Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:43.77,0:01:45.63,Default,,0000,0000,0000,,Қош бол.
Dialogue: 0,0:01:45.63,0:01:47.82,Default,,0000,0000,0000,,Бұл өте тез өтетін сияқты.
Dialogue: 0,0:01:47.82,0:01:50.68,Default,,0000,0000,0000,,Өткен күні мен Тоору мектепке кірді деп ойладым →
Dialogue: 0,0:01:50.68,0:01:53.04,Default,,0000,0000,0000,,Ол қазірдің өзінде екінші курс студенті.
Dialogue: 0,0:01:53.04,0:01:55.23,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:01:55.23,0:01:58.42,Default,,0000,0000,0000,,≪Сосын, Рун-чан үшінші курс студенті болады...≫
Dialogue: 0,0:01:58.42,0:02:02.97,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:02.97,0:02:06.00,Default,,0000,0000,0000,,Сонда кездескенше. аа.
Dialogue: 0,0:02:06.00,0:02:08.00,Default,,0000,0000,0000,,Қош бол!
Dialogue: 0,0:02:09.04,0:02:11.39,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:02:11.39,0:02:16.39,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:19.30,0:02:21.32,Default,,0000,0000,0000,,Тоору, сен әлі ояндың ба?
Dialogue: 0,0:02:21.32,0:02:24.68,Default,,0000,0000,0000,,…
Dialogue: 0,0:02:24.68,0:02:27.05,Default,,0000,0000,0000,,Кеш қалмаңыз. ·Мен түссіндім.
Dialogue: 0,0:02:27.05,0:02:30.05,Default,,0000,0000,0000,,（）  （）
Dialogue: 0,0:02:32.43,0:02:34.43,Default,,0000,0000,0000,,Ня~→
Dialogue: 0,0:02:35.47,0:02:37.47,Default,,0000,0000,0000,,Ня~
Dialogue: 0,0:02:40.01,0:02:42.01,Default,,0000,0000,0000,,Ня~
Dialogue: 0,0:02:43.38,0:02:55.38,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:58.36,0:03:09.30,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:09.30,0:03:14.30,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:16.71,0:03:24.78,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:24.78,0:03:28.78,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:30.01,0:03:41.28,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:41.28,0:03:49.70,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:49.70,0:03:56.10,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:56.10,0:04:00.10,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:04.35,0:04:12.35,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:20.34,0:04:22.03,Default,,0000,0000,0000,,Қайырлы таң Наги. Қайырлы таң.
Dialogue: 0,0:04:22.03,0:04:26.41,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:26.41,0:04:29.44,Default,,0000,0000,0000,,Не болды? Наги, мен бүгін өзімді жақсы сезінбеймін.
Dialogue: 0,0:04:29.44,0:04:32.30,Default,,0000,0000,0000,,Кеше мені романның жалғасы қызықтырды→
Dialogue: 0,0:04:32.30,0:04:34.32,Default,,0000,0000,0000,,Түн ортасына дейін оқыдым...
Dialogue: 0,0:04:34.32,0:04:37.68,Default,,0000,0000,0000,,Аа~ Менің ойымша, бұл менің ұйқым жеткіліксіз болғандықтан шығар.
Dialogue: 0,0:04:37.68,0:04:39.20,Default,,0000,0000,0000,,Түнде кеш тұру.
Dialogue: 0,0:04:39.20,0:04:41.05,Default,,0000,0000,0000,,Жоқ, шын мәнінде, сол кезде →
Dialogue: 0,0:04:41.05,0:04:45.76,Default,,0000,0000,0000,,Мен екі қорап шоколад жедім, мен өзімді жек көрдім...
Dialogue: 0,0:04:45.76,0:04:48.63,Default,,0000,0000,0000,,≪Тәттілердің ырқына көн! ≫
Dialogue: 0,0:04:48.63,0:04:52.83,Default,,0000,0000,0000,,Мм... Мен де таң атқанша кітап оқыдым.→
Dialogue: 0,0:04:52.83,0:04:54.35,Default,,0000,0000,0000,,«Сол түнде» кітабы.
Dialogue: 0,0:04:54.35,0:04:57.88,Default,,0000,0000,0000,,Ах~ Міне! Сіз оны оқыдыңыз ба?
Dialogue: 0,0:04:57.88,0:04:59.57,Default,,0000,0000,0000,,Иә! Бұл мені жылатады.
Dialogue: 0,0:04:59.57,0:05:03.77,Default,,0000,0000,0000,,Сүйіктің аурудан қайтыс болғанда жыламадың ба?
Dialogue: 0,0:05:03.77,0:05:06.80,Default,,0000,0000,0000,,Уф! Уууу….
Dialogue: 0,0:05:06.80,0:05:10.34,Default,,0000,0000,0000,,Иә, иә. Оны есіме алсам, жылаймын.
Dialogue: 0,0:05:10.34,0:05:13.71,Default,,0000,0000,0000,,I…. иә?
Dialogue: 0,0:05:13.71,0:05:16.41,Default,,0000,0000,0000,,Мен оны енді ғана оқи бастадым.
Dialogue: 0,0:05:16.41,0:05:18.41,Default,,0000,0000,0000,,Кешіріңіз... Кешіріңіз...
Dialogue: 0,0:05:20.45,0:05:23.47,Default,,0000,0000,0000,,Иә? Қазір үй тапсырмасын істеп жатырсың ба?
Dialogue: 0,0:05:23.47,0:05:27.68,Default,,0000,0000,0000,,А, а. Мен оны кешегі күнмен аяқтай алмадым.
Dialogue: 0,0:05:27.68,0:05:29.87,Default,,0000,0000,0000,,Уау, бұл сирек.
Dialogue: 0,0:05:29.87,0:05:32.23,Default,,0000,0000,0000,,Кітапты түн ортасына дейін оқыдым.
Dialogue: 0,0:05:32.23,0:05:34.92,Default,,0000,0000,0000,,Мм. Ах. иә?
Dialogue: 0,0:05:34.92,0:05:36.27,Default,,0000,0000,0000,,Бұл «U».
Dialogue: 0,0:05:36.27,0:05:39.27,Default,,0000,0000,0000,,«А», дұрыс па? иә?
Dialogue: 0,0:05:41.32,0:05:45.69,Default,,0000,0000,0000,,Ах~ Бұл «Мен»!
Dialogue: 0,0:05:45.69,0:05:49.40,Default,,0000,0000,0000,,Сіз қателесесіз. Бұл «Е». Ха!
Dialogue: 0,0:05:49.40,0:05:51.58,Default,,0000,0000,0000,,«Мен»…. «жұмысшы».
Dialogue: 0,0:05:51.58,0:05:53.58,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:05:58.99,0:06:00.51,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:06:00.51,0:06:03.70,Default,,0000,0000,0000,,Аяқталды ма? Тағы да... →
Dialogue: 0,0:06:03.70,0:06:06.23,Default,,0000,0000,0000,,Бар. Сіз...
Dialogue: 0,0:06:06.23,0:06:08.26,Default,,0000,0000,0000,,Бұл «3», иә?
Dialogue: 0,0:06:08.26,0:06:10.45,Default,,0000,0000,0000,,Бұл «Е». Ах.
Dialogue: 0,0:06:10.45,0:06:13.64,Default,,0000,0000,0000,,Сонда бұл «му», солай ма?
Dialogue: 0,0:06:13.64,0:06:15.66,Default,,0000,0000,0000,,Бұл «7». аа….
Dialogue: 0,0:06:15.66,0:06:18.02,Default,,0000,0000,0000,,Төңкерілген, солай ма?
Dialogue: 0,0:06:18.02,0:06:20.02,Default,,0000,0000,0000,,Ах…. Ах~!
Dialogue: 0,0:06:22.39,0:06:24.75,Default,,0000,0000,0000,,Run-chan! Үй тапсырмасын орындадың ба?
Dialogue: 0,0:06:24.75,0:06:28.46,Default,,0000,0000,0000,,Жоқ, мен оны үзіліс кезінде аяқтадым.
Dialogue: 0,0:06:28.46,0:06:30.31,Default,,0000,0000,0000,,≪Жүгір баламен сөйлесіп тұр... →
Dialogue: 0,0:06:30.31,0:06:33.31,Default,,0000,0000,0000,,Ах~ Тоору, тағы ашуланасың ба? ≫
Dialogue: 0,0:06:34.01,0:06:36.71,Default,,0000,0000,0000,,≪Тоорудың келетін уақыты келді емес пе? ≫
Dialogue: 0,0:06:36.71,0:06:40.57,Default,,0000,0000,0000,,≪Тоорудың орнына барып, біраз уақыт өлтіргенімді қалайсыз ба? ≫
Dialogue: 0,0:06:40.57,0:06:42.57,Default,,0000,0000,0000,,≪Әлде оны тоқтатқан дұрыс па? ≫
Dialogue: 0,0:06:44.11,0:06:47.97,Default,,0000,0000,0000,,Ой... иә...
Dialogue: 0,0:06:47.97,0:06:49.50,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:49.50,0:06:51.02,Default,,0000,0000,0000,,Не болды? Юко.
Dialogue: 0,0:06:51.02,0:06:53.37,Default,,0000,0000,0000,,Иә! Ағылшын тілі қиын, солай емес пе?
Dialogue: 0,0:06:53.37,0:06:56.40,Default,,0000,0000,0000,,≪Мен... Мен қазір жүгіремін...≫
Dialogue: 0,0:06:56.40,0:06:58.25,Default,,0000,0000,0000,,Эй... Эй, Тоору.
Dialogue: 0,0:06:58.25,0:07:00.61,Default,,0000,0000,0000,,Не? Енді →
Dialogue: 0,0:07:00.61,0:07:03.81,Default,,0000,0000,0000,,Бір минут күте тұрыңыз...
Dialogue: 0,0:07:03.81,0:07:06.33,Default,,0000,0000,0000,,Оны салыңыз. Ака~н!
Dialogue: 0,0:07:06.33,0:07:09.03,Default,,0000,0000,0000,,Әй, иә! Қарғыс атқыр... не... не істеп жатырсың!?
Dialogue: 0,0:07:09.03,0:07:11.72,Default,,0000,0000,0000,,Енді болмайды! Мүмкін емес!
Dialogue: 0,0:07:11.72,0:07:13.91,Default,,0000,0000,0000,,Ку... ауыртады! Ах...
Dialogue: 0,0:07:13.91,0:07:16.94,Default,,0000,0000,0000,,Тоору, келдің бе? Ах.
Dialogue: 0,0:07:16.94,0:07:18.96,Default,,0000,0000,0000,,<<Енді жақсы>>
Dialogue: 0,0:07:18.96,0:07:21.65,Default,,0000,0000,0000,,Жетеді, Тоору.
Dialogue: 0,0:07:21.65,0:07:23.33,Default,,0000,0000,0000,,А... а...
Dialogue: 0,0:07:23.33,0:07:25.03,Default,,0000,0000,0000,,Иә? Тоору!?
Dialogue: 0,0:07:25.03,0:07:27.38,Default,,0000,0000,0000,,Барлық 3 курс студенттері үшін →
Dialogue: 0,0:07:27.38,0:07:30.25,Default,,0000,0000,0000,,Сіздің физикалық жағдайыңызға мұқият болыңыз. →
Dialogue: 0,0:07:30.25,0:07:34.61,Default,,0000,0000,0000,,1 және 2 курс студенттері де жоғарылатуға дайындалуда...
Dialogue: 0,0:07:34.61,0:07:37.98,Default,,0000,0000,0000,,Жарайды ма? Үшінші семестрде сақамды қойдым.→
Dialogue: 0,0:07:37.98,0:07:39.00,Default,,0000,0000,0000,,Біраз уақыттан кейін бітеді. →
Dialogue: 0,0:07:39.00,0:07:42.00,Default,,0000,0000,0000,,Сергек болыңыз.
Dialogue: 0,0:07:47.41,0:07:49.93,Default,,0000,0000,0000,,Ах~ Сіз сондасыз.
Dialogue: 0,0:07:49.93,0:07:51.78,Default,,0000,0000,0000,,О, мен бе?
Dialogue: 0,0:07:51.78,0:07:55.32,Default,,0000,0000,0000,,Дұрыс. Маған жақсылық жасай аласыз ба? →
Dialogue: 0,0:07:55.32,0:07:58.69,Default,,0000,0000,0000,,Осыны барлығына таратып берулеріңізді қалаймын.
Dialogue: 0,0:07:58.69,0:08:01.55,Default,,0000,0000,0000,,Иә. Оның алдында сұрақ.
Dialogue: 0,0:08:01.55,0:08:04.74,Default,,0000,0000,0000,,Иә?не?
Dialogue: 0,0:08:04.74,0:08:06.77,Default,,0000,0000,0000,,Менің атым кім?
Dialogue: 0,0:08:06.77,0:08:12.16,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:08:12.16,0:08:14.52,Default,,0000,0000,0000,,Мұғалім: Олай емес...
Dialogue: 0,0:08:14.52,0:08:16.87,Default,,0000,0000,0000,,Ол менің сынып мұғалімім, солай ма?
Dialogue: 0,0:08:16.87,0:08:19.56,Default,,0000,0000,0000,,Кешіріңіз. Сіз ересек болған кезде →
Dialogue: 0,0:08:19.56,0:08:22.92,Default,,0000,0000,0000,,Өкінішке орай, мен кенеттен ештеңе есіме түсіре алмаймын.
Dialogue: 0,0:08:22.92,0:08:24.61,Default,,0000,0000,0000,,Соқ! (Кито) Камате Сенсей!
Dialogue: 0,0:08:24.61,0:08:26.97,Default,,0000,0000,0000,,Сонда сіз мұғалімдік құқығынан айырыласыз!
Dialogue: 0,0:08:26.97,0:08:29.67,Default,,0000,0000,0000,,Кито мырза! (Камате) Иә~ Неге?
Dialogue: 0,0:08:29.67,0:08:32.03,Default,,0000,0000,0000,,Оқушының атын ұмыту мүмкін емес! →
Dialogue: 0,0:08:32.03,0:08:34.22,Default,,0000,0000,0000,,Мен барлық студенттердің беті мен атымын→
Dialogue: 0,0:08:34.22,0:08:38.58,Default,,0000,0000,0000,,Мен сенің қай жылы, қай топқа жататыныңды толық білемін!
Dialogue: 0,0:08:38.58,0:08:40.94,Default,,0000,0000,0000,,О~ Бұл керемет. (Кито) Мұғалім болу →
Dialogue: 0,0:08:40.94,0:08:43.31,Default,,0000,0000,0000,,Әрине! Менің сүйкімді оқушыларым →
Dialogue: 0,0:08:43.31,0:08:45.66,Default,,0000,0000,0000,,Уайымыңмен маған қашан келесің→
Dialogue: 0,0:08:45.66,0:08:48.02,Default,,0000,0000,0000,,Сіз түсінбейсіз бе? Сол кезде мен өзімнен «сен кімсің?» деп сұрадым.
Dialogue: 0,0:08:48.02,0:08:51.02,Default,,0000,0000,0000,,Кито Кито Кито! иә?
Dialogue: 0,0:08:52.40,0:08:54.25,Default,,0000,0000,0000,,Китоның кесірінен мен қашып кеттім→
Dialogue: 0,0:08:54.25,0:08:57.94,Default,,0000,0000,0000,,Мен оның орнына осыны алғым келеді. Ах!
Dialogue: 0,0:08:57.94,0:08:59.94,Default,,0000,0000,0000,,Үйге бара жатқанда мен саған тамақ алып беремін. Не!
Dialogue: 0,0:09:02.32,0:09:05.02,Default,,0000,0000,0000,,Тоорунның арқасында мен үй тапсырмасын аяқтадым.
Dialogue: 0,0:09:05.02,0:09:08.72,Default,,0000,0000,0000,,Жоқ! Е, сіз жай ғана жауаптарды сәйкестендірмедіңіз бе?
Dialogue: 0,0:09:08.72,0:09:10.07,Default,,0000,0000,0000,,Хехехе. Жақсы →
Dialogue: 0,0:09:10.07,0:09:13.94,Default,,0000,0000,0000,,Сіз мұны мүлдем істемедіңіз бе? А, дұрыс! →
Dialogue: 0,0:09:13.94,0:09:17.31,Default,,0000,0000,0000,,Сіз қайдан білдіңіз? Сіз... →
Dialogue: 0,0:09:17.31,0:09:21.52,Default,,0000,0000,0000,,Жақында сіз екінші курс студенті боласыз, сондықтан жақсырақ болуыңыз керек.
Dialogue: 0,0:09:21.52,0:09:23.37,Default,,0000,0000,0000,,Бүгін де ауа райы жақсы.
Dialogue: 0,0:09:23.37,0:09:25.23,Default,,0000,0000,0000,,Алдамаңыз! Ах!
Dialogue: 0,0:09:25.23,0:09:27.23,Default,,0000,0000,0000,,Иә? иә?
Dialogue: 0,0:09:29.26,0:09:32.96,Default,,0000,0000,0000,,Ня~ Мына жерде котенка бар.
Dialogue: 0,0:09:32.96,0:09:34.48,Default,,0000,0000,0000,,Мен түсе алмаймын ба?
Dialogue: 0,0:09:34.48,0:09:37.01,Default,,0000,0000,0000,,Ня~ Ах.
Dialogue: 0,0:09:37.01,0:09:40.70,Default,,0000,0000,0000,,Мен сені жалғыз қалдыра алмаймын! Мен сізге қазір көмектесемін!
Dialogue: 0,0:09:40.70,0:09:42.89,Default,,0000,0000,0000,,Ютака?
Dialogue: 0,0:09:42.89,0:09:44.91,Default,,0000,0000,0000,,Ммм... мм. Тек тоқта! →
Dialogue: 0,0:09:44.91,0:09:47.94,Default,,0000,0000,0000,,Бұл қауіпті! бәрі жақсы!
Dialogue: 0,0:09:47.94,0:09:51.31,Default,,0000,0000,0000,,Ютака Мен осындай болсам да, ағашқа өрмелеуге шебермін!
Dialogue: 0,0:09:51.31,0:09:53.67,Default,,0000,0000,0000,,Хмм... Жарайды...
Dialogue: 0,0:09:53.67,0:09:56.03,Default,,0000,0000,0000,,А, а, а, а.... Күте тұрыңыз~→
Dialogue: 0,0:09:56.03,0:09:59.73,Default,,0000,0000,0000,,Мен қазір кетемін. Өтінемін, тыныш отырыңыз.
Dialogue: 0,0:09:59.73,0:10:01.73,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:10:04.78,0:10:07.48,Default,,0000,0000,0000,,Мен оны ұстадым! Ахх! →
Dialogue: 0,0:10:07.48,0:10:10.48,Default,,0000,0000,0000,,Уф…. (2 адам) Аа...
Dialogue: 0,0:10:12.36,0:10:16.73,Default,,0000,0000,0000,,Хмм... А, анау... (2 адам) А...
Dialogue: 0,0:10:16.73,0:10:19.76,Default,,0000,0000,0000,,≪Сәлем! Екеуміз де ашулымыз! ≫
Dialogue: 0,0:10:19.76,0:10:22.80,Default,,0000,0000,0000,,Кешіріңіз! Әй... Түскен жапырақтарды тазалаймын!
Dialogue: 0,0:10:22.80,0:10:26.66,Default,,0000,0000,0000,,Бұл дұрыс емес! иә?
Dialogue: 0,0:10:26.66,0:10:28.36,Default,,0000,0000,0000,,Ютака құлап қалса, не істеуді жоспарладыңыз?
Dialogue: 0,0:10:28.36,0:10:31.38,Default,,0000,0000,0000,,Иә! Сіз дерлік жарақат аласыз!
Dialogue: 0,0:10:31.38,0:10:33.57,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:10:33.57,0:10:37.61,Default,,0000,0000,0000,,Тоорун Мипорин…. Хехе. →
Dialogue: 0,0:10:37.61,0:10:41.15,Default,,0000,0000,0000,,Хехехе~! Неге сонша бақыттысың? →
Dialogue: 0,0:10:41.15,0:10:44.52,Default,,0000,0000,0000,,Бірақ жақсы орындадың. Иә.
Dialogue: 0,0:10:44.52,0:10:47.04,Default,,0000,0000,0000,,Ютака Сіз жақсы жұмыс істедіңіз, солай емес пе?
Dialogue: 0,0:10:47.04,0:10:49.22,Default,,0000,0000,0000,,Ня~ Ня~
Dialogue: 0,0:10:49.22,0:10:52.76,Default,,0000,0000,0000,,Эхехехехе~ Мысық та →
Dialogue: 0,0:10:52.76,0:10:54.28,Default,,0000,0000,0000,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:10:54.28,0:10:58.98,Default,,0000,0000,0000,,А, жоқ! Мұнда! иә?
Dialogue: 0,0:10:58.98,0:11:00.34,Default,,0000,0000,0000,,Бұлай араласпа.
Dialogue: 0,0:11:00.34,0:11:03.53,Default,,0000,0000,0000,,Ах... →
Dialogue: 0,0:11:03.53,0:11:05.06,Default,,0000,0000,0000,,Қылмыс жасама, тазала!
Dialogue: 0,0:11:05.06,0:11:08.25,Default,,0000,0000,0000,,… ～
Dialogue: 0,0:11:08.25,0:11:10.94,Default,,0000,0000,0000,,Иә? Міне болды.
Dialogue: 0,0:11:10.94,0:11:14.98,Default,,0000,0000,0000,,Run-chan. Әлі де алады ма?
Dialogue: 0,0:11:14.98,0:11:16.16,Default,,0000,0000,0000,,Сіз әлі аяқтадыңыз ба?
Dialogue: 0,0:11:16.16,0:11:19.03,Default,,0000,0000,0000,,Иә, аяқталды!
Dialogue: 0,0:11:19.03,0:11:21.03,Default,,0000,0000,0000,,Иә? иә?
Dialogue: 0,0:11:23.07,0:11:25.93,Default,,0000,0000,0000,,Қараңдаршы, Тоорудың басында жапырақтың бір үзігі бар→
Dialogue: 0,0:11:25.93,0:11:28.62,Default,,0000,0000,0000,,Олар өте көп.
Dialogue: 0,0:11:28.62,0:11:30.64,Default,,0000,0000,0000,,Ах. Иә….
Dialogue: 0,0:11:30.64,0:11:35.02,Default,,0000,0000,0000,,Мен оны сен үшін аламын. Мен... Жарайды, алма!
Dialogue: 0,0:11:35.02,0:11:39.02,Default,,0000,0000,0000,,Өйткені оны өзіңіз ала аласыз. Сізге ұялудың қажеті жоқ.
Dialogue: 0,0:11:41.41,0:11:44.11,Default,,0000,0000,0000,,Ах! (2 адам) Аа~.
Dialogue: 0,0:11:44.11,0:11:46.30,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:11:46.30,0:11:48.65,Default,,0000,0000,0000,,Бір сәтке танымадым.
Dialogue: 0,0:11:48.65,0:11:50.65,Default,,0000,0000,0000,,Иә, қазір таза.
Dialogue: 0,0:11:51.68,0:11:54.05,Default,,0000,0000,0000,,А... рахмет.
Dialogue: 0,0:11:54.05,0:11:57.41,Default,,0000,0000,0000,,Иә? не болды? Тоору.
Dialogue: 0,0:11:57.41,0:11:59.93,Default,,0000,0000,0000,,Бұл ерекше ештеңе емес.
Dialogue: 0,0:11:59.93,0:12:02.93,Default,,0000,0000,0000,,Сонымен... өте сүйкімді! Мяу~
Dialogue: 0,0:14:10.74,0:14:14.95,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:14:14.95,0:14:18.16,Default,,0000,0000,0000,,Не болды? Тоору. Уф.
Dialogue: 0,0:14:18.16,0:14:22.02,Default,,0000,0000,0000,,Тез жемесең, суып кетеді. Иә.
Dialogue: 0,0:14:22.02,0:14:25.02,Default,,0000,0000,0000,,Мм. Иә иә...
Dialogue: 0,0:14:27.07,0:14:30.28,Default,,0000,0000,0000,,О! Бұл дуриан бургері өте дәмді!
Dialogue: 0,0:14:30.28,0:14:34.47,Default,,0000,0000,0000,,Иә, таңқаларлық. Ах.
Dialogue: 0,0:14:34.47,0:14:36.34,Default,,0000,0000,0000,,Иә? Тоору кетчуппен бірге келеді →
Dialogue: 0,0:14:36.34,0:14:41.72,Default,,0000,0000,0000,,Ауыз қуысы. иә? Аа, бұл рас.
Dialogue: 0,0:14:41.72,0:14:44.24,Default,,0000,0000,0000,,Рахмет. иә?
Dialogue: 0,0:14:44.24,0:14:47.94,Default,,0000,0000,0000,,Ран-чан да осында.
Dialogue: 0,0:14:47.94,0:14:49.29,Default,,0000,0000,0000,,А... иә?
Dialogue: 0,0:14:49.29,0:14:51.98,Default,,0000,0000,0000,,Тіл тістеу…. Ха!
Dialogue: 0,0:14:51.98,0:14:54.01,Default,,0000,0000,0000,,Бұл қан ба!? Кетчуп па!?
Dialogue: 0,0:14:54.01,0:14:56.53,Default,,0000,0000,0000,,Тоору~ жүгіріңіз! →
Dialogue: 0,0:14:56.53,0:14:59.40,Default,,0000,0000,0000,,Күткеніңізге рахмет. Өкініштісі кеш.
Dialogue: 0,0:14:59.40,0:15:03.60,Default,,0000,0000,0000,,Қазір сол жерде бір шетелдік маған бағыт сұрап жатыр.
Dialogue: 0,0:15:03.60,0:15:05.45,Default,,0000,0000,0000,,Мен оған жауап бере алдым.
Dialogue: 0,0:15:05.45,0:15:07.31,Default,,0000,0000,0000,,Иә. иә?
Dialogue: 0,0:15:07.31,0:15:09.67,Default,,0000,0000,0000,,Хахаха Нагихян!
Dialogue: 0,0:15:09.67,0:15:13.70,Default,,0000,0000,0000,,Ха ха ха ха ха ха хе хе хе хе. (Юко Наги) Иә?
Dialogue: 0,0:15:13.70,0:15:17.90,Default,,0000,0000,0000,,≪Бұл қай тіл? Мен сынақтан өтіп жатырмын ба? ≫
Dialogue: 0,0:15:17.90,0:15:19.90,Default,,0000,0000,0000,,Мен жай ғана тілімді тістеп алдым.
Dialogue: 0,0:15:20.27,0:15:24.64,Default,,0000,0000,0000,,Қараңдар, қараңдар! Мен қазір ұпай жинап жатырмын.
Dialogue: 0,0:15:24.64,0:15:27.01,Default,,0000,0000,0000,,Маған осы дүкеннің тауары керек.
Dialogue: 0,0:15:27.01,0:15:29.36,Default,,0000,0000,0000,,Ах~ Міне, осы. (Юко) Дена→
Dialogue: 0,0:15:29.36,0:15:34.74,Default,,0000,0000,0000,,Егер сізге бәрі қажет болмаса, мен сіздің ынтымақтастықыңызды қалаймын.
Dialogue: 0,0:15:34.74,0:15:37.61,Default,,0000,0000,0000,,Беру. (Юко) Рахмет, Тоору.
Dialogue: 0,0:15:37.61,0:15:40.31,Default,,0000,0000,0000,,Хахахимо хахефу~! (Юко) Сен де жүгір, рахмет.
Dialogue: 0,0:15:40.31,0:15:43.50,Default,,0000,0000,0000,,Мен де жинаған жоқпын, сондықтан ынтымақтасамын.
Dialogue: 0,0:15:43.50,0:15:45.19,Default,,0000,0000,0000,,Шынымен бе? Мен сондай қуаныштымын.
Dialogue: 0,0:15:45.19,0:15:48.38,Default,,0000,0000,0000,,Сонымен, сіз қандай тауар жинайсыз?
Dialogue: 0,0:15:48.38,0:15:52.09,Default,,0000,0000,0000,,Иә, ойыншық қонжық салпыншақ. Бұл сүйкімді.
Dialogue: 0,0:15:52.09,0:15:54.28,Default,,0000,0000,0000,,Иә. Юкохян…→
Dialogue: 0,0:15:54.28,0:15:56.63,Default,,0000,0000,0000,,Фухахо фухифуфухиха фухиханха~.
Dialogue: 0,0:15:56.63,0:15:58.63,Default,,0000,0000,0000,,Хонхо хехехехехехе~.
Dialogue: 0,0:16:00.00,0:16:02.36,Default,,0000,0000,0000,,А... иә. Ах →
Dialogue: 0,0:16:02.36,0:16:05.72,Default,,0000,0000,0000,,Мен жуынатын бөлмеге барайын деп жатырмын.
Dialogue: 0,0:16:05.72,0:16:07.74,Default,,0000,0000,0000,,О. Айтпақшы →
Dialogue: 0,0:16:07.74,0:16:09.93,Default,,0000,0000,0000,,...
Dialogue: 0,0:16:09.93,0:16:11.45,Default,,0000,0000,0000,,（） （３）
Dialogue: 0,0:16:11.45,0:16:15.65,Default,,0000,0000,0000,,Ауырды. аа…. иә?
Dialogue: 0,0:16:15.65,0:16:17.65,Default,,0000,0000,0000,,Ах~. (Юко) Ха!
Dialogue: 0,0:16:18.68,0:16:21.38,Default,,0000,0000,0000,,Таза ақ тым өршіл 1 ұпай.
Dialogue: 0,0:16:21.38,0:16:23.07,Default,,0000,0000,0000,,Шілтер сүйкімді. 2 ұпай.
Dialogue: 0,0:16:23.07,0:16:25.59,Default,,0000,0000,0000,,Хохе хехе? Хмм….
Dialogue: 0,0:16:25.59,0:16:27.59,Default,,0000,0000,0000,,Уау!!
Dialogue: 0,0:16:28.79,0:16:32.82,Default,,0000,0000,0000,,≪Ой, ол кісі ұпайларды лақтырып жіберді! ≫
Dialogue: 0,0:16:32.82,0:16:36.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:16:36.20,0:16:38.72,Default,,0000,0000,0000,,<<Уау~ Қандай ысырап! Бірақ қазірдің өзінде →
Dialogue: 0,0:16:38.72,0:16:42.92,Default,,0000,0000,0000,,Қоқыс жәшігіндегі алақан. Күткендей, мен оны алып тастауым керек... →
Dialogue: 0,0:16:42.92,0:16:45.78,Default,,0000,0000,0000,,А, дұрыс! Осы жерге орналастырсаңыз →
Dialogue: 0,0:16:45.78,0:16:47.78,Default,,0000,0000,0000,,Оны лақтырған адам алуы мүмкін≫
Dialogue: 0,0:16:48.65,0:16:52.85,Default,,0000,0000,0000,,Юуко, сен кешігіп қалдың. Сен не істеп жатырсың?
Dialogue: 0,0:16:52.85,0:16:54.71,Default,,0000,0000,0000,,（）… （２）
Dialogue: 0,0:16:54.71,0:16:58.75,Default,,0000,0000,0000,,Маған ұпайлар қажет емес, сондықтан жалғастырыңыз. иә.
Dialogue: 0,0:16:58.75,0:17:01.95,Default,,0000,0000,0000,,Хахихахо~! рақмет сізге.
Dialogue: 0,0:17:01.95,0:17:03.47,Default,,0000,0000,0000,,Хе...
Dialogue: 0,0:17:03.47,0:17:07.50,Default,,0000,0000,0000,,Ұпай жинамаған адамдар аз болуы мүмкін.
Dialogue: 0,0:17:07.50,0:17:09.86,Default,,0000,0000,0000,,Осы арқылы сіз тауарды бірден ала аласыз. →
Dialogue: 0,0:17:09.86,0:17:12.72,Default,,0000,0000,0000,,Юко Қайтып келгенде таң қаласыз.
Dialogue: 0,0:17:12.72,0:17:16.09,Default,,0000,0000,0000,,Мм... сіз ұпай карталарын жинайсыз ба?
Dialogue: 0,0:17:16.09,0:17:18.28,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:17:18.28,0:17:21.98,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:17:21.98,0:17:23.00,Default,,0000,0000,0000,,≪Неге? Неге ешкім →
Dialogue: 0,0:17:23.00,0:17:25.00,Default,,0000,0000,0000,,Сіз ұпай картасын лақтырмақсыз ба? ≫
Dialogue: 0,0:17:27.71,0:17:29.90,Default,,0000,0000,0000,,Ах! иә?
Dialogue: 0,0:17:29.90,0:17:33.60,Default,,0000,0000,0000,,«Тек шектеулі уақыт!»…. Хехе.
Dialogue: 0,0:17:33.60,0:17:36.29,Default,,0000,0000,0000,,Дуриан бургері! Тек шектеулі уақыт!
Dialogue: 0,0:17:36.29,0:17:39.66,Default,,0000,0000,0000,,Осы жерден тамақтанайық! Бүгін емес.
Dialogue: 0,0:17:39.66,0:17:41.01,Default,,0000,0000,0000,,Иә! Неліктен?
Dialogue: 0,0:17:41.01,0:17:43.04,Default,,0000,0000,0000,,Күрсіну…. Апыр-ай!
Dialogue: 0,0:17:43.04,0:17:46.06,Default,,0000,0000,0000,,Үй тапсырмасын орындау керек.
Dialogue: 0,0:17:46.06,0:17:49.76,Default,,0000,0000,0000,,Уф... Уақыт шектеулі!
Dialogue: 0,0:17:49.76,0:17:52.12,Default,,0000,0000,0000,,Міне. (Юко) Иә!
Dialogue: 0,0:17:52.12,0:17:54.31,Default,,0000,0000,0000,,Оны қайта пайдаланыңыз.
Dialogue: 0,0:17:54.31,0:17:59.86,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:17:59.86,0:18:02.86,Default,,0000,0000,0000,,Қалай болды? (Юко) Мен түсіндім.
Dialogue: 0,0:18:04.74,0:18:06.60,Default,,0000,0000,0000,,Сізге жақсы, Юко-чан.
Dialogue: 0,0:18:06.60,0:18:09.46,Default,,0000,0000,0000,,Иә, рахмет. Аз уақытта жиналды →
Dialogue: 0,0:18:09.46,0:18:12.46,Default,,0000,0000,0000,,Мен таң қалдым. Ах.
Dialogue: 0,0:18:14.68,0:18:16.20,Default,,0000,0000,0000,,Та-да!
Dialogue: 0,0:18:16.20,0:18:19.06,Default,,0000,0000,0000,,Әй, сүйкімді емес пе?
Dialogue: 0,0:18:19.06,0:18:22.09,Default,,0000,0000,0000,,Юуко сүйкімді нәрселерді жақсы көреді.
Dialogue: 0,0:18:22.09,0:18:24.27,Default,,0000,0000,0000,,Иә. Иә →
Dialogue: 0,0:18:24.27,0:18:26.79,Default,,0000,0000,0000,,Өйткені сүйкімді заттар сүйкімді.
Dialogue: 0,0:18:26.79,0:18:28.65,Default,,0000,0000,0000,,Орындалды! иә?
Dialogue: 0,0:18:28.65,0:18:32.52,Default,,0000,0000,0000,,Қараңдар! не?
Dialogue: 0,0:18:32.52,0:18:36.72,Default,,0000,0000,0000,,Оригами тырналары! Хехе, кішкентай емес пе?
Dialogue: 0,0:18:36.72,0:18:38.75,Default,,0000,0000,0000,,Көруге тым кішкентай...
Dialogue: 0,0:18:38.75,0:18:40.61,Default,,0000,0000,0000,,Бұл өте жаман, Наги-чан.
Dialogue: 0,0:18:40.61,0:18:44.65,Default,,0000,0000,0000,,Маған үлкейткіш әйнек беріңіз. Менде ондай жоқ.
Dialogue: 0,0:18:44.65,0:18:47.01,Default,,0000,0000,0000,,Не? Бұл бет кім?
Dialogue: 0,0:18:47.01,0:18:50.01,Default,,0000,0000,0000,,Сіздің көзілдірігіңіз қандай деп ойлайсыз?
Dialogue: 0,0:18:51.21,0:18:54.57,Default,,0000,0000,0000,,Иә. рақмет сізге.
Dialogue: 0,0:18:54.57,0:18:56.93,Default,,0000,0000,0000,,Мен оны сізге қарызға беремін деп ойлаймын.
Dialogue: 0,0:18:56.93,0:18:59.63,Default,,0000,0000,0000,,Бұл жақсы. Оххон!
Dialogue: 0,0:18:59.63,0:19:02.65,Default,,0000,0000,0000,,Жүгір... Басыңыз жақсы ма?
Dialogue: 0,0:19:02.65,0:19:05.01,Default,,0000,0000,0000,,Ахаха, Наги имитациясы!
Dialogue: 0,0:19:05.01,0:19:09.06,Default,,0000,0000,0000,,Егер қолданбасаңыз, қайтарыңыз! Бұл үлкейткіш әйнекті алмастырушы емес пе еді?
Dialogue: 0,0:19:09.06,0:19:13.77,Default,,0000,0000,0000,,Иә! А... Мен оған көмектесе алмаймын. Ах!
Dialogue: 0,0:19:13.77,0:19:16.63,Default,,0000,0000,0000,,Наги-чан кішірейіп барады!
Dialogue: 0,0:19:16.63,0:19:19.99,Default,,0000,0000,0000,,Керемет! Сондай кішкентай!
Dialogue: 0,0:19:19.99,0:19:21.99,Default,,0000,0000,0000,,А... көздерің. →
Dialogue: 0,0:19:23.70,0:19:27.57,Default,,0000,0000,0000,,Бұрынғы еліктеушілікке мүлде ұқсамады.
Dialogue: 0,0:19:27.57,0:19:31.94,Default,,0000,0000,0000,,Иә~ Менің ойымша? Наги өзіне сенімді сияқты.
Dialogue: 0,0:19:31.94,0:19:34.97,Default,,0000,0000,0000,,Аа, мен оны көргім келеді. иә!
Dialogue: 0,0:19:34.97,0:19:36.50,Default,,0000,0000,0000,,Еліктеп көріңіз!
Dialogue: 0,0:19:36.50,0:19:39.50,Default,,0000,0000,0000,,Хмм... Мен оны көп көрсеткім келмейді, бірақ...
Dialogue: 0,0:19:41.04,0:19:43.23,Default,,0000,0000,0000,,Аха! Наги-чан→
Dialogue: 0,0:19:43.23,0:19:46.26,Default,,0000,0000,0000,,Үлкейткіш әйнек сізге жақсы көрінеді!
Dialogue: 0,0:19:46.26,0:19:49.29,Default,,0000,0000,0000,,Сонымен... қараңдар!!
Dialogue: 0,0:19:49.29,0:19:52.16,Default,,0000,0000,0000,,Иә! Ол көрсеткісі келмейтінін айтады.
Dialogue: 0,0:19:52.16,0:19:54.34,Default,,0000,0000,0000,,Менің айтқым келгені бұл емес!
Dialogue: 0,0:19:54.34,0:19:58.38,Default,,0000,0000,0000,,Содан кейін әрекетті қайталаңыз! (Юко) Мен де оны қайта көргім келеді.
Dialogue: 0,0:19:58.38,0:20:02.92,Default,,0000,0000,0000,,Сонымен... сіз мұны істей аласыз ба? Эй, мен бұл жолы дұрыс қарайтын боламын.
Dialogue: 0,0:20:02.92,0:20:05.11,Default,,0000,0000,0000,,Хмм... Мен білмеймін! иә!
Dialogue: 0,0:20:05.11,0:20:08.82,Default,,0000,0000,0000,,Хмф! Хахахаха Наги Чан ашуланды.
Dialogue: 0,0:20:08.82,0:20:11.34,Default,,0000,0000,0000,,Кешіріңіз. Бірақ Наги өте ұқсас болды.
Dialogue: 0,0:20:11.34,0:20:15.34,Default,,0000,0000,0000,,Иә, дәл солай болды! Сіз оны көрмедіңіз!
Dialogue: 0,0:20:18.25,0:20:20.77,Default,,0000,0000,0000,,Бұл жерде не туралы ойлайсың? →
Dialogue: 0,0:20:20.77,0:20:23.30,Default,,0000,0000,0000,,Олар дуриандық бургерлерді шектеулі уақытқа ғана ұсынады. →
Dialogue: 0,0:20:23.30,0:20:25.66,Default,,0000,0000,0000,,Қараңыз. (Камате) А~ Жоқ, жоқ. →
Dialogue: 0,0:20:25.66,0:20:28.85,Default,,0000,0000,0000,,Дүкеннің мұндай түріне әдетте студенттер келеді.
Dialogue: 0,0:20:28.85,0:20:32.05,Default,,0000,0000,0000,,Бұл шектеулі уақытқа ғана.
Dialogue: 0,0:20:32.05,0:20:34.91,Default,,0000,0000,0000,,Ха! Бұл дұрыс емес! →
Dialogue: 0,0:20:34.91,0:20:37.94,Default,,0000,0000,0000,,Мектептен қайтып келе жатқанда азық-түлік сатып алу - қылмыскер болудың алғашқы қадамы! →
Dialogue: 0,0:20:37.94,0:20:39.29,Default,,0000,0000,0000,,Тез барып абай болмасаң...
Dialogue: 0,0:20:39.29,0:20:42.65,Default,,0000,0000,0000,,Жақсы. (Кито) Бірақ!
Dialogue: 0,0:20:42.65,0:20:44.01,Default,,0000,0000,0000,,Бұл басқа дүкен.
Dialogue: 0,0:20:44.01,0:20:47.54,Default,,0000,0000,0000,,Иә, иә. Ол адамдармен қатал.
Dialogue: 0,0:20:47.54,0:20:50.90,Default,,0000,0000,0000,,Әй, күте тұрыңыз, біз әлі сөйлескен жоқпыз!
Dialogue: 0,0:20:50.90,0:20:52.75,Default,,0000,0000,0000,,Дәлірек айтсақ, үлкендер үшін көбірек→
Dialogue: 0,0:20:52.75,0:20:55.95,Default,,0000,0000,0000,,Мен жоғары санатты дүкеннен үміттенемін. Не!
Dialogue: 0,0:20:55.95,0:20:57.30,Default,,0000,0000,0000,,Амансың ба? Мен өте қуаныштымын →
Dialogue: 0,0:20:57.30,0:21:00.66,Default,,0000,0000,0000,,Бұл рахат, солай ма? (Камате) Кито.
Dialogue: 0,0:21:00.66,0:21:03.03,Default,,0000,0000,0000,,Сәлем! (Камате) Хе.
Dialogue: 0,0:21:03.03,0:21:05.03,Default,,0000,0000,0000,,Бұл бөлінген шот!
Dialogue: 0,0:21:07.40,0:21:10.93,Default,,0000,0000,0000,,Бұл диета әдісі жақсы емес.
Dialogue: 0,0:21:10.93,0:21:12.62,Default,,0000,0000,0000,,Солай ма? (Юко) Шынымен бе? →
Dialogue: 0,0:21:12.62,0:21:14.64,Default,,0000,0000,0000,,Біз де сендік. Дұрыс па? →
Dialogue: 0,0:21:14.64,0:21:18.01,Default,,0000,0000,0000,,Сондықтан мен таң қалып, басқа әдіске көштім.
Dialogue: 0,0:21:18.01,0:21:21.04,Default,,0000,0000,0000,,Иә. (Юко) Картоп жеуге бола ма?
Dialogue: 0,0:21:21.04,0:21:23.73,Default,,0000,0000,0000,,Ах! Бүгін жақсы →
Dialogue: 0,0:21:23.73,0:21:26.09,Default,,0000,0000,0000,,Себебі мен оны дұрыс есептедім. (Юко) Шынымен бе?
Dialogue: 0,0:21:26.09,0:21:28.09,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:21:29.96,0:21:31.31,Default,,0000,0000,0000,,Тоору? Ах.
Dialogue: 0,0:21:31.31,0:21:34.67,Default,,0000,0000,0000,,Ұйқыңыз келді ме? Хмм... Жарайды.
Dialogue: 0,0:21:34.67,0:21:38.05,Default,,0000,0000,0000,,Аа, бұл өте ұзақ. (Юко) Сіз тым көп сөйледіңіз.
Dialogue: 0,0:21:38.05,0:21:42.58,Default,,0000,0000,0000,,Тезірек үйге қайтайық? (Юко) Дұрыс.
Dialogue: 0,0:21:42.58,0:21:44.58,Default,,0000,0000,0000,,Иә, үйге бар, үйге қайт!
Dialogue: 0,0:21:46.79,0:21:49.99,Default,,0000,0000,0000,,Ғарышта! Тағы бір оғаш нәрсе.
Dialogue: 0,0:21:49.99,0:21:52.02,Default,,0000,0000,0000,,Іс жүзінде...→
Dialogue: 0,0:21:52.02,0:21:54.37,Default,,0000,0000,0000,,Бұл бөтен адам!
Dialogue: 0,0:21:54.37,0:21:57.06,Default,,0000,0000,0000,,Ах... Күрсін....
Dialogue: 0,0:21:57.06,0:21:59.42,Default,,0000,0000,0000,,≪Наги қайта келеді≫
Dialogue: 0,0:21:59.42,0:22:03.13,Default,,0000,0000,0000,,Күтілгендей! Мен солай ойладым!
Dialogue: 0,0:22:03.13,0:22:05.98,Default,,0000,0000,0000,,Мен келісемін! иә?
Dialogue: 0,0:22:05.98,0:22:08.01,Default,,0000,0000,0000,,Қанша жесең де, семірмейсің! (Юко) Кейде →
Dialogue: 0,0:22:08.01,0:22:10.01,Default,,0000,0000,0000,,Аспан да ұшады!
Dialogue: 0,0:22:11.38,0:22:13.23,Default,,0000,0000,0000,,Run-chan!? Ха!
Dialogue: 0,0:22:13.23,0:22:17.26,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:22:17.26,0:22:19.62,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:22:19.62,0:22:23.16,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:22:23.16,0:22:25.68,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:22:25.68,0:22:29.06,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:22:29.06,0:22:31.75,Default,,0000,0000,0000,,Ах! Сонда кездескенше.
Dialogue: 0,0:22:31.75,0:22:35.28,Default,,0000,0000,0000,,Денеңізді күтіңіз. иә!
Dialogue: 0,0:22:35.28,0:22:38.31,Default,,0000,0000,0000,,Уау! Көріскенше, жігіттер~!
Dialogue: 0,0:22:38.31,0:22:40.67,Default,,0000,0000,0000,,Рун-чан, күте тұр!
Dialogue: 0,0:22:40.67,0:22:42.69,Default,,0000,0000,0000,,Ах. (Юко) Қош бол!
Dialogue: 0,0:22:42.69,0:22:46.22,Default,,0000,0000,0000,,Не? иә? Жердегі тағам дәмді →
Dialogue: 0,0:22:46.22,0:22:50.27,Default,,0000,0000,0000,,Жақсы болды! Сіз ғарышта не жейсіз?
Dialogue: 0,0:22:50.27,0:22:54.97,Default,,0000,0000,0000,,Ғарыштық тағам~! Солай ма?
Dialogue: 0,0:22:54.97,0:22:58.01,Default,,0000,0000,0000,,Иә! Жерде жасалған! Уф...
Dialogue: 0,0:22:58.01,0:23:01.54,Default,,0000,0000,0000,,Run-chan! А, сен ояндың ба?
Dialogue: 0,0:23:01.54,0:23:04.24,Default,,0000,0000,0000,,Не? Жақсы ұйықтадың.
Dialogue: 0,0:23:04.24,0:23:07.27,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:23:07.27,0:23:09.62,Default,,0000,0000,0000,,≪Ю... арман? ≫
Dialogue: 0,0:23:09.62,0:23:11.48,Default,,0000,0000,0000,,Иә, Тоорундар отбасы келді!
Dialogue: 0,0:23:11.48,0:23:15.34,Default,,0000,0000,0000,,Ах. иә….
Dialogue: 0,0:23:15.34,0:23:17.37,Default,,0000,0000,0000,,Кешіріңіз. рақмет сізге.
Dialogue: 0,0:23:17.37,0:23:20.73,Default,,0000,0000,0000,,Жарайды. Сосын мен үйге барамын.
Dialogue: 0,0:23:20.73,0:23:22.92,Default,,0000,0000,0000,,Иә! иә?
Dialogue: 0,0:23:22.92,0:23:25.28,Default,,0000,0000,0000,,Бұл ғарышта емес, солай емес пе!? Тоору әзіл айтып жатқанына сене алар емеспін →
Dialogue: 0,0:23:25.28,0:23:27.80,Default,,0000,0000,0000,,Бұл сирек.
Dialogue: 0,0:23:27.80,0:23:30.67,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:30.67,0:23:34.87,Default,,0000,0000,0000,,Ня~ Ня~…
Dialogue: 0,0:23:34.87,0:23:37.41,Default,,0000,0000,0000,,Сонда кездескенше. аа.
Dialogue: 0,0:23:37.41,0:23:39.41,Default,,0000,0000,0000,,Қош бол!
Dialogue: 0,0:23:42.62,0:23:46.32,Default,,0000,0000,0000,,≪Қызық, әркім оқуды оңай бітіре ме? ≫
Dialogue: 0,0:23:46.32,0:23:51.88,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:51.88,0:23:55.41,Default,,0000,0000,0000,,（）
Dialogue: 0,0:23:55.41,0:23:59.95,Default,,0000,0000,0000,,Түн болғандықтан абай болыңыз. иә.
Dialogue: 0,0:23:59.95,0:24:01.81,Default,,0000,0000,0000,,Чиен (лифт дыбысы)
Dialogue: 0,0:24:01.81,0:24:05.84,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:05.84,0:24:07.87,Default,,0000,0000,0000,,≪Қараңғы түссе де көмектесу мүмкін емес≫
Dialogue: 0,0:24:07.87,0:24:09.22,Default,,0000,0000,0000,,≪Өзіңізді тәтті нәрсемен қуантқыңыз келе ме?≫
Dialogue: 0,0:24:09.22,0:24:13.59,Default,,0000,0000,0000,,Хо хо хо хо хо... иә?
Dialogue: 0,0:24:13.59,0:24:15.12,Default,,0000,0000,0000,,Хохо хохо...
Dialogue: 0,0:24:15.12,0:24:18.31,Default,,0000,0000,0000,,Ru…→
Dialogue: 0,0:24:18.31,0:24:22.02,Default,,0000,0000,0000,,Run-chan…. Хо хо хо... Ха!
Dialogue: 0,0:24:22.02,0:24:25.05,Default,,0000,0000,0000,,Әй, Тоору!
Dialogue: 0,0:24:25.05,0:24:27.05,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:24:29.92,0:24:31.61,Default,,0000,0000,0000,,Ух...хехе...→
Dialogue: 0,0:24:31.61,0:24:34.97,Default,,0000,0000,0000,,Хэхехе!
Dialogue: 0,0:24:34.97,0:24:36.66,Default,,0000,0000,0000,,Run-chan! иә?
Dialogue: 0,0:24:36.66,0:24:39.85,Default,,0000,0000,0000,,Не болды? Тоору.
Dialogue: 0,0:24:39.85,0:24:41.04,Default,,0000,0000,0000,,Run-chan…→
Dialogue: 0,0:24:41.04,0:24:43.06,Default,,0000,0000,0000,,Өзгеріс жоқ!
Dialogue: 0,0:24:43.06,0:24:46.93,Default,,0000,0000,0000,,Иә? иә!
Dialogue: 0,0:24:46.93,0:25:06.62,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:06.62,0:25:26.49,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:26.49,0:25:46.69,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:46.69,0:26:06.72,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:06.72,0:26:26.75,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:26.75,0:26:34.75,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:00.60,0:27:04.30,Default,,0000,0000,0000,,Тоору Сіз кешіктіңіз!
Dialogue: 0,0:27:04.30,0:27:06.99,Default,,0000,0000,0000,,Күтуден шаршадым.
Dialogue: 0,0:27:06.99,0:27:09.02,Default,,0000,0000,0000,,Тез үйге қайтайық.
Dialogue: 0,0:27:09.02,0:27:11.04,Default,,0000,0000,0000,,Иә. Хаха.
Dialogue: 0,0:27:11.04,0:27:14.06,Default,,0000,0000,0000,,Міне! (Наги Рун Юуко) Ахахха!
Dialogue: 0,0:27:14.06,0:27:16.93,Default,,0000,0000,0000,,Хехе. (Наги Рун Юуко) Ахахха!
Dialogue: 0,0:27:16.93,0:27:33.93,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:35.43,0:27:41.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory