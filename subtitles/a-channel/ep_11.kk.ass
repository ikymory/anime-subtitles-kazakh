Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:02.35,0:02:16.32,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:16.32,0:02:19.85,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:02:19.85,0:02:21.37,Default,,0000,0000,0000,,...
Dialogue: 0,0:02:21.37,0:02:24.57,Default,,0000,0000,0000,,Арун-чан қазірдің өзінде! Хехе.
Dialogue: 0,0:02:24.57,0:02:26.75,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:02:26.75,0:02:28.75,Default,,0000,0000,0000,,Тағы бір Қан Құбыжық Өнері ме?
Dialogue: 0,0:02:30.13,0:02:33.13,Default,,0000,0000,0000,,Рахмет, Тоору.
Dialogue: 0,0:02:34.00,0:02:37.36,Default,,0000,0000,0000,,Ах... иә.
Dialogue: 0,0:02:37.36,0:02:47.36,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:50.99,0:02:54.86,Default,,0000,0000,0000,,Дыбыстық сигнал… (оятар дабылы)
Dialogue: 0,0:02:54.86,0:02:59.86,Default,,0000,0000,0000,,Пипипипи…
Dialogue: 0,0:03:00.09,0:03:13.09,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:15.08,0:03:26.69,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:26.69,0:03:31.69,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:33.93,0:03:41.00,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:41.00,0:03:45.00,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:47.39,0:03:58.84,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:58.84,0:04:06.92,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:06.92,0:04:13.82,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:13.82,0:04:17.82,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:21.74,0:04:29.74,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:45.97,0:04:47.83,Default,,0000,0000,0000,,…（）
Dialogue: 0,0:04:47.83,0:04:49.02,Default,,0000,0000,0000,,（）
Dialogue: 0,0:04:49.02,0:04:53.39,Default,,0000,0000,0000,,Қайырлы таң! Бүгін тағы салқын.
Dialogue: 0,0:04:53.39,0:04:56.08,Default,,0000,0000,0000,,Аа~ Көктем жақында келе ме деп ойлаймын.
Dialogue: 0,0:04:56.08,0:04:59.79,Default,,0000,0000,0000,,Аа, айтпақшы, Тоорудың туған күні жақында емес пе?
Dialogue: 0,0:04:59.79,0:05:04.17,Default,,0000,0000,0000,,Иә, дұрыс. (Юко) Ендеше, той жасаймыз ба?
Dialogue: 0,0:05:04.17,0:05:08.70,Default,,0000,0000,0000,,Жақсы. (Юко) Қайтадан бас тартыңыз.
Dialogue: 0,0:05:08.70,0:05:12.74,Default,,0000,0000,0000,,Осы жылы да сыйлықтар күтіңіз! Иә.
Dialogue: 0,0:05:12.74,0:05:14.76,Default,,0000,0000,0000,,≪Оны асыға күтіңіз...→
Dialogue: 0,0:05:14.76,0:05:16.79,Default,,0000,0000,0000,,Шынымен солай ма? →
Dialogue: 0,0:05:16.79,0:05:19.79,Default,,0000,0000,0000,,Бұл қандай жануар болды? ≫
Dialogue: 0,0:05:24.69,0:05:26.38,Default,,0000,0000,0000,,Сол форма...
Dialogue: 0,0:05:26.38,0:05:28.74,Default,,0000,0000,0000,,Ах~ Кіші мектеп оқушысы, солай ма? →
Dialogue: 0,0:05:28.74,0:05:31.43,Default,,0000,0000,0000,,Бүгін мектепте ақпараттық сессия бар.
Dialogue: 0,0:05:31.43,0:05:33.62,Default,,0000,0000,0000,,Аа~ түсіндім. →
Dialogue: 0,0:05:33.62,0:05:36.48,Default,,0000,0000,0000,,Жаңа жыл аяқталғанда, бұл балалар қабылдау емтиханын тапсырады.
Dialogue: 0,0:05:36.48,0:05:39.48,Default,,0000,0000,0000,,Ал біз тағы бір жылға қартайамыз ба?
Dialogue: 0,0:05:41.03,0:05:44.40,Default,,0000,0000,0000,,Емтихан…. Емтихан?
Dialogue: 0,0:05:44.40,0:05:48.77,Default,,0000,0000,0000,,Сағыныш, Тоору. иә? Иә….
Dialogue: 0,0:05:48.77,0:05:53.16,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:05:53.16,0:05:58.37,Default,,0000,0000,0000,,Ах~ екінші таңдауымды тез шешуім керек~
Dialogue: 0,0:05:58.37,0:06:00.39,Default,,0000,0000,0000,,Сіз бірінші таңдауыңызды шешіп қойдыңыз ба?
Dialogue: 0,0:06:00.39,0:06:03.58,Default,,0000,0000,0000,,Иә. Менің бағаларыма келетін болсақ →
Dialogue: 0,0:06:03.58,0:06:06.29,Default,,0000,0000,0000,,Менің ойымша, бұл деңгей ең жақын.
Dialogue: 0,0:06:06.29,0:06:08.31,Default,,0000,0000,0000,,Тоору орта мектепте не істейді?
Dialogue: 0,0:06:08.31,0:06:11.84,Default,,0000,0000,0000,,Сіз әлі шешкен жоқсыз ба? Ол екінші курс студенті.
Dialogue: 0,0:06:11.84,0:06:14.03,Default,,0000,0000,0000,,Мен де солай қабылдаймын.
Dialogue: 0,0:06:14.03,0:06:18.07,Default,,0000,0000,0000,,Екінші сынып? Тоору арқылы сіз жақсырақ жерге бара аласыз, солай ма?
Dialogue: 0,0:06:18.07,0:06:20.93,Default,,0000,0000,0000,,Менің бағаларым жақсы, сондықтан жоқ...→
Dialogue: 0,0:06:20.93,0:06:23.93,Default,,0000,0000,0000,,Run-chan қайда барса да
Dialogue: 0,0:06:28.00,0:06:30.36,Default,,0000,0000,0000,,«Мен, Демегава, ақыры құдайдай Кираны ұстауға тырысқан зұлым ұйымның жасырын базасын тауып алдым,
Dialogue: 0,0:06:30.36,0:06:33.89,Default,,0000,0000,0000,,Сонымен, сіз орта мектепте не істеу керектігін әлі шештіңіз бе?
Dialogue: 0,0:06:33.89,0:06:38.11,Default,,0000,0000,0000,,Иә... әйтпесе. Екінші орта мектеп ше?
Dialogue: 0,0:06:38.11,0:06:42.98,Default,,0000,0000,0000,,О, жақсы. Ол жерде жақсы беделге ие. →
Dialogue: 0,0:06:42.98,0:06:44.67,Default,,0000,0000,0000,,Ауытқу мәндерінің де дұрыс екеніне сенімдімін.
Dialogue: 0,0:06:44.67,0:06:48.70,Default,,0000,0000,0000,,Иә. Ой, енді ойлап қарасам, Тоору→
Dialogue: 0,0:06:48.70,0:06:51.06,Default,,0000,0000,0000,,Ол мен оқитын орта мектепке баратынын айтты.
Dialogue: 0,0:06:51.06,0:06:53.42,Default,,0000,0000,0000,,Дон! иә?
Dialogue: 0,0:06:53.42,0:06:56.45,Default,,0000,0000,0000,,Жоғары орта мектепке барыңыз, бірақ...
Dialogue: 0,0:06:56.45,0:06:59.48,Default,,0000,0000,0000,,Жақсы жерге барсаңыз, кейінірек жеңіл болады.
Dialogue: 0,0:06:59.48,0:07:03.85,Default,,0000,0000,0000,,Қазір мен екінші орта мектепте оқып жүргендіктен, ойымды өзгерттім.
Dialogue: 0,0:07:03.85,0:07:06.88,Default,,0000,0000,0000,,Иә. Бірақ сіз қабылдасаңыз да →
Dialogue: 0,0:07:06.88,0:07:09.58,Default,,0000,0000,0000,,Мен нәтижелерді көремін. Аму…→
Dialogue: 0,0:07:09.58,0:07:13.62,Default,,0000,0000,0000,,Ауытқу мәні де жеткіліксіз... Дұрыс. →
Dialogue: 0,0:07:13.62,0:07:16.82,Default,,0000,0000,0000,,Әзірге.
Dialogue: 0,0:07:16.82,0:07:19.01,Default,,0000,0000,0000,,Ах! Ал... күте тұрыңыз! Сіз қайда қоңырау шалып жатырсыз?
Dialogue: 0,0:07:19.01,0:07:21.37,Default,,0000,0000,0000,,Мен мектепті жек көремін!!
Dialogue: 0,0:07:21.37,0:07:25.74,Default,,0000,0000,0000,,Ха! Ха! Ха! Ха! Ха ха...
Dialogue: 0,0:07:25.74,0:07:27.26,Default,,0000,0000,0000,,Күрсін! (Жүгірдің анасы) А~!
Dialogue: 0,0:07:27.26,0:07:29.78,Default,,0000,0000,0000,,Ууу... Ууууууууууууууу →
Dialogue: 0,0:07:29.78,0:07:32.14,Default,,0000,0000,0000,,Иә, түсіндім.
Dialogue: 0,0:07:32.14,0:07:35.17,Default,,0000,0000,0000,,Оны қабылдауға өзіңізді мәжбүрлеудің еш мәні жоқ.
Dialogue: 0,0:07:35.17,0:07:37.17,Default,,0000,0000,0000,,А... Сонымен...
Dialogue: 0,0:07:38.04,0:07:40.39,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:07:40.39,0:07:43.39,Default,,0000,0000,0000,,Сіз жеуге болатын барлық Коби сиыр еті ше?
Dialogue: 0,0:07:45.77,0:07:48.47,Default,,0000,0000,0000,,Түсіндім! Байқап көріңіз!
Dialogue: 0,0:07:48.47,0:07:50.99,Default,,0000,0000,0000,,Иә! →
Dialogue: 0,0:07:50.99,0:07:53.69,Default,,0000,0000,0000,,Рун-чан, сен қалаған мектепті таңдадың!
Dialogue: 0,0:07:53.69,0:07:57.73,Default,,0000,0000,0000,,Иә, жақсы. Мен анаммен сөйлесіп, шешім қабылдадым.
Dialogue: 0,0:07:57.73,0:08:00.09,Default,,0000,0000,0000,,Сонымен, сізде крам мектебінде тәрбиеші бар ма?
Dialogue: 0,0:08:00.09,0:08:02.95,Default,,0000,0000,0000,,Өзіңізді жанып тұрғандай сезінесіз~
Dialogue: 0,0:08:02.95,0:08:05.81,Default,,0000,0000,0000,,Тәрбиеші Хира-чанның да білетін адамы.
Dialogue: 0,0:08:05.81,0:08:07.81,Default,,0000,0000,0000,,Не? Қараңыз
Dialogue: 0,0:08:13.72,0:08:16.42,Default,,0000,0000,0000,,Таныстыру! Мен Тоору Сенсеймін!
Dialogue: 0,0:08:16.42,0:08:19.11,Default,,0000,0000,0000,,Сәлем, бірақ...→
Dialogue: 0,0:08:19.11,0:08:21.97,Default,,0000,0000,0000,,Мен оның Тоору-чан екеніне сенімдімін...
Dialogue: 0,0:08:21.97,0:08:25.00,Default,,0000,0000,0000,,Иә. Бұл дұрыс, бірақ көзілдірік - бұл міндетті түрде.
Dialogue: 0,0:08:25.00,0:08:29.00,Default,,0000,0000,0000,,Мен мұғаліммін, сондықтан көзілдірік туралы айтпаймын.
Dialogue: 0,0:08:31.40,0:08:33.75,Default,,0000,0000,0000,,Оқуды бастайық
Dialogue: 0,0:08:33.75,0:08:35.94,Default,,0000,0000,0000,,О! сықырлау шықырлау (шапалақтау)
Dialogue: 0,0:08:35.94,0:08:37.96,Default,,0000,0000,0000,,Оңай нәрседен бастаңыз.
Dialogue: 0,0:08:37.96,0:08:39.96,Default,,0000,0000,0000,,Ох~ Сырт Сырт Сырт
Dialogue: 0,0:08:45.71,0:08:47.71,Default,,0000,0000,0000,,О? Гача!
Dialogue: 0,0:08:51.77,0:08:54.63,Default,,0000,0000,0000,,Осының барлығын қазір есіңізде сақтаңыз.
Dialogue: 0,0:08:54.63,0:08:56.32,Default,,0000,0000,0000,,О, о...
Dialogue: 0,0:08:56.32,0:08:58.01,Default,,0000,0000,0000,,Негізгі Бұл жай ғана есте сақтау
Dialogue: 0,0:08:58.01,0:09:01.36,Default,,0000,0000,0000,,Немесе… үйінді…
Dialogue: 0,0:09:01.36,0:09:07.93,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:09:07.93,0:09:09.93,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:09:12.31,0:09:14.33,Default,,0000,0000,0000,,Дженга~! шытырлақ шытырлақ
Dialogue: 0,0:09:14.33,0:09:24.77,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:09:24.77,0:09:27.77,Default,,0000,0000,0000,,Ха! Хмм...
Dialogue: 0,0:09:29.31,0:09:31.67,Default,,0000,0000,0000,,Жауап «а»!
Dialogue: 0,0:09:31.67,0:09:33.36,Default,,0000,0000,0000,,Иә! (Жұмбақ дауыс) 4-сұрақ – айла. →
Dialogue: 0,0:09:33.36,0:09:35.71,Default,,0000,0000,0000,,Абайлаңыз, ә!
Dialogue: 0,0:09:35.71,0:09:39.71,Default,,0000,0000,0000,,≪Не? Мына дауыс менің басыма не айтып тұр?
Dialogue: 0,0:09:42.28,0:09:45.63,Default,,0000,0000,0000,,≪Оң қолым өз қолым болмағандай→
Dialogue: 0,0:09:45.63,0:09:48.00,Default,,0000,0000,0000,,Жауабын жазыңыз... Не болып жатыр!?≫
Dialogue: 0,0:09:48.00,0:09:51.37,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:09:51.37,0:09:53.37,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:55.41,0:09:57.76,Default,,0000,0000,0000,,Сіз жақсысыз ба?
Dialogue: 0,0:09:57.76,0:10:03.98,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:03.98,0:10:06.35,Default,,0000,0000,0000,,Әй, әріптер! Күте тұрыңыз!
Dialogue: 0,0:10:06.35,0:10:09.04,Default,,0000,0000,0000,,Күрсін... Күрсін... Мен мұнымен мәселені шеше алмаймын!
Dialogue: 0,0:10:09.04,0:10:12.04,Default,,0000,0000,0000,,Аа, иә... А, не?
Dialogue: 0,0:10:15.10,0:10:17.10,Default,,0000,0000,0000,,Рун-чан, оян
Dialogue: 0,0:10:18.64,0:10:20.64,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:23.85,0:10:25.85,Default,,0000,0000,0000,,Арман? Иә
Dialogue: 0,0:10:28.40,0:10:47.43,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:47.43,0:10:55.84,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:55.84,0:10:58.84,Default,,0000,0000,0000,,О, сіздің бағаларыңыз жақсарды.
Dialogue: 0,0:10:59.05,0:11:02.74,Default,,0000,0000,0000,,Уфуфу~ Мен оянғанда →
Dialogue: 0,0:11:02.74,0:11:04.76,Default,,0000,0000,0000,,Анықтамалық кітаптарды қарап отырамын~
Dialogue: 0,0:11:04.76,0:11:06.76,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:11:08.47,0:11:11.34,Default,,0000,0000,0000,,≪Анықтамалық кітаптардың бәрі тоз-тоз болғанша...≫
Dialogue: 0,0:11:11.34,0:11:14.36,Default,,0000,0000,0000,,А, кешіріңіз, иә?
Dialogue: 0,0:11:14.36,0:11:16.88,Default,,0000,0000,0000,,Мен оны ваннаға тастадым.
Dialogue: 0,0:11:16.88,0:11:18.07,Default,,0000,0000,0000,,Иә! Сіз бәрін тастадыңыз ба!?
Dialogue: 0,0:11:18.07,0:11:20.07,Default,,0000,0000,0000,,Мен оны кейінірек қайта сатып аламын
Dialogue: 0,0:11:23.62,0:11:25.62,Default,,0000,0000,0000,,Олай болса, кеттік!
Dialogue: 0,0:11:28.34,0:11:31.87,Default,,0000,0000,0000,,≪Run-chan, бар күшіңізді салыңыз≫
Dialogue: 0,0:11:31.87,0:11:37.09,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:11:37.09,0:11:39.45,Default,,0000,0000,0000,,Иә, сосын қоңырау соғылғанда→
Dialogue: 0,0:11:39.45,0:11:42.64,Default,,0000,0000,0000,,Сұрақ парағын аударып, бастаңыз.
Dialogue: 0,0:11:42.64,0:11:44.17,Default,,0000,0000,0000,,≪Орындаймыз! ≫
Dialogue: 0,0:11:44.17,0:11:47.86,Default,,0000,0000,0000,,Кеен... (камате) басы
Dialogue: 0,0:11:47.86,0:11:50.39,Default,,0000,0000,0000,,Бастысы! мм... а?
Dialogue: 0,0:11:50.39,0:11:53.92,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:11:53.92,0:11:55.77,Default,,0000,0000,0000,,Ах... келесі қарындаш!
Dialogue: 0,0:11:55.77,0:11:58.80,Default,,0000,0000,0000,,≪ кедергі келтірді ме? ≫
Dialogue: 0,0:11:58.80,0:12:01.16,Default,,0000,0000,0000,,≪Ал... Токио қорқынышты≫
Dialogue: 0,0:12:01.16,0:12:04.02,Default,,0000,0000,0000,,Кин... (Камате) Иә→
Dialogue: 0,0:12:04.02,0:12:07.02,Default,,0000,0000,0000,,Жауап парақтарын жинаңыз
Dialogue: 0,0:12:08.40,0:12:10.76,Default,,0000,0000,0000,,Уф~ Ум...
Dialogue: 0,0:12:10.76,0:12:13.11,Default,,0000,0000,0000,,Не? Кешіріңіз, мен бұрын болдым →
Dialogue: 0,0:12:13.11,0:12:15.80,Default,,0000,0000,0000,,Қарындаш ұшты емес пе?
Dialogue: 0,0:12:15.80,0:12:19.85,Default,,0000,0000,0000,,Не? Ах... жарайды хаха, жақсы~
Dialogue: 0,0:12:19.85,0:12:21.85,Default,,0000,0000,0000,,≪Ешқандай кедергі болған жоқ па?≫
Dialogue: 0,0:12:23.05,0:12:27.75,Default,,0000,0000,0000,,А-а~ Ендеше, бүгін емтихан тапсыру үшін Қансайдан жол бойы барасың ба?
Dialogue: 0,0:12:27.75,0:12:30.29,Default,,0000,0000,0000,,Иә. Мен көктемде осында көшіп келемін. Сол себепті...
Dialogue: 0,0:12:30.29,0:12:33.82,Default,,0000,0000,0000,,Ах! Қансай туралы айтсақ... (Юко) А?
Dialogue: 0,0:12:33.82,0:12:37.36,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:12:37.36,0:12:39.88,Default,,0000,0000,0000,,Фуфуфу→
Dialogue: 0,0:12:39.88,0:12:41.73,Default,,0000,0000,0000,,Бұл бүгінгі бойтұмар.
Dialogue: 0,0:12:41.73,0:12:44.60,Default,,0000,0000,0000,,Е, сиыр құдайы шығар?
Dialogue: 0,0:12:44.60,0:12:57.05,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:12:57.05,0:13:01.09,Default,,0000,0000,0000,,Иә! Міне болды! Міне болды! Хехе
Dialogue: 0,0:13:01.09,0:13:03.95,Default,,0000,0000,0000,,Қараңызшы, менің нөмірім!
Dialogue: 0,0:13:03.95,0:13:06.48,Default,,0000,0000,0000,,Тооруға рахмет, мен емтиханды тапсырдым!
Dialogue: 0,0:13:06.48,0:13:09.18,Default,,0000,0000,0000,,Жоқ, Ран-чан көп жұмыс істегендіктен.
Dialogue: 0,0:13:09.18,0:13:11.18,Default,,0000,0000,0000,,Тодороки мен Бакуго!
Dialogue: 0,0:13:14.06,0:13:18.26,Default,,0000,0000,0000,,Осылай өтіп кеттім...
Dialogue: 0,0:13:18.26,0:13:22.80,Default,,0000,0000,0000,,Иә? (Юко) Жүгіру: Сен қолыңнан келгеннің бәрін жасадың.
Dialogue: 0,0:13:22.80,0:13:25.50,Default,,0000,0000,0000,,Сөздерді ұмытып қалмас үшін қолыңа жаз...
Dialogue: 0,0:13:25.50,0:13:27.36,Default,,0000,0000,0000,,Ах~ біз де ештеңені ұмытпаймыз деп үміттенемін →
Dialogue: 0,0:13:27.36,0:13:30.38,Default,,0000,0000,0000,,Менің қолымда жазатын нәрсе бар. Бірақ→
Dialogue: 0,0:13:30.38,0:13:32.08,Default,,0000,0000,0000,,Егер бұл сынақ болса, сіз алдайсыз.
Dialogue: 0,0:13:32.08,0:13:35.44,Default,,0000,0000,0000,,Мен күткендей, мен оны жудым.
Dialogue: 0,0:13:35.44,0:13:39.14,Default,,0000,0000,0000,,Бірақ мен оны бүкіл денеммен жазатын әдетке айналдым→
Dialogue: 0,0:13:39.14,0:13:42.14,Default,,0000,0000,0000,,Түсіру қиын болды. иә?
Dialogue: 0,0:16:04.43,0:16:11.66,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:16:11.66,0:16:15.53,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:16:15.53,0:16:17.53,Default,,0000,0000,0000,,（） ～
Dialogue: 0,0:16:20.09,0:16:23.45,Default,,0000,0000,0000,,Бүгін Тооруда сыйлық бар!
Dialogue: 0,0:16:23.45,0:16:25.14,Default,,0000,0000,0000,,Не? иә!
Dialogue: 0,0:16:25.14,0:16:28.14,Default,,0000,0000,0000,,Жақында менің туған күнім.
Dialogue: 0,0:16:29.01,0:16:31.53,Default,,0000,0000,0000,,Торт!? Торт!
Dialogue: 0,0:16:31.53,0:16:33.72,Default,,0000,0000,0000,,Бото! Ха!
Dialogue: 0,0:16:33.72,0:16:36.72,Default,,0000,0000,0000,,Ах! (2 адам) Аа...
Dialogue: 0,0:16:39.77,0:16:41.46,Default,,0000,0000,0000,,Бұл 3 секунд ережесі деп аталады, солай ма?
Dialogue: 0,0:16:41.46,0:16:44.82,Default,,0000,0000,0000,,Жоқ... Мен әбден төбемнен шықтым.
Dialogue: 0,0:16:44.82,0:16:46.84,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:16:46.84,0:16:48.03,Default,,0000,0000,0000,,Хэхе... Иә!
Dialogue: 0,0:16:48.03,0:16:50.88,Default,,0000,0000,0000,,Нақты нәрсе осында. иә?
Dialogue: 0,0:16:50.88,0:16:52.07,Default,,0000,0000,0000,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:16:52.07,0:16:56.62,Default,,0000,0000,0000,,Көңіл-күйді түсіріп, сосын көтерсең, қуаныш екі еселенеді деп естідім →
Dialogue: 0,0:16:56.62,0:16:59.65,Default,,0000,0000,0000,,Мен Тоорудың бақытты болғанын қалаймын!
Dialogue: 0,0:16:59.65,0:17:02.84,Default,,0000,0000,0000,,Сіз кімнен сұрадыңыз?
Dialogue: 0,0:17:02.84,0:17:06.04,Default,,0000,0000,0000,,Мен торт аламын. Мен оны енді тастамаймын →
Dialogue: 0,0:17:06.04,0:17:09.40,Default,,0000,0000,0000,,Жарайды. Жарайды.
Dialogue: 0,0:17:09.40,0:17:11.93,Default,,0000,0000,0000,,Бірақ Тоору багажды алып жүруі керек...
Dialogue: 0,0:17:11.93,0:17:13.45,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:17:13.45,0:17:15.45,Default,,0000,0000,0000,,Тоору, ашуландың ба?
Dialogue: 0,0:17:17.82,0:17:20.35,Default,,0000,0000,0000,,Тоору 16 жаста.
Dialogue: 0,0:17:20.35,0:17:22.70,Default,,0000,0000,0000,,Ол үлкейіп барады.
Dialogue: 0,0:17:22.70,0:17:26.91,Default,,0000,0000,0000,,Бұрын соншалықты кішкентай болатын. иә?
Dialogue: 0,0:17:26.91,0:17:29.77,Default,,0000,0000,0000,,Артымнан жорғалап жүріп...
Dialogue: 0,0:17:29.77,0:17:31.63,Default,,0000,0000,0000,,Не? Менде әрқашан кәмпит бар →
Dialogue: 0,0:17:31.63,0:17:35.17,Default,,0000,0000,0000,,Мен жылай бастадым. Бұл сүйкімді болды.
Dialogue: 0,0:17:35.17,0:17:38.70,Default,,0000,0000,0000,,Run-chan…. иә?
Dialogue: 0,0:17:38.70,0:17:40.72,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз? иә?
Dialogue: 0,0:17:40.72,0:17:44.76,Default,,0000,0000,0000,,Өткен күні көрген түс туралы әңгіме. арман?
Dialogue: 0,0:17:44.76,0:17:47.79,Default,,0000,0000,0000,,Қараңдаршы, менің бойым өсті.
Dialogue: 0,0:17:47.79,0:17:49.65,Default,,0000,0000,0000,,Бұл әлі кішкентай.
Dialogue: 0,0:17:49.65,0:17:52.67,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:17:52.67,0:17:54.53,Default,,0000,0000,0000,,Маған бала сияқты қарама!
Dialogue: 0,0:17:54.53,0:17:56.53,Default,,0000,0000,0000,,Хмм. Хехе.
Dialogue: 0,0:17:58.74,0:18:02.74,Default,,0000,0000,0000,,А, мен ақ шашты таптым! Ха!
Dialogue: 0,0:18:06.81,0:18:09.34,Default,,0000,0000,0000,,Мектепке торт әкелу үшін батыл болуың керек.
Dialogue: 0,0:18:09.34,0:18:12.87,Default,,0000,0000,0000,,Барлығына жетеді, түскі ас ішейік.
Dialogue: 0,0:18:12.87,0:18:15.06,Default,,0000,0000,0000,,Түскі асқа дейін қайда қалдыру керек?
Dialogue: 0,0:18:15.06,0:18:18.76,Default,,0000,0000,0000,,Түсіндім! Оны тоңазытқышта сақтау керек пе?
Dialogue: 0,0:18:18.76,0:18:20.79,Default,,0000,0000,0000,,Тоңазытқыш жоқ. (Юко) Тұрған жері→
Dialogue: 0,0:18:20.79,0:18:24.32,Default,,0000,0000,0000,,Мектептегі ең суық жерге не қалдырасың?
Dialogue: 0,0:18:24.32,0:18:26.51,Default,,0000,0000,0000,,Дәретхана?
Dialogue: 0,0:18:26.51,0:18:29.71,Default,,0000,0000,0000,,Сен де жейсің. →
Dialogue: 0,0:18:29.71,0:18:32.74,Default,,0000,0000,0000,,Дәлірек айтсақ, жақында Тоорудың туған күні келеді.
Dialogue: 0,0:18:32.74,0:18:35.60,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:18:35.60,0:18:37.12,Default,,0000,0000,0000,,Сол күні біз не істейміз?
Dialogue: 0,0:18:37.12,0:18:41.16,Default,,0000,0000,0000,,Жарайды! Мен сіздерге шара күні сыйлықтар дайындап қойдым.
Dialogue: 0,0:18:41.16,0:18:45.36,Default,,0000,0000,0000,,Иә? Мен кеше Тоору қалаған кітапты оқыдым→
Dialogue: 0,0:18:45.36,0:18:47.22,Default,,0000,0000,0000,,Мен саған сыйлық беремін. рақмет сізге.
Dialogue: 0,0:18:47.22,0:18:50.25,Default,,0000,0000,0000,,Хмм, біз...
Dialogue: 0,0:18:50.25,0:18:54.46,Default,,0000,0000,0000,,Кубок. кесе? Қандай түрі? →
Dialogue: 0,0:18:54.46,0:18:56.81,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:18:56.81,0:18:59.81,Default,,0000,0000,0000,,Е кесе. (Юко) Иә... иә~!
Dialogue: 0,0:19:00.52,0:19:04.72,Default,,0000,0000,0000,,Торт нашарлап кетпей тұрып, қазір жеп алайық.
Dialogue: 0,0:19:04.72,0:19:08.43,Default,,0000,0000,0000,,Дұрыс. (Юко) Иә.
Dialogue: 0,0:19:08.43,0:19:10.12,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:19:10.12,0:19:12.30,Default,,0000,0000,0000,,Ұнады! (Юко) Дәмді!
Dialogue: 0,0:19:12.30,0:19:14.66,Default,,0000,0000,0000,,Қызықты ойын! (3 адам) Иә?
Dialogue: 0,0:19:14.66,0:19:18.69,Default,,0000,0000,0000,,Негізі бұлардың бірі васаби торты!
Dialogue: 0,0:19:18.69,0:19:21.06,Default,,0000,0000,0000,,Сіз әдеттегідей тойлай алмайсыз ба?
Dialogue: 0,0:19:21.06,0:19:25.10,Default,,0000,0000,0000,,Жасыл бар екені анық... Ол анық!
Dialogue: 0,0:19:25.10,0:19:27.10,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:19:30.32,0:19:33.51,Default,,0000,0000,0000,,Мен Юкоға дәмді рөлді беремін.
Dialogue: 0,0:19:33.51,0:19:35.03,Default,,0000,0000,0000,,Иә! Бұл Қансай ғой.
Dialogue: 0,0:19:35.03,0:19:37.39,Default,,0000,0000,0000,,Мен қызғанамын.
Dialogue: 0,0:19:37.39,0:19:41.42,Default,,0000,0000,0000,,Гохо! Гохо! Енді жейміз бе?
Dialogue: 0,0:19:41.42,0:19:43.95,Default,,0000,0000,0000,,Аму…. Хмм!
Dialogue: 0,0:19:43.95,0:19:46.81,Default,,0000,0000,0000,,Бірақ таң қалмаңыз. Васаби қосылған торт →
Dialogue: 0,0:19:46.81,0:19:48.83,Default,,0000,0000,0000,,Негізі тағы бір нәрсе бар... уф...→
Dialogue: 0,0:19:48.83,0:19:50.83,Default,,0000,0000,0000,,Гохо! Гохо, гохо! Рун-чан!?
Dialogue: 0,0:19:54.06,0:19:57.09,Default,,0000,0000,0000,,Торт өте сүйкімді.
Dialogue: 0,0:19:57.09,0:19:59.09,Default,,0000,0000,0000,,Бип... Каша!
Dialogue: 0,0:20:02.80,0:20:05.00,Default,,0000,0000,0000,,Каша! О, кәдесый фото?
Dialogue: 0,0:20:05.00,0:20:07.69,Default,,0000,0000,0000,,Гохо! Иә.
Dialogue: 0,0:20:07.69,0:20:10.38,Default,,0000,0000,0000,,Бәріміз бірге суретке түсейік!
Dialogue: 0,0:20:10.38,0:20:12.07,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:20:12.07,0:20:14.43,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:20:14.43,0:20:17.45,Default,,0000,0000,0000,,Каша! (Юко) Ах.
Dialogue: 0,0:20:17.45,0:20:20.65,Default,,0000,0000,0000,,Юуко Бұлыңғыр... (Юко) Иә! →
Dialogue: 0,0:20:20.65,0:20:22.17,Default,,0000,0000,0000,,Мен қозғала алмаймын!
Dialogue: 0,0:20:22.17,0:20:24.86,Default,,0000,0000,0000,,Бірте-бірте қозғалмай ма?
Dialogue: 0,0:20:24.86,0:20:26.05,Default,,0000,0000,0000,,Mokkai Revenge!
Dialogue: 0,0:20:26.05,0:20:29.05,Default,,0000,0000,0000,,Олай болса барлығымыз Юуконы баптайық!
Dialogue: 0,0:20:31.26,0:20:34.79,Default,,0000,0000,0000,,Ах... эй! Әдеттегідей суретке түсіріңіз!
Dialogue: 0,0:20:34.79,0:20:37.31,Default,,0000,0000,0000,,Каша! (Юко) А, менің үйім көшіп бара жатқан еді. →
Dialogue: 0,0:20:37.31,0:20:39.84,Default,,0000,0000,0000,,Моккай! Сонда кездескенше →
Dialogue: 0,0:20:39.84,0:20:41.86,Default,,0000,0000,0000,,Мен Юкомен бірге барамын. Сен~жоқ.
Dialogue: 0,0:20:41.86,0:20:43.88,Default,,0000,0000,0000,,Каша! (Юко) Ах~ Қайтадан қозғалды!
Dialogue: 0,0:20:43.88,0:20:46.88,Default,,0000,0000,0000,,Ахахха! (Юко) Қазірдің өзінде!
Dialogue: 0,0:20:49.44,0:20:52.64,Default,,0000,0000,0000,,Иә, кешегі күннен жалғастырайық. →
Dialogue: 0,0:20:52.64,0:20:55.33,Default,,0000,0000,0000,,Кеше біз Кавальери → принципін қолдандық
Dialogue: 0,0:20:55.33,0:20:58.03,Default,,0000,0000,0000,,Шардың көлемі мен бетінің ауданын есептеу формуласы...
Dialogue: 0,0:20:58.03,0:21:01.05,Default,,0000,0000,0000,,Иә. иә?
Dialogue: 0,0:21:01.05,0:21:03.08,Default,,0000,0000,0000,,Иә, иә….
Dialogue: 0,0:21:03.08,0:21:05.08,Default,,0000,0000,0000,,≪Турун? Ах! →
Dialogue: 0,0:21:06.45,0:21:09.14,Default,,0000,0000,0000,,Торт! Бұл... бұл →
Dialogue: 0,0:21:09.14,0:21:12.84,Default,,0000,0000,0000,,Ум, мм, мм... аа~! ≫
Dialogue: 0,0:21:12.84,0:21:15.54,Default,,0000,0000,0000,,Иә! (Кито) Төменгі жағындағы → диаметрін түртіңіз
Dialogue: 0,0:21:15.54,0:21:18.39,Default,,0000,0000,0000,,Цилиндр конусы…. Хаха!
Dialogue: 0,0:21:18.39,0:21:20.92,Default,,0000,0000,0000,,Тоорун! Тоорун!
Dialogue: 0,0:21:20.92,0:21:22.92,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:24.79,0:21:26.48,Default,,0000,0000,0000,,≪Құттықтаймыз! ≫
Dialogue: 0,0:21:26.48,0:21:28.66,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:21:28.66,0:21:33.05,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:21:33.05,0:21:36.41,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:21:36.41,0:21:38.77,Default,,0000,0000,0000,,Иә!! (Кито) Иә. Олай болса, Ютака-сан→
Dialogue: 0,0:21:38.77,0:21:42.30,Default,,0000,0000,0000,,Осы есепті шешіңіз. Иә!!
Dialogue: 0,0:21:42.30,0:21:46.30,Default,,0000,0000,0000,,Кин Хон Хан…
Dialogue: 0,0:21:48.36,0:21:51.39,Default,,0000,0000,0000,,Қараңыз! Қараңдар, қараңдар!
Dialogue: 0,0:21:51.39,0:21:53.91,Default,,0000,0000,0000,,Иә?не?
Dialogue: 0,0:21:53.91,0:21:56.94,Default,,0000,0000,0000,,Қабылдау емтиханында оқып жатқан суретім!
Dialogue: 0,0:21:56.94,0:21:59.64,Default,,0000,0000,0000,,Екі жыл бұрын? (Юко) Ол торт жеп жатыр.
Dialogue: 0,0:21:59.64,0:22:02.34,Default,,0000,0000,0000,,Иә. Бұл күн Тоорудың туған күні еді.
Dialogue: 0,0:22:02.34,0:22:05.20,Default,,0000,0000,0000,,Неге мені тамақтандырып жатырсың?
Dialogue: 0,0:22:05.20,0:22:08.90,Default,,0000,0000,0000,,Себебі сіз тест тапсырушысыз.
Dialogue: 0,0:22:08.90,0:22:12.10,Default,,0000,0000,0000,,Не? Иә, туған күнің құтты болсын→
Dialogue: 0,0:22:12.10,0:22:14.46,Default,,0000,0000,0000,,Тоору! Аа!?
Dialogue: 0,0:22:14.46,0:22:17.66,Default,,0000,0000,0000,,Бірақ мен сыйлықты ұмытпаған шығармын.
Dialogue: 0,0:22:17.66,0:22:20.35,Default,,0000,0000,0000,,Иә, бәрі осы.
Dialogue: 0,0:22:20.35,0:22:22.70,Default,,0000,0000,0000,,Қалғаны... Дыбыстық сигнал
Dialogue: 0,0:22:22.70,0:22:24.39,Default,,0000,0000,0000,,Қарау. иә? бұл?
Dialogue: 0,0:22:24.39,0:22:28.92,Default,,0000,0000,0000,,Бұл өткен жылы Тоорудың туған күні болатын.
Dialogue: 0,0:22:28.92,0:22:31.12,Default,,0000,0000,0000,,Бұл жолы емтихан алушы Тоору ма? иә.
Dialogue: 0,0:22:31.12,0:22:34.65,Default,,0000,0000,0000,,Тоору емтихан тапсырып жатқандықтан, жақсы деді→
Dialogue: 0,0:22:34.65,0:22:37.69,Default,,0000,0000,0000,,Мен саған сыйлық пен торт бергім келеді.
Dialogue: 0,0:22:37.69,0:22:40.88,Default,,0000,0000,0000,,Хехе... Дәлірек айтқанда, мені мазаламайсың ба?
Dialogue: 0,0:22:40.88,0:22:44.09,Default,,0000,0000,0000,,Иә~ Бұл дұрыс емес. Эй, Тоору.
Dialogue: 0,0:22:44.09,0:22:47.46,Default,,0000,0000,0000,,Хмм…. Тоору да көп жұмыс істеді.
Dialogue: 0,0:22:47.46,0:22:51.32,Default,,0000,0000,0000,,Хехе. Және…→
Dialogue: 0,0:22:51.32,0:22:56.37,Default,,0000,0000,0000,,Я~! Бұл биылғы естелік сурет!
Dialogue: 0,0:22:56.37,0:22:58.90,Default,,0000,0000,0000,,Хаха! (Юко) Иә! →
Dialogue: 0,0:22:58.90,0:23:00.25,Default,,0000,0000,0000,,Эй, бұл ненің фотосы?
Dialogue: 0,0:23:00.25,0:23:02.77,Default,,0000,0000,0000,,Мен оны Тоорудан алдым! (Юко) Қазірдің өзінде! →
Dialogue: 0,0:23:02.77,0:23:05.47,Default,,0000,0000,0000,,Оны өшіріңіз. Иә~ маған ұнамайды~!
Dialogue: 0,0:23:05.47,0:23:08.16,Default,,0000,0000,0000,,Таку…. Кеттік, Тоору!
Dialogue: 0,0:23:08.16,0:23:10.02,Default,,0000,0000,0000,,Иә. Эй!
Dialogue: 0,0:23:10.02,0:23:22.47,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:22.47,0:23:31.89,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:31.89,0:23:43.17,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:43.17,0:23:54.12,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:54.12,0:24:03.55,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:03.55,0:24:13.48,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:13.48,0:24:17.52,Default,,0000,0000,0000,,Ей, Тоору, келесі жылы да бәріміз торт жейміз.
Dialogue: 0,0:24:17.52,0:24:20.04,Default,,0000,0000,0000,,Васаби тортынан бас тартыңыз.
Dialogue: 0,0:24:20.04,0:24:23.74,Default,,0000,0000,0000,,Ей, біз келесі жылы емтихан тапсырамыз.
Dialogue: 0,0:24:23.74,0:24:26.95,Default,,0000,0000,0000,,Наги қазірдің өзінде! Қорқынышты нәрселерді айтпаңыз!
Dialogue: 0,0:24:26.95,0:24:29.64,Default,,0000,0000,0000,,Сіз не айттыңыз? Бұл шындық.
Dialogue: 0,0:24:29.64,0:24:32.33,Default,,0000,0000,0000,,Мен… келесі жылы біз → көремін
Dialogue: 0,0:24:32.33,0:24:34.69,Default,,0000,0000,0000,,Сіз тест тапсырушысыз.
Dialogue: 0,0:24:34.69,0:24:36.38,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:24:36.38,0:24:42.38,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:46.31,0:24:48.31,Default,,0000,0000,0000,,Емтихан….
Dialogue: 0,0:24:50.01,0:24:52.36,Default,,0000,0000,0000,,Ал, мен бүгін осындамын.
Dialogue: 0,0:24:52.36,0:24:54.36,Default,,0000,0000,0000,,Қош бол.
Dialogue: 0,0:24:57.75,0:24:59.77,Default,,0000,0000,0000,,Уақыт өте тез өтіп кеткен сияқты.
Dialogue: 0,0:24:59.77,0:25:02.47,Default,,0000,0000,0000,,Күні кеше мен Тоору мектепке кірді деп ойладым →
Dialogue: 0,0:25:02.47,0:25:05.33,Default,,0000,0000,0000,,Ол қазірдің өзінде екінші курс студенті.
Dialogue: 0,0:25:05.33,0:25:07.68,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:25:07.68,0:25:10.68,Default,,0000,0000,0000,,≪Сосын Рун-чан үшінші курс студенті болады...≫
Dialogue: 0,0:25:12.40,0:25:21.33,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:21.33,0:25:32.44,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:32.44,0:25:34.79,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:25:34.79,0:25:53.14,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:53.14,0:25:56.84,Default,,0000,0000,0000,,...
Dialogue: 0,0:25:56.84,0:25:58.84,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:26:00.88,0:26:03.74,Default,,0000,0000,0000,,Мм→
Dialogue: 0,0:26:03.74,0:26:06.44,Default,,0000,0000,0000,,Ештеңе. иә?
Dialogue: 0,0:26:06.44,0:26:09.97,Default,,0000,0000,0000,,Иә. Ойланып қарашы, Сарун-чан.
Dialogue: 0,0:26:09.97,0:26:11.49,Default,,0000,0000,0000,,Иә? Тым кеш болса да →
Dialogue: 0,0:26:11.49,0:26:13.01,Default,,0000,0000,0000,,Неліктен осы орта мектепке ауыстыңыз?
Dialogue: 0,0:26:13.01,0:26:16.04,Default,,0000,0000,0000,,Хмм, неге олай ойлайсың?
Dialogue: 0,0:26:16.04,0:26:19.40,Default,,0000,0000,0000,,Айтыңызшы. Х-ми-цу~!
Dialogue: 0,0:26:19.40,0:26:21.75,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:26:21.75,0:26:25.75,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:27.48,0:26:37.25,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:37.25,0:26:40.25,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:41.62,0:26:55.60,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:55.60,0:27:09.73,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:09.73,0:27:28.43,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:28.43,0:27:35.43,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:45.43,0:27:54.43,Default,,0000,0000,0000,,Сен
