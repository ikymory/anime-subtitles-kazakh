Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:50.79,0:01:54.33,Default,,0000,0000,0000,,Қайырлы таң, Ран-чан. Қайырлы таң.
Dialogue: 0,0:01:54.33,0:01:57.03,Default,,0000,0000,0000,,Сіз шалбар киіп жүрсіз бе? әрине!
Dialogue: 0,0:01:57.03,0:02:00.39,Default,,0000,0000,0000,,Енді ұйықтауға болмайды!
Dialogue: 0,0:02:00.39,0:02:02.39,Default,,0000,0000,0000,,Жүр, кеттік!
Dialogue: 0,0:02:03.42,0:02:06.11,Default,,0000,0000,0000,,Уау. Ах...
Dialogue: 0,0:02:06.11,0:02:08.47,Default,,0000,0000,0000,,Run-chan….
Dialogue: 0,0:02:08.47,0:02:20.47,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:23.95,0:02:34.73,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:34.73,0:02:39.73,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:41.14,0:02:49.88,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:49.88,0:02:53.88,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:02:55.10,0:03:06.71,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:06.71,0:03:14.46,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:14.46,0:03:21.70,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:21.70,0:03:24.70,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:29.61,0:03:37.61,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:43.42,0:03:46.45,Default,,0000,0000,0000,,(Репортер) Оны бұрын бір жерде көргендеймін, бірақ мүмкін қате естіппін…
Dialogue: 0,0:03:46.45,0:03:48.45,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:03:50.82,0:03:54.03,Default,,0000,0000,0000,,Пуха~! Өйткені, көмір қышқылы сізді ояту үшін жұмыс істемейді!
Dialogue: 0,0:03:54.03,0:03:57.89,Default,,0000,0000,0000,,Кофе бар, солай ма? иә?
Dialogue: 0,0:03:57.89,0:03:59.41,Default,,0000,0000,0000,,Көзім жыпылықтайды →
Dialogue: 0,0:03:59.41,0:04:02.44,Default,,0000,0000,0000,,Бірден оянасыз. Бұл солай ма?
Dialogue: 0,0:04:02.44,0:04:04.79,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:04:04.79,0:04:06.48,Default,,0000,0000,0000,,Керемет кадр! Эххе~.
Dialogue: 0,0:04:06.48,0:04:08.17,Default,,0000,0000,0000,,Ойланып қарасам, бүгін әлі Тоору→
Dialogue: 0,0:04:08.17,0:04:11.36,Default,,0000,0000,0000,,Мен оны көрген жоқпын. Мен бүгін кезекшімін →
Dialogue: 0,0:04:11.36,0:04:15.24,Default,,0000,0000,0000,,Таңертең бос емес екеніңді естідім. (Юко) Солай ма? →
Dialogue: 0,0:04:15.24,0:04:19.11,Default,,0000,0000,0000,,Біз әрқашан біргеміз, сондықтан мен сенсіз жалғыз сезінемін.
Dialogue: 0,0:04:19.11,0:04:22.11,Default,,0000,0000,0000,,Дұрыс. Бірақ, егер мен кезекшілікте болсам, көмектесе алмаймын деп ойлаймын. →
Dialogue: 0,0:04:24.16,0:04:27.16,Default,,0000,0000,0000,,Иә. (Юко) Не ​​болды? Наги.
Dialogue: 0,0:04:28.37,0:04:31.23,Default,,0000,0000,0000,,Эй, қарағың келмей ме?
Dialogue: 0,0:04:31.23,0:04:34.10,Default,,0000,0000,0000,,Иә? Не?
Dialogue: 0,0:04:34.10,0:04:36.10,Default,,0000,0000,0000,,1-сынып Тоору.
Dialogue: 0,0:04:42.18,0:04:45.71,Default,,0000,0000,0000,,Қараңдаршы! Бұл дудл.
Dialogue: 0,0:04:45.71,0:04:47.23,Default,,0000,0000,0000,,Ол әлі де болды.
Dialogue: 0,0:04:47.23,0:04:49.42,Default,,0000,0000,0000,,Менің ойымша, ол ойылғандықтан өшірілмейді. →
Dialogue: 0,0:04:49.42,0:04:52.27,Default,,0000,0000,0000,,Одан да жылдам жүрейік.
Dialogue: 0,0:04:52.27,0:04:54.13,Default,,0000,0000,0000,,А, күте тұрыңыз!
Dialogue: 0,0:04:54.13,0:04:58.33,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:58.33,0:05:01.03,Default,,0000,0000,0000,,Бірінші сынып кабинеті Мен сағыныш сезінемін.
Dialogue: 0,0:05:01.03,0:05:03.39,Default,,0000,0000,0000,,Бұл баяғыда болды. →
Dialogue: 0,0:05:03.39,0:05:06.42,Default,,0000,0000,0000,,О, солай ма? Торудың сыныбы.
Dialogue: 0,0:05:06.42,0:05:08.42,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:05:11.80,0:05:14.32,Default,,0000,0000,0000,,Тору сыныпта қандай?
Dialogue: 0,0:05:14.32,0:05:16.52,Default,,0000,0000,0000,,Менен қорқасың ба?
Dialogue: 0,0:05:16.52,0:05:19.71,Default,,0000,0000,0000,,Тоору таң қаларлықтай құрметті студент.
Dialogue: 0,0:05:19.71,0:05:21.07,Default,,0000,0000,0000,,Өтірік! Бұл зорлық-зомбылық бейне болса да!
Dialogue: 0,0:05:21.07,0:05:24.43,Default,,0000,0000,0000,,Иә! Ба... жарғанатты сермеу →
Dialogue: 0,0:05:24.43,0:05:27.12,Default,,0000,0000,0000,,Бүкіл сынып қанға боялған ба деп ойлаймын...
Dialogue: 0,0:05:27.12,0:05:29.48,Default,,0000,0000,0000,,Мен олай ойламаймын...
Dialogue: 0,0:05:29.48,0:05:31.50,Default,,0000,0000,0000,,Мұғалім, аяқталды.
Dialogue: 0,0:05:31.50,0:05:34.53,Default,,0000,0000,0000,,Аа, әдеттегідей рахмет.
Dialogue: 0,0:05:34.53,0:05:36.21,Default,,0000,0000,0000,,Мм... мұндағы ұлдар саны →
Dialogue: 0,0:05:36.21,0:05:39.41,Default,,0000,0000,0000,,Мен қате жібердім, сондықтан оны түзеттім.
Dialogue: 0,0:05:39.41,0:05:42.78,Default,,0000,0000,0000,,Жақсы болды ма? Расында ма?
Dialogue: 0,0:05:42.78,0:05:45.80,Default,,0000,0000,0000,,Бұл менің қателігім болды. →
Dialogue: 0,0:05:45.80,0:05:47.99,Default,,0000,0000,0000,,Рахмет. Бұл көмектесті.
Dialogue: 0,0:05:47.99,0:05:49.68,Default,,0000,0000,0000,,Жоқ, бұл шектен шыққан.
Dialogue: 0,0:05:49.68,0:05:52.55,Default,,0000,0000,0000,,To-o-ru! Апыр-ай!
Dialogue: 0,0:05:52.55,0:05:56.42,Default,,0000,0000,0000,,``Бұл өте ұят.'' Дұрыс, балам.
Dialogue: 0,0:05:56.42,0:05:59.45,Default,,0000,0000,0000,,Менен көмек сұрады. Мынау~!
Dialogue: 0,0:05:59.45,0:06:01.30,Default,,0000,0000,0000,,≪Неге мұндасың...≫
Dialogue: 0,0:06:01.30,0:06:05.84,Default,,0000,0000,0000,,Кин Хон Хан…
Dialogue: 0,0:06:05.84,0:06:07.69,Default,,0000,0000,0000,,Мм... Иә?
Dialogue: 0,0:06:07.69,0:06:11.24,Default,,0000,0000,0000,,Мен оқулығымды ұмытып қалдым. Саған көрсетуге бола ма?
Dialogue: 0,0:06:11.24,0:06:14.76,Default,,0000,0000,0000,,Жарайды. рақмет сізге.
Dialogue: 0,0:06:14.76,0:06:16.76,Default,,0000,0000,0000,,Гатта! иә….
Dialogue: 0,0:06:18.13,0:06:20.16,Default,,0000,0000,0000,,Хмм... Кешіріңіз→
Dialogue: 0,0:06:20.16,0:06:23.02,Default,,0000,0000,0000,,Бүгін сізбен байланысуды ұмытып кетіппін.
Dialogue: 0,0:06:23.02,0:06:28.73,Default,,0000,0000,0000,,Сонымен... дұрыс. А... а~ мен оны көрмеймін.
Dialogue: 0,0:06:28.73,0:06:30.25,Default,,0000,0000,0000,,≪Жақын...≫
Dialogue: 0,0:06:30.25,0:06:33.12,Default,,0000,0000,0000,,Кин Хон Хан…
Dialogue: 0,0:06:33.12,0:06:36.15,Default,,0000,0000,0000,,Сізге көп рахмет. →
Dialogue: 0,0:06:36.15,0:06:39.67,Default,,0000,0000,0000,,Көмегің үшін рахмет. үй….
Dialogue: 0,0:06:39.67,0:06:41.20,Default,,0000,0000,0000,,Менің атым Ютака.
Dialogue: 0,0:06:41.20,0:06:44.07,Default,,0000,0000,0000,,Негізі мен сізбен біраздан бері сөйлескім келді.
Dialogue: 0,0:06:44.07,0:06:48.77,Default,,0000,0000,0000,,Бірақ менің мүмкіндігім болмады. Аа, дұрыс...
Dialogue: 0,0:06:48.77,0:06:50.46,Default,,0000,0000,0000,,Дос болуды жалғастырыңыз →
Dialogue: 0,0:06:50.46,0:06:52.98,Default,,0000,0000,0000,,Тоорун!
Dialogue: 0,0:06:52.98,0:06:54.33,Default,,0000,0000,0000,,Иә!?
Dialogue: 0,0:06:54.33,0:06:58.03,Default,,0000,0000,0000,,Түрту... (аяқ дыбыстары)
Dialogue: 0,0:06:58.03,0:07:01.73,Default,,0000,0000,0000,,Сіздің келгеніңіздің белгісі ретінде мен сізге шырын сатып алайын!
Dialogue: 0,0:07:01.73,0:07:03.09,Default,,0000,0000,0000,,А... Аа, күте тұрыңыз! Енді ше!? Хахаха….
Dialogue: 0,0:07:03.09,0:07:10.32,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:10.32,0:07:12.84,Default,,0000,0000,0000,,Иә? Тоору?
Dialogue: 0,0:07:12.84,0:07:15.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:15.20,0:07:18.40,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:07:18.40,0:07:20.40,Default,,0000,0000,0000,,Тағы бір Қан Құбыжық Өнері ме?
Dialogue: 0,0:07:22.44,0:07:25.80,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:25.80,0:07:28.16,Default,,0000,0000,0000,,Не? Бұл сирек.
Dialogue: 0,0:07:28.16,0:07:31.36,Default,,0000,0000,0000,,Иә? Хмм... ауырады... қандай да бір түрде қатайта аласыз ба? →
Dialogue: 0,0:07:31.36,0:07:33.05,Default,,0000,0000,0000,,Итатата!
Dialogue: 0,0:07:33.05,0:07:36.75,Default,,0000,0000,0000,,Тоору, не болды? мінеки біз?
Dialogue: 0,0:07:36.75,0:07:39.78,Default,,0000,0000,0000,,Ха ха ха ха. →
Dialogue: 0,0:07:39.78,0:07:43.48,Default,,0000,0000,0000,,Сізді күткенім үшін кешіріңіз, Тоорун! Мен екіншісін сатып алдым. →
Dialogue: 0,0:07:43.48,0:07:47.48,Default,,0000,0000,0000,,Иә? Тоорун? Қайда бардың? Тоорун!
Dialogue: 0,0:07:49.04,0:07:55.11,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:55.11,0:07:57.11,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:07:59.98,0:08:01.98,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:08:04.36,0:08:06.71,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:08:06.71,0:08:11.60,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:08:11.60,0:08:13.79,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:08:13.79,0:08:16.79,Default,,0000,0000,0000,,Ах! Бұл жақсы ма?
Dialogue: 0,0:08:19.34,0:08:21.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:21.03,0:08:23.03,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:08:25.23,0:08:27.42,Default,,0000,0000,0000,,Иә? (Сато) Маңдайың әдемі екен.
Dialogue: 0,0:08:27.42,0:08:30.62,Default,,0000,0000,0000,,≪Рун бейтаныс адаммен сөйлесіп тұр ма? ≫
Dialogue: 0,0:08:30.62,0:08:33.32,Default,,0000,0000,0000,,≪Қызық... бұл не? Сол өрнекті көйлек≫
Dialogue: 0,0:08:33.32,0:08:36.85,Default,,0000,0000,0000,,Сол жерде. (Сато) Түсінемін. Рақмет сізге.
Dialogue: 0,0:08:36.85,0:08:39.88,Default,,0000,0000,0000,,Сонда кездескенше. Ах.
Dialogue: 0,0:08:39.88,0:08:42.91,Default,,0000,0000,0000,,Наги-чан! Ей... Эй, сен енді кімсің?
Dialogue: 0,0:08:42.91,0:08:45.44,Default,,0000,0000,0000,,Тіпті жаңа денсаулық мұғалімі.
Dialogue: 0,0:08:45.44,0:08:49.31,Default,,0000,0000,0000,,Сіз адасып кеткен сияқтысыз. Аа~ Дұрыс.
Dialogue: 0,0:08:49.31,0:08:51.33,Default,,0000,0000,0000,,Ол күдікті адам ба деп ойлаймын...
Dialogue: 0,0:08:51.33,0:08:53.85,Default,,0000,0000,0000,,Сондай-ақ, «Маңдайың әдемі.→
Dialogue: 0,0:08:53.85,0:08:56.88,Default,,0000,0000,0000,,Мені мақтап: «Бұл өте жақсы!» дедім.
Dialogue: 0,0:08:56.88,0:08:59.88,Default,,0000,0000,0000,,Біртүрлі емес пе? бұл….
Dialogue: 0,0:09:00.42,0:09:04.12,Default,,0000,0000,0000,,Иә~ Жаңа денсаулық мұғалімі?
Dialogue: 0,0:09:04.12,0:09:07.16,Default,,0000,0000,0000,,Күдікті көрінеді.
Dialogue: 0,0:09:07.16,0:09:10.52,Default,,0000,0000,0000,,Бірақ қыздар арасында танымал болатын сияқты... →
Dialogue: 0,0:09:10.52,0:09:12.70,Default,,0000,0000,0000,,≪Ол қайтадан келеді! ≫
Dialogue: 0,0:09:12.70,0:09:14.39,Default,,0000,0000,0000,,Алдын ала рахмет. Бұл пайдалы болды.
Dialogue: 0,0:09:14.39,0:09:16.42,Default,,0000,0000,0000,,Жоқ, рахмет. О?
Dialogue: 0,0:09:16.42,0:09:20.11,Default,,0000,0000,0000,,Дұрыс, келесі жолы бізге медбике кабинетіне келіңіз →
Dialogue: 0,0:09:20.11,0:09:22.47,Default,,0000,0000,0000,,Мен саған арнайы төсек дайындаймын.
Dialogue: 0,0:09:22.47,0:09:24.66,Default,,0000,0000,0000,,Ахаха, мұғалім, қызық екен.
Dialogue: 0,0:09:24.66,0:09:27.02,Default,,0000,0000,0000,,Кез келген уақытта келіңіз. иә?
Dialogue: 0,0:09:27.02,0:09:29.88,Default,,0000,0000,0000,,Біраз уақыттан бері бірдеңе қозғалды... →
Dialogue: 0,0:09:29.88,0:09:32.57,Default,,0000,0000,0000,,Ах! аа….
Dialogue: 0,0:09:32.57,0:09:40.65,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:09:40.65,0:09:43.01,Default,,0000,0000,0000,,Ах! сен….
Dialogue: 0,0:09:43.01,0:09:45.37,Default,,0000,0000,0000,,Ран-чанмен тым таныс болмаңыз!
Dialogue: 0,0:09:45.37,0:09:48.73,Default,,0000,0000,0000,,Эй, менің атым Рун-чан. →
Dialogue: 0,0:09:48.73,0:09:50.08,Default,,0000,0000,0000,,Мен де сені Ран-чан деп атай аламын ба?
Dialogue: 0,0:09:50.08,0:09:52.44,Default,,0000,0000,0000,,Иә. Ха!
Dialogue: 0,0:09:52.44,0:09:54.62,Default,,0000,0000,0000,,Мен «Run-chan»…→ көремін
Dialogue: 0,0:09:54.62,0:09:57.16,Default,,0000,0000,0000,,Сен сүйкімдісің, «Рун-чан». Ах. →
Dialogue: 0,0:09:57.16,0:10:00.02,Default,,0000,0000,0000,,Сіз теңіз кірпісіне ұқсайсыз, сондықтан сізді «кірпі-чан» деп атайды.
Dialogue: 0,0:10:00.02,0:10:02.87,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:02.87,0:10:04.06,Default,,0000,0000,0000,,Мен өзімді күйзеліске ұшырадым.
Dialogue: 0,0:10:04.06,0:10:07.08,Default,,0000,0000,0000,,Жауға тұз жібергенмен бірдей.
Dialogue: 0,0:10:07.08,0:10:10.29,Default,,0000,0000,0000,,Бірақ Ран-чан шынымен сүйкімді→
Dialogue: 0,0:10:10.29,0:10:13.49,Default,,0000,0000,0000,,Маңдай. рахмет.
Dialogue: 0,0:10:13.49,0:10:17.52,Default,,0000,0000,0000,,Дұрыс... шынымен... →
Dialogue: 0,0:10:17.52,0:10:20.56,Default,,0000,0000,0000,,Шынымен... Ах...
Dialogue: 0,0:10:20.56,0:10:23.25,Default,,0000,0000,0000,,Сәлем!! иә? иә?
Dialogue: 0,0:10:23.25,0:10:25.77,Default,,0000,0000,0000,,Ран-чаннан аулақ болыңыз!
Dialogue: 0,0:10:25.77,0:10:29.48,Default,,0000,0000,0000,,А, а... (Сато)... Кешіріңіз. →
Dialogue: 0,0:10:29.48,0:10:31.00,Default,,0000,0000,0000,,Дәрігердің уақыты келді.
Dialogue: 0,0:10:31.00,0:10:34.02,Default,,0000,0000,0000,,≪Ой, менің денем әлсіз...≫
Dialogue: 0,0:10:34.02,0:10:37.55,Default,,0000,0000,0000,,Кин Хон Хан…
Dialogue: 0,0:10:37.55,0:10:39.91,Default,,0000,0000,0000,,Иә! Мынаны қара!
Dialogue: 0,0:10:39.91,0:10:41.10,Default,,0000,0000,0000,,Та-да!
Dialogue: 0,0:10:41.10,0:10:44.79,Default,,0000,0000,0000,,Музыка жоқ, өмір жоқ!
Dialogue: 0,0:10:44.79,0:10:47.83,Default,,0000,0000,0000,,О! Шектеулі шығарылым түсін сатып алдыңыз ба?
Dialogue: 0,0:10:47.83,0:10:50.19,Default,,0000,0000,0000,,Иә? Солай ма? Күшті. →
Dialogue: 0,0:10:50.19,0:10:52.21,Default,,0000,0000,0000,,Мен де соны қалаймын.
Dialogue: 0,0:10:52.21,0:10:54.56,Default,,0000,0000,0000,,Жоғары технология.
Dialogue: 0,0:10:54.56,0:10:58.26,Default,,0000,0000,0000,,Run қандай әндерді тыңдайды?
Dialogue: 0,0:10:58.26,0:11:00.12,Default,,0000,0000,0000,,Жақсы...→
Dialogue: 0,0:11:00.12,0:11:03.12,Default,,0000,0000,0000,,Бұл әлі де музыкасыз өмір. Мүмкін ол қосылмаған шығар...
Dialogue: 0,0:11:05.00,0:11:08.37,Default,,0000,0000,0000,,Хм... Мен әртүрлі нәрселерді қолданып көрдім →
Dialogue: 0,0:11:08.37,0:11:13.41,Default,,0000,0000,0000,,Мен музыканы қоя алмадым, сондықтан оны бұзылған деп ойладым.
Dialogue: 0,0:11:13.41,0:11:16.78,Default,,0000,0000,0000,,Осындай нәрсе...→
Dialogue: 0,0:11:16.78,0:11:19.14,Default,,0000,0000,0000,,Мынадай нәрсе...→
Dialogue: 0,0:11:19.14,0:11:21.33,Default,,0000,0000,0000,,Немесе сол сияқты...
Dialogue: 0,0:11:21.33,0:11:24.86,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:11:24.86,0:11:26.86,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:11:28.23,0:11:30.09,Default,,0000,0000,0000,,Бірақ бұл әлі де жақсы емес.
Dialogue: 0,0:11:30.09,0:11:33.11,Default,,0000,0000,0000,,Соңғысы қандай!? Соңғысы! (2 адам) Иә?
Dialogue: 0,0:11:33.11,0:11:36.81,Default,,0000,0000,0000,,Ол бөлшектелді ме? Жоқ, менің ойымша, ол бұзылған.
Dialogue: 0,0:11:36.81,0:11:38.84,Default,,0000,0000,0000,,Әуесқой оны түзете алады деп ойлайсыз ба?
Dialogue: 0,0:11:38.84,0:11:41.36,Default,,0000,0000,0000,,Өндірушіге жіберу сияқты басқа да жолдар бар шығар!
Dialogue: 0,0:11:41.36,0:11:44.40,Default,,0000,0000,0000,,Бұл тыныш және Нагидің ісі!
Dialogue: 0,0:11:44.40,0:11:47.09,Default,,0000,0000,0000,,Мен болсам, мен сені бөлшектеп тастар едім!
Dialogue: 0,0:11:47.09,0:11:50.45,Default,,0000,0000,0000,,Жарайды! Өйткені мен сынған емеспін →
Dialogue: 0,0:11:50.45,0:11:53.45,Default,,0000,0000,0000,,Қажет емес! Бұл дегеніміз емес.
Dialogue: 0,0:11:57.35,0:11:59.71,Default,,0000,0000,0000,,Ах. Ол келді!
Dialogue: 0,0:11:59.71,0:12:01.23,Default,,0000,0000,0000,,Ах~ Бұл жақсы. →
Dialogue: 0,0:12:01.23,0:12:05.23,Default,,0000,0000,0000,,Музыканы қою үшін компьютерді пайдалану керек.
Dialogue: 0,0:12:07.62,0:12:09.14,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:09.14,0:12:13.18,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:12:13.18,0:12:15.18,Default,,0000,0000,0000,,Менде компьютер жоқ. Неге сатып алдың?
Dialogue: 0,0:12:17.72,0:12:19.24,Default,,0000,0000,0000,,Уф... Мм~→
Dialogue: 0,0:12:19.24,0:12:22.78,Default,,0000,0000,0000,,Сіз үзіліс кезінде қайда барасыз?
Dialogue: 0,0:12:22.78,0:12:24.78,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:12:26.81,0:12:29.81,Default,,0000,0000,0000,,Маған айтпайынша мен сені жібермеймін.
Dialogue: 0,0:12:36.41,0:12:39.44,Default,,0000,0000,0000,,…（）
Dialogue: 0,0:12:39.44,0:12:42.44,Default,,0000,0000,0000,,Уау! Апыр-ай! Бұл өтірік! Күте тұрыңыз!
Dialogue: 0,0:12:43.65,0:12:46.85,Default,,0000,0000,0000,,Кешіріңіз, кешіріңіз! Сен ашулысың ба?
Dialogue: 0,0:12:46.85,0:12:49.37,Default,,0000,0000,0000,,Себебі мен ашуланбаймын.
Dialogue: 0,0:12:49.37,0:12:52.40,Default,,0000,0000,0000,,Иә? Хмм... ол өте өсті...
Dialogue: 0,0:12:52.40,0:12:54.76,Default,,0000,0000,0000,,Жақсы дейді, өйткені жусаң кішірейеді.
Dialogue: 0,0:12:54.76,0:12:57.96,Default,,0000,0000,0000,,Жоқ, сіз мұны қазір пайдалана аласыз.
Dialogue: 0,0:12:57.96,0:13:00.81,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:00.81,0:13:02.17,Default,,0000,0000,0000,,Хмм… Иә….
Dialogue: 0,0:13:02.17,0:13:04.52,Default,,0000,0000,0000,,Енді қайда бара жатырсың?
Dialogue: 0,0:13:04.52,0:13:06.52,Default,,0000,0000,0000,,Ютака сені сонда апарады!
Dialogue: 0,0:13:11.76,0:13:13.11,Default,,0000,0000,0000,,Run-chan.
Dialogue: 0,0:13:13.11,0:13:18.16,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:13:18.16,0:13:22.54,Default,,0000,0000,0000,,Түсіндім... Келесі кезекте: Дене шынықтыру сабағы.
Dialogue: 0,0:13:22.54,0:13:41.06,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:13:41.06,0:14:01.10,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:14:01.10,0:14:11.86,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:14:11.86,0:14:30.05,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:14:30.05,0:14:37.45,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:14:37.45,0:14:39.45,Default,,0000,0000,0000,,Run-chan….
Dialogue: 0,0:16:52.80,0:16:55.50,Default,,0000,0000,0000,,Бірақ әлі де гүлденушілер бар →
Dialogue: 0,0:16:55.50,0:16:59.37,Default,,0000,0000,0000,,Бұл біртүрлі әңгіме. (Юко) Мен сенімдімін.
Dialogue: 0,0:16:59.37,0:17:01.37,Default,,0000,0000,0000,,Басқа мектептер шорттарды талап етеді.
Dialogue: 0,0:17:04.09,0:17:07.12,Default,,0000,0000,0000,,Блумерлер жай ғана шалбар. →
Dialogue: 0,0:17:07.12,0:17:11.82,Default,,0000,0000,0000,,Мен шалбар кисем де, неге жоғарыдан киемін?→
Dialogue: 0,0:17:11.82,0:17:14.69,Default,,0000,0000,0000,,Бұл шалбардағы шалбар... (Юко) Наги?
Dialogue: 0,0:17:14.69,0:17:16.69,Default,,0000,0000,0000,,Сабаққа шалбармен бару біртүрлі.
Dialogue: 0,0:17:18.72,0:17:20.58,Default,,0000,0000,0000,,Мен шалбар кимегендіктен ұялмаймын!?→
Dialogue: 0,0:17:20.58,0:17:23.45,Default,,0000,0000,0000,,Бұл ұят! (Барлығы) Әй...
Dialogue: 0,0:17:23.45,0:17:27.65,Default,,0000,0000,0000,,Наги Булмаға қарағанда ұят.
Dialogue: 0,0:17:27.65,0:17:30.35,Default,,0000,0000,0000,,Осылай қайталағанда ұнайтын сияқты.
Dialogue: 0,0:17:30.35,0:17:32.87,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:32.87,0:17:35.06,Default,,0000,0000,0000,,Денені қыздыру жаттығуларын бастау. Дыбыстық сигнал! (ысқырық дыбысы)
Dialogue: 0,0:17:35.06,0:17:38.26,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:17:38.26,0:17:41.46,Default,,0000,0000,0000,,Сәлем. не? Юко-чан.
Dialogue: 0,0:17:41.46,0:17:44.82,Default,,0000,0000,0000,,Сіз мұны тартасыз ба? Сіз оны итеруіңіз керек емес пе еді?
Dialogue: 0,0:17:44.82,0:17:47.85,Default,,0000,0000,0000,,Түсіндім. Жарайды, кеттік.
Dialogue: 0,0:17:47.85,0:17:50.21,Default,,0000,0000,0000,,Жарайды, келіңдер! (Юко жүгіру) Сен~жоқ.
Dialogue: 0,0:17:50.21,0:17:52.06,Default,,0000,0000,0000,,Соқ! (2 адам) Уау! →
Dialogue: 0,0:17:52.06,0:17:54.92,Default,,0000,0000,0000,,Ах... (Барлығы) Иә?
Dialogue: 0,0:17:54.92,0:17:57.78,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? Сол жігіттер.
Dialogue: 0,0:17:57.78,0:17:59.97,Default,,0000,0000,0000,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:17:59.97,0:18:01.33,Default,,0000,0000,0000,,Жаңа ғана тартқаныңыз тартып жатқан сияқты.
Dialogue: 0,0:18:01.33,0:18:03.33,Default,,0000,0000,0000,,Дұрыс, Юко-чан.
Dialogue: 0,0:18:05.36,0:18:07.36,Default,,0000,0000,0000,,Уау! Хахаха!
Dialogue: 0,0:18:09.91,0:18:11.59,Default,,0000,0000,0000,,Хахахаха!
Dialogue: 0,0:18:11.59,0:18:13.78,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:18:13.78,0:18:16.81,Default,,0000,0000,0000,,Көңілді сияқты.
Dialogue: 0,0:18:16.81,0:18:18.00,Default,,0000,0000,0000,,Ах! Хахаха! Ах...→
Dialogue: 0,0:18:18.00,0:18:21.02,Default,,0000,0000,0000,,Егер сіз көп ойнасаңыз, сізге зиян тигізеді.
Dialogue: 0,0:18:21.02,0:18:24.72,Default,,0000,0000,0000,,Жарайды. Апыр-ай!
Dialogue: 0,0:18:24.72,0:18:27.42,Default,,0000,0000,0000,,Күрсін.
Dialogue: 0,0:18:27.42,0:18:30.45,Default,,0000,0000,0000,,Иә? не болды? Наги-чан.
Dialogue: 0,0:18:30.45,0:18:32.45,Default,,0000,0000,0000,,Жоқ... бұл ештеңе емес.
Dialogue: 0,0:18:34.15,0:18:36.15,Default,,0000,0000,0000,,Иә, келесі сұрақ.
Dialogue: 0,0:18:39.87,0:18:41.87,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:42.74,0:18:45.74,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:18:47.28,0:18:50.14,Default,,0000,0000,0000,,≪Сен Тоорун Ютаканы көріп жатырсың ба? ≫
Dialogue: 0,0:18:50.14,0:18:54.19,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:18:54.19,0:18:57.05,Default,,0000,0000,0000,,≪Сөзсіз! ≫
Dialogue: 0,0:18:57.05,0:18:59.40,Default,,0000,0000,0000,,Ютака үшін келдіңіз бе?
Dialogue: 0,0:18:59.40,0:19:01.40,Default,,0000,0000,0000,,Мазасыздық…. иә?
Dialogue: 0,0:19:03.61,0:19:06.14,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:06.14,0:19:13.71,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:19:13.71,0:19:16.57,Default,,0000,0000,0000,,Иә, бұл мәселені шеше алатын адам.
Dialogue: 0,0:19:16.57,0:19:18.57,Default,,0000,0000,0000,,Сіз ынталысыз.
Dialogue: 0,0:19:20.61,0:19:22.14,Default,,0000,0000,0000,,Ах! Ютака ма?
Dialogue: 0,0:19:22.14,0:19:25.00,Default,,0000,0000,0000,,Иә. Иә, алға.
Dialogue: 0,0:19:25.00,0:19:28.36,Default,,0000,0000,0000,,А... аа... а.
Dialogue: 0,0:19:28.36,0:19:34.42,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:19:34.42,0:19:36.42,Default,,0000,0000,0000,,≪Турун! ≫
Dialogue: 0,0:19:41.99,0:19:43.51,Default,,0000,0000,0000,,...
Dialogue: 0,0:19:43.51,0:19:46.21,Default,,0000,0000,0000,,Оны ішке салмаңыз, сыртқа шығарып көріңіз.
Dialogue: 0,0:19:46.21,0:19:48.23,Default,,0000,0000,0000,,Спортзалға арналған киім?
Dialogue: 0,0:19:48.23,0:19:50.23,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:19:54.45,0:19:58.66,Default,,0000,0000,0000,,Иә, иә. Мен оны кимеймін.
Dialogue: 0,0:19:58.66,0:20:00.01,Default,,0000,0000,0000,,...
Dialogue: 0,0:20:00.01,0:20:03.01,Default,,0000,0000,0000,,～ （）
Dialogue: 0,0:20:04.22,0:20:06.74,Default,,0000,0000,0000,,Бірдеңе болды →
Dialogue: 0,0:20:06.74,0:20:10.78,Default,,0000,0000,0000,,Тоору Мен қазір спортзалға арналған киімімді киіп жүрмін. Бұл мен оны өшіруім керек дегенді білдіре ме?
Dialogue: 0,0:20:10.78,0:20:12.78,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:20:15.33,0:20:17.33,Default,,0000,0000,0000,,Бұл сіздің үмітіңізді ақтайды деп ойламаймын.
Dialogue: 0,0:20:18.86,0:20:21.05,Default,,0000,0000,0000,,Ах! Бұл→
Dialogue: 0,0:20:21.05,0:20:23.41,Default,,0000,0000,0000,,Тек көйлек!
Dialogue: 0,0:20:23.41,0:20:25.77,Default,,0000,0000,0000,,Сіз заттарды жақсы сақтайсыз.
Dialogue: 0,0:20:25.77,0:20:29.47,Default,,0000,0000,0000,,≪Ой, мені мақтады≫
Dialogue: 0,0:20:29.47,0:20:31.47,Default,,0000,0000,0000,,…
Dialogue: 0,0:20:33.67,0:20:36.54,Default,,0000,0000,0000,,Иә? Бұл...
Dialogue: 0,0:20:36.54,0:20:38.73,Default,,0000,0000,0000,,Дыбыстық сигнал!
Dialogue: 0,0:20:38.73,0:20:42.77,Default,,0000,0000,0000,,Иә! Олай болса, сабақты бастайық. →
Dialogue: 0,0:20:42.77,0:20:45.63,Default,,0000,0000,0000,,Біз денені қыздыру жаттығуларын жасаймыз, сондықтан жұптасып отырыңдар.
Dialogue: 0,0:20:45.63,0:20:47.15,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:20:47.15,0:20:50.51,Default,,0000,0000,0000,,Ах. мм... хмм?
Dialogue: 0,0:20:50.51,0:20:53.21,Default,,0000,0000,0000,,～
Dialogue: 0,0:20:53.21,0:20:56.21,Default,,0000,0000,0000,,Уау! Ютакамен бірге болайық!
Dialogue: 0,0:20:58.76,0:21:01.79,Default,,0000,0000,0000,,Мм! Иә.
Dialogue: 0,0:21:01.79,0:21:03.31,Default,,0000,0000,0000,,Ах, Мипорин.
Dialogue: 0,0:21:03.31,0:21:05.00,Default,,0000,0000,0000,,Ютака менімен жұптасады, солай ма?
Dialogue: 0,0:21:05.00,0:21:07.35,Default,,0000,0000,0000,,Не? Ютака және Торун →
Dialogue: 0,0:21:07.35,0:21:10.88,Default,,0000,0000,0000,,Жұп құрыңызшы... Менімен, солай ма?
Dialogue: 0,0:21:10.88,0:21:12.06,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:21:12.06,0:21:15.10,Default,,0000,0000,0000,,Менімен бірге! Уау...
Dialogue: 0,0:21:15.10,0:21:18.10,Default,,0000,0000,0000,,Содан кейін осы жолмен. Миполи...
Dialogue: 0,0:21:20.14,0:21:22.14,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:21:25.70,0:21:28.40,Default,,0000,0000,0000,,Эй, Юуко, сенің таңғышың бар ма?
Dialogue: 0,0:21:28.40,0:21:31.09,Default,,0000,0000,0000,,Не болды? Жарақат па? Жоқ →
Dialogue: 0,0:21:31.09,0:21:33.11,Default,,0000,0000,0000,,Бұрын дене шынықтыру сабағында құлағанымда →
Dialogue: 0,0:21:33.11,0:21:35.30,Default,,0000,0000,0000,,Мен тіземді тырнап алдым.
Dialogue: 0,0:21:35.30,0:21:39.33,Default,,0000,0000,0000,,Ах! Бұл қиын! Мен оны тез арада дезинфекциялауым керек.
Dialogue: 0,0:21:39.33,0:21:41.69,Default,,0000,0000,0000,,Ауруханаға барайық. Е, бұл туралы →
Dialogue: 0,0:21:41.69,0:21:44.22,Default,,0000,0000,0000,,Оны сумен жуып, таңғыш тағу жеткілікті.
Dialogue: 0,0:21:44.22,0:21:48.42,Default,,0000,0000,0000,,Жоқ. Егер ол іріңдеп кетсе, бұл қорқынышты болады.
Dialogue: 0,0:21:48.42,0:21:52.63,Default,,0000,0000,0000,,Жарайды. Оның үстіне келесі сабақ басталғалы жатыр.
Dialogue: 0,0:21:52.63,0:21:55.99,Default,,0000,0000,0000,,Иә, асығыңыз! О, күте тұрыңыз ...
Dialogue: 0,0:21:55.99,0:21:58.86,Default,,0000,0000,0000,,～（）
Dialogue: 0,0:21:58.86,0:22:00.86,Default,,0000,0000,0000,,Иә? (Юко) Мүмкін емес.
Dialogue: 0,0:22:02.73,0:22:04.76,Default,,0000,0000,0000,,Бірдеңе болды ма?
Dialogue: 0,0:22:04.76,0:22:08.79,Default,,0000,0000,0000,,Кешіріңіз... иә? →
Dialogue: 0,0:22:08.79,0:22:11.66,Default,,0000,0000,0000,,Иә! Уау!!→
Dialogue: 0,0:22:11.66,0:22:13.34,Default,,0000,0000,0000,,～!!
Dialogue: 0,0:22:13.34,0:22:16.04,Default,,0000,0000,0000,,Юко-чан? Қарғыс атқыр...
Dialogue: 0,0:22:16.04,0:22:18.72,Default,,0000,0000,0000,,Кешіріңіз мені кешіріңіз. Амал жоқ→
Dialogue: 0,0:22:18.72,0:22:20.08,Default,,0000,0000,0000,,Ондай жерде болу...
Dialogue: 0,0:22:20.08,0:22:23.44,Default,,0000,0000,0000,,Аа... Ұстама ұстап, құлап қалдым... →
Dialogue: 0,0:22:23.44,0:22:25.80,Default,,0000,0000,0000,,Рахмет. Юко-чан!
Dialogue: 0,0:22:25.80,0:22:28.00,Default,,0000,0000,0000,,Уау! Не болды?
Dialogue: 0,0:22:28.00,0:22:30.00,Default,,0000,0000,0000,,Иә? (Сато) Куккукку….
Dialogue: 0,0:22:33.04,0:22:36.07,Default,,0000,0000,0000,,Мұғалім, кешіріңіз, байқамадым...
Dialogue: 0,0:22:36.07,0:22:38.93,Default,,0000,0000,0000,,Жоқ, жоқ. Керісінше, Run-chan→
Dialogue: 0,0:22:38.93,0:22:41.96,Default,,0000,0000,0000,,Басқаны аттаған абырой.
Dialogue: 0,0:22:41.96,0:22:46.00,Default,,0000,0000,0000,,Мм... Сато мырзаға Run → ұнайтын сияқты
Dialogue: 0,0:22:46.00,0:22:48.69,Default,,0000,0000,0000,,Қайда... Ммм?
Dialogue: 0,0:22:48.69,0:22:51.72,Default,,0000,0000,0000,,Еш ойланбастан сөйлесуге болатын орындар →
Dialogue: 0,0:22:51.72,0:22:54.76,Default,,0000,0000,0000,,Екі жақ жоқ сияқты... әрине.
Dialogue: 0,0:22:54.76,0:22:59.64,Default,,0000,0000,0000,,Сондай-ақ... бұл табиғи S сияқты көрінеді және оның маңдайы әдемі→
Dialogue: 0,0:22:59.64,0:23:03.84,Default,,0000,0000,0000,,Маңдайдың ені де ең жақсы, ал маңдай...
Dialogue: 0,0:23:03.84,0:23:05.84,Default,,0000,0000,0000,,≪Мына... бұл мұғалім...≫
Dialogue: 0,0:23:06.88,0:23:09.88,Default,,0000,0000,0000,,（）
Dialogue: 0,0:23:10.75,0:23:12.94,Default,,0000,0000,0000,,Сабақ басталды.
Dialogue: 0,0:23:12.94,0:23:15.46,Default,,0000,0000,0000,,Бұл өте жаман.
Dialogue: 0,0:23:15.46,0:23:18.15,Default,,0000,0000,0000,,Жоқ, сызаттарды бағаламаңыз.
Dialogue: 0,0:23:18.15,0:23:20.35,Default,,0000,0000,0000,,Жарайды, мен абай боламын. →
Dialogue: 0,0:23:20.35,0:23:22.03,Default,,0000,0000,0000,,Бірақ сол мұғалім Сато→
Dialogue: 0,0:23:22.03,0:23:25.06,Default,,0000,0000,0000,,Амансың ба? Не?
Dialogue: 0,0:23:25.06,0:23:27.75,Default,,0000,0000,0000,,Сіз ертерек құлап қалдыңыз, солай ма? →
Dialogue: 0,0:23:27.75,0:23:30.94,Default,,0000,0000,0000,,Мені тағы жалғыз қалдыруға жарайсың ба?
Dialogue: 0,0:23:30.94,0:23:32.14,Default,,0000,0000,0000,,Ах~ Мен біраз уайымдаған шығармын.
Dialogue: 0,0:23:32.14,0:23:35.99,Default,,0000,0000,0000,,Иә! (2 адам) Иә?
Dialogue: 0,0:23:35.99,0:23:38.52,Default,,0000,0000,0000,,Бұл мұғалім қауіпті.
Dialogue: 0,0:23:38.52,0:23:40.88,Default,,0000,0000,0000,,Иә? Қандай қауіп бар?
Dialogue: 0,0:23:40.88,0:23:43.88,Default,,0000,0000,0000,,Сол мұғалім... (2 адам) А....
Dialogue: 0,0:23:45.76,0:23:48.76,Default,,0000,0000,0000,,өтіңіз... Менде біртүрлі фетиш бар.
Dialogue: 0,0:23:50.81,0:23:54.35,Default,,0000,0000,0000,,А, солай. Маңдайым әдемі →
Dialogue: 0,0:23:54.35,0:23:57.38,Default,,0000,0000,0000,,Мені мақтады! Бұл, әрине, қауіпті.
Dialogue: 0,0:23:57.38,0:23:59.74,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:23:59.74,0:24:01.74,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:24:04.45,0:24:07.48,Default,,0000,0000,0000,,Хмм, жарайды.
Dialogue: 0,0:24:07.48,0:24:10.01,Default,,0000,0000,0000,,Кин Хон Хан…
Dialogue: 0,0:24:10.01,0:24:13.38,Default,,0000,0000,0000,,Тоорун маған осында айтыңызшы.
Dialogue: 0,0:24:13.38,0:24:16.57,Default,,0000,0000,0000,,Жарайды. Не түсінбейсің?
Dialogue: 0,0:24:16.57,0:24:19.57,Default,,0000,0000,0000,,Барлығы. Хаха….
Dialogue: 0,0:24:22.80,0:24:25.80,Default,,0000,0000,0000,,Ал, мен оны басынан бастап түсіндіремін. иә.
Dialogue: 0,0:24:26.34,0:24:29.04,Default,,0000,0000,0000,,Тоору-сан мейірімді. Иә.
Dialogue: 0,0:24:29.04,0:24:32.06,Default,,0000,0000,0000,,Неге түсінбейсің!?
Dialogue: 0,0:24:32.06,0:24:34.41,Default,,0000,0000,0000,,Сіз мұны қайта-қайта қайталайсыз!
Dialogue: 0,0:24:34.41,0:24:36.77,Default,,0000,0000,0000,,Кешіріңіз... Бұл жерде осылай көрінеді.
Dialogue: 0,0:24:36.77,0:24:39.47,Default,,0000,0000,0000,,Сондықтан ол басқаша! Міне бітті!
Dialogue: 0,0:24:39.47,0:24:41.82,Default,,0000,0000,0000,,Мен болсам, оны жай ғана шығарар едім.
Dialogue: 0,0:24:41.82,0:24:44.68,Default,,0000,0000,0000,,Шынында да.
Dialogue: 0,0:24:44.68,0:24:46.37,Default,,0000,0000,0000,,Күрсін... Күрсін... Түсінді ме?
Dialogue: 0,0:24:46.37,0:24:49.74,Default,,0000,0000,0000,,Күрсін... Күрсін... Мүлдем...
Dialogue: 0,0:24:49.74,0:24:52.76,Default,,0000,0000,0000,,…
Dialogue: 0,0:24:52.76,0:24:54.95,Default,,0000,0000,0000,,Ах, Мипорин.
Dialogue: 0,0:24:54.95,0:24:57.14,Default,,0000,0000,0000,,Ютака Соңғы кездері Тооруды тым көп мазалап жүрсің.
Dialogue: 0,0:24:57.14,0:24:59.33,Default,,0000,0000,0000,,Иә! →
Dialogue: 0,0:24:59.33,0:25:01.85,Default,,0000,0000,0000,,Уау! Кешіріңіз Тоору-сан→
Dialogue: 0,0:25:01.85,0:25:04.55,Default,,0000,0000,0000,,Онымен айналысудың қажеті жоқ. Бұл ауыртпалық емес пе? →
Dialogue: 0,0:25:04.55,0:25:07.55,Default,,0000,0000,0000,,～
Dialogue: 0,0:25:10.95,0:25:21.05,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:21.05,0:25:23.74,Default,,0000,0000,0000,,Қазірдің өзінде! Тоору-сан, сен қиналып қалдың ғой? →
Dialogue: 0,0:25:23.74,0:25:27.28,Default,,0000,0000,0000,,Егер шынымен түсінбесеңіз, алдымен менен сұраңыз!
Dialogue: 0,0:25:27.28,0:25:36.37,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:36.37,0:25:39.37,Default,,0000,0000,0000,,≪Мен өзімді жалғыз сезіне алмаймын...→
Dialogue: 0,0:25:41.42,0:25:43.27,Default,,0000,0000,0000,,Мен олай ойламаймын! Өйткені мен олай ойламаймын! ≫
Dialogue: 0,0:25:43.27,0:25:50.51,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:50.51,0:25:53.37,Default,,0000,0000,0000,,Уау! Тоору... Тоору Күтіңіз! →
Dialogue: 0,0:25:53.37,0:25:56.40,Default,,0000,0000,0000,,Уау! жақсы емес! Артық керек емес!
Dialogue: 0,0:25:56.40,0:25:58.26,Default,,0000,0000,0000,,Тоору: Бірдеңе болды ма? мінеки біз?
Dialogue: 0,0:25:58.26,0:26:02.13,Default,,0000,0000,0000,,Уау! Бер бер бер бер! →
Dialogue: 0,0:26:02.13,0:26:04.13,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:26:05.66,0:26:07.66,Default,,0000,0000,0000,,≪Себебі мен жалғыз емеспін...≫
Dialogue: 0,0:26:10.04,0:26:20.14,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:20.14,0:26:24.52,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:24.52,0:26:32.43,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:32.43,0:26:37.81,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:37.81,0:26:47.41,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:47.41,0:26:52.79,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:52.79,0:27:11.49,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:11.49,0:27:18.49,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:28.49,0:27:37.49,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:29:10.68,0:29:12.03,Default,,0000,0000,0000,,Со Ютака мен Мипорин→
Dialogue: 0,0:29:12.03,0:29:15.40,Default,,0000,0000,0000,,Бұл өте сәтті болды... Айтпақшы, қазірдің өзінде жаз.
Dialogue: 0,0:29:15.40,0:29:18.76,Default,,0000,0000,0000,,Не? Қазірдің өзінде жаз? Сәл ерте емес пе?
Dialogue: 0,0:29:18.76,0:29:21.45,Default,,0000,0000,0000,,Міне! Түрлі жағдайлар болады. →
Dialogue: 0,0:29:21.45,0:29:23.47,Default,,0000,0000,0000,,Қараңыз! Купальник әлемі, ыстық бұлақ әлемі және т.б.
Dialogue: 0,0:29:23.47,0:29:25.66,Default,,0000,0000,0000,,Жоқ, менің ойымша, ыстық бұлақ жоқ.
Dialogue: 0,0:29:25.66,0:29:29.36,Default,,0000,0000,0000,,Алайда, купальникке ауыспас бұрын, үлкен кедергі болады...
Dialogue: 0,0:29:29.36,0:29:31.36,Default,,0000,0000,0000,,Келесі жолы «Арна».
Dialogue: 0,0:29:33.07,0:29:35.09,Default,,0000,0000,0000,,Диета? Әдемі денелі Ютака үшін→
Dialogue: 0,0:29:35.09,0:29:37.09,Default,,0000,0000,0000,,Бұл байланыссыз сөздер.
Dialogue: 0,0:29:38.59,0:29:44.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory