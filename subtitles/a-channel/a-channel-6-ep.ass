Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:04.82,0:02:06.84,Default,,0000,0000,0000,,Тоору~!
Dialogue: 0,0:02:06.84,0:02:09.86,Default,,0000,0000,0000,,～→
Dialogue: 0,0:02:09.86,0:02:12.56,Default,,0000,0000,0000,,Балмұздақ жегің келе ме? иә?
Dialogue: 0,0:02:12.56,0:02:14.56,Default,,0000,0000,0000,,Онда жоқ.
Dialogue: 0,0:02:18.12,0:02:20.30,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:02:20.30,0:02:22.30,Default,,0000,0000,0000,,～
Dialogue: 0,0:02:23.84,0:02:28.72,Default,,0000,0000,0000,,Сен онда не істеп жүрсің? Мен ұйықтап жатқанда құладым.
Dialogue: 0,0:02:28.72,0:02:32.60,Default,,0000,0000,0000,,Мен қозғала алмаймын... Маған көмектесіңізші. Аха!
Dialogue: 0,0:02:32.60,0:02:34.28,Default,,0000,0000,0000,,Кочо Кочо Кочо…. Ахахахахах! Эй, эй...→
Dialogue: 0,0:02:34.28,0:02:36.47,Default,,0000,0000,0000,,Тоқта... тоқта! Кочо Кочо….
Dialogue: 0,0:02:36.47,0:02:39.17,Default,,0000,0000,0000,,Ахахахаха... хаха~.
Dialogue: 0,0:02:39.17,0:02:43.87,Default,,0000,0000,0000,,Каша! (Ұялы телефон жапқышының дыбысы) Эй... не істеп жатырсың?
Dialogue: 0,0:02:43.87,0:02:45.89,Default,,0000,0000,0000,,Мен өзімді импульспен әрекет етіп жатқандай сезінемін...
Dialogue: 0,0:02:45.89,0:02:48.26,Default,,0000,0000,0000,,Аха! Тағы біреуі. Тоқта...
Dialogue: 0,0:02:48.26,0:02:50.26,Default,,0000,0000,0000,,Каша! Керемет кадр!
Dialogue: 0,0:02:52.46,0:03:04.46,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:07.27,0:03:18.72,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:18.72,0:03:23.72,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:25.29,0:03:33.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:33.20,0:03:37.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:39.43,0:03:49.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:49.20,0:03:58.45,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:58.45,0:04:05.02,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:05.02,0:04:08.02,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:13.77,0:04:21.77,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:23.20,0:04:25.39,Default,,0000,0000,0000,,Иә, Тоору.
Dialogue: 0,0:04:25.39,0:04:27.39,Default,,0000,0000,0000,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,0:04:28.09,0:04:33.47,Default,,0000,0000,0000,,Хмм, дәмді!
Dialogue: 0,0:04:33.47,0:04:35.47,Default,,0000,0000,0000,,Хмм…. иә?
Dialogue: 0,0:04:36.17,0:04:39.53,Default,,0000,0000,0000,,Тоору, сенің шаштарың өсті, солай ма?
Dialogue: 0,0:04:39.53,0:04:42.06,Default,,0000,0000,0000,,Иә. Жазғы демалыстан кейін →
Dialogue: 0,0:04:42.06,0:04:44.75,Default,,0000,0000,0000,,Мен оны ұзақ уақыт жалғыз қалдырдым.
Dialogue: 0,0:04:44.75,0:04:47.61,Default,,0000,0000,0000,,Мен оны кесейін бе? иә?
Dialogue: 0,0:04:47.61,0:04:50.81,Default,,0000,0000,0000,,Қайшы~! Сол қайшылармен!?
Dialogue: 0,0:04:50.81,0:04:53.84,Default,,0000,0000,0000,,Иә, өтінемін, қозғалмаңыз.
Dialogue: 0,0:04:53.84,0:04:55.19,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:04:55.19,0:04:58.06,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:58.06,0:05:01.06,Default,,0000,0000,0000,,Күте тұрыңыз! Сіз қайшымен көлденеңінен кесесіз бе?
Dialogue: 0,0:05:02.93,0:05:05.12,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:05.12,0:05:07.64,Default,,0000,0000,0000,,Ах…. Жақсы…→
Dialogue: 0,0:05:07.64,0:05:09.83,Default,,0000,0000,0000,,Сіз жас көрінесіз.
Dialogue: 0,0:05:09.83,0:05:11.52,Default,,0000,0000,0000,,Мектеп сөмкесі сізге жарасады!
Dialogue: 0,0:05:11.52,0:05:14.88,Default,,0000,0000,0000,,Тіпті кіші мектеп оқушысы емес пе!?
Dialogue: 0,0:05:14.88,0:05:17.74,Default,,0000,0000,0000,,Енді жоқ... Мен мектепке бара алмаймын.
Dialogue: 0,0:05:17.74,0:05:21.78,Default,,0000,0000,0000,,Қазір жазғы демалыс. Мектеп күні бар...
Dialogue: 0,0:05:21.78,0:05:24.31,Default,,0000,0000,0000,,Жарайды! Бұл сүйкімді.
Dialogue: 0,0:05:24.31,0:05:26.00,Default,,0000,0000,0000,,Сондықтан.
Dialogue: 0,0:05:26.00,0:05:28.18,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:05:28.18,0:05:31.55,Default,,0000,0000,0000,,Сонда... Аха!
Dialogue: 0,0:05:31.55,0:05:33.55,Default,,0000,0000,0000,,Осылайша...
Dialogue: 0,0:05:35.26,0:05:38.26,Default,,0000,0000,0000,,Орындалды! Уақыт келді!
Dialogue: 0,0:05:41.14,0:05:43.14,Default,,0000,0000,0000,,Сәйкестік.
Dialogue: 0,0:05:48.22,0:05:50.40,Default,,0000,0000,0000,,Tattatatta… (аяқ дыбысы)
Dialogue: 0,0:05:50.40,0:05:55.46,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:05:55.46,0:05:58.48,Default,,0000,0000,0000,,Пинг-понг
Dialogue: 0,0:05:58.48,0:06:00.17,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:06:00.17,0:06:02.86,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:06:02.86,0:06:04.88,Default,,0000,0000,0000,,Қайырлы таң, Тоору-чан.
Dialogue: 0,0:06:04.88,0:06:08.25,Default,,0000,0000,0000,,Кешіріңіз, жүгіріңіз, мен әлі ұйықтап жатырмын...
Dialogue: 0,0:06:08.25,0:06:10.77,Default,,0000,0000,0000,,Мені оята аласыз ба?
Dialogue: 0,0:06:10.77,0:06:12.77,Default,,0000,0000,0000,,Түсінікті. Сізді мазалағаным үшін кешіріңіз.
Dialogue: 0,0:06:15.82,0:06:18.68,Default,,0000,0000,0000,,Рун-чан, бұл мектептің бірінші күні!
Dialogue: 0,0:06:18.68,0:06:20.87,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:06:20.87,0:06:23.90,Default,,0000,0000,0000,,Рун-чан мектепке бара жатыр.
Dialogue: 0,0:06:23.90,0:06:26.94,Default,,0000,0000,0000,,Қазірдің өзінде... Хмм.
Dialogue: 0,0:06:26.94,0:06:29.29,Default,,0000,0000,0000,,Ах~.
Dialogue: 0,0:06:29.29,0:06:33.16,Default,,0000,0000,0000,,Жаз болса да, Ұзын жеңді тағы да киіп жүрмін.
Dialogue: 0,0:06:33.16,0:06:35.86,Default,,0000,0000,0000,,Жазғы свитерлер сүйкімді→
Dialogue: 0,0:06:35.86,0:06:38.55,Default,,0000,0000,0000,,Осыны айтып тұрсыз. Аа….
Dialogue: 0,0:06:38.55,0:06:40.58,Default,,0000,0000,0000,,Run-chan!
Dialogue: 0,0:06:40.58,0:06:43.10,Default,,0000,0000,0000,,Иә, сау болыңыз…. Апыр-ай! Түсіндім, шешіп ал!
Dialogue: 0,0:06:43.10,0:06:46.10,Default,,0000,0000,0000,,Мен оны шешемін! Мен оны шешіп аламын! Қош бол...
Dialogue: 0,0:06:49.82,0:06:52.52,Default,,0000,0000,0000,,Күн ыстық. Күрсіну….
Dialogue: 0,0:06:52.52,0:06:55.52,Default,,0000,0000,0000,,Ах~ мен өзімді ессіз сезінемін...
Dialogue: 0,0:06:56.90,0:06:59.10,Default,,0000,0000,0000,,Рун-чан, бұл мектеп емес!
Dialogue: 0,0:06:59.10,0:07:01.12,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:07:01.12,0:07:03.64,Default,,0000,0000,0000,,Мүмкін емес. Жаз - →
Dialogue: 0,0:07:03.64,0:07:06.50,Default,,0000,0000,0000,,Бұзықтардың саны артып келеді.
Dialogue: 0,0:07:06.50,0:07:09.86,Default,,0000,0000,0000,,Кейде көлік ішінен сізге біреу қоңырау шалады→
Dialogue: 0,0:07:09.86,0:07:11.05,Default,,0000,0000,0000,,Бар сияқты. Уау →
Dialogue: 0,0:07:11.05,0:07:14.25,Default,,0000,0000,0000,,Бұл алаңдатады. Мен абай болуым керек.
Dialogue: 0,0:07:14.25,0:07:16.25,Default,,0000,0000,0000,,（）
Dialogue: 0,0:07:18.45,0:07:21.81,Default,,0000,0000,0000,,Әй, ыстық. Мектепке көлікпен баруым керек пе?
Dialogue: 0,0:07:21.81,0:07:23.17,Default,,0000,0000,0000,,≪Ха! ≫
Dialogue: 0,0:07:23.17,0:07:25.17,Default,,0000,0000,0000,,≪Ах аа...≫
Dialogue: 0,0:07:26.20,0:07:29.39,Default,,0000,0000,0000,,≪Чикан!?≫
Dialogue: 0,0:07:29.39,0:07:33.43,Default,,0000,0000,0000,,Кяаа!! Біреу! Бұзық осында!
Dialogue: 0,0:07:33.43,0:07:36.63,Default,,0000,0000,0000,,Иә!? Иа... мінекей...
Dialogue: 0,0:07:36.63,0:07:39.50,Default,,0000,0000,0000,,Бұзық? Мен полицияға хабарлауым керек пе?
Dialogue: 0,0:07:39.50,0:07:43.53,Default,,0000,0000,0000,,Иә!? Әй, жоқ... бұл түсінбеушілік! →
Dialogue: 0,0:07:43.53,0:07:47.53,Default,,0000,0000,0000,,Мен олардың мектеп мұғалімімін! Хабарламауыңызды өтінемін!
Dialogue: 0,0:07:48.26,0:07:53.13,Default,,0000,0000,0000,,Олай болса, мен басып шығарылған қағаздарды таратамын, сондықтан оларды артқа жіберіңіз. →
Dialogue: 0,0:07:53.13,0:07:56.67,Default,,0000,0000,0000,,Жаңа семестрге дейін сол сауалнаманы толтырыңыз.
Dialogue: 0,0:07:56.67,0:07:59.36,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:07:59.36,0:08:02.56,Default,,0000,0000,0000,,Барлығың тыңдаңдар! Бұл→
Dialogue: 0,0:08:02.56,0:08:06.26,Default,,0000,0000,0000,,Бұл мансап бойынша кеңес беруге арналған сауалнама. Жаңа семестр алдында жақсылап ойланыңыз →
Dialogue: 0,0:08:06.26,0:08:09.30,Default,,0000,0000,0000,,Жазыңыз. Бір жыл ғана болды →
Dialogue: 0,0:08:09.30,0:08:12.66,Default,,0000,0000,0000,,Бейқам нәрселерді жазбаңыз. →
Dialogue: 0,0:08:12.66,0:08:15.19,Default,,0000,0000,0000,,Босаңсаңыз, емтихан тапсырғанға дейінгі уақыт зымырап өтеді! →
Dialogue: 0,0:08:15.19,0:08:19.89,Default,,0000,0000,0000,,Ертеңнен басталатын демалыста да шындықтан қашпаңыз→
Dialogue: 0,0:08:19.89,0:08:22.42,Default,,0000,0000,0000,,Жақсы оқы! Кин Хон Хан…
Dialogue: 0,0:08:22.42,0:08:25.12,Default,,0000,0000,0000,,күрсіну…. Міне бітті! →
Dialogue: 0,0:08:25.12,0:08:28.12,Default,,0000,0000,0000,,Қайтадан мектепке! Ах.
Dialogue: 0,0:08:36.23,0:08:39.60,Default,,0000,0000,0000,,Кито мырза. иә? Тоору мырза.
Dialogue: 0,0:08:39.60,0:08:42.79,Default,,0000,0000,0000,,Мұғалім, мен бүгін бозарып кеттім.
Dialogue: 0,0:08:42.79,0:08:45.66,Default,,0000,0000,0000,,Амансың ба? о қымбаттым!
Dialogue: 0,0:08:45.66,0:08:49.86,Default,,0000,0000,0000,,≪Мейірімді бала... Менің шәкіртім күткендей≫
Dialogue: 0,0:08:49.86,0:08:52.56,Default,,0000,0000,0000,,Иә. Таңертеңнен бері басым ауырып тұр...
Dialogue: 0,0:08:52.56,0:08:54.56,Default,,0000,0000,0000,,Ауруханада дәрі-дәрмек бар.
Dialogue: 0,0:08:56.93,0:08:58.62,Default,,0000,0000,0000,,Бас ауруын табандылықпен басқаруға болады.
Dialogue: 0,0:08:58.62,0:09:00.81,Default,,0000,0000,0000,,Ах... (Сато) Ах~.
Dialogue: 0,0:09:00.81,0:09:04.51,Default,,0000,0000,0000,,Ах! (Сато) Жоқ, Кито мырза →
Dialogue: 0,0:09:04.51,0:09:07.54,Default,,0000,0000,0000,,Сонымен қатар ақ халатты киіңіз. Тоқта, оны киесің.
Dialogue: 0,0:09:07.54,0:09:09.23,Default,,0000,0000,0000,,Қарғыс атсын...бұл жеке бас бостандығы! →
Dialogue: 0,0:09:09.23,0:09:13.44,Default,,0000,0000,0000,,Мен мұғалім келмей тұрып-ақ ақ халатты едім!
Dialogue: 0,0:09:13.44,0:09:15.46,Default,,0000,0000,0000,,Бірақ ақ халаттылар туралы айтсақ→
Dialogue: 0,0:09:15.46,0:09:18.15,Default,,0000,0000,0000,,Сіз денсаулық сақтау мұғалімі болуыңыз керек, солай ма?
Dialogue: 0,0:09:18.15,0:09:20.67,Default,,0000,0000,0000,,Одан гөрі, профессор Сато→
Dialogue: 0,0:09:20.67,0:09:23.36,Default,,0000,0000,0000,,Мына күлкілі өрнекті жейдеге бірдеңе беріңізші!
Dialogue: 0,0:09:23.36,0:09:26.07,Default,,0000,0000,0000,,Иә~ Сіз менің дәмім нашар дейсіз бе?
Dialogue: 0,0:09:26.07,0:09:29.93,Default,,0000,0000,0000,,Кито-сенсэй де басқа адамдар туралы айта алмайды, солай ма?
Dialogue: 0,0:09:29.93,0:09:32.13,Default,,0000,0000,0000,,Олай болса, Тоору-сан шешсін!
Dialogue: 0,0:09:32.13,0:09:34.98,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:09:34.98,0:09:37.84,Default,,0000,0000,0000,,О? Тоору мырза? (Сато) Уни-чан?
Dialogue: 0,0:09:37.84,0:09:40.53,Default,,0000,0000,0000,,Тоору-сан! (Сато) Кито мырза→
Dialogue: 0,0:09:40.53,0:09:42.73,Default,,0000,0000,0000,,Урчин-чан, сен оны баспадың ба? (Кито) Бұл не?!→
Dialogue: 0,0:09:42.73,0:09:45.92,Default,,0000,0000,0000,,Сато мырза! (Сато) Жоқ, бұл Кито-сенсэй!
Dialogue: 0,0:09:45.92,0:09:48.61,Default,,0000,0000,0000,,Жоқ, бұл Сато мырза! (Сато) Жоқ...
Dialogue: 0,0:09:48.61,0:09:50.61,Default,,0000,0000,0000,,Бұл кішкентай емес.
Dialogue: 0,0:09:52.33,0:09:55.69,Default,,0000,0000,0000,,≪Ах... бұл →
Dialogue: 0,0:09:55.69,0:09:58.55,Default,,0000,0000,0000,,Егер бұл SOS сигналы болса ше!?→
Dialogue: 0,0:09:58.55,0:10:00.40,Default,,0000,0000,0000,,Ах! →
Dialogue: 0,0:10:00.40,0:10:03.43,Default,,0000,0000,0000,,Бұл бірінші сынып кабинеті ме? Күту уақыты! ≫
Dialogue: 0,0:10:03.43,0:10:05.79,Default,,0000,0000,0000,,Баса Баса!
Dialogue: 0,0:10:05.79,0:10:07.31,Default,,0000,0000,0000,,Енді бірінші қабатқа түсудің қажеті жоқ→
Dialogue: 0,0:10:07.31,0:10:10.83,Default,,0000,0000,0000,,Ұнтақ Оны алып тастауға болады. Қалай →
Dialogue: 0,0:10:10.83,0:10:13.87,Default,,0000,0000,0000,,Тақтаның өшіргіші осындай тәртіпсіздік жасайды.
Dialogue: 0,0:10:13.87,0:10:15.72,Default,,0000,0000,0000,,Сәлем. «Эй» емес.
Dialogue: 0,0:10:15.72,0:10:18.91,Default,,0000,0000,0000,,Сылдырмақ... Жарылыс! (Есік дыбысы) (Михо Ютака) Иә?
Dialogue: 0,0:10:18.91,0:10:20.77,Default,,0000,0000,0000,,Өрт шықты ма?! Хахаха...
Dialogue: 0,0:10:20.77,0:10:23.77,Default,,0000,0000,0000,,Иә? Ах!
Dialogue: 0,0:10:25.66,0:10:28.68,Default,,0000,0000,0000,,Ум, Сенпай. (Юко) Аа...
Dialogue: 0,0:10:28.68,0:10:30.04,Default,,0000,0000,0000,,Не болды? (Юко) Аа... →
Dialogue: 0,0:10:30.04,0:10:34.91,Default,,0000,0000,0000,,≪Бұл ауа... сөзсіз менің сүйіктім≫
Dialogue: 0,0:10:34.91,0:10:38.78,Default,,0000,0000,0000,,Ах... А, анау~→
Dialogue: 0,0:10:38.78,0:10:42.15,Default,,0000,0000,0000,,Ал... Тазалауға келдім.
Dialogue: 0,0:10:42.15,0:10:44.67,Default,,0000,0000,0000,,≪Менің өлгім келеді! ≫
Dialogue: 0,0:10:44.67,0:10:46.86,Default,,0000,0000,0000,,Кешіріңіз, Сенпай. Апыр-ай!
Dialogue: 0,0:10:46.86,0:10:49.40,Default,,0000,0000,0000,,Мына бала тентектерге толы. (Юко) Жоқ... Жоқ, жарайды. →
Dialogue: 0,0:10:49.40,0:10:53.93,Default,,0000,0000,0000,,Маған қате түсіну оңай.
Dialogue: 0,0:10:53.93,0:10:56.63,Default,,0000,0000,0000,,Одан да күлкілі әңгімелер бар.
Dialogue: 0,0:10:56.63,0:10:59.83,Default,,0000,0000,0000,,Сәлем Тоору.
Dialogue: 0,0:10:59.83,0:11:02.19,Default,,0000,0000,0000,,Егер мен Ютаканы ертерек тоқтатқан болсам→
Dialogue: 0,0:11:02.19,0:11:06.56,Default,,0000,0000,0000,,Юко осылай ұялмаса екен.
Dialogue: 0,0:11:06.56,0:11:09.76,Default,,0000,0000,0000,,Кешіріңіз. (Юко) Тоқта! →
Dialogue: 0,0:11:09.76,0:11:11.61,Default,,0000,0000,0000,,Кешірім сұрама~! →
Dialogue: 0,0:11:11.61,0:11:15.15,Default,,0000,0000,0000,,Керісінше, кешірім сұрағанда мен ұяламын.
Dialogue: 0,0:11:15.15,0:11:18.01,Default,,0000,0000,0000,,Кешіріңіз. (Юко) Тоқта!
Dialogue: 0,0:11:18.01,0:11:20.01,Default,,0000,0000,0000,,Сіз асығыссыз. Мұнда!
Dialogue: 0,0:11:21.22,0:11:24.57,Default,,0000,0000,0000,,Шынымен, мен апат сигналын жібердім.
Dialogue: 0,0:11:24.57,0:11:27.27,Default,,0000,0000,0000,,Соны көргенде ойыма от қана түсті.
Dialogue: 0,0:11:27.27,0:11:29.46,Default,,0000,0000,0000,,Өрт болса, түтін шығады, солай ма?
Dialogue: 0,0:11:29.46,0:11:34.84,Default,,0000,0000,0000,,Бұл тым темпераментті. Сіз тағы біраз тыныштанғаныңыз жөн.
Dialogue: 0,0:11:34.84,0:11:37.20,Default,,0000,0000,0000,,Иә, Наги-чан.
Dialogue: 0,0:11:37.20,0:11:39.89,Default,,0000,0000,0000,,Күн ыстық! Немесе... өрт! →
Dialogue: 0,0:11:39.89,0:11:41.25,Default,,0000,0000,0000,,Ах! →
Dialogue: 0,0:11:41.25,0:11:45.45,Default,,0000,0000,0000,,Бұлай дүрбелең жасау жақсы емес... →
Dialogue: 0,0:11:45.45,0:11:47.64,Default,,0000,0000,0000,,Міне! Неліктен жаз?
Dialogue: 0,0:11:47.64,0:11:49.16,Default,,0000,0000,0000,,Күн ыстық!
Dialogue: 0,0:11:49.16,0:11:52.52,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:11:52.52,0:11:56.56,Default,,0000,0000,0000,,Мен асығыс болғандықтан қателік жібердім. иә….
Dialogue: 0,0:11:56.56,0:11:59.42,Default,,0000,0000,0000,,Ыстық! Өйткені, адамдар →
Dialogue: 0,0:11:59.42,0:12:02.12,Default,,0000,0000,0000,,Дүрбелең болса жақсы емес. Иә.
Dialogue: 0,0:12:02.12,0:12:04.48,Default,,0000,0000,0000,,Менікке көмектесу мүмкін емес. →
Dialogue: 0,0:12:04.48,0:12:07.17,Default,,0000,0000,0000,,Шынымды айтсам, егер өрт болса, қорқынышты болар еді.
Dialogue: 0,0:12:07.17,0:12:10.37,Default,,0000,0000,0000,,Дұрыс! Жаздың ортасында ыстық кофе →
Dialogue: 0,0:12:10.37,0:12:12.89,Default,,0000,0000,0000,,Жынды! Бұл дұрыс!
Dialogue: 0,0:12:12.89,0:12:15.92,Default,,0000,0000,0000,,Жазда автоматтардан ыстық сусындарды алып тастау керек!
Dialogue: 0,0:12:15.92,0:12:17.11,Default,,0000,0000,0000,,О.
Dialogue: 0,0:12:17.11,0:12:20.11,Default,,0000,0000,0000,,Жоқ, бұл дұрыс емес. иә?
Dialogue: 0,0:14:28.41,0:14:32.12,Default,,0000,0000,0000,,Ах! Не болып жатыр →
Dialogue: 0,0:14:32.12,0:14:35.82,Default,,0000,0000,0000,,Сауалнаманы мектепте ұмытып қалдым.
Dialogue: 0,0:14:35.82,0:14:37.34,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:14:37.34,0:14:39.34,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:14:42.73,0:14:45.91,Default,,0000,0000,0000,,Иә? →
Dialogue: 0,0:14:45.91,0:14:47.61,Default,,0000,0000,0000,,Жарайды... →
Dialogue: 0,0:14:47.61,0:14:51.15,Default,,0000,0000,0000,,Юко? «Мен мектепте сауалнама парағын ұмытып кетіппін.→
Dialogue: 0,0:14:51.15,0:14:55.35,Default,,0000,0000,0000,,Барып алғым келеді, бірақ жалғыз баруға қорқамын. →
Dialogue: 0,0:14:55.35,0:14:57.87,Default,,0000,0000,0000,,Бірге болыңыз.
Dialogue: 0,0:14:57.87,0:14:59.22,Default,,0000,0000,0000,,Сондықтан... сондықтан үрейленбеңіз→
Dialogue: 0,0:14:59.22,0:15:02.58,Default,,0000,0000,0000,,Сонша... Йотто.
Dialogue: 0,0:15:02.58,0:15:05.95,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:15:05.95,0:15:09.82,Default,,0000,0000,0000,,«Жаңа оқу жылына дейін қалдырыңыз». Мен оны ұнатпаймын!
Dialogue: 0,0:15:09.82,0:15:11.01,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:15:11.01,0:15:13.20,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:15:13.20,0:15:16.89,Default,,0000,0000,0000,,«Мұқият ойлап, жазғым келеді.→
Dialogue: 0,0:15:16.89,0:15:20.77,Default,,0000,0000,0000,,Менімен бірге жүріңізші! ». Аа~ қазірдің өзінде.
Dialogue: 0,0:15:20.77,0:15:22.77,Default,,0000,0000,0000,,(Пошта қоңырау үні)
Dialogue: 0,0:15:23.80,0:15:26.32,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:15:26.32,0:15:28.35,Default,,0000,0000,0000,,(Пошта қоңырау үні)
Dialogue: 0,0:15:28.35,0:15:32.05,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:15:32.05,0:15:35.25,Default,,0000,0000,0000,,Иә? Бұл «тым қорқынышты» ма?
Dialogue: 0,0:15:35.25,0:15:37.94,Default,,0000,0000,0000,,Хаа хаа ха....
Dialogue: 0,0:15:37.94,0:15:40.46,Default,,0000,0000,0000,,≪Кешіріңіз... кешігіп қалдым≫
Dialogue: 0,0:15:40.46,0:15:42.32,Default,,0000,0000,0000,,≪Наги келді≫
Dialogue: 0,0:15:42.32,0:15:45.35,Default,,0000,0000,0000,,Келді! Бұл жерде! Эй!
Dialogue: 0,0:15:45.35,0:15:49.89,Default,,0000,0000,0000,,Күрсін... Күрсін... А? Неге бәрі осында?
Dialogue: 0,0:15:49.89,0:15:52.25,Default,,0000,0000,0000,,Мен екеуіне де хабарластым.
Dialogue: 0,0:15:52.25,0:15:54.28,Default,,0000,0000,0000,,Негізгі қақпа ашық па? біз→
Dialogue: 0,0:15:54.28,0:15:59.49,Default,,0000,0000,0000,,Мен артқы қақпадан кірдім. Артқы қақпа алыс.
Dialogue: 0,0:15:59.49,0:16:02.19,Default,,0000,0000,0000,,Юуко, мұнда бар жылдамдықпен кел.
Dialogue: 0,0:16:02.19,0:16:06.56,Default,,0000,0000,0000,,Иә, иә. Жарайды, кеттік. Иә, бастаңыз!
Dialogue: 0,0:16:06.56,0:16:08.75,Default,,0000,0000,0000,,Ахаха. Мен шыдамсызмын.
Dialogue: 0,0:16:08.75,0:16:11.78,Default,,0000,0000,0000,,Жарайсың ба? Артқа қарама!
Dialogue: 0,0:16:11.78,0:16:13.96,Default,,0000,0000,0000,,Не? қазірдің өзінде.
Dialogue: 0,0:16:13.96,0:16:17.50,Default,,0000,0000,0000,,Уау... Уау...
Dialogue: 0,0:16:17.50,0:16:20.53,Default,,0000,0000,0000,,Иә? Ууу... хаха...
Dialogue: 0,0:16:20.53,0:16:22.89,Default,,0000,0000,0000,,Мен... Мен оны жек көремін!! Уау (ит үреді)
Dialogue: 0,0:16:22.89,0:16:25.58,Default,,0000,0000,0000,,Уау! Уф уф!
Dialogue: 0,0:16:25.58,0:16:29.46,Default,,0000,0000,0000,,Күрсін... Күрсін... Мен өзімнің жеке басымды алдым.
Dialogue: 0,0:16:29.46,0:16:32.82,Default,,0000,0000,0000,,Жүр, ұмытып кеткен нәрсені алайық.
Dialogue: 0,0:16:32.82,0:16:35.02,Default,,0000,0000,0000,,Күтіңіз. Мен әлі қозғала алмаймын...
Dialogue: 0,0:16:35.02,0:16:37.20,Default,,0000,0000,0000,,Ах. Қайтыс болды.
Dialogue: 0,0:16:37.20,0:16:41.91,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:16:41.91,0:16:43.10,Default,,0000,0000,0000,,Хмм, бұл ашық емес шығар.
Dialogue: 0,0:16:43.10,0:16:47.14,Default,,0000,0000,0000,,Ах ха ха.
Dialogue: 0,0:16:47.14,0:16:50.66,Default,,0000,0000,0000,,Күрсіну…. →
Dialogue: 0,0:16:50.66,0:16:52.85,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:16:52.85,0:16:55.54,Default,,0000,0000,0000,,Персоналдың кіруі де жабық па?
Dialogue: 0,0:16:55.54,0:16:58.74,Default,,0000,0000,0000,,Хмм, бұл мүмкін емес пе?
Dialogue: 0,0:16:58.74,0:17:00.74,Default,,0000,0000,0000,,Неліктен оны ашуға тырысып жатырсыз?
Dialogue: 0,0:17:01.11,0:17:03.46,Default,,0000,0000,0000,,Қарғыс атсын. аа….
Dialogue: 0,0:17:03.46,0:17:05.46,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:07.84,0:17:12.72,Default,,0000,0000,0000,,Мм... Түнгі мектеп қорқынышты ғой.
Dialogue: 0,0:17:12.72,0:17:15.08,Default,,0000,0000,0000,,Ах... Ах. Ах.
Dialogue: 0,0:17:15.08,0:17:17.43,Default,,0000,0000,0000,,Уа... эй! →
Dialogue: 0,0:17:17.43,0:17:20.63,Default,,0000,0000,0000,,Мен оны жек көремін!!
Dialogue: 0,0:17:20.63,0:17:22.15,Default,,0000,0000,0000,,Уау! (Юко) Уф...
Dialogue: 0,0:17:22.15,0:17:24.51,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:24.51,0:17:28.72,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:17:28.72,0:17:31.24,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:17:31.24,0:17:34.44,Default,,0000,0000,0000,,Жоқ, терезе кездейсоқ ашылды.
Dialogue: 0,0:17:34.44,0:17:36.13,Default,,0000,0000,0000,,Мен абайсызда болдым, бірақ бүгін құтқарылдым.
Dialogue: 0,0:17:36.13,0:17:38.48,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:17:38.48,0:17:42.85,Default,,0000,0000,0000,,Хмм... Юуко, сен тым жабысып тұрсың. Өйткені~!
Dialogue: 0,0:17:42.85,0:17:45.21,Default,,0000,0000,0000,,Мен біреуге байланып қаламын ба деп уайымдаймын.
Dialogue: 0,0:17:45.21,0:17:47.57,Default,,0000,0000,0000,,Мен түсіндім. иә?
Dialogue: 0,0:17:47.57,0:17:50.77,Default,,0000,0000,0000,,Мен ғылым бөлмесіне барып, сізге адам үлгісін әкелемін.
Dialogue: 0,0:17:50.77,0:17:54.63,Default,,0000,0000,0000,,Мен оны жек көремін! Тоқта! Ұнамаса, кет!
Dialogue: 0,0:17:54.63,0:17:57.67,Default,,0000,0000,0000,,Мен оны одан сайын жек көремін. Көңілді сияқты.
Dialogue: 0,0:17:57.67,0:17:59.19,Default,,0000,0000,0000,,Жоқ... Мен білмеймін.
Dialogue: 0,0:17:59.19,0:18:02.39,Default,,0000,0000,0000,,Енді...Юко қатты қорқады.
Dialogue: 0,0:18:02.39,0:18:05.24,Default,,0000,0000,0000,,Өйткені түнгі мектеп әдеттегіден өзгеше→
Dialogue: 0,0:18:05.24,0:18:07.60,Default,,0000,0000,0000,,Бұл қорқынышты. Ах.
Dialogue: 0,0:18:07.60,0:18:10.47,Default,,0000,0000,0000,,Не? Хэхе…→
Dialogue: 0,0:18:10.47,0:18:13.83,Default,,0000,0000,0000,,Хэхехе~. Эй →
Dialogue: 0,0:18:13.83,0:18:17.54,Default,,0000,0000,0000,,Түнгі мектепке дейін келдім... (Юко) А?
Dialogue: 0,0:18:17.54,0:18:19.72,Default,,0000,0000,0000,,Келіңіздер, зерттеп көрейік!
Dialogue: 0,0:18:19.72,0:18:22.42,Default,,0000,0000,0000,,Иә!? (2 адам) О!
Dialogue: 0,0:18:22.42,0:18:25.42,Default,,0000,0000,0000,,Кеттік! (Тору жүгіру) О!
Dialogue: 0,0:18:26.80,0:18:29.16,Default,,0000,0000,0000,,А... күте тұрыңыз!
Dialogue: 0,0:18:29.16,0:18:49.52,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:18:49.52,0:19:03.49,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:19:03.49,0:19:22.35,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:19:22.35,0:19:36.66,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:19:36.66,0:19:38.66,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:19:42.22,0:19:44.41,Default,,0000,0000,0000,,Ха ха ха!
Dialogue: 0,0:19:44.41,0:19:47.77,Default,,0000,0000,0000,,Түнгі мектеп өте қызықты!
Dialogue: 0,0:19:47.77,0:19:50.13,Default,,0000,0000,0000,,Ах. (Юко) Ух...
Dialogue: 0,0:19:50.13,0:19:52.13,Default,,0000,0000,0000,,Қорқынышты.
Dialogue: 0,0:19:54.83,0:19:57.37,Default,,0000,0000,0000,,А, бұл...
Dialogue: 0,0:19:57.37,0:19:59.89,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:19:59.89,0:20:01.08,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:20:01.08,0:20:05.94,Default,,0000,0000,0000,,Дәретхана…. Ах. →
Dialogue: 0,0:20:05.94,0:20:07.46,Default,,0000,0000,0000,,～
Dialogue: 0,0:20:07.46,0:20:09.82,Default,,0000,0000,0000,,Мен дәретхананың қасында біраз тоқтаймын.
Dialogue: 0,0:20:09.82,0:20:12.51,Default,,0000,0000,0000,,Иә, мен күтемін.
Dialogue: 0,0:20:12.51,0:20:14.87,Default,,0000,0000,0000,,Біз ваннаға бірге бара алмаймыз.
Dialogue: 0,0:20:14.87,0:20:18.87,Default,,0000,0000,0000,,（）
Dialogue: 0,0:20:19.59,0:20:23.29,Default,,0000,0000,0000,,Мм... электр тогы. Асықшы!
Dialogue: 0,0:20:23.29,0:20:25.98,Default,,0000,0000,0000,,​​Түсіндім.
Dialogue: 0,0:20:25.98,0:20:28.18,Default,,0000,0000,0000,,Фу. иә?
Dialogue: 0,0:20:28.18,0:20:31.18,Default,,0000,0000,0000,,Не? не? Жоқ, бұл...
Dialogue: 0,0:20:34.90,0:20:36.90,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:20:38.28,0:20:41.47,Default,,0000,0000,0000,,（ ）～～!!→
Dialogue: 0,0:20:41.47,0:20:43.16,Default,,0000,0000,0000,,Ха ха ха! Апыр-ай!
Dialogue: 0,0:20:43.16,0:20:46.52,Default,,0000,0000,0000,,Ха ха ха! (Юко) Уау!
Dialogue: 0,0:20:46.52,0:20:48.54,Default,,0000,0000,0000,,Уау! (Юко Наги) Хахаха...
Dialogue: 0,0:20:48.54,0:20:50.89,Default,,0000,0000,0000,,Бұл шықты Ол шықты! Ол шықты! Ол шықты!
Dialogue: 0,0:20:50.89,0:20:52.89,Default,,0000,0000,0000,,Іш қатуды басады? Бұл сол емес!
Dialogue: 0,0:20:54.94,0:20:56.62,Default,,0000,0000,0000,,Хаа хаа ха...→
Dialogue: 0,0:20:56.62,0:20:58.98,Default,,0000,0000,0000,,Күрсін... Күрсін. →
Dialogue: 0,0:20:58.98,0:21:02.68,Default,,0000,0000,0000,,Хм... Ана жақтағы спорт залдың сыртында адам жаны бар!
Dialogue: 0,0:21:02.68,0:21:04.04,Default,,0000,0000,0000,,Адамның жаны - адам өлгеннен кейін бірден болатын нәрсе→
Dialogue: 0,0:21:04.04,0:21:07.23,Default,,0000,0000,0000,,Шыққан сол ма? (Юко) Иә?
Dialogue: 0,0:21:07.23,0:21:10.43,Default,,0000,0000,0000,,Егер сіз оны дереу қайтарсаңыз, сіз әлі де құтқарыла аласыз!
Dialogue: 0,0:21:10.43,0:21:12.79,Default,,0000,0000,0000,,Не айттыңыз! Шш!
Dialogue: 0,0:21:12.79,0:21:15.48,Default,,0000,0000,0000,,…（） （ ）
Dialogue: 0,0:21:15.48,0:21:18.68,Default,,0000,0000,0000,,…
Dialogue: 0,0:21:18.68,0:21:20.37,Default,,0000,0000,0000,,Хигучи расталды.
Dialogue: 0,0:21:20.37,0:21:24.90,Default,,0000,0000,0000,,≪Аяқ... ұры ма? ≫
Dialogue: 0,0:21:24.90,0:21:32.48,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:21:32.48,0:21:35.35,Default,,0000,0000,0000,,Кеңестер Кеңестер Кеңестер…
Dialogue: 0,0:21:35.35,0:21:41.07,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:21:41.07,0:21:43.07,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:21:46.62,0:21:48.62,Default,,0000,0000,0000,,Қарғыс атсын.
Dialogue: 0,0:21:50.83,0:21:53.86,Default,,0000,0000,0000,,Иә?Ах!
Dialogue: 0,0:21:53.86,0:21:56.89,Default,,0000,0000,0000,,Иә? Урчин-чан? Уууу...
Dialogue: 0,0:21:56.89,0:21:59.59,Default,,0000,0000,0000,,Ах. Не, Сато мырза?
Dialogue: 0,0:21:59.59,0:22:02.28,Default,,0000,0000,0000,,Мен таң қалып, адасып қалдым. (Сато) Не ​​істеп жатырсың? →
Dialogue: 0,0:22:02.28,0:22:04.28,Default,,0000,0000,0000,,Осындай уақытта. иә?
Dialogue: 0,0:22:06.49,0:22:09.49,Default,,0000,0000,0000,,Мен тазалауға келдім. (Юко) Мен оны жек көремін!
Dialogue: 0,0:22:11.20,0:22:14.56,Default,,0000,0000,0000,,Эй, сен ұмытып кеткен бір нәрсені алуға келген шығарсың.
Dialogue: 0,0:22:14.56,0:22:17.27,Default,,0000,0000,0000,,Иә, дұрыс. Мұғалім, анау шырақ ше?
Dialogue: 0,0:22:17.27,0:22:21.47,Default,,0000,0000,0000,,А, мен шамдарды жақсы көремін.
Dialogue: 0,0:22:21.47,0:22:25.34,Default,,0000,0000,0000,,Бұл уақытша жалын менің өмірім сияқты сезіледі.
Dialogue: 0,0:22:25.34,0:22:27.20,Default,,0000,0000,0000,,Сіз жақындықты айтасыз ба?
Dialogue: 0,0:22:27.20,0:22:29.22,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:22:29.22,0:22:31.08,Default,,0000,0000,0000,,Ах…. Bang!
Dialogue: 0,0:22:31.08,0:22:34.08,Default,,0000,0000,0000,,А, мен құлап қалдым. Бұл сыпайы.
Dialogue: 0,0:22:36.29,0:22:40.00,Default,,0000,0000,0000,,Ол қозғалмайды. Шынымен, ол құлап қалды ма?
Dialogue: 0,0:22:40.00,0:22:42.85,Default,,0000,0000,0000,,Ұстама! қиын!
Dialogue: 0,0:22:42.85,0:22:45.21,Default,,0000,0000,0000,,Әзірге біз оны емханаға апаруымыз керек!
Dialogue: 0,0:22:45.21,0:22:48.58,Default,,0000,0000,0000,,Бетпен жату қауіпті! Мен бетімді уқалап жатырмын.
Dialogue: 0,0:22:48.58,0:22:51.28,Default,,0000,0000,0000,,Не? Хмм… мм…. →
Dialogue: 0,0:22:51.28,0:22:55.81,Default,,0000,0000,0000,,Ах~ Қарғыс атқыр, тым ауыр. Сіз оны көтере алмайсыз ба? бұл.
Dialogue: 0,0:22:55.81,0:22:59.69,Default,,0000,0000,0000,,А, дұрыс! Тек кереуетті осында әкел!
Dialogue: 0,0:22:59.69,0:23:01.88,Default,,0000,0000,0000,,Сонда не істейміз? →
Dialogue: 0,0:23:01.88,0:23:04.07,Default,,0000,0000,0000,,Мынаны екі адам ұстайды, демек бұл аяқтар. →
Dialogue: 0,0:23:04.07,0:23:07.76,Default,,0000,0000,0000,,Тоору – көмекші. Жақсы ма?
Dialogue: 0,0:23:07.76,0:23:09.79,Default,,0000,0000,0000,,Иә. Түсіндім.
Dialogue: 0,0:23:09.79,0:23:12.14,Default,,0000,0000,0000,,Кеттік! Сен~жоқ.
Dialogue: 0,0:23:12.14,0:23:14.17,Default,,0000,0000,0000,,Хмм…. (Юко) Хмм...
Dialogue: 0,0:23:14.17,0:23:17.37,Default,,0000,0000,0000,,Бұл ауыр.
Dialogue: 0,0:23:17.37,0:23:19.89,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:23:19.89,0:23:21.41,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:23:21.41,0:23:24.93,Default,,0000,0000,0000,,≪Иә? Ол жеңілірек болды≫
Dialogue: 0,0:23:24.93,0:23:26.12,Default,,0000,0000,0000,,≪Хо Хо Хо…≫
Dialogue: 0,0:23:26.12,0:23:29.49,Default,,0000,0000,0000,,Жүгіру денесі жоқ!
Dialogue: 0,0:23:29.49,0:23:31.67,Default,,0000,0000,0000,,Не? (Юко) Иә? →
Dialogue: 0,0:23:31.67,0:23:34.67,Default,,0000,0000,0000,,Мен оны жек көремін!! Хахаха.
Dialogue: 0,0:23:36.06,0:23:39.58,Default,,0000,0000,0000,,Жақсы ату!
Dialogue: 0,0:23:39.58,0:23:41.94,Default,,0000,0000,0000,,Мен шаршадым.
Dialogue: 0,0:23:41.94,0:23:43.13,Default,,0000,0000,0000,,Ах. (Сато) Арх! Ах... →
Dialogue: 0,0:23:43.13,0:23:46.49,Default,,0000,0000,0000,,Уф...уһ... Бұл болмайды.
Dialogue: 0,0:23:46.49,0:23:49.85,Default,,0000,0000,0000,,Тоқта. Мұғалім, сенімді болыңыз.
Dialogue: 0,0:23:49.85,0:23:52.71,Default,,0000,0000,0000,,Баши! (Юко) Егер сіз осындай нәрсе жасасаңыз ...
Dialogue: 0,0:23:52.71,0:23:54.23,Default,,0000,0000,0000,,≪Жақсы сезінеді≫
Dialogue: 0,0:23:54.23,0:23:56.58,Default,,0000,0000,0000,,Ах…. Сіз байқадыңыз ба?
Dialogue: 0,0:23:56.58,0:23:58.77,Default,,0000,0000,0000,,Хмм... хаха... а... →
Dialogue: 0,0:23:58.77,0:24:00.30,Default,,0000,0000,0000,,Хмм… мм….
Dialogue: 0,0:24:00.30,0:24:02.15,Default,,0000,0000,0000,,Мұғалім! мұғалім!
Dialogue: 0,0:24:02.15,0:24:05.85,Default,,0000,0000,0000,,Мықты болыңыз! мұғалім….
Dialogue: 0,0:24:05.85,0:24:09.55,Default,,0000,0000,0000,,≪Бұл не...? Жүгіру-чан≫
Dialogue: 0,0:24:09.55,0:24:12.25,Default,,0000,0000,0000,,Сато мырза, мен сіздің өлгеніңізді қаламаймын!
Dialogue: 0,0:24:12.25,0:24:15.44,Default,,0000,0000,0000,,≪Рунчан≫
Dialogue: 0,0:24:15.44,0:24:19.48,Default,,0000,0000,0000,,Мен өлмеймін. Апыр-ай!
Dialogue: 0,0:24:19.48,0:24:22.35,Default,,0000,0000,0000,,Түйіспе.
Dialogue: 0,0:24:22.35,0:24:25.38,Default,,0000,0000,0000,,Мен өлмеймін... Уау! Соқ!
Dialogue: 0,0:24:25.38,0:24:28.38,Default,,0000,0000,0000,,Ах…. (Сато) Қарғыс атсын... Ах... →
Dialogue: 0,0:24:29.92,0:24:32.28,Default,,0000,0000,0000,,Ах…. (Юко) Жақсысың ба?
Dialogue: 0,0:24:32.28,0:24:35.31,Default,,0000,0000,0000,,Ол өлмейтінін айтты. Үйге бар.
Dialogue: 0,0:24:35.31,0:24:38.51,Default,,0000,0000,0000,,Дұрыс. (Сато) Қарғыс атсын...
Dialogue: 0,0:24:38.51,0:24:41.87,Default,,0000,0000,0000,,Сылдырмақ...
Dialogue: 0,0:24:41.87,0:24:44.40,Default,,0000,0000,0000,,Ит жақсы емес пе? Жоқ, жоқ, жоқ.
Dialogue: 0,0:24:44.40,0:24:47.40,Default,,0000,0000,0000,,Ах~ мен қатты шаршадым.
Dialogue: 0,0:24:49.45,0:24:52.45,Default,,0000,0000,0000,,Қайырлы түн. (Тоору Юуко жүгіру) Қайырлы түн.
Dialogue: 0,0:24:53.49,0:24:55.18,Default,,0000,0000,0000,,Жақында 3-платформада →
Dialogue: 0,0:24:55.18,0:24:58.87,Default,,0000,0000,0000,,Пойыз келе жатыр. →
Dialogue: 0,0:24:58.87,0:25:02.91,Default,,0000,0000,0000,,…
Dialogue: 0,0:25:02.91,0:25:06.45,Default,,0000,0000,0000,,Жақында кездескенше! (Юко) Иә, тағы кездескенше!
Dialogue: 0,0:25:06.45,0:25:15.88,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:15.88,0:25:19.75,Default,,0000,0000,0000,,Пуруруру… (кету қоңырауы) Басыңыз! (пойыз есігінің дыбысы)
Dialogue: 0,0:25:19.75,0:25:23.46,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:23.46,0:25:25.81,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:25:25.81,0:25:28.00,Default,,0000,0000,0000,,≪Бүгін барлығының осында болғанына қуаныштымын≫
Dialogue: 0,0:25:28.00,0:25:31.54,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:31.54,0:25:33.90,Default,,0000,0000,0000,,Ах.→
Dialogue: 0,0:25:33.90,0:25:36.42,Default,,0000,0000,0000,,Мен тағы да ұмытып кеттім!
Dialogue: 0,0:25:36.42,0:25:43.42,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:44.50,0:25:54.77,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:54.77,0:25:59.48,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:59.48,0:26:07.56,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:07.56,0:26:13.12,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:13.12,0:26:27.59,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:27.59,0:26:46.45,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:26:46.45,0:26:53.45,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:03.12,0:27:12.12,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:17.93,0:27:19.45,Default,,0000,0000,0000,,Хмм…→
Dialogue: 0,0:27:19.45,0:27:21.45,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:27:23.49,0:27:25.51,Default,,0000,0000,0000,,≪Соңында мен уақытымды босқа кетірдім→
Dialogue: 0,0:27:25.51,0:27:28.04,Default,,0000,0000,0000,,Мен қатты қорықтым →
Dialogue: 0,0:27:28.04,0:27:30.56,Default,,0000,0000,0000,,Мен мүлдем ұйықтай алмаймын≫
Dialogue: 0,0:27:30.56,0:27:33.09,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:27:33.09,0:27:36.79,Default,,0000,0000,0000,,≪Осы жаста отбасымның менімен жатқанына сене алар емеспін→
Dialogue: 0,0:27:36.79,0:27:38.79,Default,,0000,0000,0000,,Оны айта алмаймын...≫
Dialogue: 0,0:27:40.33,0:27:42.18,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:27:42.18,0:27:44.18,Default,,0000,0000,0000,,≪Иә! ≫
Dialogue: 0,0:27:46.22,0:27:49.25,Default,,0000,0000,0000,,Бірге жатқанымызға біраз болды.
Dialogue: 0,0:27:49.25,0:27:52.25,Default,,0000,0000,0000,,Хехехе. қайырлы түн.
Dialogue: 0,0:27:53.75,0:27:59.75,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory