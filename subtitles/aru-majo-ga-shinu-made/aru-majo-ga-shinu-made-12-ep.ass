Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.83,0:00:10.84,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:00:10.84,0:00:14.68,Default,,0,0,0,,Шыу!
Dialogue: 0,0:00:14.68,0:00:20.35,Default,,0,0,0,,((Мегтің анасы: Ха ха ха ха ха ха ха ха... аа...
Dialogue: 0,0:00:20.35,0:00:24.19,Default,,0,0,0,,Әй... Құдай, мына балаға көмектес!
Dialogue: 0,0:00:24.19,0:00:29.52,Default,,0,0,0,,Мына бала... Мег жалғыз! Ах...))
Dialogue: 0,0:00:29.52,0:00:31.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:31.53,0:00:36.03,Default,,0,0,0,,Бұл не... арман?
Dialogue: 0,0:00:39.70,0:00:42.70,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:02:24.01,0:02:26.51,Default,,0,0,0,,Мег-чан, өзіңді жақсы сезінбейтін сияқтысың➡
Dialogue: 0,0:02:26.51,0:02:31.18,Default,,0,0,0,,Амансың ба? Жарайды. Ұйықтасаң жақсы боласың.
Dialogue: 0,0:02:31.18,0:02:33.18,Default,,0,0,0,,Ұйықтап жатсаңыз.
Dialogue: 0,0:02:33.18,0:02:38.52,Default,,0,0,0,,Уф... Мен ұйықтап жатырмын... Хоухоу. (Карбункул) Сықырлау.
Dialogue: 0,0:02:38.52,0:02:43.36,Default,,0,0,0,,Мен үшін уайымдағандарың өте мейірімді.
Dialogue: 0,0:02:43.36,0:02:45.36,Default,,0,0,0,,Онымен салыстырғанда, әлгі жын-шайтан.
Dialogue: 0,0:02:45.36,0:02:48.20,Default,,0,0,0,,Ұйқың қанбай жүрсе де, еркелейсің.
Dialogue: 0,0:02:48.20,0:02:51.37,Default,,0,0,0,,А... жоқ...
Dialogue: 0,0:02:51.37,0:02:54.70,Default,,0,0,0,,Шықыр! Хо! Жарайды... Жарайды.
Dialogue: 0,0:02:54.70,0:02:57.21,Default,,0,0,0,,Мен біраз демаламын.
Dialogue: 0,0:02:57.21,0:02:59.91,Default,,0,0,0,,Иә... сәл ғана.
Dialogue: 0,0:03:01.81,0:03:07.32,Default,,0,0,0,,)
Dialogue: 0,0:03:10.52,0:03:12.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:12.49,0:03:14.66,Default,,0,0,0,,Мен қанша уақыт ұйықтадым?
Dialogue: 0,0:03:14.66,0:03:18.33,Default,,0,0,0,,Cu? Хо?
Dialogue: 0,0:03:18.33,0:03:20.83,Default,,0,0,0,,《Сол сиқыршы...》
Dialogue: 0,0:03:20.83,0:03:23.17,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:03:23.17,0:03:27.00,Default,,0,0,0,,Ах... Ведьма Эльдора.
Dialogue: 0,0:03:27.00,0:03:29.34,Default,,0,0,0,,Мен сіздің үйіңізге бара жатырмын➡
Dialogue: 0,0:03:29.34,0:03:32.37,Default,,0,0,0,,Мен сені кездейсоқ көрдім.
Dialogue: 0,0:03:32.37,0:03:34.84,Default,,0,0,0,,Хохохохо хохохохо хохохохо.... Шах!
Dialogue: 0,0:03:34.84,0:03:37.35,Default,,0,0,0,,Үйге қайтайық, Мег.
Dialogue: 0,0:03:40.85,0:03:45.39,Default,,0,0,0,,Ууу…. О, Мег-чан, сен қазір үйге барасың ба?
Dialogue: 0,0:03:45.39,0:03:47.39,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:03:47.39,0:03:50.03,Default,,0,0,0,,О, бұл Мег. Сіз тапсырмаңызды аяқтадыңыз ба?
Dialogue: 0,0:03:50.03,0:03:53.20,Default,,0,0,0,,Эй, орташа деңгейлі. Мистер Сето?
Dialogue: 0,0:03:53.20,0:03:56.23,Default,,0,0,0,,Аа, бұл Мег-чан. О, Анна.
Dialogue: 0,0:03:56.23,0:03:59.70,Default,,0,0,0,,Үйге ерте барма. Иә, жақында кездескенше.
Dialogue: 0,0:04:04.31,0:04:08.11,Default,,0,0,0,,《Ешкім қарап тұрған жоқ. Жоқ, мен оны көре алмаймын.
Dialogue: 0,0:04:11.48,0:04:14.48,Default,,0,0,0,,Мм... сен неге бұл қаладасың?
Dialogue: 0,0:04:14.48,0:04:18.82,Default,,0,0,0,,Мені, ана... қожайын болуға шақырды.
Dialogue: 0,0:04:18.82,0:04:21.12,Default,,0,0,0,,Не? 《Ана? 》
Dialogue: 0,0:04:25.66,0:04:27.86,Default,,0,0,0,,Элле, сені осында көргеніме қуаныштымын.
Dialogue: 0,0:04:30.17,0:04:32.50,Default,,0,0,0,,Уф… уф… уф….
Dialogue: 0,0:04:32.50,0:04:36.17,Default,,0,0,0,,《Қарғыс атсын... Уф~! Әлемдегі үздік 3-тікке кіріңіз➡
Dialogue: 0,0:04:36.17,0:04:39.01,Default,,0,0,0,,Сиқыршылардың екеуі менің үйімде!
Dialogue: 0,0:04:39.01,0:04:42.34,Default,,0,0,0,,Неліктен? Неліктен? мен неге мұндамын?
Dialogue: 0,0:04:42.34,0:04:47.18,Default,,0,0,0,,Бұл тиіндер тобындағы ұлу сияқты ыңғайсыз.
Dialogue: 0,0:04:47.18,0:04:49.68,Default,,0,0,0,,Иә! Маған айтсаңыз болғаны.
Dialogue: 0,0:04:49.68,0:04:52.85,Default,,0,0,0,,Мен тиінмін мен тиінмін мен тиінмін мен тиінмін➡
Dialogue: 0,0:04:52.85,0:04:55.52,Default,,0,0,0,,Мен тиінмін Мен тиінмін Мен тиінмін Мен тиінмін....
Dialogue: 0,0:04:55.52,0:04:57.69,Default,,0,0,0,,Сіз қанша адам туралы күңкілдейсіз?
Dialogue: 0,0:04:57.69,0:04:59.69,Default,,0,0,0,,Ол қорқынышты бала.
Dialogue: 0,0:04:59.69,0:05:01.80,Default,,0,0,0,,Әдеттегіден көп айырмашылығы жоқ.
Dialogue: 0,0:05:01.80,0:05:04.60,Default,,0,0,0,,Бұл да дұрыс. Оны жоққа шығару.
Dialogue: 0,0:05:06.80,0:05:10.14,Default,,0,0,0,,А... Мег Бұл бала Элле.
Dialogue: 0,0:05:10.14,0:05:13.64,Default,,0,0,0,,Жеті данышпан Эльдора туралы айтатын болсақ, сіз бұл туралы білетін шығарсыз, солай ма?
Dialogue: 0,0:05:13.64,0:05:16.14,Default,,0,0,0,,Иә. Ах, мм...
Dialogue: 0,0:05:16.14,0:05:19.31,Default,,0,0,0,,Бұл сиқырлы рәсім.
Dialogue: 0,0:05:19.31,0:05:22.82,Default,,0,0,0,,Не, балалар, бұрыннан таныссыңдар ма?
Dialogue: 0,0:05:22.82,0:05:26.32,Default,,0,0,0,,Салтанатты жиында біраз әңгімелестік.
Dialogue: 0,0:05:26.32,0:05:28.49,Default,,0,0,0,,Сізді қайтадан көргеніме қуаныштымын.
Dialogue: 0,0:05:28.49,0:05:31.33,Default,,0,0,0,,Сіз біршама өстіңіз. Ол кезде әлі жоқ➡
Dialogue: 0,0:05:31.33,0:05:36.33,Default,,0,0,0,,Нәзік әрі әлсіз болғаны сонша, ұстасаң сынып кететін сияқты.
Dialogue: 0,0:05:36.33,0:05:40.17,Default,,0,0,0,,Қазір қалай? жарықты сезін
Dialogue: 0,0:05:40.17,0:05:43.34,Default,,0,0,0,,Күн сияқты. Эх...
Dialogue: 0,0:05:43.34,0:05:45.84,Default,,0,0,0,,Үміт тасыдың ішіңде.
Dialogue: 0,0:05:45.84,0:05:51.65,Default,,0,0,0,,《Тағы да... бұл адам көзін көргендей сөйлейді》
Dialogue: 0,0:05:54.18,0:05:57.35,Default,,0,0,0,,((Сіз қарғыс астындасыз.
Dialogue: 0,0:05:57.35,0:05:59.39,Default,,0,0,0,,А... Жоқ... Неге? Енді сіз үшін➡
Dialogue: 0,0:05:59.39,0:06:02.29,Default,,0,0,0,,Сізді ауыр тағдыр күтіп тұр.
Dialogue: 0,0:06:02.29,0:06:07.30,Default,,0,0,0,,Қарғыс жойылса, сіз маңызды нәрсені жоғалтасыз))
Dialogue: 0,0:06:07.30,0:06:10.97,Default,,0,0,0,,Олай болса, ұстаз, Эльдора неге мұнда?
Dialogue: 0,0:06:10.97,0:06:16.14,Default,,0,0,0,,Аа, жұлдыздың өзегін жасау жақын арада соңғы сатысында болады.
Dialogue: 0,0:06:16.14,0:06:20.31,Default,,0,0,0,,Олай болса, Эльдора әзірше бос емес.
Dialogue: 0,0:06:20.31,0:06:23.98,Default,,0,0,0,,10 жыл 20 жыл... Жоқ, мүмкін одан да көп.
Dialogue: 0,0:06:23.98,0:06:29.65,Default,,0,0,0,,Бұл бала жұлдызды тазарту үшін жұлдыздың өзегін пайдаланатын орындаушы болады.
Dialogue: 0,0:06:29.65,0:06:31.65,Default,,0,0,0,,Ұзақ уақыт….
Dialogue: 0,0:06:31.65,0:06:35.49,Default,,0,0,0,,Соның алдында мен мына баланы көрсеткім келді.
Dialogue: 0,0:06:35.49,0:06:37.66,Default,,0,0,0,,Менің ескі туған қалам.
Dialogue: 0,0:06:37.66,0:06:41.00,Default,,0,0,0,,Отан? Мен де сен сияқтымын➡
Dialogue: 0,0:06:41.00,0:06:44.00,Default,,0,0,0,,Мені анам көтеріп, осында өстім.
Dialogue: 0,0:06:44.00,0:06:46.67,Default,,0,0,0,,Қайтып келгеніңізге неше жыл болды?
Dialogue: 0,0:06:46.67,0:06:50.17,Default,,0,0,0,,Эльдора сіздің қарындасыңыздың шәкірті, Мег.
Dialogue: 0,0:06:50.17,0:06:53.68,Default,,0,0,0,,Ах... Эльдора-ни-сан дейсіз бе?
Dialogue: 0,0:06:53.68,0:06:57.35,Default,,0,0,0,,Сіз мені әпке дейсіз.
Dialogue: 0,0:06:57.35,0:06:59.35,Default,,0,0,0,,Мен бақыттымын.
Dialogue: 0,0:06:59.35,0:07:01.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:03.29,0:07:06.45,Default,,0,0,0,,Мен бүгін қатты шаршадым.
Dialogue: 0,0:07:06.45,0:07:09.12,Default,,0,0,0,,Кю. Уф….
Dialogue: 0,0:07:09.12,0:07:15.33,Default,,0,0,0,,《Мен Эльдора-ни-санмен сөйлескенде, ол сабырлы және мейірімді адам еді》
Dialogue: 0,0:07:18.67,0:07:24.17,Default,,0,0,0,,((Хаа...
Dialogue: 0,0:07:24.17,0:07:28.18,Default,,0,0,0,,А... Құдайым, мына балаға көмектес!
Dialogue: 0,0:07:28.18,0:07:33.15,Default,,0,0,0,,Бұл бала... Мег жалғыз! Ах...))
Dialogue: 0,0:07:54.17,0:07:57.67,Default,,0,0,0,,Ха... енді...
Dialogue: 0,0:07:57.67,0:08:01.11,Default,,0,0,0,,《Менің сәби кезімдегі естеліктерім? 》
Dialogue: 0,0:08:01.11,0:08:03.51,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:08:07.48,0:08:11.45,Default,,0,0,0,,Е... Эльдора-ни-сан, не болды?
Dialogue: 0,0:08:11.45,0:08:13.79,Default,,0,0,0,,Бөлмеңізден күшті қорқыныш сезімі пайда болады➡
Dialogue: 0,0:08:13.79,0:08:17.29,Default,,0,0,0,,Өйткені ол маған мұра болып қалды. Эй... келме.
Dialogue: 0,0:08:17.29,0:08:20.46,Default,,0,0,0,,Хо! Сүйкімді. Мег, не болды?
Dialogue: 0,0:08:20.46,0:08:23.97,Default,,0,0,0,,Мен түс көрдім. Қандай арман?
Dialogue: 0,0:08:23.97,0:08:29.30,Default,,0,0,0,,Кенет адамдары көп үлкен қалада бір бақсы пайда болады➡
Dialogue: 0,0:08:29.30,0:08:31.97,Default,,0,0,0,,Қала қирады.
Dialogue: 0,0:08:31.97,0:08:34.98,Default,,0,0,0,,Бұл қорқынышты түс.
Dialogue: 0,0:08:34.98,0:08:39.98,Default,,0,0,0,,Қаланы қиратып жатқан бақсы Эльдора апа еді.
Dialogue: 0,0:08:41.98,0:08:44.49,Default,,0,0,0,,Неліктен олай істедің?
Dialogue: 0,0:08:44.49,0:08:48.16,Default,,0,0,0,,Бұл кек алу болды.
Dialogue: 0,0:08:48.16,0:08:50.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:52.19,0:08:55.03,Default,,0,0,0,,)
Dialogue: 0,0:08:55.03,0:08:57.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:57.00,0:08:59.00,Default,,0,0,0,,Өйткені менің отбасым өлтірілді.
Dialogue: 0,0:08:59.00,0:09:02.77,Default,,0,0,0,,Сіздің отбасыңыз сіздің қожайыныңыз емес пе?
Dialogue: 0,0:09:02.77,0:09:05.77,Default,,0,0,0,,Менің басқа отбасым.
Dialogue: 0,0:09:05.77,0:09:09.94,Default,,0,0,0,,А... А, күте тұрыңыз! (есіктің ашылған дыбысы)
Dialogue: 0,0:09:09.94,0:09:12.45,Default,,0,0,0,,Эльдора әпке!
Dialogue: 0,0:09:20.46,0:09:23.06,Default,,0,0,0,,Эл. Ах...
Dialogue: 0,0:09:25.13,0:09:29.63,Default,,0,0,0,,Мама, менің айтқанымды естідіңіз бе?
Dialogue: 0,0:09:31.63,0:09:36.64,Default,,0,0,0,,Мегті өз қамқорлығында ұстау анаң үшін қылмыс болды.
Dialogue: 0,0:09:36.64,0:09:38.97,Default,,0,0,0,,Әй... Ұстаз.
Dialogue: 0,0:09:38.97,0:09:43.31,Default,,0,0,0,,Олай болса Мег екеумізді кездестіруге рұқсат етпеуіңіз керек еді.
Dialogue: 0,0:09:43.31,0:09:48.65,Default,,0,0,0,,Мана Мусуме: Екеуің қол ұстасып, бір-біріңді қолдаңдар деймін.
Dialogue: 0,0:09:48.65,0:09:51.15,Default,,0,0,0,,Мен дәл осылай ойладым.
Dialogue: 0,0:09:53.66,0:09:57.33,Default,,0,0,0,,Егер сіздің анаңыз шынымен Мегті жақсы көрсе➡
Dialogue: 0,0:09:57.33,0:10:01.66,Default,,0,0,0,,Қылмыс жасағың келсе, мені жайына қалдыр➡
Dialogue: 0,0:10:01.66,0:10:04.33,Default,,0,0,0,,Мен Мегтің менімен бірге тұрғанын қаладым.
Dialogue: 0,0:10:04.33,0:10:08.50,Default,,0,0,0,,Сонда Элле, сенің одақтастарың болмайды.
Dialogue: 0,0:10:08.50,0:10:10.51,Default,,0,0,0,,Бүкіл әлем сені жек көреді, сен жалғызсың➡
Dialogue: 0,0:10:10.51,0:10:13.01,Default,,0,0,0,,Сізге өмір сүру керек болады, солай ма?
Dialogue: 0,0:10:13.01,0:10:15.34,Default,,0,0,0,,Бұл жақсы. иә?
Dialogue: 0,0:10:15.34,0:10:18.65,Default,,0,0,0,,Өйткені бұл менің күнәм.
Dialogue: 0,0:10:23.02,0:10:25.02,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:10:25.02,0:10:28.69,Default,,0,0,0,,Мен сені жек көруім керек пе, білмеймін.
Dialogue: 0,0:10:28.69,0:10:31.03,Default,,0,0,0,,Мен де кешірудің басқа екенін сеземін.
Dialogue: 0,0:10:31.03,0:10:33.36,Default,,0,0,0,,Бірақ өшпенділік➡
Dialogue: 0,0:10:33.36,0:10:37.03,Default,,0,0,0,,Менде туған жер туралы қосымшалар немесе естеліктер жоқ.
Dialogue: 0,0:10:37.03,0:10:39.03,Default,,0,0,0,,Шебер айтқандай➡
Dialogue: 0,0:10:39.03,0:10:43.37,Default,,0,0,0,,Дүниеде сені жек көретін адамдар бар шығар.
Dialogue: 0,0:10:43.37,0:10:46.54,Default,,0,0,0,,Сонда да мен сенімен сөйлескім келеді.
Dialogue: 0,0:10:46.54,0:10:48.88,Default,,0,0,0,,Әпкеммен!
Dialogue: 0,0:10:48.88,0:10:54.55,Default,,0,0,0,,Сіз мені әлі әпке деп атайсыз.
Dialogue: 0,0:10:54.55,0:10:58.05,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:10:58.05,0:11:01.86,Default,,0,0,0,,Қайтадан қателессем ше?
Dialogue: 0,0:11:01.86,0:11:03.83,Default,,0,0,0,,Ах... (қоңырау дыбысы)
Dialogue: 0,0:11:03.83,0:11:07.83,Default,,0,0,0,,Өтінемін, мені өлтір.
Dialogue: 0,0:11:10.16,0:11:14.00,Default,,0,0,0,,Шындықты білетін жалғыз адам болғаныма қуанамын.
Dialogue: 0,0:11:14.00,0:11:17.84,Default,,0,0,0,,Оны бейітіме апарсам ба деп ойладым.
Dialogue: 0,0:11:17.84,0:11:25.01,Default,,0,0,0,,Бұл бір бас бармақ сізді жазалау үшін жеткіліксіз.
Dialogue: 0,0:11:25.01,0:11:28.02,Default,,0,0,0,,Мастер...
Dialogue: 0,0:11:28.02,0:11:30.69,Default,,0,0,0,,<Осыдан 17 жыл бұрын жойылған ел➡
Dialogue: 0,0:11:30.69,0:11:34.02,Default,,0,0,0,,Интернеттен қарасам, бірден шықты.
Dialogue: 0,0:11:34.02,0:11:38.53,Default,,0,0,0,,Елдің аты Орлов.
Dialogue: 0,0:11:38.53,0:11:41.70,Default,,0,0,0,,Қарғыстан өлгеніме жарты жылдан аз уақыт қалды.
Dialogue: 0,0:11:41.70,0:11:44.70,Default,,0,0,0,,Бір күнді босқа өткізуге болмайды.
Dialogue: 0,0:11:44.70,0:11:47.54,Default,,0,0,0,,Мен мұны өз басымнан түсінемін, бірақ➡
Dialogue: 0,0:11:47.54,0:11:50.04,Default,,0,0,0,,Бұны білмесең, алға жылжи алмайсың.
Dialogue: 0,0:11:50.04,0:11:52.54,Default,,0,0,0,,Мен бұған да сенімдімін...>
Dialogue: 0,0:11:52.54,0:11:55.04,Default,,0,0,0,,Орлов… Орлов….
Dialogue: 0,0:11:55.04,0:11:57.85,Default,,0,0,0,,Орловтың кітабы мүлдем жоқ.
Dialogue: 0,0:11:59.88,0:12:01.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:01.85,0:12:05.02,Default,,0,0,0,,<'Картада жоқ ел'?
Dialogue: 0,0:12:05.02,0:12:10.19,Default,,0,0,0,,Орлов. Бұл ел әлемдегі ең ұзақ тарихқа ие елдердің бірі➡
Dialogue: 0,0:12:10.19,0:12:15.20,Default,,0,0,0,,Ол әскери өнеркәсібімен өркендеп келе жатқан әлемдегі ең әскерилендірілген мемлекеттердің бірі болды.
Dialogue: 0,0:12:15.20,0:12:19.20,Default,,0,0,0,,Сонымен бірге ол сиқырға қарсы идеологиясы да күшті ел болды.
Dialogue: 0,0:12:19.20,0:12:24.21,Default,,0,0,0,,Сиқыршылар қолданатын сиқыр қаруды оңай залалсыздандырады.
Dialogue: 0,0:12:24.21,0:12:26.54,Default,,0,0,0,,Әскери қаруды дамытатын ел ретінде➡
Dialogue: 0,0:12:26.54,0:12:29.68,Default,,0,0,0,,Орлов ерекше позиция құрды➡
Dialogue: 0,0:12:29.68,0:12:31.88,Default,,0,0,0,,Сахна артында сиқыршылардың қырғыны және ➡
Dialogue: 0,0:12:31.88,0:12:36.35,Default,,0,0,0,,Сондай-ақ оның Халықаралық сиқыршылар қауымдастығын таратуды жоспарлағаны туралы әңгіме бар.
Dialogue: 0,0:12:36.35,0:12:40.52,Default,,0,0,0,,Сиқырды жою үшін Орлов ІІІ дүниежүзілік соғыс үшін күреседі ➡
Dialogue: 0,0:12:40.52,0:12:44.69,Default,,0,0,0,,Триггердің тартылғанына аз ғана уақыт қалды деп айтылды.
Dialogue: 0,0:12:44.69,0:12:47.70,Default,,0,0,0,,Оған апаттың бақсысы Эльдора себепкер болған деседі➡
Dialogue: 0,0:12:47.70,0:12:53.74,Default,,0,0,0,,Сиқырлы апаттан қираған Орлов тұрғындарының көпшілігінің мерзімі өтіп жатыр➡
Dialogue: 0,0:12:53.74,0:13:00.01,Default,,0,0,0,,Қазіргі уақытта бірнеше адамның ғана тірі екені расталғаны айтылады.
Dialogue: 0,0:13:00.01,0:13:04.08,Default,,0,0,0,,《Орлов сиқыршыларды жоймақ болды》
Dialogue: 0,0:13:06.51,0:13:09.35,Default,,0,0,0,,《Эльдора-ни-сан барлығын қорғау үшін осында➡
Dialogue: 0,0:13:09.35,0:13:11.69,Default,,0,0,0,,Бірдеңе болды ма...》
Dialogue: 0,0:13:11.69,0:13:15.86,Default,,0,0,0,,《Картада жоқ ел...》 (Кітапты жабу дыбысы)
Dialogue: 0,0:13:18.03,0:13:22.00,Default,,0,0,0,,《Осында барсам бірдеңе үйрене аламын ба...》
Dialogue: 0,0:13:24.00,0:13:26.00,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:13:26.00,0:13:28.00,Default,,0,0,0,,Мастер, таңғы шай.
Dialogue: 0,0:13:28.00,0:13:30.51,Default,,0,0,0,,Бүгін өте ерте, солай емес пе?
Dialogue: 0,0:13:30.51,0:13:33.01,Default,,0,0,0,,Мен белгілі бір себептермен ұйықтай алмаймын.
Dialogue: 0,0:13:35.01,0:13:38.35,Default,,0,0,0,,Аа...
Dialogue: 0,0:13:38.35,0:13:40.68,Default,,0,0,0,,Иә! Әуе билеті қымбат!
Dialogue: 0,0:13:40.68,0:13:44.35,Default,,0,0,0,,Осы ақшаның бәрін жинасам да, бұл мүмкін емес.
Dialogue: 0,0:13:44.35,0:13:46.52,Default,,0,0,0,,Уа... Қалай?
Dialogue: 0,0:13:46.52,0:13:49.02,Default,,0,0,0,,Қарлы үкі, мені бортқа мінгіз➡
Dialogue: 0,0:13:49.02,0:13:51.86,Default,,0,0,0,,Трансконтинентальды рейс жасап көргіңіз келе ме?
Dialogue: 0,0:13:51.86,0:13:53.86,Default,,0,0,0,,Хоу!
Dialogue: 0,0:14:24.66,0:14:27.50,Default,,0,0,0,,Сіз қалай ойлайсыз? Мастер.
Dialogue: 0,0:14:27.50,0:14:30.00,Default,,0,0,0,,Аа... сондай күшті болыңыз.
Dialogue: 0,0:14:30.00,0:14:32.33,Default,,0,0,0,,Бұл өте егжей-тегжейлі.
Dialogue: 0,0:14:32.33,0:14:35.00,Default,,0,0,0,,Соңғы кездері түбірлерді тым көп басып жатқан жоқсыз ба?
Dialogue: 0,0:14:35.00,0:14:37.67,Default,,0,0,0,,Жұмыс күте алмайды.
Dialogue: 0,0:14:37.67,0:14:40.01,Default,,0,0,0,,Мен сені иығымды осылай ысқылаймын➡
Dialogue: 0,0:14:40.01,0:14:42.68,Default,,0,0,0,,Бар болғаны жарты жыл қалды деген ой мені қынжылтады.
Dialogue: 0,0:14:42.68,0:14:46.68,Default,,0,0,0,,Рұқсатсыз өлтіруге болмайды! Қуаныштың көз жасы ағып жатты...
Dialogue: 0,0:14:46.68,0:14:49.68,Default,,0,0,0,,Уф... жоқ, бұл өте қатал...
Dialogue: 0,0:14:49.68,0:14:54.02,Default,,0,0,0,,Сен шынымен өлесің бе? Ол аурады! Сіз тым қатты итеріп жатырсыз, Мег.
Dialogue: 0,0:14:54.02,0:14:56.02,Default,,0,0,0,,А... мүмкін емес.
Dialogue: 0,0:14:58.03,0:15:00.29,Default,,0,0,0,,Мастер. Бұл не?
Dialogue: 0,0:15:00.29,0:15:03.63,Default,,0,0,0,,Күні кеше мен ``The Uncharted Country'' атты кітапты оқыдым.
Dialogue: 0,0:15:03.63,0:15:06.30,Default,,0,0,0,,Мм... Онда жазылған ел➡
Dialogue: 0,0:15:06.30,0:15:10.17,Default,,0,0,0,,Орловтың топырағы сиқырлы апатпен ластанғаннан кейін➡
Dialogue: 0,0:15:10.17,0:15:13.51,Default,,0,0,0,,Енді елге кіру мүмкін болмады➡
Dialogue: 0,0:15:13.51,0:15:16.68,Default,,0,0,0,,Тек қазір, он жылдан астам уақыттан кейін тазарту алға жылжыды➡
Dialogue: 0,0:15:16.68,0:15:20.35,Default,,0,0,0,,Жақын арада ол жерге аяқ басатын сияқтымыз.
Dialogue: 0,0:15:20.35,0:15:22.68,Default,,0,0,0,,Бұл жеткілікті, Мег.
Dialogue: 0,0:15:22.68,0:15:25.55,Default,,0,0,0,,Міне, жұмысқа қайтатын уақыт келді деп ойлаймын.
Dialogue: 0,0:15:30.66,0:15:33.10,Default,,0,0,0,,Орлов менің туған жерім ме?
Dialogue: 0,0:15:33.10,0:15:37.17,Default,,0,0,0,,Мұны білгенде не істейсің?
Dialogue: 0,0:15:37.17,0:15:40.17,Default,,0,0,0,,Мен өзім туралы білгім келеді.
Dialogue: 0,0:15:47.68,0:15:49.68,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:15:49.68,0:15:52.68,Default,,0,0,0,,Мен сені Орловтағы апаттан құтқардым.
Dialogue: 0,0:15:52.68,0:15:55.72,Default,,0,0,0,,Сіз әлі жас кезіңізде.
Dialogue: 0,0:15:55.72,0:15:58.05,Default,,0,0,0,,((Режиссері: Сиқырлы апат болған жерде➡
Dialogue: 0,0:15:58.05,0:16:02.12,Default,,0,0,0,,Лорд Фауст құтқарған жалғыз адам.
Dialogue: 0,0:16:02.12,0:16:04.79,Default,,0,0,0,,Бұл сенсің, Мег))
Dialogue: 0,0:16:04.79,0:16:07.63,Default,,0,0,0,,Күтілгендей, солай болды.
Dialogue: 0,0:16:07.63,0:16:12.13,Default,,0,0,0,,Сіз Орловқа барасыз ба? иә.
Dialogue: 0,0:16:12.13,0:16:15.97,Default,,0,0,0,,Мег. Сіздің Лаписте досыңыз бар.
Dialogue: 0,0:16:15.97,0:16:20.14,Default,,0,0,0,,Сізді жақсы көретіндер де, сізді күтетіндер де бар.
Dialogue: 0,0:16:20.14,0:16:22.64,Default,,0,0,0,,Мен қайтып баратын үй осында.
Dialogue: 0,0:16:22.64,0:16:26.15,Default,,0,0,0,,Десе де, сіз туған жеріңізді қуалайсыз ба?
Dialogue: 0,0:16:26.15,0:16:28.15,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:28.15,0:16:32.99,Default,,0,0,0,,Бірақ менің туған жерім Лаписте.
Dialogue: 0,0:16:32.99,0:16:36.32,Default,,0,0,0,,Бұл әрқашан бұрынғыдай болды және солай болып қала береді.
Dialogue: 0,0:16:36.32,0:16:39.99,Default,,0,0,0,,Бірақ мен ештеңе білмей өмір сүргім келмейді.
Dialogue: 0,0:16:39.99,0:16:44.33,Default,,0,0,0,,Мен туған жерімді білгім келеді.
Dialogue: 0,0:16:44.33,0:16:49.34,Default,,0,0,0,,Ол жерде қандай адамдар болды, олармен кімдер тұрды, қандай жер болды?➡
Dialogue: 0,0:16:49.34,0:16:52.17,Default,,0,0,0,,Мен оны өз көзіммен көргім келеді.
Dialogue: 0,0:16:52.17,0:16:56.68,Default,,0,0,0,,Сізді ұстап тұру үшін өткеннің қажеті жоқ.
Dialogue: 0,0:16:56.68,0:16:59.18,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:16:59.18,0:17:01.65,Default,,0,0,0,,Бұл өткенмен шектелмейді.
Dialogue: 0,0:17:01.65,0:17:06.82,Default,,0,0,0,,Мен таңдаған болашақта жүру үшін осы керек.
Dialogue: 0,0:17:06.82,0:17:08.96,Default,,0,0,0,,Оның үстіне, ұстаз, түсінер едіңіз, солай емес пе?
Dialogue: 0,0:17:08.96,0:17:11.63,Default,,0,0,0,,Мұның мәні неде? Ха….
Dialogue: 0,0:17:11.63,0:17:13.96,Default,,0,0,0,,Мен сараңмын.
Dialogue: 0,0:17:13.96,0:17:15.96,Default,,0,0,0,,Иә? Сіз дүниеге келген өткеніңіз➡
Dialogue: 0,0:17:15.96,0:17:17.97,Default,,0,0,0,,Алда тұрған болашақ➡
Dialogue: 0,0:17:17.97,0:17:20.80,Default,,0,0,0,,Мен бәрі толығымен менікі болғанын қалаймын.
Dialogue: 0,0:17:20.80,0:17:23.14,Default,,0,0,0,,Білсең де, білмесең де, сақтасаң да, тастайсың да➡
Dialogue: 0,0:17:23.14,0:17:25.14,Default,,0,0,0,,Мен сені босатамын.
Dialogue: 0,0:17:25.14,0:17:28.98,Default,,0,0,0,,Мен нені қажет, нені қажетсіз деп шешемін.
Dialogue: 0,0:17:28.98,0:17:31.68,Default,,0,0,0,,Өйткені мен сараңмын!
Dialogue: 0,0:17:31.68,0:17:35.82,Default,,0,0,0,,Сұлу ұлдар, дүниедегі байлық, мәртебе, абырой➡
Dialogue: 0,0:17:35.82,0:17:38.32,Default,,0,0,0,,Тіпті өзімнің естеліктерім➡
Dialogue: 0,0:17:38.32,0:17:41.32,Default,,0,0,0,,Мен оны өзімдікі ретінде сақтағым келеді!
Dialogue: 0,0:17:41.32,0:17:45.16,Default,,0,0,0,,Хахахахахахахаха! иә?
Dialogue: 0,0:17:45.16,0:17:47.50,Default,,0,0,0,,Мәңгілік баласың➡
Dialogue: 0,0:17:47.50,0:17:50.67,Default,,0,0,0,,Сен ақымақ баласың. О? иә?
Dialogue: 0,0:17:50.67,0:17:53.33,Default,,0,0,0,,Кюу? Қалай?
Dialogue: 0,0:17:53.33,0:17:57.67,Default,,0,0,0,,Сіздің тағдырыңыз өзгереді.
Dialogue: 0,0:17:57.67,0:18:00.11,Default,,0,0,0,,Мег. Ах...
Dialogue: 0,0:18:00.11,0:18:04.11,Default,,0,0,0,,Өткенді қабылдауға дайынсыз ба?
Dialogue: 0,0:18:04.11,0:18:06.11,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:18:06.11,0:18:08.78,Default,,0,0,0,,Содан кейін барыңыз. Ах...
Dialogue: 0,0:18:08.78,0:18:12.62,Default,,0,0,0,,Барып, туған жеріңді көр.
Dialogue: 0,0:18:12.62,0:18:16.29,Default,,0,0,0,,Сіз әлі білмейтін дүние. Мастер...
Dialogue: 0,0:18:16.29,0:18:18.79,Default,,0,0,0,,Бірақ ұмытпаңыз.
Dialogue: 0,0:18:18.79,0:18:23.46,Default,,0,0,0,,Туған жерің бөлек болса да, Лапис – туған жерің➡
Dialogue: 0,0:18:23.46,0:18:27.17,Default,,0,0,0,,Сіздің үйіңіз осында.
Dialogue: 0,0:18:27.17,0:18:29.80,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:18:29.80,0:18:32.47,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:18:32.47,0:18:35.98,Default,,0,0,0,,Бұл мен қайтуым керек жер.
Dialogue: 0,0:18:39.01,0:18:43.48,Default,,0,0,0,,< Туған жерімді аралауды осылай шештім.
Dialogue: 0,0:18:43.48,0:18:46.99,Default,,0,0,0,,Бұл сапар менің тағдырымды қалай өзгертеді?➡
Dialogue: 0,0:18:46.99,0:18:50.83,Default,,0,0,0,,Мен әлі білмеймін. Бірақ бұл сапардан тыс➡
Dialogue: 0,0:18:50.83,0:18:54.50,Default,,0,0,0,,Іздегеніме жауап күтіп тұр.
Dialogue: 0,0:18:54.50,0:18:57.50,Default,,0,0,0,,Дәл қазір менде солай болды＞
Dialogue: 0,0:19:01.44,0:19:05.11,Default,,0,0,0,,үшін мені шығарып салуға келді.
Dialogue: 0,0:19:05.11,0:19:08.44,Default,,0,0,0,,Мен сені сағындым, Мег. Рахмет сізге.
Dialogue: 0,0:19:08.44,0:19:10.61,Default,,0,0,0,,Мен де біраз уақыт Fine-ді көре алмаймын➡
Dialogue: 0,0:19:10.61,0:19:13.61,Default,,0,0,0,,Мен сені уайымдағаным үшін мені көруге келгеніңе қуаныштымын.
Dialogue: 0,0:19:13.61,0:19:17.12,Default,,0,0,0,,Мег…. Білемін, сен жылайсың.
Dialogue: 0,0:19:17.12,0:19:21.62,Default,,0,0,0,,Өйткені, бұл үміттің символы, қаланың пұтына айналған және бүкіл адамзаттың таңданатын нысаны➡
Dialogue: 0,0:19:21.62,0:19:24.29,Default,,0,0,0,,Менің ең жақын досым, мен жоғалғалы жатырмын.
Dialogue: 0,0:19:24.29,0:19:27.96,Default,,0,0,0,,Жалғыздықтан өлме. Мен жалғыздықты азайттым.
Dialogue: 0,0:19:27.96,0:19:31.47,Default,,0,0,0,,Хехе... Жарайды, қайтып келемін.
Dialogue: 0,0:19:31.47,0:19:35.30,Default,,0,0,0,,Мен сендерге көптеген қызықты естелік әңгімелер айтып беремін.
Dialogue: 0,0:19:35.30,0:19:37.81,Default,,0,0,0,,Иә, мен оны асыға күтемін.
Dialogue: 0,0:19:37.81,0:19:40.31,Default,,0,0,0,,Мег-чан, сен дүниені көп аралайсың, солай ма?
Dialogue: 0,0:19:40.31,0:19:42.31,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:19:42.31,0:19:46.48,Default,,0,0,0,,《Мен Орловқа барғым келетіні туралы Сиқырлар қауымдастығына жүгіндім➡
Dialogue: 0,0:19:46.48,0:19:49.32,Default,,0,0,0,,Таңқаларлық жауап қайтарылды.
Dialogue: 0,0:19:49.32,0:19:53.99,Default,,0,0,0,,Дүние жүзіндегі сиқырлы апаттар. Зардап шеккен елдерге қолдау көрсету және тергеу➡
Dialogue: 0,0:19:53.99,0:19:58.33,Default,,0,0,0,,Содан кейін бұл жер аударылған Орлов елінен ресми тергеу сұрауы болды.
Dialogue: 0,0:19:58.33,0:20:03.00,Default,,0,0,0,,Мен Мастер Фаусттан бұл Сиқырлы қауымдастықтың өтініші екенін естідім.
Dialogue: 0,0:20:03.00,0:20:06.33,Default,,0,0,0,,Жеті данышпан Джек маған оны ұсынды.
Dialogue: 0,0:20:06.33,0:20:10.34,Default,,0,0,0,,Сондықтан мен сиқырлы сусындарды біраз уақытқа дейін жеткізе алмаймын.
Dialogue: 0,0:20:10.34,0:20:13.34,Default,,0,0,0,,Уақытша болса да, өзімді жалғыз сезінемін.
Dialogue: 0,0:20:13.34,0:20:17.34,Default,,0,0,0,,Мег-чанның арқасында мен шие гүлдерін көрдім.
Dialogue: 0,0:20:17.34,0:20:22.35,Default,,0,0,0,,Әй, шие гүлдері... Ах! Лапис Серена ше?
Dialogue: 0,0:20:22.35,0:20:26.69,Default,,0,0,0,,Мег-чанның арқасында мен Аннаға нағыз шие гүлдерін көрсете алдым.
Dialogue: 0,0:20:26.69,0:20:30.02,Default,,0,0,0,,Иә. Мег-чан қазірдің өзінде тамаша сиқыршы.
Dialogue: 0,0:20:30.02,0:20:34.36,Default,,0,0,0,,Мен әлі де керемет боламын.
Dialogue: 0,0:20:34.36,0:20:38.37,Default,,0,0,0,,Ол әрі қарай өседі, сондықтан оны асыға күтіңіз.
Dialogue: 0,0:20:38.37,0:20:42.17,Default,,0,0,0,,Мен сіздің қайтып келуіңізді күтемін.
Dialogue: 0,0:20:44.21,0:20:48.88,Default,,0,0,0,,Мег. Кету уақыты келді. Иә, шебер.
Dialogue: 0,0:20:48.88,0:20:51.21,Default,,0,0,0,,Егер бәрі қауіпсіз аяқталса➡
Dialogue: 0,0:20:51.21,0:20:53.88,Default,,0,0,0,,Олай болса, маған әртүрлі нәрселерді айтып беріңізші.
Dialogue: 0,0:20:53.88,0:20:57.05,Default,,0,0,0,,Мастер және Эльдора-ни-сан туралы.
Dialogue: 0,0:20:57.05,0:20:59.39,Default,,0,0,0,,А, мен уәде беремін.
Dialogue: 0,0:20:59.39,0:21:02.19,Default,,0,0,0,,Ihi…. Ха….
Dialogue: 0,0:21:11.17,0:21:14.34,Default,,0,0,0,,((Келіңіз. А?
Dialogue: 0,0:21:14.34,0:21:16.70,Default,,0,0,0,,Бүгіннен бастап сіз отбасысыз.
Dialogue: 0,0:21:16.70,0:21:20.37,Default,,0,0,0,,Meg Raspberry сияқты))
Dialogue: 0,0:21:20.37,0:21:22.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:22.88,0:21:26.85,Default,,0,0,0,,Жүрегіңде әрқашан үміт болсын, Мег Таңқурай.
Dialogue: 0,0:21:29.85,0:21:31.85,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:31.85,0:21:46.90,Default,,0,0,0,,♬～
Dialogue: 0,0:21:46.90,0:21:50.74,Default,,0,0,0,,Онда кездескенше, кеттік!
Dialogue: 0,0:21:50.74,0:22:00.82,Default,,0,0,0,,♬～
Dialogue: 0,0:22:00.82,0:22:03.12,Default,,0,0,0,,Кю Кю… Кю. Хоу... хоухоу.
Dialogue: 0,0:22:06.65,0:22:10.16,Default,,0,0,0,,《Менің саяхатым осы жерден басталады.
Dialogue: 0,0:22:10.16,0:22:12.33,Default,,0,0,0,,Тамырыңызды іздеу➡
Dialogue: 0,0:22:12.33,0:22:15.66,Default,,0,0,0,,Ал бөтен елде, Қуаныштың көз жасын жинаймын➡
Dialogue: 0,0:22:15.66,0:22:18.57,Default,,0,0,0,,Ұзақ, ұзақ сапар...》
Dialogue: 0,0:22:20.07,0:22:26.07,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
