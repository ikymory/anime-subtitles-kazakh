Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.78,0:00:15.07,Default,,0,0,0,,Қамалға оралу
Dialogue: 0,0:00:15.91,0:00:16.74,Default,,0,0,0,,Иә
Dialogue: 0,0:00:28.88,0:00:29.75,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:00:30.63,0:00:32.59,Default,,0,0,0,,Жаңғақ тастан жасалған
Dialogue: 0,0:00:32.84,0:00:37.14,Default,,0,0,0,,Бұл Дзен Шираюкиге хатпен бірге бермек болған пакеттің мазмұны.
Dialogue: 0,0:00:37.89,0:00:39.05,Default,,0,0,0,,Сол кезде
Dialogue: 0,0:00:39.22,0:00:41.85,Default,,0,0,0,,Оны Оби алып жүрген сияқты.
Dialogue: 0,0:00:42.14,0:00:45.77,Default,,0,0,0,,Егер Шираюки кемеде болса, ол сигнал ретінде шығуы керек.
Dialogue: 0,0:00:46.69,0:00:49.77,Default,,0,0,0,,Кихару бастапқыда Шираюки үшін жасаған сияқты.
Dialogue: 0,0:00:50.90,0:00:51.86,Default,,0,0,0,,Маған
Dialogue: 0,0:00:52.86,0:00:55.20,Default,,0,0,0,,Эй, сен мені осында әкелдің...
Dialogue: 0,0:00:55.32,0:00:57.36,Default,,0,0,0,,Сіз бұл ұят дедіңіз...
Dialogue: 0,0:00:57.74,0:00:59.70,Default,,0,0,0,,Теңізде осылай не істеуіміз керек?
Dialogue: 0,0:01:00.62,0:01:05.62,Default,,0,0,0,,Алдымен мына кемедегі адамдар сені одақтастарыңа апарсын.
Dialogue: 0,0:01:14.55,0:01:15.72,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:01:20.80,0:01:21.47,Default,,0,0,0,,Зен
Dialogue: 0,0:01:24.06,0:01:25.23,Default,,0,0,0,,Шираюки
Dialogue: 0,0:01:26.52,0:01:31.52,Default,,0,0,0,,♪～
Dialogue: 0,0:02:50.77,0:02:55.77,Default,,0,0,0,,～♪
Dialogue: 0,0:02:58.82,0:03:02.07,Default,,0,0,0,,Иә? Ханзада Радж келе ме? енді?
Dialogue: 0,0:03:02.20,0:03:05.58,Default,,0,0,0,,Ақымақ ханзаданың мұндай порттық қалада не керегі бар?
Dialogue: 0,0:03:05.78,0:03:08.20,Default,,0,0,0,,Мен оның не екенін білмеймін, бірақ мені тыңдаңыз.
Dialogue: 0,0:03:08.33,0:03:09.62,Default,,0,0,0,,Бұл азап.
Dialogue: 0,0:03:10.12,0:03:13.08,Default,,0,0,0,,Менің ойымша, олар спирттік ішімдіктерді беріп, әйелдерге алым-салық беруі керек.
Dialogue: 0,0:03:13.21,0:03:14.88,Default,,0,0,0,,Хаха, бұл дұрыс.
Dialogue: 0,0:03:15.00,0:03:15.88,Default,,0,0,0,,(Лауазымды тұлғалардың шағымдары)
Dialogue: 0,0:03:17.21,0:03:20.22,Default,,0,0,0,,Бұдан былай теңіздің тырнағын қуамыз
Dialogue: 0,0:03:20.63,0:03:22.43,Default,,0,0,0,,Ух... теңіз тырнағы
Dialogue: 0,0:03:22.59,0:03:26.26,Default,,0,0,0,,Мына қарақшылар мына теңізде қалағанын істеп жүр ме?
Dialogue: 0,0:03:26.43,0:03:27.89,Default,,0,0,0,,Сауда теңізшілері...
Dialogue: 0,0:03:28.02,0:03:31.60,Default,,0,0,0,,Ол теңіз ақысын төлеуге мәжбүр болғанына шағымданды.
Dialogue: 0,0:03:32.10,0:03:33.77,Default,,0,0,0,,Хидикоға олай істеме.
Dialogue: 0,0:03:33.90,0:03:35.11,Default,,0,0,0,,Бұл тек ақшаға қатысты емес
Dialogue: 0,0:03:35.31,0:03:37.94,Default,,0,0,0,,Олар сатуға болатын адамдарды ұрлайды.
Dialogue: 0,0:03:38.19,0:03:39.40,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:03:40.15,0:03:42.86,Default,,0,0,0,,Егер бізге көмектескіңіз келсе, осы жерді басыңыз
Dialogue: 0,0:03:42.99,0:03:44.66,Default,,0,0,0,,Айтсаңыз да...
Dialogue: 0,0:03:45.41,0:03:47.66,Default,,0,0,0,,Біз де жүкті көтерудің қажеті жоқ.
Dialogue: 0,0:03:47.83,0:03:49.75,Default,,0,0,0,,Жұмыс бар. Жұмыс бар.
Dialogue: 0,0:03:49.91,0:03:52.37,Default,,0,0,0,,Ханзада Раджи қайда?
Dialogue: 0,0:03:52.50,0:03:54.33,Default,,0,0,0,,Ол ханзаданың қарақшылармен бәсекелесуі мүмкін емес еді.
Dialogue: 0,0:03:54.46,0:03:55.75,Default,,0,0,0,,Хаха...
Dialogue: 0,0:03:56.96,0:04:01.72,Default,,0,0,0,,Уақыт жоқ кезде не күтіп тұрсыз?
Dialogue: 0,0:04:12.81,0:04:14.35,Default,,0,0,0,,Мен алға шыға аламын ба?
Dialogue: 0,0:04:15.06,0:04:17.15,Default,,0,0,0,,Халықтың бұйрығы орындалмайды.
Dialogue: 0,0:04:19.44,0:04:20.28,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:04:20.82,0:04:21.94,Default,,0,0,0,,Мені төмендетпе
Dialogue: 0,0:04:26.53,0:04:28.37,Default,,0,0,0,,А... міне, солай.
Dialogue: 0,0:04:28.70,0:04:29.58,Default,,0,0,0,,Бұл ханзада.
Dialogue: 0,0:04:29.70,0:04:30.37,Default,,0,0,0,,Ханзада Раджи
Dialogue: 0,0:04:37.71,0:04:40.75,Default,,0,0,0,,Ми... адамдардың көзі ауырады.
Dialogue: 0,0:04:48.68,0:04:49.68,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:04:50.51,0:04:52.72,Default,,0,0,0,,Күтілгендей, әрбір қозғалыс.
Dialogue: 0,0:04:53.68,0:04:56.27,Default,,0,0,0,,Итоя, шашырап кеткен барлық адамдарды жина.
Dialogue: 0,0:04:56.48,0:04:57.15,Default,,0,0,0,,Иә
Dialogue: 0,0:04:58.06,0:04:58.90,Default,,0,0,0,,Раджи-доно
Dialogue: 0,0:04:59.15,0:04:59.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:01.23,0:05:02.73,Default,,0,0,0,,Мен мұны сұрадым.
Dialogue: 0,0:05:13.83,0:05:15.58,Default,,0,0,0,,Барлығыңыз өтінемін
Dialogue: 0,0:05:16.37,0:05:20.17,Default,,0,0,0,,Қандай жағдай болмасын, теңіздің тырнағын қашып құтыла алмаймыз.
Dialogue: 0,0:05:21.38,0:05:22.30,Default,,0,0,0,,Қуат...
Dialogue: 0,0:05:23.34,0:05:25.13,Default,,0,0,0,,Маған күш беруіңді қалаймын.
Dialogue: 0,0:05:29.22,0:05:31.60,Default,,0,0,0,,Ханзада Раджи жақсы жұмыс істей ме?
Dialogue: 0,0:05:32.14,0:05:34.43,Default,,0,0,0,,Танбарун — Раджи-доно жері.
Dialogue: 0,0:05:34.68,0:05:35.85,Default,,0,0,0,,Біз біздің-
Dialogue: 0,0:05:35.98,0:05:37.89,Default,,0,0,0,,Тек қолыңнан келгенін істе (ат кине)
Dialogue: 0,0:05:41.52,0:05:42.44,Default,,0,0,0,,Желдей жылдам шабуыл!
Dialogue: 0,0:05:43.98,0:05:45.69,Default,,0,0,0,,Жоғары мәртебелі Дзен, бұл сізсіз.
Dialogue: 0,0:05:58.62,0:06:01.54,Default,,0,0,0,,Бас! Алда үш кеме бар.
Dialogue: 0,0:06:01.88,0:06:02.54,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:03.25,0:06:04.50,Default,,0,0,0,,Тау арыстаны?
Dialogue: 0,0:06:04.67,0:06:06.09,Default,,0,0,0,,Мен әлі түсінбеймін.
Dialogue: 0,0:06:06.42,0:06:07.59,Default,,0,0,0,,Егер сен арыстан болсаң...
Dialogue: 0,0:06:07.72,0:06:10.72,Default,,0,0,0,,Бұл жас ханымды қолдануға болады дегенді білдіре ме?
Dialogue: 0,0:06:11.72,0:06:14.35,Default,,0,0,0,,Мен реакцияға қарап тікелей зерттеймін бе?
Dialogue: 0,0:06:15.14,0:06:16.60,Default,,0,0,0,,Мені палубаға апарыңыз.
Dialogue: 0,0:06:16.73,0:06:17.48,Default,,0,0,0,,Уссу
Dialogue: 0,0:06:18.52,0:06:22.40,Default,,0,0,0,,Арыстан үндемесе, ақша табу оңай болады.
Dialogue: 0,0:06:22.65,0:06:25.48,Default,,0,0,0,,Міне, Казуки де осында.
Dialogue: 0,0:06:26.23,0:06:28.82,Default,,0,0,0,,Алма басты қыздың құны болмаса да...
Dialogue: 0,0:06:29.07,0:06:32.24,Default,,0,0,0,,Айқайласа, аздап көмектесетін шығар.
Dialogue: 0,0:06:32.37,0:06:33.62,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:06:34.79,0:06:36.75,Default,,0,0,0,,Ей, алма басы, шықшы.
Dialogue: 0,0:06:37.20,0:06:38.00,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:06:38.12,0:06:40.42,Default,,0,0,0,,Бірдеңе қауіпті болып көрінсе, айқайлаңыз.
Dialogue: 0,0:06:46.92,0:06:47.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:48.38,0:06:49.47,Default,,0,0,0,,Бас!
Dialogue: 0,0:06:50.01,0:06:51.84,Default,,0,0,0,,Не шулы?
Dialogue: 0,0:06:52.59,0:06:53.43,Default,,0,0,0,,Бұл
Dialogue: 0,0:06:53.76,0:06:54.47,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:01.02,0:07:02.81,Default,,0,0,0,,Бұл әзіл емес.
Dialogue: 0,0:07:03.27,0:07:04.90,Default,,0,0,0,,Бұл арыстан емес.
Dialogue: 0,0:07:05.86,0:07:06.98,Default,,0,0,0,,Сауда кемесі
Dialogue: 0,0:07:07.90,0:07:13.03,Default,,0,0,0,,Ал барлық кемелер теңіз жалауларын көтеріп, жолымызды жауып тұр.
Dialogue: 0,0:07:14.24,0:07:16.08,Default,,0,0,0,,Мен басын әкелдім.
Dialogue: 0,0:07:16.20,0:07:17.79,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:07:26.09,0:07:27.42,Default,,0,0,0,,Міне, Сакаки.
Dialogue: 0,0:07:28.09,0:07:28.76,Default,,0,0,0,,Иә
Dialogue: 0,0:07:32.22,0:07:35.14,Default,,0,0,0,,Бірақ ханзада Радж қауесеттерден өзгеше.
Dialogue: 0,0:07:35.72,0:07:39.93,Default,,0,0,0,,Біз сияқты саудагерлерден бізге кеме жіберуді сұраңыз.
Dialogue: 0,0:07:40.27,0:07:44.90,Default,,0,0,0,,Жоқ, мен оны соңғы рет көргенімде, ол бастық ханзада болды.
Dialogue: 0,0:07:45.11,0:07:46.23,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:07:46.36,0:07:49.03,Default,,0,0,0,,Егер біреу сізден мұны тез арада орындауды сұраса, оны елемеуге болмайды.
Dialogue: 0,0:07:50.28,0:07:50.94,Default,,0,0,0,,Жақсы
Dialogue: 0,0:07:52.36,0:07:53.82,Default,,0,0,0,,Бұл қандай сан?
Dialogue: 0,0:07:54.11,0:07:57.91,Default,,0,0,0,,Әй, сен майданда жетектеп келе жатқан кемең ұлттық кеме ғой, солай емес пе?
Dialogue: 0,0:07:58.70,0:08:00.83,Default,,0,0,0,,Ұлттық кеме... (Қарақшы 1) Не істейсің?
Dialogue: 0,0:08:01.00,0:08:02.83,Default,,0,0,0,,Менің артымнан ерме.
Dialogue: 0,0:08:03.67,0:08:08.46,Default,,0,0,0,,Князь Раджи Шираюки-дононың пайда болуы тырнақ палубасында расталды.
Dialogue: 0,0:08:09.09,0:08:09.92,Default,,0,0,0,,Сіз қауіпсізсіз бе?
Dialogue: 0,0:08:10.05,0:08:10.71,Default,,0,0,0,,Га
Dialogue: 0,0:08:11.21,0:08:14.59,Default,,0,0,0,,Шираюки-доно, Кизуки-доно және Казуки есімді бала...
Dialogue: 0,0:08:14.72,0:08:17.39,Default,,0,0,0,,Демек, сізді сол кеме басып алды.
Dialogue: 0,0:08:18.72,0:08:19.64,Default,,0,0,0,,Сакаки
Dialogue: 0,0:08:20.06,0:08:20.72,Default,,0,0,0,,Иә
Dialogue: 0,0:08:21.60,0:08:23.10,Default,,0,0,0,,Осы уақытқа дейін адалдық -
Dialogue: 0,0:08:23.52,0:08:26.48,Default,,0,0,0,,Мен тек аяныштымын деп ойладым.
Dialogue: 0,0:08:27.44,0:08:31.61,Default,,0,0,0,,Мен оларға қатты ашуланамын.
Dialogue: 0,0:08:32.86,0:08:33.65,Default,,0,0,0,,Хо
Dialogue: 0,0:08:36.99,0:08:39.20,Default,,0,0,0,,Қарақшылар, мені естисіз бе!
Dialogue: 0,0:08:40.83,0:08:46.17,Default,,0,0,0,,Мен Радж Шехназад, Танбарун патшалығының бірінші ханзадасымын.
Dialogue: 0,0:08:46.54,0:08:49.09,Default,,0,0,0,,Бəріңіз қол тигізген қызыл шашты қыз...
Dialogue: 0,0:08:50.05,0:08:52.42,Default,,0,0,0,,Бұл танбарунда бір ғана адам бар.
Dialogue: 0,0:08:52.55,0:08:55.51,Default,,0,0,0,,Оған патша отбасының досы атағы берілді.
Dialogue: 0,0:08:56.30,0:08:59.14,Default,,0,0,0,,Бұлай қашып құтыла алмайсың деп ойлаймын!
Dialogue: 0,0:08:59.55,0:09:03.35,Default,,0,0,0,,Иә? тақырып? Корольдік отбасының досы ма?
Dialogue: 0,0:09:04.27,0:09:05.89,Default,,0,0,0,,Мына кішкентай қыз?
Dialogue: 0,0:09:08.15,0:09:09.40,Default,,0,0,0,,Олар сол таңертең ғана қабырғалардың ар жағына барлау миссиясына аттанған еді.
Dialogue: 0,0:09:10.32,0:09:13.78,Default,,0,0,0,,Бұл жігітті қалаған тау арыстаны емес пе еді?
Dialogue: 0,0:09:15.20,0:09:18.45,Default,,0,0,0,,Ей, мұнша адаммен қалай күресуге болады?
Dialogue: 0,0:09:19.45,0:09:22.45,Default,,0,0,0,,Мен артқа тартайын, балалар, батысқа өтіп кетіңдер.
Dialogue: 0,0:09:22.58,0:09:23.66,Default,,0,0,0,,О
Dialogue: 0,0:09:26.46,0:09:28.08,Default,,0,0,0,,Корольдік дос
Dialogue: 0,0:09:28.50,0:09:32.46,Default,,0,0,0,,Мұндай атауды бірінші рет естіп тұрмын.
Dialogue: 0,0:09:32.67,0:09:35.67,Default,,0,0,0,,Мен жай ғана сізді тұрақсыздандыру стратегиясын жасадым.
Dialogue: 0,0:09:39.55,0:09:41.56,Default,,0,0,0,,Бірақ бұл өтірік емес
Dialogue: 0,0:09:43.56,0:09:45.56,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:09:50.65,0:09:53.32,Default,,0,0,0,,Ей, бетіңді көрсетпе, эй.
Dialogue: 0,0:09:53.78,0:09:54.99,Default,,0,0,0,,Ханзада Раджи
Dialogue: 0,0:10:00.87,0:10:03.58,Default,,0,0,0,,Тез қайтпа, жас ханым.
Dialogue: 0,0:10:06.96,0:10:10.29,Default,,0,0,0,,Бұл бетке не болды? Оған теңіз жыланы шабуыл жасады ма?
Dialogue: 0,0:10:10.75,0:10:12.50,Default,,0,0,0,,Мм... Иә, аздап.
Dialogue: 0,0:10:12.79,0:10:14.09,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:10:14.25,0:10:16.09,Default,,0,0,0,,Қарғыс атсын.
Dialogue: 0,0:10:17.42,0:10:19.76,Default,,0,0,0,,Не болғаны маңызды емес.
Dialogue: 0,0:10:20.14,0:10:21.60,Default,,0,0,0,,Босаңсаңыз жақсы емес
Dialogue: 0,0:10:22.80,0:10:25.31,Default,,0,0,0,,Мен батысқа барыңдар деген бұйрықты естідім...
Dialogue: 0,0:10:25.43,0:10:26.98,Default,,0,0,0,,Майданнан кеме келді ме?
Dialogue: 0,0:10:27.52,0:10:28.31,Default,,0,0,0,,Иә
Dialogue: 0,0:10:33.94,0:10:36.32,Default,,0,0,0,,Артымыздан ұлттық кемелер келе жатыр.
Dialogue: 0,0:10:36.48,0:10:38.32,Default,,0,0,0,,Шу шығармаңыз
Dialogue: 0,0:10:39.20,0:10:41.16,Default,,0,0,0,,Көгілдір құйын жақындап қалды.
Dialogue: 0,0:10:41.28,0:10:44.24,Default,,0,0,0,,Қанша тырыссам да жете алмаймын.
Dialogue: 0,0:10:45.16,0:10:47.12,Default,,0,0,0,,Бұлай бөлінбе.
Dialogue: 0,0:10:48.62,0:10:49.83,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:10:50.04,0:10:50.87,Default,,0,0,0,,Сәлем
Dialogue: 0,0:10:54.54,0:10:55.75,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:56.34,0:10:58.01,Default,,0,0,0,,А... міне, солай.
Dialogue: 0,0:11:08.60,0:11:11.48,Default,,0,0,0,,Уайымдамаңыз, сіз құйынға тым жақынсыз.
Dialogue: 0,0:11:11.60,0:11:16.32,Default,,0,0,0,,Сіз нені ұстап тұрсыз? Тұтқаны тез кесіңіз, сонда сіз жұтып кетесіз
Dialogue: 0,0:11:24.12,0:11:26.62,Default,,0,0,0,,Бұл мүмкін емес, ханзада, мен сізге бұдан әрі қарай жүре алмаймын.
Dialogue: 0,0:11:26.95,0:11:28.75,Default,,0,0,0,,Не... неге?
Dialogue: 0,0:11:29.04,0:11:30.33,Default,,0,0,0,,Көк құйын
Dialogue: 0,0:11:30.62,0:11:31.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:31.79,0:11:35.79,Default,,0,0,0,,Танбарун аумақтық суларында тұрақты емес болатын құйындылар жиынтығы.
Dialogue: 0,0:11:36.34,0:11:38.42,Default,,0,0,0,,Егер сіз мұхит ағындары туралы бәрін білетін адам болмасаңыз...
Dialogue: 0,0:11:38.55,0:11:40.17,Default,,0,0,0,,өту мүмкін емес
Dialogue: 0,0:11:40.88,0:11:44.18,Default,,0,0,0,,Егер сіз оны қатты соқсаңыз, кеме бөліктерге бөлінеді.
Dialogue: 0,0:11:50.18,0:11:52.64,Default,,0,0,0,,Кя! (Казуки) Уау!
Dialogue: 0,0:11:54.35,0:11:57.40,Default,,0,0,0,,Төбедегі адам нашар жүзеді.
Dialogue: 0,0:12:01.19,0:12:02.70,Default,,0,0,0,,Керемет шайқау
Dialogue: 0,0:12:16.96,0:12:18.83,Default,,0,0,0,,Осы уақытқа дейін жетсек жақсы болады.
Dialogue: 0,0:12:19.25,0:12:23.46,Default,,0,0,0,,Менің мұндай жоспарым жоқ еді, бірақ мен оны біраз уақытқа жасырамын.
Dialogue: 0,0:12:36.60,0:12:40.65,Default,,0,0,0,,Әй, қатты дірілдеп тұр. Бұл кеме жақсы ма?
Dialogue: 0,0:12:41.15,0:12:42.77,Default,,0,0,0,,Сондықтан, жаман асықпаңыз.
Dialogue: 0,0:12:42.94,0:12:45.61,Default,,0,0,0,,Ух... бұл тым қатты. Сіз де көрген боларсыз.
Dialogue: 0,0:12:45.73,0:12:48.24,Default,,0,0,0,,Әлгі қарақшы әйелдің мазақ еткен күлкісі
Dialogue: 0,0:12:48.65,0:12:51.45,Default,,0,0,0,,Мұндай бетті көргенде, шегінуге бола ма?
Dialogue: 0,0:12:52.12,0:12:53.45,Default,,0,0,0,,Тыңдап тұрсың ба, Сакаки?
Dialogue: 0,0:12:54.49,0:12:55.74,Default,,0,0,0,,есіме түсті
Dialogue: 0,0:12:56.16,0:12:59.58,Default,,0,0,0,,Көк құйын әр 10 секунд сайын ағынын өзгертуі керек екеніне сенімдімін.
Dialogue: 0,0:13:00.21,0:13:03.79,Default,,0,0,0,,Ағысқа қарсы шықпай алға ұмтылсақ, мүмкін
Dialogue: 0,0:13:04.80,0:13:05.96,Default,,0,0,0,,10 секунд сайын?
Dialogue: 0,0:13:13.55,0:13:16.22,Default,,0,0,0,,Санауды қашан бастау керек?
Dialogue: 0,0:13:17.35,0:13:18.02,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:13:24.11,0:13:24.86,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:13:25.94,0:13:30.20,Default,,0,0,0,,Рульді солға және оңға бұрыңыз, сонда сіз көк құйыннан өтесіз.
Dialogue: 0,0:13:30.65,0:13:31.36,Default,,0,0,0,,Га
Dialogue: 0,0:13:32.78,0:13:33.95,Default,,0,0,0,,Сол жақта
Dialogue: 0,0:13:34.16,0:13:34.99,Default,,0,0,0,,О
Dialogue: 0,0:13:35.87,0:13:37.12,Default,,0,0,0,,және Спидвагон қорының тергеуінен қашып, жасырынды.
Dialogue: 0,0:13:37.62,0:13:38.91,Default,,0,0,0,,О
Dialogue: 0,0:13:40.46,0:13:41.46,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:42.29,0:13:44.54,Default,,0,0,0,,Сіз дұрыс айттыңыз, ханзада Раджи.
Dialogue: 0,0:13:44.71,0:13:46.67,Default,,0,0,0,,Егер бұл орын алса, бәрі немесе ештеңе емес.
Dialogue: 0,0:13:48.21,0:13:49.13,Default,,0,0,0,,О...
Dialogue: 0,0:13:54.05,0:13:57.06,Default,,0,0,0,,Таңбарунды жалама
Dialogue: 0,0:14:05.15,0:14:06.15,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:14:06.57,0:14:08.40,Default,,0,0,0,,Бұл теңіз тырнақтарының қорғаны.
Dialogue: 0,0:14:08.86,0:14:13.86,Default,,0,0,0,,Мен нақты орналасқан жерді білмеймін, өйткені мен оған жету үшін үнемі мұхиттан өтемін.
Dialogue: 0,0:14:14.70,0:14:18.04,Default,,0,0,0,,Әй, не деген ұят, кішкентай қыз.
Dialogue: 0,0:14:18.29,0:14:20.87,Default,,0,0,0,,Осы уақытқа дейін ешкім келе алмайды.
Dialogue: 0,0:14:21.33,0:14:24.12,Default,,0,0,0,,(Қарақшылардың күлкісі)
Dialogue: 0,0:14:24.67,0:14:27.71,Default,,0,0,0,,Енді қайда сататындарыңызды баяу анықтайық...
Dialogue: 0,0:14:27.84,0:14:29.71,Default,,0,0,0,,Бұл туралы ойланайық па?
Dialogue: 0,0:14:30.09,0:14:31.47,Default,,0,0,0,,Бас! а?
Dialogue: 0,0:14:31.97,0:14:34.43,Default,,0,0,0,,Олар мені қуып келе жатты.
Dialogue: 0,0:14:35.59,0:14:36.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:42.35,0:14:45.60,Default,,0,0,0,,Ей, сен қалжыңдамайсың.
Dialogue: 0,0:14:57.07,0:14:59.70,Default,,0,0,0,,Әйтеуір аман-есен жетіп алдың.
Dialogue: 0,0:15:00.58,0:15:01.37,Default,,0,0,0,,О
Dialogue: 0,0:15:02.54,0:15:06.04,Default,,0,0,0,,Мені бақылағандары үшін барлығына рахмет.
Dialogue: 0,0:15:06.63,0:15:09.00,Default,,0,0,0,,Оған іліккен дұрысырақ болар еді.
Dialogue: 0,0:15:10.38,0:15:13.51,Default,,0,0,0,,Кешіріңіз, маған тағы бір рет күш беріңізші.
Dialogue: 0,0:15:15.76,0:15:17.39,Default,,0,0,0,,Жалғастыру
Dialogue: 0,0:15:17.89,0:15:20.85,Default,,0,0,0,,Кемені жойып, олардың қашу жолын кесіңіз
Dialogue: 0,0:15:21.31,0:15:22.68,Default,,0,0,0,,О
Dialogue: 0,0:15:25.06,0:15:26.56,Default,,0,0,0,,Еш қағыспа
Dialogue: 0,0:15:40.45,0:15:41.12,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:15:42.20,0:15:44.25,Default,,0,0,0,,Әрине, бірақ...
Dialogue: 0,0:15:44.79,0:15:46.16,Default,,0,0,0,,Мен белімнен айырылдым
Dialogue: 0,0:15:53.80,0:15:55.67,Default,,0,0,0,,Екеуміз де артқа қарай жүгірдік.
Dialogue: 0,0:15:57.18,0:15:58.30,Default,,0,0,0,,Ал егер сенің станың кішірейгендіктен күшін жоғалтса…
Dialogue: 0,0:16:00.47,0:16:01.31,Default,,0,0,0,,Шираюки
Dialogue: 0,0:16:01.56,0:16:02.64,Default,,0,0,0,,О!
Dialogue: 0,0:16:02.93,0:16:03.60,Default,,0,0,0,,Ағаштар
Dialogue: 0,0:16:07.35,0:16:08.56,Default,,0,0,0,,Әйел!
Dialogue: 0,0:16:12.23,0:16:14.61,Default,,0,0,0,,Менің серіктесімді түртіңіз.
Dialogue: 0,0:16:20.45,0:16:21.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:26.04,0:16:27.83,Default,,0,0,0,,Бұл жігіт қайда?
Dialogue: 0,0:16:28.21,0:16:29.08,Default,,0,0,0,,Қозғалмаңыз!
Dialogue: 0,0:16:29.58,0:16:31.17,Default,,0,0,0,,Шираюкиді жіберіңіз
Dialogue: 0,0:16:32.13,0:16:34.50,Default,,0,0,0,,Ол сен ұстайтын қыз емес.
Dialogue: 0,0:16:39.76,0:16:41.97,Default,,0,0,0,,Бұл не, балалар?
Dialogue: 0,0:16:42.35,0:16:45.43,Default,,0,0,0,,Мына алма бас қызға көмектесуге келдің бе?
Dialogue: 0,0:16:45.56,0:16:47.81,Default,,0,0,0,,Сол үшін сіз кемені апатқа ұшыратасыз ба?
Dialogue: 0,0:16:48.10,0:16:49.31,Default,,0,0,0,,Барлық жерде міндетті түрде өмір сүруге құқығы жоқ адамдар бар,
Dialogue: 0,0:16:53.19,0:16:54.07,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:16:56.19,0:16:56.94,Default,,0,0,0,,Оби!
Dialogue: 0,0:16:58.53,0:17:00.95,Default,,0,0,0,,Ұстаз, іште жас келіншек
Dialogue: 0,0:17:02.03,0:17:03.24,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:17:04.62,0:17:05.87,Default,,0,0,0,,Сіз Кадзукисіз.
Dialogue: 0,0:17:05.99,0:17:08.75,Default,,0,0,0,,А... иә, сен де кел. Бұл жолмен.
Dialogue: 0,0:17:10.62,0:17:11.29,Default,,0,0,0,,басы
Dialogue: 0,0:17:11.83,0:17:13.79,Default,,0,0,0,,Әй, арттағы балаларды тоқтат.
Dialogue: 0,0:17:16.63,0:17:21.22,Default,,0,0,0,,Әй, не болды, теңіз жыланы, сонша асығасың ба?
Dialogue: 0,0:17:26.14,0:17:28.73,Default,,0,0,0,,Егер сіздің сарайыңыз сол арқаға қосылған болса...
Dialogue: 0,0:17:28.93,0:17:30.69,Default,,0,0,0,,Мен сені бұрын мазалағанмын.
Dialogue: 0,0:17:31.81,0:17:34.15,Default,,0,0,0,,Тау арыстаны!
Dialogue: 0,0:17:38.86,0:17:40.90,Default,,0,0,0,,Енді тау арыстаны
Dialogue: 0,0:17:41.15,0:17:44.28,Default,,0,0,0,,Аа, генералдың адамы мен Итоя және басқалары келе жатыр.
Dialogue: 0,0:17:44.74,0:17:46.37,Default,,0,0,0,,Қарттар ма?
Dialogue: 0,0:17:48.12,0:17:49.25,Default,,0,0,0,,Мен қайтып барамын
Dialogue: 0,0:17:49.71,0:17:51.46,Default,,0,0,0,,Шираюки, күте тұрыңыз.
Dialogue: 0,0:17:57.09,0:17:58.59,Default,,0,0,0,,Ол жоғалды.
Dialogue: 0,0:17:59.88,0:18:03.68,Default,,0,0,0,,Мен әлі жалғыз болмаймыз деп ойладым.
Dialogue: 0,0:18:19.82,0:18:22.70,Default,,0,0,0,,Шираюки дауысы
Dialogue: 0,0:18:26.16,0:18:27.95,Default,,0,0,0,,Ze… Зен
Dialogue: 0,0:18:31.08,0:18:34.12,Default,,0,0,0,,Дзен Дзен...!
Dialogue: 0,0:18:42.17,0:18:45.26,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:18:48.81,0:18:51.27,Default,,0,0,0,,Жоғарыда бақылау бөлімі орналастырылған.
Dialogue: 0,0:18:53.56,0:18:54.98,Default,,0,0,0,,Сіз де сондасыз
Dialogue: 0,0:18:55.69,0:18:56.90,Default,,0,0,0,,Дзен туралы не деуге болады?
Dialogue: 0,0:18:58.07,0:19:00.40,Default,,0,0,0,,Біз аздап жабайы боламыз.
Dialogue: 0,0:19:01.32,0:19:02.57,Default,,0,0,0,,Мені күт
Dialogue: 0,0:19:06.99,0:19:07.78,Default,,0,0,0,,Иә
Dialogue: 0,0:19:28.47,0:19:29.43,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:19:34.94,0:19:40.61,Default,,0,0,0,,Енді теңіздің тырнақтары тып-тыныш болып қалды.
Dialogue: 0,0:19:41.57,0:19:44.69,Default,,0,0,0,,Ол қайдан пайда болды?
Dialogue: 0,0:19:45.24,0:19:46.86,Default,,0,0,0,,Сіз мұны өте керемет түрде жасайсыз.
Dialogue: 0,0:19:49.28,0:19:53.16,Default,,0,0,0,,Сізге телефон соққан шығар. Ол алыс. Осы уакытқа дейін.
Dialogue: 0,0:19:54.37,0:19:59.42,Default,,0,0,0,,Мен Дзен Вистариямын, Кларинс патшалығының екінші князімін.
Dialogue: 0,0:20:00.59,0:20:02.67,Default,,0,0,0,,Мен серік сұрайын ба, қарақшылар?
Dialogue: 0,0:20:04.01,0:20:05.26,Default,,0,0,0,,Өте жақсы!
Dialogue: 0,0:20:05.38,0:20:07.01,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:20:20.27,0:20:22.61,Default,,0,0,0,,Неге берілмейсің, Теңіз жыланы?
Dialogue: 0,0:20:23.48,0:20:27.86,Default,,0,0,0,,Ол күзетші болып жұмыс істейді ме, білмеймін, бірақ ол менің жолыма бірінен соң бірі кедергі келтіреді.
Dialogue: 0,0:20:28.11,0:20:29.49,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:20:31.58,0:20:32.78,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:20:33.74,0:20:37.21,Default,,0,0,0,,Әр жолы мен оны соңғы минутта өткізіп алдым.
Dialogue: 0,0:20:38.00,0:20:41.63,Default,,0,0,0,,Төбеден балық аулайтын күн келді.
Dialogue: 0,0:20:42.17,0:20:43.38,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:20:44.00,0:20:48.05,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:58.94,0:21:01.35,Default,,0,0,0,,Уайымдама, Шираюки
Dialogue: 0,0:21:01.65,0:21:03.02,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:21:07.78,0:21:10.11,Default,,0,0,0,,Бітті, Шираюки
Dialogue: 0,0:21:12.16,0:21:13.70,Default,,0,0,0,,Ханзада Зен
Dialogue: 0,0:21:14.58,0:21:17.37,Default,,0,0,0,,Мистер Ағаштар Мицухиде мырза
Dialogue: 0,0:21:18.04,0:21:22.50,Default,,0,0,0,,(Ақшақардың айқайы)
Dialogue: 0,0:21:25.80,0:21:28.76,Default,,0,0,0,,Михая Танбарун сарбаздарын дастархан басында күт.
Dialogue: 0,0:21:29.30,0:21:31.34,Default,,0,0,0,,Раджи-доно сізге хабарласып, қоңырау шалу керек еді.
Dialogue: 0,0:21:31.64,0:21:32.55,Default,,0,0,0,,Иә
Dialogue: 0,0:21:33.97,0:21:37.43,Default,,0,0,0,,Зен Ум... Оби ше?
Dialogue: 0,0:21:39.06,0:21:40.60,Default,,0,0,0,,Оби әлі төменде.
Dialogue: 0,0:21:41.27,0:21:45.52,Default,,0,0,0,,Тырнақ ұсталды. Мен оны қазір шығарып саламын. Ал...
Dialogue: 0,0:21:46.19,0:21:48.69,Default,,0,0,0,,Қалғанын Танбарун шешеді.
Dialogue: 0,0:21:49.28,0:21:51.53,Default,,0,0,0,,Немесе... Казуки, баспа.
Dialogue: 0,0:21:52.16,0:21:53.41,Default,,0,0,0,,Айтпақшы, Венецияға жеткеннен кейін нұсқауларың аяқталады.»
Dialogue: 0,0:21:53.57,0:21:55.28,Default,,0,0,0,,Не істеп жатырсың, қария?
Dialogue: 0,0:21:55.74,0:21:57.45,Default,,0,0,0,,А... жақсы.
Dialogue: 0,0:21:58.29,0:22:03.25,Default,,0,0,0,,Балалар, сарайға қайтып бармас бұрын, неге біздің ауылда демалып алмайсыңдар?
Dialogue: 0,0:22:03.63,0:22:06.67,Default,,0,0,0,,А, жоқ, мен бұл жолы кешірім сұрағым келеді.
Dialogue: 0,0:22:07.09,0:22:07.80,Default,,0,0,0,,Хахаха
Dialogue: 0,0:22:09.38,0:22:10.09,Default,,0,0,0,,Және…
Dialogue: 0,0:22:11.22,0:22:12.22,Default,,0,0,0,,Әке.
Dialogue: 0,0:22:15.14,0:22:20.14,Default,,0,0,0,,♪～
Dialogue: 0,0:23:49.90,0:23:54.90,Default,,0,0,0,,～♪
Dialogue: 0,0:23:57.11,0:24:00.08,Default,,0,0,0,,Кешіріңіз, мен сіздің оққағарыңыз болып тағайындалдым...
Dialogue: 0,0:24:00.45,0:24:01.74,Default,,0,0,0,,Мен сені осы бастан өткердім.
Dialogue: 0,0:24:01.91,0:24:03.45,Default,,0,0,0,,Оби қайда кетті?
Dialogue: 0,0:24:03.70,0:24:07.96,Default,,0,0,0,,Шираюки, менің ойымша, біз бұл жерде бірге тұра алмаймыз.
Dialogue: 0,0:24:08.96,0:24:09.75,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:24:11.25,0:24:17.25,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory