Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.00,0:00:25.69,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:00:25.69,0:00:29.86,Default,,0000,0000,0000,,That era
Dialogue: 0,0:00:25.69,0:00:29.86,Default,,0000,0000,0000,,Империя басым держава болды.
Dialogue: 0,0:00:29.86,0:00:34.87,Default,,0000,0000,0000,,Дакиядан кейінгі Антанта
Dialogue: 0,0:00:29.86,0:00:34.87,Default,,0000,0000,0000,,Республиканы да жеңді.
Dialogue: 0,0:00:34.87,0:00:37.87,Default,,0000,0000,0000,,The remnants
Dialogue: 0,0:00:34.87,0:00:37.87,Default,,0000,0000,0000,,Мен оны оңтүстікке қашуға рұқсат еттім➡
Dialogue: 0,0:00:37.87,0:00:40.21,Default,,0000,0000,0000,,Ол континентте үстемдік орнатты.
Dialogue: 0,0:00:40.21,0:00:45.88,Default,,0000,0000,0000,,Империяның ең жақсы дәуірі деп аталады.
Dialogue: 0,0:00:40.21,0:00:45.88,Default,,0000,0000,0000,,Ол ең үлкен аумақты басқарды.
Notwithstanding
Dialogue: 0,0:00:45.88,0:00:47.88,Default,,0000,0000,0000,,.
Dialogue: 0,0:00:47.88,0:00:52.89,Default,,0000,0000,0000,,Тағдыр құдайы Империяда
Dialogue: 0,0:00:47.88,0:00:52.89,Default,,0000,0000,0000,,I didn't smile.
Dialogue: 0,0:00:52.89,0:00:55.72,Default,,0000,0000,0000,,Бұл нағыз қатыгездік.
Dialogue: 0,0:00:55.72,0:00:58.56,Default,,0000,0000,0000,,Неліктен империя әлеммен айналысады➡
Dialogue: 0,0:00:58.56,0:01:01.33,Default,,0000,0000,0000,,Батпақтағы шайқас
Dialogue: 0,0:00:58.56,0:01:01.33,Default,,0000,0000,0000,,Probably forced.
Dialogue: 0,0:01:01.33,0:01:05.83,Default,,0000,0000,0000,,Where are they
Dialogue: 0,0:01:01.33,0:01:05.83,Default,,0000,0000,0000,,Мен дұрыс емес бұрылыс жасадым ба?
Dialogue: 0,0:01:05.83,0:01:09.67,Default,,0000,0000,0000,,Мен сізге жауап бере алғым келеді.
Dialogue: 0,0:01:09.67,0:01:15.68,Default,,0000,0000,0000,,Мен де адасып, жол іздеп.
Dialogue: 0,0:01:09.67,0:01:15.68,Default,,0000,0000,0000,,Олар жай ғана қойлар.
Dialogue: 0,0:01:15.68,0:01:18.68,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:01:15.68,0:01:18.68,Default,,0000,0000,0000,,Just.
Dialogue: 0,0:01:18.68,0:01:23.18,Default,,0000,0000,0000,,Алланың қалауын ойласаң.
Dialogue: 0,0:01:26.52,0:01:30.69,Default,,0000,0000,0000,,Дүние
Dialogue: 0,0:01:26.52,0:01:30.69,Default,,0000,0000,0000,,Бізді соғысқа не итермеледі➡
Dialogue: 0,0:01:30.69,0:01:35.70,Default,,0000,0000,0000,,Империяға деген төзгісіз қорқыныш.
Dialogue: 0,0:01:30.69,0:01:35.70,Default,,0000,0000,0000,,It may be true.
Dialogue: 0,0:01:35.70,0:01:38.20,Default,,0000,0000,0000,,Unbearable fear?
Dialogue: 0,0:01:38.20,0:01:44.87,Default,,0000,0000,0000,,Иә. Бұл эмоцияға негізделген.
Dialogue: 0,0:01:44.87,0:01:49.54,Default,,0000,0000,0000,,Біреулер қорықты, біреулер жек көрді.
Dialogue: 0,0:01:49.54,0:01:54.21,Default,,0000,0000,0000,,Some people trust
Dialogue: 0,0:01:49.54,0:01:54.21,Default,,0000,0000,0000,,Кейбіреулері қосылды.
Dialogue: 0,0:01:54.21,0:01:57.88,Default,,0000,0000,0000,,Әр адамның жүрегін сезім билейді➡
Dialogue: 0,0:01:57.88,0:02:02.49,Default,,0000,0000,0000,,Жою жолы
Dialogue: 0,0:01:57.88,0:02:02.49,Default,,0000,0000,0000,,Менің ойымша, олар әрі қарай жылжыды.
Dialogue: 0,0:02:02.49,0:02:07.59,Default,,0000,0000,0000,,Қолына семсер алған адам семсерден өледі.
Dialogue: 0,0:02:09.83,0:02:11.83,Default,,0000,0000,0000,,(Ұшу дыбысы)
Dialogue: 0,0:02:11.83,0:02:14.33,Default,,0000,0000,0000,,📱 (Коениг) Бұл 03. Жау көрінбейді.
Dialogue: 0,0:02:14.33,0:02:16.84,Default,,0000,0000,0000,,📱Бұл 04 Байланыс жоқ!
Dialogue: 0,0:02:16.84,0:02:18.84,Default,,0000,0000,0000,,📱Еш жерде жау жоқ!
Dialogue: 0,0:02:18.84,0:02:21.01,Default,,0000,0000,0000,,Қат! I got framed!
Dialogue: 0,0:02:21.01,0:02:23.01,Default,,0000,0000,0000,,Майор, нақты не?
Dialogue: 0,0:02:23.01,0:02:27.18,Default,,0000,0000,0000,,Dispersed advance is false news.
Dialogue: 0,0:02:23.01,0:02:27.18,Default,,0000,0000,0000,,Enemies are gathering!
Dialogue: 0,0:02:27.18,0:02:29.52,Default,,0000,0000,0000,,Әскерім үшін тәтті бал дайындалды➡
Dialogue: 0,0:02:29.52,0:02:32.19,Default,,0000,0000,0000,,Honestly
Dialogue: 0,0:02:29.52,0:02:32.19,Default,,0000,0000,0000,,I was lured out!
Dialogue: 0,0:02:32.19,0:02:34.85,Default,,0000,0000,0000,,Where we are now
Dialogue: 0,0:02:32.19,0:02:34.85,Default,,0000,0000,0000,,If not ➡
Dialogue: 0,0:02:34.85,0:02:39.19,Default,,0000,0000,0000,,The enemy is in front of our main force.
Dialogue: 0,0:02:34.85,0:02:39.19,Default,,0000,0000,0000,,Gathering!
Dialogue: 0,0:02:39.19,0:02:44.70,Default,,0000,0000,0000,,As intended, with deceptive information
Dialogue: 0,0:02:39.19,0:02:44.70,Default,,0000,0000,0000,,Enemies were lured out of the anagura.
Dialogue: 0,0:02:44.70,0:02:48.54,Default,,0000,0000,0000,,Оларды қоршап, жою ғана қалды.
Dialogue: 0,0:02:48.54,0:02:50.54,Default,,0000,0000,0000,,You won.
Dialogue: 0,0:02:50.54,0:02:53.21,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:02:50.54,0:02:53.21,Default,,0000,0000,0000,,Unable to connect to headquarters!
Dialogue: 0,0:02:53.21,0:02:55.21,Default,,0000,0000,0000,,Майор, маған нұсқау беріңізші!
Dialogue: 0,0:02:55.21,0:02:57.54,Default,,0000,0000,0000,,Барлығы жиналғаннан кейін толық жылдамдықты өзгерту!
Dialogue: 0,0:02:57.54,0:02:59.55,Default,,0000,0000,0000,,📱 (Weiss)
Dialogue: 0,0:02:57.54,0:02:59.55,Default,,0000,0000,0000,,Do you want to hit the enemy magician?
Dialogue: 0,0:02:59.55,0:03:03.98,Default,,0000,0000,0000,,Do you know about small fry? Lick rotten
Dialogue: 0,0:02:59.55,0:03:03.98,Default,,0000,0000,0000,,Destroy the enemy headquarters!
Dialogue: 0,0:03:03.98,0:03:07.49,Default,,0000,0000,0000,,Break through the center! ?
Dialogue: 0,0:03:03.98,0:03:07.49,Default,,0000,0000,0000,,Майор, байсалдысыз ба? ?
Dialogue: 0,0:03:07.49,0:03:09.66,Default,,0000,0000,0000,,Сандық кемшілікті ескеріңіз!
Dialogue: 0,0:03:09.66,0:03:12.99,Default,,0000,0000,0000,,Mere support for the main army, etc.
Dialogue: 0,0:03:09.66,0:03:12.99,Default,,0000,0000,0000,,Жоюды кейінге қалдыру!
Dialogue: 0,0:03:12.99,0:03:16.33,Default,,0000,0000,0000,,Then! Turn the foundation upside down!
Dialogue: 0,0:03:16.33,0:03:20.33,Default,,0000,0000,0000,,Ойын ережесін өзгертіңіз!
Dialogue: 0,0:03:16.33,0:03:20.33,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:03:20.33,0:03:22.84,Default,,0000,0000,0000,,(Дабыл)
Dialogue: 0,0:03:22.84,0:03:28.01,Default,,0000,0000,0000,,Breaking news? Enemy magic troops
Dialogue: 0,0:03:22.84,0:03:28.01,Default,,0000,0000,0000,,Олар тез жақындап келе жатқан сияқты...
Dialogue: 0,0:03:28.01,0:03:30.68,Default,,0000,0000,0000,,Не? Ол қайдан?
Dialogue: 0,0:03:30.68,0:03:34.85,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:03:34.85,0:03:37.52,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:03:37.52,0:03:40.85,Default,,0000,0000,0000,,Proceed! Don't flinch!
Dialogue: 0,0:03:37.52,0:03:40.85,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:03:40.85,0:03:45.02,Default,,0000,0000,0000,,(оқтар мен жарылыс дыбыстары)
Dialogue: 0,0:03:45.02,0:03:47.86,Default,,0000,0000,0000,,өз елінен қашып кеткен
Dialogue: 0,0:03:45.02,0:03:47.86,Default,,0000,0000,0000,,You losers!
Dialogue: 0,0:03:47.86,0:03:50.86,Default,,0000,0000,0000,,Мұны бронды жеңді бір рет түрту арқылы жасаңыз!
Dialogue: 0,0:03:50.86,0:04:03.81,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:04:03.81,0:04:06.48,Default,,0000,0000,0000,,12-ші сиқырлы батальон бұзылады!
Dialogue: 0,0:04:06.48,0:04:10.48,Default,,0000,0000,0000,,No way...
Dialogue: 0,0:04:06.48,0:04:10.48,Default,,0000,0000,0000,,Мысықтар осыны көздеп отыр ма?
Dialogue: 0,0:04:10.48,0:04:18.49,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:04:18.49,0:04:22.33,Default,,0000,0000,0000,,《Тч, әр уақытта
Dialogue: 0,0:04:18.49,0:04:22.33,Default,,0000,0000,0000,,Мен бұған сену керек екеніне сене алмаймын.
Dialogue: 0,0:04:22.33,0:04:25.00,Default,,0000,0000,0000,,Damn you, damn you...
Dialogue: 0,0:04:25.00,0:04:29.00,Default,,0000,0000,0000,,But right now, survival comes first.
Dialogue: 0,0:04:29.00,0:04:33.51,Default,,0000,0000,0000,,Because necessity is necessary! 》
Dialogue: 0,0:04:33.51,0:04:44.18,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:04:44.18,0:04:48.19,Default,,0000,0000,0000,,Әулиелер
Dialogue: 0,0:04:44.18,0:04:48.19,Default,,0000,0000,0000,,Do not forget the power of the Lord.
Dialogue: 0,0:04:48.19,0:04:53.19,Default,,0000,0000,0000,,Under the light, follow your destiny.
Dialogue: 0,0:04:53.19,0:04:56.86,Default,,0000,0000,0000,,The rebels will be consumed.
Dialogue: 0,0:04:56.86,0:04:59.37,Default,,0000,0000,0000,,Target Enemy headquarters!
Dialogue: 0,0:04:59.37,0:05:01.67,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:05:05.64,0:05:08.81,Default,,0000,0000,0000,,Evacuation Evacuation!
Dialogue: 0,0:05:05.64,0:05:08.81,Default,,0000,0000,0000,,Әй, асығыңыз!
Dialogue: 0,0:05:08.81,0:05:11.98,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:05:08.81,0:05:11.98,Default,,0000,0000,0000,,Is it the same as the line again?
Dialogue: 0,0:05:11.98,0:05:14.08,Default,,0000,0000,0000,,Жоғары мәртебелі! Кешіріңіз!
Dialogue: 0,0:05:18.15,0:05:25.16,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:05:25.16,0:05:28.56,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:35.50,0:05:38.50,Default,,0000,0000,0000,,It's truly a tower on the sand.
Dialogue: 0,0:05:38.50,0:05:40.84,Default,,0000,0000,0000,,More than I thought
Dialogue: 0,0:05:38.50,0:05:40.84,Default,,0000,0000,0000,,It wasn't a big deal.
Dialogue: 0,0:05:40.84,0:05:43.68,Default,,0000,0000,0000,,It's too late, guys.
Dialogue: 0,0:05:43.68,0:05:48.18,Default,,0000,0000,0000,,No way...Major too.
Dialogue: 0,0:05:43.68,0:05:48.18,Default,,0000,0000,0000,,Мен сізді қанағаттандырарлықтай алып кете алмасам ше?
Dialogue: 0,0:05:48.18,0:05:52.35,Default,,0000,0000,0000,,Although we are proud of our elegance,
Dialogue: 0,0:05:48.18,0:05:52.35,Default,,0000,0000,0000,,Those are some pretty uncool escargots.
Dialogue: 0,0:05:52.35,0:05:55.69,Default,,0000,0000,0000,,Escargot It's delicious, though.
Dialogue: 0,0:05:55.69,0:05:59.36,Default,,0000,0000,0000,,Guys, I understand how you feel.
Dialogue: 0,0:05:55.69,0:05:59.36,Default,,0000,0000,0000,,Абайлаңыз.
Dialogue: 0,0:05:59.36,0:06:02.46,Default,,0000,0000,0000,,This is a battlefield after all.
Dialogue: 0,0:06:02.46,0:06:06.30,Default,,0000,0000,0000,,Ха! I apologize for the inconvenience!
Dialogue: 0,0:06:02.46,0:06:06.30,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:06:06.30,0:06:11.80,Default,,0000,0000,0000,,Әйтсе де атамекенге қайтатын жолымыз жоқ.
Dialogue: 0,0:06:06.30,0:06:11.80,Default,,0000,0000,0000,,There was an order to return.
Dialogue: 0,0:06:11.80,0:06:14.14,Default,,0000,0000,0000,,Қалған жұмысты достық күштерге қалдырыңыз➡
Dialogue: 0,0:06:14.14,0:06:17.64,Default,,0000,0000,0000,,What is a sandy battlefield?
Dialogue: 0,0:06:14.14,0:06:17.64,Default,,0000,0000,0000,,Let's say goodbye!
Dialogue: 0,0:06:17.64,0:06:22.32,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:22.32,0:06:27.65,Default,,0000,0000,0000,,Оңтүстік ликер және кәдесый ретінде жиһаз
Dialogue: 0,0:06:22.32,0:06:27.65,Default,,0000,0000,0000,,Enjoy your first vacation in a while!
Dialogue: 0,0:06:27.65,0:06:30.49,Default,,0000,0000,0000,,The dust that has stained your body
Dialogue: 0,0:06:27.65,0:06:30.49,Default,,0000,0000,0000,,Жуу➡
Dialogue: 0,0:06:30.49,0:06:34.29,Default,,0000,0000,0000,,Cultivate energy in both body and mind...
Dialogue: 0,0:06:44.34,0:06:50.34,Default,,0000,0000,0000,,Қалай... неге...
Dialogue: 0,0:06:44.34,0:06:50.34,Default,,0000,0000,0000,,Бұл қалай болды!
Dialogue: 0,0:06:52.35,0:07:09.06,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:07:25.14,0:07:28.82,Default,,0000,0000,0000,,Жоқ, мен келдім.
Dialogue: 0,0:07:25.14,0:07:28.82,Default,,0000,0000,0000,,Бұл алыс болды!
Dialogue: 0,0:07:28.82,0:07:31.32,Default,,0000,0000,0000,,Жарайсыңдар! Мен өлгенше ішемін!
Dialogue: 0,0:07:31.32,0:07:36.49,Default,,0000,0000,0000,,Shall we go to Zolka Restaurant?
Dialogue: 0,0:07:31.32,0:07:36.49,Default,,0000,0000,0000,,Эй, бұл жақсы. Бүгін кешке барамыз ба?
Dialogue: 0,0:07:36.49,0:07:39.49,Default,,0000,0000,0000,,Қайтып келдіңіз бе?
Dialogue: 0,0:07:39.49,0:07:43.16,Default,,0000,0000,0000,,Тікелей Бас штабтың қарамағында
Dialogue: 0,0:07:39.49,0:07:43.16,Default,,0000,0000,0000,,2-3-ші әуе сиқырлы батальоны ➡
Dialogue: 0,0:07:43.16,0:07:47.17,Default,,0000,0000,0000,,Майор Таня фон Дегуречаф
Dialogue: 0,0:07:43.16,0:07:47.17,Default,,0000,0000,0000,,Мен жұмыстан жаңа ғана оралдым.
Dialogue: 0,0:07:47.17,0:07:50.84,Default,,0000,0000,0000,,Стис ауданы арқылы өтіп бара жатып,
Dialogue: 0,0:07:47.17,0:07:50.84,Default,,0000,0000,0000,,Оңтүстікте де тамаша ерлік жасадыңыз.
Dialogue: 0,0:07:50.84,0:07:55.01,Default,,0000,0000,0000,,Ұрыс мәліметтерін қараңыз
Dialogue: 0,0:07:50.84,0:07:55.01,Default,,0000,0000,0000,,Мен қатты әсерлендім.
Dialogue: 0,0:07:55.01,0:07:57.34,Default,,0000,0000,0000,,Мен құрметке бөленгенмін.
Dialogue: 0,0:07:57.34,0:08:03.28,Default,,0000,0000,0000,,Шөлге ғана тән қиындықтар көп болса керек.
Dialogue: 0,0:07:57.34,0:08:03.28,Default,,0000,0000,0000,,Айтпақшы, әскерлердің жағдайы қалай?
Dialogue: 0,0:08:03.28,0:08:05.28,Default,,0000,0000,0000,,Иә Кішігірім тозу.
Dialogue: 0,0:08:05.28,0:08:08.29,Default,,0000,0000,0000,,Ауыр зақым жоқ
Dialogue: 0,0:08:05.28,0:08:08.29,Default,,0000,0000,0000,,Сіз қайтып келдіңіз.
Dialogue: 0,0:08:08.29,0:08:11.46,Default,,0000,0000,0000,,Ұрыс жалғасуда. Бұл жасақтың жауынгерлік рухына әсер ете ме?
Dialogue: 0,0:08:11.46,0:08:16.13,Default,,0000,0000,0000,,Жауынгерлік рухта мықты бол
Dialogue: 0,0:08:11.46,0:08:16.13,Default,,0000,0000,0000,,Оның өзі энергияға толы.
Dialogue: 0,0:08:16.13,0:08:19.30,Default,,0000,0000,0000,,Күтілгендей, бұл элиталық батальон.
Dialogue: 0,0:08:19.30,0:08:22.64,Default,,0000,0000,0000,,Енді,
Dialogue: 0,0:08:19.30,0:08:22.64,Default,,0000,0000,0000,,Практикалық мәселелерге көшейік.
Dialogue: 0,0:08:22.64,0:08:24.80,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:22.64,0:08:24.80,Default,,0000,0000,0000,,Тасымалдауға қатысты...
Dialogue: 0,0:08:24.80,0:08:27.81,Default,,0000,0000,0000,,Ах, темір жол бөлімі.
Dialogue: 0,0:08:24.80,0:08:27.81,Default,,0000,0000,0000,,Майор Уганы білесіз бе?
Dialogue: 0,0:08:27.81,0:08:33.15,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:08:27.81,0:08:33.15,Default,,0000,0000,0000,,Ол стратегиялық барлау бөлімінің капитаны Рудольф.
Dialogue: 0,0:08:33.15,0:08:36.55,Default,,0000,0000,0000,,Барлау бөлімі...
Dialogue: 0,0:08:50.66,0:08:53.00,Default,,0000,0000,0000,,《Тым аңғал!
Dialogue: 0,0:08:53.00,0:08:58.00,Default,,0000,0000,0000,,Ол кезде өтірік болса да, әскер шығыны болды
Dialogue: 0,0:08:53.00,0:08:58.00,Default,,0000,0000,0000,,Қарқынды дейік...》
Dialogue: 0,0:09:01.27,0:09:03.48,Default,,0000,0000,0000,,Барлық мүшелер назар аударыңыз!
Dialogue: 0,0:09:05.44,0:09:10.95,Default,,0000,0000,0000,,Мырзалар, бүгін таңертең Шығыс майдан армиясы
Dialogue: 0,0:09:05.44,0:09:10.95,Default,,0000,0000,0000,,437 тактикалық арнайы барлау взводы➡
Dialogue: 0,0:09:10.95,0:09:14.29,Default,,0000,0000,0000,,Төтенше жағдай туралы хабарлама жіберу.
Dialogue: 0,0:09:10.95,0:09:14.29,Default,,0000,0000,0000,,Бірінші кордонда➡
Dialogue: 0,0:09:14.29,0:09:17.46,Default,,0000,0000,0000,,Федералдық әскерлерді белсендіру туралы хабарланды.
Dialogue: 0,0:09:17.46,0:09:19.46,Default,,0000,0000,0000,,
Dialogue: 0,0:09:19.46,0:09:23.63,Default,,0000,0000,0000,,Сондықтан қазірден бастап
Dialogue: 0,0:09:19.46,0:09:23.63,Default,,0000,0000,0000,,Жаттығу кезіндегі кездейсоқ қателіктен➡
Dialogue: 0,0:09:23.63,0:09:27.47,Default,,0000,0000,0000,,Федералдық аумаққа трансшекаралық барлау жүргізу
Dialogue: 0,0:09:23.63,0:09:27.47,Default,,0000,0000,0000,,Ол орындалды.
Dialogue: 0,0:09:27.47,0:09:32.14,Default,,0000,0000,0000,,Федералдық армияның қозғалысын бақылау
Dialogue: 0,0:09:27.47,0:09:32.14,Default,,0000,0000,0000,,Қажет болса, дабыл беріңіз.
Dialogue: 0,0:09:32.14,0:09:35.47,Default,,0000,0000,0000,,«Барлығын мен үшін» мұрагері…
Dialogue: 0,0:09:32.14,0:09:35.47,Default,,0000,0000,0000,,Осы жерден соғыс бастамаңыз.
Dialogue: 0,0:09:35.47,0:09:38.64,Default,,0000,0000,0000,,Соғыс басталмаған жағдайда
Dialogue: 0,0:09:35.47,0:09:38.64,Default,,0000,0000,0000,,...
Dialogue: 0,0:09:38.64,0:09:43.65,Default,,0000,0000,0000,,Of course the declaration of war
Dialogue: 0,0:09:38.64,0:09:43.65,Default,,0000,0000,0000,,Жарияланғанға дейін бұл бейтараптықты бұзу болып табылады.
Dialogue: 0,0:09:43.65,0:09:48.32,Default,,0000,0000,0000,,Өз іс-әрекеттеріңізде өте сақ болыңыз.
Dialogue: 0,0:09:43.65,0:09:48.32,Default,,0000,0000,0000,,...
Dialogue: 0,0:09:48.32,0:09:51.32,Default,,0000,0000,0000,,Major
Dialogue: 0,0:09:48.32,0:09:51.32,Default,,0000,0000,0000,,Сізге сұрақ қойсам болады ма?
Dialogue: 0,0:09:51.32,0:09:54.33,Default,,0000,0000,0000,,Әрине, лейтенант Серебряков.
Dialogue: 0,0:09:54.33,0:09:58.83,Default,,0000,0000,0000,,Соғыс сөзсіз болса, алдын алу шабуылдары
Dialogue: 0,0:09:54.33,0:09:58.83,Default,,0000,0000,0000,,Is it allowed?
Dialogue: 0,0:09:58.83,0:10:03.17,Default,,0000,0000,0000,,Біз коммунистермен жұмыс істеп жатырмыз, сондықтан ұялмаңыз...
Dialogue: 0,0:09:58.83,0:10:03.17,Default,,0000,0000,0000,,➡
Dialogue: 0,0:10:03.17,0:10:05.50,Default,,0000,0000,0000,,Бірінші атуды Федерация жасайды.
Dialogue: 0,0:10:05.50,0:10:09.84,Default,,0000,0000,0000,,Until the moment of war
Dialogue: 0,0:10:05.50,0:10:09.84,Default,,0000,0000,0000,,No firing of any kind is permitted.
Dialogue: 0,0:10:09.84,0:10:13.35,Default,,0000,0000,0000,,…
Dialogue: 0,0:10:09.84,0:10:13.35,Default,,0000,0000,0000,,It was placed.
Dialogue: 0,0:10:13.35,0:10:17.35,Default,,0000,0000,0000,,I agree with Lt. Glanz.
Dialogue: 0,0:10:17.35,0:10:21.35,Default,,0000,0000,0000,,...
Dialogue: 0,0:10:17.35,0:10:21.35,Default,,0000,0000,0000,,Flying to the operational area.
Dialogue: 0,0:10:21.35,0:10:25.86,Default,,0000,0000,0000,,...
Dialogue: 0,0:10:21.35,0:10:25.86,Default,,0000,0000,0000,,Әдепсіз адам бар ма?
Dialogue: 0,0:10:25.86,0:10:30.70,Default,,0000,0000,0000,,...
Dialogue: 0,0:10:25.86,0:10:30.70,Default,,0000,0000,0000,,I believe there are none in my battalion.
Dialogue: 0,0:10:30.70,0:10:32.70,Default,,0000,0000,0000,,Хмм… Бұл не өзі!
Dialogue: 0,0:10:32.70,0:10:35.20,Default,,0000,0000,0000,,...
Dialogue: 0,0:10:35.20,0:10:39.37,Default,,0000,0000,0000,,Will snow come after the desert?
Dialogue: 0,0:10:35.20,0:10:39.37,Default,,0000,0000,0000,,«Супер Айджа».
Dialogue: 0,0:10:39.37,0:10:42.88,Default,,0000,0000,0000,,(қатты дауыс)
Dialogue: 0,0:10:42.88,0:10:46.88,Default,,0000,0000,0000,,...
Dialogue: 0,0:10:42.88,0:10:46.88,Default,,0000,0000,0000,,Expect to fulfill your mission!
Dialogue: 0,0:10:46.88,0:10:49.72,Default,,0000,0000,0000,,...
Dialogue: 0,0:10:49.72,0:10:52.22,Default,,0000,0000,0000,,Glory to the Empire!
Dialogue: 0,0:10:52.22,0:10:55.22,Default,,0000,0000,0000,,...
Dialogue: 0,0:11:29.36,0:11:36.70,Default,,0000,0000,0000,,...
Dialogue: 0,0:11:29.36,0:11:36.70,Default,,0000,0000,0000,,…
Dialogue: 0,0:11:36.70,0:11:41.70,Default,,0000,0000,0000,,Live ammunition is piled up
Dialogue: 0,0:11:36.70,0:11:41.70,Default,,0000,0000,0000,,Fuel for vehicles?
Dialogue: 0,0:11:41.70,0:11:44.20,Default,,0000,0000,0000,,...
Dialogue: 0,0:11:47.04,0:11:49.38,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:11:49.38,0:12:05.16,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:12:05.16,0:12:11.33,Default,,0000,0000,0000,,Сіз өте үлкен екенсіз, тіпті пойыздың мылтығына да бардыңыз.
Dialogue: 0,0:12:05.16,0:12:11.33,Default,,0000,0000,0000,,It's tantamount to a declaration of war.
Dialogue: 0,0:12:11.33,0:12:15.50,Default,,0000,0000,0000,,...
Dialogue: 0,0:12:11.33,0:12:15.50,Default,,0000,0000,0000,,...
Dialogue: 0,0:12:15.50,0:12:19.81,Default,,0000,0000,0000,,«Осы жерден соғыс бастама».
Dialogue: 0,0:12:15.50,0:12:19.81,Default,,0000,0000,0000,,Түсінді.
Dialogue: 0,0:12:24.68,0:12:28.68,Default,,0000,0000,0000,,Ең жаман нәрсе ерте ме, кеш пе болады
Dialogue: 0,0:12:24.68,0:12:28.68,Default,,0000,0000,0000,,Одан құтылу мүмкін емес сияқты.
Dialogue: 0,0:12:28.68,0:12:30.68,Default,,0000,0000,0000,,Біз мұқият жасыру әрекеттерін орындаймыз.
Dialogue: 0,0:12:30.68,0:12:33.52,Default,,0000,0000,0000,,Қалааралық радио
Dialogue: 0,0:12:30.68,0:12:33.52,Default,,0000,0000,0000,,Қайта тексеріңіз.
Dialogue: 0,0:12:33.52,0:12:37.02,Default,,0000,0000,0000,,«Барлығын мен үшін» мұрагері…
Dialogue: 0,0:12:33.52,0:12:37.02,Default,,0000,0000,0000,,Радио блокадасын шекке дейін сақтаңыз.
Dialogue: 0,0:12:37.02,0:12:40.86,Default,,0000,0000,0000,,Пернелерді нашар баспаңыз.
Dialogue: 0,0:12:37.02,0:12:40.86,Default,,0000,0000,0000,,Major.
Dialogue: 0,0:12:40.86,0:12:45.03,Default,,0000,0000,0000,,Мылтық ұңғысы қозғалуда...
Dialogue: 0,0:12:40.86,0:12:45.03,Default,,0000,0000,0000,,In the event of hostilities...
Dialogue: 0,0:12:45.03,0:12:47.53,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:12:45.03,0:12:47.53,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:12:52.54,0:12:55.34,Default,,0000,0000,0000,,Uh... I shot him.
Dialogue: 0,0:12:57.71,0:13:02.15,Default,,0000,0000,0000,,Федералдық күштер барлық фронттарға шабуыл жасайды
Dialogue: 0,0:12:57.71,0:13:02.15,Default,,0000,0000,0000,,A declaration of war.
Dialogue: 0,0:13:02.15,0:13:05.32,Default,,0000,0000,0000,,Федерация империяға соғыс жариялады.
Dialogue: 0,0:13:02.15,0:13:05.32,Default,,0000,0000,0000,,Сіздің туған еліңіз қандай?
Dialogue: 0,0:13:05.32,0:13:10.82,Default,,0000,0000,0000,,Филиалдылығына қарамастан барлық бөлімшелер
Dialogue: 0,0:13:05.32,0:13:10.82,Default,,0000,0000,0000,,Бізге шайқасты дереу бастау керектігі айтылған!
Dialogue: 0,0:13:10.82,0:13:13.33,Default,,0000,0000,0000,,Соғыс уақытына әзірлік жоспарына ауысыңыз!
Dialogue: 0,0:13:13.33,0:13:17.50,Default,,0000,0000,0000,,...
Dialogue: 0,0:13:13.33,0:13:17.50,Default,,0000,0000,0000,,...
Dialogue: 0,0:13:17.50,0:13:20.60,Default,,0000,0000,0000,,(Sound of magic tool)
Dialogue: 0,0:13:23.17,0:13:25.84,Default,,0000,0000,0000,,What is the enemy's magic reaction?
Dialogue: 0,0:13:23.17,0:13:25.84,Default,,0000,0000,0000,,Not at this time!
Dialogue: 0,0:13:25.84,0:13:28.34,Default,,0000,0000,0000,,Okay. The federal army is already ➡
Dialogue: 0,0:13:28.34,0:13:31.01,Default,,0000,0000,0000,,With our eastern army
Dialogue: 0,0:13:28.34,0:13:31.01,Default,,0000,0000,0000,,Appears to be at war.
Dialogue: 0,0:13:31.01,0:13:35.18,Default,,0000,0000,0000,,We will attack enemy artillery and
Dialogue: 0,0:13:31.01,0:13:35.18,Default,,0000,0000,0000,,...
Dialogue: 0,0:13:35.18,0:13:39.52,Default,,0000,0000,0000,,Be wary of enemy reinforcements.
Dialogue: 0,0:13:35.18,0:13:39.52,Default,,0000,0000,0000,,📱(Weiss) All members assembled!
Dialogue: 0,0:13:39.52,0:13:43.69,Default,,0000,0000,0000,,...
Dialogue: 0,0:13:39.52,0:13:43.69,Default,,0000,0000,0000,,Do not allow jumping!
Dialogue: 0,0:13:43.69,0:13:47.69,Default,,0000,0000,0000,,Get the gun! Be inspired!
Dialogue: 0,0:13:43.69,0:13:47.69,Default,,0000,0000,0000,,Clutch the jewel!
Dialogue: 0,0:13:47.69,0:13:50.60,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:13:47.69,0:13:50.60,Default,,0000,0000,0000,,Әрекет етуді бастаңыз!
Dialogue: 0,0:13:55.20,0:13:58.37,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:13:58.37,0:14:00.47,Default,,0000,0000,0000,,Enemy attack! ?
Dialogue: 0,0:13:58.37,0:14:00.47,Default,,0000,0000,0000,,Эй, досым! Эй, досым!
Dialogue: 0,0:14:00.47,0:14:02.47,Default,,0000,0000,0000,,This is not the front line!
Dialogue: 0,0:14:02.47,0:14:04.98,Default,,0000,0000,0000,,...
Dialogue: 0,0:14:02.47,0:14:04.98,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:14:04.98,0:14:07.65,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:14:07.65,0:14:09.82,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:14:09.82,0:14:13.32,Default,,0000,0000,0000,,It's a train gun! Protect the train gun!
Dialogue: 0,0:14:17.16,0:14:24.00,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:14:24.00,0:14:27.00,Default,,0000,0000,0000,,Асығыңыз, асығыңыз! Мен өз квотамды түсіремін!
Dialogue: 0,0:14:27.00,0:14:30.30,Default,,0000,0000,0000,,Жүктелмеген снарядты көздеңіз!
Dialogue: 0,0:14:27.00,0:14:30.30,Default,,0000,0000,0000,,Польнарефф?
Dialogue: 0,0:14:33.51,0:14:37.51,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:14:37.51,0:14:39.68,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:14:39.68,0:14:43.08,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:14:45.02,0:14:47.32,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:14:54.19,0:14:58.20,Default,,0000,0000,0000,,Хмм, менің ойымша, біздің кезегіміз емес.
Dialogue: 0,0:14:58.20,0:15:04.64,Default,,0000,0000,0000,,Үлкен, нәзік, жанғыш.
Dialogue: 0,0:14:58.20,0:15:04.64,Default,,0000,0000,0000,,Тек тамаша мақсат.
Dialogue: 0,0:15:04.64,0:15:06.64,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:15:10.98,0:15:16.48,Default,,0000,0000,0000,,《Шынымды айтсам, мен соғысты жек көремін.
Dialogue: 0,0:15:10.98,0:15:16.48,Default,,0000,0000,0000,,Адамдардың бірін-бірі өлтіруі, т.б.➡
Dialogue: 0,0:15:16.48,0:15:20.49,Default,,0000,0000,0000,,Менің ойымша, бұл адамзат тарихындағы ең сорақы нәрсе.
Dialogue: 0,0:15:20.49,0:15:24.16,Default,,0000,0000,0000,,Ресурстар мен адами капиталдың ысырап болуы
Dialogue: 0,0:15:20.49,0:15:24.16,Default,,0000,0000,0000,,Басқасы жоқ.
Dialogue: 0,0:15:24.16,0:15:26.99,Default,,0000,0000,0000,,Бірақ қарсылас Комми.
Dialogue: 0,0:15:26.99,0:15:30.33,Default,,0000,0000,0000,,Жеке бас бостандығын бұзу
Dialogue: 0,0:15:26.99,0:15:30.33,Default,,0000,0000,0000,,Тоталитарлық.
Dialogue: 0,0:15:30.33,0:15:33.50,Default,,0000,0000,0000,,Коммимен бірге аспанға қарай алмайсың.
Dialogue: 0,0:15:33.50,0:15:37.34,Default,,0000,0000,0000,,Артқы сейфте
Dialogue: 0,0:15:33.50,0:15:37.34,Default,,0000,0000,0000,,Тегіс өмір сүру➡
Dialogue: 0,0:15:37.34,0:15:40.01,Default,,0000,0000,0000,,Мен мылтық алуым керек.
Dialogue: 0,0:15:40.01,0:15:44.18,Default,,0000,0000,0000,,Екінші компания
Dialogue: 0,0:15:40.01,0:15:44.18,Default,,0000,0000,0000,,Жау пойызының зеңбіректерін жою аяқталды.
Dialogue: 0,0:15:44.18,0:15:48.18,Default,,0000,0000,0000,,Еңбектеріңіз үшін рахмет. Тіпті солай➡
Dialogue: 0,0:15:48.18,0:15:52.08,Default,,0000,0000,0000,,Жаудың сиқыршысы әлі көрінбейді.
Dialogue: 0,0:15:54.02,0:15:57.52,Default,,0000,0000,0000,,Майор
Dialogue: 0,0:15:54.02,0:15:57.52,Default,,0000,0000,0000,,Бұл Шығыс армиясын қолдау туралы бұйрық.
Dialogue: 0,0:15:57.52,0:16:01.96,Default,,0000,0000,0000,,Мәліметтер өз қалауыңыз бойынша!
Dialogue: 0,0:15:57.52,0:16:01.96,Default,,0000,0000,0000,,Хмм, майдандағы жағдай қандай?
Dialogue: 0,0:16:01.96,0:16:06.30,Default,,0000,0000,0000,,Менің ойымша, біз кешіктірілген шайқастамыз.
Dialogue: 0,0:16:01.96,0:16:06.30,Default,,0000,0000,0000,,Құрлықтық армиядан қолдау күту.
Dialogue: 0,0:16:06.30,0:16:11.47,Default,,0000,0000,0000,,Жақсы ұстап тұрса да
Dialogue: 0,0:16:06.30,0:16:11.47,Default,,0000,0000,0000,,Әскери күштің тапшылығын жоққа шығаруға болмайды ма?
Dialogue: 0,0:16:11.47,0:16:13.47,Default,,0000,0000,0000,,Сіз қалай көмектесе аласыз?
Dialogue: 0,0:16:13.47,0:16:15.47,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:16:15.47,0:16:20.65,Default,,0000,0000,0000,,Егер сіз шекара аймағына оралсаңыз
Dialogue: 0,0:16:15.47,0:16:20.65,Default,,0000,0000,0000,,Біз жаудың негізгі алдыңғы шебін бұзып өтуіміз керек.
Dialogue: 0,0:16:20.65,0:16:25.48,Default,,0000,0000,0000,,Осы тұста жеңілдеп алайық.
Dialogue: 0,0:16:20.65,0:16:25.48,Default,,0000,0000,0000,,Бұл айналма маневр ме? Мақсат -...
Dialogue: 0,0:16:25.48,0:16:29.82,Default,,0000,0000,0000,,Астананы өртеп жібереміз. Бұл стратегиялық ауытқу.
Dialogue: 0,0:16:29.82,0:16:33.66,Default,,0000,0000,0000,,Капитал?
Dialogue: 0,0:16:29.82,0:16:33.66,Default,,0000,0000,0000,,Бұл Дакиа емес, солай ма?
Dialogue: 0,0:16:33.66,0:16:37.50,Default,,0000,0000,0000,,Хахаха... Капитан әзілге де шебер.
Dialogue: 0,0:16:37.50,0:16:41.17,Default,,0000,0000,0000,,Коммидің әуе шабуылына қарсы қорғаныс қабілетінің жоқтығы
Dialogue: 0,0:16:37.50,0:16:41.17,Default,,0000,0000,0000,,Ол оригамимен бірге келеді.
Dialogue: 0,0:16:41.17,0:16:45.00,Default,,0000,0000,0000,,Қызыл алаңға жеке Cessna көлігімен қонуға болады
Dialogue: 0,0:16:41.17,0:16:45.00,Default,,0000,0000,0000,,Мен кепілдік беремін.
Dialogue: 0,0:16:45.00,0:16:47.01,Default,,0000,0000,0000,,Cessna?
Dialogue: 0,0:16:45.00,0:16:47.01,Default,,0000,0000,0000,,Қызыл алаң?
Dialogue: 0,0:16:47.01,0:16:50.01,Default,,0000,0000,0000,,А, уайымдама.
Dialogue: 0,0:16:47.01,0:16:50.01,Default,,0000,0000,0000,,Бірақ олардың әуе қорғанысы, т.б.➡
Dialogue: 0,0:16:50.01,0:16:53.68,Default,,0000,0000,0000,,Тіпті жасөспірімдер
Dialogue: 0,0:16:50.01,0:16:53.68,Default,,0000,0000,0000,,Біз бұзып өтетінімізге сенімдімін.
Dialogue: 0,0:16:53.68,0:16:56.35,Default,,0000,0000,0000,,Сонда сіз байсалдысыз ба?
Dialogue: 0,0:16:53.68,0:16:56.35,Default,,0000,0000,0000,,Әрине.
Dialogue: 0,0:16:56.35,0:17:00.12,Default,,0000,0000,0000,,Себебі, бұл бұрыс
Dialogue: 0,0:16:56.35,0:17:00.12,Default,,0000,0000,0000,,Жаудың астанасын байыппен көздеу.
Dialogue: 0,0:17:00.12,0:17:05.79,Default,,0000,0000,0000,,Өз еліңізден сұраңыз.
Dialogue: 0,0:17:00.12,0:17:05.79,Default,,0000,0000,0000,,Саяси ойларды растаңыз.
Dialogue: 0,0:17:05.79,0:17:07.79,Default,,0000,0000,0000,,Түсінікті!
Dialogue: 0,0:17:07.79,0:17:12.30,Default,,0000,0000,0000,,《Тірі қалу және өзін-өзі сақтау
Dialogue: 0,0:17:07.79,0:17:12.30,Default,,0000,0000,0000,,және Комиді қудалау.
Dialogue: 0,0:17:12.30,0:17:16.14,Default,,0000,0000,0000,,Бір оқпен үш құсты өлтіру керемет идея.
Dialogue: 0,0:17:16.14,0:17:21.14,Default,,0000,0000,0000,,Өте жақсы, өте бақытты》
Dialogue: 0,0:17:21.14,0:17:24.84,Default,,0000,0000,0000,,Мен өз елімнің рұқсатын күте алмаймын.
Dialogue: 0,0:17:26.81,0:17:28.98,Default,,0000,0000,0000,,Тіпті Федерация соғысқа қатысуда!
Dialogue: 0,0:17:26.81,0:17:28.98,Default,,0000,0000,0000,,Жағдай қалай?
Dialogue: 0,0:17:28.98,0:17:32.99,Default,,0000,0000,0000,,Штабтың барлау ұшақтарын көбірек жіберіңіз!
Dialogue: 0,0:17:28.98,0:17:32.99,Default,,0000,0000,0000,,Барлық орталық күштерді шығысқа бөліңіз.
Dialogue: 0,0:17:32.99,0:17:35.99,Default,,0000,0000,0000,,Шегіну реті қандай?
Dialogue: 0,0:17:32.99,0:17:35.99,Default,,0000,0000,0000,,Соңғы күзетшіні басқаруда ақау бар!
Dialogue: 0,0:17:35.99,0:17:37.99,Default,,0000,0000,0000,,Стратегиялық резервтердің жұмылдыру жағдайы!
Dialogue: 0,0:17:35.99,0:17:37.99,Default,,0000,0000,0000,,Алмаздың бұзылуы!
Dialogue: 0,0:17:37.99,0:17:39.99,Default,,0000,0000,0000,,Мырзалар.
2-3-ші әуе сиқырлы батальонының
Dialogue: 0,0:17:39.99,0:17:45.16,Default,,0000,0000,0000,,○
Dialogue: 0,0:17:39.99,0:17:45.16,Default,,0000,0000,0000,,Майор Таня фон Дегуречафтан➡
Dialogue: 0,0:17:45.16,0:17:48.07,Default,,0000,0000,0000,,Мен апелляцияны талқылағым келеді.
Dialogue: 0,0:17:51.84,0:17:55.04,Default,,0000,0000,0000,,Сіздің пікіріңіз қандай?
Dialogue: 0,0:17:51.84,0:17:55.04,Default,,0000,0000,0000,,Полковник Лерген.
Dialogue: 0,0:17:57.51,0:18:02.11,Default,,0000,0000,0000,,Астанаға тікелей соққы Аудару ретінде тамаша.
Dialogue: 0,0:18:02.11,0:18:04.62,Default,,0000,0000,0000,,Байқауға тұрарлық па?
Dialogue: 0,0:18:04.62,0:18:06.62,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:18:04.62,0:18:06.62,Default,,0000,0000,0000,,Сіз байсалдысыз ба?
Dialogue: 0,0:18:06.62,0:18:09.62,Default,,0000,0000,0000,,Сіз қалжыңдаған болуыңыз керек.
Dialogue: 0,0:18:09.62,0:18:14.29,Default,,0000,0000,0000,,Шабуыл жасау әрекеті кезінде
Dialogue: 0,0:18:09.62,0:18:14.29,Default,,0000,0000,0000,,Белгілі бір мағынада оны табыс деп атауға болады.
Dialogue: 0,0:18:14.29,0:18:18.46,Default,,0000,0000,0000,,Федералдық тараптағы сақтыққа байланысты
Dialogue: 0,0:18:14.29,0:18:18.46,Default,,0000,0000,0000,,Егер сіз күштеріңізді тылға бөлсеңіз➡
Dialogue: 0,0:18:18.46,0:18:22.30,Default,,0000,0000,0000,,Негізгі майдандағы қысымды жеңілдету
Dialogue: 0,0:18:18.46,0:18:22.30,Default,,0000,0000,0000,,Оны күтуге болады.
Dialogue: 0,0:18:22.30,0:18:25.30,Default,,0000,0000,0000,,Айтуға оңай, бірақ...
Dialogue: 0,0:18:22.30,0:18:25.30,Default,,0000,0000,0000,,Шындығында тырысу мүмкін емес.
Dialogue: 0,0:18:25.30,0:18:27.81,Default,,0000,0000,0000,,Бұл фронт офицерлерінің экстремалды авантюризмі болуы керек.
Dialogue: 0,0:18:27.81,0:18:30.64,Default,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:18:27.81,0:18:30.64,Default,,0000,0000,0000,,Қарауға орын жоқ.
Dialogue: 0,0:18:30.64,0:18:35.31,Default,,0000,0000,0000,,Ойланып көріңізші.
Dialogue: 0,0:18:30.64,0:18:35.31,Default,,0000,0000,0000,,Бұл Дегуречаф.
Dialogue: 0,0:18:35.31,0:18:39.15,Default,,0000,0000,0000,,Degurechaff?
Dialogue: 0,0:18:35.31,0:18:39.15,Default,,0000,0000,0000,,Сізде күміс медаль бар ма?
Dialogue: 0,0:18:39.15,0:18:42.15,Default,,0000,0000,0000,,Майор - қабілетті соғыс жүргізуші.
Dialogue: 0,0:18:42.15,0:18:46.16,Default,,0000,0000,0000,,Аңшы ит ретінде
Dialogue: 0,0:18:42.15,0:18:46.16,Default,,0000,0000,0000,,Ол сонымен қатар ең жоғары лауазымды дала офицері.
Dialogue: 0,0:18:46.16,0:18:51.33,Default,,0000,0000,0000,,Дакиядағы астанаға бұрынғы шабуылдар
Dialogue: 0,0:18:46.16,0:18:51.33,Default,,0000,0000,0000,,Рейн майданындағы бас кесу операциясы.
Dialogue: 0,0:18:51.33,0:18:54.17,Default,,0000,0000,0000,,Тіпті оңтүстікте
Dialogue: 0,0:18:51.33,0:18:54.17,Default,,0000,0000,0000,,Жаудың жойылған штабы.
Dialogue: 0,0:18:54.17,0:18:59.17,Default,,0000,0000,0000,,Бұл осындай тәжірибесі бар біреудің есебі.
Dialogue: 0,0:18:54.17,0:18:59.17,Default,,0000,0000,0000,,Жетістік жеткілікті.
Dialogue: 0,0:18:59.17,0:19:03.78,Default,,0000,0000,0000,,Саясат рұқсат бере ме, жоқ па деген мәселе.
Dialogue: 0,0:18:59.17,0:19:03.78,Default,,0000,0000,0000,,Растаңыз.
Dialogue: 0,0:19:03.78,0:19:08.61,Default,,0000,0000,0000,,Бұл үлкен сенім.
Dialogue: 0,0:19:03.78,0:19:08.61,Default,,0000,0000,0000,,Әлі де қабылданбайды.
Dialogue: 0,0:19:08.61,0:19:12.28,Default,,0000,0000,0000,,Жаудың астанасы болса да!
Dialogue: 0,0:19:08.61,0:19:12.28,Default,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:19:12.28,0:19:14.29,Default,,0000,0000,0000,,Полковниктің үміті қате болуы мүмкін бе?
Dialogue: 0,0:19:14.29,0:19:19.79,Default,,0000,0000,0000,,Оны сол жерде қалдырыңыз.
Dialogue: 0,0:19:14.29,0:19:19.79,Default,,0000,0000,0000,,Жүз пікірталастың ләззат алуына шамамыз келмейді.
Dialogue: 0,0:19:19.79,0:19:24.13,Default,,0000,0000,0000,,Шынында да
Dialogue: 0,0:19:19.79,0:19:24.13,Default,,0000,0000,0000,,Одан әрі уақытты босқа өткізу.
Dialogue: 0,0:19:24.13,0:19:27.13,Default,,0000,0000,0000,,Мен рұқсат берілуі мүмкін деп есептеймін.
Dialogue: 0,0:19:27.13,0:19:29.47,Default,,0000,0000,0000,,Жоғары мәртебелі!
Dialogue: 0,0:19:27.13,0:19:29.47,Default,,0000,0000,0000,,Сіз байсалдысыз ба?
Dialogue: 0,0:19:29.47,0:19:31.47,Default,,0000,0000,0000,,Бұл тым абайсызда емес пе?
Dialogue: 0,0:19:31.47,0:19:34.31,Default,,0000,0000,0000,,Сәттілік болса
Dialogue: 0,0:19:31.47,0:19:34.31,Default,,0000,0000,0000,,Оларға мұны істеуге рұқсат етіңіз.
Dialogue: 0,0:19:34.31,0:19:39.31,Default,,0000,0000,0000,,Сәтті рейд
Dialogue: 0,0:19:34.31,0:19:39.31,Default,,0000,0000,0000,,Сіз құнды бөтелкеңізді қадаңыз делік.
Dialogue: 0,0:19:48.65,0:19:52.99,Default,,0000,0000,0000,,«Аяулы ана мен әже.
Dialogue: 0,0:19:52.99,0:19:55.33,Default,,0000,0000,0000,,Сіздің денеңізде қандай да бір өзгеріс бар ма?
Dialogue: 0,0:19:55.33,0:20:01.83,Default,,0000,0000,0000,,Мен қазір жіберілген ерікті күш ретінде қызмет етемін.
Dialogue: 0,0:19:55.33,0:20:01.83,Default,,0000,0000,0000,,Мен белгілі бір бөлімге қатысамын.
Dialogue: 0,0:20:01.83,0:20:04.84,Default,,0000,0000,0000,,Әскери жарғыларға сәйкес
Dialogue: 0,0:20:01.83,0:20:04.84,Default,,0000,0000,0000,,Толық жаза алмаймын, бірақ ➡
Dialogue: 0,0:20:04.84,0:20:07.01,Default,,0000,0000,0000,,Мен жақсымын.
Dialogue: 0,0:20:07.01,0:20:09.84,Default,,0000,0000,0000,,Ақыры мылтықпен жұмыс істей алады
Dialogue: 0,0:20:07.01,0:20:09.84,Default,,0000,0000,0000,,Мен үйреніп бара жатырмын➡
Dialogue: 0,0:20:09.84,0:20:13.51,Default,,0000,0000,0000,,Мен де жолдас деп атайтын достар таптым.
Dialogue: 0,0:20:13.51,0:20:19.18,Default,,0000,0000,0000,,Бірақ шынымды айтсам, бұл жай ғана сан.
Dialogue: 0,0:20:13.51,0:20:19.18,Default,,0000,0000,0000,,Тек дәмі нашар тағам...
Dialogue: 0,0:20:19.18,0:20:23.36,Default,,0000,0000,0000,,Әжемен пісірілген
Dialogue: 0,0:20:19.18,0:20:23.36,Default,,0000,0000,0000,,Мен пирогты сағындым.
Dialogue: 0,0:20:23.36,0:20:27.69,Default,,0000,0000,0000,,Біраз уақыттан бері
Dialogue: 0,0:20:23.36,0:20:27.69,Default,,0000,0000,0000,,Мен бұл туралы тек армандайтыным сонша...
Dialogue: 0,0:20:27.69,0:20:30.86,Default,,0000,0000,0000,,Осындай әлсіз дыбыс шығарғаны үшін кешіріңіз.
Dialogue: 0,0:20:30.86,0:20:35.37,Default,,0000,0000,0000,,Ерте әке сияқты
Dialogue: 0,0:20:30.86,0:20:35.37,Default,,0000,0000,0000,,Мен жақсы жауынгер болуым керек.
Dialogue: 0,0:20:35.37,0:20:38.70,Default,,0000,0000,0000,,Құдайдың әділдігін орындау.
Dialogue: 0,0:20:38.70,0:20:42.71,Default,,0000,0000,0000,,Дүниенің жауы Империяны жою.
Dialogue: 0,0:20:42.71,0:20:47.11,Default,,0000,0000,0000,,Біз әлі де аянбай еңбек етеміз
Dialogue: 0,0:20:42.71,0:20:47.11,Default,,0000,0000,0000,,Әскери қызметте бар күшімді саламын».
Dialogue: 0,0:20:51.22,0:20:54.72,Default,,0000,0000,0000,,«P.S. Компанияға қосылғанда➡
Dialogue: 0,0:20:54.72,0:20:57.22,Default,,0000,0000,0000,,Біраз күрделі нәрсе
Dialogue: 0,0:20:54.72,0:20:57.22,Default,,0000,0000,0000,,Мен жасадым➡
Dialogue: 0,0:20:57.22,0:21:00.83,Default,,0000,0000,0000,,Солдат ретінде
Dialogue: 0,0:20:57.22,0:21:00.83,Default,,0000,0000,0000,,Өз көзқарасыңызды көрсету.
Dialogue: 0,0:21:00.83,0:21:03.00,Default,,0000,0000,0000,,Уайымдамаңыз.''
Dialogue: 0,0:21:03.00,0:21:06.00,Default,,0000,0000,0000,,Қарашы, Мэри, Мәскеуге жақындап қалдық.
Dialogue: 0,0:21:06.00,0:21:08.33,Default,,0000,0000,0000,,Не? Бұл уақыт әлдеқашан ба?
Dialogue: 0,0:21:08.33,0:21:10.34,Default,,0000,0000,0000,,Ой, жоқ!
Dialogue: 0,0:21:31.02,0:21:33.86,Default,,0000,0000,0000,,Бұл басталды, Уильям.
Dialogue: 0,0:21:33.86,0:21:36.86,Default,,0000,0000,0000,,Бірлескен соғысушыларға қош келдіңіздер.
Dialogue: 0,0:21:36.86,0:21:41.37,Default,,0000,0000,0000,,Біраз болды, ағай.
Dialogue: 0,0:21:41.37,0:21:43.37,Default,,0000,0000,0000,,Мәскеу ше?
Dialogue: 0,0:21:43.37,0:21:48.21,Default,,0000,0000,0000,,Жаңа достармен тамаша серіктестік
Dialogue: 0,0:21:43.37,0:21:48.21,Default,,0000,0000,0000,,Көңілді отырсың ба?
Dialogue: 0,0:21:48.21,0:21:51.88,Default,,0000,0000,0000,,Жауымның жауы – досым.
Dialogue: 0,0:21:51.88,0:21:56.38,Default,,0000,0000,0000,,Отандық саясаткерлер атынан
Dialogue: 0,0:21:51.88,0:21:56.38,Default,,0000,0000,0000,,Біз иық тіресіп тұрмыз.
Dialogue: 0,0:21:56.38,0:22:00.49,Default,,0000,0000,0000,,Бұл өте көңілсіз.
Dialogue: 0,0:22:00.49,0:22:02.49,Default,,0000,0000,0000,,Бұл Мәскеу ме?
Dialogue: 0,0:22:02.49,0:22:05.99,Default,,0000,0000,0000,,Әй, суық!
Dialogue: 0,0:22:02.49,0:22:05.99,Default,,0000,0000,0000,,Тағам жақсы ма?
Dialogue: 0,0:22:05.99,0:22:09.16,Default,,0000,0000,0000,,Бұл сізсіз
Dialogue: 0,0:22:05.99,0:22:09.16,Default,,0000,0000,0000,,Сіз керемет серік емессіз бе?
Dialogue: 0,0:22:09.16,0:22:12.50,Default,,0000,0000,0000,,Көпұлтты күштерді ашуға саяхат
Dialogue: 0,0:22:09.16,0:22:12.50,Default,,0000,0000,0000,,Дегенмен—
Dialogue: 0,0:22:12.50,0:22:14.60,Default,,0000,0000,0000,,Сөзсіз.
Dialogue: 0,0:22:20.17,0:22:24.51,Default,,0000,0000,0000,,42-ші ұшу дивизиясы
Dialogue: 0,0:22:20.17,0:22:24.51,Default,,0000,0000,0000,,Барлық мүшелер қауіпсіз.
Dialogue: 0,0:22:24.51,0:22:27.11,Default,,0000,0000,0000,,Әзірге... бірақ.
Dialogue: 0,0:22:29.35,0:22:32.85,Default,,0000,0000,0000,,Жалпы, әрқашан жоғарыда
Dialogue: 0,0:22:29.35,0:22:32.85,Default,,0000,0000,0000,,Тек идеялар жетелейді.
Dialogue: 0,0:22:32.85,0:22:38.19,Default,,0000,0000,0000,,Адамзаттың прогресті және әмбебаптығын бейнелейтін
Dialogue: 0,0:22:32.85,0:22:38.19,Default,,0000,0000,0000,,Бұл сахналық қойылым болды ма?
Dialogue: 0,0:22:38.19,0:22:43.03,Default,,0000,0000,0000,,Иә, «Бұл империя деп аталады.
Dialogue: 0,0:22:38.19,0:22:43.03,Default,,0000,0000,0000,,Бір зұлымдыққа қарсы тұру➡
Dialogue: 0,0:22:43.03,0:22:48.53,Default,,0000,0000,0000,,Бүкіл әлемде кемпірқосақ сияқты
Dialogue: 0,0:22:43.03,0:22:48.53,Default,,0000,0000,0000,,``Көпұлтты бірлік'' тақырыбымен.
Dialogue: 0,0:22:48.53,0:22:52.04,Default,,0000,0000,0000,,Бұл саясаткерлерге ұнайды.
Dialogue: 0,0:22:52.04,0:22:54.21,Default,,0000,0000,0000,,Көріп отырғаныңыздай, бұл тамаша жасақ.
Dialogue: 0,0:22:54.21,0:22:58.04,Default,,0000,0000,0000,,Егер бірдеңе болса, командирді ауыстырыңыз.
Dialogue: 0,0:22:54.21,0:22:58.04,Default,,0000,0000,0000,,Мен оны алғым келеді.
Dialogue: 0,0:22:58.04,0:23:01.48,Default,,0000,0000,0000,,Қасқырмен қол алысу ұят болар.
Dialogue: 0,0:23:01.48,0:23:06.32,Default,,0000,0000,0000,,Бірақ қойды жетектеп
Dialogue: 0,0:23:01.48,0:23:06.32,Default,,0000,0000,0000,,Арыстандармен соғысқаннан жақсы.
Dialogue: 0,0:23:06.32,0:23:09.15,Default,,0000,0000,0000,,Қойшы, сенің жоспарың қандай?
Dialogue: 0,0:23:09.15,0:23:11.49,Default,,0000,0000,0000,,Дүние – сахна.
Dialogue: 0,0:23:11.49,0:23:15.29,Default,,0000,0000,0000,,Барлығына арналған нәрсе
Dialogue: 0,0:23:11.49,0:23:15.29,Default,,0000,0000,0000,,рөл атқаруы керек.
Dialogue: 0,0:23:18.33,0:23:21.83,Default,,0000,0000,0000,,Бірақ бұл мен болуы шарт емес.
Dialogue: 0,0:23:24.34,0:23:26.67,Default,,0000,0000,0000,,Сіз айтқандай.
Dialogue: 0,0:23:26.67,0:23:30.01,Default,,0000,0000,0000,,Соңғы кеңес➡
Dialogue: 0,0:23:30.01,0:23:33.68,Default,,0000,0000,0000,,Федерация өз сиқыршысы.
Dialogue: 0,0:23:30.01,0:23:33.68,Default,,0000,0000,0000,,Барлығы тазартылды.
Dialogue: 0,0:23:33.68,0:23:37.02,Default,,0000,0000,0000,,Барлығын Лагелиге жібереді.
Dialogue: 0,0:23:37.02,0:23:40.52,Default,,0000,0000,0000,,Сыбыс шындыққа айналды.
Dialogue: 0,0:23:40.52,0:23:42.69,Default,,0000,0000,0000,,Шикари Шикари.
Dialogue: 0,0:23:42.69,0:23:46.59,Default,,0000,0000,0000,,Коммунистер сиқыршылар деп аталады.
Dialogue: 0,0:23:42.69,0:23:46.59,Default,,0000,0000,0000,,Бөтен заттар танылмайтын сияқты.
Dialogue: 0,0:23:48.86,0:23:54.07,Default,,0000,0000,0000,,Жоқ, шынымен.
Dialogue: 0,0:23:48.86,0:23:54.07,Default,,0000,0000,0000,,Жақсы бірлескен соғысушы.
Dialogue: 0,0:23:57.54,0:24:01.31,Default,,0000,0000,0000,,Мырзалар, бұдан былай
Dialogue: 0,0:23:57.54,0:24:01.31,Default,,0000,0000,0000,,Федералдық мекемеге ауыстыру.
Dialogue: 0,0:24:01.31,0:24:03.98,Default,,0000,0000,0000,,Бұл одақтастардан өзгеше.
Dialogue: 0,0:24:03.98,0:24:06.48,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:24:03.98,0:24:06.48,Default,,0000,0000,0000,,Өз іс-әрекеттеріңізде абай болыңыз.
Dialogue: 0,0:24:06.48,0:24:08.48,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:24:12.48,0:24:15.49,Default,,0000,0000,0000,,Жоғарыда айтылған
Dialogue: 0,0:24:12.48,0:24:15.49,Default,,0000,0000,0000,,Бұл даладан алынған есеп.
Dialogue: 0,0:24:17.99,0:24:20.49,Default,,0000,0000,0000,,Бас хатшы жолдас, ескертпелер.
Dialogue: 0,0:24:20.49,0:24:23.33,Default,,0000,0000,0000,,Рұқсат етілген.
Dialogue: 0,0:24:23.33,0:24:28.67,Default,,0000,0000,0000,,Алғы шептен репортаж Сізге көп рахмет.
Dialogue: 0,0:24:28.67,0:24:32.00,Default,,0000,0000,0000,,Бұл жақсы жаңалық әкелді.
Dialogue: 0,0:24:28.67,0:24:32.00,Default,,0000,0000,0000,,Николай жолдасқа➡
Dialogue: 0,0:24:32.00,0:24:34.34,Default,,0000,0000,0000,,Мен мәңгілік ризамын.
Dialogue: 0,0:24:34.34,0:24:36.34,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:24:36.34,0:24:40.35,Default,,0000,0000,0000,,Соғыстың басталуы туралы
Dialogue: 0,0:24:36.34,0:24:40.35,Default,,0000,0000,0000,,Император әскері күтіп тұрды➡
Dialogue: 0,0:24:40.35,0:24:44.85,Default,,0000,0000,0000,,қабылданбайды.
Dialogue: 0,0:24:40.35,0:24:44.85,Default,,0000,0000,0000,,Неліктен? жолдас.
Dialogue: 0,0:24:44.85,0:24:47.52,Default,,0000,0000,0000,,Уф, маған.
Dialogue: 0,0:24:44.85,0:24:47.52,Default,,0000,0000,0000,,Менде түсінік жоқ...
Dialogue: 0,0:24:47.52,0:24:51.02,Default,,0000,0000,0000,,О, бір-екі.
Dialogue: 0,0:24:47.52,0:24:51.02,Default,,0000,0000,0000,,Біреу бар ма?
Dialogue: 0,0:24:51.02,0:24:53.02,Default,,0000,0000,0000,,Өйткені, Николай жолдас➡
Dialogue: 0,0:24:53.02,0:24:56.70,Default,,0000,0000,0000,,Император елшісі залы
Dialogue: 0,0:24:53.02,0:24:56.70,Default,,0000,0000,0000,,Олар жақсы дос болған көрінеді.
Dialogue: 0,0:24:56.70,0:25:00.97,Default,,0000,0000,0000,,Империалист дегеніміз не?
Dialogue: 0,0:24:56.70,0:25:00.97,Default,,0000,0000,0000,,Бұл жай ғана қарым-қатынас.
Dialogue: 0,0:25:00.97,0:25:06.97,Default,,0000,0000,0000,,Шамамен бір апта бұрын
Dialogue: 0,0:25:00.97,0:25:06.97,Default,,0000,0000,0000,,Достығыңда кішіпейілсің бе?
Dialogue: 0,0:25:06.97,0:25:11.14,Default,,0000,0000,0000,,Мен алған 20 жастағы шарап болды
Dialogue: 0,0:25:06.97,0:25:11.14,Default,,0000,0000,0000,,Бұл дәмді болды ма?
Dialogue: 0,0:25:11.14,0:25:13.14,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:25:13.14,0:25:16.82,Default,,0000,0000,0000,,Бас хатшы жолдас, бұл бір жер.
Dialogue: 0,0:25:13.14,0:25:16.82,Default,,0000,0000,0000,,Жолдасыңа толық айтып бер➡
Dialogue: 0,0:25:16.82,0:25:20.15,Default,,0000,0000,0000,,Не сұрау керек
Dialogue: 0,0:25:16.82,0:25:20.15,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:25:20.15,0:25:22.15,Default,,0000,0000,0000,,Рұқсат етілген.
Dialogue: 0,0:25:25.66,0:25:28.99,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:25:25.66,0:25:28.99,Default,,0000,0000,0000,,Мені тыңда!
Dialogue: 0,0:25:28.99,0:25:32.66,Default,,0000,0000,0000,,Барлығын түсіндіруге болады!
Dialogue: 0,0:25:28.99,0:25:32.66,Default,,0000,0000,0000,,Империяның жігіттері кімдер?
Dialogue: 0,0:25:32.66,0:25:35.50,Default,,0000,0000,0000,,Эй, жібер!
Dialogue: 0,0:25:35.50,0:25:41.31,Default,,0000,0000,0000,,Жолдастар
Dialogue: 0,0:25:35.50,0:25:41.31,Default,,0000,0000,0000,,Мен одан әрі қызмет пен жанқиярлықты күтемін.
Dialogue: 0,0:25:49.85,0:25:53.35,Default,,0000,0000,0000,,Бұл шынымен де қала арқылы өтіп жатыр ма?
Dialogue: 0,0:25:53.35,0:25:56.52,Default,,0000,0000,0000,,Әй, кәдімгі қалаға саяхат.
Dialogue: 0,0:25:56.52,0:26:01.13,Default,,0000,0000,0000,,Мен үшін де аз
Dialogue: 0,0:25:56.52,0:26:01.13,Default,,0000,0000,0000,,Маған үзіліс керек.
Dialogue: 0,0:26:07.30,0:26:10.14,Default,,0000,0000,0000,,О, бұл туралы не деуге болады?
Dialogue: 0,0:26:10.14,0:26:14.47,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:26:14.47,0:26:17.64,Default,,0000,0000,0000,,А, бұл біраз оғаш.
Dialogue: 0,0:26:17.64,0:26:20.31,Default,,0000,0000,0000,,Қандай ұят.
Dialogue: 0,0:26:20.31,0:26:23.98,Default,,0000,0000,0000,,Егер сәл ертерек болса
Dialogue: 0,0:26:20.31,0:26:23.98,Default,,0000,0000,0000,,Жеуге дайын болды.
Dialogue: 0,0:26:23.98,0:26:26.65,Default,,0000,0000,0000,,А? Сіз қандай ақымақсыз?
Dialogue: 0,0:26:26.65,0:26:28.65,Default,,0000,0000,0000,,Бұл ұшуға тыйым салынған аймақ.
Dialogue: 0,0:26:28.65,0:26:30.99,Default,,0000,0000,0000,,Бұл көп ұлтты ерікті армия ма?
Dialogue: 0,0:26:30.99,0:26:34.16,Default,,0000,0000,0000,,Сондықтан сиқыршыларға сенуге болмайды.
Dialogue: 0,0:26:34.16,0:26:36.16,Default,,0000,0000,0000,,Күткендей, мұндай реакцияшыл адамдар➡
Dialogue: 0,0:26:36.16,0:26:39.50,Default,,0000,0000,0000,,Олардың барлығын концлагерьге жіберіңіз.
Dialogue: 0,0:26:36.16,0:26:39.50,Default,,0000,0000,0000,,Бұл дұрыс жауап болды….
Dialogue: 0,0:26:39.50,0:26:42.50,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:26:42.50,0:26:51.01,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:26:54.35,0:26:58.02,Default,,0000,0000,0000,,Мұнда 02 Мәскеу алаңы сәтті жойылды!
Dialogue: 0,0:26:58.02,0:27:00.79,Default,,0000,0000,0000,,Тіпті шіркін мүсіндер де жаншылады!
Dialogue: 0,0:27:00.79,0:27:03.79,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:27:15.63,0:27:18.47,Default,,0000,0000,0000,,03 Жыланның ұясын жарып жібердім.
Dialogue: 0,0:27:18.47,0:27:21.64,Default,,0000,0000,0000,,Құпия полиция
Dialogue: 0,0:27:18.47,0:27:21.64,Default,,0000,0000,0000,,Мен дүрбелеңдемін.
Dialogue: 0,0:27:21.64,0:27:26.14,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:27:29.48,0:27:34.82,Default,,0000,0000,0000,,Tchi Негізгі ену шабуылы үшін
Dialogue: 0,0:27:29.48,0:27:34.82,Default,,0000,0000,0000,,Тіпті броньды тесіп өтетін оқтар да жұмыс істемейді.
Dialogue: 0,0:27:34.82,0:27:38.66,Default,,0000,0000,0000,,Мұнда 04 Мақсат
Dialogue: 0,0:27:34.82,0:27:38.66,Default,,0000,0000,0000,,Шабуылдарды қабылдамайды.
Dialogue: 0,0:27:38.66,0:27:40.66,Default,,0000,0000,0000,,Бұл өте қиын.
Dialogue: 0,0:27:40.66,0:27:46.00,Default,,0000,0000,0000,,Бұл операцияның мақсаты - орташа мөлшердегі заттарды жою
Dialogue: 0,0:27:40.66,0:27:46.00,Default,,0000,0000,0000,,Оны қалыпты жағдайда күлдіріңіз.
Dialogue: 0,0:27:46.00,0:27:49.00,Default,,0000,0000,0000,,Әскерлерді жылжыту туралы алаңдамаңыз.
Dialogue: 0,0:27:49.00,0:27:51.17,Default,,0000,0000,0000,,📱Бірден түсіндім!
Dialogue: 0,0:27:51.17,0:27:55.17,Default,,0000,0000,0000,,📱Құрметті батальон, бәс тігу менде.
Dialogue: 0,0:27:55.17,0:27:58.68,Default,,0000,0000,0000,,📱Тіпті жасөспірім де бұзып өте алады
Dialogue: 0,0:27:55.17,0:27:58.68,Default,,0000,0000,0000,,Әуе қорғанысы желісін айттыңыз ба?
Dialogue: 0,0:27:58.68,0:28:01.61,Default,,0000,0000,0000,,Майор айтқандай болды.
Dialogue: 0,0:28:01.61,0:28:05.45,Default,,0000,0000,0000,,Фактілерді сыпайы түрде қабылдау жақсы.
Dialogue: 0,0:28:05.45,0:28:07.45,Default,,0000,0000,0000,,Бірақ мейірімділік болмайды.
Dialogue: 0,0:28:07.45,0:28:12.62,Default,,0000,0000,0000,,📱Барлығыңыз, қайтып келгеннен кейін 02 құнды бөтелкесін алыңыз.
Dialogue: 0,0:28:07.45,0:28:12.62,Default,,0000,0000,0000,,Оны құрғатыңыз.
Dialogue: 0,0:28:12.62,0:28:15.13,Default,,0000,0000,0000,,Бұл жағажайдан кейінгі ең үлкен миссия.
Dialogue: 0,0:28:15.13,0:28:18.13,Default,,0000,0000,0000,,Мен ішімдікпен айналысқанда мүлде шегінбеймін.
Dialogue: 0,0:28:18.13,0:28:20.80,Default,,0000,0000,0000,,Қарғыс атсын, сендерде ерлік бар!
Dialogue: 0,0:28:20.80,0:28:22.80,Default,,0000,0000,0000,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:28:20.80,0:28:22.80,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:28:22.80,0:28:24.80,Default,,0000,0000,0000,,Ләззат алыңыз!
Dialogue: 0,0:28:24.80,0:28:29.31,Default,,0000,0000,0000,,Мырзалар, асыға күтіңіздер.
Dialogue: 0,0:28:24.80,0:28:29.31,Default,,0000,0000,0000,,Жақсы, бірақ➡
Dialogue: 0,0:28:29.31,0:28:31.98,Default,,0000,0000,0000,,Еңбек демалыстан бұрын келеді.
Dialogue: 0,0:28:31.98,0:28:34.48,Default,,0000,0000,0000,,Рейдтеріңізді жалғастырыңыз.
Dialogue: 0,0:28:34.48,0:28:36.98,Default,,0000,0000,0000,,📱 (Барлығы) Түсінікті!
Dialogue: 0,0:28:36.98,0:28:39.28,Default,,0000,0000,0000,,Қазір….
Dialogue: 0,0:28:42.99,0:28:47.83,Default,,0000,0000,0000,,《Осы дүниеде
Dialogue: 0,0:28:42.99,0:28:47.83,Default,,0000,0000,0000,,Бұл аяқталды ма? 》
Dialogue: 0,0:28:47.83,0:28:52.66,Default,,0000,0000,0000,,Бірінші компания, біз
Dialogue: 0,0:28:47.83,0:28:52.66,Default,,0000,0000,0000,,Осы үлкен нәрсені жарып жібердік делік.
Dialogue: 0,0:28:52.66,0:28:56.50,Default,,0000,0000,0000,,Ол аяқтала салысымен
Dialogue: 0,0:28:52.66,0:28:56.50,Default,,0000,0000,0000,,Басқа мемлекеттік мекемелерге де рейд жасаңыз!
Dialogue: 0,0:28:56.50,0:29:00.44,Default,,0000,0000,0000,,Техниканың көрінісі Мақсат Бір кесек боқ!
Dialogue: 0,0:29:00.44,0:29:03.27,Default,,0000,0000,0000,,Мақсат Бір топ боқ!
Dialogue: 0,0:29:03.27,0:29:05.28,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:29:08.61,0:29:11.95,Default,,0000,0000,0000,,Мүмкін сен досыңды атқан шығарсың
Dialogue: 0,0:29:08.61,0:29:11.95,Default,,0000,0000,0000,,Ордер офицері Сью.
Dialogue: 0,0:29:11.95,0:29:14.62,Default,,0000,0000,0000,,Уф... Кешіріңіз.
Dialogue: 0,0:29:14.62,0:29:19.46,Default,,0000,0000,0000,,Түсіруден өте нашарсың, солай емес пе?
Dialogue: 0,0:29:14.62,0:29:19.46,Default,,0000,0000,0000,,Сиқыршының таланты ерекше болса да.
Dialogue: 0,0:29:19.46,0:29:22.29,Default,,0000,0000,0000,,Хаха шынымен.
Dialogue: 0,0:29:22.29,0:29:24.46,Default,,0000,0000,0000,,Басқаларға да солай болады!
Dialogue: 0,0:29:24.46,0:29:26.46,Default,,0000,0000,0000,,Мылтыққа көбірек үйреніңіз!
Dialogue: 0,0:29:26.46,0:29:28.80,Default,,0000,0000,0000,,Оны өз денеңнің бір бөлігіне айналдыр!
Dialogue: 0,0:29:26.46,0:29:28.80,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:29:28.80,0:29:31.97,Default,,0000,0000,0000,,Жарайды, атуды жалғастыр!
Dialogue: 0,0:29:28.80,0:29:31.97,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:29:31.97,0:29:35.14,Default,,0000,0000,0000,,Жабдықтың қатты жетіспеушілігі.
Dialogue: 0,0:29:35.14,0:29:38.31,Default,,0000,0000,0000,,Оқу оқ-дәрілерімен қамтамасыз ету де тым төмен.
Dialogue: 0,0:29:38.31,0:29:42.15,Default,,0000,0000,0000,,Мен шағым түсіргім келеді.
Dialogue: 0,0:29:38.31,0:29:42.15,Default,,0000,0000,0000,,Партияға айтыңыз.
Dialogue: 0,0:29:42.15,0:29:46.15,Default,,0000,0000,0000,,Ал, кешке сәлем.
Dialogue: 0,0:29:46.15,0:29:49.99,Default,,0000,0000,0000,,(Дабыл)
Dialogue: 0,0:29:49.99,0:29:53.09,Default,,0000,0000,0000,,Жау шабуылы! Жау шабуылы!
Dialogue: 0,0:30:00.50,0:30:03.60,Default,,0000,0000,0000,,Не...?
Dialogue: 0,0:30:20.35,0:30:24.69,Default,,0000,0000,0000,,Мақтанатын халық сарайы
Dialogue: 0,0:30:20.35,0:30:24.69,Default,,0000,0000,0000,,Бұл таңқаларлық нәзік болды.
Dialogue: 0,0:30:24.69,0:30:27.36,Default,,0000,0000,0000,,Кенеттен құрылыс жұмыстарын жүргізу мүмкін болмады ма?
Dialogue: 0,0:30:27.36,0:30:30.86,Default,,0000,0000,0000,,Бетонды бөлуге арналған
Dialogue: 0,0:30:27.36,0:30:30.86,Default,,0000,0000,0000,,Бір жақтылық болған сияқты.
Dialogue: 0,0:30:35.87,0:30:38.37,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:30:41.71,0:30:44.54,Default,,0000,0000,0000,,Хамф, сендер біліксіз комитеттер.
Dialogue: 0,0:30:44.54,0:30:47.21,Default,,0000,0000,0000,,Биіктік параметрі бомбаға қарсы ұшақтарға арналған.
Dialogue: 0,0:30:47.21,0:30:50.88,Default,,0000,0000,0000,,Мақсаты да нашар.
Dialogue: 0,0:30:47.21,0:30:50.88,Default,,0000,0000,0000,,Сіз қорғаныс позицияларына шабуыл жасайсыз ба?
Dialogue: 0,0:30:50.88,0:30:54.05,Default,,0000,0000,0000,,Қанша шіркін болса да, негіз – негіз.
Dialogue: 0,0:30:54.05,0:30:57.22,Default,,0000,0000,0000,,Қажетсіз зиян келтіру деген нені білдіреді?
Dialogue: 0,0:30:54.05,0:30:57.22,Default,,0000,0000,0000,,Менің ойыма ештеңе келмейді.
Dialogue: 0,0:30:57.22,0:30:59.39,Default,,0000,0000,0000,,Кешіріңіз, мен жай ғана...
Dialogue: 0,0:30:59.39,0:31:02.66,Default,,0000,0000,0000,,Айтпақшы, лейтенант
Dialogue: 0,0:30:59.39,0:31:02.66,Default,,0000,0000,0000,,Сіз жеке себепсіз➡
Dialogue: 0,0:31:02.66,0:31:06.00,Default,,0000,0000,0000,,Комиге бір нәрсе кірді.
Dialogue: 0,0:31:02.66,0:31:06.00,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:31:06.00,0:31:09.17,Default,,0000,0000,0000,,Мен сіздің өміріңіздің кейбірін білемін.
Dialogue: 0,0:31:09.17,0:31:11.17,Default,,0000,0000,0000,,Бұл менің бала кезімнен өткен оқиға.
Dialogue: 0,0:31:11.17,0:31:15.51,Default,,0000,0000,0000,,Иә, сізге де бір.
Dialogue: 0,0:31:11.17,0:31:15.51,Default,,0000,0000,0000,,Шығармашылықпен айналысайық.
Dialogue: 0,0:31:15.51,0:31:19.51,Default,,0000,0000,0000,,Жермен таныс болсаң
Dialogue: 0,0:31:15.51,0:31:19.51,Default,,0000,0000,0000,,Мен туристік ақпаратты сұрағым келеді.
Dialogue: 0,0:31:21.51,0:31:23.51,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:31:21.51,0:31:23.51,Default,,0000,0000,0000,,Рейд?
Dialogue: 0,0:31:23.51,0:31:27.69,Default,,0000,0000,0000,,Не? Қазіргі шабуыл қандай?
Dialogue: 0,0:31:23.51,0:31:27.69,Default,,0000,0000,0000,,Бибі! Бибі! Сенімен бәрі жақсы ма?
Dialogue: 0,0:31:27.69,0:31:32.36,Default,,0000,0000,0000,,Бибі!
Dialogue: 0,0:31:27.69,0:31:32.36,Default,,0000,0000,0000,,Уф, иә, мені біраз қоқыс басып қалды.
Dialogue: 0,0:31:32.36,0:31:35.19,Default,,0000,0000,0000,,Бірақ қан! Тезірек емделіңіз!
Dialogue: 0,0:31:35.19,0:31:39.70,Default,,0000,0000,0000,,Мэри, сабыр етіңіз.
Dialogue: 0,0:31:39.70,0:31:43.20,Default,,0000,0000,0000,,Подполковник! Барлық қалада
Dialogue: 0,0:31:39.70,0:31:43.20,Default,,0000,0000,0000,,Сізге шабуыл жасалып жатқан сияқты.
Dialogue: 0,0:31:43.20,0:31:46.20,Default,,0000,0000,0000,,Император армиясы туралы не деуге болады?
Dialogue: 0,0:31:43.20,0:31:46.20,Default,,0000,0000,0000,,Империя….
Dialogue: 0,0:31:46.20,0:31:49.21,Default,,0000,0000,0000,,Федералдық нысандар және т.б.
Dialogue: 0,0:31:46.20,0:31:49.21,Default,,0000,0000,0000,,Қарызға алмасам ғой.
Dialogue: 0,0:31:49.21,0:31:52.54,Default,,0000,0000,0000,,Біздің зиянымыз қандай?
Dialogue: 0,0:31:49.21,0:31:52.54,Default,,0000,0000,0000,,Кейбіреулер жарақат алды.
Dialogue: 0,0:31:52.54,0:31:55.55,Default,,0000,0000,0000,,Қалғаны федерацияда.
Dialogue: 0,0:31:52.54,0:31:55.55,Default,,0000,0000,0000,,Жалғыз болғаны, төсегім сынып қалды.
Dialogue: 0,0:31:55.55,0:31:59.22,Default,,0000,0000,0000,,Топты жинаңыз.
Dialogue: 0,0:31:55.55,0:31:59.22,Default,,0000,0000,0000,,Әзірге барлық мүшелерді жинаңыз.
Dialogue: 0,0:31:59.22,0:32:01.42,Default,,0000,0000,0000,,Жедел жауап күту режимі.
Dialogue: 0,0:32:08.33,0:32:10.53,Default,,0000,0000,0000,,Мэри!
Dialogue: 0,0:32:14.33,0:32:16.67,Default,,0000,0000,0000,,Ордер Сью, сіз не істеп жатырсыз?
Dialogue: 0,0:32:16.67,0:32:19.00,Default,,0000,0000,0000,,Біз олардың іс-әрекеттерін назардан тыс қалдыра алмаймыз.
Dialogue: 0,0:32:19.00,0:32:21.01,Default,,0000,0000,0000,,Кету.
Dialogue: 0,0:32:19.00,0:32:21.01,Default,,0000,0000,0000,,Қабылданбады!
Dialogue: 0,0:32:21.01,0:32:24.68,Default,,0000,0000,0000,,Постыңызға оралыңыз!
Dialogue: 0,0:32:21.01,0:32:24.68,Default,,0000,0000,0000,,Бірақ менің досым ренжіп қалды!
Dialogue: 0,0:32:24.68,0:32:27.51,Default,,0000,0000,0000,,Мен түсіндім, солай ма?
Dialogue: 0,0:32:24.68,0:32:27.51,Default,,0000,0000,0000,,Сонымен! ?
Dialogue: 0,0:32:27.51,0:32:32.02,Default,,0000,0000,0000,,Император армиясында әлі күнге дейін Федерациядан шыққан адамдар бар.
Dialogue: 0,0:32:27.51,0:32:32.02,Default,,0000,0000,0000,,Сізге шабуыл жасалған болуы мүмкін!
Dialogue: 0,0:32:32.02,0:32:34.02,Default,,0000,0000,0000,,Сонымен?
Dialogue: 0,0:32:34.02,0:32:36.52,Default,,0000,0000,0000,,Паратуралық талаптар
Dialogue: 0,0:32:34.02,0:32:36.52,Default,,0000,0000,0000,,Олар әртүрлі болса да➡
Dialogue: 0,0:32:36.52,0:32:42.03,Default,,0000,0000,0000,,Достық күштер соғысса, иық тірестір!
Dialogue: 0,0:32:36.52,0:32:42.03,Default,,0000,0000,0000,,Әскери адам деген осы емес пе? ?
Dialogue: 0,0:32:42.03,0:32:45.63,Default,,0000,0000,0000,,Солдаттар туралы айтатын болсақ
Dialogue: 0,0:32:42.03,0:32:45.63,Default,,0000,0000,0000,,Біріншіден, бұйрықтарды орындаңыз.
Dialogue: 0,0:32:50.70,0:32:53.54,Default,,0000,0000,0000,,🔊Ескерту Достастық азаматтары.
Dialogue: 0,0:32:53.54,0:32:56.21,Default,,0000,0000,0000,,Не? Бұл хабар!
Dialogue: 0,0:32:53.54,0:32:56.21,Default,,0000,0000,0000,,Император армиясына ұқсайды!
Dialogue: 0,0:32:56.21,0:32:59.38,Default,,0000,0000,0000,,Мен қайда қашуым керек? ?
Dialogue: 0,0:32:56.21,0:32:59.38,Default,,0000,0000,0000,,Орталықта барлығы қауіпті.
Dialogue: 0,0:32:59.38,0:33:01.65,Default,,0000,0000,0000,,Әзірше көп пәтерлі үй кешеніне жүгір!
Dialogue: 0,0:33:01.65,0:33:04.82,Default,,0000,0000,0000,,Не? Бұл ескерту!
Dialogue: 0,0:33:01.65,0:33:04.82,Default,,0000,0000,0000,,Хабар қайдан келеді?
Dialogue: 0,0:33:04.82,0:33:09.32,Default,,0000,0000,0000,,Білмеймін, бірақ Империя азамат болады.
Dialogue: 0,0:33:04.82,0:33:09.32,Default,,0000,0000,0000,,Ол саған осылай айтып тұрған сияқты.
Dialogue: 0,0:33:09.32,0:33:13.32,Default,,0000,0000,0000,,Император армиясының айтқанында не ақымақтық бар?
Dialogue: 0,0:33:09.32,0:33:13.32,Default,,0000,0000,0000,,Оған сене аласыз ба?
Dialogue: 0,0:33:13.32,0:33:15.33,Default,,0000,0000,0000,,Плазаны жауып тастаңыз!
Dialogue: 0,0:33:15.33,0:33:18.16,Default,,0000,0000,0000,,Сондай-ақ Император армиясында
Dialogue: 0,0:33:15.33,0:33:18.16,Default,,0000,0000,0000,,Сізге бомба түсуі мүмкін!
Dialogue: 0,0:33:18.16,0:33:20.16,Default,,0000,0000,0000,,Ха! Мен оны түсіндім!
Dialogue: 0,0:33:20.16,0:33:24.17,Default,,0000,0000,0000,,Ақымақ... Император армиясы?
Dialogue: 0,0:33:24.17,0:33:28.84,Default,,0000,0000,0000,,Неліктен бұл болып жатыр?
Dialogue: 0,0:33:28.84,0:34:35.67,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:34:35.67,0:34:39.68,Default,,0000,0000,0000,,Керемет….
Dialogue: 0,0:34:39.68,0:34:42.35,Default,,0000,0000,0000,,Қандай әдемі...
Dialogue: 0,0:34:42.35,0:34:44.52,Default,,0000,0000,0000,,Төзгісіз болу.
Dialogue: 0,0:34:44.52,0:34:46.68,Default,,0000,0000,0000,,Мен мұны қалаймын!
Dialogue: 0,0:34:46.68,0:34:50.19,Default,,0000,0000,0000,,Мен мұны қалаймын!
Dialogue: 0,0:34:50.19,0:34:52.59,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:34:55.19,0:34:57.20,Default,,0000,0000,0000,,Әзіл!
Dialogue: 0,0:34:57.20,0:34:59.20,Default,,0000,0000,0000,,Күте тұрыңыз, старшина Сью!
Dialogue: 0,0:35:02.47,0:35:05.97,Default,,0000,0000,0000,,Қарғыс атсын, ақымақ!
Dialogue: 0,0:35:05.97,0:35:08.47,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:35:29.16,0:35:31.83,Default,,0000,0000,0000,,Бұл менің жақсы көңіл-күйімді бұзды.
Dialogue: 0,0:35:31.83,0:35:34.33,Default,,0000,0000,0000,,Майор, жау көбейіп кетті!
Dialogue: 0,0:35:34.33,0:35:37.34,Default,,0000,0000,0000,,Артқы жақтан
Dialogue: 0,0:35:34.33,0:35:37.34,Default,,0000,0000,0000,,Екі компанияға арналған сиқырлы бірлік.
Dialogue: 0,0:35:37.34,0:35:40.51,Default,,0000,0000,0000,,Сіз шынымен қатысуға рұқсат алдыңыз ба?
Dialogue: 0,0:35:40.51,0:35:43.67,Default,,0000,0000,0000,,Иә, подполковник.
Dialogue: 0,0:35:40.51,0:35:43.67,Default,,0000,0000,0000,,Мейірімді ағаңыз арқылы!
Dialogue: 0,0:35:43.67,0:35:46.68,Default,,0000,0000,0000,,Сіз келген бойда
Dialogue: 0,0:35:43.67,0:35:46.68,Default,,0000,0000,0000,,Қиындыққа араласу...
Dialogue: 0,0:35:46.68,0:35:49.51,Default,,0000,0000,0000,,Қосымша жұмысты қосу.
Dialogue: 0,0:35:49.51,0:35:52.02,Default,,0000,0000,0000,,Не? Сол жылдамдық.
Dialogue: 0,0:35:52.02,0:35:54.19,Default,,0000,0000,0000,,Ол сиқырлы күшке толы ма?
Dialogue: 0,0:35:54.19,0:35:56.85,Default,,0000,0000,0000,,Мэридің жасырын сиқырлы күші әдеттен тыс.
Dialogue: 0,0:35:56.85,0:35:59.02,Default,,0000,0000,0000,,Жаңадан қабылданған адам болса да, ол ерекше болды.
Dialogue: 0,0:35:59.02,0:36:02.46,Default,,0000,0000,0000,,Сіз қабілетсіз жұмысшысыз ба? Бұл қиын.
Dialogue: 0,0:36:02.46,0:36:04.46,Default,,0000,0000,0000,,Қашықтықты сақтаңыз және қолдау көрсетіңіз.
Dialogue: 0,0:36:04.46,0:36:07.47,Default,,0000,0000,0000,,Тым қатты итермеңіз.
Dialogue: 0,0:36:04.46,0:36:07.47,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:36:33.16,0:36:36.83,Default,,0000,0000,0000,,Цк. Сіздің біліктілік деңгейіңіз үлкен дәрежеде.
Dialogue: 0,0:36:36.83,0:36:39.66,Default,,0000,0000,0000,,Майор-доно, олар федералды әскерлер емес сияқты.
Dialogue: 0,0:36:39.66,0:36:42.57,Default,,0000,0000,0000,,Не? Бұл Коммидің аспаны.
Dialogue: 0,0:36:44.50,0:36:47.34,Default,,0000,0000,0000,,Қатар мен құрал-жабдықтарға қарап
Dialogue: 0,0:36:44.50,0:36:47.34,Default,,0000,0000,0000,,Бұл көп ұлтты күш пе?
Dialogue: 0,0:36:47.34,0:36:50.84,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:36:47.34,0:36:50.84,Default,,0000,0000,0000,,Қосымша күшейткіштер келуі мүмкін.
Dialogue: 0,0:36:50.84,0:36:52.84,Default,,0000,0000,0000,,Тиісті уақытта кетіңіз.
Dialogue: 0,0:36:58.85,0:37:01.45,Default,,0000,0000,0000,,Фил! Кит!
Dialogue: 0,0:37:01.45,0:37:03.45,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:37:06.12,0:37:08.13,Default,,0000,0000,0000,,Оқ жоқ!
Dialogue: 0,0:37:10.96,0:37:14.13,Default,,0000,0000,0000,,Маған күш бере гөр, Алла!
Dialogue: 0,0:37:14.13,0:37:17.97,Default,,0000,0000,0000,,Бейбітшілік үшін, әділдік үшін!
Dialogue: 0,0:37:17.97,0:37:22.57,Default,,0000,0000,0000,,Бұл жағымсыз.
Dialogue: 0,0:37:17.97,0:37:22.57,Default,,0000,0000,0000,,Қашан есіме түскен сияқты!
Dialogue: 0,0:37:31.98,0:37:36.99,Default,,0000,0000,0000,,Артында жас әйел?
Dialogue: 0,0:37:31.98,0:37:36.99,Default,,0000,0000,0000,,Дегенмен, олар бірдей көрінеді.
Dialogue: 0,0:37:49.83,0:37:53.34,Default,,0000,0000,0000,,А, бұл...
Dialogue: 0,0:37:53.34,0:38:07.12,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:38:07.12,0:38:09.32,Default,,0000,0000,0000,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:38:28.31,0:38:32.64,Default,,0000,0000,0000,,Майор, қазір жақсы уақыт па?
Dialogue: 0,0:38:28.31,0:38:32.64,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:38:32.64,0:38:35.31,Default,,0000,0000,0000,,Майор!
Dialogue: 0,0:38:35.31,0:38:38.98,Default,,0000,0000,0000,,А... бәрің кетіңдер.
Dialogue: 0,0:38:38.98,0:38:41.15,Default,,0000,0000,0000,,Кездесу орнына асығыңыз.
Dialogue: 0,0:38:41.15,0:38:43.85,Default,,0000,0000,0000,,Түсінікті!
Dialogue: 0,0:38:56.67,0:38:59.84,Default,,0000,0000,0000,,Мэри Мэри!
Dialogue: 0,0:38:56.67,0:38:59.84,Default,,0000,0000,0000,,Ордер Сью, сіз мені тыңдай аласыз ба?
Dialogue: 0,0:38:59.84,0:39:02.77,Default,,0000,0000,0000,,Мықты болыңыз, старшина Сью!
Dialogue: 0,0:39:02.77,0:39:04.94,Default,,0000,0000,0000,,Оның санасы бар сияқты.
Dialogue: 0,0:39:02.77,0:39:04.94,Default,,0000,0000,0000,,Бұл ауыр ма?
Dialogue: 0,0:39:04.94,0:39:08.28,Default,,0000,0000,0000,,Оны тез артқа апарыңыз.
Dialogue: 0,0:39:04.94,0:39:08.28,Default,,0000,0000,0000,,Мэри фирмасы.
Dialogue: 0,0:39:08.28,0:39:10.61,Default,,0000,0000,0000,,Сау болыңыз!
Dialogue: 0,0:39:10.61,0:39:13.28,Default,,0000,0000,0000,,《Мылтықпен атылғандар ауырады.
Dialogue: 0,0:39:13.28,0:39:17.62,Default,,0000,0000,0000,,Әкемнің мылтығы көбірек ауырады.
Dialogue: 0,0:39:17.62,0:39:21.46,Default,,0000,0000,0000,,Менің әкем мейірімді еді.
Dialogue: 0,0:39:21.46,0:39:25.13,Default,,0000,0000,0000,,Ол менің әкемнің досы.
Dialogue: 0,0:39:25.13,0:39:29.30,Default,,0000,0000,0000,,Мен ол шайтанды кешірмеймін.
Dialogue: 0,0:39:29.30,0:39:32.30,Default,,0000,0000,0000,,Құдай Құдай….
Dialogue: 0,0:39:32.30,0:39:36.51,Default,,0000,0000,0000,,Маған күш берші...》
Dialogue: 0,0:39:40.98,0:39:43.81,Default,,0000,0000,0000,,Қосымша мәселе! Қосымша!
Dialogue: 0,0:39:43.81,0:39:47.82,Default,,0000,0000,0000,,Жау елге туған жердің туын қағып!
Dialogue: 0,0:39:47.82,0:39:49.82,Default,,0000,0000,0000,,Барлық қызыл жалауларды өртеп жіберді!
Dialogue: 0,0:39:49.82,0:39:53.32,Default,,0000,0000,0000,,Құпия полиция да жойылды.
Dialogue: 0,0:39:49.82,0:39:53.32,Default,,0000,0000,0000,,Тіпті деректі фильм де түсірді.
Dialogue: 0,0:39:53.32,0:39:55.66,Default,,0000,0000,0000,,«Олар көз жасына сенбейді».
Dialogue: 0,0:39:55.66,0:39:59.66,Default,,0000,0000,0000,,Федералдық максиманың ирониясы?
Dialogue: 0,0:39:59.66,0:40:02.00,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:40:02.00,0:40:05.00,Default,,0000,0000,0000,,Бұл қалай болды...?
Dialogue: 0,0:40:05.00,0:40:09.01,Default,,0000,0000,0000,,Ең көп астанаға дейін
Dialogue: 0,0:40:05.00,0:40:09.01,Default,,0000,0000,0000,,Мен бұл жай ғана мәжбүрлеу мәселесі деп ойладым.
Dialogue: 0,0:40:09.01,0:40:14.01,Default,,0000,0000,0000,,Мен оны Федерацияның саяси символы болады деп күтпедім.
Dialogue: 0,0:40:09.01,0:40:14.01,Default,,0000,0000,0000,,Толығымен ұсақталған.
Dialogue: 0,0:40:14.01,0:40:18.12,Default,,0000,0000,0000,,Императорлық туды көтеру
Dialogue: 0,0:40:14.01,0:40:18.12,Default,,0000,0000,0000,,Олар тіпті мемлекеттік әнұранды орындайды.
Dialogue: 0,0:40:22.02,0:40:24.12,Default,,0000,0000,0000,,Бұл тым көп.
Dialogue: 0,0:40:26.69,0:40:31.86,Default,,0000,0000,0000,,Тек стратегиялық ауытқу мақсатында
Dialogue: 0,0:40:26.69,0:40:31.86,Default,,0000,0000,0000,,Толық орындалғанымен.
Dialogue: 0,0:40:31.86,0:40:38.54,Default,,0000,0000,0000,,Полковник, сіз де майор Дегуречафтың күшін сезіне аласыз.
Dialogue: 0,0:40:31.86,0:40:38.54,Default,,0000,0000,0000,,Мен оны тым төмен бағалаған сияқтымын.
Dialogue: 0,0:40:38.54,0:40:42.37,Default,,0000,0000,0000,,Нақты
Dialogue: 0,0:40:38.54,0:40:42.37,Default,,0000,0000,0000,,Бұл диверсиялық операция ретінде тамаша болар еді.
Dialogue: 0,0:40:42.37,0:40:45.88,Default,,0000,0000,0000,,Тарихи жетістік деп қоғамдық пікір де толқып отыр.
Dialogue: 0,0:40:47.88,0:40:51.55,Default,,0000,0000,0000,,Мәселе саясаткерлерде...
Dialogue: 0,0:40:51.55,0:40:56.05,Default,,0000,0000,0000,,Сіз оларға есеп айырысу ұсынысымен жақындауға тырыссаңыз да
Dialogue: 0,0:40:51.55,0:40:56.05,Default,,0000,0000,0000,,Әзірше мүмкін емес.
Dialogue: 0,0:40:56.05,0:41:00.49,Default,,0000,0000,0000,,Екінші жақтың беті
Dialogue: 0,0:40:56.05,0:41:00.49,Default,,0000,0000,0000,,Ол толығымен жаншылды.
Dialogue: 0,0:41:00.49,0:41:05.50,Default,,0000,0000,0000,,Федерация да көңілсіз.
Dialogue: 0,0:41:00.49,0:41:05.50,Default,,0000,0000,0000,,Мен олардың шабуыл жасайтынына сенімдімін.
Dialogue: 0,0:41:05.50,0:41:09.80,Default,,0000,0000,0000,,Жедел даму жоспары
Dialogue: 0,0:41:05.50,0:41:09.80,Default,,0000,0000,0000,,Маған жаттығу керек шығар.
Dialogue: 0,0:41:12.67,0:41:14.84,Default,,0000,0000,0000,,《Degurechaff….
Dialogue: 0,0:41:14.84,0:41:19.14,Default,,0000,0000,0000,,Мен қайтып келген бойда
Dialogue: 0,0:41:14.84,0:41:19.14,Default,,0000,0000,0000,,Мен оны қамап қоямын! 》
Dialogue: 0,0:41:23.85,0:41:25.85,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:41:25.85,0:41:29.02,Default,,0000,0000,0000,,Қанша рет!
Dialogue: 0,0:41:25.85,0:41:29.02,Default,,0000,0000,0000,,Қалағаныңызша тост жасай аласыз!
Dialogue: 0,0:41:29.02,0:41:31.02,Default,,0000,0000,0000,,Іш, іш!
Dialogue: 0,0:41:31.02,0:41:33.86,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:41:31.02,0:41:33.86,Default,,0000,0000,0000,,Мен астанаға жасалған шабуылдан шошып кеттім.
Dialogue: 0,0:41:33.86,0:41:36.86,Default,,0000,0000,0000,,Күтілгендей
Dialogue: 0,0:41:33.86,0:41:36.86,Default,,0000,0000,0000,,Бас штаб мақтан тұтатын элиталық бөлімше.
Dialogue: 0,0:41:36.86,0:41:39.86,Default,,0000,0000,0000,,Коммунистер де пішінсіз.
Dialogue: 0,0:41:47.71,0:41:52.21,Default,,0000,0000,0000,,Капитан, уәде
Dialogue: 0,0:41:47.71,0:41:52.21,Default,,0000,0000,0000,,Есіңде ме?
Dialogue: 0,0:41:52.21,0:41:55.88,Default,,0000,0000,0000,,Фактілерді шыншылдықпен мойындау жақсы.
Dialogue: 0,0:41:55.88,0:41:57.88,Default,,0000,0000,0000,,Бірақ мейірімділік болмайды.
Dialogue: 0,0:41:57.88,0:42:02.19,Default,,0000,0000,0000,,Қайтып келгеннен кейін, 02 құнды бөтелке
Dialogue: 0,0:41:57.88,0:42:02.19,Default,,0000,0000,0000,,Оны құрғатыңыз.
Dialogue: 0,0:42:05.82,0:42:08.99,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:42:05.82,0:42:08.99,Default,,0000,0000,0000,,Бұл мен күткеннен де көп орындалды!
Dialogue: 0,0:42:08.99,0:42:11.66,Default,,0000,0000,0000,,Сіз оңтүстік сувенирлерін сатып алдыңыз ба?
Dialogue: 0,0:42:11.66,0:42:14.37,Default,,0000,0000,0000,,Маған да капитан ұнайды, солай емес пе?
Dialogue: 0,0:42:16.67,0:42:21.01,Default,,0000,0000,0000,,Кешіріңіз, бірақ сіз сияқты жаман емес!
Dialogue: 0,0:42:21.01,0:42:23.17,Default,,0000,0000,0000,,Қандай азап…
Dialogue: 0,0:42:23.17,0:42:25.18,Default,,0000,0000,0000,,«Ах!» деген не?
Dialogue: 0,0:42:25.18,0:42:29.01,Default,,0000,0000,0000,,Бұл мен үшін болса керек!
Dialogue: 0,0:42:29.01,0:42:32.35,Default,,0000,0000,0000,,Жылдам қарқын!
Dialogue: 0,0:42:29.01,0:42:32.35,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:42:32.35,0:42:35.35,Default,,0000,0000,0000,,Бұл қиын нәрсе.
Dialogue: 0,0:42:37.69,0:42:43.19,Default,,0000,0000,0000,,《Ішімдік әрқашан
Dialogue: 0,0:42:37.69,0:42:43.19,Default,,0000,0000,0000,,Бұл белгілі бір әсер еткен сияқты...》
Dialogue: 0,0:42:47.53,0:42:49.70,Default,,0000,0000,0000,,《Қиын》
Dialogue: 0,0:42:49.70,0:42:51.70,Default,,0000,0000,0000,,Майор!
Dialogue: 0,0:42:49.70,0:42:51.70,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:42:51.70,0:42:56.54,Default,,0000,0000,0000,,Десерт алғыңыз келе ме? Бұл жеміс соққысы.
Dialogue: 0,0:42:56.54,0:42:59.04,Default,,0000,0000,0000,,О? Лейтенант.
Dialogue: 0,0:42:59.04,0:43:01.48,Default,,0000,0000,0000,,Майор-доноға арналған маринадталған батыс ликері?
Dialogue: 0,0:43:01.48,0:43:04.32,Default,,0000,0000,0000,,Жоқ! Мүмкін емес!
Dialogue: 0,0:43:04.32,0:43:06.82,Default,,0000,0000,0000,,Құрамында алкоголь жоқ!
Dialogue: 0,0:43:06.82,0:43:09.65,Default,,0000,0000,0000,,Бұл тәттілендірілген ерекше нұсқа.
Dialogue: 0,0:43:09.65,0:43:12.49,Default,,0000,0000,0000,,Хмф, маскүнемдер.
Dialogue: 0,0:43:12.49,0:43:15.49,Default,,0000,0000,0000,,Мен үшін алаңдама.
Dialogue: 0,0:43:15.49,0:43:19.50,Default,,0000,0000,0000,,24 сағат
Dialogue: 0,0:43:15.49,0:43:19.50,Default,,0000,0000,0000,,Бұл ешқашан жазылмайтын ауру болуы керек.
Dialogue: 0,0:43:19.50,0:43:23.67,Default,,0000,0000,0000,,Егер сіз әскери қызметте болмасаңыз, мұны жасамаңыз.
Dialogue: 0,0:43:23.67,0:43:29.67,Default,,0000,0000,0000,,Сіздің әскери міндеттеріңізге кедергі келтірмейтін дәрежеде,
Dialogue: 0,0:43:23.67,0:43:29.67,Default,,0000,0000,0000,,Кем дегенде ілгекті алып тастаңыз.
Dialogue: 0,0:43:32.18,0:43:36.18,Default,,0000,0000,0000,,Әскери тәртіп тыныс алу сияқты.
Dialogue: 0,0:43:32.18,0:43:36.18,Default,,0000,0000,0000,,Майор...
Dialogue: 0,0:43:36.18,0:43:39.35,Default,,0000,0000,0000,,Ол тәртіпті ұстанатын жын.
Dialogue: 0,0:43:36.18,0:43:39.35,Default,,0000,0000,0000,,Майор...
Dialogue: 0,0:43:39.35,0:43:43.35,Default,,0000,0000,0000,,Бізге қарсы….
Dialogue: 0,0:43:39.35,0:43:43.35,Default,,0000,0000,0000,,«Оны шешіп ал» дегенді қалай түсінесіңдер?
Dialogue: 0,0:43:43.35,0:43:46.52,Default,,0000,0000,0000,,Барлық мүшелер назарында!
Dialogue: 0,0:43:46.52,0:43:50.19,Default,,0000,0000,0000,,Біздің батальон командирі
Dialogue: 0,0:43:46.52,0:43:50.19,Default,,0000,0000,0000,,Мен ауруға байланысты кетуге мәжбүр болдым!
Dialogue: 0,0:43:50.19,0:43:52.20,Default,,0000,0000,0000,,Шынайы ма?
Dialogue: 0,0:43:50.19,0:43:52.20,Default,,0000,0000,0000,,Твит жазбаңыз!
Dialogue: 0,0:43:52.20,0:43:54.20,Default,,0000,0000,0000,,Сонымен!
Dialogue: 0,0:43:54.20,0:43:57.37,Default,,0000,0000,0000,,Майор Дегуречафтың сауығып кетуі үшін дұға ету➡
Dialogue: 0,0:43:57.37,0:43:59.37,Default,,0000,0000,0000,,Тағы да!
Dialogue: 0,0:43:59.37,0:44:01.87,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:44:17.49,0:44:20.09,Default,,0000,0000,0000,,《Бұл қиын》
Dialogue: 0,0:44:28.33,0:44:34.34,Default,,0000,0000,0000,,《Сол қаттылық
Dialogue: 0,0:44:28.33,0:44:34.34,Default,,0000,0000,0000,,Қалай қарасаң да, бұл қалыпты емес...》
Dialogue: 0,0:44:47.68,0:44:54.09,Default,,0000,0000,0000,,《Сол беріктік, сиқырлы күштің мөлшері күткендей...》
Dialogue: 0,0:44:56.86,0:45:00.86,Default,,0000,0000,0000,,Ақылсыз фанат.
Dialogue: 0,0:45:03.97,0:45:09.31,Default,,0000,0000,0000,,Бұл өте көп қалпына келтіру күші. Баяу.
Dialogue: 0,0:45:03.97,0:45:09.31,Default,,0000,0000,0000,,Мен сенен демалуыңды өтінетін болдым.
Dialogue: 0,0:45:09.31,0:45:12.98,Default,,0000,0000,0000,,Мен демала алмаймын.
Dialogue: 0,0:45:09.31,0:45:12.98,Default,,0000,0000,0000,,Сондай-ақ Федерация адамдары үшін➡
Dialogue: 0,0:45:12.98,0:45:15.81,Default,,0000,0000,0000,,Біз
Dialogue: 0,0:45:12.98,0:45:15.81,Default,,0000,0000,0000,,Мұнда болу себебін көрсетпесеңіз.
Dialogue: 0,0:45:15.81,0:45:18.98,Default,,0000,0000,0000,,Сізге
Dialogue: 0,0:45:15.81,0:45:18.98,Default,,0000,0000,0000,,Оны талқылауға өкілеттігі жоқ.
Dialogue: 0,0:45:18.98,0:45:22.99,Default,,0000,0000,0000,,Еріктілер әскері өте саяси мәселе.
Dialogue: 0,0:45:22.99,0:45:26.49,Default,,0000,0000,0000,,Дос астанаға шабуыл жасалды.
Dialogue: 0,0:45:26.49,0:45:28.99,Default,,0000,0000,0000,,Сен неге оларға көмектеспейсің?
Dialogue: 0,0:45:28.99,0:45:32.50,Default,,0000,0000,0000,,Мен тіпті астананы жақсы қорғай алмаймын.
Dialogue: 0,0:45:28.99,0:45:32.50,Default,,0000,0000,0000,,Бұл олардың кінәсі.
Dialogue: 0,0:45:32.50,0:45:36.50,Default,,0000,0000,0000,,Бұл біздің кінәміз емес.
Dialogue: 0,0:45:32.50,0:45:36.50,Default,,0000,0000,0000,,Қарап тұрған адам! ?
Dialogue: 0,0:45:36.50,0:45:40.50,Default,,0000,0000,0000,,Уф! біз
Dialogue: 0,0:45:36.50,0:45:40.50,Default,,0000,0000,0000,,Империя деп аталатын ортақ жау➡
Dialogue: 0,0:45:40.50,0:45:42.51,Default,,0000,0000,0000,,Біз оларды жою үшін жиналдық.
Dialogue: 0,0:45:42.51,0:45:46.51,Default,,0000,0000,0000,,Адамзат үшін, әлем үшін
Dialogue: 0,0:45:42.51,0:45:46.51,Default,,0000,0000,0000,,Барлығымыз күресуіміз керек!
Dialogue: 0,0:45:46.51,0:45:52.12,Default,,0000,0000,0000,,А... Оған дейін.
Dialogue: 0,0:45:46.51,0:45:52.12,Default,,0000,0000,0000,,Мені өлтіргің келе ме?
Dialogue: 0,0:45:54.85,0:45:57.52,Default,,0000,0000,0000,,Мен сенің тарихыңды білемін.
Dialogue: 0,0:45:57.52,0:46:02.29,Default,,0000,0000,0000,,Менің әкем император әскерімен шайқасқа қатысқан.
Dialogue: 0,0:45:57.52,0:46:02.29,Default,,0000,0000,0000,,Сіздің өміріңізден айырылғаныңызды естідім.
Dialogue: 0,0:46:02.29,0:46:05.30,Default,,0000,0000,0000,,Мен сенің жауыңды жек көруді түсінемін.
Dialogue: 0,0:46:05.30,0:46:10.63,Default,,0000,0000,0000,,Бірақ біз кісі өлтірушіміз
Dialogue: 0,0:46:05.30,0:46:10.63,Default,,0000,0000,0000,,Кек алушы жұмбақ емес.
Dialogue: 0,0:46:10.63,0:46:13.80,Default,,0000,0000,0000,,Ол әскери адам.
Dialogue: 0,0:46:13.80,0:46:17.81,Default,,0000,0000,0000,,Жеке сезіммен
Dialogue: 0,0:46:13.80,0:46:17.81,Default,,0000,0000,0000,,Біз соғысып жатқан жоқпыз.
Dialogue: 0,0:46:22.31,0:46:24.48,Default,,0000,0000,0000,,Мен ертең Мәскеуден кетемін.
Dialogue: 0,0:46:24.48,0:46:28.79,Default,,0000,0000,0000,,Егер сіз әскери адам болсаңыз
Dialogue: 0,0:46:24.48,0:46:28.79,Default,,0000,0000,0000,,Жауды жаумен шатастырмау.
Dialogue: 0,0:46:46.00,0:46:51.18,Default,,0000,0000,0000,,Империяда бір жын бар, оны жеңу керек...
Dialogue: 0,0:46:51.18,0:47:00.12,Default,,0000,0000,0000,,♬
Dialogue: 0,0:47:00.12,0:47:03.12,Default,,0000,0000,0000,,Ояныңдар, барлық мүшелер!
Dialogue: 0,0:47:06.12,0:47:08.29,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:47:08.29,0:47:11.80,Default,,0000,0000,0000,,Капитан Вайс Капитан Вайсс осында ма?
Dialogue: 0,0:47:11.80,0:47:14.30,Default,,0000,0000,0000,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің.
Dialogue: 0,0:47:11.80,0:47:14.30,Default,,0000,0000,0000,,Капитан Вайс➡
Dialogue: 0,0:47:14.30,0:47:16.63,Default,,0000,0000,0000,,Бас штабтан махаббат шақыруы.
Dialogue: 0,0:47:16.63,0:47:18.80,Default,,0000,0000,0000,,Батальонды жинаңыз!
Dialogue: 0,0:47:18.80,0:47:20.97,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:47:18.80,0:47:20.97,Default,,0000,0000,0000,,Жүгір!
Dialogue: 0,0:47:20.97,0:47:24.47,Default,,0000,0000,0000,,Брифинг аяқталған бойда оны өткізіңіз.
Dialogue: 0,0:47:26.48,0:47:30.81,Default,,0000,0000,0000,,Соғыс басталғаннан он күн өткен соң
Dialogue: 0,0:47:26.48,0:47:30.81,Default,,0000,0000,0000,,Шекарада қозғалыс көп.
Dialogue: 0,0:47:30.81,0:47:33.32,Default,,0000,0000,0000,,Жаудың қимылын қараңыз.
Dialogue: 0,0:47:36.32,0:47:38.32,Default,,0000,0000,0000,,Негізгі үш категория бар.
Dialogue: 0,0:47:38.32,0:47:40.99,Default,,0000,0000,0000,,А тобы солтүстікке бағыт алады.
Dialogue: 0,0:47:40.99,0:47:43.99,Default,,0000,0000,0000,,Империялық отан құру
Dialogue: 0,0:47:40.99,0:47:43.99,Default,,0000,0000,0000,,В тобы өз ұстанымдарын көрсетеді.
Dialogue: 0,0:47:43.99,0:47:49.00,Default,,0000,0000,0000,,Дакияға қарай жүріңіз
Dialogue: 0,0:47:43.99,0:47:49.00,Default,,0000,0000,0000,,Бұл енді ғана басталған С тобы.
Dialogue: 0,0:47:49.00,0:47:53.34,Default,,0000,0000,0000,,Орталық В тобы
Dialogue: 0,0:47:49.00,0:47:53.34,Default,,0000,0000,0000,,Жаудың негізгі күші болып саналса да➡
Dialogue: 0,0:47:53.34,0:47:55.67,Default,,0000,0000,0000,,Ақымақ адалдыққа қарсы заң жоқ.
Dialogue: 0,0:47:55.67,0:47:58.84,Default,,0000,0000,0000,,Бас штабтың штаб-пәтерінде солтүстіктен әрқайсысын жеңіңіз➡
Dialogue: 0,0:47:58.84,0:48:02.78,Default,,0000,0000,0000,,Кең ауқымды бір қанатты қоршау жоспарланған.
Dialogue: 0,0:48:02.78,0:48:07.45,Default,,0000,0000,0000,,Сонымен біздің рөліміз қандай?
Dialogue: 0,0:48:07.45,0:48:09.95,Default,,0000,0000,0000,,Жылжымалы партизандық соғыс тәртібі.
Dialogue: 0,0:48:09.95,0:48:13.62,Default,,0000,0000,0000,,Солтүстікке жіберілген орталық күштер
Dialogue: 0,0:48:09.95,0:48:13.62,Default,,0000,0000,0000,,Найзаның ұшы сеніп тапсырылған.
Dialogue: 0,0:48:13.62,0:48:17.46,Default,,0000,0000,0000,,Алайда жау В тобының
Dialogue: 0,0:48:13.62,0:48:17.46,Default,,0000,0000,0000,,Қысымды елемеу мүмкін емес.
Dialogue: 0,0:48:17.46,0:48:20.30,Default,,0000,0000,0000,,Сан стратегиясы қиын.
Dialogue: 0,0:48:20.30,0:48:25.14,Default,,0000,0000,0000,,Жаудың А тобын талқандауда
Dialogue: 0,0:48:20.30,0:48:25.14,Default,,0000,0000,0000,,Орталық шыдай ма?
Dialogue: 0,0:48:25.14,0:48:29.31,Default,,0000,0000,0000,,Капитан Вайс Есте сақтау керек нәрсе.
Dialogue: 0,0:48:29.31,0:48:32.11,Default,,0000,0000,0000,,Бұл номиналды құнынан гөрі мазмұны туралы.
Dialogue: 0,0:48:34.14,0:48:37.65,Default,,0000,0000,0000,,Коммунистер
Dialogue: 0,0:48:34.14,0:48:37.65,Default,,0000,0000,0000,,Партияның дұрыстығын болжайды.
Dialogue: 0,0:48:37.65,0:48:41.15,Default,,0000,0000,0000,,Саясат әскери парасаттылықтан басым болады.
Dialogue: 0,0:48:41.15,0:48:43.99,Default,,0000,0000,0000,,Егер сіз қарсылық көрсетсеңіз, сіз тазартыласыз.
Dialogue: 0,0:48:43.99,0:48:48.16,Default,,0000,0000,0000,,Бұл әскер ме?
Dialogue: 0,0:48:48.16,0:48:50.16,Default,,0000,0000,0000,,
Dialogue: 0,0:48:50.16,0:48:53.16,Default,,0000,0000,0000,,Қою.
Dialogue: 0,0:48:50.16,0:48:53.16,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:48:53.16,0:48:55.17,Default,,0000,0000,0000,,Бұл Шығыс армиясының шұғыл өтініші.
Dialogue: 0,0:48:55.17,0:48:57.33,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:48:57.33,0:49:02.94,Default,,0000,0000,0000,,Шегіну кезінде қолдаушы ретінде қызмет ету
Dialogue: 0,0:48:57.33,0:49:02.94,Default,,0000,0000,0000,,3-32-бөлім ➡
Dialogue: 0,0:49:02.94,0:49:05.94,Default,,0000,0000,0000,,Тигенхоф қаласы қоршауда.
Dialogue: 0,0:49:05.94,0:49:09.28,Default,,0000,0000,0000,,Шығыс армиясы туралы не деуге болады?
Dialogue: 0,0:49:05.94,0:49:09.28,Default,,0000,0000,0000,,Бұл олардың жұмысы болар еді.
Dialogue: 0,0:49:09.28,0:49:13.12,Default,,0000,0000,0000,,Алдыңғы шайқастардағы стратегиялық резервтер
Dialogue: 0,0:49:09.28,0:49:13.12,Default,,0000,0000,0000,,Ол тұтынылған сияқты.
Dialogue: 0,0:49:13.12,0:49:17.79,Default,,0000,0000,0000,,Сонымен, біз, тікелей Бас штабтың қолбасшылығында,
Dialogue: 0,0:49:13.12,0:49:17.79,Default,,0000,0000,0000,,Сол үшін жылап келдің бе?
Dialogue: 0,0:49:17.79,0:49:19.79,Default,,0000,0000,0000,,Қалалық соғыс дегеніміз не?
Dialogue: 0,0:49:19.79,0:49:23.46,Default,,0000,0000,0000,,Егер сіз жаудың қатты қоршауында болсаңыз
Dialogue: 0,0:49:19.79,0:49:23.46,Default,,0000,0000,0000,,Құтқару қиын емес пе?
Dialogue: 0,0:49:23.46,0:49:28.13,Default,,0000,0000,0000,,Сайттан түсірілген аэрофотосуреттерге келетін болсақ
Dialogue: 0,0:49:23.46,0:49:28.13,Default,,0000,0000,0000,,Жаудың ауыр артиллериясы көрінбейді.
Dialogue: 0,0:49:28.13,0:49:31.47,Default,,0000,0000,0000,,Бұл расталды
Dialogue: 0,0:49:28.13,0:49:31.47,Default,,0000,0000,0000,,Тек бірнеше жеңіл далалық зеңбіректер.
Dialogue: 0,0:49:31.47,0:49:34.81,Default,,0000,0000,0000,,Ауыр артиллерия үмітсіз
Dialogue: 0,0:49:31.47,0:49:34.81,Default,,0000,0000,0000,,Өйткені мен баяумын.
Dialogue: 0,0:49:34.81,0:49:38.31,Default,,0000,0000,0000,,Тасымалдау үшін уақыт қажет
Dialogue: 0,0:49:34.81,0:49:38.31,Default,,0000,0000,0000,,Бұл Федерацияға да қатысты.
Dialogue: 0,0:49:38.31,0:49:42.48,Default,,0000,0000,0000,,Бірақ шекарада
Dialogue: 0,0:49:38.31,0:49:42.48,Default,,0000,0000,0000,,Ұзын қашықтықтағы пойыздық мылтық➡
Dialogue: 0,0:49:42.48,0:49:45.82,Default,,0000,0000,0000,,Оны кеңейтуге де болады.
Dialogue: 0,0:49:42.48,0:49:45.82,Default,,0000,0000,0000,,Шынында да.
Dialogue: 0,0:49:45.82,0:49:49.32,Default,,0000,0000,0000,,Егер сол үлкен жігіт сізді нысанаға алса ше?
Dialogue: 0,0:49:45.82,0:49:49.32,Default,,0000,0000,0000,,Бұл мен жинаған нәрсе емес.
Dialogue: 0,0:49:49.32,0:49:51.32,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:49:51.32,0:49:54.99,Default,,0000,0000,0000,,Сен жаусың
Dialogue: 0,0:49:51.32,0:49:54.99,Default,,0000,0000,0000,,Бағаламау дұрыс.
Dialogue: 0,0:49:54.99,0:49:59.33,Default,,0000,0000,0000,,Бірақ пойыз мылтығы
Dialogue: 0,0:49:54.99,0:49:59.33,Default,,0000,0000,0000,,Бұл аса қауіпті емес.
Dialogue: 0,0:49:59.33,0:50:05.34,Default,,0000,0000,0000,,Федерацияға қарсы соғыста жаудың бақылаушы сиқыршысы
Dialogue: 0,0:49:59.33,0:50:05.34,Default,,0000,0000,0000,,Ешқашан расталмаған.
Dialogue: 0,0:50:05.34,0:50:09.34,Default,,0000,0000,0000,,Артынан жаяу әскер келсе де
Dialogue: 0,0:50:05.34,0:50:09.34,Default,,0000,0000,0000,,Жердегі бақылау қызметкері болған жерде➡
Dialogue: 0,0:50:09.34,0:50:12.34,Default,,0000,0000,0000,,Agile ынтымақтастық шынайы емес.
Dialogue: 0,0:50:12.34,0:50:16.51,Default,,0000,0000,0000,,Менен сұрасаңыз, бұл рас.
Dialogue: 0,0:50:12.34,0:50:16.51,Default,,0000,0000,0000,,сәйкес құтқару мүмкін.
Dialogue: 0,0:50:16.51,0:50:23.35,Default,,0000,0000,0000,,Бірақ қазірдің өзінде 203 батальон
Dialogue: 0,0:50:16.51,0:50:23.35,Default,,0000,0000,0000,,Бас штабтан бұйрықтар алынды.
Dialogue: 0,0:50:23.35,0:50:27.52,Default,,0000,0000,0000,,Біз тікелей Бас штабқа есеп береміз.
Dialogue: 0,0:50:27.52,0:50:31.03,Default,,0000,0000,0000,,《Ортада ұсталды ма?》
Dialogue: 0,0:50:31.03,0:50:36.20,Default,,0000,0000,0000,,Дегенмен, ішінара жеңсеңіз де
Dialogue: 0,0:50:31.03,0:50:36.20,Default,,0000,0000,0000,,Жалпы есепте жеңілудің еш мәні жоқ.
Dialogue: 0,0:50:36.20,0:50:38.70,Default,,0000,0000,0000,,Бұл Шығыс армиясына әділетсіздік болар еді➡
Dialogue: 0,0:50:38.70,0:50:42.54,Default,,0000,0000,0000,,Бүкіл армия үшін
Dialogue: 0,0:50:38.70,0:50:42.54,Default,,0000,0000,0000,,Партизандық соғысты таңдау керек деп ойлаймын.
Dialogue: 0,0:50:42.54,0:50:45.04,Default,,0000,0000,0000,,Кешіріңіз, бірақ менде басқа амал жоқ.
Dialogue: 0,0:50:45.04,0:50:47.71,Default,,0000,0000,0000,,Намаз оқумен қатар, Тигенхоф...
Dialogue: 0,0:50:47.71,0:50:49.91,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:50:53.72,0:50:56.55,Default,,0000,0000,0000,,Қалай болды, майор?
Dialogue: 0,0:50:56.55,0:50:59.22,Default,,0000,0000,0000,,Бұл қызықты позицияда.
Dialogue: 0,0:50:59.22,0:51:02.49,Default,,0000,0000,0000,,Лейтенант Серебряков Толық карта.
Dialogue: 0,0:51:02.49,0:51:06.10,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:51:02.49,0:51:06.10,Default,,0000,0000,0000,,Маған да маршрут картасын беріңізші.
Dialogue: 0,0:51:12.84,0:51:16.17,Default,,0000,0000,0000,,Тигенхоф жақсы жерде.
Dialogue: 0,0:51:16.17,0:51:20.34,Default,,0000,0000,0000,,Бас штабтың солтүстік операцияларында
Dialogue: 0,0:51:16.17,0:51:20.34,Default,,0000,0000,0000,,Маңызды сала деп айтуға болады.
Dialogue: 0,0:51:20.34,0:51:23.18,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:51:23.18,0:51:26.18,Default,,0000,0000,0000,,Аэрофотосуретте темір жол желісі де бүтін.
Dialogue: 0,0:51:26.18,0:51:28.35,Default,,0000,0000,0000,,Жылжымалы партизан соғысы үшін➡
Dialogue: 0,0:51:28.35,0:51:31.35,Default,,0000,0000,0000,,Әскери күштердің жоспарлы әрекеті
Dialogue: 0,0:51:28.35,0:51:31.35,Default,,0000,0000,0000,,Оны асыға күтуге болады.
Dialogue: 0,0:51:31.35,0:51:33.69,Default,,0000,0000,0000,,Өзен бойында оңай қорғануға болады➡
Dialogue: 0,0:51:33.69,0:51:36.53,Default,,0000,0000,0000,,Сондай-ақ шығыс шекарадан
Dialogue: 0,0:51:33.69,0:51:36.53,Default,,0000,0000,0000,,Біраз қашықтық бар.
Dialogue: 0,0:51:36.53,0:51:40.36,Default,,0000,0000,0000,,Жылжымалы соғыста
Dialogue: 0,0:51:36.53,0:51:40.36,Default,,0000,0000,0000,,Маңызды тасымалдау нүктелеріне қысым көрсетуге болады ма?
Dialogue: 0,0:51:40.36,0:51:42.87,Default,,0000,0000,0000,,Негіз ретінде тамаша.
Dialogue: 0,0:51:42.87,0:51:46.04,Default,,0000,0000,0000,,Өте жақсы.
Dialogue: 0,0:51:46.04,0:51:49.87,Default,,0000,0000,0000,,Тигенхофты құтқару – ең соңғы құтқару.
Dialogue: 0,0:51:49.87,0:51:54.38,Default,,0000,0000,0000,,Шығыс армиясы және Бас штабы
Dialogue: 0,0:51:49.87,0:51:54.38,Default,,0000,0000,0000,,Екі тілек те орындалуы мүмкін.
Dialogue: 0,0:51:54.38,0:51:57.71,Default,,0000,0000,0000,,Жасайық.
Dialogue: 0,0:51:54.38,0:51:57.71,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:51:57.71,0:52:01.65,Default,,0000,0000,0000,,Аа хаха Адамдарға көмектесу?
Dialogue: 0,0:52:01.65,0:52:06.66,Default,,0000,0000,0000,,Лейтенант Серебряков әскерлерге арналған медициналық құралдар
Dialogue: 0,0:52:01.65,0:52:06.66,Default,,0000,0000,0000,,Барынша алып жүріңіз.
Dialogue: 0,0:52:06.66,0:52:10.33,Default,,0000,0000,0000,,Түсінікті!
Dialogue: 0,0:52:06.66,0:52:10.33,Default,,0000,0000,0000,,Виски мен темекі болса жақсы болар еді➡
Dialogue: 0,0:52:10.33,0:52:13.00,Default,,0000,0000,0000,,Біз үшін де көп емес.
Dialogue: 0,0:52:10.33,0:52:13.00,Default,,0000,0000,0000,,Менің қолымда ештеңе жоқ.
Dialogue: 0,0:52:13.00,0:52:16.50,Default,,0000,0000,0000,,Майор
Dialogue: 0,0:52:13.00,0:52:16.50,Default,,0000,0000,0000,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:52:16.50,0:52:21.84,Default,,0000,0000,0000,,Негізі кешегі карта
Dialogue: 0,0:52:16.50,0:52:21.84,Default,,0000,0000,0000,,Мен оны Шығыс армиясынан алдым.
Dialogue: 0,0:52:21.84,0:52:25.18,Default,,0000,0000,0000,,Мен оны батальонның қазынасына қоямын деп ойлаймын.
Dialogue: 0,0:52:21.84,0:52:25.18,Default,,0000,0000,0000,,Мен солай ойладым➡
Dialogue: 0,0:52:25.18,0:52:27.34,Default,,0000,0000,0000,,Бұл достық күштерге де арналған.
Dialogue: 0,0:52:27.34,0:52:29.68,Default,,0000,0000,0000,,Бұл таң қалдырады, капитан Вайс.
Dialogue: 0,0:52:29.68,0:52:34.35,Default,,0000,0000,0000,,Офицер ретінде сіз сәл артықсыз
Dialogue: 0,0:52:29.68,0:52:34.35,Default,,0000,0000,0000,,Мен сізді орташа адам деп ойладым.
Dialogue: 0,0:52:34.35,0:52:38.52,Default,,0000,0000,0000,,Жоқ, оны айналдырған
Dialogue: 0,0:52:34.35,0:52:38.52,Default,,0000,0000,0000,,Бұл лейтенант Серебряков...
Dialogue: 0,0:52:38.52,0:52:40.52,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:52:40.52,0:52:43.53,Default,,0000,0000,0000,,Эхехе….
Dialogue: 0,0:52:49.53,0:52:52.37,Default,,0000,0000,0000,,Мен оны сұрадым!
Dialogue: 0,0:52:49.53,0:52:52.37,Default,,0000,0000,0000,,Мен достық күштерді жауапты қалдырдым!
Dialogue: 0,0:52:52.37,0:52:54.70,Default,,0000,0000,0000,,Тейгенхофты құтқару!
Dialogue: 0,0:52:54.70,0:53:22.33,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,0:53:22.33,0:53:25.50,Default,,0000,0000,0000,,Шулы
Dialogue: 0,0:53:22.33,0:53:25.50,Default,,0000,0000,0000,,Қайсар адамдар!
Dialogue: 0,0:53:25.50,0:53:28.17,Default,,0000,0000,0000,,Майор, біз шынымен қысқамыз!
Dialogue: 0,0:53:28.17,0:53:32.18,Default,,0000,0000,0000,,Солтүстік-шығыс бағыттағы қорғаныс желісі
Dialogue: 0,0:53:28.17,0:53:32.18,Default,,0000,0000,0000,,Шектер бар!
Dialogue: 0,0:53:32.18,0:53:35.85,Default,,0000,0000,0000,,Ақымақ
Dialogue: 0,0:53:32.18,0:53:35.85,Default,,0000,0000,0000,,Мен тіпті мысықтың қолын алғым келеді!
Dialogue: 0,0:53:35.85,0:53:38.35,Default,,0000,0000,0000,,Қазір лосось туралы
Dialogue: 0,0:53:35.85,0:53:38.35,Default,,0000,0000,0000,,Мен оны киемін.
Dialogue: 0,0:53:38.35,0:53:41.02,Default,,0000,0000,0000,,📱Tiegenhof Control компаниясынан
Dialogue: 0,0:53:38.35,0:53:41.02,Default,,0000,0000,0000,,49-шы бірлікке.
Dialogue: 0,0:53:41.02,0:53:43.35,Default,,0000,0000,0000,,📱Жақында
Dialogue: 0,0:53:41.02,0:53:43.35,Default,,0000,0000,0000,,Ол жерге қосымша күштер келеді.
Dialogue: 0,0:53:43.35,0:53:45.36,Default,,0000,0000,0000,,📱Маған ескертілді.
Dialogue: 0,0:53:52.53,0:53:55.63,Default,,0000,0000,0000,,Достық күштер! Келдің бе!
Dialogue: 0,0:54:02.47,0:54:05.31,Default,,0000,0000,0000,,Жердегі бомбалау Бос өрт!
Dialogue: 0,0:54:05.31,0:54:07.31,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:54:20.99,0:54:26.16,Default,,0000,0000,0000,,Үшінші бөлімге жатады
Dialogue: 0,0:54:20.99,0:54:26.16,Default,,0000,0000,0000,,Бұл 49-шы сиқырлы батальонның майоры Хофен.
Dialogue: 0,0:54:26.16,0:54:30.33,Default,,0000,0000,0000,,Тікелей Бас штабтың қарамағында
Dialogue: 0,0:54:26.16,0:54:30.33,Default,,0000,0000,0000,,2○3 Air Magic батальоны➡
Dialogue: 0,0:54:30.33,0:54:32.34,Default,,0000,0000,0000,,Бұл майор Дегуречаф.
Dialogue: 0,0:54:32.34,0:54:35.51,Default,,0000,0000,0000,,Кешігіп келгенім үшін кешіріңіз...
Dialogue: 0,0:54:35.51,0:54:37.67,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:54:37.67,0:54:41.18,Default,,0000,0000,0000,,Жоқ, жоқ... бәрібір
Dialogue: 0,0:54:37.67,0:54:41.18,Default,,0000,0000,0000,,Келгендеріңізге рахмет.
Dialogue: 0,0:54:41.18,0:54:44.85,Default,,0000,0000,0000,,Жаудың ауыр артиллериясының ілгері басуы алдында
Dialogue: 0,0:54:41.18,0:54:44.85,Default,,0000,0000,0000,,Мен өз өмірімді сақтап қалғандай сезінемін.
Dialogue: 0,0:54:44.85,0:54:47.52,Default,,0000,0000,0000,,Мен де солай.
Dialogue: 0,0:54:44.85,0:54:47.52,Default,,0000,0000,0000,,Уақытында келгеніңіз өте жақсы.
Dialogue: 0,0:54:47.52,0:54:50.82,Default,,0000,0000,0000,,Командалық орталық осында. Мен сізге айналаны көрсетуге рұқсат етіңіз.
Dialogue: 0,0:54:55.19,0:55:00.63,Default,,0000,0000,0000,,Біз штабтың қорғанысына жауаптымыз және
Dialogue: 0,0:54:55.19,0:55:00.63,Default,,0000,0000,0000,,Бұл қалған жауларды тексеру. Шенеуніктер ше?
Dialogue: 0,0:55:00.63,0:55:06.64,Default,,0000,0000,0000,,Біз Тигенхофты алға база ретінде қолданамыз.
Dialogue: 0,0:55:00.63,0:55:06.64,Default,,0000,0000,0000,,Бас штабтың жылжымалы партизандық соғыс туралы бұйрығы.
Dialogue: 0,0:55:06.64,0:55:10.47,Default,,0000,0000,0000,,Көбінесе дөрекі қолданылады.
Dialogue: 0,0:55:06.64,0:55:10.47,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:55:10.47,0:55:14.98,Default,,0000,0000,0000,,Егер сіздің командаңыздың біліктілік деңгейі мен бұрын көргендей болса,
Dialogue: 0,0:55:10.47,0:55:14.98,Default,,0000,0000,0000,,Бұл мағынасы бар.
Dialogue: 0,0:55:14.98,0:55:16.98,Default,,0000,0000,0000,,Бұл құрмет.
Dialogue: 0,0:55:16.98,0:55:20.82,Default,,0000,0000,0000,,Бірге жиналайық
Dialogue: 0,0:55:16.98,0:55:20.82,Default,,0000,0000,0000,,Мен ішімдік алғым келеді➡
Dialogue: 0,0:55:20.82,0:55:24.15,Default,,0000,0000,0000,,Бір күні сіздің қол астындағыларыңыз болады
Dialogue: 0,0:55:20.82,0:55:24.15,Default,,0000,0000,0000,,Мен сізді емдеуге рұқсат етіңіз.
Dialogue: 0,0:55:24.15,0:55:28.49,Default,,0000,0000,0000,,Болжам бойынша
Dialogue: 0,0:55:24.15,0:55:28.49,Default,,0000,0000,0000,,Менің қарамағымдағы қызметкер ішімдік ішеді.
Dialogue: 0,0:55:28.49,0:55:32.66,Default,,0000,0000,0000,,Мен майор Ховенді банкротқа ұшыратқым келмейді.
Dialogue: 0,0:55:28.49,0:55:32.66,Default,,0000,0000,0000,,Мен алаңдаймын.
Dialogue: 0,0:55:32.66,0:55:35.67,Default,,0000,0000,0000,,Хахахаха! Жақсы, міне келдік!
Dialogue: 0,0:55:35.67,0:55:38.84,Default,,0000,0000,0000,,Менің батальон офицерім
Dialogue: 0,0:55:35.67,0:55:38.84,Default,,0000,0000,0000,,Мен сені барлығына сыйлаймын!
Dialogue: 0,0:55:38.84,0:55:41.00,Default,,0000,0000,0000,,Қалағаныңызша ішіңіз!
Dialogue: 0,0:55:41.00,0:55:43.84,Default,,0000,0000,0000,,Қол астындағыларды қуантады.
Dialogue: 0,0:55:43.84,0:55:46.34,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:55:46.34,0:55:49.35,Default,,0000,0000,0000,,Міне, ұсақ шенеуніктерге.
Dialogue: 0,0:55:51.85,0:55:57.19,Default,,0000,0000,0000,,Майор! маған көмекке келгені үшін
Dialogue: 0,0:55:51.85,0:55:57.19,Default,,0000,0000,0000,,Сізді командир деп атайды, бірақ дәл қазір...
Dialogue: 0,0:55:57.19,0:56:01.79,Default,,0000,0000,0000,,Ах, Бас штабқа.
Dialogue: 0,0:55:57.19,0:56:01.79,Default,,0000,0000,0000,,Балалар офицері бар➡
Dialogue: 0,0:56:01.79,0:56:04.13,Default,,0000,0000,0000,,Өлеңдер рас сияқты.
Dialogue: 0,0:56:04.13,0:56:08.83,Default,,0000,0000,0000,,Сондай-ақ ұрыс даласындағы аңыздарда
Dialogue: 0,0:56:04.13,0:56:08.83,Default,,0000,0000,0000,,Мұның таңғаларлық ақиқаты бар.
Dialogue: 0,0:56:11.97,0:56:15.47,Default,,0000,0000,0000,,Генерал жолдас Жағдай қиын.
Dialogue: 0,0:56:15.47,0:56:18.48,Default,,0000,0000,0000,,Негізгі шабуылдаушы топ әрең
Dialogue: 0,0:56:15.47,0:56:18.48,Default,,0000,0000,0000,,Біз ілгерілеуді жалғастырамыз➡
Dialogue: 0,0:56:18.48,0:56:21.64,Default,,0000,0000,0000,,Ауыр артиллериялық кідіріс
Dialogue: 0,0:56:18.48,0:56:21.64,Default,,0000,0000,0000,,Бұл мәселе.
Dialogue: 0,0:56:21.64,0:56:27.15,Default,,0000,0000,0000,,Иә, жолдас, майданнан.
Dialogue: 0,0:56:21.64,0:56:27.15,Default,,0000,0000,0000,,Бұл қиын, бірақ қолайлы ауқымда.
Dialogue: 0,0:56:27.15,0:56:30.15,Default,,0000,0000,0000,,Ауыр артиллерия болса
Dialogue: 0,0:56:27.15,0:56:30.15,Default,,0000,0000,0000,,Менің ойымша, бұл құптарлық.
Dialogue: 0,0:56:30.15,0:56:33.99,Default,,0000,0000,0000,,Жолдастар, бәрі жақсы болып жатқан сияқты.
Dialogue: 0,0:56:33.99,0:56:37.99,Default,,0000,0000,0000,,Біздің армия
Dialogue: 0,0:56:33.99,0:56:37.99,Default,,0000,0000,0000,,басымдылықты сақтай отырып, алға жылжу.
Dialogue: 0,0:56:37.99,0:56:44.00,Default,,0000,0000,0000,,Ауыр артиллерияның келуін күтудің қажеті жоқ
Dialogue: 0,0:56:37.99,0:56:44.00,Default,,0000,0000,0000,,Стратегия дерлік шешілді.
Dialogue: 0,0:56:44.00,0:56:47.50,Default,,0000,0000,0000,,Жақсы жаңалық үшін рахмет.
Dialogue: 0,0:56:47.50,0:56:51.84,Default,,0000,0000,0000,,Бас хатшы жолдас
Dialogue: 0,0:56:47.50,0:56:51.84,Default,,0000,0000,0000,,Тағы бір жақсы жаңалық.
Dialogue: 0,0:56:51.84,0:56:53.84,Default,,0000,0000,0000,,Мәлімдеме жасаңыз.
Dialogue: 0,0:56:53.84,0:57:00.78,Default,,0000,0000,0000,,Иә. Қазіргі уақытта Тигенхофта
Dialogue: 0,0:56:53.84,0:57:00.78,Default,,0000,0000,0000,,Жау әскерлері қалса.
Dialogue: 0,0:57:00.78,0:57:03.12,Default,,0000,0000,0000,,Әскерлердің мысалы?
Dialogue: 0,0:57:03.12,0:57:07.52,Default,,0000,0000,0000,,Осыны орындадым деген сөз
Dialogue: 0,0:57:03.12,0:57:07.52,Default,,0000,0000,0000,,Сіз сенімдісіз бе?
Dialogue: 0,0:57:09.46,0:57:12.46,Default,,0000,0000,0000,,Мүлдем жол беруге болмайтын айуандық!
Dialogue: 0,0:57:12.46,0:57:16.13,Default,,0000,0000,0000,,Қазір есіме түссе де
Dialogue: 0,0:57:12.46,0:57:16.13,Default,,0000,0000,0000,,Мына қан қайнап жатқан сияқты.
Dialogue: 0,0:57:16.13,0:57:20.97,Default,,0000,0000,0000,,Ондай адамдарды жайына қалдыр
Dialogue: 0,0:57:16.13,0:57:20.97,Default,,0000,0000,0000,,Себеп жоқ.
Dialogue: 0,0:57:20.97,0:57:25.64,Default,,0000,0000,0000,,Жер анадан туған
Dialogue: 0,0:57:20.97,0:57:25.64,Default,,0000,0000,0000,,Әскери күш-қуат!
Dialogue: 0,0:57:25.64,0:57:30.31,Default,,0000,0000,0000,,Содан кейін
Dialogue: 0,0:57:25.64,0:57:30.31,Default,,0000,0000,0000,,Ең жақсы технологияны біріктіретін ұшақ!
Dialogue: 0,0:57:30.31,0:57:32.32,Default,,0000,0000,0000,,Одан әрі….
Dialogue: 0,0:57:32.32,0:57:36.32,Default,,0000,0000,0000,,Қарғыс атқыр империализм
Dialogue: 0,0:57:32.32,0:57:36.32,Default,,0000,0000,0000,,Бұл заклинание емес, бірақ➡
Dialogue: 0,0:57:36.32,0:57:40.99,Default,,0000,0000,0000,,Көпұлтты ерікті күштер де
Dialogue: 0,0:57:36.32,0:57:40.99,Default,,0000,0000,0000,,Оны қоюға болады!
Dialogue: 0,0:57:40.99,0:57:44.83,Default,,0000,0000,0000,,Осы құралдардың кез келгені
Dialogue: 0,0:57:40.99,0:57:44.83,Default,,0000,0000,0000,,Оларды өзіңізбен бірге алыңыз➡
Dialogue: 0,0:57:44.83,0:57:47.50,Default,,0000,0000,0000,,Набури! Шабуыл!
Dialogue: 0,0:57:47.50,0:57:50.33,Default,,0000,0000,0000,,Бәріміз бірге жасайық
Dialogue: 0,0:57:47.50,0:57:50.33,Default,,0000,0000,0000,,Сіз сондасыз ба?
Dialogue: 0,0:57:50.33,0:57:55.04,Default,,0000,0000,0000,,Ха ха ха ха….
Dialogue: 0,0:57:59.01,0:58:01.78,Default,,0000,0000,0000,,Құрметті Бас хатшы жолдас.
Dialogue: 0,0:58:01.78,0:58:06.08,Default,,0000,0000,0000,,Тигенгофқа
Dialogue: 0,0:58:01.78,0:58:06.08,Default,,0000,0000,0000,,Біз ауқымды шабуылды ұсынамыз.
Dialogue: 0,0:58:12.62,0:58:14.79,Default,,0000,0000,0000,,Жабдық әлі аяқталды ма?
Dialogue: 0,0:58:14.79,0:58:18.96,Default,,0000,0000,0000,,Бізде жұмыс күші жетпейді!
Dialogue: 0,0:58:14.79,0:58:18.96,Default,,0000,0000,0000,,Біз одан әрі асықпаймыз!
Dialogue: 0,0:58:18.96,0:58:23.47,Default,,0000,0000,0000,,Нақты ұрыс...?
Dialogue: 0,0:58:18.96,0:58:23.47,Default,,0000,0000,0000,,Мен ешқашан Федерациямен бірге жекпе-жек өткіземін деп ойламадым...
Dialogue: 0,0:58:23.47,0:58:25.64,Default,,0000,0000,0000,,Бізде бәрі жақсы болады.
Dialogue: 0,0:58:25.64,0:58:29.81,Default,,0000,0000,0000,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:58:25.64,0:58:29.81,Default,,0000,0000,0000,,Бұл қалай болды?
Dialogue: 0,0:58:29.81,0:58:32.31,Default,,0000,0000,0000,,Командир Дрейк.
Dialogue: 0,0:58:29.81,0:58:32.31,Default,,0000,0000,0000,,Цк.
Dialogue: 0,0:58:32.31,0:58:36.15,Default,,0000,0000,0000,,Бұл империяға қарсы соғыс.
Dialogue: 0,0:58:32.31,0:58:36.15,Default,,0000,0000,0000,,Біз де күресе аламыз, солай ма?
Dialogue: 0,0:58:36.15,0:58:39.82,Default,,0000,0000,0000,,Өз елінің бұйрықтары мен рұқсаттары аясында.
Dialogue: 0,0:58:39.82,0:58:42.15,Default,,0000,0000,0000,,Бұл да Құдайдың қалауы болуы керек.
Dialogue: 0,0:58:42.15,0:58:44.15,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:58:44.15,0:58:47.16,Default,,0000,0000,0000,,Сол Құдайдың алдында.
Dialogue: 0,0:58:44.15,0:58:47.16,Default,,0000,0000,0000,,Сізге қоңырау шалмайды деп үміттенемін.
Dialogue: 0,0:58:47.16,0:58:49.33,Default,,0000,0000,0000,,Иемізді сынама.
Dialogue: 0,0:58:49.33,0:58:52.03,Default,,0000,0000,0000,,Мен өз міндетімді ғана орындаймын.
Dialogue: 0,0:58:54.66,0:58:56.67,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:58:56.67,0:59:00.60,Default,,0000,0000,0000,,Сіз әдемі көрінесіз.
Dialogue: 0,0:58:56.67,0:59:00.60,Default,,0000,0000,0000,,Теңізді қатты сағындың ба?
Dialogue: 0,0:59:00.60,0:59:05.44,Default,,0000,0000,0000,,Иә, дәл қазір, лас пабта.
Dialogue: 0,0:59:00.60,0:59:05.44,Default,,0000,0000,0000,,Мен сусын алғым келеді.
Dialogue: 0,0:59:05.44,0:59:09.45,Default,,0000,0000,0000,,Бұл ақымақ бұйрық па? Бұл дұрыс.
Dialogue: 0,0:59:09.45,0:59:13.78,Default,,0000,0000,0000,,Өз еліндегі саясаткерлер Федерацияға жатады
Dialogue: 0,0:59:09.45,0:59:13.78,Default,,0000,0000,0000,,Ол өзінің жақсылығын сатқысы келетін сияқты.
Dialogue: 0,0:59:13.78,0:59:17.79,Default,,0000,0000,0000,,Бұл көрініске байланысты бөлімше тек жаңадан алынғандардан тұрады.
Dialogue: 0,0:59:13.78,0:59:17.79,Default,,0000,0000,0000,,Келіңіздер!
Dialogue: 0,0:59:17.79,0:59:22.63,Default,,0000,0000,0000,,Мұны өз ойыңызда орындаңыз ба?
Dialogue: 0,0:59:17.79,0:59:22.63,Default,,0000,0000,0000,,Асыраушысынан айырылған адамның зейнетақысы қанша болады?
Dialogue: 0,0:59:22.63,0:59:26.13,Default,,0000,0000,0000,,Айтпақшы, бұл мысал ма?
Dialogue: 0,0:59:26.13,0:59:30.97,Default,,0000,0000,0000,,Иә, прапорщик Мэри Сью.
Dialogue: 0,0:59:30.97,0:59:34.14,Default,,0000,0000,0000,,Менің әкем ержүрек жауынгер болған.
Dialogue: 0,0:59:34.14,0:59:36.81,Default,,0000,0000,0000,,Мен оны ақтауға тырыспаймын, бірақ➡
Dialogue: 0,0:59:36.81,0:59:40.01,Default,,0000,0000,0000,,Мүмкіндігінше
Dialogue: 0,0:59:36.81,0:59:40.01,Default,,0000,0000,0000,,Маған қамқор бол.
Dialogue: 0,0:59:50.32,0:59:52.99,Default,,0000,0000,0000,,Майор! Майор!
Dialogue: 0,0:59:52.99,0:59:57.33,Default,,0000,0000,0000,,Ояныңыз, майор!
Dialogue: 0,0:59:52.99,0:59:57.33,Default,,0000,0000,0000,,Хмм, не?
Dialogue: 0,0:59:57.33,1:00:00.50,Default,,0000,0000,0000,,Шабуыл! Федералды армия көшті!
Dialogue: 0,1:00:00.50,1:00:02.50,Default,,0000,0000,0000,,Жаудың көлемі қандай?
Dialogue: 0,1:00:02.50,1:00:06.17,Default,,0000,0000,0000,,Кем дегенде сегіз бөлім.
Dialogue: 0,1:00:02.50,1:00:06.17,Default,,0000,0000,0000,,Сегіз бөлім! ?
Dialogue: 0,1:00:06.17,1:00:09.84,Default,,0000,0000,0000,,Бұл әуе флотының бірінші есебі.
Dialogue: 0,1:00:06.17,1:00:09.84,Default,,0000,0000,0000,,Бұл осыдан төрт есе көп.
Dialogue: 0,1:00:09.84,1:00:13.14,Default,,0000,0000,0000,,Иә ең оптимистік
Dialogue: 0,1:00:09.84,1:00:13.14,Default,,0000,0000,0000,,Бағалау.
Dialogue: 0,1:00:16.18,1:00:20.52,Default,,0000,0000,0000,,Олар әлі күнге дейін Тигенхофтың маңыздылығын түсінбейді.
Dialogue: 0,1:00:16.18,1:00:20.52,Default,,0000,0000,0000,,Сіз байқамаған болуыңыз керек.
Dialogue: 0,1:00:20.52,1:00:25.36,Default,,0000,0000,0000,,Алайда, батыл қоныс аударуға байланысты
Dialogue: 0,1:00:20.52,1:00:25.36,Default,,0000,0000,0000,,Ауқымды шабуыл?
Dialogue: 0,1:00:25.36,1:00:28.02,Default,,0000,0000,0000,,《Ол Commie болса да, ол тым икемді.
Dialogue: 0,1:00:28.02,1:00:31.53,Default,,0000,0000,0000,,Стратегия оқылды ма?
Dialogue: 0,1:00:28.02,1:00:31.53,Default,,0000,0000,0000,,Немесе ақпараттың ағып кетуі ме?
Dialogue: 0,1:00:31.53,1:00:34.83,Default,,0000,0000,0000,,Қиямет! Неге...》
Dialogue: 0,1:00:38.87,1:00:41.70,Default,,0000,0000,0000,,Өйткені, жау да адам.
Dialogue: 0,1:00:41.70,1:00:43.71,Default,,0000,0000,0000,,Ауыр сауытпен саяхаттау жеткіліксіз болады.
Dialogue: 0,1:00:43.71,1:00:46.88,Default,,0000,0000,0000,,Жеңіл қаруланған әскерлерге басып кіру
Dialogue: 0,1:00:43.71,1:00:46.88,Default,,0000,0000,0000,,Қарын болса керек.
Dialogue: 0,1:00:46.88,1:00:50.38,Default,,0000,0000,0000,,Хаа… Хаа… Хаа…
Dialogue: 0,1:00:46.88,1:00:50.38,Default,,0000,0000,0000,,Сіздің қымбат базаңыз жойылуы мүмкін.
Dialogue: 0,1:00:50.38,1:00:53.05,Default,,0000,0000,0000,,Барлығын дереу оятыңыз!
Dialogue: 0,1:00:53.05,1:01:13.67,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:01:13.67,1:01:18.17,Default,,0000,0000,0000,,Әскери жолдастар, Отанымыз не істеді?
Dialogue: 0,1:01:18.17,1:01:23.68,Default,,0000,0000,0000,,Жауап қарапайым
Dialogue: 0,1:01:18.17,1:01:23.68,Default,,0000,0000,0000,,Біз ештеңе істеген жоқпыз. Ештеңе.
Dialogue: 0,1:01:23.68,1:01:28.35,Default,,0000,0000,0000,,Бірақ Федерация
Dialogue: 0,1:01:23.68,1:01:28.35,Default,,0000,0000,0000,,Ол мені өлтірмекші болды.
Dialogue: 0,1:01:28.35,1:01:31.35,Default,,0000,0000,0000,,Жақсы көрші болу мүмкін емес.
Dialogue: 0,1:01:31.35,1:01:34.69,Default,,0000,0000,0000,,Бұл дүние
Dialogue: 0,1:01:31.35,1:01:34.69,Default,,0000,0000,0000,,Тек иррационалды тіршілік иелері бар сияқты.
Dialogue: 0,1:01:34.69,1:01:38.36,Default,,0000,0000,0000,,Олар біздің құқығымызды алады
Dialogue: 0,1:01:34.69,1:01:38.36,Default,,0000,0000,0000,,Егер ол ➡ бұзса
Dialogue: 0,1:01:38.36,1:01:42.03,Default,,0000,0000,0000,,Біз күресуіміз керек.
Dialogue: 0,1:01:42.03,1:01:45.20,Default,,0000,0000,0000,,Мен еркіндікті бәрінен де жақсы көремін.
Dialogue: 0,1:01:45.20,1:01:50.04,Default,,0000,0000,0000,,Бостандыққа қол жеткізу және бостандықты қорғау
Dialogue: 0,1:01:45.20,1:01:50.04,Default,,0000,0000,0000,,Бостандықты қорғау.
Dialogue: 0,1:01:50.04,1:01:52.54,Default,,0000,0000,0000,,Біз бас тарта алмаймыз.
Dialogue: 0,1:01:52.54,1:01:56.21,Default,,0000,0000,0000,,Жолдастар, бұл азаттық үшін күрес.
Dialogue: 0,1:01:56.21,1:01:58.72,Default,,0000,0000,0000,,Сіз селт ете алмайсыз!
Dialogue: 0,1:01:58.72,1:02:02.15,Default,,0000,0000,0000,,Достар, үйге қайтыңдар.
Dialogue: 0,1:02:02.15,1:02:04.15,Default,,0000,0000,0000,,Жеңіске жетіңіз!
Dialogue: 0,1:02:04.15,1:02:06.16,Default,,0000,0000,0000,,Әйтпесе, өлім!
Dialogue: 0,1:02:06.16,1:02:09.33,Default,,0000,0000,0000,,Біз туған жеріміздің күзетшілеріміз!
Dialogue: 0,1:02:09.33,1:02:11.63,Default,,0000,0000,0000,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,1:02:26.51,1:02:30.68,Default,,0000,0000,0000,,Бұл не...?
Dialogue: 0,1:02:30.68,1:02:33.02,Default,,0000,0000,0000,,Бұл керемет сан...
Dialogue: 0,1:02:33.02,1:03:01.81,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:03:01.81,1:03:04.81,Default,,0000,0000,0000,,Еш қағыспа! Ату, ату!
Dialogue: 0,1:03:04.81,1:03:32.84,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:03:32.84,1:03:36.15,Default,,0000,0000,0000,,Қарғыс атсын бұл танк.
Dialogue: 0,1:03:32.84,1:03:36.15,Default,,0000,0000,0000,,Не істеуге болмайды?
Dialogue: 0,1:03:44.85,1:03:47.36,Default,,0000,0000,0000,,Сиқыршы? Бұл көмектеседі.
Dialogue: 0,1:03:47.36,1:03:49.53,Default,,0000,0000,0000,,Енді, ат, ат!
Dialogue: 0,1:03:49.53,1:03:51.53,Default,,0000,0000,0000,,Еш қағыспа!
Dialogue: 0,1:03:51.53,1:03:53.86,Default,,0000,0000,0000,,Жау күшін жоғалтып жатыр!
Dialogue: 0,1:03:53.86,1:03:56.20,Default,,0000,0000,0000,,Санымыздан басым!
Dialogue: 0,1:03:56.20,1:03:59.20,Default,,0000,0000,0000,,Қарғыс атсын
Dialogue: 0,1:03:56.20,1:03:59.20,Default,,0000,0000,0000,,Бірінен соң бірі келеді!
Dialogue: 0,1:03:59.20,1:04:01.97,Default,,0000,0000,0000,,Әлі ұшақ жоқ! ?
Dialogue: 0,1:03:59.20,1:04:01.97,Default,,0000,0000,0000,,Оны қалай болғанда да тоқтатыңыз!
Dialogue: 0,1:04:01.97,1:04:05.31,Default,,0000,0000,0000,,Мұнайды қайда сатады!
Dialogue: 0,1:04:01.97,1:04:05.31,Default,,0000,0000,0000,,Жүр, зарядта!
Dialogue: 0,1:04:05.31,1:04:07.51,Default,,0000,0000,0000,,Өл! Сіз шайтандар!
Dialogue: 0,1:04:17.15,1:04:19.82,Default,,0000,0000,0000,,Жабдықтарды тез арада толтырыңыз.
Dialogue: 0,1:04:19.82,1:04:24.16,Default,,0000,0000,0000,,Топтарды жылдам қамтамасыз ету
Dialogue: 0,1:04:19.82,1:04:24.16,Default,,0000,0000,0000,,Жабдықтау нүктесіне жылжытыңыз.
Dialogue: 0,1:04:24.16,1:04:28.00,Default,,0000,0000,0000,,Зардап шеккендерді дереу дәрігерге жеткізу керек.
Dialogue: 0,1:04:24.16,1:04:28.00,Default,,0000,0000,0000,,Мені өзіңізбен бірге алыңыз.
Dialogue: 0,1:04:28.00,1:04:32.67,Default,,0000,0000,0000,,📱(Вайс) Бұл 02 солтүстік-шығыстан
Dialogue: 0,1:04:28.00,1:04:32.67,Default,,0000,0000,0000,,Жаудың екі жаңа дивизиясы алға жылжуда!
Dialogue: 0,1:04:32.67,1:04:35.37,Default,,0000,0000,0000,,📱Жақында бұл аймаққа шабуыл жасайды деп ойлаймын.
Dialogue: 0,1:04:41.18,1:04:45.68,Default,,0000,0000,0000,,Мұнда 03
Dialogue: 0,1:04:41.18,1:04:45.68,Default,,0000,0000,0000,,Сондай-ақ жаңа күшейтулер расталды.
Dialogue: 0,1:04:45.68,1:04:51.52,Default,,0000,0000,0000,,Мұнда 04 G2 нүктесінде
Dialogue: 0,1:04:45.68,1:04:51.52,Default,,0000,0000,0000,,Қарсыластың қару-жарақ күшін елестетіңіз!
Dialogue: 0,1:04:51.52,1:04:56.86,Default,,0000,0000,0000,,Егістікте коммунистерді жинауға бола ма?
Dialogue: 0,1:04:51.52,1:04:56.86,Default,,0000,0000,0000,,Бұл мені күмәндану үшін жеткілікті.
Dialogue: 0,1:04:56.86,1:04:59.96,Default,,0000,0000,0000,,Бірінші рота Қозғала алатындар, ілесіңдер!
Dialogue: 0,1:04:59.96,1:05:04.07,Default,,0000,0000,0000,,Қалаға басып кірер алдында
Dialogue: 0,1:04:59.96,1:05:04.07,Default,,0000,0000,0000,,Комиссияларды қағып алыңыз!
Dialogue: 0,1:05:07.80,1:05:10.31,Default,,0000,0000,0000,,《Бұл не деген шайқас?
Dialogue: 0,1:05:10.31,1:05:15.01,Default,,0000,0000,0000,,Адам ресурстарын біріктіреді
Dialogue: 0,1:05:10.31,1:05:15.01,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? 》
Dialogue: 0,1:05:21.65,1:05:25.15,Default,,0000,0000,0000,,Әй, мен көктегі сиқыршыны көздеп отырмын.
Dialogue: 0,1:05:21.65,1:05:25.15,Default,,0000,0000,0000,,О!
Dialogue: 0,1:05:29.16,1:05:31.56,Default,,0000,0000,0000,,Эвакуациялаңыз! Эвакуацияланамын!
Dialogue: 0,1:05:34.83,1:05:38.67,Default,,0000,0000,0000,,Лейтенант Серебряков!
Dialogue: 0,1:05:34.83,1:05:38.67,Default,,0000,0000,0000,,Әр компанияның есептері! ?
Dialogue: 0,1:05:38.67,1:05:44.34,Default,,0000,0000,0000,,Ешқандай ауыр зақым болмаса да қазірдің өзінде
Dialogue: 0,1:05:38.67,1:05:44.34,Default,,0000,0000,0000,,Әскерлердің көпшілігі таусылды.
Dialogue: 0,1:05:44.34,1:05:48.51,Default,,0000,0000,0000,,Менде көп сиқырлы күш пен оқтар бар...
Dialogue: 0,1:05:48.51,1:05:50.68,Default,,0000,0000,0000,,Бұл бөлімде нешеу бар?
Dialogue: 0,1:05:50.68,1:05:54.68,Default,,0000,0000,0000,,10 дана.
Dialogue: 0,1:05:50.68,1:05:54.68,Default,,0000,0000,0000,,Мен күткендей, бұдан артық ештеңе айта алмаймын...
Dialogue: 0,1:05:54.68,1:05:58.85,Default,,0000,0000,0000,,📱 (Koenig) Бұл 03
Dialogue: 0,1:05:54.68,1:05:58.85,Default,,0000,0000,0000,,Біз тордан құтыла алдық!
Dialogue: 0,1:05:58.85,1:06:02.96,Default,,0000,0000,0000,,Батальон көлеміндегі жау сиқыршысы.
Dialogue: 0,1:05:58.85,1:06:02.96,Default,,0000,0000,0000,,Қалаға барыңыз.
Dialogue: 0,1:06:02.96,1:06:04.96,Default,,0000,0000,0000,,Егер сіз қазір сиқыршы болсаңыз! ?
Dialogue: 0,1:06:04.96,1:06:08.46,Default,,0000,0000,0000,,Федералдық сарбаз емес.
Dialogue: 0,1:06:04.96,1:06:08.46,Default,,0000,0000,0000,,Менің ойымша, бұл Мәскеуде жаумен байланыста болған бөлімше.
Dialogue: 0,1:06:08.46,1:06:10.97,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,1:06:10.97,1:06:13.30,Default,,0000,0000,0000,,Бір соққы және кет!
Dialogue: 0,1:06:13.30,1:06:15.47,Default,,0000,0000,0000,,Балалар, сіз мұны міндетті түрде жасай аласыз.
Dialogue: 0,1:06:15.47,1:06:18.64,Default,,0000,0000,0000,,📱Ерік-жігермен және күшпен
Dialogue: 0,1:06:15.47,1:06:18.64,Default,,0000,0000,0000,,Оны империяға көрсетіңіз!
Dialogue: 0,1:06:18.64,1:06:23.15,Default,,0000,0000,0000,,Қала аумағына шабуыл...
Dialogue: 0,1:06:18.64,1:06:23.15,Default,,0000,0000,0000,,Енді, сіз штабты көздедіңіз бе?
Dialogue: 0,1:06:23.15,1:06:25.98,Default,,0000,0000,0000,,Кері қудалау!
Dialogue: 0,1:06:23.15,1:06:25.98,Default,,0000,0000,0000,,Оны кез келген жағдайда тоқтатыңыз...
Dialogue: 0,1:06:25.98,1:06:29.65,Default,,0000,0000,0000,,📱Әр командаға
Dialogue: 0,1:06:25.98,1:06:29.65,Default,,0000,0000,0000,,Tiegenhof басқаруынан әр блокқа.
Dialogue: 0,1:06:29.65,1:06:33.49,Default,,0000,0000,0000,,📱Ынтымақты бақылау тобы
Dialogue: 0,1:06:29.65,1:06:33.49,Default,,0000,0000,0000,,Қарсыластың бірнеше әуе күштері анықталды.
Dialogue: 0,1:06:33.49,1:06:39.30,Default,,0000,0000,0000,,📱Жауынгерлік және бомбалаушы топтар
Dialogue: 0,1:06:33.49,1:06:39.30,Default,,0000,0000,0000,,Солтүстік-шығыстан келе жатыр дейді.
Dialogue: 0,1:06:43.00,1:06:45.84,Default,,0000,0000,0000,,📱Аудан бойынша арнайы ескерту беру.
Dialogue: 0,1:06:45.84,1:06:49.01,Default,,0000,0000,0000,,📱Барлық бөлімшелер, сақ болыңыз. қайталаңыз.
Dialogue: 0,1:06:49.01,1:06:51.01,Default,,0000,0000,0000,,📱Барлық бөлімшелер, сақ болыңыз.
Dialogue: 0,1:06:51.01,1:06:53.68,Default,,0000,0000,0000,,Әуеден келетін қауіптер өте көп...
Dialogue: 0,1:06:53.68,1:06:56.68,Default,,0000,0000,0000,,Әлі де жаудың жаяу әскері
Dialogue: 0,1:06:53.68,1:06:56.68,Default,,0000,0000,0000,,Көп қалғанымен.
Dialogue: 0,1:06:59.01,1:07:03.79,Default,,0000,0000,0000,,📱 (Вайс) Майор, бұйрықтарыңызды беріңіз!
Dialogue: 0,1:07:03.79,1:07:07.62,Default,,0000,0000,0000,,Екі, үш және төрт рота әуе қорғаныс күштері болып табылады.
Dialogue: 0,1:07:07.62,1:07:11.79,Default,,0000,0000,0000,,Аралас бомбалау құрылымы
Dialogue: 0,1:07:07.62,1:07:11.79,Default,,0000,0000,0000,,Қала сыртындағы көрікті жерлерді аралаудан бас тарту.
Dialogue: 0,1:07:11.79,1:07:16.30,Default,,0000,0000,0000,,Бұл иммиграциялық тексеру ме? Сиқыршы үшін.
Dialogue: 0,1:07:11.79,1:07:16.30,Default,,0000,0000,0000,,Бұл қиын жұмыс.
Dialogue: 0,1:07:16.30,1:07:19.14,Default,,0000,0000,0000,,📱Мен білемін, солай ма?
Dialogue: 0,1:07:16.30,1:07:19.14,Default,,0000,0000,0000,,Капитан Вайс.
Dialogue: 0,1:07:19.14,1:07:22.81,Default,,0000,0000,0000,,Мен сізге жердегі қысымды қалдырамын.
Dialogue: 0,1:07:19.14,1:07:22.81,Default,,0000,0000,0000,,Барынша жалқау болмаңыз.
Dialogue: 0,1:07:22.81,1:07:25.64,Default,,0000,0000,0000,,📱(Вайс) Ха!
Dialogue: 0,1:07:25.64,1:07:28.48,Default,,0000,0000,0000,,Қалған 1-ші рота менің соңымнан келеді.
Dialogue: 0,1:07:28.48,1:07:32.78,Default,,0000,0000,0000,,Жаудың сиқырлы бірлігінің бөксесінде
Dialogue: 0,1:07:28.48,1:07:32.78,Default,,0000,0000,0000,,Оларды қорғасын оқтарымен ат!
Dialogue: 0,1:07:37.49,1:07:41.49,Default,,0000,0000,0000,,Сіздің шенеуніктеріңіз алдыңғы қатарда.
Dialogue: 0,1:07:37.49,1:07:41.49,Default,,0000,0000,0000,,Күшейтілген қару-жарақпен шабуыл!
Dialogue: 0,1:07:41.49,1:07:43.49,Default,,0000,0000,0000,,Иә!
Dialogue: 0,1:07:45.83,1:07:48.00,Default,,0000,0000,0000,,📱Күтіңіз! Мэри!
Dialogue: 0,1:07:48.00,1:07:50.17,Default,,0000,0000,0000,,Ордер соты! Екі адамдық камераны бұзбаңыз!
Dialogue: 0,1:07:50.17,1:07:52.50,Default,,0000,0000,0000,,Жарайды! Мен бара аламын!
Dialogue: 0,1:07:52.50,1:07:54.84,Default,,0000,0000,0000,,Идиот
Dialogue: 0,1:07:52.50,1:07:54.84,Default,,0000,0000,0000,,Тағдыр маған тірі қалуды бұйырып тұр ма?
Dialogue: 0,1:07:54.84,1:07:57.17,Default,,0000,0000,0000,,Ұстауға дайындалыңыз!
Dialogue: 0,1:07:57.17,1:07:59.58,Default,,0000,0000,0000,,Оны ұнтаққа бөліңіз!
Dialogue: 0,1:08:04.28,1:08:06.48,Default,,0000,0000,0000,,Мэри!
Dialogue: 0,1:08:16.13,1:08:19.53,Default,,0000,0000,0000,,Ха, жабайы қабан сияқты.
Dialogue: 0,1:08:21.96,1:08:23.97,Default,,0000,0000,0000,,Атқан үш ұшақ расталды.
Dialogue: 0,1:08:23.97,1:08:27.47,Default,,0000,0000,0000,,Жарайды, үйрек ату! Қанекей мынаны істейік!
Dialogue: 0,1:08:27.47,1:08:32.14,Default,,0000,0000,0000,,📱Артыңыздағы жаудың жаңа қимылын тексеріңіз.
Dialogue: 0,1:08:27.47,1:08:32.14,Default,,0000,0000,0000,,Бұл императорлық сиқырлы күш!
Dialogue: 0,1:08:32.14,1:08:34.48,Default,,0000,0000,0000,,📱Осында жаңа ойыншылар қабылданады.
Dialogue: 0,1:08:34.48,1:08:37.81,Default,,0000,0000,0000,,📱Операцияның мақсаты
Dialogue: 0,1:08:34.48,1:08:37.81,Default,,0000,0000,0000,,Бұл жаудың басы ғана!
Dialogue: 0,1:08:37.81,1:08:41.62,Default,,0000,0000,0000,,📱Авангард старшинасы Сью және т.б
Dialogue: 0,1:08:37.81,1:08:41.62,Default,,0000,0000,0000,,Жаудың штабына шабуыл жасаңыз!
Dialogue: 0,1:08:43.82,1:08:45.99,Default,,0000,0000,0000,,Неліктен мұнда?
Dialogue: 0,1:08:45.99,1:08:48.82,Default,,0000,0000,0000,,📱Жау штабына шабуыл! ?
Dialogue: 0,1:08:48.82,1:08:51.49,Default,,0000,0000,0000,,Бір ұшақ бізге қарай бет алды!
Dialogue: 0,1:08:51.49,1:09:01.27,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:09:01.27,1:09:03.27,Default,,0000,0000,0000,,Эй!
Dialogue: 0,1:09:03.27,1:09:05.98,Default,,0000,0000,0000,,Ха~!
Dialogue: 0,1:09:18.79,1:09:20.79,Default,,0000,0000,0000,,Ха...
Dialogue: 0,1:09:22.79,1:09:26.00,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:09:37.97,1:09:41.14,Default,,0000,0000,0000,,Эй, оптикалық жүйе техникасы! ?
Dialogue: 0,1:09:41.14,1:09:43.48,Default,,0000,0000,0000,,Бұл керемет сиқырлы реакция!
Dialogue: 0,1:09:43.48,1:09:45.65,Default,,0000,0000,0000,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,1:09:45.65,1:09:48.65,Default,,0000,0000,0000,,Мен жалғыз сені нысанаға алып отырмын ба?
Dialogue: 0,1:09:52.99,1:09:55.32,Default,,0000,0000,0000,,Тартыңыз және шабуыл жасаңыз!
Dialogue: 0,1:09:55.32,1:09:59.66,Default,,0000,0000,0000,,Серіктесім лейтенант Серебряковтан басқа.
Dialogue: 0,1:09:55.32,1:09:59.66,Default,,0000,0000,0000,,Аңшылықты жалғастырыңыз!
Dialogue: 0,1:09:59.66,1:10:23.85,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:10:23.85,1:10:27.16,Default,,0000,0000,0000,,Сіз бұлай көтеріле алмайсыз!
Dialogue: 0,1:10:23.85,1:10:27.16,Default,,0000,0000,0000,,Сіздің жолыңызда тұрған жойғыш ұшақтарды тастаңыз!
Dialogue: 0,1:10:33.03,1:10:35.03,Default,,0000,0000,0000,,📱Бомбардир
Dialogue: 0,1:10:33.03,1:10:35.03,Default,,0000,0000,0000,,Айналма жолмен жүріп, алға ұмтылу!
Dialogue: 0,1:10:35.03,1:10:37.03,Default,,0000,0000,0000,,📱Біз уақытында үлгермейміз!
Dialogue: 0,1:10:37.03,1:10:43.54,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:10:43.54,1:10:46.64,Default,,0000,0000,0000,,17 қаралды! Мен кетемін!
Dialogue: 0,1:10:50.71,1:10:53.38,Default,,0000,0000,0000,,Капитан, бұл үшінші және төртінші рота!
Dialogue: 0,1:10:53.38,1:10:56.89,Default,,0000,0000,0000,,Жауынгерлер тартады.
Dialogue: 0,1:10:53.38,1:10:56.89,Default,,0000,0000,0000,,Осы мүмкіндікті пайдаланып, бомбалаушыны жіберіңіз!
Dialogue: 0,1:10:56.89,1:11:01.16,Default,,0000,0000,0000,,Бірақ сіз және өзіңіз ғана...
Dialogue: 0,1:10:56.89,1:11:01.16,Default,,0000,0000,0000,,Майордан таяқ жегеннен артық!
Dialogue: 0,1:11:01.16,1:11:04.56,Default,,0000,0000,0000,,истребитель дегеніміз не?
Dialogue: 0,1:11:01.16,1:11:04.56,Default,,0000,0000,0000,,Бұл өте сүйкімді!
Dialogue: 0,1:11:09.83,1:11:12.84,Default,,0000,0000,0000,,Екінші рота көтерілуге ​​дайын!
Dialogue: 0,1:11:17.01,1:11:21.18,Default,,0000,0000,0000,,Қашып кету - қорқақтық!
Dialogue: 0,1:11:17.01,1:11:21.18,Default,,0000,0000,0000,,Қорқақ!
Dialogue: 0,1:11:21.18,1:11:49.04,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:11:49.04,1:11:53.71,Default,,0000,0000,0000,,Сіз қанша атуға дайынсыз!
Dialogue: 0,1:11:49.04,1:11:53.71,Default,,0000,0000,0000,,Сиқырлы қуатты тұтыну айтарлықтай болуы керек!
Dialogue: 0,1:11:53.71,1:11:56.88,Default,,0000,0000,0000,,(қатты тыныс алу)
Dialogue: 0,1:11:56.88,1:11:59.38,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1:11:59.38,1:12:08.49,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:12:08.49,1:12:13.50,Default,,0000,0000,0000,,Барлық сиқырлы күшіңізді қолданыңыз! Шектеуге дейін көтеріліңіз!
Dialogue: 0,1:12:15.66,1:12:19.17,Default,,0000,0000,0000,,Кел, мен сенің қарсыласыңмын!
Dialogue: 0,1:12:24.01,1:12:26.61,Default,,0000,0000,0000,,Шыу!
Dialogue: 0,1:12:29.35,1:12:35.65,Default,,0000,0000,0000,,Шыу!
Dialogue: 0,1:12:40.69,1:12:44.86,Default,,0000,0000,0000,,Биіктігі 8000!
Dialogue: 0,1:12:44.86,1:12:46.86,Default,,0000,0000,0000,,8500!
Dialogue: 0,1:12:50.03,1:12:52.03,Default,,0000,0000,0000,,9000!
Dialogue: 0,1:12:54.70,1:12:57.61,Default,,0000,0000,0000,,9500!
Dialogue: 0,1:13:02.81,1:13:05.81,Default,,0000,0000,0000,,Енгізу техникасы!
Dialogue: 0,1:13:05.81,1:13:09.02,Default,,0000,0000,0000,,Әрине, оны есінен тандырып тастаған дұрыс қой?
Dialogue: 0,1:13:21.50,1:13:26.50,Default,,0000,0000,0000,,Хахаха... мен жасадым... жасадым.
Dialogue: 0,1:13:40.02,1:13:43.02,Default,,0000,0000,0000,,Әр компанияға жақсылық.
Dialogue: 0,1:13:43.02,1:13:48.32,Default,,0000,0000,0000,,Бірақ жұмыс әлі аяқталған жоқ.
Dialogue: 0,1:13:43.02,1:13:48.32,Default,,0000,0000,0000,,Жауды жерге соғуды жалғастыру.
Dialogue: 0,1:13:50.86,1:13:59.70,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:13:59.70,1:14:02.14,Default,,0000,0000,0000,,Бұл қозғалыс аталды ма?
Dialogue: 0,1:14:02.14,1:14:05.64,Default,,0000,0000,0000,,Бұл мен күткеннен де көп. Мен бұл жерге үйреніп қалдым!
Dialogue: 0,1:14:07.81,1:14:09.98,Default,,0000,0000,0000,,(Таняның айқайы)
Dialogue: 0,1:14:09.98,1:14:13.28,Default,,0000,0000,0000,,(Мэридің айқайы)
Dialogue: 0,1:14:16.65,1:14:19.49,Default,,0000,0000,0000,,Өл! Ол менің әкемнің жауы!
Dialogue: 0,1:14:19.49,1:14:22.99,Default,,0000,0000,0000,,Мен не істедім!
Dialogue: 0,1:14:19.49,1:14:22.99,Default,,0000,0000,0000,,Ақымақ ауыз!
Dialogue: 0,1:14:22.99,1:14:25.83,Default,,0000,0000,0000,,Жұмыс кезінде ойнау, т.б.
Dialogue: 0,1:14:22.99,1:14:25.83,Default,,0000,0000,0000,,Бұл хобби емес!
Dialogue: 0,1:14:25.83,1:14:27.83,Default,,0000,0000,0000,,Тыныш, үндеме, үндеме!
Dialogue: 0,1:14:27.83,1:14:31.50,Default,,0000,0000,0000,,Мен сені кешірмеймін! мүлдем!
Dialogue: 0,1:14:31.50,1:14:34.50,Default,,0000,0000,0000,,(Соқтығыс дыбысы)
Dialogue: 0,1:14:38.17,1:14:41.01,Default,,0000,0000,0000,,(қатты тыныс алу)
Dialogue: 0,1:14:41.01,1:14:47.85,Default,,0000,0000,0000,,Соғыс туралы жеке сезімдеріңіз бар ма?
Dialogue: 0,1:14:41.01,1:14:47.85,Default,,0000,0000,0000,,Бұл күлкілі емес!
Dialogue: 0,1:14:47.85,1:14:57.53,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:14:57.53,1:15:03.53,Default,,0000,0000,0000,,Маған не болды.
Dialogue: 0,1:14:57.53,1:15:03.53,Default,,0000,0000,0000,,Бұл ұқсас нәрсе ме?
Dialogue: 0,1:15:06.30,1:15:09.47,Default,,0000,0000,0000,,《Бұл жұмыс, эмоциялар жоқ.
Dialogue: 0,1:15:09.47,1:15:14.64,Default,,0000,0000,0000,,Ақылға негізделген ерікті түрде》
Dialogue: 0,1:15:14.64,1:15:16.81,Default,,0000,0000,0000,,Оны өлтірейік.
Dialogue: 0,1:15:16.81,1:15:19.98,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:15:19.98,1:16:11.30,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:16:11.30,1:16:14.47,Default,,0000,0000,0000,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:16:14.47,1:16:16.47,Default,,0000,0000,0000,,Құдай.
Dialogue: 0,1:16:16.47,1:16:19.07,Default,,0000,0000,0000,,Біз күнәкарларды кешіре гөр.
Dialogue: 0,1:16:21.31,1:16:24.65,Default,,0000,0000,0000,,Үміттенемін
Dialogue: 0,1:16:21.31,1:16:24.65,Default,,0000,0000,0000,,Оны сізге әкеліңіз.
Dialogue: 0,1:16:24.65,1:16:26.65,Default,,0000,0000,0000,,Боқ...
Dialogue: 0,1:16:26.65,1:16:31.65,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,1:17:09.46,1:17:11.46,Default,,0000,0000,0000,,Ал...
Dialogue: 0,1:17:17.47,1:17:20.07,Default,,0000,0000,0000,,Бұл құбыжық па?
Dialogue: 0,1:17:17.47,1:17:20.07,Default,,0000,0000,0000,,Шыу!
Dialogue: 0,1:17:45.83,1:17:50.03,Default,,0000,0000,0000,,(Таняның айқайы)
Dialogue: 0,1:18:11.12,1:18:18.53,Default,,0000,0000,0000,,(қатты тыныс алу)
Dialogue: 0,1:18:45.15,1:18:47.86,Default,,0000,0000,0000,,Шыу!
Dialogue: 0,1:18:56.33,1:19:02.94,Default,,0000,0000,0000,,Ах...
Dialogue: 0,1:18:56.33,1:19:02.94,Default,,0000,0000,0000,,Айуан, мен саған ілесе алмаймын.
Dialogue: 0,1:19:02.94,1:19:07.44,Default,,0000,0000,0000,,Қош бол.
Dialogue: 0,1:19:02.94,1:19:07.44,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:19:07.44,1:19:13.55,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:19:36.97,1:19:38.97,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,1:19:44.98,1:19:47.32,Default,,0000,0000,0000,,Майор! Аман болыңыз!
Dialogue: 0,1:19:47.32,1:19:50.02,Default,,0000,0000,0000,,О, жай ғана.
Dialogue: 0,1:19:53.99,1:20:00.00,Default,,0000,0000,0000,,Мүмкін болса өлтіргім келді.
Dialogue: 0,1:19:53.99,1:20:00.00,Default,,0000,0000,0000,,Жоқ, мен оны өлтіруім керек еді...
Dialogue: 0,1:20:05.00,1:20:07.17,Default,,0000,0000,0000,,Подполковник...
Dialogue: 0,1:20:07.17,1:20:10.34,Default,,0000,0000,0000,,Мен әлі де күресемін.
Dialogue: 0,1:20:10.34,1:20:14.01,Default,,0000,0000,0000,,Маған қайтуға рұқсат етіңіз...
Dialogue: 0,1:20:14.01,1:20:19.85,Default,,0000,0000,0000,,Мені жіберуіңізді өтінемін...
Dialogue: 0,1:20:14.01,1:20:19.85,Default,,0000,0000,0000,,Өтінемін….
Dialogue: 0,1:20:19.85,1:20:22.35,Default,,0000,0000,0000,,Сол шайтан...
Dialogue: 0,1:20:19.85,1:20:22.35,Default,,0000,0000,0000,,Үндетпе.
Dialogue: 0,1:20:25.19,1:20:27.86,Default,,0000,0000,0000,,📱Подполковник Дрейк. Федералды армия➡
Dialogue: 0,1:20:27.86,1:20:31.03,Default,,0000,0000,0000,,Федералдық әскерлер шығарылады!
Dialogue: 0,1:20:27.86,1:20:31.03,Default,,0000,0000,0000,,Не?
Dialogue: 0,1:20:31.03,1:20:35.03,Default,,0000,0000,0000,,Ол бұзылған күйде.
Dialogue: 0,1:20:31.03,1:20:35.03,Default,,0000,0000,0000,,Барлық жерде шатасу болды.
Dialogue: 0,1:20:37.53,1:20:40.64,Default,,0000,0000,0000,,Уақыт келді. Мен тартамын.
Dialogue: 0,1:20:47.54,1:20:53.35,Default,,0000,0000,0000,,Неге... неге...
Dialogue: 0,1:20:47.54,1:20:53.35,Default,,0000,0000,0000,,Әке….
Dialogue: 0,1:21:00.16,1:21:02.82,Default,,0000,0000,0000,,Бізде зембілдер жеткіліксіз!
Dialogue: 0,1:21:00.16,1:21:02.82,Default,,0000,0000,0000,,Жарайсың!
Dialogue: 0,1:21:02.82,1:21:04.83,Default,,0000,0000,0000,,Асығыңыз!
Dialogue: 0,1:21:18.51,1:21:21.11,Default,,0000,0000,0000,,Эй, сен темекі тартқың келе ме?
Dialogue: 0,1:21:27.02,1:21:32.52,Default,,0000,0000,0000,,《Х бар болғаны бірде айтқан.
Dialogue: 0,1:21:32.52,1:21:38.19,Default,,0000,0000,0000,,Мені ауыр жағдайға түсірсең.
Dialogue: 0,1:21:38.19,1:21:43.87,Default,,0000,0000,0000,,Дәл солай жазылған
Dialogue: 0,1:21:38.19,1:21:43.87,Default,,0000,0000,0000,,Бейбіт күнделікті өмір алыс.
Dialogue: 0,1:21:43.87,1:21:47.20,Default,,0000,0000,0000,,Тәжірибелі жауынгер болсаң да
Dialogue: 0,1:21:43.87,1:21:47.20,Default,,0000,0000,0000,,Таусылды➡
Dialogue: 0,1:21:47.20,1:21:54.54,Default,,0000,0000,0000,,Қызметі жоғарылаған командир ретінде
Dialogue: 0,1:21:47.20,1:21:54.54,Default,,0000,0000,0000,,Күн сайын өмірге кепілдік жоқ.
Dialogue: 0,1:21:54.54,1:22:00.32,Default,,0000,0000,0000,,Бұл қазірдің өзінде батпақты шайқас
Dialogue: 0,1:21:54.54,1:22:00.32,Default,,0000,0000,0000,,Ақыр аяғы жоқ.
Dialogue: 0,1:22:00.32,1:22:04.15,Default,,0000,0000,0000,,Ұлы соғыс мәңгілікке кеңейді.
Dialogue: 0,1:22:04.15,1:22:08.66,Default,,0000,0000,0000,,берілген
Dialogue: 0,1:22:04.15,1:22:08.66,Default,,0000,0000,0000,,Тағдыр болса...》
Dialogue: 0,1:22:23.00,1:22:25.67,Default,,0000,0000,0000,,Майор? Бұл не?
Dialogue: 0,1:22:25.67,1:22:30.35,Default,,0000,0000,0000,,Бұл аудару туралы өтініш, Мәртебелі.
Dialogue: 0,1:22:30.35,1:22:33.18,Default,,0000,0000,0000,,Мен мұны түсінемін.
Dialogue: 0,1:22:33.18,1:22:37.19,Default,,0000,0000,0000,,Алдыңғы қатардағы жұмыстан басқа нәрсемен айналысқыңыз келсе ше?
Dialogue: 0,1:22:37.19,1:22:39.69,Default,,0000,0000,0000,,Бұл әзіл ме? майор.
Dialogue: 0,1:22:39.69,1:22:43.53,Default,,0000,0000,0000,,Жоқ, мен өте байсалдымын.
Dialogue: 0,1:22:43.53,1:22:47.20,Default,,0000,0000,0000,,《Ренгер: Сол жылытушы
Dialogue: 0,1:22:43.53,1:22:47.20,Default,,0000,0000,0000,,Сізге артқы жағы керек пе?
Dialogue: 0,1:22:47.20,1:22:49.20,Default,,0000,0000,0000,,Сіз нені айтасыз? 》
Dialogue: 0,1:22:49.20,1:22:52.70,Default,,0000,0000,0000,,Майор
Dialogue: 0,1:22:49.20,1:22:52.70,Default,,0000,0000,0000,,Неліктен алдыңғы шептер?
Dialogue: 0,1:22:52.70,1:22:54.87,Default,,0000,0000,0000,,Неліктен әскери қызметтен бас тарту керек?
Dialogue: 0,1:22:54.87,1:22:59.87,Default,,0000,0000,0000,,Жоғары мәртебелі, сұрағыңыздың мақсаты
Dialogue: 0,1:22:54.87,1:22:59.87,Default,,0000,0000,0000,,Мен мұны ұсақ шенеунік ретінде түсінбеймін.
Dialogue: 0,1:22:59.87,1:23:03.48,Default,,0000,0000,0000,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,1:22:59.87,1:23:03.48,Default,,0000,0000,0000,,Сіз отпен ойнайсыз ба?
Dialogue: 0,1:23:03.48,1:23:06.31,Default,,0000,0000,0000,,《Баланың бүлінген әңгімесі сияқты емес пе?
Dialogue: 0,1:23:06.31,1:23:11.15,Default,,0000,0000,0000,,Негізі ол кішкентай, бірақ...
Dialogue: 0,1:23:06.31,1:23:11.15,Default,,0000,0000,0000,,Сіз бүлікшіл кезеңдесіз бе? 》
Dialogue: 0,1:23:11.15,1:23:15.66,Default,,0000,0000,0000,,Майор Біз
Dialogue: 0,1:23:11.15,1:23:15.66,Default,,0000,0000,0000,,Мен сіз туралы жоғары ойлаймын.
Dialogue: 0,1:23:15.66,1:23:18.16,Default,,0000,0000,0000,,Бұл құрмет, Мәртебелі.
Dialogue: 0,1:23:18.16,1:23:23.33,Default,,0000,0000,0000,,Ендеше неге сен сияқты элита
Dialogue: 0,1:23:18.16,1:23:23.33,Default,,0000,0000,0000,,Сіз тылда жұмыс істеуге өтініш бересіз бе?
Dialogue: 0,1:23:23.33,1:23:26.84,Default,,0000,0000,0000,,Маған шынымен не ойлайтыныңызды айтыңыз.
Dialogue: 0,1:23:26.84,1:23:30.01,Default,,0000,0000,0000,,Жоғары мәртебелі сөздері мен тілектері
Dialogue: 0,1:23:26.84,1:23:30.01,Default,,0000,0000,0000,,Кешірім сұраймын➡
Dialogue: 0,1:23:30.01,1:23:35.51,Default,,0000,0000,0000,,Бұл соғыс
Dialogue: 0,1:23:30.01,1:23:35.51,Default,,0000,0000,0000,,Біз қазіргідей жеңе алмаймыз.
Dialogue: 0,1:23:35.51,1:23:41.52,Default,,0000,0000,0000,,Сіз Федерацияны жеңдім дейсіз бе?
Dialogue: 0,1:23:35.51,1:23:41.52,Default,,0000,0000,0000,,Иә, менің білуімше.
Dialogue: 0,1:23:41.52,1:23:44.69,Default,,0000,0000,0000,,Өзіңіздің жеке пікіріңізді айтыңыз.
Dialogue: 0,1:23:44.69,1:23:48.69,Default,,0000,0000,0000,,Иә, қазір біздің әскеріміз
Dialogue: 0,1:23:44.69,1:23:48.69,Default,,0000,0000,0000,,Ұйымның күші емес➡
Dialogue: 0,1:23:48.69,1:23:53.19,Default,,0000,0000,0000,,Жеке спектакльдер сериясы, әрең
Dialogue: 0,1:23:48.69,1:23:53.19,Default,,0000,0000,0000,,Жеңіске жеткендей кейіп таныту.
Dialogue: 0,1:23:53.19,1:23:58.03,Default,,0000,0000,0000,,Қазір Федерацияның кең аумағы
Dialogue: 0,1:23:53.19,1:23:58.03,Default,,0000,0000,0000,,Үлкен кеңістіктерді қорыта алмайды.
Dialogue: 0,1:23:58.03,1:24:02.30,Default,,0000,0000,0000,,Жүйелі түрде жетілдірусіз
Dialogue: 0,1:23:58.03,1:24:02.30,Default,,0000,0000,0000,,Жеңіс мүмкін болмайды.
Dialogue: 0,1:24:02.30,1:24:04.47,Default,,0000,0000,0000,,Өткен күнгі шайқаста➡
Dialogue: 0,1:24:04.47,1:24:08.14,Default,,0000,0000,0000,,Көпұлтты ерікті күштерге келетін болсақ.
Dialogue: 0,1:24:04.47,1:24:08.14,Default,,0000,0000,0000,,Кездескен.
Dialogue: 0,1:24:08.14,1:24:10.31,Default,,0000,0000,0000,,Бізді алаңдату керек нәрсе ➡
Dialogue: 0,1:24:10.31,1:24:13.31,Default,,0000,0000,0000,,Тіпті Америка Құрама Штаттарының Ұлттық гвардиясы
Dialogue: 0,1:24:10.31,1:24:13.31,Default,,0000,0000,0000,,Қатысу.
Dialogue: 0,1:24:13.31,1:24:16.48,Default,,0000,0000,0000,,Соңында
Dialogue: 0,1:24:13.31,1:24:16.48,Default,,0000,0000,0000,,Америка Құрама Штаттары да шабуыл жасайды.
Dialogue: 0,1:24:16.48,1:24:19.65,Default,,0000,0000,0000,,Осыны айтып тұрсыз ба?
Dialogue: 0,1:24:16.48,1:24:19.65,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,1:24:19.65,1:24:23.32,Default,,0000,0000,0000,,Бірақ империя
Dialogue: 0,1:24:19.65,1:24:23.32,Default,,0000,0000,0000,,Америка Құрама Штаттарына қарап➡
Dialogue: 0,1:24:23.32,1:24:26.66,Default,,0000,0000,0000,,Стратегиялық ортаның болжамдары
Dialogue: 0,1:24:23.32,1:24:26.66,Default,,0000,0000,0000,,солай емес пе?
Dialogue: 0,1:24:26.66,1:24:30.50,Default,,0000,0000,0000,,Надан бол
Dialogue: 0,1:24:26.66,1:24:30.50,Default,,0000,0000,0000,,Мен ұсақ шенеуніктерді білмеймін.
Dialogue: 0,1:24:30.50,1:24:32.83,Default,,0000,0000,0000,,Бұл ұят, майор.
Dialogue: 0,1:24:32.83,1:24:35.67,Default,,0000,0000,0000,,Олар табиғаты бойынша изоляцияшыл.
Dialogue: 0,1:24:35.67,1:24:40.18,Default,,0000,0000,0000,,Мұхиттың арғы жағында
Dialogue: 0,1:24:35.67,1:24:40.18,Default,,0000,0000,0000,,Қалай ойлайсыңдар, біз құрлыққа мұрынды тығып аламыз ба?
Dialogue: 0,1:24:40.18,1:24:44.35,Default,,0000,0000,0000,,Әрине, Америка Құрама Штаттарының араласуы
Dialogue: 0,1:24:40.18,1:24:44.35,Default,,0000,0000,0000,,Ең дұрысы, ешқайсысы болмауы керек.
Dialogue: 0,1:24:44.35,1:24:49.02,Default,,0000,0000,0000,,Бірақ мұндай дүниежүзілік соғыс
Dialogue: 0,1:24:44.35,1:24:49.02,Default,,0000,0000,0000,,Бұл мүмкін бе?
Dialogue: 0,1:24:49.02,1:24:53.62,Default,,0000,0000,0000,,Жауап анық: олай болуы мүмкін емес.
Dialogue: 0,1:24:56.36,1:25:00.13,Default,,0000,0000,0000,,Яғни, сіз
Dialogue: 0,1:24:56.36,1:25:00.13,Default,,0000,0000,0000,,Бұл матчта жеңіске жету үшін➡
Dialogue: 0,1:25:00.13,1:25:04.47,Default,,0000,0000,0000,,Жалпы стратегиялық жорамалдарға шолу
Dialogue: 0,1:25:00.13,1:25:04.47,Default,,0000,0000,0000,,Мен осыны талап етіп отырмын.
Dialogue: 0,1:25:04.47,1:25:07.30,Default,,0000,0000,0000,,Дұрыс айтасыз.
Dialogue: 0,1:25:04.47,1:25:07.30,Default,,0000,0000,0000,,Мәртебелі.
Dialogue: 0,1:25:07.30,1:25:10.47,Default,,0000,0000,0000,,Ағымдағы табыс тәжірибеңізге
Dialogue: 0,1:25:07.30,1:25:10.47,Default,,0000,0000,0000,,Көп ұстанбаңыз➡
Dialogue: 0,1:25:10.47,1:25:15.31,Default,,0000,0000,0000,,Тактикалық зерттеулер мен адам ресурстарын дамыту арқылы
Dialogue: 0,1:25:10.47,1:25:15.31,Default,,0000,0000,0000,,Бірлескен әрекет ететін күштер.
Dialogue: 0,1:25:15.31,1:25:19.48,Default,,0000,0000,0000,,Бұл сіздің жеңу мүмкіндігіңіз
Dialogue: 0,1:25:15.31,1:25:19.48,Default,,0000,0000,0000,,Қосылатынымызға сенеміз.
Dialogue: 0,1:25:19.48,1:25:24.32,Default,,0000,0000,0000,,Ал сіз зерттеу және тергеу әрекеттеріне қатысасыз.
Dialogue: 0,1:25:19.48,1:25:24.32,Default,,0000,0000,0000,,Сіз жеңгіңіз келе ме?
Dialogue: 0,1:25:24.32,1:25:28.16,Default,,0000,0000,0000,,Артқы жағында
Dialogue: 0,1:25:24.32,1:25:28.16,Default,,0000,0000,0000,,Әскери күштерді орынды пайдалану және ➡
Dialogue: 0,1:25:28.16,1:25:31.49,Default,,0000,0000,0000,,Мен әскерді жетілдіру жолдарын зерттегім келеді.
Dialogue: 0,1:25:28.16,1:25:31.49,Default,,0000,0000,0000,,Иә.
Dialogue: 0,1:25:31.49,1:25:34.30,Default,,0000,0000,0000,,Нақты жоспар құрылды.
Dialogue: 0,1:25:38.00,1:25:42.84,Default,,0000,0000,0000,,《Тым логикалық.
Dialogue: 0,1:25:38.00,1:25:42.84,Default,,0000,0000,0000,,Мұқият дайындалды.
Dialogue: 0,1:25:42.84,1:25:45.64,Default,,0000,0000,0000,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,1:25:42.84,1:25:45.64,Default,,0000,0000,0000,,Бұл қаншалықты қорқынышты?
Dialogue: 0,1:25:48.34,1:25:53.01,Default,,0000,0000,0000,,Бұл өте ұзақ процесс.
Dialogue: 0,1:25:53.01,1:25:56.68,Default,,0000,0000,0000,,Сіз бір нәрсені ұмытқан сияқтысыз.
Dialogue: 0,1:25:56.68,1:26:01.39,Default,,0000,0000,0000,,Соғыс әдісі қандай?
Dialogue: 0,1:25:56.68,1:26:01.39,Default,,0000,0000,0000,,Сіз мұны осылай жасайсыз!
Dialogue: 0,1:26:07.80,1:26:12.63,Default,,0000,0000,0000,,Соққы күші!
Dialogue: 0,1:26:07.80,1:26:12.63,Default,,0000,0000,0000,,Бізде, Империяда, мұндай күш бар!
Dialogue: 0,1:26:12.63,1:26:16.97,Default,,0000,0000,0000,,Соғыс менмендік емес.
Dialogue: 0,1:26:12.63,1:26:16.97,Default,,0000,0000,0000,,Бұл ерік-жігер мәселесі.
Dialogue: 0,1:26:16.97,1:26:20.81,Default,,0000,0000,0000,,Есте сақтау жақсы.
Dialogue: 0,1:26:20.81,1:26:26.15,Default,,0000,0000,0000,,Империя ұлы мәртебелі жұдырықтай
Dialogue: 0,1:26:20.81,1:26:26.15,Default,,0000,0000,0000,,Бұл ауырады.
Dialogue: 0,1:26:26.15,1:26:28.98,Default,,0000,0000,0000,,Қан көп ағып жатыр.
Dialogue: 0,1:26:28.98,1:26:34.32,Default,,0000,0000,0000,,Мәселе жоқ! Тіпті осы қолмен
Dialogue: 0,1:26:28.98,1:26:34.32,Default,,0000,0000,0000,,Бокс жеткілікті!
Dialogue: 0,1:26:34.32,1:26:39.49,Default,,0000,0000,0000,,Мен жалғыз болсам да
Dialogue: 0,1:26:34.32,1:26:39.49,Default,,0000,0000,0000,,Біз күресуіміз керек!
Dialogue: 0,1:26:39.49,1:26:45.50,Default,,0000,0000,0000,,Жоғары мәртебелі, бұл шайқастан тыс
Dialogue: 0,1:26:39.49,1:26:45.50,Default,,0000,0000,0000,,Нақты не бар?
Dialogue: 0,1:26:47.50,1:26:50.17,Default,,0000,0000,0000,,Соғыс және саясат.
Dialogue: 0,1:26:50.17,1:26:52.67,Default,,0000,0000,0000,,Дипломатия құралдарының бірі.
Dialogue: 0,1:26:52.67,1:26:57.51,Default,,0000,0000,0000,,Сондықтан дұрыс күрес
Dialogue: 0,1:26:52.67,1:26:57.51,Default,,0000,0000,0000,,Егер аяқтай алмасаңыз➡
Dialogue: 0,1:26:57.51,1:27:01.78,Default,,0000,0000,0000,,Алда не күтіп тұр?
Dialogue: 0,1:26:57.51,1:27:01.78,Default,,0000,0000,0000,,Келесі соғыс үшін➡
Dialogue: 0,1:27:01.78,1:27:04.29,Default,,0000,0000,0000,,Жай дайындық кезеңі.
Dialogue: 0,1:27:04.29,1:27:07.99,Default,,0000,0000,0000,,Жаңа ақымақтық
Dialogue: 0,1:27:04.29,1:27:07.99,Default,,0000,0000,0000,,Бұл бастама болуы мүмкін.
Dialogue: 0,1:27:12.29,1:27:17.30,Default,,0000,0000,0000,,T: Бүгін айтатын сөздерім осы ғана.
Dialogue: 0,1:27:12.29,1:27:17.30,Default,,0000,0000,0000,,Бәрін қирату отымен өртеп жібер➡
Dialogue: 0,1:27:17.30,1:27:22.50,Default,,0000,0000,0000,,Қалған күйген жер
Dialogue: 0,1:27:17.30,1:27:22.50,Default,,0000,0000,0000,,Бұл тек жер болуы мүмкін.
Dialogue: 0,1:27:28.14,1:27:32.98,Default,,0000,0000,0000,,Дүниені жаулап алсаң да
Dialogue: 0,1:27:28.14,1:27:32.98,Default,,0000,0000,0000,,Тіпті супердержаваға айналса да➡
Dialogue: 0,1:27:32.98,1:27:37.29,Default,,0000,0000,0000,,Конфликттің тағы бір түрі
Dialogue: 0,1:27:32.98,1:27:37.29,Default,,0000,0000,0000,,Ол енді ғана туады.
Dialogue: 0,1:27:41.16,1:27:44.16,Default,,0000,0000,0000,,Даңқ ортасында, Арқасынан пышақпен➡
Dialogue: 0,1:27:44.16,1:27:47.86,Default,,0000,0000,0000,,Сіз бәрін жоғалтуыңыз мүмкін
Dialogue: 0,1:27:44.16,1:27:47.86,Default,,0000,0000,0000,,Дүние.
Dialogue: 0,1:27:52.50,1:27:56.67,Default,,0000,0000,0000,,Жоғары мәртебелі мырза айтқандай.
Dialogue: 0,1:27:52.50,1:27:56.67,Default,,0000,0000,0000,,Біріншіден, жеңіс – бәрі.
Dialogue: 0,1:27:56.67,1:27:59.67,Default,,0000,0000,0000,,Дегенмен
Dialogue: 0,1:27:56.67,1:27:59.67,Default,,0000,0000,0000,,Сіз дұрыс жеңуіңіз керек.
Dialogue: 0,1:27:59.67,1:28:05.11,Default,,0000,0000,0000,,болмаса
Dialogue: 0,1:27:59.67,1:28:05.11,Default,,0000,0000,0000,,Тарих саған күледі.
Dialogue: 0,1:28:05.11,1:28:09.82,Default,,0000,0000,0000,,Соғыс
Dialogue: 0,1:28:05.11,1:28:09.82,Default,,0000,0000,0000,,Маңыздысы сіздің қалай жеңгеніңіз.
Dialogue: 0,1:28:13.79,1:28:17.29,Default,,0000,0000,0000,,Екі ай жасайық.
Dialogue: 0,1:28:13.79,1:28:17.29,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:28:17.29,1:28:23.80,Default,,0000,0000,0000,,Менің билігіммен Батысқа тағайындалды.
Dialogue: 0,1:28:17.29,1:28:23.80,Default,,0000,0000,0000,,Одан кейін нәтижеге байланысты.
Dialogue: 0,1:28:23.80,1:28:28.14,Default,,0000,0000,0000,,Шұғыл
Dialogue: 0,1:28:23.80,1:28:28.14,Default,,0000,0000,0000,,Ұрыс сабақтары мен әдістерін зерттеу үшін бар күшіңізді салыңыз.
Dialogue: 0,1:28:28.14,1:28:31.34,Default,,0000,0000,0000,,Бұл дегеніміз...
Dialogue: 0,1:28:33.31,1:28:38.65,Default,,0000,0000,0000,,Әй, бұл сіз қалайтын тылдағы міндет.
Dialogue: 0,1:28:38.65,1:28:41.15,Default,,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,1:28:47.49,1:28:49.49,Default,,0000,0000,0000,,(есік жабылған дыбыс)
Dialogue: 0,1:28:52.16,1:28:57.33,Default,,0000,0000,0000,,《Таня фон Дегуречаф.
Dialogue: 0,1:28:52.16,1:28:57.33,Default,,0000,0000,0000,,Жауынгерлік фанат және стратег.
Dialogue: 0,1:28:57.33,1:29:00.60,Default,,0000,0000,0000,,Және балалар.
Dialogue: 0,1:29:00.60,1:29:06.44,Default,,0000,0000,0000,,Ұлттың тілегі де осы еді
Dialogue: 0,1:29:00.60,1:29:06.44,Default,,0000,0000,0000,,Бұл сарбаздың соңғы түрі ме?
Dialogue: 0,1:29:06.44,1:29:11.11,Default,,0000,0000,0000,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,1:29:06.44,1:29:11.11,Default,,0000,0000,0000,,Сіз бұл ақылсыз жанжал әлеміндесіз➡
Dialogue: 0,1:29:11.11,1:29:14.02,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? 》
Dialogue: 0,1:29:29.13,1:29:34.64,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,1:29:34.64,1:29:40.48,Default,,0000,0000,0000,,Армандарыңыздың тылында еңбек ету!
Dialogue: 0,1:29:34.64,1:29:40.48,Default,,0000,0000,0000,,Бейбіт күндер!
Dialogue: 0,1:29:40.48,1:29:43.48,Default,,0000,0000,0000,,Құдайдың күші
Dialogue: 0,1:29:40.48,1:29:43.48,Default,,0000,0000,0000,,Қатал тағдыр➡
Dialogue: 0,1:29:43.48,1:29:47.48,Default,,0000,0000,0000,,Орындауға ешқандай себеп жоқ!
Dialogue: 0,1:29:47.48,1:29:52.49,Default,,0000,0000,0000,,Құдайға ықыласпен
Dialogue: 0,1:29:47.48,1:29:52.49,Default,,0000,0000,0000,,Сіз көмек сұрай алмайсыз!
Dialogue: 0,1:29:52.49,1:29:57.16,Default,,0000,0000,0000,,Тартылған карталарды пайдалану
Dialogue: 0,1:29:52.49,1:29:57.16,Default,,0000,0000,0000,,Өз болашағыңды қолға ал!
Dialogue: 0,1:29:57.16,1:30:02.06,Default,,0000,0000,0000,,Бұл адамдық артықшылық!
Dialogue: 0,1:29:57.16,1:30:02.06,Default,,0000,0000,0000,,Бұл адамның жағдайы!
Dialogue: 0,1:30:04.17,1:30:10.17,Default,,0000,0000,0000,,Бұл өкінішті болды, Existence X.
Dialogue: 0,1:30:15.01,1:31:09.16,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:31:09.16,1:31:16.00,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:31:16.00,1:31:51.37,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:31:51.37,1:31:55.54,Default,,0000,0000,0000,,Батыстан шығысқа және қайтадан батысқа қарай?
Dialogue: 0,1:31:55.54,1:31:58.38,Default,,0000,0000,0000,,Алайда, бұл жолы кері.
Dialogue: 0,1:31:58.38,1:32:02.15,Default,,0000,0000,0000,,Жақсырақ
Dialogue: 0,1:31:58.38,1:32:02.15,Default,,0000,0000,0000,,Мен энергияны дамытқым келеді.
Dialogue: 0,1:32:02.15,1:32:07.82,Default,,0000,0000,0000,,Мен өзімді летаргиялық және мазасыз сезінемін.
Dialogue: 0,1:32:02.15,1:32:07.82,Default,,0000,0000,0000,,Бұл толық фронт синдромы.
Dialogue: 0,1:32:07.82,1:32:11.83,Default,,0000,0000,0000,,Шынымен, неге?
Dialogue: 0,1:32:07.82,1:32:11.83,Default,,0000,0000,0000,,Мен осылай болды деп ойлаймын.
Dialogue: 0,1:32:17.33,1:32:21.50,Default,,0000,0000,0000,,《Күтілгендей
Dialogue: 0,1:32:17.33,1:32:21.50,Default,,0000,0000,0000,,Дұрыс жерде дұрыс адам - ​​дүниенің билігі.
Dialogue: 0,1:32:21.50,1:32:28.31,Default,,0000,0000,0000,,Тұрақты өнімділікті сақтауды жалғастырыңыз.
Dialogue: 0,1:32:21.50,1:32:28.31,Default,,0000,0000,0000,,Мен өмір бойы партада жұмыс істеуді жоспарлап отырмын.
Dialogue: 0,1:32:40.19,1:32:43.52,Default,,0000,0000,0000,,☎
Dialogue: 0,1:32:43.52,1:32:46.86,Default,,0000,0000,0000,,☎Иә Жауынгерлік өнер зертханасы
Dialogue: 0,1:32:43.52,1:32:46.86,Default,,0000,0000,0000,,Бұл подполковник Дегуречаф.
Dialogue: 0,1:32:46.86,1:32:49.03,Default,,0000,0000,0000,,Сәттілік, подполковник.
Dialogue: 0,1:32:49.03,1:32:53.70,Default,,0000,0000,0000,,Жоғары мәртебелі! Түсінгеніңізге рахмет.
Dialogue: 0,1:32:49.03,1:32:53.70,Default,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,1:32:53.70,1:32:57.87,Default,,0000,0000,0000,,Сіздің қабілетіңіз қандай?
Dialogue: 0,1:32:53.70,1:32:57.87,Default,,0000,0000,0000,,Әділ бағалауға дейін.
Dialogue: 0,1:32:57.87,1:33:00.14,Default,,0000,0000,0000,,☎Құрметтен асып кеттім.
Dialogue: 0,1:33:00.14,1:33:05.65,Default,,0000,0000,0000,,Ал штаб бастықтары сіздің ұсыныстарыңызды ескереді.
Dialogue: 0,1:33:00.14,1:33:05.65,Default,,0000,0000,0000,,Оны жалпы қабылдау туралы шешім қабылданды.
Dialogue: 0,1:33:05.65,1:33:08.48,Default,,0000,0000,0000,,☎Міне, солай! Міне бітті!
Dialogue: 0,1:33:05.65,1:33:08.48,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,1:33:08.48,1:33:12.65,Default,,0000,0000,0000,,☎ (Зетур) Тиісті күш
Dialogue: 0,1:33:08.48,1:33:12.65,Default,,0000,0000,0000,,Бұл операциялық пайдалануға арналған далалық зерттеу.
Dialogue: 0,1:33:12.65,1:33:16.49,Default,,0000,0000,0000,,☎Алдыңғы шепте
Dialogue: 0,1:33:12.65,1:33:16.49,Default,,0000,0000,0000,,Оны орындаушының өзі орындауын сұраңыз.
Dialogue: 0,1:33:16.49,1:33:18.49,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:33:21.50,1:33:23.66,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1:33:21.50,1:33:23.66,Default,,0000,0000,0000,,Құттықтаймыз.
Dialogue: 0,1:33:23.66,1:33:26.50,Default,,0000,0000,0000,,Мен жаңа жауынгерлік топ құрамын.
Dialogue: 0,1:33:26.50,1:33:29.50,Default,,0000,0000,0000,,☎Ой, уайымдама.
Dialogue: 0,1:33:26.50,1:33:29.50,Default,,0000,0000,0000,,Сіздің әскерлеріңіз➡
Dialogue: 0,1:33:29.50,1:33:35.01,Default,,0000,0000,0000,,2○3 Air Magic батальонын тағайындаңыз.
Dialogue: 0,1:33:29.50,1:33:35.01,Default,,0000,0000,0000,,Мен оны қозғамаймын.
Dialogue: 0,1:33:35.01,1:33:40.35,Default,,0000,0000,0000,,☎Сонымен қатар жаяу әскер батальондары
Dialogue: 0,1:33:35.01,1:33:40.35,Default,,0000,0000,0000,,Бронды роталар мен артиллериядан басқа ➡
Dialogue: 0,1:33:40.35,1:33:44.02,Default,,0000,0000,0000,,Кадр мәселесінде еркіндікке рұқсат етейік.
Dialogue: 0,1:33:44.02,1:33:49.02,Default,,0000,0000,0000,,☎Бұл ерекше жағдай болса да
Dialogue: 0,1:33:44.02,1:33:49.02,Default,,0000,0000,0000,,Бұл императорлық армияның алғашқы жауынгерлік тобы.
Dialogue: 0,1:33:49.02,1:33:54.36,Default,,0000,0000,0000,,Ресми түрде Бас штабтың тікелей бақылауындағы Сынақ жауынгерлік командасы.
Атауы
Dialogue: 0,1:33:49.02,1:33:54.36,Default,,0000,0000,0000,,➡
Dialogue: 0,1:33:54.36,1:33:56.70,Default,,0000,0000,0000,,Бұл өте жұмсақ.
Dialogue: 0,1:33:56.70,1:34:01.80,Default,,0000,0000,0000,,Сондықтан кодтар жиыны Саламандер болып табылады.
Dialogue: 0,1:34:01.80,1:34:05.47,Default,,0000,0000,0000,,☎Бұл Саламандердің жауынгерлік командасы.
Dialogue: 0,1:34:05.47,1:34:07.81,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,1:34:07.81,1:34:13.48,Default,,0000,0000,0000,,Тыл жұмысына кімдер рұқсат етілді?
Dialogue: 0,1:34:07.81,1:34:13.48,Default,,0000,0000,0000,,Мұндай жоспар болды ма?
Dialogue: 0,1:34:13.48,1:34:19.32,Default,,0000,0000,0000,,Жоспар немесе ештеңе жоқ, тек өз қалауы.
Dialogue: 0,1:34:19.32,1:34:31.67,Default,,0000,0000,0000,,(Мұғалім) Символизацияланған жау нысанаға ілініп, оған жақындайды. ➡
Dialogue: 0,1:34:31.67,1:34:36.00,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,1:34:36.00,1:34:41.61,Default,,0000,0000,0000,,Бұл қалай болды!?
Dialogue: 0,1:34:43.11,1:34:49.11,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory