Dialogue: 0,0:00:38.43,0:00:41.06,Default CN,,0,0,0,,...
Dialogue: 1,0:00:42.23,0:00:44.48,Default CN,,0,0,0,,...
Dialogue: 0,0:00:42.23,0:00:44.48,Default CN,,0,0,0,,...
Dialogue: 0,0:01:13.68,0:01:14.55,Default CN,,0,0,0,,Өсу әлеуеті
Dialogue: 0,0:01:19.64,0:01:20.73,Default CN,,0,0,0,,Шынайы ойдан шығарылған
Dialogue: 0,0:01:20.73,0:01:21.81,Default CN,,0,0,0,,...
Dialogue: 0,0:01:21.81,0:01:23.31,Default CN,,0,0,0,,Алдыңғы әңгімеден шықпай бұрын айтылған
Dialogue: 0,0:01:23.31,0:01:25.15,Default CN,,0,0,0,,Шындық – ақиқат
Dialogue: 0,0:01:46.21,0:01:48.67,Default CN,,0,0,0,,Роши Масая және т.б.
Dialogue: 0,0:01:57.68,0:01:58.77,Default CN,,0,0,0,,Сәлем
Dialogue: 0,0:02:00.02,0:02:01.48,Default CN,,0,0,0,,Сіз Анси-син Доксусыз.
Dialogue: 0,0:02:03.56,0:02:05.48,Default CN,,0,0,0,,Гакоу Китажима
Dialogue: 0,0:02:05.48,0:02:06.69,Default CN,,0,0,0,,Мен отыра аламын
Dialogue: 0,0:02:14.11,0:02:17.99,Default CN,,0,0,0,,Шиндонгаку - қар бөлімі 2-ші орта мектептің бесінші оқушысы
Dialogue: 0,0:02:18.83,0:02:19.95,Default CN,,0,0,0,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:02:20.66,0:02:22.33,Default CN,,0,0,0,,Мен Коренари сияқты студент едім.
Dialogue: 0,0:02:24.21,0:02:25.29,Default CN,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:02:28.88,0:02:30.05,Default CN,,0,0,0,,Салыстыру
Dialogue: 0,0:02:30.05,0:02:31.67,Default CN,,0,0,0,,Менің арманым
Dialogue: 0,0:02:32.97,0:02:34.59,Default CN,,0,0,0,,Мектепке келген бір оқушы
Dialogue: 0,0:02:35.64,0:02:38.18,Default CN,,0,0,0,,Накако – қаланың көрнекті оқушысы.
Dialogue: 0,0:02:39.01,0:02:41.31,Default CN,,0,0,0,,Бір мектепте оқымау
Dialogue: 0,0:02:41.31,0:02:43.18,Default CN,,0,0,0,,Назар аударыңыз!
Dialogue: 0,0:02:43.68,0:02:47.56,Default CN,,0,0,0,,Күн нұрын шашады, Мен оны күлімдеп айтамын.
Dialogue: 0,0:02:47.56,0:02:50.48,Default CN,,0,0,0,,Йошихисаның ұялшақтығы
Dialogue: 0,0:02:50.48,0:02:52.15,Default CN,,0,0,0,,Мен радиалды бағытқа қарай жүгіремін.
Dialogue: 0,0:02:52.90,0:02:54.20,Default CN,,0,0,0,,Окато Коджин экраны
Dialogue: 0,0:02:54.74,0:02:58.99,Default CN,,0,0,0,,Бұл күткендей өмір сүре алудың кереметі.
Dialogue: 0,0:03:01.12,0:03:05.25,Default CN,,0,0,0,,Дегенмен, мен Насаның кереметін білдім.
Dialogue: 0,0:03:26.94,0:03:28.15,Default CN,,0,0,0,,Нагадан шығу
Dialogue: 0,0:03:28.69,0:03:29.81,Default CN,,0,0,0,,Бір жақты жел
Dialogue: 0,0:03:36.53,0:03:37.70,Default CN,,0,0,0,,...
Dialogue: 0,0:03:37.70,0:03:38.74,Default CN,,0,0,0,,Маған қиын
Dialogue: 0,0:03:40.41,0:03:41.62,Default CN,,0,0,0,,...
Dialogue: 0,0:03:43.45,0:03:45.12,Default CN,,0,0,0,,Кадзуно Мэй Казуто
Dialogue: 0,0:03:45.62,0:03:47.33,Default CN,,0,0,0,,Бұл Казунокидің алдындағы саусақ па?
Dialogue: 0,0:03:49.67,0:03:50.59,Default CN,,0,0,0,,Бұл түсініктеме…
Dialogue: 0,0:03:51.25,0:03:53.09,Default CN,,0,0,0,,Мектепті бітіргеннен кейін
Dialogue: 0,0:03:55.97,0:03:57.30,Default CN,,0,0,0,,Ешқашан кетпеңіз
Dialogue: 0,0:03:57.30,0:03:58.51,Default CN,,0,0,0,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:04:13.94,0:04:15.40,Default CN,,0,0,0,,анық және теріс
Dialogue: 0,0:04:15.99,0:04:17.65,Default CN,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:04:19.78,0:04:21.32,Default CN,,0,0,0,,Йошиёши Хаяками
Dialogue: 0,0:04:22.28,0:04:24.87,Default CN,,0,0,0,,Мен Анзайды ойлап отырмын.
Dialogue: 0,0:04:25.66,0:04:28.87,Default CN,,0,0,0,,Дегенмен, менің физикалық жағдайым ұнамайды.
Dialogue: 0,0:04:28.87,0:04:30.83,Default CN,,0,0,0,,Қазір кету мүмкін емес.
Dialogue: 0,0:04:32.29,0:04:35.80,Default CN,,0,0,0,,Мэй Мин - Сюзи Пейннің шындығы
Dialogue: 0,0:05:41.53,0:05:42.66,Default CN,,0,0,0,,Комое
Dialogue: 0,0:06:23.40,0:06:25.11,Default CN,,0,0,0,,Ояну
Dialogue: 0,0:06:25.11,0:06:27.07,Default CN,,0,0,0,,Елорданың айқайы оянды
Dialogue: 0,0:06:37.75,0:06:39.42,Default CN,,0,0,0,,Анзай Шин Догакуға қош келдіңіз
Dialogue: 0,0:06:39.42,0:06:41.09,Default CN,,0,0,0,,Намаз оқып жүргеніме көп болды
Dialogue: 0,0:06:42.42,0:06:43.63,Default CN,,0,0,0,,Полпо
Dialogue: 0,0:07:15.71,0:07:17.25,Default CN,,0,0,0,,Форт
Dialogue: 0,0:07:18.79,0:07:19.75,Default CN,,0,0,0,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:07:19.75,0:07:21.46,Default CN,,0,0,0,,Оны қайдан көріп тұрсың?
Dialogue: 0,0:07:21.46,0:07:25.17,Default CN,,0,0,0,,Қамал бекінісіне келген қонақ
Dialogue: 0,0:07:38.85,0:07:39.90,Default CN,,0,0,0,,Бөлек
Dialogue: 0,0:07:39.90,0:07:40.65,Default CN,,0,0,0,,Гайо Кайру
Dialogue: 0,0:07:40.65,0:07:41.86,Default CN,,0,0,0,,Өзін-өзі босату
Dialogue: 0,0:07:41.86,0:07:43.19,Default CN,,0,0,0,,Жабық тұмсық
Dialogue: 0,0:07:44.11,0:07:46.07,Default CN,,0,0,0,,6 адамға арналған ойын-сауық аяқталды
Dialogue: 0,0:07:46.07,0:07:48.49,Default CN,,0,0,0,,Мен кездесуді мүмкіндігінше тез қабылдадым.
Dialogue: 0,0:07:48.49,0:07:50.20,Default CN,,0,0,0,,Сіз соңғы адамсыз
Dialogue: 0,0:07:50.20,0:07:51.70,Default CN,,0,0,0,,Алайда астана төрт нүктеге жетті.
Dialogue: 0,0:07:52.87,0:07:54.79,Default CN,,0,0,0,,Мен бұл туралы ойлап отырмын.
Dialogue: 0,0:07:58.37,0:07:59.92,Default CN,,0,0,0,,Өзін-өзі босату
Dialogue: 0,0:07:59.92,0:08:02.17,Default CN,,0,0,0,,Сіз кімді басқара аласыз?
Dialogue: 0,0:08:02.63,0:08:04.80,Default CN,,0,0,0,,Сіз жолға қызықпайсыз.
Dialogue: 0,0:08:04.80,0:08:06.67,Default CN,,0,0,0,,Сіз оны көз алдыңызда көре аласыз.
Dialogue: 0,0:08:06.67,0:08:08.76,Default CN,,0,0,0,,Оқуға болатын шағын әңгіме
Dialogue: 0,0:08:08.76,0:08:10.01,Default CN,,0,0,0,,Дегенмен, күш өте ерекше.
Dialogue: 0,0:08:12.05,0:08:14.47,Default CN,,0,0,0,,Шытырман оқиға осылай басталды.
Dialogue: 0,0:08:14.47,0:08:16.27,Default CN,,0,0,0,,Біртүрлі әлем
Dialogue: 0,0:08:16.27,0:08:17.52,Default CN,,0,0,0,,Егер сізде ешқандай үміт болмаса
Dialogue: 0,0:08:17.85,0:08:18.60,Default CN,,0,0,0,,Көңілсіздік
Dialogue: 0,0:08:18.60,0:08:20.60,Default CN,,0,0,0,,Істегіңіз келетін нәрсе шын мәнінде орындалады.
Dialogue: 0,0:08:21.40,0:08:25.32,Default CN,,0,0,0,,Мен сізге қарапайым адам ретінде не істегіңіз келетінін айта аламын.
Dialogue: 0,0:08:25.86,0:08:26.82,Default CN,,0,0,0,,Қалау?
Dialogue: 0,0:09:03.40,0:09:04.98,Default CN,,0,0,0,,Сізбен бірге серік және т.б.
Dialogue: 0,0:09:27.92,0:09:29.13,Default CN,,0,0,0,,Сәлем
Dialogue: 0,0:09:31.47,0:09:33.34,Default CN,,0,0,0,,Үй иесі астанада
Dialogue: 0,0:09:34.22,0:09:36.39,Default CN,,0,0,0,,Сіз соңғысысыз
Dialogue: 0,0:09:36.39,0:09:37.01,Default CN,,0,0,0,,Накако…
Dialogue: 0,0:09:38.60,0:09:39.85,Default CN,,0,0,0,,Айқайлаған қасқыр ересек
Dialogue: 0,0:09:41.56,0:09:43.81,Default CN,,0,0,0,,Нана қасқырдың ересек тілі
Dialogue: 0,0:09:44.36,0:09:46.61,Default CN,,0,0,0,,Жеті адамның өлімі басталады
Dialogue: 0,0:09:46.98,0:09:48.23,Default CN,,0,0,0,,Менің мұны істеуім мүмкін.
Dialogue: 0,0:09:48.94,0:09:50.57,Default CN,,0,0,0,,Аз уақыттан кейін
Dialogue: 0,0:09:50.86,0:09:51.95,Default CN,,0,0,0,,Э-э...
Dialogue: 0,0:09:51.95,0:09:54.16,Default CN,,0,0,0,,Бұл өмірде бір рет болатын нәрсе.
Dialogue: 0,0:09:54.16,0:09:55.32,Default CN,,0,0,0,,Жалға берушінің резиденциясы
Dialogue: 0,0:09:55.62,0:09:57.03,Default CN,,0,0,0,,...
Dialogue: 0,0:09:57.62,0:10:01.08,Default CN,,0,0,0,,Туған ауылға айнаның нұры келді.
Dialogue: 0,0:10:01.08,0:10:02.67,Default CN,,0,0,0,,Мен бірінші табиғимын
Dialogue: 0,0:10:02.67,0:10:04.54,Default CN,,0,0,0,,Осыдан кейін тағы бір бала жиналды.
Dialogue: 0,0:10:05.33,0:10:07.88,Default CN,,0,0,0,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:10:07.88,0:10:09.55,Default CN,,0,0,0,,Дегенмен, маған ұнамайтыны анық.
Dialogue: 0,0:10:11.13,0:10:12.38,Default CN,,0,0,0,,Жою
Dialogue: 0,0:10:12.88,0:10:13.88,Default CN,,0,0,0,,Түсініксіз
Dialogue: 0,0:10:14.43,0:10:15.14,Default CN,,0,0,0,,Толық түсініксіз
Dialogue: 0,0:10:18.06,0:10:19.93,Default CN,,0,0,0,,Наганың соңғы оқиғасы
Dialogue: 0,0:10:19.93,0:10:20.89,Default CN,,0,0,0,,Мен бұған ризамын.
Dialogue: 0,0:10:22.73,0:10:26.90,Default CN,,0,0,0,,Қамал қамалында адам жүріп жатқан белгілі бір камера бар.
Dialogue: 0,0:10:28.86,0:10:30.69,Default CN,,0,0,0,,«Тілек уақыты» айқайы
Dialogue: 0,0:10:30.69,0:10:34.36,Default CN,,0,0,0,,Сіз кеңседе не істегіңіз келеді?
Dialogue: 0,0:10:37.99,0:10:38.78,Default CN,,0,0,0,,Бұл рөл де біраз қиын екен…
Dialogue: 0,0:10:38.78,0:10:42.33,Default CN,,0,0,0,,Бөлмеге жеті адамның біреуі ғана кіре алады
Dialogue: 0,0:10:43.29,0:10:44.58,Default CN,,0,0,0,,Кішкентай қызыл қалпақ
Dialogue: 0,0:10:46.33,0:10:49.63,Default CN,,0,0,0,,Бұл «лабиринт тәрізді қызыл қалпақ»
Dialogue: 0,0:10:51.71,0:10:53.76,Default CN,,0,0,0,,«Тілек уақыты»
Dialogue: 0,0:10:53.76,0:10:54.76,Default CN,,0,0,0,,Сізге қасық керек
Dialogue: 0,0:10:55.47,0:10:58.30,Default CN,,0,0,0,,Жастар нағыз болғысы келетін адамдар.
Dialogue: 0,0:10:58.30,0:11:01.22,Default CN,,0,0,0,,Ағымдағы күй: 30 наурыз, 2017 ж
Dialogue: 0,0:11:01.64,0:11:05.48,Default CN,,0,0,0,,Қамалдағы белгілі бір қамалдың қасық
Dialogue: 0,0:11:05.85,0:11:07.69,Default CN,,0,0,0,,...
Dialogue: 0,0:11:07.69,0:11:08.44,Default CN,,0,0,0,,Бұл...
Dialogue: 0,0:11:08.77,0:11:11.48,Default CN,,0,0,0,,Артық емес, қадірі жоқ.
Dialogue: 0,0:11:12.61,0:11:14.45,Default CN,,0,0,0,,Сіз шынымен көргіңіз келетін нәрсе - бұл не істегіңіз келетіні
Dialogue: 0,0:11:14.82,0:11:16.91,Default CN,,0,0,0,,Менің қайда екенімді білгің келсе,
Dialogue: 0,0:11:16.91,0:11:18.32,Default CN,,0,0,0,,Бұл басқамен бірдей.
Dialogue: 0,0:11:18.32,0:11:19.78,Default CN,,0,0,0,,Жарайды, бұл тек менің жеке пікірім ғана.
Dialogue: 0,0:11:19.78,0:11:20.62,Default CN,,0,0,0,,Жабық тұмсық Жабық тұмсық
Dialogue: 0,0:11:21.29,0:11:23.04,Default CN,,0,0,0,,Жауап сізге ұнамаса
Dialogue: 0,0:11:24.00,0:11:25.83,Default CN,,0,0,0,,Бұл менің міндетім.
Dialogue: 0,0:11:26.71,0:11:29.42,Default CN,,0,0,0,,Сіздің шынайы өлім арманыңыз
Dialogue: 0,0:11:29.42,0:11:33.17,Default CN,,0,0,0,,Әңгіменің бас кейіпкерінің өзін таңдаған әсері
Dialogue: 0,0:11:33.17,0:11:36.18,Default CN,,0,0,0,,Екі қабатты филиал
Dialogue: 0,0:11:36.18,0:11:37.55,Default CN,,0,0,0,,Бірнеше жүгіру
Dialogue: 0,0:11:37.55,0:11:38.64,Default CN,,0,0,0,,Жұмысқа келу
Dialogue: 0,0:11:38.97,0:11:41.06,Default CN,,0,0,0,,...
Dialogue: 0,0:11:41.43,0:11:42.26,Default CN,,0,0,0,,Бір нәрсе дұрыс емес.
Dialogue: 0,0:11:42.77,0:11:44.18,Default CN,,0,0,0,,Нага сұрақтары
Dialogue: 0,0:11:44.18,0:11:46.44,Default CN,,0,0,0,,Қатыспағыңыз келсе
Dialogue: 0,0:11:51.15,0:11:54.23,Default CN,,0,0,0,,...
Dialogue: 0,0:11:54.23,0:11:56.03,Default CN,,0,0,0,,Маңызды мәселелер бірінші кезекте шешіледі
Dialogue: 0,0:11:56.36,0:11:59.32,Default CN,,0,0,0,,Белгілі бір адам қасыққа қалай келді?
Dialogue: 0,0:11:59.32,0:12:01.28,Default CN,,0,0,0,,Аяқталған ойын алаңы
Dialogue: 0,0:12:02.49,0:12:03.95,Default CN,,0,0,0,,Қамал қақпасының қоршауы
Dialogue: 0,0:12:03.95,0:12:06.16,Default CN,,0,0,0,,Йокогамаға қосылған жолдар да жабылған.
Dialogue: 0,0:12:07.37,0:12:10.83,Default CN,,0,0,0,,Қиялдың жоқ екені рас.
Dialogue: 0,0:12:10.83,0:12:11.75,Default CN,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:12:13.00,0:12:15.05,Default CN,,0,0,0,,Токиоға баратын уақыт келгенде
Dialogue: 0,0:12:15.05,0:12:17.09,Default CN,,0,0,0,,Бұл шектеулі
Dialogue: 0,0:12:17.09,0:12:20.01,Default CN,,0,0,0,,Қазіргі жапон уақыты таңертең 9 балл, түстен кейін 5 балл.
Dialogue: 0,0:12:20.01,0:12:22.64,Default CN,,0,0,0,,Сағат тоғыздың таңы қала үкіметіне ұқсайды.
Dialogue: 0,0:12:23.06,0:12:27.43,Default CN,,0,0,0,,Бұзбау керек.
Dialogue: 0,0:12:27.43,0:12:29.98,Default CN,,0,0,0,,Түсте бес нүктенің қалай жоғалып кеткені туралы әңгіме...
Dialogue: 0,0:12:30.69,0:12:31.81,Default CN,,0,0,0,,Жұмысқа қатысу
Dialogue: 0,0:12:32.94,0:12:33.65,Default CN,,0,0,0,,Бағынады
Dialogue: 0,0:12:34.11,0:12:35.86,Default CN,,0,0,0,,Нағыз қасқыр
Dialogue: 0,0:12:35.86,0:12:37.49,Default CN,,0,0,0,,Дегенмен, ол өте үлкен.
Dialogue: 0,0:12:38.24,0:12:40.74,Default CN,,0,0,0,,Опасыз және көзге көрінбейтін тексеру
Dialogue: 0,0:12:40.74,0:12:42.12,Default CN,,0,0,0,,Аяқталған қабылдау
Dialogue: 0,0:12:42.87,0:12:43.87,Default CN,,0,0,0,,Және
Dialogue: 0,0:12:43.87,0:12:46.54,Default CN,,0,0,0,,Біреудің қалай бұзып өтуі туралы қысқаша әңгіме
Dialogue: 0,0:12:46.54,0:12:49.96,Default CN,,0,0,0,,Басқа тұлғаның қаласын «бірінші келген» қағидасы бойынша басқару жауапкершілігі
Dialogue: 0,0:12:50.75,0:12:52.79,Default CN,,0,0,0,,Бұл да үй иесі және қалалық нашақор.
Dialogue: 0,0:12:54.13,0:12:55.55,Default CN,,0,0,0,,Тоюки
Dialogue: 0,0:12:55.55,0:12:57.17,Default CN,,0,0,0,,Тек сақтау уақыты талабы
Dialogue: 0,0:12:57.17,0:12:58.76,Default CN,,0,0,0,,Ауыл қай жерде?
Dialogue: 0,0:12:58.76,0:12:59.68,Default CN,,0,0,0,,Жұмыс орнына келу
Dialogue: 0,0:12:59.68,0:13:01.55,Default CN,,0,0,0,,Сіз бейшарасыз…
Dialogue: 0,0:13:05.39,0:13:06.35,Default CN,,0,0,0,,біртүрлі
Dialogue: 0,0:13:06.35,0:13:07.98,Default CN,,0,0,0,,4 ұпай жартысы орындалды
Dialogue: 0,0:13:07.98,0:13:11.31,Default CN,,0,0,0,,Фортқа бару үшін сізде күту уақыты бар.
Dialogue: 0,0:13:38.71,0:13:40.67,Default CN,,0,0,0,,Менің өлетін уақытым болды. Тек жұмыс орныма барыңыз.
Dialogue: 0,0:13:41.13,0:13:42.18,Default CN,,0,0,0,,Сеніңше, қалай?
Dialogue: 0,0:13:42.18,0:13:44.09,Default CN,,0,0,0,,...
Dialogue: 0,0:13:48.72,0:13:49.77,Default CN,,0,0,0,,Әйелдерге арналған қонақ бөлмесі
Dialogue: 0,0:13:54.65,0:13:55.65,Default CN,,0,0,0,,Гано отыру және жүру
Dialogue: 0,0:14:01.65,0:14:02.95,Default CN,,0,0,0,,Гарекушу уақыты
Dialogue: 0,0:14:02.95,0:14:04.49,Default CN,,0,0,0,,Сіздің сұранысыңызды алғаннан кейін
Dialogue: 0,0:14:05.87,0:14:06.83,Default CN,,0,0,0,,Сонымен, 15 жыл бұрын неге Дио Джиорноның анасын жоймады да, оған еш кедергісіз баланы дүниеге әкелуге мүмкіндік берді?
Dialogue: 0,0:14:08.54,0:14:09.87,Default CN,,0,0,0,,Йокай?
Dialogue: 0,0:14:09.87,0:14:11.04,Default CN,,0,0,0,,Кім Чидо
Dialogue: 0,0:14:15.17,0:14:17.71,Default CN,,0,0,0,,Нана, мен бірінші келдім, айқайладым
Dialogue: 0,0:14:17.71,0:14:20.01,Default CN,,0,0,0,,Алғашқы үш полифалық ілім
Dialogue: 0,0:14:20.01,0:14:21.92,Default CN,,0,0,0,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:14:22.42,0:14:23.43,Default CN,,0,0,0,,Полидактилия
Dialogue: 0,0:14:23.97,0:14:24.89,Default CN,,0,0,0,,Полидактилия
Dialogue: 0,0:14:29.77,0:14:33.10,Default CN,,0,0,0,,Гакушин Хацуичи
Dialogue: 0,0:14:33.10,0:14:34.77,Default CN,,0,0,0,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:14:36.31,0:14:38.94,Default CN,,0,0,0,,Гакоу Фука алғашқы екі
Dialogue: 0,0:14:38.94,0:14:40.61,Default CN,,0,0,0,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:14:41.90,0:14:44.03,Default CN,,0,0,0,,Рион Гаку Хацуичи
Dialogue: 0,0:14:44.03,0:14:44.78,Default CN,,0,0,0,,Полидактилия
Dialogue: 0,0:14:46.03,0:14:49.20,Default CN,,0,0,0,,Менің фамилиям Коре Кио орта мектебінің 3-сыныбы
Dialogue: 0,0:14:49.20,0:14:50.20,Default CN,,0,0,0,,Полидактилия
Dialogue: 0,0:14:51.33,0:14:53.21,Default CN,,0,0,0,,Хатсуджи Масамүнэ
Dialogue: 0,0:14:53.91,0:14:58.29,Default CN,,0,0,0,,...
Dialogue: 0,0:14:58.29,0:15:00.50,Default CN,,0,0,0,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:15:00.50,0:15:01.59,Default CN,,0,0,0,,Бұл менің шын атым
Dialogue: 0,0:15:04.13,0:15:04.63,Default CN,,0,0,0,,Урешино
Dialogue: 0,0:15:06.93,0:15:07.72,Default CN,,0,0,0,,Фотосурет
Dialogue: 0,0:15:08.05,0:15:10.10,Default CN,,0,0,0,,Бұл менің атым Бұл менің фамилиям
Dialogue: 0,0:15:10.10,0:15:13.56,Default CN,,0,0,0,,Бақыттың шаттығы мен даланың бақыты
Dialogue: 0,0:15:13.56,0:15:14.27,Default CN,,0,0,0,,Хатсуичи
Dialogue: 0,0:15:14.85,0:15:16.77,Default CN,,0,0,0,,Оято – бірінші орта мектеп оқушысы.
Dialogue: 0,0:15:19.19,0:15:20.02,Default CN,,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:15:22.44,0:15:23.19,Default CN,,0,0,0,,Әрине, мен ашуланамын — мен сонша…
Dialogue: 0,0:15:26.32,0:15:28.99,Default CN,,0,0,0,,Бесінші нүктенің алдындағы бір сәттік дауыс, қайта туылу белгісі.
Dialogue: 0,0:15:28.99,0:15:29.95,Default CN,,0,0,0,,Жақсы нүкте
Dialogue: 0,0:15:29.95,0:15:30.83,Default CN,,0,0,0,,Жеу керек
Dialogue: 0,0:15:35.54,0:15:37.62,Default CN,,0,0,0,,Бұл туралы айту керек, бірақ бұл туралы айту керек.
Dialogue: 0,0:15:49.34,0:15:50.68,Default CN,,0,0,0,,Ескерту аты
Dialogue: 0,0:15:54.18,0:15:54.98,Default CN,,0,0,0,,Қабылданды
Dialogue: 0,0:16:32.60,0:16:35.56,Default CN,,0,0,0,,Мен өлгеннен кейін сарайдан шықтым.
Dialogue: 0,0:16:35.85,0:16:38.56,Default CN,,0,0,0,,Басқалар
Dialogue: 0,0:16:50.53,0:16:52.66,Default CN,,0,0,0,,Келесі жолы мен отбасыммен ойнаймын
Dialogue: 0,0:16:52.66,0:16:54.53,Default CN,,0,0,0,,Рас? естеліктер естеліктер
Dialogue: 0,0:16:54.53,0:16:57.08,Default CN,,0,0,0,,...
Dialogue: 0,0:16:57.41,0:16:59.25,Default CN,,0,0,0,,Кіші менг
Dialogue: 0,0:17:00.00,0:17:02.04,Default CN,,0,0,0,,Әңгімелесу Сіздің жұмысыңыз көшірілді
Dialogue: 0,0:17:02.04,0:17:03.09,Default CN,,0,0,0,,Жүгіруден кейін жүгіру
Dialogue: 0,0:17:03.50,0:17:05.25,Default CN,,0,0,0,,Қайғылы емес
Dialogue: 0,0:17:08.05,0:17:09.22,Default CN,,0,0,0,,Тек бір адам
Dialogue: 0,0:17:09.88,0:17:12.51,Default CN,,0,0,0,,Менің бір ғана нақты тілегім бар.
Dialogue: 0,0:17:14.55,0:17:15.60,Default CN,,0,0,0,,Қандай болса да
Dialogue: 0,0:17:41.29,0:17:42.12,Default CN,,0,0,0,,Жоғарғы бөлік
Dialogue: 0,0:17:43.88,0:17:45.75,Default CN,,0,0,0,,Өлім
Dialogue: 0,0:17:45.75,0:17:46.80,Default CN,,0,0,0,,Жариялаған
Dialogue: 0,0:17:46.80,0:17:49.30,Default CN,,0,0,0,,...
Dialogue: 0,0:17:50.67,0:17:52.93,Default CN,,0,0,0,,Электрондық құрылғыға рұқсатыңыз болуы керек.
Dialogue: 0,0:17:52.93,0:17:55.26,Default CN,,0,0,0,,Сәтті орындау
Dialogue: 0,0:17:55.26,0:17:56.72,Default CN,,0,0,0,,Пайдаланылмаған қуат көзі
Dialogue: 0,0:17:56.72,0:17:58.72,Default CN,,0,0,0,,Электр тоғын бақылау үшін қажет
Dialogue: 0,0:17:58.72,0:18:01.52,Default CN,,0,0,0,,Ауданда кез келген уақытта жұмыс істей алмайды
Dialogue: 0,0:18:02.60,0:18:03.35,Default CN,,0,0,0,,Жарайды, бұл тек менің жеке пікірім ғана.
Dialogue: 0,0:18:05.40,0:18:06.77,Default CN,,0,0,0,,Бұл кітап
Dialogue: 0,0:18:06.77,0:18:07.86,Default CN,,0,0,0,,Бұл ойынның белгілі бір түрі.
Dialogue: 0,0:18:08.48,0:18:10.57,Default CN,,0,0,0,,Дегенмен, электр қуатының көзін пайдалануға болмайды.
Dialogue: 0,0:18:10.57,0:18:11.61,Default CN,,0,0,0,,Бұл да қолмен.
Dialogue: 0,0:18:12.61,0:18:14.28,Default CN,,0,0,0,,Абайсыз тыңдау
Dialogue: 0,0:18:14.91,0:18:17.37,Default CN,,0,0,0,,Сіз әлі шоги көріп жүрсіз бе?
Dialogue: 0,0:18:17.37,0:18:18.41,Default CN,,0,0,0,,Нағыз ескі тақта
Dialogue: 0,0:18:18.41,0:18:20.08,Default CN,,0,0,0,,...
Dialogue: 0,0:18:20.08,0:18:20.87,Default CN,,0,0,0,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:19:54.84,0:19:57.01,Default CN,,0,0,0,,Мен алатын қызықты сөздер
Dialogue: 0,0:19:57.01,0:19:58.22,Default CN,,0,0,0,,Шынайы оқиға
Dialogue: 0,0:19:58.22,0:20:00.93,Default CN,,0,0,0,,Еуропадан кеткенде сатып алғаным осы.
Dialogue: 0,0:20:01.85,0:20:03.85,Default CN,,0,0,0,,Басқа университеттерде оқытылатын балалар әдебиеті
Dialogue: 0,0:20:04.68,0:20:05.68,Default CN,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:20:14.44,0:20:16.45,Default CN,,0,0,0,,Йошихиса көрінбеді
Dialogue: 0,0:20:16.45,0:20:17.36,Default CN,,0,0,0,,Шабуылдан кейін алдымен басы көрінеді.
Dialogue: 0,0:20:17.99,0:20:19.45,Default CN,,0,0,0,,Э-э...
Dialogue: 0,0:20:19.45,0:20:20.57,Default CN,,0,0,0,,Мен менің жүрегіммін
Dialogue: 0,0:20:21.07,0:20:23.03,Default CN,,0,0,0,,Анықтаманың қысқаша мазмұны
Dialogue: 0,0:20:23.79,0:20:24.45,Default CN,,0,0,0,,...
Dialogue: 0,0:20:27.33,0:20:28.42,Default CN,,0,0,0,,15-ші эпизод: Батырлық өлім – Екінші бөлім
Dialogue: 0,0:20:29.92,0:20:30.79,Default CN,,0,0,0,,Қорқақтық
Dialogue: 0,0:20:31.84,0:20:33.75,Default CN,,0,0,0,,Үй иесі абай
Dialogue: 0,0:20:34.67,0:20:35.92,Default CN,,0,0,0,,Мен тікелей қатысып отырмын, т.б.
Dialogue: 0,0:20:35.92,0:20:37.88,Default CN,,0,0,0,,Сіз ұялшақтығыңызбен келістіңіз
Dialogue: 0,0:20:37.88,0:20:38.93,Default CN,,0,0,0,,Йошихиса Фьюси
Dialogue: 0,0:20:38.93,0:20:39.38,Default CN,,0,0,0,,...
Dialogue: 0,0:20:40.14,0:20:41.14,Default CN,,0,0,0,,Э-э...
Dialogue: 0,0:20:41.14,0:20:43.56,Default CN,,0,0,0,,Мен мүмкіндігімнен айырылдым
Dialogue: 0,0:20:43.85,0:20:44.76,Default CN,,0,0,0,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:20:45.47,0:20:48.35,Default CN,,0,0,0,,Жеңілгенде, Мен әрқашан жеңілемін.
Dialogue: 0,0:20:48.35,0:20:51.23,Default CN,,0,0,0,,Қаланың төменгі бөлігіне жету үшін бірнеше сағат қажет болды.
Dialogue: 0,0:20:51.86,0:20:55.23,Default CN,,0,0,0,,Мен жеңілдім.
Dialogue: 0,0:20:55.23,0:20:56.69,Default CN,,0,0,0,,Енді аспан жақында келеді.
Dialogue: 0,0:20:56.69,0:20:58.99,Default CN,,0,0,0,,Апта күні Сатоюша тобы Коре Фукюша
Dialogue: 0,0:20:58.99,0:21:00.53,Default CN,,0,0,0,,Қазір демалуда
Dialogue: 0,0:21:00.53,0:21:01.82,Default CN,,0,0,0,,Тағы бір адам келді.
Dialogue: 0,0:21:05.95,0:21:07.91,Default CN,,0,0,0,,...
Dialogue: 0,0:21:07.91,0:21:09.41,Default CN,,0,0,0,,Қорқақтық
Dialogue: 0,0:21:11.54,0:21:13.67,Default CN,,0,0,0,,Барлық қызметкерлер келді.
Dialogue: 0,0:21:14.38,0:21:16.25,Default CN,,0,0,0,,Мен өз кеңсемде қайдамын
Dialogue: 0,0:21:16.80,0:21:19.47,Default CN,,0,0,0,,Кіші кристалды жүгіріс
Dialogue: 0,0:21:19.47,0:21:21.80,Default CN,,0,0,0,,анық және қиын
Dialogue: 0,0:21:21.80,0:21:24.97,Default CN,,0,0,0,,...
Dialogue: 0,0:21:24.97,0:21:26.77,Default CN,,0,0,0,,...
Dialogue: 0,0:21:27.52,0:21:28.73,Default CN,,0,0,0,,Жақсы нүктені бақылау
Dialogue: 0,0:21:28.73,0:21:29.89,Default CN,,0,0,0,,Нағыз адам
Dialogue: 0,0:21:31.19,0:21:33.69,Default CN,,0,0,0,,Бағаларыңыз үшін рахмет.
Dialogue: 0,0:21:34.52,0:21:36.40,Default CN,,0,0,0,,Дегенмен, үй иесі сізді қарсы алуға келді.
Dialogue: 0,0:21:37.19,0:21:38.57,Default CN,,0,0,0,,Мейтеня кетіп қалды
Dialogue: 0,0:21:56.00,0:21:57.05,Default CN,,0,0,0,,Қорқақтық
Dialogue: 0,0:21:58.51,0:21:59.84,Default CN,,0,0,0,,...
Dialogue: 0,0:22:03.55,0:22:06.43,Default CN,,0,0,0,,Қала – адамның өмірі.
Dialogue: 0,0:22:06.43,0:22:08.72,Default CN,,0,0,0,,Әңгіме - бұл адамның өмірі.
Dialogue: 0,0:22:08.72,0:22:10.06,Default CN,,0,0,0,,Өткеннің өткені
Dialogue: 0,0:22:21.90,0:22:23.66,Default CN,,0,0,0,,Әйел өмірі әрқашан осында
Dialogue: 0,0:22:24.74,0:22:26.66,Default CN,,0,0,0,,Обсервация бағы – сүйікті аймақ.
Dialogue: 0,0:22:39.34,0:22:42.55,Default CN,,0,0,0,,Көрінісі жақсы шай кесе
Dialogue: 0,0:22:42.55,0:22:45.97,Default CN,,0,0,0,,...
Dialogue: 0,0:22:46.55,0:22:48.39,Default CN,,0,0,0,,Сондықтан тамақ менің жеке ісім.
Dialogue: 0,0:22:49.60,0:22:51.02,Default CN,,0,0,0,,...
Dialogue: 0,0:22:51.02,0:22:52.31,Default CN,,0,0,0,,Мен қонақ емеспін.
Dialogue: 0,0:22:54.98,0:22:56.23,Default CN,,0,0,0,,Сәттілік
Dialogue: 0,0:22:56.23,0:22:57.36,Default CN,,0,0,0,,Қызыл шай кесе
Dialogue: 0,0:22:57.77,0:22:58.90,Default CN,,0,0,0,,...
Dialogue: 0,0:22:58.90,0:23:01.40,Default CN,,0,0,0,,Гакикин шөпті қызыл шай
Dialogue: 0,0:23:03.78,0:23:06.82,Default CN,,0,0,0,,Қамалдың ішін көргенде
Dialogue: 0,0:23:06.82,0:23:08.70,Default CN,,0,0,0,,Сөйлесудің қажеті жоқ
Dialogue: 0,0:23:08.70,0:23:10.45,Default CN,,0,0,0,,...
Dialogue: 0,0:23:12.25,0:23:15.42,Default CN,,0,0,0,,Өткендегі екінші аспан.
Dialogue: 0,0:23:18.54,0:23:21.09,Default CN,,0,0,0,,Биік мұнара да өтіп кетті.
Dialogue: 0,0:23:29.80,0:23:33.81,Default CN,,0,0,0,,Алайда бекіністің айналасындағы астанасы теңіз, ал басқа аймақтар қамтылмаған.
Dialogue: 0,0:23:35.73,0:23:38.19,Default CN,,0,0,0,,Барғың келген кезде бір қасық уақыт
Dialogue: 0,0:23:38.19,0:23:38.98,Default CN,,0,0,0,,...
Dialogue: 0,0:23:41.02,0:23:42.40,Default CN,,0,0,0,,Э-э...
Dialogue: 0,0:23:42.40,0:23:43.69,Default CN,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:23:43.69,0:23:45.99,Default CN,,0,0,0,,…
Dialogue: 0,0:23:49.07,0:23:51.70,Default CN,,0,0,0,,Менің ерекше қалауларым
Dialogue: 0,0:23:51.70,0:23:54.29,Default CN,,0,0,0,,Бұл менің бөлмем, маған ұнайды.
Dialogue: 0,0:23:54.29,0:23:56.21,Default CN,,0,0,0,,Музыкалық атмосферасы бар музыкалық аспап
Dialogue: 0,0:23:57.33,0:24:01.34,Default CN,,0,0,0,,Сіздің бастапқы жоспарыңыз қандай?
Dialogue: 0,0:24:02.63,0:24:03.67,Default CN,,0,0,0,,Алайда шығу жолдары жоқ.
Dialogue: 0,0:24:06.93,0:24:09.89,Default CN,,0,0,0,,Мен де күтпеген жауап алдым.
Dialogue: 0,0:24:19.52,0:24:21.86,Default CN,,0,0,0,,Форттағы уақыт пен жарық
Dialogue: 0,0:24:22.73,0:24:25.74,Default CN,,0,0,0,,Қожайын болсаң, бақытты боласың, жеке тұлға ретінде бақытты боласың.
Dialogue: 0,0:24:27.20,0:24:29.78,Default CN,,0,0,0,,...
Dialogue: 0,0:24:29.78,0:24:33.33,Default CN,,0,0,0,,Ойыңыз болса, үй иесі мектеп емес.
Dialogue: 0,0:24:33.33,0:24:36.70,Default CN,,0,0,0,,Алайда марқұмға қатысты түрлі сауалдар бар.
Dialogue: 0,0:24:37.41,0:24:39.96,Default CN,,0,0,0,,Адамның тағайындалуы
Dialogue: 0,0:24:47.13,0:24:48.97,Default CN,,0,0,0,,Маған ұнайды.
Dialogue: 0,0:24:49.63,0:24:51.80,Default CN,,0,0,0,,Қайталау нүктелері Пайдаланылмаған бөлім
Dialogue: 0,0:24:53.26,0:24:54.56,Default CN,,0,0,0,,Қорқақтық
Dialogue: 0,0:25:01.23,0:25:02.98,Default CN,,0,0,0,,Мұнда келе жатырмын
Dialogue: 0,0:25:08.19,0:25:10.16,Default CN,,0,0,0,,Отыру
Dialogue: 0,0:25:10.16,0:25:11.82,Default CN,,0,0,0,,Қорқақтықпен ішу
Dialogue: 0,0:25:11.82,0:25:13.32,Default CN,,0,0,0,,Менің әнім
Dialogue: 0,0:25:13.32,0:25:15.83,Default CN,,0,0,0,,Мен сізді жақсы көрініспен қалдырамын.
Dialogue: 0,0:25:18.29,0:25:20.96,Default CN,,0,0,0,,Басқалары жоқ.
Dialogue: 0,0:25:23.21,0:25:27.84,Default CN,,0,0,0,,Әңгімелесу: Қазіргі уақытта қорқақ адамның досы
Dialogue: 0,0:25:31.30,0:25:31.97,Default CN,,0,0,0,,Әрине, мен ашуланамын — мен сонша…
Dialogue: 0,0:25:35.64,0:25:38.93,Default CN,,0,0,0,,Түпнұсқа Урешино кристалы жүректен шығады.
Dialogue: 0,0:25:39.81,0:25:41.81,Default CN,,0,0,0,,Ересек қасқыр Йошихисаны көрінбейтін сезінеді
Dialogue: 0,0:25:42.65,0:25:47.61,Default CN,,0,0,0,,Қай жерде берсең, тастамайсың.
Dialogue: 0,0:25:47.98,0:25:49.69,Default CN,,0,0,0,,Өлім себебі
Dialogue: 0,0:25:49.69,0:25:51.40,Default CN,,0,0,0,,Сізде жақсы тәжірибе бар
Dialogue: 0,0:25:52.28,0:25:55.24,Default CN,,0,0,0,,Абайсызда
Dialogue: 0,0:25:57.08,0:25:59.83,Default CN,,0,0,0,,Урешиноның түсіндірмесі сіз қалаған нәрсе.
Dialogue: 0,0:25:59.83,0:26:02.08,Default CN,,0,0,0,,ұялшақтық
Dialogue: 0,0:26:03.25,0:26:05.96,Default CN,,0,0,0,,Сағынып қалған болсаңыз, әңгімені айтып беріңізші
Dialogue: 0,0:26:07.25,0:26:08.13,Default CN,,0,0,0,,Имаго тәрізді
Dialogue: 0,0:26:16.14,0:26:18.85,Default CN,,0,0,0,,Өлгеннен кейін өлген баланың бейнесі
Dialogue: 0,0:26:33.78,0:26:37.16,Default CN,,0,0,0,,Мен үйде түскі ас ішейін деп жатырмын
Dialogue: 0,0:26:38.33,0:26:40.45,Default CN,,0,0,0,,Үй иесінің ең жақсы ойыны
Dialogue: 0,0:26:42.91,0:26:47.42,Default CN,,0,0,0,,...
Dialogue: 0,0:26:47.42,0:26:49.30,Default CN,,0,0,0,,Кішкене желді естігенде
Dialogue: 0,0:26:49.30,0:26:50.55,Default CN,,0,0,0,,Бұл сіздің барлық жүктеріңіз бе?
Dialogue: 0,0:26:50.55,0:26:52.72,Default CN,,0,0,0,,Менің әнімнің үні
Dialogue: 0,0:26:53.05,0:26:55.22,Default CN,,0,0,0,,Түпнұсқа осы жерден шыққан.
Dialogue: 0,0:26:55.22,0:26:56.26,Default CN,,0,0,0,,Нананың әңгімесі
Dialogue: 0,0:27:01.98,0:27:02.98,Default CN,,0,0,0,,Мұндайды есту өте сирек
Dialogue: 0,0:27:02.98,0:27:04.23,Default CN,,0,0,0,,Мүлдем ұмытылған
Dialogue: 0,0:27:14.70,0:27:16.11,Default CN,,0,0,0,,Кім жоқ?
Dialogue: 0,0:27:16.11,0:27:17.45,Default CN,,0,0,0,,Жақсы бейне бірінші
Dialogue: 0,0:27:26.08,0:27:27.17,Default CN,,0,0,0,,Мұндайды есту өте сирек
Dialogue: 0,0:27:28.17,0:27:28.71,Default CN,,0,0,0,,Қорқақтық
Dialogue: 0,0:27:29.96,0:27:31.84,Default CN,,0,0,0,,...
Dialogue: 0,0:27:33.63,0:27:35.30,Default CN,,0,0,0,,Мен тұрған жерден өлген адамдар
Dialogue: 0,0:27:36.05,0:27:39.55,Default CN,,0,0,0,,Жылу шыққаннан кейін үй иесі қалада жұмыс істейді.
Dialogue: 0,0:27:39.55,0:27:40.43,Default CN,,0,0,0,,Бос емес
Dialogue: 0,0:27:40.85,0:27:42.97,Default CN,,0,0,0,,Масамунаның саяхаты аяқталды
Dialogue: 0,0:27:42.97,0:27:46.60,Default CN,,0,0,0,,Желді ауа райы және жаздың аптап ыстығы тобы.
Dialogue: 0,0:27:47.27,0:27:49.56,Default CN,,0,0,0,,Я Урешиноның өз бетімен кеткен жеке мектебі
Dialogue: 0,0:27:50.40,0:27:51.57,Default CN,,0,0,0,,...
Dialogue: 0,0:28:03.66,0:28:04.33,Default CN,,0,0,0,,Дұрыс есептеу уақыттары
Dialogue: 0,0:28:07.21,0:28:09.71,Default CN,,0,0,0,,Мен үй иесі енді жоқ сияқты сезінемін.
Dialogue: 0,0:28:10.84,0:28:12.30,Default CN,,0,0,0,,Жылу бөлінуіне байланысты
Dialogue: 0,0:28:14.13,0:28:16.72,Default CN,,0,0,0,,Әсіресе аптап ыстық мезгілінде, қала жақсы бейнелерге толы кезде.
Dialogue: 0,0:28:17.43,0:28:18.93,Default CN,,0,0,0,,Ыстық маусым тобы?
Dialogue: 0,0:28:18.93,0:28:19.89,Default CN,,0,0,0,,Накореджия
Dialogue: 0,0:28:21.30,0:28:25.18,Default CN,,0,0,0,,Жазғы термиялық өңдеудің бірінші семестрін білу
Dialogue: 0,0:28:27.77,0:28:29.69,Default CN,,0,0,0,,Пәтер иелерінің жақтастығы
Dialogue: 0,0:28:30.69,0:28:31.77,Default CN,,0,0,0,,Шинья кетіп қалады
Dialogue: 0,0:28:35.07,0:28:36.44,Default CN,,0,0,0,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:28:40.03,0:28:42.28,Default CN,,0,0,0,,Ашу сезімінен сабырлылық туады
Dialogue: 0,0:28:48.21,0:28:50.12,Default CN,,0,0,0,,Мен оған ақша төлегім келмейді.
Dialogue: 0,0:28:50.12,0:28:53.21,Default CN,,0,0,0,,Бұл сіз үшін жақсы нәрсе.
Dialogue: 0,0:28:53.88,0:28:58.34,Default CN,,0,0,0,,Оған дейін түс ауа кездейсоқ қайтатынмын.
Dialogue: 0,0:28:58.34,0:29:00.05,Default CN,,0,0,0,,Қажетті уақыт
Dialogue: 0,0:29:00.05,0:29:00.68,Default CN,,0,0,0,,Әдейі?
Dialogue: 0,0:29:01.51,0:29:03.30,Default CN,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:29:03.30,0:29:05.43,Default CN,,0,0,0,,Бір ғана адам кенеттен бас тартылды.
Dialogue: 0,0:29:05.43,0:29:06.93,Default CN,,0,0,0,,Тамақты сәтті өткізу және бастау
Dialogue: 0,0:29:06.93,0:29:09.23,Default CN,,0,0,0,,Адамды бақылау
Dialogue: 0,0:29:11.81,0:29:12.94,Default CN,,0,0,0,,Китажима ескі шебердің ертегісі
Dialogue: 0,0:29:14.65,0:29:19.49,Default CN,,0,0,0,,Бұл ескі мұғалімге арналған мектептегі тегін ойын-сауық қызметі.
Dialogue: 0,0:29:21.20,0:29:25.66,Default CN,,0,0,0,,Қарт ұстаздың әңгімесін тыңдау
Dialogue: 0,0:29:25.66,0:29:30.12,Default CN,,0,0,0,,Мектептен кеткің келмесе, мектептен шықпа.
Dialogue: 0,0:29:30.12,0:29:32.29,Default CN,,0,0,0,,Әңгіме толық деп жауап береді.
Dialogue: 0,0:29:32.29,0:29:34.71,Default CN,,0,0,0,,...
Dialogue: 0,0:29:34.71,0:29:36.17,Default CN,,0,0,0,,Себеп
Dialogue: 0,0:29:36.17,0:29:37.26,Default CN,,0,0,0,,...
Dialogue: 0,0:29:37.26,0:29:39.30,Default CN,,0,0,0,,Осы сәттің өте ерте таңы
Dialogue: 0,0:29:39.30,0:29:41.63,Default CN,,0,0,0,,…
Dialogue: 0,0:29:52.85,0:29:53.98,Default CN,,0,0,0,,Жаздың аптап ыстығы өтіп кетті
Dialogue: 0,0:29:54.31,0:29:55.69,Default CN,,0,0,0,,Менің сөздерім
Dialogue: 0,0:29:55.69,0:29:58.48,Default CN,,0,0,0,,Жазғы маусымды қорытындылау
Dialogue: 0,0:29:58.48,0:30:00.61,Default CN,,0,0,0,,Тортты да жей алмай ма?
Dialogue: 0,0:30:00.61,0:30:03.57,Default CN,,0,0,0,,...
Dialogue: 0,0:30:03.57,0:30:05.62,Default CN,,0,0,0,,Қолданылуы мүмкін емес
Dialogue: 0,0:30:05.62,0:30:07.66,Default CN,,0,0,0,,Қарт мұғалімнің екінші бұйрығы
Dialogue: 0,0:30:08.70,0:30:10.20,Default CN,,0,0,0,,Өлім
Dialogue: 0,0:30:14.21,0:30:16.04,Default CN,,0,0,0,,...
Dialogue: 0,0:30:16.04,0:30:17.96,Default CN,,0,0,0,,Мен сенімен ойнағым келмейді.
Dialogue: 0,0:30:19.17,0:30:20.76,Default CN,,0,0,0,,Желді тыңда, рухты сезін
Dialogue: 0,0:30:23.22,0:30:24.09,Default CN,,0,0,0,,Дегенмен, солай
Dialogue: 0,0:30:24.72,0:30:26.76,Default CN,,0,0,0,,Желдің біртүрлі ән айтуы
Dialogue: 0,0:30:26.76,0:30:29.22,Default CN,,0,0,0,,Жұмысқа қабылдау қажет
Dialogue: 0,0:30:31.14,0:30:33.85,Default CN,,0,0,0,,Ресми ән жібергіңіз келмесе, өтінемін
Dialogue: 0,0:30:33.85,0:30:36.27,Default CN,,0,0,0,,Қолөнер шеберлігі
Dialogue: 0,0:30:42.90,0:30:43.99,Default CN,,0,0,0,,Менің сөздерім
Dialogue: 0,0:30:45.20,0:30:48.95,Default CN,,0,0,0,,Екінші тоқсанның басында мен мектептен шығуым керек.
Dialogue: 0,0:30:49.49,0:30:52.54,Default CN,,0,0,0,,Бұған үй иесінің қайтыс болуы себеп болды.
Dialogue: 0,0:30:53.12,0:30:56.04,Default CN,,0,0,0,,Жергілікті жер иесі қайтыс болған кезде
Dialogue: 0,0:30:56.88,0:30:58.92,Default CN,,0,0,0,,Бұрын кетпеген
Dialogue: 0,0:31:00.76,0:31:02.34,Default CN,,0,0,0,,...
Dialogue: 0,0:31:02.34,0:31:07.55,Default CN,,0,0,0,,「」
Dialogue: 0,0:31:07.55,0:31:09.26,Default CN,,0,0,0,,Рас
Dialogue: 0,0:31:09.26,0:31:11.10,Default CN,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:31:11.10,0:31:14.23,Default CN,,0,0,0,,Жер иесі
Dialogue: 0,0:31:14.23,0:31:17.02,Default CN,,0,0,0,,Мен астанаға тіке барып, көрдім
Dialogue: 0,0:31:17.52,0:31:18.94,Default CN,,0,0,0,,Өкінішке орай
Dialogue: 0,0:31:19.86,0:31:22.90,Default CN,,0,0,0,,Кейбір тарих
Dialogue: 0,0:31:23.44,0:31:25.53,Default CN,,0,0,0,,Ой - Урешиноның өлімі.
Dialogue: 0,0:31:26.86,0:31:29.12,Default CN,,0,0,0,,...
Dialogue: 0,0:31:29.12,0:31:30.49,Default CN,,0,0,0,,Үй иесі астана емес.
Dialogue: 0,0:31:30.49,0:31:32.66,Default CN,,0,0,0,,Тұлғаны алып тастау; Тұлғаны алып тастау;
Dialogue: 0,0:31:32.66,0:31:34.00,Default CN,,0,0,0,,...
Dialogue: 0,0:31:34.54,0:31:35.79,Default CN,,0,0,0,,Сен де сондайсың
Dialogue: 0,0:31:35.79,0:31:37.17,Default CN,,0,0,0,,Сен де сондайсың
Dialogue: 0,0:31:37.17,0:31:38.08,Default CN,,0,0,0,,Сен де сондайсың
Dialogue: 0,0:31:38.08,0:31:39.17,Default CN,,0,0,0,,Сен де сондайсың
Dialogue: 0,0:31:39.17,0:31:40.29,Default CN,,0,0,0,,Сен де сондайсың
Dialogue: 0,0:31:40.29,0:31:41.63,Default CN,,0,0,0,,Сен де сондайсың
Dialogue: 0,0:31:41.63,0:31:43.59,Default CN,,0,0,0,,Урешино сәл тыныш төменгі жартысы
Dialogue: 0,0:31:45.38,0:31:47.68,Default CN,,0,0,0,,Мұны қалай жасайсыз?
Dialogue: 0,0:31:47.68,0:31:49.80,Default CN,,0,0,0,,...
Dialogue: 0,0:31:49.80,0:31:50.39,Default CN,,0,0,0,,Талқылау
Dialogue: 0,0:31:51.01,0:31:52.01,Default CN,,0,0,0,,Оны оқып берейін.
Dialogue: 0,0:31:52.64,0:31:54.56,Default CN,,0,0,0,,Гагаго мектебі
Dialogue: 0,0:31:57.10,0:31:57.90,Default CN,,0,0,0,,...
Dialogue: 0,0:31:57.90,0:31:58.94,Default CN,,0,0,0,,Мен өмірден айырылдым
Dialogue: 0,0:31:59.56,0:32:00.65,Default CN,,0,0,0,,Бұл рөл де біраз қиын екен…
Dialogue: 0,0:32:00.65,0:32:04.36,Default CN,,0,0,0,,Жапон мектебі емес, жазғы мектеп-интернаты
Dialogue: 0,0:32:04.86,0:32:06.11,Default CN,,0,0,0,,Ся Вэйи
Dialogue: 0,0:32:06.11,0:32:08.11,Default CN,,0,0,0,,Бұл рас па?
Dialogue: 0,0:32:08.11,0:32:11.53,Default CN,,0,0,0,,Бұл сіз үшін ерекше ме?
Dialogue: 0,0:32:11.53,0:32:13.70,Default CN,,0,0,0,,Жалпы айтқанда, бір-бірінің арақашықтығы жоқ.
Dialogue: 0,0:32:14.29,0:32:15.54,Default CN,,0,0,0,,Сөйлесу циклі
Dialogue: 0,0:32:15.54,0:32:18.00,Default CN,,0,0,0,,Ересек қасқыр ертегісінің басталуы
Dialogue: 0,0:32:18.00,0:32:22.50,Default CN,,0,0,0,,Қамал қамалының ашылу уақыты: Жапония уақыты бойынша 9 ұпай ерте, түстен кейін 5 ұпай
Dialogue: 0,0:32:22.92,0:32:25.59,Default CN,,0,0,0,,Менің ойлап жүргенім Жапония уақыты.
Dialogue: 0,0:32:26.38,0:32:28.13,Default CN,,0,0,0,,Сіз жоғары сапалы ағаштан жасалғансыз.
Dialogue: 0,0:32:29.51,0:32:32.10,Default CN,,0,0,0,,...
Dialogue: 0,0:32:32.10,0:32:33.51,Default CN,,0,0,0,,Қабылдау емтиханының нұсқаулығы
Dialogue: 0,0:32:33.51,0:32:36.73,Default CN,,0,0,0,,Мектеп үрмелі мен барабандарын ашық ауада көтермелейді.
Dialogue: 0,0:32:37.18,0:32:39.94,Default CN,,0,0,0,,Сіз шетелде оқуды жақсы білесіз бе?
Dialogue: 0,0:32:40.27,0:32:41.19,Default CN,,0,0,0,,...
Dialogue: 0,0:32:41.19,0:32:43.11,Default CN,,0,0,0,,Сіз не киесіз?
Dialogue: 0,0:32:43.11,0:32:44.82,Default CN,,0,0,0,,Бұл тұрарлық емес.
Dialogue: 0,0:32:44.82,0:32:46.15,Default CN,,0,0,0,,Мен не істерімді білмеймін
Dialogue: 0,0:32:47.99,0:32:50.20,Default CN,,0,0,0,,Мен не істерімді білмеймін.
Dialogue: 0,0:32:50.20,0:32:55.12,Default CN,,0,0,0,,Мен мұнда алғаш келгеннен бері халықаралық студентпін.
Dialogue: 0,0:32:55.12,0:32:58.62,Default CN,,0,0,0,,Жапонияға келгенде, Жапонияға келетін уақыт келеді деп болжанады.
Dialogue: 0,0:32:58.62,0:33:02.00,Default CN,,0,0,0,,Ағылшын тіліндегі аударма
Dialogue: 0,0:33:02.79,0:33:04.96,Default CN,,0,0,0,,...
Dialogue: 0,0:33:04.96,0:33:07.76,Default CN,,0,0,0,,Ешқандай орынға рұқсат етілмейді
Dialogue: 0,0:33:07.76,0:33:10.18,Default CN,,0,0,0,,Мен сен туралы не білуім керек
Dialogue: 0,0:33:10.18,0:33:12.51,Default CN,,0,0,0,,Сен не білесің?
Dialogue: 0,0:33:12.51,0:33:14.14,Default CN,,0,0,0,,Екінші семестр басталғалы мен мектептен шықтым.
Dialogue: 0,0:33:14.72,0:33:15.56,Default CN,,0,0,0,,Жұмыс орны
Dialogue: 0,0:33:38.37,0:33:40.29,Default CN,,0,0,0,,Өлім
Dialogue: 0,0:33:42.58,0:33:44.63,Default CN,,0,0,0,,Кішігірім мәселелер бар.
Dialogue: 0,0:33:45.50,0:33:47.13,Default CN,,0,0,0,,Көру үшін қолжетімді емес.
Dialogue: 0,0:33:52.13,0:33:54.43,Default CN,,0,0,0,,Урешино Фуичики ойнайды
Dialogue: 0,0:33:54.43,0:33:56.22,Default CN,,0,0,0,,...
Dialogue: 0,0:33:56.22,0:33:58.22,Default CN,,0,0,0,,Урешино Райгану
Dialogue: 0,0:33:58.22,0:33:58.60,Default CN,,0,0,0,,Келесі ойын
Dialogue: 0,0:34:06.36,0:34:07.94,Default CN,,0,0,0,,Процестің егжей-тегжейлері
Dialogue: 0,0:34:08.40,0:34:10.86,Default CN,,0,0,0,,Урешино
Dialogue: 0,0:34:10.86,0:34:13.70,Default CN,,0,0,0,,Менің жұмысқа орналасуыма әсер ететін қандай да бір жағдайлар болса, маған мәжбүр болуы мүмкін
Dialogue: 0,0:34:13.99,0:34:18.95,Default CN,,0,0,0,,Бірінші бетте басқа доспен байланысқаннан кейін
Dialogue: 0,0:34:18.95,0:34:21.50,Default CN,,0,0,0,,Осыдан кейін Вьетнамға басқа адамдар келді.
Dialogue: 0,0:34:23.29,0:34:27.17,Default CN,,0,0,0,,Мен де алданбаймын.
Dialogue: 0,0:34:27.17,0:34:29.05,Default CN,,0,0,0,,Мектепке көптен кеткен
Dialogue: 0,0:34:29.05,0:34:32.38,Default CN,,0,0,0,,Шеберімнің өткен тәжірибесін бағалау
Dialogue: 0,0:34:32.38,0:34:33.18,Default CN,,0,0,0,,Негіздеме: «Кинфу-ки»
Dialogue: 0,0:34:34.43,0:34:36.43,Default CN,,0,0,0,,Сіздің бұған құқығыңыз болмауы мүмкін.
Dialogue: 0,0:34:37.76,0:34:41.39,Default CN,,0,0,0,,Дегенмен, бұл ескі мұғалімнің тілі.
Dialogue: 0,0:34:41.89,0:34:45.44,Default CN,,0,0,0,,Нәтижесінде басқа тұтынушылар сізбен сөйлесе алмауы мүмкін.
Dialogue: 0,0:34:46.06,0:34:48.40,Default CN,,0,0,0,,Мен осындамын және тірімін.
Dialogue: 0,0:34:48.40,0:34:49.73,Default CN,,0,0,0,,Нәтижесінде өткен күн аяқталды.
Dialogue: 0,0:34:49.73,0:34:51.40,Default CN,,0,0,0,,...
Dialogue: 0,0:34:52.07,0:34:55.32,Default CN,,0,0,0,,Нәтижесінде, Урешиноя жалғыз адам.
Dialogue: 0,0:34:56.16,0:34:57.32,Default CN,,0,0,0,,Накоаки
Dialogue: 0,0:35:01.37,0:35:02.37,Default CN,,0,0,0,,Э-э...
Dialogue: 0,0:35:02.37,0:35:05.92,Default CN,,0,0,0,,Сяо Цзиньоу да жақында қайтыс болды.
Dialogue: 0,0:35:07.00,0:35:07.67,Default CN,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:35:08.09,0:35:09.00,Default CN,,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:35:12.42,0:35:14.13,Default CN,,0,0,0,,Мен өзімнің досыммын
Dialogue: 0,0:35:15.63,0:35:16.76,Default CN,,0,0,0,,Қажетті құпия қорғау
Dialogue: 0,0:35:46.29,0:35:47.50,Default CN,,0,0,0,,Йошихиса көрінбеді
Dialogue: 0,0:35:47.50,0:35:48.92,Default CN,,0,0,0,,Сәттілік
Dialogue: 0,0:35:48.92,0:35:49.84,Default CN,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:35:53.38,0:35:54.05,Default CN,,0,0,0,,Жалғасы
Dialogue: 0,0:35:54.47,0:35:56.88,Default CN,,0,0,0,,Мен сөз тіркесін жазу үшін келдім.
Dialogue: 0,0:35:56.88,0:36:00.51,Default CN,,0,0,0,,Ұнамаса, қайтып келген соң қайта көру керек.
Dialogue: 0,0:36:00.51,0:36:03.72,Default CN,,0,0,0,,Дегенмен, сіз бұл туралы ойлайсыз.
Dialogue: 0,0:36:05.23,0:36:08.06,Default CN,,0,0,0,,Жаныңыз тыныш болған кезде
Dialogue: 0,0:36:08.06,0:36:12.78,Default CN,,0,0,0,,Жапон тілі, т.б.. Тегін мектепке келгенде ойлану керек.
Dialogue: 0,0:36:16.78,0:36:17.53,Default CN,,0,0,0,,Э-э...
Dialogue: 0,0:36:18.61,0:36:20.78,Default CN,,0,0,0,,Гафуюйо мектебі
Dialogue: 0,0:36:20.78,0:36:22.66,Default CN,,0,0,0,,Бұл менің кінәм емес.
Dialogue: 0,0:36:25.41,0:36:27.33,Default CN,,0,0,0,,...
Dialogue: 0,0:36:27.33,0:36:28.46,Default CN,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:36:31.25,0:36:32.34,Default CN,,0,0,0,,Жылдамдық
Dialogue: 0,0:36:36.26,0:36:37.42,Default CN,,0,0,0,,Себеп
Dialogue: 0,0:36:37.42,0:36:40.51,Default CN,,0,0,0,,Сіз әрқашан аспандасыз
Dialogue: 0,0:36:50.19,0:36:52.15,Default CN,,0,0,0,,Гаканоның қайтып келуі
Dialogue: 0,0:36:52.15,0:36:53.02,Default CN,,0,0,0,,Қазірге дейін
Dialogue: 0,0:36:57.03,0:36:58.82,Default CN,,0,0,0,,Бұл менің қуанышты қызыл шайым
Dialogue: 0,0:36:58.82,0:37:00.99,Default CN,,0,0,0,,Кешіріңіз
Dialogue: 0,0:37:00.99,0:37:02.24,Default CN,,0,0,0,,Мүмкіндік
Dialogue: 0,0:37:03.53,0:37:04.99,Default CN,,0,0,0,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 0,0:37:05.54,0:37:06.83,Default CN,,0,0,0,,Na қайта қаралды
Dialogue: 0,0:37:26.52,0:37:28.98,Default CN,,0,0,0,,Бүгінгі Теншу шебері
Dialogue: 0,0:37:28.98,0:37:31.15,Default CN,,0,0,0,,Сова Дайке Ичики Коммерциялық көлемі Ичиге
Dialogue: 0,0:37:31.15,0:37:32.48,Default CN,,0,0,0,,Болашақ жоспарлар
Dialogue: 0,0:37:33.15,0:37:35.94,Default CN,,0,0,0,,Қазан айының аяқталғанына 6 ай болды.
Dialogue: 0,0:37:36.61,0:37:38.78,Default CN,,0,0,0,,Гуаньюй қасық
Dialogue: 0,0:37:38.78,0:37:42.62,Default CN,,0,0,0,,...
Dialogue: 0,0:37:46.12,0:37:48.54,Default CN,,0,0,0,,Менің асхананың уақыты
Dialogue: 0,0:37:48.54,0:37:51.29,Default CN,,0,0,0,,Масамүнэ мен Иккакудың өткені
Dialogue: 0,0:37:51.29,0:37:53.04,Default CN,,0,0,0,,Сіз шындықты оқыдыңыз
Dialogue: 0,0:37:53.04,0:37:55.29,Default CN,,0,0,0,,Сау бол, мен келдім
Dialogue: 0,0:37:55.29,0:37:56.84,Default CN,,0,0,0,,Сіз болғыңыз келмейді
Dialogue: 0,0:37:56.84,0:38:00.30,Default CN,,0,0,0,,Көк астана келген сайын уақыт келеді.
Dialogue: 0,0:38:00.93,0:38:03.30,Default CN,,0,0,0,,Осыдан кейін есеп мынау.
Dialogue: 0,0:38:03.30,0:38:06.01,Default CN,,0,0,0,,Мен дарынды шебер ретінде еңбек жолымды енді бастадым.
Dialogue: 0,0:38:06.01,0:38:07.89,Default CN,,0,0,0,,Мұндағы шайқастың басшысы.
Dialogue: 0,0:38:07.89,0:38:09.27,Default CN,,0,0,0,,Дегенмен қасық келді.
Dialogue: 0,0:38:09.27,0:38:11.94,Default CN,,0,0,0,,Жалға берушінің жұмысқа орналасу талабы өзара талқылау талабы талап практикалық жүзеге асыру немесе тілек
Dialogue: 0,0:38:11.94,0:38:14.27,Default CN,,0,0,0,,Қорытынды сызба немесе егжей-тегжейлі әдіс анықталады
Dialogue: 0,0:38:14.65,0:38:17.90,Default CN,,0,0,0,,Кішкентай кристалдар туралы ойлау және шындықты армандау
Dialogue: 0,0:38:18.32,0:38:21.36,Default CN,,0,0,0,,Масамүненің миссиясы туралы ой толғау
Dialogue: 0,0:38:22.66,0:38:25.66,Default CN,,0,0,0,,Кімде шынайы тілек бар?
Dialogue: 0,0:38:26.28,0:38:27.24,Default CN,,0,0,0,,Жақсы емес
Dialogue: 0,0:38:27.24,0:38:28.45,Default CN,,0,0,0,,Мен де жақсылықты бағалаймын.
Dialogue: 0,0:38:28.45,0:38:30.20,Default CN,,0,0,0,,Қолданыстағы жалға берушінің бастапқы нүктесі
Dialogue: 0,0:38:30.20,0:38:32.21,Default CN,,0,0,0,,Надаия алғышарттары шамамен жақсы оқиға
Dialogue: 0,0:38:33.00,0:38:35.21,Default CN,,0,0,0,,Қасық келді
Dialogue: 0,0:38:35.21,0:38:37.29,Default CN,,0,0,0,,Наурыздың соңына дейін де қолданылады
Dialogue: 0,0:38:37.29,0:38:38.96,Default CN,,0,0,0,,...
Dialogue: 0,0:38:38.96,0:38:40.67,Default CN,,0,0,0,,Жасым сонша, мен кеттім
Dialogue: 0,0:38:41.05,0:38:43.51,Default CN,,0,0,0,,Нана
Dialogue: 0,0:38:45.97,0:38:48.64,Default CN,,0,0,0,,Жақсы Насаки филиалының инженериясы
Dialogue: 0,0:38:52.31,0:38:53.52,Default CN,,0,0,0,,Қолжетімсіз
Dialogue: 0,0:38:53.52,0:38:56.86,Default CN,,0,0,0,,Оқиғаның түбі
Dialogue: 0,0:38:56.86,0:38:59.28,Default CN,,0,0,0,,Басқа адамның келуі туралы айту мүмкін емес.
Dialogue: 0,0:39:02.74,0:39:03.70,Default CN,,0,0,0,,Мұндайды есту өте сирек
Dialogue: 0,0:39:04.57,0:39:06.82,Default CN,,0,0,0,,...
Dialogue: 0,0:39:06.82,0:39:08.28,Default CN,,0,0,0,,Сайя Гаша келді
Dialogue: 0,0:39:09.95,0:39:10.58,Default CN,,0,0,0,,Керіскерлер тобы
Dialogue: 0,0:39:10.58,0:39:13.29,Default CN,,0,0,0,,Қолтық астындағы ауырсыну
Dialogue: 0,0:39:14.25,0:39:16.50,Default CN,,0,0,0,,Бұйрықтың өлімі
Dialogue: 0,0:39:16.50,0:39:18.09,Default CN,,0,0,0,,Нобунаоның уақытына байланысты.
Dialogue: 0,0:39:20.38,0:39:22.38,Default CN,,0,0,0,,Нацуки шағын жел әні
Dialogue: 0,0:39:22.38,0:39:26.30,Default CN,,0,0,0,,Менің алдымдағы жағдай туралы сәл оғаш оқиға
Dialogue: 0,0:39:27.01,0:39:28.55,Default CN,,0,0,0,,Бұл қамал қамалы
Dialogue: 0,0:39:30.01,0:39:31.81,Default CN,,0,0,0,,Қай жерде зерттеуге болатынын қараңыз
Dialogue: 0,0:39:36.77,0:39:38.81,Default CN,,0,0,0,,Өлмейтіндік мектебін толығымен аяқтау
Dialogue: 0,0:39:39.65,0:39:40.65,Default CN,,0,0,0,,Қайтыс болды
Dialogue: 0,0:39:41.53,0:39:44.57,Default CN,,0,0,0,,Дегенмен мен мектептің иелігіндегі ескі мұғаліммін.
Dialogue: 0,0:39:45.11,0:39:46.28,Default CN,,0,0,0,,Тегін мектеп?
Dialogue: 0,0:39:47.74,0:39:51.41,Default CN,,0,0,0,,「」
Dialogue: 0,0:39:51.99,0:39:54.41,Default CN,,0,0,0,,Кездесу туралы не айтамын?
Dialogue: 0,0:39:55.79,0:39:56.62,Default CN,,0,0,0,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:40:08.47,0:40:09.22,Default CN,,0,0,0,,Жоқ
Dialogue: 0,0:40:11.76,0:40:13.47,Default CN,,0,0,0,,Келу уақыты
Dialogue: 0,0:40:14.18,0:40:15.56,Default CN,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:40:16.23,0:40:18.85,Default CN,,0,0,0,,Аспанға жеткеніме көп болды
Dialogue: 0,0:40:18.85,0:40:20.77,Default CN,,0,0,0,,Осыдан кейін үй иесі белгілі бір уақытта қайтадан бастайды.
Dialogue: 0,0:40:26.15,0:40:28.61,Default CN,,0,0,0,,Бірлескен ұрыс шебі тамаша
Dialogue: 0,0:40:32.03,0:40:33.16,Default CN,,0,0,0,,Йошихиса Фьюси
Dialogue: 0,0:40:33.16,0:40:34.75,Default CN,,0,0,0,,Кішкентай қызыл қалпақ
Dialogue: 0,0:40:34.75,0:40:36.25,Default CN,,0,0,0,,Сіз кенеттен құлап қалдыңыз
Dialogue: 0,0:40:37.08,0:40:40.04,Default CN,,0,0,0,,Кішкентай қызыл қалпақты ойыншық ретінде көру идеясы
Dialogue: 0,0:40:40.63,0:40:41.71,Default CN,,0,0,0,,Нинфу резиденциясын сәтті аяқтау
Dialogue: 0,0:40:42.29,0:40:43.88,Default CN,,0,0,0,,Жақсы уақыт өткізіңіз
Dialogue: 0,0:40:44.46,0:40:46.26,Default CN,,0,0,0,,Жалға берушіге тамақты бастауға рұқсат етіледі
Dialogue: 0,0:40:46.84,0:40:48.59,Default CN,,0,0,0,,Өзара көмек қол жетімді
Dialogue: 0,0:40:49.43,0:40:51.01,Default CN,,0,0,0,,Шығаруды басқару
Dialogue: 0,0:40:51.80,0:40:55.02,Default CN,,0,0,0,,Мен оқиғаны ұмытып кеттім.
Dialogue: 0,0:40:56.35,0:40:57.77,Default CN,,0,0,0,,Қол жеткізу үшін қасық
Dialogue: 0,0:40:57.77,0:40:59.60,Default CN,,0,0,0,,Орындалғысы келгеннен кейін
Dialogue: 0,0:41:00.15,0:41:03.07,Default CN,,0,0,0,,Сіздің партияңыздың жоғалуы туралы барлық естеліктер
Dialogue: 0,0:41:03.07,0:41:04.07,Default CN,,0,0,0,,Ондық ниет?
Dialogue: 0,0:41:04.48,0:41:07.24,Default CN,,0,0,0,,Қамал қамалы да жақсы
Dialogue: 0,0:41:07.24,0:41:08.70,Default CN,,0,0,0,,Барлық қалалық естеліктер
Dialogue: 0,0:41:08.70,0:41:10.86,Default CN,,0,0,0,,Кездесуді де есіне алады.
Dialogue: 0,0:41:10.86,0:41:12.74,Default CN,,0,0,0,,Барлығы қосылған
Dialogue: 0,0:41:14.79,0:41:16.70,Default CN,,0,0,0,,30 наурызға дейін
Dialogue: 0,0:41:16.70,0:41:20.75,Default CN,,0,0,0,,Қызметінен айырылған адамдардың нақты тілектеріне қатысты әңгіме, еске алу кездесуі күтілуде.
Dialogue: 0,0:41:21.33,0:41:24.71,Default CN,,0,0,0,,Егер сіз топтың бұрынғы мүшесі болсаңыз, бізге осы жерден хабарласыңыз.
Dialogue: 0,0:41:25.75,0:41:27.38,Default CN,,0,0,0,,Таңдау жоқ.
Dialogue: 0,0:41:28.84,0:41:30.38,Default CN,,0,0,0,,Цутори сізді және өзіңізді шешеді
Dialogue: 0,0:41:33.80,0:41:34.85,Default CN,,0,0,0,,Сондықтан
Dialogue: 0,0:41:34.85,0:41:37.85,Default CN,,0,0,0,,Нәтижеге көңілім толмайды.
Dialogue: 0,0:41:38.39,0:41:39.77,Default CN,,0,0,0,,Жоғалған естеліктер
Dialogue: 0,0:41:42.94,0:41:46.36,Default CN,,0,0,0,,Мен оны бастапқыда осылай көрдім.
Dialogue: 0,0:41:47.03,0:41:50.11,Default CN,,0,0,0,,Кіші кристал
Dialogue: 0,0:41:58.33,0:41:59.08,Default CN,,0,0,0,,Э-э...
Dialogue: 0,0:42:01.33,0:42:05.67,Default CN,,0,0,0,,Мен өте әдепсіз студентпін, мен топтың басына, Санаданың курстастарына айқайлаймын.
Dialogue: 0,0:42:09.30,0:42:10.80,Default CN,,0,0,0,,Таку қабылдаудан кейін қайтыс болды
Dialogue: 0,0:42:10.80,0:42:14.76,Default CN,,0,0,0,,Шығыстағы аяулы әйелдің өмір тарихы
Dialogue: 0,0:42:20.18,0:42:23.56,Default CN,,0,0,0,,Менің досым менің үйімді тастап, үлкен жетістікке жетті.
Dialogue: 0,0:42:27.32,0:42:30.28,Default CN,,0,0,0,,Санада университетінің адамы
Dialogue: 0,0:42:30.28,0:42:33.61,Default CN,,0,0,0,,Өте белсенді және белсенді
Dialogue: 0,0:42:35.91,0:42:38.58,Default CN,,0,0,0,,Ескі шебер
Dialogue: 0,0:42:43.04,0:42:44.00,Default CN,,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:42:44.00,0:42:47.21,Default CN,,0,0,0,,Сен ең жақсы қызсың
Dialogue: 0,0:42:49.67,0:42:50.92,Default CN,,0,0,0,,Мен әлі... әлі де тірімін
Dialogue: 0,0:42:56.22,0:42:59.06,Default CN,,0,0,0,,Кездесуден бері Икеданың мойындауы
Dialogue: 0,0:42:59.06,0:43:00.56,Default CN,,0,0,0,,Ойланатын қашықтық
Dialogue: 0,0:43:00.85,0:43:04.52,Default CN,,0,0,0,,Икеда
Dialogue: 0,0:43:04.52,0:43:06.48,Default CN,,0,0,0,,Өлгеннен кейін өлген баланың бейнесі
Dialogue: 0,0:43:07.02,0:43:11.82,Default CN,,0,0,0,,Бала бастауыш сыныпта оқып жүрген кезі
Dialogue: 0,0:43:12.69,0:43:14.95,Default CN,,0,0,0,,Дегенмен, бұл да бірінші
Dialogue: 0,0:43:14.95,0:43:17.07,Default CN,,0,0,0,,Мен сені енді көрмеймін.
Dialogue: 0,0:43:17.07,0:43:20.87,Default CN,,0,0,0,,Масуири басталғаннан кейін, басқа жақсы мүсіндердің басталуы және Санада қозғалысының аяқталуы.
Dialogue: 0,0:43:22.41,0:43:24.87,Default CN,,0,0,0,,Мен үшін ең зиянды нәрсе не?
Dialogue: 0,0:43:35.55,0:43:37.22,Default CN,,0,0,0,,Шин Анзай
Dialogue: 0,0:43:46.90,0:43:51.61,Default CN,,0,0,0,,Сыртқы келбет тек бір адам емес, көптеген адамдарда сезім болады.
Dialogue: 0,0:43:51.61,0:43:52.86,Default CN,,0,0,0,,Өнімділік
Dialogue: 0,0:43:52.86,0:43:53.99,Default CN,,0,0,0,,Жақсы балл
Dialogue: 0,0:43:53.99,0:43:54.78,Default CN,,0,0,0,,Сіз үйдесіз
Dialogue: 0,0:43:54.78,0:43:56.15,Default CN,,0,0,0,,...
Dialogue: 0,0:43:56.15,0:43:57.32,Default CN,,0,0,0,,Кейін
Dialogue: 0,0:43:57.32,0:43:58.82,Default CN,,0,0,0,,Көру үшін қол жетімді анықталмаған тіл
Dialogue: 0,0:43:58.82,0:44:00.49,Default CN,,0,0,0,,Жағымсыз тұстар туралы айту
Dialogue: 0,0:44:02.58,0:44:04.20,Default CN,,0,0,0,,Сіздің үйіңізден көңіліңіз қалды.
Dialogue: 0,0:44:04.20,0:44:05.71,Default CN,,0,0,0,,Растау статусы
Dialogue: 0,0:44:13.38,0:44:14.30,Default CN,,0,0,0,,Ашық емес
Dialogue: 0,0:44:14.30,0:44:16.13,Default CN,,0,0,0,,...
Dialogue: 0,0:44:16.13,0:44:17.47,Default CN,,0,0,0,,Жақсы өнімділік
Dialogue: 0,0:44:17.47,0:44:18.97,Default CN,,0,0,0,,Шинбэй
Dialogue: 0,0:44:19.72,0:44:21.26,Default CN,,0,0,0,,Сәттілік
Dialogue: 0,0:44:21.26,0:44:22.60,Default CN,,0,0,0,,Төмен класты ергежейлі
Dialogue: 0,0:44:22.60,0:44:24.22,Default CN,,0,0,0,,Мұны істеу мүмкін емес
Dialogue: 0,0:44:24.22,0:44:27.02,Default CN,,0,0,0,,Налаңға, бізде бар осы кілтті тағы бір қарап шығайын ба?
Dialogue: 0,0:44:27.02,0:44:28.40,Default CN,,0,0,0,,...
Dialogue: 0,0:44:28.40,0:44:29.86,Default CN,,0,0,0,,Бұл жер...
Dialogue: 0,0:44:31.27,0:44:33.19,Default CN,,0,0,0,,Дугаку Санада жылайды
Dialogue: 0,0:44:33.19,0:44:36.07,Default CN,,0,0,0,,Тағы бір еркек дос
Dialogue: 0,0:44:36.07,0:44:38.07,Default CN,,0,0,0,,Үйретуге болмайтын тіл және басқа да әртүрлі мәселелер
Dialogue: 0,0:44:38.07,0:44:39.20,Default CN,,0,0,0,,Шынайы кімдігі: барлаушы
Dialogue: 0,0:44:39.20,0:44:40.45,Default CN,,0,0,0,,Сәттілік
Dialogue: 0,0:44:40.45,0:44:41.49,Default CN,,0,0,0,,Ашу
Dialogue: 0,0:44:41.49,0:44:42.99,Default CN,,0,0,0,,...
Dialogue: 0,0:44:42.99,0:44:44.04,Default CN,,0,0,0,,Сәттілік
Dialogue: 0,0:44:44.79,0:44:46.75,Default CN,,0,0,0,,...
Dialogue: 0,0:44:46.75,0:44:49.75,Default CN,,0,0,0,,Мен онымен не істерімді білмеймін.
Dialogue: 0,0:44:51.88,0:44:52.88,Default CN,,0,0,0,,Менің зияным
Dialogue: 0,0:44:53.96,0:44:55.17,Default CN,,0,0,0,,...
Dialogue: 0,0:44:55.17,0:44:57.38,Default CN,,0,0,0,,Сол кездегі партияның орындалуы
Dialogue: 0,0:44:57.38,0:45:00.30,Default CN,,0,0,0,,Тәңірдің сол циклі, лак қара кесегі
Dialogue: 0,0:45:00.30,0:45:02.43,Default CN,,0,0,0,,Сырты да тынышталды.
Dialogue: 0,0:45:03.64,0:45:06.14,Default CN,,0,0,0,,Туған күнің құтты болсын!
Dialogue: 0,0:45:06.93,0:45:07.89,Default CN,,0,0,0,,Бұл рөл де біраз қиын екен…
Dialogue: 0,0:45:07.89,0:45:10.06,Default CN,,0,0,0,,Өзін-өзі жою жағдайы туралы есеп
Dialogue: 0,0:45:10.69,0:45:11.77,Default CN,,0,0,0,,Мен де білмеймін.
Dialogue: 0,0:45:13.32,0:45:14.98,Default CN,,0,0,0,,Оқиғадан кейін
Dialogue: 0,0:45:15.48,0:45:18.11,Default CN,,0,0,0,,Мектептің аяқталуы
Dialogue: 0,0:45:28.16,0:45:29.29,Default CN,,0,0,0,,Оянба
Dialogue: 0,0:45:29.29,0:45:30.54,Default CN,,0,0,0,,Оянба
Dialogue: 0,0:45:30.54,0:45:32.00,Default CN,,0,0,0,,Сенің жүрегің күшті
Dialogue: 0,0:45:33.46,0:45:34.25,Default CN,,0,0,0,,Оянба
Dialogue: 0,0:45:38.01,0:45:40.88,Default CN,,0,0,0,,Мен дұрыс ойлай аламын.
Dialogue: 0,0:45:42.51,0:45:44.85,Default CN,,0,0,0,,Басқа адамдар туралы ойлау
7
Dialogue: 0,0:45:50.06,0:45:55.65,Default CN,,0,0,0,,...
Dialogue: 0,0:45:55.65,0:45:56.98,Default CN,,0,0,0,,Идея қайда?
Dialogue: 0,0:45:56.98,0:46:01.61,Default CN,,0,0,0,,Дүние жойылғанша Санаданы кешіріңіз.
Dialogue: 0,0:46:02.53,0:46:03.32,Default CN,,0,0,0,,Бұл рөл де біраз қиын екен…
Dialogue: 0,0:46:03.95,0:46:06.95,Default CN,,0,0,0,,Ұлы отбасын еске алу жиналысының жоғалуы
Dialogue: 0,0:46:08.25,0:46:10.75,Default CN,,0,0,0,,...
Dialogue: 0,0:46:23.43,0:46:27.22,Default CN,,0,0,0,,Мұнда көрсетілгендей дереу жеткізу
Dialogue: 0,0:46:29.89,0:46:31.14,Default CN,,0,0,0,,Бұл операцияның аяқталуы
Dialogue: 0,0:46:32.23,0:46:33.65,Default CN,,0,0,0,,...
Dialogue: 0,0:46:34.31,0:46:37.07,Default CN,,0,0,0,,Жалға берушінің таза емес азық-түлік сауда қауымдастығы
Dialogue: 0,0:46:37.65,0:46:38.90,Default CN,,0,0,0,,Маған Чидо бейнесі ұнайды.
Dialogue: 0,0:46:50.70,0:46:51.33,Default CN,,0,0,0,,Бірақ біз бір жерден бірдеңе тауып қалармыз.
Dialogue: 0,0:47:05.97,0:47:07.97,Default CN,,0,0,0,,Бұл сегіз түсті қорап па?
Dialogue: 0,0:47:21.69,0:47:22.99,Default CN,,0,0,0,,...
Dialogue: 0,0:47:26.95,0:47:28.62,Default CN,,0,0,0,,Сіз оны осылай аласыз.
Dialogue: 0,0:47:28.62,0:47:30.08,Default CN,,0,0,0,,Бұл логикалық және динамикалық.
Dialogue: 0,0:47:30.79,0:47:32.33,Default CN,,0,0,0,,Бұл «Арман фантастикасы» (3)
Dialogue: 0,0:47:34.46,0:47:36.63,Default CN,,0,0,0,,Шығу тегі - көне сегіз тонды қорап.
Dialogue: 0,0:47:37.25,0:47:38.08,Default CN,,0,0,0,,Макото
Dialogue: 0,0:47:39.88,0:47:41.84,Default CN,,0,0,0,,...
Dialogue: 0,0:47:50.14,0:47:51.22,Default CN,,0,0,0,,Өлім оқиғасы
Dialogue: 0,0:47:51.89,0:47:53.23,Default CN,,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:47:53.23,0:47:54.73,Default CN,,0,0,0,,Сяо Цзинью
Dialogue: 0,0:47:54.73,0:47:55.81,Default CN,,0,0,0,,Кіші кристал
Dialogue: 0,0:47:58.90,0:48:00.82,Default CN,,0,0,0,,Кешіріңіз
Dialogue: 0,0:48:10.91,0:48:11.70,Default CN,,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:48:13.41,0:48:14.91,Default CN,,0,0,0,,Бірыңғай форма
Dialogue: 0,0:48:15.79,0:48:17.46,Default CN,,0,0,0,,Бұл Қар бөліміндегі бесінші орта мектеп ме?
Dialogue: 0,0:48:21.34,0:48:22.55,Default CN,,0,0,0,,Әңгіменің соңы
Dialogue: 0,0:48:22.88,0:48:25.05,Default CN,,0,0,0,,Алайда бұл күтпеген жағдай.
Dialogue: 0,0:48:25.05,0:48:29.22,Default CN,,0,0,0,,...
Dialogue: 0,0:48:31.60,0:48:34.43,Default CN,,0,0,0,,...
Dialogue: 0,0:48:35.35,0:48:37.48,Default CN,,0,0,0,,Дегенмен, бастапқыда жоғарыдағы ақпаратты алып тастау қажет.
Dialogue: 0,0:48:37.89,0:48:41.73,Default CN,,0,0,0,,Мен мектепте оқып жүргенде көп адам өмірден өтті.
Dialogue: 0,0:48:45.07,0:48:47.15,Default CN,,0,0,0,,Тек кішкентай қызыл қалпақ керек
Dialogue: 0,0:48:47.15,0:48:51.20,Default CN,,0,0,0,,Онымен өзара байланыстыра білу осы мектеп.
Dialogue: 0,0:48:52.49,0:48:53.66,Default CN,,0,0,0,,...
Dialogue: 0,0:48:54.74,0:48:56.12,Default CN,,0,0,0,,Сен сонда болған кезде қарадың.
Dialogue: 0,0:48:57.12,0:48:58.12,Default CN,,0,0,0,,Құпиялылық
Dialogue: 0,0:48:58.12,0:49:00.83,Default CN,,0,0,0,,Менің жүрегім жойылуы мүмкін.
Dialogue: 0,0:49:01.17,0:49:02.79,Default CN,,0,0,0,,Na - бұл баға
Dialogue: 0,0:49:02.79,0:49:05.17,Default CN,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:49:05.59,0:49:08.88,Default CN,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:49:09.47,0:49:12.10,Default CN,,0,0,0,,Бұл жай ғана сіз үшін тапсырыс.
Dialogue: 0,0:49:12.10,0:49:16.35,Default CN,,0,0,0,,Бұдан әрі «Тілек қасық» мағынасы
Dialogue: 0,0:49:18.39,0:49:21.81,Default CN,,0,0,0,,Басқа астана бар қалада белгілі бір ән бар.
Dialogue: 0,0:49:23.65,0:49:25.78,Default CN,,0,0,0,,Мен мұның не екенін білмеймін.
Dialogue: 0,0:49:27.94,0:49:29.15,Default CN,,0,0,0,,...
Dialogue: 0,0:49:30.70,0:49:33.16,Default CN,,0,0,0,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:49:36.70,0:49:38.71,Default CN,,0,0,0,,Мен бұл туралы ойлана алдым.
Dialogue: 0,0:49:42.21,0:49:45.13,Default CN,,0,0,0,,Қосымша мәліметтер: Толығымен белгісіз жол
Dialogue: 0,0:49:46.67,0:49:49.88,Default CN,,0,0,0,,Маған қыздың мектебін тыңдауға рұқсат жоқ.
Dialogue: 0,0:49:49.88,0:49:51.51,Default CN,,0,0,0,,Бұл оңай емес.
Dialogue: 0,0:49:57.72,0:49:58.98,Default CN,,0,0,0,,Бұл субтитрлерді Miao Meng Milk Tea House дайындады. Олар тек алмасу және алдын ала қарау мақсатында ғана арналған; коммерциялық мақсатта пайдаланбаңыз. Аударма: passengercity, Shutiao, Zhi Xiang Yongheng, Ryusaki. Өңдеу: Kono Sekai ni i o Komete. Уақытты баптау: VV. Кейінгі өңдеу: MIR. Дәстүрлі қытайша бейімдеу: Yuzuki. Арнайы эффектілер: A5
Dialogue: 0,0:49:58.98,0:49:59.98,Default CN,,0,0,0,,Шайқас
Dialogue: 0,0:50:00.69,0:50:02.73,Default CN,,0,0,0,,...
Dialogue: 0,0:50:03.27,0:50:04.11,Default CN,,0,0,0,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:50:04.98,0:50:07.86,Default CN,,0,0,0,,Шын мән
Dialogue: 0,0:50:07.86,0:50:09.94,Default CN,,0,0,0,,Көріну мүмкіндігі жоқ
Dialogue: 0,0:50:16.49,0:50:17.20,Default CN,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:50:19.95,0:50:22.25,Default CN,,0,0,0,,Жүрек
Dialogue: 0,0:50:22.25,0:50:22.83,Default CN,,0,0,0,,...
Dialogue: 0,0:50:24.58,0:50:27.34,Default CN,,0,0,0,,...
Dialogue: 0,0:50:27.34,0:50:28.80,Default CN,,0,0,0,,...
Dialogue: 0,0:50:29.26,0:50:32.51,Default CN,,0,0,0,,Китажима Роши қазір дүниеден өтті
Dialogue: 0,0:50:33.47,0:50:36.43,Default CN,,0,0,0,,Бұл біздің мектептің проблемасы.
Dialogue: 0,0:50:36.43,0:50:38.35,Default CN,,0,0,0,,Гатоман Санаданың оқиғасы
Dialogue: 0,0:50:38.35,0:50:40.52,Default CN,,0,0,0,,Сіздің сүйікті суреттеріңіз туралы көптеген талқылаулар
Dialogue: 0,0:50:40.52,0:50:41.77,Default CN,,0,0,0,,Кездесу?
Dialogue: 0,0:50:42.39,0:50:43.23,Default CN,,0,0,0,,Сеніңше, қалай?
Dialogue: 0,0:50:44.15,0:50:46.11,Default CN,,0,0,0,,Васанаданы тікелей көру керек
Dialogue: 0,0:50:48.27,0:50:50.32,Default CN,,0,0,0,,Ескі шебер
Dialogue: 0,0:50:50.32,0:50:52.36,Default CN,,0,0,0,,Ескі шебер
Dialogue: 0,0:50:53.82,0:50:55.07,Default CN,,0,0,0,,Хаоден
Dialogue: 0,0:50:58.49,0:51:00.62,Default CN,,0,0,0,,Ида Роши дұрыс
Dialogue: 0,0:51:00.62,0:51:01.66,Default CN,,0,0,0,,Шынайы принциптер
Dialogue: 0,0:51:03.71,0:51:06.75,Default CN,,0,0,0,,Оқушыларды шақыру оңай
Dialogue: 0,0:51:06.75,0:51:09.50,Default CN,,0,0,0,,Осында келген кездегі басымнан өткен естеліктер
Dialogue: 0,0:51:10.00,0:51:12.51,Default CN,,0,0,0,,Алайда бұған Санадая жауапты.
Dialogue: 0,0:51:12.51,0:51:13.26,Default CN,,0,0,0,,Мен де өкінемін...
Dialogue: 0,0:51:13.26,0:51:14.93,Default CN,,0,0,0,,Көргенімнен айырылғаныма өкінемін.
Dialogue: 0,0:51:15.51,0:51:17.51,Default CN,,0,0,0,,Жұмыстың бар екендігі туралы рефлексия
Dialogue: 0,0:51:17.51,0:51:21.10,Default CN,,0,0,0,,Ная - қарт шеберді көрудің себебі.
Dialogue: 0,0:51:21.10,0:51:25.85,Default CN,,0,0,0,,Өзіне зиян келтіру
Dialogue: 0,0:51:26.81,0:51:28.06,Default CN,,0,0,0,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:51:28.06,0:51:28.82,Default CN,,0,0,0,,Дегенмен, бұл...
Dialogue: 0,0:51:28.82,0:51:34.24,Default CN,,0,0,0,,...
Dialogue: 0,0:51:34.95,0:51:38.70,Default CN,,0,0,0,,Санаданың кішкентай жеңгесі - жылап тұрған әйел бейнесі туралы әңгіме.
Dialogue: 0,0:51:38.70,0:51:39.95,Default CN,,0,0,0,,Негізсіз
Dialogue: 0,0:51:39.95,0:51:42.33,Default CN,,0,0,0,,Мен екі тараптың да заң жүзінде жауапты екеніне сенемін.
Dialogue: 0,0:51:42.33,0:51:43.75,Default CN,,0,0,0,,Тоқтату
Dialogue: 0,0:51:43.75,0:51:45.08,Default CN,,0,0,0,,Келесі кезек келгенде
Dialogue: 0,0:51:45.08,0:51:50.17,Default CN,,0,0,0,,Жоғары сынып директорының немесе мектеп директорының шығу тегі
Dialogue: 0,0:51:54.59,0:51:55.93,Default CN,,0,0,0,,Жақсы таяқ
Dialogue: 0,0:51:55.93,0:51:57.26,Default CN,,0,0,0,,...
Dialogue: 0,0:51:57.26,0:51:59.14,Default CN,,0,0,0,,өзімшіл? Студент қыз?
Dialogue: 0,0:52:00.35,0:52:02.31,Default CN,,0,0,0,,Мұнда емес.
Dialogue: 0,0:52:02.31,0:52:03.60,Default CN,,0,0,0,,Жыл сайын қалада
Dialogue: 0,0:52:04.43,0:52:06.14,Default CN,,0,0,0,,Биылғы жаз Вэйи
Dialogue: 0,0:52:06.14,0:52:07.60,Default CN,,0,0,0,,Бағдарламаны аяқтағаннан кейін бағдарлама аяқталды.
Dialogue: 0,0:52:08.10,0:52:09.81,Default CN,,0,0,0,,Кету уақыты келді ме?
Dialogue: 0,0:52:09.81,0:52:12.48,Default CN,,0,0,0,,3 күн 2 түн өмір сүру
Dialogue: 0,0:52:12.48,0:52:13.61,Default CN,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:52:13.94,0:52:15.95,Default CN,,0,0,0,,Сәттілік!
Dialogue: 0,0:52:15.95,0:52:17.45,Default CN,,0,0,0,,кекештену кекештену
Dialogue: 0,0:52:17.45,0:52:20.41,Default CN,,0,0,0,,Менің оқиғам: Маған мұны істеудің қажеті жоқ.
Dialogue: 0,0:52:20.41,0:52:21.58,Default CN,,0,0,0,,...
Dialogue: 0,0:52:21.87,0:52:22.83,Default CN,,0,0,0,,Айқайлау?
Dialogue: 0,0:52:24.25,0:52:24.95,Default CN,,0,0,0,,Тағы кездескенше
Dialogue: 0,0:52:25.66,0:52:26.54,Default CN,,0,0,0,,Жұмыртқадан жасалған торт
Dialogue: 0,0:52:27.12,0:52:28.75,Default CN,,0,0,0,,Кешіріңіз
Dialogue: 0,0:52:28.75,0:52:31.04,Default CN,,0,0,0,,...
Dialogue: 0,0:52:31.04,0:52:32.50,Default CN,,0,0,0,,Шынайы мағына
Dialogue: 0,0:52:32.50,0:52:33.80,Default CN,,0,0,0,,Сәттілік
Dialogue: 0,0:52:37.26,0:52:40.14,Default CN,,0,0,0,,Тәжге арналған маска
Dialogue: 0,0:52:40.14,0:52:43.39,Default CN,,0,0,0,,Мен жоқта емес
Dialogue: 0,0:52:43.39,0:52:46.06,Default CN,,0,0,0,,Мен не айтқым келеді?
Dialogue: 0,0:52:47.19,0:52:49.19,Default CN,,0,0,0,,Бұл туралы бізбен сөйлесудің қажеті жоқ.
Dialogue: 0,0:52:49.19,0:52:51.73,Default CN,,0,0,0,,Қасқыр ересектер және туған күніңізбен
Dialogue: 0,0:52:56.69,0:53:00.03,Default CN,,0,0,0,,Менің түсіндіруім
Dialogue: 0,0:53:06.20,0:53:08.46,Default CN,,0,0,0,,Құрметті баршаңызға!
Dialogue: 0,0:53:08.46,0:53:11.42,Default CN,,0,0,0,,3-ші семестр мүгедектігінің мектепке баруы
Dialogue: 0,0:53:14.38,0:53:17.84,Default CN,,0,0,0,,Ата-анамның тілі қажет
Dialogue: 0,0:53:18.59,0:53:21.43,Default CN,,0,0,0,,Алайда мен тегін мектеп бітірдім.
Dialogue: 0,0:53:21.76,0:53:24.39,Default CN,,0,0,0,,Тегін мектеп
Dialogue: 0,0:53:24.89,0:53:27.93,Default CN,,0,0,0,,Достары бар қарт шебер
Dialogue: 0,0:53:28.31,0:53:30.85,Default CN,,0,0,0,,...
Dialogue: 0,0:53:30.85,0:53:32.56,Default CN,,0,0,0,,Киташима
Dialogue: 0,0:53:33.23,0:53:34.65,Default CN,,0,0,0,,...
Dialogue: 0,0:53:34.65,0:53:36.73,Default CN,,0,0,0,,...
Dialogue: 0,0:53:36.73,0:53:38.11,Default CN,,0,0,0,,Иә
Dialogue: 0,0:53:38.11,0:53:40.41,Default CN,,0,0,0,,Тегін мектеп немесе шынайы мектеп емес
Dialogue: 0,0:53:40.41,0:53:42.24,Default CN,,0,0,0,,...
Dialogue: 0,0:53:42.87,0:53:44.41,Default CN,,0,0,0,,Жеке кеңседен шығу керек
Dialogue: 0,0:53:44.41,0:53:46.83,Default CN,,0,0,0,,Қоғамдық істерге сенбеу
Dialogue: 0,0:53:48.54,0:53:50.87,Default CN,,0,0,0,,Әкем екеуміз
Dialogue: 0,0:53:50.87,0:53:53.17,Default CN,,0,0,0,,Сондықтан мен бухгалтерлік есеп жүйесіне жазылдым.
Dialogue: 0,0:53:53.50,0:53:55.75,Default CN,,0,0,0,,Менің де ойым бар
Dialogue: 0,0:53:56.42,0:53:58.63,Default CN,,0,0,0,,Басқа мектеп
Dialogue: 0,0:54:01.47,0:54:06.10,Default CN,,0,0,0,,Дегенмен, мектеп сізді орналастыра алмауы мүмкін.
Dialogue: 0,0:54:07.43,0:54:09.68,Default CN,,0,0,0,,Сондықтан мен түсіндірмені оқыдым.
Dialogue: 0,0:54:09.68,0:54:13.31,Default CN,,0,0,0,,Қар курсының ең жас үшінші семестрі
Dialogue: 0,0:54:13.31,0:54:14.40,Default CN,,0,0,0,,Дегенмен, бұл Сакамата қауымдастығы…
Dialogue: 0,0:54:15.23,0:54:17.61,Default CN,,0,0,0,,Дүниенің басталуы
Dialogue: 0,0:54:17.61,0:54:19.36,Default CN,,0,0,0,,Шунайчи Теншуко
Dialogue: 0,0:54:20.78,0:54:21.82,Default CN,,0,0,0,,Құдай-ай, бәрі тым кішірейіп кеткендіктен ғой
Dialogue: 0,0:54:22.49,0:54:25.12,Default CN,,0,0,0,,Жеке кабинет
Dialogue: 0,0:54:26.03,0:54:28.37,Default CN,,0,0,0,,Медициналық кабинет кітапханасы
Dialogue: 0,0:54:29.08,0:54:32.58,Default CN,,0,0,0,,Білім жолына мен жауаптымын.
Dialogue: 0,0:54:34.79,0:54:38.55,Default CN,,0,0,0,,Біз сөйлей алмайтындықтан, өзара көмек
Dialogue: 0,0:54:49.81,0:54:52.06,Default CN,,0,0,0,,...
Dialogue: 0,0:54:52.94,0:54:54.77,Default CN,,0,0,0,,Менің оянып кетуім керек.
Dialogue: 0,0:54:55.27,0:54:56.48,Default CN,,0,0,0,,Пайдаланылмаған
Dialogue: 0,0:54:56.48,0:54:57.73,Default CN,,0,0,0,,Апатты
Dialogue: 0,0:54:57.73,0:54:59.23,Default CN,,0,0,0,,Нагадан шығу қақпасы аяқталды
Dialogue: 0,0:55:00.07,0:55:01.36,Default CN,,0,0,0,,Көшедегі ұялшақтық
Dialogue: 0,0:55:12.62,0:55:14.37,Default CN,,0,0,0,,Мен мұнда емеспін.
Dialogue: 0,0:55:15.21,0:55:18.34,Default CN,,0,0,0,,Мен өзімнің досыммын.
Dialogue: 0,0:55:42.86,0:55:43.90,Default CN,,0,0,0,,Комое
Dialogue: 0,0:56:08.51,0:56:09.76,Default CN,,0,0,0,,Жылдамдық
Dialogue: 0,0:56:36.00,0:56:37.67,Default CN,,0,0,0,,Шин Анзай
Dialogue: 0,0:56:38.46,0:56:41.96,Default CN,,0,0,0,,...
Dialogue: 0,0:56:42.38,0:56:45.92,Default CN,,0,0,0,,Хаттың көшірмесін жіберу керек.
Dialogue: 0,0:56:46.80,0:56:49.89,Default CN,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:56:50.60,0:56:54.35,Default CN,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:56:55.93,0:56:59.27,Default CN,,0,0,0,,「I」
Dialogue: 0,0:57:00.02,0:57:04.03,Default CN,,0,0,0,,Бұл жаздың ауа райының уақыты.
Dialogue: 0,0:57:05.69,0:57:07.74,Default CN,,0,0,0,,Сіз бақыттысыз «Мен»
Dialogue: 0,0:57:08.70,0:57:11.16,Default CN,,0,0,0,,Мен сені кездестірдім, саған май қостым.
Dialogue: 0,0:57:15.54,0:57:17.75,Default CN,,0,0,0,,Белгілі мөлшердегі жұмысшылар саны қажет. Белгілі бір мөлшерде кадр қажет...
Dialogue: 0,0:57:26.42,0:57:27.47,Default CN,,0,0,0,,Анзай Догаку?
Dialogue: 0,0:57:38.81,0:57:39.69,Default CN,,0,0,0,,Өлім оқиғасы
Dialogue: 0,0:57:47.94,0:57:50.07,Default CN,,0,0,0,,Сауалнама Масамүне Дугакуку
Dialogue: 0,0:57:50.07,0:57:52.28,Default CN,,0,0,0,,Бірінші және екінші адам ешқашан келмеді?
Dialogue: 0,0:57:53.87,0:57:55.49,Default CN,,0,0,0,,Екі жасар қысқа желді ән
Dialogue: 0,0:57:56.08,0:57:59.29,Default CN,,0,0,0,,Казусубару Кошо үш жыл
Dialogue: 0,0:57:59.83,0:58:01.46,Default CN,,0,0,0,,Анзай Догаку
Dialogue: 0,0:58:02.00,0:58:03.13,Default CN,,0,0,0,,Сіз осындасыз
Dialogue: 0,0:58:04.21,0:58:06.17,Default CN,,0,0,0,,На Урешино 1 сынып
Dialogue: 0,0:58:06.55,0:58:09.38,Default CN,,0,0,0,,Басқа фамилиялар шағын.
Dialogue: 0,0:58:09.38,0:58:09.97,Default CN,,0,0,0,,артқа
Dialogue: 0,0:58:10.80,0:58:13.59,Default CN,,0,0,0,,Бірінші курс студенті жетім
Dialogue: 0,0:58:15.85,0:58:19.14,Default CN,,0,0,0,,...
Dialogue: 0,0:58:20.43,0:58:21.77,Default CN,,0,0,0,,Гаджичидо
Dialogue: 0,0:58:21.77,0:58:24.90,Default CN,,0,0,0,,Кіші кристалды фамилия Кофука тегі Гато Шираничи
Dialogue: 0,0:58:25.52,0:58:26.57,Default CN,,0,0,0,,Жүрек?
Dialogue: 0,0:58:29.65,0:58:31.15,Default CN,,0,0,0,,Китажима Роши
Dialogue: 0,0:58:50.46,0:58:52.63,Default CN,,0,0,0,,Қарт шебер осында
Dialogue: 0,0:58:53.30,0:58:57.56,Default CN,,0,0,0,,Мен қазір осындамын
Dialogue: 0,0:58:58.51,0:58:59.93,Default CN,,0,0,0,,...
Dialogue: 0,0:59:00.52,0:59:02.27,Default CN,,0,0,0,,Көп түсті
Dialogue: 0,0:59:02.94,0:59:04.69,Default CN,,0,0,0,,...
Dialogue: 0,0:59:07.90,0:59:10.23,Default CN,,0,0,0,,Егер сіз желіні ұстай алатын күйде болсаңыз, хабарлама жіберіңіз.
Dialogue: 0,0:59:14.03,0:59:16.78,Default CN,,0,0,0,,Сіздің қабылдауыңызбен келісемін.
Dialogue: 0,0:59:17.37,0:59:18.49,Default CN,,0,0,0,,Бұл маған қажет емес
Dialogue: 0,0:59:22.41,0:59:24.33,Default CN,,0,0,0,,Мен дарындымын, Ида емтиханды тапсырды.
Dialogue: 0,0:59:25.08,0:59:26.29,Default CN,,0,0,0,,Басқа адамның теріс қылықтары
Dialogue: 0,0:59:28.79,0:59:32.13,Default CN,,0,0,0,,Бұл мен бұрын естіген болмашы әңгіме.
Dialogue: 0,0:59:32.80,0:59:35.26,Default CN,,0,0,0,,Жағымсыз естеліктерді қайталау
Dialogue: 0,0:59:35.76,0:59:36.97,Default CN,,0,0,0,,Ескі шебер
Dialogue: 0,0:59:36.97,0:59:40.39,Default CN,,0,0,0,,Дүниенің кемеңгері келді.
Dialogue: 0,0:59:40.39,0:59:42.68,Default CN,,0,0,0,,Сіз оны тікелей көре алмайсыз
Dialogue: 0,0:59:43.56,0:59:46.35,Default CN,,0,0,0,,Кездесуден бір сөйлем: «Сен оқуға келдің»
Dialogue: 0,0:59:46.35,0:59:48.90,Default CN,,0,0,0,,Елорданың өлімі туралы айтып бере аласыз ба?
Dialogue: 0,0:59:50.02,0:59:51.82,Default CN,,0,0,0,,Қарт шебер Нафушин
Dialogue: 0,0:59:51.82,0:59:54.74,Default CN,,0,0,0,,Нәтижесі мен тегін болғаны туралы әңгіменің әңгімесі.
Dialogue: 0,0:59:55.66,0:59:58.07,Default CN,,0,0,0,,Нәтижесінде, Санада сұлулығы либералды...
Dialogue: 0,0:59:58.49,1:00:03.33,Default CN,,0,0,0,,Токиодағы әрбір мектептің нұсқауларын қалай оқуға болады
Dialogue: 0,1:00:04.58,1:00:08.04,Default CN,,0,0,0,,Дегенмен, менің әңгімемді оқып шығыңыз
Dialogue: 0,1:00:09.17,1:00:10.34,Default CN,,0,0,0,,Апатты
Dialogue: 0,1:00:10.34,1:00:15.80,Default CN,,0,0,0,,Бас менеджер мен Санаданың жағдайы.
Dialogue: 0,1:00:17.80,1:00:22.60,Default CN,,0,0,0,,Сізді кенеттен көру мүмкін.
Dialogue: 0,1:00:22.97,1:00:24.77,Default CN,,0,0,0,,Дегенмен, маған хабарласыңыз.
Dialogue: 0,1:00:24.77,1:00:27.06,Default CN,,0,0,0,,Тоджо Догакушиннің қолдаушысы
Dialogue: 0,1:00:28.23,1:00:30.69,Default CN,,0,0,0,,Шынайы оқиға
Dialogue: 0,1:00:43.58,1:00:44.62,Default CN,,0,0,0,,Рион
Dialogue: 0,1:00:50.71,1:00:52.59,Default CN,,0,0,0,,Басқа адам қайтыс болған кезде
Dialogue: 0,1:00:54.30,1:00:55.46,Default CN,,0,0,0,,Мен де дарындымын.
Dialogue: 0,1:00:56.01,1:00:58.30,Default CN,,0,0,0,,Содан бері футбол командасының демалыс уақыты өтті.
Dialogue: 0,1:00:58.30,1:00:59.55,Default CN,,0,0,0,,Алайда басқа адамның өлімі
Dialogue: 0,1:01:00.85,1:01:02.18,Default CN,,0,0,0,,...
Dialogue: 0,1:01:05.85,1:01:07.10,Default CN,,0,0,0,,Менің көзім көрмей қалды
Dialogue: 0,1:01:07.64,1:01:09.40,Default CN,,0,0,0,,Мен де жолды білмеймін.
Dialogue: 0,1:01:09.40,1:01:11.65,Default CN,,0,0,0,,Masamune және т.б.
Dialogue: 0,1:01:12.27,1:01:13.94,Default CN,,0,0,0,,Бұл жерде өлім емес.
Dialogue: 0,1:01:13.94,1:01:16.90,Default CN,,0,0,0,,Жақсы жұмыс, үй иесі, астана, қарлы пән және орта мектеп оқушысы.
Dialogue: 0,1:01:18.78,1:01:19.32,Default CN,,0,0,0,,Кейде оны ес-түссіз етіп ұрып, полиция тоқтатса да…
Dialogue: 0,1:01:19.74,1:01:20.82,Default CN,,0,0,0,,Мен кінәсізмін
Dialogue: 0,1:01:21.95,1:01:24.74,Default CN,,0,0,0,,Сондықтан мен бұл туралы ойлап отырмын.
Dialogue: 0,1:01:25.49,1:01:28.16,Default CN,,0,0,0,,Қамал қамалы
Dialogue: 0,1:01:28.79,1:01:30.25,Default CN,,0,0,0,,Насаи Казуко
Dialogue: 0,1:01:31.42,1:01:32.92,Default CN,,0,0,0,,Үй иесі
Dialogue: 0,1:01:32.92,1:01:35.05,Default CN,,0,0,0,,Астананың орны бөлек.
Dialogue: 0,1:01:35.50,1:01:38.01,Default CN,,0,0,0,,Бір ой, жақсы мен жаман істермен айналысамын
Dialogue: 0,1:01:45.64,1:01:47.02,Default CN,,0,0,0,,Мен қайдамын?
Dialogue: 0,1:01:47.60,1:01:48.85,Default CN,,0,0,0,,Вокзалда алдарыңызда
Dialogue: 0,1:01:49.31,1:01:50.56,Default CN,,0,0,0,,Бұл жалған
Dialogue: 0,1:01:50.56,1:01:53.31,Default CN,,0,0,0,,Демек, ұлы отбасы шын мәнінде бар.
Dialogue: 0,1:01:53.31,1:01:55.11,Default CN,,0,0,0,,Кейбір шарттар қолданылады.
Dialogue: 0,1:01:55.98,1:01:59.36,Default CN,,0,0,0,,Мен сарайдың қай жерінде екенімді көремін.
Dialogue: 0,1:01:59.36,1:02:01.16,Default CN,,0,0,0,,Кейбір маңызды
Dialogue: 0,1:02:02.03,1:02:06.12,Default CN,,0,0,0,,Өйткені қазіргі уақытта біздің үй иесінің капиталы бар
Dialogue: 0,1:02:06.70,1:02:08.75,Default CN,,0,0,0,,...
Dialogue: 0,1:02:10.62,1:02:12.58,Default CN,,0,0,0,,«Қасық қажет»
Dialogue: 0,1:02:13.17,1:02:14.75,Default CN,,0,0,0,,Сізде шынайы тілек бар.
Dialogue: 0,1:02:17.17,1:02:18.51,Default CN,,0,0,0,,Менің қалауларым
Dialogue: 0,1:02:20.05,1:02:22.47,Default CN,,0,0,0,,Бұл менің апамның үйіме оралуы.
Dialogue: 0,1:02:26.81,1:02:31.27,Default CN,,0,0,0,,Бастауыш сыныпқа барғалы бір жыл болды, әпкем мен әпкем өмірден озды.
Dialogue: 0,1:02:31.27,1:02:32.23,Default CN,,0,0,0,,Тудырған ауру
Dialogue: 0,1:02:32.77,1:02:36.11,Default CN,,0,0,0,,Оны қабылдаңыз
Dialogue: 0,1:02:38.53,1:02:40.07,Default CN,,0,0,0,,Бастапқыда пайдасыз
Dialogue: 0,1:02:40.95,1:02:44.70,Default CN,,0,0,0,,Уақыттың шын мәнін білдім.
Dialogue: 0,1:02:45.95,1:02:48.54,Default CN,,0,0,0,,Оның қазір қайтыс болғаны рас.
Dialogue: 0,1:02:49.91,1:02:51.29,Default CN,,0,0,0,,Менің қалауларым
Dialogue: 0,1:02:52.29,1:02:53.83,Default CN,,0,0,0,,Танаги шағын тостаған
Dialogue: 0,1:02:54.88,1:02:56.63,Default CN,,0,0,0,,Мен қайтуым керек
Dialogue: 0,1:02:56.63,1:02:59.96,Default CN,,0,0,0,,Мен қазір осындамын
Dialogue: 0,1:03:06.60,1:03:07.85,Default CN,,0,0,0,,Мен оны естимін.
Dialogue: 0,1:03:10.18,1:03:13.89,Default CN,,0,0,0,,Қасқыр аң-таң қалып, кішкентай қызыл қалпақ киген маған айғайлайды.
Dialogue: 0,1:03:38.25,1:03:40.80,Default CN,,0,0,0,,Жүрек сен осындасың
Dialogue: 0,1:03:41.17,1:03:43.72,Default CN,,0,0,0,,...
Dialogue: 0,1:03:44.55,1:03:47.80,Default CN,,0,0,0,,Жапон музыкасы және бір жерде жазылған басқа әндер
Dialogue: 0,1:03:47.80,1:03:49.10,Default CN,,0,0,0,,Гая кетіп қалды
Dialogue: 0,1:03:49.51,1:03:50.81,Default CN,,0,0,0,,Мен де
Dialogue: 0,1:03:50.81,1:03:51.56,Default CN,,0,0,0,,Мен кеттім
Dialogue: 0,1:03:52.06,1:03:53.27,Default CN,,0,0,0,,Дегенмен, оны көру мүмкін емес пе?
Dialogue: 0,1:03:53.85,1:03:57.65,Default CN,,0,0,0,,...
Dialogue: 0,1:03:58.02,1:03:59.02,Default CN,,0,0,0,,Мен де
Dialogue: 0,1:03:59.02,1:04:01.94,Default CN,,0,0,0,,Урешино осында болғандықтан, оның тегі кішкентай.
Dialogue: 0,1:04:01.94,1:04:02.61,Default CN,,0,0,0,,Әңгімені мына адам жазған.
Dialogue: 0,1:04:03.32,1:04:04.49,Default CN,,0,0,0,,Кейде оны ес-түссіз етіп ұрып, полиция тоқтатса да…
Dialogue: 0,1:04:05.15,1:04:09.41,Default CN,,0,0,0,,Мен келдім, мен Масамүненің екінші курс алтыншы тобын тамашалап бітірдім.
Dialogue: 0,1:04:10.24,1:04:13.79,Default CN,,0,0,0,,Дегенмен, бұл бас әріптің атауы.
Dialogue: 0,1:04:14.25,1:04:16.46,Default CN,,0,0,0,,Масамуна қайтыс болған кезде
Dialogue: 0,1:04:17.79,1:04:19.67,Default CN,,0,0,0,,Мен сонда болғаннан кейін, т.б.
Dialogue: 0,1:04:19.67,1:04:22.46,Default CN,,0,0,0,,Алайда бұл екінші аспан және үшінші аспан.
Dialogue: 0,1:04:22.46,1:04:24.42,Default CN,,0,0,0,,Масамунаның өлімі
Dialogue: 0,1:04:25.13,1:04:28.43,Default CN,,0,0,0,,Біз немесе басқалар қайта кездеспейтін кезде.
Dialogue: 0,1:04:28.43,1:04:30.26,Default CN,,0,0,0,,Басқа көріністер
Dialogue: 0,1:04:30.97,1:04:32.77,Default CN,,0,0,0,,Тек бір түрі мүмкін.
Dialogue: 0,1:04:33.06,1:04:36.48,Default CN,,0,0,0,,Негізі мен параллель әлем адамымын.
Dialogue: 0,1:04:38.85,1:04:43.69,Default CN,,0,0,0,,Параллель әлем
Dialogue: 0,1:04:43.69,1:04:45.32,Default CN,,0,0,0,,Ойын әрқашан пайда болады
Dialogue: 0,1:04:46.11,1:04:48.53,Default CN,,0,0,0,,...
Dialogue: 0,1:04:48.53,1:04:53.20,Default CN,,0,0,0,,Мен әртүрлі қар сыныптарының оқушысымын.
Dialogue: 0,1:04:53.83,1:04:57.41,Default CN,,0,0,0,,Бұл аймақта жеті адам бар, ал әлемде жеті түрлі адам бар.
Dialogue: 0,1:04:58.62,1:04:59.63,Default CN,,0,0,0,,18-ші эпизод: Венецияға!
Dialogue: 0,1:05:01.96,1:05:03.30,Default CN,,0,0,0,,Танымал және түсінікті әдістерді қолдану
Dialogue: 0,1:05:04.05,1:05:07.72,Default CN,,0,0,0,,Дүниенің түпнұсқа мәтіні – ұлы ағаш
Dialogue: 0,1:05:08.63,1:05:12.72,Default CN,,0,0,0,,Бірақ біздің әлем біздікінен бөлек.
Dialogue: 0,1:05:17.48,1:05:20.40,Default CN,,0,0,0,,Дереккөздің шығу тегі бір, сондықтан ұқсас.
Dialogue: 0,1:05:20.85,1:05:22.86,Default CN,,0,0,0,,Дегенмен, кейбір айырмашылықтар бар.
Dialogue: 0,1:05:22.86,1:05:25.69,Default CN,,0,0,0,,Мен дүниенің ортасындамын
Dialogue: 0,1:05:26.07,1:05:29.36,Default CN,,0,0,0,,Кристалл орналасқан әлемнен жапон әні
Dialogue: 0,1:05:30.32,1:05:32.66,Default CN,,0,0,0,,Сондықтан мен сіздің талантыңызды көре алмаймын.
Dialogue: 0,1:05:33.08,1:05:34.08,Default CN,,0,0,0,,Көптеген айырмашылықтар
Dialogue: 0,1:05:34.66,1:05:36.25,Default CN,,0,0,0,,«GW» параметрі де төмендегідей
Dialogue: 0,1:05:36.70,1:05:37.54,Default CN,,0,0,0,,«GW»?
Dialogue: 0,1:05:37.54,1:05:39.54,Default CN,,0,0,0,,...
Dialogue: 0,1:05:39.54,1:05:40.87,Default CN,,0,0,0,,«ӘЛЕМ қақпасы»
Dialogue: 0,1:05:41.63,1:05:45.05,Default CN,,0,0,0,,Бұл ұзақ уақыт жасаушының қазіргі уақытта өте жарылғыш жұмысы.
Dialogue: 0,1:05:45.05,1:05:49.01,Default CN,,0,0,0,,Менің досымның және басқа да арнайы кеңесшінің шолуы
Dialogue: 0,1:05:49.47,1:05:50.26,Default CN,,0,0,0,,Ұзын?
Dialogue: 0,1:05:50.63,1:05:52.97,Default CN,,0,0,0,,Өмір сүру ұзақтығы алты жыл
Dialogue: 0,1:05:52.97,1:05:55.47,Default CN,,0,0,0,,«UNIZON» ойын компаниясы данышпан ойын жасаушы
Dialogue: 0,1:05:58.85,1:06:00.64,Default CN,,0,0,0,,Коуя Ширанаду
Dialogue: 0,1:06:00.64,1:06:02.73,Default CN,,0,0,0,,Тұрақты білімнің бір нүктесі жоғалады
Dialogue: 0,1:06:02.73,1:06:04.69,Default CN,,0,0,0,,Гачиду «GW»
Dialogue: 0,1:06:05.19,1:06:08.11,Default CN,,0,0,0,,Өте қызық ойын ойнау үшін өзгертілген бейне
Dialogue: 0,1:06:08.11,1:06:09.28,Default CN,,0,0,0,,Дарындылық пен модификацияны жоғалту
Dialogue: 0,1:06:09.28,1:06:10.82,Default CN,,0,0,0,,…
Dialogue: 0,1:06:10.82,1:06:13.16,Default CN,,0,0,0,,...
Dialogue: 0,1:06:13.66,1:06:15.58,Default CN,,0,0,0,,Шындық мәңгі қалады
Dialogue: 0,1:06:15.58,1:06:16.20,Default CN,,0,0,0,,...
Dialogue: 0,1:06:16.20,1:06:17.20,Default CN,,0,0,0,,Сіз осындасыз
Dialogue: 0,1:06:17.70,1:06:19.46,Default CN,,0,0,0,,Бұл рас.
Dialogue: 0,1:06:21.04,1:06:23.21,Default CN,,0,0,0,,Жақсы ұпай жауап
Dialogue: 0,1:06:25.79,1:06:26.71,Default CN,,0,0,0,,Толығымен жалған растау
Dialogue: 0,1:06:28.42,1:06:32.59,Default CN,,0,0,0,,Бос уақытыңыз үшін ойынды қалай орнатуға болады
Dialogue: 0,1:06:33.68,1:06:35.39,Default CN,,0,0,0,,Алдын ала ойлар
Dialogue: 0,1:06:35.39,1:06:39.52,Default CN,,0,0,0,,Дегенмен, біздің шынайы әлеміміз жеткілікті түрде ұқсас, бірақ сонымен бірге әртүрлі.
Dialogue: 0,1:06:39.52,1:06:41.89,Default CN,,0,0,0,,Нақты көрінісі
Dialogue: 0,1:06:41.89,1:06:44.27,Default CN,,0,0,0,,Параллель дүниеден шығару.
Dialogue: 0,1:06:44.77,1:06:47.48,Default CN,,0,0,0,,Сізбен кім сөйлеседі?
Dialogue: 0,1:06:49.11,1:06:49.82,Default CN,,0,0,0,,Көрмейтін бет
Dialogue: 0,1:06:50.28,1:06:52.57,Default CN,,0,0,0,,Мен сонда болғанымда сонда болдым.
Dialogue: 0,1:06:52.57,1:06:54.16,Default CN,,0,0,0,,Көп белсенділік
Dialogue: 0,1:06:54.16,1:06:56.74,Default CN,,0,0,0,,Мен осындамын және жұмысқа кірістім деген презентация.
Dialogue: 0,1:06:57.70,1:07:01.08,Default CN,,0,0,0,,...
Dialogue: 0,1:07:01.91,1:07:03.33,Default CN,,0,0,0,,Қасық
Dialogue: 0,1:07:04.04,1:07:07.00,Default CN,,0,0,0,,Менің бөлмемдегі еденнің астында
Dialogue: 0,1:07:07.00,1:07:09.96,Default CN,,0,0,0,,Бір шанышқы саны бар, біреуі бар, оның ішінде біреуі бар
Dialogue: 0,1:07:11.42,1:07:14.05,Default CN,,0,0,0,,Менің бөлмемде де қорап бар.
Dialogue: 0,1:07:14.05,1:07:15.80,Default CN,,0,0,0,,Өйткені менде бір ғана жазба бар
Dialogue: 0,1:07:17.35,1:07:19.10,Default CN,,0,0,0,,Юкаденрименде де бар
Dialogue: 0,1:07:19.10,1:07:22.35,Default CN,,0,0,0,,...
Dialogue: 0,1:07:22.35,1:07:23.27,Default CN,,0,0,0,,Бір көзге қараңыз
Dialogue: 0,1:07:24.52,1:07:25.94,Default CN,,0,0,0,,Сатоя ас үй камині
Dialogue: 0,1:07:27.36,1:07:29.53,Default CN,,0,0,0,,Асхана мейрамханасы
Dialogue: 0,1:07:30.86,1:07:32.74,Default CN,,0,0,0,,...
Dialogue: 0,1:07:32.74,1:07:35.45,Default CN,,0,0,0,,Бөлмеңіз болса, Рияны пайдаланыңыз
Dialogue: 0,1:07:38.20,1:07:39.49,Default CN,,0,0,0,,Алты бөлік
Dialogue: 0,1:07:40.54,1:07:42.41,Default CN,,0,0,0,,Анықталмаған аударма және басқа жергілікті орындар
Dialogue: 0,1:07:43.33,1:07:44.33,Default CN,,0,0,0,,Бұл презентация
Dialogue: 0,1:07:45.58,1:07:46.54,Default CN,,0,0,0,,Ойлау
Dialogue: 0,1:07:47.17,1:07:51.30,Default CN,,0,0,0,,Сіздің миссияңыз қандай?
Dialogue: 0,1:07:52.01,1:07:55.51,Default CN,,0,0,0,,Қасықтың соңына әдейі немесе байқаусызда жету керек.
Dialogue: 0,1:07:59.30,1:08:00.85,Default CN,,0,0,0,,Бұл қасық.
Dialogue: 0,1:08:03.73,1:08:05.31,Default CN,,0,0,0,,Нақты тілек
Dialogue: 0,1:08:07.27,1:08:08.98,Default CN,,0,0,0,,Астана – сенің еркіндігің
Dialogue: 0,1:08:52.44,1:08:55.28,Default CN,,0,0,0,,Бір қасық
Dialogue: 0,1:08:55.90,1:08:57.78,Default CN,,0,0,0,,Белгілі бір уақыттан кейін
Dialogue: 0,1:09:00.49,1:09:03.29,Default CN,,0,0,0,,Ойынды ойнауға кететін уақыт аз ғана уақыт.
Dialogue: 0,1:09:03.83,1:09:06.54,Default CN,,0,0,0,,Үкімет не болады?
Dialogue: 0,1:09:06.54,1:09:09.17,Default CN,,0,0,0,,Пойызда саяхаттауға деген қызығушылық
Dialogue: 0,1:09:09.79,1:09:12.92,Default CN,,0,0,0,,Мен бастапқы жерден келдім.
Dialogue: 0,1:09:12.92,1:09:17.84,Default CN,,0,0,0,,Казуиро орындауы Какуто Цухигайосакицукан
Dialogue: 0,1:09:18.93,1:09:20.30,Default CN,,0,0,0,,...
Dialogue: 0,1:09:20.84,1:09:24.01,Default CN,,0,0,0,,Мен электр қуатын аламын деген ниетім бар.
Dialogue: 0,1:09:24.01,1:09:27.98,Default CN,,0,0,0,,Анықталған квадрат жақсы және жақсы оқиды бір қадам
Dialogue: 0,1:09:30.60,1:09:32.65,Default CN,,0,0,0,,Мен соңғы бір айда қабылдау емтиханына қатыстым.
Dialogue: 0,1:09:32.65,1:09:35.28,Default CN,,0,0,0,,Қарастыру кезеңі: Өндірістік орта мектеп/толық орта мектеп
Dialogue: 0,1:09:35.28,1:09:36.32,Default CN,,0,0,0,,...
Dialogue: 0,1:09:36.90,1:09:38.57,Default CN,,0,0,0,,Түпнұсқалардың бар-жоғын тексеру
Dialogue: 0,1:09:39.99,1:09:41.11,Default CN,,0,0,0,,Бұл энергияны тауысады.
Dialogue: 0,1:09:41.62,1:09:43.33,Default CN,,0,0,0,,Гато Шичидо
Dialogue: 0,1:09:43.66,1:09:45.49,Default CN,,0,0,0,,...
Dialogue: 0,1:09:46.45,1:09:47.54,Default CN,,0,0,0,,Бұл баратын жер
Dialogue: 0,1:09:48.29,1:09:51.50,Default CN,,0,0,0,,Арнайы жеке мектеп
Dialogue: 0,1:09:51.50,1:09:55.05,Default CN,,0,0,0,,Сабаққа қатысып, өткенді зерттедім.
Dialogue: 0,1:09:55.05,1:09:56.38,Default CN,,0,0,0,,Аняның үйіне қош келдіңіз
Dialogue: 0,1:09:56.38,1:09:58.92,Default CN,,0,0,0,,Бұл да мүмкін.
Dialogue: 0,1:09:58.92,1:10:01.30,Default CN,,0,0,0,,...
Dialogue: 0,1:10:01.30,1:10:02.68,Default CN,,0,0,0,,Алайда өткеннен кейін
Dialogue: 0,1:10:02.68,1:10:05.35,Default CN,,0,0,0,,Шетелде оқуымды жоспарлау
Dialogue: 0,1:10:05.35,1:10:07.60,Default CN,,0,0,0,,Шетелде? шынайы зиян
Dialogue: 0,1:10:08.64,1:10:11.31,Default CN,,0,0,0,,Мен мүлікті иеленуден айырылдым.
Dialogue: 0,1:10:11.31,1:10:15.19,Default CN,,0,0,0,,...
Dialogue: 0,1:10:17.78,1:10:20.49,Default CN,,0,0,0,,Жақында шағын жел әні
Dialogue: 0,1:10:21.20,1:10:24.24,Default CN,,0,0,0,,...
Dialogue: 0,1:10:24.95,1:10:28.00,Default CN,,0,0,0,,Кездесуге баратын жолды жаяу жүру
Dialogue: 0,1:10:28.33,1:10:30.29,Default CN,,0,0,0,,...
Dialogue: 0,1:10:31.08,1:10:32.87,Default CN,,0,0,0,,Менің жазбаларым
Dialogue: 0,1:10:34.96,1:10:37.88,Default CN,,0,0,0,,Жеке адами капитал үш жыл тағы бір рет қайталаймын
Dialogue: 0,1:10:38.59,1:10:41.43,Default CN,,0,0,0,,Мен де мүлде білімсізмін.
Dialogue: 0,1:10:53.40,1:10:54.98,Default CN,,0,0,0,,Мен осында келіп күттім.
Dialogue: 0,1:10:55.98,1:10:57.07,Default CN,,0,0,0,,Қирау
Dialogue: 0,1:10:57.07,1:11:00.90,Default CN,,0,0,0,,Психикалық ойлар қажет
Dialogue: 0,1:11:00.90,1:11:03.20,Default CN,,0,0,0,,...
Dialogue: 0,1:11:06.74,1:11:10.16,Default CN,,0,0,0,,Ойланып қарасам, мен де сол аумаққа түсемін.
Dialogue: 0,1:11:10.70,1:11:11.75,Default CN,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,1:11:14.21,1:11:16.21,Default CN,,0,0,0,,Жағдайға байланысты қазіргі жағдайлар
Dialogue: 0,1:11:16.21,1:11:20.26,Default CN,,0,0,0,,Мен сені тағы көрдім.
Dialogue: 0,1:11:20.26,1:11:21.76,Default CN,,0,0,0,,Бұл баратын жер
Dialogue: 0,1:11:23.34,1:11:27.60,Default CN,,0,0,0,,Анықталған негізгі пікір, үздік жоспар
Dialogue: 0,1:11:29.97,1:11:34.65,Default CN,,0,0,0,,...
Dialogue: 0,1:11:34.65,1:11:36.31,Default CN,,0,0,0,,Бұл бесінші орта мектеп оқулығының оқиғасы
Dialogue: 0,1:11:36.31,1:11:38.98,Default CN,,0,0,0,,...
Dialogue: 0,1:11:39.69,1:11:40.73,Default CN,,0,0,0,,Шынайы оқиға
Dialogue: 0,1:11:42.32,1:11:44.40,Default CN,,0,0,0,,Мен де мектеп оқушысымын.
Dialogue: 0,1:11:44.40,1:11:46.91,Default CN,,0,0,0,,Бұл ең қолайлы жағдай.
Dialogue: 0,1:11:47.20,1:11:49.66,Default CN,,0,0,0,,Санаданың досы
Dialogue: 0,1:11:50.83,1:11:55.46,Default CN,,0,0,0,,Маэда тауынан өтуге қош келдіңіз.
Dialogue: 0,1:11:56.12,1:11:58.34,Default CN,,0,0,0,,...
Dialogue: 0,1:11:59.50,1:12:02.80,Default CN,,0,0,0,,...
Dialogue: 0,1:12:03.67,1:12:04.47,Default CN,,0,0,0,,Э-э...
Dialogue: 0,1:12:05.43,1:12:06.59,Default CN,,0,0,0,,Тоджо Менгаку
Dialogue: 0,1:12:07.14,1:12:09.43,Default CN,,0,0,0,,Тоджо Догаку немесе Талаптар
Dialogue: 0,1:12:11.72,1:12:14.14,Default CN,,0,0,0,,Менің әкем университетте профессор болған.
Dialogue: 0,1:12:14.14,1:12:17.15,Default CN,,0,0,0,,2019 жылдың сәуірі Нагоя университетіне келу
Dialogue: 0,1:12:20.15,1:12:23.07,Default CN,,0,0,0,,Сондай-ақ аралық мектеп ауданындағы орта мектепке баруға болады.
Dialogue: 0,1:12:25.07,1:12:27.20,Default CN,,0,0,0,,Алайда бұл сіздің ниетіңіз емес.
Dialogue: 0,1:12:27.20,1:12:29.49,Default CN,,0,0,0,,Сондай-ақ өзін толық емес орта мектептен кетуге мәжбүрлеу керек.
Dialogue: 0,1:12:31.74,1:12:36.83,Default CN,,0,0,0,,Егер сіз орта мектеп оқушысы болсаңыз да, болмасаңыз, онда белгілі бір маңызды жайттар бар.
Dialogue: 0,1:12:36.83,1:12:38.88,Default CN,,0,0,0,,Юкадан бері, «Жүрек жаттықтыру кабинеті»
Dialogue: 0,1:12:38.88,1:12:40.63,Default CN,,0,0,0,,Қосымша опциялар қолжетімді
Dialogue: 0,1:12:45.01,1:12:46.68,Default CN,,0,0,0,,Сіз адам емессіз
Dialogue: 0,1:12:47.26,1:12:49.55,Default CN,,0,0,0,,Мен бір идеяны ойлап, оны тастап кеттім.
Dialogue: 0,1:13:03.82,1:13:05.19,Default CN,,0,0,0,,Сәттілік
Dialogue: 0,1:13:05.19,1:13:06.15,Default CN,,0,0,0,,Міндетті сатып алу
Dialogue: 0,1:13:07.74,1:13:10.41,Default CN,,0,0,0,,Ыңғайлы дүкен, т.б.
Dialogue: 0,1:13:10.41,1:13:11.83,Default CN,,0,0,0,,Менің ойларым және шағын дим сом
Dialogue: 0,1:13:11.83,1:13:12.91,Default CN,,0,0,0,,Жақсы дәм
Dialogue: 0,1:13:15.50,1:13:17.66,Default CN,,0,0,0,,Аспанның соңғы күні - аспанның соңғы күні.
Dialogue: 0,1:13:17.66,1:13:20.25,Default CN,,0,0,0,,Есепке дайындық та аяқталды.
Dialogue: 0,1:13:22.84,1:13:23.96,Default CN,,0,0,0,,Кейбір шарттар қолданылады.
Dialogue: 0,1:13:24.96,1:13:28.63,Default CN,,0,0,0,,Мектепте қайтыс болған бала
Dialogue: 0,1:13:28.63,1:13:32.35,Default CN,,0,0,0,,Қаладағы үлкендермен бір мезгілде
Dialogue: 0,1:13:33.01,1:13:36.18,Default CN,,0,0,0,,Оқиғадан кейін жоғалып кеткен.
Dialogue: 0,1:13:36.18,1:13:40.27,Default CN,,0,0,0,,Ұлы астананың жүзеге асуын тілеуден және оның жоғалғанын еске алудан.
Dialogue: 0,1:13:40.77,1:13:43.77,Default CN,,0,0,0,,Қалау немесе қаламау мүмкіндігіне күмән жоқ.
Dialogue: 0,1:13:44.40,1:13:46.86,Default CN,,0,0,0,,Айнаның қамал қамалы белгілі екені рас.
Dialogue: 0,1:13:46.86,1:13:48.90,Default CN,,0,0,0,,Шынайы мән
Dialogue: 0,1:13:51.66,1:13:53.28,Default CN,,0,0,0,,Жүрек алға жылжи аламын
Dialogue: 0,1:13:54.74,1:13:55.95,Default CN,,0,0,0,,...
Dialogue: 0,1:13:56.45,1:13:59.79,Default CN,,0,0,0,,Содан бері
Dialogue: 0,1:13:59.79,1:14:02.13,Default CN,,0,0,0,,Мен компаниядан шыққан кезде мен компаниядан шықтым.
Dialogue: 0,1:14:03.29,1:14:04.25,Default CN,,0,0,0,,...
Dialogue: 0,1:14:04.88,1:14:05.88,Default CN,,0,0,0,,Мен өзімді ұрдым
Dialogue: 0,1:14:52.68,1:14:54.72,Default CN,,0,0,0,,Үйде отырудың қажеті жоқ
Dialogue: 0,1:14:57.68,1:14:59.18,Default CN,,0,0,0,,Сатып алу және сатып алу
Dialogue: 0,1:15:03.06,1:15:04.23,Default CN,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,1:15:07.40,1:15:08.78,Default CN,,0,0,0,,Нагоя
Dialogue: 0,1:15:18.74,1:15:19.79,Default CN,,0,0,0,,Э-э...
Dialogue: 0,1:15:19.79,1:15:22.16,Default CN,,0,0,0,,...
Dialogue: 0,1:15:23.21,1:15:26.00,Default CN,,0,0,0,,Ғылыми жағдайлар дұрыс.
Dialogue: 0,1:15:27.84,1:15:28.80,Default CN,,0,0,0,,Кешір мені.
Dialogue: 0,1:15:31.59,1:15:32.55,Default CN,,0,0,0,,Джиорно, жараландың ба?
Dialogue: 0,1:15:36.18,1:15:39.18,Default CN,,0,0,0,,Үшінші семестрдің басында
Dialogue: 0,1:15:39.18,1:15:41.98,Default CN,,0,0,0,,Мен оны елестете алмаймын, бірақ мен оны аша алмаймын.
Dialogue: 0,1:15:41.98,1:15:44.31,Default CN,,0,0,0,,Жағдай аздап өзгеруі мүмкін
Dialogue: 0,1:15:44.98,1:15:46.06,Default CN,,0,0,0,,Жіңішке?
Dialogue: 0,1:15:46.06,1:15:49.23,Default CN,,0,0,0,,Мен Санада Юиден шығарылдым.
Dialogue: 0,1:15:49.23,1:15:52.44,Default CN,,0,0,0,,...
Dialogue: 0,1:15:52.44,1:15:54.49,Default CN,,0,0,0,,Анықталмаған тіл
Dialogue: 0,1:15:55.57,1:15:56.36,Default CN,,0,0,0,,Жылдамдық
Dialogue: 0,1:15:56.78,1:15:58.45,Default CN,,0,0,0,,Шираничи
Dialogue: 0,1:15:58.45,1:16:01.33,Default CN,,0,0,0,,Жауабы: түсінбеймін.
Dialogue: 0,1:16:01.33,1:16:02.87,Default CN,,0,0,0,,Маған қара
Dialogue: 0,1:16:06.29,1:16:10.59,Default CN,,0,0,0,,Мені Накаяманың еркек досы қызықтырады.
Dialogue: 0,1:16:10.59,1:16:12.05,Default CN,,0,0,0,,Түлкі мен енот рухы
Dialogue: 0,1:16:12.76,1:16:13.88,Default CN,,0,0,0,,Мен не істерімді білмеймін.
Dialogue: 0,1:16:14.84,1:16:16.72,Default CN,,0,0,0,,Мен дұрыс емес екеніме сенімдімін.
Dialogue: 0,1:16:17.30,1:16:21.97,Default CN,,0,0,0,,Махаббат деп айқайлаған кім?
Dialogue: 0,1:16:23.60,1:16:26.44,Default CN,,0,0,0,,...
Dialogue: 0,1:16:26.44,1:16:28.98,Default CN,,0,0,0,,10 немесе 20 жылдан кейін аффирмация жалғасады.
Dialogue: 0,1:16:28.98,1:16:30.44,Default CN,,0,0,0,,Қалыпты өмірдің расталмайтын дәрежесі
Dialogue: 0,1:16:32.11,1:16:33.19,Default CN,,0,0,0,,және интернатта тұратын оқушылар мен күндізгі бөлімде оқитындар арасында шиеленіс бар.
Dialogue: 0,1:16:35.03,1:16:38.99,Default CN,,0,0,0,,Бірінші жеткізу тәртібі
Dialogue: 0,1:16:38.99,1:16:40.12,Default CN,,0,0,0,,Иллюзия жойылды ма?
Dialogue: 0,1:16:40.12,1:16:41.28,Default CN,,0,0,0,,Толығымен тәркіленген
Dialogue: 0,1:16:41.28,1:16:42.29,Default CN,,0,0,0,,Аняның үйіне қош келдіңіз
Dialogue: 0,1:16:43.16,1:16:44.08,Default CN,,0,0,0,,Себеп
Dialogue: 0,1:16:44.08,1:16:46.96,Default CN,,0,0,0,,Басқалары қазіргі уақытта ең тиімді болып табылады.
Dialogue: 0,1:16:47.54,1:16:51.04,Default CN,,0,0,0,,Егер сіз университетке келгіңіз келсе, растау кездесуіне қосылыңыз.
Dialogue: 0,1:16:51.04,1:16:52.96,Default CN,,0,0,0,,Мен оқшауланғанмын
Dialogue: 0,1:16:53.92,1:16:55.01,Default CN,,0,0,0,,...
Dialogue: 0,1:16:55.97,1:16:57.18,Default CN,,0,0,0,,...
Dialogue: 0,1:16:58.59,1:16:59.93,Default CN,,0,0,0,,Бұл жолмен жүру керек
Dialogue: 0,1:17:00.72,1:17:02.18,Default CN,,0,0,0,,Бұл тұрарлық емес.
Dialogue: 0,1:17:02.18,1:17:03.77,Default CN,,0,0,0,,Бұл мектеп мәселесі.
Dialogue: 0,1:17:04.81,1:17:06.31,Default CN,,0,0,0,,Мектепте ақау бар ма?
Dialogue: 0,1:17:11.61,1:17:13.78,Default CN,,0,0,0,,10 миллион қажетсіз өкініш, ұялшақтық
Dialogue: 0,1:17:14.86,1:17:17.28,Default CN,,0,0,0,,Нанажин Гури Тою
Dialogue: 0,1:17:17.28,1:17:19.45,Default CN,,0,0,0,,Анықталмаған жаңа мектеп Сатоя
Dialogue: 0,1:17:20.07,1:17:23.49,Default CN,,0,0,0,,Дегенмен, бұл келесі қадам.
Dialogue: 0,1:17:24.24,1:17:25.37,Default CN,,0,0,0,,Сізден талап етілетін жерде
Dialogue: 0,1:17:27.25,1:17:29.17,Default CN,,0,0,0,,Адамның алдауын төменде қараңыз
Dialogue: 0,1:17:29.17,1:17:31.00,Default CN,,0,0,0,,Ичикай Рёкенсуке және т.б
Dialogue: 0,1:17:39.76,1:17:42.01,Default CN,,0,0,0,,Бұл қосалқы қасқырдың бейнелік принципі
Dialogue: 0,1:17:42.01,1:17:43.81,Default CN,,0,0,0,,Бұл «Қасқыр мен жеті қозы»
Dialogue: 0,1:17:44.47,1:17:45.68,Default CN,,0,0,0,,Жеті?
Dialogue: 0,1:17:46.89,1:17:49.56,Default CN,,0,0,0,,Жағымсыз ниет
Dialogue: 0,1:17:49.56,1:17:50.90,Default CN,,0,0,0,,Өлім сериясы
Dialogue: 0,1:17:50.90,1:17:52.44,Default CN,,0,0,0,,Императрица Тенсайкай Транспортер
Dialogue: 0,1:17:52.81,1:17:54.65,Default CN,,0,0,0,,...
Dialogue: 0,1:18:12.75,1:18:13.50,Default CN,,0,0,0,,Жылдамдық
Dialogue: 0,1:18:14.04,1:18:15.75,Default CN,,0,0,0,,...
Dialogue: 0,1:18:18.05,1:18:19.84,Default CN,,0,0,0,,Қасқыр Ересек Кайто Кога
Dialogue: 0,1:18:20.47,1:18:22.05,Default CN,,0,0,0,,Сатып алуға қатысу
Dialogue: 0,1:18:23.26,1:18:24.26,Default CN,,0,0,0,,Кайто Кога
Dialogue: 0,1:18:27.93,1:18:28.81,Default CN,,0,0,0,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,1:18:32.60,1:18:33.65,Default CN,,0,0,0,,Рион
Dialogue: 0,1:18:35.69,1:18:36.69,Default CN,,0,0,0,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,1:18:38.53,1:18:39.90,Default CN,,0,0,0,,Қорқақтық
Dialogue: 0,1:18:41.11,1:18:42.16,Default CN,,0,0,0,,Қорқақтық
Dialogue: 0,1:18:42.99,1:18:43.95,Default CN,,0,0,0,,Қорқақтық
Dialogue: 0,1:18:44.41,1:18:45.95,Default CN,,0,0,0,,Қош келдіңіз
Dialogue: 0,1:18:45.95,1:18:47.08,Default CN,,0,0,0,,...
Dialogue: 0,1:18:47.49,1:18:49.79,Default CN,,0,0,0,,Кристалды тазарту
Dialogue: 0,1:18:51.54,1:18:54.67,Default CN,,0,0,0,,Бірден бес ұпай берді.
Dialogue: 0,1:18:55.54,1:18:57.38,Default CN,,0,0,0,,...
Dialogue: 0,1:18:58.71,1:19:00.63,Default CN,,0,0,0,,Мен де аттың орнын алуым керек.
Dialogue: 0,1:19:02.34,1:19:03.80,Default CN,,0,0,0,,Басқару жауапкершілігі
Dialogue: 0,1:19:04.84,1:19:07.68,Default CN,,0,0,0,,Менің баратын жерім қайтарылды.
Dialogue: 0,1:19:08.26,1:19:10.89,Default CN,,0,0,0,,Дегенмен, айна қайтадан күшейді.
Dialogue: 0,1:19:12.64,1:19:14.19,Default CN,,0,0,0,,...
Dialogue: 0,1:19:20.19,1:19:21.32,Default CN,,0,0,0,,Жалға беруші Жалға беруші
Dialogue: 0,1:19:21.82,1:19:23.70,Default CN,,0,0,0,,...
Dialogue: 0,1:19:23.70,1:19:25.45,Default CN,,0,0,0,,«Тілек қасық» құтқару кристалын бекітіңіз…
Dialogue: 0,1:19:25.99,1:19:28.79,Default CN,,0,0,0,,Рион Мен суреттің кеңдігін көрдім...
Dialogue: 0,1:19:29.24,1:19:30.45,Default CN,,0,0,0,,Қасықтардың көпшілігі бар...
Dialogue: 0,1:19:36.75,1:19:38.42,Default CN,,0,0,0,,...
Dialogue: 0,1:19:38.96,1:19:41.17,Default CN,,0,0,0,,Қосымша мәліметтер
Dialogue: 0,1:19:43.68,1:19:45.64,Default CN,,0,0,0,,Дегенмен, бұл өлі серия.
Dialogue: 0,1:19:48.35,1:19:50.68,Default CN,,0,0,0,,Гаай Ба Сяоцзин, Ба Дай Каду құтқарылды
Dialogue: 0,1:19:52.10,1:19:53.02,Default CN,,0,0,0,,Мен жиналыстан шығып, сені құтқардым.
Dialogue: 0,1:20:59.04,1:21:01.46,Default CN,,0,0,0,,Бірінші Тоқтының төменгі жағы
Dialogue: 0,1:21:10.51,1:21:11.30,Default CN,,0,0,0,,Жел әні
Dialogue: 0,1:21:17.64,1:21:19.31,Default CN,,0,0,0,,Екінші төменгі бет
Dialogue: 0,1:21:21.06,1:21:23.02,Default CN,,0,0,0,,Үшінші позиция
Dialogue: 0,1:21:24.78,1:21:26.90,Default CN,,0,0,0,,Ас үйдегі төртінші камин
Dialogue: 0,1:21:28.78,1:21:30.87,Default CN,,0,0,0,,Хакурюдегі 5-ші мейрамхана
Dialogue: 0,1:21:32.66,1:21:34.79,Default CN,,0,0,0,,Алтыншы ваннадағы бассейннің төменгі беті
Dialogue: 0,1:21:48.34,1:21:49.80,Default CN,,0,0,0,,Ересек қасқыр
Dialogue: 0,1:21:49.80,1:21:50.68,Default CN,,0,0,0,,Сіз сондасыз.
Dialogue: 0,1:21:57.02,1:21:59.60,Default CN,,0,0,0,,Жетінші қозы елі
Dialogue: 0,1:21:59.60,1:22:00.94,Default CN,,0,0,0,,Бұл ешқашан жетпеген аймақ.
Dialogue: 0,1:22:01.44,1:22:02.77,Default CN,,0,0,0,,Қолжетімсіз аймақ
Dialogue: 0,1:22:03.77,1:22:06.23,Default CN,,0,0,0,,Тоқты туғанда тағы алты рет.
Dialogue: 0,1:22:06.82,1:22:08.70,Default CN,,0,0,0,,Бір қозы ғана секірген соңғы аймақ
