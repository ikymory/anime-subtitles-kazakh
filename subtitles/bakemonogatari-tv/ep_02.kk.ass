Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.15,0:00:17.48,Default,,0,0,0,,Сенджогахарадағы үй - сарай.
Dialogue: 0,0:00:17.57,0:00:18.77,Default,,0,0,0,,Ханекава осылай деді
Dialogue: 0,0:00:22.45,0:00:25.53,Default,,0,0,0,,Анам күдікті дінге кірді.
Dialogue: 0,0:00:26.20,0:00:28.74,Default,,0,0,0,,Бар байлығыңызды садақа беру жеткіліксіз.
Dialogue: 0,0:00:28.87,0:00:31.20,Default,,0,0,0,,Мен үлкен көлемдегі қарызды көтердім.
Dialogue: 0,0:00:32.79,0:00:36.13,Default,,0,0,0,,Ақырында, өткен жылдың соңында өзара келісілген ажырасуға қол жеткізілді.
Dialogue: 0,0:00:36.54,0:00:39.05,Default,,0,0,0,,Мені әкем қабылдады.
Dialogue: 0,0:00:39.21,0:00:40.96,Default,,0,0,0,,Біз екеуміз осында тұрамыз.
Dialogue: 0,0:00:48.30,0:00:54.31,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:10.22,0:02:16.23,Default,,0,0,0,,~♪
Dialogue: 0,0:02:37.12,0:02:38.71,Default,,0,0,0,,Маған көмектесесіз бе?
Dialogue: 0,0:02:41.13,0:02:43.50,Default,,0,0,0,,Мен саған көмектеспеймін, бірақ күшімді беремін.
Dialogue: 0,0:02:45.50,0:02:48.22,Default,,0,0,0,,Дұрыс, қазір үйге қайт.
Dialogue: 0,0:02:48.47,0:02:50.34,Default,,0,0,0,,Сондықтан денеңізді салқын сумен тазалаңыз.
Dialogue: 0,0:02:50.43,0:02:52.72,Default,,0,0,0,,Сен таза киім киіп келе аласың ба?
Dialogue: 0,0:02:53.35,0:02:57.64,Default,,0,0,0,,Түн ортасы шамасында осында қайта кездессек болады ма?
Dialogue: 0,0:02:58.06,0:02:59.06,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:03:03.81,0:03:05.23,Default,,0,0,0,,Рахмет... (Ошино) Иә?
Dialogue: 0,0:03:06.78,0:03:07.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:08.15,0:03:09.70,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:03:09.95,0:03:12.74,Default,,0,0,0,,Олар өз еркімен көмектесетін сияқты емес, солай емес пе?
Dialogue: 0,0:03:13.74,0:03:15.12,Default,,0,0,0,,Хмм... мм?
Dialogue: 0,0:03:15.24,0:03:16.12,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:16.54,0:03:20.04,Default,,0,0,0,,Егер бұл жас ханымның өзін жайлырақ сезінсе.
Dialogue: 0,0:03:20.12,0:03:21.21,Default,,0,0,0,,Мен оны сақтауым керек пе?
Dialogue: 0,0:03:22.67,0:03:25.88,Default,,0,0,0,,Олай болса, 100 000 иен.
Dialogue: 0,0:03:26.63,0:03:27.50,Default,,0,0,0,,100 000 иен…
Dialogue: 0,0:03:28.01,0:03:30.34,Default,,0,0,0,,Жауап мен болған кездегіден мүлде басқаша.
Dialogue: 0,0:03:30.84,0:03:31.84,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:03:31.93,0:03:34.89,Default,,0,0,0,,Менің ойымша, бұл Төраға-чан үшін де 100 000 иен болды.
Dialogue: 0,0:03:35.93,0:03:38.02,Default,,0,0,0,,Мен болған кезде ол 5 миллион болды деді!
Dialogue: 0,0:03:38.56,0:03:40.85,Default,,0,0,0,,Мен вампирмін, менің таңдауым жоқ.
Dialogue: 0,0:03:40.94,0:03:43.52,Default,,0,0,0,,Барлығына оңай вампирлерді кінәламаңыз!
Dialogue: 0,0:03:44.19,0:03:45.02,Default,,0,0,0,,Төлей аласыз ба?
Dialogue: 0,0:03:46.19,0:03:47.02,Default,,0,0,0,,Әрине
Dialogue: 0,0:03:48.48,0:03:49.86,Default,,0,0,0,,Не болса да
Dialogue: 0,0:03:52.53,0:03:53.53,Default,,0,0,0,,Әрине
Dialogue: 0,0:03:58.87,0:04:01.79,Default,,0,0,0,,Хмм, 100 000 иен...
Dialogue: 0,0:04:04.04,0:04:05.88,Default,,0,0,0,,Мен душ қабылдауды аяқтадым.
Dialogue: 0,0:04:08.30,0:04:09.13,Default,,0,0,0,,Уау
Dialogue: 0,0:04:09.42,0:04:12.51,Default,,0,0,0,,Ол жерден кетіңіз. Мен киімдерімді шығара алмаймын.
Dialogue: 0,0:04:12.88,0:04:14.43,Default,,0,0,0,,Киініңіз! Киініңіз!
Dialogue: 0,0:04:14.93,0:04:16.93,Default,,0,0,0,,Сондықтан оны қазір киюді бастаңыз.
Dialogue: 0,0:04:17.18,0:04:19.81,Default,,0,0,0,,Мен саған оны киюді әу бастан айттым!
Dialogue: 0,0:04:20.18,0:04:22.23,Default,,0,0,0,,Мен оны әкелуді ұмытып кетіппін.
Dialogue: 0,0:04:22.31,0:04:24.48,Default,,0,0,0,,Содан кейін оны орамалмен жабыңыз!
Dialogue: 0,0:04:24.56,0:04:26.56,Default,,0,0,0,,Маған ұнамайды, мұндай нашар басқарушы.
Dialogue: 0,0:04:32.19,0:04:33.03,Default,,0,0,0,,
Dialogue: 0,0:04:35.20,0:04:37.78,Default,,0,0,0,,Мен алғаш рет әйелді толығымен жалаңаш көрдім.
Dialogue: 0,0:04:38.33,0:04:39.41,Default,,0,0,0,,Таза киім.
Dialogue: 0,0:04:40.24,0:04:42.00,Default,,0,0,0,,Ақ киім жақсырақ деп ойлайсың ба?
Dialogue: 0,0:04:42.08,0:04:42.91,Default,,0,0,0,,Мен білмеймін...
Dialogue: 0,0:04:45.75,0:04:46.83,Default,,0,0,0,,Шорт және көкірекше
Dialogue: 0,0:04:49.17,0:04:50.84,Default,,0,0,0,,Мен тек өрнекті бұйымдарды иеленемін.
Dialogue: 0,0:04:51.26,0:04:52.21,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:04:54.34,0:04:56.14,Default,,0,0,0,,Арараги-кун, болмайды, сен
Dialogue: 0,0:04:56.22,0:04:59.22,Default,,0,0,0,,Менің жалаңаш суреттерімді көргеннен кейін сіз мүйізденіп қалдыңыз деп ойламаймын.
Dialogue: 0,0:04:59.81,0:05:03.02,Default,,0,0,0,,Олай болса да, мен кінәлі емеспін!
Dialogue: 0,0:05:03.10,0:05:05.48,Default,,0,0,0,,Маған бұрылсаң да жетеді
Dialogue: 0,0:05:05.56,0:05:07.23,Default,,0,0,0,,Мен...
Dialogue: 0,0:05:07.35,0:05:08.19,Default,,0,0,0,,Иә
Dialogue: 0,0:05:11.32,0:05:13.19,Default,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:05:13.53,0:05:14.40,Default,,0,0,0,,Не?
Dialogue: 0,0:05:14.49,0:05:17.32,Default,,0,0,0,,Бүгінгі күн үшін алғыс білдіру үшін мен сізге үлкен қызмет жасап жатырмын.
Dialogue: 0,0:05:17.41,0:05:18.70,Default,,0,0,0,,Аздап қуаныңыз.
Dialogue: 0,0:05:19.12,0:05:19.95,Default,,0,0,0,,Уф
Dialogue: 0,0:05:20.70,0:05:22.29,Default,,0,0,0,,Тек бақытты бол!
Dialogue: 0,0:05:22.75,0:05:23.91,Default,,0,0,0,,Кері кесу!
Dialogue: 0,0:05:24.29,0:05:26.79,Default,,0,0,0,,Алған әсеріңізді білдіру сыпайылық болар еді.
Dialogue: 0,0:05:26.87,0:05:28.79,Default,,0,0,0,,Немесе... Сіздің ойыңыз қандай?
Dialogue: 0,0:05:31.13,0:05:34.01,Default,,0,0,0,,Мен... сенің денең әдемі, солай емес пе?
Dialogue: 0,0:05:35.84,0:05:36.93,Default,,0,0,0,,Ер адамның аты – Ллойд Форджер
Dialogue: 0,0:05:37.01,0:05:40.10,Default,,0,0,0,,Сол себепті мәңгілік пәксіз.
Dialogue: 0,0:05:40.18,0:05:43.31,Default,,0,0,0,,Өмір бойы? Сіз болашақтансыз ба?
Dialogue: 0,0:05:43.39,0:05:46.39,Default,,0,0,0,,Сіз түкіруді тоқтата аласыз ба? Қыздық жұқпалы
Dialogue: 0,0:05:47.06,0:05:49.02,Default,,0,0,0,,Қыздық әйелге берілуі мүмкін бе?
Dialogue: 0,0:05:50.40,0:05:52.15,Default,,0,0,0,,Дәлірек айтқанда, бір минут күтіңіз.
Dialogue: 0,0:05:52.36,0:05:55.15,Default,,0,0,0,,Әңгіме мен пәкпін деген болжаммен өрбиді.
Dialogue: 0,0:05:55.57,0:05:58.03,Default,,0,0,0,,Иә, мен алдын ала бірдеңені айттым.
Dialogue: 0,0:05:58.36,0:06:00.37,Default,,0,0,0,,Хаа... Түсінесіз деп үміттенемін.
Dialogue: 0,0:06:00.74,0:06:03.62,Default,,0,0,0,,Түкірме, әуесқой қыздық тарайды
Dialogue: 0,0:06:03.99,0:06:06.87,Default,,0,0,0,,Мойындайық, мен пәкпін!
Dialogue: 0,0:06:09.08,0:06:10.75,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:06:10.83,0:06:13.30,Default,,0,0,0,,Мен оны Ханекава мырзадан құпия түрде сақтаймын.
Dialogue: 0,0:06:13.80,0:06:14.80,Default,,0,0,0,,Ханекава дегеніміз не?
Dialogue: 0,0:06:15.34,0:06:18.43,Default,,0,0,0,,Ол Арараги-кунның сүйіктісі емес пе?
Dialogue: 0,0:06:18.51,0:06:19.68,Default,,0,0,0,,Сіз көп сөйлейсіз, солай емес пе?
Dialogue: 0,0:06:20.01,0:06:21.35,Default,,0,0,0,,Иә, бұл Каваджири.
Dialogue: 0,0:06:21.43,0:06:24.43,Default,,0,0,0,,Бұл жай ғана оған қамқорлық жасайтын Ханекава.
Dialogue: 0,0:06:24.52,0:06:26.93,Default,,0,0,0,,Ең пайдасыз адам - ​​ең аянышты.
Dialogue: 0,0:06:27.02,0:06:28.98,Default,,0,0,0,,Сіз әділетсіз шығынға ұшырадыңыз.
Dialogue: 0,0:06:29.06,0:06:30.94,Default,,0,0,0,,Бұл күлкілі түсінбеушілік.
Dialogue: 0,0:06:31.40,0:06:33.98,Default,,0,0,0,,Бұл шынымен күлкілі түсінбеушілік.
Dialogue: 0,0:06:34.11,0:06:36.69,Default,,0,0,0,,Ең жамандары - ең ақымақ.
Dialogue: 0,0:06:37.15,0:06:39.07,Default,,0,0,0,,Жоқ, мен онша көп айтқан жоқпын.
Dialogue: 0,0:06:39.32,0:06:40.32,Default,,0,0,0,,Бұл менің бетімде жазылған
Dialogue: 0,0:06:40.45,0:06:41.41,Default,,0,0,0,,Жазба.
Dialogue: 0,0:06:41.70,0:06:43.99,Default,,0,0,0,,Мен мұны айтасыз деп ойладым, сондықтан мен оны ертерек жаздым.
Dialogue: 0,0:06:44.33,0:06:45.99,Default,,0,0,0,,Мұндай қолды айналдыруға бола ма?
Dialogue: 0,0:06:49.96,0:06:51.88,Default,,0,0,0,,Ошино-сан саған қамқор болды, солай ма?
Dialogue: 0,0:06:53.09,0:06:54.46,Default,,0,0,0,,Ханекава да
Dialogue: 0,0:06:54.63,0:06:56.55,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:06:56.96,0:06:57.80,Default,,0,0,0,,Тек осы екі қарапайым белгіні есте сақта.
Dialogue: 0,0:06:57.88,0:07:00.47,Default,,0,0,0,,Сондықтан маған сенуге болады деп ойлаймын.
Dialogue: 0,0:07:00.55,0:07:03.51,Default,,0,0,0,,Бұл менің ғана емес, сонымен қатар Ханекаваның куәлігі.
Dialogue: 0,0:07:04.01,0:07:04.85,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:07:05.51,0:07:07.43,Default,,0,0,0,,Бірақ, Арараги-кун
Dialogue: 0,0:07:08.48,0:07:10.48,Default,,0,0,0,,Оған сонша сену
Dialogue: 0,0:07:11.15,0:07:15.73,Default,,0,0,0,,Мен қайта-қайта алданып қалдым.
Dialogue: 0,0:07:16.32,0:07:18.57,Default,,0,0,0,,Осылайша оптимистік жолмен
Dialogue: 0,0:07:18.65,0:07:20.74,Default,,0,0,0,,Не болса да, менің ойыма ештеңе келмейді.
Dialogue: 0,0:07:20.90,0:07:21.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:21.86,0:07:22.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:26.58,0:07:28.33,Default,,0,0,0,,Неліктен оны кигеннен кейін шешіп алдың?
Dialogue: 0,0:07:29.04,0:07:30.87,Default,,0,0,0,,Мен шашымды кептіруді ұмытып кетіппін.
Dialogue: 0,0:07:31.46,0:07:34.13,Default,,0,0,0,,Сіз жай ғана ақымақсыз ба?
Dialogue: 0,0:07:34.21,0:07:36.46,Default,,0,0,0,,Сіз дөрекі болмайсыз ба?
Dialogue: 0,0:07:36.55,0:07:38.51,Default,,0,0,0,,Егер мен жарақат алсам, жаман болмай ма?
Dialogue: 0,0:07:43.84,0:07:46.26,Default,,0,0,0,,Сіз оптимист екеніңізді жоғарыда айттыңыз.
Dialogue: 0,0:07:46.35,0:07:47.72,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:07:47.81,0:07:48.97,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:07:49.06,0:07:52.27,Default,,0,0,0,,Бірақ бұл дұрыс емес пе? Мен әсіресе оптимистік болсам да
Dialogue: 0,0:07:52.73,0:07:54.44,Default,,0,0,0,,Мен жаман ештеңе істеп жатқан жоқпын.
Dialogue: 0,0:07:54.52,0:07:55.98,Default,,0,0,0,,Мен алдап жүрген сияқты емеспін.
Dialogue: 0,0:07:56.82,0:07:59.74,Default,,0,0,0,,Мен жаман ештеңе істеп жатқан жоқпын...
Dialogue: 0,0:08:00.24,0:08:02.36,Default,,0,0,0,,Дұрыс? (Сенджугахара) Дұрыс.
Dialogue: 0,0:08:03.41,0:08:04.24,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:05.12,0:08:06.24,Default,,0,0,0,,Алдау болуы мүмкін
Dialogue: 0,0:08:06.62,0:08:07.99,Default,,0,0,0,,Не? (Сенджугахара) Бұл ештеңе емес.
Dialogue: 0,0:08:12.29,0:08:14.88,Default,,0,0,0,,Эй Арараги-кун, сенен бірдеңе сұрасам болады ма?
Dialogue: 0,0:08:15.58,0:08:18.09,Default,,0,0,0,,Бұл ай үлгісіне ұқсайды дегенді қалай түсінесіз?
Dialogue: 0,0:08:18.17,0:08:19.76,Default,,0,0,0,,Иә? Сен не туралы айтып тұрсың?
Dialogue: 0,0:08:19.84,0:08:22.13,Default,,0,0,0,,Ошино мырзаға осылай айтқан жоқсыз ба?
Dialogue: 0,0:08:22.51,0:08:24.76,Default,,0,0,0,,Қараңыз, ай үлгісі Жапониядан шыққан.
Dialogue: 0,0:08:25.34,0:08:27.26,Default,,0,0,0,,Қоян мочи жеп жатқан сияқты, бірақ
Dialogue: 0,0:08:27.89,0:08:29.64,Default,,0,0,0,,Егер сіз шетелден келген болсаңыз, бұл шаян болуы мүмкін.
Dialogue: 0,0:08:29.85,0:08:32.02,Default,,0,0,0,,Бұл әдемі әйелдің профилі деп айтылады.
Dialogue: 0,0:08:32.43,0:08:34.10,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:08:34.19,0:08:36.77,Default,,0,0,0,,Сіз бұл бос сөздің бәрін білесіз.
Dialogue: 0,0:08:36.90,0:08:39.98,Default,,0,0,0,,Өмірімде бірінші рет мен саған таң қалдым.
Dialogue: 0,0:08:40.07,0:08:40.98,Default,,0,0,0,,Эй!
Dialogue: 0,0:08:41.07,0:08:44.24,Default,,0,0,0,,Мен астрономия және ғарыш ғылымы туралы көп білемін.
Dialogue: 0,0:08:44.45,0:08:47.66,Default,,0,0,0,,Ештеңе етпейді, менің алдымда әдемі көрінудің қажеті жоқ.
Dialogue: 0,0:08:47.74,0:08:50.41,Default,,0,0,0,,Сіз бәрібір басқа ештеңе білмейсіз, солай ма?
Dialogue: 0,0:08:50.54,0:08:52.33,Default,,0,0,0,,Ауызша зорлық-зомбылық туралы білесіз бе?
Dialogue: 0,0:08:52.70,0:08:55.37,Default,,0,0,0,,Содан кейін тіл полициясын шақырыңыз.
Dialogue: 0,0:08:56.08,0:08:57.38,Default,,0,0,0,,Сіз...
Dialogue: 0,0:08:57.46,0:09:00.92,Default,,0,0,0,,Шындығында, сіз маған тек мақтаншақ денеңізді көрсеткіңіз келе ме?
Dialogue: 0,0:09:01.00,0:09:03.92,Default,,0,0,0,,Мен өз денемді мақтан тұтамын деп мақтаншақ емеспін.
Dialogue: 0,0:09:04.47,0:09:08.05,Default,,0,0,0,,Мен киім киюге шебер емеспін, олар ауыр.
Dialogue: 0,0:09:08.35,0:09:09.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:09.76,0:09:12.77,Default,,0,0,0,,Бірақ сен таңқаларлық білімді екенсің, Арараги-кун.
Dialogue: 0,0:09:12.85,0:09:14.10,Default,,0,0,0,,(Мектеп оқушысы 2) Джоджо (Мектеп оқушысы 5) Джоджо, қайырлы таң
Dialogue: 0,0:09:14.27,0:09:17.98,Default,,0,0,0,,Сіздің басыңызда ми бар шығар.
Dialogue: 0,0:09:18.06,0:09:18.90,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:09:19.27,0:09:20.23,Default,,0,0,0,,Бұл анық...
Dialogue: 0,0:09:20.82,0:09:22.65,Default,,0,0,0,,Сен сияқты жаратылыстардың бас сүйектерінде
Dialogue: 0,0:09:23.24,0:09:25.24,Default,,0,0,0,,Құрамында ми бар дегенді білдіреді
Dialogue: 0,0:09:25.32,0:09:28.37,Default,,0,0,0,,Бұл қазірдің өзінде ғажайып оқиға емес пе?
Dialogue: 0,0:09:28.74,0:09:31.74,Default,,0,0,0,,Сіз мені шынымен ақымақ деп ойлайтын шығарсыз.
Dialogue: 0,0:09:32.08,0:09:33.91,Default,,0,0,0,,Ах! Неге байқадың?
Dialogue: 0,0:09:34.87,0:09:36.16,Default,,0,0,0,,Мен оның тік жүзіне таң қалдым!
Dialogue: 0,0:09:38.33,0:09:40.34,Default,,0,0,0,,Мен үшін, Арараги-кун
Dialogue: 0,0:09:40.42,0:09:43.55,Default,,0,0,0,,Мен ақылымның қаншалықты ақымақ екенін түсіндім.
Dialogue: 0,0:09:43.63,0:09:44.67,Default,,0,0,0,,Мен жауапкершілікті сезінемін.
Dialogue: 0,0:09:45.01,0:09:46.59,Default,,0,0,0,,Польнарефф, рөл артында бәрі жақсы ма?
Dialogue: 0,0:09:46.68,0:09:49.64,Default,,0,0,0,,Мен соншалықты ақымақпын ба?
Dialogue: 0,0:09:49.97,0:09:52.39,Default,,0,0,0,,Ауытқу мәнін тексеру I 74
Dialogue: 0,0:09:52.81,0:09:54.64,Default,,0,0,0,,Қарғыс атсын... Мен 46
Dialogue: 0,0:09:54.89,0:09:56.35,Default,,0,0,0,,Егер сіз оны дөңгелектесеңіз, ол нөлге тең болады.
Dialogue: 0,0:09:56.89,0:09:58.77,Default,,0,0,0,,Иә? Өтірікші, себебі сағат 6...
Dialogue: 0,0:09:59.81,0:10:02.98,Default,,0,0,0,,Ах! Сен, енді ондыққа!
Dialogue: 0,0:10:03.07,0:10:05.44,Default,,0,0,0,,​​Менің ауытқу баллымды не істейсің!
Dialogue: 0,0:10:05.53,0:10:08.57,Default,,0,0,0,,100... Өзгеріс жасамайынша, өзімді жеңген сияқты емеспін.
Dialogue: 0,0:10:08.66,0:10:10.45,Default,,0,0,0,,Менің сандарымда да ондық орын бар...
Dialogue: 0,0:10:11.74,0:10:14.04,Default,,0,0,0,,Иә, мен шештім.
Dialogue: 0,0:10:15.79,0:10:17.71,Default,,0,0,0,,Егер бәрі жақсы болса
Dialogue: 0,0:10:17.79,0:10:19.88,Default,,0,0,0,,Шаян жеуге Хоккайдоға барайық
Dialogue: 0,0:10:19.96,0:10:22.13,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:10:22.38,0:10:23.46,Default,,0,0,0,,Сіз де барасыз.
Dialogue: 0,0:10:23.63,0:10:24.46,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:24.96,0:10:26.72,Default,,0,0,0,,О, сен білмедің бе?
Dialogue: 0,0:10:27.88,0:10:30.68,Default,,0,0,0,,Шаян өте дәмді.
Dialogue: 0,0:10:53.20,0:10:54.03,Default,,0,0,0,,Ах
Dialogue: 0,0:10:57.45,0:10:58.37,Default,,0,0,0,,Е...
Dialogue: 0,0:11:01.04,0:11:04.09,Default,,0,0,0,,Ошино мырза синтоизм діни қызметкері болды ма?
Dialogue: 0,0:11:04.17,0:11:05.67,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:11:06.09,0:11:09.59,Default,,0,0,0,,Мен университетте осылай оқыдым, бірақ ғибадатханада жұмысқа орналаспадым.
Dialogue: 0,0:11:09.93,0:11:11.84,Default,,0,0,0,,Менің ойымда көп нәрсе бар.
Dialogue: 0,0:11:12.39,0:11:16.26,Default,,0,0,0,,Иә, қызым, сен адал болып бара жатырсың.
Dialogue: 0,0:11:16.35,0:11:17.47,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:11:18.23,0:11:21.31,Default,,0,0,0,,Тек растау үшін, сіз макияж киіп жүрсіз бе?
Dialogue: 0,0:11:21.40,0:11:24.11,Default,,0,0,0,,Мен мұны істемегенім жақсы деп ойладым.
Dialogue: 0,0:11:24.19,0:11:25.02,Default,,0,0,0,,Иә
Dialogue: 0,0:11:25.11,0:11:27.15,Default,,0,0,0,,Бұл сөзсіз дұрыс шешім.
Dialogue: 0,0:11:27.48,0:11:29.49,Default,,0,0,0,,Арараги-кун, сен де душ қабылдадың ба?
Dialogue: 0,0:11:29.69,0:11:32.45,Default,,0,0,0,,А, мен оны Сенджугахарадан алдым. Мәселе жоқ.
Dialogue: 0,0:11:33.49,0:11:36.20,Default,,0,0,0,,Хамф, сен жақсы көрінбейсің.
Dialogue: 0,0:11:36.28,0:11:37.91,Default,,0,0,0,,Қажетсіз нәрселерді айтпаңыз
Dialogue: 0,0:11:41.87,0:11:43.04,Default,,0,0,0,,Бірақ Ошино
Dialogue: 0,0:11:43.13,0:11:46.17,Default,,0,0,0,,Шаяндардан немесе басқа нәрселерден оңай құтылу мүмкін бе?
Dialogue: 0,0:11:47.59,0:11:49.80,Default,,0,0,0,,Ойлау тәсілің жабайы, Арараги-кун.
Dialogue: 0,0:11:50.47,0:11:52.55,Default,,0,0,0,,Жақсы нәрсе болды ма?
Dialogue: 0,0:11:53.01,0:11:55.76,Default,,0,0,0,,Шинобу-чан мен бозғылт мысық зұлым және дұшпан.
Dialogue: 0,0:11:55.85,0:11:58.81,Default,,0,0,0,,Ол Арараги-кун мен Төраға-чанға шабуыл жасады.
Dialogue: 0,0:11:58.97,0:12:01.27,Default,,0,0,0,,Шаянның бұл жолы олай емес.
Dialogue: 0,0:12:01.35,0:12:02.19,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:12:03.27,0:12:06.15,Default,,0,0,0,,Мен саған айттым ба? Басқа адам - Құдай
Dialogue: 0,0:12:06.23,0:12:09.65,Default,,0,0,0,,Сондықтан олардан құтылудың орнына, қазірден бастап біз
Dialogue: 0,0:12:09.94,0:12:11.45,Default,,0,0,0,,Құдайдан сұра
Dialogue: 0,0:12:11.95,0:12:13.45,Default,,0,0,0,,Нашар шықты.
Dialogue: 0,0:12:13.53,0:12:16.78,Default,,0,0,0,,Егер мен бірдеңе сұрасам, оны қайтара аламын ба?
Dialogue: 0,0:12:16.87,0:12:17.70,Default,,0,0,0,,Сенджогахара
Dialogue: 0,0:12:18.74,0:12:20.41,Default,,0,0,0,,Салмақ Салмағы
Dialogue: 0,0:12:21.04,0:12:21.91,Default,,0,0,0,,Мүмкін.
Dialogue: 0,0:12:22.46,0:12:26.92,Default,,0,0,0,,Олар адамның маңызды өтінішінен бас тартатындай қыңыр емес.
Dialogue: 0,0:12:27.00,0:12:30.71,Default,,0,0,0,,Ал құдайлар – өте сызбалы топ.
Dialogue: 0,0:12:31.09,0:12:32.38,Default,,0,0,0,,Шамамен?
Dialogue: 0,0:12:32.92,0:12:35.93,Default,,0,0,0,,Адам баласы, мен жеке адамдармен санаспаймын.
Dialogue: 0,0:12:36.01,0:12:37.30,Default,,0,0,0,,Негізінде, Алланың алдында
Dialogue: 0,0:12:37.39,0:12:41.02,Default,,0,0,0,,Үшеуміз, жас, жыныс және салмақ арасында ешқандай айырмашылық жоқ.
Dialogue: 0,0:12:41.52,0:12:44.31,Default,,0,0,0,,Ей, бұл шаян
Dialogue: 0,0:12:44.39,0:12:46.15,Default,,0,0,0,,Сіз әлі менің қасымдасыз ба?
Dialogue: 0,0:12:47.61,0:12:51.23,Default,,0,0,0,,Иә, ол бар, ол барлық жерде.
Dialogue: 0,0:12:51.90,0:12:54.53,Default,,0,0,0,,Алайда мұнда түсу үшін
Dialogue: 0,0:12:54.70,0:12:56.57,Default,,0,0,0,,Маған процедура керек (Сенжугахара) А...
Dialogue: 0,0:13:06.33,0:13:08.25,Default,,0,0,0,,Екеуі де көздерін төмен түсірді.
Dialogue: 0,0:13:08.34,0:13:10.05,Default,,0,0,0,,Басыңызды төмен түсіресіз бе? (2 адам) Иә?
Dialogue: 0,0:13:10.59,0:13:12.55,Default,,0,0,0,,Бұл құдайлардың алдында.
Dialogue: 0,0:13:26.65,0:13:28.44,Default,,0,0,0,,А... не?
Dialogue: 0,0:13:28.56,0:13:29.90,Default,,0,0,0,,Сіз алкогольді ішкен кезде
Dialogue: 0,0:13:29.98,0:13:33.78,Default,,0,0,0,,Шамасы, бұл сіз бен Құдай арасындағы қашықтықты қысқартуы мүмкін.
Dialogue: 0,0:13:33.99,0:13:35.28,Default,,0,0,0,,Мен кәмелетке толмағанмын.
Dialogue: 0,0:13:35.36,0:13:38.57,Default,,0,0,0,,Мас болу үшін жеткілікті ішудің қажеті жоқ, аз ғана.
Dialogue: 0,0:13:48.33,0:13:49.25,Default,,0,0,0,,Қазір...
Dialogue: 0,0:13:49.33,0:13:51.71,Default,,0,0,0,,Ендеше демалудан бастайық.
Dialogue: 0,0:13:53.42,0:13:57.72,Default,,0,0,0,,Бұл менің орным, мен сені кәдімгідей қабылдайтын жерім.
Dialogue: 0,0:13:58.89,0:13:59.72,Default,,0,0,0,,Иә...
Dialogue: 0,0:14:01.05,0:14:05.14,Default,,0,0,0,,Басыңызды төмен түсіріп, көзіңізді жұмып, санаңыз.
Dialogue: 0,0:14:10.31,0:14:13.19,Default,,0,0,0,,Бір екі
Dialogue: 0,0:14:13.73,0:14:16.44,Default,,0,0,0,,Үш төрт
Dialogue: 0,0:14:16.99,0:14:19.70,Default,,0,0,0,,Бес алты
Dialogue: 0,0:14:20.12,0:14:21.37,Default,,0,0,0,,Жеті
Dialogue: 0,0:14:21.95,0:14:22.99,Default,,0,0,0,,Сегіз
Dialogue: 0,0:14:23.66,0:14:24.49,Default,,0,0,0,,Тоғыз
Dialogue: 0,0:14:28.00,0:14:28.96,Default,,0,0,0,,Сіз тынышталдыңыз ба?
Dialogue: 0,0:14:30.00,0:14:30.83,Default,,0,0,0,,Иә
Dialogue: 0,0:14:30.92,0:14:33.63,Default,,0,0,0,,Жарайды, сұраққа жауап берейік.
Dialogue: 0,0:14:35.71,0:14:37.63,Default,,0,0,0,,Қыз, сенің атың кім?
Dialogue: 0,0:14:38.30,0:14:39.76,Default,,0,0,0,,Сенджугахара Хитаги
Dialogue: 0,0:14:40.39,0:14:41.64,Default,,0,0,0,,Сіз қай мектепте оқисыз?
Dialogue: 0,0:14:42.47,0:14:44.14,Default,,0,0,0,,Жеке Наоэцу орта мектебі
Dialogue: 0,0:14:44.56,0:14:45.39,Default,,0,0,0,,Сіздің туған күніңіз қашан?
Dialogue: 0,0:14:46.18,0:14:47.27,Default,,0,0,0,,7 шілде
Dialogue: 0,0:14:48.02,0:14:49.52,Default,,0,0,0,,Сіздің сүйікті жазушыңыз кім?
Dialogue: 0,0:14:50.40,0:14:51.40,Default,,0,0,0,,Кюсаку Юмено
Dialogue: 0,0:14:52.06,0:14:54.40,Default,,0,0,0,,Балалық шағыңдағы сәтсіздіктер туралы әңгіме айтып бере аласың ба?
Dialogue: 0,0:14:54.98,0:14:56.03,Default,,0,0,0,,Мен мұны айтқым келмейді
Dialogue: 0,0:14:56.74,0:14:57.90,Default,,0,0,0,,Сіздің сүйікті классикалық музыкаңыз қандай?
Dialogue: 0,0:14:58.65,0:15:00.41,Default,,0,0,0,,Мен музыканы ұнатпаймын.
Dialogue: 0,0:15:00.78,0:15:03.28,Default,,0,0,0,,Бастауыш мектепті бітіргенде не ойладың?
Dialogue: 0,0:15:03.91,0:15:07.25,Default,,0,0,0,,Мен жай ғана орта мектепке ауысамын деп ойладым.
Dialogue: 0,0:15:07.45,0:15:09.54,Default,,0,0,0,,Мен жаңа ғана мемлекеттік мектептен мемлекеттік мектепке бардым.
Dialogue: 0,0:15:09.96,0:15:11.83,Default,,0,0,0,,Алғашқы махаббатыңыз қандай бала болды?
Dialogue: 0,0:15:12.46,0:15:13.34,Default,,0,0,0,,Мен мұны айтқым келмейді
Dialogue: 0,0:15:14.04,0:15:15.34,Default,,0,0,0,,Осы уақытқа дейін менің өмірімде
Dialogue: 0,0:15:15.42,0:15:16.84,Default,,0,0,0,,Ең ауыр жадыңыз қандай?
Dialogue: 0,0:15:19.76,0:15:20.97,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:21.34,0:15:24.72,Default,,0,0,0,,Мен сенен ең ауыр естеліктеріңді сұрап тұрмын.
Dialogue: 0,0:15:26.72,0:15:29.85,Default,,0,0,0,,О... о... анашым...
Dialogue: 0,0:15:30.85,0:15:31.73,Default,,0,0,0,,Менің анам
Dialogue: 0,0:15:32.90,0:15:35.23,Default,,0,0,0,,Жаман дінге құмар болу
Dialogue: 0,0:15:36.32,0:15:37.23,Default,,0,0,0,,Барлығы осы ма?
Dialogue: 0,0:15:38.19,0:15:39.36,Default,,0,0,0,,Барлығы осы...
Dialogue: 0,0:15:40.40,0:15:42.99,Default,,0,0,0,,Айтыңызшы, не болды?
Dialogue: 0,0:15:44.70,0:15:49.25,Default,,0,0,0,,Мм... Менде сол діни ұйымның басшысы бар.
Dialogue: 0,0:15:50.00,0:15:52.17,Default,,0,0,0,,Мені осында анам әкелді.
Dialogue: 0,0:15:53.00,0:15:54.63,Default,,0,0,0,,Сіз келгенде не болды?
Dialogue: 0,0:15:55.92,0:15:58.13,Default,,0,0,0,,Мені салт деп атаңыз...
Dialogue: 0,0:15:59.63,0:16:01.34,Default,,0,0,0,,Мен... маған
Dialogue: 0,0:16:02.34,0:16:03.18,Default,,0,0,0,,Зорлық-зомбылық
Dialogue: 0,0:16:03.34,0:16:04.18,Default,,0,0,0,,Ах
Dialogue: 0,0:16:07.72,0:16:10.64,Default,,0,0,0,,Сіз мені... зорламақ болдыңыз.
Dialogue: 0,0:16:11.39,0:16:12.48,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:16:13.19,0:16:17.90,Default,,0,0,0,,Бірақ «жасауға тырысу» бұл әрекетті білдіреді, солай емес пе?
Dialogue: 0,0:16:19.07,0:16:21.65,Default,,0,0,0,,​​Мен оны жақын маңдағы шыбықпен ұрдым.
Dialogue: 0,0:16:22.78,0:16:27.24,Default,,0,0,0,,Бірақ анам маған көмектеспеді.
Dialogue: 0,0:16:28.16,0:16:28.99,Default,,0,0,0,,Және?
Dialogue: 0,0:16:30.25,0:16:35.54,Default,,0,0,0,,Мен сол басшыны жаралағаным үшін анам...
Dialogue: 0,0:16:36.71,0:16:39.67,Default,,0,0,0,,Сіздің анаңыз жазаға тартылды ма?
Dialogue: 0,0:16:40.55,0:16:44.09,Default,,0,0,0,,Иә, бірақ мен бұл туралы ойлаймын.
Dialogue: 0,0:16:44.30,0:16:46.93,Default,,0,0,0,,Егер мен сол кезде қарсылық көрсетпесем
Dialogue: 0,0:16:47.89,0:16:51.73,Default,,0,0,0,,Кем дегенде, бұлай болмас еді.
Dialogue: 0,0:16:52.06,0:16:53.98,Default,,0,0,0,,Менің ойымша, ол бұзылған жоқ.
Dialogue: 0,0:16:54.44,0:16:58.69,Default,,0,0,0,,Олай болса, жас ханым, бұл сіздің ойыңыз.
Dialogue: 0,0:16:58.90,0:17:00.40,Default,,0,0,0,,Қанша ауыр болса да
Dialogue: 0,0:17:00.53,0:17:03.28,Default,,0,0,0,,Бұл сіз алып жүруіңіз керек нәрсе.
Dialogue: 0,0:17:03.45,0:17:05.45,Default,,0,0,0,,Сіз мұны басқаларға қалдыра алмайсыз.
Dialogue: 0,0:17:06.91,0:17:08.70,Default,,0,0,0,,Басқаларға қалдырыңыз...
Dialogue: 0,0:17:09.41,0:17:12.70,Default,,0,0,0,,Айналма, көзіңді ашып қара.
Dialogue: 0,0:17:21.50,0:17:26.01,Default,,0,0,0,,Ха... ааа...
Dialogue: 0,0:17:26.59,0:17:28.60,Default,,0,0,0,,Сіз бірдеңе көре аласыз ба?
Dialogue: 0,0:17:28.80,0:17:32.02,Default,,0,0,0,,Мен көріп тұрмын... Сол кездегідей...
Dialogue: 0,0:17:32.68,0:17:38.02,Default,,0,0,0,,Мен сол кездегі үлкен шаянды көріп тұрмын.
Dialogue: 0,0:17:39.48,0:17:40.82,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:17:40.90,0:17:44.40,Default,,0,0,0,,Мен оны мүлдем көрмеймін, бірақ Арараги-кун ше?
Dialogue: 0,0:17:44.90,0:17:46.24,Default,,0,0,0,,Мен ештеңе көре алмаймын
Dialogue: 0,0:17:46.65,0:17:50.49,Default,,0,0,0,,Сонымен... Бірақ мен оны анық көріп тұрмын.
Dialogue: 0,0:17:51.16,0:17:52.12,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:17:53.29,0:17:55.62,Default,,0,0,0,,Олай болса, бірдеңе айту керек емес пе?
Dialogue: 0,0:17:57.29,0:18:00.00,Default,,0,0,0,,Не айтайын... Әй
Dialogue: 0,0:18:01.67,0:18:02.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:06.38,0:18:07.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:09.01,0:18:11.18,Default,,0,0,0,,Әй, Сенджугахара!
Dialogue: 0,0:18:11.26,0:18:13.01,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:18:13.39,0:18:16.68,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:18:19.65,0:18:21.36,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:18:21.52,0:18:23.94,Default,,0,0,0,,О, Құдайым, сен сондай сабырсызсың.
Dialogue: 0,0:18:24.03,0:18:26.36,Default,,0,0,0,,Ол шынымен жақсы жігіт.
Dialogue: 0,0:18:26.44,0:18:27.95,Default,,0,0,0,,Мүмкін жақсы нәрсе болған шығар.
Dialogue: 0,0:18:28.32,0:18:30.28,Default,,0,0,0,,О... Эй, Ошино
Dialogue: 0,0:18:30.45,0:18:33.58,Default,,0,0,0,,Мен білемін. Бұл саясаттың өзгеруі. Мен көмектесе алмаймын.
Dialogue: 0,0:18:34.70,0:18:37.33,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:18:41.00,0:18:42.50,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:18:46.30,0:18:50.26,Default,,0,0,0,,Сайып келгенде, бұл ақыл-ой мәселесі.
Dialogue: 0,0:18:50.51,0:18:53.51,Default,,0,0,0,,Сұрай алмасаң, Тілді түсінбесек
Dialogue: 0,0:18:53.60,0:18:55.52,Default,,0,0,0,,Соғыстан басқа ештеңе жоқ
Dialogue: 0,0:18:55.60,0:18:56.43,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:56.52,0:18:58.73,Default,,0,0,0,,Жақсы, егер біз оны осылай ұсақтайтын болсақ.
Dialogue: 0,0:18:58.81,0:19:01.02,Default,,0,0,0,,Ол пішін бойынша шешілген.
Dialogue: 0,0:19:01.48,0:19:03.61,Default,,0,0,0,,Осы кезде мен солай болуы мүмкін деп ойладым.
Dialogue: 0,0:19:03.69,0:19:05.36,Default,,0,0,0,,Ах... Бұл мүмкін бе деп ойлаймын.
Dialogue: 0,0:19:05.44,0:19:07.86,Default,,0,0,0,,Мен крабдарды қатты жек көремін.
Dialogue: 0,0:19:08.40,0:19:09.49,Default,,0,0,0,,Тамақтану қиын.
Dialogue: 0,0:19:10.91,0:19:11.74,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:19:12.57,0:19:14.33,Default,,0,0,0,,Күте тұрыңыз, Ошино мырза.
Dialogue: 0,0:19:14.41,0:19:15.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:16.66,0:19:19.79,Default,,0,0,0,,Күту дегенді қалай түсінесіңдер? Кішкентай қыз
Dialogue: 0,0:19:20.17,0:19:23.17,Default,,0,0,0,,Мен бұрын ғана таң қалдым.
Dialogue: 0,0:19:23.96,0:19:26.71,Default,,0,0,0,,Мен мұны дұрыс істей аламын.
Dialogue: 0,0:19:26.80,0:19:28.80,Default,,0,0,0,,Өйткені мен мұны өзім істей аламын
Dialogue: 0,0:19:28.97,0:19:29.80,Default,,0,0,0,,Тек осы екі қарапайым белгіні есте сақта.
Dialogue: 0,0:19:30.38,0:19:32.68,Default,,0,0,0,,Содан кейін барып, көріңіз.
Dialogue: 0,0:19:32.93,0:19:33.76,Default,,0,0,0,,Ах
Dialogue: 0,0:19:37.27,0:19:38.27,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:39.48,0:19:42.02,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:19:43.35,0:19:45.19,Default,,0,0,0,,Бірақ жеткілікті.
Dialogue: 0,0:19:45.32,0:19:50.15,Default,,0,0,0,,Бұл менің сезімдерім, ойларым, естеліктерім.
Dialogue: 0,0:19:50.36,0:19:51.61,Default,,0,0,0,,Мен оны арқаммен көтеремін
Dialogue: 0,0:19:52.57,0:19:54.41,Default,,0,0,0,,Мен оны жоғалтуға тура келді.
Dialogue: 0,0:19:57.04,0:19:58.37,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:19:58.58,0:20:02.12,Default,,0,0,0,,Маған салмағымды қайтарып беріңізші.
Dialogue: 0,0:20:02.96,0:20:06.75,Default,,0,0,0,,Өтінемін, анамды маған қайтарыңыз.
Dialogue: 0,0:20:12.72,0:20:16.26,Default,,0,0,0,,(Сенджогахараның айқайы)
Dialogue: 0,0:20:17.64,0:20:21.52,Default,,0,0,0,,Сенджугахараның анасы жауыз дінге түсіп кетті.
Dialogue: 0,0:20:21.89,0:20:25.10,Default,,0,0,0,,Сенджугахара бастауыш мектептің бесінші сыныбында оқығанға ұқсайды.
Dialogue: 0,0:20:25.52,0:20:28.90,Default,,0,0,0,,Шамамен сол кезде Сенджугахара қорқынышты аурудан зардап шекті.
Dialogue: 0,0:20:30.11,0:20:31.61,Default,,0,0,0,,Қызымның ауруына байланысты
Dialogue: 0,0:20:31.69,0:20:35.16,Default,,0,0,0,,Сенджугахараның анасы жүрегін тыныштандыратын жер іздеді.
Dialogue: 0,0:20:35.45,0:20:36.28,Default,,0,0,0,,Және…
Dialogue: 0,0:20:38.20,0:20:42.25,Default,,0,0,0,,Шамасы, Сенджогахара ауыр операция нәтижесінде өлімнен аман қалды.
Dialogue: 0,0:20:43.33,0:20:45.63,Default,,0,0,0,,Бірақ нәтижесінде ана
Dialogue: 0,0:20:45.71,0:20:48.21,Default,,0,0,0,,Дінге көбірек беріле бастадым.
Dialogue: 0,0:20:48.80,0:20:52.13,Default,,0,0,0,,Сенджугахара анасымен араздасып қалған көрінеді.
Dialogue: 0,0:20:52.38,0:20:55.47,Default,,0,0,0,,Ол кіші мектеп оқушысы болғаннан кейін әрең сөйлеген сияқты.
Dialogue: 0,0:20:55.80,0:20:56.64,Default,,0,0,0,,Және…
Dialogue: 0,0:20:57.60,0:21:00.60,Default,,0,0,0,,Оқиға мен орта мектепті бітірейін деп жатқанда болды.
Dialogue: 0,0:21:09.52,0:21:10.94,Default,,0,0,0,,Нәтиже—
Dialogue: 0,0:21:14.36,0:21:16.28,Default,,0,0,0,,Отбасы күйреді.
Dialogue: 0,0:21:17.45,0:21:18.28,Default,,0,0,0,,Ажырасқан
Dialogue: 0,0:21:19.41,0:21:24.16,Default,,0,0,0,,Сонда Сенджогахара шаянға тап болды.
Dialogue: 0,0:21:25.04,0:21:26.67,Default,,0,0,0,,Мен оны әлдеқашан салып қойғанмын
Dialogue: 0,0:21:26.75,0:21:29.42,Default,,0,0,0,,Күлкілі краб - Арараги-кун
Dialogue: 0,0:21:29.54,0:21:32.67,Default,,0,0,0,,Демек, бұл «Омоиши Ками» дегенді білдіреді.
Dialogue: 0,0:21:33.05,0:21:35.13,Default,,0,0,0,,Сондай-ақ «естеліктер»
Dialogue: 0,0:21:35.22,0:21:37.18,Default,,0,0,0,,Басқаша айтқанда, бұғау деп те атауға болады.
Dialogue: 0,0:21:38.14,0:21:39.68,Default,,0,0,0,,Басқаша айтқанда, сіз барып шаянды кездестіргенде
Dialogue: 0,0:21:39.76,0:21:42.68,Default,,0,0,0,,Сенджугахара анасымен байланысты үзді.
Dialogue: 0,0:21:43.77,0:21:46.60,Default,,0,0,0,,Мен анамды уайымдауды қойдым.
Dialogue: 0,0:21:46.89,0:21:48.06,Default,,0,0,0,,Мен ойлауды тоқтаттым
Dialogue: 0,0:21:48.15,0:21:49.69,Default,,0,0,0,,Мен салмақ жоғалттым.
Dialogue: 0,0:21:50.40,0:21:53.44,Default,,0,0,0,,Өз еркімен алдады
Dialogue: 0,0:21:53.99,0:21:56.90,Default,,0,0,0,,Дегенмен бұл жаман нәрсе емес.
Dialogue: 0,0:21:56.99,0:22:00.78,Default,,0,0,0,,Әсіресе бұл жағдайда, енді мен өз ойыма оралдым,
Dialogue: 0,0:22:00.87,0:22:02.70,Default,,0,0,0,,Бұл анам қайтып келеді деген сөз емес
Dialogue: 0,0:22:02.79,0:22:05.20,Default,,0,0,0,,Бұзылған отбасы қайта жандамайды.
Dialogue: 0,0:22:05.91,0:22:07.46,Default,,0,0,0,,Және де
Dialogue: 0,0:22:08.04,0:22:11.71,Default,,0,0,0,,Сондықтан мен Сенджугахара Хитагидің қайтарылуын қаладым.
Dialogue: 0,0:22:11.79,0:22:13.30,Default,,0,0,0,,Мен оны қайтарғым келді.
Dialogue: 0,0:22:13.38,0:22:17.43,Default,,0,0,0,,Анамның естеліктеріне, естеліктеріне және уайымдарына қатысты ештеңе істей алмаймын.
Dialogue: 0,0:22:17.84,0:22:21.35,Default,,0,0,0,,Ошино айтқандай, ештеңе өзгермейді.
Dialogue: 0,0:22:22.76,0:22:24.97,Default,,0,0,0,,Ештеңе ешқашан өзгермейді.
Dialogue: 0,0:22:25.56,0:22:28.44,Default,,0,0,0,,Және бұл ысырап болған жоқ.
Dialogue: 0,0:22:28.56,0:22:31.86,Default,,0,0,0,,Мен кем дегенде бір маңызды дос таптым.
Dialogue: 0,0:22:32.48,0:22:33.36,Default,,0,0,0,,Сіз кім туралы айтып отырсыз?
Dialogue: 0,0:22:35.03,0:22:36.61,Default,,0,0,0,,Бұл сен туралы (Арараги) Ха!
Dialogue: 0,0:22:37.36,0:22:39.41,Default,,0,0,0,,Арараги-кун рахмет
Dialogue: 0,0:22:39.57,0:22:42.03,Default,,0,0,0,,Мен сізге өте ризамын.
Dialogue: 0,0:22:42.37,0:22:44.58,Default,,0,0,0,,Осы уақытқа дейін болған барлық нәрсе үшін кешірім сұраймын.
Dialogue: 0,0:22:46.08,0:22:48.16,Default,,0,0,0,,Бұл дөрекі болуы мүмкін, бірақ
Dialogue: 0,0:22:48.25,0:22:51.83,Default,,0,0,0,,Дос болып қала берсек, мен өте бақытты болар едім.
Dialogue: 0,0:22:52.29,0:22:53.13,Default,,0,0,0,,Ах
Dialogue: 0,0:22:55.51,0:22:56.34,Default,,0,0,0,,Хехе
Dialogue: 0,0:22:57.42,0:22:58.88,Default,,0,0,0,,Бауырым! Таң атты, Кора!
Dialogue: 0,0:22:59.22,0:23:01.34,Default,,0,0,0,,Сізге асығыс оянуға тура келеді.
Dialogue: 0,0:23:01.43,0:23:03.39,Default,,0,0,0,,Жаңа ғана ұйықтап қалсам да
Dialogue: 0,0:23:03.72,0:23:06.39,Default,,0,0,0,,Ах~ Сіз тағы да кеш тұрдыңыз!
Dialogue: 0,0:23:06.52,0:23:07.35,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:23:07.68,0:23:10.19,Default,,0,0,0,,Таңғы ас ішпеген жалғыз менің ағам!
Dialogue: 0,0:23:12.56,0:23:15.94,Default,,0,0,0,,Алайда мен шаршадым, менде де қызба бар сияқты.
Dialogue: 0,0:23:17.69,0:23:21.32,Default,,0,0,0,,Айтпақшы, менің салмағым 55 кг, бірақ...
Dialogue: 0,0:23:21.74,0:23:22.57,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:23:23.32,0:23:27.91,Default,,0,0,0,,Мен көремін. Құдайлар, әрине, өрескел топ.
Dialogue: 0,0:23:30.62,0:23:36.63,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:24:52.87,0:24:58.88,Default,,0,0,0,,~♪
Dialogue: 0,0:25:01.01,0:25:02.55,Default,,0,0,0,,Бұл Карен! (Дүйсенбі және сейсенбі) Бұл дүйсенбі және сейсенбі!
Dialogue: 0,0:25:02.63,0:25:03.47,Default,,0,0,0,,Джунгли спорт залы деп аталады.
Dialogue: 0,0:25:03.55,0:25:04.38,Default,,0,0,0,,Мен де айттым ғой!
Dialogue: 0,0:25:04.47,0:25:05.30,Default,,0,0,0,,Мен асыра айтып отырмын деп ойлаймын.
Dialogue: 0,0:25:05.38,0:25:06.93,Default,,0,0,0,,Сіз тым көп айтасыз ба? (Дүйсенбі/сейсенбі) Джунгли
Dialogue: 0,0:25:06.97,0:25:08.05,Default,,0,0,0,,Джунгли... солай емес пе?
Dialogue: 0,0:25:08.14,0:25:09.43,Default,,0,0,0,,Джим (Карен) Джим де, эй.
Dialogue: 0,0:25:09.51,0:25:10.39,Default,,0,0,0,,Бұл кескін манипуляциясы.
Dialogue: 0,0:25:10.43,0:25:11.72,Default,,0,0,0,,Сонымен, қандай атау дұрыс?
Dialogue: 0,0:25:11.81,0:25:13.39,Default,,0,0,0,,Менің ойымша, «Арнайы көлденең жолақ» сияқты нәрсе жақсы болар еді.
Dialogue: 0,0:25:13.48,0:25:14.31,Default,,0,0,0,,Керемет көрінеді!
Dialogue: 0,0:25:14.39,0:25:15.44,Default,,0,0,0,,Міне, трейлер викторинасы!
Dialogue: 0,0:25:15.52,0:25:16.35,Default,,0,0,0,,Викторина!
Dialogue: 0,0:25:16.48,0:25:17.52,Default,,0,0,0,,Сіз автобус жүргізушісісіз
Dialogue: 0,0:25:17.61,0:25:19.40,Default,,0,0,0,,Мен ешқашан автобус жүргізушісімін деп ойламаппын!
Dialogue: 0,0:25:19.48,0:25:20.48,Default,,0,0,0,,Бірінші станцияда үш адам отырды!
Dialogue: 0,0:25:20.57,0:25:21.61,Default,,0,0,0,,Менің көңіл-күйім көтеріңкі!
Dialogue: 0,0:25:21.65,0:25:23.57,Default,,0,0,0,,Енді автобус жүргізушісінің аты кім?
Dialogue: 0,0:25:23.65,0:25:24.95,Default,,0,0,0,,Бұл тым көп!
Dialogue: 0,0:25:25.07,0:25:26.99,Default,,0,0,0,,Келесі жолы «Майои Май Май 1-бөлім»
Dialogue: 0,0:25:27.07,0:25:28.28,Default,,0,0,0,,Иә, бұл сіздің атыңыз.
