Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.00,0:00:08.84,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:00:08.92,0:00:10.09,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:00:10.84,0:00:13.05,Default,,0,0,0,,Барлығыңыз сәйкес келдіңіз бе?
Dialogue: 0,0:00:13.63,0:00:16.93,Default,,0,0,0,,Бұл жолы жоғары тұрған полиция қызметкерлерінен көмек сұрағым келеді.
Dialogue: 0,0:00:17.01,0:00:18.85,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:18.93,0:00:19.77,Default,,0,0,0,,О
Dialogue: 0,0:00:20.35,0:00:22.27,Default,,0,0,0,,Бұл сізге де арналған
Dialogue: 0,0:00:22.35,0:00:26.10,Default,,0,0,0,,Адамдардың бізді иіскеуі қиын болар еді.
Dialogue: 0,0:00:26.40,0:00:28.61,Default,,0,0,0,,Бұл жағдайда мысықтың көзі
Dialogue: 0,0:00:28.69,0:00:30.65,Default,,0,0,0,,Олардың қатысы бар екені рас па?
Dialogue: 0,0:00:30.98,0:00:32.03,Default,,0,0,0,,Иә
Dialogue: 0,0:00:33.03,0:00:36.57,Default,,0,0,0,,Өйткені олар полицияға хабарлама жіберген.
Dialogue: 0,0:00:36.78,0:00:39.08,Default,,0,0,0,,«Көз жасы қыз» хикаясы жарыққа шықты...
Dialogue: 0,0:00:39.54,0:00:41.50,Default,,0,0,0,,Олар көздің жауын алады.
Dialogue: 0,0:00:41.58,0:00:43.91,Default,,0,0,0,,Менің «Коморебиімді» де солар қиратты.
Dialogue: 0,0:00:44.00,0:00:45.79,Default,,0,0,0,,«Рим әйелі».
Dialogue: 0,0:00:45.87,0:00:48.79,Default,,0,0,0,,Олардың бәрі Хайнцтың шығармалары.
Dialogue: 0,0:00:49.17,0:00:52.30,Default,,0,0,0,,Біздің не істегенімізден хабардар болуыңыз мүмкін...
Dialogue: 0,0:00:52.38,0:00:53.26,Default,,0,0,0,,біздің орнымыз ба?
Dialogue: 0,0:00:53.72,0:00:56.18,Default,,0,0,0,,Сіз кек алғыңыз келе ме...
Dialogue: 0,0:00:56.26,0:00:57.43,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:00:58.05,0:00:59.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:00.14,0:01:01.06,Default,,0,0,0,,Сегучи мырза
Dialogue: 0,0:01:01.14,0:01:02.22,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:01:02.31,0:01:05.27,Default,,0,0,0,,Сізді босатуыңыз үшін менің бір жақсылығым бар.
Dialogue: 0,0:01:05.35,0:01:07.06,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:07.65,0:01:10.40,Default,,0,0,0,,Мен сенің мысықтың көзіне түскеніңді қалаймын.
Dialogue: 0,0:01:10.82,0:01:12.94,Default,,0,0,0,,Не? мысық көзі?
Dialogue: 0,0:01:13.49,0:01:17.07,Default,,0,0,0,,Бұл біз назардан тыс қалдырмайтын нәрсе.
Dialogue: 0,0:01:17.86,0:01:20.03,Default,,0,0,0,,Ең сорақысы, өмір немесе өлім маңызды емес.
Dialogue: 0,0:01:20.45,0:01:23.75,Default,,0,0,0,,Бірақ тіпті полицейлер де қиналып жатыр.
Dialogue: 0,0:01:24.41,0:01:26.79,Default,,0,0,0,,Оны орындаудың көптеген жолдары бар.
Dialogue: 0,0:01:28.46,0:01:29.71,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:01:30.17,0:01:34.46,Default,,0,0,0,,Сондай-ақ, бізге қарап тұрған Мория Мория есімді арт-дилер болды.
Dialogue: 0,0:01:34.55,0:01:35.97,Default,,0,0,0,,Қазір Мияке Мияке деп аталады——
Dialogue: 0,0:01:36.05,0:01:38.89,Default,,0,0,0,,Мен сіздің мұражай иесі екеніңізді білдім.
Dialogue: 0,0:01:39.43,0:01:40.68,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:01:40.89,0:01:41.89,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:01:42.47,0:01:47.14,Default,,0,0,0,,Соны да жасаңыз, Сегучи мырза.
Dialogue: 0,0:01:48.48,0:01:50.48,Default,,0,0,0,,♪～
Dialogue: 0,0:03:15.15,0:03:17.15,Default,,0,0,0,,～♪
Dialogue: 0,0:03:25.24,0:03:27.87,Default,,0,0,0,,Мен сені күттім. Өтінемін, осында келіңіз.
Dialogue: 0,0:03:28.08,0:03:29.33,Default,,0,0,0,,Сәлем
Dialogue: 0,0:03:32.79,0:03:33.75,Default,,0,0,0,,Сен білмедің бе?
Dialogue: 0,0:03:41.47,0:03:43.09,Default,,0,0,0,,Сен маған қанша уақыт қарап тұрсың?
Dialogue: 0,0:03:43.18,0:03:46.30,Default,,0,0,0,,Өйткені мен ақыры әкемнің жүзін көрдім.
Dialogue: 0,0:03:46.39,0:03:47.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:47.85,0:03:49.56,Default,,0,0,0,,Мория-сан, мен осындамын.
Dialogue: 0,0:03:49.81,0:03:51.94,Default,,0,0,0,,Ах! Сәлем Мория-сан
Dialogue: 0,0:03:52.02,0:03:54.35,Default,,0,0,0,,О, сәлем Ай-сан.
Dialogue: 0,0:03:54.65,0:03:57.07,Default,,0,0,0,,Керемет сыйлық үшін рахмет.
Dialogue: 0,0:03:57.23,0:04:01.15,Default,,0,0,0,,Жоқ, бұл сізде болуы керек нәрсе.
Dialogue: 0,0:04:01.40,0:04:03.41,Default,,0,0,0,,Хитоми, перделерді жауып жібере аласыз ба?
Dialogue: 0,0:04:03.99,0:04:04.91,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:04:06.20,0:04:09.95,Default,,0,0,0,,Маған Cranuff Syndicate туралы айтып беріңізші.
Dialogue: 0,0:04:10.33,0:04:12.46,Default,,0,0,0,,Ал әкем туралы...
Dialogue: 0,0:04:13.75,0:04:14.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:15.75,0:04:17.09,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:17.67,0:04:20.88,Default,,0,0,0,,Ол әдетте бұрыннан ашық.
Dialogue: 0,0:04:21.67,0:04:23.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:26.85,0:04:27.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:29.68,0:04:31.35,Default,,0,0,0,,Ха... tsk...
Dialogue: 0,0:04:33.44,0:04:34.56,Default,,0,0,0,,Не?
Dialogue: 0,0:04:36.19,0:04:37.52,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:04:37.61,0:04:40.61,Default,,0,0,0,,Дүкен ашылғанша, тіпті Шун Тоши-чан~Раомен кездессеңіз де
Dialogue: 0,0:04:42.74,0:04:44.53,Default,,0,0,0,,15 жыл бұрын
Dialogue: 0,0:04:44.61,0:04:47.12,Default,,0,0,0,,Харада Харада мұражайындағы өрт оқиғасы туралы
Dialogue: 0,0:04:47.20,0:04:48.83,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:04:49.16,0:04:51.41,Default,,0,0,0,,Иә, мен оны ешқашан ұмытпаймын.
Dialogue: 0,0:04:52.41,0:04:55.29,Default,,0,0,0,,Әкемнің жұмыстары қойылады деп жоспарланған жерде өрт шықты.
Dialogue: 0,0:04:56.12,0:04:58.04,Default,,0,0,0,,Қатысқан әкем қатысты.
Dialogue: 0,0:04:58.13,0:05:00.63,Default,,0,0,0,,Маған сенің хабарсыз кеткенің хабарланды.
Dialogue: 0,0:05:01.17,0:05:03.26,Default,,0,0,0,,Өртті кім бастады?
Dialogue: 0,0:05:03.34,0:05:06.47,Default,,0,0,0,,Оның Cranuff Syndicate болу ықтималдығы жоғары.
Dialogue: 0,0:05:06.55,0:05:08.09,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:05:08.39,0:05:09.30,Default,,0,0,0,,Иә
Dialogue: 0,0:05:09.64,0:05:11.93,Default,,0,0,0,,Өрттен бірнеше күн бұрын
Dialogue: 0,0:05:12.02,0:05:14.73,Default,,0,0,0,,Мен Хайнц мырзаға бардым.
Dialogue: 0,0:05:17.44,0:05:18.90,Default,,0,0,0,,Бұл басқа әңгіме.
Dialogue: 0,0:05:19.40,0:05:21.23,Default,,0,0,0,,Мен сізге суретті бере алмаймын.
Dialogue: 0,0:05:21.65,0:05:23.94,Default,,0,0,0,,Көркем көрменің де жойылғанын қалаймын.
Dialogue: 0,0:05:24.15,0:05:26.07,Default,,0,0,0,,Шарттарды қабылдасаңыз
Dialogue: 0,0:05:26.15,0:05:28.62,Default,,0,0,0,,Мен екі еселенген соманы төлеуге дайынмын.
Dialogue: 0,0:05:28.70,0:05:30.58,Default,,0,0,0,,Бұл ақша туралы емес
Dialogue: 0,0:05:30.66,0:05:32.04,Default,,0,0,0,,Менің жұмысым
Dialogue: 0,0:05:32.12,0:05:34.45,Default,,0,0,0,,Сіз ақша табу үшін не қолданасыз?
Dialogue: 0,0:05:34.54,0:05:35.87,Default,,0,0,0,,Мен сенің тоқтауыңды қалаймын
Dialogue: 0,0:05:36.21,0:05:38.42,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:05:38.96,0:05:40.09,Default,,0,0,0,,Хайнц мырза
Dialogue: 0,0:05:40.17,0:05:43.38,Default,,0,0,0,,Менің ойымша, сенің бізбен араласқаның дұрыс болар еді.
Dialogue: 0,0:05:43.71,0:05:48.72,Default,,0,0,0,,Өзіңізді ғана емес, отбасыңыздың өмірін де қорғағыңыз келсе...
Dialogue: 0,0:05:49.34,0:05:50.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:50.64,0:05:51.60,Default,,0,0,0,,Ku...
Dialogue: 0,0:05:52.47,0:05:53.68,Default,,0,0,0,,Алу
Dialogue: 0,0:06:02.94,0:06:06.32,Default,,0,0,0,,Бірнеше күннен кейін сол өрт шықты.
Dialogue: 0,0:06:06.90,0:06:08.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:09.11,0:06:11.28,Default,,0,0,0,,Бұл жалғыз себеп емес
Dialogue: 0,0:06:11.37,0:06:13.70,Default,,0,0,0,,10 жылға жуық уақыттан кейін
Dialogue: 0,0:06:13.79,0:06:17.21,Default,,0,0,0,,Хайнц мырзаның барлық картиналары өртте жойылуы керек еді.
Dialogue: 0,0:06:17.41,0:06:21.21,Default,,0,0,0,,Қазір нарықта Cranuff атауымен қол жетімді
Dialogue: 0,0:06:21.50,0:06:23.84,Default,,0,0,0,,Дерек көзі ақылмен жасырылған, бірақ
Dialogue: 0,0:06:23.92,0:06:26.51,Default,,0,0,0,,Менің зерттеуім бойынша олардың барлығы
Dialogue: 0,0:06:26.59,0:06:28.76,Default,,0,0,0,,Cranuff Syndicate деп аталатын ұйымнан.
Dialogue: 0,0:06:28.84,0:06:31.18,Default,,0,0,0,,Мен сатылымда екенін білдім.
Dialogue: 0,0:06:31.64,0:06:34.18,Default,,0,0,0,,Крануфф синдикаты солай
Dialogue: 0,0:06:34.26,0:06:37.39,Default,,0,0,0,,Әкемнің суретін алайын деп от жақтым.
Dialogue: 0,0:06:37.48,0:06:41.23,Default,,0,0,0,,Егер сіз осылай ойласаңыз, бәрі мағынасы бар.
Dialogue: 0,0:06:41.31,0:06:42.31,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:06:42.94,0:06:45.19,Default,,0,0,0,,Әкем өртке қатысты...
Dialogue: 0,0:06:45.48,0:06:47.78,Default,,0,0,0,,Менің ойымша, бұл олардың мақсаты болды.
Dialogue: 0,0:06:48.36,0:06:51.45,Default,,0,0,0,,Хайнц тірі болғанда көптеген қолайсыздықтар болған болуы керек.
Dialogue: 0,0:06:51.87,0:06:54.12,Default,,0,0,0,,Бұл балалар ең нашар.
Dialogue: 0,0:06:54.33,0:06:55.87,Default,,0,0,0,,Сонда да, Мория-сан
Dialogue: 0,0:06:55.95,0:06:58.29,Default,,0,0,0,,Әкемнің тірі екенін айттыңыз.
Dialogue: 0,0:06:58.37,0:06:59.21,Default,,0,0,0,,Мақсат ақыл-есі бар сияқты,
Dialogue: 0,0:06:59.62,0:07:02.67,Default,,0,0,0,,Шын мәнінде, өрттен кейін бір айға жуық.
Dialogue: 0,0:07:03.00,0:07:06.88,Default,,0,0,0,,Портрет пен хат маған жіберілді.
Dialogue: 0,0:07:07.46,0:07:10.47,Default,,0,0,0,,Майкл Хайнцтан
Dialogue: 0,0:07:10.72,0:07:11.68,Default,,0,0,0,,Иә
Dialogue: 0,0:07:12.18,0:07:14.26,Default,,0,0,0,,Хат өз қолыңызбен жазылуы керек.
Dialogue: 0,0:07:14.35,0:07:17.56,Default,,0,0,0,,«Әйелің мен қыздарыңды сұра» деп жазылған.
Dialogue: 0,0:07:17.64,0:07:18.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:18.77,0:07:22.60,Default,,0,0,0,,Бірақ мен саған келгенде
Dialogue: 0,0:07:22.81,0:07:25.57,Default,,0,0,0,,Хайнц ханым қауіпті сезініп үлгерді.
Dialogue: 0,0:07:25.65,0:07:28.44,Default,,0,0,0,,Ол сендерді өзімен бірге алып, жоғалып кетті.
Dialogue: 0,0:07:29.36,0:07:32.57,Default,,0,0,0,,Содан бері 15 жыл бойы іздендім.
Dialogue: 0,0:07:32.66,0:07:35.12,Default,,0,0,0,,Мен оны таба алмадым.
Dialogue: 0,0:07:35.66,0:07:38.08,Default,,0,0,0,,Өйткені біз осылайша ғажайып кездесіп қалдық
Dialogue: 0,0:07:38.16,0:07:40.79,Default,,0,0,0,,Мен оған берген уәдемді қазір орындағым келеді.
Dialogue: 0,0:07:41.29,0:07:42.50,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:07:42.71,0:07:45.50,Default,,0,0,0,,Cat's Eye әрекеттерін қазір тоқтатыңыз.
Dialogue: 0,0:07:45.79,0:07:46.80,Default,,0,0,0,,На...
Dialogue: 0,0:07:47.42,0:07:49.01,Default,,0,0,0,,Крануфф синдикаты
Dialogue: 0,0:07:49.09,0:07:52.18,Default,,0,0,0,,Мақсатына жету үшін ештеңені тоқтатпайтын қауіпті ұйым.
Dialogue: 0,0:07:52.72,0:07:55.60,Default,,0,0,0,,Көркем шығармалардағы ақшаны жылыстату
Dialogue: 0,0:07:55.68,0:07:58.77,Default,,0,0,0,,Мафия сияқты астыртын ұйымдармен терең байланыс
Dialogue: 0,0:07:59.02,0:08:02.02,Default,,0,0,0,,Осы уақытқа дейін мен тек Хайнцтың суреттерін, тіпті мысықтың көзін ғана мақсат еттім.
Dialogue: 0,0:08:02.10,0:08:04.02,Default,,0,0,0,,Әрине, назар аудару керек.
Dialogue: 0,0:08:04.56,0:08:05.98,Default,,0,0,0,,Мен де
Dialogue: 0,0:08:06.06,0:08:08.86,Default,,0,0,0,,Крануфф синдикатының шынайы тұлғасын анықтау үшін...
Dialogue: 0,0:08:08.94,0:08:09.98,Default,,0,0,0,,(бұралған дыбыс)
Dialogue: 0,0:08:10.44,0:08:12.49,Default,,0,0,0,,Олардың нысанаға алынуы нәтижесінде...
Dialogue: 0,0:08:12.57,0:08:13.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:13.86,0:08:15.82,Default,,0,0,0,,Сол қолымнан айырылдым
Dialogue: 0,0:08:18.24,0:08:21.16,Default,,0,0,0,,Сондықтан бүркеншік есімді қолданамын.
Dialogue: 0,0:08:21.25,0:08:24.12,Default,,0,0,0,,Бұны бастан кешіргеніңізді қаламаймыз.
Dialogue: 0,0:08:24.21,0:08:25.25,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:08:25.33,0:08:26.84,Default,,0,0,0,,Мория-сан (Мория) Ах...
Dialogue: 0,0:08:27.17,0:08:29.75,Default,,0,0,0,,Мазалағаныңызға рахмет.
Dialogue: 0,0:08:30.00,0:08:30.84,Default,,0,0,0,,Тек...
Dialogue: 0,0:08:31.63,0:08:33.43,Default,,0,0,0,,Не болса да
Dialogue: 0,0:08:33.51,0:08:35.64,Default,,0,0,0,,Мен әкемнің барлық шығармаларын қайтарып аламын.
Dialogue: 0,0:08:36.18,0:08:37.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:37.39,0:08:39.35,Default,,0,0,0,,Хабарламаны жіберген адам да...
Dialogue: 0,0:08:39.85,0:08:43.10,Default,,0,0,0,,Әкем байқаған болар деп ойладым.
Dialogue: 0,0:08:43.18,0:08:45.06,Default,,0,0,0,,Біз үшін үш апа
Dialogue: 0,0:08:45.15,0:08:47.73,Default,,0,0,0,,Менің әкем шынымен де маңызды адам.
Dialogue: 0,0:08:47.81,0:08:50.61,Default,,0,0,0,,Сондықтан мен мысықтың көзін ойнауды тоқтата алмаймын.
Dialogue: 0,0:08:50.69,0:08:52.53,Default,,0,0,0,,Мен әкемді көргім келеді
Dialogue: 0,0:08:52.94,0:08:55.86,Default,,0,0,0,,Себебі мен кішкентаймын және ештеңе есімде жоқ.
Dialogue: 0,0:08:56.07,0:08:57.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:57.91,0:08:58.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:00.04,0:09:01.41,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:09:01.95,0:09:04.37,Default,,0,0,0,,Мен оны тоқтата алмайтын сияқтымын
Dialogue: 0,0:09:04.96,0:09:06.21,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:09:07.13,0:09:08.25,Default,,0,0,0,,Жай... (3 адам) Иә?
Dialogue: 0,0:09:08.88,0:09:12.96,Default,,0,0,0,,Cranuff Syndicate-тен сақ болыңыз.
Dialogue: 0,0:09:20.68,0:09:22.72,Default,,0,0,0,,Шун-чан Цяо~
Dialogue: 0,0:09:22.81,0:09:25.10,Default,,0,0,0,,Әй, Камия, не болды?
Dialogue: 0,0:09:25.19,0:09:27.35,Default,,0,0,0,,Кофехана әлі ашылған жоқ.
Dialogue: 0,0:09:27.44,0:09:30.90,Default,,0,0,0,,Менің ойымша, бұл жерде қандай да бір жаңалықтар бар ма?
Dialogue: 0,0:09:30.98,0:09:34.36,Default,,0,0,0,,Уақытты өлтіру үшін адамдарды пайдаланбаңыз.
Dialogue: 0,0:09:34.44,0:09:38.03,Default,,0,0,0,,Қараңызшы, Seguchi компаниясының президенті Сегучи қамауға алынуы керек еді.
Dialogue: 0,0:09:38.11,0:09:40.87,Default,,0,0,0,,Оқиғасыз босатылды.
Dialogue: 0,0:09:40.99,0:09:43.58,Default,,0,0,0,,Енді менің көз алдымда олай айтпа!
Dialogue: 0,0:09:43.66,0:09:44.75,Default,,0,0,0,,Менің кеудем өте нашар
Dialogue: 0,0:09:44.83,0:09:47.25,Default,,0,0,0,,Ой, бұл мина болды.
Dialogue: 0,0:09:47.46,0:09:48.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:49.04,0:09:50.21,Default,,0,0,0,,Ммм...
Dialogue: 0,0:09:51.25,0:09:52.13,Default,,0,0,0,,Цк
Dialogue: 0,0:09:53.67,0:09:55.92,Default,,0,0,0,,Иә? Бұл жігіт...
Dialogue: 0,0:09:56.67,0:09:58.18,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:58.43,0:10:01.39,Default,,0,0,0,,Мен кофехананың алдында көргенімдей...
Dialogue: 0,0:10:01.47,0:10:03.43,Default,,0,0,0,,бомбалаушы Кадзиура?
Dialogue: 0,0:10:03.89,0:10:05.56,Default,,0,0,0,,О, сен онда не істеп жүрсің?
Dialogue: 0,0:10:05.73,0:10:07.48,Default,,0,0,0,,Мен көліктің алдында қыдырдым.
Dialogue: 0,0:10:07.89,0:10:09.94,Default,,0,0,0,,Ха! Ку...
Dialogue: 0,0:10:10.02,0:10:11.65,Default,,0,0,0,,Әй
Dialogue: 0,0:10:12.73,0:10:13.98,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:10:14.40,0:10:15.36,Default,,0,0,0,,Ал енді, Арнайы сынып… жарайды—
Dialogue: 0,0:10:15.90,0:10:18.57,Default,,0,0,0,,Барлығыңыз сақ болыңыздар.
Dialogue: 0,0:10:18.78,0:10:20.91,Default,,0,0,0,,Тағы келіңізші, Морияның ағасы.
Dialogue: 0,0:10:21.20,0:10:22.91,Default,,0,0,0,,Күте тұрыңыз! барлығы!
Dialogue: 0,0:10:23.20,0:10:25.12,Default,,0,0,0,,Тосио? (Тосио) Тезірек көліктен кет!
Dialogue: 0,0:10:25.62,0:10:27.41,Default,,0,0,0,,Ахх (жарылыс дыбысы)
Dialogue: 0,0:10:27.50,0:10:29.92,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:10:33.92,0:10:36.30,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:10:36.92,0:10:37.80,Default,,0,0,0,,Мм...
Dialogue: 0,0:10:38.76,0:10:40.51,Default,,0,0,0,,Тосио, жақсысың ба?
Dialogue: 0,0:10:40.59,0:10:42.18,Default,,0,0,0,,Ой... жарайды...
Dialogue: 0,0:10:42.55,0:10:44.72,Default,,0,0,0,,Көздеріңіз ше? Мияке мырза ше?
Dialogue: 0,0:10:45.22,0:10:46.35,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:10:47.48,0:10:49.89,Default,,0,0,0,,Тосио... Тосио!
Dialogue: 0,0:10:50.40,0:10:51.77,Default,,0,0,0,,Тосио!
Dialogue: 0,0:11:01.24,0:11:02.82,Default,,0,0,0,,Хитоми... (оқушы) Ха
Dialogue: 0,0:11:03.74,0:11:04.78,Default,,0,0,0,,Амансың ба...
Dialogue: 0,0:11:05.12,0:11:06.12,Default,,0,0,0,,Тосио!
Dialogue: 0,0:11:07.25,0:11:09.75,Default,,0,0,0,,Жақсы... иә...
Dialogue: 0,0:11:10.33,0:11:13.21,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:11:17.76,0:11:18.84,Default,,0,0,0,,Тосио туралы не деуге болады?
Dialogue: 0,0:11:18.92,0:11:20.18,Default,,0,0,0,,Әзірше жақсы сияқты
Dialogue: 0,0:11:20.72,0:11:22.68,Default,,0,0,0,,Көп уайымдаудың қажеті жоқ.
Dialogue: 0,0:11:22.89,0:11:25.93,Default,,0,0,0,,Уцуми-санды араласқаным үшін кешіріңіз.
Dialogue: 0,0:11:26.01,0:11:27.81,Default,,0,0,0,,Мория-сан кешірім сұрайды...
Dialogue: 0,0:11:28.02,0:11:29.81,Default,,0,0,0,,Күтілгендей, бұл жарылыс та?
Dialogue: 0,0:11:30.10,0:11:33.15,Default,,0,0,0,,Иә, бұл Cranuff Syndicate болуы керек.
Dialogue: 0,0:11:33.44,0:11:36.73,Default,,0,0,0,,Мүмкін менің тұлғам ашылған шығар.
Dialogue: 0,0:11:37.03,0:11:38.74,Default,,0,0,0,,Кеше… Ах…
Dialogue: 0,0:11:39.24,0:11:40.11,Default,,0,0,0,,Иә
Dialogue: 0,0:11:46.66,0:11:51.00,Default,,0,0,0,,Бүгін бізге қосылғандарыңыз үшін барлығыңызға рахмет.
Dialogue: 0,0:11:51.29,0:11:55.04,Default,,0,0,0,,Дүние жүзінің ең үздік шедеврлері қойылған өнер көрмесі.
Dialogue: 0,0:11:55.29,0:11:58.00,Default,,0,0,0,,Сегучи мемориалдық мұражайындағы «Сегучи коллекциясы».
Dialogue: 0,0:11:58.09,0:12:00.84,Default,,0,0,0,,Ол кең көлемде өткізіледі.
Dialogue: 0,0:12:00.92,0:12:01.76,Default,,0,0,0,,О~
Dialogue: 0,0:12:02.13,0:12:03.76,Default,,0,0,0,,Бөлек болып табылады
Dialogue: 0,0:12:03.84,0:12:08.47,Default,,0,0,0,,Бұл жұмысты әлемге әйгілі суретші Жапонияда алғаш рет көрсетеді.
Dialogue: 0,0:12:09.27,0:12:11.39,Default,,0,0,0,,Крануффтың фантастикалық шедеврі
Dialogue: 0,0:12:10.18,0:12:13.31,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:12:11.48,0:12:12.89,Default,,0,0,0,,«Марс құдайы»
Dialogue: 0,0:12:12.98,0:12:14.98,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:12:15.61,0:12:16.52,Default,,0,0,0,,(Теледидарды өшіру дыбысы)
Dialogue: 0,0:12:18.15,0:12:19.61,Default,,0,0,0,,«Марс құдайы»
Dialogue: 0,0:12:19.90,0:12:21.11,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:21.19,0:12:25.07,Default,,0,0,0,,Иә, әкемнің суреті Харада өнер мұражайындағы өртте өртеніп кеткен дейді.
Dialogue: 0,0:12:25.16,0:12:25.99,Default,,0,0,0,,Ha
Dialogue: 0,0:12:26.78,0:12:29.41,Default,,0,0,0,,Осы уақытта осындай үлкен хабарландыру жасау.
Dialogue: 0,0:12:29.91,0:12:31.96,Default,,0,0,0,,Бізді толығымен арандатады.
Dialogue: 0,0:12:32.29,0:12:34.33,Default,,0,0,0,,А, мен ренжіп барамын!
Dialogue: 0,0:12:34.42,0:12:36.00,Default,,0,0,0,,«Марс құдайы» ғана емес
Dialogue: 0,0:12:36.08,0:12:38.21,Default,,0,0,0,,Мен бұл жігіттің барлық суреттерін ұрлағым келеді.
Dialogue: 0,0:12:38.29,0:12:40.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:40.92,0:12:42.05,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:12:42.13,0:12:43.26,Default,,0,0,0,,Бұл Мория.
Dialogue: 0,0:12:43.34,0:12:45.76,Default,,0,0,0,,Сегучидің баспасөз мәслихатын көрдіңіз бе?
Dialogue: 0,0:12:46.01,0:12:47.76,Default,,0,0,0,,Иә (Хитоми/Ай) Иә?
Dialogue: 0,0:12:48.22,0:12:50.39,Default,,0,0,0,,Менің саған айтар сөзім бар.
Dialogue: 0,0:12:54.14,0:12:55.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:55.14,0:12:56.85,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:12:57.19,0:12:58.56,Default,,0,0,0,,Келдің бе?
Dialogue: 0,0:12:58.98,0:13:01.48,Default,,0,0,0,,Бұл өте жақсы баспасөз конференциясы болды.
Dialogue: 0,0:13:02.11,0:13:05.74,Default,,0,0,0,,Мысықтың көзі міндетті түрде шығады.
Dialogue: 0,0:13:08.49,0:13:09.95,Default,,0,0,0,,Не істеу керек? Әпке
Dialogue: 0,0:13:10.58,0:13:12.37,Default,,0,0,0,,Сізде жауап бар, солай ма?
Dialogue: 0,0:13:12.79,0:13:14.29,Default,,0,0,0,,Иә, мұны істеуден басқа амалым жоқ.
Dialogue: 0,0:13:14.71,0:13:16.29,Default,,0,0,0,,Иә, міндетті түрде орындаймын!
Dialogue: 0,0:13:19.92,0:13:22.84,Default,,0,0,0,,Мен Сегучи мемориалдық залында өтетін орын боламын——
Dialogue: 0,0:13:22.92,0:13:26.18,Default,,0,0,0,,Мен көрме залы мен кіру жолының қауіпсіздік ақпаратын тексеремін.
Dialogue: 0,0:13:26.68,0:13:30.39,Default,,0,0,0,,Ай Сегучидің айналасында мүмкіндігінше көбірек ақпарат жинағаныңызды қалайды.
Dialogue: 0,0:13:30.97,0:13:32.93,Default,,0,0,0,,Әрине, қауіпті болмаса.
Dialogue: 0,0:13:33.43,0:13:34.39,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:13:34.73,0:13:35.69,Default,,0,0,0,,Осындай қатал жағдайларға қарамастан, барлығыңыз да жақсы өнер көрсеттіңіздер.
Dialogue: 0,0:13:35.98,0:13:38.94,Default,,0,0,0,,Хитоми Камия-санмен кездесе ме?
Dialogue: 0,0:13:39.19,0:13:41.07,Default,,0,0,0,,Не, тышқанмен?
Dialogue: 0,0:13:42.61,0:13:44.57,Default,,0,0,0,,Маған сенетініңізге сене алар емеспін...
Dialogue: 0,0:13:44.65,0:13:45.90,Default,,0,0,0,,Біз біраз дауластық
Dialogue: 0,0:13:46.45,0:13:48.28,Default,,0,0,0,,Бұл қымбат, бірақ жақсы ма?
Dialogue: 0,0:13:48.36,0:13:51.33,Default,,0,0,0,,Біз бұл туралы болашақта талқылаймыз.
Dialogue: 0,0:13:58.54,0:13:59.75,Default,,0,0,0,,Ах! иә?
Dialogue: 0,0:14:18.27,0:14:21.02,Default,,0,0,0,,Қылмыс жарияланған кезде сағат 11-ге таяп қалды.
Dialogue: 0,0:14:21.36,0:14:24.78,Default,,0,0,0,,Бірақ аға, шынымен де жараңыз жақсы ма?
Dialogue: 0,0:14:24.86,0:14:27.74,Default,,0,0,0,,Can you stay still in a hospital at a time like this?
Dialogue: 0,0:14:27.82,0:14:29.74,Default,,0,0,0,,Бұл... бұл... бұл...
Dialogue: 0,0:14:29.82,0:14:31.45,Default,,0,0,0,,It's better not to push yourself too hard...
Dialogue: 0,0:14:31.53,0:14:34.66,Default,,0,0,0,,Шулы! Жарайды! Itata...
Dialogue: 0,0:14:34.74,0:14:35.75,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:14:43.96,0:14:45.55,Default,,0,0,0,,Жарайды, олар байқамады.
Dialogue: 0,0:14:46.01,0:14:47.55,Default,,0,0,0,,Кеттік (Хитоми) Иә.
Dialogue: 0,0:14:51.30,0:14:53.97,Default,,0,0,0,,Compared to the outside, the inside is quite thin.
Dialogue: 0,0:15:00.31,0:15:01.94,Default,,0,0,0,,«Марс құдайы»
Dialogue: 0,0:15:02.40,0:15:04.82,Default,,0,0,0,,I can't believe it's so easy to get there
Dialogue: 0,0:15:08.74,0:15:10.28,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:15:10.99,0:15:12.24,Default,,0,0,0,,It's an exhibition room! (3-күзет) Асығыңыз!
Dialogue: 0,0:15:15.03,0:15:16.58,Default,,0,0,0,,А, күте тұрыңыз!
Dialogue: 0,0:15:17.25,0:15:18.33,Default,,0,0,0,,Мысықтың көзі!
Dialogue: 0,0:15:18.75,0:15:20.04,Default,,0,0,0,,Сыртта сақ болыңыз
Dialogue: 0,0:15:28.88,0:15:31.47,Default,,0,0,0,,Just as my sister expected, it was an easy victory.
Dialogue: 0,0:15:31.68,0:15:34.01,Default,,0,0,0,,I won't let up until I get home safely.
Dialogue: 0,0:15:34.97,0:15:36.56,Default,,0,0,0,,Мысықтың көзі қозғалды
Dialogue: 0,0:15:36.85,0:15:38.93,Default,,0,0,0,,Now comes the real deal.
Dialogue: 0,0:15:39.52,0:15:41.69,Default,,0,0,0,,Hunt down the dirty thief cat
Dialogue: 0,0:15:42.10,0:15:45.23,Default,,0,0,0,,Even if I inflict some damage, I will definitely catch him.
Dialogue: 0,0:15:46.90,0:15:48.36,Default,,0,0,0,,Әр көлікке айтыңыз
Dialogue: 0,0:15:48.44,0:15:51.07,Default,,0,0,0,,Cat's Eye is currently heading towards Roppongi Roppongi Dori.
Dialogue: 0,0:15:51.15,0:15:53.28,Default,,0,0,0,,Begin tracking each vehicle.
Dialogue: 0,0:15:53.36,0:15:54.45,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:16:01.16,0:16:01.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:04.46,0:16:06.00,Default,,0,0,0,,You came right away.
Dialogue: 0,0:16:06.29,0:16:07.42,Default,,0,0,0,,ұқсайды
Dialogue: 0,0:16:19.27,0:16:20.02,Default,,0,0,0,,Құт
Dialogue: 0,0:16:23.48,0:16:24.77,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:16:44.75,0:16:46.21,Default,,0,0,0,,Bad (sudden brake sound)
Dialogue: 0,0:16:47.17,0:16:48.21,Default,,0,0,0,,Coming behind you too
Dialogue: 0,0:16:51.38,0:16:53.47,Default,,0,0,0,,Huh... (Subordinate 6) Hmm...
Dialogue: 0,0:16:55.09,0:16:55.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:55.93,0:16:56.93,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:57.55,0:16:58.35,Default,,0,0,0,,Әпкенің көз жасы
Dialogue: 0,0:16:58.76,0:17:00.56,Default,,0,0,0,,Hold on tightly (tears) Huh?
Dialogue: 0,0:17:02.39,0:17:03.14,Default,,0,0,0,,Бұл… түс.
Dialogue: 0,0:17:03.77,0:17:04.77,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:17:07.61,0:17:08.77,Default,,0,0,0,,Біріншіден, аяқтарыңыздың астындағы қорапқа қараңыздар
Dialogue: 0,0:17:08.86,0:17:09.73,Default,,0,0,0,,Уф
Dialogue: 0,0:17:11.53,0:17:12.53,Default,,0,0,0,,Не! Уф
Dialogue: 0,0:17:18.78,0:17:19.78,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:17:21.74,0:17:23.45,Default,,0,0,0,,I missed the cat's eye.
Dialogue: 0,0:17:23.83,0:17:25.67,Default,,0,0,0,,Сіз не істеп жатырсыз? Қат!
Dialogue: 0,0:17:26.04,0:17:29.75,Default,,0,0,0,,Well, as long as we have this, they can't escape.
Dialogue: 0,0:17:30.38,0:17:32.26,Default,,0,0,0,,Көлікті түсіріңіз. (Бағыныңқы 2) Иә.
Dialogue: 0,0:17:32.59,0:17:33.97,Default,,0,0,0,,I'm going after him.
Dialogue: 0,0:17:34.05,0:17:35.22,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:17:41.64,0:17:43.31,Default,,0,0,0,,Жұмыстың басталуы
Dialogue: 0,0:17:43.89,0:17:45.18,Default,,0,0,0,,Бұл мысықтың көзі!
Dialogue: 0,0:17:45.27,0:17:47.60,Default,,0,0,0,,Stealing the “Goddess of Mars” from the Seguchi Memorial Museum——
Dialogue: 0,0:17:47.69,0:17:49.69,Default,,0,0,0,,Currently fleeing by car!
Dialogue: 0,0:17:49.94,0:17:52.86,Default,,0,0,0,,Look, I won't tell you where.
Dialogue: 0,0:17:52.94,0:17:55.28,Default,,0,0,0,,According to information from a police officer who was nearby.
Dialogue: 0,0:17:55.36,0:17:57.66,Default,,0,0,0,,He's heading west on the Koshu Highway!
Dialogue: 0,0:17:58.11,0:17:59.91,Default,,0,0,0,,Жақсы! Біз де шығамыз.
Dialogue: 0,0:18:00.16,0:18:01.24,Default,,0,0,0,,Иә! (Такеучи) Жарайды!
Dialogue: 0,0:18:01.99,0:18:04.87,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:18:07.16,0:18:08.25,Default,,0,0,0,,I found it!
Dialogue: 0,0:18:10.50,0:18:13.34,Default,,0,0,0,,Алдыңыздағы көлікті солға қарай тартып, тоқтаңыз.
Dialogue: 0,0:18:13.75,0:18:15.67,Default,,0,0,0,,Артымнан полиция келе жатыр.
Dialogue: 0,0:18:15.76,0:18:16.84,Default,,0,0,0,,Содан кейін олар жоғалады
Dialogue: 0,0:18:16.92,0:18:19.59,Default,,0,0,0,,Сіз бәрібір біздің машинаға тиісе алмайсыз.
Dialogue: 0,0:18:20.18,0:18:21.01,Default,,0,0,0,,Басқа екі машина——
Dialogue: 0,0:18:21.10,0:18:23.14,Default,,0,0,0,,Мен оны мысықтың көзінің алдынан айналдырдым.
Dialogue: 0,0:18:23.64,0:18:27.10,Default,,0,0,0,,Сіз енді қаша алмайсыз Мысық көзі
Dialogue: 0,0:18:30.35,0:18:32.90,Default,,0,0,0,,Қате бағытта жүгіру...соншалықты табанды.
Dialogue: 0,0:18:37.15,0:18:38.70,Default,,0,0,0,,Түсіруді маған қалдырыңыз (көз)
Dialogue: 0,0:18:41.70,0:18:42.62,Default,,0,0,0,,Мен ішке кіремін!
Dialogue: 0,0:18:42.91,0:18:44.24,Default,,0,0,0,,Тек итеруді жалғастырыңыз!
Dialogue: 0,0:18:47.41,0:18:48.41,Default,,0,0,0,,Бұл… түс.
Dialogue: 0,0:18:48.50,0:18:49.58,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:18:50.75,0:18:52.29,Default,,0,0,0,,Ха! Уф!
Dialogue: 0,0:18:53.50,0:18:56.38,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:18:59.13,0:19:00.09,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:19:02.01,0:19:04.10,Default,,0,0,0,,Кадзиура? (Асая) Не істейсің?
Dialogue: 0,0:19:04.18,0:19:05.77,Default,,0,0,0,,Оларды тірекке қалдырыңыз.
Dialogue: 0,0:19:06.10,0:19:08.39,Default,,0,0,0,,Біз Мысықтар мен Сегучидің көлігін қуамыз.
Dialogue: 0,0:19:14.48,0:19:15.32,Default,,0,0,0,,Бұл… түс.
Dialogue: 0,0:19:23.87,0:19:25.53,Default,,0,0,0,,Көлікті жақындатыңыз
Dialogue: 0,0:19:29.50,0:19:31.50,Default,,0,0,0,,Енді махаббат! Саған қалдырдым
Dialogue: 0,0:19:31.67,0:19:32.54,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:19:32.63,0:19:33.46,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:19:34.00,0:19:34.96,Default,,0,0,0,,(шинаның жарылған дыбысы)
Dialogue: 0,0:19:37.13,0:19:39.97,Default,,0,0,0,,Уау! Не? Эй! сен не істеп жатырсың
Dialogue: 0,0:19:40.05,0:19:42.64,Default,,0,0,0,,Менің доңғалағым жарылып қалды! Тежегіштер де жұмыс істемейді
Dialogue: 0,0:19:42.84,0:19:43.68,Default,,0,0,0,,Тұтқаны да...
Dialogue: 0,0:19:43.97,0:19:46.64,Default,,0,0,0,,Тоқта! (2-бағыныңқы) Бұл мүмкін емес!
Dialogue: 0,0:19:46.72,0:19:48.31,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:19:49.48,0:19:52.48,Default,,0,0,0,,Мен… біраз ойланып алайын.
Dialogue: 0,0:19:56.52,0:19:57.78,Default,,0,0,0,,nice love
Dialogue: 0,0:19:58.53,0:19:59.74,Default,,0,0,0,,It's decided!
Dialogue: 0,0:20:02.41,0:20:04.03,Default,,0,0,0,,Сәлем! Сен не істеп жатырсың!
Dialogue: 0,0:20:04.53,0:20:05.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:06.53,0:20:08.24,Default,,0,0,0,,What on earth...
Dialogue: 0,0:20:08.45,0:20:10.54,Default,,0,0,0,,Бұл менің жолым.
Dialogue: 0,0:20:11.08,0:20:13.33,Default,,0,0,0,,Иә? Бұл...
Dialogue: 0,0:20:13.58,0:20:14.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:15.38,0:20:18.25,Default,,0,0,0,,Менімен сөйлесуге біраз уақыт бөле аласыз ба?
Dialogue: 0,0:20:18.55,0:20:19.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:20.17,0:20:22.68,Default,,0,0,0,,Excuse me. Бірдеңе болды ма?
Dialogue: 0,0:20:23.13,0:20:24.14,Default,,0,0,0,,Kamiya?
Dialogue: 0,0:20:24.80,0:20:27.97,Default,,0,0,0,,Мен кездейсоқ өтіп бара жатып, апаттың куәсі болдым.
Dialogue: 0,0:20:28.06,0:20:29.72,Default,,0,0,0,,Камера айналады~
Dialogue: 0,0:20:30.52,0:20:32.56,Default,,0,0,0,,Иә? Ондағы адамдар Seguchi компаниясы...
Dialogue: 0,0:20:32.64,0:20:34.69,Default,,0,0,0,,Хироюки Хироюкимен танысқыңыз келе ме?
Dialogue: 0,0:20:34.94,0:20:36.15,Default,,0,0,0,,Сен қандайсың!
Dialogue: 0,0:20:36.44,0:20:39.36,Default,,0,0,0,,Е! gun? Is it real?
Dialogue: 0,0:20:37.23,0:20:39.36,Default,,0,0,0,,Yeah, a gun? иә?
Dialogue: 0,0:20:39.53,0:20:41.74,Default,,0,0,0,,Stop it! Рұқсатсыз көрсетпеңіз
Dialogue: 0,0:20:41.82,0:20:43.07,Default,,0,0,0,,Erase it now!
Dialogue: 0,0:20:43.24,0:20:45.53,Default,,0,0,0,,Жоқ, қазірдің өзінде кеш
Dialogue: 0,0:20:45.87,0:20:48.03,Default,,0,0,0,,Бұл тікелей трансляциялануда.
Dialogue: 0,0:20:48.41,0:20:51.83,Default,,0,0,0,,Ааа... не?
Dialogue: 0,0:20:56.38,0:20:58.42,Default,,0,0,0,,Мылтық та көрсетілген.
Dialogue: 0,0:20:58.50,0:21:01.05,Default,,0,0,0,,Егер бұл орын алса, ешқандай ақтау болмайды.
Dialogue: 0,0:21:01.38,0:21:04.26,Default,,0,0,0,,Ни-санның стратегиясы мінсіз болды.
Dialogue: 0,0:21:04.59,0:21:06.84,Default,,0,0,0,,Менімен байланысқан Мория-санға рахмет.
Dialogue: 0,0:21:07.80,0:21:10.97,Default,,0,0,0,,Сегучи жариялаған «Марс құдайы» жалған.
Dialogue: 0,0:21:11.06,0:21:11.89,Default,,0,0,0,,Е...
Dialogue: 0,0:21:12.27,0:21:14.98,Default,,0,0,0,,Богиняның динамизмі нақты нәрседен мүлдем басқаша.
Dialogue: 0,0:21:15.48,0:21:18.23,Default,,0,0,0,,Нақты нәрсені жақыннан көріп, түсіндім.
Dialogue: 0,0:21:18.44,0:21:22.69,Default,,0,0,0,,Сегучидің бұл туралы кеңінен жариялауының себебі...
Dialogue: 0,0:21:22.78,0:21:24.53,Default,,0,0,0,,Тұзақ болуы мүмкін
Dialogue: 0,0:21:24.61,0:21:26.20,Default,,0,0,0,,Мысықтың көзіне қарсы
Dialogue: 0,0:21:28.07,0:21:32.29,Default,,0,0,0,,Сондықтан мен картинада GPS орнатылған болуы мүмкін деп күдіктендім.
Dialogue: 0,0:21:32.75,0:21:34.50,Default,,0,0,0,,Бұл күні қауіпсіздік те әлсіз болды.
Dialogue: 0,0:21:34.58,0:21:36.71,Default,,0,0,0,,Себебі ол мені ұрлауға әдейі тырысты...
Dialogue: 0,0:21:36.79,0:21:38.04,Default,,0,0,0,,Сол кезде көзім жетті.
Dialogue: 0,0:21:38.38,0:21:40.21,Default,,0,0,0,,Сегучи тұтқынға түскендіктен
Dialogue: 0,0:21:40.29,0:21:42.17,Default,,0,0,0,,Крануфф синдикатының басқа мүшелері
Dialogue: 0,0:21:42.25,0:21:43.51,Default,,0,0,0,,Мен қамауға алынбаймын ба?
Dialogue: 0,0:21:43.92,0:21:47.76,Default,,0,0,0,,Егер бұл оңай қарсылас болса, мен қиналмас едім.
Dialogue: 0,0:21:48.09,0:21:51.39,Default,,0,0,0,,Иә... бұл нақты нәрсе болуы мүмкін.
Dialogue: 0,0:22:01.27,0:22:02.78,Default,,0,0,0,,Мысықтың көзі...
Dialogue: 0,0:22:05.03,0:22:06.82,Default,,0,0,0,,Хехе...
Dialogue: 0,0:22:11.37,0:22:13.37,Default,,0,0,0,,♪～
Dialogue: 0,0:23:37.95,0:23:39.96,Default,,0,0,0,,～♪
Dialogue: 0,0:23:41.46,0:23:47.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory