Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:20.81,0:00:24.35,Default,,0,0,0,,смокинг маскасы Көзіңізді ашыңыз!
Dialogue: 0,0:00:26.86,0:00:28.15,Default,,0,0,0,,Біреу...
Dialogue: 0,0:00:29.27,0:00:30.94,Default,,0,0,0,,Маған қоңырау шалу
Dialogue: 0,0:00:33.36,0:00:34.78,Default,,0,0,0,,Ұзын шаш…
Dialogue: 0,0:00:35.53,0:00:37.95,Default,,0,0,0,,Түсімде мені үнемі шақыратын адам...
Dialogue: 0,0:00:38.99,0:00:40.24,Default,,0,0,0,,Сіз бе?
Dialogue: 0,0:00:45.00,0:00:46.42,Default,,0,0,0,,Сейлор Мун!
Dialogue: 0,0:00:47.96,0:00:49.71,Default,,0,0,0,,Сіз қайғылы көрінесіз...
Dialogue: 0,0:00:49.84,0:00:51.00,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:00:51.13,0:00:52.84,Default,,0,0,0,,Неге жылайсың?
Dialogue: 0,0:00:54.01,0:00:57.64,Default,,0,0,0,,Иә, мұндай оқиға бұрын да болған...
Dialogue: 0,0:00:58.68,0:01:00.35,Default,,0,0,0,,Эндимион!
Dialogue: 0,0:01:01.56,0:01:03.81,Default,,0,0,0,,Эндимион!
Dialogue: 0,0:01:04.02,0:01:06.73,Default,,0,0,0,,Endymion Endymion!
Dialogue: 0,0:01:07.48,0:01:08.90,Default,,0,0,0,,«Эндимион»
Dialogue: 0,0:01:09.65,0:01:12.07,Default,,0,0,0,,Менің атым?
Dialogue: 0,0:01:13.32,0:01:19.32,Default,,0,0,0,,Ах... Мен осында Мамору Чиба болып қайта тудым.
Dialogue: 0,0:01:20.28,0:01:21.49,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:01:22.20,0:01:25.21,Default,,0,0,0,,Сізбен кездесу үшін
Dialogue: 0,0:01:27.50,0:01:30.08,Default,,0,0,0,,Серени...ти
Dialogue: 0,0:01:37.43,0:01:41.51,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:01:41.68,0:01:46.73,Default,,0,0,0,,♪〜
Dialogue: 0,0:03:04.26,0:03:10.27,Default,,0,0,0,,〜♪
Dialogue: 0,0:03:28.75,0:03:29.75,Default,,0,0,0,,Хмм…
Dialogue: 0,0:03:29.91,0:03:31.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:31.46,0:03:32.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:32.92,0:03:34.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:34.29,0:03:35.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:40.88,0:03:43.18,Default,,0,0,0,,Ааа... ааа...
Dialogue: 0,0:03:43.34,0:03:44.64,Default,,0,0,0,,Ахх...
Dialogue: 0,0:03:44.76,0:03:47.47,Default,,0,0,0,,Ах... Ах...
Dialogue: 0,0:03:47.60,0:03:50.23,Default,,0,0,0,,Ай!
Dialogue: 0,0:03:50.35,0:03:51.89,Default,,0,0,0,,(жылаған дауыс)
Dialogue: 0,0:03:52.06,0:03:52.89,Default,,0,0,0,,Сейлор Мун?
Dialogue: 0,0:03:53.06,0:03:56.81,Default,,0,0,0,,(жылаған дауыс)
Dialogue: 0,0:04:00.15,0:04:01.99,Default,,0,0,0,,Жарты ай белгісі?
Dialogue: 0,0:04:02.28,0:04:03.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:04.41,0:04:05.07,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:07.49,0:04:09.20,Default,,0,0,0,,Сейлор Мунның денесі...
Dialogue: 0,0:04:12.50,0:04:13.58,Default,,0,0,0,,Өзгерту...
Dialogue: 0,0:04:22.30,0:04:24.59,Default,,0,0,0,,Усаги...чан?
Dialogue: 0,0:04:35.40,0:04:36.56,Default,,0,0,0,,Бұл сурет...
Dialogue: 0,0:04:38.44,0:04:41.78,Default,,0,0,0,,Тыныштық ханшайымы
Dialogue: 0,0:04:50.12,0:04:53.41,Default,,0,0,0,,(Екінші қолдың дыбысы)
Dialogue: 0,0:04:53.58,0:04:55.00,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:55.79,0:05:00.21,Default,,0,0,0,,Тоқтаған сағат тілі артқа бұрылып жатыр...
Dialogue: 0,0:05:04.63,0:05:06.47,Default,,0,0,0,,Уақытты кері қайтару…
Dialogue: 0,0:05:07.76,0:05:10.47,Default,,0,0,0,,Өткенді еске түсіруді бастаңыз
Dialogue: 0,0:05:11.76,0:05:13.52,Default,,0,0,0,,Қайғылы өткен...
Dialogue: 0,0:05:15.23,0:05:16.85,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:05:17.02,0:05:18.44,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:05:19.02,0:05:20.19,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:05:21.73,0:05:23.36,Default,,0,0,0,,есіме түсті
Dialogue: 0,0:05:25.74,0:05:27.24,Default,,0,0,0,,Сіз туралы...
Dialogue: 0,0:05:29.53,0:05:31.53,Default,,0,0,0,,Қымбаттым...
Dialogue: 0,0:05:32.20,0:05:33.75,Default,,0,0,0,,Эндимион
Dialogue: 0,0:05:35.12,0:05:37.62,Default,,0,0,0,,Көгілдір түс, ол сізді тереңінен тартады...
Dialogue: 0,0:05:38.04,0:05:40.29,Default,,0,0,0,,Көзіңіздің түсі сияқты
Dialogue: 0,0:05:40.42,0:05:43.59,Default,,0,0,0,,Үміт мүмкіндігі бар көк жұлдыз
Dialogue: 0,0:05:44.51,0:05:47.43,Default,,0,0,0,,Және менің құпиям
Dialogue: 0,0:05:49.22,0:05:52.89,Default,,0,0,0,,Жердің бірінші ханзадасы Эндимион
Dialogue: 0,0:05:53.68,0:05:56.89,Default,,0,0,0,,Басқалардан күштірек, керемет адам...
Dialogue: 0,0:05:57.64,0:06:01.52,Default,,0,0,0,,Мен ол адамды көргім келгендіктен бұл планетаға талай рет қондым.
Dialogue: 0,0:06:02.36,0:06:03.52,Default,,0,0,0,,Және…
Dialogue: 0,0:06:05.15,0:06:06.28,Default,,0,0,0,,Бір күні...
Dialogue: 0,0:06:07.86,0:06:11.16,Default,,0,0,0,,Бір-бірімізді жақсы көре бастадық
Dialogue: 0,0:06:20.12,0:06:25.42,Default,,0,0,0,,Эндимион, біз енді ешқашан кездеспеуіміз керек.
Dialogue: 0,0:06:25.55,0:06:26.67,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:06:27.72,0:06:31.64,Default,,0,0,0,,Жер мен Айдың тұрғындары қарым-қатынас жасамауы керек.
Dialogue: 0,0:06:32.10,0:06:34.72,Default,,0,0,0,,Бұл Құдайдың заңы
Dialogue: 0,0:06:37.52,0:06:40.60,Default,,0,0,0,,Ғашық болма...
Dialogue: 0,0:06:43.19,0:06:44.36,Default,,0,0,0,,Ах! Құдай-ай!
Dialogue: 0,0:06:49.70,0:06:52.45,Default,,0,0,0,,Ай патшалығы біздікі болады!
Dialogue: 0,0:06:52.57,0:06:54.78,Default,,0,0,0,,Қолдарыңызға керемет күміс кристалды алыңыз!
Dialogue: 0,0:06:55.08,0:06:58.41,Default,,0,0,0,,Тоқта! Бұл пайдасыз күресті тоқтатыңыз!
Dialogue: 0,0:06:58.58,0:07:00.87,Default,,0,0,0,,Ханзада! Ол Жерге опасыздық жасай ма?
Dialogue: 0,0:07:01.46,0:07:03.42,Default,,0,0,0,,Сәлем! Ха…
Dialogue: 0,0:07:04.04,0:07:05.80,Default,,0,0,0,,Бұл сіз жасайсыз!
Dialogue: 0,0:07:05.96,0:07:06.80,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:07.30,0:07:10.38,Default,,0,0,0,,Ааа! Ха!?
Dialogue: 0,0:07:10.97,0:07:14.68,Default,,0,0,0,,Иә! Эндимион!
Dialogue: 0,0:07:15.93,0:07:18.85,Default,,0,0,0,,Жауап беріп, көзіңізді ашыңыз
Dialogue: 0,0:07:19.02,0:07:22.94,Default,,0,0,0,,Біз қайта туылып, ақыры кездессек те...
Dialogue: 0,0:07:23.69,0:07:25.15,Default,,0,0,0,,Бұл тағдыр ма?
Dialogue: 0,0:07:25.82,0:07:29.65,Default,,0,0,0,,Мен саған әлі өзім туралы ештеңе айтқан жоқпын.
Dialogue: 0,0:07:30.03,0:07:33.53,Default,,0,0,0,,Мен жақсы көретін жалғыз адам...
Dialogue: 0,0:07:34.45,0:07:36.70,Default,,0,0,0,,смокинг маскасы!
Dialogue: 0,0:07:36.83,0:07:38.83,Default,,0,0,0,,(жылаған дауыс)
Dialogue: 0,0:07:44.58,0:07:45.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:45.63,0:07:48.05,Default,,0,0,0,,Керемет! (Марс) Ғажайып күш!
Dialogue: 0,0:07:48.17,0:07:49.55,Default,,0,0,0,,Өте қолжетімсіз!
Dialogue: 0,0:07:49.92,0:07:53.18,Default,,0,0,0,,Усаги-чанның көз жасы кристалданып, жарқырап тұр!
Dialogue: 0,0:07:53.30,0:07:55.76,Default,,0,0,0,,Мен тура көрмеймін!
Dialogue: 0,0:07:55.89,0:07:58.51,Default,,0,0,0,,Сол күшті ақ жарық...
Dialogue: 0,0:07:58.97,0:08:00.93,Default,,0,0,0,,Сондай-ақ... мүмкін...
Dialogue: 0,0:08:01.56,0:08:04.98,Default,,0,0,0,,Мен мөрдің тез бұзылғанына сене алар емеспін...
Dialogue: 0,0:08:05.56,0:08:08.98,Default,,0,0,0,,Бұл елес күміс кристалл.
Dialogue: 0,0:08:22.71,0:08:26.67,Default,,0,0,0,,О... әдеттен тыс қуат...
Dialogue: 0,0:08:26.79,0:08:32.63,Default,,0,0,0,,Барған сайын күш келеді! Бұл шынымен де керемет күміс кристалл!
Dialogue: 0,0:08:32.88,0:08:36.51,Default,,0,0,0,,Ол ақырында пайда болды ма? Ха...
Dialogue: 0,0:08:43.89,0:08:45.77,Default,,0,0,0,,Елес күміс кристалдың жарығы...
Dialogue: 0,0:08:47.10,0:08:50.53,Default,,0,0,0,,Стокседо Масканың денесіне сорылған...
Dialogue: 0,0:08:55.24,0:08:57.78,Default,,0,0,0,,Жарық сөнді...
Dialogue: 0,0:09:00.62,0:09:01.83,Default,,0,0,0,,Королева Берил!
Dialogue: 0,0:09:02.25,0:09:03.96,Default,,0,0,0,,Қазір кунзит!
Dialogue: 0,0:09:04.08,0:09:05.75,Default,,0,0,0,,Менің қараңғы Патшалығым үшін—
Dialogue: 0,0:09:05.87,0:09:08.21,Default,,0,0,0,,Фантомдық күміс кристалды ұрлаңыз!
Dialogue: 0,0:09:08.46,0:09:10.67,Default,,0,0,0,,Хаха! Хааа!
Dialogue: 0,0:09:10.88,0:09:12.84,Default,,0,0,0,,Тоқта! Кунзит!
Dialogue: 0,0:09:13.30,0:09:15.30,Default,,0,0,0,,Сәлем! Бұл кептеліс!
Dialogue: 0,0:09:16.09,0:09:18.51,Default,,0,0,0,,Керемет найзағай!
Dialogue: 0,0:09:18.68,0:09:19.64,Default,,0,0,0,,Иә! Хмм!
Dialogue: 0,0:09:20.05,0:09:22.97,Default,,0,0,0,,Меркурий аквамист!
Dialogue: 0,0:09:23.22,0:09:24.10,Default,,0,0,0,,Ха... не?
Dialogue: 0,0:09:24.60,0:09:27.14,Default,,0,0,0,,Зұлым рухтарды қуыңыз!
Dialogue: 0,0:09:27.40,0:09:28.73,Default,,0,0,0,,Нуах!
Dialogue: 0,0:09:29.06,0:09:32.48,Default,,0,0,0,,Сәлем! Сіз ақымақ теңізші жауынгерлер!
Dialogue: 0,0:09:32.78,0:09:34.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:34.40,0:09:36.03,Default,,0,0,0,,және оларды туған жерім Италияның асханасына енгіздім.
Dialogue: 0,0:09:36.20,0:09:38.99,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:09:41.45,0:09:43.16,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:09:43.49,0:09:45.37,Default,,0,0,0,,Сейлор Мун, жақсысың ба?
Dialogue: 0,0:09:45.50,0:09:47.87,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:09:48.04,0:09:50.96,Default,,0,0,0,,Ха... Смокинг маскасы жоқ!
Dialogue: 0,0:09:51.25,0:09:52.80,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:09:52.92,0:09:54.17,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:54.30,0:09:55.51,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:09:56.55,0:09:58.22,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:09:59.09,0:10:02.05,Default,,0,0,0,,Хехехе... хехехехе...
Dialogue: 0,0:10:02.47,0:10:03.97,Default,,0,0,0,,Смокинг маскасы!
Dialogue: 0,0:10:04.56,0:10:05.81,Default,,0,0,0,,Мен көмектескім келеді, бірақ...
Dialogue: 0,0:10:05.93,0:10:08.73,Default,,0,0,0,,Шабуылды тоқтату үшін бар күшіңізді салыңыз!
Dialogue: 0,0:10:09.06,0:10:12.06,Default,,0,0,0,,Мен сізге елес күміс кристалды беремін.
Dialogue: 0,0:10:12.69,0:10:14.53,Default,,0,0,0,,Сейлор Мун қауіпті!
Dialogue: 0,0:10:14.65,0:10:15.53,Default,,0,0,0,,Жібер!
Dialogue: 0,0:10:15.69,0:10:19.16,Default,,0,0,0,,Менің енді сендерге пайдасы жоқ, иә...
Dialogue: 0,0:10:19.32,0:10:21.95,Default,,0,0,0,,Өзіңізбен бірге смокинг маскасын алмаңыз...
Dialogue: 0,0:10:22.12,0:10:23.91,Default,,0,0,0,,(Тыныштықтың айқайы)
Dialogue: 0,0:10:24.08,0:10:27.12,Default,,0,0,0,,Иә! Смокинг маскасы!
Dialogue: 0,0:10:28.75,0:10:30.37,Default,,0,0,0,,Барма!
Dialogue: 0,0:10:31.58,0:10:33.21,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:37.55,0:10:40.64,Default,,0,0,0,,Мамочан!
Dialogue: 0,0:11:03.20,0:11:08.62,Default,,0,0,0,,(Тыныштықтың айқайы)
Dialogue: 0,0:11:08.79,0:11:13.58,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:11:13.75,0:11:16.59,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:11:16.88,0:11:20.93,Default,,0,0,0,,Сейлор Мун... Тыныштық ханшайымы жоқ
Dialogue: 0,0:11:21.80,0:11:23.05,Default,,0,0,0,,Есіңе түсірдің.
Dialogue: 0,0:11:25.35,0:11:26.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:26.97,0:11:29.02,Default,,0,0,0,,I, Теңізші Венера —
Dialogue: 0,0:11:29.14,0:11:33.73,Default,,0,0,0,,Ол сонымен бірге ханшайымды қорғайтын қамқоршы жауынгерлердің нағыз көшбасшысы.
Dialogue: 0,0:11:34.40,0:11:38.32,Default,,0,0,0,,Сондай-ақ біздің патшалық, Күміс мыңжылдық туралы.
Dialogue: 0,0:11:40.95,0:11:42.53,Default,,0,0,0,,есіме түсті
Dialogue: 0,0:11:42.78,0:11:44.53,Default,,0,0,0,,Ханшайымның реинкарнациясы —
Dialogue: 0,0:11:44.66,0:11:46.95,Default,,0,0,0,,Минако-чан емес, Усаги-чан ба?
Dialogue: 0,0:11:47.54,0:11:50.29,Default,,0,0,0,,Барлығын алдағаным үшін кешірім сұраймын.
Dialogue: 0,0:11:50.41,0:11:54.33,Default,,0,0,0,,Бірақ бұл сонымен бірге ханшайым мен фантомдық күміс кристалды қорғау үшін.
Dialogue: 0,0:11:54.83,0:11:58.59,Default,,0,0,0,,Бәрін айт, өткенде не болды
Dialogue: 0,0:11:59.05,0:12:02.17,Default,,0,0,0,,Иә, сонау бұрынғы заманда.
Dialogue: 0,0:12:02.30,0:12:05.05,Default,,0,0,0,,Жер әлі бір ел болған кезде
Dialogue: 0,0:12:05.34,0:12:08.56,Default,,0,0,0,,Ал ай да патшалық болған кезде
Dialogue: 0,0:12:09.14,0:12:10.27,Default,,0,0,0,,Сіздің бұрынғы өміріңізде...
Dialogue: 0,0:12:10.39,0:12:14.48,Default,,0,0,0,,Ханшайымның қорғаушысы жауынгер ретінде ол әрқашан оның жанында қызмет етті.
Dialogue: 0,0:12:15.44,0:12:17.06,Default,,0,0,0,,Бірақ бір рет...
Dialogue: 0,0:12:17.23,0:12:18.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:18.32,0:12:20.94,Default,,0,0,0,,Жер сарбаздары Ай патшалығына шабуыл жасайды...
Dialogue: 0,0:12:22.11,0:12:23.32,Default,,0,0,0,,Мен көрдім...
Dialogue: 0,0:12:23.86,0:12:25.99,Default,,0,0,0,,Біздің бұрынғы өміріміз...
Dialogue: 0,0:12:26.66,0:12:29.95,Default,,0,0,0,,Біз ханшайымды қорғайтын жауынгер едік.
Dialogue: 0,0:12:30.83,0:12:35.42,Default,,0,0,0,,Ах, бірақ сен сансыз сарбаздармен шайқасып жатқанда...
Dialogue: 0,0:12:36.25,0:12:41.01,Default,,0,0,0,,Жердің ханзадасы Эндимион дауды қандай да бір жолмен шешуге тырысты.
Dialogue: 0,0:12:41.17,0:12:45.47,Default,,0,0,0,,Мен өз өмірімді жерлесімнің жүзінен жоғалттым.
Dialogue: 0,0:12:45.63,0:12:47.80,Default,,0,0,0,,Мүмкін смокинг маскасы...
Dialogue: 0,0:12:48.39,0:12:52.14,Default,,0,0,0,,Стокседо маскасы... Жоқ, Мамору Джиба...
Dialogue: 0,0:12:52.27,0:12:54.19,Default,,0,0,0,,Ол ханзада Эндимионның реинкарнациясы.
Dialogue: 0,0:12:54.60,0:12:56.10,Default,,0,0,0,,Ннн…
Dialogue: 0,0:12:58.06,0:12:59.86,Default,,0,0,0,,Жер бетіндегі адамдардың миын жуу
Dialogue: 0,0:12:59.98,0:13:04.57,Default,,0,0,0,,Ай патшалығының жойылуы осы зұлым нәрсенің жұмысы болды.
Dialogue: 0,0:13:04.70,0:13:08.62,Default,,0,0,0,,Амалсыз шайқасты, ол мөрмен жабылды.
Dialogue: 0,0:13:10.41,0:13:12.79,Default,,0,0,0,,Бір қайғылы оқиғаны қайталап жатқанымызға сене алар емеспін...
Dialogue: 0,0:13:12.91,0:13:15.96,Default,,0,0,0,,Неліктен бұл қайталануда...
Dialogue: 0,0:13:17.58,0:13:21.25,Default,,0,0,0,,Әлгі әйел оған мөр басты ма?
Dialogue: 0,0:13:21.59,0:13:25.55,Default,,0,0,0,,«Сол әйел» смокинг маскасын алып кеткен адамға қатысты ма?
Dialogue: 0,0:13:25.67,0:13:27.22,Default,,0,0,0,,Бұл адам кім?
Dialogue: 0,0:13:28.01,0:13:31.26,Default,,0,0,0,,Оны қайда апардың... Мамо-чан?
Dialogue: 0,0:13:31.47,0:13:33.35,Default,,0,0,0,,Эй, айтшы!
Dialogue: 0,0:13:33.85,0:13:36.35,Default,,0,0,0,,Ханшайым... сабыр етіңізші.
Dialogue: 0,0:13:36.73,0:13:38.98,Default,,0,0,0,,Мен ханшайым емеспін!
Dialogue: 0,0:13:39.10,0:13:43.78,Default,,0,0,0,,Усаги Цукино, қарапайым орта мектептің 2-ші курс қызы!
Dialogue: 0,0:13:44.78,0:13:46.90,Default,,0,0,0,,Мен жай ғана ғашық болғым келеді...
Dialogue: 0,0:13:47.78,0:13:49.07,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:50.41,0:13:53.54,Default,,0,0,0,,Мен жай ғана Мамо-чанмен бірге болғым келеді...
Dialogue: 0,0:13:59.88,0:14:01.71,Default,,0,0,0,,Әлі де сене алар емеспін
Dialogue: 0,0:14:02.25,0:14:06.84,Default,,0,0,0,,Менің көз жасым елес күміс кристалдың мөрін бұзуы мүмкін...
Dialogue: 0,0:14:07.05,0:14:09.39,Default,,0,0,0,,Жоқ. Мөрді бұзған адам —
Dialogue: 0,0:14:09.51,0:14:12.72,Default,,0,0,0,,Эндимионға деген күшті сезімдеріңіз
Dialogue: 0,0:14:13.43,0:14:14.56,Default,,0,0,0,,Эндимион…
Dialogue: 0,0:14:18.19,0:14:21.19,Default,,0,0,0,,Ха... Мамо... Чан...
Dialogue: 0,0:14:21.65,0:14:22.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:22.98,0:14:24.19,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:14:24.69,0:14:25.73,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:14:26.03,0:14:26.86,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:14:26.99,0:14:28.49,Default,,0,0,0,,Не болды? Не болды?
Dialogue: 0,0:14:28.61,0:14:30.32,Default,,0,0,0,,Мықты болыңыз! Сенімен бәрі жақсы ма?
Dialogue: 0,0:14:30.45,0:14:31.99,Default,,0,0,0,,Ханшайым! Ханшайым!
Dialogue: 0,0:14:36.54,0:14:39.83,Default,,0,0,0,,Сіз елес күміс кристалды таптыңыз ба?
Dialogue: 0,0:14:40.37,0:14:43.09,Default,,0,0,0,,Ол дененің барлық жерінде...
Dialogue: 0,0:14:43.21,0:14:44.59,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:14:44.71,0:14:48.80,Default,,0,0,0,,Сол кезде, шынында да, елес күміс кристалдан жарық шықты.
Dialogue: 0,0:14:48.97,0:14:51.30,Default,,0,0,0,,Денеге сорылған болуы керек
Dialogue: 0,0:14:52.97,0:14:55.31,Default,,0,0,0,,Иә, не болса да тап!
Dialogue: 0,0:14:55.43,0:14:57.31,Default,,0,0,0,,Оған дейін мені тірі қалдыр.
Dialogue: 0,0:14:57.43,0:14:58.56,Default,,0,0,0,,Хаха!
Dialogue: 0,0:15:08.53,0:15:11.28,Default,,0,0,0,,Мен бұл жігітті бір жерден көрдім...
Dialogue: 0,0:15:11.41,0:15:14.24,Default,,0,0,0,,Жадеит Сіз де?
Dialogue: 0,0:15:14.37,0:15:16.74,Default,,0,0,0,,Мен сені бұрыннан білгендей...
Dialogue: 0,0:15:17.49,0:15:19.00,Default,,0,0,0,,Ннн…
Dialogue: 0,0:15:20.83,0:15:22.17,Default,,0,0,0,,Эндимион!
Dialogue: 0,0:15:22.63,0:15:24.75,Default,,0,0,0,,Ха... Энди...
Dialogue: 0,0:15:25.09,0:15:26.21,Default,,0,0,0,,Ннн…
Dialogue: 0,0:15:26.63,0:15:28.88,Default,,0,0,0,,Не болды? Кунзит
Dialogue: 0,0:15:29.13,0:15:32.38,Default,,0,0,0,,Жоқ, мен бұл жігітті танымаймын.
Dialogue: 0,0:15:32.51,0:15:35.26,Default,,0,0,0,,Ұлы билеушіге ұсынамыз—
Dialogue: 0,0:15:35.39,0:15:38.64,Default,,0,0,0,,Сізге фантом күміс кристалы туралы ойлансаңыз болғаны!
Dialogue: 0,0:15:41.85,0:15:42.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:43.85,0:15:45.06,Default,,0,0,0,,Ннн…
Dialogue: 0,0:15:48.86,0:15:52.95,Default,,0,0,0,,Күмістің елес кристалы жоқ дененің пайдасы жоқ.
Dialogue: 0,0:15:53.07,0:15:56.03,Default,,0,0,0,,Жақсы! Ааа!
Dialogue: 0,0:15:56.16,0:15:57.66,Default,,0,0,0,,Ай!
Dialogue: 0,0:15:58.12,0:15:59.50,Default,,0,0,0,,Ха!? Ха...
Dialogue: 0,0:16:02.25,0:16:07.80,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:16:08.75,0:16:13.88,Default,,0,0,0,,Сіз қанша рет осылай жылап ояндыңыз?
Dialogue: 0,0:16:14.34,0:16:19.39,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:16:19.56,0:16:23.44,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:16:29.57,0:16:31.24,Default,,0,0,0,,Артемида екеуміз...
Dialogue: 0,0:16:31.36,0:16:35.91,Default,,0,0,0,,Ай патшалығының жоғалуымен мен ұзақ ұйқыға кеттім.
Dialogue: 0,0:16:37.20,0:16:38.53,Default,,0,0,0,,Ақыры мен ояндым...
Dialogue: 0,0:16:39.99,0:16:41.41,Default,,0,0,0,,Мен сені кездестірдім
Dialogue: 0,0:16:42.87,0:16:47.58,Default,,0,0,0,,Бірақ мен сене алмадым, мен сені жаман сезіндім.
Dialogue: 0,0:16:49.29,0:16:51.80,Default,,0,0,0,,Менде Усаги-чанға ұқсайтын бет жоқ.
Dialogue: 0,0:16:55.01,0:16:58.43,Default,,0,0,0,,Луна, қоянға барайық.
Dialogue: 0,0:16:58.85,0:17:02.85,Default,,0,0,0,,Бірақ... біз өз шегімізге жақындадық.
Dialogue: 0,0:17:02.98,0:17:04.98,Default,,0,0,0,,Мен Усаги-чанның күлкісін көруім керек...
Dialogue: 0,0:17:05.19,0:17:08.15,Default,,0,0,0,,Әйтеуір, өзімізді де жақсы сезінбейміз.
Dialogue: 0,0:17:08.27,0:17:09.98,Default,,0,0,0,,Луна да, солай ма?
Dialogue: 0,0:17:10.40,0:17:13.53,Default,,0,0,0,,Ммм... Иә.
Dialogue: 0,0:17:16.49,0:17:18.78,Default,,0,0,0,,Хэхе... Иә.
Dialogue: 0,0:17:19.95,0:17:22.24,Default,,0,0,0,,Хэхе... Иә.
Dialogue: 0,0:17:24.04,0:17:27.25,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:17:27.37,0:17:28.83,Default,,0,0,0,,Келіңіз.
Dialogue: 0,0:17:29.25,0:17:32.38,Default,,0,0,0,,Апай, Усаги ше?
Dialogue: 0,0:17:32.50,0:17:36.72,Default,,0,0,0,,Бұл...ол ешқашан бөлмесінен шықпайды.
Dialogue: 0,0:17:38.14,0:17:40.10,Default,,0,0,0,,Усаги-чан, жақсысың ба?
Dialogue: 0,0:17:40.22,0:17:41.76,Default,,0,0,0,,Бұл менмін, Луна!
Dialogue: 0,0:17:42.01,0:17:45.52,Default,,0,0,0,,Барлығы келе ме, Усаги-чан?
Dialogue: 0,0:17:45.68,0:17:47.77,Default,,0,0,0,,Жарайсың ба? Мен оны ашамын
Dialogue: 0,0:17:48.94,0:17:50.02,Default,,0,0,0,,Иә...
Dialogue: 0,0:17:52.27,0:17:53.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:53.32,0:17:54.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:55.28,0:17:57.78,Default,,0,0,0,,Луна... Барлығы...
Dialogue: 0,0:17:58.91,0:18:01.78,Default,,0,0,0,,Қоян! Сол шаш...
Dialogue: 0,0:18:09.88,0:18:11.67,Default,,0,0,0,,Мен оны аздап кесіп тастадым.
Dialogue: 0,0:18:12.00,0:18:15.59,Default,,0,0,0,,Оданго, мүмкін тағы бір орам.
Dialogue: 0,0:18:15.96,0:18:18.93,Default,,0,0,0,,Қалай ойлайсың, Усаги-чан? Иә...
Dialogue: 0,0:18:19.30,0:18:21.68,Default,,0,0,0,,Бұл ұзындық, солай ма?
Dialogue: 0,0:18:22.10,0:18:24.22,Default,,0,0,0,,Шашыңыз қашан ұзартылды?
Dialogue: 0,0:18:24.35,0:18:27.27,Default,,0,0,0,,Содан бері ол өсе берді...
Dialogue: 0,0:18:27.73,0:18:31.11,Default,,0,0,0,,Мен ханшайым болған кезде өте ұзақ уақыт болды.
Dialogue: 0,0:18:31.23,0:18:35.69,Default,,0,0,0,,Менің есте сақтау қабілетім тез қалпына келгендіктен, денем де өзгерді.
Dialogue: 0,0:18:36.19,0:18:39.74,Default,,0,0,0,,Өзгерту? Сіз ханшайым болғыңыз келе ме?
Dialogue: 0,0:18:40.36,0:18:44.66,Default,,0,0,0,,Мен енді мен емес сияқтымын.
Dialogue: 0,0:18:44.87,0:18:47.00,Default,,0,0,0,,Усаги-чан, күміс кристалл ше?
Dialogue: 0,0:18:47.12,0:18:47.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:48.37,0:18:50.37,Default,,0,0,0,,Ол енді жарқырамайды
Dialogue: 0,0:18:50.50,0:18:53.71,Default,,0,0,0,,Осылай қарасаң, ол жай ғана шыны шарға ұқсайды.
Dialogue: 0,0:18:54.71,0:18:58.47,Default,,0,0,0,,Ол кезде жарқырап тұрғанымен...
Dialogue: 0,0:18:58.88,0:18:59.88,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:19:01.93,0:19:06.60,Default,,0,0,0,,Ха... Стокседо маскасы, қазір қайдасың? сен қайдасың?
Dialogue: 0,0:19:06.72,0:19:07.39,Default,,0,0,0,,Усаги-чан?
Dialogue: 0,0:19:07.93,0:19:11.56,Default,,0,0,0,,Асықпасақ... ол кісінің денесі...
Dialogue: 0,0:19:12.15,0:19:14.27,Default,,0,0,0,,Маған ұнамайды... Мамо-чан...
Dialogue: 0,0:19:14.44,0:19:16.57,Default,,0,0,0,,Қоян! Мықты болыңыз
Dialogue: 0,0:19:16.73,0:19:18.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:18.32,0:19:21.03,Default,,0,0,0,,Капитан Диетфрид Бугенвилья, Корольдік флот
Dialogue: 0,0:19:21.74,0:19:23.32,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:19:23.49,0:19:25.78,Default,,0,0,0,,Усаги-чан, мықты бол!
Dialogue: 0,0:19:25.91,0:19:29.54,Default,,0,0,0,,Сен мықты болуың керек, мұны мұндағылардың бәрі біледі.
Dialogue: 0,0:19:30.83,0:19:34.25,Default,,0,0,0,,Мен... күштімін бе?
Dialogue: 0,0:19:34.46,0:19:36.17,Default,,0,0,0,,Серенити ханшайымы —
Dialogue: 0,0:19:36.30,0:19:38.67,Default,,0,0,0,,Әрқашан жұмсақ және күшті күлімсіреумен—
Dialogue: 0,0:19:38.80,0:19:41.05,Default,,0,0,0,,Сіз бізді орап тастадыңыз.
Dialogue: 0,0:19:41.55,0:19:43.09,Default,,0,0,0,,Усаги-чан да...
Dialogue: 0,0:19:43.76,0:19:46.01,Default,,0,0,0,,Бірақ мен ханшайым емеспін!
Dialogue: 0,0:19:46.14,0:19:47.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:48.39,0:19:50.31,Default,,0,0,0,,Сіз басқасыз
Dialogue: 0,0:19:50.73,0:19:53.90,Default,,0,0,0,,Дәл осындай тағдырды көрудің қажеті жоқ.
Dialogue: 0,0:19:54.02,0:19:55.98,Default,,0,0,0,,Мен қайта туылған болуым керек.
Dialogue: 0,0:19:56.11,0:19:57.15,Default,,0,0,0,,Мағынасы болуы керек
Dialogue: 0,0:19:57.77,0:20:00.19,Default,,0,0,0,,Өткен өмірімде орындай алмаған сезімдерім
Dialogue: 0,0:20:00.32,0:20:01.90,Default,,0,0,0,,Біз оны жүзеге асыра аламыз
Dialogue: 0,0:20:02.40,0:20:04.78,Default,,0,0,0,,Бұған барлығы дайын.
Dialogue: 0,0:20:07.28,0:20:08.62,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:20:09.20,0:20:12.58,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:12.75,0:20:14.54,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:14.67,0:20:15.88,Default,,0,0,0,,Қоян!
Dialogue: 0,0:20:16.00,0:20:17.54,Default,,0,0,0,,(Қоян жылайды)
Dialogue: 0,0:20:18.00,0:20:22.22,Default,,0,0,0,,Рахмет... Барлығыңызға рахмет
Dialogue: 0,0:20:22.34,0:20:27.18,Default,,0,0,0,,Бірақ мен... не істерімді білмеймін.
Dialogue: 0,0:20:27.85,0:20:28.89,Default,,0,0,0,,Айға барайық
Dialogue: 0,0:20:29.51,0:20:30.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:32.94,0:20:37.23,Default,,0,0,0,,Қараңғы патшалық пен фантом күміс кристалының орны...
Dialogue: 0,0:20:37.36,0:20:39.57,Default,,0,0,0,,Ал зұлым жау туралы —
Dialogue: 0,0:20:39.94,0:20:43.61,Default,,0,0,0,,Барлық жұмбақтарды шешудің кілті айда болуы керек.
Dialogue: 0,0:20:43.74,0:20:44.40,Default,,0,0,0,,Ай?
Dialogue: 0,0:20:46.03,0:20:47.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:55.29,0:20:59.71,Default,,0,0,0,,Күміс мыңжылдық болған біздің Патшалық...
Dialogue: 0,0:21:02.30,0:21:04.05,Default,,0,0,0,,Мен бақытты болдым
Dialogue: 0,0:21:05.63,0:21:08.05,Default,,0,0,0,,Маңызды достардың қоршауында...
Dialogue: 0,0:21:09.14,0:21:10.35,Default,,0,0,0,,Және…
Dialogue: 0,0:21:11.56,0:21:13.98,Default,,0,0,0,,Мен шынайы махаббатты таптым
Dialogue: 0,0:21:15.44,0:21:18.98,Default,,0,0,0,,Менің барлық асыл қазыналарым
Dialogue: 0,0:21:20.32,0:21:24.44,Default,,0,0,0,,Мен ешкімнің сол бақытты қайта құртқанын қаламаймын.
Dialogue: 0,0:21:39.88,0:21:42.13,Default,,0,0,0,,Мен қазірдің өзінде трагедиядамын...
Dialogue: 0,0:21:42.21,0:21:43.80,Default,,0,0,0,,Мен ханшайым болмаймын!
Dialogue: 0,0:21:45.51,0:21:47.43,Default,,0,0,0,,Айға барайық!
Dialogue: 0,0:21:48.30,0:21:50.72,Default,,0,0,0,,Барлық құпияларды білу үшін!
Dialogue: 0,0:21:50.85,0:21:51.85,Default,,0,0,0,,Иә
Dialogue: 0,0:22:21.00,0:22:27.01,Default,,0,0,0,,♪〜
Dialogue: 0,0:23:43.67,0:23:49.67,Default,,0,0,0,,〜♪
Dialogue: 0,0:23:52.97,0:23:56.30,Default,,0,0,0,,Бұл ай ма? Тым қараңғы
Dialogue: 0,0:23:56.47,0:23:59.47,Default,,0,0,0,,Дыбыс мүлде жоқ... Біртүрлі сезіледі.
Dialogue: 0,0:23:59.64,0:24:01.35,Default,,0,0,0,,Бұл ненің қирауы?
Dialogue: 0,0:24:01.60,0:24:06.11,Default,,0,0,0,,Бұл біздің патшалығымыз болған Күміс мыңжылдық.
Dialogue: 0,0:24:06.69,0:24:10.40,Default,,0,0,0,,А... сен кімсің?
Dialogue: 0,0:24:14.82,0:24:16.53,Default,,0,0,0,,Ай сәулесі - махаббат хабары
Dialogue: 0,0:24:18.03,0:24:24.03,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
