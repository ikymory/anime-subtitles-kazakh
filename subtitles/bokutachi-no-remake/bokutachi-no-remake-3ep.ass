Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:03.00,Default,,0,0,0,,- Бейнеде -
Dialogue: 0,0:00:03.00,0:00:05.00,Default,,0,0,0,,- Бейнеде -
Dialogue: 0,0:00:05.00,0:00:08.00,Default,,0,0,0,,Ах~ Көрсетілім уақыты келді~
Dialogue: 0,0:00:08.00,0:00:11.00,Default,,0,0,0,,Қызық, біздің видео қандай көрінеді?
Dialogue: 0,0:00:11.00,0:00:12.00,Default,,0,0,0,,Сәл уайымдадым
Dialogue: 0,0:00:12.00,0:00:15.00,Default,,0,0,0,,Кешіріңіз, өңдеуді соңғы мерзімге жетпей аяқтадым.
Dialogue: 0,0:00:15.00,0:00:17.00,Default,,0,0,0,,Сіз оны қарап шығуға уақытыңыз болмады, солай ма?
Dialogue: 0,0:00:17.00,0:00:18.00,Default,,0,0,0,,Жарайды, осы барлық жанама дәлелдер үйіліп жатқанда, менде оны мойындаудан басқа амал қалмады деп ойлаймын.
Dialogue: 0,0:00:18.00,0:00:21.00,Default,,0,0,0,,Осы уақытқа дейін жетсең, мен Киояға сенемін.
Dialogue: 0,0:00:21.00,0:00:23.00,Default,,0,0,0,,Дұрыс, егер Кёя болмаса.
Dialogue: 0,0:00:23.00,0:00:26.00,Default,,0,0,0,,Мен тоқтай алмаған шығармын.
Dialogue: 0,0:00:26.00,0:00:28.00,Default,,0,0,0,,Иә! Жақсы болатынына сенімдімін!
Dialogue: 0,0:00:28.00,0:00:31.00,Default,,0,0,0,,Иә, назар аударыңыз!
Dialogue: 0,0:00:31.00,0:00:36.00,Default,,0,0,0,,Енді біз 1-кешенді оқытудың аяқталуын скрининг өткіземіз.
Dialogue: 0,0:00:36.00,0:00:41.00,Default,,0,0,0,,Өздеріңіз білетіндей, бұл скрининг сабақ аясында өтеді.
Dialogue: 0,0:00:41.00,0:00:44.00,Default,,0,0,0,,Шығармаға айналғаннан кейін,
Dialogue: 0,0:00:44.00,0:00:48.00,Default,,0,0,0,,Сіз әрқашан аудитория тарапынан бағалануға дайын болуыңыз керек.
Dialogue: 0,0:00:48.00,0:00:52.00,Default,,0,0,0,,Міне, біз де жаратушымыз
Dialogue: 0,0:00:52.00,0:00:54.00,Default,,0,0,0,,Қатты аудитория
Dialogue: 0,0:00:54.00,0:00:55.00,Default,,0,0,0,,Күлкілі болса, күліңіз
Dialogue: 0,0:00:55.00,0:00:57.00,Default,,0,0,0,,Қол соғуларыңызға болады.
Dialogue: 0,0:00:57.00,0:01:01.00,Default,,0,0,0,,, бірақ керісінше де дұрыс
Dialogue: 0,0:01:01.00,0:01:04.00,Default,,0,0,0,,Құрбым жасағандықтан, Еңбек еткендіктен
Dialogue: 0,0:01:04.00,0:01:06.00,Default,,0,0,0,,Мұндай ақымақ эмоциялардың қажеті жоқ.
Dialogue: 0,0:01:06.00,0:01:11.00,Default,,0,0,0,,Мен кино бөлімінің студенті ретінде шынайы жауап күтемін.
Dialogue: 0,0:01:11.00,0:01:14.00,Default,,0,0,0,,Басқаша айтқанда, қызық болмаса, әрекет етпеңіз.
Dialogue: 0,0:01:14.00,0:01:17.00,Default,,0,0,0,,Зал тынышталып, аяқталды.
Dialogue: 0,0:01:17.00,0:01:19.50,Default,,0,0,0,,Хашиба
Dialogue: 0,0:01:17.00,0:01:18.00,Default,,0,0,0,,О
Dialogue: 0,0:01:21.00,0:01:23.00,Default,,0,0,0,,Мен жеңілмеймін
Dialogue: 0,0:01:23.00,0:01:25.50,Default,,0,0,0,,О
Dialogue: 0,0:01:27.00,0:01:30.00,Default,,0,0,0,,Енді скринингті бастайық.
Dialogue: 0,0:01:57.00,0:02:01.00,Default,,0,0,0,,Кез келген адам
Dialogue: 0,0:02:01.00,0:02:07.00,Default,,0,0,0,,Білесің бе, уақыт кері қайтпайды.
Dialogue: 0,0:02:07.00,0:02:12.00,Default,,0,0,0,,Көз алдыңызда не көріп тұрсыз
Dialogue: 0,0:02:12.00,0:02:17.00,Default,,0,0,0,,Болашақ бұлыңғыр.
Dialogue: 0,0:02:17.00,0:02:22.00,Default,,0,0,0,,Сіз шынымен кіммен кездескіңіз келеді?
Dialogue: 0,0:02:22.00,0:02:25.00,Default,,0,0,0,,Жолдың арғы жағында
Dialogue: 0,0:02:25.00,0:02:28.00,Default,,0,0,0,,Сол күні сені қуып келе жатырмын
Dialogue: 0,0:02:29.00,0:02:31.00,Default,,0,0,0,,шықты
Dialogue: 0,0:02:31.00,0:02:38.00,Default,,0,0,0,,Бұдан былай әнге айналмайтын әңгімелер
Dialogue: 0,0:02:39.00,0:02:42.00,Default,,0,0,0,,Мен не болып жатқанын айта алмаймын
Dialogue: 0,0:02:42.00,0:02:44.00,Default,,0,0,0,,Әлі жоқ
Dialogue: 0,0:02:45.00,0:02:49.00,Default,,0,0,0,,Бұл жауап іздейтін уақыт емес.
Dialogue: 0,0:02:49.00,0:02:54.00,Default,,0,0,0,,Мен енді сөйлей алмаймын.
Dialogue: 0,0:02:54.00,0:03:00.00,Default,,0,0,0,,Тек тілектеріңізді есте сақтаңыз
Dialogue: 0,0:03:24.00,0:03:26.00,Default,,0,0,0,,Шынымды айтсам, деңгейлер тым әртүрлі
Dialogue: 0,0:03:26.00,0:03:29.00,Default,,0,0,0,,Келесі команда Китайаманың жұмысы
Dialogue: 0,0:03:29.00,0:03:31.00,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:03:31.00,0:03:32.00,Default,,0,0,0,,Біздің сахна да станция
Dialogue: 0,0:03:32.00,0:03:35.00,Default,,0,0,0,,Мені салыстыра ма деп ойлаймын
Dialogue: 0,0:03:35.00,0:03:37.00,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:03:37.00,0:03:38.00,Default,,0,0,0,,Сонымен
Dialogue: 0,0:03:39.00,0:03:40.00,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:03:54.00,0:03:55.00,Default,,0,0,0,,Фотосурет?
Dialogue: 0,0:03:55.00,0:03:57.00,Default,,0,0,0,,Қозғалмайтын сурет бар ма?
Dialogue: 0,0:03:57.00,0:03:59.00,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:04:05.00,0:04:09.00,Default,,0,0,0,,Менің ойыма сол кездегі жалғыз жол осы еді.
Dialogue: 0,0:04:12.00,0:04:14.00,Default,,0,0,0,,Мен міндетті түрде бірдеңе істеймін
Dialogue: 0,0:04:14.00,0:04:16.00,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:04:16.00,0:04:18.00,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:04:19.00,0:04:21.00,Default,,0,0,0,,Мен міндетті түрде бірдеңе істеймін
Dialogue: 0,0:04:21.00,0:04:23.00,Default,,0,0,0,,Не болды, Норино-кун?
Dialogue: 0,0:04:23.00,0:04:25.00,Default,,0,0,0,,Мен бірдеңе істеймін
Dialogue: 0,0:04:25.00,0:04:27.00,Default,,0,0,0,,Мен қателескендіктен айта алмаймын.
Dialogue: 0,0:04:27.00,0:04:30.00,Default,,0,0,0,,Бұл жабдықпен не істеуім керек?
Dialogue: 0,0:04:30.00,0:04:33.00,Default,,0,0,0,,Біз түсіретініміз - фотосуреттер емес, бейне.
Dialogue: 0,0:04:33.00,0:04:35.00,Default,,0,0,0,,Жоқ, мен аламын.
Dialogue: 0,0:04:35.00,0:04:37.00,Default,,0,0,0,,Бұлай бейқам болма, беріл.
Dialogue: 0,0:04:37.00,0:04:39.00,Default,,0,0,0,,Қайта құрып, келесі кестені бастайық.
Dialogue: 0,0:04:39.00,0:04:41.00,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:04:41.00,0:04:43.00,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:04:43.00,0:04:44.00,Default,,0,0,0,,Маған сеніңіз
Dialogue: 0,0:04:44.00,0:04:46.00,Default,,0,0,0,,үшінның қажырлы еңбегі үшін рахмет
Dialogue: 0,0:04:46.00,0:04:48.00,Default,,0,0,0,,Мен оны міндетті түрде тиімді пайдаланамын.
Dialogue: 0,0:04:48.00,0:04:50.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:04:50.00,0:04:53.00,Default,,0,0,0,,Мен бұрын-соңды мұндай қыспаққа түскен емеспін.
Dialogue: 0,0:04:53.00,0:04:55.00,Default,,0,0,0,,Нашар материалдарсыз
Dialogue: 0,0:04:55.00,0:04:57.00,Default,,0,0,0,,Мен бір рет фильмді жүктеуге мәжбүрледім
Dialogue: 0,0:04:57.00,0:04:59.00,Default,,0,0,0,,Сонда не болды?
Dialogue: 0,0:04:59.00,0:05:01.00,Default,,0,0,0,,Кейінгі әсерлер
Dialogue: 0,0:05:01.00,0:05:02.00,Default,,0,0,0,,Премьер
Dialogue: 0,0:05:02.00,0:05:03.00,Default,,0,0,0,,Фотосурет
Dialogue: 0,0:05:03.00,0:05:04.00,Default,,0,0,0,,Осы жерде
Dialogue: 0,0:05:04.00,0:05:06.00,Default,,0,0,0,,Ол қазірдің өзінде болуы керек.
Dialogue: 0,0:05:06.00,0:05:07.00,Default,,0,0,0,,Әр адамның күш-жігері
Dialogue: 0,0:05:07.00,0:05:08.00,Default,,0,0,0,,Оны ысырап етпеңіз
Dialogue: 0,0:05:12.00,0:05:14.00,Default,,0,0,0,,Иә, бұл Кирю.
Dialogue: 0,0:05:14.00,0:05:16.00,Default,,0,0,0,,О, Хусси?
Dialogue: 0,0:05:16.00,0:05:18.00,Default,,0,0,0,,Ақырында клубқа қосылуға шешім қабылдады.
Dialogue: 0,0:05:18.00,0:05:20.00,Default,,0,0,0,,Мен аламын, мен аламын.
Dialogue: 0,0:05:20.00,0:05:22.00,Default,,0,0,0,,Маған фотосурет түсіруді үйретіңізші
Dialogue: 0,0:05:26.00,0:05:28.00,Default,,0,0,0,,Қалай ойлайсыңдар?Сурет сәйкес келе ме?
Dialogue: 0,0:05:28.00,0:05:30.00,Default,,0,0,0,,Иә, бұл тамаша.
Dialogue: 0,0:05:30.00,0:05:32.00,Default,,0,0,0,,Кирю-сан туралы айтатын болсақ,
Dialogue: 0,0:05:32.00,0:05:34.00,Default,,0,0,0,,Әр кесу үшін 100 фотосурет түсіру керек сияқты.
Dialogue: 0,0:05:34.00,0:05:36.00,Default,,0,0,0,,100 дана?
Dialogue: 0,0:05:36.00,0:05:38.00,Default,,0,0,0,,Иә, сондықтан негізгі камера бекітілген.
Dialogue: 0,0:05:38.00,0:05:40.00,Default,,0,0,0,,Содан кейін мен
Dialogue: 0,0:05:40.00,0:05:42.00,Default,,0,0,0,,Бейне сияқты әрекет еткеніңізді қалаймын.
Dialogue: 0,0:05:42.00,0:05:44.00,Default,,0,0,0,,Не? Жарайды ма?
Dialogue: 0,0:05:44.00,0:05:46.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:46.00,0:05:48.00,Default,,0,0,0,,Тізбектелген кадрлардан мимика алынады
Dialogue: 0,0:05:48.00,0:05:50.00,Default,,0,0,0,,Біз қолдануға болатын нәрсені шығарамыз.
Dialogue: 0,0:05:50.00,0:05:52.00,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:05:52.00,0:05:54.00,Default,,0,0,0,,Жолдар қайта жариялана ма?
Dialogue: 0,0:05:54.00,0:05:56.00,Default,,0,0,0,,Иә
Dialogue: 0,0:05:56.00,0:05:58.00,Default,,0,0,0,,Сондықтан оны кесудің секунд санына қарай реттеу керек.
Dialogue: 0,0:05:58.00,0:06:00.00,Default,,0,0,0,,Мен бұларды басып шығарамын!
Dialogue: 0,0:06:00.00,0:06:02.00,Default,,0,0,0,,Рэм де көмектеседі.
Dialogue: 0,0:06:02.00,0:06:04.00,Default,,0,0,0,,Мен оны түсініктеме бөліміне жазамын
Dialogue: 0,0:06:04.00,0:06:06.00,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:06:06.00,0:06:08.00,Default,,0,0,0,,Олай болса
Dialogue: 0,0:06:08.00,0:06:10.00,Default,,0,0,0,,Рэм де көмектеседі.
Dialogue: 0,0:06:10.00,0:06:12.00,Default,,0,0,0,,Мен бұл жолы ұйықтамаймын.
Dialogue: 0,0:06:12.00,0:06:14.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:14.00,0:06:16.00,Default,,0,0,0,,Шиноваки ше?
Dialogue: 0,0:06:16.00,0:06:18.00,Default,,0,0,0,,Взвод командирі, тіпті біз Әйел Титанын қолға түсірсек те,
Dialogue: 0,0:06:18.00,0:06:20.00,Default,,0,0,0,,Тіпті қозғалмайтын кескіндерге де төтеп бере алады
Dialogue: 0,0:06:20.00,0:06:22.00,Default,,0,0,0,,Бұл жалғыз нұсқа болатын композиция жасауыңызды қалаймын.
Dialogue: 0,0:06:22.00,0:06:24.00,Default,,0,0,0,,Бұл өте қиын
Dialogue: 0,0:06:24.00,0:06:26.00,Default,,0,0,0,,Мұны тек Шиноваки жасай алады.
Dialogue: 0,0:06:26.00,0:06:28.00,Default,,0,0,0,,Мен сізге бір жақсылық сұрасам болады ма?
Dialogue: 0,0:06:28.00,0:06:30.00,Default,,0,0,0,,Иә, мен жасап көремін.
Dialogue: 0,0:06:30.00,0:06:32.00,Default,,0,0,0,,Кионо-кунның үмітін ақтау
Dialogue: 0,0:06:32.00,0:06:34.00,Default,,0,0,0,,Сонымен қатар, сандық фотоаппарат әкелген адам бар ма?
Dialogue: 0,0:06:34.00,0:06:36.00,Default,,0,0,0,,А, менде бар.
Dialogue: 0,0:06:36.00,0:06:38.00,Default,,0,0,0,,Сурет сапасы қорқынышты.
Dialogue: 0,0:06:38.00,0:06:40.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:06:42.00,0:06:44.00,Default,,0,0,0,,Жарайды, міне осы.
Dialogue: 0,0:06:44.00,0:06:46.00,Default,,0,0,0,,Көмегің үшін рахмет, Нанако.
Dialogue: 0,0:06:48.00,0:06:50.00,Default,,0,0,0,,Нанаконың сандық камерасымен түсірілген
Dialogue: 0,0:06:50.00,0:06:52.00,Default,,0,0,0,,Бейне ұзақтығы небәрі 15 секунд
Dialogue: 0,0:07:00.00,0:07:02.00,Default,,0,0,0,,Содан кейін фотокамерадағы қозғалыссыз кескіндерді жинақтаңыз
Dialogue: 0,0:07:02.00,0:07:04.00,Default,,0,0,0,,Әңгімені тоқу
Dialogue: 0,0:07:04.00,0:07:06.00,Default,,0,0,0,,Бар болғаны 3 минут
Dialogue: 0,0:07:06.00,0:07:08.00,Default,,0,0,0,,Осы үш минутта
Dialogue: 0,0:07:34.00,0:07:36.00,Default,,0,0,0,,1 минут
Dialogue: 0,0:07:36.00,0:07:38.00,Default,,0,0,0,,2 минут
Dialogue: 0,0:07:38.00,0:07:40.00,Default,,0,0,0,,3 минут
Dialogue: 0,0:07:40.00,0:07:42.00,Default,,0,0,0,,4 минут
Dialogue: 0,0:07:42.00,0:07:44.00,Default,,0,0,0,,5 минут
Dialogue: 0,0:07:44.00,0:07:46.00,Default,,0,0,0,,6 минут
Dialogue: 0,0:07:46.00,0:07:48.00,Default,,0,0,0,,7 минут
Dialogue: 0,0:07:48.00,0:07:50.00,Default,,0,0,0,,8 минут
Dialogue: 0,0:07:50.00,0:07:52.00,Default,,0,0,0,,9 минут
Dialogue: 0,0:07:52.00,0:07:54.00,Default,,0,0,0,,10 минут
Dialogue: 0,0:07:54.00,0:07:56.00,Default,,0,0,0,,11 минут
Dialogue: 0,0:07:56.00,0:07:58.00,Default,,0,0,0,,12 минут
Dialogue: 0,0:07:58.00,0:08:00.00,Default,,0,0,0,,13 минут
Dialogue: 0,0:08:00.00,0:08:02.00,Default,,0,0,0,,14 минут
Dialogue: 0,0:08:02.00,0:08:04.00,Default,,0,0,0,,15 минут
Dialogue: 0,0:08:04.00,0:08:06.00,Default,,0,0,0,,20 минут
Dialogue: 0,0:08:06.00,0:08:08.00,Default,,0,0,0,,21 минут
Dialogue: 0,0:08:08.00,0:08:10.00,Default,,0,0,0,,22 минут
Dialogue: 0,0:08:10.00,0:08:12.00,Default,,0,0,0,,23 минут
Dialogue: 0,0:08:12.00,0:08:14.00,Default,,0,0,0,,24 минут
Dialogue: 0,0:08:14.00,0:08:16.00,Default,,0,0,0,,25 минут
Dialogue: 0,0:08:16.00,0:08:18.00,Default,,0,0,0,,26 минут
Dialogue: 0,0:08:18.00,0:08:20.00,Default,,0,0,0,,28 минут
Dialogue: 0,0:08:20.00,0:08:22.00,Default,,0,0,0,,29 минут
Dialogue: 0,0:08:22.00,0:08:24.00,Default,,0,0,0,,30 минут
Dialogue: 0,0:08:24.00,0:08:26.00,Default,,0,0,0,,31 минут
Dialogue: 0,0:08:26.00,0:08:28.00,Default,,0,0,0,,32 минут
Dialogue: 0,0:08:28.00,0:08:30.00,Default,,0,0,0,,33 минут
Dialogue: 0,0:08:30.00,0:08:32.00,Default,,0,0,0,,34 минут
Dialogue: 0,0:08:32.00,0:08:34.00,Default,,0,0,0,,35 минут
Dialogue: 0,0:08:34.00,0:08:36.00,Default,,0,0,0,,40 минут
Dialogue: 0,0:08:36.00,0:08:38.00,Default,,0,0,0,,41 минут
Dialogue: 0,0:08:38.00,0:08:40.00,Default,,0,0,0,,42 минут
Dialogue: 0,0:08:40.00,0:08:42.00,Default,,0,0,0,,43 минут
Dialogue: 0,0:08:42.00,0:08:44.00,Default,,0,0,0,,44 минут
Dialogue: 0,0:08:44.00,0:08:46.00,Default,,0,0,0,,45 минут
Dialogue: 0,0:08:46.00,0:08:48.00,Default,,0,0,0,,50 минут
Dialogue: 0,0:08:48.00,0:08:50.00,Default,,0,0,0,,60 минут
Dialogue: 0,0:08:50.00,0:08:52.00,Default,,0,0,0,,60 минут
Dialogue: 0,0:08:52.00,0:08:54.00,Default,,0,0,0,,70 минут
Dialogue: 0,0:08:54.00,0:08:56.00,Default,,0,0,0,,70 минут
Dialogue: 0,0:08:56.00,0:08:58.00,Default,,0,0,0,,70 минут
Dialogue: 0,0:08:58.00,0:09:00.00,Default,,0,0,0,,Өте көңілсіз
Dialogue: 0,0:09:00.00,0:09:02.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:02.00,0:09:04.00,Default,,0,0,0,,Мен түсіріп жатқанда не істеп жатқаныма қатты мән бермеймін.
Dialogue: 0,0:09:04.00,0:09:06.00,Default,,0,0,0,,Түсінбесем де
Dialogue: 0,0:09:06.00,0:09:08.00,Default,,0,0,0,,Мен көтерілсем, ол да қатты түсті.
Dialogue: 0,0:09:08.00,0:09:10.00,Default,,0,0,0,,Сіз шынымен кереметсіз
Dialogue: 0,0:09:10.00,0:09:12.00,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:09:12.00,0:09:14.00,Default,,0,0,0,,Бірақ, менің сценарийім
Dialogue: 0,0:09:14.00,0:09:16.00,Default,,0,0,0,,Мен бірінші жариялағаным емес
Dialogue: 0,0:09:16.00,0:09:18.00,Default,,0,0,0,,Өз пікіріңізді қосыңыз
Dialogue: 0,0:09:18.00,0:09:20.00,Default,,0,0,0,,Бөлінген инстинкт.
Dialogue: 0,0:09:20.00,0:09:22.00,Default,,0,0,0,,Тек сол қалпында қолданылса
Dialogue: 0,0:09:22.00,0:09:24.00,Default,,0,0,0,,Бұл сөзсіз жақсы болды.
Dialogue: 0,0:09:24.00,0:09:26.00,Default,,0,0,0,,Бұл қазіргі бейнеден жақсырақ болуы мүмкін
Dialogue: 0,0:09:26.00,0:09:28.00,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:09:28.00,0:09:30.00,Default,,0,0,0,,Менің де көңілім қалды.
Dialogue: 0,0:09:30.00,0:09:32.00,Default,,0,0,0,,Бүгінгі күн шынымен де керемет болды.
Dialogue: 0,0:09:32.00,0:09:34.00,Default,,0,0,0,,Осы бастапқы нүктені дәл сол жерде айтыңыз.
Dialogue: 0,0:09:34.00,0:09:36.00,Default,,0,0,0,,Мен айтқанын орындадым.
Dialogue: 0,0:09:36.00,0:09:38.00,Default,,0,0,0,,Мен мұны жасадым
Dialogue: 0,0:09:38.00,0:09:40.00,Default,,0,0,0,,Эй, айтайын дегенім.
Dialogue: 0,0:09:40.00,0:09:42.00,Default,,0,0,0,,Маған қатты әсер қалдырды.
Dialogue: 0,0:09:42.00,0:09:44.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:09:44.00,0:09:46.00,Default,,0,0,0,,Мен де қалыпты актерлік ойнай аламын.
Dialogue: 0,0:09:46.00,0:09:48.00,Default,,0,0,0,,Бұл жақсырақ
Dialogue: 0,0:09:48.00,0:09:50.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:50.00,0:09:52.00,Default,,0,0,0,,О, жетеді
Dialogue: 0,0:09:52.00,0:09:54.00,Default,,0,0,0,,Мен айтайын
Dialogue: 0,0:09:54.00,0:09:56.00,Default,,0,0,0,,Менің ойымша, сіз міндетті түрде жақсы өнер көрсете аласыз.
Dialogue: 0,0:09:56.00,0:09:58.00,Default,,0,0,0,,Мен жақсырақ әрекет еткім келеді
Dialogue: 0,0:10:00.00,0:10:02.00,Default,,0,0,0,,Кёуя-кун
Dialogue: 0,0:10:02.00,0:10:04.00,Default,,0,0,0,,Кёуякун қатал адам.
Dialogue: 0,0:10:06.00,0:10:08.00,Default,,0,0,0,,Ол әдетте соншалықты бейбіт көрінеді.
Dialogue: 0,0:10:08.00,0:10:10.00,Default,,0,0,0,,Жоқ, бұл 70 пайызға жетеді, бұл
Dialogue: 0,0:10:10.00,0:10:12.00,Default,,0,0,0,,Көздер кенет жылтырап кетеді
Dialogue: 0,0:10:14.00,0:10:16.00,Default,,0,0,0,,Түсірілім және көрсетілім кезінде
Dialogue: 0,0:10:16.00,0:10:18.00,Default,,0,0,0,,Жүрегім соғып тұрды.
Dialogue: 0,0:10:20.00,0:10:22.00,Default,,0,0,0,,Ей, енді жабылайық.
Dialogue: 0,0:10:22.00,0:10:24.00,Default,,0,0,0,,Егер сізде шолу жиналысы болса, оны сыртта өткізіңіз.
Dialogue: 0,0:10:24.00,0:10:26.00,Default,,0,0,0,,Әлде…
Dialogue: 0,0:10:26.00,0:10:28.00,Default,,0,0,0,,Келесі мақсатыңызды шештіңіз бе?
Dialogue: 0,0:10:28.00,0:10:30.00,Default,,0,0,0,,Иә
Dialogue: 0,0:10:30.00,0:10:32.00,Default,,0,0,0,,Осыған
Dialogue: 0,0:10:32.00,0:10:34.00,Default,,0,0,0,,Бүгін Ямо
Dialogue: 0,0:10:34.00,0:10:36.00,Default,,0,0,0,,Бүгінгі якун үшін
Dialogue: 0,0:10:36.00,0:10:38.00,Default,,0,0,0,,Мен жоғалтқым келмейді
Dialogue: 0,0:10:38.00,0:10:40.00,Default,,0,0,0,,Бұл дұрыс болды
Dialogue: 0,0:10:40.00,0:10:42.00,Default,,0,0,0,,Мерекеден кейінгі кезекті тапсырма
Dialogue: 0,0:10:42.00,0:10:44.00,Default,,0,0,0,,Мен күтемін.
Dialogue: 0,0:10:44.00,0:10:46.00,Default,,0,0,0,,Кек алу жақсы
Dialogue: 0,0:10:46.00,0:10:48.00,Default,,0,0,0,,Иә
Dialogue: 0,0:10:48.00,0:10:50.00,Default,,0,0,0,,Жақсы жауап.
Dialogue: 0,0:10:50.00,0:10:52.00,Default,,0,0,0,,Біріншіден, шолу жиналысы.
Dialogue: 0,0:10:52.00,0:10:54.00,Default,,0,0,0,,Әзірше менің қателерімді қалдырыңыз.
Dialogue: 0,0:10:54.00,0:10:56.00,Default,,0,0,0,,Бұл басында шешілді, солай ма?
Dialogue: 0,0:10:56.00,0:10:58.00,Default,,0,0,0,,Содан кейін уақытты және барлығын есептеңіз.
Dialogue: 0,0:10:58.00,0:11:00.00,Default,,0,0,0,,Сюжеттер тақтасын жасамаңыз
Dialogue: 0,0:11:00.00,0:11:02.00,Default,,0,0,0,,О, сценарий де.
Dialogue: 0,0:11:02.00,0:11:04.00,Default,,0,0,0,,Актерлік өнер бұл күндері адамдарды таң қалдыратын нәрсе.
Dialogue: 0,0:11:04.00,0:11:06.00,Default,,0,0,0,,Мен саған көрсетемін
Dialogue: 0,0:11:06.00,0:11:08.00,Default,,0,0,0,,О, мен оны асыға күтемін.
Dialogue: 0,0:11:10.00,0:11:12.00,Default,,0,0,0,,Аз да болса сүйсіну
Dialogue: 0,0:11:12.00,0:11:14.00,Default,,0,0,0,,Мен жақындасқым келген платина буыны
Dialogue: 0,0:11:14.00,0:11:16.00,Default,,0,0,0,,Егер
Dialogue: 0,0:11:16.00,0:11:18.00,Default,,0,0,0,,Егер мен аздап қысым көрсетсем
Dialogue: 0,0:11:20.00,0:11:22.00,Default,,0,0,0,,Менің де ремейкім
Dialogue: 0,0:11:22.00,0:11:24.00,Default,,0,0,0,,Бәлкім, біраз нәрсе дұрыс болған шығар.
Dialogue: 0,0:11:26.00,0:11:28.00,Default,,0,0,0,,Уф, мен түсінбеймін.
Dialogue: 0,0:11:28.00,0:11:30.00,Default,,0,0,0,,Неліктен Хашибаның командасы бірінші орында емес?
Dialogue: 0,0:11:30.00,0:11:32.00,Default,,0,0,0,,Себебі қарапайым
Dialogue: 0,0:11:32.00,0:11:34.00,Default,,0,0,0,,Сабаққа ұсынылған жұмыстар
Dialogue: 0,0:11:34.00,0:11:36.00,Default,,0,0,0,,Тым айнымалы
Dialogue: 0,0:11:36.00,0:11:38.00,Default,,0,0,0,,Бұл кездейсоқ болған шығар.
Dialogue: 0,0:11:38.00,0:11:40.00,Default,,0,0,0,,Бұл тапсырыс қатесі немесе басқа нәрсе болуы мүмкін.
Dialogue: 0,0:11:40.00,0:11:42.00,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:44.00,0:11:46.00,Default,,0,0,0,,Ол жұмыс жақсы ойластырылмаған.
Dialogue: 0,0:11:46.00,0:11:48.00,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:11:48.00,0:11:50.00,Default,,0,0,0,,Мен ұзақ уақыттан кейін қызықты нәрсе тапқан шығармын.
Dialogue: 0,0:11:50.00,0:11:52.00,Default,,0,0,0,,Жазатайым оқиғаны пайдалану
Dialogue: 0,0:11:52.00,0:11:54.00,Default,,0,0,0,,Егер сіз бұл бейнені жасасаңыз
Dialogue: 0,0:11:54.00,0:11:56.00,Default,,0,0,0,,Кем дегенде
Dialogue: 0,0:11:56.00,0:11:58.00,Default,,0,0,0,,Киотани Хашибаның есеп шығару қабілеті
Dialogue: 0,0:11:58.00,0:12:00.00,Default,,0,0,0,,Оған қоса—
Dialogue: 0,0:12:00.00,0:12:02.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:02.00,0:12:04.00,Default,,0,0,0,,Сонымен
Dialogue: 0,0:12:04.00,0:12:06.00,Default,,0,0,0,,Кейінгі тапсырмалар
Dialogue: 0,0:12:06.00,0:12:08.00,Default,,0,0,0,,Мен сені Хашибаның командасымен біріктіруді сұраймын.
Dialogue: 0,0:12:08.00,0:12:10.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:10.00,0:12:12.00,Default,,0,0,0,,Уф…
Dialogue: 0,0:12:12.00,0:12:14.00,Default,,0,0,0,,Сізді Хашиба қызықтырады ма?
Dialogue: 0,0:12:14.00,0:12:16.00,Default,,0,0,0,,Уф, хе.
Dialogue: 0,0:12:16.00,0:12:18.00,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:12:18.00,0:12:20.00,Default,,0,0,0,,Уа, ау, ау
Dialogue: 0,0:12:20.00,0:12:22.00,Default,,0,0,0,,, әрине.
Dialogue: 0,0:12:22.00,0:12:24.00,Default,,0,0,0,,Хашибаның продюсер ретіндегі таланты
Dialogue: 0,0:12:24.00,0:12:26.00,Default,,0,0,0,,О?
Dialogue: 0,0:12:26.00,0:12:28.00,Default,,0,0,0,,Мен айтқанымда дәл осылай айтқым келді.
Dialogue: 0,0:12:28.00,0:12:30.00,Default,,0,0,0,,Ууу
Dialogue: 0,0:12:30.00,0:12:32.00,Default,,0,0,0,,Апаның бұлдырлығы
Dialogue: 0,0:12:32.00,0:12:34.00,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:12:36.00,0:12:38.00,Default,,0,0,0,,Жасың нешеде болса да сүйкімді
Dialogue: 0,0:12:38.00,0:12:40.00,Default,,0,0,0,,Менің әпкем
Dialogue: 0,0:12:40.00,0:12:42.00,Default,,0,0,0,,Алдымен мені кешіріңіз.
Dialogue: 0,0:12:42.00,0:12:44.00,Default,,0,0,0,,Иә, рахмет
Dialogue: 0,0:12:44.00,0:12:46.00,Default,,0,0,0,,Иә
Dialogue: 0,0:12:46.00,0:12:48.00,Default,,0,0,0,,Уф
Dialogue: 0,0:12:48.00,0:12:50.00,Default,,0,0,0,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:12:50.00,0:12:52.00,Default,,0,0,0,,Кешіріңіз, мен кенет ауысуға тура келді.
Dialogue: 0,0:12:52.00,0:12:54.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:54.00,0:12:56.00,Default,,0,0,0,,Нанако, еңбегіңіз үшін рахмет.
Dialogue: 0,0:12:56.00,0:12:58.00,Default,,0,0,0,,Осымен
Dialogue: 0,0:12:58.00,0:13:00.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:00.00,0:13:02.00,Default,,0,0,0,,Енді сағат нешеде?
Dialogue: 0,0:13:02.00,0:13:04.00,Default,,0,0,0,,Бар ма?
Dialogue: 0,0:13:06.00,0:13:08.00,Default,,0,0,0,,Үлкен апа
Dialogue: 0,0:13:08.00,0:13:10.00,Default,,0,0,0,,Га
Dialogue: 0,0:13:14.00,0:13:16.00,Default,,0,0,0,,Менде караоке-бокс болмағанына біраз уақыт болды.
Dialogue: 0,0:13:18.00,0:13:20.00,Default,,0,0,0,,Сізге караоке ұнай ма?
Dialogue: 0,0:13:20.00,0:13:22.00,Default,,0,0,0,,Иә, маған өте ұнайды
Dialogue: 0,0:13:22.00,0:13:24.00,Default,,0,0,0,,Дәлірек айтсақ, ән айтып, ән айту.
Dialogue: 0,0:13:24.00,0:13:26.00,Default,,0,0,0,,Мен сенің үмітіңді артамын
Dialogue: 0,0:13:26.00,0:13:28.00,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:13:32.00,0:13:34.00,Default,,0,0,0,,Сонымен
Dialogue: 0,0:13:34.00,0:13:36.00,Default,,0,0,0,,Хаа
Dialogue: 0,0:13:36.00,0:13:38.00,Default,,0,0,0,,Га
Dialogue: 0,0:13:38.00,0:13:40.00,Default,,0,0,0,,Дауыстың қаттылығы ғажап.
Dialogue: 0,0:13:40.00,0:13:42.00,Default,,0,0,0,,Ең бастысы, бұл дауыс
Dialogue: 0,0:13:42.00,0:13:44.00,Default,,0,0,0,,Жүрегімде тікелей жаңғырып тұрғандай
Dialogue: 0,0:13:44.00,0:13:46.00,Default,,0,0,0,,На
Dialogue: 0,0:13:46.00,0:13:48.00,Default,,0,0,0,,Жарайды, екеу болсын.
Dialogue: 0,0:13:48.00,0:13:50.00,Default,,0,0,0,,Өте нашар
Dialogue: 0,0:13:50.00,0:13:52.00,Default,,0,0,0,,Өте нашар
Dialogue: 0,0:13:58.00,0:14:00.00,Default,,0,0,0,,Хаа
Dialogue: 0,0:14:00.00,0:14:02.00,Default,,0,0,0,,Біраз уақыттан кейін бірінші рет ән айтқаннан кейін
Dialogue: 0,0:14:02.00,0:14:04.00,Default,,0,0,0,,Бұл жақсы болды.
Dialogue: 0,0:14:04.00,0:14:06.00,Default,,0,0,0,,Кешіріңіз, мен оны жақсы білмедім.
Dialogue: 0,0:14:06.00,0:14:08.00,Default,,0,0,0,,Мен
Dialogue: 0,0:14:08.00,0:14:10.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:14:10.00,0:14:12.00,Default,,0,0,0,,Ата-анамның үйі
Dialogue: 0,0:14:12.00,0:14:14.00,Default,,0,0,0,,Менің әжем қарапайым халыққа қызмет ететін.
Dialogue: 0,0:14:14.00,0:14:16.00,Default,,0,0,0,,Мен де кішкентай кезімнен.
Dialogue: 0,0:14:16.00,0:14:18.00,Default,,0,0,0,,Мен үйрендім
Dialogue: 0,0:14:18.00,0:14:20.00,Default,,0,0,0,,Бұл жақсы емес, солай ма?
Dialogue: 0,0:14:20.00,0:14:22.00,Default,,0,0,0,,Тек нашар дыбыс
Dialogue: 0,0:14:22.00,0:14:24.00,Default,,0,0,0,,Ол емделмейді
Dialogue: 0,0:14:28.00,0:14:30.00,Default,,0,0,0,,Деса
Dialogue: 0,0:14:30.00,0:14:32.00,Default,,0,0,0,,Менің сенен бір жақсылығым бар.
Dialogue: 0,0:14:32.00,0:14:34.00,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:14:34.00,0:14:36.00,Default,,0,0,0,,Қалай ән айтсаң да
Dialogue: 0,0:14:36.00,0:14:38.00,Default,,0,0,0,,Нені түзетуім керек?
Dialogue: 0,0:14:38.00,0:14:40.00,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:14:40.00,0:14:42.00,Default,,0,0,0,,Кейде жақсы.
Dialogue: 0,0:14:42.00,0:14:44.00,Default,,0,0,0,,Менімен караокеге кел
Dialogue: 0,0:14:44.00,0:14:46.00,Default,,0,0,0,,Менің әнімді тыңдауларыңызды қалаймын.
Dialogue: 0,0:14:46.00,0:14:48.00,Default,,0,0,0,,Жол босатыңыз. Енді мен қосымша күштерді ұйымдастыруды өз мойныма аламын.
Dialogue: 0,0:14:50.00,0:14:52.00,Default,,0,0,0,,Жақсы, егер маған қарсы болмасаңыз.
Dialogue: 0,0:14:52.00,0:14:54.00,Default,,0,0,0,,Мен мұны шынымен жасадым!
Dialogue: 0,0:14:54.00,0:14:56.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:56.00,0:14:58.00,Default,,0,0,0,,Киоя
Dialogue: 0,0:15:00.00,0:15:02.00,Default,,0,0,0,,О, бірдеңе
Dialogue: 0,0:15:02.00,0:15:04.00,Default,,0,0,0,,Кёяның алдында ән айту өте оңай болды.
Dialogue: 0,0:15:04.00,0:15:06.00,Default,,0,0,0,,Көңілді болды
Dialogue: 0,0:15:08.00,0:15:10.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:10.00,0:15:12.00,Default,,0,0,0,,Наноко
Dialogue: 0,0:15:12.00,0:15:14.00,Default,,0,0,0,,Мен жай ғана ойладым.
Dialogue: 0,0:15:14.00,0:15:16.00,Default,,0,0,0,,Жаттығу жасап, сенім артқаннан кейін
Dialogue: 0,0:15:16.00,0:15:18.00,Default,,0,0,0,,Наноконың әнін интернетке жүктеңіз
Dialogue: 0,0:15:18.00,0:15:20.00,Default,,0,0,0,,ше?
Dialogue: 0,0:15:20.00,0:15:22.00,Default,,0,0,0,,Net?
Dialogue: 0,0:15:22.00,0:15:24.00,Default,,0,0,0,,Наноко әнін жазыңыз
Dialogue: 0,0:15:24.00,0:15:26.00,Default,,0,0,0,,Бейне сайтында жарияланған
Dialogue: 0,0:15:26.00,0:15:28.00,Default,,0,0,0,,Көп адамнан сұрасаң
Dialogue: 0,0:15:28.00,0:15:30.00,Default,,0,0,0,,Негізсіз мүмкін емес мүмкін емес
Dialogue: 0,0:15:30.00,0:15:32.00,Default,,0,0,0,,Бұл мүмкін емес, солай емес пе?
Dialogue: 0,0:15:32.00,0:15:34.00,Default,,0,0,0,,Бұл жай ғана нашар болса да
Dialogue: 0,0:15:34.00,0:15:36.00,Default,,0,0,0,,Олай етсең, ұрып-соғатыныңа сенімдімін.
Dialogue: 0,0:15:36.00,0:15:38.00,Default,,0,0,0,,Өйткені бұл маған ұнамайды
Dialogue: 0,0:15:38.00,0:15:40.00,Default,,0,0,0,,Жақсырақ болады деп үміттенемін
Dialogue: 0,0:15:40.00,0:15:42.00,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:15:42.00,0:15:44.00,Default,,0,0,0,,Өйткені интернет – бұл әлем.
Dialogue: 0,0:15:44.00,0:15:46.00,Default,,0,0,0,,Мұндай жерде өзін-өзі анықтауға деген ұмтылысты көрсету қиын.
Dialogue: 0,0:15:46.00,0:15:48.00,Default,,0,0,0,,(Ватару) Бұл жігіт суға түсе алмайды! (Цубаки) Косэй!
Dialogue: 0,0:15:48.00,0:15:50.00,Default,,0,0,0,,Олай болса
Dialogue: 0,0:15:50.00,0:15:52.00,Default,,0,0,0,,Егер сіз тек Жапония үшін бейне сайт жасай алсаңыз ше?
Dialogue: 0,0:15:52.00,0:15:54.00,Default,,0,0,0,,Жүктеп салайық
Dialogue: 0,0:15:54.00,0:15:56.00,Default,,0,0,0,,Тек Жапонияда ма?
Dialogue: 0,0:15:56.00,0:15:58.00,Default,,0,0,0,,Ондай нәрсе болды ма?
Dialogue: 0,0:15:58.00,0:16:00.00,Default,,0,0,0,,Иә, осы жылдың соңында?
Dialogue: 0,0:16:00.00,0:16:02.00,Default,,0,0,0,,Мен мұны келесі жылы жасай аламыз деп үміттенемін.
Dialogue: 0,0:16:02.00,0:16:04.00,Default,,0,0,0,,ше?
Dialogue: 0,0:16:04.00,0:16:06.00,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:16:06.00,0:16:08.00,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:08.00,0:16:10.00,Default,,0,0,0,,Жақсы, егер бәрі осы болса.
Dialogue: 0,0:16:10.00,0:16:12.00,Default,,0,0,0,,Жарайды, шешілді.
Dialogue: 0,0:16:12.00,0:16:14.00,Default,,0,0,0,,Осыны мақсат етіп қояйық.
Dialogue: 0,0:16:14.00,0:16:16.00,Default,,0,0,0,,Өз еркімен шешім қабылдамаңыз
Dialogue: 0,0:16:16.00,0:16:18.00,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:16:18.00,0:16:20.00,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:20.00,0:16:22.00,Default,,0,0,0,,Иә
Dialogue: 0,0:16:22.00,0:16:24.00,Default,,0,0,0,,Иә
Dialogue: 0,0:16:24.00,0:16:26.00,Default,,0,0,0,,Олай болса толық тоқсандық емтихан аяқталды.
Dialogue: 0,0:16:26.00,0:16:28.00,Default,,0,0,0,,Жаңа мүшелерді алу арқылы
Dialogue: 0,0:16:28.00,0:16:30.00,Default,,0,0,0,,Өнер зерттеу тобының жұмыс күндерін жаңарту
Dialogue: 0,0:16:30.00,0:16:32.00,Default,,0,0,0,,Құттықтаймыз
Dialogue: 0,0:16:32.00,0:16:34.00,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:16:34.00,0:16:36.00,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:16:36.00,0:16:38.00,Default,,0,0,0,,Уф
Dialogue: 0,0:16:38.00,0:16:40.00,Default,,0,0,0,,Куу
Dialogue: 0,0:16:40.00,0:16:42.00,Default,,0,0,0,,Олай болса
Dialogue: 0,0:16:42.00,0:16:44.00,Default,,0,0,0,,Өзіңізді тағы да таныстырыңыз
Dialogue: 0,0:16:44.00,0:16:46.00,Default,,0,0,0,,Мен Кирю Такашимін
Dialogue: 0,0:16:46.00,0:16:48.00,Default,,0,0,0,,Мен фотосурет бөлімінің 5 курс студентімін.
Dialogue: 0,0:16:48.00,0:16:50.00,Default,,0,0,0,,Бұл теория үшін көп рахмет.
Dialogue: 0,0:16:50.00,0:16:52.00,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:16:52.00,0:16:54.00,Default,,0,0,0,,Сіздің арқаңызда әдемі префектурамыз жеңілді.
Dialogue: 0,0:16:54.00,0:16:56.00,Default,,0,0,0,,Ол жойылды.
Dialogue: 0,0:16:56.00,0:16:58.00,Default,,0,0,0,,Иә, сүйкімді қыздар да.
Dialogue: 0,0:16:58.00,0:17:00.00,Default,,0,0,0,,Сіз мені осында әкелдіңіз.
Dialogue: 0,0:17:00.00,0:17:02.00,Default,,0,0,0,,Юрика Хияма
Dialogue: 0,0:17:02.00,0:17:04.00,Default,,0,0,0,,Қолөнер мамандығының 3 курс студенті
Dialogue: 0,0:17:04.00,0:17:06.00,Default,,0,0,0,,Мен керамикамен айналысамын.
Dialogue: 0,0:17:06.00,0:17:08.00,Default,,0,0,0,,Мен жасаймын.
Dialogue: 0,0:17:08.00,0:17:10.00,Default,,0,0,0,,Желу орамы
Dialogue: 0,0:17:10.00,0:17:12.00,Default,,0,0,0,,Донбурико
Dialogue: 0,0:17:12.00,0:17:14.00,Default,,0,0,0,,Мен Ойкеге тәуелдімін.
Dialogue: 0,0:17:14.00,0:17:16.00,Default,,0,0,0,,«Қиын екен.»
Dialogue: 0,0:17:20.00,0:17:22.00,Default,,0,0,0,,Музыка бөлімінің 2 курс студенті
Dialogue: 0,0:17:22.00,0:17:24.00,Default,,0,0,0,,Мики Сугимото
Dialogue: 0,0:17:24.00,0:17:26.00,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:17:26.00,0:17:28.00,Default,,0,0,0,,Аа, сіз өте қабілетті адам сияқтысыз.
Dialogue: 0,0:17:28.00,0:17:30.00,Default,,0,0,0,,Бір рет назар аударыңыз
Dialogue: 0,0:17:30.00,0:17:32.00,Default,,0,0,0,,Бүгінгі қуаныш
Dialogue: 0,0:17:32.00,0:17:34.00,Default,,0,0,0,,Би арқылы білдірейік
Dialogue: 0,0:17:34.00,0:17:36.00,Default,,0,0,0,,Бұл сәлемдесу позасы
Dialogue: 0,0:17:36.00,0:17:38.00,Default,,0,0,0,,Бұл болашаққа деген үміт
Dialogue: 0,0:17:38.00,0:17:40.00,Default,,0,0,0,,Ол жазбаны жойды
Dialogue: 0,0:17:40.00,0:17:42.00,Default,,0,0,0,,3 курс орындаушысы
Dialogue: 0,0:17:42.00,0:17:44.00,Default,,0,0,0,,Мен алдымен бутох курсын оқып жатырмын.
Dialogue: 0,0:17:44.00,0:17:46.00,Default,,0,0,0,,Және бұл
Dialogue: 0,0:17:46.00,0:17:48.00,Default,,0,0,0,,Бах биі
Dialogue: 0,0:17:48.00,0:17:50.00,Default,,0,0,0,,Мен көптен күттім
Dialogue: 0,0:17:50.00,0:17:52.00,Default,,0,0,0,,Майкеннің мамандығына барайық
Dialogue: 0,0:17:52.00,0:17:54.00,Default,,0,0,0,,Везувий қиындыққа тап болды ма?
Dialogue: 0,0:17:58.00,0:18:00.00,Default,,0,0,0,,Бұл Поппенің трагедиясы
Dialogue: 0,0:18:04.00,0:18:06.00,Default,,0,0,0,,Жарайды, менің толық емес жұмыс күнім бар.
Dialogue: 0,0:18:06.00,0:18:08.00,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:18:08.00,0:18:10.00,Default,,0,0,0,,Мен кешкі ас әзірлеймін.
Dialogue: 0,0:18:10.00,0:18:12.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:14.00,0:18:16.00,Default,,0,0,0,,Бұл күлкілі, өйткені олардың барлығы аға буын өкілдері.
Dialogue: 0,0:18:16.00,0:18:18.00,Default,,0,0,0,,Бұл көңілді болды.
Dialogue: 0,0:18:18.00,0:18:20.00,Default,,0,0,0,,Тұлға
Dialogue: 0,0:18:20.00,0:18:22.00,Default,,0,0,0,,Әр аға – дарынның бір шоғыры.
Dialogue: 0,0:18:22.00,0:18:24.00,Default,,0,0,0,,Киотани-кун
Dialogue: 0,0:18:24.00,0:18:26.00,Default,,0,0,0,,Не?
Dialogue: 0,0:18:28.00,0:18:30.00,Default,,0,0,0,,Мен сурет саламын
Dialogue: 0,0:18:30.00,0:18:32.00,Default,,0,0,0,,Сіз мұны білесіз.
Dialogue: 0,0:18:32.00,0:18:34.00,Default,,0,0,0,,Мен бұл туралы білетінмін.
Dialogue: 0,0:18:34.00,0:18:36.00,Default,,0,0,0,,Мен мұны құпия ұстадым.
Dialogue: 0,0:18:36.00,0:18:38.00,Default,,0,0,0,,Неге тек сол кезде?
Dialogue: 0,0:18:38.00,0:18:40.00,Default,,0,0,0,,Менің ойымша, сіз кілтті таңдаған жоқсыз.
Dialogue: 0,0:18:40.00,0:18:42.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:42.00,0:18:44.00,Default,,0,0,0,,Мен рұқсатсыз көрдім
Dialogue: 0,0:18:44.00,0:18:46.00,Default,,0,0,0,,Кешірім сұрама.
Dialogue: 0,0:18:46.00,0:18:48.00,Default,,0,0,0,,Менің абайсыздығым
Dialogue: 0,0:18:50.00,0:18:52.00,Default,,0,0,0,,Эй
Dialogue: 0,0:18:52.00,0:18:54.00,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:18:54.00,0:18:56.00,Default,,0,0,0,,Бұрын ештеңе істей алмайтындар
Dialogue: 0,0:18:56.00,0:18:58.00,Default,,0,0,0,,Сіз не істей аласыз?
Dialogue: 0,0:18:58.00,0:19:00.00,Default,,0,0,0,,Мен сені іздеймін
Dialogue: 0,0:19:00.00,0:19:02.00,Default,,0,0,0,,Мен сөйледім
Dialogue: 0,0:19:02.00,0:19:04.00,Default,,0,0,0,,Иә
Dialogue: 0,0:19:04.00,0:19:06.00,Default,,0,0,0,,Басқаларға ұқсамайды
Dialogue: 0,0:19:06.00,0:19:08.00,Default,,0,0,0,,Мен ештеңе істей алмаймын
Dialogue: 0,0:19:08.00,0:19:10.00,Default,,0,0,0,,Тіпті қарапайым өмірде де
Dialogue: 0,0:19:10.00,0:19:12.00,Default,,0,0,0,,Дожибаккарияши
Dialogue: 0,0:19:12.00,0:19:14.00,Default,,0,0,0,,Мектеп оқуы да
Dialogue: 0,0:19:14.00,0:19:16.00,Default,,0,0,0,,Мен де жаттығуда жақсы емеспін.
Dialogue: 0,0:19:16.00,0:19:18.00,Default,,0,0,0,,Бірақ бір ғана нәрсе
Dialogue: 0,0:19:18.00,0:19:20.00,Default,,0,0,0,,Маған бір ғана нәрсе ұнады.
Dialogue: 0,0:19:20.00,0:19:22.00,Default,,0,0,0,,Сурет
Dialogue: 0,0:19:22.00,0:19:24.00,Default,,0,0,0,,Бірақ ол мүлде қалыптаспайды.
Dialogue: 0,0:19:24.00,0:19:26.00,Default,,0,0,0,,Мен өзіме ұнағандықтан сурет саламын
Dialogue: 0,0:19:26.00,0:19:28.00,Default,,0,0,0,,Бірдеңе жасаңыз
Dialogue: 0,0:19:28.00,0:19:30.00,Default,,0,0,0,,Мен өзіме ұнағандықтан сурет саламын
Dialogue: 0,0:19:30.00,0:19:32.00,Default,,0,0,0,,Ештеңе жоқ бөтелке
Dialogue: 0,0:19:32.00,0:19:34.00,Default,,0,0,0,,Мен тіпті марапатқа ие болдым.
Dialogue: 0,0:19:34.00,0:19:36.00,Default,,0,0,0,,Сіз мұнымен ғана өмір сүре алмайсыз.
Dialogue: 0,0:19:36.00,0:19:38.00,Default,,0,0,0,,Сонымен
Dialogue: 0,0:19:38.00,0:19:40.00,Default,,0,0,0,,Егер сіз бейнені зерттесеңіз
Dialogue: 0,0:19:40.00,0:19:42.00,Default,,0,0,0,,Мүмкін мен теледидар жұмысын жасай аламын.
Dialogue: 0,0:19:42.00,0:19:44.00,Default,,0,0,0,,Жарайды, екеу болсын.
Dialogue: 0,0:19:44.00,0:19:46.00,Default,,0,0,0,,Мен өнер университетіне үшінші курста келдім.
Dialogue: 0,0:19:46.00,0:19:48.00,Default,,0,0,0,,Өнер бөліміне барудағы батылдық
Dialogue: 0,0:19:48.00,0:19:50.00,Default,,0,0,0,,Шынымды айтсам, олай емес еді.
Dialogue: 0,0:19:50.00,0:19:52.00,Default,,0,0,0,,Мен оны ұнататындықтан саламын
Dialogue: 0,0:19:52.00,0:19:54.00,Default,,0,0,0,,Мен сені мүлдем ұната алмаймын
Dialogue: 0,0:19:54.00,0:19:56.00,Default,,0,0,0,,Сенімсіз
Dialogue: 0,0:19:56.00,0:19:58.00,Default,,0,0,0,,Мен мұны құпия ұстадым.
Dialogue: 0,0:19:58.00,0:20:00.00,Default,,0,0,0,,Кёя-кун сияқты
Dialogue: 0,0:20:00.00,0:20:02.00,Default,,0,0,0,,Бір күні нұр үстіне нұр болар
Dialogue: 0,0:20:02.00,0:20:04.00,Default,,0,0,0,,Келесің бе деп.
Dialogue: 0,0:20:06.00,0:20:08.00,Default,,0,0,0,,Бірақ мұндай нәрсе
Dialogue: 0,0:20:08.00,0:20:10.00,Default,,0,0,0,,мүлде келмеді
Dialogue: 0,0:20:10.00,0:20:12.00,Default,,0,0,0,,Жоқ, менікі
Dialogue: 0,0:20:12.00,0:20:14.00,Default,,0,0,0,,Сондықтан мен ойладым
Dialogue: 0,0:20:14.00,0:20:16.00,Default,,0,0,0,,Қазірдің өзінде бірге
Dialogue: 0,0:20:16.00,0:20:18.00,Default,,0,0,0,,Мен сурет салуды тоқтатсам, оңайырақ болар ма еді?
Dialogue: 0,0:20:18.00,0:20:20.00,Default,,0,0,0,,Қолымнан келгеннің бәрін жасадым
Dialogue: 0,0:20:20.00,0:20:22.00,Default,,0,0,0,,Пайдасы жоқ. Бәрі бітті.
Dialogue: 0,0:20:22.00,0:20:24.00,Default,,0,0,0,,Ешқашан сурет салуды тоқтатпаңыз.
Dialogue: 0,0:20:24.00,0:20:26.00,Default,,0,0,0,,Пайдасы жоқ. Бәрі бітті.
Dialogue: 0,0:20:26.00,0:20:28.00,Default,,0,0,0,,Кёя-кун
Dialogue: 0,0:20:28.00,0:20:30.00,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:20:30.00,0:20:32.00,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:20:36.00,0:20:38.00,Default,,0,0,0,,Әрқашан сіздің суретіңізде
Dialogue: 0,0:20:42.00,0:20:44.00,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:20:44.00,0:20:46.00,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:20:46.00,0:20:48.00,Default,,0,0,0,,Шиноакидің картинасы
Dialogue: 0,0:20:48.00,0:20:50.00,Default,,0,0,0,,Алыстан болашаққа
Dialogue: 0,0:20:50.00,0:20:52.00,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:20:52.00,0:20:54.00,Default,,0,0,0,,Түсіру уақыты
Dialogue: 0,0:20:54.00,0:20:56.00,Default,,0,0,0,,Сіз маған айттыңыз.
Dialogue: 0,0:20:56.00,0:20:58.00,Default,,0,0,0,,Мұны мен ғана істей аламын
Dialogue: 0,0:20:58.00,0:21:00.00,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:21:00.00,0:21:02.00,Default,,0,0,0,,Иә
Dialogue: 0,0:21:02.00,0:21:04.00,Default,,0,0,0,,деді
Dialogue: 0,0:21:04.00,0:21:06.00,Default,,0,0,0,,Мен бақытты болдым
Dialogue: 0,0:21:06.00,0:21:08.00,Default,,0,0,0,,Мен қатты толқыдым.
Dialogue: 0,0:21:08.00,0:21:10.00,Default,,0,0,0,,Қандай адам бұлай ойлайды?
Dialogue: 0,0:21:10.00,0:21:12.00,Default,,0,0,0,,Мен көп нәрсені білгім келді.
Dialogue: 0,0:21:12.00,0:21:14.00,Default,,0,0,0,,Акидің суреті
Dialogue: 0,0:21:14.00,0:21:16.00,Default,,0,0,0,,Шешім
Dialogue: 0,0:21:16.00,0:21:18.00,Default,,0,0,0,,Мен мақсатым ретінде Кёя-кунмен бар күшімді саламын.
Dialogue: 0,0:21:18.00,0:21:20.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:21:20.00,0:21:22.00,Default,,0,0,0,,Көп оқы
Dialogue: 0,0:21:22.00,0:21:24.00,Default,,0,0,0,,Кёя-кун көргісі келетін дүние
Dialogue: 0,0:21:24.00,0:21:26.00,Default,,0,0,0,,Мен сурет сала алатын адам болғым келеді.
Dialogue: 0,0:21:26.00,0:21:28.00,Default,,0,0,0,,Кёя-кунның мақсаты бар ма?
Dialogue: 0,0:21:28.00,0:21:30.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:21:30.00,0:21:32.00,Default,,0,0,0,,Иә
Dialogue: 0,0:21:32.00,0:21:34.00,Default,,0,0,0,,Иә
Dialogue: 0,0:21:34.00,0:21:36.00,Default,,0,0,0,,Мен сізге әлі айта алмаймын.
Dialogue: 0,0:21:36.00,0:21:38.00,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:21:38.00,0:21:40.00,Default,,0,0,0,,Акидің суреті
Dialogue: 0,0:21:40.00,0:21:42.00,Default,,0,0,0,,Акидің суреті
Dialogue: 0,0:21:42.00,0:21:44.00,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:21:44.00,0:21:46.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:21:46.00,0:21:48.00,Default,,0,0,0,,Адамдарды сізге қосу үшін бар күшіңізді салыңыз
Dialogue: 0,0:21:48.00,0:21:50.00,Default,,0,0,0,,Сентон
Dialogue: 0,0:21:50.00,0:21:52.00,Default,,0,0,0,,Менің мақсатым
Dialogue: 0,0:21:52.00,0:21:54.00,Default,,0,0,0,,(Балалардың шуы)
Dialogue: 0,0:21:54.00,0:21:56.00,Default,,0,0,0,,10 жылдан кейін осылай айтасың
Dialogue: 0,0:21:56.00,0:21:58.00,Default,,0,0,0,,Менің ремейкім
Dialogue: 0,0:21:58.00,0:22:00.00,Default,,0,0,0,,Бұл тек бастамасы ғана
Dialogue: 0,0:22:12.00,0:22:14.00,Default,,0,0,0,,Акидің суреті
Dialogue: 0,0:22:14.00,0:22:16.00,Default,,0,0,0,,Акидің суреті
