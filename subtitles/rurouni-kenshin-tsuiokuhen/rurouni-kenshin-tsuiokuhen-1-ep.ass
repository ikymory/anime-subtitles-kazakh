Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:41.16,0:00:45.79,Default,,0,0,0,,Заман мен халықтың жүрегі ауырады.
Dialogue: 0,0:01:09.02,0:01:12.03,Default,,0,0,0,,Бұл дәуір күннен күнге аласапыран болып барады.
Dialogue: 0,0:01:12.23,0:01:14.74,Default,,0,0,0,,Егер сізде үлкен күш болса да
Dialogue: 0,0:01:14.94,0:01:18.03,Default,,0,0,0,,Бұл ағынды тоқтату үшін ештеңе істеу мүмкін емес.
Dialogue: 0,0:01:18.57,0:01:19.91,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:01:20.20,0:01:21.03,Default,,0,0,0,,Хмф!
Dialogue: 0,0:01:21.28,0:01:22.24,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:01:27.08,0:01:27.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:46.23,0:01:47.27,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:01:49.35,0:01:51.73,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:02:05.91,0:02:07.75,Default,,0,0,0,,Өтінемін! Бұл бала жалғыз!
Dialogue: 0,0:02:07.87,0:02:09.29,Default,,0,0,0,,Қарама!
Dialogue: 0,0:02:09.79,0:02:11.92,Default,,0,0,0,,Апа, тек сол бала...
Dialogue: 0,0:02:13.59,0:02:15.13,Default,,0,0,0,,Гү…
Dialogue: 0,0:02:20.18,0:02:23.60,Default,,0,0,0,,Шинта Шинта, сен әлі жассың.
Dialogue: 0,0:02:23.72,0:02:26.98,Default,,0,0,0,,Біз сияқты өмір жолыңызды өзіңіз таңдай алмайсыз.
Dialogue: 0,0:02:27.35,0:02:29.19,Default,,0,0,0,,Сондықтан қазір өле алмайсың.
Dialogue: 0,0:02:29.31,0:02:30.69,Default,,0,0,0,,Сіз тірісіз
Dialogue: 0,0:02:30.77,0:02:33.77,Default,,0,0,0,,Өлгендер үшін өмір сүріп, өз өміріңді таңда.
Dialogue: 0,0:02:36.28,0:02:37.82,Default,,0,0,0,,Синта тірі
Dialogue: 0,0:02:39.78,0:02:40.95,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:50.00,0:02:52.67,Default,,0,0,0,,Тікелей... Шинта
Dialogue: 0,0:02:53.67,0:02:55.67,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:03:03.05,0:03:04.26,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:03:04.35,0:03:05.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:06.10,0:03:07.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:08.43,0:03:10.06,Default,,0,0,0,,Бұл кім? Сіз
Dialogue: 0,0:03:10.64,0:03:13.27,Default,,0,0,0,,Өлейін деп тұрған адамның атын атаудың қажеті жоқ.
Dialogue: 0,0:03:15.48,0:03:16.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:25.49,0:03:27.99,Default,,0,0,0,,Бір-бірімізді кездестіруімізге себеп болған қандай да бір байланыс болды.
Dialogue: 0,0:03:28.12,0:03:29.41,Default,,0,0,0,,Жау жеңіліске ұшырады
Dialogue: 0,0:03:30.04,0:03:33.42,Default,,0,0,0,,Кек сақтасаң да, өкінсең де өлген адам қайта тірілмейді.
Dialogue: 0,0:03:34.33,0:03:37.67,Default,,0,0,0,,Өзіңізді жақсы сезіну үшін тек аман қалу жеткілікті.
Dialogue: 0,0:03:49.22,0:03:51.18,Default,,0,0,0,,Бұл кең таралған
Dialogue: 0,0:03:51.39,0:03:54.40,Default,,0,0,0,,Қан мен ақ өрік хош иісі көтеріледі
Dialogue: 0,0:03:54.60,0:03:57.86,Default,,0,0,0,,Қарақшылар иттей өлтірді, тозақ
Dialogue: 0,0:03:58.11,0:04:01.40,Default,,0,0,0,,Сатылып, әйел болу да тозақ.
Dialogue: 0,0:04:01.74,0:04:04.32,Default,,0,0,0,,Иә, бұл жиі кездеседі.
Dialogue: 0,0:04:04.45,0:04:07.08,Default,,0,0,0,,Осы уақытқа дейін және болашақта
Dialogue: 0,0:04:16.58,0:04:20.30,Default,,0,0,0,,Хитен Мицуруги стилінің қағидалары бойынша қылышыңызды сермесеңіз де
Dialogue: 0,0:04:20.42,0:04:23.38,Default,,0,0,0,,Ақыр соңында, кейде ешкімді құтқара алмайды.
Dialogue: 0,0:04:23.84,0:04:26.22,Default,,0,0,0,,Мен міндетті түрде істей алатын нәрсе
Dialogue: 0,0:04:26.39,0:04:29.64,Default,,0,0,0,,Құрбандардың мәйіттерін жерлеу.
Dialogue: 0,0:04:32.35,0:04:33.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:41.78,0:04:45.41,Default,,0,0,0,,Ата-анаңа ғана емес, қарақшыларға да бейіт тұрғыздың ба?
Dialogue: 0,0:04:45.53,0:04:47.62,Default,,0,0,0,,Ата-ананың орнына адамдарды сатып алу
Dialogue: 0,0:04:47.74,0:04:50.20,Default,,0,0,0,,Менің ата-анам өткен жылы корори ауруынан қайтыс болды.
Dialogue: 0,0:04:50.33,0:04:53.16,Default,,0,0,0,,Бірақ қарақшы ма, парақор ма,
Dialogue: 0,0:04:53.25,0:04:55.21,Default,,0,0,0,,Өлсең де өліксің.
Dialogue: 0,0:04:55.75,0:04:57.04,Default,,0,0,0,,Бұл қандай тас?
Dialogue: 0,0:04:57.17,0:05:00.34,Default,,0,0,0,,Касуми-сан Аканэ-сан Сакура-сан
Dialogue: 0,0:05:00.75,0:05:02.71,Default,,0,0,0,,Танысқанымызға бір күн ғана болды.
Dialogue: 0,0:05:02.84,0:05:04.80,Default,,0,0,0,,Себебі мен жалғыз ұл болдым
Dialogue: 0,0:05:05.22,0:05:08.14,Default,,0,0,0,,Мен өмірімді құрбан етсем де, оны қорғауым керек деп ойладым.
Dialogue: 0,0:05:08.26,0:05:09.30,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:10.31,0:05:13.56,Default,,0,0,0,,Әркім өзін қорғап, «Тек осы бала» дейді.
Dialogue: 0,0:05:14.48,0:05:16.14,Default,,0,0,0,,Өйткені мен бала едім
Dialogue: 0,0:05:16.39,0:05:20.32,Default,,0,0,0,,Сол үшін жақсы тас іздедім, тым болмаса бейіт болсын.
Dialogue: 0,0:05:21.27,0:05:23.07,Default,,0,0,0,,Бұл менде бар жалғыз нәрсе
Dialogue: 0,0:05:23.23,0:05:24.82,Default,,0,0,0,,Менде оны сүйемелдейтін гүлдер жоқ.
Dialogue: 0,0:05:27.95,0:05:31.08,Default,,0,0,0,,Жақсы сакенің дәмін білмей, Буддалыққа жету бақытсыз болар еді.
Dialogue: 0,0:05:31.28,0:05:33.04,Default,,0,0,0,,Бұл мен үшін.
Dialogue: 0,0:05:34.29,0:05:36.16,Default,,0,0,0,,Рахмет, мм...
Dialogue: 0,0:05:36.58,0:05:38.33,Default,,0,0,0,,Мен Сейжуро Хикомын
Dialogue: 0,0:05:38.46,0:05:39.92,Default,,0,0,0,,Қылышпен жұмыс жасаңыз
Dialogue: 0,0:05:40.00,0:05:41.04,Default,,0,0,0,,Қылыш?
Dialogue: 0,0:05:41.17,0:05:45.67,Default,,0,0,0,,Монк, сіз таптырмас адамды қорғай алмай қалдыңыз.
Dialogue: 0,0:05:46.01,0:05:48.09,Default,,0,0,0,,Сол үш адамның өмірі де маған аманат.
Dialogue: 0,0:05:48.76,0:05:52.10,Default,,0,0,0,,Сенің кішкентай қолдарың мәйіттің салмағын біледі.
Dialogue: 0,0:05:52.22,0:05:55.89,Default,,0,0,0,,Алайда маған аманат етілген өмірдің салмағы онымен салыстыруға келмейді.
Dialogue: 0,0:05:56.06,0:05:58.23,Default,,0,0,0,,Сіз оны арқаңызбен алып жүрдіңіз.
Dialogue: 0,0:05:58.44,0:06:02.57,Default,,0,0,0,,Өзіңізді қолдауға және басқаларды қорғауға күш алыңыз.
Dialogue: 0,0:06:02.98,0:06:04.65,Default,,0,0,0,,Сіз аман қалуыңыз үшін
Dialogue: 0,0:06:04.82,0:06:07.03,Default,,0,0,0,,Маңызды нәрсені қорғау
Dialogue: 0,0:06:07.74,0:06:09.36,Default,,0,0,0,,Қорғау
Dialogue: 0,0:06:09.66,0:06:11.41,Default,,0,0,0,,Монахтың аты кім?
Dialogue: 0,0:06:11.62,0:06:12.58,Default,,0,0,0,,Синта
Dialogue: 0,0:06:12.87,0:06:15.62,Default,,0,0,0,,Тым мейірімді, қылышшыға жарамайды.
Dialogue: 0,0:06:15.79,0:06:18.54,Default,,0,0,0,,Енді сіз өзіңізді Кеншин деп атай аласыз.
Dialogue: 0,0:06:19.04,0:06:20.75,Default,,0,0,0,,Кеншин?
Dialogue: 0,0:06:24.67,0:06:29.01,Default,,0,0,0,,Мен саған ерекше сыйлығымды беремін.
Dialogue: 0,0:06:52.20,0:06:54.95,Default,,0,0,0,,Кеш болды, сәл тезірек алайық.
Dialogue: 0,0:06:55.20,0:06:57.08,Default,,0,0,0,,Мен мұны естідім, Киёсато.
Dialogue: 0,0:06:57.79,0:06:59.96,Default,,0,0,0,,Келесі айда құттықтау болатын сияқты.
Dialogue: 0,0:07:00.04,0:07:00.87,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:07:00.96,0:07:04.67,Default,,0,0,0,,Бала кездегі досыңыз сізге жақсылық көрсеткенін қалайсыз ба?
Dialogue: 0,0:07:06.00,0:07:08.76,Default,,0,0,0,,Мен өзімді нашар сезінемін.
Dialogue: 0,0:07:08.88,0:07:11.43,Default,,0,0,0,,Дүние мұң болса, жалғыз мен...
Dialogue: 0,0:07:11.80,0:07:13.01,Default,,0,0,0,,Не айту керек
Dialogue: 0,0:07:13.34,0:07:14.89,Default,,0,0,0,,Дүниеде не болып жатса да
Dialogue: 0,0:07:14.97,0:07:18.64,Default,,0,0,0,,Әр адамның бақытты болуға талпынуында еш жамандық жоқ.
Dialogue: 0,0:07:28.03,0:07:30.40,Default,,0,0,0,,Мен келесі көктемде қайтуға болады деп ойлаймын.
Dialogue: 0,0:07:32.07,0:07:34.99,Default,,0,0,0,,Біраз уақыт шыдамдылық танытуымыз керек.
Dialogue: 0,0:07:36.28,0:07:37.99,Default,,0,0,0,,Үйге қайтып бара жатқанда қасқыр сатып алайық
Dialogue: 0,0:07:41.50,0:07:44.96,Default,,0,0,0,,Киото Шошидай Шигекура Джубеймен кездесу
Dialogue: 0,0:07:51.55,0:07:53.59,Default,,0,0,0,,Бұдан былай мен аузыма құдайдың жоспарын қосамын.
Dialogue: 0,0:07:54.72,0:07:55.60,Default,,0,0,0,,Сіз өлтірушісіз бе?
Dialogue: 0,0:07:55.72,0:07:58.18,Default,,0,0,0,,Қалай ойлайсыңдар, әлем қылыштың бір серпілісімен өзгереді ме?
Dialogue: 0,0:07:58.47,0:07:59.47,Default,,0,0,0,,Өзіңізді атаңыз!
Dialogue: 0,0:08:01.68,0:08:03.06,Default,,0,0,0,,Маған атыңды айтпа!
Dialogue: 0,0:08:05.94,0:08:06.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:12.45,0:08:14.28,Default,,0,0,0,,Жоқ, сен енді өле алмайсың.
Dialogue: 0,0:08:18.91,0:08:19.74,Default,,0,0,0,,Гуах
Dialogue: 0,0:08:20.08,0:08:21.20,Default,,0,0,0,,Шигекура мырза!
Dialogue: 0,0:08:27.29,0:08:28.88,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:08:29.30,0:08:31.67,Default,,0,0,0,,Мен өле алмаймын, өлгім келмейді
Dialogue: 0,0:08:35.18,0:08:36.18,Default,,0,0,0,,Серіктеріне сенгені өзінің қателігі екенін түсінген Эрен
Dialogue: 0,0:08:37.43,0:08:38.26,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:08:41.22,0:08:43.85,Default,,0,0,0,,Мен өле алмаймын, қазір өле алмаймын
Dialogue: 0,0:08:45.56,0:08:47.69,Default,,0,0,0,,Менің өлгім келмейді. Менің өлгім келмейді.
Dialogue: 0,0:08:49.52,0:08:51.61,Default,,0,0,0,,Өлме! мүлдем
Dialogue: 0,0:08:51.90,0:08:53.40,Default,,0,0,0,,Бұл мені өлтірмейді, бірақ біраз уақыт дұрыс жүре алмайтын шығармын.
Dialogue: 0,0:09:15.97,0:09:19.97,Default,,0,0,0,,Мен... Менің өлгім келмейді.
Dialogue: 0,0:09:21.06,0:09:23.27,Default,,0,0,0,,Яғни, біз кездесуге тиіс едік пе?
Dialogue: 0,0:09:24.06,0:09:27.69,Default,,0,0,0,,Он төрт жыл—
Dialogue: 0,0:09:33.73,0:09:35.03,Default,,0,0,0,,Сондай-ақ...
Dialogue: 0,0:09:42.16,0:09:43.49,Default,,0,0,0,,Гимура: Сені ұрып қалды ма?
Dialogue: 0,0:09:43.58,0:09:45.16,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:09:45.29,0:09:49.54,Default,,0,0,0,,Гимураны ренжітетін біреу болды. Бұл адам өте шебер ме?
Dialogue: 0,0:09:49.88,0:09:51.34,Default,,0,0,0,,Жоқ (Иизука) А?
Dialogue: 0,0:09:53.09,0:09:53.92,Default,,0,0,0,,Оңбау
Dialogue: 0,0:09:54.30,0:09:55.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:55.26,0:09:58.30,Default,,0,0,0,,Иизука мырза, қалғанын шешіңіз.
Dialogue: 0,0:09:58.38,0:09:59.22,Default,,0,0,0,,О... Эй!
Dialogue: 0,0:10:01.39,0:10:02.35,Default,,0,0,0,,Хаа
Dialogue: 0,0:10:02.60,0:10:03.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:07.44,0:10:08.89,Default,,0,0,0,,(судың шашырауы)
Dialogue: 0,0:10:23.58,0:10:26.29,Default,,0,0,0,,Енді жылдамырақ теріңіз.
Dialogue: 0,0:10:29.12,0:10:30.79,Default,,0,0,0,,Бұл жігіт күшейе түседі
Dialogue: 0,0:10:31.08,0:10:33.38,Default,,0,0,0,,Қанша дарынды болсаң да қылыштың,
Dialogue: 0,0:10:33.46,0:10:36.42,Default,,0,0,0,,Күшті болғың келмесе, жақсармайсың.
Dialogue: 0,0:10:36.76,0:10:40.59,Default,,0,0,0,,Бұл жігіт бәрінен де күшті қалайды.
Dialogue: 0,0:10:40.93,0:10:45.31,Default,,0,0,0,,Таза, иә, ақымақ таза.
Dialogue: 0,0:10:47.85,0:10:50.27,Default,,0,0,0,,Хитен Мицуруги стилінің принципі
Dialogue: 0,0:10:52.02,0:10:53.56,Default,,0,0,0,,Мицуруги қылыш
Dialogue: 0,0:10:53.73,0:10:57.36,Default,,0,0,0,,Былайша айтқанда, адам дүниесі үшін ұстаған қылыш болуы керек.
Dialogue: 0,0:10:57.99,0:11:00.24,Default,,0,0,0,,Әлсіздерді қорғау
Dialogue: 0,0:11:01.78,0:11:02.78,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:11:03.57,0:11:04.41,Default,,0,0,0,,Хо
Dialogue: 0,0:11:04.83,0:11:06.87,Default,,0,0,0,,Сізге семсер лақтырған адам болды ма?
Dialogue: 0,0:11:06.95,0:11:08.62,Default,,0,0,0,,Мен ес-түссіз қалдым
Dialogue: 0,0:11:09.00,0:11:10.04,Default,,0,0,0,,Иизука Сіздің қарсыласыңыз кім?
Dialogue: 0,0:11:10.16,0:11:14.54,Default,,0,0,0,,Мен Киото Шошидай Шигекура Джубейдің қызметшісімін. Менің атым бойынша...
Dialogue: 0,0:11:15.17,0:11:16.00,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:16.17,0:11:17.00,Default,,0,0,0,,Не?
Dialogue: 0,0:11:17.42,0:11:20.05,Default,,0,0,0,,Негізі бүгін кешке жеке жиналыс бар.
Dialogue: 0,0:11:20.67,0:11:22.64,Default,,0,0,0,,Минормаро мен Миябе де қатысады.
Dialogue: 0,0:11:22.84,0:11:25.72,Default,,0,0,0,,Бұл доменіміздің болашақ саясатын анықтайтын маңызды орын.
Dialogue: 0,0:11:25.89,0:11:27.10,Default,,0,0,0,,Сіз эскортсыз ба?
Dialogue: 0,0:11:27.39,0:11:31.02,Default,,0,0,0,,Жоқ, сен де сол үстелге келе аласың ба деп ойлап едім.
Dialogue: 0,0:11:31.48,0:11:33.23,Default,,0,0,0,,О, ғажап емес пе?
Dialogue: 0,0:11:33.40,0:11:35.52,Default,,0,0,0,,Мен бас тартамын (Иизука) Иә?
Dialogue: 0,0:11:36.19,0:11:37.53,Default,,0,0,0,,Мен хитокиримін
Dialogue: 0,0:11:37.65,0:11:40.15,Default,,0,0,0,,Одан басқа шаруам жоқ.
Dialogue: 0,0:11:40.49,0:11:42.45,Default,,0,0,0,,Егер сізде басқа пайдалану болмаса, бұл.
Dialogue: 0,0:11:43.28,0:11:44.45,Default,,0,0,0,,Сәлем! Біраз
Dialogue: 0,0:11:44.57,0:11:46.08,Default,,0,0,0,,Ах... кешіріңіз.
Dialogue: 0,0:11:52.54,0:11:54.17,Default,,0,0,0,,Бұл қандай көзқарас?
Dialogue: 0,0:11:54.29,0:11:57.04,Default,,0,0,0,,Катсура-сан маған қамқор болса да.
Dialogue: 0,0:11:59.17,0:12:01.80,Default,,0,0,0,,Ха ха!
Dialogue: 0,0:12:03.80,0:12:04.80,Default,,0,0,0,,Кихетай?
Dialogue: 0,0:12:05.01,0:12:06.01,Default,,0,0,0,,Екеуі де осы Спорт фестивалінде жоғары деңгейдегі нәтижелерге қол жеткізді!
Dialogue: 0,0:12:06.14,0:12:09.31,Default,,0,0,0,,Бұл жігіттің оқ болары сөзсіз.
Dialogue: 0,0:12:09.97,0:12:12.98,Default,,0,0,0,,Бұл балалар мұны кейде үлкен күшпен жасайды.
Dialogue: 0,0:12:13.60,0:12:16.44,Default,,0,0,0,,Сегунатты ақыры құртатындар осы жігіттер.
Dialogue: 0,0:12:16.56,0:12:19.61,Default,,0,0,0,,Бұл ақымақ самурайдан жақсы, бірақ жақсы ма?
Dialogue: 0,0:12:19.69,0:12:22.40,Default,,0,0,0,,Ей, кішіпейіл бола алмайсың.
Dialogue: 0,0:12:22.74,0:12:23.90,Default,,0,0,0,,Келесі!
Dialogue: 0,0:12:25.03,0:12:26.74,Default,,0,0,0,,Ондай балалар да бар ма?
Dialogue: 0,0:12:26.87,0:12:29.41,Default,,0,0,0,,Бейтаныс сарбаздардың оғаштығы - бөтеннің оғаштығы.
Dialogue: 0,0:12:34.83,0:12:36.13,Default,,0,0,0,,О!
Dialogue: 0,0:12:36.46,0:12:38.71,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл жақсы дәм емес пе?
Dialogue: 0,0:12:39.59,0:12:40.42,Default,,0,0,0,,Такасуги
Dialogue: 0,0:12:40.71,0:12:43.72,Default,,0,0,0,,Бұл не, көгершіндей көзіңді айналдырасың ба?
Dialogue: 0,0:12:44.34,0:12:45.93,Default,,0,0,0,,Әлгі бала... (Такасуги) Иә?
Dialogue: 0,0:12:47.18,0:12:48.39,Default,,0,0,0,,Мен оны Киотода алғым келеді
Dialogue: 0,0:13:03.19,0:13:04.57,Default,,0,0,0,,Таудан төмен түсуге болмайды
Dialogue: 0,0:13:04.65,0:13:05.49,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:13:06.41,0:13:07.78,Default,,0,0,0,,Осы уақытта
Dialogue: 0,0:13:07.87,0:13:10.95,Default,,0,0,0,,Көп адамдар аласапыранға түсіп, өлді.
Dialogue: 0,0:13:11.12,0:13:13.00,Default,,0,0,0,,Енді осы қуатты пайдалану уақыты келді.
Dialogue: 0,0:13:13.08,0:13:16.12,Default,,0,0,0,,Адамдарды қорғау үшін Мицуруги стилін қолданудың уақыты келді!
Dialogue: 0,0:13:16.25,0:13:17.79,Default,,0,0,0,,Мынау ақымақ шәкірт!
Dialogue: 0,0:13:19.00,0:13:22.00,Default,,0,0,0,,Осы аласапыран дүниеде жалғыз шықсаң не істейсің?
Dialogue: 0,0:13:22.76,0:13:24.34,Default,,0,0,0,,Мен мына дүбірлі дүниені өзгерткім келеді
Dialogue: 0,0:13:24.42,0:13:27.05,Default,,0,0,0,,Жалғыз нұсқа - режимдердің біріне қосылу.
Dialogue: 0,0:13:27.22,0:13:30.89,Default,,0,0,0,,Бірақ бұл билік арқылы пайдалану дегенді білдіреді.
Dialogue: 0,0:13:31.39,0:13:35.81,Default,,0,0,0,,Мен саған Мицуруги-рюді үйреткенім үшін емес.
Dialogue: 0,0:13:36.31,0:13:39.94,Default,,0,0,0,,Сырттағы ешнәрсеге алаңдамай, тек жаттығуларға көңіл бөлу керек.
Dialogue: 0,0:13:41.11,0:13:43.40,Default,,0,0,0,,Алдымыздағы адамдар қиналып жатыр
Dialogue: 0,0:13:43.48,0:13:45.40,Default,,0,0,0,,Көп адамдар қайғырады
Dialogue: 0,0:13:45.49,0:13:48.45,Default,,0,0,0,,Мен оны жалғыз қалдыра алмаймын!
Dialogue: 0,0:13:49.45,0:13:52.62,Default,,0,0,0,,Хитен Мицуруги-рю - салыстыруға келмейтін ең күшті мектеп.
Dialogue: 0,0:13:52.83,0:13:54.79,Default,,0,0,0,,Мысалы, құрлықтағы қара кеме
Dialogue: 0,0:13:55.04,0:13:57.83,Default,,0,0,0,,Ендеше, қазір бұл күшті қолданудың уақыты келді.
Dialogue: 0,0:13:57.96,0:14:00.42,Default,,0,0,0,,Адамдарды заманның қиындығынан қорғау
Dialogue: 0,0:14:00.54,0:14:01.79,Default,,0,0,0,,Бұл Мицуруги стилі...
Dialogue: 0,0:14:01.92,0:14:04.80,Default,,0,0,0,,Қылыш – өлімші қару, ал қылыш – кісі өлтіру өнері.
Dialogue: 0,0:14:05.59,0:14:08.80,Default,,0,0,0,,Қаншалықты әдемі, сәнді десеңіз де, бұл шындық.
Dialogue: 0,0:14:09.18,0:14:11.35,Default,,0,0,0,,Біреуді қорғау үшін өлтіріңіз
Dialogue: 0,0:14:11.47,0:14:13.51,Default,,0,0,0,,Біреуді құтқару үшін біреуді өлтіру
Dialogue: 0,0:14:13.60,0:14:15.81,Default,,0,0,0,,Бұл қылыштың нағыз қағидасы
Dialogue: 0,0:14:16.60,0:14:21.36,Default,,0,0,0,,Мен сені құтқарған кездегідей жүздеген зұлымдарды өлтірдім.
Dialogue: 0,0:14:21.48,0:14:23.65,Default,,0,0,0,,Бірақ олар да адам.
Dialogue: 0,0:14:24.02,0:14:25.36,Default,,0,0,0,,Осы аласапыран заманда
Dialogue: 0,0:14:25.44,0:14:27.70,Default,,0,0,0,,Мен тек толық өмір сүруге тырыстым.
Dialogue: 0,0:14:28.40,0:14:29.95,Default,,0,0,0,,Осы таудан бір қадам шықсаң
Dialogue: 0,0:14:30.03,0:14:33.83,Default,,0,0,0,,Бізді не күтіп тұрғанын өзіміздің қарама-қайшы әділеттілігіміз басқарады.
Dialogue: 0,0:14:33.95,0:14:36.16,Default,,0,0,0,,Тек тойымсыз өлтіру
Dialogue: 0,0:14:36.25,0:14:37.58,Default,,0,0,0,,Егер сіз оған өзіңізді тастасаңыз
Dialogue: 0,0:14:37.71,0:14:41.25,Default,,0,0,0,,Мицуруги стилі сізді жаппай өлтірушіге айналдырады.
Dialogue: 0,0:14:42.71,0:14:45.55,Default,,0,0,0,,Әлі де I
Dialogue: 0,0:14:46.21,0:14:49.22,Default,,0,0,0,,Мен бұл күшімді қиналған адамдарға көмектесу үшін пайдаланғым келеді.
Dialogue: 0,0:14:49.80,0:14:52.60,Default,,0,0,0,,Мүмкіндігінше көп адам, мүмкіндігінше көп өмір сүреді
Dialogue: 0,0:14:52.80,0:14:55.06,Default,,0,0,0,,Мен сені осы қолдармен қорғағым келеді
Dialogue: 0,0:14:55.35,0:14:56.68,Default,,0,0,0,,Сол себепті...
Dialogue: 0,0:14:59.89,0:15:00.73,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:15:01.19,0:15:03.36,Default,,0,0,0,,Мен енді сен сияқты ақымақтарды білмеймін.
Dialogue: 0,0:15:03.52,0:15:05.73,Default,,0,0,0,,Кез келген жерге тез барыңыз
Dialogue: 0,0:15:07.57,0:15:10.49,Default,,0,0,0,,Рахмет... Сізге көп рахмет
Dialogue: 0,0:15:11.57,0:15:13.03,Default,,0,0,0,,Менің ақымақ шәкіртім
Dialogue: 0,0:15:13.12,0:15:16.29,Default,,0,0,0,,Бұл сіздің өмір жолыңызды ақымақтықпен таңдағаныңызды білдіреді.
Dialogue: 0,0:15:16.83,0:15:22.04,Default,,0,0,0,,Таза болғандықтан, бұл да айналып өтпейтін жол.
Dialogue: 0,0:15:32.84,0:15:34.60,Default,,0,0,0,,Қан ағып жатыр.
Dialogue: 0,0:15:39.31,0:15:41.85,Default,,0,0,0,,Бүгін күн өте жылы.
Dialogue: 0,0:15:41.98,0:15:45.36,Default,,0,0,0,,Кеше ғана қар жауды.
Dialogue: 0,0:16:08.80,0:16:09.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:10.26,0:16:11.97,Default,,0,0,0,,Сайто мырза, не болды?
Dialogue: 0,0:16:12.17,0:16:14.01,Default,,0,0,0,,Мен қан иісін сезіндім деп ойладым.
Dialogue: 0,0:16:15.39,0:16:17.22,Default,,0,0,0,,Жоқ, Сайто мырза
Dialogue: 0,0:16:17.35,0:16:19.52,Default,,0,0,0,,Менің ойымша, сіз соңғы уақытта тым көп кесіп жібердіңіз.
Dialogue: 0,0:16:19.93,0:16:21.27,Default,,0,0,0,,Окита-кун (Окита) Иә?
Dialogue: 0,0:16:21.68,0:16:24.14,Default,,0,0,0,,Сөздерді мұқият шайнап, мұқият тексеру керек.
Dialogue: 0,0:16:24.23,0:16:25.85,Default,,0,0,0,,Оны аузыңа сал
Dialogue: 0,0:16:26.23,0:16:27.15,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:16:32.65,0:16:35.66,Default,,0,0,0,,көшенің қақ ортасына намыстанып бара жатыр
Dialogue: 0,0:16:38.03,0:16:39.28,Default,,0,0,0,,Мен сенен бүгін кешке сұраймын.
Dialogue: 0,0:16:40.79,0:16:42.91,Default,,0,0,0,,Иә? Жақсы иіс шығады.
Dialogue: 0,0:16:43.04,0:16:44.08,Default,,0,0,0,,Ақ өрік хош иісті зат
Dialogue: 0,0:16:44.16,0:16:47.42,Default,,0,0,0,,Сіз таңқаларлық сексуалды иісті де білесіз бе?
Dialogue: 0,0:16:47.63,0:16:48.67,Default,,0,0,0,,Бұл әйел?
Dialogue: 0,0:16:52.97,0:16:54.68,Default,,0,0,0,,Ол жақсы әйел.
Dialogue: 0,0:16:59.26,0:17:00.81,Default,,0,0,0,,Олай болса, кейінірек.
Dialogue: 0,0:17:14.40,0:17:18.32,Default,,0,0,0,,Маған ұнамайды. Мен көшеде Мибудың қасқырларына тап болдым.
Dialogue: 0,0:17:18.49,0:17:20.53,Default,,0,0,0,,Қорыққаным сонша, жолды ашық қалдырдым.
Dialogue: 0,0:17:21.24,0:17:24.50,Default,,0,0,0,,Патриоттарды сұрақ-жауапсыз лақтырып жатыр деген қауесет бар.
Dialogue: 0,0:17:25.12,0:17:26.08,Default,,0,0,0,,О, қорқынышты!
Dialogue: 0,0:17:29.13,0:17:31.55,Default,,0,0,0,,Көктемде түнде шие, жазда жұлдыз гүлдейді
Dialogue: 0,0:17:32.17,0:17:34.72,Default,,0,0,0,,Күзде толған ай, қыста қар
Dialogue: 0,0:17:34.88,0:17:36.93,Default,,0,0,0,,Жетер, саке жақсы.
Dialogue: 0,0:17:37.63,0:17:39.26,Default,,0,0,0,,Егер ол әлі де дәмді болмаса
Dialogue: 0,0:17:39.43,0:17:42.35,Default,,0,0,0,,Бұл сіздің ішіңіздегі бірдеңенің ауырғанының дәлелі.
Dialogue: 0,0:17:45.31,0:17:48.81,Default,,0,0,0,,Хе, сен де бір күні ішімдіктің дәмін татарсың.
Dialogue: 0,0:17:49.15,0:17:51.57,Default,,0,0,0,,Сол кезде жақсы саке ішейік
Dialogue: 0,0:17:56.36,0:17:58.07,Default,,0,0,0,,Ол әйелді тоқтататын кез келді.
Dialogue: 0,0:17:58.16,0:18:00.87,Default,,0,0,0,,Кешіріңіз, мен оны ұмыта алмаймын.
Dialogue: 0,0:18:12.75,0:18:14.13,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:18:28.44,0:18:30.44,Default,,0,0,0,,Соңғы кездері ерекше таң қалдырдың.
Dialogue: 0,0:18:31.06,0:18:32.06,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:32.19,0:18:34.73,Default,,0,0,0,,Басқа адамға айғайлауға уақыт бермеңіз
Dialogue: 0,0:18:36.90,0:18:37.78,Default,,0,0,0,,Тағы да сәлем.
Dialogue: 0,0:18:46.04,0:18:47.75,Default,,0,0,0,,Сіз бұл ырым туралы естідіңіз бе?
Dialogue: 0,0:18:48.41,0:18:51.17,Default,,0,0,0,,Қатты ызаға толы қылыш жарасы
Dialogue: 0,0:18:51.29,0:18:54.63,Default,,0,0,0,,Бұл сезім сейілмейінше, ол ешқашан жоғалмайды.
Dialogue: 0,0:18:55.34,0:18:57.76,Default,,0,0,0,,Кектенген семсер жарасы
Dialogue: 0,0:18:58.42,0:19:02.09,Default,,0,0,0,,Иә, ол мәңгілікке жойылмайтын сияқты.
Dialogue: 0,0:19:02.47,0:19:06.10,Default,,0,0,0,,(ағаш таяқпен ұрған дыбыс)
Dialogue: 0,0:19:15.48,0:19:16.32,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:19.82,0:19:21.16,Default,,0,0,0,,Әпке
Dialogue: 0,0:19:25.78,0:19:27.33,Default,,0,0,0,,Сіз оны әлі жуып үлгердіңіз бе?
Dialogue: 0,0:19:28.87,0:19:32.08,Default,,0,0,0,,Енді ойлап қарасам, кешегі кездесу қиын болған сияқты.
Dialogue: 0,0:19:32.21,0:19:33.21,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:33.33,0:19:37.00,Default,,0,0,0,,Жоқ, мен Миябе мырза мен Катсура мырзаның бір-бірімен төбелескенін естідім.
Dialogue: 0,0:19:38.71,0:19:40.13,Default,,0,0,0,,Сәлем, Миябе-сан және т.б
Dialogue: 0,0:19:40.26,0:19:42.93,Default,,0,0,0,,Ол осы астанада бір сұмдық жасауды жоспарлап отырған сияқты.
Dialogue: 0,0:19:43.18,0:19:44.34,Default,,0,0,0,,Кацура-сан ше?
Dialogue: 0,0:19:44.60,0:19:46.72,Default,,0,0,0,,Қазір уақыт емес.
Dialogue: 0,0:19:46.81,0:19:48.52,Default,,0,0,0,,Мен өзіммен бірге болған адам туралы айтып отырмын.
Dialogue: 0,0:19:48.64,0:19:50.93,Default,,0,0,0,,Ол Миябе-санды ұрып жібере жаздады.
Dialogue: 0,0:19:51.48,0:19:53.10,Default,,0,0,0,,Бұл тыныш емес.
Dialogue: 0,0:19:53.19,0:19:54.44,Default,,0,0,0,,Мүлде жоқ
Dialogue: 0,0:19:58.61,0:20:00.28,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:20:00.82,0:20:03.11,Default,,0,0,0,,Сіз біреуді кесіп тастай аласыз ба?
Dialogue: 0,0:20:03.28,0:20:05.03,Default,,0,0,0,,Мен жақсы болғым келмейді.
Dialogue: 0,0:20:05.16,0:20:06.45,Default,,0,0,0,,Бұл кісі өлтіру
Dialogue: 0,0:20:06.62,0:20:10.58,Default,,0,0,0,,Бірақ жаңа әлем құру үшін біз ескіні жоюымыз керек.
Dialogue: 0,0:20:10.95,0:20:13.92,Default,,0,0,0,,Бұл ұнамсыз рөл, бірақ оны біреу орындауы керек.
Dialogue: 0,0:20:14.71,0:20:18.80,Default,,0,0,0,,Сіз өзіңіздің өкілеттіктеріңізді адамдарды қорғау үшін пайдаланғыңыз келетінін айттыңыз.
Dialogue: 0,0:20:19.00,0:20:21.67,Default,,0,0,0,,Олай болса, маған сол билікті беріңізші.
Dialogue: 0,0:20:22.01,0:20:25.09,Default,,0,0,0,,Жаңа дәуір үшін сіз адамдарды өлтіре аласыз ба?
Dialogue: 0,0:20:45.24,0:20:46.37,Default,,0,0,0,,Хе-хе, рақмет
Dialogue: 0,0:20:47.32,0:20:48.16,Default,,0,0,0,,осы портта бір жерде жасырынып, бізді бақылап отыр.
Dialogue: 0,0:20:48.28,0:20:49.74,Default,,0,0,0,,Бұл Айзука, инспектор.
Dialogue: 0,0:20:51.45,0:20:54.75,Default,,0,0,0,,Бұл жұмысты бірінші рет жасап тұрсыз, солай ма? Сақ болыңыз
Dialogue: 0,0:20:54.92,0:20:56.33,Default,,0,0,0,,Кейде мен ақыл-ойымды жоғалтып аламын
Dialogue: 0,0:20:56.50,0:20:58.92,Default,,0,0,0,,Тамақ іше алмай құлап қалатындар бар.
Dialogue: 0,0:20:59.25,0:21:00.46,Default,,0,0,0,,Жарайды
Dialogue: 0,0:21:00.59,0:21:02.46,Default,,0,0,0,,Бұл мен күткеннен де жақсы болды.
Dialogue: 0,0:21:02.63,0:21:03.63,Default,,0,0,0,,жақсы
Dialogue: 0,0:21:04.30,0:21:07.34,Default,,0,0,0,,Бұл жұмыстың ұраны - жылдам, дәл және сенімді болу.
Dialogue: 0,0:21:07.55,0:21:09.68,Default,,0,0,0,,Ұзақ тұрудың қажеті жоқ, тек адасып кетіңіз.
Dialogue: 0,0:21:10.89,0:21:15.48,Default,,0,0,0,,Менің қанды семсерім мен құрбан болған өмірімнен басқа
Dialogue: 0,0:21:16.23,0:21:19.69,Default,,0,0,0,,Барлығы бейбіт өмір сүретін жаңа дәуір болса ше?
Dialogue: 0,0:21:20.40,0:21:21.69,Default,,0,0,0,,Мен...
Dialogue: 0,0:21:28.45,0:21:29.83,Default,,0,0,0,,Аспан орнында
Dialogue: 0,0:21:35.37,0:21:36.54,Default,,0,0,0,,Біреуді өлтіру
Dialogue: 0,0:21:47.47,0:21:48.93,Default,,0,0,0,,Мына бала ше?
Dialogue: 0,0:21:49.14,0:21:50.43,Default,,0,0,0,,Керемет
Dialogue: 0,0:21:50.55,0:21:53.72,Default,,0,0,0,,Шынымды айтсам, бұл оғаш сарбаздардың қожайынына арналған жолбарыстың күшігі.
Dialogue: 0,0:21:53.81,0:21:55.98,Default,,0,0,0,,Менен сұрасаң, беремін.
Dialogue: 0,0:21:56.27,0:21:58.10,Default,,0,0,0,,Бірақ бір шарт бар.
Dialogue: 0,0:21:58.23,0:21:59.06,Default,,0,0,0,,Не?
Dialogue: 0,0:21:59.73,0:22:02.61,Default,,0,0,0,,Баланың өмірін құртқаны үшін.
Dialogue: 0,0:22:02.73,0:22:05.32,Default,,0,0,0,,Өзіңізді таза ұстаңыз.
Dialogue: 0,0:22:05.57,0:22:08.99,Default,,0,0,0,,Бұдан былай сен ешқашан қылышыңды суырмайсың.
Dialogue: 0,0:22:09.53,0:22:13.24,Default,,0,0,0,,Мен қазір Чошу руындағы Ишин патриоттарының жетекшісімін.
Dialogue: 0,0:22:13.54,0:22:14.79,Default,,0,0,0,,Әрине, менің олай етуге ниетім жоқ.
Dialogue: 0,0:22:15.08,0:22:16.08,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:22:16.62,0:22:17.79,Default,,0,0,0,,Уәде берейік
Dialogue: 0,0:22:18.71,0:22:21.84,Default,,0,0,0,,Бүгін семсерші Кацура Когороның қайтыс болған күні.
Dialogue: 0,0:22:22.42,0:22:27.17,Default,,0,0,0,,Сондықтан сіз Бакумацу фестивалінде Чошу микоши бола аласыз.
Dialogue: 0,0:22:27.47,0:22:29.34,Default,,0,0,0,,Гагакуды маған қалдырыңыз
Dialogue: 0,0:22:30.18,0:22:31.09,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:22:33.10,0:22:39.10,Default,,0,0,0,,(Шәмисен спектаклі)
Dialogue: 0,0:22:55.95,0:22:59.50,Default,,0,0,0,,Менің тәнім мәңгілік, Мұсашы өрісінде шіримейді.
Dialogue: 0,0:22:59.66,0:23:02.38,Default,,0,0,0,,Ұсталған Ямато жаны
Dialogue: 0,0:23:05.63,0:23:08.09,Default,,0,0,0,,Сегунат мұғалімді жаншып өлтірді.
Dialogue: 0,0:23:08.26,0:23:10.55,Default,,0,0,0,,Бірақ сол асыл мұрат әлі де жалғасын табуда.
Dialogue: 0,0:23:11.26,0:23:12.14,Default,,0,0,0,,Жынды!
Dialogue: 0,0:23:12.68,0:23:15.64,Default,,0,0,0,,Әділдіктің мінсіздігі сонша, ол есінен тануға батылы барады!
Dialogue: 0,0:23:15.93,0:23:19.73,Default,,0,0,0,,Бұл қазіргі Чошу руы, жоқ, бұл менің қозғаушы күшім.
Dialogue: 0,0:23:20.60,0:23:23.48,Default,,0,0,0,,Қане, бұл жігіт ешнәрсе істемейді.
Dialogue: 0,0:23:38.91,0:23:41.08,Default,,0,0,0,,Таңертең ұйықтауға уақыт жоқ сияқты.
Dialogue: 0,0:23:42.25,0:23:44.17,Default,,0,0,0,,Хитокири Баттоусай күткендей
Dialogue: 0,0:23:44.92,0:23:48.09,Default,,0,0,0,,Осының бәрін істегеннен кейін, маған қан төгілмеді дегенге сене алар емеспін.
Dialogue: 0,0:23:48.46,0:23:50.42,Default,,0,0,0,,Үйге қайтып бара жатқанда сусын алғыңыз келе ме?
Dialogue: 0,0:23:50.51,0:23:51.72,Default,,0,0,0,,Жоқ, I
Dialogue: 0,0:23:52.18,0:23:55.22,Default,,0,0,0,,Түсіндім, неге жалғыз және жалғыз ішпейсің?
Dialogue: 0,0:23:55.30,0:23:56.14,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:23:58.60,0:23:59.68,Default,,0,0,0,,Содан бері бір жыл
Dialogue: 0,0:24:00.14,0:24:04.10,Default,,0,0,0,,Мүмкін ол жетілген көрінгендіктен шығар, бірақ оның мінез-құлқы өзгерді.
Dialogue: 0,0:24:05.69,0:24:09.19,Default,,0,0,0,,Бірақ жүрегімнің іші дәл бұрынғыдай, кіршіксіз.
Dialogue: 0,0:24:09.82,0:24:11.40,Default,,0,0,0,,Сонда сіз сенімді бола аласыз.
Dialogue: 0,0:24:11.53,0:24:13.86,Default,,0,0,0,,Жоқ, ол жерде болмағандықтан.
Dialogue: 0,0:24:14.11,0:24:17.03,Default,,0,0,0,,Мен қазір кім екенімде үлкен алшақтықты сезіне бастадым.
Dialogue: 0,0:24:17.66,0:24:18.91,Default,,0,0,0,,Хитокири ретінде өзіме
Dialogue: 0,0:24:46.94,0:24:48.40,Default,,0,0,0,,Шинсенгуми?
Dialogue: 0,0:24:48.52,0:24:51.61,Default,,0,0,0,,Жоқ, мен сияқты көлеңкелі өлтіруші.
Dialogue: 0,0:24:52.19,0:24:53.49,Default,,0,0,0,,Бүгін кешке осыны қалаймын
Dialogue: 0,0:24:53.57,0:24:54.82,Default,,0,0,0,,Хмм, сәттілік.
Dialogue: 0,0:24:55.11,0:24:58.20,Default,,0,0,0,,Миябе мырза және басқалар, мен тағы біраз ұстаймын.
Dialogue: 0,0:24:58.33,0:25:02.00,Default,,0,0,0,,Өтінемін, маған Шинсенгумиден сақ болу керектігін еске салыңыз.
Dialogue: 0,0:25:02.12,0:25:02.95,Default,,0,0,0,,Ха!
Dialogue: 0,0:25:07.21,0:25:08.34,Default,,0,0,0,,Бүгін түнде ме?
Dialogue: 0,0:25:08.42,0:25:10.17,Default,,0,0,0,,Әй, ел бітті.
Dialogue: 0,0:25:10.25,0:25:11.67,Default,,0,0,0,,Мен толтыруға тапсырыс бере аламын ба?
Dialogue: 0,0:25:12.17,0:25:14.67,Default,,0,0,0,,Жоқ, жарайды, алкогольдің дәмі нашар.
Dialogue: 0,0:25:14.84,0:25:16.38,Default,,0,0,0,,Оны қайдан алдың?
Dialogue: 0,0:25:17.18,0:25:19.89,Default,,0,0,0,,Киотоға от жағу ақылға сыймайды.
Dialogue: 0,0:26:01.14,0:26:03.56,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:26:23.45,0:26:24.45,Default,,0,0,0,,Өлімдік күнәлардың кардиналына тән нәрсе деп айтуға болатын шығар.
Dialogue: 0,0:26:28.87,0:26:32.29,Default,,0,0,0,,Сіз шынымен жаңбыр жаудырасыз, солай емес пе?
Dialogue: 0,0:26:33.46,0:26:35.42,Default,,0,0,0,,Қанды жаңбыр
Dialogue: 0,0:26:57.78,0:27:03.78,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:28:20.61,0:28:26.62,Default,,0,0,0,,~♪
Dialogue: 0,0:28:28.16,0:28:32.75,Default,,0,0,0,,Көк жанның гүлі шашылып, қызыл қанның жемісі піседі.
Dialogue: 0,0:28:33.71,0:28:36.08,Default,,0,0,0,,Ақшыл күрсініс, кебектің көлеңкесі
Dialogue: 0,0:28:36.71,0:28:38.71,Default,,0,0,0,,Бір-бірінің үстіне түскен қолдар туралы естеліктер
Dialogue: 0,0:28:39.05,0:28:40.46,Default,,0,0,0,,Бұл иллюзия
Dialogue: 0,0:28:42.67,0:28:44.47,Default,,0,0,0,,«Руруни Кеншин: естеліктер»
Dialogue: 0,0:28:44.63,0:28:47.10,Default,,0,0,0,,2-акт «Адасқан мысық»
Dialogue: 0,0:28:48.60,0:28:53.60,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
