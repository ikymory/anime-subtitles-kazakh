Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.62,0:00:06.63,Default,,0,0,0,,♪~
Dialogue: 0,0:01:25.50,0:01:30.50,Default,,0,0,0,,~♪
Dialogue: 0,0:01:32.30,0:01:35.17,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:01:35.97,0:01:37.13,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:01:38.09,0:01:39.39,Default,,0,0,0,,Кааааа...
Dialogue: 0,0:01:40.09,0:01:42.14,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:01:42.26,0:01:43.35,Default,,0,0,0,,Әй, сағат неше болды?
Dialogue: 0,0:01:43.68,0:01:46.85,Default,,0,0,0,,Өте қиын, аға! Сағат 9 болды!
Dialogue: 0,0:01:46.98,0:01:50.15,Default,,0,0,0,,Ма... бұл жаман, кел Бонни!
Dialogue: 0,0:01:50.27,0:01:52.19,Default,,0,0,0,,Мен олардың ізі, тырнақ іздері немесе нәжістерін көріп тұрған жоқпын.
Dialogue: 0,0:01:52.32,0:01:53.82,Default,,0,0,0,,(Боннидің асығыс дыбысы)
Dialogue: 0,0:01:58.49,0:02:00.37,Default,,0,0,0,,Уау! Гах...
Dialogue: 0,0:02:00.78,0:02:03.37,Default,,0,0,0,,Уау! Гах... Гах...
Dialogue: 0,0:02:06.58,0:02:08.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:12.59,0:02:15.05,Default,,0,0,0,,Фу... Сен істейсің, Бонни-чан.
Dialogue: 0,0:02:15.17,0:02:16.80,Default,,0,0,0,,Бірақ бүгін уақытым жоқ.
Dialogue: 0,0:02:16.92,0:02:19.30,Default,,0,0,0,,Тезірек, мені айдап жібер!
Dialogue: 0,0:02:21.43,0:02:23.64,Default,,0,0,0,,Даха!
Dialogue: 0,0:02:23.85,0:02:25.60,Default,,0,0,0,,Тоқта, қашып барасың ба?
Dialogue: 0,0:02:26.77,0:02:28.10,Default,,0,0,0,,Аһ!
Dialogue: 0,0:02:28.23,0:02:30.85,Default,,0,0,0,,Кім қашады! Бұл одуванчик!
Dialogue: 0,0:02:30.98,0:02:34.07,Default,,0,0,0,,Мен ертең сенімен міндетті түрде шешемін!
Dialogue: 0,0:02:34.19,0:02:37.28,Default,,0,0,0,,Оған дейін, сонда тыныш күт!
Dialogue: 0,0:02:37.74,0:02:41.07,Default,,0,0,0,,Оны жайнатып, қашып кетпеңіз!
Dialogue: 0,0:02:41.20,0:02:42.24,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:02:42.91,0:02:43.87,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:02:44.41,0:02:46.37,Default,,0,0,0,,Ақымақ болма! Мынау...
Dialogue: 0,0:02:46.49,0:02:48.00,Default,,0,0,0,,Ой... ау... ау!
Dialogue: 0,0:02:48.12,0:02:51.83,Default,,0,0,0,,Гехо Гехо Гехо... Сызықтар... Гохо
Dialogue: 0,0:02:52.50,0:02:54.46,Default,,0,0,0,,Гехо... Иә!
Dialogue: 0,0:02:56.50,0:02:58.34,Default,,0,0,0,,Ол жоғалды.
Dialogue: 0,0:02:59.84,0:03:02.64,Default,,0,0,0,,Бұл апат болды. Айтатын сөзім жоқ.
Dialogue: 0,0:03:03.51,0:03:04.64,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:05.05,0:03:08.85,Default,,0,0,0,,Чикусо! Бұл не?
Dialogue: 0,0:03:11.52,0:03:13.52,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:03:13.98,0:03:15.98,Default,,0,0,0,,(әтеш айқайлайды)
Dialogue: 0,0:03:24.78,0:03:27.20,Default,,0,0,0,,Амансың ба? Котанбо мырза
Dialogue: 0,0:03:27.33,0:03:29.54,Default,,0,0,0,,Жара әйтеуір жабылды, бірақ...
Dialogue: 0,0:03:30.20,0:03:32.83,Default,,0,0,0,,Үлкен жігіттің дене күші болады.
Dialogue: 0,0:03:30.20,0:03:32.83,Default,,0,0,0,,(Китанбоның қорылдауы)
Dialogue: 0,0:03:33.50,0:03:35.88,Default,,0,0,0,,Кішкене болса жарайды.
Dialogue: 0,0:03:36.00,0:03:39.84,Default,,0,0,0,,Дұрыс, ол сондай үлкен және күшті.
Dialogue: 0,0:03:39.96,0:03:41.13,Default,,0,0,0,,Мен бәрі жақсы болатынына сенімдімін.
Dialogue: 0,0:03:41.93,0:03:43.80,Default,,0,0,0,,Әлі-
Dialogue: 0,0:03:43.93,0:03:48.14,Default,,0,0,0,,Мен кездесейін деп жатқан Куукаку Шиба деген кім?
Dialogue: 0,0:03:49.81,0:03:53.27,Default,,0,0,0,,Йоруичи-сан маған ешқандай мәліметтерді айтпайды.
Dialogue: 0,0:03:53.56,0:03:59.53,Default,,0,0,0,,Қақпадан өтпей-ақ Сейрейтейге кірудің жалғыз жолын сен білетін адамсың, солай ма?
Dialogue: 0,0:03:59.65,0:04:02.24,Default,,0,0,0,,Ол атақты спикер болса керек.
Dialogue: 0,0:04:02.70,0:04:07.45,Default,,0,0,0,,А-а, мен оның асыл тұқымды жоғары санатты мысық екеніне сенімдімін.
Dialogue: 0,0:04:07.99,0:04:09.20,Default,,0,0,0,,Парсы т.б.
Dialogue: 0,0:04:09.33,0:04:11.58,Default,,0,0,0,,Американдық шорт
Dialogue: 0,0:04:11.70,0:04:13.92,Default,,0,0,0,,Далматия т.б.
Dialogue: 0,0:04:14.04,0:04:15.79,Default,,0,0,0,,Inoue (Orihime) Иә?
Dialogue: 0,0:04:16.42,0:04:18.46,Default,,0,0,0,,Мен Йоруичи-санмен таныс болғаным үшін...
Dialogue: 0,0:04:18.59,0:04:20.51,Default,,0,0,0,,Міндетті түрде мысық емес
Dialogue: 0,0:04:21.01,0:04:22.26,Default,,0,0,0,,Және Далматия
Dialogue: 0,0:04:23.22,0:04:24.30,Default,,0,0,0,,Бұл ит!
Dialogue: 0,0:04:24.93,0:04:26.26,Default,,0,0,0,,Аттракцион саябағы болса да, жан-жағында бір адам жоқ—
Dialogue: 0,0:04:27.22,0:04:29.51,Default,,0,0,0,,Жоқ, есімнен алған әсерге сүйене отырып.
Dialogue: 0,0:04:29.64,0:04:33.35,Default,,0,0,0,,Мен оның самурай сияқты үлкен, үлкен жігіт екеніне сенімдімін.
Dialogue: 0,0:04:33.48,0:04:36.35,Default,,0,0,0,,Жоқ, ол дәурен сияқты ескі қожайын шығар.
Dialogue: 0,0:04:36.52,0:04:38.27,Default,,0,0,0,,Олар үшін де тойып жеңіздер
Dialogue: 0,0:04:39.07,0:04:43.03,Default,,0,0,0,,Ал... енді былай.
Dialogue: 0,0:04:43.15,0:04:45.49,Default,,0,0,0,,Ал...
Dialogue: 0,0:04:47.16,0:04:48.95,Default,,0,0,0,,Ах... (Орихиме) Мм...
Dialogue: 0,0:04:49.83,0:04:50.91,Default,,0,0,0,,Дайын!
Dialogue: 0,0:04:51.24,0:04:55.04,Default,,0,0,0,,Мысық құлақтары мен құйрығы бар гермит тәрізді мачо самурай!
Dialogue: 0,0:04:55.16,0:04:56.37,Default,,0,0,0,,​​Күмән жоқ!
Dialogue: 0,0:04:56.50,0:04:58.08,Default,,0,0,0,,Жоқ, мен қандай сурет екенін білмеймін.
Dialogue: 0,0:04:58.21,0:05:01.92,Default,,0,0,0,,Ал, гитара ұстаған арық самурай ше?
Dialogue: 0,0:05:02.05,0:05:04.42,Default,,0,0,0,,Хаха, сен түсінбейсің, Иноуэ-сан.
Dialogue: 0,0:05:04.55,0:05:05.93,Default,,0,0,0,,Плащ кию керек
Dialogue: 0,0:05:06.05,0:05:08.26,Default,,0,0,0,,О, қандай ұят!
Dialogue: 0,0:05:09.51,0:05:12.02,Default,,0,0,0,,Солай бола тұра, бәрі кеш, Куросаки.
Dialogue: 0,0:05:12.14,0:05:13.89,Default,,0,0,0,,Сізге телефон соғуға болады ма?
Dialogue: 0,0:05:14.02,0:05:16.19,Default,,0,0,0,,Жоқ, мен қараймын.
Dialogue: 0,0:05:17.98,0:05:21.65,Default,,0,0,0,,Олай болса, мен келесі Шиба Кукаку туралы ойлауым керек.
Dialogue: 0,0:05:22.94,0:05:23.78,Default,,0,0,0,,Ал...
Dialogue: 0,0:05:23.90,0:05:26.57,Default,,0,0,0,,Жоқ, бұл туралы ойланудың қажеті жоқ.
Dialogue: 0,0:05:26.70,0:05:27.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:28.28,0:05:30.99,Default,,0,0,0,,Иә? Бармайсың!?
Dialogue: 0,0:05:31.12,0:05:32.20,Default,,0,0,0,,Барма
Dialogue: 0,0:05:32.33,0:05:34.16,Default,,0,0,0,,Мен саған алға жүр дедім.
Dialogue: 0,0:05:34.66,0:05:37.54,Default,,0,0,0,,Мен кетер алдында кешегі бейбақпен келісіп алайын.
Dialogue: 0,0:05:37.71,0:05:39.42,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:05:39.54,0:05:41.17,Default,,0,0,0,,Шатасуды доғар!
Dialogue: 0,0:05:41.29,0:05:43.88,Default,,0,0,0,,Ооо... жоқ... жоқ!
Dialogue: 0,0:05:44.51,0:05:46.67,Default,,0,0,0,,Ол сені қашып кетті деп ойлайды!
Dialogue: 0,0:05:46.80,0:05:48.13,Default,,0,0,0,,Ойлан!
Dialogue: 0,0:05:48.63,0:05:51.72,Default,,0,0,0,,Әй, сен әлі кетпейсің бе?
Dialogue: 0,0:05:51.85,0:05:52.68,Default,,0,0,0,,Инуэ мырза
Dialogue: 0,0:05:53.26,0:05:56.39,Default,,0,0,0,,Сіз маған мына ақымақты осы жерден алып кетуге көмектесе аласыз ба?
Dialogue: 0,0:05:56.93,0:05:58.44,Default,,0,0,0,,Ақымақ кім?
Dialogue: 0,0:05:58.56,0:06:00.23,Default,,0,0,0,,Келсе, шығарып сал.
Dialogue: 0,0:06:00.35,0:06:01.98,Default,,0,0,0,,Мен сені бірден қуамын...
Dialogue: 0,0:06:05.03,0:06:07.82,Default,,0,0,0,,Attah!
Dialogue: 0,0:06:08.65,0:06:11.41,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:06:12.16,0:06:15.87,Default,,0,0,0,,Басыңызға ағып жатқан қан сізді бастапқы мақсатыңызды ұмыттырды ма?
Dialogue: 0,0:06:16.58,0:06:18.21,Default,,0,0,0,,Сен ақымақ
Dialogue: 0,0:06:18.50,0:06:21.33,Default,,0,0,0,,Руқияның өмірі осы жолға байланысты.
Dialogue: 0,0:06:21.46,0:06:24.21,Default,,0,0,0,,Ұмытып кеткен сияқты емес пе?
Dialogue: 0,0:06:25.05,0:06:26.88,Default,,0,0,0,,Сіз бен оның арасында ерік бәсекесі бар.
Dialogue: 0,0:06:27.01,0:06:29.18,Default,,0,0,0,,Менің бос уақытым жоқ.
Dialogue: 0,0:06:29.84,0:06:32.14,Default,,0,0,0,,Түсінсең, тез дайындал.
Dialogue: 0,0:06:33.26,0:06:34.51,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:37.60,0:06:40.60,Default,,0,0,0,,Сол екеу ме?
Dialogue: 0,0:06:45.98,0:06:48.74,Default,,0,0,0,,Бұл не, Ренжи?
Dialogue: 0,0:06:49.40,0:06:51.78,Default,,0,0,0,,Үкім шығару күні алға жылжытылды ма?
Dialogue: 0,0:06:53.49,0:06:56.62,Default,,0,0,0,,Орындауға 14 күннен аз уақыт қалды
Dialogue: 0,0:06:56.99,0:06:59.75,Default,,0,0,0,,Кәдесыйларды пайдалануға рұқсат етіледі.
Dialogue: 0,0:07:00.04,0:07:02.75,Default,,0,0,0,,Теманы Сотталғандар сарайының төрт терең абақтысына ауыстыру
Dialogue: 0,0:07:13.30,0:07:14.14,Default,,0,0,0,,Эй
Dialogue: 0,0:07:14.76,0:07:18.06,Default,,0,0,0,,Ауылдың шетіне дейін ұзақ жол жүрген сияқтымыз...
Dialogue: 0,0:07:18.18,0:07:20.52,Default,,0,0,0,,Бұл шынымен дұрыс па?
Dialogue: 0,0:07:21.23,0:07:22.40,Default,,0,0,0,,Ал егер
Dialogue: 0,0:07:22.52,0:07:23.69,Default,,0,0,0,,Шулы!
Dialogue: 0,0:07:23.81,0:07:25.36,Default,,0,0,0,,Картада ақсақал маған берді—
Dialogue: 0,0:07:25.48,0:07:27.73,Default,,0,0,0,,Бұл жерде екені анық.
Dialogue: 0,0:07:27.86,0:07:31.20,Default,,0,0,0,,Егер сізде шағымданатын нәрсе болса, сіз жетекшілік етуіңіз керек.
Dialogue: 0,0:07:31.70,0:07:34.49,Default,,0,0,0,,Жоқ, менің шағымданатын ештеңем жоқ.
Dialogue: 0,0:07:34.62,0:07:36.37,Default,,0,0,0,,Мен Куцуру Шиба екеніне сенімдімін...
Dialogue: 0,0:07:36.49,0:07:40.66,Default,,0,0,0,,Мен осындай жерде тұрып жатырмын, өйткені мен өзімнің шынайы болмысымды құпия сақтағым келеді.
Dialogue: 0,0:07:41.12,0:07:43.67,Default,,0,0,0,,Өкінішке орай, олай емес.
Dialogue: 0,0:07:43.79,0:07:45.79,Default,,0,0,0,,Оның табиғатына байланысты.
Dialogue: 0,0:07:45.92,0:07:47.88,Default,,0,0,0,,Маған осындай жерлер ұнайды.
Dialogue: 0,0:07:50.05,0:07:51.01,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:07:51.13,0:07:53.18,Default,,0,0,0,,Тұрғылықты жерін ауыстыра береді, бірақ...
Dialogue: 0,0:07:53.30,0:07:55.43,Default,,0,0,0,,Тек үйлер әрқашан бірдей салынады.
Dialogue: 0,0:07:56.47,0:07:58.89,Default,,0,0,0,,Қарасам бір қарағанда айта аламын.
Dialogue: 0,0:07:59.56,0:08:00.85,Default,,0,0,0,,Бір қарағанда емес
Dialogue: 0,0:08:01.06,0:08:03.52,Default,,0,0,0,,Бір қарағанда дұрыс.
Dialogue: 0,0:08:10.99,0:08:12.28,Default,,0,0,0,,О, мен көрдім.
Dialogue: 0,0:08:12.65,0:08:14.07,Default,,0,0,0,,Міне.
Dialogue: 0,0:08:15.57,0:08:17.03,Default,,0,0,0,,Бұл… (Ишида) Бұл…
Dialogue: 0,0:08:17.16,0:08:19.24,Default,,0,0,0,,Уау! керемет!
Dialogue: 0,0:08:19.83,0:08:20.66,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:08:23.87,0:08:26.88,Default,,0,0,0,,Бір қарағанда түсінуге болады, солай ма? Хехе
Dialogue: 0,0:08:27.25,0:08:30.34,Default,,0,0,0,,Бұл бір қарағанда түсінуге бола ма деген ескі сұрақ!
Dialogue: 0,0:08:30.46,0:08:33.67,Default,,0,0,0,,Елсіз жерлерді ұнатамын десем өтірік шығар.
Dialogue: 0,0:08:34.01,0:08:35.22,Default,,0,0,0,,Мен осылай үй саламын
Dialogue: 0,0:08:35.34,0:08:37.89,Default,,0,0,0,,Олар маған қалада тұруға рұқсат бермейді.
Dialogue: 0,0:08:38.01,0:08:39.89,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:08:40.26,0:08:44.31,Default,,0,0,0,,Мм... Бұл жалаушасы бар зат адамның қолы ма?
Dialogue: 0,0:08:44.44,0:08:46.31,Default,,0,0,0,,Бұл өте жақсы жұмыс.
Dialogue: 0,0:08:46.85,0:08:49.98,Default,,0,0,0,,Әр жолы... (Ишида) Мотив әртүрлі ме? Бұл...
Dialogue: 0,0:08:50.11,0:08:51.11,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:08:51.61,0:08:54.15,Default,,0,0,0,,Иә! Хмм...
Dialogue: 0,0:08:59.03,0:09:03.00,Default,,0,0,0,,Ах! Енді сол ұят үйге кіреміз бе?
Dialogue: 0,0:09:03.70,0:09:06.58,Default,,0,0,0,,Мен осылай үйге кірсем, мені ешкім көргім келмейді.
Dialogue: 0,0:09:06.96,0:09:09.21,Default,,0,0,0,,Не болды? Жақында келесіз бе?
Dialogue: 0,0:09:09.34,0:09:10.17,Default,,0,0,0,,Иә...
Dialogue: 0,0:09:12.71,0:09:13.76,Default,,0,0,0,,Сәлем Ишида!
Dialogue: 0,0:09:13.88,0:09:17.09,Default,,0,0,0,,Барғың келмейтінін білемін, бірақ тез келші.
Dialogue: 0,0:09:17.22,0:09:18.97,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:21.93,0:09:23.85,Default,,0,0,0,,Бұл не мұржа?
Dialogue: 0,0:09:23.98,0:09:26.73,Default,,0,0,0,,Бұл үймен салыстырғанда өте үлкен сияқты...
Dialogue: 0,0:09:27.31,0:09:28.40,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:28.52,0:09:31.86,Default,,0,0,0,,Ұшы бітеліп қалған сияқты, бірақ...?
Dialogue: 0,0:09:33.36,0:09:34.94,Default,,0,0,0,,Күте тұрыңыз! (Джинхико) Күте тұрыңыз!
Dialogue: 0,0:09:35.65,0:09:37.66,Default,,0,0,0,,Балалар сендер кімсіңдер?
Dialogue: 0,0:09:37.78,0:09:39.53,Default,,0,0,0,,Біртүрлі көрініс
Dialogue: 0,0:09:39.66,0:09:42.45,Default,,0,0,0,,Оның үстіне бір адам Шинигами болып көрінеді.
Dialogue: 0,0:09:42.87,0:09:44.79,Default,,0,0,0,,Хмф! (Канехико) Хмф!
Dialogue: 0,0:09:45.96,0:09:48.62,Default,,0,0,0,,Бұл күдікті жігіт, Канехико...
Dialogue: 0,0:09:48.75,0:09:50.25,Default,,0,0,0,,Джинхико!
Dialogue: 0,0:09:50.38,0:09:52.75,Default,,0,0,0,,Мен сені ешқашан өткізбеймін!
Dialogue: 0,0:09:53.92,0:09:55.09,Default,,0,0,0,,Кетіңіз!
Dialogue: 0,0:09:55.42,0:09:58.55,Default,,0,0,0,,Әйтпесе осы жерде өлесің.
Dialogue: 0,0:09:58.93,0:10:01.05,Default,,0,0,0,,Тексеріңіз, сіз тағы да қақпашысыз ба?
Dialogue: 0,0:10:01.18,0:10:04.56,Default,,0,0,0,,«Жан» қоғамы – сондай қиын жер.
Dialogue: 0,0:10:05.02,0:10:06.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:07.98,0:10:10.19,Default,,0,0,0,,Йоруичи-доно!?
Dialogue: 0,0:10:13.90,0:10:16.03,Default,,0,0,0,,Сіз кіре салысымен баспалдақпен төмен түсесіз бе?
Dialogue: 0,0:10:16.15,0:10:18.15,Default,,0,0,0,,Бұл өте біртүрлі үй.
Dialogue: 0,0:10:18.28,0:10:21.20,Default,,0,0,0,,Екінші қабатқа қалай жетуге болады?
Dialogue: 0,0:10:21.32,0:10:23.33,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:10:23.45,0:10:26.45,Default,,0,0,0,,Мен Йоруичи-доно мен оның қызметшісінің кім екенін білмеймін.
Dialogue: 0,0:10:26.58,0:10:28.16,Default,,0,0,0,,Менің дөрекілігімді кешіріңіз.
Dialogue: 0,0:10:28.50,0:10:29.62,Default,,0,0,0,,Бұл сенің серігің емес.
Dialogue: 0,0:10:30.08,0:10:34.34,Default,,0,0,0,,Жақсы, мен сізге бұрын хабарласпадым. Оған да менің кінәм бар.
Dialogue: 0,0:10:34.63,0:10:38.34,Default,,0,0,0,,Хаха! Күткендей, ұлы адамның жүрегі үлкен.
Dialogue: 0,0:10:39.68,0:10:41.18,Default,,0,0,0,,Осы жерде сәл күте тұрыңыз.
Dialogue: 0,0:10:41.18,0:10:42.51,Default,,0,0,0,,Осы жерде сәл күте тұрыңыз.
Dialogue: 0,0:10:41.18,0:10:42.51,Default,,0,0,0,,(содзиді түрту дыбысы)
Dialogue: 0,0:10:42.51,0:10:43.14,Default,,0,0,0,,(содзиді түрту дыбысы)
Dialogue: 0,0:10:43.26,0:10:44.26,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:10:49.02,0:10:51.94,Default,,0,0,0,,Иә, дәл қазір, Куцуру-сама.
Dialogue: 0,0:11:01.45,0:11:04.83,Default,,0,0,0,,Иә! Біраз уақыт болды, солай емес пе? Йоруичи
Dialogue: 0,0:11:05.16,0:11:06.99,Default,,0,0,0,,Ку... Кукаку.
Dialogue: 0,0:11:07.12,0:11:08.33,Default,,0,0,0,,Әйел!?
Dialogue: 0,0:11:08.95,0:11:11.79,Default,,0,0,0,,Оны адам деп ешкім айтпады.
Dialogue: 0,0:11:12.25,0:11:15.71,Default,,0,0,0,,О? Бұл не деген бәйбішелер?
Dialogue: 0,0:11:17.00,0:11:18.71,Default,,0,0,0,,Шын мәнінде Куцуру
Dialogue: 0,0:11:19.30,0:11:22.39,Default,,0,0,0,,Мен бүгін сенен жақсылық сұрауға келдім.
Dialogue: 0,0:11:23.14,0:11:25.68,Default,,0,0,0,,Көбінесе сіз келгенде солай емес пе?
Dialogue: 0,0:11:26.18,0:11:27.47,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:31.02,0:11:32.65,Default,,0,0,0,,Бұл қиыншылық па?
Dialogue: 0,0:11:32.90,0:11:34.36,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:11:34.98,0:11:38.32,Default,,0,0,0,,Ха, бұл алмасуды соңғы рет өткізгенімізге біраз уақыт болды.
Dialogue: 0,0:11:39.69,0:11:41.65,Default,,0,0,0,,Жарайды, сөйлесейік.
Dialogue: 0,0:11:41.78,0:11:44.20,Default,,0,0,0,,Мен қиындықты жақсы көремін.
Dialogue: 0,0:12:27.07,0:12:28.45,Default,,0,0,0,,Көріп тұрсың ба, Руқия?
Dialogue: 0,0:12:28.87,0:12:30.66,Default,,0,0,0,,Сол терезеден
Dialogue: 0,0:12:31.08,0:12:33.96,Default,,0,0,0,,Сізді орындауға арналған екі құрал
Dialogue: 0,0:12:34.08,0:12:35.42,Default,,0,0,0,,Бұл Суман.
Dialogue: 0,0:12:39.50,0:12:42.05,Default,,0,0,0,,Бұл мұнарада қамалғандар:
Dialogue: 0,0:12:42.17,0:12:46.59,Default,,0,0,0,,Мұнарадағы кішкентай терезеден егіз көбелектерге қарап...
Dialogue: 0,0:12:46.72,0:12:50.26,Default,,0,0,0,,Күнәға өкінеді дейді.
Dialogue: 0,0:12:50.60,0:12:54.56,Default,,0,0,0,,Сондықтан бұл жер «Үкім сарайы» деп аталады.
Dialogue: 0,0:12:59.90,0:13:01.19,Default,,0,0,0,,Қолдар
Dialogue: 0,0:13:01.53,0:13:02.82,Default,,0,0,0,,Шешімі!
Dialogue: 0,0:13:20.04,0:13:22.71,Default,,0,0,0,,Көлікті басқарудағы қажырлы еңбектеріңіз үшін рахмет.
Dialogue: 0,0:13:22.84,0:13:24.38,Default,,0,0,0,,Жүр, кеттік
Dialogue: 0,0:13:24.51,0:13:25.76,Default,,0,0,0,,О
Dialogue: 0,0:13:29.35,0:13:31.68,Default,,0,0,0,,Вице-капитан Абараи (Ренджи) Ах...
Dialogue: 0,0:13:42.07,0:13:43.15,Default,,0,0,0,,Капитанның орынбасары?
Dialogue: 0,0:13:48.20,0:13:51.78,Default,,0,0,0,,Мен расталмаған бір ақпаратты айтайын.
Dialogue: 0,0:13:52.24,0:13:56.66,Default,,0,0,0,,Кеше «Жан» қоғамында саяхат апаты болғанын білесіз бе?
Dialogue: 0,0:13:56.79,0:13:58.08,Default,,0,0,0,,Сан 5
Dialogue: 0,0:13:58.21,0:14:01.59,Default,,0,0,0,,Бірінің өз денесіндей қылыш бар еді.
Dialogue: 0,0:14:01.92,0:14:04.55,Default,,0,0,0,,Шамасы, ол қызғылт сары шашты өлім құдайы.
Dialogue: 0,0:14:05.05,0:14:06.22,Default,,0,0,0,,Ha
Dialogue: 0,0:14:08.34,0:14:11.68,Default,,0,0,0,,Түсіндім, оқиғаның түйінін түсіндім.
Dialogue: 0,0:14:15.68,0:14:17.10,Default,,0,0,0,,Жарайды, бірде бірге шай ішуге баруымыз керек қой?
Dialogue: 0,0:14:18.27,0:14:20.06,Default,,0,0,0,,Жақсы, мен аламын.
Dialogue: 0,0:14:20.40,0:14:22.23,Default,,0,0,0,,Шынымен бе? (Кукаку) О
Dialogue: 0,0:14:22.86,0:14:24.57,Default,,0,0,0,,Урахара да шайнап жатыр.
Dialogue: 0,0:14:24.65,0:14:26.94,Default,,0,0,0,,Жоқ деп айта алмаймын.
Dialogue: 0,0:14:27.78,0:14:31.12,Default,,0,0,0,,Дегенмен мен сізге сенемін.
Dialogue: 0,0:14:31.24,0:14:33.70,Default,,0,0,0,,Мен ол балаларға сенген сияқты емеспін.
Dialogue: 0,0:14:34.49,0:14:38.16,Default,,0,0,0,,Мен сені маған бағынышты, оның ішінде күзетші рөлін атқаруға рұқсат етемін.
Dialogue: 0,0:14:38.71,0:14:39.54,Default,,0,0,0,,Жетекшілер?
Dialogue: 0,0:14:39.87,0:14:43.50,Default,,0,0,0,,Аа, ол минон болса да, бәрібір менің інім.
Dialogue: 0,0:14:44.38,0:14:47.51,Default,,0,0,0,,Мен әлі жаман баламын және оны шынымен пайдалана алмаймын.
Dialogue: 0,0:14:48.55,0:14:49.97,Default,,0,0,0,,Эй, дайынсың ба?
Dialogue: 0,0:14:50.09,0:14:52.09,Default,,0,0,0,,О... сәл күте тұрыңыз
Dialogue: 0,0:14:52.22,0:14:54.31,Default,,0,0,0,,Оны ашайық. Өзіңізді ұстаңыз.
Dialogue: 0,0:14:54.43,0:14:56.06,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:14:57.73,0:15:01.02,Default,,0,0,0,,Танысқаныма қуаныштымын, менің атым Шиба Иваваси.
Dialogue: 0,0:15:01.48,0:15:03.15,Default,,0,0,0,,Кейінірек кездескенше
Dialogue: 0,0:15:03.56,0:15:04.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:05.36,0:15:06.48,Default,,0,0,0,,Хаха
Dialogue: 0,0:15:07.74,0:15:08.86,Default,,0,0,0,,Гаан!
Dialogue: 0,0:15:08.99,0:15:12.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:15.83,0:15:18.25,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:15:18.58,0:15:21.67,Default,,0,0,0,,Не, балалар бір-біріңді танисыңдар ма? а?
Dialogue: 0,0:15:26.55,0:15:28.55,Default,,0,0,0,,Содан бері қанша күн өтті деп ойлаймын.
Dialogue: 0,0:15:28.67,0:15:30.84,Default,,0,0,0,,Мен оның соншалықты жанды жағын соңғы рет көрдім...
Dialogue: 0,0:15:34.09,0:15:36.72,Default,,0,0,0,,Оның жолын кескен Ичимарудың бейбақы болды.
Dialogue: 0,0:15:36.85,0:15:40.39,Default,,0,0,0,,Ол бала енді өмір сүрмейтін шығар...
Dialogue: 0,0:15:42.14,0:15:45.02,Default,,0,0,0,,Бұл туралы айтпау дұрыс жауап болды деп ойлаймын.
Dialogue: 0,0:15:45.90,0:15:47.73,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:15:48.53,0:15:50.95,Default,,0,0,0,,Әй, біраз болды, Абарай-күн.
Dialogue: 0,0:15:51.53,0:15:52.66,Default,,0,0,0,,Эйзен мырза
Dialogue: 0,0:15:55.12,0:15:56.66,Default,,0,0,0,,Бір сәт сөйлесе аламыз ба?
Dialogue: 0,0:15:58.87,0:16:03.08,Default,,0,0,0,,Жоқ, бұлай сөйлескенімізге көп болды.
Dialogue: 0,0:16:03.21,0:16:04.04,Default,,0,0,0,,Иә
Dialogue: 0,0:16:05.67,0:16:08.67,Default,,0,0,0,,Сізді Кенпачиге алып кеткеннен бері...
Dialogue: 0,0:16:08.80,0:16:10.05,Default,,0,0,0,,Неше жыл болды?
Dialogue: 0,0:16:11.30,0:16:13.72,Default,,0,0,0,,Сіз қазір 6-шы отрядтасыз ба?
Dialogue: 0,0:16:14.39,0:16:16.89,Default,,0,0,0,,Мм... оқиға қандай?
Dialogue: 0,0:16:25.65,0:16:26.94,Default,,0,0,0,,Абарай-күн
Dialogue: 0,0:16:27.36,0:16:31.32,Default,,0,0,0,,Сіз Рукия Кучикиге жақынсыз, солай ма?
Dialogue: 0,0:16:31.69,0:16:32.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:33.36,0:16:34.99,Default,,0,0,0,,Жасырудың қажеті жоқ
Dialogue: 0,0:16:35.45,0:16:38.78,Default,,0,0,0,,Мен сіздердің бір-бірлеріңізді Руконғайдағы күндеріңізден жақсы танитындарыңызды естідім.
Dialogue: 0,0:16:39.16,0:16:40.49,Default,,0,0,0,,Иә
Dialogue: 0,0:16:40.95,0:16:43.16,Default,,0,0,0,,Мен сізден тікелей сұрайын ба?
Dialogue: 0,0:16:45.33,0:16:49.34,Default,,0,0,0,,Сіздің көзіңізде ол өлуі керек пе?
Dialogue: 0,0:16:49.50,0:16:51.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:53.22,0:16:55.05,Default,,0,0,0,,Жоқ, сұрақтың мағынасы бар...
Dialogue: 0,0:16:55.18,0:16:56.89,Default,,0,0,0,,Бұл біртүрлі деп ойламайсың ба?
Dialogue: 0,0:16:57.22,0:16:58.18,Default,,0,0,0,,Оның қылмысы –
Dialogue: 0,0:16:58.30,0:17:01.56,Default,,0,0,0,,Рұқсатсыз несие беру және рухани қуаттан айырылу
Dialogue: 0,0:17:01.68,0:17:03.68,Default,,0,0,0,,Бұл мерзімі өтіп кетті.
Dialogue: 0,0:17:04.48,0:17:08.44,Default,,0,0,0,,Бұл, әрине, ауыр қылмыс, бірақ мәселе мәселенің қалай шешілгенінде.
Dialogue: 0,0:17:08.98,0:17:12.40,Default,,0,0,0,,Жасанды қалдықтарды дереу қайтару және жою тәртібі
Dialogue: 0,0:17:12.86,0:17:16.91,Default,,0,0,0,,Жеңілдік кезеңін 35 күннен 25 күнге дейін қысқарту
Dialogue: 0,0:17:17.28,0:17:20.99,Default,,0,0,0,,Шинигамиде капитан дәрежесінен басқа Соухиді пайдалану
Dialogue: 0,0:17:21.54,0:17:23.25,Default,,0,0,0,,Олардың барлығы әдеттен тыс.
Dialogue: 0,0:17:24.54,0:17:26.29,Default,,0,0,0,,Мен үшін мұның бәрі —
Dialogue: 0,0:17:26.42,0:17:29.21,Default,,0,0,0,,Мен бір ерік-жігерге сүйеніп қозғалып бара жатқандай сезінемін.
Dialogue: 0,0:17:29.67,0:17:32.00,Default,,0,0,0,,Күте тұрыңыз, капитан Эйзен, сіз нені айтасыз...
Dialogue: 0,0:17:32.38,0:17:33.96,Default,,0,0,0,,Менде жағымсыз сезім бар.
Dialogue: 0,0:17:36.05,0:17:38.68,Default,,0,0,0,,Абарай-күн, мүмкін мен...
Dialogue: 0,0:17:38.68,0:17:38.97,Default,,0,0,0,,Абарай-күн, мүмкін мен...
Dialogue: 0,0:17:38.68,0:17:38.97,Default,,0,0,0,,(ескерту қоңырауы)
Dialogue: 0,0:17:38.97,0:17:39.09,Default,,0,0,0,,(ескерту қоңырауы)
Dialogue: 0,0:17:39.09,0:17:40.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:39.09,0:17:40.22,Default,,0,0,0,,(ескерту қоңырауы)
Dialogue: 0,0:17:40.22,0:17:40.35,Default,,0,0,0,,(ескерту қоңырауы)
Dialogue: 0,0:17:40.35,0:17:41.68,Default,,0,0,0,,Барлық капитандарға хабарлама Барлық капитандарға хабарлама
Dialogue: 0,0:17:40.35,0:17:41.68,Default,,0,0,0,,(ескерту қоңырауы)
Dialogue: 0,0:17:41.68,0:17:44.22,Default,,0,0,0,,Барлық капитандарға хабарлама Барлық капитандарға хабарлама
Dialogue: 0,0:17:44.35,0:17:47.10,Default,,0,0,0,,Қазір командирдің шұғыл жиналысы шақырылады.
Dialogue: 0,0:17:47.23,0:17:48.23,Default,,0,0,0,,Қайталаңыз!
Dialogue: 0,0:17:48.52,0:17:50.11,Default,,0,0,0,,Уууу!
Dialogue: 0,0:17:50.27,0:17:53.07,Default,,0,0,0,,Уау! Кааа...
Dialogue: 0,0:17:55.07,0:17:56.32,Default,,0,0,0,,(Изуку) Ах! (Гран Торино) Уа!
Dialogue: 0,0:17:56.45,0:17:58.99,Default,,0,0,0,,Сен бейбақ! Ұшайық!
Dialogue: 0,0:17:59.41,0:18:01.37,Default,,0,0,0,,О ла ла ла! Апыр-ай!
Dialogue: 0,0:18:02.70,0:18:04.50,Default,,0,0,0,,Хе, хаха, дұрыс айтасың!
Dialogue: 0,0:18:04.62,0:18:05.87,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:18:06.00,0:18:07.16,Default,,0,0,0,,Не! Гухе...
Dialogue: 0,0:18:10.83,0:18:13.17,Default,,0,0,0,,Ура Ура Ура Ура! (Ичиго) Ауырды... аа...
Dialogue: 0,0:18:13.96,0:18:16.30,Default,,0,0,0,,Сен бейбақ! (Иваваси) Уау!
Dialogue: 0,0:18:17.05,0:18:19.18,Default,,0,0,0,,Артқа оралма! (Иваваси) Уайымдама!
Dialogue: 0,0:18:19.30,0:18:20.89,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:18:21.68,0:18:25.68,Default,,0,0,0,,(Екі адам шу шығарады)
Dialogue: 0,0:18:29.35,0:18:30.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:30.52,0:18:33.52,Default,,0,0,0,,Доя! (Ичиго) Жолдан кет!
Dialogue: 0,0:18:34.32,0:18:36.57,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:18:37.74,0:18:38.57,Default,,0,0,0,,Әй?
Dialogue: 0,0:18:41.37,0:18:42.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:42.66,0:18:45.24,Default,,0,0,0,,Темера...
Dialogue: 0,0:18:46.75,0:18:49.37,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:18:51.54,0:18:52.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:52.63,0:18:53.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:54.09,0:18:55.46,Default,,0,0,0,,Ура!
Dialogue: 0,0:18:56.46,0:19:00.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:07.35,0:19:10.14,Default,,0,0,0,,Ұрысты тоқтату үшін менің қолымнан ештеңе келмейді...
Dialogue: 0,0:19:10.27,0:19:14.36,Default,,0,0,0,,Тұрғылықты жерімді неге ауыстыра беретінімді түсіндім деп ойлаймын.
Dialogue: 0,0:19:14.48,0:19:16.61,Default,,0,0,0,,Бұл қиын...
Dialogue: 0,0:19:16.86,0:19:18.44,Default,,0,0,0,,Не деген сұмдық!
Dialogue: 0,0:19:18.57,0:19:20.53,Default,,0,0,0,,Кездескен бойда ұрысып қалдық.
Dialogue: 0,0:19:21.03,0:19:22.28,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,0:19:22.41,0:19:24.03,Default,,0,0,0,,Үй әбігерге түсті!
Dialogue: 0,0:19:24.49,0:19:25.95,Default,,0,0,0,,Сәлем! Эй! (тепкі дыбыс)
Dialogue: 0,0:19:26.08,0:19:28.54,Default,,0,0,0,,Өйткені, әпке... (Кузуру) Қарсы сөйлеме.
Dialogue: 0,0:19:29.71,0:19:31.00,Default,,0,0,0,,Сізде шағымданатын нәрсе бар ма?
Dialogue: 0,0:19:32.12,0:19:33.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:33.50,0:19:35.67,Default,,0,0,0,,Бұл кенеттен не болды?
Dialogue: 0,0:19:35.79,0:19:37.96,Default,,0,0,0,,Ағайындылар, бәрі бірге...
Dialogue: 0,0:19:39.01,0:19:40.22,Default,,0,0,0,,Доки!
Dialogue: 0,0:19:47.64,0:19:48.72,Default,,0,0,0,,Эй, қарғыс атқыр бала.
Dialogue: 0,0:19:49.10,0:19:50.93,Default,,0,0,0,,Бұл менің үйім
Dialogue: 0,0:19:51.35,0:19:53.94,Default,,0,0,0,,Менің әдістеріме қатысты шағымыңыз болса, кетіңіз.
Dialogue: 0,0:19:55.36,0:19:57.40,Default,,0,0,0,,Мен... Кешіріңіз.
Dialogue: 0,0:19:57.82,0:20:00.99,Default,,0,0,0,,Жарайды, түсінсеңіз жақсы.
Dialogue: 0,0:20:06.62,0:20:08.29,Default,,0,0,0,,Әпкеңнен қорықпа.
Dialogue: 0,0:20:08.41,0:20:09.37,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:20:09.95,0:20:11.87,Default,,0,0,0,,Жарайды, бәрі орындарынан тұрыңдар!
Dialogue: 0,0:20:12.00,0:20:13.17,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:13.29,0:20:16.34,Default,,0,0,0,,Канехико шығып Джинхикомен бірге дайындалуы керек.
Dialogue: 0,0:20:16.46,0:20:17.34,Default,,0,0,0,,Құдай-ай, бұл жігіт шынымен де соған батып кетті ғой, иә?
Dialogue: 0,0:20:17.75,0:20:21.01,Default,,0,0,0,,Қалғандарың, аузыңды жап, артымнан еріңдер.
Dialogue: 0,0:20:22.80,0:20:26.22,Default,,0,0,0,,Бұл таңқаларлық. Жер астында болғанымен неге жарық бар?
Dialogue: 0,0:20:26.35,0:20:28.01,Default,,0,0,0,,Мен электр қуатын өндіретін қондырғыны да көре алмадым.
Dialogue: 0,0:20:28.39,0:20:30.27,Default,,0,0,0,,Менде от жағалары бар.
Dialogue: 0,0:20:30.39,0:20:33.56,Default,,0,0,0,,Төбедегі тесікте және екі жағындағы ағаш жақтауларда.
Dialogue: 0,0:20:33.69,0:20:35.15,Default,,0,0,0,,Оттаяқ Казура…
Dialogue: 0,0:20:35.27,0:20:38.23,Default,,0,0,0,,Бұл тек Жан қоғамында болатын өсімдік пе, әлде бір нәрсе ме?
Dialogue: 0,0:20:40.48,0:20:42.28,Default,,0,0,0,,Міне, келдік.
Dialogue: 0,0:20:42.40,0:20:43.45,Default,,0,0,0,,Ум...
Dialogue: 0,0:20:43.57,0:20:44.78,Default,,0,0,0,,Оны аш, Иваваси.
Dialogue: 0,0:20:44.91,0:20:46.45,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:47.74,0:20:48.87,Default,,0,0,0,,Ум...
Dialogue: 0,0:20:49.33,0:20:50.16,Default,,0,0,0,,Идиот!
Dialogue: 0,0:20:51.04,0:20:52.12,Default,,0,0,0,,Кенет не болды!
Dialogue: 0,0:20:52.25,0:20:54.41,Default,,0,0,0,,Маған қарсы шықпа, жарай ма?
Dialogue: 0,0:20:54.71,0:20:57.04,Default,,0,0,0,,Мінекей!
Dialogue: 0,0:21:06.47,0:21:09.39,Default,,0,0,0,,Не... бұл не? (Исида) Үлкен
Dialogue: 0,0:21:14.06,0:21:15.10,Default,,0,0,0,,Сен бұл жігітпен не істеп жүрсің?
Dialogue: 0,0:21:15.23,0:21:17.35,Default,,0,0,0,,Сейрейтейге лақтырамын.
Dialogue: 0,0:21:18.44,0:21:19.31,Default,,0,0,0,,Аспаннан
Dialogue: 0,0:21:19.77,0:21:21.02,Default,,0,0,0,,Аспан!?
Dialogue: 0,0:21:22.40,0:21:24.78,Default,,0,0,0,,Менің атым Кукаку Шиба
Dialogue: 0,0:21:24.90,0:21:27.03,Default,,0,0,0,,Ол Руконгайдағы ең үздік отшашу!
Dialogue: 0,0:21:31.49,0:21:36.50,Default,,0,0,0,,♪~
Dialogue: 0,0:22:25.55,0:22:30.55,Default,,0,0,0,,~♪
Dialogue: 0,0:22:42.11,0:22:44.23,Default,,0,0,0,,күрсініп... тағы айта аласыз ба?
Dialogue: 0,0:22:44.36,0:22:45.86,Default,,0,0,0,,Айтпа!
Dialogue: 0,0:22:46.49,0:22:48.78,Default,,0,0,0,,Бесінші дивизионның вице-капитаны Момо Хинамори
Dialogue: 0,0:22:48.90,0:22:50.95,Default,,0,0,0,,Бүгіннен бастап сен менің әпкемсің.
Dialogue: 0,0:22:52.45,0:22:58.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory