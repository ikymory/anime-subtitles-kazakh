Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:41.16,0:00:42.40,Default,,0,0,0,,...
Dialogue: 0,0:00:44.53,0:00:45.30,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,0:00:47.53,0:00:48.13,Default,,0,0,0,,N?
Dialogue: 0,0:00:51.50,0:00:52.40,Default,,0,0,0,,Пеггер
Dialogue: 0,0:00:53.73,0:00:56.03,Default,,0,0,0,,Кахат Куруру Куруру
Dialogue: 0,0:00:56.86,0:00:59.20,Default,,0,0,0,,Ламуа куру текалая
Dialogue: 0,0:01:00.26,0:01:02.20,Default,,0,0,0,,...
Dialogue: 0,0:01:07.66,0:01:12.50,Default,,0,0,0,,Куруру Куруруру Пекар Куруру
Dialogue: 0,0:01:13.40,0:01:16.53,Default,,0,0,0,,Пека Пека Пека Куруру экипажы
Dialogue: 0,0:01:17.26,0:01:19.93,Default,,0,0,0,,Куруру Пекар! Оның
Dialogue: 0,0:01:21.13,0:01:22.23,Default,,0,0,0,,Сіз?
Dialogue: 0,0:01:26.00,0:01:26.90,Default,,0,0,0,,Ураааа
Dialogue: 0,0:01:27.43,0:01:30.93,Default,,0,0,0,,Пабу Пабу!
Dialogue: 0,0:01:32.03,0:01:33.00,Default,,0,0,0,,Мухах
Dialogue: 0,0:01:35.70,0:01:37.50,Default,,0,0,0,,Саз!
Dialogue: 0,0:01:43.00,0:01:46.06,Default,,0,0,0,,Мама! Пам аа!
Dialogue: 0,0:01:46.50,0:01:50.33,Default,,0,0,0,,Мама! Пам аа!
Dialogue: 0,0:01:51.00,0:01:57.43,Default,,0,0,0,,(Кукулдың айқайы)
Dialogue: 0,0:02:05.03,0:02:06.76,Default,,0,0,0,,...
Dialogue: 0,0:02:09.86,0:02:11.33,Default,,0,0,0,,...
Dialogue: 0,0:02:11.46,0:02:13.33,Default,,0,0,0,,Маунга Песинигана
Dialogue: 0,0:02:15.80,0:02:16.66,Default,,0,0,0,,Уау
Dialogue: 0,0:02:18.16,0:02:19.80,Default,,0,0,0,,О!
Dialogue: 0,0:02:21.26,0:02:23.33,Default,,0,0,0,,Гугугу...гухаха
Dialogue: 0,0:02:23.60,0:02:26.60,Default,,0,0,0,,Баа!
Dialogue: 0,0:02:37.43,0:02:40.26,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:02:40.96,0:02:47.96,Default,,0,0,0,,♪〜
Dialogue: 0,0:03:46.20,0:03:53.20,Default,,0,0,0,,〜♪
Dialogue: 0,0:03:53.90,0:03:57.13,Default,,0,0,0,,Мен шешім қабылдадым, енді шыдай алмаймын бұл күнге.
Dialogue: 0,0:03:57.73,0:04:01.70,Default,,0,0,0,,Мектепте де, үйде де үнемі ұрысудан шаршадым.
Dialogue: 0,0:04:02.56,0:04:04.86,Default,,0,0,0,,Дораемон Мен үйден қашып бара жатырмын
Dialogue: 0,0:04:04.96,0:04:05.90,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:06.10,0:04:08.56,Default,,0,0,0,,«Мм»
Dialogue: 0,0:04:10.43,0:04:12.63,Default,,0,0,0,,Тоқтама Иә, мен тоқтамаймын
Dialogue: 0,0:04:13.50,0:04:16.56,Default,,0,0,0,,Әйтеуір, мен әдеттегідей тез қайтамын.
Dialogue: 0,0:04:17.33,0:04:21.16,Default,,0,0,0,,Бұл жолы басқаша, менің ойымда байыпты жоспар бар.
Dialogue: 0,0:04:21.30,0:04:22.23,Default,,0,0,0,,Қаһарман болуды армандап, беделді U.A. орта мектебінің Қаһармандар курсына оқуға түстім
Dialogue: 0,0:04:22.33,0:04:26.50,Default,,0,0,0,,Иә, ешкімге сенбе, өз өміріңмен өмір сүр
Dialogue: 0,0:04:26.60,0:04:27.93,Default,,0,0,0,,А, бұл мүмкін емес.
Dialogue: 0,0:04:28.03,0:04:31.20,Default,,0,0,0,,Жалғыз өмір сүру үшін не қажет?
Dialogue: 0,0:04:31.30,0:04:34.53,Default,,0,0,0,,Бұл тамақ, киім-кешек және баспана.
Dialogue: 0,0:04:34.63,0:04:37.36,Default,,0,0,0,,О, бұл сізге жақсы нәрсе.
Dialogue: 0,0:04:37.46,0:04:41.03,Default,,0,0,0,,Әй, солай емес пе? Сондықтан құралдарыңызды алыңыз.
Dialogue: 0,0:04:41.13,0:04:42.50,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:04:42.60,0:04:44.30,Default,,0,0,0,,Сіз доссыз, солай ма? Сіз ең жақсы доссыз, солай ма?
Dialogue: 0,0:04:44.40,0:04:46.46,Default,,0,0,0,,Түсіндім, түсіндім.
Dialogue: 0,0:04:46.56,0:04:47.76,Default,,0,0,0,,Олай болса, Дораемон
Dialogue: 0,0:04:47.86,0:04:52.00,Default,,0,0,0,,Мен бостандық пен тәуелсіздікке алғашқы қадам жасап жатырмын.
Dialogue: 0,0:04:52.10,0:04:53.80,Default,,0,0,0,,Өткеннен… немесе бәлкім басқа болашақтан
Dialogue: 0,0:04:56.06,0:04:58.66,Default,,0,0,0,,Бірінші қадамды жіберіп алды
Dialogue: 0,0:05:10.16,0:05:14.63,Default,,0,0,0,,Мен алыс жер алғым келеді, бірақ...ол үшін ақша керек.
Dialogue: 0,0:05:16.53,0:05:19.00,Default,,0,0,0,,Кетсем, қашқын боламын...
Dialogue: 0,0:05:19.10,0:05:20.83,Default,,0,0,0,,Менің көршімде тұрайық
Dialogue: 0,0:05:23.50,0:05:25.06,Default,,0,0,0,,Оның жасы үлкен екенін білетінмін, бірақ бұл…
Dialogue: 0,0:05:28.26,0:05:30.33,Default,,0,0,0,,Ха, бұл жалғыз орын.
Dialogue: 0,0:05:35.23,0:05:36.16,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:05:41.56,0:05:42.36,Default,,0,0,0,,Уау
Dialogue: 0,0:05:48.93,0:05:52.73,Default,,0,0,0,,Иә? Сіз үйден қашып кеттіңіз бе? Үйден қашпа
Dialogue: 0,0:05:52.83,0:05:55.86,Default,,0,0,0,,Сіз бір нәрсеге қол жеткіздіңіз бе?
Dialogue: 0,0:05:55.96,0:05:58.60,Default,,0,0,0,,Мәңгілік бола ма деп ойлаймын. Мен оны асыға күтемін.
Dialogue: 0,0:05:59.10,0:06:02.63,Default,,0,0,0,,Бұл жолы басқаша болады, өйткені мен міндетті түрде үйден қашамын.
Dialogue: 0,0:06:03.13,0:06:06.60,Default,,0,0,0,,Сіз де бостандық ғажайыптарын сезінгіңіз келмейді ме?
Dialogue: 0,0:06:07.00,0:06:08.80,Default,,0,0,0,,Мен бірден үйге бара жатсам да
Dialogue: 0,0:06:08.90,0:06:11.86,Default,,0,0,0,,Дорэмон, маған көмектесші~ Не?
Dialogue: 0,0:06:11.96,0:06:13.70,Default,,0,0,0,,Өзіңізді қатты итермеңіз
Dialogue: 0,0:06:13.90,0:06:15.46,Default,,0,0,0,,Тек қолыңнан келгеннің бәрін істе.
Dialogue: 0,0:06:15.56,0:06:17.13,Default,,0,0,0,,Қош бол жақында көріскенше
Dialogue: 0,0:06:17.26,0:06:19.70,Default,,0,0,0,,Ей, біз неге іште ойнамаймыз?
Dialogue: 0,0:06:20.76,0:06:24.76,Default,,0,0,0,,Мені мазақ қылса бәрі дұрыс, қаласаң да қайтпаймын.
Dialogue: 0,0:06:25.86,0:06:27.16,Default,,0,0,0,,Үйге барасыз ба?
Dialogue: 0,0:06:30.30,0:06:35.86,Default,,0,0,0,,(Нобитаның қорылдауы)
Dialogue: 0,0:06:36.63,0:06:38.66,Default,,0,0,0,,А, не?
Dialogue: 0,0:06:39.26,0:06:40.76,Default,,0,0,0,,Ой, жоқ!
Dialogue: 0,0:06:41.33,0:06:44.13,Default,,0,0,0,,Жүр, менің үйімді бұзба.
Dialogue: 0,0:06:44.23,0:06:48.86,Default,,0,0,0,,Үй? Менің жеріме рұқсатсыз үй салу қиын емес пе?
Dialogue: 0,0:06:48.96,0:06:52.60,Default,,0,0,0,,Ағайдың мүлкі? Осы бос жердің иесі болды ма?
Dialogue: 0,0:06:52.73,0:06:54.76,Default,,0,0,0,,Иә, бұл анық.
Dialogue: 0,0:06:55.03,0:06:56.76,Default,,0,0,0,,Мен білмедім
Dialogue: 0,0:07:02.36,0:07:06.33,Default,,0,0,0,,«Сидзука-чан» Соңында мен артқы тауға жеттім—
Dialogue: 0,0:07:06.43,0:07:10.56,Default,,0,0,0,,«Мен жаңа еркін өмір бастауды шештім».
Dialogue: 0,0:07:11.56,0:07:15.53,Default,,0,0,0,,«Көрініс тамаша және қоршаған орта тамаша».
Dialogue: 0,0:07:16.03,0:07:19.00,Default,,0,0,0,,«Бізге қонаққа келші, Нобита».
Dialogue: 0,0:07:19.26,0:07:21.26,Default,,0,0,0,,Жарайды, болды хехехе
Dialogue: 0,0:07:21.56,0:07:23.40,Default,,0,0,0,,Иә? А, аа, аа
Dialogue: 0,0:07:26.30,0:07:27.46,Default,,0,0,0,,Уау~
Dialogue: 0,0:07:28.10,0:07:29.86,Default,,0,0,0,,Бұл жеке меншік жер
Dialogue: 0,0:07:30.00,0:07:32.13,Default,,0,0,0,,Ешбір құрылысты рұқсатсыз салуға болмайды.
Dialogue: 0,0:07:32.26,0:07:33.56,Default,,0,0,0,,Бірден жойылды
Dialogue: 0,0:07:38.80,0:07:41.73,Default,,0,0,0,,Нобита, сен не қаңғып жүрсің?
Dialogue: 0,0:07:42.90,0:07:45.23,Default,,0,0,0,,Сіз жаңа мекенжай туралы шешім қабылдадыңыз ба?
Dialogue: 0,0:07:45.33,0:07:47.56,Default,,0,0,0,,Әлде қазір үйге барасыз ба?
Dialogue: 0,0:07:47.90,0:07:49.23,Default,,0,0,0,,Кук
Dialogue: 0,0:07:49.36,0:07:51.16,Default,,0,0,0,,Мекен-жайыңызды айтыңызшы.
Dialogue: 0,0:07:51.26,0:07:53.10,Default,,0,0,0,,Өйткені мен ойынға шықпаймын.
Dialogue: 0,0:07:53.20,0:07:54.26,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:07:54.36,0:07:55.70,Default,,0,0,0,,шулы шулы
Dialogue: 0,0:07:57.23,0:07:59.20,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:08:01.16,0:08:02.30,Default,,0,0,0,,Дораемон
Dialogue: 0,0:08:02.40,0:08:04.90,Default,,0,0,0,,Ей, ерте кездескенше.
Dialogue: 0,0:08:05.33,0:08:08.66,Default,,0,0,0,,Эй Дораемон, маған кез келген жерде есігіңді қарызға бер. Эй, эй.
Dialogue: 0,0:08:09.43,0:08:13.00,Default,,0,0,0,,Ей, сен ешкімнің көмегіне сенбеймін дедің ғой.
Dialogue: 0,0:08:13.10,0:08:15.90,Default,,0,0,0,,Бұл соңғы рет, тағы бір рет
Dialogue: 0,0:08:16.26,0:08:17.60,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:18.36,0:08:20.36,Default,,0,0,0,,Бұл шынымен де соңғы рет
Dialogue: 0,0:08:20.46,0:08:21.66,Default,,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:08:22.00,0:08:24.00,Default,,0,0,0,,Сіз қайда бара жатқаныңызды білесіз бе?
Dialogue: 0,0:08:24.23,0:08:27.30,Default,,0,0,0,,Иә, жағдай тынышталғанда сізге хабарлаймын.
Dialogue: 0,0:08:28.23,0:08:30.10,Default,,0,0,0,,Ал, қолыңнан келгеннің бәрін жаса.
Dialogue: 0,0:08:30.66,0:08:32.66,Default,,0,0,0,,Мен бәрібір жақында қайтамын.
Dialogue: 0,0:08:33.03,0:08:36.29,Default,,0,0,0,,Міне, өте ыңғайсыз және қараусыз қалған ауыл.
Dialogue: 0,0:08:36.50,0:08:38.50,Default,,0,0,0,,Осында тұрайық, Ия!
Dialogue: 0,0:08:38.60,0:08:41.36,Default,,0,0,0,,Мен өзім өмір сүре аламын Яй Яй
Dialogue: 0,0:08:49.00,0:08:51.80,Default,,0,0,0,,Бұл енді әзіл емес.
Dialogue: 0,0:08:52.30,0:08:54.96,Default,,0,0,0,,Балалардың да адам құқықтары бар.
Dialogue: 0,0:08:55.06,0:08:58.10,Default,,0,0,0,,Дүкен сақтаушысы жеткізу арамшөптерді жою жолағы
Dialogue: 0,0:08:58.46,0:09:01.06,Default,,0,0,0,,Мен анамның құлы емеспін.
Dialogue: 0,0:09:01.40,0:09:05.16,Default,,0,0,0,,Мұндай жолдарды құлдай жұмыс істегеннен кейін ғана айту керек.
Dialogue: 0,0:09:05.50,0:09:08.76,Default,,0,0,0,,Әй... Үйден қашатын шығармын.
Dialogue: 0,0:09:08.93,0:09:10.13,Default,,0,0,0,,Мұны рұқсатсыз орындаңыз
Dialogue: 0,0:09:11.00,0:09:12.43,Default,,0,0,0,,Такеши!
Dialogue: 0,0:09:15.46,0:09:18.96,Default,,0,0,0,,Мүлдем, мүлде, мен үйге келмеймін.
Dialogue: 0,0:09:22.00,0:09:23.16,Default,,0,0,0,,Нобитаны іздейік
Dialogue: 0,0:09:23.26,0:09:24.46,Default,,0,0,0,,Джайан
Dialogue: 0,0:09:24.80,0:09:25.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:26.06,0:09:28.16,Default,,0,0,0,,Эй, о, Сунео.
Dialogue: 0,0:09:28.70,0:09:30.00,Default,,0,0,0,,Шын мәнінде мектеп автобусымен келдің бе?
Dialogue: 0,0:09:30.10,0:09:32.10,Default,,0,0,0,,Нобита... Нобита Сіз білмейсіз бе?
Dialogue: 0,0:09:33.83,0:09:36.03,Default,,0,0,0,,Сунео Не? Сол көзқарас
Dialogue: 0,0:09:36.16,0:09:36.93,Default,,0,0,0,,Джиан - бұл
Dialogue: 0,0:09:37.20,0:09:41.03,Default,,0,0,0,,Уау~ Маған анам тәрбие бергендіктен...
Dialogue: 0,0:09:41.13,0:09:43.36,Default,,0,0,0,,Ол барлық пәндерге беріледі деп айтылады.
Dialogue: 0,0:09:43.46,0:09:45.40,Default,,0,0,0,,Таңертеңнен кешке дейін оқу
Dialogue: 0,0:09:45.50,0:09:46.60,Default,,0,0,0,,Сіз де қашқынсыз ба?
Dialogue: 0,0:09:46.70,0:09:51.50,Default,,0,0,0,,Иә, мен Нобитаны капсуласына салуды ойладым.
Dialogue: 0,0:09:51.60,0:09:52.26,Default,,0,0,0,,Иә
Dialogue: 0,0:09:52.43,0:09:53.76,Default,,0,0,0,,О, Нобита ше?
Dialogue: 0,0:09:54.13,0:09:56.73,Default,,0,0,0,,Е, мен де Шизука-чанның үйден қашып кеткеніне сене алар емеспін...
Dialogue: 0,0:09:57.66,0:09:59.83,Default,,0,0,0,,Үйден қашқаным сонша емес...
Dialogue: 0,0:09:59.93,0:10:03.46,Default,,0,0,0,,Бірақ мен енді фортепиано сабағын ұнатпаймын.
Dialogue: 0,0:10:05.70,0:10:09.13,Default,,0,0,0,,Дораемон! Ашық, ашық, ашық
Dialogue: 0,0:10:09.23,0:10:10.96,Default,,0,0,0,,Не… не болды? Нобита-кун
Dialogue: 0,0:10:12.83,0:10:14.30,Default,,0,0,0,,Уау~
Dialogue: 0,0:10:15.93,0:10:18.13,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:19.03,0:10:22.13,Default,,0,0,0,,Мен тұрғым келген ауыл бөгет түбіне айналды.
Dialogue: 0,0:10:22.23,0:10:23.63,Default,,0,0,0,,Ол батып кетті.
Dialogue: 0,0:10:23.93,0:10:27.76,Default,,0,0,0,,Әй, Жапонияның бір жерінде иесі жоқ жер бар ма?
Dialogue: 0,0:10:28.30,0:10:30.10,Default,,0,0,0,,Мұндай нәрсе бар ма?
Dialogue: 0,0:10:30.33,0:10:34.00,Default,,0,0,0,,Мемлекет жеке меншіктен басқа барлық жердің иесі болып табылады.
Dialogue: 0,0:10:34.46,0:10:37.66,Default,,0,0,0,,Берілмеу. Үйден қашу мүмкін емес.
Dialogue: 0,0:10:37.80,0:10:40.00,Default,,0,0,0,,Маған ұнамайды, үйден қашу керек
Dialogue: 0,0:10:40.86,0:10:41.96,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:10:42.26,0:10:45.13,Default,,0,0,0,,Аа, мен бәрібір түсінбеймін. Сонда кездескенше.
Dialogue: 0,0:10:46.30,0:10:47.83,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:10:49.93,0:10:51.03,Default,,0,0,0,,Ноби-чан, қайда бара жатырсың?
Dialogue: 0,0:10:51.13,0:10:52.10,Default,,0,0,0,,Қашқын!
Dialogue: 0,0:10:52.20,0:10:53.30,Default,,0,0,0,,Көліктерден сақ болыңыз
Dialogue: 0,0:10:53.53,0:10:54.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:56.60,0:10:57.76,Default,,0,0,0,,Сәлем Ноби-чан?
Dialogue: 0,0:10:58.20,0:11:01.80,Default,,0,0,0,,Жақсы, енді маған Дораэмоннан сұраудың қажеті жоқ.
Dialogue: 0,0:11:02.20,0:11:04.13,Default,,0,0,0,,Мен өзім жақсы өмір сүремін
Dialogue: 0,0:11:04.26,0:11:06.63,Default,,0,0,0,,Мұндай ақаулы құрал ше... (Сунео) Эй, Нобита.
Dialogue: 0,0:11:07.10,0:11:08.93,Default,,0,0,0,,Нобита, мен сені іздедім.
Dialogue: 0,0:11:09.03,0:11:12.06,Default,,0,0,0,,Менің саған өтінішім бар Қашқын, сен қолыңнан келгенін істеп жатырсың ба?
Dialogue: 0,0:11:12.16,0:11:14.40,Default,,0,0,0,,Капсулалардан басқа әртүрлі құралдар—
Dialogue: 0,0:11:14.50,0:11:16.10,Default,,0,0,0,,Сіз оны Дораемоннан алдыңыз, солай ма?
Dialogue: 0,0:11:16.20,0:11:19.13,Default,,0,0,0,,Ендеше қашқандарға қосылайық.
Dialogue: 0,0:11:19.50,0:11:21.86,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:22.43,0:11:24.30,Default,,0,0,0,,Не, сен сараңсың ба?
Dialogue: 0,0:11:24.40,0:11:25.86,Default,,0,0,0,,Біз ең жақсы достармыз, солай ма?
Dialogue: 0,0:11:27.33,0:11:30.20,Default,,0,0,0,,...
Dialogue: 0,0:11:30.30,0:11:31.53,Default,,0,0,0,,Қорқынышты қорқынышты қорқынышты...
Dialogue: 0,0:11:31.96,0:11:34.73,Default,,0,0,0,,Бұл егеуқұйрық емес, хомяк
Dialogue: 0,0:11:34.83,0:11:37.86,Default,,0,0,0,,Қорықпа, сен үнсіз, сүйкімдісің, солай ма?
Dialogue: 0,0:11:37.96,0:11:41.10,Default,,0,0,0,,Маған ұнамайды, ұнамайды, бір жерде істе.
Dialogue: 0,0:11:41.20,0:11:42.86,Default,,0,0,0,,Бұл жұмыс істемейді.
Dialogue: 0,0:11:42.96,0:11:46.46,Default,,0,0,0,,Менеджер отбасылық сапарға кетіп бара жатыр еді, оған қамқорлық жасауымды өтінді.
Dialogue: 0,0:11:46.76,0:11:49.93,Default,,0,0,0,,Менен бұлай сұрама, әке.
Dialogue: 0,0:11:50.03,0:11:52.80,Default,,0,0,0,,Бір апта ғана қалды, сабыр ет.
Dialogue: 0,0:11:53.16,0:11:55.40,Default,,0,0,0,,Бір апта бойы! Иә
Dialogue: 0,0:11:55.50,0:11:58.23,Default,,0,0,0,,Уау~ Каа... Тәт, көмектесші, маған көмектесші, Тат...
Dialogue: 0,0:11:58.40,0:12:00.30,Default,,0,0,0,,Айте Уау~ Уау~
Dialogue: 0,0:12:00.73,0:12:03.90,Default,,0,0,0,,Уау~ Өйткені бүкіл Жапонияда тұратын жер жоқ.
Dialogue: 0,0:12:04.16,0:12:06.90,Default,,0,0,0,,Ең жақын досына опасыздық жасаған адамды мен кешірмеймін.
Dialogue: 0,0:12:07.00,0:12:08.23,Default,,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:12:08.33,0:12:10.46,Default,,0,0,0,,Дадада, өйткені... Иә? Дора-чан
Dialogue: 0,0:12:10.56,0:12:11.36,Default,,0,0,0,,Иә? (Нобита) Иә?
Dialogue: 0,0:12:11.63,0:12:12.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:13.10,0:12:15.83,Default,,0,0,0,,Уууу... Гушу~
Dialogue: 0,0:12:19.63,0:12:23.60,Default,,0,0,0,,Мен Дораэмон үйден қашып кетеді деп ойламадым.
Dialogue: 0,0:12:25.06,0:12:28.60,Default,,0,0,0,,Бұл жағдайда қай жерде тұру мәселесі одан да өзекті болады.
Dialogue: 0,0:12:28.70,0:12:32.46,Default,,0,0,0,,Жапонияның әр бұрышының иесі бар.
Dialogue: 0,0:12:32.63,0:12:35.10,Default,,0,0,0,,Мен бұл туралы ешқашан ойламадым. Иә...
Dialogue: 0,0:12:35.46,0:12:38.16,Default,,0,0,0,,Эй, бұл біртүрлі деп ойламайсың ба?
Dialogue: 0,0:12:38.90,0:12:41.73,Default,,0,0,0,,Өйткені, жердің жасы миллиардтаған жыл.
Dialogue: 0,0:12:41.83,0:12:44.33,Default,,0,0,0,,Ол Жер жаратылғаннан бері бар.
Dialogue: 0,0:12:44.43,0:12:48.46,Default,,0,0,0,,Кейінірек келген адамдар оны жай ғана бөліп алып, сонда тұрды.
Dialogue: 0,0:12:48.63,0:12:51.40,Default,,0,0,0,,«Кейін келген адамдар»? Бұл дұрыс!
Dialogue: 0,0:12:51.56,0:12:52.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:52.53,0:12:55.33,Default,,0,0,0,,Ей, айналамызда ешкім жоқ уақытқа барайық.
Dialogue: 0,0:12:55.70,0:13:00.46,Default,,0,0,0,,Күткендей, өткен заманда адам болмаған заман болды.
Dialogue: 0,0:13:00.66,0:13:03.20,Default,,0,0,0,,Сол дәуірге қайта оралсаңыз, бүкіл Жапония...
Dialogue: 0,0:13:03.50,0:13:04.93,Default,,0,0,0,,Біздің
Dialogue: 0,0:13:05.06,0:13:06.63,Default,,0,0,0,,Нобита-кун Сатеру
Dialogue: 0,0:13:06.73,0:13:08.93,Default,,0,0,0,,Жоқ, жоқ, жоқ, Нобита-сан, сен ақылдысың.
Dialogue: 0,0:13:09.03,0:13:10.36,Default,,0,0,0,,Бұл не болып жатыр?
Dialogue: 0,0:13:10.63,0:13:13.80,Default,,0,0,0,,Енді уақыт машинасына көшейік.
Dialogue: 0,0:13:14.06,0:13:17.26,Default,,0,0,0,,Бос жерлерге толы ескі Жапонияға
Dialogue: 0,0:13:21.03,0:13:22.03,Default,,0,0,0,,Этто
Dialogue: 0,0:13:22.43,0:13:23.56,Default,,0,0,0,,Хото
Dialogue: 0,0:13:24.33,0:13:26.06,Default,,0,0,0,,Мазалағаным үшін кешіріңіз (Сунео) Дәл солай.
Dialogue: 0,0:13:26.20,0:13:28.50,Default,,0,0,0,,Не болды? Дораемон
Dialogue: 0,0:13:31.20,0:13:33.63,Default,,0,0,0,,Ей, егеуқұйрықтар жоқ па?
Dialogue: 0,0:13:33.90,0:13:35.83,Default,,0,0,0,,Не? Жоқ, мен жоқпын, бәрібір
Dialogue: 0,0:13:35.93,0:13:38.26,Default,,0,0,0,,Хехе, кеттік~
Dialogue: 0,0:13:38.60,0:13:40.16,Default,,0,0,0,,О! (Нобита) Міне.
Dialogue: 0,0:13:46.06,0:13:47.00,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:13:47.36,0:13:50.30,Default,,0,0,0,,Енді тарихтағы ең үлкен қашқын.
Dialogue: 0,0:13:50.40,0:13:51.83,Default,,0,0,0,,Кету
Dialogue: 0,0:13:52.26,0:13:54.90,Default,,0,0,0,,Бип Айтпақшы, қайда барасыз?
Dialogue: 0,0:13:55.23,0:13:58.50,Default,,0,0,0,,Мен Жапонияда адамдар пайда болғанға дейін барғым келеді.
Dialogue: 0,0:13:58.73,0:14:00.43,Default,,0,0,0,,Дыбыстық сигнал жоқ
Dialogue: 0,0:14:00.53,0:14:03.43,Default,,0,0,0,,Нұсқауларды бермес бұрын жылды дұрыстап тексеріңіз.
Dialogue: 0,0:14:04.40,0:14:07.90,Default,,0,0,0,,Ей, қазбалар мен тас құралдардың ғасырларына қарасаңыз...
Dialogue: 0,0:14:08.00,0:14:11.26,Default,,0,0,0,,Шамасы, адамдар шамамен 30 000 жыл бұрын болған.
Dialogue: 0,0:14:11.46,0:14:14.46,Default,,0,0,0,,Олай болса 30 001 жыл артқа оралайық.
Dialogue: 0,0:14:14.56,0:14:16.56,Default,,0,0,0,,Қарапайым идея
Dialogue: 0,0:14:16.66,0:14:19.26,Default,,0,0,0,,Бұл көптен бері болған шығар, солай ма?
Dialogue: 0,0:14:19.36,0:14:20.50,Default,,0,0,0,,Содан кейін 30,02 жыл.
Dialogue: 0,0:14:20.76,0:14:23.06,Default,,0,0,0,,Пипипипи… (үшін) Уау~
Dialogue: 0,0:14:23.30,0:14:24.16,Default,,0,0,0,,Сүйегім сынды!
Dialogue: 0,0:14:24.26,0:14:27.70,Default,,0,0,0,,Кеңістік-уақыт турбуленттігі пайда болады. Егер сіз жұтып қалсаңыз, сіз ешқашан орала алмайсыз.
Dialogue: 0,0:14:27.80,0:14:29.90,Default,,0,0,0,,Мықтап ұстаңыз.
Dialogue: 0,0:14:30.13,0:14:31.60,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:35.16,0:14:39.33,Default,,0,0,0,,Сіз қашып кеткен сияқтысыз. Жақында қайда бару керектігін шешіңіз.
Dialogue: 0,0:14:39.60,0:14:41.43,Default,,0,0,0,,Сонда 30 000 есе көп...
Dialogue: 0,0:14:41.53,0:14:44.23,Default,,0,0,0,,60 000 жыл бұрын болса жақсы емес пе?
Dialogue: 0,0:14:44.33,0:14:47.96,Default,,0,0,0,,Иә, сенімді болу үшін тағы 10 000 жыл қосайық.
Dialogue: 0,0:14:48.20,0:14:49.40,Default,,0,0,0,,Иә шешім
Dialogue: 0,0:14:49.50,0:14:52.40,Default,,0,0,0,,Баратын жер Жапония 70 000 жыл бұрын
Dialogue: 0,0:14:52.50,0:14:55.23,Default,,0,0,0,,70 000 жыл бұрын Түсінген
Dialogue: 0,0:15:03.73,0:15:04.63,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:15:04.76,0:15:07.13,Default,,0,0,0,,Иә
Dialogue: 0,0:15:08.73,0:15:10.76,Default,,0,0,0,,Жоқ, жоқ, жоқ, рахмет
Dialogue: 0,0:15:11.06,0:15:13.40,Default,,0,0,0,,Уау, жақсы
Dialogue: 0,0:15:13.50,0:15:16.83,Default,,0,0,0,,Қандай ашық жасыл, о, дәмді ауа
Dialogue: 0,0:15:17.00,0:15:19.16,Default,,0,0,0,,Бұл өзіміздің Жапония.
Dialogue: 0,0:15:19.26,0:15:22.70,Default,,0,0,0,,Ей, өзіміздің жұмақты осында жасайық.
Dialogue: 0,0:15:22.80,0:15:24.43,Default,,0,0,0,,Иә (барлығы) келіседі.
Dialogue: 0,0:15:25.23,0:15:27.33,Default,,0,0,0,,(Нобитаның түшкіруі)
Dialogue: 0,0:15:29.10,0:15:31.40,Default,,0,0,0,,Эй, сен ақымақ суық емессің бе?
Dialogue: 0,0:15:31.50,0:15:34.86,Default,,0,0,0,,Ойлап қарасақ, 70 000 жыл бұрын...
Dialogue: 0,0:15:34.96,0:15:40.26,Default,,0,0,0,,Соңғы плейстоцен кезеңінде, Вюрм мұздануының басында.
Dialogue: 0,0:15:41.03,0:15:42.16,Default,,0,0,0,,Мұз дәуірі дегеніміз не?
Dialogue: 0,0:15:42.26,0:15:45.23,Default,,0,0,0,,Мұздықтар тараған сайын бүкіл жер суытады.
Dialogue: 0,0:15:45.70,0:15:47.96,Default,,0,0,0,,Мен суық жұмақты қаламаймын.
Dialogue: 0,0:15:48.06,0:15:50.66,Default,,0,0,0,,Жарайды, кейін дұрыстап орындаймын.
Dialogue: 0,0:15:51.03,0:15:54.96,Default,,0,0,0,,Ең алдымен бұл жердің қандай әлем болғанын қалайсыз?
Dialogue: 0,0:15:55.40,0:15:58.13,Default,,0,0,0,,Өз тілектеріңіз бен ойларыңызбен бөлісіңіз.
Dialogue: 0,0:15:58.30,0:16:02.46,Default,,0,0,0,,Мен, түнгі қонақ үй, манга кітапханасы және ойын орталығы
Dialogue: 0,0:16:02.56,0:16:04.26,Default,,0,0,0,,Мен Катсудон мейрамханасы
Dialogue: 0,0:16:04.36,0:16:06.70,Default,,0,0,0,,Мен мейрамханадамын, әрине тегін.
Dialogue: 0,0:16:06.96,0:16:09.13,Default,,0,0,0,,А... Менің арманым жоқ.
Dialogue: 0,0:16:09.30,0:16:13.33,Default,,0,0,0,,Ей, көлдің бойында гүл бақшасы бар.
Dialogue: 0,0:16:13.43,0:16:14.73,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:16:14.83,0:16:19.33,Default,,0,0,0,,Ал күндіз кемпірқосақ пайда болады, ал түнде аврора жарқырайды.
Dialogue: 0,0:16:19.43,0:16:21.36,Default,,0,0,0,,Сіз мұны істей аласыз ба? Әрине
Dialogue: 0,0:16:22.16,0:16:26.13,Default,,0,0,0,,Пегас, су перілері және жалғыз мүйізділер көңілді...
Dialogue: 0,0:16:26.43,0:16:28.26,Default,,0,0,0,,Қыздың хоббиін тексеру
Dialogue: 0,0:16:28.63,0:16:31.60,Default,,0,0,0,,Сунео: Біз еркекпіз...
Dialogue: 0,0:16:31.70,0:16:33.86,Default,,0,0,0,,Шытырман оқиғалар әлемі жақсырақ.
Dialogue: 0,0:16:33.96,0:16:34.80,Default,,0,0,0,,Иә, иә\NЕгер бұл
Dialogue: 0,0:16:34.90,0:16:36.70,Default,,0,0,0,,Жабайы табиғат Джианға жарасады.
Dialogue: 0,0:16:36.80,0:16:37.56,Default,,0,0,0,,Оң жақ (Сунео) Иә.
Dialogue: 0,0:16:37.66,0:16:39.10,Default,,0,0,0,,Мен қыздардың хоббиімен жақсымын.
Dialogue: 0,0:16:40.03,0:16:42.66,Default,,0,0,0,,Гүл бақшасында тоқ боласың ба? Сунео
Dialogue: 0,0:16:42.76,0:16:43.76,Default,,0,0,0,,Фуфуннанай
Dialogue: 0,0:16:43.86,0:16:46.76,Default,,0,0,0,,Пегас пен су перілері Жапонияға сәйкес келмейді.
Dialogue: 0,0:16:46.93,0:16:48.06,Default,,0,0,0,,Иә, сәйкес келмейді.
Dialogue: 0,0:16:49.33,0:16:50.76,Default,,0,0,0,,Ең көбі...
Dialogue: 0,0:16:50.96,0:16:52.93,Default,,0,0,0,,Сонымен... Сай Сай! мүйізтұмсық
Dialogue: 0,0:16:53.03,0:16:56.26,Default,,0,0,0,,Дұрыс, мүйізтұмсықтар жақсы. Мүйізтұмсықтар?
Dialogue: 0,0:16:57.40,0:16:58.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:59.83,0:17:01.16,Default,,0,0,0,,Сунео Джиан
Dialogue: 0,0:17:01.76,0:17:04.26,Default,,0,0,0,,Уау! Маған көмектесіңізші
Dialogue: 0,0:17:04.36,0:17:05.53,Default,,0,0,0,,Күтіңіз, күтіңіз!
Dialogue: 0,0:17:05.63,0:17:07.46,Default,,0,0,0,,Аххх (Нобита) Ахх~
Dialogue: 0,0:17:07.56,0:17:09.30,Default,,0,0,0,,Уау~ Бұл мүйізтұмсық.
Dialogue: 0,0:17:11.30,0:17:13.16,Default,,0,0,0,,Мен қазір өзім шығамын.
Dialogue: 0,0:17:13.59,0:17:15.66,Default,,0,0,0,,Тореадор!
Dialogue: 0,0:17:16.03,0:17:17.50,Default,,0,0,0,,Оле
Dialogue: 0,0:17:18.43,0:17:21.06,Default,,0,0,0,,Бүгінгі тақырып:
Dialogue: 0,0:17:30.30,0:17:31.46,Default,,0,0,0,,Уф
Dialogue: 0,0:17:31.86,0:17:34.23,Default,,0,0,0,,Хаха, ғажап, корридашыға ұқсайды
Dialogue: 0,0:17:55.83,0:17:58.33,Default,,0,0,0,,Дәл солай, мен сені алысқа апарамын.
Dialogue: 0,0:17:58.43,0:18:02.46,Default,,0,0,0,,Бірақ абай болыңыз, Жапонияның осы дәуірінде...
Dialogue: 0,0:18:02.56,0:18:05.23,Default,,0,0,0,,Қауіпті жануарлар өте көп.
Dialogue: 0,0:18:05.33,0:18:08.70,Default,,0,0,0,,Мүйізтұмсықтардан басқа аю, қасқыр, жолбарыс, қолтырауын да кездеседі.
Dialogue: 0,0:18:08.80,0:18:10.66,Default,,0,0,0,,Не? Жолбарыстар мен қолтырауындар да?
Dialogue: 0,0:18:11.03,0:18:13.20,Default,,0,0,0,,Иә, сонда...
Dialogue: 0,0:18:13.83,0:18:16.10,Default,,0,0,0,,Қарапайым өмір жиынтығы!
Dialogue: 0,0:18:16.40,0:18:18.46,Default,,0,0,0,,Оны тасқа айналдыру ақымақ жеңіл.
Dialogue: 0,0:18:18.56,0:18:22.06,Default,,0,0,0,,Бұл тас па? Мүлдем ауырмайтын бұл түйме ше?
Dialogue: 0,0:18:22.16,0:18:24.03,Default,,0,0,0,,Уау... Нобита-кун
Dialogue: 0,0:18:24.63,0:18:26.53,Default,,0,0,0,,Мен қазір түсіндіремін.
Dialogue: 0,0:18:26.63,0:18:30.96,Default,,0,0,0,,Бұл найза пілді де таң қалдыра алатын соққы таяқшасы.
Dialogue: 0,0:18:32.00,0:18:34.03,Default,,0,0,0,,Ал мына кондиционер костюмі
Dialogue: 0,0:18:34.13,0:18:36.93,Default,,0,0,0,,Дененің айналасындағы ауа температурасын реттей алады
Dialogue: 0,0:18:37.43,0:18:39.13,Default,,0,0,0,,Кәне, бәрі өзгерсін.
Dialogue: 0,0:18:39.23,0:18:40.36,Default,,0,0,0,,Иә
Dialogue: 0,0:18:45.83,0:18:47.33,Default,,0,0,0,,үшін киімдерін ауыстырды ма?
Dialogue: 0,0:18:47.83,0:18:49.26,Default,,0,0,0,,Иә
Dialogue: 0,0:18:49.36,0:18:51.50,Default,,0,0,0,,Жылы және ыңғайлы
Dialogue: 0,0:18:51.60,0:18:53.86,Default,,0,0,0,,Мұндай нәрсе Джианға жарасады.
Dialogue: 0,0:18:53.96,0:18:55.30,Default,,0,0,0,,Хмм, бұл нені білдіреді?
Dialogue: 0,0:18:55.60,0:18:59.56,Default,,0,0,0,,Міне, бүгіннен бастап біз осында тұратын боламыз.
Dialogue: 0,0:18:59.66,0:19:01.23,Default,,0,0,0,,Алдымен қайда тұру керектігін шешіңіз
Dialogue: 0,0:19:01.60,0:19:05.03,Default,,0,0,0,,Үй? Жарайды, бұл менің жерім.
Dialogue: 0,0:19:05.23,0:19:06.76,Default,,0,0,0,,Ах~ Құлақ
Dialogue: 0,0:19:06.86,0:19:08.73,Default,,0,0,0,,Әй, осы желіден менің жеріме.
Dialogue: 0,0:19:08.83,0:19:11.60,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Осы жолдан бастап ол әрқашан менің жерім болды.
Dialogue: 0,0:19:11.70,0:19:12.86,Default,,0,0,0,,(Үш адам айғайлайды)
Dialogue: 0,0:19:12.96,0:19:16.43,Default,,0,0,0,,Уау, қандай аянышты көрініс.
Dialogue: 0,0:19:16.90,0:19:18.90,Default,,0,0,0,,Жапонияның барлық жерінде бос орындар бар.
Dialogue: 0,0:19:19.00,0:19:22.06,Default,,0,0,0,,Қарабайыр дәуірге не үшін келдің?
Dialogue: 0,0:19:22.20,0:19:23.50,Default,,0,0,0,,О, бұл ұят.
Dialogue: 0,0:19:23.60,0:19:24.76,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:19:28.03,0:19:30.16,Default,,0,0,0,,Иә? Бұл бөлік жақсы ма?
Dialogue: 0,0:19:30.26,0:19:33.53,Default,,0,0,0,,Оңтүстік-шығысқа қарап, жақсы көрініс, жақсы күн сәулесі
Dialogue: 0,0:19:33.80,0:19:35.60,Default,,0,0,0,,Эй, бұл жер жақсы.
Dialogue: 0,0:19:35.70,0:19:37.40,Default,,0,0,0,,Иә, келісемін
Dialogue: 0,0:19:37.50,0:19:39.36,Default,,0,0,0,,Қайсысы мәңгілік
Dialogue: 0,0:19:40.90,0:19:43.70,Default,,0,0,0,,Мұнда сізге жабайы аңдар шабуыл жасамайды.
Dialogue: 0,0:19:43.80,0:19:46.26,Default,,0,0,0,,Осы жерден үлкен шұңқыр жасап, сонда тұрайық.
Dialogue: 0,0:19:46.40,0:19:48.33,Default,,0,0,0,,Тас дәуіріндей болу жақсы емес пе?
Dialogue: 0,0:19:48.93,0:19:51.10,Default,,0,0,0,,Бұл тасты қалай қазып жатырсың?
Dialogue: 0,0:19:51.20,0:19:52.96,Default,,0,0,0,,Ал...
Dialogue: 0,0:19:53.53,0:19:55.73,Default,,0,0,0,,Жеңіл күрек!
Dialogue: 0,0:19:56.33,0:20:00.23,Default,,0,0,0,,Егер сіз мұны қолдансаңыз, пудинг сияқты оңай тастарды қазып аласыз.
Dialogue: 0,0:20:00.33,0:20:01.10,Default,,0,0,0,,Жарайды, мен мұны істеймін.
Dialogue: 0,0:20:01.20,0:20:05.13,Default,,0,0,0,,Мен мұны істеймін Қызық көрінеді Мен істеймін
Dialogue: 0,0:20:05.43,0:20:09.33,Default,,0,0,0,,Күтіңіз, күтіңіз, әлі көп жұмыс бар.
Dialogue: 0,0:20:10.60,0:20:12.60,Default,,0,0,0,,Ауыр жүк менікі, солай ма?
Dialogue: 0,0:20:12.93,0:20:16.03,Default,,0,0,0,,Олай болса, соғыс министрі... Жоқ, құрылыс министрі.
Dialogue: 0,0:20:16.66,0:20:19.43,Default,,0,0,0,,Саған қалдырайық (Нобита) Керемет.
Dialogue: 0,0:20:19.56,0:20:20.96,Default,,0,0,0,,, келесісі -
Dialogue: 0,0:20:21.16,0:20:23.36,Default,,0,0,0,,Ханазоно цилиндрі!
Dialogue: 0,0:20:24.60,0:20:28.73,Default,,0,0,0,,Ұсақ дәндер газ сияқты ұшып, гүл бақшасын жасайды.
Dialogue: 0,0:20:28.83,0:20:30.00,Default,,0,0,0,,Маған орындауға рұқсат етіңіз
Dialogue: 0,0:20:30.13,0:20:33.96,Default,,0,0,0,,Жарайды, Шизука-чан Қоршаған ортаны қорғау агенттігінің директоры.
Dialogue: 0,0:20:34.06,0:20:35.86,Default,,0,0,0,,Иә, қазір...
Dialogue: 0,0:20:36.13,0:20:38.20,Default,,0,0,0,,Әй, тездетіп мені де министр қыл.
Dialogue: 0,0:20:38.30,0:20:39.53,Default,,0,0,0,,Тағы не бар?
Dialogue: 0,0:20:39.63,0:20:42.80,Default,,0,0,0,,Ал, ауыл және орман шаруашылығы министріне барайық.
Dialogue: 0,0:20:42.90,0:20:44.60,Default,,0,0,0,,А, абай болыңыз
Dialogue: 0,0:20:45.06,0:20:47.26,Default,,0,0,0,,Даладағы мейрамхана
Dialogue: 0,0:20:48.03,0:20:50.53,Default,,0,0,0,,Бұл пісіруге арналған тұқымдарды қамтиды.
Dialogue: 0,0:20:50.63,0:20:52.10,Default,,0,0,0,,Егер сіз осы тұқымды ексеңіз,
Dialogue: 0,0:20:52.20,0:20:55.23,Default,,0,0,0,,Сіз өзіңіздің сүйікті тағамдарыңызды бір жыл бойы кез келген уақытта жей аласыз.
Dialogue: 0,0:20:55.76,0:20:57.30,Default,,0,0,0,,Онда ол Нобитаға жарамайды.
Dialogue: 0,0:20:57.40,0:20:58.56,Default,,0,0,0,,Неге екен?
Dialogue: 0,0:20:58.66,0:21:01.30,Default,,0,0,0,,Таңғы даңқтарды ексең де, олар әрқашан кеуіп қалады.
Dialogue: 0,0:21:01.60,0:21:04.26,Default,,0,0,0,,Ауыл және орман шаруашылығы министрі Сунео шешім қабылдады
Dialogue: 0,0:21:04.70,0:21:06.53,Default,,0,0,0,,Иә (Нобита) Эй, мен ше?
Dialogue: 0,0:21:06.63,0:21:09.23,Default,,0,0,0,,Жақсы жағдайда мен Тазалық министрімін деп айта аламын.
Dialogue: 0,0:21:09.33,0:21:10.20,Default,,0,0,0,,Сунео!
Dialogue: 0,0:21:10.43,0:21:12.86,Default,,0,0,0,,Нобита-кунның қолынан келетін сияқты...
Dialogue: 0,0:21:13.43,0:21:14.63,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:21:14.93,0:21:20.23,Default,,0,0,0,,Жануарлар генінің ампулалары және жұмыртқаны клондау!
Dialogue: 0,0:21:20.33,0:21:24.40,Default,,0,0,0,,Мен жалғызбын, өйткені мына кең дүниеде басқа достарым жоқ.
Dialogue: 0,0:21:24.50,0:21:26.26,Default,,0,0,0,,Үй жануарын жасаңыз
Dialogue: 0,0:21:26.43,0:21:27.50,Default,,0,0,0,,Үй жануарлары?
Dialogue: 0,0:21:27.86,0:21:31.36,Default,,0,0,0,,Осы жұмыртқаға ампулалық сұйықтықты енгізіңіз.
Dialogue: 0,0:21:31.46,0:21:32.93,Default,,0,0,0,,Мұны тіпті Нобита да жасай алады
Dialogue: 0,0:21:33.03,0:21:34.80,Default,,0,0,0,,Сонда мен қандай министрмін?
Dialogue: 0,0:21:34.90,0:21:37.16,Default,,0,0,0,,Үй жануарлары министрі ше?
Dialogue: 0,0:21:37.53,0:21:39.50,Default,,0,0,0,,Сіз үй жануарларының министрісіз бе?
Dialogue: 0,0:21:39.66,0:21:41.66,Default,,0,0,0,,Бұл біртүрлі, солай ма?
Dialogue: 0,0:21:41.76,0:21:43.00,Default,,0,0,0,,Эден мектебіне қабылдау нәтижелері
Dialogue: 0,0:21:48.90,0:21:53.23,Default,,0,0,0,,Ой, мына өзен арнасы жұмыртқа шығаруға қолайлы жер сияқты.
Dialogue: 0,0:21:56.40,0:21:58.46,Default,,0,0,0,,Бұл қара әйтеуір жұмыртқа -
Dialogue: 0,0:21:58.56,0:22:01.23,Default,,0,0,0,,Бар болғаны осы ампуланы енгізу керек.
Dialogue: 0,0:22:01.43,0:22:04.60,Default,,0,0,0,,Сондықтан Нобита да мұны істей алатынын тексеріңіз.
Dialogue: 0,0:22:04.70,0:22:07.93,Default,,0,0,0,,Неліктен сіз әрқашан осылай рөлдерде ойнайсыз?
Dialogue: 0,0:22:08.60,0:22:10.60,Default,,0,0,0,,Дұрыс, хехе...
Dialogue: 0,0:22:11.00,0:22:14.40,Default,,0,0,0,,Мұны барлығын таң қалдыру үшін пайдаланыңыз.
Dialogue: 0,0:22:20.40,0:22:22.33,Default,,0,0,0,,Ноби-чан О...
Dialogue: 0,0:22:22.50,0:22:24.76,Default,,0,0,0,,Қызық, Дора-чан қайда кетті?
Dialogue: 0,0:22:24.86,0:22:27.23,Default,,0,0,0,,Мен сізден бір тапсырманы орындауыңызды өтінемін деп ойладым.
Dialogue: 0,0:22:27.53,0:22:29.36,Default,,0,0,0,,Біртүрлі ауа-райы.
Dialogue: 0,0:22:29.83,0:22:32.23,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:22:42.06,0:22:44.13,Default,,0,0,0,,Ах, дұрыс... Уф.
Dialogue: 0,0:22:46.33,0:22:47.23,Default,,0,0,0,,Уф…
Dialogue: 0,0:22:53.23,0:22:55.10,Default,,0,0,0,,Уф, у…
Dialogue: 0,0:23:02.50,0:23:05.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:08.16,0:23:10.23,Default,,0,0,0,,Ваак кункун
Dialogue: 0,0:23:15.83,0:23:16.96,Default,,0,0,0,,Муара?
Dialogue: 0,0:23:17.66,0:23:21.26,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:23:32.00,0:23:36.06,Default,,0,0,0,,Қоршаған ортаны қорғау агенттігінің бас директоры Тұқым себу жақсы жүріп жатқан сияқты.
Dialogue: 0,0:23:36.46,0:23:37.60,Default,,0,0,0,,Күрсін
Dialogue: 0,0:23:38.86,0:23:42.13,Default,,0,0,0,,Егін егуді аяқтадым, бірақ бүршіктері өсіп тұрған сияқты.
Dialogue: 0,0:23:42.36,0:23:44.60,Default,,0,0,0,,Бұл жерде жаңбыр жауады деп үміттенемін...
Dialogue: 0,0:23:44.70,0:23:45.93,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:23:46.30,0:23:49.13,Default,,0,0,0,,Радио басқарылатын жаңбыр бұлттары!
Dialogue: 0,0:23:51.60,0:23:54.40,Default,,0,0,0,,Бұл жауынның құрамында да тыңайтқыш бар.
Dialogue: 0,0:23:54.50,0:23:56.00,Default,,0,0,0,,Бұл ыңғайлы.
Dialogue: 0,0:23:56.20,0:23:57.60,Default,,0,0,0,,Олай болса, мықты бол.
Dialogue: 0,0:23:58.03,0:24:01.10,Default,,0,0,0,,Ауыл және орман шаруашылығы министрінің жұмысы жақсы ма деп ойлаймын.
Dialogue: 0,0:24:01.56,0:24:05.43,Default,,0,0,0,,Сәлеметсіз бе, Сунео-кун күткендей, бұл тамаша рамен алқабы.
Dialogue: 0,0:24:06.06,0:24:08.90,Default,,0,0,0,,Дораемон, біз қоян емеспіз.
Dialogue: 0,0:24:09.00,0:24:10.70,Default,,0,0,0,,Бұл жай ғана жапырақтар.
Dialogue: 0,0:24:10.80,0:24:13.60,Default,,0,0,0,,Жақсы, кейін түсінесіз.
Dialogue: 0,0:24:13.86,0:24:15.93,Default,,0,0,0,,Бұл кешкі асқа уақытында
Dialogue: 0,0:24:16.26,0:24:18.90,Default,,0,0,0,,Радиомен басқарылатын күн!
Dialogue: 0,0:24:19.03,0:24:20.63,Default,,0,0,0,,Бұл шынымен рамен ме?
Dialogue: 0,0:24:20.73,0:24:22.40,Default,,0,0,0,,Сену
Dialogue: 0,0:24:22.73,0:24:24.80,Default,,0,0,0,,Не? Неліктен неге?
Dialogue: 0,0:24:31.86,0:24:34.66,Default,,0,0,0,,Құрылыс біршама алға жылжыған сияқты.
Dialogue: 0,0:24:35.26,0:24:37.63,Default,,0,0,0,,Бұл таңғажайып, Жа...
Dialogue: 0,0:24:38.90,0:24:41.70,Default,,0,0,0,,Кешіріңіз, мен негізінен қазуды аяқтадым, бірақ...
Dialogue: 0,0:24:42.03,0:24:44.46,Default,,0,0,0,,Ал ас үй мен дәретхана ше?
Dialogue: 0,0:24:44.96,0:24:47.10,Default,,0,0,0,,А, мынаны қосайық.
Dialogue: 0,0:24:47.80,0:24:50.03,Default,,0,0,0,,Нобир су құбыры!
Dialogue: 0,0:24:50.50,0:24:54.50,Default,,0,0,0,,Оны жерге жабыстырсаң, жер асты суының тамырына жетіп, су шығады.
Dialogue: 0,0:24:54.60,0:24:58.33,Default,,0,0,0,,Бұл нобир газ құбыры табиғи газды орналастырады.
Dialogue: 0,0:24:58.50,0:25:00.63,Default,,0,0,0,,Бұл асыл кәріз құбыры.
Dialogue: 0,0:25:01.30,0:25:02.63,Default,,0,0,0,,Жарайды, мен оны орнатамын.
Dialogue: 0,0:25:03.10,0:25:05.60,Default,,0,0,0,,Сосын сұрадым, саған қалдырамын.
Dialogue: 0,0:25:05.90,0:25:09.03,Default,,0,0,0,,Енді мәселе үй жануарлары министрі Нобитада.
Dialogue: 0,0:25:13.80,0:25:16.20,Default,,0,0,0,,Сол жақтағы жұмыртқа жұмыртқадан шығады.
Dialogue: 0,0:25:17.43,0:25:18.86,Default,,0,0,0,,Хиен
Dialogue: 0,0:25:21.16,0:25:23.13,Default,,0,0,0,,Пегастың дүниеге келуі
Dialogue: 0,0:25:23.93,0:25:27.06,Default,,0,0,0,,Мен жылқы мен аққу ампуласын бір уақытта қолдандым.
Dialogue: 0,0:25:27.53,0:25:29.20,Default,,0,0,0,,Өте сүйкімді~
Dialogue: 0,0:25:29.66,0:25:32.66,Default,,0,0,0,,Аа, басқа жұмыртқалар да шығып кететін сияқты.
Dialogue: 0,0:25:33.63,0:25:35.00,Default,,0,0,0,,Аа
Dialogue: 0,0:25:35.40,0:25:37.50,Default,,0,0,0,,Бүркіт пен арыстаннан жасалған Гриффин
Dialogue: 0,0:25:38.80,0:25:40.30,Default,,0,0,0,,Мынау да сүйкімді~
Dialogue: 0,0:25:41.23,0:25:44.00,Default,,0,0,0,,Крокодил, бұғы және жарғанат Рю
Dialogue: 0,0:25:45.16,0:25:48.63,Default,,0,0,0,,Мен осындай сүйкімді нәрсені жасай алу үшін данышпан болуым керек.
Dialogue: 0,0:25:48.73,0:25:50.06,Default,,0,0,0,,Нобита-кун
Dialogue: 0,0:25:50.16,0:25:51.63,Default,,0,0,0,,Бұл Дораемон!
Dialogue: 0,0:25:51.83,0:25:54.90,Default,,0,0,0,,Әй, бәрі тығылып, шу болды, тезірек!
Dialogue: 0,0:25:59.60,0:26:00.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:01.30,0:26:04.40,Default,,0,0,0,,арқылы не жасадыңыз? ит? мысық?
Dialogue: 0,0:26:04.50,0:26:06.93,Default,,0,0,0,,Сосын мен ұйықтап қалдым.
Dialogue: 0,0:26:07.03,0:26:09.50,Default,,0,0,0,,Ендеше, сіз ештеңе істеп жатқан жоқсыз ба?
Dialogue: 0,0:26:09.60,0:26:11.20,Default,,0,0,0,,Тез жасаңыз
Dialogue: 0,0:26:11.40,0:26:13.66,Default,,0,0,0,,Ол дүниеге келгенде, оны тамақтандырыңыз.
Dialogue: 0,0:26:13.76,0:26:14.90,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:15.30,0:26:17.90,Default,,0,0,0,,Жануарларға арналған әмбебап тамақ!
Dialogue: 0,0:26:18.60,0:26:21.83,Default,,0,0,0,,Оны көп тамақтандырсаң, тез өседі.
Dialogue: 0,0:26:21.93,0:26:23.36,Default,,0,0,0,,Түсіндім, түсіндім.
Dialogue: 0,0:26:23.46,0:26:25.36,Default,,0,0,0,,Біздің тамақ ішетін уақыт та қалды
Dialogue: 0,0:26:25.46,0:26:27.53,Default,,0,0,0,,Иә, мен бірден барамын.
Dialogue: 0,0:26:28.13,0:26:29.83,Default,,0,0,0,,(үш жылау)
Dialogue: 0,0:26:29.93,0:26:33.30,Default,,0,0,0,,Қараңдар, көп жеп, тез өсіңдер.
Dialogue: 0,0:26:35.40,0:26:39.80,Default,,0,0,0,,Пега, Драко және Гури есімдерін қоямыз.
Dialogue: 0,0:26:40.10,0:26:43.33,Default,,0,0,0,,Жоқ, бұл котлет ыдысы дерлік дайын.
Dialogue: 0,0:26:43.76,0:26:47.26,Default,,0,0,0,,Бұл катсудон қайда? Қалай қарасаң да, бұл дайкон шалғам.
Dialogue: 0,0:26:47.36,0:26:49.73,Default,,0,0,0,,Жақсы, жақсы, тез қабылдап алайық.
Dialogue: 0,0:26:50.36,0:26:53.26,Default,,0,0,0,,Шалғамды цукудани жасауға болмайды.
Dialogue: 0,0:26:53.56,0:26:55.70,Default,,0,0,0,,Мен шалғамды жек көремін
Dialogue: 0,0:26:55.80,0:26:57.26,Default,,0,0,0,,Аяғыңды тез жазып алғаның жөн.
Dialogue: 0,0:26:58.90,0:27:01.33,Default,,0,0,0,,Шизука-чан ах
Dialogue: 0,0:27:01.80,0:27:04.06,Default,,0,0,0,,Тамақтың уақыты жақындап қалды~
Dialogue: 0,0:27:04.16,0:27:05.50,Default,,0,0,0,,Шалғам ұны
Dialogue: 0,0:27:05.60,0:27:07.23,Default,,0,0,0,,Иә, мен бірден барамын.
Dialogue: 0,0:27:07.96,0:27:09.53,Default,,0,0,0,,Әй, сырты да таза.
Dialogue: 0,0:27:09.63,0:27:11.23,Default,,0,0,0,,Мен істеймін, ішін де бір қараңыз.
Dialogue: 0,0:27:11.83,0:27:13.16,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:27:13.33,0:27:15.83,Default,,0,0,0,,Жарайды, Джан, мұны өзің тұрғыздың ба?
Dialogue: 0,0:27:15.93,0:27:19.46,Default,,0,0,0,,Мына жерде дәретхана, мына жерде ас үй.
Dialogue: 0,0:27:19.63,0:27:20.46,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:27:20.56,0:27:22.16,Default,,0,0,0,,Уау, қандай жақсы бөлме.
Dialogue: 0,0:27:22.26,0:27:24.10,Default,,0,0,0,,А, Нобита-кун келмеді ме?
Dialogue: 0,0:27:24.20,0:27:25.26,Default,,0,0,0,,Иә
Dialogue: 0,0:27:25.36,0:27:27.63,Default,,0,0,0,,Бұл мүлдем баяу.
Dialogue: 0,0:27:28.43,0:27:29.73,Default,,0,0,0,,Шағын жиһаз
Dialogue: 0,0:27:29.86,0:27:31.06,Default,,0,0,0,,Уау өте сүйкімді
Dialogue: 0,0:27:31.16,0:27:33.36,Default,,0,0,0,,Бөлмеңізге сүйікті жиһазыңызды әкеліңіз
Dialogue: 0,0:27:33.46,0:27:35.36,Default,,0,0,0,,Мен оны кейінірек үлкейтемін (Сунео/Шидзука) Иә.
Dialogue: 0,0:27:35.93,0:27:38.33,Default,,0,0,0,,Дораемон, менің қарным ашты.
Dialogue: 0,0:27:38.83,0:27:40.86,Default,,0,0,0,,Тамақ дайын.
Dialogue: 0,0:27:40.96,0:27:42.13,Default,,0,0,0,,Шалғам
Dialogue: 0,0:27:42.70,0:27:46.16,Default,,0,0,0,,Шалғам? Маған катсудон ұнайды
Dialogue: 0,0:27:47.53,0:27:48.53,Default,,0,0,0,,Хмм
Dialogue: 0,0:27:48.63,0:27:51.03,Default,,0,0,0,,Мен спагетти жегім келді.
Dialogue: 0,0:27:51.13,0:27:53.56,Default,,0,0,0,,Шалғамды осылай қалай жейсің?
Dialogue: 0,0:27:53.86,0:27:58.33,Default,,0,0,0,,Ол қалың шалғамға ұқсайды, бірақ шын мәнінде ол екі бөлікке бөлінеді.
Dialogue: 0,0:27:58.60,0:28:00.63,Default,,0,0,0,,Ішінде жаңа піскен дораяки
Dialogue: 0,0:28:01.10,0:28:04.06,Default,,0,0,0,,Не? Уау, ішінде сиыр еті бар.
Dialogue: 0,0:28:04.76,0:28:06.46,Default,,0,0,0,,Жоқ, бұл катсудон.
Dialogue: 0,0:28:07.26,0:28:10.53,Default,,0,0,0,,Уау, мен спагетти аламын.
Dialogue: 0,0:28:11.30,0:28:13.76,Default,,0,0,0,,Бұл дәмді. Дәмді. Бұл дәмді.
Dialogue: 0,0:28:13.86,0:28:16.03,Default,,0,0,0,,Басында не болар екен деп ойладым.
Dialogue: 0,0:28:17.76,0:28:19.40,Default,,0,0,0,,Нобита-сан, сен не істеп жатырсың?
Dialogue: 0,0:28:19.60,0:28:22.76,Default,,0,0,0,,Жарайды, иіскеп ал, мен бірден келемін.
Dialogue: 0,0:28:23.06,0:28:23.90,Default,,0,0,0,,Бұл Койл деген жігіт шын мәнінде пайдалы ма?
Dialogue: 0,0:28:24.43,0:28:26.46,Default,,0,0,0,,Эй, жақсы иіс шығады.
Dialogue: 0,0:28:27.10,0:28:28.26,Default,,0,0,0,,тым кеш болды.
Dialogue: 0,0:28:28.46,0:28:30.23,Default,,0,0,0,,Иә, мен аламын.
Dialogue: 0,0:28:30.56,0:28:31.93,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:28:32.83,0:28:34.53,Default,,0,0,0,,Ммм
Dialogue: 0,0:28:34.63,0:28:37.60,Default,,0,0,0,,Мм, мына шалғам дәмді екен.
Dialogue: 0,0:28:38.03,0:28:40.76,Default,,0,0,0,,Мұндай тамақтанудың жолдары бар.
Dialogue: 0,0:28:41.20,0:28:43.06,Default,,0,0,0,,Иә? Келесі толтыру
Dialogue: 0,0:28:43.16,0:28:45.70,Default,,0,0,0,,Джиан таңғажайып, бүкіл денесін жейді
Dialogue: 0,0:28:46.06,0:28:47.76,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,0:28:47.90,0:28:50.46,Default,,0,0,0,,Осыншама жесең, семіресің.
Dialogue: 0,0:28:51.63,0:28:53.70,Default,,0,0,0,,бірақ мен де, Ято да ақша табуымыз керек қой!
Dialogue: 0,0:29:03.10,0:29:05.13,Default,,0,0,0,,Әдемі кемпірқосақ.
Dialogue: 0,0:29:05.23,0:29:08.50,Default,,0,0,0,,Расында, бұл жұмақ.
Dialogue: 0,0:29:09.00,0:29:12.10,Default,,0,0,0,,Керемет табиғат аясында осылайша...
Dialogue: 0,0:29:12.20,0:29:15.60,Default,,0,0,0,,Кішігірім уайымдар енді маңызды емес.
Dialogue: 0,0:29:15.90,0:29:17.70,Default,,0,0,0,,Шынымен иә
Dialogue: 0,0:29:18.80,0:29:21.73,Default,,0,0,0,,Үйге бір рет барайын ба?
Dialogue: 0,0:29:21.83,0:29:23.76,Default,,0,0,0,,Иә, бұл жақсы.
Dialogue: 0,0:29:23.86,0:29:27.50,Default,,0,0,0,,Дұрыс, мен сені қазір сонша айғайлайтын шығар деп ойламаймын.
Dialogue: 0,0:29:27.90,0:29:31.16,Default,,0,0,0,,Бұл жақсы. Сіз әрқашан қайтадан келе аласыз ...
Dialogue: 0,0:29:32.00,0:29:35.63,Default,,0,0,0,,Иә? Айтпақшы, мен неге үйден қашып кеттім?
Dialogue: 0,0:29:36.16,0:29:38.30,Default,,0,0,0,,Хмм... ұмытып кетіппін.
Dialogue: 0,0:29:42.33,0:29:44.63,Default,,0,0,0,,Бұл өте қызықты күн болды.
Dialogue: 0,0:29:44.73,0:29:46.46,Default,,0,0,0,,Иә (Сунео) Мен ертең қайтамын.
Dialogue: 0,0:29:46.56,0:29:47.66,Default,,0,0,0,,Иә.
Dialogue: 0,0:29:55.83,0:29:57.33,Default,,0,0,0,,Қайда болдың?
Dialogue: 0,0:29:57.56,0:29:59.43,Default,,0,0,0,,Аа, сізді мазалағаным үшін кешіріңіз.
Dialogue: 0,0:29:59.53,0:30:01.43,Default,,0,0,0,,Қош бол (Сунео) Кешіріңіз.
Dialogue: 0,0:30:01.53,0:30:03.16,Default,,0,0,0,,Әй, апа, мен оны қашан көрсем.
Dialogue: 0,0:30:03.26,0:30:04.16,Default,,0,0,0,,Жарайды (Сунео) Кешіріңіз.
Dialogue: 0,0:30:04.30,0:30:06.83,Default,,0,0,0,,Сунэ Чан не істер еді?
Dialogue: 0,0:30:06.93,0:30:08.30,Default,,0,0,0,,Иә.
Dialogue: 0,0:30:08.66,0:30:11.66,Default,,0,0,0,,Хамстер! Эй... сен оны себетіңе салғаныңа сенімдісің бе?
Dialogue: 0,0:30:11.76,0:30:13.00,Default,,0,0,0,,Ол қамтылған.
Dialogue: 0,0:30:13.10,0:30:14.80,Default,,0,0,0,,Жақсы
Dialogue: 0,0:30:16.70,0:30:17.90,Default,,0,0,0,,Ертең кездескенше (Нобита) Иә.
Dialogue: 0,0:30:18.00,0:30:19.16,Default,,0,0,0,,Қош бол (Сунео)
Dialogue: 0,0:30:19.26,0:30:20.73,Default,,0,0,0,,Ешкімге айтпа
Dialogue: 0,0:30:21.00,0:30:23.23,Default,,0,0,0,,Білемін, сен ақымақсың.
Dialogue: 0,0:30:23.33,0:30:25.26,Default,,0,0,0,,Оны барлығы ести алады, солай ма?
Dialogue: 0,0:30:38.76,0:30:40.10,Default,,0,0,0,,Хаа…
Dialogue: 0,0:30:44.43,0:30:46.66,Default,,0,0,0,,Уау
Dialogue: 0,0:30:46.76,0:30:47.86,Default,,0,0,0,,Уау
Dialogue: 0,0:30:48.06,0:30:55.26,Default,,0,0,0,,(Хикари тайпасының айқайы)
Dialogue: 0,0:30:55.50,0:30:57.26,Default,,0,0,0,,Беріліс!
Dialogue: 0,0:30:58.00,0:31:01.53,Default,,0,0,0,,Мамуа Мамуа Памуа
Dialogue: 0,0:31:02.40,0:31:05.20,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:31:07.10,0:31:08.06,Default,,0,0,0,,Ha
Dialogue: 0,0:31:09.13,0:31:10.90,Default,,0,0,0,,Ууууу...
Dialogue: 0,0:31:11.33,0:31:14.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:14.43,0:31:17.10,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:17.20,0:31:18.46,Default,,0,0,0,,Жалпы алғанда, сол хабар тарату мұнарасынан өткеннен кейін сигнал әдетте жақсы болады
Dialogue: 0,0:31:19.90,0:31:22.13,Default,,0,0,0,,Қаңғыбас ит жартылай ұйықтап жатқан жоқ па?
Dialogue: 0,0:31:24.30,0:31:25.80,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:26.46,0:31:29.86,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:31:30.83,0:31:32.36,Default,,0,0,0,,Ауырсыну
Dialogue: 0,0:31:36.20,0:31:39.36,Default,,0,0,0,,Бірден үйден қашу - үлкен мәселе.
Dialogue: 0,0:31:39.46,0:31:44.60,Default,,0,0,0,,Сонымен, егер сіз мұны күніне 3 сағат сияқты күнделікті аздап жасасаңыз, ол байқалмайды.
Dialogue: 0,0:31:44.70,0:31:46.60,Default,,0,0,0,,Күн сайын үйден бірте-бірте қашасың ба?
Dialogue: 0,0:31:46.70,0:31:49.03,Default,,0,0,0,,Үйден қашу дегеніңіз осы ма?
Dialogue: 0,0:31:49.13,0:31:53.23,Default,,0,0,0,,Ауыр сөз айтпа, бірақ бұл сырды ешкімге айтпа.
Dialogue: 0,0:31:53.33,0:31:54.23,Default,,0,0,0,,Әрине
Dialogue: 0,0:31:54.33,0:31:55.80,Default,,0,0,0,,Аа, тшш, біреу келе жатыр.
Dialogue: 0,0:31:56.03,0:31:59.70,Default,,0,0,0,,Әй, сен не айтып тұрсың? Мені де қосыңызшы.
Dialogue: 0,0:32:00.70,0:32:03.10,Default,,0,0,0,,Ах, а... бұл...
Dialogue: 0,0:32:03.20,0:32:04.83,Default,,0,0,0,,Джианның қайталау кеңесі
Dialogue: 0,0:32:05.03,0:32:06.20,Default,,0,0,0,,Иә? (Б оқушы) Жоқ.
Dialogue: 0,0:32:06.30,0:32:07.50,Default,,0,0,0,,Бірақ... Сәттілік.
Dialogue: 0,0:32:08.63,0:32:11.96,Default,,0,0,0,,Fuss Neo Сіз мені алдауға шеберсіз.
Dialogue: 0,0:32:12.60,0:32:14.46,Default,,0,0,0,,Мен данышпанмын, солай ма?
Dialogue: 0,0:32:14.56,0:32:16.53,Default,,0,0,0,,Хехехе Сунео-кун керемет.
Dialogue: 0,0:32:16.63,0:32:17.63,Default,,0,0,0,,Бұл
Dialogue: 0,0:32:18.33,0:32:21.16,Default,,0,0,0,,Джан қазір байсалды.
Dialogue: 0,0:32:29.20,0:32:30.13,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:32:30.60,0:32:31.90,Default,,0,0,0,,Қайтып келдің!
Dialogue: 0,0:32:32.23,0:32:34.86,Default,,0,0,0,,Ноби-чан, сен бүгін бақшаның арам шөптерін шауып жатырсың.
Dialogue: 0,0:32:34.96,0:32:36.46,Default,,0,0,0,,Ах, мен келдім.
Dialogue: 0,0:32:36.56,0:32:39.00,Default,,0,0,0,,Онда бөлмеңді жина... Мен жинаймын.
Dialogue: 0,0:32:39.10,0:32:41.66,Default,,0,0,0,,Үй тапсырмасын орындағаннан кейін үйден қашуға болады.
Dialogue: 0,0:32:42.10,0:32:43.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:43.46,0:32:45.86,Default,,0,0,0,,Тез, асық (Нобита) Иә, асығыс болсам да.
Dialogue: 0,0:32:47.03,0:32:48.30,Default,,0,0,0,,Маған жауап маңызды емес.
Dialogue: 0,0:32:48.40,0:32:50.60,Default,,0,0,0,,Мен оны тез тазалаймын.
Dialogue: 0,0:32:51.46,0:32:53.70,Default,,0,0,0,,Нобита! Ноби-чан!
Dialogue: 0,0:32:54.03,0:32:56.33,Default,,0,0,0,,Тоңазытқыштың іші толығымен таза.
Dialogue: 0,0:32:56.43,0:32:57.53,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:32:57.83,0:33:01.00,Default,,0,0,0,,Тш, білмеймін. Эй, Дораемон.
Dialogue: 0,0:33:01.10,0:33:04.43,Default,,0,0,0,,Мен не болса да осыншама жей алмаймын.
Dialogue: 0,0:33:04.53,0:33:06.23,Default,,0,0,0,,Міне саған – қоштасу сүйісі.
Dialogue: 0,0:33:06.50,0:33:08.60,Default,,0,0,0,,Сонда мұны кім жасады?
Dialogue: 0,0:33:08.70,0:33:12.03,Default,,0,0,0,,Әй, ұры кіріп кеткен шығар?
Dialogue: 0,0:33:12.13,0:33:13.86,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:33:13.96,0:33:18.36,Default,,0,0,0,,Есік жабық, тамақты ұрлай алмайсың.
Dialogue: 0,0:33:18.46,0:33:21.26,Default,,0,0,0,,Мүмкін шынымен аш ұры шығар
Dialogue: 0,0:33:21.40,0:33:23.66,Default,,0,0,0,,Қалай болғанда да, дереу дүкенге барыңыз.
Dialogue: 0,0:33:23.76,0:33:24.96,Default,,0,0,0,,Уау~ Эх~
Dialogue: 0,0:33:25.93,0:33:27.90,Default,,0,0,0,,Оған көмектесу мүмкін емес, тез барайық.
Dialogue: 0,0:33:30.56,0:33:32.63,Default,,0,0,0,,Нобита-кун
Dialogue: 0,0:33:33.56,0:33:36.23,Default,,0,0,0,,Әй, сен сонда Нобитаны кездестірмедің бе?
Dialogue: 0,0:33:36.33,0:33:38.76,Default,,0,0,0,,Мен жай ғана тапсырма сұрадым.
Dialogue: 0,0:33:39.06,0:33:41.16,Default,,0,0,0,,Олай болса, сәл көтеріліп, күте тұрайын.
Dialogue: 0,0:33:41.26,0:33:42.80,Default,,0,0,0,,Мазалағаным үшін кешіріңіз, о...
Dialogue: 0,0:33:44.36,0:33:48.06,Default,,0,0,0,,Тапсырмаларыңызды тез бітіруіңіз керек.
Dialogue: 0,0:33:48.16,0:33:50.66,Default,,0,0,0,,Сіз әрқашан өте баяусыз.
Dialogue: 0,0:33:51.00,0:33:52.33,Default,,0,0,0,,Нобита...
Dialogue: 0,0:33:52.43,0:33:54.46,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:33:55.06,0:33:56.30,Default,,0,0,0,,Қызық, сонда біреу бар ма?
Dialogue: 0,0:33:56.66,0:33:58.50,Default,,0,0,0,,Бұл егеуқұйрық емес пе?
Dialogue: 0,0:33:59.16,0:34:01.80,Default,,0,0,0,,Оның орнына күткенше киімімізді ауыстырайық.
Dialogue: 0,0:34:02.23,0:34:04.70,Default,,0,0,0,,Келісемін Бұл бос уақыт.
Dialogue: 0,0:34:08.00,0:34:11.73,Default,,0,0,0,,Ерм, а, мына киімдер, олар оңай.
Dialogue: 0,0:34:11.83,0:34:12.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:13.10,0:34:16.10,Default,,0,0,0,,Джиан Бұл жерде біреу бар сияқты.
Dialogue: 0,0:34:16.23,0:34:18.30,Default,,0,0,0,,Бұл рас па? Жарайды, мен қараймын.
Dialogue: 0,0:34:18.60,0:34:20.53,Default,,0,0,0,,Бұл кім? шкафта кім бар
Dialogue: 0,0:34:20.63,0:34:21.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:34:23.23,0:34:25.86,Default,,0,0,0,,«Уау» деген не? Мені қорқытпа.
Dialogue: 0,0:34:26.00,0:34:28.80,Default,,0,0,0,,Ууу гууу
Dialogue: 0,0:34:29.30,0:34:32.03,Default,,0,0,0,,Мен оны бұрын көрген емеспін, бірақ ол Нобитаның туысы ма?
Dialogue: 0,0:34:32.56,0:34:33.43,Default,,0,0,0,,Такобо!
Dialogue: 0,0:34:34.06,0:34:36.00,Default,,0,0,0,,Ол шетелдік, Сунео.
Dialogue: 0,0:34:36.10,0:34:37.26,Default,,0,0,0,,Түсіңіз.
Dialogue: 0,0:34:37.36,0:34:39.90,Default,,0,0,0,,Партаға шықпау керек.
Dialogue: 0,0:34:40.00,0:34:41.66,Default,,0,0,0,,Дагу Тейна
Dialogue: 0,0:34:41.80,0:34:43.93,Default,,0,0,0,,Мына бейбақ (Сунео) Ах~
Dialogue: 0,0:34:44.10,0:34:47.03,Default,,0,0,0,,Иә? Гаха ааа
Dialogue: 0,0:34:47.36,0:34:49.73,Default,,0,0,0,,Уау~ Ууу
Dialogue: 0,0:34:49.83,0:34:50.86,Default,,0,0,0,,Уф
Dialogue: 0,0:34:50.96,0:34:52.96,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:34:53.06,0:34:55.36,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:34:55.46,0:34:57.46,Default,,0,0,0,,Эй, бұл не болды?
Dialogue: 0,0:34:57.56,0:34:59.33,Default,,0,0,0,,Иә? бұл кім
Dialogue: 0,0:34:59.43,0:35:03.90,Default,,0,0,0,,Кім? Құпия десеңіз де, тобыңызға осындай адам қосылсын!
Dialogue: 0,0:35:04.00,0:35:06.00,Default,,0,0,0,,Мен бұл қызды танымаймын.
Dialogue: 0,0:35:06.43,0:35:08.90,Default,,0,0,0,,Сен онда не істеп жүрсің?
Dialogue: 0,0:35:09.06,0:35:09.50,Default,,0,0,0,,Екінші қабатта шу шығаруға болмайды дейді.
Dialogue: 0,0:35:09.50,0:35:11.56,Default,,0,0,0,,Екінші қабатта шу шығаруға болмайды дейді.
Dialogue: 0,0:35:09.50,0:35:11.56,Default,,0,0,0,,Жаман, тез, тез
Dialogue: 0,0:35:11.56,0:35:12.20,Default,,0,0,0,,Екінші қабатта шу шығаруға болмайды дейді.
Dialogue: 0,0:35:13.56,0:35:16.40,Default,,0,0,0,,Нобита Ах... Әй?
Dialogue: 0,0:35:23.10,0:35:24.86,Default,,0,0,0,,Мынау кім?
Dialogue: 0,0:35:25.03,0:35:26.60,Default,,0,0,0,,Егер сіз білмесеңіз
Dialogue: 0,0:35:26.70,0:35:28.13,Default,,0,0,0,,Онда неге бұлай киіп жүрсің?
Dialogue: 0,0:35:28.63,0:35:30.16,Default,,0,0,0,,Оның найзасы бар, қара.
Dialogue: 0,0:35:30.26,0:35:31.50,Default,,0,0,0,,Ах, иттататататата...
Dialogue: 0,0:35:31.60,0:35:34.13,Default,,0,0,0,,Әй, бұл нағыз тас найза.
Dialogue: 0,0:35:34.23,0:35:35.16,Default,,0,0,0,,Не? (Нобита) Олай болса
Dialogue: 0,0:35:35.26,0:35:38.13,Default,,0,0,0,,Бұл бала нағыз қарабайыр адам емес пе?
Dialogue: 0,0:35:47.66,0:35:51.63,Default,,0,0,0,,20 ғасырда Токиода нағыз қарабайыр адамдар қалай болды?
Dialogue: 0,0:35:52.13,0:35:54.10,Default,,0,0,0,,Иә, бұл біртүрлі.
Dialogue: 0,0:35:54.20,0:35:56.10,Default,,0,0,0,,Өйткені, Нобита оны осында әкелді.
Dialogue: 0,0:35:56.20,0:35:58.20,Default,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:35:58.43,0:36:00.23,Default,,0,0,0,,Мүмкін солай шығар?
Dialogue: 0,0:36:00.96,0:36:02.26,Default,,0,0,0,,«Бұл»?
Dialogue: 0,0:36:02.80,0:36:05.56,Default,,0,0,0,,Біз бұл дүниеге алғаш келген кезде—
Dialogue: 0,0:36:05.66,0:36:07.70,Default,,0,0,0,,Кеңістік-уақыт турбуленттігі болды.
Dialogue: 0,0:36:07.80,0:36:11.76,Default,,0,0,0,,Бұл уақыт ағымында болатын тұзақ.
Dialogue: 0,0:36:11.96,0:36:15.23,Default,,0,0,0,,Кейде адамдар оны жұтып қояды.
Dialogue: 0,0:36:15.33,0:36:17.00,Default,,0,0,0,,Жұтылып кетсе не болады?
Dialogue: 0,0:36:17.26,0:36:19.93,Default,,0,0,0,,Ол қазір біз өмір сүріп жатқан әлемнен жоғалады.
Dialogue: 0,0:36:20.53,0:36:22.40,Default,,0,0,0,,Адамдар жойылып кете ме?
Dialogue: 0,0:36:22.50,0:36:23.83,Default,,0,0,0,,Мен мұндай әңгімені естімеппін.
Dialogue: 0,0:36:24.13,0:36:27.20,Default,,0,0,0,,Жапонияда да оның рухы қашады деп айтылады.
Dialogue: 0,0:36:27.30,0:36:30.60,Default,,0,0,0,,Дүние жүзінде мұндай әңгімелер көп.
Dialogue: 0,0:36:30.70,0:36:36.13,Default,,0,0,0,,Жақында 1937 жылы желтоқсанда Қытайдағы Янцзы өзенінде —
Dialogue: 0,0:36:36.23,0:36:39.80,Default,,0,0,0,,Бірден 3000 солдат із-түссіз жоғалып кеткен.
Dialogue: 0,0:36:40.20,0:36:42.86,Default,,0,0,0,,Ал, сонда ол кісілерге не болды?
Dialogue: 0,0:36:43.43,0:36:46.90,Default,,0,0,0,,Жол асты кеңістігінде мәңгі қалқып жүрмін, егер жолым болса...
Dialogue: 0,0:36:47.00,0:36:49.30,Default,,0,0,0,,Шығу кезінде шығуға болатын сияқты.
Dialogue: 0,0:36:50.00,0:36:53.33,Default,,0,0,0,,Ендеше, бұл бала да ертеден осында болды ма?
Dialogue: 0,0:36:53.46,0:36:55.43,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:36:55.53,0:36:56.90,Default,,0,0,0,,Бұл көңіл көншітеді.
Dialogue: 0,0:36:57.00,0:36:58.20,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:36:58.56,0:37:02.73,Default,,0,0,0,,Өйткені адамдар Жапонияда 70 000 жыл бұрын өмір сүрген.
Dialogue: 0,0:37:02.90,0:37:05.50,Default,,0,0,0,,Жоқ, мен бұл туралы әлі білмеймін.
Dialogue: 0,0:37:05.86,0:37:09.40,Default,,0,0,0,,Мен бұл баланың қай дәуірден шыққанын анықтаймын.
Dialogue: 0,0:37:09.60,0:37:11.76,Default,,0,0,0,,Шизука-чан, мына балаға қамқор болшы.
Dialogue: 0,0:37:11.93,0:37:12.93,Default,,0,0,0,,Иә
Dialogue: 0,0:37:13.10,0:37:17.83,Default,,0,0,0,,Қалған үшеуіне келетін болсақ, бұл жерде біреудің тұратын-тұрмағанын біліңіз.
Dialogue: 0,0:37:18.56,0:37:21.36,Default,,0,0,0,,Екеуміз ғана болғанымыз дұрыс.
Dialogue: 0,0:37:21.50,0:37:24.83,Default,,0,0,0,,Иә, мұндай жерде адасып кету қиын болар еді.
Dialogue: 0,0:37:24.93,0:37:25.90,Default,,0,0,0,,Е, сен кім туралы айтып тұрсың? Сонда кездескенше
Dialogue: 0,0:37:26.00,0:37:28.13,Default,,0,0,0,,Нобитаны іздеудің қажеті жоқ.
Dialogue: 0,0:37:28.80,0:37:30.73,Default,,0,0,0,,Тексеріңіз, сіз айтып отырсыз.
Dialogue: 0,0:37:30.83,0:37:32.43,Default,,0,0,0,,Олай болса менімен бірге жүр.
Dialogue: 0,0:37:32.53,0:37:33.46,Default,,0,0,0,,Иә
Dialogue: 0,0:37:38.50,0:37:41.73,Default,,0,0,0,,Аа, уақыт машинасының шығуынан айта аласыз ба?
Dialogue: 0,0:37:41.83,0:37:44.80,Default,,0,0,0,,Иә, ол бала қашан, қайдан шыққан?
Dialogue: 0,0:37:45.20,0:37:47.80,Default,,0,0,0,,Кеңістік-уақыт жер сілкінісінің есептегіші!
Dialogue: 0,0:37:48.03,0:37:50.26,Default,,0,0,0,,Мына бақылау сферасын ішіне салыңыз
Dialogue: 0,0:37:50.36,0:37:51.36,Default,,0,0,0,,Хмм.
Dialogue: 0,0:37:51.76,0:37:53.70,Default,,0,0,0,,Уақыт пен кеңістік ағынында қалқыған
Dialogue: 0,0:37:54.23,0:37:56.16,Default,,0,0,0,,Кеңістік пен уақыттағы толқындарды зерттеу
Dialogue: 0,0:38:00.40,0:38:01.63,Default,,0,0,0,,Эй, міне, осы.
Dialogue: 0,0:38:02.80,0:38:04.40,Default,,0,0,0,,Мына жігіттің соңынан ерейік
Dialogue: 0,0:38:05.66,0:38:06.63,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:38:09.30,0:38:11.53,Default,,0,0,0,,Қашан? қайда? Эй
Dialogue: 0,0:38:14.50,0:38:15.46,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:38:15.56,0:38:17.23,Default,,0,0,0,,Өте шулы
Dialogue: 0,0:38:17.60,0:38:20.66,Default,,0,0,0,,Үй жануарлары ше? үй жануарлары министрі
Dialogue: 0,0:38:20.76,0:38:22.20,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:38:24.66,0:38:26.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:38:26.80,0:38:28.93,Default,,0,0,0,,А, міне, міне, мынау.
Dialogue: 0,0:38:29.53,0:38:31.26,Default,,0,0,0,,үшін қайда кетті?
Dialogue: 0,0:38:32.80,0:38:35.63,Default,,0,0,0,,Пега Драко Грис
Dialogue: 0,0:38:36.03,0:38:38.80,Default,,0,0,0,,Шық, бұл менмін!
Dialogue: 0,0:38:40.70,0:38:41.60,Default,,0,0,0,,Уф
Dialogue: 0,0:38:42.56,0:38:44.83,Default,,0,0,0,,Иә? Уау
Dialogue: 0,0:38:46.96,0:38:48.10,Default,,0,0,0,,Пега!
Dialogue: 0,0:38:48.33,0:38:52.06,Default,,0,0,0,,Пеггер, сен есейдің. Мен түсінбедім.
Dialogue: 0,0:38:52.50,0:38:54.16,Default,,0,0,0,,Драко мен Гури қайда?
Dialogue: 0,0:38:54.60,0:38:56.10,Default,,0,0,0,,(Пеганың айқайы)
Dialogue: 0,0:38:59.60,0:39:02.93,Default,,0,0,0,,Гри~Драко~
Dialogue: 0,0:39:03.76,0:39:08.93,Default,,0,0,0,,Ой, бәрі есейіп кетті. Олар мені есіне алады. Апыр-ай.
Dialogue: 0,0:39:19.46,0:39:21.66,Default,,0,0,0,,Бұл ибис. Ибистердің отары.
Dialogue: 0,0:39:21.76,0:39:23.03,Default,,0,0,0,,Керемет
Dialogue: 0,0:39:23.46,0:39:27.16,Default,,0,0,0,,Олардың көпшілігі 20 ғасырда жойылады.
Dialogue: 0,0:39:27.43,0:39:29.70,Default,,0,0,0,,Бұл өте өкінішті.
Dialogue: 0,0:39:31.13,0:39:33.40,Default,,0,0,0,,Өйткені, онда ешкім тұрмайды.
Dialogue: 0,0:39:33.50,0:39:36.06,Default,,0,0,0,,Сонда ол бала қайдан шықты?
Dialogue: 0,0:39:36.60,0:39:40.23,Default,,0,0,0,,(Курайами тайпасының дауысы)
Dialogue: 0,0:39:40.33,0:39:42.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:39:44.16,0:39:47.43,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,0:39:48.03,0:39:50.43,Default,,0,0,0,,Уф, у…
Dialogue: 0,0:39:53.76,0:39:58.76,Default,,0,0,0,,А... Мен қатты ренжідім. Мен шынымен қорқынышты жағдайға тап болған болуым керек.
Dialogue: 0,0:39:59.36,0:40:01.00,Default,,0,0,0,,Ух... Ах...
Dialogue: 0,0:40:01.33,0:40:02.76,Default,,0,0,0,,А, қозғалма.
Dialogue: 0,0:40:03.06,0:40:03.93,Default,,0,0,0,,Кук
Dialogue: 0,0:40:05.96,0:40:06.83,Default,,0,0,0,,Кук
Dialogue: 0,0:40:07.53,0:40:09.83,Default,,0,0,0,,Жарақат әлі жазылмаған.
Dialogue: 0,0:40:11.83,0:40:12.46,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,0:40:12.56,0:40:14.56,Default,,0,0,0,,Маған тыныш ұйықтау керек
Dialogue: 0,0:40:14.80,0:40:18.43,Default,,0,0,0,,Уайымдама, мұнда сені қорлайтын ешкім жоқ.
Dialogue: 0,0:40:19.90,0:40:22.30,Default,,0,0,0,,Сіз аштыңыз ба?
Dialogue: 0,0:40:22.43,0:40:24.13,Default,,0,0,0,,Мен бұл...
Dialogue: 0,0:40:26.76,0:40:29.26,Default,,0,0,0,,Жылы көже дәмді болады.
Dialogue: 0,0:40:29.66,0:40:31.73,Default,,0,0,0,,N? Ах...
Dialogue: 0,0:40:32.36,0:40:34.53,Default,,0,0,0,,Ах, ах…
Dialogue: 0,0:40:37.30,0:40:40.53,Default,,0,0,0,,Оны ішіп, тыныш ұйықтасаңыз, тез арада жақсы болады.
Dialogue: 0,0:40:53.16,0:40:56.00,Default,,0,0,0,,Yaho (Сунео) Жарайды, бұл жақсы.
Dialogue: 0,0:40:57.16,0:40:59.96,Default,,0,0,0,,Болды, Джан, күте тұр. Сунео, күте тұрыңыз.
Dialogue: 0,0:41:00.13,0:41:02.03,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:41:02.20,0:41:04.03,Default,,0,0,0,,О, сен мұны істедің.
Dialogue: 0,0:41:05.33,0:41:10.03,Default,,0,0,0,,(Ойнап жатқан екі адамның дыбысы)
Dialogue: 0,0:41:28.23,0:41:29.10,Default,,0,0,0,,Ахх
Dialogue: 0,0:41:29.20,0:41:30.06,Default,,0,0,0,,Не? Не болды?
Dialogue: 0,0:41:30.16,0:41:31.06,Default,,0,0,0,,Крокодил
Dialogue: 0,0:41:31.16,0:41:32.56,Default,,0,0,0,,Гя
Dialogue: 0,0:41:32.76,0:41:36.06,Default,,0,0,0,,Бүгінгі тақырып:
Dialogue: 0,0:41:40.16,0:41:41.76,Default,,0,0,0,,Маған көмектес
Dialogue: 0,0:41:43.10,0:41:45.63,Default,,0,0,0,,Эй, Сунео, күте тұр. (Сунео) Джан, тезірек.
Dialogue: 0,0:42:05.63,0:42:07.10,Default,,0,0,0,,Бұл Рю.
Dialogue: 0,0:42:07.20,0:42:09.23,Default,,0,0,0,,Екеуің де жақсысыңдар ма?
Dialogue: 0,0:42:09.33,0:42:10.43,Default,,0,0,0,,Нобита
Dialogue: 0,0:42:12.00,0:42:14.33,Default,,0,0,0,,Сіз қалай ойлайсыз? мен жасаған үй жануарым
Dialogue: 0,0:42:15.36,0:42:18.60,Default,,0,0,0,,Ей, үлкен жаңалық, үлкен жаңалық
Dialogue: 0,0:42:21.80,0:42:23.06,Default,,0,0,0,,Бақыланатын нәтижелер...
Dialogue: 0,0:42:23.16,0:42:25.96,Default,,0,0,0,,Қарашы, Дора-чан, мен өзімді әлдеқайда жақсы сезінемін.
Dialogue: 0,0:42:26.06,0:42:28.03,Default,,0,0,0,,Ах... баа
Dialogue: 0,0:42:28.20,0:42:29.53,Default,,0,0,0,,Үйдесің бе?
Dialogue: 0,0:42:29.63,0:42:31.93,Default,,0,0,0,,Ааа
Dialogue: 0,0:42:34.83,0:42:35.46,Default,,0,0,0,,Хехе
Dialogue: 0,0:42:35.60,0:42:37.76,Default,,0,0,0,,Бұл мен жасаған мықты одақтас.
Dialogue: 0,0:42:37.86,0:42:39.86,Default,,0,0,0,,Сіз қалай ойлайсыз? Менің жұмысым үлкен мәселе, солай емес пе?
Dialogue: 0,0:42:40.16,0:42:42.26,Default,,0,0,0,,...
Dialogue: 0,0:42:42.76,0:42:45.66,Default,,0,0,0,,Аа, иә, мен сіздің жеке басыңызды таптым.
Dialogue: 0,0:42:45.76,0:42:46.76,Default,,0,0,0,,Не? (Нобита) Иә?
Dialogue: 0,0:42:46.86,0:42:48.70,Default,,0,0,0,,Ол қайдан пайда болды?
Dialogue: 0,0:42:51.03,0:42:53.86,Default,,0,0,0,,Кеңістік пен уақытта толқындарды бақылау нәтижелері—
Dialogue: 0,0:42:53.96,0:42:59.96,Default,,0,0,0,,Бұл бала солтүстік ендікте 31 градус 7 минутта және шығыс бойлық 118 градус 2 минутта орналасқан.
Dialogue: 0,0:43:00.20,0:43:04.70,Default,,0,0,0,,Ол жер қазіргі Қытай материгіндегі Хэсиан маңында.
Dialogue: 0,0:43:05.13,0:43:07.83,Default,,0,0,0,,Не? Сонымен, сіз Қытайдансыз ба?
Dialogue: 0,0:43:07.93,0:43:10.06,Default,,0,0,0,,Бұл Жапония емес.
Dialogue: 0,0:43:10.16,0:43:10.76,Default,,0,0,0,,Сонымен—
Dialogue: 0,0:43:10.86,0:43:13.23,Default,,0,0,0,,Нағыз конняку мисо дәмі!
Dialogue: 0,0:43:17.03,0:43:19.03,Default,,0,0,0,,Дәмді (барлығы) Ахх
Dialogue: 0,0:43:19.13,0:43:22.10,Default,,0,0,0,,Жүр, сен туралы бірдеңе айт.
Dialogue: 0,0:43:22.50,0:43:25.46,Default,,0,0,0,,Менің не айтып тұрғанымды түсіндің бе? Иә түсінемін
Dialogue: 0,0:43:25.60,0:43:29.53,Default,,0,0,0,,Менің атым Кукуру Хикари, Тәжікараның ұлы.
Dialogue: 0,0:43:29.90,0:43:34.03,Default,,0,0,0,,Біраз балық аулап ауылға оралғанымда кенет көкке сіңіп кетті.
Dialogue: 0,0:43:34.40,0:43:36.53,Default,,0,0,0,,Бұл кеңістік-уақыт турбуленттігі туралы.
Dialogue: 0,0:43:37.03,0:43:39.43,Default,,0,0,0,,Басқа ауылдың адамдары да сорды ма?
Dialogue: 0,0:43:39.83,0:43:42.43,Default,,0,0,0,,Жоқ, мен өзенге бара жатқанда...
Dialogue: 0,0:43:42.53,0:43:45.83,Default,,0,0,0,,Ауылдағылардың барлығына Кураями тайпасы шабуыл жасаған көрінеді.
Dialogue: 0,0:43:46.06,0:43:47.63,Default,,0,0,0,,Кураями тайпасы?
Dialogue: 0,0:43:48.26,0:43:50.66,Default,,0,0,0,,Ол көптен бері нысана болды.
Dialogue: 0,0:43:51.40,0:43:55.30,Default,,0,0,0,,Мен оның қауіпті екенін түсінген сайын бүкіл ауылымды қанша рет көшірдім?
Dialogue: 0,0:43:55.76,0:43:58.43,Default,,0,0,0,,Қанша қашсаң да, иіскеп, қайтып келеді.
Dialogue: 0,0:43:58.96,0:44:01.63,Default,,0,0,0,,Басқа ауылдарға да шабуыл жасалса керек.
Dialogue: 0,0:44:03.76,0:44:06.03,Default,,0,0,0,,Шабуылға ұшырағандармен не болады?
Dialogue: 0,0:44:06.46,0:44:07.66,Default,,0,0,0,,Маған сән журналының түсірілімінде қолданылған осы киімді берді
Dialogue: 0,0:44:07.93,0:44:11.40,Default,,0,0,0,,Оны солтүстікке апарып жатқан сияқты, бірақ содан кейін...
Dialogue: 0,0:44:12.33,0:44:13.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:15.16,0:44:19.06,Default,,0,0,0,,Неге ұрыспайсың? Макура тайпасын жеңу үшін күш біріктірейік...
Dialogue: 0,0:44:19.16,0:44:21.03,Default,,0,0,0,,Джан Кураями тайпасы
Dialogue: 0,0:44:21.13,0:44:24.33,Default,,0,0,0,,Иә, біз ол Кураями тайпасын жеңбейміз.
Dialogue: 0,0:44:24.90,0:44:29.73,Default,,0,0,0,,Олардың қорқынышты одақтасы бар.
Dialogue: 0,0:44:30.10,0:44:34.06,Default,,0,0,0,,Дауыл мен найзағайды басқаратын өлмейтін рух патшасы.
Dialogue: 0,0:44:34.16,0:44:36.00,Default,,0,0,0,,Гига зомби!
Dialogue: 0,0:44:38.46,0:44:43.73,Default,,0,0,0,,Гига!
Dialogue: 0,0:44:46.10,0:44:48.10,Default,,0,0,0,,Гига зомби?
Dialogue: 0,0:44:53.36,0:44:55.23,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:44:55.33,0:44:56.63,Default,,0,0,0,,Бұл құбыжық емес пе?
Dialogue: 0,0:44:56.73,0:44:59.06,Default,,0,0,0,,Жоқ (Нобита) Мүмкін емес...
Dialogue: 0,0:44:59.20,0:45:00.60,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:45:01.23,0:45:03.13,Default,,0,0,0,,Сиқыршы сияқты.
Dialogue: 0,0:45:03.40,0:45:04.93,Default,,0,0,0,,Сиқыршы?
Dialogue: 0,0:45:05.20,0:45:06.60,Default,,0,0,0,,Қорқамын, ол қайтып келмейді.
Dialogue: 0,0:45:06.93,0:45:10.06,Default,,0,0,0,,Ежелгі заманнан бері адамдар бұл дүниедегі барлық нәрселермен айналысқан.
Dialogue: 0,0:45:10.46,0:45:13.00,Default,,0,0,0,,Мен ол жерде рух өмір сүреді деп ойладым.
Dialogue: 0,0:45:13.30,0:45:15.70,Default,,0,0,0,,Ал сен рухты ашуландырсаң —
Dialogue: 0,0:45:15.80,0:45:21.00,Default,,0,0,0,,Мен жер сілкінісі, дала өрті, су тасқыны, жұқпалы аурулар болады деп сендім.
Dialogue: 0,0:45:21.23,0:45:26.23,Default,,0,0,0,,Ондай кездерде сиқырмен рухты тыныштандыратын адам – сиқыршы.
Dialogue: 0,0:45:26.46,0:45:30.20,Default,,0,0,0,,Алғашқы қоғамда бәрі сенен қорқатын.
Dialogue: 0,0:45:30.96,0:45:32.76,Default,,0,0,0,,Хаха, бұл не деген ырым?
Dialogue: 0,0:45:32.86,0:45:36.50,Default,,0,0,0,,Уайымдама, Кукуру, мен мұндай алаяқтықтан қорықпаймын.
Dialogue: 0,0:45:36.90,0:45:38.46,Default,,0,0,0,,Иә, оны ғылым дейміз...
Dialogue: 0,0:45:38.83,0:45:39.93,Default,,0,0,0,,Жалған емес
Dialogue: 0,0:45:40.43,0:45:42.90,Default,,0,0,0,,Гига зомбиіне сәйкес келетін адамдар бар ма?
Dialogue: 0,0:45:43.36,0:45:45.83,Default,,0,0,0,,Сонымен, сіз осылай қалуды жоспарлап отырсыз ба?
Dialogue: 0,0:45:46.26,0:45:49.96,Default,,0,0,0,,Мама мен әке, ауыл тұрғындарына көмектескіңіз келмейді ме?
Dialogue: 0,0:45:50.16,0:45:53.83,Default,,0,0,0,,Әрине... Мен барып көмектесемін.
Dialogue: 0,0:45:54.60,0:45:56.76,Default,,0,0,0,,Олай болса, маған қалдырыңыз.
Dialogue: 0,0:45:56.86,0:46:00.80,Default,,0,0,0,,Иә, біз толқулар мен шытырман оқиғаларды жақсы көретін ұлдармыз.
Dialogue: 0,0:46:00.90,0:46:04.33,Default,,0,0,0,,Әйтеуір, қолға түскен Хикари тайпасын құтқарайық.
Dialogue: 0,0:46:04.43,0:46:06.66,Default,,0,0,0,,Жарайды, бұл шешілді.
Dialogue: 0,0:46:07.20,0:46:08.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:08.70,0:46:11.80,Default,,0,0,0,,Ертең материктік Қытайға жіберіледі
Dialogue: 0,0:46:11.90,0:46:13.56,Default,,0,0,0,,Оу!
Dialogue: 0,0:46:47.46,0:46:48.63,Default,,0,0,0,,Жо-жоқ… мүмкін емес… осы сөмкенің ішінде не бар!
Dialogue: 0,0:46:49.30,0:46:52.30,Default,,0,0,0,,Не, сен ояу ма едің?
Dialogue: 0,0:46:53.26,0:46:55.13,Default,,0,0,0,,Ерте жату керек.
Dialogue: 0,0:46:55.23,0:46:57.16,Default,,0,0,0,,Гига зомбилері келуі мүмкін
Dialogue: 0,0:46:57.66,0:46:58.90,Default,,0,0,0,,Оның келуі мүмкін емес.
Dialogue: 0,0:46:59.00,0:47:01.70,Default,,0,0,0,,Қытайдан өте алыс.
Dialogue: 0,0:47:02.43,0:47:04.30,Default,,0,0,0,,Менің бөлмемде бірге ұйықтайық.
Dialogue: 0,0:47:04.40,0:47:06.66,Default,,0,0,0,,Жоқ, мен осындамын.
Dialogue: 0,0:47:06.76,0:47:08.63,Default,,0,0,0,,Мен қазірдің өзінде...
Dialogue: 0,0:47:10.63,0:47:11.73,Default,,0,0,0,,Мен ұйықтайын деп жатырмын
Dialogue: 0,0:47:23.96,0:47:25.53,Default,,0,0,0,,Гига зомби?
Dialogue: 0,0:47:32.00,0:47:33.26,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,0:47:53.50,0:47:55.50,Default,,0,0,0,,Күте тұрыңыз, бұлай бейқам болмаңыз.
Dialogue: 0,0:47:55.83,0:47:56.90,Default,,0,0,0,,Не болды?
Dialogue: 0,0:47:58.13,0:48:00.93,Default,,0,0,0,,Қытайға жалғыз жаяу бару ақылға сыймас еді.
Dialogue: 0,0:48:01.26,0:48:03.36,Default,,0,0,0,,үшін ынтымақтасуға тырысады.
Dialogue: 0,0:48:03.96,0:48:07.33,Default,,0,0,0,,Кукуру, сен бізге әлі сенбейсің бе?
Dialogue: 0,0:48:07.70,0:48:12.56,Default,,0,0,0,,Жоқ, сендер жақсы адамдарсыңдар, одан да...
Dialogue: 0,0:48:13.33,0:48:16.60,Default,,0,0,0,,Қарсыластар - қатыгез Кураями тайпасы және Рух патшасы.
Dialogue: 0,0:48:16.70,0:48:18.16,Default,,0,0,0,,Бүгін ол қару саудагерін тұтқындауға барды
Dialogue: 0,0:48:19.13,0:48:21.20,Default,,0,0,0,,Тіпті сізге қауіп төніп тұр...
Dialogue: 0,0:48:21.43,0:48:24.33,Default,,0,0,0,,Хехехе, енді мынаны басыңа қой.
Dialogue: 0,0:48:24.43,0:48:25.86,Default,,0,0,0,,Не? Яғни
Dialogue: 0,0:48:26.30,0:48:28.36,Default,,0,0,0,,Тек басыңызға қойыңыз.
Dialogue: 0,0:48:29.26,0:48:30.06,Default,,0,0,0,,Тағы 500 рет!
Dialogue: 0,0:48:30.16,0:48:31.70,Default,,0,0,0,,Сол түймені басыңыз
Dialogue: 0,0:48:34.53,0:48:37.70,Default,,0,0,0,,Уау! Ааа
Dialogue: 0,0:48:38.36,0:48:39.43,Default,,0,0,0,,Бұл
Dialogue: 0,0:48:39.56,0:48:40.73,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:48:41.40,0:48:42.23,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:48:42.40,0:48:43.83,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:48:43.96,0:48:49.03,Default,,0,0,0,,Жел рухына сені ұштыруды бұйырдым.
Dialogue: 0,0:48:49.13,0:48:50.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:50.50,0:48:54.16,Default,,0,0,0,,Иә, иә, бұл адам керемет сиқыршы.
Dialogue: 0,0:48:54.26,0:48:57.56,Default,,0,0,0,,Есімі Дора Зомби.
Dialogue: 0,0:48:57.66,0:48:59.00,Default,,0,0,0,,Сәлем Джан
Dialogue: 0,0:48:59.10,0:49:01.23,Default,,0,0,0,,Аа, дұрыс, Дразомби-сан.
Dialogue: 0,0:49:01.33,0:49:04.10,Default,,0,0,0,,Бұл адам маған өз күшін бергісі келеді.
Dialogue: 0,0:49:06.26,0:49:07.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:07.86,0:49:09.03,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:49:09.16,0:49:11.90,Default,,0,0,0,,Егер сіз мұны шешсеңіз, жалғастырыңыз.
Dialogue: 0,0:49:12.00,0:49:13.20,Default,,0,0,0,,Кету
Dialogue: 0,0:49:13.63,0:49:15.00,Default,,0,0,0,,Таңғы асты ішкеннен кейін
Dialogue: 0,0:49:15.36,0:49:18.93,Default,,0,0,0,,А, ой, енді ойлап қарасам, Нобита-санға не болды екен?
Dialogue: 0,0:49:19.20,0:49:23.26,Default,,0,0,0,,(Нобитаның қорылдауы)
Dialogue: 0,0:49:28.33,0:49:32.73,Default,,0,0,0,,Ее-я-хо, Қытайға кетті!
Dialogue: 0,0:49:35.00,0:49:36.66,Default,,0,0,0,,Уау, олар керемет көрінеді!
Dialogue: 0,0:49:37.50,0:49:39.93,Default,,0,0,0,,Тексеріңіз, Нобита әрқашан салқын болуға тырысады.
Dialogue: 0,0:49:40.03,0:49:41.40,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,0:49:41.50,0:49:44.26,Default,,0,0,0,,Бұл үй жануарларын Нобита жасаған.
Dialogue: 0,0:49:44.53,0:49:47.70,Default,,0,0,0,,Қытайдың Хэсиан қаласына дейін 2000 км.
Dialogue: 0,0:49:47.80,0:49:50.73,Default,,0,0,0,,Осы жылдамдықпен жүрсек, кешке дейін жетеміз.
Dialogue: 0,0:49:51.10,0:49:54.43,Default,,0,0,0,,Эй Дораемон, жақсысың ба?
Dialogue: 0,0:49:54.53,0:49:55.73,Default,,0,0,0,,Не?
Dialogue: 0,0:49:55.83,0:49:59.00,Default,,0,0,0,,Жапония мен Қытайдың арасында мұхит бар, солай ма?
Dialogue: 0,0:49:59.10,0:50:01.60,Default,,0,0,0,,Пега мен басқалары жолда шаршаса ше?
Dialogue: 0,0:50:01.90,0:50:07.30,Default,,0,0,0,,Уайымдамаңыз, мен тек сенімді болу үшін кетер алдында спутниктік суретке түсірдім.
Dialogue: 0,0:50:08.16,0:50:09.76,Default,,0,0,0,,Мынаны қараңыз!
Dialogue: 0,0:50:09.86,0:50:10.60,Default,,0,0,0,,Иётто
Dialogue: 0,0:50:13.76,0:50:18.40,Default,,0,0,0,,Иә? Бұл Жапония ма? Ол материктік Қытаймен байланысты.
Dialogue: 0,0:50:18.90,0:50:20.00,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:50:20.63,0:50:25.36,Default,,0,0,0,,Біз қазір мұз дәуірінде тұрмыз, сондықтан теңіз суы қатып, теңіз суы азайды.
Dialogue: 0,0:50:25.46,0:50:31.03,Default,,0,0,0,,Сондықтан теңіз деңгейі төмендеп, мұхит түбі сыртқа шықты.
Dialogue: 0,0:50:31.36,0:50:34.43,Default,,0,0,0,,Түсіндім, онда қалаған уақытта түсіп, демалуға болады.
Dialogue: 0,0:50:34.70,0:50:36.06,Default,,0,0,0,,Жеңілдеп қалдыңыз ба?
Dialogue: 0,0:50:36.16,0:50:39.73,Default,,0,0,0,,Әрине иә, Пеггер!
Dialogue: 0,0:50:39.86,0:50:40.93,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:50:57.10,0:51:01.00,Default,,0,0,0,,Көзге көрінетіндей, үлкен ағаштар мен қалың шөптер жоқ.
Dialogue: 0,0:51:01.10,0:51:03.20,Default,,0,0,0,,Ол бұрын мұхит түбі болған.
Dialogue: 0,0:51:03.73,0:51:06.90,Default,,0,0,0,,Енді Қытайға дейін жер бар.
Dialogue: 0,0:51:07.00,0:51:08.60,Default,,0,0,0,,Иә, шекаралар жоқ.
Dialogue: 0,0:51:08.70,0:51:11.76,Default,,0,0,0,,Жапония мен Қытай бір құрлық.
Dialogue: 0,0:51:11.96,0:51:15.23,Default,,0,0,0,,Кукуру ауылы да дәл осы жерде.
Dialogue: 0,0:51:16.46,0:51:18.26,Default,,0,0,0,,...
Dialogue: 0,0:51:18.40,0:51:21.20,Default,,0,0,0,,Уау, гамбургер және картоп
Dialogue: 0,0:51:21.76,0:51:24.43,Default,,0,0,0,,Эй Дораемон, мұнда не бар?
Dialogue: 0,0:51:24.53,0:51:25.70,Default,,0,0,0,,Кола (Нобита) Иә.
Dialogue: 0,0:51:26.23,0:51:27.36,Default,,0,0,0,,Олай айтсаң, тіпті Дайкоку аға да қарсылық білдіре алмайды.
Dialogue: 0,0:51:27.96,0:51:30.06,Default,,0,0,0,,Ах, Джианның тістегені.
Dialogue: 0,0:51:30.16,0:51:30.63,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:51:30.90,0:51:33.96,Default,,0,0,0,,Қалағаныңызша жеңіз, мен сізге көп әкелдім.
Dialogue: 0,0:51:34.06,0:51:35.66,Default,,0,0,0,,Менде 10 дана болады.
Dialogue: 0,0:51:36.13,0:51:37.13,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:51:44.56,0:51:46.80,Default,,0,0,0,,Кукуру ше? Дәміне келетін болсақ
Dialogue: 0,0:51:47.06,0:51:50.26,Default,,0,0,0,,Мен мұндай тамақты бұрын жеген емеспін, бірақ бұл өте жақсы.
Dialogue: 0,0:51:50.40,0:51:52.33,Default,,0,0,0,,Бірақ... Бірақ?
Dialogue: 0,0:51:52.43,0:51:54.66,Default,,0,0,0,,Кеше жеген конняку жақсырақ болды...
Dialogue: 0,0:51:54.96,0:51:57.33,Default,,0,0,0,,Нағыз коньяк мисо хош иісі
Dialogue: 0,0:51:57.43,0:51:59.66,Default,,0,0,0,,Cucur жақсы қарапайым дәмге ие.
Dialogue: 0,0:52:00.50,0:52:03.16,Default,,0,0,0,,Жарайды, сен не білдің?
Dialogue: 0,0:52:03.80,0:52:07.13,Default,,0,0,0,,Жапон ата-бабалары мұз дәуірінде осы жерден өткен.
Dialogue: 0,0:52:07.23,0:52:09.13,Default,,0,0,0,,Мен Қытайдан көшіп келдім.
Dialogue: 0,0:52:09.30,0:52:12.70,Default,,0,0,0,,Дұрыс. Корея мен Сібірден басқа...
Dialogue: 0,0:52:12.80,0:52:16.10,Default,,0,0,0,,Адамдар оңтүстік аралдардан да көшіп келген сияқты.
Dialogue: 0,0:52:16.43,0:52:18.56,Default,,0,0,0,,Оған ондаған мың жылдар қажет болды.
Dialogue: 0,0:52:19.20,0:52:21.36,Default,,0,0,0,,Содан кейін, кез келген жағдайда, Кукуру...
Dialogue: 0,0:52:21.46,0:52:25.06,Default,,0,0,0,,Менің атамның атасы—
Dialogue: 0,0:52:25.16,0:52:27.93,Default,,0,0,0,,Атамның атасы—
Dialogue: 0,0:52:28.03,0:52:28.90,Default,,0,0,0,,Атамның... хахахаха
Dialogue: 0,0:52:29.00,0:52:31.46,Default,,0,0,0,,Жарайды, бұл ата.
Dialogue: 0,0:52:31.60,0:52:34.40,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:52:35.63,0:52:39.03,Default,,0,0,0,,Жарайды, бірден Қытайға ұшайық.
Dialogue: 0,0:52:39.13,0:52:40.43,Default,,0,0,0,,Оу!
Dialogue: 0,0:52:42.50,0:52:47.13,Default,,0,0,0,,Егер сіз алыстағы ата-бабаларыңызды іздесеңіз, сіз бүкіл әлемде бір-бірімен туысқан адамдарды табасыз.
Dialogue: 0,0:52:47.43,0:52:51.40,Default,,0,0,0,,Мүмкін Эдисон екеуміз туысқан шығармыз.
Dialogue: 0,0:52:51.50,0:52:54.36,Default,,0,0,0,,Ал, Нобита-сан (Нобита) Хэхехехе...
Dialogue: 0,0:53:11.13,0:53:15.13,Default,,0,0,0,,Күн батып бара жатыр, тез арада межелі жерге жетуіміз керек.
Dialogue: 0,0:53:15.36,0:53:17.26,Default,,0,0,0,,Егер сізге таныс нәрсе көрсеңіз...
Dialogue: 0,0:53:17.36,0:53:20.50,Default,,0,0,0,,А, ана жақта мен балық аулаған өзен.
Dialogue: 0,0:53:24.20,0:53:26.96,Default,,0,0,0,,үшінмыз, түсейік (бәрі) О!
Dialogue: 0,0:53:40.60,0:53:42.43,Default,,0,0,0,,Бұл менің ауылым...
Dialogue: 0,0:53:45.36,0:53:47.16,Default,,0,0,0,,Әке, ана!
Dialogue: 0,0:53:47.73,0:53:49.86,Default,,0,0,0,,үшін қайда кетті!
Dialogue: 0,0:53:53.53,0:53:55.73,Default,,0,0,0,,Бұл менің үйім
Dialogue: 0,0:53:56.73,0:53:58.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:00.73,0:54:04.06,Default,,0,0,0,,үшін солтүстік елге жеткізілді.
Dialogue: 0,0:54:05.06,0:54:07.70,Default,,0,0,0,,Жарайды, бүгін кешке осында тұрамыз.
Dialogue: 0,0:54:07.80,0:54:11.30,Default,,0,0,0,,Таң атқаннан кейін Кураями тайпасымен ойынды бастайық.
Dialogue: 0,0:54:12.06,0:54:12.90,Default,,0,0,0,,Иә
Dialogue: 0,0:54:13.66,0:54:15.53,Default,,0,0,0,,Бүгін жақсы ұйықтайық.
Dialogue: 0,0:54:15.70,0:54:17.50,Default,,0,0,0,,Ертеңнен бастап қиын болады.
Dialogue: 0,0:54:17.73,0:54:19.16,Default,,0,0,0,,үшінңызға рахмет
Dialogue: 0,0:54:19.40,0:54:21.73,Default,,0,0,0,,Өйткені ол Нобитаның атасы.
Dialogue: 0,0:54:21.83,0:54:25.00,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,0:54:39.83,0:54:42.70,Default,,0,0,0,,Келушіге арналған таяқ!
Dialogue: 0,0:54:46.16,0:54:47.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:47.56,0:54:49.50,Default,,0,0,0,,Курс солтүстік-солтүстік-батыс
Dialogue: 0,0:54:49.66,0:54:51.13,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:54:51.23,0:54:52.33,Default,,0,0,0,,Солтүстік-солтүстік-батыс
Dialogue: 0,0:54:52.43,0:54:54.20,Default,,0,0,0,,Бір минут күте тұрыңыз (Нобита) Иә?
Dialogue: 0,0:54:54.43,0:54:57.60,Default,,0,0,0,,Осыдан кейін, менің ойымша, Баспропеллер жақсырақ.
Dialogue: 0,0:54:57.70,0:54:58.43,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:54:58.66,0:55:00.73,Default,,0,0,0,,Pegas тым көзге түседі
Dialogue: 0,0:55:00.83,0:55:04.46,Default,,0,0,0,,Кураями тайпасы ескертсе, мен жасырынсам, мен оларды іздеуге мүмкіндік жоқ.
Dialogue: 0,0:55:04.90,0:55:06.26,Default,,0,0,0,,Бұл да дұрыс.
Dialogue: 0,0:55:06.73,0:55:08.93,Default,,0,0,0,,үшінңыз, мен жақында ораламын, күте тұрыңыз.
Dialogue: 0,0:55:09.46,0:55:12.10,Default,,0,0,0,,Жарайды, Шизука-чан, мен кукуруды сұрадым.
Dialogue: 0,0:55:12.20,0:55:13.06,Default,,0,0,0,,Иә
Dialogue: 0,0:55:14.43,0:55:15.93,Default,,0,0,0,,Көп ұзамай үйреніп кетесің.
Dialogue: 0,0:55:16.20,0:55:18.26,Default,,0,0,0,,Сен жақсы қызсың, тыныш күте тұр.
Dialogue: 0,0:55:18.36,0:55:19.66,Default,,0,0,0,,Енді сыртқа шығайық.
Dialogue: 0,0:55:19.73,0:55:20.70,Default,,0,0,0,,Тей
Dialogue: 0,0:55:22.83,0:55:26.43,Default,,0,0,0,,А, менің артымнан ерме.
Dialogue: 0,0:55:29.43,0:55:33.50,Default,,0,0,0,,(3 жылау)
Dialogue: 0,0:55:34.86,0:55:37.23,Default,,0,0,0,,Қызық, олар қаншалықты алға жылжыды?
Dialogue: 0,0:55:37.56,0:55:39.40,Default,,0,0,0,,4 күн бұрын шабуыл жасалды
Dialogue: 0,0:55:39.60,0:55:42.13,Default,,0,0,0,,Бұл төрт күндік серуен болғандықтан, онша алыс емес.
Dialogue: 0,0:55:44.30,0:55:46.10,Default,,0,0,0,,Мына таудан өткен сияқты.
Dialogue: 0,0:55:48.96,0:55:51.26,Default,,0,0,0,,Тау көлеңкесі Ағаштың көлеңкесінде абай болайық
Dialogue: 0,0:55:51.36,0:55:52.20,Default,,0,0,0,,Жарайды
Dialogue: 0,0:55:59.86,0:56:01.40,Default,,0,0,0,,О? Ах
Dialogue: 0,0:56:01.70,0:56:03.76,Default,,0,0,0,,А, қайда бара жатырсың?
Dialogue: 0,0:56:08.86,0:56:10.26,Default,,0,0,0,,Бұл Кураями тайпасының найзасы.
Dialogue: 0,0:56:10.96,0:56:12.90,Default,,0,0,0,,Олар осында аң аулап, олжасын жеген көрінеді.
Dialogue: 0,0:56:13.00,0:56:14.66,Default,,0,0,0,,Дораэмон жасаңыз!
Dialogue: 0,0:56:15.50,0:56:17.13,Default,,0,0,0,,Қараңдаршы, оттың қалдықтары.
Dialogue: 0,0:56:17.70,0:56:19.23,Default,,0,0,0,,Мен осында тұрдым.
Dialogue: 0,0:56:19.36,0:56:22.13,Default,,0,0,0,,Сонымен, біз дұрыс жолда болдық.
Dialogue: 0,0:56:25.66,0:56:27.50,Default,,0,0,0,,Әлі де солтүстік-солтүстік-батыс бағытында.
Dialogue: 0,0:56:27.60,0:56:29.10,Default,,0,0,0,,Тезірек (Сунео/Нобита) Иә
Dialogue: 0,0:56:36.93,0:56:38.83,Default,,0,0,0,,Таңғажайып орман алқабы
Dialogue: 0,0:56:38.93,0:56:42.03,Default,,0,0,0,,Сағынып қалсаң, қиналып қаласың. Біраз төмен түсейік.
Dialogue: 0,0:56:48.10,0:56:49.46,Default,,0,0,0,,Бөлінбеңіз
Dialogue: 0,0:56:55.00,0:56:57.53,Default,,0,0,0,,Олай болса, ағашты соғып алмау үшін абай бол.
Dialogue: 0,0:56:57.63,0:57:00.56,Default,,0,0,0,,Итте (Нобита) Ахахаха
Dialogue: 0,0:57:01.26,0:57:03.26,Default,,0,0,0,,Жоқ! (Нобита) О, жоқ!
Dialogue: 0,0:57:03.76,0:57:04.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:08.60,0:57:10.46,Default,,0,0,0,,Бұл екінші күндік лагерьдің қалдықтары.
Dialogue: 0,0:57:36.70,0:57:39.26,Default,,0,0,0,,Үшінші күн, яғни кеш.
Dialogue: 0,0:57:41.56,0:57:44.23,Default,,0,0,0,,Ақыры жақындап қалды
Dialogue: 0,0:58:20.90,0:58:23.00,Default,,0,0,0,,А... (Хикари халқы) Ақсақал!
Dialogue: 0,0:58:23.40,0:58:24.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:58:25.86,0:58:27.63,Default,,0,0,0,,Тұр! Тез жүріңіз
Dialogue: 0,0:58:27.83,0:58:29.66,Default,,0,0,0,,Сіз немен айналысып жатырсыз?
Dialogue: 0,0:58:29.93,0:58:32.13,Default,,0,0,0,,Маған сәл демалуға рұқсат етіңіз.
Dialogue: 0,0:58:32.23,0:58:33.73,Default,,0,0,0,,Нуу тұр!
Dialogue: 0,0:58:33.93,0:58:34.83,Default,,0,0,0,,Тоқта! (Курайами тайпасы А) Уау
Dialogue: 0,0:58:35.03,0:58:36.96,Default,,0,0,0,,Гига!
Dialogue: 0,0:58:37.46,0:58:39.23,Default,,0,0,0,,Гигер
Dialogue: 0,0:58:40.53,0:58:42.96,Default,,0,0,0,,Цучидама-сама, маған бірдеңе керек.
Dialogue: 0,0:58:43.36,0:58:48.70,Default,,0,0,0,,Саған қарай жылжығандарды, жүрмейтіндерді өлтіріп, алға ұмтыл.
Dialogue: 0,0:58:48.83,0:58:51.90,Default,,0,0,0,,Токоями сарайына баратын жол әлі ұзақ.
Dialogue: 0,0:58:52.20,0:58:52.90,Default,,0,0,0,,Жаса!
Dialogue: 0,0:58:53.70,0:58:55.76,Default,,0,0,0,,Жарайды, егер сіз мұны істегіңіз келсе, мен үшін жасаңыз.
Dialogue: 0,0:58:56.03,0:58:58.70,Default,,0,0,0,,Гуу
Dialogue: 0,0:59:00.86,0:59:01.96,Default,,0,0,0,,Фалько…
Dialogue: 0,0:59:02.13,0:59:03.13,Default,,0,0,0,,Ах
Dialogue: 0,0:59:03.23,0:59:03.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:04.10,0:59:05.13,Default,,0,0,0,,Қайсысы қоқыс екенін айтып бере аласыз ба?
Dialogue: 0,0:59:05.40,0:59:11.50,Default,,0,0,0,,Мен Ұлы Рух патшасы Дразомбимін.
Dialogue: 0,0:59:11.90,0:59:15.20,Default,,0,0,0,,Қолға түскен адамдарды дереу босатыңыз
Dialogue: 0,0:59:15.53,0:59:19.33,Default,,0,0,0,,Немесе мен найзағайдың рухын қоздырамын -
Dialogue: 0,0:59:19.43,0:59:21.90,Default,,0,0,0,,Барбекю жасайық.
Dialogue: 0,0:59:22.10,0:59:23.56,Default,,0,0,0,,Міне!
Dialogue: 0,0:59:23.93,0:59:25.93,Default,,0,0,0,,(Курайами тайпасының айқайы)
Dialogue: 0,0:59:29.20,0:59:30.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:59:32.30,0:59:33.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:33.23,0:59:33.70,Default,,0,0,0,,Ei
Dialogue: 0,0:59:34.03,0:59:35.30,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:59:36.33,0:59:39.46,Default,,0,0,0,,(Көшбасшының айқайы)
Dialogue: 0,0:59:43.40,0:59:44.23,Default,,0,0,0,,(Көшбасшының айқайы)
Dialogue: 0,0:59:44.40,0:59:45.43,Default,,0,0,0,,Құлақ
Dialogue: 0,0:59:45.53,0:59:47.26,Default,,0,0,0,,Кураями тайпасы дүрбелеңде. Алақай!
Dialogue: 0,0:59:47.36,0:59:49.43,Default,,0,0,0,,Хехе, бұл үлкен мәселе емес.
Dialogue: 0,0:59:50.83,0:59:53.20,Default,,0,0,0,,Сонда да бұл жарқыраған киім ғой, солай емес пе?
Dialogue: 0,0:59:53.30,0:59:56.33,Default,,0,0,0,,Мен солай деп ойлаймын, бірақ маған бұл өзінше ұнайды.
Dialogue: 0,0:59:56.43,0:59:57.63,Default,,0,0,0,,Гига!
Dialogue: 0,0:59:58.46,0:59:59.63,Default,,0,0,0,,Бұл іс жарыққа шыққанына төрт айдан асты.
Dialogue: 0,1:00:00.10,1:00:01.60,Default,,0,0,0,,Ішінде біреу бар ма деп ойлаймын.
Dialogue: 0,1:00:01.83,1:00:03.00,Default,,0,0,0,,Осындай кішкентай жерде?
Dialogue: 0,1:00:03.16,1:00:04.63,Default,,0,0,0,,Сәлем, сен кімсің...
Dialogue: 0,1:00:04.73,1:00:06.43,Default,,0,0,0,,Гига! (Нобита) Уау
Dialogue: 0,1:00:06.56,1:00:08.56,Default,,0,0,0,,Өйткені, біреу бар...
Dialogue: 0,1:00:12.23,1:00:14.56,Default,,0,0,0,,Ей, жалқау маймылдар
Dialogue: 0,1:00:14.80,1:00:16.50,Default,,0,0,0,,Балшықтан жасалған бұйымдар сөйледі.
Dialogue: 0,1:00:16.76,1:00:18.63,Default,,0,0,0,,Саз емес
Dialogue: 0,1:00:18.73,1:00:22.43,Default,,0,0,0,,Мен Цучидама, Гига Зомби-саманың қызметшісімін.
Dialogue: 0,1:00:22.80,1:00:25.13,Default,,0,0,0,,Тіпті Гига зомбиінің қызметшісі
Dialogue: 0,1:00:27.40,1:00:28.53,Default,,0,0,0,,Уау!
Dialogue: 0,1:00:29.00,1:00:30.23,Default,,0,0,0,,Бұл соққы толқыны.
Dialogue: 0,1:00:30.36,1:00:32.53,Default,,0,0,0,,Арық балшық қуыршақ!
Dialogue: 0,1:00:32.80,1:00:35.83,Default,,0,0,0,,Менің құдіретімді әлі түсінбедің бе?
Dialogue: 0,1:00:37.10,1:00:38.90,Default,,0,0,0,,Уау! (үшін) Уау!
Dialogue: 0,1:00:39.56,1:00:41.40,Default,,0,0,0,,Тастың артына тығылу
Dialogue: 0,1:00:42.66,1:00:43.86,Default,,0,0,0,,Ойласам, біз ұзақ уақыт сөйлеспеген сияқтымыз
Dialogue: 0,1:00:44.53,1:00:45.76,Default,,0,0,0,,Ойласам, біз ұзақ уақыт сөйлеспеген сияқтымыз
Dialogue: 0,1:00:46.56,1:00:48.46,Default,,0,0,0,,Дорэмон, бірдеңе істе.
Dialogue: 0,1:00:48.63,1:00:50.46,Default,,0,0,0,,Әй, анау, анау...
Dialogue: 0,1:00:50.56,1:00:51.56,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,1:00:51.66,1:00:52.73,Default,,0,0,0,,Уау (Нобита/Шидзука) Уау
Dialogue: 0,1:00:52.83,1:00:54.53,Default,,0,0,0,,Міне болды (Нобита) Иә?
Dialogue: 0,1:00:54.86,1:00:56.93,Default,,0,0,0,,Кел, сазды құбыжық
Dialogue: 0,1:00:57.16,1:00:59.90,Default,,0,0,0,,Жақсы батылдық, енот құбыжық.
Dialogue: 0,1:01:00.70,1:01:03.93,Default,,0,0,0,,Мынау желпілдеп тұрған жадағай иті емес!
Dialogue: 0,1:01:04.73,1:01:05.76,Default,,0,0,0,,Ei
Dialogue: 0,1:01:08.93,1:01:10.30,Default,,0,0,0,,Иә! (үшін) Уау!
Dialogue: 0,1:01:11.63,1:01:13.00,Default,,0,0,0,,Бұл қорқынышты болды.
Dialogue: 0,1:01:13.13,1:01:16.70,Default,,0,0,0,,Солай болса да, неге мұндай кесек топырақ бар...
Dialogue: 0,1:01:17.40,1:01:20.03,Default,,0,0,0,,Ол қозғалды ма, әлде сөйледі ме?
Dialogue: 0,1:01:20.26,1:01:21.16,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:22.23,1:01:22.96,Default,,0,0,0,,Ах!
Dialogue: 0,1:01:28.06,1:01:28.93,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:29.50,1:01:32.76,Default,,0,0,0,,А... Әке, ана.
Dialogue: 0,1:01:33.43,1:01:35.23,Default,,0,0,0,,Cucur
Dialogue: 0,1:01:35.56,1:01:37.63,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,1:01:38.50,1:01:40.63,Default,,0,0,0,,Мен осы уақытқа дейін уайымдадым.
Dialogue: 0,1:01:40.76,1:01:43.06,Default,,0,0,0,,Отбасы қайта қосылды.
Dialogue: 0,1:01:43.26,1:01:45.13,Default,,0,0,0,,Бұл қозғалатын көрініс.
Dialogue: 0,1:01:45.23,1:01:47.06,Default,,0,0,0,,Бұл жақсы. Бұл жақсы.
Dialogue: 0,1:01:47.16,1:01:49.56,Default,,0,0,0,,Мен мұндай жағдайларда әлсізмін.
Dialogue: 0,1:01:49.73,1:01:50.33,Default,,0,0,0,,Хехе
Dialogue: 0,1:01:50.43,1:01:52.56,Default,,0,0,0,,Қараңызшы, бұл ана жақта.
Dialogue: 0,1:01:57.16,1:01:58.76,Default,,0,0,0,,Дразомби-сама
Dialogue: 0,1:01:58.86,1:02:02.90,Default,,0,0,0,,Иә, иә... өтінемін, менімен жақсы болыңыз, мен...
Dialogue: 0,1:02:03.26,1:02:05.46,Default,,0,0,0,,Жарайды, осылай қалып, сиқыршы бол.
Dialogue: 0,1:02:05.83,1:02:10.20,Default,,0,0,0,,Әй, мына адамдарды неге Жапонияға апармаймыз?
Dialogue: 0,1:02:10.60,1:02:13.16,Default,,0,0,0,,Жоқ, бұл қауіпсіз.
Dialogue: 0,1:02:13.63,1:02:17.93,Default,,0,0,0,,Дұрыс, бәрі, егер қаласаңдар, біздің елге келер ме едіңдер?
Dialogue: 0,1:02:18.80,1:02:22.13,Default,,0,0,0,,Гига зомби де қол жетпейтін жұмақ.
Dialogue: 0,1:02:23.63,1:02:26.63,Default,,0,0,0,,Ал... Кез келген жерде есік!
Dialogue: 0,1:02:28.50,1:02:30.76,Default,,0,0,0,,Барлық жерде есік бар ма?
Dialogue: 0,1:02:31.40,1:02:35.80,Default,,0,0,0,,Дораэмон, Жапонияға бармас бұрын, Пега мен басқаларды қайтаруымыз керек.
Dialogue: 0,1:02:36.00,1:02:38.63,Default,,0,0,0,,А, мен түсіндім. Алдымен Хошенге барыңыз.
Dialogue: 0,1:02:39.23,1:02:40.23,Default,,0,0,0,,Йойшо (Хикари халқы) О!
Dialogue: 0,1:02:40.40,1:02:43.86,Default,,0,0,0,,Енді, әзірше ауылыңа барайық.
Dialogue: 0,1:02:45.23,1:02:47.76,Default,,0,0,0,,Таң қалмаңыз, асығыңыз (Сунео) Жүр, тезірек.
Dialogue: 0,1:02:48.76,1:02:51.90,Default,,0,0,0,,(Қуаныш дыбыстары)
Dialogue: 0,1:02:54.93,1:02:56.96,Default,,0,0,0,,Дораемон Иә иә
Dialogue: 0,1:03:00.53,1:03:01.30,Default,,0,0,0,,Жарайды
Dialogue: 0,1:03:14.80,1:03:18.00,Default,,0,0,0,,Джигер, сен енот құбыжық
Dialogue: 0,1:03:18.13,1:03:22.06,Default,,0,0,0,,Жақсы ма, жақсы ма, бұл өшпенділіктен арылу керек пе?
Dialogue: 0,1:03:39.70,1:03:42.96,Default,,0,0,0,,Бұл елде енді өкініш жоқ.
Dialogue: 0,1:03:44.00,1:03:45.66,Default,,0,0,0,,Дразомби-саманың күші
Dialogue: 0,1:03:45.76,1:03:47.16,Default,,0,0,0,,Бұл күш
Dialogue: 0,1:03:47.26,1:03:48.46,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,1:03:49.13,1:03:51.33,Default,,0,0,0,,Пеггер Гри
Dialogue: 0,1:03:51.43,1:03:53.73,Default,,0,0,0,,Драко, шығыңызшы.
Dialogue: 0,1:03:53.83,1:03:55.76,Default,,0,0,0,,Мен Жапонияға қайтамын.
Dialogue: 0,1:03:55.86,1:03:58.03,Default,,0,0,0,,Тез шық!
Dialogue: 0,1:03:58.13,1:04:00.73,Default,,0,0,0,,Шықпағанша қалдырамын.
Dialogue: 0,1:04:02.46,1:04:04.50,Default,,0,0,0,,Пегагри
Dialogue: 0,1:04:04.73,1:04:06.26,Default,,0,0,0,,Дора-чан
Dialogue: 0,1:04:06.40,1:04:07.50,Default,,0,0,0,,Иә, иә
Dialogue: 0,1:04:07.60,1:04:11.03,Default,,0,0,0,,Жоқ, мен Драко туралы айтып отырмын.
Dialogue: 0,1:04:11.13,1:04:13.60,Default,,0,0,0,,Оған түсініксіз ат қоймаңыз
Dialogue: 0,1:04:13.70,1:04:14.90,Default,,0,0,0,,Пеггер
Dialogue: 0,1:04:15.13,1:04:18.06,Default,,0,0,0,,Гри (Сунео) Драко
Dialogue: 0,1:04:19.03,1:04:23.00,Default,,0,0,0,,Пеггер, бәрі қайда кетті?
Dialogue: 0,1:04:23.83,1:04:25.00,Default,,0,0,0,,Ах Пега
Dialogue: 0,1:04:25.66,1:04:26.73,Default,,0,0,0,,Пега?
Dialogue: 0,1:04:31.16,1:04:32.83,Default,,0,0,0,,Бұл не, құс?
Dialogue: 0,1:04:45.60,1:04:48.20,Default,,0,0,0,,Осыншама ізденсем де, таба алмаймын.
Dialogue: 0,1:04:48.33,1:04:50.03,Default,,0,0,0,,Бір жерге кеткен жоқ па?
Dialogue: 0,1:04:50.16,1:04:53.50,Default,,0,0,0,,Мүмкін ол біздің артымыздан ерген шығар?
Dialogue: 0,1:04:53.66,1:04:56.20,Default,,0,0,0,,Міне! Өйткені артымда бірдеңе қалдырдым...
Dialogue: 0,1:04:56.30,1:05:00.43,Default,,0,0,0,,Мен адасып қалдым, тамақ жоқ...
Dialogue: 0,1:05:00.53,1:05:04.53,Default,,0,0,0,,Уайымдама, анау үшеуі мықты.
Dialogue: 0,1:05:04.73,1:05:08.73,Default,,0,0,0,,Дұрыс. Бір қызығы, олар емін-еркін рахаттанып жүр емес пе?
Dialogue: 0,1:05:08.83,1:05:11.00,Default,,0,0,0,,Енді Жапонияға оралайық.
Dialogue: 0,1:05:11.13,1:05:13.46,Default,,0,0,0,,Жоқ, мен оны таппайынша қайтпаймын.
Dialogue: 0,1:05:13.86,1:05:18.63,Default,,0,0,0,,Сенің сезіміңді түсінемін, бірақ бізде Хикари халқы бар...
Dialogue: 0,1:05:18.73,1:05:22.56,Default,,0,0,0,,Мен сізді мүмкіндігінше тезірек Жапонияға аман-есен жеткізуге міндеттімін.
Dialogue: 0,1:05:22.83,1:05:26.03,Default,,0,0,0,,Мен мұнда мәңгі қала алмаймын.
Dialogue: 0,1:05:40.20,1:05:42.36,Default,,0,0,0,,О
Dialogue: 0,1:05:44.80,1:05:47.60,Default,,0,0,0,,Бұл біздің жұмақ
Dialogue: 0,1:05:47.70,1:05:51.33,Default,,0,0,0,,Қандай әдемі және бейбіт көрініс
Dialogue: 0,1:05:51.50,1:05:54.33,Default,,0,0,0,,Біз шынымен де осында тұра аламыз ба?
Dialogue: 0,1:05:54.80,1:05:58.40,Default,,0,0,0,,Өтінемін, бұл әлі ешкім тұрмайтын жер.
Dialogue: 0,1:05:58.93,1:06:00.93,Default,,0,0,0,,Бұл жер тамаша
Dialogue: 0,1:06:01.03,1:06:04.80,Default,,0,0,0,,Жаңа ауылымызды дереу осында салайық.
Dialogue: 0,1:06:04.90,1:06:05.90,Default,,0,0,0,,Иә
Dialogue: 0,1:06:28.20,1:06:29.66,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:06:32.90,1:06:35.03,Default,,0,0,0,,Сунео, қатты ұстаңыз.
Dialogue: 0,1:06:35.13,1:06:36.73,Default,,0,0,0,,Ауыр, Джан, эй, эй
Dialogue: 0,1:06:37.16,1:06:39.36,Default,,0,0,0,,Нобита, сен немен айналысып тұрсың?
Dialogue: 0,1:06:39.50,1:06:41.00,Default,,0,0,0,,Бұл ауыр
Dialogue: 0,1:06:41.86,1:06:42.80,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:54.80,1:06:55.43,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:05.00,1:07:05.90,Default,,0,0,0,,Pega…
Dialogue: 0,1:07:16.13,1:07:17.76,Default,,0,0,0,,Сіз не істеп жатырсыз? (Нобита) Иә?
Dialogue: 0,1:07:18.80,1:07:19.80,Default,,0,0,0,,Бөлек
Dialogue: 0,1:07:23.93,1:07:26.16,Default,,0,0,0,,Менің ойымша, ол ақырында қайтып келеді.
Dialogue: 0,1:07:26.43,1:07:27.33,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:28.63,1:07:32.56,Default,,0,0,0,,Баяғыда қасқырдың күшігім бар еді.
Dialogue: 0,1:07:33.26,1:07:34.96,Default,,0,0,0,,Оның аты Заң.
Dialogue: 0,1:07:36.63,1:07:40.40,Default,,0,0,0,,Оған қамқор бол, сүйкімді жігіт еді.
Dialogue: 0,1:07:40.63,1:07:43.83,Default,,0,0,0,,(Заңның айқайы)
Dialogue: 0,1:07:44.96,1:07:48.63,Default,,0,0,0,,Бірде мен оңтүстікке ауылды аралап бара жаттым.
Dialogue: 0,1:07:49.53,1:07:52.30,Default,,0,0,0,,Аңдаған олжа енді жақын жерде емес.
Dialogue: 0,1:07:53.13,1:07:55.36,Default,,0,0,0,,Әрине, мен өзіммен бірге Заңды алып кеттім.
Dialogue: 0,1:07:55.70,1:08:00.96,Default,,0,0,0,,Күн шығады, батады, қайта шығады, батады...
Dialogue: 0,1:08:02.03,1:08:03.83,Default,,0,0,0,,Бұл ұзақ жол болды.
Dialogue: 0,1:08:07.46,1:08:10.50,Default,,0,0,0,,Бұғы табын тауып, оны бар күшіңізбен аулаңыз...
Dialogue: 0,1:08:10.60,1:08:11.83,Default,,0,0,0,,Жартастан қуылды
Dialogue: 0,1:08:12.36,1:08:14.66,Default,,0,0,0,,Бұл қазірдің өзінде үлкен шу болды.
Dialogue: 0,1:08:16.39,1:08:17.80,Default,,0,0,0,,А, Ро?
Dialogue: 0,1:08:18.56,1:08:20.00,Default,,0,0,0,,Заң жойылды
Dialogue: 0,1:08:20.89,1:08:21.93,Default,,0,0,0,,Заң
Dialogue: 0,1:08:26.06,1:08:28.83,Default,,0,0,0,,Төмен!
Dialogue: 0,1:08:37.93,1:08:40.60,Default,,0,0,0,,Сізді киік тепті ме? Сіз жартастан құладыңыз ба?
Dialogue: 0,1:08:41.20,1:08:42.03,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:42.50,1:08:45.80,Default,,0,0,0,,Ауылға оралғанымызға бір ай болды.
Dialogue: 0,1:08:49.16,1:08:50.50,Default,,0,0,0,,Мен қайтып келдім.
Dialogue: 0,1:08:51.63,1:08:52.36,Default,,0,0,0,,Заң
Dialogue: 0,1:08:53.93,1:08:56.50,Default,,0,0,0,,Мен жараланып, лай басып қалдым, бірақ...
Dialogue: 0,1:08:56.70,1:08:58.60,Default,,0,0,0,,Құйрығын жынды сияқты бұлғады
Dialogue: 0,1:08:58.73,1:09:01.23,Default,,0,0,0,,Ол менің құшағыма секірді.
Dialogue: 0,1:09:02.33,1:09:03.56,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,1:09:03.73,1:09:07.39,Default,,0,0,0,,Жануарларда өз ұяларына оралу инстинкті бар.
Dialogue: 0,1:09:08.10,1:09:09.36,Default,,0,0,0,,Уау...
Dialogue: 0,1:09:09.70,1:09:12.80,Default,,0,0,0,,Мен Нобитаның өзін жақсы сезінгеніне қуаныштымын.
Dialogue: 0,1:09:25.56,1:09:28.83,Default,,0,0,0,,Аспан мен жерді толтыратын рухтар
Dialogue: 0,1:09:29.10,1:09:33.26,Default,,0,0,0,,Жаңа ауылымызға амандық
Dialogue: 0,1:09:33.50,1:09:36.20,Default,,0,0,0,,Жаңа ауылға амандық
Dialogue: 0,1:09:36.53,1:09:39.70,Default,,0,0,0,,Жаңа Құдай жарылқасын
Dialogue: 0,1:09:39.89,1:09:43.03,Default,,0,0,0,,Жаңа Құдай жарылқасын
Dialogue: 0,1:09:50.89,1:09:52.06,Default,,0,0,0,,Енді тамақтанайық.
Dialogue: 0,1:09:52.16,1:09:58.23,Default,,0,0,0,,Жақсы, жақсы, жақсы, жақсы...
Dialogue: 0,1:10:01.86,1:10:03.43,Default,,0,0,0,,Уау, керемет
Dialogue: 0,1:10:03.66,1:10:05.36,Default,,0,0,0,,Уау, керемет
Dialogue: 0,1:10:05.96,1:10:07.86,Default,,0,0,0,,Сиырларды қуыруға болмайды
Dialogue: 0,1:10:11.36,1:10:13.10,Default,,0,0,0,,Буға пісірілген жабайы сиыр еті
Dialogue: 0,1:10:13.20,1:10:15.33,Default,,0,0,0,,Бұл жердің алғашқы аулауы.
Dialogue: 0,1:10:15.46,1:10:16.86,Default,,0,0,0,,...
Dialogue: 0,1:10:17.13,1:10:18.10,Default,,0,0,0,,Ах
Dialogue: 0,1:10:18.20,1:10:19.70,Default,,0,0,0,,Уме
Dialogue: 0,1:10:19.96,1:10:21.63,Default,,0,0,0,,Итадакимасу
Dialogue: 0,1:10:22.00,1:10:23.30,Default,,0,0,0,,Шизука-чан да тамақтанса ше?
Dialogue: 0,1:10:24.03,1:10:25.73,Default,,0,0,0,,А, мен жай ғана...
Dialogue: 0,1:10:25.86,1:10:27.16,Default,,0,0,0,,Жаңғақтар да бар.
Dialogue: 0,1:10:27.36,1:10:30.06,Default,,0,0,0,,Аа, дәмді көрінді.
Dialogue: 0,1:10:30.86,1:10:34.30,Default,,0,0,0,,Бұл аймақ азық-түлікке бай.
Dialogue: 0,1:10:34.40,1:10:36.73,Default,,0,0,0,,Сізге ұнағанына қуаныштымын.
Dialogue: 0,1:10:37.80,1:10:40.86,Default,,0,0,0,,Эй Утабе, сенің кезегің келді.
Dialogue: 0,1:10:42.96,1:10:44.80,Default,,0,0,0,,Жарайды, ән айтайық.
Dialogue: 0,1:10:45.13,1:10:47.30,Default,,0,0,0,,Міне
Dialogue: 0,1:10:48.30,1:10:52.16,Default,,0,0,0,,Дразомби-саманың жетекшілігімен
Dialogue: 0,1:10:52.16,1:10:53.53,Default,,0,0,0,,Дразомби-саманың жетекшілігімен
Dialogue: 0,1:10:52.16,1:10:53.53,Default,,0,0,0,,Узуме Алдыңғы
Dialogue: 0,1:10:53.53,1:10:53.76,Default,,0,0,0,,Узуме Алдыңғы
Dialogue: 0,1:10:53.96,1:10:54.13,Default,,0,0,0,,Иә
Dialogue: 0,1:10:54.13,1:10:54.76,Default,,0,0,0,,Иә
Dialogue: 0,1:10:54.13,1:10:54.76,Default,,0,0,0,,Егер сіз шығыс жағалауға келсеңіз—
Dialogue: 0,1:10:54.76,1:10:59.20,Default,,0,0,0,,Егер сіз шығыс жағалауға келсеңіз—
Dialogue: 0,1:10:59.73,1:11:05.16,Default,,0,0,0,,Бұл от елі. Құттықтаймыз!
Dialogue: 0,1:11:05.70,1:11:10.66,Default,,0,0,0,,Орманда жыртқыш таулар бар.
Dialogue: 0,1:11:11.33,1:11:16.43,Default,,0,0,0,,Өзенде таулар балық бар
Dialogue: 0,1:11:17.13,1:11:21.43,Default,,0,0,0,,Құттықтаймыз! Құттықтаймыз!
Dialogue: 0,1:11:22.13,1:11:23.83,Default,,0,0,0,,О, керемет
Dialogue: 0,1:11:23.93,1:11:26.33,Default,,0,0,0,,Дорэмон, мен саған бір нәрсе беруім керек.
Dialogue: 0,1:11:26.43,1:11:27.43,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:11:28.20,1:11:30.66,Default,,0,0,0,,Ал, мен саған бір ән беремін.
Dialogue: 0,1:11:30.76,1:11:31.80,Default,,0,0,0,,Ах (Сунео) Уау!
Dialogue: 0,1:11:31.90,1:11:32.70,Default,,0,0,0,,Аа, бәрі осы...
Dialogue: 0,1:11:32.70,1:11:33.06,Default,,0,0,0,,Аа, бәрі осы...
Dialogue: 0,1:11:32.70,1:11:33.06,Default,,0,0,0,,Мен Джианмын, генерал генералмын.
Dialogue: 0,1:11:33.06,1:11:34.60,Default,,0,0,0,,Мен генерал Джан Гакимін
Dialogue: 0,1:11:34.60,1:11:36.36,Default,,0,0,0,,Мен Джан Гаки генералмын
Dialogue: 0,1:11:34.60,1:11:36.36,Default,,0,0,0,,Дораемон, бірдеңе істе, эй
Dialogue: 0,1:11:36.36,1:11:36.46,Default,,0,0,0,,Мен Джианмын, генерал генералмын.
Dialogue: 0,1:11:36.46,1:11:36.80,Default,,0,0,0,,Мен Джианмын, ерке генерал.
Dialogue: 0,1:11:36.46,1:11:36.80,Default,,0,0,0,,Джан, тоқтат.
Dialogue: 0,1:11:36.80,1:11:36.90,Default,,0,0,0,,Джан, тоқтат.
Dialogue: 0,1:11:36.90,1:11:37.86,Default,,0,0,0,,Джан, тоқтат.
Dialogue: 0,1:11:36.90,1:11:37.86,Default,,0,0,0,,(Джианның ән салған дауысы)
Dialogue: 0,1:11:37.86,1:11:37.96,Default,,0,0,0,,(Джианның ән салған дауысы)
Dialogue: 0,1:11:37.96,1:11:40.23,Default,,0,0,0,,(Джианның ән салған дауысы)
Dialogue: 0,1:11:37.96,1:11:40.23,Default,,0,0,0,,О... рухтың азғыруы ма?
Dialogue: 0,1:11:40.23,1:11:40.33,Default,,0,0,0,,(Джианның ән салған дауысы)
Dialogue: 0,1:11:40.33,1:11:41.43,Default,,0,0,0,,(Джианның ән салған дауысы)
Dialogue: 0,1:11:40.33,1:11:41.43,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,1:11:42.46,1:11:45.03,Default,,0,0,0,,Автоматты отшашу
Dialogue: 0,1:11:52.10,1:11:54.53,Default,,0,0,0,,(Ауыл тұрғындары қолдайды)
Dialogue: 0,1:11:54.83,1:11:57.70,Default,,0,0,0,,О, бұл әдемі
Dialogue: 0,1:12:00.36,1:12:01.96,Default,,0,0,0,,Мен мұндай техниканы бұрын-соңды көрген емеспін.
Dialogue: 0,1:12:02.06,1:12:03.63,Default,,0,0,0,,Дразомби-самадан күткендей
Dialogue: 0,1:12:06.80,1:12:08.50,Default,,0,0,0,,Иә, мен шаршадым.
Dialogue: 0,1:12:27.96,1:12:29.90,Default,,0,0,0,,Мен теледидар қарамаймын.
Dialogue: 0,1:12:30.33,1:12:33.23,Default,,0,0,0,,Ойланып қарасам, манганы да оқымаймын.
Dialogue: 0,1:12:33.66,1:12:36.16,Default,,0,0,0,,Мен үй тапсырмасын орындауым керек
Dialogue: 0,1:12:36.26,1:12:38.73,Default,,0,0,0,,Анашым, сіз ашулысыз ба?
Dialogue: 0,1:12:39.36,1:12:41.16,Default,,0,0,0,,Үйге барып көрейін бе?
Dialogue: 0,1:12:41.33,1:12:42.73,Default,,0,0,0,,Мұны істейік.
Dialogue: 0,1:12:43.03,1:12:45.56,Default,,0,0,0,,Қалаған уақытта келуге болады.
Dialogue: 0,1:12:45.73,1:12:47.63,Default,,0,0,0,,Иә (Джан Сунео) Дұрыс.
Dialogue: 0,1:12:59.00,1:13:02.20,Default,,0,0,0,,Мен жоқта Пега мен басқалары қайтып келсе...
Dialogue: 0,1:13:02.30,1:13:03.43,Default,,0,0,0,,Маған мынаны жеуге рұқсат етіңіз.
Dialogue: 0,1:13:03.53,1:13:05.20,Default,,0,0,0,,Жарайды, мен қабылдадым.
Dialogue: 0,1:13:05.80,1:13:08.23,Default,,0,0,0,,Дразомби-сама үйге қайтқанда...
Dialogue: 0,1:13:08.33,1:13:10.53,Default,,0,0,0,,Мазасыздық сезімі
Dialogue: 0,1:13:10.63,1:13:13.13,Default,,0,0,0,,Егер Гига Зомби келсе...
Dialogue: 0,1:13:13.23,1:13:15.80,Default,,0,0,0,,Жарайды, мен кепілдік беремін.
Dialogue: 0,1:13:15.93,1:13:17.73,Default,,0,0,0,,Жарайды, мен жақында қайтамын.
Dialogue: 0,1:13:17.83,1:13:19.50,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,1:13:21.66,1:13:22.96,Default,,0,0,0,,Шеберлікпен
Dialogue: 0,1:13:23.06,1:13:24.56,Default,,0,0,0,,Қош бол
Dialogue: 0,1:13:35.60,1:13:37.26,Default,,0,0,0,,О, Құдайым!
Dialogue: 0,1:13:37.36,1:13:39.30,Default,,0,0,0,,Токоями сарайын қалай салу керек?
Dialogue: 0,1:13:39.76,1:13:42.23,Default,,0,0,0,,Бізде әлі жұмыс күші жетпейді.
Dialogue: 0,1:13:42.83,1:13:48.16,Default,,0,0,0,,Сонда да сіз тұтқындаған құлдар қайтарылды ма?
Dialogue: 0,1:13:48.76,1:13:50.93,Default,,0,0,0,,Мен қорқамын, зомби Гига мырза
Dialogue: 0,1:13:51.03,1:13:55.33,Default,,0,0,0,,Олар күтпеген және күшті одақтас тапты.
Dialogue: 0,1:13:55.63,1:13:58.93,Default,,0,0,0,,Ол Ұлы Рух патшасы Дора зомби деп аталады.
Dialogue: 0,1:13:59.66,1:14:02.63,Default,,0,0,0,,Ұлы Рух патшасы Дора зомби туралы не деуге болады?
Dialogue: 0,1:14:03.36,1:14:05.70,Default,,0,0,0,,Оның жұмбақ күштері бар.
Dialogue: 0,1:14:05.80,1:14:08.20,Default,,0,0,0,,Бір қарағанда, ол ракон итіне ұқсайды.
Dialogue: 0,1:14:08.30,1:14:09.90,Default,,0,0,0,,Тыныш, үндеме!
Dialogue: 0,1:14:10.00,1:14:12.53,Default,,0,0,0,,Бұл дүниеде мені жеңетін нәрсе бар ма?
Dialogue: 0,1:14:12.63,1:14:15.00,Default,,0,0,0,,Мен оны жердің шетіне дейін аңдыймын.
Dialogue: 0,1:14:15.10,1:14:17.56,Default,,0,0,0,,Мен сені жұлып аламын.
Dialogue: 0,1:14:17.66,1:14:21.73,Default,,0,0,0,,(Гига Зомбидің күлкісі)
Dialogue: 0,1:14:26.06,1:14:29.10,Default,,0,0,0,,Ноби! Түсіну үшін қанша рет айтуым керек?
Dialogue: 0,1:14:29.20,1:14:30.96,Default,,0,0,0,,Мен ұйықтай беремін
Dialogue: 0,1:14:31.06,1:14:35.40,Default,,0,0,0,,Сосын Гота мен Хонекава үшеуі де дәлізде тұр.
Dialogue: 0,1:14:35.50,1:14:36.83,Default,,0,0,0,,Иә
Dialogue: 0,1:14:36.93,1:14:38.96,Default,,0,0,0,,Иә
Dialogue: 0,1:14:47.03,1:14:49.63,Default,,0,0,0,,Әр адамда 70 000 жыл реактивті лаг бар.
Dialogue: 0,1:14:49.86,1:14:51.83,Default,,0,0,0,,Бұл қалыпты жағдайға мүлдем оралмайды.
Dialogue: 0,1:14:51.93,1:14:55.63,Default,,0,0,0,,Бұл дүниеге оралу шынымен қиын.
Dialogue: 0,1:14:57.26,1:14:59.26,Default,,0,0,0,,Бірақ жақсы ма?
Dialogue: 0,1:14:59.36,1:15:00.36,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:00.46,1:15:01.90,Default,,0,0,0,,Бұл Гига зомби.
Dialogue: 0,1:15:02.40,1:15:06.53,Default,,0,0,0,,Жарайды. Бұл қарапайым сиқыршы. Бұл үлкен мәселе емес.
Dialogue: 0,1:15:07.23,1:15:10.16,Default,,0,0,0,,Сізде Баспропеллер немесе басқа есік жоқ сияқты емес пе?
Dialogue: 0,1:15:10.26,1:15:11.30,Default,,0,0,0,,Ура!
Dialogue: 0,1:15:11.66,1:15:13.36,Default,,0,0,0,,Ертең неге бармайсың?
Dialogue: 0,1:15:13.46,1:15:14.93,Default,,0,0,0,,Иә (Сунео) Сонда кездескенше.
Dialogue: 0,1:15:15.03,1:15:16.40,Default,,0,0,0,,Қош бол, сау бол
Dialogue: 0,1:15:17.60,1:15:18.86,Default,,0,0,0,,Күрсін...
Dialogue: 0,1:15:25.80,1:15:27.26,Default,,0,0,0,,Хмм.
Dialogue: 0,1:15:28.90,1:15:33.43,Default,,0,0,0,,Сіз қазір не істеп жатырсыз? Сіз қорқынышты көрінесіз.
Dialogue: 0,1:15:33.73,1:15:34.90,Default,,0,0,0,,Эмилияның фракциясы мен Куруштың фракциясы арасындағы тең шарттардағы одақ.
Dialogue: 0,1:15:35.90,1:15:37.33,Default,,0,0,0,,Бұл Цучидаманың қолы.
Dialogue: 0,1:15:37.83,1:15:40.60,Default,,0,0,0,,Маған қызық болды, мен саған бір сынық алып келдім.
Dialogue: 0,1:15:40.70,1:15:42.76,Default,,0,0,0,,Қараңызшы (Нобита) Уау! Апыр-ай!
Dialogue: 0,1:15:43.56,1:15:46.20,Default,,0,0,0,,Сіз таң қаласыз, солай емес пе? Бұл сондай зорлық-зомбылық.
Dialogue: 0,1:15:46.60,1:15:48.30,Default,,0,0,0,,Шашылған бөлшектерге қараңдар
Dialogue: 0,1:15:48.40,1:15:50.13,Default,,0,0,0,,Иә? Уау аа
Dialogue: 0,1:15:51.13,1:15:52.00,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,1:15:53.66,1:15:56.63,Default,,0,0,0,,Ол пішінді есте сақтайтын керамикадан жасалған.
Dialogue: 0,1:15:57.20,1:15:58.86,Default,,0,0,0,,Шамасы, Гига Зомби -
Dialogue: 0,1:15:58.96,1:16:01.63,Default,,0,0,0,,Мен оны жай сиқыршы деп ойламаймын.
Dialogue: 0,1:16:02.20,1:16:04.16,Default,,0,0,0,,Сонда Хикари тайпасы жақсы бола ма?
Dialogue: 0,1:16:04.63,1:16:06.13,Default,,0,0,0,,Мен бәріне хабарлаймын.
Dialogue: 0,1:16:08.16,1:16:09.43,Default,,0,0,0,,Хмм...
Dialogue: 0,1:16:26.03,1:16:28.03,Default,,0,0,0,,Кеш болды (Нобита)
Dialogue: 0,1:16:28.56,1:16:30.33,Default,,0,0,0,,Өте үлкен
Dialogue: 0,1:16:30.76,1:16:33.63,Default,,0,0,0,,Эй (Сунео) Кукуру
Dialogue: 0,1:16:33.80,1:16:34.96,Default,,0,0,0,,Кукуру
Dialogue: 0,1:16:35.96,1:16:37.16,Default,,0,0,0,,Кукуру
Dialogue: 0,1:16:38.13,1:16:39.03,Default,,0,0,0,,Cucur
Dialogue: 0,1:16:40.30,1:16:42.03,Default,,0,0,0,,Ауыл тұрғындары жоқ.
Dialogue: 0,1:16:42.13,1:16:43.56,Default,,0,0,0,,Бір жерде жоғалып кетті.
Dialogue: 0,1:16:44.50,1:16:45.86,Default,,0,0,0,,Бұл гига зомби ме?
Dialogue: 0,1:16:45.96,1:16:47.56,Default,,0,0,0,,Жоқ, сен соншалықты ақымақсың.
Dialogue: 0,1:16:48.26,1:16:50.60,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,1:16:50.83,1:16:52.53,Default,,0,0,0,,Қытайдан мұнда қалай жеттік?
Dialogue: 0,1:16:52.63,1:16:55.03,Default,,0,0,0,,Уау
Dialogue: 0,1:16:55.70,1:17:00.50,Default,,0,0,0,,Мен осындамын. Мен Рух патшасымын, Гига зомбимін.
Dialogue: 0,1:17:00.80,1:17:02.46,Default,,0,0,0,,Гига зомби?
Dialogue: 0,1:17:02.60,1:17:05.96,Default,,0,0,0,,Мен жаңа құлдар аламын.
Dialogue: 0,1:17:06.30,1:17:09.63,Default,,0,0,0,,Егер көңіліңіз қалса, Токоями сарайына келіңіз.
Dialogue: 0,1:17:10.03,1:17:13.43,Default,,0,0,0,,Дегенмен, ешқашан оралмауға дайын болыңыз.
Dialogue: 0,1:17:13.53,1:17:15.43,Default,,0,0,0,,(Гига зомбидің күлкісі)
Dialogue: 0,1:17:15.63,1:17:17.13,Default,,0,0,0,,Бұл құбыжық
Dialogue: 0,1:17:17.26,1:17:20.36,Default,,0,0,0,,(Гига Зомбидің күлкісі)
Dialogue: 0,1:17:21.23,1:17:22.20,Default,,0,0,0,,Оқ жаудырыңдар! Бүйіріне нысана ал!
Dialogue: 0,1:17:22.73,1:17:24.13,Default,,0,0,0,,Бұл иллюзия
Dialogue: 0,1:17:26.76,1:17:28.83,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:31.13,1:17:34.06,Default,,0,0,0,,Жарайды, Токоями сарайына барайық.
Dialogue: 0,1:17:41.26,1:17:43.10,Default,,0,0,0,,Бұл Токоя сарайы ма?
Dialogue: 0,1:17:43.20,1:17:45.43,Default,,0,0,0,,Үлкен Токоями сарайы
Dialogue: 0,1:17:45.60,1:17:46.60,Default,,0,0,0,,Сол ғибадатхана?
Dialogue: 0,1:17:46.70,1:17:49.30,Default,,0,0,0,,Әй, кеше келген жер емес пе?
Dialogue: 0,1:17:49.40,1:17:51.53,Default,,0,0,0,,Токоя сарайы қайда орналасқан?
Dialogue: 0,1:17:51.80,1:17:53.10,Default,,0,0,0,,Қайда?
Dialogue: 0,1:17:53.20,1:17:54.46,Default,,0,0,0,,О, менің...
Dialogue: 0,1:17:54.86,1:17:57.73,Default,,0,0,0,,Бірақ мен оны қалай да табудан басқа амалым жоқ.
Dialogue: 0,1:17:58.00,1:17:58.93,Default,,0,0,0,,Онда
Dialogue: 0,1:17:59.13,1:18:00.23,Default,,0,0,0,,Онда?
Dialogue: 0,1:18:00.76,1:18:03.10,Default,,0,0,0,,Алдымен бағытты анықтау үшін таяқшаны пайдаланыңыз—
Dialogue: 0,1:18:04.33,1:18:06.33,Default,,0,0,0,,Баспропеллер арқылы жалғастырыңыз
Dialogue: 0,1:18:06.43,1:18:08.63,Default,,0,0,0,,Бұл әдеттегі үлгі емес пе? Бұл
Dialogue: 0,1:18:30.26,1:18:32.70,Default,,0,0,0,,Біз ұзақ жолдан өттік, сондықтан уақыт келді...
Dialogue: 0,1:18:32.80,1:18:34.90,Default,,0,0,0,,Ах, а... Эй, Дораемон, а...
Dialogue: 0,1:18:35.00,1:18:37.70,Default,,0,0,0,,Батарея бітті, сондықтан төмен түсейік.
Dialogue: 0,1:18:46.40,1:18:48.56,Default,,0,0,0,,Бұл үлкен мұздық.
Dialogue: 0,1:18:49.53,1:18:51.36,Default,,0,0,0,,Уау
Dialogue: 0,1:18:52.33,1:18:54.20,Default,,0,0,0,,Аздап салқын емес пе?
Dialogue: 0,1:18:54.63,1:18:57.36,Default,,0,0,0,,А, бұл кондиционердің костюмі жұмыс істемейді, солай ма?
Dialogue: 0,1:18:57.46,1:18:59.66,Default,,0,0,0,,Оған көмектесу мүмкін емес, мынаны қараңыз.
Dialogue: 0,1:19:00.16,1:19:01.83,Default,,0,0,0,,50 градус аяз
Dialogue: 0,1:19:02.10,1:19:05.10,Default,,0,0,0,,Мына киімдерді шешсеңіз, бірден тоңып қаласыз.
Dialogue: 0,1:19:05.56,1:19:07.73,Default,,0,0,0,,Сіз біраз уақыттан бері біртүрлі дыбыстарды естіген жоқсыз ба?
Dialogue: 0,1:19:07.83,1:19:08.80,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:14.00,1:19:14.93,Default,,0,0,0,,Эмма мен басқалары – мен бұрын-соңды көрген де, сөйлескен де алғашқы адамдар еді.
Dialogue: 0,1:19:16.03,1:19:17.36,Default,,0,0,0,,Қауіпті, қаш.
Dialogue: 0,1:19:17.46,1:19:18.63,Default,,0,0,0,,Уау
Dialogue: 0,1:19:22.33,1:19:24.06,Default,,0,0,0,,Мұз ағып жатыр, асығайық.
Dialogue: 0,1:19:24.26,1:19:26.53,Default,,0,0,0,,Таксоптерсіз қалай жасауға болады?
Dialogue: 0,1:19:26.80,1:19:28.00,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,1:19:28.10,1:19:30.26,Default,,0,0,0,,Келушінің таяқшасы!
Dialogue: 0,1:19:30.36,1:19:32.66,Default,,0,0,0,,Әлде таяқ па?
Dialogue: 0,1:19:35.13,1:19:36.73,Default,,0,0,0,,Осы таудың арғы жағында?
Dialogue: 0,1:19:37.10,1:19:39.80,Default,,0,0,0,,Өзіңді сызықты моторлы көлік ретінде көрсет!
Dialogue: 0,1:19:40.26,1:19:42.33,Default,,0,0,0,,Осындай уақытта пойыздар ойнайсыз ба?
Dialogue: 0,1:19:42.43,1:19:44.33,Default,,0,0,0,,Жүр, тезірек бортқа мін.
Dialogue: 0,1:19:44.96,1:19:47.43,Default,,0,0,0,,«Жүріңіз.» (Сунео) Бұл жол.
Dialogue: 0,1:19:47.60,1:19:51.23,Default,,0,0,0,,Өзін сызықты моторлы көлік ретінде көрсету жердің магнетизмін пайдаланады.
Dialogue: 0,1:19:51.33,1:19:53.46,Default,,0,0,0,,Ол 300км/сағ дейін жүре алады.
Dialogue: 0,1:19:53.56,1:19:55.40,Default,,0,0,0,,Не? 300 км?
Dialogue: 0,1:19:55.93,1:19:58.63,Default,,0,0,0,,үшін атқа мінді ме? Енді жолға шығайық.
Dialogue: 0,1:19:58.73,1:20:00.13,Default,,0,0,0,,Кету!
Dialogue: 0,1:20:00.23,1:20:02.93,Default,,0,0,0,,Ах, (Сунео) Бұл әдепсіз.
Dialogue: 0,1:20:03.03,1:20:04.40,Default,,0,0,0,,Ысырапшыл болмаңыз
Dialogue: 0,1:20:12.43,1:20:14.20,Default,,0,0,0,,Жылдам
Dialogue: 0,1:20:19.23,1:20:21.06,Default,,0,0,0,,Уау
Dialogue: 0,1:20:26.43,1:20:28.70,Default,,0,0,0,,Уау, мен 300км/сағ жылдамдықпен жүрмін.
Dialogue: 0,1:20:28.80,1:20:31.03,Default,,0,0,0,,Уау
Dialogue: 0,1:20:40.86,1:20:42.50,Default,,0,0,0,,Уау
Dialogue: 0,1:20:43.16,1:20:44.50,Default,,0,0,0,,Тоқта, тоқта!
Dialogue: 0,1:20:44.73,1:20:45.90,Default,,0,0,0,,аялдаманы тоқтату
Dialogue: 0,1:20:46.00,1:20:47.53,Default,,0,0,0,,Тоқта
Dialogue: 0,1:20:52.93,1:20:54.53,Default,,0,0,0,,үшін жақсы ма?
Dialogue: 0,1:20:54.63,1:20:55.86,Default,,0,0,0,,Ах (Сунео) Иә.
Dialogue: 0,1:20:55.96,1:20:59.50,Default,,0,0,0,,Мұнда үңгір бар. Әзірше баспана ал.
Dialogue: 0,1:21:06.13,1:21:07.53,Default,,0,0,0,,Өте шиеленісті, иә?
Dialogue: 0,1:21:08.53,1:21:11.80,Default,,0,0,0,,Мен мұндай боран болады деп ойламаппын.
Dialogue: 0,1:21:11.90,1:21:14.00,Default,,0,0,0,,Сунео, жақсысың ба?
Dialogue: 0,1:21:14.83,1:21:15.56,Default,,0,0,0,,Сунео!
Dialogue: 0,1:21:15.66,1:21:18.03,Default,,0,0,0,,А, иә, жоқ, көңілім қалды.
Dialogue: 0,1:21:18.30,1:21:21.36,Default,,0,0,0,,Қалай болғанда да, Нобита-кун, сен керемет жұмыс жасадың.
Dialogue: 0,1:21:21.46,1:21:22.46,Default,,0,0,0,,Шынымен
Dialogue: 0,1:21:22.60,1:21:24.36,Default,,0,0,0,,Нобита керемет
Dialogue: 0,1:21:24.46,1:21:27.60,Default,,0,0,0,,Нобита... Иә? Нобита жоқ
Dialogue: 0,1:21:27.70,1:21:29.46,Default,,0,0,0,,А, Нобита-кун?
Dialogue: 0,1:21:31.56,1:21:34.56,Default,,0,0,0,,Нобита~! (Сунео) Нобита~
Dialogue: 0,1:21:34.66,1:21:36.16,Default,,0,0,0,,Нобита-сан!
Dialogue: 0,1:21:36.26,1:21:38.80,Default,,0,0,0,,Нобита-кун! Нобита
Dialogue: 0,1:21:38.90,1:21:40.23,Default,,0,0,0,,Мен сені іздеймін.
Dialogue: 0,1:21:40.33,1:21:42.96,Default,,0,0,0,,Джан, бұл мүмкін емес. Сіз де жоғаласыз.
Dialogue: 0,1:21:43.30,1:21:45.33,Default,,0,0,0,,Іздемесең өлесің.
Dialogue: 0,1:21:45.83,1:21:48.30,Default,,0,0,0,,Нобита өледі.
Dialogue: 0,1:21:48.43,1:21:49.50,Default,,0,0,0,,(Сунео/Шидзуканың жылауы)
Dialogue: 0,1:21:49.60,1:21:50.83,Default,,0,0,0,,Дораемон жауапты.
Dialogue: 0,1:21:50.96,1:21:53.53,Default,,0,0,0,,Мен білемін, у...
Dialogue: 0,1:21:54.10,1:21:56.20,Default,,0,0,0,,Құтқарушы бөтелке!
Dialogue: 0,1:21:56.80,1:22:00.83,Default,,0,0,0,,Бұл бөтелкеде емдік энергетикалық сусын бар.
Dialogue: 0,1:22:01.00,1:22:02.53,Default,,0,0,0,,Нобита-кунды табыңыз
Dialogue: 0,1:22:03.03,1:22:06.43,Default,,0,0,0,,Өзіңді жақсы сезінгенде, мен сені осында жетектеп, қайтып келемін.
Dialogue: 0,1:22:06.96,1:22:09.16,Default,,0,0,0,,Нобитаның орнына қалай жетуге болады?
Dialogue: 0,1:22:09.46,1:22:13.06,Default,,0,0,0,,Сізге тек Нобита-кунның иісін еске түсіру керек.
Dialogue: 0,1:22:13.36,1:22:15.73,Default,,0,0,0,,Нобитаның иісі бар нәрсе бар ма?
Dialogue: 0,1:22:15.93,1:22:17.80,Default,,0,0,0,,Менің көңілім қалды.
Dialogue: 0,1:22:17.90,1:22:18.76,Default,,0,0,0,,Конняро қазірдің өзінде
Dialogue: 0,1:22:18.86,1:22:20.73,Default,,0,0,0,,Джиан: Зорлық-зомбылық жасама.
Dialogue: 0,1:22:21.13,1:22:23.86,Default,,0,0,0,,Аа, дұрыс. Мен жақсы нәрсе жасырылғанына сенімдімін.
Dialogue: 0,1:22:24.03,1:22:25.66,Default,,0,0,0,,Бұл да, мынау да, мынау да, мынау да емес
Dialogue: 0,1:22:25.76,1:22:28.20,Default,,0,0,0,,Иә 0 ұпай жауап
Dialogue: 0,1:22:28.83,1:22:30.43,Default,,0,0,0,,Осының иісін сезіп көрейін
Dialogue: 0,1:22:32.63,1:22:33.50,Default,,0,0,0,,Ауырсыну
Dialogue: 0,1:22:34.00,1:22:35.46,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:22:49.56,1:22:52.70,Default,,0,0,0,,Не? Бұл шошқа ма? Бұл ит пе?
Dialogue: 0,1:22:59.23,1:23:00.73,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,1:23:00.83,1:23:03.16,Default,,0,0,0,,Жарайды, тек күте аламыз.
Dialogue: 0,1:23:03.50,1:23:05.40,Default,,0,0,0,,Hexsi Күн суытып барады
Dialogue: 0,1:23:07.13,1:23:08.66,Default,,0,0,0,,Артқы жағы жылы емес пе?
Dialogue: 0,1:23:09.20,1:23:10.63,Default,,0,0,0,,Дораемон! (Сунео/Шидзука) Иә?
Dialogue: 0,1:23:10.80,1:23:12.23,Default,,0,0,0,,Не болды? Джан
Dialogue: 0,1:23:14.90,1:23:16.96,Default,,0,0,0,,Жоқ... бұл баспалдақтар қандай?
Dialogue: 0,1:23:17.06,1:23:18.36,Default,,0,0,0,,Мүмкін бұл...
Dialogue: 0,1:23:18.50,1:23:19.76,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,1:23:23.90,1:23:28.56,Default,,0,0,0,,Гига!
Dialogue: 0,1:23:28.80,1:23:30.56,Default,,0,0,0,,Келдің бе?
Dialogue: 0,1:23:31.26,1:23:36.00,Default,,0,0,0,,Өздерін Ұлы Рух патшасы Дразомби деп атайтын ақымақтар
Dialogue: 0,1:23:36.86,1:23:39.90,Default,,0,0,0,,Бұл күлкілі. Олар сені бөліп тастайды.
Dialogue: 0,1:23:40.00,1:23:42.00,Default,,0,0,0,,(Гига зомбидің күлкісі)
Dialogue: 0,1:23:46.83,1:23:50.53,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:23:54.46,1:23:58.83,Default,,0,0,0,,Дораэмонның құралдары кемшіліктерге толы емес пе?
Dialogue: 0,1:24:01.23,1:24:04.33,Default,,0,0,0,,Дораэмон Шизука-чан
Dialogue: 0,1:24:04.43,1:24:06.63,Default,,0,0,0,,Джан Сунео
Dialogue: 0,1:24:07.16,1:24:09.93,Default,,0,0,0,,Суық, суық...
Dialogue: 0,1:24:10.23,1:24:14.53,Default,,0,0,0,,Өткенде қалдырған рамен сорпасын ішуім керек еді.
Dialogue: 0,1:24:15.03,1:24:16.03,Default,,0,0,0,,Ноби-чан
Dialogue: 0,1:24:17.36,1:24:19.20,Default,,0,0,0,,Әй, ана?
Dialogue: 0,1:24:19.30,1:24:21.50,Default,,0,0,0,,Сіз не істеп жатырсыз? Осындай жерде
Dialogue: 0,1:24:21.60,1:24:24.16,Default,,0,0,0,,Ха мама, бұл босқа. Отсую
Dialogue: 0,1:24:24.26,1:24:26.60,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Сіз оны әрқашан артта қалдырасыз.
Dialogue: 0,1:24:26.70,1:24:29.46,Default,,0,0,0,,Мен ішемін аа...
Dialogue: 0,1:24:30.20,1:24:33.20,Default,,0,0,0,,Нобита Жылы (Нобита) Иә?
Dialogue: 0,1:24:33.93,1:24:35.90,Default,,0,0,0,,Не? Әкем де келді ме?
Dialogue: 0,1:24:36.00,1:24:38.43,Default,,0,0,0,,Иә, компания бүгін жабық, сондықтан...
Dialogue: 0,1:24:38.53,1:24:41.06,Default,,0,0,0,,Мен сенімен пештің басында отырғым келді.
Dialogue: 0,1:24:41.33,1:24:44.76,Default,,0,0,0,,Не, бұл пеш мүлдем жылы емес пе?
Dialogue: 0,1:24:44.86,1:24:46.73,Default,,0,0,0,,Хмм, мен оны әкелу үшін қиналдым.
Dialogue: 0,1:24:46.83,1:24:49.13,Default,,0,0,0,,А, әке, жарайды, әке, әке.
Dialogue: 0,1:24:49.23,1:24:50.50,Default,,0,0,0,,Оны өзіңізбен бірге алуға болмайды.
Dialogue: 0,1:24:50.86,1:24:55.66,Default,,0,0,0,,Әке, ана... бірдеңе істе~
Dialogue: 0,1:24:55.76,1:24:58.30,Default,,0,0,0,,Аня, көпшіліктен қорықпайсың ба?
Dialogue: 0,1:25:03.83,1:25:07.26,Default,,0,0,0,,Нобита Ноби ұйықтағысы келеді.
Dialogue: 0,1:25:07.63,1:25:11.10,Default,,0,0,0,,Е, а, иә, ұйықтағым келеді.
Dialogue: 0,1:25:11.43,1:25:12.63,Default,,0,0,0,,өлім жазасы
Dialogue: 0,1:25:12.90,1:25:15.16,Default,,0,0,0,,Жарайды, онда мен өлгім келмейді.
Dialogue: 0,1:25:15.33,1:25:16.93,Default,,0,0,0,,Дораэмон бірдеңе жасаңыз
Dialogue: 0,1:25:17.03,1:25:20.10,Default,,0,0,0,,Мен Дораемон емеспін, мен сенің адвокатымын.
Dialogue: 0,1:25:20.50,1:25:23.00,Default,,0,0,0,,Төрағалық етуші куәгерлерді шақыруда.
Dialogue: 0,1:25:23.73,1:25:26.73,Default,,0,0,0,,Дораемон, шын жауап берші, жарай ма?
Dialogue: 0,1:25:26.86,1:25:27.46,Default,,0,0,0,,Иә
Dialogue: 0,1:25:27.56,1:25:30.50,Default,,0,0,0,,Айыпталушы Бита жиі ұйықтай ма?
Dialogue: 0,1:25:30.83,1:25:35.00,Default,,0,0,0,,Иә, мен үй тапсырмасын орындаған кезде үнемі қорылдаймын.
Dialogue: 0,1:25:35.10,1:25:38.00,Default,,0,0,0,,Кейде тамақтану кезінде
Dialogue: 0,1:25:38.40,1:25:40.70,Default,,0,0,0,,Мен ұйықтамаймын Мен ұйықтамаймын
Dialogue: 0,1:25:40.80,1:25:42.66,Default,,0,0,0,,Дораемон, маған көмектес
Dialogue: 0,1:25:42.76,1:25:45.63,Default,,0,0,0,,Келесі куә Мектепте не болып жатыр?
Dialogue: 0,1:25:46.16,1:25:49.70,Default,,0,0,0,,Иә, мен кейде бірінші сағаттан бастап ұйықтап кетемін.
Dialogue: 0,1:25:49.80,1:25:52.83,Default,,0,0,0,,Жағдай қатты нашарлағанда мен күні бойы мектепте ұйықтаймын...
Dialogue: 0,1:25:53.06,1:25:54.76,Default,,0,0,0,,Мұғалім, бұл тым көп.
Dialogue: 0,1:25:56.03,1:25:58.66,Default,,0,0,0,,Адвокат Сізде қандай да бір айып бар ма?
Dialogue: 0,1:25:59.03,1:26:00.90,Default,,0,0,0,,Заңгер, бірдеңе жасаңыз.
Dialogue: 0,1:26:01.00,1:26:03.86,Default,,0,0,0,,Ұйықтауыңызды ақтау мүмкін емес.
Dialogue: 0,1:26:03.96,1:26:05.46,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,1:26:05.93,1:26:11.03,Default,,0,0,0,,Сотталушы Нобита Ноби ұйықтап қалғаны үшін өлім жазасына кесілді
Dialogue: 0,1:26:11.26,1:26:14.30,Default,,0,0,0,,Мен енді ұйықтамаймын.
Dialogue: 0,1:26:14.40,1:26:15.46,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,1:26:15.56,1:26:17.10,Default,,0,0,0,,Ах Шизука-чан
Dialogue: 0,1:26:17.60,1:26:19.00,Default,,0,0,0,,Маған көмектесші~
Dialogue: 0,1:26:19.13,1:26:20.60,Default,,0,0,0,,Рамен сорпасы
Dialogue: 0,1:26:20.70,1:26:21.83,Default,,0,0,0,,Уау
Dialogue: 0,1:26:25.10,1:26:28.03,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,1:26:29.76,1:26:34.10,Default,,0,0,0,,Қазір бәрі жақсы, тез сауығып кетесің.
Dialogue: 0,1:26:34.90,1:26:39.30,Default,,0,0,0,,Не? Не, бұл елес пе?
Dialogue: 0,1:26:39.40,1:26:42.50,Default,,0,0,0,,Хехе, мен өлдім деп ойламаймын.
Dialogue: 0,1:26:48.03,1:26:50.70,Default,,0,0,0,,Ашылуы екіталай
Dialogue: 0,1:26:52.26,1:26:54.83,Default,,0,0,0,,Егер сіз кіре алсаңыз -
Dialogue: 0,1:26:56.53,1:27:00.93,Default,,0,0,0,,Осы кішкентай қорапты ашып, ішіндегі түймені басыңыз.
Dialogue: 0,1:27:01.66,1:27:02.60,Default,,0,0,0,,Бұл
Dialogue: 0,1:27:26.30,1:27:27.06,Default,,0,0,0,,Нуер
Dialogue: 0,1:27:27.16,1:27:28.76,Default,,0,0,0,,Аа, Конняро
Dialogue: 0,1:27:41.73,1:27:43.33,Default,,0,0,0,,Эй (Кураями тайпасы В) Ах!
Dialogue: 0,1:27:45.83,1:27:47.36,Default,,0,0,0,,Уау
Dialogue: 0,1:27:52.00,1:27:55.10,Default,,0,0,0,,(баланың жылауы)
Dialogue: 0,1:28:11.60,1:28:13.36,Default,,0,0,0,,Ух... аааа
Dialogue: 0,1:28:13.50,1:28:14.20,Default,,0,0,0,,Теят
Dialogue: 0,1:28:14.73,1:28:15.63,Default,,0,0,0,,Чикишо
Dialogue: 0,1:28:15.73,1:28:17.33,Default,,0,0,0,,А, мына жерде Кукуру бар.
Dialogue: 0,1:28:19.93,1:28:21.23,Default,,0,0,0,,Бұл Тәжікара-сан.
Dialogue: 0,1:28:21.73,1:28:22.80,Default,,0,0,0,,Үлкендерге
Dialogue: 0,1:28:23.10,1:28:24.93,Default,,0,0,0,,Осыған көмектесейік.
Dialogue: 0,1:28:25.03,1:28:27.76,Default,,0,0,0,,Күте тұрыңыз, ұсталмақ болғандай.
Dialogue: 0,1:28:28.06,1:28:29.10,Default,,0,0,0,,Жақсы нәрсе бар
Dialogue: 0,1:28:29.30,1:28:32.10,Default,,0,0,0,,Ультра уақытты қарау!
Dialogue: 0,1:28:36.40,1:28:39.16,Default,,0,0,0,,Бізден басқаның бәрі үшін уақыт тоқтады.
Dialogue: 0,1:28:39.26,1:28:40.03,Default,,0,0,0,,Жарайды
Dialogue: 0,1:28:48.66,1:28:50.96,Default,,0,0,0,,Кукуру, мен көмектесуге келдім.
Dialogue: 0,1:28:51.50,1:28:52.43,Default,,0,0,0,,Cucur
Dialogue: 0,1:28:53.46,1:28:54.53,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,1:28:55.00,1:28:56.83,Default,,0,0,0,,Хикари тайпасын жылжыта алмайсың ба?
Dialogue: 0,1:28:57.36,1:29:02.46,Default,,0,0,0,,Осыншама адамды құтқару үшін алдымен қашу жолын жасау керек.
Dialogue: 0,1:29:03.46,1:29:05.80,Default,,0,0,0,,Құрсаудан өтіңіз!
Dialogue: 0,1:29:06.20,1:29:08.36,Default,,0,0,0,,Жердегі жағдайды тексеру
Dialogue: 0,1:29:09.03,1:29:10.93,Default,,0,0,0,,Мен сізге бірден көмектесемін.
Dialogue: 0,1:29:11.43,1:29:12.53,Default,,0,0,0,,Беда
Dialogue: 0,1:29:13.86,1:29:15.70,Default,,0,0,0,,Йойшо Йойшо
Dialogue: 0,1:29:15.80,1:29:17.20,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,1:29:17.30,1:29:19.63,Default,,0,0,0,,Мен бірден өтуім керек.
Dialogue: 0,1:29:19.73,1:29:21.50,Default,,0,0,0,,Ол бұзылды ма?
Dialogue: 0,1:29:27.70,1:29:30.16,Default,,0,0,0,,Бұл бейтаныс жерде пайда болды.
Dialogue: 0,1:29:30.33,1:29:32.60,Default,,0,0,0,,Құралдарда ақау бар ма?
Dialogue: 0,1:29:32.70,1:29:33.63,Default,,0,0,0,,Иә?
Dialogue: 0,1:29:34.96,1:29:37.53,Default,,0,0,0,,Бұл қандай машина?
Dialogue: 0,1:29:37.66,1:29:39.13,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:29:39.50,1:29:42.10,Default,,0,0,0,,Амал жоқ... Уақытты тоқтаттым.
Dialogue: 0,1:29:44.36,1:29:45.80,Default,,0,0,0,,Эрен сияқты түрлендіруден өткен адам деп саналатын Әйел Титанмен бетпе-бет келді—
Dialogue: 0,1:29:49.53,1:29:51.33,Default,,0,0,0,,Қош келдіңіз Дразомби-кун
Dialogue: 0,1:29:51.43,1:29:54.36,Default,,0,0,0,,Мен сіздің тоқтатылған уақытыңызды жойдым.
Dialogue: 0,1:29:54.86,1:29:55.86,Default,,0,0,0,,Шығарылды ма?
Dialogue: 0,1:29:55.96,1:29:57.50,Default,,0,0,0,,Вахахаха
Dialogue: 0,1:29:57.60,1:29:59.53,Default,,0,0,0,,Мұнда ешкім кіре алмайды...
Dialogue: 0,1:29:59.63,1:30:02.83,Default,,0,0,0,,Ерлігің үшін саған құрмет көрсеттім.
Dialogue: 0,1:30:03.46,1:30:06.73,Default,,0,0,0,,Жарайды, сіз уақытша қылмыскерсіз.
Dialogue: 0,1:30:07.10,1:30:09.70,Default,,0,0,0,,Тарихты өз қалауына сәйкес өзгертуге тырысу —
Dialogue: 0,1:30:09.93,1:30:11.16,Default,,0,0,0,,Сіз болашақтансыз ба?
Dialogue: 0,1:30:11.33,1:30:13.06,Default,,0,0,0,,(Гига зомбидің күлкісі)
Dialogue: 0,1:30:13.16,1:30:16.60,Default,,0,0,0,,Жарайсың, мен мынаны өзімнің қорғаным еттім.
Dialogue: 0,1:30:16.70,1:30:20.96,Default,,0,0,0,,Дүниені, жер тарихын алуға тырысамын.
Dialogue: 0,1:30:21.33,1:30:26.10,Default,,0,0,0,,Қарабайыр адамдармен қарым-қатынас жасағанда, бұл нәрестенің қолын бұраумен бірдей.
Dialogue: 0,1:30:26.20,1:30:29.00,Default,,0,0,0,,Time Patrol сізді жалғыз қалдырмайды.
Dialogue: 0,1:30:29.43,1:30:31.93,Default,,0,0,0,,Сондықтан жер астына негіз салдық.
Dialogue: 0,1:30:32.03,1:30:35.63,Default,,0,0,0,,Ішкі кеңістікті жою құрылғысы аяқталғаннан кейін...
Dialogue: 0,1:30:35.73,1:30:38.00,Default,,0,0,0,,Бұл дәуірге жақынырақ қол жеткізу мүмкін емес
Dialogue: 0,1:30:38.10,1:30:43.50,Default,,0,0,0,,Ал мен мәңгілік әлемнің императоры боламын.
Dialogue: 0,1:30:43.60,1:30:45.76,Default,,0,0,0,,Мен бұған жол бермеймін.
Dialogue: 0,1:30:47.23,1:30:48.20,Default,,0,0,0,,жансыз
Dialogue: 0,1:30:48.80,1:30:50.86,Default,,0,0,0,,Сен ақымақ роботсың
Dialogue: 0,1:30:51.06,1:30:51.90,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:30:52.06,1:30:53.43,Default,,0,0,0,,Дораемон
Dialogue: 0,1:30:54.03,1:30:55.70,Default,,0,0,0,,Сіз бұл жігіттің достарының бірісіз бе?
Dialogue: 0,1:30:56.10,1:30:57.70,Default,,0,0,0,,үшін түсірілді
Dialogue: 0,1:30:58.00,1:30:59.46,Default,,0,0,0,,Дора-чан, мықты бол
Dialogue: 0,1:30:59.56,1:31:06.63,Default,,0,0,0,,(Гига Зомбидің күлкісі)
Dialogue: 0,1:31:19.40,1:31:21.46,Default,,0,0,0,,Хмм... аа, не болып жатыр?
Dialogue: 0,1:31:22.00,1:31:23.56,Default,,0,0,0,,Түс көрдім бе деп
Dialogue: 0,1:31:24.33,1:31:25.96,Default,,0,0,0,,Жоқ, бұл арман емес деп ойлаймын.
Dialogue: 0,1:31:26.76,1:31:27.86,Default,,0,0,0,,Сіз құтқарылған сияқтысыз.
Dialogue: 0,1:31:29.50,1:31:31.23,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:31:32.36,1:31:34.30,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,1:31:34.50,1:31:37.13,Default,,0,0,0,,Джан Сунео
Dialogue: 0,1:31:42.96,1:31:44.70,Default,,0,0,0,,Мұндай жағдайда бәрін маған қалдыр.
Dialogue: 0,1:31:48.70,1:31:52.00,Default,,0,0,0,,Пеггер Гри Драко
Dialogue: 0,1:31:52.63,1:31:55.73,Default,,0,0,0,,үшін қайда кетті? Сіз уайымдадыңыз ба?
Dialogue: 0,1:31:59.20,1:32:01.33,Default,,0,0,0,,Дораэмон және басқалары жақын жерде болуы керек.
Dialogue: 0,1:32:01.53,1:32:03.50,Default,,0,0,0,,Иіске еріп іздей аламыз ба?
Dialogue: 0,1:32:04.66,1:32:05.90,Default,,0,0,0,,О, бұл не?
Dialogue: 0,1:32:07.93,1:32:09.30,Default,,0,0,0,,Менің жауабым?
Dialogue: 0,1:32:09.93,1:32:11.30,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,1:32:11.80,1:32:12.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:19.36,1:32:27.93,Default,,0,0,0,,Ааааййййячитаох Аййячитаох
Dialogue: 0,1:32:28.53,1:32:37.16,Default,,0,0,0,,Аэее
Dialogue: 0,1:32:37.43,1:32:44.46,Default,,0,0,0,,Аааааййййячитаох Аййячитаох
Dialogue: 0,1:32:44.56,1:32:46.86,Default,,0,0,0,,Айияячитао
Dialogue: 0,1:32:47.06,1:32:48.93,Default,,0,0,0,,Құрбандық – бұл
Dialogue: 0,1:32:52.20,1:32:54.20,Default,,0,0,0,,Дораемон, бірдеңе істе
Dialogue: 0,1:32:54.33,1:32:56.90,Default,,0,0,0,,Мен оған көмектесе алмаймын.
Dialogue: 0,1:32:57.06,1:32:58.80,Default,,0,0,0,,Мұндай ана!
Dialogue: 0,1:33:01.53,1:33:05.86,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,1:33:06.06,1:33:08.13,Default,,0,0,0,,Қылшын тісті жолбарыс?
Dialogue: 0,1:33:13.70,1:33:14.46,Default,,0,0,0,,Дораемон!
Dialogue: 0,1:33:15.53,1:33:17.43,Default,,0,0,0,,Джан Сунео!
Dialogue: 0,1:33:17.53,1:33:18.43,Default,,0,0,0,,Нобита!
Dialogue: 0,1:33:18.53,1:33:19.56,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:33:31.76,1:33:32.60,Default,,0,0,0,,Цучидама
Dialogue: 0,1:33:33.56,1:33:34.53,Default,,0,0,0,,Шығу осы жолмен.
Dialogue: 0,1:33:40.73,1:33:43.10,Default,,0,0,0,,Ей, ақымақтар, шыға аласың ба?
Dialogue: 0,1:33:46.50,1:33:47.83,Default,,0,0,0,,Уау
Dialogue: 0,1:33:48.00,1:33:49.16,Default,,0,0,0,,Бұл үңгір.
Dialogue: 0,1:33:49.93,1:33:51.76,Default,,0,0,0,,Кукукукукуку…
Dialogue: 0,1:33:53.96,1:33:56.03,Default,,0,0,0,,Мен енді қаша алмаймын
Dialogue: 0,1:33:56.86,1:33:59.16,Default,,0,0,0,,Лезде жабысатын пистолет!
Dialogue: 0,1:33:59.46,1:34:01.13,Default,,0,0,0,,Бұл сізге жақсы
Dialogue: 0,1:34:02.56,1:34:06.16,Default,,0,0,0,,Эй, бұл не? Мен қимылдай алмаймын.
Dialogue: 0,1:34:06.26,1:34:08.06,Default,,0,0,0,,Эй, бірдеңе істе.
Dialogue: 0,1:34:08.36,1:34:11.00,Default,,0,0,0,,Әдепсіз әдістерді қолданады
Dialogue: 0,1:34:11.26,1:34:11.93,Default,,0,0,0,,Сол жерде
Dialogue: 0,1:34:14.03,1:34:16.33,Default,,0,0,0,,(үшін айқайлайды)
Dialogue: 0,1:34:16.53,1:34:18.00,Default,,0,0,0,,Уа, ау, ау
Dialogue: 0,1:34:20.36,1:34:23.26,Default,,0,0,0,,(Гига зомбидің күлкісі)
Dialogue: 0,1:34:23.53,1:34:25.56,Default,,0,0,0,,Енді мен мәңгілік жер астындамын.
Dialogue: 0,1:34:25.66,1:34:27.83,Default,,0,0,0,,(Гига зомбидің күлкісі)
Dialogue: 0,1:34:29.76,1:34:32.20,Default,,0,0,0,,Жоқ, мен толығымен қамалғанмын.
Dialogue: 0,1:34:34.03,1:34:36.20,Default,,0,0,0,,Дораемон қандай шеңбер арқылы өтеді?
Dialogue: 0,1:34:36.30,1:34:37.96,Default,,0,0,0,,Мен оны жаңа ғана қолдандым.
Dialogue: 0,1:34:38.06,1:34:39.73,Default,,0,0,0,,Ал, онда не істеуіміз керек?
Dialogue: 0,1:34:39.83,1:34:41.16,Default,,0,0,0,,Солай сияқты.
Dialogue: 0,1:34:42.50,1:34:44.53,Default,,0,0,0,,Қалталарыңызды реттеңіз
Dialogue: 0,1:34:44.73,1:34:47.96,Default,,0,0,0,,Дахахахаха Жер енді менікі
Dialogue: 0,1:34:48.06,1:34:52.93,Default,,0,0,0,,(Гига зомбидің күлкісі)
Dialogue: 0,1:34:57.10,1:35:00.76,Default,,0,0,0,,Ештеңе емес, Дорами байқағанша күту керек.
Dialogue: 0,1:35:00.86,1:35:03.20,Default,,0,0,0,,Байқамасам ше?
Dialogue: 0,1:35:03.30,1:35:04.56,Default,,0,0,0,,Міне
Dialogue: 0,1:35:04.90,1:35:08.13,Default,,0,0,0,,Сонда... сонда мәңгі жер астында өмір сүресің бе?
Dialogue: 0,1:35:08.23,1:35:12.00,Default,,0,0,0,,Уф, мен мұндай жерде өлгім келмейді, мама!
Dialogue: 0,1:35:12.10,1:35:15.23,Default,,0,0,0,,Кешіріңіз, мен барлығын шақырдым.
Dialogue: 0,1:35:15.33,1:35:17.03,Default,,0,0,0,,Иә? Ахх
Dialogue: 0,1:35:17.16,1:35:20.90,Default,,0,0,0,,Осы кішкентай қорапты ашып, ішіндегі түймені басыңыз.
Dialogue: 0,1:35:24.66,1:35:26.80,Default,,0,0,0,,Бұл не сұмдық? Бұл
Dialogue: 0,1:35:26.96,1:35:29.96,Default,,0,0,0,,(таратқыштың дыбысы)
Dialogue: 0,1:35:34.03,1:35:37.80,Default,,0,0,0,,Мұнда басыңыз Кеш плейстоцен төртінші мұздық зерттеушісі
Dialogue: 0,1:35:38.66,1:35:40.56,Default,,0,0,0,,Мамонт атын жамылып, ішкі тергеу жүргізеді
Dialogue: 0,1:35:40.66,1:35:44.93,Default,,0,0,0,,Соңында Гига Зомбидің құпия базасын тауып, қолдау сұрады.
Dialogue: 0,1:35:54.93,1:35:55.86,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:36:00.23,1:36:04.26,Default,,0,0,0,,Уақыт патрульдік командасы Giga Zombie базасына қарай кетеді.
Dialogue: 0,1:36:17.16,1:36:21.80,Default,,0,0,0,,(таратқыш дыбысы)
Dialogue: 0,1:36:21.90,1:36:23.33,Default,,0,0,0,,Бұл қатты дыбыс шығарып тұр
Dialogue: 0,1:36:24.50,1:36:25.33,Default,,0,0,0,,Ах
Dialogue: 0,1:36:25.66,1:36:27.93,Default,,0,0,0,,Уақыт үнемделген патрульдік топ.
Dialogue: 0,1:36:28.03,1:36:28.80,Default,,0,0,0,,Тодороки, сен не айтып тұрсың өзің?
Dialogue: 0,1:36:28.90,1:36:30.96,Default,,0,0,0,,Сәлем, сәлем
Dialogue: 0,1:36:33.60,1:36:35.70,Default,,0,0,0,,Өйткені, маған хабарлаған сен едің ғой.
Dialogue: 0,1:36:35.83,1:36:39.30,Default,,0,0,0,,«Сіз» дегеніміз не? Ал, сол кішкентай қораптағы түйме ше...
Dialogue: 0,1:36:39.46,1:36:41.13,Default,,0,0,0,,Мен байқамадым
Dialogue: 0,1:36:41.53,1:36:44.40,Default,,0,0,0,,Керемет, сіздің арқаңызда мен Giga Zombie базасын білдім.
Dialogue: 0,1:36:44.50,1:36:45.10,Default,,0,0,0,,Рахмет
Dialogue: 0,1:36:45.40,1:36:48.00,Default,,0,0,0,,Ха, дұрыс. Гига зомби туралы не деуге болады?
Dialogue: 0,1:36:48.46,1:36:50.03,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,1:36:50.33,1:36:53.20,Default,,0,0,0,,Е, иә... ааа
Dialogue: 0,1:36:56.16,1:36:58.90,Default,,0,0,0,,Гига зомбиі ғарыш кеңістігін жойғаны үшін қамауға алынды
Dialogue: 0,1:36:59.46,1:37:00.60,Default,,0,0,0,,Гигат
Dialogue: 0,1:37:01.53,1:37:04.03,Default,,0,0,0,,Хикари халқы енді қауіпсіз қорғалды.
Dialogue: 0,1:37:04.13,1:37:06.36,Default,,0,0,0,,Бұл негіз көп ұзамай жойылады.
Dialogue: 0,1:37:06.76,1:37:08.13,Default,,0,0,0,,Тез кемеге мініңіз.
Dialogue: 0,1:37:08.40,1:37:09.33,Default,,0,0,0,,Иә
Dialogue: 0,1:37:09.40,1:37:11.13,Default,,0,0,0,,Мен жүре аламын ба? Сонша
Dialogue: 0,1:37:11.23,1:37:13.00,Default,,0,0,0,,Ештеңе етпейді, әйтеуір сыйып кетемін.
Dialogue: 0,1:37:13.46,1:37:15.50,Default,,0,0,0,,Ол тар емес пе?
Dialogue: 0,1:37:15.60,1:37:17.03,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,1:37:32.76,1:37:36.00,Default,,0,0,0,,Сонымен, біз осында тұра аламыз ба?
Dialogue: 0,1:37:36.26,1:37:38.73,Default,,0,0,0,,Гига зомби енді келмейді.
Dialogue: 0,1:37:38.90,1:37:41.06,Default,,0,0,0,,Ауылды қалпына келтіру
Dialogue: 0,1:37:41.30,1:37:44.20,Default,,0,0,0,,Енді Кукуру менің бабам болуы мүмкін.
Dialogue: 0,1:37:44.46,1:37:45.96,Default,,0,0,0,,Жоқ, бұл мен шығармын.
Dialogue: 0,1:37:46.73,1:37:49.56,Default,,0,0,0,,Джианның ата-бабалары Кураями тайпасынан емес пе?
Dialogue: 0,1:37:49.96,1:37:51.23,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,1:37:51.86,1:37:53.26,Default,,0,0,0,,Ол соншалықты керемет пианист болса да—
Dialogue: 0,1:37:53.70,1:37:55.16,Default,,0,0,0,,Ах-ах-ах
Dialogue: 0,1:37:55.26,1:37:57.60,Default,,0,0,0,,Олай болса, Кукуру, сау бол.
Dialogue: 0,1:37:57.83,1:37:59.63,Default,,0,0,0,,Нобита-сан да (Нобита) Иә.
Dialogue: 0,1:38:02.16,1:38:03.93,Default,,0,0,0,,Кәне, бәріміз үйге қайтайық.
Dialogue: 0,1:38:04.53,1:38:06.66,Default,,0,0,0,,Нобита-кун, кешіріңіз...
Dialogue: 0,1:38:06.76,1:38:09.33,Default,,0,0,0,,Біз сол жануарларға қамқор боламыз.
Dialogue: 0,1:38:09.63,1:38:12.23,Default,,0,0,0,,Иә, неге?
Dialogue: 0,1:38:12.33,1:38:14.40,Default,,0,0,0,,Дорэмон, бірдеңе істе.
Dialogue: 0,1:38:14.66,1:38:19.20,Default,,0,0,0,,Нобита-кун, Пегас 20 ғасырда өмір сүре алмайды.
Dialogue: 0,1:38:19.53,1:38:23.53,Default,,0,0,0,,Уайымдама, мен сені болашақтың қиял-ғажайып сафари саябағында дұрыс тәрбиелеймін.
Dialogue: 0,1:38:23.66,1:38:24.20,Default,,0,0,0,,Пега!
Dialogue: 0,1:38:24.86,1:38:26.60,Default,,0,0,0,,Гри Драко
Dialogue: 0,1:38:27.90,1:38:30.60,Default,,0,0,0,,Нобита-кун, мен сені кез келген уақытта кездестіре аламын.
Dialogue: 0,1:38:30.73,1:38:32.73,Default,,0,0,0,,Мен сені көруге келетініме сенімдімін.
Dialogue: 0,1:38:53.76,1:39:00.83,Default,,0,0,0,,♪〜
Dialogue: 0,1:40:08.26,1:40:15.26,Default,,0,0,0,,〜♪
