Dialogue: 1,0:01:32.13,0:01:35.35,STAFF 方正正准黑_GBK,,0,0,0,,Syou／ ·domi／ sieki／ ·
Dialogue: 0,0:01:35.85,0:02:09.85,STAFF 方正正准黑_GBK,,0,0,0,Banner;7;0;60,，，，，，， sub.kamigami.org  @
Dialogue: 0,0:01:30.41,0:01:33.45,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бүгін көңілді жексенбі
Dialogue: 0,0:01:33.88,0:01:36.74,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Түскі ас қорапшасын жасайық
Dialogue: 0,0:01:37.21,0:01:39.65,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Дашимаки жұмыртқасын жасаңыз
Dialogue: 0,0:01:39.72,0:01:40.68,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жасаңыз
Dialogue: 0,0:01:40.72,0:01:43.48,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жұмыртқаны араластырыңыз
Dialogue: 0,0:01:43.62,0:01:46.93,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Араластыру, араластыру, араластыру, араластыру.
Dialogue: 0,0:01:47.25,0:01:50.42,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Майды мұқият жағыңыз
Dialogue: 0,0:01:50.53,0:01:53.42,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Төрт бұрышты да тексеріңіз.
Dialogue: 0,0:01:53.56,0:01:56.52,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ыстық қазандағы жұмыртқалар
Dialogue: 0,0:01:57.24,0:01:58.80,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Артқыдан алдыңғыға
Dialogue: 0,0:01:58.88,0:02:00.80,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Оны айналдыру Оны айналдыру
Dialogue: 0,0:02:00.86,0:02:02.56,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Оны айналдыру Оны айналдыру
Dialogue: 0,0:02:02.64,0:02:05.98,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Майды қайтадан қосыңыз
Dialogue: 0,0:02:06.12,0:02:07.57,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Sode Soide
Dialogue: 0,0:02:07.66,0:02:10.73,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жұмыртқаны қайтадан құйыңыз
Dialogue: 0,0:02:11.08,0:02:14.65,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Артқы жағынан алға қарай домалату және айналдыру.
Dialogue: 0,0:02:14.70,0:02:16.40,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Домалау және айналдыру
Dialogue: 0,0:02:18.92,0:02:20.17,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Орындалды
Dialogue: 0,0:02:28.57,0:02:29.84,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Дәмді көрінеді
Dialogue: 0,0:02:30.26,0:02:32.30,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл шынымен дәмді болады деп үміттенемін.
Dialogue: 0,0:02:32.42,0:02:35.56,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жарайды, Сакура қатты жұмыс істеді.
Dialogue: 0,0:02:35.66,0:02:37.26,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бала да бақытты болады
Dialogue: 0,0:02:37.66,0:02:39.34,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ауа райы да жақсы көрінеді.
Dialogue: 0,0:02:39.69,0:02:41.21,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Кездесуге қолайлы күн.
Dialogue: 0,0:02:41.28,0:02:42.76,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Күні?
Dialogue: 0,0:02:42.94,0:02:43.89,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл күн.
Dialogue: 0,0:02:44.50,0:02:46.76,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Е...мм...бұл...
Dialogue: 0,0:02:46.94,0:02:49.41,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл кездесуден басқа ештеңе емес.
Dialogue: 0,0:02:49.50,0:02:51.57,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Біз бірге шығамыз.
Dialogue: 0,0:02:55.17,0:02:59.90,TEXT-JP A-OTF Folk Pro B,,0,0,0,,К.Керо-чан мен Юкито-сан бөлек жәшіктерге бөлінген.
Dialogue: 0,0:03:00.12,0:03:02.09,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Рахмет.
Dialogue: 0,0:03:02.54,0:03:05.06,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Юкитоның үйінде жақсы көмекші болыңыз.
Dialogue: 0,0:03:05.34,0:03:06.76,TEXT-JP A-OTF Folk Pro B,,0,0,0,,...
Dialogue: 0,0:03:06.98,0:03:11.06,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жарайды ма? Тек Керо-чан тазалауға көмектеседі.
Dialogue: 0,0:03:12.06,0:03:13.02,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:03:13.33,0:03:15.64,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ойнап, маған кедергі жасама.
Dialogue: 0,0:03:16.29,0:03:17.34,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сехенва
Dialogue: 0,0:03:17.85,0:03:21.94,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Тазалауға көмектесетін мөрленген жануар жоқ.
Dialogue: 0,0:03:22.77,0:03:27.14,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен Керо-чаннан басқа мөрленген аңдарды білмеймін, сондықтан білмеймін.
Dialogue: 0,0:03:27.22,0:03:28.40,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сора Соя
Dialogue: 0,0:03:34.74,0:03:35.64,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Орындалды
Dialogue: 0,0:03:36.00,0:03:37.44,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жарайсың Сакура
Dialogue: 0,0:03:37.49,0:03:38.92,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Уақыт тамаша.
Dialogue: 0,0:03:39.18,0:03:40.80,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:03:42.70,0:03:43.56,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:03:49.54,0:03:51.02,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Тамақ жеу жақсы емес.
Dialogue: 0,0:03:56.05,0:03:57.92,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Кешіріңіз, бұл Киномото.
Dialogue: 0,0:03:59.05,0:04:01.29,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Біреу тістеп алайын деп жатыр ма?
Dialogue: 0,0:04:01.52,0:04:02.78,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жоқ...мм...
Dialogue: 0,0:04:03.68,0:04:05.00,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сіз Сономисыз ба?
Dialogue: 0,0:04:05.22,0:04:08.01,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә Сәлем, қазір жақсысың ба?
Dialogue: 0,0:04:08.30,0:04:09.74,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бет астында ғаламдық державалар қатал ақпараттық соғыстар жүргізетін дәуірде
Dialogue: 0,0:04:11.34,0:04:15.21,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Білесіз бе...шынында, маған бүгін күтпеген жерден қоңырау шалды...
Dialogue: 0,0:04:15.73,0:04:18.90,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Нуки-аши, Саши-аши, Шино-аши
Dialogue: 0,0:04:19.62,0:04:21.40,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә, бүгін?
Dialogue: 0,0:04:24.46,0:04:25.22,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ата?
Dialogue: 0,0:04:25.52,0:04:29.92,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ол менің анамның атасы, демек ол менің арғы атам.
Dialogue: 0,0:04:31.30,0:04:33.53,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бүгін саған бір нәрсе бергім келеді.
Dialogue: 0,0:04:34.01,0:04:37.00,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Маған жаңа ғана Томойо-чанның анасы қоңырау шалды.
Dialogue: 0,0:04:37.57,0:04:38.28,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бүгін?
Dialogue: 0,0:04:38.78,0:04:40.98,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ертең менің шетелде жұмысым бар.
Dialogue: 0,0:04:41.33,0:04:44.73,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен қайтып келгенше айлар өтеді.
Dialogue: 0,0:04:45.18,0:04:46.21,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ал, бері қарай! Жарыл енді!
Dialogue: 0,0:04:47.05,0:04:48.81,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен саған уәде бердім...
Dialogue: 0,0:04:51.57,0:04:52.68,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:53.16,0:04:55.08,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жоқ, бұл маңызды нәрсе болуы керек.
Dialogue: 0,0:04:55.57,0:04:56.28,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:04:57.06,0:04:58.61,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:05:03.09,0:05:05.12,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл Томойо-чан.
Dialogue: 0,0:05:06.40,0:05:07.93,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл да Дайдоджи храмынан.
Dialogue: 0,0:05:19.52,0:05:20.38,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл үлкен.
Dialogue: 0,0:05:21.38,0:05:21.80,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:05:23.08,0:05:24.17,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Менің ойымша, бұл жерде бәрі жақсы.
Dialogue: 0,0:05:25.05,0:05:25.50,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:05:26.66,0:05:29.18,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Есік қоңырауы қайда?
Dialogue: 0,0:05:32.53,0:05:33.46,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:05:34.08,0:05:35.56,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Киномото: Сакура-сама, солай ма?
Dialogue: 0,0:05:36.14,0:05:37.10,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:05:37.80,0:05:38.96,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Хе-хе-хе
Dialogue: 0,0:05:44.13,0:05:45.06,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен сен демалыс үйін сатып аламыз дедің деп анық естідім.
Dialogue: 0,0:05:53.78,0:05:55.90,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сяоран-кун, сен оған үйреніп қалғансың.
Dialogue: 0,0:05:56.38,0:05:57.45,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Олай емес.
Dialogue: 0,0:05:57.78,0:05:58.53,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:05:58.94,0:06:01.98,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Түсіндім, Сяоран, сенің де күзетшің бар.
Dialogue: 0,0:06:02.80,0:06:05.24,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жоқ, мен отбасы сияқтымын.
Dialogue: 0,0:06:26.22,0:06:27.10,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сәлем
Dialogue: 0,0:06:27.86,0:06:29.16,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:06:29.48,0:06:31.54,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бүгін кенеттен өзгергенім үшін кешірім сұраймын.
Dialogue: 0,0:06:31.88,0:06:32.34,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жоқ
Dialogue: 0,0:06:32.80,0:06:36.54,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ертең бос емес шетелге кетсем болады ма?
Dialogue: 0,0:06:36.84,0:06:39.85,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен сізге бір нәрсе бергім келеді.
Dialogue: 0,0:06:40.02,0:06:40.74,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Маған?
Dialogue: 0,0:06:41.38,0:06:44.25,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұған дейін мені таныстыра аласыз ба?
Dialogue: 0,0:06:44.78,0:06:45.52,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә.
Dialogue: 0,0:06:46.85,0:06:52.44,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ли, бұл Сяоран. Ол менімен бір орта мектепте оқыды, біз бір сыныпта оқыдық.
Dialogue: 0,0:06:52.76,0:06:54.96,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сынып менің қасымда...
Dialogue: 0,0:06:56.53,0:06:57.66,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Менің...
Dialogue: 0,0:07:00.33,0:07:01.41,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ли, мен Сяоранмын.
Dialogue: 0,0:07:02.14,0:07:03.41,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мені шақырғаныңызға рахмет.
Dialogue: 0,0:07:04.74,0:07:09.88,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл Ли мырза. Бүгін жоспарларыңызды кенеттен өзгерткенім үшін кешіріңіз.
Dialogue: 0,0:07:10.70,0:07:11.78,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:07:12.16,0:07:14.93,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен сіздің шығуды жоспарлап жатқаныңызды естідім.
Dialogue: 0,0:07:15.02,0:07:16.84,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә, солай...
Dialogue: 0,0:07:20.98,0:07:22.30,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакура-чан?
Dialogue: 0,0:07:22.40,0:07:22.97,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:07:23.18,0:07:24.88,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл дәмді көрінеді
Dialogue: 0,0:07:25.50,0:07:28.64,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірақ менің ойымша, жоспар екеуміз бірге тамақтанамыз.
Dialogue: 0,0:07:28.82,0:07:31.18,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Барлығы бірге тамақтанса дәмді болады.
Dialogue: 0,0:07:31.90,0:07:33.34,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл сізге де ұнаса
Dialogue: 0,0:07:35.92,0:07:37.50,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл да керемет.
Dialogue: 0,0:07:38.04,0:07:40.30,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сяоран жақсы аспаз.
Dialogue: 0,0:07:40.96,0:07:42.14,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жоқ, бұл дұрыс емес...
Dialogue: 0,0:07:42.41,0:07:43.14,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:07:43.49,0:07:46.04,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жоқ, бұл гарнир жақсырақ көрінеді.
Dialogue: 0,0:07:46.33,0:07:49.46,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл дұрыс емес, ол тәттілер дәмдірек.
Dialogue: 0,0:07:49.52,0:07:50.30,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жоқ, солай.
Dialogue: 0,0:07:50.48,0:07:51.28,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Міне.
Dialogue: 0,0:07:52.48,0:07:55.08,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Екеуі де дәмді.
Dialogue: 0,0:07:57.30,0:08:01.73,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл екеуміздің де ұсыныстарымыз. Оны бірден алайық.
Dialogue: 0,0:08:07.09,0:08:09.16,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл шай дәмді.
Dialogue: 0,0:08:09.44,0:08:11.73,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен оны соңғы іссапарымда сатып алдым.
Dialogue: 0,0:08:12.22,0:08:14.60,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Томойо саған ұнайтын шығар деп ойладым.
Dialogue: 0,0:08:14.92,0:08:16.33,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Рахмет
Dialogue: 0,0:08:18.28,0:08:22.14,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакура-чан мен басқалары атасын кездестірді ме?
Dialogue: 0,0:08:22.52,0:08:26.61,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл рас шығар, өйткені бұл шынында да қарт адам үшін тосын.
Dialogue: 0,0:08:27.14,0:08:30.05,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сіз маған бір нәрсе бергіңіз келді.
Dialogue: 0,0:08:30.48,0:08:30.97,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:08:31.52,0:08:33.84,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірақ Ли неге сенімен бірге?
Dialogue: 0,0:08:34.18,0:08:38.81,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Дұрыс, Сакура-чан мен оның досы бірге шығады.
Dialogue: 0,0:08:39.36,0:08:41.28,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Оның қандай бала екенін көргің келеді.
Dialogue: 0,0:08:42.09,0:08:43.32,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,0:08:43.86,0:08:48.42,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірақ мен Лидің Шинки атаның көзілдірігіне сәйкес келетініне сенімдімін.
Dialogue: 0,0:08:51.48,0:08:52.56,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:08:52.62,0:08:54.28,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл өте дәмді болды.
Dialogue: 0,0:09:00.93,0:09:01.62,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ой
Dialogue: 0,0:09:03.37,0:09:05.12,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен оны аламын ба?
Dialogue: 0,0:09:05.52,0:09:06.89,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен сізге бір жақсылық сұрасам болады ма?
Dialogue: 0,0:09:07.08,0:09:09.17,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә, иә...
Dialogue: 0,0:09:09.94,0:09:11.64,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен сонда баруым керек пе?
Dialogue: 0,0:09:12.13,0:09:15.84,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Аа, іштегі адамға қоңырау шалыңыз, сонда бәрі жақсы болады.
Dialogue: 0,0:09:16.29,0:09:19.96,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жаңа шай сұрай аласыз ба?
Dialogue: 0,0:09:20.30,0:09:21.25,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Түсінікті
Dialogue: 0,0:09:22.38,0:09:23.18,TEXT-JP A-OTF Folk Pro B,,0,0,0,,I'm going
Dialogue: 0,0:09:37.82,0:09:40.84,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Екеуміз ғана болғанда мен қобалжыймын.
Dialogue: 0,0:09:41.14,0:09:42.64,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Қандай кездейсоқ кездесу, Хиёри
Dialogue: 0,0:09:42.78,0:09:44.37,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жоқ, жоқ, бұл.
Dialogue: 0,0:09:45.18,0:09:48.36,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сіз менімен біраз уақыт сөйлесе аласыз ба?
Dialogue: 0,0:09:49.28,0:09:50.41,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Егер маған бәрібір
Dialogue: 0,0:09:51.08,0:09:51.78,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Рахмет
Dialogue: 0,0:09:52.54,0:09:55.78,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакура-чан мектепте қалай?
Dialogue: 0,0:09:56.36,0:10:00.26,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен жақсымын, әрқашан күлімдеп, көңілді жүргендей көрінемін.
Dialogue: 0,0:10:00.57,0:10:03.89,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Қарап тұрудың өзі баршаны қуантады
Dialogue: 0,0:10:05.30,0:10:06.57,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:11.72,0:10:15.69,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакура-чанның анасы да сондай болған.
Dialogue: 0,0:10:18.28,0:10:20.45,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Атасы Ата
Dialogue: 0,0:10:21.46,0:10:22.64,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Қараңдаршы, кемпірқосақ
Dialogue: 0,0:10:24.97,0:10:27.78,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Әрқашан күлімдеп, бақытты көріну
Dialogue: 0,0:10:28.61,0:10:32.33,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сол балаға қарап барлығы бақытты сезінді.
Dialogue: 0,0:10:33.58,0:10:38.20,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Алайда ол Сакура-чан сияқты спортшы емес еді.
Dialogue: 0,0:10:43.36,0:10:44.24,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Надешико
Dialogue: 0,0:10:45.17,0:10:45.82,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:10:46.36,0:10:46.90,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:10:47.68,0:10:49.88,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Қараңдаршы, мен гүлдерді жойған жоқпын.
Dialogue: 0,0:10:55.10,0:10:57.05,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ол мейірімді бала еді.
Dialogue: 0,0:11:02.37,0:11:07.18,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірақ мен сол мейірімді баланы мұңайттым.
Dialogue: 0,0:11:11.76,0:11:13.01,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Шешімді болыңыз
Dialogue: 0,0:11:13.62,0:11:18.53,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сол бала ең бақытты болуы керек кезде тойлай алмадым.
Dialogue: 0,0:11:19.50,0:11:22.72,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сол бала кешірім сұрай алмай дүниеден өтті.
Dialogue: 0,0:11:26.97,0:11:29.80,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірақ мен Сакура-чанмен кездесе алдым.
Dialogue: 0,0:11:31.62,0:11:36.72,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакура-чан арқылы мен сол қызды қайта кездестіргендей болдым.
Dialogue: 0,0:11:37.64,0:11:43.56,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ұзақ уақыт бойы жақындай алмаған сүйген адамыммен сөйлесудің сәті түсті.
Dialogue: 0,0:11:45.18,0:11:49.06,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мүмкін ештеңе білмейтін адам ештеңе айтпауы керек.
Dialogue: 0,0:11:50.50,0:11:53.16,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Немерелеріңіз де бақытты болады деп ойлаймын.
Dialogue: 0,0:11:54.25,0:11:56.33,TEXT-JP A-OTF Folk Pro B,,0,0,0,,жақсы болар еді, бірақ...
Dialogue: 0,0:11:57.08,0:11:57.54,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,0:12:03.54,0:12:06.62,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Надешико мен Сакура-чан
Dialogue: 0,0:12:07.62,0:12:09.78,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сүйкімді баланы ұрлау
Dialogue: 0,0:12:09.86,0:12:13.68,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Неліктен жеккөрініштірек емес?
Dialogue: 0,0:12:15.41,0:12:17.25,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Кешіріңіз, не...
Dialogue: 0,0:12:18.02,0:12:22.04,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Дүние сол қалпында қалады дедім.
Dialogue: 0,0:12:27.94,0:12:29.50,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:12:31.64,0:12:33.00,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Юкиусагидің толық емес жұмыс күні туралы не деуге болады?
Dialogue: 0,0:12:33.37,0:12:34.24,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бүгін демалыс күні.
Dialogue: 0,0:12:34.69,0:12:36.53,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Момоя құбыжықтар арасында.
Dialogue: 0,0:12:38.17,0:12:39.89,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл қиын жұмыс.
Dialogue: 0,0:12:40.16,0:12:42.73,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен оқу ақысын өзім басқарғым келеді.
Dialogue: 0,0:12:43.13,0:12:46.12,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сондай-ақ, мүмкін болса, Сакура-чан жоғары оқу орындарына түседі.
Dialogue: 0,0:12:46.36,0:12:48.82,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Егер сіз басқа бірдеңе жасай алсаңыз, мен сізге көмектескім келеді.
Dialogue: 0,0:12:49.34,0:12:51.48,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Шынында да, бұл Энни Чан.
Dialogue: 0,0:12:52.49,0:12:53.69,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Кешіріңіз, бірақ
Dialogue: 0,0:12:53.98,0:12:56.86,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ол қазірдің өзінде қатты Cisco.
Dialogue: 0,0:12:59.52,0:13:01.61,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Үшеуі де дәл бірдей жағдайда қаза тапты.
Dialogue: 0,0:13:08.36,0:13:10.97,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен ештеңе істей алмайтынымды білемін, бірақ
Dialogue: 0,0:13:11.88,0:13:15.24,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сонда да мен Сакура-чанға және басқаларға қолымнан келгеннің бәрін жасай аламын.
Dialogue: 0,0:13:16.01,0:13:18.80,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә, менің басқа қызметшіме айтыңызшы.
Dialogue: 0,0:13:19.62,0:13:20.22,TEXT-JP A-OTF Folk Pro B,,0,0,0,,О
Dialogue: 0,0:13:33.28,0:13:36.05,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Айтсам да тыңдар едің.
Dialogue: 0,0:13:36.44,0:13:36.84,TEXT-JP A-OTF Folk Pro B,,0,0,0,,О
Dialogue: 0,0:13:37.69,0:13:40.16,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен Момоя-ни-чанның күштері қайтып келгенін көріп тұрмын.
Dialogue: 0,0:13:40.52,0:13:42.08,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Оның өзі осылай деді.
Dialogue: 0,0:13:42.77,0:13:43.46,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Және...
Dialogue: 0,0:13:53.14,0:13:57.20,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сондай-ақ, Сакураның күші соншалықты күшті, бұл сөз тіркесі емес.
Dialogue: 0,0:13:57.66,0:13:59.17,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Менің ойымша, бұл байланыссыз.
Dialogue: 0,0:14:00.76,0:14:01.88,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Англиямен байланыс туралы не айтасыз?
Dialogue: 0,0:14:02.34,0:14:03.81,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:14:05.66,0:14:06.77,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Міне келді
Dialogue: 0,0:14:07.98,0:14:08.73,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:30.88,0:14:31.85,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:35.28,0:14:36.40,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:38.40,0:14:40.60,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Біреу... шай...
Dialogue: 0,0:15:06.89,0:15:07.96,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жақсы ма деп ойлаймын...
Dialogue: 0,0:15:10.08,0:15:11.93,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Осы орынды енгізіңіз...
Dialogue: 0,0:15:45.98,0:15:46.68,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мұнда...
Dialogue: 0,0:15:51.85,0:15:52.82,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен түсіндім...
Dialogue: 0,0:16:00.97,0:16:03.02,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл менің анамның бөлмесі болатын.
Dialogue: 0,0:16:41.30,0:16:42.01,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Шығару
Dialogue: 0,0:16:46.65,0:16:48.86,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Осы жер туралы өткен естеліктерді еске түсіру
Dialogue: 0,0:16:52.69,0:16:53.40,TEXT-JP A-OTF Folk Pro B,,0,0,0,,ЖАЗУ
Dialogue: 0,0:18:12.85,0:18:13.69,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:18:16.48,0:18:17.93,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Артық емес
Dialogue: 0,0:18:26.78,0:18:30.14,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Енді жоқ... Мен орала алмаймын...
Dialogue: 0,0:18:56.38,0:18:57.88,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сол арман тағы да...
Dialogue: 0,0:19:04.00,0:19:05.93,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен білемін
Dialogue: 0,0:19:22.50,0:19:23.26,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен білемін
Dialogue: 0,0:19:25.20,0:19:26.77,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен сені білемін
Dialogue: 0,0:19:28.24,0:19:29.44,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен білемін...
Dialogue: 0,0:19:30.72,0:19:31.29,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакура
Dialogue: 0,0:19:36.58,0:19:37.82,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:19:38.50,0:19:39.61,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Не болды?
Dialogue: 0,0:19:40.32,0:19:41.64,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Өзіңізді нашар сезінесіз бе?
Dialogue: 0,0:19:43.97,0:19:45.58,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:19:46.62,0:19:49.66,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен сағат дыбысын естідім... Қап-қара болды...
Dialogue: 0,0:19:50.76,0:19:52.77,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Қараңғыда... сонда...
Dialogue: 0,0:19:54.01,0:19:56.17,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сол жерде шапан киген бала тұрды.
Dialogue: 0,0:19:57.44,0:19:58.37,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сол халат...
Dialogue: 0,0:20:01.18,0:20:03.40,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә, бұл отбасынан өткен салтанатты киім...
Dialogue: 0,0:20:04.82,0:20:06.32,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл менің шапаным еді.
Dialogue: 0,0:20:09.68,0:20:12.05,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Өтінемін, демалыңыз.
Dialogue: 0,0:20:12.68,0:20:13.21,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірақ...
Dialogue: 0,0:20:15.45,0:20:15.93,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ум...
Dialogue: 0,0:20:26.10,0:20:26.65,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ум...
Dialogue: 0,0:20:28.22,0:20:31.06,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Уайымдама, мен сенің жаныңда боламын.
Dialogue: 0,0:20:32.70,0:20:33.34,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сонымен...
Dialogue: 0,0:20:37.21,0:20:38.17,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:20:42.56,0:20:44.26,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакура-чан, жақсысың ба?
Dialogue: 0,0:20:44.54,0:20:46.49,TEXT-JP A-OTF Folk Pro B,,0,0,0,,I Неге...
Dialogue: 0,0:20:47.08,0:20:51.21,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ол біраз уақыт қайтып келмеді, мен оны Ли мырзамен бірге іздеуге келдім.
Dialogue: 0,0:20:53.06,0:20:53.56,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Дәрігер
Dialogue: 0,0:20:54.28,0:20:54.86,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірден
Dialogue: 0,0:20:55.29,0:20:58.65,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жарайды, аздап басым айналып кетті.
Dialogue: 0,0:20:58.82,0:20:59.58,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:20:59.98,0:21:01.58,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Өте жақсы.
Dialogue: 0,0:21:02.93,0:21:03.80,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жарайды...
Dialogue: 0,0:21:14.69,0:21:16.56,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ол синхрондауды бастады.
Dialogue: 0,0:21:17.12,0:21:17.76,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Иә
Dialogue: 0,0:21:18.24,0:21:20.62,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сіз картаны жасаушы сияқты армандаған шығарсыз.
Dialogue: 0,0:21:21.16,0:21:22.48,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Кітаптың ішінде не бар?
Dialogue: 0,0:21:22.96,0:21:23.85,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Прогресс
Dialogue: 0,0:21:24.82,0:21:27.53,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Арманның күші күшейеді
Dialogue: 0,0:21:28.41,0:21:30.12,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Жоспарланған уақыттан ерте емес пе?
Dialogue: 0,0:21:30.64,0:21:32.33,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ешқашан кеш емес
Dialogue: 0,0:21:33.29,0:21:33.88,TEXT-JP A-OTF Folk Pro B,,0,0,0,,көрінгендей, шамамен 36 дана шығады.
Dialogue: 0,0:21:34.97,0:21:39.33,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сол жақтағы қамқоршы байқап қалып, қозғала бастады.
Dialogue: 0,0:21:51.66,0:21:54.49,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Біраз уақыт өтті, Кербер Ай
Dialogue: 0,0:21:54.96,0:21:57.97,TEXT-JP A-OTF Folk Pro B,,0,0,0,,А, бұл сіз жауап бермегеніңіз үшін.
Dialogue: 0,0:21:58.26,0:21:59.04,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:21:59.54,0:22:02.21,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен бұған қатты ашуланбаймын.
Dialogue: 0,0:22:03.73,0:22:05.02,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен толық түсінемін.
Dialogue: 0,0:22:05.82,0:22:07.52,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Әсіресе, айдың бетіне қарасаң
Dialogue: 0,0:22:08.16,0:22:11.97,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сонымен, сіз маған сиқырлы шеңбердің бейнесін жіберіп, мені қиындыққа шақырдыңыз ...
Dialogue: 0,0:22:12.30,0:22:14.60,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сіз сөйлесуге дайынсыз ба?
Dialogue: 0,0:22:15.49,0:22:15.94,TEXT-JP A-OTF Folk Pro B,,0,0,0,,О
Dialogue: 0,0:22:16.60,0:22:18.30,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Олай болса, бәрін түсіндіріңіз.
Dialogue: 0,0:22:18.85,0:22:21.60,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Раббыма не болып жатыр?
Dialogue: 0,0:22:26.38,0:22:28.44,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен ең қорқатын нәрсе...
Dialogue: 0,0:22:29.01,0:22:30.44,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Шындыққа айналу
Dialogue: 0,0:24:10.36,0:24:12.45,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Коньянячиха
Dialogue: 0,0:24:13.20,0:24:15.81,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Солай бола тұрса да, бұл жол ұзақ жолдан өтті.
Dialogue: 0,0:24:15.85,0:24:16.96,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Оны Керо-чан бұрышына қалдырыңыз
Dialogue: 0,0:24:17.06,0:24:20.66,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл жолы мен үлкен атамның вилласында жеген бенто мен тәттілермен таныстырғым келеді.
Dialogue: 0,0:24:20.74,0:24:23.13,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Біріншіден, мен Юки Усагимен бірге жеген Сакураның бентосы.
Dialogue: 0,0:24:23.24,0:24:25.13,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Тамагояки керемет, өйткені мен оны үнемі жаттығатынмын.
Dialogue: 0,0:24:25.20,0:24:27.17,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Қуырылған тауық еті, тартылған ет котлеті, сірке суы қосылған қуырылған көкөністер
Dialogue: 0,0:24:27.22,0:24:28.97,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Тамақтану балансы да жақсы ойластырылған.
Dialogue: 0,0:24:29.10,0:24:31.48,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ал, келесі жолы баланың тәттілерін жеп көріңіз.
Dialogue: 0,0:24:31.61,0:24:33.48,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Ата, біраз уақыт өтті, бірақ сіздің жағдайыңыз жақсы сияқты.
Dialogue: 0,0:24:33.57,0:24:35.33,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бірақ сізде үлкен вилла бар, сізде қанша болады?
Dialogue: 0,0:24:35.40,0:24:38.05,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Мен жазғы демалыс орнындағы виллада тропикалық сусын ішкім келеді.
Dialogue: 0,0:24:38.21,0:24:39.77,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Хонана
Dialogue: 0,0:24:40.57,0:24:43.81,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Маған арғы атамның вилласынан ат мінгізді.
Dialogue: 0,0:24:43.98,0:24:46.21,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Үйге келгенде мен біртүрлі нәрсені сезіндім...
Dialogue: 0,0:24:46.85,0:24:48.32,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Бұл да картаның жұмысы болуы мүмкін.
Dialogue: 0,0:24:48.86,0:24:51.77,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Келесі жолы Сакура, айна және естеліктердің кілті
Dialogue: 0,0:24:52.24,0:24:53.32,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Сакурамен
Dialogue: 0,0:24:53.57,0:24:54.78,TEXT-JP A-OTF Folk Pro B,,0,0,0,,Шығару
Dialogue: 0,0:24:56.28,0:25:02.28,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
