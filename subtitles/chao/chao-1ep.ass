Dialogue: 0,1:28:18.87,1:28:24.50,Default,,0,0,0,,♪ Уәде етілген сақинаны ұмытпаңыз
Dialogue: 0,1:28:24.59,1:28:27.26,Default,,0,0,0,,♪ Екіге арналған уақыт
Dialogue: 0,1:28:27.34,1:28:28.76,Default,,0,0,0,,♪ Хум ла ла ла...
Dialogue: 0,1:28:28.84,1:28:34.55,Default,,0,0,0,,♪ Ғажайып сәуле түсетін күндер
Dialogue: 0,1:28:35.39,1:28:39.81,Default,,0,0,0,,♪ Күлкіге толы
Dialogue: 0,1:28:41.10,1:28:46.86,Default,,0,0,0,,♪ Уәде етілген сақинаны ұмытпаңыз
Dialogue: 0,1:28:46.94,1:28:49.57,Default,,0,0,0,,♪ Екіге арналған уақыт
Dialogue: 0,1:28:49.65,1:28:52.28,Default,,0,0,0,,♪ ЛаЛаЛа хум ЛаЛаЛа
Dialogue: 0,1:28:52.36,1:28:54.87,Default,,0,0,0,,♪ Қолдарыңызды көтеріңіз! Сол қолдармен байланысты күндер
Dialogue: 0,1:28:54.95,1:28:57.70,Default,,0,0,0,,♪ Жаңа күлкіні кездестіру үшін
Dialogue: 0,1:28:57.79,1:29:00.46,Default,,0,0,0,,♪ Оян! Оянған махаббаттың соғуы
Dialogue: 0,1:29:00.54,1:29:03.46,Default,,0,0,0,,♪ Екеумізге нұр жауды
Dialogue: 0,1:29:03.54,1:29:06.00,Default,,0,0,0,,♪ Қолдарыңызды көтеріңіз! Сол қолдармен байланысты күндер
