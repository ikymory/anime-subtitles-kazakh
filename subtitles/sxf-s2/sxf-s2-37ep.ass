Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.96,Default,,0,0,0,,Бет астында ғаламдық державалар қатал ақпараттық соғыстар жүргізетін дәуірде
Dialogue: 0,0:00:07.26,0:00:09.02,Default,,0,0,0,,Екі мемлекет бетпе-бет келген
Dialogue: 0,0:00:09.02,0:00:10.61,Default,,0,0,0,,Шығыс Остания
Dialogue: 0,0:00:10.61,0:00:12.03,Default,,0,0,0,,Батыс Весталис
Dialogue: 0,0:00:13.06,0:00:17.08,Default,,0,0,0,,Соғысты жоспарлап отырған Остания үкіметінің қайраткерлерінің қозғалыстарын анықтау.
Dialogue: 0,0:00:17.30,0:00:20.73,Default,,0,0,0,,Весталис «Стракс» операциясын іске қосады
Dialogue: 0,0:00:21.54,0:00:24.34,Default,,0,0,0,,Сумерк, операцияларға жауапты дарынды агент
Dialogue: 0,0:00:24.87,0:00:27.77,Default,,0,0,0,,Оның миссиясы 100 түрлі жүзді пайдалану.
Dialogue: 0,0:00:28.08,0:00:30.04,Default,,0,0,0,,отбасы құру
Dialogue: 0,0:00:30.98,0:00:32.86,Default,,0,0,0,,Әкесі Ллойд Форгер
Dialogue: 0,0:00:32.86,0:00:34.03,Default,,0,0,0,,Психиатр
Dialogue: 0,0:00:34.39,0:00:36.18,Default,,0,0,0,,Шынайы кімдігі: барлаушы
Dialogue: 0,0:00:36.18,0:00:38.02,Default,,0,0,0,,Код атауы Ымырт
Dialogue: 0,0:00:38.70,0:00:40.52,Default,,0,0,0,,Ана Йол Жасампаз
Dialogue: 0,0:00:40.52,0:00:41.65,Default,,0,0,0,,Қалалық әкімдік қызметкерлері
Dialogue: 0,0:00:42.16,0:00:44.17,Default,,0,0,0,,Шынайы кімдігі: жалдамалы кісі өлтіруші
Dialogue: 0,0:00:44.17,0:00:45.94,Default,,0,0,0,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:00:49.09,0:00:52.32,Default,,0,0,0,,Шынайы тұлға: ақыл-ойды оқи алатын психика
Dialogue: 0,0:00:53.18,0:00:54.91,Default,,0,0,0,,Dog Bond Forger
Dialogue: 0,0:00:55.36,0:00:58.72,Default,,0,0,0,,Шынайы сәйкестік: Болашақты болжай алатын психикалық ит
Dialogue: 0,0:00:59.74,0:01:02.56,Default,,0,0,0,,Өз пайдаңыз үшін жалған отбасын жасаңыз
Dialogue: 0,0:01:02.56,0:01:07.04,Default,,0,0,0,,Олардың миссиясы жалғасуда, өйткені олар өздерінің жеке басын бір-бірінен жасырады.
Dialogue: 0,0:01:19.47,0:01:22.02,Default,,0,0,0,,Сұрақ қою батыл әрекет
Dialogue: 0,0:01:22.02,0:01:24.61,Default,,0,0,0,,Сұрақ Басқаларсыз өмір
Dialogue: 0,0:01:24.61,0:01:27.15,Default,,0,0,0,,Сатқындық пен бейбітшілікке сұрақ
Dialogue: 0,0:01:27.15,0:01:29.36,Default,,0,0,0,,Сұрақ не?
Dialogue: 0,0:01:29.65,0:01:31.53,Default,,0,0,0,,Дүние екіге бөлінген
Dialogue: 0,0:01:31.53,0:01:34.20,Default,,0,0,0,,Әрбір жасырын әділдік болып табылады
Dialogue: 0,0:01:34.78,0:01:36.66,Default,,0,0,0,,Гарандого қарсы тұру
Dialogue: 0,0:01:36.66,0:01:38.41,Default,,0,0,0,,Үйілген және қабаттастырылған
Dialogue: 0,0:01:38.41,0:01:39.91,Default,,0,0,0,,Екі жақты екі бет
Dialogue: 0,0:01:40.79,0:01:42.83,Default,,0,0,0,,Парасаттылық, төмендік және сахна артындағы
Dialogue: 0,0:01:43.33,0:01:45.04,Default,,0,0,0,,Мұның соңы немесе ақыры маңызды емес.
Dialogue: 0,0:01:45.92,0:01:47.21,Default,,0,0,0,,Дәл уақыт өте стандарт болып табылады
Dialogue: 0,0:01:47.21,0:01:49.05,Default,,0,0,0,,Мен бұл туралы бірдеңе жасадым.
Dialogue: 0,0:01:49.05,0:01:53.34,Default,,0,0,0,,Crazy әңгіме, бәрі әлдеқашан шешілген сияқты
Dialogue: 0,0:01:53.34,0:01:56.05,Default,,0,0,0,,Ерекшеліксіз қалыптан тыс жағдай
Dialogue: 0,0:01:56.05,0:01:58.72,Default,,0,0,0,,Әдетте ешқандай себепсіз
Dialogue: 0,0:01:59.56,0:02:02.06,Default,,0,0,0,,Дұрыс пен бұрыс тұрақсыз
Dialogue: 0,0:02:02.06,0:02:04.94,Default,,0,0,0,,Іштен шыққан шынайы сезімдер жинақталады
Dialogue: 0,0:02:04.94,0:02:07.23,Default,,0,0,0,,Кейде оны қорытуға мүмкіндік болмайды.
Dialogue: 0,0:02:07.23,0:02:09.73,Default,,0,0,0,,Сіз мұны байқамай қарсы аласыз ба?
Dialogue: 0,0:02:09.73,0:02:12.53,Default,,0,0,0,,Қайғылы емеспін, бірақ бәрібір осылай
Dialogue: 0,0:02:12.53,0:02:14.91,Default,,0,0,0,,Мен 100% білмеймін
Dialogue: 0,0:02:14.91,0:02:19.87,Default,,0,0,0,,Мен өз уайымымнан құтылсам екен деп тілеймін, тілеймін және мұңайдым.
Dialogue: 0,0:02:19.87,0:02:22.54,Default,,0,0,0,,Егер бұл перде желбіресе
Dialogue: 0,0:02:22.54,0:02:25.25,Default,,0,0,0,,Идеалдар мен шындық теңселеді
Dialogue: 0,0:02:27.17,0:02:29.67,Default,,0,0,0,,Сұрақ қою батыл әрекет
Dialogue: 0,0:02:29.67,0:02:32.17,Default,,0,0,0,,Сұрақ Басқаларсыз өмір
Dialogue: 0,0:02:32.17,0:02:34.84,Default,,0,0,0,,Сатқындық пен бейбітшілікке сұрақ
Dialogue: 0,0:02:34.84,0:02:36.05,Default,,0,0,0,,Сұрақ не?
Dialogue: 0,0:02:39.26,0:02:45.23,Default,,0,0,0,,Отағасы
Dialogue: 0,0:02:53.03,0:02:54.96,Default,,0,0,0,,Бонд, серуендеуге барайық.
Dialogue: 0,0:03:02.15,0:03:03.50,Default,,0,0,0,,(Норияки) Мүмкін дәрілер әсер етіп жатқан болар, бірақ қазір жағдай онша жаман емес.
Dialogue: 0,0:03:04.47,0:03:05.99,Default,,0,0,0,,Аня бармайды
Dialogue: 0,0:03:09.46,0:03:11.50,Default,,0,0,0,,Аня қазір бос емес.
Dialogue: 0,0:03:11.81,0:03:13.52,Default,,0,0,0,,Ең үлкен қиындық
Dialogue: 0,0:03:13.52,0:03:14.58,Default,,0,0,0,,Оригами
Dialogue: 0,0:03:15.38,0:03:17.53,Default,,0,0,0,,Олар мұны мектепте жасайтын көрінеді.
Dialogue: 0,0:03:21.45,0:03:23.52,Default,,0,0,0,,Сіз шынымен де шоғырланып жатырсыз.
Dialogue: 0,0:03:24.71,0:03:26.08,Default,,0,0,0,,Бұл жігіт келмесе
Dialogue: 0,0:03:26.08,0:03:28.81,Default,,0,0,0,,Бүгін жаяу жүрудің орнына жаттығуға жұмсаймыз ба?
Dialogue: 0,0:03:32.46,0:03:34.02,Default,,0,0,0,,Олай болса, мен барамын.
Dialogue: 0,0:03:34.63,0:03:37.35,Default,,0,0,0,,Қош келдіңіз, Ллойд мырза, Бонд мырза.
Dialogue: 0,0:03:54.11,0:03:54.74,Default,,0,0,0,,ӨТУ
Dialogue: 0,0:04:04.42,0:04:05.48,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:04:05.48,0:04:08.06,Default,,0,0,0,,Қарсыласыңызды қабілетсіз ету үшін қолдар мен аяқтарды көздеңіз.
Dialogue: 0,0:04:08.66,0:04:10.84,Default,,0,0,0,,Өлімге әкелетін жарақаттарды тудыруы мүмкін маңызды нүктелерді пайдаланбаңыз.
Dialogue: 0,0:04:11.24,0:04:13.39,Default,,0,0,0,,Сіз ақпаратты ала алмайсыз.
Dialogue: 0,0:04:13.79,0:04:17.82,Default,,0,0,0,,Теме, өзіңе қамқор болғаным үшін маған берген алғысыңды ұмыттың ба?
Dialogue: 0,0:04:18.02,0:04:18.65,Default,,0,0,0,,Colla
Dialogue: 0,0:04:19.06,0:04:21.17,Default,,0,0,0,,Бір рет тістеп алсаң, ешқашан жіберме
Dialogue: 0,0:04:21.51,0:04:23.33,Default,,0,0,0,,Сізге де қауіп бар.
Dialogue: 0,0:04:23.33,0:04:26.84,Default,,0,0,0,,Қайта-қайта тістеп алса, қылмыскер үшін өлімге әкелуі мүмкін.
Dialogue: 0,0:04:28.34,0:04:32.13,Default,,0,0,0,,Сіз тым мейірімдісіз, сондықтан үру мен тістеу сізге сәйкес келмейтін шығар.
Dialogue: 0,0:04:32.51,0:04:33.46,Default,,0,0,0,,Цука
Dialogue: 0,0:04:33.94,0:04:36.07,Default,,0,0,0,,Неліктен мен қылмыскердің рөлін ойнап жатырмын?
Dialogue: 0,0:04:36.07,0:04:38.31,Default,,0,0,0,,Тыңда, мен ақпарат берушімін.
Dialogue: 0,0:04:38.31,0:04:39.51,Default,,0,0,0,,Бұл жаттығу.
Dialogue: 0,0:04:39.51,0:04:40.57,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:04:40.85,0:04:42.49,Default,,0,0,0,,Мен не істей аламын?
Dialogue: 0,0:04:42.49,0:04:45.47,Default,,0,0,0,,Оны 500 немесе одан аз таңбамен айтыңыз
Dialogue: 0,0:04:45.83,0:04:48.37,Default,,0,0,0,,Жағдай ушығып барады.
Dialogue: 0,0:04:48.37,0:04:50.24,Default,,0,0,0,,Біз кез келген төтенше жағдайға дайындалуымыз керек
Dialogue: 0,0:04:50.24,0:04:51.98,Default,,0,0,0,,Бұл жауап емес.
Dialogue: 0,0:04:52.18,0:04:55.59,Default,,0,0,0,,Жарайды, басу және бақылау жаттығулары үшін жеткілікті.
Dialogue: 0,0:04:55.59,0:04:58.94,Default,,0,0,0,,Сіз иіс скринингі мен жарылғыш заттарды анықтауды үйренесіз бе?
Dialogue: 0,0:04:58.94,0:05:00.58,Default,,0,0,0,,Оны есте сақтау қиын.
Dialogue: 0,0:05:01.58,0:05:03.35,Default,,0,0,0,,Мен де солай істеймін
Dialogue: 0,0:05:03.35,0:05:05.26,Default,,0,0,0,,Бомбардир мен мұны істеймін
Dialogue: 0,0:05:07.48,0:05:08.44,Default,,0,0,0,,●
Dialogue: 0,0:05:08.44,0:05:10.50,Default,,0,0,0,,Мен шынымен зейінді жоғалттым ба?
Dialogue: 0,0:05:10.73,0:05:15.52,Default,,0,0,0,,Apple жобасы ақылды әскери иттерді зерттеу болды, солай ма?
Dialogue: 0,0:05:15.52,0:05:19.01,Default,,0,0,0,,Сіз көп жаттығулар жасаудан шаршаған болуыңыз керек.
Dialogue: 0,0:05:19.99,0:05:21.10,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:23.45,0:05:25.51,Default,,0,0,0,,Осындай нәрсені жасауға болады ма?
Dialogue: 0,0:05:25.51,0:05:27.13,Default,,0,0,0,,Қандай пайдасыз ит.
Dialogue: 0,0:05:27.49,0:05:29.25,Default,,0,0,0,,Жоба сәтсіз.
Dialogue: 0,0:05:29.25,0:05:31.55,Default,,0,0,0,,Бұл жігіттер жақын арада жойылатын шығар.
Dialogue: 0,0:05:35.21,0:05:40.09,Default,,0,0,0,,Ванкоро үшін жаттығулар мен нақты шайқастар шын мәнінде ойын сияқты.
Dialogue: 0,0:05:40.53,0:05:42.85,Default,,0,0,0,,Серіктесіңізбен көбірек көңіл көтеріңіз.
Dialogue: 0,0:05:42.85,0:05:45.53,Default,,0,0,0,,Сізге әрқашан мұндай нәрселер жетіспейді.
Dialogue: 0,0:05:45.78,0:05:48.31,Default,,0,0,0,,Қарқынды өзгерту үшін мені серуендеуге апарыңыз.
Dialogue: 0,0:05:48.78,0:05:50.75,Default,,0,0,0,,Сондықтан мен үйге бара жатырмын.
Dialogue: 0,0:05:57.70,0:05:59.05,Default,,0,0,0,,Біз серуендеуге барамыз ба?
Dialogue: 0,0:06:05.16,0:06:07.18,Default,,0,0,0,,Сіз көп нәрсе жасадыңыз.
Dialogue: 0,0:06:07.18,0:06:09.06,Default,,0,0,0,,Жұлдыздар сүйкімді
Dialogue: 0,0:06:11.49,0:06:13.60,Default,,0,0,0,,Жай жұлдыз емес
Dialogue: 0,0:06:15.74,0:06:19.32,Default,,0,0,0,,Аня Хозиер Стелланы марапаттауы
Dialogue: 0,0:06:35.98,0:06:37.56,Default,,0,0,0,,Тамақты жинамаңыз.
Dialogue: 0,0:06:45.44,0:06:47.74,Default,,0,0,0,,Менің балмұздағым
Dialogue: 0,0:06:47.74,0:06:51.14,Default,,0,0,0,,Мен әлі аздап жедім.
Dialogue: 0,0:06:52.05,0:06:53.62,Default,,0,0,0,,Дассе
Dialogue: 0,0:06:53.62,0:06:57.27,Default,,0,0,0,,Сіздің лақап атыңыз бүгіннен бастап Айс Бечао.
Dialogue: 0,0:06:57.27,0:06:58.48,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:07:08.34,0:07:12.09,Default,,0,0,0,,Екі сатылы балмұздақ - Екі сатылы балмұздақ -
Dialogue: 0,0:07:12.09,0:07:14.50,Default,,0,0,0,,Қалталы ақшасы көп адамдар қызғаншақ
Dialogue: 0,0:07:18.54,0:07:20.22,Default,,0,0,0,,Баланың тамағын қорғадыңыз ба?
Dialogue: 0,0:07:20.22,0:07:21.28,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:07:21.28,0:07:23.96,Default,,0,0,0,,Сізді қабылдауға тұрарлық еді.
Dialogue: 0,0:07:29.37,0:07:31.14,Default,,0,0,0,,Бұл не аю?
Dialogue: 0,0:07:31.48,0:07:33.81,Default,,0,0,0,,Әйтеуір, балмұздағымды көздеп отырмын
Dialogue: 0,0:07:33.81,0:07:35.23,Default,,0,0,0,,Эй Бонд, не болды?
Dialogue: 0,0:07:40.52,0:07:42.87,Default,,0,0,0,,Менің балмұздағым
Dialogue: 0,0:07:42.87,0:07:46.28,Default,,0,0,0,,Мен әлі аздап жедім.
Dialogue: 0,0:07:46.28,0:07:48.73,Default,,0,0,0,,Кешір, балам, мен түзелемін.
Dialogue: 0,0:07:53.22,0:07:55.70,Default,,0,0,0,,Үш дан Үш дан
Dialogue: 0,0:07:55.70,0:07:56.97,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:07:56.97,0:07:58.25,Default,,0,0,0,,Цюрис
Dialogue: 0,0:07:58.75,0:08:02.01,Default,,0,0,0,,Басқа адамдардың тамағына секіру тән емес.
Dialogue: 0,0:08:02.36,0:08:03.68,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:08:03.68,0:08:05.00,Default,,0,0,0,,Қарныңыз ашты ма?
Dialogue: 0,0:08:14.07,0:08:15.17,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:15.17,0:08:16.24,Default,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:08:16.24,0:08:17.56,Default,,0,0,0,,Бұл жігіт міндетті түрде есінен танып қалады
Dialogue: 0,0:08:28.78,0:08:30.53,Default,,0,0,0,,Бүгін біртүрлі екенсің.
Dialogue: 0,0:08:34.49,0:08:36.79,Default,,0,0,0,,Бұл қандай аң?
Dialogue: 0,0:08:37.08,0:08:38.13,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:39.56,0:08:41.34,Default,,0,0,0,,Менің итім кешірім сұрайды
Dialogue: 0,0:08:42.23,0:08:43.79,Default,,0,0,0,,Тәртіп жақсы емес
Dialogue: 0,0:08:44.26,0:08:47.78,Default,,0,0,0,,Танымайтын қарапайым адамды тістеу мүмкін емес.
Dialogue: 0,0:08:48.02,0:08:50.04,Default,,0,0,0,,Мен оны дұрыстап қайта үйретуім керек.
Dialogue: 0,0:08:51.67,0:08:53.23,Default,,0,0,0,,Бұл таңқаларлық, Бонд.
Dialogue: 0,0:08:53.23,0:08:54.78,Default,,0,0,0,,Болашақты сақтады
Dialogue: 0,0:09:03.07,0:09:04.52,Default,,0,0,0,,Ағамның ойы қандай—
Dialogue: 0,0:09:04.88,0:09:08.14,Default,,0,0,0,,Мен әлеуметтендіру және мойынсұнушылық жаттығуларын аяқтадым.
Dialogue: 0,0:09:08.39,0:09:11.82,Default,,0,0,0,,Ол соншалықты ақылсыз ит емес еді, бірақ...
Dialogue: 0,0:09:12.31,0:09:15.83,Default,,0,0,0,,Аня сияқты мен оны әлі де жеткілікті түсінбеймін.
Dialogue: 0,0:09:18.58,0:09:22.08,Default,,0,0,0,,Кочи
Dialogue: 0,0:09:18.73,0:09:21.79,Default,,0,0,0,,Әйтеуір, мені көгершін тітіркендірді.
Dialogue: 0,0:09:22.29,0:09:26.59,Default,,0,0,0,,Қиял
Dialogue: 0,0:09:22.56,0:09:23.79,Default,,0,0,0,,Қазіргі жағдайда оның барар жері жоқ.
Dialogue: 0,0:09:23.79,0:09:25.94,Default,,0,0,0,,Сіз сияқты жігіттермен қазірдің өзінде айналысу керек.
Dialogue: 0,0:09:30.29,0:09:32.34,Default,,0,0,0,,Бұл қандай да бір ауру ма?
Dialogue: 0,0:09:33.05,0:09:34.88,Default,,0,0,0,,Ауруханаға баруым керек пе?
Dialogue: 0,0:09:40.31,0:09:41.36,Default,,0,0,0,,Дейзи
Dialogue: 0,0:09:41.36,0:09:43.12,Default,,0,0,0,,Жоқ, ханым, артқа тұрыңыз.
Dialogue: 0,0:09:43.12,0:09:44.90,Default,,0,0,0,,Дейзи әлі ішінде
Dialogue: 0,0:09:45.15,0:09:46.84,Default,,0,0,0,,Маған ұнамайды, Дейзи.
Dialogue: 0,0:09:52.85,0:09:53.61,Default,,0,0,0,,●
Dialogue: 0,0:09:59.39,0:10:02.10,Default,,0,0,0,,Мен бүгін шынымен мазасыз сезінемін.
Dialogue: 0,0:10:05.42,0:10:06.74,Default,,0,0,0,,Колла №.
Dialogue: 0,0:10:18.40,0:10:19.28,Default,,0,0,0,,●
Dialogue: 0,0:10:23.37,0:10:25.20,Default,,0,0,0,,Өрт сөндіру бөліміне біреу хабарласады.
Dialogue: 0,0:10:25.44,0:10:27.48,Default,,0,0,0,,Өрт сіз ойлағаннан да тез таралады.
Dialogue: 0,0:10:30.54,0:10:33.99,Default,,0,0,0,,Өрт Сіз бұл иіске әрекет еттіңіз бе?
Dialogue: 0,0:10:36.90,0:10:38.35,Default,,0,0,0,,Ішінде адамдар бар
Dialogue: 0,0:10:38.35,0:10:40.60,Default,,0,0,0,,Жарайды, барлығы сыртта.
Dialogue: 0,0:10:42.45,0:10:44.26,Default,,0,0,0,,Соңғы кездері олар өте көп.
Dialogue: 0,0:10:44.53,0:10:47.01,Default,,0,0,0,,Оны өртеу болды деген де қауесет бар.
Dialogue: 0,0:10:47.01,0:10:48.76,Default,,0,0,0,,Өрт сөндіру машинасы әлі бар ма?
Dialogue: 0,0:10:50.00,0:10:52.01,Default,,0,0,0,,Дейзи
Dialogue: 0,0:10:54.39,0:10:56.26,Default,,0,0,0,,Ақымақ болма, мұнда ешкім жоқ
Dialogue: 0,0:10:56.99,0:10:58.51,Default,,0,0,0,,Сен де бірге кел
Dialogue: 0,0:10:58.51,0:11:01.26,Default,,0,0,0,,Жоқ, мүмкін бұл біреудің иісі шығар.
Dialogue: 0,0:11:07.20,0:11:07.96,Default,,0,0,0,,Облигация
Dialogue: 0,0:11:08.60,0:11:09.33,Default,,0,0,0,,Облигация
Dialogue: 0,0:11:11.59,0:11:12.32,Default,,0,0,0,,Облигация
Dialogue: 0,0:11:16.19,0:11:16.96,Default,,0,0,0,,Ыстық
Dialogue: 0,0:11:17.37,0:11:18.78,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:11:22.00,0:11:22.90,Default,,0,0,0,,Күшік
Dialogue: 0,0:11:23.18,0:11:24.60,Default,,0,0,0,,Бұл үй жануары ма?
Dialogue: 0,0:11:26.79,0:11:28.29,Default,,0,0,0,,Әлгі жігіт таң қалды.
Dialogue: 0,0:11:29.62,0:11:30.81,Default,,0,0,0,,Мен қазір кетемін.
Dialogue: 0,0:11:31.22,0:11:32.12,Default,,0,0,0,,Сіз жүгіре аласыз ба?
Dialogue: 0,0:11:32.92,0:11:34.05,Default,,0,0,0,,Өзіңізді төмендетіңіз
Dialogue: 0,0:11:36.84,0:11:37.80,Default,,0,0,0,,Шығу жолы...
Dialogue: 0,0:11:39.24,0:11:40.84,Default,,0,0,0,,Сіз оттан қорқасыз.
Dialogue: 0,0:11:41.11,0:11:42.35,Default,,0,0,0,,Оны мәжбүрлемеңіз
Dialogue: 0,0:11:43.00,0:11:44.11,Default,,0,0,0,,Мен қиындыққа тап болдым
Dialogue: 0,0:11:44.11,0:11:44.96,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:11:45.49,0:11:47.71,Default,,0,0,0,,Төменгі қабаттағы аумақ толығымен өртке оранды.
Dialogue: 0,0:11:48.08,0:11:51.03,Default,,0,0,0,,Сонымен солтүстік жағындағы сыртқы баспалдақ қалды.
Dialogue: 0,0:11:51.31,0:11:53.62,Default,,0,0,0,,Құлау қаупі бар, бірақ сол жерден...
Dialogue: 0,0:11:53.89,0:11:54.82,Default,,0,0,0,,Келіңіз Бонд
Dialogue: 0,0:11:56.81,0:11:57.50,Default,,0,0,0,,Не?
Dialogue: 0,0:11:57.81,0:11:59.07,Default,,0,0,0,,Ойнап жүргенде
Dialogue: 0,0:12:02.82,0:12:05.20,Default,,0,0,0,,Бұл пайдалы болды.
Dialogue: 0,0:12:06.52,0:12:08.87,Default,,0,0,0,,Осындай кездерде де мұрның жақсы ма?
Dialogue: 0,0:12:09.11,0:12:10.59,Default,,0,0,0,,Сіз кереметсіз
Dialogue: 0,0:12:12.56,0:12:14.59,Default,,0,0,0,,Осы қарқынмен сыртқы баспалдақтар да жақсы емес.
Dialogue: 0,0:12:15.60,0:12:19.40,Default,,0,0,0,,Олай болса, түтіннің арасынан күштеп өтуден басқа амалымыз жоқ...
Dialogue: 0,0:12:19.40,0:12:21.76,Default,,0,0,0,,Маған қарамастан, Бонд тыныс алуға қиналып жатыр.
Dialogue: 0,0:12:23.96,0:12:25.38,Default,,0,0,0,,Пластикалық пакет?
Dialogue: 0,0:12:26.30,0:12:27.83,Default,,0,0,0,,Жарайды, бұл.
Dialogue: 0,0:12:28.26,0:12:31.30,Default,,0,0,0,,Төменнен таза ауаны осылай жұтсаңыз
Dialogue: 0,0:12:32.24,0:12:34.36,Default,,0,0,0,,Қарапайым оттегі баллоны дайын.
Dialogue: 0,0:12:36.33,0:12:39.15,Default,,0,0,0,,Тыныс алмайтын жерді мына жігіт тесіп өтеді.
Dialogue: 0,0:12:45.94,0:12:47.86,Default,,0,0,0,,Мына жігітті осында алып жүрейік.
Dialogue: 0,0:12:50.11,0:12:52.88,Default,,0,0,0,,Бағытыңызды жоғалтпаңыз, маған жақын жүріңіз
Dialogue: 0,0:12:56.09,0:12:56.72,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:08.16,0:13:09.92,Default,,0,0,0,,Жақсы болдыңыз ба?
Dialogue: 0,0:13:10.86,0:13:14.64,Default,,0,0,0,,Бұл бала 407-бөлмеде қалған сияқты.
Dialogue: 0,0:13:18.31,0:13:21.65,Default,,0,0,0,,Беннет мырза мен мына ит емес пе?
Dialogue: 0,0:13:21.86,0:13:23.80,Default,,0,0,0,,Қашу тым кеш болды ма?
Dialogue: 0,0:13:23.80,0:13:26.12,Default,,0,0,0,,Сіз және басқалар көмектесу үшін бар күшіңізді саласыз.
Dialogue: 0,0:13:26.81,0:13:28.66,Default,,0,0,0,,Бұл үлкен ит
Dialogue: 0,0:13:32.28,0:13:33.86,Default,,0,0,0,,Bond Fire Fire
Dialogue: 0,0:13:35.34,0:13:36.09,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:13:36.09,0:13:37.92,Default,,0,0,0,,Мен саған бір шелек су әкелемін.
Dialogue: 0,0:13:47.67,0:13:49.07,Default,,0,0,0,,Хосо
Dialogue: 0,0:13:49.82,0:13:52.44,Default,,0,0,0,,Суланғанда солай бола ма?
Dialogue: 0,0:13:52.68,0:13:55.60,Default,,0,0,0,,Мен әрқашан сусабын Йору-санға қалдырдым.
Dialogue: 0,0:13:55.60,0:13:57.69,Default,,0,0,0,,Мен оны бірінші рет көріп тұрмын.
Dialogue: 0,0:13:59.58,0:14:01.28,Default,,0,0,0,,Жоқ, жоқ, ымырт
Dialogue: 0,0:14:01.28,0:14:02.84,Default,,0,0,0,,Мен суық жүректі барлаушымын
Dialogue: 0,0:14:02.84,0:14:04.95,Default,,0,0,0,,Эмоцияларыңызды көрсетпеңіз
Dialogue: 0,0:14:06.76,0:14:08.95,Default,,0,0,0,,Өрттің сөнгеніне қуаныштымын.
Dialogue: 0,0:14:12.08,0:14:12.93,Default,,0,0,0,,●
Dialogue: 0,0:14:17.82,0:14:19.97,Default,,0,0,0,,Қария, мен ол күшікті сұраймын.
Dialogue: 0,0:14:21.13,0:14:22.47,Default,,0,0,0,,Күте тұрыңыз, Бонд
Dialogue: 0,0:14:28.50,0:14:31.50,Default,,0,0,0,,Уау, жанып барады
Dialogue: 0,0:14:32.68,0:14:33.98,Default,,0,0,0,,Дейзи
Dialogue: 0,0:14:34.32,0:14:36.14,Default,,0,0,0,,Жоқ, ханым, артқа тұрыңыз.
Dialogue: 0,0:14:36.14,0:14:37.98,Default,,0,0,0,,Дейзи әлі ішінде
Dialogue: 0,0:14:39.83,0:14:42.03,Default,,0,0,0,,Мен тоқтай алмаймын
Dialogue: 0,0:14:45.88,0:14:48.74,Default,,0,0,0,,Бұл дымқыл, арық мақұлық деген не?
Dialogue: 0,0:14:53.68,0:14:55.56,Default,,0,0,0,,Ол қайтадан қарапайым адамға айналды.
Dialogue: 0,0:14:54.65,0:14:56.75,Default,,0,0,0,,Жібер, боқ.
Dialogue: 0,0:14:57.01,0:14:58.62,Default,,0,0,0,,(JoJo) Дүрбелең шығарма!
Dialogue: 0,0:14:59.66,0:15:01.25,Default,,0,0,0,,Майды тұтандыру құралы
Dialogue: 0,0:15:01.54,0:15:04.63,Default,,0,0,0,,Адамдарды менсінбейтін бейбақ!
Dialogue: 0,0:15:09.09,0:15:11.16,Default,,0,0,0,,Сіз бұл жігітті от жағушы дейсіз.
Dialogue: 0,0:15:13.07,0:15:17.92,Default,,0,0,0,,Мұнайдың түрі де билік қуып келген сериялық өрт сөндірушінің түрімен сәйкес келеді.
Dialogue: 0,0:15:18.90,0:15:22.40,Default,,0,0,0,,Тек хабарлаңыз және қалғанын полицияның қарауына қалдырыңыз.
Dialogue: 0,0:15:22.99,0:15:24.47,Default,,0,0,0,,Мен мұны өте жақсы байқадым.
Dialogue: 0,0:15:24.72,0:15:26.14,Default,,0,0,0,,Оқиға орнында иіс бар.
Dialogue: 0,0:15:26.14,0:15:28.72,Default,,0,0,0,,Әлде қылмыскерге тән күйзеліс иісі ме?
Dialogue: 0,0:15:31.31,0:15:33.45,Default,,0,0,0,,Бәрібір жақсы.
Dialogue: 0,0:15:34.42,0:15:35.66,Default,,0,0,0,,Дейзи сізге жақсы
Dialogue: 0,0:15:36.13,0:15:38.32,Default,,0,0,0,,Мен қақпаны бұзып өттім дедің—дәл қазір де, қазір де, солай емес пе?
Dialogue: 0,0:15:38.65,0:15:40.17,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,0:15:40.48,0:15:42.67,Default,,0,0,0,,Сен кеткенде, мен
Dialogue: 0,0:15:43.59,0:15:45.53,Default,,0,0,0,,Дейзи
Dialogue: 0,0:15:45.53,0:15:46.67,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:52.88,0:15:57.99,Default,,0,0,0,,Маған байсалды көрінетін ағасы мен үлкен, сымбатты ит көмектесті.
Dialogue: 0,0:15:57.99,0:15:59.94,Default,,0,0,0,,Бұл шынымен де марапатқа лайық.
Dialogue: 0,0:16:00.49,0:16:01.71,Default,,0,0,0,,Сіз қайда бардыңыз?
Dialogue: 0,0:16:01.71,0:16:02.94,Default,,0,0,0,,Оны аздап іздеп көрейік.
Dialogue: 0,0:16:03.29,0:16:04.23,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:16:05.15,0:16:06.12,Default,,0,0,0,,Сіз және мен
Dialogue: 0,0:16:06.12,0:16:08.95,Default,,0,0,0,,Газетте болу өте жақсы емес.
Dialogue: 0,0:16:09.86,0:16:13.46,Default,,0,0,0,,Осы сәтті ит үшін бір жылдық ет
Dialogue: 0,0:16:19.08,0:16:20.49,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:16:20.78,0:16:21.96,Default,,0,0,0,,Бұл таңқаларлық болды.
Dialogue: 0,0:16:22.12,0:16:22.80,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:23.94,0:16:26.22,Default,,0,0,0,,Аяқ емес, қол тістейтін шығар.
Dialogue: 0,0:16:29.91,0:16:31.22,Default,,0,0,0,,Абайсызда болмаңыз
Dialogue: 0,0:16:32.35,0:16:35.29,Default,,0,0,0,,Менің үйімде сен өлсең қайғыратын адамдар бар.
Dialogue: 0,0:16:50.84,0:16:52.24,Default,,0,0,0,,Мен де жаман болдым
Dialogue: 0,0:16:52.79,0:16:55.44,Default,,0,0,0,,Кәсіби ит ретіндегі жұмыс екінші орында.
Dialogue: 0,0:16:55.99,0:16:59.73,Default,,0,0,0,,Алдымен, сіз Фолгер отбасының мүшесі екеніңізді түсініңіз.
Dialogue: 0,0:17:00.40,0:17:01.33,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:02.32,0:17:03.44,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:17:05.35,0:17:07.34,Default,,0,0,0,,Сіз көп түтін жұттыңыз.
Dialogue: 0,0:17:07.34,0:17:09.76,Default,,0,0,0,,Тек сенімді болу үшін үйге қайтып бара жатқанда ауруханаға дәрігерге барайық.
Dialogue: 0,0:17:12.15,0:17:13.38,Default,,0,0,0,,Сәлем Нанна
Dialogue: 0,0:17:13.74,0:17:14.93,Default,,0,0,0,,Коллаж
Dialogue: 0,0:17:15.22,0:17:16.77,Default,,0,0,0,,соғұрлым олардың күші мен жылдамдығы артады
Dialogue: 0,0:17:16.77,0:17:18.19,Default,,0,0,0,,Фолгерлер құлаған кезде
Dialogue: 0,0:17:18.19,0:17:21.07,Default,,0,0,0,,Өйткені бұл мен үшін ыңғайсыз болар еді.
Dialogue: 0,0:17:26.11,0:17:28.29,Default,,0,0,0,,Ертең менің басқа тапсырмаларым жоқ.
Dialogue: 0,0:17:28.29,0:17:30.87,Default,,0,0,0,,Біраз уақыттан кейін бәріміз бірге иттер саябағына барамыз ба?
Dialogue: 0,0:17:31.31,0:17:34.64,Default,,0,0,0,,Демалысыңыздан ләззат алмаған жалғыз сіз болдыңыз, себебі сіз алыста болдыңыз.
Dialogue: 0,0:17:37.01,0:17:39.36,Default,,0,0,0,,Неліктен жылау суланғанда өзгереді?
Dialogue: 0,0:17:39.54,0:17:42.96,Default,,0,0,0,,Бұл субтитрді Моечая шығарған. Оны коммерциялық мақсатта пайдалануға болады.
Dialogue: 0,0:17:54.18,0:18:00.98,Default,,0,0,0,,Көру аймағында қою қызыл-қызыл түс пайда болады
Dialogue: 0,0:18:03.85,0:18:11.11,Default,,0,0,0,,Шамамен 40 000 км алға
Dialogue: 0,0:18:14.11,0:18:18.53,Default,,0,0,0,,Артында жақындап келе жатқан өзара жаралар
Dialogue: 0,0:18:18.87,0:18:23.75,Default,,0,0,0,,Адасып кеткен жол мені одан сайын адастырады
Dialogue: 0,0:18:23.75,0:18:28.13,Default,,0,0,0,,Көрінбейтін, иісі сезілмейтін және өзгертілмейтін болашақ
Dialogue: 0,0:18:28.42,0:18:30.34,Default,,0,0,0,,Мен сенің арқаңнан пышақ сұғып алдым!
Dialogue: 0,0:18:31.46,0:18:39.97,Default,,0,0,0,,Бүгін кешке жаныңда болуға рұқсат ет
Dialogue: 0,0:18:41.10,0:18:48.90,Default,,0,0,0,,Мен бүгін кешке байыптымын.
Dialogue: 0,0:18:50.15,0:18:52.61,Default,,0,0,0,,Қосымша ақпарат алу үшін осында келіңіз
Dialogue: 0,0:18:52.61,0:18:54.95,Default,,0,0,0,,Біз дұға еткен болашақ
Dialogue: 0,0:18:54.95,0:18:56.91,Default,,0,0,0,,Жолдар әртүрлі.
Dialogue: 0,0:19:02.12,0:19:04.50,Default,,0,0,0,,Өзара өлтіру ниетімен
Dialogue: 0,0:19:04.50,0:19:07.88,Default,,0,0,0,,Сіз соңғы соққыны аласыз.
Dialogue: 0,0:19:09.29,0:19:12.51,Default,,0,0,0,,Ақыр соңында мен оны тоқтатамын.
Dialogue: 0,0:19:16.13,0:19:17.22,Default,,0,0,0,,Дайын
Dialogue: 0,0:19:20.44,0:19:21.55,Default,,0,0,0,,Пышақ
Dialogue: 0,0:19:22.34,0:19:24.51,Default,,0,0,0,,Бұл Пеппенгуин.
Dialogue: 0,0:19:24.77,0:19:26.98,Default,,0,0,0,,Оригами қиын.
Dialogue: 0,0:19:27.32,0:19:29.69,Default,,0,0,0,,Иә, мұндай нәрсе туралы не деуге болады?
Dialogue: 0,0:19:44.37,0:19:46.63,Default,,0,0,0,,Эй, мен оны тым көп кесіп алдым.
Dialogue: 0,0:19:48.33,0:19:49.34,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:19:50.36,0:19:51.65,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:19:53.79,0:19:55.15,Default,,0,0,0,,Боббонд
Dialogue: 0,0:19:55.15,0:19:58.13,Default,,0,0,0,,Қырысып кеткен
Dialogue: 0,0:19:59.37,0:20:00.81,Default,,0,0,0,,Демек, Өлім періштесі тек алма жей ме?
Dialogue: 0,0:20:01.55,0:20:03.37,Default,,0,0,0,,Міне, келдік.
Dialogue: 0,0:20:03.78,0:20:06.18,Default,,0,0,0,,Үйге қайтып бара жатқанда үстіме су құйылды
Dialogue: 0,0:20:08.11,0:20:09.84,Default,,0,0,0,,Олай ма еді?
Dialogue: 0,0:20:11.20,0:20:13.15,Default,,0,0,0,,Дауысы да әдеттегіден өзгеше.
Dialogue: 0,0:20:13.54,0:20:15.66,Default,,0,0,0,,Жарайды, Аня-сан.
Dialogue: 0,0:20:15.92,0:20:18.39,Default,,0,0,0,,Бонд мырза суланғанда осылай болады.
Dialogue: 0,0:20:18.61,0:20:21.16,Default,,0,0,0,,Құрғағаннан кейін бұрынғыдай үлпілдек болады.
Dialogue: 0,0:20:21.60,0:20:25.91,Default,,0,0,0,,Мен жаңа ғана күшікті өрттен құтқардым. Мен жаңа ғана өрт қоюшыны ұстадым.
Dialogue: 0,0:20:25.91,0:20:28.33,Default,,0,0,0,,Мен сізге шындықты айта алмаймын.
Dialogue: 0,0:20:29.50,0:20:32.95,Default,,0,0,0,,Чичи мен Бонд серуендеу кезінде өте пайдалы
Dialogue: 0,0:20:34.01,0:20:36.51,Default,,0,0,0,,Бонд мырза, сәл күте тұрыңыз.
Dialogue: 0,0:20:36.51,0:20:38.45,Default,,0,0,0,,Мен оны бірден кептіремін.
Dialogue: 0,0:20:38.45,0:20:39.93,Default,,0,0,0,,Кешіріңіз, Йору-сан.
Dialogue: 0,0:20:40.44,0:20:41.20,Default,,0,0,0,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:20:52.37,0:20:55.63,Default,,0,0,0,,Чичи Бонд сыйлығы Стелла
Dialogue: 0,0:20:57.82,0:21:00.17,Default,,0,0,0,,Не, сен Стелланы ойнайсың ба?
Dialogue: 0,0:21:01.92,0:21:04.76,Default,,0,0,0,,Өте ауыр жұмыс марапатына ие болыңыз
Dialogue: 0,0:21:09.55,0:21:11.39,Default,,0,0,0,,Бонд мырза Ллойд мырза
Dialogue: 0,0:21:11.39,0:21:12.96,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:21:13.53,0:21:16.35,Default,,0,0,0,,Не қаласаңыз да, нағыз Стелланы алыңыз.
Dialogue: 0,0:21:19.89,0:21:22.05,Default,,0,0,0,,Жүр, кешкі ас ішейік.
Dialogue: 0,0:21:22.42,0:21:23.72,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:21:23.97,0:21:26.56,Default,,0,0,0,,Аня Мен Чичидің гамбургер стейкін жегім келеді
Dialogue: 0,0:21:28.06,0:21:33.06,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
