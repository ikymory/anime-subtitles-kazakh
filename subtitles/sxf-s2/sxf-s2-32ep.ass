Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.49,0:00:14.03,Default,,0,0,0,,Сұрақ қою батыл әрекет
Dialogue: 0,0:00:14.03,0:00:16.62,Default,,0,0,0,,Сұрақ Басқаларсыз өмір
Dialogue: 0,0:00:16.62,0:00:19.16,Default,,0,0,0,,Сатқындық пен бейбітшілікке сұрақ
Dialogue: 0,0:00:19.16,0:00:21.38,Default,,0,0,0,,Сұрақ не?
Dialogue: 0,0:00:21.67,0:00:23.54,Default,,0,0,0,,Дүние екіге бөлінген
Dialogue: 0,0:00:23.54,0:00:26.21,Default,,0,0,0,,Әрбір жасырын әділдік болып табылады
Dialogue: 0,0:00:26.80,0:00:28.67,Default,,0,0,0,,Гарандого қарсы тұру
Dialogue: 0,0:00:28.67,0:00:30.43,Default,,0,0,0,,Үйілген және қабаттастырылған
Dialogue: 0,0:00:30.43,0:00:31.93,Default,,0,0,0,,Екі жақты екі бет
Dialogue: 0,0:00:32.80,0:00:34.85,Default,,0,0,0,,Парасаттылық, төмендік және сахна артындағы
Dialogue: 0,0:00:35.35,0:00:37.06,Default,,0,0,0,,Мұның соңы немесе ақыры маңызды емес.
Dialogue: 0,0:00:37.93,0:00:39.23,Default,,0,0,0,,Дәл уақыт өте стандарт болып табылады
Dialogue: 0,0:00:39.23,0:00:41.06,Default,,0,0,0,,Мен бұл туралы бірдеңе жасадым.
Dialogue: 0,0:00:41.06,0:00:45.36,Default,,0,0,0,,Crazy әңгіме, бәрі әлдеқашан шешілген сияқты
Dialogue: 0,0:00:45.36,0:00:48.07,Default,,0,0,0,,Ерекшеліксіз қалыптан тыс жағдай
Dialogue: 0,0:00:48.07,0:00:50.74,Default,,0,0,0,,Әдетте ешқандай себепсіз
Dialogue: 0,0:00:51.57,0:00:54.07,Default,,0,0,0,,Дұрыс пен бұрыс тұрақсыз
Dialogue: 0,0:00:54.07,0:00:56.95,Default,,0,0,0,,Іштен шыққан шынайы сезімдер жинақталады
Dialogue: 0,0:00:56.95,0:00:59.25,Default,,0,0,0,,Кейде оны қорытуға мүмкіндік болмайды.
Dialogue: 0,0:00:59.25,0:01:01.75,Default,,0,0,0,,Сіз мұны байқамай қарсы аласыз ба?
Dialogue: 0,0:01:01.75,0:01:04.54,Default,,0,0,0,,Қайғылы емеспін, бірақ бәрібір осылай
Dialogue: 0,0:01:04.54,0:01:06.92,Default,,0,0,0,,Мен 100% білмеймін
Dialogue: 0,0:01:06.92,0:01:11.88,Default,,0,0,0,,Мен өз уайымымнан құтылсам екен деп тілеймін, тілеймін және мұңайдым.
Dialogue: 0,0:01:11.88,0:01:14.55,Default,,0,0,0,,Егер бұл перде желбіресе
Dialogue: 0,0:01:14.55,0:01:17.26,Default,,0,0,0,,Идеалдар мен шындық теңселеді
Dialogue: 0,0:01:19.18,0:01:21.69,Default,,0,0,0,,Сұрақ қою батыл әрекет
Dialogue: 0,0:01:21.69,0:01:24.19,Default,,0,0,0,,Сұрақ Басқаларсыз өмір
Dialogue: 0,0:01:24.19,0:01:26.86,Default,,0,0,0,,Сатқындық пен бейбітшілікке сұрақ
Dialogue: 0,0:01:26.86,0:01:28.07,Default,,0,0,0,,Сұрақ не?
Dialogue: 0,0:01:31.49,0:01:34.99,Default,,0,0,0,,Кімнің міндеттері қажет?
Dialogue: 0,0:01:40.04,0:01:41.45,Default,,0,0,0,,Екеуің де артқа тұрасыңдар.
Dialogue: 0,0:01:42.78,0:01:44.71,Default,,0,0,0,,Сіз бұрын ешқашан көрмеген артықшылықтар
Dialogue: 0,0:01:45.21,0:01:46.81,Default,,0,0,0,,Бұл орташа диапазон түрі ме?
Dialogue: 0,0:01:47.37,0:01:49.78,Default,,0,0,0,,Екеуіңді арқалап алып қашу қиын.
Dialogue: 0,0:01:50.57,0:01:51.42,Default,,0,0,0,,Егер
Dialogue: 0,0:01:57.42,0:01:58.97,Default,,0,0,0,,Мен арасына кіре алмаймын.
Dialogue: 0,0:01:59.53,0:02:02.46,Default,,0,0,0,,Ол қаруды өте жақсы меңгерген.
Dialogue: 0,0:02:02.83,0:02:03.95,Default,,0,0,0,,(Миямура) Хмм… Өлмегенің жөн болар
Dialogue: 0,0:02:03.95,0:02:04.78,Default,,0,0,0,,Ұрыс
Dialogue: 0,0:02:05.12,0:02:07.17,Default,,0,0,0,,Бұл адам пышақ сілтеп тұрған жоқ.
Dialogue: 0,0:02:07.17,0:02:08.56,Default,,0,0,0,,Қауіпсіздікке жауапты біреу
Dialogue: 0,0:02:09.35,0:02:11.80,Default,,0,0,0,,Мен мүмкіндігінше ерекшеленемін.
Dialogue: 0,0:02:12.12,0:02:14.80,Default,,0,0,0,,Біз не істеуіміз керек? Осылай жалғаса берсе, әбігер болады.
Dialogue: 0,0:02:15.14,0:02:16.62,Default,,0,0,0,,Жоқ, тек кедергі келтіресің.
Dialogue: 0,0:02:18.53,0:02:19.47,Default,,0,0,0,,Шынайы кімдігі: жалдамалы кісі өлтіруші
Dialogue: 0,0:02:19.69,0:02:20.53,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:02:20.53,0:02:22.00,Default,,0,0,0,,Егер сіз осындай жерді көрсеңіз
Dialogue: 0,0:02:23.52,0:02:26.46,Default,,0,0,0,,Цирк ханымы өте жақсы
Dialogue: 0,0:02:31.63,0:02:33.23,Default,,0,0,0,,Бұл не, көшедегі қойылым?
Dialogue: 0,0:02:33.23,0:02:35.13,Default,,0,0,0,,Люкс круиздік кемеден күткендей
Dialogue: 0,0:02:37.09,0:02:39.65,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:02:39.65,0:02:42.22,Default,,0,0,0,,Менің ойымша, Аня да бұл мен екенімді білмейді.
Dialogue: 0,0:02:42.54,0:02:43.68,Default,,0,0,0,,Қазір
Dialogue: 0,0:02:46.80,0:02:48.25,Default,,0,0,0,,Керемет
Dialogue: 0,0:02:48.52,0:02:50.15,Default,,0,0,0,,Кедергісіз өту
Dialogue: 0,0:02:50.43,0:02:51.63,Default,,0,0,0,,Қоғамдық бақылау
Dialogue: 0,0:02:51.63,0:02:53.53,Default,,0,0,0,,Артқы жағындағы оркалар
Dialogue: 0,0:02:53.94,0:02:54.90,Default,,0,0,0,,Орындау қиын
Dialogue: 0,0:02:54.90,0:02:56.38,Default,,0,0,0,,Мен жеткілікті түрде жақындай алмаймын.
Dialogue: 0,0:03:00.07,0:03:01.33,Default,,0,0,0,,Өйткені мен тірі жеп қойылудан шын мәнінде қорқамын
Dialogue: 0,0:03:02.36,0:03:04.08,Default,,0,0,0,,Менің аяғым ауыр
Dialogue: 0,0:03:04.75,0:03:05.70,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:03:05.70,0:03:07.58,Default,,0,0,0,,Мен кіруге тартынамын.
Dialogue: 0,0:03:08.33,0:03:11.76,Default,,0,0,0,,Осындай калибрлі қарумен өлімге әкелетін жарақаттар туралы алаңдамаудың қажеті жоқ.
Dialogue: 0,0:03:12.13,0:03:14.39,Default,,0,0,0,,Қолыңнан келгенін істе, әпке.
Dialogue: 0,0:03:14.39,0:03:16.97,Default,,0,0,0,,Оны тез жеңбесең, Чичи шығады.
Dialogue: 0,0:03:17.32,0:03:18.40,Default,,0,0,0,,Кеттік
Dialogue: 0,0:03:18.63,0:03:21.50,Default,,0,0,0,,Тізбекті ұстап, оны төмен сүйреңіз, бүлінуге дайын.
Dialogue: 0,0:03:22.09,0:03:23.06,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:03:23.06,0:03:26.75,Default,,0,0,0,,Мен акробат сияқты әрекет етпесем, адамдар күдіктене ме деп ойлаймын.
Dialogue: 0,0:03:27.73,0:03:28.96,Default,,0,0,0,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:03:28.96,0:03:30.56,Default,,0,0,0,,Жарай, кеттік, Йотаро.
Dialogue: 0,0:03:30.56,0:03:32.28,Default,,0,0,0,,Қарттар да қолдарынан келгенін істеулері керек
Dialogue: 0,0:03:32.28,0:03:34.32,Default,,0,0,0,,Бізге ғажайып дағдыларды көрсетіңіз
Dialogue: 0,0:03:35.55,0:03:38.99,Default,,0,0,0,,Мен қаншалықты қиын болғаным үшін көп көңіл бөлдім.
Dialogue: 0,0:03:38.99,0:03:40.13,Default,,0,0,0,,Бұл қиыншылық
Dialogue: 0,0:03:40.44,0:03:44.12,Default,,0,0,0,,Мен бұл жігіттерді шабу кезінде жоюым керек пе?
Dialogue: 0,0:04:22.27,0:04:24.41,Default,,0,0,0,,Тамаша жұмыс
Dialogue: 0,0:04:25.12,0:04:26.42,Default,,0,0,0,,Мен таңғажайып нәрсе көрдім
Dialogue: 0,0:04:26.42,0:04:28.75,Default,,0,0,0,,Мен тұжырымдаманы шынымен түсінбедім.
Dialogue: 0,0:04:28.97,0:04:30.55,Default,,0,0,0,,Хаха қорқынышты
Dialogue: 0,0:04:30.55,0:04:33.79,Default,,0,0,0,,Келесі жолы не айтатыныңызды тыңдаймын деп ойлаймын.
Dialogue: 0,0:04:33.79,0:04:35.56,Default,,0,0,0,,Жарайды, тамаша.
Dialogue: 0,0:04:35.79,0:04:37.65,Default,,0,0,0,,Бұған ол да риза болуы керек.
Dialogue: 0,0:04:36.14,0:04:36.92,Default,,0,0,0,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:04:37.87,0:04:39.55,Default,,0,0,0,,Мен дүкенге қайта баруым керек.
Dialogue: 0,0:04:41.64,0:04:43.46,Default,,0,0,0,,Кішкентай қыз, сен қайда болдың?
Dialogue: 0,0:04:43.67,0:04:45.78,Default,,0,0,0,,Мұнда цирк бар...
Dialogue: 0,0:04:47.66,0:04:49.30,Default,,0,0,0,,Аня орындады
Dialogue: 0,0:04:49.60,0:04:51.24,Default,,0,0,0,,Көмектесіңіз
Dialogue: 0,0:04:51.24,0:04:54.27,Default,,0,0,0,,Миссияны Чичи де білмей-ақ аяқтады.
Dialogue: 0,0:04:55.51,0:04:56.92,Default,,0,0,0,,Батыл Аня
Dialogue: 0,0:04:57.16,0:05:01.10,Default,,0,0,0,,Мен соңғы шытырман оқиға үшін жүрегімнің соғуын басқара алмаймын.
Dialogue: 0,0:05:11.74,0:05:13.71,Default,,0,0,0,,Осының бәрін маған бер
Dialogue: 0,0:05:13.71,0:05:16.72,Default,,0,0,0,,Және... бұл сізге өте жарасады.
Dialogue: 0,0:05:18.85,0:05:19.95,Default,,0,0,0,,Лай емес
Dialogue: 0,0:05:20.29,0:05:23.30,Default,,0,0,0,,Қалай қарасаңыз да, ол - бақытты, көңілді әке.
Dialogue: 0,0:05:23.69,0:05:25.00,Default,,0,0,0,,Қарғыс атқыр
Dialogue: 0,0:05:25.28,0:05:26.14,Default,,0,0,0,,Құрғақ
Dialogue: 0,0:05:31.20,0:05:31.96,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:05:32.27,0:05:33.56,Default,,0,0,0,,Жоқ, бірақ
Dialogue: 0,0:05:33.56,0:05:36.65,Default,,0,0,0,,Ол жақтағы тұтынушы қандай қызық ерлі-зайыптылардың дауы болды?
Dialogue: 0,0:05:36.65,0:05:38.90,Default,,0,0,0,,Мұз жинағыштың бәрі жабысқақ болды.
Dialogue: 0,0:05:38.90,0:05:39.90,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:05:40.44,0:05:43.53,Default,,0,0,0,,Мен бұл кемеде кісі өлтіру болмағанына қуаныштымын.
Dialogue: 0,0:05:44.09,0:05:45.91,Default,,0,0,0,,Бұл мүлдем рас.
Dialogue: 0,0:06:03.11,0:06:07.69,Default,,0,0,0,,Blueless Number 89-дағы су перісі дәретхана суы
Dialogue: 0,0:06:07.95,0:06:11.18,Default,,0,0,0,,Бұл сарайда тексерген парфюмериядан өзгеше.
Dialogue: 0,0:06:11.44,0:06:14.07,Default,,0,0,0,,Ол жүзімен бірге өзгерді ме?
Dialogue: 0,0:06:14.34,0:06:17.51,Default,,0,0,0,,Кем дегенде бір ер және екі әйел болды.
Dialogue: 0,0:06:17.51,0:06:20.47,Default,,0,0,0,,Иіс шықпайтын жолсерік қыз ма?
Dialogue: 0,0:06:22.38,0:06:23.12,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:06:23.12,0:06:24.61,Default,,0,0,0,,Олардың қадамдары
Dialogue: 0,0:06:26.13,0:06:27.20,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:06:27.68,0:06:31.71,Default,,0,0,0,,Оның екінші немесе үшінші класты кабинада жасырыну ықтималдығы жоғары.
Dialogue: 0,0:06:31.71,0:06:33.60,Default,,0,0,0,,Менің құлағыма әлі ештеңе жеткен жоқ
Dialogue: 0,0:06:33.92,0:06:36.14,Default,,0,0,0,,Мен біреуді сол жерде қалдыруым керек пе?
Dialogue: 0,0:06:37.44,0:06:39.33,Default,,0,0,0,,Маршрутқа байланысты шығар
Dialogue: 0,0:06:39.33,0:06:43.24,Default,,0,0,0,,Олар ертең түнге дейін ақауға қарсы әрекет жасамайды.
Dialogue: 0,0:06:43.91,0:06:47.44,Default,,0,0,0,,Уақыты келгенде, мен не болса да көрінемін
Dialogue: 0,0:06:47.44,0:06:49.40,Default,,0,0,0,,Үздіксіз қолдауыңыз үшін рахмет.
Dialogue: 0,0:06:54.81,0:06:56.18,Default,,0,0,0,,Мен сені басшының қызының қайда жасырынып жатқанын айтуға мәжбүрлеймін.
Dialogue: 0,0:06:56.18,0:06:57.65,Default,,0,0,0,,Жоқ, әлі жоқ.
Dialogue: 0,0:06:57.65,0:07:00.36,Default,,0,0,0,,Әзірге үшінші палубаға барыңыз.
Dialogue: 0,0:07:00.60,0:07:03.26,Default,,0,0,0,,Ол соншалықты пайдасыз ақпарат беруші.
Dialogue: 0,0:07:03.87,0:07:06.83,Default,,0,0,0,,Тек ақша алу арқылы алдауды қаламайтыныңызға сенімдімін.
Dialogue: 0,0:07:07.86,0:07:09.85,Default,,0,0,0,,Бұған жол бермеңіз
Dialogue: 0,0:07:09.85,0:07:11.58,Default,,0,0,0,,Кемеден түсер алдында
Dialogue: 0,0:07:11.81,0:07:14.82,Default,,0,0,0,,Мен төлеген ақшамды қайтара аламын ба?
Dialogue: 0,0:07:16.27,0:07:18.14,Default,,0,0,0,,Ақшаны не үшін пайдаланасыз?
Dialogue: 0,0:07:18.14,0:07:19.84,Default,,0,0,0,,That's right.
Dialogue: 0,0:07:18.69,0:07:22.00,Default,,0,0,0,,Барлық жерде ақымақ адамдар бар.
Dialogue: 0,0:07:22.74,0:07:25.00,Default,,0,0,0,,Мен дайындалуым керек пе?
Dialogue: 0,0:07:29.51,0:07:33.89,Default,,0,0,0,,Нәтижесінде капитал жоғалады
Dialogue: 0,0:07:29.89,0:07:31.18,Default,,0,0,0,,Әй, қайда бара жатырсың?
Dialogue: 0,0:07:31.18,0:07:32.37,Default,,0,0,0,,Бөлме мына жақта.
Dialogue: 0,0:07:32.56,0:07:34.53,Default,,0,0,0,,Хаха, бұл қиын…
Dialogue: 0,0:07:34.53,0:07:35.34,Default,,0,0,0,,Заттарыңызды тексеріңіз
Dialogue: 0,0:07:36.57,0:07:38.70,Default,,0,0,0,,Мен кеш жұмыс істеп жатқан шығармын.
Dialogue: 0,0:07:38.70,0:07:40.36,Default,,0,0,0,,Оның саған еш қатысы жоқ.
Dialogue: 0,0:07:40.72,0:07:42.68,Default,,0,0,0,,Баланың ұйықтайтын уақыты келді.
Dialogue: 0,0:07:42.68,0:07:43.53,Default,,0,0,0,,Кумия Нурезо — біз сол жігітті артта қалдыра саламыз.
Dialogue: 0,0:07:43.74,0:07:47.55,Default,,0,0,0,,Аняның шытырман оқиғасы енді ғана басталды
Dialogue: 0,0:07:58.03,0:08:01.45,Default,,0,0,0,,Мен сізден хабар алған жоқпын, сондықтан сіз бос емессіз деп ойлаймын.
Dialogue: 0,0:08:02.13,0:08:04.00,Default,,0,0,0,,Тыңдау немесе тыңдау жоқ
Dialogue: 0,0:08:04.53,0:08:07.02,Default,,0,0,0,,Мен мұнда біраз уақыт тыныштала алатын сияқтымын.
Dialogue: 0,0:08:08.12,0:08:11.47,Default,,0,0,0,,Басқарушы бізге тамақ дайындап қойған сияқты.
Dialogue: 0,0:08:12.05,0:08:14.60,Default,,0,0,0,,Бізді алып кететін кеме келгенше құлыпта қала алатын сияқтымыз.
Dialogue: 0,0:08:16.07,0:08:17.28,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:08:17.28,0:08:18.72,Default,,0,0,0,,Тыныш бол.
Dialogue: 0,0:08:21.42,0:08:23.23,Default,,0,0,0,,Мен қатты қорықтым
Dialogue: 0,0:08:23.71,0:08:27.11,Default,,0,0,0,,Олар қандай? Олар ауыр өлтірушілер ме?
Dialogue: 0,0:08:27.11,0:08:30.21,Default,,0,0,0,,Мылтық ату және борттағы орақтарды сермеу
Dialogue: 0,0:08:30.21,0:08:32.53,Default,,0,0,0,,Бұл әзіл емес. Үйге бар.
Dialogue: 0,0:08:32.53,0:08:34.34,Default,,0,0,0,,Шу шығарма, ақымақ.
Dialogue: 0,0:08:34.34,0:08:36.15,Default,,0,0,0,,Мен Кэтте Ане-санды көрдім.
Dialogue: 0,0:08:36.15,0:08:37.83,Default,,0,0,0,,Сол қайсар адамдар
Dialogue: 0,0:08:38.05,0:08:39.25,Default,,0,0,0,,Маджиготтар
Dialogue: 0,0:08:39.59,0:08:43.62,Default,,0,0,0,,Сіз шынымен жүрексіз жігітсіз.
Dialogue: 0,0:08:43.62,0:08:45.50,Default,,0,0,0,,Мен өзімді аянышты сезінемін, сондықтан мен жылай бастадым
Dialogue: 0,0:08:47.92,0:08:49.13,Default,,0,0,0,,Ботчанға
Dialogue: 0,0:08:49.90,0:08:53.17,Default,,0,0,0,,Бұлай өспеу керек.
Dialogue: 0,0:08:56.65,0:08:59.36,Default,,0,0,0,,Дәлірек айтсақ, неге маған ердің?
Dialogue: 0,0:09:00.64,0:09:03.69,Default,,0,0,0,,Мұндай қауіпке араласудың қажеті жоқ еді.
Dialogue: 0,0:09:04.04,0:09:06.69,Default,,0,0,0,,Мен жаңа ұйымда қалуым керек еді.
Dialogue: 0,0:09:07.28,0:09:10.34,Default,,0,0,0,,Бұл сіз туралы ...
Dialogue: 0,0:09:10.34,0:09:11.90,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:11.90,0:09:13.14,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:09:16.13,0:09:17.60,Default,,0,0,0,,Өтінемін, мені менсінбе
Dialogue: 0,0:09:17.94,0:09:21.37,Default,,0,0,0,,Бастығыңнан алған жақсылығыңды ұмытатындай шірік болма.
Dialogue: 0,0:09:22.63,0:09:25.04,Default,,0,0,0,,Соғыстан кейін жейтін ештеңе қалмады.
Dialogue: 0,0:09:25.43,0:09:28.22,Default,,0,0,0,,Отбасы басқаратын қара базарсыз.
Dialogue: 0,0:09:28.51,0:09:30.17,Default,,0,0,0,,Мен табиғатта өлдім
Dialogue: 0,0:09:31.21,0:09:32.15,Default,,0,0,0,,Мен саған мынаны беремін
Dialogue: 0,0:09:42.66,0:09:44.10,Default,,0,0,0,,Бұл әркімге құпия
Dialogue: 0,0:09:46.63,0:09:49.78,Default,,0,0,0,,Эй Орка, сен қайда бардың?
Dialogue: 0,0:09:51.85,0:09:55.03,Default,,0,0,0,,Сол нанның дәмі әлі есімде
Dialogue: 0,0:09:57.26,0:10:00.75,Default,,0,0,0,,Бұл жерде болуыма жеткілікті себеп.
Dialogue: 0,0:10:02.26,0:10:03.16,Default,,0,0,0,,Зеб
Dialogue: 0,0:10:04.75,0:10:06.98,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:10:07.30,0:10:08.53,Default,,0,0,0,,Hapoon Bastard
Dialogue: 0,0:10:08.53,0:10:12.38,Default,,0,0,0,,Олар әскери салада ақша табу үшін соғысты бастаған фракциямен араласуға тырысады.
Dialogue: 0,0:10:12.38,0:10:13.47,Default,,0,0,0,,Сен бейбақсың.
Dialogue: 0,0:10:14.03,0:10:15.83,Default,,0,0,0,,Маған қалдырыңыз, Ане-сан.
Dialogue: 0,0:10:15.83,0:10:17.81,Default,,0,0,0,,Хапунның көмекшілері бізге шабуыл жасап жатыр.
Dialogue: 0,0:10:17.81,0:10:20.08,Default,,0,0,0,,Мен сені ұрамын.
Dialogue: 0,0:10:22.33,0:10:23.77,Default,,0,0,0,,Кешіріңіз, бұл өтірік.
Dialogue: 0,0:10:26.24,0:10:27.27,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:10:30.05,0:10:30.87,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:10:31.14,0:10:35.22,Default,,0,0,0,,Сіз маған ертерек бөлмені қағуға белгі беруді ұмытып, есікке жақындадыңыз.
Dialogue: 0,0:10:35.78,0:10:37.32,Default,,0,0,0,,Кешіріңіз, мен абай боламын.
Dialogue: 0,0:10:37.77,0:10:40.85,Default,,0,0,0,,Ертеңгі күнге дайындалу үшін демалыңыз.
Dialogue: 0,0:10:40.85,0:10:43.69,Default,,0,0,0,,Менде есік алдында тұрған жалған болады.
Dialogue: 0,0:10:44.03,0:10:46.21,Default,,0,0,0,,Сіз осындай жағдайда ұйықтай аласыз ба?
Dialogue: 0,0:10:48.61,0:10:49.68,Default,,0,0,0,,мырза.
Dialogue: 0,0:10:49.94,0:10:52.34,Default,,0,0,0,,Мен осы қабаттың айналасына қарағанымда
Dialogue: 0,0:10:53.10,0:10:55.99,Default,,0,0,0,,Мүмкін болса, жау күштерін жойыңыз
Dialogue: 0,0:10:56.52,0:10:58.36,Default,,0,0,0,,Балалар, сендер шынымен таңғажайыпсыңдар.
Dialogue: 0,0:10:58.64,0:11:00.78,Default,,0,0,0,,Өміріңіз мақсатты болса да, сабырлы болыңыз
Dialogue: 0,0:11:00.78,0:11:01.96,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:02.75,0:11:04.56,Default,,0,0,0,,Бұл біздің миссиямыз.
Dialogue: 0,0:11:05.42,0:11:07.75,Default,,0,0,0,,Өлтіру және өлтіру қалыпты жағдай ма?
Dialogue: 0,0:11:07.75,0:11:09.18,Default,,0,0,0,,Мен не айтарымды білмеймін
Dialogue: 0,0:11:09.18,0:11:11.57,Default,,0,0,0,,Соғыс аяқталғанына 10 жылдан астам уақыт өтсе де
Dialogue: 0,0:11:12.12,0:11:14.25,Default,,0,0,0,,Ол әлі де жерде жатыр.
Dialogue: 0,0:11:14.25,0:11:15.79,Default,,0,0,0,,Соғыс дегеніміз не?
Dialogue: 0,0:11:18.98,0:11:22.76,Default,,0,0,0,,Адамдар әлі де адам болғанша, жанжалдың соңы жоқ.
Dialogue: 0,0:11:23.84,0:11:26.21,Default,,0,0,0,,Соғыс уақытында болсын, бейбіт уақытта болсын
Dialogue: 0,0:11:26.81,0:11:29.65,Default,,0,0,0,,Біз әрқашан ел қорғайтын жауынгерміз.
Dialogue: 0,0:11:30.83,0:11:34.69,Default,,0,0,0,,Қажет болса, аяқ дыбысымен сигнал беріңіз, т.б.
Dialogue: 0,0:11:34.69,0:11:36.45,Default,,0,0,0,,Сергек болыңыз
Dialogue: 0,0:11:36.45,0:11:37.45,Default,,0,0,0,,Иә
Dialogue: 0,0:11:37.45,0:11:38.22,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:11:39.32,0:11:40.32,Default,,0,0,0,,Forger-kun
Dialogue: 0,0:11:40.49,0:11:41.72,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:11:42.47,0:11:44.18,Default,,0,0,0,,Миссияға назар аударыңыз
Dialogue: 0,0:11:44.57,0:11:46.23,Default,,0,0,0,,Барлығы өледі.
Dialogue: 0,0:11:54.16,0:11:57.19,Default,,0,0,0,,Уайымдамаңыз, бұл кәсіпқой ма?
Dialogue: 0,0:11:58.01,0:11:59.75,Default,,0,0,0,,Менеджер айтқандай.
Dialogue: 0,0:11:59.75,0:12:01.81,Default,,0,0,0,,Барлығыңыз демалыңыз.
Dialogue: 0,0:12:02.19,0:12:04.07,Default,,0,0,0,,Жай жату жақсы.
Dialogue: 0,0:12:04.56,0:12:06.79,Default,,0,0,0,,Күшімді ертеңге сақтауым керек.
Dialogue: 0,0:12:07.08,0:12:09.90,Default,,0,0,0,,Жылдам қозғалу үшін аяқ киімді киіңіз
Dialogue: 0,0:12:10.51,0:12:11.99,Default,,0,0,0,,Мәңгілік шың тек менікі
Dialogue: 0,0:12:14.03,0:12:15.38,Default,,0,0,0,,Мен шамдарды өшіремін.
Dialogue: 0,0:12:46.67,0:12:47.98,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:12:48.69,0:12:51.70,Default,,0,0,0,,Ақырында мен Ллойд мырзамен және басқалармен байланыса алмадым.
Dialogue: 0,0:12:52.30,0:12:54.51,Default,,0,0,0,,Бұлай емес...
Dialogue: 0,0:13:02.68,0:13:05.44,Default,,0,0,0,,Мүмкін бұл аяқтардың салмағы
Dialogue: 0,0:13:06.88,0:13:10.36,Default,,0,0,0,,Ол жай ғана жарақат алудан қорықты.
Dialogue: 0,0:13:11.67,0:13:15.16,Default,,0,0,0,,Екеуің кешірілмейтін залалды көрсеңдер.
Dialogue: 0,0:13:15.88,0:13:18.51,Default,,0,0,0,,Өйткені мен енді ол үйде тұра алмаймын
Dialogue: 0,0:13:19.53,0:13:21.91,Default,,0,0,0,,Бұл камуфляж үшін қолданылатын отбасы, солай ма?
Dialogue: 0,0:13:25.31,0:13:27.35,Default,,0,0,0,,Дұрыс, Йору.
Dialogue: 0,0:13:27.86,0:13:30.24,Default,,0,0,0,,Басымдылықтарыңызды қате қабылдамаңыз
Dialogue: 0,0:13:34.86,0:13:36.14,Default,,0,0,0,,Біз өлерміз
Dialogue: 0,0:13:39.57,0:13:41.62,Default,,0,0,0,,Мен не үшінмін?
Dialogue: 0,0:13:44.39,0:13:46.97,Default,,0,0,0,,m 0 0 л 0 200 л 400 200 л 400 0 Тікелей қосылым Қашықтықтан қашу, шамамен 20 сағат
Dialogue: 0,0:13:51.48,0:13:52.59,Default,,0,0,0,,Неми
Dialogue: 0,0:13:52.59,0:13:56.35,Default,,0,0,0,,Неліктен мен Коро итімді таңертең ерте күтіп жүрмін?
Dialogue: 0,0:13:57.34,0:13:59.14,Default,,0,0,0,,Бұл «Бофф» емес, бұл ақымақ
Dialogue: 0,0:13:59.14,0:14:02.59,Default,,0,0,0,,Мен үй жануарларын күтуші немесе бала күтуші емеспін.
Dialogue: 0,0:14:02.59,0:14:05.20,Default,,0,0,0,,Мен астыртын ісіммен айналысамын, маған біраз уақыт беріңіз.
Dialogue: 0,0:14:06.02,0:14:07.90,Default,,0,0,0,,Қандай сүйкімді ит
Dialogue: 0,0:14:10.04,0:14:11.58,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:14:11.84,0:14:13.45,Default,,0,0,0,,Охайогозаймас
Dialogue: 0,0:14:14.44,0:14:17.80,Default,,0,0,0,,Мен сізді бірінші рет көріп тұрмын, бірақ сіз осы жерде тұрасыз.
Dialogue: 0,0:14:17.80,0:14:19.40,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:14:20.42,0:14:22.82,Default,,0,0,0,,Біз қайтадан кездесеміз деп үміттенемін.
Dialogue: 0,0:14:26.68,0:14:28.99,Default,,0,0,0,,Менің балам болғың келе ме?
Dialogue: 0,0:14:34.12,0:14:35.73,Default,,0,0,0,,Менің атым Ымырт
Dialogue: 0,0:14:36.29,0:14:38.19,Default,,0,0,0,,Вестеристегі ең жақсы барлау агенті
Dialogue: 0,0:14:38.84,0:14:40.44,Default,,0,0,0,,Қашан және қандай жағдайда
Dialogue: 0,0:14:40.74,0:14:43.31,Default,,0,0,0,,Тіпті өлілердің арасында болса да
Dialogue: 0,0:14:43.63,0:14:46.46,Default,,0,0,0,,Әрқашан сабырлы болуға жаттықты
Dialogue: 0,0:14:47.02,0:14:50.12,Default,,0,0,0,,Бақылау күші Сараптамалық күш Жеңу қабілеті
Dialogue: 0,0:14:50.43,0:14:52.75,Default,,0,0,0,,Барлығын шегіне дейін қайраңыз
Dialogue: 0,0:14:52.75,0:14:55.29,Default,,0,0,0,,Бүгінге дейін мен осы дүниені араладым.
Dialogue: 0,0:14:55.80,0:14:56.58,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:14:56.75,0:14:58.08,Default,,0,0,0,,Мұнда келме
Dialogue: 0,0:14:58.60,0:14:59.84,Default,,0,0,0,,Қарғыс атқыр
Dialogue: 0,0:15:02.72,0:15:04.39,Default,,0,0,0,,Мен бекер болдым
Dialogue: 0,0:15:05.28,0:15:08.29,Default,,0,0,0,,Бұл дүниеде әлі белгісіз нәрселер бар.
Dialogue: 0,0:15:08.93,0:15:12.45,Default,,0,0,0,,Өз ақпаратыңызға және тәжірибеңізге тым көп сенбеңіз
Dialogue: 0,0:15:12.99,0:15:15.22,Default,,0,0,0,,Адам қорқынышының түбірі белгісіз.
Dialogue: 0,0:15:15.52,0:15:18.15,Default,,0,0,0,,Өлім және көзге көрінбейтін жындар
Dialogue: 0,0:15:18.15,0:15:19.64,Default,,0,0,0,,Көрші елдер мен көршілер де
Dialogue: 0,0:15:19.64,0:15:22.43,Default,,0,0,0,,Шынайы тұлғаны білмеу қорқыныш тудырады.
Dialogue: 0,0:15:22.81,0:15:25.86,Default,,0,0,0,,Кейбір адамдар оны түсінбейтін нәрсе ретінде жоққа шығарады.
Dialogue: 0,0:15:26.06,0:15:27.86,Default,,0,0,0,,Немесе көрмеген кейіп таныту
Dialogue: 0,0:15:27.86,0:15:30.98,Default,,0,0,0,,Кейбір адамдар нәрселерді біле тұра таңбалайды.
Dialogue: 0,0:15:30.98,0:15:32.66,Default,,0,0,0,,Жан тыныштығын мақсат етіңіз
Dialogue: 0,0:15:34.60,0:15:35.48,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:15:35.84,0:15:37.08,Default,,0,0,0,,Мен барлау офицерімін
Dialogue: 0,0:15:37.58,0:15:39.37,Default,,0,0,0,,Мен белгісізден қорықпаймын
Dialogue: 0,0:15:39.79,0:15:40.51,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:40.74,0:15:43.55,Default,,0,0,0,,Дұрыс қорқыңыз және дұрыс жауап беріңіз
Dialogue: 0,0:15:44.37,0:15:47.37,Default,,0,0,0,,Ғалымдар қараңғыда нұрды жаққанындай.
Dialogue: 0,0:15:47.75,0:15:50.17,Default,,0,0,0,,Вирустар мен вакциналарды табу сияқты
Dialogue: 0,0:15:52.01,0:15:53.57,Default,,0,0,0,,2-круиз күні
Dialogue: 0,0:15:53.57,0:15:54.46,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:15:54.46,0:15:56.64,Default,,0,0,0,,Мен бұл қиын жағдайдан өтемін
Dialogue: 0,0:16:07.55,0:16:09.16,Default,,0,0,0,,Ойын-сауық тоқтатылды
Dialogue: 0,0:16:09.39,0:16:12.31,Default,,0,0,0,,Ерлі-зайыптылар төбелескен сияқты.
Dialogue: 0,0:16:12.75,0:16:15.11,Default,,0,0,0,,Грей-сама нәжісінің ағып кетуіне байланысты.
Dialogue: 0,0:16:15.11,0:16:16.62,Default,,0,0,0,,Әйелім ашулы
Dialogue: 0,0:16:16.94,0:16:19.25,Default,,0,0,0,,Оның бүгін көңілді көңіл-күйі жоқ сияқты.
Dialogue: 0,0:16:19.25,0:16:21.33,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:16:21.52,0:16:22.98,Default,,0,0,0,,Шақыруға қатысты
Dialogue: 0,0:16:22.98,0:16:24.30,Default,,0,0,0,,Менің ойымша, бұл банкрот.
Dialogue: 0,0:16:25.07,0:16:26.23,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:16:26.23,0:16:28.12,Default,,0,0,0,,Балалар, сендерде ештеңе жоқ.
Dialogue: 0,0:16:28.12,0:16:30.07,Default,,0,0,0,,Мен ерлі-зайыптыларға қамқор боламын.
Dialogue: 0,0:16:30.07,0:16:33.12,Default,,0,0,0,,Бүгінгі күнді еркін өткізіңіз.
Dialogue: 0,0:16:33.12,0:16:34.72,Default,,0,0,0,,Мен... түсінемін.
Dialogue: 0,0:16:34.72,0:16:35.81,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:16:38.05,0:16:40.61,Default,,0,0,0,,Шытырман оқиға
Dialogue: 0,0:16:40.61,0:16:45.77,Default,,0,0,0,,Бүгін де Аняның сапары жалғасуда.
Dialogue: 0,0:16:45.77,0:16:48.32,Default,,0,0,0,,Бақылау үкіміне жауап
Dialogue: 0,0:16:46.54,0:16:48.83,Default,,0,0,0,,Қызықты шытырман оқиға
Dialogue: 0,0:16:48.83,0:16:51.16,Default,,0,0,0,,Вакуваку Танкен
Dialogue: 0,0:16:48.95,0:16:51.29,Default,,0,0,0,,Өлең мәтінінде қандай ойлар жасырылған?
Dialogue: 0,0:16:51.16,0:16:51.82,Default,,0,0,0,,Ю…
Dialogue: 0,0:16:52.37,0:16:54.04,Default,,0,0,0,,Мен кеше ұйықтап қалдым, бірақ
Dialogue: 0,0:16:54.04,0:16:56.78,Default,,0,0,0,,Мен Хаханы тауып, оған көмектесуім керек.
Dialogue: 0,0:16:57.04,0:16:57.83,Default,,0,0,0,,Бірақ
Dialogue: 0,0:16:58.02,0:16:58.70,Default,,0,0,0,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:16:58.70,0:17:02.20,Default,,0,0,0,,Хаха қиыншылықта, мен оған тез барып көмектесуім керек.
Dialogue: 0,0:17:02.20,0:17:04.09,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:17:04.52,0:17:05.29,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:17:05.29,0:17:07.42,Default,,0,0,0,,Йору-сан – жауынгер адам.
Dialogue: 0,0:17:07.65,0:17:10.23,Default,,0,0,0,,Уа, Құдайым!
Dialogue: 0,0:17:10.23,0:17:12.16,Default,,0,0,0,,Мен оны айта алмаймын, өйткені ол айналады
Dialogue: 0,0:17:13.06,0:17:16.20,Default,,0,0,0,,Мен Чичиді бір жерге қоюым керек.
Dialogue: 0,0:17:17.68,0:17:19.74,Default,,0,0,0,,Чичи Гольф ойнайды.
Dialogue: 0,0:17:20.17,0:17:21.19,Default,,0,0,0,,Біз мұны істейміз бе?
Dialogue: 0,0:17:21.42,0:17:23.81,Default,,0,0,0,,Ересектер қандай да бір себептермен гольфты жақсы көреді.
Dialogue: 0,0:17:28.12,0:17:32.41,Default,,0,0,0,,Чичи гольф ойнап жатқанда Аняның жасырын шығу жоспары
Dialogue: 0,0:17:35.78,0:17:38.18,Default,,0,0,0,,Барлық курстар біріктірілген
Dialogue: 0,0:17:38.49,0:17:39.50,Default,,0,0,0,,Браво
Dialogue: 0,0:17:40.56,0:17:42.31,Default,,0,0,0,,Қазірдің өзінде аяқталды
Dialogue: 0,0:17:42.31,0:17:44.23,Default,,0,0,0,,Эй, сен де жасап көр.
Dialogue: 0,0:17:44.49,0:17:45.50,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:17:52.31,0:17:53.21,Default,,0,0,0,,●
Dialogue: 0,0:17:53.21,0:17:54.51,Default,,0,0,0,,Жақсы мақсат қойыңыз.
Dialogue: 0,0:18:00.23,0:18:02.13,Default,,0,0,0,,Түскі асқа аз қалды.
Dialogue: 0,0:18:02.13,0:18:03.77,Default,,0,0,0,,Мен кірмейінше кетпеймін.
Dialogue: 0,0:18:05.21,0:18:07.12,Default,,0,0,0,,Табысты тәжірибе маңызды
Dialogue: 0,0:18:07.37,0:18:09.71,Default,,0,0,0,,Қанағаттанғанша ақырын орындасын.
Dialogue: 0,0:18:09.71,0:18:11.26,Default,,0,0,0,,Сот шешіміне жауап
Dialogue: 0,0:18:11.50,0:18:13.35,Default,,0,0,0,,Қатты айғайласаң, ыңғайсыздық тудырады.
Dialogue: 0,0:18:19.65,0:18:22.80,Default,,0,0,0,,Мен Чичидің тұзағына түсіп, уақытымды босқа өткіздім.
Dialogue: 0,0:18:22.80,0:18:25.42,Default,,0,0,0,,Мен келесі стратегия туралы ойлануым керек.
Dialogue: 0,0:18:25.42,0:18:26.67,Default,,0,0,0,,Тамақты жақсылап шайнаңыз.
Dialogue: 0,0:18:27.02,0:18:28.97,Default,,0,0,0,,Чичи білімді жақсы көреді
Dialogue: 0,0:18:28.97,0:18:31.17,Default,,0,0,0,,Чичи де осында ғашық болатынына сенімдімін.
Dialogue: 0,0:18:33.99,0:18:36.22,Default,,0,0,0,,Мұның бәрі мен бұрыннан оқыған кітаптар.
Dialogue: 0,0:18:39.92,0:18:41.46,Default,,0,0,0,,Бұл қызық болғанша, бәрі осы.
Dialogue: 0,0:18:41.92,0:18:42.93,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:18:45.26,0:18:47.18,Default,,0,0,0,,Пазлдар қызықты
Dialogue: 0,0:18:47.18,0:18:51.06,Default,,0,0,0,,Әкемнің көмегінсіз қиын болатын сияқты.
Dialogue: 0,0:18:52.15,0:18:54.51,Default,,0,0,0,,Менің ойымша, оларды бір қатарға қоюға 2 минут кетеді.
Dialogue: 0,0:18:54.51,0:18:55.47,Default,,0,0,0,,(Ходжинс) Бүгіннен бастап мен Автоматты жазу қуыршағының шәкірті болып жұмыс істеймін.
Dialogue: 0,0:19:01.12,0:19:02.25,Default,,0,0,0,,Бақылау
Dialogue: 0,0:19:05.02,0:19:06.00,Default,,0,0,0,,Бақылау
Dialogue: 0,0:19:11.20,0:19:14.36,Default,,0,0,0,,Кешкі ас кезінде Чичиден қашып құтыла алмады
Dialogue: 0,0:19:14.36,0:19:18.03,Default,,0,0,0,,Дәлірек айтқанда, мен оны жарты жолда ұмытып, ләззат алдым.
Dialogue: 0,0:19:19.40,0:19:20.32,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:19:20.32,0:19:21.90,Default,,0,0,0,,Неге маған қарап тұрсың?
Dialogue: 0,0:19:21.90,0:19:24.05,Default,,0,0,0,,Олар сонша көңілді болса да
Dialogue: 0,0:19:24.05,0:19:26.85,Default,,0,0,0,,Неліктен қазір соншалықты бақытсыз болып көрінесіз?
Dialogue: 0,0:19:27.06,0:19:29.19,Default,,0,0,0,,Мен қателік жібердім бе?
Dialogue: 0,0:19:29.47,0:19:30.60,Default,,0,0,0,,Сабыр ет, ымырт
Dialogue: 0,0:19:30.60,0:19:31.89,Default,,0,0,0,,Белгісізге бет бұрыңыз
Dialogue: 0,0:19:31.89,0:19:32.96,Default,,0,0,0,,Сізді жек көресіз бе?
Dialogue: 0,0:19:32.96,0:19:34.29,Default,,0,0,0,,Сіз бүлікшіл кезеңдесіз бе?
Dialogue: 0,0:19:34.80,0:19:37.54,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, Фолгер отбасы жойылады.
Dialogue: 0,0:19:38.53,0:19:40.70,Default,,0,0,0,,Асқазаныңыз ауырады ма?
Dialogue: 0,0:19:41.11,0:19:41.87,Default,,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:19:42.65,0:19:45.32,Default,,0,0,0,,Аня, сен Чичиге қиындық тудырып жатырсың.
Dialogue: 0,0:19:45.91,0:19:46.87,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:19:47.10,0:19:49.51,Default,,0,0,0,,Аня шытырман оқиғадан ләззат алуда
Dialogue: 0,0:19:50.23,0:19:51.21,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:51.21,0:19:52.36,Default,,0,0,0,,Бұл жақсы болар еді...
Dialogue: 0,0:19:53.66,0:19:56.62,Default,,0,0,0,,Бірақ мен аздап көңілсізмін, өйткені мен араласудың қажеті жоқ.
Dialogue: 0,0:19:57.88,0:20:00.76,Default,,0,0,0,,Аня Чичи мен Хаха бірге болар еді.
Dialogue: 0,0:20:01.10,0:20:04.18,Default,,0,0,0,,Сондықтан мен Ханаға жалғыз өзім баруым керек.
Dialogue: 0,0:20:05.02,0:20:06.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:06.06,0:20:07.22,Default,,0,0,0,,That's right.
Dialogue: 0,0:20:07.22,0:20:09.79,Default,,0,0,0,,Йору-санның да демалыста болғанын қалаймын.
Dialogue: 0,0:20:10.55,0:20:13.33,Default,,0,0,0,,Бұл жігіт әлі кішкентай бала.
Dialogue: 0,0:20:14.43,0:20:17.48,Default,,0,0,0,,Мен Йору-саннан оның ертең бос екенін сұрап көремін.
Dialogue: 0,0:20:18.00,0:20:19.53,Default,,0,0,0,,Мен Хаханың қайда екенін білемін.
Dialogue: 0,0:20:19.81,0:20:20.75,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:20.75,0:20:23.28,Default,,0,0,0,,Бірақ мен консьержден хабарлама қалдыруын өтіндім.
Dialogue: 0,0:20:23.67,0:20:25.97,Default,,0,0,0,,Жауап алсаң, ертең кездесейік.
Dialogue: 0,0:20:25.97,0:20:26.90,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:20:27.58,0:20:28.46,Default,,0,0,0,,Иә.
Dialogue: 0,0:20:28.46,0:20:30.75,Default,,0,0,0,,Жоғарыда отшашулар атылатын сияқты.
Dialogue: 0,0:20:32.20,0:20:34.32,Default,,0,0,0,,Өйткені бұл түнгі басты оқиға.
Dialogue: 0,0:20:34.32,0:20:36.88,Default,,0,0,0,,Мүмкін Йору-сан және басқалары да көруге келеді.
Dialogue: 0,0:20:37.29,0:20:39.57,Default,,0,0,0,,Адамдардың көптігі сонша, менің оларды таба алатыным күмәнді.
Dialogue: 0,0:20:39.57,0:20:40.55,Default,,0,0,0,,Біз барамыз ба?
Dialogue: 0,0:20:40.72,0:20:42.72,Default,,0,0,0,,Отшашулар атылады
Dialogue: 0,0:21:01.11,0:21:01.70,Default,,0,0,0,,Иә
Dialogue: 0,0:21:02.85,0:21:03.36,Default,,0,0,0,,Иә
Dialogue: 0,0:21:05.79,0:21:07.07,Default,,0,0,0,,Бұл менеджерден.
Dialogue: 0,0:21:07.52,0:21:08.78,Default,,0,0,0,,Кездесу кемесінен
Dialogue: 0,0:21:09.04,0:21:11.61,Default,,0,0,0,,Ол дайындық жұмыстарының аяқталғаны туралы хабарлама алғанын айтты.
Dialogue: 0,0:21:12.40,0:21:15.89,Default,,0,0,0,,Байланыс 4 сағаттан кейін орын алады, бірақ дайындық қажет.
Dialogue: 0,0:21:16.12,0:21:20.47,Default,,0,0,0,,Ең бастысы, жау осы палубаның айналасын қоршап алған сияқты.
Dialogue: 0,0:21:20.74,0:21:22.81,Default,,0,0,0,,Бөлмеден шығып, басқа нүктеге барыңыз
Dialogue: 0,0:21:23.51,0:21:24.70,Default,,0,0,0,,Барлығың, киімдеріңді ауыстырыңдар.
Dialogue: 0,0:21:24.70,0:21:25.92,Default,,0,0,0,,Сондай-ақ парик бар.
Dialogue: 0,0:21:25.92,0:21:27.47,Default,,0,0,0,,Мәңгілік шың тек менікі
Dialogue: 0,0:21:29.69,0:21:30.53,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:21:30.53,0:21:31.81,Default,,0,0,0,,Қандай да бір қозғалыс бар ма?
Dialogue: 0,0:21:32.01,0:21:35.05,Default,,0,0,0,,Белгісіз шифрланған байланыс түсірілді
Dialogue: 0,0:21:35.05,0:21:37.94,Default,,0,0,0,,Ол қауіпсіздік станциясының жиілігінен ерекшеленеді.
Dialogue: 0,0:21:37.94,0:21:39.50,Default,,0,0,0,,Бұл олардың сигналы ма?
Dialogue: 0,0:21:39.50,0:21:40.82,Default,,0,0,0,,…қандай зат болмасын, бәрін бомбаға айналдырады.
Dialogue: 0,0:21:41.00,0:21:41.90,Default,,0,0,0,,Жарайды
Dialogue: 0,0:21:42.14,0:21:43.57,Default,,0,0,0,,Барлығына хабарлаңыз
Dialogue: 0,0:21:43.98,0:21:47.03,Default,,0,0,0,,3-кезеңде орналастыру кезінде оларға буксирлеу.
Dialogue: 0,0:21:53.00,0:21:55.23,Default,,0,0,0,,Жарайды, айналада жау белгілері жоқ.
Dialogue: 0,0:21:56.43,0:21:57.26,Default,,0,0,0,,Қандай жағымсыз!
Dialogue: 0,0:21:57.55,0:22:00.97,Default,,0,0,0,,Бұл субтитрді Моечая шығарған. Оны коммерциялық мақсатта пайдалануға болады.
Dialogue: 0,0:22:12.18,0:22:18.98,Default,,0,0,0,,Көру аймағында қою қызыл-қызыл түс пайда болады
Dialogue: 0,0:22:21.86,0:22:29.12,Default,,0,0,0,,Шамамен 40 000 км алға
Dialogue: 0,0:22:32.12,0:22:36.54,Default,,0,0,0,,Артында жақындап келе жатқан өзара жаралар
Dialogue: 0,0:22:36.88,0:22:41.76,Default,,0,0,0,,Адасып кеткен жол мені одан сайын адастырады
Dialogue: 0,0:22:41.76,0:22:46.14,Default,,0,0,0,,Көрінбейтін, иісі сезілмейтін және өзгертілмейтін болашақ
Dialogue: 0,0:22:46.43,0:22:48.35,Default,,0,0,0,,Мен сенің арқаңнан пышақ сұғып алдым!
Dialogue: 0,0:22:49.47,0:22:57.98,Default,,0,0,0,,Бүгін кешке жаныңда болуға рұқсат ет
Dialogue: 0,0:22:59.11,0:23:06.91,Default,,0,0,0,,Мен бүгін кешке байыптымын.
Dialogue: 0,0:23:08.16,0:23:10.62,Default,,0,0,0,,Қосымша ақпарат алу үшін осында келіңіз
Dialogue: 0,0:23:10.62,0:23:12.95,Default,,0,0,0,,Біз дұға еткен болашақ
Dialogue: 0,0:23:12.95,0:23:14.91,Default,,0,0,0,,Жолдар әртүрлі.
Dialogue: 0,0:23:20.13,0:23:22.50,Default,,0,0,0,,Өзара өлтіру ниетімен
Dialogue: 0,0:23:22.50,0:23:25.88,Default,,0,0,0,,Сіз соңғы соққыны аласыз.
Dialogue: 0,0:23:27.30,0:23:30.51,Default,,0,0,0,,Ақыр соңында мен оны тоқтатамын.
Dialogue: 0,0:23:37.98,0:23:40.98,Default,,0,0,0,,Кемедегі әңгіме - Апаның шөп шайы
Dialogue: 0,0:23:42.48,0:23:47.48,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
