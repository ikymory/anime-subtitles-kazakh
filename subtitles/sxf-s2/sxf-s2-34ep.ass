Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:07.82,Default,,0,0,0,,Йорудың басқа беті, Тікенді ханшайым
Dialogue: 0,0:00:08.01,0:00:10.75,Default,,0,0,0,,Бұл жолғы жұмыс - эскорт.
Dialogue: 0,0:00:10.75,0:00:13.57,Default,,0,0,0,,Құқық бұзушы мафия шенеунігін қорғау үшін келісім-шарт жасалған.
Dialogue: 0,0:00:13.57,0:00:16.12,Default,,0,0,0,,Йору сәнді круиздік кемеге отырды.
Dialogue: 0,0:00:16.30,0:00:17.20,Default,,0,0,0,,Екінші жағынан
Dialogue: 0,0:00:17.20,0:00:18.79,Default,,0,0,0,,Джекпот
Dialogue: 0,0:00:19.32,0:00:21.81,Default,,0,0,0,,Аня лотереяда бірінші жүлдені жеңіп алды
Dialogue: 0,0:00:21.81,0:00:26.08,Default,,0,0,0,,Фолгер отбасы бір кемеде аяқталды.
Dialogue: 0,0:00:28.72,0:00:31.51,Default,,0,0,0,,Кемеде көптеген өлтірушілер болды.
Dialogue: 0,0:00:33.09,0:00:35.68,Default,,0,0,0,,Кусаригама Барнаби
Dialogue: 0,0:00:37.99,0:00:40.23,Default,,0,0,0,,Біз не істеуіміз керек? Осылай жалғаса берсе, әбігер болады.
Dialogue: 0,0:00:40.40,0:00:43.36,Default,,0,0,0,,Цирк ханымы өте жақсы
Dialogue: 0,0:00:43.77,0:00:45.48,Default,,0,0,0,,Жақсы Аня-сан
Dialogue: 0,0:00:45.48,0:00:49.28,Default,,0,0,0,,Аня Ллойдты Йордың шынайы тұлғасын білмеуге тырысады.
Dialogue: 0,0:00:49.28,0:00:50.78,Default,,0,0,0,,Батыл Аня
Dialogue: 0,0:00:50.78,0:00:54.62,Default,,0,0,0,,Мен соңғы шытырман оқиға үшін жүрегімнің соғуын басқара алмаймын.
Dialogue: 0,0:00:54.91,0:00:56.13,Default,,0,0,0,,Қарғыс атқыр
Dialogue: 0,0:00:57.05,0:00:59.79,Default,,0,0,0,,Йору өлтірушілердің шабуылдарынан жалтаруды жалғастыруда
Dialogue: 0,0:01:00.15,0:01:02.16,Default,,0,0,0,,Мен не үшінмін?
Dialogue: 0,0:01:03.80,0:01:05.44,Default,,0,0,0,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,0:01:05.82,0:01:07.55,Default,,0,0,0,,Отшашу кезінде
Dialogue: 0,0:01:07.55,0:01:11.01,Default,,0,0,0,,Йору мен өлтірушілер арасында өлімге әкелетін шайқас болады.
Dialogue: 0,0:01:11.17,0:01:15.39,Default,,0,0,0,,Мен сол баланың асыл өмірін ғана қорғағым келді.
Dialogue: 0,0:01:15.85,0:01:17.55,Default,,0,0,0,,Бұдан былай өзгермейді.
Dialogue: 0,0:01:17.55,0:01:19.81,Default,,0,0,0,,Жоқ, енді көбірек.
Dialogue: 0,0:01:20.21,0:01:22.52,Default,,0,0,0,,Ллойд мырзаның мақұлдайтынына сенімдімін.
Dialogue: 0,0:01:22.97,0:01:23.81,Default,,0,0,0,,Мені кешір
Dialogue: 0,0:01:26.10,0:01:27.65,Default,,0,0,0,,Мен күресемін
Dialogue: 0,0:01:28.64,0:01:29.72,Default,,0,0,0,,Мен тоқтамаймын
Dialogue: 0,0:01:41.50,0:01:44.04,Default,,0,0,0,,Сұрақ қою батыл әрекет
Dialogue: 0,0:01:44.04,0:01:46.63,Default,,0,0,0,,Сұрақ Басқаларсыз өмір
Dialogue: 0,0:01:46.63,0:01:49.17,Default,,0,0,0,,Сатқындық пен бейбітшілікке сұрақ
Dialogue: 0,0:01:49.17,0:01:51.38,Default,,0,0,0,,Сұрақ не?
Dialogue: 0,0:01:51.67,0:01:53.55,Default,,0,0,0,,Дүние екіге бөлінген
Dialogue: 0,0:01:53.55,0:01:56.22,Default,,0,0,0,,Әрбір жасырын әділдік болып табылады
Dialogue: 0,0:01:56.80,0:01:58.68,Default,,0,0,0,,Гарандого қарсы тұру
Dialogue: 0,0:01:58.68,0:02:00.43,Default,,0,0,0,,Үйілген және қабаттастырылған
Dialogue: 0,0:02:00.43,0:02:01.93,Default,,0,0,0,,Екі жақты екі бет
Dialogue: 0,0:02:02.81,0:02:04.85,Default,,0,0,0,,Парасаттылық, төмендік және сахна артындағы
Dialogue: 0,0:02:05.35,0:02:07.06,Default,,0,0,0,,Мұның соңы немесе ақыры маңызды емес.
Dialogue: 0,0:02:07.94,0:02:09.23,Default,,0,0,0,,Дәл уақыт өте стандарт болып табылады
Dialogue: 0,0:02:09.23,0:02:11.07,Default,,0,0,0,,Мен бұл туралы бірдеңе жасадым.
Dialogue: 0,0:02:11.07,0:02:15.36,Default,,0,0,0,,Crazy әңгіме, бәрі әлдеқашан шешілген сияқты
Dialogue: 0,0:02:15.36,0:02:18.08,Default,,0,0,0,,Ерекшеліксіз қалыптан тыс жағдай
Dialogue: 0,0:02:18.08,0:02:20.74,Default,,0,0,0,,Әдетте ешқандай себепсіз
Dialogue: 0,0:02:21.58,0:02:24.08,Default,,0,0,0,,Дұрыс пен бұрыс тұрақсыз
Dialogue: 0,0:02:24.08,0:02:26.96,Default,,0,0,0,,Іштен шыққан шынайы сезімдер жинақталады
Dialogue: 0,0:02:26.96,0:02:29.25,Default,,0,0,0,,Кейде оны қорытуға мүмкіндік болмайды.
Dialogue: 0,0:02:29.25,0:02:31.76,Default,,0,0,0,,Сіз мұны байқамай қарсы аласыз ба?
Dialogue: 0,0:02:31.76,0:02:34.55,Default,,0,0,0,,Қайғылы емеспін, бірақ бәрібір осылай
Dialogue: 0,0:02:34.55,0:02:36.93,Default,,0,0,0,,Мен 100% білмеймін
Dialogue: 0,0:02:36.93,0:02:41.89,Default,,0,0,0,,Мен өз уайымымнан құтылсам екен деп тілеймін, тілеймін және мұңайдым.
Dialogue: 0,0:02:41.89,0:02:44.56,Default,,0,0,0,,Егер бұл перде желбіресе
Dialogue: 0,0:02:44.56,0:02:47.27,Default,,0,0,0,,Идеалдар мен шындық теңселеді
Dialogue: 0,0:02:49.19,0:02:51.69,Default,,0,0,0,,Сұрақ қою батыл әрекет
Dialogue: 0,0:02:51.69,0:02:54.19,Default,,0,0,0,,Сұрақ Басқаларсыз өмір
Dialogue: 0,0:02:54.19,0:02:56.86,Default,,0,0,0,,Сатқындық пен бейбітшілікке сұрақ
Dialogue: 0,0:02:56.86,0:02:58.07,Default,,0,0,0,,Сұрақ не?
Dialogue: 0,0:03:01.49,0:03:06.00,Default,,0,0,0,,Футуристік қол
Dialogue: 0,0:03:22.44,0:03:24.32,Default,,0,0,0,,Отшашулар әдемі болды
Dialogue: 0,0:03:24.61,0:03:25.74,Default,,0,0,0,,Жақсы, онда
Dialogue: 0,0:03:26.00,0:03:27.13,Default,,0,0,0,,Бірақ кешіріңіз
Dialogue: 0,0:03:27.42,0:03:29.39,Default,,0,0,0,,Йору мырзаны табу мүмкін болмады.
Dialogue: 0,0:03:29.71,0:03:31.53,Default,,0,0,0,,Күтілгендей, кеме тым кең.
Dialogue: 0,0:03:33.72,0:03:36.28,Default,,0,0,0,,Мен анамды мүлде ұмыттым.
Dialogue: 0,0:03:36.67,0:03:38.16,Default,,0,0,0,,Мен оны жақын арада іздеуім керек.
Dialogue: 0,0:03:42.13,0:03:45.20,Default,,0,0,0,,Қауіпсіздік қызметкерлері асығыс қозғалып жатқан сияқты.
Dialogue: 0,0:03:45.55,0:03:46.56,Default,,0,0,0,,Менің заттарыма тиіспеңіз
Dialogue: 0,0:03:47.49,0:03:52.40,Default,,0,0,0,,«Егер сіз тезірек біреуді бөлмеге кіргізе алсаңыз».
Dialogue: 0,0:03:53.10,0:03:54.63,Default,,0,0,0,,«Кеме түбіндегі бомба»
Dialogue: 0,0:03:55.04,0:03:56.47,Default,,0,0,0,,Қорқып қалмаңдар
Dialogue: 0,0:03:56.95,0:03:57.80,Default,,0,0,0,,Кім
Dialogue: 0,0:03:58.01,0:03:59.26,Default,,0,0,0,,Қандай мақсатпен?
Dialogue: 0,0:03:59.62,0:04:00.52,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:04:00.52,0:04:02.19,Default,,0,0,0,,Ақпарат жинау керек пе?
Dialogue: 0,0:04:02.19,0:04:05.34,Default,,0,0,0,,Жоқ, қауіпсіздік қызметкерлері бұл туралы бірдеңе жасайтынына сенімдімін.
Dialogue: 0,0:04:05.62,0:04:07.98,Default,,0,0,0,,Басыңызды қою тәуекелмен бірге жүреді.
Dialogue: 0,0:04:08.68,0:04:10.72,Default,,0,0,0,,Бірақ жағдайға байланысты
Dialogue: 0,0:04:11.08,0:04:13.00,Default,,0,0,0,,Үлкен тәуекелдерді ескере отырып
Dialogue: 0,0:04:13.00,0:04:14.48,Default,,0,0,0,,Арқа мен қарынды ауыстыру мүмкін емес
Dialogue: 0,0:04:15.37,0:04:17.05,Default,,0,0,0,,Бірақ Аняны артта қалдырмаңыз.
Dialogue: 0,0:04:17.05,0:04:17.73,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:04:18.06,0:04:18.81,Default,,0,0,0,,Остания үкіметінің негізгі тұлғаларының қозғалысын бақылау үшін
Dialogue: 0,0:04:19.28,0:04:21.72,Default,,0,0,0,,Аня әлі де көңіл көтерген жоқ
Dialogue: 0,0:04:23.44,0:04:24.65,Default,,0,0,0,,Осындай кездерде
Dialogue: 0,0:04:24.65,0:04:28.29,Default,,0,0,0,,Аня сонда ойнап жатыр, Чичи, бөлмеңе қайт.
Dialogue: 0,0:04:29.55,0:04:32.06,Default,,0,0,0,,Күндізгі күтім орталығы? Бұл ыңғайлы.
Dialogue: 0,0:04:32.32,0:04:33.29,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:04:33.79,0:04:35.92,Default,,0,0,0,,Ал, мен сені сәлден кейін алып кетемін.
Dialogue: 0,0:04:35.92,0:04:36.88,Default,,0,0,0,,Осы жерде болыңыз
Dialogue: 0,0:04:38.57,0:04:40.51,Default,,0,0,0,,Өтінемін, қызыма қамқор бол.
Dialogue: 0,0:04:41.07,0:04:42.28,Default,,0,0,0,,Менің атым Аня.
Dialogue: 0,0:04:42.54,0:04:43.77,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:04:44.74,0:04:46.39,Default,,0,0,0,,Доп ойнау
Dialogue: 0,0:04:48.11,0:04:49.97,Default,,0,0,0,,Жарайды, қазір.
Dialogue: 0,0:04:50.43,0:04:52.54,Default,,0,0,0,,Жарайды, Аня-чан.
Dialogue: 0,0:04:52.54,0:04:53.90,Default,,0,0,0,,Біз не ойнауымыз керек?
Dialogue: 0,0:04:54.09,0:04:56.50,Default,,0,0,0,,Аня доп ойнайды
Dialogue: 0,0:04:56.50,0:04:58.88,Default,,0,0,0,,Иә, бұл таңқаларлық.
Dialogue: 0,0:04:58.88,0:05:00.59,Default,,0,0,0,,Мен жақын арада жалықтым
Dialogue: 0,0:05:01.52,0:05:02.34,Default,,0,0,0,,Жалықты
Dialogue: 0,0:05:02.68,0:05:04.89,Default,,0,0,0,,Дұрыс, мен одан шаршадым.
Dialogue: 0,0:05:04.89,0:05:06.66,Default,,0,0,0,,Аня Мен сурет салғым келеді
Dialogue: 0,0:05:06.97,0:05:09.16,Default,,0,0,0,,Жарайды, күте тұрыңыз.
Dialogue: 0,0:05:10.94,0:05:12.92,Default,,0,0,0,,Иә, онда не салуым керек?
Dialogue: 0,0:05:13.70,0:05:15.16,Default,,0,0,0,,Осымен.
Dialogue: 0,0:05:15.74,0:05:16.98,Default,,0,0,0,,Жоқ, мен ауылдағы үшінші сортты мектепке бардым.
Dialogue: 0,0:05:28.06,0:05:30.20,Default,,0,0,0,,Қызық, оны жоюға болады ма?
Dialogue: 0,0:05:30.20,0:05:32.24,Default,,0,0,0,,Үндетпе, мен шоғырланып жатырмын.
Dialogue: 0,0:05:32.44,0:05:35.46,Default,,0,0,0,,Өтінемін, бұл кемеде үлкен адам бар ...
Dialogue: 0,0:05:35.46,0:05:37.27,Default,,0,0,0,,Маған үндемеңіз
Dialogue: 0,0:05:37.65,0:05:40.24,Default,,0,0,0,,Мен бұл жерде бомба бар деп естідім.
Dialogue: 0,0:05:41.42,0:05:42.57,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:05:44.20,0:05:44.99,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:05:45.48,0:05:47.46,Default,,0,0,0,,Мен бұрынғы теңіз батальонымын.
Dialogue: 0,0:05:47.46,0:05:50.33,Default,,0,0,0,,Ол жарылғыш заттарды залалсыздандыруға жауапты болды.
Dialogue: 0,0:05:50.33,0:05:52.04,Default,,0,0,0,,Қаласаңыз, маған көмектесіңіз.
Dialogue: 0,0:05:53.42,0:05:56.37,Default,,0,0,0,,Бұдан былай біз жасай алатын нәрсе - бұл бомба.
Dialogue: 0,0:05:56.37,0:05:57.54,Default,,0,0,0,,Сендер, қылыштарыңды тартыңдар!
Dialogue: 0,0:05:57.85,0:05:59.56,Default,,0,0,0,,Тұзақ орнатылды.
Dialogue: 0,0:05:59.95,0:06:03.12,Default,,0,0,0,,Бұл уақыт белгіленген түрі B-CP62 түрі ме?
Dialogue: 0,0:06:03.40,0:06:06.09,Default,,0,0,0,,Бұл батыс экстремистері ұнататын түрі.
Dialogue: 0,0:06:06.09,0:06:09.83,Default,,0,0,0,,Кінәлі Шығыстың маңызды адамы ма?Осы кемені көздеп отыр.
Dialogue: 0,0:06:09.83,0:06:13.32,Default,,0,0,0,,Жоқ, мен барлау бөлімінен мұндай адамдардың болғанын естіген емеспін.
Dialogue: 0,0:06:13.32,0:06:16.56,Default,,0,0,0,,Сондай-ақ бұл Батыстың жұмысына ұқсайтын бетперде болуы мүмкін.
Dialogue: 0,0:06:16.56,0:06:17.94,Default,,0,0,0,,Ей, не болып жатыр?
Dialogue: 0,0:06:18.25,0:06:19.57,Default,,0,0,0,,Бұл әбден мүмкін бе?
Dialogue: 0,0:06:22.29,0:06:23.76,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:06:25.23,0:06:28.14,Default,,0,0,0,,Бомбаны Чичи мен Аняға қалдырыңыз хахаха
Dialogue: 0,0:06:28.41,0:06:29.21,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:06:30.84,0:06:34.21,Default,,0,0,0,,Есімдегі барлық өлтірушілерді өлтіру
Dialogue: 0,0:06:34.21,0:06:35.83,Default,,0,0,0,,Ол қорқынышты әйел.
Dialogue: 0,0:06:36.42,0:06:37.85,Default,,0,0,0,,Жаман жігіттің дауысы
Dialogue: 0,0:06:38.54,0:06:39.84,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:06:40.65,0:06:43.70,Default,,0,0,0,,Мен жеткілікті ақша таптым.
Dialogue: 0,0:06:43.70,0:06:47.09,Default,,0,0,0,,Гиена жақындағанша тез шегініңіз.
Dialogue: 0,0:06:47.35,0:06:51.60,Default,,0,0,0,,Қалған уақытыңызда балалар, кем дегенде, сол жерде ойнау керек.
Dialogue: 0,0:06:51.85,0:06:53.60,Default,,0,0,0,,Кеменің алдыңғы жағы
Dialogue: 0,0:06:53.60,0:06:57.07,Default,,0,0,0,,Бұл кеме жақын арада осы мұхитқа батады.
Dialogue: 0,0:06:57.07,0:07:00.40,Default,,0,0,0,,Мен өлгенше не болғанын білмеймін.
Dialogue: 0,0:07:01.22,0:07:02.96,Default,,0,0,0,,Жаман жігітті көрмей қалдым.
Dialogue: 0,0:07:03.20,0:07:04.14,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:04.14,0:07:05.90,Default,,0,0,0,,Қазір Хаханың орнында
Dialogue: 0,0:07:06.43,0:07:09.54,Default,,0,0,0,,Алдыңғы төбе Алдыңғы төбе
Dialogue: 0,0:07:16.94,0:07:19.51,Default,,0,0,0,,Бұл сұмдық
Dialogue: 0,0:07:27.50,0:07:28.45,Default,,0,0,0,,Жетпейді
Dialogue: 0,0:07:29.99,0:07:35.43,Default,,0,0,0,,Ақылға сыйымсыздық
Dialogue: 0,0:07:35.43,0:07:40.75,Default,,0,0,0,,бүкіл әлемде өтірік айту
Dialogue: 0,0:07:37.59,0:07:39.73,Default,,0,0,0,,Мен оны аяқтай алмаймын, өйткені қолым жетпейді.
Dialogue: 0,0:07:41.19,0:07:46.91,Default,,0,0,0,,Оған қарау оны мүлдем өзгертпейді
Dialogue: 0,0:07:43.14,0:07:45.26,Default,,0,0,0,,Хаха мен осының үстіндемін
Dialogue: 0,0:07:45.26,0:07:47.25,Default,,0,0,0,,Қарусыз күресу
Dialogue: 0,0:07:46.91,0:07:52.35,Default,,0,0,0,,Неліктен біз бұл трагедияны бастадық?
Dialogue: 0,0:07:47.25,0:07:49.11,Default,,0,0,0,,Мен жақсы ести алмаймын, өйткені ол алыс.
Dialogue: 0,0:07:49.33,0:07:51.57,Default,,0,0,0,,Қайда көтерілу керек Қайда көтерілу керек
Dialogue: 0,0:07:52.35,0:07:57.08,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә? Мен мұның бәрін ұмыттым
Dialogue: 0,0:07:57.08,0:07:59.81,Default,,0,0,0,,Аня Хахаға көмектеседі
Dialogue: 0,0:07:58.16,0:08:03.67,Default,,0,0,0,,Неліктен біз мұны істей бердік?
Dialogue: 0,0:08:00.83,0:08:03.48,Default,,0,0,0,,Жеткізу
Dialogue: 0,0:08:03.48,0:08:08.56,Default,,0,0,0,,Үмітті басып алу
Dialogue: 0,0:08:03.67,0:08:08.81,Default,,0,0,0,,Мен қарапайым өмірді қаладым
Dialogue: 0,0:08:21.12,0:08:22.68,Default,,0,0,0,,Ешқандай шу шығармаңыз
Dialogue: 0,0:08:22.68,0:08:24.11,Default,,0,0,0,,Мен емес
Dialogue: 0,0:08:24.11,0:08:25.53,Default,,0,0,0,,Қазір дыбыс қандай?
Dialogue: 0,0:08:25.78,0:08:28.64,Default,,0,0,0,,Егер әлгі құбыжық әйел байқаса, бітті.
Dialogue: 0,0:08:28.64,0:08:29.77,Default,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,0:08:29.77,0:08:32.28,Default,,0,0,0,,Қазір уақыт, мен катана адамымен қиналып жүрмін.
Dialogue: 0,0:08:32.74,0:08:33.66,Default,,0,0,0,,Осы сәтте
Dialogue: 0,0:08:33.66,0:08:35.94,Default,,0,0,0,,Мақсат Глецшер
Dialogue: 0,0:08:37.20,0:08:39.73,Default,,0,0,0,,Бұл мәңгілікке қалмайды.
Dialogue: 0,0:08:40.99,0:08:43.46,Default,,0,0,0,,Өлтіргеннен кейін дереу кетіңіз.
Dialogue: 0,0:08:43.91,0:08:44.66,Default,,0,0,0,,Кеттік
Dialogue: 0,0:09:00.23,0:09:04.27,Default,,0,0,0,,Жоспарланғандай Менің жоғалтатын ештеңем жоқ
Dialogue: 0,0:09:04.27,0:09:07.15,Default,,0,0,0,,Неліктен бастадым?
Dialogue: 0,0:09:04.61,0:09:05.82,Default,,0,0,0,,Артымнан оқ атылды
Dialogue: 0,0:09:07.15,0:09:10.99,Default,,0,0,0,,Мен неге жалғастырдым?
Dialogue: 0,0:09:08.34,0:09:09.32,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:09:11.53,0:09:15.53,Default,,0,0,0,,Жауап әрқашан менің ішімде
Dialogue: 0,0:09:15.53,0:09:22.32,Default,,0,0,0,,Бұдан былай мен ешқашан шатастырмаймын
Dialogue: 0,0:09:23.78,0:09:29.55,Default,,0,0,0,,Маған оның бос әурешілік екені маңызды емес
Dialogue: 0,0:09:26.11,0:09:26.91,Default,,0,0,0,,Кой
Dialogue: 0,0:09:27.65,0:09:30.33,Default,,0,0,0,,Мен сені келесі соққыммен аяқтаймын.
Dialogue: 0,0:09:29.55,0:09:34.89,Default,,0,0,0,,Қайғы мен қайғы аспаннан тыс
Dialogue: 0,0:09:34.89,0:09:45.56,Default,,0,0,0,,Мен сен үшін бәрін жасаймын
Dialogue: 0,0:09:40.44,0:09:42.79,Default,,0,0,0,,Ақымақ сияқты алға ұмтылу
Dialogue: 0,0:09:45.56,0:09:51.22,Default,,0,0,0,,Соңына дейін
Dialogue: 0,0:09:49.35,0:09:50.81,Default,,0,0,0,,Сен қол белгілері арқылы байланысасың.
Dialogue: 0,0:10:20.77,0:10:22.94,Default,,0,0,0,,Хаха шайқасына не болды?
Dialogue: 0,0:10:25.28,0:10:27.97,Default,,0,0,0,,Мен біттім. Мен шаршадым.
Dialogue: 0,0:10:30.96,0:10:34.12,Default,,0,0,0,,Хаха жеңіс Аняның арқасында
Dialogue: 0,0:10:34.34,0:10:36.67,Default,,0,0,0,,Біз оркаларды шығаруымыз керек.
Dialogue: 0,0:10:44.01,0:10:45.86,Default,,0,0,0,,Сәтті шығарылым.
Dialogue: 0,0:10:48.50,0:10:49.81,Default,,0,0,0,,Бұл үлкен!
Dialogue: 0,0:10:49.81,0:10:50.50,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:50.93,0:10:55.40,Default,,0,0,0,,Мен бомбадан гөрі қауіпсіздік агенттерінің қоршауында жүргеніме алаңдаймын...
Dialogue: 0,0:10:59.11,0:10:59.86,Default,,0,0,0,,●
Dialogue: 0,0:11:03.55,0:11:06.76,Default,,0,0,0,,Лорелай ханшайымымен қоштасу
Dialogue: 0,0:11:06.76,0:11:11.58,Default,,0,0,0,,Батып кетудің соңғы азабын толық сезінгеніңізді естуге рұқсат етіңіз.
Dialogue: 0,0:11:24.79,0:11:29.27,Default,,0,0,0,,Бірақ неге менің қаруым сонда жатты?
Dialogue: 0,0:11:30.24,0:11:32.22,Default,,0,0,0,,Басқа біреу...
Dialogue: 0,0:11:33.07,0:11:35.56,Default,,0,0,0,,Нашар бас тарту
Dialogue: 0,0:11:40.11,0:11:42.32,Default,,0,0,0,,Оны жел ұшырып әкеткен болуы керек.
Dialogue: 0,0:11:43.48,0:11:46.34,Default,,0,0,0,,Менеджер мырза, жақсысыз ба?
Dialogue: 0,0:11:50.11,0:11:52.27,Default,,0,0,0,,Әлі де бірнеше бомба бар
Dialogue: 0,0:11:52.46,0:11:55.99,Default,,0,0,0,,Егер оның мақсаты кемені суға батыру болса ше?
Dialogue: 0,0:11:55.99,0:11:58.81,Default,,0,0,0,,Мылтықтың бұл мөлшері бұл орын үшін тым аз.
Dialogue: 0,0:12:00.29,0:12:02.45,Default,,0,0,0,,Сақтық шарасы ретінде жолаушыларды эвакуациялаңыз.
Dialogue: 0,0:12:02.45,0:12:03.55,Default,,0,0,0,,Қайда?
Dialogue: 0,0:12:03.55,0:12:06.19,Default,,0,0,0,,Біз олардың қайда отырғызылғанын және қанша екенін білмейміз.
Dialogue: 0,0:12:06.19,0:12:08.69,Default,,0,0,0,,Ал жолаушылардың бәрі маңызды адамдар.
Dialogue: 0,0:12:08.69,0:12:10.54,Default,,0,0,0,,Біз дүрбелең тудыра алмаймыз.
Dialogue: 0,0:12:10.77,0:12:12.61,Default,,0,0,0,,Бұл Қауіпсіздік бюросының бет-бейнесі ме?
Dialogue: 0,0:12:12.61,0:12:15.13,Default,,0,0,0,,Саған айтсам білесің.
Dialogue: 0,0:12:15.87,0:12:19.17,Default,,0,0,0,,Бос кез келген адам кемені тексерсін.
Dialogue: 0,0:12:19.17,0:12:20.10,Default,,0,0,0,,Экипаж да
Dialogue: 0,0:12:21.09,0:12:23.61,Default,,0,0,0,,Үлкен жігіттер ешқашан түсінбейді.
Dialogue: 0,0:12:30.28,0:12:34.24,Default,,0,0,0,,Асықпасаңыз, балалар бөлмесіндегі келіншек сізге ұрысады.
Dialogue: 0,0:12:36.51,0:12:38.43,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:12:38.43,0:12:40.54,Default,,0,0,0,,Мен оқты шығаруым керек.
Dialogue: 0,0:12:40.54,0:12:43.69,Default,,0,0,0,,Тікелей шабуыл жақсы емес, өзіңізді бір рет дайындаңыз.
Dialogue: 0,0:12:44.01,0:12:46.17,Default,,0,0,0,,Мен сені міндетті түрде өлтіремін
Dialogue: 0,0:12:49.93,0:12:51.12,Default,,0,0,0,,Мен шын мәнінде айта алмаймын.
Dialogue: 0,0:12:51.94,0:12:53.32,Default,,0,0,0,,Қандай жынсыз
Dialogue: 0,0:12:57.01,0:12:58.65,Default,,0,0,0,,Бұл иіс
Dialogue: 0,0:12:59.27,0:13:00.51,Default,,0,0,0,,Жарылғыш заттар
Dialogue: 0,0:13:01.52,0:13:03.38,Default,,0,0,0,,Сағат ішіндегі бомба
Dialogue: 0,0:13:03.38,0:13:06.35,Default,,0,0,0,,Чичи іздегеннен көп нәрсе бар.
Dialogue: 0,0:13:06.63,0:13:08.75,Default,,0,0,0,,Мен бұл бейбақты ешқашан күтпедім...
Dialogue: 0,0:13:13.20,0:13:14.33,Default,,0,0,0,,«Қиын екен.»
Dialogue: 0,0:13:14.33,0:13:16.05,Default,,0,0,0,,Мен Чичиге хабарлауым керек.
Dialogue: 0,0:13:16.05,0:13:18.65,Default,,0,0,0,,Бірақ бұл жолы Чичидің қайда екенін білмеймін.
Dialogue: 0,0:13:18.65,0:13:22.22,Default,,0,0,0,,Мен Чичиге айта алмаймын, өйткені көп нәрсе белгілі болады.
Dialogue: 0,0:13:23.07,0:13:25.91,Default,,0,0,0,,Бұл қорқынышты. Кеменің ішінде бомба бар.
Dialogue: 0,0:13:25.91,0:13:28.59,Default,,0,0,0,,Төменгі палубаларға назар аудару керек десе де
Dialogue: 0,0:13:28.59,0:13:29.90,Default,,0,0,0,,Жердің қай жерінде?
Dialogue: 0,0:13:29.90,0:13:31.23,Default,,0,0,0,,Қиындық тудырғаным үшін кешір.
Dialogue: 0,0:13:33.20,0:13:34.67,Default,,0,0,0,,Бұл не, жас ханым?
Dialogue: 0,0:13:35.02,0:13:38.31,Default,,0,0,0,,Мен танымайтын ақсақал сол сағатқа жаңа ғана қолын тигізді...
Dialogue: 0,0:13:38.31,0:13:40.90,Default,,0,0,0,,Хана боқпен бірге ойнады.
Dialogue: 0,0:13:40.90,0:13:42.93,Default,,0,0,0,,Оны тазалаңыз.
Dialogue: 0,0:13:43.12,0:13:44.25,Default,,0,0,0,,Ханакусо
Dialogue: 0,0:13:44.67,0:13:46.07,Default,,0,0,0,,Кешіріңіз, қыз.
Dialogue: 0,0:13:46.07,0:13:47.62,Default,,0,0,0,,Мен қазір бос емеспін.
Dialogue: 0,0:13:50.09,0:13:53.08,Default,,0,0,0,,Жоқ, осы уақытта күдікті адам туралы ақпарат.
Dialogue: 0,0:13:53.08,0:13:56.69,Default,,0,0,0,,Бұл екіталай, бірақ мен оны тексергім келеді.
Dialogue: 0,0:13:57.33,0:13:58.23,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:13:58.48,0:13:59.90,Default,,0,0,0,,Мен қарап көрейін.
Dialogue: 0,0:14:01.09,0:14:02.47,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:14:02.72,0:14:04.98,Default,,0,0,0,,Бұрынғы отшашулар таң қалдырды.
Dialogue: 0,0:14:05.32,0:14:07.36,Default,,0,0,0,,Кешіріңіз, тұтынушы.
Dialogue: 0,0:14:07.59,0:14:09.02,Default,,0,0,0,,Ертең аралда
Dialogue: 0,0:14:11.46,0:14:12.96,Default,,0,0,0,,Жақсы сезімталдық
Dialogue: 0,0:14:13.18,0:14:15.46,Default,,0,0,0,,Өтінемін, артық етпеңіз, менеджер.
Dialogue: 0,0:14:15.85,0:14:18.46,Default,,0,0,0,,Үстіңгі жағы жойылған сияқты.
Dialogue: 0,0:14:25.39,0:14:27.43,Default,,0,0,0,,Йокими-кун
Dialogue: 0,0:14:27.43,0:14:29.72,Default,,0,0,0,,Жалғыз қайда барасың?
Dialogue: 0,0:14:30.76,0:14:32.32,Default,,0,0,0,,Ол тірі болды ма?
Dialogue: 0,0:14:32.32,0:14:34.84,Default,,0,0,0,,Бомба Теменің жұмысы болды.
Dialogue: 0,0:14:34.84,0:14:37.37,Default,,0,0,0,,Бізді де ұшыруды жоспарладыңыз ба?
Dialogue: 0,0:14:37.60,0:14:39.85,Default,,0,0,0,,Жеңілген сарбаздар дүркіретпесін
Dialogue: 0,0:14:39.85,0:14:43.83,Default,,0,0,0,,Бұл мақсат пен бақты теңіз балдырына азайтуға мүмкіндік емес пе?
Dialogue: 0,0:14:43.83,0:14:47.81,Default,,0,0,0,,Мен сіз жолаушылардың кейбірі сіздің клиенттеріңіз деп айттыңыз деп ойладым.
Dialogue: 0,0:14:47.81,0:14:50.12,Default,,0,0,0,,Менің ойымша, олар соншалықты үлкен топ емес.
Dialogue: 0,0:14:50.35,0:14:51.53,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:14:51.53,0:14:54.48,Default,,0,0,0,,Бомба батыстық бомба ретінде жасырылған.
Dialogue: 0,0:14:54.48,0:14:56.29,Default,,0,0,0,,Егер ол жақсы оралса
Dialogue: 0,0:14:56.29,0:14:59.72,Default,,0,0,0,,Қару-жарақ соғыс басталғанда ессіздер сияқты сатылды.
Dialogue: 0,0:14:59.72,0:15:01.88,Default,,0,0,0,,Клиент де бақытты болады.
Dialogue: 0,0:15:02.19,0:15:03.35,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:15:03.35,0:15:05.52,Default,,0,0,0,,Қайықты шығыңыз, қайта құрайық.
Dialogue: 0,0:15:06.11,0:15:08.27,Default,,0,0,0,,Ол мені мінгіземін деп кім айтты?
Dialogue: 0,0:15:08.27,0:15:12.39,Default,,0,0,0,,Бұл кеме тек бір адамға жететін су мен азық-түлікті тасымалдайды.
Dialogue: 0,0:15:12.70,0:15:14.38,Default,,0,0,0,,Өзің бар
Dialogue: 0,0:15:14.38,0:15:16.61,Default,,0,0,0,,Бұл менікі.
Dialogue: 0,0:15:18.80,0:15:21.61,Default,,0,0,0,,Үшінші жүк қоймасы және балласт цистернасының жоғарғы бөлігі
Dialogue: 0,0:15:21.61,0:15:24.65,Default,,0,0,0,,Шамасы, қазандықта да бомба табылған.
Dialogue: 0,0:15:25.87,0:15:27.33,Default,,0,0,0,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,0:15:28.24,0:15:32.16,Default,,0,0,0,,Егер бұл құрылым болса, оны сол адам жасаған болуы мүмкін.
Dialogue: 0,0:15:32.56,0:15:36.04,Default,,0,0,0,,Мен айтқан тұзақ әдеттерінен сақ болыңыз.
Dialogue: 0,0:15:37.22,0:15:38.42,Default,,0,0,0,,Келесі
Dialogue: 0,0:15:39.75,0:15:42.42,Default,,0,0,0,,Сондай-ақ жоғарғы 8-ші палубада
Dialogue: 0,0:15:45.47,0:15:46.61,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:15:47.35,0:15:48.81,Default,,0,0,0,,Осындай қалың топта
Dialogue: 0,0:15:48.81,0:15:51.24,Default,,0,0,0,,Мақсат кемені суға батыру емес пе?
Dialogue: 0,0:15:51.24,0:15:53.85,Default,,0,0,0,,Маған сағатыңызды жөндеуге рұқсат етіңіз.
Dialogue: 0,0:15:53.85,0:15:55.12,Default,,0,0,0,,Алдымен қызметкерлерге төлеңіз.
Dialogue: 0,0:15:56.89,0:15:59.42,Default,,0,0,0,,Жоқ, бұл жігіттің уақыты жоқ шығар.
Dialogue: 0,0:16:00.05,0:16:00.72,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:16:01.08,0:16:02.79,Default,,0,0,0,,Тексеруде
Dialogue: 0,0:16:06.54,0:16:07.78,Default,,0,0,0,,Біраз
Dialogue: 0,0:16:07.78,0:16:09.81,Default,,0,0,0,,Мен оны теңізге лақтырамын.
Dialogue: 0,0:16:16.52,0:16:20.04,Default,,0,0,0,,Мен сізге оны жер асты әлемінен естелік ретінде естуге рұқсат етемін.
Dialogue: 0,0:16:20.04,0:16:23.59,Default,,0,0,0,,Жақында екінші отшашу басталады.
Dialogue: 0,0:16:23.59,0:16:27.01,Default,,0,0,0,,Айқай мен айғаймен боялған симфония
Dialogue: 0,0:16:27.01,0:16:30.34,Default,,0,0,0,,Сіз оны бүкіл кемеде орналасқан тыңдау құрылғыларымен тамашалай аласыз.
Dialogue: 0,0:16:29.28,0:16:30.34,Default,,0,0,0,,Біраз Уолтер Эванс (59)
Dialogue: 0,0:16:30.50,0:16:31.30,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:16:31.30,0:16:32.35,Default,,0,0,0,,Сол сағат
Dialogue: 0,0:16:32.58,0:16:35.35,Default,,0,0,0,,Винтаж элементі
Dialogue: 0,0:16:49.23,0:16:50.57,Default,,0,0,0,,●
Dialogue: 0,0:16:51.25,0:16:52.37,Default,,0,0,0,,Бірдеңе болды
Dialogue: 0,0:16:52.65,0:16:54.40,Default,,0,0,0,,Қазір дыбыс қандай?
Dialogue: 0,0:16:54.40,0:16:56.05,Default,,0,0,0,,Қайтадан отшашу
Dialogue: 0,0:16:56.05,0:16:59.69,Default,,0,0,0,,Кез келген дүрбелең болмас үшін хабарландыру жасаңыз.
Dialogue: 0,0:17:00.96,0:17:02.38,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:17:02.59,0:17:03.38,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:17:03.60,0:17:05.12,Default,,0,0,0,,Жарылыстың алдын алды
Dialogue: 0,0:17:05.12,0:17:06.63,Default,,0,0,0,,Аняға рахмет
Dialogue: 0,0:17:06.95,0:17:08.13,Default,,0,0,0,,Табылды
Dialogue: 0,0:17:08.36,0:17:09.90,Default,,0,0,0,,Рұқсатсыз шығу
Dialogue: 0,0:17:10.43,0:17:11.98,Default,,0,0,0,,Үлкен апа, мм.
Dialogue: 0,0:17:11.98,0:17:14.50,Default,,0,0,0,,Уф... мен нәжім ағып бара жатқандай сезіндім...
Dialogue: 0,0:17:14.50,0:17:16.47,Default,,0,0,0,,Олай болса солай айт.
Dialogue: 0,0:17:16.47,0:17:17.49,Default,,0,0,0,,Мен қайтамын.
Dialogue: 0,0:17:18.21,0:17:20.24,Default,,0,0,0,,Әлі де бомбалар қалды.
Dialogue: 0,0:17:20.24,0:17:20.95,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:17:20.95,0:17:22.87,Default,,0,0,0,,Мен оған әлі барымды берген жоқпын.
Dialogue: 0,0:17:23.14,0:17:24.92,Default,,0,0,0,,Жүр, мен ваннаға барамын.
Dialogue: 0,0:17:25.92,0:17:29.38,Default,,0,0,0,,Барлық аумақтарды, соның ішінде жоғарғы қабаттарды мұқият іздеңіз.
Dialogue: 0,0:17:29.76,0:17:33.14,Default,,0,0,0,,Бортта әлі де террористер болуы мүмкін.
Dialogue: 0,0:17:33.43,0:17:37.91,Default,,0,0,0,,Қауіпсіздік бөлімінен тәулік бойы қауіпсіздікті қамтамасыз етуді сұраңыз.
Dialogue: 0,0:17:38.09,0:17:39.67,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:17:46.64,0:17:48.91,Default,,0,0,0,,Бұрын әлсіз жарылыс дыбысы естілді...
Dialogue: 0,0:17:49.18,0:17:51.34,Default,,0,0,0,,Әзірге қалдықтар жоқ болуы мүмкін.
Dialogue: 0,0:17:51.34,0:17:52.93,Default,,0,0,0,,Өте сақ болыңыз
Dialogue: 0,0:17:53.42,0:17:55.34,Default,,0,0,0,,Жарайды, мен дайынмын.
Dialogue: 0,0:17:55.56,0:17:57.68,Default,,0,0,0,,Сәл ерте болса да, қайықты түсірейік.
Dialogue: 0,0:17:58.27,0:18:02.18,Default,,0,0,0,,Круиздік кеме кеткенше осы шүберекпен жабыңыз.
Dialogue: 0,0:18:02.61,0:18:03.44,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:18:03.95,0:18:05.44,Default,,0,0,0,,Сен сонда жақсысың деп үміттенемін.
Dialogue: 0,0:18:14.29,0:18:16.65,Default,,0,0,0,,(Виолет) Мен теремін. (Роданс) Жарай бер.
Dialogue: 0,0:18:17.28,0:18:20.29,Default,,0,0,0,,А... бұл киімдер кірленіп кетеді.
Dialogue: 0,0:18:20.29,0:18:21.12,Default,,0,0,0,,Эмма…
Dialogue: 0,0:18:21.43,0:18:22.71,Default,,0,0,0,,Даму
Dialogue: 0,0:18:23.26,0:18:25.71,Default,,0,0,0,,Бұл қыз да мені құшақтап қоштасқысы келеді
Dialogue: 0,0:18:25.96,0:18:26.91,Default,,0,0,0,,Фаб
Dialogue: 0,0:18:27.16,0:18:28.71,Default,,0,0,0,,Жоқ, қара.
Dialogue: 0,0:18:29.01,0:18:30.45,Default,,0,0,0,,Менің қолым да жабысқақ.
Dialogue: 0,0:18:31.95,0:18:36.00,Default,,0,0,0,,Сол қолдар бұл баланың болашағын бірге байлады.
Dialogue: 0,0:18:44.43,0:18:47.99,Default,,0,0,0,,Бұл өте жылы
Dialogue: 0,0:18:50.45,0:18:53.74,Default,,0,0,0,,Бұл сіз үміттенбейтін нәрсе болуы мүмкін.
Dialogue: 0,0:18:54.38,0:18:56.28,Default,,0,0,0,,Бұл қажетсіз көмек болуы мүмкін.
Dialogue: 0,0:18:56.81,0:18:57.81,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:18:58.74,0:19:00.77,Default,,0,0,0,,Сізге және сіздің отбасыңызға
Dialogue: 0,0:19:01.04,0:19:03.38,Default,,0,0,0,,Бейбіт күндер келсін
Dialogue: 0,0:19:03.66,0:19:04.57,Default,,0,0,0,,Намаз оқу
Dialogue: 0,0:19:06.77,0:19:08.50,Default,,0,0,0,,Ешқандай проблема жоқ сияқты.
Dialogue: 0,0:19:09.16,0:19:11.98,Default,,0,0,0,,Енді қалпына келтіру кемесінің байланысын күтейік.
Dialogue: 0,0:19:12.23,0:19:15.03,Default,,0,0,0,,Таң атқанша сақтықыңды түсірме
Dialogue: 0,0:19:20.00,0:19:22.81,Default,,0,0,0,,Сезімтал болуды бірден доғарыңыз.
Dialogue: 0,0:19:24.20,0:19:28.44,Default,,0,0,0,,Біз жай ғана қатардағы жауынгер екенімізді ұмытпауымыз керек.
Dialogue: 0,0:19:28.80,0:19:30.47,Default,,0,0,0,,Дәл солай, ақымақ
Dialogue: 0,0:19:31.36,0:19:35.25,Default,,0,0,0,,Ойланып қарасам, хабар барын ұмытып кетіппін.
Dialogue: 0,0:19:35.60,0:19:40.56,Default,,0,0,0,,Тамақшы ертең зәкір қоятын аралда кездесуді сұраған сияқты.
Dialogue: 0,0:19:41.59,0:19:43.04,Default,,0,0,0,,Ллойд мырза
Dialogue: 0,0:19:43.36,0:19:44.54,Default,,0,0,0,,Жоқ, бірақ
Dialogue: 0,0:19:44.54,0:19:46.87,Default,,0,0,0,,Мен қалдықтардан сақ боламын.
Dialogue: 0,0:19:46.87,0:19:50.41,Default,,0,0,0,,Миссияңызды аяқтағаныңыз үшін сыйлық ретінде оны орындаңыз.
Dialogue: 0,0:19:54.74,0:19:57.82,Default,,0,0,0,,Ісіну көрінбеуі үшін бетіңізді салқын ұстаған дұрыс.
Dialogue: 0,0:19:58.52,0:19:59.30,Default,,0,0,0,,Және
Dialogue: 0,0:19:59.69,0:20:02.09,Default,,0,0,0,,Кеудедегі тыртықтарды мүмкіндігінше көрсетпеуге тырысыңыз.
Dialogue: 0,0:20:02.51,0:20:04.11,Default,,0,0,0,,Ештеңені көрсетпеңіз
Dialogue: 0,0:20:04.11,0:20:06.00,Default,,0,0,0,,Мен купальник кимеймін.
Dialogue: 0,0:20:09.04,0:20:11.66,Default,,0,0,0,,Қазіргі уақытта қауіпсіздік қамтамасыз етілді ме?
Dialogue: 0,0:20:11.66,0:20:15.32,Default,,0,0,0,,Қалғанын қауіпсіздік күштеріне тапсырған дұрыс деп ойлаймын.
Dialogue: 0,0:20:16.51,0:20:17.82,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:20:21.73,0:20:24.26,Default,,0,0,0,,Күтуден шаршадым деп ойлаймын.
Dialogue: 0,0:20:24.49,0:20:25.58,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:26.75,0:20:28.60,Default,,0,0,0,,Бұл шұғыл мәселе болса да
Dialogue: 0,0:20:28.60,0:20:31.50,Default,,0,0,0,,Мен отбасымды қайтадан тастап кеттім.
Dialogue: 0,0:20:33.19,0:20:34.84,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Ымырт
Dialogue: 0,0:20:35.48,0:20:37.43,Default,,0,0,0,,Отбасы да міндет, солай ма?
Dialogue: 0,0:20:38.01,0:20:41.30,Default,,0,0,0,,Жоқ, бұл жолы демалыс деп аталатын миссия.
Dialogue: 0,0:20:41.30,0:20:42.92,Default,,0,0,0,,Миссия емес
Dialogue: 0,0:21:57.59,0:22:01.01,Default,,0,0,0,,Бұл субтитрді Моечая шығарған. Оны коммерциялық мақсатта пайдалануға болады.
Dialogue: 0,0:22:12.23,0:22:19.02,Default,,0,0,0,,Көру аймағында қою қызыл-қызыл түс пайда болады
Dialogue: 0,0:22:21.90,0:22:29.16,Default,,0,0,0,,Шамамен 40 000 км алға
Dialogue: 0,0:22:32.16,0:22:36.58,Default,,0,0,0,,Артында жақындап келе жатқан өзара жаралар
Dialogue: 0,0:22:36.92,0:22:41.80,Default,,0,0,0,,Адасып кеткен жол мені одан сайын адастырады
Dialogue: 0,0:22:41.80,0:22:46.18,Default,,0,0,0,,Көрінбейтін, иісі сезілмейтін және өзгертілмейтін болашақ
Dialogue: 0,0:22:46.47,0:22:48.39,Default,,0,0,0,,Мен сенің арқаңнан пышақ сұғып алдым!
Dialogue: 0,0:22:49.51,0:22:58.02,Default,,0,0,0,,Бүгін кешке жаныңда болуға рұқсат ет
Dialogue: 0,0:22:59.15,0:23:06.95,Default,,0,0,0,,Мен бүгін кешке байыптымын.
Dialogue: 0,0:23:08.20,0:23:10.66,Default,,0,0,0,,Қосымша ақпарат алу үшін осында келіңіз
Dialogue: 0,0:23:10.66,0:23:13.00,Default,,0,0,0,,Біз дұға еткен болашақ
Dialogue: 0,0:23:13.00,0:23:14.96,Default,,0,0,0,,Жолдар әртүрлі.
Dialogue: 0,0:23:20.17,0:23:22.55,Default,,0,0,0,,Өзара өлтіру ниетімен
Dialogue: 0,0:23:22.55,0:23:25.93,Default,,0,0,0,,Сіз соңғы соққыны аласыз.
Dialogue: 0,0:23:27.34,0:23:30.55,Default,,0,0,0,,Ақыр соңында мен оны тоқтатамын.
Dialogue: 0,0:23:38.02,0:23:41.02,Default,,0,0,0,,Ләззат алу және жеңу дәрежесі
Dialogue: 0,0:23:42.52,0:23:47.52,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
