Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:07.99,Default,,0,0,0,,Ходокудың аман қалу стратегиясы
Dialogue: 0,0:00:06.30,0:00:07.87,Default,,0,0,0,,Жалқаулықтың шыңы
Dialogue: 0,0:00:08.44,0:00:09.63,Default,,0,0,0,,Шынайы кімдігі: жалдамалы кісі өлтіруші
Dialogue: 0,0:00:09.99,0:00:11.43,Default,,0,0,0,,Мен үй тапсырмасын орындауым керек
Dialogue: 0,0:00:11.43,0:00:13.70,Default,,0,0,0,,Мұғалім тағы ұрысып қалады.
Dialogue: 0,0:00:13.84,0:00:14.82,Default,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:00:24.13,0:00:27.01,Default,,0,0,0,,Ходокудың ерекше қабілеті
Dialogue: 0,0:00:35.48,0:00:37.45,Default,,0,0,0,,Анямен бірге жасырынбақ
Dialogue: 0,0:00:43.31,0:00:44.63,Default,,0,0,0,,Электр қуатының үзілуі
Dialogue: 0,0:00:51.81,0:00:53.85,Default,,0,0,0,,Бонд мырзаға тосын сый.
Dialogue: 0,0:00:53.85,0:00:55.60,Default,,0,0,0,,Кочи Кокчи
Dialogue: 0,0:00:59.91,0:01:05.04,Default,,0,0,0,,Зертхана қызметкері
Dialogue: 0,0:01:00.25,0:01:02.41,Default,,0,0,0,,Мен оны №8 таптым
Dialogue: 0,0:01:02.41,0:01:04.06,Default,,0,0,0,,Мен сенің өлгеніңді қалаймын
Dialogue: 0,0:01:32.56,0:01:34.26,Default,,0,0,0,,Облигация
Dialogue: 0,0:01:34.64,0:01:35.72,Default,,0,0,0,,Жылама
Dialogue: 0,0:01:36.14,0:01:38.31,Default,,0,0,0,,Бұл жігіт те ақырында бақытты болды.
Dialogue: 0,0:01:46.97,0:01:49.52,Default,,0,0,0,,Сіз немен қоштасқыңыз келеді?
Dialogue: 0,0:01:57.86,0:01:59.90,Default,,0,0,0,,Аня үй тапсырмасымен айналысады
Dialogue: 0,0:01:59.90,0:02:01.34,Default,,0,0,0,,Менің ойнауға уақытым жоқ
Dialogue: 0,0:02:05.39,0:02:06.80,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:02:06.80,0:02:08.42,Default,,0,0,0,,Кешіріңіз, Бонд мырза.
Dialogue: 0,0:02:08.42,0:02:09.94,Default,,0,0,0,,Мен ит тамағынан қалдым.
Dialogue: 0,0:02:09.94,0:02:12.09,Default,,0,0,0,,Мен оны сатып алуды ұмытып кетіппін.
Dialogue: 0,0:02:12.43,0:02:15.66,Default,,0,0,0,,Ллойд-сан бүгін үйге кеш қайтып келе жатқан сияқты.
Dialogue: 0,0:02:15.66,0:02:19.79,Default,,0,0,0,,Бонд мырзаның кешкі асын қолымда бар нәрсемен жасауға тырысамын.
Dialogue: 0,0:02:20.51,0:02:22.04,Default,,0,0,0,,Жарайды, мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:02:28.04,0:02:31.21,Default,,0,0,0,,Бонд мырза, кешкі ас дайын.
Dialogue: 0,0:02:37.92,0:02:40.12,Default,,0,0,0,,Бонд мырза
Dialogue: 0,0:02:40.85,0:02:43.35,Default,,0,0,0,,Өлім себебі
Dialogue: 0,0:02:43.80,0:02:45.65,Default,,0,0,0,,Иттерге арналған NG тағамдары
Dialogue: 0,0:02:45.65,0:02:48.36,Default,,0,0,0,,Ллойд мырза ешқандай проблема болмайтындай етіп жазып алды.
Dialogue: 0,0:02:51.32,0:02:52.92,Default,,0,0,0,,Бұл кешкі ас.
Dialogue: 0,0:02:54.32,0:02:55.61,Default,,0,0,0,,Шешім
Dialogue: 0,0:02:56.31,0:02:59.45,Default,,0,0,0,,Абайлаңыз, өйткені Хаха ашулансаңыз, ол сізді өлтіреді.
Dialogue: 0,0:03:02.49,0:03:04.09,Default,,0,0,0,,Облигация
Dialogue: 0,0:03:04.09,0:03:07.63,Default,,0,0,0,,Өйткені менің тамағым саған ұнамайды.
Dialogue: 0,0:03:12.34,0:03:15.09,Default,,0,0,0,,Барлығы жабық
Dialogue: 0,0:03:18.54,0:03:20.60,Default,,0,0,0,,Эй, Бонд мырза, зорлық-зомбылық жасау жақсы емес.
Dialogue: 0,0:03:21.36,0:03:23.72,Default,,0,0,0,,Не істеуім керек? Бұл қандай да бір ауру ма?
Dialogue: 0,0:03:24.60,0:03:26.56,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:27.52,0:03:29.40,Default,,0,0,0,,Кел, тамақ іш
Dialogue: 0,0:03:29.40,0:03:29.98,Default,,0,0,0,,Келіп тамақтан Кел, тамақ іш
Dialogue: 0,0:03:31.48,0:03:32.61,Default,,0,0,0,,Өлім
Dialogue: 0,0:03:32.69,0:03:34.74,Default,,0,0,0,,Ерте бұрылыс
Dialogue: 0,0:03:35.65,0:03:37.78,Default,,0,0,0,,Кел, тамақ іш
Dialogue: 0,0:03:39.16,0:03:41.12,Default,,0,0,0,,Бар болу
Dialogue: 0,0:03:41.11,0:03:43.86,Default,,0,0,0,,Қолөнер
Dialogue: 0,0:03:43.84,0:03:45.04,Default,,0,0,0,,Бұл Бонд емес пе?
Dialogue: 0,0:03:45.07,0:03:45.95,Default,,0,0,0,,Қолөнер
Dialogue: 0,0:03:48.12,0:03:49.61,Default,,0,0,0,,Мені тоқтатқаныңыз үшін рахмет.
Dialogue: 0,0:03:49.61,0:03:51.39,Default,,0,0,0,,Сізге рахмет, мен үйге ерте бара аламын.
Dialogue: 0,0:03:58.95,0:04:01.78,Default,,0,0,0,,Бонд мырза
Dialogue: 0,0:04:11.67,0:04:13.02,Default,,0,0,0,,Ванва
Dialogue: 0,0:04:24.95,0:04:26.21,Default,,0,0,0,,Мен шын мәнінде айта алмаймын.
Dialogue: 0,0:04:27.75,0:04:29.21,Default,,0,0,0,,Бұл қаңғыбас ит
Dialogue: 0,0:04:31.63,0:04:33.43,Default,,0,0,0,,Басқа жерден тамақ алыңыз
Dialogue: 0,0:04:33.43,0:04:34.36,Default,,0,0,0,,Дәл айтқанда, жоқ. Мен жартылай эльфпін.
Dialogue: 0,0:04:54.88,0:04:55.99,Default,,0,0,0,,Мен ит алатын болсам, қауіпсіздік үшін сенім артатын күзетші ит алсам жақсы болар деп ойладым…
Dialogue: 0,0:04:55.99,0:04:57.69,Default,,0,0,0,,Қастарды сызыңыз
Dialogue: 0,0:05:47.16,0:05:48.29,Default,,0,0,0,,Койойдың миссиясы
Dialogue: 0,0:05:48.72,0:05:51.46,Default,,0,0,0,,Жаңа ағартқыш агент Born әзірлеп жатыр
Dialogue: 0,0:05:51.46,0:05:53.30,Default,,0,0,0,,Геролимнен үлгілер алу
Dialogue: 0,0:05:54.14,0:05:56.26,Default,,0,0,0,,Әдеттегідей, шектен шыққан тәртіпке байланысты
Dialogue: 0,0:05:56.26,0:05:58.46,Default,,0,0,0,,Ақпарат жинауға уақыт болмады.
Dialogue: 0,0:05:58.71,0:06:00.14,Default,,0,0,0,,Қазір барыңыз
Dialogue: 0,0:06:00.53,0:06:02.36,Default,,0,0,0,,Бетперде арқылы инфильтрация мүмкін емес.
Dialogue: 0,0:06:02.82,0:06:04.87,Default,,0,0,0,,Күшпен ішке кіруден басқа амалым жоқ.
Dialogue: 0,0:06:07.81,0:06:09.64,Default,,0,0,0,,Бонд Неге мұндасың?
Dialogue: 0,0:06:10.03,0:06:11.10,Default,,0,0,0,,Неге Цуки камералар мен тыңшылық құрылғыларға сонша әуес?
Dialogue: 0,0:06:11.10,0:06:12.08,Default,,0,0,0,,Жау тапқан
Dialogue: 0,0:06:12.57,0:06:14.36,Default,,0,0,0,,Немесе бұл тек сіз бе?
Dialogue: 0,0:06:14.60,0:06:16.09,Default,,0,0,0,,Йор-сан мен Аня
Dialogue: 0,0:06:16.09,0:06:18.27,Default,,0,0,0,,Ол серуендеу кезінде сырғып кетті ме?
Dialogue: 0,0:06:19.67,0:06:21.66,Default,,0,0,0,,Неге екенін білмеймін, бірақ үйге қайт.
Dialogue: 0,0:06:21.66,0:06:23.22,Default,,0,0,0,,Мен жұмыстамын.
Dialogue: 0,0:06:27.68,0:06:29.74,Default,,0,0,0,,Не, сенімен ойнағанымды қалайсың ба?
Dialogue: 0,0:06:29.93,0:06:31.58,Default,,0,0,0,,Мен бос емеспін, кейінірек қалдырыңыз.
Dialogue: 0,0:06:33.34,0:06:35.56,Default,,0,0,0,,Тоқта, бұл жаудың ұясы.
Dialogue: 0,0:06:38.79,0:06:41.28,Default,,0,0,0,,Ол адам жоқ жерде жол көрсетеді.
Dialogue: 0,0:06:41.56,0:06:43.86,Default,,0,0,0,,Оны соншалықты көп жаттықтырғаным есімде жоқ...
Dialogue: 0,0:06:43.86,0:06:45.22,Default,,0,0,0,,Бұл сіз бұрын үйренген нәрсе болды ма?
Dialogue: 0,0:06:45.89,0:06:47.28,Default,,0,0,0,,Ойланып қарасақ, Born Inc.
Dialogue: 0,0:06:47.28,0:06:50.14,Default,,0,0,0,,Apple жобасымен қатысы бар деген қауесеттер болды.
Dialogue: 0,0:06:50.95,0:06:53.48,Default,,0,0,0,,Бұны біле тұра мұнда келеді деп күтпедім.
Dialogue: 0,0:06:53.95,0:06:55.68,Default,,0,0,0,,Менің жеке нөмірім
Dialogue: 0,0:06:56.02,0:07:00.04,Default,,0,0,0,,Сен, сынауға ұшыраған жауыңның кек алу үшін.
Dialogue: 0,0:07:02.87,0:07:03.60,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:03.86,0:07:05.57,Default,,0,0,0,,Тапсырманы бірге орындайық
Dialogue: 0,0:07:05.57,0:07:06.70,Default,,0,0,0,,Ақпараттың болмауы
Dialogue: 0,0:07:06.70,0:07:08.68,Default,,0,0,0,,Мұрынға сүйену жаман емес.
Dialogue: 0,0:07:24.08,0:07:25.86,Default,,0,0,0,,Бұл зертхана ма?
Dialogue: 0,0:07:26.13,0:07:27.77,Default,,0,0,0,,Ол қойма бөлмелеріне толы.
Dialogue: 0,0:07:30.16,0:07:31.83,Default,,0,0,0,,Қайсысы Геролим?
Dialogue: 0,0:07:32.60,0:07:34.29,Default,,0,0,0,,Қауіпсіздік те күшті.
Dialogue: 0,0:07:34.29,0:07:36.87,Default,,0,0,0,,Әрбір сүйекті бір-бірден тексеріңіз.
Dialogue: 0,0:07:38.16,0:07:40.08,Default,,0,0,0,,Мен үйге қашан бара аламын?
Dialogue: 0,0:07:43.76,0:07:46.16,Default,,0,0,0,,Неге маған қайта қоңырау шалдың?
Dialogue: 0,0:07:46.59,0:07:48.66,Default,,0,0,0,,Ақаулық табылды деп естідім.
Dialogue: 0,0:07:49.13,0:07:50.82,Default,,0,0,0,,Жаман жігіттер қайтып келді.
Dialogue: 0,0:07:51.73,0:07:53.57,Default,,0,0,0,,Мен жауды тартамын
Dialogue: 0,0:07:53.57,0:07:54.89,Default,,0,0,0,,Алдымен үйге барасың.
Dialogue: 0,0:07:55.11,0:07:56.55,Default,,0,0,0,,Бұл ұзақ шайқас болады.
Dialogue: 0,0:07:57.81,0:07:59.78,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:07:59.78,0:08:01.23,Default,,0,0,0,,Тамағыңды же
Dialogue: 0,0:08:06.07,0:08:07.14,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:08:07.14,0:08:08.98,Default,,0,0,0,,Қызметкерлердің көпшілігі жұмыстан кетті.
Dialogue: 0,0:08:13.89,0:08:14.95,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:08:16.38,0:08:18.51,Default,,0,0,0,,Таку, менеджер
Dialogue: 0,0:08:18.51,0:08:20.84,Default,,0,0,0,,Неге маған қайта қоңырау шалдың?
Dialogue: 0,0:08:21.12,0:08:23.20,Default,,0,0,0,,Мәселе табылды.
Dialogue: 0,0:08:23.39,0:08:26.28,Default,,0,0,0,,Жеткізу күні де ерте келді, сондықтан бұл тәртіпсіздік.
Dialogue: 0,0:08:26.28,0:08:27.87,Default,,0,0,0,,Алдымен Итадориді ұрлап алғанымыз дұрыс.
Dialogue: 0,0:08:27.87,0:08:29.47,Default,,0,0,0,,Жоғарыдан қысыммен
Dialogue: 0,0:08:30.89,0:08:32.36,Default,,0,0,0,,Құлып ашық
Dialogue: 0,0:08:37.22,0:08:37.83,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:39.75,0:08:42.83,Default,,0,0,0,,«Туро Макото» Мен Phantom Thief T-ге келдім
Dialogue: 0,0:08:40.79,0:08:42.09,Default,,0,0,0,,Фантом ұры Т
Dialogue: 0,0:08:42.24,0:08:42.83,Default,,0,0,0,,Аристократтар академиясына сұхбат
Dialogue: 0,0:08:43.22,0:08:44.41,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:08:49.06,0:08:51.34,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:08:51.59,0:08:53.65,Default,,0,0,0,,Бұл еркелік кімге арналған?
Dialogue: 0,0:08:57.03,0:08:58.02,Default,,0,0,0,,Оны ашқаныңыз үшін рахмет.
Dialogue: 0,0:08:58.80,0:08:59.77,Default,,0,0,0,,(Нацуки Субару) Ол қыз неге мұнда? Әлі күндізгі уақыт қой.
Dialogue: 0,0:09:00.32,0:09:02.21,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:09:02.62,0:09:03.52,Default,,0,0,0,,Кім?
Dialogue: 0,0:09:09.63,0:09:10.69,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:09:10.69,0:09:12.78,Default,,0,0,0,,Сіздің арқаңызда миссия оңай аяқталды.
Dialogue: 0,0:09:15.27,0:09:17.69,Default,,0,0,0,,Мен үйге күткенімнен тезірек бара аламын.
Dialogue: 0,0:09:22.80,0:09:23.71,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:09:26.24,0:09:27.42,Default,,0,0,0,,Муму
Dialogue: 0,0:09:27.42,0:09:29.95,Default,,0,0,0,,Мен сізді уайымдап іздедім.
Dialogue: 0,0:09:37.47,0:09:38.43,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:38.66,0:09:41.37,Default,,0,0,0,,Сіз Борннан кек алғаныңызға шынымен бақыттысыз ба?
Dialogue: 0,0:09:41.37,0:09:42.06,Default,,0,0,0,,Жақсы, онда
Dialogue: 0,0:09:42.59,0:09:45.07,Default,,0,0,0,,Жарайды, үйге қайтар жолда супермаркетке тоқталайық.
Dialogue: 0,0:09:45.07,0:09:46.83,Default,,0,0,0,,Саған той жасайын ба?
Dialogue: 0,0:09:51.49,0:09:57.12,Default,,0,0,0,,Сыртта оқу тәжірибесі
Dialogue: 0,0:10:04.52,0:10:05.75,Default,,0,0,0,,(Хабаршы) «Ақ камелия сарайында оның сұлулығы мадақталады—»
Dialogue: 0,0:10:05.90,0:10:08.84,Default,,0,0,0,,Егер сіз ерте тұрмасаңыз, қоңырау шалуға кешігіп қаласыз.
Dialogue: 0,0:10:13.75,0:10:17.89,Default,,0,0,0,,Қоңырауға кешіккені үшін жаза ретінде Майтронға көмектесу
Dialogue: 0,0:10:17.89,0:10:21.02,Default,,0,0,0,,Бұл аяқталмайынша жатақханадан шығуға рұқсат етілмейді.
Dialogue: 0,0:10:21.50,0:10:22.81,Default,,0,0,0,,Шындығында, 2-сыныпты үш тәжірибеші мен бір 1-сыныпты тәжірибеші қызмет барысында қаза тапты.
Dialogue: 0,0:10:22.81,0:10:24.19,Default,,0,0,0,,Мейрам болса да
Dialogue: 0,0:10:24.19,0:10:27.03,Default,,0,0,0,,Өзін-өзі ақтайтын өмір талғампаз емес.
Dialogue: 0,0:10:27.03,0:10:28.52,Default,,0,0,0,,Десмонд мырза
Dialogue: 0,0:10:28.97,0:10:30.28,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:10:36.40,0:10:39.12,Default,,0,0,0,,Қымбатты Дамиан, қайтадан сабаққа кешікпей қалыңыз.
Dialogue: 0,0:10:39.35,0:10:41.91,Default,,0,0,0,,Мен Стелланы тез алуым керек.
Dialogue: 0,0:10:42.09,0:10:44.00,Default,,0,0,0,,Сіз тым қатты тырысып жатырсыз.
Dialogue: 0,0:10:44.92,0:10:46.12,Default,,0,0,0,,Бүгін осында
Dialogue: 0,0:10:46.12,0:10:49.06,Default,,0,0,0,,Мұғалім сені киноға апаратын сияқты.
Dialogue: 0,0:10:49.28,0:10:52.38,Default,,0,0,0,,Сіз сондай-ақ «Теңіз астындағы 20 000 қадам» жаңа жұмысын көре аласыз.
Dialogue: 0,0:10:52.84,0:10:55.68,Default,,0,0,0,,Үйге қайтып бара жатқанда Уимпсондағы қуырылған сиыр еті.
Dialogue: 0,0:10:55.68,0:10:57.56,Default,,0,0,0,,Тез бітіріп, кездесейік.
Dialogue: 0,0:10:57.56,0:10:58.88,Default,,0,0,0,,Қуырылған сиыр еті
Dialogue: 0,0:10:58.88,0:11:00.14,Default,,0,0,0,,Барма
Dialogue: 0,0:11:00.34,0:11:02.39,Default,,0,0,0,,Мен өз бөлмемде оқимын.
Dialogue: 0,0:11:03.17,0:11:05.11,Default,,0,0,0,,Шынайы сезімдері мен нағыз болмысын жасырып
Dialogue: 0,0:11:05.11,0:11:07.04,Default,,0,0,0,,Бармасаң, барма.
Dialogue: 0,0:11:07.23,0:11:08.61,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:11:09.27,0:11:10.34,Default,,0,0,0,,Эй, мұғалім
Dialogue: 0,0:11:10.72,0:11:12.65,Default,,0,0,0,,Фильмдер кез келген нәрсе болуы мүмкін.
Dialogue: 0,0:11:12.65,0:11:14.81,Default,,0,0,0,,Маған «Теңіз астындағы 20 000 қадам» ұнайды
Dialogue: 0,0:11:14.98,0:11:17.69,Default,,0,0,0,,Дұрыс, мен не істеуім керек?
Dialogue: 0,0:11:18.10,0:11:19.42,Default,,0,0,0,,Мырза, кенет қозғалмаңыз.
Dialogue: 0,0:11:19.42,0:11:21.11,Default,,0,0,0,,Мен олардан өзгешемін.
Dialogue: 0,0:11:21.49,0:11:25.62,Default,,0,0,0,,Олар ойнап жатқанда, мен шыңға жету үшін көп жұмыс істеймін.
Dialogue: 0,0:11:26.08,0:11:26.92,Default,,0,0,0,,Дамиан
Dialogue: 0,0:11:27.38,0:11:29.73,Default,,0,0,0,,Десмондтың атына сай өмір сүріңіз
Dialogue: 0,0:11:29.73,0:11:31.63,Default,,0,0,0,,Онда көптеген атақты адамдар болады ғой, иә?
Dialogue: 0,0:11:32.25,0:11:34.70,Default,,0,0,0,,Әкем мені тағы да мақтасын деп
Dialogue: 0,0:11:36.25,0:11:37.79,Default,,0,0,0,,Балалар
Dialogue: 0,0:11:38.39,0:11:39.99,Default,,0,0,0,,Сол жаққа барыңыз.
Dialogue: 0,0:11:39.99,0:11:42.52,Default,,0,0,0,,Бұл баланың жазасы.
Dialogue: 0,0:12:00.86,0:12:02.49,Default,,0,0,0,,Ұйымдастырылмаған киім
Dialogue: 0,0:12:02.49,0:12:04.43,Default,,0,0,0,,Белгіленген уақыттан тыс тағамдар
Dialogue: 0,0:12:04.43,0:12:07.96,Default,,0,0,0,,Жаза ретінде Майтронға келіп көмектесіңіз.
Dialogue: 0,0:12:07.96,0:12:09.75,Default,,0,0,0,,Рахмет
Dialogue: 0,0:12:14.13,0:12:16.21,Default,,0,0,0,,Бұл не, балалар?
Dialogue: 0,0:12:16.21,0:12:17.58,Default,,0,0,0,,Сыртқа шығуға не болды?
Dialogue: 0,0:12:17.58,0:12:18.35,Default,,0,0,0,,Бұл жаза.
Dialogue: 0,0:12:18.35,0:12:20.07,Default,,0,0,0,,Осыны тез бітірейік.
Dialogue: 0,0:12:20.34,0:12:22.44,Default,,0,0,0,,Ойынға бармаңыз
Dialogue: 0,0:12:22.44,0:12:24.16,Default,,0,0,0,,Дэмиеннің ішінің бүгілуі
Dialogue: 0,0:12:24.16,0:12:25.11,Default,,0,0,0,,Гари Цутому
Dialogue: 0,0:12:25.55,0:12:26.52,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:26.52,0:12:28.31,Default,,0,0,0,,Менімен араласпа
Dialogue: 0,0:12:28.90,0:12:30.97,Default,,0,0,0,,Келіңіз және өз бетіңізше көңіл көтеріңіз.
Dialogue: 0,0:12:39.92,0:12:40.82,Default,,0,0,0,,Егер сіз бұл туралы ойласаңыз
Dialogue: 0,0:12:40.82,0:12:44.72,Default,,0,0,0,,Оның мұндай жақсы күні кинотеатрға бару сезімі жоқ.
Dialogue: 0,0:12:44.72,0:12:45.66,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:12:45.66,0:12:47.83,Default,,0,0,0,,Соңғы тренд - кір жуу.
Dialogue: 0,0:12:48.08,0:12:49.14,Default,,0,0,0,,Және қараңыз
Dialogue: 0,0:12:52.41,0:12:55.05,Default,,0,0,0,,Сондай-ақ империялық түстерді ойнауға болады.
Dialogue: 0,0:12:57.37,0:12:59.60,Default,,0,0,0,,Стелланы қаласаңыз, осында келіңіз.
Dialogue: 0,0:12:59.83,0:13:02.18,Default,,0,0,0,,Теме, бұл плащ менікі.
Dialogue: 0,0:13:02.46,0:13:04.12,Default,,0,0,0,,Корра, балалар
Dialogue: 0,0:13:04.12,0:13:05.77,Default,,0,0,0,,Көп жұмыс істе
Dialogue: 0,0:13:05.97,0:13:07.22,Default,,0,0,0,,Керемет
Dialogue: 0,0:13:07.22,0:13:10.27,Default,,0,0,0,,Сол достық Бағалы Elegant
Dialogue: 0,0:13:22.59,0:13:25.85,Default,,0,0,0,,Бала пикникке барғысы келетін сияқты.
Dialogue: 0,0:13:26.00,0:13:27.30,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:13:30.40,0:13:32.96,Default,,0,0,0,,Жұмыс кезіндегі жеке әңгіме Prank
Dialogue: 0,0:13:32.96,0:13:35.30,Default,,0,0,0,,Мен саған жаңа жаза беремін.
Dialogue: 0,0:13:36.25,0:13:38.40,Default,,0,0,0,,Өмір салты бойынша жетекші мұғалім Гринмен
Dialogue: 0,0:13:38.40,0:13:40.80,Default,,0,0,0,,Келіңіз және бірге ашық ауада оқыңыз.
Dialogue: 0,0:13:45.60,0:13:47.52,Default,,0,0,0,,Пикник - көңілді.
Dialogue: 0,0:13:46.45,0:13:47.67,Default,,0,0,0,,өледі
Dialogue: 0,0:13:47.52,0:13:49.85,Default,,0,0,0,,Бөлмеде өзен рафтингіне баруға болады.
Dialogue: 0,0:13:49.85,0:13:51.35,Default,,0,0,0,,Едем керемет болар еді
Dialogue: 0,0:13:51.35,0:13:52.21,Default,,0,0,0,,Өлу
Dialogue: 0,0:13:52.21,0:13:53.65,Default,,0,0,0,,Сенімді болыңыз.
Dialogue: 0,0:13:53.65,0:13:56.44,Default,,0,0,0,,Мен бұрынғы теңіз батальонының ардагерімін.
Dialogue: 0,0:13:56.44,0:13:59.04,Default,,0,0,0,,Үлкен қайыққа мінгендей ләззат алыңыз.
Dialogue: 0,0:13:59.64,0:14:03.11,Default,,0,0,0,,Жарайды, ағыспен көлге қарай жүгірейік.
Dialogue: 0,0:14:03.11,0:14:05.03,Default,,0,0,0,,Бұл тамаша жер.
Dialogue: 0,0:14:05.70,0:14:08.16,Default,,0,0,0,,Орташа жаттығулар да миға пайдалы.
Dialogue: 0,0:14:08.16,0:14:11.50,Default,,0,0,0,,Тиімді оқу – бұл жай ғана партада отыру емес.
Dialogue: 0,0:14:11.50,0:14:13.04,Default,,0,0,0,,Орташа емес.
Dialogue: 0,0:14:13.04,0:14:14.62,Default,,0,0,0,,Сәлем, балалар
Dialogue: 0,0:14:14.62,0:14:17.63,Default,,0,0,0,,Сол жағы Барынша тырыспасаң, тасқа соғыласың.
Dialogue: 0,0:14:21.16,0:14:22.09,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:14:22.09,0:14:23.76,Default,,0,0,0,,Менің алдымда сарқырама бар
Dialogue: 0,0:14:32.27,0:14:33.73,Default,,0,0,0,,(Хабаршы) «Ақ камелия сарайында оның сұлулығы мадақталады—»
Dialogue: 0,0:14:36.87,0:14:38.05,Default,,0,0,0,,Маған көмектес
Dialogue: 0,0:14:38.05,0:14:39.93,Default,,0,0,0,,Мен Десмондтар отбасының екінші ұлымын.
Dialogue: 0,0:14:39.93,0:14:41.17,Default,,0,0,0,,Мен қазір барамын
Dialogue: 0,0:14:41.43,0:14:42.03,Default,,0,0,0,,Бұл не өзі?
Dialogue: 0,0:14:43.40,0:14:45.42,Default,,0,0,0,,Мен Эльман әулетінің мұрагерімін.
Dialogue: 0,0:14:45.42,0:14:47.03,Default,,0,0,0,,Мен Эджбургтер отбасынан шыққан бейбақпын.
Dialogue: 0,0:14:47.32,0:14:48.24,Default,,0,0,0,,Кем дегенде
Dialogue: 0,0:14:48.24,0:14:50.22,Default,,0,0,0,,Дамиан-сама жалғыз ғана өмір сүре алады
Dialogue: 0,0:14:50.22,0:14:51.13,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:14:51.13,0:14:53.69,Default,,0,0,0,,Біздің армандарымызды біз үшін орындаңыз.
Dialogue: 0,0:14:54.10,0:14:54.92,Default,,0,0,0,,Оны еш күш жұмсамай шашыраңқы етіп көрсету үшін
Dialogue: 0,0:14:54.92,0:14:56.29,Default,,0,0,0,,Қайыққа асығыңыз
Dialogue: 0,0:14:56.29,0:14:58.25,Default,,0,0,0,,Біздің өміріміз аяқталмай тұрып
Dialogue: 0,0:14:58.25,0:14:59.04,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:15:00.62,0:15:02.25,Default,,0,0,0,,Косуманга қызық болған кезде
Dialogue: 0,0:15:02.25,0:15:04.63,Default,,0,0,0,,Ток мүлдем жылдам емес.
Dialogue: 0,0:15:05.49,0:15:08.35,Default,,0,0,0,,Мен есумен айналысқандықтан ғана жылдам болды.
Dialogue: 0,0:15:17.63,0:15:18.36,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:15:18.36,0:15:21.52,Default,,0,0,0,,Тезірек от жағып, суық тигіземін.
Dialogue: 0,0:15:33.12,0:15:34.42,Default,,0,0,0,,Жылы болды.
Dialogue: 0,0:15:35.24,0:15:37.79,Default,,0,0,0,,Тыныштанған соң қарным ашты.
Dialogue: 0,0:15:37.79,0:15:40.29,Default,,0,0,0,,Мен суланған кезде өзеннен балық аулауым керек пе?
Dialogue: 0,0:15:40.77,0:15:43.25,Default,,0,0,0,,Сізде дайындаған бутербродтар жоқ па?
Dialogue: 0,0:15:43.53,0:15:45.68,Default,,0,0,0,,Қалжың деген сөз жоқ
Dialogue: 0,0:15:45.68,0:15:48.18,Default,,0,0,0,,Eden студенттеріне арналған жергілікті сатып алу.
Dialogue: 0,0:15:48.89,0:15:49.76,Default,,0,0,0,,Бірақ
Dialogue: 0,0:15:50.04,0:15:53.25,Default,,0,0,0,,Мен жіп пен торды жасаймын, сондықтан өз тапқырлығыңызды көріңіз.
Dialogue: 0,0:16:04.42,0:16:08.85,Default,,0,0,0,,Қазір сенің осы жолмен жүретін кезің
Dialogue: 0,0:16:08.85,0:16:13.45,Default,,0,0,0,,Сол қоңырауды соққан сен бола аласың
Dialogue: 0,0:16:13.45,0:16:18.15,Default,,0,0,0,,Барлығы жасырынбақ сияқты
Dialogue: 0,0:16:18.15,0:16:22.29,Default,,0,0,0,,Дайын немесе жоқ, міне, бар
Dialogue: 0,0:16:22.29,0:16:27.05,Default,,0,0,0,,Ертең сіз оны кеше көресіз
Dialogue: 0,0:16:27.05,0:16:31.56,Default,,0,0,0,,Басқа күндер сияқты болды
Dialogue: 0,0:16:31.56,0:16:36.17,Default,,0,0,0,,Енді сіздің қолыңызда ғана
Dialogue: 0,0:16:36.17,0:16:43.08,Default,,0,0,0,,Сіз қазір ғана қолыңызда ұстайсыз
Dialogue: 0,0:16:58.39,0:16:59.23,Default,,0,0,0,,Миллионың костюмі сол жігіттің шашынан алынған арнайы талшықтан жасалған.
Dialogue: 0,0:16:59.43,0:17:00.58,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:17:00.58,0:17:02.25,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:17:02.25,0:17:05.06,Default,,0,0,0,,Уимпсондағы қуырылған сиыр еті де жаман емес.
Dialogue: 0,0:17:05.06,0:17:07.03,Default,,0,0,0,,Өзім ұстаған олжаға тең келер емес
Dialogue: 0,0:17:07.23,0:17:08.16,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:17:08.16,0:17:09.72,Default,,0,0,0,,Бұл өте жақсы
Dialogue: 0,0:17:09.72,0:17:10.97,Default,,0,0,0,,Хмм
Dialogue: 0,0:17:12.45,0:17:14.64,Default,,0,0,0,,Маған не ұнайды?
Dialogue: 0,0:17:15.01,0:17:18.64,Default,,0,0,0,,Мен мұны істеп жатқанда, басқа жігіттер оқып жатыр.
Dialogue: 0,0:17:23.09,0:17:25.82,Default,,0,0,0,,Жел жақсы емес пе, бала?
Dialogue: 0,0:17:30.91,0:17:33.11,Default,,0,0,0,,Жыпылықтаған жалын және сықырлаған дыбыстар
Dialogue: 0,0:17:33.30,0:17:35.87,Default,,0,0,0,,Ағаштардың сыбдыры, топырақтың иісі
Dialogue: 0,0:17:36.05,0:17:39.03,Default,,0,0,0,,Міне, осылайша бес сезімге беріліп, адасып кетесің.
Dialogue: 0,0:17:39.03,0:17:40.34,Default,,0,0,0,,Жаман емес.
Dialogue: 0,0:17:41.15,0:17:44.54,Default,,0,0,0,,Бұлыңғыр болса да, ол империялық түске айнала алмайды.
Dialogue: 0,0:17:45.44,0:17:46.42,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:17:46.63,0:17:48.51,Default,,0,0,0,,Соңғы неврология бойынша
Dialogue: 0,0:17:48.51,0:17:52.33,Default,,0,0,0,,Ойдан тыс уақытта ми өте белсенді болады дейді.
Dialogue: 0,0:17:52.86,0:17:56.53,Default,,0,0,0,,Есте сақтау және шығармашылық сияқты нәрселермен байланысты деп айтылады.
Dialogue: 0,0:17:56.91,0:17:59.40,Default,,0,0,0,,Танымал авторлар мен спортшылар
Dialogue: 0,0:17:59.40,0:18:02.52,Default,,0,0,0,,Олар алаңдауға уақытын бағалайтын сияқты.
Dialogue: 0,0:18:02.83,0:18:04.20,Default,,0,0,0,,Егер сіз бейшара болсаңыз
Dialogue: 0,0:18:04.20,0:18:07.35,Default,,0,0,0,,Сіз қысқа уақытта 8 Стелла ала аласыз.
Dialogue: 0,0:18:08.95,0:18:10.53,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:18:11.37,0:18:12.24,Default,,0,0,0,,Таң қалды
Dialogue: 0,0:18:12.86,0:18:21.87,Default,,0,0,0,,Ашу
Dialogue: 0,0:18:15.80,0:18:19.09,Default,,0,0,0,,Құрметті Дамиан, бұл тым анық емес деп ойлаймын...
Dialogue: 0,0:18:19.09,0:18:21.41,Default,,0,0,0,,Бұл адам таңқаларлық қарапайым.
Dialogue: 0,0:18:24.02,0:18:24.52,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:25.63,0:18:27.34,Default,,0,0,0,,Менің киімім қатты кепті.
Dialogue: 0,0:18:27.34,0:18:29.59,Default,,0,0,0,,Көлге жаяу барамыз ба?
Dialogue: 0,0:18:32.05,0:18:35.24,Default,,0,0,0,,Оны студенттер арасында Стелла көлі деп атаса керек.
Dialogue: 0,0:18:35.24,0:18:36.69,Default,,0,0,0,,Stella Go
Dialogue: 0,0:18:36.69,0:18:37.42,Default,,0,0,0,,(Хабаршы) «Ақ камелия сарайында оның сұлулығы мадақталады—»
Dialogue: 0,0:18:37.42,0:18:39.20,Default,,0,0,0,,Мен Стеллаға тым қатты құмармын
Dialogue: 0,0:18:39.76,0:18:43.52,Default,,0,0,0,,Пику Пику пикнигі
Dialogue: 0,0:18:44.50,0:18:45.52,Default,,0,0,0,,Енді
Dialogue: 0,0:18:45.74,0:18:47.99,Default,,0,0,0,,Оңтүстікте оны пикник деп атайды.
Dialogue: 0,0:18:47.99,0:18:51.61,Default,,0,0,0,,Батысқа үшінші елдер арқылы бет бұрғандар саны артып бара жатқан сияқты.
Dialogue: 0,0:18:52.73,0:18:55.31,Default,,0,0,0,,Ұстаз, бізді батысқа сатпақшы
Dialogue: 0,0:18:56.88,0:18:59.78,Default,,0,0,0,,Сіз тек 23 шақырым жаяу жүріп ақау жасай алмайсыз.
Dialogue: 0,0:19:00.17,0:19:01.95,Default,,0,0,0,,Неліктен батысқа бара жатырсың?
Dialogue: 0,0:19:02.15,0:19:04.69,Default,,0,0,0,,Қызық, батыстың тәттілері жақсы ма?
Dialogue: 0,0:19:04.92,0:19:06.61,Default,,0,0,0,,Неге деп ойлаймын.
Dialogue: 0,0:19:06.61,0:19:08.37,Default,,0,0,0,,Тіпті Останияның түнгі аспаны
Dialogue: 0,0:19:08.37,0:19:10.48,Default,,0,0,0,,Бұл өте керемет!
Dialogue: 0,0:19:11.53,0:19:12.72,Default,,0,0,0,,Жарайды
Dialogue: 0,0:19:12.72,0:19:14.44,Default,,0,0,0,,Дамиан-сама есейгенде
Dialogue: 0,0:19:14.44,0:19:17.41,Default,,0,0,0,,Бұл Останияны одан да жақсы сезінеді.
Dialogue: 0,0:19:19.14,0:19:20.94,Default,,0,0,0,,Сіз саясаткер болуға ұмтыласыз ба?
Dialogue: 0,0:19:20.94,0:19:22.03,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:19:22.80,0:19:24.81,Default,,0,0,0,,Себебі менің әкем сондай...
Dialogue: 0,0:19:25.03,0:19:26.24,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:27.47,0:19:30.72,Default,,0,0,0,,Бір нәрсеге талмай еңбек ете білу керемет.
Dialogue: 0,0:19:30.91,0:19:33.52,Default,,0,0,0,,Айтпақшы, менің арманым ғарышкер болу.
Dialogue: 0,0:19:33.52,0:19:35.35,Default,,0,0,0,,Иә, бұл тамаша.
Dialogue: 0,0:19:35.73,0:19:37.26,Default,,0,0,0,,Менмін менмін
Dialogue: 0,0:19:38.04,0:19:39.11,Default,,0,0,0,,Атап айтқанда, ештеңе жоқ
Dialogue: 0,0:19:39.11,0:19:40.40,Default,,0,0,0,,Иә немесе жоқ
Dialogue: 0,0:19:40.40,0:19:41.38,Default,,0,0,0,,Бұл да жақсы.
Dialogue: 0,0:19:41.75,0:19:44.50,Default,,0,0,0,,Өйткені, мен тәттілерді көп жеп, өмір сүргім келеді.
Dialogue: 0,0:19:44.50,0:19:45.57,Default,,0,0,0,,Wonderful
Dialogue: 0,0:19:45.57,0:19:46.68,Default,,0,0,0,,Бұл не арман?
Dialogue: 0,0:19:47.06,0:19:49.34,Default,,0,0,0,,Ал, мен бұл туралы шындап ойлануым керек.
Dialogue: 0,0:19:49.34,0:19:51.69,Default,,0,0,0,,Біз бұл ортаны қалай жасай аламыз?
Dialogue: 0,0:19:51.69,0:19:55.21,Default,,0,0,0,,Сіз көп тамақтансаңыз да қалай сау бола аласыз?
Dialogue: 0,0:19:55.84,0:19:56.72,Default,,0,0,0,,Мазасыз
Dialogue: 0,0:19:59.68,0:20:00.72,Default,,0,0,0,,Келу
Dialogue: 0,0:20:18.16,0:20:19.26,Default,,0,0,0,,Керемет
Dialogue: 0,0:20:19.26,0:20:22.01,Default,,0,0,0,,Жұлдыздар су бетінде шағылысып, оны ғарыш кеңістігіне ұқсатады.
Dialogue: 0,0:20:22.33,0:20:23.85,Default,,0,0,0,,Қарашы, балам.
Dialogue: 0,0:20:24.18,0:20:25.90,Default,,0,0,0,,Мен жұлдызды ұстай алатындай сезінемін
Dialogue: 0,0:20:26.13,0:20:27.13,Default,,0,0,0,,Жасайық
Dialogue: 0,0:20:28.35,0:20:29.70,Default,,0,0,0,,Уақытты босқа кетіру болды ма?
Dialogue: 0,0:20:33.97,0:20:34.60,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:36.37,0:20:37.72,Default,,0,0,0,,Менің ойымша, бұл әдемі
Dialogue: 0,0:20:39.42,0:20:40.54,Default,,0,0,0,,That's right.
Dialogue: 0,0:20:42.15,0:20:43.26,Default,,0,0,0,,Бұл әдемі
Dialogue: 0,0:20:57.16,0:20:59.28,Default,,0,0,0,,Ғалам орасан зор, солай емес пе?
Dialogue: 0,0:20:59.51,0:21:00.63,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:21:00.91,0:21:01.85,Default,,0,0,0,,Жұлдыздар дегеніміз не?
Dialogue: 0,0:21:01.85,0:21:04.91,Default,,0,0,0,,Қант себілгендей дәмді көрінеді.
Dialogue: 0,0:21:09.94,0:21:11.76,Default,,0,0,0,,Дэмиан күлді.
Dialogue: 0,0:21:12.96,0:21:14.55,Default,,0,0,0,,Міне!
Dialogue: 0,0:21:15.92,0:21:17.44,Default,,0,0,0,,Мен жақында үйге барамын.
Dialogue: 0,0:21:17.74,0:21:20.30,Default,,0,0,0,,Бұл сыртта оқу болды.
Dialogue: 0,0:21:20.30,0:21:21.16,Default,,0,0,0,,Балалар
Dialogue: 0,0:21:21.16,0:21:23.05,Default,,0,0,0,,Тиісті есеп жазыңыз.
Dialogue: 0,0:21:24.34,0:21:27.18,Default,,0,0,0,,Мен үйге келген соң бірден душ қабылдап, ұйықтағым келеді.
Dialogue: 0,0:21:27.70,0:21:29.56,Default,,0,0,0,,Дені сау бала
Dialogue: 0,0:21:30.82,0:21:32.06,Default,,0,0,0,,Есеп № 006
Dialogue: 0,0:21:32.75,0:21:35.81,Default,,0,0,0,,Мен үш адамның далалық зерттеу есептерін әкелдім.
Dialogue: 0,0:21:36.14,0:21:38.10,Default,,0,0,0,,Рахмет, Грин мырза.
Dialogue: 0,0:21:38.50,0:21:40.64,Default,,0,0,0,,Олар қанатын кеңге жая алды ма?
Dialogue: 0,0:21:41.76,0:21:43.02,Default,,0,0,0,,Мен солай деп үміттенемін.
Dialogue: 0,0:21:44.10,0:21:45.83,Default,,0,0,0,,Бұл талғампаз
Dialogue: 0,0:21:46.22,0:21:49.60,Default,,0,0,0,,Көп нәрсені көру және жасау қызықты болды.
Dialogue: 0,0:21:49.86,0:21:53.12,Default,,0,0,0,,Дегенмен, жапондық күш-жігерді қажет етеді.
Dialogue: 0,0:21:57.55,0:22:00.92,Default,,0,0,0,,Бұл субтитрді Моечая шығарған. Оны коммерциялық мақсатта пайдалануға болады.
Dialogue: 0,0:22:12.14,0:22:18.94,Default,,0,0,0,,Көру аймағыңызда қою қызыл қызыл түс пайда болады
Dialogue: 0,0:22:21.82,0:22:29.08,Default,,0,0,0,,Шамамен 40 000 км алға
Dialogue: 0,0:22:32.08,0:22:36.50,Default,,0,0,0,,Артында жақындап келе жатқан өзара жаралар
Dialogue: 0,0:22:36.83,0:22:41.71,Default,,0,0,0,,Адасқан жол мені одан сайын адастырады
Dialogue: 0,0:22:41.71,0:22:46.09,Default,,0,0,0,,Көрінбейтін, иісі сезілмейтін және өзгертілмейтін болашақ
Dialogue: 0,0:22:46.39,0:22:48.30,Default,,0,0,0,,Мен сенің арқаңнан пышақ сұғып алдым!
Dialogue: 0,0:22:49.43,0:22:57.94,Default,,0,0,0,,Бүгін кешке жаныңда болуға рұқсат ет
Dialogue: 0,0:22:59.06,0:23:06.86,Default,,0,0,0,,Мен бүгін кешке байыптымын.
Dialogue: 0,0:23:08.12,0:23:10.58,Default,,0,0,0,,Қосымша ақпарат алу үшін осында келіңіз
Dialogue: 0,0:23:10.58,0:23:12.91,Default,,0,0,0,,Біз дұға еткен болашақ
Dialogue: 0,0:23:12.91,0:23:14.87,Default,,0,0,0,,Жолдар әртүрлі.
Dialogue: 0,0:23:20.09,0:23:22.46,Default,,0,0,0,,Өзара өлтіру ниетімен
Dialogue: 0,0:23:22.46,0:23:25.84,Default,,0,0,0,,Сіз соңғы соққыны аласыз.
Dialogue: 0,0:23:27.26,0:23:30.47,Default,,0,0,0,,Ақыр соңында мен оны тоқтатамын.
Dialogue: 0,0:23:37.94,0:23:40.94,Default,,0,0,0,,Жауапкершілік пен отбасы, бала жүрегі мен бала жүрегі
Dialogue: 0,0:23:42.44,0:23:47.44,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
