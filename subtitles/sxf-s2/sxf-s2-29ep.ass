Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Даналықтың тәттілігі
Dialogue: 0,0:00:06.00,0:00:07.99,Default,,0,0,0,,Едем мектебінің жеті кереметінің бірі
Dialogue: 0,0:00:08.24,0:00:11.97,Default,,0,0,0,,Мектеп асханасына жоқ жерден келетін жұмбақ аспазшы.
Dialogue: 0,0:00:11.97,0:00:14.60,Default,,0,0,0,,Еріксіз ұсынылатын тәттілер
Dialogue: 0,0:00:14.60,0:00:16.60,Default,,0,0,0,,Тамаша дәм ғана емес
Dialogue: 0,0:00:17.09,0:00:21.48,Default,,0,0,0,,Оны жегендер де император ғалымдары болды.
Dialogue: 0,0:00:21.48,0:00:23.71,Default,,0,0,0,,«Егер сіз тамақ жесеңіз, сіз бірден ақылды боласыз».
Dialogue: 0,0:00:23.71,0:00:25.20,Default,,0,0,0,,Мұндай өсек туды
Dialogue: 0,0:00:25.20,0:00:30.28,Default,,0,0,0,,Кейбір Едем студенттері тапсырыс беру мүмкіндігін қарастырды.
Dialogue: 0,0:00:42.52,0:00:45.07,Default,,0,0,0,,Сұрақ қою батыл әрекет
Dialogue: 0,0:00:45.07,0:00:47.65,Default,,0,0,0,,Сұрақ Басқаларды сүймейтін өмір
Dialogue: 0,0:00:47.65,0:00:50.20,Default,,0,0,0,,Сатқындық пен бейбітшілікке сұрақ
Dialogue: 0,0:00:50.20,0:00:52.41,Default,,0,0,0,,Сұрақ не?
Dialogue: 0,0:00:52.70,0:00:54.58,Default,,0,0,0,,Дүние екіге бөлінген
Dialogue: 0,0:00:54.58,0:00:57.24,Default,,0,0,0,,Әрбір жасырын әділдік болып табылады
Dialogue: 0,0:00:57.83,0:00:59.71,Default,,0,0,0,,Гарандого қарсы тұру
Dialogue: 0,0:00:59.71,0:01:01.46,Default,,0,0,0,,Үйілген және қабаттастырылған
Dialogue: 0,0:01:01.46,0:01:02.96,Default,,0,0,0,,Екі жақты екі бет
Dialogue: 0,0:01:03.83,0:01:05.88,Default,,0,0,0,,Парасаттылық, төмендік және сахна артындағы
Dialogue: 0,0:01:06.38,0:01:08.09,Default,,0,0,0,,Мұның соңы немесе ақыры маңызды емес.
Dialogue: 0,0:01:08.96,0:01:10.26,Default,,0,0,0,,Дәл уақыт өте стандарт болып табылады
Dialogue: 0,0:01:10.26,0:01:12.09,Default,,0,0,0,,Мен бұл туралы бірдеңе жасадым.
Dialogue: 0,0:01:12.09,0:01:16.39,Default,,0,0,0,,Crazy әңгіме, бәрі әлдеқашан шешілген сияқты
Dialogue: 0,0:01:16.39,0:01:19.10,Default,,0,0,0,,Ерекшеліксіз қалыптан тыс жағдай
Dialogue: 0,0:01:19.10,0:01:21.77,Default,,0,0,0,,Әдетте ешқандай себепсіз
Dialogue: 0,0:01:22.60,0:01:25.11,Default,,0,0,0,,Дұрыс пен бұрыс тұрақсыз
Dialogue: 0,0:01:25.11,0:01:27.98,Default,,0,0,0,,Іштен шыққан шынайы сезімдер жинақталады
Dialogue: 0,0:01:27.98,0:01:30.28,Default,,0,0,0,,Кейде оны қорытуға мүмкіндік болмайды.
Dialogue: 0,0:01:30.28,0:01:32.78,Default,,0,0,0,,Сіз мұны байқамай қарсы аласыз ба?
Dialogue: 0,0:01:32.78,0:01:35.57,Default,,0,0,0,,Қайғылы емеспін, бірақ бәрібір осылай
Dialogue: 0,0:01:35.57,0:01:37.95,Default,,0,0,0,,Мен 100% білмеймін
Dialogue: 0,0:01:37.95,0:01:42.91,Default,,0,0,0,,Мен өз уайымымнан құтылсам екен деп тілеймін, тілеймін және мұңайдым.
Dialogue: 0,0:01:42.91,0:01:45.58,Default,,0,0,0,,Егер бұл перде желбіресе
Dialogue: 0,0:01:45.58,0:01:48.30,Default,,0,0,0,,Идеалдар мен шындық теңселеді
Dialogue: 0,0:01:50.21,0:01:52.72,Default,,0,0,0,,Сұрақ қою батыл әрекет
Dialogue: 0,0:01:52.72,0:01:55.22,Default,,0,0,0,,Сұрақ Басқаларсыз өмір
Dialogue: 0,0:01:55.22,0:01:57.89,Default,,0,0,0,,Сатқындық пен бейбітшілікке сұрақ
Dialogue: 0,0:01:57.89,0:01:59.10,Default,,0,0,0,,Сұрақ не?
Dialogue: 0,0:02:01.98,0:02:04.98,Default,,0,0,0,,Даналық сыйлық нүктесі
Dialogue: 0,0:02:06.17,0:02:07.73,Default,,0,0,0,,Мүмкін сіз
Dialogue: 0,0:02:07.73,0:02:09.36,Default,,0,0,0,,Сол кездегі ханзада
Dialogue: 0,0:02:09.73,0:02:10.49,Default,,0,0,0,,Жоқ
Dialogue: 0,0:02:10.49,0:02:12.86,Default,,0,0,0,,Мен сенің басқа эгосыңмын
Dialogue: 0,0:02:12.86,0:02:14.65,Default,,0,0,0,,Жоқ, сөзсіз.
Dialogue: 0,0:02:14.65,0:02:16.48,Default,,0,0,0,,Бұл көздер, бұл шаштар
Dialogue: 0,0:02:16.96,0:02:18.26,Default,,0,0,0,,Менің ханзадам
Dialogue: 0,0:02:18.26,0:02:18.99,Default,,0,0,0,,Ұнады
Dialogue: 0,0:02:19.28,0:02:23.04,Default,,0,0,0,,Жоқ, мен де сен сияқты қоймын.
Dialogue: 0,0:02:23.81,0:02:27.16,Default,,0,0,0,,Оқиға енді мүлде дамымайды.
Dialogue: 0,0:02:27.16,0:02:28.28,Default,,0,0,0,,Бұл тәртіпсіздік
Dialogue: 0,0:02:28.28,0:02:30.70,Default,,0,0,0,,Өйткені олар бірдей көрінеді
Dialogue: 0,0:02:30.70,0:02:33.13,Default,,0,0,0,,Параметрлерде мұны елемеңіз.
Dialogue: 0,0:02:33.35,0:02:34.83,Default,,0,0,0,,Келесі кезекте Аня
Dialogue: 0,0:02:34.83,0:02:37.50,Default,,0,0,0,,Бөлінген егіздер арасындағы шайқас
Dialogue: 0,0:02:37.50,0:02:38.64,Default,,0,0,0,,Сәлем
Dialogue: 0,0:02:38.64,0:02:41.43,Default,,0,0,0,,Егер біз шайқасатын болсақ, бұл балалар зардап шегеді.
Dialogue: 0,0:02:42.39,0:02:43.92,Default,,0,0,0,,Мен мұны естідім.
Dialogue: 0,0:02:43.92,0:02:47.37,Default,,0,0,0,,Академиялық қабілетке негізделген сабақтар екінші семестрде басталады.
Dialogue: 0,0:02:47.37,0:02:48.40,Default,,0,0,0,,Доюко
Dialogue: 0,0:02:48.67,0:02:49.62,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:02:49.39,0:02:51.65,Default,,0,0,0,,Тяньцзы тобы Қарапайым топ
Dialogue: 0,0:02:49.84,0:02:51.96,Default,,0,0,0,,Жақсы оқитын мен және мен
Dialogue: 0,0:02:51.65,0:02:52.15,Default,,0,0,0,,Тяньцзы тобы Қарапайым топ Тяньцзы тобы Қарапайым топ
Dialogue: 0,0:02:51.81,0:02:52.40,Default,,0,0,0,,Тяньцзы тобы Қарапайым топ Міндетті май тобы Тяньцзы тобы Қарапайым топ Міндетті май тобы
Dialogue: 0,0:02:51.98,0:02:52.48,Default,,0,0,0,,Tianzi тобы Қарапайым топ Міндетті май тобы Тяньцзы тобы Қарапайым топ Міндетті май тобы
Dialogue: 0,0:02:52.15,0:02:54.39,Default,,0,0,0,,Тяньцзы тобы Қарапайым топ Міндетті май тобы Қазіргі уақытта осында Жақсы оқып жатқан Аня-чанмен. Қарапайым топ Міндетті май тобы Қазіргі уақытта осында Тяньцзы тобы Қарапайым топ Міндетті май тобы Қазіргі уақытта осында
Dialogue: 0,0:02:52.27,0:02:52.85,Default,,0,0,0,,Tianzi тобы Қарапайым топ Міндетті май тобы Қазіргі уақытта осында Қарапайым топ Міндетті май тобы Қазіргі уақытта осында
Dialogue: 0,0:02:52.44,0:02:53.02,Default,,0,0,0,,Қарапайым топ Міндетті май тобы Қазіргі уақытта осында Қарапайым топ Міндетті май тобы Қазіргі уақытта осында
Dialogue: 0,0:02:52.60,0:02:53.10,Default,,0,0,0,,Қарапайым топ Міндетті май тобы Қазіргі уақытта осында Міндетті май тобы Қазіргі уақытта осында
Dialogue: 0,0:02:52.77,0:02:53.44,Default,,0,0,0,,Міндетті май тобы Қазіргі уақытта осында Міндетті май тобы Қазіргі уақытта осында
Dialogue: 0,0:02:53.02,0:02:58.65,Default,,0,0,0,,Міндетті май тобы Қазіргі уақытта осында
Dialogue: 0,0:02:54.39,0:02:57.49,Default,,0,0,0,,Кейбір сыныптар жеке сыныптарға бөлінеді.
Dialogue: 0,0:02:59.01,0:03:01.08,Default,,0,0,0,,Аня жалғыз қалады
Dialogue: 0,0:03:01.08,0:03:02.43,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:03:02.43,0:03:04.58,Default,,0,0,0,,Сондықтан мен көп оқуым керек
Dialogue: 0,0:03:05.33,0:03:07.28,Default,,0,0,0,,Аралық кезеңнің соңына қосымша
Dialogue: 0,0:03:07.28,0:03:10.56,Default,,0,0,0,,Ертеңгі викторина да пайымдау үшін негіз ретінде пайдаланылады деген қауесет бар.
Dialogue: 0,0:03:10.56,0:03:13.00,Default,,0,0,0,,Сондай-ақ ежелгі тіл сынағы болады.
Dialogue: 0,0:03:13.35,0:03:14.39,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:03:14.39,0:03:15.90,Default,,0,0,0,,Аня, бәрі жақсы.
Dialogue: 0,0:03:15.90,0:03:17.74,Default,,0,0,0,,Татата қиын.
Dialogue: 0,0:03:18.02,0:03:19.38,Default,,0,0,0,,Ол шықты Ол шықты
Dialogue: 0,0:03:19.38,0:03:20.72,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:20.96,0:03:24.06,Default,,0,0,0,,Мен екінші асханаға бардым, бұрынғы тәтті тағам ұсынылды.
Dialogue: 0,0:03:24.42,0:03:25.42,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:25.42,0:03:27.06,Default,,0,0,0,,Ақымақ, білмейсің бе?
Dialogue: 0,0:03:27.06,0:03:30.36,Default,,0,0,0,,Корольдік сарайдың бұрынғы аспазшысы аңызға айналған кондитер аспазымен жасалған.
Dialogue: 0,0:03:30.73,0:03:32.36,Default,,0,0,0,,Әдетте даналық тәттілігі деп аталады
Dialogue: 0,0:03:32.36,0:03:35.52,Default,,0,0,0,,Оны жеген адам міндетті түрде императорлық ғалым болады.
Dialogue: 0,0:03:35.52,0:03:37.11,Default,,0,0,0,,Бұл керемет тәтті
Dialogue: 0,0:03:38.32,0:03:40.07,Default,,0,0,0,,Биылғы макаронға ұқсайды
Dialogue: 0,0:03:40.22,0:03:43.24,Default,,0,0,0,,Саны шектеулі, сондықтан оны басқа біреу алмас бұрын асығыңыз.
Dialogue: 0,0:03:50.45,0:03:52.84,Default,,0,0,0,,Аня мұны да жесе, данышпан болады.
Dialogue: 0,0:03:52.84,0:03:58.01,Default,,0,0,0,,Дәліз арқылы жүру
Dialogue: 0,0:03:53.09,0:03:54.96,Default,,0,0,0,,Менің ойымша, бұл бәрібір ұят
Dialogue: 0,0:03:54.96,0:03:57.13,Default,,0,0,0,,Мұндай нәрселерде тәжірибенің болуы маңызды.
Dialogue: 0,0:03:57.13,0:04:00.34,Default,,0,0,0,,Дәлірек айтқанда, патша аспазының макарондары.
Dialogue: 0,0:04:00.34,0:04:01.84,Default,,0,0,0,,Мен қалыпты тамақтанғым келеді.
Dialogue: 0,0:04:01.84,0:04:02.79,Default,,0,0,0,,Ал оның Регалияларының көбі шын мәнінде Нора болып шықты.
Dialogue: 0,0:04:02.79,0:04:03.76,Default,,0,0,0,,Макарон дегеніміз не?
Dialogue: 0,0:04:05.10,0:04:06.03,Default,,0,0,0,,Мен бұл жерде екеніне сенімдімін.
Dialogue: 0,0:04:06.03,0:04:07.73,Default,,0,0,0,,Егер сіз асықпасаңыз, ол жоғалады.
Dialogue: 0,0:04:10.47,0:04:11.29,Default,,0,0,0,,Жоқ, бұл менің кінәм.
Dialogue: 0,0:04:11.52,0:04:12.72,Default,,0,0,0,,Чинчукурин
Dialogue: 0,0:04:12.98,0:04:14.27,Default,,0,0,0,,Неге сонша үмітсізсің?
Dialogue: 0,0:04:14.27,0:04:16.15,Default,,0,0,0,,Міне!
Dialogue: 0,0:04:16.35,0:04:19.89,Default,,0,0,0,,Пьер Помьенің жаңа кәмпиттері Тек біреуі қалды!
Dialogue: 0,0:04:20.61,0:04:22.20,Default,,0,0,0,,Бірінші келген, бірінші қызмет етеді!
Dialogue: 0,0:04:22.39,0:04:24.20,Default,,0,0,0,,Мен оны саған бермеймін.
Dialogue: 0,0:04:24.20,0:04:26.95,Default,,0,0,0,,Бұл енді Стелла үшін шайқас
Dialogue: 0,0:04:26.95,0:04:28.33,Default,,0,0,0,,Маған беріңізші
Dialogue: 0,0:04:28.33,0:04:29.56,Default,,0,0,0,,Мен шын мәнінде айта алмаймын.
Dialogue: 0,0:04:31.14,0:04:33.80,Default,,0,0,0,,Бүгінгі сатылым аяқталды.
Dialogue: 0,0:04:34.76,0:04:35.77,Default,,0,0,0,,Сен басқа әлемнен келгеніңді айтасың ба?
Dialogue: 0,0:04:35.77,0:04:39.01,Default,,0,0,0,,Мен мұнымен Стелланы да ала аламын ба деп ойлаймын. Мен оны асыға күтемін.
Dialogue: 0,0:04:39.01,0:04:40.21,Default,,0,0,0,,Джордж
Dialogue: 0,0:04:41.23,0:04:43.02,Default,,0,0,0,,Теме, бұл менмін
Dialogue: 0,0:04:43.02,0:04:44.10,Default,,0,0,0,,Оны маған бер.
Dialogue: 0,0:04:44.10,0:04:46.10,Default,,0,0,0,,Мен оны жейтін болдым.
Dialogue: 0,0:04:46.43,0:04:47.22,Default,,0,0,0,,Бұл тонау.
Dialogue: 0,0:04:47.78,0:04:50.11,Default,,0,0,0,,Мен оны аз ақшама сатып алдым.
Dialogue: 0,0:04:50.11,0:04:51.31,Default,,0,0,0,,Беретін нәрсе ме?
Dialogue: 0,0:04:52.05,0:04:55.22,Default,,0,0,0,,Теме, айтпақшы, қалам қорабын қайтарып алған жоқпын.
Dialogue: 0,0:04:55.83,0:04:58.80,Default,,0,0,0,,Бекер ән айтудан мен де ұялдым.
Dialogue: 0,0:04:58.80,0:05:00.07,Default,,0,0,0,,Жапырақтың кек
Dialogue: 0,0:05:00.26,0:05:02.18,Default,,0,0,0,,Мен... түсіндім.
Dialogue: 0,0:05:02.18,0:05:03.50,Default,,0,0,0,,Бұлардың 5-еуі бар.
Dialogue: 0,0:05:03.50,0:05:05.70,Default,,0,0,0,,Қалған төртеуін саған беремін.
Dialogue: 0,0:05:05.70,0:05:07.46,Default,,0,0,0,,Сондықтан мені мазақ ет
Dialogue: 0,0:05:07.46,0:05:09.11,Default,,0,0,0,,Сіз жақсы жігітсіз.
Dialogue: 0,0:05:09.54,0:05:11.00,Default,,0,0,0,,4 қалды
Dialogue: 0,0:05:22.69,0:05:23.69,Default,,0,0,0,,Осылайша
Dialogue: 0,0:05:23.93,0:05:28.64,Default,,0,0,0,,Императорлық стипендиат болу үшін қызу шайқас басталды.
Dialogue: 0,0:05:30.97,0:05:32.91,Default,,0,0,0,,Бұл бір орындалатын жарыс
Dialogue: 0,0:05:33.19,0:05:35.42,Default,,0,0,0,,Соңғы орында тұрған жігітте макарон жоқ.
Dialogue: 0,0:05:35.42,0:05:37.48,Default,,0,0,0,,Жарайды, не қаласаңыз.
Dialogue: 0,0:05:37.48,0:05:39.34,Default,,0,0,0,,Аня Трамп алғаш рет
Dialogue: 0,0:05:39.34,0:05:40.46,Default,,0,0,0,,Мен ережелерді білмеймін
Dialogue: 0,0:05:40.46,0:05:41.81,Default,,0,0,0,,Бұл жігіт шынымен бе?
Dialogue: 0,0:05:41.81,0:05:42.89,Default,,0,0,0,,Бұл оңай.
Dialogue: 0,0:05:42.89,0:05:44.32,Default,,0,0,0,,Жокерді тартпаңыз
Dialogue: 0,0:05:44.32,0:05:46.49,Default,,0,0,0,,Бар болғаны бірдей сандарды сәйкестендіру.
Dialogue: 0,0:05:46.73,0:05:47.27,Default,,0,0,0,,Күтуім керек екен ғой?
Dialogue: 0,0:05:49.38,0:05:50.50,Default,,0,0,0,,Қазір
Dialogue: 0,0:05:50.81,0:05:52.40,Default,,0,0,0,,Әй, оны Бабаға айналдыр.
Dialogue: 0,0:05:52.40,0:05:54.34,Default,,0,0,0,,Бұл жігітке күштеп, оны оған қалдырыңыз.
Dialogue: 0,0:05:54.34,0:05:55.26,Default,,0,0,0,,ража
Dialogue: 0,0:05:55.55,0:05:59.27,Default,,0,0,0,,Кемпірлер туралы ештеңе білмейтін адамға ақылдың тәттілігі тым бекер.
Dialogue: 0,0:06:05.39,0:06:07.26,Default,,0,0,0,,Сіздің кезегіңіз.
Dialogue: 0,0:06:07.55,0:06:11.33,Default,,0,0,0,,Аняда 6, 4 және 10 бар.
Dialogue: 0,0:06:11.33,0:06:13.47,Default,,0,0,0,,Мұны айтудың қажеті жоқ, Аня-чан.
Dialogue: 0,0:06:15.46,0:06:16.56,Default,,0,0,0,,Бұл бір кездері болған оқиға
Dialogue: 0,0:06:16.88,0:06:18.56,Default,,0,0,0,,Бабаны қол жететін жерге қойыңыз.
Dialogue: 0,0:06:18.56,0:06:21.14,Default,,0,0,0,,6-ны жету қиын жерге қойыңыз.
Dialogue: 0,0:06:21.55,0:06:22.64,Default,,0,0,0,,Жүріңіз, тартыңыз.
Dialogue: 0,0:06:26.85,0:06:27.94,Default,,0,0,0,,6
Dialogue: 0,0:06:30.94,0:06:32.92,Default,,0,0,0,,Таңғажайып Аня-чан
Dialogue: 0,0:06:33.36,0:06:35.15,Default,,0,0,0,,Ал... бұл жай ғана кездейсоқтық.
Dialogue: 0,0:06:36.67,0:06:37.36,Default,,0,0,0,,4
Dialogue: 0,0:06:37.73,0:06:38.43,Default,,0,0,0,,10
Dialogue: 0,0:06:38.80,0:06:39.50,Default,,0,0,0,,А
Dialogue: 0,0:06:39.81,0:06:40.88,Default,,0,0,0,,Қария
Dialogue: 0,0:06:41.17,0:06:42.34,Default,,0,0,0,,Э-э, жоқ.
Dialogue: 0,0:06:42.34,0:06:44.67,Default,,0,0,0,,Аня туралы бәрі жойылды.
Dialogue: 0,0:06:44.67,0:06:45.80,Default,,0,0,0,,Күте тұрыңыз, күтіңіз
Dialogue: 0,0:06:45.80,0:06:47.23,Default,,0,0,0,,Бұл тым күшті, солай емес пе?
Dialogue: 0,0:06:47.76,0:06:49.42,Default,,0,0,0,,Иә, бұл жалған.
Dialogue: 0,0:06:49.42,0:06:51.58,Default,,0,0,0,,Менің ойымша, олар картаға немесе басқа нәрсеге белгі қойды.
Dialogue: 0,0:06:51.58,0:06:53.93,Default,,0,0,0,,Не? Менімен флирт жасама.
Dialogue: 0,0:06:55.21,0:06:59.01,Default,,0,0,0,,Егер сіз алдамшы болмасаңыз, мұндай ойларды оқи алатыныңызға сене алмаймын.
Dialogue: 0,0:06:59.01,0:07:01.69,Default,,0,0,0,,Аня көңілін қалдырды.
Dialogue: 0,0:07:03.03,0:07:05.93,Default,,0,0,0,,Егер сіз соншалықты көп айтқыңыз келсе, одан әрі баруға болады.
Dialogue: 0,0:07:07.05,0:07:08.82,Default,,0,0,0,,Аня-чан тым тәтті
Dialogue: 0,0:07:09.16,0:07:11.62,Default,,0,0,0,,Жаңа ойын карталарымен басынан бастайық.
Dialogue: 0,0:07:11.62,0:07:12.95,Default,,0,0,0,,Мен де тәртіпті өзгертемін.
Dialogue: 0,0:07:12.95,0:07:15.06,Default,,0,0,0,,Теме, енді алдама.
Dialogue: 0,0:07:15.06,0:07:16.17,Default,,0,0,0,,Менде жоқ.
Dialogue: 0,0:07:17.79,0:07:19.20,Default,,0,0,0,,●
Dialogue: 0,0:07:19.20,0:07:21.26,Default,,0,0,0,,Адамдарға сіздің экстрасенс екеніңізді білдірмеңіз
Dialogue: 0,0:07:21.26,0:07:24.08,Default,,0,0,0,,Мен әдейі сәтсіздікке ұшырағандай көрінуім керек.
Dialogue: 0,0:07:32.40,0:07:33.89,Default,,0,0,0,,Баба айналып келді
Dialogue: 0,0:07:34.40,0:07:35.14,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:07:35.97,0:07:38.74,Default,,0,0,0,,Баба ортада. Енді, жабыңыз.
Dialogue: 0,0:07:39.12,0:07:40.83,Default,,0,0,0,,Әдейі істен шығу
Dialogue: 0,0:07:43.03,0:07:44.22,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:07:44.22,0:07:47.03,Default,,0,0,0,,Аня мен байқаусызда Бабаны тартып алдым.
Dialogue: 0,0:07:47.94,0:07:48.96,Default,,0,0,0,,Дэсси
Dialogue: 0,0:07:48.96,0:07:49.85,Default,,0,0,0,,Мануке
Dialogue: 0,0:07:49.85,0:07:51.07,Default,,0,0,0,,Доңкуса
Dialogue: 0,0:07:51.98,0:07:53.66,Default,,0,0,0,,Қазір мұны жасайтын уақыт!
Dialogue: 0,0:07:53.66,0:07:55.85,Default,,0,0,0,,Жоқ, Аня-чан, егер сен мені ұрсаң
Dialogue: 0,0:07:57.42,0:07:58.79,Default,,0,0,0,,Бұл қосулы емес.
Dialogue: 0,0:07:59.82,0:08:03.18,Default,,0,0,0,,Қауіпті. Мені шығарған кезде миссия аяқталды.
Dialogue: 0,0:08:03.18,0:08:05.99,Default,,0,0,0,,Мен әкем сияқты салқын өтірікші болуым керек.
Dialogue: 0,0:08:06.20,0:08:07.17,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:08:07.17,0:08:10.80,Default,,0,0,0,,Мен екінші ұлыма осы кемпірді басқаруға рұқсат етсем, Аня аман қалады.
Dialogue: 0,0:08:10.80,0:08:11.53,Default,,0,0,0,,Жабу
Dialogue: 0,0:08:29.79,0:08:31.70,Default,,0,0,0,,Түсінуге оңай жігіт.
Dialogue: 0,0:08:32.66,0:08:34.14,Default,,0,0,0,,Жарайды, бәрі дайын.
Dialogue: 0,0:08:34.33,0:08:37.43,Default,,0,0,0,,Менің екінші ұлым да ақыл оқи алатын шығар.
Dialogue: 0,0:08:40.98,0:08:41.71,Default,,0,0,0,,Жоғары
Dialogue: 0,0:08:42.58,0:08:44.21,Default,,0,0,0,,Мен де көтерілдім
Dialogue: 0,0:08:44.54,0:08:47.29,Default,,0,0,0,,Бұл қауіпті. Аняның бабасы жоғалып кетпейді.
Dialogue: 0,0:08:47.48,0:08:49.22,Default,,0,0,0,,Мен де көтерілдім
Dialogue: 0,0:08:52.40,0:08:54.68,Default,,0,0,0,,Дамиан-кун да өте әлсіз.
Dialogue: 0,0:08:54.68,0:08:55.70,Default,,0,0,0,,Ендеше, ертең кездескенше.
Dialogue: 0,0:08:55.70,0:08:57.45,Default,,0,0,0,,Сәттілік Аня-чан
Dialogue: 0,0:08:58.67,0:08:59.69,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:09:00.08,0:09:01.92,Default,,0,0,0,,Бұл матчты шешеді
Dialogue: 0,0:09:01.92,0:09:05.23,Default,,0,0,0,,Жоқ, бұл жігіттің бетіне қарасаң, жеңген сияқты.
Dialogue: 0,0:09:05.40,0:09:09.34,Default,,0,0,0,,Аня, сен Бабаны өтірікші жүзіңмен тартып алу үшін барыңды салуың керек.
Dialogue: 0,0:09:09.34,0:09:13.33,Default,,0,0,0,,Егер біз жеңілсек, Аня бұл кәмпитті жей алмайды және ол әлі де мылқау болады.
Dialogue: 0,0:09:13.33,0:09:17.33,Default,,0,0,0,,Содан кейін сынақ сәтсіз аяқталды және мен Беккимен бірге бөлек сыныпқа түстім.
Dialogue: 0,0:09:17.86,0:09:20.50,Default,,0,0,0,,Аня Мен жалғыз боламын
Dialogue: 0,0:09:21.09,0:09:23.80,Default,,0,0,0,,Жарайды, бұл ескі емес.
Dialogue: 0,0:09:45.96,0:09:47.61,Default,,0,0,0,,Олай болса, төрт адамға.
Dialogue: 0,0:09:47.93,0:09:50.09,Default,,0,0,0,,Иә! Дәмді!
Dialogue: 0,0:09:50.40,0:09:51.54,Default,,0,0,0,,Қызықты
Dialogue: 0,0:09:51.54,0:09:55.09,Default,,0,0,0,,Қымбатты Дамиан, сен неге ол жерде сонша ақымақ әрекет етіп жатқаныңа таңғаламын.
Dialogue: 0,0:09:55.09,0:09:56.41,Default,,0,0,0,,Ендеше, ертең кездескенше.
Dialogue: 0,0:09:56.41,0:09:59.21,Default,,0,0,0,,Ол ақымақ, ол бок
Dialogue: 0,0:10:02.18,0:10:03.11,Default,,0,0,0,,Жоқ, бұл менің кінәм.
Dialogue: 0,0:10:08.51,0:10:10.29,Default,,0,0,0,,Сіз оның жартысын ысқылайсыз ба?
Dialogue: 0,0:10:13.65,0:10:15.81,Default,,0,0,0,,Уайымдама, ақымақ.
Dialogue: 0,0:10:15.81,0:10:19.31,Default,,0,0,0,,Императорлық стипендиат болу үшін маған ондай тағамдарды жеудің қажеті жоқ.
Dialogue: 0,0:10:19.76,0:10:21.51,Default,,0,0,0,,Жеңдер ақымақ, ақымақ
Dialogue: 0,0:10:23.18,0:10:24.87,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:10:25.14,0:10:27.04,Default,,0,0,0,,Аня-чанды жеңіз
Dialogue: 0,0:10:27.76,0:10:29.23,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:10:32.65,0:10:33.85,Default,,0,0,0,,Жауап беріңіз…
Dialogue: 0,0:10:33.85,0:10:35.62,Default,,0,0,0,,Қазір менде де Стелла бар
Dialogue: 0,0:10:57.91,0:10:59.80,Default,,0,0,0,,Викторинаны бастайық
Dialogue: 0,0:11:14.04,0:11:15.86,Default,,0,0,0,,Аня Бокчи растады
Dialogue: 0,0:11:15.86,0:11:18.51,Default,,0,0,0,,Мектеп өмірі, болашағы бұлыңғыр
Dialogue: 0,0:11:18.51,0:11:20.00,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:11:20.00,0:11:21.12,Default,,0,0,0,,Мерзім соңында қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:11:21.33,0:11:24.62,Default,,0,0,0,,Дұрыс, сен қазірдің өзінде жалғыздықтан жақсысың.
Dialogue: 0,0:11:26.62,0:11:29.81,Default,,0,0,0,,Мектеп сынақтары қиын, солай емес пе?
Dialogue: 0,0:11:30.15,0:11:32.98,Default,,0,0,0,,Аня біраз уақыт ұйықтап жатыр.
Dialogue: 0,0:11:36.29,0:11:39.05,Default,,0,0,0,,Менің негізгі академиялық қабілетім біршама жақсарғанымен...
Dialogue: 0,0:11:39.24,0:11:41.12,Default,,0,0,0,,Жол өте ұзақ.
Dialogue: 0,0:11:42.65,0:11:46.64,Default,,0,0,0,,Бұл көне тіл сынағы...Мен емле қателері үшін шегерілетін ұпайларды аламын.
Dialogue: 0,0:11:46.86,0:11:49.10,Default,,0,0,0,,Егер сізде бұл болмаса, сіз көп ұпай аласыз.
Dialogue: 0,0:11:49.53,0:11:52.14,Default,,0,0,0,,Менің ойымша, сіз әлі көне тілді онша көп зерттеген жоқсыз.
Dialogue: 0,0:11:52.14,0:11:54.59,Default,,0,0,0,,Сіз оны туып өскен ортаңыздан үйрендіңіз бе?
Dialogue: 0,0:11:54.59,0:11:57.90,Default,,0,0,0,,Дегенмен әлі күнге дейін архаикалық тілдерді ана тілі ретінде қолданатын елдер жоқ.
Dialogue: 0,0:11:59.59,0:12:02.80,Default,,0,0,0,,Жоқ, ізденудің қажеті жоқ.
Dialogue: 0,0:12:03.39,0:12:04.38,Default,,0,0,0,,Аня
Dialogue: 0,0:12:04.38,0:12:06.58,Default,,0,0,0,,Мен кешкі асқа гамбургерлер жасадым.
Dialogue: 0,0:12:06.58,0:12:08.25,Default,,0,0,0,,Сенің әкең Эден мектебінің түлегі ғой, иә?
Dialogue: 0,0:12:08.25,0:12:10.88,Default,,0,0,0,,Мен десертті де жасап көрдім.
Dialogue: 0,0:12:16.72,0:12:20.04,Default,,0,0,0,,Бұл Dust Heavy Industry компаниясының екінші бөлімі жалған идентификаторы
Dialogue: 0,0:12:20.25,0:12:23.39,Default,,0,0,0,,Бұл жаңа жойғыш ұшағы үшін қозғалтқыштың өнімділігін тексеру сандары.
Dialogue: 0,0:12:23.39,0:12:26.39,Default,,0,0,0,,Ақпарат алмасу махаббат эпикалық шайқасы II
Dialogue: 0,0:12:24.42,0:12:25.86,Default,,0,0,0,,Әрқашан пайдалы
Dialogue: 0,0:12:26.87,0:12:28.46,Default,,0,0,0,,Бұл тегін емес.
Dialogue: 0,0:12:28.72,0:12:31.76,Default,,0,0,0,,Мен бұрын сұраған қауымдастық мүшелерінің бейне деректері
Dialogue: 0,0:12:31.97,0:12:33.36,Default,,0,0,0,,О, солай.
Dialogue: 0,0:12:33.36,0:12:34.49,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:12:34.49,0:12:37.80,Default,,0,0,0,,Мұндайда жақсы хабар берушілердің бірі өшірілді.
Dialogue: 0,0:12:38.57,0:12:39.51,Default,,0,0,0,,Қауіпсіздік бюросы?
Dialogue: 0,0:12:39.51,0:12:41.65,Default,,0,0,0,,Жоқ, менде ешқандай дәлел жоқ.
Dialogue: 0,0:12:41.65,0:12:44.37,Default,,0,0,0,,Оны Бақша қиратты деген қауесет бар.
Dialogue: 0,0:12:44.85,0:12:45.65,Default,,0,0,0,,Бақ
Dialogue: 0,0:12:46.12,0:12:49.67,Default,,0,0,0,,Бұл елде бұрыннан бар делінетін қастандық ұйымы ма?
Dialogue: 0,0:12:49.93,0:12:52.12,Default,,0,0,0,,Бұл дерлік қала аңызына ұқсайды.
Dialogue: 0,0:12:52.12,0:12:54.81,Default,,0,0,0,,Жоқ, олар шын мәнінде бар.
Dialogue: 0,0:12:55.02,0:12:59.01,Default,,0,0,0,,Олар көлеңкелі үкіметтің бұйрығымен ұлттық қарақшыларды бірінен соң бірін тазартуда.
Dialogue: 0,0:12:59.24,0:13:03.26,Default,,0,0,0,,Әрине, кейбір бейресми милиция ұйымдары бар...
Dialogue: 0,0:13:03.26,0:13:03.95,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:13:03.95,0:13:06.25,Default,,0,0,0,,Олар соншалықты жылы емес.
Dialogue: 0,0:13:06.25,0:13:09.86,Default,,0,0,0,,Жалғыз солдаттың бүкіл ротаны жоюға күші бар.
Dialogue: 0,0:13:10.08,0:13:11.45,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:13:11.45,0:13:12.40,Default,,0,0,0,,Мен де солай ойладым, бірақ бұл шешімді талқылаудың қажеті жоқ
Dialogue: 0,0:13:12.83,0:13:13.52,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:13:13.75,0:13:17.05,Default,,0,0,0,,Маған қосымша жұмыс орнына жұмысыма көмектес.
Dialogue: 0,0:13:17.42,0:13:18.43,Default,,0,0,0,,Жұмыс?
Dialogue: 0,0:13:19.97,0:13:20.93,Default,,0,0,0,,Бұл осы.
Dialogue: 0,0:13:20.93,0:13:22.42,Default,,0,0,0,,Жоғалған мысық
Dialogue: 0,0:13:22.42,0:13:25.92,Default,,0,0,0,,Менің сүйікті кафемнің қызметкері Кейсидің үй жануарларының мысығының көшірмесі
Dialogue: 0,0:13:25.92,0:13:28.42,Default,,0,0,0,,Ол өткен аптада жоғалып кетті.
Dialogue: 0,0:13:28.42,0:13:31.33,Default,,0,0,0,,Кейси өте қайғылы болды.
Dialogue: 0,0:13:31.67,0:13:35.06,Default,,0,0,0,,Ымырт, Кейсидің күлкісін қайтару үшін
Dialogue: 0,0:13:35.06,0:13:38.18,Default,,0,0,0,,Мен және Кейси өзімізді жақсы сезіну үшін
Dialogue: 0,0:13:38.18,0:13:40.47,Default,,0,0,0,,Маған осы мысықты ұстауға көмектесіңізші.
Dialogue: 0,0:13:41.90,0:13:42.93,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:13:42.93,0:13:45.56,Default,,0,0,0,,Егер маған көмектеспесеңіз, мен сізге ешқандай ақпарат бермеймін.
Dialogue: 0,0:13:47.77,0:13:51.23,Default,,0,0,0,,Қосымша бонус ретінде сіз жаңадан жасалған тіс щеткасы тәрізді тапанша аласыз.
Dialogue: 0,0:13:51.73,0:13:54.58,Default,,0,0,0,,Қарғыс атқыр, неткен жүрексіз адам.
Dialogue: 0,0:13:54.58,0:13:57.63,Default,,0,0,0,,Жарайды, мен сені өзім ұстаймын.
Dialogue: 0,0:13:58.24,0:14:00.64,Default,,0,0,0,,Ақпарат берушілерді бағаламау
Dialogue: 0,0:14:01.42,0:14:02.85,Default,,0,0,0,,Сәлем Джеффри
Dialogue: 0,0:14:03.40,0:14:05.28,Default,,0,0,0,,А, бұл дұрыс. Бұл жұмысқа сұраныс.
Dialogue: 0,0:14:05.28,0:14:06.64,Default,,0,0,0,,Мысықты іздеп жатыр
Dialogue: 0,0:14:06.95,0:14:08.37,Default,,0,0,0,,Еркек солтүстік көк
Dialogue: 0,0:14:08.37,0:14:09.57,Default,,0,0,0,,Менің мойнымдағы қоңырау
Dialogue: 0,0:14:10.01,0:14:11.57,Default,,0,0,0,,Егер сіз оны тапсаңыз, маған хабарлаңыз.
Dialogue: 0,0:14:11.57,0:14:12.49,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:14:13.22,0:14:15.43,Default,,0,0,0,,Біраз уақыт өтті, Тау Джо
Dialogue: 0,0:14:15.43,0:14:17.73,Default,,0,0,0,,Менің шеберлігіңізге байланысты өтінішім бар.
Dialogue: 0,0:14:17.73,0:14:19.20,Default,,0,0,0,,Сәлеметсіз бе, Теренс?
Dialogue: 0,0:14:20.34,0:14:21.53,Default,,0,0,0,,Бұл төтенше жағдай
Dialogue: 0,0:14:21.53,0:14:22.87,Default,,0,0,0,,Сәлем Нэнси
Dialogue: 0,0:14:22.87,0:14:24.63,Default,,0,0,0,,Сіз мысықтар туралы көп білетінсіз, солай ма?
Dialogue: 0,0:14:24.63,0:14:27.39,Default,,0,0,0,,22-ші округтен келген Харрисон мырза, өтінемін.
Dialogue: 0,0:14:27.39,0:14:29.01,Default,,0,0,0,,Сәлем Джаспер
Dialogue: 0,0:14:29.01,0:14:30.01,Default,,0,0,0,,Йо Бат
Dialogue: 0,0:14:33.73,0:14:37.19,Default,,0,0,0,,Мен осындай нәрсені Сити Холлдың жанындағы Риттер көшесінде көрдім.
Dialogue: 0,0:14:37.19,0:14:38.98,Default,,0,0,0,,Үлкен Джо
Dialogue: 0,0:14:44.34,0:14:46.84,Default,,0,0,0,,Олар осында болуы керек...
Dialogue: 0,0:14:46.84,0:14:48.58,Default,,0,0,0,,О, Фрэнки-сан
Dialogue: 0,0:14:50.39,0:14:51.38,Default,,0,0,0,,Заттарыңызды тексеріңіз
Dialogue: 0,0:14:51.56,0:14:53.86,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:54.76,0:14:57.26,Default,,0,0,0,,Айтпақшы, мен қалалық әкімдікте жұмыс істедім.
Dialogue: 0,0:14:57.26,0:14:59.78,Default,,0,0,0,,Иә, қазір түскі үзіліс уақыты келді.
Dialogue: 0,0:15:00.19,0:15:02.62,Default,,0,0,0,,Фрэнкидің жұмыс орны да осында ма?
Dialogue: 0,0:15:02.62,0:15:04.70,Default,,0,0,0,,Жоқ, шын мәнінде
Dialogue: 0,0:15:06.78,0:15:08.33,Default,,0,0,0,,Жоғалған мысық
Dialogue: 0,0:15:08.33,0:15:09.56,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:15:09.97,0:15:11.64,Default,,0,0,0,,Мен де саған көмектесе аламын.
Dialogue: 0,0:15:12.66,0:15:14.70,Default,,0,0,0,,Жоқ, біз қазір түскі ас ішіп жатырмыз.
Dialogue: 0,0:15:14.70,0:15:17.05,Default,,0,0,0,,Уайымдама, О...Отто
Dialogue: 0,0:15:17.05,0:15:19.90,Default,,0,0,0,,Шуджиннің досы қысылып қалды.
Dialogue: 0,0:15:20.30,0:15:23.78,Default,,0,0,0,,Олар әлі де ерлі-зайыптылардың рөлін шындап ойнап жатыр ма?
Dialogue: 0,0:15:24.09,0:15:27.54,Default,,0,0,0,,Мазасыздық болмаса,
Dialogue: 0,0:15:27.79,0:15:29.72,Default,,0,0,0,,Олай болса, өтінемін.
Dialogue: 0,0:15:29.92,0:15:30.58,Default,,0,0,0,,Иә
Dialogue: 0,0:15:31.75,0:15:33.99,Default,,0,0,0,,Сонда Копи мырза қайсысы?
Dialogue: 0,0:15:33.99,0:15:36.54,Default,,0,0,0,,Оның осында жақын екені белгілі.
Dialogue: 0,0:15:37.03,0:15:42.34,Default,,0,0,0,,C20 мысық тәріздес тыңдау құрылғысы айналадағы әрбір мысық орнына орнатылды.
Dialogue: 0,0:15:42.34,0:15:47.21,Default,,0,0,0,,Оған Копи-чанның мойнындағы қоңыраудың дыбысына жауап беретін сенсор бекітілген.
Dialogue: 0,0:15:48.47,0:15:50.65,Default,,0,0,0,,Бұл таңқаларлық, Фрэнки.
Dialogue: 0,0:15:51.60,0:15:52.54,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:15:55.64,0:15:58.69,Default,,0,0,0,,A, C20 нүктесіне шабуыл жасалуда.
Dialogue: 0,0:15:58.69,0:15:59.65,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:16:01.60,0:16:02.56,Default,,0,0,0,,Жойылған
Dialogue: 0,0:16:03.57,0:16:05.10,Default,,0,0,0,,Басқа да тармақтар
Dialogue: 0,0:16:08.24,0:16:11.16,Default,,0,0,0,,Біз аутсайдер ретінде алынып тасталды ма?
Dialogue: 0,0:16:11.61,0:16:13.27,Default,,0,0,0,,Бұл стратегия сәтсіз.
Dialogue: 0,0:16:13.56,0:16:16.50,Default,,0,0,0,,Мысықтар әлемі де қатал, солай емес пе?
Dialogue: 0,0:16:16.50,0:16:18.48,Default,,0,0,0,,Сосын арғы жақтан келе жатқан сияқты.
Dialogue: 0,0:16:18.48,0:16:19.67,Default,,0,0,0,,Мен оны саған жібергенше
Dialogue: 0,0:16:20.14,0:16:22.96,Default,,0,0,0,,Мысықты тарту құрылғысы MTTB айласы
Dialogue: 0,0:16:26.43,0:16:30.04,Default,,0,0,0,,Ол нысаналарды тарту үшін актинидия хош иісін таратады.
Dialogue: 0,0:16:31.10,0:16:33.68,Default,,0,0,0,,Фрэнки-сан өте шебер.
Dialogue: 0,0:16:33.68,0:16:35.31,Default,,0,0,0,,Сіз қолөнершісіз бе?
Dialogue: 0,0:16:35.73,0:16:38.37,Default,,0,0,0,,Мен өз өнертабыстарыммен әлемді жақсы орынға айналдырамын.
Dialogue: 0,0:16:38.37,0:16:42.71,Default,,0,0,0,,Ол патент арқылы өте бай болуды армандайтын жас жігіт.
Dialogue: 0,0:16:43.23,0:16:44.32,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:16:45.06,0:16:47.29,Default,,0,0,0,,Мен тылдың тұрғынымын деп айта алмаймын...
Dialogue: 0,0:17:03.95,0:17:05.09,Default,,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:17:05.25,0:17:07.10,Default,,0,0,0,,Тым көп адам жиналды
Dialogue: 0,0:17:07.52,0:17:09.24,Default,,0,0,0,,Қайсысы Копи-сан?
Dialogue: 0,0:17:13.89,0:17:15.61,Default,,0,0,0,,Сұр
Dialogue: 0,0:17:15.93,0:17:16.89,Default,,0,0,0,,Бұл қай бала?
Dialogue: 0,0:17:20.24,0:17:22.32,Default,,0,0,0,,Мен сені не болса да ұстаймын
Dialogue: 0,0:17:21.32,0:17:23.73,Default,,0,0,0,,Маған көмектесіңізші
Dialogue: 0,0:17:24.34,0:17:26.32,Default,,0,0,0,,Hyper Long Hard
Dialogue: 0,0:17:26.52,0:17:27.48,Default,,0,0,0,,Жылау
Dialogue: 0,0:17:30.40,0:17:31.85,Default,,0,0,0,,Нүктелік шабуылдар жақсы емес.
Dialogue: 0,0:17:31.85,0:17:33.08,Default,,0,0,0,,Біз бетімізбен шабуыл жасауымыз керек.
Dialogue: 0,0:17:33.54,0:17:34.87,Default,,0,0,0,,Бұл жерге кірме.
Dialogue: 0,0:17:35.06,0:17:37.22,Default,,0,0,0,,Камера түріндегі желі қосқышы
Dialogue: 0,0:17:37.72,0:17:40.40,Default,,0,0,0,,Копи-чан өте сақ болған сияқты.
Dialogue: 0,0:17:40.40,0:17:44.54,Default,,0,0,0,,Мен абай болып, ''Мен жай ғана суретке түсіп жатырмын'' деп айтуым керек.
Dialogue: 0,0:17:44.95,0:17:47.15,Default,,0,0,0,,Дегенмен, ол камера ретінде жасырылғандықтан
Dialogue: 0,0:17:47.15,0:17:49.51,Default,,0,0,0,,Бұл іске қосу құралының ауқымы қысқа.
Dialogue: 0,0:17:49.51,0:17:52.38,Default,,0,0,0,,Түсіруді қамтамасыз ету үшін сіз 2 метрге жетуіңіз керек.
Dialogue: 0,0:18:08.30,0:18:09.50,Default,,0,0,0,,Тұр, е!
Dialogue: 0,0:18:09.98,0:18:11.53,Default,,0,0,0,,Бұл Копи-сан.
Dialogue: 0,0:18:20.02,0:18:22.84,Default,,0,0,0,,Көшір, сен мені ашуландырдың.
Dialogue: 0,0:18:22.84,0:18:25.29,Default,,0,0,0,,Өкінсеңіз де, қазірдің өзінде кеш
Dialogue: 0,0:18:33.09,0:18:36.76,Default,,0,0,0,,Мен жасау үшін 10 жыл жұмсаған соңғы қаруым
Dialogue: 0,0:18:37.01,0:18:39.44,Default,,0,0,0,,Керемет физикалық қабілеттерге ие болыңыз
Dialogue: 0,0:18:39.44,0:18:40.38,Default,,0,0,0,,болуы керек
Dialogue: 0,0:18:40.38,0:18:42.52,Default,,0,0,0,,Қуатты костюм
Dialogue: 0,0:18:42.86,0:18:46.20,Default,,0,0,0,,Қуатты қосқанша және қозғалтқыш қызғанша күтіңіз.
Dialogue: 0,0:18:46.20,0:18:47.94,Default,,0,0,0,,Бұл 15 минутты алады.
Dialogue: 0,0:18:47.94,0:18:49.48,Default,,0,0,0,,Оған дейін тыныш бол.
Dialogue: 0,0:18:53.43,0:18:55.91,Default,,0,0,0,,Идиот, бұл қауіпті жол.
Dialogue: 0,0:18:56.33,0:18:57.74,Default,,0,0,0,,Тоқта, кешіріңіз.
Dialogue: 0,0:18:57.74,0:18:59.22,Default,,0,0,0,,Мен сені енді қумаймын
Dialogue: 0,0:18:59.22,0:19:00.44,Default,,0,0,0,,Фрэнки-сан
Dialogue: 0,0:19:00.72,0:19:02.90,Default,,0,0,0,,Осыны бір сәтке қарызға алуға рұқсат етіңіз.
Dialogue: 0,0:19:28.46,0:19:29.77,Default,,0,0,0,,Құдай-ай! Сол жексұрын!
Dialogue: 0,0:19:30.85,0:19:34.34,Default,,0,0,0,,Мен сені ұстадым, Фрэнки.
Dialogue: 0,0:19:35.60,0:19:36.78,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:37.41,0:19:39.78,Default,,0,0,0,,10 жыл менің 10 жылым
Dialogue: 0,0:19:39.78,0:19:41.57,Default,,0,0,0,,Саған жақсылық, Копи-сан.
Dialogue: 0,0:19:41.57,0:19:43.31,Default,,0,0,0,,Үйге бара аласыз.
Dialogue: 0,0:19:47.76,0:19:49.36,Default,,0,0,0,,Жоқ, бірақ
Dialogue: 0,0:19:49.36,0:19:53.32,Default,,0,0,0,,Егер Кейси сізге жүгінеді деп ойласаңыз, бұл арзан.
Dialogue: 0,0:19:53.60,0:19:56.21,Default,,0,0,0,,Мені күт, жаным
Dialogue: 0,0:19:57.28,0:19:59.55,Default,,0,0,0,,Рақмет сізге Фрэнки
Dialogue: 0,0:20:00.07,0:20:02.96,Default,,0,0,0,,Копи Мен уайымдадым.
Dialogue: 0,0:20:04.43,0:20:06.61,Default,,0,0,0,,Саған жақсылық, Кейси
Dialogue: 0,0:20:07.81,0:20:08.84,Default,,0,0,0,,Муму
Dialogue: 0,0:20:08.84,0:20:12.55,Default,,0,0,0,,Ма-кун алдыңғы есікті ашық қалдырады.
Dialogue: 0,0:20:12.55,0:20:14.04,Default,,0,0,0,,Бұл жаман болды
Dialogue: 0,0:20:14.04,0:20:17.11,Default,,0,0,0,,Келесі жолы мен сізге өзіңіз қалаған жүзікті сатып аламын.
Dialogue: 0,0:20:18.38,0:20:19.97,Default,,0,0,0,,Йо... Йокаттайо Иә
Dialogue: 0,0:20:21.03,0:20:22.78,Default,,0,0,0,,Бұл мен үшін.
Dialogue: 0,0:20:25.03,0:20:26.59,Default,,0,0,0,,(Виолет) Мен теремін. (Роданс) Жарай бер.
Dialogue: 0,0:20:26.59,0:20:28.37,Default,,0,0,0,,Фрэнки-сан
Dialogue: 0,0:20:29.81,0:20:33.19,Default,,0,0,0,,Екеуіңіз, Шиавасе және Курашинаё.
Dialogue: 0,0:20:42.59,0:20:46.29,Default,,0,0,0,,Адам өз жұмысымен өмір сүруге шешім қабылдады.
Dialogue: 0,0:20:50.92,0:20:53.79,Default,,0,0,0,,Ақыр соңында, басқаларға көмектесу жақсы сезінеді.
Dialogue: 0,0:20:54.90,0:20:57.58,Default,,0,0,0,,Сенпай бақытты көрінеді.
Dialogue: 0,0:20:58.24,0:20:59.21,Default,,0,0,0,,Не
Dialogue: 0,0:20:59.21,0:21:01.64,Default,,0,0,0,,Күйеуіңіз сізге бірдеңе сатып алды ма?
Dialogue: 0,0:21:02.10,0:21:03.53,Default,,0,0,0,,Яғни, қарашы ғой — сол Хаято.
Dialogue: 0,0:21:03.82,0:21:06.32,Default,,0,0,0,,Мен оның қанағаттандырарлық көрінгеніне қуаныштымын.
Dialogue: 0,0:21:06.32,0:21:08.04,Default,,0,0,0,,Шынымен тітіркендіргіш
Dialogue: 0,0:21:08.04,0:21:10.92,Default,,0,0,0,,Сіз ақырында қарапайым адам сияқты болдыңыз.
Dialogue: 0,0:21:11.78,0:21:12.92,Default,,0,0,0,,Адам деңгейі
Dialogue: 0,0:21:13.28,0:21:15.00,Default,,0,0,0,,Жеке адам сияқты ма?
Dialogue: 0,0:21:16.42,0:21:17.84,Default,,0,0,0,,Осылайша әлем бейбітшілік кейпін сақтайды
Dialogue: 0,0:21:17.84,0:21:20.23,Default,,0,0,0,,Мен мұны жақсы жасыра алғаныма көңілім толды.
Dialogue: 0,0:21:20.75,0:21:23.44,Default,,0,0,0,,Шарон, тым көп алданба.
Dialogue: 0,0:21:23.82,0:21:26.06,Default,,0,0,0,,Жоқ, мен мұны мысқыл болсын деп айттым.
Dialogue: 0,0:21:28.14,0:21:29.22,Default,,0,0,0,,Брайар-кун
Dialogue: 0,0:21:29.67,0:21:30.98,Default,,0,0,0,,Жүрегім суып тұр
Dialogue: 0,0:21:31.20,0:21:32.83,Default,,0,0,0,,Forger-kun телефоны
Dialogue: 0,0:21:33.10,0:21:35.55,Default,,0,0,0,,Иә, мен жалғанмын
Dialogue: 0,0:21:40.66,0:21:42.88,Default,,0,0,0,,Сіз жауапты тұтынушыдан
Dialogue: 0,0:21:48.44,0:21:51.56,Default,,0,0,0,,Сәлеметсіз бе, мен сіздің телефон нөміріңізді өзгерттім.
Dialogue: 0,0:21:52.85,0:21:54.08,Default,,0,0,0,,Сәлем
Dialogue: 0,0:21:55.04,0:21:58.40,Default,,0,0,0,,Қонақ келді, Ибара ханшайым.
Dialogue: 0,0:21:57.63,0:22:01.01,Default,,0,0,0,,Бұл субтитрді Моечая шығарған. Оны коммерциялық мақсатта пайдалануға болады.
Dialogue: 0,0:22:12.23,0:22:19.02,Default,,0,0,0,,Көру аймағында қою қызыл-қызыл түс пайда болады
Dialogue: 0,0:22:21.90,0:22:29.16,Default,,0,0,0,,Шамамен 40 000 км алға
Dialogue: 0,0:22:32.16,0:22:36.58,Default,,0,0,0,,Артында жақындап келе жатқан өзара жаралар
Dialogue: 0,0:22:36.92,0:22:41.80,Default,,0,0,0,,Адасып кеткен жол мені одан сайын адастырады
Dialogue: 0,0:22:41.80,0:22:46.18,Default,,0,0,0,,Көрінбейтін, иісі сезілмейтін және өзгертілмейтін болашақ
Dialogue: 0,0:22:46.47,0:22:48.39,Default,,0,0,0,,Мен сенің арқаңнан пышақ сұғып алдым!
Dialogue: 0,0:22:49.51,0:22:58.02,Default,,0,0,0,,Бүгін кешке жаныңда болуға рұқсат ет
Dialogue: 0,0:22:59.15,0:23:06.95,Default,,0,0,0,,Мен бүгін кешке байыптымын.
Dialogue: 0,0:23:08.20,0:23:10.66,Default,,0,0,0,,Қосымша ақпарат алу үшін осында келіңіз
Dialogue: 0,0:23:10.66,0:23:13.00,Default,,0,0,0,,Біз дұға еткен болашақ
Dialogue: 0,0:23:13.00,0:23:14.96,Default,,0,0,0,,Жолдар әртүрлі.
Dialogue: 0,0:23:20.17,0:23:22.55,Default,,0,0,0,,Өзара өлтіру ниетімен
Dialogue: 0,0:23:22.55,0:23:25.93,Default,,0,0,0,,Сіз соңғы соққыны аласыз.
Dialogue: 0,0:23:27.34,0:23:30.55,Default,,0,0,0,,Ақыр соңында мен оны тоқтатамын.
Dialogue: 0,0:23:38.02,0:23:41.02,Default,,0,0,0,,Трансшекаралық соғыс
Dialogue: 0,0:23:42.52,0:23:47.52,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
