Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.38,0:00:05.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:08.38,0:00:10.01,Default,,0,0,0,,Балалар сендер де?
Dialogue: 0,0:00:10.09,0:00:11.88,Default,,0,0,0,,Бұл да.
Dialogue: 0,0:00:11.97,0:00:13.13,Default,,0,0,0,,Полициядан
Dialogue: 0,0:00:13.22,0:00:15.97,Default,,0,0,0,,«Әлі де күресе алатындар» туралы өтініш болды.
Dialogue: 0,0:00:16.55,0:00:18.64,Default,,0,0,0,,Айзава-сенсэй... (Изуку) Ха!
Dialogue: 0,0:00:18.72,0:00:21.39,Default,,0,0,0,,Сенің жаныңда Курогири бар деп естідім.
Dialogue: 0,0:00:21.48,0:00:22.73,Default,,0,0,0,,Олай болса баруға болады.
Dialogue: 0,0:00:25.27,0:00:27.94,Default,,0,0,0,,Қараңдаршы, менің достарым әлі ұрысып жатыр...
Dialogue: 0,0:00:28.02,0:00:30.15,Default,,0,0,0,,Бармаймын ба?
Dialogue: 0,0:00:30.74,0:00:33.53,Default,,0,0,0,,Есіңізде болса кез келген жерге бара аласыз.
Dialogue: 0,0:00:33.61,0:00:36.53,Default,,0,0,0,,Біз осы уақытқа дейін жеңіске жеттік.
Dialogue: 0,0:00:37.28,0:00:38.78,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:00:39.58,0:00:41.25,Default,,0,0,0,,Мен бүгін көңіл көтеруім керек
Dialogue: 0,0:00:42.20,0:00:45.75,Default,,0,0,0,,Мен неге батыр болуды армандағанымды түсінбеймін.
Dialogue: 0,0:00:45.83,0:00:47.75,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:00:47.84,0:00:49.46,Default,,0,0,0,,Біз...
Dialogue: 0,0:00:50.42,0:00:51.76,Default,,0,0,0,,Спорт күні керемет өтті, иә?
Dialogue: 0,0:00:53.05,0:00:58.05,Default,,0,0,0,,♪～
Dialogue: 0,0:02:16.22,0:02:21.22,Default,,0,0,0,,～♪
Dialogue: 0,0:02:23.89,0:02:26.81,Default,,0,0,0,,Сұр ет қатарлары
Dialogue: 0,0:02:27.52,0:02:29.65,Default,,0,0,0,,Ұсқынсыз ет...
Dialogue: 0,0:02:30.31,0:02:33.73,Default,,0,0,0,,Бастапқыда мен жерлеуге қатысатын едім.
Dialogue: 0,0:02:33.82,0:02:38.36,Default,,0,0,0,,Жоқтау рухы бұзылса керек.
Dialogue: 0,0:02:38.45,0:02:42.49,Default,,0,0,0,,Бірақ Йоичи сынған дыбысты естігенде
Dialogue: 0,0:02:42.58,0:02:45.37,Default,,0,0,0,,Менің әлемім өшті
Dialogue: 0,0:02:46.91,0:02:49.33,Default,,0,0,0,,Құмарлығыңызды жоғалтыңыз
Dialogue: 0,0:02:49.42,0:02:54.09,Default,,0,0,0,,Демек, жоғалту тесігінен өтетін шабуыл жоқ.
Dialogue: 0,0:02:55.13,0:02:58.55,Default,,0,0,0,,Мен жазадан құтылдым.
Dialogue: 0,0:02:59.26,0:03:03.10,Default,,0,0,0,,Мен Изуку Мидорияны енді түсіндім
Dialogue: 0,0:03:04.14,0:03:07.81,Default,,0,0,0,,Трагедия адамдарды күшті етеді
Dialogue: 0,0:03:08.73,0:03:10.94,Default,,0,0,0,,Сіз солай ойлайсыз ба?
Dialogue: 0,0:03:11.52,0:03:12.69,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:03:13.90,0:03:17.99,Default,,0,0,0,,Қараңызшы, сізде тоқырау мен құлдырауға толы өмір жоқ.
Dialogue: 0,0:03:18.07,0:03:20.74,Default,,0,0,0,,«Сіз артта қалмас үшін ертеңгі практикалық дағды»
Dialogue: 0,0:03:20.82,0:03:24.70,Default,,0,0,0,,Менің көп жұмыс істегенімнің бірден-бір себебі.
Dialogue: 0,0:03:24.78,0:03:26.20,Default,,0,0,0,,Юкине-кун, барсың ба?
Dialogue: 0,0:03:26.29,0:03:28.58,Default,,0,0,0,,Бүгінге дейін қиын болып көрінді.
Dialogue: 0,0:03:28.66,0:03:30.54,Default,,0,0,0,,Ол бұрын Гангимари болған
Dialogue: 0,0:03:32.37,0:03:36.38,Default,,0,0,0,,Мұңайғанша, мұңаймаған жақсы!
Dialogue: 0,0:03:36.46,0:03:37.00,Default,,0,0,0,,Қазір он жылға жуық уақыт болды, иә? Ол анама тіпті кешірім сұрауға да келген жоқ
Dialogue: 0,0:03:37.00,0:03:38.05,Default,,0,0,0,,Қазір он жылға жуық уақыт болды, иә? Ол анама тіпті кешірім сұрауға да келген жоқ
Dialogue: 0,0:03:37.00,0:03:38.05,Default,,0,0,0,,Хэншоу…
Dialogue: 0,0:03:38.05,0:03:38.13,Default,,0,0,0,,Қазір он жылға жуық уақыт болды, иә? Ол анама тіпті кешірім сұрауға да келген жоқ
Dialogue: 0,0:03:38.13,0:03:39.67,Default,,0,0,0,,Қазір он жылға жуық уақыт болды, иә? Ол анама тіпті кешірім сұрауға да келген жоқ
Dialogue: 0,0:03:38.13,0:03:39.67,Default,,0,0,0,,Ыстық жұдырық!
Dialogue: 0,0:03:39.67,0:03:41.01,Default,,0,0,0,,Қазір он жылға жуық уақыт болды, иә? Ол анама тіпті кешірім сұрауға да келген жоқ
Dialogue: 0,0:03:42.97,0:03:44.05,Default,,0,0,0,,Ауыр күйік
Dialogue: 0,0:03:44.14,0:03:46.35,Default,,0,0,0,,Қалпына келтіруші қызға тез өтіңіз!
Dialogue: 0,0:03:46.43,0:03:49.39,Default,,0,0,0,,Зардап шеккендерді емдеуді жалғастыра отырып, тіпті кемпір де өз шегіне жетті.
Dialogue: 0,0:03:49.48,0:03:50.98,Default,,0,0,0,,Оны емдеуге болады ма...
Dialogue: 0,0:03:51.06,0:03:54.10,Default,,0,0,0,,Сен болсаң да, Аналар жай ғана ыстық.
Dialogue: 0,0:03:54.19,0:03:55.94,Default,,0,0,0,,Бару
Dialogue: 0,0:03:56.02,0:03:58.86,Default,,0,0,0,,Әлі де біраз күшіңіз болса
Dialogue: 0,0:04:01.20,0:04:02.49,Default,,0,0,0,,О
Dialogue: 0,0:04:04.49,0:04:06.16,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:04:06.74,0:04:10.70,Default,,0,0,0,,Олар әлі соғысуда.
Dialogue: 0,0:04:12.12,0:04:13.21,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:13.87,0:04:18.34,Default,,0,0,0,,Қайғылы нәрсенің болмағаны жақсы.
Dialogue: 0,0:04:18.42,0:04:23.47,Default,,0,0,0,,Тодороки Дабиді жеңді дегенді естіп, біраз ойландым.
Dialogue: 0,0:04:26.05,0:04:27.47,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:27.55,0:04:30.10,Default,,0,0,0,,Соғысуға қабілеттілер жиналды!
Dialogue: 0,0:04:34.31,0:04:37.02,Default,,0,0,0,,Жігіттер! Бүгін су айдыны!
Dialogue: 0,0:04:37.11,0:04:41.03,Default,,0,0,0,,Кеттік! Бұл соңғы үлкен жұмыс!
Dialogue: 0,0:04:41.11,0:04:43.90,Default,,0,0,0,,Жараланған батыр...
Dialogue: 0,0:04:43.99,0:04:47.70,Default,,0,0,0,,Біз көппіз, біз ештеңе сезбейміз.
Dialogue: 0,0:04:47.78,0:04:50.37,Default,,0,0,0,,Бұл жалғыздық.
Dialogue: 0,0:04:50.45,0:04:54.12,Default,,0,0,0,,Бұл Бүкіл Құдірет-ке жете алмайтын қоқыс.
Dialogue: 0,0:04:55.42,0:04:56.96,Default,,0,0,0,,Қара тесік!
Dialogue: 0,0:04:57.04,0:04:59.59,Default,,0,0,0,,Ах! Ха!
Dialogue: 0,0:05:00.30,0:05:01.55,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:05:02.38,0:05:03.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:03.80,0:05:05.18,Default,,0,0,0,,Тазалау.
Dialogue: 0,0:05:06.05,0:05:07.43,Default,,0,0,0,,(Қаһармандардың айқайлары)
Dialogue: 0,0:05:08.22,0:05:09.18,Default,,0,0,0,,Делекция!
Dialogue: 0,0:05:14.35,0:05:15.48,Default,,0,0,0,,Угаааа…
Dialogue: 0,0:05:15.56,0:05:18.06,Default,,0,0,0,,Бір мінез-құлықпен ондаған адам айналысады...
Dialogue: 0,0:05:18.15,0:05:19.27,Default,,0,0,0,,Ұрысудың қажеті жоқ
Dialogue: 0,0:05:19.36,0:05:21.69,Default,,0,0,0,,Қарғыс атсын... бәрі, кетпеңдер.
Dialogue: 0,0:05:21.78,0:05:23.65,Default,,0,0,0,,Бір кісідей күресейік!
Dialogue: 0,0:05:23.74,0:05:25.32,Default,,0,0,0,,О! (Комори) Иә!
Dialogue: 0,0:05:27.78,0:05:29.53,Default,,0,0,0,,Менің кетуім керек…
Dialogue: 0,0:05:30.12,0:05:31.04,Default,,0,0,0,,Уф... (Айзава) Ах.
Dialogue: 0,0:05:31.12,0:05:33.70,Default,,0,0,0,,Бұл мені тепе-теңдіктен айыруға арналған алдау ма?
Dialogue: 0,0:05:33.79,0:05:36.25,Default,,0,0,0,,Мен бірнеше минутты ғана қайталадым.
Dialogue: 0,0:05:36.33,0:05:38.38,Default,,0,0,0,,Қолымнан айырылғанға дейін.
Dialogue: 0,0:05:38.46,0:05:41.50,Default,,0,0,0,,Шигаракимен жалғасқан шайқастың зияны әлі де сақталды.
Dialogue: 0,0:05:43.88,0:05:47.18,Default,,0,0,0,,Ұрыс қанша уақытқа созылды...
Dialogue: 0,0:05:47.26,0:05:48.97,Default,,0,0,0,,Өзі ешқашан Ал Майтты басып оза алмайтынын түсінген әкем—
Dialogue: 0,0:05:49.05,0:05:51.39,Default,,0,0,0,,Мен «Біреуі барлығына» лақтырдым
Dialogue: 0,0:05:51.47,0:05:53.31,Default,,0,0,0,,Ха! Бар емес пе?
Dialogue: 0,0:05:53.89,0:05:56.56,Default,,0,0,0,,Бірден кейінгі ұрпақтардың «даралығы» бұл...
Dialogue: 0,0:05:56.64,0:06:00.31,Default,,0,0,0,,Бірақ бұл аз уақытқа болды
Dialogue: 0,0:06:00.40,0:06:03.32,Default,,0,0,0,,Менің «еркінсіз» екендігім іштей сіңген.
Dialogue: 0,0:06:04.49,0:06:07.70,Default,,0,0,0,,Бәрі мүмкін сияқты...
Dialogue: 0,0:06:09.03,0:06:10.07,Default,,0,0,0,,Өміріңде —
Dialogue: 0,0:06:12.12,0:06:14.29,Default,,0,0,0,,Шоқтар бар
Dialogue: 0,0:06:15.00,0:06:20.46,Default,,0,0,0,,Шоқ бар болса, үшін бір үшін, ол...
Dialogue: 0,0:06:20.54,0:06:21.63,Default,,0,0,0,,Мидория
Dialogue: 0,0:06:21.71,0:06:23.63,Default,,0,0,0,,Сусындар мен таңғыштар
Dialogue: 0,0:06:23.71,0:06:26.26,Default,,0,0,0,,Сондай-ақ, денеңіздің тоңуына жол бермеңіз.
Dialogue: 0,0:06:27.17,0:06:28.76,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:28.84,0:06:31.39,Default,,0,0,0,,Эвакуациялау орындарындағы адамдардан
Dialogue: 0,0:06:32.39,0:06:34.77,Default,,0,0,0,,Ааа! (№ 13) Уау
Dialogue: 0,0:06:37.35,0:06:41.90,Default,,0,0,0,,Барлық «Ерлерге арналған Nonno» 5-ші футболкалары
Dialogue: 0,0:06:41.98,0:06:42.86,Default,,0,0,0,,(қолды қысу дыбысы)
Dialogue: 0,0:06:42.94,0:06:44.27,Default,,0,0,0,,Ах
Dialogue: 0,0:06:45.61,0:06:47.15,Default,,0,0,0,,Жүгірейік
Dialogue: 0,0:06:47.78,0:06:49.91,Default,,0,0,0,,Бізге сіздің көмегіңіз қажет
Dialogue: 0,0:06:49.99,0:06:52.91,Default,,0,0,0,,Саған да біздің көмегіміз керек.
Dialogue: 0,0:06:52.99,0:06:57.37,Default,,0,0,0,,Қолымды ұста, Аояма-кун.
Dialogue: 0,0:06:57.96,0:07:01.83,Default,,0,0,0,,үшін бірге күреседі.
Dialogue: 0,0:07:02.42,0:07:03.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:06.55,0:07:08.63,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе (босқындар).
Dialogue: 0,0:07:09.30,0:07:10.18,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:07:10.26,0:07:12.85,Default,,0,0,0,,Деку-сан! (Кота) Мидория-нии-чан!
Dialogue: 0,0:07:12.93,0:07:14.47,Default,,0,0,0,,Арнайы қорытпа болат сымнан тоқылған шектеуші қару.➡
Dialogue: 0,0:07:14.56,0:07:15.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:28.57,0:07:30.78,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:07:33.24,0:07:34.62,Default,,0,0,0,,Аояма-кун!
Dialogue: 0,0:07:34.70,0:07:37.91,Default,,0,0,0,,Жүгір, Мидория-кун!
Dialogue: 0,0:07:39.25,0:07:40.62,Default,,0,0,0,,Менің шын атым Джеймс Рэтли
Dialogue: 0,0:07:40.71,0:07:41.54,Default,,0,0,0,,Гррр…
Dialogue: 0,0:07:41.62,0:07:43.83,Default,,0,0,0,,Бякумо Варп Мидория...
Dialogue: 0,0:07:44.50,0:07:46.71,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:52.51,0:07:53.59,Default,,0,0,0,,Уау (Pro Hero) Ах!
Dialogue: 0,0:07:55.89,0:07:58.43,Default,,0,0,0,,Шабуылдар жұмыс істемейді, бұл өте қиын!
Dialogue: 0,0:07:58.52,0:07:59.89,Default,,0,0,0,,үшін бір үшін айырмашылығы
Dialogue: 0,0:07:59.98,0:08:02.19,Default,,0,0,0,,Мен Маборошиге байсалды жауап беремін.
Dialogue: 0,0:08:02.27,0:08:04.19,Default,,0,0,0,,Жол салу
Dialogue: 0,0:08:04.27,0:08:07.07,Default,,0,0,0,,Өлі ағашқа апаратын жол!
Dialogue: 0,0:08:07.15,0:08:09.82,Default,,0,0,0,,Барлық себептер бойынша босату
Dialogue: 0,0:08:09.90,0:08:13.07,Default,,0,0,0,,Оның мәні эмоцияларға қалдырылады
Dialogue: 0,0:08:13.16,0:08:16.37,Default,,0,0,0,,Бұл ісіну туралы емес.
Dialogue: 0,0:08:16.45,0:08:21.62,Default,,0,0,0,,Ол тек көптеген билікті басып, бақылау арқылы.
Dialogue: 0,0:08:21.71,0:08:25.21,Default,,0,0,0,,Саныңыздан асып түсемін деп ойламаңыз.
Dialogue: 0,0:08:26.13,0:08:27.21,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:29.76,0:08:31.76,Default,,0,0,0,,Уф... Хагакуре-сан!
Dialogue: 0,0:08:31.84,0:08:34.97,Default,,0,0,0,,Жарық сәулесіндей болса, мен!
Dialogue: 0,0:08:35.05,0:08:36.55,Default,,0,0,0,,Иә, Юта Отокоцу
Dialogue: 0,0:08:38.22,0:08:39.26,Default,,0,0,0,,Бухаха
Dialogue: 0,0:08:39.35,0:08:41.56,Default,,0,0,0,,Электромагниттік проекциялық зеңбірек!
Dialogue: 0,0:08:41.64,0:08:42.81,Default,,0,0,0,,Иә
Dialogue: 0,0:08:42.89,0:08:43.81,Default,,0,0,0,,Ти!
Dialogue: 0,0:08:48.36,0:08:50.23,Default,,0,0,0,,Күрделі
Dialogue: 0,0:08:56.74,0:08:57.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:58.53,0:09:00.66,Default,,0,0,0,,Енді бәрі емес...
Dialogue: 0,0:09:01.16,0:09:02.75,Default,,0,0,0,,(Серо мен оның достарының айқайы)
Dialogue: 0,0:09:02.83,0:09:05.50,Default,,0,0,0,,Бүкіл денең жарылған. Сақтап алыңыз!
Dialogue: 0,0:09:05.58,0:09:08.46,Default,,0,0,0,,Оған жете алатын жалғыз күш – сенсің.
Dialogue: 0,0:09:08.54,0:09:11.46,Default,,0,0,0,,Біз кек аламыз!
Dialogue: 0,0:09:13.01,0:09:14.22,Default,,0,0,0,,Жүр!
Dialogue: 0,0:09:16.80,0:09:18.22,Default,,0,0,0,,Ана, әпке!
Dialogue: 0,0:09:18.30,0:09:19.81,Default,,0,0,0,,Папа, әпке!
Dialogue: 0,0:09:19.89,0:09:20.72,Default,,0,0,0,,Жаңбырлы маусым!
Dialogue: 0,0:09:20.81,0:09:22.85,Default,,0,0,0,,Сәттілік! Әпке!
Dialogue: 0,0:09:23.81,0:09:24.81,Default,,0,0,0,,Шоджи-кун…
Dialogue: 0,0:09:25.77,0:09:27.81,Default,,0,0,0,,Сәттілік, Шоджи-кун
Dialogue: 0,0:09:27.90,0:09:32.07,Default,,0,0,0,,Біздің ұтқырлығымызбен бұл шабуылдан құтылу қиын болады.
Dialogue: 0,0:09:32.15,0:09:35.07,Default,,0,0,0,,Мен сені аздап көтеріп алсам ғой
Dialogue: 0,0:09:39.45,0:09:40.87,Default,,0,0,0,,Жүр!
Dialogue: 0,0:09:41.49,0:09:43.25,Default,,0,0,0,,Шодзи-кун, Цюю-чан!
Dialogue: 0,0:09:46.37,0:09:48.67,Default,,0,0,0,,Уф! (Киришима) Ішім!
Dialogue: 0,0:09:48.75,0:09:50.17,Default,,0,0,0,,Эй Чан! (Ашидоның достары) Мина!
Dialogue: 0,0:09:50.25,0:09:52.13,Default,,0,0,0,,Уф (Ашидо) Уф...
Dialogue: 0,0:09:52.21,0:09:54.42,Default,,0,0,0,,Сәттілік! (Ашидо) Сәттілік!
Dialogue: 0,0:09:56.05,0:09:56.93,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:57.72,0:09:59.22,Default,,0,0,0,,Құлаққап = Джак, оны маған қосыңыз!
Dialogue: 0,0:09:59.30,0:10:00.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:01.18,0:10:03.68,Default,,0,0,0,,Жібер!
Dialogue: 0,0:10:07.73,0:10:09.73,Default,,0,0,0,,Мидорияға сәттілік!
Dialogue: 0,0:10:09.81,0:10:10.65,Default,,0,0,0,,Аһ!
Dialogue: 0,0:10:13.94,0:10:14.78,Default,,0,0,0,,Хамф!
Dialogue: 0,0:10:15.74,0:10:17.65,Default,,0,0,0,,Ой!
Dialogue: 0,0:10:20.66,0:10:23.29,Default,,0,0,0,,Ха-ха... Уф
Dialogue: 0,0:10:23.95,0:10:25.16,Default,,0,0,0,,Минета-кун
Dialogue: 0,0:10:25.25,0:10:27.75,Default,,0,0,0,,Жүр, Мидория!
Dialogue: 0,0:10:29.46,0:10:30.75,Default,,0,0,0,,Не?
Dialogue: 0,0:10:31.46,0:10:34.21,Default,,0,0,0,,Өліктен басқа ештеңеге ұқсамайтындар...
Dialogue: 0,0:10:34.30,0:10:36.17,Default,,0,0,0,,Неге олар өлмейді?
Dialogue: 0,0:10:36.97,0:10:42.68,Default,,0,0,0,,Қозғалысы өте жақсы болмаса да, көзім... тек көз алмасы...
Dialogue: 0,0:10:42.76,0:10:46.31,Default,,0,0,0,,Тек жерге жатып, көзіңізді айналдырыңыз.
Dialogue: 0,0:10:47.02,0:10:52.23,Default,,0,0,0,,Біте алмаған адамға бергенім қате болды!
Dialogue: 0,0:10:52.31,0:10:55.73,Default,,0,0,0,,Түсіндім, Мидория.
Dialogue: 0,0:10:56.61,0:10:58.86,Default,,0,0,0,,Изуку Мидория
Dialogue: 0,0:11:02.57,0:11:04.20,Default,,0,0,0,,Мидория, сенің әлсіздігің...
Dialogue: 0,0:11:04.20,0:11:05.24,Default,,0,0,0,,Мидория, сенің әлсіздігің...
Dialogue: 0,0:11:04.20,0:11:05.24,Default,,0,0,0,,Ах
Dialogue: 0,0:11:05.24,0:11:06.12,Default,,0,0,0,,Мидория, сенің әлсіздігің...
Dialogue: 0,0:11:06.20,0:11:08.00,Default,,0,0,0,,Сәттілік! Уау
Dialogue: 0,0:11:10.46,0:11:12.54,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:12.63,0:11:13.54,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:11:16.13,0:11:17.05,Default,,0,0,0,,Мидория…
Dialogue: 0,0:11:17.63,0:11:19.05,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:11:19.13,0:11:21.55,Default,,0,0,0,,Бүкіл Құдірет-те бұл болмады.
Dialogue: 0,0:11:22.26,0:11:24.60,Default,,0,0,0,,Әлсіз күш
Dialogue: 0,0:11:26.56,0:11:29.85,Default,,0,0,0,,Бұл балалар қайта-қайта
Dialogue: 0,0:11:30.48,0:11:33.36,Default,,0,0,0,,Мен сені тұрғызып жатырмын.
Dialogue: 0,0:11:33.44,0:11:37.15,Default,,0,0,0,,Егер сіз оны тоқтатпасаңыз
Dialogue: 0,0:11:37.82,0:11:39.19,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:40.15,0:11:42.20,Default,,0,0,0,,Жұлдызды шайқас
Dialogue: 0,0:11:42.28,0:11:45.58,Default,,0,0,0,,Мен қателессем де, оны жеңуге бел байладым.
Dialogue: 0,0:11:45.66,0:11:49.37,Default,,0,0,0,,Сондықтан мен шығаратын орынды кесуім керек еді...
Dialogue: 0,0:11:49.45,0:11:52.79,Default,,0,0,0,,Бұл сенің ісің, Бүкіл Құдірет.
Dialogue: 0,0:11:53.42,0:11:58.26,Default,,0,0,0,,Бұл балалардың көздегені толық жеңіс болды.
Dialogue: 0,0:11:58.34,0:12:01.34,Default,,0,0,0,,Неғұрлым аз жоғалту керек болса, соғұрлым жақсы.
Dialogue: 0,0:12:01.43,0:12:04.47,Default,,0,0,0,,Әй, қай ауыз...
Dialogue: 0,0:12:05.64,0:12:07.56,Default,,0,0,0,,(Декү) Кешір мені (Каири) Ах…
Dialogue: 0,0:12:08.18,0:12:11.02,Default,,0,0,0,,Өйткені сіз сол күні жүгіре бастадыңыз
Dialogue: 0,0:12:11.64,0:12:14.27,Default,,0,0,0,,Менің де денем қозғалды.
Dialogue: 0,0:12:16.19,0:12:18.28,Default,,0,0,0,,Сол күннен бастап
Dialogue: 0,0:12:19.99,0:12:21.78,Default,,0,0,0,,Сен…
Dialogue: 0,0:12:21.86,0:12:23.16,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:12:24.49,0:12:25.70,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:12:25.78,0:12:27.12,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:12:28.45,0:12:31.62,Default,,0,0,0,,Сәттілік батыр
Dialogue: 0,0:12:33.04,0:12:35.96,Default,,0,0,0,,Бірінші күні мектептен үйге қайтқаным есімде.
Dialogue: 0,0:12:36.96,0:12:37.96,Default,,0,0,0,,Қазір
Dialogue: 0,0:12:38.71,0:12:40.51,Default,,0,0,0,,Оның айтқаны
Dialogue: 0,0:12:40.59,0:12:43.51,Default,,0,0,0,,Мен оны өте жақсы түсінетін сияқтымын.
Dialogue: 0,0:12:43.59,0:12:47.64,Default,,0,0,0,,Урарака-сан, сен ауруханаға жақындап қалдың, бар күшіңді сал.
Dialogue: 0,0:12:49.01,0:12:50.14,Default,,0,0,0,,үшін да қолынан келгенін жасап жатыр
Dialogue: 0,0:12:51.73,0:12:55.40,Default,,0,0,0,,Бірақ «Деку» «Қолыңнан келгеннің бәрін жаса!» дегенді білдіреді.
Dialogue: 0,0:12:55.48,0:12:57.77,Default,,0,0,0,,Маған бір нәрсе ұнайды
Dialogue: 0,0:13:00.07,0:13:01.61,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:13:02.24,0:13:03.07,Default,,0,0,0,,(орындықтан тұру дыбысы)
Dialogue: 0,0:13:03.15,0:13:05.66,Default,,0,0,0,,Барлық батырларды қазір Жапонияға жіберіңіз!
Dialogue: 0,0:13:05.74,0:13:06.87,Default,,0,0,0,,Бірақ Президент
Dialogue: 0,0:13:06.95,0:13:08.83,Default,,0,0,0,,Бәрі бір үшін жеңсе, еліміздің қауіпсіздігі...
Dialogue: 0,0:13:08.91,0:13:10.70,Default,,0,0,0,,Сіз білесіз бе? Бар!
Dialogue: 0,0:13:13.41,0:13:16.42,Default,,0,0,0,,Мен барлығының даусын естимін
Dialogue: 0,0:13:16.50,0:13:18.67,Default,,0,0,0,,Сәттілік! (Цукаучи) Сәттілік!
Dialogue: 0,0:13:18.75,0:13:19.92,Default,,0,0,0,,Сәттілік! (Жолбарыс) Сәттілік!
Dialogue: 0,0:13:20.00,0:13:20.84,Default,,0,0,0,,Сәттілік! (Кота) Сәттілік!
Dialogue: 0,0:13:20.92,0:13:21.92,Default,,0,0,0,,Сәттілік! жалғастыра бер!
Dialogue: 0,0:13:22.01,0:13:22.84,Default,,0,0,0,,Сәттілік! (Азамат) Сәттілік!
Dialogue: 0,0:13:22.92,0:13:23.97,Default,,0,0,0,,Сәттілік! (Айзава) Сәттілік!
Dialogue: 0,0:13:28.05,0:13:29.22,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:13:31.47,0:13:32.77,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:13:34.52,0:13:37.73,Default,,0,0,0,,Сол күннен бастап сіз...
Dialogue: 0,0:13:43.74,0:13:47.57,Default,,0,0,0,,Ол менің ең жақсы кейіпкерім болды
Dialogue: 0,0:13:52.58,0:13:53.70,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:13:53.79,0:13:55.50,Default,,0,0,0,,Сонымен қатар, оларды сол беделді делдал таныстырды.
Dialogue: 0,0:13:59.08,0:14:02.80,Default,,0,0,0,,Ууу!
Dialogue: 0,0:14:03.96,0:14:09.30,Default,,0,0,0,,ＳＭＡＳＨ！
Dialogue: 0,0:14:18.40,0:14:21.19,Default,,0,0,0,,Мен неге байқамадым?
Dialogue: 0,0:14:21.73,0:14:27.07,Default,,0,0,0,,«Супер регенерация» бұл арық денеге қолданылмағаны мені біртүрлі сезінеді.
Dialogue: 0,0:14:27.15,0:14:33.33,Default,,0,0,0,,Мынау жігіт... Жоқ, осы жігіттер жоспар құрған.
Dialogue: 0,0:14:34.20,0:14:37.87,Default,,0,0,0,,Өз алдына дұшпандық тым әлсіз.
Dialogue: 0,0:14:37.96,0:14:41.63,Default,,0,0,0,,Бірақ олар жиналып, мен білмей тұрып мені жауып тастады.
Dialogue: 0,0:14:41.71,0:14:44.88,Default,,0,0,0,,Сезімталдығымды түсірдім.
Dialogue: 0,0:14:45.59,0:14:49.55,Default,,0,0,0,,Сол кезде Йоичи және оның мұрагерлері құрылған.
Dialogue: 0,0:14:49.63,0:14:54.14,Default,,0,0,0,,Ақыл ғана емес, дене де...
Dialogue: 0,0:14:54.22,0:14:55.77,Default,,0,0,0,,Шикі денеде
Dialogue: 0,0:14:55.85,0:14:57.02,Default,,0,0,0,,Қабылдау мүмкін емес
Dialogue: 0,0:14:57.10,0:15:00.35,Default,,0,0,0,,♬~
Dialogue: 0,0:15:01.06,0:15:02.61,Default,,0,0,0,,Бар болғаны 2 жыл
Dialogue: 0,0:15:02.69,0:15:05.48,Default,,0,0,0,,8-ші буыннан сәл артық —
Dialogue: 0,0:15:05.57,0:15:11.57,Default,,0,0,0,,Бұл тоғыз адамның күш-қуатының кристалдануы!
Dialogue: 0,0:15:23.13,0:15:25.05,Default,,0,0,0,,«Индивидуалдылық» жойылуда…
Dialogue: 0,0:15:25.71,0:15:27.55,Default,,0,0,0,,Сен мұны істедің бе, Мидория?
Dialogue: 0,0:15:28.09,0:15:30.72,Default,,0,0,0,,Мидория (Фрогбуки) Мидория-чан
Dialogue: 0,0:15:30.80,0:15:31.68,Default,,0,0,0,,Мен жасадым...
Dialogue: 0,0:15:31.76,0:15:32.97,Default,,0,0,0,,Өміріңде —
Dialogue: 0,0:15:34.55,0:15:36.68,Default,,0,0,0,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,0:15:39.81,0:15:41.90,Default,,0,0,0,,Мен оларды өзімнің «индивидуалдылығыммен» күштеп байланыстырдым!
Dialogue: 0,0:15:43.40,0:15:45.44,Default,,0,0,0,,Әлі ештеңе істеген жоқпын
Dialogue: 0,0:15:46.19,0:15:49.82,Default,,0,0,0,,Мен оны ешкімнің алып кетуіне жол бермеймін
Dialogue: 0,0:15:49.90,0:15:52.66,Default,,0,0,0,,Мен ғана армандай аламын
Dialogue: 0,0:15:52.74,0:15:56.62,Default,,0,0,0,,Оны ешкім мұраға ала алмайды.
Dialogue: 0,0:15:56.70,0:15:59.25,Default,,0,0,0,,Жын патшасы әрқашан жалғыз!
Dialogue: 0,0:16:01.29,0:16:03.83,Default,,0,0,0,,Бұл шындық болса да, оны қайталаңыз.
Dialogue: 0,0:16:05.09,0:16:08.05,Default,,0,0,0,,Мен ақымақ жерлеу рәсімінде жасағандай.
Dialogue: 0,0:16:08.13,0:16:13.13,Default,,0,0,0,,Енді «Біреуі бәрі үшін» жоқ Бұл жігіт немесе ешкім
Dialogue: 0,0:16:13.68,0:16:17.81,Default,,0,0,0,,Мен өзімді бере аламын және оны алып кете аламын.
Dialogue: 0,0:16:17.89,0:16:19.22,Default,,0,0,0,,Ыдыс!
Dialogue: 0,0:16:19.31,0:16:22.44,Default,,0,0,0,,Тоқта, бәрі бір үшін!
Dialogue: 0,0:16:22.52,0:16:23.65,Default,,0,0,0,,Мидория!
Dialogue: 0,0:16:23.73,0:16:24.56,Default,,0,0,0,,Ах
Dialogue: 0,0:16:24.65,0:16:25.94,Default,,0,0,0,,Ақ бұлт!?
Dialogue: 0,0:16:29.48,0:16:31.36,Default,,0,0,0,,Өшіру… Қалың…
Dialogue: 0,0:16:32.20,0:16:33.82,Default,,0,0,0,,Тау… Өріс…
Dialogue: 0,0:16:36.37,0:16:38.74,Default,,0,0,0,,енді біркелкі таралып жатқандай сезіледі
Dialogue: 0,0:16:41.33,0:16:43.50,Default,,0,0,0,,«Киллер Куиннің» ерекше қабілеті: ол тиген заттың бәрі—
Dialogue: 0,0:16:44.17,0:16:47.84,Default,,0,0,0,,Өлген ағашты жоқтаймын.
Dialogue: 0,0:16:48.92,0:16:51.09,Default,,0,0,0,,сақталуы керек
Dialogue: 0,0:16:51.67,0:16:55.30,Default,,0,0,0,,А, қарғыс атсын! Күткендей...
Dialogue: 0,0:16:55.39,0:16:57.93,Default,,0,0,0,,Кез келген адам, кез келген жерде...
Dialogue: 0,0:16:58.01,0:17:02.43,Default,,0,0,0,,Не болса да қолын созады.
Dialogue: 0,0:17:03.52,0:17:08.65,Default,,0,0,0,,Көңіл айтуыңызды өтінемін... орнына...
Dialogue: 0,0:17:09.48,0:17:11.15,Default,,0,0,0,,Мориё қаласы дейсіз бе? Хмм…
Dialogue: 0,0:17:12.19,0:17:14.03,Default,,0,0,0,,Менің досым...
Dialogue: 0,0:17:14.61,0:17:16.78,Default,,0,0,0,,Мен күтемін!
Dialogue: 0,0:17:25.71,0:17:27.00,Default,,0,0,0,,Бакугу!?
Dialogue: 0,0:17:27.08,0:17:29.63,Default,,0,0,0,,Ауруханаға бару... Бұл өтірік емес пе?
Dialogue: 0,0:17:29.71,0:17:31.71,Default,,0,0,0,,Ол «жарылыстан» жалғыз келген.
Dialogue: 0,0:17:31.80,0:17:32.63,Default,,0,0,0,,Я...
Dialogue: 0,0:17:33.34,0:17:37.43,Default,,0,0,0,,Мен Тодорокидің секіру үстелін алдым.
Dialogue: 0,0:17:37.51,0:17:42.35,Default,,0,0,0,,Маған сенен өтуге жол берме, Изуку!
Dialogue: 0,0:17:42.43,0:17:46.81,Default,,0,0,0,,үшін бір үшін Мен сені кешірмеймін
Dialogue: 0,0:17:46.90,0:17:51.32,Default,,0,0,0,,Бірақ мен сізді түсініксіз құбыжық деп ойламаймын.
Dialogue: 0,0:17:51.40,0:17:53.94,Default,,0,0,0,,Факторлар синхрондалғандықтан айта аласыз.
Dialogue: 0,0:17:54.82,0:17:56.07,Default,,0,0,0,,Қойыңызшы. Мен тек қана сондағы миы жоқ жігітті ұстап әкетуге келдім.
Dialogue: 0,0:17:56.91,0:17:58.07,Default,,0,0,0,,Тоқта
Dialogue: 0,0:17:58.62,0:18:00.58,Default,,0,0,0,,Сен мен үшін маңыздысың
Dialogue: 0,0:18:01.28,0:18:02.54,Default,,0,0,0,,Жолтайым Құдай
Dialogue: 0,0:18:03.24,0:18:06.00,Default,,0,0,0,,Сіз жын патшасы емессіз!
Dialogue: 0,0:18:07.21,0:18:10.67,Default,,0,0,0,,Бұл менікі. Маған қара!
Dialogue: 0,0:18:14.34,0:18:20.18,Default,,0,0,0,,Сіз жалғыз адамсыз!
Dialogue: 0,0:18:38.20,0:18:40.07,Default,,0,0,0,,Йоичи?
Dialogue: 0,0:18:40.16,0:18:41.57,Default,,0,0,0,,Мидория-кун
Dialogue: 0,0:18:41.66,0:18:44.66,Default,,0,0,0,,Кесектер қалуы үшін ең шетінде
Dialogue: 0,0:18:44.74,0:18:47.46,Default,,0,0,0,,Сіз соқтығыстың күшін реттедіңіз, солай ма?
Dialogue: 0,0:18:48.29,0:18:52.21,Default,,0,0,0,,Ал мен оны шоқтың реакциясымен ояттым.
Dialogue: 0,0:18:52.29,0:18:55.13,Default,,0,0,0,,Жалаң қалдыққа айналған мен
Dialogue: 0,0:18:55.76,0:18:59.97,Default,,0,0,0,,«Біреуі барлығына» дұрыс толтыру
Dialogue: 0,0:19:00.05,0:19:02.68,Default,,0,0,0,,Маған бәрібір, бәрібір!
Dialogue: 0,0:19:02.76,0:19:04.85,Default,,0,0,0,,Жоғалма, бетіңді көрсет
Dialogue: 0,0:19:05.43,0:19:07.35,Default,,0,0,0,,Бұл мүмкін емес. Ол жоғалады.
Dialogue: 0,0:19:07.43,0:19:09.31,Default,,0,0,0,,Жоқ, бұл менікі.
Dialogue: 0,0:19:09.39,0:19:12.11,Default,,0,0,0,,Маған қара, көзіңді көрсет!
Dialogue: 0,0:19:12.69,0:19:16.23,Default,,0,0,0,,Бауырым, мен сені жетектей алмадым.
Dialogue: 0,0:19:16.32,0:19:21.11,Default,,0,0,0,,Бұл Мидориияның біз үшін тапқан соңғы құтқарылуы.
Dialogue: 0,0:19:21.20,0:19:23.24,Default,,0,0,0,,Жоқ! Рұқсат етілмейді!
Dialogue: 0,0:19:23.32,0:19:25.74,Default,,0,0,0,,Мен сені сүйемін, мен сені сүйемін.
Dialogue: 0,0:19:25.83,0:19:28.33,Default,,0,0,0,,Мен сенсіз жақсы емеспін!
Dialogue: 0,0:19:28.41,0:19:30.00,Default,,0,0,0,,Дәл солай... (үшін біреу үшін) Ха!
Dialogue: 0,0:19:30.08,0:19:34.54,Default,,0,0,0,,үшінн өзіңіз үшін пайдаланғаны үшін төлейтін уақыт келді.
Dialogue: 0,0:19:35.38,0:19:39.55,Default,,0,0,0,,Ол оянған жалғыз мен емес едім.
Dialogue: 0,0:19:43.68,0:19:50.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:06.08,0:20:10.08,Default,,0,0,0,,Мен оны мұғалім жеп қойды деп ойлап, жоғалып кетті.
Dialogue: 0,0:20:11.41,0:20:13.12,Default,,0,0,0,,Менің жоғалып кетуіме жол берме
Dialogue: 0,0:20:13.21,0:20:15.17,Default,,0,0,0,,Сіз байланғансыз ба?
Dialogue: 0,0:20:17.21,0:20:18.59,Default,,0,0,0,,Әже
Dialogue: 0,0:20:21.09,0:20:22.47,Default,,0,0,0,,Курогири...
Dialogue: 0,0:20:24.43,0:20:27.39,Default,,0,0,0,,Мұғалімнен денені қайтарып алу арқылы.
Dialogue: 0,0:20:27.47,0:20:29.89,Default,,0,0,0,,Ештеңені бұзу мүмкін емес
Dialogue: 0,0:20:31.18,0:20:35.40,Default,,0,0,0,,Ақырында мен сен айтқандай болдым.
Dialogue: 0,0:20:36.73,0:20:39.48,Default,,0,0,0,,Сіз ол жылап тұрған бала болды дейсіз бе?
Dialogue: 0,0:20:41.11,0:20:43.70,Default,,0,0,0,,Мен бұл қолды сындыра алмадым
Dialogue: 0,0:20:46.12,0:20:48.99,Default,,0,0,0,,Мен істегенімді кешіре алмаймын
Dialogue: 0,0:20:49.08,0:20:50.83,Default,,0,0,0,,Сол үшін де ұрыстық
Dialogue: 0,0:20:51.96,0:20:56.17,Default,,0,0,0,,Тоқтағанын қаладым, тоқтағанын қаладым.
Dialogue: 0,0:20:56.92,0:20:59.42,Default,,0,0,0,,Мұңның айналуына жол берме
Dialogue: 0,0:21:00.09,0:21:01.05,Default,,0,0,0,,Ha
Dialogue: 0,0:21:02.38,0:21:04.05,Default,,0,0,0,,Изуку Мидория
Dialogue: 0,0:21:04.88,0:21:08.22,Default,,0,0,0,,Егер Спиннер тірі болса, маған хабарлаңыз.
Dialogue: 0,0:21:09.76,0:21:11.77,Default,,0,0,0,,Өлім ағашының жерлеу рәсімі
Dialogue: 0,0:21:12.48,0:21:16.10,Default,,0,0,0,,Оны жою үшін соңына дейін күресті
Dialogue: 0,0:21:17.48,0:21:20.82,Default,,0,0,0,,Мен қазірдің өзінде... бұздым.
Dialogue: 0,0:21:51.01,0:21:56.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:15.01,0:23:20.02,Default,,0,0,0,,～♪
Dialogue: 0,0:23:22.06,0:23:22.90,Default,,0,0,0,,Мен бұны реттеймін
Dialogue: 0,0:23:24.69,0:23:26.94,Default,,0,0,0,,«Біреуі бәрі үшін» ұзақ шайқасында
Dialogue: 0,0:23:27.03,0:23:28.65,Default,,0,0,0,,Ақырзаман келді
Dialogue: 0,0:23:29.36,0:23:31.28,Default,,0,0,0,,Бірақ бұл соңы емес.
Dialogue: 0,0:23:31.36,0:23:36.45,Default,,0,0,0,,Жоғалғанды ​​қалпына келтіру; қайта құру және қайта туылу басталады
Dialogue: 0,0:23:36.54,0:23:39.37,Default,,0,0,0,,Бұл Тодорокидің отбасына да қатысты...
Dialogue: 0,0:23:40.62,0:23:45.00,Default,,0,0,0,,Келесі жолы «Эпилог/Тодороки-кунның тозақтағы үйі/ФИНАЛ»
Dialogue: 0,0:23:45.09,0:23:46.92,Default,,0,0,0,,Отбасылық байланыстар тексеріледі
Dialogue: 0,0:23:47.80,0:23:50.93,Default,,0,0,0,,Әрі қарай!Plus Ultra!
Dialogue: 0,0:23:52.43,0:23:58.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
