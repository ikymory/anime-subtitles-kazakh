Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.84,0:00:10.38,Default,,0,0,0,,♪ Иә, мен бақыттымын.
Dialogue: 0,0:00:10.46,0:00:14.39,Default,,0,0,0,,♪ Өмір сүрудің қуанышы
Dialogue: 0,0:00:14.47,0:00:18.01,Default,,0,0,0,,♪ Кеудемдегі жара болса да
Dialogue: 0,0:00:18.10,0:00:21.77,Default,,0,0,0,,♪ Itadanemo
Dialogue: 0,0:00:21.85,0:00:23.69,Default,,0,0,0,,Хехехе
Dialogue: 0,0:00:21.85,0:00:23.69,Default,,0,0,0,,♪ Неліктен дүниеге келдің?
Dialogue: 0,0:00:23.69,0:00:25.02,Default,,0,0,0,,♪ Неліктен дүниеге келдің?
Dialogue: 0,0:00:25.02,0:00:25.69,Default,,0,0,0,,♪ Неліктен дүниеге келдің?
Dialogue: 0,0:00:25.02,0:00:25.69,Default,,0,0,0,,Хехехе ахаха
Dialogue: 0,0:00:25.69,0:00:25.77,Default,,0,0,0,,Хехехе ахаха
Dialogue: 0,0:00:25.77,0:00:27.52,Default,,0,0,0,,Хехехе ахаха
Dialogue: 0,0:00:25.77,0:00:27.52,Default,,0,0,0,,♪ Сіз не істейсіз?
Dialogue: 0,0:00:27.52,0:00:28.98,Default,,0,0,0,,♪ Сіз не істейсіз?
Dialogue: 0,0:00:29.07,0:00:34.03,Default,,0,0,0,,Артқа қарасам, бәрі басып алған жолда екен.
Dialogue: 0,0:00:29.07,0:00:34.03,Default,,0,0,0,,(Ән айтатын екі дауыс)
Dialogue: 0,0:00:34.03,0:00:34.53,Default,,0,0,0,,(Ән айтатын екі дауыс)
Dialogue: 0,0:00:36.66,0:00:38.49,Default,,0,0,0,,Оны бастау деп атау
Dialogue: 0,0:00:38.58,0:00:41.41,Default,,0,0,0,,Тым жұмсақ жад
Dialogue: 0,0:00:50.63,0:00:53.59,Default,,0,0,0,,Менің істегенім болды
Dialogue: 0,0:00:55.34,0:00:59.39,Default,,0,0,0,,Мен кездейсоқ сол жолға қарап қалдым.
Dialogue: 0,0:01:06.73,0:01:11.90,Default,,0,0,0,,Бұл өте маңызды нәрсе сияқты көрінді.
Dialogue: 0,0:01:14.07,0:01:15.40,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:01:16.99,0:01:21.99,Default,,0,0,0,,♪～
Dialogue: 0,0:02:40.16,0:02:45.16,Default,,0,0,0,,～♪
Dialogue: 0,0:02:53.54,0:02:55.38,Default,,0,0,0,,Геркулес…
Dialogue: 0,0:02:55.46,0:02:57.05,Default,,0,0,0,,Мен дәл осы жерде болжам жасаймын.
Dialogue: 0,0:02:57.13,0:02:57.97,Default,,0,0,0,,Гррр…
Dialogue: 0,0:02:59.68,0:03:02.76,Default,,0,0,0,,Құралдар өз шегінен асып кетуі керек
Dialogue: 0,0:03:02.85,0:03:05.06,Default,,0,0,0,,Ол жарық шығара ма?
Dialogue: 0,0:03:05.14,0:03:06.72,Default,,0,0,0,,Джари!
Dialogue: 0,0:03:06.81,0:03:10.31,Default,,0,0,0,,Күлімсіреуді ұмыттың, ең жақын досым.
Dialogue: 0,0:03:10.39,0:03:11.65,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:13.52,0:03:14.48,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,0:03:15.23,0:03:16.82,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:03:19.49,0:03:21.57,Default,,0,0,0,,Ку… Каха…
Dialogue: 0,0:03:21.66,0:03:24.91,Default,,0,0,0,,Бүкіл Құдірет шіркін
Dialogue: 0,0:03:25.49,0:03:29.54,Default,,0,0,0,,Күлкіңнен айырыл, үмітіңді үз
Dialogue: 0,0:03:30.50,0:03:33.25,Default,,0,0,0,,Жермен жорғалау
Dialogue: 0,0:03:34.92,0:03:38.42,Default,,0,0,0,,Үмітсіздік пен азаптан бұрмаланған сен
Dialogue: 0,0:03:39.55,0:03:42.18,Default,,0,0,0,,Мен тәртіпсіздік жасаймын
Dialogue: 0,0:03:42.26,0:03:45.93,Default,,0,0,0,,Бір кездері сен маған жасағандай!
Dialogue: 0,0:03:48.64,0:03:51.44,Default,,0,0,0,,Менің денем... қозғалмайды!?
Dialogue: 0,0:03:51.52,0:03:53.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:53.10,0:03:54.44,Default,,0,0,0,,Қан – бұл...
Dialogue: 0,0:03:55.31,0:03:57.52,Default,,0,0,0,,бірдей қызыл
Dialogue: 0,0:04:00.44,0:04:01.86,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:04:01.95,0:04:02.91,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:06.53,0:04:11.50,Default,,0,0,0,,үшін мүмкін!
Dialogue: 0,0:04:14.67,0:04:15.46,Default,,0,0,0,,Ах
Dialogue: 0,0:04:15.46,0:04:15.92,Default,,0,0,0,,Ах
Dialogue: 0,0:04:15.46,0:04:15.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:15.92,0:04:16.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:16.38,0:04:17.21,Default,,0,0,0,,Қосылды!
Dialogue: 0,0:04:18.50,0:04:21.22,Default,,0,0,0,,Екеуің де амансыңдар.
Dialogue: 0,0:04:21.30,0:04:22.38,Default,,0,0,0,,Ол Майт па?
Dialogue: 0,0:04:22.47,0:04:26.05,Default,,0,0,0,,Менің уақытым таусылып жатыр, сондықтан қысқаша жазамын.
Dialogue: 0,0:04:26.60,0:04:29.26,Default,,0,0,0,,Балалар, дәл қазір көпшілікке жүгіріңдер.
Dialogue: 0,0:04:29.77,0:04:34.02,Default,,0,0,0,,Енді, егер біз жаппай дағдарысты басқаруға мүмкіндік бар болса,
Dialogue: 0,0:04:34.10,0:04:37.44,Default,,0,0,0,,«Қозғалтқыш» және «жартылай салқындатылған, жартылай жану» Тек сендер балалар.
Dialogue: 0,0:04:37.52,0:04:38.69,Default,,0,0,0,,Мен сұрадым...
Dialogue: 0,0:04:37.52,0:04:38.69,Default,,0,0,0,,Суасты кемесі ме?
Dialogue: 0,0:04:43.78,0:04:45.95,Default,,0,0,0,,Кім... үшін...
Dialogue: 0,0:04:48.37,0:04:52.87,Default,,0,0,0,,Өртенген адам мен Ингениум арасындағы әңгімеден мән-жайды тұжырымдаңыз.
Dialogue: 0,0:04:54.29,0:04:57.67,Default,,0,0,0,,үшін бір үшін өткен деп айтылатын ұрыс алаңын қадағалаңыз.
Dialogue: 0,0:04:58.25,0:05:02.17,Default,,0,0,0,,Онда біз жаңбыр мен желден аман қалған қан дақтарын жинадық.
Dialogue: 0,0:05:02.26,0:05:05.05,Default,,0,0,0,,Бұл қан «үшін бір үшін» тобына тиесілі ме?
Dialogue: 0,0:05:05.13,0:05:07.26,Default,,0,0,0,,Бұл бәрі мүмкін бе...
Dialogue: 0,0:05:09.26,0:05:10.35,Default,,0,0,0,,Батырдың аты: Ол Майт
Dialogue: 0,0:05:11.02,0:05:12.52,Default,,0,0,0,,Қысқарту
Dialogue: 0,0:05:12.60,0:05:16.35,Default,,0,0,0,,Қанды жел, иіске, мына мұрын саған хабар береді.
Dialogue: 0,0:05:17.40,0:05:19.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:19.23,0:05:20.65,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:21.23,0:05:22.53,Default,,0,0,0,,Бұл да басқа
Dialogue: 0,0:05:23.36,0:05:24.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:25.45,0:05:27.20,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:27.87,0:05:28.32,Default,,0,0,0,,(лазерлік ату дыбысы)
Dialogue: 0,0:05:28.32,0:05:29.70,Default,,0,0,0,,(лазерлік ату дыбысы)
Dialogue: 0,0:05:28.32,0:05:29.70,Default,,0,0,0,,Га
Dialogue: 0,0:05:33.95,0:05:36.00,Default,,0,0,0,,Ол ауыр қылмыс жасамаған, бірақ—
Dialogue: 0,0:05:37.12,0:05:40.38,Default,,0,0,0,,Қаншалықты күшті болсаң да
Dialogue: 0,0:05:40.46,0:05:43.26,Default,,0,0,0,,Сол қанды жалап алсаңыз, «қанның ұюы» белсендіріледі.
Dialogue: 0,0:05:43.88,0:05:46.01,Default,,0,0,0,,Сіздің қозғалыстарыңыз тоқтайды.
Dialogue: 0,0:05:48.55,0:05:52.51,Default,,0,0,0,,үшін мүмкін... О, барлық мүмкін
Dialogue: 0,0:05:53.22,0:05:55.31,Default,,0,0,0,,Сіз түсінесіз.
Dialogue: 0,0:05:55.39,0:06:00.02,Default,,0,0,0,,Бұл денені әшкерелеуге неге батылым бардым дегеннің мәні!
Dialogue: 0,0:06:00.94,0:06:06.07,Default,,0,0,0,,Батырдың жүрегі басқалар үшін ғана өмір сүреді.
Dialogue: 0,0:06:06.15,0:06:08.91,Default,,0,0,0,,Бірақ Құдай жерге тағзым етті
Dialogue: 0,0:06:08.99,0:06:12.24,Default,,0,0,0,,Егер сіз де біреудің әлсіз жүрегін жаулап алсаңыз...
Dialogue: 0,0:06:12.33,0:06:17.00,Default,,0,0,0,,Сізге тіпті өз өміріңізбен күресуге рұқсат беріледі.
Dialogue: 0,0:06:17.75,0:06:19.25,Default,,0,0,0,,Хмф!
Dialogue: 0,0:06:19.33,0:06:21.84,Default,,0,0,0,,Және, әрине
Dialogue: 0,0:06:21.92,0:06:28.01,Default,,0,0,0,,Келіңіз де, 40 батырды өлтірген осы Стейнді аяқтаңыз.
Dialogue: 0,0:06:29.13,0:06:31.89,Default,,0,0,0,,Мен білемін, Стейн.
Dialogue: 0,0:06:33.51,0:06:35.64,Default,,0,0,0,,Сіз өмір сүруіңіз керек
Dialogue: 0,0:06:36.68,0:06:38.98,Default,,0,0,0,,Мен осындамын!
Dialogue: 0,0:06:44.11,0:06:46.90,Default,,0,0,0,,«Мәжбүрлеп қосу» «Қан алу»!
Dialogue: 0,0:06:47.74,0:06:48.90,Default,,0,0,0,,Барлық денеде...
Dialogue: 0,0:06:48.99,0:06:50.91,Default,,0,0,0,,Қаныңды тастадың!?
Dialogue: 0,0:06:50.99,0:06:53.87,Default,,0,0,0,,Қанның қызыл-қара дақтары
Dialogue: 0,0:06:53.95,0:06:57.50,Default,,0,0,0,,Мен сіз жасайтын нәрсені болжаған болар едім.
Dialogue: 0,0:06:58.29,0:07:01.00,Default,,0,0,0,,Сондықтан мен оны алдын ала дайындадым.
Dialogue: 0,0:07:01.63,0:07:03.54,Default,,0,0,0,,Тартарлық бір ғана адам
Dialogue: 0,0:07:03.63,0:07:08.34,Default,,0,0,0,,Менен бас тартып, қашып кеткен күннен бастап
Dialogue: 0,0:07:08.42,0:07:10.34,Default,,0,0,0,,Лақтырсаң да, қан бұрынғысынша...
Dialogue: 0,0:07:11.30,0:07:13.05,Default,,0,0,0,,Бірінші адамның атын жазғаныңыздан бері қанша секунд өтті?
Dialogue: 0,0:07:13.93,0:07:15.93,Default,,0,0,0,,«Антигендік метаморфоз»
Dialogue: 0,0:07:16.01,0:07:18.48,Default,,0,0,0,,Мен қанды қайта жаздым.
Dialogue: 0,0:07:18.56,0:07:23.48,Default,,0,0,0,,Ешбір із қалдырмау - ұзақ билік етудің құпиясы.
Dialogue: 0,0:07:24.82,0:07:25.98,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,0:07:26.07,0:07:28.65,Default,,0,0,0,,Алынған қанның арқасында
Dialogue: 0,0:07:28.74,0:07:30.53,Default,,0,0,0,,Мен ояумын
Dialogue: 0,0:07:30.61,0:07:31.78,Default,,0,0,0,,Дақ!
Dialogue: 0,0:07:32.41,0:07:33.24,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:07:33.87,0:07:35.08,Default,,0,0,0,,Уау
Dialogue: 0,0:07:40.54,0:07:41.67,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:42.71,0:07:43.54,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:43.63,0:07:45.04,Default,,0,0,0,,Дақ!
Dialogue: 0,0:07:50.38,0:07:55.55,Default,,0,0,0,,«Даралығыңызды» және «қан ұйығышын» алыңыз
Dialogue: 0,0:07:55.64,0:07:56.93,Default,,0,0,0,,Сол жақ қолыңдағы ырғақ артта қалып жатыр
Dialogue: 0,0:07:56.93,0:07:59.35,Default,,0,0,0,,Сол жақ қолыңдағы ырғақ артта қалып жатыр
Dialogue: 0,0:07:56.93,0:07:59.35,Default,,0,0,0,,Ойланып қарасаң, Одақтың мүшесісің...
Dialogue: 0,0:07:59.35,0:07:59.43,Default,,0,0,0,,Сол жақ қолыңдағы ырғақ артта қалып жатыр
Dialogue: 0,0:07:59.43,0:08:02.19,Default,,0,0,0,,Сол жақ қолыңдағы ырғақ артта қалып жатыр
Dialogue: 0,0:07:59.43,0:08:02.19,Default,,0,0,0,,Өз кезегінде ол жерлеу қызметінің өсуіне үлкен үлес қосты.
Dialogue: 0,0:08:02.19,0:08:03.81,Default,,0,0,0,,Жерлеу қызметінің өсуіне де үлкен үлес қосты.
Dialogue: 0,0:08:03.90,0:08:07.15,Default,,0,0,0,,Ах... Кешір, мен телефон шалуға сыртқа шығып келемін.
Dialogue: 0,0:08:10.07,0:08:15.32,Default,,0,0,0,,Сіздің жұмысыңыз бітті, қанішер.
Dialogue: 0,0:08:15.41,0:08:17.53,Default,,0,0,0,,Бұл бітпейді...
Dialogue: 0,0:08:17.62,0:08:23.04,Default,,0,0,0,,Ха... Бәрі процесс, Жын патшасы...
Dialogue: 0,0:08:23.12,0:08:25.04,Default,,0,0,0,,Бәрі бір адам үшін!
Dialogue: 0,0:08:26.54,0:08:29.71,Default,,0,0,0,,Тіпті жоғары білімі жоқ
Dialogue: 0,0:08:29.80,0:08:35.97,Default,,0,0,0,,Сіз маған батырдың не екенін үйреттіңіз.
Dialogue: 0,0:08:36.05,0:08:39.60,Default,,0,0,0,,Өмір сүр және жең
Dialogue: 0,0:08:40.10,0:08:41.73,Default,,0,0,0,,Менің барлығым…
Dialogue: 0,0:08:50.98,0:08:51.82,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:54.91,0:08:56.57,Default,,0,0,0,,Геркулес!?
Dialogue: 0,0:08:56.66,0:08:58.95,Default,,0,0,0,,Бұзылуы керек еді...
Dialogue: 0,0:08:59.03,0:09:01.33,Default,,0,0,0,,Бұл соңғы қалқан
Dialogue: 0,0:09:02.58,0:09:04.08,Default,,0,0,0,,Осылайша тәжірибеңіз артады және көпшіліктің назарын аударасыз
Dialogue: 0,0:09:05.17,0:09:06.46,Default,,0,0,0,,Тікелей эфир
Dialogue: 0,0:09:17.47,0:09:18.80,Default,,0,0,0,,Бұл оқиға туралы бізге мүлде ешқандай ақпарат түскен жоқ
Dialogue: 0,0:09:21.39,0:09:23.35,Default,,0,0,0,,Тошинориге сәттілік
Dialogue: 0,0:09:24.48,0:09:27.02,Default,,0,0,0,,А... а...
Dialogue: 0,0:09:27.10,0:09:29.56,Default,,0,0,0,,Әлі айналдыруда
Dialogue: 0,0:09:29.65,0:09:31.28,Default,,0,0,0,,Тошинориге сәттілік
Dialogue: 0,0:09:33.15,0:09:35.28,Default,,0,0,0,,Мастер...
Dialogue: 0,0:09:36.03,0:09:38.12,Default,,0,0,0,,Бұл галлюцинация
Dialogue: 0,0:09:38.62,0:09:44.00,Default,,0,0,0,,Маған жігер беру үшін қожайынның бейнесін алып отырмын.
Dialogue: 0,0:09:47.29,0:09:49.13,Default,,0,0,0,,Қалай болғанда да, мұнда алғаш рет кездесіп отырған адамдарың көп сияқты, сондықтан—
Dialogue: 0,0:09:50.59,0:09:55.34,Default,,0,0,0,,Тірек элементтері мен аяқтары енді жарамсыз.
Dialogue: 0,0:09:55.92,0:09:58.51,Default,,0,0,0,,Мен енді төбелесе алмаймын
Dialogue: 0,0:10:04.39,0:10:05.43,Default,,0,0,0,,Құт
Dialogue: 0,0:10:05.52,0:10:07.10,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:10:08.02,0:10:10.27,Default,,0,0,0,,Сондықтан оны өміріңізге айырбастамаңыз
Dialogue: 0,0:10:11.19,0:10:14.86,Default,,0,0,0,,Өтінемін, дұрыс өмір сүр, мені қорғап, тәрбиеле.
Dialogue: 0,0:10:14.94,0:10:17.28,Default,,0,0,0,,Иә, Люмиллион
Dialogue: 0,0:10:18.28,0:10:22.08,Default,,0,0,0,,(Каиридің қиналып дем алуы)
Dialogue: 0,0:10:22.16,0:10:24.04,Default,,0,0,0,,Бәрі мүмкін!
Dialogue: 0,0:10:29.29,0:10:33.46,Default,,0,0,0,,Әлі емес... әлі өлген жоқ
Dialogue: 0,0:10:37.76,0:10:39.76,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:10:46.60,0:10:48.39,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:02.45,0:11:05.99,Default,,0,0,0,,Екі рет... жоғалады.
Dialogue: 0,0:11:06.08,0:11:07.83,Default,,0,0,0,,Салмақ азайту
Dialogue: 0,0:11:07.91,0:11:10.71,Default,,0,0,0,,Бұл табыттың аспанда қалқып тұруын қамтамасыз етеді!
Dialogue: 0,0:11:10.79,0:11:12.33,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:11:12.33,0:11:15.50,Default,,0,0,0,,(Endeavour) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:11:12.33,0:11:15.50,Default,,0,0,0,,үшін бір үшін, Шигараги кенеттен жерлеуге жақындады!
Dialogue: 0,0:11:15.59,0:11:17.26,Default,,0,0,0,,Балшық иілу шегінде
Dialogue: 0,0:11:17.34,0:11:18.30,Default,,0,0,0,,Бұл бар!
Dialogue: 0,0:11:21.05,0:11:24.76,Default,,0,0,0,,Юэйден түскен соң Мидория жүре берді.
Dialogue: 0,0:11:24.85,0:11:27.06,Default,,0,0,0,,Осындай жақын қашықтықта
Dialogue: 0,0:11:27.14,0:11:30.39,Default,,0,0,0,,Мен әйтеуір қураған ағаштың шабуылынан құтылдым.
Dialogue: 0,0:11:30.48,0:11:33.98,Default,,0,0,0,,Әйтеуір тығырыққа тіреледі.
Dialogue: 0,0:11:34.06,0:11:34.90,Default,,0,0,0,,Бірақ
Dialogue: 0,0:11:35.52,0:11:37.78,Default,,0,0,0,,үшін біреудің балшық үшін
Dialogue: 0,0:11:37.86,0:11:40.53,Default,,0,0,0,,Егер сіз осы ауқымға кірсеңіз
Dialogue: 0,0:11:40.61,0:11:43.57,Default,,0,0,0,,Өлі ағаш «Бәрі бір үшін» астында...
Dialogue: 0,0:11:44.20,0:11:48.70,Default,,0,0,0,,Сақталған тепе-теңдік бұзылады.
Dialogue: 0,0:11:50.46,0:11:53.58,Default,,0,0,0,,«Артқа айналдыру» инъекциясы кезінде
Dialogue: 0,0:11:53.67,0:11:56.04,Default,,0,0,0,,Бұл мақсат болды
Dialogue: 0,0:11:56.88,0:12:01.38,Default,,0,0,0,,Менің қайталанатын «даралығымды» Қайғыға көшіру арқылы.
Dialogue: 0,0:12:01.47,0:12:05.30,Default,,0,0,0,,Менен асатын қызметшіге айналады.
Dialogue: 0,0:12:09.93,0:12:13.98,Default,,0,0,0,,Мен оған жақындағанша...
Dialogue: 0,0:12:14.69,0:12:18.65,Default,,0,0,0,,Келіңіздер, үшін бір үшін, мен осындамын!
Dialogue: 0,0:12:19.73,0:12:22.32,Default,,0,0,0,,Изуку Мидория мазаламай
Dialogue: 0,0:12:22.40,0:12:25.37,Default,,0,0,0,,Біркелкі тасымалдауды қамтамасыз ету
Dialogue: 0,0:12:27.70,0:12:29.83,Default,,0,0,0,,Келіңіздер, жоқтаңыздар
Dialogue: 0,0:12:29.91,0:12:32.21,Default,,0,0,0,,Басқа қызметші
Dialogue: 0,0:12:32.96,0:12:34.00,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:35.38,0:12:36.88,Default,,0,0,0,,5-үй, «Малкольм» үй меңгерушісі
Dialogue: 0,0:12:36.96,0:12:38.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:39.55,0:12:40.38,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:12:40.46,0:12:42.38,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:12:42.47,0:12:43.84,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:43.93,0:12:45.01,Default,,0,0,0,,оны міндетті түрде өлтіргісі келер еді.
Dialogue: 0,0:12:45.09,0:12:48.68,Default,,0,0,0,,Менің санам онсыз да жоқтауға батты ма?
Dialogue: 0,0:12:49.47,0:12:50.31,Default,,0,0,0,,Иә
Dialogue: 0,0:12:50.39,0:12:52.31,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:12:52.39,0:12:55.94,Default,,0,0,0,,Ондай жағдайда мен сонда баруым керек.
Dialogue: 0,0:13:15.25,0:13:17.63,Default,,0,0,0,,Жетті. Мен сені де, әпкеңді де өлтіремін.
Dialogue: 0,0:13:17.71,0:13:19.13,Default,,0,0,0,,Не болды? ...
Dialogue: 0,0:13:20.05,0:13:23.01,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:13:23.92,0:13:24.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:26.51,0:13:27.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:28.51,0:13:31.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:31.93,0:13:34.81,Default,,0,0,0,,Сол аянышты жүзбен
Dialogue: 0,0:13:34.89,0:13:41.32,Default,,0,0,0,,Жас жігітке пайдасыз арман, Барша құдірет көрсету жауапкершілігін алайық.
Dialogue: 0,0:13:45.32,0:13:48.03,Default,,0,0,0,,үшін мүмкін, мен сізге көмектесуім керек.
Dialogue: 0,0:13:48.11,0:13:50.08,Default,,0,0,0,,Изуку Мидория
Dialogue: 0,0:13:50.91,0:13:52.29,Default,,0,0,0,,Қарғыс атсын... (Изуку) Уф!
Dialogue: 0,0:13:53.20,0:13:56.29,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:13:57.25,0:14:01.80,Default,,0,0,0,,Осы уақытта жоғарыда мені бұрын ренжіткен жігіттер...
Dialogue: 0,0:14:01.88,0:14:04.76,Default,,0,0,0,,Мен бәрін құртамын!
Dialogue: 0,0:14:04.84,0:14:07.51,Default,,0,0,0,,Гррр…
Dialogue: 0,0:14:10.10,0:14:11.60,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:13.81,0:14:15.31,Default,,0,0,0,,Ах
Dialogue: 0,0:14:15.39,0:14:18.06,Default,,0,0,0,,Ха... а... а...
Dialogue: 0,0:14:19.23,0:14:20.81,Default,,0,0,0,,Бұл қолдармен тағдыр т.б
Dialogue: 0,0:14:20.90,0:14:23.32,Default,,0,0,0,,Мен оны сізге ұнайтын кез келген пішінде бұрап беремін.
Dialogue: 0,0:14:24.07,0:14:27.24,Default,,0,0,0,,Мен, саған не болса да
Dialogue: 0,0:14:27.32,0:14:29.03,Default,,0,0,0,,Мен миллион адамды — тек «үшінн» ғана емес — құтқара алатын адам бола аламын деп…
Dialogue: 0,0:14:32.58,0:14:34.49,Default,,0,0,0,,Куу! Қарғыс атқыр...
Dialogue: 0,0:14:35.83,0:14:38.96,Default,,0,0,0,,Бір кезде басып қалдым деп ойлаған көз жасым
Dialogue: 0,0:14:39.04,0:14:42.21,Default,,0,0,0,,Қайта толып кету қаупіне қарсы тұрыңыз
Dialogue: 0,0:14:44.46,0:14:47.01,Default,,0,0,0,,Бұл жылауық баланы түзету керек.
Dialogue: 0,0:14:48.47,0:14:50.97,Default,,0,0,0,,Себебі мен жақсы шәкірт болғым келеді
Dialogue: 0,0:14:53.56,0:14:56.73,Default,,0,0,0,,«Біреуі бәрі үшін» бет-бейнесі
Dialogue: 0,0:14:57.85,0:15:02.90,Default,,0,0,0,,Онымен бірінші болып қоштастым.
Dialogue: 0,0:15:03.73,0:15:04.69,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:05.98,0:15:11.41,Default,,0,0,0,,О... Бәрі мүмкін!
Dialogue: 0,0:15:17.16,0:15:20.87,Default,,0,0,0,,Ерекшелігі жоқ батыр бола аласың ба?
Dialogue: 0,0:15:21.88,0:15:23.50,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:15:24.17,0:15:29.34,Default,,0,0,0,,Өйткені сіз көп жұмыс жасай аласыз.
Dialogue: 0,0:15:29.92,0:15:33.72,Default,,0,0,0,,Мен армандарымды не үшін тастап кете алмадым
Dialogue: 0,0:15:35.64,0:15:39.89,Default,,0,0,0,,Мен де лақтыра алмаймын.
Dialogue: 0,0:15:40.48,0:15:44.15,Default,,0,0,0,,Менің арманым...
Dialogue: 0,0:15:45.65,0:15:50.36,Default,,0,0,0,,Бейбітшілік символы ретінде...
Dialogue: 0,0:15:50.45,0:15:51.91,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:57.24,0:15:59.25,Default,,0,0,0,,Кейін
Dialogue: 0,0:15:59.33,0:16:01.58,Default,,0,0,0,,Сорахико
Dialogue: 0,0:16:01.67,0:16:04.79,Default,,0,0,0,,Сол арманыңызды орындаңыз.
Dialogue: 0,0:16:04.88,0:16:06.21,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:16:06.29,0:16:08.17,Default,,0,0,0,,Мастер~!
Dialogue: 0,0:16:09.71,0:16:11.88,Default,,0,0,0,,Нана Шимураның соңғы сәттері
Dialogue: 0,0:16:13.26,0:16:15.68,Default,,0,0,0,,Неліктен қазір есімде?
Dialogue: 0,0:16:17.47,0:16:23.65,Default,,0,0,0,,Ол өзінің қабілеті жоқ, мұраты өзінен бұрын болған әйел еді.
Dialogue: 0,0:16:23.73,0:16:27.32,Default,,0,0,0,,Бұл нағыз сұмдық өлім еді.
Dialogue: 0,0:16:29.36,0:16:31.15,Default,,0,0,0,,Ол ауыр қылмыс жасамаған, бірақ—
Dialogue: 0,0:16:31.86,0:16:35.78,Default,,0,0,0,,Сіз Бүкіл Құдірет-тен ұтасыз
Dialogue: 0,0:16:35.87,0:16:37.53,Default,,0,0,0,,Не істеп жатырсың, Ани? Қазір тоқтама.
Dialogue: 0,0:16:38.99,0:16:40.16,Default,,0,0,0,,Өйткені
Dialogue: 0,0:16:41.08,0:16:45.79,Default,,0,0,0,,Тошинори сенен де ақылсыз.
Dialogue: 0,0:16:46.71,0:16:48.55,Default,,0,0,0,,Көп өлсең
Dialogue: 0,0:16:48.63,0:16:52.55,Default,,0,0,0,,Ол кем дегенде балабақша тәрбиеленушісінен кем болмай ма?
Dialogue: 0,0:16:52.63,0:16:55.55,Default,,0,0,0,,Бұл жігіт, соның ішінде мен...
Dialogue: 0,0:16:57.68,0:17:00.56,Default,,0,0,0,,Менің істегенім болды
Dialogue: 0,0:17:01.39,0:17:05.56,Default,,0,0,0,,Мен жаңа ғана сол жолға қарап қалдым.
Dialogue: 0,0:17:05.65,0:17:11.32,Default,,0,0,0,,Бұл өте маңызды нәрсе сияқты көрінді.
Dialogue: 0,0:17:12.19,0:17:13.07,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:17:14.90,0:17:16.32,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:17.91,0:17:22.08,Default,,0,0,0,,Батыр ретінде өлуді таңдай аламын деп ойладың ба?
Dialogue: 0,0:17:22.16,0:17:25.83,Default,,0,0,0,,Мен оны ақыры шығардым.
Dialogue: 0,0:17:28.25,0:17:29.13,Default,,0,0,0,,Аһ!
Dialogue: 0,0:17:29.21,0:17:31.13,Default,,0,0,0,,«Қанның ұюы»
Dialogue: 0,0:17:31.21,0:17:33.13,Default,,0,0,0,,А... а...
Dialogue: 0,0:17:33.21,0:17:35.34,Default,,0,0,0,,Жараланған батыр қаншалықты қорқынышты?
Dialogue: 0,0:17:35.43,0:17:37.80,Default,,0,0,0,,Мен көп нәрсені білдім
Dialogue: 0,0:17:37.89,0:17:41.39,Default,,0,0,0,,Мен сені ештеңеге қол жеткізбеймін.
Dialogue: 0,0:17:43.60,0:17:46.52,Default,,0,0,0,,Мен сол жүзді күттім
Dialogue: 0,0:17:47.31,0:17:51.86,Default,,0,0,0,,Сіз оны ең жек көретін кезде
Dialogue: 0,0:17:56.36,0:17:57.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:58.32,0:18:00.37,Default,,0,0,0,,Ой... жұмсақ!
Dialogue: 0,0:18:00.45,0:18:03.24,Default,,0,0,0,,Ах, Юэй тұрақты.
Dialogue: 0,0:18:03.33,0:18:04.16,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:18:04.25,0:18:06.04,Default,,0,0,0,,Кеттік! Ах
Dialogue: 0,0:18:10.84,0:18:13.25,Default,,0,0,0,,Уау аа аа (Эйхаку) Суретке түсуді тоқтатпа!
Dialogue: 0,0:18:18.64,0:18:21.76,Default,,0,0,0,,Уау! Гррр!
Dialogue: 0,0:18:21.85,0:18:26.14,Default,,0,0,0,,Юэй сізді сорып алды деп мақсатыңыздан айырылдыңыз ба?
Dialogue: 0,0:18:26.23,0:18:27.73,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:18:27.81,0:18:32.57,Default,,0,0,0,,Данжуро Тобита ізгілігіңізбен ұстамды болыңыз
Dialogue: 0,0:18:32.65,0:18:33.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:33.57,0:18:35.61,Default,,0,0,0,,Лазерлік бір мезгілде сәулелену дайын!
Dialogue: 0,0:18:35.69,0:18:37.36,Default,,0,0,0,,Hits Бүкіл Құдірет
Dialogue: 0,0:18:37.45,0:18:39.36,Default,,0,0,0,,Ол жұлдызды армандаушы.
Dialogue: 0,0:18:41.41,0:18:42.24,Default,,0,0,0,,Иә
Dialogue: 0,0:18:42.33,0:18:44.91,Default,,0,0,0,,Жерлеу рәсімін Жұлдызбен бұрады —
Dialogue: 0,0:18:45.50,0:18:48.21,Default,,0,0,0,,Ｘ-６６
Dialogue: 0,0:18:51.33,0:18:53.21,Default,,0,0,0,,ОТ!
Dialogue: 0,0:18:57.88,0:19:00.76,Default,,0,0,0,,Жұлдыз жоқ.
Dialogue: 0,0:19:03.72,0:19:06.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:06.98,0:19:09.81,Default,,0,0,0,,Уф! (Изуку) Уф...
Dialogue: 0,0:19:09.89,0:19:12.77,Default,,0,0,0,,Ку... у... ой
Dialogue: 0,0:19:15.86,0:19:17.86,Default,,0,0,0,,О, бұл қорқынышты (әйел) Иә?
Dialogue: 0,0:19:17.94,0:19:18.78,Default,,0,0,0,,Уау
Dialogue: 0,0:19:18.86,0:19:20.45,Default,,0,0,0,,Бұл енді жақсы емес.
Dialogue: 0,0:19:20.53,0:19:23.32,Default,,0,0,0,,Бүкіл Құдірет өледі... өледі
Dialogue: 0,0:19:23.41,0:19:26.29,Default,,0,0,0,,Бұл жақсы емес...
Dialogue: 0,0:19:26.37,0:19:27.58,Default,,0,0,0,,Сіз соққыға түсесіз бе?
Dialogue: 0,0:19:27.66,0:19:29.79,Default,,0,0,0,,үшін мүмкін...
Dialogue: 0,0:19:29.87,0:19:31.71,Default,,0,0,0,,Біздің кейіпкер...
Dialogue: 0,0:19:32.29,0:19:35.46,Default,,0,0,0,,Мені Құдірет құтқарды.
Dialogue: 0,0:19:43.14,0:19:45.35,Default,,0,0,0,,Ағам мүмкін...
Dialogue: 0,0:19:48.93,0:19:50.94,Default,,0,0,0,,Тошинори…
Dialogue: 0,0:19:51.73,0:19:53.19,Default,,0,0,0,,Иә, соңы
Dialogue: 0,0:19:55.02,0:20:01.28,Default,,0,0,0,,Ол қандай формада болса да, оның өлімі бетбұрыс болады.
Dialogue: 0,0:20:03.99,0:20:06.41,Default,,0,0,0,,Уф… Уф…
Dialogue: 0,0:20:08.33,0:20:10.16,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:20:10.91,0:20:13.08,Default,,0,0,0,,Ей, сен, сөйлей алмайтындай етіп тағы да жауып тастайын ба?
Dialogue: 0,0:20:21.34,0:20:23.76,Default,,0,0,0,,Куу… Куу…
Dialogue: 0,0:20:25.01,0:20:26.47,Default,,0,0,0,,Ол соншалықты керемет пианист болса да—
Dialogue: 0,0:20:29.27,0:20:30.60,Default,,0,0,0,,Ол...
Dialogue: 0,0:20:53.00,0:20:55.17,Default,,0,0,0,,А... а...
Dialogue: 0,0:21:03.88,0:21:08.89,Default,,0,0,0,,(Изуку мен Бакугудың толқыған дауыстары)
Dialogue: 0,0:21:17.06,0:21:18.61,Default,,0,0,0,,Хэхе (Изуку) Хэхехе
Dialogue: 0,0:21:18.69,0:21:22.69,Default,,0,0,0,,(Бакуго мен Изукудың күлкісі)
Dialogue: 0,0:21:51.06,0:21:56.06,Default,,0,0,0,,♪～
Dialogue: 0,0:23:15.06,0:23:20.06,Default,,0,0,0,,～♪
Dialogue: 0,0:23:21.65,0:23:22.94,Default,,0,0,0,,Мен бұны реттеймін
Dialogue: 0,0:23:23.56,0:23:25.61,Default,,0,0,0,,«Біреуі бәрі үшін» ұрлау
Dialogue: 0,0:23:25.69,0:23:27.90,Default,,0,0,0,,мінсіз болуы тиіс барлығына арналған жоспар
Dialogue: 0,0:23:27.99,0:23:29.99,Default,,0,0,0,,Бұрмалау орын алады
Dialogue: 0,0:23:30.07,0:23:31.78,Default,,0,0,0,,Тісті доңғалақтар есінен танып жатыр
Dialogue: 0,0:23:32.62,0:23:36.58,Default,,0,0,0,,Батырлар жасаған ой, тілек арқылы
Dialogue: 0,0:23:36.66,0:23:38.66,Default,,0,0,0,,Келесі жолы «Соңғы бастық!!»
Dialogue: 0,0:23:39.66,0:23:43.84,Default,,0,0,0,,Какчан шарасыз жағдайда тұрған Бүкіл Құдірет-ті құтқару үшін орнынан тұрды.
Dialogue: 0,0:23:44.59,0:23:46.96,Default,,0,0,0,,Қайта тірілу осы жерден басталады
Dialogue: 0,0:23:47.63,0:23:50.97,Default,,0,0,0,,Әрі қарай!Plus Ultra!
Dialogue: 0,0:23:52.47,0:23:58.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
