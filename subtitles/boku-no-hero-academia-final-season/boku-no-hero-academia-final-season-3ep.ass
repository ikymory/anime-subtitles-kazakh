Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.30,0:00:13.51,Default,,0,0,0,,Ағам мүмкін...
Dialogue: 0,0:00:16.89,0:00:18.64,Default,,0,0,0,,Тошинори…
Dialogue: 0,0:00:18.72,0:00:24.27,Default,,0,0,0,,Ол қандай формада болса да, оның өлімі бетбұрыс болады.
Dialogue: 0,0:00:26.48,0:00:28.90,Default,,0,0,0,,Уф… Уф…
Dialogue: 0,0:00:30.78,0:00:32.65,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:00:33.40,0:00:35.66,Default,,0,0,0,,Ей, сен, сөйлей алмайтындай етіп тағы да жауып тастайын ба?
Dialogue: 0,0:00:37.28,0:00:38.74,Default,,0,0,0,,Ол соншалықты керемет пианист болса да—
Dialogue: 0,0:00:40.45,0:00:41.83,Default,,0,0,0,,Ол...
Dialogue: 0,0:01:06.98,0:01:11.98,Default,,0,0,0,,♪～
Dialogue: 0,0:02:30.15,0:02:35.15,Default,,0,0,0,,～♪
Dialogue: 0,0:02:48.04,0:02:50.25,Default,,0,0,0,,Ха... ха ха
Dialogue: 0,0:02:52.04,0:02:54.67,Default,,0,0,0,,Хмм... Гуха!
Dialogue: 0,0:02:54.75,0:02:55.80,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе...
Dialogue: 0,0:02:55.88,0:02:57.72,Default,,0,0,0,,Сіз жаумен бетпе-бет келдіңіз (зұлым)
Dialogue: 0,0:02:57.80,0:03:01.76,Default,,0,0,0,,Барлығы емес, бірақ миллион…
Dialogue: 0,0:03:02.30,0:03:04.43,Default,,0,0,0,,Гах... Гах!
Dialogue: 0,0:03:05.39,0:03:06.02,Default,,0,0,0,,Жел...
Dialogue: 0,0:03:06.02,0:03:06.81,Default,,0,0,0,,Жел...
Dialogue: 0,0:03:06.02,0:03:06.81,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:03:06.81,0:03:08.27,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:03:08.27,0:03:10.02,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:03:08.27,0:03:10.02,Default,,0,0,0,,Жел соғып тұрды
Dialogue: 0,0:03:10.02,0:03:10.81,Default,,0,0,0,,Жел соғып тұрды
Dialogue: 0,0:03:10.90,0:03:13.23,Default,,0,0,0,,(қой малау)
Dialogue: 0,0:03:13.31,0:03:15.32,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:03:15.40,0:03:18.36,Default,,0,0,0,,Ауа-райы жақсы.
Dialogue: 0,0:03:18.44,0:03:20.65,Default,,0,0,0,,Бүгін бәліш жасаймыз ба?
Dialogue: 0,0:03:20.74,0:03:22.24,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,0:03:28.20,0:03:29.62,Default,,0,0,0,,Асығыңыз, асығыңыз!
Dialogue: 0,0:03:29.71,0:03:33.79,Default,,0,0,0,,Алыс дағдарыстан бүгінгі мерзім бұлыңғыр!
Dialogue: 0,0:03:34.96,0:03:38.63,Default,,0,0,0,,Ауа ағыны алып кумулонимб бұлттарының әсерінен біртүрлі.
Dialogue: 0,0:03:38.71,0:03:40.55,Default,,0,0,0,,Эй Мерил, о
Dialogue: 0,0:03:40.63,0:03:43.51,Default,,0,0,0,,Бұрынғы трансляция апаты жүктеп салынған.
Dialogue: 0,0:03:44.47,0:03:47.85,Default,,0,0,0,,Жапонияда кенеттен үлкен кумулонимбус бұлты пайда болды.
Dialogue: 0,0:03:47.93,0:03:50.64,Default,,0,0,0,,Әлі де қарқынды дамып келеді
Dialogue: 0,0:03:50.73,0:03:52.90,Default,,0,0,0,,Бұдан былай реактивті ағынмен жүру
Dialogue: 0,0:03:52.98,0:03:55.61,Default,,0,0,0,,Солтүстік Америкаға да әсер етуі мүмкін
Dialogue: 0,0:03:56.36,0:03:58.11,Default,,0,0,0,,Дәл сол себепті тірі аңызға айналған Ал Майт,
Dialogue: 0,0:03:58.19,0:04:01.03,Default,,0,0,0,,Мартин, кешкі ас жақында болады.
Dialogue: 0,0:04:01.11,0:04:02.24,Default,,0,0,0,,Иә
Dialogue: 0,0:04:04.41,0:04:06.03,Default,,0,0,0,,Барлығы мүмкін...
Dialogue: 0,0:04:07.20,0:04:09.04,Default,,0,0,0,,Менің өлгім келмейді.
Dialogue: 0,0:04:10.25,0:04:11.50,Default,,0,0,0,,Метеорология бюросының мәліметі бойынша
Dialogue: 0,0:04:11.58,0:04:16.00,Default,,0,0,0,,Жергілікті температураның көтерілуінен болатын бір уақыттағы конвекция
Dialogue: 0,0:04:16.09,0:04:19.13,Default,,0,0,0,,Оңтүстік-батыстан тропиктік циклондардың қосылуына байланысты
Dialogue: 0,0:04:19.80,0:04:22.01,Default,,0,0,0,,Ең үлкен масштаб
Dialogue: 0,0:04:22.09,0:04:24.47,Default,,0,0,0,,Өртті кумулонимб бұлты пайда болды деп есептеледі.
Dialogue: 0,0:04:24.47,0:04:25.76,Default,,0,0,0,,Өртті кумулонимбус бұлты пайда болды деген болжам бар.
Dialogue: 0,0:04:24.47,0:04:25.76,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:04:25.76,0:04:28.31,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:04:28.39,0:04:31.06,Default,,0,0,0,,Я...
Dialogue: 0,0:04:33.64,0:04:37.69,Default,,0,0,0,,Әлемді бір адам өзгерте алады
Dialogue: 0,0:04:58.29,0:04:59.46,Default,,0,0,0,,…бізге теңдей берілген.
Dialogue: 0,0:05:00.21,0:05:04.84,Default,,0,0,0,,Егер сіз «ауысым» әрекетін қайта іске қоссаңыз, бұл жолы кері қайтарудан құтыла алмайсыз.
Dialogue: 0,0:05:04.93,0:05:08.01,Default,,0,0,0,,Біз жеңу жолын табуымыз керек...
Dialogue: 0,0:05:13.60,0:05:14.89,Default,,0,0,0,,2nd
Dialogue: 0,0:05:26.41,0:05:29.28,Default,,0,0,0,,Сіз уақытында үлгермейтініңізді білесіз бе?
Dialogue: 0,0:05:29.91,0:05:33.29,Default,,0,0,0,,Сіздің ішіңіздегі Бүкіл Құдірет екіұшты көрініске ие болды.
Dialogue: 0,0:05:33.37,0:05:37.17,Default,,0,0,0,,Тірі болғандықтан емес пе?
Dialogue: 0,0:05:37.25,0:05:40.29,Default,,0,0,0,,Ол енді қалыптаса бастады.
Dialogue: 0,0:05:40.38,0:05:43.96,Default,,0,0,0,,Мұның мағынасы осы емес пе?
Dialogue: 0,0:05:44.05,0:05:48.05,Default,,0,0,0,,Дүниеге арман көрсеткен адамның өлімімен
Dialogue: 0,0:05:48.14,0:05:51.35,Default,,0,0,0,,Армандар шындыққа оралады
Dialogue: 0,0:06:00.61,0:06:02.02,Default,,0,0,0,,Біреудің...
Dialogue: 0,0:06:04.11,0:06:06.61,Default,,0,0,0,,Біреудің жұдырық түйгені
Dialogue: 0,0:06:06.70,0:06:09.11,Default,,0,0,0,,Біреудің тынысы
Dialogue: 0,0:06:10.62,0:06:14.29,Default,,0,0,0,,Мен сені өлтірген болашақты өзгерткім келеді.
Dialogue: 0,0:06:14.37,0:06:17.79,Default,,0,0,0,,Кайри-чан, жараландың ба…?
Dialogue: 0,0:06:17.87,0:06:20.08,Default,,0,0,0,,<Эрен басынан бері мүлде өзгерген жоқ. ➡
Dialogue: 0,0:06:20.17,0:06:22.92,Default,,0,0,0,,Уг… Ух… Гух…
Dialogue: 0,0:06:23.55,0:06:28.22,Default,,0,0,0,,(Изуку) Кайри-чанның квиркі күшейіп келеді
Dialogue: 0,0:06:28.30,0:06:33.85,Default,,0,0,0,,(Басшы) Біреу бізді «зұлымдар» деп атаған соң ұрысқа түстіңдер ме?
Dialogue: 0,0:06:33.93,0:06:37.94,Default,,0,0,0,,Якуза қарапайым адамдарға қол көтермеуі керек.
Dialogue: 0,0:06:38.02,0:06:40.98,Default,,0,0,0,,Дегенмен, бұл дұрыс емес…
Dialogue: 0,0:06:41.06,0:06:44.94,Default,,0,0,0,,Сен тек өз намысыңды ақтауға тырыстың…
Dialogue: 0,0:06:45.03,0:06:49.45,Default,,0,0,0,,Барлығы қатты сенді және айналдырды...
Dialogue: 0,0:06:50.66,0:06:52.20,Default,,0,0,0,,Біреудің...
Dialogue: 0,0:06:54.45,0:06:57.50,Default,,0,0,0,,Біреудің дұғасы
Dialogue: 0,0:07:05.46,0:07:08.13,Default,,0,0,0,,Қарғыс атқыр кішкентай шабақтар күш алып жатыр
Dialogue: 0,0:07:08.22,0:07:12.39,Default,,0,0,0,,Барша құдірет оны мойындаса да, күшейе түсті!
Dialogue: 0,0:07:12.47,0:07:15.89,Default,,0,0,0,,Бірақ неге! Мен неге...
Dialogue: 0,0:07:15.97,0:07:17.77,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:17.85,0:07:22.06,Default,,0,0,0,,Мен Бүкіл Құдірет-ті аяқтадым ба!?
Dialogue: 0,0:07:33.57,0:07:38.25,Default,,0,0,0,,Бір-бірімізді танып, шынайы жетілдіре алсақ
Dialogue: 0,0:07:38.33,0:07:43.79,Default,,0,0,0,,Көмектесіңіз және жеңіңіз Жеңіңіз және көмектесіңіз және ең жақсы кейіпкер болыңыз
Dialogue: 0,0:07:43.88,0:07:47.80,Default,,0,0,0,,B… Бакугу бала
Dialogue: 0,0:07:47.88,0:07:50.17,Default,,0,0,0,,Өзің де қатты шаршаған сияқтысың.
Dialogue: 0,0:07:56.85,0:07:59.93,Default,,0,0,0,,Бұл жерде емес пе еді?
Dialogue: 0,0:08:01.27,0:08:02.94,Default,,0,0,0,,Өзімді энергияға толы сезінемін…
Dialogue: 0,0:08:03.81,0:08:08.32,Default,,0,0,0,,Жоқ, бұл жерде болды, Бүкіл Құдірет.
Dialogue: 0,0:08:09.07,0:08:11.82,Default,,0,0,0,,Бұл арманның соңы болды
Dialogue: 0,0:08:11.90,0:08:15.16,Default,,0,0,0,,Тағдыр бұрмаланды.
Dialogue: 0,0:08:15.24,0:08:16.70,Default,,0,0,0,,Арманың бар екені рас
Dialogue: 0,0:08:16.78,0:08:19.08,Default,,0,0,0,,Осымен аяқталды.
Dialogue: 0,0:08:19.16,0:08:20.33,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:08:20.41,0:08:23.50,Default,,0,0,0,,Уәделер қалды
Dialogue: 0,0:08:24.46,0:08:27.42,Default,,0,0,0,,Сіз оны орындауыңыз керек
Dialogue: 0,0:08:29.13,0:08:30.21,Default,,0,0,0,,Иә
Dialogue: 0,0:08:31.01,0:08:35.93,Default,,0,0,0,,Нарық бағасы бекітілген болса да, «Біздің бұрынғылар өліп, оны бізге қалдырады».
Dialogue: 0,0:08:36.60,0:08:40.97,Default,,0,0,0,,Бұл Тошинори Яги күлкілі әңгіме
Dialogue: 0,0:08:42.52,0:08:46.77,Default,,0,0,0,,Маған галлюцинациялар не айтып жатыр деп ойлаймын.
Dialogue: 0,0:08:48.36,0:08:51.69,Default,,0,0,0,,Батыр мен адам
Dialogue: 0,0:08:51.78,0:08:54.45,Default,,0,0,0,,Мен оңай өлмеймін
Dialogue: 0,0:09:02.20,0:09:04.04,Default,,0,0,0,,Не? Бұл жарық
Dialogue: 0,0:09:04.92,0:09:05.79,Default,,0,0,0,,Бұл –
Dialogue: 0,0:09:06.38,0:09:08.00,Default,,0,0,0,,«Жарылыстың» «Даралығы»?
Dialogue: 0,0:09:09.21,0:09:10.80,Default,,0,0,0,,Охххх
Dialogue: 0,0:09:10.88,0:09:13.42,Default,,0,0,0,,Иә? Бұл адам қайда...
Dialogue: 0,0:09:13.51,0:09:16.64,Default,,0,0,0,,Міне. Баяғыда мені жаулар (зұлымдар) коалициясы ұрлап әкетті.
Dialogue: 0,0:09:17.97,0:09:20.64,Default,,0,0,0,,Ах! (Бакуго) Уф... уф...
Dialogue: 0,0:09:20.72,0:09:22.18,Default,,0,0,0,,А, мына жігіт!
Dialogue: 0,0:09:22.27,0:09:26.19,Default,,0,0,0,,Спорт мерекесінде ұсталды... Аты кім еді?
Dialogue: 0,0:09:26.27,0:09:29.52,Default,,0,0,0,,Мм... Бакуго!
Dialogue: 0,0:09:32.61,0:09:36.03,Default,,0,0,0,,Уф... у... а
Dialogue: 0,0:09:41.54,0:09:44.25,Default,,0,0,0,,Хаха...
Dialogue: 0,0:09:44.75,0:09:47.42,Default,,0,0,0,,Бакугу...бала!
Dialogue: 0,0:09:47.50,0:09:48.88,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:09:48.96,0:09:52.71,Default,,0,0,0,,А...осы жол...
Dialogue: 0,0:09:52.80,0:09:55.63,Default,,0,0,0,,Әй, қария! Уф
Dialogue: 0,0:09:55.72,0:09:57.34,Default,,0,0,0,,(Бакугоның жөтелі)
Dialogue: 0,0:09:57.43,0:10:00.64,Default,,0,0,0,,Бұл да менің жолым.
Dialogue: 0,0:10:00.72,0:10:02.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:02.72,0:10:03.60,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:03.68,0:10:05.68,Default,,0,0,0,,Шеттен түсіру!?
Dialogue: 0,0:10:05.77,0:10:08.23,Default,,0,0,0,,Ішіне жиналған қанды құстырды.
Dialogue: 0,0:10:08.81,0:10:11.23,Default,,0,0,0,,Өзіңізді сәл жақсы сезінесіз бе?
Dialogue: 0,0:10:11.32,0:10:14.57,Default,,0,0,0,,А... уф!
Dialogue: 0,0:10:14.65,0:10:16.32,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:10:16.40,0:10:18.78,Default,,0,0,0,,Ха... ха...
Dialogue: 0,0:10:18.86,0:10:22.95,Default,,0,0,0,,Немесе... Мүшелер Сынған сүйектер
Dialogue: 0,0:10:23.04,0:10:28.12,Default,,0,0,0,,Менің денеммен мояй түйінін байлаудың құпия Хакамада стилі
Dialogue: 0,0:10:28.21,0:10:30.71,Default,,0,0,0,,Біріншіден, ашу жоқ.
Dialogue: 0,0:10:30.79,0:10:31.67,Default,,0,0,0,,Бірақ... әр тыныс тозақ азабы болуы керек.
Dialogue: 0,0:10:31.67,0:10:36.26,Default,,0,0,0,,Бірақ... бір дем тозақтың азабы болуы керек.
Dialogue: 0,0:10:31.67,0:10:36.26,Default,,0,0,0,,(Бакугоның ауыр тыныс алуы)
Dialogue: 0,0:10:36.26,0:10:36.34,Default,,0,0,0,,(Бакугоның ауыр тыныс алуы)
Dialogue: 0,0:10:36.34,0:10:36.67,Default,,0,0,0,,(Бакугоның ауыр тыныс алуы)
Dialogue: 0,0:10:36.34,0:10:36.67,Default,,0,0,0,,Қозғалатын дене емес
Dialogue: 0,0:10:36.67,0:10:39.55,Default,,0,0,0,,Қозғалатын дене емес
Dialogue: 0,0:10:39.63,0:10:41.01,Default,,0,0,0,,Уау
Dialogue: 0,0:10:42.60,0:10:46.60,Default,,0,0,0,,Мені тірі қалдырғаныңа рахмет, Сенпай.
Dialogue: 0,0:10:46.68,0:10:50.35,Default,,0,0,0,,Мен жай ғана... қостым.
Dialogue: 0,0:10:51.65,0:10:56.90,Default,,0,0,0,,Сол кезде мен жүрегім мен өкпемді жұмыс істеуге мәжбүрлейтінмін, бірақ
Dialogue: 0,0:10:56.99,0:10:59.70,Default,,0,0,0,,есін жимады
Dialogue: 0,0:10:59.78,0:11:06.20,Default,,0,0,0,,Ninja Art Awl «Кивами» - адамның өз өмірлік әрекеттерін қысқарту формасы
Dialogue: 0,0:11:06.83,0:11:10.17,Default,,0,0,0,,Өзімнің немесе Бакугудың өміріне қауіп төндіріп, шегіне жету.
Dialogue: 0,0:11:10.25,0:11:13.67,Default,,0,0,0,,Таразыны өлшеуге мәжбүр болған кезде
Dialogue: 0,0:11:16.46,0:11:19.38,Default,,0,0,0,,Қан арқылы өтетін нәрсе
Dialogue: 0,0:11:20.55,0:11:21.89,Default,,0,0,0,,Өлім алдында
Dialogue: 0,0:11:22.55,0:11:28.18,Default,,0,0,0,,Бакугудың бүкіл денесінен кішкентай моншақ тер төгіліп жатты.
Dialogue: 0,0:11:32.44,0:11:35.90,Default,,0,0,0,,Мен... жай ғана қостым.
Dialogue: 0,0:11:36.57,0:11:41.86,Default,,0,0,0,,Сізді оятқан нәрсе - сіз шыңдаған "даралығыңыз".
Dialogue: 0,0:11:48.91,0:11:53.96,Default,,0,0,0,,Айтпасаң да, өзіңнен де асып түсетін батыр боламын!
Dialogue: 0,0:11:54.04,0:11:55.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:56.13,0:11:57.09,Default,,0,0,0,,Цука
Dialogue: 0,0:11:57.17,0:11:59.76,Default,,0,0,0,,Егер сіз жағдайдың барлығы біреу үшін деп ойласаңыз
Dialogue: 0,0:11:59.84,0:12:01.17,Default,,0,0,0,,Не? Сол кішкентай жігіт!
Dialogue: 0,0:12:01.26,0:12:02.38,Default,,0,0,0,,Ұшып кетіңіз!
Dialogue: 0,0:12:02.47,0:12:05.89,Default,,0,0,0,,Барлығы біреу үшін, балам.
Dialogue: 0,0:12:05.97,0:12:09.35,Default,,0,0,0,,«Қанның ұюына» байланысты қозғала алмау
Dialogue: 0,0:12:09.43,0:12:11.52,Default,,0,0,0,,Сіз осында келе аласыз ба?
Dialogue: 0,0:12:13.40,0:12:14.23,Default,,0,0,0,,Бұл — Они руының салты—
Dialogue: 0,0:12:14.98,0:12:16.57,Default,,0,0,0,,(Бакугоның ентігу дыбысы)
Dialogue: 0,0:12:22.15,0:12:25.57,Default,,0,0,0,,Ол өз функциясын жоғалтқанымен
Dialogue: 0,0:12:26.20,0:12:28.33,Default,,0,0,0,,Шпинат өлшемі туралы
Dialogue: 0,0:12:40.09,0:12:43.76,Default,,0,0,0,,«Үлкен, жарылғыш, кісі өлтіру, құдайдың динамиті»
Dialogue: 0,0:12:46.09,0:12:49.89,Default,,0,0,0,,Менің саған бере алатыным осы ғана
Dialogue: 0,0:12:56.90,0:12:58.15,Default,,0,0,0,,Иә
Dialogue: 0,0:13:00.78,0:13:01.99,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:13:02.07,0:13:05.24,Default,,0,0,0,,Бүкіл Құдірет-тың өмірін аласың ба?
Dialogue: 0,0:13:05.32,0:13:06.99,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:07.07,0:13:09.70,Default,,0,0,0,,Жоқ, мен оны кейінге қалдырамын!
Dialogue: 0,0:13:10.29,0:13:14.92,Default,,0,0,0,,Осы уақытқа дейін келсең, мен алдымен ініңді аламын!
Dialogue: 0,0:13:15.00,0:13:20.42,Default,,0,0,0,,Ол үшін біз тым күшті аза тұту рухын толығымен қабылдауымыз керек.
Dialogue: 0,0:13:21.09,0:13:25.30,Default,,0,0,0,,Мен жерлеуге өзімнің «даралығымды» беруім керек.
Dialogue: 0,0:13:25.38,0:13:27.55,Default,,0,0,0,,Бірінші кезекте сол кезде
Dialogue: 0,0:13:27.64,0:13:32.31,Default,,0,0,0,,Мен бастаманы қолға алсам ғой!
Dialogue: 0,0:13:32.39,0:13:35.81,Default,,0,0,0,,Барлығын ескеру керек еді.
Dialogue: 0,0:13:36.39,0:13:39.36,Default,,0,0,0,,Ең жақсы жолды таңдау
Dialogue: 0,0:13:39.44,0:13:42.15,Default,,0,0,0,,Мақсатқа қосылу
Dialogue: 0,0:13:42.23,0:13:43.61,Default,,0,0,0,,Иә
Dialogue: 0,0:13:43.69,0:13:45.78,Default,,0,0,0,,Сансыз маршруттар бар
Dialogue: 0,0:13:45.86,0:13:49.03,Default,,0,0,0,,Ішім қайнап жатыр!
Dialogue: 0,0:13:50.03,0:13:52.87,Default,,0,0,0,,Құлап бара жатқан нәрсені тепсең, бірден ұшып кететін сияқты.
Dialogue: 0,0:13:52.95,0:13:53.83,Default,,0,0,0,,Жай ғана тас
Dialogue: 0,0:13:55.12,0:13:58.25,Default,,0,0,0,,Мақсатыма апаратын жол бұлжымас.
Dialogue: 0,0:13:58.33,0:14:03.76,Default,,0,0,0,,Бірақ тісті берілістер неге істен шығып жатыр!?
Dialogue: 0,0:14:03.84,0:14:08.01,Default,,0,0,0,,Маған жел соғуы керек еді!
Dialogue: 0,0:14:11.10,0:14:12.47,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:13.10,0:14:17.52,Default,,0,0,0,,Мен соңғы бастықпын, Барлығы бір үшін!
Dialogue: 0,0:14:22.23,0:14:23.15,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:32.70,0:14:35.41,Default,,0,0,0,,Нені сүрте алмайды
Dialogue: 0,0:14:35.50,0:14:39.92,Default,,0,0,0,,Оны осы жерден сүртіңіз!
Dialogue: 0,0:14:48.01,0:14:49.51,Default,,0,0,0,,Суасты кемесі ме?
Dialogue: 0,0:14:49.59,0:14:52.60,Default,,0,0,0,,Мұнда басыңыз Тергеу штабынан әр пунктке есеп беру
Dialogue: 0,0:14:53.26,0:14:56.98,Default,,0,0,0,,Ұлы, жарылғыш, кісі өлтіру және құдайдың динамитімен Құдіретті құтқара алды.
Dialogue: 0,0:14:59.02,0:15:00.65,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:00.73,0:15:02.86,Default,,0,0,0,,Әр түрлі орындардан жағдай туралы есептерді сұрау
Dialogue: 0,0:15:02.94,0:15:03.77,Default,,0,0,0,,Иә
Dialogue: 0,0:15:03.86,0:15:07.49,Default,,0,0,0,,Орталық аурухана алдындағы тәртіпсіздікті ауыздықтау аяқталды
Dialogue: 0,0:15:10.32,0:15:12.24,Default,,0,0,0,,Ұйымдастырушы Спиннер қамауға алынды.
Dialogue: 0,0:15:12.82,0:15:14.03,Default,,0,0,0,,Зардап шеккендерді триаждау және
Dialogue: 0,0:15:14.12,0:15:16.83,Default,,0,0,0,,Ұсталған адамдарды беру басталды деп айтылады.
Dialogue: 0,0:15:16.91,0:15:20.12,Default,,0,0,0,,Okuwatajima жоғары деңгейлі әрекеттерінің тоқтатылуын растау
Dialogue: 0,0:15:20.21,0:15:21.83,Default,,0,0,0,,Басу аяқталды
Dialogue: 0,0:15:21.92,0:15:24.25,Default,,0,0,0,,Қалпына келтіру тобы оқиға орнына бара жатыр.
Dialogue: 0,0:15:24.34,0:15:26.59,Default,,0,0,0,,Әрі қарай, бөлу операциясының бастапқы нүктесі
Dialogue: 0,0:15:26.67,0:15:28.26,Default,,0,0,0,,Басу аяқталды
Dialogue: 0,0:15:29.47,0:15:33.05,Default,,0,0,0,,Қазір зардап шеккендерді құтқару жұмыстары жүргізілуде.
Dialogue: 0,0:15:33.14,0:15:35.10,Default,,0,0,0,,Ұлттық Такоба стадионы
Dialogue: 0,0:15:35.18,0:15:37.06,Default,,0,0,0,,Соғысты жалғастыру
Dialogue: 0,0:15:37.72,0:15:37.97,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:15:37.97,0:15:39.02,Default,,0,0,0,,Қандай әдемі теңдігімді бұзды!
Dialogue: 0,0:15:37.97,0:15:39.02,Default,,0,0,0,,Дацугоку Гашридің физикалық шабуылы
Dialogue: 0,0:15:39.02,0:15:39.10,Default,,0,0,0,,Дацугоку Гэшлидің физикалық шабуылы
Dialogue: 0,0:15:39.10,0:15:39.93,Default,,0,0,0,,Дацугоку Гэшлидің физикалық шабуылы
Dialogue: 0,0:15:39.10,0:15:39.93,Default,,0,0,0,,Егер ағам мен әпкем әлі тірі болса…
Dialogue: 0,0:15:39.93,0:15:40.60,Default,,0,0,0,,Дацугоку Гэшлидің физикалық шабуылы
Dialogue: 0,0:15:40.69,0:15:42.31,Default,,0,0,0,,Қиын болып жатқан сияқтысыз
Dialogue: 0,0:15:42.94,0:15:44.06,Default,,0,0,0,,Скептик мырза
Dialogue: 0,0:15:44.15,0:15:47.82,Default,,0,0,0,,Қазіргі уақытта қамауға алынған батырмен бірге жеткізілуде.
Dialogue: 0,0:15:47.90,0:15:50.11,Default,,0,0,0,,Юэй эвакуация жүйесі бойынша—
Dialogue: 0,0:15:50.20,0:15:51.82,Default,,0,0,0,,Шике орта мектебіне эвакуациялау аяқталды
Dialogue: 0,0:15:52.45,0:15:55.45,Default,,0,0,0,,Қазіргі уақытта тоқтатылған блоктың эвакуацияланушыларын қорғау үшін жіберілді.
Dialogue: 0,0:15:56.16,0:15:58.37,Default,,0,0,0,,Ягуар ауруханасының алаңын басып шығару аяқталды
Dialogue: 0,0:15:59.25,0:16:00.46,Default,,0,0,0,,Курогири туралы
Dialogue: 0,0:16:00.54,0:16:02.75,Default,,0,0,0,,Қазіргі микрофоны бар өшіргіш басы
Dialogue: 0,0:16:02.83,0:16:05.00,Default,,0,0,0,,Әлі де жоқ.
Dialogue: 0,0:16:05.09,0:16:06.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:10.51,0:16:12.22,Default,,0,0,0,,Леди Наган
Dialogue: 0,0:16:12.30,0:16:13.76,Default,,0,0,0,,Бұл жалпы соғыс –
Dialogue: 0,0:16:13.84,0:16:17.64,Default,,0,0,0,,Соңында бұл сіз Изуку Мидорияға сенетін шайқасқа айналады.
Dialogue: 0,0:16:18.39,0:16:20.73,Default,,0,0,0,,Бізбен күресіңізші
Dialogue: 0,0:16:21.39,0:16:24.35,Default,,0,0,0,,Мидория... Изуку
Dialogue: 0,0:16:26.77,0:16:28.11,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:35.12,0:16:36.99,Default,,0,0,0,,Шынында да солай ма…
Dialogue: 0,0:16:37.08,0:16:39.54,Default,,0,0,0,,А... анау жігіт
Dialogue: 0,0:16:39.62,0:16:43.87,Default,,0,0,0,,Өлім алдында, бірақ бір сәтке
Dialogue: 0,0:16:43.96,0:16:48.17,Default,,0,0,0,,Тіпті қураған ағаштың өзі онымен ойнаудың нышанын көрсетті.
Dialogue: 0,0:16:48.25,0:16:51.09,Default,,0,0,0,,Ол бірдеңе жасады
Dialogue: 0,0:16:51.17,0:16:54.72,Default,,0,0,0,,Мен оны ұстап алу үстінде болдым.
Dialogue: 0,0:16:55.93,0:16:58.72,Default,,0,0,0,,Менің денем «жарылыстан» ауырады
Dialogue: 0,0:16:58.81,0:16:59.85,Default,,0,0,0,,Бірақ
Dialogue: 0,0:16:59.93,0:17:06.52,Default,,0,0,0,,Осы жанама әсерді пайдаланыңыз! Көбірек! әлі! көбірек!
Dialogue: 0,0:17:07.69,0:17:10.94,Default,,0,0,0,,Жетеді, кейін қалдырамын.
Dialogue: 0,0:17:11.53,0:17:13.11,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:17:13.19,0:17:17.57,Default,,0,0,0,,Мен бұздым деп ойлаған нәрсем тарақан сияқты қыңыр болды...
Dialogue: 0,0:17:17.66,0:17:19.20,Default,,0,0,0,,Гррр...
Dialogue: 0,0:17:19.28,0:17:21.24,Default,,0,0,0,,Жарайды (Изуку) Уф!
Dialogue: 0,0:17:21.33,0:17:22.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:23.20,0:17:28.13,Default,,0,0,0,,Тек оны қайта-қайта жойыңыз
Dialogue: 0,0:17:28.21,0:17:28.96,Default,,0,0,0,,Я...
Dialogue: 0,0:17:28.96,0:17:30.17,Default,,0,0,0,,Я...
Dialogue: 0,0:17:28.96,0:17:30.17,Default,,0,0,0,,Қашықтықты сақтаңыз
Dialogue: 0,0:17:30.25,0:17:32.88,Default,,0,0,0,,Мен 4-ші (күшпен) үлгердім.
Dialogue: 0,0:17:33.55,0:17:37.89,Default,,0,0,0,,Регенерация плюс лезде өлім және бұрынғыдан да күшті дене
Dialogue: 0,0:17:37.97,0:17:39.64,Default,,0,0,0,,Онымен қалай күресуге болады
Dialogue: 0,0:17:39.72,0:17:42.22,Default,,0,0,0,,Жауап табылмады
Dialogue: 0,0:17:42.31,0:17:46.98,Default,,0,0,0,,2 - белсендіру уақытына қарамастан белсендіруден кейінгі соңғысы
Dialogue: 0,0:17:47.06,0:17:51.07,Default,,0,0,0,,Сіз кесіп алғаннан кейін денеңіз кері шегінуге байланысты қозғалуды тоқтатады.
Dialogue: 0,0:17:51.15,0:17:55.53,Default,,0,0,0,,Енді ол іске қосылды, бұл жолы соңғы рет.
Dialogue: 0,0:17:58.07,0:18:00.91,Default,,0,0,0,,Әрі қарай!
Dialogue: 0,0:18:04.25,0:18:06.41,Default,,0,0,0,,Әлі де тобыр!
Dialogue: 0,0:18:07.50,0:18:09.71,Default,,0,0,0,,Күш соншалықты үлкен емес
Dialogue: 0,0:18:09.79,0:18:12.71,Default,,0,0,0,,Endeavour немесе «Қара көлеңке» сияқты көп қысым емес
Dialogue: 0,0:18:12.80,0:18:14.88,Default,,0,0,0,,Кейінірек орындаңыз
Dialogue: 0,0:18:14.96,0:18:17.72,Default,,0,0,0,,Бүкіл Құдірет-пен салыстыруға болмайды
Dialogue: 0,0:18:17.80,0:18:19.14,Default,,0,0,0,,Тоқтаңдар, екеуің де
Dialogue: 0,0:18:19.22,0:18:23.64,Default,,0,0,0,,Артқа айналдыруды жалғастыру үшін күш салуға тұрарлық!
Dialogue: 0,0:18:23.72,0:18:25.93,Default,,0,0,0,,Мағынасы да! Энишимо!
Dialogue: 0,0:18:26.02,0:18:29.19,Default,,0,0,0,,Ол тас жоқ!
Dialogue: 0,0:18:31.44,0:18:33.19,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:18:33.27,0:18:35.19,Default,,0,0,0,,Бұл ауырсыну.
Dialogue: 0,0:18:35.28,0:18:40.99,Default,,0,0,0,,Алақанымда тер моншақтары, бүкіл денемді ауырту
Dialogue: 0,0:18:41.07,0:18:42.99,Default,,0,0,0,,Орналасу аралығын бұзатын ауырсыну!
Dialogue: 0,0:18:42.99,0:18:45.70,Default,,0,0,0,,Орналасу аралығын бұзатын ауырсыну!
Dialogue: 0,0:18:42.99,0:18:45.70,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,0:18:45.70,0:18:45.79,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,0:18:45.79,0:18:46.54,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,0:18:45.79,0:18:46.54,Default,,0,0,0,,Оны ауыртпалықпен ұстаңыз! Жарылу уақыты келді!
Dialogue: 0,0:18:46.54,0:18:49.58,Default,,0,0,0,,Оны ауыртпалықпен ұстаңыз! Жарылу уақыты келді!
Dialogue: 0,0:19:02.26,0:19:03.26,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:03.97,0:19:06.98,Default,,0,0,0,,Сәлем! Хахаха
Dialogue: 0,0:19:07.06,0:19:08.81,Default,,0,0,0,,Тым жылдам
Dialogue: 0,0:19:09.89,0:19:11.48,Default,,0,0,0,,Тоқтамаңыз!
Dialogue: 0,0:19:11.56,0:19:13.94,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:14.73,0:19:16.69,Default,,0,0,0,,Сәлем Иззуку
Dialogue: 0,0:19:17.99,0:19:22.03,Default,,0,0,0,,Мен сені әлі де қуып жете аламын ба?
Dialogue: 0,0:19:25.12,0:19:26.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:27.08,0:19:29.41,Default,,0,0,0,,Неліктен деп ойлаймын
Dialogue: 0,0:19:30.62,0:19:34.67,Default,,0,0,0,,Мен қазір бір нәрсені басып озатындай сезінемін.
Dialogue: 0,0:19:41.72,0:19:43.01,Default,,0,0,0,,Уваааах! Ашылмай жатыр!
Dialogue: 0,0:19:43.09,0:19:45.56,Default,,0,0,0,,Сен... Кацуки...
Dialogue: 0,0:19:45.64,0:19:48.02,Default,,0,0,0,,Жоқ, мен оны көрмеймін.
Dialogue: 0,0:19:48.10,0:19:49.93,Default,,0,0,0,,Өйткені екінші тарап...
Dialogue: 0,0:19:50.02,0:19:52.31,Default,,0,0,0,,Оны әлі де көру керек
Dialogue: 0,0:19:52.81,0:19:56.48,Default,,0,0,0,,Мен бұл балаға сенімдімін
Dialogue: 0,0:19:57.28,0:20:01.86,Default,,0,0,0,,Сіз әдеттегідей күлімдеуіңіз керек.
Dialogue: 0,0:20:02.70,0:20:04.07,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:20:07.58,0:20:11.71,Default,,0,0,0,,Неліктен бұл тас бұрыннан...
Dialogue: 0,0:20:11.79,0:20:15.54,Default,,0,0,0,,Мен неге Бүкіл Құдірет-тен артықпын...!?
Dialogue: 0,0:20:21.17,0:20:22.43,Default,,0,0,0,,Егер Йоичи...
Dialogue: 0,0:20:24.01,0:20:29.02,Default,,0,0,0,,Бұл Йоичи болса, ол қазір кетті.
Dialogue: 0,0:20:29.64,0:20:31.56,Default,,0,0,0,,Жын патшасы
Dialogue: 0,0:20:33.56,0:20:36.52,Default,,0,0,0,,Сен оны өлтірдің.
Dialogue: 0,0:20:37.90,0:20:40.86,Default,,0,0,0,,Иә, ұқсас
Dialogue: 0,0:20:41.61,0:20:46.62,Default,,0,0,0,,Өшпенділік сезімін оятып, ол қайта оралады
Dialogue: 0,0:20:47.28,0:20:49.74,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:20:49.83,0:20:52.12,Default,,0,0,0,,Бұл жігіт еді.
Dialogue: 0,0:20:52.21,0:20:56.00,Default,,0,0,0,,Бұл жігіт Йоичи... Оның інісі...
Dialogue: 0,0:20:58.09,0:21:01.38,Default,,0,0,0,,Қолыңызды созбасаңыз!
Dialogue: 0,0:21:06.47,0:21:07.30,Default,,0,0,0,,Ха!
Dialogue: 0,0:21:11.56,0:21:15.23,Default,,0,0,0,,Гуаааааааааааа!
Dialogue: 0,0:21:28.91,0:21:32.25,Default,,0,0,0,,Менің ең жек көретінім...
Dialogue: 0,0:21:35.58,0:21:39.50,Default,,0,0,0,,Бұл сенсің... Дұрыс...
Dialogue: 0,0:21:39.59,0:21:43.51,Default,,0,0,0,,Бұл сен кінәлісің, Кандо!
Dialogue: 0,0:21:43.59,0:21:46.30,Default,,0,0,0,,Бұлыңғырлық келді, Барса!
Dialogue: 0,0:21:46.38,0:21:50.93,Default,,0,0,0,,Мен Бакугудың Каччанмын!
Dialogue: 0,0:21:51.01,0:21:56.02,Default,,0,0,0,,♪～
Dialogue: 0,0:23:15.01,0:23:20.02,Default,,0,0,0,,～♪
Dialogue: 0,0:23:21.85,0:23:22.90,Default,,0,0,0,,Мен бұны реттеймін
Dialogue: 0,0:23:23.48,0:23:26.07,Default,,0,0,0,,Шайқас кезінде, Барлығы бір үшін санасында
Dialogue: 0,0:23:26.15,0:23:27.65,Default,,0,0,0,,Менің өткен өмірім қайта тіріледі
Dialogue: 0,0:23:28.53,0:23:33.74,Default,,0,0,0,,Туылуы Ерекше қабілетсіз іні ұрлық
Dialogue: 0,0:23:33.83,0:23:35.20,Default,,0,0,0,,Бұрмаланған армандар
Dialogue: 0,0:23:35.28,0:23:39.41,Default,,0,0,0,,Бұл арманға тосқауыл қоятын нәрсе - соқыр нұр.
Dialogue: 0,0:23:40.37,0:23:43.17,Default,,0,0,0,,Келесі жолы ""Индивидуалдылық"!! Жарылыс!!"
Dialogue: 0,0:23:43.25,0:23:45.46,Default,,0,0,0,,Каччанның шынайы Хаузер әсері
Dialogue: 0,0:23:45.55,0:23:46.92,Default,,0,0,0,,Енді жарылады
Dialogue: 0,0:23:47.80,0:23:50.93,Default,,0,0,0,,Әрі қарай!Plus Ultra!
Dialogue: 0,0:23:52.43,0:23:58.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
