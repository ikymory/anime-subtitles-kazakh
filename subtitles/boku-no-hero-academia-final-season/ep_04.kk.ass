Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.04,0:00:08.42,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,0:00:08.50,0:00:12.93,Default,,0,0,0,,Бұл көмескі естелік
Dialogue: 0,0:00:13.01,0:00:14.84,Default,,0,0,0,,Онда брондау қиын.
Dialogue: 0,0:00:14.84,0:00:15.68,Default,,0,0,0,,Онда брондау қиын.
Dialogue: 0,0:00:14.84,0:00:15.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:15.76,0:00:16.64,Default,,0,0,0,,Ах
Dialogue: 0,0:00:19.52,0:00:21.60,Default,,0,0,0,,Эй, ол адам...
Dialogue: 0,0:00:23.19,0:00:25.86,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:00:25.94,0:00:26.81,Default,,0,0,0,,Иә! (Әйел) О
Dialogue: 0,0:00:28.02,0:00:30.99,Default,,0,0,0,,Шу болып тұр, кет.
Dialogue: 0,0:00:35.78,0:00:40.79,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,0:00:57.05,0:01:02.06,Default,,0,0,0,,♪～
Dialogue: 0,0:02:20.22,0:02:25.22,Default,,0,0,0,,～♪
Dialogue: 0,0:02:31.52,0:02:33.69,Default,,0,0,0,,Жарқыраған сәбиден бастау
Dialogue: 0,0:02:33.77,0:02:38.70,Default,,0,0,0,,Дүние жүзінде табиғаттан тыс күштер туралы хабарлар бірінен соң бірі болып жатыр.
Dialogue: 0,0:02:38.78,0:02:41.62,Default,,0,0,0,,Ерекше қабілет тек туа біткен емес.
Dialogue: 0,0:02:41.70,0:02:46.00,Default,,0,0,0,,Өйткені олар жүре пайда болады, тіпті қайталама жыныстық белгілерге дейін және одан кейін де пайда болады.
Dialogue: 0,0:02:46.08,0:02:50.96,Default,,0,0,0,,Зерттеу тобы мұны белгісіз ауру ретінде зерттеді.
Dialogue: 0,0:02:51.04,0:02:56.88,Default,,0,0,0,,Табиғаттан тыс күштерді «адамдардан тармақталған жаңа ген» деп жариялады
Dialogue: 0,0:02:56.96,0:03:01.39,Default,,0,0,0,,Бұл соншалықты сезімтал және ерте болды.
Dialogue: 0,0:03:01.47,0:03:04.68,Default,,0,0,0,,Табиғаттан тыс күштері барлар және жоқтар
Dialogue: 0,0:03:04.76,0:03:09.02,Default,,0,0,0,,Топтық өмірді шешуші түрде бөлетін хабарландыру
Dialogue: 0,0:03:09.10,0:03:12.56,Default,,0,0,0,,Одан кейінгі хаосты жеделдете түсті
Dialogue: 0,0:03:14.27,0:03:18.82,Default,,0,0,0,,Өнеркәсіп кешенінің айналасына табиғаттан тыс күшке ие адамдар жинала бастаған сияқты.
Dialogue: 0,0:03:18.90,0:03:21.57,Default,,0,0,0,,Бұл кеше түнде демонстранттар қақтығысқан жігіттер.
Dialogue: 0,0:03:21.66,0:03:24.70,Default,,0,0,0,,Олар әрекет жасамас бұрын мен оларды ұрамын.
Dialogue: 0,0:03:27.66,0:03:29.75,Default,,0,0,0,,Ха! Не?
Dialogue: 0,0:03:32.37,0:03:35.67,Default,,0,0,0,,Не, паранормальді жетім?
Dialogue: 0,0:03:35.75,0:03:38.38,Default,,0,0,0,,Мен сені аяймын, бірақ мені жайына қалдыр.
Dialogue: 0,0:03:38.46,0:03:39.38,Default,,0,0,0,,Кеттік
Dialogue: 0,0:03:39.47,0:03:42.09,Default,,0,0,0,,Жетім балалар тасымалдаушы болуы ықтимал
Dialogue: 0,0:03:43.14,0:03:44.47,Default,,0,0,0,,(шу)
Dialogue: 0,0:03:44.55,0:03:46.72,Default,,0,0,0,,Иә? Бұл ненің дыбысы?
Dialogue: 0,0:03:51.98,0:03:56.44,Default,,0,0,0,,Бұл анамнан алынған табиғаттан тыс қабілет.
Dialogue: 0,0:03:56.52,0:04:00.69,Default,,0,0,0,,Сәби туылды.
Dialogue: 0,0:04:01.28,0:04:04.95,Default,,0,0,0,,Айналаңыздағының бәрі сіздің меншігіңіз.
Dialogue: 0,0:04:05.03,0:04:10.79,Default,,0,0,0,,Жылап, айқайласа да, өзіне қарамай, ештеңе бермейтіндер
Dialogue: 0,0:04:10.87,0:04:13.67,Default,,0,0,0,,Мен жай ғана таң қалдым.
Dialogue: 0,0:04:18.17,0:04:19.46,Default,,0,0,0,,Оу!
Dialogue: 0,0:04:19.96,0:04:22.47,Default,,0,0,0,,Бұл... көмек болды...
Dialogue: 0,0:04:22.55,0:04:24.59,Default,,0,0,0,,Дегенмен, Ол Майт—
Dialogue: 0,0:04:24.68,0:04:27.47,Default,,0,0,0,,Ух... Ууууууууууу!
Dialogue: 0,0:04:28.97,0:04:31.10,Default,,0,0,0,,Ах… Ах… Ах…
Dialogue: 0,0:04:31.18,0:04:36.11,Default,,0,0,0,,(ер адамның үрейлі дауысы)
Dialogue: 0,0:04:36.19,0:04:40.99,Default,,0,0,0,,Жақсы емес... Ауырмайды.
Dialogue: 0,0:04:41.07,0:04:44.11,Default,,0,0,0,,Ананың беруі керек тағам
Dialogue: 0,0:04:44.20,0:04:47.03,Default,,0,0,0,,Оның басым бөлігін ағам алып кеткен.
Dialogue: 0,0:04:47.12,0:04:51.25,Default,,0,0,0,,Менің інім өте кішкентай, осал еді.
Dialogue: 0,0:04:51.75,0:04:53.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:53.54,0:04:54.96,Default,,0,0,0,,Уф
Dialogue: 0,0:04:55.54,0:04:58.71,Default,,0,0,0,,Өзіне ештеңе бермейтін тіршілік иесі еді, бірақ
Dialogue: 0,0:04:59.29,0:05:01.46,Default,,0,0,0,,Өйткені ол менің қолымда болды
Dialogue: 0,0:05:02.09,0:05:07.34,Default,,0,0,0,,Аға інісін ешқашан жібермейтін.
Dialogue: 0,0:05:07.43,0:05:08.39,Default,,0,0,0,,Суасты кемесі ме?
Dialogue: 0,0:05:08.47,0:05:11.47,Default,,0,0,0,,Еңбекке қабілетті және әртүрлі қабілетті адамдар арасындағы қайшылық тереңдей түскенде,
Dialogue: 0,0:05:11.56,0:05:16.31,Default,,0,0,0,,Жарқыраған сәби бейбітшілік пен қауіпсіздікке шақыруда жетекшілік етеді.
Dialogue: 0,0:05:16.40,0:05:20.86,Default,,0,0,0,,Қолдаушылардың қатары күннен-күнге көбейіп, шатасып барады.
Dialogue: 0,0:05:20.94,0:05:22.11,Default,,0,0,0,,Суасты кемесі ме?
Dialogue: 0,0:05:22.19,0:05:24.95,Default,,0,0,0,,Маған айтпай не оқып отырсың?
Dialogue: 0,0:05:25.03,0:05:29.62,Default,,0,0,0,,Мен әлі жазуды үйреніп жатырмын, сондықтан қиын кітаптарды оқи алмаймын.
Dialogue: 0,0:05:29.70,0:05:32.75,Default,,0,0,0,,Бұл комикс керемет.
Dialogue: 0,0:05:32.83,0:05:34.79,Default,,0,0,0,,Оны суреттер арқылы оқуға болады
Dialogue: 0,0:05:34.87,0:05:38.50,Default,,0,0,0,,Оны салған адамның тілегі сурет арқылы беріледі.
Dialogue: 0,0:05:39.59,0:05:40.96,Default,,0,0,0,,Батыр
Dialogue: 0,0:05:42.00,0:05:45.92,Default,,0,0,0,,Мен де бір күні осындай болғым келеді.
Dialogue: 0,0:05:48.30,0:05:50.35,Default,,0,0,0,,Сен де оқығың келе ме, ағайын?
Dialogue: 0,0:05:53.47,0:05:58.35,Default,,0,0,0,,Інісі әлі үлкен ағасынан бас тарта алмады.
Dialogue: 0,0:05:58.44,0:06:01.36,Default,,0,0,0,,Менің бұл қолым бұлыңғыр есімде
Dialogue: 0,0:06:01.94,0:06:05.86,Default,,0,0,0,,Бұл ағамның жақсылығы деп сенгім келді.
Dialogue: 0,0:06:07.78,0:06:12.79,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:06:13.95,0:06:15.29,Default,,0,0,0,,Оның жанашырлары
Dialogue: 0,0:06:15.37,0:06:19.17,Default,,0,0,0,,Ол 10 миллион адамнан асты.
Dialogue: 0,0:06:20.58,0:06:21.42,Default,,0,0,0,,Брат?
Dialogue: 0,0:06:22.04,0:06:24.05,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:06:24.13,0:06:28.43,Default,,0,0,0,,Отбасын тіркеу ең жылдам болды.
Dialogue: 0,0:06:28.51,0:06:31.35,Default,,0,0,0,,Үндістанда, екі апта бұрын
Dialogue: 0,0:06:31.43,0:06:35.14,Default,,0,0,0,,50 адам табиғаттан тыс күштермен туылған дейді.
Dialogue: 0,0:06:36.31,0:06:39.98,Default,,0,0,0,,Бауырым, ол түрі...
Dialogue: 0,0:06:40.06,0:06:42.56,Default,,0,0,0,,Бұл біртүрлі оқиға.
Dialogue: 0,0:06:42.65,0:06:46.36,Default,,0,0,0,,Осылайша сіз адамдарды жинай аласыз.
Dialogue: 0,0:06:46.94,0:06:50.36,Default,,0,0,0,,Мен оны өлтіріп, ұрлап алдым.
Dialogue: 0,0:06:50.45,0:06:52.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:52.57,0:06:54.28,Default,,0,0,0,,Қарғыс атқыр... неге!
Dialogue: 0,0:06:54.37,0:06:58.04,Default,,0,0,0,,Өйткені ол сол комиксте бейнеленген болуы мүмкін.
Dialogue: 0,0:06:58.12,0:07:02.08,Default,,0,0,0,,«Біріміз бәріміз үшін, бәріміз біріміз үшін»
Dialogue: 0,0:07:03.09,0:07:05.21,Default,,0,0,0,,Бұл жақсы сөз.
Dialogue: 0,0:07:06.09,0:07:10.47,Default,,0,0,0,,Батыр өзінің шынайы болмысын жасырып, жалғыз күресті, бірақ
Dialogue: 0,0:07:10.55,0:07:15.64,Default,,0,0,0,,Зұлым жын патшадан бәрі қорқады, ол оған бәрін береді.
Dialogue: 0,0:07:16.43,0:07:19.14,Default,,0,0,0,,Сіз қандайсыз
Dialogue: 0,0:07:19.23,0:07:23.90,Default,,0,0,0,,Барлығы мен үшін бар әлем
Dialogue: 0,0:07:24.73,0:07:27.53,Default,,0,0,0,,Менің де түс көрдім
Dialogue: 0,0:07:28.99,0:07:30.61,Default,,0,0,0,,Ағай...
Dialogue: 0,0:07:34.20,0:07:37.20,Default,,0,0,0,,Сіз неге күресесіз?
Dialogue: 0,0:07:37.29,0:07:41.87,Default,,0,0,0,,Менімен жүр, менің ақымақ әрі сүйкімді інім.
Dialogue: 0,0:07:42.50,0:07:45.38,Default,,0,0,0,,Қазір дүние дүрбелеңде.
Dialogue: 0,0:07:45.46,0:07:49.01,Default,,0,0,0,,Үлкен күштерді жеке пайдаға пайдалануға болмайды.
Dialogue: 0,0:07:49.59,0:07:53.01,Default,,0,0,0,,Сіз тек өзіңізді қанағаттандыру туралы ойлайсыз!
Dialogue: 0,0:07:53.59,0:07:56.81,Default,,0,0,0,,А... бейшара.
Dialogue: 0,0:07:56.89,0:08:00.43,Default,,0,0,0,,Табиғаттан тыс күшсіз туылған...
Dialogue: 0,0:08:00.52,0:08:03.52,Default,,0,0,0,,Күш болмаса, өтуге себеп жоқ.
Dialogue: 0,0:08:03.60,0:08:04.73,Default,,0,0,0,,Аһ!
Dialogue: 0,0:08:04.81,0:08:07.82,Default,,0,0,0,,Менің ешқандай мүмкіндігім жоқ қой, иә?
Dialogue: 0,0:08:07.90,0:08:10.61,Default,,0,0,0,,Шындық оқулық бойынша жүрмейді
Dialogue: 0,0:08:10.69,0:08:11.28,Default,,0,0,0,,(Йоичидің ыңырсыуы)
Dialogue: 0,0:08:11.28,0:08:14.16,Default,,0,0,0,,(Йоичидің ыңырсыуы)
Dialogue: 0,0:08:11.28,0:08:14.16,Default,,0,0,0,,Маған берілмейтін шындық
Dialogue: 0,0:08:14.16,0:08:14.24,Default,,0,0,0,,(Йоичидің ыңырсыуы)
Dialogue: 0,0:08:14.24,0:08:15.70,Default,,0,0,0,,(Йоичидің ыңырсыуы)
Dialogue: 0,0:08:14.24,0:08:15.70,Default,,0,0,0,,Мен оны қазірден бастап қайта бояймын
Dialogue: 0,0:08:15.70,0:08:17.12,Default,,0,0,0,,Мен оны қазірден бастап қайта бояймын
Dialogue: 0,0:08:17.20,0:08:19.62,Default,,0,0,0,,Сен мен үшін маңыздысың
Dialogue: 0,0:08:19.70,0:08:21.04,Default,,0,0,0,,Тоқта
Dialogue: 0,0:08:21.12,0:08:22.62,Default,,0,0,0,,Тіпті арық адам үшін
Dialogue: 0,0:08:22.71,0:08:25.63,Default,,0,0,0,,Мен қолдануға оңай табиғаттан тыс қабілет таптым.
Dialogue: 0,0:08:25.71,0:08:28.67,Default,,0,0,0,,Мен оны қазір беремін.
Dialogue: 0,0:08:28.75,0:08:29.84,Default,,0,0,0,,Тоқта
Dialogue: 0,0:08:29.92,0:08:31.59,Default,,0,0,0,,Мен де есімді шештім.
Dialogue: 0,0:08:31.67,0:08:33.59,Default,,0,0,0,,«Йоичи»
Dialogue: 0,0:08:33.68,0:08:37.18,Default,,0,0,0,,Өйткені бұл маған берілген бірінші нәрсе болды.
Dialogue: 0,0:08:37.26,0:08:39.60,Default,,0,0,0,,Осылайша аталды
Dialogue: 0,0:08:39.68,0:08:44.98,Default,,0,0,0,,Жүр, бірге барайық, Йоичи.
Dialogue: 0,0:08:45.06,0:08:46.94,Default,,0,0,0,,Тоқта
Dialogue: 0,0:08:47.48,0:08:49.23,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:08:52.53,0:08:53.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:04.62,0:09:07.13,Default,,0,0,0,,(Йоичидің ауыр тыныс алуы)
Dialogue: 0,0:09:07.75,0:09:11.13,Default,,0,0,0,,Тоқта, неге кетіп бара жатырсың?
Dialogue: 0,0:09:11.21,0:09:14.38,Default,,0,0,0,,Мен саған күш берген жоқпын ба?
Dialogue: 0,0:09:14.47,0:09:16.89,Default,,0,0,0,,Не?сен
Dialogue: 0,0:09:16.97,0:09:18.14,Default,,0,0,0,,Дионы жеңуге арналған бұл сапар—
Dialogue: 0,0:09:18.22,0:09:21.47,Default,,0,0,0,,Бұл менікі. Маған қара!
Dialogue: 0,0:09:22.31,0:09:24.94,Default,,0,0,0,,Егер бұл менікі болмаса...
Dialogue: 0,0:09:25.02,0:09:26.06,Default,,0,0,0,,Ах... Уф.
Dialogue: 0,0:09:26.14,0:09:27.44,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:09:35.36,0:09:38.99,Default,,0,0,0,,Ағамды ұрлаған жігіттің көзін тапсам да
Dialogue: 0,0:09:39.07,0:09:44.87,Default,,0,0,0,,Оның көз алмалары табиғи түрде жылтыр емес еді, оларда жұқа қабық бар сияқты.
Dialogue: 0,0:09:45.62,0:09:51.92,Default,,0,0,0,,Ол көздерде жастық шақ көрінбеді.
Dialogue: 0,0:10:00.51,0:10:02.72,Default,,0,0,0,,«біреуден алынған нәрсе»
Dialogue: 0,0:10:02.81,0:10:05.68,Default,,0,0,0,,«Қызмет ету мақсатында алынған заттар»
Dialogue: 0,0:10:06.27,0:10:11.44,Default,,0,0,0,,Билікті Йоичиге беруге мәжбүр болдым, ол оған қажет емес деп бас тартты.
Dialogue: 0,0:10:12.02,0:10:16.45,Default,,0,0,0,,Маған беру керек болған табиғаттан тыс күш жоғалып кетті.
Dialogue: 0,0:10:17.03,0:10:19.45,Default,,0,0,0,,Мұндай жағдай бұрын-соңды болмаған
Dialogue: 0,0:10:20.03,0:10:24.29,Default,,0,0,0,,Мен Йоичидің табиғаттан тыс күштері жоқ екенін растадым.
Dialogue: 0,0:10:24.37,0:10:28.37,Default,,0,0,0,,Мен өзімді сезбей тұрып алып кетті деп ойладым.
Dialogue: 0,0:10:28.46,0:10:33.67,Default,,0,0,0,,Менің табиғаттан тыс қабілетім соншалықты кішкентай, мен оны фактор ретінде тани алмаймын.
Dialogue: 0,0:10:33.75,0:10:37.22,Default,,0,0,0,,Тексеру кезінде жұмыс істемейтін қоқыс табылды
Dialogue: 0,0:10:37.88,0:10:43.85,Default,,0,0,0,,Қалыптасу кезінде қоректік заттардың жетіспеушілігінен қалыптаспаған фактор сияқты нәрсе.
Dialogue: 0,0:10:45.10,0:10:48.60,Default,,0,0,0,,Ол шынымен қозғалды ма?
Dialogue: 0,0:10:49.98,0:10:52.36,Default,,0,0,0,,Көшбасшы Сол жеңіліс кезінде —
Dialogue: 0,0:10:52.44,0:10:53.27,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:10:53.27,0:10:56.03,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:10:53.27,0:10:56.03,Default,,0,0,0,,Сіз «Барлығы бір үшін» тақырыбына қол тигізбедіңіз бе?
Dialogue: 0,0:10:56.03,0:10:56.11,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:10:56.11,0:10:57.44,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:10:56.11,0:10:57.44,Default,,0,0,0,,Сен өте табандысың, Брюс, маған нәтижені айт.
Dialogue: 0,0:10:57.44,0:10:59.36,Default,,0,0,0,,Сіз табандысыз Брюс, маған нәтижені айтыңыз.
Dialogue: 0,0:11:00.45,0:11:03.49,Default,,0,0,0,,Сол күннен бастап мен бүкіл денемді жайсыз сезінемін.
Dialogue: 0,0:11:03.58,0:11:04.99,Default,,0,0,0,,Мен оны өте жақсы байқадым.
Dialogue: 0,0:11:05.66,0:11:08.62,Default,,0,0,0,,Ағзада екі фактор бар.
Dialogue: 0,0:11:09.21,0:11:14.00,Default,,0,0,0,,Туа біткен заттар мен ақаулар сияқты ұсақ-түйектер
Dialogue: 0,0:11:15.42,0:11:18.63,Default,,0,0,0,,Мен солай деп ойладым.
Dialogue: 0,0:11:19.55,0:11:22.30,Default,,0,0,0,,Мен берген табиғаттан тыс күш жоғалып кетті.
Dialogue: 0,0:11:22.39,0:11:25.64,Default,,0,0,0,,Жетіспейтін бөліктерді толтыру үшін енгізілген
Dialogue: 0,0:11:25.72,0:11:27.64,Default,,0,0,0,,ұрланған
Dialogue: 0,0:11:28.77,0:11:31.44,Default,,0,0,0,,Мен ағамды тоқтата алмадым.
Dialogue: 0,0:11:31.52,0:11:34.56,Default,,0,0,0,,Ағам мені тірі қалдырды
Dialogue: 0,0:11:34.65,0:11:37.82,Default,,0,0,0,,Адамдар тек ойыншық немесе ойын ретінде қарастырылады
Dialogue: 0,0:11:38.44,0:11:42.82,Default,,0,0,0,,Егер менде басқаларға кішкене болса да жанашырлық болса...
Dialogue: 0,0:11:43.78,0:11:46.45,Default,,0,0,0,,Йоичидің еркі менің ішімде
Dialogue: 0,0:11:46.54,0:11:49.45,Default,,0,0,0,,Ол әлі де бар ма?
Dialogue: 0,0:11:49.54,0:11:53.38,Default,,0,0,0,,Өзгелерге сәл ғана жанашырлық танытсам ғой
Dialogue: 0,0:11:53.46,0:11:55.63,Default,,0,0,0,,Беру немесе алу
Dialogue: 0,0:11:55.71,0:12:01.01,Default,,0,0,0,,Бұл әлемдегі ең жұмсақ күшке айналуы мүмкін еді.
Dialogue: 0,0:12:04.05,0:12:06.72,Default,,0,0,0,,Егер мен көз жасымды шығарсам, бұл мені жынды етеді, сондықтан мен оларды шығардым.
Dialogue: 0,0:12:06.72,0:12:08.47,Default,,0,0,0,,Көз жасымды шығарсам, бұл мені жынды етеді, сондықтан мен оларды шығардым.
Dialogue: 0,0:12:06.72,0:12:08.47,Default,,0,0,0,,(мойынның сынған дыбысы)
Dialogue: 0,0:12:08.56,0:12:13.56,Default,,0,0,0,,Өзіңізге ұнамайтын және өзіңіз қалаған нәрсені манипуляциялау және кемсіту
Dialogue: 0,0:12:13.65,0:12:16.48,Default,,0,0,0,,Мен оны осылай алдым
Dialogue: 0,0:12:19.07,0:12:21.53,Default,,0,0,0,,Бірақ сіз...
Dialogue: 0,0:12:24.28,0:12:27.66,Default,,0,0,0,,Бұл менің жолым емес
Dialogue: 0,0:12:27.74,0:12:29.83,Default,,0,0,0,,Мен мұны қалаймын
Dialogue: 0,0:12:30.79,0:12:34.21,Default,,0,0,0,,Мен оны қусам да, қусам да
Dialogue: 0,0:12:34.29,0:12:37.63,Default,,0,0,0,,Қолымнан тайып кетті
Dialogue: 0,0:12:39.55,0:12:42.17,Default,,0,0,0,,Иә
Dialogue: 0,0:12:42.76,0:12:47.64,Default,,0,0,0,,Бұл сен кінәлісің, Кандо!
Dialogue: 0,0:12:48.14,0:12:51.85,Default,,0,0,0,,Канто: Оның қандас туыстары жойылды.
Dialogue: 0,0:12:51.93,0:12:53.27,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:12:53.35,0:12:59.15,Default,,0,0,0,,Оған жақын болған барлық әйелдер мен балалар күдікті!
Dialogue: 0,0:12:59.23,0:13:01.61,Default,,0,0,0,,Егер бұл оның қаны болса
Dialogue: 0,0:13:01.69,0:13:05.16,Default,,0,0,0,,Мен сол кезде бірдеңені сезсем керек.
Dialogue: 0,0:13:05.24,0:13:09.95,Default,,0,0,0,,Көздер... ол кезде әлі ол көздер емес еді.
Dialogue: 0,0:13:10.04,0:13:12.04,Default,,0,0,0,,Бұл тек бос ұқсастық.
Dialogue: 0,0:13:12.12,0:13:15.83,Default,,0,0,0,,Бірақ қазір ол кісінің ерік-жігеріне ұқсас ерік бар екені сөзсіз.
Dialogue: 0,0:13:15.92,0:13:21.55,Default,,0,0,0,,Уақыт пен кеңістіктен тыс, ол мені бөгеп тұр.
Dialogue: 0,0:13:23.26,0:13:25.80,Default,,0,0,0,,Оны бұрылыс арқылы күштеп жұлып алған сияқты.
Dialogue: 0,0:13:26.64,0:13:30.81,Default,,0,0,0,,Бүкіл Құдірет-қа көшіруге болатын нүкте жақын жерде ме?
Dialogue: 0,0:13:31.89,0:13:34.56,Default,,0,0,0,,Тек жерлеу орны бар.
Dialogue: 0,0:13:34.64,0:13:39.81,Default,,0,0,0,,Біз енді шайқасқа қатыса алмаймыз және өзімізді азайта алмаймыз.
Dialogue: 0,0:13:40.44,0:13:45.61,Default,,0,0,0,,Мен жерлеу үйіне жетсем де, ол мені қабылдамады.
Dialogue: 0,0:13:45.70,0:13:47.82,Default,,0,0,0,,Қақтығыс болмай қоймайды
Dialogue: 0,0:13:47.91,0:13:53.70,Default,,0,0,0,,Тасымалдауды жүзеге асыру үшін артық қуатты қалдыру керек
Dialogue: 0,0:13:54.25,0:13:58.96,Default,,0,0,0,,...Мен солай ойладым, бірақ бұл жеткілікті.
Dialogue: 0,0:13:59.83,0:14:05.67,Default,,0,0,0,,Сізді өлтіру, мақсат және беру
Dialogue: 0,0:14:05.76,0:14:08.68,Default,,0,0,0,,Барлығы бірден
Dialogue: 0,0:14:11.47,0:14:12.76,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:14:13.97,0:14:16.69,Default,,0,0,0,,Барлық себептер бойынша босату
Dialogue: 0,0:14:18.56,0:14:21.15,Default,,0,0,0,,Ол ауыр қылмыс жасамаған, бірақ—
Dialogue: 0,0:14:21.23,0:14:24.90,Default,,0,0,0,,Барлығы бір мақсат үшін!
Dialogue: 0,0:14:24.99,0:14:27.15,Default,,0,0,0,,Басыңыз!
Dialogue: 0,0:14:30.62,0:14:33.83,Default,,0,0,0,,Осы орасан зор энергияны қозғалысқа айналдырыңыз!?
Dialogue: 0,0:14:33.91,0:14:36.71,Default,,0,0,0,,Мен барлығын бірден өз қолыма аламын деп отырмын.
Dialogue: 0,0:14:37.58,0:14:39.50,Default,,0,0,0,,Сәбилікке қайта оралу
Dialogue: 0,0:14:39.58,0:14:41.75,Default,,0,0,0,,Сіз құмар ойын ойнадыңыз ба?
Dialogue: 0,0:14:42.46,0:14:43.92,Default,,0,0,0,,О... дұрыс.
Dialogue: 0,0:14:44.00,0:14:49.26,Default,,0,0,0,,Жеңіске жетудің жолы жоқ.
Dialogue: 0,0:14:49.34,0:14:53.14,Default,,0,0,0,,Мен бәрін өзім үшін алып, жоғары көтерілемін.
Dialogue: 0,0:14:53.72,0:14:58.27,Default,,0,0,0,,Менің «жарылысым» мен қалаған нәрсені жасай алады.
Dialogue: 0,0:14:58.98,0:15:00.65,Default,,0,0,0,,Соғыс күші жағынан олар сөзсіз сенімді.
Dialogue: 0,0:15:00.73,0:15:04.90,Default,,0,0,0,,Мен сені енді мазаламаймын
Dialogue: 0,0:15:10.91,0:15:13.37,Default,,0,0,0,,Додж, балам!
Dialogue: 0,0:15:16.24,0:15:17.45,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:15:18.46,0:15:21.50,Default,,0,0,0,,Hazero Hazero!
Dialogue: 0,0:15:21.58,0:15:22.92,Default,,0,0,0,,Hazero!
Dialogue: 0,0:15:23.46,0:15:25.05,Default,,0,0,0,,Гррр... Уф... Грр!
Dialogue: 0,0:15:25.67,0:15:26.55,Default,,0,0,0,,Мен білмейтін қыз…➡
Dialogue: 0,0:15:27.21,0:15:31.30,Default,,0,0,0,,Ол дәл қазір ешқандай мінез көрсетпеуі керек еді.
Dialogue: 0,0:15:38.56,0:15:41.23,Default,,0,0,0,,Жаңбырда қуат түседі.
Dialogue: 0,0:15:41.31,0:15:44.06,Default,,0,0,0,,Қаптап, ұшып кетті
Dialogue: 0,0:15:44.15,0:15:48.36,Default,,0,0,0,,Жарылғыш тер тамшылары кәдімгі тер тамшыларымен алмасады.
Dialogue: 0,0:15:48.44,0:15:52.91,Default,,0,0,0,,Уақыт айырмашылығына байланысты араласып, бомбаны іске қоспай ұшсын
Dialogue: 0,0:15:52.99,0:15:56.79,Default,,0,0,0,,Басқа тітіркендіргіштерден туындаған детонация
Dialogue: 0,0:15:56.87,0:15:58.04,Default,,0,0,0,,Сол кезде!
Dialogue: 0,0:15:58.70,0:16:02.58,Default,,0,0,0,,Менің аузымда? Сол соңғы минутта!?
Dialogue: 0,0:16:03.46,0:16:07.80,Default,,0,0,0,,Мені жақсы талғамым үшін мақтады!
Dialogue: 0,0:16:08.46,0:16:12.51,Default,,0,0,0,,Бір «индивидуалдылық» жеткілікті!
Dialogue: 0,0:16:13.80,0:16:16.64,Default,,0,0,0,,Зақым алғанда жасартады.
Dialogue: 0,0:16:17.26,0:16:18.52,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:16:21.60,0:16:24.52,Default,,0,0,0,,Зақымданған қуат
Dialogue: 0,0:16:24.60,0:16:27.02,Default,,0,0,0,,Қайтадан босатыңыз
Dialogue: 0,0:16:28.19,0:16:29.73,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:30.40,0:16:33.24,Default,,0,0,0,,Бұл менің оқиғам!
Dialogue: 0,0:16:33.32,0:16:35.95,Default,,0,0,0,,Жолдан кет! Моб!
Dialogue: 0,0:16:36.03,0:16:39.12,Default,,0,0,0,,Хаузер
Dialogue: 0,0:16:43.33,0:16:46.71,Default,,0,0,0,,Әсер!
Dialogue: 0,0:16:53.80,0:16:56.18,Default,,0,0,0,,Ку... уф... ха!
Dialogue: 0,0:16:56.26,0:16:59.18,Default,,0,0,0,,...
Dialogue: 0,0:16:59.26,0:17:03.44,Default,,0,0,0,,Дараааааа!
Dialogue: 0,0:17:05.35,0:17:07.94,Default,,0,0,0,,Бұл тітіркендіргіш...
Dialogue: 0,0:17:08.02,0:17:12.57,Default,,0,0,0,,Ооооооооо!
Dialogue: 0,0:17:12.65,0:17:17.16,Default,,0,0,0,,Біртүрлі факторлардың комбинациясы жақсы болмайды
Dialogue: 0,0:17:17.24,0:17:22.20,Default,,0,0,0,,Мұндай жарылыс салдарынан мұндай нәрсенің құлауы мүмкін емес.
Dialogue: 0,0:17:22.95,0:17:26.33,Default,,0,0,0,,Менің денем жас, нәзік болғандықтан ба?
Dialogue: 0,0:17:26.42,0:17:28.17,Default,,0,0,0,,Жағымсыз эмоциялардың жетегінде кету
Dialogue: 0,0:17:28.25,0:17:30.88,Default,,0,0,0,,Бақылау құқығы әлсірейді.
Dialogue: 0,0:17:31.42,0:17:33.13,Default,,0,0,0,,Сонымен
Dialogue: 0,0:17:33.21,0:17:36.30,Default,,0,0,0,,Бұл менің фанаттар кездесу орным болады.
Dialogue: 0,0:17:36.38,0:17:37.89,Default,,0,0,0,,Тоқтат. Жетті. Іздерме оны.
Dialogue: 0,0:17:37.97,0:17:38.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:39.89,0:17:42.43,Default,,0,0,0,,Құрылған ағаш жұтқан
Dialogue: 0,0:17:53.61,0:17:54.94,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:55.03,0:17:57.70,Default,,0,0,0,,Бұл менің оқиғам!
Dialogue: 0,0:17:58.53,0:18:00.20,Default,,0,0,0,,Сукуна соған тұрарлық.
Dialogue: 0,0:18:01.62,0:18:03.62,Default,,0,0,0,,Бұл олай емес еді.
Dialogue: 0,0:18:04.83,0:18:06.83,Default,,0,0,0,,Мен жалғыз емес едім
Dialogue: 0,0:18:08.25,0:18:09.83,Default,,0,0,0,,Бұл дене де
Dialogue: 0,0:18:11.46,0:18:14.13,Default,,0,0,0,,Менімен байланысқан өмір
Dialogue: 0,0:18:15.59,0:18:16.80,Default,,0,0,0,,Армандар
Dialogue: 0,0:18:18.30,0:18:20.14,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:18:21.43,0:18:25.56,Default,,0,0,0,,Бұл біздің тарихымыз!
Dialogue: 0,0:18:33.78,0:18:35.69,Default,,0,0,0,,Барлығы аздап берді—
Dialogue: 0,0:18:35.78,0:18:38.45,Default,,0,0,0,,Зақымдану және тітіркену
Dialogue: 0,0:18:39.16,0:18:40.78,Default,,0,0,0,,Сені махаббат сиқырымен баурап алатын боламын.
Dialogue: 0,0:18:42.66,0:18:46.54,Default,,0,0,0,,Бұл жолы бәрі бір...
Dialogue: 0,0:18:49.37,0:18:54.05,Default,,0,0,0,,Менің жалғыз жеңу мүмкін емес...
Dialogue: 0,0:18:54.63,0:18:57.88,Default,,0,0,0,,Сәл әрі қарай
Dialogue: 0,0:18:57.97,0:19:01.55,Default,,0,0,0,,Менің «даралығымды» Жоқтауға көшіру
Dialogue: 0,0:19:01.64,0:19:05.81,Default,,0,0,0,,Жұтылып кететін екінші жағындағы қызметшіні күшейтіңіз.
Dialogue: 0,0:19:05.89,0:19:08.56,Default,,0,0,0,,Бұл ең зұлым ақыл мен дене
Dialogue: 0,0:19:09.56,0:19:12.36,Default,,0,0,0,,Қайтадан үстемдік ету
Dialogue: 0,0:19:12.44,0:19:16.11,Default,,0,0,0,,Жерлеудің жағдайына қарап, И
Dialogue: 0,0:19:16.19,0:19:19.61,Default,,0,0,0,,Бұл картаны кеспей орындалған болуы керек.
Dialogue: 0,0:19:19.70,0:19:22.41,Default,,0,0,0,,Жеңіске әлі де мүмкіндік бар
Dialogue: 0,0:19:22.49,0:19:26.37,Default,,0,0,0,,Егер сіз жерлеуді басқара алсаңыз, «Біреуі бәрі үшін» алып тастай аласыз.
Dialogue: 0,0:19:27.37,0:19:31.50,Default,,0,0,0,,Йоичи, сенсіз мен жақсы емеспін.
Dialogue: 0,0:19:31.58,0:19:35.75,Default,,0,0,0,,Сізге ұнамайтын нәрселерді жақсырақ есте сақтайсыз, солай емес пе?
Dialogue: 0,0:19:35.84,0:19:39.01,Default,,0,0,0,,Сондықтан да сіз адамдардың болашағына тосқауыл қоясыз.
Dialogue: 0,0:19:40.30,0:19:42.76,Default,,0,0,0,,Йоичи I...
Dialogue: 0,0:19:44.01,0:19:48.27,Default,,0,0,0,,Мен барлығының қарап тұрғанын қалаймын.
Dialogue: 0,0:19:49.31,0:19:51.77,Default,,0,0,0,,Тағы да...
Dialogue: 0,0:19:52.94,0:19:58.03,Default,,0,0,0,,Әлі жоғалған жоқ...
Dialogue: 0,0:19:58.11,0:19:59.99,Default,,0,0,0,,Ха-ха... Уф
Dialogue: 0,0:20:01.99,0:20:05.91,Default,,0,0,0,,Суық, күшім жоқ.
Dialogue: 0,0:20:05.99,0:20:08.41,Default,,0,0,0,,Мен тұра алмаймын.
Dialogue: 0,0:20:09.54,0:20:09.87,Default,,0,0,0,,Уаааааааааааааааа...
Dialogue: 0,0:20:09.87,0:20:10.79,Default,,0,0,0,,Уаааааааааааааааа...
Dialogue: 0,0:20:09.87,0:20:10.79,Default,,0,0,0,,Жолдан кет!
Dialogue: 0,0:20:10.79,0:20:11.54,Default,,0,0,0,,Уаааааааааааааааа...
Dialogue: 0,0:20:11.54,0:20:13.75,Default,,0,0,0,,Уаааааааааааааааа...
Dialogue: 0,0:20:11.54,0:20:13.75,Default,,0,0,0,,Мен сөз таппай қалдым
Dialogue: 0,0:20:13.75,0:20:14.75,Default,,0,0,0,,Мен қазірдің өзінде сөз таппай қалдым
Dialogue: 0,0:20:15.42,0:20:19.21,Default,,0,0,0,,Жаңа туған, бәрібір.
Dialogue: 0,0:20:19.30,0:20:22.13,Default,,0,0,0,,Жалғыз қалдырсаңыз да жоғалады
Dialogue: 0,0:20:23.47,0:20:24.89,Default,,0,0,0,,Құлап кетпеу нені білдіреді?
Dialogue: 0,0:20:25.68,0:20:27.26,Default,,0,0,0,,Күшті.
Dialogue: 0,0:20:27.35,0:20:29.06,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:29.14,0:20:31.02,Default,,0,0,0,,Қауіп...
Dialogue: 0,0:20:31.73,0:20:36.27,Default,,0,0,0,,Толық жеңіске жетпесек... Эй!?
Dialogue: 0,0:20:36.36,0:20:38.27,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:20:36.36,0:20:38.27,Default,,0,0,0,,Ахх!
Dialogue: 0,0:20:47.16,0:20:52.37,Default,,0,0,0,,Ұйықтау уақыты келді Барлығы бір үшін
Dialogue: 0,0:20:52.46,0:20:53.41,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:20:54.12,0:20:57.04,Default,,0,0,0,,Мен өз сезімдерімді басқарды.
Dialogue: 0,0:20:57.13,0:20:59.67,Default,,0,0,0,,Бұл мен емес
Dialogue: 0,0:21:00.30,0:21:04.38,Default,,0,0,0,,Маған ұнамайды, маған ұнамайды, маған ұнамайды, маған ұнамайды, маған ұнамайды, маған ұнамайды, маған ұнамайды!
Dialogue: 0,0:21:00.30,0:21:04.38,Default,,0,0,0,,(Барлығы бір адамның алақайы үшін)
Dialogue: 0,0:21:04.38,0:21:04.47,Default,,0,0,0,,(Барлығы бір адамның алақайы үшін)
Dialogue: 0,0:21:04.47,0:21:05.30,Default,,0,0,0,,(Барлығы бір адамның жылағаны үшін)
Dialogue: 0,0:21:04.47,0:21:05.30,Default,,0,0,0,,Жек көру Жек көру Жек көру Жек көру Жек көру Жек көру Жек көру!
Dialogue: 0,0:21:05.30,0:21:09.93,Default,,0,0,0,,Жек көру Жек көру Жек көру Жек көру Жек көру Жек көру Жек көру!
Dialogue: 0,0:21:11.56,0:21:15.90,Default,,0,0,0,,Ұрланған фактор иесіне қайтарылады...
Dialogue: 0,0:21:16.81,0:21:21.48,Default,,0,0,0,,Ондай қызмет бар емес пе?
Dialogue: 0,0:21:32.16,0:21:35.08,Default,,0,0,0,,Әй...
Dialogue: 0,0:21:35.16,0:21:37.67,Default,,0,0,0,,Мен Бүкіл Құдірет's standing орындағым келді.
Dialogue: 0,0:21:37.67,0:21:39.25,Default,,0,0,0,,Мен Бүкіл Құдірет's standing орындағым келді.
Dialogue: 0,0:21:37.67,0:21:39.25,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:21:39.25,0:21:41.46,Default,,0,0,0,,Мен Бүкіл Құдірет's standing орындағым келді.
Dialogue: 0,0:21:44.76,0:21:46.22,Default,,0,0,0,,Соғыс күші жағынан олар сөзсіз сенімді.
Dialogue: 0,0:21:47.22,0:21:48.93,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз
Dialogue: 0,0:21:51.06,0:21:56.06,Default,,0,0,0,,♪～
Dialogue: 0,0:23:15.06,0:23:20.06,Default,,0,0,0,,～♪
Dialogue: 0,0:23:21.90,0:23:22.94,Default,,0,0,0,,Мен бұны реттеймін
Dialogue: 0,0:23:23.73,0:23:25.94,Default,,0,0,0,,Барлығы бір үшін жойылды
Dialogue: 0,0:23:26.03,0:23:31.24,Default,,0,0,0,,Бірақ өлі ағашпен кескілескен шайқас кезінде ең жаманы болады.
Dialogue: 0,0:23:31.32,0:23:35.87,Default,,0,0,0,,«Біреуі бәрі үшін»... жоқ, кейінгі мұрагерлердің бірінің «даралығы»
Dialogue: 0,0:23:36.58,0:23:39.21,Default,,0,0,0,,Оны қураған ағаш ұрлап кеткен.
Dialogue: 0,0:23:40.04,0:23:43.00,Default,,0,0,0,,Келесі жолы «Тарихтағы ең қас жау (зұлым)»
Dialogue: 0,0:23:43.08,0:23:46.96,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса, Мидория Изуку!
Dialogue: 0,0:23:47.05,0:23:50.97,Default,,0,0,0,,Әрі қарай!Plus Ultra!
Dialogue: 0,0:23:52.47,0:23:58.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
