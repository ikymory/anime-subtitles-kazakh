Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.91,0:00:03.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:03.29,0:00:05.25,Default,,0,0,0,,Махаббатты сүйіңіз~!
Dialogue: 0,0:00:05.33,0:00:07.25,Default,,0,0,0,,Жұмсақ~!
Dialogue: 0,0:00:07.34,0:00:09.51,Default,,0,0,0,,Лаваны жақсы көру Лаваны жақсы көру ~
Dialogue: 0,0:00:09.59,0:00:10.34,Default,,0,0,0,,Нәзік ~ Махаббат Махаббат ~
Dialogue: 0,0:00:10.34,0:00:12.72,Default,,0,0,0,,Жұмсақ ~ Лаваны сүйемін ~
Dialogue: 0,0:00:10.34,0:00:12.72,Default,,0,0,0,,Бұл сіздің күш-жігеріңізді мойындаудың бір түрі.
Dialogue: 0,0:00:12.72,0:00:12.80,Default,,0,0,0,,Жұмсақ ~ Лаваны сүйемін ~
Dialogue: 0,0:00:12.80,0:00:13.26,Default,,0,0,0,,Жұмсақ ~ Лаваны сүйемін ~
Dialogue: 0,0:00:12.80,0:00:13.26,Default,,0,0,0,,Шебер болыңыз
Dialogue: 0,0:00:13.26,0:00:13.88,Default,,0,0,0,,Шебер болыңыз
Dialogue: 0,0:00:13.88,0:00:14.80,Default,,0,0,0,,Шебер болыңыз
Dialogue: 0,0:00:13.88,0:00:14.80,Default,,0,0,0,,Gentle өте керемет болғанына рахмет!
Dialogue: 0,0:00:14.80,0:00:16.14,Default,,0,0,0,,Gentle өте керемет болғанына рахмет!
Dialogue: 0,0:00:16.22,0:00:19.01,Default,,0,0,0,,Махаббат лавасы керемет болды
Dialogue: 0,0:00:19.68,0:00:20.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:20.93,0:00:23.19,Default,,0,0,0,,Маған кетуге болатынын айтса да.
Dialogue: 0,0:00:23.27,0:00:24.52,Default,,0,0,0,,Келмейсің бе?
Dialogue: 0,0:00:24.60,0:00:26.48,Default,,0,0,0,,«Әлі жоқ» «Әлі жоқ»
Dialogue: 0,0:00:26.56,0:00:28.19,Default,,0,0,0,,Шабадан әлі қорқамын
Dialogue: 0,0:00:28.27,0:00:31.61,Default,,0,0,0,,Қайта қолдануға және қайталауға болады
Dialogue: 0,0:00:31.69,0:00:34.70,Default,,0,0,0,,Мен сенің маған әртүрлі істерде көмектесуіңді қаладым.
Dialogue: 0,0:00:35.49,0:00:36.32,Default,,0,0,0,,Сол күні
Dialogue: 0,0:00:36.91,0:00:39.91,Default,,0,0,0,,Изуку Мидория әлемге не көрсетті
Dialogue: 0,0:00:39.99,0:00:42.58,Default,,0,0,0,,Қоғам қалай қабылдайды және өзгереді?
Dialogue: 0,0:00:42.66,0:00:45.46,Default,,0,0,0,,Оны анықтағаннан кейін
Dialogue: 0,0:00:46.08,0:00:49.34,Default,,0,0,0,,Мен салықтарыммен тағы біраз уақыт жей аламын.
Dialogue: 0,0:00:49.42,0:00:51.71,Default,,0,0,0,,Ей, жау (жауыз).
Dialogue: 0,0:00:51.80,0:00:53.09,Default,,0,0,0,,Иә
Dialogue: 0,0:00:54.05,0:00:59.05,Default,,0,0,0,,♪～
Dialogue: 0,0:02:17.22,0:02:22.22,Default,,0,0,0,,～♪
Dialogue: 0,0:02:26.89,0:02:28.89,Default,,0,0,0,,Бұл қорқынышты болды
Dialogue: 0,0:02:28.98,0:02:31.15,Default,,0,0,0,,Одан құтылғаныңызға өте қуаныштымын.
Dialogue: 0,0:02:31.23,0:02:33.52,Default,,0,0,0,,Бір досым қайтыс болды.
Dialogue: 0,0:02:33.61,0:02:35.82,Default,,0,0,0,,Ең нашар өлтіруші
Dialogue: 0,0:02:35.90,0:02:36.86,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:02:36.94,0:02:38.90,Default,,0,0,0,,Шынымды айтсам, менің өмірім бейберекет.
Dialogue: 0,0:02:38.99,0:02:40.66,Default,,0,0,0,,Үй қираған.
Dialogue: 0,0:02:40.74,0:02:43.58,Default,,0,0,0,,Мен оны тоқтата алмадым ба деп ойлаймын...
Dialogue: 0,0:02:43.66,0:02:45.16,Default,,0,0,0,,Эй
Dialogue: 0,0:02:45.66,0:02:47.25,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:02:47.33,0:02:49.16,Default,,0,0,0,,Басында ол жай ғана бұзақы болды.
Dialogue: 0,0:02:49.25,0:02:51.13,Default,,0,0,0,,үшін ойланып қалды
Dialogue: 0,0:02:51.21,0:02:54.09,Default,,0,0,0,,Бұндай қауіп болады деп ешкім күтпеген.
Dialogue: 0,0:02:54.88,0:02:57.09,Default,,0,0,0,,Халықаралық қолдаумен және еріктілермен
Dialogue: 0,0:02:57.17,0:02:59.72,Default,,0,0,0,,Қалпына келтіру жұмыстары қарқынды жүріп жатыр
Dialogue: 0,0:02:59.80,0:03:04.97,Default,,0,0,0,,Алайда, керісінше, қалпына келтіру жұмыстары уақытында аяқталмаған жерлер де бар...
Dialogue: 0,0:03:05.56,0:03:07.60,Default,,0,0,0,,Қалың үйілген қоқыс
Dialogue: 0,0:03:07.68,0:03:11.56,Default,,0,0,0,,Бұл залалдың қаншалықты кең тарағанын көрсетеді
Dialogue: 0,0:03:12.15,0:03:13.81,Default,,0,0,0,,Көптеген адамдарды қатыстырыңыз
Dialogue: 0,0:03:13.90,0:03:16.73,Default,,0,0,0,,Бұрын-соңды болмаған терроризмді тудырған жау (зұлым) коалициясы
Dialogue: 0,0:03:16.73,0:03:17.57,Default,,0,0,0,,Бұрын-соңды болмаған лаңкестік тудырған жау (зұлым) коалициясы
Dialogue: 0,0:03:16.73,0:03:17.57,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:17.57,0:03:17.65,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:17.65,0:03:18.07,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:17.65,0:03:18.07,Default,,0,0,0,,Сол көсем Шигарагидің жерлеу рәсімі қандай болды?
Dialogue: 0,0:03:18.07,0:03:21.36,Default,,0,0,0,,Сол көсем Шигарагидің жерлеу рәсімі қандай болды?
Dialogue: 0,0:03:22.36,0:03:25.41,Default,,0,0,0,,Біз сізге екінші арнайы мүмкіндікті жібереміз.
Dialogue: 0,0:03:31.12,0:03:33.46,Default,,0,0,0,,Алып дене мен таразының көптеген «даралығын» көтере алмау —
Dialogue: 0,0:03:33.54,0:03:35.96,Default,,0,0,0,,Мен миымды жоғалтудың алдында тұрдым.
Dialogue: 0,0:03:36.05,0:03:40.05,Default,,0,0,0,,Біз біраз уақыттан бері мисыз зерттеу жүргіздік.
Dialogue: 0,0:03:40.13,0:03:45.01,Default,,0,0,0,,Прогресс әлі таяз болды, сондықтан ол әрең басылды.
Dialogue: 0,0:03:45.55,0:03:48.89,Default,,0,0,0,,Неге келдің, қанішер?
Dialogue: 0,0:03:48.97,0:03:50.68,Default,,0,0,0,,Мен оны жоққа шығармаймын
Dialogue: 0,0:03:50.77,0:03:53.48,Default,,0,0,0,,Мен Шигаракидің соңғы сәттерін айту үшін келдім.
Dialogue: 0,0:03:53.56,0:03:57.90,Default,,0,0,0,,Өлгендерді атуға келдің бе? Қарғыс атқыр, бұл жағымсыз дәм.
Dialogue: 0,0:03:58.65,0:04:01.15,Default,,0,0,0,,Өйткені мен тірімін... Мен саған айтамын
Dialogue: 0,0:04:02.53,0:04:06.83,Default,,0,0,0,,Шигараки Соу оны жою үшін соңына дейін күресті.
Dialogue: 0,0:04:08.95,0:04:10.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:11.75,0:04:14.88,Default,,0,0,0,,Шигараки саған осылай айт деп айтты ма?
Dialogue: 0,0:04:14.96,0:04:16.38,Default,,0,0,0,,Спиннерде
Dialogue: 0,0:04:17.34,0:04:18.59,Default,,0,0,0,,Мен?
Dialogue: 0,0:04:18.67,0:04:20.51,Default,,0,0,0,,Тога мен Даби үшін де?
Dialogue: 0,0:04:20.59,0:04:21.88,Default,,0,0,0,,Компрессорлар ше?
Dialogue: 0,0:04:22.68,0:04:24.55,Default,,0,0,0,,Сіз жалғыз болдыңыз
Dialogue: 0,0:04:24.64,0:04:26.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:31.77,0:04:35.77,Default,,0,0,0,,Құрылған ағаш... үміт еді.
Dialogue: 0,0:04:36.27,0:04:39.11,Default,,0,0,0,,Ол күліп: «Бәрін құртайық» деді.
Dialogue: 0,0:04:39.19,0:04:41.90,Default,,0,0,0,,Балшық гүлдер маған бұрмаланған көкжиекті көрсетті
Dialogue: 0,0:04:41.99,0:04:45.49,Default,,0,0,0,,Ол менің спикерім болды.
Dialogue: 0,0:04:46.07,0:04:50.95,Default,,0,0,0,,Мен қысымға ұшыраған кезімде де мен бас тарттым және «Мен жай ғана ақымақпын» деп ойладым.
Dialogue: 0,0:04:51.54,0:04:54.21,Default,,0,0,0,,Сен маған осындай түс көрсеттің
Dialogue: 0,0:04:54.29,0:04:57.46,Default,,0,0,0,,Мүмкін біз үлкен нәрсе істей аламыз
Dialogue: 0,0:04:57.54,0:04:59.00,Default,,0,0,0,,Өзіңізді қатты итермеңіз
Dialogue: 0,0:04:57.54,0:04:59.00,Default,,0,0,0,,Мүмкін мен біреу бола алармын!
Dialogue: 0,0:04:59.00,0:04:59.09,Default,,0,0,0,,Мүмкін мен біреу бола алармын!
Dialogue: 0,0:04:59.09,0:05:00.59,Default,,0,0,0,,Мүмкін мен біреу бола алармын!
Dialogue: 0,0:04:59.09,0:05:00.59,Default,,0,0,0,,Дереу ұстаныңыз... Ах.
Dialogue: 0,0:05:02.80,0:05:06.18,Default,,0,0,0,,Шигараки Соу менің кейіпкерім еді!
Dialogue: 0,0:05:06.26,0:05:09.81,Default,,0,0,0,,Мақсаты жою болып табылатын жою әрекеті дегеніміз не?
Dialogue: 0,0:05:09.89,0:05:12.60,Default,,0,0,0,,Себеп жоқ, идея жоқ, жай ғана ашу.
Dialogue: 0,0:05:12.68,0:05:16.06,Default,,0,0,0,,Маған ойын ұнады...
Dialogue: 0,0:05:16.15,0:05:17.98,Default,,0,0,0,,Полиция тергеуі жалғасуда
Dialogue: 0,0:05:18.06,0:05:20.36,Default,,0,0,0,,Қайғылы өткен күн де жарыққа шығады.
Dialogue: 0,0:05:20.44,0:05:25.24,Default,,0,0,0,,Мен жабық тұрғанда мен жай ғана ойын ойнадым.
Dialogue: 0,0:05:25.32,0:05:27.70,Default,,0,0,0,,Себебін зерттеу маңызды
Dialogue: 0,0:05:27.78,0:05:32.20,Default,,0,0,0,,Егер сентиментальды болсақ, шабыттанған адамдар қайтадан пайда болады.
Dialogue: 0,0:05:32.29,0:05:33.12,Default,,0,0,0,,қайталаймын
Dialogue: 0,0:05:33.20,0:05:35.16,Default,,0,0,0,,Сонда ол болды.
Dialogue: 0,0:05:35.25,0:05:37.96,Default,,0,0,0,,Біз ойнайтын ойындар шамамен бірдей.
Dialogue: 0,0:05:38.04,0:05:38.88,Default,,0,0,0,,Біз—
Dialogue: 0,0:05:38.96,0:05:42.25,Default,,0,0,0,,Оны нық көзқараспен айту керек.
Dialogue: 0,0:05:42.34,0:05:43.71,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:05:45.01,0:05:49.43,Default,,0,0,0,,Мен алғаш рет... дос таптым.
Dialogue: 0,0:05:50.35,0:05:53.77,Default,,0,0,0,,Олар мен олардың кейіпкері болуым керек деді.
Dialogue: 0,0:05:53.85,0:05:58.02,Default,,0,0,0,,Шигаракидің жүрегінің ортасында жаулар (жауыздар) коалициясы болды.
Dialogue: 0,0:05:58.10,0:06:01.40,Default,,0,0,0,,Шигаракидің де дәл осылай ойлағанына сенімдімін.
Dialogue: 0,0:06:01.48,0:06:04.23,Default,,0,0,0,,Мен сізге айтқым келді деп ойлаймын
Dialogue: 0,0:06:07.07,0:06:09.53,Default,,0,0,0,,Жылу әсерінен
Dialogue: 0,0:06:09.62,0:06:13.58,Default,,0,0,0,,«Ағынды тоқтату мүмкін емес» деген ойды қойдым.
Dialogue: 0,0:06:14.24,0:06:18.92,Default,,0,0,0,,Мен өзім сияқты адам ретінде кеш түсіндім.
Dialogue: 0,0:06:20.04,0:06:22.25,Default,,0,0,0,,Егер мен тағы бір қадам жасасам
Dialogue: 0,0:06:23.42,0:06:27.93,Default,,0,0,0,,Мен өз кейіпкерімді құтқара алдым ба?
Dialogue: 0,0:06:28.51,0:06:30.05,Default,,0,0,0,,Енді және қайта
Dialogue: 0,0:06:30.14,0:06:32.26,Default,,0,0,0,,Екінші және үшінші өлі ағаш және үшін бір үшін
Dialogue: 0,0:06:32.35,0:06:34.77,Default,,0,0,0,,Сіз деміңізді ұстап тұрған шығарсыз
Dialogue: 0,0:06:34.85,0:06:36.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:36.10,0:06:39.02,Default,,0,0,0,,Біз назарымызды келесі қауіпке аударуымыз керек.
Dialogue: 0,0:06:39.10,0:06:40.56,Default,,0,0,0,,(орындықтан тұру дыбысы)
Dialogue: 0,0:06:43.94,0:06:48.20,Default,,0,0,0,,Балалар, күресуді жалғастыра бересіңдер ме?
Dialogue: 0,0:06:48.86,0:06:50.28,Default,,0,0,0,,Соңында
Dialogue: 0,0:06:50.36,0:06:55.20,Default,,0,0,0,,Шигараги жерлеу мен жау (жауыз) одағын ұмытып күледі.
Dialogue: 0,0:06:56.45,0:06:57.58,Default,,0,0,0,,Кітап жазу
Dialogue: 0,0:06:57.66,0:06:58.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:58.87,0:07:02.46,Default,,0,0,0,,Өлім ағашы Жоқтау деп аталатын қорқыныш символы...
Dialogue: 0,0:07:02.54,0:07:05.46,Default,,0,0,0,,Жау (зұлым) коалициясы жою үшін өмір сүрді.
Dialogue: 0,0:07:05.55,0:07:08.80,Default,,0,0,0,,Мен сені мәңгілікке қарсы аламын
Dialogue: 0,0:07:09.93,0:07:11.97,Default,,0,0,0,,Өткен өшпейді
Dialogue: 0,0:07:12.05,0:07:15.10,Default,,0,0,0,,Мен өлген ағашпын, Жаназа жырын тоқып
Dialogue: 0,0:07:17.10,0:07:18.60,Default,,0,0,0,,Мен бұл комикс деп үміттенемін
Dialogue: 0,0:07:18.68,0:07:19.81,Default,,0,0,0,,Ах!?
Dialogue: 0,0:07:19.89,0:07:21.73,Default,,0,0,0,,(Токуда) Бастапқыда U.A.-ның «Үлкен үштігінің» бірі —
Dialogue: 0,0:07:23.27,0:07:25.32,Default,,0,0,0,,Мен ешқашан ұмытпаймын
Dialogue: 0,0:07:33.03,0:07:33.91,Default,,0,0,0,,Хун
Dialogue: 0,0:07:33.99,0:07:36.29,Default,,0,0,0,,Менің де хабарым бар.
Dialogue: 0,0:07:36.37,0:07:39.16,Default,,0,0,0,,Сегізаяққа қолыңнан келгеннің бәрін істе деп айт
Dialogue: 0,0:07:41.67,0:07:45.75,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:07:45.84,0:07:47.67,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:07:47.75,0:07:51.93,Default,,0,0,0,,Кейбір иллюстрациялар болуы мүмкін.
Dialogue: 0,0:07:52.63,0:07:56.81,Default,,0,0,0,,Кескіндеме білім мен шекарадан асып түседі
Dialogue: 0,0:07:57.51,0:07:59.43,Default,,0,0,0,,Қош келдің бала
Dialogue: 0,0:07:59.52,0:08:01.27,Default,,0,0,0,,Хабарлама жеткізілді ме?
Dialogue: 0,0:08:01.35,0:08:02.19,Default,,0,0,0,,Иә
Dialogue: 0,0:08:02.27,0:08:04.44,Default,,0,0,0,,Иә, маған...
Dialogue: 0,0:08:04.52,0:08:06.27,Default,,0,0,0,,Джисакиге қатысты...
Dialogue: 0,0:08:07.65,0:08:11.40,Default,,0,0,0,,Сен сондай ұсқынсыз көрінесің, Джисаки.
Dialogue: 0,0:08:11.49,0:08:13.91,Default,,0,0,0,,Әй... Әке...
Dialogue: 0,0:08:13.99,0:08:16.20,Default,,0,0,0,,Ол төсекке таңылған болуы керек...
Dialogue: 0,0:08:16.28,0:08:18.29,Default,,0,0,0,,Сіздің «даралығыңызбен»
Dialogue: 0,0:08:18.37,0:08:23.46,Default,,0,0,0,,Дегенмен, қолдау элементтері жеделдетілген қарқынмен дамып жатқан сияқты.
Dialogue: 0,0:08:23.54,0:08:26.88,Default,,0,0,0,,Сонымен қатар мен топ басшысы емеспін. Мен енді топ емеспін.
Dialogue: 0,0:08:26.96,0:08:28.13,Default,,0,0,0,,Әке...
Dialogue: 0,0:08:28.21,0:08:31.55,Default,,0,0,0,,Адам жолынан адаспа
Dialogue: 0,0:08:31.63,0:08:33.30,Default,,0,0,0,,Өйткені ол болады.
Dialogue: 0,0:08:34.30,0:08:37.35,Default,,0,0,0,,Мен саған әрқашан қолымды создым.
Dialogue: 0,0:08:37.43,0:08:39.18,Default,,0,0,0,,Онда барма.
Dialogue: 0,0:08:40.35,0:08:43.27,Default,,0,0,0,,Куроно маған ұрыспады, солай ма?
Dialogue: 0,0:08:43.35,0:08:46.73,Default,,0,0,0,,Кешіріңіз... Әке... Кешіріңіз...
Dialogue: 0,0:08:46.81,0:08:48.07,Default,,0,0,0,,Кешіктіріңіз
Dialogue: 0,0:08:48.15,0:08:51.24,Default,,0,0,0,,Сол сызықты өмір бойы Элиге бағыттаңыз.
Dialogue: 0,0:08:51.32,0:08:53.07,Default,,0,0,0,,Эли сені ұмытады
Dialogue: 0,0:08:53.15,0:08:55.82,Default,,0,0,0,,Елиге не істегеніңді ұмытпа
Dialogue: 0,0:08:55.91,0:08:58.41,Default,,0,0,0,,(Джисаки жылайды)
Dialogue: 0,0:08:58.49,0:09:00.12,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:08:58.49,0:09:00.12,Default,,0,0,0,,(Джисакидің айқайы)
Dialogue: 0,0:09:00.12,0:09:00.20,Default,,0,0,0,,(Джисаки жылайды)
Dialogue: 0,0:09:00.20,0:09:03.50,Default,,0,0,0,,(Джисаки жылайды)
Dialogue: 0,0:09:00.20,0:09:03.50,Default,,0,0,0,,Таусылғанша ұрысамын.
Dialogue: 0,0:09:03.50,0:09:04.58,Default,,0,0,0,,Таусылғанша ұрысамын.
Dialogue: 0,0:09:06.63,0:09:08.92,Default,,0,0,0,,Рахмет, Цукаучи мырза.
Dialogue: 0,0:09:09.00,0:09:09.84,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:09:09.92,0:09:12.51,Default,,0,0,0,,Элиді еске түсіргеннен әлдеқайда жақсы
Dialogue: 0,0:09:14.30,0:09:17.47,Default,,0,0,0,,Біз мұны қалай болдырмауға болады?
Dialogue: 0,0:09:18.22,0:09:19.64,Default,,0,0,0,,Ол кетпейді
Dialogue: 0,0:09:23.35,0:09:24.18,Default,,0,0,0,,Хоксқа
Dialogue: 0,0:09:24.27,0:09:26.40,Default,,0,0,0,,Батыр Біз көбірек аламыз ба?
Dialogue: 0,0:09:26.48,0:09:29.69,Default,,0,0,0,,Не? Хоукс: Сізде мұндай күш бар ма?
Dialogue: 0,0:09:29.77,0:09:31.19,Default,,0,0,0,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:09:31.28,0:09:33.49,Default,,0,0,0,,Енді ауыстырайық.
Dialogue: 0,0:09:33.57,0:09:36.15,Default,,0,0,0,,Бүгіннен бастап жаңа студенттер де сабаққа қатысатын болады.
Dialogue: 0,0:09:36.24,0:09:38.12,Default,,0,0,0,,Қара жүзіңді көрсетпе
Dialogue: 0,0:09:38.20,0:09:41.70,Default,,0,0,0,,Бірақ батырлар класында тік байланыстар көп емес.
Dialogue: 0,0:09:41.79,0:09:43.54,Default,,0,0,0,,Біз бетпе-бет кездесеміз...
Dialogue: 0,0:09:43.62,0:09:48.29,Default,,0,0,0,,Кя~! Тодороки Сенпай! Динамит Сенпай!
Dialogue: 0,0:09:48.38,0:09:49.54,Default,,0,0,0,,Не?
Dialogue: 0,0:09:48.38,0:09:49.54,Default,,0,0,0,,Тергеуіміз қажет нәрселер бар… біртіндеп шешеміз
Dialogue: 0,0:09:49.54,0:09:49.63,Default,,0,0,0,,Тергеуіміз қажет нәрселер бар… біртіндеп шешеміз
Dialogue: 0,0:09:49.63,0:09:51.75,Default,,0,0,0,,Тергеуіміз қажет нәрселер бар… біртіндеп шешеміз
Dialogue: 0,0:09:49.63,0:09:51.75,Default,,0,0,0,,Мына жігіттердің барлығын шығару керек!
Dialogue: 0,0:09:51.84,0:09:53.71,Default,,0,0,0,,1 жыл Керемет!
Dialogue: 0,0:09:55.72,0:09:58.76,Default,,0,0,0,,Тікелей эфирде «үшін бір үшін» командасымен шайқасты көру
Dialogue: 0,0:09:58.84,0:10:01.64,Default,,0,0,0,,Мен Тодороки-сенпайды спорт мерекесінен кездестірдім...
Dialogue: 0,0:10:01.72,0:10:03.81,Default,,0,0,0,,Мен де... нұсқаулық болды.
Dialogue: 0,0:10:03.89,0:10:05.43,Default,,0,0,0,,Мен де (студент) Мен де
Dialogue: 0,0:10:05.52,0:10:08.60,Default,,0,0,0,,Оларға тамсанған дұрыс, бірақ олар да адам.
Dialogue: 0,0:10:08.69,0:10:11.52,Default,,0,0,0,,Мені топ болып қуып кетсе, таң қалар едім.
Dialogue: 0,0:10:11.61,0:10:13.90,Default,,0,0,0,,Мен әр адаммен жеке сөйлесе алдым.
Dialogue: 0,0:10:13.98,0:10:17.45,Default,,0,0,0,,Мен дәлізде жүгіріп бара жаттым! Дәлізде! Төраға!
Dialogue: 0,0:10:17.53,0:10:20.12,Default,,0,0,0,,Жарайды, тәртіпті сақтау керек.
Dialogue: 0,0:10:20.20,0:10:21.78,Default,,0,0,0,,Олардың да кейінгі әсерлері бар
Dialogue: 0,0:10:21.87,0:10:23.91,Default,,0,0,0,,Ах! (Иида) Маған демалуға рұқсат етіңізші.
Dialogue: 0,0:10:23.99,0:10:26.41,Default,,0,0,0,,Мен... Кешіріңіз...
Dialogue: 0,0:10:26.50,0:10:28.00,Default,,0,0,0,,Мен сені жаңа ғана көрдім...
Dialogue: 0,0:10:28.08,0:10:29.71,Default,,0,0,0,,Бакугоу жұмыс істеп жатыр ма?
Dialogue: 0,0:10:28.08,0:10:29.71,Default,,0,0,0,,Сіз не туралы шынайы ойлай аласыз
Dialogue: 0,0:10:29.79,0:10:30.83,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:10:29.79,0:10:30.83,Default,,0,0,0,,Мен саған ұнайды деп ойладым
Dialogue: 0,0:10:30.83,0:10:30.92,Default,,0,0,0,,Мен сізге ұнайды деп ойладым
Dialogue: 0,0:10:30.92,0:10:31.46,Default,,0,0,0,,Мен саған ұнайды деп ойладым
Dialogue: 0,0:10:30.92,0:10:31.46,Default,,0,0,0,,Бір нәрсені қайталамау
Dialogue: 0,0:10:31.46,0:10:31.54,Default,,0,0,0,,Бір нәрсені қайталамау
Dialogue: 0,0:10:31.54,0:10:33.00,Default,,0,0,0,,Бір нәрсені қайталамау
Dialogue: 0,0:10:31.54,0:10:33.00,Default,,0,0,0,,Олардың көптігі сонша, мен шынымен абдырап қалдым.
Dialogue: 0,0:10:33.00,0:10:33.09,Default,,0,0,0,,Олардың көптігі сонша, мен шынымен абдырап қалдым.
Dialogue: 0,0:10:33.09,0:10:34.67,Default,,0,0,0,,Олардың көптігі сонша, мен шынымен абдырап қалдым.
Dialogue: 0,0:10:33.09,0:10:34.67,Default,,0,0,0,,Менің ойымша, бұл маңызды
Dialogue: 0,0:10:34.76,0:10:36.59,Default,,0,0,0,,Баяғыдан, Качан
Dialogue: 0,0:10:36.67,0:10:39.89,Default,,0,0,0,,Әйелдер мені алшақ ұстағандықтан үйренбеген шығармын.
Dialogue: 0,0:10:39.97,0:10:41.09,Default,,0,0,0,,Уау, бұл таңқаларлық.
Dialogue: 0,0:10:41.18,0:10:43.10,Default,,0,0,0,,Таңқаларлық емес, шіркін.
Dialogue: 0,0:10:43.18,0:10:47.14,Default,,0,0,0,,Мен олардың жетістігін құптаймын, бірақ янкилердің танымал болғанын құптамаймын.
Dialogue: 0,0:10:47.23,0:10:48.27,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:10:48.35,0:10:50.10,Default,,0,0,0,,Тек кет! (Оқушылар) Эй!
Dialogue: 0,0:10:50.19,0:10:52.02,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:10:52.11,0:10:54.11,Default,,0,0,0,,Бұл таңқаларлық емес еді.
Dialogue: 0,0:10:54.19,0:10:55.94,Default,,0,0,0,,Мидория-сенпай! (Изуку/Шинсу) Иә?
Dialogue: 0,0:10:56.03,0:10:58.03,Default,,0,0,0,,Мм... Мен оны қарап отырдым.
Dialogue: 0,0:10:58.11,0:11:00.11,Default,,0,0,0,,Бұл маған батылдық берді!
Dialogue: 0,0:11:00.20,0:11:04.74,Default,,0,0,0,,Мен де бірдеңе істеуім керек сияқты сезіндім!
Dialogue: 0,0:11:04.83,0:11:08.75,Default,,0,0,0,,Мм... көп рахмет! Кешіріңіз!
Dialogue: 0,0:11:08.83,0:11:10.17,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,0:11:11.54,0:11:14.88,Default,,0,0,0,,Мм... жақсы...
Dialogue: 0,0:11:14.96,0:11:16.80,Default,,0,0,0,,Бұл ауырсыну...
Dialogue: 0,0:11:16.88,0:11:19.01,Default,,0,0,0,,Мидория мен Тодороки керемет!
Dialogue: 0,0:11:19.09,0:11:22.30,Default,,0,0,0,,Янкилердің танымал екенін қабылдай алмаймыз.
Dialogue: 0,0:11:22.39,0:11:24.39,Default,,0,0,0,,Жан осындай!
Dialogue: 0,0:11:24.47,0:11:27.14,Default,,0,0,0,,Соғыс тым үлкен болды.
Dialogue: 0,0:11:27.22,0:11:29.77,Default,,0,0,0,,Мен оның ортасында болдым.
Dialogue: 0,0:11:29.85,0:11:32.48,Default,,0,0,0,,Бұлай шу шығарғаныңыз таңқаларлық емес.
Dialogue: 0,0:11:32.56,0:11:34.48,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,0:11:36.32,0:11:38.78,Default,,0,0,0,,Тағы 2-А сұхбат келіссөздері келе жатыр.
Dialogue: 0,0:11:38.86,0:11:39.78,Default,,0,0,0,,№.
Dialogue: 0,0:11:39.86,0:11:42.20,Default,,0,0,0,,Алғысы келетін адам жоқ па?
Dialogue: 0,0:11:42.28,0:11:43.37,Default,,0,0,0,,Минета және т.б.
Dialogue: 0,0:11:43.45,0:11:45.78,Default,,0,0,0,,Олай ойламайтындар бар.
Dialogue: 0,0:11:45.87,0:11:48.16,Default,,0,0,0,,Бұл басымдық.
Dialogue: 0,0:11:53.04,0:11:56.09,Default,,0,0,0,,Міне, бүгін бұл жерді қалпына келтіру және қайта құру.
Dialogue: 0,0:11:56.17,0:11:57.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:57.46,0:11:59.59,Default,,0,0,0,,О, бұл А класы емес пе?
Dialogue: 0,0:11:59.67,0:12:00.59,Default,,0,0,0,,Бұл мені өлтірмейді, бірақ біраз уақыт дұрыс жүре алмайтын шығармын.
Dialogue: 0,0:12:00.67,0:12:01.51,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:12:01.59,0:12:02.55,Default,,0,0,0,,Екеуі де осы Спорт фестивалінде жоғары деңгейдегі нәтижелерге қол жеткізді!
Dialogue: 0,0:12:02.63,0:12:05.51,Default,,0,0,0,,Suneater менің серіктесім.
Dialogue: 0,0:12:05.60,0:12:07.10,Default,,0,0,0,,Міне, балалар
Dialogue: 0,0:12:07.18,0:12:08.01,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:08.10,0:12:10.89,Default,,0,0,0,,(Оқушыларды жігерлендіретін дауыстар)
Dialogue: 0,0:12:10.98,0:12:13.27,Default,,0,0,0,,Алдымен жерді тегістеңіз.
Dialogue: 0,0:12:14.19,0:12:15.94,Default,,0,0,0,,Сізді бір батыр ұсынды
Dialogue: 0,0:12:16.02,0:12:18.98,Default,,0,0,0,,Металдар үшін осы жерді басыңыз (Sero) Иә.
Dialogue: 0,0:12:20.32,0:12:22.53,Default,,0,0,0,,Бұл әбден зақымдалған джинсы болуы мүмкін.
Dialogue: 0,0:12:23.20,0:12:25.45,Default,,0,0,0,,Сізге тек тыныштық пен демалу керек.
Dialogue: 0,0:12:25.53,0:12:26.37,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:12:26.45,0:12:27.28,Default,,0,0,0,,Ах
Dialogue: 0,0:12:27.37,0:12:29.83,Default,,0,0,0,,Әлі де солай ма?
Dialogue: 0,0:12:29.91,0:12:31.58,Default,,0,0,0,,Иә? ол туралы уайымдама
Dialogue: 0,0:12:31.66,0:12:34.54,Default,,0,0,0,,Қол бірте-бірте қалпына келеді.
Dialogue: 0,0:12:35.29,0:12:37.54,Default,,0,0,0,,Ол қалыпты жағдайға орала ма?
Dialogue: 0,0:12:37.63,0:12:40.71,Default,,0,0,0,,Мен бастапқыда бәрін алуға бардым деп ойладым.
Dialogue: 0,0:12:41.38,0:12:42.42,Default,,0,0,0,,Иә
Dialogue: 0,0:12:46.43,0:12:48.64,Default,,0,0,0,,(Сирена қосылады)
Dialogue: 0,0:12:57.15,0:12:58.15,Default,,0,0,0,,Эй
Dialogue: 0,0:12:58.23,0:12:59.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:59.32,0:13:01.44,Default,,0,0,0,,Балалар, бұл түскі ас.
Dialogue: 0,0:13:02.03,0:13:03.40,Default,,0,0,0,,Уау! Онигири!
Dialogue: 0,0:13:03.49,0:13:04.78,Default,,0,0,0,,Дәмді көрінеді!
Dialogue: 0,0:13:04.86,0:13:07.82,Default,,0,0,0,,Осыншама көп болғаны дұрыс па...?
Dialogue: 0,0:13:07.91,0:13:11.79,Default,,0,0,0,,Бұл шайқаста менің жерім желге ұшып кетті, бірақ...
Dialogue: 0,0:13:11.87,0:13:14.21,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:13:14.29,0:13:15.62,Default,,0,0,0,,Не? О, жоқ
Dialogue: 0,0:13:15.71,0:13:18.42,Default,,0,0,0,,Мен сені кінәлағым келмеді. Кешіріңіз.
Dialogue: 0,0:13:18.50,0:13:21.55,Default,,0,0,0,,Мен сендерді еңбектеніп жатқандарыңды көргенде
Dialogue: 0,0:13:21.63,0:13:24.80,Default,,0,0,0,,Біз де ойладық: «Ол үшін уайымдамаңыз».
Dialogue: 0,0:13:24.88,0:13:26.55,Default,,0,0,0,,Оны бізге қалдырмаңыз
Dialogue: 0,0:13:26.64,0:13:30.26,Default,,0,0,0,,Біз оны өзіміз қалағанымызша қайта жасаймыз.
Dialogue: 0,0:13:30.85,0:13:33.35,Default,,0,0,0,,Жарайды, мен бұл тамақты да алдым.
Dialogue: 0,0:13:33.43,0:13:35.31,Default,,0,0,0,,Бүгін оны тазалап көрейік!
Dialogue: 0,0:13:35.39,0:13:37.90,Default,,0,0,0,,Себебі бізде жұмыс күші жеткіліксіз.
Dialogue: 0,0:13:37.98,0:13:39.94,Default,,0,0,0,,(үшін күледі)
Dialogue: 0,0:13:40.02,0:13:40.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:40.94,0:13:43.36,Default,,0,0,0,,Не? Бұл кестеде болмаған автобус.
Dialogue: 0,0:13:43.44,0:13:44.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:45.07,0:13:48.57,Default,,0,0,0,,Кешіріңіз, маған кешірім сұрау керек.
Dialogue: 0,0:13:48.66,0:13:50.78,Default,,0,0,0,,Бұрынғы қолайсыздық үшін кешірім сұраймын!
Dialogue: 0,0:13:50.87,0:13:53.20,Default,,0,0,0,,Әркімнің жағдайын ескермей
Dialogue: 0,0:13:53.29,0:13:55.25,Default,,0,0,0,,Қандай керемет жыл болды!
Dialogue: 0,0:13:55.33,0:13:57.08,Default,,0,0,0,,Мені мұнда неге әкелдің?
Dialogue: 0,0:13:57.17,0:13:59.17,Default,,0,0,0,,Ваби қысымы керемет болды...
Dialogue: 0,0:13:59.25,0:14:02.55,Default,,0,0,0,,үшін үшін күрескен ағаларымыз сияқты.
Dialogue: 0,0:14:02.63,0:14:04.97,Default,,0,0,0,,Біз де қарттарға көмектескіміз келеді!
Dialogue: 0,0:14:05.05,0:14:07.88,Default,,0,0,0,,Мен уақытша лицензия алып қана қоймай, жақында ғана тіркелдім.
Dialogue: 0,0:14:07.97,0:14:09.84,Default,,0,0,0,,Мен не істей аламын Өтінемін, маған мұны істеуге рұқсат етіңіз!
Dialogue: 0,0:14:09.93,0:14:11.22,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:11.97,0:14:14.98,Default,,0,0,0,,Екінші курсқа кедергі болады, сондықтан бұрышта жеңіл жұмыс жасаңыз.
Dialogue: 0,0:14:15.06,0:14:16.39,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:16.48,0:14:19.15,Default,,0,0,0,,Кіші балалар сондай беймәлім тіршілік иелері ме?
Dialogue: 0,0:14:19.23,0:14:21.94,Default,,0,0,0,,Меши Мен онша көп дайындаған жоқпын.
Dialogue: 0,0:14:22.02,0:14:24.28,Default,,0,0,0,,Мен жедім!
Dialogue: 0,0:14:24.36,0:14:26.19,Default,,0,0,0,,Мен бір нәрсені түсінбеймін.
Dialogue: 0,0:14:26.28,0:14:30.78,Default,,0,0,0,,Міне, сіздің барлық еңбектеріңіз бірінен соң бірі болады.
Dialogue: 0,0:14:31.49,0:14:33.83,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:14:33.91,0:14:34.79,Default,,0,0,0,,Жарақатым жазылды, сондықтан бүгіннен бастап қалыпты мектеп кестесіне оралдым.
Dialogue: 0,0:14:35.50,0:14:37.33,Default,,0,0,0,,Очако-чан?
Dialogue: 0,0:14:37.41,0:14:38.46,Default,,0,0,0,,Иә
Dialogue: 0,0:14:40.04,0:14:41.75,Default,,0,0,0,,Біртіндеп
Dialogue: 0,0:14:41.84,0:14:45.09,Default,,0,0,0,,Сіздің асыға күтетін сияқты болғаныңызға қуаныштымын.
Dialogue: 0,0:14:45.17,0:14:46.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:46.38,0:14:47.67,Default,,0,0,0,,Мүмкін емес — сен Шиндо емессің ғой…
Dialogue: 0,0:14:47.76,0:14:49.26,Default,,0,0,0,,Кешіріңіз, Цюйю-чан
Dialogue: 0,0:14:49.34,0:14:51.14,Default,,0,0,0,,Деку-кун, сен не жейсің?
Dialogue: 0,0:14:51.22,0:14:52.80,Default,,0,0,0,,Мм... Такана
Dialogue: 0,0:14:52.89,0:14:54.72,Default,,0,0,0,,Маған да Такана ұнайды!
Dialogue: 0,0:14:54.81,0:14:57.23,Default,,0,0,0,,Такана мен умебоши ең жақсы!
Dialogue: 0,0:14:59.94,0:15:01.81,Default,,0,0,0,,Бата
Dialogue: 0,0:15:01.90,0:15:03.57,Default,,0,0,0,,(Жүрек соғысы дыбысы)
Dialogue: 0,0:15:07.74,0:15:09.36,Default,,0,0,0,,Иә, Урарака?
Dialogue: 0,0:15:09.45,0:15:11.41,Default,,0,0,0,,Үйге бір рет бару
Dialogue: 0,0:15:11.49,0:15:13.20,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:13.95,0:15:16.62,Default,,0,0,0,,Очако-чан, мен оны оқылған деп белгілей алмаймын.
Dialogue: 0,0:15:16.70,0:15:18.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:25.75,0:15:27.26,Default,,0,0,0,,Уф... шіркін!
Dialogue: 0,0:15:27.34,0:15:28.92,Default,,0,0,0,,Не? Мен оны жобаладым
Dialogue: 0,0:15:29.51,0:15:31.18,Default,,0,0,0,,Олар кенет маған тікұшақ жіберуді бұйырды.
Dialogue: 0,0:15:31.26,0:15:34.01,Default,,0,0,0,,Камераның батареясы таусылған!
Dialogue: 0,0:15:34.80,0:15:39.89,Default,,0,0,0,,Біздің бұл күнді аяқтау камераға көрсетілмеді.
Dialogue: 0,0:15:47.73,0:15:50.53,Default,,0,0,0,,Қала пейзажы бұрынғы қалпына оралды.
Dialogue: 0,0:15:52.11,0:15:53.78,Default,,0,0,0,,Біртіндеп
Dialogue: 0,0:15:53.87,0:15:57.45,Default,,0,0,0,,Сіздің асыға күтетін сияқты болғаныңызға қуаныштымын.
Dialogue: 0,0:15:59.29,0:16:02.33,Default,,0,0,0,,Сол күннен бастап жағдай жақсармаған
Dialogue: 0,0:16:02.42,0:16:06.09,Default,,0,0,0,,Күн батқан сайын көлеңке өсетіндей.
Dialogue: 0,0:16:07.09,0:16:11.17,Default,,0,0,0,,Бұрынғыдай емес, шынымен бітті.
Dialogue: 0,0:16:13.01,0:16:14.84,Default,,0,0,0,,Орындалды
Dialogue: 0,0:16:15.39,0:16:17.31,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:16:17.93,0:16:21.06,Default,,0,0,0,,Жарқын және позитивті болуға қайта оралу уақыты келді.
Dialogue: 0,0:16:21.60,0:16:24.40,Default,,0,0,0,,Маған бәрінің күлгені ұнайды
Dialogue: 0,0:16:25.31,0:16:27.07,Default,,0,0,0,,Мен су қосқым келмейді
Dialogue: 0,0:16:29.61,0:16:30.07,Default,,0,0,0,,Сондықтан мен бұл ауыратын жараны мәңгілікке алып тастауым керек.
Dialogue: 0,0:16:30.07,0:16:32.82,Default,,0,0,0,,Сондықтан мен бұл ауыратын жараны мәңгілікке кетірдім.
Dialogue: 0,0:16:30.07,0:16:32.82,Default,,0,0,0,,Уф, оқ-дәрі астында қалып қоюдың өзі бір әлем екен
Dialogue: 0,0:16:32.82,0:16:32.90,Default,,0,0,0,,Сондықтан мен бұл ауыратын жараны мәңгілікке кетірдім.
Dialogue: 0,0:16:32.90,0:16:36.37,Default,,0,0,0,,Сондықтан мен бұл ауыратын жараны мәңгілікке кетірдім.
Dialogue: 0,0:16:32.90,0:16:36.37,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:16:36.37,0:16:36.45,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:16:36.45,0:16:37.83,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:16:36.45,0:16:37.83,Default,,0,0,0,,Очако-чан —
Dialogue: 0,0:16:37.91,0:16:43.46,Default,,0,0,0,,Бар болғаны батыр болу және дұрыс әрекет жасау болды.
Dialogue: 0,0:16:43.54,0:16:45.42,Default,,0,0,0,,Бірақ
Dialogue: 0,0:16:46.25,0:16:49.80,Default,,0,0,0,,Тым көп ойлау
Dialogue: 0,0:16:50.30,0:16:54.01,Default,,0,0,0,,Ол тікелей Біреу үшін үшін-ның бағыныштысы.
Dialogue: 0,0:16:54.09,0:16:56.22,Default,,0,0,0,,Сондықтан мен батыр болуды мақсат еттім
Dialogue: 0,0:16:57.64,0:17:02.68,Default,,0,0,0,,Мен Химико-чанның өмірінде тірі қалдым.
Dialogue: 0,0:17:03.64,0:17:04.14,Default,,0,0,0,,Менің істегенім...
Dialogue: 0,0:17:04.14,0:17:05.98,Default,,0,0,0,,Менің істегенім...
Dialogue: 0,0:17:04.14,0:17:05.98,Default,,0,0,0,,Уф, аа...
Dialogue: 0,0:17:06.06,0:17:07.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:07.27,0:17:09.40,Default,,0,0,0,,Урарака-сан! (Рейхи) Ха!
Dialogue: 0,0:17:09.48,0:17:11.15,Default,,0,0,0,,Оны басқа жерде көрді, сондықтан ол сонда кетті.
Dialogue: 0,0:17:11.23,0:17:14.49,Default,,0,0,0,,Ах! Бұл неге... қалай...
Dialogue: 0,0:17:14.57,0:17:16.32,Default,,0,0,0,,Әйтеуір
Dialogue: 0,0:17:16.41,0:17:18.41,Default,,0,0,0,,«Біріміз бәріміз үшін» ұшты
Dialogue: 0,0:17:19.03,0:17:22.87,Default,,0,0,0,,Маңызды әңгімеміз осы жерде болды.
Dialogue: 0,0:17:22.95,0:17:27.17,Default,,0,0,0,,Жоқ, мен қазір үйге барамын дедім.
Dialogue: 0,0:17:27.25,0:17:30.13,Default,,0,0,0,,Мен үйге бара алатын болсам, үйге барар едім.
Dialogue: 0,0:17:30.21,0:17:32.30,Default,,0,0,0,,Бірақ мен сені осында деп ойладым.
Dialogue: 0,0:17:33.55,0:17:36.93,Default,,0,0,0,,Неге... Көргім келмейді.
Dialogue: 0,0:17:37.01,0:17:40.26,Default,,0,0,0,,Кешіріңіз, бірақ маған көрсеткеніңізді қалаймын.
Dialogue: 0,0:17:40.35,0:17:41.31,Default,,0,0,0,,Е...
Dialogue: 0,0:17:41.39,0:17:45.06,Default,,0,0,0,,Ұрақа әрқашан солай емес пе?
Dialogue: 0,0:17:45.14,0:17:46.98,Default,,0,0,0,,Тіпті қабылдау емтиханы кезінде...
Dialogue: 0,0:17:47.06,0:17:48.48,Default,,0,0,0,,Менің «даралығым»
Dialogue: 0,0:17:48.56,0:17:50.52,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:17:50.61,0:17:53.19,Default,,0,0,0,,Бірақ құлап қалсаң, бұл бақытсыздық.
Dialogue: 0,0:17:53.28,0:17:55.86,Default,,0,0,0,,Бұл өту/өтпеген ұпайлар туралы...
Dialogue: 0,0:17:55.95,0:17:58.95,Default,,0,0,0,,Менің ұпайларымды ажырата аласыз ба?
Dialogue: 0,0:17:59.03,0:18:01.79,Default,,0,0,0,,әрқашан
Dialogue: 0,0:18:01.87,0:18:05.41,Default,,0,0,0,,Бірақ «Деку» «Қолыңнан келгеннің бәрін жаса!» дегенді білдіреді.
Dialogue: 0,0:18:05.50,0:18:06.87,Default,,0,0,0,,Маған бір нәрсе ұнайды
Dialogue: 0,0:18:06.96,0:18:08.21,Default,,0,0,0,,Декү, сабыр сақта!
Dialogue: 0,0:18:08.29,0:18:12.71,Default,,0,0,0,,Оның! Маған Hero Academia-да сәтті өтіңіз!
Dialogue: 0,0:18:12.80,0:18:16.67,Default,,0,0,0,,Әрқашан басқаларды өзіңізден жоғары қойыңыз
Dialogue: 0,0:18:16.76,0:18:18.68,Default,,0,0,0,,Тіпті спорт мерекесі кезінде
Dialogue: 0,0:18:18.76,0:18:21.01,Default,,0,0,0,,Әрқашан, әрқашан...
Dialogue: 0,0:18:21.10,0:18:23.26,Default,,0,0,0,,Маған көмек керек.
Dialogue: 0,0:18:24.39,0:18:26.43,Default,,0,0,0,,Ол менің кейіпкерім!
Dialogue: 0,0:18:27.02,0:18:31.19,Default,,0,0,0,,Сондықтан мен тек сенің күшіңе сенбеймін
Dialogue: 0,0:18:33.23,0:18:36.65,Default,,0,0,0,,Менің қолымнан ұстаудың өзі жүрегіңді тыныштандырады.
Dialogue: 0,0:18:36.74,0:18:41.62,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:18:44.74,0:18:49.37,Default,,0,0,0,,Химико-чан... ол мен үшін өлді.
Dialogue: 0,0:18:50.46,0:18:56.46,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:18:56.55,0:18:59.47,Default,,0,0,0,,Егер мені пышақтап алмағанда...
Dialogue: 0,0:18:59.55,0:19:02.22,Default,,0,0,0,,Мен тым көп ойладым...
Dialogue: 0,0:19:02.80,0:19:06.22,Default,,0,0,0,,Адамдармен қандас «дара тұлға» болды.
Dialogue: 0,0:19:06.81,0:19:09.23,Default,,0,0,0,,Тіпті олай болмаса да
Dialogue: 0,0:19:09.31,0:19:13.40,Default,,0,0,0,,Білудің жолы болды ма?
Dialogue: 0,0:19:13.48,0:19:16.69,Default,,0,0,0,,Тезірек байқасам ғой!
Dialogue: 0,0:19:16.78,0:19:21.16,Default,,0,0,0,,Бала кезімізде кездессек, жағдай басқаша болар ма еді?
Dialogue: 0,0:19:21.24,0:19:23.24,Default,,0,0,0,,Сен ғана ауада жүзе аласың, иә, Дөңгелек Жүз?
Dialogue: 0,0:19:23.32,0:19:26.08,Default,,0,0,0,,Батырға қиналғанда
Dialogue: 0,0:19:26.16,0:19:29.46,Default,,0,0,0,,Батырды кім қорғай алады?
Dialogue: 0,0:19:33.04,0:19:39.22,Default,,0,0,0,,Мен де қиналып жүрмін... Шығарагиді жерлеуде менде де осындай қиындық бар.
Dialogue: 0,0:19:40.01,0:19:44.47,Default,,0,0,0,,Бұл шайқасты бұрынғыдай босқа өткізбе.
Dialogue: 0,0:19:46.47,0:19:48.85,Default,,0,0,0,,үшін бір үшін де маған айтты
Dialogue: 0,0:19:48.93,0:19:53.06,Default,,0,0,0,,Сіз жүрген жол - тікенді жол.
Dialogue: 0,0:19:53.86,0:19:55.15,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:19:55.23,0:19:58.82,Default,,0,0,0,,Қажетсіз болса да, Қол созсаң,
Dialogue: 0,0:19:58.90,0:20:01.99,Default,,0,0,0,,сөзсіз
Dialogue: 0,0:20:07.79,0:20:08.83,Default,,0,0,0,,О, мен байыпты болдым!
Dialogue: 0,0:20:08.91,0:20:10.83,Default,,0,0,0,,Ах (Киришима және басқалар) Эй!
Dialogue: 0,0:20:10.91,0:20:13.00,Default,,0,0,0,,Урарака! (Яойорозу) Урарака-сан!
Dialogue: 0,0:20:13.08,0:20:14.25,Default,,0,0,0,,Біз де осындамыз!
Dialogue: 0,0:20:14.33,0:20:17.42,Default,,0,0,0,,Очако-чанның ақымақ! Уф
Dialogue: 0,0:20:17.50,0:20:19.59,Default,,0,0,0,,Мен сенен маған айтарыңды күттім.
Dialogue: 0,0:20:19.67,0:20:21.93,Default,,0,0,0,,Егер сізге бірдеңе ұнаса, айта аласыз.
Dialogue: 0,0:20:22.01,0:20:23.59,Default,,0,0,0,,Рахмет, Цюйю-чан
Dialogue: 0,0:20:23.68,0:20:25.43,Default,,0,0,0,,Урарака! (Джиро) Урарака!
Dialogue: 0,0:20:25.51,0:20:28.43,Default,,0,0,0,,Мен уайымдадым (Ашидо) Урарака
Dialogue: 0,0:20:28.51,0:20:30.64,Default,,0,0,0,,Толығырақ сөйлесейік.
Dialogue: 0,0:20:41.24,0:20:44.41,Default,,0,0,0,,Мен оны үрлеп жібердім, бірақ шоқтар жақсы ма?
Dialogue: 0,0:20:44.49,0:20:45.32,Default,,0,0,0,,Иә
Dialogue: 0,0:20:45.41,0:20:46.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:46.45,0:20:48.28,Default,,0,0,0,,Шоқтар...
Dialogue: 0,0:20:48.37,0:20:50.20,Default,,0,0,0,,Не, бұл...
Dialogue: 0,0:20:50.29,0:20:51.25,Default,,0,0,0,,Күтіңіз, күтіңіз
Dialogue: 0,0:20:51.33,0:20:54.12,Default,,0,0,0,,Маған соншалықты маңызды нәрсені неге айтпайсың?
Dialogue: 0,0:20:54.21,0:20:56.96,Default,,0,0,0,,Дұрыс, Мидория-кун (Тодороки) Сіз нені айтып тұрсыз?
Dialogue: 0,0:20:57.04,0:20:59.21,Default,,0,0,0,,Сулы! (Ашидо) Бұл рас!
Dialogue: 0,0:20:59.30,0:21:01.38,Default,,0,0,0,,Иә, мен сенімен дұрыс сөйлесемін.
Dialogue: 0,0:21:01.46,0:21:04.38,Default,,0,0,0,,Мидория қазірдің өзінде~ (Киришима) Мидория!
Dialogue: 0,0:21:04.47,0:21:09.47,Default,,0,0,0,,(барлық дүрбелең)
Dialogue: 0,0:21:12.64,0:21:15.06,Default,,0,0,0,,Не?!
Dialogue: 0,0:21:15.14,0:21:17.81,Default,,0,0,0,,Түзеткіш!
Dialogue: 0,0:21:17.90,0:21:22.69,Default,,0,0,0,,♪～
Dialogue: 0,0:21:22.78,0:21:25.24,Default,,0,0,0,,«Біреуі барлығына» аяқталды
Dialogue: 0,0:21:26.16,0:21:29.24,Default,,0,0,0,,Гиюдің күшімен иірілген қуат кристалы.
Dialogue: 0,0:21:30.16,0:21:32.50,Default,,0,0,0,,Келесі жолы бәріміз айналдыра алсақ
Dialogue: 0,0:21:35.79,0:21:39.38,Default,,0,0,0,,Иә, егер бәріміз бірге айналдыра алсақ
Dialogue: 0,0:22:54.24,0:22:59.25,Default,,0,0,0,,～♪
Dialogue: 0,0:23:00.79,0:23:05.30,Default,,0,0,0,,(Қайшымен кесу дыбысы)
Dialogue: 0,0:23:08.59,0:23:14.51,Default,,0,0,0,,(Терумотоның ауыр тыныс алуы)
Dialogue: 0,0:23:15.14,0:23:18.81,Default,,0,0,0,,Неге... бұл тек мен...
Dialogue: 0,0:23:18.89,0:23:19.94,Default,,0,0,0,,Я...
Dialogue: 0,0:23:22.27,0:23:23.90,Default,,0,0,0,,Мен бұны реттеймін
Dialogue: 0,0:23:24.52,0:23:25.98,Default,,0,0,0,,Менің оқиғам
Dialogue: 0,0:23:26.78,0:23:30.20,Default,,0,0,0,,Перде «Біріміз бәріміз үшін» шоғырымен жабылады.
Dialogue: 0,0:23:31.03,0:23:36.70,Default,,0,0,0,,Иә, бұл біздің ең үлкен қаһарман атанғанымыздың тарихы.
Dialogue: 0,0:23:38.54,0:23:43.04,Default,,0,0,0,,«Менің кейіпкерім академиясы» келесі соңғы эпизод
Dialogue: 0,0:23:43.92,0:23:46.96,Default,,0,0,0,,Біздің әңгімеміз жалғасады
Dialogue: 0,0:23:47.05,0:23:50.97,Default,,0,0,0,,Әрі қарай!Plus Ultra!
Dialogue: 0,0:23:52.47,0:23:58.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
