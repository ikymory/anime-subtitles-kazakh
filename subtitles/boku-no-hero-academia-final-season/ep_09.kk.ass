Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.62,0:00:03.67,Default,,0,0,0,,Бүгін
Dialogue: 0,0:00:03.75,0:00:06.42,Default,,0,0,0,,Америка Құрама Штаттарында ашық аспан болады.
Dialogue: 0,0:00:06.50,0:00:09.55,Default,,0,0,0,,Өткен апта өте ауыр болатын сияқты.
Dialogue: 0,0:00:09.63,0:00:11.76,Default,,0,0,0,,Болжамнан алыс болғанымыз үшін кешірім сұраймыз.
Dialogue: 0,0:00:11.76,0:00:13.13,Default,,0,0,0,,Болжамнан алыс болғанымыз үшін кешірім сұраймыз.
Dialogue: 0,0:00:11.76,0:00:13.13,Default,,0,0,0,,Мерил, енді біртүрлі ештеңе айтпа.
Dialogue: 0,0:00:13.13,0:00:14.76,Default,,0,0,0,,Мерил, енді біртүрлі ештеңе айтпа.
Dialogue: 0,0:00:14.84,0:00:18.01,Default,,0,0,0,,Дегенмен, жуу кезінде абай болыңыз.
Dialogue: 0,0:00:18.60,0:00:20.18,Default,,0,0,0,,Жел әлі қатты соғады
Dialogue: 0,0:00:20.18,0:00:21.10,Default,,0,0,0,,Жел әлі де қатты соғады
Dialogue: 0,0:00:20.18,0:00:21.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:21.18,0:00:24.52,Default,,0,0,0,,Сол күні соққан желдің екпіні
Dialogue: 0,0:00:24.60,0:00:26.77,Default,,0,0,0,,Ұлы шайқастан кейін бұл дүниеде
Dialogue: 0,0:00:26.86,0:00:29.53,Default,,0,0,0,,Оның қандай әсері бар?
Dialogue: 0,0:00:29.61,0:00:33.32,Default,,0,0,0,,Біз болжам жасауды жалғастырамыз.
Dialogue: 0,0:00:34.03,0:00:39.03,Default,,0,0,0,,♪～
Dialogue: 0,0:01:57.20,0:02:02.20,Default,,0,0,0,,～♪
Dialogue: 0,0:02:03.99,0:02:05.45,Default,,0,0,0,,Ха ха ха ха... (Сәлем) Эй
Dialogue: 0,0:02:06.21,0:02:08.04,Default,,0,0,0,,Оны осында әкеліңіз.
Dialogue: 0,0:02:08.12,0:02:10.71,Default,,0,0,0,,А, бұл пайдалы.
Dialogue: 0,0:02:10.79,0:02:13.71,Default,,0,0,0,,Уау! Үй салынды!
Dialogue: 0,0:02:13.80,0:02:16.38,Default,,0,0,0,,Уау, бұл бамбук өсіндісіне ұқсайды!
Dialogue: 0,0:02:16.47,0:02:18.47,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:02:19.05,0:02:21.64,Default,,0,0,0,,Содан бері бір апта өтті.
Dialogue: 0,0:02:22.14,0:02:27.94,Default,,0,0,0,,Қалпына келтіру жұмыстары қарқынды жүріп жатыр, жылан үңгірлері шайқасынан бері ешкім қолы тимеген.
Dialogue: 0,0:02:28.02,0:02:32.65,Default,,0,0,0,,Шайқастан кейін көптеген елдерден, соның ішінде Америкадан.
Dialogue: 0,0:02:32.73,0:02:35.40,Default,,0,0,0,,Көптеген қолдаулар келуді жалғастыруда.
Dialogue: 0,0:02:35.48,0:02:37.19,Default,,0,0,0,,Олардың шайқасын бақылаңыз
Dialogue: 0,0:02:37.28,0:02:39.91,Default,,0,0,0,,Мен қозғалмай тұра алмадым!
Dialogue: 0,0:02:40.61,0:02:42.62,Default,,0,0,0,,Мен емтихан органынан сызбаларды алдым.
Dialogue: 0,0:02:42.70,0:02:45.70,Default,,0,0,0,,Мүмкін болатын жерде құрылысты бастайық.
Dialogue: 0,0:02:45.79,0:02:46.62,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:02:47.71,0:02:50.92,Default,,0,0,0,,Ой~ (Жұмысшы) Жарайды, бастайық.
Dialogue: 0,0:02:51.00,0:02:52.75,Default,,0,0,0,,Табиғаттан тыс
Dialogue: 0,0:02:52.84,0:02:56.26,Default,,0,0,0,,Бұл масштабты қалпына келтіру үшін 10 жыл қажет еді.
Dialogue: 0,0:02:57.09,0:02:59.93,Default,,0,0,0,,Алайда, егер осы көптеген «жеке тұлғалар» жиналса,
Dialogue: 0,0:03:00.01,0:03:02.18,Default,,0,0,0,,Мен жақын арада сенімдімін...
Dialogue: 0,0:03:02.76,0:03:04.56,Default,,0,0,0,,Артқа жол жоқ.
Dialogue: 0,0:03:05.22,0:03:09.10,Default,,0,0,0,,Операция алдында айтқанымдай, бұл ең дұрысы.
Dialogue: 0,0:03:09.18,0:03:13.81,Default,,0,0,0,,Біз де оның жетістігін көрдік, сондықтан оған көмектесу үшін қолдан келгеннің бәрін жасадық.
Dialogue: 0,0:03:13.90,0:03:18.44,Default,,0,0,0,,Мен әйтеуір буындарды бір-бірінің үстіне қою арқылы пішінді сақтап қалдым.
Dialogue: 0,0:03:18.53,0:03:21.57,Default,,0,0,0,,Оңалту қозғалысты жақсартатынын айту мүмкін емес.
Dialogue: 0,0:03:21.66,0:03:24.41,Default,,0,0,0,,Батырлардың іс-әрекетіне қарасаңыз
Dialogue: 0,0:03:24.49,0:03:27.08,Default,,0,0,0,,Мирко сияқты аяқ-қолды протездеу мүмкіндігі де бар...
Dialogue: 0,0:03:27.66,0:03:29.33,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:03:29.96,0:03:32.83,Default,,0,0,0,,Менің «даралығым» алақаннан шығады.
Dialogue: 0,0:03:32.92,0:03:35.09,Default,,0,0,0,,Катсуки…
Dialogue: 0,0:03:35.17,0:03:38.96,Default,,0,0,0,,Және ол тіпті жоқ.
Dialogue: 0,0:03:40.67,0:03:44.47,Default,,0,0,0,,Оңалту қаншалықты қиын болса да, оны қазір жасаңыз!
Dialogue: 0,0:03:44.55,0:03:47.14,Default,,0,0,0,,Тек жеңіл жаттығуға болады
Dialogue: 0,0:03:47.22,0:03:49.73,Default,,0,0,0,,Ха! (Дәрігер) Сенің жүрегің қолыңнан жақсы.
Dialogue: 0,0:03:50.48,0:03:53.73,Default,,0,0,0,,Edgeshot-тың тамаша тігістері мен жүрек-қан тамырлары рефлекстері жоқ.
Dialogue: 0,0:03:53.81,0:03:55.90,Default,,0,0,0,,Сен өлдің.
Dialogue: 0,0:03:56.48,0:04:00.40,Default,,0,0,0,,Мен оның мұндай жағдайда қалай күрескенін түсінбеймін.
Dialogue: 0,0:04:00.49,0:04:02.57,Default,,0,0,0,,Одан кейін бірнеше шақырым жол жүруге қалай мүмкіндік болды?
Dialogue: 0,0:04:02.66,0:04:04.99,Default,,0,0,0,,Себебі мен оны түсінбеймін.
Dialogue: 0,0:04:05.62,0:04:09.08,Default,,0,0,0,,Тірі қалудан және жауап беруден басқа амал жоқ.
Dialogue: 0,0:04:09.16,0:04:12.04,Default,,0,0,0,,Қалай болғанда да, бұл абсолютті демалыс.
Dialogue: 0,0:04:12.12,0:04:14.92,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:04:18.13,0:04:19.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:19.25,0:04:20.67,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:04:23.97,0:04:28.06,Default,,0,0,0,,Мен Бүкіл Құдірет-пен бір бөлмеде боламын деп ешқашан ойламадым.
Dialogue: 0,0:04:28.14,0:04:30.31,Default,,0,0,0,,Бұл Цукаучи-кунның жоспары болды.
Dialogue: 0,0:04:30.39,0:04:32.23,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:32.31,0:04:36.11,Default,,0,0,0,,Қауіпсіздік оңай, ал аурухана бөлмелері шектеулі.
Dialogue: 0,0:04:38.19,0:04:40.44,Default,,0,0,0,,Бүкіл Құдірет денесі...
Dialogue: 0,0:04:41.07,0:04:44.70,Default,,0,0,0,,Сіз мұндай болтты бірінші рет салып отырғаныңызды айттыңыз.
Dialogue: 0,0:04:45.49,0:04:47.20,Default,,0,0,0,,Жас Мидория ше?
Dialogue: 0,0:04:47.78,0:04:50.95,Default,,0,0,0,,Мен қолымды сезбеймін...
Dialogue: 0,0:04:54.16,0:04:57.96,Default,,0,0,0,,Тенканың өмірін сақтап қалу мүмкін болмады.
Dialogue: 0,0:04:58.79,0:05:03.13,Default,,0,0,0,,Жек сезім басылса да, жүрегіңе қол соз
Dialogue: 0,0:05:03.88,0:05:07.43,Default,,0,0,0,,Тенка жау (жауыз) одағын соңына дейін басқарды.
Dialogue: 0,0:05:08.93,0:05:11.89,Default,,0,0,0,,Өлім алдында тұрған адам ретінде мен сізге мынаны айтайын:
Dialogue: 0,0:05:12.47,0:05:16.40,Default,,0,0,0,,Соңында оның жүзі қандай болды деп ойлаймын...
Dialogue: 0,0:05:17.40,0:05:20.65,Default,,0,0,0,,Мен... бұздым.
Dialogue: 0,0:05:21.53,0:05:24.90,Default,,0,0,0,,Ертең кім болатыныңа байланысты.
Dialogue: 0,0:05:26.45,0:05:29.87,Default,,0,0,0,,Ең жақсысын жасаңыз
Dialogue: 0,0:05:30.58,0:05:33.95,Default,,0,0,0,,Ол жерде жылап тұрған бала болмаса
Dialogue: 0,0:05:34.04,0:05:37.37,Default,,0,0,0,,Менің жүрегім аман қалды деп ойлаймын.
Dialogue: 0,0:05:37.46,0:05:40.63,Default,,0,0,0,,«Біріміз бәріміз үшін» миссиясымен
Dialogue: 0,0:05:41.67,0:05:44.97,Default,,0,0,0,,Сіз оны аудардыңыз, солай ма? Мен оны сеземін
Dialogue: 0,0:05:45.59,0:05:48.14,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:05:48.89,0:05:52.51,Default,,0,0,0,,Мен әлі күнге дейін тұтанған шоқтарды сеземін
Dialogue: 0,0:05:52.60,0:05:54.73,Default,,0,0,0,,Неліктен қозғала алмайсың?
Dialogue: 0,0:05:55.43,0:05:57.85,Default,,0,0,0,,Каччан, сенің аман болғаныңа қуаныштымын.
Dialogue: 0,0:05:57.94,0:05:59.35,Default,,0,0,0,,Кешіріңіз, бәрі мүмкін.
Dialogue: 0,0:05:59.44,0:06:02.94,Default,,0,0,0,,Бұл бала сенің жақсысың ба, жоқ па деп уайымдаған сияқты.
Dialogue: 0,0:06:03.03,0:06:05.86,Default,,0,0,0,,Хмм... Изуку-кун, мен де кешір.
Dialogue: 0,0:06:05.94,0:06:06.90,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:06:06.99,0:06:09.87,Default,,0,0,0,,Эй, дәл қазір...
Dialogue: 0,0:06:11.78,0:06:13.95,Default,,0,0,0,,Шоқтар бұл...
Dialogue: 0,0:06:14.95,0:06:17.37,Default,,0,0,0,,Не? Сонда...
Dialogue: 0,0:06:18.46,0:06:19.63,Default,,0,0,0,,Сіз...
Dialogue: 0,0:06:22.59,0:06:24.51,Default,,0,0,0,,«Тұлғалық жоқ»…
Dialogue: 0,0:06:25.13,0:06:28.51,Default,,0,0,0,,Иә, бірақ ол бастапқыда болмаған.
Dialogue: 0,0:06:28.59,0:06:30.14,Default,,0,0,0,,Бұл ұят емес.
Dialogue: 0,0:06:30.76,0:06:33.56,Default,,0,0,0,,Мен керемет арман көргендей сезінемін.
Dialogue: 0,0:06:33.64,0:06:35.56,Default,,0,0,0,,(Бакугоның дірілдеп тыныс алуы)
Dialogue: 0,0:06:35.64,0:06:40.31,Default,,0,0,0,,Қандай арам адам өтеді! а?
Dialogue: 0,0:06:40.40,0:06:43.11,Default,,0,0,0,,Содан кейін мен одан да асып кетемін.
Dialogue: 0,0:06:43.19,0:06:45.40,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,0:06:45.48,0:06:49.07,Default,,0,0,0,,Маған сенен өтуге жол берме, Изуку!
Dialogue: 0,0:06:49.15,0:06:51.74,Default,,0,0,0,,(Бакугоның дірілдеп тыныс алуы)
Dialogue: 0,0:06:51.74,0:06:52.57,Default,,0,0,0,,(Бакугоның дірілдеп тыныс алуы)
Dialogue: 0,0:06:51.74,0:06:52.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:52.57,0:06:55.08,Default,,0,0,0,,(Бакугоның дірілдеп тыныс алуы)
Dialogue: 0,0:06:55.16,0:06:57.41,Default,,0,0,0,,Иә... иә...
Dialogue: 0,0:06:57.50,0:06:58.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:58.66,0:07:00.50,Default,,0,0,0,,Жылау!?
Dialogue: 0,0:07:01.13,0:07:04.46,Default,,0,0,0,,Жоқ... жоқ... иә...
Dialogue: 0,0:07:04.55,0:07:06.67,Default,,0,0,0,,Шынымен... (Изуку) А... а...
Dialogue: 0,0:07:07.55,0:07:13.18,Default,,0,0,0,,Шынымды айтсам, мен саған не істедім...
Dialogue: 0,0:07:13.26,0:07:16.31,Default,,0,0,0,,Әйтеуір, үнемі осылай болған...
Dialogue: 0,0:07:16.89,0:07:20.06,Default,,0,0,0,,Жарыс және қуу...
Dialogue: 0,0:07:20.14,0:07:22.86,Default,,0,0,0,,Мен бірдеңе ойлап отыр едім...
Dialogue: 0,0:07:22.94,0:07:24.94,Default,,0,0,0,,Тоқта, олай емес сияқты.
Dialogue: 0,0:07:25.02,0:07:27.44,Default,,0,0,0,,Әзірше шоқтар бар.
Dialogue: 0,0:07:28.15,0:07:31.70,Default,,0,0,0,,Менің денем әлсіз болғандықтан, менің ойым да әлсіз.
Dialogue: 0,0:07:31.78,0:07:34.95,Default,,0,0,0,,Екеуміз де күшейіп кеттік.
Dialogue: 0,0:07:35.53,0:07:38.95,Default,,0,0,0,,Біз алғаш танысқан күннен бері сен қатты өзгердің.
Dialogue: 0,0:07:40.54,0:07:43.46,Default,,0,0,0,,Сол күні жүгіре бастаған Мидорий баласы
Dialogue: 0,0:07:43.54,0:07:47.46,Default,,0,0,0,,Ол мен үшін ең жақсы қаһарман болды.
Dialogue: 0,0:07:48.51,0:07:52.09,Default,,0,0,0,,Бірақ қазір мен бәрін шабыттандырамын
Dialogue: 0,0:07:52.18,0:07:55.14,Default,,0,0,0,,Ол бәрі үшін ең жақсы кейіпкер.
Dialogue: 0,0:07:55.76,0:08:00.10,Default,,0,0,0,,Сіз маған мұны айту үшін уақыт бердіңіз ...
Dialogue: 0,0:08:00.18,0:08:02.60,Default,,0,0,0,,Бакугу баласы да
Dialogue: 0,0:08:02.69,0:08:05.36,Default,,0,0,0,,Ең жақсы қаһарман
Dialogue: 0,0:08:05.98,0:08:09.11,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:08:10.90,0:08:14.36,Default,,0,0,0,,Ах... иә.
Dialogue: 0,0:08:19.16,0:08:20.66,Default,,0,0,0,,Бала кезімде
Dialogue: 0,0:08:21.25,0:08:26.67,Default,,0,0,0,,Соғыс біткен соң әлем автоматты түрде тыныштық орнайды деп ойладым.
Dialogue: 0,0:08:27.59,0:08:31.92,Default,,0,0,0,,Бірақ біздің тарихымыз аяқталмайды
Dialogue: 0,0:08:32.55,0:08:37.89,Default,,0,0,0,,Шайқастан кейін, біз сізге жарқын болашақты көрсеткенше
Dialogue: 0,0:08:38.60,0:08:40.56,Default,,0,0,0,,♬~
Dialogue: 0,0:08:46.56,0:08:50.94,Default,,0,0,0,,(DJ музыкасы)
Dialogue: 0,0:08:51.03,0:08:53.65,Default,,0,0,0,,маусым ұсталды -
Dialogue: 0,0:08:53.74,0:08:56.78,Default,,0,0,0,,Жоғары сынып оқушыларына диплом тапсыру рәсімі өтті.
Dialogue: 0,0:08:56.87,0:08:57.62,Default,,0,0,0,,Картоп Картоп Картоп
Dialogue: 0,0:08:57.62,0:08:58.78,Default,,0,0,0,,Картоп Картоп Картоп
Dialogue: 0,0:08:57.62,0:08:58.78,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:08:58.87,0:09:01.62,Default,,0,0,0,,Сіз жақсы күрестіңіз.
Dialogue: 0,0:08:58.87,0:09:01.62,Default,,0,0,0,,Картоп Картоп Картоп...
Dialogue: 0,0:09:03.54,0:09:05.96,Default,,0,0,0,,Хехе, мен бітірдім!
Dialogue: 0,0:09:06.04,0:09:09.09,Default,,0,0,0,,Нежире Сенпай~!
Dialogue: 0,0:09:09.17,0:09:10.84,Default,,0,0,0,,(Жасөспірімдердің айқайы)
Dialogue: 0,0:09:10.92,0:09:14.63,Default,,0,0,0,,Бітіру рәсімі Кешігіп қалғаным үшін кешіріңіз.
Dialogue: 0,0:09:14.72,0:09:19.39,Default,,0,0,0,,Шие гүлдері шашырап кетті, бірақ ең болмағанда басы керемет.
Dialogue: 0,0:09:19.47,0:09:21.01,Default,,0,0,0,,Алға!
Dialogue: 0,0:09:21.10,0:09:22.89,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:22.98,0:09:25.19,Default,,0,0,0,,Бұл бітіру кеші емес!
Dialogue: 0,0:09:25.27,0:09:27.10,Default,,0,0,0,,Бұл жылап тұрған оқиға.
Dialogue: 0,0:09:27.19,0:09:28.65,Default,,0,0,0,,Бұл мереке сияқты
Dialogue: 0,0:09:28.73,0:09:33.07,Default,,0,0,0,,Уау! Қандай бұралу! (толқын) хехехехе
Dialogue: 0,0:09:33.15,0:09:35.28,Default,,0,0,0,,Жарақат Ауырмайды ма? (толқын) Иә
Dialogue: 0,0:09:35.36,0:09:39.28,Default,,0,0,0,,Ауырды, бірақ мен бақыттымын, жақсы болғаным біртүрлі!
Dialogue: 0,0:09:39.87,0:09:41.58,Default,,0,0,0,,Мириоға рахмет
Dialogue: 0,0:09:41.66,0:09:45.46,Default,,0,0,0,,Табытқа құлап бара жатқанда, бізді бақылап тұрған адам.
Dialogue: 0,0:09:46.42,0:09:49.25,Default,,0,0,0,,Әр елге қажетті жабдықтарды сұрау
Dialogue: 0,0:09:49.33,0:09:53.51,Default,,0,0,0,,Қалпына келтіру жоспары Шығындарды есептеу және көтеру
Dialogue: 0,0:09:53.59,0:09:58.89,Default,,0,0,0,,Қолдау ұйымдастыру және бөлу Аурухана төсектерін қамтамасыз ету Медициналық көмекке
Dialogue: 0,0:09:58.97,0:10:03.14,Default,,0,0,0,,Адамнан тыс қоғамда да мұндай тез қалпына келудің артында не жатыр?
Dialogue: 0,0:10:03.22,0:10:05.93,Default,,0,0,0,,Әлемге әйгілі директор Незу...
Dialogue: 0,0:10:06.02,0:10:08.02,Default,,0,0,0,,BPM жоғарырақ көтерейік.
Dialogue: 0,0:10:08.10,0:10:10.61,Default,,0,0,0,,Әр елге тәсілдер жасалды.
Dialogue: 0,0:10:08.10,0:10:10.61,Default,,0,0,0,,Ха! Тек оңай айтыңыз
Dialogue: 0,0:10:11.77,0:10:13.11,Default,,0,0,0,,Басшы әрқашан болды
Dialogue: 0,0:10:13.73,0:10:16.45,Default,,0,0,0,,Мен шайқасқа қарап тұрдым.
Dialogue: 0,0:10:17.70,0:10:19.61,Default,,0,0,0,,Бұл жақсы қоштасу сөзі болды!
Dialogue: 0,0:10:19.70,0:10:22.20,Default,,0,0,0,,Репезен Юэй (Батыр) Дискорд Мавата Пучахензуа!
Dialogue: 0,0:10:22.20,0:10:23.62,Default,,0,0,0,,Репезен Юэй (Батыр) Мавата Пучахензуа келіспеушілік!
Dialogue: 0,0:10:22.20,0:10:23.62,Default,,0,0,0,,Бұл рэп-батл сияқты
Dialogue: 0,0:10:23.70,0:10:24.83,Default,,0,0,0,,Салқын ара
Dialogue: 0,0:10:23.70,0:10:24.83,Default,,0,0,0,,Енді жауап!
Dialogue: 0,0:10:24.83,0:10:24.91,Default,,0,0,0,,Енді жауап!
Dialogue: 0,0:10:24.91,0:10:25.95,Default,,0,0,0,,Енді жауап!
Dialogue: 0,0:10:24.91,0:10:25.95,Default,,0,0,0,,Керемет пе? Маған бірдеңе бар ма?
Dialogue: 0,0:10:25.95,0:10:26.04,Default,,0,0,0,,Керемет пе? Маған бірдеңе бар ма?
Dialogue: 0,0:10:26.04,0:10:27.62,Default,,0,0,0,,Керемет пе? Маған бірдеңе бар ма?
Dialogue: 0,0:10:26.04,0:10:27.62,Default,,0,0,0,,Репезен түлегі Лемиллион а.к.а.!
Dialogue: 0,0:10:27.62,0:10:27.71,Default,,0,0,0,,Repezen түлегі Лемиллион а.к.а.!
Dialogue: 0,0:10:27.71,0:10:29.12,Default,,0,0,0,,Репезен түлегі Лемиллион а.к.а.!
Dialogue: 0,0:10:27.71,0:10:29.12,Default,,0,0,0,,Рэп
Dialogue: 0,0:10:29.71,0:10:32.92,Default,,0,0,0,,Мирио Тогата!
Dialogue: 0,0:10:33.00,0:10:33.96,Default,,0,0,0,,(тонгата тыныс алу дыбысы)
Dialogue: 0,0:10:34.05,0:10:36.51,Default,,0,0,0,,Мен бүгін бос емеспін.
Dialogue: 0,0:10:36.59,0:10:40.97,Default,,0,0,0,,Біз үшін осында болғандарыңызға көп рахмет.
Dialogue: 0,0:10:41.05,0:10:42.97,Default,,0,0,0,,Гаг Сеннокай!
Dialogue: 0,0:10:43.06,0:10:46.56,Default,,0,0,0,,Көп нәрсе жоғалды және ештеңе пайда болмады.
Dialogue: 0,0:10:46.64,0:10:48.23,Default,,0,0,0,,Батырлар шайқасы дегеніміз не?
Dialogue: 0,0:10:48.31,0:10:51.73,Default,,0,0,0,,Ол әдетте теріс мәндерді нөлге қайтару үшін қолданылады.
Dialogue: 0,0:10:52.31,0:10:55.53,Default,,0,0,0,,Жалпы курс Қолдау курсы Менеджмент курсы
Dialogue: 0,0:10:55.61,0:10:59.03,Default,,0,0,0,,Әрбір студент осы оқу арқылы алған тәжірибесін толық пайдаланды.
Dialogue: 0,0:10:59.11,0:11:00.74,Default,,0,0,0,,Біз бір кісідей соғыстық.
Dialogue: 0,0:11:01.66,0:11:04.74,Default,,0,0,0,,Бірақ ол әлі нөлге оралған жоқ.
Dialogue: 0,0:11:05.33,0:11:09.37,Default,,0,0,0,,Біздің үш жылымыз болашаққа арналған.
Dialogue: 0,0:11:09.46,0:11:11.42,Default,,0,0,0,,Мақсат бүгін емес
Dialogue: 0,0:11:11.50,0:11:15.00,Default,,0,0,0,,Әзілсіз әлемде жарқын болашақ жоқ.
Dialogue: 0,0:11:15.09,0:11:17.80,Default,,0,0,0,,Көптеген адамдар күліп, бірге уақыт өткізетін позитивті әлем
Dialogue: 0,0:11:17.88,0:11:21.68,Default,,0,0,0,,Бұл біздің мақсат лентасы.
Dialogue: 0,0:11:22.30,0:11:23.55,Default,,0,0,0,,Тогата…
Dialogue: 0,0:11:24.30,0:11:26.14,Default,,0,0,0,,Маған қарашы, Түнгі көз.
Dialogue: 0,0:11:26.22,0:11:27.06,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:11:27.64,0:11:31.19,Default,,0,0,0,,Бүгін бастаймыз!
Dialogue: 0,0:11:31.27,0:11:34.02,Default,,0,0,0,,Құрметті қазіргі студенттер!
Dialogue: 0,0:11:37.19,0:11:38.74,Default,,0,0,0,,Жақында кездескенше! (Түлектер) Жарайсыңдар!
Dialogue: 0,0:11:38.82,0:11:42.86,Default,,0,0,0,,Шамасы, бұл Юэй бітіру салтанатының дәстүрі болса керек.
Dialogue: 0,0:11:42.95,0:11:44.87,Default,,0,0,0,,Және…
Dialogue: 0,0:11:45.41,0:11:48.62,Default,,0,0,0,,Әдетте мені сынып жетекшісі болуды сұрамайды, бірақ...
Dialogue: 0,0:11:48.70,0:11:51.37,Default,,0,0,0,,Ал, мән-жайлар – жағдайлар.
Dialogue: 0,0:11:51.46,0:11:52.83,Default,,0,0,0,,Тағы бір жыл, сәлем
Dialogue: 0,0:11:52.92,0:11:54.84,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:11:54.92,0:11:57.92,Default,,0,0,0,,Мен Айзава мырза үшін қуаныштымын~
Dialogue: 0,0:11:58.00,0:11:59.09,Default,,0,0,0,,Мен жыладым
Dialogue: 0,0:11:59.17,0:12:01.17,Default,,0,0,0,,Бұл соңы ма?
Dialogue: 0,0:11:59.17,0:12:01.17,Default,,0,0,0,,Мен бұл Айзава-сенсей болғанына қуаныштымын!
Dialogue: 0,0:12:01.17,0:12:01.26,Default,,0,0,0,,Мен бұл Айзава Сенсей болғанына қуаныштымын!
Dialogue: 0,0:12:01.26,0:12:02.63,Default,,0,0,0,,Мен бұл Айзава-сенсей болғанына қуаныштымын!
Dialogue: 0,0:12:01.26,0:12:02.63,Default,,0,0,0,,Сізге ауруханаға жатқызу керек пе?
Dialogue: 0,0:12:02.63,0:12:03.51,Default,,0,0,0,,Сізге ауруханаға жатқызу керек пе?
Dialogue: 0,0:12:03.59,0:12:05.35,Default,,0,0,0,,Тек демалыңыз және демалыңыз.
Dialogue: 0,0:12:05.43,0:12:08.18,Default,,0,0,0,,Бүгін бәріміз бірге болуымыз керек.
Dialogue: 0,0:12:08.27,0:12:09.93,Default,,0,0,0,,Сіз ақылға қонымды нәрсе айта бастадыңыз.
Dialogue: 0,0:12:10.02,0:12:10.85,Default,,0,0,0,,Ах!? (Серо) Иә!
Dialogue: 0,0:12:10.93,0:12:12.06,Default,,0,0,0,,Жатқан жерің жайлы...
Dialogue: 0,0:12:12.14,0:12:13.06,Default,,0,0,0,,Эй
Dialogue: 0,0:12:15.23,0:12:16.57,Default,,0,0,0,,Фу…
Dialogue: 0,0:12:16.65,0:12:18.15,Default,,0,0,0,,Қою
Dialogue: 0,0:12:19.15,0:12:20.19,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:20.19,0:12:21.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:20.19,0:12:21.03,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:12:21.03,0:12:21.82,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:12:24.45,0:12:27.58,Default,,0,0,0,,Қайта сәлем! Мен Юэйден кетемін
Dialogue: 0,0:12:28.16,0:12:29.33,Default,,0,0,0,,Бұл «Ерекшеліктердің сингулярлығы» деп аталатын апокалиптикалық теориялардың бірі.
Dialogue: 0,0:12:29.41,0:12:32.58,Default,,0,0,0,,Аояма: Сезімдерің өзгермегеніне сенімдісің бе?
Dialogue: 0,0:12:32.66,0:12:33.50,Default,,0,0,0,,Сізге рахмет
Dialogue: 0,0:12:33.58,0:12:35.79,Default,,0,0,0,,Мен барлығын бір үшін бөле алар едім!
Dialogue: 0,0:12:36.59,0:12:40.67,Default,,0,0,0,,Мұғалім де, Цукаучи мырза да менің қалуыма болатынын айтты.
Dialogue: 0,0:12:40.76,0:12:44.26,Default,,0,0,0,,Бірақ мен үнді өзім орнатқым келеді.
Dialogue: 0,0:12:44.97,0:12:47.80,Default,,0,0,0,,Қабылдауға Біреу үшін Барлығы's intentions қатысты.
Dialogue: 0,0:12:47.89,0:12:51.02,Default,,0,0,0,,Бүгінгідей бітіру кешін өткізе алмаймын.
Dialogue: 0,0:12:51.60,0:12:56.27,Default,,0,0,0,,Күнәларыңды өтеп, Батыр жолын тағы бір мақсат ет
Dialogue: 0,0:12:56.35,0:12:57.77,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:12:57.86,0:13:01.65,Default,,0,0,0,,Себебі мен сенің қолыңды алдым!
Dialogue: 0,0:13:05.41,0:13:06.45,Default,,0,0,0,,Иә
Dialogue: 0,0:13:07.12,0:13:09.45,Default,,0,0,0,,Тағы бір күні... міндетті түрде...
Dialogue: 0,0:13:10.12,0:13:12.70,Default,,0,0,0,,Мен бәрімен бірге жүрегімді тік ұстап тұрамын.
Dialogue: 0,0:13:13.29,0:13:15.21,Default,,0,0,0,,Аояма, сен...
Dialogue: 0,0:13:15.29,0:13:18.21,Default,,0,0,0,,Шынымды айтсам, сен басқаларға қарағанда Хансың!
Dialogue: 0,0:13:19.25,0:13:20.67,Default,,0,0,0,,Жыламаңдар, бәрің
Dialogue: 0,0:13:20.75,0:13:22.55,Default,,0,0,0,,Мен ылғалдануды жек көремін! (Ашидо) Уау!
Dialogue: 0,0:13:22.63,0:13:23.47,Default,,0,0,0,,Мабуши!
Dialogue: 0,0:13:23.55,0:13:26.68,Default,,0,0,0,,Мектеп фестиваліндегіден де дәлірек бақылау!
Dialogue: 0,0:13:26.76,0:13:29.22,Default,,0,0,0,,Міне, тосын сый.
Dialogue: 0,0:13:29.30,0:13:32.31,Default,,0,0,0,,А сыныбының жаңа мүшесі!
Dialogue: 0,0:13:33.23,0:13:34.27,Default,,0,0,0,,Енгізу қиын
Dialogue: 0,0:13:34.35,0:13:35.39,Default,,0,0,0,,(Барлығы қуанады)
Dialogue: 0,0:13:35.48,0:13:37.10,Default,,0,0,0,,Уау
Dialogue: 0,0:13:35.48,0:13:37.10,Default,,0,0,0,,Ақыл-ойды манипуляциялау! (Одзиро/Серо) А сыныбына келдің бе?
Dialogue: 0,0:13:37.10,0:13:38.31,Default,,0,0,0,,Ақыл-ойды манипуляциялау! (Одзиро/Серо) А сыныбына келдің бе?
Dialogue: 0,0:13:38.40,0:13:40.44,Default,,0,0,0,,Аудару! Бұл А тобы!
Dialogue: 0,0:13:40.52,0:13:43.74,Default,,0,0,0,,Керемет! Уақытша лицензия ресми түрде берілді ме?
Dialogue: 0,0:13:43.82,0:13:45.61,Default,,0,0,0,,Қош келдіңіз, Шинсу-кун!
Dialogue: 0,0:13:47.45,0:13:50.20,Default,,0,0,0,,Қоштасу кеші сияқты нәрселер туралы айту дұрыс емес пе?
Dialogue: 0,0:13:50.28,0:13:52.37,Default,,0,0,0,,Шынымен! (Серо) Бұл жаман болды!
Dialogue: 0,0:13:50.28,0:13:52.37,Default,,0,0,0,,Жақсы емес пе? Өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:13:52.45,0:13:53.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:53.70,0:13:55.37,Default,,0,0,0,,Аояма-кун, тоқта! тоқта!
Dialogue: 0,0:13:55.37,0:13:56.21,Default,,0,0,0,,Аояма-кун, тоқта! тоқта!
Dialogue: 0,0:13:55.37,0:13:56.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:56.29,0:13:58.67,Default,,0,0,0,,Әлі де "тұлға" қатесі бар сияқты!
Dialogue: 0,0:13:58.75,0:13:59.58,Default,,0,0,0,,Мен оны көріп тұрмын
Dialogue: 0,0:13:59.67,0:14:02.25,Default,,0,0,0,,Кешіріңіз (Ашидо) Уау~ Нағыз бет
Dialogue: 0,0:14:02.34,0:14:04.63,Default,,0,0,0,,Сүйкімді! (Хагакуре) Тоқта!
Dialogue: 0,0:14:04.71,0:14:05.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:06.42,0:14:08.89,Default,,0,0,0,,Құдай әрқашан бар ...
Dialogue: 0,0:14:08.97,0:14:10.55,Default,,0,0,0,,Уау, уф... уф (Айзава) Эй
Dialogue: 0,0:14:10.64,0:14:14.14,Default,,0,0,0,,Менің сізге айтатыным бар.
Dialogue: 0,0:14:15.10,0:14:16.73,Default,,0,0,0,,Батырлар курсы 2 және 3 курс
Dialogue: 0,0:14:16.81,0:14:21.65,Default,,0,0,0,,Енді біз апаттан зардап шеккен аймақты қалпына келтірумен айналысамыз.
Dialogue: 0,0:14:21.73,0:14:25.28,Default,,0,0,0,,Мен өкіл боламын және жетекшілік етемін.
Dialogue: 0,0:14:25.36,0:14:28.07,Default,,0,0,0,,Ағымдағы қалпына келтіру әрекеттеріне қосымша
Dialogue: 0,0:14:28.15,0:14:31.32,Default,,0,0,0,,Қауіпсіздіктің нашарлауына жол бермеу үшін елді аралаймыз.
Dialogue: 0,0:14:31.99,0:14:33.37,Default,,0,0,0,,Зейнетке шыққаннан кейін бәрі мүмкін
Dialogue: 0,0:14:33.45,0:14:35.20,Default,,0,0,0,,Және айтудың қажеті жоқ
Dialogue: 0,0:14:35.29,0:14:39.37,Default,,0,0,0,,Оқулықтарда айтылған Готару шайқасынан кейін
Dialogue: 0,0:14:39.46,0:14:43.25,Default,,0,0,0,,Оқулықта бұл сөзсіз жоқ Шатасу бар
Dialogue: 0,0:14:43.34,0:14:45.76,Default,,0,0,0,,Таңбалардың болмауы
Dialogue: 0,0:14:45.84,0:14:47.01,Default,,0,0,0,,Барлығы да бір үшін
Dialogue: 0,0:14:47.09,0:14:49.93,Default,,0,0,0,,Мен осындай шатасуға тудым.
Dialogue: 0,0:14:50.51,0:14:51.89,Default,,0,0,0,,Жарайсың ба? Дәуір баратын жер
Dialogue: 0,0:14:51.97,0:14:53.39,Default,,0,0,0,,Ах (Одзиро) Қайда бару керек...
Dialogue: 0,0:14:53.47,0:14:57.06,Default,,0,0,0,,Аа, мен бұрынғы мектебіммен бір сыныпта оқимын.
Dialogue: 0,0:14:57.14,0:14:59.39,Default,,0,0,0,,Балалар сендер оқудан шығарылған жоқсыңдар ғой?
Dialogue: 0,0:14:59.48,0:15:00.65,Default,,0,0,0,,Мен ең болмағанда алған ақшамды қайтарып бергім келеді.
Dialogue: 0,0:15:00.73,0:15:04.90,Default,,0,0,0,,Бізді бүлдірдің, ажалдың дәмін бір рет татасың.
Dialogue: 0,0:15:04.98,0:15:06.48,Default,,0,0,0,,Бұл қорқынышты болды~
Dialogue: 0,0:15:06.57,0:15:08.40,Default,,0,0,0,,Ей, келіспеушілік, болды, жүр.
Dialogue: 0,0:15:08.49,0:15:10.53,Default,,0,0,0,,Фуфу иә
Dialogue: 0,0:15:11.66,0:15:12.66,Default,,0,0,0,,Күйік
Dialogue: 0,0:15:12.74,0:15:17.20,Default,,0,0,0,,Соның арқасында мен батырдың не үшін қажет екенін түсіндім.
Dialogue: 0,0:15:17.29,0:15:18.16,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:15:18.79,0:15:20.54,Default,,0,0,0,,Сәлем
Dialogue: 0,0:15:24.29,0:15:26.67,Default,,0,0,0,,Жоқ, сіз жаңа студентсіз.
Dialogue: 0,0:15:26.76,0:15:29.59,Default,,0,0,0,,Біз де ертең қарт боламыз ба?
Dialogue: 0,0:15:29.67,0:15:31.34,Default,,0,0,0,,Жылдам ілгерілеу
Dialogue: 0,0:15:31.43,0:15:33.26,Default,,0,0,0,,Мен ертең бос боламын.
Dialogue: 0,0:15:33.35,0:15:35.76,Default,,0,0,0,,Бірақ маған демалуға уақыт берілді.
Dialogue: 0,0:15:35.85,0:15:37.35,Default,,0,0,0,,Уф... жай ғана ысқылауға болады.
Dialogue: 0,0:15:37.43,0:15:38.48,Default,,0,0,0,,Серо-кун болды ма?
Dialogue: 0,0:15:38.56,0:15:39.48,Default,,0,0,0,,Жақсы емес.
Dialogue: 0,0:15:39.56,0:15:42.19,Default,,0,0,0,,Мен оның басқаша болғаны жақсы деп ойладым...
Dialogue: 0,0:15:42.85,0:15:45.07,Default,,0,0,0,,Рейхи-сан (Рейхи) Деку-кунға дейін
Dialogue: 0,0:15:45.82,0:15:49.07,Default,,0,0,0,,Дәлірек айтсақ, бұл жарақат салдарынан болды, солай ма?
Dialogue: 0,0:15:49.15,0:15:51.03,Default,,0,0,0,,Иә, ол қайтадан өседі деп үміттенемін.
Dialogue: 0,0:15:51.11,0:15:53.62,Default,,0,0,0,,Имечан, дәлірек айтсақ, Токоями.
Dialogue: 0,0:15:53.70,0:15:55.37,Default,,0,0,0,,Бұл басқаша, бірақ маған ұнайды
Dialogue: 0,0:15:56.03,0:15:57.83,Default,,0,0,0,,Көрдім, маған ұнайды.
Dialogue: 0,0:15:57.91,0:15:58.87,Default,,0,0,0,,Ах
Dialogue: 0,0:15:58.95,0:16:01.08,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:16:02.71,0:16:03.54,Default,,0,0,0,,(Яо) Камина-сан… (Мибори) Бізді алдап қалды.
Dialogue: 0,0:16:03.63,0:16:08.09,Default,,0,0,0,,А-а... Қалай ойлайсың, Тодороки қоштасу кешіне қатыса алады ма?
Dialogue: 0,0:16:08.17,0:16:09.01,Default,,0,0,0,,А...
Dialogue: 0,0:16:09.71,0:16:11.26,Default,,0,0,0,,Бүгін болмаса, кез келген уақытта
Dialogue: 0,0:16:12.18,0:16:13.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:14.80,0:16:16.76,Default,,0,0,0,,Онда мен осында боламын.
Dialogue: 0,0:16:17.56,0:16:18.56,Default,,0,0,0,,Жоқ, мәселе сол жерде емес.
Dialogue: 0,0:16:21.14,0:16:22.44,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:16:26.65,0:16:29.40,Default,,0,0,0,,А... Жарайды.
Dialogue: 0,0:16:30.78,0:16:33.24,Default,,0,0,0,,Келмесең жарайды дедім.
Dialogue: 0,0:16:33.32,0:16:37.58,Default,,0,0,0,,Айтсаң, сен де, Фуми Нацуо.
Dialogue: 0,0:16:37.66,0:16:39.70,Default,,0,0,0,,Анашым Бірақ...
Dialogue: 0,0:16:39.79,0:16:42.87,Default,,0,0,0,,Соны айтсаң, сен де салқын.
Dialogue: 0,0:16:43.37,0:16:46.25,Default,,0,0,0,,Мен мұнда парыз сезімімен келген жоқпын.
Dialogue: 0,0:16:46.96,0:16:48.75,Default,,0,0,0,,Барлығы, солай ма?
Dialogue: 0,0:16:51.38,0:16:55.68,Default,,0,0,0,,Әңгімелесу мүмкін, бірақ күніне бірнеше минут.
Dialogue: 0,0:16:57.30,0:16:59.56,Default,,0,0,0,,Бейбіт өлімге бет бұру
Dialogue: 0,0:17:00.14,0:17:03.02,Default,,0,0,0,,Бұл қазіргі Туя Тодороки.
Dialogue: 0,0:17:04.48,0:17:07.15,Default,,0,0,0,,А...
Dialogue: 0,0:17:07.23,0:17:09.23,Default,,0,0,0,,Бірінен соң бірі...
Dialogue: 0,0:17:09.32,0:17:13.15,Default,,0,0,0,,Хахаха... бұл туристік орын емес.
Dialogue: 0,0:17:13.24,0:17:16.07,Default,,0,0,0,,(Тояның жөтелі)
Dialogue: 0,0:17:16.16,0:17:16.99,Default,,0,0,0,,Туя
Dialogue: 0,0:17:17.07,0:17:22.33,Default,,0,0,0,,(Тояның ауыр тыныс алуы)
Dialogue: 0,0:17:24.96,0:17:27.21,Default,,0,0,0,,Мен болашақ туралы айту үшін келдім.
Dialogue: 0,0:17:28.75,0:17:29.71,Default,,0,0,0,,Туя
Dialogue: 0,0:17:30.30,0:17:33.72,Default,,0,0,0,,Мен батырлықтан зейнеткерлікке шығамын.
Dialogue: 0,0:17:35.55,0:17:39.47,Default,,0,0,0,,Мен мұны шайқас аяқталғаннан кейін жасауды ойладым.
Dialogue: 0,0:17:39.55,0:17:42.97,Default,,0,0,0,,Мен енді өз бетімше тұра да алмаймын.
Dialogue: 0,0:17:44.06,0:17:46.98,Default,,0,0,0,,Кейіпкер Эндевор өртеніп өлді.
Dialogue: 0,0:17:47.98,0:17:51.98,Default,,0,0,0,,Сіздің жалыныңыз басқалардан күштірек болды.
Dialogue: 0,0:17:52.07,0:17:55.49,Default,,0,0,0,,Түсіндім, бұл үшін кешіріңіз.
Dialogue: 0,0:17:55.57,0:17:59.99,Default,,0,0,0,,Іс біткен соң мақтанба, ақымақ.
Dialogue: 0,0:18:00.07,0:18:02.16,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:18:02.24,0:18:05.00,Default,,0,0,0,,Туя мені жақсы біледі.
Dialogue: 0,0:18:06.25,0:18:07.50,Default,,0,0,0,,Мен оны көптен бері қарап жүрмін.
Dialogue: 0,0:18:11.21,0:18:14.46,Default,,0,0,0,,Сіз оны көргім келді.
Dialogue: 0,0:18:14.55,0:18:16.67,Default,,0,0,0,,Бірақ мен оны көрмедім.
Dialogue: 0,0:18:17.34,0:18:19.72,Default,,0,0,0,,Юта Отокоцу
Dialogue: 0,0:18:19.80,0:18:23.68,Default,,0,0,0,,Сенің жылуың менің «Тозақ жалыны»
Dialogue: 0,0:18:24.72,0:18:28.19,Default,,0,0,0,,Мен күн сайын сол айыптау видеосын қараймын.
Dialogue: 0,0:18:28.27,0:18:31.40,Default,,0,0,0,,Әке!
Dialogue: 0,0:18:31.48,0:18:34.82,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:18:35.44,0:18:36.78,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:18:38.15,0:18:39.66,Default,,0,0,0,,күнде келеді
Dialogue: 0,0:18:40.16,0:18:41.91,Default,,0,0,0,,Әңгімелесейік
Dialogue: 0,0:18:43.03,0:18:45.54,Default,,0,0,0,,Тым кеш болса да
Dialogue: 0,0:18:46.16,0:18:47.50,Default,,0,0,0,,Әңгімелесейік
Dialogue: 0,0:18:48.00,0:18:49.75,Default,,0,0,0,,Жүрек соғу жиілігінің жоғарылауы
Dialogue: 0,0:18:49.83,0:18:51.17,Default,,0,0,0,,Тағы да ауыртпалық...
Dialogue: 0,0:18:51.75,0:18:55.92,Default,,0,0,0,,Суық Нацуо Фуюми Шото
Dialogue: 0,0:18:56.71,0:18:59.18,Default,,0,0,0,,Сен қалған уақытта сөйлесейік.
Dialogue: 0,0:18:59.76,0:19:04.68,Default,,0,0,0,,Мені жек көрсең, не қаласаң, соны айт.
Dialogue: 0,0:19:05.35,0:19:07.35,Default,,0,0,0,,Туя-нии, мен де...
Dialogue: 0,0:19:07.43,0:19:10.60,Default,,0,0,0,,Менің айтқым келетін нәрселер өте көп.
Dialogue: 0,0:19:11.69,0:19:13.11,Default,,0,0,0,,Бүгін тоқталайық.
Dialogue: 0,0:19:13.19,0:19:14.90,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:19:14.98,0:19:19.11,Default,,0,0,0,,Кешіріңіз. Соңғы бір нәрсе, жарай ма?
Dialogue: 0,0:19:20.20,0:19:22.49,Default,,0,0,0,,Сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,0:19:24.24,0:19:27.50,Default,,0,0,0,,Туя-нии, сенің сүйікті тағамың қандай?
Dialogue: 0,0:19:27.58,0:19:30.25,Default,,0,0,0,,(Тояның ауыр тыныс алуы)
Dialogue: 0,0:19:33.04,0:19:35.04,Default,,0,0,0,,Бұл физикалық күштің шегі.
Dialogue: 0,0:19:35.13,0:19:37.80,Default,,0,0,0,,Бүгін ұйықтайын, ертең кездескенше
Dialogue: 0,0:19:46.43,0:19:47.47,Default,,0,0,0,,Соба
Dialogue: 0,0:19:50.23,0:19:51.23,Default,,0,0,0,,Дәл солай.
Dialogue: 0,0:19:52.81,0:19:55.48,Default,,0,0,0,,Бұдан артық кез келген параллель түзу!
Dialogue: 0,0:19:56.07,0:19:59.40,Default,,0,0,0,,Мәжбүр болса да қиылысайық
Dialogue: 0,0:20:03.16,0:20:04.78,Default,,0,0,0,,Шынында да, екі алып қазір бетпе-бет келеді!
Dialogue: 0,0:20:05.91,0:20:07.37,Default,,0,0,0,,енді біркелкі таралып жатқандай сезіледі
Dialogue: 0,0:20:10.37,0:20:11.87,Default,,0,0,0,,Мұның бәрі мен үшін.
Dialogue: 0,0:20:11.96,0:20:15.96,Default,,0,0,0,,Кешіріңіз, бірақ менің сезімім өзгерген жоқ. Мен енді сенімен араласпаймын.
Dialogue: 0,0:20:16.04,0:20:16.88,Default,,0,0,0,,О
Dialogue: 0,0:20:18.05,0:20:19.84,Default,,0,0,0,,Мен қызыммен тіркелгім келеді
Dialogue: 0,0:20:19.92,0:20:22.38,Default,,0,0,0,,Рәсім де, таныстыру да жоқ
Dialogue: 0,0:20:22.47,0:20:25.64,Default,,0,0,0,,А, бұл жаман болды.
Dialogue: 0,0:20:27.56,0:20:28.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:28.97,0:20:31.23,Default,,0,0,0,,Сіздің әпкеңіз ше? Сіз жұмысыңызды тастадыңыз, солай ма?
Dialogue: 0,0:20:31.31,0:20:32.14,Default,,0,0,0,,Иә
Dialogue: 0,0:20:32.23,0:20:36.73,Default,,0,0,0,,Бірақ оқушымның анасы мені жаңа жұмыс орнымен таныстырды.
Dialogue: 0,0:20:36.81,0:20:38.65,Default,,0,0,0,,Ол мені қолдайтынын айтты.
Dialogue: 0,0:20:41.65,0:20:44.45,Default,,0,0,0,,Шынымды айтсам, өз жауапкершілігімді орындадым деп ойлаймын.
Dialogue: 0,0:20:44.53,0:20:46.62,Default,,0,0,0,,Мен де жазаландым деп ойлаймын.
Dialogue: 0,0:20:47.28,0:20:49.04,Default,,0,0,0,,Бұл жеткілікті емес пе?
Dialogue: 0,0:20:49.70,0:20:54.67,Default,,0,0,0,,Мен өмір бойы жасаған қылмыстарым үшін өтемақы төлеймін және кешірім сұраймын.
Dialogue: 0,0:20:54.75,0:20:57.04,Default,,0,0,0,,Қараудың қажеті жоқ
Dialogue: 0,0:20:57.13,0:21:02.17,Default,,0,0,0,,Саған түскен ұшқындарды қолымнан келгенше ұстаймын.
Dialogue: 0,0:21:02.26,0:21:06.43,Default,,0,0,0,,Тірі қалудың қандай да бір мағынасы болса, солай.
Dialogue: 0,0:21:07.10,0:21:08.43,Default,,0,0,0,,Бұл тозақ
Dialogue: 0,0:21:09.26,0:21:10.43,Default,,0,0,0,,О
Dialogue: 0,0:21:13.52,0:21:16.31,Default,,0,0,0,,Мен биге шақыру алдым.
Dialogue: 0,0:21:17.81,0:21:19.19,Default,,0,0,0,,Себебі сен оларды мүлде үйге әкетпейсің ғой.
Dialogue: 0,0:21:19.77,0:21:22.69,Default,,0,0,0,,Мен сенің әкеңді жақсы деп ойладым.
Dialogue: 0,0:21:24.86,0:21:27.41,Default,,0,0,0,,Шото ше? Сіз мектепке қайтасыз ба?
Dialogue: 0,0:21:27.49,0:21:28.32,Default,,0,0,0,,Иә
Dialogue: 0,0:21:28.41,0:21:30.37,Default,,0,0,0,,Сіз де мініңіз, әпке.
Dialogue: 0,0:21:30.45,0:21:32.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:37.79,0:21:40.21,Default,,0,0,0,,Әке Ана
Dialogue: 0,0:21:40.29,0:21:43.92,Default,,0,0,0,,Менде барлығы А сыныбында бар, сондықтан бәрі жақсы.
Dialogue: 0,0:21:44.01,0:21:47.55,Default,,0,0,0,,Өйткені мен қандай болсам, солай бола аламын
Dialogue: 0,0:21:48.39,0:21:49.47,Default,,0,0,0,,Шынында да, екі алып қазір бетпе-бет келеді!
Dialogue: 0,0:21:50.22,0:21:51.26,Default,,0,0,0,,Иә
Dialogue: 0,0:21:51.35,0:21:55.48,Default,,0,0,0,,♪～
Dialogue: 0,0:21:55.48,0:21:56.60,Default,,0,0,0,,♪～
Dialogue: 0,0:21:55.48,0:21:56.60,Default,,0,0,0,,Оу!
Dialogue: 0,0:21:56.69,0:21:59.61,Default,,0,0,0,,Бұл тез болды. Жақсы болды ма?
Dialogue: 0,0:21:59.69,0:22:00.61,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:22:00.69,0:22:03.07,Default,,0,0,0,,Ет жейік~
Dialogue: 0,0:22:03.15,0:22:05.99,Default,,0,0,0,,Идиот! Сізді жігерлі ететін сөздер туралы сөйлесейік!
Dialogue: 0,0:22:07.36,0:22:09.16,Default,,0,0,0,,Тозақ... бірақ
Dialogue: 0,0:22:09.24,0:22:10.87,Default,,0,0,0,,(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:22:13.79,0:22:14.62,Default,,0,0,0,,Иә
Dialogue: 0,0:22:15.91,0:22:17.62,Default,,0,0,0,,Қарап тұрған адамдар бар.
Dialogue: 0,0:22:24.01,0:22:25.09,Default,,0,0,0,,(Мобильді электрондық поштаны қабылдау дыбысы)
Dialogue: 0,0:22:25.17,0:22:27.30,Default,,0,0,0,,Қайсарлық~
Dialogue: 0,0:22:28.51,0:22:28.93,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:22:28.93,0:22:30.85,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:22:28.93,0:22:30.85,Default,,0,0,0,,Ол қалай өзгереді?
Dialogue: 0,0:22:30.85,0:22:30.93,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:22:30.93,0:22:33.18,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:22:30.93,0:22:33.18,Default,,0,0,0,,Қалай өзгертуге болады
Dialogue: 0,0:22:33.18,0:22:33.72,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:22:33.81,0:22:35.60,Default,,0,0,0,,А, сәлем, Мера-сан.
Dialogue: 0,0:22:35.68,0:22:38.73,Default,,0,0,0,,Бұл Хокс, Қоғамдық қауіпсіздік комиссиясының жаңа төрағасы.
Dialogue: 0,0:23:15.47,0:23:20.48,Default,,0,0,0,,～♪
Dialogue: 0,0:23:21.77,0:23:22.90,Default,,0,0,0,,Мен бұны реттеймін
Dialogue: 0,0:23:23.65,0:23:25.57,Default,,0,0,0,,Ұзақ шайқас аяқталды
Dialogue: 0,0:23:26.61,0:23:29.82,Default,,0,0,0,,Бірақ шайқастан кейін қайғы келеді.
Dialogue: 0,0:23:30.61,0:23:35.33,Default,,0,0,0,,Бұл жоғалған өмірдің азабы, жоғалтқанның жарасы.
Dialogue: 0,0:23:35.91,0:23:37.79,Default,,0,0,0,,Мен қолымды созғым келеді
Dialogue: 0,0:23:37.87,0:23:43.42,Default,,0,0,0,,Мұңыңа жақын боламын, Жүрегің аз да болса жеңілдеп қалсын.
Dialogue: 0,0:23:44.00,0:23:46.92,Default,,0,0,0,,Келесі жолы «Күлгенді ұнататын қыз»
Dialogue: 0,0:23:47.51,0:23:50.93,Default,,0,0,0,,Бұл қосымша көмек болса да
Dialogue: 0,0:23:52.43,0:23:58.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
