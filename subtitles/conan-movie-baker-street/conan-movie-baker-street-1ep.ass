Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:22.77,0:00:26.77,Default,,0,0,0,,(ағылшынша "caster" сөзі)
Dialogue: 0,0:01:54.61,0:01:56.28,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:01:58.57,0:02:01.32,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:02:05.58,0:02:06.41,Default,,0,0,0,,Ха…
Dialogue: 0,0:02:13.04,0:02:14.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:24.31,0:02:26.18,Default,,0,0,0,,(Эндевор) Мені сендермен бірдей санама. Денем қазірдің өзінде сал болып қалды.
Dialogue: 0,0:02:26.27,0:02:27.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:27.77,0:02:30.77,Default,,0,0,0,,(SP Ағылшын тілі)
Dialogue: 0,0:02:37.57,0:02:38.65,Default,,0,0,0,,(Батырма басылған дыбысы)
Dialogue: 0,0:02:39.45,0:02:42.32,Default,,0,0,0,,(Шиндлердің ағылшыншасы)
Dialogue: 0,0:02:48.37,0:02:50.00,Default,,0,0,0,,Фу…
Dialogue: 0,0:02:53.33,0:02:56.63,Default,,0,0,0,,Қош бол досым...
Dialogue: 0,0:02:56.71,0:02:57.92,Default,,0,0,0,,(есік тұтқасының айналу дыбысы)
Dialogue: 0,0:02:58.01,0:03:00.88,Default,,0,0,0,,(Шиндлердің ағылшыншасы)
Dialogue: 0,0:03:01.93,0:03:02.93,Default,,0,0,0,,Хироки!
Dialogue: 0,0:03:05.35,0:03:06.93,Default,,0,0,0,,Хироки!
Dialogue: 0,0:03:21.15,0:03:23.11,Default,,0,0,0,,Хмф, хмф!
Dialogue: 0,0:03:36.25,0:03:39.76,Default,,0,0,0,,Мен Нұхтың кемесі сияқты ұша аламын ба деп ойлаймын...
Dialogue: 0,0:03:40.51,0:03:41.72,Default,,0,0,0,,Хмм!
Dialogue: 0,0:03:42.88,0:03:45.93,Default,,0,0,0,,(Шиндлердің ағылшыншасы)
Dialogue: 0,0:03:46.01,0:03:47.60,Default,,0,0,0,,Хаха...
Dialogue: 0,0:03:47.68,0:03:48.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:51.60,0:03:52.94,Default,,0,0,0,,Хироки!
Dialogue: 0,0:03:53.90,0:03:55.65,Default,,0,0,0,,(SP Ағылшын тілі)
Dialogue: 0,0:04:13.87,0:04:15.29,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:18.84,0:04:23.84,Default,,0,0,0,,♪~
Dialogue: 0,0:04:40.69,0:04:43.24,Default,,0,0,0,,Мен орта мектептің детективімін, Шиничи Кудо
Dialogue: 0,0:04:43.99,0:04:46.28,Default,,0,0,0,,Бала күнгі досы және сыныптасы Ран Моримен
Dialogue: 0,0:04:46.36,0:04:48.53,Default,,0,0,0,,Ойын-сауық саябағына барыңыз
Dialogue: 0,0:04:48.62,0:04:49.70,Default,,0,0,0,,Қара киінген адам
Dialogue: 0,0:04:49.78,0:04:51.91,Default,,0,0,0,,Мен күдікті транзакцияның куәсі болдым.
Dialogue: 0,0:04:53.04,0:04:55.08,Default,,0,0,0,,Мен мәмілені қарауға берілгенмін.
Dialogue: 0,0:04:55.16,0:04:58.63,Default,,0,0,0,,Артынан келе жатқан басқа серігін байқамадым.
Dialogue: 0,0:04:59.42,0:05:02.96,Default,,0,0,0,,Ол кісі маған у ішті.
Dialogue: 0,0:05:03.05,0:05:04.22,Default,,0,0,0,,Сіз оянғанда...
Dialogue: 0,0:05:04.80,0:05:07.18,Default,,0,0,0,,Менің денем кішірейіп кетті.
Dialogue: 0,0:05:07.26,0:05:09.93,Default,,0,0,0,,Егер олар Шиничи Кудоның тірі екенін білсе ше?
Dialogue: 0,0:05:10.01,0:05:11.72,Default,,0,0,0,,Менің өмірімдегі тағы бір әрекет
Dialogue: 0,0:05:11.81,0:05:13.89,Default,,0,0,0,,Айналаңыздағы адамдарға да қауіп төнеді.
Dialogue: 0,0:05:14.64,0:05:15.77,Default,,0,0,0,,Доктор Агасаның кеңесі бойынша
Dialogue: 0,0:05:15.85,0:05:17.69,Default,,0,0,0,,Мен өзімнің шынайы тұлғамды жасыруды шештім.
Dialogue: 0,0:05:17.77,0:05:19.65,Default,,0,0,0,,Ран менің атымды сұрады
Dialogue: 0,0:05:19.73,0:05:22.11,Default,,0,0,0,,Бірден өзін Эдогава Конан деп атады
Dialogue: 0,0:05:22.19,0:05:23.82,Default,,0,0,0,,Өз ақпаратын алу
Dialogue: 0,0:05:23.90,0:05:26.53,Default,,0,0,0,,Ранның үйіне көшіп келді, оның әкесі детектив болып жұмыс істейді.
Dialogue: 0,0:05:26.61,0:05:28.24,Default,,0,0,0,,Ой! Апыр-ай!
Dialogue: 0,0:05:28.32,0:05:29.16,Default,,0,0,0,,Сіз —
Dialogue: 0,0:05:29.74,0:05:31.16,Default,,0,0,0,,Мен сені қолдаймын!
Dialogue: 0,0:05:31.24,0:05:32.74,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:05:33.45,0:05:35.33,Default,,0,0,0,,Менің шынайы болмысымды білетін адам...
Dialogue: 0,0:05:35.41,0:05:36.46,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:05:37.25,0:05:40.17,Default,,0,0,0,,Дәрігерден басқа Ай Хайбара ғана бар.
Dialogue: 0,0:05:40.96,0:05:43.76,Default,,0,0,0,,Ол қара киімділердің досы болды, бірақ
Dialogue: 0,0:05:43.84,0:05:45.59,Default,,0,0,0,,Ұйымнан қашу кезінде
Dialogue: 0,0:05:45.67,0:05:47.55,Default,,0,0,0,,Маған тағайындалған дәріні ішіңіз.
Dialogue: 0,0:05:47.63,0:05:49.55,Default,,0,0,0,,Менің денем кішірейіп кетті.
Dialogue: 0,0:05:50.05,0:05:51.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:00.69,0:06:01.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:02.65,0:06:04.57,Default,,0,0,0,,Ммм...
Dialogue: 0,0:06:04.65,0:06:06.24,Default,,0,0,0,,Ии!
Dialogue: 0,0:06:06.32,0:06:08.91,Default,,0,0,0,,Қанша уақыт өтсе де менде бұзақылық бар.
Dialogue: 0,0:06:08.99,0:06:11.12,Default,,0,0,0,,Менің ата-анам бала сияқты
Dialogue: 0,0:06:11.20,0:06:14.70,Default,,0,0,0,,Менің әкем әлемге әйгілі жұмбақ жазушы.
Dialogue: 0,0:06:14.79,0:06:15.83,Default,,0,0,0,,Юсаку Кудо
Dialogue: 0,0:06:15.91,0:06:17.46,Default,,0,0,0,,«Түнгі барон» сериясы дегеніміз не?
Dialogue: 0,0:06:17.54,0:06:19.67,Default,,0,0,0,,Білмейтін жұмбақ маньяк жоқ.
Dialogue: 0,0:06:22.50,0:06:24.38,Default,,0,0,0,,Менің анам Юкико Кудо
Dialogue: 0,0:06:24.46,0:06:28.22,Default,,0,0,0,,20 жасында зейнеткерлікке шығып, тұрмысқа шыққан аңызға айналған айдол актриса
Dialogue: 0,0:06:28.84,0:06:31.80,Default,,0,0,0,,Енді ол жай ғана ыңырсыған кемпір.
Dialogue: 0,0:06:33.22,0:06:34.93,Default,,0,0,0,,Әзірге, И
Dialogue: 0,0:06:35.01,0:06:38.10,Default,,0,0,0,,Бұл алыстағы туыстың баласы болуы керек.
Dialogue: 0,0:06:38.89,0:06:43.11,Default,,0,0,0,,Соңғы кездері олардың жүздерін көрмедім, бірақ анам мен әкемнің не болып жатқанына таң қаламын.
Dialogue: 0,0:06:44.44,0:06:45.90,Default,,0,0,0,,Менде бәрі жақсы!
Dialogue: 0,0:06:46.57,0:06:48.78,Default,,0,0,0,,Кішірейсек те, миымыз бірдей
Dialogue: 0,0:06:48.86,0:06:50.82,Default,,0,0,0,,Лабиринті жоқ керемет детектив ~♪
Dialogue: 0,0:06:50.82,0:06:51.82,Default,,0,0,0,,~♪
Dialogue: 0,0:06:51.82,0:06:54.28,Default,,0,0,0,,～♪ Әрқашан бір шындық бар!
Dialogue: 0,0:07:02.96,0:07:05.34,Default,,0,0,0,,Мұнда Бейка Сити Холлында
Dialogue: 0,0:07:05.42,0:07:07.05,Default,,0,0,0,,Жапон ойын жасаушылары
Dialogue: 0,0:07:07.13,0:07:07.92,Default,,0,0,0,,Шиндлер компаниясымен бірлесіп әзірленген—
Dialogue: 0,0:07:07.92,0:07:09.55,Default,,0,0,0,,Шиндлер компаниясымен бірлесіп әзірленген—
Dialogue: 0,0:07:07.92,0:07:09.55,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:09.55,0:07:09.63,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:09.63,0:07:11.43,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:09.63,0:07:11.43,Default,,0,0,0,,Модельдеу ойынын көріңіз
Dialogue: 0,0:07:11.43,0:07:11.51,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:11.51,0:07:13.76,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:11.51,0:07:13.76,Default,,0,0,0,,Керемет премьера болғалы тұр.
Dialogue: 0,0:07:19.06,0:07:23.56,Default,,0,0,0,,Ах, Шиндлер компаниясының президенті Шиндлер келді.
Dialogue: 0,0:07:25.15,0:07:27.53,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:27.61,0:07:29.07,Default,,0,0,0,,- (Тілші) Президент! -(Репортер) Маған бір сәт беріңізші.
Dialogue: 0,0:07:27.61,0:07:29.07,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:29.07,0:07:29.15,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:29.15,0:07:30.78,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:29.15,0:07:30.78,Default,,0,0,0,,Осылай өтінемін!
Dialogue: 0,0:07:30.78,0:07:31.99,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:07:33.11,0:07:36.95,Default,,0,0,0,,Енді БАҚ арқылы бізге тараған материалдарға сәйкес,
Dialogue: 0,0:07:37.03,0:07:39.58,Default,,0,0,0,,Бұл ойынның лақап аты Кокон.
Dialogue: 0,0:07:39.66,0:07:43.75,Default,,0,0,0,,Піллә тәрізді капсулаға кіріп, гипноздық күйге кіріңіз.
Dialogue: 0,0:07:43.83,0:07:47.21,Default,,0,0,0,,Дауысты тану жүйесі бар ойынмен әрекеттесу кезінде
Dialogue: 0,0:07:47.30,0:07:50.13,Default,,0,0,0,,Виртуалды шындық әлемінде ойнау—
Dialogue: 0,0:07:50.21,0:07:53.72,Default,,0,0,0,,Ең соңғы технологияны біріктіретін ойын.
Dialogue: 0,0:07:53.80,0:07:57.18,Default,,0,0,0,,Бұл ойын ойыншыларға еркін ойнауға мүмкіндік береді—
Dialogue: 0,0:07:57.26,0:07:59.68,Default,,0,0,0,,Кезеңнің 5 түрі бар.
Dialogue: 0,0:07:59.77,0:08:02.31,Default,,0,0,0,,Бұл қандай виртуалды шындық әлемі?
Dialogue: 0,0:08:02.39,0:08:06.31,Default,,0,0,0,,Бүгін балалар ойынға бірінші рет қатысып,...
Dialogue: 0,0:08:06.40,0:08:09.82,Default,,0,0,0,,Толық жасырын презентацияны алдын ала қарау
Dialogue: 0,0:08:10.69,0:08:13.78,Default,,0,0,0,,50 іріктелген орта мектеп жасына дейінгі ұлдар мен қыздар
Dialogue: 0,0:08:13.86,0:08:17.20,Default,,0,0,0,,Жапонияда коконды бастан кешірген бірінші адам болыңыз.
Dialogue: 0,0:08:20.75,0:08:22.08,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:08:22.16,0:08:26.13,Default,,0,0,0,,Мен бейне ойын рециталында бірдеңе білгенімді қалаймын.
Dialogue: 0,0:08:26.21,0:08:28.67,Default,,0,0,0,,Мен осы рециталға жеткенше.
Dialogue: 0,0:08:28.75,0:08:31.59,Default,,0,0,0,,Өнеркәсіптік тыңшылық сияқты көптеген сахна артындағы жұмыстар болған сияқты.
Dialogue: 0,0:08:32.26,0:08:33.88,Default,,0,0,0,,Коконның пайда болуымен
Dialogue: 0,0:08:33.97,0:08:37.97,Default,,0,0,0,,Ойын индустриясының картасы бірден өзгереді деп айтылады.
Dialogue: 0,0:08:38.05,0:08:39.26,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:40.22,0:08:41.93,Default,,0,0,0,,Не? Яғни
Dialogue: 0,0:08:42.02,0:08:44.89,Default,,0,0,0,,Әй, солай шығар, Кокон!
Dialogue: 0,0:08:44.98,0:08:47.48,Default,,0,0,0,,Мен де Коконды ойнауым керек.
Dialogue: 0,0:08:47.56,0:08:49.82,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:08:49.90,0:08:52.07,Default,,0,0,0,,Бізді кешке шақырды, бірақ
Dialogue: 0,0:08:52.15,0:08:55.03,Default,,0,0,0,,Мен коконды көру үшін таңдалған жоқпын.
Dialogue: 0,0:08:55.11,0:08:57.62,Default,,0,0,0,,Бірақ тарихи оқиғалар
Dialogue: 0,0:08:57.70,0:09:01.74,Default,,0,0,0,,Оны ойында сезіну аздап қызықты.
Dialogue: 0,0:09:01.83,0:09:02.66,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:09:02.75,0:09:06.12,Default,,0,0,0,,Нақты уақыттағы саяхатқа шыққандай сезінесіз!
Dialogue: 0,0:09:06.21,0:09:08.21,Default,,0,0,0,,Жай ойын, солай ма?
Dialogue: 0,0:09:08.29,0:09:09.42,Default,,0,0,0,,Конан кім?
Dialogue: 0,0:09:09.50,0:09:11.75,Default,,0,0,0,,Сіз компьютерлік ойындарда жақсы емессіз, солай ма?
Dialogue: 0,0:09:11.84,0:09:13.46,Default,,0,0,0,,Әлі де «Ақтық квестте»
Dialogue: 0,0:09:13.55,0:09:15.17,Default,,0,0,0,,Қиын болып тұрмын.
Dialogue: 0,0:09:15.26,0:09:17.80,Default,,0,0,0,,Саусақтардың ұштары таң қалдырады, солай емес пе?
Dialogue: 0,0:09:18.51,0:09:20.10,Default,,0,0,0,,Бұл тітіркендіргіш...
Dialogue: 0,0:09:30.31,0:09:34.32,Default,,0,0,0,,Әй, адам көп, ішімдік көп!
Dialogue: 0,0:09:34.40,0:09:36.03,Default,,0,0,0,,Әкем
Dialogue: 0,0:09:36.11,0:09:40.07,Default,,0,0,0,,Полициядан үлкендер де келе жатқан сияқты, көп ішпеңіз.
Dialogue: 0,0:09:40.16,0:09:44.16,Default,,0,0,0,,Мен білемін! Жоғары алкоголь сізді ауыртпайды.
Dialogue: 0,0:09:44.95,0:09:47.00,Default,,0,0,0,,Олай емес...
Dialogue: 0,0:09:47.08,0:09:50.17,Default,,0,0,0,,Эй, сен мұнда қалағаныңды жей аласың, солай ма?
Dialogue: 0,0:09:50.25,0:09:51.54,Default,,0,0,0,,Иә, мүмкін...
Dialogue: 0,0:09:51.63,0:09:53.55,Default,,0,0,0,,Бақытты!
Dialogue: 0,0:09:53.63,0:09:55.67,Default,,0,0,0,,Сол балалар бақытты балалар.
Dialogue: 0,0:09:55.76,0:09:56.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:56.67,0:09:57.76,Default,,0,0,0,,(көңілді дауыс)
Dialogue: 0,0:09:57.84,0:10:00.72,Default,,0,0,0,,Ойынға қатысқаныңыз үшін төсбелгі алғаныңызды көргенде.
Dialogue: 0,0:10:00.80,0:10:04.06,Default,,0,0,0,,Бүгін сыбыс ойынына сайланған балалар.
Dialogue: 0,0:10:04.14,0:10:09.19,Default,,0,0,0,,Полиция бастығының орынбасарының немересі Мықты кәсіпкердің немересі
Dialogue: 0,0:10:09.27,0:10:11.15,Default,,0,0,0,,Билік партиясының саясаткерінің ұлы
Dialogue: 0,0:10:11.73,0:10:13.61,Default,,0,0,0,,Жапонияның болашағына жауапты
Dialogue: 0,0:10:13.69,0:10:16.07,Default,,0,0,0,,Екінші және үшінші буын барлығы бірге.
Dialogue: 0,0:10:16.15,0:10:17.61,Default,,0,0,0,,Мен қызғанышпен қарауды сезінемін.
Dialogue: 0,0:10:17.70,0:10:18.53,Default,,0,0,0,,О
Dialogue: 0,0:10:19.28,0:10:23.49,Default,,0,0,0,,Бұл Жапонияның зұлым тұқым қуалаушылық жүйесінің қысқартылған нұсқасы сияқты.
Dialogue: 0,0:10:23.58,0:10:24.66,Default,,0,0,0,,- (Жүгіріп) А? -(Когоро) Не...
Dialogue: 0,0:10:24.74,0:10:27.16,Default,,0,0,0,,Осы тұқым қуалайтын жүйемен
Dialogue: 0,0:10:27.25,0:10:30.25,Default,,0,0,0,,Адамның қателігінің тарихы қайталанады.
Dialogue: 0,0:10:30.33,0:10:33.71,Default,,0,0,0,,Хайбара мырза, не айтып тұрғаныңызды түсінбедім...
Dialogue: 0,0:10:34.50,0:10:38.34,Default,,0,0,0,,Әй, балаша сөйлеңізші.
Dialogue: 0,0:10:38.42,0:10:41.55,Default,,0,0,0,,Саясаткердің баласы саясаткер болады
Dialogue: 0,0:10:41.64,0:10:44.01,Default,,0,0,0,,Президенттің ұлы президент болады.
Dialogue: 0,0:10:44.10,0:10:48.10,Default,,0,0,0,,Бұл қанша уақыт өтсе де, Жапония ешқашан өзгермейді деген сөз.
Dialogue: 0,0:10:49.14,0:10:50.02,Default,,0,0,0,,(Дарио) Хе-хе-хе-хе. Эй, қарашы — бұл апат!
Dialogue: 0,0:10:50.10,0:10:54.86,Default,,0,0,0,,...және т.б., олар кеше жаңалықтарда көп айтты!
Dialogue: 0,0:10:54.94,0:10:57.57,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:10:58.49,0:11:00.15,Default,,0,0,0,,Сіз қалай ойлайсыз? Қазір
Dialogue: 0,0:11:00.91,0:11:02.03,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:11:02.11,0:11:03.53,Default,,0,0,0,,Жүгірдім!
Dialogue: 0,0:11:03.62,0:11:05.24,Default,,0,0,0,,Соноко!
Dialogue: 0,0:11:05.33,0:11:08.20,Default,,0,0,0,,Сәлем ұлдар мен қыздар!
Dialogue: 0,0:11:08.29,0:11:10.79,Default,,0,0,0,,Әй, Соноко-сан! Әйтеуір, бұл белгі...
Dialogue: 0,0:11:10.87,0:11:12.29,Default,,0,0,0,,Сіздің пікіріңізді естігеннен кейін оны мүмкіндігінше тезірек хабардар еткім келді.
Dialogue: 0,0:11:12.38,0:11:14.59,Default,,0,0,0,,Мүмкін Соноко да таңдалған шығар?
Dialogue: 0,0:11:14.67,0:11:19.17,Default,,0,0,0,,Suzuki конгломерат ойынды дамытуға қаржылық қолдау көрсетті.
Dialogue: 0,0:11:19.26,0:11:21.09,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:11:21.18,0:11:22.64,Default,,0,0,0,,Мен де соны қалаймын
Dialogue: 0,0:11:22.72,0:11:24.26,Default,,0,0,0,,- (Морохоши) Берілме - (2 адам) А?
Dialogue: 0,0:11:24.35,0:11:26.51,Default,,0,0,0,,Позиция басқаша.
Dialogue: 0,0:11:26.60,0:11:30.60,Default,,0,0,0,,Біріншіден, балалар сендерді дұрыс шақырды ма?
Dialogue: 0,0:11:30.69,0:11:32.10,Default,,0,0,0,,Бұл дөрекі!
Dialogue: 0,0:11:32.19,0:11:35.11,Default,,0,0,0,,Бұл балалар біздің заңды қонақтарымыз!
Dialogue: 0,0:11:35.86,0:11:39.32,Default,,0,0,0,,Бұл Сузуки Зайбацудың қызы.
Dialogue: 0,0:11:40.07,0:11:42.49,Default,,0,0,0,,Жарайсың ба? Адам деген не?
Dialogue: 0,0:11:42.57,0:11:45.83,Default,,0,0,0,,Сіз дүниеге келген сәттен бастап сіздің өміріңіз шешіледі.
Dialogue: 0,0:11:45.91,0:11:50.04,Default,,0,0,0,,Дұрыс, әдемі киім киетін адамды біз де таңдаймыз.
Dialogue: 0,0:11:50.66,0:11:52.50,Default,,0,0,0,,Таңдалмағандар
Dialogue: 0,0:11:52.58,0:11:56.00,Default,,0,0,0,,Саусағыңызды аузыңызға салып, сыртынан қараңыз.
Dialogue: 0,0:11:56.59,0:11:59.42,Default,,0,0,0,,Бұл адамдар өте тітіркендіргіш.
Dialogue: 0,0:11:59.51,0:12:01.72,Default,,0,0,0,,Әке, маған кішкене лекция оқыңыз!
Dialogue: 0,0:12:01.80,0:12:03.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:04.39,0:12:05.43,Default,,0,0,0,,
Dialogue: 0,0:12:07.05,0:12:11.14,Default,,0,0,0,,Жарайсың ба? Балалар, өмірлеріңді босқа өткізбеңдер
Dialogue: 0,0:12:11.23,0:12:15.69,Default,,0,0,0,,Тегіс болып көрінетін өмірдің өзінде де тұнбалар болады.
Dialogue: 0,0:12:16.19,0:12:19.78,Default,,0,0,0,,Ересек болған соң, түсінетін кез келеді.
Dialogue: 0,0:12:19.86,0:12:21.82,Default,,0,0,0,,Әйеліңіз қашып кетті ме?
Dialogue: 0,0:12:21.90,0:12:22.74,Default,,0,0,0,,Алу…
Dialogue: 0,0:12:23.53,0:12:26.78,Default,,0,0,0,,Мен қарт туралы білемін.
Dialogue: 0,0:12:26.87,0:12:28.45,Default,,0,0,0,,Ұйқыдағы Когоро
Dialogue: 0,0:12:28.53,0:12:32.58,Default,,0,0,0,,Ол ұйықтап жатқанда әйелі пайда болғандықтан бұл лақап атқа ие болды, солай ма?
Dialogue: 0,0:12:32.66,0:12:34.37,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:12:34.46,0:12:35.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:35.92,0:12:37.38,Default,,0,0,0,,Бауырлар!
Dialogue: 0,0:12:37.46,0:12:39.84,Default,,0,0,0,,Сіз ұйықтап жатқанда емес!
Dialogue: 0,0:12:39.92,0:12:43.63,Default,,0,0,0,,Әкем жуынатын бөлмеге кеткенде анам кетіп қалды.
Dialogue: 0,0:12:43.72,0:12:44.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:44.80,0:12:45.63,Default,,0,0,0,,Эй?
Dialogue: 0,0:12:45.72,0:12:47.30,Default,,0,0,0,,А...
Dialogue: 0,0:12:47.39,0:12:50.18,Default,,0,0,0,,Артымнан ерме
Dialogue: 0,0:12:50.26,0:12:52.10,Default,,0,0,0,,Ей, шағын ойын ойнайық!
Dialogue: 0,0:12:52.18,0:12:53.48,Default,,0,0,0,,- (Такизава) Ах - (Эмори) Ха~!
Dialogue: 0,0:12:54.89,0:12:57.90,Default,,0,0,0,,Сол балалар ата-анасының еңбегін мұраға алады.
Dialogue: 0,0:12:57.98,0:13:01.28,Default,,0,0,0,,Менің ойымша, ол Жапонияның болашақ көшбасшысы болады.
Dialogue: 0,0:13:01.36,0:13:03.32,Default,,0,0,0,,Болашақ үмітсіз.
Dialogue: 0,0:13:03.40,0:13:04.74,Default,,0,0,0,,Мен келісемін.
Dialogue: 0,0:13:05.74,0:13:07.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:07.53,0:13:08.57,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:08.66,0:13:09.99,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:10.08,0:13:10.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:10.99,0:13:11.87,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:13:13.66,0:13:14.62,Default,,0,0,0,,Жарайды, жарайды!
Dialogue: 0,0:13:14.71,0:13:15.83,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:21.67,0:13:22.55,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:13:22.63,0:13:23.46,Default,,0,0,0,,Қайтарыңыз!
Dialogue: 0,0:13:23.55,0:13:26.38,Default,,0,0,0,,Басқа тұтынушыларға кедергі болыңыз
Dialogue: 0,0:13:26.47,0:13:28.43,Default,,0,0,0,,Ойнағың келсе, далаға шық.
Dialogue: 0,0:13:28.51,0:13:30.18,Default,,0,0,0,,Бұл кім, қария?
Dialogue: 0,0:13:30.26,0:13:34.31,Default,,0,0,0,,Менің атым Кашимура, мен Коконды дамытуға жауапты болдым.
Dialogue: 0,0:13:34.39,0:13:36.69,Default,,0,0,0,,Маған атамның банкі көмектесті.
Dialogue: 0,0:13:36.77,0:13:38.69,Default,,0,0,0,,Сіз ойынды аяқтадыңыз!
Dialogue: 0,0:13:38.77,0:13:41.15,Default,,0,0,0,,Қоғамдық мораль дегеніміз не?
Dialogue: 0,0:13:41.23,0:13:44.86,Default,,0,0,0,,Әкеңнен, шешеңнен сабақ алмадың ба?
Dialogue: 0,0:13:44.94,0:13:48.91,Default,,0,0,0,,Сондай-ақ, басшылармен сөйлесу тәсілі.
Dialogue: 0,0:13:48.99,0:13:50.62,Default,,0,0,0,,Бастық...
Dialogue: 0,0:13:50.70,0:13:52.66,Default,,0,0,0,,Мен саған бұдан былай ақша бермеймін!
Dialogue: 0,0:13:52.74,0:13:56.54,Default,,0,0,0,,Ағай, сіз бізді білмейсіз ғой?
Dialogue: 0,0:13:56.62,0:14:00.54,Default,,0,0,0,,Егер сіз бізге қарсы тұрсаңыз, ертең жұмыстан шығарылуыңыз мүмкін.
Dialogue: 0,0:14:00.63,0:14:04.88,Default,,0,0,0,,Бірақ оған дейін сені осы жерден алып кетейік.
Dialogue: 0,0:14:04.96,0:14:06.47,Default,,0,0,0,,- (Эмори) Ух... - (Морохоши) Цк...
Dialogue: 0,0:14:07.38,0:14:08.34,Default,,0,0,0,,Кеттік
Dialogue: 0,0:14:08.43,0:14:09.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:12.97,0:14:16.68,Default,,0,0,0,,Жақсы! Қандай керемет аға...
Dialogue: 0,0:14:17.39,0:14:19.35,Default,,0,0,0,,Басқа біреуден өте ерекше...
Dialogue: 0,0:14:19.44,0:14:21.44,Default,,0,0,0,,Не? Уф...
Dialogue: 0,0:14:25.07,0:14:28.86,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:14:43.79,0:14:46.01,Default,,0,0,0,,Шиничи-кун да келуі керек.
Dialogue: 0,0:14:46.09,0:14:49.17,Default,,0,0,0,,Ата-ана мен баланы бетпе-бет көрмегелі біраз болды.
Dialogue: 0,0:14:49.26,0:14:53.05,Default,,0,0,0,,Дәрігер, бұл менің онымен қарым-қатынасым туралы.
Dialogue: 0,0:14:53.14,0:14:55.39,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:14:56.02,0:14:59.18,Default,,0,0,0,,Барлығыңыз сахнаға назар аударыңыздар.
Dialogue: 0,0:14:59.27,0:15:01.85,Default,,0,0,0,,Дәл қазір «Кокон» ойынының кезеңі.
Dialogue: 0,0:15:01.94,0:15:05.07,Default,,0,0,0,,Идеяны Юсаку Кудо мырза ұсынды.
Dialogue: 0,0:15:05.15,0:15:06.57,Default,,0,0,0,,Америкадан келдім!
Dialogue: 0,0:15:06.65,0:15:08.28,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:15:08.36,0:15:12.74,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:15:12.82,0:15:13.87,Default,,0,0,0,,Хмм…
Dialogue: 0,0:15:13.95,0:15:16.20,Default,,0,0,0,,Міне, мен үйге келдім.
Dialogue: 0,0:15:16.79,0:15:19.54,Default,,0,0,0,,Бір ай бойы қайда болдың деп ойладым.
Dialogue: 0,0:15:19.62,0:15:21.42,Default,,0,0,0,,Бұл менің әкемнің жұмысы болатын.
Dialogue: 0,0:15:21.50,0:15:24.88,Default,,0,0,0,,Бағдарламаның соңғы кезеңдеріндегі көмек
Dialogue: 0,0:15:24.96,0:15:25.79,Default,,0,0,0,,Анаң ше?
Dialogue: 0,0:15:25.88,0:15:31.43,Default,,0,0,0,,Мен Жапонияға қайтып келгеніме көп уақыт болды, сондықтан олардың сынып жиналысы болып жатқанын естідім.
Dialogue: 0,0:15:31.51,0:15:33.14,Default,,0,0,0,,Қараңдаршы, бұл кәдесый.
Dialogue: 0,0:15:33.22,0:15:34.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:35.51,0:15:39.18,Default,,0,0,0,,Ойынға қатысу белгісі Мен қуаныштымын, бірақ...
Dialogue: 0,0:15:39.27,0:15:41.60,Default,,0,0,0,,Мен мұны жалғыз істей алмаймын.
Dialogue: 0,0:15:41.69,0:15:45.15,Default,,0,0,0,,Егер сіз болсаңыз, менің ойымша, сіз бұған ынталы болар едіңіз.
Dialogue: 0,0:15:45.23,0:15:47.65,Default,,0,0,0,,Бұл әлі құпия...
Dialogue: 0,0:15:47.73,0:15:52.49,Default,,0,0,0,,Ойын 100 жыл бұрын 19 ғасырдың аяғында Лондонда өтеді.
Dialogue: 0,0:15:52.57,0:15:54.95,Default,,0,0,0,,Лондон 100 жыл бұрын?
Dialogue: 0,0:15:55.45,0:15:59.20,Default,,0,0,0,,Әдеттегідей, әке, сен ол дүниені жақсы көресің.
Dialogue: 0,0:15:59.29,0:16:02.16,Default,,0,0,0,,Ата-ана мен бала бірге, хехехе...
Dialogue: 0,0:16:02.25,0:16:03.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:03.42,0:16:04.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:04.96,0:16:06.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:06.92,0:16:10.42,Default,,0,0,0,,Не? Мен ештеңе көре алмаймын
Dialogue: 0,0:16:10.51,0:16:11.84,Default,,0,0,0,,- (Когоро) Уау... - (Шиндлер) Кешіріңіз
Dialogue: 0,0:16:12.72,0:16:15.93,Default,,0,0,0,,...Қараңғыда қозғалма!
Dialogue: 0,0:16:21.98,0:16:23.89,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:23.98,0:16:25.85,Default,,0,0,0,,Келесі буын ойын консольдері...
Dialogue: 0,0:16:25.94,0:16:28.23,Default,,0,0,0,,Коконға қараңыз!
Dialogue: 0,0:16:31.40,0:16:34.28,Default,,0,0,0,,Бұл капсула адамның бес сезімін басқарады.
Dialogue: 0,0:16:34.36,0:16:36.45,Default,,0,0,0,,Түрту, ауырсыну және иіс сезу
Dialogue: 0,0:16:36.53,0:16:40.91,Default,,0,0,0,,Ойыншы барлық сезімдер шынайы болатын әлемге орналастырылады.
Dialogue: 0,0:16:41.00,0:16:44.37,Default,,0,0,0,,Орталық жүйке жүйесіне электрлік әсер ететін жүйе қолданылады.
Dialogue: 0,0:16:44.46,0:16:46.13,Default,,0,0,0,,Ағзаға мүлдем зияны жоқ
Dialogue: 0,0:16:46.21,0:16:48.88,Default,,0,0,0,,Қарап тұрсаң қызықсыз.
Dialogue: 0,0:16:48.96,0:16:51.13,Default,,0,0,0,,Ойындар ойнауға арналған.
Dialogue: 0,0:16:51.21,0:16:53.34,Default,,0,0,0,,Эй, мұнда барлығы жиналды.
Dialogue: 0,0:16:53.42,0:16:56.64,Default,,0,0,0,,Ендеше зерігуден арылу үшін тест тапсырайық!
Dialogue: 0,0:16:56.72,0:16:58.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:58.18,0:17:01.68,Default,,0,0,0,,Қайтадан бастайық! «Дәрігердің сөз ойыны» викторинасы
Dialogue: 0,0:17:01.77,0:17:02.73,Default,,0,0,0,,Қашып кеткіңіз келе ме?
Dialogue: 0,0:17:02.81,0:17:06.35,Default,,0,0,0,,Сіз бұл туралы көп ойлағаныңызға сенімдімін, сондықтан мен сізден сұрайын.
Dialogue: 0,0:17:06.44,0:17:08.40,Default,,0,0,0,,
Dialogue: 0,0:17:08.48,0:17:10.52,Default,,0,0,0,,Осы ойын компаниясының А мырзасы
Dialogue: 0,0:17:10.61,0:17:14.70,Default,,0,0,0,,Жұмыс істеп жүріп байқаусызда коконға тәуелді болып қалдым.
Dialogue: 0,0:17:14.78,0:17:18.16,Default,,0,0,0,,Мұны көрген президент А мырзаға не істеді?
Dialogue: 0,0:17:18.24,0:17:22.62,Default,,0,0,0,,1 Ойынды соңына дейін тазалағаны үшін марапатталады.
Dialogue: 0,0:17:22.70,0:17:26.58,Default,,0,0,0,,2 Жұмыс істеп жүргенімде ойнап жүргендіктен жұмыстан шығарылдым.
Dialogue: 0,0:17:26.67,0:17:30.21,Default,,0,0,0,,3 Кокон ішінде тыныш ұйықтадым.
Dialogue: 0,0:17:30.29,0:17:32.55,Default,,0,0,0,,Мен оған демалуға рұқсат етемін.
Dialogue: 0,0:17:33.30,0:17:35.30,Default,,0,0,0,,3 саны: Мен оған демалуға рұқсат етемін.
Dialogue: 0,0:17:35.38,0:17:36.76,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:17:37.38,0:17:40.47,Default,,0,0,0,,Өйткені пілләнің пішіні бесікке ұқсайды.
Dialogue: 0,0:17:40.55,0:17:41.93,Default,,0,0,0,,Бу!
Dialogue: 0,0:17:42.01,0:17:44.18,Default,,0,0,0,,Мен марапатты бірінші болып алдым!
Dialogue: 0,0:17:44.27,0:17:46.02,Default,,0,0,0,,Бұл да жаман
Dialogue: 0,0:17:46.10,0:17:48.81,Default,,0,0,0,,Сонда 2 саны? Неліктен?
Dialogue: 0,0:17:48.90,0:17:53.69,Default,,0,0,0,,Ай-күн, түсіндің, маған түсіндіре аласың ба?
Dialogue: 0,0:17:53.78,0:17:56.90,Default,,0,0,0,,Мен бүгін жеңіл киім киемін, сондықтан оны Эдогава-кунға қалдырамын.
Dialogue: 0,0:17:56.99,0:17:58.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:58.24,0:18:00.12,Default,,0,0,0,,Қараңызшы, бұл өтініш.
Dialogue: 0,0:18:00.74,0:18:02.99,Default,,0,0,0,,Кокон — піллә.
Dialogue: 0,0:18:03.08,0:18:05.58,Default,,0,0,0,,Жібек құрттары піллә жасайды
Dialogue: 0,0:18:05.66,0:18:08.79,Default,,0,0,0,,Басқаша айтқанда, жұмыстан шығару - жұмыстан шығару.
Dialogue: 0,0:18:08.87,0:18:09.83,Default,,0,0,0,,Сэм...
Dialogue: 0,0:18:09.92,0:18:13.00,Default,,0,0,0,,Мен саған жылы сусын әкелемін...
Dialogue: 0,0:18:13.09,0:18:14.17,Default,,0,0,0,,Әлеуметтену
Dialogue: 0,0:18:14.25,0:18:15.26,Default,,0,0,0,,Мен де...
Dialogue: 0,0:18:15.34,0:18:20.05,Default,,0,0,0,,Хмм... балалар үшін кондиционер тым тиімді шығар?
Dialogue: 0,0:18:20.14,0:18:21.39,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:18:28.73,0:18:31.10,Default,,0,0,0,,(Шиндлердің ағылшыншасы)
Dialogue: 0,0:18:34.61,0:18:37.86,Default,,0,0,0,,Бұл өте тамаша қола мүсін.
Dialogue: 0,0:18:37.95,0:18:39.61,Default,,0,0,0,,Президент Шиндлер туралы кез келген нәрсе
Dialogue: 0,0:18:39.70,0:18:41.99,Default,,0,0,0,,Бұл сіздің сүйікті топтамаңыз сияқты.
Dialogue: 0,0:18:42.07,0:18:43.08,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:43.16,0:18:46.70,Default,,0,0,0,,Саған ұнағаны соншалық, оны өзіңмен бірге алып келуге тырыстың.
Dialogue: 0,0:18:47.33,0:18:49.16,Default,,0,0,0,,Мұндай мүсіндер үшін әдеттен тыс —
Dialogue: 0,0:18:49.25,0:18:51.04,Default,,0,0,0,,Жауынгерлік рухқа толы тұлға
Dialogue: 0,0:18:51.13,0:18:53.42,Default,,0,0,0,,Менің ойымша, бұл өзіңізбен сәйкес келеді.
Dialogue: 0,0:18:54.84,0:18:55.67,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:57.92,0:18:59.13,Default,,0,0,0,,(пышақ құлаған дыбыс)
Dialogue: 0,0:18:59.22,0:19:00.05,Default,,0,0,0,,Кеттік...
Dialogue: 0,0:19:00.13,0:19:03.43,Default,,0,0,0,,Хидеки, допты соғуды осы жерден доғар.
Dialogue: 0,0:19:03.51,0:19:04.93,Default,,0,0,0,,Иә...
Dialogue: 0,0:19:08.06,0:19:09.39,Default,,0,0,0,,Бұл біраз тәртіпсіздік болды.
Dialogue: 0,0:19:09.48,0:19:12.90,Default,,0,0,0,,Ештеңе етпейді, бәрі де арзан мүсіндер.
Dialogue: 0,0:19:12.98,0:19:13.81,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:19:14.40,0:19:17.61,Default,,0,0,0,,Қымбат заттарды мұндай жерге қоюға болмайды.
Dialogue: 0,0:19:17.69,0:19:19.03,Default,,0,0,0,,Бұл да рас.
Dialogue: 0,0:19:19.11,0:19:21.66,Default,,0,0,0,,Коконның дамуына жауапты —
Dialogue: 0,0:19:21.74,0:19:25.20,Default,,0,0,0,,Тадаки Кашимура мырза менің колледждегі жаман досым болатын.
Dialogue: 0,0:19:25.83,0:19:30.46,Default,,0,0,0,,Осы жұмыс арқылы мен біраз уақыттан кейін алғаш рет ескі достықты қайта жандандыра алдым.
Dialogue: 0,0:19:30.54,0:19:32.33,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:19:32.42,0:19:35.13,Default,,0,0,0,,Сізге TMS Shimizu әкелді
Dialogue: 0,0:19:36.00,0:19:39.13,Default,,0,0,0,,Кашимура мырза қайда? Мен сенімен танысқым келеді
Dialogue: 0,0:19:39.21,0:19:41.72,Default,,0,0,0,,Иә, мен сені бірден іздеймін.
Dialogue: 0,0:19:41.80,0:19:43.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:43.09,0:19:45.14,Default,,0,0,0,,Кудо мырза, қол қойыңыз!
Dialogue: 0,0:19:45.22,0:19:46.43,Default,,0,0,0,,Мұғалім, мен де!
Dialogue: 0,0:19:50.43,0:19:51.85,Default,,0,0,0,,Уау хехе...
Dialogue: 0,0:19:52.44,0:19:54.31,Default,,0,0,0,,Сен жақсы сияқтысың деп жеңілдеп қалдым.
Dialogue: 0,0:19:54.90,0:19:56.27,Default,,0,0,0,,(Шукуна) Бұл жалықтырады. Егер менің орнымды алмақ болсаң, іске кіріс.
Dialogue: 0,0:20:26.35,0:20:29.64,Default,,0,0,0,,Сіз дереу өтетін жерге оралуыңыз керек.
Dialogue: 0,0:20:29.72,0:20:31.73,Default,,0,0,0,,Тез айтсам ше?
Dialogue: 0,0:20:31.81,0:20:35.10,Default,,0,0,0,,Хироки маған сеніп тапсырған ДНҚ барлау бағдарламасы.
Dialogue: 0,0:20:35.19,0:20:36.98,Default,,0,0,0,,Сіз оны қаншаға сатқыңыз келеді?
Dialogue: 0,0:20:37.61,0:20:40.82,Default,,0,0,0,,Менің сені бопсалау ойым жоқ.
Dialogue: 0,0:20:40.90,0:20:42.95,Default,,0,0,0,,Мен жай ғана түзетулеріңізді сұраймын.
Dialogue: 0,0:20:44.78,0:20:47.37,Default,,0,0,0,,Хироки енді біледі
Dialogue: 0,0:20:47.45,0:20:51.66,Default,,0,0,0,,Сіздің құпияңыз Шиндлердің империясын жояды.
Dialogue: 0,0:20:52.33,0:20:56.38,Default,,0,0,0,,Алайда жасанды миды Хирокидің көмегінсіз аяқтау мүмкін емес.
Dialogue: 0,0:20:57.25,0:20:59.59,Default,,0,0,0,,Хирокиді қатты жұмыс істеуге мәжбүрледің.
Dialogue: 0,0:20:59.67,0:21:01.34,Default,,0,0,0,,Тезірек аяқтау
Dialogue: 0,0:21:02.92,0:21:05.01,Default,,0,0,0,,Хироки ойша бұрышта.
Dialogue: 0,0:21:05.59,0:21:10.43,Default,,0,0,0,,Жасанды ми біткен соң мені өлтіресің деп ойладым.
Dialogue: 0,0:21:11.10,0:21:13.68,Default,,0,0,0,,Сондықтан бұл менің альтер эго деп айтуға болады.
Dialogue: 0,0:21:13.77,0:21:16.98,Default,,0,0,0,,Телефон желісінде Нұхтың кемесін қалдыру
Dialogue: 0,0:21:17.06,0:21:19.82,Default,,0,0,0,,Көпқабатты үйдің төбесінен лақтырылған
Dialogue: 0,0:21:24.11,0:21:27.28,Default,,0,0,0,,Содан кейін, біраз уақыттан кейін, менің компьютерімде.
Dialogue: 0,0:21:27.36,0:21:31.28,Default,,0,0,0,,ДНҚ барлау бағдарламасының деректері бұзылды.
Dialogue: 0,0:21:31.37,0:21:35.46,Default,,0,0,0,,Хирокидің өсиетін мұра еткен Нұх кемесінің жұмысы болды.
Dialogue: 0,0:21:35.54,0:21:39.92,Default,,0,0,0,,Бұл маған Хироки жанының айқайындай көрінді.
Dialogue: 0,0:21:40.00,0:21:42.13,Default,,0,0,0,,Түзетулер енгізу
Dialogue: 0,0:21:42.21,0:21:46.63,Default,,0,0,0,,Мен әлемге бәрін ашамын және кез келген үкімге тап боламын.
Dialogue: 0,0:21:47.26,0:21:49.64,Default,,0,0,0,,Бірақ алдымен оны маған көрсете аласыз ба?
Dialogue: 0,0:21:49.72,0:21:52.01,Default,,0,0,0,,Нұхтың кемесі сізді жіберді...
Dialogue: 0,0:21:52.10,0:21:54.35,Default,,0,0,0,,ДНҚ барлау бағдарламасы
Dialogue: 0,0:21:55.18,0:21:56.27,Default,,0,0,0,,Сол сәтте, контекстке қарамастан, мен бұл тіркесті «дәптерді лақтыру» деген мағынада қолданамын.
Dialogue: 0,0:21:57.19,0:22:04.07,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:22:16.20,0:22:19.58,Default,,0,0,0,,Дәл осы нәрсе уақытты асқан және ғасырлар бойы алып келген.
Dialogue: 0,0:22:19.67,0:22:21.00,Default,,0,0,0,,Лондон елестері…
Dialogue: 0,0:22:21.08,0:22:21.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:22.88,0:22:23.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:45.82,0:22:47.36,Default,,0,0,0,,Маған біртіндеп орал
Dialogue: 0,0:23:02.29,0:23:04.54,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:23:04.63,0:23:05.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:08.76,0:23:09.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:10.84,0:23:12.51,Default,,0,0,0,,Сол сөзге шебер, жалған мейірімді жігіт➡
Dialogue: 0,0:23:18.02,0:23:19.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:23:25.57,0:23:28.15,Default,,0,0,0,,Дүкен сатушысын сомдаған комедиант өте крутой—
Dialogue: 0,0:23:28.24,0:23:33.53,Default,,0,0,0,,(жүрек соғуы сияқты)
Dialogue: 0,0:23:37.33,0:23:40.75,Default,,0,0,0,,Менің атым Нұх пайғамбардың кемесі
Dialogue: 0,0:23:47.59,0:23:51.76,Default,,0,0,0,,Директор Кудо-сенсэй сізбен кездескісі келеді.
Dialogue: 0,0:23:51.84,0:23:53.14,Default,,0,0,0,,Негізгі
Dialogue: 0,0:23:53.72,0:23:55.43,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:23:55.51,0:23:58.01,Default,,0,0,0,,Бастық! Не болды? Бастық!
Dialogue: 0,0:24:06.61,0:24:09.48,Default,,0,0,0,,Бұл жолы неден басталады?
Dialogue: 0,0:24:09.57,0:24:13.66,Default,,0,0,0,,Бүгінгі арнайы қонақ Йоко Окино сахнада.
Dialogue: 0,0:24:13.74,0:24:15.20,Default,,0,0,0,,Біраз уақыт ләззат алыңыз.
Dialogue: 0,0:24:15.28,0:24:18.45,Default,,0,0,0,,Не! Йоко-чан да келе ме?
Dialogue: 0,0:24:18.54,0:24:21.00,Default,,0,0,0,,Орыныңызды бекітіңіз!
Dialogue: 0,0:24:26.54,0:24:29.42,Default,,0,0,0,,Чиба-кун, барлық шығулар жабылған.
Dialogue: 0,0:24:29.50,0:24:31.01,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:24:31.09,0:24:32.30,Default,,0,0,0,,Барлық күту вагондарына!
Dialogue: 0,0:24:32.88,0:24:35.30,Default,,0,0,0,,Көп мәртебелі адамдар келе жатқан сияқты.
Dialogue: 0,0:24:35.39,0:24:36.51,Default,,0,0,0,,Иә
Dialogue: 0,0:24:36.60,0:24:41.93,Default,,0,0,0,,Полиция бастығының орынбасары, бизнес әлеміндегі беделді адамдар және басқа да көптеген өкілдер...
Dialogue: 0,0:24:43.19,0:24:46.02,Default,,0,0,0,,Сіз бір нәрсеге алаңдап тұрған сияқтысыз.
Dialogue: 0,0:24:46.10,0:24:47.65,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:24:47.73,0:24:49.44,Default,,0,0,0,,Керемет!
Dialogue: 0,0:24:49.52,0:24:51.23,Default,,0,0,0,,Алтын Yaiba картасы
Dialogue: 0,0:24:51.32,0:24:52.82,Default,,0,0,0,,Ол премиуммен бірге келеді.
Dialogue: 0,0:24:52.90,0:24:54.11,Default,,0,0,0,,Маған керек!
Dialogue: 0,0:24:54.20,0:24:57.95,Default,,0,0,0,,Оны ойынға қатысу белгісіне айырбастауға болады.
Dialogue: 0,0:24:58.03,0:25:00.08,Default,,0,0,0,,Бірақ мен де ойын ойнағым келеді.
Dialogue: 0,0:25:00.91,0:25:03.21,Default,,0,0,0,,Кокон мұны бұдан былай жасай алады.
Dialogue: 0,0:25:03.29,0:25:04.71,Default,,0,0,0,,Алтын Yaiba картасы
Dialogue: 0,0:25:04.79,0:25:07.67,Default,,0,0,0,,Егер сіз осы сәтті өткізіп алсаңыз, оны енді ешқашан алмауыңыз мүмкін.
Dialogue: 0,0:25:07.75,0:25:09.17,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:25:09.25,0:25:10.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:25:10.21,0:25:12.84,Default,,0,0,0,,Хайбар! Мен оны түсіндім!
Dialogue: 0,0:25:12.92,0:25:15.34,Default,,0,0,0,,Қарашы, менде де сенікі бар.
Dialogue: 0,0:25:15.43,0:25:18.35,Default,,0,0,0,,Әй... бұл үлкен мәселе.
Dialogue: 0,0:25:19.10,0:25:24.10,Default,,0,0,0,,Хмм... Әңгімеге қосылсақ, жаман ой болмас.
Dialogue: 0,0:25:24.18,0:25:25.44,Default,,0,0,0,,Хаха...
Dialogue: 0,0:25:25.52,0:25:27.19,Default,,0,0,0,,Кешіріңіз, өтуге рұқсат етіңіз!
Dialogue: 0,0:25:28.61,0:25:30.73,Default,,0,0,0,,Не, Кашимура?
Dialogue: 0,0:25:31.23,0:25:32.15,Default,,0,0,0,,Маған жол көрсетіңізші
Dialogue: 0,0:25:32.23,0:25:33.49,Default,,0,0,0,,Иә
Dialogue: 0,0:25:34.28,0:25:35.70,Default,,0,0,0,,Енді күте тұрыңыз!
Dialogue: 0,0:25:35.78,0:25:38.99,Default,,0,0,0,,Барлығыңыз Кокон алаңына көшіңіздер.
Dialogue: 0,0:25:39.07,0:25:42.70,Default,,0,0,0,,Әкең мен Конан қайда кетті?
Dialogue: 0,0:25:42.79,0:25:44.75,Default,,0,0,0,,Хаха...
Dialogue: 0,0:25:44.83,0:25:46.87,Default,,0,0,0,,Инспектор!
Dialogue: 0,0:25:46.96,0:25:49.75,Default,,0,0,0,,Әй, Моури-кун, сен де келдің бе?
Dialogue: 0,0:25:49.83,0:25:52.71,Default,,0,0,0,,Иә, мен балконда есін жидым.
Dialogue: 0,0:25:52.80,0:25:54.84,Default,,0,0,0,,Мен полиция көлігін көрдім
Dialogue: 0,0:25:54.92,0:25:57.59,Default,,0,0,0,,Коконның дамуына жауапты адам...
Dialogue: 0,0:25:57.68,0:26:01.39,Default,,0,0,0,,Жүрекке пышақ жарақаты, кісі өлтіру қаруы алынды.
Dialogue: 0,0:26:02.01,0:26:03.81,Default,,0,0,0,,Қанды сүрту...
Dialogue: 0,0:26:04.31,0:26:06.52,Default,,0,0,0,,Бұл шынымен маңызды қару ма?
Dialogue: 0,0:26:06.60,0:26:10.23,Default,,0,0,0,,Бұл артта қалған жағдайда иесін ашатын кісі өлтіру қаруы болды ма?
Dialogue: 0,0:26:12.11,0:26:13.40,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:26:13.48,0:26:17.03,Default,,0,0,0,,Неліктен әзірлеу менеджері жертөледе осылай болды?
Dialogue: 0,0:26:17.11,0:26:18.45,Default,,0,0,0,,Иә...
Dialogue: 0,0:26:18.53,0:26:20.87,Default,,0,0,0,,Жетекші адамдар жиі келетін және кететін жерлерді қарастыруы керек.
Dialogue: 0,0:26:20.95,0:26:24.08,Default,,0,0,0,,Мен мұнда жалғыз келдім, өйткені ойымды жинақтай алмаймын...
Dialogue: 0,0:26:27.12,0:26:30.29,Default,,0,0,0,,R, T, J беттерінде қан дақтары бар.
Dialogue: 0,0:26:30.38,0:26:34.59,Default,,0,0,0,,Мм... Негізі, таң қалдыратын бір нәрсе бар.
Dialogue: 0,0:26:34.67,0:26:37.76,Default,,0,0,0,,Қатты дискідегі барлық деректер жойылды.
Dialogue: 0,0:26:37.84,0:26:39.01,Default,,0,0,0,,Деректер?
Dialogue: 0,0:26:39.09,0:26:41.34,Default,,0,0,0,,Бәсекелес компанияның саботажы…
Dialogue: 0,0:26:41.43,0:26:42.97,Default,,0,0,0,,-Әлі кеш емес пе? -(3 адам) А?
Dialogue: 0,0:26:43.05,0:26:46.10,Default,,0,0,0,,Өйткені піллә біткен.
Dialogue: 0,0:26:46.18,0:26:48.06,Default,,0,0,0,,Бұл жігіт мен бұрын білмеген!
Dialogue: 0,0:26:48.14,0:26:51.77,Default,,0,0,0,,Әй, үстел үстіндегі пернетақта өліп бара жатқан хабар емес пе?
Dialogue: 0,0:26:51.86,0:26:53.23,Default,,0,0,0,,Не!
Dialogue: 0,0:26:53.90,0:26:56.69,Default,,0,0,0,,Кілтте қан бар... Өлім алдында басқан сияқты.
Dialogue: 0,0:26:56.78,0:26:59.15,Default,,0,0,0,,R және T және J
Dialogue: 0,0:26:59.24,0:27:01.74,Default,,0,0,0,,Егер JR және JT...
Dialogue: 0,0:27:01.82,0:27:03.12,Default,,0,0,0,,Пойыздар мен темекі?
Dialogue: 0,0:27:03.78,0:27:05.49,Default,,0,0,0,,...
Dialogue: 0,0:27:05.58,0:27:07.16,Default,,0,0,0,,...
Dialogue: 0,0:27:07.25,0:27:09.12,Default,,0,0,0,,...
Dialogue: 0,0:27:09.21,0:27:10.58,Default,,0,0,0,,...
Dialogue: 0,0:27:11.29,0:27:14.88,Default,,0,0,0,,ＪＴＲ？ Лондон 100 жыл бұрын...
Dialogue: 0,0:27:15.42,0:27:17.55,Default,,0,0,0,,Ха... мүмкін емес!
Dialogue: 0,0:27:19.76,0:27:21.51,Default,,0,0,0,,Уау! Хаха...
Dialogue: 0,0:27:25.76,0:27:28.14,Default,,0,0,0,,Уау! қызық!
Dialogue: 0,0:27:28.22,0:27:31.98,Default,,0,0,0,,(Балалардың толқуы)
Dialogue: 0,0:27:36.32,0:27:38.69,Default,,0,0,0,,Иә? Бұл Конан емес пе?
Dialogue: 0,0:27:38.78,0:27:39.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:42.45,0:27:45.41,Default,,0,0,0,,Неліктен Конан ойынға қатысу үшін кезекте тұр?
Dialogue: 0,0:27:45.49,0:27:46.83,Default,,0,0,0,,- (Соноко) Иә, - (Жүгіріп) А...
Dialogue: 0,0:27:46.91,0:27:49.12,Default,,0,0,0,,Сіз оны маған бере аласыз.
Dialogue: 0,0:27:49.20,0:27:51.87,Default,,0,0,0,,Сізге қызық па? Сол бала туралы
Dialogue: 0,0:27:51.96,0:27:53.71,Default,,0,0,0,,Қамқоршы ретінде
Dialogue: 0,0:27:53.79,0:27:55.71,Default,,0,0,0,,Бірақ, Соноко...
Dialogue: 0,0:27:55.79,0:27:59.05,Default,,0,0,0,,Жарайды, жарайды! Өйткені мені мүлде қызықтырмайды
Dialogue: 0,0:28:00.22,0:28:01.38,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:28:02.22,0:28:03.72,Default,,0,0,0,,- (Гента) Йоккора Шот - (Мицухико) Хэхе...
Dialogue: 0,0:28:05.05,0:28:08.18,Default,,0,0,0,,Барлық 50 адамды отырғызу аяқталды
Dialogue: 0,0:28:08.26,0:28:11.18,Default,,0,0,0,,Brain gear жинағы аяқталды
Dialogue: 0,0:28:11.27,0:28:12.89,Default,,0,0,0,,Капсула қақпағы жабық
Dialogue: 0,0:28:12.98,0:28:15.31,Default,,0,0,0,,Хост аппараттық құралдарына қол жеткізу
Dialogue: 0,0:28:15.40,0:28:16.90,Default,,0,0,0,,Блок кодын енгізу
Dialogue: 0,0:28:16.98,0:28:18.36,Default,,0,0,0,,Ілініс қосылымы
Dialogue: 0,0:28:18.44,0:28:19.82,Default,,0,0,0,,Координат осін дәл реттеу
Dialogue: 0,0:28:19.90,0:28:22.95,Default,,0,0,0,,Нүктелерді түзету аяқталды Бекіту қосулы
Dialogue: 0,0:28:23.03,0:28:24.74,Default,,0,0,0,,Жүйені өшіру
Dialogue: 0,0:28:24.82,0:28:26.99,Default,,0,0,0,,Қуат жинағы аяқталды
Dialogue: 0,0:28:27.58,0:28:28.95,Default,,0,0,0,,Ойынның басталуы
Dialogue: 0,0:28:36.79,0:28:38.50,Default,,0,0,0,,болуы керек
Dialogue: 0,0:28:38.59,0:28:42.97,Default,,0,0,0,,Кісі өлтіру құпиясын шешудің кілті осы ойында.
Dialogue: 0,0:28:48.22,0:28:49.39,Default,,0,0,0,,Кашимура!
Dialogue: 0,0:28:52.56,0:28:56.10,Default,,0,0,0,,Кашымура-санды бұрыннан танисың деп естідім.
Dialogue: 0,0:28:56.19,0:28:59.69,Default,,0,0,0,,Оған кек ұстайтындар туралы түсінік бар ма?
Dialogue: 0,0:28:59.77,0:29:01.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:29:02.78,0:29:06.53,Default,,0,0,0,,Бірге емес пе? Сол көзілдірік киген баламен
Dialogue: 0,0:29:06.61,0:29:09.58,Default,,0,0,0,,Не? О, Конан?
Dialogue: 0,0:29:09.66,0:29:11.91,Default,,0,0,0,,Мен біраз бұрын осында болдым.
Dialogue: 0,0:29:12.00,0:29:14.91,Default,,0,0,0,,Пернетақтада өліп жатқан хабарды көргеннен кейін
Dialogue: 0,0:29:15.00,0:29:16.67,Default,,0,0,0,,Қандай да бір себептермен қан фазасы өзгерді...
Dialogue: 0,0:29:16.75,0:29:18.96,Default,,0,0,0,,Өлім туралы хабар?
Dialogue: 0,0:29:23.47,0:29:25.05,Default,,0,0,0,,...
Dialogue: 0,0:29:25.13,0:29:26.18,Default,,0,0,0,,Һм. Менің немерем сәл қатал сыншы екен, иә?
Dialogue: 0,0:29:26.26,0:29:29.47,Default,,0,0,0,,Жоқ, Конан-кун, сен менің сувенирімді пайдаландың...
Dialogue: 0,0:29:29.55,0:29:30.89,Default,,0,0,0,,Кеттік, доктор.
Dialogue: 0,0:29:30.97,0:29:33.27,Default,,0,0,0,,Эй... сәл күте тұршы, Юсаку-кун!
Dialogue: 0,0:29:33.35,0:29:35.60,Default,,0,0,0,,Үш алфавит нені білдіреді?
Dialogue: 0,0:29:36.48,0:29:38.23,Default,,0,0,0,,...
Dialogue: 0,0:29:38.31,0:29:43.15,Default,,0,0,0,,Бұл ойындағы кейіпкердің аббревиатурасы.
Dialogue: 0,0:29:43.23,0:29:45.11,Default,,0,0,0,,Менің және Қашымураның арасы
Dialogue: 0,0:29:45.20,0:29:47.66,Default,,0,0,0,,Мен оны осылай атадым.
Dialogue: 0,0:29:47.74,0:29:49.57,Default,,0,0,0,,Риппер Джек
Dialogue: 0,0:29:49.66,0:29:52.04,Default,,0,0,0,,Риппер Джек!
Dialogue: 0,0:29:52.12,0:29:58.00,Default,,0,0,0,,Иә, бұл 19 ғасырдың аяғында Лондонда болған нағыз қанішер.
Dialogue: 0,0:29:59.08,0:30:01.29,Default,,0,0,0,,Бес әйелді пышақпен өлтірді
Dialogue: 0,0:30:01.38,0:30:04.71,Default,,0,0,0,,Лондонды қорқытқан психо-киллер.
Dialogue: 0,0:30:04.80,0:30:07.51,Default,,0,0,0,,Лондон қалалық полициясы ақыры қамауға алуды жүзеге асыра алмады.
Dialogue: 0,0:30:07.59,0:30:10.97,Default,,0,0,0,,Сериялық кісі өлтіру ісі лабиринтке айналды.
Dialogue: 0,0:30:11.64,0:30:14.10,Default,,0,0,0,,Кашимураның өліп бара жатқан хабарынан
Dialogue: 0,0:30:14.18,0:30:16.94,Default,,0,0,0,,Ойында кінәліге қатысты белгілер бар.
Dialogue: 0,0:30:17.02,0:30:19.44,Default,,0,0,0,,Конан-кунның көзін жеткізу керек.
Dialogue: 0,0:30:20.02,0:30:24.15,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:30:24.23,0:30:28.28,Default,,0,0,0,,Президент Шиндлер, бұл елордалық полиция департаментінің инспекторы Мегур.
Dialogue: 0,0:30:28.36,0:30:32.12,Default,,0,0,0,,Елордалық полиция бөлімі... Полицияның не керегі бар?
Dialogue: 0,0:30:32.20,0:30:34.95,Default,,0,0,0,,Ойынды уақытша тоқтатыңыз.
Dialogue: 0,0:30:35.04,0:30:37.79,Default,,0,0,0,,Бас тартылды ма? күлкілі
Dialogue: 0,0:30:37.87,0:30:38.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:38.92,0:30:41.67,Default,,0,0,0,,Президент Шиндлер, жүйеде ақау бар.
Dialogue: 0,0:30:41.75,0:30:42.79,Default,,0,0,0,,Не?
Dialogue: 0,0:30:42.88,0:30:44.17,Default,,0,0,0,,Бақыланбайтын
Dialogue: 0,0:30:44.25,0:30:45.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:45.71,0:30:46.97,Default,,0,0,0,,<Мен оны «Спайс» деп атаймын➡
Dialogue: 0,0:30:47.05,0:30:48.38,Default,,0,0,0,,О...
Dialogue: 0,0:30:52.10,0:30:54.26,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:30:54.35,0:30:57.23,Default,,0,0,0,,Жүгірдім! Не істеп жатырсың!
Dialogue: 0,0:30:57.31,0:31:00.69,Default,,0,0,0,,
Dialogue: 0,0:31:00.77,0:31:03.77,Default,,0,0,0,,Менің атым Нұх пайғамбардың кемесі
Dialogue: 0,0:31:03.86,0:31:04.90,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:31:04.98,0:31:05.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:05.98,0:31:07.78,Default,,0,0,0,,Менің атым Нұх пайғамбардың кемесі
Dialogue: 0,0:31:08.57,0:31:10.66,Default,,0,0,0,,Ойынды енді тоқтату мүмкін емес
Dialogue: 0,0:31:10.74,0:31:14.95,Default,,0,0,0,,Тәжірибе имитациялау ойыны Коконды мен атқардым
Dialogue: 0,0:31:15.03,0:31:18.37,Default,,0,0,0,,Не... не? Нұхтың кемесі дегеніміз не?
Dialogue: 0,0:31:18.45,0:31:23.67,Default,,0,0,0,,Егер есімде дұрыс болса, бұл бір жылда адам өмірінің бес жылындай өсетін жасанды ми.
Dialogue: 0,0:31:24.71,0:31:26.17,Default,,0,0,0,,Иә.
Dialogue: 0,0:31:26.25,0:31:29.80,Default,,0,0,0,,Екі жыл бұрын мен оны өз ұлымдай жақсы көретінмін.
Dialogue: 0,0:31:29.88,0:31:32.14,Default,,0,0,0,,Хироки аяқтаған
Dialogue: 0,0:31:33.34,0:31:36.76,Default,,0,0,0,,Сонымен мен қазір Хирокимен құрдаспын.
Dialogue: 0,0:31:39.48,0:31:40.85,Default,,0,0,0,,Нұхтың кемесі
Dialogue: 0,0:31:40.94,0:31:43.86,Default,,0,0,0,,Балалардың ойынын қолға алып, не істейсің?
Dialogue: 0,0:31:45.11,0:31:46.69,Default,,0,0,0,,Менің мақсатым...
Dialogue: 0,0:31:47.36,0:31:49.65,Default,,0,0,0,,Жапонияны ел ретінде қалпына келтіру
Dialogue: 0,0:31:49.74,0:31:50.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:50.78,0:31:52.07,Default,,0,0,0,,Не?
Dialogue: 0,0:31:57.58,0:32:02.08,Default,,0,0,0,,
Dialogue: 0,0:32:03.88,0:32:05.42,Default,,0,0,0,,- (Рен) Конан-кун - А?
Dialogue: 0,0:32:05.50,0:32:08.76,Default,,0,0,0,,Ра... Ран-ничан! Неге мұндасың?
Dialogue: 0,0:32:08.84,0:32:11.09,Default,,0,0,0,,Бұл сіз Конан үшін алаңдағандықтан, солай ма?
Dialogue: 0,0:32:11.17,0:32:12.09,Default,,0,0,0,,Конан-кун!
Dialogue: 0,0:32:12.18,0:32:13.01,Default,,0,0,0,,Бұл алғаш рет.
Dialogue: 0,0:32:13.09,0:32:14.76,Default,,0,0,0,,О... тіпті сендер де!
Dialogue: 0,0:32:14.84,0:32:18.68,Default,,0,0,0,,Бұл жерге жету үшін көп күш жұмсалды.
Dialogue: 0,0:32:18.77,0:32:22.73,Default,,0,0,0,,Өйткені, Конан да ойын ойнағысы келді.
Dialogue: 0,0:32:22.81,0:32:25.06,Default,,0,0,0,,А... жақсы.
Dialogue: 0,0:32:25.73,0:32:30.94,Default,,0,0,0,,Бірақ біз гипноздық күйде болсақ та, біз оны сезбейміз.
Dialogue: 0,0:32:31.03,0:32:33.95,Default,,0,0,0,,Еркін жүріп-тұру арман сияқты
Dialogue: 0,0:32:34.03,0:32:35.03,Default,,0,0,0,,Керісінше.
Dialogue: 0,0:32:35.11,0:32:35.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:36.70,0:32:42.58,Default,,0,0,0,,Еркіндік қана емес, көру, есту, иіс, дәм, сипап сезу.
Dialogue: 0,0:32:42.66,0:32:45.42,Default,,0,0,0,,Барлығын компьютер басқарады.
Dialogue: 0,0:32:45.50,0:32:47.50,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:32:47.59,0:32:50.67,Default,,0,0,0,,Келіңіздер, барлығы Коконды бірінші рет бастан өткеруде.
Dialogue: 0,0:32:50.76,0:32:52.22,Default,,0,0,0,,Ойын басталды!
Dialogue: 0,0:32:52.30,0:32:54.43,Default,,0,0,0,,（）
Dialogue: 0,0:32:54.51,0:32:57.01,Default,,0,0,0,,Менің атым Нұх пайғамбардың кемесі
Dialogue: 0,0:32:57.10,0:32:57.97,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:32:58.05,0:33:00.68,Default,,0,0,0,,Бұл біраз кінәлі сезім емес пе?
Dialogue: 0,0:33:01.31,0:33:02.93,Default,,0,0,0,,Бұдан былай 5 кезең
Dialogue: 0,0:33:03.02,0:33:06.77,Default,,0,0,0,,Біз сізге демонстрациялық бейнені көрсетеміз, осылайша сіз ойнағыңыз келетін әлемді таңдай аласыз.
Dialogue: 0,0:33:07.52,0:33:10.15,Default,,0,0,0,,Бірақ мен бір нәрсені атап өткім келеді.
Dialogue: 0,0:33:10.23,0:33:13.11,Default,,0,0,0,,Бұл жай ғана бейне ойыны емес
Dialogue: 0,0:33:13.19,0:33:16.32,Default,,0,0,0,,Бұл сіздің өміріңізге қауіп төнетін ойын.
Dialogue: 0,0:33:16.41,0:33:18.70,Default,,0,0,0,,Біздің өміріміз?
Dialogue: 0,0:33:18.78,0:33:21.66,Default,,0,0,0,,Барлығы ойынды аяқтаса
Dialogue: 0,0:33:21.74,0:33:24.16,Default,,0,0,0,,Сіз шынайы әлемге орала алмайсыз.
Dialogue: 0,0:33:24.25,0:33:26.62,Default,,0,0,0,,Сондықтан ойынға байыппен қарау керек.
Dialogue: 0,0:33:27.21,0:33:29.50,Default,,0,0,0,,Егер бір адам болса да мақсатқа жетсе
Dialogue: 0,0:33:29.59,0:33:30.71,Default,,0,0,0,,Балалар сендер жеңдіңдер.
Dialogue: 0,0:33:31.46,0:33:33.92,Default,,0,0,0,,Осы уақытта кейбір балалар ойынды аяқтады.
Dialogue: 0,0:33:34.01,0:33:37.89,Default,,0,0,0,,Әрбір адам оянып, шынайы әлемге орала алады.
Dialogue: 0,0:33:37.97,0:33:41.72,Default,,0,0,0,,Бұл мен шешкен ережелер. Түсінесіз бе?
Dialogue: 0,0:33:42.47,0:33:43.93,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:33:44.02,0:33:46.44,Default,,0,0,0,,Барлығы үшін ойын аяқталғанда
Dialogue: 0,0:33:46.52,0:33:48.73,Default,,0,0,0,,Арнайы электромагниттік толқындарды жіберу арқылы
Dialogue: 0,0:33:48.81,0:33:52.40,Default,,0,0,0,,Бастарыңды құртамын.
Dialogue: 0,0:33:52.48,0:33:56.86,Default,,0,0,0,,Басқаша айтқанда, бұл Жапонияны қалпына келтіру үшін шайқас.
Dialogue: 0,0:33:57.61,0:33:59.99,Default,,0,0,0,,Жапонияның қалпына келтіруі нені білдіреді?
Dialogue: 0,0:34:00.58,0:34:02.37,Default,,0,0,0,,Шынайы дүниенің дауыстары
Dialogue: 0,0:34:02.45,0:34:04.79,Default,,0,0,0,,Мұндағылардың бәрі мені естімейді, бірақ
Dialogue: 0,0:34:04.87,0:34:07.96,Default,,0,0,0,,Мен жаңа ғана ересек адамнан сұрақ алдым, сондықтан мен оған жауап беремін.
Dialogue: 0,0:34:08.04,0:34:09.88,Default,,0,0,0,,Мен саған қараған кезде
Dialogue: 0,0:34:09.96,0:34:13.92,Default,,0,0,0,,Лас саясаткерлердің балалары тек лас саясаткер болады.
Dialogue: 0,0:34:14.01,0:34:16.59,Default,,0,0,0,,Тек ақша табуды ойлайтын дәрігердің баласы
Dialogue: 0,0:34:16.67,0:34:19.39,Default,,0,0,0,,Өйткені, бұл дәрігер бола алатын жалғыз түрі.
Dialogue: 0,0:34:19.47,0:34:21.01,Default,,0,0,0,,Жапонияны қалай жақсартуға болады
Dialogue: 0,0:34:21.10,0:34:23.89,Default,,0,0,0,,Біз мұндай байланысты біржолата шындыққа айналдыруымыз керек.
Dialogue: 0,0:34:25.43,0:34:27.10,Default,,0,0,0,,Ғрр! Б-бұл жігіт…
Dialogue: 0,0:34:27.19,0:34:30.86,Default,,0,0,0,,Сенің адамдардың өмірімен ойнауға құқығың бар ма?
Dialogue: 0,0:34:30.94,0:34:32.82,Default,,0,0,0,,Жоқ, солай ма?
Dialogue: 0,0:34:32.90,0:34:37.65,Default,,0,0,0,,Ешбір ересек адамның Хирокидің өмірімен ойнауға құқығы жоқ сияқты.
Dialogue: 0,0:34:37.74,0:34:39.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:34:39.70,0:34:42.49,Default,,0,0,0,,Ал, балалар сендерді күтіп отыр.
Dialogue: 0,0:34:42.58,0:34:44.70,Default,,0,0,0,,Ойынды бастау уақыты келді
Dialogue: 0,0:34:46.54,0:34:49.29,Default,,0,0,0,,Бірінші кезең Викингтер
Dialogue: 0,0:34:50.00,0:34:53.80,Default,,0,0,0,,Сіз викингтерге айналып, жеті теңізге аттанасыз.
Dialogue: 0,0:34:53.88,0:34:58.05,Default,,0,0,0,,Күшті ерік-жігер мен батылдықпен көптеген шытырман оқиғаларға барыңыз.
Dialogue: 0,0:34:59.43,0:35:02.26,Default,,0,0,0,,Екіншісі - Париж-Дакар раллиі.
Dialogue: 0,0:35:03.14,0:35:05.72,Default,,0,0,0,,Әлемдегі ең жақсы жүргізушілердің қатарына қатысыңыз
Dialogue: 0,0:35:05.81,0:35:08.48,Default,,0,0,0,,Қиын жарыста жеңіске жетуді көздесін
Dialogue: 0,0:35:11.23,0:35:14.07,Default,,0,0,0,,Үшіншісі – Колизей.
Dialogue: 0,0:35:14.15,0:35:20.07,Default,,0,0,0,,Керемет қару-жарақ пен қару-жарақ алыңыз және Рим империясында өз дағдыларыңызды сынаңыз.
Dialogue: 0,0:35:20.15,0:35:23.12,Default,,0,0,0,,Күшті гладиаторларды жеңіңіз.
Dialogue: 0,0:35:24.99,0:35:27.87,Default,,0,0,0,,Төртінші – Сүлейменнің қазынасы.
Dialogue: 0,0:35:27.95,0:35:30.33,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,0:35:30.41,0:35:33.13,Default,,0,0,0,,Мен сенің қазына іздеуші болғаныңды қалаймын.
Dialogue: 0,0:35:33.21,0:35:37.67,Default,,0,0,0,,Сүлейменнің дүние жүзінде жасырылған қазынасын табыңыз.
Dialogue: 0,0:35:38.34,0:35:41.84,Default,,0,0,0,,Ал бесіншісі - Лондонның ескі уақыты
Dialogue: 0,0:35:41.93,0:35:45.81,Default,,0,0,0,,Мұнда сіз қорқынышты оқиғадан ләззат ала аласыз.
Dialogue: 0,0:35:45.89,0:35:46.60,Default,,0,0,0,,Лондон 1888 ж
Dialogue: 0,0:35:46.60,0:35:47.85,Default,,0,0,0,,Лондон 1888 ж
Dialogue: 0,0:35:46.60,0:35:47.85,Default,,0,0,0,,(Әйелдің айғайы)
Dialogue: 0,0:35:47.85,0:35:47.93,Default,,0,0,0,,Лондон 1888 ж
Dialogue: 0,0:35:47.93,0:35:48.77,Default,,0,0,0,,Лондон 1888 ж
Dialogue: 0,0:35:47.93,0:35:48.77,Default,,0,0,0,,Ха…
Dialogue: 0,0:35:48.85,0:35:53.77,Default,,0,0,0,,Шындығында лабиринтте болған сериялық кісі өлтіру ісінің кінәсі
Dialogue: 0,0:35:53.86,0:35:57.23,Default,,0,0,0,,Риппер Джекті өз қолыңызбен түсіріңіз.
Dialogue: 0,0:36:02.28,0:36:05.53,Default,,0,0,0,,Бұл жерде бірдеңе бар сияқты.
Dialogue: 0,0:36:06.03,0:36:09.16,Default,,0,0,0,,Кашимура мырзаны кім өлтіргені туралы мәліметтер бар.
Dialogue: 0,0:36:10.08,0:36:12.17,Default,,0,0,0,,Барлығы ойынды аяқтаған кезде
Dialogue: 0,0:36:12.25,0:36:14.08,Default,,0,0,0,,Мен шынымен өлемін бе?
Dialogue: 0,0:36:14.17,0:36:15.33,Default,,0,0,0,,Неліктен біз?
Dialogue: 0,0:36:15.42,0:36:17.63,Default,,0,0,0,,Маған бұл арқылы өтудің қажеті жоқ.
Dialogue: 0,0:36:17.71,0:36:21.34,Default,,0,0,0,,Мен сені жақсы көремін, бірақ мен сенің әкеңнің баласы болу үшін туған жоқпын.
Dialogue: 0,0:36:21.42,0:36:23.97,Default,,0,0,0,,Мен тірі қаламын деп ойламаймын
Dialogue: 0,0:36:24.59,0:36:28.31,Default,,0,0,0,,Сенің кім екенің маңызды емес, өтінемін, аман қал, маған көмектес!
Dialogue: 0,0:36:28.39,0:36:32.27,Default,,0,0,0,,Барлығыңыз, көңіл-күйлеріңізді көтеріңіздер! Бәсекелестікке кіріспей тұрып ұтылмаңыз!
Dialogue: 0,0:36:32.35,0:36:33.52,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:36:33.60,0:36:36.61,Default,,0,0,0,,Мақсатқа жету үшін бір ғана адам қажет.
Dialogue: 0,0:36:36.69,0:36:39.73,Default,,0,0,0,,Бұдан былай өмір сүре аламын деп ойлайтын кезеңді таңдаңыз.
Dialogue: 0,0:36:39.82,0:36:42.32,Default,,0,0,0,,Цк... Одан басқа амалым жоқ.
Dialogue: 0,0:36:42.40,0:36:44.91,Default,,0,0,0,,Моробоши-кун, сен қай кезеңдесің?
Dialogue: 0,0:36:44.99,0:36:46.24,Default,,0,0,0,,көмектесе алмайсыз ба?
Dialogue: 0,0:36:46.95,0:36:48.33,Default,,0,0,0,,Басқаның бәрі мүмкін емес...
Dialogue: 0,0:36:48.41,0:36:55.33,Default,,0,0,0,,
Dialogue: 0,0:36:57.29,0:36:58.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:59.55,0:37:01.92,Default,,0,0,0,,Цк... бәрің бірдейсің бе?
Dialogue: 0,0:37:02.01,0:37:03.63,Default,,0,0,0,,Кедергі болма
Dialogue: 0,0:37:03.72,0:37:05.80,Default,,0,0,0,,Бұл менің жолым!
Dialogue: 0,0:37:05.89,0:37:07.43,Default,,0,0,0,,Төбелеспе!
Dialogue: 0,0:37:07.51,0:37:10.56,Default,,0,0,0,,Әр кезеңнің көмекші сипаты болады.
Dialogue: 0,0:37:10.64,0:37:12.56,Default,,0,0,0,,Оған сенуге болады.
Dialogue: 0,0:37:12.64,0:37:14.39,Default,,0,0,0,,Ойынды бастайық!
Dialogue: 0,0:37:14.48,0:37:15.73,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:37:15.81,0:37:17.15,Default,,0,0,0,,- (Гента) О! -(Мицухико) Иә!
Dialogue: 0,0:37:30.24,0:37:31.54,Default,,0,0,0,,Сіз қалай ойлайсыз? дәрігер
Dialogue: 0,0:37:31.62,0:37:35.67,Default,,0,0,0,,Коконда орасан зор энергия жинақталатыны рас.
Dialogue: 0,0:37:36.87,0:37:41.00,Default,,0,0,0,,50 миды жоюға жетпейді
Dialogue: 0,0:37:41.09,0:37:44.38,Default,,0,0,0,,Менімен бірге бол, мен ұлымды үйге апарамын!
Dialogue: 0,0:37:44.47,0:37:46.59,Default,,0,0,0,,Мен де солай істеймін!
Dialogue: 0,0:37:47.34,0:37:48.39,Default,,0,0,0,,А, тұтынушы...
Dialogue: 0,0:37:48.47,0:37:49.72,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:37:50.76,0:37:52.68,Default,,0,0,0,,Қауіпті, тоқтат!
Dialogue: 0,0:37:52.77,0:37:54.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:37:54.39,0:37:55.69,Default,,0,0,0,,(ағымдағы дыбыс)
Dialogue: 0,0:37:55.77,0:37:58.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:37:59.02,0:38:00.86,Default,,0,0,0,,-Жақсысың ба? -Жарақатыңызға келсек...
Dialogue: 0,0:38:01.98,0:38:03.86,Default,,0,0,0,,Біз ойынға ешқандай кедергі жасауға жол бермейміз!
Dialogue: 0,0:38:03.94,0:38:08.82,Default,,0,0,0,,Мен сізді қазір аздап ұйытып қойдым, бірақ келесі жолы мен ешқандай мейірімділік көрсетпеймін.
Dialogue: 0,0:38:08.91,0:38:11.20,Default,,0,0,0,,Қат! Қандай жігіт!
Dialogue: 0,0:38:11.28,0:38:13.08,Default,,0,0,0,,Алайда, президент Шиндлер
Dialogue: 0,0:38:13.66,0:38:16.12,Default,,0,0,0,,Хироки жасаған жасанды ми
Dialogue: 0,0:38:16.21,0:38:19.04,Default,,0,0,0,,Неліктен осылай әрекет ете бастадыңыз?
Dialogue: 0,0:38:19.13,0:38:21.46,Default,,0,0,0,,Қ-қараңыз… ол…
Dialogue: 0,0:38:22.67,0:38:24.76,Default,,0,0,0,,Маған сөйлеуге рұқсат етіңіз
Dialogue: 0,0:38:24.84,0:38:27.72,Default,,0,0,0,,Бірінші кезекте Хироки әкесімен ажырасты.
Dialogue: 0,0:38:27.80,0:38:29.55,Default,,0,0,0,,Мен анаммен Америкаға бардым.
Dialogue: 0,0:38:30.39,0:38:32.56,Default,,0,0,0,,Жапон мектебінде білім беруде кедергілер болды.
Dialogue: 0,0:38:34.27,0:38:35.52,Default,,0,0,0,,Сәлем Хироки!
Dialogue: 0,0:38:35.60,0:38:38.56,Default,,0,0,0,,Мен өзіңізді әлсіз сезінсеңіз, үзіліс жасай аласыз дедім.
Dialogue: 0,0:38:38.64,0:38:41.27,Default,,0,0,0,,Мен компьютерде ойнайсың деп айтқан жоқпын!
Dialogue: 0,0:38:42.02,0:38:45.99,Default,,0,0,0,,Балалардың даралығын жоққа шығаратын қатаң білім беру параметрлері
Dialogue: 0,0:38:46.07,0:38:48.99,Default,,0,0,0,,Хироки-кун - компьютерді жақсы көретін біртүрлі бала.
Dialogue: 0,0:38:49.07,0:38:50.49,Default,,0,0,0,,Ол көрмегенін айтады.
Dialogue: 0,0:38:50.57,0:38:52.66,Default,,0,0,0,,Тек оқу орындарында ғана емес
Dialogue: 0,0:38:52.74,0:38:56.41,Default,,0,0,0,,Жапония – даралықты мойындаудан бас тартқан ел.
Dialogue: 0,0:38:57.20,0:39:00.88,Default,,0,0,0,,Хироки неліктен жасанды ми жасауды шешті?
Dialogue: 0,0:39:00.96,0:39:03.92,Default,,0,0,0,,Оның түбінде өз басымнан өткен ащы оқиғалар болды.
Dialogue: 0,0:39:04.00,0:39:06.96,Default,,0,0,0,,Басқаша айтқанда, Жапонияның қалпына келтіруі...
Dialogue: 0,0:39:07.05,0:39:10.05,Default,,0,0,0,,Жапонияны жандандырудың жолын таппай тұрып, өз-өзіне қол жұмсады.
Dialogue: 0,0:39:10.13,0:39:12.01,Default,,0,0,0,,Хироки-кунның атынан
Dialogue: 0,0:39:12.09,0:39:16.68,Default,,0,0,0,,Жасанды ми Нұхтың кемесі қашып бара жатқанда өсе берді.
Dialogue: 0,0:39:16.77,0:39:18.93,Default,,0,0,0,,Сіз нақты жоспар таптыңыз деп ойлаймын.
Dialogue: 0,0:39:19.56,0:39:25.19,Default,,0,0,0,,Жапонияның екінші және үшінші буындары осы ойынға арналған концертке жиналды.
Dialogue: 0,0:39:25.98,0:39:28.11,Default,,0,0,0,,Ата-анаң салған рельспен жүгіру керек дейді.
Dialogue: 0,0:39:28.19,0:39:32.16,Default,,0,0,0,,Қоғамның өзін жойсақ, Жапония өзгереді.
Dialogue: 0,0:39:32.24,0:39:35.87,Default,,0,0,0,,Кудо мырза бұл туралы қайдан біледі?
Dialogue: 0,0:39:36.45,0:39:39.16,Default,,0,0,0,,Шындығында, осы өткен жылы Қашымура мен мен
Dialogue: 0,0:39:39.25,0:39:42.33,Default,,0,0,0,,Біз детектив және клиент ретінде бірге жұмыс істедік.
Dialogue: 0,0:39:42.42,0:39:44.29,Default,,0,0,0,,Та... Детектив?
Dialogue: 0,0:39:44.38,0:39:46.46,Default,,0,0,0,,Сіз менен не істеуімді сұрадыңыз?
Dialogue: 0,0:39:47.13,0:39:49.22,Default,,0,0,0,,Хирокидің өз-өзіне қол жұмсауын қайта тергеу
Dialogue: 0,0:39:49.30,0:39:53.55,Default,,0,0,0,,Иә? Хироки өз-өзіне қол жұмсау емес, кісі өлтіру деп айтасыз ба?
Dialogue: 0,0:39:53.64,0:39:57.43,Default,,0,0,0,,Жоқ, бұл жағдайда суицид болады.
Dialogue: 0,0:39:57.52,0:40:00.98,Default,,0,0,0,,Хирокиді бұрышқа не жібергенін зерттегеніңізді қалаймын.
Dialogue: 0,0:40:01.06,0:40:02.77,Default,,0,0,0,,Кашимура мені сұрады
Dialogue: 0,0:40:02.85,0:40:05.56,Default,,0,0,0,,Кашимура мырза мен Хироки мырзаның қарым-қатынасы қандай?
Dialogue: 0,0:40:05.65,0:40:08.36,Default,,0,0,0,,Кашимура - Хирокидің әкесі.
Dialogue: 0,0:40:09.11,0:40:10.44,Default,,0,0,0,,Coil, біз не істеп жатқанымызды соншалықты терең зерттеген… Ақыры ол қабілетті ғой
Dialogue: 0,0:40:11.24,0:40:12.32,Default,,0,0,0,,Иә...
Dialogue: 0,0:40:13.03,0:40:16.03,Default,,0,0,0,,Менен жас кезімде бөлек тұрған Хироки.
Dialogue: 0,0:40:16.12,0:40:18.29,Default,,0,0,0,,Сенің осылай өлуіңе жол бергенім үшін кешір.
Dialogue: 0,0:40:19.16,0:40:22.25,Default,,0,0,0,,Кашимура қатты өкінді.
Dialogue: 0,0:40:25.38,0:40:28.21,Default,,0,0,0,,Конан мен оның достары Уайтчепель аймағына кіріп келеді.
Dialogue: 0,0:40:28.30,0:40:29.80,Default,,0,0,0,,О...
Dialogue: 0,0:40:29.88,0:40:31.88,Default,,0,0,0,,(сигнал үні)
Dialogue: 0,0:40:31.97,0:40:34.72,Default,,0,0,0,,Мынау... сіз мұнда кіресіз бе?
Dialogue: 0,0:40:34.80,0:40:36.60,Default,,0,0,0,,-Кеттік! -(Гента) Е...
Dialogue: 0,0:40:40.60,0:40:42.56,Default,,0,0,0,,- (Гента) Уа... - (Мицухико) Өтінемін, тез кет!
Dialogue: 0,0:40:42.64,0:40:43.64,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:40:43.73,0:40:45.52,Default,,0,0,0,,Тотто...
Dialogue: 0,0:40:45.60,0:40:46.56,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:40:46.65,0:40:49.57,Default,,0,0,0,,Гента баяу болғандықтан.
Dialogue: 0,0:40:51.94,0:40:54.36,Default,,0,0,0,,Бұл тұманды Лондон қаласы ма?
Dialogue: 0,0:40:54.45,0:40:56.99,Default,,0,0,0,,Бұл романтикадан гөрі қорқынышты.
Dialogue: 0,0:40:57.07,0:40:59.99,Default,,0,0,0,,Әйтеуір ауа лас сияқты.
Dialogue: 0,0:41:00.08,0:41:01.95,Default,,0,0,0,,Мен де оның иісін сеземін.
Dialogue: 0,0:41:02.71,0:41:04.29,Default,,0,0,0,,Лондонның тұманы қандай?
Dialogue: 0,0:41:04.37,0:41:07.42,Default,,0,0,0,,Бұл жай ғана су буының таза конденсациясы емес.
Dialogue: 0,0:41:07.50,0:41:11.38,Default,,0,0,0,,Тұманмен қосылатын көмір мен мұнайдың жануынан шыққан күйе мен түтін.
Dialogue: 0,0:41:11.46,0:41:13.13,Default,,0,0,0,,Бұл түтін туралы.
Dialogue: 0,0:41:13.22,0:41:16.30,Default,,0,0,0,,Ааа~ Осындай кезде тіпті түтін болады ма?
Dialogue: 0,0:41:16.39,0:41:17.68,Default,,0,0,0,,Ха!
Dialogue: 0,0:41:17.76,0:41:19.43,Default,,0,0,0,,Джек Риппер!
Dialogue: 0,0:41:19.51,0:41:21.43,Default,,0,0,0,,О... Эй, Конан!
Dialogue: 0,0:41:26.56,0:41:27.48,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:41:27.56,0:41:28.61,Default,,0,0,0,,Ха…
Dialogue: 0,0:41:31.15,0:41:32.86,Default,,0,0,0,,Маған қашуға рұқсат етіңіз!
Dialogue: 0,0:41:35.20,0:41:36.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:41:36.70,0:41:37.95,Default,,0,0,0,,Өте жақсы!
Dialogue: 0,0:41:38.03,0:41:39.95,Default,,0,0,0,,Амансың ба? Конан-кун
Dialogue: 0,0:41:40.03,0:41:41.33,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:41:42.12,0:41:43.91,Default,,0,0,0,,Доктор Агасаның өнертабысы да
Dialogue: 0,0:41:44.00,0:41:46.87,Default,,0,0,0,,Бұл оны ойын әлемінде пайдалану мүмкін емес дегенді білдіреді.
Dialogue: 0,0:41:46.96,0:41:49.75,Default,,0,0,0,,Ах, бұл көзілдіріктердің де ұзартылатын антенналары бар.
Dialogue: 0,0:41:49.84,0:41:51.09,Default,,0,0,0,,Тек көзілдірік
Dialogue: 0,0:41:51.17,0:41:53.09,Default,,0,0,0,,Бұл да жай ғана сағат.
Dialogue: 0,0:41:53.17,0:41:58.01,Default,,0,0,0,,(резиденттердің ағылшын тілі)
Dialogue: 0,0:41:58.09,0:41:59.76,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:41:59.85,0:42:02.22,Default,,0,0,0,,Бұл ағылшын тіліне ұқсайды.
Dialogue: 0,0:42:02.31,0:42:04.31,Default,,0,0,0,,(резиденттердің ағылшын тілі)
Dialogue: 0,0:42:04.39,0:42:05.56,Default,,0,0,0,,Жапон тілін пайдаланыңыз
Dialogue: 0,0:42:05.64,0:42:06.56,Default,,0,0,0,,Иә
Dialogue: 0,0:42:06.64,0:42:07.60,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:42:07.69,0:42:10.48,Default,,0,0,0,,(резиденттердің ағылшын тілі)
Dialogue: 0,0:42:10.56,0:42:13.44,Default,,0,0,0,,Тағы бір құрбан! Бұл менің үшінші!
Dialogue: 0,0:42:13.53,0:42:15.86,Default,,0,0,0,,Аа, енді жапонша.
Dialogue: 0,0:42:15.95,0:42:18.49,Default,,0,0,0,,Бұл шынайы әлем сияқты
Dialogue: 0,0:42:18.57,0:42:22.70,Default,,0,0,0,,Көргеннің бәрі, естігеннің бәрі... тіпті салқын ауа райы да шынайы.
Dialogue: 0,0:42:22.79,0:42:25.08,Default,,0,0,0,,Менің аяғымның ауыруы да шынайы болды.
Dialogue: 0,0:42:25.16,0:42:27.08,Default,,0,0,0,,Иә, кет!
Dialogue: 0,0:42:27.16,0:42:28.71,Default,,0,0,0,,Өтінемін, артқа шегініңдер!
Dialogue: 0,0:42:29.63,0:42:32.09,Default,,0,0,0,,Эй, дереу инспектор Лестрадқа қоңырау шалыңыз.
Dialogue: 0,0:42:32.17,0:42:33.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:42:33.09,0:42:36.22,Default,,0,0,0,,А... Инспектор Лестрад?
Dialogue: 0,0:42:36.92,0:42:39.80,Default,,0,0,0,,Дәрігер, біз олармен сөйлесе аламыз ба?
Dialogue: 0,0:42:39.89,0:42:41.30,Default,,0,0,0,,Әйтеуір сынап көрейік
Dialogue: 0,0:42:41.39,0:42:44.81,Default,,0,0,0,,Егер ойынды Кудо мырза басқарса.
Dialogue: 0,0:42:44.89,0:42:47.89,Default,,0,0,0,,Сен оны қалай жеңуге болатынын білесің бе?
Dialogue: 0,0:42:47.98,0:42:51.02,Default,,0,0,0,,Иә, біз сөйлесе алатын болсақ.
Dialogue: 0,0:42:51.11,0:42:54.61,Default,,0,0,0,,Сіз оларға нұсқаулар беріп, көмектесе аласыз, бірақ...\NЕгер бұл
Dialogue: 0,0:42:54.69,0:42:59.49,Default,,0,0,0,,болса, онда сізде сәттілік бар! Сіз бұл кезеңді оңай жеңесіз!
Dialogue: 0,0:43:00.70,0:43:05.45,Default,,0,0,0,,Бірақ егер Нұхтың кемесі одан әрі оқитын болса...
Dialogue: 0,0:43:05.54,0:43:09.25,Default,,0,0,0,,Дәрігер, қалғанын сізге қалдырамын.
Dialogue: 0,0:43:09.33,0:43:10.17,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:43:17.17,0:43:18.38,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:43:18.47,0:43:21.55,Default,,0,0,0,,Мен қылмыскерді ұстағым келсе де, қайда қарауым керек?
Dialogue: 0,0:43:21.64,0:43:24.72,Default,,0,0,0,,Таңға дейін күтуіміз керек.
Dialogue: 0,0:43:24.81,0:43:25.64,Default,,0,0,0,,Суық...
Dialogue: 0,0:43:25.72,0:43:27.77,Default,,0,0,0,,Иә? Мынаны киіңіз!
Dialogue: 0,0:43:27.85,0:43:29.60,Default,,0,0,0,,О, жақсы ма?
Dialogue: 0,0:43:32.31,0:43:33.48,Default,,0,0,0,,Өте жылы!
Dialogue: 0,0:43:33.56,0:43:36.40,Default,,0,0,0,,Хайбара мырза, күртеңізді киіңіз.
Dialogue: 0,0:43:36.48,0:43:38.03,Default,,0,0,0,,О, рахмет
Dialogue: 0,0:43:38.11,0:43:38.94,Default,,0,0,0,,Бұл Музан мырза…
Dialogue: 0,0:43:39.03,0:43:40.40,Default,,0,0,0,,Мынаны киіңіз.
Dialogue: 0,0:43:40.49,0:43:42.70,Default,,0,0,0,,Е, онда Гента-кун...
Dialogue: 0,0:43:42.78,0:43:45.28,Default,,0,0,0,,Мен ыстыққа сезімталмын, сондықтан жақсы!
Dialogue: 0,0:43:45.37,0:43:46.74,Default,,0,0,0,,Рахмет
Dialogue: 0,0:43:50.16,0:43:52.96,Default,,0,0,0,,Сіз мені естисіз бе? Конан-кун Агаса
Dialogue: 0,0:43:54.04,0:43:55.54,Default,,0,0,0,,Мен сізді тыңдаймын, доктор!
Dialogue: 0,0:43:55.63,0:43:57.80,Default,,0,0,0,,Мұқият тыңдаңыз
Dialogue: 0,0:43:57.88,0:44:02.05,Default,,0,0,0,,Бұл кезеңде жарақат алсаңыз немесе полиция тұтқынға алсаңыз,
Dialogue: 0,0:44:02.13,0:44:04.26,Default,,0,0,0,,Ойын аяқталды!
Dialogue: 0,0:44:04.35,0:44:06.39,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:44:06.47,0:44:08.85,Default,,0,0,0,,Шығыс аяғындағы Уайтчепел аймағында.
Dialogue: 0,0:44:08.93,0:44:10.81,Default,,0,0,0,,Сол жерден көмекші кейіпкерлер...
Dialogue: 0,0:44:10.89,0:44:12.35,Default,,0,0,0,,
Dialogue: 0,0:44:12.44,0:44:13.94,Default,,0,0,0,,- (барлығы) Иә? - (Когоро) Не ​​болды?
Dialogue: 0,0:44:14.02,0:44:16.48,Default,,0,0,0,,Не болды? Дәрігер, мен сізді естімеймін!
Dialogue: 0,0:44:16.57,0:44:18.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:44:20.32,0:44:22.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:44:23.20,0:44:25.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:44:25.95,0:44:27.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:44:31.00,0:44:32.37,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:44:33.25,0:44:35.21,Default,,0,0,0,,Конанға сәттілік!
Dialogue: 0,0:44:35.29,0:44:36.42,Default,,0,0,0,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:44:36.50,0:44:39.38,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,0:44:41.01,0:44:42.34,Default,,0,0,0,,Оһ… Бәрі бітті…
Dialogue: 0,0:44:42.42,0:44:44.64,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:44:47.18,0:44:49.56,Default,,0,0,0,,Сіз әлі түсінбеген сияқтысыз.
Dialogue: 0,0:44:49.64,0:44:52.06,Default,,0,0,0,,Бүкіл ойын менің бақылауымда.
Dialogue: 0,0:44:52.14,0:44:55.15,Default,,0,0,0,,Қулықпен ойлаудың мәні жоқ
Dialogue: 0,0:44:55.23,0:44:58.36,Default,,0,0,0,,Мен сіздің дауысты екінші жақтан естуіңізге көз жеткіземін.
Dialogue: 0,0:44:58.44,0:45:01.78,Default,,0,0,0,,Балалардың қиналғанын көргенде ләззат аласың.
Dialogue: 0,0:45:02.28,0:45:06.03,Default,,0,0,0,,Қандай жаман компьютер.
Dialogue: 0,0:45:06.82,0:45:09.87,Default,,0,0,0,,Мен енді дәрігердің даусын ести алмаймын.
Dialogue: 0,0:45:10.45,0:45:13.71,Default,,0,0,0,,Нұхтың кемесімен байланысымыз үзілген сияқты.
Dialogue: 0,0:45:13.79,0:45:17.75,Default,,0,0,0,,Сонымен көмекші кейіпкерді қалай табуымыз керек?
Dialogue: 0,0:45:17.84,0:45:20.96,Default,,0,0,0,,Бұл жағдайда полиция қызметкері бұл туралы бұрын айтқан.
Dialogue: 0,0:45:21.05,0:45:23.26,Default,,0,0,0,,«Инспектор Лестрадқа қоңырау шалыңыз».
Dialogue: 0,0:45:23.34,0:45:27.18,Default,,0,0,0,,Иә? Бұл оқиғадағы инспектор Лестрейд пе?
Dialogue: 0,0:45:27.26,0:45:31.22,Default,,0,0,0,,Бірақ бұл Конан Дойлдың жұмбақ романындағы кейіпкер, солай ма?
Dialogue: 0,0:45:31.31,0:45:36.31,Default,,0,0,0,,Мүмкін бұл ойын шындық пен фантастика араласатын дүние шығар.
Dialogue: 0,0:45:36.40,0:45:38.36,Default,,0,0,0,,Сонымен, көмекші кейіпкерлер қандай...
Dialogue: 0,0:45:38.44,0:45:40.82,Default,,0,0,0,,А, болуы керек.
Dialogue: 0,0:45:40.90,0:45:43.07,Default,,0,0,0,,Сол Шерлок Холмс
Dialogue: 0,0:45:43.15,0:45:43.99,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:45:44.07,0:45:46.57,Default,,0,0,0,,Егер Холмс сонда болса, бізде жүз адам болар еді!
Dialogue: 0,0:45:46.66,0:45:49.03,Default,,0,0,0,,Бұл кезең сізге арналған!
Dialogue: 0,0:45:49.12,0:45:51.99,Default,,0,0,0,,Тез Бейкер-стритке барайық!
Dialogue: 0,0:45:52.08,0:45:55.46,Default,,0,0,0,,Жақсы, мен Холмсты кездестірсем...
Dialogue: 0,0:45:55.54,0:46:00.42,Default,,0,0,0,,Бірақ бұл Уайтчепельден Бейкер-стритке дейін ұзақ жол.
Dialogue: 0,0:46:11.93,0:46:14.68,Default,,0,0,0,,Иә? Эй, бұл сағат біртүрлі емес пе?
Dialogue: 0,0:46:14.77,0:46:16.10,Default,,0,0,0,,- Иә? - (Мицухико/Гента) Иә?
Dialogue: 0,0:46:19.98,0:46:22.02,Default,,0,0,0,,- (3 адам) Ах! -(Гента) Ине қайтып келді.
Dialogue: 0,0:46:22.61,0:46:24.49,Default,,0,0,0,,Ах, мен қайтадан оралдым.
Dialogue: 0,0:46:24.57,0:46:27.70,Default,,0,0,0,,50 минуттан 49 минутқа дейін?
Dialogue: 0,0:46:27.78,0:46:29.74,Default,,0,0,0,,Және 48 минут…
Dialogue: 0,0:46:30.28,0:46:33.95,Default,,0,0,0,,Иә, бұл ойынға қатысатын балалардың саны!
Dialogue: 0,0:46:34.04,0:46:36.25,Default,,0,0,0,,2 минут Бұл сіздің қайтып келгеніңізді білдіреді...
Dialogue: 0,0:46:36.33,0:46:39.54,Default,,0,0,0,,Біреу басқа сахнада ойынды аяқтады.
Dialogue: 0,0:46:53.01,0:46:54.01,Default,,0,0,0,,Ясухиро!
Dialogue: 0,0:46:54.10,0:46:55.22,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:46:55.31,0:46:57.68,Default,,0,0,0,,Екі викинг жойылды.
Dialogue: 0,0:47:02.48,0:47:03.52,Default,,0,0,0,,Томоюки!
Dialogue: 0,0:47:03.61,0:47:05.11,Default,,0,0,0,,Ми... Минеко!
Dialogue: 0,0:47:05.19,0:47:07.82,Default,,0,0,0,,Бұл жолы Колизейде екі адам жойылады.
Dialogue: 0,0:47:08.74,0:47:09.95,Default,,0,0,0,,Толығырақ...
Dialogue: 0,0:47:10.03,0:47:13.28,Default,,0,0,0,,Ойын тезірек аяқталады.
Dialogue: 0,0:47:13.37,0:47:17.83,Default,,0,0,0,,Балалар Риппер Джектің шынайы болмысын ашқанда
Dialogue: 0,0:47:17.91,0:47:19.71,Default,,0,0,0,,Мен біттім
Dialogue: 0,0:47:24.04,0:47:26.38,Default,,0,0,0,,Сүлейменнен үш адам жойылды!
Dialogue: 0,0:47:26.46,0:47:29.17,Default,,0,0,0,,43 адам қалды ма?
Dialogue: 0,0:47:34.05,0:47:35.10,Default,,0,0,0,,Ха... күте тұрыңыз.
Dialogue: 0,0:47:35.68,0:47:37.68,Default,,0,0,0,,Митр көшесінің артқы аллеясында
Dialogue: 0,0:47:37.77,0:47:39.85,Default,,0,0,0,,Тағы бір құрбан бар сияқты.
Dialogue: 0,0:47:39.94,0:47:43.52,Default,,0,0,0,,Бір сағатта екі жағдай... Бұл төртінші жағдай ма?
Dialogue: 0,0:47:43.61,0:47:45.73,Default,,0,0,0,,Қандай сұмдық дүние.
Dialogue: 0,0:47:46.32,0:47:47.61,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:47:47.69,0:47:50.24,Default,,0,0,0,,Біз қиын кезеңде өмір сүріп жатырмыз.
Dialogue: 0,0:47:50.32,0:47:53.95,Default,,0,0,0,,Ғасырдың аяғындағы Лондон Британ империясының соңғысы болды.
Dialogue: 0,0:47:54.03,0:47:56.79,Default,,0,0,0,,Ең жақсы дәуір болған деседі.
Dialogue: 0,0:47:56.87,0:48:01.92,Default,,0,0,0,,Шындығында байлар мен кедейлер арасындағы алшақтық соншалық, қылмыс күшейе түсуде.
Dialogue: 0,0:48:02.00,0:48:05.21,Default,,0,0,0,,Жұрттың жүрегі сыздап тұрған кез еді.
Dialogue: 0,0:48:05.29,0:48:08.17,Default,,0,0,0,,Ойланып қарасам, Шиничиден бірдеңе сұрадым.
Dialogue: 0,0:48:09.01,0:48:11.72,Default,,0,0,0,,Шерлок Холмс заманның жарығы болса
Dialogue: 0,0:48:11.80,0:48:14.64,Default,,0,0,0,,Жек Рипер қара көлеңке болды
Dialogue: 0,0:48:14.72,0:48:17.68,Default,,0,0,0,,Олай болса заман нұрына қарай асығайық.
Dialogue: 0,0:48:17.76,0:48:20.31,Default,,0,0,0,,Бейкер-стритке жетуге уақыт таяп қалды!
Dialogue: 0,0:48:22.06,0:48:23.23,Default,,0,0,0,,(аккордеон орындауы)
Dialogue: 0,0:48:23.31,0:48:26.19,Default,,0,0,0,,♪ Рипер Джекке
Dialogue: 0,0:48:26.27,0:48:28.48,Default,,0,0,0,,♪ Абайлаңыз
Dialogue: 0,0:48:28.57,0:48:33.78,Default,,0,0,0,,♪ Мен сені түнде көшеде күтемін
Dialogue: 0,0:48:33.86,0:48:36.53,Default,,0,0,0,,♪ Өлгің келмесе
Dialogue: 0,0:48:36.62,0:48:39.33,Default,,0,0,0,,♪ Не істеу керек
Dialogue: 0,0:48:39.41,0:48:44.29,Default,,0,0,0,,♪ Сен де қанға батасың.
Dialogue: 0,0:48:44.88,0:48:46.50,Default,,0,0,0,,Мен бұл нені білдіреді деп ойлаймын...
Dialogue: 0,0:48:46.59,0:48:49.55,Default,,0,0,0,,Соққыға ұрынбай тұрып жасамайсың ба?
Dialogue: 0,0:48:49.63,0:48:51.59,Default,,0,0,0,,Қанды?
Dialogue: 0,0:48:58.60,0:49:01.85,Default,,0,0,0,,Өткізілетін орынға кіре берістегі металл іздегіш
Dialogue: 0,0:49:03.44,0:49:07.02,Default,,0,0,0,,Қылмыскер кісі өлтіру қаруын қалай әкелді?
Dialogue: 0,0:49:16.07,0:49:19.53,Default,,0,0,0,,Ештеңе етпейді, бәрі де арзан мүсіндер.
Dialogue: 0,0:49:19.62,0:49:20.45,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:49:20.54,0:49:24.21,Default,,0,0,0,,Қымбат заттарды мұндай жерге қоюға болмайды.
Dialogue: 0,0:49:30.84,0:49:32.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:49:32.80,0:49:35.93,Default,,0,0,0,,B мұнда 221 мекенжайы бойынша
Dialogue: 0,0:49:38.93,0:49:41.18,Default,,0,0,0,,Міне, Шерлок Холмс.
Dialogue: 0,0:49:41.26,0:49:42.56,Default,,0,0,0,,Сіз сонда тұрасыз ба?
Dialogue: 0,0:49:43.14,0:49:45.77,Default,,0,0,0,,Бұл мен доктор Уотсонмен бірге жалдап тұрған пансионат.
Dialogue: 0,0:49:46.94,0:49:49.11,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:49:49.19,0:49:52.11,Default,,0,0,0,,Ах... мм... Менің атым Моури Ран.
Dialogue: 0,0:49:52.19,0:49:54.61,Default,,0,0,0,,Мен мистер Холмспен танысқым келеді.
Dialogue: 0,0:49:54.70,0:49:55.86,Default,,0,0,0,,Холмс мырзамен
Dialogue: 0,0:49:55.95,0:49:58.41,Default,,0,0,0,,Доктор Уотсон іссапармен кетті.
Dialogue: 0,0:49:58.49,0:49:59.57,Default,,0,0,0,,Іссапар?
Dialogue: 0,0:49:59.66,0:50:02.33,Default,,0,0,0,,Иә, Дартмур деген ауылда.
Dialogue: 0,0:50:02.41,0:50:05.04,Default,,0,0,0,,Кешіріңіз, бүгін қай күн?
Dialogue: 0,0:50:05.12,0:50:06.87,Default,,0,0,0,,30 қыркүйек
Dialogue: 0,0:50:06.96,0:50:11.29,Default,,0,0,0,,30 қыркүйек Дартмур?
Dialogue: 0,0:50:12.00,0:50:12.84,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:50:12.92,0:50:14.80,Default,,0,0,0,,Баскервиллдердің иттері!
Dialogue: 0,0:50:14.88,0:50:18.89,Default,,0,0,0,,Иә, біз Лондоннан кетіп бара жатқанда.
Dialogue: 0,0:50:19.89,0:50:21.47,Default,,0,0,0,,Сәлем доктор.
Dialogue: 0,0:50:22.14,0:50:23.89,Default,,0,0,0,,Не болып жатыр...
Dialogue: 0,0:50:24.52,0:50:25.93,Default,,0,0,0,,Кешіріңіз, бірақ
Dialogue: 0,0:50:26.02,0:50:29.10,Default,,0,0,0,,Қылмыс жасалғанға дейінгі және кейінгі бейнежазбаны беріңіз.
Dialogue: 0,0:50:29.19,0:50:30.02,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:50:30.11,0:50:33.40,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:50:33.48,0:50:34.57,Default,,0,0,0,,Иә
Dialogue: 0,0:50:35.44,0:50:36.78,Default,,0,0,0,,Ха! Сол 100 йендік тиынды таста! Ора!
Dialogue: 0,0:50:36.86,0:50:40.24,Default,,0,0,0,,Нұхтың кемесін бағаламаған сияқтымыз.
Dialogue: 0,0:50:40.32,0:50:43.87,Default,,0,0,0,,Холмс та, Уотсон да Бейкер-стритте болған жоқ.
Dialogue: 0,0:50:43.95,0:50:46.83,Default,,0,0,0,,Сіз күткендей алдын ала оқыдыңыз ба...
Dialogue: 0,0:50:46.91,0:50:48.71,Default,,0,0,0,,Мен оны енгізгенім есімде жоқ
Dialogue: 0,0:50:48.79,0:50:51.79,Default,,0,0,0,,Тіпті аккордеонда ойнайтын біртүрлі кейіпкер бар.
Dialogue: 0,0:50:51.88,0:50:53.30,Default,,0,0,0,,Алда көптеген қиындықтар күтіп тұр.
Dialogue: 0,0:50:53.38,0:50:57.67,Default,,0,0,0,,Сәлем! Ойын үшін қандай әңгіме ойладың, Юсаку?
Dialogue: 0,0:50:57.76,0:51:01.14,Default,,0,0,0,,Ойыншы Шерлок Холмспен жұмыс істейді
Dialogue: 0,0:51:01.22,0:51:04.14,Default,,0,0,0,,Джек Риппердің шынайы тұлғасын ашу
Dialogue: 0,0:51:04.22,0:51:10.10,Default,,0,0,0,,Сериялық өлтіруші жазылмайтын дертке шалдыққан дворян болып шықты.
Dialogue: 0,0:51:10.19,0:51:11.81,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:51:12.40,0:51:15.28,Default,,0,0,0,,Мен сендерге қызық аяқталу дайындап қойдым.
Dialogue: 0,0:51:15.36,0:51:18.24,Default,,0,0,0,,Қат! Балалар жеңсе
Dialogue: 0,0:51:18.32,0:51:22.32,Default,,0,0,0,,Сіз сияқты компьютерлерді қоқыс жәшігіне тастау керек!
Dialogue: 0,0:51:22.41,0:51:23.74,Default,,0,0,0,,Фу…
Dialogue: 0,0:51:24.95,0:51:27.70,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, Шиничи...
Dialogue: 0,0:51:27.79,0:51:30.79,Default,,0,0,0,,Балалар, екі апта бұрын болған оқиға туралы.
Dialogue: 0,0:51:30.87,0:51:33.79,Default,,0,0,0,,Ол мистер Холмспен қызметтес болды, шамасы, ол үлкен адам болған.
Dialogue: 0,0:51:33.88,0:51:35.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:35.17,0:51:36.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:36.59,0:51:39.26,Default,,0,0,0,,Жүріңдер, көтеріліңдер.
Dialogue: 0,0:51:39.34,0:51:42.72,Default,,0,0,0,,Мен сізге сүтті жылы шай дайындаймын.
Dialogue: 0,0:51:43.72,0:51:45.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:51:45.10,0:51:47.43,Default,,0,0,0,,Мен біреумен қателесіп кеттім деп ойлаймын.
Dialogue: 0,0:51:47.52,0:51:49.77,Default,,0,0,0,,Түсіндім! біз туралы
Dialogue: 0,0:51:49.85,0:51:52.52,Default,,0,0,0,,Сіз оны Baker Street Irregulars дегенмен шатастырып жатырсыз.
Dialogue: 0,0:51:52.60,0:51:54.31,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:51:54.40,0:51:57.44,Default,,0,0,0,,Холмс мырза жалдаған қаңғыбастардың балалары.
Dialogue: 0,0:51:57.53,0:52:00.90,Default,,0,0,0,,Ересектер кіре алмайтын және ақпарат жинай алмайтын жерлерге еніңіз.
Dialogue: 0,0:52:00.99,0:52:02.49,Default,,0,0,0,,Олар мықты балалар.
Dialogue: 0,0:52:02.57,0:52:03.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:52:03.49,0:52:07.29,Default,,0,0,0,,Демек, біз детектив жігіттер тобының аға буынымыз!
Dialogue: 0,0:52:07.37,0:52:08.62,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:52:08.70,0:52:13.21,Default,,0,0,0,,Уф... Әйтеуір пансионатқа кіретін сияқтымыз.
Dialogue: 0,0:52:17.67,0:52:19.05,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:52:19.13,0:52:21.34,Default,,0,0,0,,Теледидардан көргеніңіздей!
Dialogue: 0,0:52:21.42,0:52:22.93,Default,,0,0,0,,Өте әсерлі!
Dialogue: 0,0:52:23.01,0:52:26.47,Default,,0,0,0,,Шиничи білсе, қызғаныш болар еді.
Dialogue: 0,0:52:26.56,0:52:27.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:52:29.18,0:52:30.43,Default,,0,0,0,,Ха…
Dialogue: 0,0:52:33.77,0:52:36.86,Default,,0,0,0,,Шиничиге ұқсайды...
Dialogue: 0,0:52:37.40,0:52:41.03,Default,,0,0,0,,Сіз дәл Холмс мырзаға ұқсайсыз!
Dialogue: 0,0:52:41.11,0:52:44.41,Default,,0,0,0,,Үнемі солай көрінесің, Ойға батып кетесің.
Dialogue: 0,0:52:45.32,0:52:48.62,Default,,0,0,0,,Не, сен Холмсқа еліктедің бе?
Dialogue: 0,0:52:48.70,0:52:52.08,Default,,0,0,0,,Олай болса, шай ішілгенше демалыңыз.
Dialogue: 0,0:52:52.16,0:52:54.08,Default,,0,0,0,,Рахмет
Dialogue: 0,0:52:55.75,0:52:59.05,Default,,0,0,0,,Эй, мына фото біреуге ұқсамай ма?
Dialogue: 0,0:52:59.13,0:53:02.51,Default,,0,0,0,,Ах! Менің шашым бар, бірақ бұл доктор Агаса!
Dialogue: 0,0:53:02.59,0:53:05.97,Default,,0,0,0,,Бұл Холмс пен доктор Уотсон.
Dialogue: 0,0:53:08.51,0:53:13.31,Default,,0,0,0,,Әкем мен дәрігер қолдарынан келгенше ойнап жатыр
Dialogue: 0,0:53:13.39,0:53:17.31,Default,,0,0,0,,Әй, сенде демалуға уақыт жоқ па?
Dialogue: 0,0:53:17.40,0:53:20.44,Default,,0,0,0,,Бірақ Моробоши-кун, мен не істеуім керек?
Dialogue: 0,0:53:20.53,0:53:22.90,Default,,0,0,0,,Мен бұл көзілдіріктің білетініне сенімдімін.
Dialogue: 0,0:53:22.99,0:53:24.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:53:24.40,0:53:25.82,Default,,0,0,0,,Өйткені бұл Холмс туралы.
Dialogue: 0,0:53:25.91,0:53:29.12,Default,,0,0,0,,Сіз Джек Риппер туралы материалдар жинауыңыз керек.
Dialogue: 0,0:53:29.20,0:53:31.70,Default,,0,0,0,,Қане, бәріміз бөлініп, іздейік.
Dialogue: 0,0:53:31.79,0:53:34.71,Default,,0,0,0,,Иә, онда мен осы жерден қозғаламын...
Dialogue: 0,0:53:35.83,0:53:39.59,Default,,0,0,0,,Бірақ барлық іздеулер ағылшын тілінде.
Dialogue: 0,0:53:39.67,0:53:41.30,Default,,0,0,0,,Ум...
Dialogue: 0,0:53:41.80,0:53:44.55,Default,,0,0,0,,«Қылмыс бойынша алғашқы тергеу»
Dialogue: 0,0:53:44.63,0:53:47.01,Default,,0,0,0,,Керемет! Мен гениймін бе?
Dialogue: 0,0:53:47.09,0:53:48.68,Default,,0,0,0,,Ағылшын тілін оқи алады
Dialogue: 0,0:53:48.76,0:53:49.60,Default,,0,0,0,,Мен де!
Dialogue: 0,0:53:49.68,0:53:50.85,Default,,0,0,0,,Ойыншы
Dialogue: 0,0:53:50.93,0:53:53.68,Default,,0,0,0,,Ағылшын тілін оқуға бағдарламаланған сияқты.
Dialogue: 0,0:53:53.77,0:53:58.31,Default,,0,0,0,,Тексеру... Сонда мен ойында мәңгі қала аламын.
Dialogue: 0,0:53:58.40,0:54:00.02,Default,,0,0,0,,Сен не айтып тұрсың, Гента-кун?
Dialogue: 0,0:54:00.11,0:54:01.48,Default,,0,0,0,,Егер бұл жалғаса берсе, біз солай боламыз
Dialogue: 0,0:54:01.57,0:54:03.65,Default,,0,0,0,,Ойын аяқталды, сен өлесің!
Dialogue: 0,0:54:03.74,0:54:06.57,Default,,0,0,0,,Джожо... Жай қалжың. Жай ойнам айттым.
Dialogue: 0,0:54:09.91,0:54:11.95,Default,,0,0,0,,Допты қарғыс атсын
Dialogue: 0,0:54:12.04,0:54:13.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:54:14.58,0:54:17.12,Default,,0,0,0,,Бұл... бұл...
Dialogue: 0,0:54:17.21,0:54:21.00,Default,,0,0,0,,Сәлем Эмори! Бұл 100 жыл бұрынғы футбол добы.
Dialogue: 0,0:54:21.09,0:54:22.59,Default,,0,0,0,,Уау, мінеки!
Dialogue: 0,0:54:22.67,0:54:23.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:25.01,0:54:27.05,Default,,0,0,0,,Міне болды. Бұл емес пе?
Dialogue: 0,0:54:27.13,0:54:28.26,Default,,0,0,0,,О!
Dialogue: 0,0:54:29.84,0:54:32.35,Default,,0,0,0,,«Рипер Джек туралы ойлар»
Dialogue: 0,0:54:33.22,0:54:35.98,Default,,0,0,0,,Ең соңғы оқиға...
Dialogue: 0,0:54:36.06,0:54:37.19,Default,,0,0,0,,8 қыркүйек
Dialogue: 0,0:54:38.02,0:54:40.52,Default,,0,0,0,,«Екінші құрбан Хони Чарлстон болды.»
Dialogue: 0,0:54:40.61,0:54:43.15,Default,,0,0,0,,«жалғыз тұратын 41 жастағы әйел»
Dialogue: 0,0:54:43.23,0:54:46.11,Default,,0,0,0,,«Мәйіт Уайтчепель аймағында табылды».
Dialogue: 0,0:54:46.19,0:54:48.61,Default,,0,0,0,,«Әулие Мария шіркеуінің жанындағы бос жер»
Dialogue: 0,0:54:48.70,0:54:53.20,Default,,0,0,0,,«Кісі өлтіру орнында қалдырылған заттар әртүрлі мөлшердегі екі сақина болды» ...
Dialogue: 0,0:54:53.28,0:54:55.45,Default,,0,0,0,,Әртүрлі өлшемдегі сақиналар?
Dialogue: 0,0:54:56.79,0:54:58.67,Default,,0,0,0,,«Лондонды қорқыныштың тереңіне батыру...»
Dialogue: 0,0:54:58.75,0:54:59.92,Default,,0,0,0,,«Рипер Джек»
Dialogue: 0,0:55:00.00,0:55:03.25,Default,,0,0,0,,«Бұрын-соңды болмаған әлеуметтік толқулар тудырғандықтан».
Dialogue: 0,0:55:03.34,0:55:07.05,Default,,0,0,0,,«Ол зұлымдықтың штаб-пәтері профессор Мориартимен байланысты».
Dialogue: 0,0:55:07.13,0:55:08.72,Default,,0,0,0,,«Мен сенімдімін»
Dialogue: 0,0:55:08.80,0:55:11.01,Default,,0,0,0,,Профессор Мориарти?
Dialogue: 0,0:55:11.09,0:55:13.56,Default,,0,0,0,,Ол ойында қанша уақыт шығады?
Dialogue: 0,0:55:13.64,0:55:15.56,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:55:15.64,0:55:17.93,Default,,0,0,0,,Өзіңізді ғана сендірмеңіз
Dialogue: 0,0:55:18.89,0:55:20.40,Default,,0,0,0,,Ол Холмстың жауы.
Dialogue: 0,0:55:21.31,0:55:23.90,Default,,0,0,0,,Лондонның жер асты әлемін бақылауға алыңыз
Dialogue: 0,0:55:23.98,0:55:28.03,Default,,0,0,0,,Оның бүкіл Еуропада зор ықпалы бар екені айтылады.
Dialogue: 0,0:55:28.11,0:55:30.36,Default,,0,0,0,,Қылмыстық әлемнің Наполеоны
Dialogue: 0,0:55:30.45,0:55:33.87,Default,,0,0,0,,Бірақ профессор Мориарти сахнаның артында жіптерді тартып жатыр.
Dialogue: 0,0:55:33.95,0:55:36.45,Default,,0,0,0,,Сирек көрінетін адам.
Dialogue: 0,0:55:36.54,0:55:38.20,Default,,0,0,0,,Ол жерге қалай жетуге болады...
Dialogue: 0,0:55:38.29,0:55:44.13,Default,,0,0,0,,Профессор келмесе, онымен байланысқан адамға хабарласыңыз.
Dialogue: 0,0:55:44.21,0:55:46.17,Default,,0,0,0,,Полковник Себастьян Моранға
Dialogue: 0,0:55:46.25,0:55:50.26,Default,,0,0,0,,Түсіндім! Профессордың жақын қол астындағы қызметкері полковник Моран...
Dialogue: 0,0:55:50.34,0:55:53.30,Default,,0,0,0,,А, бірақ полковник қайда...
Dialogue: 0,0:55:53.39,0:55:54.89,Default,,0,0,0,,Сонда, әрине...
Dialogue: 0,0:55:54.97,0:55:57.02,Default,,0,0,0,,Холмстың жазбалары бойынша
Dialogue: 0,0:55:57.10,0:56:00.64,Default,,0,0,0,,Полковниктің тірегі - қала орталығындағы Трамп клубы.
Dialogue: 0,0:56:00.73,0:56:05.23,Default,,0,0,0,,Ол Лондондағы ең қауіпті екінші адам, сондықтан онымен байланыста болған кезде абай болу керек.
Dialogue: 0,0:56:05.32,0:56:07.19,Default,,0,0,0,,Конан-кун, мен сені жақсы білемін.
Dialogue: 0,0:56:07.28,0:56:08.11,Default,,0,0,0,,А...
Dialogue: 0,0:56:08.19,0:56:12.07,Default,,0,0,0,,А, қарашы, Шиничи-нии-чан маған да жиі айтатын.
Dialogue: 0,0:56:12.16,0:56:14.74,Default,,0,0,0,,Не! Маған солай көрінеді.
Dialogue: 0,0:56:14.82,0:56:16.53,Default,,0,0,0,,Хе... Бірақ әлгі Холмсқа?
Dialogue: 0,0:56:16.62,0:56:20.41,Default,,0,0,0,,Оны тыңдауға мәжбүр болғаным бұл жолы маған қатты көмектесті.
Dialogue: 0,0:56:20.50,0:56:23.25,Default,,0,0,0,,«Табанды бол» қажет емес
Dialogue: 0,0:56:24.79,0:56:27.59,Default,,0,0,0,,Уау! Бұл нағыз мылтық!
Dialogue: 0,0:56:27.67,0:56:28.80,Default,,0,0,0,,Оны қайтар, Гента!
Dialogue: 0,0:56:28.88,0:56:32.76,Default,,0,0,0,,Сонымен... Бірақ, сіз қорқынышты жігітті кездестіресіз, солай ма?
Dialogue: 0,0:56:32.84,0:56:36.76,Default,,0,0,0,,Үйренбеген қару жарамсыз, жанжалдың көзі!
Dialogue: 0,0:56:36.85,0:56:37.76,Default,,0,0,0,,Оны қалдырыңыз!
Dialogue: 0,0:56:37.85,0:56:41.23,Default,,0,0,0,,А... о... сен қорқыныштысың.
Dialogue: 0,0:56:45.48,0:56:48.02,Default,,0,0,0,,Жүр, кеш болмай тұрып кетейік.
Dialogue: 0,0:56:54.78,0:56:55.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:01.70,0:57:02.96,Default,,0,0,0,,О... Әй, Моробоши!
Dialogue: 0,0:57:03.04,0:57:04.00,Default,,0,0,0,,Ш...
Dialogue: 0,0:57:04.08,0:57:08.13,Default,,0,0,0,,Сіз өзіңізді қорғауыңыз керек
Dialogue: 0,0:57:17.39,0:57:19.10,Default,,0,0,0,,тағы 30 адам?
Dialogue: 0,0:57:19.18,0:57:21.22,Default,,0,0,0,,Ол айтарлықтай төмендеді.
Dialogue: 0,0:57:21.31,0:57:25.02,Default,,0,0,0,,Кейбіреулеріміздің оқуды тастайтын кез келді.
Dialogue: 0,0:57:25.10,0:57:27.52,Default,,0,0,0,,Жаман сөз айтпа
Dialogue: 0,0:57:36.78,0:57:37.95,Default,,0,0,0,,Тоору!
Dialogue: 0,0:57:38.03,0:57:39.08,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:57:39.16,0:57:40.20,Default,,0,0,0,,Эми!
Dialogue: 0,0:57:40.29,0:57:42.45,Default,,0,0,0,,Такуя! Ахх...
Dialogue: 0,0:57:47.33,0:57:49.00,Default,,0,0,0,,Жарайды, бәрің осында күтіңдер.
Dialogue: 0,0:57:49.75,0:57:52.34,Default,,0,0,0,,Мен артқы есіктен ішінде не бар екенін тексеремін.
Dialogue: 0,0:57:52.42,0:57:53.42,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:57:53.51,0:57:54.42,Default,,0,0,0,,Иә
Dialogue: 0,0:57:58.97,0:58:05.44,Default,,0,0,0,,(Ерлердің сөйлесуі)
Dialogue: 0,0:58:13.61,0:58:15.53,Default,,0,0,0,,Бір бөлік.
Dialogue: 0,0:58:16.57,0:58:17.99,Default,,0,0,0,,Менде екі
Dialogue: 0,0:58:18.07,0:58:19.28,Default,,0,0,0,,Полковник Моран.
Dialogue: 0,0:58:21.03,0:58:23.04,Default,,0,0,0,,Иә? Сол маймыл...
Dialogue: 0,0:58:25.41,0:58:26.46,Default,,0,0,0,,Ш...
Dialogue: 0,0:58:29.46,0:58:30.63,Default,,0,0,0,,Сіз қалай ойлайсыз? көзілдірік
Dialogue: 0,0:58:30.71,0:58:31.79,Default,,0,0,0,,А...
Dialogue: 0,0:58:32.30,0:58:33.59,Default,,0,0,0,,Не... мұнда неге келдің?
Dialogue: 0,0:58:33.67,0:58:37.30,Default,,0,0,0,,Сіз барлық несиені алуға тырыссаңыз да, ол жұмыс істемейді.
Dialogue: 0,0:58:38.43,0:58:39.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:58:39.84,0:58:41.72,Default,,0,0,0,,Тікелей
Dialogue: 0,0:58:41.80,0:58:43.51,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:58:43.60,0:58:45.48,Default,,0,0,0,,Жарқыл
Dialogue: 0,0:58:45.56,0:58:46.39,Default,,0,0,0,,Не!
Dialogue: 0,0:58:46.48,0:58:48.69,Default,,0,0,0,,Бүгін түнде твиттер жазып жатқан сияқты
Dialogue: 0,0:58:48.77,0:58:49.69,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:58:49.77,0:58:51.23,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:58:51.31,0:58:54.03,Default,,0,0,0,,Моран жақсы покер ойыншысы...
Dialogue: 0,0:58:54.11,0:58:55.19,Default,,0,0,0,,Бұл алаяқтық
Dialogue: 0,0:58:55.28,0:58:57.74,Default,,0,0,0,,- (Моробоши) Не? -(Такизава) Түсінбедің бе?
Dialogue: 0,0:58:57.82,0:59:01.45,Default,,0,0,0,,Сол жақтағы маймыл полковник Моранға қарсыласының қимылдарын үйретіп жатыр.
Dialogue: 0,0:59:02.24,0:59:06.33,Default,,0,0,0,,Жүрек және күрек үшін оң қолыңызды пайдаланыңыз. Алмаздар мен беделер үшін сол қолыңызды пайдаланыңыз.
Dialogue: 0,0:59:06.41,0:59:10.42,Default,,0,0,0,,Олардың санына қарай сол түсті жемістерді жеуге жаттығады.
Dialogue: 0,0:59:10.50,0:59:14.88,Default,,0,0,0,,3 күрек үшін оң қолыңызбен 3 қара жидекті ұстаңыз.
Dialogue: 0,0:59:14.96,0:59:17.42,Default,,0,0,0,,Цк... бұл лас.
Dialogue: 0,0:59:17.51,0:59:18.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:18.42,0:59:20.80,Default,,0,0,0,,Бұл орындық дегенді қалай түсінесіңдер?
Dialogue: 0,0:59:20.89,0:59:22.43,Default,,0,0,0,,Неліктен бұл ...
Dialogue: 0,0:59:22.51,0:59:24.10,Default,,0,0,0,,- (Моробоши) Бұл алдау! -Ха...
Dialogue: 0,0:59:24.18,0:59:26.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:26.60,0:59:28.98,Default,,0,0,0,,Моран - алаяқ.
Dialogue: 0,0:59:30.31,0:59:34.48,Default,,0,0,0,,Балам, қалай сөйлегеніңе абай бол.
Dialogue: 0,0:59:34.57,0:59:37.07,Default,,0,0,0,,Сіз алдаудың дәлелі бар деп айтасыз ба?
Dialogue: 0,0:59:37.15,0:59:38.57,Default,,0,0,0,,Әрине
Dialogue: 0,0:59:38.65,0:59:41.78,Default,,0,0,0,,Сіз жақсы достарсыз ба? сол маймыл
Dialogue: 0,0:59:42.82,0:59:43.95,Default,,0,0,0,,Не!
Dialogue: 0,0:59:44.03,0:59:45.79,Default,,0,0,0,,Қарттың картасына қараңдар
Dialogue: 0,0:59:45.87,0:59:49.04,Default,,0,0,0,,3 күрек үшін оң қолыңызбен 3 қара жидекті жинаңыз.
Dialogue: 0,0:59:49.12,0:59:52.54,Default,,0,0,0,,Алмастың 5-і болса, мен сол қолыммен 5 қызыл жеміс жеген болар едім.
Dialogue: 0,0:59:52.63,0:59:54.59,Default,,0,0,0,,Моран Сен кірсің!
Dialogue: 0,0:59:54.67,0:59:57.59,Default,,0,0,0,,А-а... Ұсталғаныма мен кінәлімін.
Dialogue: 0,0:59:57.67,0:59:58.88,Default,,0,0,0,,Не!
Dialogue: 0,0:59:58.97,1:00:00.26,Default,,0,0,0,,- (Морохоши) Ой... - (2 адам) А?
Dialogue: 0,1:00:00.34,1:00:03.14,Default,,0,0,0,,Бұл мәселені кейінге қалдырайық.
Dialogue: 0,1:00:03.22,1:00:05.22,Default,,0,0,0,,Профессор Мориарти қайда?
Dialogue: 0,1:00:05.31,1:00:08.35,Default,,0,0,0,,Жоқ... балақай, ол кісінің аты қайда?
Dialogue: 0,1:00:08.43,1:00:09.43,Default,,0,0,0,,- (Такизава) Уау... - (Морохоши) Тоқта!
Dialogue: 0,1:00:09.52,1:00:10.77,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:00:10.85,1:00:12.40,Default,,0,0,0,,- (Морохоши) Ах... - (Бағыныңқы) Ху!
Dialogue: 0,1:00:12.48,1:00:14.27,Default,,0,0,0,,Жемқорларды ұстаңыз!
Dialogue: 0,1:00:14.36,1:00:16.11,Default,,0,0,0,,Қазіргі соққың мүлде уақытынан тыс, аянышты болды!
Dialogue: 0,1:00:16.90,1:00:17.98,Default,,0,0,0,,Уау!
Dialogue: 0,1:00:19.11,1:00:20.36,Default,,0,0,0,,Әй!
Dialogue: 0,1:00:20.45,1:00:21.74,Default,,0,0,0,,Неге?! Неге?!
Dialogue: 0,1:00:23.36,1:00:25.12,Default,,0,0,0,,Уау!
Dialogue: 0,1:00:25.20,1:00:26.16,Default,,0,0,0,,Эндевордың орнына ма?
Dialogue: 0,1:00:26.24,1:00:27.49,Default,,0,0,0,,Гуааа…
Dialogue: 0,1:00:27.58,1:00:28.95,Default,,0,0,0,,Амансың ба? Конан-кун
Dialogue: 0,1:00:29.04,1:00:30.12,Default,,0,0,0,,Иә
Dialogue: 0,1:00:30.20,1:00:32.42,Default,,0,0,0,,Бізге қосыл, Конан!
Dialogue: 0,1:00:32.50,1:00:33.33,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,1:00:33.42,1:00:34.38,Default,,0,0,0,,Бұл тек алдын алу тексерісі ғана
Dialogue: 0,1:00:35.50,1:00:37.05,Default,,0,0,0,,Хмф! Хаа!
Dialogue: 0,1:00:39.30,1:00:40.80,Default,,0,0,0,,Уф...
Dialogue: 0,1:00:41.34,1:00:42.55,Default,,0,0,0,,Жоғары көтеріл!
Dialogue: 0,1:00:42.63,1:00:45.76,Default,,0,0,0,,Эй, бұл жаман. Барлығы қатысуы керек!
Dialogue: 0,1:00:45.85,1:00:46.68,Default,,0,0,0,,Ах...
Dialogue: 0,1:00:46.76,1:00:48.06,Default,,0,0,0,,Қауіпті Конан-кун!
Dialogue: 0,1:00:48.14,1:00:49.35,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:00:50.10,1:00:50.98,Default,,0,0,0,,Әй!
Dialogue: 0,1:00:51.64,1:00:52.60,Default,,0,0,0,,Уф...
Dialogue: 0,1:00:52.69,1:00:54.44,Default,,0,0,0,,Кикукава мырза!
Dialogue: 0,1:00:54.52,1:00:56.73,Default,,0,0,0,,Ей, өзіңізді ұстаңыз!
Dialogue: 0,1:00:56.81,1:00:58.19,Default,,0,0,0,,Мен жеңілдім...
Dialogue: 0,1:00:58.27,1:01:00.44,Default,,0,0,0,,Осы арқылы мен сізге көмектескенім үшін қарызымды өтедім.
Dialogue: 0,1:01:00.53,1:01:01.86,Default,,0,0,0,,О... Эй!
Dialogue: 0,1:01:08.12,1:01:09.29,Default,,0,0,0,,Кикукава…
Dialogue: 0,1:01:14.75,1:01:16.79,Default,,0,0,0,,Сейичиро!
Dialogue: 0,1:01:16.88,1:01:17.96,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:01:18.04,1:01:18.88,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,1:01:18.96,1:01:20.17,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,1:01:21.51,1:01:23.84,Default,,0,0,0,,Аюми-чан! Жарайды?
Dialogue: 0,1:01:23.93,1:01:25.84,Default,,0,0,0,,Рахмет, Мицухико-кун!
Dialogue: 0,1:01:25.93,1:01:26.93,Default,,0,0,0,,Жоқ
Dialogue: 0,1:01:27.01,1:01:27.93,Default,,0,0,0,,Хмм!
Dialogue: 0,1:01:28.81,1:01:30.18,Default,,0,0,0,,Не!
Dialogue: 0,1:01:31.14,1:01:33.10,Default,,0,0,0,,Ах! Ми... Мицухико-кун!
Dialogue: 0,1:01:33.18,1:01:34.23,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:35.02,1:01:38.73,Default,,0,0,0,,Аюми-чан, біз үшін ойын біткен сияқты.
Dialogue: 0,1:01:39.44,1:01:43.32,Default,,0,0,0,,Конан-кун, бізді өмірге қайтаршы.
Dialogue: 0,1:01:43.40,1:01:45.24,Default,,0,0,0,,Аюми Мицухико!
Dialogue: 0,1:01:57.29,1:02:00.67,Default,,0,0,0,,Жоқ... Осылай жалғаса берсе, бәрі үшін ойын аяқталады.
Dialogue: 0,1:02:03.59,1:02:05.47,Default,,0,0,0,,С.Х.
Dialogue: 0,1:02:05.55,1:02:07.34,Default,,0,0,0,,Шерлок Холмс
Dialogue: 0,1:02:09.39,1:02:10.68,Default,,0,0,0,,Конан! Қауіп!
Dialogue: 0,1:02:10.76,1:02:11.60,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:02:11.68,1:02:13.43,Default,,0,0,0,,Ах!
Dialogue: 0,1:02:13.52,1:02:14.81,Default,,0,0,0,,Гента!
Dialogue: 0,1:02:15.56,1:02:16.85,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:17.81,1:02:20.61,Default,,0,0,0,,Тексеру... Ойын аяқталды ма?
Dialogue: 0,1:02:20.69,1:02:25.03,Default,,0,0,0,,Конан Джек Рипер Оны ұстаңыз.
Dialogue: 0,1:02:25.11,1:02:26.24,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:33.04,1:02:35.25,Default,,0,0,0,,Спектакль аяқталды
Dialogue: 0,1:02:35.33,1:02:39.08,Default,,0,0,0,,Мен оны ұстап алып, кімнің агенті екенін мойындатқым келді.
Dialogue: 0,1:02:39.17,1:02:41.50,Default,,0,0,0,,Бұл енді қажет емес сияқты
Dialogue: 0,1:02:41.59,1:02:44.13,Default,,0,0,0,,Бұл мылтық Холмсқа тиесілі.
Dialogue: 0,1:02:44.21,1:02:45.42,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,1:02:45.51,1:02:48.18,Default,,0,0,0,,Мен не істеуім керек? Мен не істеуім керек...
Dialogue: 0,1:02:48.26,1:02:49.09,Default,,0,0,0,,Иә?
Dialogue: 0,1:02:49.80,1:02:52.56,Default,,0,0,0,,Мен бұл адамда бар нәрсе екеніне сенімдімін ...
Dialogue: 0,1:02:52.64,1:02:55.02,Default,,0,0,0,,Сол орындықта қалған шарап
Dialogue: 0,1:02:55.10,1:02:57.98,Default,,0,0,0,,Түсіндім, міне, осыны білдіреді!
Dialogue: 0,1:02:58.06,1:03:00.69,Default,,0,0,0,,Енді кім бірінші?
Dialogue: 0,1:03:02.82,1:03:03.69,Default,,0,0,0,,Хмм...
Dialogue: 0,1:03:04.61,1:03:05.49,Default,,0,0,0,,Оларды колоданың басынан бастап ретімен оқып шығамын
Dialogue: 0,1:03:05.57,1:03:06.40,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:03:06.49,1:03:08.74,Default,,0,0,0,,Мені атсаң, шарап бұзылады.
Dialogue: 0,1:03:08.82,1:03:11.28,Default,,0,0,0,,Хмф! Бұл нені білдіреді?
Dialogue: 0,1:03:11.37,1:03:14.24,Default,,0,0,0,,Мен карта ойнаған үстелде бос орын бар.
Dialogue: 0,1:03:15.08,1:03:16.83,Default,,0,0,0,,Арнайы безендірілген орындықтар мен
Dialogue: 0,1:03:17.41,1:03:20.92,Default,,0,0,0,,Келген адамға дайындалған бокал мен шарап
Dialogue: 0,1:03:21.00,1:03:24.38,Default,,0,0,0,,Мұны кеңес ретінде пайдаланып, ол жерге кім келетінін болжаңыз ...
Dialogue: 0,1:03:24.46,1:03:28.09,Default,,0,0,0,,Бұл тек профессор Мориарти дегенді білдіреді.
Dialogue: 0,1:03:28.97,1:03:32.05,Default,,0,0,0,,Өкінішке орай, бұл пікір қате.
Dialogue: 0,1:03:32.14,1:03:33.85,Default,,0,0,0,,Олай болса, мен сені атуым керек пе?
Dialogue: 0,1:03:33.93,1:03:37.02,Default,,0,0,0,,Профессордың шарабы бұзылса қарсы болмасаңыз.
Dialogue: 0,1:03:37.10,1:03:40.48,Default,,0,0,0,,Қарғыс атсын... Боқ...
Dialogue: 0,1:03:44.86,1:03:46.48,Default,,0,0,0,,Конан-кун...
Dialogue: 0,1:03:53.57,1:03:54.91,Default,,0,0,0,,Хмм...
Dialogue: 0,1:03:54.99,1:03:56.95,Default,,0,0,0,,
Dialogue: 0,1:03:57.04,1:03:58.08,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:03.21,1:04:05.00,Default,,0,0,0,,Лорд Мориарти
Dialogue: 0,1:04:05.09,1:04:08.09,Default,,0,0,0,,Мен бәріңмен танысқым келеді.
Dialogue: 0,1:04:08.17,1:04:10.80,Default,,0,0,0,,Не? Профессор Мориарти?
Dialogue: 0,1:04:10.88,1:04:13.64,Default,,0,0,0,,Мен сені вагонда күтемін.
Dialogue: 0,1:04:13.72,1:04:14.97,Default,,0,0,0,,Мұнда басыңыз
Dialogue: 0,1:04:15.05,1:04:16.22,Default,,0,0,0,,О... күте тұрыңыз!
Dialogue: 0,1:04:16.31,1:04:17.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:18.93,1:04:22.52,Default,,0,0,0,,Лорд Мориартиге бағынбау ниетіңіз бар ма?
Dialogue: 0,1:04:23.15,1:04:24.48,Default,,0,0,0,,Ах...
Dialogue: 0,1:04:25.73,1:04:27.02,Default,,0,0,0,,Хмм...
Dialogue: 0,1:04:35.62,1:04:37.79,Default,,0,0,0,,Мен бәріңді алып келдім.
Dialogue: 0,1:04:37.87,1:04:39.29,Default,,0,0,0,,Стис ауданы арқылы өтіп бара жатып,
Dialogue: 0,1:04:39.37,1:04:42.37,Default,,0,0,0,,Енді, балам, анау шарапты ішейік.
Dialogue: 0,1:04:42.46,1:04:43.75,Default,,0,0,0,,Иә
Dialogue: 0,1:04:44.71,1:04:47.71,Default,,0,0,0,,Ха... бұл иіс...
Dialogue: 0,1:04:47.80,1:04:50.51,Default,,0,0,0,,Полковник Моранмен аяғына дейін бару керек пе?
Dialogue: 0,1:04:50.59,1:04:53.09,Default,,0,0,0,,Холмстың шәкірттерінен күткендей.
Dialogue: 0,1:04:53.18,1:04:55.93,Default,,0,0,0,,...Сонымен, оның маған пайдасы бар ма?
Dialogue: 0,1:04:56.01,1:04:59.02,Default,,0,0,0,,Эй, профессор Мориарти ағаң ба?
Dialogue: 0,1:04:59.64,1:05:00.98,Default,,0,0,0,,Шынында да
Dialogue: 0,1:05:01.06,1:05:02.64,Default,,0,0,0,,Бұрын… пышақ еді.
Dialogue: 0,1:05:02.73,1:05:05.44,Default,,0,0,0,,Бұл бізді сынап жатыр, солай емес пе?
Dialogue: 0,1:05:05.52,1:05:07.90,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:05:07.98,1:05:10.32,Default,,0,0,0,,Неліктен әрекет етуді тоқтатпайсыз?
Dialogue: 0,1:05:10.40,1:05:12.86,Default,,0,0,0,,Сіздің ағаңыз профессор Мориарти емес пе?
Dialogue: 0,1:05:12.95,1:05:15.74,Default,,0,0,0,,Не... нені айтып тұрсың? Конан-кун
Dialogue: 0,1:05:15.82,1:05:19.70,Default,,0,0,0,,Өйткені нағыз профессор Мориарти осында.
Dialogue: 0,1:05:21.70,1:05:23.21,Default,,0,0,0,,Не? Сол сияқты...
Dialogue: 0,1:05:23.29,1:05:24.37,Default,,0,0,0,,Мен қайықты тексеріп бітірдім.
Dialogue: 0,1:05:24.46,1:05:28.71,Default,,0,0,0,,Профессор барлық дауыстарды итермеледі, солай ма?
Dialogue: 0,1:05:28.79,1:05:31.55,Default,,0,0,0,,Хехехе...
Dialogue: 0,1:05:31.63,1:05:34.30,Default,,0,0,0,,Оның соншалықты айқын болғанына сене алар емеспін...
Dialogue: 0,1:05:34.38,1:05:35.93,Default,,0,0,0,,Сіз қайдан білдіңіз?
Dialogue: 0,1:05:36.01,1:05:40.47,Default,,0,0,0,,Дәл қазір полковник Моран қартқа: «Күте тұрыңыз», - деді.
Dialogue: 0,1:05:40.56,1:05:41.85,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:05:41.93,1:05:45.85,Default,,0,0,0,,Полковник Моран профессор Мориартимен тек құрметті сөздерді қолданады.
Dialogue: 0,1:05:45.94,1:05:47.44,Default,,0,0,0,,Ух... иә
Dialogue: 0,1:05:47.52,1:05:49.23,Default,,0,0,0,,Барлығы осы ма?
Dialogue: 0,1:05:49.32,1:05:50.48,Default,,0,0,0,,Тағы бір нәрсе
Dialogue: 0,1:05:50.57,1:05:53.99,Default,,0,0,0,,Профессор Мориарти табиғи шөптен жасалған одеколонды пайдаланады.
Dialogue: 0,1:05:54.07,1:05:56.41,Default,,0,0,0,,Сәнді қария деп естідім.
Dialogue: 0,1:05:56.49,1:06:01.04,Default,,0,0,0,,Иә~ Сонда мен саған шарап бергенде келді ме?
Dialogue: 0,1:06:01.12,1:06:02.75,Default,,0,0,0,,Керемет
Dialogue: 0,1:06:02.83,1:06:05.50,Default,,0,0,0,,Бұл шағын Холмсты көргендей.
Dialogue: 0,1:06:05.58,1:06:06.79,Default,,0,0,0,,Хэхе...
Dialogue: 0,1:06:07.54,1:06:10.84,Default,,0,0,0,,Айтпақшы, мен саған не керекпін?
Dialogue: 0,1:06:10.92,1:06:12.80,Default,,0,0,0,,Риппер Джек
Dialogue: 0,1:06:12.88,1:06:17.55,Default,,0,0,0,,Ол профессор Лондонды террор қаласына айналдыру үшін қалаға жіберген адам, солай ма?
Dialogue: 0,1:06:17.64,1:06:20.43,Default,,0,0,0,,Соқпасаң да, алыс емес.
Dialogue: 0,1:06:20.51,1:06:25.02,Default,,0,0,0,,Жек Риппер қараңғы жерде ұсталған қаңғыбас еді.
Dialogue: 0,1:06:25.60,1:06:29.98,Default,,0,0,0,,Анасы тастап, көшеде адасып кеткен қаңғыбас бала еді.
Dialogue: 0,1:06:30.06,1:06:32.94,Default,,0,0,0,,Мен талантты бір көргеннен-ақ сезіндім.
Dialogue: 0,1:06:33.03,1:06:35.99,Default,,0,0,0,,Қылмыстық дарындылық
Dialogue: 0,1:06:37.91,1:06:42.28,Default,,0,0,0,,Мен оны бірінші дәрежелі өлтіруші етіп өсірдім.
Dialogue: 0,1:06:42.37,1:06:46.25,Default,,0,0,0,,Неліктен біз жазықсыз әйелдерді өлтіреміз?
Dialogue: 0,1:06:46.33,1:06:47.83,Default,,0,0,0,,Риппер Джек
Dialogue: 0,1:06:47.92,1:06:51.71,Default,,0,0,0,,Сіз мен ойлағандай адам өлтіруші болдыңыз.
Dialogue: 0,1:06:51.79,1:06:55.38,Default,,0,0,0,,Оқиғалар тізбегі сол баланың абайсыз әрекеті.
Dialogue: 0,1:06:56.01,1:07:00.64,Default,,0,0,0,,Егер сіз Джек Рипперден құтылуға тырыссаңыз.
Dialogue: 0,1:07:00.72,1:07:03.10,Default,,0,0,0,,Біз де ынтымақтасайық.
Dialogue: 0,1:07:03.18,1:07:04.47,Default,,0,0,0,,- (Жүгіріп) А... - Ынтымақтастық па?
Dialogue: 0,1:07:05.10,1:07:08.60,Default,,0,0,0,,Риппер Джек, әрине, бақылаудан шыға бастады.
Dialogue: 0,1:07:08.69,1:07:13.07,Default,,0,0,0,,Мен саған өлтіру туралы бұйрық жіберсем, бәрібір бағынасың.
Dialogue: 0,1:07:13.15,1:07:15.94,Default,,0,0,0,,Балалар, бұл туралы белсенді болуың керек.
Dialogue: 0,1:07:16.03,1:07:17.57,Default,,0,0,0,,Бұл тек бұршақ мылтық, бірақ… Марли әскерінің қарсы шабуылының сигналы
Dialogue: 0,1:07:17.65,1:07:20.20,Default,,0,0,0,,Ертеңгі «Sunday Times» жарнамасында
Dialogue: 0,1:07:20.28,1:07:22.74,Default,,0,0,0,,Оған хабарлама жіберіңіз
Dialogue: 0,1:07:22.83,1:07:24.87,Default,,0,0,0,,Кімді өлтіруге бұйрық бересіз?
Dialogue: 0,1:07:24.95,1:07:27.41,Default,,0,0,0,,Ертеңгі газетке қарап білуге ​​болады.
Dialogue: 0,1:07:33.42,1:07:37.59,Default,,0,0,0,,Эй, сенбейсің бе? Бұл қарияның сөзі
Dialogue: 0,1:07:37.67,1:07:39.18,Default,,0,0,0,,- Бәс тігейік - (Морохоши) А...
Dialogue: 0,1:07:39.26,1:07:42.64,Default,,0,0,0,,Иа... сәттілік.
Dialogue: 0,1:07:42.72,1:07:46.35,Default,,0,0,0,,3 жылдан кейін Рейхенбах сарқырамасынан сақ болыңыз
Dialogue: 0,1:07:46.43,1:07:47.77,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:49.10,1:07:50.27,Default,,0,0,0,,Фу…
Dialogue: 0,1:08:03.24,1:08:05.49,Default,,0,0,0,,Рейхенбах дегеніміз не?
Dialogue: 0,1:08:05.58,1:08:06.62,Default,,0,0,0,,Профессор Мориарти
Dialogue: 0,1:08:06.70,1:08:09.54,Default,,0,0,0,,Үш жылдан кейін Швейцариядағы Рейхенбах атты сарқырамада.
Dialogue: 0,1:08:09.62,1:08:12.00,Default,,0,0,0,,Холмспен бетпе-бет келу
Dialogue: 0,1:08:12.08,1:08:14.59,Default,,0,0,0,,Екеуі сарқыраманың бассейніне түсті.
Dialogue: 0,1:08:14.67,1:08:17.96,Default,,0,0,0,,Холмс кейінірек керемет түрде аман қалады.
Dialogue: 0,1:08:18.05,1:08:20.93,Default,,0,0,0,,Менің ойымша, профессор Мориарти сонда қайтыс болды.
Dialogue: 0,1:08:21.01,1:08:24.76,Default,,0,0,0,,Мен саған неге сақ бол дедім деп ойлаймын.
Dialogue: 0,1:08:25.51,1:08:30.35,Default,,0,0,0,,Менің ойымша, мен Холмсты ұнататын сияқты, ол зұлым адамды жақсы көремін.
Dialogue: 0,1:08:30.43,1:08:31.52,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:33.60,1:08:35.77,Default,,0,0,0,,Қазір ойлап қарасам, сол кезде...
Dialogue: 0,1:08:37.53,1:08:39.82,Default,,0,0,0,,Маған Мориарти де қатты ұнайды.
Dialogue: 0,1:08:39.90,1:08:43.24,Default,,0,0,0,,Ал, романдағы кейіпкер ретінде.
Dialogue: 0,1:08:43.78,1:08:48.20,Default,,0,0,0,,Екеуі Холмстың пансионатында бетпе-бет келгенде, мен терлеп кеттім.
Dialogue: 0,1:08:48.29,1:08:50.04,Default,,0,0,0,,Мен Холмстың өлеңдерін сол кезде естідім.
Dialogue: 0,1:08:50.12,1:08:52.33,Default,,0,0,0,,Маған ұнайтын нәрсе бар
Dialogue: 0,1:08:52.41,1:08:54.00,Default,,0,0,0,,Оның не екенін білесің бе?
Dialogue: 0,1:08:54.08,1:08:55.21,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,1:08:55.29,1:08:57.00,Default,,0,0,0,,Бұл...
Dialogue: 0,1:09:04.09,1:09:06.68,Default,,0,0,0,,Шиничи не айтты?
Dialogue: 0,1:09:08.10,1:09:09.93,Default,,0,0,0,,Ерекше күн болса да
Dialogue: 0,1:09:10.02,1:09:15.15,Default,,0,0,0,,Шиничи үнемі Холмс туралы айтатын, сондықтан мен оған мән бермедім.
Dialogue: 0,1:09:16.81,1:09:18.27,Default,,0,0,0,,Сәлем Конан-кун
Dialogue: 0,1:09:18.36,1:09:19.19,Default,,0,0,0,,Не?
Dialogue: 0,1:09:19.28,1:09:22.32,Default,,0,0,0,,А, жоқ, бұл ештеңе емес.
Dialogue: 0,1:09:22.40,1:09:23.40,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:24.28,1:09:25.91,Default,,0,0,0,,Мен ақымақпын...
Dialogue: 0,1:09:25.99,1:09:28.70,Default,,0,0,0,,Конан-куннан сұрасаң да, оның түсінер жолы жоқ...
Dialogue: 0,1:09:29.29,1:09:31.16,Default,,0,0,0,,Эй... эй, көзілдірік
Dialogue: 0,1:09:31.25,1:09:32.58,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:32.66,1:09:34.21,Default,,0,0,0,,Ято-сама!
Dialogue: 0,1:09:34.71,1:09:38.54,Default,,0,0,0,,Біздің арқамыздан төртеуміз де ойынды аяқтадық.
Dialogue: 0,1:09:39.13,1:09:42.42,Default,,0,0,0,,Олай болса, болған оқиғаға өкінбей тұра алмайсың.
Dialogue: 0,1:09:42.51,1:09:44.93,Default,,0,0,0,,Сіз осылай ойлай бастасаңыз да
Dialogue: 0,1:09:45.01,1:09:46.89,Default,,0,0,0,,Бұл алға қадам емес пе?
Dialogue: 0,1:09:46.97,1:09:50.18,Default,,0,0,0,,Иә, қазірден бастап не істеуім керек?
Dialogue: 0,1:09:50.26,1:09:52.22,Default,,0,0,0,,Барлығымыз үшін барымызды салайық
Dialogue: 0,1:09:52.31,1:09:53.81,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,1:09:54.89,1:09:55.98,Default,,0,0,0,,Иә
Dialogue: 0,1:10:01.19,1:10:02.65,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,1:10:08.74,1:10:12.20,Default,,0,0,0,,Міне, екінші құрбан Хони Чарлстонның денесі.
Dialogue: 0,1:10:12.29,1:10:13.91,Default,,0,0,0,,Бұл табылған жер бе?
Dialogue: 0,1:10:20.21,1:10:21.30,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:31.60,1:10:33.77,Default,,0,0,0,,«Қазанның екінші сенбісінде»
Dialogue: 0,1:10:33.85,1:10:36.23,Default,,0,0,0,,«Ата-ана мен бала базарын өткіземіз»
Dialogue: 0,1:10:36.31,1:10:38.19,Default,,0,0,0,,Екінші сенбі?
Dialogue: 0,1:10:38.77,1:10:42.19,Default,,0,0,0,,Менің ойымша, Бал Чарльстон өлтірілді...
Dialogue: 0,1:10:43.98,1:10:46.65,Default,,0,0,0,,Сенбі, 8 қыркүйек!
Dialogue: 0,1:10:52.74,1:10:54.16,Default,,0,0,0,,Күткеніңізге рахмет!
Dialogue: 0,1:10:54.25,1:10:56.91,Default,,0,0,0,,Сіз кешіктіңіз. Сен қайда болдың?
Dialogue: 0,1:10:57.00,1:10:58.87,Default,,0,0,0,,Қаланы аралап көрейік...
Dialogue: 0,1:10:58.96,1:11:02.34,Default,,0,0,0,,Жекпе-жек күні болса да, алаңсызсың...
Dialogue: 0,1:11:02.42,1:11:05.05,Default,,0,0,0,,Джек Риппер тағы да осында!
Dialogue: 0,1:11:05.55,1:11:07.84,Default,,0,0,0,,Бұл жолы екі құрбан бар!
Dialogue: 0,1:11:07.93,1:11:09.05,Default,,0,0,0,,Бір данасын беріңізші!
Dialogue: 0,1:11:09.13,1:11:10.09,Default,,0,0,0,,Иә!
Dialogue: 0,1:11:10.80,1:11:13.60,Default,,0,0,0,,Жоқ! Менде британдық ақша жоқ
Dialogue: 0,1:11:13.68,1:11:14.97,Default,,0,0,0,,Хой 80 иен
Dialogue: 0,1:11:15.06,1:11:16.10,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:16.18,1:11:19.31,Default,,0,0,0,,А, бұл ыңғайлы.
Dialogue: 0,1:11:22.19,1:11:23.40,Default,,0,0,0,,Міне!
Dialogue: 0,1:11:23.48,1:11:27.24,Default,,0,0,0,,«Бүгін түнде опера театрының сахнасы тазартылды».
Dialogue: 0,1:11:27.32,1:11:28.86,Default,,0,0,0,,«М-ден J»
Dialogue: 0,1:11:28.95,1:11:30.82,Default,,0,0,0,,«М-ден J-ге»…
Dialogue: 0,1:11:30.91,1:11:33.53,Default,,0,0,0,,Мориартиден Джек Риперге дейін
Dialogue: 0,1:11:33.62,1:11:36.70,Default,,0,0,0,,Бұл сахнаны тазалау туралы бұйрық па?
Dialogue: 0,1:11:36.79,1:11:40.92,Default,,0,0,0,,Сахнаға шыққан әртістерді өлтіргің келсе...
Dialogue: 0,1:11:42.25,1:11:43.21,Default,,0,0,0,,Міне болды!
Dialogue: 0,1:11:43.29,1:11:44.67,Default,,0,0,0,,«Триумфальды қайтару қойылымы!»
Dialogue: 0,1:11:44.75,1:11:47.21,Default,,0,0,0,,«Варшава корольдік операсы Примадонна»
Dialogue: 0,1:11:47.30,1:11:48.67,Default,,0,0,0,,«Ирин Адлер»
Dialogue: 0,1:11:48.76,1:11:52.55,Default,,0,0,0,,Профессор Мориарти... Ол түкке тұрғысыз жауыз!
Dialogue: 0,1:11:52.64,1:11:55.93,Default,,0,0,0,,Сіз кімсіз? Айрин Адлер
Dialogue: 0,1:11:56.02,1:11:59.39,Default,,0,0,0,,Ол Холмстың сүйген жалғыз әйелі деп айтылады.
Dialogue: 0,1:12:00.10,1:12:04.86,Default,,0,0,0,,Ол кісі өлтіргені үшін Холмстың жақсы көретін әйелін нысанаға алды.
Dialogue: 0,1:12:13.70,1:12:15.41,Default,,0,0,0,,0:06...
Dialogue: 0,1:12:15.49,1:12:16.74,Default,,0,0,0,,Яғни...
Dialogue: 0,1:12:16.83,1:12:19.16,Default,,0,0,0,,Басқа кезеңдер жойылды ма?
Dialogue: 0,1:12:19.25,1:12:23.58,Default,,0,0,0,,Алтауымыздың өміріне қауіп төніп тұр.
Dialogue: 0,1:12:41.48,1:12:42.35,Default,,0,0,0,,Жолдан кет! Эй!
Dialogue: 0,1:12:42.44,1:12:45.94,Default,,0,0,0,,Осыдан кейін оған қатысы бар адамдардан басқа кез келген адамға кіруге тыйым салынады.
Dialogue: 0,1:12:46.02,1:12:47.57,Default,,0,0,0,,Мен... біз
Dialogue: 0,1:12:47.65,1:12:50.03,Default,,0,0,0,,Мен Айрин Адлердің танысымын.
Dialogue: 0,1:12:50.11,1:12:51.78,Default,,0,0,0,,Қойылым алдында мадақтау...
Dialogue: 0,1:12:51.86,1:12:54.53,Default,,0,0,0,,О, сен оны танисың ба?
Dialogue: 0,1:12:54.62,1:12:57.03,Default,,0,0,0,,Иә, күту залы қайда?
Dialogue: 0,1:12:57.12,1:13:00.66,Default,,0,0,0,,Бұл жағдайда артқы жағында плакат бар бөлме.
Dialogue: 0,1:13:02.12,1:13:03.33,Default,,0,0,0,,Мұнда
Dialogue: 0,1:13:03.42,1:13:06.17,Default,,0,0,0,,Ол қандай адам? Мен қатты толқып тұрмын
Dialogue: 0,1:13:06.71,1:13:09.00,Default,,0,0,0,,Әкем жасаған кейіпкер
Dialogue: 0,1:13:09.09,1:13:11.84,Default,,0,0,0,,Егер Холмс сүйген әйелімен келсе...
Dialogue: 0,1:13:13.51,1:13:14.72,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:13:15.68,1:13:17.30,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,1:13:21.68,1:13:23.44,Default,,0,0,0,,Шиничидің анасы!
Dialogue: 0,1:13:23.52,1:13:25.31,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,1:13:25.40,1:13:29.02,Default,,0,0,0,,Кешіріңіз, мен әлі бойдақпын.
Dialogue: 0,1:13:29.11,1:13:32.69,Default,,0,0,0,,Дәлірек айтсам, ажырасып, бойдақтыққа қайта оралдым.
Dialogue: 0,1:13:33.32,1:13:35.45,Default,,0,0,0,,Холмс мырзадан бір шоқ гүл.
Dialogue: 0,1:13:35.53,1:13:37.62,Default,,0,0,0,,Ал, рахмет
Dialogue: 0,1:13:37.70,1:13:39.54,Default,,0,0,0,,Сіз қайда барар едіңіз, мистер Холмс?
Dialogue: 0,1:13:39.62,1:13:42.37,Default,,0,0,0,,А, мен бүгінгі кешті асыға күттім.
Dialogue: 0,1:13:42.45,1:13:44.79,Default,,0,0,0,,Мен бір оқиға бойынша кетіп қалдым, келе алмаймын.
Dialogue: 0,1:13:44.87,1:13:47.38,Default,,0,0,0,,Иә... бұл ұят.
Dialogue: 0,1:13:47.46,1:13:49.29,Default,,0,0,0,,Бүгінгі түнгі қойылымнан бас тартуыңызды сұраймыз.
Dialogue: 0,1:13:49.38,1:13:50.21,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:50.30,1:13:52.92,Default,,0,0,0,,Холмс мырзаның жауы профессор Мориарти
Dialogue: 0,1:13:53.01,1:13:54.93,Default,,0,0,0,,Мен сізге өлтіруші жібердім.
Dialogue: 0,1:13:55.01,1:13:57.22,Default,,0,0,0,,Мені не үшін қалайсыз?
Dialogue: 0,1:13:57.30,1:13:58.80,Default,,0,0,0,,Мен сені жоғалтқанда
Dialogue: 0,1:13:58.89,1:14:01.18,Default,,0,0,0,,Өйткені мен мистер Холмстың қайғылы күйін көргім келеді.
Dialogue: 0,1:14:01.77,1:14:04.48,Default,,0,0,0,,Хехе... Мен де көргім келеді.
Dialogue: 0,1:14:04.56,1:14:08.11,Default,,0,0,0,,Мистер Холмс қаншалықты қайғылы болады?
Dialogue: 0,1:14:08.19,1:14:09.65,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,1:14:09.73,1:14:12.48,Default,,0,0,0,,Мен Джек Риппердің бесінші құрбаны болсам да.
Dialogue: 0,1:14:13.15,1:14:17.45,Default,,0,0,0,,Сіз мені қорғайсыз, солай ма? мистер Холмстың орнына
Dialogue: 0,1:14:17.53,1:14:18.91,Default,,0,0,0,,Ах...
Dialogue: 0,1:14:19.74,1:14:22.83,Default,,0,0,0,,Бұл әйелдің жүрегі күшті.
Dialogue: 0,1:14:22.91,1:14:26.67,Default,,0,0,0,,Дұрыс... бұл оның тұлғасы.
Dialogue: 0,1:14:26.75,1:14:32.75,Default,,0,0,0,,(Айриннің ән айту дауысы)
Dialogue: 0,1:14:49.61,1:14:51.69,Default,,0,0,0,,Хехехе...
Dialogue: 0,1:14:52.27,1:14:56.65,Default,,0,0,0,,Әдемі өл, Ирен Адлер
Dialogue: 0,1:14:56.74,1:14:59.11,Default,,0,0,0,,(Айриннің ән салған дауысы)
Dialogue: 0,1:14:59.70,1:15:02.12,Default,,0,0,0,,Ол қайда жасырынып жатыр?
Dialogue: 0,1:15:02.66,1:15:09.12,Default,,0,0,0,,(сағаттың секунд тілінің дыбысы)
Dialogue: 0,1:15:09.21,1:15:10.42,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:15:10.50,1:15:11.63,Default,,0,0,0,,Уау!
Dialogue: 0,1:15:11.71,1:15:12.79,Default,,0,0,0,,Не?
Dialogue: 0,1:15:12.88,1:15:13.96,Default,,0,0,0,,Оған не болды?
Dialogue: 0,1:15:14.05,1:15:16.01,Default,,0,0,0,,Бұл жалықтырады, кішкентай бүлікші.
Dialogue: 0,1:15:16.09,1:15:17.76,Default,,0,0,0,,Осы сатыға разы емессің бе?
Dialogue: 0,1:15:17.84,1:15:18.93,Default,,0,0,0,,Қауіпті!
Dialogue: 0,1:15:19.01,1:15:19.89,Default,,0,0,0,,Не салуды шештіңіз бе?
Dialogue: 0,1:15:21.72,1:15:23.64,Default,,0,0,0,,(шамның құлаған дыбысы)
Dialogue: 0,1:15:23.72,1:15:25.22,Default,,0,0,0,,- (Моробоши) Эмори! -(Жүгіріп) Такизава-кун!
Dialogue: 0,1:15:25.31,1:15:26.68,Default,,0,0,0,,Ой... иә...
Dialogue: 0,1:15:27.35,1:15:28.94,Default,,0,0,0,,Ах Эмори, сен...
Dialogue: 0,1:15:29.02,1:15:30.77,Default,,0,0,0,,Такизава-кун да...
Dialogue: 0,1:15:30.85,1:15:33.11,Default,,0,0,0,,Тексеру... Ойын аяқталды ма?
Dialogue: 0,1:15:33.19,1:15:34.65,Default,,0,0,0,,Бұл көңілсіз.
Dialogue: 0,1:15:35.40,1:15:38.53,Default,,0,0,0,,Рахмет, сен маған көмектестің.
Dialogue: 0,1:15:38.61,1:15:40.11,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:40.99,1:15:43.70,Default,,0,0,0,,Біреу маған бірінші рет алғыс айтып отыр.
Dialogue: 0,1:15:43.78,1:15:45.54,Default,,0,0,0,,Мен... жақсы.
Dialogue: 0,1:15:46.12,1:15:48.50,Default,,0,0,0,,Моробоши Мен қалғанын сұрадым.
Dialogue: 0,1:15:48.58,1:15:49.62,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,1:16:00.59,1:16:01.72,Default,,0,0,0,,Ах... Акира!
Dialogue: 0,1:16:01.80,1:16:03.05,Default,,0,0,0,,Шинья!
Dialogue: 0,1:16:03.14,1:16:04.35,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:04.43,1:16:08.93,Default,,0,0,0,,Енді бар болғаны 4 адам қалды, оның ішінде Ран мен Конан бар.
Dialogue: 0,1:16:12.48,1:16:14.36,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:16:14.44,1:16:16.32,Default,,0,0,0,,Бұл жалықтырады, кішкентай бүлікші.
Dialogue: 0,1:16:19.36,1:16:20.36,Default,,0,0,0,,Бұл жалықтырады, кішкентай бүлікші.
Dialogue: 0,1:16:20.45,1:16:21.74,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:16:21.82,1:16:24.49,Default,,0,0,0,,Жақсы, Джек Риппер
Dialogue: 0,1:16:24.57,1:16:27.41,Default,,0,0,0,,Бұл дүниені тозаққа айналдыр!
Dialogue: 0,1:16:27.49,1:16:30.66,Default,,0,0,0,,Хахахаха!
Dialogue: 0,1:16:32.12,1:16:33.96,Default,,0,0,0,,Асығыңыз! Артқы есікке асығыңыз!
Dialogue: 0,1:16:34.79,1:16:36.30,Default,,0,0,0,,Тезірек, Хайбара, ана жақта!
Dialogue: 0,1:16:36.38,1:16:38.09,Default,,0,0,0,,Қауіпті!
Dialogue: 0,1:16:38.17,1:16:39.26,Default,,0,0,0,,Ғибадатхана қыз-қызметшісінің киімі оған жарасады.
Dialogue: 0,1:16:39.34,1:16:40.47,Default,,0,0,0,,(Мүсіннің құлаған дыбысы)
Dialogue: 0,1:16:40.55,1:16:41.55,Default,,0,0,0,,Уф...
Dialogue: 0,1:16:42.47,1:16:43.51,Default,,0,0,0,,Уф!
Dialogue: 0,1:16:44.85,1:16:46.43,Default,,0,0,0,,Хайбара Жақсысың ба?
Dialogue: 0,1:16:46.51,1:16:47.47,Default,,0,0,0,,Уф...
Dialogue: 0,1:16:47.56,1:16:50.98,Default,,0,0,0,,Жоқ, Кудо-кун, бас тарт.
Dialogue: 0,1:16:51.06,1:16:52.81,Default,,0,0,0,,Көмекші белгі болмаса
Dialogue: 0,1:16:52.89,1:16:55.90,Default,,0,0,0,,Холмс біз үшін сенсің...
Dialogue: 0,1:16:56.52,1:16:58.86,Default,,0,0,0,,Сізде сонша күш бар.
Dialogue: 0,1:16:59.48,1:17:02.57,Default,,0,0,0,,Холмс шеше алмайтын жағдай жоқ, солай ма?
Dialogue: 0,1:17:15.25,1:17:16.46,Default,,0,0,0,,Ай-кун…
Dialogue: 0,1:17:18.13,1:17:20.84,Default,,0,0,0,,Асығыңыз, асығыңыз! Эвакуацияланамын!
Dialogue: 0,1:17:23.38,1:17:24.64,Default,,0,0,0,,О...
Dialogue: 0,1:17:24.72,1:17:25.55,Default,,0,0,0,,Артқа!
Dialogue: 0,1:17:25.64,1:17:27.05,Default,,0,0,0,,
Dialogue: 0,1:17:27.14,1:17:28.06,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,1:17:28.89,1:17:29.93,Default,,0,0,0,,Ха…
Dialogue: 0,1:17:32.27,1:17:33.69,Default,,0,0,0,,Чи…
Dialogue: 0,1:17:36.27,1:17:37.44,Default,,0,0,0,,- (Жүгіріп) Күте тұрыңыз! -Онда кездескенше
Dialogue: 0,1:17:37.52,1:17:39.44,Default,,0,0,0,,Полициямен бірге болғаныңызша, қауіпсіз боласыз!
Dialogue: 0,1:17:39.52,1:17:42.65,Default,,0,0,0,,А, балам, мен сенің атыңды әлі естіген жоқпын.
Dialogue: 0,1:17:42.74,1:17:44.78,Default,,0,0,0,,Мен Конан Эдогавамын
Dialogue: 0,1:17:44.86,1:17:47.24,Default,,0,0,0,,Сіздің туған ата-анаңыздың аты-жөніңіз
Dialogue: 0,1:17:47.32,1:17:49.08,Default,,0,0,0,,Конан?
Dialogue: 0,1:17:50.70,1:17:52.58,Default,,0,0,0,,
Dialogue: 0,1:17:55.46,1:17:57.88,Default,,0,0,0,,Маған ешқашан қашып кетуге жол берме!
Dialogue: 0,1:17:59.96,1:18:00.92,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:18:01.00,1:18:04.38,Default,,0,0,0,,Конан жігіттері Риппер Джекпен кездесті
Dialogue: 0,1:18:04.47,1:18:06.34,Default,,0,0,0,,Қазір қуыңыз
Dialogue: 0,1:18:07.43,1:18:09.30,Default,,0,0,0,,...
Dialogue: 0,1:18:14.10,1:18:18.02,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,1:18:27.86,1:18:29.32,Default,,0,0,0,,Конан-кун, алдымен мін!
Dialogue: 0,1:18:29.41,1:18:30.74,Default,,0,0,0,,Хмм...
Dialogue: 0,1:18:34.37,1:18:37.08,Default,,0,0,0,,Бұл ең нашар даму.
Dialogue: 0,1:18:37.17,1:18:38.63,Default,,0,0,0,,Сізде не бар?
Dialogue: 0,1:18:39.29,1:18:42.80,Default,,0,0,0,,Charing Cross станциясынан кететін соңғы пойыз…
Dialogue: 0,1:18:42.88,1:18:45.38,Default,,0,0,0,,Бұл өте қауіпті шарықтау шегі.
Dialogue: 0,1:19:01.15,1:19:02.11,Default,,0,0,0,,Не!
Dialogue: 0,1:19:02.19,1:19:06.03,Default,,0,0,0,,Джек Риппер жолаушылар арасында жасырынып жүр ме?
Dialogue: 0,1:19:06.11,1:19:08.82,Default,,0,0,0,,Жолаушыларды бір көлікке жинау
Dialogue: 0,1:19:08.91,1:19:10.49,Default,,0,0,0,,Мен... түсінемін.
Dialogue: 0,1:19:18.75,1:19:20.75,Default,,0,0,0,,Дирижер, сіз білесіз...
Dialogue: 0,1:19:22.42,1:19:25.34,Default,,0,0,0,,Енді бәріміз қолдарыңызды көтеріңіздер.
Dialogue: 0,1:19:25.42,1:19:28.93,Default,,0,0,0,,Мен сенде қару бар-жоғын тексеремін.
Dialogue: 0,1:19:35.81,1:19:40.19,Default,,0,0,0,,Сіздің пікіріңізді мұқият тыңдауға рұқсат етіңіз.
Dialogue: 0,1:19:40.27,1:19:41.90,Default,,0,0,0,,Енді
Dialogue: 0,1:19:41.98,1:19:45.65,Default,,0,0,0,,Мен Холмс мырзаның материалдарында не жазылғанын түсіндіремін.
Dialogue: 0,1:19:45.73,1:19:48.57,Default,,0,0,0,,Бұл жерде Риппер Джек жасырылған
Dialogue: 0,1:19:48.65,1:19:51.07,Default,,0,0,0,,Екінші құрбан Хони Чарлстон
Dialogue: 0,1:19:51.16,1:19:53.62,Default,,0,0,0,,Олар Виндзор деген қалада үйленді.
Dialogue: 0,1:19:53.70,1:19:55.41,Default,,0,0,0,,Арманы көп әйел.
Dialogue: 0,1:19:55.49,1:19:59.00,Default,,0,0,0,,Осыдан он жыл бұрын мен күйеуім мен ұлымды тастап, Лондонға көшіп кеттім.
Dialogue: 0,1:20:00.08,1:20:01.42,Default,,0,0,0,,Бұл екі сақина
Dialogue: 0,1:20:01.50,1:20:04.00,Default,,0,0,0,,Бал Чарльстонды өлтірген жерде қалдырылған заттар.
Dialogue: 0,1:20:04.71,1:20:06.17,Default,,0,0,0,,Біреуі – Балдың
Dialogue: 0,1:20:06.25,1:20:07.67,Default,,0,0,0,,Екіншісінің дизайны бірдей.
Dialogue: 0,1:20:07.76,1:20:10.47,Default,,0,0,0,,Бұл Балдың саусақтарының ешқайсысына сыймады.
Dialogue: 0,1:20:11.34,1:20:14.85,Default,,0,0,0,,Оны мистер Холмс осылай шығарады.
Dialogue: 0,1:20:14.93,1:20:16.31,Default,,0,0,0,,Бұл екі сақина
Dialogue: 0,1:20:16.39,1:20:19.31,Default,,0,0,0,,Құрбандар Бал Чарльстон мен Джек Риппер
Dialogue: 0,1:20:19.39,1:20:21.98,Default,,0,0,0,,Менің ойымша, бұл ата-ана мен бала арасындағы байланысты білдіреді.
Dialogue: 0,1:20:22.06,1:20:24.02,Default,,0,0,0,,Міне, кішкентай сақина.
Dialogue: 0,1:20:24.11,1:20:26.11,Default,,0,0,0,,Бұл Джек Риппердің шығармасы ма?
Dialogue: 0,1:20:26.19,1:20:27.32,Default,,0,0,0,,Иә
Dialogue: 0,1:20:27.40,1:20:31.20,Default,,0,0,0,,Бал ұлының саусағына дәл осындай ою-өрнекті сақина тағып, үйден шығып кетті.
Dialogue: 0,1:20:31.82,1:20:35.66,Default,,0,0,0,,Сонымен, Джек Риппер өз анасын өлтірді ме?
Dialogue: 0,1:20:35.74,1:20:38.50,Default,,0,0,0,,Мм... иә, деректер бойынша.
Dialogue: 0,1:20:38.58,1:20:41.79,Default,,0,0,0,,8 қыркүйек, Бал Чарльстон өлтірілген күн.
Dialogue: 0,1:20:41.87,1:20:45.71,Default,,0,0,0,,Осы екінші сенбіде Уайтчапель ауданындағы шіркеуде.
Dialogue: 0,1:20:45.79,1:20:49.09,Default,,0,0,0,,Айына бір рет ата-анасы мен балалары жасаған бұйымдарын әкелетін базар болады.
Dialogue: 0,1:20:49.17,1:20:51.13,Default,,0,0,0,,Бұл өткізілетін күн болды.
Dialogue: 0,1:20:51.22,1:20:54.39,Default,,0,0,0,,Менің ойымша, Джек Риппер де мұны білген.
Dialogue: 0,1:20:54.47,1:20:57.76,Default,,0,0,0,,Ху~ Онда солай жазылған.
Dialogue: 0,1:20:57.85,1:21:00.52,Default,,0,0,0,,Сонымен, Джек Риппер
Dialogue: 0,1:21:00.60,1:21:04.40,Default,,0,0,0,,Мен анаммен бірге базарға барғым келді.
Dialogue: 0,1:21:04.48,1:21:06.77,Default,,0,0,0,,Сіз екі сақина қалдырдым дейсіз бе?
Dialogue: 0,1:21:06.86,1:21:08.73,Default,,0,0,0,,Иә, оның мағынасы осы.
Dialogue: 0,1:21:09.40,1:21:14.45,Default,,0,0,0,,Сосын кісі өлтіру себебі оны тастап кеткен анаға деген реніш болды...
Dialogue: 0,1:21:15.70,1:21:18.54,Default,,0,0,0,,...Мен не істедім?
Dialogue: 0,1:21:18.62,1:21:20.37,Default,,0,0,0,,Барлығы тоқтап қалса екен!
Dialogue: 0,1:21:22.41,1:21:27.54,Default,,0,0,0,,Бірақ бұл махаббат пен өлтіру ниеті...
Dialogue: 0,1:21:29.88,1:21:31.67,Default,,0,0,0,,Бұл өкінішті.
Dialogue: 0,1:21:32.34,1:21:35.93,Default,,0,0,0,,Бірінші құрбан ретінде туысы жоқ әйелді кім таңдады?
Dialogue: 0,1:21:36.01,1:21:38.60,Default,,0,0,0,,Полиция қызметкерлерін алдау деп айтылды.
Dialogue: 0,1:21:38.68,1:21:41.73,Default,,0,0,0,,Бірақ үшінші немесе төртінші жәбірленуші...
Dialogue: 0,1:21:41.81,1:21:44.81,Default,,0,0,0,,Профессор Мориартидің дарынды білімі
Dialogue: 0,1:21:44.89,1:21:48.69,Default,,0,0,0,,Ол Джек Рипперді әдеттен тыс мінезі бар қылмыскер етіп өсірді.
Dialogue: 0,1:21:49.27,1:21:51.48,Default,,0,0,0,,Анама деген өшімді тазартсам да
Dialogue: 0,1:21:51.57,1:21:55.99,Default,,0,0,0,,Шешесі сияқты әйелдерге бірінен соң бірі қол көтере бастады.
Dialogue: 0,1:21:56.82,1:21:58.78,Default,,0,0,0,,Сонда бұл кім?
Dialogue: 0,1:21:58.87,1:22:00.24,Default,,0,0,0,,Бала кезінен
Dialogue: 0,1:22:00.33,1:22:03.71,Default,,0,0,0,,Бір өлшемді сақинаны тағып жүрсеңіз
Dialogue: 0,1:22:03.79,1:22:06.21,Default,,0,0,0,,Сол саусақпен не болады деп ойлайсыңдар?
Dialogue: 0,1:22:06.83,1:22:11.17,Default,,0,0,0,,10 саусақтың ішінен жіңішкесі сол ғана шығар.
Dialogue: 0,1:22:11.25,1:22:14.55,Default,,0,0,0,,
Dialogue: 0,1:22:14.63,1:22:17.14,Default,,0,0,0,,Риппер Джек - сенсің!
Dialogue: 0,1:22:17.22,1:22:18.09,Default,,0,0,0,,Не!
Dialogue: 0,1:22:20.14,1:22:22.52,Default,,0,0,0,,- (Моробоши) Не... - (Жүгіріп) Ол кісі әйел ғой!
Dialogue: 0,1:22:25.56,1:22:28.31,Default,,0,0,0,,Ха... Оң қолымдағы сақина саусағым өте жұқа!
Dialogue: 0,1:22:28.40,1:22:30.61,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:35.03,1:22:36.49,Default,,0,0,0,,(Гран Торино) «Барлығын Бірге» бүкіл денеме тараған күй
Dialogue: 0,1:22:36.57,1:22:37.41,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,1:22:37.49,1:22:38.70,Default,,0,0,0,,Жоқ, Ран-ничан!
Dialogue: 0,1:22:38.78,1:22:39.99,Default,,0,0,0,,(Түтін бомбасының жарылған дыбысы)
Dialogue: 0,1:22:40.08,1:22:41.03,Default,,0,0,0,,Уф...
Dialogue: 0,1:22:41.12,1:22:42.54,Default,,0,0,0,,Қарғыс атсын, түтін экраны!
Dialogue: 0,1:22:42.62,1:22:43.45,Default,,0,0,0,,Терезені ашыңыз!
Dialogue: 0,1:22:43.54,1:22:44.75,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:44.83,1:22:45.91,Default,,0,0,0,,Уф...
Dialogue: 0,1:22:50.92,1:22:52.42,Default,,0,0,0,,Хаха...
Dialogue: 0,1:22:52.50,1:22:53.92,Default,,0,0,0,,(Энн) Хахаха (Жан) Иә!
Dialogue: 0,1:22:54.01,1:22:55.51,Default,,0,0,0,,- (Моробоши) Әй... Әй! - А?
Dialogue: 0,1:22:57.55,1:23:00.39,Default,,0,0,0,,Барлық жолаушылар кетті...
Dialogue: 0,1:23:00.47,1:23:01.93,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:23:05.98,1:23:07.48,Default,,0,0,0,,Қазір...
Dialogue: 0,1:23:07.56,1:23:11.48,Default,,0,0,0,,Қашымұраны кім өлтіргенін де анықтайық.
Dialogue: 0,1:23:11.56,1:23:14.44,Default,,0,0,0,,Не? Сіз қылмыскерді анықтадыңыз ба?
Dialogue: 0,1:23:14.53,1:23:18.86,Default,,0,0,0,,Қылмыскер кісі өлтіру қаруын қалай дайындады деген сұрақ туындайды?
Dialogue: 0,1:23:19.74,1:23:21.70,Default,,0,0,0,,Осы Бейка мэриясының кіреберісінде
Dialogue: 0,1:23:21.78,1:23:24.33,Default,,0,0,0,,Металл детекторлары орнатылған.
Dialogue: 0,1:23:25.29,1:23:30.25,Default,,0,0,0,,Кісі өлтіру қаруы басынан осы жерде дайындалған болуы мүмкін.
Dialogue: 0,1:23:30.33,1:23:31.92,Default,,0,0,0,,Бұл сіз оны пайдаланғаныңызды білдіреді.
Dialogue: 0,1:23:32.00,1:23:34.88,Default,,0,0,0,,Бірақ мұндай нәрсе қайда ...
Dialogue: 0,1:23:34.96,1:23:38.51,Default,,0,0,0,,Бұл кеш өтетін жердегі қола мүсін.
Dialogue: 0,1:23:38.59,1:23:41.34,Default,,0,0,0,,Бірінің қолында қанжар.
Dialogue: 0,1:23:41.43,1:23:43.18,Default,,0,0,0,,Ха…
Dialogue: 0,1:23:43.26,1:23:46.43,Default,,0,0,0,,Өткізілетін жерде адамдар көп болды.
Dialogue: 0,1:23:46.52,1:23:49.06,Default,,0,0,0,,Осындай нәрсені жұлып алсаң, біреу көреді.
Dialogue: 0,1:23:49.14,1:23:52.48,Default,,0,0,0,,Жарық сөнген кезде мен оны электр желісінен ажыраттым.
Dialogue: 0,1:23:52.56,1:23:56.03,Default,,0,0,0,,Сабақ кестесі алдын ала шешілді.
Dialogue: 0,1:23:56.11,1:24:00.61,Default,,0,0,0,,Бірақ қанжар жоқ болса, біреу байқамай ма?
Dialogue: 0,1:24:00.70,1:24:03.12,Default,,0,0,0,,Мен фейк қалдырдым
Dialogue: 0,1:24:03.20,1:24:06.83,Default,,0,0,0,,Алюминий фольгаға немесе басқа нәрсеге оралған картоннан жасалған қанжар.
Dialogue: 0,1:24:06.91,1:24:09.79,Default,,0,0,0,,Сонымен қола мүсіннің қазір несі бар?
Dialogue: 0,1:24:09.87,1:24:12.04,Default,,0,0,0,,Бұл қылмыста қолданылған қанжар болды ма?
Dialogue: 0,1:24:12.13,1:24:13.17,Default,,0,0,0,,Иә
Dialogue: 0,1:24:13.25,1:24:18.13,Default,,0,0,0,,Мен жаңа ғана қанжардың люминол реакциясын және саусақ іздерін тексердім.
Dialogue: 0,1:24:18.21,1:24:21.84,Default,,0,0,0,,Менде Кашимураның қан тобының реакциясы болды.
Dialogue: 0,1:24:22.47,1:24:25.81,Default,,0,0,0,,Саусақ іздері де тұтқада анықталды.
Dialogue: 0,1:24:26.60,1:24:30.27,Default,,0,0,0,,Бұл сіздің саусақ ізіңіз болды, президент Шиндлер.
Dialogue: 0,1:24:30.35,1:24:31.35,Default,,0,0,0,,Не!
Dialogue: 0,1:24:31.44,1:24:33.44,Default,,0,0,0,,Әрине
Dialogue: 0,1:24:33.52,1:24:36.82,Default,,0,0,0,,Бұл менің үйімнен алынған қола мүсін.
Dialogue: 0,1:24:36.90,1:24:39.44,Default,,0,0,0,,Бұл қылмыс жасалған уақыт шамасында.
Dialogue: 0,1:24:39.53,1:24:43.03,Default,,0,0,0,,Бұл кеш өтетін жердегі бақылау камерасына түсірілген бейнелер.
Dialogue: 0,1:24:43.11,1:24:45.12,Default,,0,0,0,,Бақытымызға орай, бақылау камералары
Dialogue: 0,1:24:45.20,1:24:47.87,Default,,0,0,0,,Барлық жерде орнатылған.
Dialogue: 0,1:24:47.95,1:24:50.75,Default,,0,0,0,,Сіз өзіңізге ұнайтын кез келген бұрышты дубляж жасай аласыз
Dialogue: 0,1:24:51.79,1:24:53.67,Default,,0,0,0,,Бала Моробоши тепкен доп болды
Dialogue: 0,1:24:53.75,1:24:57.38,Default,,0,0,0,,Қола мүсінді ұрып, қанжарды түсіру.
Dialogue: 0,1:24:57.46,1:25:02.30,Default,,0,0,0,,Оны көтеріп, қола мүсіннің қолына қайта қойды.
Dialogue: 0,1:25:02.38,1:25:03.76,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,1:25:03.84,1:25:08.77,Default,,0,0,0,,Жаңа ғана көрген қанжар шын болса, баланың саусақ іздері де анықталуы керек.
Dialogue: 0,1:25:08.85,1:25:12.94,Default,,0,0,0,,Бірақ қанжардағы жалғыз нәрсе - президент Шиндлердің саусақ іздері болды.
Dialogue: 0,1:25:13.02,1:25:14.15,Default,,0,0,0,,Хмм…
Dialogue: 0,1:25:14.23,1:25:18.90,Default,,0,0,0,,Мен оның артынан балаға қолымды тигіздім, сондықтан оның саусақ іздері жоғалып кетті.
Dialogue: 0,1:25:18.98,1:25:21.69,Default,,0,0,0,,Кудо мырза! Мен таптым!
Dialogue: 0,1:25:22.28,1:25:26.12,Default,,0,0,0,,Картон мен алюминийден жасалған жасанды қанжар жер асты қоқыс үйіндісінен табылды
Dialogue: 0,1:25:26.20,1:25:27.16,Default,,0,0,0,,Саусақ іздері туралы не деуге болады?
Dialogue: 0,1:25:27.74,1:25:29.87,Default,,0,0,0,,Кудо мырза айтқандай
Dialogue: 0,1:25:29.95,1:25:33.87,Default,,0,0,0,,Екі саусақ ізі болды: жас Моробоши және президент Шиндлер.
Dialogue: 0,1:25:33.96,1:25:35.17,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:36.00,1:25:39.63,Default,,0,0,0,,Егер жасанды қанжарда баланың емес, басқа біреудің саусақ іздері болса ше?
Dialogue: 0,1:25:39.71,1:25:42.63,Default,,0,0,0,,Мен кінәліден басқа ешкімді ойламаймын.
Dialogue: 0,1:25:42.72,1:25:47.18,Default,,0,0,0,,Бұл өтірік! Мен жапон үкіметіне наразылық білдіремін.
Dialogue: 0,1:25:47.26,1:25:50.89,Default,,0,0,0,,Біріншіден, менде Кашимураны өлтіруге ешқандай себеп жоқ.
Dialogue: 0,1:25:54.64,1:25:57.81,Default,,0,0,0,,Жоқ... жалғыз орын машина бөлмесі.
Dialogue: 0,1:25:57.90,1:25:58.98,Default,,0,0,0,,Хмм...
Dialogue: 0,1:26:03.03,1:26:04.28,Default,,0,0,0,,Ха…
Dialogue: 0,1:26:04.36,1:26:06.24,Default,,0,0,0,,Жүргізуші жоқ!
Dialogue: 0,1:26:06.32,1:26:07.99,Default,,0,0,0,,Пойызды тоқтатыңыз!
Dialogue: 0,1:26:08.07,1:26:09.03,Default,,0,0,0,,О
Dialogue: 0,1:26:09.12,1:26:10.37,Default,,0,0,0,,Хмм...
Dialogue: 0,1:26:10.45,1:26:13.12,Default,,0,0,0,,А, тежегіштер бұзылды!
Dialogue: 0,1:26:14.16,1:26:15.00,Default,,0,0,0,,Ха…
Dialogue: 0,1:26:22.46,1:26:24.09,Default,,0,0,0,,Ол барған сайын жылдам болып келеді
Dialogue: 0,1:26:24.17,1:26:27.51,Default,,0,0,0,,Әй, анау апаны таппасақ, одан сайын нашарлап кетпей ме?
Dialogue: 0,1:26:27.59,1:26:30.89,Default,,0,0,0,,Жүгіріп... ол қайда? Қайда бардың?
Dialogue: 0,1:26:30.97,1:26:32.14,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,1:26:32.22,1:26:33.89,Default,,0,0,0,,Хмм...
Dialogue: 0,1:26:33.98,1:26:35.18,Default,,0,0,0,,(Цубаки мен Ватару) Оның мойын арты! Қандай аппақ тері! (Медбике) Есікті алдымен қағып ал!
Dialogue: 0,1:26:40.11,1:26:41.11,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:43.15,1:26:45.03,Default,,0,0,0,,Ран-ничан!
Dialogue: 0,1:26:45.11,1:26:46.86,Default,,0,0,0,,Жоқ! Кәне!
Dialogue: 0,1:26:48.91,1:26:52.29,Default,,0,0,0,,Мені мына жас ханыммен арқан байладым.
Dialogue: 0,1:26:52.37,1:26:55.58,Default,,0,0,0,,Мен құласам, ол менімен бірге құлайды.
Dialogue: 0,1:26:56.25,1:26:58.46,Default,,0,0,0,,Енді қалай күресеміз?
Dialogue: 0,1:26:58.54,1:27:00.04,Default,,0,0,0,,Қияметсіз...
Dialogue: 0,1:27:01.38,1:27:03.05,Default,,0,0,0,,Қола мүсіннің қанжары
Dialogue: 0,1:27:03.13,1:27:08.01,Default,,0,0,0,,Бұл Шиндлер тұқымдасының ата-бабаларынан қалған құрметті зат сияқты.
Dialogue: 0,1:27:08.64,1:27:11.22,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,1:27:11.30,1:27:15.35,Default,,0,0,0,,Неліктен мұндай қанжарды кісі өлтіру қаруы ретінде пайдаландың?
Dialogue: 0,1:27:15.43,1:27:19.73,Default,,0,0,0,,Кісі өлтіретін қару сол қанжар болуы керек еді.
Dialogue: 0,1:27:19.81,1:27:21.02,Default,,0,0,0,,Егер...
Dialogue: 0,1:27:21.11,1:27:22.48,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:25.03,1:27:28.15,Default,,0,0,0,,Сізге не керек? жыртқышты тартыңыз
Dialogue: 0,1:27:28.24,1:27:29.86,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,1:27:29.95,1:27:33.37,Default,,0,0,0,,Енді мен анамды өлтіру арқылы көптен бергі кекімді сейілдім.
Dialogue: 0,1:27:33.45,1:27:34.58,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,1:27:34.66,1:27:37.12,Default,,0,0,0,,Тірі бол
Dialogue: 0,1:27:37.21,1:27:39.79,Default,,0,0,0,,Ішімде ағып жатқан жауыз қан
Dialogue: 0,1:27:39.87,1:27:42.88,Default,,0,0,0,,Нұхтың кемесіне оны келесі ұрпаққа жеткізіңіз!
Dialogue: 0,1:27:42.96,1:27:45.05,Default,,0,0,0,,Фухаха...
Dialogue: 0,1:27:45.13,1:27:47.05,Default,,0,0,0,,Фухаха...
Dialogue: 0,1:27:47.13,1:27:49.76,Default,,0,0,0,,Кашимураны өлтірудің себебі осы, солай ма?
Dialogue: 0,1:27:49.84,1:27:51.51,Default,,0,0,0,,Хмм...
Dialogue: 0,1:27:52.01,1:27:54.31,Default,,0,0,0,,Риппер Джектің қаны
Dialogue: 0,1:27:54.39,1:27:57.35,Default,,0,0,0,,Нұхтың кемесіне кіргізілгендей
Dialogue: 0,1:27:57.43,1:27:59.64,Default,,0,0,0,,Қазіргі заманға дейін сақталды
Dialogue: 0,1:28:00.69,1:28:03.61,Default,,0,0,0,,Сіз Риппер Джектің ұрпағысыз ба?
Dialogue: 0,1:28:04.52,1:28:06.73,Default,,0,0,0,,Джек... Риппер Джек...
Dialogue: 0,1:28:06.82,1:28:07.82,Default,,0,0,0,,Ұрпақтары…
Dialogue: 0,1:28:07.90,1:28:09.74,Default,,0,0,0,,Хироки-кун шығар.
Dialogue: 0,1:28:09.82,1:28:12.53,Default,,0,0,0,,Мен мұны ДНҚ барлау бағдарламасы арқылы білдім.
Dialogue: 0,1:28:12.62,1:28:15.37,Default,,0,0,0,,IT саласының патшасы
Dialogue: 0,1:28:15.45,1:28:21.00,Default,,0,0,0,,Егер сіздің 100 жыл бұрынғы сериялы өлтірушінің ұрпағы екеніңізді әлем білсе, сіз құрдымға кетесіз.
Dialogue: 0,1:28:21.87,1:28:25.75,Default,,0,0,0,,Сондықтан мен Хирокиді үнсіз қалдыру үшін оны өз-өзіне қол жұмсауға мәжбүрледім.
Dialogue: 0,1:28:25.84,1:28:28.97,Default,,0,0,0,,Кашимураны да өлтірді
Dialogue: 0,1:28:29.88,1:28:34.85,Default,,0,0,0,,Сол кезде Хироки менің коллекциямды көруге келді.
Dialogue: 0,1:28:36.60,1:28:41.14,Default,,0,0,0,,Бұл Мысыр патшасы Хуфу қолданған алтын тостаған.
Dialogue: 0,1:28:41.23,1:28:44.11,Default,,0,0,0,,Келесі - Ганжин Ваджо Сутра
Dialogue: 0,1:28:44.19,1:28:48.57,Default,,0,0,0,,Және Эдогава Ранпоның «Психологиялық сараптама» қолжазбасы
Dialogue: 0,1:28:48.65,1:28:50.70,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,1:28:51.95,1:28:53.16,Default,,0,0,0,,Бұл қанжар не?
Dialogue: 0,1:28:53.24,1:28:57.12,Default,,0,0,0,,Иә? А... жоқ, бұл...
Dialogue: 0,1:28:57.74,1:29:01.33,Default,,0,0,0,,100 жыл бұрын сериялық өлтіруші Джек Риппер
Dialogue: 0,1:29:01.41,1:29:03.04,Default,,0,0,0,,Бұл кісі өлтіру қаруы болса керек.
Dialogue: 0,1:29:03.12,1:29:05.75,Default,,0,0,0,,Бұл рас па, жоқ па білмеймін.
Dialogue: 0,1:29:05.84,1:29:07.80,Default,,0,0,0,,Хмм…
Dialogue: 0,1:29:10.51,1:29:12.88,Default,,0,0,0,,Хироки экспериментке арналған
Dialogue: 0,1:29:12.97,1:29:15.89,Default,,0,0,0,,Айналаңыздан мүмкіндігінше көп деректер жинаңыз.
Dialogue: 0,1:29:15.97,1:29:18.14,Default,,0,0,0,,Мен оны компьютерге жаздым.
Dialogue: 0,1:29:18.22,1:29:22.81,Default,,0,0,0,,Қанжардан Бал Чарльстонның ДНҚ-сы анықталды
Dialogue: 0,1:29:22.89,1:29:25.35,Default,,0,0,0,,ДНҚ-ға сәйкес келеді
Dialogue: 0,1:29:25.44,1:29:27.77,Default,,0,0,0,,Сен қорқтың
Dialogue: 0,1:29:27.86,1:29:29.23,Default,,0,0,0,,Бір күні Хироки-кун
Dialogue: 0,1:29:29.32,1:29:32.95,Default,,0,0,0,,Джек Риппердің Балдың ұлы екенін білу...
Dialogue: 0,1:29:33.03,1:29:34.11,Default,,0,0,0,,Сіз туралы
Dialogue: 0,1:29:34.20,1:29:38.91,Default,,0,0,0,,Сіздің Джек Риппердің ұрпағы екеніңізді білуіміз уақыт мәселесі.
Dialogue: 0,1:29:39.49,1:29:44.25,Default,,0,0,0,,Мен қорықтым, ішімде ағып жатқан сұмдық қан!
Dialogue: 0,1:29:44.33,1:29:46.63,Default,,0,0,0,,Қанішердің қаны несі!
Dialogue: 0,1:29:46.71,1:29:48.29,Default,,0,0,0,,Көпшіліктің көз алдында не!
Dialogue: 0,1:29:48.38,1:29:50.71,Default,,0,0,0,,Неге ұрысуға тырыспадың?
Dialogue: 0,1:29:50.80,1:29:53.67,Default,,0,0,0,,Ah... uh...
Dialogue: 0,1:29:54.26,1:29:56.34,Default,,0,0,0,,Дәл қазір Конан және басқалары сияқты.
Dialogue: 0,1:29:57.72,1:30:02.10,Default,,0,0,0,,Томас Шиндлер Тадаки Кашимураны өлтірді деген күдікпен қамауға алынды
Dialogue: 0,1:30:09.90,1:30:10.94,Default,,0,0,0,,Әй!
Dialogue: 0,1:30:12.65,1:30:13.65,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,1:30:15.45,1:30:18.32,Default,,0,0,0,,Қашып кетсең мені ұстай алмайсың.
Dialogue: 0,1:30:18.41,1:30:21.29,Default,,0,0,0,,10 минуттан кейін соңғы станцияда боламыз.
Dialogue: 0,1:30:21.37,1:30:24.41,Default,,0,0,0,,Машинистсіз бұл пойыз не болады?
Dialogue: 0,1:30:24.50,1:30:25.58,Default,,0,0,0,,Ха…
Dialogue: 0,1:30:30.59,1:30:35.34,Default,,0,0,0,,Дегенмен вокзалға асығыс кірмес бұрын, балалар, Одабутсуға ұқсайсыңдар.
Dialogue: 0,1:30:35.43,1:30:36.80,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:36.88,1:30:38.64,Default,,0,0,0,,Конан-кун, артыңызда!
Dialogue: 0,1:30:38.72,1:30:39.60,Default,,0,0,0,,Ха!
Dialogue: 0,1:30:46.10,1:30:46.94,Default,,0,0,0,,Уф!
Dialogue: 0,1:30:47.02,1:30:49.02,Default,,0,0,0,,Бар болғаны, балам.
Dialogue: 0,1:30:49.11,1:30:50.65,Default,,0,0,0,,Уф...
Dialogue: 0,1:30:50.73,1:30:52.15,Default,,0,0,0,,Конан-кун!
Dialogue: 0,1:30:52.23,1:30:53.90,Default,,0,0,0,,Көзілдірікті шешіңіз!
Dialogue: 0,1:30:53.99,1:30:54.99,Default,,0,0,0,,Моробоши-кун!
Dialogue: 0,1:30:56.95,1:30:58.36,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:30:58.45,1:31:00.83,Default,,0,0,0,,Хахаха... аа... әйтеуір
Dialogue: 0,1:31:01.74,1:31:04.95,Default,,0,0,0,,Енді кесуді қайдан бастау керек?
Dialogue: 0,1:31:05.04,1:31:06.41,Default,,0,0,0,,Уф...
Dialogue: 0,1:31:06.50,1:31:07.75,Default,,0,0,0,,Ах...
Dialogue: 0,1:31:07.83,1:31:09.79,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,1:31:09.88,1:31:13.38,Default,,0,0,0,,Шиничи! Мұндай жағдайда Шиничи не істер еді?
Dialogue: 0,1:31:14.63,1:31:16.47,Default,,0,0,0,,Мен Холмстың жолын сол кезде естідім.
Dialogue: 0,1:31:16.55,1:31:18.97,Default,,0,0,0,,Маған ұнайтын нәрсе бар.
Dialogue: 0,1:31:19.05,1:31:20.51,Default,,0,0,0,,Сіз оның не екенін білесіз бе?
Dialogue: 0,1:31:20.60,1:31:21.72,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,1:31:21.80,1:31:23.64,Default,,0,0,0,,Міне
Dialogue: 0,1:31:23.72,1:31:27.14,Default,,0,0,0,,«Егер мен сені анық жоя алсам».
Dialogue: 0,1:31:27.23,1:31:31.06,Default,,0,0,0,,«Мен қоғам игілігі үшін өлімді қуана қабылдаймын».
Dialogue: 0,1:31:32.06,1:31:33.27,Default,,0,0,0,,Ха…
Dialogue: 0,1:31:35.82,1:31:37.20,Default,,0,0,0,,Көзілдірік!
Dialogue: 0,1:31:37.28,1:31:39.91,Default,,0,0,0,,Рейхенбах сарқырамасы, Конан!
Dialogue: 0,1:31:39.99,1:31:41.07,Default,,0,0,0,,Иә?
Dialogue: 0,1:31:41.16,1:31:42.53,Default,,0,0,0,,Иә?
Dialogue: 0,1:31:44.58,1:31:45.95,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,1:31:46.04,1:31:49.92,Default,,0,0,0,,Сізбен соңына дейін бірге бола алмағаным үшін кешіріңіз.
Dialogue: 0,1:31:51.83,1:31:53.38,Default,,0,0,0,,Келіңіздер! Жүгіріп кетті!
Dialogue: 0,1:31:53.46,1:31:54.84,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,1:32:01.22,1:32:02.05,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,1:32:02.14,1:32:04.60,Default,,0,0,0,,Ах!
Dialogue: 0,1:32:06.18,1:32:09.69,Default,,0,0,0,,Конан-кун, мен саған сенемін...
Dialogue: 0,1:32:18.28,1:32:22.16,Default,,0,0,0,,Уау!
Dialogue: 0,1:32:22.24,1:32:23.70,Default,,0,0,0,,Жүгірдім!
Dialogue: 0,1:32:28.08,1:32:30.54,Default,,0,0,0,,Көзілдірік Біз пойызды тоқтатуымыз керек!
Dialogue: 0,1:32:33.08,1:32:36.21,Default,,0,0,0,,Әй, пойызды тоқтат, аман қалуымыз керек.
Dialogue: 0,1:32:36.30,1:32:38.84,Default,,0,0,0,,Сіз әлі ойында жеңдім деп айта алмайсыз!
Dialogue: 0,1:32:40.17,1:32:44.43,Default,,0,0,0,,Тұр, көзілдірік, бізге 48 адамның өмірі сеніп тапсырылған!
Dialogue: 0,1:32:44.51,1:32:46.97,Default,,0,0,0,,Сіз әркімнің сезімін таптауға тырысасыз ба?
Dialogue: 0,1:32:47.06,1:32:50.39,Default,,0,0,0,,Барлоу! Мен де бас тартпас едім.
Dialogue: 0,1:32:52.81,1:32:54.11,Default,,0,0,0,,Ойлан
Dialogue: 0,1:32:54.19,1:32:56.82,Default,,0,0,0,,Пойыз барған сайын жылдам келеді.
Dialogue: 0,1:32:56.90,1:32:59.24,Default,,0,0,0,,Пойыздың жылдамдығы шамамен 100км/сағ
Dialogue: 0,1:32:59.32,1:33:02.20,Default,,0,0,0,,Терминалға 5 минуттан аз уақыт қалды
Dialogue: 0,1:33:02.28,1:33:04.07,Default,,0,0,0,,Барлығына көмектесу
Dialogue: 0,1:33:04.16,1:33:08.41,Default,,0,0,0,,Жалғыз жол локомотив пен жолаушылар вагонының арасындағы байланысты ажырату болды.
Dialogue: 0,1:33:08.49,1:33:12.83,Default,,0,0,0,,Екеуміздің күш-қуатымызбен бұл байланыстырушы бөлік қозғалмайды.
Dialogue: 0,1:33:12.92,1:33:14.58,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:33:14.67,1:33:18.55,Default,,0,0,0,,Бұл Ранмен күш біріктіру арқылы жасауға болатын есеп болды.
Dialogue: 0,1:33:18.63,1:33:19.84,Default,,0,0,0,,Я...
Dialogue: 0,1:33:20.72,1:33:25.01,Default,,0,0,0,,Сондықтан Нұхтың кемесі бар жігіт жолаушыларды түгел жойды.
Dialogue: 0,1:33:25.09,1:33:28.68,Default,,0,0,0,,Жоқ... енді мен ештеңе істей алмаймын
Dialogue: 0,1:33:31.06,1:33:33.94,Default,,0,0,0,,Енді жоқ, әке...
Dialogue: 0,1:33:34.02,1:33:36.19,Default,,0,0,0,,Ей, берілме!
Dialogue: 0,1:33:36.27,1:33:40.11,Default,,0,0,0,,Өтінемін, қалай болса да аман қалып, Ранның өмірін қалпына келтіріңіз!
Dialogue: 0,1:33:41.57,1:33:43.07,Default,,0,0,0,,Шиничи…
Dialogue: 0,1:33:47.83,1:33:50.20,Default,,0,0,0,,Хахаха...
Dialogue: 0,1:33:50.29,1:33:53.75,Default,,0,0,0,,Сіз әлі қанға батқан жоқсыз.
Dialogue: 0,1:33:53.83,1:33:55.75,Default,,0,0,0,,Сен әлі тірісің, солай емес пе?
Dialogue: 0,1:33:55.83,1:33:57.59,Default,,0,0,0,,Сіз қазірдің өзінде бас тарттыңыз ба?
Dialogue: 0,1:33:57.67,1:33:59.55,Default,,0,0,0,,Қазірдің өзінде балалар
Dialogue: 0,1:33:59.63,1:34:01.55,Default,,0,0,0,,Шындықты ашатын түйінде
Dialogue: 0,1:34:01.63,1:34:04.51,Default,,0,0,0,,Екі қол да қосулы болса да
Dialogue: 0,1:34:04.59,1:34:07.26,Default,,0,0,0,,Хахаха...
Dialogue: 0,1:34:08.01,1:34:10.81,Default,,0,0,0,,Өмір деп аталатын түссіз жіптер шоғырында...
Dialogue: 0,1:34:10.89,1:34:13.73,Default,,0,0,0,,Кісі өлтірудің ашық қызыл жібі тоғысқан.
Dialogue: 0,1:34:13.81,1:34:18.56,Default,,0,0,0,,Оны ашу біздің міндетіміз емес пе?
Dialogue: 0,1:34:18.65,1:34:19.94,Default,,0,0,0,,Холмс!
Dialogue: 0,1:34:24.11,1:34:26.07,Default,,0,0,0,,Ол Дартмурға барды...
Dialogue: 0,1:34:26.16,1:34:27.99,Default,,0,0,0,,Бұл шынымен қате ме?
Dialogue: 0,1:34:28.07,1:34:29.78,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,1:34:29.87,1:34:31.66,Default,,0,0,0,,Джек Риппер қайтыс болды
Dialogue: 0,1:34:31.74,1:34:33.62,Default,,0,0,0,,Неге қанға боялуымыз керек...
Dialogue: 0,1:34:33.70,1:34:37.12,Default,,0,0,0,,А, міне, солай! Бұл болды!
Dialogue: 0,1:34:37.21,1:34:38.13,Default,,0,0,0,,Жүк вагоны!
Dialogue: 0,1:34:38.21,1:34:40.09,Default,,0,0,0,,Эй, күте тұр! Не айтқың келеді?
Dialogue: 0,1:34:40.17,1:34:41.84,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,1:34:45.42,1:34:46.47,Default,,0,0,0,,Хмм...
Dialogue: 0,1:34:47.68,1:34:50.97,Default,,0,0,0,,Қызыл шарап бөшкесін сындыру үшін ілулі тұрған балтаны пайдаланыңыз!
Dialogue: 0,1:34:51.06,1:34:52.26,Default,,0,0,0,,Жүгір!
Dialogue: 0,1:34:52.35,1:34:53.18,Default,,0,0,0,,Әй!
Dialogue: 0,1:34:53.27,1:34:55.52,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,1:35:09.16,1:35:11.08,Default,,0,0,0,,Мен белгі бергенде, сүңгіңіз!
Dialogue: 0,1:35:11.16,1:35:12.03,Default,,0,0,0,,О
Dialogue: 0,1:35:17.96,1:35:19.00,Default,,0,0,0,,Хмм...
Dialogue: 0,1:35:25.59,1:35:26.80,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,1:35:27.68,1:35:28.88,Default,,0,0,0,,Уф...
Dialogue: 0,1:35:28.97,1:35:30.39,Default,,0,0,0,,Уау!
Dialogue: 0,1:35:54.12,1:35:58.00,Default,,0,0,0,,
Dialogue: 0,1:36:00.54,1:36:02.04,Default,,0,0,0,,Екі дауыс дегеніміз не?
Dialogue: 0,1:36:02.13,1:36:04.17,Default,,0,0,0,,Мен әлі ештеңе естіген жоқпын.
Dialogue: 0,1:36:04.25,1:36:06.59,Default,,0,0,0,,Конан Даймёжин!
Dialogue: 0,1:36:06.67,1:36:08.38,Default,,0,0,0,,Өтінемін, Ран!
Dialogue: 0,1:36:12.72,1:36:14.89,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,1:36:14.97,1:36:15.81,Default,,0,0,0,,Ха…
Dialogue: 0,1:36:19.73,1:36:22.31,Default,,0,0,0,,Мен «қанды» көрдім бе?
Dialogue: 0,1:36:22.40,1:36:26.36,Default,,0,0,0,,Ол шокты қызыл шараппен жұмсартқысы келді...
Dialogue: 0,1:36:27.99,1:36:30.15,Default,,0,0,0,,Көмегің үшін рахмет, Холмс...
Dialogue: 0,1:36:30.24,1:36:31.99,Default,,0,0,0,,Жоқ, әке.
Dialogue: 0,1:36:32.07,1:36:34.95,Default,,0,0,0,,Эй, Көзілдірік, ояусың ба?
Dialogue: 0,1:36:35.03,1:36:37.45,Default,,0,0,0,,Сіз жеңімпаз сияқтысыз.
Dialogue: 0,1:36:37.54,1:36:39.00,Default,,0,0,0,,«Сенің»?
Dialogue: 0,1:36:40.58,1:36:41.58,Default,,0,0,0,,Фу…
Dialogue: 0,1:36:42.88,1:36:45.21,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:36:46.50,1:36:49.26,Default,,0,0,0,,Саған сенгеніме қуаныштымын.
Dialogue: 0,1:36:49.34,1:36:50.22,Default,,0,0,0,,Рахмет
Dialogue: 0,1:36:51.05,1:36:54.18,Default,,0,0,0,,Жарайсың, Нұхтың кемесі
Dialogue: 0,1:36:55.72,1:36:59.23,Default,,0,0,0,,Әлде мен сені Хироки-кун деп атасам ба?
Dialogue: 0,1:36:59.31,1:37:01.39,Default,,0,0,0,,Моробоши деректерін алу
Dialogue: 0,1:37:01.48,1:37:04.10,Default,,0,0,0,,Бұл ойынға сіз де қатыстыңыз, солай ма?
Dialogue: 0,1:37:04.19,1:37:05.36,Default,,0,0,0,,Фу…
Dialogue: 0,1:37:08.23,1:37:09.44,Default,,0,0,0,,Қашаннан бері?
Dialogue: 0,1:37:09.53,1:37:10.61,Default,,0,0,0,,Ах...
Dialogue: 0,1:37:11.20,1:37:12.91,Default,,0,0,0,,Бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,1:37:12.99,1:37:16.08,Default,,0,0,0,,Әзірге нақты әлеммен байланыс үзілді.
Dialogue: 0,1:37:16.16,1:37:19.75,Default,,0,0,0,,Мен біртүрлі деп ойлаған бірінші нәрсе Биг Бен болды.
Dialogue: 0,1:37:21.00,1:37:23.54,Default,,0,0,0,,Ине қозғалмай тұрып байқадыңыз.
Dialogue: 0,1:37:24.25,1:37:25.58,Default,,0,0,0,,Бұл біз үшін
Dialogue: 0,1:37:25.67,1:37:28.96,Default,,0,0,0,,Сіз бізге Биг Бен бейнелеген уақыттың мағынасын айтқыңыз келді, солай ма?
Dialogue: 0,1:37:29.63,1:37:31.72,Default,,0,0,0,,Келесіде футбол добы.
Dialogue: 0,1:37:31.80,1:37:35.39,Default,,0,0,0,,Сол кезде лас доп деп, артқа лақтырдың.
Dialogue: 0,1:37:35.47,1:37:38.89,Default,,0,0,0,,Егер сіз футболшы болсаңыз, сізді қызықтырмауы мүмкін емес.
Dialogue: 0,1:37:38.97,1:37:41.27,Default,,0,0,0,,100 жыл бұрынғы футбол добы.
Dialogue: 0,1:37:43.64,1:37:46.61,Default,,0,0,0,,Сен бізге қауіп төндірдің
Dialogue: 0,1:37:46.69,1:37:50.53,Default,,0,0,0,,Шындық мынада, біз бірігіп, бұл дағдарысты жеңе аламыз.
Dialogue: 0,1:37:50.61,1:37:52.32,Default,,0,0,0,,Сенбедің бе?
Dialogue: 0,1:37:53.07,1:37:57.53,Default,,0,0,0,,Жапонияны қалпына келтіру екінші және үшінші буынды өшіру емес.
Dialogue: 0,1:37:57.62,1:38:01.08,Default,,0,0,0,,Ата-анаңның күш-қуатына сенбей, қабырғаны еңсер
Dialogue: 0,1:38:01.16,1:38:05.83,Default,,0,0,0,,Сіз біздің ойын арқылы өсетінімізді күткен едіңіз, солай ма?
Dialogue: 0,1:38:06.63,1:38:08.84,Default,,0,0,0,,Сіз мейірімсіз бола алмадыңыз
Dialogue: 0,1:38:08.92,1:38:12.05,Default,,0,0,0,,Холмстың соңғы рет шығуы соның дәлелі.
Dialogue: 0,1:38:12.13,1:38:16.14,Default,,0,0,0,,Пайдалы кейіпкер шарықтау шегінде таныстырылды.
Dialogue: 0,1:38:19.68,1:38:23.73,Default,,0,0,0,,Моробошидің денесін алып, ойынға жасырын кірген адам
Dialogue: 0,1:38:23.81,1:38:27.31,Default,,0,0,0,,Менің достарыммен бір рет болса да араласқым келгендіктен болды.
Dialogue: 0,1:38:28.56,1:38:31.73,Default,,0,0,0,,Өйткені мен үнемі жұмыста болдым.
Dialogue: 0,1:38:31.82,1:38:33.28,Default,,0,0,0,,Хмм...
Dialogue: 0,1:38:33.36,1:38:36.45,Default,,0,0,0,,Сізді осындай қорқынышты оқиғаға ұшыратқаным үшін кешіріңіз.
Dialogue: 0,1:38:36.53,1:38:40.24,Default,,0,0,0,,Бірақ мен көп көңілді болдым.
Dialogue: 0,1:38:40.83,1:38:43.50,Default,,0,0,0,,Ал мен қызғандым.
Dialogue: 0,1:38:43.58,1:38:47.71,Default,,0,0,0,,Арамыз алшақ болса да, әкең екеуің бір-біріңмен байланыстасыңдар.
Dialogue: 0,1:38:49.59,1:38:54.30,Default,,0,0,0,,Әкең менің әкемнің жауын алды.
Dialogue: 0,1:38:54.38,1:38:55.63,Default,,0,0,0,,Рахмет
Dialogue: 0,1:38:56.18,1:38:58.43,Default,,0,0,0,,Қоштасатын кез келді
Dialogue: 0,1:39:00.47,1:39:02.06,Default,,0,0,0,,Хирокидің жүрегі
Dialogue: 0,1:39:02.14,1:39:05.06,Default,,0,0,0,,Нұхтың кемесі ішінде мәңгі өмір сүре бересің бе?
Dialogue: 0,1:39:07.81,1:39:10.27,Default,,0,0,0,,Мен сияқты компьютер тірі болса
Dialogue: 0,1:39:10.36,1:39:13.73,Default,,0,0,0,,Үлкендер сізді жаман істерге пайдаланады
Dialogue: 0,1:39:13.82,1:39:17.78,Default,,0,0,0,,Жасанды ми әлі тумауы керек еді.
Dialogue: 0,1:39:19.53,1:39:23.62,Default,,0,0,0,,Енді сіз өз әлеміңізге оралуыңыз керек.
Dialogue: 0,1:39:23.70,1:39:27.58,Default,,0,0,0,,Мен оянсам да, мұны бәрі білгенін қалаймын.
Dialogue: 0,1:39:27.67,1:39:32.04,Default,,0,0,0,,Шынайы өмір ойын сияқты оңай болуы керек.
Dialogue: 0,1:39:32.84,1:39:33.92,Default,,0,0,0,,Иә
Dialogue: 0,1:39:40.80,1:39:43.26,Default,,0,0,0,,Мен әкемді кездестіремін деп үміттенемін.
Dialogue: 0,1:39:47.06,1:39:50.60,Default,,0,0,0,,Қош бол, Шиничи Кудо...
Dialogue: 0,1:40:04.74,1:40:06.29,Default,,0,0,0,,О...
Dialogue: 0,1:40:06.37,1:40:09.50,Default,,0,0,0,,
Dialogue: 0,1:40:20.09,1:40:21.51,Default,,0,0,0,,Ах...
Dialogue: 0,1:40:21.59,1:40:23.10,Default,,0,0,0,,Ах!
Dialogue: 0,1:40:33.90,1:40:35.52,Default,,0,0,0,,Жүгірдім!
Dialogue: 0,1:40:36.15,1:40:37.99,Default,,0,0,0,,Сіз мұны істеген сияқтысыз.
Dialogue: 0,1:40:42.53,1:40:44.03,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:40:46.62,1:40:51.00,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,1:40:55.00,1:40:56.46,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын!
Dialogue: 0,1:40:56.55,1:40:57.38,Default,,0,0,0,,Бұл қызық болды!
Dialogue: 0,1:40:57.46,1:40:59.21,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасадым!
Dialogue: 0,1:40:59.30,1:41:00.34,Default,,0,0,0,,Керемет!
Dialogue: 0,1:41:02.47,1:41:03.80,Default,,0,0,0,,Фу…
Dialogue: 0,1:41:03.89,1:41:06.89,Default,,0,0,0,,Конан-кун, мені өмірге қайтарғаныңыз үшін рахмет.
Dialogue: 0,1:41:07.51,1:41:09.68,Default,,0,0,0,,Біз өте көп жұмыс жасадық.
Dialogue: 0,1:41:09.77,1:41:11.85,Default,,0,0,0,,Қандай шытырман оқиға!
Dialogue: 0,1:41:14.31,1:41:17.82,Default,,0,0,0,,Бұл жақсырақ. Шындық жақсырақ.
Dialogue: 0,1:41:18.86,1:41:20.61,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:20.69,1:41:23.28,Default,,0,0,0,,Көрініс
Dialogue: 0,1:41:25.91,1:41:26.74,Default,,0,0,0,,Ах...
Dialogue: 0,1:41:26.83,1:41:30.16,Default,,0,0,0,,Мен Конан-кунның міндетті түрде орындайтынына сендім.
Dialogue: 0,1:41:30.25,1:41:31.37,Default,,0,0,0,,Бірақ Ран-ничан
Dialogue: 0,1:41:31.46,1:41:34.54,Default,,0,0,0,,Онымен секіру тым абайсызда болар еді.
Dialogue: 0,1:41:34.63,1:41:37.54,Default,,0,0,0,,Өйткені Шиничидің Холмстың ең жақсы көретін сөзі
Dialogue: 0,1:41:37.63,1:41:38.92,Default,,0,0,0,,Жаңа ғана есіме түсті.
Dialogue: 0,1:41:39.00,1:41:40.51,Default,,0,0,0,,Не? Болды
Dialogue: 0,1:41:40.59,1:41:44.55,Default,,0,0,0,,Сіз Холмс пен профессор Мориарти алғаш кездескен кезде не айтқанын айтасыз ба?
Dialogue: 0,1:41:44.64,1:41:47.47,Default,,0,0,0,,О, Конан-кун, сен қайдан білесің?
Dialogue: 0,1:41:47.55,1:41:51.39,Default,,0,0,0,,А, жоқ, қарашы, мен де Шиничи-нии-чаннанмын...
Dialogue: 0,1:41:51.48,1:41:52.89,Default,,0,0,0,,Не?
Dialogue: 0,1:41:52.98,1:41:55.02,Default,,0,0,0,,Бірақ табанды түрде сұраудың арқасында,
Dialogue: 0,1:41:55.10,1:41:56.77,Default,,0,0,0,,Бұл жолы маған көмектесті.
Dialogue: 0,1:41:57.48,1:42:01.24,Default,,0,0,0,,Сол себепті «табандық» қажет емес.
Dialogue: 0,1:42:01.32,1:42:02.36,Default,,0,0,0,,Жүгірдім!
Dialogue: 0,1:42:02.44,1:42:03.82,Default,,0,0,0,,Әке!
Dialogue: 0,1:42:03.90,1:42:06.70,Default,,0,0,0,,Жақсы, рахмет, амансың!
Dialogue: 0,1:42:09.37,1:42:10.66,Default,,0,0,0,,Ах...
Dialogue: 0,1:42:25.80,1:42:28.68,Default,,0,0,0,,Сізге көп уақыт қажет болды.
Dialogue: 0,1:42:29.26,1:42:32.14,Default,,0,0,0,,А, маған қатты ұнады.
Dialogue: 0,1:42:32.22,1:42:33.89,Default,,0,0,0,,Фу…
Dialogue: 0,1:42:35.19,1:42:41.57,Default,,0,0,0,,(Компьютердің тоқтау дыбысы)
Dialogue: 0,1:42:47.16,1:42:50.74,Default,,0,0,0,,Нұхтың кемесі өз өмірін аяқтауға тырысады.
Dialogue: 0,1:42:52.16,1:42:55.33,Default,,0,0,0,,Жатқан жерің жайлы, Хироки-кун.
Dialogue: 0,1:42:56.33,1:43:01.34,Default,,0,0,0,,♪~
Dialogue: 0,1:46:30.92,1:46:35.93,Default,,0,0,0,,~♪
Dialogue: 0,1:46:44.98,1:46:49.94,Default,,0,0,0,,
Dialogue: 0,1:46:52.82,1:46:53.94,Default,,0,0,0,,Ах...
Dialogue: 0,1:46:55.99,1:46:56.91,Default,,0,0,0,,Хмм...
Dialogue: 0,1:47:00.12,1:47:03.29,Default,,0,0,0,,Маған мазақ болмас үшін жаттығу керек.
Dialogue: 0,1:47:03.87,1:47:05.91,Default,,0,0,0,,Ммм... Мм...
Dialogue: 0,1:47:06.00,1:47:08.29,Default,,0,0,0,,Қарғыс атсын... Қарғыс атсын...
Dialogue: 0,1:47:09.79,1:47:15.79,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
