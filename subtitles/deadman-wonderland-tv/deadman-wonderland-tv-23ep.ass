Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:11.56,0:02:15.74,op,NTP,0000,0000,0000,,Ақыл мен шындықты қатаң бақылау
Dialogue: 0,0:02:15.74,0:02:20.16,op,NTP,0000,0000,0000,,Өзімді кесіп, олардың ессіздігі үшін айқайлаймын
Dialogue: 0,0:02:20.20,0:02:24.49,op,NTP,0000,0000,0000,,Ешқашан бітпейтін қорқынышты түспен ояныңыз
Dialogue: 0,0:02:24.54,0:02:29.25,op,NTP,0000,0000,0000,,Бұл бұралған бас жоспардың басты тартымдылығы
Dialogue: 0,0:02:42.01,0:02:46.18,op,NTP,0000,0000,0000,,Мен сенің өлген адамың боламын
Dialogue: 0,0:02:46.27,0:02:50.60,op,NTP,0000,0000,0000,,Менің қолымдағы қаннан басқа ештеңе жоқ
Dialogue: 0,0:02:50.69,0:02:55.07,op,NTP,0000,0000,0000,,Сіздің ғажайыптар елінде қалдыңыз
Dialogue: 0,0:02:55.11,0:02:59.49,op,NTP,0000,0000,0000,,Мен де мен сияқты сені қансыратқым келеді
Dialogue: 0,0:02:59.53,0:03:03.99,op,NTP,0000,0000,0000,,Ендеше мені өлген адам ет
Dialogue: 0,0:03:04.03,0:03:08.29,op,NTP,0000,0000,0000,,Тамырымда тек умен
Dialogue: 0,0:03:08.33,0:03:12.63,op,NTP,0000,0000,0000,,Сіздің ғажайыптар елінде қалдыңыз
Dialogue: 0,0:03:12.71,0:03:14.92,op,NTP,0000,0000,0000,,Мен жасауым керек шайқаста қалдым
Dialogue: 0,0:03:14.96,0:03:17.71,op,NTP,0000,0000,0000,,Мен сияқты сені қансыратамын
Dialogue: 0,0:00:06.90,0:00:08.73,jp_text,NTP,0000,0000,0000,,Өзін аянышты сезіну қалыпты жағдай.
Dialogue: 0,0:00:10.28,0:00:13.61,jp_text,NTP,0000,0000,0000,,Мен ештеңе істей алмаймын.
Dialogue: 0,0:00:14.41,0:00:16.28,jp_text,NTP,0000,0000,0000,,Бірақ Ганта әлсіз.
Dialogue: 0,0:00:17.53,0:00:19.24,jp_text,NTP,0000,0000,0000,,Широ дұрыс айтады.
Dialogue: 0,0:00:19.62,0:00:22.16,jp_text,NTP,0000,0000,0000,,Бірақ мен оны дұрыс түсінбей, күмәндандым.
Dialogue: 0,0:00:22.46,0:00:25.79,jp_text,NTP,0000,0000,0000,,Мен қорқып кетсем, Широның маған қайтадан көмектескенін қалаймын.
Dialogue: 0,0:00:26.25,0:00:28.59,jp_text,NTP,0000,0000,0000,,Маған шынымен соққы беру керек ...
Dialogue: 0,0:00:35.09,0:00:36.39,jp_text,NTP,0000,0000,0000,,Өтінемін, Чижи-сан.
Dialogue: 0,0:00:36.64,0:00:39.93,jp_text,NTP,0000,0000,0000,,Маған күресуді үйретіңізші
Dialogue: 0,0:00:41.02,0:00:43.06,jp_text,NTP,0000,0000,0000,,Жылап тұрған бала Чиби деп атады?
Dialogue: 0,0:00:44.27,0:00:46.06,jp_text,NTP,0000,0000,0000,,Күшті болудан басқа амалымыз жоқ.
Dialogue: 0,0:00:47.02,0:00:49.98,jp_text,NTP,0000,0000,0000,,Мен күшейсем, Наги-санға көмектесе аламын.
Dialogue: 0,0:00:50.44,0:00:54.40,jp_text,NTP,0000,0000,0000,,Егер мен күшейіп кетсем, енді Широ туралы алаңдамаймын.
Dialogue: 0,0:00:54.74,0:00:58.49,jp_text,NTP,0000,0000,0000,,Күшті болған соң қызыл адам жібере аласың
Dialogue: 0,0:00:59.28,0:01:02.29,jp_text,NTP,0000,0000,0000,,Күшті болсам, бұлай сорлы болмаймын.
Dialogue: 0,0:01:02.66,0:01:08.50,jp_text,NTP,0000,0000,0000,,Мен әлсіз өзімді жұдырықтай алатындай күшті болғым келеді.
Dialogue: 0,0:01:16.97,0:01:18.22,jp_text,NTP,0000,0000,0000,,Жауап дұрыс.
Dialogue: 0,0:01:18.51,0:01:20.93,jp_text,NTP,0000,0000,0000,,тым көп суды сорып жатыр.
Dialogue: 0,0:01:22.31,0:01:23.39,jp_text,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:01:23.89,0:01:27.40,jp_text,NTP,0000,0000,0000,,Тек бас тарту жаман болды, Ганта Игараши.
Dialogue: 0,0:01:29.52,0:01:30.86,jp_text,NTP,0000,0000,0000,,Дайынсың ба?
Dialogue: 0,0:01:31.65,0:01:35.95,jp_text,NTP,0000,0000,0000,,Әрқашан ақиқат болатын ақиқат – тозаққа ең жақын лай.
Dialogue: 0,0:01:43.24,0:01:44.04,jp_text,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:03:24.43,0:03:25.72,jp_text,NTP,0000,0000,0000,,Шоколадты толтыру
Dialogue: 0,0:03:26.01,0:03:27.56,jp_text,NTP,0000,0000,0000,,Сәлем, жұмыртқаны қайтар
Dialogue: 0,0:03:27.60,0:03:30.23,jp_text,NTP,0000,0000,0000,,Кешеден бері көп тамақ жейсің.
Dialogue: 0,0:03:30.39,0:03:31.98,jp_text,NTP,0000,0000,0000,,Бейшара ит?
Dialogue: 0,0:03:31.98,0:03:33.15,jp_text,NTP,0000,0000,0000,,Жұмыртқаларды қайтару жоқ
Dialogue: 0,0:03:33.15,0:03:35.52,jp_text,NTP,0000,0000,0000,,Широ Широ Даттеба
Dialogue: 0,0:03:35.69,0:03:38.73,jp_text,NTP,0000,0000,0000,,Эй, Широ сонша таң қалды ма?
Dialogue: 0,0:03:39.15,0:03:40.61,jp_text,NTP,0000,0000,0000,,Менің досым мені ұрды
Dialogue: 0,0:03:41.20,0:03:42.74,jp_text,NTP,0000,0000,0000,,Менің бетім әлі ауырады
Dialogue: 0,0:03:43.11,0:03:45.24,jp_text,NTP,0000,0000,0000,,Бұл ауырады ма? Сіз?
Dialogue: 0,0:03:45.45,0:03:48.12,jp_text,NTP,0000,0000,0000,,Широ - эйс адам.
Dialogue: 0,0:03:48.99,0:03:50.79,jp_text,NTP,0000,0000,0000,,Еркек болғаннан кейін
Dialogue: 0,0:03:50.83,0:03:53.08,jp_text,NTP,0000,0000,0000,,Мен не істесем де, енді ауырмайды.
Dialogue: 0,0:03:54.08,0:03:55.38,jp_text,NTP,0000,0000,0000,,Бірақ неге?
Dialogue: 0,0:03:56.34,0:03:58.96,jp_text,NTP,0000,0000,0000,,Неліктен Широ эйс адамы?
Dialogue: 0,0:03:59.71,0:04:01.72,jp_text,NTP,0000,0000,0000,,Ганта сені неге жек көреді?
Dialogue: 0,0:04:02.51,0:04:04.55,jp_text,NTP,0000,0000,0000,,Неліктен печенье дәмді емес?
Dialogue: 0,0:04:05.14,0:04:08.93,jp_text,NTP,0000,0000,0000,,Мен кесе жесем де бұл жер неге тоймайды?
Dialogue: 0,0:04:10.56,0:04:12.10,jp_text,NTP,0000,0000,0000,,Ганта болса да
Dialogue: 0,0:04:13.02,0:04:14.56,jp_text,NTP,0000,0000,0000,,Әлсіз болса да
Dialogue: 0,0:04:14.65,0:04:16.86,jp_text,NTP,0000,0000,0000,,Неліктен қатты ауырады?
Dialogue: 0,0:04:18.19,0:04:21.57,jp_text,NTP,0000,0000,0000,,Ауырсынудың қажеті жоқ
Dialogue: 0,0:04:21.65,0:04:22.99,jp_text,NTP,0000,0000,0000,,Бұрынғыдай.
Dialogue: 0,0:04:23.90,0:04:27.37,jp_text,NTP,0000,0000,0000,,Мен саған көмектесейін десем де, сен маған опасыздық жасадың.
Dialogue: 0,0:04:27.41,0:04:31.66,jp_text,NTP,0000,0000,0000,,Кедей әлсіз адамдар айлакер, жауапсыз келеді.
Dialogue: 0,0:04:31.75,0:04:35.17,jp_text,NTP,0000,0000,0000,,Өзіңізді емес, басқаларды кінәлаңыз және басқаларды ренжітіңіз
Dialogue: 0,0:04:35.54,0:04:38.04,jp_text,NTP,0000,0000,0000,,Широ мұндай әлсіз адамға қамқорлық жасайды.
Dialogue: 0,0:04:38.92,0:04:41.76,jp_text,NTP,0000,0000,0000,,Бұл маңызды емес. Маған Ганта ұнамайды.
Dialogue: 0,0:04:41.96,0:04:44.22,jp_text,NTP,0000,0000,0000,,Дұрыс, Ганта кінәлі.
Dialogue: 0,0:04:44.26,0:04:45.93,jp_text,NTP,0000,0000,0000,,Мен сені ұрамын
Dialogue: 0,0:04:46.55,0:04:47.43,jp_text,NTP,0000,0000,0000,,Біраз
Dialogue: 0,0:04:57.35,0:04:59.36,jp_text,NTP,0000,0000,0000,,Ол ликермен толтырылған.
Dialogue: 0,0:04:59.65,0:05:02.03,jp_text,NTP,0000,0000,0000,,Бұл жеңіл тағамдар жарысына айналды.
Dialogue: 0,0:05:02.40,0:05:05.61,jp_text,NTP,0000,0000,0000,,Мен, жоқ, мен де жеңіл тамақ жеуім керек.
Dialogue: 0,0:05:09.99,0:05:12.91,jp_text,NTP,0000,0000,0000,,Көптеген тәтті «күнәнің бұтақтары»
Dialogue: 0,0:05:15.50,0:05:17.12,jp_text,NTP,0000,0000,0000,,Нагиді құтқарудан бас тарту
Dialogue: 0,0:05:17.71,0:05:19.00,jp_text,NTP,0000,0000,0000,,Әскери күштің жеткіліксіздігі немесе одан да көп
Dialogue: 0,0:05:19.25,0:05:22.30,jp_text,NTP,0000,0000,0000,,Партизандық операциялардың әртүрлі бағыттардан сыртқа көздеуден басқа амалы жоқ
Dialogue: 0,0:05:22.34,0:05:26.18,jp_text,NTP,0000,0000,0000,,Бірақ Рокуро құсу жолы міндетті түрде қауіпсіз емес.
Dialogue: 0,0:05:26.22,0:05:28.55,jp_text,NTP,0000,0000,0000,,Қауіпсіз маршрут деген ұғым жоқ.
Dialogue: 0,0:05:28.68,0:05:30.14,jp_text,NTP,0000,0000,0000,,Сөз жоқ.
Dialogue: 0,0:05:30.39,0:05:32.81,jp_text,NTP,0000,0000,0000,,Қабір күзетшілеріне тап болсаң
Dialogue: 0,0:05:30.39,0:05:32.81,Float_jp,NTP,0000,0000,0000,,Жетекші
Dialogue: 0,0:05:32.93,0:05:34.14,jp_text,NTP,0000,0000,0000,,Міне, солай.
Dialogue: 0,0:05:34.52,0:05:35.81,jp_text,NTP,0000,0000,0000,,Уақыт – уақыт
Dialogue: 0,0:05:36.19,0:05:37.06,jp_text,NTP,0000,0000,0000,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:05:37.23,0:05:38.52,jp_text,NTP,0000,0000,0000,,Ганта не істейді?
Dialogue: 0,0:05:38.81,0:05:40.77,jp_text,NTP,0000,0000,0000,,Ойланып қарасам, қайтып келмеймін.
Dialogue: 0,0:05:41.07,0:05:42.86,jp_text,NTP,0000,0000,0000,,Мұны тек осы жердегі мүшелер орындайды.
Dialogue: 0,0:05:43.61,0:05:46.03,jp_text,NTP,0000,0000,0000,,Сіз маған жалған уақыт айттыңыз.
Dialogue: 0,0:05:46.40,0:05:48.20,jp_text,NTP,0000,0000,0000,,Мен осылайша жақсырақ болар деп ойладым.
Dialogue: 0,0:05:48.70,0:05:49.87,jp_text,NTP,0000,0000,0000,,Сен мені жек көрмейсің бе?
Dialogue: 0,0:05:50.12,0:05:53.29,jp_text,NTP,0000,0000,0000,,Мен сізді қате бағалағандықтан, мен сізді қорқынышты оқиғаға ұшыраттым.
Dialogue: 0,0:05:53.83,0:05:55.45,jp_text,NTP,0000,0000,0000,,Мені көптен бері жек көреді.
Dialogue: 0,0:05:55.75,0:05:56.71,jp_text,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:05:56.87,0:05:58.12,jp_text,NTP,0000,0000,0000,,Сіз әлі жассыз.
Dialogue: 0,0:05:58.50,0:06:00.54,jp_text,NTP,0000,0000,0000,,Өз жаралары мен бостандықтарымен
Dialogue: 0,0:06:00.54,0:06:01.63,jp_text,NTP,0000,0000,0000,,Біз ұрысамыз
Dialogue: 0,0:06:03.42,0:06:05.46,jp_text,NTP,0000,0000,0000,,Тізбекті үзу
Dialogue: 0,0:06:12.81,0:06:14.77,jp_text,NTP,0000,0000,0000,,Бұл жақсы нәрсе болды ма?
Dialogue: 0,0:06:14.85,0:06:17.48,jp_text,NTP,0000,0000,0000,,Не, сен әлі тірісің бе?
Dialogue: 0,0:06:17.60,0:06:22.31,jp_text,NTP,0000,0000,0000,,Олардың қауіпсіздік деңгейі ең көбі 30/20, солай емес пе?
Dialogue: 0,0:06:22.61,0:06:25.40,jp_text,NTP,0000,0000,0000,,Қабір күзетшісімен соқтығысуы керек
Dialogue: 0,0:06:22.61,0:06:25.40,Float_jp,NTP,0000,0000,0000,,Жетекші
Dialogue: 0,0:06:25.53,0:06:27.11,jp_text,NTP,0000,0000,0000,,Табысты болыңыз
Dialogue: 0,0:06:27.49,0:06:31.70,jp_text,NTP,0000,0000,0000,,Эй, мен жасырын кіріп, оны жалғыз тоқтатамын деп ешқашан ойламаппын.
Dialogue: 0,0:06:31.99,0:06:33.08,jp_text,NTP,0000,0000,0000,,Бұл мүмкін емес емес пе?
Dialogue: 0,0:06:34.12,0:06:36.12,jp_text,NTP,0000,0000,0000,,Мен оны міндетті түрде көремін
Dialogue: 0,0:06:36.87,0:06:39.46,jp_text,NTP,0000,0000,0000,,Соның салдарынан өлсем де
Dialogue: 0,0:06:40.46,0:06:42.13,jp_text,NTP,0000,0000,0000,,Бұл қорқынышты есеп.
Dialogue: 0,0:06:46.96,0:06:48.72,jp_text,NTP,0000,0000,0000,,Оны маған әйелім берді.
Dialogue: 0,0:06:50.34,0:06:52.47,jp_text,NTP,0000,0000,0000,,Баламның суретін өзіммен бірге алып жүргім келеді.
Dialogue: 0,0:06:52.51,0:06:54.14,jp_text,NTP,0000,0000,0000,,Ер әйел?
Dialogue: 0,0:06:54.76,0:06:55.89,jp_text,NTP,0000,0000,0000,,Бұл қыз.
Dialogue: 0,0:06:56.43,0:06:57.47,jp_text,NTP,0000,0000,0000,,Мен оны көре аламын ба?
Dialogue: 0,0:06:58.06,0:06:59.02,jp_text,NTP,0000,0000,0000,,Әрине
Dialogue: 0,0:07:01.27,0:07:02.61,jp_text,NTP,0000,0000,0000,,Өйткені бұл бала осында
Dialogue: 0,0:07:02.86,0:07:05.52,jp_text,NTP,0000,0000,0000,,Тіпті негізсіз DW жертөлесінде
Dialogue: 0,0:07:05.82,0:07:07.65,jp_text,NTP,0000,0000,0000,,Мен үмітті бола аламын.
Dialogue: 0,0:07:08.69,0:07:13.37,jp_text,NTP,0000,0000,0000,,Бір күні жаңбыр жауып, көк аспан жайылып, міндетті түрде кемпірқосақты көресің.
Dialogue: 0,0:07:13.78,0:07:15.24,jp_text,NTP,0000,0000,0000,,Мен солай ойлаймын.
Dialogue: 0,0:07:16.79,0:07:17.91,jp_text,NTP,0000,0000,0000,,Бұл сүйкімді емес пе?
Dialogue: 0,0:07:19.54,0:07:20.92,jp_text,NTP,0000,0000,0000,,Сенің ата-анаң ақымақ па?
Dialogue: 0,0:07:22.12,0:07:25.21,jp_text,NTP,0000,0000,0000,,Мен саған ұқсаймын.
Dialogue: 0,0:07:40.31,0:07:42.23,jp_text,NTP,0000,0000,0000,,Мен қазір он екі рет өлдім.
Dialogue: 0,0:07:42.65,0:07:45.06,jp_text,NTP,0000,0000,0000,,Заряд ұзақ, оқ әлсіз
Dialogue: 0,0:07:45.48,0:07:46.82,jp_text,NTP,0000,0000,0000,,Орбита тым оқылады
Dialogue: 0,0:07:47.07,0:07:48.69,jp_text,NTP,0000,0000,0000,,Ең бастысы, бұл баяу.
Dialogue: 0,0:07:49.36,0:07:52.24,jp_text,NTP,0000,0000,0000,,Мен дыбыс жылдамдығынан асатын жылдамдыққа жете алмаймын.
Dialogue: 0,0:07:52.78,0:07:53.61,jp_text,NTP,0000,0000,0000,,Дыбыс жылдамдығы?
Dialogue: 0,0:07:54.07,0:07:56.28,jp_text,NTP,0000,0000,0000,,Қанды денеңізбен басқаруды үйреніңіз
Dialogue: 0,0:07:56.58,0:07:59.08,jp_text,NTP,0000,0000,0000,,Қанды өз мүшелеріңмен бірдей деп ойла.
Dialogue: 0,0:07:59.37,0:08:01.87,jp_text,NTP,0000,0000,0000,,Иә, бірақ мен не істеуім керек?
Dialogue: 0,0:08:02.58,0:08:05.13,jp_text,NTP,0000,0000,0000,,Ганта Қазір кәмпит бар ма?
Dialogue: 0,0:08:07.38,0:08:08.63,jp_text,NTP,0000,0000,0000,,Әрқашан бәрі
Dialogue: 0,0:08:14.43,0:08:16.93,jp_text,NTP,0000,0000,0000,,Эй, сен не істеп жатырсың, Чижи-сан?
Dialogue: 0,0:08:16.93,0:08:17.76,jp_text,NTP,0000,0000,0000,,Қозғалмаңыз
Dialogue: 0,0:08:19.10,0:08:21.27,jp_text,NTP,0000,0000,0000,,Мына кәмпитті сол жерден атып таста
Dialogue: 0,0:08:22.31,0:08:24.10,jp_text,NTP,0000,0000,0000,,Менің қорғанысымды бұзыңыз
Dialogue: 0,0:08:25.31,0:08:28.86,jp_text,NTP,0000,0000,0000,,Егер Ганта зеңбірегі менің қуыс жарқылымнан баяу болса
Dialogue: 0,0:08:25.31,0:08:28.86,Float_jp,NTP,0000,0000,0000,,Көрінбейтін қара
Dialogue: 0,0:08:29.07,0:08:30.69,jp_text,NTP,0000,0000,0000,,Бұл бақытты өлім жазасы.
Dialogue: 0,0:08:31.94,0:08:33.86,jp_text,NTP,0000,0000,0000,,Жылдамдаудан басқа амалымыз жоқ.
Dialogue: 0,0:08:34.32,0:08:36.91,jp_text,NTP,0000,0000,0000,,Кел мені ұр, Ганта Игараши.
Dialogue: 0,0:08:57.43,0:08:58.39,jp_text,NTP,0000,0000,0000,,Сіз елді дүр сілкіндіре білген ардагер орындаушы ретінде әйгілісіз, иә?
Dialogue: 0,0:08:59.35,0:09:00.31,jp_text,NTP,0000,0000,0000,,Иә Келесі
Dialogue: 0,0:09:01.22,0:09:02.73,jp_text,NTP,0000,0000,0000,,Тезірек толтырыңыз
Dialogue: 0,0:09:05.94,0:09:06.90,jp_text,NTP,0000,0000,0000,,Темеха
Dialogue: 0,0:09:06.98,0:09:08.52,jp_text,NTP,0000,0000,0000,,Сіз Широ-чанды білмейсіз бе?
Dialogue: 0,0:09:09.31,0:09:10.61,jp_text,NTP,0000,0000,0000,,«Күлдіршін»
Dialogue: 0,0:09:10.86,0:09:13.37,jp_text,NTP,0000,0000,0000,,Ол Ганта Игарашиді ұрып-соғатынын айтты.
Dialogue: 0,0:09:13.43,0:09:15.49,jp_text,NTP,0000,0000,0000,,Ол секірді.
Dialogue: 0,0:09:15.95,0:09:18.03,jp_text,NTP,0000,0000,0000,,Широның досы ма?
Dialogue: 0,0:09:19.49,0:09:21.04,jp_text,NTP,0000,0000,0000,,Біраз уақыт өтті. «Қарға».
Dialogue: 0,0:09:21.41,0:09:22.37,jp_text,NTP,0000,0000,0000,,Қалайсың?
Dialogue: 0,0:09:22.62,0:09:24.83,jp_text,NTP,0000,0000,0000,,Сіз кенет жоғалып кеттіңіз
Dialogue: 0,0:09:25.29,0:09:26.46,jp_text,NTP,0000,0000,0000,,Сіз не істедіңіз?
Dialogue: 0,0:09:27.58,0:09:29.96,jp_text,NTP,0000,0000,0000,,Кешіріңіз, мен аздап өлдім.
Dialogue: 0,0:09:38.84,0:09:40.35,jp_text,NTP,0000,0000,0000,,Менің ұрысуға ниетім жоқ.
Dialogue: 0,0:09:40.43,0:09:43.22,jp_text,NTP,0000,0000,0000,,Мені қатты жақсы көретініңізге қуаныштымын.
Dialogue: 0,0:09:43.81,0:09:45.98,jp_text,NTP,0000,0000,0000,,Сіз сондай кейіпкер болдыңыз ба?
Dialogue: 0,0:09:49.52,0:09:50.90,jp_text,NTP,0000,0000,0000,,Енді...
Dialogue: 0,0:09:51.44,0:09:53.28,jp_text,NTP,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:09:53.44,0:09:54.74,jp_text,NTP,0000,0000,0000,,«Күлдіршін»
Dialogue: 0,0:09:55.49,0:09:58.74,jp_text,NTP,0000,0000,0000,,Ол ең күшті «Өлі адам» ретінде белгілі шайқас фанаты.
Dialogue: 0,0:10:00.70,0:10:02.66,jp_text,NTP,0000,0000,0000,,Менімен де көп нәрсе болып жатыр.
Dialogue: 0,0:10:04.04,0:10:06.71,jp_text,NTP,0000,0000,0000,,Енді мен ең әлсіз «өлі адаммын»
Dialogue: 0,0:10:07.37,0:10:09.63,jp_text,NTP,0000,0000,0000,,Маған осынша қызмет етіңізші.
Dialogue: 0,0:10:10.88,0:10:12.34,jp_text,NTP,0000,0000,0000,,Сіз де өзіңізді жалай аласыз.
Dialogue: 0,0:10:15.80,0:10:17.72,jp_text,NTP,0000,0000,0000,,Эй, «Тоқылдақ».
Dialogue: 0,0:10:22.81,0:10:24.60,jp_text,NTP,0000,0000,0000,,Бұл жігіт қазір арнайы дайындықтан өтіп жатыр.
Dialogue: 0,0:10:25.06,0:10:27.18,jp_text,NTP,0000,0000,0000,,Қанның бір тамшысы да босқа кетпейді.
Dialogue: 0,0:10:27.94,0:10:29.81,jp_text,NTP,0000,0000,0000,,Иә, дұрыс.
Dialogue: 0,0:10:30.19,0:10:31.90,jp_text,NTP,0000,0000,0000,,Сіз іздеген әйел
Dialogue: 0,0:10:31.90,0:10:33.69,jp_text,NTP,0000,0000,0000,,Мен бұл жігіттің орнына келмейтін сияқтымын.
Dialogue: 0,0:10:34.02,0:10:35.11,jp_text,NTP,0000,0000,0000,,Басқа ештеңені болжамаңыз
Dialogue: 0,0:10:36.32,0:10:38.03,jp_text,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:10:38.24,0:10:41.41,jp_text,NTP,0000,0000,0000,,Ал, мен «Күлдіршінмін»
Dialogue: 0,0:10:41.53,0:10:42.66,jp_text,NTP,0000,0000,0000,,Сакигами Тото
Dialogue: 0,0:10:43.08,0:10:44.45,jp_text,NTP,0000,0000,0000,,Мені Тото деп атаңыз
Dialogue: 0,0:10:46.08,0:10:47.20,jp_text,NTP,0000,0000,0000,,Бұл Ганта
Dialogue: 0,0:10:47.62,0:10:49.75,jp_text,NTP,0000,0000,0000,,Танысқаныма қуаныштымын «Тоқылдақ»
Dialogue: 0,0:10:50.54,0:10:52.08,jp_text,NTP,0000,0000,0000,,Бұл Широ
Dialogue: 0,0:11:05.85,0:11:10.10,jp_text,NTP,0000,0000,0000,,Шыбындардың қалдықтары әлі де айналып жүрген сияқты, Генкаку мырза.
Dialogue: 0,0:11:10.94,0:11:13.06,jp_text,NTP,0000,0000,0000,,Уақытты өлтіруге жақсы
Dialogue: 0,0:11:14.44,0:11:17.94,jp_text,NTP,0000,0000,0000,,Промоутер және жаңа директор болу да бос уақыт.
Dialogue: 0,0:11:19.15,0:11:22.74,jp_text,NTP,0000,0000,0000,,Мен жаңа ойыншықтар жасауға кірісуім керек.
Dialogue: 0,0:11:23.16,0:11:25.87,jp_text,NTP,0000,0000,0000,,Ойынды тез аяқтаңыз.
Dialogue: 0,0:11:26.49,0:11:29.33,jp_text,NTP,0000,0000,0000,,Түсіндім, жаңа директор мырза.
Dialogue: 0,0:11:32.04,0:11:34.54,jp_text,NTP,0000,0000,0000,,Мен де өзім қалаған құбыжықты алдым.
Dialogue: 0,0:11:39.72,0:11:40.80,jp_text,NTP,0000,0000,0000,,Неге мен?
Dialogue: 0,0:11:47.06,0:11:48.39,jp_text,NTP,0000,0000,0000,,Бұл қандай дыбыс?
Dialogue: 0,0:11:48.93,0:11:53.69,jp_text,NTP,0000,0000,0000,,Гүлдеген қызыл гүлдің дыбысы
Dialogue: 0,0:12:06.58,0:12:08.79,jp_text,NTP,0000,0000,0000,,Хорда бұрышының ұзындығы Сіз не істеп жатырсыз?
Dialogue: 0,0:12:09.33,0:12:11.33,jp_text,NTP,0000,0000,0000,,Содан бері мен үзілісте болдым.
Dialogue: 0,0:12:11.66,0:12:13.71,jp_text,NTP,0000,0000,0000,,Олай десеңіз, Сато көрінбейді.
Dialogue: 0,0:12:22.26,0:12:23.09,jp_text,NTP,0000,0000,0000,,Тынышталыңыз
Dialogue: 0,0:12:23.47,0:12:25.39,jp_text,NTP,0000,0000,0000,,Бұдан былай бәрі нәтижеге байланысты.
Dialogue: 0,0:12:25.59,0:12:27.01,jp_text,NTP,0000,0000,0000,,Күте тұрыңыз, Наги.
Dialogue: 0,0:12:30.02,0:12:31.48,jp_text,NTP,0000,0000,0000,,Сіз
Dialogue: 0,0:12:34.10,0:12:35.27,jp_text,NTP,0000,0000,0000,,Бостандық тізбектері?
Dialogue: 0,0:12:34.10,0:12:35.27,Float_jp,NTP,0000,0000,0000,,Шрамдық тізбек
Dialogue: 0,0:12:35.94,0:12:37.02,jp_text,NTP,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:12:38.07,0:12:39.52,jp_text,NTP,0000,0000,0000,,Бұл қай жерде?
Dialogue: 0,0:12:39.65,0:12:41.03,jp_text,NTP,0000,0000,0000,,Мен қателік жібердім бе?
Dialogue: 0,0:12:41.07,0:12:42.53,jp_text,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:42.69,0:12:44.24,jp_text,NTP,0000,0000,0000,,Менің мұндай жерге келгім келмейді.
Dialogue: 0,0:12:44.78,0:12:47.37,jp_text,NTP,0000,0000,0000,,Саған не болды?
Dialogue: 0,0:12:48.49,0:12:51.45,jp_text,NTP,0000,0000,0000,,Бұл менің гитарамды сындырған ақ әйел емес пе?
Dialogue: 0,0:12:51.95,0:12:54.41,jp_text,NTP,0000,0000,0000,,Мен адасып кеткен сияқтымын.
Dialogue: 0,0:12:54.50,0:12:55.83,jp_text,NTP,0000,0000,0000,,Мен сені бірден үйге жіберемін.
Dialogue: 0,0:12:56.04,0:12:57.17,jp_text,NTP,0000,0000,0000,,Және
Dialogue: 0,0:13:03.51,0:13:05.43,jp_text,NTP,0000,0000,0000,,Бір шыбын ба?
Dialogue: 0,0:13:05.76,0:13:09.26,jp_text,NTP,0000,0000,0000,,Сөйлессең түсінесің. «Ойын ережесін бұзу»
Dialogue: 0,0:13:16.65,0:13:19.19,jp_text,NTP,0000,0000,0000,,Уақыт келді емес пе?
Dialogue: 0,0:13:19.73,0:13:22.82,jp_text,NTP,0000,0000,0000,,Әлі бір сағат қалды, сәл ғана көп.
Dialogue: 0,0:13:23.03,0:13:26.45,jp_text,NTP,0000,0000,0000,,Жоқ, мен осында құлап қаламын және бұл соңы болады.
Dialogue: 0,0:13:26.49,0:13:27.53,jp_text,NTP,0000,0000,0000,,Бұл күз.
Dialogue: 0,0:13:28.49,0:13:29.49,jp_text,NTP,0000,0000,0000,,Чижи-сан
Dialogue: 0,0:13:30.62,0:13:32.83,jp_text,NTP,0000,0000,0000,,Мен олардың операцияларына қосылған кезде
Dialogue: 0,0:13:33.00,0:13:35.29,jp_text,NTP,0000,0000,0000,,Бірінші болып өліңіз
Dialogue: 0,0:13:35.75,0:13:37.33,jp_text,NTP,0000,0000,0000,,Қай жолда бекер өлер едің?
Dialogue: 0,0:13:37.42,0:13:38.13,jp_text,NTP,0000,0000,0000,,Оны тоқтатыңыз
Dialogue: 0,0:13:39.58,0:13:40.67,jp_text,NTP,0000,0000,0000,,Бұл...
Dialogue: 0,0:13:48.34,0:13:49.59,jp_text,NTP,0000,0000,0000,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:13:52.60,0:13:54.39,jp_text,NTP,0000,0000,0000,,Жоқ, оқ кішкентай.
Dialogue: 0,0:13:54.68,0:13:55.85,jp_text,NTP,0000,0000,0000,,Қан жеткіліксіз
Dialogue: 0,0:14:09.74,0:14:11.28,jp_text,NTP,0000,0000,0000,,Эй, бұл оқ
Dialogue: 0,0:14:14.33,0:14:15.37,jp_text,NTP,0000,0000,0000,,Бұл анемия ма?
Dialogue: 0,0:14:22.71,0:14:25.38,jp_text,NTP,0000,0000,0000,,Бостандық тізбегі
Dialogue: 0,0:14:22.71,0:14:25.38,Float_jp,NTP,0000,0000,0000,,Шрам тізбегі
Dialogue: 0,0:14:26.01,0:14:26.97,jp_text,NTP,0000,0000,0000,,монах
Dialogue: 0,0:14:28.22,0:14:30.76,jp_text,NTP,0000,0000,0000,,Сіз сабағыңызды әлі үйренбеген сияқтысыз.
Dialogue: 0,0:14:31.05,0:14:32.85,jp_text,NTP,0000,0000,0000,,Бас тарту – ағартушылық
Dialogue: 0,0:14:33.22,0:14:35.47,jp_text,NTP,0000,0000,0000,,Уағыз айту жақсы.
Dialogue: 0,0:14:36.39,0:14:39.39,jp_text,NTP,0000,0000,0000,,Мен тег пен жасырынбақты жек көремін.
Dialogue: 0,0:14:40.35,0:14:42.77,jp_text,NTP,0000,0000,0000,,Мен қазір бұл жігіттерді өлтіремін
Dialogue: 0,0:14:43.94,0:14:47.24,jp_text,NTP,0000,0000,0000,,Сіз маған көмекке келіп, өлтіресіз бе? Әлде қашып құтыла алмағандықтан өлтіресің бе?
Dialogue: 0,0:14:47.36,0:14:50.82,jp_text,NTP,0000,0000,0000,,Мен сізге өлім жазасына кесілген тұтқын ретінде өз соңыңызды таңдауға рұқсат етемін.
Dialogue: 0,0:14:53.03,0:14:54.83,jp_text,NTP,0000,0000,0000,,Барлығы келе жатқан жоқ.
Dialogue: 0,0:14:54.99,0:14:56.37,jp_text,NTP,0000,0000,0000,,Ешқашан далаға шықпаңыз
Dialogue: 0,0:14:56.70,0:14:58.83,jp_text,NTP,0000,0000,0000,,Наги мен үмітімізді қосыңыз.
Dialogue: 0,0:14:58.83,0:14:59.41,jp_text,NTP,0000,0000,0000,,Широ
Dialogue: 0,0:15:05.13,0:15:07.88,jp_text,NTP,0000,0000,0000,,Бірінші оқ, Ганта Игараши
Dialogue: 0,0:15:08.47,0:15:11.84,jp_text,NTP,0000,0000,0000,,Өзіңіздің сүйікті «Зуппаши» мылтығын алыңыз.
Dialogue: 0,0:15:22.90,0:15:25.44,jp_text,NTP,0000,0000,0000,,Қарако жігіт жалғыз
Dialogue: 0,0:15:28.78,0:15:30.61,jp_text,NTP,0000,0000,0000,,Мына бала ақымақ.
Dialogue: 0,0:15:31.61,0:15:32.57,jp_text,NTP,0000,0000,0000,,Қарако-сан
Dialogue: 0,0:15:36.16,0:15:38.83,jp_text,NTP,0000,0000,0000,,Біз не істеуіміз керек
Dialogue: 0,0:15:42.67,0:15:43.54,jp_text,NTP,0000,0000,0000,,Сыртта
Dialogue: 0,0:15:47.00,0:15:47.96,jp_text,NTP,0000,0000,0000,,Міндетті түрде.
Dialogue: 0,0:15:53.59,0:15:56.18,jp_text,NTP,0000,0000,0000,,Боқ бұл қайсы
Dialogue: 0,0:15:56.72,0:15:58.77,jp_text,NTP,0000,0000,0000,,Қарако-сан және басқалары, мені жайына қалдыр.
Dialogue: 0,0:15:59.02,0:16:01.18,jp_text,NTP,0000,0000,0000,,Сіз мұны пайдасыз деп ойладыңыз ба?
Dialogue: 0,0:16:01.64,0:16:02.56,jp_text,NTP,0000,0000,0000,,Барлығы
Dialogue: 0,0:16:05.94,0:16:06.77,jp_text,NTP,0000,0000,0000,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:16:12.65,0:16:14.95,jp_text,NTP,0000,0000,0000,,Иә, болды, енді берілме.
Dialogue: 0,0:16:26.59,0:16:29.75,jp_text,NTP,0000,0000,0000,,Дыбыс жылдамдығынан асып кету деген осы.
Dialogue: 0,0:16:32.01,0:16:32.92,jp_text,NTP,0000,0000,0000,,Минадзуки
Dialogue: 0,0:16:33.76,0:16:36.39,jp_text,NTP,0000,0000,0000,,Қабір сақтаушының жасырынатын жері сол жақта.
Dialogue: 0,0:16:33.76,0:16:36.39,Float_jp,NTP,0000,0000,0000,,Жетекші
Dialogue: 0,0:16:37.30,0:16:41.64,jp_text,NTP,0000,0000,0000,,Таку: Сіз басқа адамның қайда екенін тексермей жүгіріп кеттіңіз.
Dialogue: 0,0:16:43.64,0:16:45.85,jp_text,NTP,0000,0000,0000,,Мен жазалау ойыны үшін қарызымды өтедім.
Dialogue: 0,0:16:46.35,0:16:48.27,jp_text,NTP,0000,0000,0000,,Минадзуки, сен де.
Dialogue: 0,0:16:48.32,0:16:51.36,jp_text,NTP,0000,0000,0000,,Мені түрмеден қашып кеткендей кейіп танытқан «Үкілер» қызықтырмайды.
Dialogue: 0,0:16:51.82,0:16:53.01,jp_text,NTP,0000,0000,0000,,Тіпті «Өлі адам» да емес
Dialogue: 0,0:16:53.19,0:16:55.78,jp_text,NTP,0000,0000,0000,,Бір ақымақтың да жараланып қала беретіні бар.
Dialogue: 0,0:16:56.49,0:16:59.53,jp_text,NTP,0000,0000,0000,,Ал сіздей емес, маған жалған айып тағылған жоқ.
Dialogue: 0,0:17:00.83,0:17:01.50,jp_text,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:17:01.95,0:17:04.83,jp_text,NTP,0000,0000,0000,,Бірақ мен сіздің шығуыңызға міндетті түрде көз жеткіземін.
Dialogue: 0,0:17:05.50,0:17:07.42,jp_text,NTP,0000,0000,0000,,Меніңше, осы дүниеде соғыссыз өмір сүре алмайтын адамдар бар.
Dialogue: 0,0:17:13.63,0:17:14.67,jp_text,NTP,0000,0000,0000,,Барка
Dialogue: 0,0:17:30.98,0:17:34.24,jp_text,NTP,0000,0000,0000,,Барлығыңыз өтінемін
Dialogue: 0,0:17:36.86,0:17:37.70,jp_text,NTP,0000,0000,0000,,Сіз
Dialogue: 0,0:17:40.49,0:17:43.70,jp_text,NTP,0000,0000,0000,,Карако-сан Широ, мен саған қазір көмектесемін.
Dialogue: 0,0:17:44.29,0:17:45.25,jp_text,NTP,0000,0000,0000,,Ганта
Dialogue: 0,0:17:48.67,0:17:51.71,jp_text,NTP,0000,0000,0000,,Хмм, маған Гантаның көмегі қажет емес.
Dialogue: 0,0:17:53.34,0:17:55.42,jp_text,NTP,0000,0000,0000,,Темера
Dialogue: 0,0:17:56.01,0:17:57.80,jp_text,NTP,0000,0000,0000,,Мына балаларды тоқтатыңыз.
Dialogue: 0,0:17:59.97,0:18:02.60,jp_text,NTP,0000,0000,0000,,Идиот, «Күнәнің бұтағы» жұмыс істей ме?
Dialogue: 0,0:18:03.14,0:18:05.64,jp_text,NTP,0000,0000,0000,,Қан аз, өткір
Dialogue: 0,0:18:15.69,0:18:16.57,jp_text,NTP,0000,0000,0000,,Жарайды.
Dialogue: 0,0:18:17.24,0:18:17.95,jp_text,NTP,0000,0000,0000,,Ганта
Dialogue: 0,0:18:18.07,0:18:18.95,jp_text,NTP,0000,0000,0000,,Ганта
Dialogue: 0,0:18:19.91,0:18:23.12,jp_text,NTP,0000,0000,0000,,Широ, жақсысың ба?
Dialogue: 0,0:18:24.12,0:18:25.12,jp_text,NTP,0000,0000,0000,,Ганта
Dialogue: 0,0:18:30.67,0:18:32.09,jp_text,NTP,0000,0000,0000,,Ганта
Dialogue: 0,0:18:44.39,0:18:47.18,jp_text,NTP,0000,0000,0000,,Сіздің мақсатыңызды елемей жатқаныңызға сене алмаймын.
Dialogue: 0,0:18:47.64,0:18:49.27,jp_text,NTP,0000,0000,0000,,Сен ақымақсың.
Dialogue: 0,0:18:53.32,0:18:55.86,jp_text,NTP,0000,0000,0000,,Мақсаты әркім үшін...
Dialogue: 0,0:18:56.86,0:18:58.65,jp_text,NTP,0000,0000,0000,,Алғашында неге екенін түсінбесем де, менде жеккөру сезімі пайда болды—
Dialogue: 0,0:18:58.95,0:18:59.74,jp_text,NTP,0000,0000,0000,,Широ
Dialogue: 0,0:19:04.03,0:19:05.54,jp_text,NTP,0000,0000,0000,,Бір ғана бала бар ма?
Dialogue: 0,0:19:05.95,0:19:07.41,jp_text,NTP,0000,0000,0000,,Бұл аздап қанағаттандырмайды.
Dialogue: 0,0:19:08.25,0:19:11.63,jp_text,NTP,0000,0000,0000,,Бұл олардың өзінше байыпты болғанын білдіреді.
Dialogue: 0,0:19:12.92,0:19:15.75,jp_text,NTP,0000,0000,0000,,Бұл жай ғана ақымақ болған сияқты.
Dialogue: 0,0:19:16.88,0:19:20.47,jp_text,NTP,0000,0000,0000,,Ендеше, осы үмітсіздік концертін бастайық.
Dialogue: 0,0:19:40.40,0:19:41.91,jp_text,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:19:42.86,0:19:43.70,jp_text,NTP,0000,0000,0000,,Мүмкін тыныс алу әдістерін тым көп қолданғандықтан шығар…
Dialogue: 0,0:19:43.87,0:19:46.62,jp_text,NTP,0000,0000,0000,,Жақынбаңыз
Dialogue: 0,0:19:49.16,0:19:52.04,jp_text,NTP,0000,0000,0000,,Менің енді есі дұрыс.
Dialogue: 0,0:19:58.96,0:20:01.84,jp_text,NTP,0000,0000,0000,,Не болды, бәріміз сыртқа шығайық.
Dialogue: 0,0:20:01.97,0:20:03.64,jp_text,NTP,0000,0000,0000,,Бала күтіп тұр, солай ма?
Dialogue: 0,0:20:04.59,0:20:05.47,jp_text,NTP,0000,0000,0000,,Балалар?
Dialogue: 0,0:20:12.81,0:20:13.85,jp_text,NTP,0000,0000,0000,,Мүмкін тыныс алу әдістерін тым көп қолданғандықтан шығар…
Dialogue: 0,0:20:18.15,0:20:19.90,jp_text,NTP,0000,0000,0000,,Ештеңе жоқ, солай ма?
Dialogue: 0,0:20:21.44,0:20:26.37,jp_text,NTP,0000,0000,0000,,Әйелім баламызға жүкті болып, ішін жіп мүйізімен ойып алып, қайтыс болды.
Dialogue: 0,0:20:27.62,0:20:30.45,jp_text,NTP,0000,0000,0000,,Баланың тірі болуы мүмкін емес, солай ма?
Dialogue: 0,0:20:34.04,0:20:36.46,jp_text,NTP,0000,0000,0000,,Сондықтан мен жек көрдім
Dialogue: 0,0:20:37.34,0:20:39.88,jp_text,NTP,0000,0000,0000,,Менің балам
Dialogue: 0,0:20:43.13,0:20:46.51,jp_text,NTP,0000,0000,0000,,Мен саған жамандық жасағаныма сенімдімін.
Dialogue: 0,0:20:46.89,0:20:48.97,jp_text,NTP,0000,0000,0000,,Менің де көңілім қалды.
Dialogue: 0,0:20:49.10,0:20:51.73,jp_text,NTP,0000,0000,0000,,«Өлгендердің» асыл балалары
Dialogue: 0,0:20:55.10,0:20:57.19,jp_text,NTP,0000,0000,0000,,Мен мұны осылай жасадым
Dialogue: 0,0:21:14.41,0:21:16.71,jp_text,NTP,0000,0000,0000,,Мен өзіме оралдым.
Dialogue: 0,0:21:16.75,0:21:20.04,jp_text,NTP,0000,0000,0000,,Сондықтан мен тірі адамдарды жек көрмей тұра алмаймын.
Dialogue: 0,0:21:20.09,0:21:23.55,jp_text,NTP,0000,0000,0000,,Неліктен әйелім баламыздың өліміне жол берді?
Dialogue: 0,0:21:24.30,0:21:27.55,jp_text,NTP,0000,0000,0000,,Мен неге тірімін?
Dialogue: 0,0:21:28.01,0:21:30.51,jp_text,NTP,0000,0000,0000,,Мен үмітсіздікті білдім
Dialogue: 0,0:21:38.19,0:21:38.98,jp_text,NTP,0000,0000,0000,,Мүмкін тыныс алу әдістерін тым көп қолданғандықтан шығар…
Dialogue: 0,0:21:43.86,0:21:47.61,jp_text,NTP,0000,0000,0000,,Мен өте әлсіз болдым
Dialogue: 0,0:22:01.09,0:22:01.96,jp_text,NTP,0000,0000,0000,,Наги-сан
Dialogue: 0,0:22:19.65,0:22:23.44,jp_text,NTP,0000,0000,0000,,Менің идеал Шура бол, «Үкі»
Dialogue: 0,0:22:23.94,0:22:27.20,jp_text,NTP,0000,0000,0000,,Барлығын өлтіріңіз, бәрін сақтаңыз
Dialogue: 0,0:24:12.13,0:24:14.09,jp_text,NTP,0000,0000,0000,,Нағыз үмітсіздікке дейін
Dialogue: 0,0:24:14.09,0:24:16.80,jp_text,NTP,0000,0000,0000,,Мен тіпті дәрменсіздікті сезе алмаймын
Dialogue: 0,0:24:17.35,0:24:18.72,jp_text,NTP,0000,0000,0000,,Нағыз тұңғиық
Dialogue: 0,0:24:19.02,0:24:20.85,jp_text,NTP,0000,0000,0000,,Күресуге уақыт бермеңіз
Dialogue: 0,0:24:21.43,0:24:23.27,jp_text,NTP,0000,0000,0000,,Егер сіз бұл жеңілдік деп ойласаңыз
Dialogue: 0,0:24:23.56,0:24:25.02,jp_text,NTP,0000,0000,0000,,Тек ұйықтап қал.
Dialogue: 0,0:22:49.26,0:22:52.30,EDJP,NTP,0000,0000,0000,,Рюсей қара және түн
Dialogue: 0,0:22:52.35,0:22:55.81,EDJP,NTP,0000,0000,0000,,Мен мәңгілікке жылауымды тоқтата алмаймын
Dialogue: 0,0:22:55.97,0:23:04.40,EDJP,NTP,0000,0000,0000,,Мен бұл сандырақ дүниені жек көрдім.
Dialogue: 0,0:23:04.44,0:23:12.82,EDJP,NTP,0000,0000,0000,,Мен бұл лабиринттен шығусыз құтылғым келеді.
Dialogue: 0,0:23:12.95,0:23:16.95,EDJP,NTP,0000,0000,0000,,Мен бостандықты қаладым
Dialogue: 0,0:23:18.91,0:23:26.13,EDJP,NTP,0000,0000,0000,,Қол ұстасып, аспанға қара
Dialogue: 0,0:23:26.55,0:23:34.05,EDJP,NTP,0000,0000,0000,,Мен кешегіден өзгердім
Dialogue: 0,0:23:34.35,0:23:40.89,EDJP,NTP,0000,0000,0000,,Жылтыр Жылтыр Жарқыраған жұлдыздар шексіз
Dialogue: 0,0:23:41.10,0:23:49.40,EDJP,NTP,0000,0000,0000,,Бұл дүние сондай әдемі
Dialogue: 0,0:23:49.65,0:23:56.33,EDJP,NTP,0000,0000,0000,,Жарқыраған Жарқыраған Ай сәулесі Үмітке толы
Dialogue: 0,0:23:56.33,0:24:04.33,EDJP,NTP,0000,0000,0000,,Бұл дүние өте керемет
Dialogue: 0,0:24:04.33,0:24:07.00,EDJP,NTP,0000,0000,0000,,Менің ойымша.
Dialogue: 0,0:00:00.00,0:00:00.00,*Default,NTP,0000,0000,0000,,--------------------------Қызметкерлер------------------------------------
Dialogue: 0,0:24:11.22,0:24:13.22,staff,NTP,0000,0000,0000,,SGS Shukosha субтитрлер өндірісі http://blog.sgsub.com
Dialogue: 0,0:24:13.22,0:24:15.22,staff,NTP,0000,0000,0000,,Аударма: Муюн но Цукиёши Изайой Өңдеген: Хиро Хиби Хитомура
Dialogue: 0,0:24:15.22,0:24:17.22,staff,NTP,0000,0000,0000,,Жапон тілі: Киоку алаңы Өрт уақыты: Менмендік Кеш мезгіл: Қышқыл
Dialogue: 0,0:24:17.22,0:24:19.22,staff,NTP,0000,0000,0000,,BD жүйесі және дамуы: Daydream ынтымақтастық: DC
