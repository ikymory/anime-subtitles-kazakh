Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:14.38,0:01:18.76,op,NTP,0000,0000,0000,,Ақыл мен шындықты қатаң бақылау
Dialogue: 0,0:01:18.80,0:01:23.18,op,NTP,0000,0000,0000,,Өзімді кесіп, олардың ессіздігі үшін айқайлаймын
Dialogue: 0,0:01:23.22,0:01:27.60,op,NTP,0000,0000,0000,,Ешқашан бітпейтін қорқынышты түспен ояныңыз
Dialogue: 0,0:01:27.60,0:01:32.32,op,NTP,0000,0000,0000,,Бұл бұралған бас жоспардың басты тартымдылығы
Dialogue: 0,0:01:45.00,0:01:49.38,op,NTP,0000,0000,0000,,Мен сенің өлген адамың боламын
Dialogue: 0,0:01:49.42,0:01:53.71,op,NTP,0000,0000,0000,,Менің қолымдағы қаннан басқа ештеңе жоқ
Dialogue: 0,0:01:53.75,0:01:58.09,op,NTP,0000,0000,0000,,Сіздің ғажайыптар елінде қалдыңыз
Dialogue: 0,0:01:58.30,0:02:02.47,op,NTP,0000,0000,0000,,Мен де мен сияқты сені қансыратқым келеді
Dialogue: 0,0:02:02.51,0:02:06.98,op,NTP,0000,0000,0000,,Ендеше мені өлген адам ет
Dialogue: 0,0:02:07.02,0:02:11.36,op,NTP,0000,0000,0000,,Тамырымда тек умен
Dialogue: 0,0:02:11.40,0:02:15.74,op,NTP,0000,0000,0000,,Сіздің ғажайыптар елінде қалдыңыз
Dialogue: 0,0:02:15.78,0:02:18.07,op,NTP,0000,0000,0000,,Мен жасауым керек шайқаста қалдым
Dialogue: 0,0:02:18.07,0:02:20.74,op,NTP,0000,0000,0000,,Мен де сені мен сияқты қанды қыламын
Dialogue: 0,0:22:49.26,0:22:52.35,EDJP,NTP,0000,0000,0000,,Рюсей қара және түн
Dialogue: 0,0:22:52.39,0:22:55.89,EDJP,NTP,0000,0000,0000,,Мен мәңгілікке жылауды тоқтата алмаймын
Dialogue: 0,0:22:55.97,0:23:04.44,EDJP,NTP,0000,0000,0000,,Мен бұл сандырақ дүниені жек көрдім
Dialogue: 0,0:23:04.48,0:23:12.82,EDJP,NTP,0000,0000,0000,,Мен бұл лабиринттен шығусыз құтылғым келеді.
Dialogue: 0,0:23:13.03,0:23:16.83,EDJP,NTP,0000,0000,0000,,Мен бостандықты қаладым
Dialogue: 0,0:23:19.00,0:23:26.09,EDJP,NTP,0000,0000,0000,,Қол ұстасып, аспанға қара
Dialogue: 0,0:23:26.63,0:23:34.14,EDJP,NTP,0000,0000,0000,,Мен кешегіден ерекше болдым
Dialogue: 0,0:23:34.43,0:23:41.02,EDJP,NTP,0000,0000,0000,,Жылтыр жылтыр Жарқыраған жұлдыздар шексіз
Dialogue: 0,0:23:41.14,0:23:49.40,EDJP,NTP,0000,0000,0000,,Бұл дүние сондай әдемі
Dialogue: 0,0:23:49.61,0:23:56.28,EDJP,NTP,0000,0000,0000,,Жарқыраған Жарқыраған Ай сәулесі Үмітке толы
Dialogue: 0,0:23:56.37,0:24:04.25,EDJP,NTP,0000,0000,0000,,Бұл дүние өте керемет
Dialogue: 0,0:24:04.38,0:24:06.96,EDJP,NTP,0000,0000,0000,,Менің ойымша.
Dialogue: 0,0:00:03.94,0:00:08.02,jp_text,NTP,0000,0000,0000,,Кеше мен сенің сүйікті пудингіңді сатып алдым.
Dialogue: 0,0:00:08.23,0:00:10.86,jp_text,NTP,0000,0000,0000,,Бұл менің әдеттегі жасырын сөреде.
Dialogue: 0,0:00:11.40,0:00:13.07,jp_text,NTP,0000,0000,0000,,Мен тәттілерді жек көремін
Dialogue: 0,0:00:14.61,0:00:16.78,jp_text,NTP,0000,0000,0000,,Мен оны ұнататын адам емеспін
Dialogue: 0,0:00:20.08,0:00:22.16,jp_text,NTP,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,0:00:28.00,0:00:30.67,jp_text,NTP,0000,0000,0000,,Келесі шайқас!
Dialogue: 0,0:00:32.51,0:00:36.43,jp_text,NTP,0000,0000,0000,,Өлмей, өле берейік.
Dialogue: 0,0:02:25.75,0:02:28.04,jp_text,NTP,0000,0000,0000,,Хицудзи-кун, жақсысың ба?
Dialogue: 0,0:02:31.08,0:02:32.71,jp_text,NTP,0000,0000,0000,,Ганта - өңі бар...
Dialogue: 0,0:02:33.13,0:02:36.46,jp_text,NTP,0000,0000,0000,,Уайымдама, мен көп жеген жоқпын, қан қолдандым.
Dialogue: 0,0:02:36.96,0:02:38.42,jp_text,NTP,0000,0000,0000,,Менің басым айналып кетті.
Dialogue: 0,0:02:39.59,0:02:42.51,jp_text,NTP,0000,0000,0000,,Кешіріңіз, мен Хицудзи-кунның сіңлісімін.
Dialogue: 0,0:02:44.47,0:02:46.52,jp_text,NTP,0000,0000,0000,,Мен бұл жігітті қорғауым керек деп ойладым.
Dialogue: 0,0:02:47.18,0:02:49.23,jp_text,NTP,0000,0000,0000,,Анам қайтыс болғаннан бері
Dialogue: 0,0:03:06.20,0:03:07.04,jp_text,NTP,0000,0000,0000,,Минадзуки!
Dialogue: 0,0:03:22.55,0:03:23.39,jp_text,NTP,0000,0000,0000,,Минадзуки
Dialogue: 0,0:03:25.81,0:03:26.51,jp_text,NTP,0000,0000,0000,,Миназуки…
Dialogue: 0,0:03:28.18,0:03:29.23,jp_text,NTP,0000,0000,0000,,Үлкен аға
Dialogue: 0,0:03:41.49,0:03:42.15,jp_text,NTP,0000,0000,0000,,Хицудзи-кун!
Dialogue: 0,0:03:43.49,0:03:45.41,jp_text,NTP,0000,0000,0000,,Хицудзи-кун, жақсысың ба?
Dialogue: 0,0:03:46.20,0:03:49.20,jp_text,NTP,0000,0000,0000,,Иә, бұл маңызды емес.
Dialogue: 0,0:03:50.50,0:03:53.87,jp_text,NTP,0000,0000,0000,,Сәлем! Қайдасың, өтірікші?
Dialogue: 0,0:03:56.63,0:03:59.34,jp_text,NTP,0000,0000,0000,,Ол сенің ағаң ғой.
Dialogue: 0,0:04:02.59,0:04:03.47,jp_text,NTP,0000,0000,0000,,Польнареффтің Рух толқыны сонша жылдам болатынын—
Dialogue: 0,0:04:15.56,0:04:17.40,jp_text,NTP,0000,0000,0000,,Оны ақырын шығарыңыз.
Dialogue: 0,0:04:21.49,0:04:22.90,jp_text,NTP,0000,0000,0000,,Біртүрлі бауырлар
Dialogue: 0,0:04:25.57,0:04:26.82,jp_text,NTP,0000,0000,0000,,Жақсы иіс шығады.
Dialogue: 0,0:04:30.37,0:04:31.83,jp_text,NTP,0000,0000,0000,,Бұл примула хош иісі.
Dialogue: 0,0:04:37.54,0:04:38.79,jp_text,NTP,0000,0000,0000,,Жарайды, Минадзуки.
Dialogue: 0,0:04:39.34,0:04:44.09,jp_text,NTP,0000,0000,0000,,Менмін, мен жалғызмын, мүлде
Dialogue: 0,0:04:46.26,0:04:49.97,jp_text,NTP,0000,0000,0000,,Сіз сенімдісіз бе? Ал мен
Dialogue: 0,0:04:49.97,0:04:51.93,jp_text,NTP,0000,0000,0000,,Қарияға келгенде мен де кінәлімін.
Dialogue: 0,0:04:53.02,0:04:55.77,jp_text,NTP,0000,0000,0000,,Сіз сол кездегідейсіз.
Dialogue: 0,0:04:55.77,0:04:57.35,jp_text,NTP,0000,0000,0000,,Тек мені ұятқа қалдырғым келді.
Dialogue: 0,0:04:57.98,0:05:00.73,jp_text,NTP,0000,0000,0000,,Мен «күнә тармағының» күшін толық түсінбегендіктен
Dialogue: 0,0:05:01.23,0:05:02.23,jp_text,NTP,0000,0000,0000,,Мен сені өлтіргім келмейді
Dialogue: 0,0:05:02.23,0:05:05.15,jp_text,NTP,0000,0000,0000,,Уайымдамаңыз, бұл сіздің істегеніңізді өзгертпейді.
Dialogue: 0,0:05:13.00,0:05:15.75,jp_text,NTP,0000,0000,0000,,Бұл қандай ауырсыну?
Dialogue: 0,0:05:28.01,0:05:28.93,jp_text,NTP,0000,0000,0000,,Широ
Dialogue: 0,0:05:33.47,0:05:35.64,jp_text,NTP,0000,0000,0000,,Бұл Широ
Dialogue: 0,0:05:36.89,0:05:38.23,jp_text,NTP,0000,0000,0000,,Бұл Широ болатын.
Dialogue: 0,0:05:47.28,0:05:48.99,jp_text,NTP,0000,0000,0000,,Мен бесік жырын естимін
Dialogue: 0,0:05:51.16,0:05:54.54,jp_text,NTP,0000,0000,0000,,«Ана қаз жүйесін» қайтадан қостыңыз ба?
Dialogue: 0,0:05:56.46,0:05:57.96,jp_text,NTP,0000,0000,0000,,Сол әннің жалғасы қандай?
Dialogue: 0,0:05:58.83,0:06:00.04,jp_text,NTP,0000,0000,0000,,Жалғасы бар ма?
Dialogue: 0,0:06:00.63,0:06:05.17,jp_text,NTP,0000,0000,0000,,Жалғасы болуы мүмкін емес
Dialogue: 0,0:06:08.97,0:06:11.18,jp_text,NTP,0000,0000,0000,,Широ, сен...
Dialogue: 0,0:06:14.93,0:06:19.85,jp_text,NTP,0000,0000,0000,,Бастапқы күнә -- тасталған жұмыртқа.
Dialogue: 0,0:06:14.93,0:06:19.85,Float_jp,NTP,0000,0000,0000,,Қайта жұмыртқа
Dialogue: 0,0:06:29.70,0:06:31.91,jp_text,NTP,0000,0000,0000,,Әрбір бірлік үшін зақымдану жағдайын қорытындылаңыз.
Dialogue: 0,0:06:32.45,0:06:34.62,jp_text,NTP,0000,0000,0000,,Сымды жасырмаңыз, оны мүмкіндігінше тез қосыңыз
Dialogue: 0,0:06:34.91,0:06:35.70,jp_text,NTP,0000,0000,0000,,Тезірек барайық
Dialogue: 0,0:06:36.41,0:06:38.62,jp_text,NTP,0000,0000,0000,,Мұндағы зиян да айтарлықтай үлкен.
Dialogue: 0,0:06:38.79,0:06:40.46,jp_text,NTP,0000,0000,0000,,Күтім зардап шеккендерге қарағанда бірінші орында.
Dialogue: 0,0:06:40.79,0:06:41.96,jp_text,NTP,0000,0000,0000,,Эй, сен мені мазалап тұрсың.
Dialogue: 0,0:06:43.54,0:06:44.67,jp_text,NTP,0000,0000,0000,,Иә! Ганта
Dialogue: 0,0:06:46.21,0:06:47.17,jp_text,NTP,0000,0000,0000,,Чижи-сан
Dialogue: 0,0:06:48.59,0:06:50.34,jp_text,NTP,0000,0000,0000,,Мен ойынды көп көріп отырдым.
Dialogue: 0,0:06:50.76,0:06:52.22,jp_text,NTP,0000,0000,0000,,Жарайсың бұл әйелге.
Dialogue: 0,0:06:53.05,0:06:54.81,jp_text,NTP,0000,0000,0000,,Иә? Не болды?
Dialogue: 0,0:06:55.47,0:06:56.85,jp_text,NTP,0000,0000,0000,,Кешіріңіз, Чижи-сан.
Dialogue: 0,0:06:57.77,0:06:59.48,jp_text,NTP,0000,0000,0000,,Мен үшін оң көзім...
Dialogue: 0,0:07:03.11,0:07:06.36,jp_text,NTP,0000,0000,0000,,Бұл жерде мұндай нәрселер жиі кездеседі, бұл туралы алаңдамаңыз.
Dialogue: 0,0:07:06.48,0:07:07.69,jp_text,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,0:07:07.82,0:07:09.57,jp_text,NTP,0000,0000,0000,,Бірақ сіз жеңсеңіз де
Dialogue: 0,0:07:09.70,0:07:11.61,jp_text,NTP,0000,0000,0000,,Өйткені, күресуге әлі де жол бар.
Dialogue: 0,0:07:12.57,0:07:14.83,jp_text,NTP,0000,0000,0000,,Сізде тым аз дағдылар бар.
Dialogue: 0,0:07:15.08,0:07:15.95,jp_text,NTP,0000,0000,0000,,Техника?
Dialogue: 0,0:07:16.41,0:07:18.12,jp_text,NTP,0000,0000,0000,,Мұның бәрі «мылтық таған» емес пе?
Dialogue: 0,0:07:18.83,0:07:20.66,jp_text,NTP,0000,0000,0000,,Мылтық...Таған
Dialogue: 0,0:07:20.96,0:07:22.63,jp_text,NTP,0000,0000,0000,,Бұл сіздің «күнә тармағының» атауы
Dialogue: 0,0:07:23.54,0:07:25.71,jp_text,NTP,0000,0000,0000,,Мен Зупаши деп ат қойдым.
Dialogue: 0,0:07:28.17,0:07:30.93,jp_text,NTP,0000,0000,0000,,Ум, мен бақыттымын.
Dialogue: 0,0:07:31.22,0:07:33.22,jp_text,NTP,0000,0000,0000,,Бұл одан да салқын
Dialogue: 0,0:07:33.39,0:07:34.47,jp_text,NTP,0000,0000,0000,,Жоқ, ред.
Dialogue: 0,0:07:35.47,0:07:38.02,jp_text,NTP,0000,0000,0000,,Мысалы, «Ace Man» техникасының атауы сияқты.
Dialogue: 0,0:07:38.27,0:07:40.81,jp_text,NTP,0000,0000,0000,,«Төмен серпіліс жауынгері»?
Dialogue: 0,0:07:41.60,0:07:42.65,jp_text,NTP,0000,0000,0000,,Сондай ностальгиялық
Dialogue: 0,0:07:43.35,0:07:46.15,jp_text,NTP,0000,0000,0000,,Бірақ мен бұл туралы көп білмеймін. Бұл қайта трансляциялау сериясы ма?
Dialogue: 0,0:07:46.61,0:07:49.07,jp_text,NTP,0000,0000,0000,,Жоқ, бұл жалға алынған шығар.
Dialogue: 0,0:07:49.82,0:07:53.03,jp_text,NTP,0000,0000,0000,,Кішкентай кезімде достарыммен «Ace Man» ойнайтынбыз.
Dialogue: 0,0:07:53.45,0:07:54.99,jp_text,NTP,0000,0000,0000,,Бұрынғы бір нәрсені еске түсіріңіз
Dialogue: 0,0:07:56.03,0:07:57.41,jp_text,NTP,0000,0000,0000,,Әрқашан көңілді...
Dialogue: 0,0:07:58.62,0:08:01.16,jp_text,NTP,0000,0000,0000,,Әй, бұл бір жақты...
Dialogue: 0,0:08:03.46,0:08:06.21,jp_text,NTP,0000,0000,0000,,Жоқ, Миназуки, мен жараға алаңдадым.
Dialogue: 0,0:08:08.96,0:08:11.42,jp_text,NTP,0000,0000,0000,,Бірікті, сен Cisco бейбақ.
Dialogue: 0,0:08:12.30,0:08:13.88,jp_text,NTP,0000,0000,0000,,Бұл ауыр жарақат емес.
Dialogue: 0,0:08:13.88,0:08:16.47,jp_text,NTP,0000,0000,0000,,Мен өзім душқа да түсе аламын.
Dialogue: 0,0:08:17.01,0:08:19.56,jp_text,NTP,0000,0000,0000,,Енді тезірек емханаға барыңыз.
Dialogue: 0,0:08:22.81,0:08:24.48,jp_text,NTP,0000,0000,0000,,Оған қарамаңыз
Dialogue: 0,0:08:28.61,0:08:29.61,jp_text,NTP,0000,0000,0000,,Чижи-сан
Dialogue: 0,0:08:31.53,0:08:33.40,jp_text,NTP,0000,0000,0000,,А, иә, есіме түсті.
Dialogue: 0,0:08:33.90,0:08:36.99,jp_text,NTP,0000,0000,0000,,Ганта Бұл баспен соққы бірден келді.
Dialogue: 0,0:08:38.74,0:08:41.70,jp_text,NTP,0000,0000,0000,,Хицудзи-кун, содан бері Широ не істеп жүр?
Dialogue: 0,0:08:42.08,0:08:43.25,jp_text,NTP,0000,0000,0000,,Біз бірге болдық, солай ма?
Dialogue: 0,0:08:44.25,0:08:47.08,jp_text,NTP,0000,0000,0000,,G корпусына кірген кезде біз бөлініп қаламыз.
Dialogue: 0,0:08:48.17,0:08:49.00,jp_text,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:08:50.63,0:08:51.38,jp_text,NTP,0000,0000,0000,,Ганта
Dialogue: 0,0:08:52.26,0:08:54.01,jp_text,NTP,0000,0000,0000,,Бұл қандай бала?
Dialogue: 0,0:08:54.17,0:08:55.26,jp_text,NTP,0000,0000,0000,,Широ ше?
Dialogue: 0,0:08:55.76,0:08:58.80,jp_text,NTP,0000,0000,0000,,Мен бұл туралы көпке дейін ұмытып кеттім.
Dialogue: 0,0:08:58.93,0:09:00.85,jp_text,NTP,0000,0000,0000,,Мен ол жігітті көргім келеді, бала кезден дос болғанбыз.
Dialogue: 0,0:09:03.06,0:09:05.06,jp_text,NTP,0000,0000,0000,,Өйткені анам тірі болғанда
Dialogue: 0,0:09:05.60,0:09:07.23,jp_text,NTP,0000,0000,0000,,Мүмкін он жыл бұрын
Dialogue: 0,0:09:11.32,0:09:12.65,jp_text,NTP,0000,0000,0000,,Циро
Dialogue: 0,0:09:13.11,0:09:17.03,jp_text,NTP,0000,0000,0000,,Широ Қане, тәтті пудинг ішейік.
Dialogue: 0,0:09:17.07,0:09:18.20,jp_text,NTP,0000,0000,0000,,Қажет емес
Dialogue: 0,0:09:19.24,0:09:23.20,jp_text,NTP,0000,0000,0000,,Содан бері қол-аяғым қатты ауырды.
Dialogue: 0,0:09:23.70,0:09:26.83,jp_text,NTP,0000,0000,0000,,Енді инъекциялар мен сынақтар болмайды.
Dialogue: 0,0:09:27.25,0:09:28.83,jp_text,NTP,0000,0000,0000,,Мен Широны білмеймін.
Dialogue: 0,0:09:29.96,0:09:32.25,jp_text,NTP,0000,0000,0000,,Ауырсынатын немесе жағымсыз нәрсе болған кезде
Dialogue: 0,0:09:32.38,0:09:35.17,jp_text,NTP,0000,0000,0000,,«Ace Man» деп қоңырау шалсаңыз, ол сізге көмекке келеді.
Dialogue: 0,0:09:35.92,0:09:37.05,jp_text,NTP,0000,0000,0000,,Кешіріңіз?
Dialogue: 0,0:09:37.72,0:09:40.05,jp_text,NTP,0000,0000,0000,,Бұл өтірік, бұл жай ғана теледидар.
Dialogue: 0,0:09:40.10,0:09:43.81,jp_text,NTP,0000,0000,0000,,Менің тегім Эйс, менің атым - Ер, мен төмен серпіліс жауынгермін.
Dialogue: 0,0:09:44.10,0:09:46.31,jp_text,NTP,0000,0000,0000,,Широның ауыруы ұшады
Dialogue: 0,0:09:46.52,0:09:48.27,jp_text,NTP,0000,0000,0000,,Біз келсек, өзіңізді қауіпсіз сезінесіз.
Dialogue: 0,0:09:48.40,0:09:51.48,jp_text,NTP,0000,0000,0000,,Сот эндорфиннің ультра хаосын жеңіз
Dialogue: 0,0:09:58.11,0:10:00.82,jp_text,NTP,0000,0000,0000,,Мен білмеймін. Бұл Гантаның кінәсі.
Dialogue: 0,0:10:02.91,0:10:04.37,jp_text,NTP,0000,0000,0000,,Жалғыз тамақ ішу
Dialogue: 0,0:10:12.38,0:10:14.88,jp_text,NTP,0000,0000,0000,,Широның ақымақ
Dialogue: 0,0:10:18.88,0:10:19.84,jp_text,NTP,0000,0000,0000,,Ана
Dialogue: 0,0:10:31.48,0:10:32.61,jp_text,NTP,0000,0000,0000,,Менің пудингім
Dialogue: 0,0:10:40.53,0:10:42.24,jp_text,NTP,0000,0000,0000,,Маған көмектесші, Эйсман
Dialogue: 0,0:10:42.49,0:10:45.49,jp_text,NTP,0000,0000,0000,,Aceman Aceman!
Dialogue: 0,0:10:56.17,0:10:57.17,jp_text,NTP,0000,0000,0000,,Широ…
Dialogue: 0,0:10:58.92,0:11:00.76,jp_text,NTP,0000,0000,0000,,Ace Man пайда болады
Dialogue: 0,0:11:09.48,0:11:11.44,jp_text,NTP,0000,0000,0000,,Ойланып қарасаңыз, әлгі жігіт
Dialogue: 0,0:11:12.10,0:11:14.27,jp_text,NTP,0000,0000,0000,,Ол көптен бері солай болды ғой, солай емес пе?
Dialogue: 0,0:11:15.73,0:11:18.49,jp_text,NTP,0000,0000,0000,,Кешірім сұрауды ұмытып кетіппін.
Dialogue: 0,0:11:19.40,0:11:22.53,jp_text,NTP,0000,0000,0000,,Бірақ ол әдетте қайда?
Dialogue: 0,0:11:24.12,0:11:25.91,jp_text,NTP,0000,0000,0000,,Білесің бе, Ганта
Dialogue: 0,0:11:26.33,0:11:27.49,jp_text,NTP,0000,0000,0000,,Мен сенімен танысқым келеді
Dialogue: 0,0:11:33.54,0:11:36.80,jp_text,NTP,0000,0000,0000,,Тамаки промоутері мульти-блокталған
Dialogue: 0,0:11:37.13,0:11:40.05,jp_text,NTP,0000,0000,0000,,Осы DW бойынша барлық толық ақпарат
Dialogue: 0,0:11:40.05,0:11:41.47,jp_text,NTP,0000,0000,0000,,Ұқсас өңдеу
Dialogue: 0,0:11:41.72,0:11:44.30,jp_text,NTP,0000,0000,0000,,Нәтижесінде «Necro Macro» жоғалып кеткен бір жағдай болды.
Dialogue: 0,0:11:44.64,0:11:48.64,jp_text,NTP,0000,0000,0000,,СР-4 қарауыл мұнарасындағы айуандықпен өлтіруді тергеуде ілгерілеушілік жоқ.
Dialogue: 0,0:11:49.98,0:11:53.60,jp_text,NTP,0000,0000,0000,,Жоғарыда айтылған құбылыс табиғаттан туындаған ауытқу емес екені анық.
Dialogue: 0,0:11:54.15,0:11:55.94,jp_text,NTP,0000,0000,0000,,Солтүстік-шығыс Токио арнайы аймағы
Dialogue: 0,0:11:56.69,0:12:01.61,jp_text,NTP,0000,0000,0000,,Басқаша айтқанда, гравитация аномалиясы осы DW бар аймақтың айналасында орналасқан.
Dialogue: 0,0:12:02.91,0:12:05.03,jp_text,NTP,0000,0000,0000,,Бұл провизияның жергілікті күйреуі.
Dialogue: 0,0:12:06.07,0:12:06.95,jp_text,NTP,0000,0000,0000,,«Қызыл тесік»
Dialogue: 0,0:12:07.74,0:12:10.20,jp_text,NTP,0000,0000,0000,,Бұл да он жыл бұрын апаттың ошағы болған.
Dialogue: 0,0:12:11.21,0:12:14.33,jp_text,NTP,0000,0000,0000,,Алты жыл бұрын құрылған бұл түрмеде.
Dialogue: 0,0:12:14.83,0:12:17.17,jp_text,NTP,0000,0000,0000,,Бірдеңе болып жатқаны анық
Dialogue: 0,0:12:17.79,0:12:20.34,jp_text,NTP,0000,0000,0000,,Егер абсурд пен шатасушылық шындық болса
Dialogue: 0,0:12:20.55,0:12:23.01,jp_text,NTP,0000,0000,0000,,Оны түзету адамның міндеті.
Dialogue: 0,0:12:25.76,0:12:28.56,jp_text,NTP,0000,0000,0000,,Балалар, сендер мұны істей алмасаңдар, мен істеймін.
Dialogue: 0,0:12:28.93,0:12:30.47,jp_text,NTP,0000,0000,0000,,Шырылдамаса, кесіп таста да, лақтырып таста.
Dialogue: 0,0:12:33.23,0:12:34.31,jp_text,NTP,0000,0000,0000,,Түлкі аулау!
Dialogue: 0,0:12:36.10,0:12:39.11,jp_text,NTP,0000,0000,0000,,Бұл өте нашар сезінеді.
Dialogue: 0,0:12:39.82,0:12:42.11,jp_text,NTP,0000,0000,0000,,Ғылыми-зерттеу институтымен байланыса алмаймын.
Dialogue: 0,0:12:43.45,0:12:47.16,jp_text,NTP,0000,0000,0000,,Сонымен, Гантаның сынақ нәтижелері қандай?
Dialogue: 0,0:12:47.74,0:12:50.58,jp_text,NTP,0000,0000,0000,,Иә, сол баланың кеудесіндегі қызыл кристал.
Dialogue: 0,0:12:51.12,0:12:52.66,jp_text,NTP,0000,0000,0000,,Бұл былайша айтқанда капсула.
Dialogue: 0,0:12:53.04,0:12:56.54,jp_text,NTP,0000,0000,0000,,Femtomashine «Аты жоқ құрттар» жинағы
Dialogue: 0,0:12:57.46,0:13:00.75,jp_text,NTP,0000,0000,0000,,Кейбіреулері он жыл бұрын «қызыл тесік» құбылысынан кейін ғана ашылды.
Dialogue: 0,0:13:00.75,0:13:02.01,jp_text,NTP,0000,0000,0000,,Қайта қаралды
Dialogue: 0,0:13:02.67,0:13:05.68,jp_text,NTP,0000,0000,0000,,Аты жоқ құрт қалдықтары сияқты нәрселерге рұқсат етілген, бірақ
Dialogue: 0,0:13:05.93,0:13:08.68,jp_text,NTP,0000,0000,0000,,Оның функциясының өзі толығымен жойылды
Dialogue: 0,0:13:10.43,0:13:14.56,jp_text,NTP,0000,0000,0000,,Алайда неліктен адамдарда «күнәнің бұтақтары» пайда болады?
Dialogue: 0,0:13:14.69,0:13:18.48,jp_text,NTP,0000,0000,0000,,Бұл оқиға кезінде тек Канто аймағында болғандар ғана болды ма?
Dialogue: 0,0:13:18.73,0:13:20.36,jp_text,NTP,0000,0000,0000,,жұмбағы шешілді.
Dialogue: 0,0:13:20.94,0:13:22.40,jp_text,NTP,0000,0000,0000,,қандай да бір жолмен
Dialogue: 0,0:13:22.86,0:13:25.53,jp_text,NTP,0000,0000,0000,,Осы қызыл кристалды денеге алу арқылы,
Dialogue: 0,0:13:25.74,0:13:26.99,jp_text,NTP,0000,0000,0000,,Ол жұқтырады ма?
Dialogue: 0,0:13:27.49,0:13:28.78,jp_text,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:13:29.99,0:13:33.33,jp_text,NTP,0000,0000,0000,,Сонда маңызды қабілеті бар адамдарды «шығару» мүмкіндігі қандай?
Dialogue: 0,0:13:34.50,0:13:38.46,jp_text,NTP,0000,0000,0000,,Атаусыз құрттың өзін жасау технологиясының болашағы жоқ.
Dialogue: 0,0:13:39.00,0:13:42.63,jp_text,NTP,0000,0000,0000,,Өйткені жұқпалы ядроның бастапқы күнәсін зерттей алмаймыз.
Dialogue: 0,0:13:39.00,0:13:42.63,Float_jp,NTP,0000,0000,0000,,Бейшара жұмыртқа
Dialogue: 0,0:13:43.88,0:13:45.09,jp_text,NTP,0000,0000,0000,,Ал, келіңдер.
Dialogue: 0,0:13:45.30,0:13:49.14,jp_text,NTP,0000,0000,0000,,Бұл менікі емес, мүлде директордың ойыншығы.
Dialogue: 0,0:13:49.72,0:13:51.26,jp_text,NTP,0000,0000,0000,,Менің келгеніме бес жыл болды.
Dialogue: 0,0:13:51.64,0:13:55.06,jp_text,NTP,0000,0000,0000,,Мен оның маскасының астында не барын әлі көре алмаймын.
Dialogue: 0,0:13:55.60,0:13:57.44,jp_text,NTP,0000,0000,0000,,Басқару деректерін қорғау қаншалықты тығыз?
Dialogue: 0,0:13:57.44,0:13:59.60,jp_text,NTP,0000,0000,0000,,Тіпті Пентагон да таң қалады.
Dialogue: 0,0:14:00.73,0:14:03.65,jp_text,NTP,0000,0000,0000,,Мен оның себебін білмеймін.
Dialogue: 0,0:14:03.90,0:14:05.86,jp_text,NTP,0000,0000,0000,,Директор тез қартаюда.
Dialogue: 0,0:14:06.45,0:14:10.66,jp_text,NTP,0000,0000,0000,,Осы қарқынмен бұл жер жақын арада менің ғажайып жеріме айналады.
Dialogue: 0,0:14:11.24,0:14:14.49,jp_text,NTP,0000,0000,0000,,Менің өз ойыным бар.
Dialogue: 0,0:14:22.50,0:14:23.17,jp_text,NTP,0000,0000,0000,,Қой-күн
Dialogue: 0,0:14:26.84,0:14:29.01,jp_text,NTP,0000,0000,0000,,Өлтіргісі келетін сияқты, қарғыс атсын.
Dialogue: 0,0:14:29.05,0:14:30.22,jp_text,NTP,0000,0000,0000,,Мен ұмытып қалдым
Dialogue: 0,0:14:31.30,0:14:32.18,jp_text,NTP,0000,0000,0000,,Не болды, апа?
Dialogue: 0,0:14:32.51,0:14:35.56,jp_text,NTP,0000,0000,0000,,Сіз үшін жазалау ойыны бар, солай ма?
Dialogue: 0,0:14:36.56,0:14:39.06,jp_text,NTP,0000,0000,0000,,Бұл әдеттегі орнату емес пе?
Dialogue: 0,0:14:39.39,0:14:42.31,jp_text,NTP,0000,0000,0000,,Темеге қарағанда бұл қыз емес.
Dialogue: 0,0:14:42.73,0:14:45.03,jp_text,NTP,0000,0000,0000,,Бүйрек пен асқазан болса, мен оны бастан өткердім.
Dialogue: 0,0:14:46.19,0:14:47.74,jp_text,NTP,0000,0000,0000,,Мен оны тоқтата алмаймын ба?
Dialogue: 0,0:14:48.40,0:14:50.07,jp_text,NTP,0000,0000,0000,,Өйткені бұл біртүрлі.
Dialogue: 0,0:14:51.95,0:14:54.45,jp_text,NTP,0000,0000,0000,,Ағам секіріп шығып, дәл осылай деді.
Dialogue: 0,0:14:54.83,0:14:56.45,jp_text,NTP,0000,0000,0000,,Қастанды бақылаушы алды
Dialogue: 0,0:14:56.54,0:14:58.04,jp_text,NTP,0000,0000,0000,,Мен оны қайтарып аламын немесе бір нәрсе.
Dialogue: 0,0:14:58.04,0:14:59.08,jp_text,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:14:59.50,0:15:00.71,jp_text,NTP,0000,0000,0000,,Эй, сәлем
Dialogue: 0,0:15:03.04,0:15:04.46,jp_text,NTP,0000,0000,0000,,Олар қандай?
Dialogue: 0,0:15:05.21,0:15:06.34,jp_text,NTP,0000,0000,0000,,Жынды болмаңыз
Dialogue: 0,0:15:08.84,0:15:11.47,jp_text,NTP,0000,0000,0000,,Миназукидің үкімін Кастпен сатып алсаңыз...
Dialogue: 0,0:15:21.10,0:15:22.73,jp_text,NTP,0000,0000,0000,,Аристократтар академиясына сұхбат
Dialogue: 0,0:15:22.85,0:15:26.19,jp_text,NTP,0000,0000,0000,,Кешіріңіз, сіз одан аулақ боласыз деп ойладым.
Dialogue: 0,0:15:37.95,0:15:39.83,jp_text,NTP,0000,0000,0000,,Әй, біраз болды.
Dialogue: 0,0:15:40.16,0:15:41.42,jp_text,NTP,0000,0000,0000,,Таками Йо-кун
Dialogue: 0,0:15:42.12,0:15:43.67,jp_text,NTP,0000,0000,0000,,Мен оны негізсіз қуғынға түсуіне жол бермеймін
Dialogue: 0,0:15:45.21,0:15:47.71,jp_text,NTP,0000,0000,0000,,Бұл Ганта Игарашиге назар аудару.
Dialogue: 0,0:15:48.13,0:15:49.13,jp_text,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:15:49.63,0:15:51.93,jp_text,NTP,0000,0000,0000,,Олай болса, бір түйір тұзбен алайық.
Dialogue: 0,0:15:55.39,0:15:56.18,jp_text,NTP,0000,0000,0000,,Монах?
Dialogue: 0,0:15:56.72,0:15:58.93,jp_text,NTP,0000,0000,0000,,Сіз монах емессіз, аға.
Dialogue: 0,0:15:59.56,0:16:01.14,jp_text,NTP,0000,0000,0000,,Өте қырылған бас
Dialogue: 0,0:16:02.02,0:16:04.56,jp_text,NTP,0000,0000,0000,,Бұл не, ақымақ бейбақ?
Dialogue: 0,0:16:05.15,0:16:07.11,jp_text,NTP,0000,0000,0000,,Мен Нембуцуды жырлап жүрсем де,
Dialogue: 0,0:16:07.32,0:16:08.98,jp_text,NTP,0000,0000,0000,,Өлім жазасына кесілгендер де алданбайды.
Dialogue: 0,0:16:11.82,0:16:13.20,jp_text,NTP,0000,0000,0000,,Дұрыс, қой-күн.
Dialogue: 0,0:16:13.74,0:16:14.99,jp_text,NTP,0000,0000,0000,,Осы G ғимаратында
Dialogue: 0,0:16:14.99,0:16:18.33,jp_text,NTP,0000,0000,0000,,Сақ болыңыз, өйткені Кастадан сатып алуға болатын өнімдер әртүрлі.
Dialogue: 0,0:16:19.16,0:16:23.33,jp_text,NTP,0000,0000,0000,,Мұнда түрмеде ұстау мерзімі өнімге кірмейді.
Dialogue: 0,0:16:23.96,0:16:24.71,jp_text,NTP,0000,0000,0000,,Келесі шайқас!
Dialogue: 0,0:16:24.96,0:16:28.80,jp_text,NTP,0000,0000,0000,,Бұл туралы айтатын болсам, апамның жазалау ойынының уақыты жақындап қалды.
Dialogue: 0,0:16:29.21,0:16:31.92,jp_text,NTP,0000,0000,0000,,Мен Миназукиді құтқара алмаймын ба?
Dialogue: 0,0:16:29.75,0:16:31.51,Unimportant_jp,NTP,0000,0000,0000,,Бұл біздің танымал шоуларымыздың бірі.
Dialogue: 0,0:16:32.09,0:16:35.72,Unimportant_jp,NTP,0000,0000,0000,,Сүйкімді қыздардың пайда болуына байланысты көру артып келеді
Dialogue: 0,0:16:33.51,0:16:35.76,jp_text,NTP,0000,0000,0000,,Неше жыл?
Dialogue: 0,0:16:36.55,0:16:39.43,jp_text,NTP,0000,0000,0000,,Бүгін мен өз денемді қай жерде бере аламын?
Dialogue: 0,0:16:39.89,0:16:41.22,jp_text,NTP,0000,0000,0000,,Сіз аяқтарыңызбен күресіп жатырсыз ба?
Dialogue: 0,0:16:41.35,0:16:43.06,jp_text,NTP,0000,0000,0000,,Мұрнымды қырып аламын ба?
Dialogue: 0,0:16:44.19,0:16:45.60,jp_text,NTP,0000,0000,0000,,Сен
Dialogue: 0,0:16:46.10,0:16:47.19,jp_text,NTP,0000,0000,0000,,Алдау
Dialogue: 0,0:16:59.62,0:17:02.25,jp_text,NTP,0000,0000,0000,,Уайымдамаңыз, Генкаку мырза.
Dialogue: 0,0:17:02.70,0:17:04.75,jp_text,NTP,0000,0000,0000,,Ол бала «өлген адам» емес
Dialogue: 0,0:17:05.21,0:17:08.71,jp_text,NTP,0000,0000,0000,,Одан да олардың көңіл-күйлері жақсы сияқты.
Dialogue: 0,0:17:09.38,0:17:11.51,jp_text,NTP,0000,0000,0000,,Мен ғылыми-зерттеу институтына барамын.
Dialogue: 0,0:17:12.21,0:17:14.26,jp_text,NTP,0000,0000,0000,,Маған беріңізші.
Dialogue: 0,0:17:16.13,0:17:17.59,jp_text,NTP,0000,0000,0000,,Керемет
Dialogue: 0,0:17:18.14,0:17:21.77,jp_text,NTP,0000,0000,0000,,Олай болса, мен саған әнге барайын.
Dialogue: 0,0:17:29.77,0:17:31.36,jp_text,NTP,0000,0000,0000,,Бұрын жаман болды.
Dialogue: 0,0:17:32.07,0:17:33.86,jp_text,NTP,0000,0000,0000,,Мен сіздің аранжировкаларыңызды қарап көрейін деп ойладым.
Dialogue: 0,0:17:34.40,0:17:37.11,jp_text,NTP,0000,0000,0000,,Міне, сондықтан біз тым күшті болдық.
Dialogue: 0,0:17:37.78,0:17:38.62,jp_text,NTP,0000,0000,0000,,Каннинна
Dialogue: 0,0:17:40.03,0:17:41.83,jp_text,NTP,0000,0000,0000,,Біз Ку Каракомыз
Dialogue: 0,0:17:42.08,0:17:43.79,jp_text,NTP,0000,0000,0000,,Бостандық тізбегінің мүшелері
Dialogue: 0,0:17:42.08,0:17:43.79,Float_jp,NTP,0000,0000,0000,,Шрам тізбегі
Dialogue: 0,0:17:45.00,0:17:45.33,jp_text,NTP,0000,0000,0000,,Шрам?
Dialogue: 0,0:17:45.33,0:17:47.46,jp_text,NTP,0000,0000,0000,,Джибун Екеуміз соғысамыз ба?
Dialogue: 0,0:17:48.42,0:17:50.50,jp_text,NTP,0000,0000,0000,,Сіз кенеттен біреуді ұрғанда не істедіңіз...
Dialogue: 0,0:17:50.96,0:17:52.17,jp_text,NTP,0000,0000,0000,,Неге мен?
Dialogue: 0,0:17:52.75,0:17:55.05,jp_text,NTP,0000,0000,0000,,Себебі мен сен түсінерсің деп ойладым.
Dialogue: 0,0:17:56.38,0:17:57.76,jp_text,NTP,0000,0000,0000,,Ганта Игараши
Dialogue: 0,0:18:00.10,0:18:02.18,jp_text,NTP,0000,0000,0000,,Біздікі дөрекі еліктеу болған сияқты.
Dialogue: 0,0:18:02.43,0:18:03.56,jp_text,NTP,0000,0000,0000,,Уф! Босат! Мені босат!
Dialogue: 0,0:18:04.39,0:18:07.81,jp_text,NTP,0000,0000,0000,,Диссиденттер ұйымы Лидерлік еркіндік тізбегі
Dialogue: 0,0:18:04.39,0:18:07.81,Float_jp,NTP,0000,0000,0000,,Шрам тізбегі
Dialogue: 0,0:18:08.27,0:18:10.02,jp_text,NTP,0000,0000,0000,,Менің атым Наги Кенгамин.
Dialogue: 0,0:18:10.36,0:18:12.86,jp_text,NTP,0000,0000,0000,,Машинаның дауысы Диссидент?
Dialogue: 0,0:18:13.19,0:18:16.36,jp_text,NTP,0000,0000,0000,,Біздің жау DW өзі
Dialogue: 0,0:18:16.86,0:18:18.82,jp_text,NTP,0000,0000,0000,,негізін қалаушы Риничиро Хакири Директор
Dialogue: 0,0:18:19.36,0:18:21.99,jp_text,NTP,0000,0000,0000,,Және Tamaki промоутері жасаған
Dialogue: 0,0:18:22.41,0:18:24.04,jp_text,NTP,0000,0000,0000,,Бұл абсурдтық миниатюралық бақ
Dialogue: 0,0:18:24.08,0:18:26.12,jp_text,NTP,0000,0000,0000,,Мен оны толығымен жойғым келеді.
Dialogue: 0,0:18:26.79,0:18:27.91,jp_text,NTP,0000,0000,0000,,Енді рақымсыз
Dialogue: 0,0:18:28.12,0:18:30.71,jp_text,NTP,0000,0000,0000,,Бізге жаңа достар керек
Dialogue: 0,0:18:31.38,0:18:34.63,jp_text,NTP,0000,0000,0000,,Біз кеше ойынды көріп, сізге кеңес бердік.
Dialogue: 0,0:18:35.01,0:18:37.01,jp_text,NTP,0000,0000,0000,,Бұл жігіт мұны істей алады.
Dialogue: 0,0:18:37.13,0:18:39.93,jp_text,NTP,0000,0000,0000,,Иә, бұл өте сергітетін болды.
Dialogue: 0,0:18:40.47,0:18:41.93,jp_text,NTP,0000,0000,0000,,Уақыт құмы арқылы саяхат
Dialogue: 0,0:18:43.22,0:18:45.97,jp_text,NTP,0000,0000,0000,,Мен бұл түрмеде бәрі ақылсыз деп ойладым
Dialogue: 0,0:18:46.35,0:18:48.35,jp_text,NTP,0000,0000,0000,,Мен сияқты ойлайтын адамдар...
Dialogue: 0,0:18:49.39,0:18:51.69,jp_text,NTP,0000,0000,0000,,Мм, бірақ кешіріңіз.
Dialogue: 0,0:18:51.90,0:18:53.27,jp_text,NTP,0000,0000,0000,,Негізі, қазір асығыңыз.
Dialogue: 0,0:18:55.19,0:18:57.07,jp_text,NTP,0000,0000,0000,,Өйткені кешегі ойында мен жеңдім
Dialogue: 0,0:18:57.44,0:18:59.11,jp_text,NTP,0000,0000,0000,,Тағы бір пенальти ойыны бар.
Dialogue: 0,0:18:59.70,0:19:01.32,jp_text,NTP,0000,0000,0000,,Мен оны шынымен тоқтатқым келеді
Dialogue: 0,0:19:07.50,0:19:08.58,jp_text,NTP,0000,0000,0000,,Күтіңіз
Dialogue: 0,0:19:09.25,0:19:12.25,jp_text,NTP,0000,0000,0000,,Түсінемін, сіз шынымен турасыз.
Dialogue: 0,0:19:21.38,0:19:22.59,jp_text,NTP,0000,0000,0000,,Мұнда «Оулу»
Dialogue: 0,0:19:26.06,0:19:28.43,jp_text,NTP,0000,0000,0000,,Көп болды, Минадзуки-чан.
Dialogue: 0,0:19:28.68,0:19:31.02,jp_text,NTP,0000,0000,0000,,Бүгін маған не бересің?
Dialogue: 0,0:19:32.10,0:19:33.06,jp_text,NTP,0000,0000,0000,,Бұл жолы
Dialogue: 0,0:19:33.19,0:19:35.98,jp_text,NTP,0000,0000,0000,,Маған оны наркозсыз алып тастауға болатыны ұнайды.
Dialogue: 0,0:19:36.65,0:19:38.19,jp_text,NTP,0000,0000,0000,,Мына бұзық қаншық
Dialogue: 0,0:19:38.19,0:19:41.07,jp_text,NTP,0000,0000,0000,,О, не болып жатыр? Бұл дұрыс емес сияқты.
Dialogue: 0,0:19:41.32,0:19:43.70,jp_text,NTP,0000,0000,0000,,Жаңа туған құс сияқты
Dialogue: 0,0:19:43.87,0:19:44.70,jp_text,NTP,0000,0000,0000,,Сен оны бірнеше күн бұрын ертіп келгенде маған айтсаң ғой.
Dialogue: 0,0:19:45.74,0:19:47.74,jp_text,NTP,0000,0000,0000,,Иә, олай емес сияқты.
Dialogue: 0,0:19:48.45,0:19:50.83,jp_text,NTP,0000,0000,0000,,Қарғыс атсын, олардың кесірінен.
Dialogue: 0,0:19:51.16,0:19:52.87,jp_text,NTP,0000,0000,0000,,Сіз біртүрлі күткен боларсыз.
Dialogue: 0,0:19:53.54,0:19:55.42,jp_text,NTP,0000,0000,0000,,Бұл жерде мылқау ойнауға болмайды.
Dialogue: 0,0:19:56.13,0:19:58.63,jp_text,NTP,0000,0000,0000,,Ойланба, әрекет ете бер
Dialogue: 0,0:19:59.46,0:20:01.80,jp_text,NTP,0000,0000,0000,,Опасыз болып, қайта ашыңыз
Dialogue: 0,0:20:02.34,0:20:03.93,jp_text,NTP,0000,0000,0000,,Барлығын күліңіз
Dialogue: 0,0:20:05.80,0:20:06.81,jp_text,NTP,0000,0000,0000,,Тоқта!
Dialogue: 0,0:20:13.40,0:20:14.31,jp_text,NTP,0000,0000,0000,,Үлкен аға
Dialogue: 0,0:20:22.78,0:20:26.20,jp_text,NTP,0000,0000,0000,,Менің ойымша, әйелдердің қысқа шаштары өте әдемі.
Dialogue: 0,0:20:26.62,0:20:28.08,jp_text,NTP,0000,0000,0000,,Жаман болды ма?
Dialogue: 0,0:20:31.33,0:20:34.79,jp_text,NTP,0000,0000,0000,,Өтірік Мұндай белгінің болуына ешқандай себеп жоқ.
Dialogue: 0,0:20:44.26,0:20:45.84,jp_text,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,0:20:45.84,0:20:47.68,jp_text,NTP,0000,0000,0000,,Осыдан кейін анау ақымақ дәрігер әйел
Dialogue: 0,0:20:47.93,0:20:51.18,jp_text,NTP,0000,0000,0000,,Қыздың шашын тамырынан жұлып алуын тілеу.
Dialogue: 0,0:20:51.68,0:20:53.85,jp_text,NTP,0000,0000,0000,,Енді сіз ше?
Dialogue: 0,0:20:54.39,0:20:56.23,jp_text,NTP,0000,0000,0000,,Әлсіз күш болғанымен
Dialogue: 0,0:20:56.77,0:20:58.94,jp_text,NTP,0000,0000,0000,,Осыны маған сене алсаңыз
Dialogue: 0,0:20:59.44,0:21:00.98,jp_text,NTP,0000,0000,0000,,Біздің жоспарға келіңіз
Dialogue: 0,0:21:01.15,0:21:03.57,jp_text,NTP,0000,0000,0000,,Мен Игараши-кунның да қызметтес болғанын қалаймын.
Dialogue: 0,0:21:04.11,0:21:05.11,jp_text,NTP,0000,0000,0000,,Жоспар?
Dialogue: 0,0:21:06.32,0:21:10.12,jp_text,NTP,0000,0000,0000,,Иіске, иіске, сасысын.
Dialogue: 0,0:21:11.04,0:21:14.21,jp_text,NTP,0000,0000,0000,,Сіз жақсы жұмыс істеп жатқан сияқтысыз "Үкі"
Dialogue: 0,0:21:14.71,0:21:17.67,jp_text,NTP,0000,0000,0000,,Егер сіз тым жігерлі болсаңыз, сіз айғайлайсыз.
Dialogue: 0,0:21:17.96,0:21:19.46,jp_text,NTP,0000,0000,0000,,Осы сияқты
Dialogue: 0,0:21:20.92,0:21:21.71,jp_text,NTP,0000,0000,0000,,Қой-күн
Dialogue: 0,0:21:22.01,0:21:22.71,jp_text,NTP,0000,0000,0000,,Хорда бұрышы
Dialogue: 0,0:21:23.05,0:21:24.92,jp_text,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:21:37.94,0:21:38.48,jp_text,NTP,0000,0000,0000,,Карако
Dialogue: 0,0:21:42.40,0:21:43.94,jp_text,NTP,0000,0000,0000,,Неліктен бұл ұнайды?
Dialogue: 0,0:21:44.53,0:21:46.70,jp_text,NTP,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:21:47.32,0:21:49.03,jp_text,NTP,0000,0000,0000,,Өте қырылған бас
Dialogue: 0,0:21:49.49,0:21:51.08,jp_text,NTP,0000,0000,0000,,Мен саған сутра беруге келдім.
Dialogue: 0,0:21:51.49,0:21:54.50,jp_text,NTP,0000,0000,0000,,Дегенмен, ең алдымен, сутра беру
Dialogue: 0,0:21:54.79,0:21:57.58,jp_text,NTP,0000,0000,0000,,Маған сенің өлуің керек.
Dialogue: 0,0:21:57.96,0:21:59.79,jp_text,NTP,0000,0000,0000,,Бұл алғашқы «Глория».
Dialogue: 0,0:22:06.51,0:22:07.51,jp_text,NTP,0000,0000,0000,,Игараши-кун
Dialogue: 0,0:22:09.09,0:22:10.93,jp_text,NTP,0000,0000,0000,,Бұл мен көрмеген бала.
Dialogue: 0,0:22:11.55,0:22:14.02,jp_text,NTP,0000,0000,0000,,Ал, әнге барайық.
Dialogue: 0,0:22:15.02,0:22:16.73,jp_text,NTP,0000,0000,0000,,«Күнәнің бұтағы» жұмыс істемейді
Dialogue: 0,0:22:18.56,0:22:21.02,jp_text,NTP,0000,0000,0000,,Ганта, қаш.
Dialogue: 0,0:22:34.99,0:22:37.62,jp_text,NTP,0000,0000,0000,,Мен сені алдымен құтқарамын.
Dialogue: 0,0:22:39.54,0:22:40.67,jp_text,NTP,0000,0000,0000,,(Айзава) Егер ол тағы да солай болса, мен дереу тоқтатып, Мидорияны шетке шығарамын
Dialogue: 0,0:24:12.26,0:24:16.18,jp_text,NTP,0000,0000,0000,,Өлім жазасына кесілгендер құрған режимге қарсы ұйым
Dialogue: 0,0:24:17.27,0:24:20.37,jp_text,NTP,0000,0000,0000,,Басқару жағы көтеріліске назар аудармаса
Dialogue: 0,0:24:21.11,0:24:21.61,jp_text,NTP,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:24:22.15,0:24:24.80,jp_text,NTP,0000,0000,0000,,Қулық ойынның басталуын белгілейді
Dialogue: 0,0:00:00.00,0:00:00.00,*Default,NTP,0000,0000,0000,,--------------------------Қызметкерлер------------------------------------
Dialogue: 0,0:24:11.22,0:24:13.22,staff,NTP,0000,0000,0000,,SGS Shukosha субтитрлер өндірісі http://blog.sgsub.com
Dialogue: 0,0:24:13.22,0:24:15.22,staff,NTP,0000,0000,0000,,Аударма: Муюн но Цукиёши Изайой Өңдеген: Хиро Хиби Хитомура
Dialogue: 0,0:24:15.22,0:24:17.22,staff,NTP,0000,0000,0000,,Жапон тілі: Киоку алаңы Өрт уақыты: Менмендік Кеш мезгіл: Қышқыл
Dialogue: 0,0:24:17.22,0:24:19.22,staff,NTP,0000,0000,0000,,BD жүйесі және дамуы: Daydream ынтымақтастық: DC
