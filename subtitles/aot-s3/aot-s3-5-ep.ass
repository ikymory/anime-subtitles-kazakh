Dialogue: 0,0:22:36.46,0:22:41.18,Default,,0,0,0,,Ол арман жүректің бар жері
Dialogue: 0,0:22:41.43,0:22:46.64,Default,,0,0,0,,Өмірден де нәзік нәрсе
Dialogue: 0,0:22:47.73,0:22:52.21,Default,,0,0,0,,Оны тастап, қайта-қайта табыңыз
Dialogue: 0,0:22:52.41,0:22:58.40,Default,,0,0,0,,Енді тыныш жат.
Dialogue: 0,0:22:59.04,0:23:04.33,Default,,0,0,0,,Импульстік импульске
Dialogue: 0,0:23:04.71,0:23:09.62,Default,,0,0,0,,Тілек бұзылды
Dialogue: 0,0:23:10.39,0:23:14.82,Default,,0,0,0,,Ұмытқан сайын
Dialogue: 0,0:23:14.97,0:23:20.29,Default,,0,0,0,,Тағы да есімде
Dialogue: 0,0:23:20.53,0:23:26.24,Default,,0,0,0,,Бұл әдемі және қатыгез әлемде
Dialogue: 0,0:23:26.55,0:23:29.06,Default,,0,0,0,,Әлі тірі
Dialogue: 0,0:23:29.06,0:23:31.91,Default,,0,0,0,,Неге екенін сұрап жатырмын
Dialogue: 0,0:23:31.91,0:23:37.44,Default,,0,0,0,,А, бізде бұл күшті және әлсіз.
Dialogue: 0,0:23:37.47,0:23:40.59,Default,,0,0,0,,Біз нені қорғаймыз?
Dialogue: 0,0:23:41.04,0:23:46.81,Default,,0,0,0,,Енді ешқандай себеп болмаса
