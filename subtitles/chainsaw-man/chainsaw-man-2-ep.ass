Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.17,0:00:10.67,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:00:12.38,0:00:13.93,Default,,0,0,0,,Менің асқазанымның дыбысы
Dialogue: 0,0:00:15.43,0:00:17.43,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:00:17.51,0:00:19.60,Default,,0,0,0,,Ах... Дэнжису
Dialogue: 0,0:00:19.68,0:00:21.93,Default,,0,0,0,,Алдымен бір нәрсені айтайын, иә?
Dialogue: 0,0:00:22.02,0:00:26.69,Default,,0,0,0,,Дэнджи-кун бұдан былай менің қолымда сақталады.
Dialogue: 0,0:00:27.40,0:00:29.65,Default,,0,0,0,,Жалғыз жауап «иә» немесе «бір»
Dialogue: 0,0:00:29.73,0:00:31.94,Default,,0,0,0,,Маған «жоқ» дейтін ит керек емес
Dialogue: 0,0:00:32.03,0:00:34.40,Default,,0,0,0,,Е, бұл маған керек емес...
Dialogue: 0,0:00:34.49,0:00:37.20,Default,,0,0,0,,Мен мұны сот-медициналық сараптама бөліміндегі бір танысымнан естідім.
Dialogue: 0,0:00:37.78,0:00:41.95,Default,,0,0,0,,Мен оны пайдалана алмаймын. Менің итімді эвтанизациялау керек болады.
Dialogue: 0,0:00:47.42,0:00:49.54,Default,,0,0,0,,Мен сені мейірімді адам деп ойладым.
Dialogue: 0,0:00:49.63,0:00:52.01,Default,,0,0,0,,Мен саған аздап ғашық болдым
Dialogue: 0,0:00:52.09,0:00:55.05,Default,,0,0,0,,Оның соншалықты қорқынышты әйел болғанына сене алар емеспін...
Dialogue: 0,0:00:55.13,0:00:57.80,Default,,0,0,0,,Сен адамдарға ит сияқты қарайсың...
Dialogue: 0,0:00:58.72,0:00:59.55,Default,,0,0,0,,Бір!
Dialogue: 0,0:00:59.64,0:01:01.39,Default,,0,0,0,,Ха...
Dialogue: 0,0:01:01.47,0:01:02.81,Default,,0,0,0,,Я...
Dialogue: 0,0:01:03.77,0:01:06.52,Default,,0,0,0,,Почитаның қайтыс болғаны есіме түсті.
Dialogue: 0,0:01:07.15,0:01:08.61,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:10.65,0:01:13.19,Default,,0,0,0,,Біз үшін де әлі таң болатын.
Dialogue: 0,0:01:13.28,0:01:15.57,Default,,0,0,0,,Автотұрақта қалағаныңызды жеңіз.
Dialogue: 0,0:01:15.65,0:01:18.82,Default,,0,0,0,,Кешіріңіз, менде ақша жоқ.
Dialogue: 0,0:01:18.91,0:01:22.16,Default,,0,0,0,,Сізге не ұнайтынын айтыңыз, мен оны төлеймін.
Dialogue: 0,0:01:22.24,0:01:23.08,Default,,0,0,0,,Иә!?
Dialogue: 0,0:01:24.12,0:01:26.83,Default,,0,0,0,,Сондай-ақ, сіз жартылай жалаңаш болсаңыз, ерекшеленетін боласыз, сондықтан оны киіңіз.
Dialogue: 0,0:01:26.92,0:01:28.46,Default,,0,0,0,,А...
Dialogue: 0,0:01:29.88,0:01:31.09,Default,,0,0,0,,Иә
Dialogue: 0,0:01:33.42,0:01:35.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:36.38,0:01:40.51,Default,,0,0,0,,Маған кір, сасық иіс шықты, тіпті маған ешкім жақындамады.
Dialogue: 0,0:01:40.60,0:01:42.85,Default,,0,0,0,,Алғаш рет мейірімділік таныту
Dialogue: 0,0:01:42.93,0:01:46.10,Default,,0,0,0,,Бұл да жақсы әйел.
Dialogue: 0,0:01:49.02,0:01:50.40,Default,,0,0,0,,Ұнады
Dialogue: 0,0:01:52.02,0:01:57.07,Default,,0,0,0,,♪～
Dialogue: 0,0:03:13.77,0:03:18.78,Default,,0,0,0,,～♪
Dialogue: 0,0:03:24.20,0:03:26.62,Default,,0,0,0,,А, мен удон алғым келеді...
Dialogue: 0,0:03:26.70,0:03:27.91,Default,,0,0,0,,Удон...
Dialogue: 0,0:03:27.99,0:03:30.50,Default,,0,0,0,,Франкфурт жақсы ма?
Dialogue: 0,0:03:30.58,0:03:31.66,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:03:31.75,0:03:33.71,Default,,0,0,0,,Маған карри удон керек.
Dialogue: 0,0:03:33.79,0:03:34.88,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:34.96,0:03:38.09,Default,,0,0,0,,А, карри удон да жақсы...
Dialogue: 0,0:03:38.17,0:03:39.59,Default,,0,0,0,,Ой
Dialogue: 0,0:03:40.26,0:03:42.59,Default,,0,0,0,,Дэнджи-кун?Сенімен бәрі жақсы ма?
Dialogue: 0,0:03:42.68,0:03:43.76,Default,,0,0,0,,Ал...
Dialogue: 0,0:03:43.84,0:03:45.43,Default,,0,0,0,,Жақсы иіс
Dialogue: 0,0:03:45.51,0:03:46.85,Default,,0,0,0,,Қанша тұрады?
Dialogue: 0,0:03:46.93,0:03:47.47,Default,,0,0,0,,Е, сәл күте тұрыңыз.
Dialogue: 0,0:03:47.47,0:03:49.10,Default,,0,0,0,,Дэнджи-кун? Ах
Dialogue: 0,0:03:47.47,0:03:49.10,Default,,0,0,0,,Е, сәл күте тұрыңыз.
Dialogue: 0,0:03:49.18,0:03:50.56,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:49.18,0:03:50.56,Default,,0,0,0,,Жалпы құны 1300 иен.
Dialogue: 0,0:03:50.56,0:03:50.98,Default,,0,0,0,,Жалпы құны 1300 иен.
Dialogue: 0,0:03:51.06,0:03:53.85,Default,,0,0,0,,Мен де өзімді арамен кесіп алдым.
Dialogue: 0,0:03:53.85,0:03:54.02,Default,,0,0,0,,Мен де өзімді арамен кесіп алдым.
Dialogue: 0,0:03:53.85,0:03:54.02,Default,,0,0,0,,Содан кейін 2000 иен.
Dialogue: 0,0:03:54.02,0:03:54.10,Default,,0,0,0,,Олай болса, 2000 иен.
Dialogue: 0,0:03:54.10,0:03:55.36,Default,,0,0,0,,Қансырап жатқаны сонша, мен қан аздығым бар деп ойлаймын.
Dialogue: 0,0:03:54.10,0:03:55.36,Default,,0,0,0,,Олай болса, 2000 иен.
Dialogue: 0,0:03:55.36,0:03:57.11,Default,,0,0,0,,Қансырап жатқаны сонша, мен қан аздығым бар деп ойлаймын.
Dialogue: 0,0:03:57.77,0:04:00.11,Default,,0,0,0,,Мұндай денені қалай алдыңыз?
Dialogue: 0,0:04:00.69,0:04:03.86,Default,,0,0,0,,Мен ұстаған шайтан менің жүрегім болды.
Dialogue: 0,0:04:05.03,0:04:06.62,Default,,0,0,0,,Мен бұған сене алмаймын
Dialogue: 0,0:04:06.70,0:04:09.33,Default,,0,0,0,,Мен де сенгім келмейді.
Dialogue: 0,0:04:09.41,0:04:12.37,Default,,0,0,0,,Почита мен үшін өлгеніне сене алмаймын.
Dialogue: 0,0:04:13.46,0:04:14.83,Default,,0,0,0,,Я...
Dialogue: 0,0:04:16.71,0:04:21.38,Default,,0,0,0,,Сіздің жағдайыңызда тіпті тарихи тұрғыдан алғанда да өте аз прецеденттер бар.
Dialogue: 0,0:04:22.13,0:04:25.13,Default,,0,0,0,,Оның әлі аты да жоқ.
Dialogue: 0,0:04:25.22,0:04:26.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:26.76,0:04:28.72,Default,,0,0,0,,Мен бұл оқиғаға сенемін.
Dialogue: 0,0:04:28.81,0:04:29.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:31.14,0:04:33.89,Default,,0,0,0,,Менің мұрным ерекше.
Dialogue: 0,0:04:33.98,0:04:35.48,Default,,0,0,0,,Сондықтан мен түсінемін.
Dialogue: 0,0:04:35.56,0:04:36.40,Default,,0,0,0,,Ха...
Dialogue: 0,0:04:37.02,0:04:39.98,Default,,0,0,0,,Сіздің ең жақсы досыңыз сіздің ішіңізде өмір сүреді.
Dialogue: 0,0:04:40.07,0:04:42.11,Default,,0,0,0,,Романтикалық мағынада емес.
Dialogue: 0,0:04:42.19,0:04:46.28,Default,,0,0,0,,Менің денем екі нәрсенің иісін сезеді: адам мен шайтан.
Dialogue: 0,0:04:46.36,0:04:47.41,Default,,0,0,0,,Ха...
Dialogue: 0,0:04:47.49,0:04:49.83,Default,,0,0,0,,Түсінемін, бұл таңқаларлық.
Dialogue: 0,0:04:49.91,0:04:52.70,Default,,0,0,0,,Бұл керемет... Ах.
Dialogue: 0,0:04:53.20,0:04:54.21,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:04:56.04,0:04:56.87,Default,,0,0,0,,Га
Dialogue: 0,0:04:59.71,0:05:01.05,Default,,0,0,0,,Удон!
Dialogue: 0,0:05:01.63,0:05:04.13,Default,,0,0,0,,Ах... Удон... Ах
Dialogue: 0,0:05:06.97,0:05:07.80,Default,,0,0,0,,Я...
Dialogue: 0,0:05:07.89,0:05:09.22,Default,,0,0,0,,Хмм
Dialogue: 0,0:05:09.93,0:05:12.02,Default,,0,0,0,,Удон жеуге бола ма?
Dialogue: 0,0:05:12.10,0:05:13.52,Default,,0,0,0,,Иә
Dialogue: 0,0:05:13.60,0:05:16.27,Default,,0,0,0,,Жақсысың ба?Жалғыз тамақ жей аласың ба?
Dialogue: 0,0:05:16.35,0:05:17.65,Default,,0,0,0,,Тамақтану...
Dialogue: 0,0:05:18.15,0:05:19.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:19.36,0:05:20.77,Default,,0,0,0,,Мен оны жей алмаймын.
Dialogue: 0,0:05:20.86,0:05:23.03,Default,,0,0,0,,Иә, хмм.
Dialogue: 0,0:05:23.11,0:05:24.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:26.07,0:05:27.78,Default,,0,0,0,,Бұл дәмді ме? бір!
Dialogue: 0,0:05:27.86,0:05:31.24,Default,,0,0,0,,Мен осылай өсіп тұрған удон кеспенің дәмді екеніне сене алар емеспін.
Dialogue: 0,0:05:31.33,0:05:33.04,Default,,0,0,0,,Сіз арзан конькисіз.
Dialogue: 0,0:05:33.12,0:05:35.16,Default,,0,0,0,,Шынында да итке ұқсайды
Dialogue: 0,0:05:37.50,0:05:38.33,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:05:38.42,0:05:41.46,Default,,0,0,0,,Ум... сенің атың кім?
Dialogue: 0,0:05:42.63,0:05:43.55,Default,,0,0,0,,Макима
Dialogue: 0,0:05:43.63,0:05:49.01,Default,,0,0,0,,Макима-сан... Сізге ұнайтын жігіт бар ма?
Dialogue: 0,0:05:49.09,0:05:50.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:50.64,0:05:52.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:55.68,0:05:57.98,Default,,0,0,0,,Денджи сияқты адамдар
Dialogue: 0,0:05:58.94,0:06:00.36,Default,,0,0,0,,Дэнджи-кун?
Dialogue: 0,0:06:01.31,0:06:02.73,Default,,0,0,0,,А...
Dialogue: 0,0:06:03.69,0:06:04.90,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:06:13.62,0:06:16.29,Default,,0,0,0,,Сізге ұнайтын жігіт бар ма?
Dialogue: 0,0:06:16.37,0:06:18.16,Default,,0,0,0,,Денджи сияқты адамдар
Dialogue: 0,0:06:18.75,0:06:20.04,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:20.54,0:06:23.38,Default,,0,0,0,,Маған да Макима ұнайды
Dialogue: 0,0:06:23.96,0:06:25.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:25.17,0:06:27.51,Default,,0,0,0,,Денджи-кун Кочи Коччи
Dialogue: 0,0:06:27.59,0:06:28.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:29.97,0:06:32.97,Default,,0,0,0,,Бұл Токиодағы Devil Hunter штаб-пәтері.
Dialogue: 0,0:06:37.31,0:06:39.48,Default,,0,0,0,,Токиода, соның ішінде жеке секторда
Dialogue: 0,0:06:39.56,0:06:42.40,Default,,0,0,0,,1000-нан астам шайтан аңшылары бар.
Dialogue: 0,0:06:42.48,0:06:47.03,Default,,0,0,0,,Қоғамдық қауіпсіздік қызметкерлері көптеген ақылы демалыстарға ие және ең жақсы әлеуметтік жеңілдіктерге ие.
Dialogue: 0,0:06:50.24,0:06:53.16,Default,,0,0,0,,Макима-санның мені ұнататыны
Dialogue: 0,0:06:53.24,0:06:55.16,Default,,0,0,0,,Біз бірге жұмыс істеген кезде,
Dialogue: 0,0:06:55.24,0:06:57.91,Default,,0,0,0,,Бұл қарым-қатынас дамитын түрі емес пе?
Dialogue: 0,0:06:58.75,0:07:03.42,Default,,0,0,0,,Егер сізде мұндай қарым-қатынас болса, сіз осындай нәрсені жасай аласыз ...
Dialogue: 0,0:07:03.50,0:07:06.67,Default,,0,0,0,,Жаса!Бұлай әрекет етпе!
Dialogue: 0,0:07:07.55,0:07:08.92,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:07:09.72,0:07:10.93,Default,,0,0,0,,Дэнджи-кун
Dialogue: 0,0:07:11.01,0:07:12.18,Default,,0,0,0,,Иә
Dialogue: 0,0:07:12.97,0:07:15.68,Default,,0,0,0,,Бізде негізгі форма бар, сондықтан оны киіңіз.
Dialogue: 0,0:07:16.26,0:07:19.02,Default,,0,0,0,,Киіміңді ауыстырған соң, мен сені әріптесіңмен кездесуге рұқсат етемін.
Dialogue: 0,0:07:22.90,0:07:23.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:24.81,0:07:25.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:26.32,0:07:27.82,Default,,0,0,0,,Оның аты - Аки Хаякава
Dialogue: 0,0:07:27.82,0:07:28.90,Default,,0,0,0,,Оның аты - Аки Хаякава
Dialogue: 0,0:07:27.82,0:07:28.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:28.90,0:07:29.19,Default,,0,0,0,,Оның аты - Аки Хаякава
Dialogue: 0,0:07:29.28,0:07:29.49,Default,,0,0,0,,Денжиден 3 жас үлкен
Dialogue: 0,0:07:29.49,0:07:31.49,Default,,0,0,0,,Денжиден 3 жас үлкен
Dialogue: 0,0:07:29.49,0:07:31.49,Default,,0,0,0,,А? а?
Dialogue: 0,0:07:31.57,0:07:32.11,Default,,0,0,0,,Хмм?
Dialogue: 0,0:07:32.11,0:07:33.20,Default,,0,0,0,,Мен бүгін Хаякава-кунның артынан барамын.
Dialogue: 0,0:07:32.11,0:07:33.20,Default,,0,0,0,,Хмм?
Dialogue: 0,0:07:33.20,0:07:34.07,Default,,0,0,0,,Бүгін Хаякаваның соңынан ерейік.
Dialogue: 0,0:07:34.16,0:07:34.99,Default,,0,0,0,,Иә!?
Dialogue: 0,0:07:35.62,0:07:38.74,Default,,0,0,0,,Мен Макима-санмен жұмыс істемеймін бе?
Dialogue: 0,0:07:38.83,0:07:40.25,Default,,0,0,0,,Бұл шындық болуы мүмкін емес, иә?
Dialogue: 0,0:07:40.33,0:07:41.08,Default,,0,0,0,,Макима-сан екеуіңіз басқа деңгейдесіздер.
Dialogue: 0,0:07:41.08,0:07:43.29,Default,,0,0,0,,Макима-сан екеуіңіз басқа деңгейдесіздер.
Dialogue: 0,0:07:41.08,0:07:43.29,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:07:43.29,0:07:43.37,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:07:43.37,0:07:44.29,Default,,0,0,0,,Айналаңа қара, кеттік
Dialogue: 0,0:07:43.37,0:07:44.29,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,0:07:44.38,0:07:47.00,Default,,0,0,0,,Жоқ! Макима-сан...
Dialogue: 0,0:07:47.09,0:07:49.46,Default,,0,0,0,,Эй, тұр!
Dialogue: 0,0:07:49.55,0:07:53.13,Default,,0,0,0,,Жоқ! Мен Макима-санмен жұмыс істеймін.
Dialogue: 0,0:07:55.80,0:07:56.93,Default,,0,0,0,,Жұмыс стиліңіз жақсы болса, біз бірге жұмыс істей аламыз.
Dialogue: 0,0:07:56.93,0:07:58.18,Default,,0,0,0,,Жұмыс стиліңіз жақсы болса, біз бірге жұмыс істей аламыз.
Dialogue: 0,0:07:56.93,0:07:58.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:58.18,0:08:00.35,Default,,0,0,0,,Жұмыс стиліңіз жақсы болса, біз бірге жұмыс істей аламыз.
Dialogue: 0,0:08:06.94,0:08:07.77,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:09.19,0:08:11.03,Default,,0,0,0,,Сондықтан қолыңнан келгеннің бәрін жаса.
Dialogue: 0,0:08:14.03,0:08:15.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:18.70,0:08:20.54,Default,,0,0,0,,Эй, сенпай.
Dialogue: 0,0:08:21.16,0:08:23.54,Default,,0,0,0,,Макима-сан еркек пе?
Dialogue: 0,0:08:27.46,0:08:28.63,Default,,0,0,0,,Эй, сен...
Dialogue: 0,0:08:30.46,0:08:31.59,Default,,0,0,0,,Эй!
Dialogue: 0,0:08:32.09,0:08:33.17,Default,,0,0,0,,Бір сәт осында кел.
Dialogue: 0,0:08:35.76,0:08:36.84,Default,,0,0,0,,Бухо
Dialogue: 0,0:08:37.47,0:08:38.85,Default,,0,0,0,,Уф
Dialogue: 0,0:08:38.93,0:08:42.14,Default,,0,0,0,,А... ха...
Dialogue: 0,0:08:43.31,0:08:45.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:45.85,0:08:47.23,Default,,0,0,0,,Уау, аа...
Dialogue: 0,0:08:47.31,0:08:51.11,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:08:59.20,0:09:00.53,Default,,0,0,0,,Жұмысыңызды тастауыңыз керек.
Dialogue: 0,0:09:01.66,0:09:04.12,Default,,0,0,0,,Ертең келсе, мен сені тағы ұрамын.
Dialogue: 0,0:09:04.75,0:09:05.79,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:07.17,0:09:09.54,Default,,0,0,0,,Менің жақсылығымды жеткізу мүмкін емес пе деп ойлаймын
Dialogue: 0,0:09:10.29,0:09:13.17,Default,,0,0,0,,Жеңіл жұмыс істегендер өледі.
Dialogue: 0,0:09:13.26,0:09:17.26,Default,,0,0,0,,Менің әріптесім де жалақысының арқасында шайтан аулаушы болды.
Dialogue: 0,0:09:17.34,0:09:19.55,Default,,0,0,0,,Олардың барлығын шайтан өлтірді.
Dialogue: 0,0:09:20.22,0:09:24.52,Default,,0,0,0,,Тірі адамдар – тамыры терең нанымға ие адамдар.
Dialogue: 0,0:09:25.52,0:09:29.69,Default,,0,0,0,,Сіз Макима-сан үшін шайтан аңшы болдыңыз, солай ма?
Dialogue: 0,0:09:29.77,0:09:31.61,Default,,0,0,0,,Пинг-понг
Dialogue: 0,0:09:32.57,0:09:35.11,Default,,0,0,0,,Сондықтан оны ұру дұрыс жауап болды.
Dialogue: 0,0:09:39.53,0:09:42.24,Default,,0,0,0,,Мен Макима-санға айтамын.
Dialogue: 0,0:09:42.33,0:09:45.25,Default,,0,0,0,,Шайтан сені қорқытып, қаштың.
Dialogue: 0,0:09:51.17,0:09:52.71,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:09:52.80,0:09:53.75,Default,,0,0,0,,Уф
Dialogue: 0,0:09:54.67,0:09:56.47,Default,,0,0,0,,Гаа… каа
Dialogue: 0,0:09:57.22,0:09:59.51,Default,,0,0,0,,Арх, аа...
Dialogue: 0,0:09:59.59,0:10:02.81,Default,,0,0,0,,Сенің ағаң мейірімді адам екен ғой?
Dialogue: 0,0:10:03.39,0:10:04.56,Default,,0,0,0,,Мен!(Хаякава) Уф
Dialogue: 0,0:10:04.64,0:10:05.98,Default,,0,0,0,,Ер адамдармен күресетін кез келді!
Dialogue: 0,0:10:04.64,0:10:05.98,Default,,0,0,0,,Гах…
Dialogue: 0,0:10:05.98,0:10:06.64,Default,,0,0,0,,Ер адамдармен күресетін кез келді!
Dialogue: 0,0:10:06.64,0:10:07.56,Default,,0,0,0,,Ер адамдармен күресетін кез келді!
Dialogue: 0,0:10:06.64,0:10:07.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:07.64,0:10:09.56,Default,,0,0,0,,Тек желкеде... (тепкі дыбысы)
Dialogue: 0,0:10:09.65,0:10:11.31,Default,,0,0,0,,Мақсат қоймаңыз! (Хаякава) Гуа!
Dialogue: 0,0:10:11.40,0:10:12.77,Default,,0,0,0,,А... (Хаякава) Ух...
Dialogue: 0,0:10:12.86,0:10:16.82,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:10:16.90,0:10:18.24,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:18.32,0:10:21.07,Default,,0,0,0,,Мен бүгін бірінші рет удон жедім.
Dialogue: 0,0:10:21.66,0:10:23.70,Default,,0,0,0,,Франкфурт Мона
Dialogue: 0,0:10:23.78,0:10:28.66,Default,,0,0,0,,Бұл маған бірінші рет қарапайым адам ретінде қаралды және бірінші рет тамақ берді.
Dialogue: 0,0:10:28.75,0:10:29.29,Default,,0,0,0,,Хмм... га...
Dialogue: 0,0:10:29.29,0:10:32.08,Default,,0,0,0,,Бұл мен үшін арманшыл өмір.
Dialogue: 0,0:10:29.29,0:10:32.08,Default,,0,0,0,,Хмм... га...
Dialogue: 0,0:10:32.75,0:10:36.84,Default,,0,0,0,,Мен жүрегі жеңіл шайтан аңшы болдым, бірақ...
Dialogue: 0,0:10:36.92,0:10:40.01,Default,,0,0,0,,Егер бұл өмірді жалғастыру керек болса
Dialogue: 0,0:10:40.51,0:10:42.18,Default,,0,0,0,,Өлсе жақсы
Dialogue: 0,0:10:42.26,0:10:43.76,Default,,0,0,0,,Я...
Dialogue: 0,0:10:43.85,0:10:45.97,Default,,0,0,0,,Өлген дұрыс па?
Dialogue: 0,0:10:46.60,0:10:48.48,Default,,0,0,0,,Бұл менің өмірім ғана емес еді.
Dialogue: 0,0:10:48.56,0:10:50.31,Default,,0,0,0,,Ха ха ха...
Dialogue: 0,0:10:50.39,0:10:51.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:51.81,0:10:53.31,Default,,0,0,0,,(Дэндзидің жөтелі)
Dialogue: 0,0:10:53.81,0:10:55.11,Default,,0,0,0,,Макима-сан...
Dialogue: 0,0:10:55.19,0:10:57.82,Default,,0,0,0,,Уф... (Хаякава) Сен сияқты бұзақы.
Dialogue: 0,0:10:57.90,0:11:00.53,Default,,0,0,0,,Ол ғашық бола алатын адам емес.
Dialogue: 0,0:11:00.61,0:11:02.53,Default,,0,0,0,,Ах!?
Dialogue: 0,0:11:02.62,0:11:04.49,Default,,0,0,0,,Сіз тек Макима-санды жақсы көресіз бе?
Dialogue: 0,0:11:04.49,0:11:05.45,Default,,0,0,0,,Сіз тек Макима-санды жақсы көресіз бе?
Dialogue: 0,0:11:04.49,0:11:05.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:05.45,0:11:06.04,Default,,0,0,0,,Сіз тек Макима-санды жақсы көресіз бе?
Dialogue: 0,0:11:06.04,0:11:06.74,Default,,0,0,0,,Сіз тек Макима-санды жақсы көресіз бе?
Dialogue: 0,0:11:06.04,0:11:06.74,Default,,0,0,0,,Уггаа...
Dialogue: 0,0:11:06.74,0:11:08.12,Default,,0,0,0,,Уггаа...
Dialogue: 0,0:11:08.20,0:11:10.25,Default,,0,0,0,,(Хаякаваның жөтелі)
Dialogue: 0,0:11:10.33,0:11:14.25,Default,,0,0,0,,Сіз... Шынымен... Уф...
Dialogue: 0,0:11:14.34,0:11:18.76,Default,,0,0,0,,Барлығы доптар туралы, мақсат...
Dialogue: 0,0:11:21.51,0:11:22.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:24.39,0:11:25.68,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:26.47,0:11:27.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:27.39,0:11:31.48,Default,,0,0,0,,Менің аға допқа алтын доп шайтан шабуыл жасады.
Dialogue: 0,0:11:31.56,0:11:33.31,Default,,0,0,0,,Уф... Бұл өтірік.
Dialogue: 0,0:11:33.40,0:11:35.06,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:11:35.15,0:11:38.53,Default,,0,0,0,,Хмм, сіз қалай ойлайсыз? Қалай ойлайсыз, біз жақсы араласа аламыз ба?
Dialogue: 0,0:11:38.61,0:11:39.57,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:39.65,0:11:40.57,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:11:40.65,0:11:42.20,Default,,0,0,0,,Бұл жігіт қоқыс.
Dialogue: 0,0:11:42.28,0:11:44.99,Default,,0,0,0,,Біз жақсы араласқанымызға қуаныштымын.
Dialogue: 0,0:11:45.53,0:11:48.45,Default,,0,0,0,,Дэнджи Хаякаваның бөліміне қосылады.
Dialogue: 0,0:11:48.54,0:11:49.70,Default,,0,0,0,,Шошқа?
Dialogue: 0,0:11:49.79,0:11:51.71,Default,,0,0,0,,Бұл бұзақы ма?
Dialogue: 0,0:11:51.79,0:11:55.13,Default,,0,0,0,,Мені мазалайтын нәрселер көп.
Dialogue: 0,0:11:55.21,0:11:57.29,Default,,0,0,0,,Тағы бір оғаш адамдар болса...
Dialogue: 0,0:11:57.38,0:11:59.96,Default,,0,0,0,,Мен бірлікті жасаған кезде айттым.
Dialogue: 0,0:12:00.05,0:12:03.47,Default,,0,0,0,,Оны басқа еш жерден таба алмайтын эксперименттік жүйеде іске қосып көріңіз.
Dialogue: 0,0:12:03.47,0:12:04.22,Default,,0,0,0,,Оны басқа еш жерден таба алмайтын эксперименттік жүйеде іске қосып көріңіз.
Dialogue: 0,0:12:04.72,0:12:05.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:06.80,0:12:08.97,Default,,0,0,0,,Бұл жігіт кім?
Dialogue: 0,0:12:09.06,0:12:13.19,Default,,0,0,0,,Дэнджи-кун – адам, бірақ ол шайтанға айналуы мүмкін.
Dialogue: 0,0:12:13.27,0:12:15.19,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл керемет.
Dialogue: 0,0:12:15.27,0:12:17.06,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:12:17.15,0:12:21.28,Default,,0,0,0,,Мен бұл туралы тек қауесет ретінде естідім, бірақ...
Dialogue: 0,0:12:21.36,0:12:23.61,Default,,0,0,0,,Дэнджи-кун ерекше
Dialogue: 0,0:12:24.28,0:12:28.87,Default,,0,0,0,,Сондықтан біз оны ерекше емдеуді жөн көрдік.
Dialogue: 0,0:12:28.95,0:12:32.96,Default,,0,0,0,,Егер адам қоғамдық қауіпсіздіктен бас тартса немесе заңсыз әрекетке барса.
Dialogue: 0,0:12:33.04,0:12:35.58,Default,,0,0,0,,Дэнджи-кун шайтан ретінде жойылады.
Dialogue: 0,0:12:35.67,0:12:36.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:36.79,0:12:37.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:37.71,0:12:40.88,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:12:41.51,0:12:44.68,Default,,0,0,0,,Өлгенше бірге жұмыс жасайық
Dialogue: 0,0:12:48.35,0:12:51.39,Default,,0,0,0,,Мен сені бақылау үшін сенімен бірге тұруды шештім.
Dialogue: 0,0:12:52.35,0:12:55.94,Default,,0,0,0,,Бір жерге қашып кетсең, сені өлтіре аламыз дейді.
Dialogue: 0,0:12:56.02,0:12:56.90,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:02.15,0:13:05.15,Default,,0,0,0,,Әй, Макима-сан жаман адам ба?
Dialogue: 0,0:13:05.74,0:13:08.28,Default,,0,0,0,,Егер солай ойласаң, Макима-сан, бас тарт.
Dialogue: 0,0:13:08.37,0:13:12.29,Default,,0,0,0,,Егер сен шайтан болсаң, өлтірілмейтініңе шүкір ет.
Dialogue: 0,0:13:12.37,0:13:15.29,Default,,0,0,0,,Біз шайтан іздеушілерміз.
Dialogue: 0,0:13:15.37,0:13:17.67,Default,,0,0,0,,Сонымен, сіз жақсы адамсыз ба?
Dialogue: 0,0:13:17.75,0:13:19.79,Default,,0,0,0,,Оның жақсы адам екеніне сенімдімін.
Dialogue: 0,0:13:20.92,0:13:23.30,Default,,0,0,0,,Сен менің құтқарушымсың.
Dialogue: 0,0:13:24.05,0:13:25.01,Default,,0,0,0,,Хмм…
Dialogue: 0,0:13:33.31,0:13:34.85,Default,,0,0,0,,Макима-сан…
Dialogue: 0,0:13:35.56,0:13:38.15,Default,,0,0,0,,Мен сені тағы бір рет ұстасам деп едім.
Dialogue: 0,0:13:38.23,0:13:39.86,Default,,0,0,0,,Иә!?
Dialogue: 0,0:13:41.73,0:13:45.69,Default,,0,0,0,,Құлпынай кептелісі Өрік кептелісі Апельсин джемі
Dialogue: 0,0:13:45.78,0:13:49.11,Default,,0,0,0,,Сары май мен бал және...
Dialogue: 0,0:13:49.20,0:13:51.45,Default,,0,0,0,,Сонымен қатар, аздап даршын қосайық.
Dialogue: 0,0:13:51.53,0:13:54.70,Default,,0,0,0,,Ең жақсы нан дайын!
Dialogue: 0,0:13:55.58,0:13:58.83,Default,,0,0,0,,Хмм... Хмм, дәмді!
Dialogue: 0,0:13:58.92,0:14:00.67,Default,,0,0,0,,Ммм, бұл ең күшті!
Dialogue: 0,0:14:00.67,0:14:02.09,Default,,0,0,0,,Ммм, бұл ең күшті!
Dialogue: 0,0:14:00.67,0:14:02.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:02.17,0:14:05.38,Default,,0,0,0,,Уау Уау Уау Уау Уау
Dialogue: 0,0:14:05.46,0:14:08.51,Default,,0,0,0,,Уау! Апыр-ай! Апыр-ай! Апыр-ай!
Dialogue: 0,0:14:08.59,0:14:12.05,Default,,0,0,0,,Уау Уау Уау Уау...
Dialogue: 0,0:14:12.14,0:14:13.26,Default,,0,0,0,,Монша ұзақ!
Dialogue: 0,0:14:15.93,0:14:17.73,Default,,0,0,0,,Дәретханада ұйықтама Ах...
Dialogue: 0,0:14:17.81,0:14:19.40,Default,,0,0,0,,(Дәретхананың ағу дыбысы)
Dialogue: 0,0:14:19.48,0:14:20.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:24.57,0:14:26.49,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:26.57,0:14:28.11,Default,,0,0,0,,(Төтенше көлік сиренасы)
Dialogue: 0,0:14:28.11,0:14:30.49,Default,,0,0,0,,Хигаши Нерима Уордындағы резиденцияда жын пайда болды.
Dialogue: 0,0:14:28.11,0:14:30.49,Default,,0,0,0,,(Төтенше көлік сиренасы)
Dialogue: 0,0:14:30.49,0:14:31.32,Default,,0,0,0,,(Төтенше көлік сиренасы)
Dialogue: 0,0:14:31.41,0:14:35.24,Default,,0,0,0,,Қазіргі уақытта бейбіт тұрғындарды эвакуациялау учаскені жабу аяқталды
Dialogue: 0,0:14:35.95,0:14:39.25,Default,,0,0,0,,Мақсатты жын екінші қабаттың артқы жағындағы бөлмеде қоршалған.
Dialogue: 0,0:14:39.33,0:14:41.29,Default,,0,0,0,,Қалғанын шайтан аулаушыларға қалдыр
Dialogue: 0,0:14:41.38,0:14:44.25,Default,,0,0,0,,Хаякава мырза, жаныңыздағы адам жаңа ма?
Dialogue: 0,0:14:48.84,0:14:50.76,Default,,0,0,0,,​​Әй, жын деген не?
Dialogue: 0,0:14:50.84,0:14:54.51,Default,,0,0,0,,Иә? Сіз міндетті білім алған жоқсыз ба?
Dialogue: 0,0:14:54.60,0:14:56.56,Default,,0,0,0,,О, оны қабылдамаңыз.
Dialogue: 0,0:14:56.64,0:14:57.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:58.10,0:15:02.10,Default,,0,0,0,,Адам мәйітін басып алған жын.Бұл жын.
Dialogue: 0,0:15:02.19,0:15:04.27,Default,,0,0,0,,Хмм... Иә?
Dialogue: 0,0:15:04.36,0:15:07.07,Default,,0,0,0,,А, онда мен жынмын ғой, солай ма?
Dialogue: 0,0:15:07.15,0:15:10.78,Default,,0,0,0,,No Жындардың бас пішіні ерекше.
Dialogue: 0,0:15:10.86,0:15:13.78,Default,,0,0,0,,Ал, сіз оны көргенде түсінесіз.
Dialogue: 0,0:15:13.87,0:15:15.99,Default,,0,0,0,,(Мәджиннің тынысы)
Dialogue: 0,0:15:17.58,0:15:20.25,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:20.33,0:15:24.75,Default,,0,0,0,,Ібілістің мінезі шайтан. Бұл жолы сен оны өлтіресің.
Dialogue: 0,0:15:25.34,0:15:27.38,Default,,0,0,0,,Шайтан болып, маған өз күшіңді көрсет
Dialogue: 0,0:15:27.46,0:15:30.34,Default,,0,0,0,,Қолдануға жарамды немесе жарамсыз екенін анықтаңыз.
Dialogue: 0,0:15:30.84,0:15:32.13,Default,,0,0,0,,Қарама.
Dialogue: 0,0:15:32.22,0:15:35.10,Default,,0,0,0,,Мен сені өлтіремін, мен сені өлтіремін, мен сені өлтіремін!
Dialogue: 0,0:15:35.18,0:15:37.14,Default,,0,0,0,,Ібіліс аңшылары!
Dialogue: 0,0:15:37.22,0:15:38.68,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:15:38.77,0:15:41.56,Default,,0,0,0,,Гааааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:15:41.64,0:15:44.36,Default,,0,0,0,,Уаааааааааааааааааааааааа...
Dialogue: 0,0:15:45.40,0:15:48.86,Default,,0,0,0,,Әй, сен неге шайтанның күшін қолданбадың?
Dialogue: 0,0:15:48.94,0:15:53.99,Default,,0,0,0,,Жарайды... Мен шайтанды өлтіру үшін күшімді пайдаланамын.
Dialogue: 0,0:15:54.07,0:15:55.62,Default,,0,0,0,,Бұл қатты ауыратын сияқты.
Dialogue: 0,0:15:55.70,0:15:58.24,Default,,0,0,0,,Сонымен... ah~
Dialogue: 0,0:15:58.33,0:16:01.87,Default,,0,0,0,,Мен де бұл жігітке қарап құбыжық болып кеткен шығармын.
Dialogue: 0,0:16:01.96,0:16:06.25,Default,,0,0,0,,Сондықтан мен бір нәрсені оңай өлтіргім келді...
Dialogue: 0,0:16:07.59,0:16:10.05,Default,,0,0,0,,Тыңдаңыз, мынаны есте сақтаңыз.
Dialogue: 0,0:16:10.13,0:16:12.30,Default,,0,0,0,,Маджин да жақсы шайтан.
Dialogue: 0,0:16:12.38,0:16:14.76,Default,,0,0,0,,Ібіліс аңшысы Шайтанды аяма
Dialogue: 0,0:16:15.43,0:16:19.01,Default,,0,0,0,,Менің бүкіл отбасымды шайтан менің көз алдымда өлтірді.
Dialogue: 0,0:16:19.85,0:16:22.81,Default,,0,0,0,,Мен төменде полициямен ішімдік іштім.
Dialogue: 0,0:16:22.89,0:16:26.52,Default,,0,0,0,,Мен әйелім мен балаларымды қорғау үшін жұмыста өмірімді қатерге тігемін.
Dialogue: 0,0:16:27.31,0:16:29.98,Default,,0,0,0,,Сізден басқаның бәрі байсалды.
Dialogue: 0,0:16:30.07,0:16:33.53,Default,,0,0,0,,Мен шайтанды барынша азаппен өлтіргім келеді.
Dialogue: 0,0:16:34.28,0:16:37.78,Default,,0,0,0,,Шайтанмен дос болғың келе ме?
Dialogue: 0,0:16:37.87,0:16:38.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:39.79,0:16:42.29,Default,,0,0,0,,Дос бола алатын шайтан болса, дос бол.
Dialogue: 0,0:16:43.66,0:16:45.58,Default,,0,0,0,,Мен доспын
Dialogue: 0,0:16:49.75,0:16:52.51,Default,,0,0,0,,Мен бұл сөздерді есіме аламын.
Dialogue: 0,0:16:54.38,0:16:55.55,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:00.31,0:17:03.31,Default,,0,0,0,,Иә... мен сені құлаттым.
Dialogue: 0,0:17:03.39,0:17:07.52,Default,,0,0,0,,Шындығында, мен эротикалық кітаптарға қан салғым келмеді.
Dialogue: 0,0:17:07.60,0:17:11.32,Default,,0,0,0,,Егер сіз шынжырлы араны қолдансаңыз, қан шашырап, ластанады.
Dialogue: 0,0:17:11.40,0:17:15.61,Default,,0,0,0,,Мен сені оңай өлтірдім. Мынаны ал.
Dialogue: 0,0:17:16.78,0:17:19.70,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:17:20.66,0:17:22.83,Default,,0,0,0,,Жарайды, жыныстық қатынасты растау
Dialogue: 0,0:17:23.41,0:17:26.12,Default,,0,0,0,,Маған Дэнджидің түсін көрсет
Dialogue: 0,0:17:26.21,0:17:29.38,Default,,0,0,0,,Мен де байсалдымын, Почита
Dialogue: 0,0:17:29.46,0:17:33.13,Default,,0,0,0,,Келісімшарт бойынша мен жақсы өмір сүріп жатырмын, армандаймын.
Dialogue: 0,0:17:33.84,0:17:35.88,Default,,0,0,0,,Мен бұл сөздерді есіме аламын.
Dialogue: 0,0:17:36.47,0:17:39.76,Default,,0,0,0,,Мен армандаған мақсатыма жеттім.
Dialogue: 0,0:17:39.85,0:17:41.64,Default,,0,0,0,,Ол әлі мені қуып келеді.
Dialogue: 0,0:17:44.22,0:17:46.27,Default,,0,0,0,,Күнделікті ваннаға түсіңіз
Dialogue: 0,0:17:46.35,0:17:47.35,Default,,0,0,0,,Жақсы тамақ жеңіз
Dialogue: 0,0:17:48.02,0:17:50.27,Default,,0,0,0,,Жақын жерде жақсы әйел де бар
Dialogue: 0,0:17:50.86,0:17:53.44,Default,,0,0,0,,Менің өмірім қазірдің өзінде 100 ұпай болса да
Dialogue: 0,0:17:53.53,0:17:55.82,Default,,0,0,0,,Маған бірдеңе жетіспейтін сияқты.
Dialogue: 0,0:17:55.90,0:17:59.28,Default,,0,0,0,,Бірдеңе болды ма?Шынайы, шындап, мақсат...
Dialogue: 0,0:17:59.36,0:18:02.33,Default,,0,0,0,,Ол кекшіл болуы керек.
Dialogue: 0,0:18:02.41,0:18:04.54,Default,,0,0,0,,Олар отбасын қорғайды.
Dialogue: 0,0:18:06.46,0:18:09.92,Default,,0,0,0,,Хмм... Макима-сан, саған да бірдеңе бар ма?
Dialogue: 0,0:18:10.63,0:18:12.29,Default,,0,0,0,,Макима-сан да...
Dialogue: 0,0:18:13.59,0:18:16.55,Default,,0,0,0,,Кеудеге массаж жасап көріңіз...
Dialogue: 0,0:18:20.72,0:18:21.55,Default,,0,0,0,,Га
Dialogue: 0,0:18:22.43,0:18:25.64,Default,,0,0,0,,Мен бұл мүмкін емес деп баяғыда берілдім.
Dialogue: 0,0:18:25.72,0:18:29.44,Default,,0,0,0,,Егер менде дәл қазір лайықты жұмыс болса, мен қиындыққа тап болмас па едім?
Dialogue: 0,0:18:29.52,0:18:32.69,Default,,0,0,0,,Мен үшін кенеттен әйелді құшақтап алу қиын.
Dialogue: 0,0:18:33.23,0:18:34.44,Default,,0,0,0,,Бірақ егер бұл кеуде болса...
Dialogue: 0,0:18:35.57,0:18:38.82,Default,,0,0,0,,Ерік-жігерің күшті болса, кеудеңді ысқылауға болады...
Dialogue: 0,0:18:38.90,0:18:41.62,Default,,0,0,0,,Сізден басқаның бәрі байсалды.
Dialogue: 0,0:18:41.70,0:18:43.33,Default,,0,0,0,,​​Бұл нені білдіреді?
Dialogue: 0,0:18:44.20,0:18:46.87,Default,,0,0,0,,Мен өзімнің байыптылығымды таптым
Dialogue: 0,0:18:46.95,0:18:50.12,Default,,0,0,0,,Менің мақсатым...
Dialogue: 0,0:18:50.21,0:18:51.63,Default,,0,0,0,,Кеуделер!
Dialogue: 0,0:18:52.21,0:18:53.25,Default,,0,0,0,,Мунеда?
Dialogue: 0,0:18:53.34,0:18:56.09,Default,,0,0,0,,Ей, мені тыңда, ақымақ!
Dialogue: 0,0:18:56.17,0:18:57.01,Default,,0,0,0,,Әңгіме?
Dialogue: 0,0:18:57.09,0:19:00.51,Default,,0,0,0,,Мен Денджиден бүгіннен бастап менімен достасуды сұраймын.
Dialogue: 0,0:19:01.05,0:19:02.14,Default,,0,0,0,,Досым ба?
Dialogue: 0,0:19:02.22,0:19:05.14,Default,,0,0,0,,Қоғамдық қауіпсіздікте кішігірім миссиялар мен патрульдер бар
Dialogue: 0,0:19:05.22,0:19:09.89,Default,,0,0,0,,Қауіпсіздік мақсатында біз жұппен қозғалуымыз керек.
Dialogue: 0,0:19:09.98,0:19:10.48,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:10.48,0:19:12.86,Default,,0,0,0,,Дұрыс, осында тұрған сияқты.
Dialogue: 0,0:19:10.48,0:19:12.86,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:12.86,0:19:12.94,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:12.94,0:19:13.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:12.94,0:19:13.90,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:13.98,0:19:15.77,Default,,0,0,0,,Абайлаңыз (есіктің ашылған дыбысы)
Dialogue: 0,0:19:15.86,0:19:17.15,Default,,0,0,0,,Өйткені ол жын
Dialogue: 0,0:19:18.69,0:19:21.41,Default,,0,0,0,,Ой! Адамға тағзым!
Dialogue: 0,0:19:21.49,0:19:25.49,Default,,0,0,0,,Менің атым "Пауэр Buddy" Unu ма?!
Dialogue: 0,0:19:25.99,0:19:29.66,Default,,0,0,0,,Қуат!? Қуатты атаңыз!? Не, сен жынсың ба!?
Dialogue: 0,0:19:30.29,0:19:33.00,Default,,0,0,0,,Жынның шайтан аулаушыға айналуы дұрыс па?
Dialogue: 0,0:19:33.08,0:19:33.92,Default,,0,0,0,,Ах
Dialogue: 0,0:19:36.25,0:19:39.26,Default,,0,0,0,,Жарайды, танысқаныма қуаныштымын!
Dialogue: 0,0:19:39.34,0:19:40.17,Default,,0,0,0,,Я...
Dialogue: 0,0:19:40.26,0:19:43.43,Default,,0,0,0,,Жындар да жындар сияқты жойылу мақсаты болып табылады.
Dialogue: 0,0:19:43.51,0:19:45.51,Default,,0,0,0,,Пауэр-чан өте ұтымды, сондықтан мен оны Хаякава-кунның тобына қостым.
Dialogue: 0,0:19:45.51,0:19:46.68,Default,,0,0,0,,Пауэр-чан өте ұтымды, сондықтан мен оны Хаякава-кунның тобына қостым.
Dialogue: 0,0:19:45.51,0:19:46.68,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:19:46.68,0:19:48.18,Default,,0,0,0,,Пауэр-чан өте ұтымды, сондықтан мен оны Хаякава-кунның тобына қостым.
Dialogue: 0,0:19:48.85,0:19:50.35,Default,,0,0,0,,Бұрын айтқанымдай
Dialogue: 0,0:19:50.43,0:19:54.19,Default,,0,0,0,,Қоғамдық қауіпсіздіктің жындарға қарсы арнайы бөлімі 4 эксперименттік бөлім болып табылады.
Dialogue: 0,0:19:54.27,0:19:55.81,Default,,0,0,0,,Нәтиже ала алмасаңыз
Dialogue: 0,0:19:55.90,0:19:59.44,Default,,0,0,0,,Жоғарғы жақтағы адамдар оны жақын арада бөлшектейтін шығар.
Dialogue: 0,0:19:59.53,0:20:03.57,Default,,0,0,0,,Егер бұл орын алса, сізге не болатынын білесіз бе?
Dialogue: 0,0:20:03.66,0:20:04.95,Default,,0,0,0,,Хмм... (Қуат) Мм...
Dialogue: 0,0:20:09.79,0:20:12.96,Default,,0,0,0,,Пауэр-чанның басында мүйіздері бар.
Dialogue: 0,0:20:13.04,0:20:16.17,Default,,0,0,0,,Тек қозғалысы аз аумақтарды патрульдеу.
Dialogue: 0,0:20:16.88,0:20:18.09,Default,,0,0,0,,Хмм... мм...
Dialogue: 0,0:20:18.17,0:20:19.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:20.01,0:20:21.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:23.38,0:20:24.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:25.51,0:20:26.35,Default,,0,0,0,,Ni...
Dialogue: 0,0:20:26.43,0:20:29.35,Default,,0,0,0,,Адам! Маған тезірек бірдеңені өлтіруге рұқсат етіңіз!
Dialogue: 0,0:20:29.43,0:20:31.64,Default,,0,0,0,,Бүркіт қанға шөлдеді.
Dialogue: 0,0:20:31.73,0:20:32.60,Default,,0,0,0,,Я...
Dialogue: 0,0:20:32.68,0:20:34.60,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:20:34.69,0:20:38.61,Default,,0,0,0,,Белгілі бір дәрежеде ақылға қонымсыз болса, мен оны ренжітпесе ғана кешіре аламын.
Dialogue: 0,0:20:39.73,0:20:42.61,Default,,0,0,0,,Сұрақ кеудеге қалай массаж жасау керек.
Dialogue: 0,0:20:43.36,0:20:44.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:45.28,0:20:47.87,Default,,0,0,0,,Егер сіз азаматтық шайтан аңшысын кездестірсеңіз
Dialogue: 0,0:20:47.95,0:20:49.74,Default,,0,0,0,,Полиция қызметкері жауап бергенде...
Dialogue: 0,0:20:49.74,0:20:51.12,Default,,0,0,0,,Полиция қызметкері жауап бергенде...
Dialogue: 0,0:20:49.74,0:20:51.12,Default,,0,0,0,,Сізбен бір сәт сөйлесе аламын ба?
Dialogue: 0,0:20:51.20,0:20:54.37,Default,,0,0,0,,Қоғамдық қауіпсіздіктің сиқырға қарсы арнайы бөлімі 4
Dialogue: 0,0:20:54.46,0:20:56.33,Default,,0,0,0,,Егер... десеңіз және дәптеріңізді көрсетсеңіз,
Dialogue: 0,0:20:56.42,0:20:58.17,Default,,0,0,0,,Мен үйге жиіркенішті кейіппен қайтамын.
Dialogue: 0,0:20:58.25,0:20:59.25,Default,,0,0,0,,Ммм... (Қуат) Ммм?
Dialogue: 0,0:21:01.46,0:21:03.34,Default,,0,0,0,,Бұл мүлде шайтан емес.
Dialogue: 0,0:21:03.42,0:21:06.55,Default,,0,0,0,,Мүмкін бұл менің кінәм шығар.
Dialogue: 0,0:21:06.64,0:21:07.97,Default,,0,0,0,,Мен жын болғанға дейін
Dialogue: 0,0:21:08.05,0:21:10.60,Default,,0,0,0,,Ол өте қорқынышты шайтан еді.
Dialogue: 0,0:21:11.31,0:21:14.14,Default,,0,0,0,,Кішкентай шайтан бүркіттің иісінен қашады.
Dialogue: 0,0:21:14.23,0:21:15.31,Default,,0,0,0,,Иә!? (Күш) Фуфуфуфу…
Dialogue: 0,0:21:15.39,0:21:16.98,Default,,0,0,0,,Сонда біз нәтиже шығара алмаймыз...
Dialogue: 0,0:21:17.06,0:21:18.11,Default,,0,0,0,,Ах
Dialogue: 0,0:21:18.19,0:21:21.86,Default,,0,0,0,,Сұрағыңыз келетін нәрсе болса, Хаякавадан сұраңыз.
Dialogue: 0,0:21:22.69,0:21:24.03,Default,,0,0,0,,Өйткені ол сендерді біріктірді
Dialogue: 0,0:21:24.03,0:21:24.61,Default,,0,0,0,,Өйткені ол сендерді біріктірді
Dialogue: 0,0:21:24.70,0:21:27.99,Default,,0,0,0,,Бейбақ, сен мені ұрдың.
Dialogue: 0,0:21:28.07,0:21:31.41,Default,,0,0,0,,Қуатпен бірлесіп, маған белсенді рөл ойнауға рұқсат бермеңіз.
Dialogue: 0,0:21:31.49,0:21:32.49,Default,,0,0,0,,Сіз мені жұмыстан шығаруға тырысып жатырсыз.
Dialogue: 0,0:21:32.49,0:21:34.00,Default,,0,0,0,,Сіз мені жұмыстан шығаруға тырысып жатырсыз.
Dialogue: 0,0:21:32.49,0:21:34.00,Default,,0,0,0,,Мен оны айтпақшы емеспін… Аах!
Dialogue: 0,0:21:34.08,0:21:35.29,Default,,0,0,0,,(Қуатты иіскеу дыбысы)
Dialogue: 0,0:21:35.37,0:21:36.46,Default,,0,0,0,,О!
Dialogue: 0,0:21:37.21,0:21:39.79,Default,,0,0,0,,Қанның иісі бар!Хехе
Dialogue: 0,0:21:39.88,0:21:43.09,Default,,0,0,0,,Әй... Әй, жүр!Қайда барасың!?
Dialogue: 0,0:21:43.17,0:21:44.01,Default,,0,0,0,,А...
Dialogue: 0,0:21:44.09,0:21:45.92,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:21:46.01,0:21:46.97,Default,,0,0,0,,Хехе...
Dialogue: 0,0:21:47.05,0:21:49.09,Default,,0,0,0,,Бұл ойын, бұл ойын!
Dialogue: 0,0:21:49.18,0:21:50.97,Default,,0,0,0,,Күресейік!
Dialogue: 0,0:21:51.05,0:21:51.93,Default,,0,0,0,,Жылдам аяқ!
Dialogue: 0,0:21:52.01,0:21:55.68,Default,,0,0,0,,Сайтты жабу және азаматтық эвакуациялау аяқталды.
Dialogue: 0,0:21:55.77,0:21:58.56,Default,,0,0,0,,Теңіз қияр шайтаны теңіз қияр шайтаны
Dialogue: 0,0:21:58.65,0:21:59.19,Default,,0,0,0,,Нерима станциясының алдында бізді қолдаңыз.
Dialogue: 0,0:21:59.19,0:22:00.44,Default,,0,0,0,,Нерима станциясының алдында бізді қолдаңыз.
Dialogue: 0,0:21:59.19,0:22:00.44,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:22:00.44,0:22:01.02,Default,,0,0,0,,Нерима станциясының алдында бізді қолдаңыз.
Dialogue: 0,0:22:01.11,0:22:04.07,Default,,0,0,0,,Жоқ, бұл теңіз қияры.Теңіз қияры, түсіндің бе?
Dialogue: 0,0:22:04.15,0:22:05.28,Default,,0,0,0,,Хи хи
Dialogue: 0,0:22:05.36,0:22:07.40,Default,,0,0,0,,Иә?Жоқ, сондықтан...
Dialogue: 0,0:22:07.49,0:22:08.66,Default,,0,0,0,,Иә! (Ібіліс аңшысы) Қауіпті
Dialogue: 0,0:22:08.74,0:22:12.49,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:22:12.58,0:22:13.91,Default,,0,0,0,,Nameko…
Dialogue: 0,0:22:13.99,0:22:17.66,Default,,0,0,0,,Қалай десеңші!Бұл менің несием!
Dialogue: 0,0:22:17.75,0:22:21.13,Default,,0,0,0,,Гехахаха...гахахаха...
Dialogue: 0,0:22:21.21,0:22:22.67,Default,,0,0,0,,Гехехе... Гехет Гехет...
Dialogue: 0,0:22:22.75,0:22:25.92,Default,,0,0,0,,Гахаха...
Dialogue: 0,0:22:26.01,0:22:31.01,Default,,0,0,0,,♪～
Dialogue: 0,0:23:50.92,0:23:55.93,Default,,0,0,0,,～♪
