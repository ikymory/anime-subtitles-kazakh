Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.33,0:00:06.63,Default,,0,0,0,,Хаха...
Dialogue: 0,0:00:06.71,0:00:09.46,Default,,0,0,0,,Жүр, мені қорға!
Dialogue: 0,0:00:09.55,0:00:12.47,Default,,0,0,0,,Қажетсіз ештеңе жасама, қарғыс атсын.
Dialogue: 0,0:00:13.22,0:00:18.05,Default,,0,0,0,,Басқа біреуден қарыз алудан шаршадым.
Dialogue: 0,0:00:18.64,0:00:20.93,Default,,0,0,0,,Егер сіз шыға алсаңыз, сізге ештеңе қарызға алудың қажеті жоқ!
Dialogue: 0,0:00:20.93,0:00:21.98,Default,,0,0,0,,Егер сіз шыға алсаңыз, сізге ештеңе қарызға алудың қажеті жоқ!
Dialogue: 0,0:00:20.93,0:00:21.98,Default,,0,0,0,,(Араның дыбысы)
Dialogue: 0,0:00:21.98,0:00:22.81,Default,,0,0,0,,(Араның дыбысы)
Dialogue: 0,0:00:22.89,0:00:24.27,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:00:24.35,0:00:26.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:28.19,0:00:29.19,Default,,0,0,0,,Ах (Арай) Ах.
Dialogue: 0,0:00:31.28,0:00:32.11,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:00:32.19,0:00:37.45,Default,,0,0,0,,(Мәңгілік шайтанның күлкісі)
Dialogue: 0,0:00:37.53,0:00:39.33,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:39.41,0:00:41.70,Default,,0,0,0,,(Мәңгілік шайтанның айқайы)
Dialogue: 0,0:00:41.79,0:00:42.70,Default,,0,0,0,,Га
Dialogue: 0,0:00:42.79,0:00:45.08,Default,,0,0,0,,О! (Мәңгілік шайтанның айқайы)
Dialogue: 0,0:00:45.17,0:00:46.83,Default,,0,0,0,,Уф
Dialogue: 0,0:00:47.63,0:00:48.84,Default,,0,0,0,,Уф
Dialogue: 0,0:00:50.30,0:00:53.76,Default,,0,0,0,,Chainsaw әлі тірі!
Dialogue: 0,0:00:55.09,0:00:56.84,Default,,0,0,0,,Ааааа…
Dialogue: 0,0:00:56.93,0:00:59.26,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:01:00.35,0:01:02.77,Default,,0,0,0,,Жүр!
Dialogue: 0,0:01:02.85,0:01:04.23,Default,,0,0,0,,Уф
Dialogue: 0,0:01:04.31,0:01:06.90,Default,,0,0,0,,Толық емделді!(Мәңгілік Ібіліс) Гува~
Dialogue: 0,0:01:07.52,0:01:09.02,Default,,0,0,0,,Шынжырлы араны қолданбаңыз
Dialogue: 0,0:01:09.11,0:01:12.53,Default,,0,0,0,,Уф (Мәңгілік жын) Ауырады... Ауырды...
Dialogue: 0,0:01:12.61,0:01:15.11,Default,,0,0,0,,Менің жүрегім мұнда емес
Dialogue: 0,0:01:15.20,0:01:17.11,Default,,0,0,0,,Мен сені өлтіре алмаймын.
Dialogue: 0,0:01:17.20,0:01:18.20,Default,,0,0,0,,Гяаа...
Dialogue: 0,0:01:18.28,0:01:19.95,Default,,0,0,0,,Гррррр
Dialogue: 0,0:01:21.03,0:01:22.04,Default,,0,0,0,,Уф
Dialogue: 0,0:01:22.12,0:01:23.04,Default,,0,0,0,,Га
Dialogue: 0,0:01:23.12,0:01:25.16,Default,,0,0,0,,Гррррр
Dialogue: 0,0:01:27.83,0:01:28.75,Default,,0,0,0,,Ібіліс…
Dialogue: 0,0:01:28.83,0:01:30.75,Default,,0,0,0,,Жағымсыз
Dialogue: 0,0:01:31.34,0:01:33.80,Default,,0,0,0,,Дэнджидің қаны таусылады.
Dialogue: 0,0:01:33.88,0:01:35.63,Default,,0,0,0,,Бұл жағдайда, бұл шынжырлы ара
Dialogue: 0,0:01:35.72,0:01:37.13,Default,,0,0,0,,Мен артқа шегінемін.
Dialogue: 0,0:01:37.97,0:01:39.30,Default,,0,0,0,,Гаааа... Уф
Dialogue: 0,0:01:40.35,0:01:43.01,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:01:43.10,0:01:45.81,Default,,0,0,0,,Ол бұрынғыдан әлдеқайда әлсіз.
Dialogue: 0,0:01:45.89,0:01:47.69,Default,,0,0,0,,Патетикалық ара
Dialogue: 0,0:01:47.77,0:01:51.94,Default,,0,0,0,,Ааааааааааааааааааааааааа...
Dialogue: 0,0:01:53.15,0:01:58.15,Default,,0,0,0,,♪～
Dialogue: 0,0:03:14.73,0:03:19.74,Default,,0,0,0,,～♪
Dialogue: 0,0:03:23.53,0:03:25.41,Default,,0,0,0,,Ооо...
Dialogue: 0,0:03:25.49,0:03:26.87,Default,,0,0,0,,Уф
Dialogue: 0,0:03:27.74,0:03:31.50,Default,,0,0,0,,Уаа... арх... уф...
Dialogue: 0,0:03:31.58,0:03:32.42,Default,,0,0,0,,Ах!?
Dialogue: 0,0:03:32.50,0:03:36.42,Default,,0,0,0,,Ара кері шегінді, қан жеткіліксіз болды.
Dialogue: 0,0:03:36.50,0:03:38.09,Default,,0,0,0,,Сіздің шығыныңыз
Dialogue: 0,0:03:38.17,0:03:39.92,Default,,0,0,0,,Шынжырлы ара
Dialogue: 0,0:03:40.01,0:03:41.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:41.38,0:03:43.68,Default,,0,0,0,,Уф... (Дэнджидің жұтынған дыбысы)
Dialogue: 0,0:03:43.76,0:03:45.68,Default,,0,0,0,,Уф (мәңгілік шайтан) Гяаааааааааааааааааа
Dialogue: 0,0:03:45.76,0:03:47.18,Default,,0,0,0,,Уаааа
Dialogue: 0,0:03:47.26,0:03:48.77,Default,,0,0,0,,Гррр…
Dialogue: 0,0:03:48.85,0:03:49.68,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:49.77,0:03:52.69,Default,,0,0,0,,Ауыр қан болса да, ағынды қараңыз
Dialogue: 0,0:03:52.77,0:03:56.69,Default,,0,0,0,,Ауырған жүзіңізге қарап ішейік...
Dialogue: 0,0:03:56.77,0:04:00.36,Default,,0,0,0,,Құлпынай кептелісін қараңыз!
Dialogue: 0,0:04:00.44,0:04:02.86,Default,,0,0,0,,Ухяхаха... Ухахаха...
Dialogue: 0,0:04:02.95,0:04:05.62,Default,,0,0,0,,Ібіліс аңшы шайтаннан қорқады...
Dialogue: 0,0:04:06.53,0:04:07.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:09.62,0:04:12.37,Default,,0,0,0,,Басындағы бұрандасы ұшып кеткен.
Dialogue: 0,0:04:16.21,0:04:18.63,Default,,0,0,0,,Савара лайықты болды.
Dialogue: 0,0:04:19.75,0:04:21.38,Default,,0,0,0,,Сондықтан мен өлдім
Dialogue: 0,0:04:21.46,0:04:25.13,Default,,0,0,0,,Kinouchi де лайықты Субару да лайықты
Dialogue: 0,0:04:25.22,0:04:27.01,Default,,0,0,0,,Сасаки де лайықты
Dialogue: 0,0:04:27.10,0:04:30.93,Default,,0,0,0,,Мен жындардың шабуылынан қорқамын, өйткені мен әдептімін.
Dialogue: 0,0:04:31.02,0:04:33.94,Default,,0,0,0,,Қорқыныш шайтанның күшіне айналады.
Dialogue: 0,0:04:34.85,0:04:39.02,Default,,0,0,0,,Акимен жұмыс істеу туралы не айтасыз?
Dialogue: 0,0:04:39.94,0:04:40.78,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:04:40.86,0:04:45.78,Default,,0,0,0,,Мылтық жігіт, сен өлтірмек болған адамның есі дұрыс адам болуы мүмкін емес.
Dialogue: 0,0:04:46.49,0:04:50.54,Default,,0,0,0,,Сіз қоғамдық қауіпсіздік күштеріне қарулы жігіттерді өлтіргіңіз келгендіктен қосылдыңыз, солай емес пе?
Dialogue: 0,0:04:51.20,0:04:54.16,Default,,0,0,0,,Бұл басындағы бұранда ұшып кетті ме?
Dialogue: 0,0:04:54.91,0:04:56.17,Default,,0,0,0,,Мен жынды емеспін.
Dialogue: 0,0:04:56.25,0:05:01.05,Default,,0,0,0,,Иә, сіз де қарулы жігітті өлтіргіңіз келеді.
Dialogue: 0,0:05:01.13,0:05:03.67,Default,,0,0,0,,Ібіліс аулаушылардың көпшілігі ойлайды
Dialogue: 0,0:05:03.76,0:05:06.84,Default,,0,0,0,,Адал, тура және қарапайым
Dialogue: 0,0:05:06.93,0:05:10.93,Default,,0,0,0,,Сондықтан да жындар да қорқуды біледі.
Dialogue: 0,0:05:11.51,0:05:16.19,Default,,0,0,0,,Бірақ бұрандалары бар жігіттің не ойлайтынын білмеймін.
Dialogue: 0,0:05:16.27,0:05:20.11,Default,,0,0,0,,Тіпті шайтанның өзі түсінбейтін нәрселерден қорқады.
Dialogue: 0,0:05:21.27,0:05:22.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:22.65,0:05:24.82,Default,,0,0,0,,Ұстаз, сіз ішімдікті көп ішесіз.
Dialogue: 0,0:05:24.90,0:05:27.03,Default,,0,0,0,,Иә, бұл лайықты
Dialogue: 0,0:05:27.11,0:05:30.16,Default,,0,0,0,,Күнделікті жинақтау бұрандаларды босатып жіберді.
Dialogue: 0,0:05:34.00,0:05:35.33,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:35.41,0:05:38.17,Default,,0,0,0,,Ол Баддидің бейітін зиярат етуге ай сайын келетін сияқты.
Dialogue: 0,0:05:38.25,0:05:40.42,Default,,0,0,0,,Бұранда қатты қалады.
Dialogue: 0,0:05:41.17,0:05:42.96,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:05:43.05,0:05:46.09,Default,,0,0,0,,Аки әлі кішкентай шабақ, сондықтан өзіңізді жаттықтырыңыз.
Dialogue: 0,0:05:46.97,0:05:48.47,Default,,0,0,0,,Мен мұны ақырын жасаймын.
Dialogue: 0,0:05:49.30,0:05:50.72,Default,,0,0,0,,Баяу жүру жақсы емес
Dialogue: 0,0:05:51.43,0:05:55.10,Default,,0,0,0,,Акидің жігіті ет кесектерін шындап жинап жатыр, солай ма?
Dialogue: 0,0:05:55.18,0:05:58.48,Default,,0,0,0,,Ол ақырында мылтықпен айналысатын жігітке жетеді.
Dialogue: 0,0:06:13.66,0:06:14.49,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:06:14.58,0:06:17.83,Default,,0,0,0,,Маған ұнамайды, ұнамайды, маған ұнамайды ...
Dialogue: 0,0:06:19.83,0:06:20.83,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:06:21.63,0:06:25.92,Default,,0,0,0,,Аки-кун, неге бізге қосылып, жұмыс орнын жеке секторға ауыстырмайсың?
Dialogue: 0,0:06:26.42,0:06:29.68,Default,,0,0,0,,Ол мені өте жақсы ақшаға шақырып жатыр.
Dialogue: 0,0:06:29.76,0:06:32.18,Default,,0,0,0,,Мылтық жігіттерді қуудың қажеті жоқ
Dialogue: 0,0:06:32.26,0:06:37.02,Default,,0,0,0,,Мен түскі асты мұнда немесе сол жерде ішемін, кейде үйге қайтар жолда киноға барамын.
Dialogue: 0,0:06:37.10,0:06:39.19,Default,,0,0,0,,Күн сайын осылай өмір сүрген дұрыс.
Dialogue: 0,0:06:40.39,0:06:42.73,Default,,0,0,0,,Мен сенімен қанша сусын алғым келсе, соған шығамын.
Dialogue: 0,0:06:42.81,0:06:45.73,Default,,0,0,0,,Бірақ мен ешқашан жеке секторға бармаймын.
Dialogue: 0,0:06:46.44,0:06:48.24,Default,,0,0,0,,Мен бадам тофуын аламын.
Dialogue: 0,0:06:49.45,0:06:52.12,Default,,0,0,0,,Жарайды, маған темекі қалдырыңыз.
Dialogue: 0,0:06:59.62,0:07:03.75,Default,,0,0,0,,Мылтық жынымен соғыссаң, Аки міндетті түрде өлтіріледі.
Dialogue: 0,0:07:04.79,0:07:07.63,Default,,0,0,0,,Бізде әлі де қабілет жетіспесе де
Dialogue: 0,0:07:07.71,0:07:11.30,Default,,0,0,0,,Жау бір сәтте жүздеген адамды өлтіруі мүмкін. Бұл олардың жын болғандықтан емес.
Dialogue: 0,0:07:12.43,0:07:17.52,Default,,0,0,0,,Өйткені Аки-кун салқын, байсалды және мейірімді...
Dialogue: 0,0:07:18.10,0:07:20.77,Default,,0,0,0,,Өйткені мен де басқалар сияқты қарапайым адаммын.
Dialogue: 0,0:07:21.69,0:07:22.52,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:24.36,0:07:26.02,Default,,0,0,0,,Уа!
Dialogue: 0,0:07:26.11,0:07:29.57,Default,,0,0,0,,Гррр…
Dialogue: 0,0:07:29.65,0:07:30.65,Default,,0,0,0,,Ах
Dialogue: 0,0:07:34.32,0:07:36.62,Default,,0,0,0,,О... мен жасадым.
Dialogue: 0,0:07:39.95,0:07:41.79,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:42.42,0:07:43.54,Default,,0,0,0,,Егер бұл адам...
Dialogue: 0,0:07:44.42,0:07:45.75,Default,,0,0,0,,Менің бір ойым бар
Dialogue: 0,0:07:45.84,0:07:47.55,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:07:47.63,0:07:50.67,Default,,0,0,0,,Сені мен кесіп, қаныңды төгіп тастадым.
Dialogue: 0,0:07:51.26,0:07:54.68,Default,,0,0,0,,Қаныңды ішіп, сауығып кетемін!
Dialogue: 0,0:07:54.76,0:07:58.64,Default,,0,0,0,,Мәңгілік қозғалыс машинасы аяқталды!
Dialogue: 0,0:07:58.72,0:07:59.93,Default,,0,0,0,,Ішек
Dialogue: 0,0:08:00.02,0:08:03.48,Default,,0,0,0,,Нобель сыйлығы енді менікі!
Dialogue: 0,0:08:03.56,0:08:06.19,Default,,0,0,0,,Ухахаха... Гухахаха...
Dialogue: 0,0:08:06.86,0:08:09.69,Default,,0,0,0,,Бұл жігіт ең ессіз болса
Dialogue: 0,0:08:10.40,0:08:12.95,Default,,0,0,0,,Сіз қарулы жігітті өлтіре аласыз.
Dialogue: 0,0:08:13.03,0:08:17.91,Default,,0,0,0,,Уфхххххххххххххххххххххххх
Dialogue: 0,0:08:21.37,0:08:25.75,Default,,0,0,0,,Ух... а...
Dialogue: 0,0:08:25.83,0:08:28.29,Default,,0,0,0,,Хмм... аа...
Dialogue: 0,0:08:31.05,0:08:32.72,Default,,0,0,0,,Я...
Dialogue: 0,0:08:32.80,0:08:34.72,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:08:34.80,0:08:36.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:37.80,0:08:38.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:40.06,0:08:41.97,Default,,0,0,0,,Аки-кун, сен әлі тірісің бе?
Dialogue: 0,0:08:45.69,0:08:49.48,Default,,0,0,0,,Қанша уақыт… бұл қанша уақыт болды?
Dialogue: 0,0:08:50.27,0:08:53.61,Default,,0,0,0,,Содан бері шамамен 3 күн өтті...
Dialogue: 0,0:08:54.45,0:08:55.86,Default,,0,0,0,,Меовко…
Dialogue: 0,0:08:56.45,0:08:59.66,Default,,0,0,0,,Барлығымыз сыртқа сусын ішейік
Dialogue: 0,0:09:00.28,0:09:03.62,Default,,0,0,0,,Енді бітті, мен біраз ұйықтайын деп жатырмын.
Dialogue: 0,0:09:05.00,0:09:06.62,Default,,0,0,0,,Ол аяқталды ма?
Dialogue: 0,0:09:08.50,0:09:10.88,Default,,0,0,0,,Бұл менің негізгі ойым
Dialogue: 0,0:09:10.96,0:09:13.26,Default,,0,0,0,,Бұл менің жүрегім. Өтінемін тез өлтіріңізші.
Dialogue: 0,0:09:13.34,0:09:15.09,Default,,0,0,0,,Кешіріңіз. Кешіріңіз.
Dialogue: 0,0:09:15.17,0:09:16.01,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:09:16.09,0:09:18.68,Default,,0,0,0,,Бәрі бітті ме!?
Dialogue: 0,0:09:18.76,0:09:23.02,Default,,0,0,0,,Бассейнде болу өте жақсы болды!
Dialogue: 0,0:09:23.68,0:09:24.52,Default,,0,0,0,,Уф (Мәңгілік Ібіліс) Гяаа
Dialogue: 0,0:09:34.28,0:09:35.57,Default,,0,0,0,,шықты
Dialogue: 0,0:09:38.91,0:09:42.70,Default,,0,0,0,,Мен мылтықтан шайтанның етінің бір бөлігін алдым, қазір күн ашық.
Dialogue: 0,0:09:42.79,0:09:45.20,Default,,0,0,0,,Боқтықтан кейін өзімді жақсы сезінемін
Dialogue: 0,0:09:45.29,0:09:47.71,Default,,0,0,0,,Ол қалқып бара жатқан сияқты...
Dialogue: 0,0:09:49.71,0:09:50.84,Default,,0,0,0,,…және
Dialogue: 0,0:09:51.42,0:09:53.59,Default,,0,0,0,,Мен ұйықтап қалдым
Dialogue: 0,0:09:54.46,0:09:57.34,Default,,0,0,0,,Мен ұйықтамай жындарды өлтіре бердім.
Dialogue: 0,0:09:59.39,0:10:02.60,Default,,0,0,0,,Біз Аки мен Дэнджиді ауруханаға апарамыз.
Dialogue: 0,0:10:02.68,0:10:06.10,Default,,0,0,0,,Қалған екеуміз бұл жолы болған оқиғаны баяндауға бардық.
Dialogue: 0,0:10:06.18,0:10:08.06,Default,,0,0,0,,Иә...
Dialogue: 0,0:10:13.86,0:10:15.82,Default,,0,0,0,,Жаңадан келгендерді қарсы алу кеші ме?
Dialogue: 0,0:10:15.90,0:10:19.57,Default,,0,0,0,,Қарасам, 4 бөлім де ешқашан жиналмаған.
Dialogue: 0,0:10:19.66,0:10:21.32,Default,,0,0,0,,Достығымызды тереңдете отырып
Dialogue: 0,0:10:21.41,0:10:24.54,Default,,0,0,0,,Қазір бізде бар проблемаларды жойайық.
Dialogue: 0,0:10:24.62,0:10:25.58,Default,,0,0,0,,Мәселе?
Dialogue: 0,0:10:25.66,0:10:27.12,Default,,0,0,0,,Міне~
Dialogue: 0,0:10:27.20,0:10:30.75,Default,,0,0,0,,Кобени-чан мен Арай-кун қоғамдық қауіпсіздіктен бас тартады, солай емес пе?
Dialogue: 0,0:10:30.83,0:10:33.50,Default,,0,0,0,,Мен шайтаннан қорқып қана қойған жоқпын;
Dialogue: 0,0:10:33.59,0:10:36.26,Default,,0,0,0,,Менің ойымша, ол Дэнджи-кунды өлтірмек болғанына өкінеді.
Dialogue: 0,0:10:37.17,0:10:39.63,Default,,0,0,0,,Химено-сенпай да оны өлтірмек болды, солай ма?
Dialogue: 0,0:10:39.72,0:10:44.26,Default,,0,0,0,,Эй!Осылай тастадым, қазіргі балам.
Dialogue: 0,0:10:44.35,0:10:47.14,Default,,0,0,0,,Батыл өмір сүрейік, солай ма?
Dialogue: 0,0:10:48.02,0:10:51.40,Default,,0,0,0,,Егер сіз ішімдік ішіп жатсаңыз, Дэнджи-куннан тез кешірім сұрауыңызға болады.
Dialogue: 0,0:10:51.48,0:10:53.73,Default,,0,0,0,,Сіз Кобени-чанды және басқаларды тоқтата аласыз, солай ма?
Dialogue: 0,0:10:53.81,0:10:55.19,Default,,0,0,0,,Сіз жай ғана ішкіңіз келеді, солай ма?
Dialogue: 0,0:10:56.19,0:10:57.40,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:10:57.49,0:11:00.15,Default,,0,0,0,,Кішкентай болса да, бір кесек ет болды.
Dialogue: 0,0:11:00.74,0:11:03.28,Default,,0,0,0,,Егер мен оны ішетін болсам, бұл сөзсіз осы аптада.
Dialogue: 0,0:11:03.37,0:11:04.78,Default,,0,0,0,,Иә? Неліктен?
Dialogue: 0,0:11:04.87,0:11:08.37,Default,,0,0,0,,Мен бәрібір ішетін болсам, Макима-санмен бірге ішкім келеді.
Dialogue: 0,0:11:15.46,0:11:18.05,Default,,0,0,0,,Макима келесі аптадан бастап Киотоға іссапармен барады.
Dialogue: 0,0:11:18.13,0:11:22.18,Default,,0,0,0,,Дэнжи жынның шабуылына ұшырағаннан кейін қолдау іздейтін сияқты.
Dialogue: 0,0:11:22.26,0:11:24.72,Default,,0,0,0,,Сондықтан бұл апта ішуге ең жақсы уақыт.
Dialogue: 0,0:11:27.43,0:11:31.31,Default,,0,0,0,,Адалдық Денджи кім деп ойлайсыз?
Dialogue: 0,0:11:33.15,0:11:36.77,Default,,0,0,0,,Басқа жын Дэнджи-кун туралы білген сияқты.
Dialogue: 0,0:11:36.86,0:11:38.82,Default,,0,0,0,,Мен сені бірінші рет көріп тұрмын.
Dialogue: 0,0:11:38.90,0:11:43.57,Default,,0,0,0,,Ең жұмбақ нәрсе - Макима-санның Дэнджи-кунға қамқорлығы.
Dialogue: 0,0:11:45.66,0:11:49.75,Default,,0,0,0,,Макима-сан, сен барлық жерде жүрсің, бірақ соңғы кездері Токиода болдың.
Dialogue: 0,0:11:49.83,0:11:51.83,Default,,0,0,0,,Себебі Дэнджи осында, солай емес пе?
Dialogue: 0,0:11:52.37,0:11:55.21,Default,,0,0,0,,Мүмкін бұл мен Дэнджи-кунның құпиясын білгендіктен шығар.
Dialogue: 0,0:11:59.42,0:12:01.22,Default,,0,0,0,,Макима-сан, мен сені мас қылып, бірдеңе сұрайын.
Dialogue: 0,0:12:03.88,0:12:05.22,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:05.30,0:12:07.60,Default,,0,0,0,,Уау~ Иісі өте жақсы~
Dialogue: 0,0:12:07.68,0:12:10.98,Default,,0,0,0,,Пухаа! Ол шағады!
Dialogue: 0,0:12:16.06,0:12:17.73,Default,,0,0,0,,А, келді
Dialogue: 0,0:12:18.23,0:12:20.15,Default,,0,0,0,,Иә, мына табақты алыңыз.
Dialogue: 0,0:12:21.15,0:12:23.24,Default,,0,0,0,,Пуха~ Дәмді
Dialogue: 0,0:12:23.32,0:12:25.11,Default,,0,0,0,,Оны ішкеніме жарты жыл болды.
Dialogue: 0,0:12:25.20,0:12:27.53,Default,,0,0,0,,Мен де үйде аз ғана ішемін.
Dialogue: 0,0:12:27.62,0:12:29.24,Default,,0,0,0,,Ноке! (Арай) Уф
Dialogue: 0,0:12:29.33,0:12:30.91,Default,,0,0,0,,Барлық сашими менікі.
Dialogue: 0,0:12:31.00,0:12:33.41,Default,,0,0,0,,Бұл дәмді!
Dialogue: 0,0:12:34.58,0:12:35.92,Default,,0,0,0,,Мм... (Химено) Иә?
Dialogue: 0,0:12:36.00,0:12:38.17,Default,,0,0,0,,Мен адасып қалдым...
Dialogue: 0,0:12:38.25,0:12:39.88,Default,,0,0,0,,Коби-чан Кобе-чан
Dialogue: 0,0:12:39.96,0:12:41.05,Default,,0,0,0,,Мұнда кел
Dialogue: 0,0:12:41.13,0:12:43.17,Default,,0,0,0,,Макима-сан, сен кешігіп келесің.
Dialogue: 0,0:12:45.01,0:12:46.72,Default,,0,0,0,,Үш парфея
Dialogue: 0,0:12:46.80,0:12:50.31,Default,,0,0,0,,Ал Ширатама Өзен... 3.
Dialogue: 0,0:12:51.22,0:12:54.14,Default,,0,0,0,,Мен мұндай дәмді тағамды бірінші рет жедім.
Dialogue: 0,0:12:54.23,0:12:57.35,Default,,0,0,0,,Кобе-чан, ақшаның көп бөлігі үйге түседі.
Dialogue: 0,0:12:57.44,0:12:58.36,Default,,0,0,0,,Көп тамақтаныңыз
Dialogue: 0,0:12:58.44,0:12:59.77,Default,,0,0,0,,Алма, ұры! Ах
Dialogue: 0,0:12:59.86,0:13:02.78,Default,,0,0,0,,Қуырылған тағамның бәрі менікі!
Dialogue: 0,0:13:02.86,0:13:05.91,Default,,0,0,0,,Сіз мистер Фьюс пен мына жынды әкелген жоқсыз ба?
Dialogue: 0,0:13:05.99,0:13:08.70,Default,,0,0,0,,Мен сені осында әкелуге қорқамын.
Dialogue: 0,0:13:08.78,0:13:12.45,Default,,0,0,0,,Хаякава мырза, Маджин-чан өте ұтымды, бұл жақсы.
Dialogue: 0,0:13:12.54,0:13:16.33,Default,,0,0,0,,Сәлем! Сіз жассыз, көп сұрап, тамақтаныңыз.
Dialogue: 0,0:13:16.42,0:13:19.75,Default,,0,0,0,,Ой, мен тек осыншама канжи оқи аламын.
Dialogue: 0,0:13:20.25,0:13:21.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:21.30,0:13:23.21,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:13:24.17,0:13:26.47,Default,,0,0,0,,Ум... поцелу туралы...
Dialogue: 0,0:13:26.55,0:13:28.80,Default,,0,0,0,,Иә?Ах...
Dialogue: 0,0:13:28.89,0:13:33.47,Default,,0,0,0,,Сабырлы болу ұят~ Мен одан сайын мас болып кетсем, ашуланамын.
Dialogue: 0,0:13:35.14,0:13:35.98,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:13:36.06,0:13:38.73,Default,,0,0,0,,Мен қараңғыны тістеймін~
Dialogue: 0,0:13:38.81,0:13:42.36,Default,,0,0,0,,Бәріңді өлтірмек болғаным үшін кешіре гөр, Дэнджи-кун.
Dialogue: 0,0:13:42.44,0:13:44.86,Default,,0,0,0,,О, мен сені өте кешірдім!
Dialogue: 0,0:13:44.94,0:13:45.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:45.86,0:13:50.32,Default,,0,0,0,,Бұл жаңадан келгендерге арналған құттықтау кеші, сондықтан жаңадан келгендер тұрып, өздерін таныстырады.
Dialogue: 0,0:13:50.41,0:13:53.08,Default,,0,0,0,,Маған аты-жөніңізді, жасыңызды және сізбен келісім-шарт бар шайтаныңызды айтыңыз.
Dialogue: 0,0:13:53.16,0:13:56.66,Default,,0,0,0,,Келісім-шартыңыз бар шайтан туралы көпшілік алдында айтпаңыз.
Dialogue: 0,0:13:56.75,0:14:00.25,Default,,0,0,0,,Құпияларыңызды тек сенетін адамдарға көрсетуіңіз керек.
Dialogue: 0,0:14:00.33,0:14:02.67,Default,,0,0,0,,Ол әлі де қыңыр жігіт.
Dialogue: 0,0:14:02.75,0:14:04.46,Default,,0,0,0,,Жарайды! Жарайды!
Dialogue: 0,0:14:04.46,0:14:05.59,Default,,0,0,0,,Жарайды! Жарайды!
Dialogue: 0,0:14:04.46,0:14:05.59,Default,,0,0,0,,Эхехе…
Dialogue: 0,0:14:05.59,0:14:06.01,Default,,0,0,0,,Жарайды! Жарайды!
Dialogue: 0,0:14:06.09,0:14:10.39,Default,,0,0,0,,Мен хоббимін. Мен білгім келеді. Мен хоббиімнің арқасында адаммын.Түсінесіз бе?
Dialogue: 0,0:14:10.47,0:14:12.18,Default,,0,0,0,,Кен Денжи
Dialogue: 0,0:14:12.26,0:14:14.27,Default,,0,0,0,,Менің ойымша, жыл 16 (Himeno) Иә?
Dialogue: 0,0:14:14.35,0:14:17.39,Default,,0,0,0,,Менің хоббиім - тамақтану және ұйықтау
Dialogue: 0,0:14:17.48,0:14:18.44,Default,,0,0,0,,А...
Dialogue: 0,0:14:18.52,0:14:19.52,Default,,0,0,0,,Өте жас
Dialogue: 0,0:14:19.60,0:14:20.44,Default,,0,0,0,,Хмм
Dialogue: 0,0:14:20.52,0:14:22.48,Default,,0,0,0,,Сіз ішпейсіз, солай ма?
Dialogue: 0,0:14:22.57,0:14:23.40,Default,,0,0,0,,Шай
Dialogue: 0,0:14:24.11,0:14:26.11,Default,,0,0,0,,Менің атым Хироказу Арай!
Dialogue: 0,0:14:26.19,0:14:28.53,Default,,0,0,0,,22 жаста Келісім-шартым бар шайтан – түлкі!
Dialogue: 0,0:14:28.61,0:14:30.53,Default,,0,0,0,,Менің хоббиім - хайку!
Dialogue: 0,0:14:30.61,0:14:31.28,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:14:31.28,0:14:32.99,Default,,0,0,0,,Хаая Паймен келісім шарты бар шайтан да сондай.
Dialogue: 0,0:14:31.28,0:14:32.99,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:14:32.99,0:14:33.66,Default,,0,0,0,,Хаая Паймен келісім шарты бар шайтан да сондай.
Dialogue: 0,0:14:33.74,0:14:36.95,Default,,0,0,0,,Түлкі жындары адамдарға мейірімді.
Dialogue: 0,0:14:37.04,0:14:39.37,Default,,0,0,0,,Біздің көптеген шайтан аңшыларымен келісім-шартымыз бар.
Dialogue: 0,0:14:39.46,0:14:42.54,Default,,0,0,0,,Түлкінің басын тек әдемі жігіттер пайдалана алады.
Dialogue: 0,0:14:42.63,0:14:44.67,Default,,0,0,0,,Бұл шайтан күлкілі
Dialogue: 0,0:14:46.38,0:14:49.51,Default,,0,0,0,,Менің атым Кобени Хигашияма, мен 20 жастамын.
Dialogue: 0,0:14:49.59,0:14:52.76,Default,,0,0,0,,Менің келісім шартым бар шайтан... құпия.
Dialogue: 0,0:14:52.85,0:14:55.18,Default,,0,0,0,,Менің хоббиім дәмді тағамды жеу
Dialogue: 0,0:14:55.26,0:14:57.39,Default,,0,0,0,,Хмм... Киім сүйкімді, солай емес пе?
Dialogue: 0,0:14:57.47,0:14:58.31,Default,,0,0,0,,Иә
Dialogue: 0,0:14:58.39,0:15:00.81,Default,,0,0,0,,Менің киімім үлкен әпкемнің қолынан шыққан.
Dialogue: 0,0:15:00.89,0:15:01.90,Default,,0,0,0,,Солай ма?Фьюс-сан мен мына жаңа жігіт ше?
Dialogue: 0,0:15:00.89,0:15:01.90,Default,,0,0,0,,Кобени-чан
Dialogue: 0,0:15:01.90,0:15:01.98,Default,,0,0,0,,Солай ма?Фьюс-сан мен мына жаңа жігіт ше?
Dialogue: 0,0:15:01.98,0:15:04.57,Default,,0,0,0,,Солай ма?Фьюс-сан мен мына жаңа жігіт ше?
Dialogue: 0,0:15:01.98,0:15:04.57,Default,,0,0,0,,Тоғыз қарындас бар, ғажап емес пе?
Dialogue: 0,0:15:04.65,0:15:07.57,Default,,0,0,0,,Өкінішке орай, ол кеше дүниеден өтті.
Dialogue: 0,0:15:09.65,0:15:11.32,Default,,0,0,0,,Наму Амида Буцу!
Dialogue: 0,0:15:11.41,0:15:15.08,Default,,0,0,0,,Айналдыру... Хоген... Гекё~?
Dialogue: 0,0:15:15.16,0:15:16.83,Default,,0,0,0,,Сенпай, сен уже мас болыпсың.
Dialogue: 0,0:15:16.91,0:15:18.33,Default,,0,0,0,,А...
Dialogue: 0,0:15:18.41,0:15:20.58,Default,,0,0,0,,Өлу оңай ма?
Dialogue: 0,0:15:21.29,0:15:24.46,Default,,0,0,0,,Жеке секторда мүмкін болмаған шайтан қоғамдық қауіпсіздікке сеніп тапсырылады.
Dialogue: 0,0:15:24.54,0:15:25.13,Default,,0,0,0,,А...
Dialogue: 0,0:15:25.13,0:15:26.38,Default,,0,0,0,,​​Сен көп өлесің.
Dialogue: 0,0:15:25.13,0:15:26.38,Default,,0,0,0,,А...
Dialogue: 0,0:15:26.38,0:15:27.17,Default,,0,0,0,,​​Сен көп өлесің.
Dialogue: 0,0:15:27.25,0:15:29.84,Default,,0,0,0,,Менің сыныптастарым енді қоғамдық қауіпсіздікте емес.
Dialogue: 0,0:15:29.92,0:15:34.09,Default,,0,0,0,,Дэнджи-кун, сен мені сүйгің келгендіктен өлмейсің.
Dialogue: 0,0:15:34.18,0:15:35.97,Default,,0,0,0,,Хе хе... хе!
Dialogue: 0,0:15:36.06,0:15:38.85,Default,,0,0,0,,Химено мас болған кезде сүйіспеншілікке айналады.
Dialogue: 0,0:15:38.93,0:15:39.93,Default,,0,0,0,,Иә!?
Dialogue: 0,0:15:40.02,0:15:43.73,Default,,0,0,0,,Жаңадан келгендерден басқасының барлығын Химено сүйді.
Dialogue: 0,0:15:43.81,0:15:45.61,Default,,0,0,0,,Сіз қашып құтыла алмайсыз.
Dialogue: 0,0:15:48.65,0:15:49.74,Default,,0,0,0,,Бұл расталған поцелу
Dialogue: 0,0:15:50.32,0:15:51.95,Default,,0,0,0,,Пуха~фуу…
Dialogue: 0,0:15:52.86,0:15:56.20,Default,,0,0,0,,Мен бүгін бірінші сүйісемін
Dialogue: 0,0:15:56.28,0:15:58.20,Default,,0,0,0,,Поцелу? Ха!
Dialogue: 0,0:15:58.29,0:16:00.54,Default,,0,0,0,,Макима-сан
Dialogue: 0,0:16:00.62,0:16:03.33,Default,,0,0,0,,Кешіріңіз, бір шикі тағам беріңізші.
Dialogue: 0,0:16:03.96,0:16:06.46,Default,,0,0,0,,Макима-сан, осында келші.
Dialogue: 0,0:16:08.84,0:16:11.22,Default,,0,0,0,,Нағыз Макима-санды бірінші рет көрдім.
Dialogue: 0,0:16:13.38,0:16:15.59,Default,,0,0,0,,Дэнджи-кун, сен біреуді сүймексің бе?
Dialogue: 0,0:16:15.68,0:16:16.60,Default,,0,0,0,,Мен жасамаймын!
Dialogue: 0,0:16:16.68,0:16:19.97,Default,,0,0,0,,Е~ Дэнджи-кун, сен мені сүймейсің бе~?
Dialogue: 0,0:16:20.06,0:16:20.98,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:16:24.73,0:16:26.98,Default,,0,0,0,,Кешіріңіз, тағы бір нәрсе.
Dialogue: 0,0:16:27.06,0:16:28.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:29.44,0:16:31.03,Default,,0,0,0,,Сонымен, поцелу дегеніміз не?
Dialogue: 0,0:16:31.11,0:16:33.57,Default,,0,0,0,,Мен Макиманың Химено-санды сүйгенімді көргенін қаламаймын.
Dialogue: 0,0:16:33.57,0:16:34.86,Default,,0,0,0,,Мен Макиманың Химено-санды сүйгенімді көргенін қаламаймын.
Dialogue: 0,0:16:33.57,0:16:34.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:34.95,0:16:37.07,Default,,0,0,0,,Неліктен чиу емессіз?
Dialogue: 0,0:16:37.16,0:16:39.28,Default,,0,0,0,,Бірақ дәл сондай күшті сезіммен
Dialogue: 0,0:16:39.37,0:16:41.00,Default,,0,0,0,,Мен сені әлі де тілімнен сүйгім келеді
Dialogue: 0,0:16:41.66,0:16:44.00,Default,,0,0,0,,Әзірше әңгімені басқа жаққа бұрудан басқа амалым жоқ.
Dialogue: 0,0:16:44.08,0:16:46.33,Default,,0,0,0,,Макима-сан, жүр!
Dialogue: 0,0:16:46.42,0:16:49.04,Default,,0,0,0,,Мен мылтық шайтан туралы бірдеңе алдым.
Dialogue: 0,0:16:49.13,0:16:52.26,Default,,0,0,0,,Иә, мен сені керемет деп естідім, Денжи.
Dialogue: 0,0:16:52.34,0:16:57.72,Default,,0,0,0,,Осы уақытқа дейін бір кесек еті бар жын ешқашан мұндай жылдам қарқынмен пайда болған емес.
Dialogue: 0,0:16:57.80,0:17:00.35,Default,,0,0,0,,Өткен күні Денджиді нысанаға алған шайтан
Dialogue: 0,0:17:00.43,0:17:03.02,Default,,0,0,0,,Соңғы кездері шайтанның қимылдары біршама күдікті болды.
Dialogue: 0,0:17:03.10,0:17:07.52,Default,,0,0,0,,Макима-сан, сен Денжи туралы бірдеңе білмейсің бе?
Dialogue: 0,0:17:09.27,0:17:10.27,Default,,0,0,0,,Маған да берші.
Dialogue: 0,0:17:12.57,0:17:13.53,Default,,0,0,0,,Бұл да менікі.
Dialogue: 0,0:17:17.70,0:17:20.03,Default,,0,0,0,,Менен артық ішсең, мен саған айтамын.
Dialogue: 0,0:17:22.58,0:17:24.29,Default,,0,0,0,,Кешіріңіз, екі студент.
Dialogue: 0,0:17:24.37,0:17:27.83,Default,,0,0,0,,Хахахаха... Мен де солай істеймін~
Dialogue: 0,0:17:27.92,0:17:29.17,Default,,0,0,0,,Тағы бір нәрсе!
Dialogue: 0,0:17:29.25,0:17:31.30,Default,,0,0,0,,Жылқы еті!Ауа қуырылған!Жылқы  еті!
Dialogue: 0,0:17:31.38,0:17:32.76,Default,,0,0,0,,Ауа қуырылған!(күш) хун
Dialogue: 0,0:17:34.59,0:17:36.26,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:36.34,0:17:38.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:38.76,0:17:39.80,Default,,0,0,0,,Бұл да менікі.
Dialogue: 0,0:17:39.89,0:17:42.26,Default,,0,0,0,,Кешіріңіз, тағы бір нәрсе.
Dialogue: 0,0:17:42.35,0:17:43.89,Default,,0,0,0,,Бірақ бұл таңқаларлық, Пауэр-чан
Dialogue: 0,0:17:43.89,0:17:44.85,Default,,0,0,0,,Бірақ бұл таңқаларлық, Пауэр-чан
Dialogue: 0,0:17:43.89,0:17:44.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:44.93,0:17:48.65,Default,,0,0,0,,Өлтіруші ниеттерін басқара алатын жындар өте аз.
Dialogue: 0,0:17:48.73,0:17:51.27,Default,,0,0,0,,Бүркіттердің IQ деңгейі жоғары.
Dialogue: 0,0:17:51.36,0:17:54.44,Default,,0,0,0,,IQ арқылы анықталады ма?Мұндай нәрсе
Dialogue: 0,0:17:54.53,0:17:56.74,Default,,0,0,0,,Сізде қанша IQ бар?
Dialogue: 0,0:17:56.82,0:17:57.65,Default,,0,0,0,,100？
Dialogue: 0,0:17:57.74,0:18:02.53,Default,,0,0,0,,100 қымбат па? Менің ойымша, ол да 100-ге жуық болды ...
Dialogue: 0,0:18:02.62,0:18:03.91,Default,,0,0,0,,Жарайды, онда 120.
Dialogue: 0,0:18:03.99,0:18:07.00,Default,,0,0,0,,Fuse-san қымбат, солай ма?
Dialogue: 0,0:18:07.08,0:18:08.67,Default,,0,0,0,,Ол 134 болды
Dialogue: 0,0:18:08.75,0:18:11.13,Default,,0,0,0,,Оны есіме түсіргенім үшін мен өзімді мақтан тұтамын.
Dialogue: 0,0:18:11.21,0:18:12.04,Default,,0,0,0,,Иә...
Dialogue: 0,0:18:12.13,0:18:15.42,Default,,0,0,0,,500... 1000 болғанына сенімдімін?
Dialogue: 0,0:18:17.22,0:18:18.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:18.13,0:18:19.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:19.72,0:18:20.55,Default,,0,0,0,,U.A. Спорттық күні тез арада келіп жетті
Dialogue: 0,0:18:20.64,0:18:21.80,Default,,0,0,0,,Бұл жасырын операциялар үшін мінсіз қабілет.
Dialogue: 0,0:18:21.89,0:18:23.76,Default,,0,0,0,,А... а...
Dialogue: 0,0:18:23.76,0:18:24.68,Default,,0,0,0,,А... а...
Dialogue: 0,0:18:23.76,0:18:24.68,Default,,0,0,0,,О...
Dialogue: 0,0:18:25.47,0:18:27.43,Default,,0,0,0,,А... Мен көріндім.
Dialogue: 0,0:18:27.52,0:18:29.06,Default,,0,0,0,,Макима көрген
Dialogue: 0,0:18:29.69,0:18:30.94,Default,,0,0,0,,Бірақ не?Бұл сезім сіздің тіліңізде ме?
Dialogue: 0,0:18:29.69,0:18:30.94,Default,,0,0,0,,Сүйісу
Dialogue: 0,0:18:30.94,0:18:32.44,Default,,0,0,0,,Бірақ не?Бұл сезім сіздің тіліңізде ме?
Dialogue: 0,0:18:32.52,0:18:35.03,Default,,0,0,0,,Жақсы, жұмсақ, жұмсақ!
Dialogue: 0,0:18:35.11,0:18:39.11,Default,,0,0,0,,Бұл не, тіл?! Ол сіздің аузыңызда ериді!
Dialogue: 0,0:18:39.20,0:18:40.82,Default,,0,0,0,,Тіл... Жоқ!
Dialogue: 0,0:18:40.91,0:18:42.83,Default,,0,0,0,,P... Құсу!
Dialogue: 0,0:18:42.91,0:18:43.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:43.91,0:18:45.08,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:18:45.66,0:18:47.58,Default,,0,0,0,,Бұл жарақат.
Dialogue: 0,0:18:47.66,0:18:49.08,Default,,0,0,0,,О, менің...
Dialogue: 0,0:18:49.16,0:18:51.58,Default,,0,0,0,,Кешіріңіз, маған сүртетін бірдеңе керек.
Dialogue: 0,0:18:51.67,0:18:54.42,Default,,0,0,0,,Бұл жаман. Бұл жаман.
Dialogue: 0,0:18:54.50,0:18:55.96,Default,,0,0,0,,А... (Арай) А?
Dialogue: 0,0:18:56.05,0:18:58.51,Default,,0,0,0,,Денжи аузына нәрлі бірдеңе салды.
Dialogue: 0,0:18:58.59,0:19:01.64,Default,,0,0,0,,Жұтынатын әдетің бар... Гухахаха...
Dialogue: 0,0:19:01.72,0:19:02.80,Default,,0,0,0,,(Дэнджидің жұтыну дыбысы)
Dialogue: 0,0:19:03.51,0:19:05.43,Default,,0,0,0,,(Қоқыс жәшігін аралау дыбысы)
Dialogue: 0,0:19:06.01,0:19:06.93,Default,,0,0,0,,Почита
Dialogue: 0,0:19:07.60,0:19:09.18,Default,,0,0,0,,Мен мұны жей аламын деп ойлаймын.
Dialogue: 0,0:19:15.02,0:19:16.07,Default,,0,0,0,,(тышқан жылайды)
Dialogue: 0,0:19:17.40,0:19:20.32,Default,,0,0,0,,Фуфуфу... Қара, Почита
Dialogue: 0,0:19:20.40,0:19:23.57,Default,,0,0,0,,Мас адамдардың құсығына егеуқұйрықтар жиналады.
Dialogue: 0,0:19:23.66,0:19:26.08,Default,,0,0,0,,Құсуды жегеніңізге сене алар емеспін.
Dialogue: 0,0:19:26.16,0:19:28.70,Default,,0,0,0,,Сүтқоректілердің бірі ретінде бұл аянышты.
Dialogue: 0,0:19:28.79,0:19:29.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:29.79,0:19:32.21,Default,,0,0,0,,Ой... (Дэнджи түкірген дыбыс)
Dialogue: 0,0:19:32.29,0:19:34.08,Default,,0,0,0,,Мүлдем... Химено-сенпайдың өзін-өзі ұстауы жоқ.
Dialogue: 0,0:19:32.29,0:19:34.08,Default,,0,0,0,,(Дэнджи түкірген дыбыс)
Dialogue: 0,0:19:34.08,0:19:34.17,Default,,0,0,0,,Мүлдем... Химено-сенпайдың өзін-өзі ұстауы жоқ.
Dialogue: 0,0:19:34.17,0:19:36.96,Default,,0,0,0,,Мүлдем... Химено-сенпайдың өзін-өзі ұстауы жоқ.
Dialogue: 0,0:19:34.17,0:19:36.96,Default,,0,0,0,,(Дэндзидің жөтелі)
Dialogue: 0,0:19:37.05,0:19:39.72,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:40.88,0:19:41.72,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:41.80,0:19:44.09,Default,,0,0,0,,Сіз мені құсуға шеберсіз, солай емес пе?
Dialogue: 0,0:19:41.80,0:19:44.09,Default,,0,0,0,,(Дэнджи түкірген дыбыс)
Dialogue: 0,0:19:44.09,0:19:44.18,Default,,0,0,0,,(Дэнджи түкірген дыбыс)
Dialogue: 0,0:19:44.18,0:19:46.81,Default,,0,0,0,,Мен мас анамды жұмыстан келген кезде қарайтынмын.
Dialogue: 0,0:19:44.18,0:19:46.81,Default,,0,0,0,,(Дэнджи түкірген дыбыс)
Dialogue: 0,0:19:46.81,0:19:47.97,Default,,0,0,0,,Мен мас анамды жұмыстан келген кезде қарайтынмын.
Dialogue: 0,0:19:48.06,0:19:51.98,Default,,0,0,0,,Менде сен сияқты шайтан аңшыдай талант жоқ еді.
Dialogue: 0,0:19:52.56,0:19:53.73,Default,,0,0,0,,Мен қызғанамын
Dialogue: 0,0:19:53.81,0:19:57.23,Default,,0,0,0,,Уф... Сіз қызғанасыз ба?
Dialogue: 0,0:19:57.32,0:20:01.78,Default,,0,0,0,,Сәлем, менің алғашқы сүйісімнің дәмі құсу сияқты.
Dialogue: 0,0:20:01.86,0:20:03.61,Default,,0,0,0,,Мен мұны қызғанамын... Уф...
Dialogue: 0,0:20:03.70,0:20:05.57,Default,,0,0,0,,Е...
Dialogue: 0,0:20:05.66,0:20:06.74,Default,,0,0,0,,Фу…
Dialogue: 0,0:20:06.83,0:20:08.16,Default,,0,0,0,,Фуфуфуфуфуфу… хаха…
Dialogue: 0,0:20:08.16,0:20:10.83,Default,,0,0,0,,Фуфуфуфуфуфу… хаха…
Dialogue: 0,0:20:08.16,0:20:10.83,Default,,0,0,0,,(Дэнджи түкірген дыбыс)
Dialogue: 0,0:20:13.29,0:20:14.96,Default,,0,0,0,,Мен Хаякава отбасын үйге апарамын.
Dialogue: 0,0:20:14.96,0:20:15.96,Default,,0,0,0,,Мен Хаякава отбасын үйге апарамын.
Dialogue: 0,0:20:14.96,0:20:15.96,Default,,0,0,0,,Үйге қайда барасыз?
Dialogue: 0,0:20:16.04,0:20:17.79,Default,,0,0,0,,Арай-кун, маған Химено-чан беріңізші.
Dialogue: 0,0:20:16.04,0:20:17.79,Default,,0,0,0,,Сен көп іштің.
Dialogue: 0,0:20:17.79,0:20:18.25,Default,,0,0,0,,Арай-кун, маған Химено-чан беріңізші.
Dialogue: 0,0:20:18.34,0:20:22.38,Default,,0,0,0,,Барлығымыз, Макима-санның игілігіне шүкіршілік етейік.
Dialogue: 0,0:20:22.47,0:20:25.84,Default,,0,0,0,,Басқалардың ақшасымен ішу - ең дәмдісі.
Dialogue: 0,0:20:25.93,0:20:26.76,Default,,0,0,0,,Эй
Dialogue: 0,0:20:29.72,0:20:31.64,Default,,0,0,0,,Иә?Ал сен ше, Денжи?
Dialogue: 0,0:20:31.73,0:20:32.89,Default,,0,0,0,,Дэнджи-кун
Dialogue: 0,0:20:32.98,0:20:36.02,Default,,0,0,0,,Химено-сенпай оны арқасымен көтеріп жүрді.
Dialogue: 0,0:20:38.65,0:20:43.32,Default,,0,0,0,,Ух... қараңғы... қараңғы
Dialogue: 0,0:20:43.40,0:20:45.61,Default,,0,0,0,,Ол қайда?мұнда
Dialogue: 0,0:20:45.70,0:20:50.08,Default,,0,0,0,,Су… Су… Су…
Dialogue: 0,0:20:50.16,0:20:55.25,Default,,0,0,0,,Уф... Қазір ойлап қарасам, мені құмар қыз сүйіп алды.
Dialogue: 0,0:20:55.75,0:21:00.21,Default,,0,0,0,,Қарғыс атсын... Су... Су...
Dialogue: 0,0:21:01.13,0:21:02.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:11.60,0:21:13.23,Default,,0,0,0,,Ммм... Мм...
Dialogue: 0,0:21:17.98,0:21:21.36,Default,,0,0,0,,Солай ма?Денденджи-кун?
Dialogue: 0,0:21:21.44,0:21:24.40,Default,,0,0,0,,Неге менімен біргесің?
Dialogue: 0,0:21:24.90,0:21:28.70,Default,,0,0,0,,Иә?Мен оны осында әкелдім деп ойлаймын.
Dialogue: 0,0:21:28.78,0:21:29.99,Default,,0,0,0,,​​Жоқ?
Dialogue: 0,0:21:30.08,0:21:31.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:31.58,0:21:35.25,Default,,0,0,0,,Менің басым айналады. Бұл не?
Dialogue: 0,0:21:38.58,0:21:43.01,Default,,0,0,0,,Айтпақшы, сіз Макима-санды жақсы көресіз, солай ма?
Dialogue: 0,0:21:43.09,0:21:46.51,Default,,0,0,0,,Уф... Менің басым айналып кетті~
Dialogue: 0,0:21:46.59,0:21:51.47,Default,,0,0,0,,Сіз мұндай сұмдық әйел болуды доғарыңыз!
Dialogue: 0,0:21:51.56,0:21:55.68,Default,,0,0,0,,Аки-кун да~ Сен сондай құқық бұзушысың~
Dialogue: 0,0:21:55.77,0:21:57.19,Default,,0,0,0,,Мо!
Dialogue: 0,0:21:57.27,0:22:02.32,Default,,0,0,0,,Мо!мал!Ахаха... хаха...
Dialogue: 0,0:22:07.82,0:22:08.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:10.41,0:22:12.16,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:22:14.24,0:22:15.91,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:24.30,0:22:25.51,Default,,0,0,0,,Біз қалаймыз?
Dialogue: 0,0:22:26.01,0:22:31.01,Default,,0,0,0,,♪～
Dialogue: 0,0:23:50.22,0:23:55.22,Default,,0,0,0,,～♪
