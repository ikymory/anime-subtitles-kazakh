Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,А, 2D-kun? Не?
Dialogue: 0,0:00:30.00,0:00:32.00,Default,,0,0,0,,А, 2D-kun? Не?
Dialogue: 0,0:00:32.00,0:00:34.00,Default,,0,0,0,,Сіз жалғызсыз ба?
Dialogue: 0,0:00:34.00,0:00:36.00,Default,,0,0,0,,А, 2D-kun? Не?
Dialogue: 0,0:00:36.00,0:00:38.00,Default,,0,0,0,,Сіз жалғызсыз ба?
Dialogue: 0,0:00:38.00,0:00:40.00,Default,,0,0,0,,А, 2D-kun? Не?
Dialogue: 0,0:00:40.00,0:00:42.00,Default,,0,0,0,,Сіз жалғызсыз ба?
Dialogue: 0,0:00:42.00,0:00:44.00,Default,,0,0,0,,А, 2D-kun? Не?
Dialogue: 0,0:00:44.00,0:00:46.00,Default,,0,0,0,,Сіз жалғызсыз ба?
Dialogue: 0,0:00:46.00,0:00:48.00,Default,,0,0,0,,А, 2D-kun? Не?
Dialogue: 0,0:00:48.00,0:00:50.00,Default,,0,0,0,,Сіз жалғызсыз ба?
Dialogue: 0,0:00:50.00,0:00:52.00,Default,,0,0,0,,А, 2D-kun? Не?
Dialogue: 0,0:00:52.00,0:00:54.00,Default,,0,0,0,,Сіз жалғызсыз ба?
Dialogue: 0,0:00:54.00,0:00:56.00,Default,,0,0,0,,А, 2D-kun? Не?
Dialogue: 0,0:00:56.00,0:00:58.00,Default,,0,0,0,,Сіз жалғызсыз ба?
Dialogue: 0,0:00:58.00,0:01:04.00,Default,,0,0,0,,Осы дауыстар айтса да
Dialogue: 0,0:01:04.00,0:01:06.00,Default,,0,0,0,,Өзіңізді жақсы сезініңіз.
Dialogue: 0,0:01:06.00,0:01:09.00,Default,,0,0,0,,Қолыңды ақырын іздесем де
Dialogue: 0,0:01:09.00,0:01:14.00,Default,,0,0,0,,Сөздерді түкірмеңіз.
Dialogue: 0,0:01:14.00,0:01:17.00,Default,,0,0,0,,Бірге армандай берсек
Dialogue: 0,0:01:17.00,0:01:22.00,Default,,0,0,0,,Шындықты айтқым келсе де
Dialogue: 0,0:01:22.00,0:01:23.00,Default,,0,0,0,,Бір сәтке де
Dialogue: 0,0:01:23.00,0:01:26.00,Default,,0,0,0,,Барлығына әлемді нұрландырыңыз
Dialogue: 0,0:01:26.00,0:01:27.00,Default,,0,0,0,,Махаббатың
Dialogue: 0,0:01:27.00,0:01:28.00,Default,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:01:28.00,0:01:30.00,Default,,0,0,0,,Міне, сені сүю деген осы
Dialogue: 0,0:01:30.00,0:01:31.00,Default,,0,0,0,,Мен шыншыл болдым
Dialogue: 0,0:01:31.00,0:01:32.00,Default,,0,0,0,,зұлым қылмыстарды болдырмау үшін, бірақ —
Dialogue: 0,0:01:32.00,0:01:33.00,Default,,0,0,0,,Біз
Dialogue: 0,0:01:33.00,0:01:34.00,Default,,0,0,0,,Ән айтсаң да
Dialogue: 0,0:01:34.00,0:01:35.00,Default,,0,0,0,,Егер біз бірге бола алсақ
Dialogue: 0,0:01:35.00,0:01:36.00,Default,,0,0,0,,Сіздермен бірге
Dialogue: 0,0:01:36.00,0:01:38.00,Default,,0,0,0,,Біз осылай істеп жатырмыз
Dialogue: 0,0:01:38.00,0:01:42.00,Default,,0,0,0,,Махаббатқа ғашық
Dialogue: 0,0:01:42.00,0:01:45.00,Default,,0,0,0,,Кеше маған Янус мырза телефон арқылы айтты.
Dialogue: 0,0:01:45.00,0:01:47.00,Default,,0,0,0,,Банри мені талай рет кездесуге шақырса да.
Dialogue: 0,0:01:47.00,0:01:50.00,Default,,0,0,0,,Сіз бірдеңені дұрыс емес істеп жатырсыз, себебі уақыт дұрыс емес.
Dialogue: 0,0:01:50.00,0:01:52.00,Default,,0,0,0,,Нижиген-кун, мені неге шақырдың?
Dialogue: 0,0:01:52.00,0:01:53.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:01:53.00,0:01:55.00,Default,,0,0,0,,Мен сенімен ойнағым келді
Dialogue: 0,0:01:55.00,0:01:57.00,Default,,0,0,0,,Жоқ, сіз мейірімдісіз.
Dialogue: 0,0:01:57.00,0:02:00.00,Default,,0,0,0,,Бірақ Ниджиген-кунның да жарты күндік жұмысы болады.
Dialogue: 0,0:02:00.00,0:02:03.00,Default,,0,0,0,,Мен Банримен бірге шығып бара жатқанмын.
Dialogue: 0,0:02:03.00,0:02:05.00,Default,,0,0,0,,Нижиген-кун, мені неге шақырдың?
Dialogue: 0,0:02:05.00,0:02:06.00,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:02:06.00,0:02:08.00,Default,,0,0,0,,Мен сенімен ойнағым келді
Dialogue: 0,0:02:08.00,0:02:10.00,Default,,0,0,0,,Жоқ, сен мейірімдісің.
Dialogue: 0,0:02:10.00,0:02:11.00,Default,,0,0,0,,Бірақ Ниджиген-кунның да жарты күндік жұмысы болады.
Dialogue: 0,0:02:11.00,0:02:13.00,Default,,0,0,0,,Мен Банримен ойнағым келді.
Dialogue: 0,0:02:13.00,0:02:14.00,Default,,0,0,0,,Жоқ, сен мейірімдісің.
Dialogue: 0,0:02:14.00,0:02:16.00,Default,,0,0,0,,Бірақ Ниджиген-кунның да жарты күндік жұмысы болады.
Dialogue: 0,0:02:16.00,0:02:18.00,Default,,0,0,0,,Мен Банримен ойнағым келді.
Dialogue: 0,0:02:18.00,0:02:19.00,Default,,0,0,0,,Жоқ, сен мейірімдісің.
Dialogue: 0,0:02:19.00,0:02:22.00,Default,,0,0,0,,Дегенмен, Нижиген-кунның да толық емес жұмыс күні бар.
Dialogue: 0,0:02:22.00,0:02:24.00,Default,,0,0,0,,Мен Банримен ойнағым келді.
Dialogue: 0,0:02:24.00,0:02:25.00,Default,,0,0,0,,Бүгін менің толық емес демалысым бар.
Dialogue: 0,0:02:25.00,0:02:27.00,Default,,0,0,0,,Окада мырзамен кездесу жоспарыңыз бар ма?
Dialogue: 0,0:02:27.00,0:02:29.00,Default,,0,0,0,,Жоспарланған?
Dialogue: 0,0:02:29.00,0:02:31.00,Default,,0,0,0,,Сол адам, көп жағдайда.
Dialogue: 0,0:02:31.00,0:02:33.00,Default,,0,0,0,,Себебі мен сіздің үйіңізге күнде келемін
Dialogue: 0,0:02:34.00,0:02:35.00,Default,,0,0,0,,Сонымен
Dialogue: 0,0:02:35.00,0:02:36.00,Default,,0,0,0,,Нижиген-кун келсе
Dialogue: 0,0:02:36.00,0:02:38.00,Default,,0,0,0,,Үш адам бірге ойнай алады
Dialogue: 0,0:02:38.00,0:02:39.00,Default,,0,0,0,,Ах
Dialogue: 0,0:02:39.00,0:02:42.00,Default,,0,0,0,,Қызық, менің бетіме қарап тұра аласың ба?
Dialogue: 0,0:02:43.00,0:02:47.00,Default,,0,0,0,,Әй, бұл әйелдің кесірінен деп ойлаймын.
Dialogue: 0,0:02:47.00,0:02:50.00,Default,,0,0,0,,Не? Романтикалық оқиға?
Dialogue: 0,0:02:50.00,0:02:56.00,Default,,0,0,0,,Иә, өйткені сіз жазғы демалыс басталғалы біздің шақырулардан бас тарттыңыз.
Dialogue: 0,0:02:56.00,0:03:00.00,Default,,0,0,0,,Хабарлассам да, асығып тұрғандай сезінемін.
Dialogue: 0,0:03:00.00,0:03:02.00,Default,,0,0,0,,Егер дұрыс болса, екінші тарап
Dialogue: 0,0:03:10.00,0:03:12.00,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:03:15.00,0:03:19.00,Default,,0,0,0,,Ол телефонмен сөйлесіп тұрған сияқты болды, мен жасырын түрде кіруге тырыстым.
Dialogue: 0,0:03:20.00,0:03:21.00,Default,,0,0,0,,Сіз кіммен сөйлестіңіз?
Dialogue: 0,0:03:23.00,0:03:25.00,Default,,0,0,0,,Моши Моши
Dialogue: 0,0:03:25.00,0:03:26.00,Default,,0,0,0,,О, сигналы келіп жатыр, келіп жатыр
Dialogue: 0,0:03:26.00,0:03:29.00,Default,,0,0,0,,А, бұл не? Қайырлы таң, Нижиген-кун.
Dialogue: 0,0:03:30.00,0:03:34.00,Default,,0,0,0,,Е-е, үш құйрықтың құрбысы бар, сондықтан басқа адам УЗИ.
Dialogue: 0,0:03:35.00,0:03:39.00,Default,,0,0,0,,Жоқ, иә, оны дұрыс тексеру керек.
Dialogue: 0,0:03:40.00,0:03:41.00,Default,,0,0,0,,Растау
Dialogue: 0,0:03:41.00,0:03:46.00,Default,,0,0,0,,Уайымдамаңыз, мен кәсіпқоймын. Мен Мионы аңдып үйренгенмін.
Dialogue: 0,0:03:46.00,0:03:48.00,Default,,0,0,0,,Әй, тағы не?
Dialogue: 0,0:03:48.00,0:03:50.00,Default,,0,0,0,,Сонымен Бэнли
Dialogue: 0,0:03:50.00,0:03:51.00,Default,,0,0,0,,Иә
Dialogue: 0,0:03:51.00,0:03:53.00,Default,,0,0,0,,Мен бүгін бос боламын.
Dialogue: 0,0:03:56.00,0:03:58.00,Default,,0,0,0,,Мынау ультрадыбыстық үй.
Dialogue: 0,0:03:58.00,0:04:01.00,Default,,0,0,0,,Бэнли Сіз бұл жерді жақсы білетінсіз.
Dialogue: 0,0:04:01.00,0:04:06.00,Default,,0,0,0,,Мен бұл туралы жазғы каникул алдында естідім, сондықтан мен оларға хабарлауын айттым, өйткені мен оны орта мектеп маусымы басталғанға дейін шығарамын.
Dialogue: 0,0:04:06.00,0:04:09.00,Default,,0,0,0,,Мен шынымен білмеймін. Олар мұнда келе ме деп ойлаймын.
Dialogue: 0,0:04:09.00,0:04:11.00,Default,,0,0,0,,Егер сіз ультрадыбысты кездестірсеңіз
Dialogue: 0,0:04:11.00,0:04:17.00,Default,,0,0,0,,Егер бұл Мионың мінезі болса, мен оны көрген сайын мені үйге апарып, өзінің шыншылдығын көрсетуі керек.
Dialogue: 0,0:04:17.00,0:04:19.00,Default,,0,0,0,,Мио бүгін бос емес.
Dialogue: 0,0:04:19.00,0:04:22.00,Default,,0,0,0,,Еске салайық, мен бүгін УЗИ-ге барамын.
Dialogue: 0,0:04:22.00,0:04:27.00,Default,,0,0,0,,Осы жерде күтсеңіз, көріністі бақылауда ұстау үшін тамаша логиканы еске түсіріңіз
Dialogue: 0,0:04:27.00,0:04:32.00,Default,,0,0,0,,Бірақ бүгін аңду үшін тым ыстық.
Dialogue: 0,0:04:33.00,0:04:36.00,Default,,0,0,0,,Мен қазірдің өзінде біраз шаршадым.
Dialogue: 0,0:04:36.00,0:04:38.00,Default,,0,0,0,,Бір жерге жылжытыңыз және қырылған мұзды жемеңіз
Dialogue: 0,0:04:38.00,0:04:40.00,Default,,0,0,0,,Керемет
Dialogue: 0,0:04:40.00,0:04:43.00,Default,,0,0,0,,Қырылған мұз? Бұл, әрине, жақсы емес.
Dialogue: 0,0:04:43.00,0:04:47.00,Default,,0,0,0,,Неліктен? Осындай күні тамақ ішу керемет емес пе?
Dialogue: 0,0:04:47.00,0:04:50.00,Default,,0,0,0,,Осындай нәрсені жеу сізді дәретханаға жақындатады.
Dialogue: 0,0:04:50.00,0:04:53.00,Default,,0,0,0,,Уау, қандай кәсіпқой!
Dialogue: 0,0:04:54.00,0:04:57.00,Default,,0,0,0,,Бұл жерден жақсы көрінбейді.
Dialogue: 0,0:04:57.00,0:05:02.00,Default,,0,0,0,,Неліктен ол опера көзілдірігін алып жүреді?
Dialogue: 0,0:05:02.00,0:05:05.00,Default,,0,0,0,,Жоқ, менде осындай конституция болғандықтан.
Dialogue: 0,0:05:05.00,0:05:09.00,Default,,0,0,0,,Тоги! Неге мұндасың?
Dialogue: 0,0:05:09.00,0:05:13.00,Default,,0,0,0,,Сіз тікелей бірінші орта мектепке келдіңіз бе?
Dialogue: 0,0:05:13.00,0:05:17.00,Default,,0,0,0,,Жоқ, жазғы демалыс, сондықтан Апона-Ситиге келу қызық па?
Dialogue: 0,0:05:17.00,0:05:21.00,Default,,0,0,0,,Бұл не? Менімен әдеттегідей хабарласыңыз.
Dialogue: 0,0:05:21.00,0:05:25.00,Default,,0,0,0,,Мен де бүгін боспын, сондықтан таңнан бері ерініп жүрмін.
Dialogue: 0,0:05:25.00,0:05:30.00,Default,,0,0,0,,Бос уақытыңыз бар ма? Жоспарларыңыз бар ма? Біреумен кездесу?
Dialogue: 0,0:05:30.00,0:05:35.00,Default,,0,0,0,,Мүлде жоқ! Сондықтан қонаққа келгеніңізге қуаныштымын.
Dialogue: 0,0:05:36.00,0:05:38.00,Default,,0,0,0,,Иә? Кобо-сан?
Dialogue: 0,0:05:41.00,0:05:43.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:43.00,0:05:46.00,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:46.00,0:05:48.00,Default,,0,0,0,,Биылғы көктемнің тоқырауы!
Dialogue: 0,0:05:48.00,0:05:49.00,Default,,0,0,0,,Кагаа мырза
Dialogue: 0,0:05:51.00,0:05:54.00,Default,,0,0,0,,Ах! Сіз мұнда не істеп жүрсіз?
Dialogue: 0,0:05:54.00,0:05:58.00,Default,,0,0,0,,Бұл менің үйім. Сіз мұнда не істеп жүрсіз?
Dialogue: 0,0:05:58.00,0:06:00.00,Default,,0,0,0,,Өмір сүру?
Dialogue: 0,0:06:00.00,0:06:02.00,Default,,0,0,0,,Бұл сіз айтып тұрған жоқсыз.
Dialogue: 0,0:06:02.00,0:06:05.00,Default,,0,0,0,,Біз Мицуё екеуіңді бірге деп ойладық.
Dialogue: 0,0:06:05.00,0:06:09.00,Default,,0,0,0,,Иә? Яна және мен? Неліктен?
Dialogue: 0,0:06:09.00,0:06:13.00,Default,,0,0,0,,Жоқ, шын мәнінде, Янаның сүйіктісі бар сияқты.
Dialogue: 0,0:06:13.00,0:06:17.00,Default,,0,0,0,,Жоқ, шын мәнінде, Янаның сүйікті қызы бар сияқты.
Dialogue: 0,0:06:17.00,0:06:22.00,Default,,0,0,0,,Мен басқа адам оккачан шығар деп ойлап, оны тексеруге келдім.
Dialogue: 0,0:06:22.00,0:06:25.00,Default,,0,0,0,,Жоқ, жоқ, мүлде емес.
Dialogue: 0,0:06:27.00,0:06:32.00,Default,,0,0,0,,Жазғы демалыс басталғалы Янамен бір рет те кездескен жоқпын.
Dialogue: 0,0:06:33.00,0:06:35.00,Default,,0,0,0,,Тіпті бір рет емес пе?
Dialogue: 0,0:06:35.00,0:06:36.00,Default,,0,0,0,,Бір рет емес
Dialogue: 0,0:06:37.00,0:06:40.00,Default,,0,0,0,,Сіз мүлде қателесесіз, Нижиген-кун.
Dialogue: 0,0:06:40.00,0:06:45.00,Default,,0,0,0,,О, мен бе? Кага-сан, осында келген Мицуё екені сөзсіз.
Dialogue: 0,0:06:45.00,0:06:49.00,Default,,0,0,0,,Біріншіден, сен Мицуёға оның қызы бар екенін айттың ғой, солай ма?
Dialogue: 0,0:06:50.00,0:06:54.00,Default,,0,0,0,,Жарайды, жол бойы келгендіктен, ішке кіріңіз.
Dialogue: 0,0:06:56.00,0:06:58.00,Default,,0,0,0,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:07:03.00,0:07:07.00,Default,,0,0,0,,Әй, Қага-сан, мен сол пәрменді басып өткен сәттен бастап.
Dialogue: 0,0:07:07.00,0:07:09.00,Default,,0,0,0,,Мен сені ресми түрде досымды табамын.
Dialogue: 0,0:07:11.00,0:07:14.00,Default,,0,0,0,,Эй, алға.
Dialogue: 0,0:07:15.00,0:07:18.00,Default,,0,0,0,,Білсең, артыңнан жарылыс ұшып кетсе де
Dialogue: 0,0:07:18.00,0:07:21.00,Default,,0,0,0,,Мен күтпеген жерден ауада тоқтап қалсам да
Dialogue: 0,0:07:22.00,0:07:25.00,Default,,0,0,0,,Кага-чан күткендей, бұл сүйкімді аяқ киім.
Dialogue: 0,0:07:26.00,0:07:30.00,Default,,0,0,0,,Келесі жолы ол дауыс сізді осылай шақырғанда, дереу өзіңізді жарып жіберіңіз.
Dialogue: 0,0:07:30.00,0:07:33.00,Default,,0,0,0,,Бас сүйекті ұрып, тек ми ғана құтылды.
Dialogue: 0,0:07:33.00,0:07:36.00,Default,,0,0,0,,Жақын жерде аңызға айнал
Dialogue: 0,0:07:36.00,0:07:37.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:07:37.00,0:07:39.00,Default,,0,0,0,,Бұл балалар шынымен ақымақ.
Dialogue: 0,0:07:40.00,0:07:44.00,Default,,0,0,0,,Менің бөлмем үшінші қабатта, сондықтан бәрі бірінші көтерілді.
Dialogue: 0,0:07:55.00,0:07:58.00,Default,,0,0,0,,Джоан Пайдың отбасы шынымен де осында тұра ма?
Dialogue: 0,0:08:03.00,0:08:04.00,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:08:04.00,0:08:05.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:08:05.00,0:08:06.00,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:08:06.00,0:08:09.00,Default,,0,0,0,,Джоан Па, жақсысың ба?
Dialogue: 0,0:08:10.00,0:08:13.00,Default,,0,0,0,,Бұл үй шынымен бос көрінеді, солай емес пе?
Dialogue: 0,0:08:14.00,0:08:17.00,Default,,0,0,0,,Мен бұл үйден жақында көшемін.
Dialogue: 0,0:08:17.00,0:08:19.00,Default,,0,0,0,,Мен соңғымын
Dialogue: 0,0:08:19.00,0:08:24.00,Default,,0,0,0,,Әкем жұмысына байланысты туған қаласына оралуға мәжбүр болды.
Dialogue: 0,0:08:24.00,0:08:27.00,Default,,0,0,0,,Анам да келуге бел буды.
Dialogue: 0,0:08:27.00,0:08:30.00,Default,,0,0,0,,Сонда сіз артта қалдыңыз ба?
Dialogue: 0,0:08:30.00,0:08:33.00,Default,,0,0,0,,Өйткені менің туған жерім Фукуока.
Dialogue: 0,0:08:33.00,0:08:35.00,Default,,0,0,0,,Сіз университетке түсе алмайсыз, солай ма?
Dialogue: 0,0:08:35.00,0:08:38.00,Default,,0,0,0,,Сондықтан мен келесі айдан бастап жалғыз тұратын боламын.
Dialogue: 0,0:08:39.00,0:08:43.00,Default,,0,0,0,,Мен бөлмені әлі шешкен жоқпын, мен қатты уайымдадым.
Dialogue: 0,0:08:44.00,0:08:45.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:45.00,0:08:47.00,Default,,0,0,0,,Міне солай болды
Dialogue: 0,0:08:47.00,0:08:50.00,Default,,0,0,0,,Ока-чан қайтыс болды
Dialogue: 0,0:08:51.00,0:08:52.00,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:08:54.00,0:08:57.00,Default,,0,0,0,,Мен Фукуокамен келісемін.
Dialogue: 0,0:08:57.00,0:09:01.00,Default,,0,0,0,,Бірақ мен жалғыз өмір сүруді қызғанамын
Dialogue: 0,0:09:01.00,0:09:02.00,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:09:03.00,0:09:06.00,Default,,0,0,0,,Мен де жалғыз өмір сүргім келді.
Dialogue: 0,0:09:06.00,0:09:10.00,Default,,0,0,0,,Төтенше жағдайға келсем, ішім үрейленеді.
Dialogue: 0,0:09:10.00,0:09:12.00,Default,,0,0,0,,Сіз қайда тұруды шештіңіз бе?
Dialogue: 0,0:09:12.00,0:09:13.00,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:09:14.00,0:09:17.00,Default,,0,0,0,,Мен бөлмені тез табуым керек.
Dialogue: 0,0:09:17.00,0:09:20.00,Default,,0,0,0,,Мен де ақша үнемдегім келеді.
Dialogue: 0,0:09:20.00,0:09:24.00,Default,,0,0,0,,Мен фотоаппаратыммен сапарға шығуым керек еді.
Dialogue: 0,0:09:24.00,0:09:26.00,Default,,0,0,0,,Бәрі паааға айналды
Dialogue: 0,0:09:27.00,0:09:28.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:29.00,0:09:30.00,Default,,0,0,0,,Мен өзімді жалғыз сезінемін.
Dialogue: 0,0:09:31.00,0:09:32.00,Default,,0,0,0,,Теңіз
Dialogue: 0,0:09:33.00,0:09:34.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:09:34.00,0:09:36.00,Default,,0,0,0,,Қараңдар, мен мұны бұрын айтқанмын.
Dialogue: 0,0:09:36.00,0:09:39.00,Default,,0,0,0,,Ока-чанды бәріміз бірге алып кетейік.
Dialogue: 0,0:09:39.00,0:09:41.00,Default,,0,0,0,,Мен көлікті шығарып саламын.
Dialogue: 0,0:09:41.00,0:09:43.00,Default,,0,0,0,,Иә, кеттік.
Dialogue: 0,0:09:43.00,0:09:45.00,Default,,0,0,0,,Барлығы бірге
Dialogue: 0,0:09:45.00,0:09:48.00,Default,,0,0,0,,Чомпа, сенде купальник бар ма?
Dialogue: 0,0:09:48.00,0:09:50.00,Default,,0,0,0,,Мен жағаға барамын
Dialogue: 0,0:09:50.00,0:09:53.00,Default,,0,0,0,,Мм, бір жерде купальник болуы керек.
Dialogue: 0,0:09:53.00,0:09:57.00,Default,,0,0,0,,Қашан барасыз? Мен оны дұрыс жоспарлаймын.
Dialogue: 0,0:09:57.00,0:09:58.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:09:58.00,0:10:02.00,Default,,0,0,0,,Жанас-санды да шақырайық, бәріміз бірге барайық.
Dialogue: 0,0:10:02.00,0:10:04.00,Default,,0,0,0,,Жаз мезгілі, солай емес пе?
Dialogue: 0,0:10:04.00,0:10:07.00,Default,,0,0,0,,Осы жаз тек бір рет болады.
Dialogue: 0,0:10:11.00,0:10:13.00,Default,,0,0,0,,Мүмкін менің қарным ашты
Dialogue: 0,0:10:15.00,0:10:17.00,Default,,0,0,0,,А, онда бірдеңе жейміз.
Dialogue: 0,0:10:17.00,0:10:20.00,Default,,0,0,0,,Мен сізге билетті толтыруға болатын дүкенді айтамын.
Dialogue: 0,0:10:22.00,0:10:26.00,Default,,0,0,0,,Арзан, бірақ дәмді қуырылған тауық етін беретін мейрамхана бар ма?
Dialogue: 0,0:10:26.00,0:10:28.00,Default,,0,0,0,,Мен мұнда А билетімен жиі келемін.
Dialogue: 0,0:10:28.00,0:10:33.00,Default,,0,0,0,,Сонымен университетке дейін келудің қажеті жоқ еді, солай ма?
Dialogue: 0,0:10:33.00,0:10:37.00,Default,,0,0,0,,Бұл да жаз мезгілін есте сақтаудың бір жолы.
Dialogue: 0,0:10:37.00,0:10:40.00,Default,,0,0,0,,Мүмкін мен А билеті бар біреуді кездестіремін.
Dialogue: 0,0:10:40.00,0:10:42.00,Default,,0,0,0,,О, ана жерде
Dialogue: 0,0:10:42.00,0:10:45.00,Default,,0,0,0,,Сол мейрамхананың қуырылған тауық еті өте жақсы.
Dialogue: 0,0:10:50.00,0:10:52.00,Default,,0,0,0,,Яна ше?
Dialogue: 0,0:10:52.00,0:10:55.00,Default,,0,0,0,,Бұл қосымша Линда-сенпай.
Dialogue: 0,0:10:55.00,0:10:57.00,Default,,0,0,0,,Неліктен бұл екеуі?
Dialogue: 0,0:10:57.00,0:11:02.00,Default,,0,0,0,,Е, иә, бұл Янаның кездесіп жүрген қызы ма?
Dialogue: 0,0:11:03.00,0:11:08.00,Default,,0,0,0,,Яна Ока-чанға ғашық емес пе?
Dialogue: 0,0:11:09.00,0:11:11.00,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:11:11.00,0:11:14.00,Default,,0,0,0,,Біз де сол дүкенге кіріп көрдік.
Dialogue: 0,0:11:14.00,0:11:15.00,Default,,0,0,0,,Тоқта
Dialogue: 0,0:11:16.00,0:11:18.00,Default,,0,0,0,,Себебі болуы керек.
Dialogue: 0,0:11:18.00,0:11:20.00,Default,,0,0,0,,Біраз уақыт бойы сергіп қалдыңыз ба?
Dialogue: 0,0:11:21.00,0:11:24.00,Default,,0,0,0,,Мен де шағын дыбыс толқынымен келісемін.
Dialogue: 0,0:11:25.00,0:11:26.00,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:11:27.00,0:11:29.00,Default,,0,0,0,,Балды бақылаңыз?
Dialogue: 0,0:11:35.00,0:11:36.00,Default,,0,0,0,,Yes
Dialogue: 0,0:11:40.00,0:11:42.00,Default,,0,0,0,,Ал, бұл не шу?
Dialogue: 0,0:11:43.00,0:11:45.00,Default,,0,0,0,,Өйткені бұл дыбыстық мицу құралы.
Dialogue: 0,0:11:45.00,0:11:47.00,Default,,0,0,0,,Бұл уақытша ғана көрініс.
Dialogue: 0,0:11:48.00,0:11:50.00,Default,,0,0,0,,Маған бұл көбірек байқалатын сияқты.
Dialogue: 0,0:11:50.00,0:11:56.00,Default,,0,0,0,,Айтайын дегенім, бүгін келгенімді ешкімге айтсаң, мен сені кешірмеймін.
Dialogue: 0,0:11:56.00,0:11:57.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:57.00,0:11:58.00,Default,,0,0,0,,Бұл шешілді, солай ма?
Dialogue: 0,0:11:58.00,0:12:03.00,Default,,0,0,0,,Себебі мен сенімен жақсы дос екенімді адамдардың қате түсінгенін қаламаймын.
Dialogue: 0,0:12:03.00,0:12:05.00,Default,,0,0,0,,Мен тағы да ұялдым
Dialogue: 0,0:12:05.00,0:12:06.00,Default,,0,0,0,,Ұялу?
Dialogue: 0,0:12:06.00,0:12:10.00,Default,,0,0,0,,Сіз жол бойы келгендіктен, бүгін тіл табысайық.
Dialogue: 0,0:12:10.00,0:12:11.00,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:12:14.00,0:12:16.00,Default,,0,0,0,,А, менде бұл бар.
Dialogue: 0,0:12:16.00,0:12:17.00,Default,,0,0,0,,(Панда) Бірінші курс студентін жіберуді қамтитын Арнайы сынып ісі — бұл төтенше жағдай.
Dialogue: 0,0:12:19.00,0:12:22.00,Default,,0,0,0,,Ойланып қарашы, одан кейін бірдеңе білдің бе?
Dialogue: 0,0:12:22.00,0:12:24.00,Default,,0,0,0,,Яна мен Линда-сенпай туралы
Dialogue: 0,0:12:24.00,0:12:28.00,Default,,0,0,0,,Мен сені ештеңеге, дәлірек айтсам, содан бері көрген емеспін.
Dialogue: 0,0:12:29.00,0:12:32.00,Default,,0,0,0,,Не? Сіз әлі де қызықсыз ба?
Dialogue: 0,0:12:32.00,0:12:34.00,Default,,0,0,0,,Мен мұны айтып тұрған жоқпын.
Dialogue: 0,0:12:34.00,0:12:37.00,Default,,0,0,0,,Бұл қалыпты сөйлесетін уақыт емес.
Dialogue: 0,0:12:38.00,0:12:40.00,Default,,0,0,0,,Бүгін менің маңызды миссиям бар.
Dialogue: 0,0:12:40.00,0:12:42.00,Default,,0,0,0,,Мен сол үшін келдім
Dialogue: 0,0:12:43.00,0:12:44.00,Default,,0,0,0,,О
Dialogue: 0,0:12:44.00,0:12:47.00,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл бірінші таңдау
Dialogue: 0,0:12:48.00,0:12:51.00,Default,,0,0,0,,Жоқ, жоқ, жақсы емес пе?
Dialogue: 0,0:12:51.00,0:12:55.00,Default,,0,0,0,,Дәлірек айтсақ, үйге келе салысымен кенеттен киімін шешеді.
Dialogue: 0,0:12:55.00,0:12:58.00,Default,,0,0,0,,Сіз бүгін купальник таңдаймын дедіңіз.
Dialogue: 0,0:12:58.00,0:13:01.00,Default,,0,0,0,,Сіз қалай ойлайсыз? Банри басып шығарылады деп ойлайсыз ба?
Dialogue: 0,0:13:02.00,0:13:05.00,Default,,0,0,0,,Міне, мен Банриді басып шығаруды төлегім келеді.
Dialogue: 0,0:13:05.00,0:13:10.00,Default,,0,0,0,,Иә, мен мінсіз купальникпен мінсіз көрінгім келеді.
Dialogue: 0,0:13:10.00,0:13:13.00,Default,,0,0,0,,Менің ойымша, мұндай нәрсе жоғалып кетті.
Dialogue: 0,0:13:14.00,0:13:18.00,Default,,0,0,0,,Төмен емес, басып шығару мүлдем жеткіліксіз.
Dialogue: 0,0:13:18.00,0:13:20.00,Default,,0,0,0,,Мен өзімді жартылай өлмегендей сезінемін.
Dialogue: 0,0:13:20.00,0:13:22.00,Default,,0,0,0,,Иә, неге?
Dialogue: 0,0:13:23.00,0:13:27.00,Default,,0,0,0,,Бұл бәрібір, сондықтан сіз бұл туралы көбірек ойлануыңыз керек.
Dialogue: 0,0:13:27.00,0:13:30.00,Default,,0,0,0,,Мен үйдегі барлық купальниктерді алып келдім.
Dialogue: 0,0:13:30.00,0:13:31.00,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:13:32.00,0:13:36.00,Default,,0,0,0,,Олай болса, мен неге купальник киюім керек?
Dialogue: 0,0:13:36.00,0:13:38.00,Default,,0,0,0,,Менімен қабаттассаң, қиналып қаласың.
Dialogue: 0,0:13:38.00,0:13:41.00,Default,,0,0,0,,Егер сіз соққыға жығылған болсаңыз, сіз артқа шегінуіңіз керек.
Dialogue: 0,0:13:41.00,0:13:44.00,Default,,0,0,0,,О, бірден шаршап барады.
Dialogue: 0,0:13:44.00,0:13:45.00,Default,,0,0,0,,Сен киіміңді ауыстырдың ба?
Dialogue: 0,0:13:45.00,0:13:46.00,Default,,0,0,0,,Иә
Dialogue: 0,0:13:46.00,0:13:49.00,Default,,0,0,0,,Жүр, кеттік, кеттік
Dialogue: 0,0:13:52.00,0:13:53.00,Default,,0,0,0,,Тауық
Dialogue: 0,0:13:53.00,0:13:55.00,Default,,0,0,0,,Біртүрлі екен, Кагаса.
Dialogue: 0,0:13:55.00,0:13:57.00,Default,,0,0,0,,Бұл тым эротикалық
Dialogue: 0,0:13:58.00,0:14:01.00,Default,,0,0,0,,Мен оны денсаулық жолы деп ойлаймын.
Dialogue: 0,0:14:01.00,0:14:04.00,Default,,0,0,0,,Бұл латынша тропикалық діріл сияқты.
Dialogue: 0,0:14:04.00,0:14:07.00,Default,,0,0,0,,Жоқ, жоқ, жоқ, бұл Жапония.
Dialogue: 0,0:14:07.00,0:14:09.00,Default,,0,0,0,,Кішкене артқа қараңыз.
Dialogue: 0,0:14:09.00,0:14:10.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:11.00,0:14:12.00,Default,,0,0,0,,Ойласам, біз ұзақ уақыт сөйлеспеген сияқтымыз
Dialogue: 0,0:14:12.00,0:14:13.00,Default,,0,0,0,,Уау
Dialogue: 0,0:14:13.00,0:14:16.00,Default,,0,0,0,,Satyback шайнау, тым мүмкін емес, сөзсіз
Dialogue: 0,0:14:16.00,0:14:19.00,Default,,0,0,0,,Мен оны сүйкімді деп ойладым
Dialogue: 0,0:14:19.00,0:14:21.00,Default,,0,0,0,,Жақсы, Кага-сан.
Dialogue: 0,0:14:21.00,0:14:24.00,Default,,0,0,0,,Қойылым алдында маған көрсетті
Dialogue: 0,0:14:24.00,0:14:28.00,Default,,0,0,0,,Сейдай Ниджиконы тоқтатты, ол бәрінің есінде қалды.
Dialogue: 0,0:14:28.00,0:14:31.00,Default,,0,0,0,,Сонымен, сіз басқа адамдар туралы айта алмайсыз ба?
Dialogue: 0,0:14:31.00,0:14:33.00,Default,,0,0,0,,Мені қатты мазалаған да осы.
Dialogue: 0,0:14:33.00,0:14:35.00,Default,,0,0,0,,О, бұл өтірік.
Dialogue: 0,0:14:35.00,0:14:37.00,Default,,0,0,0,,Бұл не? Бұл не?
Dialogue: 0,0:14:37.00,0:14:38.00,Default,,0,0,0,,Жүзу костюмі
Dialogue: 0,0:14:38.00,0:14:40.00,Default,,0,0,0,,Қалай қарасаң да саз балшық.
Dialogue: 0,0:14:40.00,0:14:42.00,Default,,0,0,0,,Оны қандай жіппен тағып жүрсіз?
Dialogue: 0,0:14:42.00,0:14:44.00,Default,,0,0,0,,Менің ойымша, бұл сүйкімді
Dialogue: 0,0:14:44.00,0:14:45.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:14:45.00,0:14:50.00,Default,,0,0,0,,Маған әйел сияқты жүретін қыздар ұнамайды.
Dialogue: 0,0:14:50.00,0:14:55.00,Default,,0,0,0,,Осымен ол демалыс киіміне ұқсайды, сондықтан бұл туралы алаңдамаудың қажеті жоқ, солай ма?
Dialogue: 0,0:14:55.00,0:15:00.00,Default,,0,0,0,,Сіз әпке сияқты әрекет етесіз, дәлірек айтсақ, сіз қазір саз балшық ойнап жатырсыз.
Dialogue: 0,0:15:01.00,0:15:08.00,Default,,0,0,0,,Дегенмен, дизайнерлік жіп ретінде маған француз үлгісіндегі жіп ұнайды, сәл осындай, энхан тәрізді.
Dialogue: 0,0:15:08.00,0:15:10.00,Default,,0,0,0,,Жоқ, бұл Жапония.
Dialogue: 0,0:15:10.00,0:15:13.00,Default,,0,0,0,,Иә, Жапония.
Dialogue: 0,0:15:15.00,0:15:17.00,Default,,0,0,0,,Келесі!
Dialogue: 0,0:15:18.00,0:15:21.00,Default,,0,0,0,,Сіз шынымен бізге алаңдаудың қажеті жоқ деп ойлайсыз ба?
Dialogue: 0,0:15:21.00,0:15:22.00,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:15:22.00,0:15:28.00,Default,,0,0,0,,Банди Кага-санға ғашық екені көрініп тұр.
Dialogue: 0,0:15:29.00,0:15:36.00,Default,,0,0,0,,Банди менен бірдеңе сұрауға қорқатын сияқты.
Dialogue: 0,0:15:36.00,0:15:38.00,Default,,0,0,0,,Сіз әлі сүйіп көрдіңіз бе?
Dialogue: 0,0:15:38.00,0:15:41.00,Default,,0,0,0,,Сүйісеміз, кейде.
Dialogue: 0,0:15:44.00,0:15:48.00,Default,,0,0,0,,Сіз Бандиге біртүрлі қысым жасайсыз ба?
Dialogue: 0,0:15:49.00,0:15:52.00,Default,,0,0,0,,Кага-сан Бандимен болған жағдайға риза бола ма?
Dialogue: 0,0:15:53.00,0:15:59.00,Default,,0,0,0,,Мен Бандиді қаншалықты жақсы көретінімді түсінгеніңізді қалаймын.
Dialogue: 0,0:15:59.00,0:16:08.00,Default,,0,0,0,,Бұл жай ғана мүйізденіп, жабайы аң сияқты маған шабуыл жасау дегенді білдіре ме?
Dialogue: 0,0:16:08.00,0:16:13.00,Default,,0,0,0,,О, сен қандайсың? Сіз бұл дауыспен бірдеңе айта аламын деп ойлайсыз ба?
Dialogue: 0,0:16:13.00,0:16:18.00,Default,,0,0,0,,Әдемі сөзбен айтқанда, көп жағдайда!
Dialogue: 0,0:16:18.00,0:16:22.00,Default,,0,0,0,,Жоқ, бірақ сен қорқыныштысың, бұл менің айтқым келгені емес.
Dialogue: 0,0:16:22.00,0:16:30.00,Default,,0,0,0,,Мен қатты қиналдым деп айта аламын.
Dialogue: 0,0:16:30.00,0:16:32.00,Default,,0,0,0,,Не болды, не болды?
Dialogue: 0,0:16:33.00,0:16:34.00,Default,,0,0,0,,Тіпті осы уақыт ішінде
Dialogue: 0,0:16:35.00,0:16:37.00,Default,,0,0,0,,Кага-сан, кеуде кеудесі
Dialogue: 0,0:16:40.00,0:16:42.00,Default,,0,0,0,,Осы уақыт ішінде не болды?
Dialogue: 0,0:16:42.00,0:16:47.00,Default,,0,0,0,,Мен Бандидің пәтеріне бардым, қайтар жолда атмосфера сәл жақсы болды.
Dialogue: 0,0:16:47.00,0:16:50.00,Default,,0,0,0,,Иә дедім де, бетімді сүйдім.
Dialogue: 0,0:16:51.00,0:16:52.00,Default,,0,0,0,,Ал егер?
Dialogue: 0,0:16:52.00,0:16:57.00,Default,,0,0,0,,Мен өзімді қиналғандай сезіндім, сондықтан мен жай ғана шағымдандым.
Dialogue: 0,0:16:58.00,0:17:00.00,Default,,0,0,0,,Жалғыз сумо
Dialogue: 0,0:17:01.00,0:17:05.00,Default,,0,0,0,,Мен жағдайды жөндеп алдым, бірақ ішім тоз-тоз болып қалды.
Dialogue: 0,0:17:05.00,0:17:09.00,Default,,0,0,0,,Дәлірек айтсақ, оған дейін үйдегі кездесу қалай өтті?
Dialogue: 0,0:17:09.00,0:17:12.00,Default,,0,0,0,,Ауа якисоба жасау сияқты.
Dialogue: 0,0:17:12.00,0:17:13.00,Default,,0,0,0,,Ауада қуырылған кеспе?
Dialogue: 0,0:17:13.00,0:17:19.00,Default,,0,0,0,,Жоқ, қысқасы, мен Бандиге тамақ пісіріп қуантатынмын.
Dialogue: 0,0:17:19.00,0:17:23.00,Default,,0,0,0,,Осыдан кейін мен босаңсып, якисобаның иісіне бөлендім.
Dialogue: 0,0:17:23.00,0:17:29.00,Default,,0,0,0,,Жігітіңіздің бөлмесінде сағаттап отырып, мұндай көңіл-күйге ешқашан кірмейсіз бе?
Dialogue: 0,0:17:29.00,0:17:32.00,Default,,0,0,0,,Дұрыс! Бұл бірінші мәселе!
Dialogue: 0,0:17:32.00,0:17:34.00,Default,,0,0,0,,Мүлде жоқ.
Dialogue: 0,0:17:34.00,0:17:38.00,Default,,0,0,0,,Бірақ мен Бернидің сезімін түсінгендей болдым.
Dialogue: 0,0:17:38.00,0:17:41.00,Default,,0,0,0,,Иә? Қалай?
Dialogue: 0,0:17:41.00,0:17:44.00,Default,,0,0,0,,Міне, сол шарасыз жүз.
Dialogue: 0,0:17:44.00,0:17:47.00,Default,,0,0,0,,Жеміс осындай ынтамен лақтырса да
Dialogue: 0,0:17:47.00,0:17:52.00,Default,,0,0,0,,Бұл құрбандыққа шалынған қызды нысанаға алған құбыжық сияқты.
Dialogue: 0,0:17:54.00,0:17:57.00,Default,,0,0,0,,Мен саған жақсырақ қарағым келеді
Dialogue: 0,0:17:57.00,0:18:00.00,Default,,0,0,0,,Екілену дұшпанның ниетінің белгісі сияқты.
Dialogue: 0,0:18:00.00,0:18:04.00,Default,,0,0,0,,Бірақ біз не істеуіміз керек?
Dialogue: 0,0:18:06.00,0:18:09.00,Default,,0,0,0,,Сенің маған көңіл бөлетініңді білемін.
Dialogue: 0,0:18:09.00,0:18:13.00,Default,,0,0,0,,Бірақ мен өзімді қуыршақ сияқты сезінемін.
Dialogue: 0,0:18:13.00,0:18:15.00,Default,,0,0,0,,Банди - мен
Dialogue: 0,0:18:16.00,0:18:19.00,Default,,0,0,0,,О, сіз өте бұрыштасыз.
Dialogue: 0,0:18:19.00,0:18:26.00,Default,,0,0,0,,Мен жыл сайынғы демалысымызға отбасыммен Барселонаға баруды жоспарлап отырмын.
Dialogue: 0,0:18:26.00,0:18:31.00,Default,,0,0,0,,Бірақ мен жалғыз Токиода қалып, Бандимен түнедім.
Dialogue: 0,0:18:31.00,0:18:37.00,Default,,0,0,0,,Мен оны осындай қарым-қатынаста болатын жағдайға жеткізгім келетінін сеземін.
Dialogue: 0,0:18:38.00,0:18:41.00,Default,,0,0,0,,Сондықтан бұл жолы теңіз толық жеңіс шайқасы болады.
Dialogue: 0,0:18:41.00,0:18:45.00,Default,,0,0,0,,Менің де байсалды екенімді түсінгеніңізді қалаймын.
Dialogue: 0,0:18:47.00,0:18:50.00,Default,,0,0,0,,Мен үнемі уайымдаймын
Dialogue: 0,0:18:50.00,0:18:53.00,Default,,0,0,0,,Сіз Барселонаға баруды жоспарлап отырсыз ба?
Dialogue: 0,0:18:53.00,0:18:55.00,Default,,0,0,0,,Мен үнемі уайымдаймын
Dialogue: 0,0:18:55.00,0:18:58.00,Default,,0,0,0,,Банди мені шынымен ұната ма?
Dialogue: 0,0:18:59.00,0:19:02.00,Default,,0,0,0,,Қызық, Банди бір күні кенет жоғалып кете ме?
Dialogue: 0,0:19:03.00,0:19:06.00,Default,,0,0,0,,Банди шынымен қайда?
Dialogue: 0,0:19:07.00,0:19:10.00,Default,,0,0,0,,Банди әлі Банди іздеп жүр ме деп ойлаймын.
Dialogue: 0,0:19:11.00,0:19:13.00,Default,,0,0,0,,Бір күні мен оны табамын
Dialogue: 0,0:19:14.00,0:19:17.00,Default,,0,0,0,,Бір жерге барыңыз
Dialogue: 0,0:19:18.00,0:19:19.00,Default,,0,0,0,,Какао мырза
Dialogue: 0,0:19:20.00,0:19:21.00,Default,,0,0,0,,О, қазірдің өзінде
Dialogue: 0,0:19:21.00,0:19:24.00,Default,,0,0,0,,Негізінде купальник маңызды емес.
Dialogue: 0,0:19:24.00,0:19:29.00,Default,,0,0,0,,Бұл ішкі дүние, жүрек, тағдыр, соған ұқсас нәрселер туралы көбірек.
Dialogue: 0,0:19:31.00,0:19:33.00,Default,,0,0,0,,Келесі ұстағанымды киемін.
Dialogue: 0,0:19:33.00,0:19:37.00,Default,,0,0,0,,Онда мен ұстағанымды қарызға беремін, бітті.
Dialogue: 0,0:19:37.00,0:19:38.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:38.00,0:19:41.00,Default,,0,0,0,,Біріншіден, менің купальникім мынау.
Dialogue: 0,0:19:42.00,0:19:44.00,Default,,0,0,0,,Ал мынау сенің шомылу киімің.
Dialogue: 0,0:19:45.00,0:19:48.00,Default,,0,0,0,,Неліктен екі мектептік купальник кию керек?
Dialogue: 0,0:19:49.00,0:19:53.00,Default,,0,0,0,,Мынау мен орта мектепте оқып жүрген кезім еді, ал мынау орта мектепте оқып жүрген кезім еді.
Dialogue: 0,0:19:55.00,0:19:57.00,Default,,0,0,0,,Бірақ бұл таң қаларлықтай емес пе?
Dialogue: 0,0:19:57.00,0:19:59.00,Default,,0,0,0,,Бұл шамамен 2 апта бойы қызықты болуы мүмкін
Dialogue: 0,0:20:00.00,0:20:01.00,Default,,0,0,0,,Осылай болмас еді...
Dialogue: 0,0:20:01.00,0:20:05.00,Default,,0,0,0,,Шынында да, камераңыздың іске қосылатын уақыты келді.
Dialogue: 0,0:20:07.00,0:20:10.00,Default,,0,0,0,,Бұл мүмкін емес, менің ойымша, бұл басқаша.
Dialogue: 0,0:20:10.00,0:20:11.00,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:20:11.00,0:20:15.00,Default,,0,0,0,,Жоқ, бұған қуанатындар көп деп ойлаймын.
Dialogue: 0,0:20:15.00,0:20:18.00,Default,,0,0,0,,Мен назар аударғым келетін нәрсе - Банри.
Dialogue: 0,0:20:18.00,0:20:23.00,Default,,0,0,0,,Мүмкін Банри осыдан кейін жаңа хоббимен айналысатын шығар.
Dialogue: 0,0:20:23.00,0:20:26.00,Default,,0,0,0,,Мен мұны сұрамаймын.
Dialogue: 0,0:20:26.00,0:20:28.00,Default,,0,0,0,,Сәлем, кейбір пікірлер
Dialogue: 0,0:20:29.00,0:20:30.00,Default,,0,0,0,,О, қазірдің өзінде
Dialogue: 0,0:20:32.00,0:20:33.00,Default,,0,0,0,,Ғылыми орта мектебі
Dialogue: 0,0:20:33.00,0:20:37.00,Default,,0,0,0,,Мені ультрадыбыстың бұйрығымен осылай етіп жаратты.
Dialogue: 0,0:20:37.00,0:20:39.00,Default,,0,0,0,,Бұл Чинами Ока.
Dialogue: 0,0:20:41.00,0:20:43.00,Default,,0,0,0,,Болашақта маған қарап тұрсың ба?
Dialogue: 0,0:20:43.00,0:20:45.00,Default,,0,0,0,,Сәлем, Кага-сан да.
Dialogue: 0,0:20:47.00,0:20:49.00,Default,,0,0,0,,Ғылыми орта мектебі
Dialogue: 0,0:20:50.00,0:20:51.00,Default,,0,0,0,,Банри, қарап тұрсың ба?
Dialogue: 0,0:20:51.00,0:20:53.00,Default,,0,0,0,,Мен сені сүйемін, мен сені сүйемін
Dialogue: 0,0:20:54.00,0:20:57.00,Default,,0,0,0,,Мен сені бүгін де, ертең де, арғы күні де жақсы көремін.
Dialogue: 0,0:20:58.00,0:21:00.00,Default,,0,0,0,,Келесі жолы жағаға барамыз.
Dialogue: 0,0:21:00.00,0:21:04.00,Default,,0,0,0,,Бұл өте қызық және өмір бойы есте қалатын естеліктер жасайды.
Dialogue: 0,0:21:04.00,0:21:05.00,Default,,0,0,0,,Сәлем Кага-сан
Dialogue: 0,0:21:08.00,0:21:11.00,Default,,0,0,0,,Бұл бетті жасауды тоқтату керек.
Dialogue: 0,0:21:14.00,0:21:16.00,Default,,0,0,0,,Сізде екі таңдау бар, өзіңізге ұнағанын таңдаңыз.
Dialogue: 0,0:21:18.00,0:21:21.00,Default,,0,0,0,,Бұл мен орта мектептің үшінші курсында оқып жүргенімде сатып алған зиянсыз зат.
Dialogue: 0,0:21:21.00,0:21:27.00,Default,,0,0,0,,Бұл президенттің кешегі кештен кейін маған сыйға берген мазақ нәрсесі.
Dialogue: 0,0:21:27.00,0:21:32.00,Default,,0,0,0,,Сіз менің зияндырақ нұсқаны таңдау мүмкіндігім бар деп ойладыңыз ба?
Dialogue: 0,0:21:33.00,0:21:34.00,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:21:34.00,0:21:37.00,Default,,0,0,0,,Банри мұндай нәрселерде таңқаларлықтай жақсы көрінеді.
Dialogue: 0,0:21:39.00,0:21:42.00,Default,,0,0,0,,Өйткені, Линда-сенпайды да шақырғым келді.
Dialogue: 0,0:21:43.00,0:21:47.00,Default,,0,0,0,,Ол жаңа ғана ата-анасының үйіне қайтатынын айтты, сондықтан мен оған ештеңе айтпадым.
Dialogue: 0,0:21:50.00,0:21:52.00,Default,,0,0,0,,Линда-сенпайдың үйі қайда?
Dialogue: 0,0:21:53.00,0:21:54.00,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:22:04.00,0:22:08.00,Default,,0,0,0,,Жоқ, ол басқаша.
Dialogue: 0,0:22:09.00,0:22:11.00,Default,,0,0,0,,Сіз оны әлі түсінбейсіз.
Dialogue: 0,0:22:11.00,0:22:14.00,Default,,0,0,0,,Мүмкін екі-үш сағат бұрын.
Dialogue: 0,0:22:14.00,0:22:18.00,Default,,0,0,0,,Мен сол қолды ұстағым келеді
Dialogue: 0,0:22:18.00,0:22:24.00,Default,,0,0,0,,Сен де, сен де.
Dialogue: 0,0:22:24.00,0:22:28.00,Default,,0,0,0,,Айқайлағым келеді, бұл өте жақсы
Dialogue: 0,0:22:28.00,0:22:31.00,Default,,0,0,0,,Сен де, сен де.
Dialogue: 0,0:22:31.00,0:22:34.00,Default,,0,0,0,,Айқайлағым келеді, бұл өте жақсы
Dialogue: 0,0:22:34.00,0:22:38.00,Default,,0,0,0,,Қараңызшы, олардың көптігі сонша, тітіркендіреді.
Dialogue: 0,0:22:38.00,0:22:41.00,Default,,0,0,0,,Неліктен, неге, жоқ?
Dialogue: 0,0:22:41.00,0:22:44.00,Default,,0,0,0,,О, түсінбейсің бе?
Dialogue: 0,0:22:45.00,0:22:51.00,Default,,0,0,0,,Маған шын, шын ғашық
Dialogue: 0,0:22:51.00,0:22:57.00,Default,,0,0,0,,Қатты сөздердің қажеті жоқ
Dialogue: 0,0:22:58.00,0:23:01.00,Default,,0,0,0,,Мені тезірек сүй
Dialogue: 0,0:23:01.00,0:23:04.00,Default,,0,0,0,,5000 жылдан кейін мені қызықтырмайды.
Dialogue: 0,0:23:04.00,0:23:08.00,Default,,0,0,0,,Мен шексіз емеспін
Dialogue: 0,0:23:08.00,0:23:11.00,Default,,0,0,0,,Сіз қашан білесіз?
Dialogue: 0,0:23:11.00,0:23:14.00,Default,,0,0,0,,Мен сені мәңгілікке сүйемін
Dialogue: 0,0:23:14.00,0:23:17.00,Default,,0,0,0,,Айтсаң да риза емеспін
