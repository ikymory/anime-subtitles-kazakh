Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Мен... Мен Тада-кунды жақсы көремін!
Dialogue: 0,0:00:06.88,0:00:09.38,Default,,0,0,0,,Әзірше мен сенің полиция бөлімшесіне келгеніңді қалаймын.
Dialogue: 0,0:00:30.00,0:00:33.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:00.00,0:01:05.58,Default,,0,0,0,,Мен оны қазір түсінетін сияқтымын.
Dialogue: 0,0:01:05.58,0:01:09.00,Default,,0,0,0,,Өткен және болашақ Қорықсаң да
Dialogue: 0,0:01:09.00,0:01:12.80,Default,,0,0,0,,Бос болса қозғала алмайды
Dialogue: 0,0:01:12.80,0:01:17.88,Default,,0,0,0,,Сізге ұнайтын болса, жақсы
Dialogue: 0,0:01:17.88,0:01:19.54,Default,,0,0,0,,Бастайық
Dialogue: 0,0:01:19.54,0:01:22.80,Default,,0,0,0,,Барлық жаман нәрселерді ұмытыңыз
Dialogue: 0,0:01:22.80,0:01:26.00,Default,,0,0,0,,Мен сенімен түнде билесем
Dialogue: 0,0:01:26.00,0:01:29.34,Default,,0,0,0,,Өзіңіздің жақсырақ нұсқасы болыңыз
Dialogue: 0,0:01:29.34,0:01:33.22,Default,,0,0,0,,Мен солай сезінемін.
Dialogue: 0,0:01:33.22,0:01:36.42,Default,,0,0,0,,Ешқашан бітпейтін мазмұн уақыты
Dialogue: 0,0:01:36.42,0:01:39.62,Default,,0,0,0,,Сен екеуміздің арамыз жақындап барады
Dialogue: 0,0:01:39.62,0:01:43.02,Default,,0,0,0,,Айналмалы жолмен болса да, соқпаңыз және атпаңыз
Dialogue: 0,0:01:43.02,0:01:47.02,Default,,0,0,0,,Мен оны бағалағым келеді
Dialogue: 0,0:01:54.02,0:01:55.02,Default,,0,0,0,,Кака-сан!
Dialogue: 0,0:01:55.92,0:01:58.52,Default,,0,0,0,,Ата-анаңыз келгенше осында күтіңіз.
Dialogue: 0,0:02:00.02,0:02:01.02,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:01.02,0:02:04.02,Default,,0,0,0,,Құжаттарды жазу арқылы ғана кешіріледі деп ойлаймын.
Dialogue: 0,0:02:04.02,0:02:05.02,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:07.02,0:02:08.02,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:09.02,0:02:12.02,Default,,0,0,0,,Мен тағы да қиындық туғыздым.
Dialogue: 0,0:02:12.02,0:02:15.02,Default,,0,0,0,,Жоқ, керісінше
Dialogue: 0,0:02:18.02,0:02:23.02,Default,,0,0,0,,Мен Кака Янаны әлі ұмытқан жоқ деп ойладым.
Dialogue: 0,0:02:23.02,0:02:26.02,Default,,0,0,0,,Мен анама мойындағанымда, ол шошып кетті.
Dialogue: 0,0:02:26.70,0:02:30.70,Default,,0,0,0,,Бұл Мицуоның ультрадыбыстық зерттеуде мойындағанын таң қалдырды.
Dialogue: 0,0:02:30.70,0:02:35.70,Default,,0,0,0,,Мен болғаныма өкіндім
Dialogue: 0,0:02:35.70,0:02:36.70,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:02:36.70,0:02:41.70,Default,,0,0,0,,УДЗ менде жоқ нәрсені оңай береді.
Dialogue: 0,0:02:41.70,0:02:46.70,Default,,0,0,0,,Мицуо, көңілді өмір және жаңа достар
Dialogue: 0,0:02:46.70,0:02:48.70,Default,,0,0,0,,Тіпті Тада-кун
Dialogue: 0,0:02:48.70,0:02:49.70,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:02:49.70,0:02:54.70,Default,,0,0,0,,Мүмкін сіз УЗИ-ге тегін түсе аласыз.
Dialogue: 0,0:02:55.38,0:02:58.38,Default,,0,0,0,,Осыны ойлағанда көңілім мұң болды.
Dialogue: 0,0:03:00.38,0:03:03.38,Default,,0,0,0,,Мен Тада-кунға барған сайын тартылып бара жатқанымды мойындаймын.
Dialogue: 0,0:03:03.38,0:03:06.38,Default,,0,0,0,,Мен үшін өте қиын болды
Dialogue: 0,0:03:06.38,0:03:09.38,Default,,0,0,0,,Жауапсыз махаббаттан ренжігенім үшін
Dialogue: 0,0:03:09.38,0:03:13.38,Default,,0,0,0,,Мүмкін сіз жай ғана мейірімді адамды таңдаған шығарсыз.
Dialogue: 0,0:03:13.38,0:03:16.38,Default,,0,0,0,,Тіпті өзіңізге де күмәнданатын нәрселер
Dialogue: 0,0:03:19.38,0:03:22.38,Default,,0,0,0,,Менің сценарийімде солай.
Dialogue: 0,0:03:23.06,0:03:25.06,Default,,0,0,0,,ЖОҚ деп айту дұрыс па?
Dialogue: 0,0:03:25.06,0:03:26.06,Default,,0,0,0,,Сценарий?
Dialogue: 0,0:03:26.06,0:03:31.06,Default,,0,0,0,,Мен өзімді өсіремін және бұл жолы өз сезімімді мойындаймын.
Dialogue: 0,0:03:31.06,0:03:36.06,Default,,0,0,0,,Мен бұл дұрыс даму және әлем өзгереді деп ойладым.
Dialogue: 0,0:03:36.06,0:03:41.06,Default,,0,0,0,,Бірақ бұл сценарий бойынша жүрмейді.
Dialogue: 0,0:03:45.06,0:03:48.06,Default,,0,0,0,,Сен мені тастасаң болады, мен сенің серігіңмін.
Dialogue: 0,0:03:48.06,0:03:49.06,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:03:49.74,0:03:50.74,Default,,0,0,0,,Коуко Кага
Dialogue: 0,0:03:51.74,0:03:53.74,Default,,0,0,0,,Әкем келді.
Dialogue: 0,0:03:53.74,0:03:55.74,Default,,0,0,0,,Коуконың әкесі
Dialogue: 0,0:03:57.74,0:03:59.74,Default,,0,0,0,,Ой!
Dialogue: 0,0:03:59.74,0:04:01.74,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:01.74,0:04:05.74,Default,,0,0,0,,Мен де велосипед иесінен кешірім сұраймын.
Dialogue: 0,0:04:05.74,0:04:06.74,Default,,0,0,0,,Сосын мен де
Dialogue: 0,0:04:06.74,0:04:09.74,Default,,0,0,0,,Мен бұдан былай қиындық туғыза алмаймын.
Dialogue: 0,0:04:09.74,0:04:14.74,Default,,0,0,0,,Мен сенің ақымақ екеніңді білемін, бірақ сен бұл жерге келіп, дос болып қала алмайсың ба деп ойлаймын.
Dialogue: 0,0:04:14.74,0:04:15.74,Default,,0,0,0,,Иә
Dialogue: 0,0:04:16.42,0:04:18.42,Default,,0,0,0,,Менің жігітім
Dialogue: 0,0:04:29.42,0:04:31.42,Default,,0,0,0,,Дауылды күн болды.
Dialogue: 0,0:04:46.42,0:04:49.42,Default,,0,0,0,,Ро-ни-о-са-ма
Dialogue: 0,0:04:49.42,0:04:51.42,Default,,0,0,0,,Міне Джульетта келді
Dialogue: 0,0:04:53.42,0:04:56.42,Default,,0,0,0,,Қайырлы таң, менің жігітім Тада-кун.
Dialogue: 0,0:04:56.42,0:04:57.42,Default,,0,0,0,,Кага-сан
Dialogue: 0,0:05:05.42,0:05:07.42,Default,,0,0,0,,Сіз 30 минут күттіңіз бе?
Dialogue: 0,0:05:07.42,0:05:08.42,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:05:08.42,0:05:09.42,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:05:10.10,0:05:12.10,Default,,0,0,0,,Маған электрондық хат жібергеніңізді қалаймын.
Dialogue: 0,0:05:12.10,0:05:14.10,Default,,0,0,0,,Махаббатыңызды білдіргіңіз келді ме?
Dialogue: 0,0:05:14.10,0:05:16.10,Default,,0,0,0,,Қараңызшы, бұл
Dialogue: 0,0:05:20.10,0:05:21.10,Default,,0,0,0,,Иә? Ит?
Dialogue: 0,0:05:21.10,0:05:24.10,Default,,0,0,0,,Иә, иесін күтіп өлді, бейшара.
Dialogue: 0,0:05:26.10,0:05:27.10,Default,,0,0,0,,Орта дәрежелі Хакко
Dialogue: 0,0:05:27.10,0:05:29.10,Default,,0,0,0,,Дұрыс, сен кереметсің.
Dialogue: 0,0:05:29.10,0:05:31.10,Default,,0,0,0,,Өйткені, біз сізге хабарлауымыз керек.
Dialogue: 0,0:05:31.10,0:05:38.10,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:05:38.78,0:05:40.78,Default,,0,0,0,,Өйткені, бізге хабарланды.
Dialogue: 0,0:05:42.78,0:05:43.78,Default,,0,0,0,,Бірақ сәтсіз аяқталды
Dialogue: 0,0:05:43.78,0:05:44.78,Default,,0,0,0,,Не?
Dialogue: 0,0:05:44.78,0:05:46.78,Default,,0,0,0,,Егер мен сені Тада-кунның үйінің алдында тұтқындаған болсам.
Dialogue: 0,0:05:46.78,0:05:48.78,Default,,0,0,0,,Біз ұзағырақ бірге бола алар едік.
Dialogue: 0,0:05:49.78,0:05:51.78,Default,,0,0,0,,Тұтқынсыз да
Dialogue: 0,0:05:51.78,0:05:53.78,Default,,0,0,0,,Бір жерде кездесейік.
Dialogue: 0,0:05:53.78,0:05:55.78,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:05:55.78,0:05:56.78,Default,,0,0,0,,Өйткені
Dialogue: 0,0:05:56.78,0:05:58.78,Default,,0,0,0,,Маған Тада-кун ұнайды.
Dialogue: 0,0:06:01.78,0:06:04.78,Default,,0,0,0,,Мен бір секундты да, метрді де босқа кеткім келмейді.
Dialogue: 0,0:06:04.78,0:06:07.78,Default,,0,0,0,,Таданың күннің алғашқы қадамынан
Dialogue: 0,0:06:08.46,0:06:10.46,Default,,0,0,0,,Бірінші секундтан бастап сенімен бірге болғым келеді
Dialogue: 0,0:06:17.46,0:06:19.46,Default,,0,0,0,,Мен біртүрлі нәрсе айттым ба?
Dialogue: 0,0:06:21.46,0:06:25.46,Default,,0,0,0,,Байғұспен кездескенде бақыттымын деп ойладым.
Dialogue: 0,0:06:25.46,0:06:27.46,Default,,0,0,0,,Бұл өте өкінішті.
Dialogue: 0,0:06:31.46,0:06:34.46,Default,,0,0,0,,Байғұс қызды күнде көтеріп жүретін менмін.
Dialogue: 0,0:06:35.14,0:06:36.14,Default,,0,0,0,,Бұл
Dialogue: 0,0:06:36.14,0:06:37.14,Default,,0,0,0,,Мұны айту қиын, бірақ
Dialogue: 0,0:06:37.14,0:06:39.14,Default,,0,0,0,,Менің үйіме келу дұрыс емес.
Dialogue: 0,0:06:39.14,0:06:40.14,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:40.14,0:06:43.14,Default,,0,0,0,,Сіз менімен кездесуге қарсысыз ба?
Dialogue: 0,0:06:43.14,0:06:45.14,Default,,0,0,0,,Жоқ, мен зиянсыз жігітпін.
Dialogue: 0,0:06:45.14,0:06:47.14,Default,,0,0,0,,Бұл керісінше.
Dialogue: 0,0:06:47.14,0:06:49.14,Default,,0,0,0,,Мен зияндымын
Dialogue: 0,0:06:49.14,0:06:50.14,Default,,0,0,0,,Зиянды ма?
Dialogue: 0,0:06:50.14,0:06:52.14,Default,,0,0,0,,Әкем айтты
Dialogue: 0,0:06:52.14,0:06:55.14,Default,,0,0,0,,Тада-кунға жақындама
Dialogue: 0,0:06:55.14,0:06:57.14,Default,,0,0,0,,Мен сияқты бейтаныс адам жабысса
Dialogue: 0,0:06:57.14,0:06:59.14,Default,,0,0,0,,Таданың өмірі бұзылды
Dialogue: 0,0:06:59.14,0:07:01.14,Default,,0,0,0,,Жаңа мақсат?
Dialogue: 0,0:07:01.82,0:07:03.82,Default,,0,0,0,,Яна сіздің ескі мақсатыңыз ба?
Dialogue: 0,0:07:05.82,0:07:08.82,Default,,0,0,0,,Әйтеуір, біз жақсымыз, данамыз.
Dialogue: 0,0:07:09.82,0:07:13.82,Default,,0,0,0,,Ромео мен Джульетта Бір күні бәріміз бір-бірімізді өлтіруіміз мүмкін
Dialogue: 0,0:07:13.82,0:07:16.82,Default,,0,0,0,,Жоқ, ол адамдар бірін-бірі жалғыз өлтірді.
Dialogue: 0,0:07:16.82,0:07:17.82,Default,,0,0,0,,Әңгіме қандай?
Dialogue: 0,0:07:18.82,0:07:19.82,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:07:20.82,0:07:22.82,Default,,0,0,0,,Көріп отырғаныңыздай.
Dialogue: 0,0:07:24.82,0:07:25.82,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:07:25.82,0:07:26.82,Default,,0,0,0,,Неліктен және қашан?
Dialogue: 0,0:07:26.82,0:07:28.82,Default,,0,0,0,,Бұл өтірік емес пе?
Dialogue: 0,0:07:29.50,0:07:33.50,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:07:39.50,0:07:42.50,Default,,0,0,0,,Сізді ұрып-соқтыңыз ба?
Dialogue: 0,0:07:43.50,0:07:44.50,Default,,0,0,0,,Бұл қазірдің өзінде қиын
Dialogue: 0,0:07:45.50,0:07:46.50,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:07:49.50,0:07:51.50,Default,,0,0,0,,Яна-сан, салқын
Dialogue: 0,0:07:52.50,0:07:53.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:54.50,0:07:57.50,Default,,0,0,0,,Жоқ, бұл жай ғана өзін-өзі қорғау мәселесі.
Dialogue: 0,0:07:58.18,0:08:01.18,Default,,0,0,0,,Басын таз етіп көрсету керек деп, шашын қиюын өтіндім.
Dialogue: 0,0:08:01.18,0:08:05.18,Default,,0,0,0,,Дүкен қызметкерлері маған бір жынысты үй жануарларым болса, оны жаттығу үстелі ретінде пайдалануға болатынын айтты.
Dialogue: 0,0:08:05.18,0:08:06.18,Default,,0,0,0,,Осы сияқты
Dialogue: 0,0:08:08.18,0:08:11.18,Default,,0,0,0,,Сонымен Банри мен Коукоға не болды?
Dialogue: 0,0:08:11.18,0:08:14.18,Default,,0,0,0,,Мен сені кездесіп жүргеніңді естідім, таң қалмайсың ба?
Dialogue: 0,0:08:15.18,0:08:19.18,Default,,0,0,0,,Жоқ, мен бір сәт керемет деп ойладым, бірақ мен таң қалмадым.
Dialogue: 0,0:08:20.18,0:08:23.18,Default,,0,0,0,,Цуйука Жақында бұл жігіттердің басына түседі деп ойлаймын.
Dialogue: 0,0:08:23.18,0:08:25.18,Default,,0,0,0,,Мен солай ойладым
Dialogue: 0,0:08:25.18,0:08:27.18,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:08:27.86,0:08:30.86,Default,,0,0,0,,Менің көргенім, Банри Коукомен кездесе алатын сияқты.
Dialogue: 0,0:08:30.86,0:08:33.86,Default,,0,0,0,,Кеуна үлкен турдың иесі.
Dialogue: 0,0:08:34.86,0:08:36.86,Default,,0,0,0,,Бұл маған сергітетіндей әсер қалдырады
Dialogue: 0,0:08:36.86,0:08:40.86,Default,,0,0,0,,Маған жабысып қалған зұлым рух ақыры жойылғандай сезінемін.
Dialogue: 0,0:08:40.86,0:08:42.86,Default,,0,0,0,,О, бұл таңқаларлық.
Dialogue: 0,0:08:42.86,0:08:45.86,Default,,0,0,0,,Егер мен мұны ғана айта аламын, Мицуо өте жақсы қалпына келді.
Dialogue: 0,0:08:45.86,0:08:48.86,Default,,0,0,0,,Ультрадыбыспен соншалықты аянышты күйде сілкіп кетсем де.
Dialogue: 0,0:08:49.86,0:08:51.86,Default,,0,0,0,,Осы сүйкімді кішкентай ультрадыбыстық дауыспен
Dialogue: 0,0:08:51.86,0:08:53.86,Default,,0,0,0,,Не, ақымақ?
Dialogue: 0,0:08:53.86,0:08:55.86,Default,,0,0,0,,тым көп әсер етеді.
Dialogue: 0,0:08:56.54,0:08:57.54,Default,,0,0,0,,Мен болсам, болар едім
Dialogue: 0,0:08:57.54,0:08:59.54,Default,,0,0,0,,М.Г.
Dialogue: 0,0:09:01.54,0:09:03.54,Default,,0,0,0,,Бірақ бәрібір, Мицуо күшті бала.
Dialogue: 0,0:09:04.54,0:09:06.54,Default,,0,0,0,,Кака-сан, кететін уақыт болды.
Dialogue: 0,0:09:06.54,0:09:08.54,Default,,0,0,0,,және бүгінге осы жетсін
Dialogue: 0,0:09:08.54,0:09:10.54,Default,,0,0,0,,Бірақ мен сені тегін тастап кеткім келмейді.
Dialogue: 0,0:09:10.54,0:09:12.54,Default,,0,0,0,,Мен де сол сыныпты алуым керек еді.
Dialogue: 0,0:09:12.54,0:09:14.54,Default,,0,0,0,,Мен сені кейін көремін.
Dialogue: 0,0:09:14.54,0:09:16.54,Default,,0,0,0,,Үзілісте бірге болайық.
Dialogue: 0,0:09:16.54,0:09:18.54,Default,,0,0,0,,Түскі асты бірге ішейік.
Dialogue: 0,0:09:18.54,0:09:20.54,Default,,0,0,0,,Сондай-ақ, сабақтан кейін барлық уақытта.
Dialogue: 0,0:09:20.54,0:09:23.54,Default,,0,0,0,,Өзіңізді бақылаңыз.
Dialogue: 0,0:09:26.54,0:09:28.54,Default,,0,0,0,,ONM дегеніміз не?
Dialogue: 0,0:09:29.54,0:09:32.54,Default,,0,0,0,,Қызық, мен енді тырыса алмаймын ба?
Dialogue: 0,0:09:32.54,0:09:34.54,Default,,0,0,0,,Оша манбе үкіметі?
Dialogue: 0,0:09:36.54,0:09:38.54,Default,,0,0,0,,Бұл қоқыс
Dialogue: 0,0:09:39.54,0:09:42.54,Default,,0,0,0,,Кеште болғаным рас.
Dialogue: 0,0:09:42.54,0:09:44.54,Default,,0,0,0,,Бұл өте ауыр болды.
Dialogue: 0,0:09:44.54,0:09:46.54,Default,,0,0,0,,Содан бері Ока-чан ше?
Dialogue: 0,0:09:46.54,0:09:47.54,Default,,0,0,0,,Мен сені кездестірген жоқпын.
Dialogue: 0,0:09:47.54,0:09:50.54,Default,,0,0,0,,Бірақ мен бетпе-бет кездескенде табиғи әрекет етемін.
Dialogue: 0,0:09:50.54,0:09:52.54,Default,,0,0,0,,Баршаңызға қайырлы таң
Dialogue: 0,0:09:52.54,0:09:54.54,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:09:55.22,0:09:57.22,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:10:01.22,0:10:06.22,Default,,0,0,0,,Мен мектептің бүгін бірінші рет жабылғанын айтайын деп едім.
Dialogue: 0,0:10:07.22,0:10:10.22,Default,,0,0,0,,Ештеңеден қашудың қажеті жоқ, солай ма?
Dialogue: 0,0:10:10.22,0:10:12.22,Default,,0,0,0,,Егер біреу өзін осылай ұстаса ше?
Dialogue: 0,0:10:12.22,0:10:14.22,Default,,0,0,0,,Мен не істерімді білмеймін
Dialogue: 0,0:10:14.22,0:10:16.22,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:10:16.22,0:10:18.22,Default,,0,0,0,,Мен, өткен күні сол нәрсе
Dialogue: 0,0:10:18.22,0:10:21.22,Default,,0,0,0,,Ол мойындалған болып есептелмейді.
Dialogue: 0,0:10:21.22,0:10:23.22,Default,,0,0,0,,Бұл партиялық орындар туралы.
Dialogue: 0,0:10:23.90,0:10:26.90,Default,,0,0,0,,Бірақ мен осылай қашып кетсем ғой.
Dialogue: 0,0:10:26.90,0:10:28.90,Default,,0,0,0,,Банди
Dialogue: 0,0:10:30.90,0:10:32.90,Default,,0,0,0,,Банди
Dialogue: 0,0:10:41.90,0:10:43.90,Default,,0,0,0,,Содан бері бірнеше күн өтті.
Dialogue: 0,0:10:43.90,0:10:47.90,Default,,0,0,0,,Кага-сан екеуміз университетке бірге барамыз.
Dialogue: 0,0:10:47.90,0:10:49.90,Default,,0,0,0,,Университетте де солай
Dialogue: 0,0:10:49.90,0:10:52.90,Default,,0,0,0,,Кейде кездесуге шығатынбыз.
Dialogue: 0,0:10:53.58,0:10:57.58,Default,,0,0,0,,Маған күн сайын дерлік Линда-сенпайдан электрондық хаттар келіп тұрды.
Dialogue: 0,0:10:57.58,0:11:01.58,Default,,0,0,0,,Бірақ мен жауап бермедім.
Dialogue: 0,0:11:14.58,0:11:16.58,Default,,0,0,0,,Иә иә иә иә
Dialogue: 0,0:11:16.58,0:11:18.58,Default,,0,0,0,,Сіз тазалауды аяқтадыңыз ба?
Dialogue: 0,0:11:18.58,0:11:20.58,Default,,0,0,0,,Иә, сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:11:20.58,0:11:22.58,Default,,0,0,0,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:11:23.26,0:11:26.26,Default,,0,0,0,,Жай отыр, мен саған кофе дайындаймын.
Dialogue: 0,0:11:27.26,0:11:29.26,Default,,0,0,0,,Олай болса сөзіңізді қабыл алыңыз.
Dialogue: 0,0:11:29.26,0:11:31.26,Default,,0,0,0,,Мен демалуым керек пе?
Dialogue: 0,0:11:31.26,0:11:33.26,Default,,0,0,0,,Жалғастырыңыз.
Dialogue: 0,0:11:34.26,0:11:36.26,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:11:38.26,0:11:40.26,Default,,0,0,0,,Ой, кешіріңіз.
Dialogue: 0,0:11:40.26,0:11:42.26,Default,,0,0,0,,Мәселе жоқ.
Dialogue: 0,0:11:42.26,0:11:44.26,Default,,0,0,0,,Онда не бар?
Dialogue: 0,0:11:44.26,0:11:46.26,Default,,0,0,0,,Әй, ата-анамның үйіндегі көкөністер.
Dialogue: 0,0:11:46.26,0:11:48.26,Default,,0,0,0,,Иә
Dialogue: 0,0:11:48.94,0:11:50.94,Default,,0,0,0,,Онда неге отырмайсың?
Dialogue: 0,0:11:50.94,0:11:52.94,Default,,0,0,0,,This is fine.
Dialogue: 0,0:11:52.94,0:11:54.94,Default,,0,0,0,,(Беатриса) Ол кітап бөлмеге кіріп кеткен жәндіктерден қалай құтылу керектігін айтып бере ме екен?
Dialogue: 0,0:11:54.94,0:11:56.94,Default,,0,0,0,,Мүмкін мен саған тәттілер сатып алуым керек пе еді.
Dialogue: 0,0:11:56.94,0:12:00.94,Default,,0,0,0,,Мен вокзал алдында дәмді көрінетін мейрамхана таптым.
Dialogue: 0,0:12:00.94,0:12:02.94,Default,,0,0,0,,Бамбук сарайы, батыс тәттілер дүкені
Dialogue: 0,0:12:02.94,0:12:04.94,Default,,0,0,0,,Жоқ, бұл таңқаларлық.
Dialogue: 0,0:12:04.94,0:12:07.94,Default,,0,0,0,,Тада-кун болсаң, менің ойымды қайдан білесің?
Dialogue: 0,0:12:07.94,0:12:09.94,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:09.94,0:12:12.94,Default,,0,0,0,,Мен де Тада-кун туралы көбірек түсінуім керек.
Dialogue: 0,0:12:12.94,0:12:14.94,Default,,0,0,0,,Хмм.
Dialogue: 0,0:12:14.94,0:12:16.94,Default,,0,0,0,,Га
Dialogue: 0,0:12:17.62,0:12:19.62,Default,,0,0,0,,Бұл көкөніс картоп болса керек.
Dialogue: 0,0:12:19.62,0:12:21.62,Default,,0,0,0,,Чочочочо
Dialogue: 0,0:12:21.62,0:12:23.62,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:23.62,0:12:25.62,Default,,0,0,0,,Мен сізден тағы бір нәрсе сұрайын деп едім.
Dialogue: 0,0:12:25.62,0:12:27.62,Default,,0,0,0,,Не?
Dialogue: 0,0:12:27.62,0:12:29.62,Default,,0,0,0,,Линда-сенпаймен бірдеңе болды ма?
Dialogue: 0,0:12:29.62,0:12:31.62,Default,,0,0,0,,Әй
Dialogue: 0,0:12:31.62,0:12:33.62,Default,,0,0,0,,Тада-кун, жарайды.
Dialogue: 0,0:12:33.62,0:12:35.62,Default,,0,0,0,,О
Dialogue: 0,0:12:36.62,0:12:38.62,Default,,0,0,0,,Неліктен Линда-сенпай?
Dialogue: 0,0:12:38.62,0:12:40.62,Default,,0,0,0,,Өткенде өзіңіз айттыңыз.
Dialogue: 0,0:12:40.62,0:12:42.62,Default,,0,0,0,,Мен Линда-сенпаймен бірдеңе болды ма деп сұрадым.
Dialogue: 0,0:12:42.62,0:12:44.62,Default,,0,0,0,,Жауабы иә
Dialogue: 0,0:12:44.62,0:12:46.62,Default,,0,0,0,,О
Dialogue: 0,0:12:47.30,0:12:50.30,Default,,0,0,0,,Егер айту қиын болса, мен сұрамаймын деп ойлаймын.
Dialogue: 0,0:12:50.30,0:12:52.30,Default,,0,0,0,,Мен ойладым
Dialogue: 0,0:12:52.30,0:12:54.30,Default,,0,0,0,,Мен әлі де қызықпын
Dialogue: 0,0:12:54.30,0:12:56.30,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:56.30,0:12:59.30,Default,,0,0,0,,Қарашы, бұл күні Кагасан екеуің ыңғайсыз болды.
Dialogue: 0,0:12:59.30,0:13:02.30,Default,,0,0,0,,Сондықтан Линда-сенпай мен үшін алаңдады.
Dialogue: 0,0:13:02.30,0:13:04.30,Default,,0,0,0,,О
Dialogue: 0,0:13:04.30,0:13:07.30,Default,,0,0,0,,Бірақ мен абайсызда соққыға ұқсайтын бірдеңені айттым.
Dialogue: 0,0:13:07.30,0:13:10.30,Default,,0,0,0,,Сондықтан қазір өзімді аздап жайсыз сезінемін.
Dialogue: 0,0:13:10.30,0:13:12.30,Default,,0,0,0,,О
Dialogue: 0,0:13:12.30,0:13:14.30,Default,,0,0,0,,Ақырында дұрыстап бітіреміз.
Dialogue: 0,0:13:14.30,0:13:16.30,Default,,0,0,0,,Рычагпен шешілді
Dialogue: 0,0:13:16.98,0:13:19.02,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:13:19.82,0:13:22.10,Default,,0,0,0,,Ал мынау картоп
Dialogue: 0,0:13:22.10,0:13:24.10,Default,,0,0,0,,О
Dialogue: 0,0:13:24.10,0:13:32.10,Default,,0,0,0,,Увааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:13:36.10,0:13:38.10,Default,,0,0,0,,Бұл түсінбеушілік. Бұл түсінбеушілік.
Dialogue: 0,0:13:38.10,0:13:40.10,Default,,0,0,0,,О
Dialogue: 0,0:13:40.10,0:13:44.10,Default,,0,0,0,,Дұрыс. Әдетте адамдар мұндай нәрселерге қызығушылық танытады.
Dialogue: 0,0:13:45.10,0:13:47.10,Default,,0,0,0,,Мен ер адаммын.
Dialogue: 0,0:13:47.10,0:13:50.10,Default,,0,0,0,,Бірақ біз енді ғана кездесе бастадық.
Dialogue: 0,0:13:50.10,0:13:54.10,Default,,0,0,0,,Менің ойымша, мұндай нәрсе табиғи прогрессия.
Dialogue: 0,0:13:54.10,0:13:55.10,Default,,0,0,0,,Табиғи ағын?
Dialogue: 0,0:13:55.10,0:13:57.10,Default,,0,0,0,,Әрине
Dialogue: 0,0:13:57.10,0:14:00.10,Default,,0,0,0,,Иә, Парижде
Dialogue: 0,0:14:01.10,0:14:02.10,Default,,0,0,0,,Париж?
Dialogue: 0,0:14:02.10,0:14:04.10,Default,,0,0,0,,Париж!
Dialogue: 0,0:14:04.10,0:14:07.10,Default,,0,0,0,,Мен армандаймын
Dialogue: 0,0:14:07.10,0:14:10.10,Default,,0,0,0,,Бұл Тадамен бірінші рет болса ше?
Dialogue: 0,0:14:10.10,0:14:13.10,Default,,0,0,0,,Бұл әрине Париж.
Dialogue: 0,0:14:13.10,0:14:14.10,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:14:14.10,0:14:18.10,Default,,0,0,0,,Ғашықтар қаласы Париждегі тағдырлы түн
Dialogue: 0,0:14:21.10,0:14:23.10,Default,,0,0,0,,Торт сатып алайық
Dialogue: 0,0:14:23.10,0:14:24.10,Default,,0,0,0,,Иә
Dialogue: 0,0:14:27.10,0:14:29.10,Default,,0,0,0,,Парижге қалай жетуге болады?
Dialogue: 0,0:14:29.10,0:14:31.10,Default,,0,0,0,,Ұшақ билетін алсаңыз бара аласыз.
Dialogue: 0,0:14:31.10,0:14:33.10,Default,,0,0,0,,Мен сатып алғым келеді Мен тез сатып алғым келеді
Dialogue: 0,0:14:33.10,0:14:36.10,Default,,0,0,0,,Бізді Эйфель мұнарасы күтіп тұр
Dialogue: 0,0:14:36.10,0:14:39.10,Default,,0,0,0,,Эйфель Менің Эйфелім
Dialogue: 0,0:14:39.10,0:14:42.10,Default,,0,0,0,,Эйфель
Dialogue: 0,0:14:44.10,0:14:45.10,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:14:45.10,0:14:47.10,Default,,0,0,0,,Келесі қосымша жаттығу қашан?
Dialogue: 0,0:14:47.10,0:14:50.10,Default,,0,0,0,,Менің ойымша, бұл келесі жұма болды.
Dialogue: 0,0:14:50.10,0:14:54.10,Default,,0,0,0,,Күт, күт, күт, мін, мін, мін
Dialogue: 0,0:14:57.10,0:14:58.10,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:14:59.10,0:15:02.10,Default,,0,0,0,,Не, сендер кездесіп жатырсыңдар ма?
Dialogue: 0,0:15:04.10,0:15:06.10,Default,,0,0,0,,Мен не істей аламын?
Dialogue: 0,0:15:11.10,0:15:13.10,Default,,0,0,0,,Бұл адамдар қазір кімдер?
Dialogue: 0,0:15:13.10,0:15:16.10,Default,,0,0,0,,Бұл аздап қорқынышты болды, солай емес пе?
Dialogue: 0,0:15:29.10,0:15:33.10,Default,,0,0,0,,Әйтеуір, біз сиқырлы қыз дәуірінде өмір сүріп жатырмыз.
Dialogue: 0,0:15:34.10,0:15:35.10,Default,,0,0,0,,Пошта
Dialogue: 0,0:15:38.10,0:15:39.10,Default,,0,0,0,,Та-да!
Dialogue: 0,0:15:39.10,0:15:42.10,Default,,0,0,0,,А, бұл ештеңе емес.
Dialogue: 0,0:15:45.10,0:15:46.10,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:46.10,0:15:49.10,Default,,0,0,0,,Ах Нана-сенпай
Dialogue: 0,0:15:51.10,0:15:53.10,Default,,0,0,0,,Дада-кун, менде ұялы телефон жоқ.
Dialogue: 0,0:15:53.10,0:15:55.10,Default,,0,0,0,,Иә
Dialogue: 0,0:15:55.10,0:15:57.10,Default,,0,0,0,,Бұл белгісіз сан
Dialogue: 0,0:15:58.10,0:15:59.10,Default,,0,0,0,,Бұл тегін
Dialogue: 0,0:16:01.10,0:16:02.10,Default,,0,0,0,,Жылжымайтын мүлік агенті
Dialogue: 0,0:16:02.10,0:16:05.10,Default,,0,0,0,,Иә, шын мәнінде Тада-саманың бөлмесінің қасында.
Dialogue: 0,0:16:05.10,0:16:07.10,Default,,0,0,0,,Су ағып кету апаты болды.
Dialogue: 0,0:16:07.10,0:16:10.10,Default,,0,0,0,,Бөлмеге су кірмегенін растауыңызды сұраймын.
Dialogue: 0,0:16:10.10,0:16:12.10,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:16:12.10,0:16:14.10,Default,,0,0,0,,Жарайды, мен қайтайын.
Dialogue: 0,0:16:14.10,0:16:17.10,Default,,0,0,0,,Менің бөлмемде су ағып жатыр. Біраз уақытқа үйге баруым керек.
Dialogue: 0,0:16:17.10,0:16:19.10,Default,,0,0,0,,Онда мен де саған қосыламын.
Dialogue: 0,0:16:19.10,0:16:21.10,Default,,0,0,0,,Кага-санның сабақтары бар шығар.
Dialogue: 0,0:16:21.10,0:16:22.10,Default,,0,0,0,,Нана-сан
Dialogue: 0,0:16:22.10,0:16:25.10,Default,,0,0,0,,Сіз өткен күні өте сабырлы болдыңыз.
Dialogue: 0,0:16:25.10,0:16:26.10,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:16:26.10,0:16:29.10,Default,,0,0,0,,Егер бұл лифт болса, мен онымен болған кезде.
Dialogue: 0,0:16:30.10,0:16:31.10,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:16:34.10,0:16:38.10,Default,,0,0,0,,Мүмкін ол менің көрші тұратынымды білмеген де шығар.
Dialogue: 0,0:16:38.10,0:16:39.10,Default,,0,0,0,,Көрші есік
Dialogue: 0,0:16:39.10,0:16:48.10,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:16:49.10,0:16:50.10,Default,,0,0,0,,Самурай
Dialogue: 0,0:16:50.10,0:16:52.10,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:16:52.10,0:16:54.10,Default,,0,0,0,,Мен мұны түсінбедім
Dialogue: 0,0:16:54.10,0:16:55.10,Default,,0,0,0,,Көрші есік
Dialogue: 0,0:16:55.10,0:16:56.10,Default,,0,0,0,,Иә
Dialogue: 0,0:16:56.10,0:17:00.10,Default,,0,0,0,,Мен көшіп келгенде, сәлем беруге бірнеше рет бардым.
Dialogue: 0,0:17:00.10,0:17:02.10,Default,,0,0,0,,Өйткені сіз үнемі шыға бермейсіз
Dialogue: 0,0:17:02.10,0:17:05.10,Default,,0,0,0,,Токиода адамдар осындай ма деп ойлаймын.
Dialogue: 0,0:17:05.10,0:17:07.10,Default,,0,0,0,,Ата-аналар үйі Нишитама
Dialogue: 0,0:17:07.10,0:17:08.10,Default,,0,0,0,,Вараби
Dialogue: 0,0:17:08.10,0:17:09.10,Default,,0,0,0,,да үреді
Dialogue: 0,0:17:09.10,0:17:10.82,Default,,0,0,0,,О, мен қорқамын
Dialogue: 0,0:17:11.10,0:17:13.10,Default,,0,0,0,,Көрші үйден су ағып кетті.
Dialogue: 0,0:17:13.10,0:17:14.10,Default,,0,0,0,,Нананың бөлмесі
Dialogue: 0,0:17:14.10,0:17:15.10,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:17:15.10,0:17:17.10,Default,,0,0,0,,Мен бұрын жасаған телефон қоңырауы
Dialogue: 0,0:17:18.10,0:17:20.54,Default,,0,0,0,,Мен сенің мұнда тұратыныңды білмедім.
Dialogue: 0,0:17:20.60,0:17:21.34,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:17:21.40,0:17:24.18,Default,,0,0,0,,Айтқыңыз келген нәрсені айтқыңыз келсе, оны тез аяқтап, сергек болыңыз!
Dialogue: 0,0:17:24.24,0:17:27.00,Default,,0,0,0,,Мені мазалағаныма шыдай алмайсың!
Dialogue: 0,0:17:27.80,0:17:31.40,Default,,0,0,0,,Сәлем! Менің аяқ киімім ішінде!
Dialogue: 0,0:17:32.40,0:17:34.48,Default,,0,0,0,,Мен бәрібір өз бөлмеме барамын.
Dialogue: 0,0:17:41.20,0:17:43.80,Default,,0,0,0,,Бұл адам бастапқыда қосымша болды, солай ма?
Dialogue: 0,0:17:43.86,0:17:44.70,Default,,0,0,0,,Не?
Dialogue: 0,0:17:44.70,0:17:49.60,Default,,0,0,0,,Қосылғаннан кейін мен топпен және толық емес жұмыс күнімен айналыстым, сондықтан мен кеттім.
Dialogue: 0,0:17:49.60,0:17:51.76,Default,,0,0,0,,Біз қарым-қатынасымызды жалғастырамыз.
Dialogue: 0,0:17:51.76,0:17:54.90,Default,,0,0,0,,Нана бізбен бір университетте оқиды ма?
Dialogue: 0,0:17:54.90,0:17:57.16,Default,,0,0,0,,Иә, 3 жас үлкен.
Dialogue: 0,0:17:57.16,0:18:00.44,Default,,0,0,0,,Сондай-ақ, бұл адамның шын есімі Нана емес.
Dialogue: 0,0:18:00.44,0:18:01.32,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:18:01.32,0:18:05.52,Default,,0,0,0,,Сонымен, мен саған өзімді ыңғайсыз сезінетінімді айттым.
Dialogue: 0,0:18:05.52,0:18:08.84,Default,,0,0,0,,Бірақ маған Бэнли көрші үйде тұратын жігіт екенін айтты.
Dialogue: 0,0:18:10.12,0:18:11.32,Default,,0,0,0,,Сонымен
Dialogue: 0,0:18:15.20,0:18:16.20,Default,,0,0,0,,О
Dialogue: 0,0:18:23.80,0:18:25.80,Default,,0,0,0,,Мен осы бөлмеде тұрамын.
Dialogue: 0,0:18:31.80,0:18:35.08,Default,,0,0,0,,Сен осында тұрасың, Бэнли.
Dialogue: 0,0:18:37.20,0:18:38.84,Default,,0,0,0,,Тек Бэнли
Dialogue: 0,0:18:38.84,0:18:39.84,Default,,0,0,0,,О
Dialogue: 0,0:18:40.76,0:18:43.28,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,0:18:43.28,0:18:43.96,Default,,0,0,0,,О
Dialogue: 0,0:18:43.98,0:18:48.18,Default,,0,0,0,,Мен оғаш нәрсе істеп, одан бетер шатастырып жібердім.
Dialogue: 0,0:18:48.18,0:18:49.18,Default,,0,0,0,,Сіз туралы
Dialogue: 0,0:18:52.02,0:18:53.50,Default,,0,0,0,,Бэнли
Dialogue: 0,0:18:53.50,0:18:56.90,Default,,0,0,0,,Неге жылайсың? Сенімен бәрі жақсы ма?
Dialogue: 0,0:19:02.58,0:19:07.18,Default,,0,0,0,,Бэнли Мен сені қайтадан көргеніме қуаныштымын.
Dialogue: 0,0:19:07.18,0:19:08.86,Default,,0,0,0,,Мен шынымен бақыттымын.
Dialogue: 0,0:19:10.14,0:19:12.94,Default,,0,0,0,,Мен кез келген нәрсені саудалауға дайын болдым.
Dialogue: 0,0:19:12.94,0:19:16.08,Default,,0,0,0,,Сондықтан, Құдайым, Бэнлиге амандық бер.
Dialogue: 0,0:19:17.76,0:19:21.48,Default,,0,0,0,,Енді сіз тірісіз және осындасыз.
Dialogue: 0,0:19:21.48,0:19:23.56,Default,,0,0,0,,Маған керегі осы
Dialogue: 0,0:19:23.56,0:19:26.60,Default,,0,0,0,,Мен артық ештеңе қаламаймын
Dialogue: 0,0:19:27.32,0:19:30.40,Default,,0,0,0,,Линда-сенпай, кешіріңіз.
Dialogue: 0,0:19:31.60,0:19:35.96,Default,,0,0,0,,Линда-сенпайдың не ойлап тұрғанын білмеймін.
Dialogue: 0,0:19:35.96,0:19:39.36,Default,,0,0,0,,Мен қорқып, қашып кеттім
Dialogue: 0,0:19:43.16,0:19:45.84,Default,,0,0,0,,Ал, енді түсіндім.
Dialogue: 0,0:19:48.04,0:19:52.84,Default,,0,0,0,,Линда-сенпай екеуміз қандай қарым-қатынаста болдық?
Dialogue: 0,0:19:54.28,0:19:59.16,Default,,0,0,0,,Біз орта мектепте оқып жүрген кезімізде Ванли екеуміз өте жақын едік.
Dialogue: 0,0:20:00.28,0:20:05.76,Default,,0,0,0,,Бэнли жақсы жігіт, көңілді және мейірімді еді.
Dialogue: 0,0:20:05.76,0:20:08.64,Default,,0,0,0,,Бірақ бұл сенімсіз.
Dialogue: 0,0:20:08.64,0:20:11.56,Default,,0,0,0,,Екеуміз құрдас болсақ та, мен сенің әпкең сияқтысың.
Dialogue: 0,0:20:11.58,0:20:14.46,Default,,0,0,0,,Дәл қазіргідей емес пе?
Dialogue: 0,0:20:14.46,0:20:16.46,Default,,0,0,0,,Менен сұрасаңыз
Dialogue: 0,0:20:19.62,0:20:22.90,Default,,0,0,0,,Линда-сенпай, сен кеше айттың ғой.
Dialogue: 0,0:20:22.90,0:20:25.90,Default,,0,0,0,,Менің кінәм бар ма?
Dialogue: 0,0:20:28.38,0:20:30.90,Default,,0,0,0,,Ванли екеуміз ең жақсы дос болдық.
Dialogue: 0,0:20:31.74,0:20:33.54,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:20:34.10,0:20:38.14,Default,,0,0,0,,Бэнли менімен мәңгі бірге болғысы келетінін айтты.
Dialogue: 0,0:20:38.80,0:20:41.56,Default,,0,0,0,,Мектеп бітіру кешінде мойындаған
Dialogue: 0,0:20:41.56,0:20:46.16,Default,,0,0,0,,Келесі күні сол көпірде мен өз жауабымды айтуым керек еді.
Dialogue: 0,0:20:46.16,0:20:48.70,Default,,0,0,0,,Сонымен мен көпірде қашан болдым?
Dialogue: 0,0:20:48.70,0:20:51.20,Default,,0,0,0,,Сен мені күтіп тұрдың
Dialogue: 0,0:20:51.20,0:20:54.88,Default,,0,0,0,,Бірақ мен кешігіп қалдым
Dialogue: 0,0:20:54.88,0:20:56.98,Default,,0,0,0,,Сондықтан мен үнемі қорқатынмын.
Dialogue: 0,0:20:56.98,0:20:59.28,Default,,0,0,0,,Егер мен уақытында болсам
Dialogue: 0,0:20:59.28,0:21:02.48,Default,,0,0,0,,Бэнли көпірден құлап кетпеген шығар.
Dialogue: 0,0:21:02.90,0:21:04.90,Default,,0,0,0,,Мен саған көп қиындық туғыздым, бірақ
Dialogue: 0,0:21:04.90,0:21:06.90,Default,,0,0,0,,Бұдан былай аға ретінде
Dialogue: 0,0:21:06.90,0:21:09.34,Default,,0,0,0,,Плюсциконы білетін адам ретінде
Dialogue: 0,0:21:09.34,0:21:12.34,Default,,0,0,0,,Мен Бэнлиді қолдағым келеді.
Dialogue: 0,0:21:13.34,0:21:15.34,Default,,0,0,0,,Мазасыздық туғызбаса
Dialogue: 0,0:21:15.34,0:21:18.34,Default,,0,0,0,,Неліктен мен сияқты адамға бұлай істедің?
Dialogue: 0,0:21:19.34,0:21:22.34,Default,,0,0,0,,Өйткені сен жай ғана Бэнлисің.
Dialogue: 0,0:21:22.34,0:21:24.34,Default,,0,0,0,,Есіңізде болмаса да
Dialogue: 0,0:21:24.34,0:21:27.34,Default,,0,0,0,,Сіз мен үшін маңыздысыз
Dialogue: 0,0:21:27.34,0:21:30.34,Default,,0,0,0,,Ол қазір Бэнли туралы біледі.
Dialogue: 0,0:21:31.20,0:21:32.20,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:21:32.20,0:21:34.20,Default,,0,0,0,,Тада-кун, су ағып жатыр ма?
Dialogue: 0,0:21:34.20,0:21:36.20,Default,,0,0,0,,О, жарайды.
Dialogue: 0,0:21:36.20,0:21:39.20,Default,,0,0,0,,Негізі бұл жерде де мәселе бар.
Dialogue: 0,0:21:39.20,0:21:40.20,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:21:40.20,0:21:43.20,Default,,0,0,0,,Мицуо қысылып қалуы мүмкін.
Dialogue: 0,0:22:31.20,0:22:57.20,Default,,0,0,0,,Бэнли - Бэнли.
Dialogue: 0,0:22:58.06,0:23:12.06,Default,,0,0,0,,Бэнли - Бэнли.
Dialogue: 0,0:23:12.32,0:23:17.22,Default,,0,0,0,,жақын
Dialogue: 0,0:23:18.72,0:23:21.16,Default,,0,0,0,,қалыңдық
Dialogue: 0,0:23:26.70,0:23:29.32,Default,,0,0,0,,Онда мен Исао 2Dмін, ол Такая Сато ретінде де белгілі.
Dialogue: 0,0:23:29.32,0:23:31.32,Default,,0,0,0,,3D бас тартылды
Dialogue: 0,0:23:31.32,0:23:34.36,Default,,0,0,0,,сыртқы түрі
Dialogue: 0,0:23:34.74,0:23:37.78,Default,,0,0,0,,Суық
Dialogue: 0,0:23:37.92,0:23:40.24,Default,,0,0,0,,Рухани бамбук
Dialogue: 0,0:23:40.24,0:23:40.74,Default,,0,0,0,,Ааааааааа!
Dialogue: 0,0:23:42.24,0:23:47.24,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
