Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Джом Беорас
Dialogue: 0,0:00:21.76,0:00:23.14,Default,,0,0,0,,Мен оның осында екеніне сенімдімін.
Dialogue: 0,0:00:23.56,0:00:27.92,Default,,0,0,0,,Увааааааааааааааааааааааааааа
Dialogue: 0,0:00:27.92,0:00:28.66,Default,,0,0,0,,Вахаха
Dialogue: 0,0:00:29.30,0:00:31.22,Default,,0,0,0,,Мен... цу... аа...
Dialogue: 0,0:00:35.90,0:00:37.58,Default,,0,0,0,,Мен Кага Коукомын
Dialogue: 0,0:00:38.58,0:00:39.58,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:00:40.46,0:00:41.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:45.38,0:00:46.18,Default,,0,0,0,,Қаға…
Dialogue: 0,0:00:47.06,0:00:47.78,Default,,0,0,0,,мырза.
Dialogue: 0,0:00:59.18,0:01:02.18,Default,,0,0,0,,Мен ешқашан ұмытпаймын
Dialogue: 0,0:01:02.18,0:01:04.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:08.54,0:01:12.34,Default,,0,0,0,,Нағыз мен қайда?
Dialogue: 0,0:01:13.02,0:01:15.62,Default,,0,0,0,,Ересек болу қиын.
Dialogue: 0,0:01:16.22,0:01:19.14,Default,,0,0,0,,Мен оны әзірше ұмыта аламын ба?
Dialogue: 0,0:01:19.14,0:01:22.14,Default,,0,0,0,,Өйткені түн күтіп тұр
Dialogue: 0,0:01:22.14,0:01:24.74,Default,,0,0,0,,Жүрегіңді соғу
Dialogue: 0,0:01:24.74,0:01:29.38,Default,,0,0,0,,Кездесетін кезде көңілді болсак
Dialogue: 0,0:01:29.38,0:01:33.26,Default,,0,0,0,,Мен қазір жеткізгім келетін сезімдер
Dialogue: 0,0:01:33.26,0:01:36.66,Default,,0,0,0,,Байқаймын ба деп қорқамын
Dialogue: 0,0:01:36.66,0:01:40.06,Default,,0,0,0,,Өткен және болашақ Қорықсаң да
Dialogue: 0,0:01:40.06,0:01:43.90,Default,,0,0,0,,Бос болса қозғала алмайды
Dialogue: 0,0:01:43.90,0:01:48.98,Default,,0,0,0,,Ләззат алсаң, бәрі жақсы
Dialogue: 0,0:01:48.98,0:01:50.66,Default,,0,0,0,,Бастайық
Dialogue: 0,0:01:50.66,0:01:53.90,Default,,0,0,0,,Барлық жаман нәрселерді ұмытыңыз
Dialogue: 0,0:01:53.90,0:01:57.06,Default,,0,0,0,,Мен сенімен түнде билесем
Dialogue: 0,0:01:57.06,0:02:00.38,Default,,0,0,0,,Өзіңіздің жақсырақ нұсқасы болыңыз
Dialogue: 0,0:02:00.38,0:02:04.30,Default,,0,0,0,,Мен солай сезінемін.
Dialogue: 0,0:02:04.30,0:02:07.50,Default,,0,0,0,,Ешқашан бітпейтін мазмұн уақыты
Dialogue: 0,0:02:07.50,0:02:10.66,Default,,0,0,0,,Сен екеуміздің арамыз жақындап барады
Dialogue: 0,0:02:10.66,0:02:14.10,Default,,0,0,0,,Айналма жол болса да, итерме, кетпе
Dialogue: 0,0:02:14.10,0:02:17.90,Default,,0,0,0,,Мен оны бағалағым келеді
Dialogue: 0,0:02:20.22,0:02:22.94,Default,,0,0,0,,Токиодағы университеттік өмірді бастағаннан кейін
Dialogue: 0,0:02:22.94,0:02:24.42,Default,,0,0,0,,Бір апта өтті
Dialogue: 0,0:02:28.06,0:02:30.26,Default,,0,0,0,,Коко Кагава
Dialogue: 0,0:02:31.50,0:02:33.30,Default,,0,0,0,,Әй, бұл сұлу кім?
Dialogue: 0,0:02:33.30,0:02:35.38,Default,,0,0,0,,Кагава бірінші курс студенті.
Dialogue: 0,0:02:35.38,0:02:37.38,Default,,0,0,0,,Менің ата-анам өте бай.
Dialogue: 0,0:02:38.86,0:02:40.50,Default,,0,0,0,,О.
Dialogue: 0,0:02:40.50,0:02:42.50,Default,,0,0,0,,Қайырлы таң Кагава-сан
Dialogue: 0,0:02:42.50,0:02:44.02,Default,,0,0,0,,Телефоныңызда не қарап тұрдыңыз?
Dialogue: 0,0:02:46.58,0:02:48.78,Default,,0,0,0,,Үш патшаның суреті
Dialogue: 0,0:02:48.78,0:02:51.86,Default,,0,0,0,,Мұның бәрі Янаги мырза ма?
Dialogue: 0,0:02:51.86,0:02:53.22,Default,,0,0,0,,Иә
Dialogue: 0,0:02:53.22,0:02:54.58,Default,,0,0,0,,Мен және үш патша
Dialogue: 0,0:02:54.58,0:02:58.14,Default,,0,0,0,,Біз кішкентай кезімізден біргеміз.
Dialogue: 0,0:02:58.14,0:03:01.94,Default,,0,0,0,,Балабақша, бастауыш мектеп, орта мектеп және орта мектеп
Dialogue: 0,0:03:01.94,0:03:03.86,Default,,0,0,0,,Мектеп те, бастауыш сынып та
Dialogue: 0,0:03:03.86,0:03:05.62,Default,,0,0,0,,Бәрі бірдей
Dialogue: 0,0:03:08.54,0:03:11.14,Default,,0,0,0,,Үш патша екеуміз әрқашан бірге болдық.
Dialogue: 0,0:03:11.14,0:03:12.70,Default,,0,0,0,,Біз бірге боламыз
Dialogue: 0,0:03:12.70,0:03:14.14,Default,,0,0,0,,Бұл дұрыс па?
Dialogue: 0,0:03:14.14,0:03:15.86,Default,,0,0,0,,Такада-кун да солай ойлайды, солай ма?
Dialogue: 0,0:03:15.86,0:03:18.26,Default,,0,0,0,,Тадане Тадабанри
Dialogue: 0,0:03:18.26,0:03:19.98,Default,,0,0,0,,Эй
Dialogue: 0,0:03:20.02,0:03:22.98,Default,,0,0,0,,Үш патшаға хабарласа аламын ба?
Dialogue: 0,0:03:22.98,0:03:25.90,Default,,0,0,0,,Жүзімді көрсең қашасың
Dialogue: 0,0:03:27.26,0:03:30.14,Default,,0,0,0,,Бүгін де сені 30 минут күттім.
Dialogue: 0,0:03:30.86,0:03:32.54,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:03:32.54,0:03:35.74,Default,,0,0,0,,Бір университетке түскенімізді білмеймін.
Dialogue: 0,0:03:35.74,0:03:37.98,Default,,0,0,0,,Бар болғаны, Кагава-сан.
Dialogue: 0,0:03:37.98,0:03:39.94,Default,,0,0,0,,Мен кестені шешіп қойдым, т.б.
Dialogue: 0,0:03:39.94,0:03:41.94,Default,,0,0,0,,Сіз қай сыныпқа барасыз?
Dialogue: 0,0:03:41.94,0:03:43.38,Default,,0,0,0,,Спорт туралы ғылым
Dialogue: 0,0:03:43.38,0:03:46.10,Default,,0,0,0,,Аа, түсіндім, сен де мен сияқтысың.
Dialogue: 0,0:03:46.10,0:03:49.82,Default,,0,0,0,,Негізі, мен оның Үш Патша сияқты болғанын қалаймын.
Dialogue: 0,0:03:49.82,0:03:51.90,Default,,0,0,0,,Өйткені сен маған ештеңе айтпайсың
Dialogue: 0,0:03:52.50,0:03:55.58,Default,,0,0,0,,Телефоныңызда тағы да
Dialogue: 0,0:03:55.58,0:03:56.62,Default,,0,0,0,,Үш патша
Dialogue: 0,0:03:56.62,0:03:58.70,Default,,0,0,0,,Күте тұрыңыз, Үш патша
Dialogue: 0,0:03:58.70,0:04:00.50,Default,,0,0,0,,Сәлем Кагава-сан
Dialogue: 0,0:04:04.54,0:04:06.70,Default,,0,0,0,,Мен тағы да қашып үлгердім.
Dialogue: 0,0:04:06.70,0:04:09.14,Default,,0,0,0,,О, Кагава мырза
Dialogue: 0,0:04:09.14,0:04:12.58,Default,,0,0,0,,Толық жылдамдықпен ештеңені қуудың қажеті жоқ
Dialogue: 0,0:04:12.58,0:04:14.02,Default,,0,0,0,,Дұрыс, Такада-кун.
Dialogue: 0,0:04:14.02,0:04:15.74,Default,,0,0,0,,Жоқ, бұл Такада емес.
Dialogue: 0,0:04:15.74,0:04:17.54,Default,,0,0,0,,Ой, кешіріңіз.
Dialogue: 0,0:04:18.42,0:04:19.70,Default,,0,0,0,,Танака мырза
Dialogue: 0,0:04:19.70,0:04:20.70,Default,,0,0,0,,Күтуім керек екен ғой?
Dialogue: 0,0:04:21.70,0:04:23.62,Default,,0,0,0,,Кеңес екі әріптен тұрады
Dialogue: 0,0:04:23.62,0:04:25.82,Default,,0,0,0,,Екі әріп
Dialogue: 0,0:04:25.82,0:04:26.86,Default,,0,0,0,,Кагава-кун
Dialogue: 0,0:04:26.86,0:04:28.86,Default,,0,0,0,,Бұл сіздің фамилияңыз, солай ма?
Dialogue: 0,0:04:28.86,0:04:30.06,Default,,0,0,0,,Өтінемін, оған жұмыстың барлық қырларын және басқа да барлық нәрсені үйретіңіз.
Dialogue: 0,0:04:30.06,0:04:31.90,Default,,0,0,0,,Үш патша қандай кесте жасайды?
Dialogue: 0,0:04:31.90,0:04:33.46,Default,,0,0,0,,Білсең, айтпа.
Dialogue: 0,0:04:33.46,0:04:36.42,Default,,0,0,0,,Шеңберден кейін
Dialogue: 0,0:04:36.42,0:04:39.58,Default,,0,0,0,,Бұл туралы тікелей адамнан сұрау керек.
Dialogue: 0,0:04:39.58,0:04:42.42,Default,,0,0,0,,Сұрасаң да айтпайтын шығар.
Dialogue: 0,0:04:42.42,0:04:45.82,Default,,0,0,0,,Мен Үш патша туралы бәрін білгім келеді.
Dialogue: 0,0:04:45.82,0:04:47.98,Default,,0,0,0,,Сіз жалғыз қалай өмір сүресіз?
Dialogue: 0,0:04:48.02,0:04:49.98,Default,,0,0,0,,Және мұндай қатынас түрі
Dialogue: 0,0:04:49.98,0:04:51.58,Default,,0,0,0,,Жоқ, бірақ
Dialogue: 0,0:04:51.58,0:04:53.34,Default,,0,0,0,,Мен оны тегін деп айтпаймын.
Dialogue: 0,0:04:53.34,0:04:55.58,Default,,0,0,0,,Мен сізге лайықты түрде алғыс айтамын.
Dialogue: 0,0:04:55.58,0:04:56.74,Default,,0,0,0,,Қолма-қол ақшамен
Dialogue: 0,0:04:56.74,0:04:57.98,Default,,0,0,0,,Иә
Dialogue: 0,0:04:57.98,0:05:01.38,Default,,0,0,0,,Ой, бұл жай әзіл ғой.
Dialogue: 0,0:05:01.38,0:05:02.78,Default,,0,0,0,,А, ұмыт.
Dialogue: 0,0:05:10.78,0:05:11.78,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:12.58,0:05:13.78,Default,,0,0,0,,Бұл адам әрқашан
Dialogue: 0,0:05:13.78,0:05:16.58,Default,,0,0,0,,Ол шынымен жетілдірілген брендпен бекітілді.
Dialogue: 0,0:05:16.58,0:05:18.58,Default,,0,0,0,,Менің ата-анам бәрібір бай.
Dialogue: 0,0:05:27.38,0:05:30.18,Default,,0,0,0,,Иә, спорт ғылымы десе де.
Dialogue: 0,0:05:30.18,0:05:33.18,Default,,0,0,0,,Кейбір адамдар бұл туралы білмеуі мүмкін
Dialogue: 0,0:05:33.18,0:05:35.18,Default,,0,0,0,,Спорт ғылымы
Dialogue: 0,0:05:38.18,0:05:40.18,Default,,0,0,0,,Біз тез әрекет етуіміз керек
Dialogue: 0,0:05:40.58,0:05:42.38,Default,,0,0,0,,Біз тез әрекет етуіміз керек
Dialogue: 0,0:05:42.38,0:05:44.58,Default,,0,0,0,,Сенің анаңның таңдауы
Dialogue: 0,0:05:44.58,0:05:46.58,Default,,0,0,0,,Мына раменге қараңыз
Dialogue: 0,0:05:46.58,0:05:47.98,Default,,0,0,0,,Якисоба кубогы
Dialogue: 0,0:05:47.98,0:05:49.98,Default,,0,0,0,,Мұны шынымен алғыңыз келе ме?
Dialogue: 0,0:05:49.98,0:05:52.38,Default,,0,0,0,,О, достарыңызбен бөлісіңіз.
Dialogue: 0,0:05:52.38,0:05:53.58,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:05:53.58,0:05:54.98,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:05:54.98,0:05:56.18,Default,,0,0,0,,Менің әңгімем
Dialogue: 0,0:05:57.78,0:05:59.18,Default,,0,0,0,,Алғашқыда-ақ дұрыс жауап бергенім үшін ашуланып тұрсың ба?
Dialogue: 0,0:06:00.18,0:06:03.38,Default,,0,0,0,,Менің ойымша, Коуко менің кестем туралы сұрады.
Dialogue: 0,0:06:04.18,0:06:04.78,Default,,0,0,0,,Жоқ, сен
Dialogue: 0,0:06:04.78,0:06:07.38,Default,,0,0,0,,Жоқ, жоқ, мен сізге айта алмаймын.
Dialogue: 0,0:06:07.98,0:06:11.18,Default,,0,0,0,,Жанас мырзаның Кага мырзадан қашып жүргенін білесіз бе?
Dialogue: 0,0:06:12.58,0:06:14.78,Default,,0,0,0,,Бірақ осы өткен аптада
Dialogue: 0,0:06:14.78,0:06:17.18,Default,,0,0,0,,Мен Кага-санды кейде көрдім.
Dialogue: 0,0:06:17.18,0:06:19.58,Default,,0,0,0,,Менің әлі достарым жоқ сияқты.
Dialogue: 0,0:06:20.58,0:06:22.58,Default,,0,0,0,,Мен сыныпта жалғызбын
Dialogue: 0,0:06:22.58,0:06:24.58,Default,,0,0,0,,Мен Жанас мырзамен де кездесе алмадым.
Dialogue: 0,0:06:24.58,0:06:26.98,Default,,0,0,0,,Мен оны аздап аяймын.
Dialogue: 0,0:06:26.98,0:06:28.38,Default,,0,0,0,,Біз Әйел Титан сияқты көрінетін біреуді байқадық.
Dialogue: 0,0:06:28.38,0:06:30.78,Default,,0,0,0,,Мүмкін сіз Коуконы аяйтын шығарсыз?
Dialogue: 0,0:06:30.78,0:06:32.38,Default,,0,0,0,,Аз ғана.
Dialogue: 0,0:06:32.38,0:06:33.78,Default,,0,0,0,,Кішкене ғана
Dialogue: 0,0:06:34.78,0:06:35.98,Default,,0,0,0,,Шынымен
Dialogue: 0,0:06:35.98,0:06:38.38,Default,,0,0,0,,Сұлу әйелдерге өмір оңай.
Dialogue: 0,0:06:38.38,0:06:39.78,Default,,0,0,0,,Не істесеңіз де
Dialogue: 0,0:06:39.78,0:06:41.78,Default,,0,0,0,,Соған ұқсаңыз.
Dialogue: 0,0:06:41.78,0:06:44.98,Default,,0,0,0,,Сіз мені бірден аяуыңыз керек.
Dialogue: 0,0:06:44.98,0:06:45.98,Default,,0,0,0,,Кукон Токимо
Dialogue: 0,0:06:45.98,0:06:47.98,Default,,0,0,0,,Барлығы бір сөзден тұрады.
Dialogue: 0,0:06:47.98,0:06:49.58,Default,,0,0,0,,Дәл осыны айту керек
Dialogue: 0,0:06:49.58,0:06:51.18,Default,,0,0,0,,Жақсы, өйткені ол әдемі.
Dialogue: 0,0:06:51.18,0:06:53.18,Default,,0,0,0,,Мен қызғанамын Өзгергім келеді
Dialogue: 0,0:06:53.78,0:06:56.18,Default,,0,0,0,,Шынымды айтсам, өзіңізді менің орныма қойыңыз.
Dialogue: 0,0:06:56.18,0:06:57.58,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:57.58,0:06:59.58,Default,,0,0,0,,Мен олай айтқан жоқпын.
Dialogue: 0,0:07:00.18,0:07:01.58,Default,,0,0,0,,Мен Янус мырзамын
Dialogue: 0,0:07:01.58,0:07:03.98,Default,,0,0,0,,Қага-санды елеусіз қалдырма деп айтпа.
Dialogue: 0,0:07:03.98,0:07:06.98,Default,,0,0,0,,Өйткені бұл Янас мырзаның еркіндігі.
Dialogue: 0,0:07:06.98,0:07:09.98,Default,,0,0,0,,Бірақ мен де Кага-санға жанашырмын.
Dialogue: 0,0:07:09.98,0:07:11.98,Default,,0,0,0,,Бұл менің еркіндігім.
Dialogue: 0,0:07:16.98,0:07:18.98,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:07:19.98,0:07:22.98,Default,,0,0,0,,Өйткені мен Коукодан аулақпын
Dialogue: 0,0:07:22.98,0:07:24.98,Default,,0,0,0,,Мұның Бандиге еш қатысы жоқ.
Dialogue: 0,0:07:25.98,0:07:27.98,Default,,0,0,0,,Оны тоқтатайық
Dialogue: 0,0:07:27.98,0:07:30.98,Default,,0,0,0,,Коуко туралы қиындыққа тап болудың қажеті жоқ.
Dialogue: 0,0:07:31.38,0:07:34.38,Default,,0,0,0,,Ой, уақыт таяп қалды.
Dialogue: 0,0:07:34.38,0:07:36.38,Default,,0,0,0,,О, бірдеңе бар ма?
Dialogue: 0,0:07:36.38,0:07:39.38,Default,,0,0,0,,Кинозерттеу тобының жаңа кітап жинағы
Dialogue: 0,0:07:39.38,0:07:41.38,Default,,0,0,0,,Менімен бірге келгің келе ме?
Dialogue: 0,0:07:41.38,0:07:42.38,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:07:45.38,0:07:48.38,Default,,0,0,0,,Түсіндім, мен орта мектепте де Эйкен сынағын тапсырдым.
Dialogue: 0,0:07:48.38,0:07:49.38,Default,,0,0,0,,Иә
Dialogue: 0,0:07:49.38,0:07:51.38,Default,,0,0,0,,Жарайды, әрекетке дайын.
Dialogue: 0,0:07:51.38,0:07:53.38,Default,,0,0,0,,Фотограф болғыңыз келе ме?
Dialogue: 0,0:07:53.38,0:07:55.38,Default,,0,0,0,,Сіз жабдықты қолданып көрдіңіз бе?
Dialogue: 0,0:07:55.38,0:07:57.38,Default,,0,0,0,,Мен өзімді орынсыз сезінбеймін бе?
Dialogue: 0,0:07:57.38,0:08:00.38,Default,,0,0,0,,Турда проблема жоқ.
Dialogue: 0,0:08:00.78,0:08:02.78,Default,,0,0,0,,Янар
Dialogue: 0,0:08:02.78,0:08:04.78,Default,,0,0,0,,Тада-кун да келді.
Dialogue: 0,0:08:04.78,0:08:06.78,Default,,0,0,0,,Иә? Ока-сан да Эйкенді алды ма?
Dialogue: 0,0:08:06.78,0:08:08.78,Default,,0,0,0,,Осучинами
Dialogue: 0,0:08:08.78,0:08:09.78,Default,,0,0,0,,Не?
Dialogue: 0,0:08:09.78,0:08:11.78,Default,,0,0,0,,Янус-сан мен Ока-сан бір-бірін тани ма?
Dialogue: 0,0:08:11.78,0:08:13.78,Default,,0,0,0,,Қашан?
Dialogue: 0,0:08:13.78,0:08:15.78,Default,,0,0,0,,Ағылшын тілінің бір туры бірдей
Dialogue: 0,0:08:15.78,0:08:17.78,Default,,0,0,0,,О, мені Ока-сан деудің қажеті жоқ.
Dialogue: 0,0:08:17.78,0:08:19.78,Default,,0,0,0,,Өйткені сіз кемпірге ұқсайсыз
Dialogue: 0,0:08:19.78,0:08:20.78,Default,,0,0,0,,Бұл — сүт, жұмыртқа сарысы, банан және нан —
Dialogue: 0,0:08:20.78,0:08:22.78,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:08:22.78,0:08:24.78,Default,,0,0,0,,Чан?
Dialogue: 0,0:08:24.78,0:08:26.78,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:08:26.78,0:08:28.78,Default,,0,0,0,,ше?
Dialogue: 0,0:08:28.78,0:08:31.38,Default,,0,0,0,,Яна мен Тада да үйге қайтуға мүдделі ме?
Dialogue: 0,0:08:31.38,0:08:32.78,Default,,0,0,0,,Ағылшын тілінен тест
Dialogue: 0,0:08:32.78,0:08:35.78,Default,,0,0,0,,Иә, менің үлкендерім де жақсы адамдар сияқты.
Dialogue: 0,0:08:35.78,0:08:37.38,Default,,0,0,0,,Менің келуім керек.
Dialogue: 0,0:08:37.38,0:08:38.38,Default,,0,0,0,,Тада-кун ше?
Dialogue: 0,0:08:38.38,0:08:39.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:39.58,0:08:41.18,Default,,0,0,0,,Ах, мен
Dialogue: 0,0:08:41.18,0:08:44.18,Default,,0,0,0,,Шешім қабылдамас бұрын тағы бірнеше шеңберді қарастырамын деп ойлаймын.
Dialogue: 0,0:08:44.18,0:08:46.98,Default,,0,0,0,,Түсіндім, жарайды, жарайды.
Dialogue: 0,0:08:46.98,0:08:48.18,Default,,0,0,0,,Сенпай!
Dialogue: 0,0:08:48.18,0:08:51.18,Default,,0,0,0,,Мұнда Янагисава мырза қосылуды шешкен сияқты.
Dialogue: 0,0:08:51.18,0:08:53.18,Default,,0,0,0,,О!
Dialogue: 0,0:08:53.78,0:08:55.78,Default,,0,0,0,,Бірінші курс студенттерін шақырамыз!
Dialogue: 0,0:08:55.78,0:08:57.78,Default,,0,0,0,,Сіз әдемі көрінесіз.
Dialogue: 0,0:08:57.78,0:08:59.78,Default,,0,0,0,,Сіз актер, актер бола аласыз!
Dialogue: 0,0:08:59.78,0:09:01.78,Default,,0,0,0,,Иә, рахмет.
Dialogue: 0,0:09:01.78,0:09:03.78,Default,,0,0,0,,Ока-чан Эйкен сынағынан өтті.
Dialogue: 0,0:09:03.78,0:09:07.78,Default,,0,0,0,,Иә, мен кешегі Янамен бірге болған сұлуды айтып отырмын.
Dialogue: 0,0:09:07.78,0:09:09.78,Default,,0,0,0,,А, Кога мырза?
Dialogue: 0,0:09:09.78,0:09:11.78,Default,,0,0,0,,Дұрыс айтасың, Кага-сан.
Dialogue: 0,0:09:11.78,0:09:13.78,Default,,0,0,0,,Сіз әлі шеңбер туралы шешім қабылдадыңыз ба?
Dialogue: 0,0:09:13.78,0:09:15.78,Default,,0,0,0,,Менің ойымша, бұл әлі жоқ.
Dialogue: 0,0:09:15.78,0:09:17.78,Default,,0,0,0,,Мен оны ағамнан естідім.
Dialogue: 0,0:09:17.78,0:09:22.78,Default,,0,0,0,,Мен Канба шеңберіндегі барлық адамдар олармен сөйлесу қиын дейді деп естідім.
Dialogue: 0,0:09:22.78,0:09:24.78,Default,,0,0,0,,Осыған ұқсас нәрсе
Dialogue: 0,0:09:24.78,0:09:26.78,Default,,0,0,0,,Сонымен қатар, қазына гүлі!
Dialogue: 0,0:09:26.78,0:09:28.78,Default,,0,0,0,,Аура сияқты
Dialogue: 0,0:09:30.78,0:09:35.78,Default,,0,0,0,,Мен Тада-кун мен Кага-сан басқа балалармен бірге Эйкен сынағын тапсырса екен.
Dialogue: 0,0:09:35.78,0:09:39.78,Default,,0,0,0,,Хмм, бірақ Яна-сан Кога-саннан қашып жүр.
Dialogue: 0,0:09:39.78,0:09:43.78,Default,,0,0,0,,Кага-сан Яна-санды қатты ұнататын сияқты.
Dialogue: 0,0:09:43.78,0:09:47.78,Default,,0,0,0,,Түсінемін, түсінбеймін, бірақ бұл жастық.
Dialogue: 0,0:09:49.78,0:09:53.78,Default,,0,0,0,,Уау, ол жақта да қызықты.
Dialogue: 0,0:09:53.78,0:09:55.78,Default,,0,0,0,,Олар да сол жақта той жасап жатыр ма деп ойлаймын.
Dialogue: 0,0:09:56.78,0:09:57.78,Default,,0,0,0,,Күте тұрыңыз, мен оны аша алмаймын.
Dialogue: 0,0:09:57.78,0:09:58.78,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:09:58.78,0:10:00.78,Default,,0,0,0,,Оның арғы жағында жындар әлемі жатыр.
Dialogue: 0,0:10:00.78,0:10:01.78,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:10:03.78,0:10:05.78,Default,,0,0,0,,Джажан!
Dialogue: 0,0:10:05.78,0:10:07.78,Default,,0,0,0,,Бұл Занобудан келген Нао-чан!
Dialogue: 0,0:10:07.78,0:10:09.78,Default,,0,0,0,,Бұл Ше Чан!
Dialogue: 0,0:10:11.78,0:10:13.78,Default,,0,0,0,,О, бұл Эйкен сынағы емес!
Dialogue: 0,0:10:13.78,0:10:16.78,Default,,0,0,0,,Балалар, сендер де той жасадыңдар ма?
Dialogue: 0,0:10:16.78,0:10:21.78,Default,,0,0,0,,Әйтеуір, Чими біздің сакадзукиді қабылдау рәсімі күні алған жаңа оқушы.
Dialogue: 0,0:10:21.78,0:10:23.78,Default,,0,0,0,,Бұл жерде 100 жыл болды!
Dialogue: 0,0:10:23.78,0:10:25.78,Default,,0,0,0,,Мұнда бірге көңіл көтерейік!
Dialogue: 0,0:10:25.78,0:10:28.78,Default,,0,0,0,,Жоқ, күте тұрыңыз, мен Садобқа жатпаймын.
Dialogue: 0,0:10:28.78,0:10:29.78,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:29.78,0:10:31.78,Default,,0,0,0,,Эй, көмектесші, Яна-сан!
Dialogue: 0,0:10:31.78,0:10:32.78,Default,,0,0,0,,Ока-чан!
Dialogue: 0,0:10:33.78,0:10:34.78,Default,,0,0,0,,Мэнни!
Dialogue: 0,0:10:34.78,0:10:35.78,Default,,0,0,0,,Тада-кун!
Dialogue: 0,0:10:35.78,0:10:36.78,Default,,0,0,0,,Барма!
Dialogue: 0,0:10:36.78,0:10:38.78,Default,,0,0,0,,Тіпті сізді қызықтырады!
Dialogue: 0,0:10:42.78,0:10:43.78,Default,,0,0,0,,Мэнни!
Dialogue: 0,0:10:43.78,0:10:45.78,Default,,0,0,0,,Тада-кун!
Dialogue: 0,0:10:51.78,0:10:53.78,Default,,0,0,0,,Суретті қалай алдың?
Dialogue: 0,0:10:53.78,0:10:54.78,Default,,0,0,0,,Хо!
Dialogue: 0,0:10:54.78,0:10:55.78,Default,,0,0,0,,Сәлем, Цугеё!
Dialogue: 0,0:10:55.78,0:10:56.78,Default,,0,0,0,,Иә
Dialogue: 0,0:10:56.78,0:10:58.78,Default,,0,0,0,,Жүр, хоккей ойнайық!
Dialogue: 0,0:10:58.78,0:10:59.78,Default,,0,0,0,,T-кейде!
Dialogue: 0,0:10:59.78,0:11:01.78,Default,,0,0,0,,Әй, қысқасын таңда!
Dialogue: 0,0:11:01.78,0:11:03.78,Default,,0,0,0,,Ол мәңгі болды!
Dialogue: 0,0:11:03.78,0:11:04.78,Default,,0,0,0,,Артқа қайт, қайт!
Dialogue: 0,0:11:04.78,0:11:05.78,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:05.78,0:11:08.78,Default,,0,0,0,,Занобу Бонинг!
Dialogue: 0,0:11:11.78,0:11:15.78,Default,,0,0,0,,Эй, жақсы иіс!
Dialogue: 0,0:11:15.78,0:11:17.78,Default,,0,0,0,,Жақсы иіс шығады!
Dialogue: 0,0:11:17.78,0:11:21.78,Default,,0,0,0,,Эй, жақсы иіс!
Dialogue: 0,0:11:22.78,0:11:23.78,Default,,0,0,0,,Ура!
Dialogue: 0,0:11:23.78,0:11:26.78,Default,,0,0,0,,Ішіңдер, ішіңдер, ішіңдер, балалар!
Dialogue: 0,0:11:27.78,0:11:29.78,Default,,0,0,0,,Жоқ, мен жай ғана...
Dialogue: 0,0:11:29.78,0:11:31.78,Default,,0,0,0,,Олай болса, онымен жұмыс істеу уақыты келді!
Dialogue: 0,0:11:31.78,0:11:32.78,Default,,0,0,0,,Сачинакаро!
Dialogue: 0,0:11:32.78,0:11:34.78,Default,,0,0,0,,Соққы!
Dialogue: 0,0:11:34.78,0:11:35.78,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:11:35.78,0:11:36.78,Default,,0,0,0,,Ура!
Dialogue: 0,0:11:36.78,0:11:37.78,Default,,0,0,0,,Тігу, тігу, тігу!
Dialogue: 0,0:11:37.78,0:11:40.78,Default,,0,0,0,,Тартыңыз, қатайтыңыз!
Dialogue: 0,0:11:40.78,0:11:41.78,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:11:41.78,0:11:43.78,Default,,0,0,0,,Қазір!
Dialogue: 0,0:11:43.78,0:11:45.78,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:11:45.78,0:11:47.78,Default,,0,0,0,,Тіпті мен білмеймін!
Dialogue: 0,0:11:47.78,0:12:00.78,Default,,0,0,0,,Толығырақ!
Dialogue: 0,0:12:02.78,0:12:04.78,Default,,0,0,0,,Екі тарап үшін!
Dialogue: 0,0:12:04.78,0:12:07.78,Default,,0,0,0,,Неліктен бұл болып жатыр!
Dialogue: 0,0:12:07.78,0:12:09.78,Default,,0,0,0,,Тіпті мен білмеймін!
Dialogue: 0,0:12:09.78,0:12:12.78,Default,,0,0,0,,Сондықтан мен 3D-ді жек көремін!
Dialogue: 0,0:12:12.78,0:12:15.74,Default,,0,0,0,,Бәрің біртүрлі екенсіңдер! Ақымақтар!
Dialogue: 0,0:12:15.74,0:12:18.74,Default,,0,0,0,,From today onwards, I will live in two dimensions!
Dialogue: 0,0:12:18.74,0:12:19.86,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:12:19.86,0:12:20.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:20.98,0:12:23.70,Default,,0,0,0,,Олай болса, бүгіннен бастап сен 2D-kun!
Dialogue: 0,0:12:23.70,0:12:27.78,Default,,0,0,0,,Бұл жеткілікті! Маған 2D-kun деп қоңырау шалыңыз!
Dialogue: 0,0:12:27.78,0:12:30.78,Default,,0,0,0,,Сен сонда кімсің? Сіздің атыңыз кім?
Dialogue: 0,0:12:30.78,0:12:33.90,Default,,0,0,0,,Тада Банрис...
Dialogue: 0,0:12:33.90,0:12:37.26,Default,,0,0,0,,Мм... тез арада Эйкенге қайтуым керек...
Dialogue: 0,0:12:37.26,0:12:38.78,Default,,0,0,0,,Ал...
Dialogue: 0,0:12:38.78,0:12:40.58,Default,,0,0,0,,Айтыңызшы!
Dialogue: 0,0:12:40.58,0:12:44.58,Default,,0,0,0,,Әпкеңмен бірге шық!
Dialogue: 0,0:12:45.58,0:12:48.58,Default,,0,0,0,,Жарайсыңдар! Барлығымыз барайық!
Dialogue: 0,0:12:50.58,0:12:51.58,Default,,0,0,0,,Тозақ...
Dialogue: 0,0:12:59.58,0:13:04.58,Default,,0,0,0,,The call you made is currently out of reception area...
Dialogue: 0,0:13:05.58,0:13:08.58,Default,,0,0,0,,Сәлем Ванли!
Dialogue: 0,0:13:08.58,0:13:10.58,Default,,0,0,0,,Ол тірі болды ма?
Dialogue: 0,0:13:10.58,0:13:12.58,Default,,0,0,0,,Нора-сан…
Dialogue: 0,0:13:13.58,0:13:15.58,Default,,0,0,0,,Ұйқының болмауы?
Dialogue: 0,0:13:15.58,0:13:20.58,Default,,0,0,0,,Oh... somehow, until the 5th party with Sato's seniors...
Dialogue: 0,0:13:20.58,0:13:21.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:21.58,0:13:22.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:26.58,0:13:29.58,Default,,0,0,0,,А... Кагава-сан?
Dialogue: 0,0:13:29.58,0:13:31.58,Default,,0,0,0,,Мен артқы есіктен өтіп жатырмын.
Dialogue: 0,0:13:31.58,0:13:33.58,Default,,0,0,0,,Менімен бірге болғаныңды айтпа.
Dialogue: 0,0:13:33.58,0:13:35.58,Default,,0,0,0,,О... иә
Dialogue: 0,0:13:35.58,0:13:39.58,Default,,0,0,0,,Сондай-ақ, мен ешқашан Эйкенге қосылмаймын...
Dialogue: 0,0:13:39.58,0:13:42.58,Default,,0,0,0,,Мен айтпаймын, бірақ айтпаймын.
Dialogue: 0,0:13:43.58,0:13:45.58,Default,,0,0,0,,Мен күнде осылай күтемін.
Dialogue: 0,0:13:45.58,0:13:47.58,Default,,0,0,0,,Жаңа ғана сөйлессек те
Dialogue: 0,0:13:48.58,0:13:52.58,Default,,0,0,0,,It might be a strategy to make people think that and invite them to the dojo.
Dialogue: 0,0:13:52.58,0:13:54.58,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:13:55.58,0:13:58.58,Default,,0,0,0,,Anyway, I don't know what he's going to do.
Dialogue: 0,0:13:58.58,0:14:00.58,Default,,0,0,0,,Сіз де абай болғаныңыз жөн.
Dialogue: 0,0:14:00.58,0:14:02.58,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:14:25.58,0:14:28.58,Default,,0,0,0,,Күрсін... Мен үйге келдім.
Dialogue: 0,0:14:29.58,0:14:33.58,Default,,0,0,0,,Бұл бал би үйірмесі. Сіз бірінші курстасыз, солай ма? Сіз әлі клуб туралы шешім қабылдадыңыз ба?
Dialogue: 0,0:14:33.58,0:14:35.58,Default,,0,0,0,,Жоқ, әлі жоқ.
Dialogue: 0,0:14:35.58,0:14:36.58,Default,,0,0,0,,Олай болса, бізге келіңіз!
Dialogue: 0,0:14:36.58,0:14:38.58,Default,,0,0,0,,Жоқ, жоқ, сенің аузың шеңберде!
Dialogue: 0,0:14:40.58,0:14:42.58,Default,,0,0,0,,Stop!
Dialogue: 0,0:14:42.58,0:14:46.58,Default,,0,0,0,,Кешіріңіз, бірақ ол қыз міндетті түрде бонусқа қосылады!
Dialogue: 0,0:14:46.58,0:14:48.58,Default,,0,0,0,,Иә, иә, tsk, tsk!
Dialogue: 0,0:14:48.58,0:14:50.58,Default,,0,0,0,,Не, қосылдың ба?
Dialogue: 0,0:14:50.58,0:14:51.58,Default,,0,0,0,,А, сен әлі клуб туралы шешім қабылдадың ба?
Dialogue: 0,0:14:51.58,0:14:53.58,Default,,0,0,0,,Ah, um...
Dialogue: 0,0:14:53.58,0:14:57.58,Default,,0,0,0,,Бұл Рин. Сіз жай ғана Банрисыз, бірінші курс студенті.
Dialogue: 0,0:14:57.58,0:15:01.58,Default,,0,0,0,,Аа, кешіріңіз, мен сізге тағы да көмектесуім керек болды.
Dialogue: 0,0:15:04.58,0:15:06.58,Default,,0,0,0,,Сіз жоғарыда айтқан бонус қандай?
Dialogue: 0,0:15:06.58,0:15:10.58,Default,,0,0,0,,Фестивальді зерттеу тобы Мен жататын үйірме
Dialogue: 0,0:15:10.58,0:15:14.58,Default,,0,0,0,,Ресми атауы Жапония Сайсай Бунка Кенкюкай.
Dialogue: 0,0:15:14.58,0:15:15.58,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:15:15.58,0:15:18.58,Default,,0,0,0,,Бұлай жүре алмайсың.
Dialogue: 0,0:15:18.58,0:15:21.58,Default,,0,0,0,,Қорғансыз жыл оңай байқалады.
Dialogue: 0,0:15:21.58,0:15:24.58,Default,,0,0,0,,Кешіріңіз, мен біраз ұйықтап қалдым.
Dialogue: 0,0:15:25.58,0:15:27.58,Default,,0,0,0,,Өзіңізді нашар сезінесіз бе?
Dialogue: 0,0:15:27.58,0:15:29.58,Default,,0,0,0,,Сіз емханада жұмыс істедіңіз бе?
Dialogue: 0,0:15:29.58,0:15:31.58,Default,,0,0,0,,Жоқ, осы уақытқа дейін.
Dialogue: 0,0:15:34.58,0:15:36.58,Default,,0,0,0,,Сенпай, сен сондай мейірімдісің.
Dialogue: 0,0:15:36.58,0:15:38.58,Default,,0,0,0,,Цубаки суық тигізіп алды ма!?
Dialogue: 0,0:15:46.58,0:15:48.58,Default,,0,0,0,,Эй, осыдан кейін...
Dialogue: 0,0:15:49.58,0:15:52.58,Default,,0,0,0,,Қағасан? Сен тағы жалғызсың.
Dialogue: 0,0:15:53.58,0:15:55.58,Default,,0,0,0,,Сіз таныссыз ба?
Dialogue: 0,0:15:55.58,0:15:57.58,Default,,0,0,0,,Сәлеметсіз бе, қыз?
Dialogue: 0,0:15:57.58,0:16:00.58,Default,,0,0,0,,Жоқ, Кага-санның өзіне ұнайтын адамы бар.
Dialogue: 0,0:16:00.58,0:16:04.58,Default,,0,0,0,,Менен ерекшесің, жас ханым.
Dialogue: 0,0:16:04.58,0:16:06.58,Default,,0,0,0,,Мен соншалықты естіген жоқпын.
Dialogue: 0,0:16:09.58,0:16:11.58,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:16:11.58,0:16:15.58,Default,,0,0,0,,Көрдіңіз бе? Өте әдемі модельге қараңыз
Dialogue: 0,0:16:15.58,0:16:19.58,Default,,0,0,0,,Бұл ол, солай ма? Атақты үлкен ауруханадан келген жас келіншек.
Dialogue: 0,0:16:19.58,0:16:21.58,Default,,0,0,0,,Кедергілер сәл жоғары.
Dialogue: 0,0:16:21.58,0:16:24.58,Default,,0,0,0,,Саған олай қарамайтынына сенімдімін.
Dialogue: 0,0:16:26.58,0:16:28.58,Default,,0,0,0,,Қағасан
Dialogue: 0,0:16:28.58,0:16:31.58,Default,,0,0,0,,Әй, Ямада-кун
Dialogue: 0,0:16:31.58,0:16:34.58,Default,,0,0,0,,Тадане Тадабанри
Dialogue: 0,0:16:34.58,0:16:37.58,Default,,0,0,0,,I was wondering what you were doing alone.
Dialogue: 0,0:16:37.58,0:16:41.58,Default,,0,0,0,,Білсе де айтпас еді.
Dialogue: 0,0:16:42.58,0:16:44.58,Default,,0,0,0,,Әлде ойыңызды өзгерттіңіз бе?
Dialogue: 0,0:16:44.58,0:16:47.58,Default,,0,0,0,,Жоқ, бұл өзгерген жоқ.
Dialogue: 0,0:16:48.58,0:16:49.58,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:16:49.58,0:16:52.58,Default,,0,0,0,,Ах! Тек Банри!
Dialogue: 0,0:16:52.58,0:16:57.58,Default,,0,0,0,,Не? Бүгін қандай терең теңізге барасыз? Мүмкін сізде қарым-қатынас бар шығар?
Dialogue: 0,0:16:57.58,0:16:59.58,Default,,0,0,0,,Бүгін біз де серуендеуге келеміз.
Dialogue: 0,0:16:59.58,0:17:01.58,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:17:01.58,0:17:06.58,Default,,0,0,0,,Не? Бүгін қандай терең теңізге барасыз? Мүмкін сізде қарым-қатынас бар шығар?
Dialogue: 0,0:17:06.58,0:17:08.58,Default,,0,0,0,,Бүгін пойыздарды тағы ауыстырамыз.
Dialogue: 0,0:17:08.58,0:17:11.58,Default,,0,0,0,,Әрине келесіз.
Dialogue: 0,0:17:11.58,0:17:14.58,Default,,0,0,0,,Жоқ, екі күн қатарынан аздап
Dialogue: 0,0:17:14.58,0:17:16.58,Default,,0,0,0,,Аз ғана емес.
Dialogue: 0,0:17:16.58,0:17:19.58,Default,,0,0,0,,All you have to do is make up your mind and join the club.
Dialogue: 0,0:17:19.58,0:17:21.58,Default,,0,0,0,,...
Dialogue: 0,0:17:21.58,0:17:23.58,Default,,0,0,0,,Ой, кешір, мен сені үйге әкелдім.
Dialogue: 0,0:17:26.58,0:17:29.58,Default,,0,0,0,,А, егер қаласаңыз, маған электрондық поштаны жіберіңіз.
Dialogue: 0,0:17:29.58,0:17:31.58,Default,,0,0,0,,Мен сені күтемін.
Dialogue: 0,0:17:34.58,0:17:36.58,Default,,0,0,0,,Қазір бұл не?
Dialogue: 0,0:17:36.58,0:17:39.58,Default,,0,0,0,,Иә? Сато бөліміндегі жоғары курс студенттері
Dialogue: 0,0:17:39.58,0:17:42.58,Default,,0,0,0,,I'm sure their names are Sao-chan and Shi-chan.
Dialogue: 0,0:17:42.58,0:17:44.58,Default,,0,0,0,,Бұл мағынаны білдірмейді.
Dialogue: 0,0:17:44.58,0:17:47.58,Default,,0,0,0,,Эй Тадакун, сен қалай ойлайсың?
Dialogue: 0,0:17:47.58,0:17:49.58,Default,,0,0,0,,Қалай?
Dialogue: 0,0:17:49.58,0:17:53.58,Default,,0,0,0,,How many circles did Tada-kun get recruited from?
Dialogue: 0,0:17:53.58,0:17:56.58,Default,,0,0,0,,Енді мен санай алмаймын деп ойлаймын.
Dialogue: 0,0:17:56.58,0:17:59.58,Default,,0,0,0,,Менің ойымша, барлық жаңа студенттер осындай.
Dialogue: 0,0:18:01.58,0:18:04.58,Default,,0,0,0,,Мен нөлмін
Dialogue: 0,0:18:04.58,0:18:06.58,Default,,0,0,0,,Нөл?
Dialogue: 0,0:18:06.58,0:18:10.58,Default,,0,0,0,,Мен бұл парақшаны сол жерден алдым.
Dialogue: 0,0:18:10.58,0:18:14.58,Default,,0,0,0,,Неге менімен ешкім сөйлеспейді?
Dialogue: 0,0:18:16.58,0:18:20.58,Default,,0,0,0,,Мен үйірмелерге аса қызықпаймын.
Dialogue: 0,0:18:20.58,0:18:24.58,Default,,0,0,0,,I don't think I want to join anywhere unless I'm with Mitsuo.
Dialogue: 0,0:18:24.58,0:18:27.58,Default,,0,0,0,,We went to the same school and cram school.
Dialogue: 0,0:18:27.58,0:18:31.58,Default,,0,0,0,,Өйткені Мицуосыз мен жоқ
Dialogue: 0,0:18:31.58,0:18:35.58,Default,,0,0,0,,Бірақ, әйтеуір, бұл да мен
Dialogue: 0,0:18:35.58,0:18:38.58,Default,,0,0,0,,Мен мұнда келгеннен бері
Dialogue: 0,0:18:39.58,0:18:43.58,Default,,0,0,0,,Мен өзімді мөлдір болып кеткендей сезінемін.
Dialogue: 0,0:18:43.58,0:18:48.58,Default,,0,0,0,,I feel like I'm being ignored by the people around me.
Dialogue: 0,0:18:49.58,0:18:53.58,Default,,0,0,0,,Мен сондай біртүрлімін бе?
Dialogue: 0,0:18:53.58,0:18:57.58,Default,,0,0,0,,I wonder if that's why Mitsuo doesn't deal with him either.
Dialogue: 0,0:18:58.58,0:19:00.58,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:19:00.58,0:19:04.58,Default,,0,0,0,,Сіз мені аяу үшін әрекет етесіз бе?
Dialogue: 0,0:19:04.58,0:19:07.58,Default,,0,0,0,,Әлде шынымен де айтып тұрсың ба?
Dialogue: 0,0:19:10.58,0:19:12.58,Default,,0,0,0,,Өйткені
Dialogue: 0,0:19:12.58,0:19:17.58,Default,,0,0,0,,Тек Яна емес, әртүрлі адамдармен сөйлескен дұрыс емес пе?
Dialogue: 0,0:19:17.58,0:19:19.58,Default,,0,0,0,,Өзіңіз сөйлеңіз
Dialogue: 0,0:19:19.58,0:19:22.58,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:19:22.58,0:19:25.58,Default,,0,0,0,,Әртүрлі үйірмелердің кештеріне қатысу.
Dialogue: 0,0:19:25.58,0:19:27.58,Default,,0,0,0,,Бірдеңе болса, мен де сенімен бірге барамын.
Dialogue: 0,0:19:27.58,0:19:29.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:29.58,0:19:32.58,Default,,0,0,0,,Біздің клуб сізді қызықтырады ма?
Dialogue: 0,0:19:32.58,0:19:35.58,Default,,0,0,0,,Кешіріңіз, кешіріңіз, мен стендті біраз уақыт аштым.
Dialogue: 0,0:19:35.58,0:19:37.58,Default,,0,0,0,,Біз жан-жақты өнерпазбыз.
Dialogue: 0,0:19:37.58,0:19:39.58,Default,,0,0,0,,Қарапайым тілмен айтқанда,
Dialogue: 0,0:19:39.58,0:19:41.58,Default,,0,0,0,,Көктемде отшашумен ішімдік ішу
Dialogue: 0,0:19:41.58,0:19:43.58,Default,,0,0,0,,Жазда барбекю жасап, сусын ішіңіз
Dialogue: 0,0:19:43.58,0:19:46.58,Default,,0,0,0,,Күзде Момиджигариде ішімдік кешін өткізіңіз
Dialogue: 0,0:19:46.58,0:19:48.58,Default,,0,0,0,,Қыста Сунобода ішу
Dialogue: 0,0:19:48.58,0:19:50.58,Default,,0,0,0,,Тенноридің кездейсоқ шеңбері
Dialogue: 0,0:19:50.58,0:19:52.58,Default,,0,0,0,,Қаласаңыз
Dialogue: 0,0:19:52.58,0:19:54.58,Default,,0,0,0,,Жақын жерде жасырын кафе бар.
Dialogue: 0,0:19:54.58,0:19:56.58,Default,,0,0,0,,Сіз мені сонда тыңдай аласыз ба?
Dialogue: 0,0:19:56.58,0:19:58.58,Default,,0,0,0,,Кафе ау лайт сонда табақпен беріледі.
Dialogue: 0,0:19:58.58,0:20:00.58,Default,,0,0,0,,Cafe au lait ball
Dialogue: 0,0:20:00.58,0:20:02.58,Default,,0,0,0,,Аа, әрине сатып аламын, уайымдама.
Dialogue: 0,0:20:02.58,0:20:04.58,Default,,0,0,0,,Ал, шешілді.
Dialogue: 0,0:20:04.58,0:20:06.58,Default,,0,0,0,,Кеттік, кеттік
Dialogue: 0,0:20:06.58,0:20:08.58,Default,,0,0,0,,Ой
Dialogue: 0,0:20:08.58,0:20:10.58,Default,,0,0,0,,Тада-кун, менің жүгім
Dialogue: 0,0:20:10.58,0:20:12.58,Default,,0,0,0,,Иә, ә
Dialogue: 0,0:20:12.58,0:20:14.58,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:14.58,0:20:16.58,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:20:16.58,0:20:18.58,Default,,0,0,0,,Ешқайсыларың әлі ешқайда кірген жоқсыңдар.
Dialogue: 0,0:20:18.58,0:20:20.58,Default,,0,0,0,,Онда міндетті түрде бізге келу керек.
Dialogue: 0,0:20:20.58,0:20:22.58,Default,,0,0,0,,Дәрістер, емтихан туралы ақпарат және т.б.
Dialogue: 0,0:20:22.58,0:20:24.58,Default,,0,0,0,,Ол тез келеді.
Dialogue: 0,0:20:24.58,0:20:26.58,Default,,0,0,0,,Түлектер көп, сондықтан жұмыс табу үшін жақсы.
Dialogue: 0,0:20:26.58,0:20:28.58,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:20:28.58,0:20:30.58,Default,,0,0,0,,Шынымен ұсынылған О, және
Dialogue: 0,0:20:30.58,0:20:32.58,Default,,0,0,0,,Қосылғанда көп нәрсе істеу керек
Dialogue: 0,0:20:32.58,0:20:34.58,Default,,0,0,0,,Негізі мен басқа университеттің студентімін.
Dialogue: 0,0:20:34.58,0:20:36.58,Default,,0,0,0,,Өйткені, әртүрлі университеттердің адамдарымен
Dialogue: 0,0:20:36.58,0:20:38.58,Default,,0,0,0,,Сөйлесу ынталандырады.
Dialogue: 0,0:20:38.58,0:20:40.58,Default,,0,0,0,,Егер бұл нашар шеңбер болса
Dialogue: 0,0:20:40.58,0:20:42.58,Default,,0,0,0,,Оған кіргеннен кейін шығу қиын болуы мүмкін.
Dialogue: 0,0:20:42.58,0:20:44.58,Default,,0,0,0,,Бізде ондай нәрсе жоқ.
Dialogue: 0,0:20:44.58,0:20:46.58,Default,,0,0,0,,Жыл сайын
Dialogue: 0,0:20:46.58,0:20:48.58,Default,,0,0,0,,Жаңа ғимарат семинар үйінде болады.
Dialogue: 0,0:20:48.58,0:20:50.58,Default,,0,0,0,,2 түн 3 күн
Dialogue: 0,0:20:50.58,0:20:52.58,Default,,0,0,0,,Сенбі күні түстен кейін
Dialogue: 0,0:20:52.58,0:20:54.58,Default,,0,0,0,,Кешке тамақтанып, кетіңіз
Dialogue: 0,0:20:54.58,0:20:56.58,Default,,0,0,0,,Үлкен банкет
Dialogue: 0,0:20:56.58,0:20:58.58,Default,,0,0,0,,Уайымдама, мен дүйсенбі күні таңертең қайтамын.
Dialogue: 0,0:20:58.58,0:21:00.58,Default,,0,0,0,,Жаңа студенттердің ақшасы
Dialogue: 0,0:21:00.58,0:21:02.58,Default,,0,0,0,,Біз сізден ақы алмаймыз, сондықтан жеңіл жүріңіз.
Dialogue: 0,0:21:02.58,0:21:04.58,Default,,0,0,0,,Иә, қатысамын.
Dialogue: 0,0:21:04.58,0:21:06.58,Default,,0,0,0,,Ереже болса, жарайды, солай ма?
Dialogue: 0,0:21:06.58,0:21:08.58,Default,,0,0,0,,Ал, ертең мамандықтың алдында кездесейік.
Dialogue: 0,0:21:08.58,0:21:10.58,Default,,0,0,0,,Бұл әрине қызық, сондықтан оны асыға күтіңіз
Dialogue: 0,0:21:10.58,0:21:12.58,Default,,0,0,0,,Эй
Dialogue: 0,0:21:16.58,0:21:18.58,Default,,0,0,0,,Мен қатысуға шешім қабылдадым.
Dialogue: 0,0:21:18.58,0:21:20.58,Default,,0,0,0,,Иә
Dialogue: 0,0:21:20.58,0:21:22.58,Default,,0,0,0,,Өйткені ол кісінің екпіні керемет еді
Dialogue: 0,0:21:22.58,0:21:24.58,Default,,0,0,0,,Бірақ бәрібір.
Dialogue: 0,0:21:24.58,0:21:26.58,Default,,0,0,0,,Егер сіз осындай нәрсені қолданып көрсеңіз
Dialogue: 0,0:21:26.58,0:21:28.58,Default,,0,0,0,,Кіру немесе кірмеуді кейінірек шеше аласыз.
Dialogue: 0,0:21:28.58,0:21:30.58,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:21:30.58,0:21:32.58,Default,,0,0,0,,Бұл тамаша мүмкіндік
Dialogue: 0,0:21:32.58,0:21:34.58,Default,,0,0,0,,Барлығы тәжірибе, солай ма?
Dialogue: 0,0:21:34.58,0:21:36.58,Default,,0,0,0,,Ах
Dialogue: 0,0:21:38.58,0:21:40.58,Default,,0,0,0,,Міне, міне, бүгін біз де келдік.
Dialogue: 0,0:21:40.58,0:21:42.58,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:21:42.58,0:21:44.58,Default,,0,0,0,,Иә
Dialogue: 0,0:21:52.58,0:21:54.58,Default,,0,0,0,,Мен өзімді мөлдір болып кеткендей сезінемін.
Dialogue: 0,0:21:54.58,0:21:56.58,Default,,0,0,0,,Немесе
Dialogue: 0,0:22:04.58,0:22:06.58,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:22:08.58,0:22:50.58,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:22:52.58,0:23:02.58,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:23:16.58,0:23:18.58,Default,,0,0,0,,Енгізілді
Dialogue: 0,0:23:27.38,0:23:29.38,Default,,0,0,0,,Кага-санмен
