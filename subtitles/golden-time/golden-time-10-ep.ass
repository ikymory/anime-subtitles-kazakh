Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Түрту... жылжыту...
Dialogue: 0,0:00:07.20,0:00:08.20,Default,,0,0,0,,Линда…
Dialogue: 0,0:00:20.50,0:00:22.00,Default,,0,0,0,,Мен Линданы кездестіре аламын...
Dialogue: 0,0:00:30.00,0:00:31.00,Default,,0,0,0,,Уф!
Dialogue: 0,0:01:01.00,0:01:03.00,Default,,0,0,0,,Не... енді...
Dialogue: 0,0:01:04.50,0:01:05.50,Default,,0,0,0,,Үш ойыншы оны құлатып тастады
Dialogue: 0,0:01:06.00,0:01:07.50,Default,,0,0,0,,Мен мен емес едім
Dialogue: 0,0:01:09.00,0:01:10.00,Default,,0,0,0,,Қазір ғана…
Dialogue: 0,0:01:12.00,0:01:13.00,Default,,0,0,0,,Линда
Dialogue: 0,0:01:15.00,0:01:16.50,Default,,0,0,0,,Мен Линдамен кездескім келеді
Dialogue: 0,0:01:17.50,0:01:18.50,Default,,0,0,0,,Неге...
Dialogue: 0,0:01:20.00,0:01:21.00,Default,,0,0,0,,Неге...
Dialogue: 0,0:01:22.00,0:01:24.50,Default,,0,0,0,,Менің жадым қайта оралғандай емес.
Dialogue: 0,0:01:25.50,0:01:26.50,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:01:26.50,0:01:29.00,Default,,0,0,0,,Мен әлі де Линдамен кездескім келеді.
Dialogue: 0,0:01:41.00,0:01:42.50,Default,,0,0,0,,Не болды...
Dialogue: 0,0:01:44.00,0:01:45.00,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:01:57.00,0:01:58.00,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:04.00,0:02:05.00,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:26.50,0:02:27.50,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:57.00,0:02:58.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:00.00,0:03:06.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:07.00,0:03:26.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:26.50,0:03:27.50,Default,,0,0,0,,Пипипипи…
Dialogue: 0,0:03:32.50,0:03:34.50,Default,,0,0,0,,Бұл ауыр жарақат емес.
Dialogue: 0,0:03:34.50,0:03:35.50,Default,,0,0,0,,Неліктен бұл...
Dialogue: 0,0:03:42.50,0:03:44.50,Default,,0,0,0,,Кеше не болды?
Dialogue: 0,0:03:44.50,0:03:47.50,Default,,0,0,0,,Мен әлі нақты түсінбедім
Dialogue: 0,0:03:48.50,0:03:49.50,Default,,0,0,0,,Бірақ сол кезде
Dialogue: 0,0:03:50.00,0:03:53.00,Default,,0,0,0,,Линдаға ғашық болған кезде мен міндетті түрде Тадабанри болдым.
Dialogue: 0,0:03:53.50,0:03:54.50,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:03:55.00,0:03:57.00,Default,,0,0,0,,Бұл сезім әлі де сейілген жоқ.
Dialogue: 0,0:04:00.00,0:04:01.00,Default,,0,0,0,,Фотосурет жоқ
Dialogue: 0,0:04:02.50,0:04:04.50,Default,,0,0,0,,Мен оны осында сақтағаныма сенімдімін.
Dialogue: 0,0:04:06.50,0:04:07.50,Default,,0,0,0,,Неге...
Dialogue: 0,0:04:08.00,0:04:09.00,Default,,0,0,0,,Неге...
Dialogue: 0,0:04:11.00,0:04:12.00,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:04:12.50,0:04:13.50,Default,,0,0,0,,Кага-сан...
Dialogue: 0,0:04:18.50,0:04:20.00,Default,,0,0,0,,Мен ауруханаға баруым керек...
Dialogue: 0,0:04:24.50,0:04:25.50,Default,,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:04:28.50,0:04:29.50,Default,,0,0,0,,Жүре алмайды
Dialogue: 0,0:04:30.50,0:04:31.50,Default,,0,0,0,,Мен...
Dialogue: 0,0:04:31.50,0:04:32.50,Default,,0,0,0,,Мен қатты өліп қалуым мүмкін
Dialogue: 0,0:04:38.50,0:04:39.50,Default,,0,0,0,,Кага мырза...
Dialogue: 0,0:04:41.00,0:04:42.50,Default,,0,0,0,,Онда не болып жатыр!
Dialogue: 0,0:04:43.00,0:04:44.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:44.00,0:04:45.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:45.00,0:04:46.50,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:04:47.00,0:04:48.50,Default,,0,0,0,,Бейбітшілік...
Dialogue: 0,0:04:49.00,0:04:50.00,Default,,0,0,0,,...
Dialogue: 0,0:04:50.00,0:04:51.50,Default,,0,0,0,,Сөйлемеңіз, себебі ауа өте ыстық
Dialogue: 0,0:05:01.00,0:05:02.00,Default,,0,0,0,,Ол аяқталды ма?
Dialogue: 0,0:05:02.00,0:05:03.50,Default,,0,0,0,,Иә, әйтеуір
Dialogue: 0,0:05:06.50,0:05:07.50,Default,,0,0,0,,Нана-сенпай?
Dialogue: 0,0:05:07.50,0:05:08.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:09.00,0:05:10.50,Default,,0,0,0,,Нана-сенпай деген кім?
Dialogue: 0,0:05:10.50,0:05:11.50,Default,,0,0,0,,Шынымен
Dialogue: 0,0:05:11.50,0:05:12.50,Default,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,0:05:13.00,0:05:14.00,Default,,0,0,0,,Солай сияқты.
Dialogue: 0,0:05:14.50,0:05:15.50,Default,,0,0,0,,Солай сияқты.
Dialogue: 0,0:05:16.00,0:05:17.00,Default,,0,0,0,,Солай сияқты.
Dialogue: 0,0:05:17.00,0:05:18.00,Default,,0,0,0,,Нана-сенпай деген кім?
Dialogue: 0,0:05:18.00,0:05:19.00,Default,,0,0,0,,Шынымен
Dialogue: 0,0:05:19.00,0:05:20.00,Default,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,0:05:20.00,0:05:22.50,Default,,0,0,0,,Ол өте жақсы адам еді, солай емес пе?
Dialogue: 0,0:05:23.00,0:05:25.00,Default,,0,0,0,,Сіз ренжіген сияқтысыз, тем.
Dialogue: 0,0:05:25.50,0:05:26.50,Default,,0,0,0,,Мен
Dialogue: 0,0:05:26.50,0:05:28.00,Default,,0,0,0,,Нана-сенпай туралы
Dialogue: 0,0:05:28.00,0:05:30.00,Default,,0,0,0,,Мен қалай болғанда да дұрыс түсінбедім деп ойлаймын.
Dialogue: 0,0:05:30.50,0:05:31.50,Default,,0,0,0,,Қалай?
Dialogue: 0,0:05:32.00,0:05:33.50,Default,,0,0,0,,Нана-сенпай деген кім?
Dialogue: 0,0:05:33.50,0:05:35.50,Default,,0,0,0,,Токио шөлінде алданбаңыз
Dialogue: 0,0:05:35.50,0:05:37.50,Default,,0,0,0,,Мен жасанды түрде,
Dialogue: 0,0:05:38.00,0:05:41.00,Default,,0,0,0,,Мен жақынымның шынайы махаббатын ұмыттым
Dialogue: 0,0:05:41.00,0:05:43.50,Default,,0,0,0,,Қалаға байланысты өзгертілді
Dialogue: 0,0:05:43.50,0:05:47.00,Default,,0,0,0,,Мен оны Кавагучиден шыққан экстремалды косплейші деп ойладым.
Dialogue: 0,0:05:47.00,0:05:48.50,Default,,0,0,0,,Кавагучи емес.
Dialogue: 0,0:05:49.00,0:05:50.50,Default,,0,0,0,,Сондай-ақ, бұл косплей емес.
Dialogue: 0,0:05:51.00,0:05:52.00,Default,,0,0,0,,Жақсы
Dialogue: 0,0:05:52.50,0:05:54.00,Default,,0,0,0,,Каминаказато болды ма?
Dialogue: 0,0:05:54.50,0:05:55.50,Default,,0,0,0,,Вараби
Dialogue: 0,0:05:57.50,0:05:58.50,Default,,0,0,0,,Қарашы, Айрен.
Dialogue: 0,0:06:01.00,0:06:02.50,Default,,0,0,0,,Бұл қорқынышты емес пе?
Dialogue: 0,0:06:03.00,0:06:04.50,Default,,0,0,0,,Мен сізді шынымен мейірімді деп ойладым.
Dialogue: 0,0:06:04.50,0:06:06.00,Default,,0,0,0,,Кенет суық болды
Dialogue: 0,0:06:08.00,0:06:09.50,Default,,0,0,0,,Мен мұндай цундерді ешқашан күтпедім.
Dialogue: 0,0:06:09.50,0:06:11.50,Default,,0,0,0,,Менің мұрнымды айналдырыңыз
Dialogue: 0,0:06:11.50,0:06:13.50,Default,,0,0,0,,Ақыл-ой дайындығы
Dialogue: 0,0:06:13.50,0:06:14.50,Default,,0,0,0,,Урус
Dialogue: 0,0:06:15.00,0:06:16.50,Default,,0,0,0,,Егер Линда-сенпай
Dialogue: 0,0:06:16.50,0:06:18.50,Default,,0,0,0,,Ол маған мейірімдірек болар еді.
Dialogue: 0,0:06:19.00,0:06:20.50,Default,,0,0,0,,жақсы болар еді
Dialogue: 0,0:06:27.50,0:06:28.50,Default,,0,0,0,,Раббым!
Dialogue: 0,0:06:29.00,0:06:30.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:30.50,0:06:31.50,Default,,0,0,0,,Амал жоқ, Нана-сенпай
Dialogue: 0,0:06:31.50,0:06:32.50,Default,,0,0,0,,Бір нәрсеге байланысты
Dialogue: 0,0:06:32.50,0:06:34.50,Default,,0,0,0,,Мен бұл туралы ойлап отырмын
Dialogue: 0,0:06:35.50,0:06:37.50,Default,,0,0,0,,Мен бұл жігітке онша қызықпаймын.
Dialogue: 0,0:06:37.50,0:06:39.50,Default,,0,0,0,,Мына тентек өз бетінше осылай болып қалды.
Dialogue: 0,0:06:39.50,0:06:41.50,Default,,0,0,0,,Мен көмек сұрадым.
Dialogue: 0,0:06:41.50,0:06:42.50,Default,,0,0,0,,Сонымен
Dialogue: 0,0:06:42.50,0:06:44.50,Default,,0,0,0,,Мен Янгирумын
Dialogue: 0,0:06:44.50,0:06:45.50,Default,,0,0,0,,Ачо
Dialogue: 0,0:06:45.50,0:06:46.50,Default,,0,0,0,,Нана-сенпай
Dialogue: 0,0:06:48.50,0:06:49.50,Default,,0,0,0,,Темекіні тастаған дұрыс
Dialogue: 0,0:06:50.50,0:06:51.50,Default,,0,0,0,,Менен сұрама.
Dialogue: 0,0:06:53.50,0:06:54.50,Default,,0,0,0,,Біраз
Dialogue: 0,0:06:54.50,0:06:55.50,Default,,0,0,0,,Сіз шынымен жақсысыз ба?
Dialogue: 0,0:06:56.50,0:06:57.50,Default,,0,0,0,,Эй
Dialogue: 0,0:06:57.50,0:06:58.50,Default,,0,0,0,,Қайда қарап тұрсың?
Dialogue: 0,0:06:59.50,0:07:00.50,Default,,0,0,0,,Сіз жүре аласыз ба?
Dialogue: 0,0:07:07.50,0:07:08.50,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:14.50,0:07:15.50,Default,,0,0,0,,Ол әлі де болды
Dialogue: 0,0:07:15.50,0:07:16.50,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:07:17.50,0:07:18.50,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:07:18.50,0:07:20.50,Default,,0,0,0,,Сәл жақсырақ
Dialogue: 0,0:07:22.50,0:07:24.50,Default,,0,0,0,,Мен жеуге болатын нәрсе сатып алдым.
Dialogue: 0,0:07:25.50,0:07:27.50,Default,,0,0,0,,Қалай ойлайсың, осы жерден айнала аламын ба?
Dialogue: 0,0:07:28.50,0:07:29.50,Default,,0,0,0,,Сіз тыңдайсыз ба?
Dialogue: 0,0:07:29.50,0:07:30.50,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:07:30.50,0:07:31.50,Default,,0,0,0,,Ах
Dialogue: 0,0:07:31.50,0:07:32.50,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:07:32.50,0:07:33.50,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:34.50,0:07:36.50,Default,,0,0,0,,Бетіңіз қызарған.
Dialogue: 0,0:07:36.50,0:07:38.10,Default,,0,0,0,,Сіздің қызуыңыз тағы көтерілді ме?
Dialogue: 0,0:07:40.10,0:07:41.10,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:42.00,0:07:44.50,Default,,0,0,0,,Линда-сенпай, мұнда неге келдің?
Dialogue: 0,0:07:46.30,0:07:49.70,Default,,0,0,0,,Дәл қазір мен кенеттен Нана-сенпайдан осындай хат алдым.
Dialogue: 0,0:07:51.90,0:07:54.70,Default,,0,0,0,,Мен таң қалдым да, ағама хабарластым.
Dialogue: 0,0:07:54.70,0:07:56.70,Default,,0,0,0,,Маған пәтерде күту керектігін айтты.
Dialogue: 0,0:07:57.20,0:07:58.50,Default,,0,0,0,,Сондықтан мен мұнда келдім.
Dialogue: 0,0:08:03.80,0:08:04.50,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:07.00,0:08:08.00,Default,,0,0,0,,Іш, жүр.
Dialogue: 0,0:08:12.50,0:08:13.50,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:08:14.00,0:08:16.00,Default,,0,0,0,,Жарайды, келесіні жасайық.
Dialogue: 0,0:08:17.00,0:08:20.00,Default,,0,0,0,,Біртүрлі болды, бірақ ешкім қарап тұрған жоқ.
Dialogue: 0,0:08:21.50,0:08:22.50,Default,,0,0,0,,Нан жақсы ма?
Dialogue: 0,0:08:25.00,0:08:27.00,Default,,0,0,0,,Жарайды, бұл біткен соң, мен дәрі ішемін.
Dialogue: 0,0:08:27.50,0:08:30.50,Default,,0,0,0,,Ал, оны қайда қойдыңыз?
Dialogue: 0,0:08:31.50,0:08:33.50,Default,,0,0,0,,Линдаға рахмет
Dialogue: 0,0:08:34.50,0:08:36.00,Default,,0,0,0,,Линдаға рахмет
Dialogue: 0,0:08:36.00,0:08:37.00,Default,,0,0,0,,болды
Dialogue: 0,0:08:39.00,0:08:40.00,Default,,0,0,0,,Сіз бірдеңе дедіңіз бе?
Dialogue: 0,0:08:41.00,0:08:45.00,Default,,0,0,0,,А, жоқ, рахмет, Линда-сенпай.
Dialogue: 0,0:08:46.00,0:08:48.00,Default,,0,0,0,,Маған осылай қамқор болғандарыңызға рахмет.
Dialogue: 0,0:08:48.50,0:08:50.00,Default,,0,0,0,,Ешкім келіп құрмет көрсетпейді.
Dialogue: 0,0:08:50.50,0:08:54.00,Default,,0,0,0,,Жарайды, мен сені қандай жағдайда да қолдаймын.
Dialogue: 0,0:08:54.00,0:08:55.00,Default,,0,0,0,,Мен саған өткен күні айттым.
Dialogue: 0,0:08:55.00,0:08:58.00,Default,,0,0,0,,Жоқ, бірақ мен оны лекцияны өткізіп жіберуге мәжбүр еттім.
Dialogue: 0,0:08:58.50,0:09:01.00,Default,,0,0,0,,Жарайды, мен Линдамын.
Dialogue: 0,0:09:01.50,0:09:03.50,Default,,0,0,0,,Демек, бұл табиғи нәрсе.
Dialogue: 0,0:09:03.50,0:09:05.50,Default,,0,0,0,,Осыны түсіну керек.
Dialogue: 0,0:09:06.50,0:09:10.50,Default,,0,0,0,,Ештеңені ойламай, маған мейірімді бол, Банри.
Dialogue: 0,0:09:11.00,0:09:12.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:15.00,0:09:16.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:17.50,0:09:21.00,Default,,0,0,0,,Бұл адам шақыратын Банри мен емеспін.
Dialogue: 0,0:09:22.50,0:09:26.50,Default,,0,0,0,,Бұл адам үшін Банри - орта мектептегі Банри.
Dialogue: 0,0:09:27.50,0:09:30.50,Default,,0,0,0,,Біз бір сыныпта және бір жеңіл атлетика клубында болдық.
Dialogue: 0,0:09:31.00,0:09:33.00,Default,,0,0,0,,Бұл сол кездегі Банри туралы.
Dialogue: 0,0:09:33.50,0:09:34.50,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:09:35.50,0:09:36.50,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:42.00,0:09:43.00,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:09:45.50,0:09:48.00,Default,,0,0,0,,Ым, жанғыш қоқыс ше?
Dialogue: 0,0:09:48.50,0:09:49.50,Default,,0,0,0,,Бұл ас үй.
Dialogue: 0,0:09:56.50,0:09:57.50,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:57.50,0:10:01.00,Default,,0,0,0,,Мен қазір жақсымын. Мен дәрі-дәрмекті ішіп, тамақтандым.
Dialogue: 0,0:10:01.00,0:10:02.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:04.50,0:10:06.50,Default,,0,0,0,,Нана-сенпай мейірімді, солай емес пе?
Dialogue: 0,0:10:07.00,0:10:10.50,Default,,0,0,0,,Егер ол адам маған шынымен көмектеспесе
Dialogue: 0,0:10:10.50,0:10:12.50,Default,,0,0,0,,Мен қатты қиналдым.
Dialogue: 0,0:10:12.50,0:10:15.50,Default,,0,0,0,,Әй, қарашы, ол кісі шынымен қамқор екен.
Dialogue: 0,0:10:16.00,0:10:19.50,Default,,0,0,0,,Маған қазірдің өзінде көп көмек көрсетілгендей сезінемін.
Dialogue: 0,0:10:22.50,0:10:23.50,Default,,0,0,0,,Иә? Не болды?
Dialogue: 0,0:10:23.50,0:10:25.50,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:10:28.00,0:10:31.00,Default,,0,0,0,,Мен Коуко-чанға хабарластым.
Dialogue: 0,0:10:31.50,0:10:32.50,Default,,0,0,0,,Кага-сан
Dialogue: 0,0:10:33.50,0:10:34.50,Default,,0,0,0,,Мен сенімен танысқым келеді
Dialogue: 0,0:10:36.50,0:10:38.50,Default,,0,0,0,,Ол менің сүйікті қызым.
Dialogue: 0,0:10:41.00,0:10:43.50,Default,,0,0,0,,Мен өзіме не болғанын білмеймін
Dialogue: 0,0:10:44.00,0:10:46.50,Default,,0,0,0,,Мені қалай қанағаттандыруға болады?
Dialogue: 0,0:10:47.00,0:10:49.50,Default,,0,0,0,,Мен не қалайтынымды білмеймін
Dialogue: 0,0:10:50.50,0:10:51.50,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:10:52.00,0:10:54.00,Default,,0,0,0,,Мен Линданың қасында болғым келетін сияқтымын.
Dialogue: 0,0:10:54.00,0:10:56.00,Default,,0,0,0,,Бұл менің ішімде екені сөзсіз
Dialogue: 0,0:10:56.50,0:10:58.50,Default,,0,0,0,,Линдамен осылай болу
Dialogue: 0,0:10:59.50,0:11:00.50,Default,,0,0,0,,Қага мырза
Dialogue: 0,0:11:00.50,0:11:03.50,Default,,0,0,0,,Түсімде кездескен адам сияқты.
Dialogue: 0,0:11:06.00,0:11:08.00,Default,,0,0,0,,Линданың әлемі шынайы.
Dialogue: 0,0:11:08.50,0:11:11.50,Default,,0,0,0,,Мен Кага-санның түсі бозарып кететінін сеземін.
Dialogue: 0,0:11:14.50,0:11:17.00,Default,,0,0,0,,Кага-сан бар дүние шын болса
Dialogue: 0,0:11:17.00,0:11:19.00,Default,,0,0,0,,Менің алдымда шыққаныңды қалаймын
Dialogue: 0,0:11:20.50,0:11:22.00,Default,,0,0,0,,Әйтпесе
Dialogue: 0,0:11:22.00,0:11:23.50,Default,,0,0,0,,Барлығы
Dialogue: 0,0:11:24.00,0:11:27.00,Default,,0,0,0,,Жоғары қызба бұзылған ландшафттың бір жерінен шығады.
Dialogue: 0,0:11:27.50,0:11:29.00,Default,,0,0,0,,Жақында келетініне сенімдімін.
Dialogue: 0,0:11:29.50,0:11:32.50,Default,,0,0,0,,Олар дәл қазір осы жаққа бару керек емес пе?
Dialogue: 0,0:11:33.00,0:11:36.00,Default,,0,0,0,,Бірақ Кага-сан дәл қазір желде ұйықтап жатқан болуы керек.
Dialogue: 0,0:11:44.00,0:11:45.00,Default,,0,0,0,,Алдау
Dialogue: 0,0:11:45.00,0:11:46.00,Default,,0,0,0,,...
Dialogue: 0,0:11:54.00,0:11:55.00,Default,,0,0,0,,Кага-сан
Dialogue: 0,0:11:55.00,0:11:57.00,Default,,0,0,0,,Қайырлы таң Тада-кун
Dialogue: 0,0:11:58.00,0:12:02.00,Default,,0,0,0,,Жігітіңіз болған кезде басқа біреумен бөлмеде қалай жалғыз қалуға болады?
Dialogue: 0,0:12:02.00,0:12:04.00,Default,,0,0,0,,Бұл мүлдем алдау.
Dialogue: 0,0:12:04.00,0:12:06.00,Default,,0,0,0,,Мен мұны бұрын айттым деп ойлаймын.
Dialogue: 0,0:12:06.00,0:12:08.00,Default,,0,0,0,,Жоқ, бірақ бұл
Dialogue: 0,0:12:08.00,0:12:10.00,Default,,0,0,0,,Эй, Коко-чан, сабыр ет.
Dialogue: 0,0:12:12.00,0:12:14.00,Default,,0,0,0,,Қандай әзіл
Dialogue: 0,0:12:19.00,0:12:21.00,Default,,0,0,0,,Ол қазірдің өзінде тегін
Dialogue: 0,0:12:21.50,0:12:23.50,Default,,0,0,0,,Ол қазірдің өзінде тегін
Dialogue: 0,0:12:23.50,0:12:25.50,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:25.50,0:12:27.50,Default,,0,0,0,,Мен қарамаған кезде
Dialogue: 0,0:12:27.50,0:12:29.50,Default,,0,0,0,,Қауіпті істермен айналыспаңыз
Dialogue: 0,0:12:29.50,0:12:31.50,Default,,0,0,0,,Қорықпаңыздар, біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:12:31.50,0:12:32.50,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:12:32.50,0:12:35.50,Default,,0,0,0,,Енді мен осындамын, енді ештеңені уайымдаудың қажеті жоқ.
Dialogue: 0,0:12:35.50,0:12:37.50,Default,,0,0,0,,Бұл мен
Dialogue: 0,0:12:37.50,0:12:39.50,Default,,0,0,0,,Мен Тада-кунның құрбысымын.
Dialogue: 0,0:12:39.50,0:12:41.50,Default,,0,0,0,,Дұрыс және мінсіз
Dialogue: 0,0:12:41.50,0:12:43.50,Default,,0,0,0,,Мен саған бәрін дайындаймын.
Dialogue: 0,0:12:45.50,0:12:47.50,Default,,0,0,0,,Бір сәт сөйлесейік.
Dialogue: 0,0:12:47.50,0:12:49.50,Default,,0,0,0,,Сіз сөйлеуіңіз керек
Dialogue: 0,0:12:49.50,0:12:51.50,Default,,0,0,0,,Мен бұл клубты алдым.
Dialogue: 0,0:12:51.50,0:12:53.50,Default,,0,0,0,,Жоқ, мен оны алдым.
Dialogue: 0,0:12:53.50,0:12:55.50,Default,,0,0,0,,Келесі мен үйленемін.
Dialogue: 0,0:12:55.50,0:12:57.50,Default,,0,0,0,,Жоқ, мен үйленемін.
Dialogue: 0,0:12:59.50,0:13:01.50,Default,,0,0,0,,Балалар, биыл келдіңдер ме?
Dialogue: 0,0:13:04.50,0:13:06.50,Default,,0,0,0,,Бұл шынымен де әзіл.
Dialogue: 0,0:13:06.50,0:13:08.50,Default,,0,0,0,,Мен алдау біраз қызық деп ойладым.
Dialogue: 0,0:13:08.50,0:13:10.50,Default,,0,0,0,,Мен сонда барып көрдім.
Dialogue: 0,0:13:10.50,0:13:11.50,Default,,0,0,0,,Өйткені
Dialogue: 0,0:13:11.50,0:13:14.50,Default,,0,0,0,,Менің Тадакун мені алдауы мүмкін емес.
Dialogue: 0,0:13:16.50,0:13:18.50,Default,,0,0,0,,Тада-кун мені шынымен жақсы көреді.
Dialogue: 0,0:13:18.50,0:13:20.50,Default,,0,0,0,,Әрине, мен мұны түсінемін.
Dialogue: 0,0:13:22.50,0:13:24.50,Default,,0,0,0,,Сүйіктім
Dialogue: 0,0:13:24.50,0:13:26.50,Default,,0,0,0,,Мен бұған толық сенімдімін
Dialogue: 0,0:13:26.50,0:13:28.50,Default,,0,0,0,,Бұл мені одан сайын күштірек етеді.
Dialogue: 0,0:13:28.50,0:13:30.50,Default,,0,0,0,,Сүйікті және қуаттандырылған
Dialogue: 0,0:13:30.50,0:13:32.50,Default,,0,0,0,,Жақсы жолмен жүру
Dialogue: 0,0:13:32.50,0:13:34.50,Default,,0,0,0,,Мені одан да жақсы сезіну
Dialogue: 0,0:13:34.50,0:13:36.50,Default,,0,0,0,,Бұл қайта-қайта болды.
Dialogue: 0,0:13:36.50,0:13:38.50,Default,,0,0,0,,Тада-кун
Dialogue: 0,0:13:38.50,0:13:40.50,Default,,0,0,0,,Сіз дәл қазір өте байсалды көріндіңіз.
Dialogue: 0,0:13:42.50,0:13:44.50,Default,,0,0,0,,Шынымен, тоқтатыңыз.
Dialogue: 0,0:13:44.50,0:13:46.50,Default,,0,0,0,,Мен бір сәт қатты қорықтым.
Dialogue: 0,0:13:46.50,0:13:48.50,Default,,0,0,0,,Бұл менің қиялым ғана
Dialogue: 0,0:13:48.50,0:13:50.50,Default,,0,0,0,,Бірақ мен білмедім
Dialogue: 0,0:13:50.50,0:13:52.50,Default,,0,0,0,,Нана-сан Тада-кунның көршісі болды, солай ма?
Dialogue: 0,0:13:52.50,0:13:56.50,Default,,0,0,0,,Оның үстіне ол Линда-сенпайды да білетін.
Dialogue: 0,0:13:58.50,0:14:00.50,Default,,0,0,0,,Маған неге айтпадың?
Dialogue: 0,0:14:00.50,0:14:04.50,Default,,0,0,0,,Ғашықтар арасында сыр жоқ.
Dialogue: 0,0:14:04.50,0:14:06.50,Default,,0,0,0,,Мен оны жасырған сияқты емеспін.
Dialogue: 0,0:14:06.50,0:14:10.50,Default,,0,0,0,,Мен сөйлесуді ұмытып кетіппін.
Dialogue: 0,0:14:10.50,0:14:12.50,Default,,0,0,0,,Мен сені кешіремін
Dialogue: 0,0:14:12.50,0:14:14.50,Default,,0,0,0,,Линда Сенпай
Dialogue: 0,0:14:14.50,0:14:16.50,Default,,0,0,0,,Тағы да рахмет
Dialogue: 0,0:14:16.50,0:14:18.50,Default,,0,0,0,,Менің бос балапаным
Dialogue: 0,0:14:18.50,0:14:20.50,Default,,0,0,0,,Басқарғаныңызға рахмет
Dialogue: 0,0:14:20.50,0:14:22.50,Default,,0,0,0,,Мен қыз ретінде шын ризамын.
Dialogue: 0,0:14:24.50,0:14:26.50,Default,,0,0,0,,Сіз қорқыныштысыз
Dialogue: 0,0:14:26.50,0:14:28.50,Default,,0,0,0,,Бұл көп жөндеу.
Dialogue: 0,0:14:28.50,0:14:30.50,Default,,0,0,0,,Сіздің жоғарыда айтқаныңыз мүлде басқа, солай емес пе?
Dialogue: 0,0:14:30.50,0:14:32.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:32.50,0:14:34.50,Default,,0,0,0,,Бұрын
Dialogue: 0,0:14:34.50,0:14:36.50,Default,,0,0,0,,Алдау! Алдау! Алдау!
Dialogue: 0,0:14:36.50,0:14:38.50,Default,,0,0,0,,Тада-кун мені алдап жатыр!
Dialogue: 0,0:14:38.50,0:14:40.50,Default,,0,0,0,,Бұл сөзсіз алдау!
Dialogue: 0,0:14:40.50,0:14:42.50,Default,,0,0,0,,Сен мені алдадың, солай ма?
Dialogue: 0,0:14:42.50,0:14:44.50,Default,,0,0,0,,Сондықтан бізді де әкелді.
Dialogue: 0,0:14:44.50,0:14:46.50,Default,,0,0,0,,Мені бас!
Dialogue: 0,0:14:46.50,0:14:48.50,Default,,0,0,0,,Төтенше жағдайда күшпен ұстаңыз!
Dialogue: 0,0:14:48.50,0:14:50.50,Default,,0,0,0,,Бір нәрсе айтыңыз
Dialogue: 0,0:14:50.50,0:14:52.50,Default,,0,0,0,,Жүріңдер, келіңдер.
Dialogue: 0,0:14:52.50,0:14:54.50,Default,,0,0,0,,Мен 3D форматын түсінбеймін.
Dialogue: 0,0:14:54.50,0:14:56.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:56.50,0:14:58.50,Default,,0,0,0,,Үш өлшем?
Dialogue: 0,0:14:58.50,0:15:00.50,Default,,0,0,0,,А, иә
Dialogue: 0,0:15:00.50,0:15:02.50,Default,,0,0,0,,Мен 3D атауынан бас тартқандықтан, мен өзімді 2D-kun деп атаймын.
Dialogue: 0,0:15:02.50,0:15:04.50,Default,,0,0,0,,Шын аты Такатани Сато
Dialogue: 0,0:15:04.50,0:15:06.50,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:06.50,0:15:08.50,Default,,0,0,0,,Сәлемдесу
Dialogue: 0,0:15:08.50,0:15:10.50,Default,,0,0,0,,Тадабанди мен Коуко-чан сияқты екінші жылы бонус
Dialogue: 0,0:15:10.50,0:15:12.50,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:15:12.50,0:15:14.50,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:15:14.50,0:15:16.50,Default,,0,0,0,,А, мен бақыттымын.
Dialogue: 0,0:15:16.50,0:15:18.50,Default,,0,0,0,,Тік байланыс алғаш рет орнатылды
Dialogue: 0,0:15:18.50,0:15:20.50,Default,,0,0,0,,Аға Лин
Dialogue: 0,0:15:20.50,0:15:22.50,Default,,0,0,0,,Үш өлшемді нәрсе үшін мені кешіріңіз.
Dialogue: 0,0:15:22.50,0:15:24.50,Default,,0,0,0,,Не?
Dialogue: 0,0:15:24.50,0:15:26.50,Default,,0,0,0,,Үшінші өлшем – ауру
Dialogue: 0,0:15:26.50,0:15:28.50,Default,,0,0,0,,Негізі мен ақымақпын.
Dialogue: 0,0:15:28.50,0:15:30.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:30.50,0:15:32.50,Default,,0,0,0,,Ол қалыпты көрінеді, бірақ оның үлкен иллюзия әдеті бар.
Dialogue: 0,0:15:32.50,0:15:34.50,Default,,0,0,0,,Бейшара, не айтып тұрғанын өзі де білмейді.
Dialogue: 0,0:15:34.50,0:15:38.50,Default,,0,0,0,,Ақымақ болма.
Dialogue: 0,0:15:38.50,0:15:40.50,Default,,0,0,0,,Көбінесе менімен бірге келуді талап ететін өзіңсің.
Dialogue: 0,0:15:40.50,0:15:42.50,Default,,0,0,0,,Бізде сабаққа да немқұрайлы қараудан басқа амал қалмады.
Dialogue: 0,0:15:42.50,0:15:44.50,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:15:44.50,0:15:46.50,Default,,0,0,0,,Үйге қайтайық?
Dialogue: 0,0:15:46.50,0:15:48.50,Default,,0,0,0,,Кіреберіс сол жақта.
Dialogue: 0,0:15:48.50,0:15:50.50,Default,,0,0,0,,Үш өлшемді Готголм
Dialogue: 0,0:15:50.50,0:15:52.50,Default,,0,0,0,,Сіз
Dialogue: 0,0:15:52.50,0:15:54.50,Default,,0,0,0,,Бұл жерде ұрыспаңыз.
Dialogue: 0,0:15:54.50,0:15:56.50,Default,,0,0,0,,Айтайын дегенім, ауырған адамның көзінше олай шу шығарма.
Dialogue: 0,0:15:56.50,0:15:58.50,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:58.50,0:16:00.50,Default,,0,0,0,,Бірақ бұл жігіт
Dialogue: 0,0:16:00.50,0:16:02.50,Default,,0,0,0,,Кешіріңіз Тада-кун
Dialogue: 0,0:16:02.50,0:16:04.50,Default,,0,0,0,,Менің айтайын дегенім, бұл рас.
Dialogue: 0,0:16:04.50,0:16:06.50,Default,,0,0,0,,Мен бұл алдау деп ойламаймын.
Dialogue: 0,0:16:06.50,0:16:08.50,Default,,0,0,0,,Бірақ мен не айта аламын?
Dialogue: 0,0:16:08.50,0:16:10.50,Default,,0,0,0,,Менен басқа қыз
Dialogue: 0,0:16:10.50,0:16:12.50,Default,,0,0,0,,Алдымен Тада-кун ауырып қалды.
Dialogue: 0,0:16:12.50,0:16:14.50,Default,,0,0,0,,Мен асықтым
Dialogue: 0,0:16:14.50,0:16:16.50,Default,,0,0,0,,Менің ренжігенімді жоққа шығаруға болмайды.
Dialogue: 0,0:16:18.50,0:16:20.50,Default,,0,0,0,,Бұл жағдайда мен өзімнен гөрі Жеті аға үшін дағдарыс сезімін сезінемін.
Dialogue: 0,0:16:20.50,0:16:22.50,Default,,0,0,0,,Мен сені ұстауым керек
Dialogue: 0,0:16:22.50,0:16:24.50,Default,,0,0,0,,Өйткені, Тада Банриді бірінші болып құтқарған адам болды
Dialogue: 0,0:16:24.50,0:16:26.50,Default,,0,0,0,,Себебі мен жетінші жоғары сыныппын.
Dialogue: 0,0:16:26.50,0:16:28.50,Default,,0,0,0,,Сол жеті қария қандай адамдар?
Dialogue: 0,0:16:28.50,0:16:30.50,Default,,0,0,0,,Хмм.
Dialogue: 0,0:16:30.50,0:16:32.50,Default,,0,0,0,,Мұндай адам
Dialogue: 0,0:16:32.50,0:16:34.50,Default,,0,0,0,,Бұл өте қорқынышты
Dialogue: 0,0:16:34.50,0:16:36.50,Default,,0,0,0,,Бірақ ол шынымен де осылай көрінеді.
Dialogue: 0,0:16:36.50,0:16:38.50,Default,,0,0,0,,Ұқсас
Dialogue: 0,0:16:38.50,0:16:40.50,Default,,0,0,0,,Осындай нәрсе
Dialogue: 0,0:16:44.50,0:16:46.50,Default,,0,0,0,,Жазғы демалыс
Dialogue: 0,0:16:46.50,0:16:48.50,Default,,0,0,0,,Сіз бір жерге барасыз ба?
Dialogue: 0,0:16:48.50,0:16:50.50,Default,,0,0,0,,Мен бұл туралы әлі ойлаған жоқпын.
Dialogue: 0,0:16:50.50,0:16:52.50,Default,,0,0,0,,Линда-сенпай
Dialogue: 0,0:16:52.50,0:16:54.50,Default,,0,0,0,,Сіздің жоспарыңыз бар ма?
Dialogue: 0,0:16:54.50,0:16:56.50,Default,,0,0,0,,Шетелге саяхаттау және т.б.
Dialogue: 0,0:16:56.50,0:16:58.50,Default,,0,0,0,,Шетелге шығатын ақшам жоқ
Dialogue: 0,0:16:58.50,0:17:00.50,Default,,0,0,0,,Мен саяхаттағым келеді
Dialogue: 0,0:17:00.50,0:17:02.50,Default,,0,0,0,,Бонустық әрекеттер және
Dialogue: 0,0:17:02.50,0:17:04.50,Default,,0,0,0,,Мен үйге барып, достарыммен ойнайтын шығармын.
Dialogue: 0,0:17:04.50,0:17:06.50,Default,,0,0,0,,О.
Dialogue: 0,0:17:06.50,0:17:08.50,Default,,0,0,0,,Ата-анаңның үйі осында емес пе?
Dialogue: 0,0:17:08.50,0:17:10.50,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:17:10.50,0:17:12.50,Default,,0,0,0,,Дәлірек айтсақ, теңіз
Dialogue: 0,0:17:12.50,0:17:14.50,Default,,0,0,0,,Бұл теңіз ғой.
Dialogue: 0,0:17:14.50,0:17:16.50,Default,,0,0,0,,Балалар, бұл туралы жоспарларыңыз жоқ па?
Dialogue: 0,0:17:16.50,0:17:18.50,Default,,0,0,0,,Біз бәріміз мұхит сияқтымыз
Dialogue: 0,0:17:18.50,0:17:20.50,Default,,0,0,0,,Керемет, мен Умичоға барғым келеді.
Dialogue: 0,0:17:20.50,0:17:22.50,Default,,0,0,0,,Менің лицензиям бар.
Dialogue: 0,0:17:22.50,0:17:24.50,Default,,0,0,0,,Бәріміз көлік жалдап, бірге барсақ қызық болар еді.
Dialogue: 0,0:17:24.50,0:17:26.50,Default,,0,0,0,,Дәлірек айтқанда
Dialogue: 0,0:17:26.50,0:17:28.50,Default,,0,0,0,,Осы көрініспен жүрейік
Dialogue: 0,0:17:28.50,0:17:30.50,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:30.50,0:17:32.50,Default,,0,0,0,,Линда-сенпай да менімен бірге.
Dialogue: 0,0:17:32.50,0:17:34.50,Default,,0,0,0,,Мені де кіргізесің бе?
Dialogue: 0,0:17:34.50,0:17:36.50,Default,,0,0,0,,Мочиссу
Dialogue: 0,0:17:36.50,0:17:38.50,Default,,0,0,0,,Орта мектепте тек қыздардың болуы өте қызықсыз.
Dialogue: 0,0:17:38.50,0:17:40.50,Default,,0,0,0,,Олай болса Нана-сенпайды да шақырайық.
Dialogue: 0,0:17:40.50,0:17:42.50,Default,,0,0,0,,Нана-сенпайға
Dialogue: 0,0:17:42.50,0:17:44.50,Default,,0,0,0,,Теңізде жақсы көрінбейді.
Dialogue: 0,0:17:44.50,0:17:46.50,Default,,0,0,0,,Дәлірек айтқанда, осында
Dialogue: 0,0:17:46.50,0:17:48.50,Default,,0,0,0,,Мен де Ока-чанмен сөйлесуім керек.
Dialogue: 0,0:17:48.50,0:17:50.50,Default,,0,0,0,,Мен саған өткен күні уәде бердім.
Dialogue: 0,0:17:50.50,0:17:52.50,Default,,0,0,0,,УЗИге шақырсақ, орындар аз болмай ма?
Dialogue: 0,0:17:52.50,0:17:54.50,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:17:54.50,0:17:56.50,Default,,0,0,0,,Үлкен көлікті жалға алсаңыз, проблема жоқ
Dialogue: 0,0:17:56.50,0:17:58.50,Default,,0,0,0,,УДЗ деген кім?
Dialogue: 0,0:17:58.50,0:18:00.50,Default,,0,0,0,,Мичио маған бұрын да мойындаған.
Dialogue: 0,0:18:00.50,0:18:02.50,Default,,0,0,0,,Асығып шайқалады
Dialogue: 0,0:18:02.50,0:18:04.50,Default,,0,0,0,,Олай айтпа
Dialogue: 0,0:18:18.50,0:18:20.50,Default,,0,0,0,,Кагава мырза
Dialogue: 0,0:18:22.50,0:18:24.50,Default,,0,0,0,,Сіз ояндыңыз ба?
Dialogue: 0,0:18:24.50,0:18:26.50,Default,,0,0,0,,Мен ұйықтап қалдым ба?
Dialogue: 0,0:18:28.50,0:18:30.50,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:18:30.50,0:18:32.50,Default,,0,0,0,,Сәл жақсы
Dialogue: 0,0:18:32.50,0:18:34.50,Default,,0,0,0,,Барлығы ше?
Dialogue: 0,0:18:34.50,0:18:36.50,Default,,0,0,0,,Түске таман қайтып келдім.
Dialogue: 0,0:18:36.50,0:18:38.50,Default,,0,0,0,,Мен түстен кейінгі сабағыма уақытында келемін.
Dialogue: 0,0:18:38.50,0:18:40.50,Default,,0,0,0,,Осы уақыт бойы Кагава мырза сізбен бірге болды ма?
Dialogue: 0,0:18:40.50,0:18:42.50,Default,,0,0,0,,Иә
Dialogue: 0,0:18:42.50,0:18:44.50,Default,,0,0,0,,Сізге бірдеңе керек пе? Сіз су алғыңыз келе ме?
Dialogue: 0,0:18:44.50,0:18:46.50,Default,,0,0,0,,Жоқ, жақсы
Dialogue: 0,0:18:48.50,0:18:50.50,Default,,0,0,0,,Кагава-сан, сен уақытты ойлайсың ба?
Dialogue: 0,0:18:50.50,0:18:52.50,Default,,0,0,0,,Жер
Dialogue: 0,0:18:52.50,0:18:54.50,Default,,0,0,0,,Сіз ештеңе жеген жоқсыз, солай ма?
Dialogue: 0,0:18:54.50,0:18:56.50,Default,,0,0,0,,Себебі мен Ринда-сенпай сатып алған нанды жедім.
Dialogue: 0,0:19:00.50,0:19:02.50,Default,,0,0,0,,Кешіріңіз, Тада-кун.
Dialogue: 0,0:19:02.50,0:19:04.50,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:19:04.50,0:19:06.50,Default,,0,0,0,,Ауырып қалсаң бәріміз жиналайық
Dialogue: 0,0:19:06.50,0:19:08.50,Default,,0,0,0,,Мен тіпті науқасқа дұрыс қарай алмаймын.
Dialogue: 0,0:19:08.50,0:19:10.50,Default,,0,0,0,,Осындай шу шығару
Dialogue: 0,0:19:10.50,0:19:12.50,Default,,0,0,0,,Сен мүлде демалмадың.
Dialogue: 0,0:19:14.50,0:19:16.50,Default,,0,0,0,,Келмегенің жақсы болар еді.
Dialogue: 0,0:19:18.50,0:19:20.50,Default,,0,0,0,,Бұл дұрыс емес
Dialogue: 0,0:19:20.50,0:19:22.50,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:19:22.50,0:19:24.50,Default,,0,0,0,,Найтеба
Dialogue: 0,0:19:24.50,0:19:26.50,Default,,0,0,0,,Бар
Dialogue: 0,0:19:30.50,0:19:32.50,Default,,0,0,0,,Мен жақсы қыз болғым келеді.
Dialogue: 0,0:19:32.50,0:19:34.50,Default,,0,0,0,,Мен мұны жақсы орындай алмаймын.
Dialogue: 0,0:19:34.50,0:19:36.50,Default,,0,0,0,,Мен сияқты ебедейсіз адам
Dialogue: 0,0:19:36.50,0:19:38.50,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:19:38.50,0:19:40.50,Default,,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 0,0:19:40.50,0:19:42.50,Default,,0,0,0,,Бар ма?
Dialogue: 0,0:19:42.50,0:19:44.50,Default,,0,0,0,,Әйтеуір бүгін
Dialogue: 0,0:19:44.50,0:19:46.50,Default,,0,0,0,,Мен бұл туралы шынымен ойладым.
Dialogue: 0,0:19:46.50,0:19:48.50,Default,,0,0,0,,Менен осылай
Dialogue: 0,0:19:48.50,0:19:50.50,Default,,0,0,0,,Ринда-сенпайға ұнайтын адамдар
Dialogue: 0,0:19:52.50,0:19:54.50,Default,,0,0,0,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,0:20:02.50,0:20:04.50,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:20:04.50,0:20:06.50,Default,,0,0,0,,О
Dialogue: 0,0:20:06.50,0:20:08.50,Default,,0,0,0,,Эй, бұл Кагава-сан.
Dialogue: 0,0:20:08.50,0:20:10.50,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:20:10.50,0:20:12.50,Default,,0,0,0,,Өміріңде —
Dialogue: 0,0:20:12.50,0:20:14.50,Default,,0,0,0,,Марс емделген жоқ па?
Dialogue: 0,0:20:14.50,0:20:16.50,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:20:16.50,0:20:18.50,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:20:18.50,0:20:20.50,Default,,0,0,0,,Егер сіз суық тиіп қалсаңыз
Dialogue: 0,0:20:20.50,0:20:22.50,Default,,0,0,0,,Мен саған қонаққа келе алмаймын.
Dialogue: 0,0:20:24.50,0:20:26.50,Default,,0,0,0,,Әлі ыстық, солай емес пе?
Dialogue: 0,0:20:28.50,0:20:30.50,Default,,0,0,0,,Мен жалғыз тұрамын, қызуым осындай.
Dialogue: 0,0:20:30.50,0:20:32.50,Default,,0,0,0,,Бұл мені алаңдатады.
Dialogue: 0,0:20:36.50,0:20:38.50,Default,,0,0,0,,Бірақ мен сенің жаныңдамын
Dialogue: 0,0:20:38.50,0:20:40.50,Default,,0,0,0,,Мен ештеңе істей алмаймын, бұл жақсы емес.
Dialogue: 0,0:20:40.50,0:20:42.50,Default,,0,0,0,,Ол жаман дос қыз
Dialogue: 0,0:20:42.50,0:20:44.50,Default,,0,0,0,,Тек махаббат бәрінен де көп
Dialogue: 0,0:20:44.50,0:20:46.50,Default,,0,0,0,,Сіз не істей аласыз
Dialogue: 0,0:20:46.50,0:20:48.50,Default,,0,0,0,,Мен бәрін істеймін
Dialogue: 0,0:20:50.50,0:20:52.50,Default,,0,0,0,,Эй, Тада-кун
Dialogue: 0,0:20:52.50,0:20:54.50,Default,,0,0,0,,Мен қазір
Dialogue: 0,0:20:54.50,0:20:56.50,Default,,0,0,0,,Мен ойладым
Dialogue: 0,0:20:56.50,0:20:58.50,Default,,0,0,0,,Менің теңізге барғым келеді
Dialogue: 0,0:20:58.50,0:21:00.50,Default,,0,0,0,,Барлығымен емес
Dialogue: 0,0:21:00.50,0:21:02.50,Default,,0,0,0,,Тадакун екеуміз
Dialogue: 0,0:21:04.50,0:21:06.50,Default,,0,0,0,,Өзіңізді жақсы сезінген кезде
Dialogue: 0,0:21:06.50,0:21:08.50,Default,,0,0,0,,Мені аласың ба?
Dialogue: 0,0:21:08.50,0:21:10.50,Default,,0,0,0,,Осылай болмас еді...
Dialogue: 0,0:21:10.50,0:21:12.50,Default,,0,0,0,,Менімен барғың келе ме?
Dialogue: 0,0:21:12.50,0:21:14.50,Default,,0,0,0,,Иә
Dialogue: 0,0:21:14.50,0:21:16.50,Default,,0,0,0,,Менің барғым келеді
Dialogue: 0,0:21:16.50,0:21:18.50,Default,,0,0,0,,Бұл Париж болуы міндетті емес
Dialogue: 0,0:21:18.50,0:21:20.50,Default,,0,0,0,,Мен сенімен жағажайға барғым келеді.
Dialogue: 0,0:21:20.50,0:21:22.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:22.50,0:21:24.50,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:21:28.50,0:21:30.50,Default,,0,0,0,,Теңізге барайық
Dialogue: 0,0:21:30.50,0:21:32.50,Default,,0,0,0,,Екеуміз ғана
Dialogue: 0,0:21:32.50,0:21:34.50,Default,,0,0,0,,Осылай болмас еді...
Dialogue: 0,0:21:34.50,0:21:36.50,Default,,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:21:36.50,0:21:38.50,Default,,0,0,0,,Жазғы демалыс келгенде
Dialogue: 0,0:21:38.50,0:21:40.50,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:21:40.50,0:21:42.50,Default,,0,0,0,,Мен Таданы теңізге апарамын.
Dialogue: 0,0:21:42.50,0:21:44.50,Default,,0,0,0,,Иә
Dialogue: 0,0:21:44.50,0:21:46.50,Default,,0,0,0,,Уәде.
Dialogue: 0,0:21:46.50,0:21:48.50,Default,,0,0,0,,Иә
Dialogue: 0,0:21:48.50,0:21:50.50,Default,,0,0,0,,Сен сияқты — олардың әрқайсысы.
Dialogue: 0,0:22:06.50,0:22:08.50,Default,,0,0,0,,Мен Тада-кунмен жағажайға барғым келеді.
Dialogue: 0,0:22:08.50,0:22:10.50,Default,,0,0,0,,Барлығымен бірге болуы міндетті емес.
Dialogue: 0,0:22:10.50,0:22:34.50,Default,,0,0,0,,Мен Тада-кунмен жағажайға барғым келеді.
Dialogue: 0,0:22:36.50,0:22:44.50,Default,,0,0,0,,Мен Тада-кунмен жағажайға барғым келеді.
Dialogue: 0,0:22:44.50,0:22:46.50,Default,,0,0,0,,Мен Тада-кунмен жағаға барғым келеді.
Dialogue: 0,0:22:46.50,0:23:00.50,Default,,0,0,0,,Мен Тада-кунмен жағажайға барғым келеді.
Dialogue: 0,0:23:00.50,0:23:02.50,Default,,0,0,0,,Сол күйінде қалуға болмайды
Dialogue: 0,0:23:02.50,0:23:04.50,Default,,0,0,0,,Менің қолдарым солай
Dialogue: 0,0:23:04.50,0:23:10.50,Default,,0,0,0,,Тартуды жалғастырыңыз
Dialogue: 0,0:23:30.50,0:23:32.50,Default,,0,0,0,,Жараны біреу жұдырықпен ұрған шығар.
Dialogue: 0,0:23:32.50,0:23:34.50,Default,,0,0,0,,Амал жоқ, менен, менен
Dialogue: 0,0:23:34.50,0:23:35.30,Default,,0,0,0,,Сеттамаре
Dialogue: 0,0:23:35.30,0:23:36.00,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:23:36.00,0:23:37.50,Default,,0,0,0,,Сеттамаре, мен сені өлтіремін.
Dialogue: 0,0:23:37.50,0:23:38.50,Default,,0,0,0,,Әй, Нана-сенпай
Dialogue: 0,0:23:38.50,0:23:40.50,Default,,0,0,0,,Судың иісі, дәлірек айтсақ, жиіркенішті иісі бар.
Dialogue: 0,0:23:42.00,0:23:47.00,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
