Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:07.00,Default,,0,0,0,,Бірақ, әйтеуір, бұл мен де Мен мұнда келгеннен бері
Dialogue: 0,0:00:08.00,0:00:11.00,Default,,0,0,0,,Мен өзімді мөлдір болып кеткендей сезінемін.
Dialogue: 0,0:00:17.00,0:00:18.00,Default,,0,0,0,,Қара-сан
Dialogue: 0,0:00:18.00,0:00:20.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:00:20.00,0:00:24.00,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:00:25.00,0:00:27.00,Default,,0,0,0,,Қара-сан
Dialogue: 0,0:00:27.00,0:00:29.00,Default,,0,0,0,,Сәлем Тада-кун
Dialogue: 0,0:00:29.00,0:00:31.00,Default,,0,0,0,,Сіздің аға буыныңыз кім?
Dialogue: 0,0:00:31.00,0:00:32.00,Default,,0,0,0,,Өміріңде —
Dialogue: 0,0:00:32.00,0:00:35.00,Default,,0,0,0,,Уақыт жақындап қалды.
Dialogue: 0,0:00:35.00,0:00:38.00,Default,,0,0,0,,Тада-кун, сен Мицуоға бүгінгі күнді айттың ба?
Dialogue: 0,0:00:38.00,0:00:40.00,Default,,0,0,0,,Мен сізге электрондық пошта арқылы айттым.
Dialogue: 0,0:00:40.00,0:00:43.00,Default,,0,0,0,,Бұл менің жаңа ғана алған жауабым.
Dialogue: 0,0:00:44.00,0:00:47.00,Default,,0,0,0,,Мен өзім туралы алаңдаймын.
Dialogue: 0,0:00:50.00,0:00:51.00,Default,,0,0,0,,Сәлем?
Dialogue: 0,0:00:51.00,0:00:52.00,Default,,0,0,0,,Тадабанри
Dialogue: 0,0:00:52.00,0:00:53.00,Default,,0,0,0,,Нижиген-кун?
Dialogue: 0,0:00:55.00,0:00:57.00,Default,,0,0,0,,Не? Бұл оқу-жаттығу жиынының кездесу нүктесі ме?
Dialogue: 0,0:00:57.00,0:00:59.00,Default,,0,0,0,,Нижиген-кун
Dialogue: 0,0:00:59.00,0:01:01.00,Default,,0,0,0,,Екінші храмға дейінгі Мэйдзи кезеңі ме?
Dialogue: 0,0:01:01.00,0:01:03.00,Default,,0,0,0,,А, мен сені таныстырамын.
Dialogue: 0,0:01:03.00,0:01:06.00,Default,,0,0,0,,Біз өткен күні Сатоның жаңа ғимаратында кездестік.
Dialogue: 0,0:01:07.00,0:01:08.00,Default,,0,0,0,,Иә, мм.
Dialogue: 0,0:01:08.00,0:01:10.00,Default,,0,0,0,,Амансың ба? Ниджиген-кун
Dialogue: 0,0:01:10.00,0:01:13.00,Default,,0,0,0,,F Бұл ғылыми орта мектеп, солай ма?
Dialogue: 0,0:01:13.00,0:01:16.00,Default,,0,0,0,,Мен оны азаматтық құқық сабағында көрдім.
Dialogue: 0,0:01:16.00,0:01:18.00,Default,,0,0,0,,Иә, бұл ғылыми орта мектеп.
Dialogue: 0,0:01:18.00,0:01:20.00,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:01:20.00,0:01:23.00,Default,,0,0,0,,Менің шын атым Такатани Сато.
Dialogue: 0,0:01:23.00,0:01:27.00,Default,,0,0,0,,Нидзиген-кун — Сатоның кешінде оған берілген есім.
Dialogue: 0,0:01:27.00,0:01:28.00,Default,,0,0,0,,Иә, иә, иә
Dialogue: 0,0:01:28.00,0:01:30.00,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:01:30.00,0:01:32.00,Default,,0,0,0,,Барлығы жиналды
Dialogue: 0,0:01:32.00,0:01:35.00,Default,,0,0,0,,2 түн 3 күн Бұл оқу-жаттығу жиынының басы.
Dialogue: 0,0:01:35.00,0:01:36.00,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:01:36.00,0:01:38.00,Default,,0,0,0,,Әзірге барлығы
Dialogue: 0,0:01:38.00,0:01:42.00,Default,,0,0,0,,Осы жерге аты-жөніңізді, мекенжайыңызды және байланыс телефоныңызды жазыңыз.
Dialogue: 0,0:01:42.00,0:01:45.00,Default,,0,0,0,,Аа, көлікте жазуға болады, сондықтан алдымен көлікке отыр.
Dialogue: 0,0:01:45.00,0:01:48.00,Default,,0,0,0,,Біз кестеден кешігіп қалдық, сондықтан асығуымыз керек.
Dialogue: 0,0:01:48.00,0:01:50.00,Default,,0,0,0,,Иә, сіз осы көліктесіз.
Dialogue: 0,0:01:50.00,0:01:52.00,Default,,0,0,0,,Иә, сіз осындасыз.
Dialogue: 0,0:01:52.00,0:01:54.00,Default,,0,0,0,,Иә, сен солайсың.
Dialogue: 0,0:02:20.00,0:02:23.00,Default,,0,0,0,,Мен қайдамын?
Dialogue: 0,0:02:23.00,0:02:26.00,Default,,0,0,0,,Ересек болу қиын.
Dialogue: 0,0:02:26.00,0:02:29.00,Default,,0,0,0,,Мен оны әзірше ұмыта аламын ба?
Dialogue: 0,0:02:29.00,0:02:32.00,Default,,0,0,0,,Өйткені түн күтіп тұр
Dialogue: 0,0:02:32.00,0:02:35.00,Default,,0,0,0,,Жүрегіңді соғу
Dialogue: 0,0:02:35.00,0:02:39.00,Default,,0,0,0,,Кездесетін кезде көңілді болсак
Dialogue: 0,0:02:39.00,0:02:41.00,Default,,0,0,0,,Мен сізге айтқым келеді
Dialogue: 0,0:02:41.00,0:02:43.00,Default,,0,0,0,,Енді менің ойымда
Dialogue: 0,0:02:43.00,0:02:46.00,Default,,0,0,0,,Мен байқайтын сияқтымын
Dialogue: 0,0:02:46.00,0:02:50.00,Default,,0,0,0,,Өткен және болашақ Қорықсаң да
Dialogue: 0,0:02:50.00,0:02:54.00,Default,,0,0,0,,Бос болса қозғала алмайды
Dialogue: 0,0:02:54.00,0:02:58.00,Default,,0,0,0,,Ләззат алсаң, бәрі жақсы
Dialogue: 0,0:02:58.00,0:03:00.00,Default,,0,0,0,,Бастайық
Dialogue: 0,0:03:00.00,0:03:04.00,Default,,0,0,0,,Барлық жаман нәрселерді ұмытыңыз
Dialogue: 0,0:03:04.00,0:03:07.00,Default,,0,0,0,,Мен сенімен түнде билесем
Dialogue: 0,0:03:07.00,0:03:10.00,Default,,0,0,0,,Өзіңіздің жақсырақ нұсқасы болыңыз
Dialogue: 0,0:03:11.00,0:03:14.00,Default,,0,0,0,,Өзіңіздің жақсырақ нұсқасы болыңыз
Dialogue: 0,0:03:14.00,0:03:18.00,Default,,0,0,0,,Мен солай сезінемін.
Dialogue: 0,0:03:18.00,0:03:21.00,Default,,0,0,0,,Ешқашан бітпейтін мазмұн уақыты
Dialogue: 0,0:03:21.00,0:03:24.00,Default,,0,0,0,,Сен екеуміздің арамыз жақындап барады
Dialogue: 0,0:03:24.00,0:03:26.00,Default,,0,0,0,,Соқпа және кетпе
Dialogue: 0,0:03:26.00,0:03:31.00,Default,,0,0,0,,Айналма жол болса да қадірлегім келеді
Dialogue: 0,0:03:31.00,0:03:34.00,Default,,0,0,0,,Бүгін ауа райы жақсы болғанына қуаныштымын.
Dialogue: 0,0:03:34.00,0:03:37.00,Default,,0,0,0,,Әй, бірдеңе ішкің келсе, бар.
Dialogue: 0,0:03:37.00,0:03:39.00,Default,,0,0,0,,А, бірақ мен үзіліссіз барамын.
Dialogue: 0,0:03:39.00,0:03:42.00,Default,,0,0,0,,Мен көп ішу керек емес пе?
Dialogue: 0,0:03:43.00,0:03:47.00,Default,,0,0,0,,Эй, сенің атың Кагакоуко-сан.
Dialogue: 0,0:03:47.00,0:03:49.00,Default,,0,0,0,,Бұл әдемі есім.
Dialogue: 0,0:03:49.00,0:03:53.00,Default,,0,0,0,,А, иә, рахмет.
Dialogue: 0,0:03:54.00,0:03:56.00,Default,,0,0,0,,Сен неге айналаға қарап тұрсың?
Dialogue: 0,0:03:56.00,0:04:00.00,Default,,0,0,0,,A, ah, ah, ah, ah, ah, ah, ah, ah, ah, ah, ah, ah.
Dialogue: 0,0:04:00.00,0:04:02.00,Default,,0,0,0,,Сен неге айналаға қарап тұрсың?
Dialogue: 0,0:04:02.00,0:04:04.00,Default,,0,0,0,,Әй, тезірек тізімді жазып ал.
Dialogue: 0,0:04:04.00,0:04:05.00,Default,,0,0,0,,болып табылады
Dialogue: 0,0:04:19.00,0:04:22.00,Default,,0,0,0,,Мм, сіз семинар үйінен өткен жоқсыз ба?
Dialogue: 0,0:04:22.00,0:04:23.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:23.00,0:04:26.00,Default,,0,0,0,,Сіз менің университетімнің семинар үйінің жанынан өттіңіз бе?
Dialogue: 0,0:04:26.00,0:04:28.00,Default,,0,0,0,,О, мен оны естімеймін.
Dialogue: 0,0:04:28.00,0:04:30.00,Default,,0,0,0,,Менің университетім
Dialogue: 0,0:04:30.00,0:04:33.00,Default,,0,0,0,,Дәлірек айтсақ, қытықтайды.
Dialogue: 0,0:04:41.00,0:04:43.00,Default,,0,0,0,,Бұл қай жерде?
Dialogue: 0,0:04:43.00,0:04:46.00,Default,,0,0,0,,Біз жақындап қалдық, түсуге дайындал.
Dialogue: 0,0:04:55.00,0:04:56.00,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:04:57.00,0:04:59.00,Default,,0,0,0,,Иә, мен тізімді жинаймын.
Dialogue: 0,0:04:59.00,0:05:01.00,Default,,0,0,0,,Иә, иә, маған жазғаныңызды беріңіз.
Dialogue: 0,0:05:05.00,0:05:06.00,Default,,0,0,0,,Кага-сан
Dialogue: 0,0:05:07.00,0:05:08.00,Default,,0,0,0,,Тада-кун
Dialogue: 0,0:05:08.00,0:05:11.00,Default,,0,0,0,,Жақсы, мен білетін адаммен сөйлесе аламын.
Dialogue: 0,0:05:13.00,0:05:17.00,Default,,0,0,0,,Бұл шынымен университеттің семинар үйі ме?
Dialogue: 0,0:05:18.00,0:05:20.00,Default,,0,0,0,,Мен ұялы телефоныма да қосыла алмаймын.
Dialogue: 0,0:05:21.00,0:05:23.00,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:05:27.00,0:05:30.00,Default,,0,0,0,,Мен ешқашан естімеген аты бар жер бар.
Dialogue: 0,0:05:30.00,0:05:33.00,Default,,0,0,0,,Бұл діни топтың оқу орны болды.
Dialogue: 0,0:05:36.00,0:05:38.00,Default,,0,0,0,,Мен заттарымды осында жинаймын.
Dialogue: 0,0:05:38.00,0:05:40.00,Default,,0,0,0,,Иә, көбірек қосуды жалғастырыңыз.
Dialogue: 0,0:05:56.00,0:06:00.00,Default,,0,0,0,,Бізге 5 сағаттан астам фильм көрсетілді.
Dialogue: 0,0:06:01.00,0:06:05.00,Default,,0,0,0,,Ғалам мен жан туралы лекциялар тыңдадым.
Dialogue: 0,0:06:16.00,0:06:20.00,Default,,0,0,0,,Сұмдық, ертеңгі күнге дейін осында тұрып қалдық.
Dialogue: 0,0:06:20.00,0:06:23.00,Default,,0,0,0,,Кәне, көңіл көтерейік.
Dialogue: 0,0:06:24.00,0:06:25.00,Default,,0,0,0,,Барлығында стақан бар
Dialogue: 0,0:06:27.00,0:06:30.00,Default,,0,0,0,,Содан кейін, жаңа балалардың оянуы және
Dialogue: 0,0:06:31.00,0:06:33.00,Default,,0,0,0,,Бүгінгі түнде тамаша толық ай және
Dialogue: 0,0:06:33.00,0:06:36.00,Default,,0,0,0,,10 000 жылдан кейінгі кездесулеріңізбен құттықтаймыз
Dialogue: 0,0:06:37.00,0:06:38.00,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:06:38.00,0:06:40.00,Default,,0,0,0,,Сәлем Нео балалары
Dialogue: 0,0:06:40.00,0:06:42.00,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:06:43.00,0:06:44.00,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:06:45.00,0:06:47.00,Default,,0,0,0,,Тізімде мекен-жай да жазылған.
Dialogue: 0,0:06:47.00,0:06:48.00,Default,,0,0,0,,Не істеу керек?
Dialogue: 0,0:06:48.00,0:06:51.00,Default,,0,0,0,,Кога мырзаны бұл жерге кім әкелді?
Dialogue: 0,0:06:51.00,0:06:53.00,Default,,0,0,0,,Бұл менің жауапкершілігім.
Dialogue: 0,0:06:53.00,0:06:56.00,Default,,0,0,0,,Біз Кага-санды аман-есен қайтаруымыз керек.
Dialogue: 0,0:06:56.00,0:06:58.00,Default,,0,0,0,,Мен не істеуім керек? Не істеуім керек?
Dialogue: 0,0:06:59.00,0:07:01.00,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:07:02.00,0:07:04.00,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:07:05.00,0:07:14.00,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:07:14.00,0:07:15.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:16.00,0:07:18.00,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:07:18.00,0:07:20.00,Default,,0,0,0,,Болашақ ғасырда 10 000 жыл нешеу?
Dialogue: 0,0:07:20.00,0:07:23.00,Default,,0,0,0,,Олар бізді жан-жақты шеңбер деп алдап жатыр.
Dialogue: 0,0:07:23.00,0:07:25.00,Default,,0,0,0,,Айтайын дегенім, бұл қамау.
Dialogue: 0,0:07:25.00,0:07:26.00,Default,,0,0,0,,Бұл қылмыс.
Dialogue: 0,0:07:26.00,0:07:29.00,Default,,0,0,0,,Сіз мұны тегін жасай аламын деп ойлайсыз ба?
Dialogue: 0,0:07:29.00,0:07:31.00,Default,,0,0,0,,Қазір көліктен түс.
Dialogue: 0,0:07:31.00,0:07:33.00,Default,,0,0,0,,Мен енді мұндай жерде қалғым келмейді.
Dialogue: 0,0:07:33.00,0:07:35.00,Default,,0,0,0,,Мен сені сотқа беремін.
Dialogue: 0,0:07:35.00,0:07:37.00,Default,,0,0,0,,Басында бәрі осылай дейді.
Dialogue: 0,0:07:37.00,0:07:39.00,Default,,0,0,0,,О, түсіндім. Ол жер жергілікті көрікті жерге айналған екен, иә?
Dialogue: 0,0:07:39.00,0:07:42.00,Default,,0,0,0,,Жақында бәрі түсінетін уақыт келеді.
Dialogue: 0,0:07:42.00,0:07:45.00,Default,,0,0,0,,Ертең күні бойы бізбен сөйлесуге кетсеңіз,
Dialogue: 0,0:07:45.00,0:07:47.00,Default,,0,0,0,,Сендердің де оянатындарыңа сенімдімін.
Dialogue: 0,0:07:47.00,0:07:49.00,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:07:50.00,0:07:52.00,Default,,0,0,0,,Кім үйге барғысы келсе, солай істеу керек.
Dialogue: 0,0:07:53.00,0:07:55.00,Default,,0,0,0,,Мен үйге барғым келмейді.
Dialogue: 0,0:07:55.00,0:07:57.00,Default,,0,0,0,,Не, не туралы айтып тұрсың?
Dialogue: 0,0:07:58.00,0:08:01.00,Default,,0,0,0,,Біреу қызықсыз сөздер айтса, мен қобалжыймын.
Dialogue: 0,0:08:01.00,0:08:03.00,Default,,0,0,0,,Оның несі ұнамайды?
Dialogue: 0,0:08:03.00,0:08:06.00,Default,,0,0,0,,Ондай бейшара жігіт осында болса да адасып кете алмайды.
Dialogue: 0,0:08:06.00,0:08:09.00,Default,,0,0,0,,Мен осында көңіл көтергім келеді.
Dialogue: 0,0:08:09.00,0:08:11.00,Default,,0,0,0,,Бос сөзді жай ғана айтпа.
Dialogue: 0,0:08:12.00,0:08:14.00,Default,,0,0,0,,Сенпай, мына жігіттер мені мазалайды.
Dialogue: 0,0:08:14.00,0:08:17.00,Default,,0,0,0,,Үйге барғың келсе, мені үйге жібер.
Dialogue: 0,0:08:18.00,0:08:22.00,Default,,0,0,0,,Мен фильмді ертерек көргенде қатты әсер еттім.
Dialogue: 0,0:08:25.00,0:08:29.00,Default,,0,0,0,,Мен үлкендерімнің айтқанын тыңдағым келеді.
Dialogue: 0,0:08:30.00,0:08:32.00,Default,,0,0,0,,шын мәнінде
Dialogue: 0,0:08:33.00,0:08:39.00,Default,,0,0,0,,Мен орта мектепте оқып жүрген кезімде жол-көлік оқиғасынан ауыр жарақат алып, барлық естеліктерім өшіп қалды.
Dialogue: 0,0:08:40.00,0:08:42.00,Default,,0,0,0,,Бұл есте сақтау қабілетінің жоғалуы деп аталады.
Dialogue: 0,0:08:42.00,0:08:47.00,Default,,0,0,0,,Мен оянғанда, мен кенеттен мен білетін ешкім жоқ әлемге тап болдым.
Dialogue: 0,0:08:48.00,0:08:52.00,Default,,0,0,0,,Менің ата-анам, досым, танысым жоқ.
Dialogue: 0,0:08:53.00,0:08:59.00,Default,,0,0,0,,Мен өзімді жалғыз сезіндім, содан бері мазасызданып, қиналып жүрмін.
Dialogue: 0,0:09:03.00,0:09:06.00,Default,,0,0,0,,Бұл қиын болды, бірақ мен енді бұл туралы алаңдаудың қажеті жоқ.
Dialogue: 0,0:09:06.00,0:09:08.00,Default,,0,0,0,,Құтқарылатын уақыт келді.
Dialogue: 0,0:09:08.00,0:09:12.00,Default,,0,0,0,,Әй, бәрі, тынымсыз балаларды үйлеріне жіберіңдер.
Dialogue: 0,0:09:12.00,0:09:15.00,Default,,0,0,0,,Менің ойымша, сіз бұл баламен біраз уақыт өткізгеніңіз жөн.
Dialogue: 0,0:09:21.00,0:09:23.00,Default,,0,0,0,,Ей, үйге бірге барайық.
Dialogue: 0,0:09:24.00,0:09:26.00,Default,,0,0,0,,Мен сенуші болуды шештім.
Dialogue: 0,0:09:27.00,0:09:30.00,Default,,0,0,0,,Кага-санның арқасында мен жақсы адамдармен таныстым.
Dialogue: 0,0:09:30.00,0:09:31.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:31.00,0:09:33.00,Default,,0,0,0,,Олай болса, үйге бара жатқандар көлікке отырсын.
Dialogue: 0,0:09:43.00,0:09:45.00,Default,,0,0,0,,Енді барлығымызға оралайық.
Dialogue: 0,0:09:46.00,0:09:47.00,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:53.00,0:09:55.00,Default,,0,0,0,,Мен бәрібір қалуды шештім.
Dialogue: 0,0:09:55.00,0:09:58.00,Default,,0,0,0,,Дәл қазір маған қатты әсер етті.
Dialogue: 0,0:09:58.00,0:10:01.00,Default,,0,0,0,,Сұлу болсам да, қолымнан келмейді.
Dialogue: 0,0:10:01.00,0:10:03.00,Default,,0,0,0,,Сондықтан мен бұл ғасырдан бас тарттым.
Dialogue: 0,0:10:03.00,0:10:06.00,Default,,0,0,0,,Жаңа ғасырда белсенді
Dialogue: 0,0:10:07.00,0:10:10.00,Default,,0,0,0,,Міне, мен өз квотаға қол жеткіздім.
Dialogue: 0,0:10:10.00,0:10:13.00,Default,,0,0,0,,Бұл филиал менеджерін жақсы көрсетеді.
Dialogue: 0,0:10:13.00,0:10:15.00,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:10:15.00,0:10:17.00,Default,,0,0,0,,Бұл менің қалуымның мағынасы жоқ.
Dialogue: 0,0:10:17.00,0:10:19.00,Default,,0,0,0,,Менің ойымша, бәрі де солай болды.
Dialogue: 0,0:10:19.00,0:10:22.00,Default,,0,0,0,,Бұл құтылудың тамаша мүмкіндігі болды.
Dialogue: 0,0:10:22.00,0:10:25.00,Default,,0,0,0,,Мен сені жалғыз қалдыра алмаймын.
Dialogue: 0,0:10:26.00,0:10:30.00,Default,,0,0,0,,Сені бұл жерге әкелгеніме мен кінәлімін.
Dialogue: 0,0:10:31.00,0:10:32.00,Default,,0,0,0,,Екеуміз бірге қашайық
Dialogue: 0,0:10:34.00,0:10:36.00,Default,,0,0,0,,Сәлем, балалар
Dialogue: 0,0:10:36.00,0:10:39.00,Default,,0,0,0,,Басты кейіпкер бұлай бұрышта болмауы керек, солай ма?
Dialogue: 0,0:10:39.00,0:10:42.00,Default,,0,0,0,,Мұнда кел, мен сенімен сөйлесемін.
Dialogue: 0,0:10:42.00,0:10:43.00,Default,,0,0,0,,Мен қазір барамын
Dialogue: 0,0:10:43.00,0:10:45.00,Default,,0,0,0,,Аа, бірақ бұған дейін кішкене нәрсе.
Dialogue: 0,0:10:46.00,0:10:48.00,Default,,0,0,0,,Мен багажымды қалдырғым келеді.
Dialogue: 0,0:10:48.00,0:10:49.00,Default,,0,0,0,,Мен сіздің кілтіңізді қарызға аламын ба?
Dialogue: 0,0:10:49.00,0:10:51.00,Default,,0,0,0,,Енді қайтып оралма
Dialogue: 0,0:10:53.00,0:10:55.00,Default,,0,0,0,,Тоқта, мен сенімен келемін.
Dialogue: 0,0:10:58.00,0:10:59.00,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:11:03.00,0:11:04.00,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:11:04.00,0:11:05.00,Default,,0,0,0,,Мен ондай адамды білмеймін.
Dialogue: 0,0:11:10.00,0:11:11.00,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:11:11.00,0:11:12.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:12.00,0:11:13.00,Default,,0,0,0,,Мен ондай адамды білмеймін.
Dialogue: 0,0:11:13.00,0:11:15.00,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:11:16.00,0:11:17.00,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:11:17.00,0:11:18.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:18.00,0:11:20.00,Default,,0,0,0,,Екеуі есікті ішінен құлыптап алды.
Dialogue: 0,0:11:20.00,0:11:21.00,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:11:22.00,0:11:23.00,Default,,0,0,0,,Менің ойымша, сіз осы жерден кете аласыз.
Dialogue: 0,0:11:24.00,0:11:25.00,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:11:26.00,0:11:27.00,Default,,0,0,0,,Алдыңғы тізім
Dialogue: 0,0:11:28.00,0:11:29.00,Default,,0,0,0,,Қашып кеткендей сезім
Dialogue: 0,0:11:30.00,0:11:32.00,Default,,0,0,0,,Эй, біреу маған керек-жарақ әкеліп берші.
Dialogue: 0,0:11:32.00,0:11:34.00,Default,,0,0,0,,Жоқ, сіз бағалы заттардан басқаның бәрін қалдыра аласыз.
Dialogue: 0,0:11:34.00,0:11:35.00,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:11:46.00,0:11:48.00,Default,,0,0,0,,Ол станцияға қарай бет алуы керек.
Dialogue: 0,0:11:48.00,0:11:49.00,Default,,0,0,0,,Қолыңызды ашып, іздеңіз
Dialogue: 0,0:11:52.00,0:11:54.00,Default,,0,0,0,,Жолда университеттің семинар үйі болды.
Dialogue: 0,0:11:54.00,0:11:57.00,Default,,0,0,0,,Мен ол жерге жете алсам, бәрі жақсы болатынына сенімдімін.
Dialogue: 0,0:12:06.00,0:12:08.00,Default,,0,0,0,,Әйтеуір шашылған сияқты.
Dialogue: 0,0:12:08.00,0:12:09.00,Default,,0,0,0,,Иә
Dialogue: 0,0:12:11.00,0:12:13.00,Default,,0,0,0,,Ұрыс әлі біткен жоқ.
Dialogue: 0,0:12:14.00,0:12:15.00,Default,,0,0,0,,Мен әлі префектураның сыртындамын.
Dialogue: 0,0:12:16.00,0:12:17.00,Default,,0,0,0,,Тада-кун
Dialogue: 0,0:12:18.00,0:12:19.00,Default,,0,0,0,,Бұл да жақсы емес.
Dialogue: 0,0:12:22.00,0:12:23.00,Default,,0,0,0,,Кога-сан, салқындаған жоқсың ба?
Dialogue: 0,0:12:26.00,0:12:27.00,Default,,0,0,0,,Кога мырза?
Dialogue: 0,0:12:28.00,0:12:30.00,Default,,0,0,0,,Бұның болғанына мен кінәлімін.
Dialogue: 0,0:12:31.00,0:12:32.00,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:12:32.00,0:12:34.00,Default,,0,0,0,,Сіз осылай айтасыз, солай ма?
Dialogue: 0,0:12:35.00,0:12:36.00,Default,,0,0,0,,Бұл менің кінәм
Dialogue: 0,0:12:38.00,0:12:41.00,Default,,0,0,0,,Флаерді ұстаған да, жақындаған да мен болдым.
Dialogue: 0,0:12:41.00,0:12:44.00,Default,,0,0,0,,Тада-кун жаңа ғана менімен араласты.
Dialogue: 0,0:12:47.00,0:12:49.00,Default,,0,0,0,,Бұл менің кінәм деп ойлаймын
Dialogue: 0,0:12:49.00,0:12:50.00,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:12:52.00,0:12:53.00,Default,,0,0,0,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:12:53.00,0:12:57.00,Default,,0,0,0,,Кага-сан бұл үйірмеде достасуды жақсы деп ойлады.
Dialogue: 0,0:12:57.00,0:12:58.00,Default,,0,0,0,,Сонымен
Dialogue: 0,0:13:01.00,0:13:03.00,Default,,0,0,0,,Бұл менің жауапкершілігім ғой.
Dialogue: 0,0:13:04.00,0:13:06.00,Default,,0,0,0,,Бұл басқа, басқаша.
Dialogue: 0,0:13:07.00,0:13:09.00,Default,,0,0,0,,Бұл шын мәнінде Тада-кунның кінәсі емес.
Dialogue: 0,0:13:09.00,0:13:12.00,Default,,0,0,0,,Егер мен Тада-кунға жақындап, онымен таныссам,
Dialogue: 0,0:13:12.00,0:13:16.00,Default,,0,0,0,,Мицу туралы айтып бере аласыз ба деп ойладым.
Dialogue: 0,0:13:17.00,0:13:20.00,Default,,0,0,0,,Бастапқыда мен шеңберлерге мән бермедім.
Dialogue: 0,0:13:21.00,0:13:23.00,Default,,0,0,0,,Мен ешқашан араласпағаным рас.
Dialogue: 0,0:13:24.00,0:13:27.00,Default,,0,0,0,,Университеттегілердің мені елемейтіні рас.
Dialogue: 0,0:13:27.00,0:13:30.00,Default,,0,0,0,,Бірақ мен бұған мән бермедім.
Dialogue: 0,0:13:31.00,0:13:33.00,Default,,0,0,0,,Масатоши көңілсіз көрінді.
Dialogue: 0,0:13:33.00,0:13:35.00,Default,,0,0,0,,Сондықтан мен Тада-кунның жанашырлығына қарыздар едім.
Dialogue: 0,0:13:35.00,0:13:37.00,Default,,0,0,0,,Өйткені, Янасу мырзаның мақсаты болды.
Dialogue: 0,0:13:37.00,0:13:39.00,Default,,0,0,0,,Иә, Янано
Dialogue: 0,0:13:39.00,0:13:41.00,Default,,0,0,0,,Бұл аралас, Мицуо.
Dialogue: 0,0:13:43.00,0:13:45.00,Default,,0,0,0,,Бұл Мицуо үшін болды.
Dialogue: 0,0:13:46.00,0:13:47.00,Default,,0,0,0,,90%
Dialogue: 0,0:13:48.00,0:13:49.00,Default,,0,0,0,,Қалған 10% ше?
Dialogue: 0,0:13:52.00,0:13:54.00,Default,,0,0,0,,Мен тіпті білмеймін.
Dialogue: 0,0:13:54.00,0:13:58.00,Default,,0,0,0,,Колледжде бұл Мицуо үшін болғанына сенімдімін.
Dialogue: 0,0:13:59.00,0:14:01.00,Default,,0,0,0,,Иә, Янано
Dialogue: 0,0:14:01.00,0:14:03.00,Default,,0,0,0,,Мен ештеңе түсінбеймін
Dialogue: 0,0:14:03.00,0:14:07.00,Default,,0,0,0,,Менімен университетте сөйлесетін адам екені анық
Dialogue: 0,0:14:07.00,0:14:09.00,Default,,0,0,0,,Бұл жай ғана Тада-кун болды.
Dialogue: 0,0:14:09.00,0:14:11.00,Default,,0,0,0,,Менімен сөйлескеніңізге қуаныштымын.
Dialogue: 0,0:14:12.00,0:14:13.00,Default,,0,0,0,,Бұл да дұрыс
Dialogue: 0,0:14:15.00,0:14:19.00,Default,,0,0,0,,Янасу-сан, менің ойымша, сені қазір Кага-сан уайымдады.
Dialogue: 0,0:14:19.00,0:14:21.00,Default,,0,0,0,,Мен сізге толық мәлімет берген жоқпын.
Dialogue: 0,0:14:22.00,0:14:23.00,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:14:23.00,0:14:25.00,Default,,0,0,0,,Әй, солай.
Dialogue: 0,0:14:25.00,0:14:27.00,Default,,0,0,0,,Ақырында, бұл жайсыз сезім
Dialogue: 0,0:14:27.00,0:14:31.00,Default,,0,0,0,,Янасу-санның жүрегі күшті иеленушіліктің орнына ауыр орындыққа айналды.
Dialogue: 0,0:14:31.00,0:14:34.00,Default,,0,0,0,,Жоқ, жарайды, қандай даму.
Dialogue: 0,0:14:34.00,0:14:36.00,Default,,0,0,0,,Янас мырза ескертеді
Dialogue: 0,0:14:36.00,0:14:40.00,Default,,0,0,0,,Сол бала кездегі досым мен үшін қаншалықты маңызды болды?
Dialogue: 0,0:14:42.00,0:14:44.00,Default,,0,0,0,,Кейде ренжітетін шығар деп ойлайтынмын.
Dialogue: 0,0:14:44.00,0:14:47.00,Default,,0,0,0,,Бірде мен оны аңдыушы деп күдіктендім.
Dialogue: 0,0:14:47.00,0:14:52.00,Default,,0,0,0,,Дегенмен, мен үшін бұл әйел – менің тағдырым.
Dialogue: 0,0:14:53.00,0:14:55.00,Default,,0,0,0,,Клондау, клондау
Dialogue: 0,0:14:56.00,0:14:58.00,Default,,0,0,0,,Клондау
Dialogue: 0,0:15:08.00,0:15:11.00,Default,,0,0,0,,Қызық, Янасу-сан Кага-сан туралы біледі ме?
Dialogue: 0,0:15:11.00,0:15:13.00,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:15:13.00,0:15:17.00,Default,,0,0,0,,Жоқ, Кага-сан Янас-сан барда, жоқта басқа.
Dialogue: 0,0:15:17.00,0:15:19.00,Default,,0,0,0,,Өйткені ол сәл басқаша көрінді
Dialogue: 0,0:15:20.00,0:15:24.00,Default,,0,0,0,,Сенің қазіргідей күлгеніңді көрмедім деп ойлаймын, Янасу.
Dialogue: 0,0:15:26.00,0:15:28.00,Default,,0,0,0,,Егер сіз басқаша ойласаңыз
Dialogue: 0,0:15:28.00,0:15:31.00,Default,,0,0,0,,Мен Мицуомен бірге болғанда, мен мінсізмін.
Dialogue: 0,0:15:31.00,0:15:33.00,Default,,0,0,0,,Мен бұл дұрыс жауап деп ойладым.
Dialogue: 0,0:15:35.00,0:15:37.00,Default,,0,0,0,,Кемел дене дегеніміз не?
Dialogue: 0,0:15:37.00,0:15:40.00,Default,,0,0,0,,Мицуосыз мен өмір сүре алмаймын.
Dialogue: 0,0:15:41.00,0:15:45.00,Default,,0,0,0,,Таңертең тұру, түнде ұйықтау, мектепке бару
Dialogue: 0,0:15:45.00,0:15:48.00,Default,,0,0,0,,Киіну, жылау, күлу
Dialogue: 0,0:15:48.00,0:15:50.00,Default,,0,0,0,,Мұның бәрі Мицуоның кесірінен.
Dialogue: 0,0:15:51.00,0:15:54.00,Default,,0,0,0,,Мицуосыз мен қолымнан келгеннің бәрін жасай алмаймын.
Dialogue: 0,0:15:54.00,0:15:57.00,Default,,0,0,0,,Өмір сүрудің мүлдем мәні жоқ
Dialogue: 0,0:15:58.00,0:16:01.00,Default,,0,0,0,,Кагасан шын мәнінде Янасу туралы.
Dialogue: 0,0:16:02.00,0:16:04.00,Default,,0,0,0,,Мен әрқашан солай болдым
Dialogue: 0,0:16:04.00,0:16:08.00,Default,,0,0,0,,Mitsuo won't turn around, so I have nothing to do but chase after him.
Dialogue: 0,0:16:09.00,0:16:11.00,Default,,0,0,0,,Сіз мені ақымақ деп ойлайсыз, солай ма?
Dialogue: 0,0:16:12.00,0:16:15.00,Default,,0,0,0,,Жарайды, мен шынымен ақымақпын.
Dialogue: 0,0:16:15.00,0:16:18.00,Default,,0,0,0,,In that case, I shouldn't have done anything to make you angry.
Dialogue: 0,0:16:18.00,0:16:20.00,Default,,0,0,0,,Оларды раушан гүлдерімен ұру және т.б.
Dialogue: 0,0:16:20.00,0:16:23.00,Default,,0,0,0,,Дұрыс, Мицуо кінәлі.
Dialogue: 0,0:16:24.00,0:16:26.00,Default,,0,0,0,,Кага-сан кінәлі, солай ма?
Dialogue: 0,0:16:26.00,0:16:29.00,Default,,0,0,0,,Жоқ, себебі бар.
Dialogue: 0,0:16:29.00,0:16:32.00,Default,,0,0,0,,Төрт айлық ашу жарылды.
Dialogue: 0,0:16:33.00,0:16:37.00,Default,,0,0,0,,Actually, I was just going to say congratulations and give you a rose with a smile.
Dialogue: 0,0:16:37.00,0:16:40.00,Default,,0,0,0,,Бұл қазірдің өзінде тамаша сценарий.
Dialogue: 0,0:16:40.00,0:16:42.00,Default,,0,0,0,,Сіз не болады деп ойладыңыз?
Dialogue: 0,0:16:42.00,0:16:45.00,Default,,0,0,0,,I chased you all the way to the same university.
Dialogue: 0,0:16:45.00,0:16:47.00,Default,,0,0,0,,Бұл жолы Мицуо нокаутқа түседі
Dialogue: 0,0:16:48.00,0:16:49.00,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:16:49.00,0:16:50.00,Default,,0,0,0,,Тіпті тәтті, бал иісі бар дене жылуы
Dialogue: 0,0:16:51.00,0:16:55.00,Default,,0,0,0,,Mitsuo-san, you always told me that you were going to take the internal exam.
Dialogue: 0,0:16:55.00,0:16:57.00,Default,,0,0,0,,Өтірік екенін білдім
Dialogue: 0,0:16:57.00,0:17:02.00,Default,,0,0,0,,I pretended to be tricked and secretly took the same university as Mitsuo.
Dialogue: 0,0:17:02.00,0:17:05.00,Default,,0,0,0,,Мүмкін бір күні сен маған шындықты айтарсың.
Dialogue: 0,0:17:05.00,0:17:06.00,Default,,0,0,0,,While expecting
Dialogue: 0,0:17:06.00,0:17:09.00,Default,,0,0,0,,But even after I graduated, they didn't tell me anything.
Dialogue: 0,0:17:09.00,0:17:13.00,Default,,0,0,0,,Still, I was willing to forgive with a smile.
Dialogue: 0,0:17:13.00,0:17:15.00,Default,,0,0,0,,However, on the day of the entrance ceremony
Dialogue: 0,0:17:15.00,0:17:19.00,Default,,0,0,0,,When I saw a happy face walking with Tada-kun,
Dialogue: 0,0:17:19.00,0:17:21.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:22.00,0:17:24.00,Default,,0,0,0,,Мен енді шыдай алмаймын
Dialogue: 0,0:17:26.00,0:17:28.00,Default,,0,0,0,,Сонымен, раушан гүлімен күйесің бе?
Dialogue: 0,0:17:28.00,0:17:30.00,Default,,0,0,0,,Иә, Берн.
Dialogue: 0,0:17:30.00,0:17:32.00,Default,,0,0,0,,Күйіп қал, күйдір
Dialogue: 0,0:17:32.00,0:17:34.00,Default,,0,0,0,,Күйіп қал, күй
Dialogue: 0,0:17:34.00,0:17:36.00,Default,,0,0,0,,Иә, Берн.
Dialogue: 0,0:17:38.00,0:17:40.00,Default,,0,0,0,,Енді мен өкінемін.
Dialogue: 0,0:17:40.00,0:17:44.00,Default,,0,0,0,,Дұрыс, мені әрқашан жек көрген.
Dialogue: 0,0:17:45.00,0:17:49.00,Default,,0,0,0,,It's like I can't stay calm when it comes to Mitsuo.
Dialogue: 0,0:17:49.00,0:17:51.00,Default,,0,0,0,,Сіз енді айналаңызды көре алмайсыз.
Dialogue: 0,0:17:53.00,0:17:56.00,Default,,0,0,0,,Rather than talking about me, let me tell you your story too.
Dialogue: 0,0:17:57.00,0:17:58.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:59.00,0:18:02.00,Default,,0,0,0,,Тада-кун, сен біреумен кездесіп жүрсің бе?
Dialogue: 0,0:18:02.00,0:18:04.00,Default,,0,0,0,,шұғыл басымдық ретінде қарастырылып, ақпарат іздестіруде
Dialogue: 0,0:18:04.00,0:18:07.00,Default,,0,0,0,,Жадымның желге ұшқаны рас.
Dialogue: 0,0:18:08.00,0:18:10.00,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:10.00,0:18:12.00,Default,,0,0,0,,Есте сақтау қабілетінің жоғалуы туралы әңгіме
Dialogue: 0,0:18:13.00,0:18:15.00,Default,,0,0,0,,Бұл рас болды ма?
Dialogue: 0,0:18:15.00,0:18:17.00,Default,,0,0,0,,The day after the third year high school graduation ceremony
Dialogue: 0,0:18:17.00,0:18:20.00,Default,,0,0,0,,Мен жақын маңдағы көпірден құладым.
Dialogue: 0,0:18:20.00,0:18:24.00,Default,,0,0,0,,My memory just flew by and I'm still here today.
Dialogue: 0,0:18:24.00,0:18:29.00,Default,,0,0,0,,I no longer understand everything about myself up until then.
Dialogue: 0,0:18:32.00,0:18:37.00,Default,,0,0,0,,Relationships with parents, friends, classmates, teachers, etc.
Dialogue: 0,0:18:37.00,0:18:40.00,Default,,0,0,0,,Сізге не ұнады немесе не ұнамады?
Dialogue: 0,0:18:40.00,0:18:43.00,Default,,0,0,0,,In short, it seems that personality has disappeared.
Dialogue: 0,0:18:43.00,0:18:47.00,Default,,0,0,0,,Even after being hospitalized and doing rehabilitation for a year, it still didn't work.
Dialogue: 0,0:18:49.00,0:18:52.00,Default,,0,0,0,,Мен ескі достармен кездесуден қорқамын.
Dialogue: 0,0:18:53.00,0:18:58.00,Default,,0,0,0,,I think the person everyone wants to meet is the original free keeper before he lost his memory.
Dialogue: 0,0:18:58.00,0:19:02.00,Default,,0,0,0,,Because I felt like I wasn't needed right now.
Dialogue: 0,0:19:03.00,0:19:06.00,Default,,0,0,0,,Сондықтан мен барлық келулерден бас тарттым.
Dialogue: 0,0:19:07.00,0:19:11.00,Default,,0,0,0,,Бірақ, егер менің қызым болса, мен оны көруге келер едім.
Dialogue: 0,0:19:11.00,0:19:14.00,Default,,0,0,0,,Иә, солай болуы мүмкін.
Dialogue: 0,0:19:17.00,0:19:22.00,Default,,0,0,0,,Even though I can't remember anything, my feelings sometimes come back.
Dialogue: 0,0:19:23.00,0:19:26.00,Default,,0,0,0,,It seems nostalgic, it seems like I can remember something.
Dialogue: 0,0:19:27.00,0:19:31.00,Default,,0,0,0,,But when I try to chase it, it disappears.
Dialogue: 0,0:19:31.00,0:19:34.00,Default,,0,0,0,,For example, if there are words written on a piece of paper.
Dialogue: 0,0:19:34.00,0:19:38.00,Default,,0,0,0,,Сөйлемді оқып көрейін десем, бірден жоғалып кететін сияқты.
Dialogue: 0,0:19:39.00,0:19:43.00,Default,,0,0,0,,There was a faint feeling that I was about to catch the tail.
Dialogue: 0,0:19:43.00,0:19:46.00,Default,,0,0,0,,Міне, құрттай жоғалады
Dialogue: 0,0:19:46.00,0:19:50.00,Default,,0,0,0,,Бұл өте қорқынышты естіледі.
Dialogue: 0,0:19:51.00,0:19:52.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:19:53.00,0:19:55.00,Default,,0,0,0,,Кешіріңіз, мен кенет біртүрлі нәрсе айттым.
Dialogue: 0,0:19:56.00,0:19:57.00,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:19:58.00,0:19:59.00,Default,,0,0,0,,Нагаре, сен Британияда өскенсің бе?
Dialogue: 0,0:20:01.00,0:20:04.00,Default,,0,0,0,,Мен не айтарымды білмеймін
Dialogue: 0,0:20:04.00,0:20:07.00,Default,,0,0,0,,О, бұл туралы уайымдама.
Dialogue: 0,0:20:07.00,0:20:10.00,Default,,0,0,0,,Мен қазір саумын.
Dialogue: 0,0:20:10.00,0:20:12.00,Default,,0,0,0,,If you have any questions, feel free to ask.
Dialogue: 0,0:20:14.00,0:20:16.00,Default,,0,0,0,,Олай болса
Dialogue: 0,0:20:17.00,0:20:20.00,Default,,0,0,0,,Сіз бұрынғы күйіңізге оралғыңыз келе ме?
Dialogue: 0,0:20:20.00,0:20:23.00,Default,,0,0,0,,Хмм, сіз қалай ойлайсыз?
Dialogue: 0,0:20:23.00,0:20:28.00,Default,,0,0,0,,Мен үшін өзімді жалғыз сезінетін адам - ​​қазір кіммін.
Dialogue: 0,0:20:28.00,0:20:34.00,Default,,0,0,0,,Бірақ мен ата-аналар мен басқа адамдар жағдайдың қалыпты жағдайға оралғанын қалайтынын да түсінемін.
Dialogue: 0,0:20:35.00,0:20:38.00,Default,,0,0,0,,Кейде мен бұрынғы күйіме оралсам деп тілеймін.
Dialogue: 0,0:20:38.00,0:20:43.00,Default,,0,0,0,,Бірақ бұл бастапқы жадты қазіргі менге қосуды білдірсе, бұл жақсы.
Dialogue: 0,0:20:43.00,0:20:46.00,Default,,0,0,0,,Әрбір тұлға өзгереді дегенді білдіре ме?
Dialogue: 0,0:20:46.00,0:20:51.00,Default,,0,0,0,,Егер бұл менің қазіргі болмысымның жоғалып кеткенін білдірсе және менің бұрынғы болмысыммен алмастырылғанын білдірсе, кешіріңіз.
Dialogue: 0,0:20:53.00,0:20:56.00,Default,,0,0,0,,Тадабанридің ескі күндері бұл дүниеден ғайып болды.
Dialogue: 0,0:20:56.00,0:21:01.00,Default,,0,0,0,,Міне, содан бері тағы бір реинкарнацияланған адам.
Dialogue: 0,0:21:01.00,0:21:02.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:08.00,0:21:15.00,Default,,0,0,0,,Кәрі Тада-кун Хай Горен сияқты бір жерде қазіргі Тада-кунды бақылап отыр ма деп ойлаймын.
Dialogue: 0,0:21:15.00,0:21:17.00,Default,,0,0,0,,Бұл аздап қорқынышты болуы мүмкін
Dialogue: 0,0:21:21.00,0:21:22.00,Default,,0,0,0,,Тада-кун, бұл
Dialogue: 0,0:21:24.00,0:21:25.00,Default,,0,0,0,,Кеттік
Dialogue: 0,0:21:25.00,0:21:26.00,Default,,0,0,0,,Иә
Dialogue: 0,0:21:27.00,0:21:31.00,Default,,0,0,0,,Ойлап қарасам, ол кезде де солай болған.
Dialogue: 0,0:21:32.00,0:21:33.00,Default,,0,0,0,,Күте тұрыңыз, Тадакун
Dialogue: 0,0:21:35.00,0:21:37.00,Default,,0,0,0,,Бұл адамдар біртүрлі.
Dialogue: 0,0:21:40.00,0:21:42.00,Default,,0,0,0,,Олар ертедегі мүміндер емес пе?
Dialogue: 0,0:21:42.00,0:21:43.00,Default,,0,0,0,,Олай болса, жаман болар еді.
Dialogue: 0,0:21:46.00,0:21:47.00,Default,,0,0,0,,Банри?
Dialogue: 0,0:21:47.00,0:21:48.00,Default,,0,0,0,,Тұра аласың ба, Армин?
Dialogue: 0,0:21:48.00,0:21:50.00,Default,,0,0,0,,Бұл менмін, мен
Dialogue: 0,0:21:50.00,0:21:52.00,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:21:53.00,0:21:54.00,Default,,0,0,0,,Бабара?
Dialogue: 0,0:21:55.00,0:21:56.00,Default,,0,0,0,,Бұл Линда.
Dialogue: 0,0:22:23.00,0:22:24.00,Default,,0,0,0,,Бабара?
Dialogue: 0,0:22:54.00,0:22:56.00,Default,,0,0,0,,Мен сені қатты жақсы көремін
Dialogue: 0,0:22:59.00,0:23:00.00,Default,,0,0,0,,Қол ұстасып көрейік
Dialogue: 0,0:23:00.00,0:23:03.00,Default,,0,0,0,,Сол күйінде қалуға болмайды
Dialogue: 0,0:23:03.00,0:23:05.00,Default,,0,0,0,,Менің қолдарым солай
Dialogue: 0,0:23:05.00,0:23:08.00,Default,,0,0,0,,Тарту
Dialogue: 0,0:23:08.00,0:23:10.00,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:23:24.00,0:23:25.00,Default,,0,0,0,,Тадабанри?
Dialogue: 0,0:23:25.00,0:23:28.00,Default,,0,0,0,,Сен тауда осылай тәпішке киіп не істеп жүрсің?
Dialogue: 0,0:23:28.00,0:23:30.00,Default,,0,0,0,,Әй, кездесу болар ма?
Dialogue: 0,0:23:30.00,0:23:32.00,Default,,0,0,0,,Не, мен?
Dialogue: 0,0:23:32.00,0:23:33.00,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:23:33.00,0:23:34.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:23:34.00,0:23:36.00,Default,,0,0,0,,Бабара деген кім?
Dialogue: 0,0:23:37.50,0:23:42.50,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
