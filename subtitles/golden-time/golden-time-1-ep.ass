Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.30,0:00:15.16,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:02:08.16,0:02:09.97,Default,,0,0,0,,Бұл қауіпті, бұл қауіпті
Dialogue: 0,0:02:16.20,0:02:17.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:17.00,0:02:18.43,Default,,0,0,0,,Заң факультеті
Dialogue: 0,0:02:19.06,0:02:20.03,Default,,0,0,0,,Мен кешігіп қалдым.
Dialogue: 0,0:02:20.83,0:02:22.06,Default,,0,0,0,,Студенттік куәлікті көрсетіңіз
Dialogue: 0,0:02:22.66,0:02:24.36,Default,,0,0,0,,Содан кейін кешіктіру себебін түсіндіріңіз.
Dialogue: 0,0:02:25.13,0:02:26.76,Default,,0,0,0,,Мен Токиоға үйренбегендіктен адасып қалдым.
Dialogue: 0,0:02:27.26,0:02:28.33,Default,,0,0,0,,Мен қате пойызға отырдым
Dialogue: 0,0:02:28.73,0:02:29.79,Default,,0,0,0,,Біз вокзалға жеткенде
Dialogue: 0,0:02:29.80,0:02:31.33,Default,,0,0,0,,Мен басқа жер асты шығуын білмеймін.
Dialogue: 0,0:02:31.43,0:02:32.33,Default,,0,0,0,,Мен айналамын
Dialogue: 0,0:02:37.96,0:02:38.76,Default,,0,0,0,,Олай болса
Dialogue: 0,0:02:38.90,0:02:39.90,Default,,0,0,0,,Осымен,
Dialogue: 0,0:02:40.36,0:02:42.73,Default,,0,0,0,,Биылғы қабылдау рәсімі аяқталды.
Dialogue: 0,0:02:43.10,0:02:44.30,Default,,0,0,0,,Жаңа студенттер үшін,
Dialogue: 0,0:02:44.70,0:02:46.83,Default,,0,0,0,,Әрбір факультет ғимаратына көшіңіз.
Dialogue: 0,0:02:47.20,0:02:48.20,Default,,0,0,0,,Бағдарлау
Dialogue: 0,0:02:48.20,0:02:49.03,Default,,0,0,0,,Қабылдаңыз
Dialogue: 0,0:02:54.10,0:02:55.43,Default,,0,0,0,,Мен көктемдемін
Dialogue: 0,0:02:55.43,0:02:57.56,Default,,0,0,0,,Мен Токиоға ата-анам тұратын Сидзуокадан келдім.
Dialogue: 0,0:02:58.43,0:02:59.89,Default,,0,0,0,,Көптен күткен университеттегі дебюті
Dialogue: 0,0:03:00.20,0:03:01.16,Default,,0,0,0,,Токиодағы дебюті
Dialogue: 0,0:03:01.53,0:03:02.66,Default,,0,0,0,,Дебют жалғыз өмір сүру
Dialogue: 0,0:03:04.30,0:03:06.90,Default,,0,0,0,,Бірақ мен күтпеген жерден кіру рәсіміне кешігіп қалдым.
Dialogue: 0,0:03:08.66,0:03:09.46,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:03:10.16,0:03:10.96,Default,,0,0,0,,Мен
Dialogue: 0,0:03:11.06,0:03:12.36,Default,,0,0,0,,Мен мұны дұрыс істей аламын ба деп ойлаймын?
Dialogue: 0,0:03:14.36,0:03:15.13,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:03:15.13,0:03:16.33,Default,,0,0,0,,Ата-аналар да келе жатыр.
Dialogue: 0,0:03:25.36,0:03:26.79,Default,,0,0,0,,Сіз университетке ауысуды жоспарлап отырсыз ба?
Dialogue: 0,0:03:28.06,0:03:29.06,Default,,0,0,0,,Бір метро аялдамасы
Dialogue: 0,0:03:29.76,0:03:30.79,Default,,0,0,0,,15 минут шығысқа қарай
Dialogue: 0,0:03:35.03,0:03:35.83,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:03:36.56,0:03:38.06,Default,,0,0,0,,Мектепке барғанда не істеу керек
Dialogue: 0,0:03:38.53,0:03:39.33,Default,,0,0,0,,Пойызға отырыңыз
Dialogue: 0,0:03:39.76,0:03:41.43,Default,,0,0,0,,Метроға отырмаңыз
Dialogue: 0,0:03:41.46,0:03:43.63,Default,,0,0,0,,Бұл төте жол, сондықтан серуендейміз.
Dialogue: 0,0:03:43.93,0:03:45.49,Default,,0,0,0,,Мен келісемін.
Dialogue: 0,0:03:46.40,0:03:47.20,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:03:47.90,0:03:49.90,Default,,0,0,0,,Ей, мен қандай үйірмеге қатысатынымды шештім.
Dialogue: 0,0:03:49.96,0:03:51.33,Default,,0,0,0,,Мен әлі шешкен жоқпын.
Dialogue: 0,0:03:51.73,0:03:53.89,Default,,0,0,0,,Менде әлі не бар деп ойлаймын.
Dialogue: 0,0:03:54.43,0:03:56.16,Default,,0,0,0,,Бұл мен үшін тым күдікті
Dialogue: 0,0:03:57.36,0:03:58.53,Default,,0,0,0,,Бүгін күн ыстық.
Dialogue: 0,0:03:59.13,0:04:00.13,Default,,0,0,0,,Балмұздақ жеме
Dialogue: 0,0:04:00.43,0:04:02.36,Default,,0,0,0,,Алда дүкен бар екеніне сенімдімін.
Dialogue: 0,0:04:02.56,0:04:03.36,Default,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,0:04:12.33,0:04:13.13,Default,,0,0,0,,Кешіріңіз—
Dialogue: 0,0:04:17.83,0:04:18.96,Default,,0,0,0,,Кім?
Dialogue: 0,0:04:20.53,0:04:21.33,Default,,0,0,0,,Жаттығу
Dialogue: 0,0:04:21.80,0:04:22.46,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:04:22.46,0:04:24.46,Default,,0,0,0,,Университет алдында кездесейік.
Dialogue: 0,0:04:24.70,0:04:26.43,Default,,0,0,0,,Жарайды, асығуымыз керек.
Dialogue: 0,0:04:26.60,0:04:27.56,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:04:28.26,0:04:29.53,Default,,0,0,0,,Сол кассаны тексеріңіз.
Dialogue: 0,0:04:30.13,0:04:31.49,Default,,0,0,0,,Біз тоқтаймыз.
Dialogue: 0,0:04:32.30,0:04:33.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:33.23,0:04:34.46,Default,,0,0,0,,Оны бес минутта жасаңыз.
Dialogue: 0,0:04:34.56,0:04:35.36,Default,,0,0,0,,Инсаба
Dialogue: 0,0:04:35.70,0:04:37.96,Default,,0,0,0,,Жоқ, барлығы бес минут. Кешігіп қалсам, міндетті түрде кешігіп қаламын.
Dialogue: 0,0:04:38.13,0:04:39.16,Default,,0,0,0,,Мәңгілік жүгіргеннен кейін Ол
Dialogue: 0,0:04:39.16,0:04:41.09,Default,,0,0,0,,сәйкес 150 иен болады
Dialogue: 0,0:04:41.63,0:04:42.43,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:04:42.93,0:04:43.73,Default,,0,0,0,,Шынайы кімдігі: жалдамалы кісі өлтіруші
Dialogue: 0,0:04:48.60,0:04:49.63,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:50.76,0:04:51.56,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:04:55.36,0:04:56.16,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:04:57.23,0:04:58.03,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:04:58.40,0:04:59.20,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:05:00.00,0:05:00.96,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:05:01.60,0:05:03.26,Default,,0,0,0,,Инженерлік факультет?
Dialogue: 0,0:05:04.86,0:05:06.06,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:06.66,0:05:07.46,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:05:07.63,0:05:08.43,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:08.43,0:05:11.39,Default,,0,0,0,,Негізі университетке қалай түсетінімді білмеймін.
Dialogue: 0,0:05:12.16,0:05:12.96,Default,,0,0,0,,Жоспар
Dialogue: 0,0:05:13.56,0:05:14.26,Default,,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:05:14.26,0:05:15.13,Default,,0,0,0,,Бұрынғы адамдар
Dialogue: 0,0:05:15.13,0:05:16.23,Default,,0,0,0,,Сіз жолды білетін сияқтысыз.
Dialogue: 0,0:05:16.23,0:05:17.03,Default,,0,0,0,,Егер келесідей болса
Dialogue: 0,0:05:17.03,0:05:17.99,Default,,0,0,0,,Мен дүкенге кірдім.
Dialogue: 0,0:05:18.36,0:05:19.56,Default,,0,0,0,,Бізде кездесуден басқа амал жоқ па?
Dialogue: 0,0:05:19.63,0:05:22.06,Default,,0,0,0,,Сонымен мен де балмұздақ сатып алдым.
Dialogue: 0,0:05:22.66,0:05:23.46,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:05:24.43,0:05:25.23,Default,,0,0,0,,О
Dialogue: 0,0:05:25.96,0:05:26.76,Default,,0,0,0,,...
Dialogue: 0,0:05:30.90,0:05:32.20,Default,,0,0,0,,Мен жай ғана Бандимін
Dialogue: 0,0:05:33.03,0:05:33.83,Default,,0,0,0,,Банди жақсы.
Dialogue: 0,0:05:34.56,0:05:36.33,Default,,0,0,0,,Мицуо Оре Янагисава
Dialogue: 0,0:05:36.86,0:05:37.96,Default,,0,0,0,,Сіз маған кез келген қоңырау шала аласыз
Dialogue: 0,0:05:38.46,0:05:39.53,Default,,0,0,0,,Яна немесе басқасы
Dialogue: 0,0:05:40.43,0:05:42.23,Default,,0,0,0,,Токио Сидзуока
Dialogue: 0,0:05:42.80,0:05:43.60,Default,,0,0,0,,Жиренішті
Dialogue: 0,0:05:44.36,0:05:46.09,Default,,0,0,0,,Токиода
Dialogue: 0,0:05:46.50,0:05:48.73,Default,,0,0,0,,Бірақ мен де жалғыз тұрамын
Dialogue: 0,0:05:54.33,0:05:55.83,Default,,0,0,0,,Бұл жерде дұрыс сияқты.
Dialogue: 0,0:05:57.36,0:05:58.16,Default,,0,0,0,,О.
Dialogue: 0,0:05:58.16,0:05:59.99,Default,,0,0,0,,Бұл ғимарат
Dialogue: 0,0:06:02.56,0:06:03.36,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:03.63,0:06:05.09,Default,,0,0,0,,Бүгін кенеттен кешігіп қалдым.
Dialogue: 0,0:06:05.26,0:06:06.23,Default,,0,0,0,,Мен кешігіп қалдым.
Dialogue: 0,0:06:06.83,0:06:07.39,Default,,0,0,0,,(Құлақтағы сыңғыру)
Dialogue: 0,0:06:07.40,0:06:08.80,Default,,0,0,0,,Өйткені менің сөйлесетін адамым жоқ еді
Dialogue: 0,0:06:09.03,0:06:09.96,Default,,0,0,0,,Мазасыздық сезімі
Dialogue: 0,0:06:10.90,0:06:12.10,Default,,0,0,0,,Басқалары қазірдің өзінде
Dialogue: 0,0:06:12.13,0:06:13.73,Default,,0,0,0,,Біз дос сияқтымыз.
Dialogue: 0,0:06:14.23,0:06:16.26,Default,,0,0,0,,Одан да жалғыздық
Dialogue: 0,0:06:16.60,0:06:17.40,Default,,0,0,0,,Жоспар
Dialogue: 0,0:06:17.80,0:06:18.63,Default,,0,0,0,,Әсіресе мен
Dialogue: 0,0:06:19.06,0:06:20.86,Default,,0,0,0,,Себебі бастауыш мектептен жалғанған
Dialogue: 0,0:06:21.13,0:06:22.29,Default,,0,0,0,,Бұл Хироси Абэ
Dialogue: 0,0:06:22.40,0:06:23.33,Default,,0,0,0,,Бұл менің бірінші рет
Dialogue: 0,0:06:24.03,0:06:24.86,Default,,0,0,0,,Қосылған
Dialogue: 0,0:06:25.63,0:06:27.19,Default,,0,0,0,,Тағы бір мектеп
Dialogue: 0,0:06:28.06,0:06:29.66,Default,,0,0,0,,Бастауыш мектептен орта мектепке дейін
Dialogue: 0,0:06:29.96,0:06:30.89,Default,,0,0,0,,Охнохараға тіркелген
Dialogue: 0,0:06:31.53,0:06:32.33,Default,,0,0,0,,Өтірік
Dialogue: 0,0:06:32.40,0:06:33.60,Default,,0,0,0,,Бұл өте беделді отбасы.
Dialogue: 0,0:06:34.33,0:06:36.03,Default,,0,0,0,,Бұл университетке не үшін келдіңіз?
Dialogue: 0,0:06:36.46,0:06:36.99,Default,,0,0,0,,Сол сияқты
Dialogue: 0,0:06:37.00,0:06:38.23,Default,,0,0,0,,Эскалатормен жүру жақсы
Dialogue: 0,0:06:38.40,0:06:39.63,Default,,0,0,0,,Бұл сөзсіз жақсы болды.
Dialogue: 0,0:06:40.53,0:06:41.49,Default,,0,0,0,,Аударманың қандай да бір түрі
Dialogue: 0,0:06:41.96,0:06:43.56,Default,,0,0,0,,Не?
Dialogue: 0,0:06:44.86,0:06:45.66,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:45.80,0:06:47.03,Default,,0,0,0,,Бұл сезімсіз.
Dialogue: 0,0:06:47.53,0:06:48.56,Default,,0,0,0,,Жаңа кездескен адамға
Dialogue: 0,0:06:48.56,0:06:49.46,Default,,0,0,0,,Мен көп нәрсені естідім.
Dialogue: 0,0:06:49.66,0:06:50.49,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:06:50.73,0:06:51.69,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:06:52.70,0:06:54.66,Default,,0,0,0,,Бұл ұзақ әңгіме.
Dialogue: 0,0:06:55.56,0:06:56.36,Default,,0,0,0,,Қысқасы
Dialogue: 0,0:06:56.80,0:06:57.70,Default,,0,0,0,,Қарама-қарсы жыныстың қарым-қатынасында
Dialogue: 0,0:06:57.70,0:06:59.30,Default,,0,0,0,,Мен аздап қиындық туғыздым.
Dialogue: 0,0:07:00.03,0:07:00.83,Default,,0,0,0,,Хаха
Dialogue: 0,0:07:01.06,0:07:02.09,Default,,0,0,0,,Гетеросексуалдық қатынастар Тар дүниенің
Dialogue: 0,0:07:02.83,0:07:03.66,Default,,0,0,0,,...
Dialogue: 0,0:07:03.66,0:07:04.49,Default,,0,0,0,,Қарым-қатынаста
Dialogue: 0,0:07:04.50,0:07:06.06,Default,,0,0,0,,Ішінара мен одан шаршадым.
Dialogue: 0,0:07:06.66,0:07:07.59,Default,,0,0,0,,Университет өмірі
Dialogue: 0,0:07:07.66,0:07:10.06,Default,,0,0,0,,Мен жаңа ортада жаңа бастама жасағым келді.
Dialogue: 0,0:07:10.06,0:07:10.86,Default,,0,0,0,,Сонымен
Dialogue: 0,0:07:11.10,0:07:11.90,Default,,0,0,0,,Иә
Dialogue: 0,0:07:12.70,0:07:13.50,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:07:13.53,0:07:16.26,Default,,0,0,0,,Басқаша айтқанда, мен қызыммен қиындыққа тап болдым.
Dialogue: 0,0:07:17.03,0:07:17.83,Default,,0,0,0,,емес
Dialogue: 0,0:07:18.63,0:07:20.19,Default,,0,0,0,,Бұл қалай аталады?
Dialogue: 0,0:07:21.73,0:07:22.53,Default,,0,0,0,,Апат
Dialogue: 0,0:07:23.70,0:07:24.50,Default,,0,0,0,,Иә
Dialogue: 0,0:07:25.13,0:07:25.93,Default,,0,0,0,,Сонымен қатар, Yoshida Productions Яиді Yotsuba-ның талисманы ретінде насихаттап жатыр.
Dialogue: 0,0:07:26.70,0:07:27.50,Default,,0,0,0,,Бір нәрсе сияқты
Dialogue: 0,0:07:28.16,0:07:28.96,Default,,0,0,0,,Көпшілігі
Dialogue: 0,0:07:29.23,0:07:30.03,Default,,0,0,0,,Хмм, осылайша бәрі жоспар бойынша жүреді.
Dialogue: 0,0:07:33.16,0:07:33.96,Default,,0,0,0,,О.
Dialogue: 0,0:07:46.80,0:07:47.60,Default,,0,0,0,,О
Dialogue: 0,0:07:53.80,0:07:54.60,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:08:00.46,0:08:01.26,Default,,0,0,0,,Бірақ
Dialogue: 0,0:08:09.36,0:08:11.83,Default,,0,0,0,,Сен бүгіннен бастап университет студенті боласың, Мицуо.
Dialogue: 0,0:08:12.86,0:08:14.26,Default,,0,0,0,,Тікенектер жойылды.
Dialogue: 0,0:08:15.93,0:08:17.13,Default,,0,0,0,,Сен ақымақ Мицуо
Dialogue: 0,0:08:17.63,0:08:19.99,Default,,0,0,0,,Менен қашып кетемін деп ойладың
Dialogue: 0,0:08:20.56,0:08:22.29,Default,,0,0,0,,Мицуо әрқашан болды
Dialogue: 0,0:08:22.43,0:08:23.63,Default,,0,0,0,,Бұл менікі
Dialogue: 0,0:08:28.50,0:08:29.30,Default,,0,0,0,,Бұл тек болжам ғана емес — бұл дәл өзі
Dialogue: 0,0:08:41.30,0:08:42.10,Default,,0,0,0,,Лианасса
Dialogue: 0,0:08:42.20,0:08:43.00,Default,,0,0,0,,Мықты болыңыз
Dialogue: 0,0:08:43.46,0:08:45.36,Default,,0,0,0,,Бұл кім? Қазір не болды?
Dialogue: 0,0:08:45.90,0:08:48.53,Default,,0,0,0,,Уау, мектеп алдында қанды шайқас па?
Dialogue: 0,0:08:48.76,0:08:49.79,Default,,0,0,0,,Бұл раушан адам
Dialogue: 0,0:08:50.03,0:08:51.13,Default,,0,0,0,,Сіз жаңа студентсіз, солай ма?
Dialogue: 0,0:08:51.63,0:08:54.16,Default,,0,0,0,,Кіру салтанатынан бері немен айналыстыңыз?
Dialogue: 0,0:08:55.16,0:08:55.96,Default,,0,0,0,,(♪ «Twinkle, Twinkle, Little Star» әніне варияциялар»)
Dialogue: 0,0:08:56.86,0:08:58.16,Default,,0,0,0,,Менің университеттегі өмірім
Dialogue: 0,0:08:58.93,0:09:00.23,Default,,0,0,0,,Бір күнде аяқталды
Dialogue: 0,0:09:01.60,0:09:03.10,Default,,0,0,0,,Чо Ямада-сан
Dialogue: 0,0:09:05.36,0:09:06.49,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:07.10,0:09:09.93,Default,,0,0,0,,Егер сізге бұл ұнаса, солай жасаңыз.
Dialogue: 0,0:09:10.30,0:09:11.90,Default,,0,0,0,,Куренао
Dialogue: 0,0:09:12.40,0:09:13.50,Default,,0,0,0,,Қаласаңыз, өтінемін.
Dialogue: 0,0:09:13.90,0:09:16.16,Default,,0,0,0,,Өтінемін, өтінемін.
Dialogue: 0,0:09:18.10,0:09:19.00,Default,,0,0,0,,Жоқ, бірақ Йор-чан менің байқамай тұрғанымда үйленіп кеткеніне сенбеймін.
Dialogue: 0,0:09:19.56,0:09:20.26,Default,,0,0,0,,Егер сіз мұны істесеңіз
Dialogue: 0,0:09:20.26,0:09:21.96,Default,,0,0,0,,Мен әйтеуір алдай аламын ба деп ойлаймын.
Dialogue: 0,0:09:22.40,0:09:23.20,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:09:24.23,0:09:26.16,Default,,0,0,0,,Өтінемін, тағы да бар.
Dialogue: 0,0:09:26.50,0:09:27.30,Default,,0,0,0,,Жапония өтінемін
Dialogue: 0,0:09:28.06,0:09:28.83,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:28.83,0:09:29.63,Default,,0,0,0,,Мен де істеймін
Dialogue: 0,0:09:30.40,0:09:31.40,Default,,0,0,0,,Жалғастырыңыз.
Dialogue: 0,0:09:31.56,0:09:33.36,Default,,0,0,0,,Мен таратып жатырмын, өтінемін.
Dialogue: 0,0:09:33.56,0:09:34.36,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:09:35.36,0:09:36.99,Default,,0,0,0,,Ал, университетте
Dialogue: 0,0:09:37.16,0:09:39.69,Default,,0,0,0,,Міндетті және таңдау пәндері бар.
Dialogue: 0,0:09:40.36,0:09:41.66,Default,,0,0,0,,Заң факультеті үшін
Dialogue: 0,0:09:41.86,0:09:44.26,Default,,0,0,0,,Бірінші курстан көптеген таңдау пәндері болғандықтан,
Dialogue: 0,0:09:44.66,0:09:45.76,Default,,0,0,0,,Екі рет айналып өтетін сабақ
Dialogue: 0,0:09:45.76,0:09:47.33,Default,,0,0,0,,Мұқият таңдаңыз
Dialogue: 0,0:09:48.10,0:09:48.60,Default,,0,0,0,,Олай болса
Dialogue: 0,0:09:48.56,0:09:50.59,Default,,0,0,0,,Алдымен құжаттың бірінші бетін қараңыз.
Dialogue: 0,0:09:51.40,0:09:52.20,Default,,0,0,0,,Қаға
Dialogue: 0,0:09:52.53,0:09:53.33,Default,,0,0,0,,Такако
Dialogue: 0,0:09:53.96,0:09:54.76,Default,,0,0,0,,Иә
Dialogue: 0,0:09:54.86,0:09:56.03,Default,,0,0,0,,Менің бала күнгі досым
Dialogue: 0,0:09:56.56,0:09:58.89,Default,,0,0,0,,Менің әкем үлкен аурухананы басқарады.
Dialogue: 0,0:09:59.53,0:10:01.23,Default,,0,0,0,,Сен менің ата-анамды білесің.
Dialogue: 0,0:10:02.13,0:10:03.96,Default,,0,0,0,,Үлкен ауруханадан келген жас келіншек?
Dialogue: 0,0:10:04.73,0:10:07.23,Default,,0,0,0,,Балабақшадан орта мектепке дейін бір мектеп
Dialogue: 0,0:10:07.33,0:10:08.13,Default,,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:10:08.33,0:10:09.39,Default,,0,0,0,,Егер рас болса, университет те.
Dialogue: 0,0:10:09.40,0:10:11.23,Default,,0,0,0,,Дәл солай бола жаздады.
Dialogue: 0,0:10:12.16,0:10:12.99,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:10:13.06,0:10:15.26,Default,,0,0,0,,Мен бұл университетке не үшін әдейі бардым?
Dialogue: 0,0:10:16.10,0:10:16.90,Default,,0,0,0,,Ах!!
Dialogue: 0,0:10:17.13,0:10:17.96,Default,,0,0,0,,Осыған байланысты, И
Dialogue: 0,0:10:18.23,0:10:20.06,Default,,0,0,0,,Ата-анаңмен ұрысып қаласың.
Dialogue: 0,0:10:20.56,0:10:21.96,Default,,0,0,0,,Мен ешқандай жәрдемақы да алмаймын.
Dialogue: 0,0:10:22.56,0:10:23.79,Default,,0,0,0,,Мен қатты қиналдым.
Dialogue: 0,0:10:24.53,0:10:25.83,Default,,0,0,0,,Мен кеткім келді
Dialogue: 0,0:10:26.26,0:10:27.06,Default,,0,0,0,,Кага-санмен
Dialogue: 0,0:10:27.63,0:10:28.89,Default,,0,0,0,,Ол қорқынышты
Dialogue: 0,0:10:29.33,0:10:30.89,Default,,0,0,0,,Мен сенімен кішкентай кезімнен біргемін.
Dialogue: 0,0:10:30.93,0:10:32.56,Default,,0,0,0,,Мен үйленемін деп шештім.
Dialogue: 0,0:10:33.13,0:10:34.53,Default,,0,0,0,,Рұқсатсыз жалғыз
Dialogue: 0,0:10:34.76,0:10:36.76,Default,,0,0,0,,Бұл кәдімгі романтикалық оқиға. Мен
Dialogue: 0,0:10:36.96,0:10:37.99,Default,,0,0,0,,сияқты сезінемін
Dialogue: 0,0:10:38.40,0:10:39.60,Default,,0,0,0,,Мен түсінбеймін
Dialogue: 0,0:10:39.83,0:10:41.86,Default,,0,0,0,,Сіз шынымен түсінбейсіз
Dialogue: 0,0:10:42.06,0:10:42.99,Default,,0,0,0,,Мен оны ертерек көрдім.
Dialogue: 0,0:10:43.43,0:10:45.79,Default,,0,0,0,,Мен бір университетке бармаймын.
Dialogue: 0,0:10:46.10,0:10:47.70,Default,,0,0,0,,Кіру салтанатында буксирлеу
Dialogue: 0,0:10:47.70,0:10:49.60,Default,,0,0,0,,Ол сенің бетіңді раушан гүлімен ұратын әйел.
Dialogue: 0,0:10:50.43,0:10:51.43,Default,,0,0,0,,Бұл ең нашар
Dialogue: 0,0:10:51.83,0:10:52.99,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:10:53.36,0:10:54.39,Default,,0,0,0,,Ең нашар
Dialogue: 0,0:10:55.40,0:10:56.16,Default,,0,0,0,,Үміткерлер міндетті түрде
Dialogue: 0,0:10:56.16,0:10:58.06,Default,,0,0,0,,Керемет сценарий деген бар.
Dialogue: 0,0:10:58.60,0:10:59.93,Default,,0,0,0,,Маған жабысатын адам
Dialogue: 0,0:11:00.03,0:11:01.19,Default,,0,0,0,,Сол сценарий бойынша
Dialogue: 0,0:11:01.20,0:11:02.36,Default,,0,0,0,,Өйткені мен өз өмірімді жалғастырғым келеді
Dialogue: 0,0:11:02.36,0:11:03.16,Default,,0,0,0,,Тек
Dialogue: 0,0:11:04.03,0:11:05.69,Default,,0,0,0,,Мен бірдеңе істеуге тырысқанда
Dialogue: 0,0:11:06.40,0:11:08.20,Default,,0,0,0,,Су әртүрлі.
Dialogue: 0,0:11:08.36,0:11:11.36,Default,,0,0,0,,Бұл менің көлігімде жазылмаған.
Dialogue: 0,0:11:11.50,0:11:14.23,Default,,0,0,0,,Су туралы менің айтқанымды орында
Dialogue: 0,0:11:14.70,0:11:16.63,Default,,0,0,0,,Суды сору
Dialogue: 0,0:11:17.16,0:11:19.39,Default,,0,0,0,,Суды сору
Dialogue: 0,0:11:20.10,0:11:21.80,Default,,0,0,0,,Пан панорамасы Пан панорамасы
Dialogue: 0,0:11:25.13,0:11:26.06,Default,,0,0,0,,Мынадай
Dialogue: 0,0:11:26.50,0:11:27.30,Default,,0,0,0,,Иә
Dialogue: 0,0:11:27.66,0:11:28.89,Default,,0,0,0,,Бұлай емес еді.
Dialogue: 0,0:11:29.76,0:11:30.56,Default,,0,0,0,,Осыған ұқсас
Dialogue: 0,0:11:31.73,0:11:32.99,Default,,0,0,0,,Тікенектер жойылды.
Dialogue: 0,0:11:34.20,0:11:35.03,Default,,0,0,0,,Мынадай
Dialogue: 0,0:11:35.06,0:11:35.86,Default,,0,0,0,,Морио қаласы керемет орын.
Dialogue: 0,0:11:37.03,0:11:37.83,Default,,0,0,0,,Ми
Dialogue: 0,0:11:42.80,0:11:43.60,Default,,0,0,0,,Туо
Dialogue: 0,0:11:48.00,0:11:48.93,Default,,0,0,0,,Мынадай
Dialogue: 0,0:11:49.76,0:11:50.56,Default,,0,0,0,,Жоқ
Dialogue: 0,0:11:50.86,0:11:53.09,Default,,0,0,0,,Жоқ, балалар сонда.
Dialogue: 0,0:11:54.30,0:11:55.36,Default,,0,0,0,,Бағдаршамды тоқтату
Dialogue: 0,0:11:57.13,0:11:58.06,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:11:59.40,0:11:59.90,Default,,0,0,0,,Қазір
Dialogue: 0,0:11:59.86,0:12:01.46,Default,,0,0,0,,Бағдарлау аяқталды
Dialogue: 0,0:12:01.80,0:12:04.00,Default,,0,0,0,,Бүгіннен бастап музыка студенті
Dialogue: 0,0:12:04.50,0:12:06.23,Default,,0,0,0,,Саналы түрде әрекет ету
Dialogue: 0,0:12:06.86,0:12:07.66,Default,,0,0,0,,Бар болғаны
Dialogue: 0,0:12:18.86,0:12:19.79,Default,,0,0,0,,(Инумаки) Та… (Бірдеңенің тесіп өткен дыбысы)
Dialogue: 0,0:12:20.70,0:12:22.16,Default,,0,0,0,,Коуко-сан
Dialogue: 0,0:12:30.10,0:12:31.96,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:12:32.76,0:12:34.36,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:12:34.83,0:12:35.86,Default,,0,0,0,,Неге сен?
Dialogue: 0,0:12:36.23,0:12:37.19,Default,,0,0,0,,Бұл университеттің
Dialogue: 0,0:12:37.46,0:12:38.73,Default,,0,0,0,,Бұл заң факультеті
Dialogue: 0,0:12:39.00,0:12:40.33,Default,,0,0,0,,Осы бағытқа
Dialogue: 0,0:12:40.33,0:12:41.13,Default,,0,0,0,,Бар
Dialogue: 0,0:12:41.46,0:12:43.53,Default,,0,0,0,,Бұлар бұрын раушан гүлдерін таратқан адамдар.
Dialogue: 0,0:12:44.16,0:12:46.03,Default,,0,0,0,,Бірінші күннен бастап байқалды.
Dialogue: 0,0:12:47.00,0:12:48.33,Default,,0,0,0,,О, Яно мырза
Dialogue: 0,0:12:48.40,0:12:49.46,Default,,0,0,0,,Даусыңыз қатты
Dialogue: 0,0:12:49.70,0:12:51.93,Default,,0,0,0,,Мен оны Мицуоның қалауы бойынша бердім.
Dialogue: 0,0:12:52.53,0:12:54.66,Default,,0,0,0,,Мен де осында тіркелдім.
Dialogue: 0,0:12:54.80,0:12:55.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:55.96,0:12:57.26,Default,,0,0,0,,Ал, сен бақытты көрінесің.
Dialogue: 0,0:12:58.13,0:13:00.69,Default,,0,0,0,,Біз тағы төрт жыл бірге оқи аламыз.
Dialogue: 0,0:13:02.10,0:13:03.13,Default,,0,0,0,,Сценарий қандай болды?
Dialogue: 0,0:13:03.70,0:13:05.10,Default,,0,0,0,,Сіздің өмірлік сценарийіңізде
Dialogue: 0,0:13:05.56,0:13:06.09,Default,,0,0,0,,Дәл солай
Dialogue: 0,0:13:06.10,0:13:07.83,Default,,0,0,0,,Эскалатормен екі бөлікке барыңыз.
Dialogue: 0,0:13:08.30,0:13:09.50,Default,,0,0,0,,Университеттің үшінші курс студенті
Dialogue: 0,0:13:09.50,0:13:10.40,Default,,0,0,0,,Францияда шетелде оқу
Dialogue: 0,0:13:10.43,0:13:11.63,Default,,0,0,0,,Сіз мұны істеуіңіз керек емес пе еді?
Dialogue: 0,0:13:12.43,0:13:13.23,Default,,0,0,0,,Сонымен
Dialogue: 0,0:13:13.26,0:13:14.89,Default,,0,0,0,,Сән саласында мансап құру
Dialogue: 0,0:13:14.90,0:13:15.70,Default,,0,0,0,,Жарайды, екеу болсын.
Dialogue: 0,0:13:16.63,0:13:19.26,Default,,0,0,0,,Ол сөзсіз аздап өзгертуді қажет етеді.
Dialogue: 0,0:13:19.86,0:13:21.39,Default,,0,0,0,,Бірақ бұл үлкен мәселе емес.
Dialogue: 0,0:13:21.90,0:13:23.00,Default,,0,0,0,,Мицуомен
Dialogue: 0,0:13:23.06,0:13:24.93,Default,,0,0,0,,Мен университет өмірінен ләззат алуым керек.
Dialogue: 0,0:13:24.93,0:13:26.39,Default,,0,0,0,,Бұл мағынасыз
Dialogue: 0,0:13:27.56,0:13:28.36,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:13:28.36,0:13:29.76,Default,,0,0,0,,Сіз осы университетте оқыдыңыз ба?
Dialogue: 0,0:13:29.76,0:13:30.56,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:13:30.83,0:13:32.06,Default,,0,0,0,,Менің әкем
Dialogue: 0,0:13:32.20,0:13:33.83,Default,,0,0,0,,Түрлі университеттерге садақа беремін.
Dialogue: 0,0:13:33.83,0:13:34.63,Default,,0,0,0,,Сіз мұны білесіз.
Dialogue: 0,0:13:35.30,0:13:36.30,Default,,0,0,0,,Баспалдақпен жүріңіз
Dialogue: 0,0:13:36.40,0:13:38.63,Default,,0,0,0,,Сіз қалаған мектепті оңай таба аласыз.
Dialogue: 0,0:13:39.60,0:13:40.90,Default,,0,0,0,,Мицуо да бақытты болар еді, солай ма?
Dialogue: 0,0:13:41.60,0:13:44.16,Default,,0,0,0,,Сіз маған өте берілген сияқтысыз.
Dialogue: 0,0:13:45.56,0:13:46.53,Default,,0,0,0,,Мен бақытты емеспін
Dialogue: 0,0:13:46.93,0:13:47.96,Default,,0,0,0,,Мен бақыттымын.
Dialogue: 0,0:13:49.20,0:13:50.76,Default,,0,0,0,,Мүлдем бақытты емес
Dialogue: 0,0:13:50.90,0:13:52.83,Default,,0,0,0,,Мен шынымен бақыттымын, солай емес пе?
Dialogue: 0,0:13:53.40,0:13:55.10,Default,,0,0,0,,Мен бақытты емеспін.
Dialogue: 0,0:13:55.73,0:13:57.29,Default,,0,0,0,,Себебі мен сенен алыстағым келді
Dialogue: 0,0:13:57.30,0:13:58.36,Default,,0,0,0,,Сырттай емтихан тапсырсам да
Dialogue: 0,0:13:58.90,0:14:00.70,Default,,0,0,0,,Мұның бәрі бұзылды.
Dialogue: 0,0:14:01.53,0:14:02.33,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:14:03.86,0:14:04.99,Default,,0,0,0,,Көк
Dialogue: 0,0:14:05.40,0:14:06.60,Default,,0,0,0,,Хм, солай ма?
Dialogue: 0,0:14:06.70,0:14:09.73,Default,,0,0,0,,Мицуо – әйгілі мысал.
Dialogue: 0,0:14:10.60,0:14:12.93,Default,,0,0,0,,Тоқта
Dialogue: 0,0:14:13.40,0:14:14.20,Default,,0,0,0,,Уфу
Dialogue: 0,0:14:16.43,0:14:19.03,Default,,0,0,0,,Мицуоның жаңа досы
Dialogue: 0,0:14:19.56,0:14:20.86,Default,,0,0,0,,Ум.
Dialogue: 0,0:14:21.40,0:14:22.20,Default,,0,0,0,,Тегін
Dialogue: 0,0:14:22.53,0:14:23.53,Default,,0,0,0,,Шизуокада дүниеге келген
Dialogue: 0,0:14:23.53,0:14:25.43,Default,,0,0,0,,Мен Янагида мырзаны жаңа ғана кездестірдім.
Dialogue: 0,0:14:26.06,0:14:27.59,Default,,0,0,0,,Мен ханзадамын
Dialogue: 0,0:14:28.43,0:14:29.23,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:14:34.36,0:14:35.16,Default,,0,0,0,,О
Dialogue: 0,0:14:35.16,0:14:36.09,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:14:36.46,0:14:37.26,Default,,0,0,0,,Мицуо
Dialogue: 0,0:14:37.93,0:14:39.09,Default,,0,0,0,,Сәлем Ярасу-сан
Dialogue: 0,0:14:39.26,0:14:40.06,Default,,0,0,0,,Кага мырза
Dialogue: 0,0:14:42.06,0:14:42.86,Default,,0,0,0,,Atto
Dialogue: 0,0:14:49.26,0:14:50.06,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:14:50.33,0:14:51.73,Default,,0,0,0,,Мен саған оны алуға көмектесемін.
Dialogue: 0,0:14:53.60,0:14:54.40,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:14:54.63,0:14:55.43,Default,,0,0,0,,О
Dialogue: 0,0:14:55.70,0:14:56.50,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:14:58.30,0:14:59.66,Default,,0,0,0,,Шынымен колледж студенті
Dialogue: 0,0:15:00.23,0:15:01.96,Default,,0,0,0,,Енді мен сенің досыңмын
Dialogue: 0,0:15:02.73,0:15:04.23,Default,,0,0,0,,Бұл керемет болды.
Dialogue: 0,0:15:04.80,0:15:06.00,Default,,0,0,0,,Хм. Хахахаха
Dialogue: 0,0:15:07.03,0:15:07.83,Default,,0,0,0,,Бұл керемет болды
Dialogue: 0,0:15:07.93,0:15:08.73,Default,,0,0,0,,Әртүрлі заттар
Dialogue: 0,0:15:09.06,0:15:09.89,Default,,0,0,0,,Екеуі де
Dialogue: 0,0:15:10.06,0:15:11.49,Default,,0,0,0,,Ол өте әдемі еді.
Dialogue: 0,0:15:12.06,0:15:13.06,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:15:13.53,0:15:15.56,Default,,0,0,0,,Біз де дос бола аламыз ба?
Dialogue: 0,0:15:16.46,0:15:17.26,Default,,0,0,0,,Мен
Dialogue: 0,0:15:17.26,0:15:19.46,Default,,0,0,0,,Әдемі адамдарды көрсем, өзімді бақытты сезінемін.
Dialogue: 0,0:15:19.86,0:15:21.03,Default,,0,0,0,,Тіпті ер адамдар
Dialogue: 0,0:15:21.16,0:15:22.26,Default,,0,0,0,,Әйел болсаң да
Dialogue: 0,0:15:22.56,0:15:23.36,Default,,0,0,0,,Иә
Dialogue: 0,0:15:23.73,0:15:25.99,Default,,0,0,0,,Янагида мырзаның да сымбатты екені рас.
Dialogue: 0,0:15:28.16,0:15:29.73,Default,,0,0,0,,Менің ойымша, ол біртүрлі.
Dialogue: 0,0:15:33.53,0:15:36.16,Default,,0,0,0,,Менің атым Чинами Ока.
Dialogue: 0,0:15:36.40,0:15:38.03,Default,,0,0,0,,Мен жай ғана Банримін
Dialogue: 0,0:15:38.36,0:15:40.59,Default,,0,0,0,,Ойчинами
Dialogue: 0,0:15:42.76,0:15:43.79,Default,,0,0,0,,Олай болса, Тода-кун
Dialogue: 0,0:15:44.16,0:15:45.39,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:15:45.86,0:15:46.69,Default,,0,0,0,,Міне осы
Dialogue: 0,0:15:47.23,0:15:48.06,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:15:50.83,0:15:52.56,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:15:52.90,0:15:53.70,Default,,0,0,0,,Тода-кун
Dialogue: 0,0:15:54.03,0:15:55.63,Default,,0,0,0,,Біз дос болдық
Dialogue: 0,0:16:08.96,0:16:09.83,Default,,0,0,0,,Сіз доссыз ба?
Dialogue: 0,0:16:16.76,0:16:17.56,Default,,0,0,0,,Шабандоз
Dialogue: 0,0:16:27.56,0:16:29.39,Default,,0,0,0,,Иә, Кевин сонда.
Dialogue: 0,0:16:30.46,0:16:31.93,Default,,0,0,0,,Шетелде оқуыңыз құтты болсын
Dialogue: 0,0:16:33.33,0:16:35.16,Default,,0,0,0,,Е-е, қолымнан келмейді, қолымнан келмейді.
Dialogue: 0,0:16:35.83,0:16:37.53,Default,,0,0,0,,Мен комедияға қызықпаймын.
Dialogue: 0,0:16:37.80,0:16:39.53,Default,,0,0,0,,Бізде студенттердің жанды қойылымдары да бар.
Dialogue: 0,0:16:40.26,0:16:41.06,Default,,0,0,0,,Сәлем
Dialogue: 0,0:16:42.46,0:16:44.13,Default,,0,0,0,,- Қанша болса да -
Dialogue: 0,0:16:45.20,0:16:47.66,Default,,0,0,0,,Сіз кемпингті ұнататын сияқтысыз.
Dialogue: 0,0:16:47.80,0:16:49.56,Default,,0,0,0,,Ношуку зерттеу тобы осында.
Dialogue: 0,0:16:49.83,0:16:51.26,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:16:51.53,0:16:53.76,Default,,0,0,0,,Ұлдар да өте жақсы қабылданады.
Dialogue: 0,0:16:54.33,0:16:56.16,Default,,0,0,0,,Тек ішіп, ішіңіз.
Dialogue: 0,0:16:56.50,0:16:58.16,Default,,0,0,0,,Іш, іш, іш
Dialogue: 0,0:16:59.13,0:16:59.93,Default,,0,0,0,,Бобос
Dialogue: 0,0:17:00.73,0:17:01.53,Default,,0,0,0,,Хун
Dialogue: 0,0:17:02.36,0:17:03.16,Default,,0,0,0,,О
Dialogue: 0,0:17:04.70,0:17:07.16,Default,,0,0,0,,Қазір тамаша көрінеді
Dialogue: 0,0:17:09.70,0:17:10.50,Default,,0,0,0,,О сен
Dialogue: 0,0:17:10.60,0:17:13.13,Default,,0,0,0,,Танымал музыкалық зерттеу тобына мүшелік жарна төлеңіз
Dialogue: 0,0:17:13.80,0:17:14.30,Default,,0,0,0,,Жоқ, бұл
Dialogue: 0,0:17:14.16,0:17:15.46,Default,,0,0,0,,Бұл емес.
Dialogue: 0,0:17:15.46,0:17:17.33,Default,,0,0,0,,Оңай құтыла алмайсың.
Dialogue: 0,0:17:17.86,0:17:18.69,Default,,0,0,0,,Қашып кеткің келсе
Dialogue: 0,0:17:18.70,0:17:20.36,Default,,0,0,0,,Бізден асып кетіңіз
Dialogue: 0,0:17:20.46,0:17:21.43,Default,,0,0,0,,(Роко) Куфуфуфу. Мақтаның жараланды ма?
Dialogue: 0,0:17:28.26,0:17:29.06,Default,,0,0,0,,Жарайды
Dialogue: 0,0:17:29.36,0:17:30.63,Default,,0,0,0,,Ертең кешіріңіз
Dialogue: 0,0:17:33.00,0:17:33.80,Default,,0,0,0,,Мұнда өте ерекше бір отбасы тұрған
Dialogue: 0,0:17:47.23,0:17:50.03,Default,,0,0,0,,Кешіріңіз, мен аздап күшті болдым деп ойлаймын.
Dialogue: 0,0:17:50.33,0:17:51.13,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:51.40,0:17:52.56,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:17:54.53,0:17:55.86,Default,,0,0,0,,Бір жыл
Dialogue: 0,0:17:56.33,0:17:59.23,Default,,0,0,0,,Иә, бұл заң факультетінен келген Тадабан Ли.
Dialogue: 0,0:18:00.26,0:18:02.46,Default,,0,0,0,,I Линда
Dialogue: 0,0:18:03.03,0:18:03.83,Default,,0,0,0,,Линда
Dialogue: 0,0:18:04.26,0:18:05.79,Default,,0,0,0,,Шын аты: Хаяшида
Dialogue: 0,0:18:06.03,0:18:07.36,Default,,0,0,0,,Ормандағы күріш алқабы
Dialogue: 0,0:18:08.00,0:18:09.73,Default,,0,0,0,,Сондықтан мені Линда деп атайды
Dialogue: 0,0:18:10.60,0:18:12.50,Default,,0,0,0,,Шеңберді жинау - бұл шайқас.
Dialogue: 0,0:18:13.40,0:18:14.60,Default,,0,0,0,,Осындай кездер үшін
Dialogue: 0,0:18:14.60,0:18:15.56,Default,,0,0,0,,Мен оны өзіммен бірге алып жүремін.
Dialogue: 0,0:18:16.40,0:18:17.20,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:17.66,0:18:18.46,Default,,0,0,0,,Шынында да
Dialogue: 0,0:18:18.90,0:18:19.70,Default,,0,0,0,,Бұл жақсы, бұл жақсы
Dialogue: 0,0:18:20.10,0:18:21.56,Default,,0,0,0,,Жасөспірімдерге қамқорлық жасау
Dialogue: 0,0:18:21.76,0:18:22.96,Default,,0,0,0,,Өйткені бұл үлкендердің міндеті.
Dialogue: 0,0:18:26.16,0:18:26.99,Default,,0,0,0,,Линда-сенпай
Dialogue: 0,0:18:27.00,0:18:28.26,Default,,0,0,0,,Сіз қай шеңбердесіз?
Dialogue: 0,0:18:29.63,0:18:31.33,Default,,0,0,0,,Фестивальді зерттеу тобы дегеніміз не?
Dialogue: 0,0:18:31.90,0:18:32.40,Default,,0,0,0,,Бірақ
Dialogue: 0,0:18:32.30,0:18:34.60,Default,,0,0,0,,Уайымдамаңыз, біз сізді күштеп сұрамаймыз.
Dialogue: 0,0:18:35.40,0:18:36.73,Default,,0,0,0,,Бұл да байланыстың бір түрі.
Dialogue: 0,0:18:37.30,0:18:38.40,Default,,0,0,0,,Егер сізде қандай да бір қиындық болса
Dialogue: 0,0:18:38.40,0:18:39.66,Default,,0,0,0,,Сіз менімен кеңес ала аласыз.
Dialogue: 0,0:18:40.13,0:18:41.49,Default,,0,0,0,,Мен де заң факультетінің студентімін.
Dialogue: 0,0:18:42.43,0:18:43.23,Default,,0,0,0,,Джейн
Dialogue: 0,0:18:43.30,0:18:44.10,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:18:44.40,0:18:45.20,Default,,0,0,0,,Бұл
Dialogue: 0,0:18:45.73,0:18:46.53,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:18:47.33,0:18:48.16,Default,,0,0,0,,Ерін далабы
Dialogue: 0,0:18:48.96,0:18:50.46,Default,,0,0,0,,Өте әдемі
Dialogue: 0,0:18:50.63,0:18:53.03,Default,,0,0,0,,Ахх
Dialogue: 0,0:19:03.70,0:19:05.10,Default,,0,0,0,,Мен Токиоға келдім.
Dialogue: 0,0:19:05.86,0:19:06.66,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:19:08.33,0:19:09.13,Default,,0,0,0,,Мұнда
Dialogue: 0,0:19:09.70,0:19:10.20,Default,,0,0,0,,Жаңа
Dialogue: 0,0:19:10.03,0:19:11.89,Default,,0,0,0,,Мен өзімді қайта туатындай сезінемін.
Dialogue: 0,0:19:13.86,0:19:15.56,Default,,0,0,0,,Жаңа достармен кездесу
Dialogue: 0,0:19:17.26,0:19:18.83,Default,,0,0,0,,Жаңа бөлмеде тұру
Dialogue: 0,0:19:20.00,0:19:21.93,Default,,0,0,0,,Сіз жаңа әлемде өмір сүре аласыз
Dialogue: 0,0:19:24.00,0:19:24.80,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:19:25.46,0:19:26.26,Default,,0,0,0,,Көңілді
Dialogue: 0,0:19:26.96,0:19:27.79,Default,,0,0,0,,Орындалды
Dialogue: 0,0:19:28.66,0:19:30.26,Default,,0,0,0,,Жалғыздық немесе жалғыздық сезімі
Dialogue: 0,0:19:30.70,0:19:31.73,Default,,0,0,0,,Мен қателессем де
Dialogue: 0,0:19:32.80,0:19:34.43,Default,,0,0,0,,Барлығы алтындай жарқырайды
Dialogue: 0,0:19:35.20,0:19:36.36,Default,,0,0,0,,таң қалдырады
Dialogue: 0,0:19:37.10,0:19:38.13,Default,,0,0,0,,Күн сайын осылай
Dialogue: 0,0:19:38.56,0:19:39.93,Default,,0,0,0,,Мен кешігіп қалатын сияқтымын.
Dialogue: 0,0:19:40.90,0:19:42.10,Default,,0,0,0,,Осылай өмір сүре алсаң
Dialogue: 0,0:19:42.80,0:19:44.80,Default,,0,0,0,,Мүмкін мен бір күні ғашық болып қалармын
Dialogue: 0,0:19:47.33,0:19:48.13,Default,,0,0,0,,Мен ғашық болғым келеді
Dialogue: 0,0:19:50.20,0:19:51.00,Default,,0,0,0,,біреу
Dialogue: 0,0:19:51.60,0:19:52.56,Default,,0,0,0,,Барлығы менің жүрегімде
Dialogue: 0,0:19:52.56,0:19:53.49,Default,,0,0,0,,Барлығын лақтырыңыз
Dialogue: 0,0:19:53.50,0:19:54.66,Default,,0,0,0,,Мен осылай ойлағым келеді
Dialogue: 0,0:19:56.36,0:19:57.19,Default,,0,0,0,,бірақ істерді тым күрделендіру жүректе қорқыныш тудырады, ал Миста бұны жақсы нәрсе деп санамайды
Dialogue: 0,0:19:59.83,0:20:00.66,Default,,0,0,0,,Мұндай махаббат
Dialogue: 0,0:20:12.26,0:20:13.06,Default,,0,0,0,,О.
Dialogue: 0,0:20:13.40,0:20:14.96,Default,,0,0,0,,Сіз дәл қазір
Dialogue: 0,0:20:16.60,0:20:17.50,Default,,0,0,0,,Жақсы
Dialogue: 0,0:20:18.13,0:20:20.19,Default,,0,0,0,,Аттатада Банри
Dialogue: 0,0:20:21.13,0:20:21.99,Default,,0,0,0,,Жоқ, бірақ Йор-чан менің байқамай тұрғанымда үйленіп кеткеніне сенбеймін.
Dialogue: 0,0:20:22.30,0:20:23.50,Default,,0,0,0,,Мицуоны күту
Dialogue: 0,0:20:23.83,0:20:25.99,Default,,0,0,0,,Бұл адам осы жолмен жүруі керек.
Dialogue: 0,0:20:26.70,0:20:28.43,Default,,0,0,0,,Менімен ұялы телефон арқылы хабарласыңыз.
Dialogue: 0,0:20:28.70,0:20:30.33,Default,,0,0,0,,Шақырсам да жауап бермейсің.
Dialogue: 0,0:20:30.93,0:20:31.69,Default,,0,0,0,,Шынымен
Dialogue: 0,0:20:31.70,0:20:33.50,Default,,0,0,0,,Мицуо шыншыл емес.
Dialogue: 0,0:20:34.66,0:20:35.46,Default,,0,0,0,,Бірақ
Dialogue: 0,0:20:35.93,0:20:37.39,Default,,0,0,0,,Бұл сүйкімді.
Dialogue: 0,0:20:38.06,0:20:38.86,Default,,0,0,0,,Кира өзімен-өзі айналысып жүр ғой?
Dialogue: 0,0:20:39.06,0:20:39.86,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:20:44.40,0:20:45.20,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:20:45.23,0:20:46.03,Default,,0,0,0,,Банди
Dialogue: 0,0:20:46.36,0:20:47.39,Default,,0,0,0,,Бұрын нашар болды.
Dialogue: 0,0:20:47.83,0:20:49.19,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:20:49.23,0:20:50.03,Default,,0,0,0,,Әлі колледжде
Dialogue: 0,0:20:50.66,0:20:51.46,Default,,0,0,0,,Осымен
Dialogue: 0,0:20:51.63,0:20:53.16,Default,,0,0,0,,Бұл мен лақтырған материал.
Dialogue: 0,0:20:53.23,0:20:54.03,Default,,0,0,0,,О
Dialogue: 0,0:20:54.26,0:20:55.36,Default,,0,0,0,,О, онда мен істеймін.
Dialogue: 0,0:20:56.43,0:20:58.66,Default,,0,0,0,,Мицуо әлі колледжде, солай ма?
Dialogue: 0,0:20:58.80,0:21:00.80,Default,,0,0,0,,Неліктен ол жерде?
Dialogue: 0,0:21:01.00,0:21:02.10,Default,,0,0,0,,Мен қазір барамын
Dialogue: 0,0:21:02.33,0:21:03.23,Default,,0,0,0,,Қашпа
Dialogue: 0,0:21:03.46,0:21:05.19,Default,,0,0,0,,Әңгіме көп.
Dialogue: 0,0:21:05.63,0:21:06.43,Default,,0,0,0,,...
Dialogue: 0,0:21:08.76,0:21:10.43,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:21:11.36,0:21:12.49,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:12.83,0:21:14.36,Default,,0,0,0,,Мен оны қайтаруды ұмытып кетіппін.
Dialogue: 0,0:21:17.83,0:21:18.63,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:21:18.96,0:21:20.29,Default,,0,0,0,,Үздіксіз қолдауыңыз үшін рахмет.
Dialogue: 0,0:21:21.50,0:21:22.30,Default,,0,0,0,,Ах
Dialogue: 0,0:21:22.60,0:21:23.40,Default,,0,0,0,,Иә
Dialogue: 0,0:21:24.00,0:21:24.80,Default,,0,0,0,,Олай болса
Dialogue: 0,0:21:25.10,0:21:27.23,Default,,0,0,0,,Мицуо, қазір барайық.
Dialogue: 0,0:21:50.26,0:21:50.76,Default,,0,0,0,,Күту
Dialogue: 0,0:21:50.53,0:21:52.19,Default,,0,0,0,,Мен бұлай айтпауым керек еді.
Dialogue: 0,0:22:28.50,0:22:32.96,Default,,0,0,0,,Саған қарай ұмтылған сайын мен сергек, толқып тұрмын.
Dialogue: 0,0:22:55.53,0:22:56.03,Default,,0,0,0,,Шайқау
Dialogue: 0,0:22:55.96,0:22:58.43,Default,,0,0,0,,Тағы бір Скайда күн шуағы
Dialogue: 0,0:22:58.80,0:23:00.06,Default,,0,0,0,,Қол ұстасып көрейік
Dialogue: 0,0:23:22.06,0:23:22.86,Default,,0,0,0,,Қош бол
Dialogue: 0,0:23:27.60,0:23:29.46,Default,,0,0,0,,Фумбакане Мицуо
Dialogue: 0,0:23:29.70,0:23:32.00,Default,,0,0,0,,Мен попопопопон екенімді сене алар емеспін
Dialogue: 0,0:23:32.00,0:23:33.13,Default,,0,0,0,,Мен бұлай айта алмаймын.
Dialogue: 0,0:23:33.43,0:23:35.06,Default,,0,0,0,,Табылған су
Dialogue: 0,0:23:35.53,0:23:38.33,Default,,0,0,0,,Тоқта, үшемдер хохохохохохо
Dialogue: 0,0:23:38.50,0:23:39.63,Default,,0,0,0,,Хохохохохо
