Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.04,0:00:07.04,Default,,0,0,0,,♪～
Dialogue: 0,0:01:24.00,0:01:30.00,Default,,0,0,0,,～♪
Dialogue: 0,0:01:38.97,0:01:43.89,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:01:49.31,0:01:50.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:55.94,0:01:56.61,Default,,0,0,0,,Такеру
Dialogue: 0,0:01:56.74,0:01:58.36,Default,,0,0,0,,Апатқа жол бермеңіз!
Dialogue: 0,0:02:05.41,0:02:06.83,Default,,0,0,0,,Уау! ?
Dialogue: 0,0:02:08.37,0:02:11.67,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:02:11.79,0:02:13.09,Default,,0,0,0,,(бастау алдындағы ескерту дыбысы)
Dialogue: 0,0:02:13.21,0:02:14.50,Default,,0,0,0,,Қараңыз...
Dialogue: 0,0:02:15.00,0:02:20.80,Default,,0,0,0,,құрлық арқылы Пәкістанға бет алған
Dialogue: 0,0:02:21.72,0:02:24.26,Default,,0,0,0,,10 ９ ８
Dialogue: 0,0:02:24.47,0:02:28.23,Default,,0,0,0,,７ ６ ５ ４
Dialogue: 0,0:02:28.60,0:02:29.23,Default,,0,0,0,,３
Dialogue: 0,0:02:29.52,0:02:30.27,Default,,0,0,0,,２
Dialogue: 0,0:02:30.56,0:02:31.27,Default,,0,0,0,,１…
Dialogue: 0,0:02:34.94,0:02:36.90,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:02:45.99,0:02:47.20,Default,,0,0,0,,Ах
Dialogue: 0,0:02:51.33,0:02:52.71,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:53.75,0:02:56.05,Default,,0,0,0,,Такеру? Такеру!
Dialogue: 0,0:02:56.88,0:02:57.96,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:02:58.09,0:02:58.72,Default,,0,0,0,,Мен оны… есептей алмаймын.
Dialogue: 0,0:02:59.13,0:03:00.93,Default,,0,0,0,,О? Ой
Dialogue: 0,0:03:01.72,0:03:03.72,Default,,0,0,0,,құрлық арқылы Пәкістанға бет алған
Dialogue: 0,0:03:03.85,0:03:04.64,Default,,0,0,0,,Уау...
Dialogue: 0,0:03:05.26,0:03:08.52,Default,,0,0,0,,(үдеткіштің шырылдаған дыбысы)
Dialogue: 0,0:03:09.39,0:03:11.10,Default,,0,0,0,,Дыбыс бұрынғысынан мүлде басқаша.
Dialogue: 0,0:03:11.23,0:03:13.48,Default,,0,0,0,,Мен қазір қолымнан келгеннің бәрін жасадым.
Dialogue: 0,0:03:14.02,0:03:16.11,Default,,0,0,0,,Ол жарыс машинасына қатты ұқсай бастады.
Dialogue: 0,0:03:16.73,0:03:18.57,Default,,0,0,0,,Менің түтік жарысында әлі көп жолым бар.
Dialogue: 0,0:03:18.69,0:03:20.15,Default,,0,0,0,,А, түтік?
Dialogue: 0,0:03:20.28,0:03:22.70,Default,,0,0,0,,Жоқ! ? Мен соншалықты көп естіген емеспін
Dialogue: 0,0:03:23.03,0:03:25.03,Default,,0,0,0,,Бұл ең үлкен жарыс.
Dialogue: 0,0:03:25.28,0:03:26.24,Default,,0,0,0,,(Көліктің жүгіру дыбысы)
Dialogue: 0,0:03:26.58,0:03:27.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:33.67,0:03:34.79,Default,,0,0,0,,Ай сәулесі…
Dialogue: 0,0:03:35.04,0:03:36.09,Default,,0,0,0,,Тайра?
Dialogue: 0,0:03:42.68,0:03:44.26,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:03:45.89,0:03:50.43,Default,,0,0,0,,Мен сенің ол көлікпен жарыспайтыныңа сенімдімін, солай ма?
Dialogue: 0,0:03:50.60,0:03:52.14,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:03:52.35,0:03:55.73,Default,,0,0,0,,Бұлай шығуың әбігер.
Dialogue: 0,0:03:55.90,0:04:00.07,Default,,0,0,0,,Уайымдама, мен сенен бұрын жүгіремін.
Dialogue: 0,0:04:00.19,0:04:02.82,Default,,0,0,0,,Боу! Хахахахахаха...
Dialogue: 0,0:04:03.07,0:04:04.82,Default,,0,0,0,,(мүшелердің күлкісі)
Dialogue: 0,0:04:05.07,0:04:08.74,Default,,0,0,0,,құрлық арқылы Пәкістанға бет алған
Dialogue: 0,0:04:09.24,0:04:11.37,Default,,0,0,0,,құрлық арқылы Пәкістанға бет алған
Dialogue: 0,0:04:12.33,0:04:13.41,Default,,0,0,0,,Эй
Dialogue: 0,0:04:17.50,0:04:18.92,Default,,0,0,0,,(Тормоз дыбысы)
Dialogue: 0,0:04:19.59,0:04:21.05,Default,,0,0,0,,Жарысайық
Dialogue: 0,0:04:21.30,0:04:23.09,Default,,0,0,0,,Үш адам бар ма?
Dialogue: 0,0:04:23.34,0:04:24.93,Default,,0,0,0,,Тартпа! құдай!
Dialogue: 0,0:04:29.06,0:04:31.02,Default,,0,0,0,,Бірге орындайық
Dialogue: 0,0:04:31.39,0:04:32.56,Default,,0,0,0,,Жүр.
Dialogue: 0,0:04:32.89,0:04:33.98,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:34.19,0:04:35.77,Default,,0,0,0,,О, мен де бе?
Dialogue: 0,0:04:37.11,0:04:38.40,Default,,0,0,0,,Мақсат қандай?
Dialogue: 0,0:04:41.23,0:04:42.53,Default,,0,0,0,,Галилео мұнарасы туралы не деуге болады?
Dialogue: 0,0:04:45.61,0:04:47.91,Default,,0,0,0,,Жарайды... Наоми!
Dialogue: 0,0:04:52.95,0:04:54.71,Default,,0,0,0,,Барыңыз, ұрыңыз.
Dialogue: 0,0:04:56.58,0:04:58.42,Default,,0,0,0,,құрлық арқылы Пәкістанға бет алған
Dialogue: 0,0:04:58.84,0:05:00.55,Default,,0,0,0,,құрлық арқылы Пәкістанға бет алған
Dialogue: 0,0:05:01.46,0:05:02.26,Default,,0,0,0,,А…?
Dialogue: 0,0:05:02.38,0:05:05.13,Default,,0,0,0,,Жақында Едемде түн келеді
Dialogue: 0,0:05:05.72,0:05:07.80,Default,,0,0,0,,Жатақханаға қайтайық.
Dialogue: 0,0:05:08.85,0:05:12.10,Default,,0,0,0,,Жақында Едемде түн келеді
Dialogue: 0,0:05:12.43,0:05:14.43,Default,,0,0,0,,Жатақханаға қайтайық.
Dialogue: 0,0:05:16.89,0:05:19.06,Default,,0,0,0,,Үйге қайтайық, Тәкеру, уақыт болды.
Dialogue: 0,0:05:19.19,0:05:19.86,Default,,0,0,0,,А...
Dialogue: 0,0:05:21.48,0:05:22.94,Default,,0,0,0,,Такеру?
Dialogue: 0,0:05:23.40,0:05:26.57,Default,,0,0,0,,Жақында Едемде түн келеді
Dialogue: 0,0:05:26.82,0:05:29.03,Default,,0,0,0,,Жатақханаға қайтайық
Dialogue: 0,0:05:31.20,0:05:32.16,Default,,0,0,0,,Жүр!
Dialogue: 0,0:05:32.41,0:05:34.29,Default,,0,0,0,,(жүгіру дыбысы)
Dialogue: 0,0:05:34.66,0:05:35.50,Default,,0,0,0,,Эй!
Dialogue: 0,0:05:35.75,0:05:37.96,Default,,0,0,0,,Тайра! Құдай!
Dialogue: 0,0:05:38.12,0:05:39.83,Default,,0,0,0,,А... иә
Dialogue: 0,0:05:46.84,0:05:49.59,Default,,0,0,0,,Эй, мен үйге бара жатырмын.
Dialogue: 0,0:05:53.81,0:05:58.23,Default,,0,0,0,,Жақында Едемде түн келеді. Жатақханаға...
Dialogue: 0,0:05:58.60,0:06:00.10,Default,,0,0,0,,Тағы да
Dialogue: 0,0:06:00.52,0:06:02.40,Default,,0,0,0,,Едем жақында түн болады...
Dialogue: 0,0:06:02.52,0:06:03.82,Default,,0,0,0,,Тағы сәл ғана!
Dialogue: 0,0:06:10.87,0:06:12.58,Default,,0,0,0,,Такеру Барлығы осы.
Dialogue: 0,0:06:12.70,0:06:14.62,Default,,0,0,0,,Тайра, бұл жаман.
Dialogue: 0,0:06:15.29,0:06:17.41,Default,,0,0,0,,Сіз осындай жерге тоқтай аласыз ба?
Dialogue: 0,0:06:17.54,0:06:18.87,Default,,0,0,0,,Мен шешемін.
Dialogue: 0,0:06:19.62,0:06:21.00,Default,,0,0,0,,Олай болса, мақсатыңызды өзгертіңіз.
Dialogue: 0,0:06:21.13,0:06:24.42,Default,,0,0,0,,Алда №7 қақпа бар. Бұл мақсат.
Dialogue: 0,0:06:24.67,0:06:26.09,Default,,0,0,0,,Шешіңіз
Dialogue: 0,0:06:26.80,0:06:27.84,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:06:28.09,0:06:28.97,Default,,0,0,0,,Ой
Dialogue: 0,0:06:36.64,0:06:38.81,Default,,0,0,0,,Гош Бұл №7 қақпа.
Dialogue: 0,0:06:39.06,0:06:39.98,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:46.57,0:06:49.45,Default,,0,0,0,,Жақында Едемде түн келеді
Dialogue: 0,0:06:49.70,0:06:51.99,Default,,0,0,0,,Жатақханаға қайтайық
Dialogue: 0,0:06:52.32,0:06:53.78,Default,,0,0,0,,Жатақханаға қайтайық
Dialogue: 0,0:06:56.49,0:06:57.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:59.87,0:07:00.54,Default,,0,0,0,,Такеру!
Dialogue: 0,0:07:01.37,0:07:02.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:05.55,0:07:06.55,Default,,0,0,0,,Иә
Dialogue: 0,0:07:07.55,0:07:09.63,Default,,0,0,0,,(тайғақ дыбыс)
Dialogue: 0,0:07:15.30,0:07:18.52,Default,,0,0,0,,Қат! Неге, қарғыс атсын!
Dialogue: 0,0:07:20.35,0:07:21.48,Default,,0,0,0,,Ей, тыңда—
Dialogue: 0,0:07:22.35,0:07:23.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:23.60,0:07:28.44,Default,,0,0,0,,Көлік өрті А-18 аймағында болды. Ауданға кіруге тыйым салынады.
Dialogue: 0,0:07:28.61,0:07:33.74,Default,,0,0,0,,Көлік өрті А-18 аймағында орын алды. Ауданға кіруге тыйым салынады.
Dialogue: 0,0:07:37.70,0:07:40.08,Default,,0,0,0,,Takeru BD4483M
Dialogue: 0,0:07:40.33,0:07:43.96,Default,,0,0,0,,Сіз өзгертілген көліктің салдарынан болған өрт оқиғасының қатысушысы екеніңізді мойындайсыз ба?
Dialogue: 0,0:07:44.21,0:07:45.38,Default,,0,0,0,,Иә
Dialogue: 0,0:07:45.67,0:07:48.25,Default,,0,0,0,,Казума CC4459M
Dialogue: 0,0:07:48.50,0:07:51.13,Default,,0,0,0,,Сіз бұл апатқа қатысы бар екеніңізді мойындайсыз ба?
Dialogue: 0,0:07:51.38,0:07:52.55,Default,,0,0,0,,Қабылдау
Dialogue: 0,0:07:52.68,0:07:56.01,Default,,0,0,0,,Бисмарк CL4496M
Dialogue: 0,0:07:56.51,0:07:58.56,Default,,0,0,0,,Сіз бұл апатқа қатысы бар екеніңізді мойындайсыз ба?
Dialogue: 0,0:07:58.89,0:08:01.23,Default,,0,0,0,,Мм... мен...
Dialogue: 0,0:08:01.73,0:08:03.56,Default,,0,0,0,,Мен... Мен ерекше емеспін...
Dialogue: 0,0:08:04.02,0:08:05.94,Default,,0,0,0,,Мен оны бұрандалармен өзгертуге көмектестім.
Dialogue: 0,0:08:06.19,0:08:06.86,Default,,0,0,0,,Такеру! ?
Dialogue: 0,0:08:07.06,0:08:09.36,Default,,0,0,0,,Мен оны мәжбүрледім.
Dialogue: 0,0:08:09.48,0:08:12.07,Default,,0,0,0,,Ол маған еріксіз көмектесті.
Dialogue: 0,0:08:12.45,0:08:15.70,Default,,0,0,0,,Сіздің әрекеттеріңіз азаматтардың қауіпсіздігіне қатер төндірді.
Dialogue: 0,0:08:15.87,0:08:20.37,Default,,0,0,0,,Сондықтан Такеру де, Казума да 3 (үш) сыныптағы ерікті әрекеттерге ие.
Dialogue: 0,0:08:20.58,0:08:23.96,Default,,0,0,0,,Такеру 10 сағат сұрайды Казума 5 сағат сұрайды
Dialogue: 0,0:08:24.08,0:08:28.04,Default,,0,0,0,,Бисмарктан 1-сыныптағы 5 сағат ерікті уақытын сұраңыз.
Dialogue: 0,0:08:29.17,0:08:30.38,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:32.84,0:08:34.13,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:08:34.26,0:08:36.64,Default,,0,0,0,,Әзірше мені тартып кетіңізші, себебі ол сіздікі.
Dialogue: 0,0:08:36.76,0:08:38.97,Default,,0,0,0,,А, жөндеу ертең.
Dialogue: 0,0:08:39.10,0:08:41.27,Default,,0,0,0,,Мм... (Казума Такеру) А?
Dialogue: 0,0:08:41.39,0:08:43.18,Default,,0,0,0,,Білесің бе, мен...
Dialogue: 0,0:08:44.19,0:08:44.85,Default,,0,0,0,,Эй!
Dialogue: 0,0:08:45.73,0:08:48.02,Default,,0,0,0,,Не дұрыс болмады? иә?
Dialogue: 0,0:08:48.69,0:08:50.82,Default,,0,0,0,,Тираны жеңетін машина бола ма?
Dialogue: 0,0:08:51.40,0:08:53.61,Default,,0,0,0,,А... Мен байқап көрейін.
Dialogue: 0,0:08:53.99,0:08:55.49,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:09:03.66,0:09:07.38,Default,,0,0,0,,Жақында сіз Айдағы Едем қаласындағы қоғамның мүшесі боласыз.
Dialogue: 0,0:09:08.38,0:09:11.46,Default,,0,0,0,,Оған дейінгі еркіндік бүгіннен бастап сізге беріледі.
Dialogue: 0,0:09:19.93,0:09:23.22,Default,,0,0,0,,Takeru Әрі қарай, барлық C саны клапандарын толығымен ашыңыз.
Dialogue: 0,0:09:23.81,0:09:25.73,Default,,0,0,0,,C… C Ct…
Dialogue: 0,0:09:26.81,0:09:27.77,Default,,0,0,0,,Қандай C?
Dialogue: 0,0:09:28.48,0:09:30.23,Default,,0,0,0,,Бұл «С» әрпі бар!
Dialogue: 0,0:09:31.82,0:09:34.86,Default,,0,0,0,,Кешегі апатқа сенің кінәң болды!
Dialogue: 0,0:09:34.99,0:09:37.20,Default,,0,0,0,,Еріктілік танытқаныңыз үшін рахмет.
Dialogue: 0,0:09:37.41,0:09:39.20,Default,,0,0,0,,Сіз жұмысқа орналасуға өтініш бердіңіз бе?
Dialogue: 0,0:09:39.37,0:09:39.99,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:09:40.12,0:09:41.12,Default,,0,0,0,,Ойлану!
Dialogue: 0,0:09:41.49,0:09:42.20,Default,,0,0,0,,Тек жағдайда
Dialogue: 0,0:09:42.66,0:09:45.08,Default,,0,0,0,,А... Бис, сен не істедің?
Dialogue: 0,0:09:45.66,0:09:47.58,Default,,0,0,0,,Бұл жақсы, проблема жоқ.
Dialogue: 0,0:09:48.17,0:09:51.50,Default,,0,0,0,,Жарайды, мен қалаған жұмысқа орналаса алмаймын.
Dialogue: 0,0:09:51.75,0:09:54.01,Default,,0,0,0,,Неліктен мен өзіме ұнайтын нәрсені таңдай алмаймын?
Dialogue: 0,0:09:54.13,0:09:57.93,Default,,0,0,0,,Бастауыш сыныпта жүргенде мұндай сұрақтарды қоюды доғар.
Dialogue: 0,0:10:00.60,0:10:01.68,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:10:01.80,0:10:02.72,Default,,0,0,0,,О! ?
Dialogue: 0,0:10:02.85,0:10:04.43,Default,,0,0,0,,Сіз неге таң қалдыңыз? Ах...
Dialogue: 0,0:10:04.60,0:10:06.39,Default,,0,0,0,,Мен оның келеді деп шынымен күтпедім.
Dialogue: 0,0:10:06.77,0:10:08.56,Default,,0,0,0,,Себебі мен демалыстамын.
Dialogue: 0,0:10:08.69,0:10:10.23,Default,,0,0,0,,Бауырым, сен шынымен де бәйгеге барасың ба?
Dialogue: 0,0:10:10.35,0:10:12.36,Default,,0,0,0,,Жоқ, мен сені қолдаймын.
Dialogue: 0,0:10:12.48,0:10:13.48,Default,,0,0,0,,Ах... сонда...
Dialogue: 0,0:10:13.73,0:10:15.32,Default,,0,0,0,,Такеру есіңізде ме?
Dialogue: 0,0:10:15.44,0:10:17.40,Default,,0,0,0,,Арх... Ааа!
Dialogue: 0,0:10:17.53,0:10:18.74,Default,,0,0,0,,Кя!
Dialogue: 0,0:10:19.49,0:10:20.78,Default,,0,0,0,,Жоқ... у...
Dialogue: 0,0:10:20.91,0:10:23.16,Default,,0,0,0,,Төменнен төмен қарайтын сияқтымын.
Dialogue: 0,0:10:23.28,0:10:24.58,Default,,0,0,0,,Жарысқа дайындық...
Dialogue: 0,0:10:24.83,0:10:27.96,Default,,0,0,0,,Бұл Такеру Чио, біреуі төменде...
Dialogue: 0,0:10:28.08,0:10:29.54,Default,,0,0,0,,Әй, Такеру-сан?
Dialogue: 0,0:10:29.83,0:10:31.92,Default,,0,0,0,,А-а... Чиё-чан?
Dialogue: 0,0:10:32.42,0:10:34.25,Default,,0,0,0,,Тәкерумен танысқаныма 6-7 жыл болды.
Dialogue: 0,0:10:34.38,0:10:35.21,Default,,0,0,0,,Бұрандалы бар
Dialogue: 0,0:10:35.59,0:10:37.13,Default,,0,0,0,,Мен осы жерде уақыт желісін өзгертемін.
Dialogue: 0,0:10:38.67,0:10:39.63,Default,,0,0,0,,Сәлем
Dialogue: 0,0:10:40.05,0:10:41.59,Default,,0,0,0,,Уф! ? Сәлем
Dialogue: 0,0:10:43.26,0:10:43.93,Default,,0,0,0,,Хехе
Dialogue: 0,0:10:46.81,0:10:53.44,Default,,0,0,0,,(есіктің ашылуы және ескерту дыбысы)
Dialogue: 0,0:11:04.99,0:11:06.20,Default,,0,0,0,,Сәлем студент
Dialogue: 0,0:11:07.29,0:11:09.16,Default,,0,0,0,,Мен оқуды бітірдім, жұмыс күтемін.
Dialogue: 0,0:11:09.54,0:11:10.54,Default,,0,0,0,,Ерікті
Dialogue: 0,0:11:10.92,0:11:12.79,Default,,0,0,0,,Шағымды доғар да, тұр!
Dialogue: 0,0:11:17.38,0:11:19.92,Default,,0,0,0,,Барлық еріктілер, осы жерді басыңыз.
Dialogue: 0,0:11:25.10,0:11:28.27,Default,,0,0,0,,Айтпасаң, дәл осы жерде жазылғандай неге жазып бермейсің?
Dialogue: 0,0:11:29.14,0:11:31.39,Default,,0,0,0,,Бірақ мұндай көп мөлшердегі алкогольді тарату...
Dialogue: 0,0:11:31.52,0:11:33.35,Default,,0,0,0,,Жеке тұлғаларға рұқсат етілмейді
Dialogue: 0,0:11:33.60,0:11:38.48,Default,,0,0,0,,Жас жігіт! Мен ерекшемін, сондықтан маған қоңырау шалыңыз!
Dialogue: 0,0:11:38.61,0:11:40.49,Default,,0,0,0,,Мм... қария
Dialogue: 0,0:11:40.78,0:11:43.45,Default,,0,0,0,,А? Не, оны маған бересің бе?
Dialogue: 0,0:11:43.78,0:11:47.87,Default,,0,0,0,,Остеопороздың алдын алуға арналған псевдогравитациялық орталық осы жерде.
Dialogue: 0,0:11:50.96,0:11:51.96,Default,,0,0,0,,Барка Монга!
Dialogue: 0,0:11:52.08,0:11:53.58,Default,,0,0,0,,Уау аа
Dialogue: 0,0:11:53.96,0:11:55.13,Default,,0,0,0,,Ах!?
Dialogue: 0,0:11:55.79,0:11:57.17,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:11:57.29,0:11:59.05,Default,,0,0,0,,Сонымен... бұл куртка.
Dialogue: 0,0:11:59.55,0:12:00.71,Default,,0,0,0,,«Аполлон»
Dialogue: 0,0:12:01.34,0:12:02.30,Default,,0,0,0,,Мен—
Dialogue: 0,0:12:07.01,0:12:08.72,Default,,0,0,0,,Казума Иә?
Dialogue: 0,0:12:08.85,0:12:11.10,Default,,0,0,0,,Қараңызшы, иә?
Dialogue: 0,0:12:29.99,0:12:31.62,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:12:32.08,0:12:34.08,Default,,0,0,0,,О, бұл керемет.
Dialogue: 0,0:12:34.75,0:12:36.17,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:12:36.33,0:12:38.63,Default,,0,0,0,,А, бұл басқа тақырып, бірақ а?
Dialogue: 0,0:12:39.00,0:12:41.42,Default,,0,0,0,,Жарыста Тайрадан жеңілмеймін.
Dialogue: 0,0:12:43.05,0:12:45.59,Default,,0,0,0,,Бірақ мұнда адамдар көп.
Dialogue: 0,0:12:45.97,0:12:47.09,Default,,0,0,0,,Мүше?
Dialogue: 0,0:12:47.22,0:12:49.64,Default,,0,0,0,,Ол аспаннан түспейді
Dialogue: 0,0:12:49.76,0:12:50.76,Default,,0,0,0,,Не?
Dialogue: 0,0:12:51.18,0:12:53.52,Default,,0,0,0,,Сіздің әпкеңіз...
Dialogue: 0,0:12:53.64,0:12:54.27,Default,,0,0,0,,Чио?
Dialogue: 0,0:12:54.60,0:12:57.06,Default,,0,0,0,,Маған келіп қолдау көрсете аласыз ба?
Dialogue: 0,0:12:57.19,0:12:59.61,Default,,0,0,0,,Қолдау? О, шілтер?
Dialogue: 0,0:12:59.73,0:13:00.73,Default,,0,0,0,,А, жоқ па?
Dialogue: 0,0:13:00.98,0:13:01.98,Default,,0,0,0,,Сізге қоңырау шалайын ба?
Dialogue: 0,0:13:02.32,0:13:04.53,Default,,0,0,0,,Шынымен бе? сізбен танысқаныма қуаныштымын!
Dialogue: 0,0:13:04.99,0:13:07.41,Default,,0,0,0,,Студент! Мен жалқау болып тұрмын
Dialogue: 0,0:13:07.78,0:13:08.99,Default,,0,0,0,,Иә
Dialogue: 0,0:13:09.12,0:13:10.37,Default,,0,0,0,,Иә
Dialogue: 0,0:13:23.13,0:13:24.47,Default,,0,0,0,,Мені қашаннан бері ұнатасың?
Dialogue: 0,0:13:25.05,0:13:25.84,Default,,0,0,0,,Ах! ?
Dialogue: 0,0:13:28.05,0:13:28.89,Default,,0,0,0,,Эй... Иә!
Dialogue: 0,0:13:29.01,0:13:33.35,Default,,0,0,0,,Жоқ, бұрын мен бұл туралы мүлдем білмедім.
Dialogue: 0,0:13:33.64,0:13:35.89,Default,,0,0,0,,Иә? Мен оны көптен бері жеп жүрмін.
Dialogue: 0,0:13:36.27,0:13:37.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:37.77,0:13:38.56,Default,,0,0,0,,Бұл?
Dialogue: 0,0:13:38.69,0:13:41.65,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:13:41.86,0:13:43.19,Default,,0,0,0,,Мен түсемін.
Dialogue: 0,0:14:06.30,0:14:08.80,Default,,0,0,0,,Жеке куәлігімізбен осындай жерден өте аламыз ба?
Dialogue: 0,0:14:09.09,0:14:11.22,Default,,0,0,0,,Жарайды, мен кодты үйрендім.
Dialogue: 0,0:14:18.44,0:14:21.90,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:14:42.33,0:14:44.38,Default,,0,0,0,,Ｄ Ｏ Ｍ…
Dialogue: 0,0:14:44.50,0:14:45.46,Default,,0,0,0,,ＤＯＭ？
Dialogue: 0,0:14:45.59,0:14:46.92,Default,,0,0,0,,Эй
Dialogue: 0,0:14:47.30,0:14:48.05,Default,,0,0,0,,Ах
Dialogue: 0,0:14:48.88,0:14:50.51,Default,,0,0,0,,Эй
Dialogue: 0,0:14:50.76,0:14:51.76,Default,,0,0,0,,Хехе, Алан мырза
Dialogue: 0,0:14:51.89,0:14:52.93,Default,,0,0,0,,Мм, мм
Dialogue: 0,0:14:55.89,0:14:57.68,Default,,0,0,0,,Тезірек шыққыңыз келе ме?
Dialogue: 0,0:14:57.81,0:14:59.77,Default,,0,0,0,,Хехехехехе
Dialogue: 0,0:15:04.02,0:15:04.90,Default,,0,0,0,,Дегенмен, менің ойымша, бұл жақсы жоспар.
Dialogue: 0,0:15:06.73,0:15:10.65,Default,,0,0,0,,Уа, уай, у...
Dialogue: 0,0:15:13.07,0:15:14.66,Default,,0,0,0,,О, бұл не?
Dialogue: 0,0:15:14.99,0:15:16.66,Default,,0,0,0,,Аполлон – Аполлон
Dialogue: 0,0:15:17.04,0:15:17.79,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:15:18.12,0:15:20.75,Default,,0,0,0,,Ештеңені білмей әлгі күртешені киесің бе?
Dialogue: 0,0:15:21.17,0:15:24.96,Default,,0,0,0,,Жоқ, ескірген сезім ерекшелене ме деп ойлаймын...
Dialogue: 0,0:15:25.09,0:15:26.75,Default,,0,0,0,,«Аполлон» дегеніміз не?
Dialogue: 0,0:15:27.63,0:15:33.22,Default,,0,0,0,,1969 жылы адамдарды Жерден Айға алғаш жеткізген кеменің аты.
Dialogue: 0,0:15:33.59,0:15:35.72,Default,,0,0,0,,Демек, бұл 300 жыл бұрын?
Dialogue: 0,0:15:35.89,0:15:37.47,Default,,0,0,0,,Жарайды, бұл көшірме шығар.
Dialogue: 0,0:15:37.60,0:15:38.68,Default,,0,0,0,,Алан ше?
Dialogue: 0,0:15:38.93,0:15:41.56,Default,,0,0,0,,Мен мұны «шынайы» деп айтқым келеді, бірақ бұл шындық.
Dialogue: 0,0:15:41.94,0:15:44.36,Default,,0,0,0,,Бұл ескі Жер ме?
Dialogue: 0,0:15:45.77,0:15:47.73,Default,,0,0,0,,Жердегі аспан да көк түсті.
Dialogue: 0,0:15:48.11,0:15:53.66,Default,,0,0,0,,Бұл керісінше. Едем күмбезінің төбесі Жер аспанының қайталануы болып табылады.
Dialogue: 0,0:15:54.11,0:15:55.45,Default,,0,0,0,,Баяғыда
Dialogue: 0,0:15:55.57,0:15:58.83,Default,,0,0,0,,Бүгінгі жер адам өмір сүре алмайтын жер.
Dialogue: 0,0:15:59.79,0:16:00.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:01.46,0:16:03.21,Default,,0,0,0,,Сәлем Алан, мысал қандай?
Dialogue: 0,0:16:03.33,0:16:07.21,Default,,0,0,0,,Иә, сіз көлікті жылдамдатқыңыз келді.
Dialogue: 0,0:16:07.96,0:16:10.05,Default,,0,0,0,,Е, эй, эй... (құлаған заттардың дыбысы)
Dialogue: 0,0:16:10.80,0:16:11.76,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:16:12.09,0:16:13.43,Default,,0,0,0,,Nu
Dialogue: 0,0:16:13.63,0:16:15.76,Default,,0,0,0,,Nu... ni!
Dialogue: 0,0:16:16.30,0:16:19.10,Default,,0,0,0,,Бұл керемет жеделдету хи хи хи хи...
Dialogue: 0,0:16:48.34,0:16:50.42,Default,,0,0,0,,(сорпаның шырылдаған дыбысы)
Dialogue: 0,0:16:51.34,0:16:52.55,Default,,0,0,0,,Ахх
Dialogue: 0,0:16:52.80,0:16:53.55,Default,,0,0,0,,Өзің де қатты шаршаған сияқтысың.
Dialogue: 0,0:16:54.01,0:16:55.09,Default,,0,0,0,,Жарық Иә
Dialogue: 0,0:16:59.64,0:17:01.43,Default,,0,0,0,,Надан ақымақ
Dialogue: 0,0:17:03.23,0:17:05.39,Default,,0,0,0,,...Сіз тек бір рет күшейте аласыз.
Dialogue: 0,0:17:05.85,0:17:08.77,Default,,0,0,0,,Бұл керемет күш, сондықтан сызықта қателеспеңіз.
Dialogue: 0,0:17:09.15,0:17:10.61,Default,,0,0,0,,Сіз мені тыңдайсыз ба?
Dialogue: 0,0:17:10.77,0:17:12.99,Default,,0,0,0,,Ой, жаман, мен мұны естімедім.
Dialogue: 0,0:17:14.32,0:17:16.70,Default,,0,0,0,,Концентрат. Сіз жеңуге тырысасыз ба?
Dialogue: 0,0:17:16.86,0:17:18.70,Default,,0,0,0,,Иә, мен жеңемін.
Dialogue: 0,0:17:18.95,0:17:20.66,Default,,0,0,0,,Иә... онда жақсы.
Dialogue: 0,0:17:20.91,0:17:24.50,Default,,0,0,0,,Мен жеңуім керек... Жеңбесем, алға жылжи алмаймын.
Dialogue: 0,0:17:30.09,0:17:33.17,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:17:33.55,0:17:36.22,Default,,0,0,0,,６ ５ ４
Dialogue: 0,0:17:36.59,0:17:37.26,Default,,0,0,0,,３
Dialogue: 0,0:17:37.63,0:17:38.26,Default,,0,0,0,,２
Dialogue: 0,0:17:38.64,0:17:39.39,Default,,0,0,0,,１…
Dialogue: 0,0:17:43.18,0:17:45.60,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:23.31,0:18:23.93,Default,,0,0,0,,Дааа
Dialogue: 0,0:18:27.23,0:18:28.56,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:18:28.89,0:18:29.69,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:18:36.74,0:18:37.57,Default,,0,0,0,,Ах, сонда ол ма еді?
Dialogue: 0,0:18:40.53,0:18:41.87,Default,,0,0,0,,Уа! ! Ахх
Dialogue: 0,0:18:46.50,0:18:47.58,Default,,0,0,0,,Құдай!
Dialogue: 0,0:19:07.14,0:19:07.93,Default,,0,0,0,,Иә
Dialogue: 0,0:19:16.15,0:19:17.11,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:18.57,0:19:19.24,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:28.58,0:19:29.58,Default,,0,0,0,,Жоқ, мен осы жолы шындап тұрмын! Жоғарғы қабатта өлі дене жатыр.
Dialogue: 0,0:19:49.02,0:19:49.68,Default,,0,0,0,,Әлде бұл өкпеден бе? Карс
Dialogue: 0,0:19:49.81,0:19:50.68,Default,,0,0,0,,Уау
Dialogue: 0,0:19:54.44,0:19:55.19,Default,,0,0,0,,Такеру!
Dialogue: 0,0:19:56.32,0:19:57.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:00.99,0:20:02.20,Default,,0,0,0,,Гууууууууууу!
Dialogue: 0,0:20:08.24,0:20:09.12,Default,,0,0,0,,Уау! ?
Dialogue: 0,0:20:13.54,0:20:16.96,Default,,0,0,0,,Уаааааааааааааааааааааааааа
Dialogue: 0,0:20:21.72,0:20:23.76,Default,,0,0,0,,Ылғалды...балапан шоуы
Dialogue: 0,0:20:24.34,0:20:26.47,Default,,0,0,0,,Тек түзу сызықта жүруге мүмкіндік беретін өзгертулерді жасамаңыз.
Dialogue: 0,0:20:26.60,0:20:30.68,Default,,0,0,0,,Сонымен! Саған сақтықпен жүруді айттым.
Dialogue: 0,0:20:30.81,0:20:31.56,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:20:31.68,0:20:32.60,Default,,0,0,0,,О
Dialogue: 0,0:20:34.19,0:20:35.90,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:20:36.27,0:20:38.23,Default,,0,0,0,,А, аа, у...
Dialogue: 0,0:20:38.69,0:20:40.03,Default,,0,0,0,,Чио-чан
Dialogue: 0,0:20:40.48,0:20:41.74,Default,,0,0,0,,Ұф… Ха…
Dialogue: 0,0:20:45.45,0:20:47.16,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:20:49.79,0:20:50.79,Default,,0,0,0,,Ха~а
Dialogue: 0,0:20:50.91,0:20:51.62,Default,,0,0,0,,А…?
Dialogue: 0,0:20:51.75,0:20:54.41,Default,,0,0,0,,Takeru BD4483M
Dialogue: 0,0:20:54.83,0:20:57.00,Default,,0,0,0,,Жақында еріктілер уақыты келеді
Dialogue: 0,0:20:57.54,0:21:00.21,Default,,0,0,0,,Жақында волонтерлік уақыт
Dialogue: 0,0:21:02.42,0:21:04.59,Default,,0,0,0,,Тексеру Мәселе жоқ
Dialogue: 0,0:21:04.97,0:21:06.59,Default,,0,0,0,,Тексеру Мәселе жоқ
Dialogue: 0,0:21:06.97,0:21:08.97,Default,,0,0,0,,Тексеру Мәселе жоқ
Dialogue: 0,0:21:09.47,0:21:10.93,Default,,0,0,0,,Тексеру Мәселе жоқ
Dialogue: 0,0:21:11.31,0:21:15.31,Default,,0,0,0,,Мәселе жоқ Проблема жоқ Ақаулық жоқ Ақаулық жоқ
Dialogue: 0,0:21:15.44,0:21:18.31,Default,,0,0,0,,Проблема жоқ Увааааааааааааааааааааааааа
Dialogue: 0,0:21:22.48,0:21:25.78,Default,,0,0,0,,Күнбақау
Dialogue: 0,0:21:26.66,0:21:28.12,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:21:29.37,0:21:30.66,Default,,0,0,0,,Метеорит?
Dialogue: 0,0:21:43.26,0:21:44.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:45.30,0:21:47.97,Default,,0,0,0,,«Бізде бәрі жақсы»
