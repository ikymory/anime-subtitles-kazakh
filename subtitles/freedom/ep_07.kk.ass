Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.84,0:00:17.10,Default,,0,0,0,,Керемет. Бұл Эйден бе?
Dialogue: 0,0:00:17.39,0:00:19.01,Default,,0,0,0,,Иә
Dialogue: 0,0:00:20.97,0:00:23.39,Default,,0,0,0,,Сізді күттіргенім үшін кешіріңіз, Казума.
Dialogue: 0,0:00:23.52,0:00:24.94,Default,,0,0,0,,Уау?
Dialogue: 0,0:00:33.07,0:00:39.08,Default,,0,0,0,,♪～
Dialogue: 0,0:01:55.99,0:02:01.99,Default,,0,0,0,,～♪
Dialogue: 0,0:02:23.97,0:02:25.68,Default,,0,0,0,,Такеру…
Dialogue: 0,0:02:26.35,0:02:28.64,Default,,0,0,0,,Эй, бұл шынымен Такеру ма?
Dialogue: 0,0:02:29.81,0:02:30.90,Default,,0,0,0,,Эй!
Dialogue: 0,0:02:32.81,0:02:33.48,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:02:33.90,0:02:37.40,Default,,0,0,0,,Бұл Гош. Бұрынғы Moonshine мүшесі Гош.
Dialogue: 0,0:02:37.86,0:02:39.32,Default,,0,0,0,,«Ай»?
Dialogue: 0,0:02:40.11,0:02:41.36,Default,,0,0,0,,Солай ма? Казума ше?
Dialogue: 0,0:02:42.57,0:02:45.45,Default,,0,0,0,,Мен сені көруге келмеймін. Бұл дегеніміз осы.
Dialogue: 0,0:02:46.62,0:02:48.71,Default,,0,0,0,,Мен Казуманы алып кетуге келдім.
Dialogue: 0,0:02:48.83,0:02:53.04,Default,,0,0,0,,Қазір ол менеджер, өзі басқарады.
Dialogue: 0,0:02:53.17,0:02:55.17,Default,,0,0,0,,Ешқандай себеп жоқ...
Dialogue: 0,0:02:55.84,0:03:00.93,Default,,0,0,0,,Бұл сенгісіз, өйткені ол бұрынғы сотталған және қазір жауапты.
Dialogue: 0,0:03:01.18,0:03:03.43,Default,,0,0,0,,Шындықты кездейсоқ білген Казума сияқты адамдар...
Dialogue: 0,0:03:04.18,0:03:06.93,Default,,0,0,0,,Бұл олардың басқару жағында қажетті адам ресурстары екенін білдіреді.
Dialogue: 0,0:03:08.06,0:03:10.81,Default,,0,0,0,,Казума - бұл... дос.
Dialogue: 0,0:03:12.40,0:03:16.52,Default,,0,0,0,,Бүгінгі күн кестесі 2-күмбезді таңғы сағат 10-дан бастап тексеру.
Dialogue: 0,0:03:16.69,0:03:20.03,Default,,0,0,0,,Басқару бөліміне оралу және секция меңгерушісімен кешкі астан кейін, сағат 14:00-ден бастап.
Dialogue: 0,0:03:20.15,0:03:24.24,Default,,0,0,0,,Күмбезді жер асты муниципалды округіне келу магистратпен сұхбат
Dialogue: 0,0:03:24.53,0:03:29.37,Default,,0,0,0,,Түсінікті. Бірден Орталық вокзалдан 2-күмбезге барыңыз.
Dialogue: 0,0:03:29.75,0:03:30.79,Default,,0,0,0,,Растау
Dialogue: 0,0:03:30.91,0:03:31.96,Default,,0,0,0,,Растау
Dialogue: 0,0:03:33.58,0:03:34.54,Default,,0,0,0,,Күніңіз сәтті өтсін
Dialogue: 0,0:03:36.88,0:03:38.92,Default,,0,0,0,,Күндеріңіз сәтті өтсін
Dialogue: 0,0:03:49.10,0:03:50.39,Default,,0,0,0,,Такеру?
Dialogue: 0,0:03:50.81,0:03:52.10,Default,,0,0,0,,Такеру!
Dialogue: 0,0:03:53.27,0:03:57.11,Default,,0,0,0,,Әй Такеру, ұйықтап жатырсың ба?
Dialogue: 0,0:03:58.36,0:03:59.32,Default,,0,0,0,,Ояу болу
Dialogue: 0,0:03:59.48,0:04:01.03,Default,,0,0,0,,Олай болса, кем дегенде жауап беріңіз.
Dialogue: 0,0:04:02.11,0:04:05.03,Default,,0,0,0,,Кешіріңіз Ао, осылай болды.
Dialogue: 0,0:04:05.24,0:04:07.28,Default,,0,0,0,,Тоқта, әрине.
Dialogue: 0,0:04:07.41,0:04:10.45,Default,,0,0,0,,Біздің ауылға жету үшін ұзақ жол жүргенін білемін.
Dialogue: 0,0:04:10.62,0:04:12.54,Default,,0,0,0,,Мен бұған көп дайындалдым.
Dialogue: 0,0:04:12.71,0:04:14.54,Default,,0,0,0,,Оның орнына мен қазір бірдеңе істеуім керек.
Dialogue: 0,0:04:15.50,0:04:19.30,Default,,0,0,0,,Біздің мақсатымыз Жер туралы Біз туралы
Dialogue: 0,0:04:20.26,0:04:24.80,Default,,0,0,0,,Сіз Такерудің достарына және Едемдегі барлық адамдарға айтуға уәде бердіңіз.
Dialogue: 0,0:04:25.47,0:04:27.30,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:04:27.43,0:04:28.35,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:04:28.81,0:04:30.22,Default,,0,0,0,,Мықты бол, Тәкеру.
Dialogue: 0,0:04:31.72,0:04:32.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:32.68,0:04:34.19,Default,,0,0,0,,Көңіл көтеру
Dialogue: 0,0:04:35.56,0:04:40.48,Default,,0,0,0,,Мен... Мен әрқашан осындай көңілсіз болдым.
Dialogue: 0,0:04:40.78,0:04:41.99,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:04:42.57,0:04:43.99,Default,,0,0,0,,Такеру әрқашан сүйкімді
Dialogue: 0,0:04:44.28,0:04:45.28,Default,,0,0,0,,Өте сүйкімді! ?
Dialogue: 0,0:04:47.03,0:04:49.03,Default,,0,0,0,,Мен де Ао туралы айтып отырмын...
Dialogue: 0,0:04:49.16,0:04:50.49,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:04:50.95,0:04:52.91,Default,,0,0,0,,Қараңызшы, бұл сүйкімді.
Dialogue: 0,0:04:53.58,0:04:54.75,Default,,0,0,0,,Хехе...
Dialogue: 0,0:05:01.46,0:05:05.01,Default,,0,0,0,,Дұрыс, мен Казумаға айтуым керек.
Dialogue: 0,0:05:05.30,0:05:07.09,Default,,0,0,0,,Біздің шытырман оқиға...
Dialogue: 0,0:05:07.51,0:05:11.31,Default,,0,0,0,,Шынайы Жердің шынайы бейнесін жеткізуіміз керек.
Dialogue: 0,0:05:12.27,0:05:14.27,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:28.49,0:05:30.70,Default,,0,0,0,,Мен сені алып кетуге келдім, қария.
Dialogue: 0,0:05:31.45,0:05:34.08,Default,,0,0,0,,Тайра, бұл тағы сенсің бе?
Dialogue: 0,0:05:36.50,0:05:38.46,Default,,0,0,0,,Енді мені жайына қалдыр.
Dialogue: 0,0:05:38.62,0:05:40.42,Default,,0,0,0,,Жалпы, егер менен сұрасаңыз...
Dialogue: 0,0:05:40.54,0:05:44.59,Default,,0,0,0,,Сіздің ойсыз жоспарларыңыз үшін құнды еркіндік сериясы...
Dialogue: 0,0:05:44.71,0:05:47.01,Default,,0,0,0,,Ой! Мен қазір жақсы сезінемін
Dialogue: 0,0:05:48.38,0:05:50.72,Default,,0,0,0,,Мен ұмыта алмаймын
Dialogue: 0,0:05:51.26,0:05:52.18,Default,,0,0,0,,Ах…
Dialogue: 0,0:05:53.64,0:05:55.52,Default,,0,0,0,,Екі жыл бұрын сол күні...
Dialogue: 0,0:05:55.81,0:05:59.27,Default,,0,0,0,,Такеру мен оның достарының қашуы – басқару бюросының еркіндігі...
Dialogue: 0,0:05:59.40,0:06:03.15,Default,,0,0,0,,Оны бізден тартып алуға дайындалған тұзақ болды.
Dialogue: 0,0:06:03.86,0:06:06.15,Default,,0,0,0,,Бізді пайдаланды
Dialogue: 0,0:06:06.65,0:06:12.91,Default,,0,0,0,,Мен Тәкеру мен Бис туралы сол кездегі шешіміме әлі де өкінемін.
Dialogue: 0,0:06:13.33,0:06:16.16,Default,,0,0,0,,Бұл ескі халық ертегілері үшін.
Dialogue: 0,0:06:16.33,0:06:18.79,Default,,0,0,0,,Сіз бастықтарға осылай қарайсыз ба?
Dialogue: 0,0:06:18.96,0:06:22.13,Default,,0,0,0,,Аматсусае, сен маған жақсылық сұрауға келдің ғой, солай ма?
Dialogue: 0,0:06:22.29,0:06:25.30,Default,,0,0,0,,Қайта-қайта сұрамасам да...
Dialogue: 0,0:06:27.55,0:06:29.01,Default,,0,0,0,,Сіз қайтып келдіңіз! ? Бамбук…
Dialogue: 0,0:06:29.13,0:06:30.26,Default,,0,0,0,,Уууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:06:30.38,0:06:33.18,Default,,0,0,0,,Сонымен! Сіз ынтымақтастық жасайсыз ба?
Dialogue: 0,0:06:33.55,0:06:36.06,Default,,0,0,0,,Бостандықты қалпына келтіру операциясы!
Dialogue: 0,0:06:40.65,0:06:43.52,Default,,0,0,0,,Бұл өте тыныш, қызықсыз дерлік.
Dialogue: 0,0:06:43.69,0:06:46.98,Default,,0,0,0,,Жарайды, менің міндетім сені зерігуден қорғау.
Dialogue: 0,0:06:47.40,0:06:50.24,Default,,0,0,0,,Жалығудан қашқанның бәрі өлді.
Dialogue: 0,0:06:54.58,0:06:55.62,Default,,0,0,0,,А…?
Dialogue: 0,0:06:55.74,0:06:56.45,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:56.58,0:06:59.46,Default,,0,0,0,,есеп Николь PK7953M-
Dialogue: 0,0:06:59.58,0:07:01.96,Default,,0,0,0,,Өмір бойы медициналық мекемелерді бақылау жүйесінен айырылды
Dialogue: 0,0:07:02.08,0:07:05.13,Default,,0,0,0,,Әр бөлім Тайра бастаған көтерілісшілердің әрекеттерін бақылайды
Dialogue: 0,0:07:05.25,0:07:05.88,Default,,0,0,0,,Га
Dialogue: 0,0:07:06.09,0:07:08.42,Default,,0,0,0,,Сақтығыңызды төмендетпеңіз. Сіз жай ғана ауру адам емессіз.
Dialogue: 0,0:07:08.59,0:07:11.63,Default,,0,0,0,,Ол Mars Development Corporation компаниясына жауапты адам болды.
Dialogue: 0,0:07:11.80,0:07:13.26,Default,,0,0,0,,Айтылғандай, Тайра және т.б
Dialogue: 0,0:07:13.39,0:07:15.97,Default,,0,0,0,,Егер сіз Едемнен жаппай қашуды жоспарласаңыз...
Dialogue: 0,0:07:16.10,0:07:17.85,Default,,0,0,0,,Сол қарияның даналығы өте қажет
Dialogue: 0,0:07:18.10,0:07:18.85,Default,,0,0,0,,Иә
Dialogue: 0,0:07:18.98,0:07:20.06,Default,,0,0,0,,А…?
Dialogue: 0,0:07:23.69,0:07:26.61,Default,,0,0,0,,Бұл Казуманың әкімшілік округінен шұғыл шақыру.
Dialogue: 0,0:07:26.73,0:07:30.24,Default,,0,0,0,,Түсіндім, мен 2-күмбезді аралағым келеді.
Dialogue: 0,0:07:30.36,0:07:31.15,Default,,0,0,0,,Га
Dialogue: 0,0:07:34.03,0:07:37.20,Default,,0,0,0,,Мен Тайрамен және басқалармен өткен өмірімді тазарту үшін.
Dialogue: 0,0:07:37.33,0:07:39.62,Default,,0,0,0,,Мен командаға жауапты болуым керек пе?
Dialogue: 0,0:07:42.67,0:07:43.96,Default,,0,0,0,,Шығыңыз
Dialogue: 0,0:07:45.29,0:07:47.80,Default,,0,0,0,,Қайта тәрбиелеу мекемесіне ауыстыру
Dialogue: 0,0:07:51.51,0:07:53.55,Default,,0,0,0,,Сен де тезірек кет.
Dialogue: 0,0:07:54.89,0:07:56.68,Default,,0,0,0,,Эй, тезірек.
Dialogue: 0,0:07:59.10,0:08:05.31,Default,,0,0,0,,Осы адамдардың мінез-құлық қағидаларымен таныс адамдарды салаға басшылық ету маңызды.
Dialogue: 0,0:08:05.44,0:08:07.82,Default,,0,0,0,,Күмәндануға орын жоқ
Dialogue: 0,0:08:07.98,0:08:09.65,Default,,0,0,0,,Бірақ мен және Такеру...
Dialogue: 0,0:08:09.78,0:08:12.86,Default,,0,0,0,,Казума CC4459M
Dialogue: 0,0:08:13.28,0:08:16.87,Default,,0,0,0,,Біз сізге толық сенім артамыз.
Dialogue: 0,0:08:17.66,0:08:21.91,Default,,0,0,0,,Мен оны екі жарым жыл бақылап отырған жоқпын.
Dialogue: 0,0:08:22.66,0:08:26.21,Default,,0,0,0,,Сол оқиғадан кейін сенің барлық істегендерің... болғаны рас.
Dialogue: 0,0:08:26.58,0:08:30.63,Default,,0,0,0,,Ол Едемді сақтауға бағытталған әрекеттермен шектелді.
Dialogue: 0,0:08:30.96,0:08:33.55,Default,,0,0,0,,Енді команданы алатын маған...
Dialogue: 0,0:08:33.67,0:08:36.43,Default,,0,0,0,,Барлық тиісті ақпаратты ашып бере аласыз ба?
Dialogue: 0,0:08:37.05,0:08:38.01,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:38.14,0:08:43.81,Default,,0,0,0,,Көтерілісшілердің, қарт адамның қашуы және іздеуде жүрген қылмыскерлердің жоспарлары туралы соңғы хабардан...
Dialogue: 0,0:08:43.98,0:08:47.56,Default,,0,0,0,,Жоқ, күні кеше мен Едемнің жанына шұғыл қондым.
Dialogue: 0,0:08:47.73,0:08:50.73,Default,,0,0,0,,Белгісіз ұшатын нысан туралы есеп беруден бастаңыз
Dialogue: 0,0:08:55.20,0:08:57.62,Default,,0,0,0,,Осы уақытта Аланмен байланысыңыз
Dialogue: 0,0:08:57.74,0:09:01.45,Default,,0,0,0,,Сіз кері санамай-ақ, Тайраның не ойлайтынын айта аласыз.
Dialogue: 0,0:09:01.58,0:09:03.29,Default,,0,0,0,,Сол ұшатын нысанда Такеру және...
Dialogue: 0,0:09:03.41,0:09:04.46,Default,,0,0,0,,А…?
Dialogue: 0,0:09:05.04,0:09:06.71,Default,,0,0,0,,Зерттеу нысанасы қашып кетті.
Dialogue: 0,0:09:06.96,0:09:08.25,Default,,0,0,0,,Жерден келген әйел?
Dialogue: 0,0:09:08.38,0:09:09.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:09.17,0:09:12.80,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:09:16.59,0:09:17.93,Default,,0,0,0,,Такеру және...
Dialogue: 0,0:09:18.68,0:09:20.76,Default,,0,0,0,,Ол Жерден келген әйел! ?
Dialogue: 0,0:09:26.85,0:09:32.48,Default,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,0:09:36.90,0:09:38.32,Default,,0,0,0,,Осы жолмен.
Dialogue: 0,0:09:40.28,0:09:43.54,Default,,0,0,0,,Ао, мен бұл Эйден үшін кешірім сұраймын.
Dialogue: 0,0:09:43.91,0:09:45.71,Default,,0,0,0,,Бұл қызық I
Dialogue: 0,0:09:45.87,0:09:48.87,Default,,0,0,0,,Себебі мен Такерумен бірге болғанда
Dialogue: 0,0:09:49.38,0:09:51.13,Default,,0,0,0,,Не?
Dialogue: 0,0:09:51.50,0:09:53.21,Default,,0,0,0,,Ух... ой...
Dialogue: 0,0:09:53.42,0:09:56.01,Default,,0,0,0,,Уа-а-а-а-а-а...
Dialogue: 0,0:09:57.17,0:09:57.93,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:03.85,0:10:04.64,Default,,0,0,0,,Сегізаяқ?
Dialogue: 0,0:10:04.77,0:10:07.39,Default,,0,0,0,,Біреудің махаббат сапарына кедергі болма.
Dialogue: 0,0:10:07.60,0:10:08.56,Default,,0,0,0,,Ао!
Dialogue: 0,0:10:14.90,0:10:16.15,Default,,0,0,0,,Такеру! Апыр-ай!
Dialogue: 0,0:10:18.11,0:10:19.49,Default,,0,0,0,,Уф! Жақсы
Dialogue: 0,0:10:28.50,0:10:29.58,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:10:29.71,0:10:30.54,Default,,0,0,0,,Ао!
Dialogue: 0,0:10:31.08,0:10:32.34,Default,,0,0,0,,Ахх
Dialogue: 0,0:10:32.46,0:10:33.59,Default,,0,0,0,,Ао!
Dialogue: 0,0:10:34.30,0:10:36.51,Default,,0,0,0,,Dowaaaao!
Dialogue: 0,0:10:36.63,0:10:38.51,Default,,0,0,0,,Такеру қашып кетеді
Dialogue: 0,0:10:38.80,0:10:41.34,Default,,0,0,0,,Takeru BD4483M
Dialogue: 0,0:10:41.97,0:10:43.26,Default,,0,0,0,,Пайдасыз қарсылықты тоқтату
Dialogue: 0,0:10:43.43,0:10:44.51,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:10:50.65,0:10:55.65,Default,,0,0,0,,Ха... Бұл шынымен сен бе? Казума
Dialogue: 0,0:10:57.99,0:10:59.65,Default,,0,0,0,,Бұл менмін, Такеру.
Dialogue: 0,0:10:59.82,0:11:03.49,Default,,0,0,0,,Мен сені алып кетуге келдім. Біз тағы кездесеміз деп уәде бердік.
Dialogue: 0,0:11:03.66,0:11:09.16,Default,,0,0,0,,Сіздің әрекеттеріңіз Едемнің тұтастығын бұзады, әсіресе...
Dialogue: 0,0:11:09.58,0:11:11.42,Default,,0,0,0,,Мен әйелдің бар екенін мойындамаймын.
Dialogue: 0,0:11:11.79,0:11:15.09,Default,,0,0,0,,Казума Бұл сол кездегі фотодағы Ао.
Dialogue: 0,0:11:15.25,0:11:17.17,Default,,0,0,0,,Есіңде ме? Қараңызшы, екі жыл бұрын...
Dialogue: 0,0:11:17.34,0:11:19.67,Default,,0,0,0,,Ақымақ жердегілер жойылды
Dialogue: 0,0:11:21.18,0:11:23.26,Default,,0,0,0,,Казмар!
Dialogue: 0,0:11:23.68,0:11:26.10,Default,,0,0,0,,Келіңіздер! Вуд уау
Dialogue: 0,0:11:28.43,0:11:31.39,Default,,0,0,0,,Такеру, сен өзгерген жоқсың.
Dialogue: 0,0:11:31.69,0:11:34.36,Default,,0,0,0,,Казума! Барлығыңызды бірден ұруға рұқсат етіңіз!
Dialogue: 0,0:11:34.52,0:11:38.57,Default,,0,0,0,,Әр нәрсені өзімшіл көзқараспен ойлау жаман әдет.
Dialogue: 0,0:11:38.98,0:11:40.65,Default,,0,0,0,,Бер, Такеру
Dialogue: 0,0:11:47.87,0:11:48.99,Default,,0,0,0,,Казума!
Dialogue: 0,0:11:49.37,0:11:51.00,Default,,0,0,0,,Такеру қашып кетті!
Dialogue: 0,0:11:51.37,0:11:52.46,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:11:52.62,0:11:53.46,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:11:53.75,0:11:57.71,Default,,0,0,0,,Ао мен Казуманы жерге міндетті түрде әкеліңіз!
Dialogue: 0,0:11:57.88,0:12:00.30,Default,,0,0,0,,Мен сені өзіммен бірге алғым келмейді!
Dialogue: 0,0:12:00.46,0:12:01.67,Default,,0,0,0,,Доварт
Dialogue: 0,0:12:04.47,0:12:05.30,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:12:05.43,0:12:06.60,Default,,0,0,0,,Такеру! Уф...
Dialogue: 0,0:12:08.10,0:12:10.18,Default,,0,0,0,,Такеру!
Dialogue: 0,0:12:10.72,0:12:11.52,Default,,0,0,0,,Көк
Dialogue: 0,0:12:17.61,0:12:18.90,Default,,0,0,0,,Такеру
Dialogue: 0,0:12:19.86,0:12:21.03,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:12:21.44,0:12:22.45,Default,,0,0,0,,Гваа!
Dialogue: 0,0:12:26.57,0:12:27.91,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:12:28.08,0:12:30.08,Default,,0,0,0,,Казума! Әй!
Dialogue: 0,0:12:36.13,0:12:38.34,Default,,0,0,0,,Мен мұның бәрін төтенше жағдайда жинадым.
Dialogue: 0,0:12:45.76,0:12:49.76,Default,,0,0,0,,Аланның қашуы олардың арасында толқу тудырды.
Dialogue: 0,0:12:50.47,0:12:52.06,Default,,0,0,0,,Бұл уақытты жіберіп алмаңыз!
Dialogue: 0,0:12:52.27,0:12:53.89,Default,,0,0,0,,О!
Dialogue: 0,0:12:56.02,0:13:00.07,Default,,0,0,0,,Тайра, балалар, сіз Жерге баруды жоспарлап жатырсыз ба?
Dialogue: 0,0:13:00.57,0:13:03.15,Default,,0,0,0,,Ол қайтып келді, күмән жоқ.
Dialogue: 0,0:13:05.28,0:13:08.12,Default,,0,0,0,,Әрбір күмбезге орналастырылған Марс иммигранттарының кемелері
Dialogue: 0,0:13:08.28,0:13:11.99,Default,,0,0,0,,Орналасқан жерді анықтау кезінде Бостандыққа дейінгі жол уақытын ескеріңіз.
Dialogue: 0,0:13:12.20,0:13:15.87,Default,,0,0,0,,Басқару бөлмесін басқарғаннан кейін қашуды орындауға нұсқау беріңіз.
Dialogue: 0,0:13:16.12,0:13:19.63,Default,,0,0,0,,«Мұқият жоспарлаңыз, бірден қолданыңыз»
Dialogue: 0,0:13:19.88,0:13:22.25,Default,,0,0,0,,Барлық ұшақтарды бір уақытта ұшыру дегеніміз не?
Dialogue: 0,0:13:22.38,0:13:25.55,Default,,0,0,0,,Олардың қауіпсіздік жүйесі бұған жете алмайды.
Dialogue: 0,0:13:25.72,0:13:26.88,Default,,0,0,0,,Ойлан, Тайра.
Dialogue: 0,0:13:27.05,0:13:29.14,Default,,0,0,0,,Ай мен үшін ең жақсысы
Dialogue: 0,0:13:29.26,0:13:32.52,Default,,0,0,0,,Гош ұрлаған Жерден келген бұл жігіт те жаман емес.
Dialogue: 0,0:13:33.14,0:13:34.64,Default,,0,0,0,,Ха... Шынымен (хабарландыру дыбысы)
Dialogue: 0,0:13:35.56,0:13:36.35,Default,,0,0,0,,Құдайым
Dialogue: 0,0:13:36.56,0:13:38.65,Default,,0,0,0,,Әй, жағдай қалай?
Dialogue: 0,0:13:38.81,0:13:43.03,Default,,0,0,0,,Ал... мен қашып үлгергенше ол қашып кетті.
Dialogue: 0,0:13:43.19,0:13:44.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:44.99,0:13:47.61,Default,,0,0,0,,...Сол жігіт!
Dialogue: 0,0:13:47.95,0:13:49.87,Default,,0,0,0,,Келесі кезекте Баканы шығарып алу.
Dialogue: 0,0:13:50.03,0:13:51.16,Default,,0,0,0,,Жұмыс басталады!
Dialogue: 0,0:14:03.92,0:14:07.72,Default,,0,0,0,,Көк түсті дедің бе? жас ханым
Dialogue: 0,0:14:08.22,0:14:10.93,Default,,0,0,0,,Иә, сіз ше?
Dialogue: 0,0:14:11.10,0:14:16.73,Default,,0,0,0,,Мен осы Ай қаласы Еден Республикасын басқаратын және басқаратын азаматтардың өкілімін.
Dialogue: 0,0:14:17.06,0:14:19.27,Default,,0,0,0,,Өкіл, тыңдаңыз.
Dialogue: 0,0:14:19.44,0:14:22.19,Default,,0,0,0,,Тәкеру екеуміз сізге айту үшін келдік.
Dialogue: 0,0:14:22.36,0:14:23.48,Default,,0,0,0,,Не?
Dialogue: 0,0:14:24.02,0:14:26.94,Default,,0,0,0,,Жер қазір жақсы
Dialogue: 0,0:14:27.07,0:14:28.45,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:14:28.61,0:14:32.49,Default,,0,0,0,,Біз қолдайтын ғылыми күшпен Жердің ауа райын бақылауды жалғастырамыз.
Dialogue: 0,0:14:32.70,0:14:35.16,Default,,0,0,0,,Олай болса оны бәрінен жасыру керек пе?
Dialogue: 0,0:14:35.33,0:14:38.25,Default,,0,0,0,,Қажетсіз хаос тәртіпті азайтады.
Dialogue: 0,0:14:39.00,0:14:40.75,Default,,0,0,0,,Сіз Казума-кунсыз, солай ма?
Dialogue: 0,0:14:41.58,0:14:44.25,Default,,0,0,0,,Маңызды емес сұрақтарға жауап берудің қажеті жоқ
Dialogue: 0,0:14:44.46,0:14:48.76,Default,,0,0,0,,Өйткені Такеру Казума-кунға берген уәдесін орындау үшін қайтып келді.
Dialogue: 0,0:14:49.72,0:14:50.68,Default,,0,0,0,,Мен оны естідім.
Dialogue: 0,0:14:50.84,0:14:55.35,Default,,0,0,0,,Казума-кун мен Такеру осы Едемде қандай өмір сүрді?
Dialogue: 0,0:14:55.51,0:14:59.02,Default,,0,0,0,,Казума Такеру үшін қаншалықты маңызды?
Dialogue: 0,0:14:59.39,0:15:00.52,Default,,0,0,0,,Ал дегенмен!
Dialogue: 0,0:15:00.77,0:15:05.52,Default,,0,0,0,,Мен тірі болғаныма қуаныштымын, бірақ сонымен бірге мен Едемнің тәртібін бұзып жатырмын.
Dialogue: 0,0:15:06.15,0:15:08.74,Default,,0,0,0,,бұл... Казума-кун
Dialogue: 0,0:15:08.90,0:15:13.74,Default,,0,0,0,,Көтерілісшілер Такерені қайтарып алуды жоспарлап отыр. Қайта тәрбиелеу мекемесіндегі қауіпсіздікті назардан тыс қалдырмаңыз.
Dialogue: 0,0:15:13.91,0:15:15.08,Default,,0,0,0,,Иә
Dialogue: 0,0:15:15.66,0:15:18.91,Default,,0,0,0,,Бізде қорғайтын қоғам бар.
Dialogue: 0,0:15:19.08,0:15:22.92,Default,,0,0,0,,Осы Едемде қызықсыз болу дұрыс.
Dialogue: 0,0:15:23.08,0:15:25.17,Default,,0,0,0,,Дұрыс па? Казума
Dialogue: 0,0:15:25.75,0:15:26.96,Default,,0,0,0,,Иә
Dialogue: 0,0:15:36.93,0:15:40.06,Default,,0,0,0,,Бұл оңай. Менде жағымсыз сезім бар.
Dialogue: 0,0:15:49.69,0:15:51.61,Default,,0,0,0,,Эй, бұл жәшік!
Dialogue: 0,0:15:51.99,0:15:54.74,Default,,0,0,0,,Тайра, бұл сенің жұмысың.
Dialogue: 0,0:15:58.29,0:16:00.20,Default,,0,0,0,,Уф... қаш!
Dialogue: 0,0:16:07.80,0:16:09.38,Default,,0,0,0,,Қария, бұл буксир!
Dialogue: 0,0:16:09.55,0:16:11.22,Default,,0,0,0,,Басқа бөлімшелер де Такеруді іздейді
Dialogue: 0,0:16:11.34,0:16:13.97,Default,,0,0,0,,Осы уақытта мүмкіндігінше көп сегізаяқтарды тартуға тырысыңыз.
Dialogue: 0,0:16:14.26,0:16:15.76,Default,,0,0,0,,Қашу жолын жіберіңіз
Dialogue: 0,0:16:15.93,0:16:18.72,Default,,0,0,0,,Қарсылас – Казума. Сақтығыңызды төмендетпеңіз!
Dialogue: 0,0:16:18.93,0:16:22.43,Default,,0,0,0,,Түсінікті! Қарт маған кейінірек қосылады.
Dialogue: 0,0:16:22.85,0:16:24.90,Default,,0,0,0,,Такеру қайда?
Dialogue: 0,0:16:27.86,0:16:28.65,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:28.77,0:16:30.15,Default,,0,0,0,,Эй, сәлем
Dialogue: 0,0:16:33.65,0:16:36.57,Default,,0,0,0,,Ай сәулесі? Бұл Тира ма?
Dialogue: 0,0:16:39.62,0:16:40.95,Default,,0,0,0,,Тира!
Dialogue: 0,0:16:41.45,0:16:42.25,Default,,0,0,0,,Дат
Dialogue: 0,0:16:43.21,0:16:44.25,Default,,0,0,0,,(Ванिला Айс) Абдурды ұсақ-түйекке айналдырды.
Dialogue: 0,0:16:45.75,0:16:46.92,Default,,0,0,0,,Не, ақымақ?
Dialogue: 0,0:16:47.04,0:16:47.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:48.09,0:16:48.88,Default,,0,0,0,,Такеру! ?
Dialogue: 0,0:16:52.26,0:16:54.59,Default,,0,0,0,,Такеру! Біраз уақыт өтті
Dialogue: 0,0:16:54.76,0:16:56.59,Default,,0,0,0,,Жер бәрібір тірі.
Dialogue: 0,0:16:56.76,0:16:58.55,Default,,0,0,0,,Ах! сіз де бара аласыз
Dialogue: 0,0:16:58.72,0:17:01.68,Default,,0,0,0,,Бірақ оған дейін Аоны құтқару үшін жертөлеге барыңыз.
Dialogue: 0,0:17:02.02,0:17:03.56,Default,,0,0,0,,Алдымен біз негізгі күшпен кездесуіміз керек.
Dialogue: 0,0:17:03.68,0:17:05.44,Default,,0,0,0,,Жоқ, Ао...
Dialogue: 0,0:17:05.60,0:17:07.27,Default,,0,0,0,,Алан да күтіп тұр.
Dialogue: 0,0:17:08.11,0:17:09.44,Default,,0,0,0,,Қария?
Dialogue: 0,0:17:13.69,0:17:15.90,Default,,0,0,0,,Мұндай жерде одақтастар бар ма?
Dialogue: 0,0:17:18.32,0:17:19.83,Default,,0,0,0,,Такеру!
Dialogue: 0,0:17:19.99,0:17:22.33,Default,,0,0,0,,Соңғы уақытта біраз уақыт болды, солай емес пе?
Dialogue: 0,0:17:23.41,0:17:26.25,Default,,0,0,0,,Ах! Уф уау... қария
Dialogue: 0,0:17:26.50,0:17:29.63,Default,,0,0,0,,Мен сіздің қайтып келгеніңізді естіп, дайындалдым.
Dialogue: 0,0:17:29.79,0:17:31.84,Default,,0,0,0,,О! Бұл Мива
Dialogue: 0,0:17:32.05,0:17:34.09,Default,,0,0,0,,Үш дөңгелекті көлік Сәлем!
Dialogue: 0,0:17:34.30,0:17:35.55,Default,,0,0,0,,Ой, №2?
Dialogue: 0,0:17:35.88,0:17:37.63,Default,,0,0,0,,Бұл «2» емес, «буй»
Dialogue: 0,0:17:38.05,0:17:39.30,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:39.47,0:17:40.47,Default,,0,0,0,,«V»?
Dialogue: 0,0:17:45.93,0:17:47.85,Default,,0,0,0,,Бұл тамаша емес пе?
Dialogue: 0,0:17:51.32,0:17:54.11,Default,,0,0,0,,Такеру Жер жақсы жер ме?
Dialogue: 0,0:17:54.36,0:17:57.45,Default,,0,0,0,,Бұл жай ғана жақсы емес, бірақ керемет.
Dialogue: 0,0:17:57.61,0:17:59.07,Default,,0,0,0,,Мен мұны жақсы түсіндіре алмаймын.
Dialogue: 0,0:17:59.41,0:18:02.87,Default,,0,0,0,,Мен де оны бәрі көрсін деп, мен оны алып кетуге келдім, тек мен және сол қыз.
Dialogue: 0,0:18:03.99,0:18:05.12,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:05.37,0:18:08.00,Default,,0,0,0,,Кеттік! Қарт күтуден шаршады.
Dialogue: 0,0:18:08.29,0:18:09.33,Default,,0,0,0,,О
Dialogue: 0,0:18:09.75,0:18:11.17,Default,,0,0,0,,Рахмет, қария
Dialogue: 0,0:18:11.29,0:18:12.21,Default,,0,0,0,,О
Dialogue: 0,0:18:19.59,0:18:20.55,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:26.93,0:18:28.85,Default,,0,0,0,,Біраз бұрын...
Dialogue: 0,0:18:33.27,0:18:35.28,Default,,0,0,0,,Мен оның келгеніне сене алар емеспін...
Dialogue: 0,0:18:35.78,0:18:39.57,Default,,0,0,0,,Біз жыл сайын Флоридадан жіберетін хабарлама
Dialogue: 0,0:18:40.49,0:18:42.41,Default,,0,0,0,,Неге... неге-
Dialogue: 0,0:18:42.78,0:18:44.99,Default,,0,0,0,,Сіз ештеңе жауап бермедіңіз бе?
Dialogue: 0,0:18:45.16,0:18:47.04,Default,,0,0,0,,Тек сау болу...
Dialogue: 0,0:18:47.75,0:18:50.17,Default,,0,0,0,,Жерді соншалықты жек көресің бе?
Dialogue: 0,0:18:50.29,0:18:55.13,Default,,0,0,0,,Жер енді артқа қарағысы келмейді. Айдың балаларына айтқым келмейді.
Dialogue: 0,0:18:55.25,0:18:57.59,Default,,0,0,0,,Сіз жасырғыңыз келетін адамсыз ба?
Dialogue: 0,0:18:58.13,0:18:59.05,Default,,0,0,0,,Гвуу…
Dialogue: 0,0:18:59.84,0:19:02.55,Default,,0,0,0,,Өйткені бәріміз де адамбыз.
Dialogue: 0,0:19:02.76,0:19:07.85,Default,,0,0,0,,Ай мен жер, жер немесе ай, қайда туғаның маңызды емес.
Dialogue: 0,0:19:08.06,0:19:10.23,Default,,0,0,0,,Мұны маған Тәкеру айтты.
Dialogue: 0,0:19:12.77,0:19:18.24,Default,,0,0,0,,Ханым, кешіріңіз, бірақ сіз жер бетінде не істеп жатырсыз?
Dialogue: 0,0:19:18.74,0:19:22.03,Default,,0,0,0,,Ауылдағы балаларды оқыту
Dialogue: 0,0:19:22.74,0:19:27.33,Default,,0,0,0,,Мұғалім, түсіндім. Бұл қанағаттанарлық сәйкестік.
Dialogue: 0,0:19:27.49,0:19:31.54,Default,,0,0,0,,Бұрын ғарышкер болып көптеген ғалымдар мен ұстаздар сайланған.
Dialogue: 0,0:19:31.71,0:19:34.33,Default,,0,0,0,,Неге екенін білесіз бе?
Dialogue: 0,0:19:36.00,0:19:40.67,Default,,0,0,0,,Ғарышкерлердің тағы бір маңызды қызметі - өз тәжірибесін көптеген адамдарға жеткізу.
Dialogue: 0,0:19:40.84,0:19:44.85,Default,,0,0,0,,Сондықтан мен сендерге жердегі тіршілік туралы айтып беруге келдім.
Dialogue: 0,0:19:45.01,0:19:48.18,Default,,0,0,0,,Сонымен қатар, маған ай туралы айтып беріңізші.
Dialogue: 0,0:19:55.19,0:19:57.40,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:19:57.65,0:19:58.65,Default,,0,0,0,,Сол әмияны—
Dialogue: 0,0:19:58.98,0:20:00.74,Default,,0,0,0,,Сіздің серіктесіңіз ше?
Dialogue: 0,0:20:00.90,0:20:03.86,Default,,0,0,0,,Биске не болды? Мен олардың бірге емес екенін естідім.
Dialogue: 0,0:20:04.03,0:20:08.87,Default,,0,0,0,,А, ол да жақсы. Дұрыс, оның жер бетінде сүйген қызы бар.
Dialogue: 0,0:20:10.20,0:20:12.29,Default,,0,0,0,,Мен тезірек барғым келеді.
Dialogue: 0,0:20:25.55,0:20:29.26,Default,,0,0,0,,Оның үстінде Freedom Series басқару бөлмесі бар.
Dialogue: 0,0:20:29.39,0:20:31.23,Default,,0,0,0,,Басқару станциясындағылар білмейді.
Dialogue: 0,0:20:34.35,0:20:38.07,Default,,0,0,0,,Қария, сіз маған Казуманың қайда екенін айта аласыз ба?
Dialogue: 0,0:20:38.23,0:20:40.32,Default,,0,0,0,,Онда да әрқашан Ао бар.
Dialogue: 0,0:20:41.15,0:20:45.07,Default,,0,0,0,,Бұл жер астында болуы керек, бірақ бұл қауіпті.
Dialogue: 0,0:20:45.24,0:20:46.37,Default,,0,0,0,,...Ал Ао ше?
Dialogue: 0,0:20:46.53,0:20:49.83,Default,,0,0,0,,Иә, мен сол кездегі суреттегі қыз сол еді.
Dialogue: 0,0:20:50.12,0:20:52.62,Default,,0,0,0,,Мен сенімен Казуманы алып кетуге келдім.
Dialogue: 0,0:20:52.87,0:20:55.87,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:20:56.04,0:20:59.21,Default,,0,0,0,,...Сонымен бір нәрсенің астына қалай жетеміз?
Dialogue: 0,0:20:59.38,0:21:01.63,Default,,0,0,0,,Бұлай бейқамдық жасауды доғар. Жалғыз не істемексің?
Dialogue: 0,0:21:01.76,0:21:02.92,Default,,0,0,0,,Бұл емес.
Dialogue: 0,0:21:03.09,0:21:05.68,Default,,0,0,0,,Мен Казуманы Жерге апарып жатырмын.
Dialogue: 0,0:21:06.47,0:21:09.81,Default,,0,0,0,,Басқару бөлмесінде белсендіруді растағаннан кейін жалғастырыңыз.
Dialogue: 0,0:21:16.69,0:21:18.90,Default,,0,0,0,,Енді сіздің кезегіңіз.
Dialogue: 0,0:21:19.06,0:21:21.36,Default,,0,0,0,,Енді «Бостандық» сериясын іске қосуға дайындалыңыз.
Dialogue: 0,0:21:21.53,0:21:22.53,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:21:22.69,0:21:23.90,Default,,0,0,0,,Какаре!
Dialogue: 0,0:21:27.74,0:21:29.45,Default,,0,0,0,,Амансың ба, қария?
Dialogue: 0,0:21:29.95,0:21:33.00,Default,,0,0,0,,Жер қалай болды?
Dialogue: 0,0:21:33.16,0:21:36.33,Default,,0,0,0,,Әй, күнде өмір сүру қандай жақсы.
Dialogue: 0,0:21:36.46,0:21:37.75,Default,,0,0,0,,Сізге ұнайды
Dialogue: 0,0:21:38.21,0:21:42.00,Default,,0,0,0,,Бір рет келіңіз, сонда сіз қайда тұрғыңыз келетінін шеше аласыз.
Dialogue: 0,0:21:42.13,0:21:44.09,Default,,0,0,0,,Техникамды қолдансам да кесіп өте алмаймын.
Dialogue: 0,0:21:44.26,0:21:47.09,Default,,0,0,0,,Дұрыс, қариядан сұрайын дегенім бар.
Dialogue: 0,0:21:47.26,0:21:49.59,Default,,0,0,0,,Ао ауылында тараған аңыз...
Dialogue: 0,0:21:50.47,0:21:52.22,Default,,0,0,0,,Бұл аңыз ба?
Dialogue: 0,0:21:52.39,0:21:54.81,Default,,0,0,0,,Өзім туып өскен ауылда
Dialogue: 0,0:21:55.06,0:21:58.94,Default,,0,0,0,,Ежелден келе жатқан аңыз бар.
Dialogue: 0,0:22:00.02,0:22:02.36,Default,,0,0,0,,«Жоғарыда пайда болған алтын жұлдыздан-»
Dialogue: 0,0:22:02.48,0:22:07.07,Default,,0,0,0,,«Бір күні молшылық пен молшылық міндетті түрде келеді».
Dialogue: 0,0:22:07.28,0:22:11.45,Default,,0,0,0,,«Бостандық басшылыққа алған шыншылдық пен даналықтың үзінділері»
Dialogue: 0,0:22:12.08,0:22:13.74,Default,,0,0,0,,«Алтын жұлдыз»?
Dialogue: 0,0:22:13.91,0:22:18.33,Default,,0,0,0,,Иә, Жерден көрінген түнгі аспанда жарқыраған айыңыз...
Dialogue: 0,0:22:18.46,0:22:19.83,Default,,0,0,0,,Өте әдемі
Dialogue: 0,0:22:20.21,0:22:23.13,Default,,0,0,0,,«Даналық еркіндігінің фрагменті»?
Dialogue: 0,0:22:23.30,0:22:27.09,Default,,0,0,0,,Жер тұрғындары Марста қолданылуы тиіс жүйені не үшін пайдаланды?
Dialogue: 0,0:22:28.01,0:22:30.76,Default,,0,0,0,,Такеру және оның достары жоспарланғандай Тайрамен және басқалармен кездеседі.
Dialogue: 0,0:22:30.89,0:22:32.14,Default,,0,0,0,,Нысанға бет алды
Dialogue: 0,0:22:32.26,0:22:37.02,Default,,0,0,0,,Күтілгендей, қазір біз ол жасырынған Бостандық бақылау бөлмесіне бара жатырмыз...
Dialogue: 0,0:22:37.14,0:22:39.44,Default,,0,0,0,,Маған жол көрсетіңізші.
Dialogue: 0,0:22:39.60,0:22:42.90,Default,,0,0,0,,Олардың барлығын нысанда жинақтау ғана қалды.
Dialogue: 0,0:22:43.52,0:22:45.15,Default,,0,0,0,,Оқиға орнына барыңыз
Dialogue: 0,0:22:46.61,0:22:47.94,Default,,0,0,0,,Такеру…
Dialogue: 0,0:22:48.86,0:22:53.99,Default,,0,0,0,,Аңыздың шығу тегі осы деп ойлаймын.
Dialogue: 0,0:22:54.53,0:22:55.62,Default,,0,0,0,,Бастапқыда Едем...
Dialogue: 0,0:22:55.74,0:22:58.75,Default,,0,0,0,,Терраформды Марсты отарлау үшін -
Dialogue: 0,0:22:58.87,0:23:01.17,Default,,0,0,0,,Застава ретінде салынған
Dialogue: 0,0:23:02.21,0:23:07.17,Default,,0,0,0,,Ал Марсқа бет алған зымырандарды қоныстанушылар пайдаланады.
Dialogue: 0,0:23:07.34,0:23:11.22,Default,,0,0,0,,Көптеген дәнді-дақылдар мен жануарлар түрлері сақталған.
Dialogue: 0,0:23:11.43,0:23:16.01,Default,,0,0,0,,Зауыт бар ракета «Бостандық» деп аталады.
Dialogue: 0,0:23:16.39,0:23:20.19,Default,,0,0,0,,Егер солай болса, жер бетіндегі шөлдерде егістіктер көп болар ма еді?
Dialogue: 0,0:23:20.35,0:23:23.15,Default,,0,0,0,,Бұл Марс көлеміндей жерде қолдануға арналған технология.
Dialogue: 0,0:23:23.27,0:23:24.27,Default,,0,0,0,,Арнайы мүмкіндіктер болмайды.
Dialogue: 0,0:23:24.44,0:23:26.23,Default,,0,0,0,,Керемет еркіндік
Dialogue: 0,0:23:26.40,0:23:29.69,Default,,0,0,0,,Көгілдір Жер мен Қоңыр оларда бұл болған жағдайда бақытты болатынына сенімдімін.
Dialogue: 0,0:23:29.86,0:23:33.16,Default,,0,0,0,,Міне, Аоның әкесі өз өмірін қатерге тігіп тауып алған.
Dialogue: 0,0:23:33.37,0:23:35.66,Default,,0,0,0,,Жер бетінде мұндай адам болды ма?
Dialogue: 0,0:23:35.83,0:23:37.24,Default,,0,0,0,,Жер асты қайда орналасқан?
Dialogue: 0,0:23:37.41,0:23:40.16,Default,,0,0,0,,Күте тұрыңыз, іске қосуға дайындық аяқталды.
Dialogue: 0,0:23:44.92,0:23:47.13,Default,,0,0,0,,Нысанға дейінгі қашықтық 3000
Dialogue: 0,0:23:47.30,0:23:50.17,Default,,0,0,0,,Күмбезде көтерілісшілер де пайда болды.
Dialogue: 0,0:23:50.63,0:23:54.34,Default,,0,0,0,,Не? Бір мезгілде шабуылдар туралы не деуге болады? Оған секіргіңіз келе ме?
Dialogue: 0,0:23:54.72,0:23:56.85,Default,,0,0,0,,Тартпа Сіз кіруге дайынсыз ба?
Dialogue: 0,0:23:57.18,0:23:59.06,Default,,0,0,0,,Барлық блоктар орнында.
Dialogue: 0,0:23:59.22,0:24:00.39,Default,,0,0,0,,Инвазия басталады!
Dialogue: 0,0:24:00.56,0:24:03.60,Default,,0,0,0,,Біз бақылауға алмас бұрын олардың байланыс желілеріне күштеп араласу.
Dialogue: 0,0:24:03.77,0:24:04.77,Default,,0,0,0,,Ха!
Dialogue: 0,0:24:11.90,0:24:13.28,Default,,0,0,0,,А, басқару бюросы?
Dialogue: 0,0:24:13.66,0:24:14.45,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:24:18.29,0:24:19.66,Default,,0,0,0,,Неге мұнда?
Dialogue: 0,0:24:19.83,0:24:23.54,Default,,0,0,0,,Өкінішке орай, бізге «Бостандықты» іске қосуға рұқсат етілмейді.
Dialogue: 0,0:24:24.17,0:24:25.46,Default,,0,0,0,,Не!
Dialogue: 0,0:24:26.46,0:24:29.34,Default,,0,0,0,,Мен сенен Жерге барудан бас тартуыңды сұраймын, Тира-сан.
Dialogue: 0,0:24:29.46,0:24:30.55,Default,,0,0,0,,Қалауыңызша!
Dialogue: 0,0:24:30.92,0:24:33.05,Default,,0,0,0,,Ол қайтадан қолданылды ма?
Dialogue: 0,0:24:33.38,0:24:34.30,Default,,0,0,0,,Сіз іске қосуға дайынсыз ба?
Dialogue: 0,0:24:34.47,0:24:36.18,Default,,0,0,0,,Тағы дерлік деректер...
Dialogue: 0,0:24:36.55,0:24:37.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:37.43,0:24:38.47,Default,,0,0,0,,Тира!
Dialogue: 0,0:24:39.76,0:24:40.89,Default,,0,0,0,,Вертолёт қонды.
Dialogue: 0,0:24:42.27,0:24:43.81,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:24:49.19,0:24:50.28,Default,,0,0,0,,(Ванिला Айс) Абдурды ұсақ-түйекке айналдырды.
Dialogue: 0,0:24:50.61,0:24:52.07,Default,,0,0,0,,Бұл соңы!
Dialogue: 0,0:24:52.19,0:24:52.99,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:24:53.15,0:24:54.49,Default,,0,0,0,,Тағы да
Dialogue: 0,0:24:54.65,0:24:55.78,Default,,0,0,0,,сәби әлі тірі. Бұл адам баланы қорғап қалған болар.
Dialogue: 0,0:24:55.91,0:24:56.62,Default,,0,0,0,,(Ванिला Айс) Абдурды ұсақ-түйекке айналдырды.
Dialogue: 0,0:24:59.87,0:25:01.16,Default,,0,0,0,,Жарайды, басталды.
Dialogue: 0,0:25:01.29,0:25:01.91,Default,,0,0,0,,(Ванिला Айс) Абдурды ұсақ-түйекке айналдырды.
Dialogue: 0,0:25:04.50,0:25:05.46,Default,,0,0,0,,Бұл басталды!
Dialogue: 0,0:25:07.92,0:25:08.71,Default,,0,0,0,,Такеру
Dialogue: 0,0:25:11.88,0:25:12.67,Default,,0,0,0,,Сол әмияны—
Dialogue: 0,0:25:13.17,0:25:15.13,Default,,0,0,0,,Маған бәрібір, қалдырыңыз.
Dialogue: 0,0:25:15.34,0:25:17.43,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:25:17.80,0:25:20.47,Default,,0,0,0,,Құтқаратын балаң бар.
Dialogue: 0,0:25:21.18,0:25:22.72,Default,,0,0,0,,Әй, қария! Уау
Dialogue: 0,0:25:23.31,0:25:24.85,Default,,0,0,0,,Уау...
Dialogue: 0,0:25:25.02,0:25:25.85,Default,,0,0,0,,Сол әмияны—
Dialogue: 0,0:25:26.02,0:25:28.15,Default,,0,0,0,,Тәкеру, кеттік.
Dialogue: 0,0:25:28.31,0:25:29.15,Default,,0,0,0,,Сол әмияны—
Dialogue: 0,0:25:29.94,0:25:31.48,Default,,0,0,0,,Жерге…
Dialogue: 0,0:25:31.82,0:25:33.53,Default,,0,0,0,,Қария!
Dialogue: 0,0:25:36.86,0:25:40.66,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,0:25:53.21,0:25:57.22,Default,,0,0,0,,Николь PK7953M Мен сені көтеріп алдым.
Dialogue: 0,0:25:58.05,0:26:00.35,Default,,0,0,0,,Такеру қайтып келді.
Dialogue: 0,0:26:00.72,0:26:01.85,Default,,0,0,0,,Алайда Қара өлімші тек дәптерге қол тигізгендерге ғана көрінеді.
Dialogue: 0,0:26:02.76,0:26:03.47,Default,,0,0,0,,(Каори) Жоқ, бірақ... (Косей) Ақыл-жастарың ұқсас болғандықтан ба?
Dialogue: 0,0:26:03.85,0:26:07.27,Default,,0,0,0,,Магистратура сізді жер астында күтіп тұр.
Dialogue: 0,0:26:08.60,0:26:10.19,Default,,0,0,0,,Шекара!
Dialogue: 0,0:26:14.78,0:26:18.24,Default,,0,0,0,,Міне, рахмет Алан.
Dialogue: 0,0:26:19.24,0:26:20.37,Default,,0,0,0,,Алан…
Dialogue: 0,0:26:20.53,0:26:23.29,Default,,0,0,0,,Бұлай болса, не болса да, жер...
Dialogue: 0,0:26:26.66,0:26:27.41,Default,,0,0,0,,Такеру!
Dialogue: 0,0:26:28.29,0:26:29.71,Default,,0,0,0,,Осы жерден бөлінейік
Dialogue: 0,0:26:29.92,0:26:30.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:30.96,0:26:33.04,Default,,0,0,0,,Мен жер астына бағыт алдым
Dialogue: 0,0:26:33.34,0:26:36.92,Default,,0,0,0,,…Таку! Сіз не айттыңыз?
Dialogue: 0,0:26:37.38,0:26:39.05,Default,,0,0,0,,Бастауға дайын...
Dialogue: 0,0:26:40.51,0:26:41.43,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:26:41.55,0:26:42.85,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:26:43.01,0:26:45.14,Default,,0,0,0,,Алан мен Аоды қалпына келтіріңіз
Dialogue: 0,0:26:45.31,0:26:46.39,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:26:46.56,0:26:49.73,Default,,0,0,0,,Мен бұл екеуін де міндетті түрде жерге апарамын.
Dialogue: 0,0:26:50.15,0:26:51.48,Default,,0,0,0,,Такеру
Dialogue: 0,0:26:51.77,0:26:54.82,Default,,0,0,0,,Казумамен мәселені шешіңіз.
Dialogue: 0,0:26:55.15,0:26:56.28,Default,,0,0,0,,Тира, біз асығуымыз керек.
Dialogue: 0,0:26:56.44,0:26:57.74,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:26:58.70,0:26:59.86,Default,,0,0,0,,Такеру…
Dialogue: 0,0:27:04.28,0:27:05.74,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:27:05.99,0:27:06.83,Default,,0,0,0,,Әй?
Dialogue: 0,0:27:07.08,0:27:07.95,Default,,0,0,0,,Хмф!
Dialogue: 0,0:27:10.37,0:27:12.67,Default,,0,0,0,,Жер бетінде бірге
Dialogue: 0,0:27:13.17,0:27:14.25,Default,,0,0,0,,О
Dialogue: 0,0:27:15.80,0:27:16.92,Default,,0,0,0,,Жерге
Dialogue: 0,0:27:22.43,0:27:25.10,Default,,0,0,0,,Такеру аман, уайымдама.
Dialogue: 0,0:27:26.81,0:27:30.35,Default,,0,0,0,,Nicole PK7953M Жеке сөйлесуден аулақ болыңыз.
Dialogue: 0,0:27:31.14,0:27:32.44,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:27:32.94,0:27:35.44,Default,,0,0,0,,Такеру сені алып кетуге келеді.
Dialogue: 0,0:27:36.15,0:27:37.48,Default,,0,0,0,,Казума-кун
Dialogue: 0,0:27:38.15,0:27:39.78,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:27:39.94,0:27:43.95,Default,,0,0,0,,Едем тұрғындарын бұдан былай олардың болашағынан айыруға құқығы жоқ.
Dialogue: 0,0:27:44.07,0:27:48.50,Default,,0,0,0,,Сіз мемлекеттік корпорацияның бұрынғы басшысы болсаңыз да.
Dialogue: 0,0:27:49.62,0:27:52.04,Default,,0,0,0,,Жас ханымның орнынан кетуін сұраңыз.
Dialogue: 0,0:27:52.29,0:27:53.29,Default,,0,0,0,,Иә
Dialogue: 0,0:27:53.50,0:27:57.50,Default,,0,0,0,,Өтінемін, Такеру білуіңізді қалайды.
Dialogue: 0,0:27:57.67,0:27:59.80,Default,,0,0,0,,Мен де сенің көргеніңді қалаймын.
Dialogue: 0,0:28:00.13,0:28:03.01,Default,,0,0,0,,Шексіз көк аспан мен теңіз
Dialogue: 0,0:28:03.18,0:28:06.22,Default,,0,0,0,,Тар дулығаңызды шешіп, жер бетінде жүріңіз
Dialogue: 0,0:28:06.39,0:28:08.35,Default,,0,0,0,,Сіз ұмыттыңыз ба?
Dialogue: 0,0:28:08.52,0:28:12.98,Default,,0,0,0,,Адамзат бәрінен айырылып қала жаздады.
Dialogue: 0,0:28:13.35,0:28:15.27,Default,,0,0,0,,Ендеше басынан қайта бастаңыз
Dialogue: 0,0:28:15.48,0:28:19.65,Default,,0,0,0,,Адамзат бір рет сәтсіздікке ұшырады, қайта емес.
Dialogue: 0,0:28:20.49,0:28:22.99,Default,,0,0,0,,Бір ғана жер бар
Dialogue: 0,0:28:23.36,0:28:29.79,Default,,0,0,0,,Едемде бар технология ай әлемінде өмір сүру үшін маңызды күш болып табылады.
Dialogue: 0,0:28:29.95,0:28:35.63,Default,,0,0,0,,Бірақ қайта жаңғырған көк жерде оны дұрыс қолданбасақ не болады?
Dialogue: 0,0:28:36.04,0:28:40.51,Default,,0,0,0,,Бір қатені қайталамауымыз керек
Dialogue: 0,0:28:41.55,0:28:48.22,Default,,0,0,0,,Едемде жер әлі өлі деген өтірік туды...
Dialogue: 0,0:28:48.89,0:28:51.68,Default,,0,0,0,,Ата-бабаларымыздың даналығын сақтау керек
Dialogue: 0,0:28:51.85,0:28:56.02,Default,,0,0,0,,Ол енді Едемнен ешқашан кете алмайды.
Dialogue: 0,0:28:57.06,0:29:00.19,Default,,0,0,0,,Сіз қайғылы адамсыз
Dialogue: 0,0:29:00.36,0:29:03.24,Default,,0,0,0,,Бірге тұратын адамдарға қалай сенбеуге болады?
Dialogue: 0,0:29:03.40,0:29:05.70,Default,,0,0,0,,Сіз қазір төмен түсе аласыз.
Dialogue: 0,0:29:06.24,0:29:10.33,Default,,0,0,0,,Толығырақ... көбірек сеніңіз.
Dialogue: 0,0:29:11.49,0:29:15.75,Default,,0,0,0,,Заман өзгерді, маған екі адам айтты.
Dialogue: 0,0:29:16.04,0:29:21.09,Default,,0,0,0,,Біз екеуміз ғана. Тек жыртықты түзетіңіз.
Dialogue: 0,0:29:22.80,0:29:24.17,Default,,0,0,0,,Бұл соңы емес
Dialogue: 0,0:29:24.67,0:29:26.63,Default,,0,0,0,,Бұл бастама!
Dialogue: 0,0:29:28.55,0:29:29.97,Default,,0,0,0,,Түсінбейсің бе?
Dialogue: 0,0:29:30.14,0:29:33.48,Default,,0,0,0,,Жерден зымырандар бұдан былай талай рет келеді.
Dialogue: 0,0:29:35.56,0:29:39.11,Default,,0,0,0,,Өйткені біз айға қарап үлгердік, ал үлкен апаттан кейін...
Dialogue: 0,0:29:39.23,0:29:42.98,Default,,0,0,0,,Барлығыңызды тастап кеткенім үшін өкінудің қажеті жоқ.
Dialogue: 0,0:29:43.74,0:29:45.95,Default,,0,0,0,,Ай мен Жер Жер мен Ай
Dialogue: 0,0:29:46.11,0:29:49.28,Default,,0,0,0,,Екеуміздің аман қалғанымызды білдім.
Dialogue: 0,0:29:49.70,0:29:54.16,Default,,0,0,0,,Тәкеру мен бізден кейін сіздей адамдар болатынына сенімдімін...
Dialogue: 0,0:29:54.29,0:29:57.21,Default,,0,0,0,,Авантюристер еркіндік іздеуге шықты
Dialogue: 0,0:29:57.92,0:30:01.04,Default,,0,0,0,,Сонда сен де мен сияқты боласың...
Dialogue: 0,0:30:01.38,0:30:04.17,Default,,0,0,0,,Мені Едемдегілердің бәрі білмей-ақ ұстаңыз...
Dialogue: 0,0:30:04.34,0:30:08.76,Default,,0,0,0,,Ештеңе болмағандай кейіп танытып, білмегендей әрекет ете бересіз бе?
Dialogue: 0,0:30:09.89,0:30:10.89,Default,,0,0,0,,Тыңдаңыз
Dialogue: 0,0:30:13.22,0:30:14.27,Default,,0,0,0,,Жер бұл...
Dialogue: 0,0:30:14.81,0:30:16.06,Default,,0,0,0,,Менде бәрі жақсы!
Dialogue: 0,0:30:27.70,0:30:29.78,Default,,0,0,0,,Freedom lyuk белсендіру анықталды.
Dialogue: 0,0:30:29.95,0:30:33.08,Default,,0,0,0,,Бостандық блогының 1 авариялық ұшыру жүйесінің жұмысы расталды
Dialogue: 0,0:30:33.24,0:30:37.58,Default,,0,0,0,,2 блок, 3 блок, жоқ, 5 блокқа дейін ұшыру жүйесі іске қосылған!
Dialogue: 0,0:30:37.75,0:30:40.67,Default,,0,0,0,,Freedom Unit 1 ұшыруын тоқтату мүмкін емес
Dialogue: 0,0:30:46.97,0:30:48.30,Default,,0,0,0,,Едем...
Dialogue: 0,0:30:48.88,0:30:50.26,Default,,0,0,0,,Оны құлыптаңыз!
Dialogue: 0,0:30:51.47,0:30:58.10,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:30:59.31,0:31:00.60,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:31:00.73,0:31:05.11,Default,,0,0,0,,Әрбір күмбез Едем заңының 6-бабының ережелеріне сәйкес жабылады.
Dialogue: 0,0:31:05.32,0:31:06.65,Default,,0,0,0,,Азаматтар тез арада -
Dialogue: 0,0:31:06.78,0:31:08.95,Default,,0,0,0,,Апаттық эвакуациялық баспанаға көшіңіз
Dialogue: 0,0:31:09.07,0:31:10.49,Default,,0,0,0,,Азаматтар тез арада -
Dialogue: 0,0:31:10.61,0:31:13.45,Default,,0,0,0,,Апаттық эвакуациялық баспанаға көшіңіз
Dialogue: 0,0:31:16.87,0:31:18.25,Default,,0,0,0,,Такеру…
Dialogue: 0,0:31:18.75,0:31:21.79,Default,,0,0,0,,(Көліктің жүгіру дыбысы)
Dialogue: 0,0:31:21.92,0:31:26.00,Default,,0,0,0,,Қазір кеттік, Казума!
Dialogue: 0,0:31:32.39,0:31:34.30,Default,,0,0,0,,Мен енді Дройтпен кездесемін.
Dialogue: 0,0:31:34.47,0:31:35.47,Default,,0,0,0,,Га
Dialogue: 0,0:31:35.60,0:31:39.31,Default,,0,0,0,,Мен оны қайта тәрбиелеу мекемесіне апарған соң, далалық командаға қайта ораламын.
Dialogue: 0,0:31:39.81,0:31:40.89,Default,,0,0,0,,Мен де солай ойладым, бірақ бұл шешімді талқылаудың қажеті жоқ
Dialogue: 0,0:31:41.06,0:31:42.02,Default,,0,0,0,,Иә
Dialogue: 0,0:31:47.19,0:31:49.28,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:31:53.36,0:31:54.57,Default,,0,0,0,,Уф...
Dialogue: 0,0:32:25.02,0:32:26.86,Default,,0,0,0,,(көліктің үдеу дыбысы)
Dialogue: 0,0:32:28.78,0:32:30.53,Default,,0,0,0,,Казмар!
Dialogue: 0,0:32:30.78,0:32:32.36,Default,,0,0,0,,Такеру!
Dialogue: 0,0:32:32.74,0:32:34.70,Default,,0,0,0,,(Слақ еткен дыбыс)
Dialogue: 0,0:32:41.29,0:32:43.50,Default,,0,0,0,,Бұл артық емес пе?
Dialogue: 0,0:32:46.33,0:32:48.34,Default,,0,0,0,,Ооооооооооооооооооооооооооооо
Dialogue: 0,0:32:54.30,0:32:59.01,Default,,0,0,0,,Такеру Бис Казума және Ао
Dialogue: 0,0:32:59.47,0:33:01.93,Default,,0,0,0,,Балалар маған сабақ берді
Dialogue: 0,0:33:02.31,0:33:04.69,Default,,0,0,0,,Шытырман оқиға, еркіндік...
Dialogue: 0,0:33:05.81,0:33:08.69,Default,,0,0,0,,Жер керемет
Dialogue: 0,0:33:09.69,0:33:14.61,Default,,0,0,0,,Біздің әрқайсымыздың біз білмей тұрып ұмыта бастаған әлеует
Dialogue: 0,0:33:14.78,0:33:17.91,Default,,0,0,0,,Ай мен Жер Жер мен Ай
Dialogue: 0,0:33:18.03,0:33:21.91,Default,,0,0,0,,Бір-біріміздің бар екенін мойындаудан бастайық
Dialogue: 0,0:33:22.33,0:33:24.21,Default,,0,0,0,,Уау
Dialogue: 0,0:33:38.68,0:33:40.39,Default,,0,0,0,,Сен не үшін келдің?
Dialogue: 0,0:33:41.35,0:33:43.35,Default,,0,0,0,,Әлі жоқ!
Dialogue: 0,0:33:44.85,0:33:46.60,Default,,0,0,0,,тым кеш!
Dialogue: 0,0:33:51.77,0:33:53.23,Default,,0,0,0,,Мен сені алып кетуге келдім.
Dialogue: 0,0:33:53.36,0:33:54.24,Default,,0,0,0,,Wo...
Dialogue: 0,0:33:54.90,0:33:56.82,Default,,0,0,0,,Мен кешігіп қалдым, бірақ
Dialogue: 0,0:33:57.66,0:33:58.70,Default,,0,0,0,,(Ванिला Айс) Абдурды ұсақ-түйекке айналдырды.
Dialogue: 0,0:33:59.57,0:34:00.74,Default,,0,0,0,,Нуах
Dialogue: 0,0:34:03.54,0:34:07.46,Default,,0,0,0,,(Казума мен Такерудың ауыр тыныс алуы)
Dialogue: 0,0:34:07.58,0:34:09.79,Default,,0,0,0,,Екі жарым жыл.
Dialogue: 0,0:34:11.13,0:34:12.67,Default,,0,0,0,,Нашар
Dialogue: 0,0:34:13.42,0:34:17.30,Default,,0,0,0,,Сіз фотодағы қызды таптыңыз...
Dialogue: 0,0:34:18.22,0:34:19.43,Default,,0,0,0,,О
Dialogue: 0,0:34:21.51,0:34:24.22,Default,,0,0,0,,Ерік-жігері күшті, бірақ жақсы қыз.
Dialogue: 0,0:34:26.81,0:34:27.69,Default,,0,0,0,,Ооо! ?
Dialogue: 0,0:34:28.19,0:34:29.73,Default,,0,0,0,,Егер мен білген болсам...
Dialogue: 0,0:34:30.94,0:34:32.52,Default,,0,0,0,,Жақсы болғанша, жақсы.
Dialogue: 0,0:34:33.19,0:34:34.57,Default,,0,0,0,,Мен менмін...
Dialogue: 0,0:34:35.19,0:34:37.57,Default,,0,0,0,,Қолымнан келгенін жасауға тырыстым.
Dialogue: 0,0:34:38.95,0:34:40.66,Default,,0,0,0,,Бис те солай айтты.
Dialogue: 0,0:34:40.82,0:34:43.12,Default,,0,0,0,,Олар сені тым байсалды дейді
Dialogue: 0,0:34:43.28,0:34:45.83,Default,,0,0,0,,Сондықтан мен сені алып кетуге жол бойы келдім.
Dialogue: 0,0:34:46.29,0:34:47.25,Default,,0,0,0,,Бұрандалар ше?
Dialogue: 0,0:34:47.41,0:34:49.29,Default,,0,0,0,,Менің Жерде қызым бар
Dialogue: 0,0:34:49.75,0:34:52.50,Default,,0,0,0,,Я, түсіндім, хаха
Dialogue: 0,0:34:53.00,0:34:55.17,Default,,0,0,0,,Бір рет кел, Жер
Dialogue: 0,0:34:55.38,0:34:57.05,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:34:58.22,0:34:59.05,Default,,0,0,0,,О
Dialogue: 0,0:34:59.22,0:35:01.43,Default,,0,0,0,,Жарайды, ең алдымен Ао.
Dialogue: 0,0:35:01.59,0:35:05.43,Default,,0,0,0,,Сондықтан мен оны осында әкелдім.
Dialogue: 0,0:35:06.52,0:35:07.98,Default,,0,0,0,,Такеру!
Dialogue: 0,0:35:09.85,0:35:12.27,Default,,0,0,0,,Ха! Ао... Уау...
Dialogue: 0,0:35:15.02,0:35:16.48,Default,,0,0,0,,Сол екеу ме?
Dialogue: 0,0:35:16.61,0:35:19.90,Default,,0,0,0,,(Еркін ұшу дыбысы)
Dialogue: 0,0:35:20.03,0:35:23.66,Default,,0,0,0,,«Бұл бастамасы»?
Dialogue: 0,0:35:25.12,0:35:27.62,Default,,0,0,0,,(жүгіру дыбысы)
Dialogue: 0,0:35:36.80,0:35:38.38,Default,,0,0,0,,Такеруге қараңыз
Dialogue: 0,0:35:43.09,0:35:45.47,Default,,0,0,0,,6-бөлім қазір Тайра күтіп тұр ма?
Dialogue: 0,0:35:45.64,0:35:46.85,Default,,0,0,0,,Біз оларды кесіп өтуіміз керек.
Dialogue: 0,0:35:47.01,0:35:48.18,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:35:50.31,0:35:52.69,Default,,0,0,0,,Әлі емес пе? Басқарма келді.
Dialogue: 0,0:35:53.06,0:35:54.65,Default,,0,0,0,,Қарғыс атсын... әлі жоқ.
Dialogue: 0,0:35:54.77,0:35:56.07,Default,,0,0,0,,А…?
Dialogue: 0,0:35:56.32,0:35:58.03,Default,,0,0,0,,Қазір қайдасың, ақымақ?
Dialogue: 0,0:35:58.19,0:36:00.70,Default,,0,0,0,,Жоқ, басқару бюросы жолды жауып тастады.
Dialogue: 0,0:36:00.86,0:36:03.36,Default,,0,0,0,,Иә? Сен не істеп жатырсың?
Dialogue: 0,0:36:03.95,0:36:05.95,Default,,0,0,0,,Тайра Мен енді күте алмаймын
Dialogue: 0,0:36:11.91,0:36:13.75,Default,,0,0,0,,Жаман...
Dialogue: 0,0:36:13.96,0:36:15.25,Default,,0,0,0,,Уақытында емес
Dialogue: 0,0:36:16.00,0:36:17.04,Default,,0,0,0,,Такеру
Dialogue: 0,0:36:17.34,0:36:19.80,Default,,0,0,0,,Такеру Ұмытып қалдыңыз ба?
Dialogue: 0,0:36:21.01,0:36:23.59,Default,,0,0,0,,Алан екеуміз алғаш кездескен жер
Dialogue: 0,0:36:26.80,0:36:28.81,Default,,0,0,0,,Мына жерде, Казума
Dialogue: 0,0:36:29.18,0:36:31.81,Default,,0,0,0,,Бұл соңғы Бостандық.
Dialogue: 0,0:36:36.65,0:36:38.40,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:36:38.57,0:36:40.15,Default,,0,0,0,,Бұл біздің құпия базамыз.
Dialogue: 0,0:36:40.28,0:36:43.03,Default,,0,0,0,,(Көліктің жүгіру дыбысы)
Dialogue: 0,0:36:43.24,0:36:44.32,Default,,0,0,0,,Бірақ Йотаро-сан бәрі жақсы деді.
Dialogue: 0,0:36:44.82,0:36:46.66,Default,,0,0,0,,Тағы бір сегізаяқ жігіт пе?
Dialogue: 0,0:36:57.00,0:36:58.75,Default,,0,0,0,,(Баяулау дыбысы)
Dialogue: 0,0:37:06.05,0:37:07.55,Default,,0,0,0,,(Серо) «Өте жылдам адам» деген лақап ат тек сән үшін ғана емес қой?
Dialogue: 0,0:37:08.64,0:37:10.31,Default,,0,0,0,,Такеру
Dialogue: 0,0:37:11.35,0:37:12.98,Default,,0,0,0,,Мен дайынмын.
Dialogue: 0,0:37:13.94,0:37:17.36,Default,,0,0,0,,Ой, балалар... бармадың ба?
Dialogue: 0,0:37:18.19,0:37:20.61,Default,,0,0,0,,Мен күткендей емес.
Dialogue: 0,0:37:20.78,0:37:23.28,Default,,0,0,0,,Бұл топтық жұмыс деп аталады.
Dialogue: 0,0:37:23.44,0:37:25.20,Default,,0,0,0,,Айтпа! …Таку
Dialogue: 0,0:37:25.70,0:37:27.70,Default,,0,0,0,,Үлкен аға, жақсысың ба?
Dialogue: 0,0:37:28.24,0:37:30.20,Default,,0,0,0,,Чио, сен мені уайымдадың.
Dialogue: 0,0:37:30.62,0:37:31.04,Default,,0,0,0,,Жерге бірге барайық
Dialogue: 0,0:37:31.04,0:37:32.50,Default,,0,0,0,,Жерге бірге барайық
Dialogue: 0,0:37:31.04,0:37:32.50,Default,,0,0,0,,Дроит Мен сені сатып кетті деп ойладым.
Dialogue: 0,0:37:32.50,0:37:32.62,Default,,0,0,0,,Дроит Мен сені сатып кетті деп ойладым.
Dialogue: 0,0:37:32.62,0:37:33.45,Default,,0,0,0,,Дроит Мен сені сатып кетті деп ойладым.
Dialogue: 0,0:37:32.62,0:37:33.45,Default,,0,0,0,,Иә
Dialogue: 0,0:37:33.58,0:37:34.46,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:37:34.58,0:37:35.21,Default,,0,0,0,,Әй?
Dialogue: 0,0:37:41.17,0:37:43.67,Default,,0,0,0,,Тегін… Дамба
Dialogue: 0,0:37:45.38,0:37:47.30,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:37:48.72,0:37:51.10,Default,,0,0,0,,Мұны істеме, олар...
Dialogue: 0,0:38:04.78,0:38:07.41,Default,,0,0,0,,Ақыр соңында, бәрі жақсы...
Dialogue: 0,0:38:07.74,0:38:08.99,Default,,0,0,0,,№.
Dialogue: 0,0:38:10.12,0:38:11.41,Default,,0,0,0,,Такеру?
Dialogue: 0,0:38:13.66,0:38:16.83,Default,,0,0,0,,Барлығыңыз, алдымен Жерге барыңыз.
Dialogue: 0,0:38:17.96,0:38:22.34,Default,,0,0,0,,Маңызды нәрсені ұмытып кеткен сияқтымын.
Dialogue: 0,0:38:23.75,0:38:25.63,Default,,0,0,0,,Өте маңызды...
Dialogue: 0,0:38:26.55,0:38:29.34,Default,,0,0,0,,Иә? Сіз не айттыңыз?
Dialogue: 0,0:38:29.55,0:38:33.14,Default,,0,0,0,,Сіз не істемексіз? Бұл сіздің соңғы еркіндігіңіз.
Dialogue: 0,0:38:34.35,0:38:38.52,Default,,0,0,0,,Осы қарқынмен мен Едемге қайта орала алмаймын.
Dialogue: 0,0:38:38.89,0:38:41.44,Default,,0,0,0,,Бұл жақсы емес
Dialogue: 0,0:38:41.90,0:38:44.98,Default,,0,0,0,,Әрине, мен барлығының Жерді көргенін қалаймын.
Dialogue: 0,0:38:45.15,0:38:47.28,Default,,0,0,0,,Олай болса, «Бостандық» бортына мініңіз.
Dialogue: 0,0:38:47.57,0:38:51.99,Default,,0,0,0,,Бірақ мен жердегі адамдардың да Едемді көргенін қалаймын.
Dialogue: 0,0:38:52.16,0:38:56.66,Default,,0,0,0,,Бұлай өтірікпен сыланған Едем емес, нағыз Едем.
Dialogue: 0,0:38:57.91,0:39:03.29,Default,,0,0,0,,Бұл орын алу үшін мен тағы бір нәрсе істеуім керек.
Dialogue: 0,0:39:03.54,0:39:06.05,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:39:06.51,0:39:09.51,Default,,0,0,0,,Бостандық ұшыруға 10 минут қалды
Dialogue: 0,0:39:11.51,0:39:14.68,Default,,0,0,0,,Барлығы, бортқа отыру уақыты келді...
Dialogue: 0,0:39:15.31,0:39:18.89,Default,,0,0,0,,Ісімді аяқтасам, мен де міндетті түрде Жерге барамын.
Dialogue: 0,0:39:19.52,0:39:20.44,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:39:21.27,0:39:22.44,Default,,0,0,0,,Такеру
Dialogue: 0,0:39:22.73,0:39:25.57,Default,,0,0,0,,Жоқ, қалай жүрсің?
Dialogue: 0,0:39:38.33,0:39:41.17,Default,,0,0,0,,Иә, мен Жерде күтемін.
Dialogue: 0,0:39:42.21,0:39:43.33,Default,,0,0,0,,О
Dialogue: 0,0:39:44.21,0:39:46.75,Default,,0,0,0,,Казума Аодан сұраңыз
Dialogue: 0,0:39:52.18,0:39:55.14,Default,,0,0,0,,Бұл уәде. Біз міндетті түрде тағы кездесеміз.
Dialogue: 0,0:39:55.76,0:39:56.93,Default,,0,0,0,,О
Dialogue: 0,0:40:05.90,0:40:08.90,Default,,0,0,0,,Кел, Казума Ао.
Dialogue: 0,0:40:14.24,0:40:16.70,Default,,0,0,0,,О? Дұрыс
Dialogue: 0,0:40:17.41,0:40:19.70,Default,,0,0,0,,Мені төменгі жағына бағыттаңыз.
Dialogue: 0,0:40:26.29,0:40:28.55,Default,,0,0,0,,Тәкеру, сен неге...
Dialogue: 0,0:40:28.67,0:40:29.88,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:40:30.01,0:40:30.67,Default,,0,0,0,,Қария!
Dialogue: 0,0:40:37.35,0:40:38.35,Default,,0,0,0,,Жоғалып кетті…
Dialogue: 0,0:40:39.72,0:40:41.93,Default,,0,0,0,,Ата, жақсысыз ба?
Dialogue: 0,0:40:42.10,0:40:42.89,Default,,0,0,0,,О
Dialogue: 0,0:40:44.65,0:40:47.73,Default,,0,0,0,,Сіз Такерусыз ба?
Dialogue: 0,0:40:55.24,0:40:58.33,Default,,0,0,0,,Неліктен Едем бізге өтірік айтты?
Dialogue: 0,0:40:59.24,0:41:03.50,Default,,0,0,0,,Едемге не үшін оралдың?
Dialogue: 0,0:41:04.12,0:41:07.21,Default,,0,0,0,,Мен Аоның Едемді көргенін қалаймын
Dialogue: 0,0:41:07.38,0:41:10.38,Default,,0,0,0,,Мен жер бетіндегі адамдардың да Едем туралы білгенін қалаймын.
Dialogue: 0,0:41:10.63,0:41:12.13,Default,,0,0,0,,Сол үшін қайтып келдім
Dialogue: 0,0:41:12.30,0:41:14.59,Default,,0,0,0,,Шындықты білгенде не істеу керек
Dialogue: 0,0:41:14.76,0:41:21.02,Default,,0,0,0,,Егер Эдем технологиясы мен Жер біріктірілсе, адамдар сол қатені қайталайды.
Dialogue: 0,0:41:21.18,0:41:24.52,Default,,0,0,0,,Маған сеніңіз, мен көрдім.
Dialogue: 0,0:41:25.02,0:41:27.06,Default,,0,0,0,,Жер бетіндегі адамдар неден зардап шегеді
Dialogue: 0,0:41:27.44,0:41:30.19,Default,,0,0,0,,Мен не істеп жатырмын, неден ләззат аламын
Dialogue: 0,0:41:30.36,0:41:32.53,Default,,0,0,0,,Олар да бізді қабылдады.
Dialogue: 0,0:41:33.32,0:41:37.24,Default,,0,0,0,,Біз Едемді қорғауға міндеттіміз
Dialogue: 0,0:41:37.95,0:41:41.99,Default,,0,0,0,,Неліктен ай мен жер бірге өмір сүре алмайды?
Dialogue: 0,0:41:42.45,0:41:43.87,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:41:44.04,0:41:50.75,Default,,0,0,0,,Біздің ұрпақ ай мен жер үшін не істей алады?
Dialogue: 0,0:41:51.13,0:41:54.67,Default,,0,0,0,,Бостандық іске қосылды!
Dialogue: 0,0:42:00.51,0:42:02.85,Default,,0,0,0,,Бостандық...?
Dialogue: 0,0:42:05.64,0:42:07.81,Default,,0,0,0,,Дұрыс айтасың, Такеру.
Dialogue: 0,0:42:08.40,0:42:11.02,Default,,0,0,0,,Басынан бастаңыз
Dialogue: 0,0:42:11.52,0:42:16.32,Default,,0,0,0,,Ай мен жердің бірге өмір сүруінің жолы бар
Dialogue: 0,0:42:16.90,0:42:23.83,Default,,0,0,0,,Егер сіз сол баланы қуып 380 000 шақырым жол жүрсеңіз...
Dialogue: 0,0:42:24.20,0:42:26.83,Default,,0,0,0,,Кез келген нәрсені істей алады
Dialogue: 0,0:42:27.37,0:42:29.50,Default,,0,0,0,,О, оны маған қалдырыңыз.
Dialogue: 0,0:42:29.79,0:42:32.04,Default,,0,0,0,,Әй, қария?
Dialogue: 0,0:42:38.01,0:42:39.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:41.89,0:42:47.52,Default,,0,0,0,,Алан соңғы екі жыл бойы өмір бойы медициналық мекемеде болды.
Dialogue: 0,0:42:47.69,0:42:50.52,Default,,0,0,0,,Қауіпсіздік мақсатында ғана емес
Dialogue: 0,0:42:51.06,0:42:56.15,Default,,0,0,0,,Бірақ мына жиіркенішті қанағаттанған жүзге қараңызшы.
Dialogue: 0,0:42:57.07,0:42:59.07,Default,,0,0,0,,Оны ұмытпа.
Dialogue: 0,0:42:59.24,0:43:04.58,Default,,0,0,0,,Бостандықты саған аманат еткен адамның аты...
Dialogue: 0,0:43:05.79,0:43:09.08,Default,,0,0,0,,(Такерудың жылауы)
Dialogue: 0,0:43:18.42,0:43:20.01,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:43:20.47,0:43:22.55,Default,,0,0,0,,Басынан бастаңыз
Dialogue: 0,0:43:24.26,0:43:27.73,Default,,0,0,0,,Ай мен Жер Жер мен Ай
Dialogue: 0,0:43:28.98,0:43:30.81,Default,,0,0,0,,Барлығы бірге
Dialogue: 0,0:43:32.10,0:43:34.23,Default,,0,0,0,,... дұрыс па? қарт адам
Dialogue: 0,0:43:48.79,0:43:50.79,Default,,0,0,0,,Иә, ааа
Dialogue: 0,0:43:53.21,0:43:56.09,Default,,0,0,0,,«Жоғарыда пайда болған алтын жұлдыздан-»
Dialogue: 0,0:43:56.21,0:44:00.92,Default,,0,0,0,,«Бір күні молшылық пен молшылық міндетті түрде келеді».
Dialogue: 0,0:44:01.18,0:44:07.31,Default,,0,0,0,,«Бостандық басшылыққа алған шыншылдық пен даналық сынықтары»?
Dialogue: 0,0:44:08.47,0:44:11.44,Default,,0,0,0,,Аңыз ақиқат болды.
Dialogue: 0,0:44:23.74,0:44:25.82,Default,,0,0,0,,А, аққан жұлдыз?
Dialogue: 0,0:44:26.33,0:44:27.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:32.16,0:44:35.00,Default,,0,0,0,,Бұл жоспарланғаннан ертерек.
Dialogue: 0,0:44:35.17,0:44:36.21,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:44:43.59,0:44:45.22,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:44:52.81,0:44:53.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:57.31,0:44:59.32,Default,,0,0,0,,Бұл негізсіз
Dialogue: 0,0:44:59.48,0:45:00.44,Default,,0,0,0,,Ах!
Dialogue: 0,0:45:04.86,0:45:05.61,Default,,0,0,0,,Аттаттаттат
Dialogue: 0,0:45:08.03,0:45:12.50,Default,,0,0,0,,Эй, мен сені қайтадан алып кетуге келдім.
Dialogue: 0,0:45:15.71,0:45:16.75,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:45:16.88,0:45:18.88,Default,,0,0,0,,Кешіктің, Такеру!
Dialogue: 0,0:45:20.88,0:45:22.05,Default,,0,0,0,,Эхехе
Dialogue: 0,0:45:22.38,0:45:23.92,Default,,0,0,0,,Такеру! Хаа...
Dialogue: 0,0:45:28.18,0:45:29.35,Default,,0,0,0,,Ух ха ха
Dialogue: 0,0:45:29.56,0:45:31.18,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:45:31.72,0:45:33.31,Default,,0,0,0,,Келесі жолы қайда барасыз?
Dialogue: 0,0:45:33.73,0:45:37.10,Default,,0,0,0,,Келесіде Марс, Алан бар.
Dialogue: 0,0:45:37.69,0:45:40.02,Default,,0,0,0,,Марс? Мен сонда барып көрдім.
Dialogue: 0,0:45:40.27,0:45:42.19,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:45:42.65,0:45:44.07,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:45:44.19,0:45:48.49,Default,,0,0,0,,Балалар сендер ақымақсыңдар!
Dialogue: 0,0:46:29.36,0:46:35.37,Default,,0,0,0,,♪～
Dialogue: 0,0:47:52.70,0:47:58.70,Default,,0,0,0,,～♪
Dialogue: 0,0:48:00.20,0:48:06.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory