Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.70,0:00:05.20,Default,,0,0,0,,Жеңімпаз Широган!
Dialogue: 0,0:00:05.20,0:00:11.71,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:00:11.71,0:00:14.71,Default,,0,0,0,,Біркелкі киімдер әлемді бояйды➡
Dialogue: 0,0:00:14.71,0:00:20.22,Default,,0,0,0,,Бұл кез келген адам қаласа, ең күшті бола алатын тамаша болашақ.
Dialogue: 0,0:00:20.22,0:00:24.72,Default,,0,0,0,,Мен мұны өзім ғана істей алатындай етіп жасаймын➡
Dialogue: 0,0:00:24.72,0:00:28.22,Default,,0,0,0,,Осы әлемде көшбасшы бол!
Dialogue: 0,0:00:29.22,0:00:31.73,Default,,0,0,0,,《Бұл сіздің миссияңыз ба? 》
Dialogue: 0,0:00:36.23,0:00:38.23,Default,,0,0,0,,Закуса!
Dialogue: 0,0:00:57.75,0:00:59.76,Default,,0,0,0,,Сіз...! (Көрермендер) Ой! Широган осында!
Dialogue: 0,0:00:59.76,0:01:01.76,Default,,0,0,0,,U….
Dialogue: 0,0:01:07.20,0:01:09.70,Default,,0,0,0,,Широган~!
Dialogue: 0,0:01:09.70,0:01:11.70,Default,,0,0,0,,А, мен кеттім.
Dialogue: 0,0:01:23.21,0:01:25.71,Default,,0,0,0,,Уақыт келді...
Dialogue: 0,0:01:25.71,0:01:27.72,Default,,0,0,0,,Мен сені көруге барайын ба?
Dialogue: 0,0:03:02.14,0:03:04.15,Default,,0,0,0,,Бавсагарамен шабуыл!
Dialogue: 0,0:03:04.15,0:03:06.15,Default,,0,0,0,,Ge! Күзетші жоқ.
Dialogue: 0,0:03:06.15,0:03:08.65,Default,,0,0,0,,Ах! Мирей-сама...ол емес пе➡
Dialogue: 0,0:03:08.65,0:03:10.62,Default,,0,0,0,,Мираи-сан!
Dialogue: 0,0:03:11.65,0:03:13.66,Default,,0,0,0,,Yaho!
Dialogue: 0,0:03:13.66,0:03:15.66,Default,,0,0,0,,Барлығы көңілді ме?
Dialogue: 0,0:03:15.66,0:03:18.66,Default,,0,0,0,,Сәлем! Мен жеңдім!
Dialogue: 0,0:03:18.66,0:03:21.16,Default,,0,0,0,,Жарайды...Оған дейін мен жеңдім!
Dialogue: 0,0:03:21.16,0:03:23.67,Default,,0,0,0,,Сонымен, сіз мұны қайталағыңыз келе ме? (Бала) Мен мұны істеймін!
Dialogue: 0,0:03:23.67,0:03:25.67,Default,,0,0,0,,Хехе.
Dialogue: 0,0:03:25.67,0:03:27.67,Default,,0,0,0,,Сәлем, Милэй мырза.
Dialogue: 0,0:03:27.67,0:03:29.67,Default,,0,0,0,,Мирей-сан Широгандан күшті ме?
Dialogue: 0,0:03:29.67,0:03:31.61,Default,,0,0,0,,Мен оның күшті екеніне сенімдімін!
Dialogue: 0,0:03:31.61,0:03:35.11,Default,,0,0,0,,Бірақ мектептегілердің бәрі форманың ең басты нәрсе екенін айтады...
Dialogue: 0,0:03:35.11,0:03:37.11,Default,,0,0,0,,Миллей-сан да күшті.
Dialogue: 0,0:03:37.11,0:03:41.12,Default,,0,0,0,,Хмм, егер бұл соңғы болса, мен жеңе алмауым мүмкін.
Dialogue: 0,0:03:41.12,0:03:43.12,Default,,0,0,0,,E➡
Dialogue: 0,0:03:43.12,0:03:45.12,Default,,0,0,0,,Ех!
Dialogue: 0,0:03:45.12,0:03:47.62,Default,,0,0,0,,Хехе...егер бұл шын мәнінде ең соңғы болса➡
Dialogue: 0,0:03:47.62,0:03:49.62,Default,,0,0,0,,Бірақ ондай адам жоқ➡
Dialogue: 0,0:03:49.62,0:03:52.63,Default,,0,0,0,,Барлығы абдырап, уайымдады➡
Dialogue: 0,0:03:52.63,0:03:55.63,Default,,0,0,0,,Сәтсіз және әрекетті қайталаңыз➡
Dialogue: 0,0:03:55.63,0:03:59.13,Default,,0,0,0,,Біртіндеп алға жылжу.
Dialogue: 0,0:03:59.13,0:04:03.14,Default,,0,0,0,,Широган күшті болуы мүмкін, бірақ ол соңғы емес.
Dialogue: 0,0:04:03.14,0:04:05.14,Default,,0,0,0,,Онда сіз жеңе аласыз➡
Dialogue: 0,0:04:05.14,0:04:07.11,Default,,0,0,0,,Мен ғана емес, бәрі де!
Dialogue: 0,0:04:08.14,0:04:10.15,Default,,0,0,0,,Мен де?
Dialogue: 0,0:04:10.15,0:04:13.15,Default,,0,0,0,,Ум! Ол үшін бар күшіңізбен ойланыңыз➡
Dialogue: 0,0:04:13.15,0:04:15.15,Default,,0,0,0,,Бар күшіңмен соқтығыс➡
Dialogue: 0,0:04:15.15,0:04:18.65,Default,,0,0,0,,Ең бастысы сәтсіздіктен қорқудан қашпау.
Dialogue: 0,0:04:18.65,0:04:20.66,Default,,0,0,0,,Қашпа.
Dialogue: 0,0:04:20.66,0:04:23.66,Default,,0,0,0,,Әлі де жеңілсем, қатты көңілім қалады.
Dialogue: 0,0:04:23.66,0:04:25.66,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын! ➡
Dialogue: 0,0:04:25.66,0:04:27.66,Default,,0,0,0,,Миллей-сан, күресейік!
Dialogue: 0,0:04:27.66,0:04:29.66,Default,,0,0,0,,Мен де!
Dialogue: 0,0:04:29.66,0:04:31.63,Default,,0,0,0,,Эй...эй, өз кезегіңді ал! Сіздің кезегіңіз!
Dialogue: 0,0:04:32.60,0:04:36.07,Default,,0,0,0,,《Мирей-сама, сен шынымен күшті болып кеттің. 》
Dialogue: 0,0:04:37.61,0:04:40.11,Default,,0,0,0,,《Якубукуро отбасын алып жүрген адам ретінде➡
Dialogue: 0,0:04:40.11,0:04:44.11,Default,,0,0,0,,Мен Миллай-саманы қорғауға жан-тәнімді төктім.
Dialogue: 0,0:04:44.11,0:04:46.11,Default,,0,0,0,,Бірақ бұл ➡
Dialogue: 0,0:04:46.11,0:04:49.12,Default,,0,0,0,,Масанори сияқты адамға сізден пайда алу мүмкіндігін беріңіз➡
Dialogue: 0,0:04:49.12,0:04:52.12,Default,,0,0,0,,Таңертеңнен кейін келмейтін команданың жалауын ұрлаңыз➡
Dialogue: 0,0:04:52.12,0:04:55.12,Default,,0,0,0,,Идеалдан алыс әрекеттерді кешіріңіз➡
Dialogue: 0,0:04:55.12,0:04:58.13,Default,,0,0,0,,Миллэй ханым енді ешкімге сене алмайды➡
Dialogue: 0,0:04:58.13,0:05:01.63,Default,,0,0,0,,соншалық, олар электр қуатын өшіруді жоюды жариялады.
Dialogue: 0,0:05:01.63,0:05:05.63,Default,,0,0,0,,Мирей-саманың жүрегін балқытқан – Юйю Кондо.
Dialogue: 0,0:05:05.63,0:05:08.64,Default,,0,0,0,,Милле-самаға шын мәнінде қажет нәрсе болды➡
Dialogue: 0,0:05:08.64,0:05:12.14,Default,,0,0,0,,Олар бір-бірімен бар күшімен соқтығысатын достар болды.
Dialogue: 0,0:05:12.14,0:05:14.14,Default,,0,0,0,,Және... 》
Dialogue: 0,0:05:14.14,0:05:16.14,Default,,0,0,0,,《Мен қарсымын!
Dialogue: 0,0:05:16.14,0:05:18.15,Default,,0,0,0,,Туды қайтаруға Мирай-сама өзі барады!
Dialogue: 0,0:05:18.15,0:05:20.15,Default,,0,0,0,,Сақталған жалаушаны қайтарыңыз➡
Dialogue: 0,0:05:20.15,0:05:22.15,Default,,0,0,0,,Жоғалғанды қайта жасаңыз.
Dialogue: 0,0:05:22.15,0:05:24.15,Default,,0,0,0,,Әрине, солай ма?
Dialogue: 0,0:05:24.15,0:05:26.15,Default,,0,0,0,,Біз мұны өз күшімізбен жасадық!
Dialogue: 0,0:05:26.15,0:05:28.66,Default,,0,0,0,,Миллай-саманың ешқандай жауапкершілігі жоқ...
Dialogue: 0,0:05:28.66,0:05:30.59,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:30.59,0:05:33.09,Default,,0,0,0,,Мен таңның жетекшісімін.
Dialogue: 0,0:05:33.09,0:05:36.10,Default,,0,0,0,,Мен сені бар күшіммен ұрғым келеді➡
Dialogue: 0,0:05:36.10,0:05:38.10,Default,,0,0,0,,Сондықтан қашқым келмейді.
Dialogue: 0,0:05:38.10,0:05:40.10,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:05:40.10,0:05:42.10,Default,,0,0,0,,Бұл қатыгез, Харука➡
Dialogue: 0,0:05:42.10,0:05:44.07,Default,,0,0,0,,Менің қайта туылуым үшін!
Dialogue: 0,0:05:46.11,0:05:48.61,Default,,0,0,0,,Бұл жігіт өзінше күресіп, бұзады➡
Dialogue: 0,0:05:48.61,0:05:51.61,Default,,0,0,0,,Егер бұлай болса, мен оған жету үшін бар күшімді салуым керек.
Dialogue: 0,0:05:51.61,0:05:53.62,Default,,0,0,0,,Сәлем, Харука!
Dialogue: 0,0:05:53.62,0:05:56.08,Default,,0,0,0,,Харука да мені қолдай ма?
Dialogue: 0,0:05:58.12,0:06:00.62,Default,,0,0,0,,Мен сенімен бірге барамын.
Dialogue: 0,0:06:00.62,0:06:02.59,Default,,0,0,0,,Рахмет! Харука. 》
Dialogue: 0,0:06:06.63,0:06:09.13,Default,,0,0,0,,《Содан бері мен әр команданы бір-бірден аралап шықтым➡
Dialogue: 0,0:06:09.13,0:06:11.13,Default,,0,0,0,,Мен туды қайтаруға бардым.
Dialogue: 0,0:06:11.13,0:06:13.64,Default,,0,0,0,,Позиция жоқ, идеал жоқ, жоғарғы немесе төменгі жоқ➡
Dialogue: 0,0:06:13.64,0:06:17.64,Default,,0,0,0,,Мен Авангардты жақсы көремін.
Dialogue: 0,0:06:17.64,0:06:19.64,Default,,0,0,0,,Міне.
Dialogue: 0,0:06:19.64,0:06:22.14,Default,,0,0,0,,Миллэй ханым туды қайтару үстінде➡
Dialogue: 0,0:06:22.14,0:06:25.15,Default,,0,0,0,,Мен әртүрлі командаларға қарсы күрестім.
Dialogue: 0,0:06:25.15,0:06:28.15,Default,,0,0,0,,Содан кейін, Миллай-сама➡
Dialogue: 0,0:06:28.15,0:06:30.59,Default,,0,0,0,,Мен өз ойымды нақты айта бастадым.
Dialogue: 0,0:06:30.59,0:06:33.59,Default,,0,0,0,,Данжи екеуміздің алдымда ғана көрсеткен күлкің➡
Dialogue: 0,0:06:33.59,0:06:36.59,Default,,0,0,0,,Ол қазір тіпті Оякубукуро отбасында да көрсетіледі.
Dialogue: 0,0:06:36.59,0:06:38.59,Default,,0,0,0,,Миллай-сама➡
Dialogue: 0,0:06:38.59,0:06:40.56,Default,,0,0,0,,Қайта туылған.
Dialogue: 0,0:06:44.10,0:06:47.07,Default,,0,0,0,,Мен өз қалауым бойынша ұша алатын қанаттар алдым.
Dialogue: 0,0:06:50.61,0:06:53.07,Default,,0,0,0,,Бірақ мен... 》
Dialogue: 0,0:06:54.11,0:06:56.11,Default,,0,0,0,,Харука? Ха!
Dialogue: 0,0:06:56.11,0:06:58.61,Default,,0,0,0,,Не болды? Харука➡
Dialogue: 0,0:06:58.61,0:07:01.12,Default,,0,0,0,,Харука да төбелеседі, солай ма?
Dialogue: 0,0:07:01.12,0:07:03.08,Default,,0,0,0,,Тек… бала сенің жаныңнан алыстап бара жатқанда…
Dialogue: 0,0:07:04.62,0:07:07.62,Default,,0,0,0,,《Иә, мен... 》
Dialogue: 0,0:07:07.62,0:07:12.13,Default,,0,0,0,,📱 Кешіріңіз.
Dialogue: 0,0:07:12.13,0:07:14.63,Default,,0,0,0,,Харука?
Dialogue: 0,0:07:14.63,0:07:17.13,Default,,0,0,0,,Кешіріңіз, Миллай-сама. Un?
Dialogue: 0,0:07:17.13,0:07:20.14,Default,,0,0,0,,Алдын ала кешірім сұраймын.
Dialogue: 0,0:07:20.14,0:07:22.14,Default,,0,0,0,,...
Dialogue: 0,0:07:22.14,0:07:24.14,Default,,0,0,0,,Құрметті Милэй, өтінемін.
Dialogue: 0,0:07:24.14,0:07:26.11,Default,,0,0,0,,Ха...сәлем!
Dialogue: 0,0:07:29.14,0:07:31.11,Default,,0,0,0,,Ым?
Dialogue: 0,0:07:36.08,0:07:38.09,Default,,0,0,0,,Фазалық тест мені қобалжытады.
Dialogue: 0,0:07:38.09,0:07:41.09,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл әлі бірінші кезең, солай ма?
Dialogue: 0,0:07:41.09,0:07:45.09,Default,,0,0,0,,Жоқ, жоқ, менің ең күшті жолым осы жерден басталады!
Dialogue: 0,0:07:45.09,0:07:47.56,Default,,0,0,0,,Біркелкі киімдер ең жақсысы.
Dialogue: 0,0:07:52.60,0:07:55.10,Default,,0,0,0,,Уау! кешіріңіз.
Dialogue: 0,0:07:55.10,0:07:57.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:57.11,0:07:59.61,Default,,0,0,0,,Лейка мырза! Алға қара.
Dialogue: 0,0:07:59.61,0:08:01.61,Default,,0,0,0,,Мен...Кешіріңіз!
Dialogue: 0,0:08:01.61,0:08:03.61,Default,,0,0,0,,Иә? Студенттер кеңесінің төрағасы?
Dialogue: 0,0:08:03.61,0:08:05.61,Default,,0,0,0,,Неліктен сіз бірінші курстасыз?
Dialogue: 0,0:08:05.61,0:08:08.12,Default,,0,0,0,,Мм... мұнда неге келдің?
Dialogue: 0,0:08:08.12,0:08:11.09,Default,,0,0,0,,Менімен келе аласыз ба? жұмысшы?
Dialogue: 0,0:08:12.12,0:08:14.12,Default,,0,0,0,,Уақытыңыз жоқ деп айтпаңыз.
Dialogue: 0,0:08:14.12,0:08:16.09,Default,,0,0,0,,Уау….
Dialogue: 0,0:08:20.63,0:08:23.60,Default,,0,0,0,,Мен оның Нагоного келеді деп ешқашан ойламадым.
Dialogue: 0,0:08:26.13,0:08:28.60,Default,,0,0,0,,Мен сені Широган деп атағаным жөн сияқты.
Dialogue: 0,0:08:30.14,0:08:32.14,Default,,0,0,0,,Закуса жақсы.
Dialogue: 0,0:08:32.14,0:08:34.61,Default,,0,0,0,,Мұз императрица Харука Сокава.
Dialogue: 0,0:08:36.64,0:08:39.15,Default,,0,0,0,,Мен тыныш жерде сөйлескім келеді.
Dialogue: 0,0:08:39.15,0:08:41.12,Default,,0,0,0,,Менімен бірге жүруіңізді сұрай аламын ба?
Dialogue: 0,0:08:47.16,0:08:49.12,Default,,0,0,0,,Амансың ба? Юю мырза.
Dialogue: 0,0:08:50.16,0:08:52.16,Default,,0,0,0,,А... Урара-сан!
Dialogue: 0,0:08:52.16,0:08:54.16,Default,,0,0,0,,Ю...Юйю-сан? ➡
Dialogue: 0,0:08:54.16,0:08:56.16,Default,,0,0,0,,Қалай... сәлем.
Dialogue: 0,0:08:56.16,0:08:58.17,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:08:58.17,0:09:00.17,Default,,0,0,0,,Ум...ммм.
Dialogue: 0,0:09:00.17,0:09:02.14,Default,,0,0,0,,Ах! Ум...!
Dialogue: 0,0:09:03.17,0:09:05.17,Default,,0,0,0,,Ха~.
Dialogue: 0,0:09:05.17,0:09:08.68,Default,,0,0,0,,Сауда автоматы зәр шығару Жүгері сорпасы ғана болды➡
Dialogue: 0,0:09:08.68,0:09:10.68,Default,,0,0,0,,Сіз қайсысын таңдар едіңіз?
Dialogue: 0,0:09:10.68,0:09:12.68,Default,,0,0,0,,Айтпақшы, мен жүгері сорпасын жақсы көремін!
Dialogue: 0,0:09:12.68,0:09:14.68,Default,,0,0,0,,Жақсы….
Dialogue: 0,0:09:14.68,0:09:17.19,Default,,0,0,0,,Мен сені біраз уақыт жалғыз қалдырғым келмейді, бірақ...
Dialogue: 0,0:09:17.19,0:09:19.19,Default,,0,0,0,,Юю Кондо.
Dialogue: 0,0:09:19.19,0:09:21.69,Default,,0,0,0,,Неліктен біз жеңілдік деп ойлайсыңдар?
Dialogue: 0,0:09:21.69,0:09:25.19,Default,,0,0,0,,《Джо! Тікелей отты доп! 》
Dialogue: 0,0:09:25.19,0:09:27.16,Default,,0,0,0,,Ей! Естисің бе!? Польнареф!?
Dialogue: 0,0:09:28.70,0:09:31.63,Default,,0,0,0,,Бар күшімді салып, жеңілдім.
Dialogue: 0,0:09:31.63,0:09:34.64,Default,,0,0,0,,Не екені маңызды емес➡
Dialogue: 0,0:09:34.64,0:09:37.64,Default,,0,0,0,,Мен сондай әлсізмін.
Dialogue: 0,0:09:37.64,0:09:40.14,Default,,0,0,0,,Иә, нәтиже бәрі.
Dialogue: 0,0:09:40.14,0:09:42.14,Default,,0,0,0,,Сен де, мен де әлсізбіз.
Dialogue: 0,0:09:42.14,0:09:44.15,Default,,0,0,0,,Егер...
Dialogue: 0,0:09:44.15,0:09:47.15,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:09:47.15,0:09:50.15,Default,,0,0,0,,Өз әлсіздігіңізді мойындап, алға ұмтылыңыз.
Dialogue: 0,0:09:50.15,0:09:52.15,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:52.15,0:09:54.16,Default,,0,0,0,,Мен алға жылжамын➡
Dialogue: 0,0:09:54.16,0:09:56.12,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:10:05.67,0:10:08.14,Default,,0,0,0,,Мен де алға ұмтыламын.
Dialogue: 0,0:10:09.17,0:10:11.17,Default,,0,0,0,,Урара мырза. Ха?
Dialogue: 0,0:10:11.17,0:10:14.68,Default,,0,0,0,,Мен қалған жүгеріні банкаға салып, ішкенді ұнатамын!
Dialogue: 0,0:10:14.68,0:10:16.64,Default,,0,0,0,,Хэхе!
Dialogue: 0,0:10:17.68,0:10:20.18,Default,,0,0,0,,Сәлем! Жүгері сорпасы!
Dialogue: 0,0:10:20.18,0:10:22.18,Default,,0,0,0,,Рахмет! Хаа….
Dialogue: 0,0:10:22.18,0:10:25.69,Default,,0,0,0,,А...мм➡
Dialogue: 0,0:10:25.69,0:10:27.69,Default,,0,0,0,,Ал...
Dialogue: 0,0:10:27.69,0:10:29.69,Default,,0,0,0,,Қажет болмаса, алыңыз.
Dialogue: 0,0:10:29.69,0:10:31.66,Default,,0,0,0,,Ах...сәлем!
Dialogue: 0,0:10:39.63,0:10:43.14,Default,,0,0,0,,Нагонода мұндай нысан салынған деп ойламаппын.
Dialogue: 0,0:10:43.14,0:10:45.64,Default,,0,0,0,,Сіз Uniformers мүшесі болуға мүдделісіз бе?
Dialogue: 0,0:10:45.64,0:10:48.64,Default,,0,0,0,,Мен оның жоғалып кеткенін естідім➡
Dialogue: 0,0:10:48.64,0:10:51.65,Default,,0,0,0,,Неліктен бұл ең күшті формалар➡
Dialogue: 0,0:10:51.65,0:10:53.62,Default,,0,0,0,,Сіз дүрбелең тудырып жатырсыз ба?
Dialogue: 0,0:10:54.65,0:10:57.15,Default,,0,0,0,,Бұл дүниеде ешнәрсе тұрақты емес.
Dialogue: 0,0:10:57.15,0:10:59.65,Default,,0,0,0,,Аспанда қалықтаған бұлт сияқты.
Dialogue: 0,0:10:59.65,0:11:03.12,Default,,0,0,0,,Ха! Сатқындық Blackout Мен мұны жиі айтамын.
Dialogue: 0,0:11:06.16,0:11:08.16,Default,,0,0,0,,Негіздеме?
Dialogue: 0,0:11:08.16,0:11:10.16,Default,,0,0,0,,Сіз осылай көресіз бе?
Dialogue: 0,0:11:10.16,0:11:12.67,Default,,0,0,0,,Тағы не бар?
Dialogue: 0,0:11:12.67,0:11:15.67,Default,,0,0,0,,Мен тек өз ішімдегі дүниені тартамын.
Dialogue: 0,0:11:15.67,0:11:18.17,Default,,0,0,0,,Сіздің әлеміңізде не бар?
Dialogue: 0,0:11:18.17,0:11:20.68,Default,,0,0,0,,Не айтқыңыз келетінін білмеймін.
Dialogue: 0,0:11:20.68,0:11:22.68,Default,,0,0,0,,Сіз оны формаға кигізесіз бе?
Dialogue: 0,0:11:22.68,0:11:25.68,Default,,0,0,0,,Мен Миллай-самадан кетемін деп ойлайсың ба?
Dialogue: 0,0:11:25.68,0:11:27.68,Default,,0,0,0,,Мұны сізбен жасамаңыз.
Dialogue: 0,0:11:27.68,0:11:30.65,Default,,0,0,0,,Сіздің әлеміңізді тек сіз ғана тарта аласыз.
Dialogue: 0,0:11:36.62,0:11:40.09,Default,,0,0,0,,Жеңіске жетсем, Таң атадан алыс бол.
Dialogue: 0,0:11:41.13,0:11:43.63,Default,,0,0,0,,Жақсы сурет жүрегіңді елжіретеді.
Dialogue: 0,0:11:43.63,0:11:47.10,Default,,0,0,0,,Сіздің әлеміңіз туралы не айтасыз?
Dialogue: 0,0:11:51.67,0:11:53.68,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:11:53.68,0:11:55.68,Default,,0,0,0,,Кардинал Фанг Форви.
Dialogue: 0,0:11:55.68,0:11:58.18,Default,,0,0,0,,Гравидия Делен.
Dialogue: 0,0:11:58.18,0:12:01.12,Default,,0,0,0,,Менің кезегім, Люсиске➡ мін
Dialogue: 0,0:12:01.12,0:12:05.62,Default,,0,0,0,,Қолыңызға қуыс айлы түн қосып, бұрылысты аяқтау үшін дағдыны пайдаланыңыз.
Dialogue: 0,0:12:05.62,0:12:09.12,Default,,0,0,0,,Менің кезегім! Wells-те жүру дағдысын белсендіріңіз.
Dialogue: 0,0:12:09.12,0:12:11.63,Default,,0,0,0,,Палубаның жоғарғы 7 картасын қараңыз➡
Dialogue: 0,0:12:11.63,0:12:15.13,Default,,0,0,0,,Қолыңызға 1 метеорлық жауын қосыңыз➡
Dialogue: 0,0:12:15.13,0:12:18.13,Default,,0,0,0,,Содан кейін Деленнің шеберлігі бар 1 картаны салыңыз➡
Dialogue: 0,0:12:18.13,0:12:20.64,Default,,0,0,0,,Метеор ағынын реттік аймаққа орнатыңыз➡
Dialogue: 0,0:12:20.64,0:12:22.64,Default,,0,0,0,,Уэллспен шабуыл!
Dialogue: 0,0:12:22.64,0:12:25.14,Default,,0,0,0,,Күзетші. Соңына бұрылу.
Dialogue: 0,0:12:25.14,0:12:27.14,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:12:27.14,0:12:29.14,Default,,0,0,0,,Кубисияға бару➡
Dialogue: 0,0:12:29.14,0:12:32.65,Default,,0,0,0,,Тапсырыс аймағына қуыс айлы түнді орнатыңыз және бір картаны салыңыз.
Dialogue: 0,0:12:32.65,0:12:36.12,Default,,0,0,0,,Дүние қара рыцарьға айналады.
Dialogue: 0,0:12:39.15,0:12:41.16,Default,,0,0,0,,Кубисиядағы шабуыл.
Dialogue: 0,0:12:41.16,0:12:44.16,Default,,0,0,0,,Күзетші жоқ. Соңына бұрылу.
Dialogue: 0,0:12:44.16,0:12:47.16,Default,,0,0,0,,Мен Миллай-самаға ешқашан опасыздық жасамаймын➡
Dialogue: 0,0:12:47.16,0:12:49.16,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:12:49.16,0:12:52.67,Default,,0,0,0,,Тосқауылға міну. Шеберлікпен 1 картаны салыңыз➡
Dialogue: 0,0:12:52.67,0:12:54.67,Default,,0,0,0,,Қуат плюс 5000.
Dialogue: 0,0:12:54.67,0:12:56.67,Default,,0,0,0,,Тозақтың құлау қаупін орнатыңыз➡
Dialogue: 0,0:12:56.67,0:12:58.67,Default,,0,0,0,,Баллингермен шабуыл!
Dialogue: 0,0:12:58.67,0:13:00.61,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:13:00.61,0:13:03.11,Default,,0,0,0,,Бұрылыстың соңы. Менің кезегім.
Dialogue: 0,0:13:03.11,0:13:06.61,Default,,0,0,0,,Кардинал Доминус Орфист Региспен жүріңіз➡
Dialogue: 0,0:13:06.61,0:13:10.12,Default,,0,0,0,,Ай сәулесін тоздыратын тамшыны шеберлікпен орнатыңыз➡
Dialogue: 0,0:13:10.12,0:13:13.12,Default,,0,0,0,,Көлеңке армиясын да атайды.
Dialogue: 0,0:13:13.12,0:13:17.59,Default,,0,0,0,,Дүние одан да қараңғы, Түпсіз қараңғы түн.
Dialogue: 0,0:13:21.63,0:13:25.13,Default,,0,0,0,,《Әлемдік карталар жиналатын стандартты жекпе-жек.
Dialogue: 0,0:13:25.13,0:13:27.64,Default,,0,0,0,,Бірақ оның артында Маскус тұр. 》
Dialogue: 0,0:13:27.64,0:13:31.14,Default,,0,0,0,,Айды қуыс түнді орнатыңыз және 1 картаны салыңыз➡
Dialogue: 0,0:13:31.14,0:13:33.64,Default,,0,0,0,,Orphist Regis көмегімен шабуыл➡
Dialogue: 0,0:13:33.64,0:13:37.65,Default,,0,0,0,,Көлеңке армиясын шеберлікпен шақырыңыз және +5000 қуат алыңыз.
Dialogue: 0,0:13:37.65,0:13:39.65,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:13:39.65,0:13:41.65,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:13:41.65,0:13:44.15,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:13:44.15,0:13:46.65,Default,,0,0,0,,Триггерді тарту 1 картаны тарту➡
Dialogue: 0,0:13:46.65,0:13:49.12,Default,,0,0,0,,Көлеңкелі армияның қуаты плюс 10000.
Dialogue: 0,0:13:50.16,0:13:53.16,Default,,0,0,0,,Көлеңке армиясымен шабуыл! күзетші.
Dialogue: 0,0:13:53.16,0:13:55.66,Default,,0,0,0,,Көлеңкелі әскермен шабуыл.
Dialogue: 0,0:13:55.66,0:13:58.67,Default,,0,0,0,,Күзетші жоқ. Соңына бұрылу.
Dialogue: 0,0:13:58.67,0:14:01.10,Default,,0,0,0,,《Сіз оны әлі орнаттыңыз ба?➡
Dialogue: 0,0:14:01.10,0:14:05.11,Default,,0,0,0,,Маскусты орнату үшін қолыңызды сақтаңыз ба?
Dialogue: 0,0:14:05.11,0:14:07.61,Default,,0,0,0,,Е! Сосын оған дейін! 》
Dialogue: 0,0:14:07.61,0:14:09.61,Default,,0,0,0,,Менің кезегім! ➡
Dialogue: 0,0:14:09.61,0:14:12.11,Default,,0,0,0,,Gravidia Nördlinger➡ көлігімен жүру
Dialogue: 0,0:14:12.11,0:14:15.62,Default,,0,0,0,,Дағдыны қолдана отырып, палубадан 2 Метеорлық жауын картасын орнатыңыз➡
Dialogue: 0,0:14:15.62,0:14:17.62,Default,,0,0,0,,Осы дағдымен 2 карта салыңыз➡
Dialogue: 0,0:14:17.62,0:14:22.12,Default,,0,0,0,,Тозақ қаупін орнатыңыз және 2 Stannels➡ шақырыңыз
Dialogue: 0,0:14:22.12,0:14:25.59,Default,,0,0,0,,Нердлингермен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:14:26.63,0:14:28.63,Default,,0,0,0,,Мен сені қирау жаңбырымен басып тастаймын➡
Dialogue: 0,0:14:28.63,0:14:30.63,Default,,0,0,0,,Дағды іске қосылды!
Dialogue: 0,0:14:30.63,0:14:34.64,Default,,0,0,0,,Тапсырыс аймағынан 1 метеорлық жауын және 2 тозақ қаупі➡
Dialogue: 0,0:14:34.64,0:14:38.64,Default,,0,0,0,,Тозақ қаупі екі метеорит картасы ретінде қарастырылады, сондықтан➡
Dialogue: 0,0:14:38.64,0:14:41.64,Default,,0,0,0,,Нердлингердің шеберлігі 5 карта ретінде есептеледі➡
Dialogue: 0,0:14:41.64,0:14:45.15,Default,,0,0,0,,Демек, Нердлингердің қуаты +15000➡
Dialogue: 0,0:14:45.15,0:14:47.15,Default,,0,0,0,,Сыни плюс 1.
Dialogue: 0,0:14:47.15,0:14:49.65,Default,,0,0,0,,Сонымен қатар, триггер әсері екі есе артады!
Dialogue: 0,0:14:49.65,0:14:52.15,Default,,0,0,0,,Тамшыға салынған метеорит картасының шеберлігімен➡
Dialogue: 0,0:14:52.15,0:14:54.16,Default,,0,0,0,,Көлеңке армиясын шегіндіріңіз➡
Dialogue: 0,0:14:54.16,0:14:56.12,Default,,0,0,0,,Жоғал!
Dialogue: 0,0:15:00.13,0:15:02.10,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:15:11.61,0:15:13.57,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:15:14.61,0:15:18.11,Default,,0,0,0,,Қос жетек! Бірінші тексеру➡
Dialogue: 0,0:15:18.11,0:15:21.08,Default,,0,0,0,,Триггердің екінші тексеруі жоқ….
Dialogue: 0,0:15:23.12,0:15:25.62,Default,,0,0,0,,Оны алыңыз! Критикалық триггер➡
Dialogue: 0,0:15:25.62,0:15:29.62,Default,,0,0,0,,Триггер эффектісі екі есе артты және Нелтлингердің критикалық +2➡
Dialogue: 0,0:15:29.62,0:15:32.63,Default,,0,0,0,,Тұрақты қуат +10000 әрқайсысы.
Dialogue: 0,0:15:32.63,0:15:35.60,Default,,0,0,0,,Бұл шабуыл...4 зиян.
Dialogue: 0,0:15:38.13,0:15:40.13,Default,,0,0,0,,Зақымдануды тексеру➡
Dialogue: 0,0:15:40.13,0:15:42.14,Default,,0,0,0,,1-тармақ➡
Dialogue: 0,0:15:42.14,0:15:44.64,Default,,0,0,0,,Екінші тармақ➡
Dialogue: 0,0:15:44.64,0:15:47.64,Default,,0,0,0,,Үшінші тармақ➡
Dialogue: 0,0:15:47.64,0:15:50.14,Default,,0,0,0,,4-тармақ➡
Dialogue: 0,0:15:50.14,0:15:52.11,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:15:56.15,0:15:58.15,Default,,0,0,0,,Кук... Дәл солай ➡
Dialogue: 0,0:15:58.15,0:16:00.12,Default,,0,0,0,,Қараңғыда жоғалып кет!
Dialogue: 0,0:16:00.12,0:16:02.09,Default,,0,0,0,,Авангардқа соққымен шабуыл жасаңыз!
Dialogue: 0,0:16:02.09,0:16:04.09,Default,,0,0,0,,Күзетші.
Dialogue: 0,0:16:04.09,0:16:07.60,Default,,0,0,0,,Әлі жоқ! Басқа соққымен шабуыл жасаңыз!
Dialogue: 0,0:16:07.60,0:16:10.10,Default,,0,0,0,,Күзетші.
Dialogue: 0,0:16:10.10,0:16:12.07,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:16:13.60,0:16:15.60,Default,,0,0,0,,《5 ұпайға дейін ұсталды➡
Dialogue: 0,0:16:15.60,0:16:18.61,Default,,0,0,0,,Осыған шыдасаң, жеңе аласың! Бірақ... 》
Dialogue: 0,0:16:18.61,0:16:20.61,Default,,0,0,0,,Сіз маскадан қорқасыз ба?
Dialogue: 0,0:16:20.61,0:16:22.58,Default,,0,0,0,,Ах...!
Dialogue: 0,0:16:27.11,0:16:29.12,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:29.12,0:16:31.12,Default,,0,0,0,,Менің кезегім! ➡
Dialogue: 0,0:16:31.12,0:16:33.12,Default,,0,0,0,,Операцияға қоңырау шалыңыз➡
Dialogue: 0,0:16:33.12,0:16:35.12,Default,,0,0,0,,Шеберлігіне қарай➡
Dialogue: 0,0:16:35.12,0:16:38.13,Default,,0,0,0,,Beyond Eternity қолданбасын палубадан түсіру аймағына қойыңыз.
Dialogue: 0,0:16:38.13,0:16:41.63,Default,,0,0,0,,Рюукидің құлаған баласы Сайба Кайтол➡
Dialogue: 0,0:16:41.63,0:16:43.60,Default,,0,0,0,,Қоңырау шалыңыз!
Dialogue: 0,0:16:44.63,0:16:47.64,Default,,0,0,0,,Дағдыны белсендіру Ryuki маркерін➡ қойыңыз
Dialogue: 0,0:16:47.64,0:16:50.64,Default,,0,0,0,,Қолыңызға палубадан Hydragrum маскасын қосыңыз➡
Dialogue: 0,0:16:50.64,0:16:52.64,Default,,0,0,0,,Қолдану.
Dialogue: 0,0:16:52.64,0:16:57.14,Default,,0,0,0,,Қолыңызға палубаның жоғарғы бес картасынан Orphist Mascus қосыңыз.
Dialogue: 0,0:16:57.14,0:16:59.15,Default,,0,0,0,,Кел!
Dialogue: 0,0:16:59.15,0:17:03.15,Default,,0,0,0,,Мен себеп пен салдарды кесіп тастаймын және манифест ➡
Dialogue: 0,0:17:03.15,0:17:07.66,Default,,0,0,0,,Кардинал Морс Орфист Маскусқа ➡
Dialogue: 0,0:17:07.66,0:17:09.62,Default,,0,0,0,,Persona Ride!
Dialogue: 0,0:17:10.66,0:17:12.66,Default,,0,0,0,,Бұл өтірік болғандықтан ба?>
Dialogue: 0,0:17:32.18,0:17:34.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:40.19,0:17:42.16,Default,,0,0,0,,Бұл Маскус….
Dialogue: 0,0:17:43.19,0:17:45.69,Default,,0,0,0,,Опарт Грюндерге қоңырау шалыңыз.
Dialogue: 0,0:17:45.69,0:17:48.70,Default,,0,0,0,,Orphist Mascus дағдысын белсендіру➡
Dialogue: 0,0:17:48.70,0:17:51.70,Default,,0,0,0,,Soul's Orphist Regis-ті алып тастау арқылы➡
Dialogue: 0,0:17:51.70,0:17:55.17,Default,,0,0,0,,Тапсырыс аймағында Drop Beyond Eternity параметрін орнатыңыз.
Dialogue: 0,0:17:56.20,0:17:58.21,Default,,0,0,0,,Операцияны күшейту➡
Dialogue: 0,0:17:58.21,0:18:00.64,Default,,0,0,0,,Грюндермен шабуыл!
Dialogue: 0,0:18:00.64,0:18:03.64,Default,,0,0,0,,Керемет... күзетші кедергі!
Dialogue: 0,0:18:03.64,0:18:06.15,Default,,0,0,0,,Op Art Boost➡
Dialogue: 0,0:18:06.15,0:18:08.65,Default,,0,0,0,,Сайба Кайтолмен шабуыл!
Dialogue: 0,0:18:08.65,0:18:11.65,Default,,0,0,0,,Мен сені қорғаймын...Күзетші!
Dialogue: 0,0:18:11.65,0:18:13.65,Default,,0,0,0,,Және тоқтатыңыз!
Dialogue: 0,0:18:13.65,0:18:16.66,Default,,0,0,0,,Қорқыныштан дірілдеген қалқанда➡
Dialogue: 0,0:18:16.66,0:18:19.13,Default,,0,0,0,,Ештеңені қорғауға болмайды.
Dialogue: 0,0:18:22.16,0:18:25.17,Default,,0,0,0,,Оны таза түрде тастаңыз➡
Dialogue: 0,0:18:25.17,0:18:29.14,Default,,0,0,0,,Әлсіз және тұрақсыз әлем.
Dialogue: 0,0:18:30.17,0:18:33.67,Default,,0,0,0,,Орфист маскалары арқылы шабуыл дағдыларын белсендіру➡
Dialogue: 0,0:18:33.67,0:18:38.18,Default,,0,0,0,,Дүниежүзілік карталардың қажетті санын тапсырыс аймағынан тастау жолағына қою арқылы➡
Dialogue: 0,0:18:38.18,0:18:41.65,Default,,0,0,0,,Карталардың әрбір саны үшін көлеңкелі әскерді шақырыңыз.
Dialogue: 0,0:18:43.18,0:18:46.69,Default,,0,0,0,,Мен тамшыға салған карталарым ➡
Dialogue: 0,0:18:46.69,0:18:48.66,Default,,0,0,0,,2 дана.
Dialogue: 0,0:18:49.69,0:18:52.19,Default,,0,0,0,,Сондықтан, көлеңкелі армияның 2 картасын шақырыңыз➡
Dialogue: 0,0:18:52.19,0:18:55.20,Default,,0,0,0,,Plus Orphist Masques Drive Plus 1➡
Dialogue: 0,0:18:55.20,0:18:57.70,Default,,0,0,0,,Тамшыға орналастырылған екі Оп-арт шеберлігімен➡
Dialogue: 0,0:18:57.70,0:19:00.67,Default,,0,0,0,,Көлеңке армиясының екі картасын шақырыңыз.
Dialogue: 0,0:19:02.14,0:19:04.61,Default,,0,0,0,,Мәңгіліктен асқан шеберлік.
Dialogue: 0,0:19:06.64,0:19:10.14,Default,,0,0,0,,Барлық көлеңкелі армияның қуаты +5000.
Dialogue: 0,0:19:10.14,0:19:12.65,Default,,0,0,0,,Бірден төрт дене.
Dialogue: 0,0:19:12.65,0:19:14.65,Default,,0,0,0,,Қазір….
Dialogue: 0,0:19:14.65,0:19:18.15,Default,,0,0,0,,Orphist Mascus қалай шабуылдауы керек?
Dialogue: 0,0:19:18.15,0:19:20.12,Default,,0,0,0,,Га... Күзетші!
Dialogue: 0,0:19:22.16,0:19:24.16,Default,,0,0,0,,Үш жетек➡
Dialogue: 0,0:19:24.16,0:19:27.16,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:19:27.16,0:19:29.66,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:19:29.66,0:19:31.67,Default,,0,0,0,,Үшінші тексеру….
Dialogue: 0,0:19:31.67,0:19:33.67,Default,,0,0,0,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:19:33.67,0:19:35.67,Default,,0,0,0,,Критикалық триггер! ➡
Dialogue: 0,0:19:35.67,0:19:39.67,Default,,0,0,0,,Көлеңкелі армияның күші +10000 Критикалық +1.
Dialogue: 0,0:19:39.67,0:19:41.68,Default,,0,0,0,,Міне!
Dialogue: 0,0:19:41.68,0:19:44.68,Default,,0,0,0,,Қорқыныштың соңына дейін қайда бару керек➡
Dialogue: 0,0:19:44.68,0:19:48.15,Default,,0,0,0,,Менің ойымша, қызыл қараңғылықтағы Хякки Яюки.
Dialogue: 0,0:19:49.18,0:19:51.15,Default,,0,0,0,,Көлеңке армиясымен шабуыл!
Dialogue: 0,0:19:53.69,0:19:55.66,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:19:56.69,0:19:59.16,Default,,0,0,0,,Көлеңке армиясымен шабуыл!
Dialogue: 0,0:20:00.63,0:20:03.13,Default,,0,0,0,,Күзетші жоқ…көкек➡
Dialogue: 0,0:20:03.13,0:20:06.63,Default,,0,0,0,,Зақымдануды тексеру 1-тармақ➡
Dialogue: 0,0:20:06.63,0:20:08.64,Default,,0,0,0,,Триггер жоқ➡
Dialogue: 0,0:20:08.64,0:20:10.60,Default,,0,0,0,,Екінші тармақ.
Dialogue: 0,0:20:17.14,0:20:19.15,Default,,0,0,0,,Кух….
Dialogue: 0,0:20:19.15,0:20:21.12,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:20:26.15,0:20:28.16,Default,,0,0,0,,Кух….
Dialogue: 0,0:20:28.16,0:20:31.66,Default,,0,0,0,,《Иә, мен әлсізмін➡
Dialogue: 0,0:20:31.66,0:20:35.66,Default,,0,0,0,,Мен сенің жаныңда болсамда, мен ешбір күшке қарсы тұра алмаймын...
Dialogue: 0,0:20:35.66,0:20:37.63,Default,,0,0,0,,Осы жылдамдықпен... 》
Dialogue: 0,0:20:38.67,0:20:40.67,Default,,0,0,0,,Сіз мойындаған сияқтысыз➡
Dialogue: 0,0:20:40.67,0:20:43.14,Default,,0,0,0,,Сіздің әлеміңіз.
Dialogue: 0,0:20:45.67,0:20:48.18,Default,,0,0,0,,Өзіңіздің әлсіз әлеміңізде болыңыз➡
Dialogue: 0,0:20:48.18,0:20:50.68,Default,,0,0,0,,Мен қалтырап, оның ыдырауын күтуім керек пе➡
Dialogue: 0,0:20:50.68,0:20:53.18,Default,,0,0,0,,Сіз жаңа әлемге ие боласыз ба?
Dialogue: 0,0:20:53.18,0:20:55.65,Default,,0,0,0,,Қалай ойлайсыз, униформашылар өзгере алады ма?
Dialogue: 0,0:20:56.68,0:20:58.65,Default,,0,0,0,,Бұл сізге байланысты.
Dialogue: 0,0:21:08.13,0:21:10.13,Default,,0,0,0,,Мұз жарылды➡
Dialogue: 0,0:21:10.13,0:21:13.10,Default,,0,0,0,,Орман... қозғалады ма?
Dialogue: 0,0:21:29.15,0:21:33.12,Default,,0,0,0,,Ха~ Осындай уақытта не істеп жүрсің?
Dialogue: 0,0:21:38.16,0:21:40.63,Default,,0,0,0,,Амансың ба? Юйю.
Dialogue: 0,0:21:41.66,0:21:43.63,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:21:45.17,0:21:48.17,Default,,0,0,0,,Ах! жәндік….
Dialogue: 0,0:21:48.17,0:21:50.67,Default,,0,0,0,,Қайдасың?!
Dialogue: 0,0:21:50.67,0:21:53.17,Default,,0,0,0,,А...ун? ➡
Dialogue: 0,0:21:53.17,0:21:55.68,Default,,0,0,0,,Ах... сен! ➡
Dialogue: 0,0:21:55.68,0:21:58.65,Default,,0,0,0,,Халона Уокер? иә?
