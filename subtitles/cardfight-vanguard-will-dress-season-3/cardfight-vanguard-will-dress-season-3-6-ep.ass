Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.87,0:00:10.87,Default,,0,0,0,,((Барлығы біркелкі болады➡
Dialogue: 0,0:00:10.87,0:00:14.38,Default,,0,0,0,,Мен болашақты жек көремін, мені үйретіңізші! ))
Dialogue: 0,0:01:59.85,0:02:01.82,Default,,0,0,0,,((Солреалонмен шабуыл➡
Dialogue: 0,0:02:01.82,0:02:04.25,Default,,0,0,0,,Палубаның жоғарғы екі картасынан қарсы жарылыс➡
Dialogue: 0,0:02:04.25,0:02:06.79,Default,,0,0,0,,Бір бірлікке қоңырау шалыңыз.
Dialogue: 0,0:02:06.79,0:02:10.76,Default,,0,0,0,,Тиімді шабуыл және маскалар палубасы.
Dialogue: 0,0:02:10.76,0:02:13.76,Default,,0,0,0,,Біркелкілер тіпті идеалды.
Dialogue: 0,0:02:13.76,0:02:16.26,Default,,0,0,0,,Күшті...бірақ.
Dialogue: 0,0:02:16.26,0:02:18.23,Default,,0,0,0,,Бұл бір нәрсе болуы керек...
Dialogue: 0,0:02:20.27,0:02:23.27,Default,,0,0,0,,Эрм, Тина…➡
Dialogue: 0,0:02:23.27,0:02:27.78,Default,,0,0,0,,Оқу мүмкін емес! Ашуланба...Міне, мен тез кетемін.
Dialogue: 0,0:02:29.28,0:02:31.25,Default,,0,0,0,,О! Лейка. А….
Dialogue: 0,0:02:31.25,0:02:33.75,Default,,0,0,0,,Иә! Данжи мырза?
Dialogue: 0,0:02:33.75,0:02:36.25,Default,,0,0,0,,Не болды? Кенеттен...
Dialogue: 0,0:02:36.25,0:02:38.25,Default,,0,0,0,,Дәлірек айтқанда, ол бала ше?
Dialogue: 0,0:02:38.25,0:02:40.29,Default,,0,0,0,,Ым? ➡
Dialogue: 0,0:02:40.29,0:02:43.79,Default,,0,0,0,,Егер сіз мені танымасаңыз, сіз жеткілікті оқымайсыз, Мистер Гласс.
Dialogue: 0,0:02:43.79,0:02:48.26,Default,,0,0,0,,Хэхехе...Жапонияның ең сүйкімді және ең күшті Авангард жауынгері➡
Dialogue: 0,0:02:48.26,0:02:50.73,Default,,0,0,0,,Шинобу Каджита менмін!
Dialogue: 0,0:02:53.30,0:02:55.77,Default,,0,0,0,,Мен тәжірибе жасағым келеді. Мені елеме!
Dialogue: 0,0:02:55.77,0:02:58.77,Default,,0,0,0,,Мичирудың маған бірдеңесі қалғанын естідім.
Dialogue: 0,0:02:58.77,0:03:00.74,Default,,0,0,0,,Ах...!
Dialogue: 0,0:03:00.74,0:03:02.78,Default,,0,0,0,,Мичирудан? Сіз не сақтадыңыз?
Dialogue: 0,0:03:02.78,0:03:05.75,Default,,0,0,0,,Айт! Мичиру не деді?
Dialogue: 0,0:03:05.75,0:03:07.75,Default,,0,0,0,,Жібер! Бұл ауырады!
Dialogue: 0,0:03:07.75,0:03:09.75,Default,,0,0,0,,Міне.
Dialogue: 0,0:03:09.75,0:03:11.79,Default,,0,0,0,,Бұл... Біртұтас киімдер...
Dialogue: 0,0:03:11.79,0:03:16.29,Default,,0,0,0,,Мичиру га са~ Біркелкілер әлемді бояғалы жатқанда➡
Dialogue: 0,0:03:16.29,0:03:18.76,Default,,0,0,0,,Менен асып түсетін адамға беріңіз➡
Dialogue: 0,0:03:18.76,0:03:21.76,Default,,0,0,0,,Мен шынымен түсінбеймін, сондықтан Данжиден сұрадым➡
Dialogue: 0,0:03:21.76,0:03:24.33,Default,,0,0,0,,Мені осында әкелді.
Dialogue: 0,0:03:24.33,0:03:27.84,Default,,0,0,0,,Лайка...сенде бәрі жақсы, солай ма?
Dialogue: 0,0:03:29.60,0:03:31.61,Default,,0,0,0,,)
Dialogue: 0,0:03:34.74,0:03:38.28,Default,,0,0,0,,Біз міндетті түрде нәтиже шығарамыз.
Dialogue: 0,0:03:38.28,0:03:40.25,Default,,0,0,0,,О, қолыңнан келгеннің бәрін жаса.
Dialogue: 0,0:03:40.25,0:03:43.25,Default,,0,0,0,,Шинобу-кун... болды. Un?
Dialogue: 0,0:03:43.25,0:03:45.25,Default,,0,0,0,,Оны жеткізгеніңіз үшін рахмет.
Dialogue: 0,0:03:45.25,0:03:47.76,Default,,0,0,0,,Ал, қолыңнан келгеннің бәрін жаса.
Dialogue: 0,0:03:47.76,0:03:49.73,Default,,0,0,0,,...
Dialogue: 0,0:03:52.26,0:03:55.26,Default,,0,0,0,,Айтпақшы, не істеп жатырсың?
Dialogue: 0,0:03:55.26,0:03:57.27,Default,,0,0,0,,Мен көмектесе алмаймын➡
Dialogue: 0,0:03:57.27,0:04:00.34,Default,,0,0,0,,Мичиру сондай-ақ, сіз қандай болсаңыз, солай қала аласыз деп айтты.
Dialogue: 0,0:04:00.34,0:04:02.30,Default,,0,0,0,,Мен көремін. ))
Dialogue: 0,0:04:11.75,0:04:13.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:17.25,0:04:19.76,Default,,0,0,0,,Мичиру...сан?
Dialogue: 0,0:04:19.76,0:04:22.26,Default,,0,0,0,,Жоқ... бұл деректер ме?
Dialogue: 0,0:04:22.26,0:04:24.73,Default,,0,0,0,,Бірақ бұл оның күресе алатынын білдіре ме?
Dialogue: 0,0:04:25.79,0:04:30.77,Default,,0,0,0,,Мичиру-сан, сенің болашағың қаншалықты биік және тік болса да➡
Dialogue: 0,0:04:30.77,0:04:33.24,Default,,0,0,0,,Мен одан да асып түсемін!
Dialogue: 0,0:04:35.74,0:04:37.74,Default,,0,0,0,,Лейка мырза...
Dialogue: 0,0:04:37.74,0:04:41.24,Default,,0,0,0,,Аа, ол жігіттер қазірдің өзінде қозғалыста➡
Dialogue: 0,0:04:41.24,0:04:43.28,Default,,0,0,0,,Болашақты өзгерту үшін.
Dialogue: 0,0:04:43.28,0:04:45.25,Default,,0,0,0,,Мына жігіттер?
Dialogue: 0,0:04:47.75,0:04:51.25,Default,,0,0,0,,Урара-чан! О иә.
Dialogue: 0,0:04:51.25,0:04:53.76,Default,,0,0,0,,Вагон бастығы!
Dialogue: 0,0:04:53.76,0:04:55.76,Default,,0,0,0,,Нагоноға қош келдіңіз!
Dialogue: 0,0:04:57.76,0:04:59.80,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:59.80,0:05:02.76,Default,,0,0,0,,Иә! Қош келдіңіз. ұзақ уақытта көрмеу.
Dialogue: 0,0:05:02.76,0:05:05.30,Default,,0,0,0,,Барлығын мазалағаным үшін кешіріңіз.
Dialogue: 0,0:05:05.30,0:05:08.77,Default,,0,0,0,,Бұл дұрыс. Жапонияның ең жақсы жауынгерлерін жинаңыз➡
Dialogue: 0,0:05:08.77,0:05:11.24,Default,,0,0,0,,Спарринг серіктес болайық.
Dialogue: 0,0:05:11.24,0:05:13.74,Default,,0,0,0,,Турнирден кейін менде бос уақыт болды.
Dialogue: 0,0:05:13.74,0:05:16.75,Default,,0,0,0,,Бұл да жақсы жаттығу!
Dialogue: 0,0:05:16.75,0:05:18.78,Default,,0,0,0,,Қанағаттанасыз ба?
Dialogue: 0,0:05:18.78,0:05:20.75,Default,,0,0,0,,Мен өте ризамын!
Dialogue: 0,0:05:20.75,0:05:22.75,Default,,0,0,0,,Ол маған өз орнын да берді.
Dialogue: 0,0:05:22.75,0:05:24.75,Default,,0,0,0,,Өте жақсы➡
Dialogue: 0,0:05:24.75,0:05:27.26,Default,,0,0,0,,Оған біраз уақыт сіз жауапты боласыз➡
Dialogue: 0,0:05:27.26,0:05:30.79,Default,,0,0,0,,Осы Seizo анкерлік болт жапсырмасын жағыңыз➡
Dialogue: 0,0:05:30.79,0:05:33.76,Default,,0,0,0,,Жекпе-жек үшін жарнамалық шығындарды төлеймін бе?
Dialogue: 0,0:05:33.76,0:05:35.76,Default,,0,0,0,,Сіз сенімдісіз бе? Мен қуаныштымын!
Dialogue: 0,0:05:35.76,0:05:38.27,Default,,0,0,0,,Сонымен неден бастаймыз?
Dialogue: 0,0:05:38.27,0:05:40.27,Default,,0,0,0,,Дұрыс➡
Dialogue: 0,0:05:40.27,0:05:42.77,Default,,0,0,0,,Әзірше мен әрқайсыңыздан күресуді сұраймын.
Dialogue: 0,0:05:42.77,0:05:44.74,Default,,0,0,0,,Бұл кенеттен.
Dialogue: 0,0:05:44.74,0:05:47.24,Default,,0,0,0,,Бұл сумода соғу тәжірибесі➡
Dialogue: 0,0:05:47.24,0:05:49.24,Default,,0,0,0,,Жақсы! а….
Dialogue: 0,0:05:49.24,0:05:51.75,Default,,0,0,0,,Ал, енді меннен бастайық.
Dialogue: 0,0:05:51.75,0:05:55.25,Default,,0,0,0,,Бұлшықет төсенішін жоғарылатыңыз!
Dialogue: 0,0:05:58.75,0:06:02.76,Default,,0,0,0,,Бұл Daybreak-тің негізгі базасы!
Dialogue: 0,0:06:02.76,0:06:04.76,Default,,0,0,0,,Уау.
Dialogue: 0,0:06:04.76,0:06:06.76,Default,,0,0,0,,Мираи-сан!
Dialogue: 0,0:06:06.76,0:06:09.26,Default,,0,0,0,,Сәлеметсіз бе! Сәлем.
Dialogue: 0,0:06:09.26,0:06:12.27,Default,,0,0,0,,Ах! Мүмкін Урара Ханеяма?
Dialogue: 0,0:06:12.27,0:06:14.80,Default,,0,0,0,,Е...білесің бе?
Dialogue: 0,0:06:14.80,0:06:17.24,Default,,0,0,0,,Ол Делюксте Мирей-саннан күшті болды!
Dialogue: 0,0:06:17.24,0:06:20.28,Default,,0,0,0,,Жоқ! Мен бір рет жеңдім!
Dialogue: 0,0:06:20.28,0:06:24.28,Default,,0,0,0,,Хехехе...Урара-чан ол кезде мықты болатын.
Dialogue: 0,0:06:24.28,0:06:26.75,Default,,0,0,0,,Ми...Мирей-сан?
Dialogue: 0,0:06:26.75,0:06:29.38,Default,,0,0,0,,Хэхехе...
Dialogue: 0,0:06:29.38,0:06:32.35,Default,,0,0,0,,)
Dialogue: 0,0:06:33.76,0:06:35.79,Default,,0,0,0,,Намокарга мініңіз! ➡
Dialogue: 0,0:06:35.79,0:06:40.76,Default,,0,0,0,,Шеберлікпен...ммм, палубадан Сваямбхуды қолыңызға қосыңыз!
Dialogue: 0,0:06:40.76,0:06:42.76,Default,,0,0,0,,Көңілді сияқты.
Dialogue: 0,0:06:42.76,0:06:44.77,Default,,0,0,0,,Сол балалар➡
Dialogue: 0,0:06:44.77,0:06:46.77,Default,,0,0,0,,Мен униформашылар емес, төбелескім келеді➡
Dialogue: 0,0:06:46.77,0:06:49.24,Default,,0,0,0,,Мен осындамын. жұмысшы?
Dialogue: 0,0:06:49.24,0:06:51.24,Default,,0,0,0,,Тек сол балалар емес➡
Dialogue: 0,0:06:51.24,0:06:53.31,Default,,0,0,0,,Жақында әртүрлі жерлерде➡
Dialogue: 0,0:06:53.31,0:06:55.28,Default,,0,0,0,,Uniformers әдістерін ұнатпайтын адамдар➡
Dialogue: 0,0:06:55.28,0:06:57.31,Default,,0,0,0,,Ол өсуде.
Dialogue: 0,0:06:57.31,0:06:59.78,Default,,0,0,0,,Тіпті ондай адамдар да жекпе-жектен ләззат алатын орын ретінде➡
Dialogue: 0,0:06:59.78,0:07:01.75,Default,,0,0,0,,Бұл біз қамтамасыз етеміз➡
Dialogue: 0,0:07:01.75,0:07:05.25,Default,,0,0,0,,Данжи...Мен оны ағамнан естідім➡
Dialogue: 0,0:07:05.25,0:07:08.26,Default,,0,0,0,,Сіз Uniformers-те болдыңыз, солай ма?
Dialogue: 0,0:07:08.26,0:07:11.76,Default,,0,0,0,,Сәлем мен достар тауып, күшейдім➡
Dialogue: 0,0:07:11.76,0:07:15.26,Default,,0,0,0,,Бірақ мен картаның енді дыбыс шығармайтынын байқадым➡
Dialogue: 0,0:07:15.26,0:07:18.27,Default,,0,0,0,,Одан кейін бір-ақ рет естідім➡
Dialogue: 0,0:07:18.27,0:07:20.80,Default,,0,0,0,,Мен қайта ести алмаймын.
Dialogue: 0,0:07:20.80,0:07:23.74,Default,,0,0,0,,Әртүрлі жағдайлардың кесірінен мен достарыммен ұрысып, ажырасып кеттім➡
Dialogue: 0,0:07:23.74,0:07:25.77,Default,,0,0,0,,Бар болғаны...
Dialogue: 0,0:07:25.77,0:07:28.74,Default,,0,0,0,,Мм...Мен жарасқым келеді.
Dialogue: 0,0:07:28.74,0:07:32.25,Default,,0,0,0,,Мүмкін сен мені жек көретін шығарсың.
Dialogue: 0,0:07:32.25,0:07:34.25,Default,,0,0,0,,Есту қорқынышты.
Dialogue: 0,0:07:35.35,0:07:37.75,Default,,0,0,0,,Урара-сан!
Dialogue: 0,0:07:37.75,0:07:40.32,Default,,0,0,0,,Күресейік!
Dialogue: 0,0:07:40.32,0:07:43.26,Default,,0,0,0,,E? Урара-чан да төбелескісі келеді!
Dialogue: 0,0:07:43.26,0:07:45.76,Default,,0,0,0,,Ех! (Бала) Ия! Алақай!
Dialogue: 0,0:07:45.76,0:07:47.76,Default,,0,0,0,,Урарамен шайқас!
Dialogue: 0,0:07:47.76,0:07:49.76,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:07:49.76,0:07:52.73,Default,,0,0,0,,Ух...сәлем.
Dialogue: 0,0:07:55.80,0:07:57.77,Default,,0,0,0,,Бұл қай жерде? Маған еріңіз.
Dialogue: 0,0:08:02.28,0:08:04.28,Default,,0,0,0,,Бұл менің таныс жерім➡
Dialogue: 0,0:08:04.28,0:08:06.25,Default,,0,0,0,,Кешіріңіз, бірақ менімен біраз уақыт араласыңыз.
Dialogue: 0,0:08:10.75,0:08:12.72,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:08:15.76,0:08:17.76,Default,,0,0,0,,Қараңдар! Un?
Dialogue: 0,0:08:17.76,0:08:19.76,Default,,0,0,0,,Тазалау.
Dialogue: 0,0:08:25.30,0:08:27.34,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:27.34,0:08:29.80,Default,,0,0,0,,((Осылай, Данжидің көмегімен➡
Dialogue: 0,0:08:29.80,0:08:32.31,Default,,0,0,0,,Мен әртүрлі жерлерді тазалауға бардым. ))
Dialogue: 0,0:08:34.78,0:08:36.75,Default,,0,0,0,,Данжи-сан!
Dialogue: 0,0:08:36.75,0:08:38.75,Default,,0,0,0,,Ол аяқталды ма?
Dialogue: 0,0:08:40.75,0:08:42.75,Default,,0,0,0,,Қайда кетті?
Dialogue: 0,0:08:49.76,0:08:51.76,Default,,0,0,0,,Дэнж мырза.
Dialogue: 0,0:08:51.76,0:08:54.23,Default,,0,0,0,,Әке мен ана.
Dialogue: 0,0:08:56.26,0:08:58.77,Default,,0,0,0,,Екеуі Якубукуро үйінен шықты➡
Dialogue: 0,0:08:58.77,0:09:01.24,Default,,0,0,0,,Мен осында тұрдым.
Dialogue: 0,0:09:01.24,0:09:04.77,Default,,0,0,0,,Менің ойымша, ол алдын ала белгіленген болашаққа қарсы күрескісі келді➡
Dialogue: 0,0:09:04.77,0:09:07.31,Default,,0,0,0,,Бірақ Милле дүниеге келгеннен кейін көп ұзамай ол апаттан қайтыс болды➡
Dialogue: 0,0:09:07.31,0:09:11.25,Default,,0,0,0,,Мираи екеумізді Нагонодағы оякубукуро отбасы қабылдады.
Dialogue: 0,0:09:11.25,0:09:14.75,Default,,0,0,0,,Содан бері мен сені анда-санда осылай көретін болдым.
Dialogue: 0,0:09:14.75,0:09:16.75,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:24.26,0:09:26.26,Default,,0,0,0,,Юю мен аздан кейін кетемін➡
Dialogue: 0,0:09:26.26,0:09:28.76,Default,,0,0,0,,Біраз демалыңыз. жоғары!
Dialogue: 0,0:09:33.33,0:09:35.77,Default,,0,0,0,,((Әкесі Ана➡
Dialogue: 0,0:09:35.77,0:09:38.77,Default,,0,0,0,,Мен...Мен көп адамға қиындық тудырдым➡
Dialogue: 0,0:09:38.77,0:09:41.28,Default,,0,0,0,,Жаңа ғана сізден қолдау алдым➡
Dialogue: 0,0:09:41.28,0:09:44.31,Default,,0,0,0,,Сізге қолдау көрсететін кезегім келген сияқты.
Dialogue: 0,0:09:44.31,0:09:47.32,Default,,0,0,0,,Өтінемін, сонда мені бақылаңыз. ))
Dialogue: 0,0:09:52.75,0:09:55.26,Default,,0,0,0,,О! Қазір әдемі болып көрінеді, солай емес пе?
Dialogue: 0,0:09:55.26,0:09:57.26,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:09:57.26,0:09:59.26,Default,,0,0,0,,Олай болса уақыт келді➡
Dialogue: 0,0:09:59.26,0:10:01.23,Default,,0,0,0,,Басы ғана!
Dialogue: 0,0:10:09.74,0:10:11.74,Default,,0,0,0,,Ку...!
Dialogue: 0,0:10:11.74,0:10:13.71,Default,,0,0,0,,Мен тағы жеңілдім. Мынадай...
Dialogue: 0,0:10:16.24,0:10:18.21,Default,,0,0,0,,Тағы бір рет өтінемін!
Dialogue: 0,0:10:18.21,0:10:20.22,Default,,0,0,0,,Ах.
Dialogue: 0,0:10:22.22,0:10:25.29,Default,,0,0,0,,Біркелкі киімдер…. Un?
Dialogue: 0,0:10:25.29,0:10:28.76,Default,,0,0,0,,Мен униформашыларды міндетті түрде тоқтатамын➡
Dialogue: 0,0:10:28.76,0:10:31.23,Default,,0,0,0,,Осы мақсатта толығырақ...
Dialogue: 0,0:10:31.23,0:10:33.23,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:10:34.73,0:10:36.73,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:10:36.73,0:10:39.23,Default,,0,0,0,,​​Түсіндім.
Dialogue: 0,0:10:39.23,0:10:41.30,Default,,0,0,0,,Тұр! Авангард.
Dialogue: 0,0:10:41.30,0:10:46.34,Default,,0,0,0,,Хаа….
Dialogue: 0,0:10:46.34,0:10:48.88,Default,,0,0,0,,Менің басым ауыр.
Dialogue: 0,0:10:48.88,0:10:52.38,Default,,0,0,0,,)
Dialogue: 0,0:10:53.21,0:10:55.22,Default,,0,0,0,,Кешіріңіз➡
Dialogue: 0,0:10:55.22,0:10:57.29,Default,,0,0,0,,Мен саған су әкелдім.
Dialogue: 0,0:10:57.29,0:11:00.22,Default,,0,0,0,,Рахмет, мм...сіз ше?
Dialogue: 0,0:11:00.22,0:11:03.26,Default,,0,0,0,,Менің атым Қобашы, мен өткен күні жастар құрамасына қосылдым.
Dialogue: 0,0:11:03.26,0:11:05.73,Default,,0,0,0,,Мен Изуку Мидориямын!
Dialogue: 0,0:11:05.73,0:11:07.73,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:11:09.26,0:11:11.23,Default,,0,0,0,,Соңғы уақытта көптеген адамдар тастап кетті➡
Dialogue: 0,0:11:11.23,0:11:13.74,Default,,0,0,0,,Кіретін адамдар сирек.
Dialogue: 0,0:11:13.74,0:11:15.77,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:11:15.77,0:11:19.24,Default,,0,0,0,,Мен Deluxe Leica-ны көргеннен кейін жастар клубына қосылдым!
Dialogue: 0,0:11:19.24,0:11:21.74,Default,,0,0,0,,Мен? жоғары!
Dialogue: 0,0:11:21.74,0:11:24.25,Default,,0,0,0,,Райка күшті жауға қарсы тұрады➡
Dialogue: 0,0:11:24.25,0:11:26.71,Default,,0,0,0,,Нағыз Youthberg сияқты керемет!
Dialogue: 0,0:11:28.25,0:11:30.22,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:11:30.22,0:11:33.22,Default,,0,0,0,,Мен үнемі тынышпын, бірақ тіпті Лайка сияқты біреу➡
Dialogue: 0,0:11:33.22,0:11:35.76,Default,,0,0,0,,Сіз көп жаттығу жасадыңыз.
Dialogue: 0,0:11:35.76,0:11:39.23,Default,,0,0,0,,Жоқ...Мен әлі алыспын➡
Dialogue: 0,0:11:39.23,0:11:41.23,Default,,0,0,0,,Әлі жоқ...
Dialogue: 0,0:11:42.73,0:11:46.23,Default,,0,0,0,,Ах! Бұл қазірдің өзінде қабық...
Dialogue: 0,0:11:46.23,0:11:48.24,Default,,0,0,0,,Бұл өте танымал болды.
Dialogue: 0,0:11:48.24,0:11:50.24,Default,,0,0,0,,Бірінен соң бірі➡
Dialogue: 0,0:11:50.24,0:11:52.74,Default,,0,0,0,,Бірақ бұл өте қызық болды!
Dialogue: 0,0:11:52.74,0:11:54.74,Default,,0,0,0,,Керемет! ➡
Dialogue: 0,0:11:54.74,0:11:56.74,Default,,0,0,0,,Айтпақшы, сіз дыбысты естідіңіз бе?
Dialogue: 0,0:11:56.74,0:11:58.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:58.71,0:12:01.72,Default,,0,0,0,,Бұл оңай болмайды.
Dialogue: 0,0:12:01.72,0:12:04.22,Default,,0,0,0,,Мазалағаным үшін кешіріңіз! ➡
Dialogue: 0,0:12:04.22,0:12:06.72,Default,,0,0,0,,Мен оны жек көремін! Бұл керемет ғимарат! ➡
Dialogue: 0,0:12:06.72,0:12:09.26,Default,,0,0,0,,Экономиканың жақсы жүріп жатқанына қуаныштымын!
Dialogue: 0,0:12:09.26,0:12:11.26,Default,,0,0,0,,Бұл тым өрескел.
Dialogue: 0,0:12:11.26,0:12:13.73,Default,,0,0,0,,Томари-сан? Мегуми-сан!
Dialogue: 0,0:12:13.73,0:12:15.73,Default,,0,0,0,,Сұлулық пен құбыжық осында!
Dialogue: 0,0:12:15.73,0:12:17.73,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:17.73,0:12:19.73,Default,,0,0,0,,Yaho~Urara-chan!
Dialogue: 0,0:12:19.73,0:12:22.24,Default,,0,0,0,,Екеуің мұнда неге келдіңдер?
Dialogue: 0,0:12:22.24,0:12:24.24,Default,,0,0,0,,Мен сізге қоңырау шалдым.
Dialogue: 0,0:12:24.24,0:12:27.24,Default,,0,0,0,,Нақты неден басталады?
Dialogue: 0,0:12:27.24,0:12:29.74,Default,,0,0,0,,Мен оны қолданып көргім келді~➡
Dialogue: 0,0:12:29.74,0:12:31.75,Default,,0,0,0,,Ұйқы.
Dialogue: 0,0:12:33.72,0:12:35.75,Default,,0,0,0,,Мен...Мен киімімді ауыстырдым!
Dialogue: 0,0:12:35.75,0:12:37.72,Default,,0,0,0,,О!
Dialogue: 0,0:12:37.72,0:12:40.26,Default,,0,0,0,,Бұл ұят нәрсе.
Dialogue: 0,0:12:40.26,0:12:42.22,Default,,0,0,0,,Өте сүйкімді! Азатой!
Dialogue: 0,0:12:42.22,0:12:44.23,Default,,0,0,0,,Сіз шынымен...
Dialogue: 0,0:12:44.23,0:12:46.23,Default,,0,0,0,,Урара-чан, осылай...!
Dialogue: 0,0:12:46.23,0:12:48.23,Default,,0,0,0,,Ах...сәлем!
Dialogue: 0,0:12:48.23,0:12:50.23,Default,,0,0,0,,Мектеп саяхаты сияқты!
Dialogue: 0,0:12:50.23,0:12:52.23,Default,,0,0,0,,Егер сіз тым көп шу шығарсаңыз, бұл жағымсыз.
Dialogue: 0,0:12:52.23,0:12:54.74,Default,,0,0,0,,Айтпақшы, Харука ше?
Dialogue: 0,0:12:54.74,0:12:57.24,Default,,0,0,0,,Мен оны шақырдым, бірақ ол жұмыс екенін айтты.
Dialogue: 0,0:12:57.24,0:13:00.24,Default,,0,0,0,,Кешіріңіз! Мен сізге жейдемді қарызға беру үшін қиындық көрдім.
Dialogue: 0,0:13:00.24,0:13:02.21,Default,,0,0,0,,E….
Dialogue: 0,0:13:03.24,0:13:06.25,Default,,0,0,0,,Бірақ екеуіңнің келгендеріңе таң қалдым.
Dialogue: 0,0:13:06.25,0:13:08.25,Default,,0,0,0,,Мирэй-чанның өтінішін қабыл алыңыз➡
Dialogue: 0,0:13:08.25,0:13:10.25,Default,,0,0,0,,Мен де Урара-чанмен кездескім келді.
Dialogue: 0,0:13:10.25,0:13:12.22,Default,,0,0,0,,Әпке~!
Dialogue: 0,0:13:12.22,0:13:14.72,Default,,0,0,0,,Хехехе...осылай барлығымен уақыт өткізіп жатқаныма сене алар емеспін➡
Dialogue: 0,0:13:14.72,0:13:17.76,Default,,0,0,0,,Мен мұны бұрын ешқашан елестеткен де емеспін.
Dialogue: 0,0:13:17.76,0:13:19.79,Default,,0,0,0,,Мүмкін солай.
Dialogue: 0,0:13:19.79,0:13:22.23,Default,,0,0,0,,Көп нәрсе болды, бәрімен ұрысып қалдық➡
Dialogue: 0,0:13:22.23,0:13:24.23,Default,,0,0,0,,Егер ол болмаса, біз бір-бірімізді танымас едік.
Dialogue: 0,0:13:24.23,0:13:26.23,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:13:26.23,0:13:28.24,Default,,0,0,0,,Әрине, Deluxe турнирлер үшін де қолайлы➡
Dialogue: 0,0:13:28.24,0:13:30.24,Default,,0,0,0,,Сыртқа шығуды ойламаған едім➡
Dialogue: 0,0:13:30.24,0:13:32.27,Default,,0,0,0,,Мен Урара-чанмен де кездесе алмадым.
Dialogue: 0,0:13:32.27,0:13:35.24,Default,,0,0,0,,Милэй мырза... Мен не айтқым келеді?
Dialogue: 0,0:13:36.24,0:13:38.21,Default,,0,0,0,,Татуласу және ұрысу➡
Dialogue: 0,0:13:38.21,0:13:41.22,Default,,0,0,0,,Менің ойымша, бәрі осылайша тереңірек түседі!
Dialogue: 0,0:13:41.22,0:13:43.32,Default,,0,0,0,,Миллей мырза.
Dialogue: 0,0:13:43.32,0:13:45.79,Default,,0,0,0,,Ах! Мен мұны шынымен жақсы жасадым. а….
Dialogue: 0,0:13:47.76,0:13:51.76,Default,,0,0,0,,Сол кезде мен униформашылардың мүшесі ретінде Wonder Hill-ге келдім.
Dialogue: 0,0:13:51.76,0:13:53.76,Default,,0,0,0,,Сол кездегі Урара-чан➡
Dialogue: 0,0:13:53.76,0:13:57.23,Default,,0,0,0,,Себебі мен бұл нағыз Урара-чан емес деп ойладым.
Dialogue: 0,0:13:57.23,0:13:59.77,Default,,0,0,0,,Бірақ мен шынымен абдырап қалдым.
Dialogue: 0,0:13:59.77,0:14:03.24,Default,,0,0,0,,Менің ойымша, сіз өзіңіздің идеал Урара-чаныңызды маған таңып жатырсыз.
Dialogue: 0,0:14:03.24,0:14:05.74,Default,,0,0,0,,Томари мырза….
Dialogue: 0,0:14:05.74,0:14:08.78,Default,,0,0,0,,Жоқ! Маған рахмет, Юю-сан мен Томари-сан➡
Dialogue: 0,0:14:08.78,0:14:12.25,Default,,0,0,0,,Дыбысты қайта естимін. Бұл менің ұрысқым келеді!
Dialogue: 0,0:14:12.25,0:14:14.25,Default,,0,0,0,,Урара-чан.
Dialogue: 0,0:14:14.25,0:14:16.22,Default,,0,0,0,,Бірақ➡
Dialogue: 0,0:14:16.22,0:14:19.22,Default,,0,0,0,,Мен оны әлі қайтарған жоқпын.
Dialogue: 0,0:14:25.23,0:14:27.23,Default,,0,0,0,,Жақсы! Бүгін тұрамыз ба?
Dialogue: 0,0:14:27.23,0:14:29.23,Default,,0,0,0,,Тағы бір рет өтінемін!
Dialogue: 0,0:14:29.23,0:14:32.23,Default,,0,0,0,,Амалсыз тырысып жатқан сияқтысыз... мүмкін қандай да бір себептермен?
Dialogue: 0,0:14:32.23,0:14:35.74,Default,,0,0,0,,Мен досыма айтқым келеді.
Dialogue: 0,0:14:35.74,0:14:38.74,Default,,0,0,0,,Uniformers киімде достарыңыз бар ма? жоғары.
Dialogue: 0,0:14:38.74,0:14:42.74,Default,,0,0,0,,Түсіндім, бірақ формашылар атанған жігіт➡
Dialogue: 0,0:14:42.74,0:14:44.71,Default,,0,0,0,,Менен оңай сұрай аласыз ба?
Dialogue: 0,0:14:44.71,0:14:46.75,Default,,0,0,0,,Біз оны өткенше жеткіземіз➡
Dialogue: 0,0:14:46.75,0:14:49.72,Default,,0,0,0,,Қалағаныңызша.
Dialogue: 0,0:14:49.72,0:14:51.72,Default,,0,0,0,,Мен мұны қолымнан келгенше істеймін деп ойлаймын.
Dialogue: 0,0:14:51.72,0:14:53.72,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:14:53.72,0:14:56.26,Default,,0,0,0,,Тағы бір рет.
Dialogue: 0,0:14:56.26,0:14:58.23,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:15:09.80,0:15:12.81,Default,,0,0,0,,((Мичиру...Мен➡
Dialogue: 0,0:15:12.81,0:15:15.28,Default,,0,0,0,,Мен бұл жігітті дұрыс басқара аламын ба? ))
Dialogue: 0,0:15:21.25,0:15:23.22,Default,,0,0,0,,Хмм….
Dialogue: 0,0:15:23.22,0:15:25.25,Default,,0,0,0,,Юю! а...?
Dialogue: 0,0:15:25.25,0:15:28.72,Default,,0,0,0,,Тезірек бетіңізді жуыңыз. Уақыт жоқ!
Dialogue: 0,0:15:28.72,0:15:30.73,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:32.23,0:15:35.23,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:15:37.73,0:15:40.30,Default,,0,0,0,,Тағы да сұмдық!
Dialogue: 0,0:15:40.30,0:15:44.27,Default,,0,0,0,,((Бірақ қандай әдемі жекпе-жек➡
Dialogue: 0,0:15:44.27,0:15:47.81,Default,,0,0,0,,Бұл жай ғана күшті жекпе-жек емес, сізді өзіне тартатын тартыс➡
Dialogue: 0,0:15:47.81,0:15:52.21,Default,,0,0,0,,Мен бұл жекпе-жекке тәнті болдым және бұл маған батылдық берді! ))
Dialogue: 0,0:15:52.21,0:15:55.22,Default,,0,0,0,,Мичиру-сан, мен сенен жақсымын!
Dialogue: 0,0:15:55.22,0:15:57.75,Default,,0,0,0,,Жолға не кедергі➡
Dialogue: 0,0:15:57.75,0:15:59.72,Default,,0,0,0,,Кім болса да тастаңыз!
Dialogue: 0,0:16:02.26,0:16:04.23,Default,,0,0,0,,Зақымдануды тексеру.
Dialogue: 0,0:16:05.73,0:16:08.73,Default,,0,0,0,,Жоқ, мен оны естімеймін.
Dialogue: 0,0:16:08.73,0:16:10.73,Default,,0,0,0,,Урара-чан.
Dialogue: 0,0:16:10.73,0:16:13.73,Default,,0,0,0,,Неліктен, мен неге қайта алмаймын?
Dialogue: 0,0:16:13.73,0:16:17.74,Default,,0,0,0,,Бұл дұрыс емес, Урара-чан. жұмысшы?
Dialogue: 0,0:16:17.74,0:16:20.24,Default,,0,0,0,,Ескі Урара-чан мен қазіргі Урара-чан➡
Dialogue: 0,0:16:20.24,0:16:22.24,Default,,0,0,0,,Сол Урара-чан➡
Dialogue: 0,0:16:22.24,0:16:25.21,Default,,0,0,0,,Сондықтан оны орнына қоюға тырысудың қажеті жоқ.
Dialogue: 0,0:16:25.21,0:16:28.25,Default,,0,0,0,,Екеуі де менмін...
Dialogue: 0,0:16:28.25,0:16:31.75,Default,,0,0,0,,Өзіңізді қандай болсаңыз, солай қабылдаңыз.
Dialogue: 0,0:16:31.75,0:16:35.26,Default,,0,0,0,,Өткенді жоққа шығарма, оны қабылдап алға ұмтыл!
Dialogue: 0,0:16:35.26,0:16:37.73,Default,,0,0,0,,Әрине, бар күшіңізбен!
Dialogue: 0,0:16:37.73,0:16:40.23,Default,,0,0,0,,Ал мұқият тыңдаңыз➡
Dialogue: 0,0:16:40.23,0:16:42.23,Default,,0,0,0,,Олай жасасаңыз, міндетті түрде резонанс тудырады➡
Dialogue: 0,0:16:42.23,0:16:44.20,Default,,0,0,0,,Жаңа дыбыстар.
Dialogue: 0,0:16:45.73,0:16:47.70,Default,,0,0,0,,Жаңа дыбыстар….
Dialogue: 0,0:16:49.74,0:16:51.74,Default,,0,0,0,,Мен тыңдағым келеді!
Dialogue: 0,0:16:53.24,0:16:55.24,Default,,0,0,0,,Олай болса➡
Dialogue: 0,0:16:55.24,0:16:57.75,Default,,0,0,0,,Сәлем! жұмысшы?
Dialogue: 0,0:16:57.75,0:17:00.75,Default,,0,0,0,,Қабыл ал! Сен сол қызбен ұрысып кетесің, солай ма?
Dialogue: 0,0:17:02.25,0:17:04.22,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:17:06.72,0:17:09.22,Default,,0,0,0,,Мен сені қолдаймын!
Dialogue: 0,0:17:09.22,0:17:12.23,Default,,0,0,0,,Мен бәріңді жақсы көремін!
Dialogue: 0,0:17:13.76,0:17:16.23,Default,,0,0,0,,Шнайзелмен шабуыл!
Dialogue: 0,0:17:16.23,0:17:19.73,Default,,0,0,0,,Дауыл күші +5000 шеберлікпен!
Dialogue: 0,0:17:19.73,0:17:21.87,Default,,0,0,0,,Дауылда….
Dialogue: 0,0:17:21.87,0:17:23.74,Default,,0,0,0,,)
Dialogue: 0,0:17:23.74,0:17:25.71,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:17:32.25,0:17:34.72,Default,,0,0,0,,Хаа….
Dialogue: 0,0:17:38.89,0:17:40.86,Default,,0,0,0,,)
Dialogue: 0,0:17:44.26,0:17:46.23,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:52.23,0:17:55.74,Default,,0,0,0,,Ұрыс үшін рахмет.
Dialogue: 0,0:17:55.74,0:17:58.24,Default,,0,0,0,,Лейка мырза! ➡
Dialogue: 0,0:17:58.24,0:18:01.28,Default,,0,0,0,,Ано➡ еңбегіңіз үшін рахмет
Dialogue: 0,0:18:01.28,0:18:04.25,Default,,0,0,0,,Жаңа оқты көруге бүкіл командамен➡ бардым
Dialogue: 0,0:18:04.25,0:18:07.72,Default,,0,0,0,,Лайка-сан, мен маңызды матч болды деп естідім.➡
Dialogue: 0,0:18:07.72,0:18:09.75,Default,,0,0,0,,Өтінемін! Жарайды ма?
Dialogue: 0,0:18:09.75,0:18:12.22,Default,,0,0,0,,Жеңіс! ➡
Dialogue: 0,0:18:12.22,0:18:14.72,Default,,0,0,0,,Бір күні мен де...
Dialogue: 0,0:18:16.26,0:18:18.23,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:18:19.79,0:18:23.26,Default,,0,0,0,,Мен сенің жақсылығыңды өтеуге уәде беремін.
Dialogue: 0,0:18:25.23,0:18:29.24,Default,,0,0,0,,Барлығыңызға көп рахмет!
Dialogue: 0,0:18:29.24,0:18:31.74,Default,,0,0,0,,Барлық көмектеріңіз үшін рахмет.
Dialogue: 0,0:18:31.74,0:18:34.24,Default,,0,0,0,,Жақсы...ол үшін уайымдама.
Dialogue: 0,0:18:34.24,0:18:36.74,Default,,0,0,0,,Айтпақшы, стикерге қатысты...
Dialogue: 0,0:18:36.74,0:18:38.71,Default,,0,0,0,,Бұл тамаша! ➡
Dialogue: 0,0:18:38.71,0:18:40.72,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:18:40.72,0:18:42.75,Default,,0,0,0,,О!
Dialogue: 0,0:18:42.75,0:18:45.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:45.72,0:18:47.76,Default,,0,0,0,,Олай болса, кеттік!
Dialogue: 0,0:18:47.76,0:18:49.72,Default,,0,0,0,,Ой... стикерлер!
Dialogue: 0,0:18:51.73,0:18:53.73,Default,,0,0,0,,Хаа….
Dialogue: 0,0:18:54.73,0:18:57.77,Default,,0,0,0,,Өкінбеңіз Туя Эбата➡
Dialogue: 0,0:18:57.77,0:19:00.23,Default,,0,0,0,,Мен сияқты күте берме.
Dialogue: 0,0:19:09.74,0:19:11.71,Default,,0,0,0,,Ой...
Dialogue: 0,0:19:11.71,0:19:13.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:21.26,0:19:25.26,Default,,0,0,0,,Нирвана Дживамен шабуыл...
Dialogue: 0,0:19:25.26,0:19:28.30,Default,,0,0,0,,Дағдыларды белсендіру.
Dialogue: 0,0:19:28.30,0:19:30.30,Default,,0,0,0,,Гару Верлина...
Dialogue: 0,0:19:31.73,0:19:33.70,Default,,0,0,0,,Хаа….
Dialogue: 0,0:19:40.74,0:19:44.38,Default,,0,0,0,,Жоқ...ойыма ештеңе келмейді.
Dialogue: 0,0:19:44.38,0:19:46.38,Default,,0,0,0,,)
Dialogue: 0,0:19:49.22,0:19:51.22,Default,,0,0,0,,Мегуми...?
Dialogue: 0,0:19:57.32,0:19:59.33,Default,,0,0,0,,((қаралау➡
Dialogue: 0,0:19:59.33,0:20:01.73,Default,,0,0,0,,Әр адам әртүрлі жастағы және ойлау тәсілі➡
Dialogue: 0,0:20:01.73,0:20:04.63,Default,,0,0,0,,Авангардпен байланысты...
Dialogue: 0,0:20:04.63,0:20:06.63,Default,,0,0,0,,Бұл қызық болды.
Dialogue: 0,0:20:11.24,0:20:13.77,Default,,0,0,0,,Мұның бәрі қызық емес➡
Dialogue: 0,0:20:13.77,0:20:16.24,Default,,0,0,0,,Небір азапты, қиын кездер болса да.
Dialogue: 0,0:20:21.22,0:20:24.75,Default,,0,0,0,,Бәрін жинастырып, алға жылжыдым➡
Dialogue: 0,0:20:24.75,0:20:28.26,Default,,0,0,0,,Күш алу үшін өзіңнен бас тартудың қажеті жоқ.
Dialogue: 0,0:20:32.83,0:20:34.80,Default,,0,0,0,,Бірақ! ))
Dialogue: 0,0:20:37.80,0:20:40.23,Default,,0,0,0,,((Ең күшті көшірме ғана қалады➡
Dialogue: 0,0:20:40.23,0:20:42.24,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:42.24,0:20:44.31,Default,,0,0,0,,Егер бәрі мұны істей алса➡
Dialogue: 0,0:20:44.31,0:20:46.37,Default,,0,0,0,,Бұл идеалды әлем. ))
Dialogue: 0,0:20:46.37,0:20:48.24,Default,,0,0,0,,)
Dialogue: 0,0:20:48.24,0:20:50.24,Default,,0,0,0,,Мүлдем идеал емес!
Dialogue: 0,0:20:50.24,0:20:52.25,Default,,0,0,0,,Юю?
Dialogue: 0,0:20:52.25,0:20:54.22,Default,,0,0,0,,Гару Верлина тұр!
Dialogue: 0,0:20:54.22,0:20:56.72,Default,,0,0,0,,Бұл қызық, өйткені әркім әртүрлі➡
Dialogue: 0,0:20:56.72,0:20:58.75,Default,,0,0,0,,Біркелкілердің идеалы➡
Dialogue: 0,0:20:58.75,0:21:01.26,Default,,0,0,0,,Мен оны тоқтату үшін бар күшімді саламын!
Dialogue: 0,0:21:01.26,0:21:03.72,Default,,0,0,0,,Гару Верлинамен шабуыл!
Dialogue: 0,0:21:06.23,0:21:08.23,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:21:11.73,0:21:14.24,Default,,0,0,0,,Ақыры...Мен жеңдім!
Dialogue: 0,0:21:14.24,0:21:16.74,Default,,0,0,0,,Қазір...
Dialogue: 0,0:21:16.74,0:21:18.74,Default,,0,0,0,,Қазір!
Dialogue: 0,0:21:18.74,0:21:23.38,Default,,0,0,0,,Хаа...!
Dialogue: 0,0:21:23.38,0:21:26.71,Default,,0,0,0,,)
Dialogue: 0,0:21:26.71,0:21:29.72,Default,,0,0,0,,Хаа….
Dialogue: 0,0:21:36.72,0:21:40.73,Default,,0,0,0,,Керемет...керемет!
Dialogue: 0,0:21:40.73,0:21:43.86,Default,,0,0,0,,Дүние жүзінде формалар көбейіп келеді!
Dialogue: 0,0:21:43.86,0:21:46.73,Default,,0,0,0,,Соңғы шайқасты жүзеге асыру элементтері➡
Dialogue: 0,0:21:46.73,0:21:49.24,Default,,0,0,0,,Тұрақты түрде толтырылуда!
Dialogue: 0,0:21:49.24,0:21:52.24,Default,,0,0,0,,Жоспар жақсы жүріп жатыр, Шыңги!
Dialogue: 0,0:21:57.21,0:21:59.21,Default,,0,0,0,,Аға.
Dialogue: 0,0:22:00.71,0:22:06.71,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory