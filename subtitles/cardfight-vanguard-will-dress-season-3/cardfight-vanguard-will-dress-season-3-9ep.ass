Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.63,0:00:04.13,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:00:04.13,0:00:08.60,Default,,0,0,0,,Болашақты жауынгерлердің жаңа ұрпағы алып жүреді!
Dialogue: 0,0:00:09.64,0:00:11.64,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:00:11.64,0:00:14.64,Default,,0,0,0,,Болашақты арқалау? Сіз кім туралы айтып тұрсыз?
Dialogue: 0,0:00:14.64,0:00:16.65,Default,,0,0,0,,Аа...
Dialogue: 0,0:00:16.65,0:00:18.65,Default,,0,0,0,,Юю Кондо! а….
Dialogue: 0,0:00:18.65,0:00:20.65,Default,,0,0,0,,Түлкі Шиба Лейка! ➡
Dialogue: 0,0:00:20.65,0:00:22.62,Default,,0,0,0,,Урара Ханеяма! E~!
Dialogue: 0,0:00:35.16,0:00:38.17,Default,,0,0,0,,Ақпаратыңызды міндетті түрде жаңартыңыз➡
Dialogue: 0,0:00:38.17,0:00:41.17,Default,,0,0,0,,Uniformers-тің бастығы - сұмдық жасанды интеллект.
Dialogue: 0,0:00:41.17,0:00:43.17,Default,,0,0,0,,Не?
Dialogue: 0,0:00:43.17,0:00:47.18,Default,,0,0,0,,Жарайсың ба? Күресші күн сайын өсіп келеді➡
Dialogue: 0,0:00:47.18,0:00:50.68,Default,,0,0,0,,Мен оны 3-ші күні көрмесем, катсудон жеймін дейді.
Dialogue: 0,0:00:50.68,0:00:54.18,Default,,0,0,0,,Қалай? Жарайды...бір дұрыс жауап➡
Dialogue: 0,0:00:54.18,0:00:57.69,Default,,0,0,0,,Аяқтарын айқастырып отырған бағдарламашы түсінбейтін шығар.➡
Dialogue: 0,0:00:57.69,0:00:59.69,Default,,0,0,0,,(Кондуктор) Сен, сол жерде тұр! Ей! Қауіпті!
Dialogue: 0,0:00:59.69,0:01:02.62,Default,,0,0,0,,Біздің шақыруымызды қабылдап, дәлелдейсіз бе? ➡
Dialogue: 0,0:01:02.62,0:01:06.63,Default,,0,0,0,,Формалар... сен ең мықтысың!
Dialogue: 0,0:01:06.63,0:01:09.13,Default,,0,0,0,,Хмм…. (Көрермендер) Ой! Сол жігіт➡
Dialogue: 0,0:01:09.13,0:01:11.63,Default,,0,0,0,,Сіз униформашылардың бастығымын деп айттыңыз ғой, солай ма? ➡
Dialogue: 0,0:01:11.63,0:01:13.64,Default,,0,0,0,,Дәлірек айтқанда, AI?
Dialogue: 0,0:01:13.64,0:01:16.14,Default,,0,0,0,,Юю Кондо люкс жеңімпазы, солай ма? ➡
Dialogue: 0,0:01:16.14,0:01:19.14,Default,,0,0,0,,Егер мұндай матч орын алса...
Dialogue: 0,0:01:19.14,0:01:21.11,Default,,0,0,0,,Бұл керемет жекпе-жек болары сөзсіз!
Dialogue: 0,0:01:22.14,0:01:26.65,Default,,0,0,0,,Бұл жақсы. Бұл да униформашылардың➡ мықтылығының жарнамасы сияқты
Dialogue: 0,0:01:26.65,0:01:31.65,Default,,0,0,0,,Егер олар мен дайындаған ең мықты күрескерге қарсы жекпе-жекте жеңіске жетсе...
Dialogue: 0,0:01:31.65,0:01:34.16,Default,,0,0,0,,Мен сенімен айналысамын.
Dialogue: 0,0:01:34.16,0:01:37.16,Default,,0,0,0,,Бұған екі сөз жоқ па?
Dialogue: 0,0:01:37.16,0:01:40.66,Default,,0,0,0,,Аа...қанша тырыссам да өзгермейді➡
Dialogue: 0,0:01:40.66,0:01:45.17,Default,,0,0,0,,Мен сізге абсолютті шындықты көрсетемін!
Dialogue: 0,0:01:45.17,0:01:47.64,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:01:53.18,0:01:56.68,Default,,0,0,0,,Хаа... Сіз өте жарқыраған сахна орнаттыңыз.
Dialogue: 0,0:01:56.68,0:01:58.68,Default,,0,0,0,,Мен бар күшімді салуым керек!
Dialogue: 0,0:01:58.68,0:02:01.12,Default,,0,0,0,,Біздің қолымызбен➡
Dialogue: 0,0:02:01.12,0:02:03.12,Default,,0,0,0,,Барлығының көзі Uniformers➡
Dialogue: 0,0:02:03.12,0:02:05.09,Default,,0,0,0,,Мені оят!
Dialogue: 0,0:03:51.13,0:03:53.10,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:03:56.63,0:04:00.60,Default,,0,0,0,,Бұл біршама салтанатты атмосфераға ие.
Dialogue: 0,0:04:01.64,0:04:04.14,Default,,0,0,0,,Бірақ мұндай тауда➡
Dialogue: 0,0:04:04.14,0:04:06.11,Default,,0,0,0,,Кеңістікпен ұрыс...
Dialogue: 0,0:04:07.64,0:04:09.61,Default,,0,0,0,,Ах...!
Dialogue: 0,0:04:10.65,0:04:12.65,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:04:12.65,0:04:15.65,Default,,0,0,0,,Бірақ неге бұл жерде?
Dialogue: 0,0:04:15.65,0:04:17.65,Default,,0,0,0,,Ол мұны жасаған сияқты. жұмысшы?
Dialogue: 0,0:04:17.65,0:04:21.66,Default,,0,0,0,,Формалар оны осы жекпе-жекке дайындады.
Dialogue: 0,0:04:21.66,0:04:23.66,Default,,0,0,0,,Тек осы үшін бе?
Dialogue: 0,0:04:23.66,0:04:25.63,Default,,0,0,0,,Сонымен... бұл таңқаларлық.
Dialogue: 0,0:04:27.66,0:04:29.66,Default,,0,0,0,,Мұнда➡
Dialogue: 0,0:04:29.66,0:04:31.60,Default,,0,0,0,,Финалға сәйкес.
Dialogue: 0,0:04:31.60,0:04:34.10,Default,,0,0,0,,Закуса мырза... Сәлеметсіз бе.
Dialogue: 0,0:04:34.10,0:04:37.07,Default,,0,0,0,,Өйткені, сізді шеттете беруге болмайды.
Dialogue: 0,0:04:42.61,0:04:44.58,Default,,0,0,0,,Ах...!
Dialogue: 0,0:04:46.62,0:04:48.58,Default,,0,0,0,,Халона!
Dialogue: 0,0:04:51.12,0:04:53.12,Default,,0,0,0,,Софи Белл...!
Dialogue: 0,0:04:53.12,0:04:55.09,Default,,0,0,0,,Уху….
Dialogue: 0,0:05:00.63,0:05:03.13,Default,,0,0,0,,Енді бізде барлық актерлер бар!
Dialogue: 0,0:05:03.13,0:05:06.64,Default,,0,0,0,,Авангардтың болашағы үшін шешуші шайқас ақыры басталды!
Dialogue: 0,0:05:06.64,0:05:10.14,Default,,0,0,0,,Қандай шайқас болады?
Dialogue: 0,0:05:10.14,0:05:13.14,Default,,0,0,0,,Томари-сан! Неге мұндасың?
Dialogue: 0,0:05:13.14,0:05:15.14,Default,,0,0,0,,Ол қазірдің өзінде шешілді! ➡
Dialogue: 0,0:05:15.14,0:05:18.65,Default,,0,0,0,,Авангардтың болашағын шешетін Паку тауының етегіндегі шешуші шайқас!
Dialogue: 0,0:05:18.65,0:05:20.65,Default,,0,0,0,,Осындай үлкен жекпе-жек туралы тікелей эфир ➡
Dialogue: 0,0:05:20.65,0:05:23.15,Default,,0,0,0,,Томари жасамаса, кім жасайды?
Dialogue: 0,0:05:23.15,0:05:27.16,Default,,0,0,0,,Ахаха…. Күткендей, Томаридің түсініктемесі көтеріліп жатыр!
Dialogue: 0,0:05:27.16,0:05:30.59,Default,,0,0,0,,Сәлем, балалар! Ережелерді түсіндіретін уақыт келді!
Dialogue: 0,0:05:30.59,0:05:33.60,Default,,0,0,0,,Тау етегіндегі шешуші шайқас.
Dialogue: 0,0:05:33.60,0:05:37.60,Default,,0,0,0,,Егер сіз екеуін де жеңе алсаңыз, сіз соңғы бастық Жігітке қарсы шығу құқығын аласыз! ➡
Dialogue: 0,0:05:37.60,0:05:39.60,Default,,0,0,0,,Бірінші тур ➡
Dialogue: 0,0:05:39.60,0:05:43.07,Default,,0,0,0,,Қандай жауынгерлер алға шығады?
Dialogue: 0,0:05:44.11,0:05:46.11,Default,,0,0,0,,Бұл менмін...менің қарсыласым➡
Dialogue: 0,0:05:46.11,0:05:48.61,Default,,0,0,0,,Мерзімі аяқталуға дәл соңғы сәтте болса да—
Dialogue: 0,0:05:48.61,0:05:50.58,Default,,0,0,0,,Мен барамын.
Dialogue: 0,0:05:57.62,0:06:01.12,Default,,0,0,0,,Әр адам түпкілікті шайқасқа жете алатын болашақты жариялаңыз➡
Dialogue: 0,0:06:01.12,0:06:04.63,Default,,0,0,0,,Біркелкі киімдер жаңа жұлдыздай пайда болды! ➡
Dialogue: 0,0:06:04.63,0:06:06.63,Default,,0,0,0,,Көптеген турнирлерге қатысты➡
Dialogue: 0,0:06:06.63,0:06:08.63,Default,,0,0,0,,UNI қолданбасын жүктеп алу саны ➡
Dialogue: 0,0:06:08.63,0:06:11.63,Default,,0,0,0,,Рекордтық көрсеткішке қол жеткізілді! ➡
Dialogue: 0,0:06:11.63,0:06:15.64,Default,,0,0,0,,Бұл қазір Авангард әлемін бояйтын басты күш! ➡
Dialogue: 0,0:06:15.64,0:06:17.64,Default,,0,0,0,,Бірақ сәл күте тұрыңыз➡
Dialogue: 0,0:06:17.64,0:06:19.64,Default,,0,0,0,,Қазіргі Авангард әлемі➡
Dialogue: 0,0:06:19.64,0:06:23.14,Default,,0,0,0,,Бұл шынымен де барлық жауынгерлер қалайтын дүние ме? ➡
Dialogue: 0,0:06:23.14,0:06:26.15,Default,,0,0,0,,Алға шыққан адам Юю Кондо➡ болды
Dialogue: 0,0:06:26.15,0:06:28.65,Default,,0,0,0,,Түлкі Шиба Лаика Урара Ханеяма➡
Dialogue: 0,0:06:28.65,0:06:30.59,Default,,0,0,0,,Жауынгерлердің жаңа ұрпағы! ➡
Dialogue: 0,0:06:30.59,0:06:34.09,Default,,0,0,0,,Deluxe➡-те тамаша нәтижелерге қол жеткізген жас элиталар
Dialogue: 0,0:06:34.09,0:06:37.59,Default,,0,0,0,,Бірыңғай киім киетіндерге шақыру! ➡
Dialogue: 0,0:06:37.59,0:06:41.60,Default,,0,0,0,,Авангард дегеніміз не? Vanguard-тың болашағы қандай? ➡
Dialogue: 0,0:06:41.60,0:06:44.60,Default,,0,0,0,,Барлық жауынгерлер, шайқасыңдар!
Dialogue: 0,0:06:44.60,0:06:46.57,Default,,0,0,0,,Мен оны сұрадым.
Dialogue: 0,0:06:57.11,0:07:00.62,Default,,0,0,0,,Біріншісі кометаға ұқсайды➡
Dialogue: 0,0:07:00.62,0:07:03.12,Default,,0,0,0,,Жеңілмейтін рекорд жаңартылуда! ➡
Dialogue: 0,0:07:03.12,0:07:05.12,Default,,0,0,0,,Енді біртұтас ойыншыларды бастап келеді➡
Dialogue: 0,0:07:05.12,0:07:08.12,Default,,0,0,0,,Күміс арыстан Широган~! ➡
Dialogue: 0,0:07:08.12,0:07:12.63,Default,,0,0,0,,Оған қарсы - Deluxe➡ жеңіп алған Blackout-тың жас көшбасшысы
Dialogue: 0,0:07:12.63,0:07:16.60,Default,,0,0,0,,Каганың айдаһары Юю Кондо~!
Dialogue: 0,0:07:17.63,0:07:20.64,Default,,0,0,0,,Бірыңғай киімнің жеңілмеген қолтаңбасы➡
Dialogue: 0,0:07:20.64,0:07:23.14,Default,,0,0,0,,Сіз оны жеңе аласыз ба?
Dialogue: 0,0:07:23.14,0:07:25.14,Default,,0,0,0,,Закуса мырза➡
Dialogue: 0,0:07:25.14,0:07:29.14,Default,,0,0,0,,Мен жекпе-жек арқылы нені естігім келетінін айтайын.
Dialogue: 0,0:07:29.14,0:07:31.11,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:07:34.08,0:07:37.59,Default,,0,0,0,,Таудың етегіндегі шешуші шайқас Бірінші матч➡
Dialogue: 0,0:07:37.59,0:07:39.55,Default,,0,0,0,,Бастау!
Dialogue: 0,0:07:41.09,0:07:43.59,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:07:43.59,0:07:45.59,Default,,0,0,0,,Тосын жұмыртқа.
Dialogue: 0,0:07:45.59,0:07:47.60,Default,,0,0,0,,Кардинал Фанг Форви.
Dialogue: 0,0:07:47.60,0:07:49.60,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:07:49.60,0:07:51.60,Default,,0,0,0,,Реноға барыңыз және бұрылысты аяқтаңыз.
Dialogue: 0,0:07:51.60,0:07:54.10,Default,,0,0,0,,Менің кезегім, Люсиске➡ мін
Dialogue: 0,0:07:54.10,0:07:56.60,Default,,0,0,0,,Шеберлікпен 1 картаны салыңыз➡
Dialogue: 0,0:07:56.60,0:08:00.11,Default,,0,0,0,,Қолыңызға шеберлікпен тозған Ай сәулесін қосыңыз.
Dialogue: 0,0:08:00.11,0:08:02.11,Default,,0,0,0,,Люсиспен шабуыл!
Dialogue: 0,0:08:02.11,0:08:04.11,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:08:04.11,0:08:06.61,Default,,0,0,0,,Бұрылыстың соңы. Широган ➡
Dialogue: 0,0:08:06.61,0:08:09.62,Default,,0,0,0,,Біріншіден, қараңғылық әлемін жасайтын негізге ие бол!
Dialogue: 0,0:08:09.62,0:08:11.62,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:08:11.62,0:08:15.12,Default,,0,0,0,,Реноның шеберлігімен Рейлге қоңырау шалыңыз.
Dialogue: 0,0:08:15.12,0:08:17.13,Default,,0,0,0,,Рейлмен шабуыл!
Dialogue: 0,0:08:17.13,0:08:19.13,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:08:19.13,0:08:21.13,Default,,0,0,0,,Бұрылыстың соңы. Екінші жағынан➡
Dialogue: 0,0:08:21.13,0:08:26.13,Default,,0,0,0,,Бұл Call Yuyu-ға тән төбелестегі серіктесіңізге қарсы күрес!
Dialogue: 0,0:08:26.13,0:08:29.64,Default,,0,0,0,,Закуса мырза, сіз Blackout-тан шаршадыңыз ба?
Dialogue: 0,0:08:29.64,0:08:31.64,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:08:31.64,0:08:33.64,Default,,0,0,0,,Менде әлі де өшіп қалады➡
Dialogue: 0,0:08:33.64,0:08:36.64,Default,,0,0,0,,Мен ондағылардың барлығын жақсы көремін➡
Dialogue: 0,0:08:36.64,0:08:39.65,Default,,0,0,0,,Қараңғылық келе жатыр, бас тартпаңыз➡
Dialogue: 0,0:08:39.65,0:08:41.65,Default,,0,0,0,,Кез келген түс қабылданады➡
Dialogue: 0,0:08:41.65,0:08:43.65,Default,,0,0,0,,Әртүрлі түстер араласады➡
Dialogue: 0,0:08:43.65,0:08:47.16,Default,,0,0,0,,Сізді нәзік қараңғылық орап алады➡
Dialogue: 0,0:08:47.16,0:08:50.16,Default,,0,0,0,,Қараңғылық мен үшін әлі де маңызды орын.
Dialogue: 0,0:08:50.16,0:08:52.16,Default,,0,0,0,,Олай болса➡
Dialogue: 0,0:08:52.16,0:08:54.63,Default,,0,0,0,,Неліктен біртұтас ойыншы болдыңыз?
Dialogue: 0,0:08:55.66,0:08:58.17,Default,,0,0,0,,Мен үшін ештеңе өзгерген жоқ➡
Dialogue: 0,0:08:58.17,0:09:00.67,Default,,0,0,0,,Мен жай ғана бақылаушыдан экспрессор болдым.
Dialogue: 0,0:09:00.67,0:09:02.67,Default,,0,0,0,,Экспрессор?
Dialogue: 0,0:09:02.67,0:09:04.67,Default,,0,0,0,,Тыныш қараңғылықты байлау➡
Dialogue: 0,0:09:04.67,0:09:08.68,Default,,0,0,0,,Ол үлкен күшпен тесіп өткен терең қараңғылық жүзіне айналды➡
Dialogue: 0,0:09:08.68,0:09:10.68,Default,,0,0,0,,Мен тек осымын➡
Dialogue: 0,0:09:10.68,0:09:15.18,Default,,0,0,0,,Өз жүрегімде лаулаған зұлматты суреттейтін суретші болдым➡
Dialogue: 0,0:09:15.18,0:09:17.69,Default,,0,0,0,,Ал жаңа қараңғылық тарайды➡
Dialogue: 0,0:09:17.69,0:09:21.66,Default,,0,0,0,,Бұл маған бұрын көрмеген сезім әкелді.
Dialogue: 0,0:09:22.69,0:09:27.20,Default,,0,0,0,,Юйю Күшті болу арқылы әлемді көре аласыз➡
Dialogue: 0,0:09:27.20,0:09:29.16,Default,,0,0,0,,Мен саған көрсетемін.
Dialogue: 0,0:09:30.17,0:09:32.13,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:09:32.13,0:09:34.14,Default,,0,0,0,,Кубисияға бару.
Dialogue: 0,0:09:34.14,0:09:36.64,Default,,0,0,0,,Эрозияға ұшыраған ай сәулесін орнатыңыз.
Dialogue: 0,0:09:36.64,0:09:39.14,Default,,0,0,0,,Көлеңке әскерін шеберлікпен шақыр.
Dialogue: 0,0:09:39.14,0:09:42.64,Default,,0,0,0,,Дүние қара рыцарьға айналады.
Dialogue: 0,0:09:42.64,0:09:46.15,Default,,0,0,0,,Міне! Қара рыцарь келді➡
Dialogue: 0,0:09:46.15,0:09:49.12,Default,,0,0,0,,Тұңғиық түннің қараңғылығы әлемді орап жатыр!
Dialogue: 0,0:09:50.15,0:09:52.15,Default,,0,0,0,,Gründer-ге қоңырау шалыңыз.
Dialogue: 0,0:09:52.15,0:09:54.16,Default,,0,0,0,,Шеберлікпен палубаның жоғарғы 7 картасынан➡
Dialogue: 0,0:09:54.16,0:09:57.66,Default,,0,0,0,,Мәңгілік уақыттан тыс 2 картаны тастаңыз.
Dialogue: 0,0:09:57.66,0:09:59.66,Default,,0,0,0,,Кубадағы шабуыл.
Dialogue: 0,0:09:59.66,0:10:02.16,Default,,0,0,0,,Күзетші жоқ. Грюндермен шабуыл.
Dialogue: 0,0:10:02.16,0:10:05.67,Default,,0,0,0,,Күзетші. Көлеңке армиясымен шабуыл.
Dialogue: 0,0:10:05.67,0:10:07.67,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:10:07.67,0:10:09.67,Default,,0,0,0,,Бұрау➡
Dialogue: 0,0:10:09.67,0:10:14.18,Default,,0,0,0,,Күресуге ерік-жігері болса, кез келген адам мықты бола алады➡
Dialogue: 0,0:10:14.18,0:10:17.18,Default,,0,0,0,,Өз күшіңізге сеніп, жүре беріңіз ➡
Dialogue: 0,0:10:17.18,0:10:20.68,Default,,0,0,0,,Бұл бір орында тұрғаннан әлдеқайда құнды.
Dialogue: 0,0:10:20.68,0:10:24.19,Default,,0,0,0,,Күшті болу – жақсылық екені рас.
Dialogue: 0,0:10:24.19,0:10:26.19,Default,,0,0,0,,Бірақ ол үшін өзіңіз болыңыз➡
Dialogue: 0,0:10:26.19,0:10:28.69,Default,,0,0,0,,Лақтыру керек деу дұрыс емес!
Dialogue: 0,0:10:28.69,0:10:30.63,Default,,0,0,0,,Өзің болу?
Dialogue: 0,0:10:30.63,0:10:33.63,Default,,0,0,0,,Біркелкі киім киетіндер қарсыластарының даралығын мойындамайды➡
Dialogue: 0,0:10:33.63,0:10:36.63,Default,,0,0,0,,Олар бізге өз әдістерін таңып жатыр!
Dialogue: 0,0:10:36.63,0:10:40.13,Default,,0,0,0,,Мен мұны ешқашан құптамас едім!
Dialogue: 0,0:10:40.13,0:10:42.64,Default,,0,0,0,,Бұл қазір сен бе?
Dialogue: 0,0:10:42.64,0:10:46.64,Default,,0,0,0,,Закуса мырза, егер формашылардың күші абсолютті болса➡
Dialogue: 0,0:10:46.64,0:10:48.64,Default,,0,0,0,,Мен одан да күшті боламын!
Dialogue: 0,0:10:48.64,0:10:51.65,Default,,0,0,0,,Ал мен сені міндетті түрде жеңемін➡
Dialogue: 0,0:10:51.65,0:10:54.62,Default,,0,0,0,,Мен сені формашылардан босатамын!
Dialogue: 0,0:10:59.59,0:11:03.53,Default,,0,0,0,,Закуса мырза, мен униформашыларды тоқтатқым келеді➡
Dialogue: 0,0:11:03.53,0:11:05.53,Default,,0,0,0,,Арнайы жаттығулар арқылы шыңдала түстім.
Dialogue: 0,0:11:05.53,0:11:09.03,Default,,0,0,0,,Нәтижелерді осында көрсетемін!
Dialogue: 0,0:11:09.03,0:11:11.03,Default,,0,0,0,,Менің кезегім! ➡
Dialogue: 0,0:11:11.03,0:11:13.54,Default,,0,0,0,,Тенрин Хорю Нирвана Дживаға барыңыз!
Dialogue: 0,0:11:13.54,0:11:17.54,Default,,0,0,0,,Рейлдің шеберлігімен Ранжарды қолыңызға қосыңыз➡
Dialogue: 0,0:11:17.54,0:11:20.04,Default,,0,0,0,,Сонымен қатар, Нирвана Дживаның шеберлігі іске қосылды!
Dialogue: 0,0:11:20.04,0:11:22.04,Default,,0,0,0,,Қолыңыздан бір картаны тастаңыз➡
Dialogue: 0,0:11:22.04,0:11:25.55,Default,,0,0,0,,Трикста мен Брамадаға қоңырау шалыңыз➡
Dialogue: 0,0:11:25.55,0:11:27.55,Default,,0,0,0,,Ранджадты тастап кеткенде➡
Dialogue: 0,0:11:27.55,0:11:30.05,Default,,0,0,0,,Дағды бойынша шақырылады.
Dialogue: 0,0:11:30.05,0:11:32.05,Default,,0,0,0,,Брамверлинаға➡
Dialogue: 0,0:11:32.05,0:11:34.56,Default,,0,0,0,,Кроссовер көйлек!
Dialogue: 0,0:11:34.56,0:11:37.06,Default,,0,0,0,,Брамада шеберлігімен 2 карта салыңыз➡
Dialogue: 0,0:11:37.06,0:11:40.06,Default,,0,0,0,,1 картаны тастаңыз Брам Верлинамен шабуыл!
Dialogue: 0,0:11:40.06,0:11:42.06,Default,,0,0,0,,Күзетші.
Dialogue: 0,0:11:42.06,0:11:45.07,Default,,0,0,0,,Нирвана Зивамен Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:11:45.07,0:11:48.07,Default,,0,0,0,,Брамверлинаны шеберлікпен ұста!
Dialogue: 0,0:11:48.07,0:11:50.57,Default,,0,0,0,,Күзетші. Бірінші тексеру➡
Dialogue: 0,0:11:50.57,0:11:53.58,Default,,0,0,0,,Триггерді сызыңыз! Бір картаны салыңыз➡
Dialogue: 0,0:11:53.58,0:11:56.58,Default,,0,0,0,,Брам Верлинаның күші плюс 10 000!
Dialogue: 0,0:11:56.58,0:11:58.58,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:11:58.58,0:12:01.52,Default,,0,0,0,,Триггерсіз шабуыл Брам Верлина!
Dialogue: 0,0:12:01.52,0:12:03.52,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:12:03.52,0:12:06.02,Default,,0,0,0,,Көлеңкелі армияны шеберлікпен шегіндіріңіз!
Dialogue: 0,0:12:06.02,0:12:08.02,Default,,0,0,0,,Ранджадпен шабуыл!
Dialogue: 0,0:12:08.02,0:12:10.02,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:12:10.02,0:12:11.99,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:12:14.53,0:12:18.00,Default,,0,0,0,,)
Dialogue: 0,0:12:19.53,0:12:22.04,Default,,0,0,0,,Закуса мырза, мен жеңемін!
Dialogue: 0,0:12:22.04,0:12:24.04,Default,,0,0,0,,Оны жеңу арқылы дәлелдеңіз➡
Dialogue: 0,0:12:24.04,0:12:26.01,Default,,0,0,0,,Бұлай істеуге болмайды!
Dialogue: 0,0:12:28.04,0:12:30.04,Default,,0,0,0,,Хаа….
Dialogue: 0,0:12:30.04,0:12:33.05,Default,,0,0,0,,Жарайды, мен саған көрсетемін.
Dialogue: 0,0:12:33.05,0:12:36.55,Default,,0,0,0,,Менің экспрессор ретіндегі күресім.
Dialogue: 0,0:12:36.55,0:12:38.55,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:12:38.55,0:12:40.56,Default,,0,0,0,,Менің кезегім➡
Dialogue: 0,0:12:40.56,0:12:43.06,Default,,0,0,0,,Кардинал Доминус Орфист Региспен жүру.
Dialogue: 0,0:12:43.06,0:12:47.06,Default,,0,0,0,,Дағдылар Drop Eternity жиынтығы.
Dialogue: 0,0:12:47.06,0:12:50.53,Default,,0,0,0,,Дүние тұңғиық қараңғы түнге айналады.
Dialogue: 0,0:12:53.07,0:12:55.04,Default,,0,0,0,,Қараңғылық... аа!
Dialogue: 0,0:13:01.01,0:13:03.01,Default,,0,0,0,,Ух...!
Dialogue: 0,0:13:03.01,0:13:05.98,Default,,0,0,0,,Мен себеп-салдар мен манифестті кесіп тастаймын.
Dialogue: 0,0:13:07.52,0:13:10.52,Default,,0,0,0,,Гидраглум шеберлігінің маскасы құлады➡
Dialogue: 0,0:13:10.52,0:13:14.52,Default,,0,0,0,,Кардинал Морстан Орфист Маскусқа➡
Dialogue: 0,0:13:14.52,0:13:16.99,Default,,0,0,0,,Persona Ride!
Dialogue: 0,0:13:19.03,0:13:22.03,Default,,0,0,0,,Гу...!
Dialogue: 0,0:13:22.03,0:13:24.00,Default,,0,0,0,,Басқа адамның дүкенінің алдында дау шығармаңдар!
Dialogue: 0,0:13:27.04,0:13:32.04,Default,,0,0,0,,Юю Сіздің сенімдеріңіз➡
Dialogue: 0,0:13:32.04,0:13:34.01,Default,,0,0,0,,Қып-қызыл қараңғылық тарқайды.
Dialogue: 0,0:13:35.04,0:13:37.05,Default,,0,0,0,,Айлы айлы түнді орнат.
Dialogue: 0,0:13:37.05,0:13:40.05,Default,,0,0,0,,Orphist Mascus дағдысын белсендіру.
Dialogue: 0,0:13:40.05,0:13:42.55,Default,,0,0,0,,Orphist Regis➡ қоспау арқылы
Dialogue: 0,0:13:42.55,0:13:45.55,Default,,0,0,0,,Тамшының мәңгілігінен тыс орнатыңыз.
Dialogue: 0,0:13:45.55,0:13:47.56,Default,,0,0,0,,Әлемдік тәртіп 4 дана.
Dialogue: 0,0:13:47.56,0:13:50.53,Default,,0,0,0,,Қоңырау шалыңыз Skewed Pain Dragon және Op Art.
Dialogue: 0,0:13:52.06,0:13:54.06,Default,,0,0,0,,Қиғаш ауырсынумен шабуыл.
Dialogue: 0,0:13:54.06,0:13:56.06,Default,,0,0,0,,Дағдыларды белсендіру.
Dialogue: 0,0:13:56.06,0:13:58.57,Default,,0,0,0,,Белгіленген ретпен барлығы 5 бағаға➡
Dialogue: 0,0:13:58.57,0:14:01.00,Default,,0,0,0,,Қарсыласыңыздың тыл қорғаушыларының бірін тастаңыз➡
Dialogue: 0,0:14:01.00,0:14:03.50,Default,,0,0,0,,Меншікті қуат плюс 5000.
Dialogue: 0,0:14:03.50,0:14:06.51,Default,,0,0,0,,Менің тапсырысымның жалпы бағасы 10.
Dialogue: 0,0:14:06.51,0:14:10.51,Default,,0,0,0,,Сондықтан Брамверлина мен Лангард шегінуі керек➡
Dialogue: 0,0:14:10.51,0:14:12.51,Default,,0,0,0,,Қуат плюс 10000.
Dialogue: 0,0:14:12.51,0:14:14.98,Default,,0,0,0,,Ку... күзетші жоқ!
Dialogue: 0,0:14:16.52,0:14:20.02,Default,,0,0,0,,Op Art-тың Gründer күшейтуімен шабуыл.
Dialogue: 0,0:14:20.02,0:14:22.02,Default,,0,0,0,,Күзетші жоқ!
Dialogue: 0,0:14:22.02,0:14:24.03,Default,,0,0,0,,Орфист маскаларымен шабуыл.
Dialogue: 0,0:14:24.03,0:14:26.03,Default,,0,0,0,,Дағдыны белсендіру➡
Dialogue: 0,0:14:26.03,0:14:28.03,Default,,0,0,0,,2 Дүниежүзілік Тапсырысты тастау жолағына орналастыру арқылы➡
Dialogue: 0,0:14:28.03,0:14:32.03,Default,,0,0,0,,Call Drive плюс 2 көлеңкелі армия үшін 1.
Dialogue: 0,0:14:32.03,0:14:34.54,Default,,0,0,0,,Сонымен қатар, «Оп-арт» шеберлігі тамшыға орналастырылған➡
Dialogue: 0,0:14:34.54,0:14:37.04,Default,,0,0,0,,Көлеңке әскерін шақырыңыз. тоғыз!
Dialogue: 0,0:14:37.04,0:14:40.04,Default,,0,0,0,,Мәңгіліктен тыс, екі өнермен➡
Dialogue: 0,0:14:40.04,0:14:42.51,Default,,0,0,0,,Барлық көлеңкелі армияның қуаты плюс 10000.
Dialogue: 0,0:14:44.05,0:14:46.05,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:14:46.05,0:14:48.55,Default,,0,0,0,,Бірінші тексеру.
Dialogue: 0,0:14:48.55,0:14:52.05,Default,,0,0,0,,Екінші тексеру➡
Dialogue: 0,0:14:52.05,0:14:54.06,Default,,0,0,0,,Үшінші тексеру➡
Dialogue: 0,0:14:54.06,0:14:56.06,Default,,0,0,0,,Триггерді тарту 1 картаны тарту➡
Dialogue: 0,0:14:56.06,0:14:58.06,Default,,0,0,0,,Көлеңкелі армияның қуаты +10000.
Dialogue: 0,0:14:58.06,0:15:00.03,Default,,0,0,0,,Көлеңке әскерімен шабуыл.
Dialogue: 0,0:15:00.03,0:15:02.00,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:15:02.00,0:15:04.97,Default,,0,0,0,,Көлеңкелі армияның көлеңкелі армиямен шабуылын күшейту.
Dialogue: 0,0:15:06.50,0:15:08.47,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:15:11.51,0:15:13.47,Default,,0,0,0,,)
Dialogue: 0,0:15:16.51,0:15:19.01,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:15:19.01,0:15:21.02,Default,,0,0,0,,Намазынан айырылған қанаттар➡
Dialogue: 0,0:15:21.02,0:15:23.48,Default,,0,0,0,,Бұл жай ғана күйреуге арналған.
Dialogue: 0,0:15:24.52,0:15:26.52,Default,,0,0,0,,Сіз тырыспайынша ешқашан білмейсіз!
Dialogue: 0,0:15:26.52,0:15:28.52,Default,,0,0,0,,Менің кезегім!
Dialogue: 0,0:15:28.52,0:15:30.53,Default,,0,0,0,,Persona Ride!
Dialogue: 0,0:15:30.53,0:15:32.53,Default,,0,0,0,,Нирвана Джива!
Dialogue: 0,0:15:32.53,0:15:35.53,Default,,0,0,0,,Трикста мен Брахмаданы тамшыдан шеберлікпен шақыр.
Dialogue: 0,0:15:35.53,0:15:37.53,Default,,0,0,0,,Триста! ➡
Dialogue: 0,0:15:37.53,0:15:40.54,Default,,0,0,0,,Миразверлинаның киімінде!
Dialogue: 0,0:15:40.54,0:15:42.54,Default,,0,0,0,,Кроссовер➡
Dialogue: 0,0:15:42.54,0:15:44.51,Default,,0,0,0,,Киініңіз!
Dialogue: 0,0:15:47.54,0:15:49.51,Default,,0,0,0,,Закуса мырза, есіңізде болсын!
Dialogue: 0,0:15:51.05,0:15:53.51,Default,,0,0,0,,Өзіңізбен күресіңіз.
Dialogue: 0,0:15:55.55,0:15:58.55,Default,,0,0,0,,Брамада шеберлігін пайдаланып 2 картаны салып, 1 картаны тастаңыз➡
Dialogue: 0,0:15:58.55,0:16:00.99,Default,,0,0,0,,Сонымен қатар, Миразверлинаның шеберлігімен➡
Dialogue: 0,0:16:00.99,0:16:03.49,Default,,0,0,0,,Көйлек көзі ретінде тамшыдан 2 бөлікті пайдаланыңыз!
Dialogue: 0,0:16:03.49,0:16:08.00,Default,,0,0,0,,Верлина Валиентемен бірге Трикстаның киімін киюді жалғастырыңыз!
Dialogue: 0,0:16:08.00,0:16:11.50,Default,,0,0,0,,Трикста мен Фларевильге де қоңырау шалыңыз!
Dialogue: 0,0:16:11.50,0:16:13.50,Default,,0,0,0,,Flare Veil Boost➡
Dialogue: 0,0:16:13.50,0:16:15.50,Default,,0,0,0,,Миразверлинамен шабуыл!
Dialogue: 0,0:16:15.50,0:16:17.51,Default,,0,0,0,,１
Dialogue: 0,0:16:17.51,0:16:19.51,Default,,0,0,0,,Күзетші.
Dialogue: 0,0:16:19.51,0:16:21.51,Default,,0,0,0,,Нирвана Дживамен шабуыл➡
Dialogue: 0,0:16:21.51,0:16:24.01,Default,,0,0,0,,Миразверлинаны шеберлікпен тұр!
Dialogue: 0,0:16:24.01,0:16:26.01,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:16:26.01,0:16:28.02,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:16:28.02,0:16:30.52,Default,,0,0,0,,Триггер жоқ…Екінші тексеру➡
Dialogue: 0,0:16:30.52,0:16:32.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:32.52,0:16:34.52,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:16:34.52,0:16:37.02,Default,,0,0,0,,Миразверлинаның күші плюс 10 000!
Dialogue: 0,0:16:37.02,0:16:39.03,Default,,0,0,0,,Нирвана Дживаның сыни плюс 1!
Dialogue: 0,0:16:39.03,0:16:41.50,Default,,0,0,0,,Зақымдануды тексеру 1 пункт.
Dialogue: 0,0:16:43.03,0:16:45.00,Default,,0,0,0,,Екінші тармақ….
Dialogue: 0,0:16:47.54,0:16:49.50,Default,,0,0,0,,Закуса мырза...
Dialogue: 0,0:16:50.54,0:16:52.54,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:16:52.54,0:16:55.51,Default,,0,0,0,,Миразверлинамен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:16:56.54,0:16:58.51,Default,,0,0,0,,１
Dialogue: 0,0:17:03.55,0:17:07.56,Default,,0,0,0,,Нағыз жарық қараңғылықты басып, көлеңкелерді жеңеді!
Dialogue: 0,0:17:07.56,0:17:11.03,Default,,0,0,0,,Закуса мырза, мен сізді босатамын!
Dialogue: 0,0:17:27.58,0:17:30.08,Default,,0,0,0,,Толық күзет.
Dialogue: 0,0:17:30.08,0:17:33.08,Default,,0,0,0,,Жоқ... Ку!
Dialogue: 0,0:17:33.08,0:17:35.58,Default,,0,0,0,,Trixta Boost➡
Dialogue: 0,0:17:35.58,0:17:38.55,Default,,0,0,0,,Верлина Валиентемен бірге Авангардқа шабуыл жасаңыз!
Dialogue: 0,0:17:40.59,0:17:42.59,Default,,0,0,0,,Күзетші.
Dialogue: 0,0:17:42.59,0:17:44.59,Default,,0,0,0,,U….
Dialogue: 0,0:17:44.59,0:17:47.09,Default,,0,0,0,,Бұрылу...аяқтау.
Dialogue: 0,0:17:47.09,0:17:50.60,Default,,0,0,0,,Өйткені, дұғасынан айырылған қанаттар нәзік болатын.
Dialogue: 0,0:17:50.60,0:17:52.60,Default,,0,0,0,,Мен➡
Dialogue: 0,0:17:52.60,0:17:55.07,Default,,0,0,0,,Мен Закуса-санды құтқаруым керек!
Dialogue: 0,0:17:56.10,0:17:58.11,Default,,0,0,0,,Бұл менмендік.
Dialogue: 0,0:17:58.11,0:18:00.07,Default,,0,0,0,,Е...? Міне бітті.
Dialogue: 0,0:18:00.07,0:18:02.04,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:02.04,0:18:04.55,Default,,0,0,0,,Соңының суретін сал.
Dialogue: 0,0:18:04.55,0:18:06.55,Default,,0,0,0,,Менің кезегім.
Dialogue: 0,0:18:06.55,0:18:08.55,Default,,0,0,0,,Фу….
Dialogue: 0,0:18:08.55,0:18:10.55,Default,,0,0,0,,Барбизонды шақырыңыз.
Dialogue: 0,0:18:10.55,0:18:13.55,Default,,0,0,0,,Ku! Көлеңке армиясымен шабуыл.
Dialogue: 0,0:18:13.55,0:18:15.56,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:18:15.56,0:18:19.56,Default,,0,0,0,,Orphist Mascus көмегімен Barbisonde Boost Attack.
Dialogue: 0,0:18:19.56,0:18:22.06,Default,,0,0,0,,Дағдыны белсендіру➡
Dialogue: 0,0:18:22.06,0:18:24.07,Default,,0,0,0,,2 Дүниежүзілік Тапсырысты тастау жолағына орналастыру арқылы➡
Dialogue: 0,0:18:24.07,0:18:28.54,Default,,0,0,0,,2 көлеңкелі армияны шақырып, плюс 1-ді жүргізіңіз.
Dialogue: 0,0:18:31.57,0:18:34.08,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:18:34.08,0:18:36.08,Default,,0,0,0,,Қараңғылық➡
Dialogue: 0,0:18:36.08,0:18:38.08,Default,,0,0,0,,Күн ашық...
Dialogue: 0,0:18:38.08,0:18:40.58,Default,,0,0,0,,Нәзік қараңғылық таң атқан.
Dialogue: 0,0:18:40.58,0:18:44.05,Default,,0,0,0,,Алда не күтіп тұр – азапты шындық.
Dialogue: 0,0:18:45.59,0:18:47.56,Default,,0,0,0,,Күзетші!
Dialogue: 0,0:18:49.09,0:18:51.09,Default,,0,0,0,,Бірінші тексеру➡
Dialogue: 0,0:18:51.09,0:18:55.10,Default,,0,0,0,,Екінші тексеру триггері жоқ➡
Dialogue: 0,0:18:55.10,0:19:00.07,Default,,0,0,0,,Үшінші тексеру триггері жоқ➡
Dialogue: 0,0:19:00.07,0:19:02.04,Default,,0,0,0,,Алдыңғы триггер➡
Dialogue: 0,0:19:02.04,0:19:04.51,Default,,0,0,0,,Алдыңғы қатардағы қуат плюс 10 000.
Dialogue: 0,0:19:08.04,0:19:11.51,Default,,0,0,0,,Зақымдануды тексеру….
Dialogue: 0,0:19:14.05,0:19:17.05,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:19:17.05,0:19:19.02,Default,,0,0,0,,Жоқ…триггер.
Dialogue: 0,0:19:23.56,0:19:27.56,Default,,0,0,0,,Жеңімпаз! Широган~!
Dialogue: 0,0:19:27.56,0:19:30.56,Default,,0,0,0,,Күшті! Барлық турнирлерді сыпырып алыңыз➡
Dialogue: 0,0:19:30.56,0:19:33.57,Default,,0,0,0,,Титулдың иесі ақымақ емес еді!
Dialogue: 0,0:19:33.57,0:19:35.54,Default,,0,0,0,,Юйю мырза….
Dialogue: 0,0:19:38.07,0:19:40.04,Default,,0,0,0,,Юю.
Dialogue: 0,0:19:41.08,0:19:43.08,Default,,0,0,0,,Күшті болдың➡
Dialogue: 0,0:19:43.08,0:19:45.08,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:19:45.08,0:19:47.08,Default,,0,0,0,,Қазіргідей шынымен жақсы ма?
Dialogue: 0,0:19:47.08,0:19:50.58,Default,,0,0,0,,Мен мүлдем➡
Dialogue: 0,0:19:50.58,0:19:53.05,Default,,0,0,0,,Мен жеңілмеуім керек еді...
Dialogue: 0,0:19:59.09,0:20:02.03,Default,,0,0,0,,((Мен күштірек болсам...
Dialogue: 0,0:20:02.03,0:20:04.50,Default,,0,0,0,,Толығырақ...! ))
Dialogue: 0,0:20:05.53,0:20:08.04,Default,,0,0,0,,((Өшіру қабылданбайды➡
Dialogue: 0,0:20:08.04,0:20:10.04,Default,,0,0,0,,Кез келген түс қабылданады.
Dialogue: 0,0:20:10.04,0:20:12.54,Default,,0,0,0,,Әртүрлі түстер араласады➡
Dialogue: 0,0:20:12.54,0:20:15.54,Default,,0,0,0,,Сізді нәзік қараңғылық орап алады. ))
Dialogue: 0,0:20:15.54,0:20:19.05,Default,,0,0,0,,((Иә, мен де осылай сөнгендерді жақсы көремін➡
Dialogue: 0,0:20:19.05,0:20:21.05,Default,,0,0,0,,Мен оны қорғағым келді.
Dialogue: 0,0:20:21.05,0:20:23.55,Default,,0,0,0,,Бірақ... )) ((Индивидуалдылық?➡
Dialogue: 0,0:20:23.55,0:20:26.05,Default,,0,0,0,,Тек өзіңіз үшін күресесіз бе? Болды➡
Dialogue: 0,0:20:26.05,0:20:29.56,Default,,0,0,0,,Жеңіске жете алмайтыныңды жасыру үшін сылтау, солай ма? ))
Dialogue: 0,0:20:29.56,0:20:33.06,Default,,0,0,0,,((Мен униформашылардан күштерімен жеңілдім➡
Dialogue: 0,0:20:33.06,0:20:35.03,Default,,0,0,0,,Мен мұны кешіре алмаймын... ))
Dialogue: 0,0:20:37.06,0:20:40.07,Default,,0,0,0,,Сондықтан Данжи мырзадан арнайы дайындық сұрадым➡
Dialogue: 0,0:20:40.07,0:20:42.07,Default,,0,0,0,,Мен күштірек болуға тырыстым.
Dialogue: 0,0:20:42.07,0:20:44.57,Default,,0,0,0,,Біркелкілерден күштірек болу➡
Dialogue: 0,0:20:44.57,0:20:46.57,Default,,0,0,0,,Мен жеңдім және дәлелдедім...
Dialogue: 0,0:20:46.57,0:20:49.58,Default,,0,0,0,,) E?
Dialogue: 0,0:20:49.58,0:20:51.58,Default,,0,0,0,,((Күшті болған жақсы➡
Dialogue: 0,0:20:51.58,0:20:54.58,Default,,0,0,0,,Бірақ мен сол себепті даралығымнан бас тартуым керек деп ойламаймын➡
Dialogue: 0,0:20:54.58,0:20:56.58,Default,,0,0,0,,Дұрыс емес!
Dialogue: 0,0:20:56.58,0:20:59.59,Default,,0,0,0,,Мен мұны ешқашан құптамас едім! ))
Dialogue: 0,0:20:59.59,0:21:02.52,Default,,0,0,0,,Күшіңізден құлағаныңыз үшін➡
Dialogue: 0,0:21:02.52,0:21:05.03,Default,,0,0,0,,Оны күшпен бұрауға тырысу➡
Dialogue: 0,0:21:05.03,0:21:07.53,Default,,0,0,0,,Бұл жай ғана...
Dialogue: 0,0:21:07.53,0:21:10.50,Default,,0,0,0,,Uniformers сияқты….
Dialogue: 0,0:21:21.04,0:21:23.01,Default,,0,0,0,,Юю.
Dialogue: 0,0:21:24.04,0:21:27.52,Default,,0,0,0,,A…. Бұл Данжи маған сеніп тапсырған карта.
Dialogue: 0,0:21:28.55,0:21:31.05,Default,,0,0,0,,Жүз тазартылған болат➡
Dialogue: 0,0:21:31.05,0:21:33.52,Default,,0,0,0,,Енді сіз оны алуға құқылысыз.
