Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.14,0:00:10.11,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:00:12.14,0:00:14.14,Default,,0,0,0,,Қайырлы таң➡
Dialogue: 0,0:00:14.14,0:00:16.11,Default,,0,0,0,,Жігіт.
Dialogue: 0,0:00:17.65,0:00:20.15,Default,,0,0,0,,G...i➡
Dialogue: 0,0:00:20.15,0:00:24.15,Default,,0,0,0,,Бұл менің атым ба?
Dialogue: 0,0:00:24.15,0:00:27.16,Default,,0,0,0,,Иә! Бұл сіздің атыңыз.
Dialogue: 0,0:00:27.16,0:00:29.16,Default,,0,0,0,,Жігіт, бір күні саған➡
Dialogue: 0,0:00:29.16,0:00:32.16,Default,,0,0,0,,Бұл әлемді жақсы жаққа бағыттаңыз➡
Dialogue: 0,0:00:32.16,0:00:34.66,Default,,0,0,0,,Мен сенің көшбасшы болғаныңды қалаймын.
Dialogue: 0,0:00:34.66,0:00:37.17,Default,,0,0,0,,Көшбасшы? ➡
Dialogue: 0,0:00:37.17,0:00:42.17,Default,,0,0,0,,Әлемді қалай басқаруға болады...
Dialogue: 0,0:00:42.17,0:00:44.67,Default,,0,0,0,,Прецедент жоқ➡
Dialogue: 0,0:00:44.67,0:00:47.68,Default,,0,0,0,,Сіз...тек сіздің қолыңыздан келетіндей➡
Dialogue: 0,0:00:47.68,0:00:50.15,Default,,0,0,0,,Біз бұл әлемді өзгертеміз.
Dialogue: 0,0:00:51.68,0:00:54.15,Default,,0,0,0,,Тек мен үшін...
Dialogue: 0,0:00:56.18,0:00:58.15,Default,,0,0,0,,Мен алмаймын.
Dialogue: 0,0:01:11.13,0:01:14.64,Default,,0,0,0,,((Бүгін де бір жерде біреудің күлкісі өшіп қалды➡
Dialogue: 0,0:01:14.64,0:01:18.14,Default,,0,0,0,,Көңілі қалып, азап шегу➡
Dialogue: 0,0:01:18.14,0:01:20.64,Default,,0,0,0,,Дүние қызық.
Dialogue: 0,0:01:20.64,0:01:24.15,Default,,0,0,0,,Сол үшін Шыңги мені жасады.
Dialogue: 0,0:01:24.15,0:01:27.15,Default,,0,0,0,,Өзі жақсы көретін карта ойынын пайдалану➡
Dialogue: 0,0:01:27.15,0:01:30.12,Default,,0,0,0,,Мен бұл әлемге жол көрсетуім керек. ))
Dialogue: 0,0:01:34.16,0:01:37.16,Default,,0,0,0,,Бұрын ешкім көрмеген әлемге➡
Dialogue: 0,0:01:37.16,0:01:40.66,Default,,0,0,0,,Мен барлығын өзіммен бірге алып кетемін.
Dialogue: 0,0:01:40.66,0:01:43.67,Default,,0,0,0,,Бұл сіздің міндетіңіз бе?
Dialogue: 0,0:01:43.67,0:01:46.67,Default,,0,0,0,,Мен➡
Dialogue: 0,0:01:46.67,0:01:49.17,Default,,0,0,0,,Менің ғана қолымнан келетіндей➡
Dialogue: 0,0:01:49.17,0:01:52.14,Default,,0,0,0,,Осы дүниеде көшбасшы бол.
Dialogue: 0,0:02:05.12,0:02:07.12,Default,,0,0,0,,Жоқ, біздің мектептің оқушысы➡
Dialogue: 0,0:02:07.12,0:02:09.12,Default,,0,0,0,,Қандай бір-екі мәре! ➡
Dialogue: 0,0:02:09.12,0:02:12.13,Default,,0,0,0,,Екеуің әлі де бір-біріңді қарсылас санайсыңдар ма?
Dialogue: 0,0:02:12.13,0:02:16.63,Default,,0,0,0,,Жарайды...Мен Лейка-санды➡ құрметтеймін
Dialogue: 0,0:02:16.63,0:02:20.14,Default,,0,0,0,,Мен ешқашан жеңілгісі келмейтін күрескерлердің бірімін...!
Dialogue: 0,0:02:20.14,0:02:22.14,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:02:22.14,0:02:25.64,Default,,0,0,0,,Бұл керемет! Leica Kitsuneshiba ше?
Dialogue: 0,0:02:25.64,0:02:27.64,Default,,0,0,0,,Дұрыс➡
Dialogue: 0,0:02:27.64,0:02:31.08,Default,,0,0,0,,Әрине, мен Кондо мырзаны лайықты қарсылас ретінде танимын➡
Dialogue: 0,0:02:31.08,0:02:35.08,Default,,0,0,0,,Дегенмен, қазір мен көп арнайы дайындық жинадым ➡
Dialogue: 0,0:02:35.08,0:02:38.09,Default,,0,0,0,,Осы жолы жеңілмейтініміз үшін соғыс жариялайық.
Dialogue: 0,0:02:38.09,0:02:40.59,Default,,0,0,0,,Мен...Мен де жеңілмеймін!
Dialogue: 0,0:02:40.59,0:02:43.59,Default,,0,0,0,,Хехе... бұл тамаша қарым-қатынас.
Dialogue: 0,0:02:43.59,0:02:46.60,Default,,0,0,0,,Арнайы дайындықтан өтіп жатқаныңызды жоғарыда айттыңыз➡
Dialogue: 0,0:02:46.60,0:02:48.60,Default,,0,0,0,,Сіз қандай жаттығу жасайсыз?
Dialogue: 0,0:02:48.60,0:02:53.10,Default,,0,0,0,,Мүмкін бұл күндері Uniformers бағдарламасы танымал шығар?
Dialogue: 0,0:02:53.10,0:02:55.10,Default,,0,0,0,,Ах...!
Dialogue: 0,0:02:55.10,0:02:58.11,Default,,0,0,0,,Екеуіңіздің Uniformers➡ туралы не ойлайтыныңызды білгім келеді
Dialogue: 0,0:02:58.11,0:03:00.08,Default,,0,0,0,,Мен сізге сұрақ қойғым келеді...
Dialogue: 0,0:03:01.11,0:03:03.11,Default,,0,0,0,,((Uniformers.
Dialogue: 0,0:03:03.11,0:03:06.11,Default,,0,0,0,,Атын қазір барлығы біледі.
Dialogue: 0,0:03:06.11,0:03:08.62,Default,,0,0,0,,Біз Жапонияға оралғаннан кейін бірнеше аптадан кейін➡
Dialogue: 0,0:03:08.62,0:03:12.12,Default,,0,0,0,,Uni App➡ деп аталатын жауынгерлік жаттығу қолданбасы бар
Dialogue: 0,0:03:12.12,0:03:14.59,Default,,0,0,0,,Ол өте танымал болды.
Dialogue: 0,0:03:16.63,0:03:19.63,Default,,0,0,0,,Тіркелгеннен кейін сізге жіберілген құрылғыны тіркеңіз➡
Dialogue: 0,0:03:19.63,0:03:22.63,Default,,0,0,0,,Қолданбадағы бәсекеге қабілетті AI ➡
Dialogue: 0,0:03:22.63,0:03:25.13,Default,,0,0,0,,Карточка төбелестерін қайта-қайта қайталау арқылы➡
Dialogue: 0,0:03:25.13,0:03:28.64,Default,,0,0,0,,Біртұтас киім киетін мекемеде өтетін жаттығу бағдарламасы ➡
Dialogue: 0,0:03:28.64,0:03:32.07,Default,,0,0,0,,Дәл осындай әсер алуға болады.
Dialogue: 0,0:03:32.07,0:03:34.58,Default,,0,0,0,,Және... ))
Dialogue: 0,0:03:34.58,0:03:38.58,Default,,0,0,0,,Құттықтаймыз, сіз форма бойынша біліктілікке ие болдыңыз.
Dialogue: 0,0:03:38.58,0:03:41.58,Default,,0,0,0,,((Қабілеттің мәні өту сызығын кесіп өткенде➡
Dialogue: 0,0:03:41.58,0:03:44.09,Default,,0,0,0,,Пайдаланушы бірыңғай форма➡ ретінде танылады
Dialogue: 0,0:03:44.09,0:03:49.09,Default,,0,0,0,,Олар ерекше жең мен маска палубасын алады.
Dialogue: 0,0:03:49.09,0:03:52.56,Default,,0,0,0,,Олар өздерін ресми түрде Uniformers деп атауға рұқсат етілген. ))
Dialogue: 0,0:03:54.60,0:03:57.10,Default,,0,0,0,,Uniappli пайдаланушылары іс жүзінде өз дағдыларын жақсартады➡
Dialogue: 0,0:03:57.10,0:04:00.10,Default,,0,0,0,,Біз керемет нәтижелерге қол жеткізіп жатырмыз.
Dialogue: 0,0:04:00.10,0:04:02.60,Default,,0,0,0,,Біркелкілер енді әлеуметтік құбылыс➡
Dialogue: 0,0:04:02.60,0:04:04.61,Default,,0,0,0,,Екеуің қалай ойлайсыңдар?
Dialogue: 0,0:04:04.61,0:04:08.11,Default,,0,0,0,,Мен... Әрине біркелкілер➡
Dialogue: 0,0:04:08.11,0:04:10.11,Default,,0,0,0,,Нәтижелер қалды.
Dialogue: 0,0:04:10.11,0:04:12.61,Default,,0,0,0,,Бірақ мен мұны өз жолыммен істеймін➡
Dialogue: 0,0:04:12.61,0:04:16.62,Default,,0,0,0,,Мен сізге униформашыларды жеңбейтін карта күресін көрсетемін.
Dialogue: 0,0:04:16.62,0:04:21.62,Default,,0,0,0,,Сол себепті біз қазір оларды жан-жақты зерттеп жатырмыз.
Dialogue: 0,0:04:21.62,0:04:25.13,Default,,0,0,0,,Мен Лайка сияқты сезінемін.
Dialogue: 0,0:04:25.13,0:04:27.63,Default,,0,0,0,,Біркелкі киім киетіндерге қарсы.
Dialogue: 0,0:04:27.63,0:04:29.63,Default,,0,0,0,,Оларға жарты жыл ғана уақыт кетті➡
Dialogue: 0,0:04:29.63,0:04:32.57,Default,,0,0,0,,Тіпті Авангардтың табиғаты да өзгеретін болды.
Dialogue: 0,0:04:32.57,0:04:34.57,Default,,0,0,0,,Бұл да...
Dialogue: 0,0:04:34.57,0:04:37.57,Default,,0,0,0,,Бір ғана жауынгердің арқасында.
Dialogue: 0,0:04:37.57,0:04:40.58,Default,,0,0,0,,Көптеген турнирлерде күшті жауынгерлерді жеңді➡
Dialogue: 0,0:04:40.58,0:04:44.08,Default,,0,0,0,,Жеңімпазды ұрлап әкетеді, бірақ оның шын тұлғасын ешкім білмейді! ➡
Dialogue: 0,0:04:44.08,0:04:46.08,Default,,0,0,0,,Бірыңғай Широган!
Dialogue: 0,0:04:46.08,0:04:58.06,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:04:59.59,0:05:02.10,Default,,0,0,0,,Урара-сан! а….
Dialogue: 0,0:05:02.10,0:05:04.10,Default,,0,0,0,,Юйю-сан!
Dialogue: 0,0:05:04.10,0:05:06.57,Default,,0,0,0,,Және Лейка!
Dialogue: 0,0:05:09.60,0:05:12.61,Default,,0,0,0,,Юйю-сан, сен осылай Ғажайып төбеге барасың ба?
Dialogue: 0,0:05:12.61,0:05:14.61,Default,,0,0,0,,Un➡
Dialogue: 0,0:05:14.61,0:05:16.61,Default,,0,0,0,,Урара-сан Райка-санмен жаттығады...
Dialogue: 0,0:05:16.61,0:05:20.62,Default,,0,0,0,,Шынайы ма? Жақында формашы болмайсың ба?
Dialogue: 0,0:05:20.62,0:05:22.62,Default,,0,0,0,,Ах! Жеңіс көрсеткіші өсті➡
Dialogue: 0,0:05:22.62,0:05:25.12,Default,,0,0,0,,3-кезең жақында!
Dialogue: 0,0:05:25.12,0:05:29.12,Default,,0,0,0,,Бұрынғы сұхбатта жақсы айта алмадым➡
Dialogue: 0,0:05:29.12,0:05:32.06,Default,,0,0,0,,Түрлі адам, неше түрлі ұрыс.
Dialogue: 0,0:05:32.06,0:05:35.06,Default,,0,0,0,,Сондықтан карта төбелестері қызықты.
Dialogue: 0,0:05:35.06,0:05:39.57,Default,,0,0,0,,Мен де униформашыларға жеңілмейтін картамен жекпе-жек өткізгім келеді.
Dialogue: 0,0:05:39.57,0:05:43.07,Default,,0,0,0,,Олардың қандай шайқас болғаны маңызды емес.
Dialogue: 0,0:05:43.07,0:05:46.07,Default,,0,0,0,,Бірақ...Мичиру-сан...
Dialogue: 0,0:05:46.07,0:05:49.58,Default,,0,0,0,,Біз енді одан аса алмаймыз деді.
Dialogue: 0,0:05:49.58,0:05:53.08,Default,,0,0,0,,Сондықтан біз одан асып түсуіміз керек➡
Dialogue: 0,0:05:53.08,0:05:55.08,Default,,0,0,0,,Біркелкі киімдер.
Dialogue: 0,0:05:55.08,0:05:57.09,Default,,0,0,0,,Мен➡
Dialogue: 0,0:05:57.09,0:06:00.59,Default,,0,0,0,,Мен Харона менің карточкалық төбелесімді мақұлдағанын қалаймын.
Dialogue: 0,0:06:00.59,0:06:02.59,Default,,0,0,0,,Менің жеке күресім арқылы➡
Dialogue: 0,0:06:02.59,0:06:05.56,Default,,0,0,0,,Мен бұл жолы дұрыс дос болғым келеді!
Dialogue: 0,0:06:08.10,0:06:10.60,Default,,0,0,0,,Әркім әртүрлі.
Dialogue: 0,0:06:10.60,0:06:13.07,Default,,0,0,0,,Бұл бізді ерекше етеді. Уау!
Dialogue: 0,0:06:14.60,0:06:17.07,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:06:23.11,0:06:26.11,Default,,0,0,0,,Сәлем, Юю Кондо➡
Dialogue: 0,0:06:26.11,0:06:29.62,Default,,0,0,0,,Райка Китсунешиба Урара Ханеяма.
Dialogue: 0,0:06:29.62,0:06:32.55,Default,,0,0,0,,Джинки мырза...
Dialogue: 0,0:06:32.55,0:06:35.06,Default,,0,0,0,,Енді күресейік. жұмысшы?
Dialogue: 0,0:06:35.06,0:06:38.56,Default,,0,0,0,,Deluxe➡-де ең күшті жекпе-жек жеңді
Dialogue: 0,0:06:38.56,0:06:41.06,Default,,0,0,0,,Маған сезінуге рұқсат етіңіз.
Dialogue: 0,0:06:41.06,0:06:43.57,Default,,0,0,0,,Бас тартуға ешқандай себеп жоқ!
Dialogue: 0,0:06:43.57,0:06:46.03,Default,,0,0,0,,Фу… Керемет!
Dialogue: 0,0:06:49.57,0:06:51.57,Default,,0,0,0,,Сіз жасаған телефон қоңырауы➡
Dialogue: 0,0:06:51.57,0:06:54.08,Default,,0,0,0,,Сіз қазір сигнал қабылдамайтын жердесіз бе?➡
Dialogue: 0,0:06:54.08,0:06:57.08,Default,,0,0,0,,Қуат қосылмағандықтан... (Телефонның ілулі тұрған дыбысы)
Dialogue: 0,0:06:57.08,0:06:59.08,Default,,0,0,0,,Идиот Аники➡
Dialogue: 0,0:06:59.08,0:07:01.08,Default,,0,0,0,,Бүгін тіпті Томари де жоқ.
Dialogue: 0,0:07:01.08,0:07:03.59,Default,,0,0,0,,Юю, қолыңнан келгеннің бәрін жаса! Жоғалтпа!
Dialogue: 0,0:07:03.59,0:07:06.09,Default,,0,0,0,,Жекпе-жек!
Dialogue: 0,0:07:06.09,0:07:08.09,Default,,0,0,0,,Юйю-сан…. а….
Dialogue: 0,0:07:08.09,0:07:11.06,Default,,0,0,0,,Юю-санның жақсы болатынына сенімдімін, солай ма?
Dialogue: 0,0:07:16.10,0:07:18.07,Default,,0,0,0,,Бір ғана нәрсе істеу керек.
Dialogue: 0,0:07:20.10,0:07:23.10,Default,,0,0,0,,Мен әрқашан Жігіттен➡ нұсқау алдым
Dialogue: 0,0:07:23.10,0:07:26.11,Default,,0,0,0,,Біз картамен төбелесіп жатыр едік. жұмысшы?
Dialogue: 0,0:07:26.11,0:07:28.61,Default,,0,0,0,,Бірақ бүгінгі күн сәл ерекше➡
Dialogue: 0,0:07:28.61,0:07:33.05,Default,,0,0,0,,Дәл осы жолы мен бәрін тапсырамын➡
Dialogue: 0,0:07:33.05,0:07:35.52,Default,,0,0,0,,Келіңіздер! Шоу уақыты.
Dialogue: 0,0:07:37.05,0:07:39.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:39.05,0:07:42.56,Default,,0,0,0,,E? Ах... бұл!
Dialogue: 0,0:07:42.56,0:07:45.03,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:07:46.56,0:07:48.56,Default,,0,0,0,,Сәлем! ➡
Dialogue: 0,0:07:48.56,0:07:50.57,Default,,0,0,0,,Сәлеметсіз бе. а...!
Dialogue: 0,0:07:50.57,0:07:53.07,Default,,0,0,0,,Менің атым Жігіт➡
Dialogue: 0,0:07:53.07,0:07:56.57,Default,,0,0,0,,Осы құлаққаптар арқылы мен Джинкидің денесін уақытша алып жатырмын.
Dialogue: 0,0:07:56.57,0:07:59.57,Default,,0,0,0,,Бұл... сен бе?
Dialogue: 0,0:07:59.57,0:08:03.08,Default,,0,0,0,,Бірден ұрысайық, Юю Кондо➡
Dialogue: 0,0:08:03.08,0:08:06.08,Default,,0,0,0,,Сізбен, люкс жеңімпазы - бұл➡
Dialogue: 0,0:08:06.08,0:08:09.58,Default,,0,0,0,,Uniformers бағдарламасындағы қажетті қадамдар ➡
Dialogue: 0,0:08:09.58,0:08:12.59,Default,,0,0,0,,Күшті деп есептелетін сізді жеңу арқылы➡
Dialogue: 0,0:08:12.59,0:08:16.09,Default,,0,0,0,,Біркелкі ойыншылар соңғы шайқасқа жақындап келеді.
Dialogue: 0,0:08:16.09,0:08:19.09,Default,,0,0,0,,Менің сізден сұрайын дегенім көп!
Dialogue: 0,0:08:19.09,0:08:22.10,Default,,0,0,0,,Жекпе-жекке ұрайын!
Dialogue: 0,0:08:22.10,0:08:24.10,Default,,0,0,0,,Жақсы! ➡
Dialogue: 0,0:08:24.10,0:08:26.07,Default,,0,0,0,,Олай болса... бастайық!
Dialogue: 0,0:08:32.61,0:08:35.11,Default,,0,0,0,,Авангард тұр!
Dialogue: 0,0:08:35.11,0:08:37.11,Default,,0,0,0,,Тосын жұмыртқа.
Dialogue: 0,0:08:37.11,0:08:39.11,Default,,0,0,0,,Глифосид.
Dialogue: 0,0:08:39.11,0:08:41.12,Default,,0,0,0,,Бұрылысты аяқтау үшін Реноға барыңыз.
Dialogue: 0,0:08:41.12,0:08:44.12,Default,,0,0,0,,Менің кезегім мен мінбеймін➡
Dialogue: 0,0:08:44.12,0:08:47.12,Default,,0,0,0,,Негізгі фазаның басында глифосид дағдыларын белсендіру➡
Dialogue: 0,0:08:47.12,0:08:50.59,Default,,0,0,0,,Аттракционнан, соңының басын жаныңа сал.
Dialogue: 0,0:08:52.63,0:08:54.63,Default,,0,0,0,,((Мен шынымен де мінбеймін.
Dialogue: 0,0:08:54.63,0:08:56.63,Default,,0,0,0,,Тура Урара-сан айтқандай. ))
Dialogue: 0,0:08:56.63,0:08:59.63,Default,,0,0,0,,Глифосидпен шабуыл. Күзет жоқ!
Dialogue: 0,0:08:59.63,0:09:01.57,Default,,0,0,0,,Драйверді тексеру➡
Dialogue: 0,0:09:01.57,0:09:03.57,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:09:03.57,0:09:06.57,Default,,0,0,0,,Зақымдануды тексеру. Соңына бұрылу.
Dialogue: 0,0:09:06.57,0:09:09.08,Default,,0,0,0,,Сізден бірдеңе сұрасам болады ма? не?
Dialogue: 0,0:09:09.08,0:09:12.58,Default,,0,0,0,,Сіз Uniformers жасадыңыз, солай ма?
Dialogue: 0,0:09:12.58,0:09:14.58,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:14.58,0:09:16.58,Default,,0,0,0,,Жекелікті алып тастайтын тәжірибе әдістері де бар.
Dialogue: 0,0:09:16.58,0:09:19.59,Default,,0,0,0,,Әрине! Мен бәрін ойладым➡
Dialogue: 0,0:09:19.59,0:09:21.59,Default,,0,0,0,,Керемет емес пе?
Dialogue: 0,0:09:21.59,0:09:25.59,Default,,0,0,0,,Неліктен Мичирумен мұндай нәрсе болды?
Dialogue: 0,0:09:25.59,0:09:27.60,Default,,0,0,0,,Бұл сен кінәлі ме?
Dialogue: 0,0:09:27.60,0:09:29.60,Default,,0,0,0,,Жоқ! ➡
Dialogue: 0,0:09:29.60,0:09:33.60,Default,,0,0,0,,Егер бұл орын алмаса, біз әлі де деректерді жинай берер едік➡
Dialogue: 0,0:09:33.60,0:09:36.60,Default,,0,0,0,,Менің кеңесімді елемегені үшін өзі кінәлі! ➡
Dialogue: 0,0:09:36.60,0:09:38.61,Default,,0,0,0,,Менің де көңілім қалды.
Dialogue: 0,0:09:38.61,0:09:41.11,Default,,0,0,0,,Ой...!
Dialogue: 0,0:09:41.11,0:09:43.11,Default,,0,0,0,,Жанып жатыр! Юю-чан.
Dialogue: 0,0:09:43.11,0:09:45.61,Default,,0,0,0,,Жігіт! Іске сәт.
Dialogue: 0,0:09:45.61,0:09:50.12,Default,,0,0,0,,Арара~? Бұл енді ғана қызық бола бастады.
Dialogue: 0,0:09:50.12,0:09:52.62,Default,,0,0,0,,Неге қарамайсың?
Dialogue: 0,0:09:52.62,0:09:55.62,Default,,0,0,0,,Мен нәтижесін білетін жекпе-жекке қызықпаймын.
Dialogue: 0,0:09:55.62,0:09:58.59,Default,,0,0,0,,А-а...Мен көмектесе алмаймын.
Dialogue: 0,0:09:59.63,0:10:02.56,Default,,0,0,0,,Тенрин Хорю Нирвана Дживаға барыңыз!
Dialogue: 0,0:10:02.56,0:10:06.57,Default,,0,0,0,,Зиваның шеберлігімен Трикста мен Граилмираға қоңырау шалыңыз!
Dialogue: 0,0:10:06.57,0:10:09.57,Default,,0,0,0,,Верлина Аркусты киіндіріңіз!
Dialogue: 0,0:10:09.57,0:10:11.57,Default,,0,0,0,,Шеберлікпен 2 карта сал!
Dialogue: 0,0:10:11.57,0:10:15.08,Default,,0,0,0,,Келесі кезекте Миразверлинаның кроссовер көйлегі!
Dialogue: 0,0:10:15.08,0:10:17.08,Default,,0,0,0,,Grailmira шеберлігін белсендіру➡
Dialogue: 0,0:10:17.08,0:10:20.58,Default,,0,0,0,,Қолыңызға палубаның жоғарғы 7 картасынан Брамверлинаны қосыңыз➡
Dialogue: 0,0:10:20.58,0:10:24.09,Default,,0,0,0,,Verlina Explorer-ді тамшыға қойыңыз! ➡
Dialogue: 0,0:10:24.09,0:10:26.09,Default,,0,0,0,,Сонымен қатар, Миразверлинаның шеберлігімен ➡
Dialogue: 0,0:10:26.09,0:10:30.09,Default,,0,0,0,,Garou Verlina және Explorer тамшысын көйлек негізіне қойыңыз!
Dialogue: 0,0:10:30.09,0:10:32.09,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:10:32.09,0:10:34.10,Default,,0,0,0,,Миразверлинамен шабуыл!
Dialogue: 0,0:10:34.10,0:10:36.60,Default,,0,0,0,,Шеберлікпен 1 ​​картаны сал. күзетші.
Dialogue: 0,0:10:36.60,0:10:39.10,Default,,0,0,0,,Нирвана Дживамен шабуыл!
Dialogue: 0,0:10:39.10,0:10:41.10,Default,,0,0,0,,Миразверлинаны шеберлікпен тұр!
Dialogue: 0,0:10:41.10,0:10:43.10,Default,,0,0,0,,...
Dialogue: 0,0:10:43.10,0:10:46.11,Default,,0,0,0,,Бірінші тексеру.
Dialogue: 0,0:10:46.11,0:10:49.11,Default,,0,0,0,,Екінші тексеру.
Dialogue: 0,0:10:49.11,0:10:52.11,Default,,0,0,0,,Алдыңғы триггер Алдыңғы қатардағы қуат плюс 10 000!
Dialogue: 0,0:10:52.11,0:10:54.12,Default,,0,0,0,,Верлина Аркуспен шабуыл!
Dialogue: 0,0:10:54.12,0:10:57.12,Default,,0,0,0,,Күзетші жоқ. Миразверлинамен шабуыл!
Dialogue: 0,0:10:57.12,0:10:59.12,Default,,0,0,0,,Қарсы шабуылға шеберлікпен қарсы тұрыңыз!
Dialogue: 0,0:10:59.12,0:11:01.06,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:11:01.06,0:11:03.06,Default,,0,0,0,,...
Dialogue: 0,0:11:03.06,0:11:07.06,Default,,0,0,0,,Бұл күшті, бірақ күткендей күшті.
Dialogue: 0,0:11:07.06,0:11:09.06,Default,,0,0,0,,Е...!
Dialogue: 0,0:11:09.06,0:11:11.07,Default,,0,0,0,,Бірыңғай формаға айналу арқылы өзгертуге болады➡
Dialogue: 0,0:11:11.07,0:11:13.07,Default,,0,0,0,,Жаңа сіз болыңыз!
Dialogue: 0,0:11:13.07,0:11:15.07,Default,,0,0,0,,Көмегің үшін рахмет!
Dialogue: 0,0:11:15.07,0:11:17.07,Default,,0,0,0,,Мықты болу ойын емес ➡
Dialogue: 0,0:11:17.07,0:11:19.57,Default,,0,0,0,,Осылайша сіз өз жолыңызды мәжбүрлейсіз➡
Dialogue: 0,0:11:19.57,0:11:22.08,Default,,0,0,0,,Барлығы бірдей күресе алады➡
Dialogue: 0,0:11:22.08,0:11:26.08,Default,,0,0,0,,Әрқайсымыздың өз күресіміз бар!
Dialogue: 0,0:11:26.08,0:11:29.08,Default,,0,0,0,,Uniformers жекелікті қалай жоққа шығарады➡
Dialogue: 0,0:11:29.08,0:11:31.09,Default,,0,0,0,,Ешқашан қабылданбайды!
Dialogue: 0,0:11:31.09,0:11:34.09,Default,,0,0,0,,Хмм... даралық ➡
Dialogue: 0,0:11:34.09,0:11:36.09,Default,,0,0,0,,Сіздің жеке шайқасыңыз➡
Dialogue: 0,0:11:36.09,0:11:39.09,Default,,0,0,0,,Басқаша айтқанда, жеңе алмайтыныңды жасыру үшін сылтау, солай ма?
Dialogue: 0,0:11:39.09,0:11:41.10,Default,,0,0,0,,Ку...! Менің кезегім.
Dialogue: 0,0:11:41.10,0:11:45.60,Default,,0,0,0,,Негізгі кезеңнің басында жанға соңғының келуін енгізіңіз➡
Dialogue: 0,0:11:45.60,0:11:49.60,Default,,0,0,0,,Содан кейін үш апат картасын жаннан палубаға қайтарыңыз➡
Dialogue: 0,0:11:49.60,0:11:52.61,Default,,0,0,0,,Тұтылу айдаһар ағашының палубасынан➡
Dialogue: 0,0:11:52.61,0:11:55.08,Default,,0,0,0,,Гриффогиллаға мініңіз!
Dialogue: 0,0:11:57.61,0:12:00.55,Default,,0,0,0,,Мен ең мықты боксшы болдым➡
Dialogue: 0,0:12:00.55,0:12:03.05,Default,,0,0,0,,Соңғы шайқасты жүзеге асырыңыз.
Dialogue: 0,0:12:03.05,0:12:05.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:05.05,0:12:09.06,Default,,0,0,0,,Абсолютті күштіден жаратылған нәрсе – ең жоғарғы.
Dialogue: 0,0:12:09.06,0:12:11.06,Default,,0,0,0,,Күштің соңы➡
Dialogue: 0,0:12:11.06,0:12:13.56,Default,,0,0,0,,Бір ғана фигура болуы мүмкін.
Dialogue: 0,0:12:13.56,0:12:17.57,Default,,0,0,0,,Гриффогилланың шеберлігі бар екі Рюки маркерін қойыңыз➡
Dialogue: 0,0:12:17.57,0:12:21.07,Default,,0,0,0,,Рюукидің құлаған ұлы Драко Ватикалға қоңырау шалыңыз.
Dialogue: 0,0:12:21.07,0:12:24.07,Default,,0,0,0,,Шеберлікпен бір Рюки маркер қосылды.
Dialogue: 0,0:12:24.07,0:12:27.08,Default,,0,0,0,,Meteor Flare Dragon➡ шақырыңыз
Dialogue: 0,0:12:27.08,0:12:29.08,Default,,0,0,0,,Верлина Аркустан шегіну дағдыларын қолданыңыз.
Dialogue: 0,0:12:29.08,0:12:34.58,Default,,0,0,0,,Артқы сақшы шегініп бара жатқанда, Драко Ватикалдың тағы бір дағдысы іске қосылды.
Dialogue: 0,0:12:34.58,0:12:38.09,Default,,0,0,0,,Палубаның жоғарғы 5 картасынан Фусимачи Мадокаға қоңырау шалыңыз➡
Dialogue: 0,0:12:38.09,0:12:40.09,Default,,0,0,0,,Трависке➡ қоңырау шалыңыз
Dialogue: 0,0:12:40.09,0:12:43.59,Default,,0,0,0,,Шеберлікпен жан заряды Ретрейт Миразверлина➡
Dialogue: 0,0:12:43.59,0:12:45.59,Default,,0,0,0,,Қуат плюс 10000.
Dialogue: 0,0:12:45.59,0:12:47.60,Default,,0,0,0,,Гриффогилламен шабуыл.
Dialogue: 0,0:12:47.60,0:12:51.10,Default,,0,0,0,,Толық күзет! Бірінші тексеру➡
Dialogue: 0,0:12:51.10,0:12:53.60,Default,,0,0,0,,Екінші тексеру.
Dialogue: 0,0:12:53.60,0:12:55.60,Default,,0,0,0,,Триггерді салу.
Dialogue: 0,0:12:55.60,0:12:59.11,Default,,0,0,0,,1 картаны салыңыз және Трависке қуат плюс 10000 беріңіз.
Dialogue: 0,0:12:59.11,0:13:02.04,Default,,0,0,0,,Трависпен шабуыл. Күзетші жоқ.
Dialogue: 0,0:13:02.04,0:13:05.05,Default,,0,0,0,,Метеорлық алау айдаһарымен шабуыл.
Dialogue: 0,0:13:05.05,0:13:07.52,Default,,0,0,0,,Күзетші жоқ! Соңына бұрылу.
Dialogue: 0,0:13:09.05,0:13:12.55,Default,,0,0,0,,Егер соңғы шайқас орындалса➡
Dialogue: 0,0:13:12.55,0:13:16.06,Default,,0,0,0,,Сен мықты болған әлемде➡
Dialogue: 0,0:13:16.06,0:13:18.06,Default,,0,0,0,,Бізге орын бар ма?
Dialogue: 0,0:13:18.06,0:13:21.06,Default,,0,0,0,,E? әрине!
Dialogue: 0,0:13:21.06,0:13:24.07,Default,,0,0,0,,Әрине, мен сендерге де форма жасап беремін➡
Dialogue: 0,0:13:24.07,0:13:26.57,Default,,0,0,0,,Уайымдамаңыз! әртүрлі.
Dialogue: 0,0:13:26.57,0:13:29.07,Default,,0,0,0,,Қат! Менің кезегім.
Dialogue: 0,0:13:29.07,0:13:31.07,Default,,0,0,0,,Persona Ride!
Dialogue: 0,0:13:31.07,0:13:33.07,Default,,0,0,0,,Дживаның шеберлігін белсендіру➡
Dialogue: 0,0:13:33.07,0:13:36.58,Default,,0,0,0,,Қолыңыздан бір картаны алып тастаңыз және Триста мен Фламараға қоңырау шалыңыз!
Dialogue: 0,0:13:36.58,0:13:39.08,Default,,0,0,0,,Қолдан жойылған Ранджад дағдысын белсендіру➡
Dialogue: 0,0:13:39.08,0:13:41.08,Default,,0,0,0,,Drop-дан өзіңізге қоңырау шалыңыз➡
Dialogue: 0,0:13:41.08,0:13:45.09,Default,,0,0,0,,Триста! Брам Верлина киімі➡
Dialogue: 0,0:13:45.09,0:13:47.09,Default,,0,0,0,,Кроссовер көйлек!
Dialogue: 0,0:13:47.09,0:13:50.59,Default,,0,0,0,,Фламала шеберлігін пайдаланып 2 картаны салып, 1 картаны тастаңыз➡
Dialogue: 0,0:13:50.59,0:13:54.60,Default,,0,0,0,,Верлина Валиентеге Трикстаға қоңырау шалыңыз!
Dialogue: 0,0:13:54.60,0:13:57.60,Default,,0,0,0,,Қосымша тапсырыс карталары➡
Dialogue: 0,0:13:57.60,0:13:59.60,Default,,0,0,0,,Намаздарыңызды киіңіз➡
Dialogue: 0,0:13:59.60,0:14:03.54,Default,,0,0,0,,Valiente-ге стенд мүмкіндігін беріңіз және Брам Верлинаға 10 000 қуат қосыңыз!
Dialogue: 0,0:14:03.54,0:14:05.54,Default,,0,0,0,,Сіз күреске дайынсыз.
Dialogue: 0,0:14:05.54,0:14:08.04,Default,,0,0,0,,Мен сені жеңуім керек!
Dialogue: 0,0:14:08.04,0:14:10.55,Default,,0,0,0,,Дүние Uniformers болуы керек жолмен боялған кезде➡
Dialogue: 0,0:14:10.55,0:14:14.55,Default,,0,0,0,,Бұл дүниеде қалған жалғыз жауынгерлер ең күшті көшірмелер болады!
Dialogue: 0,0:14:14.55,0:14:17.02,Default,,0,0,0,,Верлина Валиентемен шабуыл!
Dialogue: 0,0:14:19.05,0:14:21.06,Default,,0,0,0,,Сақшылардың зақымдалуын тексеру жоқ.
Dialogue: 0,0:14:21.06,0:14:23.06,Default,,0,0,0,,Триггерді салу.
Dialogue: 0,0:14:23.06,0:14:26.56,Default,,0,0,0,,1 картаны салыңыз және Грифогираның қуатын плюс 10000 алыңыз.
Dialogue: 0,0:14:26.56,0:14:30.06,Default,,0,0,0,,Шабуыл соққы болғандықтан, Валиентеге шеберлікпен тұрыңыз.
Dialogue: 0,0:14:30.06,0:14:32.07,Default,,0,0,0,,Брам Верлинамен шабуыл!
Dialogue: 0,0:14:32.07,0:14:35.57,Default,,0,0,0,,Толық күзет. Валиентемен қайтадан шабуыл жасаңыз!
Dialogue: 0,0:14:35.57,0:14:37.57,Default,,0,0,0,,Кесу.
Dialogue: 0,0:14:37.57,0:14:40.58,Default,,0,0,0,,Нирвана Дживамен шабуыл!
Dialogue: 0,0:14:40.58,0:14:42.58,Default,,0,0,0,,Екі дағдыны белсендіру➡
Dialogue: 0,0:14:42.58,0:14:45.08,Default,,0,0,0,,Брам Верлина мен Валиенте тұр!
Dialogue: 0,0:14:45.08,0:14:47.58,Default,,0,0,0,,Күзетші. Бірінші тексеру.
Dialogue: 0,0:14:47.58,0:14:49.58,Default,,0,0,0,,Екінші тексеру.
Dialogue: 0,0:14:49.58,0:14:53.09,Default,,0,0,0,,Триггерді тартыңыз! Бір картаны тартыңыз және Валиентенің күшін және 10 000 алыңыз.
Dialogue: 0,0:14:53.09,0:14:56.59,Default,,0,0,0,,Брам Верлинамен тағы да шабуыл жасаңыз!
Dialogue: 0,0:14:56.59,0:14:58.59,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:14:58.59,0:15:01.03,Default,,0,0,0,,Дағдыны белсендіру Драко Ватикалдың шегінуі➡
Dialogue: 0,0:15:01.03,0:15:04.03,Default,,0,0,0,,Валиентемен қайтадан шабуыл жасаңыз!
Dialogue: 0,0:15:04.03,0:15:06.03,Default,,0,0,0,,Фу….
Dialogue: 0,0:15:06.03,0:15:08.54,Default,,0,0,0,,Күзетші. тоғыз...!
Dialogue: 0,0:15:08.54,0:15:10.54,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:10.54,0:15:12.54,Default,,0,0,0,,Хэхехе...хаха!
Dialogue: 0,0:15:12.54,0:15:14.54,Default,,0,0,0,,Керемет! Сәйкес карта айналымы➡
Dialogue: 0,0:15:14.54,0:15:18.05,Default,,0,0,0,,Керемет 6 қатарынан шабуыл➡
Dialogue: 0,0:15:18.05,0:15:20.55,Default,,0,0,0,,Күшті➡
Dialogue: 0,0:15:20.55,0:15:23.05,Default,,0,0,0,,Бірақ бәрібір➡
Dialogue: 0,0:15:23.05,0:15:25.05,Default,,0,0,0,,Ол келмеді.
Dialogue: 0,0:15:25.05,0:15:27.56,Default,,0,0,0,,Бұрылыңыз!
Dialogue: 0,0:15:27.56,0:15:30.56,Default,,0,0,0,,Енді... менің кезегім!
Dialogue: 0,0:15:30.56,0:15:32.56,Default,,0,0,0,,Күтілгендей~!
Dialogue: 0,0:15:32.56,0:15:34.56,Default,,0,0,0,,Юйю-чан~➡
Dialogue: 0,0:15:34.56,0:15:36.56,Default,,0,0,0,,Сіз байқадыңыз, солай ма?
Dialogue: 0,0:15:36.56,0:15:40.07,Default,,0,0,0,,Жігіт деген адам ешқашан қиылыспайтын тіршілік иесі.
Dialogue: 0,0:15:40.07,0:15:43.57,Default,,0,0,0,,Дәл қазір әлемдегі барлық жауынгерлер➡
Dialogue: 0,0:15:43.57,0:15:46.07,Default,,0,0,0,,Бір беріктікке боялады ма, жоқ па.
Dialogue: 0,0:15:46.07,0:15:48.04,Default,,0,0,0,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:15:52.58,0:15:55.58,Default,,0,0,0,,((3 апат картасы жойылған➡
Dialogue: 0,0:15:55.58,0:15:59.09,Default,,0,0,0,,Ашық триггер келесі бұрылыста пайда болады!
Dialogue: 0,0:15:59.09,0:16:02.02,Default,,0,0,0,,Әскери күш қазірдің өзінде төмен➡
Dialogue: 0,0:16:02.02,0:16:04.03,Default,,0,0,0,,Бірақ➡
Dialogue: 0,0:16:04.03,0:16:07.50,Default,,0,0,0,,Қандай жағдай болмасын, біз оны осы кезекте шешеміз! ))
Dialogue: 0,0:16:08.53,0:16:10.53,Default,,0,0,0,,Нирвана Дживамен шабуыл!
Dialogue: 0,0:16:10.53,0:16:12.53,Default,,0,0,0,,Күзетші. Бірінші тексеру➡
Dialogue: 0,0:16:12.53,0:16:14.54,Default,,0,0,0,,Триггерді салу➡
Dialogue: 0,0:16:14.54,0:16:17.54,Default,,0,0,0,,1 картаны және Trixta қуатын +10000➡ салыңыз
Dialogue: 0,0:16:17.54,0:16:19.54,Default,,0,0,0,,Екінші тексеру….
Dialogue: 0,0:16:19.54,0:16:21.54,Default,,0,0,0,,Маған жауап бер.
Dialogue: 0,0:16:21.54,0:16:23.54,Default,,0,0,0,,Критикалық триггер!
Dialogue: 0,0:16:23.54,0:16:27.05,Default,,0,0,0,,Жақсы! Осымен Ранджадтың қуаты плюс 10000➡
Dialogue: 0,0:16:27.05,0:16:29.05,Default,,0,0,0,,Критикалық плюс 1!
Dialogue: 0,0:16:29.05,0:16:31.05,Default,,0,0,0,,Ранжидпен шабуыл!
Dialogue: 0,0:16:31.05,0:16:33.05,Default,,0,0,0,,Күзет жолын кесу!
Dialogue: 0,0:16:33.05,0:16:35.56,Default,,0,0,0,,Әлі жоқ... Grail Mira➡ арқылы күшейтіңіз
Dialogue: 0,0:16:35.56,0:16:38.56,Default,,0,0,0,,Барамыз ба? Менің досым!
Dialogue: 0,0:16:38.56,0:16:41.53,Default,,0,0,0,,Трикстамен шабуыл!
Dialogue: 0,0:16:42.56,0:16:44.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:46.57,0:16:48.57,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:16:48.57,0:16:51.07,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:16:51.07,0:16:53.07,Default,,0,0,0,,Ах...!
Dialogue: 0,0:16:53.07,0:16:55.08,Default,,0,0,0,,Ku….
Dialogue: 0,0:16:55.08,0:16:57.08,Default,,0,0,0,,Бұрылыстың соңы.
Dialogue: 0,0:16:57.08,0:17:00.08,Default,,0,0,0,,Бұл ең күшті көшірме...оған не болды?
Dialogue: 0,0:17:00.08,0:17:03.58,Default,,0,0,0,,A…. Бұл ең алдымен даралық деп аталады➡
Dialogue: 0,0:17:03.58,0:17:07.59,Default,,0,0,0,,Сіздің төбелесіңіз өзіңіз жасаған нәрсе емес, солай ма?
Dialogue: 0,0:17:07.59,0:17:10.09,Default,,0,0,0,,Әр адам өзінен бұрынғылардан үйрене алады➡
Dialogue: 0,0:17:10.09,0:17:12.09,Default,,0,0,0,,Тарихтан сабақ алу➡
Dialogue: 0,0:17:12.09,0:17:15.06,Default,,0,0,0,,Бізге тек деректерді жетілдіру керек.
Dialogue: 0,0:17:16.10,0:17:19.10,Default,,0,0,0,,Оянатын кез келді.
Dialogue: 0,0:17:19.10,0:17:21.60,Default,,0,0,0,,Драко Ватикалға➡ қоңырау шалыңыз
Dialogue: 0,0:17:21.60,0:17:25.11,Default,,0,0,0,,Одан әрі... Верлина Эспералидеаға қоңырау шалыңыз.
Dialogue: 0,0:17:25.11,0:17:27.07,Default,,0,0,0,,Бұл тек менің қиялым ғана болды.
Dialogue: 0,0:17:28.61,0:17:31.11,Default,,0,0,0,,Espera Ruidea күшті➡
Dialogue: 0,0:17:31.11,0:17:33.61,Default,,0,0,0,,Ұлт Айдаһар империясы болғанда ➡
Dialogue: 0,0:17:33.61,0:17:36.62,Default,,0,0,0,,Гриффогилламен тамаша үйлеседі➡
Dialogue: 0,0:17:36.62,0:17:39.12,Default,,0,0,0,,Келіңіздер! Draco Vatical Boost➡
Dialogue: 0,0:17:39.12,0:17:42.12,Default,,0,0,0,,Espera идеясымен шабуыл!
Dialogue: 0,0:17:42.12,0:17:45.13,Default,,0,0,0,,У...күзет жолын кесу!
Dialogue: 0,0:17:45.13,0:17:48.13,Default,,0,0,0,,Гриффогилламен шабуыл.
Dialogue: 0,0:17:48.13,0:17:51.13,Default,,0,0,0,,Дағдыны белсендіру Барлық артқы қорғаушыларды тұрғызыңыз➡
Dialogue: 0,0:17:51.13,0:17:54.64,Default,,0,0,0,,Және палубадағы соңғы карта➡
Dialogue: 0,0:17:54.64,0:17:58.14,Default,,0,0,0,,Триггерді мәжбүрлеп іске қосыңыз.
Dialogue: 0,0:17:58.14,0:18:00.11,Default,,0,0,0,,Драгведа іске қосылды! ➡
Dialogue: 0,0:18:00.11,0:18:03.08,Default,,0,0,0,,Espera Idea қуаты плюс 100 миллион иен➡
Dialogue: 0,0:18:03.08,0:18:05.08,Default,,0,0,0,,Гриффогилланы тұрғызыңыз.
Dialogue: 0,0:18:05.08,0:18:07.05,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:09.08,0:18:12.09,Default,,0,0,0,,((Сіз жасай алатын жалғыз нәрсе - бұл зақымдануды тексеру➡
Dialogue: 0,0:18:12.09,0:18:15.09,Default,,0,0,0,,Менің жеңетін жолым жоқ. ))
Dialogue: 0,0:18:15.09,0:18:17.09,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:18:17.09,0:18:19.09,Default,,0,0,0,,Драйверді тексеру.
Dialogue: 0,0:18:19.09,0:18:21.10,Default,,0,0,0,,Ең күшті тамаша➡
Dialogue: 0,0:18:21.10,0:18:25.10,Default,,0,0,0,,Егер бұл жай ғана көшірме болса да, мұны әркім жасай алса, бұл тамаша дүние болар еді.
Dialogue: 0,0:18:25.10,0:18:29.60,Default,,0,0,0,,Мен бәріңді сол утопияға апаратын жетекшімін.
Dialogue: 0,0:18:29.60,0:18:32.61,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:18:32.61,0:18:34.61,Default,,0,0,0,,Зақымдануды тексеру.
Dialogue: 0,0:18:34.61,0:18:37.61,Default,,0,0,0,,Кемелдік немесе идеалдылық➡
Dialogue: 0,0:18:37.61,0:18:41.12,Default,,0,0,0,,Мені олай итерме!
Dialogue: 0,0:18:41.12,0:18:43.08,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:18:46.62,0:18:49.12,Default,,0,0,0,,Менің күресім бар➡
Dialogue: 0,0:18:49.12,0:18:51.09,Default,,0,0,0,,Мен сенемін!
Dialogue: 0,0:18:55.63,0:18:58.63,Default,,0,0,0,,Екінші тексеру.
Dialogue: 0,0:18:58.63,0:19:01.57,Default,,0,0,0,,Триггердің үстінде!
Dialogue: 0,0:19:01.57,0:19:04.04,Default,,0,0,0,,Нирвана Дживаның күші плюс 100 миллион!
Dialogue: 0,0:19:06.57,0:19:09.08,Default,,0,0,0,,Керемет... ғажап! ➡
Dialogue: 0,0:19:09.08,0:19:11.08,Default,,0,0,0,,Өте әдемі.
Dialogue: 0,0:19:11.08,0:19:14.58,Default,,0,0,0,,Сонда да мен мықтыға да, мінсізге де жете алмаймын➡
Dialogue: 0,0:19:14.58,0:19:16.58,Default,,0,0,0,,Дегенмен, Кира жеңілісті жек көреді.
Dialogue: 0,0:19:16.58,0:19:18.59,Default,,0,0,0,,Драко Ватикалмен күшейтіңіз➡
Dialogue: 0,0:19:18.59,0:19:20.55,Default,,0,0,0,,Espera идеясымен шабуыл!
Dialogue: 0,0:19:23.09,0:19:25.09,Default,,0,0,0,,Толық күзет!
Dialogue: 0,0:19:25.09,0:19:27.09,Default,,0,0,0,,Үміт - бұл...
Dialogue: 0,0:19:27.09,0:19:29.60,Default,,0,0,0,,Үміт әлі сөнген жоқ!
Dialogue: 0,0:19:29.60,0:19:31.60,Default,,0,0,0,,(Сора) …Дегенмен, болған жайттардың бәрінен кейін,
Dialogue: 0,0:19:31.60,0:19:34.10,Default,,0,0,0,,Айттым ғой...біз жарасамыз➡
Dialogue: 0,0:19:34.10,0:19:37.61,Default,,0,0,0,,Сіз мұны жақсы білесіз, солай ма?
Dialogue: 0,0:19:37.61,0:19:41.11,Default,,0,0,0,,Гриффогилламен Трикстаға шабуыл жасаңыз.
Dialogue: 0,0:19:41.11,0:19:43.61,Default,,0,0,0,,Қарғыс атқыр... күзетші жоқ.
Dialogue: 0,0:19:43.61,0:19:46.11,Default,,0,0,0,,Верлина Эспералидеа –➡
Dialogue: 0,0:19:46.11,0:19:49.62,Default,,0,0,0,,Авангард шабуыл жасағанда тұрыңыз➡
Dialogue: 0,0:19:49.62,0:19:53.12,Default,,0,0,0,,Бұл идеяның шын мәні➡
Dialogue: 0,0:19:53.12,0:19:55.62,Default,,0,0,0,,Енді мұны аяқтаймыз ба? қарақат….
Dialogue: 0,0:19:55.62,0:19:57.63,Default,,0,0,0,,Бірінші тексеру.
Dialogue: 0,0:19:57.63,0:19:59.63,Default,,0,0,0,,Триггер жоқ.
Dialogue: 0,0:19:59.63,0:20:02.06,Default,,0,0,0,,Екінші ➡
Dialogue: 0,0:20:02.06,0:20:04.57,Default,,0,0,0,,Тексеру➡
Dialogue: 0,0:20:04.57,0:20:08.07,Default,,0,0,0,,Алдыңғы триггер!
Dialogue: 0,0:20:08.07,0:20:11.54,Default,,0,0,0,,Барлық алдыңғы қатардағы қуат плюс 10 000.
Dialogue: 0,0:20:21.08,0:20:24.09,Default,,0,0,0,,Адамның жүрегі үмітсіздікке толғанда➡
Dialogue: 0,0:20:24.09,0:20:27.09,Default,,0,0,0,,Айтпасқа амалым жоқ➡
Dialogue: 0,0:20:27.09,0:20:31.09,Default,,0,0,0,,Берілме, жақсы, үміт, болашақ➡
Dialogue: 0,0:20:31.09,0:20:33.09,Default,,0,0,0,,Жарық….
Dialogue: 0,0:20:33.09,0:20:35.10,Default,,0,0,0,,Адамдар қызық➡
Dialogue: 0,0:20:35.10,0:20:37.10,Default,,0,0,0,,Бірақ ол тым әлсіз.
Dialogue: 0,0:20:37.10,0:20:40.10,Default,,0,0,0,,Сондықтан мен сізге жол көрсетемін.
Dialogue: 0,0:20:40.10,0:20:43.10,Default,,0,0,0,,Espera Ruidea-мен бірге Нирвана Зиваға➡
Dialogue: 0,0:20:43.10,0:20:45.11,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:20:45.11,0:20:47.07,Default,,0,0,0,,Күзетші жоқ.
Dialogue: 0,0:20:54.62,0:20:57.12,Default,,0,0,0,,Келіңіздер! Соңғы шайқас➡
Dialogue: 0,0:20:57.12,0:20:59.59,Default,,0,0,0,,Бұл есік енді ашық!
Dialogue: 0,0:21:20.57,0:21:23.58,Default,,0,0,0,,Рақмет Юю Кондо➡
Dialogue: 0,0:21:23.58,0:21:27.05,Default,,0,0,0,,Сізбен жекпе-жек өте мағыналы болды.
Dialogue: 0,0:21:29.58,0:21:34.59,Default,,0,0,0,,Бұл дүние мен деп аталатын жалғыз кемел адамнан тұрады➡
Dialogue: 0,0:21:34.59,0:21:37.56,Default,,0,0,0,,Жаңа әлемге қарай ол қайта боялады.
Dialogue: 0,0:21:40.09,0:21:43.10,Default,,0,0,0,,Жеңімпаз Широган!
Dialogue: 0,0:21:43.10,0:21:45.10,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:21:45.10,0:21:47.10,Default,,0,0,0,,((Күтілгендей➡
Dialogue: 0,0:21:47.10,0:21:50.57,Default,,0,0,0,,Сіз...Закуса болдыңыз ба? ))
Dialogue: 0,0:21:51.61,0:21:55.61,Default,,0,0,0,,((Мен... орындаймын➡
Dialogue: 0,0:21:55.61,0:21:58.58,Default,,0,0,0,,Басқа...болашақ. ))
