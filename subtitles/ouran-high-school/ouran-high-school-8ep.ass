Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:02.80,staff-ja,,0,0,0,,Mam
Dialogue: 0,0:00:00.00,0:00:03.00,staff-ja,,0,0,0,,HARERE
Dialogue: 0,0:00:00.00,0:00:03.00,staff-ja,,0,0,0,,Syura
Dialogue: 0,0:00:00.00,0:00:03.17,staff-ja,,0,0,0,,Аударма Aris
Dialogue: 0,0:00:00.00,0:00:03.25,staff-ja,,0,0,0,,Сабақ кестесі Қара мысық пен сиыр қыз
Dialogue: 0,0:00:00.00,0:00:03.25,staff-ja,,0,0,0,,Наксияның әкімшілік жүйесі
Dialogue: 0,0:00:00.00,0:00:03.63,staff-ja,,0,0,0,,OP&ED Hagakure
Dialogue: 0,0:00:00.00,0:00:03.63,staff-ja,,0,0,0,,Сюра
Dialogue: 0,0:00:00.00,0:00:03.88,Default11-ja,,0,0,0,,Құдайдың субтитр жұбы
Dialogue: 0,0:00:08.28,0:00:09.61,Style1,,0,0,0,,Жағажай?
Dialogue: 0,0:00:08.45,0:00:08.89,jp.sub-ja,,0,0,0,,Теңіз?
Dialogue: 0,0:00:09.61,0:00:11.61,Style1,,0,0,0,,Иә, жағажай!
Dialogue: 0,0:00:09.64,0:00:11.16,jp.sub-ja,,0,0,0,,Иса теңізі
Dialogue: 0,0:00:11.61,0:00:13.28,Style1,,0,0,0,,Жағажай...
Dialogue: 0,0:00:11.72,0:00:12.34,jp.sub-ja,,0,0,0,,Теңіз
Dialogue: 0,0:00:13.28,0:00:14.95,Style1,,0,0,0,,Сіз мұны бұрын айтқансыз, солай емес пе?
Dialogue: 0,0:00:13.42,0:00:14.87,jp.sub-ja,,0,0,0,,Сіз өткен күні айттыңыз.
Dialogue: 0,0:00:14.95,0:00:17.12,Style1,,0,0,0,,Нағыз жағажайға баруға қарсы болмас едіңіз.
Dialogue: 0,0:00:15.17,0:00:16.98,jp.sub-ja,,0,0,0,,Егер бұл нағыз теңіз болса, онда баруға болады.
Dialogue: 0,0:00:17.12,0:00:18.45,Style1,,0,0,0,,Мен мұны айттым ба?
Dialogue: 0,0:00:17.27,0:00:17.97,jp.sub-ja,,0,0,0,,Мен мұны айттым ба?
Dialogue: 0,0:00:18.45,0:00:21.29,Style1,,0,0,0,,Иә, айттыңыз. Және де...
Dialogue: 0,0:00:18.59,0:00:20.84,jp.sub-ja,,0,0,0,,Сондықтан
Dialogue: 0,0:00:21.29,0:00:23.13,Style1,,0,0,0,,...біз сізге бірнеше купальник дайындадық.
Dialogue: 0,0:00:21.33,0:00:23.03,jp.sub-ja,,0,0,0,,Мен купальник дайындадым
Dialogue: 0,0:00:23.13,0:00:24.96,Style1,,0,0,0,,Бұл сүйкімді емес пе?
Dialogue: 0,0:00:23.33,0:00:24.49,jp.sub-ja,,0,0,0,,Сүйкімді емес пе?
Dialogue: 0,0:00:24.89,0:00:30.61,jp.sub-ja,,0,0,0,,Менің ойымша, мұндай нәрсе Хару-чанға жарасады.
Dialogue: 0,0:00:24.96,0:00:27.30,Style1,,0,0,0,,Менің ойымша...
Dialogue: 0,0:00:27.30,0:00:30.63,Style1,,0,0,0,,...бұл Хару-чанға жақсы көрінеді.
Dialogue: 0,0:00:30.61,0:00:31.71,jp.sub-ja,,0,0,0,,Читчичи
Dialogue: 0,0:00:31.97,0:00:35.81,Style1,,0,0,0,,Түсінбедің, иә, Бал сенпай?
Dialogue: 0,0:00:32.20,0:00:34.51,jp.sub-ja,,0,0,0,,Түсінбейсің, бал-сенпай.
Dialogue: 0,0:00:35.81,0:00:38.64,Style1,,0,0,0,,Бұл форманы кию фактіні жылтыратуға көмектеседі
Dialogue: 0,0:00:36.02,0:00:40.24,jp.sub-ja,,0,0,0,,Бұл кесетін тақтаны форма кию арқылы ғана алдауға болады.
Dialogue: 0,0:00:36.67,0:00:40.20,Style2,,0,0,0,,«Кішкентай ару А-кубогы»
Dialogue: 0,0:00:38.64,0:00:40.74,Style1,,0,0,0,,оның кесетін тақтайдай жалпақ екенін.
Dialogue: 0,0:00:40.74,0:00:43.25,Style1,,0,0,0,,Бір бөліктен тұратын костюм тек көз жасын шақырады,
Dialogue: 0,0:00:40.96,0:00:44.65,jp.sub-ja,,0,0,0,,Мен бір бөлік түрі өте нашар екенін толығымен көремін.
Dialogue: 0,0:00:43.25,0:00:46.25,Style1,,0,0,0,,оның фигурасының қаншалықты нашар екенін көрсету арқылы.
Dialogue: 0,0:00:44.77,0:00:45.96,jp.sub-ja,,0,0,0,,Көзімнен жас келеді.
Dialogue: 0,0:00:46.25,0:00:50.25,Style1,,0,0,0,,Осы тұста біз бұл бөлек үлгідегі костюмді мұқият таңдадық.
Dialogue: 0,0:00:46.46,0:00:49.96,jp.sub-ja,,0,0,0,,Біз мұқият таңдаған бұл бөлек түр
Dialogue: 0,0:00:50.25,0:00:53.74,Style1,,0,0,0,,Бұрымдар кез келген бюсттің жоқтығын жақсы жабуда!
Dialogue: 0,0:00:50.31,0:00:53.38,jp.sub-ja,,0,0,0,,Бұрымдар кеуденің жоқтығын тамаша жабады.
Dialogue: 0,0:00:58.59,0:01:01.89,jp.sub-ja,,0,0,0,,Жігіттер неге менің қызыма жыныстық зорлық көрсетіп жатырсыңдар?
Dialogue: 0,0:00:58.59,0:01:02.10,Style1,,0,0,0,,Менің кішкентай қызыма жыныстық зорлық-зомбылық көрсетуге қалай дәтің барсыңдар!
Dialogue: 0,0:01:02.10,0:01:04.60,Style1,,0,0,0,,Осының өзі жетеді!
Dialogue: 0,0:01:02.27,0:01:04.29,jp.sub-ja,,0,0,0,,Кінәлі
Dialogue: 0,0:01:04.60,0:01:08.20,Style1,,0,0,0,,Олай болса, біз жағаға бармаймыз ба?
Dialogue: 0,0:01:04.73,0:01:06.98,jp.sub-ja,,0,0,0,,Онда мен теңізге бармаймын
Dialogue: 0,0:01:08.20,0:01:10.27,Style1,,0,0,0,,Біз бармаймыз деп кім айтты?
Dialogue: 0,0:01:08.26,0:01:09.54,jp.sub-ja,,0,0,0,,Барма деп кім айтты?
Dialogue: 0,0:01:10.27,0:01:12.94,Style1,,0,0,0,,О, сонда барғың келеді!
Dialogue: 0,0:01:10.43,0:01:12.75,jp.sub-ja,,0,0,0,,Не? Мен шынымен барғым келеді.
Dialogue: 0,0:01:12.94,0:01:14.78,Style1,,0,0,0,,Уса-чан да келе ала ма?
Dialogue: 0,0:01:13.19,0:01:14.49,jp.sub-ja,,0,0,0,,Қоян да
Dialogue: 0,0:01:14.78,0:01:16.27,Style1,,0,0,0,,Менің қарсылығым жоқ.
Dialogue: 0,0:01:14.94,0:01:15.94,jp.sub-ja,,0,0,0,,Қарсылық жоқ.
Dialogue: 0,0:01:17.95,0:01:20.45,Style1,,0,0,0,,Иә? Біз шынымен барамыз ба?
Dialogue: 0,0:01:18.18,0:01:20.09,jp.sub-ja,,0,0,0,,О, шынымен барасың ба?
Dialogue: 0,0:01:20.45,0:01:23.44,Style1,,0,0,0,,Жүр, жағаға барайық!
Dialogue: 0,0:01:20.63,0:01:22.76,jp.sub-ja,,0,0,0,,Теңізге барайық
Dialogue: 0,0:01:28.02,0:01:30.58,Style1,,0,0,0,,«Күн, теңіз және қабылдаушы клуб!»
Dialogue: 0,0:01:31.73,0:01:33.96,Style1,,0,0,0,,Неліктен Окинава?
Dialogue: 0,0:01:31.94,0:01:33.59,jp.sub-ja,,0,0,0,,Неліктен Окинава?
Dialogue: 0,0:01:33.85,0:01:36.65,jp.sub-ja,,0,0,0,,Кьюя-но-докорода жеке жағажай да бар.
Dialogue: 0,0:01:33.96,0:01:37.13,Style1,,0,0,0,,Мұнда Киоя тұрғындарының жеке жағажайы бар.
Dialogue: 0,0:01:37.10,0:01:39.04,jp.sub-ja,,0,0,0,,Бұл әдемі жер.
Dialogue: 0,0:01:37.13,0:01:39.30,Style1,,0,0,0,,Керемет жер екен, иә?
Dialogue: 0,0:01:39.30,0:01:40.30,Style1,,0,0,0,,Оқу, оқу
Dialogue: 0,0:01:40.30,0:01:42.30,Style1,,0,0,0,,Бірақ біз бір жерге баратын болсақ, неге...
Dialogue: 0,0:01:40.43,0:01:41.87,jp.sub-ja,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:01:42.29,0:01:43.47,jp.sub-ja,,0,0,0,,Кариб және т.б.
Dialogue: 0,0:01:42.30,0:01:44.91,Style1,,0,0,0,,...Кариб теңізі... ...немесе Фиджи ме?
Dialogue: 0,0:01:43.58,0:01:44.84,jp.sub-ja,,0,0,0,,Фиджи т.б.
Dialogue: 0,0:01:44.91,0:01:47.41,Style1,,0,0,0,,Сіздің ойыңызша, Харухидің төлқұжаты бар ма?
Dialogue: 0,0:01:44.98,0:01:47.67,jp.sub-ja,,0,0,0,,Сіздің ойыңызша, Харухидің төлқұжаты бар ма?
Dialogue: 0,0:01:47.41,0:01:51.07,Style1,,0,0,0,,- Ааа... - Ойлылығыңызға көп рахмет.
Dialogue: 0,0:01:48.12,0:01:50.67,jp.sub-ja,,0,0,0,,Мазалағаным үшін кешірім сұраймын.
Dialogue: 0,0:01:53.92,0:01:55.75,Style1,,0,0,0,,Өте әдемі.
Dialogue: 0,0:01:54.11,0:02:00.64,jp.sub-ja,,0,0,0,,Бұл әдемі. Тамакимен бірге мұхитты тамашалау арман сияқты.
Dialogue: 0,0:01:55.75,0:02:01.26,Style1,,0,0,0,,Тамаки-кун, сенімен оңаша болу, теңізге қарау арман сияқты.
Dialogue: 0,0:02:01.26,0:02:06.20,Style1,,0,0,0,,Бұл арман емес. Бірақ менің жолым болса,
Dialogue: 0,0:02:01.54,0:02:05.77,jp.sub-ja,,0,0,0,,Бұл түс емес, бірақ мен бүгін кешке үміттенемін
Dialogue: 0,0:02:06.20,0:02:10.60,Style1,,0,0,0,,Бүгін түнде түсіңе көрінгенімді қалаймын.
Dialogue: 0,0:02:06.26,0:02:09.51,jp.sub-ja,,0,0,0,,Түсінде көрінейін
Dialogue: 0,0:02:10.60,0:02:12.09,Style1,,0,0,0,,Тамаки-кун...
Dialogue: 0,0:02:10.65,0:02:11.38,jp.sub-ja,,0,0,0,,Тамаки-кун
Dialogue: 0,0:02:14.27,0:02:15.94,Style1,,0,0,0,,Сабыр ет, Хикару!
Dialogue: 0,0:02:14.32,0:02:15.93,jp.sub-ja,,0,0,0,,Жұмсақ болыңыз, Хикари.
Dialogue: 0,0:02:15.94,0:02:18.71,Style1,,0,0,0,,Кешіріңіз! Мен аламын!
Dialogue: 0,0:02:16.16,0:02:17.97,jp.sub-ja,,0,0,0,,Жаман мен барамын.
Dialogue: 0,0:02:18.71,0:02:20.61,Style1,,0,0,0,,Мені күт, Каору!
Dialogue: 0,0:02:18.93,0:02:20.45,jp.sub-ja,,0,0,0,,Күте тұр, Каору
Dialogue: 0,0:02:20.61,0:02:23.31,Style1,,0,0,0,,Бұл мен емес! Доп қашып барады!
Dialogue: 0,0:02:20.89,0:02:23.13,jp.sub-ja,,0,0,0,,Мен емес, доп қашады.
Dialogue: 0,0:02:23.31,0:02:25.11,Style2,,0,0,0,,«Орын бойынша жұмыс істейтін хосттар»
Dialogue: 0,0:02:29.95,0:02:31.29,Style1,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,0:02:30.15,0:02:30.95,jp.sub-ja,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:02:31.29,0:02:34.62,Style1,,0,0,0,,Екі ату уақытыңыз аяқталды. Келесі, өтінемін.
Dialogue: 0,0:02:31.41,0:02:34.76,jp.sub-ja,,0,0,0,,Екі ату уақыты аяқталды. Келесі адам өтінемін.
Dialogue: 0,0:02:34.62,0:02:38.68,Style1,,0,0,0,,Неліктен біз жағажайда Хост клубының іс-шараларын өткіземіз?
Dialogue: 0,0:02:35.02,0:02:38.17,jp.sub-ja,,0,0,0,,Неліктен теңізге келіп, қабылдаушы клубтың іс-шараларына қатыстыңыз?
Dialogue: 0,0:02:41.63,0:02:42.96,Style1,,0,0,0,,Харухи-кун...
Dialogue: 0,0:02:41.74,0:02:42.43,jp.sub-ja,,0,0,0,,Харухи-кун
Dialogue: 0,0:02:43.90,0:02:46.24,Style1,,0,0,0,,Харухи-кун, сен суға бармайсың ба?
Dialogue: 0,0:02:44.17,0:02:45.79,jp.sub-ja,,0,0,0,,Харухи, сен жүзбейсің.
Dialogue: 0,0:02:46.24,0:02:49.74,Style1,,0,0,0,,О, мен теңізге қарағанды ​​көбірек ұнатамын.
Dialogue: 0,0:02:47.38,0:02:49.27,jp.sub-ja,,0,0,0,,Мен теңізге қарағанды ұнатамын
Dialogue: 0,0:02:49.74,0:02:53.24,Style1,,0,0,0,,Ендеше, саған қосылсақ жақсы болар ма еді?
Dialogue: 0,0:02:49.83,0:02:52.75,jp.sub-ja,,0,0,0,,Олай болса, сізге қосылсақ болады ма?
Dialogue: 0,0:02:53.24,0:02:55.08,Style1,,0,0,0,,Қалай болды?
Dialogue: 0,0:02:53.43,0:02:56.36,jp.sub-ja,,0,0,0,,Неге жүзуге бармайсың?
Dialogue: 0,0:02:55.08,0:02:57.25,Style1,,0,0,0,,Алға барып жүзіңіз.
Dialogue: 0,0:02:57.25,0:03:00.15,Style1,,0,0,0,,Сіз сондай сүйкімді купальник киіпсіз, және бәрі.
Dialogue: 0,0:02:57.28,0:02:59.39,jp.sub-ja,,0,0,0,,Мен сүйкімді купальник кисем де
Dialogue: 0,0:03:02.59,0:03:04.59,Style1,,0,0,0,,Біз мүлдем алданып қалдық, иә?
Dialogue: 0,0:03:02.62,0:03:04.48,jp.sub-ja,,0,0,0,,Сіз мүлде алданып қалдыңыз, солай емес пе?
Dialogue: 0,0:03:04.59,0:03:06.92,Style1,,0,0,0,,Бізбен бірге қонақтарды алып келеді деп кім ойлаған?
Dialogue: 0,0:03:04.78,0:03:06.42,jp.sub-ja,,0,0,0,,Мен тіпті тұтынушыларды шақырамын деп ойламаппын.
Dialogue: 0,0:03:06.92,0:03:08.92,Style1,,0,0,0,,Біз мұны шынымен түсінбедік.
Dialogue: 0,0:03:07.07,0:03:08.58,jp.sub-ja,,0,0,0,,Шын мәнінде есептелмеген
Dialogue: 0,0:03:08.92,0:03:12.60,Style1,,0,0,0,,Мен сіздерді клуб мүшелерін тегін шақырдым,
Dialogue: 0,0:03:08.96,0:03:12.27,jp.sub-ja,,0,0,0,,Мен сізді тегін мүшелікке шақырдым.
Dialogue: 0,0:03:12.60,0:03:15.26,Style1,,0,0,0,,сондықтан қызметтеріңізді міндетті түрде орындаңыз.
Dialogue: 0,0:03:12.74,0:03:14.80,jp.sub-ja,,0,0,0,,Жақсы қызмет көрсетіңіз.
Dialogue: 0,0:03:15.26,0:03:17.27,Style1,,0,0,0,,Бірақ мұнда қонақтармен...
Dialogue: 0,0:03:15.49,0:03:17.18,jp.sub-ja,,0,0,0,,Ал егер тұтынушылар болса
Dialogue: 0,0:03:17.27,0:03:19.60,Style1,,0,0,0,,...Харухи купальнигін кие алмайды.
Dialogue: 0,0:03:17.42,0:03:19.26,jp.sub-ja,,0,0,0,,Харухи купальник кие алмайды
Dialogue: 0,0:03:19.60,0:03:21.94,Style1,,0,0,0,,Барлығы ескерілді.
Dialogue: 0,0:03:19.90,0:03:21.50,jp.sub-ja,,0,0,0,,Барлығы есептелгендей
Dialogue: 0,0:03:21.94,0:03:24.61,Style1,,0,0,0,,Менің сүйікті қызыма купальник кигіземін деп ойладың ба?
Dialogue: 0,0:03:22.09,0:03:27.05,jp.sub-ja,,0,0,0,,Сенің көз алдыңа купальник киген сүйкімді қызды кім көрсетеді?
Dialogue: 0,0:03:24.61,0:03:27.60,Style1,,0,0,0,,сіздің көзіңізге әсер ету керек пе?
Dialogue: 0,0:03:28.01,0:03:35.47,Style2,,0,0,0,,«Тамаки ойының театры»
Dialogue: 0,0:03:35.62,0:03:38.95,Style1,,0,0,0,,Содан кейін күн батқанда,
Dialogue: 0,0:03:35.84,0:03:38.11,jp.sub-ja,,0,0,0,,Ал кеш батқанда
Dialogue: 0,0:03:38.95,0:03:44.23,Style1,,0,0,0,,Харухи екеуміз жағада серуендейміз, тек екеуміз.
Dialogue: 0,0:03:39.05,0:03:43.23,jp.sub-ja,,0,0,0,,Мен Харухимен жалғыз жағажайда серуендеуге барамын.
Dialogue: 0,0:03:44.23,0:03:48.23,Style1,,0,0,0,,Бұл шынымен де күннің батуы.
Dialogue: 0,0:03:44.32,0:03:47.01,jp.sub-ja,,0,0,0,,Нағыз әдемі күннің батуы
Dialogue: 0,0:03:48.23,0:03:52.57,Style1,,0,0,0,,Біз осында қалып, мәңгі бірге көрсек екен.
Dialogue: 0,0:03:48.43,0:03:51.98,jp.sub-ja,,0,0,0,,Мен оны осылай мәңгі бірге көргім келеді.
Dialogue: 0,0:03:52.57,0:03:56.91,Style1,,0,0,0,,Немесе осы жолдағы бірдеңе! Бұл тым көп болар еді, иә?
Dialogue: 0,0:03:52.59,0:03:55.84,jp.sub-ja,,0,0,0,,Қандай жағдай болса да, мен енді шыдай алмаймын.
Dialogue: 0,0:03:56.91,0:03:59.07,Style1,,0,0,0,,Тамаки-кунның үстінен не болуы мүмкін?
Dialogue: 0,0:03:56.94,0:03:59.14,jp.sub-ja,,0,0,0,,Қызық, Тамаки-кун не болды?
Dialogue: 0,0:03:59.07,0:04:00.41,Style1,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:03:59.14,0:04:00.37,jp.sub-ja,,0,0,0,,Хм, солай ма?
Dialogue: 0,0:04:00.41,0:04:02.91,Style1,,0,0,0,,Бұл оның әдеттегі жағдайы.
Dialogue: 0,0:04:00.48,0:04:02.12,jp.sub-ja,,0,0,0,,Бұл жай ғана тұрақты ауру.
Dialogue: 0,0:04:02.91,0:04:04.90,Style1,,0,0,0,,Хару-чан!
Dialogue: 0,0:04:03.13,0:04:04.25,jp.sub-ja,,0,0,0,,Хару-чан
Dialogue: 0,0:04:05.91,0:04:08.25,Style1,,0,0,0,,Тозақтық маневрге барайық!
Dialogue: 0,0:04:06.09,0:04:07.64,jp.sub-ja,,0,0,0,,Көңілді болайық
Dialogue: 0,0:04:08.25,0:04:10.92,Style1,,0,0,0,,Менің ойымша, сіз «моллюскаларды аулау» деп айтып отырсыз.
Dialogue: 0,0:04:08.31,0:04:10.52,jp.sub-ja,,0,0,0,,Олай десеңіз, Шиохигари
Dialogue: 0,0:04:10.92,0:04:14.42,Style1,,0,0,0,,Мен ешкімнің балық аулауға баратынын естіген емеспін...
Dialogue: 0,0:04:11.23,0:04:16.60,jp.sub-ja,,0,0,0,,Мен мұндай жерде бальзамды аулауды естіген емеспін.
Dialogue: 0,0:04:14.42,0:04:16.65,Style1,,0,0,0,,...осындай кез келген жерде...
Dialogue: 0,0:04:23.27,0:04:25.76,Style1,,0,0,0,,Бұл не!?
Dialogue: 0,0:04:23.37,0:04:25.60,jp.sub-ja,,0,0,0,,Бұл не?
Dialogue: 0,0:04:30.61,0:04:32.27,Style1,,0,0,0,,Мори-сенпай...
Dialogue: 0,0:04:30.76,0:04:31.57,jp.sub-ja,,0,0,0,,Мори Сенпай
Dialogue: 0,0:04:32.27,0:04:34.61,Style1,,0,0,0,,Менің жеке полиция күштерім
Dialogue: 0,0:04:32.39,0:04:34.26,jp.sub-ja,,0,0,0,,Менің отбасымның жеке полициясы
Dialogue: 0,0:04:34.61,0:04:38.95,Style1,,0,0,0,,бұрын Honey-senpai-ге жасаған қылмысының орнын толтырғысы келді,
Dialogue: 0,0:04:34.87,0:04:38.74,jp.sub-ja,,0,0,0,,Өткен күні Бал сенпайды сыйламағаным үшін кешірім сұраймын.
Dialogue: 0,0:04:38.95,0:04:40.95,Style1,,0,0,0,,сондықтан мен оларға мұны істеуге рұқсат етемін.
Dialogue: 0,0:04:39.12,0:04:40.50,jp.sub-ja,,0,0,0,,Адамдарға қалағанын жасауға мүмкіндік беру
Dialogue: 0,0:04:40.95,0:04:43.65,Style1,,0,0,0,,Керемет! Қандай тартыс!
Dialogue: 0,0:04:41.20,0:04:43.23,jp.sub-ja,,0,0,0,,Қандай үлкен аулау!
Dialogue: 0,0:04:43.65,0:04:46.56,Style1,,0,0,0,,Бүгін кешке сәнді гарнир дайындаймыз, иә?
Dialogue: 0,0:04:43.84,0:04:46.05,jp.sub-ja,,0,0,0,,Бүгінгі кешкі гарнир керемет.
Dialogue: 0,0:04:46.46,0:04:47.70,jp.sub-ja,,0,0,0,,Дәмді көрінеді
Dialogue: 0,0:04:46.56,0:04:49.22,Style1,,0,0,0,,Бұл дәмді болады!
Dialogue: 0,0:04:47.59,0:04:48.89,Style2,,0,0,0,,«Бақытқа толы»
Dialogue: 0,0:04:49.22,0:04:54.23,Style1,,0,0,0,,Екеуің рахаттанып жүрген сияқтысыңдар, менің ойымша, бәрі жақсы.
Dialogue: 0,0:04:49.39,0:04:53.74,jp.sub-ja,,0,0,0,,Екеуі де көңіл көтеріп жүрген сияқты, солай емес пе?
Dialogue: 0,0:04:54.23,0:04:56.23,Style1,,0,0,0,,Сенпай!
Dialogue: 0,0:04:54.46,0:05:00.30,jp.sub-ja,,0,0,0,,Сенпай, бүгінгі кешкі ас үлкен олжа.
Dialogue: 0,0:04:56.23,0:05:00.57,Style1,,0,0,0,,Біз бүгін кешкі асқа үлкен жол алдық!
Dialogue: 0,0:05:00.54,0:05:03.80,jp.sub-ja,,0,0,0,,Түсіндім, қызым.
Dialogue: 0,0:05:00.57,0:05:03.91,Style1,,0,0,0,,Жасадың, істедің бе, менің кішкентай қызым?
Dialogue: 0,0:05:03.91,0:05:08.24,Style1,,0,0,0,,Үлкен жүк! Үлкен жүк!
Dialogue: 0,0:05:03.99,0:05:08.10,jp.sub-ja,,0,0,0,,Бұл үлкен олжа. Бұл үлкен аулау.
Dialogue: 0,0:05:08.24,0:05:09.58,Style1,,0,0,0,,Иә? Бұл не болды?
Dialogue: 0,0:05:08.72,0:05:09.41,jp.sub-ja,,0,0,0,,Не?
Dialogue: 0,0:05:09.58,0:05:13.58,Style1,,0,0,0,,Бүгінгі кешкі ас нағыз рахат болады!
Dialogue: 0,0:05:09.68,0:05:13.28,jp.sub-ja,,0,0,0,,Бүгінгі кешкі ас той болады.
Dialogue: 0,0:05:13.58,0:05:16.25,Style1,,0,0,0,,Қалай ойлайсың, Харухи? Сіз бұл үлкен краб деп ойлайсыз ба...
Dialogue: 0,0:05:13.74,0:05:17.74,jp.sub-ja,,0,0,0,,Қалай ойлайсың, Харухи? Үлкен краб - менің сүйікті крабым.
Dialogue: 0,0:05:16.25,0:05:18.28,Style1,,0,0,0,,...шаянды қоздыру?
Dialogue: 0,0:05:19.76,0:05:21.26,Style1,,0,0,0,,Оған не болды? Ол жалғыз өзі салқынқанды болып жүр.
Dialogue: 0,0:05:19.89,0:05:20.35,jp.sub-ja,,0,0,0,,Ұнады
Dialogue: 0,0:05:21.26,0:05:22.59,Style1,,0,0,0,,Қандай сүйкімді!
Dialogue: 0,0:05:21.33,0:05:22.05,jp.sub-ja,,0,0,0,,Сүйкімді
Dialogue: 0,0:05:25.43,0:05:26.60,Style1,,0,0,0,,Цент...
Dialogue: 0,0:05:26.60,0:05:27.60,Style1,,0,0,0,,...ti...
Dialogue: 0,0:05:27.60,0:05:29.09,Style1,,0,0,0,,...пед!
Dialogue: 0,0:05:37.27,0:05:38.94,Style1,,0,0,0,,Эй, Харухи...
Dialogue: 0,0:05:37.37,0:05:38.49,jp.sub-ja,,0,0,0,,Сәлем Харухи
Dialogue: 0,0:05:38.94,0:05:40.28,Style1,,0,0,0,,Қанша азап шегеді
Dialogue: 0,0:05:39.16,0:05:43.83,jp.sub-ja,,0,0,0,,Жәндіктерді жақсы көретін ақкөңіл қыз болсаң да, маған жүз қадам бер.
Dialogue: 0,0:05:40.28,0:05:43.88,Style1,,0,0,0,,өзіңді құртқұмар, ақкөңіл қыз деп ойлау...
Dialogue: 0,0:05:43.88,0:05:46.88,Style1,,0,0,0,,...ең болмаса әлгі затты ақырын босатып жібере алмадың ба?
Dialogue: 0,0:05:44.09,0:05:46.57,jp.sub-ja,,0,0,0,,Тым болмаса ақырын босатсаңыз, көмектесе алмайсыз.
Dialogue: 0,0:05:46.88,0:05:50.39,Style1,,0,0,0,,Жарайды. Оны өлтіру үшін одан да көп қажет болады.
Dialogue: 0,0:05:46.96,0:05:49.95,jp.sub-ja,,0,0,0,,Жарайды, мен одан өлмеймін.
Dialogue: 0,0:05:50.39,0:05:52.49,Style1,,0,0,0,,Харухи-кун сондай ерке.
Dialogue: 0,0:05:50.52,0:05:52.36,jp.sub-ja,,0,0,0,,Харухи ер мінезді көрінеді
Dialogue: 0,0:05:52.49,0:05:54.22,Style1,,0,0,0,,Сонда да жақсы, иә?
Dialogue: 0,0:05:52.59,0:05:54.22,jp.sub-ja,,0,0,0,,Бұл оңай.
Dialogue: 0,0:05:54.22,0:05:55.88,Style1,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:05:54.32,0:05:55.32,jp.sub-ja,,0,0,0,,Керемет
Dialogue: 0,0:05:58.56,0:06:00.40,Style1,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:05:58.65,0:05:59.96,jp.sub-ja,,0,0,0,,Жақсы.
Dialogue: 0,0:06:00.40,0:06:03.90,Style1,,0,0,0,,Әдетте қыздар мүлдем басқаша әрекет етеді.
Dialogue: 0,0:06:00.54,0:06:03.61,jp.sub-ja,,0,0,0,,Оның реакциясы қарапайым қыздың реакциясынан мүлде басқаша.
Dialogue: 0,0:06:03.90,0:06:06.89,Style1,,0,0,0,,Оның қорқатын ештеңесі жоқ па?
Dialogue: 0,0:06:04.08,0:06:06.16,jp.sub-ja,,0,0,0,,Оның қорқынышты ештеңесі жоқ па?
Dialogue: 0,0:06:08.40,0:06:10.57,Style1,,0,0,0,,Мырза! Мырза!
Dialogue: 0,0:06:08.56,0:06:09.45,jp.sub-ja,,0,0,0,,лорд мырза
Dialogue: 0,0:06:10.57,0:06:13.22,jp.sub-ja,,0,0,0,,Маған қызықты ойын келді, қатысқым келеді.
Dialogue: 0,0:06:10.57,0:06:13.91,Style1,,0,0,0,,Біз жай ғана көңілді ойын ойлап таптық. Ойнағыңыз келе ме?
Dialogue: 0,0:06:13.91,0:06:15.24,Style1,,0,0,0,,Біз оны...
Dialogue: 0,0:06:14.10,0:06:19.97,jp.sub-ja,,0,0,0,,«Харухидің әлсіз тұсын кім таба алады?» атты ойын.
Dialogue: 0,0:06:15.24,0:06:20.58,Style1,,0,0,0,,...«Харухидің әлсіздігін кім таба алады?» ойын!
Dialogue: 0,0:06:20.58,0:06:22.58,Style1,,0,0,0,,Қандай қорқынышты ойын.
Dialogue: 0,0:06:20.87,0:06:22.42,jp.sub-ja,,0,0,0,,Қандай дәмсіз ойын.
Dialogue: 0,0:06:22.58,0:06:24.25,Style1,,0,0,0,,Иә, сіз дұрыс шығарсыз.
Dialogue: 0,0:06:22.89,0:06:27.40,jp.sub-ja,,0,0,0,,Дұрыс, мен өзімнің осал тұстарымды жақын адамдарға ғана көрсетемін.
Dialogue: 0,0:06:24.25,0:06:28.26,Style1,,0,0,0,,Ол өзінің әлсіздігін жақын адамына ғана көрсететін еді.
Dialogue: 0,0:06:28.26,0:06:29.93,Style1,,0,0,0,,Ережелер қандай!?
Dialogue: 0,0:06:28.51,0:06:29.21,jp.sub-ja,,0,0,0,,Ережелер
Dialogue: 0,0:06:29.90,0:06:31.22,jp.sub-ja,,0,0,0,,Мен мұны істеуім керек.
Dialogue: 0,0:06:29.93,0:06:31.26,Style1,,0,0,0,,Соған көбірек ұқсайды.
Dialogue: 0,0:06:31.26,0:06:32.93,Style1,,0,0,0,,Соңғы мерзім ертең күн батқанда.
Dialogue: 0,0:06:31.52,0:06:32.93,jp.sub-ja,,0,0,0,,Тапсыру мерзімі ертең кешке
Dialogue: 0,0:06:32.93,0:06:35.93,Style1,,0,0,0,,Кім бірінші өзінің кемшілігін тапса, сол жеңеді.
Dialogue: 0,0:06:33.15,0:06:35.24,jp.sub-ja,,0,0,0,,Әлсіз жерді кім бірінші тапса, сол жеңеді
Dialogue: 0,0:06:35.93,0:06:39.26,Style1,,0,0,0,,Мен кім берсе, сол жүлде алады.
Dialogue: 0,0:06:36.12,0:06:39.06,jp.sub-ja,,0,0,0,,Жеңімпазға сыйлық беремін.
Dialogue: 0,0:06:41.10,0:06:43.54,Style1,,0,0,0,,Біз де осымен айналысамыз!
Dialogue: 0,0:06:41.32,0:06:42.98,jp.sub-ja,,0,0,0,,Біз де араластырамыз.
Dialogue: 0,0:06:43.54,0:06:46.20,Style1,,0,0,0,,Сонымен, барлығы ойнап жатыр.
Dialogue: 0,0:06:43.78,0:06:45.99,jp.sub-ja,,0,0,0,,Олай болса барлығы қатысуы керек.
Dialogue: 0,0:06:47.54,0:06:52.21,Style1,,0,0,0,,Бірақ Киочан, бұл фотолар сенде қалай?
Dialogue: 0,0:06:47.66,0:06:50.99,jp.sub-ja,,0,0,0,,Бірақ Киочан, бұл фото сенде неге?
Dialogue: 0,0:06:52.21,0:06:56.55,Style1,,0,0,0,,Менің көздерім бар. Неге біз оны осылай қалдырмасқа?
Dialogue: 0,0:06:52.45,0:06:56.16,jp.sub-ja,,0,0,0,,Мұны белгілі бір дереккөзден айтайын.
Dialogue: 0,0:06:58.05,0:06:59.96,Style2,,0,0,0,,«Сосын...»
Dialogue: 0,0:06:59.96,0:07:00.89,Style2,,0,0,0,,«Ойындар басталсын!»
Dialogue: 0,0:07:03.06,0:07:04.56,Style1,,0,0,0,,Бұл жер...
Dialogue: 0,0:07:03.19,0:07:08.91,jp.sub-ja,,0,0,0,,Бұл жер тіпті жергілікті тұрғындар сирек баратын елушілер жері деп айтылады.
Dialogue: 0,0:07:04.56,0:07:06.90,Style1,,0,0,0,,...паранормальды нүкте деп айтылады,
Dialogue: 0,0:07:06.90,0:07:09.23,Style1,,0,0,0,,оған тіпті жергілікті тұрғындар да жиі келе бермейді.
Dialogue: 0,0:07:09.23,0:07:13.57,Style1,,0,0,0,,Бұл үңгір судың төмен түсуінде ғана көрінеді.
Dialogue: 0,0:07:09.49,0:07:13.04,jp.sub-ja,,0,0,0,,Бұл үңгір судың ағысы азайғанда ғана пайда болады.
Dialogue: 0,0:07:13.57,0:07:17.91,Style1,,0,0,0,,Осы уақытқа дейін мұнда көп адам суға батып кетті дейді.
Dialogue: 0,0:07:13.78,0:07:17.10,jp.sub-ja,,0,0,0,,Көптеген адамдар суға батып өлген көрінеді.
Dialogue: 0,0:07:17.91,0:07:23.25,Style1,,0,0,0,,Созылған реніш жолдан өткендерді қараңғылыққа сүйрейді дейді.
Dialogue: 0,0:07:18.02,0:07:22.92,jp.sub-ja,,0,0,0,,Сол кісілердің өшпенділігі өтіп бара жатқандарды қараңғылыққа тартатын сияқты.
Dialogue: 0,0:07:23.25,0:07:24.58,Style1,,0,0,0,,Мынау не бар!?
Dialogue: 0,0:07:23.31,0:07:24.14,jp.sub-ja,,0,0,0,,Бұл не?
Dialogue: 0,0:07:29.59,0:07:32.42,Style1,,0,0,0,,Бұл не? Батылдық сынағы немесе бір нәрсе ме?
Dialogue: 0,0:07:29.82,0:07:32.02,jp.sub-ja,,0,0,0,,Бұл батылдықты сынау ма?
Dialogue: 0,0:07:33.59,0:07:36.93,Style1,,0,0,0,,Сіз елестерден қорықпайсыз ба?
Dialogue: 0,0:07:33.67,0:07:36.61,jp.sub-ja,,0,0,0,,Сіз елестерден қорықпайсыз ба?
Dialogue: 0,0:07:36.93,0:07:39.60,Style1,,0,0,0,,Мен ешқашан көрген емеспін.
Dialogue: 0,0:07:37.16,0:07:38.97,jp.sub-ja,,0,0,0,,Мен оны бұрын ешқашан көрген емеспін.
Dialogue: 0,0:07:39.60,0:07:41.76,Style2,,0,0,0,,«Паранормальды қорқыныш стратегиясы... сәтсіз аяқталды»
Dialogue: 0,0:07:41.93,0:07:45.20,Style1,,0,0,0,,Хару-чан! Мұнда, мына жерде!
Dialogue: 0,0:07:42.04,0:07:44.35,jp.sub-ja,,0,0,0,,Хару-чан мына жерде, мында
Dialogue: 0,0:07:45.20,0:07:47.20,Style1,,0,0,0,,Олар дәл қашан осы үйдің бір бөлігіне айналды?
Dialogue: 0,0:07:45.36,0:07:46.48,jp.sub-ja,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:07:47.20,0:07:51.21,Style1,,0,0,0,,Бұл заттың жағажайда болуына рұқсат етілген бе?
Dialogue: 0,0:07:47.48,0:07:50.52,jp.sub-ja,,0,0,0,,Жағаға осындай нәрсені қоюға болады ма?
Dialogue: 0,0:07:51.21,0:07:56.37,Style1,,0,0,0,,Жарайды, жеке полиция қызметкерлері, рұқсат етсеңіз!
Dialogue: 0,0:07:51.49,0:07:55.75,jp.sub-ja,,0,0,0,,Олай болса, жеке полиция, өтінемін.
Dialogue: 0,0:08:02.53,0:08:05.86,jp.sub-ja,,0,0,0,,Қараңғы, кішкентай, қорқынышты
Dialogue: 0,0:08:02.55,0:08:04.55,Style1,,0,0,0,,Бұл қараңғы, әрі жабық, әрі қорқынышты! Бұл қараңғы, жабық және қорқынышты!
Dialogue: 0,0:08:04.55,0:08:06.99,Style1,,0,0,0,,- Бал- сенпай... ...және жабық, әрі қорқынышты!
Dialogue: 0,0:08:04.78,0:08:05.85,jp.sub-ja,,0,0,0,,Бал-сенпай
Dialogue: 0,0:08:05.12,0:08:10.11,Style2,,0,0,0,,"Клаустрофобия шабуылының стратегиясы... сәтсіз аяқталды"
Dialogue: 0,0:08:05.86,0:08:10.16,jp.sub-ja,,0,0,0,,Қараңғы, кішкентай, қорқынышты
Dialogue: 0,0:08:06.99,0:08:10.12,Style1,,0,0,0,,Бұл қараңғы, жабық және қорқынышты!
Dialogue: 0,0:08:11.89,0:08:15.23,Style1,,0,0,0,,Бұл мори, дұрыс,
Dialogue: 0,0:08:11.89,0:08:16.87,Style2,,0,0,0,,``Мори: гарпун''
Dialogue: 0,0:08:12.12,0:08:16.12,jp.sub-ja,,0,0,0,,Бұл гарпун, Мори-сенпай.
Dialogue: 0,0:08:15.23,0:08:17.57,Style1,,0,0,0,,Мори-сенпай?
Dialogue: 0,0:08:16.87,0:08:18.83,Style2,,0,0,0,,«Сөз ойыны?»
Dialogue: 0,0:08:17.57,0:08:18.83,Style1,,0,0,0,,Оқу, оқу
Dialogue: 0,0:08:18.83,0:08:20.80,Style2,,0,0,0,,«Өткір заттардан қорқу стратегиясы... сәтсіз аяқталды»
Dialogue: 0,0:08:21.57,0:08:24.24,Style1,,0,0,0,,Бұл ойынның пайдасы жоқ, иә?
Dialogue: 0,0:08:21.86,0:08:23.66,jp.sub-ja,,0,0,0,,Бұл ойын мүмкін емес.
Dialogue: 0,0:08:24.24,0:08:27.58,Style1,,0,0,0,,А... Мен жалығып бара жатырмын.
Dialogue: 0,0:08:24.49,0:08:27.18,jp.sub-ja,,0,0,0,,Бұл қызықсыз.
Dialogue: 0,0:08:27.58,0:08:29.71,Style1,,0,0,0,,Ол қаһарман болуға дайын емес,
Dialogue: 0,0:08:27.78,0:08:29.50,jp.sub-ja,,0,0,0,,Ештеңе соншалықты қорқынышты емес
Dialogue: 0,0:08:29.71,0:08:32.92,Style1,,0,0,0,,ол қорықпайтын нәрселермен.
Dialogue: 0,0:08:29.86,0:08:31.60,jp.sub-ja,,0,0,0,,Батыр ана болу құқығынан айырылған жоқ па?
Dialogue: 0,0:08:32.92,0:08:34.92,Style1,,0,0,0,,Шекара сызықтары?
Dialogue: 0,0:08:34.92,0:08:36.92,Style1,,0,0,0,,- Мырза? - Сен не істеп жатырсың?
Dialogue: 0,0:08:35.10,0:08:36.81,jp.sub-ja,,0,0,0,,Мырза, сіз не істеп жатырсыз?
Dialogue: 0,0:08:36.92,0:08:40.92,Style1,,0,0,0,,егеуқұйрық жыландар! Осыншама көп адамның бірге болуы ыңғайсыз болуы керек, солай ма?
Dialogue: 0,0:08:37.05,0:08:38.10,jp.sub-ja,,0,0,0,,Бұл көк генерал.
Dialogue: 0,0:08:38.46,0:08:40.70,jp.sub-ja,,0,0,0,,Осыншама жинау жиіркенішті болуы керек.
Dialogue: 0,0:08:40.92,0:08:45.09,Style1,,0,0,0,,Кез келген адам бұларды жағымсыз деп санайды. Бұл әлсіздік емес.
Dialogue: 0,0:08:41.08,0:08:44.33,jp.sub-ja,,0,0,0,,Бұл бәріне жиіркенішті. Бұл әлсіздік емес.
Dialogue: 0,0:08:45.09,0:08:49.53,Style1,,0,0,0,,Олай болса, Окинавада егеуқұйрық жыландар бар ма?
Dialogue: 0,0:08:45.25,0:08:48.97,jp.sub-ja,,0,0,0,,Бірақ Окинавада көк генерал болды ма?
Dialogue: 0,0:08:51.10,0:08:52.60,Style1,,0,0,0,,Және тағы бір гарнир...
Dialogue: 0,0:08:51.26,0:08:52.55,jp.sub-ja,,0,0,0,,Гарнир алыңыз
Dialogue: 0,0:08:52.60,0:08:54.44,Style1,,0,0,0,,Харухи-кун!
Dialogue: 0,0:08:52.86,0:08:54.15,jp.sub-ja,,0,0,0,,Харухи-кун
Dialogue: 0,0:08:54.44,0:08:55.60,Style1,,0,0,0,,Сәлем!
Dialogue: 0,0:08:55.60,0:08:57.61,Style1,,0,0,0,,Бұл жел керемет!
Dialogue: 0,0:08:55.78,0:08:57.36,jp.sub-ja,,0,0,0,,Жел жақсы сезінеді
Dialogue: 0,0:08:57.61,0:08:59.94,Style1,,0,0,0,,Ол жерде қауіпті.
Dialogue: 0,0:08:57.83,0:08:59.17,jp.sub-ja,,0,0,0,,Бұл қауіпті
Dialogue: 0,0:09:00.94,0:09:02.95,Style1,,0,0,0,,Бұл керемет сезім, иә?
Dialogue: 0,0:09:01.37,0:09:02.53,jp.sub-ja,,0,0,0,,Өзін жақсы сезінеді
Dialogue: 0,0:09:02.95,0:09:03.95,Style1,,0,0,0,,мм-мм.
Dialogue: 0,0:09:03.95,0:09:06.62,Style1,,0,0,0,,Оо, мұнда қыздар бар!
Dialogue: 0,0:09:04.82,0:09:06.19,jp.sub-ja,,0,0,0,,Мұнда бір қыз бар.
Dialogue: 0,0:09:06.62,0:09:10.62,Style1,,0,0,0,,Бақытты! Әй қыздар, бірге ойнайық.
Dialogue: 0,0:09:06.96,0:09:08.06,jp.sub-ja,,0,0,0,,Сен басқа әлемнен келгеніңді айтасың ба?
Dialogue: 0,0:09:08.33,0:09:10.42,jp.sub-ja,,0,0,0,,Қыздар, бірге ойнайық.
Dialogue: 0,0:09:10.62,0:09:12.96,Style1,,0,0,0,,Мұнда не істеп жүрсіңдер?
Dialogue: 0,0:09:10.77,0:09:12.37,jp.sub-ja,,0,0,0,,Балалар сендер кімсіңдер?
Dialogue: 0,0:09:12.94,0:09:16.21,jp.sub-ja,,0,0,0,,Жақсы, тек қыздар болса қызық болмас еді.
Dialogue: 0,0:09:12.96,0:09:16.02,Style1,,0,0,0,,Кімге бәрібір? Айналасында қыздардан басқа ешкімнің болмағаны қызық болар, иә?
Dialogue: 0,0:09:16.02,0:09:19.29,Style1,,0,0,0,,Тоқтаңыз. Бұл «жеке жағажай».
Dialogue: 0,0:09:16.23,0:09:19.24,jp.sub-ja,,0,0,0,,Тоқтаңыз. Бұл жеке жағажай.
Dialogue: 0,0:09:19.24,0:09:21.61,jp.sub-ja,,0,0,0,,Бұл не, жас ханым?
Dialogue: 0,0:09:19.29,0:09:21.96,Style1,,0,0,0,,Бұл не? Бұл «жандарым» дегенді білдіре ме?
Dialogue: 0,0:09:22.86,0:09:23.84,jp.sub-ja,,0,0,0,,Ау
Dialogue: 0,0:09:22.97,0:09:24.97,Style1,,0,0,0,,Ой-оу!
Dialogue: 0,0:09:24.97,0:09:28.64,Style1,,0,0,0,,Сіз қазір кетесіз бе? Олар сені қаламайды.
Dialogue: 0,0:09:25.29,0:09:26.77,jp.sub-ja,,0,0,0,,Сіз кете аласыз ба?
Dialogue: 0,0:09:27.04,0:09:30.29,jp.sub-ja,,0,0,0,,Сізге бұл ұнамайтын шығар. Сіз бұл ыңғайсыздық деп айтасыз.
Dialogue: 0,0:09:28.64,0:09:30.47,Style1,,0,0,0,,Сен оларды мазалап жүрсің дейді.
Dialogue: 0,0:09:30.47,0:09:31.64,Style1,,0,0,0,,Харухи-кун...
Dialogue: 0,0:09:30.77,0:09:31.52,jp.sub-ja,,0,0,0,,Харухи-кун
Dialogue: 0,0:09:31.64,0:09:33.31,Style1,,0,0,0,,Неге, балақай...
Dialogue: 0,0:09:31.87,0:09:32.83,jp.sub-ja,,0,0,0,,Бұл бала
Dialogue: 0,0:09:33.31,0:09:36.04,Style1,,0,0,0,,Хабу жыландар! Бұл хабу жыландары, сэр!
Dialogue: 0,0:09:33.31,0:09:36.04,Style2,,0,0,0,,«Хабу: Окинавада тұратын улы жылан»
Dialogue: 0,0:09:33.50,0:09:36.13,jp.sub-ja,,0,0,0,,Бұл хаб. Бұл хаб.
Dialogue: 0,0:09:36.04,0:09:38.65,Style1,,0,0,0,,Мен не істеймін!?
Dialogue: 0,0:09:36.15,0:09:39.26,jp.sub-ja,,0,0,0,,Не істеуім керек, олар мені осылай ұстады ма?
Dialogue: 0,0:09:38.65,0:09:39.71,jp.sub-ja,,0,0,0,,Тамаки-сама
Dialogue: 0,0:09:38.65,0:09:39.98,Style1,,0,0,0,,Тамаки-сама!
Dialogue: 0,0:09:41.65,0:09:43.08,Style1,,0,0,0,,Бұл Харухи-кун!
Dialogue: 0,0:09:41.76,0:09:42.59,jp.sub-ja,,0,0,0,,Харухи-кун
Dialogue: 0,0:09:46.88,0:09:49.00,jp.sub-ja,,0,0,0,,Бұл жіңішке қол дегеніміз не?
Dialogue: 0,0:09:46.92,0:09:49.26,Style1,,0,0,0,,Бұл иілгіш қолдарда не бар?
Dialogue: 0,0:09:49.26,0:09:50.09,Style1,,0,0,0,,Харухи-кун!
Dialogue: 0,0:09:49.29,0:09:50.19,jp.sub-ja,,0,0,0,,Харухи-кун
Dialogue: 0,0:09:50.09,0:09:53.26,Style1,,0,0,0,,Қарындас бала болған соң, қатал әрекетке барма!
Dialogue: 0,0:09:50.19,0:09:52.72,jp.sub-ja,,0,0,0,,Әйелге ұқсамасаңыз да, киінбейсіз.
Dialogue: 0,0:09:53.26,0:09:56.93,Style1,,0,0,0,,Бала, сен мұхитқа шомылсаң болды...
Dialogue: 0,0:09:53.41,0:09:56.25,jp.sub-ja,,0,0,0,,Бала теңізде жүзгенде де тыныш.
Dialogue: 0,0:09:56.93,0:09:57.93,Style1,,0,0,0,,Харухи!
Dialogue: 0,0:09:56.96,0:09:57.63,jp.sub-ja,,0,0,0,,Харухи
Dialogue: 0,0:09:57.93,0:10:00.27,Style1,,0,0,0,,...жақсы бала сияқты!
Dialogue: 0,0:09:57.95,0:09:59.56,jp.sub-ja,,0,0,0,,Орындаңыз
Dialogue: 0,0:10:29.97,0:10:31.30,Style1,,0,0,0,,Хару-чан!
Dialogue: 0,0:10:30.25,0:10:30.93,jp.sub-ja,,0,0,0,,Хару-чан
Dialogue: 0,0:10:31.30,0:10:33.47,Style1,,0,0,0,,Мырза!
Dialogue: 0,0:10:31.43,0:10:32.06,jp.sub-ja,,0,0,0,,Мырза
Dialogue: 0,0:10:33.47,0:10:34.64,Style1,,0,0,0,,Олар қайда?
Dialogue: 0,0:10:33.68,0:10:34.33,jp.sub-ja,,0,0,0,,Сол жігіттер
Dialogue: 0,0:10:34.64,0:10:39.07,Style1,,0,0,0,,Біз олардың жеке куәліктерін сақтап қалдық және құрметпен кетулерін өтіндік.
Dialogue: 0,0:10:34.94,0:10:38.15,jp.sub-ja,,0,0,0,,Менен жеке куәлігімді қалдыруды өтінді.
Dialogue: 0,0:10:39.07,0:10:41.64,Style1,,0,0,0,,Қыздар қонақүйге қайтты.
Dialogue: 0,0:10:39.29,0:10:41.03,jp.sub-ja,,0,0,0,,Қыздар қонақ үйге қайтты.
Dialogue: 0,0:10:41.64,0:10:45.25,Style1,,0,0,0,,Мен дәрігерді шақырдым, ол жақын арада осында болуы керек.
Dialogue: 0,0:10:41.91,0:10:44.56,jp.sub-ja,,0,0,0,,Мен дәрігерді шақырдым, ол бірден келеді.
Dialogue: 0,0:10:45.25,0:10:46.25,Style1,,0,0,0,,Б... бір сызық
Dialogue: 0,0:10:45.37,0:10:45.75,jp.sub-ja,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:46.25,0:10:49.92,Style1,,0,0,0,,Менде бәрі жақсы. Маған дәрігер керек емес.
Dialogue: 0,0:10:46.30,0:10:48.52,jp.sub-ja,,0,0,0,,Жарайды, дәрігер жоқ.
Dialogue: 0,0:10:49.92,0:10:51.92,Style1,,0,0,0,,Сіз солардың бірісіз бе?
Dialogue: 0,0:10:50.11,0:10:51.01,jp.sub-ja,,0,0,0,,Сіз бұлсыз ба?
Dialogue: 0,0:10:51.92,0:10:57.26,Style1,,0,0,0,,Шынында, Балсенпай сияқты жекпе-жек шебері ме?
Dialogue: 0,0:10:52.01,0:10:56.58,jp.sub-ja,,0,0,0,,Ол шын мәнінде Бал сенпай сияқты жекпе-жек шебері ме?
Dialogue: 0,0:10:58.93,0:11:01.60,Style1,,0,0,0,,Сіз өзіңізді, қыз, жалғыз деп қалай ойлайсыз?
Dialogue: 0,0:10:59.09,0:11:00.34,jp.sub-ja,,0,0,0,,Жалғыз әйел ретінде
Dialogue: 0,0:11:00.98,0:11:04.40,jp.sub-ja,,0,0,0,,Неліктен сіз ер адамдармен кез келген нәрсені жасай аласыз деп ойлайсыз?
Dialogue: 0,0:11:01.60,0:11:04.60,Style1,,0,0,0,,Ол балаларға қарсы бірдеңе істей алар ма еді!?
Dialogue: 0,0:11:04.60,0:11:07.60,Style1,,0,0,0,,Оның ұл немесе қыз болуына еш қатысы жоқ.
Dialogue: 0,0:11:04.94,0:11:07.28,jp.sub-ja,,0,0,0,,Ер адамсың ба, әйелсің бе бәрібір.
Dialogue: 0,0:11:07.60,0:11:10.61,Style1,,0,0,0,,Мен дәл сол жерде болдым және ештеңе туралы ойлауға уақытым болмады
Dialogue: 0,0:11:07.87,0:11:11.06,jp.sub-ja,,0,0,0,,Менің мұндай жерде болып, ондай нәрселерді ойлауға уақытым жоқ...
Dialogue: 0,0:11:10.61,0:11:14.28,Style1,,0,0,0,,Жақсы ойлан, ақымақ! Сен қызсың!
Dialogue: 0,0:11:10.75,0:11:13.79,jp.sub-ja,,0,0,0,,Ойлан, ақымақ, сен әйелсің.
Dialogue: 0,0:11:14.28,0:11:17.28,Style1,,0,0,0,,Артымнан ергенім үшін кешірім сұраймын,
Dialogue: 0,0:11:14.56,0:11:16.54,jp.sub-ja,,0,0,0,,Сізге қиындық тудырғаным үшін кешірім сұраймын.
Dialogue: 0,0:11:17.28,0:11:20.28,Style1,,0,0,0,,, бірақ сенің маған ашулануының басқа себебін түсінбеймін.
Dialogue: 0,0:11:17.59,0:11:19.83,jp.sub-ja,,0,0,0,,Одан басқа ашуланудың мәнісін түсінбеймін.
Dialogue: 0,0:11:20.28,0:11:23.62,Style1,,0,0,0,,Мен қателескен жоқпын.
Dialogue: 0,0:11:20.49,0:11:21.91,jp.sub-ja,,0,0,0,,Мен қателескен жоқпын.
Dialogue: 0,0:11:23.62,0:11:27.79,Style1,,0,0,0,,Сізде жоқ, иә? Содан кейін сіз дәл алға барасыз.
Dialogue: 0,0:11:23.85,0:11:26.70,jp.sub-ja,,0,0,0,,Дұрыс, онда қалағаныңды істе.
Dialogue: 0,0:11:27.79,0:11:31.28,Style1,,0,0,0,,Сіз қателескеніңізді мойындамайынша мен сізбен қайта сөйлеспеймін!
Dialogue: 0,0:11:27.95,0:11:30.62,jp.sub-ja,,0,0,0,,Қателігіңді мойындамайынша мен сенімен сөйлеспеймін.
Dialogue: 0,0:11:38.07,0:11:38.97,Style1,,0,0,0,,«Отори отбасылық вилласы»
Dialogue: 0,0:11:38.07,0:11:40.83,Style2,,0,0,0,,«Отори отбасылық вилласы»
Dialogue: 0,0:11:38.97,0:11:40.84,Style1,,0,0,0,,«Отори отбасылық вилла» Та-да!
Dialogue: 0,0:11:40.84,0:11:40.97,Style1,,0,0,0,,Та-да!
Dialogue: 0,0:11:40.97,0:11:43.57,Style1,,0,0,0,,Шаяндардың бәрі қайнатылған!
Dialogue: 0,0:11:41.04,0:11:43.26,jp.sub-ja,,0,0,0,,Шаян қайнатылған.
Dialogue: 0,0:11:43.57,0:11:47.24,Style1,,0,0,0,,Кешіріңіз, Сенпай, қазір мұнда қызметші қыз жоқ.
Dialogue: 0,0:11:43.84,0:11:47.00,jp.sub-ja,,0,0,0,,Кешіріңіз, Сенпай, менің қазір қызметші қызым жоқ.
Dialogue: 0,0:11:47.24,0:11:51.25,Style1,,0,0,0,,Біз сіздің виллаңызға кіргенбіз, Кио Чан.
Dialogue: 0,0:11:47.56,0:11:50.27,jp.sub-ja,,0,0,0,,Кио-чанның вилласына басып кірген біз едік.
Dialogue: 0,0:11:51.25,0:11:53.91,Style1,,0,0,0,,Такаши, Хару-чанды шақыр.
Dialogue: 0,0:11:51.35,0:11:53.02,jp.sub-ja,,0,0,0,,Такаши Хару-чанды шақырды.
Dialogue: 0,0:11:55.42,0:11:59.59,Style1,,0,0,0,,Ол жақта өте мұңды, иә? Жаңбыр жаууы мүмкін сияқты.
Dialogue: 0,0:11:55.53,0:11:59.23,jp.sub-ja,,0,0,0,,Шынымен қараңғы. Жаңбыр жауатын сияқты.
Dialogue: 0,0:11:59.59,0:12:02.26,Style1,,0,0,0,,Мұңды туралы айтатын болсақ...
Dialogue: 0,0:11:59.68,0:12:01.14,jp.sub-ja,,0,0,0,,Қараңғы туралы айту.
Dialogue: 0,0:12:02.26,0:12:06.76,Style1,,0,0,0,,Бұл жерде сырттағы қараңғылықтан да мұңды біреу бар.
Dialogue: 0,0:12:02.57,0:12:06.56,jp.sub-ja,,0,0,0,,Мұнда сырттағы қараңғылықтан да қараңғы біреу бар.
Dialogue: 0,0:12:06.64,0:12:10.53,jp.sub-ja,,0,0,0,,Егер сіз соншалықты күйзеліске ұшырасаңыз, төбелесуге болмайды.
Dialogue: 0,0:12:06.76,0:12:08.60,Style1,,0,0,0,,Егер сіз осылай сүртетін болсаңыз...
Dialogue: 0,0:12:08.60,0:12:11.26,Style1,,0,0,0,,...онда сіз онымен ұрыспауыңыз керек еді.
Dialogue: 0,0:12:22.94,0:12:25.11,Style1,,0,0,0,,Харухи, сен ол көйлекті өзің сатып алдың ба?
Dialogue: 0,0:12:23.18,0:12:24.83,jp.sub-ja,,0,0,0,,Харухи, сен өз киіміңді ала келдің бе?
Dialogue: 0,0:12:25.11,0:12:28.95,Style1,,0,0,0,,Әкем маған сөмкелерімді қайта жинаған болуы керек.
Dialogue: 0,0:12:25.29,0:12:28.45,jp.sub-ja,,0,0,0,,Әкем рұқсатсыз жүктерімді қайта жинап алған сияқты.
Dialogue: 0,0:12:28.95,0:12:31.79,Style1,,0,0,0,,Ол менің үнемі осындай киім кигенімді қалайды.
Dialogue: 0,0:12:29.16,0:12:31.55,jp.sub-ja,,0,0,0,,Олар үнемі осындай заттарды кигісі келеді.
Dialogue: 0,0:12:31.79,0:12:34.12,Style1,,0,0,0,,Жақсы жұмыс, Харухидің әкесі!
Dialogue: 0,0:12:31.86,0:12:33.93,jp.sub-ja,,0,0,0,,Жақсы жұмыс Харухи әке
Dialogue: 0,0:12:31.92,0:12:33.68,Style2,,0,0,0,,«Ха-ру-хидің әкесі!»
Dialogue: 0,0:12:34.12,0:12:36.61,Style1,,0,0,0,,Хару-чан, сен сүйкімді көрінесің.
Dialogue: 0,0:12:34.32,0:12:36.25,jp.sub-ja,,0,0,0,,Хару-чан сүйкімді
Dialogue: 0,0:12:47.84,0:12:50.24,Style1,,0,0,0,,Ауа бұлыңғыр, иә?
Dialogue: 0,0:12:47.98,0:12:49.54,jp.sub-ja,,0,0,0,,Ауа нашар.
Dialogue: 0,0:12:50.24,0:12:52.71,Style1,,0,0,0,,Бұл жерде шиеленіс.
Dialogue: 0,0:12:50.39,0:12:51.86,jp.sub-ja,,0,0,0,,Мен шиеленісті сезінемін.
Dialogue: 0,0:12:54.08,0:12:56.08,Style1,,0,0,0,,Тамақтанып алайық, Хару-чан!
Dialogue: 0,0:12:54.19,0:12:55.62,jp.sub-ja,,0,0,0,,Хару-чанды жейік
Dialogue: 0,0:12:56.08,0:12:59.41,Style1,,0,0,0,,Бүгін біз ұстаған шаяндардың дәмді екеніне сенімдімін.
Dialogue: 0,0:12:56.23,0:12:59.17,jp.sub-ja,,0,0,0,,Мен бүгін ұстаған шаянның дәмді болатыны сөзсіз.
Dialogue: 0,0:13:00.52,0:13:07.92,Style1,,0,0,0,,«Сөз ойыны?»
Dialogue: 0,0:13:07.92,0:13:10.26,Style1,,0,0,0,,Бұл шаяндар...
Dialogue: 0,0:13:08.15,0:13:11.46,jp.sub-ja,,0,0,0,,Бұл краб өте дәмді.
Dialogue: 0,0:13:10.26,0:13:12.59,Style1,,0,0,0,,...шаянның дәмі.
Dialogue: 0,0:13:12.59,0:13:13.93,Style1,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:13:12.66,0:13:13.59,jp.sub-ja,,0,0,0,,Бұл не?
Dialogue: 0,0:13:19.53,0:13:22.60,Style1,,0,0,0,,Тым көп жеп жатқан жоқсыз ба?
Dialogue: 0,0:13:19.71,0:13:22.65,jp.sub-ja,,0,0,0,,Тамақ ішу артық емес пе?
Dialogue: 0,0:13:22.60,0:13:25.90,Style1,,0,0,0,,Иә? Сіз менімен сөйлеспейсіз деп ойладым.
Dialogue: 0,0:13:22.75,0:13:25.03,jp.sub-ja,,0,0,0,,Сол себепті сөйлемейсің бе?
Dialogue: 0,0:13:25.04,0:13:25.90,Style2,,0,0,0,,«Қарсыл!»
Dialogue: 0,0:13:27.28,0:13:29.47,Style1,,0,0,0,,Y-сен сүйкімді емессің.
Dialogue: 0,0:13:27.44,0:13:29.19,jp.sub-ja,,0,0,0,,Сүйкімді емес
Dialogue: 0,0:13:33.28,0:13:37.62,Style1,,0,0,0,,Жарайды, түсіндім. Сіз не істегеніңізді қайта қарастырмайсыз.
Dialogue: 0,0:13:33.53,0:13:36.93,jp.sub-ja,,0,0,0,,Мен түсіндім. Тәубе ету ниетің жоқ сияқты.
Dialogue: 0,0:13:37.62,0:13:39.62,Style1,,0,0,0,,Жақсы, онда. Мен ұйықтаймын.
Dialogue: 0,0:13:37.64,0:13:39.30,jp.sub-ja,,0,0,0,,Болды, мен ұйықтаймын
Dialogue: 0,0:13:39.62,0:13:41.78,Style1,,0,0,0,,Кёя, маған бөлмемді көрсет.
Dialogue: 0,0:13:39.70,0:13:41.44,jp.sub-ja,,0,0,0,,Кёуя, мені бөлмеме апарыңызшы.
Dialogue: 0,0:13:43.39,0:13:47.38,Style1,,0,0,0,,Жарайды. Жарайды, кешіріңіз десеңіз...
Dialogue: 0,0:13:43.54,0:13:46.97,jp.sub-ja,,0,0,0,,Жарайды, мен алдымен кешірім сұраймын.
Dialogue: 0,0:13:52.90,0:13:57.24,Style1,,0,0,0,,Мүмкін мен шынымен де каратэ немесе басқа нәрсені үйренуім керек шығар.
Dialogue: 0,0:13:53.01,0:13:56.66,jp.sub-ja,,0,0,0,,Мүмкін маған каратэ үйрену керек шығар.
Dialogue: 0,0:13:57.08,0:13:58.72,jp.sub-ja,,0,0,0,,Жалғыз әйел ретінде
Dialogue: 0,0:13:57.24,0:14:00.24,Style1,,0,0,0,,Сіз өзіңізді, қыз, жалғыз деп қалай ойлайсыз?
Dialogue: 0,0:13:59.40,0:14:02.84,jp.sub-ja,,0,0,0,,Неліктен сіз ер адамдармен кез келген нәрсені жасай аласыз деп ойлайсыз?
Dialogue: 0,0:14:00.24,0:14:02.91,Style1,,0,0,0,,Ол балаларға қарсы бірдеңе істей алар ма еді!?
Dialogue: 0,0:14:02.91,0:14:05.58,Style1,,0,0,0,,О, сонда сені мазалайды ма?
Dialogue: 0,0:14:03.10,0:14:05.28,jp.sub-ja,,0,0,0,,Не, саған бәрібір?
Dialogue: 0,0:14:05.58,0:14:08.58,Style1,,0,0,0,,Сіздің ойларыңыз осы бағытта жүреді, солай ма?
Dialogue: 0,0:14:05.69,0:14:08.19,jp.sub-ja,,0,0,0,,Сіздің ойларыңыз осылай жүріп жатыр.
Dialogue: 0,0:14:08.58,0:14:11.59,Style1,,0,0,0,,Біз сізді тоқтататын сияқты емеспіз, немесе басқа нәрсе,
Dialogue: 0,0:14:08.81,0:14:11.03,jp.sub-ja,,0,0,0,,Ал, мен сені тоқтатпаймын.
Dialogue: 0,0:14:11.59,0:14:14.25,Style1,,0,0,0,,бірақ бұл туралы емес, солай емес пе?
Dialogue: 0,0:14:11.79,0:14:13.72,jp.sub-ja,,0,0,0,,Олай емес.
Dialogue: 0,0:14:15.26,0:14:20.26,Style1,,0,0,0,,Шынымды айтсам, бүгін де ойланбастан әрекет еткеніңізді қайта қарастырғаныңызды қалаймын.
Dialogue: 0,0:14:15.35,0:14:19.81,jp.sub-ja,,0,0,0,,Шынымды айтсам, бүгінгідей немқұрайлылығыңыз туралы ой жүгірткеніңізді қалаймын.
Dialogue: 0,0:14:20.26,0:14:24.26,Style1,,0,0,0,,Неліктен? Хикару, мен сендерге қиындық туғызған жоқпын, солай ма?
Dialogue: 0,0:14:20.31,0:14:23.56,jp.sub-ja,,0,0,0,,Неліктен Жарық пен басқаларға қиындық тудырмайсың?
Dialogue: 0,0:14:25.27,0:14:27.27,Style1,,0,0,0,,Бұл дұрыс емес, Хару-чан.
Dialogue: 0,0:14:25.54,0:14:26.69,jp.sub-ja,,0,0,0,,Жоқ, Хару-чан.
Dialogue: 0,0:14:27.27,0:14:30.94,Style1,,0,0,0,,Сіз бәріне кешірім сұрағаныңызды айтуыңыз керек, жарай ма?
Dialogue: 0,0:14:27.47,0:14:30.37,jp.sub-ja,,0,0,0,,Бәрінен кешірім сұраймын, солай ма?
Dialogue: 0,0:14:30.94,0:14:34.61,Style1,,0,0,0,,Түсіндіңіз бе? Ал Тама-чанға кешірім сұрайтыныңды айт
Dialogue: 0,0:14:31.21,0:14:36.25,jp.sub-ja,,0,0,0,,Жақсы, Тама-чанды қатты уайымдатқаным үшін кешіріңіз.
Dialogue: 0,0:14:34.61,0:14:37.61,Style1,,0,0,0,,оны қатты уайымдағаны үшін.
Dialogue: 0,0:14:37.61,0:14:42.45,Style1,,0,0,0,,Бәрің мен үшін уайымдадың ба?
Dialogue: 0,0:14:37.73,0:14:41.15,jp.sub-ja,,0,0,0,,Сіз уайымдадыңыз ба?
Dialogue: 0,0:14:42.45,0:14:44.72,Style1,,0,0,0,,Сіз бұл қызға сенесіз бе?
Dialogue: 0,0:14:42.70,0:14:43.58,jp.sub-ja,,0,0,0,,Бұл бала
Dialogue: 0,0:14:44.72,0:14:46.38,Style1,,0,0,0,,Шекара сызықтары?
Dialogue: 0,0:14:44.80,0:14:48.71,jp.sub-ja,,0,0,0,,Түсіндім, кешіріңіз.
Dialogue: 0,0:14:47.62,0:14:49.89,Style1,,0,0,0,,Мұнда.
Dialogue: 0,0:14:49.89,0:14:52.56,Style1,,0,0,0,,Әй, не үшін, кішкентай мылжың?
Dialogue: 0,0:14:49.97,0:14:52.33,jp.sub-ja,,0,0,0,,Мына кішкентай жануар қандай?
Dialogue: 0,0:14:52.56,0:14:55.43,Style1,,0,0,0,,Сен сондай сүйкімдісің, біз сені кешіреміз!
Dialogue: 0,0:14:52.60,0:14:53.81,jp.sub-ja,,0,0,0,,Мен сені кешіремін, өйткені сен сүйкімдісің
Dialogue: 0,0:14:54.06,0:14:55.43,Style2,,0,0,0,,«Қысу»
Dialogue: 0,0:14:57.23,0:14:58.73,Style1,,0,0,0,,Не болды?
Dialogue: 0,0:14:57.37,0:14:58.13,jp.sub-ja,,0,0,0,,Не болды?
Dialogue: 0,0:14:58.73,0:15:01.30,Style1,,0,0,0,,Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:14:58.86,0:15:00.31,jp.sub-ja,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 0,0:15:01.30,0:15:02.90,Style1,,0,0,0,,Сіз шаянды көп жедіңіз.
Dialogue: 0,0:15:01.46,0:15:02.85,jp.sub-ja,,0,0,0,,Шаянды көп жеу
Dialogue: 0,0:15:02.85,0:15:04.13,jp.sub-ja,,0,0,0,,Хару-чан, мықты бол
Dialogue: 0,0:15:02.90,0:15:04.34,Style1,,0,0,0,,Хару-чан, мықты бол!
Dialogue: 0,0:15:04.34,0:15:06.90,Style1,,0,0,0,,Жүр, жуынатын бөлмеге! Жуынатын бөлме!
Dialogue: 0,0:15:04.41,0:15:06.58,jp.sub-ja,,0,0,0,,Жүр, жуынатын бөлмеге бар.
Dialogue: 0,0:15:11.91,0:15:14.58,Style1,,0,0,0,,Қандай ысырап қылдым.
Dialogue: 0,0:15:12.05,0:15:14.23,jp.sub-ja,,0,0,0,,Мен ысырапшыл нәрсе жасадым.
Dialogue: 0,0:15:15.58,0:15:20.26,Style1,,0,0,0,,Мен сондай асықтым, ең жақын бөлмеге сүңгіп кеттім. Мен қайдамын?
Dialogue: 0,0:15:15.70,0:15:18.48,jp.sub-ja,,0,0,0,,Мен үрейленіп, ең жақын бөлмеге секірдім.
Dialogue: 0,0:15:19.31,0:15:20.17,jp.sub-ja,,0,0,0,,Мұнда
Dialogue: 0,0:15:20.26,0:15:21.92,Style1,,0,0,0,,Барлығы орындалды ма?
Dialogue: 0,0:15:20.44,0:15:21.18,jp.sub-ja,,0,0,0,,Бітірдің бе?
Dialogue: 0,0:15:21.92,0:15:25.26,Style1,,0,0,0,,Бейтаныс адамның бөлмесіне кіргенім үшін кешіріңіз...
Dialogue: 0,0:15:22.24,0:15:24.92,jp.sub-ja,,0,0,0,,Кешіріңіз, мен бейтаныс адамның бөлмесіндемін.
Dialogue: 0,0:15:25.26,0:15:27.60,Style1,,0,0,0,,Қандай дөрекі. Бұл мен.
Dialogue: 0,0:15:25.35,0:15:27.17,jp.sub-ja,,0,0,0,,Дөрекі, бұл менмін.
Dialogue: 0,0:15:27.60,0:15:29.93,Style1,,0,0,0,,Кёя-сенпай?
Dialogue: 0,0:15:27.75,0:15:28.81,jp.sub-ja,,0,0,0,,Кёуя Сенпай
Dialogue: 0,0:15:29.93,0:15:36.27,Style1,,0,0,0,,Ой, кешіріңіз, мен бәрін өзім үшін уайымдатқан сияқтымын.
Dialogue: 0,0:15:31.08,0:15:34.91,jp.sub-ja,,0,0,0,,Кешіріңіз, мен бәріңізді алаңдатқан сияқтымын.
Dialogue: 0,0:15:36.27,0:15:39.43,Style1,,0,0,0,,Мен ерекше алаңдамадым.
Dialogue: 0,0:15:36.41,0:15:38.47,jp.sub-ja,,0,0,0,,Мен ерекше алаңдамаймын.
Dialogue: 0,0:15:42.44,0:15:45.88,Style1,,0,0,0,,Хикару мен Каоруны тоқтату қиын болды
Dialogue: 0,0:15:42.64,0:15:48.34,jp.sub-ja,,0,0,0,,Хикари мен Каору қылмыскерлерді өлтіруге кедергі болатын жалғыз нәрсе.
Dialogue: 0,0:15:45.88,0:15:50.21,Style1,,0,0,0,,сол панктарды жартылай өлімге дейін ұруға тырысудан.
Dialogue: 0,0:15:48.45,0:15:49.73,jp.sub-ja,,0,0,0,,Бұл қиын болды.
Dialogue: 0,0:15:51.89,0:15:57.23,Style1,,0,0,0,,Сондай-ақ, мен қыздарға гүл шоқтарын жіберуге бардым
Dialogue: 0,0:15:52.09,0:15:56.85,jp.sub-ja,,0,0,0,,Енді осы саяхатты тамашалауға келген қыздарға.
Dialogue: 0,0:15:57.23,0:16:00.56,Style1,,0,0,0,,кешірім сұрау арқылы, осы сапарға келуді асыға күткеннен кейін.
Dialogue: 0,0:15:57.32,0:15:59.83,jp.sub-ja,,0,0,0,,Кешірім сұрау ретінде гүл шоғын жіберу үшін көп күш жұмсалды.
Dialogue: 0,0:16:00.56,0:16:02.90,Style1,,0,0,0,,Ол гүлдердің ақшасын өзім төлеймін.
Dialogue: 0,0:16:00.65,0:16:02.66,jp.sub-ja,,0,0,0,,Мен гүлдердің ақшасын төлеймін.
Dialogue: 0,0:16:02.90,0:16:09.89,Style1,,0,0,0,,Бір адамға гүл шоқтары 50 000 тұрады, демек 600 000-ға жетеді.
Dialogue: 0,0:16:03.17,0:16:09.67,jp.sub-ja,,0,0,0,,Бір адамның қолында 50 000 гүл шоғы бар, сондықтан жабылған кезде ол 600 000 болады.
Dialogue: 0,0:16:12.51,0:16:14.51,Style1,,0,0,0,,Неліктен жарықты сөндірдің?
Dialogue: 0,0:16:12.64,0:16:13.73,jp.sub-ja,,0,0,0,,Неліктен электр тогы?
Dialogue: 0,0:16:14.51,0:16:18.50,Style1,,0,0,0,,Қаласаңыз, сол гүлдердің ақысын денеңізбен төлеуге болады.
Dialogue: 0,0:16:14.57,0:16:17.90,jp.sub-ja,,0,0,0,,Гүлдердің ақысын денеңізбен төлеуге болады.
Dialogue: 0,0:16:25.25,0:16:27.26,Style1,,0,0,0,,Сіз өзіңіздің сенімділігіңізді, бұл нәрселерді қайта қарастыруыңыз керек
Dialogue: 0,0:16:25.42,0:16:29.80,jp.sub-ja,,0,0,0,,Сіз өзіңіздің аңғалдығыңызды қайта қарауыңыз керек, бұл сіздің еркек немесе әйел болуыңыз маңызды емес.
Dialogue: 0,0:16:27.26,0:16:30.76,Style1,,0,0,0,,адамның ұл немесе қыз болуына еш қатысы жоқ.
Dialogue: 0,0:16:30.76,0:16:35.09,Style1,,0,0,0,,Сіз өзіңізді соншалықты ашық қалдыру арқылы қателестіңіз.
Dialogue: 0,0:16:30.87,0:16:33.61,jp.sub-ja,,0,0,0,,Қорғансыз болғаның сенің қателігің.
Dialogue: 0,0:16:36.60,0:16:38.93,Style1,,0,0,0,,Сонымен.
Dialogue: 0,0:16:36.73,0:16:37.47,jp.sub-ja,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:40.27,0:16:43.71,Style1,,0,0,0,,Кёя-сенпай, сен мұны істемейсің.
Dialogue: 0,0:16:40.46,0:16:42.09,jp.sub-ja,,0,0,0,,Кёуя-сенпай олай істемейді.
Dialogue: 0,0:16:43.71,0:16:45.21,Style1,,0,0,0,,Айтайын дегенім,
Dialogue: 0,0:16:43.91,0:16:49.15,jp.sub-ja,,0,0,0,,Өйткені өз-өзіме араласудың пайдасы жоқ.
Dialogue: 0,0:16:45.21,0:16:49.87,Style1,,0,0,0,,Менімен араласқаннан ештеңе пайда болмайды, солай ма?
Dialogue: 0,0:16:51.88,0:16:54.22,Style1,,0,0,0,,Рас.
Dialogue: 0,0:16:51.99,0:16:52.59,jp.sub-ja,,0,0,0,,Әрине
Dialogue: 0,0:16:54.22,0:16:57.21,Style1,,0,0,0,,Сіз шынымен де қызықсыз.
Dialogue: 0,0:16:54.39,0:16:56.54,jp.sub-ja,,0,0,0,,Бұл шынымен қызық екен, сен
Dialogue: 0,0:16:58.22,0:17:00.39,Style1,,0,0,0,,Бірақ мен бір нәрсені білдім.
Dialogue: 0,0:16:58.36,0:17:03.69,jp.sub-ja,,0,0,0,,Бірақ мен Кёуя-сенпайдың таңғаларлық мейірімді екенін түсінемін.
Dialogue: 0,0:17:00.39,0:17:04.22,Style1,,0,0,0,,Кёя-сенпай, сен мен ойлағаннан да сүйкімдісің.
Dialogue: 0,0:17:05.23,0:17:08.90,Style1,,0,0,0,,Әйтеуір, Тамаки-сенпайдың айтқанын қолдап отырсың ғой, солай ма?
Dialogue: 0,0:17:05.26,0:17:08.90,jp.sub-ja,,0,0,0,,Бұл қазіргі Тамаки-сенпайдың жалғасы шығар деп ойлаймын.
Dialogue: 0,0:17:08.90,0:17:12.89,Style1,,0,0,0,,Жақсы ойлан, ақымақ! Сен қызсың!
Dialogue: 0,0:17:09.16,0:17:12.57,jp.sub-ja,,0,0,0,,Ойлан, ақымақ, сен әйелсің.
Dialogue: 0,0:17:15.30,0:17:19.64,Style1,,0,0,0,,Сен маған соны көрсету үшін әдейі жаман жігітті ойнадың, солай емес пе?
Dialogue: 0,0:17:15.45,0:17:19.13,jp.sub-ja,,0,0,0,,Сіз қасақана қаскүнемнің рөлін ойнап, маған бұл туралы үйреттіңіз.
Dialogue: 0,0:17:22.24,0:17:23.58,Style1,,0,0,0,,Киоя?
Dialogue: 0,0:17:22.46,0:17:24.93,jp.sub-ja,,0,0,0,,Кёуя, сізде лосьон бар ма?
Dialogue: 0,0:17:23.58,0:17:27.41,Style1,,0,0,0,,Сізде лосьон бар ма? Бұл күнге күйіп қалу мен ойлағаннан да жаман...
Dialogue: 0,0:17:25.30,0:17:27.41,jp.sub-ja,,0,0,0,,Күннің күйуі таңқаларлық қатты...
Dialogue: 0,0:17:30.25,0:17:32.35,Style1,,0,0,0,,Киёя, сен шіріксің...
Dialogue: 0,0:17:30.52,0:17:31.49,jp.sub-ja,,0,0,0,,Кёуя
Dialogue: 0,0:17:32.26,0:17:34.98,jp.sub-ja,,0,0,0,,Қарашы, қалағандай пайдалан, ақымақ.
Dialogue: 0,0:17:32.26,0:17:34.98,jp.sub-ja,,0,0,0,,«Windows» – қарғыстарды көзбен анықтай алатын Техникалық колледж қызметкерлері.
Dialogue: 0,0:17:32.35,0:17:35.25,Style1,,0,0,0,,Мұнда. Қалағаныңызша қолданыңыз, ақымақ.
Dialogue: 0,0:17:38.93,0:17:41.60,Style1,,0,0,0,,Ештеңе ұтпайды, иә?
Dialogue: 0,0:17:38.97,0:17:44.06,jp.sub-ja,,0,0,0,,Артықшылықтары. Бұл қызық әсер.
Dialogue: 0,0:17:41.60,0:17:44.53,Style1,,0,0,0,,Қызықты ой, өзінше.
Dialogue: 0,0:17:48.20,0:17:50.87,Style1,,0,0,0,,Сен Киоямен не істеп жүрсің?
Dialogue: 0,0:17:48.47,0:17:49.82,jp.sub-ja,,0,0,0,,Сен Кьюямен не істеп жүрсің?
Dialogue: 0,0:17:50.87,0:17:52.54,Style1,,0,0,0,,Ештеңе, шынымен.
Dialogue: 0,0:17:52.03,0:17:52.56,jp.sub-ja,,0,0,0,,Ерекше ештеңе жоқ
Dialogue: 0,0:17:52.54,0:17:54.21,Style1,,0,0,0,,Сіз менің бұл ештеңе емес деп сенуімді күтесіз бе!?
Dialogue: 0,0:17:52.59,0:17:54.10,jp.sub-ja,,0,0,0,,Бірдеңе бар ма?
Dialogue: 0,0:17:54.21,0:17:56.88,Style1,,0,0,0,,Сонда қалай бөлменің жарығы сөніп, екеуің жалғыз қалдыңдар!?
Dialogue: 0,0:17:54.42,0:17:56.99,jp.sub-ja,,0,0,0,,Онда неге бөлменің жарығын өшіріп, бізді жалғыз қалдырасың?
Dialogue: 0,0:17:56.88,0:17:58.87,Style1,,0,0,0,,Сіз оң...
Dialogue: 0,0:17:56.99,0:17:58.37,jp.sub-ja,,0,0,0,,Жалпы сіз
Dialogue: 0,0:18:00.88,0:18:05.22,Style1,,0,0,0,,Қарсы емес. Бүгін көп нәрсе болды, сіз шаршаған шығарсыз,
Dialogue: 0,0:18:01.05,0:18:03.31,jp.sub-ja,,0,0,0,,Бұл жеткілікті. Бүгін көп нәрсе болып жатыр.
Dialogue: 0,0:18:03.62,0:18:06.17,jp.sub-ja,,0,0,0,,Сен де шаршадың, енді ұйықта.
Dialogue: 0,0:18:05.22,0:18:07.72,Style1,,0,0,0,,сондықтан төсекке асығыңыз.
Dialogue: 0,0:18:07.72,0:18:09.05,Style1,,0,0,0,,Сенпай...
Dialogue: 0,0:18:07.87,0:18:08.44,jp.sub-ja,,0,0,0,,Аға
Dialogue: 0,0:18:13.90,0:18:15.23,Style1,,0,0,0,,Иә, мен...
Dialogue: 0,0:18:19.23,0:18:20.74,Style1,,0,0,0,,Харухи?
Dialogue: 0,0:18:19.56,0:18:19.99,jp.sub-ja,,0,0,0,,Харухи
Dialogue: 0,0:18:20.74,0:18:23.07,Style1,,0,0,0,,Мұнда.
Dialogue: 0,0:18:20.90,0:18:21.75,jp.sub-ja,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:23.07,0:18:25.74,Style1,,0,0,0,,Мен жай ғана бір нәрсе есіме түсті, кешірім сұрасаңыз...
Dialogue: 0,0:18:23.30,0:18:26.10,jp.sub-ja,,0,0,0,,Мен бірдеңені есіме түсірдім, кешіріңіз.
Dialogue: 0,0:18:25.74,0:18:27.90,Style1,,0,0,0,,Онда ешкімнің шаруасы жоқ!
Dialogue: 0,0:18:25.83,0:18:27.74,jp.sub-ja,,0,0,0,,Мұндай жерде ешбір баланың ісі жоқ.
Dialogue: 0,0:18:30.25,0:18:35.58,Style1,,0,0,0,,Харухи, сен найзағайға шыдай алмайсың ба? Жүр, Харухи, мұнда шық.
Dialogue: 0,0:18:30.31,0:18:32.91,jp.sub-ja,,0,0,0,,Харухи, сен найзағай ойнай алмайсың ба?
Dialogue: 0,0:18:34.23,0:18:35.31,jp.sub-ja,,0,0,0,,Кел, Харухи!
Dialogue: 0,0:18:35.58,0:18:38.75,Style1,,0,0,0,,Онда қалу оны әлдеқайда қорқынышты етеді, солай емес пе?
Dialogue: 0,0:18:35.82,0:18:37.79,jp.sub-ja,,0,0,0,,Мен сондай жерге кірсем одан да қорқынышты болар еді.
Dialogue: 0,0:18:38.75,0:18:43.25,Style1,,0,0,0,,Менде бәрі жақсы. Мен мұны істеу арқылы әрқашан оны жеңемін.
Dialogue: 0,0:18:38.78,0:18:42.67,jp.sub-ja,,0,0,0,,Жарайды, мен үнемі осындай нәрселерден өтемін.
Dialogue: 0,0:18:44.26,0:18:45.59,Style1,,0,0,0,,Әрқашан...
Dialogue: 0,0:18:44.40,0:18:44.87,jp.sub-ja,,0,0,0,,Әрқашан
Dialogue: 0,0:18:46.93,0:18:49.26,Style1,,0,0,0,,Әрқашан, өз бетінше...
Dialogue: 0,0:18:47.09,0:18:51.38,jp.sub-ja,,0,0,0,,Үйде әрқашан жалғыз
Dialogue: 0,0:18:50.27,0:18:52.60,Style1,,0,0,0,,сіздің үйіңізде...
Dialogue: 0,0:18:52.60,0:18:55.93,Style1,,0,0,0,,жақын жерде болсақ та, бізге қоңырау шалмай...
Dialogue: 0,0:18:52.95,0:18:55.36,jp.sub-ja,,0,0,0,,Біз жақын болғанда да маған қоңырау шалмаңыз
Dialogue: 0,0:18:59.27,0:19:00.61,Style1,,0,0,0,,Б... бір сызық
Dialogue: 0,0:18:59.47,0:18:59.96,jp.sub-ja,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:04.45,0:19:08.62,Style1,,0,0,0,,Мен түсіндім деп ойлаймын. Жарайды, мен жеңілемін.
Dialogue: 0,0:19:04.58,0:19:07.97,jp.sub-ja,,0,0,0,,Мен түсіндім. Бұл менің жоғалтуым.
Dialogue: 0,0:19:08.62,0:19:12.31,Style1,,0,0,0,,Ешкімге сенбей өстің.
Dialogue: 0,0:19:08.78,0:19:11.76,jp.sub-ja,,0,0,0,,Өзгеге сенбей өстің.
Dialogue: 0,0:19:13.62,0:19:15.45,Style1,,0,0,0,,Сонымен, келіңіз...
Dialogue: 0,0:19:13.64,0:19:14.26,jp.sub-ja,,0,0,0,,Қараңыз
Dialogue: 0,0:19:16.72,0:19:18.39,Style1,,0,0,0,,Келіңіздер.
Dialogue: 0,0:19:16.92,0:19:17.74,jp.sub-ja,,0,0,0,,Мұнда кел
Dialogue: 0,0:19:31.31,0:19:33.44,Style1,,0,0,0,,Бұдан былай мен сонда боламын.
Dialogue: 0,0:19:31.48,0:19:32.66,jp.sub-ja,,0,0,0,,Бұдан былай мен осында боламын
Dialogue: 0,0:19:33.44,0:19:36.31,Style1,,0,0,0,,Мен сенен көзімді алмау үшін қолымнан келгеннің бәрін жасаймын,
Dialogue: 0,0:19:33.62,0:19:35.52,jp.sub-ja,,0,0,0,,Жалғыз қалуға жол бермеңіз
Dialogue: 0,0:19:36.31,0:19:38.80,Style1,,0,0,0,,енді ешқашан жалғыз болмайтыныңызға көз жеткізу үшін.
Dialogue: 0,0:19:36.51,0:19:38.28,jp.sub-ja,,0,0,0,,Мен саған ең болмаса бақылаймын.
Dialogue: 0,0:19:44.92,0:19:46.92,Style1,,0,0,0,,Мұның дұрыс екеніне сенімдісіз бе?
Dialogue: 0,0:19:45.23,0:19:46.86,jp.sub-ja,,0,0,0,,Бұл шынымен жақсы болды ма?
Dialogue: 0,0:19:46.92,0:19:48.92,Style1,,0,0,0,,Екеуін бірге қалдыру?
Dialogue: 0,0:19:47.20,0:19:48.40,jp.sub-ja,,0,0,0,,Бізді жайына қалдырыңыз
Dialogue: 0,0:19:48.92,0:19:54.09,Style1,,0,0,0,,Ол біздің Тамакимен бірге. Не қате болуы мүмкін?
Dialogue: 0,0:19:49.02,0:19:53.65,jp.sub-ja,,0,0,0,,Екінші жақ – бұл Тамаки. Қандай қателік болады?
Dialogue: 0,0:19:55.26,0:19:57.27,Style1,,0,0,0,,Мырза? Біз кіріп жатырмыз.
Dialogue: 0,0:19:55.38,0:19:57.21,jp.sub-ja,,0,0,0,,Мырза, мен кіріп жатырмын.
Dialogue: 0,0:19:57.27,0:20:00.27,Style1,,0,0,0,,Көрдіңіз бе? Көз байланғанмен ештеңені көре алмайсың,
Dialogue: 0,0:19:57.56,0:20:01.88,jp.sub-ja,,0,0,0,,Құлақ тығынын киіп жүрсеңіз
Dialogue: 0,0:20:00.27,0:20:01.94,Style1,,0,0,0,,және дыбыс жағынан, егер сіз құлаққап кисеңіз...
Dialogue: 0,0:20:01.94,0:20:04.44,Style1,,0,0,0,,Аа, дұрыс айтасыз!
Dialogue: 0,0:20:02.93,0:20:03.95,jp.sub-ja,,0,0,0,,Бұл рас
Dialogue: 0,0:20:04.44,0:20:06.61,Style1,,0,0,0,,Жексұрын.
Dialogue: 0,0:20:04.62,0:20:05.82,jp.sub-ja,,0,0,0,,Ер адамның аты – Ллойд Форджер
Dialogue: 0,0:20:06.61,0:20:09.61,Style1,,0,0,0,,- Бұл қандай «-ойын»? - олай емес!
Dialogue: 0,0:20:06.67,0:20:07.80,jp.sub-ja,,0,0,0,,Қанша пьеса бар?
Dialogue: 0,0:20:08.71,0:20:12.21,jp.sub-ja,,0,0,0,,Жоқ, бұл басқаша.
Dialogue: 0,0:20:09.61,0:20:12.95,Style1,,0,0,0,,Бұл олай емес!
Dialogue: 0,0:20:12.95,0:20:14.78,Style1,,0,0,0,,Сау бол, Харухи.
Dialogue: 0,0:20:13.13,0:20:14.68,jp.sub-ja,,0,0,0,,Сау бол, Харухи
Dialogue: 0,0:20:14.78,0:20:17.62,Style1,,0,0,0,,Оның ұлылығының S&M-ге де қатысы бар сияқты.
Dialogue: 0,0:20:15.03,0:20:17.39,jp.sub-ja,,0,0,0,,Сіздің де СМ-де хоббиіңіз бар сияқты.
Dialogue: 0,0:20:17.62,0:20:19.95,Style1,,0,0,0,,Айттым ғой, олай емес!
Dialogue: 0,0:20:17.69,0:20:19.82,jp.sub-ja,,0,0,0,,Сондықтан басқаша деймін.
Dialogue: 0,0:20:19.95,0:20:24.63,Style1,,0,0,0,,Мен көремін. Демек, бұл S&M.
Dialogue: 0,0:20:20.06,0:20:23.58,jp.sub-ja,,0,0,0,,Түсіндім, сен СМ деп атайсың ба?
Dialogue: 0,0:20:24.57,0:20:27.05,jp.sub-ja,,0,0,0,,Білмей-ақ мені оғаш нәрсеге мәжбүрледің.
Dialogue: 0,0:20:24.63,0:20:27.46,Style1,,0,0,0,,Мен саған күлкілі нәрсені білмей-ақ құтылуға рұқсат бердім.
Dialogue: 0,0:20:27.46,0:20:29.96,Style1,,0,0,0,,Бұлай болған жоқ! Мен мұны сен үшін жасадым!
Dialogue: 0,0:20:27.51,0:20:30.01,jp.sub-ja,,0,0,0,,Жоқ, мен сен үшінмін
Dialogue: 0,0:20:29.96,0:20:30.97,Style1,,0,0,0,,Көлік жүргізуді бастаңыз.
Dialogue: 0,0:20:30.24,0:20:30.95,jp.sub-ja,,0,0,0,,Мені шығарыңыз
Dialogue: 0,0:20:30.97,0:20:32.30,Style1,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,0:20:33.30,0:20:36.64,Style1,,0,0,0,,Мені артымда қалдырмаңыз!
Dialogue: 0,0:20:33.50,0:20:36.46,jp.sub-ja,,0,0,0,,Мені тастама
Dialogue: 0,0:20:36.64,0:20:40.01,Style1,,0,0,0,,Шынымен
Dialogue: 0,0:20:36.84,0:20:38.52,jp.sub-ja,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:20:38.29,0:20:40.15,jp.sub-ja,,0,0,0,,Осы уақытқа дейін неге байқамадым?
Dialogue: 0,0:20:40.43,0:20:42.29,jp.sub-ja,,0,0,0,,Харухи шынымен де жоғары сынып оқушылары үшін жарасады емес пе?
Dialogue: 0,0:20:40.77,0:20:42.43,Style1,,0,0,0,,Неліктен мен оны бұрын байқамадым?
Dialogue: 0,0:20:42.43,0:20:44.70,Style1,,0,0,0,,Харухи қыздарға арналған мектепке мүлдем қабылданбайды, солай емес пе?
Dialogue: 0,0:20:42.56,0:20:45.92,jp.sub-ja,,0,0,0,,Осыған байланысты мен сені қыздарға арналған орта мектепке ауыстыруға ешқашан рұқсат етпеймін.
Dialogue: 0,0:20:44.70,0:20:48.27,Style1,,0,0,0,,Сондықтан мен оны қыздар мектебіне ауыстыруға рұқсат бере алмаймын!
Dialogue: 0,0:20:48.27,0:20:50.38,Style1,,0,0,0,,Келесі жолы «Lobelia Girls' Academy-дан шақыру»
Dialogue: 0,0:20:48.30,0:20:50.38,jp.sub-ja,,0,0,0,,Келесі аптада Оуран орта мектебінің хост клубы
Dialogue: 0,0:20:50.38,0:20:54.94,Style1,,0,0,0,,Сізді келесі аптада Оуран орта мектебінің хост клубы күтеді!
Dialogue: 0,0:20:50.84,0:20:52.21,jp.sub-ja,,0,0,0,,Біз сізді асыға күтеміз.
Dialogue: 0,0:20:56.44,0:21:02.44,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
