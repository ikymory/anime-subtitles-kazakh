Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:02.80,staff-ja,,0,0,0,,Mam
Dialogue: 0,0:00:00.00,0:00:03.00,staff-ja,,0,0,0,,Жапония
Dialogue: 0,0:00:00.00,0:00:03.00,staff-ja,,0,0,0,,Syura
Dialogue: 0,0:00:00.00,0:00:03.17,staff-ja,,0,0,0,,Аударма Aris
Dialogue: 0,0:00:00.00,0:00:03.25,staff-ja,,0,0,0,,Уақыт кестесі
Dialogue: 0,0:00:00.00,0:00:03.25,staff-ja,,0,0,0,,Наксияның әкімшілік жүйесі
Dialogue: 0,0:00:00.00,0:00:03.63,staff-ja,,0,0,0,,OP&ED Hagakure
Dialogue: 0,0:00:00.00,0:00:03.63,staff-ja,,0,0,0,,Сюра
Dialogue: 0,0:00:00.00,0:00:03.88,Default11-ja,,0,0,0,,Құдайдың субтитр жұбы
Dialogue: 0,0:00:05.61,0:00:10.20,Style1,,0,0,0,,Бұл ойынды алғаш ойнай бастаған кезіміз есіңізде ме?
Dialogue: 0,0:00:05.78,0:00:08.10,jp.sub-ja,,0,0,0,,Мен бұл ойынды алғаш ойнай бастағанда
Dialogue: 0,0:00:08.90,0:00:09.56,jp.sub-ja,,0,0,0,,біз төрт жылдан бері соғыста жүргеніміз?
Dialogue: 0,0:00:22.29,0:00:25.06,Style1,,0,0,0,,Екеуміз бірге аққала жасайық.
Dialogue: 0,0:00:22.44,0:00:24.26,jp.sub-ja,,0,0,0,,Ендеше бірге аққала жасайық
Dialogue: 0,0:00:28.63,0:00:30.30,Style1,,0,0,0,,Сіз қайсысымен сөйлесесіз?
Dialogue: 0,0:00:28.84,0:00:29.90,jp.sub-ja,,0,0,0,,Сіз қайсысын айтып отырсыз?
Dialogue: 0,0:00:30.30,0:00:32.64,Style1,,0,0,0,,Әрине, екеуің де.
Dialogue: 0,0:00:30.48,0:00:31.82,jp.sub-ja,,0,0,0,,Әрине, екеумізге де.
Dialogue: 0,0:00:32.64,0:00:35.64,Style1,,0,0,0,,Мұнда «Екеуің» деген ешкім жоқ.
Dialogue: 0,0:00:32.82,0:00:34.98,jp.sub-ja,,0,0,0,,«Футари» атты бала жоқ.
Dialogue: 0,0:00:35.64,0:00:38.97,Style1,,0,0,0,,Мен сенімен сөйлесіп тұрмын, Хикару-чан және Каору-чан.
Dialogue: 0,0:00:36.02,0:00:38.18,jp.sub-ja,,0,0,0,,Мен Хикари-чан мен Каору-чанға айтамын
Dialogue: 0,0:00:39.98,0:00:40.98,Style1,,0,0,0,,Жарайды,
Dialogue: 0,0:00:40.06,0:00:45.22,jp.sub-ja,,0,0,0,,Олай болса, мен қайсысының нұр, қайсысының нұрлы екенін білемін.
Dialogue: 0,0:00:40.98,0:00:42.65,Style1,,0,0,0,,қайсысымыз Хикарумыз,
Dialogue: 0,0:00:42.65,0:00:46.01,Style1,,0,0,0,,және қайсысы Каору? Сіз айта аласыз ба?
Dialogue: 0,0:00:50.25,0:00:53.92,Style1,,0,0,0,,«Қайсысы Хикару-кун ойынын» ойнайық!
Dialogue: 0,0:00:50.66,0:00:53.60,jp.sub-ja,,0,0,0,,Хикари-кун қайсысы? Ойын
Dialogue: 0,0:00:55.69,0:00:58.66,Style2,,0,0,0,,"№3 музыкалық бөлме" "Хост клубы енді бизнес үшін ашық"
Dialogue: 0,0:00:58.93,0:01:00.33,Style1,,0,0,0,,Енді,
Dialogue: 0,0:00:59.16,0:01:02.16,jp.sub-ja,,0,0,0,,Қане, қайсысы жарық екенін айта аласың ба?
Dialogue: 0,0:01:00.33,0:01:02.26,Style1,,0,0,0,,Хикару кім екенімізді айта аласыз ба?
Dialogue: 0,0:01:02.26,0:01:04.27,Style1,,0,0,0,,О, бұл қиын.
Dialogue: 0,0:01:02.44,0:01:04.44,jp.sub-ja,,0,0,0,,Бұл қиын.
Dialogue: 0,0:01:04.27,0:01:06.60,Style1,,0,0,0,,Олар тым ұқсас.
Dialogue: 0,0:01:04.48,0:01:05.76,jp.sub-ja,,0,0,0,,Тым ұқсас~
Dialogue: 0,0:01:06.60,0:01:08.80,Style1,,0,0,0,,Қыз бала ешқашан болған емес
Dialogue: 0,0:01:06.68,0:01:10.20,jp.sub-ja,,0,0,0,,Осы уақытқа дейін бірде-бір бала оны нақты түсінбеген.
Dialogue: 0,0:01:08.80,0:01:10.27,Style1,,0,0,0,,бұрын бізді кім ажырата алатын.
Dialogue: 0,0:01:10.27,0:01:12.94,Style1,,0,0,0,,Қандай күлкілі ойын.
Dialogue: 0,0:01:10.52,0:01:12.22,jp.sub-ja,,0,0,0,,Қандай ақымақ ойын
Dialogue: 0,0:01:12.94,0:01:15.61,Style1,,0,0,0,,Иә? Сізге ұнамайтын нәрсе бар ма?
Dialogue: 0,0:01:13.06,0:01:15.02,jp.sub-ja,,0,0,0,,Маған бұл ұнамайды.
Dialogue: 0,0:01:15.61,0:01:17.28,Style1,,0,0,0,,Бұл жай ғана емес.
Dialogue: 0,0:01:15.80,0:01:19.94,jp.sub-ja,,0,0,0,,Айтайын дегенім, мен бұл екеуінің қаншалықты танымал екенін түсінбеймін.
Dialogue: 0,0:01:17.28,0:01:20.62,Style1,,0,0,0,,Екеуіңіздің неге сонша танымал екендеріңізді түсінбеймін.
Dialogue: 0,0:01:20.62,0:01:21.95,Style1,,0,0,0,,Бұл бізге айтады.
Dialogue: 0,0:01:20.82,0:01:21.96,jp.sub-ja,,0,0,0,,Сіз маған айтасыз.
Dialogue: 0,0:01:21.95,0:01:23.62,Style1,,0,0,0,,Шамасы, Харухи...
Dialogue: 0,0:01:22.28,0:01:23.40,jp.sub-ja,,0,0,0,,Сәлем, Харухи.
Dialogue: 0,0:01:23.62,0:01:28.29,Style1,,0,0,0,,...Хост клубында егіздердің болуының артықшылығын түсіну.
Dialogue: 0,0:01:24.02,0:01:28.04,jp.sub-ja,,0,0,0,,Сіз қабылдау бөлімінде егіздердің пайдасын түсінбейтін сияқтысыз.
Dialogue: 0,0:01:28.29,0:01:29.63,Style1,,0,0,0,,Мұнда тыңдаңыз.
Dialogue: 0,0:01:28.62,0:01:29.22,jp.sub-ja,,0,0,0,,Ал сосын!
Dialogue: 0,0:01:29.63,0:01:31.63,Style1,,0,0,0,,Бір-екі әдемі гомосексуалдың болуы
Dialogue: 0,0:01:29.84,0:01:33.20,jp.sub-ja,,0,0,0,,Әдемі жігіттердің гей екенін айтудың өзі ұпай алу үшін жеткілікті.
Dialogue: 0,0:01:31.63,0:01:33.63,Style1,,0,0,0,,көптеген жоғары ұпай жинайды.
Dialogue: 0,0:01:33.63,0:01:38.30,Style1,,0,0,0,,Осы мен достықтың арасындағы тартысты шоу жасау да жөн.
Dialogue: 0,0:01:33.98,0:01:37.66,jp.sub-ja,,0,0,0,,Маған да достық пен достық арасында тербелетін қойылым ұнайды.
Dialogue: 0,0:01:38.30,0:01:40.30,Style1,,0,0,0,,Бірақ біздің жағдайда егіз болғандықтан,
Dialogue: 0,0:01:38.40,0:01:39.42,jp.sub-ja,,0,0,0,,Біздің жағдайда
Dialogue: 0,0:01:39.74,0:01:42.82,jp.sub-ja,,0,0,0,,Неліктен олар егіздердің ең жоғарғы тыйымын қару ретінде пайдаланады?
Dialogue: 0,0:01:40.30,0:01:43.33,Style1,,0,0,0,,біз бұл ең тыйым салынған тыйымдарды қару ретінде қолданамыз.
Dialogue: 0,0:01:44.57,0:01:47.58,Style1,,0,0,0,,Оның үстіне екі адам болуының сценарийі бар,
Dialogue: 0,0:01:44.80,0:01:45.54,jp.sub-ja,,0,0,0,,Сонымен қатар
Dialogue: 0,0:01:45.94,0:01:50.10,jp.sub-ja,,0,0,0,,Осындай терең байланыстағы екі адамды бір уақытта сүйетін шығарма.
Dialogue: 0,0:01:47.58,0:01:50.91,Style1,,0,0,0,,бір-бірімен соншалықты терең байланысы бар, сізді бір уақытта жақсы көретін.
Dialogue: 0,0:01:50.91,0:01:53.92,Style1,,0,0,0,,Бұл жас әйелдің ең керемет романтикасы, солай ма?
Dialogue: 0,0:01:51.04,0:01:53.14,jp.sub-ja,,0,0,0,,Бұл қыздың соңғы романтикасы болса керек.
Dialogue: 0,0:01:53.92,0:01:55.92,Style1,,0,0,0,,Е... Мен...
Dialogue: 0,0:01:55.04,0:01:57.10,jp.sub-ja,,0,0,0,,Мен енді жақсы емеспін.
Dialogue: 0,0:01:55.92,0:01:58.48,Style1,,0,0,0,,Мен енді шыдай алмаймын!
Dialogue: 0,0:02:02.93,0:02:05.59,Style1,,0,0,0,,Хикару! Каору!
Dialogue: 0,0:02:02.94,0:02:04.46,jp.sub-ja,,0,0,0,,Жарық Каору
Dialogue: 0,0:02:05.56,0:02:09.02,jp.sub-ja,,0,0,0,,Шарт мынада: сіз бөлімнің басты бетін байыппен басқарасыз.
Dialogue: 0,0:02:05.59,0:02:07.93,Style1,,0,0,0,,Шарт бойынша клубтың басты бетін бақылауыңызға рұқсат етемін
Dialogue: 0,0:02:07.93,0:02:10.60,Style1,,0,0,0,,сіз мұны байыппен қабылдайсыз!
Dialogue: 0,0:02:09.04,0:02:10.12,jp.sub-ja,,0,0,0,,Мен мұны сізге қалдырдым.
Dialogue: 0,0:02:10.60,0:02:12.66,jp.sub-ja,,0,0,0,,Сондықтан мен мұны шындап істеп жатырмын.
Dialogue: 0,0:02:10.60,0:02:12.94,Style1,,0,0,0,,Біз мұны байыппен қабылдаймыз.
Dialogue: 0,0:02:12.94,0:02:15.27,Style1,,0,0,0,,Кеше түнде таң атқанша тұрып, онымен жұмыс істедік.
Dialogue: 0,0:02:13.10,0:02:15.06,jp.sub-ja,,0,0,0,,Кеше де таң атқанша уақыт кетті
Dialogue: 0,0:02:15.24,0:02:17.68,jp.sub-ja,,0,0,0,,Бұл сіз жасаған экран ба?
Dialogue: 0,0:02:15.27,0:02:18.30,Style1,,0,0,0,,Ал мынау сіз жасаған экран!?
Dialogue: 0,0:02:20.94,0:02:23.41,Style1,,0,0,0,,Хару-чан, сен керемет көрінесің!
Dialogue: 0,0:02:21.12,0:02:22.80,jp.sub-ja,,0,0,0,,Хару-чан керемет
Dialogue: 0,0:02:24.56,0:02:25.74,jp.sub-ja,,0,0,0,,Сексуалды
Dialogue: 0,0:02:25.95,0:02:27.62,Style1,,0,0,0,,Қашан!?
Dialogue: 0,0:02:26.08,0:02:26.62,jp.sub-ja,,0,0,0,,Қашан?
Dialogue: 0,0:02:27.62,0:02:30.59,Style1,,0,0,0,,Сіз Харухидің жалаңаш суретін қашан түсірдіңіз!?
Dialogue: 0,0:02:27.84,0:02:30.28,jp.sub-ja,,0,0,0,,Сіз Харухидің жалаңаш суретін қашан түсірдіңіз?
Dialogue: 0,0:02:34.96,0:02:37.29,Style1,,0,0,0,,«Иә, бұл поза.
Dialogue: 0,0:02:35.18,0:02:36.86,jp.sub-ja,,0,0,0,,Иә, бұл поза.
Dialogue: 0,0:02:37.29,0:02:39.30,Style1,,0,0,0,,Бұл жақсы өрнек.
Dialogue: 0,0:02:37.46,0:02:38.54,jp.sub-ja,,0,0,0,,Бұл әдемі көрініс
Dialogue: 0,0:02:39.30,0:02:43.90,Style1,,0,0,0,,Осы жерде жұмыс істеп болған соң, біз сізге қалаған керемет тунецті беруге рұқсат етеміз...
Dialogue: 0,0:02:39.58,0:02:40.46,jp.sub-ja,,0,0,0,,Бұл аяқталған кезде
Dialogue: 0,0:02:40.70,0:02:43.70,jp.sub-ja,,0,0,0,,Қалағаныңызша жей беріңіз.
Dialogue: 0,0:02:42.83,0:02:47.63,Style2,,0,0,0,,«Әдемі тунец»
Dialogue: 0,0:02:43.90,0:02:47.90,Style1,,0,0,0,,...сіз қалағаныңыз... қалағаныңыз...».
Dialogue: 0,0:02:44.12,0:02:46.88,jp.sub-ja,,0,0,0,,Мен саған беремін, саған беремін
Сіз
Dialogue: 0,0:02:47.76,0:02:50.10,jp.sub-ja,,0,0,0,,орындадыңыз ба?
Dialogue: 0,0:02:47.90,0:02:50.24,Style1,,0,0,0,,Сен солай істедің бе!? Сен солай істедің бе!?
Dialogue: 0,0:02:50.24,0:02:52.24,Style1,,0,0,0,,Сіз қатты адасушысыз.
Dialogue: 0,0:02:50.36,0:02:51.82,jp.sub-ja,,0,0,0,,Тым адасушылық
Dialogue: 0,0:02:52.24,0:02:54.57,Style1,,0,0,0,,Бұл, әрине, композициялық фотосурет.
Dialogue: 0,0:02:52.40,0:02:54.14,jp.sub-ja,,0,0,0,,Бұл композициялық фотосурет болуы керек.
Dialogue: 0,0:02:55.58,0:02:57.81,Style1,,0,0,0,,Құрама?
Dialogue: 0,0:02:55.70,0:02:56.86,jp.sub-ja,,0,0,0,,Синтез?
Dialogue: 0,0:02:56.35,0:02:57.81,Style2,,0,0,0,,«Фотошопты айтасыз ба?»
Dialogue: 0,0:02:57.91,0:02:59.25,Style1,,0,0,0,,Біз жақсы жұмыс жасадық, солай емес пе?
Dialogue: 0,0:02:58.06,0:02:59.18,jp.sub-ja,,0,0,0,,Жарайсыңдар.
Dialogue: 0,0:02:59.25,0:03:00.92,Style1,,0,0,0,,Керемет шеберлік, өзім айтсам.
Dialogue: 0,0:02:59.40,0:03:00.98,jp.sub-ja,,0,0,0,,Мен үшін тамаша технология
Dialogue: 0,0:03:00.92,0:03:04.59,Style1,,0,0,0,,Ей, ақымақтар! Сіздің дағдыларыңызды босқа пайдалану қандай! Ұят болсын!
Dialogue: 0,0:03:01.22,0:03:04.10,jp.sub-ja,,0,0,0,,Ей, ақымақ, техниканың босқа кеткені, ұят.
Dialogue: 0,0:03:04.59,0:03:05.92,Style1,,0,0,0,,Бірақ егер сіз мұны істегіңіз келсе,
Dialogue: 0,0:03:04.82,0:03:08.04,jp.sub-ja,,0,0,0,,Егер сіз мұны бәрібір орындағыңыз келсе, оны осы кумир фотокітапымен біріктіріңіз.
Dialogue: 0,0:03:05.92,0:03:08.26,Style1,,0,0,0,,оны осы кумир фото жинағымен біріктіріңіз.
Dialogue: 0,0:03:08.26,0:03:10.59,Style1,,0,0,0,,Бұл ақымақтық болар еді, сэр. Тезірек болар еді...
Dialogue: 0,0:03:08.62,0:03:10.68,jp.sub-ja,,0,0,0,,Сіз ақымақсыз, сэр.
Dialogue: 0,0:03:10.59,0:03:13.26,Style1,,0,0,0,,...оған сол затты киюді тікелей сұрау.
Dialogue: 0,0:03:10.86,0:03:12.98,jp.sub-ja,,0,0,0,,Оны тікелей адамға қою жылдамырақ.
Dialogue: 0,0:03:13.26,0:03:15.89,Style1,,0,0,0,,И-иә, мен одан сұрай аламын.
Dialogue: 0,0:03:13.50,0:03:15.16,jp.sub-ja,,0,0,0,,Сонымен Сока Адамның өзіне.
Dialogue: 0,0:03:17.60,0:03:19.60,Style1,,0,0,0,,Бұл туралы не ойлайсыз?
Dialogue: 0,0:03:17.84,0:03:19.18,jp.sub-ja,,0,0,0,,Қызық, бұл не?
Dialogue: 0,0:03:19.60,0:03:21.60,Style1,,0,0,0,,Неліктен сізде бұл бар?
Dialogue: 0,0:03:19.76,0:03:21.06,jp.sub-ja,,0,0,0,,Неліктен сізде бар?
Dialogue: 0,0:03:21.60,0:03:23.27,Style1,,0,0,0,,Харухи-кун керемет көрінеді!
Dialogue: 0,0:03:21.62,0:03:22.98,jp.sub-ja,,0,0,0,,Харухи керемет
Dialogue: 0,0:03:23.27,0:03:25.61,Style1,,0,0,0,,Дегенмен, Тамаки-сама айтқандай,
Dialogue: 0,0:03:23.48,0:03:25.38,jp.sub-ja,,0,0,0,,Бірақ Тамаки-сама айтқандай,
Dialogue: 0,0:03:25.61,0:03:28.94,Style1,,0,0,0,,Мен Харухикунды әйел киімін кигенін көргім келеді.
Dialogue: 0,0:03:25.86,0:03:28.66,jp.sub-ja,,0,0,0,,Мен де Харухидің кроссовкасын көргім келеді.
Dialogue: 0,0:03:28.94,0:03:32.54,Style1,,0,0,0,,Харухи-кун өте сүйкімді, олар оған жақсы көрінетініне сенімдімін.
Dialogue: 0,0:03:29.34,0:03:32.08,jp.sub-ja,,0,0,0,,Харухи-кун сен сүйкімдісің, сондықтан сен маған жарасатыныңа сенімдімін.
Dialogue: 0,0:03:40.29,0:03:44.56,Style1,,0,0,0,,Менің рұқсатымсыз менің суреттерімді құрастыруды доғарасыз ба?
Dialogue: 0,0:03:40.68,0:03:44.12,jp.sub-ja,,0,0,0,,Біртүрлі композициялық фотосуреттер жасауды доғарыңыз.
Dialogue: 0,0:03:44.56,0:03:47.53,Style1,,0,0,0,,Сіз басқа адамдарды қандай деп қабылдайсыз?
Dialogue: 0,0:03:44.84,0:03:46.86,jp.sub-ja,,0,0,0,,Адамдар дегеніміз не деп ойлайсың?
Dialogue: 0,0:03:48.56,0:03:51.93,Style1,,0,0,0,,Бұл анық емес пе? Ойыншықтар.
Dialogue: 0,0:03:48.86,0:03:49.84,jp.sub-ja,,0,0,0,,Бұл шешілді
Dialogue: 0,0:03:50.78,0:03:51.66,jp.sub-ja,,0,0,0,,Ойыншықтар
Dialogue: 0,0:03:57.97,0:03:59.77,Style2,,0,0,0,,«Хост клубы бизнес үшін ашық болуды жалғастыруда»
Dialogue: 0,0:03:58.57,0:04:00.24,Style1,,0,0,0,,Көрдіңіз бе,
Dialogue: 0,0:03:58.98,0:04:03.00,jp.sub-ja,,0,0,0,,Сонымен, қызықсыз өмірден қалай ләззат алуға болады
Dialogue: 0,0:04:00.24,0:04:03.25,Style1,,0,0,0,,қызықсыз өмірден ләззат алу үшін...
Dialogue: 0,0:04:03.25,0:04:05.91,Style1,,0,0,0,,...сенде ынталандыратын ойыншықтар болуы керек.
Dialogue: 0,0:04:03.42,0:04:05.80,jp.sub-ja,,0,0,0,,Маған ынталандырушы ойыншық керек.
Dialogue: 0,0:04:05.91,0:04:08.61,Style1,,0,0,0,,Мен ойыншық емеспін!
Dialogue: 0,0:04:06.14,0:04:07.94,jp.sub-ja,,0,0,0,,Мен ойыншық емеспін
Dialogue: 0,0:04:09.92,0:04:11.44,Style1,,0,0,0,,Ойыншықтар...
Dialogue: 0,0:04:09.98,0:04:10.80,jp.sub-ja,,0,0,0,,Ойыншықтар
Dialogue: 0,0:04:12.74,0:04:14.24,jp.sub-ja,,0,0,0,,Ойыншықтар Ойыншықтар
Dialogue: 0,0:04:12.92,0:04:14.92,Style1,,0,0,0,,Ойыншықтар... ойыншықтар...
Dialogue: 0,0:04:14.92,0:04:19.79,Style1,,0,0,0,,Егер сіз ойыншықтарды ұнатсаңыз, онда менің клубыма, Қара магия клубына келіңіз.
Dialogue: 0,0:04:15.10,0:04:19.42,jp.sub-ja,,0,0,0,,Ойыншықтарды ұнататын болсаңыз, біздің қара магия клубына келіңіз.
Dialogue: 0,0:04:20.93,0:04:24.93,Style1,,0,0,0,,Біз әлемдегі қара магиялық қызықтар базарын аштық.
Dialogue: 0,0:04:20.94,0:04:24.38,jp.sub-ja,,0,0,0,,Дүниежүзілік қара сиқыр құралдарының жәрмеңкесі өтіп жатыр
Dialogue: 0,0:04:24.93,0:04:27.60,Style1,,0,0,0,,Біз әрқашан массаны ұстап тұрамыз.
Dialogue: 0,0:04:24.96,0:04:27.32,jp.sub-ja,,0,0,0,,Меса әрқашан өткізіледі.
Dialogue: 0,0:04:27.60,0:04:31.61,Style1,,0,0,0,,Егер қазір келсеңіз, мен сізге мына әдемі қарғыс қуыршағын алып беремін,
Dialogue: 0,0:04:27.88,0:04:31.12,jp.sub-ja,,0,0,0,,Қазір қарғыс атқан тамаша қуыршақ.
Dialogue: 0,0:04:31.27,0:04:35.80,Style2,,0,0,0,,«Қара магия клубының президенті, Некозава Умехито»
Dialogue: 0,0:04:31.61,0:04:35.81,Style1,,0,0,0,,Белзенеф, менің сыйлығым.
Dialogue: 0,0:04:31.76,0:04:33.98,jp.sub-ja,,0,0,0,,Қазіргі Белзенев
Dialogue: 0,0:04:36.61,0:04:38.95,Style1,,0,0,0,,Неліктен ол есіктің тесігінен сөйлеп тұр?
Dialogue: 0,0:04:36.88,0:04:38.70,jp.sub-ja,,0,0,0,,Неліктен мұндай алшақтықтан?
Dialogue: 0,0:04:38.95,0:04:40.12,Style1,,0,0,0,,Осыған байланысты,
Dialogue: 0,0:04:39.20,0:04:41.46,jp.sub-ja,,0,0,0,,Дәлірек айтқанда, есік болды ма?
Dialogue: 0,0:04:40.12,0:04:41.95,Style1,,0,0,0,,Ол жерде әрқашан есік болды ма?
Dialogue: 0,0:04:41.95,0:04:46.56,Style1,,0,0,0,,Некозава-сенпай жарқыраған жерлерді ұнатпайды.
Dialogue: 0,0:04:42.04,0:04:45.70,jp.sub-ja,,0,0,0,,Өйткені Некозава-сенпай жарық жерлерді ұнатпайды.
Dialogue: 0,0:04:46.56,0:04:50.23,Style1,,0,0,0,,Сенің ол кісіге қатысың жоқ болуы керек.
Dialogue: 0,0:04:46.88,0:04:48.82,jp.sub-ja,,0,0,0,,Ол адаммен араласпаңыз
Dialogue: 0,0:04:50.23,0:04:53.56,Style1,,0,0,0,,Олай етсең, қарғысқа ұшырайсың.
Dialogue: 0,0:04:50.42,0:04:52.64,jp.sub-ja,,0,0,0,,Қатысып қалсаң, қарғысқа ұшырайсың.
Dialogue: 0,0:04:53.56,0:04:55.90,Style1,,0,0,0,,Сізде бұл талапқа негіз бар ма?
Dialogue: 0,0:04:53.74,0:04:55.38,jp.sub-ja,,0,0,0,,Кейбір негіз болса да
Dialogue: 0,0:04:55.90,0:05:01.57,Style1,,0,0,0,,Иә. Бұл өткен жылдың аяғындағы сынақтар кезінде...
Dialogue: 0,0:04:56.04,0:05:00.38,jp.sub-ja,,0,0,0,,Иә, бұл өткен жылдың соңында емтихан кезінде болды.
Dialogue: 0,0:05:01.57,0:05:05.23,Style1,,0,0,0,,Әй, бұл туралы айтудың өзі қорқынышты.
Dialogue: 0,0:05:01.92,0:05:04.72,jp.sub-ja,,0,0,0,,Әй, мұны айтудың өзі қорқынышты.
Dialogue: 0,0:05:07.58,0:05:09.58,Style1,,0,0,0,,Тамаки-кун, қайырлы таң.
Dialogue: 0,0:05:07.96,0:05:09.10,jp.sub-ja,,0,0,0,,Қайырлы таң Тамаки-кун
Dialogue: 0,0:05:09.58,0:05:11.14,Style1,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:05:09.66,0:05:10.36,jp.sub-ja,,0,0,0,,Қайырлы таң
Dialogue: 0,0:05:14.25,0:05:22.59,Style1,,0,0,0,,Сол күні мен байқаусызда әлгі қарғыс атқан қуыршақ Белзенефті басып қалған күнім еді...
Dialogue: 0,0:05:14.58,0:05:16.18,jp.sub-ja,,0,0,0,,Мен кездейсоқ
Dialogue: 0,0:05:17.12,0:05:20.52,jp.sub-ja,,0,0,0,,Сол күні мен әлгі қарғыс атқан қуыршақ Белзеневті басқанымда
Dialogue: 0,0:05:22.59,0:05:24.93,Style1,,0,0,0,,Бірден кейін мен тапсырған сынақ санамаланды
Dialogue: 0,0:05:22.86,0:05:24.06,jp.sub-ja,,0,0,0,,Бірден тапсырылған емтиханда
Dialogue: 0,0:05:24.44,0:05:26.98,jp.sub-ja,,0,0,0,,Түсініксіз қарғыс тәрізді кейіпкерлердің тізімі
Dialogue: 0,0:05:24.93,0:05:27.26,Style1,,0,0,0,,түсініксіз әріптермен, қарғыс атқандай!
Dialogue: 0,0:05:27.26,0:05:30.93,Style1,,0,0,0,,Абайлап, айналамдағыларға қарадым, бірақ олардың ешқайсысын білмедім!
Dialogue: 0,0:05:27.38,0:05:29.10,jp.sub-ja,,0,0,0,,Мен күдіктеніп, жан-жағыма қарадым.
Dialogue: 0,0:05:29.58,0:05:32.80,jp.sub-ja,,0,0,0,,Ол бейтаныс адамдарға толы басқа кеңістікке айналды.
Dialogue: 0,0:05:30.93,0:05:32.60,Style1,,0,0,0,,Мен балама өлшемге ауыстым!
Dialogue: 0,0:05:32.60,0:05:33.60,Style1,,0,0,0,,Қандай қорқынышты!
Dialogue: 0,0:05:32.88,0:05:33.90,jp.sub-ja,,0,0,0,,Қорқынышты~
Dialogue: 0,0:05:33.60,0:05:35.60,Style1,,0,0,0,,Бұл шынымен болды ма?
Dialogue: 0,0:05:34.06,0:05:35.30,jp.sub-ja,,0,0,0,,Бұл шынымен де солай ма?
Dialogue: 0,0:05:35.60,0:05:37.61,Style1,,0,0,0,,Бұл сіздің қатты шайқалғаныңыз үшін,
Dialogue: 0,0:05:35.88,0:05:37.68,jp.sub-ja,,0,0,0,,Бұл сіздің ренжігеніңіз үшін.
Dialogue: 0,0:05:37.61,0:05:40.94,Style1,,0,0,0,,сіз барып, грек сыныбына тест тапсырдыңыз.
Dialogue: 0,0:05:37.94,0:05:40.80,jp.sub-ja,,0,0,0,,Мен рұқсатсыз грек тілі курсына емтихан тапсырып жатыр едім.
Dialogue: 0,0:05:40.94,0:05:43.88,Style1,,0,0,0,,Жоқ! Бұл қарғыс болды! Не керек, үш күннен кейін, таңертең,
Dialogue: 0,0:05:41.02,0:05:42.24,jp.sub-ja,,0,0,0,,Жоқ, бұл қарғыс.
Dialogue: 0,0:05:42.48,0:05:43.92,jp.sub-ja,,0,0,0,,Оның үстіне үш күннен кейін таңертең
Dialogue: 0,0:05:43.88,0:05:47.22,Style1,,0,0,0,,неге екені белгісіз, аяғым қорғасындай ауыр болып қалды!
Dialogue: 0,0:05:44.14,0:05:47.20,jp.sub-ja,,0,0,0,,Неге екені белгісіз, аяғым қорғасындай ауыр болып қалды.
Dialogue: 0,0:05:47.22,0:05:50.89,Style1,,0,0,0,,Себебі бір күн бұрын сізде сол марафон болды, солай ма?
Dialogue: 0,0:05:47.64,0:05:50.80,jp.sub-ja,,0,0,0,,Одан бір күн бұрын марафон болған шығар.
Dialogue: 0,0:05:50.89,0:05:56.23,Style1,,0,0,0,,Қарғыс қуыршақ Белзенефтің күші шынайы.
Dialogue: 0,0:05:51.20,0:05:55.50,jp.sub-ja,,0,0,0,,Мына қарғыс атқан қуыршақ Белзеневтің күші шын
Dialogue: 0,0:05:56.23,0:06:01.23,Style1,,0,0,0,,Осы қуыршақтың арқасына жек көретін адамның атын ойып жазсаңыз,
Dialogue: 0,0:05:56.46,0:06:00.90,jp.sub-ja,,0,0,0,,Осы қуыршақтың артына жек көретін адамның атын ойып жазсаңыз
Dialogue: 0,0:06:01.23,0:06:05.23,Style1,,0,0,0,,олар бақытсыздыққа тап болады.
Dialogue: 0,0:06:01.42,0:06:04.64,jp.sub-ja,,0,0,0,,Ол адам әрқашан бақытсыз болады.
Dialogue: 0,0:06:05.23,0:06:08.24,Style1,,0,0,0,,Бұл жігіт шынымен де қараңғы, бірнеше жағынан.
Dialogue: 0,0:06:05.50,0:06:07.96,jp.sub-ja,,0,0,0,,Бұл адам көп жағынан шынымен қараңғы.
Dialogue: 0,0:06:08.24,0:06:12.64,Style1,,0,0,0,,Жарқын жарықтарды жек көретінін айтады. Бұл оған қалай ұнайды деп ойлаймын.
Dialogue: 0,0:06:08.36,0:06:10.22,jp.sub-ja,,0,0,0,,Мен жарықты жек көремін
Dialogue: 0,0:06:10.78,0:06:12.26,jp.sub-ja,,0,0,0,,Осыншама ше?
Dialogue: 0,0:06:16.50,0:06:18.26,jp.sub-ja,,0,0,0,,Кісі өлтіру~
Dialogue: 0,0:06:16.58,0:06:18.71,Style1,,0,0,0,,Кісі өлтірушілер!
Dialogue: 0,0:06:22.40,0:06:24.70,jp.sub-ja,,0,0,0,,Хикари Каору Не?
Dialogue: 0,0:06:22.58,0:06:24.59,Style1,,0,0,0,,Хикару, Каору, сен қалайсың!?
Dialogue: 0,0:06:24.59,0:06:29.26,Style1,,0,0,0,,Сіз қара магияның нағыз қорқынышын білмейсіз!
Dialogue: 0,0:06:24.84,0:06:27.92,jp.sub-ja,,0,0,0,,Сіз қара магияның нағыз сұмдығын түсінбейсіз.
Dialogue: 0,0:06:29.26,0:06:31.26,Style1,,0,0,0,,А, мен жалықтым.
Dialogue: 0,0:06:29.64,0:06:31.02,jp.sub-ja,,0,0,0,,А, бұл қызықсыз.
Dialogue: 0,0:06:31.26,0:06:34.23,Style1,,0,0,0,,Біз жасай алатын қызық нәрсе жоқ па?
Dialogue: 0,0:06:31.52,0:06:33.50,jp.sub-ja,,0,0,0,,Қызықты нәрсе бар ма?
Dialogue: 0,0:06:35.80,0:06:39.42,jp.sub-ja,,0,0,0,,Менеджердің қадір-қасиеті еленбейді.
Dialogue: 0,0:06:36.13,0:06:40.26,Style1,,0,0,0,,Менің президент ретіндегі абыройым... еленбейді...
Dialogue: 0,0:06:41.27,0:06:44.54,Style1,,0,0,0,,Айтшы, Харухи, біздің бір жақсылығымыз бар.
Dialogue: 0,0:06:41.38,0:06:43.96,jp.sub-ja,,0,0,0,,Эй, Харухи, менің сенен бір жақсылығым бар.
Dialogue: 0,0:06:44.54,0:06:45.21,Style1,,0,0,0,,Не болды?
Dialogue: 0,0:06:45.21,0:06:46.88,Style1,,0,0,0,,Келесі демалыс күні біз...
Dialogue: 0,0:06:45.66,0:06:46.88,jp.sub-ja,,0,0,0,,Келесі мереке
Dialogue: 0,0:06:46.88,0:06:50.55,Style1,,0,0,0,,...сенің үйіңе келе аламыз ба?
Dialogue: 0,0:06:47.16,0:06:50.04,jp.sub-ja,,0,0,0,,Сыртқа шығып ойнауға болады.
Dialogue: 0,0:06:50.55,0:06:51.88,Style1,,0,0,0,,Неліктен?
Dialogue: 0,0:06:50.64,0:06:51.76,jp.sub-ja,,0,0,0,,Неліктен тағы?
Dialogue: 0,0:06:51.88,0:06:53.55,Style1,,0,0,0,,Өйткені біз оны қатты қызықтырамыз.
Dialogue: 0,0:06:52.18,0:06:53.92,jp.sub-ja,,0,0,0,,Мені шынымен қызықтырады.
Dialogue: 0,0:06:53.55,0:06:54.55,Style1,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:06:54.04,0:06:54.30,jp.sub-ja,,0,0,0,,Жақсы емес
Dialogue: 0,0:06:54.55,0:06:55.55,Style1,,0,0,0,,Ешқайсысы жоқ па?
Dialogue: 0,0:06:54.90,0:06:55.64,jp.sub-ja,,0,0,0,,Қалай болғанда да?
Dialogue: 0,0:06:55.55,0:06:57.89,Style1,,0,0,0,,Мүмкін емес. Сіз мені мазақ етесіз.
Dialogue: 0,0:06:55.94,0:06:57.84,jp.sub-ja,,0,0,0,,Жоқ, мен сені бәрібір мазақ етемін.
Dialogue: 0,0:06:57.89,0:07:00.32,Style1,,0,0,0,,- Қанша сұрасақ та? - Мүмкін емес.
Dialogue: 0,0:06:58.28,0:06:59.68,jp.sub-ja,,0,0,0,,Қанша сұрасаң да?
Dialogue: 0,0:06:59.98,0:07:00.42,jp.sub-ja,,0,0,0,,Жақсы емес
Dialogue: 0,0:07:00.32,0:07:05.56,Style1,,0,0,0,,Мен де көптен бері Харухидің отбасына құрмет көрсетуім керек деп ойладым.
Dialogue: 0,0:07:00.70,0:07:03.54,jp.sub-ja,,0,0,0,,Мен үшін де солай, бірақ Харухидің отбасы үшін.
Dialogue: 0,0:07:03.98,0:07:05.92,jp.sub-ja,,0,0,0,,Сәлем беруім керек деп ойладым.
Dialogue: 0,0:07:05.56,0:07:07.23,Style1,,0,0,0,,Тозақта жол жоқ.
Dialogue: 0,0:07:05.94,0:07:06.84,jp.sub-ja,,0,0,0,,Мүлдем жоқ
Dialogue: 0,0:07:07.23,0:07:10.30,Style1,,0,0,0,,Олай болса, осылай жасайық. Сағынсаң
Dialogue: 0,0:07:07.32,0:07:08.50,jp.sub-ja,,0,0,0,,Олай болса мұны істейік.
Dialogue: 0,0:07:09.12,0:07:12.42,jp.sub-ja,,0,0,0,,Ойында Хикари-кунның қайсысы екенін таба алмасаңыз
Dialogue: 0,0:07:10.30,0:07:12.57,Style1,,0,0,0,,«Қайсысы Хикару-кун ойынында»
Dialogue: 0,0:07:12.57,0:07:13.77,Style1,,0,0,0,,айыппұл ретінде,
Dialogue: 0,0:07:12.78,0:07:14.78,jp.sub-ja,,0,0,0,,Жаза ретінде үйге бару
Dialogue: 0,0:07:13.77,0:07:15.33,Style1,,0,0,0,,біз сіздің үйіңізге келеміз.
Dialogue: 0,0:07:19.58,0:07:22.24,Style1,,0,0,0,,Жарайды, Хикару-кун қайсысымыз?
Dialogue: 0,0:07:20.56,0:07:22.08,jp.sub-ja,,0,0,0,,Иә, Хикари-кун қайсысы?
Dialogue: 0,0:07:22.24,0:07:24.58,Style1,,0,0,0,,Сен Каорусың, ал сен Хикарусың.
Dialogue: 0,0:07:22.48,0:07:24.52,jp.sub-ja,,0,0,0,,Мынау Каору, мынау жарық
Dialogue: 0,0:07:24.58,0:07:27.24,Style1,,0,0,0,,Bzzzt! Сіз қате түсіндіңіз!
Dialogue: 0,0:07:24.82,0:07:26.76,jp.sub-ja,,0,0,0,,бұл~ шетте~
Dialogue: 0,0:07:28.25,0:07:32.38,Style1,,0,0,0,,Жоқ, болмады. Сіз өте ұқсассыз, бірақ сіз басқашасыз.
Dialogue: 0,0:07:28.40,0:07:29.40,jp.sub-ja,,0,0,0,,Өшірілген емес.
Dialogue: 0,0:07:30.02,0:07:31.94,jp.sub-ja,,0,0,0,,Олар өте ұқсас, бірақ бәрібір олар әртүрлі.
Dialogue: 0,0:07:39.93,0:07:41.93,Style1,,0,0,0,,Айт, Харухи-кун,
Dialogue: 0,0:07:40.32,0:07:41.54,jp.sub-ja,,0,0,0,,Нене Харухи-кун
Dialogue: 0,0:07:41.93,0:07:45.20,Style1,,0,0,0,,олар шаштарын оңға немесе солға бөлген кезде,
Dialogue: 0,0:07:42.22,0:07:45.06,jp.sub-ja,,0,0,0,,Шаш үлгісінің оң жағы мен сол жағы жасырылған кезде
Dialogue: 0,0:07:45.20,0:07:47.54,Style1,,0,0,0,,Хикару-кун мен Каору-кунның айырмашылығы
Dialogue: 0,0:07:45.72,0:07:49.68,jp.sub-ja,,0,0,0,,Мен Хикару-кун мен Каору-кунды ажырата алмаймын.
Dialogue: 0,0:07:47.54,0:07:49.87,Style1,,0,0,0,,мүлдем ажыратылмайтын болады.
Dialogue: 0,0:07:49.87,0:07:52.21,Style1,,0,0,0,,Оларды қалай ажыратуға болады?
Dialogue: 0,0:07:50.22,0:07:51.58,jp.sub-ja,,0,0,0,,Сіз қалай айттыңыз?
Dialogue: 0,0:07:52.21,0:07:55.54,Style1,,0,0,0,,Ой, көрейік...
Dialogue: 0,0:07:53.28,0:07:54.74,jp.sub-ja,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:55.54,0:07:58.55,Style1,,0,0,0,,Мен айту керек болса...
Dialogue: 0,0:07:55.90,0:07:56.96,jp.sub-ja,,0,0,0,,Егер мен мұны айту керек болсам,
Dialogue: 0,0:07:58.40,0:08:03.14,jp.sub-ja,,0,0,0,,Хикарудың мінез-құлқы Каорудан 10% нашар.
Dialogue: 0,0:07:58.55,0:08:03.95,Style1,,0,0,0,,Хикарудың сөзі мен іс-әрекеті Каорудікінен он пайызға артық.
Dialogue: 0,0:08:03.95,0:08:07.68,Style2,,0,0,0,,«Ешқандай құқық бұзушылық қарастырылмаған»
Dialogue: 0,0:08:10.23,0:08:12.49,Style1,,0,0,0,,Кешіріңіз, Хикару!
Dialogue: 0,0:08:10.30,0:08:11.68,jp.sub-ja,,0,0,0,,Кешіріңіз, Хикари
Dialogue: 0,0:08:14.56,0:08:19.57,Style1,,0,0,0,,Мен ештеңені жасырмаймын және әрқашан өз ойымды ашық айтамын,
Dialogue: 0,0:08:14.70,0:08:16.88,jp.sub-ja,,0,0,0,,Ал, мен ештеңені жасырмаймын.
Dialogue: 0,0:08:17.06,0:08:19.30,jp.sub-ja,,0,0,0,,Әрқашан адал сөйле
Dialogue: 0,0:08:19.52,0:08:22.36,jp.sub-ja,,0,0,0,,Каору - арамза адам.
Dialogue: 0,0:08:19.57,0:08:22.91,Style1,,0,0,0,,сондықтан Каору өшпендірек.
Dialogue: 0,0:08:22.91,0:08:24.57,Style1,,0,0,0,,Бұны айналдырмаңыз.
Dialogue: 0,0:08:23.16,0:08:24.54,jp.sub-ja,,0,0,0,,Ештеңе айтпа.
Dialogue: 0,0:08:24.57,0:08:26.91,Style1,,0,0,0,,Хикару, мен әрқашан бірге жүретін адаммын,
Dialogue: 0,0:08:25.14,0:08:28.80,jp.sub-ja,,0,0,0,,Мен жарықтың өзімшілдік ойынына қосылатын адаммын деп ойлаймын.
Dialogue: 0,0:08:26.91,0:08:28.91,Style1,,0,0,0,,Өзіңнің өзімшіл ойындарыңды ойнайсың ба?
Dialogue: 0,0:08:28.91,0:08:30.91,Style1,,0,0,0,,Мен оларды ұсынатын адам болуым мүмкін,
Dialogue: 0,0:08:29.22,0:08:32.46,jp.sub-ja,,0,0,0,,Мен бастаған болсам да, оны қазбалайтын Каору.
Dialogue: 0,0:08:30.91,0:08:32.92,Style1,,0,0,0,,бірақ сен оларға кіресің, Каору.
Dialogue: 0,0:08:32.92,0:08:35.42,Style1,,0,0,0,,Олар сізге ұнамаса, тоқтаңыз. Сен несің, ақымақ?
Dialogue: 0,0:08:32.98,0:08:35.20,jp.sub-ja,,0,0,0,,Ұнамаса тоқта, ақымақ.
Dialogue: 0,0:08:35.42,0:08:38.92,Style1,,0,0,0,,Сен оны өз көзіңмен көру үшін тым ақымақсың, Хикару.
Dialogue: 0,0:08:35.68,0:08:38.76,jp.sub-ja,,0,0,0,,Жарық тым ақымақ болғандықтан шығар.
Dialogue: 0,0:08:38.92,0:08:41.26,Style1,,0,0,0,,Сіз оны ойыншық деп атағаныңыз сияқты,
Dialogue: 0,0:08:39.34,0:08:41.08,jp.sub-ja,,0,0,0,,Жалпы айтқанда, бұл ойыншық.
Dialogue: 0,0:08:41.26,0:08:44.26,Style1,,0,0,0,,сіз оған өте жылдам болдыңыз.
Dialogue: 0,0:08:41.62,0:08:43.66,jp.sub-ja,,0,0,0,,Әрқашан нәрселермен тез араласады.
Dialogue: 0,0:08:44.26,0:08:49.26,Style1,,0,0,0,,Хикару, сен Харухиге шынымен ғашықсың, солай ма?
Dialogue: 0,0:08:44.50,0:08:48.36,jp.sub-ja,,0,0,0,,Хикари, саған Харухи қатты ұнайды, солай ма?
Dialogue: 0,0:08:49.26,0:08:50.27,Style1,,0,0,0,,Иә!?
Dialogue: 0,0:08:50.23,0:08:51.06,Style2,,0,0,0,,"Не?!"
Dialogue: 0,0:08:50.27,0:08:51.60,Style1,,0,0,0,,Не!?
Dialogue: 0,0:08:51.60,0:08:55.27,Style1,,0,0,0,,H-эй, сен бәрін дұрыс түсіндің! Сен шынымен ақымақсың, Каору!
Dialogue: 0,0:08:51.90,0:08:55.14,jp.sub-ja,,0,0,0,,Сіз нені түсінбедіңіз? Сен ақымақсың ғой, Каору.
Dialogue: 0,0:08:55.27,0:08:58.61,Style1,,0,0,0,,Иә! Бұл дүниеде айта алмайтын және айта алмайтын нәрселер бар!
Dialogue: 0,0:08:55.44,0:08:58.54,jp.sub-ja,,0,0,0,,Иә, бұл дүниеде жақсы да, жаман да бар.
Dialogue: 0,0:08:58.61,0:09:01.61,Style1,,0,0,0,,Біріншіден, мен әлгі кішкентай танукиге қалай құмар едім? (Тануки - пішінін өзгертетін енот ит)
Dialogue: 0,0:08:58.84,0:09:01.58,jp.sub-ja,,0,0,0,,Неліктен мен Харухи сияқты бұршақ дануки ойнаймын?
Dialogue: 0,0:09:01.61,0:09:06.28,Style1,,0,0,0,,Харухиді кішкене тануки деп не айтасыз!?
Dialogue: 0,0:09:01.76,0:09:06.22,jp.sub-ja,,0,0,0,,Харухиді мамедануки деп атағанның несі жаман?
Dialogue: 0,0:09:06.28,0:09:08.08,Style1,,0,0,0,,Фантастикалық. Бұл фантастикалық.
Dialogue: 0,0:09:06.46,0:09:08.18,jp.sub-ja,,0,0,0,,Керемет Бұл тамаша.
Dialogue: 0,0:09:08.08,0:09:09.81,Style2,,0,0,0,,«Қуатты қозғалтқыш»
Dialogue: 0,0:09:10.62,0:09:15.96,Style1,,0,0,0,,Харухи-кунның айналасындағы әдемі, сонымен бірге өткір төрт жақты қарым-қатынас.
Dialogue: 0,0:09:11.00,0:09:15.86,jp.sub-ja,,0,0,0,,Харухидің айналасындағы әдемі, бірақ қайғылы төрт жақты қарым-қатынас
Dialogue: 0,0:09:15.96,0:09:18.63,Style1,,0,0,0,,Сонымен қатар, фигуралардың екеуі егіз,
Dialogue: 0,0:09:16.48,0:09:20.22,jp.sub-ja,,0,0,0,,Оның үстіне екеуі егіз.
Dialogue: 0,0:09:18.63,0:09:20.63,Style1,,0,0,0,,бұл дамуға батып кетті!
Dialogue: 0,0:09:20.63,0:09:24.97,Style1,,0,0,0,,Ренге оның үстіне үш тостаған күріш жеуге болады!
Dialogue: 0,0:09:20.86,0:09:24.94,jp.sub-ja,,0,0,0,,Ренге енді үш есе көп күріш болуы мүмкін.
Dialogue: 0,0:09:24.97,0:09:26.64,Style1,,0,0,0,,Отаку сен бұлай болма.
Dialogue: 0,0:09:25.30,0:09:26.46,jp.sub-ja,,0,0,0,,Отакус аулақ болуы керек
Dialogue: 0,0:09:26.64,0:09:29.97,Style1,,0,0,0,,Қалай деген сөз! Менеджеріңізге айтқаныңыз қандай жаман!
Dialogue: 0,0:09:26.82,0:09:29.98,jp.sub-ja,,0,0,0,,Менеджерге қорқынышты, қорқынышты.
Dialogue: 0,0:09:29.97,0:09:33.31,Style1,,0,0,0,,Ренге-кун, саған да Харухи ұнады деп ойладым.
Dialogue: 0,0:09:30.12,0:09:33.00,jp.sub-ja,,0,0,0,,Ренге-кун, саған Харухи ұнады деп ойлаймын.
Dialogue: 0,0:09:33.31,0:09:36.31,Style1,,0,0,0,,Бұл басқа мәселе. Әрқашан көбірек орын бар екенін бәрі біледі
Dialogue: 0,0:09:33.48,0:09:34.28,jp.sub-ja,,0,0,0,,Міне
Dialogue: 0,0:09:34.62,0:09:37.98,jp.sub-ja,,0,0,0,,Қазіргі уақытта гомосексуалдық қарым-қатынастардың әртүрлі екені белгілі.
Dialogue: 0,0:09:36.31,0:09:38.58,Style1,,0,0,0,,осы күндері гомосексуалдық қатынастар үшін.
Dialogue: 0,0:09:39.65,0:09:43.99,Style1,,0,0,0,,Мен сізді Францияға үйге кетті деп ойладым.
Dialogue: 0,0:09:39.72,0:09:43.68,jp.sub-ja,,0,0,0,,Негізі, мен сізді Францияға оралған шығар деп ойладым.
Dialogue: 0,0:09:43.99,0:09:50.26,Style1,,0,0,0,,Францияда қабылдаушы клубтарды бастауға әлі ерте, және ол аяқталмайды.
Dialogue: 0,0:09:44.06,0:09:46.42,jp.sub-ja,,0,0,0,,Өйткені Францияда хост клубын құруға тырыссаңыз да.
Dialogue: 0,0:09:46.90,0:09:49.08,jp.sub-ja,,0,0,0,,Әлі ерте емес
Dialogue: 0,0:09:50.26,0:09:52.26,Style1,,0,0,0,,Жетеді!
Dialogue: 0,0:09:50.70,0:09:52.06,jp.sub-ja,,0,0,0,,Эй, Нагаре, басынан бастап бар күшіңді салып жатырсың ба?
Dialogue: 0,0:09:52.26,0:09:55.26,Style1,,0,0,0,,Сіз әрқашан менің төсегіме кіресіз! Сен сондай зиянкессің!
Dialogue: 0,0:09:52.30,0:09:55.30,jp.sub-ja,,0,0,0,,Ол ылғи басқалардың төсегіне кіріп, сондай мазасызданады.
Dialogue: 0,0:09:55.26,0:09:57.27,Style1,,0,0,0,,Себебі сен жалғызсың, Хикару.
Dialogue: 0,0:09:55.60,0:09:56.98,jp.sub-ja,,0,0,0,,Себебі жарық жалғыз болып көрінеді
Dialogue: 0,0:09:57.12,0:09:59.68,jp.sub-ja,,0,0,0,,Менімен жатудан басқа амалың жоқ еді, ақымақ.
Dialogue: 0,0:09:57.27,0:09:59.60,Style1,,0,0,0,,Сенің жаныңда жатудан басқа амалым қалмады, ақымақ!
Dialogue: 0,0:09:59.60,0:10:02.60,Style1,,0,0,0,,Кімді ақымақ дейсің!? Сіз бірнеше сабақтарда нашар оқисыз!
Dialogue: 0,0:09:59.90,0:10:02.70,jp.sub-ja,,0,0,0,,Менде не ақымақтық бар? Мен математикадан әлсізмін.
Dialogue: 0,0:10:02.60,0:10:06.94,Style1,,0,0,0,,Қараңдаршы, кім сөйлеп жатыр! Хикару, тіл білімін көбірек оқу керек шығар!
Dialogue: 0,0:10:02.88,0:10:06.58,jp.sub-ja,,0,0,0,,Мен Хикариге тілді көбірек үйрену керек деп жиі айтамын.
Dialogue: 0,0:10:06.94,0:10:08.28,Style1,,0,0,0,,Тістеріңізді қатты қайрайсыз!
Dialogue: 0,0:10:07.32,0:10:08.58,jp.sub-ja,,0,0,0,,Тісімді шуылдасам да
Dialogue: 0,0:10:08.28,0:10:10.95,Style1,,0,0,0,,Ұйқыда лақтырып, төсектен құлайтын кім!?
Dialogue: 0,0:10:08.68,0:10:11.06,jp.sub-ja,,0,0,0,,Кім нашар ұйықтап, төсекке құлап жатыр?
Dialogue: 0,0:10:10.95,0:10:12.28,Style1,,0,0,0,,- Секс пикси! - Науқас!
Dialogue: 0,0:10:11.08,0:10:11.76,jp.sub-ja,,0,0,0,,Эротикалық каппа
Dialogue: 0,0:10:11.80,0:10:12.40,jp.sub-ja,,0,0,0,,Оған не болды?
Dialogue: 0,0:10:12.28,0:10:14.28,Style1,,0,0,0,,Мамаң тым көп боянады!
Dialogue: 0,0:10:12.56,0:10:14.16,jp.sub-ja,,0,0,0,,Анаң қатты боянады
Dialogue: 0,0:10:14.28,0:10:15.72,Style1,,0,0,0,,Біз аяқталды!
Dialogue: 0,0:10:14.40,0:10:15.04,jp.sub-ja,,0,0,0,,Бұл тұйыққа тіреледі
Dialogue: 0,0:10:27.96,0:10:29.52,Style1,,0,0,0,,Харухи!
Dialogue: 0,0:10:28.24,0:10:28.76,jp.sub-ja,,0,0,0,,Харухи
Dialogue: 0,0:10:33.64,0:10:34.26,jp.sub-ja,,0,0,0,,Қайырлы таң
Dialogue: 0,0:10:33.64,0:10:35.30,Style1,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:10:35.30,0:10:38.97,Style1,,0,0,0,,Хикару? Шашыңыз не болды?
Dialogue: 0,0:10:35.64,0:10:38.12,jp.sub-ja,,0,0,0,,Жарық, анау басына не болды?
Dialogue: 0,0:10:38.97,0:10:40.98,Style1,,0,0,0,,Неліктен қызғылт түсті?
Dialogue: 0,0:10:39.34,0:10:40.70,jp.sub-ja,,0,0,0,,Неліктен қызғылт түсті?
Dialogue: 0,0:10:40.98,0:10:45.58,Style1,,0,0,0,,Бұл маған жақсы көрінеді. Сүйкімді емес пе? Бүгіннен бастап қызғылт - мен.
Dialogue: 0,0:10:41.20,0:10:43.04,jp.sub-ja,,0,0,0,,Бұл сізге жақсы көрінеді, сондықтан сүйкімді болуы керек
Dialogue: 0,0:10:43.82,0:10:45.34,jp.sub-ja,,0,0,0,,Өйткені бүгіннен бастап қызғылт түсті мен
Dialogue: 0,0:10:45.58,0:10:49.95,Style1,,0,0,0,,Мен Каору деп қателескенімді мәңгілікке көтере алмадым.
Dialogue: 0,0:10:45.80,0:10:49.32,jp.sub-ja,,0,0,0,,Мен мәңгілікке Каору деп қателесуге шыдай алмаймын.
Dialogue: 0,0:10:54.92,0:10:56.93,Style1,,0,0,0,,Қайырлы таң, Харухи.
Dialogue: 0,0:10:55.10,0:10:56.20,jp.sub-ja,,0,0,0,,Қайырлы таң Харухи
Dialogue: 0,0:10:56.93,0:10:58.93,Style1,,0,0,0,,Каору, сен көкпен жүрдің.
Dialogue: 0,0:10:57.06,0:10:58.74,jp.sub-ja,,0,0,0,,Каору көк түсті
Dialogue: 0,0:10:58.93,0:11:02.26,Style1,,0,0,0,,Кеше түнде мен жалғыз ұйықтауға сирек мүмкіндік алдым,
Dialogue: 0,0:10:59.24,0:11:01.94,jp.sub-ja,,0,0,0,,Әдемі болып жалғыз ұйықтасам да
Dialogue: 0,0:11:02.26,0:11:04.27,Style1,,0,0,0,,Бірақ мен жаман түс көрдім.
Dialogue: 0,0:11:02.48,0:11:03.80,jp.sub-ja,,0,0,0,,Мен жаман түс көрдім
Dialogue: 0,0:11:04.27,0:11:07.27,Style1,,0,0,0,,Көрдіңіз бе, менің шашым қызғылт түске боялған...
Dialogue: 0,0:11:04.54,0:11:07.00,jp.sub-ja,,0,0,0,,Менің шашым қызғылт.
Dialogue: 0,0:11:07.27,0:11:11.26,Style1,,0,0,0,,...ең ғажайып көлеңке, бұл түсімде мен көрдім.
Dialogue: 0,0:11:07.64,0:11:10.72,jp.sub-ja,,0,0,0,,Мен шашымды осындай дәмсіз түске бояуды армандадым.
Dialogue: 0,0:11:41.80,0:11:48.37,Style2,,0,0,0,,«Асханадағы түскі үзіліс»
Dialogue: 0,0:11:50.91,0:11:52.91,Style1,,0,0,0,,Түскі ас.
Dialogue: 0,0:11:51.28,0:11:52.06,jp.sub-ja,,0,0,0,,Түскі ас
Dialogue: 0,0:11:52.91,0:11:54.05,Style1,,0,0,0,,Екінші ойға келгенде,
Dialogue: 0,0:11:53.30,0:11:54.92,jp.sub-ja,,0,0,0,,Күтілгендей, Б-ның макарон және Д-ның салаты.
Dialogue: 0,0:11:54.05,0:11:55.58,Style1,,0,0,0,,B макарон және D салаты!
Dialogue: 0,0:11:55.58,0:11:56.92,Style1,,0,0,0,,Менің айтайын дегенім, F cappellini
Dialogue: 0,0:11:55.92,0:11:57.84,jp.sub-ja,,0,0,0,,Ф капеллини мен Барбари үйрегі емес
Dialogue: 0,0:11:56.92,0:11:58.65,Style1,,0,0,0,,барбар үйрекпен - жоқ, оны бір жаққа қойыңыз,
Dialogue: 0,0:11:57.98,0:11:58.78,jp.sub-ja,,0,0,0,,...
Dialogue: 0,0:11:58.65,0:11:59.65,Style1,,0,0,0,,және оны фуа грас поэле етіңіз,
Dialogue: 0,0:11:58.86,0:12:00.48,jp.sub-ja,,0,0,0,,Периге соусы қосылған фуэ гра пуартасы
Dialogue: 0,0:11:59.65,0:12:00.92,Style1,,0,0,0,,Периге соусында!
Dialogue: 0,0:12:00.88,0:12:03.88,jp.sub-ja,,0,0,0,,Елікпе Мен саған еліктеме деп айтып тұрмын
Dialogue: 0,0:12:00.92,0:12:02.26,Style1,,0,0,0,,Мені көшіруді тоқтатыңыз!
Dialogue: 0,0:12:02.26,0:12:04.59,Style1,,0,0,0,,Мен саған көшірме дедім ғой!?
Dialogue: 0,0:12:06.26,0:12:10.27,Style1,,0,0,0,,Керемет. Олар үйлесімді күреседі.
Dialogue: 0,0:12:06.42,0:12:09.06,jp.sub-ja,,0,0,0,,Керемет! Хамо жігіттері төбелесіп жатыр.
Dialogue: 0,0:12:10.27,0:12:12.93,Style1,,0,0,0,,Мен бұл жерде шу болып жатыр деп ойладым.
Dialogue: 0,0:12:10.54,0:12:12.36,jp.sub-ja,,0,0,0,,Егер сіз шулы деп ойласаңыз
Dialogue: 0,0:12:12.93,0:12:17.27,Style1,,0,0,0,,Екеуің әлі ұрысып жатырсыңдар ма? Сіз Хост клубын ұятқа қалдырып жатырсыз.
Dialogue: 0,0:12:13.26,0:12:17.00,jp.sub-ja,,0,0,0,,Балалар, әлі де төбелесіп жатырсыңдар ма? Қабылдаушы клуб үшін бұл ұят.
Dialogue: 0,0:12:17.27,0:12:18.61,Style1,,0,0,0,,Бұл Хост клубы.
Dialogue: 0,0:12:17.62,0:12:18.18,jp.sub-ja,,0,0,0,,Хост бөлігі
Dialogue: 0,0:12:18.61,0:12:19.94,Style1,,0,0,0,,О, Хост клубы.
Dialogue: 0,0:12:18.62,0:12:20.02,jp.sub-ja,,0,0,0,,Ал, қабылдаушы бөлім.
Dialogue: 0,0:12:19.94,0:12:21.98,Style1,,0,0,0,,Хост клубының ұлдары барлығы бірге.
Dialogue: 0,0:12:20.18,0:12:22.24,jp.sub-ja,,0,0,0,,Қабылдаушы клубтың барлығы осында.
Dialogue: 0,0:12:21.98,0:12:26.41,Style2,,0,0,0,,«Қоян сумосы»
Dialogue: 0,0:12:22.61,0:12:27.14,Style1,,0,0,0,,Жарайды, үзіліс! Бұл ұрысқа екеуің де кінәлісіңдер.
Dialogue: 0,0:12:22.76,0:12:24.24,jp.sub-ja,,0,0,0,,Иә, бәрі осы.
Dialogue: 0,0:12:24.58,0:12:26.90,jp.sub-ja,,0,0,0,,Жекпе-жектегі табыс
Dialogue: 0,0:12:28.28,0:12:33.62,Style1,,0,0,0,,Хика-чан мен Као-чан, осы тортқа жартылай тамақтанып, татуласып кетіңдер! Жақсы?
Dialogue: 0,0:12:28.40,0:12:32.14,jp.sub-ja,,0,0,0,,Хика-чан да, Као-чан да торттың жартысын жеп болған соң, татуласып кетті.
Dialogue: 0,0:12:32.42,0:12:33.28,Style2,,0,0,0,,«Жарайды?»
Dialogue: 0,0:12:33.62,0:12:38.63,Style1,,0,0,0,,О, бірақ мен де жегім келеді, сондықтан үшінші рет өтуіміз керек деп ойлаймын.
Dialogue: 0,0:12:33.98,0:12:38.40,jp.sub-ja,,0,0,0,,Бірақ мен де оны жегім келеді, сондықтан оның үштен бір бөлігі шығар.
Dialogue: 0,0:12:38.63,0:12:42.63,Style1,,0,0,0,,Құлпынайды бөле алмаймыз, сонда не істейміз?
Dialogue: 0,0:12:38.90,0:12:42.62,jp.sub-ja,,0,0,0,,Мен құлпынайларды бөле алмаймын, не істеуім керек?
Dialogue: 0,0:12:42.63,0:12:44.73,Style1,,0,0,0,,Мүмкін мен оны қабылдауым керек шығар.
Dialogue: 0,0:12:42.94,0:12:44.38,jp.sub-ja,,0,0,0,,Мен оны ала аламын ба?
Dialogue: 0,0:12:42.96,0:12:55.67,Style2,,0,0,0,,«Тітіркену»
Dialogue: 0,0:12:44.73,0:12:47.90,Style1,,0,0,0,,Мен құлпынайды жақсы көремін, солай ма?
Dialogue: 0,0:12:44.82,0:12:47.62,jp.sub-ja,,0,0,0,,Өйткені маған құлпынай ұнайды, солай ма?
Dialogue: 0,0:12:47.90,0:12:52.94,Style1,,0,0,0,,О, бірақ Хика-чан мен Као-чан, сендер де құлпынай ұнатасыңдар ма?
Dialogue: 0,0:12:49.88,0:12:52.08,jp.sub-ja,,0,0,0,,Хика-чан да, Као-чан да құлпынайды жақсы көреді
Dialogue: 0,0:12:56.24,0:12:58.58,Style1,,0,0,0,,Сіз жай ғана жағдайды нашарлатып жатырсыз, сондықтан тоқтаңыз.
Dialogue: 0,0:12:56.36,0:12:58.34,jp.sub-ja,,0,0,0,,Тоқтаңыз, себебі жағдай нашарлайды.
Dialogue: 0,0:12:58.52,0:13:02.08,jp.sub-ja,,0,0,0,,Харухи, сені мектеп асханасында кездестіру сирек.
Dialogue: 0,0:12:58.58,0:13:02.25,Style1,,0,0,0,,О, Харухи! Сізді асханада кездестіргенім ұнайды!
Dialogue: 0,0:13:02.25,0:13:03.92,Style1,,0,0,0,,Мен бұл екеуіне алаңдадым,
Dialogue: 0,0:13:02.40,0:13:05.84,jp.sub-ja,,0,0,0,,Мен бұл екеуіне алаңдадым, сондықтан олардың соңынан еруге болмайды.
Dialogue: 0,0:13:03.92,0:13:06.25,Style1,,0,0,0,,және ойланбастан осында олардың соңынан ерді.
Dialogue: 0,0:13:06.25,0:13:10.49,Style1,,0,0,0,,Мен жәй ғана қораптағы түскі асымды жедім, сондықтан оны сыныпта жегім келді.
Dialogue: 0,0:13:06.70,0:13:10.02,jp.sub-ja,,0,0,0,,Бұл түскі ас қорабы болғандықтан, мен оны сыныпта жегім келді.
Dialogue: 0,0:13:11.93,0:13:14.46,Style1,,0,0,0,,Бір қорап түскі ас?
Dialogue: 0,0:13:12.22,0:13:14.10,jp.sub-ja,,0,0,0,,Түскі ас қорабы~
Dialogue: 0,0:13:12.53,0:13:15.12,Style2,,0,0,0,,«Тамаки қорабы»
Dialogue: 0,0:13:17.93,0:13:20.94,Style1,,0,0,0,,Қымбатты, міне сенің қораптағы түскі асың.
Dialogue: 0,0:13:18.28,0:13:20.26,jp.sub-ja,,0,0,0,,Түскі ас қорабы
Dialogue: 0,0:13:20.94,0:13:26.61,Style1,,0,0,0,,О, бірақ жүрек тәрізді шашыратқыштар біраз ұят болуы мүмкін.
Dialogue: 0,0:13:21.22,0:13:23.62,jp.sub-ja,,0,0,0,,Бірақ жүректерге себілген?
Dialogue: 0,0:13:24.14,0:13:25.72,jp.sub-ja,,0,0,0,,Менің ойымша, бұл аздап ұят болды
Dialogue: 0,0:13:26.61,0:13:28.94,Style1,,0,0,0,,Тіпті сіздің қораптағы түскі асыңызда ұят сезімі бар болса да,
Dialogue: 0,0:13:26.88,0:13:28.88,jp.sub-ja,,0,0,0,,Ұят жүректі түскі ас қорабы болса да
Dialogue: 0,0:13:28.94,0:13:30.95,Style1,,0,0,0,,Мен оны жеуден тартынбас едім!
Dialogue: 0,0:13:29.14,0:13:31.68,jp.sub-ja,,0,0,0,,Мен оны ойланбастан жеймін~
Dialogue: 0,0:13:30.95,0:13:32.95,Style1,,0,0,0,,Мен сенің не айтып тұрғаныңды білмеймін,
Dialogue: 0,0:13:31.14,0:13:32.84,jp.sub-ja,,0,0,0,,Мен сенің не айтып тұрғаныңды білмеймін.
Dialogue: 0,0:13:32.95,0:13:36.95,Style1,,0,0,0,,бірақ мен сіздің адасуларыңыз әрқашан сәйкес келмейтінін білемін.
Dialogue: 0,0:13:33.22,0:13:36.14,jp.sub-ja,,0,0,0,,Мен сіздің адасуларыңызда контекст жоқ екенін түсіндім.
Dialogue: 0,0:13:36.95,0:13:38.95,Style1,,0,0,0,,Харухи, мына жер.
Dialogue: 0,0:13:37.06,0:13:38.62,jp.sub-ja,,0,0,0,,Харухи, бұл жер бос.
Dialogue: 0,0:13:38.95,0:13:40.29,Style1,,0,0,0,,О, жарайды.
Dialogue: 0,0:13:40.29,0:13:42.29,Style1,,0,0,0,,Сіздің қораптағы түскі асыңызда не бар?
Dialogue: 0,0:13:40.50,0:13:41.88,jp.sub-ja,,0,0,0,,Түскі ас қорабы Ішінде не бар?
Dialogue: 0,0:13:42.29,0:13:45.56,Style1,,0,0,0,,Кешегі қайнаған тамақ қалдықтары, біраз оралған омлет және т.б.
Dialogue: 0,0:13:42.62,0:13:45.42,jp.sub-ja,,0,0,0,,Кешегі пісірілген тамақ пен қуырылған жұмыртқа т.б.
Dialogue: 0,0:13:45.56,0:13:49.23,Style1,,0,0,0,,Менімен бірге ауысыңыз. Мен Каорудан басқа нәрсеге тапсырыс бердім,
Dialogue: 0,0:13:45.74,0:13:47.02,jp.sub-ja,,0,0,0,,Оны менікімен ауыстырыңыз.
Dialogue: 0,0:13:47.58,0:13:50.84,jp.sub-ja,,0,0,0,,Мен Каорудан басқа нәрсе сұрағанымда, маған ұнамайтын нәрселер ғана болды.
Dialogue: 0,0:13:49.23,0:13:51.57,Style1,,0,0,0,,мен жек көретін барлық нәрселермен аяқталды.
Dialogue: 0,0:13:51.57,0:13:53.63,Style1,,0,0,0,,Әрине, жақсы...
Dialogue: 0,0:13:51.72,0:13:52.68,jp.sub-ja,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:13:55.57,0:14:01.20,Style1,,0,0,0,,Бұл өте байсалдылық. Мен ешқашан мұндай тағамды жеген емеспін ...
Dialogue: 0,0:13:55.68,0:13:57.42,jp.sub-ja,,0,0,0,,Бұл өте сәнді.
Dialogue: 0,0:13:57.92,0:14:00.62,jp.sub-ja,,0,0,0,,Мен мұндай тағамдарды көп жеген емеспін.
Dialogue: 0,0:14:09.25,0:14:14.26,Style1,,0,0,0,,Дәмді, солай емес пе? Дәмді, солай емес пе, Харухи? Жақсы.
Dialogue: 0,0:14:09.50,0:14:12.64,jp.sub-ja,,0,0,0,,Бұл дәмді болды. Бұл дәмді болды, Харухи.
Dialogue: 0,0:14:13.30,0:14:16.44,jp.sub-ja,,0,0,0,,Жақсы, мен сені күнде тамақтандырғым келеді.
Dialogue: 0,0:14:14.26,0:14:17.09,Style1,,0,0,0,,Мен саған оны күнде жеуге рұқсат еткім келеді.
Dialogue: 0,0:14:18.93,0:14:21.93,Style1,,0,0,0,,Жарайсың, Хикару. Сыйлық ретінде сіз менің түскі асымды іше аласыз,
Dialogue: 0,0:14:19.14,0:14:22.16,jp.sub-ja,,0,0,0,,Сен керемет жұмыс жасадың, Хикари. Мен сізге сыйлық ретінде түскі асымды беремін.
Dialogue: 0,0:14:21.93,0:14:23.93,Style1,,0,0,0,,- ендеше маған қорапша түскі ас ішуге рұқсат етіңіз. - Жоқ.
Dialogue: 0,0:14:22.16,0:14:23.56,jp.sub-ja,,0,0,0,,Маған түскі ас қорабын беріңіз.
Dialogue: 0,0:14:23.93,0:14:24.93,Style1,,0,0,0,,О, олай айтпа.
Dialogue: 0,0:14:24.26,0:14:25.16,jp.sub-ja,,0,0,0,,Олай айтпа
Dialogue: 0,0:14:24.93,0:14:25.93,Style1,,0,0,0,,Мен дайын емеспін.
Dialogue: 0,0:14:25.16,0:14:25.92,jp.sub-ja,,0,0,0,,Янакота
Dialogue: 0,0:14:25.93,0:14:30.61,Style1,,0,0,0,,Харухи, бұл жақсы ма? Сен де менікі алғың келе ме?
Dialogue: 0,0:14:26.20,0:14:28.28,jp.sub-ja,,0,0,0,,Харухи дәмді
Dialogue: 0,0:14:29.04,0:14:30.06,jp.sub-ja,,0,0,0,,Осыны да орындаймыз ба?
Dialogue: 0,0:14:30.61,0:14:33.57,Style1,,0,0,0,,Мұнда. «Аа...»
Dialogue: 0,0:14:36.95,0:14:39.57,Style1,,0,0,0,,Бетті шығару. Кетіңіз.
Dialogue: 0,0:14:37.16,0:14:38.94,jp.sub-ja,,0,0,0,,Маған кедергі болма, кет.
Dialogue: 0,0:14:58.57,0:15:00.97,Style1,,0,0,0,,Сыныпта тамақ ішемін деп ойлаймын.
Dialogue: 0,0:14:58.80,0:15:00.56,jp.sub-ja,,0,0,0,,Сыныпта тамақтанайық
Dialogue: 0,0:15:10.25,0:15:12.58,Style1,,0,0,0,,Егер бұл жағдай жалғаса берсе,
Dialogue: 0,0:15:10.48,0:15:12.30,jp.sub-ja,,0,0,0,,Егер бұл жағдай жалғаса берсе
Dialogue: 0,0:15:12.58,0:15:16.58,Style1,,0,0,0,,біз бауырластық махаббат пакетін ұсынуды тоқтатуымыз керек.
Dialogue: 0,0:15:12.80,0:15:15.66,jp.sub-ja,,0,0,0,,Бауырластық сүйіспеншілікті насихаттауды тоқтатыңыз.
Dialogue: 0,0:15:16.58,0:15:19.92,Style1,,0,0,0,,Біздің тағайындалғандардың мөлшерлемесі төмендеді.
Dialogue: 0,0:15:16.66,0:15:18.80,jp.sub-ja,,0,0,0,,Номинация деңгейі төмендейді.
Dialogue: 0,0:15:19.92,0:15:24.59,Style1,,0,0,0,,О, Харухи, бұл сен үшін жауапкершілікті сезіну керек нәрсе емес.
Dialogue: 0,0:15:21.14,0:15:24.10,jp.sub-ja,,0,0,0,,Харухи ерекше жауапкершілікті сезінбейді.
Dialogue: 0,0:15:24.59,0:15:31.60,Style1,,0,0,0,,Бұл төбелеске сіздің ойсыз пікіріңіз себеп болғанымен.
Dialogue: 0,0:15:25.04,0:15:26.70,jp.sub-ja,,0,0,0,,Жанжалдың себебі болса да
Dialogue: 0,0:15:27.14,0:15:30.86,jp.sub-ja,,0,0,0,,Бұл сенен жүрексіз сөз болса да...
Dialogue: 0,0:15:31.60,0:15:33.83,Style2,,0,0,0,,«Күлімсіреу» «Асхананы тазалауға да алаңдама».
Dialogue: 0,0:15:31.60,0:15:33.84,Style1,,0,0,0,,«Күлімде» Ол мені кінәлап жатқаны анық.
Dialogue: 0,0:15:31.94,0:15:33.74,jp.sub-ja,,0,0,0,,Сіз мені кінәлайсыз.
Dialogue: 0,0:15:33.84,0:15:34.27,Style1,,0,0,0,,Ол мені кінәлап жатқаны анық.
Dialogue: 0,0:15:34.27,0:15:37.94,Style1,,0,0,0,,Хика-чан мен Као-чан бір-бірімен ұрысып жатыр...
Dialogue: 0,0:15:34.74,0:15:39.58,jp.sub-ja,,0,0,0,,Бұл Хика-Чан мен Као-Чанның бірінші рет соғысуы.
Dialogue: 0,0:15:37.94,0:15:40.94,Style1,,0,0,0,,Бұл бұрын-соңды болмаған, иә?
Dialogue: 0,0:15:40.94,0:15:42.61,Style1,,0,0,0,,Бұл дұрыс па?
Dialogue: 0,0:15:41.26,0:15:42.30,jp.sub-ja,,0,0,0,,Солай ма?
Dialogue: 0,0:15:42.61,0:15:48.55,Style1,,0,0,0,,Мен оларды мектепке дейінгі кезінен білемін. Біз бір жылы емес едік,
Dialogue: 0,0:15:44.08,0:15:46.16,jp.sub-ja,,0,0,0,,Мен сені балабақша кезімнен білемін.
Dialogue: 0,0:15:47.08,0:15:50.36,jp.sub-ja,,0,0,0,,Біз әртүрлі сыныптарда оқимыз, сондықтан біз ешқашан сөйлескен емеспіз.
Dialogue: 0,0:15:48.55,0:15:54.46,Style1,,0,0,0,,сондықтан мен олармен ешқашан сөйлескен емеспін, бірақ олар әрқашан бірге ойнайтын сияқты болды.
Dialogue: 0,0:15:51.08,0:15:53.88,jp.sub-ja,,0,0,0,,Әйтеуір, екеуміз бірге ойнайтынбыз.
Dialogue: 0,0:15:56.22,0:16:01.90,Style1,,0,0,0,,Дұрыс айтасыз. Мен оларды орта мектептен бері білемін,
Dialogue: 0,0:15:56.40,0:16:00.70,jp.sub-ja,,0,0,0,,Дұрыс, мен оны орта мектептен бері білемін.
Dialogue: 0,0:16:01.90,0:16:04.16,Style1,,0,0,0,,бірақ олар шынымен де алыс тұрды.
Dialogue: 0,0:16:02.06,0:16:03.56,jp.sub-ja,,0,0,0,,Ол сөзсіз қалқымалы болды.
Dialogue: 0,0:16:08.90,0:16:12.91,Style1,,0,0,0,,Өздерінен басқа, барлығын алшақ ұстағандай болды.
Dialogue: 0,0:16:09.36,0:16:12.36,jp.sub-ja,,0,0,0,,Біз өзімізден басқа ешкімді тығырыққа тіремейтін сияқтымыз.
Dialogue: 0,0:16:12.91,0:16:16.58,Style1,,0,0,0,,Олардың мінездері қазіргіден бірнеше есе бұзылған.
Dialogue: 0,0:16:13.30,0:16:15.66,jp.sub-ja,,0,0,0,,Оның тұлғасы қазіргіден бірнеше есе бұрмаланған.
Dialogue: 0,0:16:16.58,0:16:21.25,Style1,,0,0,0,,Осылай ойлап қарасақ, бұл жекпе-жек жақсы жаққа бетбұрыс шығар.
Dialogue: 0,0:16:16.96,0:16:20.16,jp.sub-ja,,0,0,0,,Егер сіз осылай ойласаңыз, төбелесу жақсы нәрсе шығар.
Dialogue: 0,0:16:21.25,0:16:25.25,Style1,,0,0,0,,Бұл олардың әлемі біршама кеңейе бастағанын білдіреді, солай емес пе?
Dialogue: 0,0:16:21.44,0:16:24.36,jp.sub-ja,,0,0,0,,Дүние аздап кеңейіп жатыр деген сөз емес пе?
Dialogue: 0,0:16:25.25,0:16:28.35,Style1,,0,0,0,,Жағдайда оларды жалғыз қалдырған дұрыс шығар.
Dialogue: 0,0:16:25.48,0:16:27.44,jp.sub-ja,,0,0,0,,Осы кезде оны жалғыз қалдырған дұрыс.
Dialogue: 0,0:16:29.92,0:16:33.26,Style1,,0,0,0,,Мүмкін бұл жақсы жаққа бетбұрыс шығар.
Dialogue: 0,0:16:30.14,0:16:32.72,jp.sub-ja,,0,0,0,,Бұл жақсы үрдіс пе?
Dialogue: 0,0:16:33.26,0:16:36.26,Style1,,0,0,0,,Бірақ егер бұл олардың бірінші жекпе-жегі болса,
Dialogue: 0,0:16:33.68,0:16:36.06,jp.sub-ja,,0,0,0,,Бірақ егер бұл сіздің бірінші жекпе-жегіңіз болса
Dialogue: 0,0:16:36.26,0:16:38.60,Style1,,0,0,0,,сонда оларға біреу керек шығар
Dialogue: 0,0:16:36.40,0:16:40.72,jp.sub-ja,,0,0,0,,Сонымен қатар, менің ойымша, біреу сізге қашан жабу керектігін айтуы керек.
Dialogue: 0,0:16:38.60,0:16:41.60,Style1,,0,0,0,,оларға қашан қоңырау шалу керектігін айту одан да көп.
Dialogue: 0,0:16:41.60,0:16:46.30,Style1,,0,0,0,,Олар да бір-бірімен қалай татуласу керектігін білмейтін шығар.
Dialogue: 0,0:16:41.92,0:16:45.74,jp.sub-ja,,0,0,0,,Ол тіпті боянуды да білмейтін шығар.
Dialogue: 0,0:16:50.45,0:16:52.45,Style2,,0,0,0,,«№3 музыкалық бөлме» «Бүгін бизнес жоқ»
Dialogue: 0,0:16:52.45,0:16:55.47,Style2,,0,0,0,,"Бум! Соққы! Жарылыс!"
Dialogue: 0,0:17:07.56,0:17:10.90,Style1,,0,0,0,,Осынша уақыт жүргеннен кейін, әлі жеңе алмадыңыз ба?
Dialogue: 0,0:17:07.66,0:17:10.46,jp.sub-ja,,0,0,0,,Осының бәрін жасағаннан кейін әлі де көңіліңіз толмай ма?
Dialogue: 0,0:17:10.90,0:17:12.57,Style1,,0,0,0,,Бауырластар, бізді қуып жатырсыңдар.
Dialogue: 0,0:17:11.00,0:17:12.28,jp.sub-ja,,0,0,0,,Мазасыз аға
Dialogue: 0,0:17:12.57,0:17:14.90,Style1,,0,0,0,,Біз сені қуып жібереміз!? Біз сізді қуып жібереміз, айтасыз!?
Dialogue: 0,0:17:12.64,0:17:14.66,jp.sub-ja,,0,0,0,,Тітіркендіргіш Тітіркендіргіш
Dialogue: 0,0:17:14.90,0:17:17.91,Style1,,0,0,0,,Сіз қалжыңдап тұрған шығарсыз! Мен шығарылған адаммын!
Dialogue: 0,0:17:15.02,0:17:17.58,jp.sub-ja,,0,0,0,,Бұл қалжың емес, сені мазалап жүрген менмін.
Dialogue: 0,0:17:17.91,0:17:20.58,Style1,,0,0,0,,Мен Каорумен бірдей жүзді адаммын.
Dialogue: 0,0:17:18.02,0:17:19.92,jp.sub-ja,,0,0,0,,Ол дәл Каоруға ұқсайды.
Dialogue: 0,0:17:20.58,0:17:23.91,Style1,,0,0,0,,Мен сенімен жаңылысудан шаршадым! Шындық мынада,
Dialogue: 0,0:17:20.92,0:17:22.88,jp.sub-ja,,0,0,0,,Мен сені қателесуден шаршадым.
Dialogue: 0,0:17:23.20,0:17:25.56,jp.sub-ja,,0,0,0,,Шындық, мен сені жек көремін.
Dialogue: 0,0:17:23.91,0:17:26.92,Style1,,0,0,0,,Мен сенің ішкі істеріңді жек көремін!
Dialogue: 0,0:17:26.92,0:17:29.58,Style1,,0,0,0,,Сөзді аузымнан шығарып алдың. Мынаны қара!
Dialogue: 0,0:17:27.20,0:17:28.82,jp.sub-ja,,0,0,0,,Бұл менің жолым.
Dialogue: 0,0:17:29.18,0:17:33.46,jp.sub-ja,,0,0,0,,Қараңдаршы, бұл мен Некозава-сенпайдан сатып алған Бельзеневтің қарғыс атқан қуыршақ.
Dialogue: 0,0:17:29.58,0:17:31.59,Style1,,0,0,0,,Мен мұны Некозава-сенпайдан сатып алдым.
Dialogue: 0,0:17:31.59,0:17:33.22,Style1,,0,0,0,,Бельзенеф, қарғыс қуыршақ!
Dialogue: 0,0:17:33.62,0:17:34.52,Style2,,0,0,0,,«Қорыққан»
Dialogue: 0,0:17:34.26,0:17:39.26,Style1,,0,0,0,,Мен бұл заттың артына сенің атыңды жазып отырмын, Хикару.
Dialogue: 0,0:17:34.58,0:17:38.77,jp.sub-ja,,0,0,0,,Мына қуыршақтың артына жарықтың атын жазамын.
Dialogue: 0,0:17:39.26,0:17:44.49,Style1,,0,0,0,,Бұдан былай сіз көп бақытсыздық пен қайғыға тап боласыз!
Dialogue: 0,0:17:39.48,0:17:40.75,jp.sub-ja,,0,0,0,,Бұдан былай сіз
Dialogue: 0,0:17:41.06,0:17:44.09,jp.sub-ja,,0,0,0,,Қайғы мен қайғы көп болады.
Dialogue: 0,0:17:47.18,0:17:48.42,jp.sub-ja,,0,0,0,,Сабыр етіңіз.
Dialogue: 0,0:17:47.20,0:17:49.54,Style1,,0,0,0,,Жетеді!
Dialogue: 0,0:17:49.54,0:17:52.87,Style1,,0,0,0,,Қарапайым ұрыс-керіске мұндай нәрсені әкелуге бармайсың!
Dialogue: 0,0:17:49.78,0:17:52.72,jp.sub-ja,,0,0,0,,Мұндай нәрсені тек ұрыс-керіске әкелмеңіз.
Dialogue: 0,0:17:52.87,0:17:54.88,Style1,,0,0,0,,Бұл ұрысқа екеуің де кінәлісіңдер,
Dialogue: 0,0:17:53.22,0:17:54.84,jp.sub-ja,,0,0,0,,Бұл жекпе-жекке екеуміз де кінәліміз.
Dialogue: 0,0:17:54.88,0:17:58.14,Style1,,0,0,0,,бірақ онымен айналаңыздағылардың бәрін мазалайтыныңыз үшін сіз одан бетер кінәлісіз!
Dialogue: 0,0:17:55.20,0:17:57.60,jp.sub-ja,,0,0,0,,Айналадағыларға қиындық туғызу одан да жаман.
Dialogue: 0,0:17:59.21,0:18:02.55,Style1,,0,0,0,,Енді кешірім сұраңыз! Дәл қазір боянбасаңыз,
Dialogue: 0,0:17:59.48,0:18:00.76,jp.sub-ja,,0,0,0,,Дұрыс макияж жасаңыз
Dialogue: 0,0:18:01.10,0:18:02.54,jp.sub-ja,,0,0,0,,Біз қазір өтеуіміз керек
Dialogue: 0,0:18:02.55,0:18:05.88,Style1,,0,0,0,,онда мен тірі болғанша сені ешқашан жібермеймін!
Dialogue: 0,0:18:02.90,0:18:05.44,jp.sub-ja,,0,0,0,,Мен сенің өмірім үшін менің үйіме келуге рұқсат бермеймін.
Dialogue: 0,0:18:16.23,0:18:18.87,Style1,,0,0,0,,Олай болса, егер біз жарасатын болсақ, Харухи,
Dialogue: 0,0:18:16.56,0:18:18.04,jp.sub-ja,,0,0,0,,Жарайды, егер бітіссек.
Dialogue: 0,0:18:18.38,0:18:21.16,jp.sub-ja,,0,0,0,,Менің ойымша, Харухидің үйіне барған дұрыс.
Dialogue: 0,0:18:18.87,0:18:21.46,Style1,,0,0,0,,Сіздің үйіңізге келе аламыз ба?
Dialogue: 0,0:18:29.91,0:18:31.21,Style2,,0,0,0,,«Бос»
Dialogue: 0,0:18:37.25,0:18:40.59,Style1,,0,0,0,,Кешіріңіз, Каору. Мен тек сценарийімізді орындап жүрсем де,
Dialogue: 0,0:18:37.58,0:18:38.56,jp.sub-ja,,0,0,0,,Кешіріңіз Каору
Dialogue: 0,0:18:39.22,0:18:40.54,jp.sub-ja,,0,0,0,,Сценарий бойынша болса да
Dialogue: 0,0:18:40.59,0:18:45.59,Style1,,0,0,0,,Мен сенің ағаң болуға, саған мұндай сұмдықты айтуға жарамаймын.
Dialogue: 0,0:18:40.90,0:18:42.26,jp.sub-ja,,0,0,0,,Мұндай қорқынышты сөзді қалай айта алдың?
Dialogue: 0,0:18:43.18,0:18:44.46,jp.sub-ja,,0,0,0,,Үлкен аға, сіз дисквалификациясыз.
Dialogue: 0,0:18:45.59,0:18:48.93,Style1,,0,0,0,,Мүлде жоқ. Мен қатты уайымдадым
Dialogue: 0,0:18:45.78,0:18:46.40,jp.sub-ja,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:18:47.00,0:18:49.70,jp.sub-ja,,0,0,0,,Жарықтан зардап шеккен мен болсам ше?
Dialogue: 0,0:18:48.93,0:18:51.93,Style1,,0,0,0,,, егер мен сені ренжітсем, не істер едім, Хикару.
Dialogue: 0,0:18:50.06,0:18:51.80,jp.sub-ja,,0,0,0,,Мен қатты уайымдадым.
Dialogue: 0,0:18:51.93,0:18:54.27,Style1,,0,0,0,,Каору, мен сені ешқашан жібермеймін!
Dialogue: 0,0:18:52.14,0:18:54.32,jp.sub-ja,,0,0,0,,Каору мен сені енді жібермеймін
Dialogue: 0,0:18:54.27,0:18:55.74,Style1,,0,0,0,,Хикару!
Dialogue: 0,0:18:54.32,0:18:55.14,jp.sub-ja,,0,0,0,,Жарық~
Dialogue: 0,0:19:05.61,0:19:08.62,Style1,,0,0,0,,О, сен ұрысты қолдан жасадың!?
Dialogue: 0,0:19:05.78,0:19:08.66,jp.sub-ja,,0,0,0,,Не, бұл жалған ұрыс болды ма?
Dialogue: 0,0:19:08.62,0:19:11.95,Style1,,0,0,0,,Жарайсыңдар, жалыққанбыз.
Dialogue: 0,0:19:09.02,0:19:11.62,jp.sub-ja,,0,0,0,,Бұл қызықсыз болғандықтан.
Dialogue: 0,0:19:11.95,0:19:14.75,Style1,,0,0,0,,Т- олар мені алды...
Dialogue: 0,0:19:12.24,0:19:14.14,jp.sub-ja,,0,0,0,,орындалды
Dialogue: 0,0:19:16.12,0:19:18.54,jp.sub-ja,,0,0,0,,H Жалықтырған егіздер
Dialogue: 0,0:19:16.96,0:19:19.55,Style1,,0,0,0,,Бос уақыты тым көп егіздер...
Dialogue: 0,0:19:21.63,0:19:23.65,Style1,,0,0,0,,...шайтан.
Dialogue: 0,0:19:21.96,0:19:23.20,jp.sub-ja,,0,0,0,,Бұл шайтан.
Dialogue: 0,0:19:24.87,0:19:27.63,Style2,,0,0,0,,"№3 музыкалық бөлме" "Хост клубы енді бизнес үшін ашық"
Dialogue: 0,0:19:25.97,0:19:27.97,Style1,,0,0,0,,Біздің руға шабуыл жасаған Маскалылар Эбису-саманың…
Dialogue: 0,0:19:26.18,0:19:27.78,jp.sub-ja,,0,0,0,,Мен қуаныштымын
Dialogue: 0,0:19:27.97,0:19:32.31,Style1,,0,0,0,,Жарайды, «Қайсысы Хикару-кун» ойынын ойнайық!
Dialogue: 0,0:19:29.32,0:19:32.06,jp.sub-ja,,0,0,0,,Хикари-кун қайсысы? Ойын
Dialogue: 0,0:19:32.31,0:19:35.64,Style1,,0,0,0,,Ум, қызғылт шашты Хикару-кун.
Dialogue: 0,0:19:32.74,0:19:35.50,jp.sub-ja,,0,0,0,,Ал, қызғылт шаш Хикару-кун.
Dialogue: 0,0:19:35.60,0:19:37.28,jp.sub-ja,,0,0,0,,Джекпот
Dialogue: 0,0:19:35.64,0:19:37.31,Style1,,0,0,0,,Бізде жеңімпаз бар!
Dialogue: 0,0:19:37.31,0:19:41.32,Style1,,0,0,0,,Сіз жарасып кеткен шығарсыз, бірақ шашыңыз біраз уақытқа дейін солай қалады, иә?
Dialogue: 0,0:19:37.72,0:19:41.16,jp.sub-ja,,0,0,0,,Боянсаңыз да, шашыңыздың түсі біраз уақытқа дейін өзгеріссіз қалады.
Dialogue: 0,0:19:41.32,0:19:43.92,Style1,,0,0,0,,Сонда да қазір айту оңайырақ болғанына қуаныштымын.
Dialogue: 0,0:19:41.60,0:19:43.78,jp.sub-ja,,0,0,0,,Бірақ оны түсіну оңайырақ болғанына қуаныштымын.
Dialogue: 0,0:19:43.92,0:19:45.51,Style1,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:19:44.06,0:19:44.74,jp.sub-ja,,0,0,0,,Жоқ.
Dialogue: 0,0:19:48.26,0:19:51.93,Style1,,0,0,0,,Бүгін қызғылт - Каору, көк - Хикару.
Dialogue: 0,0:19:48.66,0:19:51.46,jp.sub-ja,,0,0,0,,Бүгінгі таңда қызғылт - әйелдік, көк - ашық.
Dialogue: 0,0:19:51.93,0:19:54.69,Style1,,0,0,0,,Түстеріңізді ауыстырдыңыз, иә?
Dialogue: 0,0:19:52.32,0:19:53.86,jp.sub-ja,,0,0,0,,Түсті өзгерттіңіз, солай ма?
Dialogue: 0,0:20:25.63,0:20:29.30,Style1,,0,0,0,,Байқадың ба, Хикару? Осы уақытқа дейін,
Dialogue: 0,0:20:25.72,0:20:26.98,jp.sub-ja,,0,0,0,,Сіз жарық туралы білесіз бе?
Dialogue: 0,0:20:27.96,0:20:29.00,jp.sub-ja,,0,0,0,,Әлем болды
Dialogue: 0,0:20:29.30,0:20:33.30,Style1,,0,0,0,,екі ғана әлем болды: «біз» және «басқалардың бәрі».
Dialogue: 0,0:20:29.68,0:20:32.16,jp.sub-ja,,0,0,0,,Тек екі нәрсе болды, біз және басқалар.
Dialogue: 0,0:20:33.30,0:20:36.76,Style1,,0,0,0,,Бірақ алғаш рет шынайы шлюз пайда болды.
Dialogue: 0,0:20:33.54,0:20:35.96,jp.sub-ja,,0,0,0,,Алғаш рет нағыз қаскүнем пайда болды.
Dialogue: 0,0:20:39.18,0:20:41.44,jp.sub-ja,,0,0,0,,Қуан, Харухи, сенде кіші болады.
Dialogue: 0,0:20:39.18,0:20:41.51,Style1,,0,0,0,,Қуан, Харухи! Сен енді біреуден үлкен боласың.
Dialogue: 0,0:20:41.51,0:20:42.85,Style1,,0,0,0,,Клубқа жаңа біреу қосылғысы келеді.
Dialogue: 0,0:20:41.68,0:20:42.96,jp.sub-ja,,0,0,0,,Мен жаңа үміткермін.
Dialogue: 0,0:20:42.85,0:20:44.85,Style1,,0,0,0,,Бірақ ол әлі бастауыш мектепте оқиды.
Dialogue: 0,0:20:43.08,0:20:44.92,jp.sub-ja,,0,0,0,,Бірақ ол бала әлі бастауыш сыныпта оқиды.
Dialogue: 0,0:20:44.85,0:20:46.52,Style1,,0,0,0,,Мен ол баланың өскенде қандай болатынын елестетуден қорқамын.
Dialogue: 0,0:20:44.92,0:20:46.32,jp.sub-ja,,0,0,0,,Қандай сұмдық бала.
Dialogue: 0,0:20:46.52,0:20:48.85,Style1,,0,0,0,,Келесі жолы, «Сынып жетекшісі – тентек тип»
Dialogue: 0,0:20:48.85,0:20:53.19,Style1,,0,0,0,,Сізді келесі аптада Оуран орта мектебінің хост клубы күтеді!
Dialogue: 0,0:20:48.96,0:20:51.00,jp.sub-ja,,0,0,0,,Оуран орта мектебінің жүргізуші клубы Келесі аптада да
Dialogue: 0,0:20:51.52,0:20:52.80,jp.sub-ja,,0,0,0,,Біз сізді асыға күтеміз.
Dialogue: 0,0:20:54.69,0:21:00.69,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
