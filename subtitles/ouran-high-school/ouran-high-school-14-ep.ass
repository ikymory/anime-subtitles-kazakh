Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,ED
Dialogue: 0,0:00:15.02,0:00:18.02,Default,,0,0,0,,HARERE
Dialogue: 0,0:00:21.00,0:00:24.00,Default,,0,0,0,,Syura
Dialogue: 0,0:00:24.04,0:00:27.06,Default,,0,0,0,,Косоде аудармасы
Dialogue: 0,0:00:28.00,0:00:30.08,Default,,0,0,0,,Mam
Dialogue: 0,0:00:32.09,0:00:36.02,Default,,0,0,0,,Уақыт картасы Наксияның әкімшілік жүйесі
Dialogue: 0,0:00:37.09,0:00:41.06,Default,,0,0,0,,Сюра
Dialogue: 0,0:01:13.01,0:01:17.00,Default,,0,0,0,,Құдайдың субтитр жұбы
Dialogue: 0,0:01:22.05,0:01:26.05,Default,,0,0,0,,Менеджер, жазылушылар саны бір таңбалы санға жетті.
Dialogue: 0,0:01:27.04,0:01:29.08,Default,,0,0,0,,Нақты сандарды хабарлау
Dialogue: 0,0:01:30.01,0:01:32.08,Default,,0,0,0,,Осы аптадағы газет қаншаға сатылды?
Dialogue: 0,0:01:33.03,0:01:34.02,Default,,0,0,0,,2-бөлім
Dialogue: 0,0:01:35.02,0:01:36.02,Default,,0,0,0,,Тек?
Dialogue: 0,0:01:36.04,0:01:37.03,Default,,0,0,0,,2 бөлім
Dialogue: 0,0:01:37.08,0:01:40.08,Default,,0,0,0,,Укио-кун, сатып алдың ба?
Dialogue: 0,0:01:41.01,0:01:42.01,Default,,0,0,0,,Сатып алынды
Dialogue: 0,0:01:43.03,0:01:46.04,Default,,0,0,0,,Сакё-кун, сатып алдың ба?
Dialogue: 0,0:01:46.09,0:01:47.09,Default,,0,0,0,,Сатып алынды
Dialogue: 0,0:01:49.00,0:01:52.09,Default,,0,0,0,,Сондықтан оны клуб мүшелерінен басқа ешкім сатып алмайды.
Dialogue: 0,0:01:54.01,0:01:57.04,Default,,0,0,0,,Дәл есеп берсең солай болады.
Dialogue: 0,0:01:58.08,0:02:00.05,Default,,0,0,0,,Қазіргі уақытта демалыс сайынғы кісі өлтірулерді тоқтатқанымыз жөн
Dialogue: 0,0:02:00.09,0:02:03.09,Default,,0,0,0,,Келесі аптадағы нөмір семестрдің соңғы газеті болмақ.
Dialogue: 0,0:02:04.01,0:02:06.09,Default,,0,0,0,,Жазғы демалысқа дейін жақсы нәтиже алуым керек.
Dialogue: 0,0:02:07.01,0:02:09.09,Default,,0,0,0,,Үйірме тек осы семестрде тоқтатылады.
Dialogue: 0,0:02:10.03,0:02:12.07,Default,,0,0,0,,Айтпақшы, бұл туралы ше?
Dialogue: 0,0:02:13.00,0:02:15.04,Default,,0,0,0,,Айтпақшы, қабылдаушы клубтың фото жинағы
Dialogue: 0,0:02:15.06,0:02:17.01,Default,,0,0,0,,«Сукисуки Тамаки-кун Арнайы» болып табылады
Dialogue: 0,0:02:17.02,0:02:19.09,Default,,0,0,0,,1000 дана шығарылғаннан кейін сатылды.
Dialogue: 0,0:02:20.02,0:02:23.01,Default,,0,0,0,,Доужинши Ренге Хошакуджи жеке басып шығарған
Dialogue: 0,0:02:23.03,0:02:25.02,Default,,0,0,0,,«Мо Мое Оуран күнделігі» №8, сондай-ақ
Dialogue: 0,0:02:25.04,0:02:27.07,Default,,0,0,0,,Кеше шыққан бойда сатылып кетті.
Dialogue: 0,0:02:27.09,0:02:30.00,Default,,0,0,0,,Қайта басып шығарылған
Dialogue: 0,0:02:31.04,0:02:32.08,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:02:35.02,0:02:38.01,Default,,0,0,0,,Олардың импульсі әлі де бар ма?
Dialogue: 0,0:02:46.04,0:02:48.01,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:02:56.08,0:02:58.06,Default,,0,0,0,,Мен бара алмаймын, Тамаки-сама.
Dialogue: 0,0:02:58.08,0:03:00.03,Default,,0,0,0,,Егер жақынырақ келсең
Dialogue: 0,0:03:00.05,0:03:04.00,Default,,0,0,0,,Сізді жақсы көретін көптеген әйелдер сізді жек көреді.
Dialogue: 0,0:03:05.01,0:03:05.51,Default,,0,0,0,,О, «екі ел арасындағы неке жақын арада болады» дедің бе?
Dialogue: 0,0:03:06.02,0:03:10.06,Default,,0,0,0,,Енді бұл гортензия бізді жасырады.
Dialogue: 0,0:03:11.00,0:03:13.05,Default,,0,0,0,,Осы бір сәтке сен менің жалғыз қызметшімсің.
Dialogue: 0,0:03:13.09,0:03:17.09,Default,,0,0,0,,Иә, гортензияның рухы көргенде ғана
Dialogue: 0,0:03:18.01,0:03:20.09,Default,,0,0,0,,Құрметті Тамаки-сама, мен саған қатты ғашықпын.
Dialogue: 0,0:03:21.02,0:03:22.00,Default,,0,0,0,,О, «екі ел арасындағы неке жақын арада болады» дедің бе?
Dialogue: 0,0:03:28.06,0:03:30.06,Default,,0,0,0,,Гомен Асобаза
Dialogue: 0,0:03:30.09,0:03:32.03,Default,,0,0,0,,Мен үшін тағы бір жеңіліс
Dialogue: 0,0:03:33.09,0:03:36.00,Default,,0,0,0,,Ханшайымдар, жұмсақ болыңдар.
Dialogue: 0,0:03:36.01,0:03:38.01,Default,,0,0,0,,Өйткені Каорудың жігіті жылауық
Dialogue: 0,0:03:38.03,0:03:41.05,Default,,0,0,0,,Жарық, өтірікші, кім жылайды?
Dialogue: 0,0:03:42.07,0:03:44.02,Default,,0,0,0,,немесе сол сияқты нәрсе
Dialogue: 0,0:03:44.04,0:03:46.09,Default,,0,0,0,,Менімен жалғыз жазалау ойынын ойнасаң
Dialogue: 0,0:03:47.00,0:03:49.01,Default,,0,0,0,,Мен Каору не болады деп ойлаймын.
Dialogue: 0,0:03:49.03,0:03:51.03,Default,,0,0,0,,Өйткені бұл жарық.
Dialogue: 0,0:03:52.01,0:03:54.06,Default,,0,0,0,,Не болды, не болды?
Dialogue: 0,0:03:55.06,0:03:58.09,Default,,0,0,0,,Мен білмей тұрып, аулада сондай сүйкімді бұлақ болатын.
Dialogue: 0,0:03:59.00,0:04:01.00,Default,,0,0,0,,Жарымизу деп аталады.
Dialogue: 0,0:04:01.02,0:04:02.07,Default,,0,0,0,,Хэйан халқы болды
Dialogue: 0,0:04:02.08,0:04:07.05,Default,,0,0,0,,Су бетінде қалқып жүрген гүл жапырақтары мен күзгі жапырақтардан жылдың төрт мезгілін білуге болады дейді.
Dialogue: 0,0:04:07.08,0:04:12.08,Default,,0,0,0,,Мен мұны төрт мезгілді ханшайымдармен бөлісейін деген ниетпен жасадым.
Dialogue: 0,0:04:13.02,0:04:15.00,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:04:15.01,0:04:18.06,Default,,0,0,0,,Күзде бізде де адамдар саны шектеулі күзгі жапырақтарды көру үшін шай ішеміз.
Dialogue: 0,0:04:18.07,0:04:20.05,Default,,0,0,0,,Брондау
Dialogue: 0,0:04:21.03,0:04:24.06,Default,,0,0,0,,Хаориде екі адам соба жейді.
Dialogue: 0,0:04:29.01,0:04:31.01,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:04:32.00,0:04:33.09,Default,,0,0,0,,Бұл тыныш.
Dialogue: 0,0:04:34.00,0:04:36.01,Default,,0,0,0,,Мен үйреніп қалған шығармын.
Dialogue: 0,0:04:36.03,0:04:39.01,Default,,0,0,0,,Мектеп табалдырығын аттағалы бері солай болды.
Dialogue: 0,0:04:39.03,0:04:41.02,Default,,0,0,0,,Харухи, жат.
Dialogue: 0,0:04:48.09,0:04:52.08,Default,,0,0,0,,Жарық Харухидің өмір жарығы сөніп қала жаздады.
Dialogue: 0,0:04:53.00,0:04:54.09,Default,,0,0,0,,Бейбіт емес пе?
Dialogue: 0,0:04:55.09,0:04:58.07,Default,,0,0,0,,Оны дұрыс қабылдамағаныңыз үшін сіз кінәлісіз.
Dialogue: 0,0:04:58.09,0:05:00.07,Default,,0,0,0,,Тіпті Темари де мені қанағаттандыра алмайды.
Dialogue: 0,0:05:00.09,0:05:03.00,Default,,0,0,0,,Хикару Генджидің Оурандағы аты жоқ.
Dialogue: 0,0:05:03.02,0:05:03.52,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:05:04.01,0:05:06.02,Default,,0,0,0,,Газет бөлімінің жалғасы үшін
Dialogue: 0,0:05:06.03,0:05:09.02,Default,,0,0,0,,Бұл жерде оларға тағзым етуден басқа амалымыз жоқ сияқты.
Dialogue: 0,0:05:10.00,0:05:11.02,Default,,0,0,0,,Күте тұрыңыз, менеджер.
Dialogue: 0,0:05:11.03,0:05:13.06,Default,,0,0,0,,Бұл бөлікті соғу өте қауіпті.
Dialogue: 0,0:05:13.07,0:05:16.08,Default,,0,0,0,,Кейбір жағдайларда клубты жоюдың орнына мектептен шығарылу қаупі бар.
Dialogue: 0,0:05:17.00,0:05:20.02,Default,,0,0,0,,Егер солай болса, оны қабылдаңыз.
Dialogue: 0,0:05:20.04,0:05:22.04,Default,,0,0,0,,Жұлдызды соққы
Dialogue: 0,0:05:23.03,0:05:24.04,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:05:25.02,0:05:26.00,Default,,0,0,0,,Ол тез.
Dialogue: 0,0:05:26.03,0:05:29.00,Default,,0,0,0,,Сіз шеберсіз.
Dialogue: 0,0:05:31.01,0:05:33.01,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:05:33.03,0:05:35.01,Default,,0,0,0,,Олармен қалай аралассаңыз да
Dialogue: 0,0:05:35.03,0:05:37.04,Default,,0,0,0,,Мен оның кесірінен зардап шегетін адаммын...
Dialogue: 0,0:05:38.03,0:05:39.05,Default,,0,0,0,,Менеджер
Dialogue: 0,0:05:40.03,0:05:42.07,Default,,0,0,0,,Біз өте өкінеміз.
Dialogue: 0,0:05:42.09,0:05:44.04,Default,,0,0,0,,Жоқ, жоқ, солай.
Dialogue: 0,0:05:44.06,0:05:48.08,Default,,0,0,0,,Тек терезенің әйнегі сынып, доп оның басына тиді.
Dialogue: 0,0:05:49.00,0:05:50.04,Default,,0,0,0,,Қандай кездейсоқ кездесу, Хиёри
Dialogue: 0,0:05:50.07,0:05:52.04,Default,,0,0,0,,Бірақ бұл дұрыс болды
Dialogue: 0,0:05:52.06,0:05:53.09,Default,,0,0,0,,Шындығында, қабылдаушы клубқа хабарласыңыз.
Dialogue: 0,0:05:54.01,0:05:57.08,Default,,0,0,0,,Маған сұхбат беруге көмектесе аласыз ба деп ойладым.
Dialogue: 0,0:05:58.02,0:06:00.05,Default,,0,0,0,,Газет үйірмесі болды ма?
Dialogue: 0,0:06:00.07,0:06:02.02,Default,,0,0,0,,Бірақ бұл.
Dialogue: 0,0:06:02.03,0:06:03.09,Default,,0,0,0,,Сакура спорты ретінде белгілі
Dialogue: 0,0:06:04.00,0:06:05.06,Default,,0,0,0,,Бұл мектептегі романтикалық жағдай ма?
Dialogue: 0,0:06:05.07,0:06:08.09,Default,,0,0,0,,Жанұялар арасындағы билік үшін күреске байланысты сынып ішілік бөліну
Dialogue: 0,0:06:09.01,0:06:13.00,Default,,0,0,0,,Бұл тым дүрліктірген жанжалдарға маманданған өсек журналы.
Dialogue: 0,0:06:13.04,0:06:16.09,Default,,0,0,0,,Оны енді ешкім оқымайды, себебі бұл жай ғана ойдан шығарылған.
Dialogue: 0,0:06:17.03,0:06:22.03,Default,,0,0,0,,Шынында да, назар аударуды қалауымызбен біз шындықты ұмытып кеттік.
Dialogue: 0,0:06:22.08,0:06:25.08,Default,,0,0,0,,Алайда клуб жабылу шегіне жетті.
Dialogue: 0,0:06:26.00,0:06:27.08,Default,,0,0,0,,Мен ақыры ояндым.
Dialogue: 0,0:06:29.03,0:06:33.02,Default,,0,0,0,,Біз нені қамту және хабарлау керектігін түсіндік.
Dialogue: 0,0:06:34.08,0:06:36.03,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:06:36.06,0:06:38.07,Default,,0,0,0,,Семестрдің соңғы газетін жіберіп алмаңыз.
Dialogue: 0,0:06:38.09,0:06:40.07,Default,,0,0,0,,Қабылдаушы бөлімде арнайы шығарылымды жабу
Dialogue: 0,0:06:40.09,0:06:44.00,Default,,0,0,0,,Біз сенің сүйкімділігіңнің түбіне жеткіміз келеді.
Dialogue: 0,0:06:44.05,0:06:47.04,Default,,0,0,0,,Бізге күш-қуатыңызды беріңіз.
Dialogue: 0,0:06:48.04,0:06:49.07,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:06:50.00,0:06:52.01,Default,,0,0,0,,Мен бұл оқиғаны қабылдаймын.
Dialogue: 0,0:06:52.03,0:06:53.03,Default,,0,0,0,,Өлемін деп ойлайтын ешқандай жағдайға тап болған емеспін
Dialogue: 0,0:06:53.05,0:06:56.02,Default,,0,0,0,,Кёуя Ол менің кесірімнен зардап шекті.
Dialogue: 0,0:06:56.03,0:06:57.04,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:06:57.06,0:07:01.04,Default,,0,0,0,,Біздің ақпаратты ашу тек тұтынушыларға ғана арналған.
Dialogue: 0,0:07:01.05,0:07:05.00,Default,,0,0,0,,Біз жарақатты емдеу құнын тағы да талқылаймыз.
Dialogue: 0,0:07:05.03,0:07:09.07,Default,,0,0,0,,Дұрыс, мен көп сандырақ жаздым, көмектесіңізші.
Dialogue: 0,0:07:09.09,0:07:12.00,Default,,0,0,0,,Менің ойымша, біз үшін ешқандай артықшылық жоқ.
Dialogue: 0,0:07:12.06,0:07:15.05,Default,,0,0,0,,Дәлірек айтсақ, өзгеге қиындық тудыратын өзіміз.
Dialogue: 0,0:07:15.07,0:07:17.00,Default,,0,0,0,,Бұл жақсы емес, солай ма?
Dialogue: 0,0:07:17.06,0:07:20.00,Default,,0,0,0,,Өзіңді ойламау қорқынышты.
Dialogue: 0,0:07:20.04,0:07:22.00,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:07:23.01,0:07:26.00,Default,,0,0,0,,Өйткені, өткен күнәларды өшіру мүмкін емес.
Dialogue: 0,0:07:26.03,0:07:30.02,Default,,0,0,0,,Сізге оның орнын толтыруға мүмкіндік берілмейді.
Dialogue: 0,0:07:31.08,0:07:33.03,Default,,0,0,0,,Бас ауруы
Dialogue: 0,0:07:33.05,0:07:34.03,Default,,0,0,0,,Менеджер
Dialogue: 0,0:07:34.08,0:07:37.02,Default,,0,0,0,,Рахмет, Укио-кун, Сакё-кун
Dialogue: 0,0:07:38.02,0:07:39.02,Default,,0,0,0,,Менің әлі басы айналып жүр
Dialogue: 0,0:07:39.04,0:07:40.02,Default,,0,0,0,,Менеджер
Dialogue: 0,0:07:40.04,0:07:41.04,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:42.06,0:07:44.03,Default,,0,0,0,,Менеджер
Dialogue: 0,0:07:44.06,0:07:47.04,Default,,0,0,0,,Кешіріңіз, бірақ менде клубты әдемі түрде жоюдан басқа амалым жоқ.
Dialogue: 0,0:07:47.06,0:07:48.08,Default,,0,0,0,,That's not true.
Dialogue: 0,0:07:49.07,0:07:51.03,Default,,0,0,0,,Адамдар әрқашан әрекетті қайталай алады
Dialogue: 0,0:07:51.05,0:07:54.05,Default,,0,0,0,,Бұл жақсы. Қабылдаушы бөлімнің барлық күші жұмылдырылады.
Dialogue: 0,0:07:54.08,0:07:57.07,Default,,0,0,0,,Газет бөлімін қайта құрумен толық ынтымақтасамыз.
Dialogue: 0,0:07:57.08,0:07:58.07,Default,,0,0,0,,Бұл біз емес.
Dialogue: 0,0:07:59.06,0:08:03.05,Default,,0,0,0,,Мен сенің жақсы мінезіңмен бірге жүре берсем, оның шегі жоқ.
Dialogue: 0,0:08:03.07,0:08:05.00,Default,,0,0,0,,Әйтеуір, әбігер.
Dialogue: 0,0:08:05.02,0:08:06.07,Default,,0,0,0,,Мен үйге бара жатырмын, Тамаки.
Dialogue: 0,0:08:07.02,0:08:09.00,Default,,0,0,0,,Бүгінгі шолу жиналысын клуб бөлмесінде өткізіңіз
Dialogue: 0,0:08:09.01,0:08:10.04,Default,,0,0,0,,Негізінен сіздің
Dialogue: 0,0:08:10.07,0:08:11.06,Default,,0,0,0,,Күтіңіз
Dialogue: 0,0:08:13.05,0:08:15.09,Default,,0,0,0,,Қансыз, көз жассыз ба?
Dialogue: 0,0:08:16.02,0:08:18.01,Default,,0,0,0,,Оларды таратуға мәжбүрлеуді көру
Dialogue: 0,0:08:18.02,0:08:20.03,Default,,0,0,0,,Мені аямайсың ба?
Dialogue: 0,0:08:21.04,0:08:22.08,Default,,0,0,0,,Отбасы бөлек.
Dialogue: 0,0:08:25.03,0:08:27.01,Default,,0,0,0,,Бұл директордың бұйрығы.
Dialogue: 0,0:08:27.03,0:08:29.01,Default,,0,0,0,,Бас тартуға болмайды
Dialogue: 0,0:08:31.05,0:08:32.08,Default,,0,0,0,,Өлемін деп ойлайтын ешқандай жағдайға тап болған емеспін
Dialogue: 0,0:08:45.09,0:08:47.06,Default,,0,0,0,,Оның ашулы екені анық.
Dialogue: 0,0:08:48.02,0:08:49.08,Default,,0,0,0,,Киіміңді де ауыстырма
Dialogue: 0,0:08:50.01,0:08:52.08,Default,,0,0,0,,Олар өте жақын болғанымен, көз тиюге батылы бармайды.
Dialogue: 0,0:08:53.00,0:08:54.01,Default,,0,0,0,,Бұл балалардың төбелесі.
Dialogue: 0,0:08:54.04,0:08:57.03,Default,,0,0,0,,Өйткені Тамаки-чан жалғыз адам.
Dialogue: 0,0:08:58.03,0:09:00.01,Default,,0,0,0,,Үйірме жұмыстары бір отбасы сияқты болса да
Dialogue: 0,0:09:00.06,0:09:02.07,Default,,0,0,0,,Сондықтан тастанды отбасылар бөлініп кетеді.
Dialogue: 0,0:09:03.01,0:09:04.04,Default,,0,0,0,,Мен сені аяймын
Dialogue: 0,0:09:06.04,0:09:10.04,Default,,0,0,0,,Газет клубымен ынтымақтасу соншалықты жаман ба?
Dialogue: 0,0:09:11.01,0:09:12.07,Default,,0,0,0,,Оның Тоно жағында болғаны сирек.
Dialogue: 0,0:09:12.09,0:09:14.07,Default,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:09:14.09,0:09:18.03,Default,,0,0,0,,Көп ұзамай ол маған кішкентай иттей қарай бастады.
Dialogue: 0,0:09:18.05,0:09:22.02,Default,,0,0,0,,Ақыр аяғында бас июден басқа амал қалмайды деген біртүрлі сенімім бар.
Dialogue: 0,0:09:22.04,0:09:25.00,Default,,0,0,0,,Сіз міндетті түрде тәжірибе ұпайларын жинайсыз.
Dialogue: 0,0:09:25.09,0:09:29.05,Default,,0,0,0,,Сонымен қатар, шамдар мен әдетте кіретін нәрсе емес.
Dialogue: 0,0:09:29.06,0:09:32.06,Default,,0,0,0,,Бұл жолы жай ғана әбігер.
Dialogue: 0,0:09:34.01,0:09:35.08,Default,,0,0,0,,Бал қарттар
Dialogue: 0,0:09:36.00,0:09:40.00,Default,,0,0,0,,Білесің бе, мен торт жеуім керек.
Dialogue: 0,0:09:48.06,0:09:49.07,Default,,0,0,0,,Бұл көздер.
Dialogue: 0,0:09:53.09,0:09:55.01,Default,,0,0,0,,Бұл иттің көзі.
Dialogue: 0,0:10:02.07,0:10:04.00,Default,,0,0,0,,Мен оған шарт қоямын.
Dialogue: 0,0:10:05.02,0:10:08.06,Default,,0,0,0,,Көркем мақаланың жоспары осы жерде көрсетілгендей болуы керек.
Dialogue: 0,0:10:08.08,0:10:10.06,Default,,0,0,0,,Сұхбат беруге негізінен тыйым салынады.
Dialogue: 0,0:10:10.06,0:10:13.07,Default,,0,0,0,,Тұтынушыларға қызмет көрсету көріністері де шығарылды, себебі олар тұтынушыларға кедергі келтіреді.
Dialogue: 0,0:10:15.05,0:10:16.06,Default,,0,0,0,,Барлығы да жақсы.
Dialogue: 0,0:10:16.08,0:10:19.00,Default,,0,0,0,,Жарайды, егер Кёуя-сенпай айтса.
Dialogue: 0,0:10:19.01,0:10:19.51,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:10:20.07,0:10:23.00,Default,,0,0,0,,Кагами-чан солай айтса, жақсы.
Dialogue: 0,0:10:24.01,0:10:26.02,Default,,0,0,0,,Көлеңкелер патшасы күткендей
Dialogue: 0,0:10:28.02,0:10:29.05,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:10:29.06,0:10:32.04,Default,,0,0,0,,Сізден сұхбат алуға рұқсат етсеңіз, мен шарттарды орындаймын.
Dialogue: 0,0:10:32.09,0:10:35.07,Default,,0,0,0,,Сонымен сұхбат ертең басталады.
Dialogue: 0,0:10:36.07,0:10:38.09,Default,,0,0,0,,Маңдайдағы жара қалай?
Dialogue: 0,0:10:39.03,0:10:42.04,Default,,0,0,0,,Ей, бұл жерде ештеңе жоқ.
Dialogue: 0,0:10:42.08,0:10:46.09,Default,,0,0,0,,Шындығында, мен осы жарақаттың арқасында байланыс орнатқаным үшін ризашылығымды білдіргім келеді.
Dialogue: 0,0:10:47.04,0:10:49.05,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:10:51.03,0:10:54.07,Default,,0,0,0,,Бұл дәріні кешірім сұрау ретінде қолданыңыз.
Dialogue: 0,0:10:55.08,0:10:58.09,Default,,0,0,0,,Бұл біздің компания жасаған жедел медициналық көмек жинағы.
Dialogue: 0,0:10:59.05,0:11:00.09,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:11:01.05,0:11:02.09,Default,,0,0,0,,Енді кешіріңіз.
Dialogue: 0,0:11:05.02,0:11:06.00,Default,,0,0,0,,Отори мырза
Dialogue: 0,0:11:06.09,0:11:11.01,Default,,0,0,0,,Сіз медициналық құрылғыларды өндіруші Otori Group компаниясының ұлы болдыңыз.
Dialogue: 0,0:11:12.01,0:11:14.04,Default,,0,0,0,,Менің негізгі жұмысым – аурухананы басқару.
Dialogue: 0,0:11:15.01,0:11:17.07,Default,,0,0,0,,Танысқаныма қуаныштымын.
Dialogue: 0,0:11:18.05,0:11:22.09,Default,,0,0,0,,Менің әкем Комацузава баспасының президенті.
Dialogue: 0,0:11:23.03,0:11:25.08,Default,,0,0,0,,Иә, мен білемін.
Dialogue: 0,0:11:26.02,0:11:31.00,Default,,0,0,0,,Сіз өзіңіздің болашақ мұрагеріңізге дайындалу үшін газет бөлімінің меңгерушісі қызметін атқарасыз ба?
Dialogue: 0,0:11:32.00,0:11:35.00,Default,,0,0,0,,Бірақ менің інім бар.
Dialogue: 0,0:11:35.03,0:11:37.09,Default,,0,0,0,,Бұл өте жақсы нәрсе.
Dialogue: 0,0:11:38.03,0:11:43.03,Default,,0,0,0,,Менің әкем болашақта баспаның барлық басшылығын інісіне тапсыруды жоспарлап отыр.
Dialogue: 0,0:11:43.08,0:11:48.01,Default,,0,0,0,,Менен басқа ағам.
Dialogue: 0,0:11:49.06,0:11:55.03,Default,,0,0,0,,Алайда мен Оуран Гакуиндегі газет клубының жетекшісі болып үш жыл қызмет ететін болсам,
Dialogue: 0,0:11:55.06,0:11:59.05,Default,,0,0,0,,Бұл болашақ мұрагер кандидаттарды қайта қарауға мәжбүр етуі мүмкін.
Dialogue: 0,0:12:00.04,0:12:01.05,Default,,0,0,0,,Қаржы бөлімінен әкетілген адам
Dialogue: 0,0:12:02.02,0:12:05.03,Default,,0,0,0,,Бұл клубты ешқашан жоюға болмайды.
Dialogue: 0,0:12:05.07,0:12:07.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:11.06,0:12:15.00,Default,,0,0,0,,Менеджер Отори Кёямен араласуға тырысты ма?
Dialogue: 0,0:12:15.02,0:12:18.07,Default,,0,0,0,,Иә, менің жалғыз жауым – Тамаки Суо.
Dialogue: 0,0:12:19.01,0:12:21.05,Default,,0,0,0,,Бастапқыда мектеп газетінің құдіретімен
Dialogue: 0,0:12:21.09,0:12:25.04,Default,,0,0,0,,Мен бұл мектепте танымал болуым керек еді.
Dialogue: 0,0:12:25.09,0:12:31.01,Default,,0,0,0,,Тамаки Сух кенеттен бастаған хост клубы әп-сәтте танымал болды.
Dialogue: 0,0:12:32.03,0:12:34.03,Default,,0,0,0,,Суо мектепке кірер алдында
Dialogue: 0,0:12:34.07,0:12:38.04,Default,,0,0,0,,Менеджер шығаратын газет көпшілікке ұнамайды деп естідім.
Dialogue: 0,0:12:38.07,0:12:39.08,Default,,0,0,0,,Аузыңды жап
Dialogue: 0,0:12:40.05,0:12:42.00,Default,,0,0,0,,Анамнан сұрасам
Dialogue: 0,0:12:42.03,0:12:46.07,Default,,0,0,0,,Біз баспагер мен сіздің үйіңіз арасындағы барлық транзакцияларды жоя аламыз.
Dialogue: 0,0:12:47.01,0:12:49.01,Default,,0,0,0,,Мен сені міндетті түрде құйрығыңнан ұстаймын.
Dialogue: 0,0:12:49.02,0:12:53.02,Default,,0,0,0,,Ол спорт клубына да, мәдениет үйірмесіне де жатпайтын, тіпті кеңесшісі жоқ ерекше жағдай.
Dialogue: 0,0:12:53.09,0:12:55.08,Default,,0,0,0,,Махаббат алаяқтығына ұқсайтын сыныптан тыс жұмыс
Dialogue: 0,0:12:56.01,0:13:00.08,Default,,0,0,0,,Мұндай ерсі қылықтар Су патшаның күш көрсетуінен басқа ештеңе емес.
Dialogue: 0,0:13:01.01,0:13:03.03,Default,,0,0,0,,Ол достарын өзіне бағындыру үшін ата-анасының беделін пайдаланса керек.
Dialogue: 0,0:13:03.06,0:13:05.05,Default,,0,0,0,,Қыздарды қалай ұнатса, сонша ұнатады.
Dialogue: 0,0:13:06.00,0:13:07.04,Default,,0,0,0,,Сол Хокёядан бастап
Dialogue: 0,0:13:07.04,0:13:10.09,Default,,0,0,0,,Қабылдаушы клуб мүшелері менің бағыныштыларым болуы керек.
Dialogue: 0,0:13:11.08,0:13:13.03,Default,,0,0,0,,Тамаки Суо
Dialogue: 0,0:13:13.04,0:13:15.08,Default,,0,0,0,,Ол өте өткір шығар.
Dialogue: 0,0:13:15.09,0:13:18.03,Default,,0,0,0,,Мен әдетте ақкөңіл кейіпкерді сомдаймын.
Dialogue: 0,0:13:18.06,0:13:20.08,Default,,0,0,0,,Оның астарлы ниеті бар екені сөзсіз.
Dialogue: 0,0:13:21.01,0:13:22.07,Default,,0,0,0,,Жанжалдарды міндетті түрде пайдаланыңыз
Dialogue: 0,0:13:22.09,0:13:24.07,Default,,0,0,0,,Еске саламын
Dialogue: 0,0:13:31.03,0:13:33.07,Default,,0,0,0,,Дарума-сан құлап қалды
Dialogue: 0,0:13:35.01,0:13:38.06,Default,,0,0,0,,Дарума-сан құлап қалды
Dialogue: 0,0:13:40.05,0:13:42.09,Default,,0,0,0,,Дарума-сан құлап қалды
Dialogue: 0,0:13:44.04,0:13:45.05,Default,,0,0,0,,Дарума-сан құлап қалды
Dialogue: 0,0:13:46.07,0:13:47.07,Default,,0,0,0,,Дарума-сан құлап қалды
Dialogue: 0,0:13:48.09,0:13:50.04,Default,,0,0,0,,Дарума-сан құлап қалды
Dialogue: 0,0:13:50.08,0:13:53.00,Default,,0,0,0,,Каору Хикари қазір сәл қозғалуы керек еді.
Dialogue: 0,0:13:51.05,0:13:55.00,Default,,0,0,0,,Менеджер, бұл қандай көрініс?
Dialogue: 0,0:13:53.02,0:13:55.01,Default,,0,0,0,,Хмм, ол қозғалмайды.
Dialogue: 0,0:13:55.03,0:13:57.01,Default,,0,0,0,,Бұл жаңа дін ме?
Dialogue: 0,0:13:57.03,0:13:59.03,Default,,0,0,0,,Менің білуім мүмкін емес
Dialogue: 0,0:14:00.00,0:14:01.09,Default,,0,0,0,,Таңқаларлық емес.
Dialogue: 0,0:14:02.02,0:14:05.01,Default,,0,0,0,,Бұл ерте заманнан қарапайым халыққа жалғасып келе жатқан ойын.
Dialogue: 0,0:14:05.02,0:14:06.09,Default,,0,0,0,,Басқа қарапайым адамдардың ойындарына жатады
Dialogue: 0,0:14:07.03,0:14:11.03,Default,,0,0,0,,Ақша жұмсамай-ақ ләззат алатын нәрселер көп.
Dialogue: 0,0:14:12.02,0:14:15.00,Default,,0,0,0,,Мұның біздің есеп беруімізге қандай қатысы бар?
Dialogue: 0,0:14:15.03,0:14:16.06,Default,,0,0,0,,Танысу
Dialogue: 0,0:14:17.07,0:14:20.05,Default,,0,0,0,,Газет бөлімдерінің жағымсыз бейнесін жою
Dialogue: 0,0:14:20.07,0:14:22.06,Default,,0,0,0,,Оқырмандарды қайтадан қалай тартуға болады
Dialogue: 0,0:14:22.08,0:14:24.04,Default,,0,0,0,,Таныс болу өте маңызды
Dialogue: 0,0:14:24.07,0:14:26.06,Default,,0,0,0,,Бұл дәл есептелгендей.
Dialogue: 0,0:14:27.00,0:14:30.01,Default,,0,0,0,,Қабылдаушы клубтың әдемі жігіттері қарапайым халықпен ойнағанды ​​ұнатады.
Dialogue: 0,0:14:30.03,0:14:32.07,Default,,0,0,0,,Жаздың басындағы сергітетін фонымен ашық ауада
Dialogue: 0,0:14:32.09,0:14:35.07,Default,,0,0,0,,Бірінші бетті безендіретіндей әдемі
Dialogue: 0,0:14:36.00,0:14:39.09,Default,,0,0,0,,Оның үстіне кейбір қарапайым адамдар да ұзақ уақыттан кейін балалық шаққа қайта оралғанына қатты қуанды.
Dialogue: 0,0:14:40.00,0:14:42.00,Default,,0,0,0,,Бұл арман сияқты жоба.
Dialogue: 0,0:14:43.08,0:14:44.08,Default,,0,0,0,,Мен бір нәрсеге қарап тұрмын
Dialogue: 0,0:14:45.09,0:14:48.04,Default,,0,0,0,,Қуануым керек пе?
Dialogue: 0,0:14:48.06,0:14:52.08,Default,,0,0,0,,Директор: Мен не айтып тұрғаныңызды түсінбеймін. Ах, Кёя, қазір сәл қозғалған боларсың. Мұнда келіп, кішкентай саусақтарымызды біріктіріңіз.
Dialogue: 0,0:14:51.06,0:14:54.04,Default,,0,0,0,,Бұл адам жай ғана ақымақ па?
Dialogue: 0,0:14:53.06,0:14:55.03,Default,,0,0,0,,Мүмкін сіздің көру қабілетіңіз нашарлаған шығар?
Dialogue: 0,0:14:54.06,0:14:56.02,Default,,0,0,0,,Сақтықты төмендетпеңіз
Dialogue: 0,0:14:55.05,0:14:57.07,Default,,0,0,0,,Шағымданба, тез кел!
Dialogue: 0,0:14:56.06,0:14:58.03,Default,,0,0,0,,Бұл оның стратегиясы.
Dialogue: 0,0:14:57.09,0:14:59.00,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:15:02.04,0:15:04.06,Default,,0,0,0,,Кейбір қарапайым адамдар?
Dialogue: 0,0:15:05.00,0:15:07.04,Default,,0,0,0,,Жақында аяқталады деп үміттенемін
Dialogue: 0,0:15:07.07,0:15:09.01,Default,,0,0,0,,Бұл Фудзиока-кун болатын.
Dialogue: 0,0:15:10.01,0:15:12.05,Default,,0,0,0,,Сізбен бір сәт сөйлесе аламын ба?
Dialogue: 0,0:15:14.08,0:15:16.03,Default,,0,0,0,,Неліктен сіз бұл бөлімдесіз?
Dialogue: 0,0:15:18.01,0:15:19.08,Default,,0,0,0,,Сәл салақтық
Dialogue: 0,0:15:20.00,0:15:22.00,Default,,0,0,0,,Сіз стипендиатсыз, солай ма?
Dialogue: 0,0:15:22.06,0:15:23.06,Default,,0,0,0,,Иә, бірақ
Dialogue: 0,0:15:23.08,0:15:26.05,Default,,0,0,0,,Басқаша айтқанда, сіз клубтың мүшесісіз.
Dialogue: 0,0:15:26.06,0:15:30.08,Default,,0,0,0,,Бұл Суо отбасы үшін өз күшін көрсету үшін тамаша материал.
Dialogue: 0,0:15:32.02,0:15:35.01,Default,,0,0,0,,Оның сахна артындағы бет-әлпетін айтып бере аласыз ба?
Dialogue: 0,0:15:35.07,0:15:38.03,Default,,0,0,0,,Немесе бұл сізді құтқаруға көмектеседі.
Dialogue: 0,0:15:38.09,0:15:41.03,Default,,0,0,0,,Бұл адамның жасырын жағы жоқ.
Dialogue: 0,0:15:42.06,0:15:43.07,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:15:43.09,0:15:47.09,Default,,0,0,0,,Сіздің ойыңызша, бұл жоғары сынып оқушылары бұл ойынды шынымен ұнатады ма?
Dialogue: 0,0:15:50.02,0:15:51.03,Default,,0,0,0,,Біртүрлі ме?
Dialogue: 0,0:15:51.09,0:15:52.07,Default,,0,0,0,,Бұл мүмкін емес еді
Dialogue: 0,0:15:53.02,0:15:54.02,Default,,0,0,0,,кесу
Dialogue: 0,0:15:55.02,0:15:57.07,Default,,0,0,0,,Қараңызшы, бұл жер кесетін жер емес.
Dialogue: 0,0:15:58.06,0:16:00.04,Default,,0,0,0,,Олай болса, банканы теуіп алайық.
Dialogue: 0,0:16:00.06,0:16:02.01,Default,,0,0,0,,Өйткені Кюя жын.
Dialogue: 0,0:16:03.06,0:16:04.06,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:04.09,0:16:08.08,Default,,0,0,0,,Жұлдызды соққы
Dialogue: 0,0:16:13.05,0:16:17.06,Default,,0,0,0,,Мен көп рет дәл сол қозғалыс маған жұмыс істейді деп ойладым.
Dialogue: 0,0:16:18.02,0:16:19.02,Default,,0,0,0,,Менеджер
Dialogue: 0,0:16:19.04,0:16:21.01,Default,,0,0,0,,Харухи осы жолмен жүгір!
Dialogue: 0,0:16:25.01,0:16:27.06,Default,,0,0,0,,Менің ойымша, ол бір қыры жасырын адам сияқты емес.
Dialogue: 0,0:16:27.08,0:16:32.07,Default,,0,0,0,,Бірақ қазір ойлап қарасам, Тамаки-сенпайдың үйі туралы ештеңе білмеймін.
Dialogue: 0,0:16:36.05,0:16:38.02,Default,,0,0,0,,Бұл әзіл емес.
Dialogue: 0,0:16:38.09,0:16:41.04,Default,,0,0,0,,Мен оның фарсына енді шыдай алмаймын.
Dialogue: 0,0:16:42.01,0:16:44.01,Default,,0,0,0,,Кешірім Тамаки Суох
Dialogue: 0,0:16:48.07,0:16:50.02,Default,,0,0,0,,Сіз адасып қалдыңыз ба?
Dialogue: 0,0:16:51.01,0:16:52.07,Default,,0,0,0,,Сонда адасып қалдыңыз ба?
Dialogue: 0,0:16:53.01,0:16:56.01,Default,,0,0,0,,Харухи, мұнда жақсы жасырынатын жер бар.
Dialogue: 0,0:16:57.02,0:16:58.06,Default,,0,0,0,,Мен адасып қалдым
Dialogue: 0,0:16:59.08,0:17:01.08,Default,,0,0,0,,Бір мағынада бұл апат.
Dialogue: 0,0:17:02.09,0:17:05.07,Default,,0,0,0,,Кёуя-сенпайды жынға айналдыру дұрыс емес пе?
Dialogue: 0,0:17:07.00,0:17:08.02,Default,,0,0,0,,Сіз қалжыңдап тұрсыз ба?
Dialogue: 0,0:17:11.04,0:17:15.09,Default,,0,0,0,,Бірақ мен жоғары сынып оқушысы болған кезде мұндай ойындар ойнаймын деп ойламадым.
Dialogue: 0,0:17:16.02,0:17:17.06,Default,,0,0,0,,Бұл қызық емес пе?
Dialogue: 0,0:17:18.01,0:17:22.08,Default,,0,0,0,,Бастауыш сыныпта оқып жүргенде достарыммен біраз істедім.
Dialogue: 0,0:17:24.00,0:17:24.50,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:26.05,0:17:31.01,Default,,0,0,0,,Менің жасымда достарым көп болмады.
Dialogue: 0,0:17:31.06,0:17:33.05,Default,,0,0,0,,Менің анам жиі ауырады.
Dialogue: 0,0:17:34.01,0:17:37.02,Default,,0,0,0,,Мен уайымдап, өз ойымды жеткізе алмайтын бала едім.
Dialogue: 0,0:17:37.09,0:17:39.09,Default,,0,0,0,,Ал анамның көңілін көтеру үшін
Dialogue: 0,0:17:40.01,0:17:42.03,Default,,0,0,0,,Ол үнемі менің қасымда пианинода ойнайтын.
Dialogue: 0,0:17:42.08,0:17:46.02,Default,,0,0,0,,Сондықтан мен қазір барлығымен осылай ойнағанды ​​ұнатамын.
Dialogue: 0,0:17:49.02,0:17:50.06,Default,,0,0,0,,Өте қызық
Dialogue: 0,0:17:53.05,0:17:54.09,Default,,0,0,0,,Қайтадан жасайық
Dialogue: 0,0:17:55.05,0:17:56.07,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:17:58.04,0:18:00.00,Default,,0,0,0,,Мақаланы аяқтаңыз
Dialogue: 0,0:18:00.01,0:18:01.04,Default,,0,0,0,,Дегенмен, директор
Dialogue: 0,0:18:01.06,0:18:05.09,Default,,0,0,0,,Ешбір дәлелсіз Суоу туралы өсек жазу өте қауіпті ме?
Dialogue: 0,0:18:06.00,0:18:11.00,Default,,0,0,0,,Енді ешқандай дәлел болмаса да, оның құйрығын көрсеткені туралы мақала жазуға болады.
Dialogue: 0,0:18:11.01,0:18:12.06,Default,,0,0,0,,Егер мен байыпты болсам
Dialogue: 0,0:18:12.07,0:18:16.00,Default,,0,0,0,,Бұл менің мектебімдегі ақымақтар шу шығаратын ойдан шығарылған мақала.
Dialogue: 0,0:18:16.02,0:18:17.06,Default,,0,0,0,,Қалағаныңызша жаза аласыз.
Dialogue: 0,0:18:17.07,0:18:19.08,Default,,0,0,0,,Қалай болғанда да, біз Сууды жеңуіміз керек.
Dialogue: 0,0:18:23.06,0:18:25.02,Default,,0,0,0,,Өйткені, солай.
Dialogue: 0,0:18:25.06,0:18:26.05,Default,,0,0,0,,Кисамара
Dialogue: 0,0:18:26.07,0:18:28.08,Default,,0,0,0,,Бұл анық болды.
Dialogue: 0,0:18:29.00,0:18:31.03,Default,,0,0,0,,Сіз ғана байқамаған шығарсыз.
Dialogue: 0,0:18:31.06,0:18:34.03,Default,,0,0,0,,Өйткені ол адам өзін әсіресе бейхабар.
Dialogue: 0,0:18:34.05,0:18:35.06,Default,,0,0,0,,Сізге айтайын
Dialogue: 0,0:18:35.07,0:18:38.01,Default,,0,0,0,,Мырзамның үстіне қолыңды қойсаң, құтылмайсың.
Dialogue: 0,0:18:38.03,0:18:42.06,Default,,0,0,0,,Сіз тек Хитачиинді ғана емес, сонымен қатар біздің клубтағылардың барлығын өз жауыңызға айналдыруға дайынсыз ба?
Dialogue: 0,0:18:43.05,0:18:47.09,Default,,0,0,0,,Өйткені, Суо ата-анасының күшін пайдаланып нұсқау береді.
Dialogue: 0,0:18:48.02,0:18:49.01,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:18:49.09,0:18:52.03,Default,,0,0,0,,Тама-чан мұндай әрекетке бармайды.
Dialogue: 0,0:18:53.03,0:18:57.05,Default,,0,0,0,,Білесің бе, біз Тама-чанды жақсы көреміз.
Dialogue: 0,0:18:57.07,0:19:00.08,Default,,0,0,0,,Мен жай ғана үмітсіз ақымақпын.
Dialogue: 0,0:19:01.09,0:19:05.09,Default,,0,0,0,,Кёуя менімен клуб құрайық.
Dialogue: 0,0:19:06.08,0:19:08.09,Default,,0,0,0,,Hello, Haninozuka-senpai
Dialogue: 0,0:19:10.02,0:19:13.09,Default,,0,0,0,,Бұл кенеттен болды, бірақ менімен клуб ашқыңыз келе ме?
Dialogue: 0,0:19:14.08,0:19:16.06,Default,,0,0,0,,Харунозука Сенпай
Dialogue: 0,0:19:19.07,0:19:21.03,Default,,0,0,0,,Балалар сендер жалықтырып алған сияқтысыңдар.
Dialogue: 0,0:19:22.07,0:19:26.01,Default,,0,0,0,,Бос уақытыңыз болса, менімен неге үйірме ашпасқа?
Dialogue: 0,0:19:27.06,0:19:28.02,Default,,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:19:28.04,0:19:29.05,Default,,0,0,0,,Біз не істейміз?
Dialogue: 0,0:19:29.08,0:19:31.07,Default,,0,0,0,,Мұны істеуді тоқтатыңыз.
Dialogue: 0,0:19:32.05,0:19:33.05,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:19:34.02,0:19:38.05,Default,,0,0,0,,Бұл енді тек Суо емес, мен бәріңді құртамын.
Dialogue: 0,0:19:38.08,0:19:40.07,Default,,0,0,0,,Мұны еркін сезініңіз.
Dialogue: 0,0:19:41.04,0:19:42.01,Default,,0,0,0,,Бірақ
Dialogue: 0,0:19:46.02,0:19:50.07,Default,,0,0,0,,Кешеден бері мен сіздің пікірлеріңізді тыңдап, жазып алатын дискі
Dialogue: 0,0:19:50.09,0:19:52.06,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:19:53.08,0:19:55.01,Default,,0,0,0,,Менеджер
Dialogue: 0,0:19:55.04,0:19:57.00,Default,,0,0,0,,Артық емес
Dialogue: 0,0:20:00.07,0:20:03.06,Default,,0,0,0,,Сіз мұны осылай айтасыз.
Dialogue: 0,0:20:04.03,0:20:07.08,Default,,0,0,0,,Тіпті біздің Otori Group пен Hitachiin холдингтері
Dialogue: 0,0:20:08.00,0:20:12.00,Default,,0,0,0,,Әкеңіздің баспа компаниясының президентін қалауыңызша өзгерте аласыз.
Dialogue: 0,0:20:12.01,0:20:13.05,Default,,0,0,0,,Есте сақтау жақсы
Dialogue: 0,0:20:14.03,0:20:17.08,Default,,0,0,0,,Бірақ біз сізден бөлекпіз.
Dialogue: 0,0:20:20.06,0:20:23.05,Default,,0,0,0,,Біздің көздегеніміз түбегейлі басқа.
Dialogue: 0,0:20:27.04,0:20:28.07,Default,,0,0,0,,Табылды
Dialogue: 0,0:20:31.01,0:20:32.06,Default,,0,0,0,,Газет бөлімі
Dialogue: 0,0:20:32.09,0:20:34.09,Default,,0,0,0,,Төтенше жағдайға байланысты сұхбат тоқтатылды.
Dialogue: 0,0:20:35.03,0:20:38.00,Default,,0,0,0,,Бұдан былай лайықты мақалалар жазамын деді.
Dialogue: 0,0:20:38.03,0:20:40.05,Default,,0,0,0,,Оны таратудың қажеті жоқ.
Dialogue: 0,0:20:40.06,0:20:42.08,Default,,0,0,0,,Түсіндім, бұл жақсы.
Dialogue: 0,0:20:42.09,0:20:45.08,Default,,0,0,0,,Тезірек клуб бөлмесіне оралайық, торт жейміз.
Dialogue: 0,0:20:46.07,0:20:47.09,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:20:48.07,0:20:50.09,Default,,0,0,0,,торт торты
Dialogue: 0,0:20:51.04,0:20:53.01,Default,,0,0,0,,Ойланып қарашы, Кёуя-сенпай
Dialogue: 0,0:20:53.08,0:20:56.05,Default,,0,0,0,,Суоның үйі шынымен де керемет пе?
Dialogue: 0,0:20:56.08,0:21:00.09,Default,,0,0,0,,Ал, бизнес ерте заманнан қаржы саласына негізделген.
Dialogue: 0,0:21:01.01,0:21:02.07,Default,,0,0,0,,Эй, сен ол туралы естімедің бе?
Dialogue: 0,0:21:03.00,0:21:06.02,Default,,0,0,0,,Roi Grand Hotel, Сакурато театры және т.б.
Dialogue: 0,0:21:06.04,0:21:08.00,Default,,0,0,0,,Қалғанын өзіңіз білесіз.
Dialogue: 0,0:21:08.02,0:21:09.07,Default,,0,0,0,,Мектепті басқару және
Dialogue: 0,0:21:09.09,0:21:11.07,Default,,0,0,0,,Сіз қай мектепте оқисыз?
Dialogue: 0,0:21:17.05,0:21:18.07,Default,,0,0,0,,Бұл Оуран.
Dialogue: 0,0:21:20.09,0:21:25.00,Default,,0,0,0,,Сіз өз мектебіңіздің президенті сияқты есте сақтауыңыз керек.
Dialogue: 0,0:21:25.08,0:21:28.00,Default,,0,0,0,,Ойланып қарасаңыз
Dialogue: 0,0:21:28.06,0:21:32.05,Default,,0,0,0,,Тамакидің көмегімен мектепке түскен сияқтысың.
Dialogue: 0,0:21:33.02,0:21:34.06,Default,,0,0,0,,Алғыс айту
Dialogue: 0,0:21:35.06,0:21:37.00,Default,,0,0,0,,Харухи
Dialogue: 0,0:21:41.02,0:21:43.04,Default,,0,0,0,,Тез келмесең, мен сені артқа тастаймын.
Dialogue: 0,0:21:44.04,0:21:47.02,Default,,0,0,0,,Мен қайтадан адасып бара жатырмын.
Dialogue: 0,0:21:59.04,0:22:03.00,Default,,0,0,0,,m 5 0 b 2 0 0 2 0 5 b 0 8 2 10 5 10 b 8 10 10 8 10 5 b 10 2 8 0 5 0
Dialogue: 0,0:22:02.01,0:22:09.03,Default,,0,0,0,,Ма Жүгіру Шынайы кімдігі: жалдамалы кісі өлтіруші Мақсатты тұлғаның қатысуы тиіс қоғамдық жиынға бару үшін Бізге асығыс керек. Фалко!!
Dialogue: 0,0:22:03.08,0:22:06.02,Default,,0,0,0,,5000 m 5 0 b 2 0 0 2 0 5 b 0 8 2 10 5 10 b 8 10 10 8 10 5 b 10 2 8 0 5 0
Dialogue: 0,0:22:04.05,0:22:06.05,Default,,0,0,0,,Ма
Dialogue: 0,0:22:05.06,0:22:07.09,Default,,0,0,0,,Жүгіру
Dialogue: 0,0:22:06.01,0:22:09.02,Default,,0,0,0,,Шынайы кімдігі: жалдамалы кісі өлтіруші Фалко!!
Dialogue: 0,0:22:07.04,0:22:09.07,Default,,0,0,0,,Мақсатты тұлғаның қатысуы тиіс қоғамдық жиынға бару үшін
Dialogue: 0,0:22:08.01,0:22:14.01,Default,,0,0,0,,Бізге асығыс керек. Қонақтар келгенде өзімізді жұп болып көрсетелік. Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады Бес Барлығы
Dialogue: 0,0:22:09.01,0:22:16.03,Default,,0,0,0,,Табыс Фалко!!
Dialogue: 0,0:22:10.00,0:22:12.01,Default,,0,0,0,,А
Dialogue: 0,0:22:11.00,0:22:13.01,Default,,0,0,0,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:22:12.07,0:22:14.06,Default,,0,0,0,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,0:22:13.05,0:22:15.05,Default,,0,0,0,,Бес
Dialogue: 0,0:22:14.01,0:22:17.00,Default,,0,0,0,,Барлығы Фалко!!
Dialogue: 0,0:22:15.08,0:22:18.02,Default,,0,0,0,,Мәжбүрлі күлкі мен алдаумен Жарайды…
Dialogue: 0,0:22:16.00,0:22:22.08,Default,,0,0,0,,отбасы құру Такада мырза, жағдайыңыз қалай? Табыс Қонақтар келгенде өзімізді жұп болып көрсетелік. Жарайды… Жұмыс
Dialogue: 0,0:22:17.06,0:22:19.09,Default,,0,0,0,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:22:18.02,0:22:20.02,Default,,0,0,0,,Жарайды…
Dialogue: 0,0:22:19.01,0:22:22.00,Default,,0,0,0,,отбасы құру Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:22:20.02,0:22:23.01,Default,,0,0,0,,Такада мырза, жағдайыңыз қалай? Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:22:21.04,0:22:23.04,Default,,0,0,0,,Қонақтар келгенде өзімізді жұп болып көрсетелік.
Dialogue: 0,0:22:22.00,0:22:30.04,Default,,0,0,0,,Жарайды… Қала Кодтық аты: Принцесса Торн Ал Шинигами өзі түсіріп алған дәптерді алған адамға болып табылады Құрметті Қайталау Қайтару Фалко!!
Dialogue: 0,0:22:23.08,0:22:26.00,Default,,0,0,0,,Қала
Dialogue: 0,0:22:24.07,0:22:26.08,Default,,0,0,0,,Ая
Dialogue: 0,0:22:25.01,0:22:28.00,Default,,0,0,0,,Кодтық аты: Принцесса Торн адамдар
Dialogue: 0,0:22:26.03,0:22:28.04,Default,,0,0,0,,болып табылады
Dialogue: 0,0:22:27.01,0:22:30.01,Default,,0,0,0,,Құрметті Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:22:28.03,0:22:30.05,Default,,0,0,0,,Қайталау
Dialogue: 0,0:22:29.02,0:22:33.00,Default,,0,0,0,,Қайтару Әр адамның ешкімге көрсетпейтін бір жағы бар Кодтық аты: Принцесса Торн
Dialogue: 0,0:22:30.00,0:22:36.02,Default,,0,0,0,,Фалко!! Мен бірге тұратын отбасыммен келдім. Шынында да, сен бөлексің… На Кодтық аты: Принцесса Торн
Dialogue: 0,0:22:31.04,0:22:33.04,Default,,0,0,0,,Біртүрлі
Dialogue: 0,0:22:32.00,0:22:34.01,Default,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:22:33.00,0:22:36.01,Default,,0,0,0,,Кодтық аты: Принцесса Торн Біртүрлі
Dialogue: 0,0:22:34.03,0:22:37.04,Default,,0,0,0,,Шынында да, сен бөлексің… Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:22:35.00,0:22:42.02,Default,,0,0,0,,Мәжбүрлі күлкі мен алдаумен Жарайды, жарайды, Азумабито әулетінің мүшелері. На Мен білетінім, бұл алғаш рет. Сенім Джи Әлсіз
Dialogue: 0,0:22:36.02,0:22:39.01,Default,,0,0,0,,Мен бірге тұратын отбасыммен келдім. Көп емес екен, иә?
Dialogue: 0,0:22:37.04,0:22:39.07,Default,,0,0,0,,Мәжбүрлі күлкі мен алдаумен
Dialogue: 0,0:22:38.03,0:22:40.03,Default,,0,0,0,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:22:39.04,0:22:41.07,Default,,0,0,0,,Мен білетінім, бұл алғаш рет.
Dialogue: 0,0:22:40.06,0:22:44.02,Default,,0,0,0,,Сенім Оң Шынайы кімдігі: жалдамалы кісі өлтіруші Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:22:41.01,0:22:47.06,Default,,0,0,0,,Фалко!! Бізге асығыс керек. Жарайды, жарайды, Азумабито әулетінің мүшелері. Джи Кодтық аты: Принцесса Торн
Dialogue: 0,0:22:42.02,0:22:44.02,Default,,0,0,0,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:22:43.01,0:22:46.00,Default,,0,0,0,,Солға Фури
Dialogue: 0,0:22:44.02,0:22:46.02,Default,,0,0,0,,Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:22:45.03,0:22:47.04,Default,,0,0,0,,Фалко!!
Dialogue: 0,0:22:46.03,0:22:49.00,Default,,0,0,0,,Бізге асығыс керек. Жарық
Dialogue: 0,0:22:47.03,0:22:51.00,Default,,0,0,0,,Жарайды, жарайды, Азумабито әулетінің мүшелері. болып табылады ЖЕТ!
Dialogue: 0,0:22:48.00,0:22:54.03,Default,,0,0,0,,Хабардарлық Сатору Фалко!!
Dialogue: 0,0:22:49.04,0:22:52.00,Default,,0,0,0,,жалған Жалған Әр адамның ешкімге көрсетпейтін бір жағы бар
Dialogue: 0,0:22:50.03,0:22:52.05,Default,,0,0,0,,болып табылады
Dialogue: 0,0:22:51.00,0:22:53.00,Default,,0,0,0,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:22:52.02,0:22:54.09,Default,,0,0,0,,Хабардарлық
Dialogue: 0,0:22:53.01,0:22:56.01,Default,,0,0,0,,Сатору Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:22:54.03,0:22:59.04,Default,,0,0,0,,Фалко!! Әрине, бөлек. Шынайы кімдігі: жалдамалы кісі өлтіруші Кодтық аты: Принцесса Торн Шұн
Dialogue: 0,0:22:55.00,0:23:02.06,Default,,0,0,0,,Немесе болып табылады Кодтық аты: Принцесса Торн
Dialogue: 0,0:22:56.03,0:22:58.04,Default,,0,0,0,,Бұл жігіт, Джоруноның денесін арқалап
Dialogue: 0,0:22:57.00,0:22:59.01,Default,,0,0,0,,Әрине, бөлек.
Dialogue: 0,0:22:58.00,0:23:00.01,Default,,0,0,0,,Шынайы кімдігі: жалдамалы кісі өлтіруші
Dialogue: 0,0:22:59.04,0:23:01.05,Default,,0,0,0,,Шұн
Dialogue: 0,0:23:00.01,0:23:02.02,Default,,0,0,0,,Немесе
Dialogue: 0,0:23:01.05,0:23:04.00,Default,,0,0,0,,болып табылады Хиро
Dialogue: 0,0:23:02.06,0:23:05.00,Default,,0,0,0,,Кодтық аты: Принцесса Торн Мен бірге тұратын отбасыммен келдім.
Dialogue: 0,0:23:05.08,0:23:08.04,Default,,0,0,0,,Харухи жоғалып кетті!
Dialogue: 0,0:23:08.04,0:23:11.02,Default,,0,0,0,,Мен жай ғана жазғы демалысымды пайдаланып, Каруизаваға толық емес жұмыс күнімен келдім.
Dialogue: 0,0:23:11.04,0:23:13.03,Default,,0,0,0,,Мен, сергітуші, сені көремін.
Dialogue: 0,0:23:15.07,0:23:17.09,Default,,0,0,0,,Келесі аптада Оуран орта мектебінің хост клубы
Dialogue: 0,0:23:18.00,0:23:19.06,Default,,0,0,0,,Біз сізді асыға күтеміз.
Dialogue: 0,0:23:20.56,0:23:25.56,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
