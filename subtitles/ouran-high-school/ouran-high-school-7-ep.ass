Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:02.80,staff-ja,,0,0,0,,Mam
Dialogue: 0,0:00:00.00,0:00:03.00,staff-ja,,0,0,0,,HARERE
Dialogue: 0,0:00:00.00,0:00:03.00,staff-ja,,0,0,0,,Syura
Dialogue: 0,0:00:00.00,0:00:03.17,staff-ja,,0,0,0,,Аударма Aris
Dialogue: 0,0:00:00.00,0:00:03.25,staff-ja,,0,0,0,,Қара мысық йогураның кестесі
Dialogue: 0,0:00:00.00,0:00:03.25,staff-ja,,0,0,0,,Наксияның әкімшілік жүйесі
Dialogue: 0,0:00:00.00,0:00:03.63,staff-ja,,0,0,0,,OP&ED Hagakure
Dialogue: 0,0:00:00.00,0:00:03.63,staff-ja,,0,0,0,,Сюра
Dialogue: 0,0:00:00.00,0:00:03.88,Default11-ja,,0,0,0,,Құдайдың субтитр жұбы
Dialogue: 0,0:00:10.31,0:00:14.98,Style1,,0,0,0,,Мен түс көріп тұрмын ба?
Dialogue: 0,0:00:10.37,0:00:13.21,jp.sub-ja,,0,0,0,,Бұл арман ма?
Dialogue: 0,0:00:14.97,0:00:19.61,jp.sub-ja,,0,0,0,,Бұл Жапония және ол тропиктік аймақтарға жатпайды.
Dialogue: 0,0:00:14.98,0:00:16.58,Style1,,0,0,0,,Бұл Жапония.
Dialogue: 0,0:00:16.58,0:00:20.65,Style1,,0,0,0,,Бұл жерде тропиктік аймақтар болмауы керек.
Dialogue: 0,0:00:20.65,0:00:25.32,Style1,,0,0,0,,Қарашы, Харухи, мұнда оңтүстік тропиктік құстар бар.
Dialogue: 0,0:00:20.94,0:00:24.26,jp.sub-ja,,0,0,0,,Қараңдаршы, Харухи, тропикалық құс бар.
Dialogue: 0,0:00:25.32,0:00:28.99,Style1,,0,0,0,,Әдемі, солай емес пе? Мен оларды қандай құстар деп атайды деп ойлаймын.
Dialogue: 0,0:00:25.59,0:00:28.49,jp.sub-ja,,0,0,0,,Бұл әдемі. Ол қандай құс?
Dialogue: 0,0:00:28.99,0:00:32.66,Style1,,0,0,0,,Тағы да шығу қайда?
Dialogue: 0,0:00:29.17,0:00:31.04,jp.sub-ja,,0,0,0,,Шығу жолы қандай болды?
Dialogue: 0,0:00:32.66,0:00:37.00,Style1,,0,0,0,,Уақытты осылай жеңіл өткізуге жұмсау біз үшін маңызды
Dialogue: 0,0:00:33.05,0:00:35.45,jp.sub-ja,,0,0,0,,Уақытты мұндай ештеңемен өткізу
Dialogue: 0,0:00:36.02,0:00:40.03,jp.sub-ja,,0,0,0,,Бұл күндіз-түні сұлулығымызды тазартатын біз үшін маңызды.
Dialogue: 0,0:00:37.00,0:00:40.00,Style1,,0,0,0,,біздің тәулік бойы сұлулығымызды жақсарту.
Dialogue: 0,0:00:40.00,0:00:44.27,Style1,,0,0,0,,Маған ондай мәнсіз істерге уақыт жұмсау маңызды емес, сонда барсам болады ма?
Dialogue: 0,0:00:40.38,0:00:44.18,jp.sub-ja,,0,0,0,,Мен үйге бара аламын ба, себебі бұл мағынасыз және шексіз?
Dialogue: 0,0:00:44.27,0:00:45.88,Style1,,0,0,0,,Мен оқығым келеді,
Dialogue: 0,0:00:44.62,0:00:48.64,jp.sub-ja,,0,0,0,,Менің сабақ оқығым келеді, мен бүгін кір жууым керек.
Dialogue: 0,0:00:45.88,0:00:48.94,Style1,,0,0,0,,мен бүгін кір жууым керек.
Dialogue: 0,0:00:50.28,0:00:54.11,Style1,,0,0,0,,Бұл қай жер?
Dialogue: 0,0:00:50.39,0:00:53.54,jp.sub-ja,,0,0,0,,Бұл жер қай жерде?
Dialogue: 0,0:00:57.62,0:00:59.96,Style2,,0,0,0,,«Біраз бұрын...»
Dialogue: 0,0:00:59.96,0:01:01.82,Style2,,0,0,0,,"15:38"
Dialogue: 0,0:01:04.46,0:01:06.29,Style2,,0,0,0,,«Оуран академиясы, оңтүстік ғимарат, фронт»
Dialogue: 0,0:01:07.96,0:01:09.63,Style1,,0,0,0,,- Ұрлау... ...аяқталды!
Dialogue: 0,0:01:08.12,0:01:08.92,jp.sub-ja,,0,0,0,,Түсіру
Dialogue: 0,0:01:08.92,0:01:09.80,jp.sub-ja,,0,0,0,,Аяқталды
Dialogue: 0,0:01:09.63,0:01:11.12,Style1,,0,0,0,,Иә? Не...
Dialogue: 0,0:01:09.80,0:01:11.05,jp.sub-ja,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:01:13.30,0:01:16.40,Style1,,0,0,0,,- Жарайды, оны қабылда. - Роджер!
Dialogue: 0,0:01:13.50,0:01:14.88,jp.sub-ja,,0,0,0,,Жарайды, мені алып кет.
Dialogue: 0,0:01:15.27,0:01:15.77,jp.sub-ja,,0,0,0,,Түсінікті
Dialogue: 0,0:01:17.97,0:01:21.03,Style1,,0,0,0,,Бір минут. Жоқ!
Dialogue: 0,0:01:18.32,0:01:21.03,jp.sub-ja,,0,0,0,,Эй, маған ұнамайды.
Dialogue: 0,0:01:25.98,0:01:29.99,Style1,,0,0,0,,Бұл Otori Group басқаратын тақырыптық саябақ,
Dialogue: 0,0:01:26.34,0:01:30.23,jp.sub-ja,,0,0,0,,Бұл Uchiha Otori тобы басқаратын тақырыптық саябақ.
Dialogue: 0,0:01:30.23,0:01:31.82,jp.sub-ja,,0,0,0,,Бұл тропикалық аква бақ.
Dialogue: 0,0:01:32.32,0:01:36.33,Style1,,0,0,0,,Бірақ Кёя-сенпай, сіздің отбасыңыз аурухана басқарғанын айтпадыңыз ба?
Dialogue: 0,0:01:32.56,0:01:35.61,jp.sub-ja,,0,0,0,,Өйткені Кёуя-сенпайдың үйі аурухана.
Dialogue: 0,0:01:35.97,0:01:38.51,jp.sub-ja,,0,0,0,,Сіз медицина саласында жұмыс істедім деп айтпадыңыз.
Dialogue: 0,0:01:36.33,0:01:39.00,Style1,,0,0,0,,немесе қандай да бір медициналық терапия жұмыс істеді ме?
Dialogue: 0,0:01:39.00,0:01:43.00,Style1,,0,0,0,,Бұл көп нәрсені жасайтын әртараптандырылған кәсіпорын,
Dialogue: 0,0:01:39.03,0:01:42.43,jp.sub-ja,,0,0,0,,Ал, бұл әртараптандырылған басқару деп аталады және олар көп нәрсені жасайды.
Dialogue: 0,0:01:42.82,0:01:45.74,jp.sub-ja,,0,0,0,,Мұны медицинаға қатысты деп атауға болады.
Dialogue: 0,0:01:43.00,0:01:47.60,Style1,,0,0,0,,бірақ бұл терапияға қатысты деп айтуға болады.
Dialogue: 0,0:01:47.60,0:01:49.94,Style1,,0,0,0,,Стресстен немесе ынтымақтасудан зардап шегетіндер көп.
Dialogue: 0,0:01:47.70,0:01:49.77,jp.sub-ja,,0,0,0,,Күйзеліс пен тосқауыл сезімінен зардап шегу
Dialogue: 0,0:01:49.94,0:01:52.61,Style1,,0,0,0,,кім оңтүстік тропиктерде уақыт өткізгісі келеді,
Dialogue: 0,0:01:50.14,0:01:52.54,jp.sub-ja,,0,0,0,,Ашық тропикалық елде демалғыңыз келсе де
Dialogue: 0,0:01:52.61,0:01:57.95,Style1,,0,0,0,,бірақ экономикалық себептерге немесе уақыттың жетіспеушілігіне байланысты бара алмайды.
Dialogue: 0,0:01:52.96,0:01:56.78,jp.sub-ja,,0,0,0,,Уақыт немесе экономикалық себептерге байланысты мұны істей алмайтын адамдар көп.
Dialogue: 0,0:01:57.95,0:02:02.62,Style1,,0,0,0,,Бұл адамдарды емдеуге көмектесетін сауықтыру саябағы.
Dialogue: 0,0:01:58.10,0:02:02.19,jp.sub-ja,,0,0,0,,Бұл емдік ойын-сауық саябағы, оны мұндай адамдар үшін сауықтыру ретінде пайдалануға болады.
Dialogue: 0,0:02:02.62,0:02:07.96,Style1,,0,0,0,,Отори тобы әрқашан басқалардың бақытын ойлайды.
Dialogue: 0,0:02:02.87,0:02:07.98,jp.sub-ja,,0,0,0,,Менің Отори тобым әрқашан адамдардың бақытын ойлайды.
Dialogue: 0,0:02:07.96,0:02:10.63,Style1,,0,0,0,,Бұл тынымсыз көлеңкелі естіледі.
Dialogue: 0,0:02:08.28,0:02:10.23,jp.sub-ja,,0,0,0,,Шексіз күдікті
Dialogue: 0,0:02:10.63,0:02:12.96,Style1,,0,0,0,,Ол келесі айға дейін ашылмайды,
Dialogue: 0,0:02:10.70,0:02:12.82,jp.sub-ja,,0,0,0,,Ол келесі айдан бастап ашылады.
Dialogue: 0,0:02:12.96,0:02:16.66,Style1,,0,0,0,,, бірақ Хост клубы оны арнайы алдын ала шақыру бойынша бүгін сақтап қойған.
Dialogue: 0,0:02:13.02,0:02:16.37,jp.sub-ja,,0,0,0,,Бүгін бізде қабылдаушы клубты брондауға арнайы шақыру бар.
Dialogue: 0,0:02:18.30,0:02:20.27,Style1,,0,0,0,,Ол сондай тыныш.
Dialogue: 0,0:02:18.53,0:02:20.03,jp.sub-ja,,0,0,0,,Мен өзімді тыныш сезінемін.
Dialogue: 0,0:02:20.27,0:02:25.98,Style1,,0,0,0,,Мұнда біз де қызмет көрсететін қонақтар жоқ.
Dialogue: 0,0:02:20.72,0:02:24.88,jp.sub-ja,,0,0,0,,Бұл жолы қызмет көрсететін тұтынушылар жоқ.
Dialogue: 0,0:02:25.98,0:02:29.25,Style1,,0,0,0,,Бұл шынымен де әдемі жас жауынгердің мерекесі,
Dialogue: 0,0:02:26.15,0:02:30.65,jp.sub-ja,,0,0,0,,Әдемі жас жауынгердің демалысы сияқты.
Dialogue: 0,0:02:29.25,0:02:31.58,Style1,,0,0,0,,Менің ойымша, сіз оны атай аласыз.
Dialogue: 0,0:02:37.91,0:02:39.31,jp.sub-ja,,0,0,0,,Хару-чан
Dialogue: 0,0:02:37.99,0:02:39.99,Style1,,0,0,0,,Хару-чан!
Dialogue: 0,0:02:39.99,0:02:44.59,Style1,,0,0,0,,Кокос шырынын ішу керек пе? Немесе манго торты болуы мүмкін бе?
Dialogue: 0,0:02:40.14,0:02:44.37,jp.sub-ja,,0,0,0,,Кокос шырынын ішіңіз немесе манго тортын жеңіз
Dialogue: 0,0:02:44.58,0:02:47.28,jp.sub-ja,,0,0,0,,Кокос шырыны.
Dialogue: 0,0:02:44.59,0:02:47.60,Style1,,0,0,0,,Мм... әрине, кокос шырыны.
Dialogue: 0,0:02:47.60,0:02:49.22,Style1,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,0:03:00.61,0:03:03.61,Style1,,0,0,0,,Харухи, су сырғанағына түсейік!
Dialogue: 0,0:03:00.83,0:03:01.44,jp.sub-ja,,0,0,0,,Харухи
Dialogue: 0,0:03:01.84,0:03:03.17,jp.sub-ja,,0,0,0,,Су сырғанағына барайық
Dialogue: 0,0:03:03.61,0:03:06.95,Style1,,0,0,0,,Сосын тағы да пуловердің несі бар?
Dialogue: 0,0:03:03.71,0:03:06.80,jp.sub-ja,,0,0,0,,Ал, сен мына капюшонда не киіп жүрсің?
Dialogue: 0,0:03:06.95,0:03:08.47,Style1,,0,0,0,,Не, мынау...
Dialogue: 0,0:03:07.05,0:03:08.03,jp.sub-ja,,0,0,0,,Бұл...
Dialogue: 0,0:03:09.95,0:03:11.62,Style2,,0,0,0,,«Әйелдер» «Ерлер»
Dialogue: 0,0:03:11.62,0:03:13.72,Style2,,0,0,0,,«Біраз бұрын»
Dialogue: 0,0:03:13.72,0:03:15.79,Style2,,0,0,0,,"16:02"
Dialogue: 0,0:03:15.79,0:03:17.62,Style2,,0,0,0,,«Киінетін бөлменің алдында»
Dialogue: 0,0:03:18.29,0:03:20.63,Style1,,0,0,0,,Жарайды, оған қамқор бол.
Dialogue: 0,0:03:18.66,0:03:20.41,jp.sub-ja,,0,0,0,,Олай болса, мына қызға көңіл бөліңізші.
Dialogue: 0,0:03:20.63,0:03:23.30,Style1,,0,0,0,,Өте жақсы.
Dialogue: 0,0:03:20.72,0:03:22.04,jp.sub-ja,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:03:23.28,0:03:24.90,jp.sub-ja,,0,0,0,,Фудзёка мырза
Dialogue: 0,0:03:23.30,0:03:26.97,Style1,,0,0,0,,Жарайды, Фудзиока-сама. Бұл жолмен.
Dialogue: 0,0:03:25.60,0:03:26.83,jp.sub-ja,,0,0,0,,Сендер не істеп жатырсыңдар?!
Dialogue: 0,0:03:26.97,0:03:29.00,Style1,,0,0,0,,Бір минут!
Dialogue: 0,0:03:27.39,0:03:28.01,jp.sub-ja,,0,0,0,,Біраз
Dialogue: 0,0:03:30.81,0:03:31.97,Style2,,0,0,0,,«Киінетін бөлме»
Dialogue: 0,0:03:31.98,0:03:33.98,Style1,,0,0,0,,Бір минут! Бір минут!
Dialogue: 0,0:03:32.03,0:03:33.61,jp.sub-ja,,0,0,0,,Эй, эй!
Dialogue: 0,0:03:33.84,0:03:36.90,jp.sub-ja,,0,0,0,,Сіздің бөлмеңізде купальниктер бар.
Dialogue: 0,0:03:33.98,0:03:36.98,Style1,,0,0,0,,Бұл бөлмеде сіз үшін бірнеше купальник бар.
Dialogue: 0,0:03:36.98,0:03:40.98,Style1,,0,0,0,,Біз анамыз әзірлеген осы жылдың ең соңғысын әкелдік.
Dialogue: 0,0:03:37.24,0:03:40.62,jp.sub-ja,,0,0,0,,Мен анам жасаған биылғы жаңа жұмыстардың барлығын әкелдім.
Dialogue: 0,0:03:40.98,0:03:43.59,Style1,,0,0,0,,Қайсысын қаласаңыз, таңдай аласыз.
Dialogue: 0,0:03:41.12,0:03:42.51,jp.sub-ja,,0,0,0,,Сіз өзіңізге ұнайтын нәрсені таңдай аласыз.
Dialogue: 0,0:03:43.59,0:03:46.92,Style1,,0,0,0,,Жарайды, Фудзиока-сама, біреуін таңдаңыз.
Dialogue: 0,0:03:43.85,0:03:46.53,jp.sub-ja,,0,0,0,,Енді, Фудзиока мырза, таңдаңыз.
Dialogue: 0,0:03:46.92,0:03:49.59,Style1,,0,0,0,,Жоқ, маған купальник керек емес.
Dialogue: 0,0:03:47.05,0:03:49.64,jp.sub-ja,,0,0,0,,Жоқ, жақсы, жүзу киімі.
Dialogue: 0,0:03:49.59,0:03:52.60,Style1,,0,0,0,,Олай болса, мен саған біреуін таңдаймын.
Dialogue: 0,0:03:49.64,0:03:52.25,jp.sub-ja,,0,0,0,,Жарайды, мен саған таңдауға рұқсат етемін.
Dialogue: 0,0:03:52.60,0:03:55.60,Style1,,0,0,0,,Күте тұрыңыз, оны емес. Мен бикини кигім келмейді.
Dialogue: 0,0:03:52.86,0:03:55.34,jp.sub-ja,,0,0,0,,Маған бикини ұнамайды.
Dialogue: 0,0:03:55.60,0:03:57.60,Style1,,0,0,0,,Бірақ сіз бұл жерде өте жақсы көрінетін едіңіз ...
Dialogue: 0,0:03:55.75,0:03:57.73,jp.sub-ja,,0,0,0,,Сіз бірге өте жақсы көрінесіз
Dialogue: 0,0:03:57.60,0:03:58.94,Style1,,0,0,0,,О, қараңдаршы.
Dialogue: 0,0:03:58.10,0:04:00.64,jp.sub-ja,,0,0,0,,Қараңдаршы, бұл сүйкімді.
Dialogue: 0,0:03:58.94,0:04:00.94,Style1,,0,0,0,,Бұл сүйкімді болар еді.
Dialogue: 0,0:04:00.94,0:04:04.57,Style1,,0,0,0,,Иә? Бірақ бұл жіптерден басқа ештеңе емес, солай емес пе?
Dialogue: 0,0:04:01.93,0:04:04.11,jp.sub-ja,,0,0,0,,Өйткені бұл жай ғана жол.
Dialogue: 0,0:04:29.97,0:04:30.66,jp.sub-ja,,0,0,0,,Аға
Dialogue: 0,0:04:29.97,0:04:31.23,Style1,,0,0,0,,Сенпай?
Dialogue: 0,0:04:31.23,0:04:34.30,Style1,,0,0,0,,Н-тездетіп, мынаны киіңіз.
Dialogue: 0,0:04:31.68,0:04:32.97,jp.sub-ja,,0,0,0,,Тездетіп, мынаны киіңіз.
Dialogue: 0,0:04:34.30,0:04:36.57,Style1,,0,0,0,,Қыздар тек осыншама теріні көрсету керек
Dialogue: 0,0:04:34.53,0:04:36.84,jp.sub-ja,,0,0,0,,Қыздардың терісін көрсетуі дұрыс па?
Dialogue: 0,0:04:36.57,0:04:38.80,Style1,,0,0,0,,олар некеге тұрғаннан кейін.
Dialogue: 0,0:04:36.84,0:04:38.18,jp.sub-ja,,0,0,0,,Тек үйленетін кезде
Dialogue: 0,0:04:40.31,0:04:42.65,Style1,,0,0,0,,Сонымен, сіз жүзуге бармайсыз ба?
Dialogue: 0,0:04:40.60,0:04:42.29,jp.sub-ja,,0,0,0,,Сіз жүзбейсіз бе?
Dialogue: 0,0:04:42.65,0:04:44.91,Style1,,0,0,0,,Кез келген жағдайда, сіз жүзе алмайсыз ба?
Dialogue: 0,0:04:42.74,0:04:44.31,jp.sub-ja,,0,0,0,,Мүмкін балға
Dialogue: 0,0:04:44.91,0:04:47.58,Style1,,0,0,0,,Мен келесі жігіт сияқты жүзе аламын деп ойлаймын,
Dialogue: 0,0:04:44.98,0:04:47.59,jp.sub-ja,,0,0,0,,Мен қарапайым адам сияқты жүзе аламын деп ойлаймын.
Dialogue: 0,0:04:47.58,0:04:51.25,Style1,,0,0,0,,бірақ мені бұл жер онша қызықтырмайды,
Dialogue: 0,0:04:47.59,0:04:51.02,jp.sub-ja,,0,0,0,,Мені мұндай нәрсе қызықтырмайды.
Dialogue: 0,0:04:51.25,0:04:55.59,Style1,,0,0,0,,мен мұнда жүзіп жүргенше, үйге барғанды ​​жөн көремін.
Dialogue: 0,0:04:51.38,0:04:53.29,jp.sub-ja,,0,0,0,,Суда жүзіп, көңіл көтеруден гөрі
Dialogue: 0,0:04:52.92,0:04:55.58,Style2,,0,0,0,,«Lazybones кейіпкері»
Dialogue: 0,0:04:53.31,0:04:55.37,jp.sub-ja,,0,0,0,,Мен үйге ертерек барғым келеді.
Dialogue: 0,0:04:55.59,0:04:59.26,Style1,,0,0,0,,Бұл шамадан тыс ғимараттың қандай кереметі бар?
Dialogue: 0,0:04:55.96,0:04:59.25,jp.sub-ja,,0,0,0,,Қызық, бұл әсіре құрал-жабдық не?
Dialogue: 0,0:04:59.26,0:05:02.27,Style1,,0,0,0,,Суда ойнау үшін винил бассейні ғана болуы керек.
Dialogue: 0,0:04:59.63,0:05:02.15,jp.sub-ja,,0,0,0,,Суда ойнау үшін винил бассейні жеткілікті.
Dialogue: 0,0:05:02.27,0:05:04.93,Style1,,0,0,0,,Винил бассейні дегеніміз не?
Dialogue: 0,0:05:02.56,0:05:04.08,jp.sub-ja,,0,0,0,,Винил бассейні дегеніміз не?
Dialogue: 0,0:05:04.93,0:05:06.27,Style1,,0,0,0,,Көрейік...
Dialogue: 0,0:05:05.10,0:05:08.05,jp.sub-ja,,0,0,0,,Міне, осы өлшем туралы.
Dialogue: 0,0:05:06.27,0:05:09.11,Style1,,0,0,0,,Олар өте үлкен,
Dialogue: 0,0:05:08.37,0:05:11.40,jp.sub-ja,,0,0,0,,Қараңызшы, бұл ауаны салып үрлейтін нәрсе.
Dialogue: 0,0:05:09.11,0:05:11.61,Style1,,0,0,0,,және сіз оларды ауаға толтырасыз.
Dialogue: 0,0:05:11.24,0:05:15.95,Style2,,0,0,0,,«Пластикалық бассейн»
Dialogue: 0,0:05:12.94,0:05:13.94,Style1,,0,0,0,,Манеке.
Dialogue: 0,0:05:13.38,0:05:14.05,jp.sub-ja,,0,0,0,,Барка
Dialogue: 0,0:05:13.94,0:05:15.95,Style1,,0,0,0,,Бұл әуе қайығы деп аталады.
Dialogue: 0,0:05:14.24,0:05:16.48,jp.sub-ja,,0,0,0,,Жарайды, бұл әуе қайығы деп аталады.
Dialogue: 0,0:05:15.95,0:05:17.94,Style2,,0,0,0,,«Үрленетін қайық»
Dialogue: 0,0:05:18.11,0:05:20.95,Style1,,0,0,0,,Кішкентай нәрсенің бассейн болуы мүмкін емес.
Dialogue: 0,0:05:18.31,0:05:20.91,jp.sub-ja,,0,0,0,,Кішкентай нәрсенің бассейн болуы мүмкін емес.
Dialogue: 0,0:05:20.95,0:05:21.62,Style1,,0,0,0,,Оқу, оқу
Dialogue: 0,0:05:21.62,0:05:26.62,Style1,,0,0,0,,Бұл бассейн. Оларда кішкентай балалар көп ойнайды, білесіз бе?
Dialogue: 0,0:05:21.97,0:05:25.44,jp.sub-ja,,0,0,0,,Бұл бассейн. Кішкентай балалар жиі суда ойнайды.
Dialogue: 0,0:05:26.62,0:05:30.29,Style1,,0,0,0,,Ей, ақымақтар, Харухи оны бассейн деп ойлайды, сондықтан бассейн болсын.
Dialogue: 0,0:05:26.62,0:05:37.30,Style2,,0,0,0,,«Сыбырлау»
Dialogue: 0,0:05:27.68,0:05:30.52,jp.sub-ja,,0,0,0,,Харухи бұл бассейн деп ойлайды, сондықтан бассейн жақсы.
Dialogue: 0,0:05:30.29,0:05:32.06,Style1,,0,0,0,,Харухиді ұятқа қалдырмаңыз.
Dialogue: 0,0:05:30.73,0:05:32.03,jp.sub-ja,,0,0,0,,Харухиді ұятқа қалдырмаңыз
Dialogue: 0,0:05:32.06,0:05:33.96,Style1,,0,0,0,,Оның тек аянышты қарапайым адамның білімі бар.
Dialogue: 0,0:05:32.26,0:05:34.26,jp.sub-ja,,0,0,0,,Бұл қарапайым халықтың даналығы.
Dialogue: 0,0:05:33.96,0:05:37.30,Style1,,0,0,0,,Иә? Бірақ қайық - қайық.
Dialogue: 0,0:05:35.34,0:05:37.71,jp.sub-ja,,0,0,0,,Өйткені қайық – қайық
Dialogue: 0,0:05:37.30,0:05:40.64,Style1,,0,0,0,,Қандай да бір себептермен мен өзімді өте жағымсыз сезінемін.
Dialogue: 0,0:05:37.71,0:05:40.59,jp.sub-ja,,0,0,0,,Не айтайын, бұл өте жағымсыз.
Dialogue: 0,0:05:40.64,0:05:42.97,Style1,,0,0,0,,Ештеңе етпейді, мені бір нәрсе мазалайды.
Dialogue: 0,0:05:40.80,0:05:42.87,jp.sub-ja,,0,0,0,,Мен бұл туралы көбірек алаңдадым.
Dialogue: 0,0:05:42.97,0:05:45.91,Style1,,0,0,0,,Мырза, неге Харухиге сол пуловер кигіздіңіз?
Dialogue: 0,0:05:43.24,0:05:45.82,jp.sub-ja,,0,0,0,,Неліктен Харухиге бұл капюшонды кигіздің?
Dialogue: 0,0:05:45.91,0:05:46.57,Style2,,0,0,0,,«Гулп!»
Dialogue: 0,0:05:46.58,0:05:48.58,Style1,,0,0,0,,Әдетте, сіз...
Dialogue: 0,0:05:46.92,0:05:48.44,jp.sub-ja,,0,0,0,,Егер сіз бұл туралы қалыпты түрде ойласаңыз.
Dialogue: 0,0:05:48.58,0:05:51.58,Style1,,0,0,0,,Мен Харухиді купальникпен көргім келеді!
Dialogue: 0,0:05:48.82,0:05:51.51,jp.sub-ja,,0,0,0,,Мен Харухиді купальникпен көргім келеді.
Dialogue: 0,0:05:51.58,0:05:53.58,Style1,,0,0,0,,...сіз бірінші айтатын нәрсе болар едіңіз.
Dialogue: 0,0:05:51.62,0:05:53.30,jp.sub-ja,,0,0,0,,айтудың ең ықтималы.
Dialogue: 0,0:05:53.58,0:05:55.25,Style1,,0,0,0,,Бұл күтпеген жағдай.
Dialogue: 0,0:05:53.90,0:05:54.83,jp.sub-ja,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:05:55.25,0:05:56.79,Style1,,0,0,0,,Мен мұны елестете алмаймын,
Dialogue: 0,0:05:55.43,0:05:57.78,jp.sub-ja,,0,0,0,,Мен олай емес деп ойлаймын, бірақ солай ма?
Dialogue: 0,0:05:56.79,0:05:59.76,Style1,,0,0,0,,бірақ ол өзінен басқа панктарды қаламағандықтан болуы мүмкін деп ойлайсыз ба?
Dialogue: 0,0:05:57.78,0:06:01.69,jp.sub-ja,,0,0,0,,Мен Харухидің терісін өзімнен басқа ешкімге көрсеткім келмейді немесе сол сияқты.
Dialogue: 0,0:05:59.76,0:06:01.59,Style1,,0,0,0,,Харухидің терісін көру үшін бе, әлде сол сияқты ма?
Dialogue: 0,0:06:01.59,0:06:03.26,Style1,,0,0,0,,О, бұл не?
Dialogue: 0,0:06:01.99,0:06:03.41,jp.sub-ja,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:06:03.26,0:06:05.60,Style1,,0,0,0,,Бұл оған түсініксіз болар еді, иә?
Dialogue: 0,0:06:03.41,0:06:05.74,jp.sub-ja,,0,0,0,,Бұл өте сұмдық, солай емес пе?
Dialogue: 0,0:06:05.60,0:06:07.60,Style1,,0,0,0,,Бұл жиіркенішті болар еді, жарайды.
Dialogue: 0,0:06:05.74,0:06:07.10,jp.sub-ja,,0,0,0,,Бұл жиіркенішті, солай емес пе?
Dialogue: 0,0:06:07.60,0:06:09.27,Style1,,0,0,0,,Ей, ақымақтар!
Dialogue: 0,0:06:07.79,0:06:08.98,jp.sub-ja,,0,0,0,,Ақымақ... ақымақ нәрсе
Dialogue: 0,0:06:09.27,0:06:12.60,Style1,,0,0,0,,Оның әкесі ретінде мен оның қамқоршысы болғандықтан, мұны істеуім табиғи нәрсе...
Dialogue: 0,0:06:09.36,0:06:12.51,jp.sub-ja,,0,0,0,,Мен әке және қамқоршы ретінде өзімнен күткен нәрсені істеймін.
Dialogue: 0,0:06:12.60,0:06:14.94,Style1,,0,0,0,,Өйткені, тіпті купальник киіп,
Dialogue: 0,0:06:12.68,0:06:15.04,jp.sub-ja,,0,0,0,,Жалпы айтқанда, қыз бала купальник кисе де,
Dialogue: 0,0:06:14.94,0:06:19.31,Style1,,0,0,0,,Қыз баланың ұлдардың алдында терісін ашық көрсетуі дұрыс емес.
Dialogue: 0,0:06:15.04,0:06:18.36,jp.sub-ja,,0,0,0,,Теріңізді ерлердің көзінше ашпаңыз.
Dialogue: 0,0:06:23.61,0:06:25.62,Style1,,0,0,0,,Хару-чан!
Dialogue: 0,0:06:23.83,0:06:24.95,jp.sub-ja,,0,0,0,,Хару-чан
Dialogue: 0,0:06:25.62,0:06:28.62,Style1,,0,0,0,,Ойнайық! Олардың сол жерде ағымдағы бассейні бар.
Dialogue: 0,0:06:25.74,0:06:28.70,jp.sub-ja,,0,0,0,,Ойнайық. Мына жерде жалқау өзен бар.
Dialogue: 0,0:06:28.62,0:06:32.29,Style1,,0,0,0,,Жоқ, мен бүгін жүзбеймін. иә?
Dialogue: 0,0:06:28.97,0:06:30.96,jp.sub-ja,,0,0,0,,Жоқ, мен бүгін жүзбеймін.
Dialogue: 0,0:06:31.53,0:06:34.47,jp.sub-ja,,0,0,0,,Әй, Бал-сенпай, жүзе алмайсың ба?
Dialogue: 0,0:06:32.29,0:06:35.63,Style1,,0,0,0,,Бал-сенпай, сен жүзуді білмейсің бе?
Dialogue: 0,0:06:35.63,0:06:39.25,Style1,,0,0,0,,Осылайша сүйкімді көрінеді.
Dialogue: 0,0:06:35.78,0:06:38.94,jp.sub-ja,,0,0,0,,Өйткені бұл сүйкімді.
Dialogue: 0,0:06:42.23,0:06:43.81,jp.sub-ja,,0,0,0,,Өйткені оның қоян үлгісі бар
Dialogue: 0,0:06:42.30,0:06:44.23,Style1,,0,0,0,,Қоянның дизайнына байланысты.
Dialogue: 0,0:06:42.30,0:06:46.23,Style2,,0,0,0,,«Түсіндім»
Dialogue: 0,0:06:44.17,0:06:45.84,jp.sub-ja,,0,0,0,,Соншалықты кінәсіз
Dialogue: 0,0:06:44.23,0:06:46.24,Style1,,0,0,0,,Тәтті және кінәсіз.
Dialogue: 0,0:06:46.15,0:06:48.15,jp.sub-ja,,0,0,0,,Жылы Жылы
Dialogue: 0,0:06:46.24,0:06:47.90,Style1,,0,0,0,,Ыстық! Өте салқын!
Dialogue: 0,0:06:47.90,0:06:50.37,Style2,,0,0,0,,«Қуатты қозғалтқыш»
Dialogue: 0,0:06:52.58,0:06:53.97,Style1,,0,0,0,,Ренге-чан?
Dialogue: 0,0:06:52.79,0:06:53.69,jp.sub-ja,,0,0,0,,Ренге-чан
Dialogue: 0,0:07:01.58,0:07:04.82,Style1,,0,0,0,,Бұл қондырғы барлық жерде орнатылған ба?
Dialogue: 0,0:07:01.94,0:07:04.37,jp.sub-ja,,0,0,0,,Бұл құрылғы барлық жерде.
Dialogue: 0,0:07:05.92,0:07:07.92,Style1,,0,0,0,,Бұл керемет көтерілу.
Dialogue: 0,0:07:06.25,0:07:07.66,jp.sub-ja,,0,0,0,,Керемет көрініс
Dialogue: 0,0:07:07.92,0:07:10.26,Style1,,0,0,0,,Сіздің ішіңізде қандай үлгі бар?
Dialogue: 0,0:07:08.24,0:07:10.14,jp.sub-ja,,0,0,0,,Оның ішіндегі өрнек қандай?
Dialogue: 0,0:07:10.26,0:07:14.26,Style1,,0,0,0,,О, сен білмейсің бе? Мен косплей жасап жатырмын.
Dialogue: 0,0:07:10.58,0:07:13.93,jp.sub-ja,,0,0,0,,О, түсінбедім, бұл косплей.
Dialogue: 0,0:07:14.26,0:07:15.60,Style1,,0,0,0,,М-мен бұған енді маңызды емес дедім!
Dialogue: 0,0:07:14.51,0:07:15.29,jp.sub-ja,,0,0,0,,Не
Dialogue: 0,0:07:15.60,0:07:16.27,Style1,,0,0,0,,«Ла-ла».
Dialogue: 0,0:07:16.27,0:07:18.94,Style1,,0,0,0,,Ла-Ла? Манга журналы?
Dialogue: 0,0:07:16.48,0:07:18.33,jp.sub-ja,,0,0,0,,Lala Manga журналы?
Dialogue: 0,0:07:18.94,0:07:20.60,Style1,,0,0,0,,Арман, шыңыраудан көтерілді;
Dialogue: 0,0:07:19.11,0:07:20.58,jp.sub-ja,,0,0,0,,Тұңғиықтан шыққан арман
Dialogue: 0,0:07:20.60,0:07:23.61,Style1,,0,0,0,,жас жігіттердің жүзін нұрландыратын сол көк көздері;
Dialogue: 0,0:07:20.92,0:07:24.96,jp.sub-ja,,0,0,0,,Түс
Dialogue: 0,0:07:23.61,0:07:25.94,Style1,,0,0,0,,дауыс ырғағы...
Dialogue: 0,0:07:25.94,0:07:27.94,Style1,,0,0,0,,Көрдіңіз бе? Мен Кисараги Куонмын!
Dialogue: 0,0:07:25.99,0:07:27.89,jp.sub-ja,,0,0,0,,Қарашы, Кисараги-кун.
Dialogue: 0,0:07:26.34,0:07:27.93,Style2,,0,0,0,,«Косплей» «Нақты нәрсе»
Dialogue: 0,0:07:27.94,0:07:29.61,Style1,,0,0,0,,Біз айта алмаймыз.
Dialogue: 0,0:07:28.04,0:07:29.06,jp.sub-ja,,0,0,0,,Маған сән журналының түсірілімінде қолданылған осы киімді берді
Dialogue: 0,0:07:29.61,0:07:32.95,Style1,,0,0,0,,Біз мұны мүлдем айта алмаймыз.
Dialogue: 0,0:07:29.69,0:07:31.49,jp.sub-ja,,0,0,0,,Мен мұны мүлдем түсінбеймін.
Dialogue: 0,0:07:32.88,0:07:36.19,jp.sub-ja,,0,0,0,,Қараңызшы, мырза, қыз сондай киінген.
Dialogue: 0,0:07:32.95,0:07:36.29,Style1,,0,0,0,,Эй, сэр, қыздың киінгені дұрыс екеніне сенімдісің бе...
Dialogue: 0,0:07:36.29,0:07:37.95,Style1,,0,0,0,,...осылай ма?
Dialogue: 0,0:07:36.52,0:07:37.32,jp.sub-ja,,0,0,0,,Та-да!
Dialogue: 0,0:07:37.95,0:07:40.96,Style1,,0,0,0,,Бұл жақсы болуы мүмкін.
Dialogue: 0,0:07:38.12,0:07:40.40,jp.sub-ja,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:07:40.85,0:07:41.81,jp.sub-ja,,0,0,0,,Неліктен?
Dialogue: 0,0:07:40.96,0:07:43.23,Style1,,0,0,0,,Тағы бір қосымша сабақ па, қазірден-ақ?
Dialogue: 0,0:07:43.23,0:07:45.56,Style1,,0,0,0,,Мүмкін бұл косплей болғандықтан ба?
Dialogue: 0,0:07:43.59,0:07:45.41,jp.sub-ja,,0,0,0,,Менің ойымша, бұл косплей болғандықтан шығар.
Dialogue: 0,0:07:45.56,0:07:47.23,Style1,,0,0,0,,Кез келген жағдайда,
Dialogue: 0,0:07:45.63,0:07:51.39,jp.sub-ja,,0,0,0,,Әйтеуір, Ханинозука-сенпай туралы бәрінің түсінігі жылы.
Dialogue: 0,0:07:47.23,0:07:51.57,Style1,,0,0,0,,Ханинозука-сенпай туралы түсінігіңіз жылы!
Dialogue: 0,0:07:51.57,0:07:53.87,Style1,,0,0,0,,Такаши!
Dialogue: 0,0:07:51.92,0:07:53.42,jp.sub-ja,,0,0,0,,Такаши
Dialogue: 0,0:07:57.24,0:07:58.71,Style1,,0,0,0,,Уа!
Dialogue: 0,0:08:00.24,0:08:01.91,Style1,,0,0,0,,Сіз қалай айтасыз?
Dialogue: 0,0:08:00.43,0:08:01.55,jp.sub-ja,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:08:01.91,0:08:05.58,Style1,,0,0,0,,Бұл оның айтқанын аяқтағандай.
Dialogue: 0,0:08:02.39,0:08:04.04,jp.sub-ja,,0,0,0,,Сіз бұл туралы бұрын айттыңыз.
Dialogue: 0,0:08:05.58,0:08:09.59,Style1,,0,0,0,,Осылайша сүйкімді көрінеді.
Dialogue: 0,0:08:05.74,0:08:08.29,jp.sub-ja,,0,0,0,,Өйткені бұл сүйкімді.
Dialogue: 0,0:08:09.59,0:08:11.92,Style1,,0,0,0,,Мен мұны тәтті және кінәсіз деп санамаймын.
Dialogue: 0,0:08:09.70,0:08:11.89,jp.sub-ja,,0,0,0,,Мен мұның кінәсіз емес екенін көрдім.
Dialogue: 0,0:08:11.92,0:08:13.59,Style1,,0,0,0,,Шынында да олай емес.
Dialogue: 0,0:08:12.13,0:08:15.66,jp.sub-ja,,0,0,0,,Сөйлемнің соңына тақырыпты қою арқылы анық айтуға болады.
Dialogue: 0,0:08:13.59,0:08:17.59,Style1,,0,0,0,,Сөйлемнің соңына тақырыпты қойыңыз, сонда көресіз.
Dialogue: 0,0:08:17.59,0:08:21.93,Style1,,0,0,0,,Осылайша сүйкімді көрінеді...
Dialogue: 0,0:08:18.34,0:08:21.59,jp.sub-ja,,0,0,0,,Өйткені бұл сүйкімді.
Dialogue: 0,0:08:21.93,0:08:23.93,Style1,,0,0,0,,... солай емес пе?
Dialogue: 0,0:08:22.02,0:08:22.78,jp.sub-ja,,0,0,0,,I
Dialogue: 0,0:08:22.90,0:08:23.92,Style2,,0,0,0,,«Мен сүйкімді көрінемін!»
Dialogue: 0,0:08:23.86,0:08:25.05,jp.sub-ja,,0,0,0,,Есептеу
Dialogue: 0,0:08:23.93,0:08:25.60,Style1,,0,0,0,,Ол мұны жоспарлаған!?
Dialogue: 0,0:08:24.77,0:08:25.60,Style2,,0,0,0,,«Ол мұны жоспарлады ма?»
Dialogue: 0,0:08:25.60,0:08:28.94,Style1,,0,0,0,,Бұл сізге Ханинозука-сенпай. Шамасы, оған қауіп төніп тұрған сияқты
Dialogue: 0,0:08:26.00,0:08:27.57,jp.sub-ja,,0,0,0,,Ханинозука-сенпай күткендей
Dialogue: 0,0:08:27.82,0:08:31.03,jp.sub-ja,,0,0,0,,Шота түрінің мәртебесіне соңғы рет қауіп төнген сияқты.
Dialogue: 0,0:08:28.94,0:08:30.94,Style1,,0,0,0,,оның соңғы эпизодтағы кішкентай бала түрі ретінде,
Dialogue: 0,0:08:30.94,0:08:33.28,Style1,,0,0,0,,сондықтан ол өзін нығайту үшін қадамдар жасап жатқан сияқты.
Dialogue: 0,0:08:31.03,0:08:33.13,jp.sub-ja,,0,0,0,,Оны күшейту шараларын қолданып жатқан сияқты.
Dialogue: 0,0:08:33.13,0:08:36.51,jp.sub-ja,,0,0,0,,Мен оны қарап шықтым. Ол өте терең.
Dialogue: 0,0:08:33.28,0:08:36.61,Style1,,0,0,0,,Мен оған көбірек құрмет көрсетуім керек. Ол өте терең.
Dialogue: 0,0:08:36.61,0:08:38.71,Style1,,0,0,0,,Мына жерге қараңдар, бәрің!
Dialogue: 0,0:08:36.74,0:08:38.06,jp.sub-ja,,0,0,0,,Қараңдар, қараңдар, бәрің.
Dialogue: 0,0:08:40.62,0:08:43.61,Style2,,0,0,0,,«Ағысқа қарсы жылдам жүзу...»
Dialogue: 0,0:08:40.62,0:08:43.62,Style1,,0,0,0,,Қараңдар! Көрдіңіз бе? Қанша жүзсек те,
Dialogue: 0,0:08:42.47,0:08:46.14,jp.sub-ja,,0,0,0,,Мен сонша жүзіп жүрсем де, бір жерден мүлде алға жылжи алмаймын.
Dialogue: 0,0:08:43.62,0:08:47.12,Style1,,0,0,0,,біз ешқашан бір жерден алға жылжымаймыз!
Dialogue: 0,0:08:47.12,0:08:52.62,Style2,,0,0,0,,«Анықтау мүмкін емес».
Dialogue: 0,0:08:48.96,0:08:50.29,Style1,,0,0,0,,Сонымен, қандай мәміле бар?
Dialogue: 0,0:08:49.04,0:08:50.49,jp.sub-ja,,0,0,0,,Сонымен не?
Dialogue: 0,0:08:50.29,0:08:52.63,Style1,,0,0,0,,Бұл жігіт шынымен де соншалықты терең ме?
Dialogue: 0,0:08:50.70,0:08:52.47,jp.sub-ja,,0,0,0,,Бұл адам терең ме?
Dialogue: 0,0:08:55.97,0:08:56.97,Style1,,0,0,0,,Бұқалар!
Dialogue: 0,0:08:55.97,0:08:57.08,jp.sub-ja,,0,0,0,,Соғу
Dialogue: 0,0:08:56.97,0:08:59.64,Style1,,0,0,0,,Мырза, ойнайық! Су мылтығымен шайқас!
Dialogue: 0,0:08:57.08,0:08:59.71,jp.sub-ja,,0,0,0,,Мырза, су мылтығымен шайқас ойнайық
Dialogue: 0,0:08:59.64,0:09:01.97,Style1,,0,0,0,,Мен және Каору сізге қарсы командада, сэр.
Dialogue: 0,0:08:59.78,0:09:01.81,jp.sub-ja,,0,0,0,,Мен және Каору командасы Тоноға қарсы.
Dialogue: 0,0:09:01.97,0:09:04.31,Style1,,0,0,0,,Егер сіз оны бетке алсаңыз, сіз ұтыласыз және пенальти ойыны бар.
Dialogue: 0,0:09:02.10,0:09:04.18,jp.sub-ja,,0,0,0,,Бетке ұрса, ұтыласың. Жазалау ойыны
Dialogue: 0,0:09:04.31,0:09:09.65,Style1,,0,0,0,,Хмф, бұл бала ойынымен кім бірге ойнағысы келеді?
Dialogue: 0,0:09:05.37,0:09:08.15,jp.sub-ja,,0,0,0,,Мұндай бала ойынына кім барады?
Dialogue: 0,0:09:09.65,0:09:12.32,Style1,,0,0,0,,Харухи, дәл қазір үйленейік.
Dialogue: 0,0:09:09.95,0:09:12.33,jp.sub-ja,,0,0,0,,Харухи, қазір үйленейік
Dialogue: 0,0:09:12.32,0:09:14.72,Style1,,0,0,0,,Біздің бал айын Атамиде өткіземіз!
Dialogue: 0,0:09:12.33,0:09:14.29,jp.sub-ja,,0,0,0,,Атамидегі бал айы
Dialogue: 0,0:09:15.42,0:09:19.88,Style2,,0,0,0,,"Сорғы!"
Dialogue: 0,0:09:17.32,0:09:22.66,Style1,,0,0,0,,Қымбатты Харухидің сендерге үйленуге рұқсат беретіні бар деп ойлайсыңдар!?
Dialogue: 0,0:09:17.41,0:09:21.29,jp.sub-ja,,0,0,0,,Сүйкімді Харухиді кім сіздің әйеліңізге айналдырады?
Dialogue: 0,0:09:22.60,0:09:24.56,jp.sub-ja,,0,0,0,,Әкесі кешірмейді
Dialogue: 0,0:09:22.66,0:09:24.99,Style1,,0,0,0,,Әкем рұқсат бермейді!
Dialogue: 0,0:09:36.57,0:09:39.51,Style2,,0,0,0,,«Ағымдағы бассейнге қарсы жүзу»
Dialogue: 0,0:09:39.51,0:09:41.67,Style2,,0,0,0,,«Мен мұны өзім жасай аламын» әдісі
Dialogue: 0,0:09:41.68,0:09:44.95,Style1,,0,0,0,,Үзіліс жасайсыз ба? Бірдеңе ішу керек пе?
Dialogue: 0,0:09:41.81,0:09:44.63,jp.sub-ja,,0,0,0,,Сіз үзіліс жасайсыз ба? Мен мұны ішемін.
Dialogue: 0,0:09:44.95,0:09:46.28,Style1,,0,0,0,,Оқу, оқу
Dialogue: 0,0:09:48.95,0:09:50.29,Style1,,0,0,0,,Мынаны ал!
Dialogue: 0,0:09:49.25,0:09:53.02,jp.sub-ja,,0,0,0,,Арнайы көлденең ұшатын сәулені өлтіріңіз
Dialogue: 0,0:09:50.29,0:09:53.59,Style1,,0,0,0,,Бүйірден секіретін сәулені сенімді түрде бұраңыз!!
Dialogue: 0,0:09:54.96,0:09:56.69,Style1,,0,0,0,,Бұл ережелерге қайшы келеді!
Dialogue: 0,0:09:55.23,0:09:56.38,jp.sub-ja,,0,0,0,,Қылмыстық құқық бұзушылық
Dialogue: 0,0:10:25.66,0:10:28.18,Style1,,0,0,0,,- Бал сенпай! - Мицукуни!
Dialogue: 0,0:10:25.95,0:10:26.95,jp.sub-ja,,0,0,0,,Бал-сенпай
Dialogue: 0,0:10:26.95,0:10:28.00,jp.sub-ja,,0,0,0,,Мицукуни
Dialogue: 0,0:10:38.00,0:10:39.99,Style1,,0,0,0,,Мори-сенпай...
Dialogue: 0,0:10:38.36,0:10:39.44,jp.sub-ja,,0,0,0,,Мори Сенпай
Dialogue: 0,0:10:41.00,0:10:44.94,Style1,,0,0,0,,Балалар, біз Бал сенпайдың артынан барамыз!
Dialogue: 0,0:10:41.41,0:10:44.09,jp.sub-ja,,0,0,0,,Бәріміз Бал-сенпайдың соңынан қуайық.
Dialogue: 0,0:10:44.94,0:10:47.61,Style1,,0,0,0,,Бұл бассейн ең қысқа жол!
Dialogue: 0,0:10:45.26,0:10:47.24,jp.sub-ja,,0,0,0,,Бұл пул таңбаша болып табылады.
Dialogue: 0,0:10:47.61,0:10:49.61,Style1,,0,0,0,,Зарядтау!
Dialogue: 0,0:10:47.71,0:10:49.00,jp.sub-ja,,0,0,0,,Шабуыл
Dialogue: 0,0:10:49.61,0:10:51.77,Style1,,0,0,0,,О, бұл жолы...
Dialogue: 0,0:10:49.86,0:10:51.62,jp.sub-ja,,0,0,0,,Әй, анау.
Dialogue: 0,0:10:54.95,0:10:57.72,jp.sub-ja,,0,0,0,,Қолтырауын жүзіп жүр
Dialogue: 0,0:10:55.28,0:10:57.95,Style1,,0,0,0,,Ол жерде аллигаторлар жүзіп жүр!
Dialogue: 0,0:10:57.95,0:11:00.09,Style1,,0,0,0,,Жарайды, бұл бассейн бітті.
Dialogue: 0,0:10:58.94,0:11:01.98,jp.sub-ja,,0,0,0,,Бұл бассейн жақсы емес. Осы жолмен жүрейік.
Dialogue: 0,0:11:00.09,0:11:02.42,Style1,,0,0,0,,Осы жолмен жүрейік!
Dialogue: 0,0:11:03.96,0:11:05.29,Style1,,0,0,0,,Олар да осында!
Dialogue: 0,0:11:04.04,0:11:05.27,jp.sub-ja,,0,0,0,,Бұл да
Dialogue: 0,0:11:05.29,0:11:06.66,Style1,,0,0,0,,Мұнда да!
Dialogue: 0,0:11:05.49,0:11:06.71,jp.sub-ja,,0,0,0,,Бұл да
Dialogue: 0,0:11:09.97,0:11:11.97,Style1,,0,0,0,,Неліктен мұнда аллигаторлар бар?
Dialogue: 0,0:11:10.07,0:11:11.50,jp.sub-ja,,0,0,0,,Неліктен қолтырауын?
Dialogue: 0,0:11:11.97,0:11:13.30,Style1,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:11:12.06,0:11:13.00,jp.sub-ja,,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:13.30,0:11:16.64,Style1,,0,0,0,,Бұл бассейндер тропиктік жануарлар аймағы.
Dialogue: 0,0:11:13.66,0:11:16.72,jp.sub-ja,,0,0,0,,Бұл бассейн тропикалық жануарлар аймағы.
Dialogue: 0,0:11:16.64,0:11:19.31,Style1,,0,0,0,,Менің ойымша, аллигаторлардың бос жүруіне жол беру қауіпті.
Dialogue: 0,0:11:16.94,0:11:19.41,jp.sub-ja,,0,0,0,,Қолтырауындардың еркін жүруіне жол беру қауіпті ме?
Dialogue: 0,0:11:19.31,0:11:24.31,Style1,,0,0,0,,Бұл жерде мәселе ағымдағы пулдың ауыстырып-қосқыш орны болса да.
Dialogue: 0,0:11:19.41,0:11:24.23,jp.sub-ja,,0,0,0,,Ағынды су бассейніне арналған қосқыштың орны қиынырақ.
Dialogue: 0,0:11:24.31,0:11:26.65,Style1,,0,0,0,,Мен дизайнерлермен сөйлесуім керек.
Dialogue: 0,0:11:24.42,0:11:26.18,jp.sub-ja,,0,0,0,,Жобалау бөліміне хабарлау керек
Dialogue: 0,0:11:26.65,0:11:29.99,Style1,,0,0,0,,Мен сізге алғыс айтуым керек. Мен мұнда жақсы деректер алдым.
Dialogue: 0,0:11:26.81,0:11:29.74,jp.sub-ja,,0,0,0,,Рахмет. Жақсы деректер алынды.
Dialogue: 0,0:11:29.74,0:11:31.09,jp.sub-ja,,0,0,0,,Не
Dialogue: 0,0:11:29.99,0:11:31.58,Style1,,0,0,0,,Не үшін!?
Dialogue: 0,0:11:30.32,0:11:31.58,Style2,,0,0,0,,«Гвинея шошқалары?»
Dialogue: 0,0:11:32.32,0:11:35.99,Style1,,0,0,0,,Бұл Tropical Aqua Garden аймағының картасы.
Dialogue: 0,0:11:32.56,0:11:35.59,jp.sub-ja,,0,0,0,,Бұл тропикалық аква бақтың аумақтық картасы.
Dialogue: 0,0:11:35.99,0:11:38.33,Style1,,0,0,0,,Бұл біздің қазіргі орналасқан жеріміз.
Dialogue: 0,0:11:36.32,0:11:38.10,jp.sub-ja,,0,0,0,,Міне, біз осындамыз
Dialogue: 0,0:11:38.33,0:11:43.60,Style1,,0,0,0,,Менің болжауымша, Балсенпай бұл жерге жету үшін,
Dialogue: 0,0:11:38.47,0:11:41.60,jp.sub-ja,,0,0,0,,Ал Бал сенпайды шайып кеткен болар деп болжалады.
Dialogue: 0,0:11:41.60,0:11:43.22,jp.sub-ja,,0,0,0,,Осы нүктеге жету үшін
Dialogue: 0,0:11:43.60,0:11:47.27,Style1,,0,0,0,,бізге оңтүстік блоктағы джунгли аймағынан өту керек.
Dialogue: 0,0:11:43.66,0:11:46.51,jp.sub-ja,,0,0,0,,Оңтүстік блоктағы джунгли аймағынан өту керек.
Dialogue: 0,0:11:47.27,0:11:50.27,Style1,,0,0,0,,Бұл шамамен 800 метр қашықтық.
Dialogue: 0,0:11:47.36,0:11:49.92,jp.sub-ja,,0,0,0,,Шамамен 800 метр қашықтықта
Dialogue: 0,0:11:50.27,0:11:53.08,Style1,,0,0,0,,Анықталмаған аймақтар көп сияқты
Dialogue: 0,0:11:50.61,0:11:52.71,jp.sub-ja,,0,0,0,,Бұл джунгли аймағы қандай?
Dialogue: 0,0:11:53.08,0:11:55.95,Style1,,0,0,0,,біздің жолымыздағы осы джунглиде.
Dialogue: 0,0:11:53.10,0:11:55.73,jp.sub-ja,,0,0,0,,Жол бойында түсініксіз жерлер көп.
Dialogue: 0,0:11:55.95,0:11:58.28,Style1,,0,0,0,,Бұл әлі әзірлену үстіндегі аймақтар.
Dialogue: 0,0:11:56.08,0:11:58.16,jp.sub-ja,,0,0,0,,Бұл әлі дамушы аймақ.
Dialogue: 0,0:11:58.28,0:12:00.62,Style1,,0,0,0,,Онда бұдан да қауіпті нәрселер болуы мүмкін...
Dialogue: 0,0:11:58.32,0:12:00.69,jp.sub-ja,,0,0,0,,Қолтырауыннан қауіпті нәрсе бар ма?
Dialogue: 0,0:12:00.62,0:12:03.29,Style1,,0,0,0,,...аллигаторларға қарағанда.
Dialogue: 0,0:12:00.69,0:12:01.86,jp.sub-ja,,0,0,0,,Жақсы көрінеді, солай ма?
Dialogue: 0,0:12:03.29,0:12:06.29,Style1,,0,0,0,,Жарайды, бұл аман қалу миссиясы!
Dialogue: 0,0:12:03.36,0:12:05.72,jp.sub-ja,,0,0,0,,Жарайды, бұл аман қалу стратегиясы.
Dialogue: 0,0:12:06.29,0:12:09.13,Style1,,0,0,0,,Біз бұл джунгли аймағына қауіпсіз енуіміз керек,
Dialogue: 0,0:12:06.41,0:12:09.06,jp.sub-ja,,0,0,0,,Біз бұл джунгли аймағын сәтті тазаладық.
Dialogue: 0,0:12:09.13,0:12:11.92,Style1,,0,0,0,,және Бал-сенпайды құтқар!
Dialogue: 0,0:12:09.47,0:12:12.06,jp.sub-ja,,0,0,0,,Бал-сенпайды құтқару керек
Dialogue: 0,0:12:26.98,0:12:30.65,Style1,,0,0,0,,Бұл жерде нағыз джунглиге айналды.
Dialogue: 0,0:12:27.28,0:12:30.08,jp.sub-ja,,0,0,0,,Бұл қазір нағыз джунгли дерлік.
Dialogue: 0,0:12:30.65,0:12:34.32,Style1,,0,0,0,,Мен жануарлардың оғаш қоңырауларын көп естідім.
Dialogue: 0,0:12:30.88,0:12:34.15,jp.sub-ja,,0,0,0,,көп
Dialogue: 0,0:12:34.32,0:12:36.65,Style1,,0,0,0,,Мына жануарлардың дауыстары...
Dialogue: 0,0:12:36.65,0:12:40.32,Style1,,0,0,0,,...шынайы нәрсе болуы мүмкін емес еді, солай ма?
Dialogue: 0,0:12:37.01,0:12:38.87,jp.sub-ja,,0,0,0,,Бұл нақты емес.
Dialogue: 0,0:12:40.32,0:12:43.59,Style1,,0,0,0,,Мен тым сенімді емеспін. Біздің барлық жұмысымызда,
Dialogue: 0,0:12:40.46,0:12:41.84,jp.sub-ja,,0,0,0,,Қалай болды?
Dialogue: 0,0:12:42.09,0:12:45.50,jp.sub-ja,,0,0,0,,Біз қандай жұмыс жасасақ та, бізге нақты іс ұнайды.
Dialogue: 0,0:12:43.59,0:12:46.12,Style1,,0,0,0,,біз шынайылыққа бағдарланамыз.
Dialogue: 0,0:12:47.93,0:12:51.80,Style1,,0,0,0,,Әдеттегідей, Мори-сенпай покермен айналысады,
Dialogue: 0,0:12:48.23,0:12:53.34,jp.sub-ja,,0,0,0,,Әдеттегідей Мори-сенпай сөзсіз, мен оның не ойлағанын білмеймін.
Dialogue: 0,0:12:51.80,0:12:53.94,Style1,,0,0,0,,мен оның не ойлағанын айта алмаймын,
Dialogue: 0,0:12:53.94,0:12:57.46,Style1,,0,0,0,,, бірақ ол сабырлы болып көрінсе де, мұндай кездер-
Dialogue: 0,0:12:54.13,0:12:56.95,jp.sub-ja,,0,0,0,,Сіз сабырлы болып көрінсеңіз де, кейде осындай
Dialogue: 0,0:13:01.28,0:13:02.95,Style1,,0,0,0,,Мори-сенпай...
Dialogue: 0,0:13:01.53,0:13:02.73,jp.sub-ja,,0,0,0,,Мори-сенпай
Dialogue: 0,0:13:02.95,0:13:05.28,Style1,,0,0,0,,...сіз сияқты ебедейсіз әрекет етеді, сэр.
Dialogue: 0,0:13:03.07,0:13:05.30,jp.sub-ja,,0,0,0,,Сіз лорд сияқты ебедейсіз.
Dialogue: 0,0:13:05.28,0:13:06.68,Style1,,0,0,0,,Не!?
Dialogue: 0,0:13:05.46,0:13:06.16,jp.sub-ja,,0,0,0,,Не
Dialogue: 0,0:13:07.95,0:13:11.22,Style1,,0,0,0,,Әрине, ол қатты алаңдайды.
Dialogue: 0,0:13:08.32,0:13:10.67,jp.sub-ja,,0,0,0,,Мен қатты уайымдап тұрмын.
Dialogue: 0,0:13:12.96,0:13:15.92,Style1,,0,0,0,,Ой, дүлей уақыт болуы керек.
Dialogue: 0,0:13:13.14,0:13:15.29,jp.sub-ja,,0,0,0,,Ой, қараңғы уақыт?
Dialogue: 0,0:13:21.96,0:13:26.64,Style1,,0,0,0,,Морисенпай Балсенпайға өте жақын, солай емес пе?
Dialogue: 0,0:13:22.05,0:13:26.51,jp.sub-ja,,0,0,0,,Мори-сенпай мен Бал-сенпай өте жақын, солай емес пе?
Dialogue: 0,0:13:26.64,0:13:28.64,Style1,,0,0,0,,Олар балалық шақтағы достар ма, әлде бір нәрсе ме?
Dialogue: 0,0:13:26.88,0:13:28.39,jp.sub-ja,,0,0,0,,Сіз бала кезден доссыз ба?
Dialogue: 0,0:13:28.64,0:13:29.97,Style1,,0,0,0,,Сол екеуі...
Dialogue: 0,0:13:28.89,0:13:29.95,jp.sub-ja,,0,0,0,,Сол екеуі
Dialogue: 0,0:13:29.97,0:13:30.97,Style1,,0,0,0,,...құдалар.
Dialogue: 0,0:13:30.17,0:13:30.97,jp.sub-ja,,0,0,0,,Ол менің немере ағам.
Dialogue: 0,0:13:30.97,0:13:33.64,Style1,,0,0,0,,Иә? Олар туыстар ма?
Dialogue: 0,0:13:32.13,0:13:33.50,jp.sub-ja,,0,0,0,,Сіз туыс болдыңыз ба?
Dialogue: 0,0:13:33.64,0:13:35.41,Style1,,0,0,0,,Моринозуктар қызмет етті
Dialogue: 0,0:13:33.81,0:13:37.57,jp.sub-ja,,0,0,0,,Харунозука – Ханинозукаға ұрпақтар бойы қызмет еткен отбасы.
Dialogue: 0,0:13:35.41,0:13:38.24,Style1,,0,0,0,,ұрпақтар үшін Ханинозука отбасы.
Dialogue: 0,0:13:39.98,0:13:44.11,Style2,,0,0,0,,«Харухидің қиялы»
Dialogue: 0,0:13:39.98,0:13:44.59,Style1,,0,0,0,,Екі ұрпақ бұрын неке арқылы туысқан болғанымен,
Dialogue: 0,0:13:40.22,0:13:44.03,jp.sub-ja,,0,0,0,,Өйткені олар екі ұрпақ бұрын неке арқылы туысқан.
Dialogue: 0,0:13:44.59,0:13:48.59,Style1,,0,0,0,,және жанұялардың қожайын мен қызметші қарым-қатынасы әлдеқашан жойылды.
Dialogue: 0,0:13:44.69,0:13:48.27,jp.sub-ja,,0,0,0,,Үй шаруашылығындағы қожайын мен қызметші қарым-қатынасы әлдеқашан әлсіреген болуы керек еді.
Dialogue: 0,0:13:48.59,0:13:53.93,Style1,,0,0,0,,Соған қарамастан Мөрісенпай әрқашан Балсенпайға еріп жүретін.
Dialogue: 0,0:13:48.94,0:13:53.40,jp.sub-ja,,0,0,0,,Сонда да Мори-сенпай әрқашан Бал-сенпайдың соңынан ереді, солай ма?
Dialogue: 0,0:13:53.93,0:13:56.93,Style1,,0,0,0,,Бұл оның қанын жіберуі керек.
Dialogue: 0,0:13:54.19,0:13:56.27,jp.sub-ja,,0,0,0,,Менің ойымша, бұл сіздің қаныңызды қайнатады.
Dialogue: 0,0:13:56.93,0:14:01.60,Style1,,0,0,0,,Мөрі-сенпай арқылы ағатын баяғыдағы вассалдардың қаны.
Dialogue: 0,0:13:57.09,0:14:01.20,jp.sub-ja,,0,0,0,,Мори-сенпайда бағзы заманнан вассалдың қаны ағып келеді.
Dialogue: 0,0:14:01.60,0:14:03.94,Style1,,0,0,0,,Қандай тамаша оқиға! Мен әсер алдым!
Dialogue: 0,0:14:01.69,0:14:04.25,jp.sub-ja,,0,0,0,,Бұл жақсы әңгіме. Мен әсер алдым.
Dialogue: 0,0:14:03.94,0:14:07.43,Style1,,0,0,0,,Міне, сіз керемет әңгіме дейсіз бе?
Dialogue: 0,0:14:04.25,0:14:06.75,jp.sub-ja,,0,0,0,,Бұл жақсы әңгіме ме?
Dialogue: 0,0:14:08.94,0:14:13.95,Style1,,0,0,0,,Мен оның қанының ағып жатқанын түсінетінімді білмеймін,
Dialogue: 0,0:14:09.15,0:14:12.38,jp.sub-ja,,0,0,0,,Қанның қайнап тұрғанын түсінбеймін.
Dialogue: 0,0:14:13.95,0:14:18.98,Style1,,0,0,0,,бірақ ол Бал сенпайды қатты ойлайды, иә?
Dialogue: 0,0:14:14.31,0:14:18.39,jp.sub-ja,,0,0,0,,Сіз Бал-сенпайға қатты көңіл бөлесіз.
Dialogue: 0,0:14:20.87,0:14:26.05,jp.sub-ja,,0,0,0,,Мори-сенпай, жарайды. Бал-сенпай қауіпсіз.
Dialogue: 0,0:14:20.96,0:14:24.29,Style1,,0,0,0,,Мори-сенпай, бәрі жақсы болады.
Dialogue: 0,0:14:24.29,0:14:26.30,Style1,,0,0,0,,Бал-сенпай қауіпсіз.
Dialogue: 0,0:14:26.30,0:14:28.63,Style1,,0,0,0,,Ол сіз ойлағаннан да қатал,
Dialogue: 0,0:14:26.79,0:14:28.62,jp.sub-ja,,0,0,0,,Бұл таңғаларлық төзімді болып көрінеді.
Dialogue: 0,0:14:28.63,0:14:31.97,Style1,,0,0,0,,ал аш болса, ағаштарда банан көп.
Dialogue: 0,0:14:28.82,0:14:31.25,jp.sub-ja,,0,0,0,,Аш болсаң, банан да көп.
Dialogue: 0,0:14:31.97,0:14:34.37,Style1,,0,0,0,,- Әй, енді... - Бұған ол қалай жауап бермек?
Dialogue: 0,0:14:32.82,0:14:34.03,jp.sub-ja,,0,0,0,,Бұл іздің қандай түрі?
Dialogue: 0,0:14:36.64,0:14:38.04,Style1,,0,0,0,,Оқу, оқу
Dialogue: 0,0:14:39.31,0:14:42.98,Style1,,0,0,0,,Д-айтпа, Морисенпай да Харухидің әкесі ретінде менің орныма келеді!
Dialogue: 0,0:14:39.62,0:14:43.02,jp.sub-ja,,0,0,0,,Мен Мори-сенпай да Харухидің әкесі болады деп ойламадым.
Dialogue: 0,0:14:42.61,0:14:47.24,Style2,,0,0,0,,«Пит-а-пат...»
Dialogue: 0,0:14:42.98,0:14:45.25,Style1,,0,0,0,,Жоқ, одан кейін ешкім жоқ.
Dialogue: 0,0:14:43.34,0:14:45.33,jp.sub-ja,,0,0,0,,Жоқ, мен ешкімді нысанаға алып отырған жоқпын.
Dialogue: 0,0:14:45.25,0:14:47.25,Style1,,0,0,0,,Бұл ақымақ қайын жұрты емес.
Dialogue: 0,0:14:45.47,0:14:47.31,jp.sub-ja,,0,0,0,,Осындай ақымақ ененің позициясы
Dialogue: 0,0:14:47.25,0:14:48.58,Style1,,0,0,0,,Сен кімді ақымақ қайынсіңлі дейсің!?
Dialogue: 0,0:14:47.52,0:14:49.29,jp.sub-ja,,0,0,0,,Кішкентай ақымақ қайын ене кім?
Dialogue: 0,0:14:48.58,0:14:49.25,Style1,,0,0,0,,Иә,
Dialogue: 0,0:14:48.76,0:14:49.96,jp.sub-ja,,0,0,0,,О, менмін.
Dialogue: 0,0:14:49.25,0:14:50.92,Style1,,0,0,0,,- бұл менмін - Ньях! Ақымақ қайын жұрт!
Dialogue: 0,0:14:50.16,0:14:51.31,jp.sub-ja,,0,0,0,,(Кішкентай ақымақ ене)
Dialogue: 0,0:14:50.84,0:14:53.34,jp.sub-ja,,0,0,0,,Жоқ, бұл біраз күрделі жағдай.
Dialogue: 0,0:14:50.92,0:14:52.25,Style1,,0,0,0,,- Ой, бізде біраз мазасыз жағдай болды - Сіз мені не деп атадыңыз!?
Dialogue: 0,0:14:51.46,0:14:52.31,jp.sub-ja,,0,0,0,,(Не?)
Dialogue: 0,0:14:52.25,0:14:54.75,Style1,,0,0,0,,- О, бізде біраз алаңдатарлық жағдай болды - Нях! Ақымақ қайын жұрт!
Dialogue: 0,0:14:53.36,0:14:53.64,jp.sub-ja,,0,0,0,,(Кішкентай ақымақ ене)
Dialogue: 0,0:15:00.93,0:15:03.63,Style1,,0,0,0,,Мори-сенпай, олай емес.
Dialogue: 0,0:15:01.20,0:15:03.59,jp.sub-ja,,0,0,0,,Мори-сенпай, олай емес.
Dialogue: 0,0:15:03.63,0:15:07.27,Style1,,0,0,0,,Бал-сенпай басқа бағытта.
Dialogue: 0,0:15:03.99,0:15:06.36,jp.sub-ja,,0,0,0,,Бал-сенпай ар жағында.
Dialogue: 0,0:15:07.27,0:15:08.94,Style1,,0,0,0,,Жоқ, ол осылай.
Dialogue: 0,0:15:07.43,0:15:08.95,jp.sub-ja,,0,0,0,,Жоқ, мен осындамын.
Dialogue: 0,0:15:08.94,0:15:11.27,Style2,,0,0,0,,«Табиғи инстинкт»
Dialogue: 0,0:15:11.27,0:15:14.61,Style1,,0,0,0,,Бір минут! Жалғыз жүру тым қауіпті!
Dialogue: 0,0:15:11.41,0:15:14.00,jp.sub-ja,,0,0,0,,Бір минут күтіңіз, жалғыз болу қауіпті.
Dialogue: 0,0:15:14.61,0:15:16.67,Style1,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:15:14.67,0:15:16.37,jp.sub-ja,,0,0,0,,Мен сенімен барамын.
Dialogue: 0,0:15:21.95,0:15:23.48,Style1,,0,0,0,,Харухи...
Dialogue: 0,0:15:22.30,0:15:22.70,jp.sub-ja,,0,0,0,,Харухи
Dialogue: 0,0:15:27.96,0:15:30.96,Style1,,0,0,0,,Ол мені бірінші рет атымен атады.
Dialogue: 0,0:15:28.08,0:15:30.40,jp.sub-ja,,0,0,0,,Бірінші рет атымен аталу
Dialogue: 0,0:15:30.96,0:15:32.39,Style2,,0,0,0,,«Кішкене ризамын»
Dialogue: 0,0:15:30.96,0:15:32.39,Style1,,0,0,0,,«Кішкене ризамын»
Dialogue: 0,0:15:33.63,0:15:35.97,Style1,,0,0,0,,Иә, жақсы, бірден, өтінемін.
Dialogue: 0,0:15:33.87,0:15:35.93,jp.sub-ja,,0,0,0,,Аа, маған тездету керек.
Dialogue: 0,0:15:35.93,0:15:37.67,jp.sub-ja,,0,0,0,,(ақымақ кішкентай қайын енесі, ақымақ кішкентай қайын енесі)
Dialogue: 0,0:15:35.97,0:15:37.97,Style1,,0,0,0,,- Ақымақ қайын жұрт! Ақымақ қайын жұрт! - Ауызыңды жап!
Dialogue: 0,0:15:37.71,0:15:38.90,jp.sub-ja,,0,0,0,,
Dialogue: 0,0:15:37.96,0:15:41.96,jp.sub-ja,,0,0,0,,Менің жеке полициям іздеу тобын жібереді деп естідім.
Dialogue: 0,0:15:37.97,0:15:42.30,Style1,,0,0,0,,- Менің отбасымның жеке полициясы іздеу тобын жібермекші. - Ақымақ қайын жұрт! Ақымақ қайын жұрт! - Тыныш, дедім!
Dialogue: 0,0:15:40.00,0:15:41.36,jp.sub-ja,,0,0,0,,
Dialogue: 0,0:15:41.96,0:15:44.46,jp.sub-ja,,0,0,0,,(ақымақ кішкентай қайын ене, ақымақ кішкентай қайын ене)
Dialogue: 0,0:15:42.30,0:15:44.91,Style1,,0,0,0,,- Бізге қарағанда олар оны табуға жақсырақ. - Ақымақ қайын жұрт! Ақымақ қайын жұрт! - Ауызыңды жап!
Dialogue: 0,0:15:42.44,0:15:44.51,jp.sub-ja,,0,0,0,,Бұл біз іздегеннен гөрі дәлірек болуы мүмкін.
Dialogue: 0,0:15:44.46,0:15:45.48,jp.sub-ja,,0,0,0,,(ақымақ кішкентай ене, ақымақ кішкентай ене)
Dialogue: 0,0:15:44.89,0:15:46.70,jp.sub-ja,,0,0,0,,Қақпаға оралыңыз және күтіңіз.
Dialogue: 0,0:15:44.91,0:15:47.58,Style1,,0,0,0,,- Қақпаға қайтып, күтейік. - Ақымақ қайын жұрт! Ақымақ қайын жұрт! - Ауызыңды жап!
Dialogue: 0,0:15:45.51,0:15:46.17,jp.sub-ja,,0,0,0,,
Dialogue: 0,0:15:46.34,0:15:47.85,jp.sub-ja,,0,0,0,,(ақымақ кішкентай қайын енесі, ақымақ кішкентай қайын енесі)
Dialogue: 0,0:15:47.58,0:15:49.91,Style1,,0,0,0,,Неше рет айтасың!?
Dialogue: 0,0:15:47.88,0:15:48.61,jp.sub-ja,,0,0,0,,(Неге қайта-қайта айтасыз?)
Dialogue: 0,0:15:49.91,0:15:52.81,Style1,,0,0,0,,Эй, Мори-сенпай мен Харухи қайда?
Dialogue: 0,0:15:50.29,0:15:52.14,jp.sub-ja,,0,0,0,,Эй, Мори-сенпай мен Харухи
Dialogue: 0,0:15:55.92,0:15:58.52,Style2,,0,0,0,,«Тропикалық аква бақшасының бас әкімшілігінің штаб-пәтері»
Dialogue: 0,0:15:58.52,0:16:02.25,Style2,,0,0,0,,«Отори отбасылық жеке полициясы»
Dialogue: 0,0:15:59.17,0:16:02.04,jp.sub-ja,,0,0,0,,Төтенше жағдайды жөнелтуге тапсырыс
Dialogue: 0,0:15:59.26,0:16:02.26,Style1,,0,0,0,,Төтенше жұмылдыру тәртібі. Төтенше жұмылдыру тәртібі.
Dialogue: 0,0:16:02.26,0:16:05.59,Style1,,0,0,0,,Кёя-саманың досы қазіргі бассейннің жанында жоғалып кетті.
Dialogue: 0,0:16:02.35,0:16:05.72,jp.sub-ja,,0,0,0,,Кёя-саманың досы ағып жатқан су бассейнінің жанында жоғалып кетті
Dialogue: 0,0:16:05.59,0:16:07.93,Style1,,0,0,0,,Іздеу нысанасы – кішкентай жас жігіт.
Dialogue: 0,0:16:05.72,0:16:07.94,jp.sub-ja,,0,0,0,,Іздеу нысанасы - кішкентай бала.
Dialogue: 0,0:16:07.93,0:16:11.93,Style1,,0,0,0,,Қайталау, іздеу нысанасы – кішкентай жас жігіт.
Dialogue: 0,0:16:08.09,0:16:11.80,jp.sub-ja,,0,0,0,,Қайталанатын іздеу нысанасы – кішкентай бала.
Dialogue: 0,0:16:11.80,0:16:14.90,jp.sub-ja,,0,0,0,,Сонымен қатар, күдікті адамдарды аяусыз жойыңыз.
Dialogue: 0,0:16:11.93,0:16:15.27,Style1,,0,0,0,,Сондай-ақ кез келген күдікті фигураларды аяусыз жойыңыз.
Dialogue: 0,0:16:15.27,0:16:18.40,Style1,,0,0,0,,Кез келген күдікті фигураларды аяусыз жойыңыз.
Dialogue: 0,0:16:15.53,0:16:18.10,jp.sub-ja,,0,0,0,,Күдікті адамдарды аяусыз жою.
Dialogue: 0,0:16:34.62,0:16:36.09,Style1,,0,0,0,,Мақсат расталды.
Dialogue: 0,0:16:34.77,0:16:35.70,jp.sub-ja,,0,0,0,,Мақсатты растау
Dialogue: 0,0:16:36.09,0:16:37.96,Style2,,0,0,0,,«Кішкентай жас жігіт пе?»
Dialogue: 0,0:16:38.96,0:16:41.29,Style2,,0,0,0,,«Күдікті фигура?»
Dialogue: 0,0:16:41.30,0:16:44.57,Style1,,0,0,0,,Нысананы күдікті адам басып алды.
Dialogue: 0,0:16:41.59,0:16:44.36,jp.sub-ja,,0,0,0,,Нысананы күдікті адам тұтқынға алды.
Dialogue: 0,0:16:44.57,0:16:47.24,Style1,,0,0,0,,Қазір субьектіні қамауға алу.
Dialogue: 0,0:16:44.95,0:16:46.57,jp.sub-ja,,0,0,0,,Бұдан былай адам қамауға алынады.
Dialogue: 0,0:16:47.24,0:16:48.40,Style1,,0,0,0,,Енді ойлап қарасам,
Dialogue: 0,0:16:47.36,0:16:51.60,jp.sub-ja,,0,0,0,,Ойланып қарасам, басқа келушілер туралы айтқан жоқпын.
Dialogue: 0,0:16:48.40,0:16:51.97,Style1,,0,0,0,,Мен оларға басқа келушілер бар екенін айтқан жоқпын.
Dialogue: 0,0:16:51.97,0:16:54.24,Style2,,0,0,0,,«Толық адекватты емес түсініктеме»
Dialogue: 0,0:16:52.10,0:16:53.60,jp.sub-ja,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:16:52.24,0:16:53.94,Style1,,0,0,0,,О, жақсы.
Dialogue: 0,0:16:54.24,0:16:57.15,Style1,,0,0,0,,Сен сонда! Жігіт кетсін,
Dialogue: 0,0:16:54.39,0:16:57.08,jp.sub-ja,,0,0,0,,Мына жақтағы жігіт, жіберші мына баланы.
Dialogue: 0,0:16:57.15,0:17:00.58,Style1,,0,0,0,,әйтпесе біз күш қолданамыз!
Dialogue: 0,0:16:57.37,0:16:59.23,jp.sub-ja,,0,0,0,,Әйтпесе, күш қолданылады.
Dialogue: 0,0:17:00.58,0:17:02.74,Style1,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,0:17:01.49,0:17:02.30,jp.sub-ja,,0,0,0,,Біраз
Dialogue: 0,0:17:07.92,0:17:12.26,Style1,,0,0,0,,Ер адам қарсылық көрсетіп жатыр! Ескерту оқтарын атуға дайын!
Dialogue: 0,0:17:08.03,0:17:09.52,jp.sub-ja,,0,0,0,,Бұл адам қарсылық көрсетеді.
Dialogue: 0,0:17:09.75,0:17:11.06,jp.sub-ja,,0,0,0,,Ескерту атуын дайындаңыз
Dialogue: 0,0:17:12.26,0:17:14.70,Style1,,0,0,0,,Такаши, Хару-чан, қозғал!
Dialogue: 0,0:17:12.38,0:17:14.46,jp.sub-ja,,0,0,0,,Такаши Хару-чан, артқа шегін.
Dialogue: 0,0:17:21.94,0:17:23.61,Style1,,0,0,0,,Сіз не істеп жатырсыз деп ойлайсыз, пипсшиак!?
Dialogue: 0,0:17:22.18,0:17:23.54,jp.sub-ja,,0,0,0,,Мына кішкентай бала не істеп жатырсың?
Dialogue: 0,0:17:23.54,0:17:25.16,jp.sub-ja,,0,0,0,,Бұл жігіт маған бәрібір.
Dialogue: 0,0:17:23.61,0:17:25.47,Style1,,0,0,0,,Ештеңе етпейді, мынаны да алыңыз!
Dialogue: 0,0:17:45.56,0:17:48.03,Style1,,0,0,0,,Соншалықты абай болма.
Dialogue: 0,0:17:45.94,0:17:47.95,jp.sub-ja,,0,0,0,,Мен бұдан былай ойланбайтын ештеңе істемеймін.
Dialogue: 0,0:17:48.03,0:17:51.83,Style1,,0,0,0,,Менің достарымды таңдау - жоқ-жоқ.
Dialogue: 0,0:17:48.38,0:17:51.66,jp.sub-ja,,0,0,0,,Достарымды қорласаң, қарғыс аласың.
Dialogue: 0,0:17:51.83,0:17:55.29,Style2,,0,0,0,,«Жоқ-жоқ!»
Dialogue: 0,0:17:53.90,0:17:55.30,Style1,,0,0,0,,Харухи!
Dialogue: 0,0:17:54.28,0:17:57.29,jp.sub-ja,,0,0,0,,Харухи Харухи, жақсысың ба?
Dialogue: 0,0:17:55.57,0:17:57.91,Style1,,0,0,0,,Харухи, бәрі жақсы ма!?
Dialogue: 0,0:17:57.91,0:17:59.58,Style1,,0,0,0,,Әй, Тама-чан!
Dialogue: 0,0:17:58.48,0:17:59.24,jp.sub-ja,,0,0,0,,Тама-чан
Dialogue: 0,0:17:59.58,0:18:01.58,Style1,,0,0,0,,- Иә? -Жаным сенпай!
Dialogue: 0,0:18:00.47,0:18:01.37,jp.sub-ja,,0,0,0,,Бал-сенпай
Dialogue: 0,0:18:01.58,0:18:04.25,Style1,,0,0,0,,Харухи!
Dialogue: 0,0:18:01.74,0:18:03.10,jp.sub-ja,,0,0,0,,Харухи
Dialogue: 0,0:18:04.25,0:18:06.58,Style1,,0,0,0,,Мен сені уайымдадым.
Dialogue: 0,0:18:04.44,0:18:05.51,jp.sub-ja,,0,0,0,,Мен уайымдадым.
Dialogue: 0,0:18:06.58,0:18:09.59,Style1,,0,0,0,,Мұнда не болғанын білмеймін, бірақ олар жақсы сияқты.
Dialogue: 0,0:18:06.64,0:18:09.32,jp.sub-ja,,0,0,0,,Білмеймін, бірақ жақсы сияқты.
Dialogue: 0,0:18:09.59,0:18:12.25,Style1,,0,0,0,,Бұны жасаған Балсенпай еді ғой?
Dialogue: 0,0:18:09.61,0:18:12.09,jp.sub-ja,,0,0,0,,Өйткені Бал-сенпай осылай істеген шығар.
Dialogue: 0,0:18:12.25,0:18:13.92,Style1,,0,0,0,,Сонда ол өзін ұстаған болуы керек.
Dialogue: 0,0:18:12.30,0:18:13.91,jp.sub-ja,,0,0,0,,Егер солай болса, онда сіз жұмсақтық танытасыз.
Dialogue: 0,0:18:13.91,0:18:16.83,jp.sub-ja,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:18:13.92,0:18:16.93,Style1,,0,0,0,,Иә? Мұнымен не айтқың келеді?
Dialogue: 0,0:18:16.93,0:18:19.60,Style1,,0,0,0,,- Иә? - Білмейсің бе?
Dialogue: 0,0:18:17.84,0:18:19.24,jp.sub-ja,,0,0,0,,Сіз білмейсіз
Dialogue: 0,0:18:19.60,0:18:23.93,Style1,,0,0,0,,Ханинозуктар ұрпақтар бойы өздерінің жауынгерлік өнерімен танымал болды.
Dialogue: 0,0:18:19.99,0:18:24.04,jp.sub-ja,,0,0,0,,Ханинозука ұрпақтар бойы атақты жекпе-жек өнерінің отбасы болды.
Dialogue: 0,0:18:22.60,0:18:27.83,Style2,,0,0,0,,«Құрметті отбасы»
Dialogue: 0,0:18:23.93,0:18:25.93,Style1,,0,0,0,,Олар полиция мен SDF-ке ғана нұсқау берді,
Dialogue: 0,0:18:24.37,0:18:26.12,jp.sub-ja,,0,0,0,,Тек полиция және өзін-өзі қорғау күштері ғана емес
Dialogue: 0,0:18:25.93,0:18:28.60,Style1,,0,0,0,,бірақ шетелдегі әскери күштер де.
Dialogue: 0,0:18:26.31,0:18:28.60,jp.sub-ja,,0,0,0,,Шетелдегі әскерилерге де нұсқау береді.
Dialogue: 0,0:18:28.60,0:18:30.24,Style1,,0,0,0,,Атап айтқанда, Бал-сенпай
Dialogue: 0,0:18:28.91,0:18:33.04,jp.sub-ja,,0,0,0,,Атап айтқанда, Ханинозука басынан бері Бал-сенпай ең күшті адам деп айтылады.
Dialogue: 0,0:18:30.24,0:18:33.14,Style1,,0,0,0,,Ханинозука отбасының қорқыныштысы деп аталды,
Dialogue: 0,0:18:33.14,0:18:35.54,Style1,,0,0,0,,бұрыннан бері және ол орта мектепте оқып жүргенде,
Dialogue: 0,0:18:33.76,0:18:38.16,jp.sub-ja,,0,0,0,,Ол орта мектепте оқып жүргенде каратэ мен дзюдодан ел чемпионаттарында жеңіске жеткен.
Dialogue: 0,0:18:35.54,0:18:38.81,Style1,,0,0,0,,ол каратэден де, дзюдодан да ел чемпионы болды.
Dialogue: 0,0:18:38.81,0:18:42.27,Style2,,0,0,0,,«Каратэ және дзюдо чемпионы»
Dialogue: 0,0:18:42.62,0:18:44.95,Style1,,0,0,0,,Айтпақшы, Мори-сенпай да ел чемпионы атанды
Dialogue: 0,0:18:42.89,0:18:47.69,jp.sub-ja,,0,0,0,,Айтпақшы, Мори-сенпай орта мектепте оқып жүргенде кендодан ел чемпионатында да жеңіске жетті.
Dialogue: 0,0:18:44.95,0:18:48.52,Style1,,0,0,0,,кендодан, ол орта мектепте оқып жүргенде.
Dialogue: 0,0:18:48.52,0:18:50.99,Style2,,0,0,0,,«Кендодан ел чемпионы»
Dialogue: 0,0:18:51.29,0:18:54.30,Style1,,0,0,0,,Жаным, сен мұнда не істеп жүрсің?
Dialogue: 0,0:18:51.47,0:18:53.94,jp.sub-ja,,0,0,0,,Бал-сенпай, мұнда неге келдің?
Dialogue: 0,0:18:54.30,0:18:55.53,Style1,,0,0,0,,Сіз не білесіз?
Dialogue: 0,0:18:54.66,0:18:58.29,jp.sub-ja,,0,0,0,,Білесің бе, мен жалқау өзеннің мақсатына жеттім.
Dialogue: 0,0:18:55.53,0:18:58.63,Style1,,0,0,0,,Мен ағымдағы пулдың соңына жеттім,
Dialogue: 0,0:18:58.63,0:19:00.64,Style1,,0,0,0,,сондықтан мен бәрін іздеуге шықтым.
Dialogue: 0,0:18:58.75,0:19:00.32,jp.sub-ja,,0,0,0,,Мен бәрін іздедім.
Dialogue: 0,0:19:00.64,0:19:02.97,Style1,,0,0,0,,Біз кішіпейілділікпен кешірім сұраймыз!
Dialogue: 0,0:19:00.86,0:19:02.18,jp.sub-ja,,0,0,0,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:19:02.97,0:19:05.64,Style1,,0,0,0,,Мен Ишизука Доджоның 2-ші буын оқушысымын!
Dialogue: 0,0:19:03.09,0:19:05.65,jp.sub-ja,,0,0,0,,Мен Ишизука Доджоның екінші ұрпағымын.
Dialogue: 0,0:19:05.64,0:19:08.31,Style1,,0,0,0,,Мен Тодороки Доджоның студентімін!
Dialogue: 0,0:19:05.90,0:19:08.55,jp.sub-ja,,0,0,0,,Мен Тодороки Доджоның студентімін.
Dialogue: 0,0:19:08.31,0:19:11.31,Style1,,0,0,0,,Мен Отаке Доджоданмын! Біз сізге қарыздармыз!
Dialogue: 0,0:19:08.64,0:19:11.11,jp.sub-ja,,0,0,0,,Мен Отаки Доджоданмын. Көмегіңіз үшін рақмет.
Dialogue: 0,0:19:11.31,0:19:12.98,Style1,,0,0,0,,О, солай ма?
Dialogue: 0,0:19:11.70,0:19:13.00,jp.sub-ja,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:19:12.98,0:19:15.65,Style1,,0,0,0,,Иә, сэр! Біз өте өкінеміз! Біз мүлде хабарсыз болдық
Dialogue: 0,0:19:13.10,0:19:14.58,jp.sub-ja,,0,0,0,,Хаха кешіріңіз.
Dialogue: 0,0:19:15.04,0:19:17.90,jp.sub-ja,,0,0,0,,Мен Мицукуни Ханинозуканың кім екенін білмедім.
Dialogue: 0,0:19:15.65,0:19:17.99,Style1,,0,0,0,,біз Ханинозука Мицукуни-саманы іздедік,
Dialogue: 0,0:19:17.99,0:19:19.99,Style1,,0,0,0,,және қорқынышты қылмыс жасадыңыз!
Dialogue: 0,0:19:18.13,0:19:19.92,jp.sub-ja,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:19:19.99,0:19:22.32,Style1,,0,0,0,,Кездейсоқ болса да,
Dialogue: 0,0:19:20.20,0:19:21.89,jp.sub-ja,,0,0,0,,Бірақ тіпті кездейсоқ
Dialogue: 0,0:19:22.32,0:19:24.99,Style1,,0,0,0,,менің дожом сенімен араласқан күніммен мақтанады,
Dialogue: 0,0:19:22.45,0:19:24.97,jp.sub-ja,,0,0,0,,Осы күні мен Мицукуни мырзамен тікелей байланысқа шықтым.
Dialogue: 0,0:19:24.99,0:19:29.00,Style1,,0,0,0,,Мицукуни-сама, жеке, ұрпақтар үшін!
Dialogue: 0,0:19:25.41,0:19:27.98,jp.sub-ja,,0,0,0,,Біз дожомызды соңына дейін мақтан тұтамыз.
Dialogue: 0,0:19:28.60,0:19:32.66,Style2,,0,0,0,,«Терең»
Dialogue: 0,0:19:29.00,0:19:33.00,Style1,,0,0,0,,Ол терең. Бұл тереңнен асып түседі.
Dialogue: 0,0:19:29.21,0:19:32.54,jp.sub-ja,,0,0,0,,Терең, тым терең
Dialogue: 0,0:19:33.00,0:19:34.67,Style1,,0,0,0,,Такаши,
Dialogue: 0,0:19:33.39,0:19:36.98,jp.sub-ja,,0,0,0,,Такаши, сен Хару-чанды жақсы қорғадың.
Dialogue: 0,0:19:34.67,0:19:39.34,Style1,,0,0,0,,сен Хару-чанды өте жақсы қорғадың.
Dialogue: 0,0:19:39.34,0:19:43.95,Style1,,0,0,0,,Менсіз жалғыздық танытпадың, солай ма?
Dialogue: 0,0:19:39.58,0:19:42.06,jp.sub-ja,,0,0,0,,Менсіз де өзіңді жалғыз сезінбедің.
Dialogue: 0,0:19:43.95,0:19:46.44,Style1,,0,0,0,,Мен олай айтпас едім.
Dialogue: 0,0:19:44.09,0:19:45.39,jp.sub-ja,,0,0,0,,Шын мәнінде емес
Dialogue: 0,0:19:57.96,0:20:00.63,Style1,,0,0,0,,Көңіл-күйді көтеру үшін келесі жағаға баруымыз керек.
Dialogue: 0,0:19:58.17,0:20:00.54,jp.sub-ja,,0,0,0,,Келесі жолы сергіту үшін жағаға барайық.
Dialogue: 0,0:20:00.62,0:20:01.58,jp.sub-ja,,0,0,0,,Жақсы теңіз
Dialogue: 0,0:20:00.63,0:20:01.96,Style1,,0,0,0,,Жағажай жақсы болар еді.
Dialogue: 0,0:20:01.96,0:20:06.64,Style1,,0,0,0,,Ей, ақымақтар, Харухи бұған қызықпайтын еді.
Dialogue: 0,0:20:02.02,0:20:05.19,jp.sub-ja,,0,0,0,,Барса Харухи мұндай нәрсеге қызықпайды.
Dialogue: 0,0:20:06.64,0:20:09.97,Style1,,0,0,0,,Мен жағажайға баруға қарсы емеспін.
Dialogue: 0,0:20:06.88,0:20:08.61,jp.sub-ja,,0,0,0,,Мүмкін сіз теңізге барарсыз
Dialogue: 0,0:20:09.97,0:20:13.64,Style1,,0,0,0,,Бұл жасанды орын қызық болмауы мүмкін,
Dialogue: 0,0:20:10.28,0:20:13.49,jp.sub-ja,,0,0,0,,Осындай айқын артефакт мені күлдіреді.
Dialogue: 0,0:20:13.64,0:20:16.65,Style1,,0,0,0,,бірақ жағажай жақсы болар еді. Ол жерде әдемі.
Dialogue: 0,0:20:13.93,0:20:16.42,jp.sub-ja,,0,0,0,,Теңіз тамаша, әдемі.
Dialogue: 0,0:20:16.60,0:20:19.57,jp.sub-ja,,0,0,0,,Жарайды, түсіндім. Келесі - мұхит.
Dialogue: 0,0:20:16.65,0:20:18.31,Style1,,0,0,0,,Жарайды, түсіндің!
Dialogue: 0,0:20:18.31,0:20:20.98,Style1,,0,0,0,,Енді жағажайға барамыз!
Dialogue: 0,0:20:20.98,0:20:24.32,Style1,,0,0,0,,Ол келесіде бәріміз жағажайға барамыз деді.
Dialogue: 0,0:20:21.16,0:20:23.00,jp.sub-ja,,0,0,0,,Келесі жолы бәріміз теңізге барамыз
Dialogue: 0,0:20:24.32,0:20:26.29,Style1,,0,0,0,,Бұл қызық болады, иә?
Dialogue: 0,0:20:24.63,0:20:25.80,jp.sub-ja,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:20:27.66,0:20:28.99,Style1,,0,0,0,,Оқу, оқу
Dialogue: 0,0:20:40.37,0:20:42.37,Style1,,0,0,0,,Неліктен жағажайға келген соң,
Dialogue: 0,0:20:40.84,0:20:44.80,jp.sub-ja,,0,0,0,,Неліктен Харухи екеуміз соғысу үшін мұхитқа дейін жетуіміз керек еді?
Dialogue: 0,0:20:42.37,0:20:44.37,Style1,,0,0,0,,Харухи екеуміз төбелесуіміз керек пе?
Dialogue: 0,0:20:44.37,0:20:47.04,Style1,,0,0,0,,Сенпай, енді менімен сөйлеспейсің деп ойладым.
Dialogue: 0,0:20:44.80,0:20:47.30,jp.sub-ja,,0,0,0,,Сенпай, сен енді менімен сөйлеспейтін шығарсың.
Dialogue: 0,0:20:47.04,0:20:48.04,Style1,,0,0,0,,Харухи!
Dialogue: 0,0:20:47.30,0:20:47.94,jp.sub-ja,,0,0,0,,Харухи
Dialogue: 0,0:20:48.04,0:20:50.38,Style1,,0,0,0,,Келесі жолы «Күн, теңіз және қонақ клуб»
Dialogue: 0,0:20:50.38,0:20:52.88,Style1,,0,0,0,,Сізді келесі аптада Оуран орта мектебінің хост клубы күтеді!
Dialogue: 0,0:20:50.74,0:20:52.88,jp.sub-ja,,0,0,0,,Келесі аптада Оуран орта мектебінің хост клубы
Dialogue: 0,0:20:53.31,0:20:54.76,jp.sub-ja,,0,0,0,,Біз сізді асыға күтеміз
Dialogue: 0,0:20:56.26,0:21:02.26,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
