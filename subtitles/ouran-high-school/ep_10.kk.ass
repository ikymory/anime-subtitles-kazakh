Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:02.80,staff-ja,,0,0,0,,Mam
Dialogue: 0,0:00:00.00,0:00:03.00,staff-ja,,0,0,0,,HARERE
Dialogue: 0,0:00:00.00,0:00:03.00,staff-ja,,0,0,0,,Syura
Dialogue: 0,0:00:00.00,0:00:03.17,staff-ja,,0,0,0,,аударма күміс алма
Dialogue: 0,0:00:00.00,0:00:03.25,staff-ja,,0,0,0,,...
Dialogue: 0,0:00:00.00,0:00:03.25,staff-ja,,0,0,0,,Наксияның әкімшілік жүйесі
Dialogue: 0,0:00:00.00,0:00:03.63,staff-ja,,0,0,0,,OP&ED Hagakure
Dialogue: 0,0:00:00.00,0:00:03.63,staff-ja,,0,0,0,,Сюра
Dialogue: 0,0:00:00.00,0:00:03.88,Default11-ja,,0,0,0,,Құдайдың субтитр жұбы
Dialogue: 0,0:00:04.98,0:00:06.31,Style2,,0,0,0,,«Сәнді кондитерлік өнімдер»
Dialogue: 0,0:00:05.84,0:00:09.35,jp.sub-ja,NTP,0,0,0,,А, бұл мүмкін емес.
Dialogue: 0,0:00:06.31,0:00:07.30,Style2,,0,0,0,,«Фудзиока»
Dialogue: 0,0:00:08.68,0:00:10.48,Style1,,0,0,0,,Бұл мүмкін емес...
Dialogue: 0,0:00:13.69,0:00:17.38,Style1,,0,0,0,,А, бәрің кіріңдер.
Dialogue: 0,0:00:14.58,0:00:16.68,jp.sub-ja,NTP,0,0,0,,Барлығыңызға қош келдіңіздер
Dialogue: 0,0:00:18.69,0:00:22.36,Style1,,0,0,0,,Бұл көп емес, бірақ өзіңізді үйде жасаңыз.
Dialogue: 0,0:00:18.72,0:00:22.01,jp.sub-ja,NTP,0,0,0,,Мұнда ештеңе жоқ, бірақ асықпаңыз.
Dialogue: 0,0:00:22.36,0:00:24.36,Style1,,0,0,0,,Мен шай қояйын, қазір.
Dialogue: 0,0:00:22.60,0:00:24.04,jp.sub-ja,NTP,0,0,0,,Мен қазір шай дайындаймын.
Dialogue: 0,0:00:24.36,0:00:29.37,Style1,,0,0,0,,Ой, кешіріңіз, менде шыныаяқ жетпейді.
Dialogue: 0,0:00:25.19,0:00:28.79,jp.sub-ja,NTP,0,0,0,,Бірақ кешіріңіз, менде шыныаяқ жетпейді.
Dialogue: 0,0:00:29.36,0:00:30.15,jp.sub-ja,NTP,0,0,0,,Өтінемін
Dialogue: 0,0:00:29.37,0:00:30.70,Style1,,0,0,0,,Менің қонағым бол.
Dialogue: 0,0:00:30.70,0:00:34.04,Style1,,0,0,0,,Мырза, бұл қандай үй?
Dialogue: 0,0:00:30.78,0:00:31.45,jp.sub-ja,NTP,0,0,0,,Мырза
Dialogue: 0,0:00:32.08,0:00:34.12,jp.sub-ja,NTP,0,0,0,,Бұл қандай үй?
Dialogue: 0,0:00:34.04,0:00:37.38,Style1,,0,0,0,,Бұл жиынтық па? Барлығынан...
Dialogue: 0,0:00:34.23,0:00:35.55,jp.sub-ja,NTP,0,0,0,,бір нәрсенің жиынтығы
Dialogue: 0,0:00:35.74,0:00:36.95,jp.sub-ja,NTP,0,0,0,,Кез келген сома
Dialogue: 0,0:00:37.36,0:00:38.90,jp.sub-ja,NTP,0,0,0,,Тынышталыңыз
Dialogue: 0,0:00:37.38,0:00:41.05,Style1,,0,0,0,,Дж-ж-жай тыныштал! Мен бұл жай ғана қойма екеніне сенімдімін.
Dialogue: 0,0:00:39.14,0:00:41.23,jp.sub-ja,NTP,0,0,0,,Мен бұл қойма екеніне сенімдімін.
Dialogue: 0,0:00:41.05,0:00:44.98,Style1,,0,0,0,,Шексіз ғарыш, бәлкім, сол шкафтың сыртында шығар.
Dialogue: 0,0:00:41.26,0:00:42.86,jp.sub-ja,NTP,0,0,0,,Мүмкін сол шкафтың артында
Dialogue: 0,0:00:42.92,0:00:44.97,jp.sub-ja,NTP,0,0,0,,Шексіздікке таралатын Ғарыш
Dialogue: 0,0:00:44.98,0:00:46.65,Style1,,0,0,0,,Ал, шкафты ашу керек пе?
Dialogue: 0,0:00:45.00,0:00:46.58,jp.sub-ja,NTP,0,0,0,,Кәне, шкафты ашайық.
Dialogue: 0,0:00:46.65,0:00:48.32,Style1,,0,0,0,,- Жоқ, жасамаңыз! -' жарайды!
Dialogue: 0,0:00:46.85,0:00:47.52,jp.sub-ja,NTP,0,0,0,,Тоқта.
Dialogue: 0,0:00:48.24,0:00:51.42,jp.sub-ja,NTP,0,0,0,,Дұрыс, түске таман осында боламын.
Dialogue: 0,0:00:48.32,0:00:51.32,Style1,,0,0,0,,О, иә, сіз түскі уақытта келдіңіз,
Dialogue: 0,0:00:51.32,0:00:53.66,Style1,,0,0,0,,сондықтан әкем саған бірдеңе ұсынамын деді.
Dialogue: 0,0:00:51.44,0:00:53.44,jp.sub-ja,NTP,0,0,0,,Әкем бірдеңе беруімді өтінді.
Dialogue: 0,0:00:53.66,0:00:55.99,Style1,,0,0,0,,Сіздің талғамыңызға сай келетініне көз жеткізу үшін,
Dialogue: 0,0:00:53.67,0:00:55.83,jp.sub-ja,NTP,0,0,0,,Сіздің талғамыңызға сай
Dialogue: 0,0:00:55.99,0:01:00.67,Style1,,0,0,0,,Мен соңғы үш күн ораза ұстадым, сол ақшаны жинадым.
Dialogue: 0,0:00:56.02,0:00:59.75,jp.sub-ja,NTP,0,0,0,,Үш күн ораза тұт, тамаққа ақша жина.
Dialogue: 0,0:01:00.67,0:01:04.00,Style1,,0,0,0,,Мен де ұямның жұмыртқасын жұмсауға тура келді.
Dialogue: 0,0:01:00.79,0:01:03.32,jp.sub-ja,NTP,0,0,0,,Мен де оның қарнынан ұрдым.
Dialogue: 0,0:01:03.92,0:01:07.58,jp.sub-ja,NTP,0,0,0,,Январдағы сәнді арнайы суши
Dialogue: 0,0:01:04.00,0:01:10.54,Style1,,0,0,0,,Та-да! Арнайы люкс суши! Бұл туралы ше?
Dialogue: 0,0:01:07.31,0:01:10.54,Style2,,0,0,0,,«Суши супермаркеті»
Dialogue: 0,0:01:07.60,0:01:09.73,jp.sub-ja,NTP,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:01:13.01,0:01:16.35,Style1,,0,0,0,,Хару-чан, саған қонаққа келгеніміз үшін кешірім сұраймыз!
Dialogue: 0,0:01:13.19,0:01:16.29,jp.sub-ja,NTP,0,0,0,,Хару-чан, қонаққа келгеніміз үшін кешірім сұраймыз.
Dialogue: 0,0:01:15.98,0:01:22.19,Style2,,0,0,0,,«Жылау»
Dialogue: 0,0:01:16.35,0:01:19.02,Style1,,0,0,0,,Жылама! Харухи үшін осы соңғы үш күн бекерге кетпесін,
Dialogue: 0,0:01:16.54,0:01:17.19,jp.sub-ja,NTP,0,0,0,,Жылама
Dialogue: 0,0:01:17.24,0:01:19.90,jp.sub-ja,NTP,0,0,0,,Өтінемін, Харухидің үш күнін жақсы күтіңіз.
Dialogue: 0,0:01:19.02,0:01:22.19,Style1,,0,0,0,,- тек абайлап тамақтаныңыз! - Бірақ бұл иірімдер өте жұқа!
Dialogue: 0,0:01:20.26,0:01:22.02,jp.sub-ja,NTP,0,0,0,,Әңгіме әлсіз
Dialogue: 0,0:01:22.08,0:01:26.28,jp.sub-ja,NTP,0,0,0,,Бұл үлкен торо емес пе?
Dialogue: 0,0:01:22.19,0:01:22.71,Style2,,0,0,0,,«Ой!»
Dialogue: 0,0:01:22.35,0:01:26.36,Style1,,0,0,0,,Уау! Кез келген жағдайда, бұл сәнді тунец пе?
Dialogue: 0,0:01:26.32,0:01:28.13,jp.sub-ja,NTP,0,0,0,,Мен оны бірінші рет жеп отырмын.
Dialogue: 0,0:01:26.36,0:01:28.79,Style1,,0,0,0,,Мен бірінші рет жеп отырмын.
Dialogue: 0,0:01:28.79,0:01:29.73,Style2,,0,0,0,,«Ахх...»
Dialogue: 0,0:01:29.73,0:01:30.50,Style2,,0,0,0,,«Чомп!»
Dialogue: 0,0:01:30.50,0:01:32.86,Style2,,0,0,0,,«Мүнч-мунч!»
Dialogue: 0,0:01:31.86,0:01:34.37,Style1,,0,0,0,,Керемет тунец дәмді!
Dialogue: 0,0:01:32.34,0:01:34.09,jp.sub-ja,NTP,0,0,0,,Ооторо дәмді
Dialogue: 0,0:01:32.86,0:01:33.85,Style2,,0,0,0,,«Дәмді!» «Мүнч-мунч!»
Dialogue: 0,0:01:34.37,0:01:37.37,Style1,,0,0,0,,Т-бұл қарапайым арық тунец,
Dialogue: 0,0:01:35.15,0:01:37.52,jp.sub-ja,NTP,0,0,0,,Бұл жай ғана қызыл ет
Dialogue: 0,0:01:37.37,0:01:40.27,Style1,,0,0,0,,және тунец ешбір сәнді емес!
Dialogue: 0,0:01:37.57,0:01:39.55,jp.sub-ja,NTP,0,0,0,,Әрине, үлкен торо емес
Dialogue: 0,0:01:50.27,0:01:51.75,jp.sub-ja,NTP,0,0,0,,Арман...?
Dialogue: 0,0:01:50.32,0:01:52.58,Style1,,0,0,0,,Бұл арман болды ма?
Dialogue: 0,0:02:01.59,0:02:04.56,jp.sub-ja,NTP,0,0,0,,Қайырлы таң Тамаки Ботчама
Dialogue: 0,0:02:01.66,0:02:05.00,Style1,,0,0,0,,Қайырлы таң, Тамаки ұстаз.
Dialogue: 0,0:02:02.93,0:02:04.52,Style2,,0,0,0,,"Суоу 2-ші резиденциясының басшысы, Маэзоно Шима (82)"
Dialogue: 0,0:02:04.88,0:02:07.98,jp.sub-ja,NTP,0,0,0,,Дереу кетіңіз Көлікті дереу бұрыңыз.
Dialogue: 0,0:02:05.00,0:02:08.00,Style1,,0,0,0,,Мен бірден кетемін. Көлікті тез арада әкеліңіз.
Dialogue: 0,0:02:08.00,0:02:09.33,Style1,,0,0,0,,Иә, ұстаз.
Dialogue: 0,0:02:08.07,0:02:09.11,jp.sub-ja,NTP,0,0,0,,Иә, Ботчама
Dialogue: 0,0:02:09.24,0:02:13.03,jp.sub-ja,NTP,0,0,0,,Мен қорқамын, Тамаки мырза, таңғы ас алғыңыз келе ме?
Dialogue: 0,0:02:09.33,0:02:13.07,Style1,,0,0,0,,Кешірім сұраймын, Тамаки-сама, бірақ таңғы асқа не ішесің?
Dialogue: 0,0:02:13.07,0:02:15.54,Style2,,0,0,0,,«Айқай»
Dialogue: 0,0:02:13.07,0:02:16.34,Style1,,0,0,0,,А, жеткілікті! Оған уақыт жоқ!
Dialogue: 0,0:02:13.26,0:02:16.37,jp.sub-ja,NTP,0,0,0,,А, қазір олай емес.
Dialogue: 0,0:02:16.34,0:02:20.01,Style1,,0,0,0,,Менің басым дәл қазір қорқынышты болжамға толы.
Dialogue: 0,0:02:16.43,0:02:19.54,jp.sub-ja,NTP,0,0,0,,Менің басым дәл қазір қорқынышты ескертулерге толы.
Dialogue: 0,0:02:20.01,0:02:21.35,Style1,,0,0,0,,Олардың жеке өміріне қол сұғылмаушылықты ескере отырып,
Dialogue: 0,0:02:20.04,0:02:21.41,jp.sub-ja,NTP,0,0,0,,Құпиялылықты ескеру
Dialogue: 0,0:02:21.35,0:02:24.68,Style1,,0,0,0,,Мен клуб мүшелерінің жеке өміріне араласуға тырысқан жоқпын.
Dialogue: 0,0:02:21.53,0:02:24.34,jp.sub-ja,NTP,0,0,0,,Мен әрқашан клуб мүшелерінің жеке өміріне араласпауға тырыстым.
Dialogue: 0,0:02:24.64,0:02:25.33,jp.sub-ja,NTP,0,0,0,,Дегенмен
Dialogue: 0,0:02:24.68,0:02:29.69,Style1,,0,0,0,,Алайда, егер Харухи шынымен де соншалықты кедей өмір сүріп жатса,
Dialogue: 0,0:02:24.84,0:02:27.88,jp.sub-ja,NTP,0,0,0,,Сіздің талғамыңызға сай
Dialogue: 0,0:02:25.96,0:02:29.77,jp.sub-ja,NTP,0,0,0,,Егер Харухи сондай кедей өмір сүрсе ше?
Dialogue: 0,0:02:27.92,0:02:30.36,jp.sub-ja,NTP,0,0,0,,Үш күн ораза ұста және тамаққа ақша жина.
Dialogue: 0,0:02:29.69,0:02:31.69,Style1,,0,0,0,,онда мен Харухиді бірден көруім керек,
Dialogue: 0,0:02:30.41,0:02:33.26,jp.sub-ja,NTP,0,0,0,,Біз Харухимен тезірек кездесіп, шындықты білуіміз керек.
Dialogue: 0,0:02:31.69,0:02:34.69,Style1,,0,0,0,,және мәселенің шындығын табыңыз. Мен мектепке жетуім керек!
Dialogue: 0,0:02:33.49,0:02:34.64,jp.sub-ja,NTP,0,0,0,,Мектепке ерте бар
Dialogue: 0,0:02:34.69,0:02:37.03,Style1,,0,0,0,,Кешірім сұраймын, Тамаки-сама!
Dialogue: 0,0:02:34.71,0:02:36.56,jp.sub-ja,NTP,0,0,0,,Мен қорқамын, Тамаки-сама.
Dialogue: 0,0:02:36.98,0:02:39.03,jp.sub-ja,NTP,0,0,0,,Киім – жартылай түнгі көйлек
Dialogue: 0,0:02:37.03,0:02:39.36,Style1,,0,0,0,,Сіз әлі пижама кигенсіз,
Dialogue: 0,0:02:39.36,0:02:42.93,Style1,,0,0,0,,және сіздің аяғыңызда әлі үй тәпішкелері бар.
Dialogue: 0,0:02:39.42,0:02:42.13,jp.sub-ja,NTP,0,0,0,,Сіздің аяқтарыңыз әлі жабық аяқ киіміңізде.
Dialogue: 0,0:02:44.30,0:02:47.29,Style1,,0,0,0,,Менің, әдепсіз неткен.
Dialogue: 0,0:02:45.05,0:02:46.60,jp.sub-ja,NTP,0,0,0,,Жаман мінез-құлық
Dialogue: 0,0:02:50.64,0:02:52.64,Style1,,0,0,0,,Жарайды, мен тағы да кетемін.
Dialogue: 0,0:02:50.87,0:02:52.51,jp.sub-ja,NTP,0,0,0,,Тағы барайық.
Dialogue: 0,0:02:52.51,0:02:54.78,jp.sub-ja,NTP,0,0,0,,Қатты қорқып, Тамаки мырза.
Dialogue: 0,0:02:52.64,0:02:54.98,Style1,,0,0,0,,Шын жүректен кешірім сұраймын, Тамаки-сама,
Dialogue: 0,0:02:54.98,0:02:58.98,Style1,,0,0,0,,бірақ бүгін жексенбі, сондықтан бүгін мектеп жоқ.
Dialogue: 0,0:02:55.14,0:02:58.80,jp.sub-ja,NTP,0,0,0,,Бүгін жексенбі, сондықтан мектеп жабық.
Dialogue: 0,0:02:58.98,0:03:03.32,Style1,,0,0,0,,Шима, сен мұны маған басында айта алмадың ба?
Dialogue: 0,0:02:59.25,0:03:02.97,jp.sub-ja,NTP,0,0,0,,Шима, алдымен соны айтып бере аласыз ба?
Dialogue: 0,0:03:03.32,0:03:06.32,Style1,,0,0,0,,Сіздің күңіңіз күн сайын Қожайынға тілек тілейді
Dialogue: 0,0:03:03.33,0:03:05.64,jp.sub-ja,NTP,0,0,0,,Қатені өзіңіз байқайсыз
Dialogue: 0,0:03:05.65,0:03:08.27,jp.sub-ja,NTP,0,0,0,,Сіз жақсы мырза болып өсесіз деп сенемін.
Dialogue: 0,0:03:06.32,0:03:08.33,Style1,,0,0,0,,жақсы джентльмен болып өсу,
Dialogue: 0,0:03:08.33,0:03:11.33,Style1,,0,0,0,,өз қатесін түсінуге қабілетті.
Dialogue: 0,0:03:08.58,0:03:11.21,jp.sub-ja,NTP,0,0,0,,Өйткені кемпір күнде намаз оқиды.
Dialogue: 0,0:03:11.25,0:03:16.05,jp.sub-ja,NTP,0,0,0,,Жоспарың жоқ болса, мына жолақ пен әдепті зерттейік.
Dialogue: 0,0:03:11.33,0:03:15.33,Style1,,0,0,0,,Басқа жоспарың жоқ болса, менімен бірге келіп, әдептілікіңді зертте.
Dialogue: 0,0:03:15.33,0:03:18.34,Style1,,0,0,0,,Менің басқа жоспарларым бар! Басқа жоспарларым бар!
Dialogue: 0,0:03:16.15,0:03:17.93,jp.sub-ja,NTP,0,0,0,,Иә, жоспарларыңыз болса.
Dialogue: 0,0:03:18.34,0:03:20.67,Style1,,0,0,0,,Біреу, маған телефон әкел!
Dialogue: 0,0:03:18.53,0:03:20.47,jp.sub-ja,NTP,0,0,0,,Мұнда біреу қоңырау шалды
Dialogue: 0,0:03:20.67,0:03:21.97,Style1,,0,0,0,,Жер
Dialogue: 0,0:03:25.34,0:03:26.61,Style1,,0,0,0,,Tch...
Dialogue: 0,0:03:28.35,0:03:31.25,Style1,,0,0,0,,Кёя, бұл сен бе? Мен сізбен маңызды нәрсені талқылауым керек.
Dialogue: 0,0:03:28.38,0:03:31.08,jp.sub-ja,NTP,0,0,0,,Кёуя, мен кіріп сенімен сөйлесуім керек.
Dialogue: 0,0:03:34.75,0:03:37.19,Style1,,0,0,0,,``Фудзиока отбасының өміріндегі бір күн!''
Dialogue: 0,0:03:41.26,0:03:43.06,Style1,,0,0,0,,Мен жарнамаланған арнайы ұсыныстарды алдым!
Dialogue: 0,0:03:41.26,0:03:43.06,Style2,,0,0,0,,"Марутоми супермаркети"
Dialogue: 0,0:03:41.34,0:03:43.05,jp.sub-ja,NTP,0,0,0,,Жарнамаланған заттарды алыңыз
Dialogue: 0,0:03:43.06,0:03:46.30,Style1,,0,0,0,,Супермаркет шынымен де жексенбінің таңын өткізетін орын.
Dialogue: 0,0:03:43.21,0:03:46.47,jp.sub-ja,NTP,0,0,0,,Өйткені, жексенбі супермаркеттегі таңғы базар.
Dialogue: 0,0:03:46.30,0:03:49.63,Style1,,0,0,0,,Үйге келген соң тазалау мен кір жууым керек...
Dialogue: 0,0:03:46.52,0:03:49.29,jp.sub-ja,NTP,0,0,0,,Үйге келгенде тазалап, жуыңыз.
Dialogue: 0,0:03:49.51,0:03:53.64,jp.sub-ja,NTP,0,0,0,,Менің пәтерімнің алдындағы бұл не деп ойлаймын.
Dialogue: 0,0:03:49.63,0:03:50.97,Style1,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:03:50.97,0:03:54.17,Style1,,0,0,0,,Бұл не, біздің пәтердің алдында?
Dialogue: 0,0:03:58.19,0:04:00.83,jp.sub-ja,NTP,0,0,0,,Не, не, бай қайда?
Dialogue: 0,0:03:58.31,0:04:01.68,Style1,,0,0,0,,- Бұл не? Байлар кімдер? - Ұстаз, рұқсат етсеңіз...
Dialogue: 0,0:03:59.25,0:04:00.85,jp.sub-ja,NTP,0,0,0,,Обочама, өтінемін.
Dialogue: 0,0:04:08.67,0:04:11.62,jp.sub-ja,NTP,0,0,0,,Харухин осында ма?
Dialogue: 0,0:04:08.99,0:04:11.66,Style1,,0,0,0,,Ой, бұл Харухидің үйі ғой, иә?
Dialogue: 0,0:04:11.66,0:04:14.66,Style1,,0,0,0,,Бұл өте үлкен, солай емес пе? Мен ойлағаннан да үлкен.
Dialogue: 0,0:04:11.93,0:04:13.70,jp.sub-ja,NTP,0,0,0,,Бұл өте үлкен, таңқаларлық.
Dialogue: 0,0:04:14.66,0:04:16.33,Style1,,0,0,0,,Оның көптеген бөлмелері бар.
Dialogue: 0,0:04:14.91,0:04:16.33,jp.sub-ja,NTP,0,0,0,,Бөлмелерге толы
Dialogue: 0,0:04:16.33,0:04:19.33,Style1,,0,0,0,,Жоқ, бұл жалпы тұрғын үй деп аталады.
Dialogue: 0,0:04:16.40,0:04:19.33,jp.sub-ja,NTP,0,0,0,,Жоқ, бұл қарапайым тұрғындарға арналған тұрғын үй кешені.
Dialogue: 0,0:04:19.33,0:04:22.33,Style1,,0,0,0,,Харухидің орны осы бөлмелердің бірі ғана шығар.
Dialogue: 0,0:04:19.49,0:04:22.32,jp.sub-ja,NTP,0,0,0,,Харухиде бұл бөлмелердің біреуі ғана болуы мүмкін.
Dialogue: 0,0:04:22.33,0:04:23.33,Style1,,0,0,0,,Киоя!
Dialogue: 0,0:04:22.35,0:04:25.80,jp.sub-ja,NTP,0,0,0,,Кёуя Бұл көп адам қанша?
Dialogue: 0,0:04:23.33,0:04:27.67,Style1,,0,0,0,,Бұл адамдардың барлығына не бар!? Әсіресе, осы екі қосшы!
Dialogue: 0,0:04:25.95,0:04:27.84,jp.sub-ja,NTP,0,0,0,,Әсіресе әлгі қосаяқтар
Dialogue: 0,0:04:27.67,0:04:31.68,Style1,,0,0,0,,О. Сенің жалғыз келуге батылың жетпегеніне сенімді едім,
Dialogue: 0,0:04:27.87,0:04:31.70,jp.sub-ja,NTP,0,0,0,,Сен өзің келуге батылым жетпегені анық.
Dialogue: 0,0:04:31.68,0:04:34.01,Style1,,0,0,0,,сондықтан жаппай келсек жақсы болар еді.
Dialogue: 0,0:04:31.72,0:04:33.63,jp.sub-ja,NTP,0,0,0,,Бірнеше адам болған жақсы ма?
Dialogue: 0,0:04:34.00,0:04:37.02,jp.sub-ja,NTP,0,0,0,,Сіз көп қажетсіз нәрселер жасадыңыз. Балалар үйге қайтайық.
Dialogue: 0,0:04:34.01,0:04:37.01,Style1,,0,0,0,,Менің ойымша, бұл қажет емес еді. Жарайды балалар үйге қайтайық.
Dialogue: 0,0:04:37.01,0:04:39.35,Style1,,0,0,0,,Жоқ! Мен үйге барғым келмейді!
Dialogue: 0,0:04:37.08,0:04:39.52,jp.sub-ja,NTP,0,0,0,,Жоқ, жоқ, үйге барғым келмейді
Dialogue: 0,0:04:39.35,0:04:42.62,Style1,,0,0,0,,Кешіріңіз. Кешір мені. Мен жалғыз қалғым келмейді.
Dialogue: 0,0:04:39.54,0:04:42.17,jp.sub-ja,NTP,0,0,0,,Кешіріңіз, кешіріңіз, мен сізді жалғыз қалдырамын.
Dialogue: 0,0:04:42.40,0:04:45.01,jp.sub-ja,NTP,0,0,0,,Не болды? Бұл фильм түсірілімі ме?
Dialogue: 0,0:04:42.62,0:04:44.96,Style1,,0,0,0,,Бұл не? Қандай да бір фильм түсіру?
Dialogue: 0,0:04:44.96,0:04:46.96,Style1,,0,0,0,,Бай адамдар! Бай адамдар!
Dialogue: 0,0:04:45.01,0:04:46.97,jp.sub-ja,NTP,0,0,0,,Мен баймын мен баймын
Dialogue: 0,0:04:46.96,0:04:49.96,Style1,,0,0,0,,Тыңдаңдар, ер адамдар. Ұмытпа...
Dialogue: 0,0:04:46.98,0:04:49.23,jp.sub-ja,NTP,0,0,0,,Ұмытпаңдар, қымбаттыларым.
Dialogue: 0,0:04:49.95,0:04:54.19,jp.sub-ja,NTP,0,0,0,,Бұл кездейсоқ сапар болды, өйткені мен кездейсоқ өтіп бара жатқанмын.
Dialogue: 0,0:04:49.96,0:04:54.63,Style1,,0,0,0,,Бұл жай ғана «кездейсоқ өтіп бара жатырмыз» деген немқұрайлы сапар,
Dialogue: 0,0:04:54.61,0:04:57.54,jp.sub-ja,NTP,0,0,0,,Бұл Фудзиока отбасының өмір сүру деңгейіне қатысты зерттеу емес.
Dialogue: 0,0:04:54.63,0:04:57.97,Style1,,0,0,0,,және бұл Фудзиока отбасының өмір сүру деңгейіне қатысты зерттеу емес!
Dialogue: 0,0:04:57.61,0:05:00.88,jp.sub-ja,NTP,0,0,0,,Шұбар, тар, тоз-тоз сияқты сөздерге мүлде тиым салынады.
Dialogue: 0,0:04:57.97,0:05:00.97,Style1,,0,0,0,,«Түрлі», «тар» және «тозған» сөздеріне мүлде тыйым салынады!
Dialogue: 0,0:05:00.97,0:05:02.31,Style1,,0,0,0,,Иә, сэр!
Dialogue: 0,0:05:01.06,0:05:02.14,jp.sub-ja,NTP,0,0,0,,Иә
Dialogue: 0,0:05:02.25,0:05:04.21,jp.sub-ja,NTP,0,0,0,,Қателік жасасаң да, Харухиге де, әкеңе де айтпа.
Dialogue: 0,0:05:02.31,0:05:04.64,Style1,,0,0,0,,Ешбір жағдайда ештеңе айтпауға немесе жасауға болмайды
Dialogue: 0,0:05:04.28,0:05:06.74,jp.sub-ja,NTP,0,0,0,,Үйге барғыңыз келетін сөздер мен әрекеттер
Dialogue: 0,0:05:04.64,0:05:06.64,Style1,,0,0,0,,Харухи немесе әкесі біздің кеткенімізді қалайды.
Dialogue: 0,0:05:06.64,0:05:09.65,Style1,,0,0,0,,Бұл үшін тым кеш. Кетіңіз, дәл қазір!
Dialogue: 0,0:05:06.80,0:05:08.72,jp.sub-ja,NTP,0,0,0,,Дұрысы, қазір үйге қайт.
Dialogue: 0,0:05:09.65,0:05:11.48,Style1,,0,0,0,,Харухи!
Dialogue: 0,0:05:09.69,0:05:10.56,jp.sub-ja,NTP,0,0,0,,Харухи
Dialogue: 0,0:05:13.29,0:05:15.10,jp.sub-ja,NTP,0,0,0,,Қарапайымдылығы да жақсы
Dialogue: 0,0:05:13.32,0:05:14.99,Style1,,0,0,0,,Қарапайым және қарапайым, жақсы көрінеді!
Dialogue: 0,0:05:13.32,0:05:16.81,Style2,,0,0,0,,«Бір бөлік сүйкімді»
Dialogue: 0,0:05:14.99,0:05:16.82,Style1,,0,0,0,,Аузыңды жап! Мына жерден кет!
Dialogue: 0,0:05:15.21,0:05:16.76,jp.sub-ja,NTP,0,0,0,,Тыныштық және жоғалып кету.
Dialogue: 0,0:05:16.85,0:05:20.38,Style2,,0,0,0,,«Айқай!»
Dialogue: 0,0:05:17.99,0:05:20.66,Style1,,0,0,0,,Харухи керемет лас тілді қолдануда!Харухи керемет лас тілді қолдануда!
Dialogue: 0,0:05:18.17,0:05:20.41,jp.sub-ja,NTP,0,0,0,,Харухи өте лас сөздер айтты.
Dialogue: 0,0:05:20.66,0:05:22.66,Style1,,0,0,0,,- Мұның бәріне сен кінәлісің! - Мен емес едім.
Dialogue: 0,0:05:20.80,0:05:23.01,jp.sub-ja,NTP,0,0,0,,Бәріне сен кінәлісің.
Dialogue: 0,0:05:21.56,0:05:23.00,jp.sub-ja,NTP,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:05:22.66,0:05:24.66,Style1,,0,0,0,,Кешіріңіз, Харухи-чан, бәрі жақсы ма?
Dialogue: 0,0:05:23.09,0:05:24.96,jp.sub-ja,NTP,0,0,0,,Харухи-чан, жақсысың ба?
Dialogue: 0,0:05:24.66,0:05:26.00,Style1,,0,0,0,,О, үй иесі ханым.
Dialogue: 0,0:05:24.99,0:05:25.94,jp.sub-ja,NTP,0,0,0,,Үй иесі
Dialogue: 0,0:05:25.95,0:05:27.40,jp.sub-ja,NTP,0,0,0,,Сол шетелдік көлікке міну
Dialogue: 0,0:05:26.00,0:05:27.67,Style1,,0,0,0,,Шетелдік көліктерде осылай жүру,
Dialogue: 0,0:05:27.53,0:05:29.63,jp.sub-ja,NTP,0,0,0,,Бұл жігіттер якуза немесе бірдеңе.
Dialogue: 0,0:05:27.67,0:05:29.67,Style1,,0,0,0,,Бұл адамдар якуза ма әлде басқасы ма?
Dialogue: 0,0:05:29.67,0:05:32.34,Style1,,0,0,0,,- Жоқ, мм... - Полиция шақыруым керек пе?
Dialogue: 0,0:05:29.68,0:05:30.37,jp.sub-ja,NTP,0,0,0,,Жоқ
Dialogue: 0,0:05:30.40,0:05:31.74,jp.sub-ja,NTP,0,0,0,,Бұл туралы полицияға хабарлауым керек пе?
Dialogue: 0,0:05:32.22,0:05:33.66,jp.sub-ja,NTP,0,0,0,,Танысқаныма қуаныштымын, ханым
Dialogue: 0,0:05:32.34,0:05:34.01,Style1,,0,0,0,,Танысыңыз, ханым.
Dialogue: 0,0:05:33.93,0:05:36.39,jp.sub-ja,NTP,0,0,0,,Менің атым Суо мен Харухидің досымын.
Dialogue: 0,0:05:34.01,0:05:36.67,Style1,,0,0,0,,Менің атым Суо, мен Харухи-санның достарының бірімін.
Dialogue: 0,0:05:36.61,0:05:39.75,jp.sub-ja,NTP,0,0,0,,Ой, жарайды, не істеуіміз керек?
Dialogue: 0,0:05:36.67,0:05:39.34,Style1,,0,0,0,,Әй, менің, менің, менің, мен не істеймін?
Dialogue: 0,0:05:39.34,0:05:42.01,Style1,,0,0,0,,Үй иесі ханым...
Dialogue: 0,0:05:39.39,0:05:40.71,jp.sub-ja,NTP,0,0,0,,Үй иесі
Dialogue: 0,0:05:41.93,0:05:46.03,jp.sub-ja,NTP,0,0,0,,Сізге кенеттен келіп мазалағаным үшін кешірім сұраймын.
Dialogue: 0,0:05:42.01,0:05:45.95,Style1,,0,0,0,,Кенеттен осылай тоқтап қалып, дүрбелең тудырғаным үшін қатты өкінемін.
Dialogue: 0,0:05:45.95,0:05:48.62,Style1,,0,0,0,,О, мүлде емес.
Dialogue: 0,0:05:46.12,0:05:47.50,jp.sub-ja,NTP,0,0,0,,№.
Dialogue: 0,0:05:48.51,0:05:52.30,jp.sub-ja,NTP,0,0,0,,Харухи-чан, мен саған кейін тәттілер әкелемін.
Dialogue: 0,0:05:48.62,0:05:52.42,Style1,,0,0,0,,Харухи-чан, мен кешікпей тамақ тастаймын, жарай ма?
Dialogue: 0,0:05:52.42,0:05:54.29,Style1,,0,0,0,,Үйде болыңыз.
Dialogue: 0,0:05:53.08,0:05:54.33,jp.sub-ja,NTP,0,0,0,,Кеше теңіз жағалауға барып келгенімізге байланысты,
Dialogue: 0,0:05:54.29,0:05:55.95,Style2,,0,0,0,,«Фудзиока»
Dialogue: 0,0:05:55.96,0:05:59.96,Style1,,0,0,0,,Мен сізге дәл қазір ескертемін, сіз үш секунд сияқты кішкене қарап тұрсаңыз болды.
Dialogue: 0,0:05:56.02,0:05:57.26,jp.sub-ja,NTP,0,0,0,,Мен мұны айтқым келеді
Dialogue: 0,0:05:57.32,0:05:59.64,jp.sub-ja,NTP,0,0,0,,Оған шамамен 3 секунд қараңыз.
Dialogue: 0,0:05:59.96,0:06:01.23,Style1,,0,0,0,,Сіз оны көргеннен кейін бірден-
Dialogue: 0,0:06:00.03,0:06:01.18,jp.sub-ja,NTP,0,0,0,,Оны көрген бойда
Dialogue: 0,0:06:01.23,0:06:04.97,Style1,,0,0,0,,Хару-чан, мен сыйлық әкелдім. Бұл торт.
Dialogue: 0,0:06:01.23,0:06:10.14,Style2,,0,0,0,,«Сәнді кондитерлік өнімдер»
Dialogue: 0,0:06:01.53,0:06:04.55,jp.sub-ja,NTP,0,0,0,,Хару-чан, бұл кәдесый торт.
Dialogue: 0,0:06:04.96,0:06:09.36,jp.sub-ja,NTP,0,0,0,,Құлпынай, шоколад және т.б.
Dialogue: 0,0:06:04.97,0:06:07.64,Style1,,0,0,0,,Онда құлпынай да, шоколад та бар,
Dialogue: 0,0:06:07.59,0:06:09.18,jp.sub-ja,NTP,0,0,0,,Ал, бұл шай болғанша.
Dialogue: 0,0:06:07.64,0:06:10.13,Style1,,0,0,0,,- және басқалары да. -Жарайды, шәй ішіп аламыз.
Dialogue: 0,0:06:15.98,0:06:18.32,Style1,,0,0,0,,Ой, бұл менің арманымнан сәл жақсырақ шығар.
Dialogue: 0,0:06:16.56,0:06:18.10,jp.sub-ja,NTP,0,0,0,,Арманнан да жақсырақ
Dialogue: 0,0:06:18.19,0:06:18.89,jp.sub-ja,NTP,0,0,0,,Шобот
Dialogue: 0,0:06:18.32,0:06:19.65,Style1,,0,0,0,,Шабби.
Dialogue: 0,0:06:20.65,0:06:22.65,Style1,,0,0,0,,Ағаштан жасалған, екі қабатты 2К.
Dialogue: 0,0:06:20.78,0:06:22.68,jp.sub-ja,NTP,0,0,0,,Ағаштан жасалған екі қабатты ғимарат 2К
Dialogue: 0,0:06:22.65,0:06:25.66,Style1,,0,0,0,,Бұл екі адамнан тұратын әке-қызы қарапайым отбасы үшін дұрыс.
Dialogue: 0,0:06:22.72,0:06:25.56,jp.sub-ja,NTP,0,0,0,,Қарапайым адам ата-анамен және баламен тұрса, былай болар еді.
Dialogue: 0,0:06:25.60,0:06:29.99,jp.sub-ja,NTP,0,0,0,,Жарайды, егер ол Харухидің өлшемі болса, бұл төмен төбеге соқпайды.
Dialogue: 0,0:06:25.66,0:06:30.33,Style1,,0,0,0,,Иә. Харухидің өлшемінде ол аласа төбеге басын ұрмайды.
Dialogue: 0,0:06:30.18,0:06:32.83,jp.sub-ja,NTP,0,0,0,,Бұл шынымен сүйкімді бөлме, солай емес пе?
Dialogue: 0,0:06:30.33,0:06:33.00,Style1,,0,0,0,,Бұл өте сүйкімді кішкентай бөлме!
Dialogue: 0,0:06:32.86,0:06:35.45,jp.sub-ja,NTP,0,0,0,,Ештеңе етпейді, мені мақтауға дейін барудың қажеті жоқ.
Dialogue: 0,0:06:33.00,0:06:35.67,Style1,,0,0,0,,Жарайды, өзіңізді мақтауға мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:06:35.67,0:06:38.67,Style1,,0,0,0,,Иә? Хару-чан, аяқ киімімізді шешеміз бе?
Dialogue: 0,0:06:35.70,0:06:38.44,jp.sub-ja,NTP,0,0,0,,Эй, Хару-чан, аяқ киіміңді шеш.
Dialogue: 0,0:06:38.67,0:06:39.73,jp.sub-ja,NTP,0,0,0,,Оны ұзақ өмір сүруге қалдыра алмаймын.
Dialogue: 0,0:06:38.67,0:06:40.00,Style1,,0,0,0,,Иә, өтінемін.
Dialogue: 0,0:06:40.00,0:06:42.51,Style1,,0,0,0,,Кірер алдында аяқ киімімізді шешуіміз керек.
Dialogue: 0,0:06:40.09,0:06:42.18,jp.sub-ja,NTP,0,0,0,,Мұнда кірер алдында аяқ киімді шешу керек.
Dialogue: 0,0:06:42.39,0:06:44.59,jp.sub-ja,NTP,0,0,0,,Бөлме дохжоға ұқсайды.
Dialogue: 0,0:06:42.51,0:06:44.61,Style1,,0,0,0,,Бұл бөлме Додзо сияқты, иә?
Dialogue: 0,0:06:44.61,0:06:45.61,Style1,,0,0,0,,Оқу, оқу
Dialogue: 0,0:06:45.56,0:06:47.39,jp.sub-ja,NTP,0,0,0,,Олай болса, бөлмеңдегі аяқ киіміңді маған қарызға бер.
Dialogue: 0,0:06:45.61,0:06:47.28,Style1,,0,0,0,,Ендеше, тәпішкені қарызға алайық.
Dialogue: 0,0:06:47.28,0:06:49.61,Style1,,0,0,0,,О, мен дәл сол жерде татами төселген бөлмені көріп тұрмын.
Dialogue: 0,0:06:47.39,0:06:49.64,jp.sub-ja,NTP,0,0,0,,А, мен дәл сол жерде татами бөлмесін көріп тұрмын.
Dialogue: 0,0:06:49.61,0:06:51.62,Style1,,0,0,0,,Бұл жағдайда бізге тәпішке керек емес, иә?
Dialogue: 0,0:06:49.78,0:06:51.67,jp.sub-ja,NTP,0,0,0,,Онда сізге бөлме киімінің қажеті жоқ.
Dialogue: 0,0:06:51.62,0:06:54.29,Style1,,0,0,0,,Жарайды, кіруді кешіріңіз!
Dialogue: 0,0:06:51.80,0:06:54.13,jp.sub-ja,NTP,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:06:54.29,0:06:55.62,Style1,,0,0,0,,Қауіпсіздікті кешіріңіз.
Dialogue: 0,0:06:54.34,0:06:55.27,jp.sub-ja,NTP,0,0,0,,Мазалау
Dialogue: 0,0:06:55.62,0:06:56.95,Style1,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:06:55.73,0:06:56.88,jp.sub-ja,NTP,0,0,0,,Кешіріңіз.
Dialogue: 0,0:06:56.95,0:06:58.62,Style1,,0,0,0,,Қауіпсіздікті кешіріңіз.
Dialogue: 0,0:06:57.05,0:06:58.27,jp.sub-ja,NTP,0,0,0,,(Кёко Хори) Иә, әлі де өзімді жақсы сезінбеймін.
Dialogue: 0,0:06:58.62,0:07:00.96,Style1,,0,0,0,,- Уа! Мұның бәрі ме? - Ой.
Dialogue: 0,0:06:58.95,0:07:00.07,jp.sub-ja,NTP,0,0,0,,Бітті ме?
Dialogue: 0,0:07:00.96,0:07:03.96,Style1,,0,0,0,,Сіз ол жерде шам ілінеді деп күтпеген боларсыз, иә?
Dialogue: 0,0:07:01.14,0:07:03.48,jp.sub-ja,NTP,0,0,0,,Күтпеген жерлерде шамдар төмендейді.
Dialogue: 0,0:07:03.90,0:07:07.87,jp.sub-ja,NTP,0,0,0,,Қарапайым халықтың баспанасына тым жеңіл қарайтын сияқтымыз.
Dialogue: 0,0:07:03.96,0:07:07.97,Style1,,0,0,0,,Біз қарапайым тұрғындардың баспанасына жеткілікті несие бермеген сияқтымыз.
Dialogue: 0,0:07:07.91,0:07:11.32,jp.sub-ja,NTP,0,0,0,,Жарайды, ол кішкентай, сондықтан бәріміз дене шынықтыру сабағына отыруға тырысайық.
Dialogue: 0,0:07:07.97,0:07:09.93,Style1,,0,0,0,,Жарайды, бұл жерде тығыз,
Dialogue: 0,0:07:09.93,0:07:11.64,Style1,,0,0,0,,сондықтан барлығы жаттығу залы үлгісінде отыруға тырысады.
Dialogue: 0,0:07:11.63,0:07:14.43,jp.sub-ja,NTP,0,0,0,,Бұл қарапайым адамдар ойлап тапқан кеңістікті азайту әдісі.
Dialogue: 0,0:07:11.64,0:07:15.31,Style1,,0,0,0,,Бұл қарапайым адамдар кеңістікті қысқарту үшін ойлап тапқан әдіс.
Dialogue: 0,0:07:15.31,0:07:19.31,Style1,,0,0,0,,Тек осыдан өтіңіз. Бұл адамдардан ештеңе күтуге болмайды.
Dialogue: 0,0:07:15.42,0:07:18.98,jp.sub-ja,NTP,0,0,0,,Сабырлы болыңыз. Бұл адамдардан ештеңе күтпеңіз.
Dialogue: 0,0:07:19.31,0:07:20.98,Style1,,0,0,0,,Мен шай қояйын.
Dialogue: 0,0:07:19.32,0:07:20.74,jp.sub-ja,NTP,0,0,0,,Мен саған шай дайындап берейін.
Dialogue: 0,0:07:20.76,0:07:23.65,jp.sub-ja,NTP,0,0,0,,Харухи, шай ішкің келсе, жүр.
Dialogue: 0,0:07:20.98,0:07:22.65,Style1,,0,0,0,,О, Харухи,
Dialogue: 0,0:07:22.65,0:07:25.65,Style1,,0,0,0,,шайға келсек, менде әкеміздің мына қара шайы бар
Dialogue: 0,0:07:24.00,0:07:27.84,jp.sub-ja,NTP,0,0,0,,Әкем сатып алған африкалық сувенир шайы.
Dialogue: 0,0:07:25.65,0:07:27.99,Style1,,0,0,0,,Африкадан кәдесый ретінде сатып алынған. Мұнда.
Dialogue: 0,0:07:27.99,0:07:29.99,Style1,,0,0,0,,О, рахмет.
Dialogue: 0,0:07:28.83,0:07:29.59,jp.sub-ja,NTP,0,0,0,,Рахмет
Dialogue: 0,0:07:29.95,0:07:32.28,jp.sub-ja,NTP,0,0,0,,Сүтті шай маған жарасады, бірақ менде сүт бар.
Dialogue: 0,0:07:29.99,0:07:32.99,Style1,,0,0,0,,Бұл сүтті шай сияқты жақсы. Сізде сүт бар ма?
Dialogue: 0,0:07:32.99,0:07:36.66,Style1,,0,0,0,,Мм-мм, бізде сүт бар...
Dialogue: 0,0:07:33.90,0:07:36.02,jp.sub-ja,NTP,0,0,0,,Сүт бар.
Dialogue: 0,0:07:36.51,0:07:39.66,jp.sub-ja,NTP,0,0,0,,Идиоттар, сендер мен үшін не істедіңдер?
Dialogue: 0,0:07:36.66,0:07:40.00,Style1,,0,0,0,,Ей, ақымақтар! Сіз оған қалай осындай нәрсені жасай аласыз?
Dialogue: 0,0:07:40.00,0:07:40.67,Style1,,0,0,0,,Жер
Dialogue: 0,0:07:40.07,0:07:40.86,jp.sub-ja,NTP,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:07:40.67,0:07:43.94,Style1,,0,0,0,,Сіз Харухиге сол заттарды беріп, оны ұятқа қалдырғыңыз келе ме?
Dialogue: 0,0:07:40.88,0:07:43.76,jp.sub-ja,NTP,0,0,0,,Сіз Харухиге осындай бірдеңе беріп, оны ұятқа қалдырғыңыз келе ме?
Dialogue: 0,0:07:43.94,0:07:47.94,Style1,,0,0,0,,Қараңдар! Қараңызшы, Харухи не істеу керектігін білмей қалды!
Dialogue: 0,0:07:44.03,0:07:47.46,jp.sub-ja,NTP,0,0,0,,Харухидің мазасыз түріне қараңыз.
Dialogue: 0,0:07:47.69,0:07:49.80,jp.sub-ja,NTP,0,0,0,,Менде шәйнек жоқ
Dialogue: 0,0:07:47.94,0:07:49.94,Style1,,0,0,0,,Оның шәйнегі жоқ!
Dialogue: 0,0:07:49.89,0:07:52.26,jp.sub-ja,NTP,0,0,0,,Ал мен оны айта алмаймын
Dialogue: 0,0:07:49.94,0:07:52.28,Style1,,0,0,0,,Және ол бізге бұлай айтуға шыдамайды!
Dialogue: 0,0:07:52.28,0:07:57.28,Style1,,0,0,0,,Х-Харухи, кешіріңіз, бұл шайды қайнатудың қажеті жоқ.
Dialogue: 0,0:07:52.67,0:07:54.31,jp.sub-ja,NTP,0,0,0,,Харухи жаман
Dialogue: 0,0:07:54.83,0:07:56.72,jp.sub-ja,NTP,0,0,0,,Ол шайды қайнатудың қажеті жоқ.
Dialogue: 0,0:07:57.28,0:07:59.62,Style1,,0,0,0,,Су бізге жақсы болады.
Dialogue: 0,0:07:57.46,0:07:59.70,jp.sub-ja,NTP,0,0,0,,Су бізге жақсы.
Dialogue: 0,0:07:59.62,0:08:03.96,Style1,,0,0,0,,Иә? Шынымен бе? Бірақ мен оны жасадым.
Dialogue: 0,0:07:59.74,0:08:01.06,jp.sub-ja,NTP,0,0,0,,Иә?
Dialogue: 0,0:08:01.29,0:08:03.39,jp.sub-ja,NTP,0,0,0,,Бірақ мен оны салып қойғанмын.
Dialogue: 0,0:08:02.49,0:08:03.95,Style2,,0,0,0,,«Кюсу шайнегінде...»
Dialogue: 0,0:08:03.96,0:08:06.29,Style1,,0,0,0,,О, бұл жағдайда, жарайды.
Dialogue: 0,0:08:03.98,0:08:06.09,jp.sub-ja,NTP,0,0,0,,А, жақсы.
Dialogue: 0,0:08:05.86,0:08:11.89,Style2,,0,0,0,,«Жүрек соғысы»
Dialogue: 0,0:08:06.29,0:08:08.63,Style1,,0,0,0,,Ой, бұл жақын болды.
Dialogue: 0,0:08:06.82,0:08:08.49,jp.sub-ja,NTP,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,0:08:08.63,0:08:10.96,Style1,,0,0,0,,Бізді қарапайым халықтың даналығы аздап құтқарды.
Dialogue: 0,0:08:08.71,0:08:11.03,jp.sub-ja,NTP,0,0,0,,Қарапайым халықтың даналығымен әрең құтылдым.
Dialogue: 0,0:08:10.96,0:08:12.30,Style1,,0,0,0,,Сіз қалай айтасыз?
Dialogue: 0,0:08:11.30,0:08:12.11,jp.sub-ja,NTP,0,0,0,,...
Dialogue: 0,0:08:12.30,0:08:15.30,Style1,,0,0,0,,Бұл жерде біздің ортақ біліміміздің ешқайсысы шындыққа жанаспайды.
Dialogue: 0,0:08:12.31,0:08:15.06,jp.sub-ja,NTP,0,0,0,,Біздің жалпы санамыз бұл жерде қолданылмайды.
Dialogue: 0,0:08:15.30,0:08:18.30,Style1,,0,0,0,,Ешқандай айтарымыз жоқ, бірақ біздің кездейсоқ ескертулеріміздің бірі әсер етуі мүмкін
Dialogue: 0,0:08:15.30,0:08:21.64,Style2,,0,0,0,,«Белгісіз кеңістік «Бұл қарапайым әлем»»
Dialogue: 0,0:08:15.51,0:08:16.78,jp.sub-ja,NTP,0,0,0,,Кездейсоқ сөз
Dialogue: 0,0:08:16.82,0:08:20.05,jp.sub-ja,NTP,0,0,0,,Бұл Харухидің жүрегіне көп зақым келтіреді деген сөз емес.
Dialogue: 0,0:08:18.30,0:08:21.64,Style1,,0,0,0,,Харухидің жүрегіне ауыр зақым. Осылайша, бұл шайқаста ...
Dialogue: 0,0:08:20.07,0:08:21.20,jp.sub-ja,NTP,0,0,0,,Басқаша айтқанда, бұл ойын
Dialogue: 0,0:08:21.64,0:08:25.31,Style1,,0,0,0,,...Харухиді ұятқа қалдырған адам жеңілген.
Dialogue: 0,0:08:21.67,0:08:23.96,jp.sub-ja,NTP,0,0,0,,Харухиді ұятқа қалдырған жеңіледі.
Dialogue: 0,0:08:25.31,0:08:27.64,Style2,,0,0,0,,«Әрекетке дайын»
Dialogue: 0,0:08:27.65,0:08:32.98,Style1,,0,0,0,,Мен мұны неге жарысқа айналдыру керек екенін түсінбеймін.
Dialogue: 0,0:08:27.82,0:08:32.41,jp.sub-ja,NTP,0,0,0,,Неліктен бұл жарысқа айналуы керек екенін түсінбеймін.
Dialogue: 0,0:08:32.89,0:08:34.42,jp.sub-ja,NTP,0,0,0,,Шай дайын.
Dialogue: 0,0:08:32.98,0:08:36.99,Style1,,0,0,0,,Шай дайын. Кешіріңіз, шыныаяқтардың бәрі сәйкес келмейді.
Dialogue: 0,0:08:34.64,0:08:37.08,jp.sub-ja,NTP,0,0,0,,Кешіріңіз, менде барлық шыныаяқтар жоқ.
Dialogue: 0,0:08:36.99,0:08:40.99,Style1,,0,0,0,,Жақсы, тым болмағанда ұсақталған тостағандар мен өлшеуіш стақандар жоқ.
Dialogue: 0,0:08:37.10,0:08:40.46,jp.sub-ja,NTP,0,0,0,,Жарайды, бәрібір, ұсақталған тостағандар немесе өлшеуіш стақандар жоқ.
Dialogue: 0,0:08:40.95,0:08:43.30,jp.sub-ja,NTP,0,0,0,,Сіз Хару-чаннан торт таңдай аласыз.
Dialogue: 0,0:08:40.99,0:08:43.66,Style1,,0,0,0,,Хару-чан, сен бірінші тортыңды таңда.
Dialogue: 0,0:08:43.63,0:08:45.46,jp.sub-ja,NTP,0,0,0,,Иә, жақсы ма?
Dialogue: 0,0:08:43.66,0:08:45.66,Style1,,0,0,0,,О, сен сенімдісің бе?
Dialogue: 0,0:08:45.57,0:08:48.70,jp.sub-ja,NTP,0,0,0,,Ештеңе емес, бәрібір мұндайды жеуге үйреніп қалғанбыз.
Dialogue: 0,0:08:45.66,0:08:46.33,Style1,,0,0,0,,Ф-Фатирлеу ештеңе әкелмейді.
Dialogue: 0,0:08:46.33,0:08:48.67,Style1,,0,0,0,,- Өйткені, біз бұл заттарды жеуге үйреніп қалдық. - Жарайды, көрейік...
Dialogue: 0,0:08:46.36,0:08:49.22,jp.sub-ja,NTP,0,0,0,,Олай болса.
Dialogue: 0,0:08:48.67,0:08:49.67,Style1,,0,0,0,,Тынш!
Dialogue: 0,0:08:49.67,0:08:51.34,Style1,,0,0,0,,Сіз оны түсіруге тырысасыз ба?
Dialogue: 0,0:08:49.67,0:08:51.45,jp.sub-ja,NTP,0,0,0,,Мен мұқият болуға тырыстым, бірақ
Dialogue: 0,0:08:51.34,0:08:52.67,Style1,,0,0,0,,Құлпынай.
Dialogue: 0,0:08:51.47,0:08:52.53,jp.sub-ja,NTP,0,0,0,,Құлпынай
Dialogue: 0,0:08:52.56,0:08:53.75,jp.sub-ja,NTP,0,0,0,,Сүйкімді
Dialogue: 0,0:08:52.67,0:08:53.74,Style1,,0,0,0,,Қандай сүйкімді!
Dialogue: 0,0:08:53.74,0:08:55.34,Style1,,0,0,0,,- Өте сүйкімді, бірақ мен қозғала алмаймын! -Жарайды, Хару-чан, сен, Такаши,
Dialogue: 0,0:08:53.74,0:09:00.11,Style2,,0,0,0,,«Шыдамсыз»
Dialogue: 0,0:08:53.80,0:08:55.28,jp.sub-ja,NTP,0,0,0,,Сүйкімді, бірақ қозғала алмайды
Dialogue: 0,0:08:54.16,0:08:59.32,jp.sub-ja,NTP,0,0,0,,Олай болса, Хару-чан екеуміз құлпынай аламыз, сонда жеткілікті...
Dialogue: 0,0:08:55.20,0:08:57.74,jp.sub-ja,NTP,0,0,0,,Мен Харухиге бірдеңе зиян тигізетінін білмеймін.
Dialogue: 0,0:08:55.34,0:08:58.01,Style1,,0,0,0,,- Харухиді не ренжітетінін айту мүмкін емес! - ал менде құлпынай болады,
Dialogue: 0,0:08:57.94,0:09:00.07,jp.sub-ja,NTP,0,0,0,,Қорқыныш үшін қарапайым адамдар әлемінің тұзағы
Dialogue: 0,0:08:58.01,0:09:00.63,Style1,,0,0,0,,- Қарапайым адамдар әлемінің тұзақтары қорқынышты! - ал басқалары қалағанын ала алады.
Dialogue: 0,0:09:04.32,0:09:05.30,Style2,,0,0,0,,«Беріңіз»
Dialogue: 0,0:09:04.68,0:09:06.68,Style1,,0,0,0,,Сізге құлпынай ұнайды ма?
Dialogue: 0,0:09:04.82,0:09:06.53,jp.sub-ja,NTP,0,0,0,,Сізге құлпынай ұнайды ма?
Dialogue: 0,0:09:06.68,0:09:09.52,Style1,,0,0,0,,Иә! Рақмет сізге.
Dialogue: 0,0:09:06.82,0:09:08.94,jp.sub-ja,NTP,0,0,0,,Иә, рақмет.
Dialogue: 0,0:09:11.26,0:09:12.97,jp.sub-ja,NTP,0,0,0,,Әрекет ету дұрыс болды ма?
Dialogue: 0,0:09:11.36,0:09:12.69,Style1,,0,0,0,,Біз шара қолдануымыз керек пе еді!?
Dialogue: 0,0:09:12.69,0:09:14.69,Style1,,0,0,0,,Мен оларды оған бергім келді!
Dialogue: 0,0:09:13.00,0:09:14.82,jp.sub-ja,NTP,0,0,0,,Мен оны саған бергім келді
Dialogue: 0,0:09:14.69,0:09:17.36,Style1,,0,0,0,,Бізді кіргізді!
Dialogue: 0,0:09:14.86,0:09:16.33,jp.sub-ja,NTP,0,0,0,,Түсіндірілді
Dialogue: 0,0:09:17.36,0:09:21.03,Style1,,0,0,0,,Аа, анау тортты жегеннен кейін мен аздап ашуланып барамын.
Dialogue: 0,0:09:18.00,0:09:20.70,jp.sub-ja,NTP,0,0,0,,Мен торт жегеннен кейін аштық сезінемін.
Dialogue: 0,0:09:21.03,0:09:23.03,Style1,,0,0,0,,Енді сіз айтып отырсаңыз, түскі ас уақытынан әлдеқашан өтіп кетті.
Dialogue: 0,0:09:21.06,0:09:23.18,jp.sub-ja,NTP,0,0,0,,Айтпақшы, түстен асып кетті.
Dialogue: 0,0:09:23.03,0:09:24.70,Style1,,0,0,0,,- Түскі ас дайын ба? - Түскі ас дайын ба?
Dialogue: 0,0:09:23.23,0:09:24.33,jp.sub-ja,NTP,0,0,0,,Әлі түс
Dialogue: 0,0:09:24.70,0:09:28.37,Style1,,0,0,0,,Өтінемін, сіз соншалықты қиялсыз өмір сүруді тоқтата аласыз ба?
Dialogue: 0,0:09:24.78,0:09:27.94,jp.sub-ja,NTP,0,0,0,,Өтінемін, сіз шексіз еркін өмір сүруді тоқтата аласыз ба?
Dialogue: 0,0:09:28.30,0:09:30.70,jp.sub-ja,NTP,0,0,0,,Міне, мен кенет барған жерім осы.
Dialogue: 0,0:09:28.37,0:09:31.04,Style1,,0,0,0,,Енді біз сізге ескертусіз кіріп кеткенбіз,
Dialogue: 0,0:09:31.04,0:09:32.38,Style1,,0,0,0,,сондықтан біз ақшаны саламыз.
Dialogue: 0,0:09:31.18,0:09:32.22,jp.sub-ja,NTP,0,0,0,,Ақшаны жұмсайық
Dialogue: 0,0:09:32.38,0:09:34.71,Style1,,0,0,0,,Неліктен сүйікті сушиге немесе басқа нәрсеге тапсырыс бермеске?
Dialogue: 0,0:09:32.53,0:09:34.67,jp.sub-ja,NTP,0,0,0,,Сіздің сүйікті сушиіңізді ішсем қалай болады?
Dialogue: 0,0:09:34.71,0:09:36.38,Style1,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:09:35.23,0:09:38.28,jp.sub-ja,NTP,0,0,0,,Жарайды, мен Кёуя-сенпайдан емделуін өтінемін.
Dialogue: 0,0:09:36.38,0:09:39.72,Style1,,0,0,0,,Кёя-сенпай, егер ол сенен болса, мен одан кейін қорқамын.
Dialogue: 0,0:09:38.30,0:09:39.38,jp.sub-ja,NTP,0,0,0,,Себебі мен алда не болады деп қорқамын
Dialogue: 0,0:09:39.72,0:09:45.32,Style1,,0,0,0,,Уайымдама. Бұл аукционға қойған сіздің фотоларыңыздың сатылымынан шыққан.
Dialogue: 0,0:09:39.74,0:09:45.08,jp.sub-ja,NTP,0,0,0,,Уайымдамаңыз, бұл сіздің шынайы суретіңіздің аукционынан түскен түсім.
Dialogue: 0,0:09:45.19,0:09:47.51,jp.sub-ja,NTP,0,0,0,,Бұл мен ғана
Dialogue: 0,0:09:45.32,0:09:47.32,Style1,,0,0,0,,Олай болса, бұл шынымен маған қатысты емес пе?
Dialogue: 0,0:09:47.32,0:09:51.66,Style1,,0,0,0,,Жарайды. Менің жақын жерде жақсы суши дүкенін басқаратын досым бар,
Dialogue: 0,0:09:47.54,0:09:51.75,jp.sub-ja,NTP,0,0,0,,Жарайды, жақын жерде мен білетін жақсы суши мейрамханасы бар.
Dialogue: 0,0:09:51.66,0:09:55.50,Style1,,0,0,0,,сондықтан мен оларға қоңырау шаламын. Оларда жоғары сапалы заттар болады.
Dialogue: 0,0:09:51.80,0:09:52.79,jp.sub-ja,NTP,0,0,0,,Мен сізге қоңырау шаламын.
Dialogue: 0,0:09:53.33,0:09:54.71,jp.sub-ja,NTP,0,0,0,,Ол жерде өте жақсы.
Dialogue: 0,0:09:59.00,0:10:01.67,Style1,,0,0,0,,«Суши пакетінде «премиум» болса да,
Dialogue: 0,0:09:59.21,0:10:03.56,jp.sub-ja,NTP,0,0,0,,Қаптамадағы суши «арнайы» деп белгіленген болса да, бұл оның жоғары санатты екенін білдірмейді.
Dialogue: 0,0:10:01.67,0:10:05.23,Style1,,0,0,0,,оны «жоғары сапалы» деп атауға болмайды. Өте сақ болыңыз».
Dialogue: 0,0:10:03.71,0:10:04.82,jp.sub-ja,NTP,0,0,0,,Абайлаңыз
Dialogue: 0,0:10:06.61,0:10:07.13,Style2,,0,0,0,,«Қоқыс себеті»
Dialogue: 0,0:10:07.30,0:10:10.36,jp.sub-ja,NTP,0,0,0,,Мен білемін, бәрібір.
Dialogue: 0,0:10:07.34,0:10:10.68,Style1,,0,0,0,,Мен соншалықты көп білемін.
Dialogue: 0,0:10:10.45,0:10:16.15,Style2,,0,0,0,,«Әбігер»
Dialogue: 0,0:10:10.68,0:10:12.02,Style1,,0,0,0,,Аа, тентек!
Dialogue: 0,0:10:11.98,0:10:16.04,jp.sub-ja,NTP,0,0,0,,Әкең сені ұятқа қалдырмау үшін бейқам кейіп танытты.
Dialogue: 0,0:10:12.02,0:10:16.19,Style1,,0,0,0,,Әкем сізді ұятқа қалдырмау үшін тіпті кездейсоқ әрекет етуге тырысты!
Dialogue: 0,0:10:16.19,0:10:19.36,Style1,,0,0,0,,Мен сенен бірдеңе жасатқым келеді, Хару-чан.
Dialogue: 0,0:10:16.36,0:10:19.33,jp.sub-ja,NTP,0,0,0,,Мен Хару-чанның тағамын жегім келеді.
Dialogue: 0,0:10:19.36,0:10:20.69,Style1,,0,0,0,,Бал сенпай!
Dialogue: 0,0:10:19.38,0:10:20.55,jp.sub-ja,NTP,0,0,0,,Бал-сенпай
Dialogue: 0,0:10:20.61,0:10:22.37,jp.sub-ja,NTP,0,0,0,,Қандай батыл сөз.
Dialogue: 0,0:10:20.69,0:10:22.36,Style1,,0,0,0,,Қандай батыл сөз!
Dialogue: 0,0:10:22.36,0:10:24.70,Style1,,0,0,0,,Біз өзімізді ұстадық!
Dialogue: 0,0:10:22.53,0:10:24.53,jp.sub-ja,NTP,0,0,0,,Тіпті біз ұстандық.
Dialogue: 0,0:10:24.70,0:10:27.70,Style1,,0,0,0,,Бұл жақсы, бірақ қазір бастаудың өзінде біраз уақыт қажет.
Dialogue: 0,0:10:24.76,0:10:27.76,jp.sub-ja,NTP,0,0,0,,Бұл жақсы, бірақ қазірден бастап біраз уақыт алады.
Dialogue: 0,0:10:27.70,0:10:29.03,Style1,,0,0,0,,Біз күтеміз!
Dialogue: 0,0:10:27.83,0:10:29.01,jp.sub-ja,NTP,0,0,0,,Күту
Dialogue: 0,0:10:29.03,0:10:31.04,Style1,,0,0,0,,Мүмкін біз одан сұрауымыз керек еді!
Dialogue: 0,0:10:29.07,0:10:31.23,jp.sub-ja,NTP,0,0,0,,Бұлай айту дұрыс болды ма?
Dialogue: 0,0:10:31.04,0:10:34.37,Style1,,0,0,0,,Біз Харухидің тағамын жейміз!
Dialogue: 0,0:10:31.23,0:10:34.23,jp.sub-ja,NTP,0,0,0,,Харухидің үйдегі тағамдарын жеуге болады.
Dialogue: 0,0:10:34.37,0:10:37.04,Style1,,0,0,0,,Жарайды, мен қайтадан супермаркетке баруым керек.
Dialogue: 0,0:10:34.56,0:10:37.02,jp.sub-ja,NTP,0,0,0,,Сосын тағы супермаркетке баруым керек.
Dialogue: 0,0:10:37.04,0:10:38.04,Style1,,0,0,0,,О, мен келемін.
Dialogue: 0,0:10:37.06,0:10:38.10,jp.sub-ja,NTP,0,0,0,,Бару
Dialogue: 0,0:10:38.04,0:10:40.38,Style1,,0,0,0,,Біз де қарапайым супермаркетке келгіміз келеді.
Dialogue: 0,0:10:38.17,0:10:40.18,jp.sub-ja,NTP,0,0,0,,Біз де қарапайым халық супермаркетіне барғымыз келеді
Dialogue: 0,0:10:40.26,0:10:41.77,jp.sub-ja,NTP,0,0,0,,Мен де, мен де
Dialogue: 0,0:10:40.38,0:10:41.88,Style1,,0,0,0,,Мен де! Мен де!
Dialogue: 0,0:10:41.65,0:10:43.37,Style2,,0,0,0,,«Бәрі барады»
Dialogue: 0,0:10:41.84,0:10:43.48,jp.sub-ja,NTP,0,0,0,,Бұл жақсы тәжірибе болуы мүмкін.
Dialogue: 0,0:10:41.88,0:10:43.65,Style1,,0,0,0,,Бұл жақсы тәжірибе болуы мүмкін.
Dialogue: 0,0:10:43.65,0:10:46.98,Style1,,0,0,0,,Иә! Қарапайым супермаркет, қарапайым адамдар супермаркети!
Dialogue: 0,0:10:43.66,0:10:46.69,jp.sub-ja,NTP,0,0,0,,Вай кәдімгі супер кәдімгі супер
Dialogue: 0,0:10:46.91,0:10:48.35,jp.sub-ja,NTP,0,0,0,,Бұл қызық
Dialogue: 0,0:10:46.98,0:10:48.99,Style1,,0,0,0,,Бұл қызық емес пе?
Dialogue: 0,0:10:48.99,0:10:53.66,Style1,,0,0,0,,Қандай пайдасы бар? Мен демалыс күнімнен бас тартамын деп ойлаймын.
Dialogue: 0,0:10:49.41,0:10:52.81,jp.sub-ja,NTP,0,0,0,,Менің қолымнан келмейді, мен бүгін демалысымды тастауым керек.
Dialogue: 0,0:10:53.63,0:10:56.38,jp.sub-ja,NTP,0,0,0,,Сенпай, бармайсың ба?
Dialogue: 0,0:10:53.66,0:10:55.33,Style1,,0,0,0,,Сенпай?
Dialogue: 0,0:10:55.33,0:10:56.66,Style1,,0,0,0,,Келмейсің бе?
Dialogue: 0,0:10:56.66,0:10:58.66,Style1,,0,0,0,,Иә, мен келемін.
Dialogue: 0,0:10:57.36,0:11:00.79,jp.sub-ja,NTP,0,0,0,,Мен барамын, бірақ оған дейін анаңа сәлем айтқым келеді.
Dialogue: 0,0:10:58.66,0:11:01.33,Style1,,0,0,0,,Әйтсе де, мен сіздің анаңызға құрметімді білдіремін.
Dialogue: 0,0:11:01.20,0:11:03.78,jp.sub-ja,NTP,0,0,0,,Бұл үшін кешіріңіз.
Dialogue: 0,0:11:01.33,0:11:04.60,Style1,,0,0,0,,Осылай қиындыққа тап болғаныңыз үшін рахмет.
Dialogue: 0,0:11:06.00,0:11:08.34,Style1,,0,0,0,,Харухи, сен анаңның артынан кетесің, иә?
Dialogue: 0,0:11:06.09,0:11:07.69,jp.sub-ja,NTP,0,0,0,,Харухи анасына ұқсайды.
Dialogue: 0,0:11:08.21,0:11:10.43,jp.sub-ja,NTP,0,0,0,,Иә, әкем де солай дейді.
Dialogue: 0,0:11:08.34,0:11:11.01,Style1,,0,0,0,,Иә, менің әкем де солай дейді.
Dialogue: 0,0:11:11.01,0:11:14.68,Style1,,0,0,0,,Ол әдемі еді. Ол да ақылды көрінеді.
Dialogue: 0,0:11:11.13,0:11:13.95,jp.sub-ja,NTP,0,0,0,,Ол әдемі және ақылды көрінеді.
Dialogue: 0,0:11:14.68,0:11:17.01,Style1,,0,0,0,,Мен оның әдемі немесе әдемі емес екенін білмеймін,
Dialogue: 0,0:11:14.74,0:11:18.43,jp.sub-ja,NTP,0,0,0,,Әдемі екенін білмеймін, бірақ ол заңгер еді.
Dialogue: 0,0:11:17.01,0:11:18.68,Style1,,0,0,0,,бірақ ол заңгер болды.
Dialogue: 0,0:11:18.68,0:11:21.82,Style1,,0,0,0,,О, мен оның да өте қабілетті болғанына сенімдімін.
Dialogue: 0,0:11:19.34,0:11:21.32,jp.sub-ja,NTP,0,0,0,,Ол өте дарынды болса керек.
Dialogue: 0,0:11:21.82,0:11:24.02,Style1,,0,0,0,,Бұл көздерді алдай алмайсың.
Dialogue: 0,0:11:21.88,0:11:23.59,jp.sub-ja,NTP,0,0,0,,Менің көзімде ешнәрсе жоқ
Dialogue: 0,0:11:23.91,0:11:26.24,jp.sub-ja,NTP,0,0,0,,Мен сенің ағаңның қандай екенін білмеймін, бірақ
Dialogue: 0,0:11:24.02,0:11:27.01,Style1,,0,0,0,,Сенпай, сенің көзің туралы ештеңе айтпаймын...
Dialogue: 0,0:11:28.03,0:11:30.03,Style1,,0,0,0,,...бірақ...
Dialogue: 0,0:11:30.03,0:11:35.99,Style1,,0,0,0,,Харухи, ана бүгін барын салады, сондықтан біз жеңеміз!
Dialogue: 0,0:11:30.10,0:11:33.46,jp.sub-ja,NTP,0,0,0,,Харухи ана, мен бар күшімді саламын.
Dialogue: 0,0:11:33.89,0:11:35.27,jp.sub-ja,NTP,0,0,0,,Бүгін де жеңіңіз
Dialogue: 0,0:11:38.04,0:11:40.56,Style1,,0,0,0,,...Менің ойымша, ол болды.
Dialogue: 0,0:11:38.20,0:11:39.84,jp.sub-ja,NTP,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:11:43.83,0:11:47.45,jp.sub-ja,NTP,0,0,0,,Сіз барлығын күтуге мәжбүрлейсіз. Баратын кез келді.
Dialogue: 0,0:11:43.97,0:11:47.93,Style1,,0,0,0,,W-біз барлығын күтеміз. Барсақ қайтеді?
Dialogue: 0,0:11:52.43,0:11:53.41,jp.sub-ja,NTP,0,0,0,,Бұл
Dialogue: 0,0:11:52.65,0:11:54.32,Style1,,0,0,0,,Ия...
Dialogue: 0,0:11:54.32,0:11:55.65,Style1,,0,0,0,,Кешіріңіз, Харухи!
Dialogue: 0,0:11:54.33,0:11:55.38,jp.sub-ja,NTP,0,0,0,,Кешіріңіз, Харухи
Dialogue: 0,0:11:55.63,0:11:57.80,jp.sub-ja,NTP,0,0,0,,Ауырлығы жоқ
Dialogue: 0,0:11:55.65,0:11:57.99,Style1,,0,0,0,,Жарайды, сен ауырсың...
Dialogue: 0,0:11:57.87,0:11:59.58,jp.sub-ja,NTP,0,0,0,,Енді Харухи
Dialogue: 0,0:11:57.99,0:12:02.33,Style1,,0,0,0,,Мен үйдемін, Харухи! Неге есік ашық?
Dialogue: 0,0:11:59.71,0:12:01.27,jp.sub-ja,NTP,0,0,0,,Неге есікті ашық қалдырасың?
Dialogue: 0,0:12:02.33,0:12:04.59,Style1,,0,0,0,,Әке...
Dialogue: 0,0:12:02.37,0:12:03.36,jp.sub-ja,NTP,0,0,0,,Әкем
Dialogue: 0,0:12:16.90,0:12:18.89,jp.sub-ja,NTP,0,0,0,,Әкесі кенет үйге келді
Dialogue: 0,0:12:17.01,0:12:20.68,Style1,,0,0,0,,- Кенет оның әкесі үйге келді... ...транни барындағы ауысымынан.
Dialogue: 0,0:12:18.31,0:12:20.68,Style2,,0,0,0,,"Ранка, шын аты: Рйодзи Фудзиока (35)"
Dialogue: 0,0:12:18.89,0:12:20.19,jp.sub-ja,NTP,0,0,0,,Гей-барда жұмыс істеу
Dialogue: 0,0:12:20.68,0:12:23.01,Style1,,0,0,0,,- Ол қызының итеріп жатқанын көрді... ...не солай көрінді...
Dialogue: 0,0:12:20.74,0:12:21.86,jp.sub-ja,NTP,0,0,0,,Төмен басылды
Dialogue: 0,0:12:21.88,0:12:23.03,jp.sub-ja,NTP,0,0,0,,Ол сияқты көрінеді
Dialogue: 0,0:12:23.01,0:12:24.35,Style1,,0,0,0,,... еденде,
Dialogue: 0,0:12:23.06,0:12:23.76,jp.sub-ja,NTP,0,0,0,,Қызым
Dialogue: 0,0:12:24.35,0:12:26.68,Style1,,0,0,0,,- ұстап тұру... ...немесе солай көрінді...
Dialogue: 0,0:12:24.43,0:12:25.53,jp.sub-ja,NTP,0,0,0,,Төмен итеру
Dialogue: 0,0:12:25.58,0:12:26.66,jp.sub-ja,NTP,0,0,0,,Ол сияқты көрінеді
Dialogue: 0,0:12:26.68,0:12:28.35,Style1,,0,0,0,,... бейтаныс бала.
Dialogue: 0,0:12:26.73,0:12:27.92,jp.sub-ja,NTP,0,0,0,,Бейтаныс адам
Dialogue: 0,0:12:28.35,0:12:33.36,Style1,,0,0,0,,``Әке''? Бұл транни Харухидің әкесі екенін білдіре ме?
Dialogue: 0,0:12:28.46,0:12:30.40,jp.sub-ja,NTP,0,0,0,,Әке болу деген нені білдіреді?
Dialogue: 0,0:12:30.49,0:12:33.35,jp.sub-ja,NTP,0,0,0,,Бұл сұм жігіт Харухидің әкесі екенін білдіре ме?
Dialogue: 0,0:12:31.79,0:12:35.89,Style2,,0,0,0,,«Тамаки жағдайдың не екенін бірден түсінді».
Dialogue: 0,0:12:33.36,0:12:35.88,Style1,,0,0,0,,Әке, үйге қош келдіңіз.
Dialogue: 0,0:12:33.40,0:12:35.70,jp.sub-ja,NTP,0,0,0,,Әке, үйге келіңізші.
Dialogue: 0,0:12:38.03,0:12:41.03,Style1,,0,0,0,,Тек сабырлы болыңыз. Бұл жай ғана апат болды.
Dialogue: 0,0:12:38.09,0:12:41.04,jp.sub-ja,NTP,0,0,0,,Сабыр ет, мен, бұл оқыс оқиға болды.
Dialogue: 0,0:12:41.03,0:12:44.13,Style1,,0,0,0,,Не болғанын түсіндірсем, ол түсінеді.
Dialogue: 0,0:12:41.08,0:12:43.58,jp.sub-ja,NTP,0,0,0,,Дұрыс түсіндіріп берсең адамдар түсінеді
Dialogue: 0,0:12:47.64,0:12:48.97,Style1,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:12:47.78,0:12:51.38,jp.sub-ja,NTP,0,0,0,,Кешіріңіз, мен сізді кеше түнде үйде жалғыз қалдырдым.
Dialogue: 0,0:12:48.97,0:12:51.31,Style1,,0,0,0,,...кеше түнде сені үйде жалғыз қалдырғаны үшін.
Dialogue: 0,0:12:51.31,0:12:52.64,Style1,,0,0,0,,Сіз жалғыз болған шығарсыз.
Dialogue: 0,0:12:51.42,0:12:52.72,jp.sub-ja,NTP,0,0,0,,Мен жалғыз болған шығармын
Dialogue: 0,0:12:52.64,0:12:54.98,Style1,,0,0,0,,Бұл шынымен жаман естіледі...
Dialogue: 0,0:12:54.92,0:12:56.32,jp.sub-ja,NTP,0,0,0,,Маған ұнамайды
Dialogue: 0,0:12:54.98,0:12:58.98,Style1,,0,0,0,,Әй, шырағым, сол қолым ауырып тұр, жаңа ғана құлатқандай
Dialogue: 0,0:12:56.34,0:13:01.95,jp.sub-ja,NTP,0,0,0,,Ғасырдың ең үлкен аңын жұдырықтай жұдырықтай салғандай сол қолым ауырады.
Dialogue: 0,0:12:58.98,0:13:01.65,Style1,,0,0,0,,ғасырдың ең үлкен аңы.
Dialogue: 0,0:13:01.65,0:13:04.66,Style1,,0,0,0,,- Мм... Әке... - Мүмкін мен қатты жұмыс істеп жатқан шығармын.
Dialogue: 0,0:13:01.70,0:13:04.61,jp.sub-ja,NTP,0,0,0,,Әке.
Dialogue: 0,0:13:02.17,0:13:04.00,jp.sub-ja,NTP,0,0,0,,Мүмкін мен тым көп жұмыс істеп жатқан шығармын
Dialogue: 0,0:13:04.61,0:13:06.66,jp.sub-ja,NTP,0,0,0,,Мен ыстық шай ішкім келеді.
Dialogue: 0,0:13:04.66,0:13:06.99,Style1,,0,0,0,,Мен ыстық шай алғым келеді.
Dialogue: 0,0:13:06.99,0:13:07.66,Style1,,0,0,0,,Басқа серіктес және серіктес емес ғибадатханалардың көмегімен бөгеттерді тұрғызғаннан кейін,
Dialogue: 0,0:13:07.04,0:13:08.62,jp.sub-ja,NTP,0,0,0,,Иә шай
Dialogue: 0,0:13:07.66,0:13:10.66,Style1,,0,0,0,,Т-шай! Харухи, сен суыңды отынмен қайнатасың ба?
Dialogue: 0,0:13:07.66,0:13:11.89,Style2,,0,0,0,,«Барлық жерде!»
Dialogue: 0,0:13:08.64,0:13:10.54,jp.sub-ja,NTP,0,0,0,,Харухи: Отынмен су қайнатуға болады ма?
Dialogue: 0,0:13:10.60,0:13:12.15,jp.sub-ja,NTP,0,0,0,,Отынды қайда қою керек?
Dialogue: 0,0:13:10.66,0:13:12.33,Style1,,0,0,0,,Отынды қайда қою керек?
Dialogue: 0,0:13:12.23,0:13:16.50,jp.sub-ja,NTP,0,0,0,,Маған ұнамайды. Мен үлкен зиянкес таптым.
Dialogue: 0,0:13:12.33,0:13:16.67,Style1,,0,0,0,,Әй, шырағым, мен үлкен зиянкес тапқан сияқтымын.
Dialogue: 0,0:13:16.62,0:13:20.70,jp.sub-ja,NTP,0,0,0,,Содан бері қанша қызды шақырдыңыз?
Dialogue: 0,0:13:16.67,0:13:18.67,Style1,,0,0,0,,Неліктен құрметті тастап кеттіңіз?
Dialogue: 0,0:13:18.67,0:13:20.67,Style1,,0,0,0,,қызыма сөз бергенде!?
Dialogue: 0,0:13:20.67,0:13:22.34,Style1,,0,0,0,,Мырза, сіз соншалықты ұзаққа бардыңыз, біз...
Dialogue: 0,0:13:20.70,0:13:23.18,jp.sub-ja,NTP,0,0,0,,Мырза, мен сізді жақында келмейді деп ойладым.
Dialogue: 0,0:13:22.34,0:13:26.34,Style1,,0,0,0,,О, біздің астымыздан өтіп бара жатқан жігіт Харухидің папасы ғой.
Dialogue: 0,0:13:22.36,0:13:25.85,jp.sub-ja,NTP,0,0,0,,А, мен төменге бір-бірімнен өтіп кеттім. Бұл Харухидің әкесі болатын.
Dialogue: 0,0:13:25.88,0:13:28.25,jp.sub-ja,NTP,0,0,0,,Жарық Каору Аспанның көмегі
Dialogue: 0,0:13:26.34,0:13:29.01,Style1,,0,0,0,,Хикару! Каору! Бұл Құдайдың араласуы!
Dialogue: 0,0:13:28.28,0:13:28.64,Style2,,0,0,0,,«Хикару» «Каору»
Dialogue: 0,0:13:28.87,0:13:30.16,jp.sub-ja,NTP,0,0,0,,Сәлем
Dialogue: 0,0:13:29.01,0:13:33.68,Style1,,0,0,0,,Сәлем. Біз Харухи-санның жақсы достарымыз, ағайынды Хитачииндер.
Dialogue: 0,0:13:30.27,0:13:33.61,jp.sub-ja,NTP,0,0,0,,Біз Харухидің ең жақын достарымыз, ағайынды Хитачииндер.
Dialogue: 0,0:13:33.67,0:13:35.48,jp.sub-ja,NTP,0,0,0,,Сенің әкең сұмдық па?
Dialogue: 0,0:13:33.68,0:13:35.35,Style1,,0,0,0,,Папа-сан, сен траншейсің бе?
Dialogue: 0,0:13:35.35,0:13:38.02,Style1,,0,0,0,,Сіз біз көрген алғашқы шынайы траннисіз.
Dialogue: 0,0:13:35.55,0:13:37.91,jp.sub-ja,NTP,0,0,0,,Мен алғаш рет нағыз сұмдықты көрдім
Dialogue: 0,0:13:38.02,0:13:40.69,Style1,,0,0,0,,Мырза, сіз ақырында Харухиге қимыл жасадыңыз ба?
Dialogue: 0,0:13:38.11,0:13:40.66,jp.sub-ja,NTP,0,0,0,,Мырза, мен ақыры Харухиге қолымды қойдым.
Dialogue: 0,0:13:40.69,0:13:43.96,Style1,,0,0,0,,Бұл үшін кешіріңіз. Бұл жігіт жүнге боялған ханымдар жігіті.
Dialogue: 0,0:13:40.82,0:13:43.91,jp.sub-ja,NTP,0,0,0,,Кешіріңіз, бұл жігіт стильді әйелдерді ұнатады.
Dialogue: 0,0:13:43.93,0:13:48.10,jp.sub-ja,NTP,0,0,0,,Мен ойнаған әйел маған қарағанда капиллярлары көп феромондық аппарат болды.
Dialogue: 0,0:13:43.96,0:13:45.30,Style1,,0,0,0,,Ол феромондық машина,
Dialogue: 0,0:13:45.30,0:13:48.30,Style1,,0,0,0,,кім капиллярлары көп қыздармен алданып қалды.
Dialogue: 0,0:13:48.16,0:13:49.92,jp.sub-ja,NTP,0,0,0,,Ойын
Dialogue: 0,0:13:48.30,0:13:49.97,Style1,,0,0,0,,Алданып қалдыңыз ба?
Dialogue: 0,0:13:49.94,0:13:51.99,jp.sub-ja,NTP,0,0,0,,Жоқ. Кім ойнап жатыр?
Dialogue: 0,0:13:49.97,0:13:54.31,Style1,,0,0,0,,Жоқ! Кімді алдады дейсің!? мен шын жүректен...
Dialogue: 0,0:13:52.06,0:13:54.17,jp.sub-ja,NTP,0,0,0,,Мен байсалдымын
Dialogue: 0,0:13:54.31,0:13:55.97,Style1,,0,0,0,,А? Ол махаббатын мойындап жатыр ма?
Dialogue: 0,0:13:54.81,0:13:55.71,jp.sub-ja,NTP,0,0,0,,(Миямура) Хмм… сол тү не жайлы еді…
Dialogue: 0,0:13:55.91,0:13:59.90,jp.sub-ja,NTP,0,0,0,,Мен сенің қызыңды өз қызымдай көремін.
Dialogue: 0,0:13:55.97,0:14:01.00,Style1,,0,0,0,,...қызыңды менің туған қызымдай ойла!
Dialogue: 0,0:14:03.35,0:14:06.35,Style2,,0,0,0,,«Харухидің әкесінің Тамаки туралы алғашқы әсері»
Dialogue: 0,0:14:06.35,0:14:07.65,Style2,,0,0,0,,«Ол ақымақ»
Dialogue: 0,0:14:08.56,0:14:12.32,jp.sub-ja,NTP,0,0,0,,Түсіндім, балалар, сіз қауесет клубы екенсіздер.
Dialogue: 0,0:14:08.65,0:14:12.32,Style1,,0,0,0,,көремін. Сіз мен естіген Хост клубысыз.
Dialogue: 0,0:14:12.32,0:14:15.03,Style1,,0,0,0,,Сіз шынымен де тамаша ұлдар тобысыз.
Dialogue: 0,0:14:12.56,0:14:14.93,jp.sub-ja,NTP,0,0,0,,Өте жақсы балалар.
Dialogue: 0,0:14:14.98,0:14:16.98,jp.sub-ja,NTP,0,0,0,,Қай баланы таңдарымды білмей абдырап қалдым.
Dialogue: 0,0:14:15.03,0:14:16.99,Style1,,0,0,0,,Мен сендердің қайсысыңды аларымды білмеймін.
Dialogue: 0,0:14:16.99,0:14:18.33,Style1,,0,0,0,,Иә, Харухи?
Dialogue: 0,0:14:17.00,0:14:18.14,jp.sub-ja,NTP,0,0,0,,Сәлем Харухи
Dialogue: 0,0:14:18.33,0:14:21.67,Style1,,0,0,0,,О, сен мені Ранка-сан деп атасаң болады.
Dialogue: 0,0:14:18.83,0:14:21.78,jp.sub-ja,NTP,0,0,0,,Сіз мені Ранка-сан деп атай аласыз.
Dialogue: 0,0:14:21.67,0:14:25.34,Style1,,0,0,0,,"Ранка" - мен жұмыс істейтін транни барда қолданатын кәсіби атау.
Dialogue: 0,0:14:21.87,0:14:25.30,jp.sub-ja,NTP,0,0,0,,Ранка - мен жұмыс істейтін гей-бардағы Генджидің аты.
Dialogue: 0,0:14:25.32,0:14:27.64,jp.sub-ja,NTP,0,0,0,,Гэндзи есімі сахналық есім сияқты.
Dialogue: 0,0:14:25.34,0:14:27.67,Style1,,0,0,0,,Кәсіби аты? Сахналық атау сияқты ма?
Dialogue: 0,0:14:27.67,0:14:29.34,Style1,,0,0,0,,Дұрыс, Мицукуни-кун.
Dialogue: 0,0:14:27.69,0:14:29.20,jp.sub-ja,NTP,0,0,0,,Дұрыс, Мицукуни-кун.
Dialogue: 0,0:14:29.33,0:14:31.44,jp.sub-ja,NTP,0,0,0,,Менің атымды қайдан білесің?
Dialogue: 0,0:14:29.34,0:14:32.34,Style1,,0,0,0,,Иә? Менің атымды қайдан білесің?
Dialogue: 0,0:14:32.28,0:14:35.48,jp.sub-ja,NTP,0,0,0,,Такаши Харунозука үшінші курс студенті Ханинозукаға
Dialogue: 0,0:14:32.34,0:14:36.01,Style1,,0,0,0,,3-курс Ханинозука- кун мен Моринозука Такаши- кун...
Dialogue: 0,0:14:36.01,0:14:38.35,Style1,,0,0,0,,Ал сіз Харухимен бір сыныпта оқитын 1-курс болар едіңіз,
Dialogue: 0,0:14:36.18,0:14:38.45,jp.sub-ja,NTP,0,0,0,,Сондай-ақ, мен Харухимен бір сыныпта оқитын бірінші курс студентімін.
Dialogue: 0,0:14:38.35,0:14:41.35,Style1,,0,0,0,,Хитачиин Хикару-кун мен Каору-кун, солай ма?
Dialogue: 0,0:14:38.50,0:14:41.27,jp.sub-ja,NTP,0,0,0,,Хитачиин Хикару-кун Каору-кун.
Dialogue: 0,0:14:41.35,0:14:43.29,Style1,,0,0,0,,Қайсыларың қайсысыңдар, қызық...
Dialogue: 0,0:14:41.43,0:14:42.93,jp.sub-ja,NTP,0,0,0,,Қайсысы қайсысы?
Dialogue: 0,0:14:43.25,0:14:45.04,jp.sub-ja,NTP,0,0,0,,Мен үнемі сөйлесемін және тыңдаймын.
Dialogue: 0,0:14:43.29,0:14:45.29,Style1,,0,0,0,,Мен әрқашан сен туралы әңгімелер естимін.
Dialogue: 0,0:14:45.29,0:14:47.29,Style1,,0,0,0,,Иә? Харухи біз туралы айтады ма?
Dialogue: 0,0:14:45.76,0:14:47.42,jp.sub-ja,NTP,0,0,0,,Харухи біздің тарихымызды айтып береді
Dialogue: 0,0:14:47.29,0:14:50.96,Style1,,0,0,0,,Мм-мм, бұл әрқашан Кёя-куннан, телефонда.
Dialogue: 0,0:14:48.62,0:14:50.63,jp.sub-ja,NTP,0,0,0,,Кёуя маған үнемі телефон соғады.
Dialogue: 0,0:14:50.96,0:14:53.30,Style1,,0,0,0,,Ранка-сан, сен шынымен әдемісің.
Dialogue: 0,0:14:50.98,0:14:53.39,jp.sub-ja,NTP,0,0,0,,Ранка-сан әдемі екен.
Dialogue: 0,0:14:53.30,0:14:54.30,Style1,,0,0,0,,Не!?
Dialogue: 0,0:14:53.46,0:14:54.34,jp.sub-ja,NTP,0,0,0,,Қалай
Dialogue: 0,0:14:54.30,0:14:55.30,Style1,,0,0,0,,Киоя...
Dialogue: 0,0:14:54.39,0:14:55.31,jp.sub-ja,NTP,0,0,0,,Кагами түні
Dialogue: 0,0:14:55.30,0:14:58.30,Style1,,0,0,0,,Біз оның асыл қызына қараймыз.
Dialogue: 0,0:14:55.36,0:14:58.04,jp.sub-ja,NTP,0,0,0,,Мен сенің асыл қызыңды асыраймын.
Dialogue: 0,0:14:58.24,0:15:02.00,jp.sub-ja,NTP,0,0,0,,Сәлемдесу және мерзімді есептер берілген.
Dialogue: 0,0:14:58.30,0:14:59.77,Style1,,0,0,0,,Сәлем беруім табиғи нәрсе,
Dialogue: 0,0:14:59.77,0:15:02.31,Style1,,0,0,0,,және ол туралы мерзімді есептерді беріңіз, солай ма?
Dialogue: 0,0:15:02.30,0:15:05.05,jp.sub-ja,NTP,0,0,0,,Бұл сіздің жұмысыңыз болуы керек еді.
Dialogue: 0,0:15:02.31,0:15:05.31,Style1,,0,0,0,,Әдетте бұл сіздің жұмысыңыз болуы керек, солай ма?
Dialogue: 0,0:15:05.14,0:15:07.70,jp.sub-ja,NTP,0,0,0,,Сіз шынымен жақсы жұмыс істедіңіз, мырза.
Dialogue: 0,0:15:05.31,0:15:07.98,Style1,,0,0,0,,Сіз шынымен жақсы клуб президентісіз.
Dialogue: 0,0:15:07.86,0:15:10.74,jp.sub-ja,NTP,0,0,0,,Ой, қызық, Кюя-кун менеджердің орынбасары болды ма?
Dialogue: 0,0:15:07.98,0:15:10.65,Style1,,0,0,0,,О, Кёя-кун, сен вице-президентсің, солай емес пе?
Dialogue: 0,0:15:10.65,0:15:13.32,Style1,,0,0,0,,Демек, президент көп нәрсеге жарамайды, солай ма?
Dialogue: 0,0:15:10.83,0:15:13.36,jp.sub-ja,NTP,0,0,0,,Нағыз жаман адам – менеджер.
Dialogue: 0,0:15:13.32,0:15:14.99,Style1,,0,0,0,,Күте тұрыңыз, әке!
Dialogue: 0,0:15:13.40,0:15:14.85,jp.sub-ja,NTP,0,0,0,,Сәлем әке
Dialogue: 0,0:15:14.98,0:15:17.84,jp.sub-ja,NTP,0,0,0,,Мен сені Кёуя-сенпаймен байланыстырғаныңды естімедім.
Dialogue: 0,0:15:14.99,0:15:17.99,Style1,,0,0,0,,Сенің Кёя-сенпаймен байланыста болғаныңды естімеппін!
Dialogue: 0,0:15:17.86,0:15:22.03,jp.sub-ja,NTP,0,0,0,,Иә, өйткені Харухи ешқашан мектеп туралы айтпайды.
Dialogue: 0,0:15:17.99,0:15:21.99,Style1,,0,0,0,,Иә? Бірақ Харухи, сен маған мектепте ешқашан ештеңе айтпайсың.
Dialogue: 0,0:15:21.99,0:15:24.66,Style1,,0,0,0,,Олай болса, маған айтпай, сен...
Dialogue: 0,0:15:22.10,0:15:24.22,jp.sub-ja,NTP,0,0,0,,Сондықтан өзіңізге айтпаңыз
Dialogue: 0,0:15:24.44,0:15:28.07,jp.sub-ja,NTP,0,0,0,,Үлкендер, адамдар шкафында саңырауқұлақ өсіруді доғарыңдар.
Dialogue: 0,0:15:24.66,0:15:28.33,Style1,,0,0,0,,Сенпай, бөтен шкафта саңырауқұлақ өсіруді доғарар ма едің!?
Dialogue: 0,0:15:28.33,0:15:31.00,Style1,,0,0,0,,Харухи, сен туралы...
Dialogue: 0,0:15:28.46,0:15:30.87,jp.sub-ja,NTP,0,0,0,,Харухи, сен баласың.
Dialogue: 0,0:15:30.91,0:15:32.99,jp.sub-ja,NTP,0,0,0,,Ашулы жүздер де сүйкімді
Dialogue: 0,0:15:31.00,0:15:33.07,Style1,,0,0,0,,...ашулы болсаң да сүйкімді боласың!
Dialogue: 0,0:15:33.05,0:15:34.11,jp.sub-ja,NTP,0,0,0,,Не?
Dialogue: 0,0:15:33.07,0:15:36.67,Style1,,0,0,0,,Бұл жігітте маған біреуді қатты еске түсіретін бір нәрсе бар.
Dialogue: 0,0:15:33.07,0:15:39.34,Style2,,0,0,0,,«Өте мейірімді ата-ана»
Dialogue: 0,0:15:34.07,0:15:36.55,jp.sub-ja,NTP,0,0,0,,Ол басқа біреуді еске түсіреді.
Dialogue: 0,0:15:36.64,0:15:39.18,jp.sub-ja,NTP,0,0,0,,Сондықтан Харухи саған жақсы қарайды.
Dialogue: 0,0:15:36.67,0:15:39.34,Style1,,0,0,0,,Бұл Харухидің бойын неге сонша жақсы ұстайтынын түсіндіреді.
Dialogue: 0,0:15:39.34,0:15:41.35,Style1,,0,0,0,,О, жоқ, қайда бара жатырсың?
Dialogue: 0,0:15:39.47,0:15:41.48,jp.sub-ja,NTP,0,0,0,,Маған ұнамайды. Қайда бара жатырсың?
Dialogue: 0,0:15:41.35,0:15:43.28,Style1,,0,0,0,,Супермаркет.
Dialogue: 0,0:15:41.53,0:15:42.81,jp.sub-ja,NTP,0,0,0,,Бұл керемет
Dialogue: 0,0:15:43.28,0:15:45.40,jp.sub-ja,NTP,0,0,0,,Мен өзім дүкен аралауға барамын.
Dialogue: 0,0:15:43.28,0:15:45.62,Style1,,0,0,0,,Мен өзім дүкен аралаймын.
Dialogue: 0,0:15:45.62,0:15:48.95,Style1,,0,0,0,,Мен бірден қайтамын, сондықтан барлығыңыз өздеріңізді ұстаңыздар.
Dialogue: 0,0:15:45.69,0:15:48.85,jp.sub-ja,NTP,0,0,0,,Мен жақында қайтамын, сондықтан бәріңіз үндемей отырыңыздар.
Dialogue: 0,0:15:48.95,0:15:51.29,Style1,,0,0,0,,Әй, Харухи! Біз де қарапайым супермаркетке барғымыз келеді!
Dialogue: 0,0:15:49.39,0:15:51.53,jp.sub-ja,NTP,0,0,0,,Харухи Біз де қарапайым халықпыз
Dialogue: 0,0:15:51.29,0:15:54.63,Style1,,0,0,0,,Жарайды, жарайды. Ол сөйлегеннен кейін ол сені тыңдамайды.
Dialogue: 0,0:15:51.67,0:15:52.70,jp.sub-ja,NTP,0,0,0,,Бұл жақсы, бұл жақсы
Dialogue: 0,0:15:52.99,0:15:54.44,jp.sub-ja,NTP,0,0,0,,Айтсам, тыңдамайсың.
Dialogue: 0,0:15:54.43,0:16:04.64,Style2,,0,0,0,,«Саңырауқұлақтар бөлмесі»
Dialogue: 0,0:15:54.63,0:15:56.96,Style1,,0,0,0,,Сол қыз Уранға баруға шешім қабылдады,
Dialogue: 0,0:15:54.86,0:15:58.04,jp.sub-ja,NTP,0,0,0,,Егер ол қыз Уранға баратын болса, Оуранға бару және кіру тәртібі туралы әңгіме болады.
Dialogue: 0,0:15:56.96,0:15:59.96,Style1,,0,0,0,,және оқуға түсудің барлық құжаттарын өзі жасады.
Dialogue: 0,0:15:58.11,0:15:59.65,jp.sub-ja,NTP,0,0,0,,Барлығын өзіңіз шешіңіз
Dialogue: 0,0:15:59.96,0:16:02.30,Style1,,0,0,0,,Мен оның тәуелсіздік рухын құрметтегім келеді,
Dialogue: 0,0:16:00.12,0:16:02.13,jp.sub-ja,NTP,0,0,0,,Мен сенің тәуелсіз рухыңды сыйлағым келеді, бірақ
Dialogue: 0,0:16:02.30,0:16:04.64,Style1,,0,0,0,,, бірақ кейде оның маған көбірек тәуелді болғанын қалаймын.
Dialogue: 0,0:16:02.32,0:16:04.14,jp.sub-ja,NTP,0,0,0,,Мені анда-санда еркелетуіңізді қалаймын.
Dialogue: 0,0:16:04.64,0:16:05.80,Style2,,0,0,0,,«Фудзиока отбасы, 8 жыл бұрын»
Dialogue: 0,0:16:05.97,0:16:07.64,Style1,,0,0,0,,Харухи!
Dialogue: 0,0:16:06.06,0:16:07.44,jp.sub-ja,NTP,0,0,0,,Харухи
Dialogue: 0,0:16:06.57,0:16:07.63,Style2,,0,0,0,,"Фудзиока Рёжи (Ранка)"
Dialogue: 0,0:16:07.51,0:16:11.54,jp.sub-ja,NTP,0,0,0,,Бүгін қонақ болатын күн екенін неге айтпадың?
Dialogue: 0,0:16:07.64,0:16:11.98,Style1,,0,0,0,,Бүгін мектепте ата-аналар күні екенін неге айтпадың?
Dialogue: 0,0:16:11.86,0:16:14.72,jp.sub-ja,NTP,0,0,0,,Қонаққа келген күні әкенің келуіне рұқсат етілмейді.
Dialogue: 0,0:16:11.98,0:16:15.98,Style1,,0,0,0,,О, жоқ! Әке, сіз ата-аналар күніне келе алмайсыз!
Dialogue: 0,0:16:15.71,0:16:16.91,Style2,,0,0,0,,«Мацубара ішімдік сататын дүкен - Саке»
Dialogue: 0,0:16:15.98,0:16:19.32,Style1,,0,0,0,,Иә? Харухи-чан бүлікші кезеңнен өтіп жатыр ма?
Dialogue: 0,0:16:17.33,0:16:18.98,jp.sub-ja,NTP,0,0,0,,Харухи бүлікші
Dialogue: 0,0:16:19.32,0:16:21.99,Style1,,0,0,0,,Менің ойымша, сіз қате түсіндіңіз, солай емес пе?
Dialogue: 0,0:16:19.49,0:16:21.73,jp.sub-ja,NTP,0,0,0,,Бұл дұрыс емес, солай емес пе?
Dialogue: 0,0:16:21.99,0:16:23.99,Style1,,0,0,0,,Ол сізді ата-аналар күніне шақыра алмады
Dialogue: 0,0:16:22.11,0:16:24.16,jp.sub-ja,NTP,0,0,0,,Менің әкем ұялып қалды
Dialogue: 0,0:16:23.99,0:16:26.32,Style1,,0,0,0,,себебі ол әкемнің транни екеніне ұялды, солай ма?
Dialogue: 0,0:16:24.25,0:16:26.18,jp.sub-ja,NTP,0,0,0,,Мен сізге барған күні қоңырау шала алмадым.
Dialogue: 0,0:16:26.32,0:16:28.66,Style1,,0,0,0,,Естеріңізге сала кетейін, мен әрқашан би болдым!
Dialogue: 0,0:16:26.37,0:16:28.77,jp.sub-ja,NTP,0,0,0,,Сізге айтайын, мен би болдым.
Dialogue: 0,0:16:28.66,0:16:30.99,Style1,,0,0,0,,Бірақ енді мен Котокодан басқа ешкімді жақсы көрмеймін,
Dialogue: 0,0:16:28.86,0:16:30.89,jp.sub-ja,NTP,0,0,0,,Бірақ мен Котокодан басқа ешкімді жақсы көрмеймін деп шештім.
Dialogue: 0,0:16:30.96,0:16:33.23,jp.sub-ja,NTP,0,0,0,,Дүкенде жұмыс істеген кезде танымал болуға тырысу
Dialogue: 0,0:16:30.99,0:16:33.66,Style1,,0,0,0,,Мен тек өз беделімді сақтауға тырысамын, сондықтан мен цехта жұмыс істей аламын.
Dialogue: 0,0:16:33.66,0:16:38.67,Style1,,0,0,0,,Сәлем, Харухи-чан! Сенің әкең кетіп қалды, ақымақ ішіп алды!
Dialogue: 0,0:16:33.91,0:16:38.06,jp.sub-ja,NTP,0,0,0,,Эй, Харухи-чан, сенің әкең абайсызда ішіп отыр.
Dialogue: 0,0:16:38.67,0:16:40.67,Style1,,0,0,0,,Харухи-чан, мен үйдемін!
Dialogue: 0,0:16:38.85,0:16:40.70,jp.sub-ja,NTP,0,0,0,,Хару-чан қазір үйде
Dialogue: 0,0:16:40.67,0:16:42.34,Style1,,0,0,0,,Уа, ішімдік иіседі екенсің.
Dialogue: 0,0:16:40.78,0:16:41.96,jp.sub-ja,NTP,0,0,0,,Алкоголь
Dialogue: 0,0:16:42.11,0:16:45.90,jp.sub-ja,NTP,0,0,0,,Баратын күні бара алмау қатты таң қалдырған болуы керек.
Dialogue: 0,0:16:42.34,0:16:45.94,Style1,,0,0,0,,Ата-аналар күніне бармағанына қатты ренжіген сияқты.
Dialogue: 0,0:16:45.94,0:16:48.24,Style1,,0,0,0,,Оны келесі жолы шақыр, жарай ма?
Dialogue: 0,0:16:45.99,0:16:47.59,jp.sub-ja,NTP,0,0,0,,Маған келесі жолы қоңырау шалмаңыз.
Dialogue: 0,0:16:49.28,0:16:50.94,Style1,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,0:16:51.95,0:16:54.28,Style1,,0,0,0,,Мен оған үйде демалуға рұқсат еткім келеді
Dialogue: 0,0:16:52.03,0:16:56.54,jp.sub-ja,NTP,0,0,0,,Қонаққа келген күні келгенше, үйде демалғаныңызды қалаймын.
Ата-аналар күніне келгеннен гөрі
Dialogue: 0,0:16:54.28,0:16:57.62,Style1,,0,0,0,,.
Dialogue: 0,0:16:57.62,0:17:04.29,Style1,,0,0,0,,Ол шаршады, сондықтан ол үйде қалып, демалыс күні ұйықтауы керек.
Dialogue: 0,0:16:57.93,0:16:59.47,jp.sub-ja,NTP,0,0,0,,Себебі мен шаршадым
Dialogue: 0,0:17:00.48,0:17:03.82,jp.sub-ja,NTP,0,0,0,,Демалыс күні үйде үнемі ұйықтай аласыз.
Dialogue: 0,0:17:04.29,0:17:08.13,Style1,,0,0,0,,Мен оның өзіне қамқорлық жасағанын қалаймын.
Dialogue: 0,0:17:04.40,0:17:07.33,jp.sub-ja,NTP,0,0,0,,Мен сіздің денеңізге жақсырақ күтім жасауыңызды қалаймын.
Dialogue: 0,0:17:11.17,0:17:13.66,Style2,,0,0,0,,«Саңырауқұлақтар бөлмесі»
Dialogue: 0,0:17:11.64,0:17:14.30,Style1,,0,0,0,,Балалар мен сендерге ризамын.
Dialogue: 0,0:17:11.72,0:17:13.96,jp.sub-ja,NTP,0,0,0,,Балалар мен сендерге ризамын.
Dialogue: 0,0:17:14.30,0:17:18.98,Style1,,0,0,0,,Ол қазір мектепте өзінше бақытты және рахаттанып жүрген сияқты.
Dialogue: 0,0:17:14.45,0:17:18.27,jp.sub-ja,NTP,0,0,0,,Ол қазір мектепте жақсы және көңілді жүрген сияқты.
Dialogue: 0,0:17:18.96,0:17:21.14,jp.sub-ja,NTP,0,0,0,,Сәлем Тамаки Суо
Dialogue: 0,0:17:18.98,0:17:20.98,Style1,,0,0,0,,Дұрыс па, Суу Тамаки-кун?
Dialogue: 0,0:17:20.98,0:17:23.48,Style1,,0,0,0,,- Әке- - Мен сенің кім екеніңді бір қарағанда білдім.
Dialogue: 0,0:17:21.16,0:17:22.06,jp.sub-ja,NTP,0,0,0,,Әкем
Dialogue: 0,0:17:22.11,0:17:23.41,jp.sub-ja,NTP,0,0,0,,Мен мұны бір қарағанда түсіндім.
Dialogue: 0,0:17:23.48,0:17:29.32,Style1,,0,0,0,,Сіз Харухидің әңгімесінде жиі кездесетін ақымақ клубтың президентісіз.
Dialogue: 0,0:17:23.49,0:17:27.50,jp.sub-ja,NTP,0,0,0,,Харухидің әңгімелерінде жиі кездесетін ақымақ менеджер сенсің.
Dialogue: 0,0:17:29.19,0:17:32.12,jp.sub-ja,NTP,0,0,0,,Харухи қабылдаушы клуб туралы айтып жатыр ма?
Dialogue: 0,0:17:29.32,0:17:32.66,Style1,,0,0,0,,Сонымен, Харухи Хост клубы туралы айтады, солай ма?
Dialogue: 0,0:17:32.66,0:17:34.32,Style1,,0,0,0,,Ойланып қарасаң, сен өзіңсің
Dialogue: 0,0:17:33.00,0:17:37.75,jp.sub-ja,NTP,0,0,0,,Ойлап қарасам, соңында Харухиді ер адам деп қателестің.
Dialogue: 0,0:17:34.32,0:17:37.66,Style1,,0,0,0,,кім Харухиді аяғына дейін бала деп қателесті, солай ма?
Dialogue: 0,0:17:37.66,0:17:41.67,Style1,,0,0,0,,Сіз оны түсінбейсіз, солай ма? Сен қорқыныштысың.
Dialogue: 0,0:17:37.81,0:17:40.23,jp.sub-ja,NTP,0,0,0,,Түсінбейсің, сен ең жамансың.
Dialogue: 0,0:17:41.63,0:17:44.13,jp.sub-ja,NTP,0,0,0,,Енді, одан да көп, бәрі.
Dialogue: 0,0:17:41.67,0:17:44.00,Style1,,0,0,0,,Ендеше, бұған еш мән бермейік,
Dialogue: 0,0:17:44.00,0:17:46.94,Style1,,0,0,0,,Неге бәріміз өзімізді қызықтырмаймыз?
Dialogue: 0,0:17:44.17,0:17:46.10,jp.sub-ja,NTP,0,0,0,,Әдемі ойнама
Dialogue: 0,0:17:47.94,0:17:49.61,Style1,,0,0,0,,Мен ешқашан білмедім.
Dialogue: 0,0:17:48.04,0:17:49.15,jp.sub-ja,NTP,0,0,0,,Мен білмедім
Dialogue: 0,0:17:49.61,0:17:52.28,Style1,,0,0,0,,Әкем мен Кёясенпай деп кім ойлаған
Dialogue: 0,0:17:49.82,0:17:54.09,jp.sub-ja,NTP,0,0,0,,Мен әкем Кёуя-сенпаймен араласады деп ойламаппын.
Dialogue: 0,0:17:52.28,0:17:54.90,Style1,,0,0,0,,бір-бірімен байланыста болды ма?
Dialogue: 0,0:17:56.28,0:17:58.95,Style1,,0,0,0,,Сонымен, біз онымен бірге барамыз, солай ма?
Dialogue: 0,0:17:56.52,0:17:58.54,jp.sub-ja,NTP,0,0,0,,Сонымен, бәріміз бірге барамыз.
Dialogue: 0,0:17:58.84,0:18:00.43,jp.sub-ja,NTP,0,0,0,,Бұл жақсы нәрсе ме?
Dialogue: 0,0:17:58.95,0:18:00.45,Style1,,0,0,0,,«Көңілді» дегеніңіз осы ма?
Dialogue: 0,0:18:00.45,0:18:02.62,Style1,,0,0,0,,Бұл тайлинг ойыны, Кёя-кун.
Dialogue: 0,0:18:00.49,0:18:02.51,jp.sub-ja,NTP,0,0,0,,Менің артымнан жүр, Кёуя-кун
Dialogue: 0,0:18:02.62,0:18:04.62,Style1,,0,0,0,,Әдемі ұлдар, солай емес пе?
Dialogue: 0,0:18:02.76,0:18:04.50,jp.sub-ja,NTP,0,0,0,,Әдемі ұлдар.
Dialogue: 0,0:18:04.27,0:18:05.60,jp.sub-ja,NTP,0,0,0,,Дәлірек айтқанда
Dialogue: 0,0:18:04.61,0:18:06.17,jp.sub-ja,NTP,0,0,0,,Сіз талантсыз ба?
Dialogue: 0,0:18:04.62,0:18:06.29,Style1,,0,0,0,,- Олар теледидар тұлғалары болуы мүмкін бе? - Сосын тағы...
Dialogue: 0,0:18:06.29,0:18:11.30,Style1,,0,0,0,,Мен көптеген жақсы балалармен бірге серуендегім келді!
Dialogue: 0,0:18:06.39,0:18:11.05,jp.sub-ja,NTP,0,0,0,,Мен көп жақсы адамдармен бірге қыдырғым келді.
Dialogue: 0,0:18:11.30,0:18:14.57,Style1,,0,0,0,,Рас, мынау да, анау да бір матадан кесілген.
Dialogue: 0,0:18:11.41,0:18:14.45,jp.sub-ja,NTP,0,0,0,,Өйткені, бұл адам мен бұл адам бір түр.
Dialogue: 0,0:18:14.57,0:18:16.26,Style2,,0,0,0,,"Марутоми супермаркети"
Dialogue: 0,0:18:22.31,0:18:27.31,Style1,,0,0,0,,Оның хал-жағдайын жасырын бақылап отыру үшін бізге неге сонша алыс бару керек, әке?
Dialogue: 0,0:18:22.45,0:18:26.06,jp.sub-ja,NTP,0,0,0,,Неліктен мен сені жасырын тексеруге баруым керек?
Dialogue: 0,0:18:26.28,0:18:27.11,jp.sub-ja,NTP,0,0,0,,(Баяндау) ДжоДжо мен оның серіктері қасиетті Бенгалур қаласына автобуспен бара жатты.
Dialogue: 0,0:18:27.23,0:18:29.89,jp.sub-ja,NTP,0,0,0,,Ол бала анасынан ерте айырылды.
Dialogue: 0,0:18:27.31,0:18:29.98,Style1,,0,0,0,,Анасынан ерте айырылды,
Dialogue: 0,0:18:29.98,0:18:31.98,Style1,,0,0,0,,және барлық үй жұмысын алды,
Dialogue: 0,0:18:30.11,0:18:33.93,jp.sub-ja,NTP,0,0,0,,Дүкенмен қатар үй шаруасын да өз мойнына алды.
Dialogue: 0,0:18:31.98,0:18:33.98,Style1,,0,0,0,,сатып алу туралы ештеңе айтпау.
Dialogue: 0,0:18:33.98,0:18:37.32,Style1,,0,0,0,,Мен оның соңынан еретін әдетімді дамыта алмадым.
Dialogue: 0,0:18:34.08,0:18:37.10,jp.sub-ja,NTP,0,0,0,,Мен оны кейінірек қоюды әдетке айналдырдым.
Dialogue: 0,0:18:37.24,0:18:39.06,jp.sub-ja,NTP,0,0,0,,Әке махаббаты дегеніміз не?
Dialogue: 0,0:18:37.32,0:18:39.72,Style1,,0,0,0,,Мұны әке махаббаты дейсіз бе?
Dialogue: 0,0:18:40.99,0:18:43.16,Style1,,0,0,0,,Әрине, мен ол үшін алаңдаймын, білесіз бе?
Dialogue: 0,0:18:41.18,0:18:43.11,jp.sub-ja,NTP,0,0,0,,Мен уайымдап жүрмін.
Dialogue: 0,0:18:43.16,0:18:45.66,Style1,,0,0,0,,Оны қорғай алатын жалғыз мен ғанамын ғой.
Dialogue: 0,0:18:43.21,0:18:45.48,jp.sub-ja,NTP,0,0,0,,Мен сені ғана қорғай аламын
Dialogue: 0,0:18:45.66,0:18:47.65,Style2,,0,0,0,,«Харухи, 6 жыл бұрын»
Dialogue: 0,0:18:46.66,0:18:47.66,Style1,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:18:46.68,0:18:49.78,jp.sub-ja,NTP,0,0,0,,Әкеңе не болды?
Dialogue: 0,0:18:47.66,0:18:50.00,Style1,,0,0,0,,Әке, не болды?
Dialogue: 0,0:18:50.00,0:18:54.00,Style1,,0,0,0,,О, иә, м... Мен кенеттен сенің себетіңді алып кеткім келді, Харухи!
Dialogue: 0,0:18:50.89,0:18:54.29,jp.sub-ja,NTP,0,0,0,,Мен кенеттен Харухидің қоржынын алғым келеді.
Dialogue: 0,0:18:54.00,0:18:58.13,Style1,,0,0,0,,Әкем сауда себеттерін алып жүруді жақсы көреді! Сене аласыз ба?
Dialogue: 0,0:18:54.20,0:18:56.14,jp.sub-ja,NTP,0,0,0,,Әкем сауда арбасының болғанын жақсы көреді.
Dialogue: 0,0:18:56.16,0:18:57.78,jp.sub-ja,NTP,0,0,0,,Бұл не?
Dialogue: 0,0:18:59.68,0:19:02.01,Style1,,0,0,0,,Сіз біртүрлі екенсіз.
Dialogue: 0,0:18:59.86,0:19:00.75,jp.sub-ja,NTP,0,0,0,,Қызық екен
Dialogue: 0,0:19:02.01,0:19:04.01,Style1,,0,0,0,,Ол басқаларға сүйенуді білмей ме,
Dialogue: 0,0:19:02.07,0:19:05.80,jp.sub-ja,NTP,0,0,0,,Бұзғым келмейді, сараңдық жоқ дегенім.
Dialogue: 0,0:19:04.01,0:19:06.02,Style1,,0,0,0,,немесе оның қалауы болмаса,
Dialogue: 0,0:19:06.02,0:19:08.69,Style1,,0,0,0,,ол сізге оны уайымдауға мүмкіндік бермейді.
Dialogue: 0,0:19:06.19,0:19:08.85,jp.sub-ja,NTP,0,0,0,,Маған бұл туралы алаңдауға мүмкіндік бермеңіз
Dialogue: 0,0:19:08.69,0:19:14.02,Style1,,0,0,0,,Соған қарамастан, оның басқаларды құтқару тәсілі бар.
Dialogue: 0,0:19:09.00,0:19:13.85,jp.sub-ja,NTP,0,0,0,,Солай болса да, мен түсінбей адамдарды құтқарамын.
Dialogue: 0,0:19:14.02,0:19:16.36,Style1,,0,0,0,,Иә, бұл бір нәрсе...
Dialogue: 0,0:19:14.71,0:19:17.19,jp.sub-ja,NTP,0,0,0,,Мен мұны түсінемін.
Dialogue: 0,0:19:16.36,0:19:18.06,Style1,,0,0,0,,...Түсіндім.
Dialogue: 0,0:19:19.36,0:19:21.37,Style1,,0,0,0,,Оны түсіну мүмкін емес!
Dialogue: 0,0:19:19.55,0:19:21.22,jp.sub-ja,NTP,0,0,0,,Сіз түсінуге мүмкіндік жоқ
Dialogue: 0,0:19:21.33,0:19:22.42,jp.sub-ja,NTP,0,0,0,,Не, бұл жай ғана әдемі?
Dialogue: 0,0:19:21.37,0:19:23.70,Style1,,0,0,0,,Кішкене сымбатты болғаның үшін қайда түсесің?
Dialogue: 0,0:19:22.43,0:19:25.68,jp.sub-ja,NTP,0,0,0,,Мен саған айтамын, оны әлі жіберетін ойым жоқ.
Dialogue: 0,0:19:23.70,0:19:25.70,Style1,,0,0,0,,Мен сізге ескертемін, мен әлі жіберуге дайын емеспін!
Dialogue: 0,0:19:25.70,0:19:28.04,Style1,,0,0,0,,Өтінемін, жіберіңізші...
Dialogue: 0,0:19:25.70,0:19:28.05,jp.sub-ja,NTP,0,0,0,,Қолдарыңызды алыңыз
Dialogue: 0,0:19:28.04,0:19:30.71,Style1,,0,0,0,,Сіз оны бірнеше күн ғана білетін адам үшін біраз жүйкеңіз бар!
Dialogue: 0,0:19:28.11,0:19:30.59,jp.sub-ja,NTP,0,0,0,,Мен кешегі және бүгінгі қарым-қатынасыма қарамастан, мен өте тәкаппармын.
Dialogue: 0,0:19:30.64,0:19:33.82,jp.sub-ja,NTP,0,0,0,,Сондықтан мен сені жау санаймын.
Dialogue: 0,0:19:30.71,0:19:31.71,Style1,,0,0,0,,Сонымен...
Dialogue: 0,0:19:31.71,0:19:34.61,Style1,,0,0,0,,Сен жаусың! Мен сені жау санаймын!
Dialogue: 0,0:19:36.55,0:19:36.77,Style2,,0,0,0,,«Ранка»
Dialogue: 0,0:19:38.72,0:19:41.39,Style1,,0,0,0,,Иә? Тамаки-сенпай, не болды?
Dialogue: 0,0:19:38.73,0:19:41.62,jp.sub-ja,NTP,0,0,0,,Тамаки-сенпайға не болды?
Dialogue: 0,0:19:41.39,0:19:45.32,Style1,,0,0,0,,Ой, иә, м... Мен кенет сенің себетіңді алып кеткім келді, Харухи!
Dialogue: 0,0:19:41.68,0:19:45.21,jp.sub-ja,NTP,0,0,0,,Мен кенеттен Харухидің қоржынын алғым келеді.
Dialogue: 0,0:19:45.32,0:19:49.82,Style1,,0,0,0,,Иә, әкем себет алып жүруді жақсы көреді! Сене аласыз ба?
Dialogue: 0,0:19:45.37,0:19:47.49,jp.sub-ja,NTP,0,0,0,,Иә, менің әкем сауда арбасының болғанын жақсы көреді.
Dialogue: 0,0:19:47.49,0:19:48.82,jp.sub-ja,NTP,0,0,0,,Бұл не?
Dialogue: 0,0:19:50.99,0:19:53.09,Style1,,0,0,0,,Сіз біртүрлі екенсіз.
Dialogue: 0,0:19:51.08,0:19:52.13,jp.sub-ja,NTP,0,0,0,,Қызық екен
Dialogue: 0,0:19:55.33,0:19:57.30,Style1,,0,0,0,,О, саңырауқұлақтар...
Dialogue: 0,0:19:55.56,0:19:57.00,jp.sub-ja,NTP,0,0,0,,Саңырауқұлақ
Dialogue: 0,0:19:59.34,0:20:01.00,Style1,,0,0,0,,Сонымен, «уақытқа қызмет көрсету» уақыт шегі бар дегенді білдіреді, иә?
Dialogue: 0,0:19:59.52,0:20:02.07,jp.sub-ja,NTP,0,0,0,,Уақыт қызметінде уақыт шегі бар ма?
Dialogue: 0,0:20:01.00,0:20:03.67,Style1,,0,0,0,,Әй, қарапайым адамдардың кофелерінің бір бумасы бар.
Dialogue: 0,0:20:01.42,0:20:03.49,jp.sub-ja,NTP,0,0,0,,Commoner кофесі үйіліп жатыр.
Dialogue: 0,0:20:03.62,0:20:05.65,jp.sub-ja,NTP,0,0,0,,Сізде жейтін нәрсе бар ма?
Dialogue: 0,0:20:03.67,0:20:06.01,Style1,,0,0,0,,- Бірдеңе жегің келді ме? - Дәл халықаралық нарықтағыдай емес пе?
Dialogue: 0,0:20:05.94,0:20:08.61,jp.sub-ja,NTP,0,0,0,,Ыстық қазан
Dialogue: 0,0:20:06.01,0:20:11.68,Style1,,0,0,0,,Ым, қайнатпа. Онда ет көп, хризантема жоқ.
Dialogue: 0,0:20:08.83,0:20:11.87,jp.sub-ja,NTP,0,0,0,,Етке толы, бірақ шунгику жоқ.
Dialogue: 0,0:20:11.68,0:20:13.35,Style1,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:20:11.92,0:20:12.95,jp.sub-ja,NTP,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:20:13.35,0:20:16.02,Style1,,0,0,0,,Адамдар көп болғанда, бұқтырылған ыдыс жақсы болар еді, иә?
Dialogue: 0,0:20:13.50,0:20:15.97,jp.sub-ja,NTP,0,0,0,,Адамдар көп болса, қазаннан жасалған тағамдар жақсы.
Dialogue: 0,0:20:16.02,0:20:18.69,Style1,,0,0,0,,Ол үшін жылы.
Dialogue: 0,0:20:16.26,0:20:16.94,jp.sub-ja,NTP,0,0,0,,Күн ыстық
Dialogue: 0,0:20:18.69,0:20:21.02,Style1,,0,0,0,,Солай болса да, егер бір сәтте,
Dialogue: 0,0:20:18.86,0:20:19.96,jp.sub-ja,NTP,0,0,0,,Әлі де бір күні
Dialogue: 0,0:20:21.02,0:20:24.36,Style1,,0,0,0,,сол риясыз қыздың қатты қалаған күні келеді
Dialogue: 0,0:20:21.15,0:20:23.12,jp.sub-ja,NTP,0,0,0,,Тілегі жоқ бала
Dialogue: 0,0:20:23.23,0:20:27.98,jp.sub-ja,NTP,0,0,0,,Егер мен бір адамның жанында болғым келетін күн келсе.
Dialogue: 0,0:20:24.36,0:20:28.59,Style1,,0,0,0,,оның жанында бір ғана адам болуы...
Dialogue: 0,0:20:29.70,0:20:32.70,Style1,,0,0,0,,Әрине, бұл туралы ойлану мені қызық етеді!
Dialogue: 0,0:20:29.96,0:20:32.45,jp.sub-ja,NTP,0,0,0,,Оны ойласам ашуым келеді.
Dialogue: 0,0:20:32.56,0:20:33.68,jp.sub-ja,NTP,0,0,0,,Иә, Шунгику
Dialogue: 0,0:20:32.70,0:20:34.71,Style1,,0,0,0,,- Міне, хризантема... ал тағы хризантема... - Мен ет алғым келді...
Dialogue: 0,0:20:33.73,0:20:34.36,jp.sub-ja,NTP,0,0,0,,Ет
Dialogue: 0,0:20:33.98,0:20:35.13,jp.sub-ja,NTP,0,0,0,,Иә, Шунгику
Dialogue: 0,0:20:34.71,0:20:38.57,Style1,,0,0,0,,- Уау, ет көп екен! - Бұл дәмді. -Мұнда не болып жатыр?
Dialogue: 0,0:20:35.15,0:20:36.52,jp.sub-ja,NTP,0,0,0,,Шунгику жеңіз
Dialogue: 0,0:20:35.55,0:20:37.76,jp.sub-ja,NTP,0,0,0,,Жолсыз жерлерге арналған көлік қолайлырақ болар еді, білесің бе?
Dialogue: 0,0:20:36.54,0:20:37.90,jp.sub-ja,NTP,0,0,0,,Қызық, бұл не?
Dialogue: 0,0:20:39.23,0:20:41.60,jp.sub-ja,NTP,0,0,0,,Мырза, сіздің осындай қарындасыңыз болды ма?
Dialogue: 0,0:20:40.29,0:20:42.76,Style1,,0,0,0,,Мырза, шынымен де осындай кішкентай қарындасыңыз бар ма?
Dialogue: 0,0:20:41.62,0:20:43.80,jp.sub-ja,NTP,0,0,0,,Жарайды. Бүгіннен бастап мен сенің ағаңмын.
Dialogue: 0,0:20:42.76,0:20:44.96,Style1,,0,0,0,,Жарайды, бүгіннен бастап мен сенің ағаң боламын!
Dialogue: 0,0:20:43.85,0:20:46.24,jp.sub-ja,NTP,0,0,0,,Сіз осындай жауапсыз мәлімдемелер жасауды тоқтата аласыз ба?
Dialogue: 0,0:20:44.96,0:20:47.96,Style1,,0,0,0,,Сіз мұндай жауапсыз мәлімдемелер жасауды тоқтатар ма едіңіз?
Dialogue: 0,0:20:47.96,0:20:50.30,Style1,,0,0,0,,Келесі жолы «Үлкен аға - ханзада»
Dialogue: 0,0:20:48.97,0:20:51.26,jp.sub-ja,NTP,0,0,0,,Келесі аптада Оуран орта мектебінің хост клубы
Dialogue: 0,0:20:50.30,0:20:52.80,Style1,,0,0,0,,Сізді келесі аптада Оуран орта мектебінің хост клубы күтеді!
Dialogue: 0,0:20:51.32,0:20:52.80,jp.sub-ja,NTP,0,0,0,,Біз сізді асыға күтеміз.
Dialogue: 0,0:20:54.30,0:21:00.30,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
