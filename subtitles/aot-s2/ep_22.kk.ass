Dialogue: 0,0:00:04.79,0:00:05.54,JP,,0000,0000,0000,,Мен ойлағандай
Dialogue: 0,0:00:05.76,0:00:06.49,JP,,0000,0000,0000,,●
Dialogue: 0,0:00:07.10,0:00:08.51,JP,,0000,0000,0000,,Бұл – Әйел Титан
Dialogue: 0,0:00:14.59,0:00:16.92,JP,,0000,0000,0000,,Қайта тірілген Әйел Титанның қолынан
Dialogue: 0,0:00:17.31,0:00:20.82,JP,,0000,0000,0000,,Левидің жасағының ең үздік мүшелері бірінен соң бірі жеңілді
Dialogue: 0,0:00:27.45,0:00:28.59,JP,,0000,0000,0000,,Оны өлтір!
Dialogue: 0,0:00:28.64,0:00:33.07,JP,,0000,0000,0000,,Серіктеріне сенгені өзінің қателігі екенін түсінген Эрен
Dialogue: 0,0:00:33.54,0:00:35.39,JP,,0000,0000,0000,,Титанға айналып, шайқасты, бірақ...
Dialogue: 0,0:00:38.41,0:00:42.94,JP,,0000,0000,0000,,Эрен жеңілді, және Әйел Титан оны әкетті
Dialogue: 0,0:00:48.31,0:00:49.62,JP,,0000,0000,0000,,Эрен...
Dialogue: 0,0:00:50.33,0:00:51.99,JP,,0000,0000,0000,,Оны қайтарып бер!
Dialogue: 0,0:01:03.40,0:01:04.74,JP,,0000,0000,0000,,Ол қайда болса да,
Dialogue: 0,0:01:05.09,0:01:06.76,JP,,0000,0000,0000,,Мен сол әйелді өлтіремін,
Dialogue: 0,0:01:07.09,0:01:08.99,JP,,0000,0000,0000,,Денесін бөлік-бөлік етіп кесіп,
Dialogue: 0,0:01:09.32,0:01:12.49,JP,,0000,0000,0000,,Оны осы лас жерден босатамын.
Dialogue: 0,0:01:13.70,0:01:15.01,JP,,0000,0000,0000,,Толық шегіну.
Dialogue: 0,0:01:15.95,0:01:19.18,JP,,0000,0000,0000,,Тек... сәл шыдай тұршы...
Dialogue: 0,0:01:26.76,0:01:27.81,JP,,0000,0000,0000,,Қ-Қандай?
Dialogue: 0,0:01:28.48,0:01:29.83,JP,,0000,0000,0000,,Нет... не істеп жатырсың...
Dialogue: 0,0:01:32.17,0:01:33.44,JP,,0000,0000,0000,,Бір сәтке шегін
Dialogue: 0,0:03:18.95,0:03:20.31,JP,,0000,0000,0000,,Ары тұр
Dialogue: 0,0:03:21.29,0:03:22.69,JP,,0000,0000,0000,,Ол да шаршап қалды ма?
Dialogue: 0,0:03:22.79,0:03:24.69,JP,,0000,0000,0000,,Өте жылдам қозғалып жатқан жоқ сияқты
Dialogue: 0,0:03:25.81,0:03:27.98,JP,,0000,0000,0000,,Мойны тіпті жұлынып кеткендей
Dialogue: 0,0:03:28.74,0:03:30.08,JP,,0000,0000,0000,,Эрен өліп қалды ма?
Dialogue: 0,0:03:33.26,0:03:34.35,JP,,0000,0000,0000,,Ол тірі
Dialogue: 0,0:03:34.84,0:03:36.74,JP,,0000,0000,0000,,Мақсат ақыл-есі бар сияқты,
Dialogue: 0,0:03:37.16,0:03:39.55,JP,,0000,0000,0000,,бірақ оның мақсаты – Эренді алып кету.
Dialogue: 0,0:03:40.34,0:03:42.19,JP,,0000,0000,0000,,Егер оны өлтіргісі келсе, таптап тастаған болар еді.
Dialogue: 0,0:03:43.87,0:03:47.63,JP,,0000,0000,0000,,Мақсат оны аузында ұстап, соғысып, қашып жүр.
Dialogue: 0,0:03:49.25,0:03:51.32,JP,,0000,0000,0000,,Мүмкін оның мақсаты – Эренді жеп қою.
Dialogue: 0,0:03:51.85,0:03:53.99,JP,,0000,0000,0000,,Егер солай болса, Эрен оның ішегінде.
Dialogue: 0,0:03:54.62,0:03:56.53,JP,,0000,0000,0000,,Логикаға сүйенсек, ол өлі.
Dialogue: 0,0:03:56.74,0:03:57.86,JP,,0000,0000,0000,,Ол тірі!
Dialogue: 0,0:04:00.40,0:04:01.66,JP,,0000,0000,0000,,Солай болғай.
Dialogue: 0,0:04:03.62,0:04:06.73,JP,,0000,0000,0000,,Алдымен, егер сен Эренді қорғаған болсаң,
Dialogue: 0,0:04:06.73,0:04:08.37,JP,,0000,0000,0000,,мұндай болмас еді.
Dialogue: 0,0:04:11.93,0:04:14.63,JP,,0000,0000,0000,,Тыңдаған: zwx & Syura; Аударған: Basugi & Pulsar; Тексерген: Xiao Ke & Ariake no Tsuki; Уақытша кестені жасаған: Feng She; Дәстүрлендірген: incot; Кодтаған: Lie Shu
