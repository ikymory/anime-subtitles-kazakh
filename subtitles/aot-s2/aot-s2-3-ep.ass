Dialogue: 0,0:22:39.53,0:22:44.25,Default,,0,0,0,,Ол арман жүректің бар жері
Dialogue: 0,0:22:44.50,0:22:49.71,Default,,0,0,0,,Өмірден де нәзік нәрсе
Dialogue: 0,0:22:50.80,0:22:55.28,Default,,0,0,0,,Оны тастап, қайта-қайта табыңыз
Dialogue: 0,0:22:55.48,0:23:01.47,Default,,0,0,0,,Енді тыныш жат.
Dialogue: 0,0:23:02.11,0:23:07.40,Default,,0,0,0,,Импульстік импульске
Dialogue: 0,0:23:07.78,0:23:12.69,Default,,0,0,0,,Тілек бұзылды
Dialogue: 0,0:23:13.46,0:23:17.89,Default,,0,0,0,,Ұмытқан сайын
Dialogue: 0,0:23:18.04,0:23:23.36,Default,,0,0,0,,Тағы да есімде
Dialogue: 0,0:23:23.60,0:23:29.31,Default,,0,0,0,,Бұл әдемі және қатыгез әлемде
Dialogue: 0,0:23:29.62,0:23:32.13,Default,,0,0,0,,Әлі тірі
Dialogue: 0,0:23:32.13,0:23:34.98,Default,,0,0,0,,Неге екенін сұрап жатырмын
Dialogue: 0,0:23:34.98,0:23:40.51,Default,,0,0,0,,А, бізде бұл күшті және әлсіз.
Dialogue: 0,0:23:40.54,0:23:43.66,Default,,0,0,0,,Біз нені қорғаймыз?
Dialogue: 0,0:23:44.11,0:23:49.88,Default,,0,0,0,,Енді ешқандай себеп болмаса
