Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.05,0:00:17.05,Default,,0,0,0,,♪〜
Dialogue: 0,0:00:30.86,0:00:36.87,Default,,0,0,0,,〜♪
Dialogue: 0,0:00:37.03,0:00:41.04,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,0:00:46.88,0:00:48.88,Default,,0,0,0,,Сіз мұны білмейсіз бе?
Dialogue: 0,0:00:49.00,0:00:52.13,Default,,0,0,0,,Жоқ, ахахха...
Dialogue: 0,0:00:52.26,0:00:54.84,Default,,0,0,0,,Неге! Мен мұны айта аламын
Dialogue: 0,0:00:54.97,0:00:57.89,Default,,0,0,0,,Осы көздермен жердің әр бұрышын көрдіңіз бе?
Dialogue: 0,0:00:58.47,0:00:59.97,Default,,0,0,0,,Бұл ақылға қонымды
Dialogue: 0,0:01:00.10,0:01:01.22,Default,,0,0,0,,Парасаттылық!
Dialogue: 0,0:01:01.35,0:01:04.06,Default,,0,0,0,,Сонда сіз Несси туралы әңгімені өтірік дейсіз бе?
Dialogue: 0,0:01:04.18,0:01:06.60,Default,,0,0,0,,Дүние жүзінде «көрдім» дейтін адамдар бар...
Dialogue: 0,0:01:06.73,0:01:08.81,Default,,0,0,0,,Ешқашан нақты дәлелдер табылған жоқ.
Dialogue: 0,0:01:09.23,0:01:10.77,Default,,0,0,0,,Иә, мен оны бұрын көрген емеспін.
Dialogue: 0,0:01:11.19,0:01:12.73,Default,,0,0,0,,Менің ойымша, бәрінен де таңқаларлық нәрсе –
Dialogue: 0,0:01:13.19,0:01:16.40,Default,,0,0,0,,Осындай үлкен динозаврлар осы уақытқа дейін өмір сүрсе...
Dialogue: 0,0:01:16.53,0:01:19.28,Default,,0,0,0,,Бір немесе екі сүйектің табылуы қалыпты жағдай.
Dialogue: 0,0:01:20.03,0:01:22.12,Default,,0,0,0,,Бірақ біз тапқанның бәрі қазбалар.
Dialogue: 0,0:01:22.24,0:01:26.08,Default,,0,0,0,,Бұл сонымен қатар 65 миллион жыл бұрынғы заттармен шектеледі.
Dialogue: 0,0:01:26.29,0:01:28.21,Default,,0,0,0,,Сунео, сен ақылдысың.
Dialogue: 0,0:01:28.33,0:01:30.34,Default,,0,0,0,,Әрбір динозавр –
Dialogue: 0,0:01:30.46,0:01:32.63,Default,,0,0,0,,Менің ойымша, біз оның жойылып кеткенін ғана болжауға болады.
Dialogue: 0,0:01:32.75,0:01:34.59,Default,,0,0,0,,Ку... Мен бұл туралы ойлануым керек.
Dialogue: 0,0:01:35.34,0:01:37.05,Default,,0,0,0,,Нобита-сан романтик.
Dialogue: 0,0:01:38.43,0:01:41.81,Default,,0,0,0,,Мен романтик болғаннан гөрі, арман мен шындықты ажырата алмаймын...
Dialogue: 0,0:01:41.93,0:01:42.97,Default,,0,0,0,,Жай ғана ақымақ
Dialogue: 0,0:01:43.35,0:01:46.14,Default,,0,0,0,,(Сунео/Джанның күлкісі)
Dialogue: 0,0:01:46.27,0:01:47.69,Default,,0,0,0,,Бірақ Йотаро-сан бәрі жақсы деді.
Dialogue: 0,0:01:47.81,0:01:49.90,Default,,0,0,0,,Қарашы, мен сені ұстайтыныма сенімдімін.
Dialogue: 0,0:01:50.31,0:01:52.94,Default,,0,0,0,,Нобита сенімді болу үшін,
Dialogue: 0,0:01:53.07,0:01:56.90,Default,,0,0,0,,Динозаврды уақыт машинасымен әкеліп, «Ал, сіз қалай ойлайсыз?» деген сөз жоқ.
Dialogue: 0,0:01:57.03,0:01:58.95,Default,,0,0,0,,(Сунео/Джанның күлкісі)
Dialogue: 0,0:01:58.95,0:02:00.49,Default,,0,0,0,,(Сунео/Джанның күлкісі)
Dialogue: 0,0:01:58.95,0:02:00.49,Default,,0,0,0,,Әу
Dialogue: 0,0:02:00.49,0:02:01.16,Default,,0,0,0,,(Сунео/Джанның күлкісі)
Dialogue: 0,0:02:01.66,0:02:04.87,Default,,0,0,0,,Дододо Дораемон
Dialogue: 0,0:02:04.99,0:02:11.00,Default,,0,0,0,,♪〜
Dialogue: 0,0:03:10.44,0:03:16.44,Default,,0,0,0,,〜♪
Dialogue: 0,0:03:17.32,0:03:18.69,Default,,0,0,0,,Матака?
Dialogue: 0,0:03:18.82,0:03:20.82,Default,,0,0,0,,Мен оларды шырылдатқым келеді.
Dialogue: 0,0:03:20.95,0:03:23.82,Default,,0,0,0,,Бүкіл әлемді іздеуге қанша жыл керек деп ойлайсың?
Dialogue: 0,0:03:24.24,0:03:26.49,Default,,0,0,0,,Мен өз өмірімді қатерге тігемін бе, бәрібір
Dialogue: 0,0:03:26.62,0:03:28.58,Default,,0,0,0,,Біз тірі қалған динозаврларды тапқанша!
Dialogue: 0,0:03:28.70,0:03:30.29,Default,,0,0,0,,Сунео мен басқаларға...
Dialogue: 0,0:03:30.71,0:03:32.50,Default,,0,0,0,,○× Ашуланбаңыз!
Dialogue: 0,0:03:33.00,0:03:34.13,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:34.25,0:03:37.63,Default,,0,0,0,,Кез келген сұраққа «○» немесе «×» арқылы жауап беруге болады.
Dialogue: 0,0:03:37.75,0:03:39.05,Default,,0,0,0,,Не?
Dialogue: 0,0:03:39.21,0:03:40.01,Default,,0,0,0,,Көріп көрейік
Dialogue: 0,0:03:40.30,0:03:42.93,Default,,0,0,0,,«Нобита-кунның бүгінгі сынағы 0 ұпай»
Dialogue: 0,0:03:44.64,0:03:46.26,Default,,0,0,0,,Ах (дұрыс жауап қоңырауы)
Dialogue: 0,0:03:46.39,0:03:47.89,Default,,0,0,0,,Дұрыс
Dialogue: 0,0:03:48.39,0:03:50.89,Default,,0,0,0,,Олай болса мен сізден сұрайын, Африкада динозаврлар бар ма?
Dialogue: 0,0:03:51.89,0:03:53.81,Default,,0,0,0,,Ах... (дұрыс емес қоңырау)
Dialogue: 0,0:03:53.94,0:03:55.65,Default,,0,0,0,,Жа Австралия
Dialogue: 0,0:03:55.77,0:03:57.40,Default,,0,0,0,,(қате қоңырау)
Dialogue: 0,0:03:57.52,0:03:58.52,Default,,0,0,0,,Америка
Dialogue: 0,0:03:58.65,0:04:00.15,Default,,0,0,0,,(қате қоңырау)
Dialogue: 0,0:04:00.28,0:04:01.53,Default,,0,0,0,,Токио
Dialogue: 0,0:04:01.65,0:04:02.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:03.11,0:04:05.62,Default,,0,0,0,,Әр сұрақты бір-бірден қойсаң, соңы болмайды.
Dialogue: 0,0:04:06.20,0:04:10.54,Default,,0,0,0,,Дәл қазір жер бетінде бір динозавр тірі қалды ма?
Dialogue: 0,0:04:11.79,0:04:12.62,Default,,0,0,0,,(қате қоңырау)
Dialogue: 0,0:04:12.75,0:04:14.21,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:04:14.33,0:04:14.62,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:04:14.62,0:04:17.50,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:04:14.62,0:04:17.50,Default,,0,0,0,,Бұл болжау 100% сенімді
Dialogue: 0,0:04:17.63,0:04:21.26,Default,,0,0,0,,Бұл Дораэмон жасаған машина. 100% сенімді ме?
Dialogue: 0,0:04:21.38,0:04:22.59,Default,,0,0,0,,Әрқашан...
Dialogue: 0,0:04:22.72,0:04:23.42,Default,,0,0,0,,Қосымша
Dialogue: 0,0:04:22.72,0:04:23.42,Default,,0,0,0,,(Қате қоңырау)
Dialogue: 0,0:04:23.42,0:04:23.76,Default,,0,0,0,,(Қате қоңырау)
Dialogue: 0,0:04:23.76,0:04:25.84,Default,,0,0,0,,(Қате қоңырау)
Dialogue: 0,0:04:23.76,0:04:25.84,Default,,0,0,0,,Әй, бәрі мені мазақ етеді!
Dialogue: 0,0:04:25.84,0:04:28.35,Default,,0,0,0,,Әй, бәрі мені мазақ етеді!
Dialogue: 0,0:04:28.64,0:04:32.81,Default,,0,0,0,,(Радиомен басқарылатын ұшу дыбысы)
Dialogue: 0,0:04:33.06,0:04:36.27,Default,,0,0,0,,А, мен бір жерге ұшып кетемін.
Dialogue: 0,0:04:33.06,0:04:36.27,Default,,0,0,0,,(Радиомен басқарылатын ұшу дыбысы)
Dialogue: 0,0:04:36.27,0:04:36.69,Default,,0,0,0,,(Радиомен басқарылатын ұшу дыбысы)
Dialogue: 0,0:04:36.69,0:04:37.94,Default,,0,0,0,,(Радиомен басқарылатын ұшу дыбысы)
Dialogue: 0,0:04:36.69,0:04:37.94,Default,,0,0,0,,Қазірдің өзінде! Мен онымен кездейсоқ араласамын
Dialogue: 0,0:04:37.94,0:04:38.56,Default,,0,0,0,,Қазірдің өзінде! Мен онымен кездейсоқ араласамын
Dialogue: 0,0:04:38.69,0:04:39.94,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:04:40.07,0:04:41.40,Default,,0,0,0,,Джан, оны маған тез қайтар.
Dialogue: 0,0:04:42.03,0:04:44.36,Default,,0,0,0,,А, мен бір жерге барамын.
Dialogue: 0,0:04:44.49,0:04:47.49,Default,,0,0,0,,Жоқ, қайтып кел.
Dialogue: 0,0:04:47.62,0:04:48.87,Default,,0,0,0,,Қайтарыңыз! Енді, онда!
Dialogue: 0,0:04:48.99,0:04:51.66,Default,,0,0,0,,А, күте тұр, күте тұр, күте тұр
Dialogue: 0,0:04:51.79,0:04:53.79,Default,,0,0,0,,Күте тұр, Корра, қайтып кел.
Dialogue: 0,0:04:53.91,0:04:55.29,Default,,0,0,0,,Ах аа
Dialogue: 0,0:04:55.29,0:04:56.17,Default,,0,0,0,,Ах аа
Dialogue: 0,0:04:55.29,0:04:56.17,Default,,0,0,0,,(Дыбыссыз радиомен басқарылатын ұшу дыбысы)
Dialogue: 0,0:04:56.17,0:04:56.50,Default,,0,0,0,,(Дыбыссыз радиомен басқарылатын ұшу дыбысы)
Dialogue: 0,0:04:56.50,0:04:57.38,Default,,0,0,0,,(қанағаттанарлықсыз радиомен басқарылатын ұшу дыбысы)
Dialogue: 0,0:04:56.50,0:04:57.38,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:05:01.71,0:05:04.76,Default,,0,0,0,,Ах, мен оны жаңа ғана сатып алдым.
Dialogue: 0,0:05:05.34,0:05:07.72,Default,,0,0,0,,Анам тағы ұрысты... А?
Dialogue: 0,0:05:07.84,0:05:11.14,Default,,0,0,0,,(судың қайнаған дыбысы)
Dialogue: 0,0:05:11.47,0:05:13.81,Default,,0,0,0,,Э-э, сүтті сонда қалдырдым.
Dialogue: 0,0:05:13.98,0:05:14.64,Default,,0,0,0,,《Міне, басталды!》
Dialogue: 0,0:05:14.77,0:05:18.69,Default,,0,0,0,,(Сунеоның қорқынышты дауысы)
Dialogue: 0,0:05:20.94,0:05:21.94,Default,,0,0,0,,...
Dialogue: 0,0:05:23.86,0:05:24.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:24.78,0:05:26.86,Default,,0,0,0,,(поезд мүйізі)
Dialogue: 0,0:05:30.70,0:05:33.37,Default,,0,0,0,,(поезд мүйізі)
Dialogue: 0,0:05:33.79,0:05:34.75,Default,,0,0,0,,Ноби-чан
Dialogue: 0,0:05:34.87,0:05:35.79,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:35.96,0:05:37.37,Default,,0,0,0,,Не? анам
Dialogue: 0,0:05:38.25,0:05:40.29,Default,,0,0,0,,Анашым, мен өте қуаныштымын.
Dialogue: 0,0:05:40.63,0:05:43.21,Default,,0,0,0,,Мен жақында сынақтан ешқашан 0 алған емеспін.
Dialogue: 0,0:05:43.96,0:05:45.42,Default,,0,0,0,,Уау (қате қоңырау)
Dialogue: 0,0:05:45.55,0:05:46.55,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:46.67,0:05:49.22,Default,,0,0,0,,Не? бұл? Ойыншық Эй Дораемон
Dialogue: 0,0:05:49.34,0:05:50.34,Default,,0,0,0,,Иә
Dialogue: 0,0:05:50.47,0:05:51.18,Default,,0,0,0,,(қате қоңырау)
Dialogue: 0,0:05:51.39,0:05:55.60,Default,,0,0,0,,Ноби-чан, мен сенен 0 ұпай алады деп ойламадым. Сіз оны жасырып жатқаныңызға сенімдімін.
Dialogue: 0,0:05:56.27,0:05:57.73,Default,,0,0,0,,Ол жайбарақат бос жүретін адам емес.
Dialogue: 0,0:05:56.27,0:05:57.73,Default,,0,0,0,,О, бұл күлкілі. Мен соңғы уақытта оқып жүрмін.
Dialogue: 0,0:05:57.73,0:06:00.23,Default,,0,0,0,,О, бұл күлкілі. Мен соңғы уақытта оқып жүрмін.
Dialogue: 0,0:06:00.35,0:06:01.81,Default,,0,0,0,,(қате қоңырау)
Dialogue: 0,0:06:01.94,0:06:04.36,Default,,0,0,0,,Солай ма? Бұл олай емес сияқты
Dialogue: 0,0:06:04.48,0:06:06.11,Default,,0,0,0,,(Дұрыс жауап қоңырауы және есік жабылған дыбыс)
Dialogue: 0,0:06:07.03,0:06:09.36,Default,,0,0,0,,Әй, бұл көздер...
Dialogue: 0,0:06:09.49,0:06:12.62,Default,,0,0,0,,Әй, мен жоқта анам бөлме іздей ме?
Dialogue: 0,0:06:12.62,0:06:13.20,Default,,0,0,0,,Әй, мен жоқта мама бөлме іздей ме?
Dialogue: 0,0:06:12.62,0:06:13.20,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:13.20,0:06:13.74,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:13.87,0:06:14.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:15.04,0:06:17.41,Default,,0,0,0,,...Ол өте шулы.
Dialogue: 0,0:06:17.54,0:06:18.50,Default,,0,0,0,,Мен оны міндетті түрде іздеймін.
Dialogue: 0,0:06:18.62,0:06:19.67,Default,,0,0,0,,Тодороки, сен не айтып тұрсың өзің?
Dialogue: 0,0:06:19.87,0:06:21.13,Default,,0,0,0,,Өте көп
Dialogue: 0,0:06:21.29,0:06:22.84,Default,,0,0,0,,Сіз көп үнемдедіңіз.
Dialogue: 0,0:06:22.96,0:06:24.88,Default,,0,0,0,,Мен оны лақтырып тастасам немесе өртеп жіберсем ше?
Dialogue: 0,0:06:25.00,0:06:26.63,Default,,0,0,0,,Не болса да, осы уақытқа дейін...
Dialogue: 0,0:06:26.76,0:06:27.51,Default,,0,0,0,,Ноби-чан
Dialogue: 0,0:06:27.51,0:06:28.84,Default,,0,0,0,,Ноби-чан
Dialogue: 0,0:06:27.51,0:06:28.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:29.18,0:06:30.76,Default,,0,0,0,,Мен саған тапсырма беремін.
Dialogue: 0,0:06:30.89,0:06:32.05,Default,,0,0,0,,Иә
Dialogue: 0,0:06:32.18,0:06:33.64,Default,,0,0,0,,Мен бөлмені босатуға тырысамын.
Dialogue: 0,0:06:33.81,0:06:35.60,Default,,0,0,0,,О, сен не істеп жүрсің?
Dialogue: 0,0:06:35.72,0:06:37.35,Default,,0,0,0,,Бұл мектеп сөмкесі қандай?
Dialogue: 0,0:06:37.48,0:06:38.52,Default,,0,0,0,,А, бұл.
Dialogue: 0,0:06:38.64,0:06:41.44,Default,,0,0,0,,Осы кезде мен достарыммен бірге оқуды ойладым.
Dialogue: 0,0:06:41.56,0:06:43.82,Default,,0,0,0,,Ал, мен барамын.
Dialogue: 0,0:06:43.98,0:06:45.02,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:06:46.07,0:06:49.65,Default,,0,0,0,,Ху... Қашу әзірге сәтті болды.
Dialogue: 0,0:06:49.82,0:06:51.28,Default,,0,0,0,,Енді не істейміз?
Dialogue: 0,0:06:51.41,0:06:53.62,Default,,0,0,0,,Әзірге сатып алуды аяқтаңыз
Dialogue: 0,0:06:54.70,0:06:56.20,Default,,0,0,0,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:06:56.33,0:06:58.70,Default,,0,0,0,,Мен бәрібір сатып алуды аяқтадым.
Dialogue: 0,0:06:58.83,0:07:00.25,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:07:00.37,0:07:03.21,Default,,0,0,0,,Мен 0 ұпайлар тобына қатысты бірдеңе жасамайынша үйге бара алмаймын.
Dialogue: 0,0:07:03.33,0:07:04.84,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:07:04.96,0:07:07.26,Default,,0,0,0,,Сонымен не істеуім керек?
Dialogue: 0,0:07:07.38,0:07:09.47,Default,,0,0,0,,«Мен не істеуім керек?»... Аа, дұрыс.
Dialogue: 0,0:07:09.59,0:07:11.18,Default,,0,0,0,,Егер мен оны досыма қалдырсам ше?
Dialogue: 0,0:07:11.30,0:07:12.26,Default,,0,0,0,,Төтенше
Dialogue: 0,0:07:12.39,0:07:15.47,Default,,0,0,0,,Бірдеңе болып қалса, олар сені мазақ етуді күтіп отыр.
Dialogue: 0,0:07:15.60,0:07:18.02,Default,,0,0,0,,Әсіресе, Сунео оны көрсе...
Dialogue: 0,0:07:18.31,0:07:19.02,Default,,0,0,0,,Сунео!?
Dialogue: 0,0:07:19.18,0:07:20.27,Default,,0,0,0,,Ах
Dialogue: 0,0:07:21.31,0:07:26.19,Default,,0,0,0,,Мен... Мен оны көрмедім. Бұл менің қиялым ғана.
Dialogue: 0,0:07:26.32,0:07:26.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:27.07,0:07:28.94,Default,,0,0,0,,А, мен көрген жоқпын.
Dialogue: 0,0:07:29.07,0:07:30.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:31.86,0:07:34.28,Default,,0,0,0,,(поезд мүйізі)
Dialogue: 0,0:07:34.41,0:07:37.08,Default,,0,0,0,,Қыдырсаң күн батады.
Dialogue: 0,0:07:37.20,0:07:39.62,Default,,0,0,0,,Оны неге арғы тауға көмбейсіңдер?
Dialogue: 0,0:07:39.75,0:07:40.41,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:41.16,0:07:44.46,Default,,0,0,0,,Бірақ сені біреу қазып алса ше?
Dialogue: 0,0:07:44.58,0:07:46.38,Default,,0,0,0,,Мысалы, ит
Dialogue: 0,0:07:46.75,0:07:48.88,Default,,0,0,0,,Иә, оны қолданайық.
Dialogue: 0,0:07:49.01,0:07:50.84,Default,,0,0,0,,Барлық жерде зал!
Dialogue: 0,0:07:51.30,0:07:55.26,Default,,0,0,0,,Жерде өздігінен пайда болған қуыстар көп.
Dialogue: 0,0:07:55.60,0:07:57.64,Default,,0,0,0,,Бұл оны іздейтін машина.
Dialogue: 0,0:07:57.81,0:08:00.52,Default,,0,0,0,,Хаха қосылды
Dialogue: 0,0:08:00.64,0:08:03.64,Default,,0,0,0,,Дүниенің бір жеріндегі ойпаңға жалғанған.
Dialogue: 0,0:08:03.77,0:08:04.94,Default,,0,0,0,,Иә
Dialogue: 0,0:08:05.06,0:08:06.19,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:08:06.31,0:08:08.11,Default,,0,0,0,,Шынында да тесік бар.
Dialogue: 0,0:08:09.53,0:08:10.90,Default,,0,0,0,,Жарайды, ішке кірейік.
Dialogue: 0,0:08:11.03,0:08:12.65,Default,,0,0,0,,Абайлаңыз (Нобита) Иә.
Dialogue: 0,0:08:13.20,0:08:14.57,Default,,0,0,0,,Дат
Dialogue: 0,0:08:15.45,0:08:19.95,Default,,0,0,0,,Егер кенеттен кірсеңіз, газ немесе жер асты суы жиналуы мүмкін.
Dialogue: 0,0:08:20.08,0:08:22.04,Default,,0,0,0,,Маған тезірек айтыңыз
Dialogue: 0,0:08:22.41,0:08:24.04,Default,,0,0,0,,Мен мұны осы жолы істеймін
Dialogue: 0,0:08:24.17,0:08:25.71,Default,,0,0,0,,(сигнал дыбысы)
Dialogue: 0,0:08:26.67,0:08:28.50,Default,,0,0,0,,Менің ойымша, бұл жолы бәрі жақсы болады.
Dialogue: 0,0:08:28.63,0:08:30.00,Default,,0,0,0,,(Ходжинс) Бүгіннен бастап мен Автоматты жазу қуыршағының шәкірті болып жұмыс істеймін.
Dialogue: 0,0:08:30.96,0:08:35.47,Default,,0,0,0,,Иә, газ немесе жер асты суы жоқ, бұл өте үлкен үңгір сияқты.
Dialogue: 0,0:08:35.59,0:08:36.84,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:39.22,0:08:40.68,Default,,0,0,0,,Амансың ба? Дораемон
Dialogue: 0,0:08:40.81,0:08:44.73,Default,,0,0,0,,Иә, мұнда жүздеген 0 ұпайларды жасыруға болады.
Dialogue: 0,0:08:44.85,0:08:46.98,Default,,0,0,0,,Неше жүздік? Біраз тереңірек...
Dialogue: 0,0:08:47.10,0:08:48.36,Default,,0,0,0,,Вааа…
Dialogue: 0,0:08:48.48,0:08:50.40,Default,,0,0,0,,Дораемон, бұл тас қараңғы
Dialogue: 0,0:08:50.53,0:08:51.73,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:08:51.86,0:08:53.95,Default,,0,0,0,,Пиккаригоке!
Dialogue: 0,0:08:54.07,0:08:56.16,Default,,0,0,0,,А, сен көрмейсің бе? Қараңғы.
Dialogue: 0,0:08:56.28,0:09:00.08,Default,,0,0,0,,Бұл тасқа жабысып, жарық беретін мүк түрі.
Dialogue: 0,0:09:00.20,0:09:02.25,Default,,0,0,0,,Олар көбеюін жалғастырады.
Dialogue: 0,0:09:02.37,0:09:04.21,Default,,0,0,0,,Уау, әдемі екен.
Dialogue: 0,0:09:04.33,0:09:07.00,Default,,0,0,0,,Хехе, мұнымен көп нәрсені жасыруға болады.
Dialogue: 0,0:09:07.29,0:09:08.58,Default,,0,0,0,,Ал...
Dialogue: 0,0:09:09.13,0:09:10.46,Default,,0,0,0,,Нобита-кун, болды!
Dialogue: 0,0:09:10.84,0:09:12.26,Default,,0,0,0,,А, мен білемін, білемін
Dialogue: 0,0:09:12.38,0:09:14.76,Default,,0,0,0,,«0 ұпай алмас үшін оқы», солай ма?
Dialogue: 0,0:09:14.88,0:09:15.93,Default,,0,0,0,,Хехе, мен барамын.
Dialogue: 0,0:09:16.55,0:09:18.93,Default,,0,0,0,,...Ең болмағанда! Қызық, түсінесіз бе?
Dialogue: 0,0:09:19.97,0:09:23.35,Default,,0,0,0,,Ей, бұл жер керемет. Бүйірлік тесіктер өте көп.
Dialogue: 0,0:09:23.68,0:09:26.69,Default,,0,0,0,,Нобита-кун, ертең жайлап барайық.
Dialogue: 0,0:09:26.81,0:09:28.85,Default,,0,0,0,,Жасырғыңыз келетін нәрсені жылдам, жылдам жасырыңыз.
Dialogue: 0,0:09:28.98,0:09:31.27,Default,,0,0,0,,А, дұрыс! анамның сатып алуы
Dialogue: 0,0:09:34.15,0:09:36.74,Default,,0,0,0,,Уау, ұмытып кете жаздадым.
Dialogue: 0,0:09:38.03,0:09:40.37,Default,,0,0,0,,А, мен оны ала аламын ба?
Dialogue: 0,0:09:40.49,0:09:45.33,Default,,0,0,0,,Циферблаттағы шкала есіңізде болса, ол тесікке кез келген бағыттан кіруге болады.
Dialogue: 0,0:09:45.45,0:09:46.37,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:46.50,0:09:48.75,Default,,0,0,0,,Менің ойымша, ол 0 ұпайды артта қалдырды.
Dialogue: 0,0:09:48.87,0:09:50.79,Default,,0,0,0,,Ух, әрине.
Dialogue: 0,0:09:50.92,0:09:52.63,Default,,0,0,0,,А, жақсы.
Dialogue: 0,0:09:52.75,0:09:54.71,Default,,0,0,0,,...Жарайды ма?
Dialogue: 0,0:09:58.30,0:10:01.39,Default,,0,0,0,,Иә, мен солай ойлаймын...
Dialogue: 0,0:10:01.51,0:10:02.14,Default,,0,0,0,,Иә
Dialogue: 0,0:10:02.76,0:10:05.68,Default,,0,0,0,,Онда алаңдайтын ештеңе жоқ.
Dialogue: 0,0:10:05.93,0:10:09.52,Default,,0,0,0,,Мм... Негізі мен бүгін біртүрлі нәрсе көргендей болдым.
Dialogue: 0,0:10:09.98,0:10:12.11,Default,,0,0,0,,Жоқ, бұл қызықсыз.
Dialogue: 0,0:10:12.82,0:10:16.07,Default,,0,0,0,,Рахмет, Декисуги-кун, мен өзімді еркін сезінемін.
Dialogue: 0,0:10:16.44,0:10:18.49,Default,,0,0,0,,Рахмет, көріскенше
Dialogue: 0,0:10:18.70,0:10:22.49,Default,,0,0,0,,Ах, енді мен тыныш ұйықтай аламын хахаха
Dialogue: 0,0:10:22.66,0:10:23.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:27.71,0:10:28.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:29.71,0:10:30.67,Default,,0,0,0,,Хуа?
Dialogue: 0,0:10:41.55,0:10:47.31,Default,,0,0,0,,(динозаврлардың ізі)
Dialogue: 0,0:10:47.43,0:10:49.94,Default,,0,0,0,,(Әскерлердің үрейлі дауыстары)
Dialogue: 0,0:10:51.15,0:10:52.98,Default,,0,0,0,,Сунечама, не болып жатыр?
Dialogue: 0,0:10:53.11,0:10:55.69,Default,,0,0,0,,Бақ бақшасы! Кио Кио Кё!
Dialogue: 0,0:10:55.82,0:10:56.82,Default,,0,0,0,,Кио Кио Кио…
Dialogue: 0,0:10:57.28,0:10:59.40,Default,,0,0,0,,(Сунеоның қорқынышты дауысы)
Dialogue: 0,0:10:59.53,0:11:03.45,Default,,0,0,0,,Мұнда ештеңе жоқ. Не болып жатыр?
Dialogue: 0,0:11:03.57,0:11:05.28,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:11:05.74,0:11:08.83,Default,,0,0,0,,Иә? Мен сонда бардым, бірақ...
Dialogue: 0,0:11:09.00,0:11:11.29,Default,,0,0,0,,Анашым менде невроз бар
Dialogue: 0,0:11:11.42,0:11:13.17,Default,,0,0,0,,Аа, Сунечама басқа балаларға қарағанда жақсы.
Dialogue: 0,0:11:13.29,0:11:16.25,Default,,0,0,0,,Бұл өте нәзік.
Dialogue: 0,0:11:19.67,0:11:21.13,Default,,0,0,0,,Дораемон
Dialogue: 0,0:11:25.68,0:11:26.89,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:11:29.35,0:11:30.27,Default,,0,0,0,,Айдаһар…
Dialogue: 0,0:11:30.39,0:11:31.73,Default,,0,0,0,,Мен көптен күттім
Dialogue: 0,0:11:31.85,0:11:35.52,Default,,0,0,0,,Осы бөлмеден кіре аламыз ба? Хмм.
Dialogue: 0,0:11:35.98,0:11:37.44,Default,,0,0,0,,Егер сіз циферблатты бұрсаңыз—
Dialogue: 0,0:11:37.57,0:11:40.49,Default,,0,0,0,,Осы жерден де сол қуысқа қосылуға болады.
Dialogue: 0,0:11:41.15,0:11:44.53,Default,,0,0,0,,Ал, циферблатты 299 М-ге бұрыңыз...
Dialogue: 0,0:11:44.66,0:11:45.83,Default,,0,0,0,,(сигнал дыбысы)
Dialogue: 0,0:11:46.03,0:11:46.95,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:11:47.08,0:11:48.33,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:11:48.45,0:11:50.45,Default,,0,0,0,,Аа, сәл күте тұрыңыз, мен сізге аяқ киім әкелемін.
Dialogue: 0,0:11:51.29,0:11:54.25,Default,,0,0,0,,Пиккаригоке барлық жерде көбейіп жатыр.
Dialogue: 0,0:11:54.38,0:11:56.84,Default,,0,0,0,,Шынымен, бұл үңгір емес деп ойлаймын.
Dialogue: 0,0:11:56.96,0:11:59.96,Default,,0,0,0,,Дұрыс есімде болса, 0 ұпай... А, мінекей.
Dialogue: 0,0:12:00.09,0:12:02.43,Default,,0,0,0,,Фуфу осы жерде
Dialogue: 0,0:12:05.22,0:12:08.22,Default,,0,0,0,,Менің ойымша, бұл осы жерде...
Dialogue: 0,0:12:08.35,0:12:09.10,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:12:09.22,0:12:09.85,Default,,0,0,0,,Бар ма?
Dialogue: 0,0:12:11.35,0:12:12.31,Default,,0,0,0,,Жақсы болды.
Dialogue: 0,0:12:12.77,0:12:15.35,Default,,0,0,0,,Неліктен оны дұрысырақ сейфке қайта салмайсыз?
Dialogue: 0,0:12:15.48,0:12:17.31,Default,,0,0,0,,Не? Сіз мұны істей аласыз ба?
Dialogue: 0,0:12:17.44,0:12:20.73,Default,,0,0,0,,Ыстық суы бар жылдам бөлме жинағы!
Dialogue: 0,0:12:21.19,0:12:24.49,Default,,0,0,0,,Сіз кез келген жерде бос орындар мен бөлмелер жасай аласыз.
Dialogue: 0,0:12:24.61,0:12:28.20,Default,,0,0,0,,Өлшемдері сіріңке қораптарынан ірі қалаларға дейін.
Dialogue: 0,0:12:28.78,0:12:31.04,Default,,0,0,0,,Иә, бұл сейфтің дәні.
Dialogue: 0,0:12:31.16,0:12:32.20,Default,,0,0,0,,Уау, кішкентай
Dialogue: 0,0:12:32.33,0:12:34.67,Default,,0,0,0,,Барлық дәндердің өлшемдері бірдей
Dialogue: 0,0:12:34.79,0:12:38.59,Default,,0,0,0,,Алдымен оны тесікке салыңыз, содан кейін үстіне ыстық су құйыңыз.
Dialogue: 0,0:12:38.71,0:12:41.63,Default,,0,0,0,,Егер ол сейфтің өлшемі болса, 1 секунд болуы мүмкін, жарай ма?
Dialogue: 0,0:12:43.76,0:12:45.80,Default,,0,0,0,,Бұл рас, бұл таңқаларлық.
Dialogue: 0,0:12:46.22,0:12:48.55,Default,,0,0,0,,Эй, сен менің бөлмемді жасай аласың ба?
Dialogue: 0,0:12:48.68,0:12:51.02,Default,,0,0,0,,Ал... бұл бөлім жақсы.
Dialogue: 0,0:12:51.14,0:12:52.35,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:12:54.48,0:12:55.73,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:12:55.85,0:12:57.48,Default,,0,0,0,,Уау уау
Dialogue: 0,0:12:57.86,0:13:00.15,Default,,0,0,0,,Керемет. Тіпті жиһазы да бар.
Dialogue: 0,0:13:00.27,0:13:01.73,Default,,0,0,0,,Сіз қалай ойлайсыз? Ол саған ұнады ма?
Dialogue: 0,0:13:01.86,0:13:05.28,Default,,0,0,0,,Әрине! Оны өзімнің құпия базам жасайық
Dialogue: 0,0:13:05.40,0:13:06.24,Default,,0,0,0,,Сәлем Дораемон
Dialogue: 0,0:13:06.36,0:13:09.03,Default,,0,0,0,,«Сидзука-чанға да айта аламын ба?» Дұрыс па?
Dialogue: 0,0:13:09.16,0:13:10.20,Default,,0,0,0,,Иә? Бұл жақсы ма?
Dialogue: 0,0:13:10.33,0:13:10.95,Default,,0,0,0,,Әрине
Dialogue: 0,0:13:11.08,0:13:13.45,Default,,0,0,0,,Иә! Мен сізге сол кезде хабарлаймын.
Dialogue: 0,0:13:13.58,0:13:16.37,Default,,0,0,0,,Қызық, Шизука-чан жетеді ме?
Dialogue: 0,0:13:17.12,0:13:18.04,Default,,0,0,0,,Хаа…
Dialogue: 0,0:13:18.17,0:13:20.46,Default,,0,0,0,,Сіз өзіңізді жақсы сезінбейсіз.
Dialogue: 0,0:13:20.84,0:13:22.09,Default,,0,0,0,,Хаа…
Dialogue: 0,0:13:22.80,0:13:24.97,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:13:25.09,0:13:26.55,Default,,0,0,0,,Мен неврозбен ауырдым.
Dialogue: 0,0:13:26.68,0:13:28.84,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:28.97,0:13:33.27,Default,,0,0,0,,Мен сияқты жүрегі сезімтал адамдар тез қобалжиды.
Dialogue: 0,0:13:33.56,0:13:35.10,Default,,0,0,0,,Мен және Онаши
Dialogue: 0,0:13:35.23,0:13:35.85,Default,,0,0,0,,Қай жағынан?
Dialogue: 0,0:13:35.98,0:13:36.64,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:36.77,0:13:37.65,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:13:37.77,0:13:39.23,Default,,0,0,0,,Анам өте шулы
Dialogue: 0,0:13:39.56,0:13:43.40,Default,,0,0,0,,«Тәкеши, оқы» «Дүкенді күт» Бұл қайталанады.
Dialogue: 0,0:13:43.53,0:13:45.40,Default,,0,0,0,,Мен мұрындық болып барамын
Dialogue: 0,0:13:45.53,0:13:48.74,Default,,0,0,0,,Мен жалғыз болатын жер бар ма?
Dialogue: 0,0:13:49.07,0:13:51.03,Default,,0,0,0,,Хаа…
Dialogue: 0,0:13:51.33,0:13:53.74,Default,,0,0,0,,Бұл біздің құпия базамыз.
Dialogue: 0,0:13:53.87,0:13:54.33,Default,,0,0,0,,Кең және тыныш -
Dialogue: 0,0:13:54.33,0:13:54.95,Default,,0,0,0,,Кең және тыныш -
Dialogue: 0,0:13:54.33,0:13:54.95,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:54.95,0:13:55.50,Default,,0,0,0,,Кең және тыныш -
Dialogue: 0,0:13:55.62,0:13:56.83,Default,,0,0,0,,Мен не істесем де, ешкім шағымданбайды.
Dialogue: 0,0:13:56.83,0:13:57.46,Default,,0,0,0,,Мен не істесем де, маған ешкім шағым айтпайды.
Dialogue: 0,0:13:56.83,0:13:57.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:57.46,0:13:59.08,Default,,0,0,0,,Мен не істесем де, маған ешкім шағым түсірмейді.
Dialogue: 0,0:13:59.21,0:14:00.67,Default,,0,0,0,,Маған айтпа
Dialogue: 0,0:14:00.79,0:14:01.67,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:01.79,0:14:03.13,Default,,0,0,0,,Сен Нобита
Dialogue: 0,0:14:03.25,0:14:04.42,Default,,0,0,0,,Ха! Ах...
Dialogue: 0,0:14:04.55,0:14:06.05,Default,,0,0,0,,Юлиус, Нектті көтер!
Dialogue: 0,0:14:06.42,0:14:08.01,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:14:08.84,0:14:12.39,Default,,0,0,0,,Жақсы, жақсы, мен осылай шығады деп ойладым.
Dialogue: 0,0:14:12.51,0:14:13.39,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:14:13.51,0:14:14.97,Default,,0,0,0,,Осы жерге тесік қойыңыз
Dialogue: 0,0:14:16.39,0:14:20.02,Default,,0,0,0,,Бос орын көп, сондықтан сіз өзіңізге ұнайтын жерде бөлме жасай аласыз.
Dialogue: 0,0:14:20.15,0:14:22.69,Default,,0,0,0,,Ой, ол қанша уақытқа созылады?
Dialogue: 0,0:14:22.82,0:14:24.61,Default,,0,0,0,,Жақында зерттеп көрейік.
Dialogue: 0,0:14:25.11,0:14:27.24,Default,,0,0,0,,Уау, қандай жақсы бөлме
Dialogue: 0,0:14:27.36,0:14:30.57,Default,,0,0,0,,Мен ешкімге алаңдамай скрипкада ойнай аламын.
Dialogue: 0,0:14:30.70,0:14:32.16,Default,,0,0,0,,Оның душ кабинасы бар.
Dialogue: 0,0:14:32.28,0:14:33.58,Default,,0,0,0,,Хе, рахмет
Dialogue: 0,0:14:33.83,0:14:34.79,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:14:34.91,0:14:36.87,Default,,0,0,0,,Маған оның сахнасы бар екені ұнайды.
Dialogue: 0,0:14:37.00,0:14:38.62,Default,,0,0,0,,Бірден қайталауды жаттықтыру
Dialogue: 0,0:14:38.75,0:14:39.79,Default,,0,0,0,,Мен мұны өз бетімше жасасам ше?
Dialogue: 0,0:14:39.92,0:14:40.54,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:14:42.54,0:14:44.17,Default,,0,0,0,,Мен киімдерімді аламын.
Dialogue: 0,0:14:44.30,0:14:45.38,Default,,0,0,0,,Бұл не үшін? О?
Dialogue: 0,0:14:45.88,0:14:50.13,Default,,0,0,0,,Сіз жиі шулайсыз. Тыныш болғаныңды қалаймын.
Dialogue: 0,0:14:51.34,0:14:53.64,Default,,0,0,0,,Алысқа барсаң, адасып кетесің.
Dialogue: 0,0:14:53.76,0:14:55.60,Default,,0,0,0,,Ол мұрынды.
Dialogue: 0,0:14:55.72,0:14:56.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:56.64,0:14:58.14,Default,,0,0,0,,Не айтсаң да
Dialogue: 0,0:14:58.27,0:15:03.02,Default,,0,0,0,,Дүниенің қиыншылықтарынан алыс, тек жер астындағы тыныш ортада.
Dialogue: 0,0:15:03.15,0:15:05.77,Default,,0,0,0,,Менің жаралы жүрегімді емдейді.
Dialogue: 0,0:15:09.53,0:15:11.82,Default,,0,0,0,,Осыншама алыста болсақ жақсы болар еді.
Dialogue: 0,0:15:13.07,0:15:16.33,Default,,0,0,0,,Тыныш. Қандай тыныш.
Dialogue: 0,0:15:16.91,0:15:19.58,Default,,0,0,0,,Көрініс құлағымды ауыртады.
Dialogue: 0,0:15:19.71,0:15:20.79,Default,,0,0,0,,(шу)
Dialogue: 0,0:15:21.04,0:15:23.79,Default,,0,0,0,,Жер астында шу шығаратын кім?
Dialogue: 0,0:15:24.84,0:15:26.63,Default,,0,0,0,,(шуға жақындау)
Dialogue: 0,0:15:27.76,0:15:28.84,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:15:28.96,0:15:34.97,Default,,0,0,0,,(Орда қадамдары)
Dialogue: 0,0:15:41.27,0:15:44.40,Default,,0,0,0,,Кио Кио Кио Кио Кио динозавр!
Dialogue: 0,0:15:44.61,0:15:46.40,Default,,0,0,0,,Динозаврлар?
Dialogue: 0,0:15:46.65,0:15:47.98,Default,,0,0,0,,Уф, өтірік емес.
Dialogue: 0,0:15:48.11,0:15:49.40,Default,,0,0,0,,Хо хо хо хо бұл шынайы!
Dialogue: 0,0:15:49.99,0:15:51.20,Default,,0,0,0,,Тағы да солай...
Dialogue: 0,0:15:51.32,0:15:53.03,Default,,0,0,0,,Уау, өте кең.
Dialogue: 0,0:15:53.16,0:15:55.70,Default,,0,0,0,,Бұл әлемдегі ең үлкен қуыс болуы мүмкін.
Dialogue: 0,0:15:55.82,0:15:57.33,Default,,0,0,0,,Көптеген динозаврлар, солай ма?
Dialogue: 0,0:15:57.45,0:15:58.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:58.58,0:15:59.79,Default,,0,0,0,,Қайда?
Dialogue: 0,0:15:59.91,0:16:02.25,Default,,0,0,0,,А... өтірік пе? иә?
Dialogue: 0,0:16:02.37,0:16:05.25,Default,,0,0,0,,Мен шынымен де бір сәт бұрын сонда болдым. Бұл рас!
Dialogue: 0,0:16:05.92,0:16:08.38,Default,,0,0,0,,«Жойылды» деген Сунео болды.
Dialogue: 0,0:16:08.50,0:16:09.76,Default,,0,0,0,,Онда жоқ адам жоқ.
Dialogue: 0,0:16:10.46,0:16:13.51,Default,,0,0,0,,Ей, ұмытайық, өйткені мен де бас тарттым.
Dialogue: 0,0:16:13.63,0:16:15.68,Default,,0,0,0,,Иә! Қатты ойнасаң, сауығып кетесің.
Dialogue: 0,0:16:15.80,0:16:16.97,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:16:17.10,0:16:18.68,Default,,0,0,0,,Бұл сырттай дабыл беретін теледидар.
Dialogue: 0,0:16:19.06,0:16:21.85,Default,,0,0,0,,Нобита қайда кетті деп қызық...
Dialogue: 0,0:16:21.98,0:16:24.10,Default,,0,0,0,,Мен оны мүмкіндігінше орнаттым.
Dialogue: 0,0:16:24.69,0:16:26.98,Default,,0,0,0,,Менің анамды кездестіретін уақытым таяп қалды...
Dialogue: 0,0:16:27.11,0:16:29.86,Default,,0,0,0,,Ойланып қарасам, мен үй тапсырмасын орындамадым.
Dialogue: 0,0:16:29.98,0:16:32.78,Default,,0,0,0,,Дорэмон, бүгін үйге қайтайық.
Dialogue: 0,0:16:32.90,0:16:33.99,Default,,0,0,0,,Иә
Dialogue: 0,0:16:35.57,0:16:37.57,Default,,0,0,0,,Сіз оны шынымен көрдіңіз бе?
Dialogue: 0,0:16:38.24,0:16:41.37,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:16:43.37,0:16:47.54,Default,,0,0,0,,(поезд мүйізі)
Dialogue: 0,0:16:52.55,0:16:57.26,Default,,0,0,0,,Оңтүстік Италиядағы Неаполис қаласы.
Dialogue: 0,0:16:59.47,0:17:01.14,Default,,0,0,0,,Иә, мен Нобимін.
Dialogue: 0,0:17:01.72,0:17:04.14,Default,,0,0,0,,Сәлеметсіз бе, мен Такеши Гоудамын.
Dialogue: 0,0:17:04.48,0:17:06.27,Default,,0,0,0,,О, Такеши мырза
Dialogue: 0,0:17:06.40,0:17:08.11,Default,,0,0,0,,Иә, Нобита сонда болады.
Dialogue: 0,0:17:08.73,0:17:11.82,Default,,0,0,0,,Мен достарыммен оқу сабағына жиналуды жоспарлап отырмын.
Dialogue: 0,0:17:11.94,0:17:13.57,Default,,0,0,0,,Ол әлі келген жоқ.
Dialogue: 0,0:17:13.94,0:17:17.95,Default,,0,0,0,,О, дұрыс. Мен сені бірден жіберемін. Кешіріңіз.
Dialogue: 0,0:17:18.07,0:17:18.99,Default,,0,0,0,,Нобита!
Dialogue: 0,0:17:20.45,0:17:22.08,Default,,0,0,0,,Кеттік
Dialogue: 0,0:17:23.12,0:17:25.00,Default,,0,0,0,,О, бұған дейін
Dialogue: 0,0:17:27.54,0:17:30.92,Default,,0,0,0,,Сәлеметсіз бе, бұл Гота мырзаның үйі ме? Мен Нобитамын.
Dialogue: 0,0:17:31.25,0:17:36.18,Default,,0,0,0,,Дұрыс. Сіз оқып жатырсыз. Бұл жақсы болса да.
Dialogue: 0,0:17:36.30,0:17:38.18,Default,,0,0,0,,Эй, эй, айттым ғой.
Dialogue: 0,0:17:38.30,0:17:39.26,Default,,0,0,0,,Иә
Dialogue: 0,0:17:39.39,0:17:41.43,Default,,0,0,0,,Мен дүкеншіден сұрайын деп ойладым.
Dialogue: 0,0:17:41.56,0:17:42.56,Default,,0,0,0,,Кеттік
Dialogue: 0,0:17:42.93,0:17:44.39,Default,,0,0,0,,Бұл не жүк?
Dialogue: 0,0:17:44.98,0:17:47.35,Default,,0,0,0,,Себебі мен көп оқимын.
Dialogue: 0,0:17:47.85,0:17:49.27,Default,,0,0,0,,А, міне, осында.
Dialogue: 0,0:17:49.40,0:17:50.36,Default,,0,0,0,,(Джианның ауыр тыныс алуы)
Dialogue: 0,0:17:50.90,0:17:54.07,Default,,0,0,0,,Маған сенбесең, үйден шығуың қиын болады.
Dialogue: 0,0:17:54.19,0:17:55.61,Default,,0,0,0,,Жүр, ішке кірейік.
Dialogue: 0,0:17:57.78,0:17:59.41,Default,,0,0,0,,Розетка
Dialogue: 0,0:17:59.53,0:18:00.74,Default,,0,0,0,,Олай болса, кешіріңіз...
Dialogue: 0,0:18:00.87,0:18:03.24,Default,,0,0,0,,Ах! Бірге жақсы, бірге жақсы
Dialogue: 0,0:18:04.08,0:18:05.70,Default,,0,0,0,,Дехехехехе
Dialogue: 0,0:18:06.16,0:18:07.62,Default,,0,0,0,,Кейін кездескенше, иә.
Dialogue: 0,0:18:07.87,0:18:09.58,Default,,0,0,0,,Барлығы, сақ болыңдар
Dialogue: 0,0:18:09.71,0:18:10.29,Default,,0,0,0,,Білемін, білемін, содан кейін.
Dialogue: 0,0:18:10.29,0:18:11.59,Default,,0,0,0,,Білемін, білемін, содан кейін.
Dialogue: 0,0:18:10.29,0:18:11.59,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:18:11.59,0:18:12.38,Default,,0,0,0,,Білемін, білемін, кездескенше.
Dialogue: 0,0:18:12.75,0:18:14.67,Default,,0,0,0,,Енді, ең алдымен!
Dialogue: 0,0:18:14.80,0:18:16.51,Default,,0,0,0,,Үй тапсырмасын орында...
Dialogue: 0,0:18:16.97,0:18:18.22,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:18:18.34,0:18:21.60,Default,,0,0,0,,(Нобитаның қорылдауы)
Dialogue: 0,0:18:21.72,0:18:26.56,Default,,0,0,0,,Косэй тағы да күйреуге ұшырайды.
Dialogue: 0,0:18:26.68,0:18:28.31,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:28.44,0:18:32.23,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:18:33.44,0:18:36.36,Default,,0,0,0,,Барлығы өте көңілді жүрген сияқты.
Dialogue: 0,0:18:36.49,0:18:38.90,Default,,0,0,0,,Мен оны біраз уақытқа қалдыруым керек пе?
Dialogue: 0,0:18:39.03,0:18:41.57,Default,,0,0,0,,Аа, дұрыс. Сунео-кун қайда кетті?
Dialogue: 0,0:18:44.91,0:18:45.54,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:18:46.29,0:18:49.54,Default,,0,0,0,,Менің алдымнан үлкен динозаврлар тобы өтті.
Dialogue: 0,0:18:50.37,0:18:53.50,Default,,0,0,0,,Динозаврлар 65 миллион жыл бұрын жойылған болуы керек еді...
Dialogue: 0,0:18:54.29,0:18:57.13,Default,,0,0,0,,Әлде бұл динозавр елесі ме?
Dialogue: 0,0:18:57.26,0:18:59.76,Default,,0,0,0,,Сол аймақта әлі де рухтар жүр.
Dialogue: 0,0:18:59.88,0:19:02.43,Default,,0,0,0,,Осындай кезде камераға суретке түсуіңіз мүмкін.
Dialogue: 0,0:19:03.10,0:19:04.60,Default,,0,0,0,,Мына төбеге барайық
Dialogue: 0,0:19:04.89,0:19:07.47,Default,,0,0,0,,Бүгін біз жұмбақ шешеміз.
Dialogue: 0,0:19:11.85,0:19:14.06,Default,,0,0,0,,Ах! Бұл тамаша жазық
Dialogue: 0,0:19:15.44,0:19:17.69,Default,,0,0,0,,Бір нәрсені суретке түсіру мүмкін
Dialogue: 0,0:19:19.65,0:19:21.49,Default,,0,0,0,,(Радиомен басқарылатын ұшу дыбысы)
Dialogue: 0,0:19:21.61,0:19:22.36,Default,,0,0,0,,Не?
Dialogue: 0,0:19:23.70,0:19:25.66,Default,,0,0,0,,Иә? Бұл дұрыс...
Dialogue: 0,0:19:26.03,0:19:28.41,Default,,0,0,0,,А, мынау Тана өзенінің түбіне батып кеткен радиобасқару...
Dialogue: 0,0:19:29.00,0:19:31.92,Default,,0,0,0,,Бұл радиомен басқарылатын елес.
Dialogue: 0,0:19:33.04,0:19:34.13,Default,,0,0,0,,Уууу…
Dialogue: 0,0:19:34.96,0:19:35.63,Default,,0,0,0,,(Радиомен басқарылатын ұшу дыбысы)
Dialogue: 0,0:19:35.79,0:19:37.05,Default,,0,0,0,,Енді жоқ!
Dialogue: 0,0:19:39.51,0:19:41.43,Default,,0,0,0,,Дат
Dialogue: 0,0:19:41.72,0:19:43.01,Default,,0,0,0,,Уау
Dialogue: 0,0:19:43.14,0:19:43.76,Default,,0,0,0,,Жоғалып кетті…
Dialogue: 0,0:19:44.05,0:19:46.26,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:19:46.39,0:19:49.73,Default,,0,0,0,,Иә? Мына жер қайда?
Dialogue: 0,0:19:50.85,0:19:54.31,Default,,0,0,0,,Сәлем Дораемон!
Dialogue: 0,0:19:54.90,0:19:56.77,Default,,0,0,0,,Нобита!
Dialogue: 0,0:19:57.90,0:20:00.15,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,0:20:02.11,0:20:04.45,Default,,0,0,0,,Мен адасып қалдым ба деп ойлаймын.
Dialogue: 0,0:20:05.41,0:20:08.45,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:20:08.58,0:20:10.04,Default,,0,0,0,,Мама
Dialogue: 0,0:20:10.50,0:20:12.29,Default,,0,0,0,,Ха... уау
Dialogue: 0,0:20:13.37,0:20:14.71,Default,,0,0,0,,Бұл жер асты көлі.
Dialogue: 0,0:20:26.47,0:20:27.47,Default,,0,0,0,,Уау...
Dialogue: 0,0:20:27.60,0:20:28.68,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:28.81,0:20:30.64,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:20:30.89,0:20:32.06,Default,,0,0,0,,Укку…
Dialogue: 0,0:20:32.60,0:20:37.73,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:20:45.78,0:20:46.78,Default,,0,0,0,,Дат
Dialogue: 0,0:20:56.96,0:21:00.92,Default,,0,0,0,,Эй, Нобитаның баяу қарқыны!
Dialogue: 0,0:21:06.93,0:21:08.18,Default,,0,0,0,,Екеуің де барсыңдар!
Dialogue: 0,0:21:08.30,0:21:11.72,Default,,0,0,0,,Үңгірлер қаншалықты терең болса да, бақылаудан шығып кету қауіпті.
Dialogue: 0,0:21:15.48,0:21:18.61,Default,,0,0,0,,Кола! Егер сен жынды болып кететін болсаң, мен саған арбаны бермеймін.
Dialogue: 0,0:21:26.36,0:21:27.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:28.32,0:21:29.70,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:21:29.83,0:21:30.53,Default,,0,0,0,,Не?
Dialogue: 0,0:21:31.87,0:21:34.00,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:21:35.46,0:21:37.29,Default,,0,0,0,,Иә? Бұл сөзсіз...
Dialogue: 0,0:21:37.42,0:21:38.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:38.50,0:21:40.34,Default,,0,0,0,,Сунеоның бейне камерасы.
Dialogue: 0,0:21:40.46,0:21:42.63,Default,,0,0,0,,Не болды... Ах!
Dialogue: 0,0:21:43.17,0:21:45.42,Default,,0,0,0,,Жамандық жасайтын да сол.
Dialogue: 0,0:21:45.55,0:21:48.26,Default,,0,0,0,,Бірақ артта қалған соң қайда кетті?
Dialogue: 0,0:21:48.39,0:21:50.22,Default,,0,0,0,,Ол рұқсатсыз үйіне кетті.
Dialogue: 0,0:21:50.35,0:21:53.18,Default,,0,0,0,,Соңғы кездері бізден қашып жүрген сияқтысың.
Dialogue: 0,0:21:53.31,0:21:56.18,Default,,0,0,0,,А... біз Сунео-санға бірдеңе дедік пе?
Dialogue: 0,0:21:56.31,0:21:58.23,Default,,0,0,0,,Не? Мен айтпаймын
Dialogue: 0,0:21:58.35,0:21:59.52,Default,,0,0,0,,Мен де
Dialogue: 0,0:21:59.65,0:22:01.73,Default,,0,0,0,,Бұл жігіт мұрынды.
Dialogue: 0,0:22:01.86,0:22:04.69,Default,,0,0,0,,Егер сіз оны осылай атағыңыз келсе, бұл «невроз»!
Dialogue: 0,0:22:04.82,0:22:06.28,Default,,0,0,0,,Иә! мұрын көтерілді
Dialogue: 0,0:22:06.40,0:22:07.65,Default,,0,0,0,,О, менің...
Dialogue: 0,0:22:07.78,0:22:08.95,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:07.78,0:22:08.95,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:22:08.95,0:22:11.62,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:22:11.74,0:22:15.87,Default,,0,0,0,,Мен жаңа ғана сіздің үйіңізге бардым...
Dialogue: 0,0:22:16.00,0:22:19.17,Default,,0,0,0,,Жоқ. Сіздің үйіңізде оқу сабағы бар.
Dialogue: 0,0:22:19.29,0:22:20.46,Default,,0,0,0,,Иә!?
Dialogue: 0,0:22:20.58,0:22:22.25,Default,,0,0,0,,Нобита тағы да...
Dialogue: 0,0:22:22.38,0:22:24.30,Default,,0,0,0,,Такеши Сіз өтірік айттыңыз.
Dialogue: 0,0:22:24.59,0:22:25.80,Default,,0,0,0,,Мен қайтып келгенде...
Dialogue: 0,0:22:25.92,0:22:27.26,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:22:27.42,0:22:29.22,Default,,0,0,0,,Ең сорақысы... (Нобита) Үйге тез жетейік.
Dialogue: 0,0:22:29.47,0:22:30.80,Default,,0,0,0,,Бұл жақсырақ сияқты.
Dialogue: 0,0:22:30.93,0:22:31.68,Default,,0,0,0,,Ах (Нобита) Иә.
Dialogue: 0,0:22:33.64,0:22:34.68,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:22:34.81,0:22:37.31,Default,,0,0,0,,Оқу сабақтары енді жұмыс істемейді.
Dialogue: 0,0:22:37.43,0:22:40.48,Default,,0,0,0,,Жаңа бірдеңе ойлаудан басқа амалым жоқ.
Dialogue: 0,0:22:41.15,0:22:42.02,Default,,0,0,0,,Тез барайық (Нобита) Иә.
Dialogue: 0,0:22:42.15,0:22:43.52,Default,,0,0,0,,барлығын бірге орналастырыңыз.
Dialogue: 0,0:22:45.23,0:22:47.61,Default,,0,0,0,,Менің не айтқым келгенін түсіндіңіз деп ойлаймын.
Dialogue: 0,0:22:47.78,0:22:48.45,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:22:48.57,0:22:54.53,Default,,0,0,0,,(жылдам алға дауысты уағыздау)
Dialogue: 0,0:22:56.12,0:22:59.66,Default,,0,0,0,,Әзірге оқушыларға мектептен басқа көшеге шығуға тыйым салынады.
Dialogue: 0,0:22:59.79,0:23:01.63,Default,,0,0,0,,Иә!? Бұл дұрыс…
Dialogue: 0,0:23:01.88,0:23:04.09,Default,,0,0,0,,Дораемон
Dialogue: 0,0:23:04.21,0:23:05.92,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:23:06.17,0:23:06.59,Default,,0,0,0,,Оған көмектесу мүмкін емес, солай ма? Неге біраз уақыт оқуыңызға көңіл бөлмейсіз?
Dialogue: 0,0:23:06.59,0:23:10.09,Default,,0,0,0,,Қолыңнан келмейді, неге біраз уақыт сабаққа көңіл бөлмейсің?
Dialogue: 0,0:23:06.59,0:23:10.09,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:23:10.09,0:23:11.30,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:23:11.43,0:23:13.55,Default,,0,0,0,,Себебі оған көмектесу мүмкін емес, солай ма?
Dialogue: 0,0:23:11.43,0:23:13.55,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:23:13.97,0:23:16.01,Default,,0,0,0,,Дегенмен, бұл маңызды емес деп ойлаймын.
Dialogue: 0,0:23:16.60,0:23:18.52,Default,,0,0,0,,Тек осында әкеліңіз.
Dialogue: 0,0:23:22.31,0:23:24.52,Default,,0,0,0,,Иә? иә? Бұл не?
Dialogue: 0,0:23:25.02,0:23:27.98,Default,,0,0,0,,Бұл бөлмеден шықпай-ақ жер астына өтуге болады, солай ма?
Dialogue: 0,0:23:28.11,0:23:29.49,Default,,0,0,0,,Эй, эй
Dialogue: 0,0:23:29.65,0:23:30.20,Default,,0,0,0,,(Takecopter ұшу дыбысы)
Dialogue: 0,0:23:30.20,0:23:33.45,Default,,0,0,0,,(Takecopter ұшу дыбысы)
Dialogue: 0,0:23:30.20,0:23:33.45,Default,,0,0,0,,Тек жақсы емес нәрселерге келгенде, мен анық ойлай аламын.
Dialogue: 0,0:23:33.74,0:23:36.41,Default,,0,0,0,,А? Не, бұл жай ғана кәріз қақпағы ма?
Dialogue: 0,0:23:38.58,0:23:41.29,Default,,0,0,0,,(Екі адамның көңілді дауысы)
Dialogue: 0,0:23:43.04,0:23:43.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:45.17,0:23:46.71,Default,,0,0,0,,Юта Отокоцу
Dialogue: 0,0:23:47.00,0:23:48.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:50.80,0:23:52.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:52.84,0:23:55.30,Default,,0,0,0,,Сонда жер астына қайта түсе алмайсың ба?
Dialogue: 0,0:23:55.43,0:23:56.85,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:23:56.97,0:23:59.81,Default,,0,0,0,,0 ұпайды сақтайтын орным болса да.
Dialogue: 0,0:23:59.93,0:24:02.69,Default,,0,0,0,,Ұйқы бөлмесі, аудандық алаң, футбол алаңы—
Dialogue: 0,0:24:02.81,0:24:06.27,Default,,0,0,0,,Менің арманым арманға толы болса да
Dialogue: 0,0:24:06.40,0:24:06.94,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:24:06.94,0:24:07.69,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:24:06.94,0:24:07.69,Default,,0,0,0,,Барлығының көңілі қалады, бірақ бас тартудан басқа амалым жоқ.
Dialogue: 0,0:24:07.69,0:24:12.07,Default,,0,0,0,,Барлығының көңілі қалады, бірақ менің бас тартудан басқа амалым жоқ.
Dialogue: 0,0:24:15.16,0:24:17.91,Default,,0,0,0,,Мен ертең бәріне хабарлаймын.
Dialogue: 0,0:24:19.91,0:24:22.29,Default,,0,0,0,,О, бұл мәселе.
Dialogue: 0,0:24:22.41,0:24:26.00,Default,,0,0,0,,Ол маған скрипканы сатып алды және...
Dialogue: 0,0:24:26.13,0:24:27.17,Default,,0,0,0,,О, демек, сен бұл туралы ашық айтып отырсың ғой.
Dialogue: 0,0:24:27.34,0:24:30.26,Default,,0,0,0,,Анама не айтуым керек?
Dialogue: 0,0:24:32.80,0:24:37.39,Default,,0,0,0,,Келесі кезекте Джан. Бұл қиын болады, haa...
Dialogue: 0,0:24:37.89,0:24:40.06,Default,,0,0,0,,Ақтау жоқ! Бірдеңе жасаңыз
Dialogue: 0,0:24:40.52,0:24:41.18,Default,,0,0,0,,Менікі! Болды
Dialogue: 0,0:24:41.31,0:24:42.27,Default,,0,0,0,,Өмірден...Шабуыл
Dialogue: 0,0:24:42.39,0:24:43.31,Default,,0,0,0,,Асыл... Мен тағы келдім.
Dialogue: 0,0:24:43.44,0:24:44.39,Default,,0,0,0,,Сахналық костюм... итте
Dialogue: 0,0:24:44.52,0:24:45.56,Default,,0,0,0,,Не болды! Уау
Dialogue: 0,0:24:45.69,0:24:46.52,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:24:47.44,0:24:49.40,Default,,0,0,0,,Уау, бұл қорқынышты болды.
Dialogue: 0,0:24:49.86,0:24:51.65,Default,,0,0,0,,Ал, келесі кезекте Сунео.
Dialogue: 0,0:24:51.78,0:24:54.53,Default,,0,0,0,,Сізге жағымсыз пікірлер келетініне сенімдімін.
Dialogue: 0,0:24:55.41,0:24:59.03,Default,,0,0,0,,Дорачама, Сунечама бұл жолы маған қамқор болды...
Dialogue: 0,0:24:59.16,0:25:01.41,Default,,0,0,0,,3 түн 4 күндік оқу-жаттығу жиыны бар ма?
Dialogue: 0,0:25:01.75,0:25:03.37,Default,,0,0,0,,Иә? «3 түн»?
Dialogue: 0,0:25:03.54,0:25:05.04,Default,,0,0,0,,Мен біраз уайымдадым.
Dialogue: 0,0:25:05.17,0:25:07.04,Default,,0,0,0,,Дора Чама қасымда болса, қауіпсіз болар едім деп ойладым.
Dialogue: 0,0:25:07.17,0:25:09.00,Default,,0,0,0,,«Сүйкімді бала саяхаттасын» дейік.
Dialogue: 0,0:25:09.13,0:25:10.34,Default,,0,0,0,,Бала жақсы ма?
Dialogue: 0,0:25:10.55,0:25:12.30,Default,,0,0,0,,Бұл... Жоқ, бұл...
Dialogue: 0,0:25:12.51,0:25:15.88,Default,,0,0,0,,Ол баланың жүрегі өте сезімтал.
Dialogue: 0,0:25:16.01,0:25:16.93,Default,,0,0,0,,А, иә... қош бол
Dialogue: 0,0:25:17.05,0:25:18.72,Default,,0,0,0,,Анаңызға да сәлем жолдаңыз
Dialogue: 0,0:25:19.14,0:25:20.22,Default,,0,0,0,,Бұл қиын
Dialogue: 0,0:25:22.06,0:25:24.73,Default,,0,0,0,,Нобита-кун, Сунео үйге келмеді.
Dialogue: 0,0:25:24.85,0:25:26.23,Default,,0,0,0,,Иә? Ол нені білдіреді?
Dialogue: 0,0:25:26.65,0:25:28.65,Default,,0,0,0,,Мен сол жер астында қамалып қалдым.
Dialogue: 0,0:25:28.81,0:25:29.48,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:25:29.61,0:25:30.94,Default,,0,0,0,,Мен, әрине, қандай да бір жолмен көмектесуім керек.
Dialogue: 0,0:25:31.07,0:25:31.73,Default,,0,0,0,,Мен саған көмектесуім керек
Dialogue: 0,0:25:31.86,0:25:32.82,Default,,0,0,0,,Әрине (Нобита) Мен саған көмектесуім керек.
Dialogue: 0,0:25:32.94,0:25:33.99,Default,,0,0,0,,Әрине (Нобита) Мен саған көмектесуім керек.
Dialogue: 0,0:25:34.11,0:25:34.74,Default,,0,0,0,,Әрине!
Dialogue: 0,0:25:35.24,0:25:37.95,Default,,0,0,0,,Иә, Сунеоның бейнекамерасы ше?
Dialogue: 0,0:25:38.49,0:25:39.62,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:25:39.74,0:25:41.83,Default,,0,0,0,,Ум, Сунео камерасының камерасы
Dialogue: 0,0:25:41.95,0:25:43.83,Default,,0,0,0,,Камера... мінеки!
Dialogue: 0,0:25:43.95,0:25:45.91,Default,,0,0,0,,(баспалдақтан түскен аяқ дыбыстары)
Dialogue: 0,0:25:46.37,0:25:48.50,Default,,0,0,0,,Фотосуретте түсінік болуы мүмкін
Dialogue: 0,0:25:51.13,0:25:52.63,Default,,0,0,0,,Ах (Нобита) Ах...
Dialogue: 0,0:25:53.21,0:25:54.63,Default,,0,0,0,,Бұл суретте!
Dialogue: 0,0:25:54.76,0:25:56.76,Default,,0,0,0,,Мына төбеге барайық
Dialogue: 0,0:25:56.93,0:25:57.63,Default,,0,0,0,,Бұл Сунеоның дауысы.
Dialogue: 0,0:25:57.63,0:25:58.09,Default,,0,0,0,,Бұл Сунеоның дауысы.
Dialogue: 0,0:25:57.63,0:25:58.09,Default,,0,0,0,,Ах! Бұл тамаша жазық
Dialogue: 0,0:25:58.09,0:25:58.22,Default,,0,0,0,,Ах! Бұл тамаша жазық
Dialogue: 0,0:25:58.22,0:25:59.22,Default,,0,0,0,,Ах! Бұл тамаша жазық
Dialogue: 0,0:25:58.22,0:25:59.22,Default,,0,0,0,,Иә
Dialogue: 0,0:25:59.22,0:26:00.68,Default,,0,0,0,,Ах! Бұл тамаша жазық
Dialogue: 0,0:26:00.93,0:26:02.10,Default,,0,0,0,,Бір нәрсені суретке түсіруге болады
Dialogue: 0,0:26:02.10,0:26:02.60,Default,,0,0,0,,Бір нәрсе суретке түсуі мүмкін
Dialogue: 0,0:26:02.10,0:26:02.60,Default,,0,0,0,,Камера сол жерде болды.
Dialogue: 0,0:26:02.60,0:26:03.85,Default,,0,0,0,,Камера сол жерде болды.
Dialogue: 0,0:26:04.47,0:26:07.27,Default,,0,0,0,,Не? Бұл дұрыс...
Dialogue: 0,0:26:07.39,0:26:08.10,Default,,0,0,0,,Ах!?
Dialogue: 0,0:26:08.23,0:26:11.11,Default,,0,0,0,,А, мынау Тана өзенінің түбіне батып кеткен радиобасқару...
Dialogue: 0,0:26:11.82,0:26:14.82,Default,,0,0,0,,Бұл радиомен басқарылатын елес.
Dialogue: 0,0:26:14.94,0:26:16.65,Default,,0,0,0,,( камераның жерге құлаған дыбысы)
Dialogue: 0,0:26:16.90,0:26:18.91,Default,,0,0,0,,Сунеоның радиомен басқаруы жер астында
Dialogue: 0,0:26:19.03,0:26:20.57,Default,,0,0,0,,Сондай-ақ Танагавадан
Dialogue: 0,0:26:21.28,0:26:22.95,Default,,0,0,0,,Бұл...
Dialogue: 0,0:26:23.66,0:26:24.45,Default,,0,0,0,,Тезірек барайық
Dialogue: 0,0:26:24.58,0:26:25.45,Default,,0,0,0,,Бұл Тана өзенінің түбі.
Dialogue: 0,0:26:26.66,0:26:27.41,Default,,0,0,0,,Қайда?
Dialogue: 0,0:26:28.29,0:26:30.71,Default,,0,0,0,,Сунео жер асты үңгірінде қамалып қалды...
Dialogue: 0,0:26:30.83,0:26:32.71,Default,,0,0,0,,Тез жүрмесең өлесің.
Dialogue: 0,0:26:32.84,0:26:36.38,Default,,0,0,0,,Мен енді мұндай нәрсеге құламаймын. Сіз коменданттық сағат туралы ұмыттыңыз ба?
Dialogue: 0,0:26:40.59,0:26:43.10,Default,,0,0,0,,Сондықтан күндіз далаға шығу мүмкін емес.
Dialogue: 0,0:26:43.22,0:26:45.35,Default,,0,0,0,,Мен мұны бүгін түнде ұйықтап болғаннан кейін жасаймын.
Dialogue: 0,0:26:46.56,0:26:49.56,Default,,0,0,0,,Сунео-кун, аман бол.
Dialogue: 0,0:26:51.69,0:26:55.73,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:27:03.37,0:27:09.37,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:27:14.54,0:27:16.71,Default,,0,0,0,,Мен көп ұйықтадым
Dialogue: 0,0:27:17.51,0:27:19.59,Default,,0,0,0,,Нобита-кун Нобита-кун
Dialogue: 0,0:27:19.72,0:27:21.55,Default,,0,0,0,,Нобита-кун! (Нобита) Әлі ерте.
Dialogue: 0,0:27:21.68,0:27:25.18,Default,,0,0,0,,Әлі ерте емес! Сіз тым көп ұйықтадыңыз. Сіз Сунео-кунды іздеп жүрсіз, солай ма?
Dialogue: 0,0:27:25.56,0:27:27.14,Default,,0,0,0,,Ха, дұрыс, ұмытып кетіппін.
Dialogue: 0,0:27:27.31,0:27:29.39,Default,,0,0,0,,(Takecopter ұшу дыбысы)
Dialogue: 0,0:27:29.52,0:27:31.14,Default,,0,0,0,,Кішкене көбірек жұмыс күші қажет.
Dialogue: 0,0:27:31.35,0:27:33.06,Default,,0,0,0,,Юмефуурин!
Dialogue: 0,0:27:33.44,0:27:37.07,Default,,0,0,0,,Джан Шизука-чан, тез арада киіміңді ауыстырып, бос жерге кел.
Dialogue: 0,0:27:37.19,0:27:40.74,Default,,0,0,0,,(Жел қоңырауының дыбысы)
Dialogue: 0,0:27:45.78,0:27:47.95,Default,,0,0,0,,Сізге ерте қоңырау шалғаным үшін кешіріңіз.
Dialogue: 0,0:27:48.20,0:27:49.66,Default,,0,0,0,,Не? Сунео?
Dialogue: 0,0:27:49.79,0:27:51.37,Default,,0,0,0,,Жер астында қалды ма?
Dialogue: 0,0:27:52.12,0:27:55.38,Default,,0,0,0,,Сондықтан екеуің маған қол ұшын созуларыңды қалаймын.
Dialogue: 0,0:27:55.50,0:27:57.84,Default,,0,0,0,,Себебі мен ол жерге қайта бара алмаймын...
Dialogue: 0,0:27:58.21,0:28:00.80,Default,,0,0,0,,Жоқ, мен бұл қуыстың... екенін кейін білдім.
Dialogue: 0,0:28:01.55,0:28:03.09,Default,,0,0,0,,Ол Танагаваға апарады.
Dialogue: 0,0:28:03.22,0:28:04.01,Default,,0,0,0,,Жоқ, иә?
Dialogue: 0,0:28:04.14,0:28:06.51,Default,,0,0,0,,Біз де сене алмадық.
Dialogue: 0,0:28:06.68,0:28:08.31,Default,,0,0,0,,Мен оны қолданып көрдім.
Dialogue: 0,0:28:08.43,0:28:08.97,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:28:09.60,0:28:12.85,Default,,0,0,0,,«○» дұрыс болса, «×» қате болса
Dialogue: 0,0:28:14.69,0:28:18.40,Default,,0,0,0,,Тана өзенінің түбінде үлкен үңгірге кіретін есік бар.
Dialogue: 0,0:28:19.69,0:28:21.65,Default,,0,0,0,,Көрдің бе?
Dialogue: 0,0:28:21.78,0:28:23.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:30.58,0:28:32.46,Default,,0,0,0,,Сонда Сунео-кунның радиобасқару құралы...
Dialogue: 0,0:28:32.58,0:28:34.96,Default,,0,0,0,,Сен сол темір жол көпіріне қарай ұшып, құладың.
Dialogue: 0,0:28:35.08,0:28:36.00,Default,,0,0,0,,О
Dialogue: 0,0:28:36.13,0:28:39.34,Default,,0,0,0,,Олай болса сол аймаққа жақын сүңгейік. Жолға шығайық!
Dialogue: 0,0:28:39.46,0:28:41.76,Default,,0,0,0,,О? Ах Додо Дораемон
Dialogue: 0,0:28:43.47,0:28:45.68,Default,,0,0,0,,Нашар Жаман Мен кездейсоқ...
Dialogue: 0,0:28:45.80,0:28:47.64,Default,,0,0,0,,Танто оттегі кәмпит!
Dialogue: 0,0:28:48.10,0:28:51.81,Default,,0,0,0,,Осыны жалайтын болсаңыз, ауа жоқ жерде де жақсы боласыз.
Dialogue: 0,0:28:51.93,0:28:54.14,Default,,0,0,0,,Қайтадан кету!
Dialogue: 0,0:28:58.57,0:29:00.61,Default,,0,0,0,,А, бұл рас.
Dialogue: 0,0:29:00.82,0:29:04.32,Default,,0,0,0,,Уа, көп нәрсе құлап жатыр.
Dialogue: 0,0:29:08.74,0:29:09.62,Default,,0,0,0,,А, мен көрдім. иә?
Dialogue: 0,0:29:09.91,0:29:10.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:10.74,0:29:11.58,Default,,0,0,0,,Оны таптыңыз ба?
Dialogue: 0,0:29:11.70,0:29:12.37,Default,,0,0,0,,Міне.
Dialogue: 0,0:29:12.91,0:29:15.29,Default,,0,0,0,,Ашылмаған шырын, мен оны әлі іше алмаймын.
Dialogue: 0,0:29:15.42,0:29:17.58,Default,,0,0,0,,Қазірдің өзінде! Сіз туннель іздеп жүрсіз бе?
Dialogue: 0,0:29:17.71,0:29:19.09,Default,,0,0,0,,Дұрыс. Эй, мына саңылау ше?
Dialogue: 0,0:29:19.21,0:29:20.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:22.09,0:29:22.80,Default,,0,0,0,,Мен бұл екеніне сенімдімін
Dialogue: 0,0:29:24.63,0:29:25.88,Default,,0,0,0,,Жарайды, ішке кірейік.
Dialogue: 0,0:29:26.01,0:29:27.26,Default,,0,0,0,,Иә
Dialogue: 0,0:29:40.44,0:29:43.03,Default,,0,0,0,,Қап қараңғы, мен ештеңе көрмеймін.
Dialogue: 0,0:29:43.15,0:29:45.45,Default,,0,0,0,,Аздап маринадталған мүк себіңіз
Dialogue: 0,0:29:46.40,0:29:47.99,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:29:55.04,0:29:56.96,Default,,0,0,0,,Сунео!
Dialogue: 0,0:29:58.08,0:30:00.88,Default,,0,0,0,,Бұл шынымен де біздің қуысымызға байланысты ма деп ойлаймын.
Dialogue: 0,0:30:01.00,0:30:03.05,Default,,0,0,0,,Барынша алысқа барайық.
Dialogue: 0,0:30:03.17,0:30:04.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:30:11.60,0:30:12.35,Default,,0,0,0,,Мен бұған жол бере алмаймын.
Dialogue: 0,0:30:14.10,0:30:14.85,Default,,0,0,0,,Уау
Dialogue: 0,0:30:14.97,0:30:16.43,Default,,0,0,0,,Керемет
Dialogue: 0,0:30:16.56,0:30:20.73,Default,,0,0,0,,(4 адамның таңданған дауысы)
Dialogue: 0,0:30:27.40,0:30:29.99,Default,,0,0,0,,Бұл бор орманына ұқсайды.
Dialogue: 0,0:30:30.41,0:30:32.95,Default,,0,0,0,,Эй, қарашы, бұл птеранодон.
Dialogue: 0,0:30:33.08,0:30:34.45,Default,,0,0,0,,Тірі, қозғалатын
Dialogue: 0,0:30:35.12,0:30:38.46,Default,,0,0,0,,Бұл жағдайда динозаврлар бар. Менің айтқаным бұл емес.
Dialogue: 0,0:30:38.71,0:30:42.42,Default,,0,0,0,,Бірақ ○× жақсы емес «Қазіргі Жер...»
Dialogue: 0,0:30:42.54,0:30:43.50,Default,,0,0,0,,Ха!
Dialogue: 0,0:30:43.63,0:30:47.88,Default,,0,0,0,,Қарасам, ол жер бетінде жойылып кетсе де, жер астында аман қалды ма?
Dialogue: 0,0:30:48.88,0:30:52.01,Default,,0,0,0,,Бірақ ол неге сонша жер астында...
Dialogue: 0,0:30:52.14,0:30:53.72,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:30:54.14,0:30:56.31,Default,,0,0,0,,Оның орнына мен Сунео-санды іздеуім керек.
Dialogue: 0,0:30:56.43,0:30:58.60,Default,,0,0,0,,Дұрыс, біз мұны істей алмаймыз. Біз оны тез арада табуымыз керек.
Dialogue: 0,0:30:58.73,0:31:00.73,Default,,0,0,0,,Сунео-кун
Dialogue: 0,0:31:00.85,0:31:02.81,Default,,0,0,0,,Сунео
Dialogue: 0,0:31:03.19,0:31:05.02,Default,,0,0,0,,Сунео Сунео
Dialogue: 0,0:31:05.15,0:31:09.74,Default,,0,0,0,,Сунео: Сен барсың ба, жоқ па? Олай болмаса, ол жоқ деп айтыңыз.
Dialogue: 0,0:31:09.86,0:31:11.41,Default,,0,0,0,,Сунео (Нобита) Сунео
Dialogue: 0,0:31:11.53,0:31:14.58,Default,,0,0,0,,(Барлық қоңыраулардың дауысы)
Dialogue: 0,0:31:16.54,0:31:18.45,Default,,0,0,0,,Егер бұл кең болса, мен оның бәрін іздей алмаймын.
Dialogue: 0,0:31:19.33,0:31:20.46,Default,,0,0,0,,Осыны қолданайық
Dialogue: 0,0:31:20.87,0:31:22.42,Default,,0,0,0,,Шағын экспедиция!
Dialogue: 0,0:31:23.21,0:31:27.71,Default,,0,0,0,,Егер сіз әдеттен тыс нәрсе тапсаңыз, дереу хабарлаңыз. Бар!
Dialogue: 0,0:31:30.80,0:31:34.14,Default,,0,0,0,,Осыншама көп адаммен іздесек, бірдеңе табатын шығармыз.
Dialogue: 0,0:31:36.51,0:31:37.93,Default,,0,0,0,,Бұл... Аха...
Dialogue: 0,0:31:38.10,0:31:38.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:38.89,0:31:40.98,Default,,0,0,0,,Енді есепті күтіңіз
Dialogue: 0,0:31:43.23,0:31:43.56,Default,,0,0,0,,А…?
Dialogue: 0,0:31:43.56,0:31:45.94,Default,,0,0,0,,А…?
Dialogue: 0,0:31:43.56,0:31:45.94,Default,,0,0,0,,Уау, реакция бар.
Dialogue: 0,0:31:45.94,0:31:46.19,Default,,0,0,0,,А…?
Dialogue: 0,0:31:46.19,0:31:47.28,Default,,0,0,0,,А…?
Dialogue: 0,0:31:46.19,0:31:47.28,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,0:31:47.40,0:31:48.07,Default,,0,0,0,,Не?
Dialogue: 0,0:31:48.19,0:31:48.90,Default,,0,0,0,,Мүмкін Сунео шығар?
Dialogue: 0,0:31:49.07,0:31:52.41,Default,,0,0,0,,А…?
Dialogue: 0,0:31:52.53,0:31:53.62,Default,,0,0,0,,Қараңыз Қараңыз Қараңыз
Dialogue: 0,0:31:53.74,0:31:55.78,Default,,0,0,0,,Қараңыз Қараңыз Қараңыз, Қараңыз!
Dialogue: 0,0:31:55.91,0:31:58.24,Default,,0,0,0,,Не? не таптың
Dialogue: 0,0:32:01.75,0:32:03.33,Default,,0,0,0,,Сунеоның радиобасқару
Dialogue: 0,0:32:03.46,0:32:04.13,Default,,0,0,0,,Жеңіс
Dialogue: 0,0:32:04.25,0:32:05.46,Default,,0,0,0,,Міне!
Dialogue: 0,0:32:16.01,0:32:18.93,Default,,0,0,0,,Я... Бұл радиомен басқару үшін тым жылдам.
Dialogue: 0,0:32:19.06,0:32:19.97,Default,,0,0,0,,Біреу өзгертіп жіберді... Уау!
Dialogue: 0,0:32:19.97,0:32:20.73,Default,,0,0,0,,Оны біреу өзгертіп жіберді... Уау!
Dialogue: 0,0:32:19.97,0:32:20.73,Default,,0,0,0,,А…?
Dialogue: 0,0:32:20.73,0:32:21.35,Default,,0,0,0,,А…?
Dialogue: 0,0:32:21.35,0:32:23.35,Default,,0,0,0,,А…?
Dialogue: 0,0:32:21.35,0:32:23.35,Default,,0,0,0,,Олар сол жерден де бірдеңе тапқан сияқты.
Dialogue: 0,0:32:23.35,0:32:23.48,Default,,0,0,0,,А…?
Dialogue: 0,0:32:23.48,0:32:24.10,Default,,0,0,0,,А…?
Dialogue: 0,0:32:23.48,0:32:24.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:24.10,0:32:24.23,Default,,0,0,0,,А…?
Dialogue: 0,0:32:24.23,0:32:25.73,Default,,0,0,0,,А…?
Dialogue: 0,0:32:24.23,0:32:25.73,Default,,0,0,0,,Go (Нобита/Джиан) Иә
Dialogue: 0,0:32:27.40,0:32:28.15,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:32:28.44,0:32:30.61,Default,,0,0,0,,Бұл жай ғана жартасты тау емес.
Dialogue: 0,0:32:31.15,0:32:33.28,Default,,0,0,0,,Бұл қамал немесе сарай сияқты.
Dialogue: 0,0:32:33.40,0:32:36.62,Default,,0,0,0,,Не болса да, ол затты біреу салған.
Dialogue: 0,0:32:38.79,0:32:40.70,Default,,0,0,0,,Сонда жер астындағы адамдар бар ма?
Dialogue: 0,0:32:40.83,0:32:42.04,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:32:42.41,0:32:42.79,Default,,0,0,0,,А…?
Dialogue: 0,0:32:42.79,0:32:45.83,Default,,0,0,0,,А…?
Dialogue: 0,0:32:42.79,0:32:45.83,Default,,0,0,0,,Иә? Мен тағы бірдеңе тапқан сияқтымын
Dialogue: 0,0:32:45.83,0:32:45.96,Default,,0,0,0,,А…?
Dialogue: 0,0:32:45.96,0:32:47.96,Default,,0,0,0,,А…?
Dialogue: 0,0:32:45.96,0:32:47.96,Default,,0,0,0,,Оны іздейтіндер тым көп.
Dialogue: 0,0:32:48.09,0:32:50.42,Default,,0,0,0,,Бірақ бұл жолы Сунео болуы мүмкін.
Dialogue: 0,0:32:48.09,0:32:50.42,Default,,0,0,0,,А…?
Dialogue: 0,0:32:50.42,0:32:50.55,Default,,0,0,0,,А…?
Dialogue: 0,0:32:50.55,0:32:51.59,Default,,0,0,0,,А…?
Dialogue: 0,0:32:50.55,0:32:51.59,Default,,0,0,0,,Олай болса, барамыз ба?
Dialogue: 0,0:32:51.59,0:32:51.71,Default,,0,0,0,,А…?
Dialogue: 0,0:32:51.71,0:32:52.47,Default,,0,0,0,,А…?
Dialogue: 0,0:32:51.71,0:32:52.47,Default,,0,0,0,,Иә
Dialogue: 0,0:32:52.63,0:32:55.84,Default,,0,0,0,,Сіз біраз уақыттан бері бір жерге қайта-қайта бара жатқан сияқтысыз.
Dialogue: 0,0:32:56.39,0:32:59.31,Default,,0,0,0,,Ah Дораэмон tata tata Takecopter
Dialogue: 0,0:32:59.43,0:33:01.77,Default,,0,0,0,,(Нобитаның үрейленген дауысы)
Dialogue: 0,0:33:01.89,0:33:03.77,Default,,0,0,0,,Қайта кездескенше! Нобита баяу!
Dialogue: 0,0:33:03.89,0:33:06.19,Default,,0,0,0,,Жоқ, мен тым қатты кеттім және оны тым көп қолдандым.
Dialogue: 0,0:33:08.02,0:33:09.61,Default,,0,0,0,,Оны біраз уақыт ұстаңыз
Dialogue: 0,0:33:09.73,0:33:11.69,Default,,0,0,0,,Барлығының батареялары да өледі.
Dialogue: 0,0:33:11.82,0:33:14.15,Default,,0,0,0,,Маған келесі 20 сағат демалу керек.
Dialogue: 0,0:33:14.28,0:33:15.74,Default,,0,0,0,,Ал, жаяу барасың ба?
Dialogue: 0,0:33:15.86,0:33:17.03,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:33:17.32,0:33:23.33,Default,,0,0,0,,А…?
Dialogue: 0,0:33:29.38,0:33:30.55,Default,,0,0,0,,Қараңыз Қараңыз Қараңыз Қараңыз ...
Dialogue: 0,0:33:30.67,0:33:33.13,Default,,0,0,0,,Бұл жолы не таптық?
Dialogue: 0,0:33:33.26,0:33:35.38,Default,,0,0,0,,Қызықты ма білмеймін.
Dialogue: 0,0:33:35.51,0:33:37.22,Default,,0,0,0,,Қараңыз Қараңыз Қараңыз ...
Dialogue: 0,0:33:39.05,0:33:39.85,Default,,0,0,0,,(динозаврлардың айқайы)
Dialogue: 0,0:33:39.97,0:33:44.60,Default,,0,0,0,,(4 адам айғайлайды)
Dialogue: 0,0:33:45.52,0:33:46.60,Default,,0,0,0,,Бірдеңе жасаңыз.
Dialogue: 0,0:33:46.73,0:33:47.85,Default,,0,0,0,,Сіз бірдеңе істеу керек дедіңіз.
Dialogue: 0,0:33:47.98,0:33:50.02,Default,,0,0,0,,Мен не істерімді де білмеймін
Dialogue: 0,0:33:50.15,0:33:51.44,Default,,0,0,0,,Уау! Жоқ, жоқ, жоқ
Dialogue: 0,0:33:51.57,0:33:52.40,Default,,0,0,0,,Нобита-кун! Ах!
Dialogue: 0,0:33:52.57,0:33:55.74,Default,,0,0,0,,А, кетейін, жіберейін, А, жоқ!
Dialogue: 0,0:34:01.37,0:34:02.33,Default,,0,0,0,,Рахмет сізге Дораемон
Dialogue: 0,0:34:02.45,0:34:03.41,Default,,0,0,0,,Мен емес Мен емес
Dialogue: 0,0:34:03.54,0:34:04.75,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:34:07.54,0:34:11.92,Default,,0,0,0,,(Динозавр дыбысы)
Dialogue: 0,0:34:15.72,0:34:16.38,Default,,0,0,0,,А...
Dialogue: 0,0:34:16.51,0:34:17.76,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:34:17.88,0:34:19.68,Default,,0,0,0,,Сонда нақты кім?
Dialogue: 0,0:34:19.80,0:34:22.81,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:34:23.06,0:34:24.77,Default,,0,0,0,,Әй, жер астындағылар! Тынш!
Dialogue: 0,0:34:29.56,0:34:31.31,Default,,0,0,0,,Мен сәлем беремін.
Dialogue: 0,0:34:31.44,0:34:34.57,Default,,0,0,0,,Жоқ, бұл қауіпті.
Dialogue: 0,0:34:34.69,0:34:37.82,Default,,0,0,0,,Мен Дораемонмын, мен жерден келдім.
Dialogue: 0,0:34:38.03,0:34:39.57,Default,,0,0,0,,Дос болыңыз...
Dialogue: 0,0:34:39.57,0:34:40.20,Default,,0,0,0,,Дос болыңыз...
Dialogue: 0,0:34:39.57,0:34:40.20,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:34:40.20,0:34:40.53,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:34:40.53,0:34:42.12,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:34:40.53,0:34:42.12,Default,,0,0,0,,Мен үйрене алмай тұрған сияқтымын
Dialogue: 0,0:34:44.74,0:34:48.75,Default,,0,0,0,,Жер асты адамдарында онша дамыған өркениет жоқ сияқты.
Dialogue: 0,0:34:48.87,0:34:50.83,Default,,0,0,0,,Бұл жігіттер адам емес.
Dialogue: 0,0:34:51.08,0:34:55.51,Default,,0,0,0,,Мен бұл бір нәрсеге ұқсайды деп біраз уақыт ойладым...
Dialogue: 0,0:34:58.13,0:35:00.26,Default,,0,0,0,,Иә! Каппа Соккури
Dialogue: 0,0:35:05.52,0:35:08.48,Default,,0,0,0,,(сөйлейтін жер астындағы адамдардың дауысы)
Dialogue: 0,0:35:08.60,0:35:10.14,Default,,0,0,0,,(Жер астындағы адамның күлкісі)
Dialogue: 0,0:35:10.27,0:35:11.48,Default,,0,0,0,,Неге күлесің?
Dialogue: 0,0:35:11.60,0:35:15.53,Default,,0,0,0,,Жер астындағы адамдарға Нобитаның түрі біртүрлі көрінеді, солай ма?
Dialogue: 0,0:35:15.78,0:35:17.57,Default,,0,0,0,,Бұл туралы уайымдамаңыз!
Dialogue: 0,0:35:17.69,0:35:20.70,Default,,0,0,0,,Уф, тоқта, тоқта
Dialogue: 0,0:35:20.95,0:35:25.08,Default,,0,0,0,,(Радиомен басқарылатын ұшу дыбысы)
Dialogue: 0,0:35:25.33,0:35:26.49,Default,,0,0,0,,Ах, Сунеоның радиобасқару құралы
Dialogue: 0,0:35:27.12,0:35:28.70,Default,,0,0,0,,(Жер астындағы адамдардың айқайы)
Dialogue: 0,0:35:30.33,0:35:34.17,Default,,0,0,0,,(Жер астындағы адамдардың шуы)
Dialogue: 0,0:35:35.59,0:35:38.01,Default,,0,0,0,,(сөйлейтін жерасты адамдардың дауысы)
Dialogue: 0,0:35:38.17,0:35:40.13,Default,,0,0,0,,Мені қайда апара жатырсың?
Dialogue: 0,0:35:40.26,0:35:41.18,Default,,0,0,0,,(сөйлейтін жер астындағы адамдардың дауысы)
Dialogue: 0,0:35:41.30,0:35:43.18,Default,,0,0,0,,Сіз ақымақ асығып тұрған сияқтысыз.
Dialogue: 0,0:35:43.30,0:35:45.64,Default,,0,0,0,,Баяуырақ жүріңіз.
Dialogue: 0,0:35:47.47,0:35:49.73,Default,,0,0,0,,(Әміршіл жерасты адамының дауысы)
Dialogue: 0,0:35:50.77,0:35:52.98,Default,,0,0,0,,(Әміршіл жерасты адамының дауысы)
Dialogue: 0,0:35:57.40,0:35:59.57,Default,,0,0,0,,Иә? Бірдеңе бар ма деп ойлаймын
Dialogue: 0,0:35:59.74,0:36:00.86,Default,,0,0,0,,(Әміршіл жерасты адамының дауысы)
Dialogue: 0,0:36:00.99,0:36:02.16,Default,,0,0,0,,Бұл...
Dialogue: 0,0:36:03.61,0:36:08.66,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:36:23.18,0:36:24.76,Default,,0,0,0,,<Ушита? Салем
Dialogue: 0,0:36:34.35,0:36:36.27,Default,,0,0,0,,(жер астындағы адамдардың шайқас айқайы)
Dialogue: 0,0:36:40.65,0:36:44.28,Default,,0,0,0,,(Жер астындағы адамдардың жауынгерлік айқайы)
Dialogue: 0,0:36:52.33,0:36:53.46,Default,,0,0,0,,Цуцу күшті...
Dialogue: 0,0:36:53.58,0:36:55.37,Default,,0,0,0,,Көзді ашып-жұмғанша жаңбыр пальтосын өзім киіп алдым...
Dialogue: 0,0:36:55.54,0:36:57.54,Default,,0,0,0,,(Әміршіл жерасты адамының дауысы)
Dialogue: 0,0:37:03.09,0:37:04.05,Default,,0,0,0,,Мұнда кел
Dialogue: 0,0:37:06.89,0:37:09.26,Default,,0,0,0,,Бұл жігіт жау ма, одақтас па?
Dialogue: 0,0:37:09.39,0:37:10.39,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:37:12.81,0:37:14.48,Default,,0,0,0,,Не қаласаң, соны істе.
Dialogue: 0,0:37:15.52,0:37:17.44,Default,,0,0,0,,(сөйлеу)
Dialogue: 0,0:37:18.31,0:37:19.23,Default,,0,0,0,,(Төрт қорқынышты дауыс)
Dialogue: 0,0:37:20.19,0:37:21.98,Default,,0,0,0,,Уау, арқанды кесіп алдың.
Dialogue: 0,0:37:22.11,0:37:25.78,Default,,0,0,0,,Сәлеметсіз бе, мен Дора... Аа, мен тілін түсінбеймін.
Dialogue: 0,0:37:25.91,0:37:26.95,Default,,0,0,0,,Мысал ретінде...
Dialogue: 0,0:37:27.07,0:37:28.91,Default,,0,0,0,,Шынымен конняку!
Dialogue: 0,0:37:29.24,0:37:31.83,Default,,0,0,0,,Құрметті жерлестер, сіздердің жарақат алмағандарыңызға қуаныштымын.
Dialogue: 0,0:37:32.12,0:37:35.33,Default,,0,0,0,,«Жердегілер»... Демек, сіз бізді білесіз бе?
Dialogue: 0,0:37:35.71,0:37:38.71,Default,,0,0,0,,Әрине мен Драгун Ван Хомын
Dialogue: 0,0:37:38.83,0:37:41.25,Default,,0,0,0,,Мен сенің қауіпсіздігіңе қазірден бастап кепілдік беремін.
Dialogue: 0,0:37:41.71,0:37:43.63,Default,,0,0,0,,Мм... сенен бірнәрсе сұрайын.
Dialogue: 0,0:37:43.76,0:37:46.72,Default,,0,0,0,,Аа, дұрыс. Бала біздің алдымызға келген жоқ па?
Dialogue: 0,0:37:47.18,0:37:48.64,Default,,0,0,0,,Ол осылай көрінді
Dialogue: 0,0:37:49.10,0:37:51.14,Default,,0,0,0,,Бұл осында. Біз оны қорғаймыз.
Dialogue: 0,0:37:51.26,0:37:53.14,Default,,0,0,0,,(4 қуанышты дауыс)
Dialogue: 0,0:37:53.27,0:37:54.10,Default,,0,0,0,,Сізбен кездесуге рұқсат етіңіз.
Dialogue: 0,0:37:54.39,0:37:56.06,Default,,0,0,0,,Бірақ ол мұнда жоқ
Dialogue: 0,0:37:56.52,0:37:58.56,Default,,0,0,0,,Маған астана Энлильге келуің керек.
Dialogue: 0,0:37:59.65,0:38:01.82,Default,,0,0,0,,Ел астанасы Энлиль алыс па?
Dialogue: 0,0:38:01.98,0:38:04.53,Default,,0,0,0,,Ол Оа континентінде. Қайықпен кесіп өту.
Dialogue: 0,0:38:05.28,0:38:07.86,Default,,0,0,0,,Кемелер мен материктер жер астында ма?
Dialogue: 0,0:38:07.99,0:38:09.03,Default,,0,0,0,,Ах
Dialogue: 0,0:38:09.16,0:38:10.95,Default,,0,0,0,,Сунеоның радиобасқару
Dialogue: 0,0:38:11.33,0:38:13.74,Default,,0,0,0,,«Радиобасқару» деп аталады ма?
Dialogue: 0,0:38:13.87,0:38:18.92,Default,,0,0,0,,Мен оны өзеннің түбінен таптым, бірақ бұл сирек кездесетін машина, сондықтан мен оны өзгертіп, бақылау үшін пайдаландым.
Dialogue: 0,0:38:19.21,0:38:20.42,Default,,0,0,0,,Өзгерту?
Dialogue: 0,0:38:20.67,0:38:23.67,Default,,0,0,0,,Бұл ғылыми өркениет жеткілікті дамыған әлем сияқты.
Dialogue: 0,0:38:23.80,0:38:26.88,Default,,0,0,0,,Нақты не бақыланады?
Dialogue: 0,0:38:28.05,0:38:31.22,Default,,0,0,0,,Мен қарабайыр жануарлар қорығының инспекторымын.
Dialogue: 0,0:38:31.35,0:38:34.10,Default,,0,0,0,,Жер бетінде әлдеқашан жойылып кеткен ежелгі жануарлар...
Dialogue: 0,0:38:34.22,0:38:36.60,Default,,0,0,0,,Мұнда бірнеше адам ғана аман қалды
Dialogue: 0,0:38:37.14,0:38:40.98,Default,,0,0,0,,Осы асыл жануарларды браконьерлерден қорғау...
Dialogue: 0,0:38:41.11,0:38:44.82,Default,,0,0,0,,Оның рөлі - жер бетіндегі әлемге адасып кетудің алдын алу.
Dialogue: 0,0:38:44.98,0:38:49.41,Default,,0,0,0,,Мен Несси мен басқа динозаврлардың құрлықта көргенін көрдім.
Dialogue: 0,0:38:49.53,0:38:50.28,Default,,0,0,0,,Иә
Dialogue: 0,0:38:50.74,0:38:55.08,Default,,0,0,0,,Сонымен, Жапонияның аты аңызға айналған каппасы - жоғарыда айтылған жарыс.
Dialogue: 0,0:38:55.20,0:38:56.29,Default,,0,0,0,,Мен көремін (Дораэмон/Нобита) Хмм
Dialogue: 0,0:38:58.08,0:39:01.17,Default,,0,0,0,,Иә? Мен бұл жерде ештеңе танымаймын.
Dialogue: 0,0:39:01.29,0:39:03.96,Default,,0,0,0,,А, мынау біз арбаны бірден айдаған алаң.
Dialogue: 0,0:39:04.09,0:39:05.71,Default,,0,0,0,,Қараңызшы, мына тесік.
Dialogue: 0,0:39:06.63,0:39:09.59,Default,,0,0,0,,Біз сол жерден құпия базамызға бара аламыз.
Dialogue: 0,0:39:09.72,0:39:10.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:11.64,0:39:13.64,Default,,0,0,0,,Мен скрипкамды алғым келеді.
Dialogue: 0,0:39:14.06,0:39:15.56,Default,,0,0,0,,Мен де сахналық киім киемін...
Dialogue: 0,0:39:16.06,0:39:18.06,Default,,0,0,0,,Осының арқасында мен жақсымын.
Dialogue: 0,0:39:18.39,0:39:22.10,Default,,0,0,0,,Кейінірек! Алдымен Сунео-кунды құтқарыңыз, солай ма?
Dialogue: 0,0:39:23.48,0:39:26.03,Default,,0,0,0,,Уау жерасты көлі
Dialogue: 0,0:39:26.15,0:39:27.57,Default,,0,0,0,,Уау...
Dialogue: 0,0:39:27.69,0:39:30.49,Default,,0,0,0,,Бұл жерде сіздің достарыңыз қорғалған.
Dialogue: 0,0:39:31.32,0:39:32.82,Default,,0,0,0,,Біз портқа жақындап қалдық.
Dialogue: 0,0:39:42.12,0:39:43.13,Default,,0,0,0,,Бұл порт
Dialogue: 0,0:39:43.25,0:39:45.63,Default,,0,0,0,,Керемет (Нобита/Шидзука/Джиан) Уау
Dialogue: 0,0:40:01.06,0:40:04.48,Default,,0,0,0,,Ой, бұл темірден жасалған желкенді кеме.
Dialogue: 0,0:40:04.61,0:40:08.48,Default,,0,0,0,,Құрлықтағы желкенді кемеден айырмашылығы, оның желкендерін бағыттау үшін жердің магнит өрісін пайдаланады.
Dialogue: 0,0:40:16.70,0:40:18.41,Default,,0,0,0,,Кемеге мініңіз, жақында жүземіз.
Dialogue: 0,0:40:23.21,0:40:25.33,Default,,0,0,0,,Энлиль қаласына жету үшін шамамен 5 сағат кетеді.
Dialogue: 0,0:40:26.00,0:40:29.17,Default,,0,0,0,,Өзіңізді еркін сезініп, кейінірек оралыңыз.
Dialogue: 0,0:40:33.55,0:40:37.68,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:40:37.81,0:40:39.06,Default,,0,0,0,,Желкенді бұру
Dialogue: 0,0:40:45.31,0:40:46.44,Default,,0,0,0,,А, мен қалқып кеттім.
Dialogue: 0,0:40:52.86,0:40:54.36,Default,,0,0,0,,А, мен жартасқа соқтым.
Dialogue: 0,0:40:54.49,0:40:56.95,Default,,0,0,0,,Нашар жұмыс! Сен не істеп жатырсың?
Dialogue: 0,0:40:57.07,0:40:59.66,Default,,0,0,0,,Жартасқа кіріңіз!
Dialogue: 0,0:41:07.42,0:41:08.84,Default,,0,0,0,,Жермен қозғалу
Dialogue: 0,0:41:08.96,0:41:10.21,Default,,0,0,0,,Барлығы (3 адам) Иә?
Dialogue: 0,0:41:11.01,0:41:13.22,Default,,0,0,0,,Мына дүние картасына қараңдар.
Dialogue: 0,0:41:13.34,0:41:15.26,Default,,0,0,0,,Бұл дүние картасы ма?
Dialogue: 0,0:41:15.38,0:41:17.72,Default,,0,0,0,,Бұл үлкен жер асты үңгірінің картасы сияқты.
Dialogue: 0,0:41:18.14,0:41:21.64,Default,,0,0,0,,Бірақ жер бетінің дәл астында мантия жатыр, солай ма?
Dialogue: 0,0:41:21.77,0:41:25.85,Default,,0,0,0,,Мен «дәл төменде» десем де, оның қалыңдығы шамамен 100 шақырым.
Dialogue: 0,0:41:25.98,0:41:28.61,Default,,0,0,0,,Жер астында материк болса, таң қалмас еді.
Dialogue: 0,0:41:29.48,0:41:33.57,Default,,0,0,0,,Сонда да осындай жерде өркениет құру үшін...
Dialogue: 0,0:41:34.86,0:41:37.32,Default,,0,0,0,,Әлгі жарқыраған нәрсе осы кеме шығар.
Dialogue: 0,0:41:37.45,0:41:40.70,Default,,0,0,0,,Өйткені біз сол жерден кеттік...
Dialogue: 0,0:41:40.87,0:41:41.99,Default,,0,0,0,,Хмм…
Dialogue: 0,0:41:42.62,0:41:45.46,Default,,0,0,0,,А... ол аймақ Жапония.
Dialogue: 0,0:41:45.58,0:41:47.08,Default,,0,0,0,,Сіз қайдан білесіз?
Dialogue: 0,0:41:47.21,0:41:50.17,Default,,0,0,0,,Себебі мен Танагавадан жер астына кірдім.
Dialogue: 0,0:41:50.29,0:41:53.21,Default,,0,0,0,,Менің ойымша, бұл 50 шақырымнан артық емес.
Dialogue: 0,0:41:53.34,0:41:55.01,Default,,0,0,0,,Түсіндім, сен ақылдысың!
Dialogue: 0,0:41:55.51,0:42:00.14,Default,,0,0,0,,Сонда бұл кеме Америкаға бет алады.
Dialogue: 0,0:42:00.26,0:42:00.89,Default,,0,0,0,,Иә
Dialogue: 0,0:42:01.01,0:42:02.18,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:42:04.89,0:42:08.56,Default,,0,0,0,,Сіз жер асты әлеміндегі ең үлкен материк Оа континентіне ұмтыласыз.
Dialogue: 0,0:42:08.69,0:42:10.90,Default,,0,0,0,,Энлиль оның ортасында
Dialogue: 0,0:42:11.32,0:42:12.65,Default,,0,0,0,,(Төрт қорқынышты дауыс)
Dialogue: 0,0:42:12.78,0:42:15.36,Default,,0,0,0,,Не болды? Бұл мен. Бұл Банхо.
Dialogue: 0,0:42:15.90,0:42:18.57,Default,,0,0,0,,Ойланып қарасам, бұл дауыс...
Dialogue: 0,0:42:18.70,0:42:20.37,Default,,0,0,0,,Біртүрлі сезіледі.
Dialogue: 0,0:42:20.82,0:42:24.50,Default,,0,0,0,,Бұл дөрекі. Біздің көзқарасымыз бойынша, сендер...
Dialogue: 0,0:42:24.79,0:42:26.83,Default,,0,0,0,,Жарайды, мен саған тамақ әкелдім.
Dialogue: 0,0:42:26.96,0:42:27.62,Default,,0,0,0,,Уау
Dialogue: 0,0:42:27.75,0:42:30.29,Default,,0,0,0,,Дұрыс, дұрыс. Менің қарыным ашты. Мен біраз уақыттан бері тамақтанбадым.
Dialogue: 0,0:42:30.88,0:42:33.21,Default,,0,0,0,,Мм... сенен сұрайын дегенім көп.
Dialogue: 0,0:42:33.71,0:42:35.05,Default,,0,0,0,,Бірде сөйлесейік
Dialogue: 0,0:42:35.17,0:42:39.84,Default,,0,0,0,,Мен кеме келгенге дейін Қасиетті Таққа есеп беруім керек.
Dialogue: 0,0:42:43.47,0:42:45.14,Default,,0,0,0,,Мен мұны жеуге бола ма?
Dialogue: 0,0:42:45.77,0:42:47.39,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:42:48.27,0:42:50.90,Default,,0,0,0,,Джиан не жесе де, бәрі бірдей
Dialogue: 0,0:42:51.02,0:42:53.61,Default,,0,0,0,,Мм! Бірақ бұл дәмді
Dialogue: 0,0:42:53.73,0:42:54.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:55.36,0:42:57.74,Default,,0,0,0,,Бұл шынымен де жердегі дәмдеуіштермен бірдей.
Dialogue: 0,0:42:57.86,0:42:59.53,Default,,0,0,0,,Қызық, дораяки жоқ па?
Dialogue: 0,0:43:03.12,0:43:06.37,Default,,0,0,0,,Бірақ бізді өзіңізбен бірге алып кетсеңіз не істейсіз?
Dialogue: 0,0:43:06.50,0:43:09.50,Default,,0,0,0,,Сунео-кун онымен кездесуге рұқсат беретінін айтты.
Dialogue: 0,0:43:09.62,0:43:12.63,Default,,0,0,0,,Мен ол адамға сене аламын деп ойлаймын.
Dialogue: 0,0:43:13.29,0:43:17.05,Default,,0,0,0,,Сунеомен кездескеннен кейін, маған жерге оңай оралуға рұқсат бересіз бе деп ойлаймын.
Dialogue: 0,0:43:21.01,0:43:23.55,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:43:23.68,0:43:26.31,Default,,0,0,0,,Әй, мына ыстықта не болды?
Dialogue: 0,0:43:26.43,0:43:28.23,Default,,0,0,0,,(қызуда 4 адамның дауысы)
Dialogue: 0,0:43:29.31,0:43:30.35,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:43:30.48,0:43:32.23,Default,,0,0,0,,Бұл жай ғана нәрсе емес
Dialogue: 0,0:43:32.69,0:43:34.65,Default,,0,0,0,,Әй, Ванхо мырза!
Dialogue: 0,0:43:43.74,0:43:47.54,Default,,0,0,0,,Ван Хо мырза, оны ашып, шығарып алыңыз.
Dialogue: 0,0:43:48.08,0:43:49.62,Default,,0,0,0,,Атчи Атчи Атчи Чик…
Dialogue: 0,0:43:49.75,0:43:52.37,Default,,0,0,0,,Сіз бізді қуырмақшысыз ба?
Dialogue: 0,0:43:52.50,0:43:53.54,Default,,0,0,0,,Дораемон
Dialogue: 0,0:43:57.63,0:43:58.88,Default,,0,0,0,,Ыстық (Нобита) Менің енді қолымнан келмейді...
Dialogue: 0,0:43:59.01,0:44:00.38,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:44:01.76,0:44:03.22,Default,,0,0,0,,А…?
Dialogue: 0,0:44:03.34,0:44:06.14,Default,,0,0,0,,Мен жанартау аймағынан абайсызда өтіп бара жатырмын.
Dialogue: 0,0:44:06.26,0:44:08.56,Default,,0,0,0,,Есіктің жанындағы қосқышты басыңыз.
Dialogue: 0,0:44:08.68,0:44:11.35,Default,,0,0,0,,Ааа... уф... Жақсы түсірілген
Dialogue: 0,0:44:11.94,0:44:14.73,Default,,0,0,0,,Хаа... Бұл жанартаулық аймақ.
Dialogue: 0,0:44:16.40,0:44:18.94,Default,,0,0,0,,Ол қазірдің өзінде Гавайиге жақын.
Dialogue: 0,0:44:19.07,0:44:21.74,Default,,0,0,0,,(Нобита мен Джианның мазасыз дауыстары)
Dialogue: 0,0:44:49.97,0:44:52.73,Default,,0,0,0,,Мен жер астында осындай үлкен үңгір болғанына сене алар емеспін.
Dialogue: 0,0:44:52.85,0:44:54.35,Default,,0,0,0,,Мен сене алар емеспін.
Dialogue: 0,0:45:14.46,0:45:18.25,Default,,0,0,0,,Қарасам, жер астында көлік жоқ.
Dialogue: 0,0:45:18.67,0:45:19.84,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:45:19.96,0:45:22.26,Default,,0,0,0,,Бұл пайдаланылған газдың кесірінен екеніне сенімдімін.
Dialogue: 0,0:45:27.43,0:45:30.72,Default,,0,0,0,,Барлығы жақын арада құрлықаралық теміржол вокзалына келеді.
Dialogue: 0,0:45:31.01,0:45:33.77,Default,,0,0,0,,О, бұл Энлил емес пе?
Dialogue: 0,0:45:33.89,0:45:36.56,Default,,0,0,0,,Астанасы Энлиль Оа материгінің орталығында орналасқан.
Dialogue: 0,0:45:38.27,0:45:40.52,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:45:47.66,0:45:49.37,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,0:45:59.67,0:46:02.25,Default,,0,0,0,,Бұл жылдам. Шинкансенге қарағанда жылдамырақ.
Dialogue: 0,0:46:02.38,0:46:04.38,Default,,0,0,0,,Бұл тыныш.
Dialogue: 0,0:46:04.51,0:46:05.38,Default,,0,0,0,,Мисс Бекки қамалда тұрады
Dialogue: 0,0:46:06.05,0:46:08.34,Default,,0,0,0,,Бұл пойыз магнетизммен жұмыс істейді.
Dialogue: 0,0:46:09.18,0:46:11.97,Default,,0,0,0,,...Сонымен бұл сызықты моторлы автомобиль.
Dialogue: 0,0:46:12.10,0:46:13.81,Default,,0,0,0,,Прогресс
Dialogue: 0,0:46:14.14,0:46:17.19,Default,,0,0,0,,Мм... Энлильге жету үшін қанша уақыт қажет?
Dialogue: 0,0:46:17.31,0:46:21.02,Default,,0,0,0,,Бұл әлі біраз уақыт алады, сондықтан оған дейін жақсылап демалыңыз.
Dialogue: 0,0:46:21.15,0:46:23.73,Default,,0,0,0,,Егер бірдеңе болса, сол жердегі түймені басу арқылы маған хабарлаңыз.
Dialogue: 0,0:46:40.75,0:46:46.05,Default,,0,0,0,,(Төрт адамның ұйықтауы)
Dialogue: 0,0:46:46.17,0:46:48.38,Default,,0,0,0,,Мен қай жерде жаттығып жүргенімді ойлайсың?
Dialogue: 0,0:46:48.88,0:46:51.60,Default,,0,0,0,,(Төрт адамның ұйықтауы)
Dialogue: 0,0:46:56.85,0:46:59.48,Default,,0,0,0,,Нобита-сан, оян. Сіз келген сияқтысыз.
Dialogue: 0,0:46:59.60,0:47:03.44,Default,,0,0,0,,Нобита-кун, оян, Нобита-кун.
Dialogue: 0,0:47:21.63,0:47:22.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:22.54,0:47:25.09,Default,,0,0,0,,Маған Сунеомен жақында кездесуге рұқсат бермейсіз бе?
Dialogue: 0,0:47:25.21,0:47:26.92,Default,,0,0,0,,Уәделер әртүрлі.
Dialogue: 0,0:47:27.13,0:47:28.88,Default,,0,0,0,,Өзімшіл ештеңе айтпа
Dialogue: 0,0:47:29.22,0:47:30.80,Default,,0,0,0,,Амансың ба? Біз –
Dialogue: 0,0:47:30.93,0:47:33.26,Default,,0,0,0,,Заңсыз иммигрант екеніңізді ұмытпаңыз.
Dialogue: 0,0:47:34.51,0:47:39.73,Default,,0,0,0,,Алдымен сізден мекен-жайыңызды, атыңызды және жасыңызды сұрасам бола ма?
Dialogue: 0,0:47:40.52,0:47:42.19,Default,,0,0,0,,Нобита Ноби
Dialogue: 0,0:47:42.52,0:47:44.23,Default,,0,0,0,,Сізде бар нәрсе осы ма?
Dialogue: 0,0:47:44.36,0:47:47.19,Default,,0,0,0,,Уа, мынау мөлдір шар не?
Dialogue: 0,0:47:47.32,0:47:48.61,Default,,0,0,0,,Бұл бомба емес шығар.
Dialogue: 0,0:47:49.32,0:47:52.07,Default,,0,0,0,,Иә? Сіз мәрмәрдің не екенін білмейсіз бе?
Dialogue: 0,0:47:52.41,0:47:55.70,Default,,0,0,0,,Жұқпалы аурулар немесе басқа ауытқулар анықталған жоқ
Dialogue: 0,0:47:57.16,0:48:01.62,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:48:01.75,0:48:02.54,Default,,0,0,0,,Қытық Егер қытық болса...
Dialogue: 0,0:48:02.54,0:48:04.38,Default,,0,0,0,,Қықылдаса қытықтаса...
Dialogue: 0,0:48:02.54,0:48:04.38,Default,,0,0,0,,Мен мұндай тіршілік иесін бұрын-соңды көрген емеспін.
Dialogue: 0,0:48:04.38,0:48:04.92,Default,,0,0,0,,Мен мұндай тіршілік иесін бұрын-соңды көрген емеспін.
Dialogue: 0,0:48:05.34,0:48:07.17,Default,,0,0,0,,А, қалай болды?
Dialogue: 0,0:48:07.67,0:48:10.38,Default,,0,0,0,,Бұл қытықтай сұрау болды.
Dialogue: 0,0:48:10.76,0:48:13.22,Default,,0,0,0,,Бұдан былай не болады?
Dialogue: 0,0:48:13.34,0:48:14.43,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:48:14.55,0:48:15.26,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:48:15.39,0:48:16.10,Default,,0,0,0,,Токиода бұлардың әрқайсысы 3 миллиард немесе 4 миллиард тұрар еді.
Dialogue: 0,0:48:16.22,0:48:17.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:20.18,0:48:21.14,Default,,0,0,0,,Сунео!
Dialogue: 0,0:48:21.27,0:48:21.94,Default,,0,0,0,,Сунео мырза
Dialogue: 0,0:48:22.39,0:48:24.98,Default,,0,0,0,,Барлығы... келді.
Dialogue: 0,0:48:25.11,0:48:27.15,Default,,0,0,0,,Жан достар!
Dialogue: 0,0:48:27.27,0:48:28.36,Default,,0,0,0,,(қуаныш дыбыстары)
Dialogue: 0,0:48:28.48,0:48:31.36,Default,,0,0,0,,Жақсы нәрсе, мен уайымдадым.
Dialogue: 0,0:48:31.61,0:48:33.24,Default,,0,0,0,,Жауап алу нәтижелері—
Dialogue: 0,0:48:33.36,0:48:36.49,Default,,0,0,0,,Сіз зиянкес емес екеніңіз анық.
Dialogue: 0,0:48:36.62,0:48:38.91,Default,,0,0,0,,Сондықтан мен сені жерге қайта жіберемін.
Dialogue: 0,0:48:39.04,0:48:40.25,Default,,0,0,0,,(5 қуанышты дауыс)
Dialogue: 0,0:48:40.75,0:48:44.88,Default,,0,0,0,,Дегенмен, Рим Папасы мақұлдау процесіне байланысты сізден 2-3 күн қалуыңыз талап етіледі.
Dialogue: 0,0:48:45.00,0:48:46.92,Default,,0,0,0,,2-3 күн көмектеспейді...
Dialogue: 0,0:48:47.04,0:48:49.67,Default,,0,0,0,,Әзірше, мен сізге мына жерде көрсетейін.
Dialogue: 0,0:48:50.26,0:48:54.38,Default,,0,0,0,,Егер біз өз тәжірибемізді жарияласақ, бұл үлкен сенсация болар еді!
Dialogue: 0,0:48:54.51,0:48:57.26,Default,,0,0,0,,Олай десеңіз, бұл үлкен сенсация.
Dialogue: 0,0:48:57.39,0:48:59.31,Default,,0,0,0,,(Дарио) Хе-хе-хе-хе. Эй, қарашы — бұл апат!
Dialogue: 0,0:48:59.43,0:49:01.02,Default,,0,0,0,,Өкінішке орай, бұл мүмкін емес.
Dialogue: 0,0:49:01.14,0:49:02.89,Default,,0,0,0,,Жер асты әлемі туралы естеліктер:
Dialogue: 0,0:49:03.02,0:49:05.10,Default,,0,0,0,,Үйге барар алдында бәрін өшіру керек.
Dialogue: 0,0:49:05.27,0:49:06.56,Default,,0,0,0,,Жадты өшіру?
Dialogue: 0,0:49:06.69,0:49:08.07,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:49:08.48,0:49:09.94,Default,,0,0,0,,Шамадан тыс ештеңе айтпа
Dialogue: 0,0:49:10.07,0:49:12.99,Default,,0,0,0,,Мен үйге аман-есен оралуым үшін алғыс айтуым керек.
Dialogue: 0,0:49:13.11,0:49:16.37,Default,,0,0,0,,Иә, бұл рас, бірақ...
Dialogue: 0,0:49:18.58,0:49:20.91,Default,,0,0,0,,Мен кеткенше менің үйімде демалыңыз.
Dialogue: 0,0:49:21.66,0:49:23.91,Default,,0,0,0,,Бірдеңе керек болса, әпкеме айтыңыз.
Dialogue: 0,0:49:24.67,0:49:25.96,Default,,0,0,0,,Заң апамды таныстырып өтейін
Dialogue: 0,0:49:26.08,0:49:26.75,Default,,0,0,0,,Төмен!
Dialogue: 0,0:49:27.71,0:49:29.46,Default,,0,0,0,,Иә, аға, қош келдіңіз.
Dialogue: 0,0:49:29.63,0:49:31.30,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:49:31.42,0:49:32.92,Default,,0,0,0,,Өте сүйкімді! Пун!
Dialogue: 0,0:49:33.26,0:49:35.88,Default,,0,0,0,,Мен Ромын, менің досым болшы.
Dialogue: 0,0:49:36.26,0:49:37.72,Default,,0,0,0,,Әрине
Dialogue: 0,0:49:40.06,0:49:42.35,Default,,0,0,0,,Қаланы көру жақсы
Dialogue: 0,0:49:42.47,0:49:45.23,Default,,0,0,0,,Бірақ ол ғимаратқа жақындамаңыз.
Dialogue: 0,0:49:45.35,0:49:47.48,Default,,0,0,0,,Бұл шектеулі аймақ.
Dialogue: 0,0:49:47.94,0:49:50.02,Default,,0,0,0,,Маған қызық, бұл не, қойма.
Dialogue: 0,0:49:50.15,0:49:51.53,Default,,0,0,0,,Менің оны көргім келмейді.
Dialogue: 0,0:49:53.82,0:49:58.24,Default,,0,0,0,,Жарайды, мен Киелі Таққа баруым керек. Ро, қалғанын сұрадым.
Dialogue: 0,0:49:58.37,0:50:00.37,Default,,0,0,0,,Иә, өтінемін, ағайын.
Dialogue: 0,0:50:01.20,0:50:04.04,Default,,0,0,0,,Олай болса мен саған қаланы аралап көрсетемін.
Dialogue: 0,0:50:07.87,0:50:13.88,Default,,0,0,0,,Орталық станция. Оның жанында Орталық базар орналасқан. Ол жақта театр бар.
Dialogue: 0,0:50:14.13,0:50:15.97,Default,,0,0,0,,Бұл концерт залы
Dialogue: 0,0:50:16.09,0:50:18.59,Default,,0,0,0,,(Нобита және оның достарының лебіздері)
Dialogue: 0,0:50:18.72,0:50:20.05,Default,,0,0,0,,Шугакуин
Dialogue: 0,0:50:20.43,0:50:21.81,Default,,0,0,0,,Мұрағаттар
Dialogue: 0,0:50:21.93,0:50:24.73,Default,,0,0,0,,Төбеде сіз Папа сарайын көре аласыз.
Dialogue: 0,0:50:25.56,0:50:27.35,Default,,0,0,0,,«Папа» дегеніміз не?
Dialogue: 0,0:50:27.60,0:50:29.65,Default,,0,0,0,,Құдайға қызмет ететін ұлы адам
Dialogue: 0,0:50:29.77,0:50:30.61,Default,,0,0,0,,Құдай?
Dialogue: 0,0:50:30.73,0:50:32.23,Default,,0,0,0,,Жер астындағы адамдардың құдайы қандай?
Dialogue: 0,0:50:32.48,0:50:35.36,Default,,0,0,0,,Құдай жер асты елін жаратты.
Dialogue: 0,0:50:35.49,0:50:38.74,Default,,0,0,0,,Сіз бұл тарихи мұражайға барған кезде түсінесіз.
Dialogue: 0,0:50:40.99,0:50:44.83,Default,,0,0,0,,Ой, алтын қазба
Dialogue: 0,0:50:44.95,0:50:48.71,Default,,0,0,0,,Киелі жерде қазылған, Құдайдың ғажайып белгісі.
Dialogue: 0,0:50:49.42,0:50:53.13,Default,,0,0,0,,Бұл стеноникозавр сүйектерінің ыдырауына байланысты.
Dialogue: 0,0:50:53.25,0:50:54.59,Default,,0,0,0,,Бұл түске айналды.
Dialogue: 0,0:50:55.21,0:50:57.09,Default,,0,0,0,,Киелі орын дегеніміз не?
Dialogue: 0,0:50:57.22,0:51:00.05,Default,,0,0,0,,«Қасиетті жер» Мұнда кел.
Dialogue: 0,0:51:01.22,0:51:05.93,Default,,0,0,0,,Ол жақтағы үлкен материк – Оа, ал оның үстінде шағын материк бар, солай ма?
Dialogue: 0,0:51:06.06,0:51:08.19,Default,,0,0,0,,Оның оңтүстік-батыс бұрышына қараңыз
Dialogue: 0,0:51:08.48,0:51:10.23,Default,,0,0,0,,Кішкентай шаршыны көруге болады.
Dialogue: 0,0:51:10.35,0:51:11.06,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:51:11.52,0:51:14.57,Default,,0,0,0,,Сунео, неге бұлай пішінде?
Dialogue: 0,0:51:14.69,0:51:17.78,Default,,0,0,0,,Неге... бұл біртүрлі.
Dialogue: 0,0:51:18.40,0:51:25.08,Default,,0,0,0,,Ғалымдардың өлшеулері бойынша 65 миллион жыл бұрын, дәл сол үлкен апат кезінде.
Dialogue: 0,0:51:25.20,0:51:28.66,Default,,0,0,0,,(жану дыбысы)
Dialogue: 0,0:51:28.79,0:51:31.92,Default,,0,0,0,,Жер бетіндегі барлық дерлік тіршілік жойылған кезде...
Dialogue: 0,0:51:32.92,0:51:37.13,Default,,0,0,0,,Бұл ғибадатханада кейбір динозаврлар жасырынып жүрген көрінеді.
Dialogue: 0,0:51:37.63,0:51:40.38,Default,,0,0,0,,Сонымен, ертедегі Стенонихозавр
Dialogue: 0,0:51:40.84,0:51:45.56,Default,,0,0,0,,Оларда барлық динозаврлардың ең үлкен миы болды.
Dialogue: 0,0:51:45.85,0:51:49.27,Default,,0,0,0,,Ақырында ол керемет эволюциялық жолмен жүрді...
Dialogue: 0,0:51:49.52,0:51:53.27,Default,,0,0,0,,Басқаша айтқанда, біз жер асты адамдарының ата-бабаларына айналдық.
Dialogue: 0,0:51:53.40,0:51:56.15,Default,,0,0,0,,А, сонда динозаврлардың ұрпақтары? Бұл...
Dialogue: 0,0:51:56.32,0:51:59.11,Default,,0,0,0,,Өтірік, кесірткелер адамға ұқсайды.
Dialogue: 0,0:51:59.32,0:52:00.86,Default,,0,0,0,,Мен таң қалған жоқпын.
Dialogue: 0,0:52:00.99,0:52:02.57,Default,,0,0,0,,Тіпті сіздің ата-бабаларыңыз...
Dialogue: 0,0:52:02.70,0:52:04.12,Default,,0,0,0,,Артыңызға қараңыз.
Dialogue: 0,0:52:04.24,0:52:05.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:05.20,0:52:05.99,Default,,0,0,0,,Әй?
Dialogue: 0,0:52:06.28,0:52:08.91,Default,,0,0,0,,Нене Нене Нене Тышқан!
Dialogue: 0,0:52:09.12,0:52:12.33,Default,,0,0,0,,Мезозой дәуірінде жер бетіндегі адамдар осылай болған.
Dialogue: 0,0:52:12.75,0:52:15.42,Default,,0,0,0,,Мен егеуқұйрықтарды ұнатпаймын.
Dialogue: 0,0:52:15.63,0:52:17.92,Default,,0,0,0,,Егер апат болмаса —
Dialogue: 0,0:52:18.05,0:52:21.22,Default,,0,0,0,,Динозаврлар жер бетінде гүлденген болуы мүмкін.
Dialogue: 0,0:52:21.63,0:52:25.05,Default,,0,0,0,,65 миллион жыл бұрын дәл не болды?
Dialogue: 0,0:52:25.35,0:52:27.10,Default,,0,0,0,,Мұны ешкім білмейді
Dialogue: 0,0:52:27.22,0:52:30.39,Default,,0,0,0,,Бірақ қазір білу үшін үлкен жоспар бар.
Dialogue: 0,0:52:30.81,0:52:32.69,Default,,0,0,0,,«Үлкен жоспар» дегеніміз не?
Dialogue: 0,0:52:32.81,0:52:34.52,Default,,0,0,0,,(Батлер) Қош келдіңіз, Лорд Джоэстар. Біз сізді күтіп жүр едік.
Dialogue: 0,0:52:35.02,0:52:39.78,Default,,0,0,0,,Сонда өркениетті, ғылым мен техниканы дамытқан ата-бабаларымыз...
Dialogue: 0,0:52:39.90,0:52:43.91,Default,,0,0,0,,Ол қоғамды айтарлықтай ілгерілететін тамаша өнертабыс жасады.
Dialogue: 0,0:52:44.03,0:52:48.24,Default,,0,0,0,,Міне! Әлемдегі алғашқы өлшемді түрлендіру кемесі.
Dialogue: 0,0:52:48.37,0:52:49.58,Default,,0,0,0,,А...
Dialogue: 0,0:52:49.91,0:52:51.41,Default,,0,0,0,,Өлшемді ауыстыратын кеме?
Dialogue: 0,0:52:51.54,0:52:54.71,Default,,0,0,0,,Басқаша айтқанда, бұл сізді басқа өлшемге апара алатын кеме, солай емес пе?
Dialogue: 0,0:52:54.83,0:52:57.96,Default,,0,0,0,,Иә, сіз жер қыртысына еркін кіре аласыз.
Dialogue: 0,0:52:58.80,0:53:02.88,Default,,0,0,0,,Бұл бірінен соң бірі белгісіз материктердің ашылуына әкелді.
Dialogue: 0,0:53:03.05,0:53:05.84,Default,,0,0,0,,Барлау дәуірінің шымылдығы ашылды.
Dialogue: 0,0:53:06.64,0:53:09.85,Default,,0,0,0,,Міне, ұлы Құдай туралы әңгіме осымен аяқталды.
Dialogue: 0,0:53:10.31,0:53:11.73,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:53:11.85,0:53:14.02,Default,,0,0,0,,Менің пикникке барғым келеді.
Dialogue: 0,0:53:14.14,0:53:15.31,Default,,0,0,0,,Қалай болғанда да, бұл қаһармандарды өлтіру миссиясын соңына дейін жеткізетін мен боламын.
Dialogue: 0,0:53:15.73,0:53:19.77,Default,,0,0,0,,Енді біраз уақыттан кейін алғаш рет ХХІ ғасырдағы құралдарды шығарайық.
Dialogue: 0,0:53:22.36,0:53:24.78,Default,,0,0,0,,Аспанда алғаш рет ұшу
Dialogue: 0,0:53:25.36,0:53:26.70,Default,,0,0,0,,Бұл дәмді, Лоу мырза.
Dialogue: 0,0:53:27.41,0:53:31.58,Default,,0,0,0,,Әй, қызық емес пе? Сіз үйреніп алсаңыз, мен сияқты нәрселерді жасай аласыз.
Dialogue: 0,0:53:31.70,0:53:32.62,Default,,0,0,0,,Қара, қара, қара.
Dialogue: 0,0:53:32.75,0:53:34.33,Default,,0,0,0,,Міне!
Dialogue: 0,0:53:35.08,0:53:36.63,Default,,0,0,0,,Нобита-кун, бұл қауіпті.
Dialogue: 0,0:53:38.13,0:53:39.67,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:53:40.67,0:53:41.71,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,0:53:42.59,0:53:44.01,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:53:44.13,0:53:46.01,Default,,0,0,0,,Аспанға соғу
Dialogue: 0,0:53:46.13,0:53:49.05,Default,,0,0,0,,Бұл үңгірдің ішінде, сондықтан абай болыңыз.
Dialogue: 0,0:53:49.18,0:53:50.89,Default,,0,0,0,,Нобита-сан, жақсысың ба?
Dialogue: 0,0:53:51.01,0:53:53.10,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:53:53.22,0:53:54.27,Default,,0,0,0,,Барайық (Нобита) Иә.
Dialogue: 0,0:53:55.60,0:54:00.19,Default,,0,0,0,,А, бұл жерде құрлықтағы өсімдіктерге ұқсас өсімдіктер өседі.
Dialogue: 0,0:54:00.32,0:54:01.98,Default,,0,0,0,,Бірақ жасыл әдемі.
Dialogue: 0,0:54:02.11,0:54:04.19,Default,,0,0,0,,Иә, әрқашан көктем.
Dialogue: 0,0:54:04.57,0:54:06.95,Default,,0,0,0,,Сонда қар да жаумайды.
Dialogue: 0,0:54:07.07,0:54:07.78,Default,,0,0,0,,Қар?
Dialogue: 0,0:54:07.91,0:54:10.33,Default,,0,0,0,,Сонда жаңбыр да жаумайды.
Dialogue: 0,0:54:10.45,0:54:11.16,Default,,0,0,0,,Жаңбыр?
Dialogue: 0,0:54:11.49,0:54:15.08,Default,,0,0,0,,Жаңбыр жоқ па? Сонда кемпірқосақ та, тайфун да болмайды.
Dialogue: 0,0:54:15.25,0:54:18.71,Default,,0,0,0,,Керемет, біз кез келген уақытта футбол немесе бейсбол ойнай аламыз.
Dialogue: 0,0:54:18.83,0:54:22.59,Default,,0,0,0,,Бірақ түнде ылғи қараңғы, жұлдыздар да, ай да шықпайды.
Dialogue: 0,0:54:23.05,0:54:25.13,Default,,0,0,0,,Аспанда бұлт жоқ
Dialogue: 0,0:54:25.26,0:54:28.05,Default,,0,0,0,,Бұл өте романтикалық емес сияқты.
Dialogue: 0,0:54:28.18,0:54:31.05,Default,,0,0,0,,Жер – арман әлеміндей
Dialogue: 0,0:54:31.72,0:54:34.31,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:54:34.43,0:54:35.06,Default,,0,0,0,,Ах!?
Dialogue: 0,0:54:35.18,0:54:36.98,Default,,0,0,0,,Ой, қызық, бұл не?
Dialogue: 0,0:54:37.23,0:54:38.27,Default,,0,0,0,,Орманның арғы жағында
Dialogue: 0,0:54:38.40,0:54:39.40,Default,,0,0,0,,Барайық (Нобита) Иә.
Dialogue: 0,0:54:39.52,0:54:43.36,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:54:43.48,0:54:47.24,Default,,0,0,0,,Біріншіден, аяқтарыңыздың астындағы қорапқа қараңыздар
Dialogue: 0,0:54:51.57,0:54:52.91,Default,,0,0,0,,Бұл рыцарьлық жаттығу.
Dialogue: 0,0:54:53.03,0:54:55.20,Default,,0,0,0,,Уау, нағыз соғыс сияқты.
Dialogue: 0,0:54:55.41,0:55:01.13,Default,,0,0,0,,(рыцарлардың ұрыс айқайы)
Dialogue: 0,0:55:01.29,0:55:02.59,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:55:03.21,0:55:08.47,Default,,0,0,0,,(жекпе-жек дауысы)
Dialogue: 0,0:55:08.63,0:55:12.18,Default,,0,0,0,,Неліктен олар таңғажайып, нағыз ұрысқа ұқсас жаттығулар жасайды?
Dialogue: 0,0:55:12.30,0:55:13.76,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,0:55:19.23,0:55:20.69,Default,,0,0,0,,Мен тура жүрдім
Dialogue: 0,0:55:21.06,0:55:24.65,Default,,0,0,0,,Жауды осындай нәрсемен жеңуге болады деп ойлайсың ба?
Dialogue: 0,0:55:24.77,0:55:25.69,Default,,0,0,0,,Тез қоңырау шалыңыз.
Dialogue: 0,0:55:25.98,0:55:26.82,Default,,0,0,0,,Аға
Dialogue: 0,0:55:27.24,0:55:29.11,Default,,0,0,0,,Заң, келдің бе?
Dialogue: 0,0:55:32.99,0:55:37.37,Default,,0,0,0,,Заң, қуан, ұлы жорық ақыры аяқталды.
Dialogue: 0,0:55:37.91,0:55:40.29,Default,,0,0,0,,Ұлы экспедиция? Сонда бұл жоспар туралы не деуге болады?
Dialogue: 0,0:55:40.54,0:55:43.79,Default,,0,0,0,,Дұрыс, көптен күткен тілегім ақыры орындалды.
Dialogue: 0,0:55:44.46,0:55:47.21,Default,,0,0,0,,Жаттығуларымыз өз жемісін беретін кез келді.
Dialogue: 0,0:55:47.76,0:55:50.68,Default,,0,0,0,,Жақсы. Ендеше кетеміз бе?
Dialogue: 0,0:55:51.05,0:55:52.93,Default,,0,0,0,,Жақында.
Dialogue: 0,0:55:53.85,0:55:56.93,Default,,0,0,0,,Бұл жерде қауіпті, басқа жаққа барыңыз.
Dialogue: 0,0:55:57.35,0:56:01.39,Default,,0,0,0,,«Экспедиция» дегенде, алыстағы елге баруды айтасыз ба?
Dialogue: 0,0:56:01.52,0:56:04.15,Default,,0,0,0,,Иә, алыс, алыс
Dialogue: 0,0:56:04.27,0:56:08.57,Default,,0,0,0,,(жекпе-жек дауысы)
Dialogue: 0,0:56:14.53,0:56:17.29,Default,,0,0,0,,Ой, динозаврлар өте көп.
Dialogue: 0,0:56:17.41,0:56:18.58,Default,,0,0,0,,Шаруа қожалығы
Dialogue: 0,0:56:21.04,0:56:22.54,Default,,0,0,0,,Мұндағы айдаһар жалға алынған.
Dialogue: 0,0:56:22.67,0:56:25.04,Default,,0,0,0,,Қай жерге түсірсем де, жалғыз келемін.
Dialogue: 0,0:56:25.17,0:56:26.46,Default,,0,0,0,,Уау өте сүйкімді
Dialogue: 0,0:56:26.84,0:56:30.42,Default,,0,0,0,,Эй, Takecopter қолданбасын доғар, қазір қалаға қайтайық.
Dialogue: 0,0:56:30.55,0:56:31.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:31.76,0:56:32.93,Default,,0,0,0,,Керемет
Dialogue: 0,0:56:33.93,0:56:35.80,Default,,0,0,0,,Оны мінгенде оңай.
Dialogue: 0,0:56:35.93,0:56:37.89,Default,,0,0,0,,Нобита-кун, жақсысың ба?
Dialogue: 0,0:56:38.06,0:56:39.10,Default,,0,0,0,,Тіпті осында!
Dialogue: 0,0:56:39.22,0:56:42.89,Default,,0,0,0,,Менің айтқанымды тыңда, надан.
Dialogue: 0,0:56:43.02,0:56:45.31,Default,,0,0,0,,Тізгінді көп тартсаң да жақсы емес.
Dialogue: 0,0:56:45.69,0:56:47.73,Default,,0,0,0,,Ей, қалаға жарысайық.
Dialogue: 0,0:56:47.86,0:56:48.82,Default,,0,0,0,,Әй, істе, істе.
Dialogue: 0,0:56:48.94,0:56:50.74,Default,,0,0,0,,Эй, эй, күте тұр
Dialogue: 0,0:56:50.94,0:56:53.11,Default,,0,0,0,,Жарайды... Дон!
Dialogue: 0,0:56:54.95,0:56:56.87,Default,,0,0,0,,А, күте тұр, күте тұр, күте тұр.
Dialogue: 0,0:56:56.99,0:56:59.54,Default,,0,0,0,,А, қайда бара жатырсың?
Dialogue: 0,0:57:01.37,0:57:04.08,Default,,0,0,0,,Тоқта! тоқта! Тоқта!
Dialogue: 0,0:57:04.50,0:57:06.96,Default,,0,0,0,,Дораемон
Dialogue: 0,0:57:07.88,0:57:12.88,Default,,0,0,0,,(Екі адам айғайлайды)
Dialogue: 0,0:57:16.76,0:57:18.43,Default,,0,0,0,,Иә!
Dialogue: 0,0:57:18.97,0:57:21.18,Default,,0,0,0,,Барыңыз (Сунео) Бұл мақсат.
Dialogue: 0,0:57:24.94,0:57:26.81,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен №1мін.
Dialogue: 0,0:57:26.94,0:57:28.61,Default,,0,0,0,,Хехе, бұл фото аяқталды.
Dialogue: 0,0:57:31.03,0:57:33.07,Default,,0,0,0,,Әй, жақсы болды.
Dialogue: 0,0:57:33.19,0:57:35.16,Default,,0,0,0,,Барлығы өте жылдам.
Dialogue: 0,0:57:35.28,0:57:36.95,Default,,0,0,0,,Иә? Нобита ше?
Dialogue: 0,0:57:37.07,0:57:38.58,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:57:38.70,0:57:41.49,Default,,0,0,0,,Біреу маған көмектесуін өтінемін
Dialogue: 0,0:57:41.62,0:57:44.04,Default,,0,0,0,,Дораемон
Dialogue: 0,0:57:45.21,0:57:46.54,Default,,0,0,0,,Итте Уггугугу…
Dialogue: 0,0:57:46.67,0:57:47.67,Default,,0,0,0,,Бұл кім? (мылтық дыбысы)
Dialogue: 0,0:57:47.79,0:57:49.21,Default,,0,0,0,,(ренжіген дауыс)
Dialogue: 0,0:57:51.25,0:57:53.01,Default,,0,0,0,,Ішке айдаһар секірді, бірақ...
Dialogue: 0,0:57:53.13,0:57:55.38,Default,,0,0,0,,2-3 атудан кейін қашып кеткен сияқты.
Dialogue: 0,0:57:55.51,0:57:56.38,Default,,0,0,0,,Бұл адасқан айдаһар ма?
Dialogue: 0,0:57:56.72,0:57:58.26,Default,,0,0,0,,Сенімді болу үшін айналамызға басқа жерге қарайық.
Dialogue: 0,0:57:58.39,0:57:59.26,Default,,0,0,0,,О
Dialogue: 0,0:57:59.39,0:58:00.35,Default,,0,0,0,,Хаа…
Dialogue: 0,0:58:02.22,0:58:03.18,Default,,0,0,0,,Ах
Dialogue: 0,0:58:03.64,0:58:07.98,Default,,0,0,0,,Егер есімде дұрыс болса, бұл Ванхо мырзаның маған жақындамау керектігін айтқан ғимараты.
Dialogue: 0,0:58:10.73,0:58:11.94,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:58:12.07,0:58:13.44,Default,,0,0,0,,Жарайды, қазір бәрі жақсы.
Dialogue: 0,0:58:13.44,0:58:14.32,Default,,0,0,0,,Жарайды, қазір бәрі жақсы.
Dialogue: 0,0:58:13.44,0:58:14.32,Default,,0,0,0,,Ха! біреу келе жатыр
Dialogue: 0,0:58:14.32,0:58:14.86,Default,,0,0,0,,Ха! біреу келе жатыр
Dialogue: 0,0:58:17.03,0:58:18.49,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:58:25.29,0:58:27.46,Default,,0,0,0,,Нобита-кун
Dialogue: 0,0:58:27.75,0:58:30.08,Default,,0,0,0,,Нобита!
Dialogue: 0,0:58:30.34,0:58:33.09,Default,,0,0,0,,Нобита қайда орналасқан?
Dialogue: 0,0:58:33.21,0:58:37.26,Default,,0,0,0,,Нобита Нобита-чан Ноби!
Dialogue: 0,0:58:37.38,0:58:39.01,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз сонда болдыңыз ба?
Dialogue: 0,0:58:39.18,0:58:40.30,Default,,0,0,0,,Онда жоқ.
Dialogue: 0,0:58:40.43,0:58:41.76,Default,,0,0,0,,Ол әлдеқашан кетті.
Dialogue: 0,0:58:41.89,0:58:42.60,Default,,0,0,0,,Иә
Dialogue: 0,0:58:42.72,0:58:44.97,Default,,0,0,0,,Мен қажет емес нәрсе айтқандықтан
Dialogue: 0,0:58:45.10,0:58:47.14,Default,,0,0,0,,Жоқ, менің де кінәм болды.
Dialogue: 0,0:58:47.27,0:58:48.98,Default,,0,0,0,,А, сол жерден іздеп көрейік.
Dialogue: 0,0:58:49.10,0:58:50.15,Default,,0,0,0,,Нобита!
Dialogue: 0,0:58:50.27,0:58:52.07,Default,,0,0,0,,Жауап (Сунео) Нобита
Dialogue: 0,0:58:52.19,0:58:53.94,Default,,0,0,0,,Нобита!
Dialogue: 0,0:59:02.45,0:59:04.74,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:59:18.76,0:59:19.80,Default,,0,0,0,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:59:34.98,0:59:37.57,Default,,0,0,0,,Үлкен кеме... ол не үшін керек?
Dialogue: 0,0:59:37.74,0:59:39.20,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:59:48.79,0:59:52.08,Default,,0,0,0,,Ақырында аяқталды ма? Жарайсың
Dialogue: 0,0:59:52.25,0:59:54.13,Default,,0,0,0,,Рахмет, бас діни қызметкер.
Dialogue: 0,0:59:54.25,0:59:56.84,Default,,0,0,0,,Бұл көптен бері арман болды.
Dialogue: 0,0:59:56.96,1:00:02.05,Default,,0,0,0,,65 миллион жыл бойы алыстағы ата-бабамыздан қалған арман.
Dialogue: 0,1:00:02.18,1:00:07.02,Default,,0,0,0,,Енді сүтқоректілер бетімізге жабысып жатқан жер әлемі.
Dialogue: 0,1:00:07.89,1:00:15.27,Default,,0,0,0,,Бастапқыда жұмақ болған жерді қайтадан динозавр халқының қолына алайық.
Dialogue: 0,1:00:31.25,1:00:33.50,Default,,0,0,0,,Заң мырза Лоу мырза
Dialogue: 0,1:00:33.63,1:00:35.13,Default,,0,0,0,,Нобита-сан табылды
Dialogue: 0,1:00:35.25,1:00:36.88,Default,,0,0,0,,О, жақсы.
Dialogue: 0,1:00:37.05,1:00:39.05,Default,,0,0,0,,Мен орманда қыдырдым.
Dialogue: 0,1:00:39.17,1:00:40.55,Default,,0,0,0,,Сіз қазірдің өзінде алаңдай бастадыңыз.
Dialogue: 0,1:00:40.67,1:00:42.05,Default,,0,0,0,,Бірақ бұл жақсы болды.
Dialogue: 0,1:00:42.18,1:00:43.76,Default,,0,0,0,,Оған көмектесу мүмкін емес
Dialogue: 0,1:00:45.43,1:00:47.22,Default,,0,0,0,,Нобита-сан, сен қайда болдың?
Dialogue: 0,1:00:47.35,1:00:49.10,Default,,0,0,0,,А... Иә, сәл ғана...
Dialogue: 0,1:00:49.22,1:00:51.06,Default,,0,0,0,,Біраз демалу керек.
Dialogue: 0,1:00:51.18,1:00:52.85,Default,,0,0,0,,Иә, мен мұны істеймін
Dialogue: 0,1:00:52.98,1:00:54.81,Default,,0,0,0,,Иә, бөлмеңізге барыңыз.
Dialogue: 0,1:00:54.94,1:00:57.32,Default,,0,0,0,,Нобита мен жарысты жеңдім.
Dialogue: 0,1:00:57.44,1:00:58.61,Default,,0,0,0,,Аа, бұл бір уақытта болды.
Dialogue: 0,1:00:58.73,1:01:01.32,Default,,0,0,0,,Жоқ, мен бірінші болдым.
Dialogue: 0,1:01:01.44,1:01:02.53,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:01:02.65,1:01:07.83,Default,,0,0,0,,Барлығыңыз тынышталып, тыңдаңыздар. Менің сізге айтарым өте маңызды нәрсе бар.
Dialogue: 0,1:01:08.12,1:01:09.41,Default,,0,0,0,,Не?
Dialogue: 0,1:01:09.62,1:01:10.91,Default,,0,0,0,,Сіз бұған сенімдісіз бе?
Dialogue: 0,1:01:11.45,1:01:12.62,Default,,0,0,0,,​​Күмән жоқ!
Dialogue: 0,1:01:12.75,1:01:14.92,Default,,0,0,0,,«Сүтқоректілер мекендейтін жер әлемі».
Dialogue: 0,1:01:15.04,1:01:16.38,Default,,0,0,0,,«Бұл оны қайтару үшін», - деді ол.
Dialogue: 0,1:01:16.50,1:01:19.84,Default,,0,0,0,,Осы мақсатта өте үлкен әскери кеме жасалды.
Dialogue: 0,1:01:20.30,1:01:23.05,Default,,0,0,0,,Сүтқоректілер дегенде мен адамдарды айтамын.
Dialogue: 0,1:01:23.17,1:01:26.59,Default,,0,0,0,,Иә, мен адамдарға қарсы соғыс ашуды жоспарлап отырмын.
Dialogue: 0,1:01:26.72,1:01:29.35,Default,,0,0,0,,Мен оларды мұндай сұмдық адамдар деп көрмеймін.
Dialogue: 0,1:01:29.47,1:01:31.77,Default,,0,0,0,,Мен естідім, көрдім.
Dialogue: 0,1:01:32.06,1:01:35.52,Default,,0,0,0,,Қалай болғанда да, мен жердегілердің барлығына естеліктері жойылмай тұрып хабарлауым керек.
Dialogue: 0,1:01:35.65,1:01:36.27,Default,,0,0,0,,Иә
Dialogue: 0,1:01:39.73,1:01:41.15,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:01:41.53,1:01:43.07,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:01:43.70,1:01:44.82,Default,,0,0,0,,Барлығына не болды?
Dialogue: 0,1:01:44.95,1:01:46.82,Default,,0,0,0,,Сіз ұйықтап қалған сияқтысыз.
Dialogue: 0,1:01:53.37,1:01:56.75,Default,,0,0,0,,Лоу мырза, үндеместен кеткенім үшін кешіріңіз.
Dialogue: 0,1:01:56.87,1:01:58.00,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:02:17.15,1:02:19.69,Default,,0,0,0,,Барлығы, кететін уақыт келді.
Dialogue: 0,1:02:21.11,1:02:24.61,Default,,0,0,0,,Бұл үшбұрышты белгі жерге кіреберіс деп есептеледі.
Dialogue: 0,1:02:24.82,1:02:28.07,Default,,0,0,0,,Және бұл ең жақын шығу.
Dialogue: 0,1:02:28.24,1:02:30.07,Default,,0,0,0,,Жердің қай жерінде?
Dialogue: 0,1:02:30.20,1:02:33.58,Default,,0,0,0,,Иә, Солтүстік Америка, мүмкін Канаданың батысы.
Dialogue: 0,1:02:35.20,1:02:39.67,Default,,0,0,0,,Ол үшін біз осы ұлы алқапты кесіп өтуіміз керек.
Dialogue: 0,1:02:40.25,1:02:45.13,Default,,0,0,0,,Динозаврлар шығар, мен олардың не екенін білмеймін, бірақ менің ойымша, әр түрлі заттар бар.
Dialogue: 0,1:02:45.26,1:02:47.97,Default,,0,0,0,,Одан құтыла алмайсың.
Dialogue: 0,1:02:48.84,1:02:49.97,Default,,0,0,0,,Дораемонға барайық
Dialogue: 0,1:03:16.04,1:03:19.50,Default,,0,0,0,,(айқай)
Dialogue: 0,1:03:26.26,1:03:26.92,Default,,0,0,0,,(Динозавр дыбысы)
Dialogue: 0,1:03:27.05,1:03:28.88,Default,,0,0,0,,Иә? Уау, осында!
Dialogue: 0,1:03:36.06,1:03:39.77,Default,,0,0,0,,Тез, тез, мұнда, мұнда, мұнда, тез, тез
Dialogue: 0,1:03:42.73,1:03:44.40,Default,,0,0,0,,Уау, Дораемон, бірдеңе істе.
Dialogue: 0,1:03:44.52,1:03:46.44,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,1:03:53.87,1:03:56.08,Default,,0,0,0,,Сабыр ет... Болды.
Dialogue: 0,1:03:56.20,1:03:58.37,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,1:03:59.16,1:04:01.42,Default,,0,0,0,,Ол күйіктерді суық сумен салқындатып отырған
Dialogue: 0,1:04:02.54,1:04:05.04,Default,,0,0,0,,Бар күшіңді салып жүгір!
Dialogue: 0,1:04:17.01,1:04:23.02,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:04:23.19,1:04:25.40,Default,,0,0,0,,Бұл алқап әлі де жалғаса ма?
Dialogue: 0,1:04:25.52,1:04:28.40,Default,,0,0,0,,А... Менің ойымша, біз қазірдің өзінде шетте қалдық.
Dialogue: 0,1:04:28.53,1:04:30.99,Default,,0,0,0,,Кетер алдында біраз демалып алайық.
Dialogue: 0,1:04:31.36,1:04:33.82,Default,,0,0,0,,Сонда да қарным ашты.
Dialogue: 0,1:04:33.95,1:04:36.95,Default,,0,0,0,,Таңертеңнен бері ештеңе жеген жоқпын.
Dialogue: 0,1:04:37.08,1:04:40.20,Default,,0,0,0,,Иә? Мына жерде қуырылған жұмыртқа бар.
Dialogue: 0,1:04:40.45,1:04:41.62,Default,,0,0,0,,Қайда?
Dialogue: 0,1:04:41.75,1:04:42.71,Default,,0,0,0,,Қараңыз
Dialogue: 0,1:04:42.83,1:04:45.92,Default,,0,0,0,,Идиот, қуырылған жұмыртқа жыпылықтай ма?
Dialogue: 0,1:04:46.29,1:04:47.71,Default,,0,0,0,,Жыпылықтау?
Dialogue: 0,1:04:51.51,1:04:57.35,Default,,0,0,0,,(Нобита мен оның достарының үрейлі дауыстары)
Dialogue: 0,1:04:57.47,1:05:01.43,Default,,0,0,0,,(5 қорқынышты дауыс)
Dialogue: 0,1:05:01.56,1:05:05.10,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,1:05:11.40,1:05:17.41,Default,,0,0,0,,(салтанатты музыка)
Dialogue: 0,1:05:22.16,1:05:28.17,Default,,0,0,0,,(салтанатты музыка)
Dialogue: 0,1:05:44.31,1:05:46.27,Default,,0,0,0,,Әрі қарай не болады?
Dialogue: 0,1:05:46.40,1:05:48.61,Default,,0,0,0,,Оны көргенде білесің. Бұл үлкен той.
Dialogue: 0,1:05:50.73,1:05:53.86,Default,,0,0,0,,Мына үлкен қазанда не қайнап жатырсың?
Dialogue: 0,1:05:54.90,1:05:56.41,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,1:05:56.53,1:05:58.99,Default,,0,0,0,,Аа... (Сунео) Мама, көмектесіңізші!
Dialogue: 0,1:06:06.83,1:06:10.25,Default,,0,0,0,,Мені жесең, мен сені ұрып-соғамын.
Dialogue: 0,1:06:06.83,1:06:10.25,Default,,0,0,0,,Мама Мама
Dialogue: 0,1:06:10.38,1:06:12.00,Default,,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,1:06:12.13,1:06:13.34,Default,,0,0,0,,(сөйлейтін жерасты адамдардың дауысы)
Dialogue: 0,1:06:19.72,1:06:20.97,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,1:06:21.10,1:06:21.89,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,1:06:36.86,1:06:38.16,Default,,0,0,0,,Әй, бұл кеме.
Dialogue: 0,1:06:39.32,1:06:41.83,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,1:06:54.09,1:06:55.38,Default,,0,0,0,,Ах... Ван Хо мырза...
Dialogue: 0,1:06:55.51,1:06:58.43,Default,,0,0,0,,Мен оны жей алмай құтылдым, бірақ...
Dialogue: 0,1:07:03.85,1:07:06.31,Default,,0,0,0,,Біз не істегенімізді білеміз бе?
Dialogue: 0,1:07:06.43,1:07:08.81,Default,,0,0,0,,Сіз тағы да заңсыз иммигранттарсыз.
Dialogue: 0,1:07:09.40,1:07:11.27,Default,,0,0,0,,Бірақ мен сені құтқардым
Dialogue: 0,1:07:11.56,1:07:14.73,Default,,0,0,0,,Мен сені жерге аман-есен қайтаруға уәде бердім.
Dialogue: 0,1:07:15.28,1:07:17.19,Default,,0,0,0,,Осыған қарамастан, сіз қашып кеттіңіз.
Dialogue: 0,1:07:17.90,1:07:20.45,Default,,0,0,0,,Аманатқа қиянат жасау – ең үлкен күнә.
Dialogue: 0,1:07:25.58,1:07:26.70,Default,,0,0,0,,Тіпті егер солай десең де
Dialogue: 0,1:07:26.83,1:07:29.33,Default,,0,0,0,,Бізде мұны істеуден басқа амал қалмады.
Dialogue: 0,1:07:29.79,1:07:32.29,Default,,0,0,0,,Маған «жер бетіндегі адамдарды құртамыз» деген сияқты сөздерді естуге рұқсат етпеңіз.
Dialogue: 0,1:07:32.63,1:07:34.75,Default,,0,0,0,,Не? Мұны кім айтты?
Dialogue: 0,1:07:35.42,1:07:38.76,Default,,0,0,0,,Мен «жердегі әлемді қайтарамыз» деп естідім
Dialogue: 0,1:07:39.13,1:07:43.22,Default,,0,0,0,,Бұл кеме сол шайқасқа барады, солай ма? Баратын жер қайда?
Dialogue: 0,1:07:43.85,1:07:46.10,Default,,0,0,0,,Сізге түсіндірудің қажеті жоқ.
Dialogue: 0,1:07:46.22,1:07:49.23,Default,,0,0,0,,Мен сенің мұрныңды бұдан былай құпияға соғуға жол бермеймін.
Dialogue: 0,1:07:49.35,1:07:51.31,Default,,0,0,0,,Есіңізде болсын.
Dialogue: 0,1:07:52.02,1:07:57.32,Default,,0,0,0,,Күтіңіз Конняро Конняро Мына жерді ашыңыз, ашыңыз!
Dialogue: 0,1:07:57.49,1:07:58.65,Default,,0,0,0,,Бірақ Йотаро-сан бәрі жақсы деді.
Dialogue: 0,1:07:58.99,1:08:01.07,Default,,0,0,0,,(Есікті қағу)
Dialogue: 0,1:08:14.67,1:08:19.42,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:08:25.85,1:08:27.01,Default,,0,0,0,,Бірақ банхо
Dialogue: 0,1:08:27.14,1:08:30.89,Default,,0,0,0,,Жарыстың аман қалуы үшін қасиетті соғыс басталғалы тұрған уақытта.
Dialogue: 0,1:08:31.23,1:08:34.36,Default,,0,0,0,,Оған ауыр жүк тиелген.
Dialogue: 0,1:08:34.48,1:08:37.36,Default,,0,0,0,,Оның үстіне олар белгілі бір мағынада біз динозаврлар сияқты...
Dialogue: 0,1:08:37.48,1:08:39.07,Default,,0,0,0,,Сөзіңізге рахмет, командир.
Dialogue: 0,1:08:39.86,1:08:42.45,Default,,0,0,0,,Бұл қасиетті соғыстағы қарсыластарымыз олар емес.
Dialogue: 0,1:08:43.07,1:08:46.49,Default,,0,0,0,,Жау әлдеқайда үлкен, белгісіз қарсылас.
Dialogue: 0,1:08:47.37,1:08:48.79,Default,,0,0,0,,Жедел жаза – бұл
Dialogue: 0,1:08:48.91,1:08:52.41,Default,,0,0,0,,Бұл мейірімділікті уағыздайтын Құдайдың еркіне қайшы келеді деп ойлаймын.
Dialogue: 0,1:08:53.79,1:08:55.33,Default,,0,0,0,,Бетінде бір атмосфера.
Dialogue: 0,1:08:56.46,1:09:00.84,Default,,0,0,0,,Жарайды, экспедиция аяқталғанша мен оларды сенің қарауыңда қалдырамын.
Dialogue: 0,1:09:10.39,1:09:13.77,Default,,0,0,0,,Мақсатты нүктеге жақындау Көтерілуге дайындалыңыз
Dialogue: 0,1:09:13.94,1:09:15.60,Default,,0,0,0,,Левитация дайын!
Dialogue: 0,1:09:15.73,1:09:21.74,Default,,0,0,0,,(ескерту қоңырауы)
Dialogue: 0,1:09:21.86,1:09:25.16,Default,,0,0,0,,(ескерту қоңырауы)
Dialogue: 0,1:09:25.32,1:09:26.57,Default,,0,0,0,,Бұл қоңырау.
Dialogue: 0,1:09:26.70,1:09:28.12,Default,,0,0,0,,Жер бетінде не болып жатыр?
Dialogue: 0,1:09:57.81,1:09:58.56,Default,,0,0,0,,(5 адам қолдайды)
Dialogue: 0,1:09:58.69,1:09:59.65,Default,,0,0,0,,Жерге шықты
Dialogue: 0,1:10:00.27,1:10:04.53,Default,,0,0,0,,Жерде бұлт, күн, таулар пайда болды.
Dialogue: 0,1:10:05.40,1:10:07.28,Default,,0,0,0,,Жердің қай жерінде?
Dialogue: 0,1:10:07.99,1:10:12.49,Default,,0,0,0,,Әй, бұл таулар... канадалық жартасты таулар.
Dialogue: 0,1:10:12.66,1:10:14.16,Default,,0,0,0,,(Бес адамның айқайы)
Dialogue: 0,1:10:14.29,1:10:15.96,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:10:29.05,1:10:31.85,Default,,0,0,0,,А, ол орман бор орманы екен.
Dialogue: 0,1:10:32.51,1:10:35.64,Default,,0,0,0,,Сондықтан ол тағы да жер астына кетті деп ойлаймын.
Dialogue: 0,1:10:35.77,1:10:38.77,Default,,0,0,0,,Жоқ, олай емес, бұл Жердегі бор кезеңі.
Dialogue: 0,1:10:38.90,1:10:40.81,Default,,0,0,0,,Нағыз бор кезеңі?
Dialogue: 0,1:10:41.27,1:10:44.78,Default,,0,0,0,,Бұл кеме алып уақыт машинасы болды.
Dialogue: 0,1:11:13.18,1:11:14.77,Default,,0,0,0,,Енді түсінікті
Dialogue: 0,1:11:14.89,1:11:18.60,Default,,0,0,0,,Динозаврлар біздің сүтқоректілердің ата-бабаларымызды жоюға ниетті.
Dialogue: 0,1:11:19.65,1:11:22.52,Default,,0,0,0,,Тарихты осылай өзгертуге қалай батылыңыз бар?
Dialogue: 0,1:11:23.15,1:11:24.90,Default,,0,0,0,,Бұл мақсат.
Dialogue: 0,1:11:25.03,1:11:27.49,Default,,0,0,0,,Дәл қазір егеуқұйрықтардан құтылу сияқты.
Dialogue: 0,1:11:27.95,1:11:30.61,Default,,0,0,0,,Бұл қарудың бәрі осы ма?
Dialogue: 0,1:11:30.74,1:11:32.45,Default,,0,0,0,,Сенгісіз
Dialogue: 0,1:11:32.70,1:11:33.83,Default,,0,0,0,,Кез келген жағдайда—
Dialogue: 0,1:11:33.95,1:11:36.45,Default,,0,0,0,,Мен олардың бетін қайтаруға тырысатынына сенімдімін.
Dialogue: 0,1:11:43.67,1:11:46.71,Default,,0,0,0,,Жарайды, әзірше мына кемеден қашайық.
Dialogue: 0,1:11:46.84,1:11:49.30,Default,,0,0,0,,Бірақ түн батқаннан кейін ғана.
Dialogue: 0,1:11:49.43,1:11:51.55,Default,,0,0,0,,О? комета
Dialogue: 0,1:11:51.68,1:11:55.14,Default,,0,0,0,,Күн әлі күн болса да, анық...
Dialogue: 0,1:12:05.65,1:12:07.78,Default,,0,0,0,,Біз де жеттік
Dialogue: 0,1:12:07.90,1:12:13.82,Default,,0,0,0,,Мен динозаврлар тайпасын жер астына ығыстырған апаттың алдында қайтып келдім.
Dialogue: 0,1:12:14.28,1:12:16.70,Default,,0,0,0,,Апаттың астарында жатқан шындық белгісіз
Dialogue: 0,1:12:16.83,1:12:20.66,Default,,0,0,0,,Бірақ бұл уақытта бүкіл жер бетіндегі динозаврлар—
Dialogue: 0,1:12:20.79,1:12:25.38,Default,,0,0,0,,Олардың жойылғаны бұлтартпас ақиқат.
Dialogue: 0,1:12:25.50,1:12:29.30,Default,,0,0,0,,Мұндай қайғылы жағдайды жай ғана табиғи құбылыс қалай тудыруы мүмкін?
Dialogue: 0,1:12:29.42,1:12:30.72,Default,,0,0,0,,Өте ойға келмейтін
Dialogue: 0,1:12:31.80,1:12:36.18,Default,,0,0,0,,Жындық күші зор біреу...
Dialogue: 0,1:12:36.31,1:12:38.64,Default,,0,0,0,,Өтіңіз!
Dialogue: 0,1:12:38.93,1:12:39.60,Default,,0,0,0,,Міне!
Dialogue: 0,1:12:39.73,1:12:43.02,Default,,0,0,0,,Ғарыштан келген басқыншылар біздің жұмаққа басып кірген шығар...
Dialogue: 0,1:12:43.35,1:12:45.52,Default,,0,0,0,,Ол толығымен жойылды деп болжануда.
Dialogue: 0,1:12:46.02,1:12:48.48,Default,,0,0,0,,Жат планеталық немесе жын болса да...
Dialogue: 0,1:12:48.69,1:12:52.95,Default,,0,0,0,,Мұндай қастандыққа Құдай разы болмайды.
Dialogue: 0,1:12:53.41,1:12:56.87,Default,,0,0,0,,Басталғалы тұрған шайқас – қасиетті соғыс.
Dialogue: 0,1:12:57.20,1:12:59.87,Default,,0,0,0,,Жеңіске өзіңізді ынталандырыңыз
Dialogue: 0,1:13:00.04,1:13:03.29,Default,,0,0,0,,«Меро-Меро Ганнан» атылатын нәрсе – «махаббат күші»
Dialogue: 0,1:13:03.96,1:13:07.54,Default,,0,0,0,,Құдай айдаһардың балаларын жарылқасын
Dialogue: 0,1:13:07.75,1:13:11.84,Default,,0,0,0,,«Меро-Меро Ганнан» атылатын нәрсе – «махаббат күші»
Dialogue: 0,1:13:12.59,1:13:14.64,Default,,0,0,0,,Иә? Комета...
Dialogue: 0,1:13:14.97,1:13:17.39,Default,,0,0,0,,Мен білмей тұрып, ол соншалықты үлкен болды ...
Dialogue: 0,1:13:19.06,1:13:19.97,Default,,0,0,0,,Ха!
Dialogue: 0,1:13:20.72,1:13:22.02,Default,,0,0,0,,Абай бол, ЖоЖо
Dialogue: 0,1:13:22.68,1:13:24.52,Default,,0,0,0,,Шизука-чан тез
Dialogue: 0,1:13:25.81,1:13:30.90,Default,,0,0,0,,(Дабыл)
Dialogue: 0,1:13:31.11,1:13:32.95,Default,,0,0,0,,Дораэмон Takecopter туралы не деуге болады?
Dialogue: 0,1:13:33.07,1:13:34.20,Default,,0,0,0,,Қазіргі уақытта зарядталуда
Dialogue: 0,1:13:34.32,1:13:34.95,Default,,0,0,0,,Иә?
Dialogue: 0,1:13:35.07,1:13:41.08,Default,,0,0,0,,(Дабыл)
Dialogue: 0,1:13:44.16,1:13:46.38,Default,,0,0,0,,Енді жоқ, Дораемон
Dialogue: 0,1:13:46.50,1:13:47.17,Default,,0,0,0,,Ахх
Dialogue: 0,1:13:47.42,1:13:48.79,Default,,0,0,0,,Нобита-кун
Dialogue: 0,1:13:49.04,1:13:50.88,Default,,0,0,0,,Мешіт гранатасы!
Dialogue: 0,1:13:51.38,1:13:52.05,Default,,0,0,0,,Ei
Dialogue: 0,1:13:52.97,1:13:57.30,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:14:05.77,1:14:07.19,Default,,0,0,0,,Не? Оның қашып кетуіне жол бердіңіз бе?
Dialogue: 0,1:14:07.69,1:14:10.65,Default,,0,0,0,,Кешіріңіз, мен сізді бала деп ойладым, бірақ...
Dialogue: 0,1:14:11.07,1:14:13.99,Default,,0,0,0,,Сылтау жоқ, қандай бала.
Dialogue: 0,1:14:14.11,1:14:17.61,Default,,0,0,0,,Олардың қорқынышты қарулары жоқ па?
Dialogue: 0,1:14:17.87,1:14:21.58,Default,,0,0,0,,Динозаврларды жойған солар болуы мүмкін бе?
Dialogue: 0,1:14:21.87,1:14:23.00,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:14:23.95,1:14:28.04,Default,,0,0,0,,Жоқ, білмеймін. Сіз тағы қандай қорқынышты қаруды қолданғыңыз келеді?
Dialogue: 0,1:14:28.17,1:14:29.96,Default,,0,0,0,,Келетінін білмеймін.
Dialogue: 0,1:14:47.35,1:14:49.65,Default,,0,0,0,,Қанша болса да тым көзге түседі.
Dialogue: 0,1:14:49.77,1:14:52.94,Default,,0,0,0,,Жарайды, бәрібір табыласың.
Dialogue: 0,1:14:53.36,1:14:57.15,Default,,0,0,0,,Қуғыншылар жақындап қалды, жақында бізді қоршап алады.
Dialogue: 0,1:14:57.28,1:14:59.32,Default,,0,0,0,,Ұрыспас бұрын сөйлесе аламыз ба?
Dialogue: 0,1:14:59.62,1:15:01.78,Default,,0,0,0,,Бұл сатылған жекпе-жек, тартынба...
Dialogue: 0,1:15:01.91,1:15:03.33,Default,,0,0,0,,Жасайық!
Dialogue: 0,1:15:03.45,1:15:04.24,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,1:15:16.67,1:15:19.68,Default,,0,0,0,,Егер бұлай болса, мен енді ешқандай рақым көрсетпеймін. Мені атып таста!
Dialogue: 0,1:15:19.80,1:15:23.76,Default,,0,0,0,,Біріншіден, аяқтарыңыздың астындағы қорапқа қараңыздар
Dialogue: 0,1:15:23.89,1:15:26.23,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:15:26.35,1:15:30.15,Default,,0,0,0,,Жарайды, бұл қамалдың тосқауылын бұзу қиын.
Dialogue: 0,1:15:30.27,1:15:34.53,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:15:34.65,1:15:36.11,Default,,0,0,0,,О? Комета...
Dialogue: 0,1:15:36.24,1:15:37.78,Default,,0,0,0,,Қазір емес.
Dialogue: 0,1:15:37.90,1:15:38.57,Default,,0,0,0,,Өйткені...
Dialogue: 0,1:15:39.07,1:15:40.53,Default,,0,0,0,,Қайтадан жақындау
Dialogue: 0,1:15:40.66,1:15:41.32,Default,,0,0,0,,Майор аман-есен!
Dialogue: 0,1:15:41.45,1:15:44.28,Default,,0,0,0,,(рыцарлардың ұрыс айқайы)
Dialogue: 0,1:15:44.62,1:15:46.25,Default,,0,0,0,,Аа, міне, осында.
Dialogue: 0,1:15:46.37,1:15:49.08,Default,,0,0,0,,Дораэмон, тез, тез гранатаны лақтыр!
Dialogue: 0,1:15:49.33,1:15:51.21,Default,,0,0,0,,Жарайды, солай.
Dialogue: 0,1:15:54.80,1:15:56.26,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:15:56.38,1:16:00.84,Default,,0,0,0,,Ешқандай болмаңыз! Мұндай нәрсе зиянсыз, тек дыбыс пен түтін.
Dialogue: 0,1:16:01.34,1:16:05.76,Default,,0,0,0,,(рыцарлардың ұрыс айқайы)
Dialogue: 0,1:16:07.93,1:16:10.14,Default,,0,0,0,,Не? Тек солай істей бер!
Dialogue: 0,1:16:12.19,1:16:13.90,Default,,0,0,0,,Басқа ештеңе жоқ па?
Dialogue: 0,1:16:14.31,1:16:18.78,Default,,0,0,0,,Бұл блеф базука, қауіп төндіретін зымыран, жалған мылтық
Dialogue: 0,1:16:18.90,1:16:20.90,Default,,0,0,0,,Көп нәрсе сенімсіз болып көрінеді
Dialogue: 0,1:16:21.03,1:16:21.91,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,1:16:26.99,1:16:28.91,Default,,0,0,0,,Ах... Дораемон осында.
Dialogue: 0,1:16:29.04,1:16:30.87,Default,,0,0,0,,Аспан мен жердің кері майы!
Dialogue: 0,1:16:31.46,1:16:32.33,Default,,0,0,0,,Не болады?
Dialogue: 0,1:16:32.46,1:16:33.33,Default,,0,0,0,,Ал, қараңдаршы.
Dialogue: 0,1:16:33.46,1:16:35.04,Default,,0,0,0,,(рыцарлардың үрейлі дауыстары)
Dialogue: 0,1:16:35.25,1:16:37.42,Default,,0,0,0,,(Рыцарлардың айқайы)
Dialogue: 0,1:16:41.47,1:16:43.76,Default,,0,0,0,,(Джан, Сунео және Нобитаның қуанышты дауыстары)
Dialogue: 0,1:16:44.47,1:16:46.10,Default,,0,0,0,,Қандай күшті қарсылас!
Dialogue: 0,1:16:46.22,1:16:47.72,Default,,0,0,0,,Қоршау мұнарасын тасымалдау
Dialogue: 0,1:16:54.02,1:16:55.61,Default,,0,0,0,,Бұл жолы аяқталды
Dialogue: 0,1:16:58.69,1:17:00.40,Default,,0,0,0,,Дорэмон, не болып жатыр?
Dialogue: 0,1:17:03.45,1:17:05.16,Default,,0,0,0,,Ха, тезірек бірдеңе берші.
Dialogue: 0,1:17:05.28,1:17:08.04,Default,,0,0,0,,Асықпа, қай жерде не бар?
Dialogue: 0,1:17:08.16,1:17:09.37,Default,,0,0,0,,Барлығына! Ахх
Dialogue: 0,1:17:09.49,1:17:10.58,Default,,0,0,0,,Шизука-чан?
Dialogue: 0,1:17:11.50,1:17:12.58,Default,,0,0,0,,Комета...
Dialogue: 0,1:17:13.00,1:17:14.04,Default,,0,0,0,,Біз соқтығысамыз
Dialogue: 0,1:17:20.30,1:17:20.96,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:17:21.13,1:17:21.97,Default,,0,0,0,,(рыцарлардың шуы)
Dialogue: 0,1:17:24.13,1:17:25.51,Default,,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,1:17:35.10,1:17:37.36,Default,,0,0,0,,Не болады...?
Dialogue: 0,1:17:37.48,1:17:38.61,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,1:17:50.12,1:17:54.92,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:17:59.13,1:18:00.42,Default,,0,0,0,,Шизука-чан, күте тұр!
Dialogue: 0,1:18:00.55,1:18:03.17,Default,,0,0,0,,Нобита-сан! Уау!
Dialogue: 0,1:18:04.05,1:18:04.72,Default,,0,0,0,,(Ванिला Айс) Абдурды ұсақ-түйекке айналдырды.
Dialogue: 0,1:18:08.18,1:18:12.47,Default,,0,0,0,,(Рыцарлардың айқайы)
Dialogue: 0,1:18:13.64,1:18:15.52,Default,,0,0,0,,Тыныш болыңыз және үрейленбеңіз
Dialogue: 0,1:18:16.02,1:18:17.98,Default,,0,0,0,,Бұл бөгде планеталық шабуыл болуы мүмкін.
Dialogue: 0,1:18:18.73,1:18:20.94,Default,,0,0,0,,Бунго Бунго
Dialogue: 0,1:18:21.27,1:18:23.65,Default,,0,0,0,,А? (Легион командирі) Корпусты жинап, кемеге оралыңыз.
Dialogue: 0,1:18:23.99,1:18:25.45,Default,,0,0,0,,Бірақ жау...
Dialogue: 0,1:18:25.57,1:18:29.74,Default,,0,0,0,,Теңізге қарашы, бұл цунами. Сіз мұны геологиядан үйренбедіңіз бе?
Dialogue: 0,1:18:29.99,1:18:32.04,Default,,0,0,0,,Асықпасаң, құрып кетесің.
Dialogue: 0,1:18:35.12,1:18:41.13,Default,,0,0,0,,(Цунами гуілі)
Dialogue: 0,1:18:43.55,1:18:49.55,Default,,0,0,0,,(цунами гуіл)
Dialogue: 0,1:18:52.35,1:18:55.14,Default,,0,0,0,,(Цунами гуілі)
Dialogue: 0,1:18:55.56,1:18:56.73,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,1:18:56.85,1:18:59.31,Default,,0,0,0,,Үлкен цунами келе жатыр. Тауға жүгіріңіз.
Dialogue: 0,1:18:59.44,1:19:00.65,Default,,0,0,0,,Жоқ, мен уақытында үлгермеймін.
Dialogue: 0,1:19:05.78,1:19:07.45,Default,,0,0,0,,Асығыңыз, асығыңыз!
Dialogue: 0,1:19:12.66,1:19:14.37,Default,,0,0,0,,Поп жертөле!
Dialogue: 0,1:19:15.16,1:19:18.42,Default,,0,0,0,,Кейін түсіндіремін, бірақ әзірше мына жер астына көміңіз.
Dialogue: 0,1:19:18.54,1:19:19.62,Default,,0,0,0,,Жарайды
Dialogue: 0,1:19:27.26,1:19:28.30,Default,,0,0,0,,Жарайды
Dialogue: 0,1:19:28.59,1:19:31.09,Default,,0,0,0,,(Цунами гуілі)
Dialogue: 0,1:19:31.51,1:19:32.89,Default,,0,0,0,,Өлшем түрлендіргіші іске қосылды!
Dialogue: 0,1:19:41.90,1:19:47.49,Default,,0,0,0,,(Цунами гуілі)
Dialogue: 0,1:19:56.24,1:19:58.00,Default,,0,0,0,,Дораэмон тез жарайды
Dialogue: 0,1:19:59.00,1:20:00.21,Default,,0,0,0,,(жұмыс дыбысы)
Dialogue: 0,1:20:00.58,1:20:02.13,Default,,0,0,0,,Тез жертөлеге барыңыз
Dialogue: 0,1:20:03.96,1:20:04.59,Default,,0,0,0,,Айт
Dialogue: 0,1:20:04.71,1:20:06.13,Default,,0,0,0,,Оған көмектесу мүмкін емес, қараңыз.
Dialogue: 0,1:20:06.42,1:20:07.38,Default,,0,0,0,,Міне.
Dialogue: 0,1:20:34.12,1:20:36.16,Default,,0,0,0,,Бұл қауіпті болды. Барлығы қауіпсіз бе?
Dialogue: 0,1:20:36.28,1:20:37.29,Default,,0,0,0,,Мен осындамын
Dialogue: 0,1:20:37.41,1:20:38.04,Default,,0,0,0,,Мен осындамын
Dialogue: 0,1:20:38.16,1:20:38.79,Default,,0,0,0,,Жоспар
Dialogue: 0,1:20:38.91,1:20:41.00,Default,,0,0,0,,Әй, бәрі қайда?
Dialogue: 0,1:20:41.12,1:20:43.54,Default,,0,0,0,,Жарық Нобита-кунға жетпейді.
Dialogue: 0,1:20:43.92,1:20:47.25,Default,,0,0,0,,Сіз ақымақ үлкен жертөле жасаған сияқтысыз.
Dialogue: 0,1:20:47.38,1:20:51.38,Default,,0,0,0,,Нобита-кун, қозғалма, сонда күт.
Dialogue: 0,1:20:51.51,1:20:54.14,Default,,0,0,0,,Өйткені ол жарқырайды
Dialogue: 0,1:20:55.26,1:21:00.52,Default,,0,0,0,,(Takecopter ұшу дыбысы)
Dialogue: 0,1:21:01.31,1:21:02.39,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,1:21:02.73,1:21:05.44,Default,,0,0,0,,Иә? Бұл жертөле ме?
Dialogue: 0,1:21:05.56,1:21:06.69,Default,,0,0,0,,Қанша?
Dialogue: 0,1:21:06.82,1:21:08.94,Default,,0,0,0,,Хоккайдоның айналасында болса керек
Dialogue: 0,1:21:09.07,1:21:10.94,Default,,0,0,0,,Иә! Хоккайдо?
Dialogue: 0,1:21:11.07,1:21:14.70,Default,,0,0,0,,Мен асығыс болғандықтан, өлшемін ойламадым.
Dialogue: 0,1:21:14.82,1:21:18.08,Default,,0,0,0,,Эй, Дораемон, сенде жер асты картасы бар, солай ма? Маған көрсет
Dialogue: 0,1:21:18.20,1:21:19.33,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:21:20.25,1:21:23.33,Default,,0,0,0,,Әй, мына жертөле киелі жер емес пе?
Dialogue: 0,1:21:23.67,1:21:25.38,Default,,0,0,0,,Орналасуы мен көлемі тамаша.
Dialogue: 0,1:21:25.58,1:21:26.29,Default,,0,0,0,,Жарай берсін…
Dialogue: 0,1:21:26.42,1:21:27.63,Default,,0,0,0,,Айтып тұрғасын...
Dialogue: 0,1:21:27.75,1:21:32.51,Default,,0,0,0,,Иә, бұл керемет! Дораемон киелі орынды салды.
Dialogue: 0,1:22:03.58,1:22:07.33,Default,,0,0,0,,Жағадан 100 км-ге дейін мейірімсіз... атты әскер
Dialogue: 0,1:22:07.46,1:22:09.75,Default,,0,0,0,,Мені тамырымен жұлып, толқын алып кеткендей.
Dialogue: 0,1:22:10.42,1:22:12.80,Default,,0,0,0,,Әйтеуір, бұл біртүрлі қараңғылық туралы не ойлайсың?
Dialogue: 0,1:22:12.92,1:22:15.05,Default,,0,0,0,,Түн әлдеқашан атқан болса да
Dialogue: 0,1:22:16.68,1:22:17.68,Default,,0,0,0,,Ха!
Dialogue: 0,1:22:18.97,1:22:20.14,Default,,0,0,0,,Міне!
Dialogue: 0,1:22:23.85,1:22:26.98,Default,,0,0,0,,Сонда бәрі сол құйрықты жұлдыздың кесірінен болды дейсіз бе?
Dialogue: 0,1:22:27.10,1:22:31.02,Default,,0,0,0,,Тынық мұхитына диаметрі 10 км құйрықты жұлдыз түседі.
Dialogue: 0,1:22:31.15,1:22:33.86,Default,,0,0,0,,Биіктігі 1000 метрден асатын үлкен цунамиді тудыру —
Dialogue: 0,1:22:34.24,1:22:38.37,Default,,0,0,0,,Мұхит түбінен теңіз суы мен шөгінділерді атмосферадан шығарды.
Dialogue: 0,1:22:38.95,1:22:41.20,Default,,0,0,0,,Сома шамамен 1 миллиард тоннаны құрайды
Dialogue: 0,1:22:41.33,1:22:45.79,Default,,0,0,0,,Ол ауада шаңға айналып, жер бетін түгел жабады.
Dialogue: 0,1:22:46.04,1:22:49.71,Default,,0,0,0,,Күнді жауып, күндіз де қараңғы етеді.
Dialogue: 0,1:22:50.88,1:22:52.88,Default,,0,0,0,,Қорқынышты табиғи апат.
Dialogue: 0,1:22:53.00,1:22:55.67,Default,,0,0,0,,Бірақ бәрі бітті емес пе?
Dialogue: 0,1:22:56.09,1:22:59.18,Default,,0,0,0,,Жоқ, нағыз апат әлі алда.
Dialogue: 0,1:22:59.30,1:23:00.68,Default,,0,0,0,,Компьютерлік есептеулерде—
Dialogue: 0,1:23:01.30,1:23:05.02,Default,,0,0,0,,Шаңның түсуіне бірнеше ай қажет.
Dialogue: 0,1:23:05.14,1:23:10.23,Default,,0,0,0,,Нәтижесінде ауа температурасы 40 градусқа төмендеп, қатты жаңбыр жалғасты.
Dialogue: 0,1:23:10.36,1:23:14.19,Default,,0,0,0,,Ағаштар мен шөптер қурап, мұхиттағы планктон өледі.
Dialogue: 0,1:23:14.32,1:23:17.36,Default,,0,0,0,,Оны жеу арқылы өмір сүрген тіршілік иелерінің көпшілігі...
Dialogue: 0,1:23:17.49,1:23:21.95,Default,,0,0,0,,Ол алдағы алты ай ішінде жойылады.
Dialogue: 0,1:23:25.54,1:23:27.29,Default,,0,0,0,,Бұл ешкім үшін емес—
Dialogue: 0,1:23:27.41,1:23:30.96,Default,,0,0,0,,Тағдыр ғой, біз ештеңе істей алмаймыз.
Dialogue: 0,1:23:33.00,1:23:39.01,Default,,0,0,0,,(Динозаврлардың жылауы)
Dialogue: 0,1:23:43.56,1:23:45.56,Default,,0,0,0,,Уф, бір ғана комета...
Dialogue: 0,1:23:45.81,1:23:48.98,Default,,0,0,0,,Құдайдың осындай жауыздық жасайтыны...
Dialogue: 0,1:23:49.73,1:23:52.65,Default,,0,0,0,,Құдайдың ісін тоқтатпа.
Dialogue: 0,1:23:52.77,1:23:54.98,Default,,0,0,0,,Бұл терең есте сақтаудың арқасында болса керек.
Dialogue: 0,1:23:56.03,1:24:01.57,Default,,0,0,0,,Динозаврлардың жойылуы – Құдайдың бұйырған әні. Егер бұл тағдыр болса, біз оған бағынуымыз керек.
Dialogue: 0,1:24:03.66,1:24:06.41,Default,,0,0,0,,Жоқ, қанша болса да, тым көп.
Dialogue: 0,1:24:06.54,1:24:07.16,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:08.46,1:24:12.46,Default,,0,0,0,,Енді мен мүмкіндігінше көп динозаврларды құтқарғым келеді.
Dialogue: 0,1:24:30.02,1:24:31.94,Default,,0,0,0,,Шизука-чан осында болды.
Dialogue: 0,1:24:32.06,1:24:32.94,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:33.48,1:24:35.77,Default,,0,0,0,,Шизука-чан, тез, тез, тез
Dialogue: 0,1:24:38.49,1:24:39.11,Default,,0,0,0,,Иә
Dialogue: 0,1:24:41.45,1:24:44.91,Default,,0,0,0,,Жарайды, жақсы бала, жағаға шық.
Dialogue: 0,1:24:47.70,1:24:50.75,Default,,0,0,0,,Momotaro маркалы тары тұшпара тиімді.
Dialogue: 0,1:24:53.29,1:24:55.75,Default,,0,0,0,,Кәне, бәріміз, жағаға бет алыңдар.
Dialogue: 0,1:24:56.04,1:24:57.42,Default,,0,0,0,,Тыныш болыңыз
Dialogue: 0,1:24:57.55,1:25:00.34,Default,,0,0,0,,Осылайша қатардан шықпаңыз.
Dialogue: 0,1:25:13.52,1:25:15.06,Default,,0,0,0,,Келіңдер, келіңдер.
Dialogue: 0,1:25:15.19,1:25:17.32,Default,,0,0,0,,Міне, сіз бұдан былай өмір сүресіз.
Dialogue: 0,1:25:17.73,1:25:20.90,Default,,0,0,0,,Жылы, жарық, тамақ көп.
Dialogue: 0,1:25:21.03,1:25:22.78,Default,,0,0,0,,Қош келдіңіз, қош келдіңіз.
Dialogue: 0,1:25:24.32,1:25:27.78,Default,,0,0,0,,Күн сәулесі мүк болса, күн сәулесі жеткілікті.
Dialogue: 0,1:25:27.91,1:25:32.79,Default,,0,0,0,,Сондай-ақ жер асты суынан өзен жасап, теңіз суын мол тартып алдық.
Dialogue: 0,1:25:32.91,1:25:36.50,Default,,0,0,0,,Ағаш пен шөптің көп түрі отырғызылады.
Dialogue: 0,1:25:37.21,1:25:39.30,Default,,0,0,0,,«Неге бұл мүмкін болды?»
Dialogue: 0,1:25:39.42,1:25:43.13,Default,,0,0,0,,Хехе, мен сізге өз құралдарым туралы толық түсініктеме бермеймін.
Dialogue: 0,1:25:43.30,1:25:46.39,Default,,0,0,0,,Әйтеуір, осында қоныстанған динозаврлар...
Dialogue: 0,1:25:46.51,1:25:49.10,Default,,0,0,0,,Сіз ұзақ өмір сүруіңіз керек
Dialogue: 0,1:25:49.31,1:25:51.18,Default,,0,0,0,,Дәл ойлағанымдай
Dialogue: 0,1:25:51.31,1:25:53.27,Default,,0,0,0,,Құтқару операциясы аяқталды
Dialogue: 0,1:25:53.39,1:25:54.64,Default,,0,0,0,,Сізге жақсы
Dialogue: 0,1:25:55.73,1:25:59.98,Default,,0,0,0,,Расында, сендер Құдайдың елшілері болуың керек.
Dialogue: 0,1:26:00.19,1:26:01.99,Default,,0,0,0,,Иә, солай істеңіз.
Dialogue: 0,1:26:02.11,1:26:04.90,Default,,0,0,0,,Біз қолымыздан келгенін жасадық.
Dialogue: 0,1:26:05.03,1:26:08.24,Default,,0,0,0,,Эй, сен мұны естідің бе? Біз Құдайдың елшілеріміз
Dialogue: 0,1:26:08.37,1:26:11.08,Default,,0,0,0,,Сіз Сашизуме Ханагамидің тапсырмасысыз, солай ма?
Dialogue: 0,1:26:11.20,1:26:13.00,Default,,0,0,0,,Хмф, мен Джанды жек көремін!
Dialogue: 0,1:26:13.12,1:26:18.13,Default,,0,0,0,,Уфуфуфу... (Нобита) Ахахахахаха
Dialogue: 0,1:26:43.19,1:26:49.20,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,1:26:53.20,1:26:59.88,Default,,0,0,0,,Енді бәрі түсінікті, бәрі Алланың ісі
Dialogue: 0,1:27:00.00,1:27:03.50,Default,,0,0,0,,Басқаша айтқанда, бала динозаврлар жер астында гүлденуі керек.
Dialogue: 0,1:27:03.63,1:27:07.18,Default,,0,0,0,,Бұл Құдайдың қалауы болды
Dialogue: 0,1:27:07.59,1:27:09.39,Default,,0,0,0,,Біз жалғастырамыз:
Dialogue: 0,1:27:09.51,1:27:13.89,Default,,0,0,0,,Бұл жер асты елін өмір сүруге қолайлы және гүлденген әлемге айналдыру —
Dialogue: 0,1:27:14.10,1:27:16.85,Default,,0,0,0,,Сіз күш-жігеріңізде ешқашан әлсіремеуіңіз керек.
Dialogue: 0,1:27:16.98,1:27:19.81,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,1:27:20.81,1:27:23.73,Default,,0,0,0,,Айдаһардың балалары бақытты
Dialogue: 0,1:27:23.86,1:27:26.74,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,1:27:27.03,1:27:29.57,Default,,0,0,0,,Құдайдың балалары бақытты
Dialogue: 0,1:27:29.78,1:27:35.79,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,1:28:04.69,1:28:07.32,Default,,0,0,0,,Бұл шынымен де тамаша саяхат болды.
Dialogue: 0,1:28:07.69,1:28:10.28,Default,,0,0,0,,Дос болып қалар едік.
Dialogue: 0,1:28:10.66,1:28:14.74,Default,,0,0,0,,Уақытында емін-еркін келіп-кетеріңізге сенімдімін.
Dialogue: 0,1:28:15.62,1:28:18.08,Default,,0,0,0,,Онда мен сізге міндетті түрде келемін.
Dialogue: 0,1:28:18.50,1:28:20.50,Default,,0,0,0,,Ондай жағдайда мен сізге бағыт-бағдар беремін.
Dialogue: 0,1:28:20.62,1:28:22.71,Default,,0,0,0,,Өйткені, бізде ғажайып машина бар.
Dialogue: 0,1:28:22.83,1:28:23.96,Default,,0,0,0,,Тағы да~
Dialogue: 0,1:28:24.54,1:28:30.88,Default,,0,0,0,,Рахмет, бірақ мен осы әдемі аспанда ұшқым келеді.
Dialogue: 0,1:28:42.94,1:28:44.44,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,1:28:44.56,1:28:45.73,Default,,0,0,0,,Қош бол
Dialogue: 0,1:28:45.86,1:28:47.69,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,1:28:47.82,1:28:51.03,Default,,0,0,0,,Ах! Жүр, мен сахналық киімімді ұмытып кетіппін.
Dialogue: 0,1:28:51.15,1:28:52.16,Default,,0,0,0,,Әй, менің радиобасқаруым
Dialogue: 0,1:28:52.28,1:28:54.07,Default,,0,0,0,,Әй, менің қымбат скрипкам
Dialogue: 0,1:28:54.20,1:28:57.08,Default,,0,0,0,,Мен сіздің жүгіңізді кейін жіберемін.
Dialogue: 0,1:28:57.20,1:29:00.16,Default,,0,0,0,,Рахмет
Dialogue: 0,1:29:01.16,1:29:04.92,Default,,0,0,0,,(Ұзатуға шыққан бес адамның дауысы)
Dialogue: 0,1:29:05.29,1:29:08.38,Default,,0,0,0,,А, маған менікі жіберудің қажеті жоқ.
Dialogue: 0,1:29:08.59,1:29:10.63,Default,,0,0,0,,Әй, эй! Ван Хо мырза
Dialogue: 0,1:29:10.76,1:29:11.92,Default,,0,0,0,,Нобита-кун Нобита-кун
Dialogue: 0,1:29:12.68,1:29:14.43,Default,,0,0,0,,Жақсы емес пе? Жарайды емес пе?
Dialogue: 0,1:29:14.55,1:29:15.85,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:29:19.47,1:29:25.48,Default,,0,0,0,,♪〜
Dialogue: 0,1:30:41.22,1:30:47.23,Default,,0,0,0,,〜♪
