Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.65,0:00:26.94,Default,,0,0,0,,♪♪～
Dialogue: 0,0:00:27.03,0:00:50.54,Default,,0,0,0,,♪♪～
Dialogue: 0,0:00:56.05,0:01:07.90,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:08.63,0:02:37.63,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:50.54,0:02:54.54,Default,,0,0,0,,Ал, өзімді таныстырып өтейін.
Dialogue: 0,0:02:54.55,0:02:56.55,Default,,0,0,0,,Ашықағали.
Dialogue: 0,0:02:58.55,0:03:02.56,Default,,0,0,0,,Аа~ Ижай мырза, атын былай қойғанда...
Dialogue: 0,0:03:02.56,0:03:06.56,Default,,0,0,0,,Ах, кешіріңіз! Анау Кагаридің сөйлегені сонша...
Dialogue: 0,0:03:06.56,0:03:08.56,Default,,0,0,0,,Өте әдемі! (Оқушы) Эй →
Dialogue: 0,0:03:08.56,0:03:13.57,Default,,0,0,0,,Сіз Нозоми Сасакиге ұқсамайсыз ба? (Оқушы) Олар бір-біріне ұқсайды! Шынымен ұқсас!
Dialogue: 0,0:03:13.57,0:03:15.57,Default,,0,0,0,,Ой!
Dialogue: 0,0:03:15.57,0:03:17.57,Default,,0,0,0,,Не? Не...
Dialogue: 0,0:03:17.57,0:03:19.57,Default,,0,0,0,,Өте сүйкімді! (Оқушы) Ал тіл қандай улы!
Dialogue: 0,0:03:19.57,0:03:23.58,Default,,0,0,0,,Иә! (Студент) Иә. Иә Иә!
Dialogue: 0,0:03:23.58,0:03:26.58,Default,,0,0,0,,Эй, эй, Кагари-сан шашын бояй ма?
Dialogue: 0,0:03:26.58,0:03:28.58,Default,,0,0,0,,Бум бум! Күміс шыбын!
Dialogue: 0,0:03:28.58,0:03:30.59,Default,,0,0,0,,Кяа~ «Күміс шыбын»!
Dialogue: 0,0:03:30.59,0:03:32.59,Default,,0,0,0,,Мен таң қалдым. →
Dialogue: 0,0:03:32.59,0:03:34.59,Default,,0,0,0,,Сіз сыныпқа тез бейімделесіз.
Dialogue: 0,0:03:34.59,0:03:37.59,Default,,0,0,0,,Иә. Мен шынымен таң қалдым.
Dialogue: 0,0:03:37.59,0:03:40.60,Default,,0,0,0,,Тіпті мектепке барғысы келетінін айтады.
Dialogue: 0,0:03:40.60,0:03:42.60,Default,,0,0,0,,Уау, бұл кенеттен пайда болды.
Dialogue: 0,0:03:42.60,0:03:46.54,Default,,0,0,0,,Сенгісіз. Кенеттен не болды?
Dialogue: 0,0:03:46.54,0:03:48.54,Default,,0,0,0,,Сезіміңді түсінемін, Йоми.
Dialogue: 0,0:03:50.54,0:03:52.54,Default,,0,0,0,,Иә.
Dialogue: 0,0:03:52.54,0:03:54.54,Default,,0,0,0,,Уфуфу…. ≪Мато!
Dialogue: 0,0:03:54.54,0:03:56.55,Default,,0,0,0,,Ю? Мектеп осында!
Dialogue: 0,0:03:56.55,0:03:59.55,Default,,0,0,0,,Рас! ? Кешіріңіз, Йоми, мен сәлден кейін барамын!
Dialogue: 0,0:03:59.55,0:04:01.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:03.55,0:04:05.55,Default,,0,0,0,,《Сол екі адамның арқасы...→
Dialogue: 0,0:04:05.55,0:04:08.56,Default,,0,0,0,,Мен үнемі бір нәрсені бақылап тұрғандай сезінемін.
Dialogue: 0,0:04:08.56,0:04:10.56,Default,,0,0,0,,Жеңіл созылу.
Dialogue: 0,0:04:10.56,0:04:13.56,Default,,0,0,0,,Мен таң қалдым, себебі мен еш қимылсыз құладым.
Dialogue: 0,0:04:13.56,0:04:15.56,Default,,0,0,0,,Мен әлі таң қалдым!
Dialogue: 0,0:04:15.56,0:04:18.57,Default,,0,0,0,,Созылу салдарынан есін жоғалту сирек кездеседі.
Dialogue: 0,0:04:18.57,0:04:20.57,Default,,0,0,0,,Бұл біреудің ісі сияқты.
Dialogue: 0,0:04:20.57,0:04:23.57,Default,,0,0,0,,Жақсы. Керемет, Кохатчи-сенпай...
Dialogue: 0,0:04:23.57,0:04:28.58,Default,,0,0,0,,Жақсы, шынымен, жақсымын. Хахаха!
Dialogue: 0,0:04:28.58,0:04:31.58,Default,,0,0,0,,Торима, мен алдын ала турға қатыса алмауым мүмкін →
Dialogue: 0,0:04:31.58,0:04:34.58,Default,,0,0,0,,Маған бұл жігіт алдын ала тапсыру үшін бірдеңе жасауы керек.
Dialogue: 0,0:04:34.58,0:04:36.59,Default,,0,0,0,,Өтінемін, Кохатчи. →
Dialogue: 0,0:04:36.59,0:04:39.59,Default,,0,0,0,,Сен болмасаң, біздің клуб оянатын еді.
Dialogue: 0,0:04:39.59,0:04:42.59,Default,,0,0,0,,Жарайды! Сонымен, түскі үзілісте жаттығуға барасыз ба?
Dialogue: 0,0:04:42.59,0:04:44.59,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:04:46.53,0:04:48.53,Default,,0,0,0,,Кохатчи-сенпай. Әй, бір сәт →
Dialogue: 0,0:04:48.53,0:04:51.53,Default,,0,0,0,,Аяғы ауырады.
Dialogue: 0,0:04:51.53,0:04:55.54,Default,,0,0,0,,Ас әзірлеу бөлімі? Иә. Тәттілер жасаңыз.
Dialogue: 0,0:04:55.54,0:04:58.54,Default,,0,0,0,,Иә? Бірақ... жалғыз? ≪(Студент) Сіз жалғыз емессіз.
Dialogue: 0,0:04:58.54,0:05:00.54,Default,,0,0,0,,Сәлем Кагари! Ах...
Dialogue: 0,0:05:00.54,0:05:04.54,Default,,0,0,0,,Экскурсияға барайық. Сенпай да Кагаллимен сөйлескісі келеді.
Dialogue: 0,0:05:06.55,0:05:09.55,Default,,0,0,0,,《Мен не айтуым керек...》
Dialogue: 0,0:05:09.55,0:05:11.55,Default,,0,0,0,,Бұл сәл орынсыз.
Dialogue: 0,0:05:11.55,0:05:14.56,Default,,0,0,0,,Біз кішкентай кезімізден біргеміз →
Dialogue: 0,0:05:14.56,0:05:17.56,Default,,0,0,0,,Мен болмасам түкке тұрғысыз болар деп ойладым→
Dialogue: 0,0:05:17.56,0:05:20.56,Default,,0,0,0,,Мен сені ешқашан жалғыз қалдырмаймын...
Dialogue: 0,0:05:20.56,0:05:22.56,Default,,0,0,0,,Мен Кагаллиден қашпаймын деп уәде бердім...
Dialogue: 0,0:05:22.56,0:05:24.57,Default,,0,0,0,,Сау болыңыз.
Dialogue: 0,0:05:24.57,0:05:27.57,Default,,0,0,0,,Ах... Сая-чан-сенсэй.
Dialogue: 0,0:05:27.57,0:05:31.57,Default,,0,0,0,,Сіз ішесіз, солай ма? кофе. Иә….
Dialogue: 0,0:05:31.57,0:05:35.58,Default,,0,0,0,,Которию-кун кетіп қалса да, ешкім қиындыққа тап болмайды. →
Dialogue: 0,0:05:35.58,0:05:39.58,Default,,0,0,0,,Өйткені ол ешкімге онша қажет емес.
Dialogue: 0,0:05:39.58,0:05:43.59,Default,,0,0,0,,Ешкімге керек емес...?
Dialogue: 0,0:05:43.59,0:05:46.52,Default,,0,0,0,,Ой, кешіріңіз, кешіріңіз, оны плюс ретінде қабылдаңыз. →
Dialogue: 0,0:05:46.52,0:05:49.52,Default,,0,0,0,,Которию-кунның арқасына ештеңе алып жүрудің қажеті жоқ.
Dialogue: 0,0:05:49.52,0:05:52.53,Default,,0,0,0,,≪(есіктің ашылу дыбысы)
Dialogue: 0,0:05:52.53,0:05:54.53,Default,,0,0,0,,Сая мұғалім.
Dialogue: 0,0:05:54.53,0:05:57.53,Default,,0,0,0,,Сәлем, Ю-кун. мен барамын.
Dialogue: 0,0:05:59.53,0:06:01.53,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:04.54,0:06:08.54,Default,,0,0,0,,Хмм... Түсінемін.
Dialogue: 0,0:06:08.54,0:06:12.55,Default,,0,0,0,,Йоми Кешіріңіз! Мен сенімен біраз уақыт үйге бара алмаймын.
Dialogue: 0,0:06:12.55,0:06:14.55,Default,,0,0,0,,Ю-сан да сенімен бірге ме? Бірге?
Dialogue: 0,0:06:14.55,0:06:18.55,Default,,0,0,0,,Иә, біз бір клубтамыз. Неліктен?
Dialogue: 0,0:06:18.55,0:06:20.56,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:20.56,0:06:35.57,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:35.57,0:06:50.52,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:50.52,0:07:01.53,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:01.53,0:07:05.53,Default,,0,0,0,,Ах, оны Бардик көшесіндегі Кагаллиге сат.
Dialogue: 0,0:07:05.53,0:07:07.54,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:07:07.54,0:07:09.54,Default,,0,0,0,,Сату, сату, сату, сату...!
Dialogue: 0,0:07:09.54,0:07:12.54,Default,,0,0,0,,Мен жоқ деймін! Ах...
Dialogue: 0,0:07:12.54,0:07:16.54,Default,,0,0,0,,Кагалли тек осындай уақыттарға арналған.
Dialogue: 0,0:07:16.54,0:07:20.55,Default,,0,0,0,,Менің достарым болса, мен қандай болар едім?
Dialogue: 0,0:07:20.55,0:07:22.55,Default,,0,0,0,,Оқу? Ах...
Dialogue: 0,0:07:24.55,0:07:27.56,Default,,0,0,0,,Кешіріңіз. Мен аздап шаршадым. Ах...
Dialogue: 0,0:07:27.56,0:07:30.56,Default,,0,0,0,,Бардик көшесі мен оны саған сатамын.
Dialogue: 0,0:07:34.56,0:07:37.57,Default,,0,0,0,,Неліктен бұл кеше болған жоқ?
Dialogue: 0,0:07:37.57,0:07:40.57,Default,,0,0,0,,Себебі~ мен таусылдым~!
Dialogue: 0,0:07:42.57,0:07:44.59,Default,,0,0,0,,Буха!
Dialogue: 0,0:07:44.59,0:07:47.51,Default,,0,0,0,,Аа, аузыңа нан салып бере аламын ба? нан!
Dialogue: 0,0:07:47.51,0:07:49.51,Default,,0,0,0,,Жоқ! Жаман мінез.
Dialogue: 0,0:07:49.51,0:07:51.51,Default,,0,0,0,,Мен оны байқап көргім келді! Мінеки! Мато!
Dialogue: 0,0:07:51.51,0:07:55.51,Default,,0,0,0,,Мен де істеймін! (Матоның анасы) Қазірдің өзінде!
Dialogue: 0,0:07:57.52,0:07:59.52,Default,,0,0,0,,Уа, уа, уа...!
Dialogue: 0,0:07:59.52,0:08:02.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:02.52,0:08:04.53,Default,,0,0,0,,≪Кагали-сан!
Dialogue: 0,0:08:04.53,0:08:06.53,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:08:06.53,0:08:08.53,Default,,0,0,0,,Иә? Йомиге не болды?
Dialogue: 0,0:08:10.53,0:08:13.54,Default,,0,0,0,,Не? А, сәл күте тұрыңыз ...
Dialogue: 0,0:08:13.54,0:08:15.54,Default,,0,0,0,,Мені мектепке апарыңыз.
Dialogue: 0,0:08:15.54,0:08:17.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:20.54,0:08:23.55,Default,,0,0,0,,Оқу: кеш... ≪(есіктің ашылған дыбысы)
Dialogue: 0,0:08:23.55,0:08:25.55,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:08:27.55,0:08:29.55,Default,,0,0,0,,Ах! Қайырлы таң...
Dialogue: 0,0:08:29.55,0:08:32.55,Default,,0,0,0,,Не болды? Аа, Йоми.
Dialogue: 0,0:08:32.55,0:08:35.56,Default,,0,0,0,,Мен оны алып кетуге барсам, ол кетіп қалғанын айтты...
Dialogue: 0,0:08:35.56,0:08:37.56,Default,,0,0,0,,Себебі мен уайымдадым!
Dialogue: 0,0:08:37.56,0:08:39.56,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:08:39.56,0:08:43.57,Default,,0,0,0,,Кешіріңіз... Бірдеңе айтсаңызшы!
Dialogue: 0,0:08:43.57,0:08:46.50,Default,,0,0,0,,Не? Неге ашуланасың? →
Dialogue: 0,0:08:46.50,0:08:48.50,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:08:50.51,0:08:52.51,Default,,0,0,0,,Ол үшін уайымдама, Қағали.
Dialogue: 0,0:08:52.51,0:08:55.51,Default,,0,0,0,,Оқу... Кагалли мырза...
Dialogue: 0,0:08:55.51,0:08:59.51,Default,,0,0,0,,≪
Dialogue: 0,0:09:04.52,0:09:06.52,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:06.52,0:09:10.53,Default,,0,0,0,,Ах, рахмет... және...
Dialogue: 0,0:09:10.53,0:09:12.53,Default,,0,0,0,,Мен не беруім керек деп ойлайсыз?
Dialogue: 0,0:09:12.53,0:09:14.53,Default,,0,0,0,,«Егер сен оны маған берсең»?
Dialogue: 0,0:09:14.53,0:09:17.53,Default,,0,0,0,,Пенсильвания авенюсын сату керек деп ойлайсыз ба?
Dialogue: 0,0:09:17.53,0:09:20.54,Default,,0,0,0,,Пенсильвания авеню?
Dialogue: 0,0:09:20.54,0:09:24.54,Default,,0,0,0,,Кагари, Йоми болмаса, Кагари ештеңе істей алмайды →
Dialogue: 0,0:09:24.54,0:09:29.54,Default,,0,0,0,,Менің ойымша, бұл мүлдем жақсы болмады. →
Dialogue: 0,0:09:29.54,0:09:34.55,Default,,0,0,0,,Бірақ мен оқи алдым, танымал болдым, әйтеуір мінсіз болды.
Dialogue: 0,0:09:34.55,0:09:36.55,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:09:36.55,0:09:39.55,Default,,0,0,0,,Мен не істерімді білмеймін. →
Dialogue: 0,0:09:39.55,0:09:41.56,Default,,0,0,0,,Мен мұны айтқан кезде түсіндім. →
Dialogue: 0,0:09:41.56,0:09:45.49,Default,,0,0,0,,Ол үнемі Йомиден бірдеңе істеуін сұрайтын. →
Dialogue: 0,0:09:45.49,0:09:48.50,Default,,0,0,0,,Кагари да Йоми үшін бірдеңе жасауы керек.
Dialogue: 0,0:09:48.50,0:09:51.50,Default,,0,0,0,,Бірақ Кагалли үшін →
Dialogue: 0,0:09:51.50,0:09:55.50,Default,,0,0,0,,Мен біреуге бірдеңе жасауды білмеймін.
Dialogue: 0,0:09:55.50,0:09:57.51,Default,,0,0,0,,Кагалли мырза...
Dialogue: 0,0:09:57.51,0:10:00.51,Default,,0,0,0,,Мен не істеуім керек... Кагалли үшін не істеуім керек→
Dialogue: 0,0:10:00.51,0:10:04.51,Default,,0,0,0,,Сіз Йоми үшін бірдеңе істей аласыз ба?
Dialogue: 0,0:10:04.51,0:10:15.52,Default,,0,0,0,,♪♪～
Dialogue: 0,0:10:15.52,0:10:19.53,Default,,0,0,0,,Иә? Кішкене қараңғылық сезіне бастады.
Dialogue: 0,0:10:19.53,0:10:21.53,Default,,0,0,0,,Бұл жақсы сурет болатын сияқты.
Dialogue: 0,0:10:21.53,0:10:23.53,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:23.53,0:10:29.54,Default,,0,0,0,,≪(Клуб мүшесі) Ой, бұл не? Жаман сезіледі. Бұл көзқарас ешқашан жоғалмайды.
Dialogue: 0,0:10:29.54,0:10:34.54,Default,,0,0,0,,《Мен кетсем де ешкім қиыншылыққа ұшырамайды》
Dialogue: 0,0:10:36.54,0:10:41.54,Default,,0,0,0,,《Мен ешкімге керек емеспін》
Dialogue: 0,0:10:51.49,0:10:54.50,Default,,0,0,0,,《Менсіз де...》
Dialogue: 0,0:10:54.50,0:10:57.50,Default,,0,0,0,,《Әлем өзгермейді》
Dialogue: 0,0:10:59.94,0:11:01.94,Default,,0,0,0,,Егер бұл Кагалли болса, мен бүгін үйге қайттым.
Dialogue: 0,0:11:01.94,0:11:05.36,Default,,0,0,0,,Мен оны Которию-сан алды деп ойладым.
Dialogue: 0,0:11:06.08,0:11:08.08,Default,,0,0,0,,Сен де таңертең бірдеңеге шағымдандың. →
Dialogue: 0,0:11:08.08,0:11:10.88,Default,,0,0,0,,Кагаллидің қамқоршысының алдында. Ах...
Dialogue: 0,0:11:10.88,0:11:14.08,Default,,0,0,0,,Дұрыс, Кагалли туралы, оны өзіме жасыруға тырыстым.
Dialogue: 0,0:11:14.08,0:11:16.09,Default,,0,0,0,,Қолмен жасалған? Иә.
Dialogue: 0,0:11:16.09,0:11:20.09,Default,,0,0,0,,Сіз аспаздық үйірмеге кіргендіктен бүгін де бірдеңе жасадыңыз, солай ма?
Dialogue: 0,0:11:20.09,0:11:23.09,Default,,0,0,0,,Мадлен. Иә, солай!
Dialogue: 0,0:11:23.09,0:11:25.09,Default,,0,0,0,,Мен міндетті түрде бақытты боламын.
Dialogue: 0,0:11:25.09,0:11:28.10,Default,,0,0,0,,Йоми қуанады.
Dialogue: 0,0:11:28.10,0:11:30.10,Default,,0,0,0,,≪Менде жоқ! Ах...
Dialogue: 0,0:11:30.10,0:11:32.10,Default,,0,0,0,,Мен мұның бәрін іштей сақтай алмаймын...
Dialogue: 0,0:11:32.10,0:11:34.10,Default,,0,0,0,,Кагаллиге күтім жасау керек нәрселер→
Dialogue: 0,0:11:34.10,0:11:36.11,Default,,0,0,0,,Маған қиын болды!
Dialogue: 0,0:11:36.26,0:11:38.26,Default,,0,0,0,,Не? Кенеттен! ?
Dialogue: 0,0:11:38.26,0:11:42.27,Default,,0,0,0,,Сонымен! Кагалли басқа адамдармен жақсы араласады →
Dialogue: 0,0:11:42.27,0:11:46.27,Default,,0,0,0,,Мүлде жоқ! Жақсы!
Dialogue: 0,0:11:46.27,0:11:48.27,Default,,0,0,0,,Мен шынымен бақыттымын!
Dialogue: 0,0:11:50.34,0:11:52.34,Default,,0,0,0,,Оқу?
Dialogue: 0,0:11:54.35,0:11:56.35,Default,,0,0,0,,Ах...!
Dialogue: 0,0:12:00.51,0:12:02.51,Default,,0,0,0,,А... күте тұрыңыз, Йоми!
Dialogue: 0,0:12:04.52,0:12:06.52,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:06.52,0:12:08.52,Default,,0,0,0,,Сіз бұл туралы алаңдамауыңыз керек, Кагалли.
Dialogue: 0,0:12:16.53,0:12:18.53,Default,,0,0,0,,≪
Dialogue: 0,0:12:18.53,0:12:21.54,Default,,0,0,0,,≪(Йомидің анасы) Йоми. Кагалли-чан келе жатыр.
Dialogue: 0,0:12:21.54,0:12:23.54,Default,,0,0,0,,Мен сені көргім келмейді.
Dialogue: 0,0:12:23.54,0:12:25.54,Default,,0,0,0,,≪(Йомидің анасы) Сен осылай шығуың керек. →
Dialogue: 0,0:12:25.54,0:12:27.54,Default,,0,0,0,,Мектепке бара бастаса да.
Dialogue: 0,0:12:27.54,0:12:29.54,Default,,0,0,0,,Мен сені көргім келмейді!
Dialogue: 0,0:12:29.54,0:12:31.54,Default,,0,0,0,,Сонда бұл.
Dialogue: 0,0:12:43.56,0:12:46.56,Default,,0,0,0,,Кесамоның Йомиден айырмашылығы бар ма?
Dialogue: 0,0:12:46.56,0:12:48.56,Default,,0,0,0,,Мен оны алып кетуге бардым, бірақ...
Dialogue: 0,0:12:48.56,0:12:51.57,Default,,0,0,0,,Бұл демалыс күні ме? Иә.
Dialogue: 0,0:12:51.57,0:12:53.57,Default,,0,0,0,,≪(Студент) Кегри. Ах...
Dialogue: 0,0:12:58.57,0:13:01.51,Default,,0,0,0,,Хмм... Мм.
Dialogue: 0,0:13:01.51,0:13:03.51,Default,,0,0,0,,Уау! Уайымдама.
Dialogue: 0,0:13:03.51,0:13:05.51,Default,,0,0,0,,Жақсы….
Dialogue: 0,0:13:05.51,0:13:09.52,Default,,0,0,0,,Әйтеуір, соңғы кездері өзімді жақсы сезінбей жүрмін.
Dialogue: 0,0:13:09.52,0:13:11.52,Default,,0,0,0,,Маған да айтып бере аласыз ба? →
Dialogue: 0,0:13:11.52,0:13:13.52,Default,,0,0,0,,Құс ойынының мекен-жайы. иә?
Dialogue: 0,0:13:13.52,0:13:18.53,Default,,0,0,0,,Мен де, дос болғым келеді. Құстармен ойнау.
Dialogue: 0,0:13:18.53,0:13:20.53,Default,,0,0,0,,Ю! Ол жақсы жігіт!
Dialogue: 0,0:13:20.53,0:13:22.53,Default,,0,0,0,,Уау. Сен жақсы жігітсің!
Dialogue: 0,0:13:22.53,0:13:24.53,Default,,0,0,0,,Эй... не болып жатыр?
Dialogue: 0,0:13:27.53,0:13:29.54,Default,,0,0,0,,Әй, қаттырақ сөйле.
Dialogue: 0,0:13:29.54,0:13:33.54,Default,,0,0,0,,≪ О?
Dialogue: 0,0:13:33.54,0:13:35.54,Default,,0,0,0,,Бір сәтке бола аламын ба?
Dialogue: 0,0:13:35.54,0:13:37.54,Default,,0,0,0,,Әдемі аяқ киім.
Dialogue: 0,0:13:39.55,0:13:41.55,Default,,0,0,0,,Кешіріңіз. →
Dialogue: 0,0:13:41.55,0:13:45.55,Default,,0,0,0,,Мені бәрі мазақтап, ұятқа қалдым...→
Dialogue: 0,0:13:45.55,0:13:47.55,Default,,0,0,0,,Сонда мен сені ренжіттім... →
Dialogue: 0,0:13:47.55,0:13:50.56,Default,,0,0,0,,Мен шынымен бақытты болдым. →
Dialogue: 0,0:13:50.56,0:13:52.56,Default,,0,0,0,,Өйткені мен де сен туралы ойлаймын...
Dialogue: 0,0:13:52.56,0:13:54.56,Default,,0,0,0,,Мм... Иә?
Dialogue: 0,0:13:54.56,0:13:56.56,Default,,0,0,0,,Кешіріңіз. иә?
Dialogue: 0,0:13:56.56,0:13:59.58,Default,,0,0,0,,Ал... Мен түсінбеймін.
Dialogue: 0,0:13:59.58,0:14:02.58,Default,,0,0,0,,Иә. кешіріңіз.
Dialogue: 0,0:14:05.51,0:14:08.51,Default,,0,0,0,,Олай болса, менің үйірме жұмысым бар.
Dialogue: 0,0:14:08.51,0:14:11.51,Default,,0,0,0,,Күтіңіз. Мен кешіре алмаудың қандай сезім екенін білемін. →
Dialogue: 0,0:14:11.51,0:14:13.51,Default,,0,0,0,,Бірақ мен өзгеремін!
Dialogue: 0,0:14:13.51,0:14:15.52,Default,,0,0,0,,Барлығына айтыңыз! сондықтан….
Dialogue: 0,0:14:15.52,0:14:17.52,Default,,0,0,0,,Бұл!
Dialogue: 0,0:14:17.52,0:14:20.52,Default,,0,0,0,,Сондықтан мен шынымен түсінбеймін. →
Dialogue: 0,0:14:20.52,0:14:24.52,Default,,0,0,0,,Мен кешіре алмаймын немесе ашулана алмаймын... Мен кешіре алмаймын.
Dialogue: 0,0:14:24.52,0:14:28.53,Default,,0,0,0,,Мен сізді шынымен түсінбеймін. →
Dialogue: 0,0:14:28.53,0:14:30.53,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:14:47.55,0:14:49.55,Default,,0,0,0,,Бүгін де Кагалли-чан келеді.
Dialogue: 0,0:14:49.55,0:14:51.55,Default,,0,0,0,,≪Қайтып келіңіз.
Dialogue: 0,0:14:51.55,0:14:54.55,Default,,0,0,0,,Бірақ... ≪Қайтып келіңізші!
Dialogue: 0,0:14:59.53,0:15:02.40,Default,,0,0,0,,《Мен осындай хат жібердім→
Dialogue: 0,0:15:02.40,0:15:06.40,Default,,0,0,0,,Мато - бұл... Мато - бұл...》
Dialogue: 0,0:15:06.40,0:15:09.40,Default,,0,0,0,,[TEL] (электрондық поштаның қоңырау үні) Ах!
Dialogue: 0,0:15:09.40,0:15:13.40,Default,,0,0,0,,[TEL] (электрондық пошта қоңырау үні)
Dialogue: 0,0:15:23.42,0:15:28.42,Default,,0,0,0,,«Мен Матоның досымын.»
Dialogue: 0,0:15:31.43,0:15:33.43,Default,,0,0,0,,Не! Бұл не?
Dialogue: 0,0:15:33.43,0:15:36.43,Default,,0,0,0,,Не! Бұл не? Бұл не?
Dialogue: 0,0:15:36.43,0:15:39.43,Default,,0,0,0,,Не! Бұл не? Бұл не? Бұл не?
Dialogue: 0,0:15:39.43,0:15:44.44,Default,,0,0,0,,Не? Ха ха ха ха….
Dialogue: 0,0:15:44.44,0:15:46.44,Default,,0,0,0,,Не...?
Dialogue: 0,0:15:46.44,0:16:06.49,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:06.49,0:16:10.50,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:10.50,0:16:15.50,Default,,0,0,0,,≪(аяқ дыбысы)
Dialogue: 0,0:16:15.50,0:16:17.50,Default,,0,0,0,,≪
Dialogue: 0,0:16:17.50,0:16:20.51,Default,,0,0,0,,≪(Йомидің анасы) Йоми? →
Dialogue: 0,0:16:20.51,0:16:23.51,Default,,0,0,0,,Кагалли-чан, мен әлі күтемін.
Dialogue: 0,0:16:33.52,0:16:35.52,Default,,0,0,0,,Кагалли….
Dialogue: 0,0:16:45.53,0:16:49.54,Default,,0,0,0,,《Кагалли маған керек》
Dialogue: 0,0:16:49.54,0:16:52.54,Default,,0,0,0,,《Кагалли – бұл... Тек Кагалли – →
Dialogue: 0,0:16:52.54,0:16:54.54,Default,,0,0,0,,Менің кетуім керек! 》
Dialogue: 0,0:16:54.54,0:16:57.54,Default,,0,0,0,,≪(есіктің ашылу дыбысы)
Dialogue: 0,0:16:57.54,0:17:00.54,Default,,0,0,0,,≪Қағали! Аа, Йоми.
Dialogue: 0,0:17:06.49,0:17:09.49,Default,,0,0,0,,Кешіріңіз, Кагари...
Dialogue: 0,0:17:09.49,0:17:14.49,Default,,0,0,0,,Кешіріңіз... Уф. Жарайды.
Dialogue: 0,0:17:14.49,0:17:16.49,Default,,0,0,0,,Кешіріңіз... Жарайды.
Dialogue: 0,0:17:18.50,0:17:20.50,Default,,0,0,0,,≪(Есіктің ашылған дыбысы) Мен үйдемін. →
Dialogue: 0,0:17:20.50,0:17:24.50,Default,,0,0,0,,Аа, дымқыл, дымқыл. Мен пластикалық қолшатырымды жоғалтып алдым. →
Dialogue: 0,0:17:24.50,0:17:26.51,Default,,0,0,0,,Мен суық тиіп қалдым. →
Dialogue: 0,0:17:26.51,0:17:29.51,Default,,0,0,0,,...
Dialogue: 0,0:17:29.51,0:17:32.51,Default,,0,0,0,,Жылы Феоре.
Dialogue: 0,0:17:32.51,0:17:34.51,Default,,0,0,0,,Тағы тәттілер?
Dialogue: 0,0:17:34.51,0:17:37.52,Default,,0,0,0,,Иә. Бұл жолы шоколадты печенье.
Dialogue: 0,0:17:37.52,0:17:39.52,Default,,0,0,0,,Рахмет. бақытты.
Dialogue: 0,0:17:39.52,0:17:43.52,Default,,0,0,0,,Шынымен бе? Иә. Мен шынымен бақыттымын.
Dialogue: 0,0:17:43.52,0:17:47.53,Default,,0,0,0,,Жақсы. Кагари, мен Йоми үшін бірдеңе істеуім керек →
Dialogue: 0,0:17:47.53,0:17:49.53,Default,,0,0,0,,Мен осылай ойладым. Иә.
Dialogue: 0,0:17:49.53,0:17:51.53,Default,,0,0,0,,Себебі мен үнемі көмек сұрайтынмын →
Dialogue: 0,0:17:51.53,0:17:54.53,Default,,0,0,0,,Мен сізге дұрыс өтеуім керек. Иә.
Dialogue: 0,0:17:54.53,0:17:57.54,Default,,0,0,0,,Мен сізге өтеуім керек...→
Dialogue: 0,0:17:57.54,0:18:02.54,Default,,0,0,0,,Йоми: Кагари туралы мен ол мені жібермейді деп ойладым.
Dialogue: 0,0:18:08.48,0:18:10.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:10.48,0:18:30.50,Default,,0,0,0,,♪♪～
Dialogue: 0,0:18:30.50,0:18:33.51,Default,,0,0,0,,♪♪～
Dialogue: 0,0:18:33.51,0:18:36.51,Default,,0,0,0,,Оқу... Қағали өзгелермен жақсы араласса→
Dialogue: 0,0:18:36.51,0:18:42.52,Default,,0,0,0,,Сіз бақыттымын дедіңіз, бірақ бұл сіздің итермелеуіңізден бе деп ойлаймын.
Dialogue: 0,0:18:42.52,0:18:44.52,Default,,0,0,0,,Сүт – иек.
Dialogue: 0,0:18:44.52,0:18:48.52,Default,,0,0,0,,Тәкаппар болу маған жаман... →
Dialogue: 0,0:18:48.52,0:18:50.52,Default,,0,0,0,,Кагарина, мен бұған дейін сенімдімін →
Dialogue: 0,0:18:50.52,0:18:54.53,Default,,0,0,0,,Мен Йомисіз ештеңе істей алмас едім деп ойлаймын.
Dialogue: 0,0:18:54.53,0:18:57.53,Default,,0,0,0,,Менің ойымша... Бірақ, Қағари→
Dialogue: 0,0:18:57.53,0:19:00.47,Default,,0,0,0,,Бұл... Йоми болмаса мен мұны істей алмас едім→
Dialogue: 0,0:19:00.47,0:19:03.47,Default,,0,0,0,,Ал... есімде жоқ. →
Dialogue: 0,0:19:03.47,0:19:06.47,Default,,0,0,0,,Ол мен үшін көп нәрсе жасады. →
Dialogue: 0,0:19:06.47,0:19:10.48,Default,,0,0,0,,Менің ойымша, ол мұны мен үшін жасады. →
Dialogue: 0,0:19:10.48,0:19:15.48,Default,,0,0,0,,Менің ойымша, Йоми маған ұнады.
Dialogue: 0,0:19:15.48,0:19:17.48,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:19:17.48,0:19:21.49,Default,,0,0,0,,Мен сені не үшін ұнатқанымды да білмеймін. Кешіріңіз. →
Dialogue: 0,0:19:21.49,0:19:25.49,Default,,0,0,0,,Кешіріңіз. Кагалли: Мен түсінбеймін. →
Dialogue: 0,0:19:25.49,0:19:28.50,Default,,0,0,0,,Сондықтан мен сенің печенье жегеніңді қалаймын.
Dialogue: 0,0:19:28.50,0:19:30.50,Default,,0,0,0,,Сонымен, осы уақытқа дейін не болды →
Dialogue: 0,0:19:30.50,0:19:32.50,Default,,0,0,0,,Мені кешіріңіз. Ах...
Dialogue: 0,0:19:32.50,0:19:35.50,Default,,0,0,0,,Сонымен Кагалли туралы... Ах...
Dialogue: 0,0:19:35.50,0:19:38.51,Default,,0,0,0,,Мені босатуыңызды қалаймын!
Dialogue: 0,0:19:38.51,0:19:40.51,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:19:44.51,0:19:46.51,Default,,0,0,0,,Орындалды.
Dialogue: 0,0:19:46.51,0:20:05.47,Default,,0,0,0,,♪♪～
Dialogue: 0,0:20:05.47,0:20:17.47,Default,,0,0,0,,Ах! !
Dialogue: 0,0:20:19.48,0:20:21.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:21.48,0:20:41.50,Default,,0,0,0,,♪♪～
Dialogue: 0,0:20:41.50,0:21:01.52,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:01.52,0:21:12.52,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:25.55,0:21:35.55,Default,,0,0,0,,♪♪～
Dialogue: 0,0:25:12.54,0:25:17.54,Default,,0,0,0,,Ах...! Ах, аа! →
Dialogue: 0,0:25:17.54,0:25:23.54,Default,,0,0,0,,Ах...! Ааа!
Dialogue: 0,0:25:25.55,0:25:27.55,Default,,0,0,0,,Жинақ...!
Dialogue: 0,0:25:32.56,0:25:35.56,Default,,0,0,0,,Бұл не...?
Dialogue: 0,0:25:35.56,0:25:37.56,Default,,0,0,0,,Өмір?
Dialogue: 0,0:25:39.06,0:25:45.06,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
