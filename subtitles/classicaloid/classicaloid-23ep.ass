Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:29.04,0:00:30.70,Default,,0,0,0,,Соңында аяқталды
Dialogue: 0,0:00:30.75,0:00:32.25,Default,,0,0,0,,Мен сізбен кездесе алдым.
Dialogue: 0,0:00:36.04,0:00:38.66,Default,,0,0,0,,Сегіз тонды күшейткіш Octovassu
Dialogue: 0,0:00:39.04,0:00:42.12,Default,,0,0,0,,Енді мен оның басталуын күтіп отырмын. Ал ше?
Dialogue: 0,0:00:43.25,0:00:43.62,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:00:45.41,0:00:46.91,Default,,0,0,0,,Ha bu белгісі
Dialogue: 0,0:00:47.70,0:00:50.29,Default,,0,0,0,,Маған ұнайды, солай ма?
Dialogue: 0,0:00:51.29,0:00:52.50,Default,,0,0,0,,2 сағаттан кейін
Dialogue: 0,0:00:52.79,0:00:53.16,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:00:54.08,0:00:56.20,Default,,0,0,0,,Октованы 2 сағаттан кейін бастаңыз
Dialogue: 0,0:00:56.83,0:00:58.41,Default,,0,0,0,,Дереу дайындық жасаңыз
Dialogue: 0,0:00:59.37,0:01:01.91,Default,,0,0,0,,Барлық классикалықоидтарды жинаңыз.
Dialogue: 0,0:01:02.25,0:01:03.50,Default,,0,0,0,,Ой, ой
Dialogue: 0,0:01:03.83,0:01:05.29,Default,,0,0,0,,Бах жапон тілінде сөйлейді
Dialogue: 0,0:01:05.45,0:01:05.95,Default,,0,0,0,,О
Dialogue: 0,0:01:06.37,0:01:08.95,Default,,0,0,0,,Менің естігенімдей, дереу қалпына келтіру тобын жіберіңіз.
Dialogue: 0,0:01:09.25,0:01:09.87,Default,,0,0,0,,Га
Dialogue: 0,0:01:11.12,0:01:12.87,Default,,0,0,0,,Чайковский мен Бадазевска
Dialogue: 0,0:01:13.41,0:01:15.54,Default,,0,0,0,,Мен айдол журналына гравюралық фотосессияға барамын.
Dialogue: 0,0:01:16.29,0:01:18.70,Default,,0,0,0,,Мен қайтып келсем, менің бөлмеме келгеніңді қалаймын.
Dialogue: 0,0:01:19.16,0:01:20.12,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:01:23.20,0:01:25.08,Default,,0,0,0,,Күмән болған болуы мүмкін
Dialogue: 0,0:01:25.58,0:01:26.62,Default,,0,0,0,,Ааа
Dialogue: 0,0:01:26.66,0:01:29.75,Default,,0,0,0,,-Біз не үшін ойын-сауықпен айналысамыз? -Аа ааа
Dialogue: 0,0:01:30.87,0:01:34.37,Default,,0,0,0,,Барлығы осы сәт үшін, Дүниені қазіргідей білу.
Dialogue: 0,0:01:34.79,0:01:37.20,Default,,0,0,0,,Музыка тыңдайтын адамдарды білу
Dialogue: 0,0:01:38.20,0:01:41.50,Default,,0,0,0,,Бұл бүгінгі күнге дайындық болды.
Dialogue: 0,0:01:42.33,0:01:46.20,Default,,0,0,0,,Ба Ба Ба Ба Бах ақыры бізбен жапон тілінде сөйлесті.
Dialogue: 0,0:01:46.58,0:01:48.75,Default,,0,0,0,,Уф, неге кенеттен?
Dialogue: 0,0:01:49.33,0:01:51.08,Default,,0,0,0,,Құралдар немесе құралдар емес
Dialogue: 0,0:01:51.33,0:01:54.54,Default,,0,0,0,,Музыка тек музыка ретінде өмір сүретін әлем
Dialogue: 0,0:01:55.41,0:01:58.50,Default,,0,0,0,,Оны жасауға арналған құрылғы аяқталды.
Dialogue: 0,0:01:58.91,0:01:59.70,Default,,0,0,0,,Жабдық?
Dialogue: 0,0:02:00.58,0:02:04.95,Default,,0,0,0,,Сегіз нота құрылғы арқылы күшейтіледі, яғни.
Dialogue: 0,0:02:05.50,0:02:08.75,Default,,0,0,0,,Сегіз классикоидтың толыққанды музыкасы
Dialogue: 0,0:02:09.12,0:02:09.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:11.04,0:02:12.00,Default,,0,0,0,,Сегіз ескерту
Dialogue: 0,0:02:12.95,0:02:17.54,Default,,0,0,0,,Сегіз дыбыс, бізді де айтасың ба?
Dialogue: 0,0:02:18.58,0:02:21.45,Default,,0,0,0,,Сіз де әлемді жасайтын тараздың бір бөлігісіз.
Dialogue: 0,0:02:22.62,0:02:25.08,Default,,0,0,0,,Жақында, жақын арада
Dialogue: 0,0:02:25.66,0:02:28.75,Default,,0,0,0,,Мұнда сегіз классикалықоид жиналады.
Dialogue: 0,0:04:07.12,0:04:09.45,Default,,0,0,0,,Бүгін де жақсы болды, Рикчан.
Dialogue: 0,0:04:09.62,0:04:11.58,Default,,0,0,0,,Сіздің жалақыңызды есепшотыңызға аударамын.
Dialogue: 0,0:04:12.04,0:04:12.91,Default,,0,0,0,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:04:14.41,0:04:14.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:15.37,0:04:16.58,Default,,0,0,0,,Балалар сендер кімсіңдер?
Dialogue: 0,0:04:17.00,0:04:20.16,Default,,0,0,0,,Classicaloid List Бізбен бірге келгіңіз келе ме?
Dialogue: 0,0:04:20.54,0:04:21.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:22.70,0:04:25.50,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:27.25,0:04:28.91,Default,,0,0,0,,Классикалық Моцарт
Dialogue: 0,0:04:29.12,0:04:29.54,Default,,0,0,0,,Реңк пе?
Dialogue: 0,0:04:29.87,0:04:32.87,Default,,0,0,0,,Бізбен бірге
Dialogue: 0,0:04:32.95,0:04:33.87,Default,,0,0,0,,Мен сенімен бірге болғым келеді.
Dialogue: 0,0:04:34.41,0:04:35.00,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:04:39.91,0:04:41.83,Default,,0,0,0,,Хмм, міне, осы.
Dialogue: 0,0:04:46.33,0:04:47.41,Default,,0,0,0,,Классика Уф
Dialogue: 0,0:04:47.58,0:04:48.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:48.41,0:04:50.04,Default,,0,0,0,,Ммммм ісік
Dialogue: 0,0:04:50.79,0:04:54.95,Default,,0,0,0,,Жоқ, жоқ, жапқыштарға толы сауда көшесі
Dialogue: 0,0:04:55.20,0:04:57.62,Default,,0,0,0,,Бұл балалар жақсы балалар.
Dialogue: 0,0:04:58.45,0:05:03.70,Default,,0,0,0,,Жоқ, бұл менің ең жақсы көретін тарақшам.
Dialogue: 0,0:05:04.16,0:05:07.20,Default,,0,0,0,,айтуым керек пе? Жоқ, бірақ
Dialogue: 0,0:05:08.45,0:05:10.20,Default,,0,0,0,,Классикалық Шуберт
Dialogue: 0,0:05:10.33,0:05:11.58,Default,,0,0,0,,Маған сенімен бірге келуге рұқсат ет.
Dialogue: 0,0:05:11.79,0:05:15.66,Default,,0,0,0,,Бұл ма? Қара киімдер көп. Күтпеген.
Dialogue: 0,0:05:18.58,0:05:21.62,Default,,0,0,0,,Шопен мырзаға пошталық тапсырыс сайтынан жеткізілді.
Dialogue: 0,0:05:22.20,0:05:22.79,Default,,0,0,0,,Иә
Dialogue: 0,0:05:24.87,0:05:26.41,Default,,0,0,0,,-Ух - Ооо.
Dialogue: 0,0:05:26.50,0:05:28.41,Default,,0,0,0,,Классикалық Шопен. Менің бұған қатысым бар.
Dialogue: 0,0:05:28.45,0:05:31.37,Default,,0,0,0,,-Ей, маған тиіспе. -Ой.
Dialogue: 0,0:05:32.37,0:05:34.16,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:05:36.33,0:05:38.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:38.33,0:05:38.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:52.66,0:05:56.70,Default,,0,0,0,,Көңілді Көңілді Шоппинг Көшедегі Тарақтар
Dialogue: 0,0:05:57.00,0:05:58.95,Default,,0,0,0,,Үйге қайтқанда міндетті түрде шайыңыз.
Dialogue: 0,0:05:59.16,0:06:00.37,Default,,0,0,0,,Ааа
Dialogue: 0,0:06:00.45,0:06:03.79,Default,,0,0,0,,-Әлсіз Бұл балалар нені қалады? -Аа ааа
Dialogue: 0,0:06:05.37,0:06:06.20,Default,,0,0,0,,Сәтсіздік?
Dialogue: 0,0:06:06.87,0:06:10.04,Default,,0,0,0,,Иә, бәрі де Мусикпен тойтарыс берген сияқты.
Dialogue: 0,0:06:10.79,0:06:14.50,Default,,0,0,0,,Ол Мусикке барлық мүмкін болатын дайындықтарды жасауды тапсырған болуы керек.
Dialogue: 0,0:06:15.16,0:06:16.95,Default,,0,0,0,,Оларды шынымен де қолдануға болмайды.
Dialogue: 0,0:06:17.62,0:06:19.87,Default,,0,0,0,,Бірақ бұл күтілген ауқымда.
Dialogue: 0,0:06:20.54,0:06:21.54,Default,,0,0,0,,Мен есімде сақтамасам да,
Dialogue: 0,0:06:22.00,0:06:25.04,Default,,0,0,0,,Жақсы болсын, жаман болсын, олар данышпан.
Dialogue: 0,0:06:25.79,0:06:28.20,Default,,0,0,0,,Мусик деп аталатын табиғаттан тыс күшті басқару
Dialogue: 0,0:06:28.54,0:06:31.12,Default,,0,0,0,,Қыңыр, эксцентрик, парасаттылықтан хабарсыз
Dialogue: 0,0:06:31.70,0:06:33.83,Default,,0,0,0,,Қарапайым адамдарға тым көп.
Dialogue: 0,0:06:34.41,0:06:36.37,Default,,0,0,0,,Мен сені әйтеуір осында әкелсем де.
Dialogue: 0,0:06:36.83,0:06:38.95,Default,,0,0,0,,Қалай болса да жалынып, өзімшіл сөздер айту
Dialogue: 0,0:06:39.29,0:06:41.54,Default,,0,0,0,,Менің ойымша, олар мойынсұнушылықпен ынтымақтасады деп ойламаймын.
Dialogue: 0,0:06:42.41,0:06:43.25,Default,,0,0,0,,Міне.
Dialogue: 0,0:06:44.29,0:06:47.00,Default,,0,0,0,,Мен осындай нәрсе болуы үшін дайындалдым.
Dialogue: 0,0:06:48.54,0:06:50.75,Default,,0,0,0,,Ол жігіттерден әлдеқайда мойынсұнғыш.
Dialogue: 0,0:06:51.12,0:06:52.91,Default,,0,0,0,,әлдеқайда жоғары тіршілік иесі
Dialogue: 0,0:06:53.04,0:06:53.79,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:06:55.83,0:06:58.91,Default,,0,0,0,,Виртуалды қолданбамен таныстыру
Dialogue: 0,0:06:59.33,0:07:01.33,Default,,0,0,0,,Алкедор негізінде дамыған
Dialogue: 0,0:07:01.37,0:07:03.62,Default,,0,0,0,,Жасанды интеллект құрылыс бағдарламасымен жабдықталған
Dialogue: 0,0:07:03.91,0:07:05.70,Default,,0,0,0,,Жеті супер андроид
Dialogue: 0,0:07:07.12,0:07:09.12,Default,,0,0,0,,Оның аты Мицуруроид Кай
Dialogue: 0,0:07:10.41,0:07:12.04,Default,,0,0,0,,Мойынсұнғыш және тамаша?
Dialogue: 0,0:07:12.66,0:07:14.83,Default,,0,0,0,,Мен сізге Бетховеннің өңделген нұсқасын көрсетемін.
Dialogue: 0,0:07:15.25,0:07:21.45,Default,,0,0,0,,- бұл музыкалық бағдарлама.
Dialogue: 0,0:07:25.20,0:07:26.25,Default,,0,0,0,,Музыка
Dialogue: 0,0:07:27.33,0:07:29.45,Default,,0,0,0,,Сол жеті мүжіктің деректері
Dialogue: 0,0:07:29.83,0:07:32.29,Default,,0,0,0,,Бұрынғы байланыс мүмкіндіктерінен жинақталған
Dialogue: 0,0:07:32.87,0:07:34.33,Default,,0,0,0,,Октованы бастау
Dialogue: 0,0:07:34.54,0:07:36.25,Default,,0,0,0,,8 музыка қажет
Dialogue: 0,0:07:36.87,0:07:39.04,Default,,0,0,0,,Тұрақсыз түпнұсқалардан айырмашылығы
Dialogue: 0,0:07:39.29,0:07:42.95,Default,,0,0,0,,Мусикті емін-еркін басқара алумен қатар, ол бұйрықтарды мүлде орындайды.
Dialogue: 0,0:07:43.41,0:07:45.00,Default,,0,0,0,,Бахтың асыл мұраттары
Dialogue: 0,0:07:45.33,0:07:47.58,Default,,0,0,0,,Олар Мицуруроид Кайды жүзеге асырады.
Dialogue: 0,0:07:55.16,0:07:58.29,Default,,0,0,0,,А, эй, Бах мырза институтқа барды ма?
Dialogue: 0,0:07:58.54,0:08:00.70,Default,,0,0,0,,Біз де көшуіміз керек пе?
Dialogue: 0,0:08:01.16,0:08:03.08,Default,,0,0,0,,Ой, балалар, сендер жетеді.
Dialogue: 0,0:08:03.29,0:08:03.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:04.25,0:08:07.41,Default,,0,0,0,,Мен сендерден әлдеқайда жақсы алмастырушы таптым.
Dialogue: 0,0:08:08.04,0:08:09.54,Default,,0,0,0,,Осылайша сіз қазір өзіңізге ұнайтын нәрсені жасай аласыз.
Dialogue: 0,0:08:10.25,0:08:12.54,Default,,0,0,0,,Оның орнына мүмкін
Dialogue: 0,0:08:13.20,0:08:14.08,Default,,0,0,0,,Фуфун
Dialogue: 0,0:08:14.66,0:08:15.50,Default,,0,0,0,,Ха
Dialogue: 0,0:08:16.00,0:08:17.16,Default,,0,0,0,,Түсінген сияқтысыз.
Dialogue: 0,0:08:17.87,0:08:20.58,Default,,0,0,0,,Ашығын айтқанда, енді сендер керек емессіңдер.
Dialogue: 0,0:08:21.25,0:08:23.62,Default,,0,0,0,,Сіз қалаған жерге бара аласыз.
Dialogue: 0,0:08:26.83,0:08:30.87,Default,,0,0,0,,А-а-а-а-а-а-а
Dialogue: 0,0:08:33.08,0:08:36.66,Default,,0,0,0,,Ол бұрыннан қолданылған дегенді қалай түсінесіз?
Dialogue: 0,0:08:36.87,0:08:38.12,Default,,0,0,0,,Мойын тағы?
Dialogue: 0,0:08:38.50,0:08:41.58,Default,,0,0,0,,Бах мырза, сіз бізге керек деп айттыңыз.
Dialogue: 0,0:08:41.87,0:08:44.16,Default,,0,0,0,,Мен бұл әйелдің ойлағанына сенімдімін.
Dialogue: 0,0:08:45.04,0:08:48.41,Default,,0,0,0,,Қалағаныңды істе десең де, мен ешқайда кетпеймін
Dialogue: 0,0:08:48.91,0:08:50.87,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:08:52.91,0:08:55.87,Default,,0,0,0,,Не? Сонда барлығына шабуыл жасалды ма?
Dialogue: 0,0:08:56.29,0:08:58.95,Default,,0,0,0,,Солардың кесірінен барлық балықтар қашып кетті.
Dialogue: 0,0:08:59.37,0:09:01.62,Default,,0,0,0,,Лу, сен оны ешқашан ұстаған жоқсың.
Dialogue: 0,0:09:01.87,0:09:02.37,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:09:02.54,0:09:02.91,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:09:03.00,0:09:04.95,Default,,0,0,0,,Бүгін балық аулау белгілеріне толы болды.
Dialogue: 0,0:09:05.37,0:09:07.95,Default,,0,0,0,,-Дерек: Ұзындығы 10 метр болатын тунец болған.
Dialogue: 0,0:09:08.04,0:09:09.45,Default,,0,0,0,,Бірде менің таяқшама
Dialogue: 0,0:09:09.58,0:09:11.62,Default,,0,0,0,,Жоқ, басқа қайда барарымды білмеймін.
Dialogue: 0,0:09:12.08,0:09:13.29,Default,,0,0,0,,Мотуға да шабуыл жасалды ма?
Dialogue: 0,0:09:13.62,0:09:15.50,Default,,0,0,0,,Хмм, бірдеңе келе жатыр.
Dialogue: 0,0:09:15.79,0:09:17.75,Default,,0,0,0,,Мен мұндайды көрмегелі біраз болды.
Dialogue: 0,0:09:18.20,0:09:20.87,Default,,0,0,0,,А, енді ойлап қарасам, мен мұнда біраз уақыт бұрын келдім.
Dialogue: 0,0:09:21.16,0:09:23.25,Default,,0,0,0,,Маған Классикалоидты қайтарып беріңізші.
Dialogue: 0,0:09:23.62,0:09:25.45,Default,,0,0,0,,Оны қайтар деп кім айтып жатыр?
Dialogue: 0,0:09:25.66,0:09:27.29,Default,,0,0,0,,Ол Бах болуы керек.
Dialogue: 0,0:09:27.75,0:09:29.25,Default,,0,0,0,,Бастапқыда мен және Чочан
Dialogue: 0,0:09:29.45,0:09:31.12,Default,,0,0,0,,Оның бұйрығы бойынша Бето мен Моту
Dialogue: 0,0:09:31.25,0:09:32.79,Default,,0,0,0,,Мен сені қайтару үшін келдім.
Dialogue: 0,0:09:33.12,0:09:35.00,Default,,0,0,0,,Иә, солай ма?
Dialogue: 0,0:09:35.12,0:09:35.95,Default,,0,0,0,,(От-шағал жәндігінің дыбысы)
Dialogue: 0,0:09:36.66,0:09:37.04,Default,,0,0,0,,Иә
Dialogue: 0,0:09:37.83,0:09:39.41,Default,,0,0,0,,Өйткені мен соңғы кездері үнсіз қалдым.
Dialogue: 0,0:09:39.45,0:09:41.29,Default,,0,0,0,,Мен сені ойыңды өзгертті деп ойладым.
Dialogue: 0,0:09:41.95,0:09:42.91,Default,,0,0,0,,Бах мырза
Dialogue: 0,0:09:43.33,0:09:45.91,Default,,0,0,0,,Классикалоидты өзіммен бірге алсам не істеуім керек?
Dialogue: 0,0:09:46.50,0:09:46.95,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:09:47.95,0:09:49.08,Default,,0,0,0,,Яондабе
Dialogue: 0,0:09:49.20,0:09:49.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:50.08,0:09:50.91,Default,,0,0,0,,Чайко-чан
Dialogue: 0,0:09:51.08,0:09:51.79,Default,,0,0,0,,Бадакюн
Dialogue: 0,0:09:52.50,0:09:54.75,Default,,0,0,0,,Біраз уақыт көмектескеніңіз үшін рахмет.
Dialogue: 0,0:09:55.08,0:09:55.45,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:09:55.58,0:09:57.91,Default,,0,0,0,,Не, жігіттер, тағы да жұмыстан босатылдыңдар ма?
Dialogue: 0,0:09:58.08,0:10:01.25,Default,,0,0,0,,Тек біз емес, бәрің де өлдіңдер.
Dialogue: 0,0:10:01.54,0:10:02.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:02.45,0:10:03.41,Default,,0,0,0,,(Баяндау) Бір күні адамсыз жүзуші кеме табылды.
Dialogue: 0,0:10:06.45,0:10:07.37,Default,,0,0,0,,Сегіз жазба?
Dialogue: 0,0:10:08.83,0:10:10.83,Default,,0,0,0,,Ал, яғни.
Dialogue: 0,0:10:10.91,0:10:13.70,Default,,0,0,0,,Бах мырзаның идеалды әлемін құру
Dialogue: 0,0:10:14.16,0:10:16.95,Default,,0,0,0,,Бұл бізге 8 классикалоид қажет дегенді білдіре ме?
Dialogue: 0,0:10:17.41,0:10:19.04,Default,,0,0,0,,Мастер Бах осылай деді.
Dialogue: 0,0:10:19.29,0:10:23.00,Default,,0,0,0,,Уау, әлемді жасайтын сегіз адам өте керемет, солай емес пе?
Dialogue: 0,0:10:23.37,0:10:24.25,Default,,0,0,0,,Хмм.
Dialogue: 0,0:10:24.83,0:10:27.58,Default,,0,0,0,,Ол мен оның не ойлағанын түсінбейтін адам еді.
Dialogue: 0,0:10:27.87,0:10:29.66,Default,,0,0,0,,Мен осылай ойладым.
Dialogue: 0,0:10:30.87,0:10:31.58,Default,,0,0,0,,Қандай керемет сәттілік!
Dialogue: 0,0:10:32.25,0:10:35.45,Default,,0,0,0,,Неліктен ол рұқсатсыз таңдаған мүшелердің қатарына қосылдыңыз?
Dialogue: 0,0:10:35.66,0:10:38.41,Default,,0,0,0,,Таусылды, енді кірме.
Dialogue: 0,0:10:38.70,0:10:40.08,Default,,0,0,0,,Маған бұл ұнамайды.
Dialogue: 0,0:10:40.70,0:10:41.75,Default,,0,0,0,,Бірақ неге?
Dialogue: 0,0:10:42.45,0:10:45.33,Default,,0,0,0,,Бұл жоспар классикалоидты қажет етеді, солай емес пе?
Dialogue: 0,0:10:45.87,0:10:47.91,Default,,0,0,0,,Олар алмастырушыны тапқанын айтты.
Dialogue: 0,0:10:48.29,0:10:49.95,Default,,0,0,0,,Біз 7 адам сияқтымыз
Dialogue: 0,0:10:50.00,0:10:52.58,Default,,0,0,0,,Робот немесе бір нәрсе айналып жүрді.
Dialogue: 0,0:10:52.83,0:10:53.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:53.66,0:10:54.58,Default,,0,0,0,,Робот?
Dialogue: 0,0:10:55.20,0:10:57.87,Default,,0,0,0,,Сонда әлгі жалған робот әлемді жасайды ма?
Dialogue: 0,0:10:58.62,0:10:59.29,Default,,0,0,0,,Иә
Dialogue: 0,0:11:08.83,0:11:11.37,Default,,0,0,0,,Бұл сіз қалаған нәрсені жасай аласыз дегенді білдіреді.
Dialogue: 0,0:11:11.58,0:11:14.20,Default,,0,0,0,,Міне. Қайтадан балық аулауға барайық.
Dialogue: 0,0:11:14.29,0:11:15.87,Default,,0,0,0,,Қыздарды алып кетейік
Dialogue: 0,0:11:16.04,0:11:17.25,Default,,0,0,0,,Ойынның жалғасы
Dialogue: 0,0:11:17.58,0:11:18.83,Default,,0,0,0,,Алкогольді ішу керек.
Dialogue: 0,0:11:18.95,0:11:20.16,Default,,0,0,0,,Мен теледидар көргім келеді
Dialogue: 0,0:11:20.50,0:11:23.29,Default,,0,0,0,,Біраз күте тұрыңыз, мен шынымен түсінбеймін.
Dialogue: 0,0:11:23.45,0:11:26.33,Default,,0,0,0,,Жаңа әлем құрылғалы тұр, солай ма?
Dialogue: 0,0:11:26.70,0:11:28.04,Default,,0,0,0,,Мен оны жалғыз қалдыра аламын ба?
Dialogue: 0,0:11:28.25,0:11:30.20,Default,,0,0,0,,Өйткені оның бізге еш қатысы жоқ.
Dialogue: 0,0:11:30.54,0:11:33.16,Default,,0,0,0,,Дұрыс, мен әлемдегі ең танымал адам боламын.
Dialogue: 0,0:11:33.20,0:11:34.54,Default,,0,0,0,,Дүниеде не істеуіміз керек?
Dialogue: 0,0:11:35.04,0:11:38.00,Default,,0,0,0,,Қай дүниеде де Сосуке ұзақ өмір сүре алады.
Dialogue: 0,0:11:38.33,0:11:39.08,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:12:09.12,0:12:11.41,Default,,0,0,0,,Енді Октованы бастайық.
Dialogue: 0,0:12:12.04,0:12:13.75,Default,,0,0,0,,Бах музыкасы бойынша
Dialogue: 0,0:12:14.08,0:12:17.16,Default,,0,0,0,,Қалған жеті адамның музыкасын қабаттап, күшейтемін.
Dialogue: 0,0:12:17.95,0:12:20.50,Default,,0,0,0,,Енді, Бах мырза, маған музыка беріңізші.
Dialogue: 0,0:12:37.79,0:12:39.41,Default,,0,0,0,,Октова Іске қосуды растау
Dialogue: 0,0:12:51.33,0:12:53.58,Default,,0,0,0,,Альфадан Этаға дейін Әдепкі мәнді өшіріңіз
Dialogue: 0,0:13:00.54,0:13:01.58,Default,,0,0,0,,Люк ашық
Dialogue: 0,0:13:03.62,0:13:05.04,Default,,0,0,0,,Екінші кезеңге көшу
Dialogue: 0,0:13:07.91,0:13:09.25,Default,,0,0,0,,Динамик барлығы тегін
Dialogue: 0,0:13:10.58,0:13:14.58,Default,,0,0,0,,Керемет, уа, дүние енді қайта туып жатыр.
Dialogue: 0,0:13:15.00,0:13:16.79,Default,,0,0,0,,Музыкалық энергия әлі де артып келеді
Dialogue: 0,0:13:17.00,0:13:17.58,Default,,0,0,0,,Мен бара аламын.
Dialogue: 0,0:13:17.95,0:13:19.79,Default,,0,0,0,,Октова Альфа шығарылымы
Dialogue: 0,0:14:07.37,0:14:11.75,Default,,0,0,0,,Иә? Неліктен? Мен оны мүлдем естімеймін
Dialogue: 0,0:14:12.00,0:14:13.79,Default,,0,0,0,,Соқсаң түзеледі.
Dialogue: 0,0:14:26.08,0:14:28.08,Default,,0,0,0,,Сосуке? Сен не істеп жатырсың?
Dialogue: 0,0:14:35.79,0:14:36.66,Default,,0,0,0,,Сіз суық тиіп қалдыңыз ба?
Dialogue: 0,0:14:39.62,0:14:41.29,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:14:41.66,0:14:43.70,Default,,0,0,0,,Айтар сөзің болса, ауызбен айт.
Dialogue: 0,0:14:45.91,0:14:46.87,Default,,0,0,0,,Дегенмен, патшаңыздың қазір есінен адасқаны анық.
Dialogue: 0,0:14:46.91,0:14:47.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:47.79,0:14:49.95,Default,,0,0,0,,Ойынның дыбысы кенет өшіп қалады.
Dialogue: 0,0:14:50.04,0:14:51.87,Default,,0,0,0,,Құбыжықтың шабуылынан кейін қайтыс болды
Dialogue: 0,0:14:52.08,0:14:56.25,Default,,0,0,0,,Мен оны 200-деңгейге көтердім.
Dialogue: 0,0:14:59.45,0:15:00.95,Default,,0,0,0,,Дыбыс жоқ.
Dialogue: 0,0:15:01.16,0:15:02.45,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:15:02.83,0:15:05.08,Default,,0,0,0,,Котенка да дыбыс шығара алмайтынын айтады.
Dialogue: 0,0:15:05.54,0:15:06.62,Default,,0,0,0,,Бұл да жақсы емес.
Dialogue: 0,0:15:07.12,0:15:09.20,Default,,0,0,0,,Барлық арналарда дыбыс ақаулары бар.
Dialogue: 0,0:15:13.12,0:15:15.12,Default,,0,0,0,,Пэд-кун бұл туралы айтып тұр ма?
Dialogue: 0,0:15:21.91,0:15:23.33,Default,,0,0,0,,Дыбыс өшкенде
Dialogue: 0,0:15:23.62,0:15:25.29,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:15:31.70,0:15:32.29,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:15:37.70,0:15:38.54,Default,,0,0,0,,Ах ха ха?
Dialogue: 0,0:15:45.00,0:15:49.37,Default,,0,0,0,,Мұнда не болып жатыр?
Dialogue: 0,0:15:51.00,0:15:52.75,Default,,0,0,0,,Аххххх
Dialogue: 0,0:15:57.70,0:16:00.70,Default,,0,0,0,,Иә? Бір минут күте тұрыңыз
Dialogue: 0,0:16:04.62,0:16:06.16,Default,,0,0,0,,Бұл солай сияқты.
Dialogue: 0,0:16:06.41,0:16:07.50,Default,,0,0,0,,Ол өте танымал батыр ғой, иә?
Dialogue: 0,0:16:07.87,0:16:11.04,Default,,0,0,0,,Мен мұны тек Мастер Бах жасаған құрылғының арқасында деп ойлаймын.
Dialogue: 0,0:16:11.58,0:16:12.12,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:16:12.50,0:16:15.16,Default,,0,0,0,,Бұл Бах жасағысы келген дүние ме?
Dialogue: 0,0:16:15.87,0:16:17.54,Default,,0,0,0,,Дыбыссыз әлем?
Dialogue: 0,0:16:28.62,0:16:34.00,Default,,0,0,0,,Эхехехе Төтенше хаос әлеміндегі жарық сәулесі
Dialogue: 0,0:16:34.33,0:16:36.08,Default,,0,0,0,,Бұл Құдайдың аяны
Dialogue: 0,0:16:37.04,0:16:39.08,Default,,0,0,0,,Октова бета шығарылымы
Dialogue: 0,0:16:44.91,0:16:45.41,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:16:46.75,0:16:47.75,Default,,0,0,0,,Тыңдау
Dialogue: 0,0:16:51.00,0:16:51.95,Default,,0,0,0,,Музыка?
Dialogue: 0,0:16:53.33,0:16:54.66,Default,,0,0,0,,Өте жақсы ән
Dialogue: 0,0:16:55.70,0:16:56.41,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:16:57.83,0:16:58.33,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:16:59.04,0:17:00.58,Default,,0,0,0,,Бұл музыка ма?
Dialogue: 0,0:17:01.00,0:17:03.12,Default,,0,0,0,,Шынайы ма? А, мен сөйлей алатынмын.
Dialogue: 0,0:17:03.87,0:17:04.87,Default,,0,0,0,,Бұл ән
Dialogue: 0,0:17:05.08,0:17:07.00,Default,,0,0,0,,Жазған Иоганн Себастьян Бах
Dialogue: 0,0:17:07.33,0:17:09.87,Default,,0,0,0,,№1 виолончель сюитасының бірінші бөлімі
Dialogue: 0,0:17:10.04,0:17:11.08,Default,,0,0,0,,Прелюдия
Dialogue: 0,0:17:11.41,0:17:12.62,Default,,0,0,0,,Бах
Dialogue: 0,0:17:14.79,0:17:15.45,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:17:16.75,0:17:18.20,Default,,0,0,0,,Мынау не парик?
Dialogue: 0,0:17:19.12,0:17:22.20,Default,,0,0,0,,Andantino қабірі
Dialogue: 0,0:17:22.29,0:17:23.41,Default,,0,0,0,,Ол қатты жараланған еді...
Dialogue: 0,0:17:23.66,0:17:24.29,Default,,0,0,0,,Пианисимо
Dialogue: 0,0:17:24.41,0:17:30.54,Default,,0,0,0,,Ah da capo dal segno
Dialogue: 0,0:17:31.29,0:17:32.29,Default,,0,0,0,,Состенуто
Dialogue: 0,0:17:32.41,0:17:33.04,Default,,0,0,0,,Бұл не? Сен... неге мені қуалап жүрсің?
Dialogue: 0,0:17:33.12,0:17:33.95,Default,,0,0,0,,Ритардант
Dialogue: 0,0:17:34.20,0:17:35.37,Default,,0,0,0,,Стаккато
Dialogue: 0,0:17:35.66,0:17:36.75,Default,,0,0,0,,Фермата
Dialogue: 0,0:17:37.54,0:17:38.75,Default,,0,0,0,,Уау
Dialogue: 0,0:17:41.20,0:17:42.25,Default,,0,0,0,,Андат
Dialogue: 0,0:17:42.58,0:17:43.54,Default,,0,0,0,,Уняааааа
Dialogue: 0,0:17:43.58,0:17:45.41,Default,,0,0,0,,Мя мяа умя мя
Dialogue: 0,0:17:45.50,0:17:46.29,Default,,0,0,0,,...
Dialogue: 0,0:17:46.79,0:17:48.04,Default,,0,0,0,,Угу гуах
Dialogue: 0,0:17:49.50,0:17:51.66,Default,,0,0,0,,Бах париктері көбірек
Dialogue: 0,0:17:51.87,0:17:53.91,Default,,0,0,0,,Маған қызық, бәрі не болды?
Dialogue: 0,0:17:54.50,0:17:55.79,Default,,0,0,0,,Қарап жібере аласыз ба?
Dialogue: 0,0:17:56.12,0:17:58.58,Default,,0,0,0,,Қаладағы адамдар бірінен соң бірі Бахқа айналып барады.
Dialogue: 0,0:17:58.95,0:18:00.91,Default,,0,0,0,,Музыканың атасы, портреттерімен танымал
Dialogue: 0,0:18:01.20,0:18:02.75,Default,,0,0,0,,Бах бейнесінің өзі
Dialogue: 0,0:18:03.12,0:18:04.54,Default,,0,0,0,,Біраздан бері шырылдап тұр.
Dialogue: 0,0:18:04.83,0:18:06.83,Default,,0,0,0,,-Бұл не? - Осы Бахтың шығармасы себеп болған сияқты.
Dialogue: 0,0:18:07.08,0:18:08.41,Default,,0,0,0,,Толығырақ ақпаратты мына жерден қараңыз
Dialogue: 0,0:18:10.45,0:18:11.58,Default,,0,0,0,,Крессендо
Dialogue: 0,0:18:13.25,0:18:14.75,Default,,0,0,0,,Бахқа толы
Dialogue: 0,0:18:15.41,0:18:17.25,Default,,0,0,0,,Бұл жаңа дүние ме?
Dialogue: 0,0:18:17.66,0:18:18.41,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:18:21.04,0:18:21.75,Default,,0,0,0,,О
Dialogue: 0,0:18:22.45,0:18:23.33,Default,,0,0,0,,Аллегро
Dialogue: 0,0:18:24.33,0:18:24.87,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:18:25.66,0:18:27.20,Default,,0,0,0,,-Реверб -Фортисимо
Dialogue: 0,0:18:28.33,0:18:29.79,Default,,0,0,0,,Decrescendo
Dialogue: 0,0:18:33.79,0:18:37.20,Default,,0,0,0,,Бұл не? Мен шыдай алмаймын.
Dialogue: 0,0:18:37.62,0:18:43.04,Default,,0,0,0,,-Тасып жатқан сезімдер о, балақай -nnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnnn
Dialogue: 0,0:18:44.00,0:18:44.45,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:44.75,0:18:46.75,Default,,0,0,0,,Бах мырза, сіз ояусыз ба?
Dialogue: 0,0:18:47.29,0:18:51.41,Default,,0,0,0,,Сіз неге еліктейсіз? О, бұл менің әнім.
Dialogue: 0,0:18:52.25,0:18:53.41,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:18:53.79,0:18:57.66,Default,,0,0,0,,Сегіз нота сегіз музыканттың бір-бірін жабатын дыбысы болуы керек.
Dialogue: 0,0:18:57.91,0:18:59.08,Default,,0,0,0,,Бұл шу.
Dialogue: 0,0:18:59.66,0:19:00.29,Default,,0,0,0,,Әртүрлі?
Dialogue: 0,0:19:00.79,0:19:03.00,Default,,0,0,0,,Ұлы Бахтан басқа музыка бар ма?
Dialogue: 0,0:19:03.33,0:19:04.95,Default,,0,0,0,,Олар шу дейді.
Dialogue: 0,0:19:05.16,0:19:06.16,Default,,0,0,0,,Ммм
Dialogue: 0,0:19:06.41,0:19:08.20,Default,,0,0,0,,Бахтың ұлылығын сезінгеннен кейін
Dialogue: 0,0:19:08.41,0:19:09.91,Default,,0,0,0,,Мен бұл туралы көптен бері ойлап жүрдім.
Dialogue: 0,0:19:10.58,0:19:12.70,Default,,0,0,0,,Жаңа дүниеде жаңғыратын музыка
Dialogue: 0,0:19:12.91,0:19:14.50,Default,,0,0,0,,Бахтың кесектері жақсы.
Dialogue: 0,0:19:14.95,0:19:16.54,Default,,0,0,0,,Бетховен немесе Моцарт па?
Dialogue: 0,0:19:16.70,0:19:18.00,Default,,0,0,0,,Керек емес ұсақ қуыру қажет емес
Dialogue: 0,0:19:18.41,0:19:20.25,Default,,0,0,0,,Сегіз Бах магистрінің сегіз нотасы
Dialogue: 0,0:19:20.58,0:19:22.79,Default,,0,0,0,,Сол музыка тудырған жаңа дүние
Dialogue: 0,0:19:23.25,0:19:24.91,Default,,0,0,0,,Егер бүкіл адамзат Бах сияқты болса
Dialogue: 0,0:19:25.16,0:19:27.00,Default,,0,0,0,,Міне нағыз идеал дүние
Dialogue: 0,0:19:27.41,0:19:30.37,Default,,0,0,0,,Уау, қатты әсерлендім, жүрегім қатты соғып тұр
Dialogue: 0,0:19:30.91,0:19:33.20,Default,,0,0,0,,Бахтың шынайы идеалдарын жүзеге асыру болып табылады
Dialogue: 0,0:19:33.41,0:19:35.45,Default,,0,0,0,,Доктор Отованың Классикалоид емес
Dialogue: 0,0:19:35.75,0:19:38.83,Default,,0,0,0,,Бұл мен жасаған Мицуроид екендігі
Dialogue: 0,0:19:39.33,0:19:42.54,Default,,0,0,0,,Жақында әлем өзгереді және Бахқа,
Dialogue: 0,0:19:42.91,0:19:44.75,Default,,0,0,0,,Жаңа әлемнің орталығында
Dialogue: 0,0:19:45.04,0:19:47.50,Default,,0,0,0,,Мен мәңгілік Құдай боламын.
Dialogue: 0,0:19:48.08,0:19:50.58,Default,,0,0,0,,Мисген мырза
Dialogue: 0,0:19:51.66,0:19:54.79,Default,,0,0,0,,Ах, Бах мырза.
Dialogue: 0,0:19:54.87,0:19:57.50,Default,,0,0,0,,Менің атымды бірінші рет атадың.
Dialogue: 0,0:19:58.08,0:20:02.00,Default,,0,0,0,,Қазір фуфуфуфуфуфуфуфу
Dialogue: 0,0:20:02.58,0:20:05.70,Default,,0,0,0,,Сіз бүкіл әлемді Бах сияқты боялған көре аласыз.
Dialogue: 0,0:20:11.45,0:20:12.83,Default,,0,0,0,,О, мұнда кел
Dialogue: 0,0:20:13.83,0:20:16.16,Default,,0,0,0,,Ақырында бұл құрылғы жұмыс істеп тұрған сияқты.
Dialogue: 0,0:20:17.00,0:20:18.12,Default,,0,0,0,,Сол жағдай үшін
Dialogue: 0,0:20:18.29,0:20:20.58,Default,,0,0,0,,Бэкдорды орнату жақсы идея болды.
Dialogue: 0,0:20:21.91,0:20:24.45,Default,,0,0,0,,Дүниені ерікті түрде өзгерту мүмкін болса, бұл мәселе болар еді.
Dialogue: 0,0:20:24.87,0:20:27.04,Default,,0,0,0,,Кешіріңіз, бірақ мен оны тоқтатамын.
Dialogue: 0,0:20:30.00,0:20:30.45,Default,,0,0,0,,Бұл
Dialogue: 0,0:20:45.33,0:20:48.66,Default,,0,0,0,,Иә, мен не істеуім керек? Хохохо
Dialogue: 0,0:20:49.25,0:20:51.12,Default,,0,0,0,,- Legato - Fortissimo
Dialogue: 0,0:20:51.25,0:20:52.66,Default,,0,0,0,,Стаккато
Dialogue: 0,0:20:53.41,0:20:57.45,Default,,0,0,0,,О, құдай-ау, саны көбейіп барады хаха.
Dialogue: 0,0:20:57.91,0:20:58.37,Default,,0,0,0,,Ах
Dialogue: 0,0:20:58.58,0:20:59.08,Default,,0,0,0,,Аллегро
Dialogue: 0,0:20:59.20,0:21:01.00,Default,,0,0,0,,-Ал, Сосуке -Аллегретто
Dialogue: 0,0:21:01.12,0:21:02.08,Default,,0,0,0,,Мықты бол, Понкотсу
Dialogue: 0,0:21:02.16,0:21:03.87,Default,,0,0,0,,- Бақыланбаңыз - Авававававававава
Dialogue: 0,0:21:04.16,0:21:07.62,Default,,0,0,0,,А-а-а-а-а-а-а, дәл қазір.
Dialogue: 0,0:21:08.29,0:21:10.50,Default,,0,0,0,,Керемет, қайтып келдіңіз.
Dialogue: 0,0:21:10.83,0:21:13.00,Default,,0,0,0,,-Хаа Сфорзандо -Ааааааааааааааааааааааааааааа
Dialogue: 0,0:21:13.08,0:21:13.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:13.50,0:21:15.75,Default,,0,0,0,,-Utanae n нық -nnnnnnnnnn
Dialogue: 0,0:21:15.83,0:21:18.58,Default,,0,0,0,,А, ха, мен білмей тұрып
Dialogue: 0,0:21:18.75,0:21:21.54,Default,,0,0,0,,Мықты болмасаң, Мюзикке алынасың.
Dialogue: 0,0:21:21.66,0:21:22.12,Default,,0,0,0,,Димину
Dialogue: 0,0:21:22.20,0:21:22.50,Default,,0,0,0,,Ах
Dialogue: 0,0:21:22.58,0:21:23.04,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:21:23.16,0:21:23.87,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:21:24.08,0:21:25.83,Default,,0,0,0,,- ммм - абаба баба баба
Dialogue: 0,0:21:26.87,0:21:27.91,Default,,0,0,0,,Мұның соңы жоқ.
Dialogue: 0,0:21:29.16,0:21:29.70,Default,,0,0,0,,Хмм
Dialogue: 0,0:21:29.95,0:21:30.66,Default,,0,0,0,,Ларго
Dialogue: 0,0:21:31.16,0:21:32.83,Default,,0,0,0,,-Mezzoforte -Сен ренжітетін бейбақтар
Dialogue: 0,0:21:33.16,0:21:36.12,Default,,0,0,0,,Мен сені музыкаммен санаңа қайтарамын.
Dialogue: 0,0:21:40.70,0:21:41.50,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:21:42.29,0:21:43.08,Default,,0,0,0,,Уау
Dialogue: 0,0:21:44.29,0:21:45.25,Default,,0,0,0,,ал екіншісі – «бар күшіңді салу»!
Dialogue: 0,0:21:46.16,0:21:46.95,Default,,0,0,0,,Қауіп-қатер сезімінің жоқтығы.
Dialogue: 0,0:21:47.70,0:21:48.45,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:49.00,0:21:51.16,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:51.75,0:21:53.33,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:21:53.58,0:21:54.33,Default,,0,0,0,,Бұл кішкене.
Dialogue: 0,0:21:54.62,0:21:55.62,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:21:55.83,0:21:57.37,Default,,0,0,0,,-Анданте -Хмм?
Dialogue: 0,0:21:58.20,0:21:59.29,Default,,0,0,0,,Аллегро
Dialogue: 0,0:21:59.41,0:22:00.70,Default,,0,0,0,,Тұрақтау
Dialogue: 0,0:22:02.33,0:22:03.00,Default,,0,0,0,,Nu
Dialogue: 0,0:22:03.45,0:22:04.79,Default,,0,0,0,,Әлі де солай ма?
Dialogue: 0,0:22:05.45,0:22:06.75,Default,,0,0,0,,Бұл қалай да болады.
Dialogue: 0,0:22:07.20,0:22:08.87,Default,,0,0,0,,Мұнда Musik пайдаланушысы бар.
Dialogue: 0,0:22:09.00,0:22:10.54,Default,,0,0,0,,Мұнда 7 адам бар.
Dialogue: 0,0:22:10.95,0:22:12.87,Default,,0,0,0,,Әй?
Dialogue: 0,0:22:13.95,0:22:19.87,Default,,0,0,0,,１ ２ ３ ４ ５ ６
Dialogue: 0,0:22:21.00,0:22:23.87,Default,,0,0,0,,Бір адам жетіспейді, солай ма?
Dialogue: 0,0:22:24.41,0:22:25.08,Default,,0,0,0,,Әрине
Dialogue: 0,0:22:29.45,0:22:32.54,Default,,0,0,0,,Қалыпты
Dialogue: 0,0:23:08.12,0:23:11.66,Default,,0,0,0,,Бұл не? Нақты ашу
Dialogue: 0,0:23:12.08,0:23:15.37,Default,,0,0,0,,Найзағайдай өткір сезімдер
Dialogue: 0,0:23:15.70,0:23:19.20,Default,,0,0,0,,Бұл не? Мен оны тоқтата алмаймын.
Dialogue: 0,0:23:19.54,0:23:25.04,Default,,0,0,0,,Толқыған сезім, балақай
Dialogue: 0,0:24:07.20,0:24:09.00,Default,,0,0,0,,Бұл дүниедегі ең қиын нәрсе
Dialogue: 0,0:24:09.04,0:24:11.25,Default,,0,0,0,,Бұл идеалдар мен құмарлықтардың қосындысы
Dialogue: 0,0:24:11.41,0:24:13.62,Default,,0,0,0,,Байланыс неғұрлым күшті және күшті болса, соғұрлым көп болады
Dialogue: 0,0:24:13.79,0:24:16.04,Default,,0,0,0,,Кристаллдың тазалығы мен жарқырауы артады.
Dialogue: 0,0:24:16.25,0:24:20.29,Default,,0,0,0,,Әй, ол – бар аласапыранның бастауы, қасіреттің бұлағы.
Dialogue: 0,0:24:20.54,0:24:24.29,Default,,0,0,0,,Ашық айтайын: кемелдік, жетілуді аңсау.
Dialogue: 0,0:24:24.62,0:24:27.25,Default,,0,0,0,,Бұл таңу – адамзаттың азабы.
Dialogue: 0,0:24:27.50,0:24:29.29,Default,,0,0,0,,Түсінбесең, тағы айтамын.
Dialogue: 0,0:24:29.50,0:24:32.08,Default,,0,0,0,,Мені жайына қалдыр, мен өз ісімді істеймін.
Dialogue: 0,0:24:33.58,0:24:39.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory