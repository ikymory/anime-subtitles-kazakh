Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.50,0:00:08.75,Default,,0,0,0,,Вояжер планеталық зонд
Dialogue: 0,0:00:09.04,0:00:14.25,Default,,0,0,0,,Бұл 1977 жылы Жерді тастап кеткен ұшқышсыз ғарыш кемесі.
Dialogue: 0,0:00:14.62,0:00:17.25,Default,,0,0,0,,Әлі де ғаламның сыртын көздеу
Dialogue: 0,0:00:17.33,0:00:22.04,Default,,0,0,0,,Сыртқы қабырғасында жарқыраған диск үнсіз ұшып келеді.
Dialogue: 0,0:00:22.20,0:00:24.75,Default,,0,0,0,,Жерден тыс интеллектке дарынды
Dialogue: 0,0:00:24.83,0:00:27.16,Default,,0,0,0,,Супер жинақ альбомы
Dialogue: 0,0:00:27.54,0:00:31.41,Default,,0,0,0,,Әртүрлі тілдерде амандасу және табиғи дыбыстар бар.
Dialogue: 0,0:00:31.70,0:00:34.50,Default,,0,0,0,,Бах Моцарт Бетховен және т.б
Dialogue: 0,0:00:34.70,0:00:39.08,Default,,0,0,0,,Адамзаттың ең жақсы әндерін қамтиды. Аты да
Dialogue: 0,0:00:39.29,0:00:45.75,Default,,0,0,0,,Алтын жазба рекорды
Dialogue: 0,0:02:15.70,0:02:17.87,Default,,0,0,0,,Шынымен бүгін қай күн?
Dialogue: 0,0:02:18.50,0:02:20.25,Default,,0,0,0,,Дүниеден дыбыс кенет жоғалады
Dialogue: 0,0:02:20.50,0:02:25.00,Default,,0,0,0,,Одан кейін парик киіп, музыкалық терминдерді былғап айту құбылысы бар.
Dialogue: 0,0:02:25.62,0:02:29.37,Default,,0,0,0,,Ал қазір әр елдің аспанында белгісіз ұшатын үлкен денелер бар.
Dialogue: 0,0:02:29.54,0:02:32.70,Default,,0,0,0,,Әй, адамдарды сорып жатыр.
Dialogue: 0,0:02:33.50,0:02:37.54,Default,,0,0,0,,Нью-Йорк Париж Мәскеу Пекин Рио
Dialogue: 0,0:02:38.08,0:02:41.00,Default,,0,0,0,,Ал Хамамацу, бұл қалалар?
Dialogue: 0,0:02:41.12,0:02:42.75,Default,,0,0,0,,Сізде қандай кек бар?
Dialogue: 0,0:02:44.12,0:02:45.33,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:45.87,0:02:47.45,Default,,0,0,0,,Қарғыс
Dialogue: 0,0:02:47.66,0:02:49.04,Default,,0,0,0,,Бұл қарғыс емес
Dialogue: 0,0:02:49.16,0:02:50.00,Default,,0,0,0,,НЛО
Dialogue: 0,0:02:50.25,0:02:51.75,Default,,0,0,0,,Бұл галактика сияқты, солай ма?
Dialogue: 0,0:02:52.04,0:02:53.08,Default,,0,0,0,,Керемет
Dialogue: 0,0:02:53.37,0:02:53.79,Default,,0,0,0,,Барлығы
Dialogue: 0,0:02:53.87,0:02:54.33,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:02:54.70,0:02:55.41,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:02:55.79,0:02:58.12,Default,,0,0,0,,Сенпай, аман болшы.
Dialogue: 0,0:02:58.45,0:02:59.00,Default,,0,0,0,,Әрине
Dialogue: 0,0:02:59.16,0:03:00.00,Default,,0,0,0,,Котенка
Dialogue: 0,0:03:00.04,0:03:01.29,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:03:01.33,0:03:03.20,Default,,0,0,0,,Мен уайымдадым.
Dialogue: 0,0:03:03.33,0:03:05.95,Default,,0,0,0,,Бірақ бұл жолы аспанда біртүрлі нәрсе болды.
Dialogue: 0,0:03:06.41,0:03:07.58,Default,,0,0,0,,Дүние жүзі бойынша
Dialogue: 0,0:03:07.62,0:03:08.95,Default,,0,0,0,,- Көңілді сияқты - Мм.
Dialogue: 0,0:03:09.50,0:03:12.79,Default,,0,0,0,,Сәлем Утанае Утанае осында ма?
Dialogue: 0,0:03:13.08,0:03:13.91,Default,,0,0,0,,-Әке? -Ой
Dialogue: 0,0:03:14.45,0:03:17.00,Default,,0,0,0,,Эй, Октова тоқтаған сияқты.
Dialogue: 0,0:03:17.25,0:03:18.83,Default,,0,0,0,,Утанае керемет.
Dialogue: 0,0:03:18.87,0:03:21.04,Default,,0,0,0,,Е, жоқ, ол қайда?
Dialogue: 0,0:03:21.37,0:03:24.91,Default,,0,0,0,,А, сіз оны көре аласыз ба? Менің үйіме де НЛО келді.
Dialogue: 0,0:03:25.16,0:03:27.04,Default,,0,0,0,,Мен Утанаеге көрсету үшін суретке түсіріп жатыр едім.
Dialogue: 0,0:03:27.25,0:03:30.00,Default,,0,0,0,,Мені ұрлап кетті Ахахахахаха
Dialogue: 0,0:03:30.29,0:03:31.04,Default,,0,0,0,,Иә, күткендей.
Dialogue: 0,0:03:31.16,0:03:33.66,Default,,0,0,0,,Жақсы, бөтен, қызықты ма?
Dialogue: 0,0:03:34.04,0:03:34.79,Default,,0,0,0,,Ә? Әйтеуір, ол Мисаға қатты ғашық қой.
Dialogue: 0,0:03:34.91,0:03:35.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:36.08,0:03:42.04,Default,,0,0,0,,Ол көрінбейді, бірақ бұл не деп ойлайсыз?
Dialogue: 0,0:03:42.41,0:03:44.00,Default,,0,0,0,,Хмм? микрофон?
Dialogue: 0,0:03:44.25,0:03:45.75,Default,,0,0,0,,Караокеге барамыз ба?
Dialogue: 0,0:03:46.08,0:03:48.95,Default,,0,0,0,,Бұл караокеге арналған ба? Мен түсінемін.
Dialogue: 0,0:03:49.20,0:03:52.12,Default,,0,0,0,,Сол сызық бойымен аздап зерттеп көрейік.
Dialogue: 0,0:03:52.66,0:03:53.79,Default,,0,0,0,,Не? Эй
Dialogue: 0,0:03:54.50,0:03:55.29,Default,,0,0,0,,-Күтілгендей -А
Dialogue: 0,0:03:55.87,0:03:56.70,Default,,0,0,0,,Бірақ олай болмас қой?
Dialogue: 0,0:03:56.79,0:03:59.20,Default,,0,0,0,,Менің болжам қате болмады.
Dialogue: 0,0:03:59.54,0:04:00.62,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:04:00.87,0:04:03.33,Default,,0,0,0,,Соңында мені осында мінгізді.
Dialogue: 0,0:04:04.00,0:04:08.20,Default,,0,0,0,,Мен мұны әрқашан ғаламның бір жерінде сезіндім
Dialogue: 0,0:04:08.66,0:04:12.79,Default,,0,0,0,,Сіздің жұмысыңыз тыңдалып жатқанын біліңіз және
Dialogue: 0,0:04:13.04,0:04:17.25,Default,,0,0,0,,Бір күні олар Жерге музыка іздеп келеді
Dialogue: 0,0:04:17.66,0:04:18.91,Default,,0,0,0,,Музыка?
Dialogue: 0,0:04:19.62,0:04:21.16,Default,,0,0,0,,Сондай заман келе ме деп ойлаймын
Dialogue: 0,0:04:21.50,0:04:26.00,Default,,0,0,0,,Мен адамдардың музыка арқылы байланысуына мүмкіндік беретін құрылғымын.
Dialogue: 0,0:04:26.91,0:04:28.87,Default,,0,0,0,,Мен Октованы дайындадым.
Dialogue: 0,0:04:29.95,0:04:32.75,Default,,0,0,0,,Бірақ менің ағам бұл құрылғыны сындырған шығар.
Dialogue: 0,0:04:33.04,0:04:33.62,Default,,0,0,0,,Жақсы
Dialogue: 0,0:04:33.79,0:04:34.70,Default,,0,0,0,,Мен де
Dialogue: 0,0:04:35.04,0:04:37.58,Default,,0,0,0,,Мен жеткенде көп бөлігі бұзылып қалыпты.
Dialogue: 0,0:04:37.83,0:04:39.50,Default,,0,0,0,,Бұл жерде ештеңе жоқ
Dialogue: 0,0:04:40.29,0:04:41.25,Default,,0,0,0,,Ах
Dialogue: 0,0:04:44.66,0:04:47.45,Default,,0,0,0,,Октованың шұғыл жөндеу жұмыстары аяқталды.
Dialogue: 0,0:04:47.95,0:04:49.41,Default,,0,0,0,,Бақшада
Dialogue: 0,0:04:50.12,0:04:50.79,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:04:50.87,0:04:53.50,Default,,0,0,0,,Менің ағаларым Классикалоидтар
Dialogue: 0,0:04:53.87,0:04:55.62,Default,,0,0,0,,Енді бір сегіз нотаға айналатын кез келді
Dialogue: 0,0:04:56.04,0:05:00.25,Default,,0,0,0,,Ғарыштан келген қонақтарымызға музыка қойып берейік.
Dialogue: 0,0:05:01.54,0:05:02.50,Default,,0,0,0,,Нажошит
Dialogue: 0,0:05:02.58,0:05:03.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:03.25,0:05:06.66,Default,,0,0,0,,Мен шетелдіктер туралы ешқашан естіген емеспін.
Dialogue: 0,0:05:07.00,0:05:09.62,Default,,0,0,0,,Мен мұндай маңызды нәрсе туралы үндемедім.
Dialogue: 0,0:05:09.66,0:05:11.66,Default,,0,0,0,,-Әрқашан солай.
Dialogue: 0,0:05:11.95,0:05:14.12,Default,,0,0,0,,Айтсам кім сенеді?
Dialogue: 0,0:05:15.37,0:05:18.79,Default,,0,0,0,,Ешкімге сенбейтін – Бах.
Dialogue: 0,0:05:19.12,0:05:20.08,Default,,0,0,0,,Чайко-чан
Dialogue: 0,0:05:21.12,0:05:25.08,Default,,0,0,0,,Бах мырзаның ақымақ ааааааааааааа
Dialogue: 0,0:05:25.16,0:05:26.70,Default,,0,0,0,,-Аа, сен мені жылаттың -Ааа
Dialogue: 0,0:05:26.79,0:05:27.58,Default,,0,0,0,,-Жасырын -Уау
Dialogue: 0,0:05:27.75,0:05:29.45,Default,,0,0,0,,-Бұл сондай күдікті -Уау уау уау
Dialogue: 0,0:05:29.54,0:05:30.45,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:05:30.58,0:05:31.25,Default,,0,0,0,,-Келісемін -Уау.
Dialogue: 0,0:05:31.41,0:05:34.83,Default,,0,0,0,,-Ол бақшаны қашан жөндей аласың? -Ууууууууууууууу
Dialogue: 0,0:05:35.12,0:05:40.54,Default,,0,0,0,,-Ой, балалар сендер жерді ойламайсыңдар -У-Ааааааааааааааааа
Dialogue: 0,0:05:41.00,0:05:42.75,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:42.79,0:05:44.75,Default,,0,0,0,,- Әй, Сосуке не болды? - Нууу
Dialogue: 0,0:05:44.83,0:05:46.50,Default,,0,0,0,,Кенет сарайдан қашып кету
Dialogue: 0,0:05:46.83,0:05:48.79,Default,,0,0,0,,Сіз Бах мырзаның әңгімесін естіген жоқсыз ба?
Dialogue: 0,0:05:49.00,0:05:49.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:49.70,0:05:52.25,Default,,0,0,0,,Мүмкін мен қазір әлемді құтқара алармын
Dialogue: 0,0:05:52.91,0:05:53.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:53.87,0:05:56.00,Default,,0,0,0,,Менің музыкаммен әлемді құтқарыңыз
Dialogue: 0,0:05:56.08,0:05:58.25,Default,,0,0,0,,Ең жақсы емес, иә?
Dialogue: 0,0:05:59.95,0:06:02.00,Default,,0,0,0,,Увааааааааааааааааааааааа
Dialogue: 0,0:06:02.29,0:06:04.16,Default,,0,0,0,,Хе хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи хи ҳи
Dialogue: 0,0:06:04.29,0:06:05.87,Default,,0,0,0,,Хаа ха ха
Dialogue: 0,0:06:06.16,0:06:07.54,Default,,0,0,0,,-nguh -ngaa
Dialogue: 0,0:06:09.04,0:06:14.95,Default,,0,0,0,,Мен оны жай қалдырсам ба деп ойлаймын. О, Сосуке?
Dialogue: 0,0:06:15.75,0:06:18.25,Default,,0,0,0,,Иә, НЛО!
Dialogue: 0,0:06:18.58,0:06:20.37,Default,,0,0,0,,Иә? Сіз НЛО-дасыз ба?
Dialogue: 0,0:06:20.45,0:06:21.66,Default,,0,0,0,,Сіз қанша уақыт болдыңыз?
Dialogue: 0,0:06:21.75,0:06:22.83,Default,,0,0,0,,Жақсы
Dialogue: 0,0:06:22.91,0:06:26.37,Default,,0,0,0,,Қызық, мен үлкен боламын ба? Жүректен шыққан түпнұсқа әнмен
Dialogue: 0,0:06:26.62,0:06:30.66,Default,,0,0,0,,Жер мен ғаламның арасындағы көпір болсам ғой.
Dialogue: 0,0:06:30.87,0:06:31.79,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:31.91,0:06:33.58,Default,,0,0,0,,Сосуке, түсіндің бе?
Dialogue: 0,0:06:33.62,0:06:36.00,Default,,0,0,0,,Сенің әнің әлемді жоюы мүмкін...
Dialogue: 0,0:06:42.16,0:06:43.70,Default,,0,0,0,,Міне, бауырлар
Dialogue: 0,0:06:44.45,0:06:48.25,Default,,0,0,0,,Жетілмеген қарым-қатынастың аянышты аяқталуы
Dialogue: 0,0:06:49.16,0:06:55.62,Default,,0,0,0,,-Мен Лулулала, ешкім емеспін -Уау
Dialogue: 0,0:06:55.91,0:07:00.16,Default,,0,0,0,,-Мен Лулулара Ішінде не бар... -Ааа
Dialogue: 0,0:07:01.54,0:07:06.20,Default,,0,0,0,,Не? Аааааааааааа?
Dialogue: 0,0:07:09.29,0:07:13.20,Default,,0,0,0,,Міне.
Dialogue: 0,0:07:14.20,0:07:16.29,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:07:16.79,0:07:18.25,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:07:19.37,0:07:23.25,Default,,0,0,0,,Жоқ, бүкіл әлемде бірдей жағдай болады.
Dialogue: 0,0:07:23.54,0:07:27.66,Default,,0,0,0,,Сосукенің әні қандай сұмдық!
Dialogue: 0,0:07:28.41,0:07:29.16,Default,,0,0,0,,Котенка
Dialogue: 0,0:07:30.54,0:07:31.33,Default,,0,0,0,,Бах мырза
Dialogue: 0,0:07:32.20,0:07:34.58,Default,,0,0,0,,Адамгершілікті мүлде қате түсінді
Dialogue: 0,0:07:35.08,0:07:36.95,Default,,0,0,0,,Сіздің айтқаныңыз рас па?
Dialogue: 0,0:07:37.54,0:07:39.08,Default,,0,0,0,,Егер сіз Октовада музыка ойнасаңыз
Dialogue: 0,0:07:39.33,0:07:41.20,Default,,0,0,0,,Сіз шетелдіктермен достаса аласыз ба?
Dialogue: 0,0:07:43.45,0:07:43.95,Default,,0,0,0,,Иә
Dialogue: 0,0:07:44.95,0:07:46.83,Default,,0,0,0,,Мм
Dialogue: 0,0:07:47.83,0:07:50.04,Default,,0,0,0,,Барлығы Шугоу
Dialogue: 0,0:07:50.41,0:07:52.16,Default,,0,0,0,,Ештеңе жасамаған дұрыс па?
Dialogue: 0,0:07:52.50,0:07:54.12,Default,,0,0,0,,Классикалоид не үшін?
Dialogue: 0,0:07:54.50,0:07:57.45,Default,,0,0,0,,Жерді құтқара алатын болсақ та...
Dialogue: 0,0:07:59.12,0:08:00.16,Default,,0,0,0,,Біріктірілмейді
Dialogue: 0,0:08:00.41,0:08:02.25,Default,,0,0,0,,Ер адамның жоспарымен бірге жүрме
Dialogue: 0,0:08:02.50,0:08:04.95,Default,,0,0,0,,-А-а-хмм
Dialogue: 0,0:08:11.62,0:08:15.37,Default,,0,0,0,,Қандай жатықтар мен залдар?
Dialogue: 0,0:08:18.33,0:08:23.41,Default,,0,0,0,,Иә, барлығыңыз маған көмектесіңіздерші.
Dialogue: 0,0:08:26.58,0:08:27.41,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:27.62,0:08:28.08,Default,,0,0,0,,Га
Dialogue: 0,0:08:28.75,0:08:31.79,Default,,0,0,0,,Утанаенің өтініші Бұл өте сирек, сондықтан сұрау керек деп ойлаймын.
Dialogue: 0,0:08:32.08,0:08:35.08,Default,,0,0,0,,Ғимаратқа сараң болма, тек Хамамацуды құтқар.
Dialogue: 0,0:08:35.37,0:08:38.08,Default,,0,0,0,,Хамамацу үшін, яғни Джоза үшін
Dialogue: 0,0:08:38.37,0:08:40.87,Default,,0,0,0,,Джоза үшін, яғни үлкендер үшін.
Dialogue: 0,0:08:41.33,0:08:44.04,Default,,0,0,0,,Бұл үлкен механикпен бір нәрсені үнемдейтін ойын сияқты.
Dialogue: 0,0:08:44.33,0:08:45.75,Default,,0,0,0,,Басынан бастап, котенка
Dialogue: 0,0:08:45.79,0:08:48.50,Default,,0,0,0,,Сіз сұрауыңыз керек еді, солай ма?
Dialogue: 0,0:08:48.95,0:08:49.58,Default,,0,0,0,,Нуу
Dialogue: 0,0:08:50.33,0:08:51.83,Default,,0,0,0,,- барлығы
Dialogue: 0,0:08:53.00,0:08:54.33,Default,,0,0,0,,Хмм хаа
Dialogue: 0,0:08:54.91,0:08:55.12,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:08:55.20,0:08:55.70,Default,,0,0,0,,Уф
Dialogue: 0,0:08:58.66,0:09:00.83,Default,,0,0,0,,Ууууууууу
Dialogue: 0,0:09:01.16,0:09:02.37,Default,,0,0,0,,-Бааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:09:02.62,0:09:04.45,Default,,0,0,0,,Жетер, дәл осы жолы.
Dialogue: 0,0:09:04.62,0:09:06.58,Default,,0,0,0,,Мен сыйлық күтемін.
Dialogue: 0,0:09:07.54,0:09:08.00,Default,,0,0,0,,Иә
Dialogue: 0,0:09:08.62,0:09:09.25,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:09.37,0:09:09.79,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:09:11.45,0:09:14.66,Default,,0,0,0,,Мен жер туралы айтқанда, мен де әкем туралы сұрағым келеді.
Dialogue: 0,0:09:16.37,0:09:19.16,Default,,0,0,0,,Иә Анданте
Dialogue: 0,0:09:24.16,0:09:29.08,Default,,0,0,0,,Асықпаңдар ғаламның достары, Біз жау емеспіз.
Dialogue: 0,0:09:29.54,0:09:32.50,Default,,0,0,0,,Осы сегіз нота ойнаған үндестікте
Dialogue: 0,0:09:33.16,0:09:37.25,Default,,0,0,0,,Жер бетіндегі адамзаттың мәніне қараңыз.
Dialogue: 0,0:09:37.29,0:09:41.79,Default,,0,0,0,,Барлығы махаббаттан туындайды
Dialogue: 0,0:09:43.54,0:09:47.00,Default,,0,0,0,,Миллиондаған жарық жылдарын кесіп өткен достардың жүректерін қозғайық
Dialogue: 0,0:09:47.54,0:09:48.16,Default,,0,0,0,,Біздің
Dialogue: 0,0:09:48.83,0:09:51.58,Default,,0,0,0,,Музыка
Dialogue: 0,0:09:59.50,0:10:02.16,Default,,0,0,0,,Мен сендерге жердегі қазыналарды көрсетемін.
Dialogue: 0,0:10:02.37,0:10:07.04,Default,,0,0,0,,-Барлығы қорғалған -Қыздың пәк жүрегі
Dialogue: 0,0:10:09.16,0:10:12.08,Default,,0,0,0,,Жердің ең жақсысы – достық.
Dialogue: 0,0:10:12.62,0:10:17.33,Default,,0,0,0,,-Арақ ішсең, жат планеталықтар да сенің досың. -Бәрі кешіріледі, содан басталады.
Dialogue: 0,0:10:19.20,0:10:21.75,Default,,0,0,0,,Адамдардың жақсы көретінін айтудың қажеті жоқ
Dialogue: 0,0:10:22.12,0:10:27.41,Default,,0,0,0,,-Сүйіспеншілік-кешірімділік,ол біздің болмысымыз -Әр адам махаббатпен қоршалған.
Dialogue: 0,0:10:28.20,0:10:31.25,Default,,0,0,0,,Бейтаныс адамдар қорқынышты, бірақ сен
Dialogue: 0,0:10:31.75,0:10:34.45,Default,,0,0,0,,Мүмкін мен мұны істей аламын, өйткені мен адам емеспін.
Dialogue: 0,0:10:36.29,0:10:39.66,Default,,0,0,0,,-Музыкаға деген адал, байсалды көзқарас -Әркім
Dialogue: 0,0:10:40.00,0:10:42.75,Default,,0,0,0,,– құрметке лайық – сүйіспеншілікпен қоршалған
Dialogue: 0,0:10:43.75,0:10:46.75,Default,,0,0,0,,Армандай өмір сүріп, қалағандай жарқыра
Dialogue: 0,0:10:47.08,0:10:49.79,Default,,0,0,0,,Міне, біз адамдармыз, солай ма?
Dialogue: 0,0:10:53.20,0:10:55.41,Default,,0,0,0,,-Өнерді жасайтын адам -Бұл дүние тым көп ағып жатыр
Dialogue: 0,0:10:55.50,0:11:01.29,Default,,0,0,0,,-   -
Dialogue: 0,0:11:01.95,0:11:05.91,Default,,0,0,0,,-Кейде жүрегім оттайды -Досым
Dialogue: 0,0:11:07.08,0:11:14.29,Default,,0,0,0,,-Жерге қош келдіңіз -Әр адам бейбітшілікті тілейді, бірақ
Dialogue: 0,0:11:14.70,0:11:16.45,Default,,0,0,0,,Қызғаныш
Dialogue: 0,0:11:23.62,0:11:26.50,Default,,0,0,0,,Ах, күткендей.
Dialogue: 0,0:11:27.25,0:11:27.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:28.58,0:11:31.20,Default,,0,0,0,,Увааааааааааааааааааа
Dialogue: 0,0:11:32.83,0:11:34.33,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:34.45,0:11:36.54,Default,,0,0,0,,Жан-жақтан сорғалаған адамдар кенет түкіріп кетті.
Dialogue: 0,0:11:36.62,0:11:38.45,Default,,0,0,0,,Мен бәрінің әуенін еститінмін
Dialogue: 0,0:11:39.20,0:11:43.41,Default,,0,0,0,,Сондықтан барлығын, соның ішінде Хамамацу тұрғындарын қайтарыңыз.
Dialogue: 0,0:11:44.20,0:11:47.12,Default,,0,0,0,,Ой, ой
Dialogue: 0,0:11:48.66,0:11:49.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:49.70,0:11:51.16,Default,,0,0,0,,Не?
Dialogue: 0,0:11:53.50,0:11:54.75,Default,,0,0,0,,(5-сынып оқушысы 5) Сүтсіз. (4-сынып оқушысы 4) Жырт.
Dialogue: 0,0:11:57.37,0:11:59.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:00.79,0:12:04.04,Default,,0,0,0,,Уақытша жөндеу жұмыстарының бәрі осы ма?
Dialogue: 0,0:12:04.12,0:12:05.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:10.79,0:12:12.16,Default,,0,0,0,,Бұл адам мені священник деп қате түсінген
Dialogue: 0,0:12:12.70,0:12:20.41,Default,,0,0,0,,Тағы бір рет Тағы бір рет Тағы бір рет
Dialogue: 0,0:12:20.95,0:12:28.70,Default,,0,0,0,,Тағы бір рет Тағы бір рет Тағы бір рет
Dialogue: 0,0:12:28.91,0:12:32.95,Default,,0,0,0,,-Жағдай қиындап барады -Тағы бір рет Тағы бір рет
Dialogue: 0,0:12:39.29,0:12:42.45,Default,,0,0,0,,Тағы бір рет Тағы бір рет
Dialogue: 0,0:12:42.66,0:12:46.20,Default,,0,0,0,,-Тағы бір рет Тағы бір рет-Ха ха ха
Dialogue: 0,0:12:46.33,0:12:49.29,Default,,0,0,0,,Тағы бір рет, тез, тез
Dialogue: 0,0:12:52.91,0:12:54.08,Default,,0,0,0,,Қандай айуандық
Dialogue: 0,0:12:54.45,0:12:56.29,Default,,0,0,0,,Мен тіл табысқым келді.
Dialogue: 0,0:12:56.41,0:12:57.54,Default,,0,0,0,,Махаббат тым аз
Dialogue: 0,0:12:58.04,0:13:02.20,Default,,0,0,0,,Хамамацу мен жер жойылады, бұл сарай да жойылады.
Dialogue: 0,0:13:02.37,0:13:03.04,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:13:03.12,0:13:03.91,Default,,0,0,0,,Ах
Dialogue: 0,0:13:04.12,0:13:07.04,Default,,0,0,0,,Иә, музыка өтіп жатыр.
Dialogue: 0,0:13:08.04,0:13:09.62,Default,,0,0,0,,Олар жай ғана күтіп тұр.
Dialogue: 0,0:13:10.20,0:13:11.16,Default,,0,0,0,,Сосуке
Dialogue: 0,0:13:12.66,0:13:14.45,Default,,0,0,0,,Сондықтан олар жау емес.
Dialogue: 0,0:13:14.95,0:13:15.79,Default,,0,0,0,,Мен түкіріп қалдым, бірақ
Dialogue: 0,0:13:15.91,0:13:18.00,Default,,0,0,0,,Мен жерге ақырын қонып, әбден жақсы болдым.
Dialogue: 0,0:13:18.58,0:13:19.70,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:13:20.04,0:13:21.41,Default,,0,0,0,,Бірақ олар шабуылдауда
Dialogue: 0,0:13:21.79,0:13:25.08,Default,,0,0,0,,Маған көбірек музыка керек, солай ма?
Dialogue: 0,0:13:25.58,0:13:27.66,Default,,0,0,0,,Көрермендер концерт аяқталғаннан кейін кетпейді
Dialogue: 0,0:13:27.70,0:13:29.50,Default,,0,0,0,,Мен қол соғып, күтемін.
Dialogue: 0,0:13:30.16,0:13:32.20,Default,,0,0,0,,Міне, болды, болды
Dialogue: 0,0:13:32.62,0:13:34.91,Default,,0,0,0,,Бірақ олар ғимаратты құлатпайды.
Dialogue: 0,0:13:35.25,0:13:38.83,Default,,0,0,0,,Толқып тұрсың, шыдай алмаймын. Мен түссіндім.
Dialogue: 0,0:13:38.91,0:13:42.58,Default,,0,0,0,,Сол сезім, мен ақшаны үнемдеп, ата-анамды сендіруім керек.
Dialogue: 0,0:13:42.91,0:13:44.45,Default,,0,0,0,,Мен тыңдау үшін ақыры осы уақытқа дейін келдім.
Dialogue: 0,0:13:44.70,0:13:47.50,Default,,0,0,0,,Бұл соңы емес, мен одан да көп нәрсені қалаймын.
Dialogue: 0,0:13:47.87,0:13:49.41,Default,,0,0,0,,Бірақ Октова бұзылды
Dialogue: 0,0:13:49.45,0:13:50.83,Default,,0,0,0,,Сіз жабдықтың ақаулары туралы білесіз бе?
Dialogue: 0,0:13:51.45,0:13:53.29,Default,,0,0,0,,Келемін деп қиналған қонақ.
Dialogue: 0,0:13:53.70,0:13:55.20,Default,,0,0,0,,Мен осылай дедім
Dialogue: 0,0:13:55.58,0:13:57.83,Default,,0,0,0,,Сонша музыканы қалай алдың?
Dialogue: 0,0:13:58.00,0:13:59.75,Default,,0,0,0,,Мен қызып кеттім. Мен қызып кеттім.
Dialogue: 0,0:14:00.00,0:14:00.62,Default,,0,0,0,,Хун
Dialogue: 0,0:14:02.33,0:14:03.08,Default,,0,0,0,,Ах
Dialogue: 0,0:14:04.83,0:14:06.20,Default,,0,0,0,,Encore?
Dialogue: 0,0:14:06.66,0:14:09.29,Default,,0,0,0,,Шетелдік қыздар көп пе?
Dialogue: 0,0:14:10.12,0:14:10.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:11.12,0:14:13.29,Default,,0,0,0,,Шынымен жасайсың ба?
Dialogue: 0,0:14:13.62,0:14:14.25,Default,,0,0,0,,Мочи
Dialogue: 0,0:14:16.66,0:14:17.37,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:14:17.54,0:14:22.37,Default,,0,0,0,,Бірінші рет ерекше көңілді музыка
Dialogue: 0,0:14:22.95,0:14:23.50,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:14:26.58,0:14:31.70,Default,,0,0,0,,А-а, уау, бірдеңе келе жатыр, бірдеңе келе жатыр.
Dialogue: 0,0:14:32.33,0:14:33.25,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:14:36.33,0:14:39.25,Default,,0,0,0,,Уххёооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооооуууууууууууууууууууу
Dialogue: 0,0:14:39.45,0:14:40.20,Default,,0,0,0,,Суретке түсіру Суретке түсіру
Dialogue: 0,0:14:40.37,0:14:41.00,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:14:41.54,0:14:43.12,Default,,0,0,0,,Жоқ, жоқ, жоқ.
Dialogue: 0,0:14:43.50,0:14:46.79,Default,,0,0,0,,Эй, сен Сосукені түрлендіру арқылы не істейсің?
Dialogue: 0,0:14:47.29,0:14:48.91,Default,,0,0,0,,Жерді сақта
Dialogue: 0,0:14:49.08,0:14:49.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:50.12,0:14:53.70,Default,,0,0,0,,Иә, мен? Енді ән жоқ
Dialogue: 0,0:14:53.79,0:14:55.58,Default,,0,0,0,,Маған үзіліс беріңізші.
Dialogue: 0,0:14:55.75,0:14:56.91,Default,,0,0,0,,-фуфуфуфуфу -уф
Dialogue: 0,0:14:57.04,0:14:57.87,Default,,0,0,0,,Біраз
Dialogue: 0,0:14:58.12,0:15:01.08,Default,,0,0,0,,Мен Жерді Сосуке сияқты адамға қалдыра алмаймын.
Dialogue: 0,0:15:02.75,0:15:04.20,Default,,0,0,0,,Келесі мақсатым —
Dialogue: 0,0:15:05.25,0:15:08.00,Default,,0,0,0,,Жарайды, мен қазір барамын.
Dialogue: 0,0:15:08.29,0:15:08.83,Default,,0,0,0,,-Иә -А
Dialogue: 0,0:15:09.08,0:15:10.79,Default,,0,0,0,,Бір адамға қосымша
Dialogue: 0,0:15:11.54,0:15:12.41,Default,,0,0,0,,-Жақсы жұмыс -А
Dialogue: 0,0:15:15.87,0:15:19.70,Default,,0,0,0,,Біз сізге ең жақсы бейнені көрсетейік.
Dialogue: 0,0:15:21.62,0:15:22.29,Default,,0,0,0,,Га
Dialogue: 0,0:15:28.79,0:15:29.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:39.87,0:15:42.54,Default,,0,0,0,,Хусси, кеттік.
Dialogue: 0,0:15:45.54,0:15:45.95,Default,,0,0,0,,-Жерді, өз үйімізді қорғау үшін -Гаааааааа
Dialogue: 0,0:15:46.00,0:15:47.04,Default,,0,0,0,,Көңіл-күйіңіз жақсы емес пе?
Dialogue: 0,0:15:47.45,0:15:49.45,Default,,0,0,0,,Ақырында, шетелдіктердің көңілін кім көтеруі керек?
Dialogue: 0,0:15:49.75,0:15:51.62,Default,,0,0,0,,Классикоид емес
Dialogue: 0,0:15:52.25,0:15:54.25,Default,,0,0,0,,Кәдімгі жерлендіруші болуы керек
Dialogue: 0,0:15:54.62,0:15:57.91,Default,,0,0,0,,Сондықтан біз музыкамызды жеткіземіз
Dialogue: 0,0:15:58.37,0:16:00.25,Default,,0,0,0,,Оны бастаған Сосуке болды.
Dialogue: 0,0:16:00.62,0:16:03.16,Default,,0,0,0,,Сіз бұл екеуін жібересіз бе? Шын айтасың ба?
Dialogue: 0,0:16:03.33,0:16:06.70,Default,,0,0,0,,Соңғы бастық шайқасына 1-деңгейдегі кейіпкерді жіберетін жын ойыны
Dialogue: 0,0:16:07.08,0:16:08.00,Default,,0,0,0,,Бұл негізсіз YO
Dialogue: 0,0:16:08.50,0:16:09.83,Default,,0,0,0,,Жер тағдыры
Dialogue: 0,0:16:10.20,0:16:11.41,Default,,0,0,0,,Бұл екі адам?
Dialogue: 0,0:16:12.58,0:16:14.95,Default,,0,0,0,,Бұл адамзаттың шешімі ме?
Dialogue: 0,0:16:15.66,0:16:17.95,Default,,0,0,0,,Ол жаққа жалғыз бару әуре-сарсаң.
Dialogue: 0,0:16:18.25,0:16:19.45,Default,,0,0,0,,Нәрсе айтып тұрған сияқты.
Dialogue: 0,0:16:20.41,0:16:20.95,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:16:21.58,0:16:24.50,Default,,0,0,0,,Жылдам қарқын
Dialogue: 0,0:16:24.54,0:16:25.66,Default,,0,0,0,,-Кяааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:16:26.16,0:16:32.66,Default,,0,0,0,,Олай болса, барып, ең жақсы музыкамды жеткізейік.
Dialogue: 0,0:16:32.75,0:16:35.00,Default,,0,0,0,,Дооооооо
Dialogue: 0,0:16:36.62,0:16:38.58,Default,,0,0,0,,-Олар тым тез жазылды -Әлем - МУЗЫКА!
Dialogue: 0,0:16:38.62,0:16:40.54,Default,,0,0,0,,-Кез келген адам жасай алады -Тездесу керек
Dialogue: 0,0:16:40.58,0:16:42.54,Default,,0,0,0,,-Ноннон Утанае -Бәріне ұнайды
Dialogue: 0,0:16:42.58,0:16:44.83,Default,,0,0,0,,Бұл да сізді мазасыздандыратын музыканың бір бөлігі.
Dialogue: 0,0:16:45.41,0:16:48.16,Default,,0,0,0,,Мұндай көзқарас бір күні аудиторияны ашуландырады.
Dialogue: 0,0:16:48.50,0:16:49.25,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:16:49.58,0:16:50.58,Default,,0,0,0,,Ахххх
Dialogue: 0,0:16:50.75,0:16:51.16,Default,,0,0,0,,Ах
Dialogue: 0,0:16:51.83,0:16:53.45,Default,,0,0,0,,Ахахха Ахахха
Dialogue: 0,0:16:53.66,0:16:55.16,Default,,0,0,0,,Неліктен бұл қызықты?
Dialogue: 0,0:16:55.33,0:16:57.66,Default,,0,0,0,,Өйткені біз қазір жерді құтқарамыз, солай ма?
Dialogue: 0,0:16:58.00,0:16:59.16,Default,,0,0,0,,Бұл керемет, солай емес пе?
Dialogue: 0,0:16:59.50,0:17:00.12,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:17:03.20,0:17:04.66,Default,,0,0,0,,А-а-а
Dialogue: 0,0:17:04.70,0:17:05.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:05.58,0:17:07.79,Default,,0,0,0,,Мен оны онлайн көрсетуім керек еді.
Dialogue: 0,0:17:07.95,0:17:10.33,Default,,0,0,0,,Мұның бәрі рұқсат алу үшін емес пе? Бұл
Dialogue: 0,0:17:10.54,0:17:13.75,Default,,0,0,0,,Ахахха Бұл бізге көмектесуіміз керек
Dialogue: 0,0:17:15.37,0:17:17.87,Default,,0,0,0,,Қазіргі адамдарға дейін
Dialogue: 0,0:17:17.95,0:17:20.37,Default,,0,0,0,,-Музыка маңызды -Қорықпа, қызым
Dialogue: 0,0:17:20.41,0:17:22.95,Default,,0,0,0,,-Мен сені сүйемін -Жақсымын.Қашып кетсем зәулім үй де, қала да жоқ болады.
Dialogue: 0,0:17:23.08,0:17:24.37,Default,,0,0,0,,Барлығы жойылады
Dialogue: 0,0:17:24.75,0:17:27.00,Default,,0,0,0,,Сіз бұл туралы ойласаңыз, онда қорқынышты ештеңе жоқ.
Dialogue: 0,0:17:29.66,0:17:31.45,Default,,0,0,0,,О, сен күшейдің.
Dialogue: 0,0:17:31.75,0:17:33.25,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:17:33.75,0:17:35.45,Default,,0,0,0,,Біздің танысқанымыз сіздің арқаңызда.
Dialogue: 0,0:17:35.95,0:17:37.79,Default,,0,0,0,,Мен мүлдем бақытты емеспін.
Dialogue: 0,0:17:39.83,0:17:41.37,Default,,0,0,0,,Лу мырза, мен тез кіремін.
Dialogue: 0,0:17:41.58,0:17:42.54,Default,,0,0,0,,Жақсы, Қасқыр.
Dialogue: 0,0:17:42.79,0:17:43.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:43.29,0:17:44.04,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:17:44.20,0:17:47.87,Default,,0,0,0,,Уф уаааааааааааааааааааааа
Dialogue: 0,0:17:48.08,0:17:48.58,Default,,0,0,0,,Га
Dialogue: 0,0:17:53.75,0:17:54.20,Default,,0,0,0,,Га
Dialogue: 0,0:17:55.00,0:17:57.00,Default,,0,0,0,,Иә
Dialogue: 0,0:17:58.12,0:17:59.62,Default,,0,0,0,,Мен өлемін деп ойладым
Dialogue: 0,0:18:00.25,0:18:02.33,Default,,0,0,0,,Өйткені, ол адамдарды жаман пайдаланушы.
Dialogue: 0,0:18:04.54,0:18:07.66,Default,,0,0,0,,Ой, уау
Dialogue: 0,0:18:08.50,0:18:14.66,Default,,0,0,0,,...
Dialogue: 0,0:18:14.87,0:18:15.41,Default,,0,0,0,,Бето
Dialogue: 0,0:18:15.50,0:18:16.75,Default,,0,0,0,,- -
Dialogue: 0,0:18:16.79,0:18:21.25,Default,,0,0,0,,-  -
Dialogue: 0,0:18:21.29,0:18:24.25,Default,,0,0,0,,Теңдесі жоқ кездесулер мен жаңа достар
Dialogue: 0,0:18:24.79,0:18:29.16,Default,,0,0,0,,Енді жерді тойлайтын мерекелік кешті безендірейік
Dialogue: 0,0:18:41.66,0:18:46.91,Default,,0,0,0,,Музыканы тыңдау.
Dialogue: 0,0:18:47.00,0:18:49.75,Default,,0,0,0,,- Өмір торнадосы - НЛО
Dialogue: 0,0:18:49.79,0:18:50.58,Default,,0,0,0,,Барлығы
Dialogue: 0,0:18:50.66,0:18:53.50,Default,,0,0,0,,-Ноталар дауылы -Оматаасе
Dialogue: 0,0:18:53.62,0:18:57.16,Default,,0,0,0,,- Classicaloid Indahous - Гитара гуілдеп тұр
Dialogue: 0,0:18:57.20,0:19:00.41,Default,,0,0,0,,-Сіз көп еркелік ойнадыңыз, күте алмадыңыз ба? - Ғарышта
Dialogue: 0,0:19:00.45,0:19:02.87,Default,,0,0,0,,-Ыстық шақыру, Ғаламның махаббаты -Түкіру
Dialogue: 0,0:19:02.91,0:19:07.04,Default,,0,0,0,,-Маған жақсы ма? - Аршыған және күлкіге толы
Dialogue: 0,0:19:07.20,0:19:14.29,Default,,0,0,0,,-Досым, біз күткенбіз -Біз армандағандай жаңа дүние күтіп тұр.
Dialogue: 0,0:19:14.62,0:19:21.08,Default,,0,0,0,,Болашақтың есігі сенің жүрегіңде
Dialogue: 0,0:19:21.29,0:19:28.25,Default,,0,0,0,,Біз баратын жаңа әлемді таптық.
Dialogue: 0,0:19:31.66,0:19:34.50,Default,,0,0,0,,Түрі мен сөздері бөлек болғанымен
Dialogue: 0,0:19:34.79,0:19:37.79,Default,,0,0,0,,Музыка бізді бір етеді
Dialogue: 0,0:19:38.16,0:19:40.66,Default,,0,0,0,,Бірге ән айтайық
Dialogue: 0,0:19:41.04,0:19:47.41,Default,,0,0,0,,Өмір мен қуаныш әні
Dialogue: 0,0:19:51.45,0:19:55.04,Default,,0,0,0,,-Тұңғиық қараңғылық -Бірдеңе жеткізіледі, жеткізіледі
Dialogue: 0,0:19:55.83,0:19:56.58,Default,,0,0,0,,Біз тез әрекет етуіміз керек
Dialogue: 0,0:19:56.70,0:20:01.04,Default,,0,0,0,,Бұдан әрі
Dialogue: 0,0:20:06.37,0:20:09.87,Default,,0,0,0,,МУСИК!
Dialogue: 0,0:20:10.04,0:20:12.12,Default,,0,0,0,,Келесі жолы кездессек, кездесуге барайық.
Dialogue: 0,0:20:12.70,0:20:18.91,Default,,0,0,0,,-Музыка! -Осылайша тағдыр достықтың есігін ашады
Dialogue: 0,0:20:26.87,0:20:29.87,Default,,0,0,0,,Ууууууууууууууууууууууууууууу
Dialogue: 0,0:20:29.95,0:20:34.41,Default,,0,0,0,,Ууууууууууууууууууууууу
Dialogue: 0,0:20:38.08,0:20:42.00,Default,,0,0,0,,Иә? иә? Хоаааааааааааааааааааааа
Dialogue: 0,0:20:45.54,0:20:47.70,Default,,0,0,0,,Қол қойыңыз
Dialogue: 0,0:20:47.83,0:20:50.12,Default,,0,0,0,,Е, а, а, сонда.
Dialogue: 0,0:20:50.41,0:20:53.00,Default,,0,0,0,,Оны үйге апарып, бәріне хабарлама жазыңыз, иә?
Dialogue: 0,0:20:53.37,0:20:55.29,Default,,0,0,0,,-Шашашашашашаша -Чоннн Маған аздап көмектесе аласыз ба?
Dialogue: 0,0:20:55.75,0:20:56.66,Default,,0,0,0,,...
Dialogue: 0,0:20:57.70,0:20:59.87,Default,,0,0,0,,Бұл Сосукенің қолы емес...
Dialogue: 0,0:20:59.95,0:21:01.58,Default,,0,0,0,,Ооооо рахмет
Dialogue: 0,0:21:01.66,0:21:03.08,Default,,0,0,0,,- Иә? Жарайды ма? -Ооооооооо
Dialogue: 0,0:21:03.33,0:21:05.25,Default,,0,0,0,,-Еееееееееееееееееееееееееееееееееееееееееееееееееееееееек
Dialogue: 0,0:21:05.29,0:21:08.83,Default,,0,0,0,,-Уаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:21:24.45,0:21:28.04,Default,,0,0,0,,Осылайша, ғаламның керемет әуесқой музыка әуесқойлары
Dialogue: 0,0:21:28.08,0:21:31.45,Default,,0,0,0,,Қанағаттанған оралу, жер құтқарылды
Dialogue: 0,0:21:32.62,0:21:35.33,Default,,0,0,0,,Енді, бірнеше аптадан кейін
Dialogue: 0,0:21:37.75,0:21:42.58,Default,,0,0,0,,Әке, мен ұмытып кетіппін.
Dialogue: 0,0:21:43.50,0:21:47.00,Default,,0,0,0,,Утанае Көп уақыт өтті. Сіз уайымдадыңыз ба?
Dialogue: 0,0:21:48.20,0:21:51.75,Default,,0,0,0,,Мен әлі де алаңсыз, салауатты өмір сүріп жатырмын, сондықтан бәрібір.
Dialogue: 0,0:21:52.33,0:21:53.45,Default,,0,0,0,,Әке сияқты
Dialogue: 0,0:21:54.20,0:21:56.33,Default,,0,0,0,,Жақында сол шетелдіктер
Dialogue: 0,0:21:56.54,0:21:59.95,Default,,0,0,0,,Мен жердің музыкасын қалай білдіңдер деп сұрадым.
Dialogue: 0,0:22:00.54,0:22:03.37,Default,,0,0,0,,Менің ойымша, олар мұны Вояжерде естіді.
Dialogue: 0,0:22:04.08,0:22:05.79,Default,,0,0,0,,Баяғыда теледидардан бірге көргенбіз.
Dialogue: 0,0:22:06.75,0:22:08.91,Default,,0,0,0,,Бұл ғарышқа тасымалданды.
Dialogue: 0,0:22:09.12,0:22:11.12,Default,,0,0,0,,Алтынның алтын жазбасы
Dialogue: 0,0:22:12.41,0:22:14.41,Default,,0,0,0,,Ол кезде мен армандаған жаңа дәуір
Dialogue: 0,0:22:14.87,0:22:16.95,Default,,0,0,0,,Бұл жаңа ғана келгеніңізді білдіреді.
Dialogue: 0,0:22:17.79,0:22:19.45,Default,,0,0,0,,Егер мұндай тұтынушылар келе берсе,
Dialogue: 0,0:22:19.87,0:22:21.20,Default,,0,0,0,,Маған қонақжайлылық көрсет.
Dialogue: 0,0:22:22.45,0:22:24.91,Default,,0,0,0,,Әке, сіздің жақсы болғаныңызға қуаныштымын.
Dialogue: 0,0:22:26.04,0:22:29.66,Default,,0,0,0,,Бұл әдетте әдеттегідей. Бах мырза
Dialogue: 0,0:22:29.75,0:22:32.41,Default,,0,0,0,,Сіз біраз уақыттан бері күйіп қалу синдромымен ауырған сияқтысыз.
Dialogue: 0,0:22:33.33,0:22:36.20,Default,,0,0,0,,Қазір мен продюсер ретінде жақсы жұмыс істеп жатырмын.
Dialogue: 0,0:22:37.29,0:22:38.62,Default,,0,0,0,,Чайко-чан және Бада-чан
Dialogue: 0,0:22:39.00,0:22:40.75,Default,,0,0,0,,Мен бөтен планетада көп жұмыс жасадым, сондықтан
Dialogue: 0,0:22:41.29,0:22:43.50,Default,,0,0,0,,Оған Бах мырза сыйлық берген сияқты.
Dialogue: 0,0:22:44.08,0:22:48.00,Default,,0,0,0,,Қабілетті қызметші, басқаша айтқанда, Санген мырза.
Dialogue: 0,0:22:48.95,0:22:52.58,Default,,0,0,0,,Лист мырза, Шопен мырза және Шуе мырза
Dialogue: 0,0:22:52.79,0:22:53.70,Default,,0,0,0,,Мен саяхатқа шықтым
Dialogue: 0,0:22:54.62,0:22:57.20,Default,,0,0,0,,НЛО оқиғасында Мусик жіберген әлем елдеріне
Dialogue: 0,0:22:57.25,0:22:58.45,Default,,0,0,0,,Ол сонда барғысы келетінін айтты.
Dialogue: 0,0:22:59.12,0:23:03.20,Default,,0,0,0,,Үй бос, ал Сосуке сәл жалғызсырайтын сияқты.
Dialogue: 0,0:23:04.62,0:23:08.50,Default,,0,0,0,,Бірақ ол өзінше бірдеңе жасауға тырысатын сияқты.
Dialogue: 0,0:23:08.75,0:23:09.87,Default,,0,0,0,,...
Dialogue: 0,0:23:11.83,0:23:12.25,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:23:12.50,0:23:14.37,Default,,0,0,0,,- Бір ғана әннен тұратын көшенің жанды дауысы дегеніміз не?
Dialogue: 0,0:23:14.75,0:23:16.83,Default,,0,0,0,,-Ерлігіңе тәнтімін -Уау!
Dialogue: 0,0:23:17.37,0:23:19.79,Default,,0,0,0,,Біздің сапарымызда дебют жасауға қалай батылы бардыңыз?
Dialogue: 0,0:23:19.87,0:23:20.70,Default,,0,0,0,,Жақсы батылдық.
Dialogue: 0,0:23:21.00,0:23:22.08,Default,,0,0,0,,Тез орындаңыз
Dialogue: 0,0:23:22.25,0:23:25.00,Default,,0,0,0,,-Барлығы Чумоку -н Гугу
Dialogue: 0,0:23:25.29,0:23:27.08,Default,,0,0,0,,Нгуууууууууууууу
Dialogue: 0,0:23:27.16,0:23:29.50,Default,,0,0,0,,-Ууууууууууууууууууууууууууууу.
Dialogue: 0,0:23:29.83,0:23:33.00,Default,,0,0,0,,Жалақы мезгіл-мезгіл түседі деп үміттенемін.
Dialogue: 0,0:23:33.79,0:23:35.83,Default,,0,0,0,,Барлығы Кагура Сосуке
Dialogue: 0,0:23:36.33,0:23:39.08,Default,,0,0,0,,Бірінші вокзал турынан қосымша спектакльдерге жеңіспен оралу
Dialogue: 0,0:23:39.37,0:23:40.83,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:23:40.95,0:23:42.54,Default,,0,0,0,,-Бұл қысқа гастроль болды -Ша Ша Ша
Dialogue: 0,0:23:42.79,0:23:44.70,Default,,0,0,0,,-Көңілді болсын, көңілді болсын -Үйде болсаң демалуға болады.
Dialogue: 0,0:23:44.95,0:23:46.33,Default,,0,0,0,,-Шашашашашашаша -Мм?
Dialogue: 0,0:23:46.41,0:23:48.50,Default,,0,0,0,,-Аа, жанды шоу бар--Шашаша Шуу
Dialogue: 0,0:23:48.79,0:23:52.04,Default,,0,0,0,,-Шашашашашашашашаа -Кя Сосуке-сама Моту-сама-
Dialogue: 0,0:23:52.12,0:23:52.66,Default,,0,0,0,,Ах
Dialogue: 0,0:23:53.00,0:23:53.62,Default,,0,0,0,,Уау
Dialogue: 0,0:23:54.79,0:23:57.58,Default,,0,0,0,,Ммм?
Dialogue: 0,0:23:59.33,0:24:00.54,Default,,0,0,0,,Ей, кішкентай қыз
Dialogue: 0,0:24:01.62,0:24:03.16,Default,,0,0,0,,-Бүгін түн біраз уақыттан бері бірінші рет - Ммм
Dialogue: 0,0:24:03.20,0:24:06.83,Default,,0,0,0,,-Сіздің қарапайым мисо сорпаңызбен және менің керемет гиозамен -мммммм
Dialogue: 0,0:24:07.16,0:24:07.70,Default,,0,0,0,,-Hmph -Ah
Dialogue: 0,0:24:08.04,0:24:09.62,Default,,0,0,0,,Утана мен кеттім...
Dialogue: 0,0:24:09.66,0:24:10.20,Default,,0,0,0,,-Аааа-ахх
Dialogue: 0,0:24:10.83,0:24:14.00,Default,,0,0,0,,Жоқ, бұл жақсы емес.
Dialogue: 0,0:24:15.41,0:24:21.83,Default,,0,0,0,,Барлығы қазір шықсын!
Dialogue: 0,0:24:23.33,0:24:29.33,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory