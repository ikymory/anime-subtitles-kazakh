Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.04,0:00:07.45,Default,,0,0,0,,Тұрғындарды іздеу
Dialogue: 0,0:00:07.91,0:00:11.25,Default,,0,0,0,,Ах, мен Утанае Отова, осы Отова сарайының иесімін.
Dialogue: 0,0:00:11.75,0:00:13.62,Default,,0,0,0,,Біртүрлі фриloadерлер бар.
Dialogue: 0,0:00:13.70,0:00:15.16,Default,,0,0,0,,Бұл туралы уайымдамаңыз.
Dialogue: 0,0:00:15.70,0:00:17.83,Default,,0,0,0,,Атақты композитормен аттас
Dialogue: 0,0:00:18.20,0:00:19.91,Default,,0,0,0,,Жұмбақ музыка ойнау
Dialogue: 0,0:00:20.29,0:00:22.29,Default,,0,0,0,,Тұшпара пісіру арқылы бөлмені жағу
Dialogue: 0,0:00:22.50,0:00:24.41,Default,,0,0,0,,Роликті аяқ киіммен дәлізде жүгіру
Dialogue: 0,0:00:24.50,0:00:26.33,Default,,0,0,0,,Жаудың қандай да бір түрі шабуылдауы мүмкін.
Dialogue: 0,0:00:26.50,0:00:28.29,Default,,0,0,0,,Бұл өте жақсы үй.
Dialogue: 0,0:00:28.62,0:00:31.41,Default,,0,0,0,,Ах, жалдау ақысын дұрыстап төлеңіз.
Dialogue: 0,0:00:31.58,0:00:33.25,Default,,0,0,0,,Жай ғана экскурсияға барыңыз.
Dialogue: 0,0:00:37.66,0:00:41.83,Default,,0,0,0,,Мұнда және осы жерде керемет
Dialogue: 0,0:00:42.29,0:00:47.25,Default,,0,0,0,,Барлық жерде бұдан керемет ештеңе жоқ.
Dialogue: 0,0:00:47.70,0:00:50.83,Default,,0,0,0,,Жарайды, көрермен оны көргенде түсінеді.
Dialogue: 0,0:00:50.95,0:00:53.70,Default,,0,0,0,,Күтілгендей, бұл сарайдың құны
Dialogue: 0,0:00:53.87,0:00:57.33,Default,,0,0,0,,А-а, бұл кім болды?
Dialogue: 0,0:00:57.62,0:00:58.33,Default,,0,0,0,,Шуберт
Dialogue: 0,0:00:58.62,0:01:01.04,Default,,0,0,0,,Бетховенді жақсы көретін адам
Dialogue: 0,0:01:01.45,0:01:02.37,Default,,0,0,0,,Шуберт
Dialogue: 0,0:01:02.66,0:01:04.66,Default,,0,0,0,,Дұрыс, кешегі аласапыраннан.
Dialogue: 0,0:01:04.70,0:01:06.87,Default,,0,0,0,,Шу мырза сіз білмей тұрып көбейді.
Dialogue: 0,0:01:07.25,0:01:08.95,Default,,0,0,0,,Мен осы сарайда тұра алдым.
Dialogue: 0,0:01:09.37,0:01:13.20,Default,,0,0,0,,Қожайын мырза, шын жүректен алғыс айтамын.
Dialogue: 0,0:01:13.37,0:01:15.87,Default,,0,0,0,,Мұнда Бетховен ағасы тұрады.
Dialogue: 0,0:01:16.08,0:01:18.66,Default,,0,0,0,,Тамаша, ана жерде, бірде сылдырмақ естіледі.
Dialogue: 0,0:01:19.00,0:01:20.62,Default,,0,0,0,,Тіпті күтімі нашар осындай сарайда да
Dialogue: 0,0:01:20.70,0:01:22.54,Default,,0,0,0,,Аға болса жұмақ
Dialogue: 0,0:01:23.45,0:01:26.16,Default,,0,0,0,,Жалдау ақысын дұрыс төлеңіз, жарай ма?
Dialogue: 0,0:01:28.37,0:01:28.95,Default,,0,0,0,,Оячин?
Dialogue: 0,0:01:29.41,0:01:29.79,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:01:30.33,0:01:32.16,Default,,0,0,0,,-Енді айта кетсеңіз, қайсысы аға? -Ах
Dialogue: 0,0:01:32.45,0:01:36.29,Default,,0,0,0,,Мен сені соңғы күндері көрмедім, Сенпай.
Dialogue: 0,0:01:38.00,0:01:38.83,Default,,0,0,0,,Бұл сіз бе?
Dialogue: 0,0:03:10.70,0:03:13.20,Default,,0,0,0,,Тоқта, не алып жатырсың?
Dialogue: 0,0:03:13.33,0:03:16.37,Default,,0,0,0,,-Жарайды, бұл біздің бірінші кездесуіміз, бірінші кездесуіміз -Аа.
Dialogue: 0,0:03:16.79,0:03:18.25,Default,,0,0,0,,Ах, Маеда әлі тірі екені
Dialogue: 0,0:03:18.87,0:03:19.29,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:19.75,0:03:22.54,Default,,0,0,0,,Қараңдаршы, анау тастың сиқыры бар ма?
Dialogue: 0,0:03:22.75,0:03:24.12,Default,,0,0,0,,Қорқынышты нәрсе
Dialogue: 0,0:03:24.58,0:03:26.50,Default,,0,0,0,,Бұл жерде де солай.
Dialogue: 0,0:03:27.62,0:03:30.00,Default,,0,0,0,,Ой, бұл не?
Dialogue: 0,0:03:30.16,0:03:33.29,Default,,0,0,0,,Ей, енді қайтайық.
Dialogue: 0,0:03:33.91,0:03:35.62,Default,,0,0,0,,Бұл не, қауіпті емес пе?
Dialogue: 0,0:03:35.95,0:03:37.20,Default,,0,0,0,,Ендеше үйге қайтайық
Dialogue: 0,0:03:37.25,0:03:38.25,Default,,0,0,0,,Ах
Dialogue: 0,0:03:38.33,0:03:39.54,Default,,0,0,0,,- Кя - Уау
Dialogue: 0,0:03:40.66,0:03:42.41,Default,,0,0,0,,-Ха, қауіпті, қауіпті -Аа
Dialogue: 0,0:03:42.45,0:03:44.37,Default,,0,0,0,,Күте тұрыңыз, жоқ!
Dialogue: 0,0:03:44.87,0:03:47.04,Default,,0,0,0,,Кешіріңіз, маған тауға кіруге рұқсат жоқ.
Dialogue: 0,0:03:47.12,0:03:49.45,Default,,0,0,0,,Маған кіруге рұқсат жоқ, кешіріңіз.
Dialogue: 0,0:03:49.50,0:03:52.58,Default,,0,0,0,,Ана, әке
Dialogue: 0,0:03:53.04,0:03:56.25,Default,,0,0,0,,-Жоғарыдағы кадрларды бағдарлама өз бетінше алған -Оның жалған екендігінде шектеу бар.
Dialogue: 0,0:03:56.29,0:03:57.75,Default,,0,0,0,,- Уф - Бұл әйел қазір қауіпсіз.
Dialogue: 0,0:03:57.79,0:03:59.75,Default,,0,0,0,,-Саған бұл ұнайды ма? -Қорғалған және әсіресе одан кейін
Dialogue: 0,0:03:59.79,0:04:01.12,Default,,0,0,0,,- Уф - Ештеңе өзгермеген сияқты.
Dialogue: 0,0:04:01.79,0:04:04.41,Default,,0,0,0,,Олар бұл тауда не көрді?
Dialogue: 0,0:04:04.79,0:04:06.87,Default,,0,0,0,,Оларды кім бұрышқа түсірді?
Dialogue: 0,0:04:07.62,0:04:08.87,Default,,0,0,0,,Міне сурет
Dialogue: 0,0:04:10.12,0:04:12.50,Default,,0,0,0,,Біз бұл тіршілік иесінің атын Гамагон деп атадық.
Dialogue: 0,0:04:12.79,0:04:14.75,Default,,0,0,0,,Мен тергеуімді жалғастырғым келеді.
Dialogue: 0,0:04:16.08,0:04:19.79,Default,,0,0,0,,Мүмкін бұл менің қиялым шығар. Мен бұл жігітті бұрын көргендей сезінемін.
Dialogue: 0,0:04:20.33,0:04:20.83,Default,,0,0,0,,Сенімен танысқаныма қуаныштымын, Аня.
Dialogue: 0,0:04:21.16,0:04:21.54,Default,,0,0,0,,де?
Dialogue: 0,0:04:22.45,0:04:24.87,Default,,0,0,0,,Орманның жын патшасы Дабе
Dialogue: 0,0:04:25.83,0:04:29.04,Default,,0,0,0,,Жоқ, ол орманның жын патшасы емес.
Dialogue: 0,0:04:29.37,0:04:31.08,Default,,0,0,0,,Орман патшасы жын
Dialogue: 0,0:04:32.04,0:04:33.66,Default,,0,0,0,,Чайко-чан?
Dialogue: 0,0:04:47.62,0:04:48.08,Default,,0,0,0,,Пу
Dialogue: 0,0:04:48.70,0:04:52.95,Default,,0,0,0,,Сасық. Қайтарыңыз.
Dialogue: 0,0:04:53.29,0:04:54.33,Default,,0,0,0,,Пуу Пу
Dialogue: 0,0:04:54.41,0:04:55.29,Default,,0,0,0,,Пуууууу
Dialogue: 0,0:04:55.79,0:04:58.20,Default,,0,0,0,,Ахахахахахахахахах
Dialogue: 0,0:04:58.33,0:05:00.62,Default,,0,0,0,,Менің сүйкімді балам
Dialogue: 0,0:05:01.20,0:05:03.54,Default,,0,0,0,,Хэхехе ахаха хахаха
Dialogue: 0,0:05:05.04,0:05:05.79,Default,,0,0,0,,Маман
Dialogue: 0,0:05:10.25,0:05:13.33,Default,,0,0,0,,Уау, жақсы ауа-райы!
Dialogue: 0,0:05:13.54,0:05:14.95,Default,,0,0,0,,-Жоқ, котенка -Мм?
Dialogue: 0,0:05:15.33,0:05:17.04,Default,,0,0,0,,Ультракүлгін сәулелер теріңізге зиянды
Dialogue: 0,0:05:17.70,0:05:19.66,Default,,0,0,0,,Жассың деп сақтығыңды түсірме
Dialogue: 0,0:05:19.95,0:05:21.25,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:05:21.70,0:05:22.45,Default,,0,0,0,,Оны пайдаланыңыз
Dialogue: 0,0:05:22.91,0:05:24.50,Default,,0,0,0,,Жоқ, мен тазалап жатырмын.
Dialogue: 0,0:05:25.08,0:05:29.83,Default,,0,0,0,,Көмек болмас, ұстама, сүй, сүй
Dialogue: 0,0:05:30.37,0:05:31.79,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:34.04,0:05:36.08,Default,,0,0,0,,Бұл тыныш.
Dialogue: 0,0:05:36.33,0:05:38.04,Default,,0,0,0,,Өйткені бето мен моту жоқ
Dialogue: 0,0:05:38.29,0:05:39.37,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:05:39.79,0:05:40.91,Default,,0,0,0,,Қарт адамдар бар.
Dialogue: 0,0:05:41.08,0:05:41.45,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:42.08,0:05:43.91,Default,,0,0,0,,Ұлы Бетховен ағасы
Dialogue: 0,0:05:44.25,0:05:47.04,Default,,0,0,0,,Жаңа белестерге ұмтылып, Тұйықталдым
Dialogue: 0,0:05:47.41,0:05:48.79,Default,,0,0,0,,Жаңа биіктер?
Dialogue: 0,0:05:49.25,0:05:52.45,Default,,0,0,0,,Иә, жаңа шабыт пайда болады
Dialogue: 0,0:05:52.87,0:05:55.83,Default,,0,0,0,,Зейінін шоғырландыру және оның қашып кетуіне жол бермей, оған батыру мүмкіндігі
Dialogue: 0,0:05:56.66,0:05:59.66,Default,,0,0,0,,Ешкім жақындай алмайтын сол жалғыз көзқарас
Dialogue: 0,0:06:00.37,0:06:03.29,Default,,0,0,0,,Әрбір қимылы, тамаша кемеңгердің ісі
Dialogue: 0,0:06:03.95,0:06:06.20,Default,,0,0,0,,Сонымен Бето не істеп жатыр?
Dialogue: 0,0:06:08.70,0:06:11.95,Default,,0,0,0,,Қарапайым адамдарға оны қарауға немесе көзбен көруге рұқсат етілмейді.
Dialogue: 0,0:06:12.50,0:06:14.00,Default,,0,0,0,,Сіз де түсінбейсіз.
Dialogue: 0,0:06:14.08,0:06:16.08,Default,,0,0,0,,Бұл маңызды емес
Dialogue: 0,0:06:16.50,0:06:18.87,Default,,0,0,0,,Ең бастысы - үлкендеріңіз көздеген биіктерге кедергі жасамау...
Dialogue: 0,0:06:18.91,0:06:19.70,Default,,0,0,0,,Ішек өнімдер туралы не деуге болады?
Dialogue: 0,0:06:20.70,0:06:24.91,Default,,0,0,0,,Хе, осындай жеңілтек, жеңіл адам ше?
Dialogue: 0,0:06:25.00,0:06:26.00,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:06:26.54,0:06:28.08,Default,,0,0,0,,-Көбелек қуып жүрген шығар -Көбелек
Dialogue: 0,0:06:28.16,0:06:29.75,Default,,0,0,0,,- Өзенге құлап, шайып кетті ме? - Апыр-ай.
Dialogue: 0,0:06:30.33,0:06:33.12,Default,,0,0,0,,-Немесе бір жерде лас әзіл айтып жатқанда -Хахахахахахаха
Dialogue: 0,0:06:33.20,0:06:34.87,Default,,0,0,0,,-Айналайын деп тұр -Ахахаха
Dialogue: 0,0:06:35.12,0:06:36.29,Default,,0,0,0,,-Аааа -Жақсы
Dialogue: 0,0:06:36.37,0:06:38.12,Default,,0,0,0,,Қауіпсіз болса, бәрі жақсы.
Dialogue: 0,0:06:38.79,0:06:39.41,Default,,0,0,0,,Ән көшеттері
Dialogue: 0,0:06:39.45,0:06:39.87,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:40.41,0:06:43.33,Default,,0,0,0,,Әй, сен кеше арнайы бағдарламаны көрдің бе? Бұл Моту-сан емес пе?
Dialogue: 0,0:06:43.66,0:06:46.50,Default,,0,0,0,,Бұл сөзсіз моту-сан, солай ма?
Dialogue: 0,0:06:47.37,0:06:49.62,Default,,0,0,0,,Ол не істеп жатыр?
Dialogue: 0,0:06:50.12,0:06:51.04,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,0:06:51.37,0:06:53.54,Default,,0,0,0,,Мына тау қаланың шетінде, солай ма?
Dialogue: 0,0:06:53.91,0:06:54.41,Default,,0,0,0,,Иә
Dialogue: 0,0:06:55.45,0:06:56.87,Default,,0,0,0,,Сәлем, Ютаге?
Dialogue: 0,0:06:57.08,0:07:01.12,Default,,0,0,0,,Бұл дұрыс. Бүгін жақсы күн. Мен төсегімді құрғатамын деп ойлаймын.
Dialogue: 0,0:07:01.25,0:07:02.87,Default,,0,0,0,,Сізге қызық емес пе?
Dialogue: 0,0:07:03.33,0:07:04.08,Default,,0,0,0,,Понкотсу
Dialogue: 0,0:07:04.41,0:07:07.20,Default,,0,0,0,,Маған осы тыныштықты тағы біраз уақыт ләззат алуға рұқсат етіңіз бе?
Dialogue: 0,0:07:07.79,0:07:08.29,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:07:09.29,0:07:11.50,Default,,0,0,0,,Ахаха, мен егжей-тегжейге назар аудардым.
Dialogue: 0,0:07:11.58,0:07:13.87,Default,,0,0,0,,Мен үй иесі болып жұмыс істей алмаймын.
Dialogue: 0,0:07:13.91,0:07:16.41,Default,,0,0,0,,Ахаха ахаха ахаха аха
Dialogue: 0,0:07:17.54,0:07:19.41,Default,,0,0,0,,Кеше Хамамацу туралы аңызды көрдіңіз бе?
Dialogue: 0,0:07:19.83,0:07:21.12,Default,,0,0,0,,Көрдім, көрдім, Хамагон
Dialogue: 0,0:07:21.37,0:07:23.04,Default,,0,0,0,,Эй, сабақтан кейін барғың келе ме?
Dialogue: 0,0:07:23.41,0:07:25.12,Default,,0,0,0,,Қызық көрінеді, Утанае.
Dialogue: 0,0:07:25.75,0:07:26.45,Default,,0,0,0,,Тенгу
Dialogue: 0,0:07:26.87,0:07:27.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:27.79,0:07:29.62,Default,,0,0,0,,Бұл Гамагон емес
Dialogue: 0,0:07:30.00,0:07:33.66,Default,,0,0,0,,Бұл теңге. Егер сіз онымен тек көңіл көтеру үшін аралассаңыз, сізді ұрлап кетеді.
Dialogue: 0,0:07:34.50,0:07:37.04,Default,,0,0,0,,Жоқ, онша байыпты болудың қажеті жоқ.
Dialogue: 0,0:07:37.95,0:07:39.66,Default,,0,0,0,,Гамагон керемет
Dialogue: 0,0:07:40.00,0:07:41.33,Default,,0,0,0,,Жүр, оны апарайық
Dialogue: 0,0:07:41.58,0:07:43.37,Default,,0,0,0,,Гамагон келе жатыр!
Dialogue: 0,0:07:43.66,0:07:46.20,Default,,0,0,0,,Жоқ, жоқ, мен Гамагонға барғым келеді.
Dialogue: 0,0:07:46.25,0:07:46.87,Default,,0,0,0,,№
Dialogue: 0,0:07:47.16,0:07:48.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:48.08,0:07:49.45,Default,,0,0,0,,Бұл қызу тақырыпқа айналуда.
Dialogue: 0,0:07:49.91,0:07:51.70,Default,,0,0,0,,Егер сіз сонда болсаңыз, сіз шулайсыз.
Dialogue: 0,0:07:52.00,0:07:54.91,Default,,0,0,0,,Мен қалмасам, қиындық туғызамын.
Dialogue: 0,0:07:55.41,0:07:56.29,Default,,0,0,0,,Оны жалғыз қалдыру дұрыс па?
Dialogue: 0,0:07:56.75,0:07:58.50,Default,,0,0,0,,Мен жай ғана үй иесімін.
Dialogue: 0,0:07:58.91,0:08:01.50,Default,,0,0,0,,Тұрғындар сыртта істеген істері үшін жауап бермейді.
Dialogue: 0,0:08:01.87,0:08:02.66,Default,,0,0,0,,Бірақ
Dialogue: 0,0:08:03.00,0:08:05.54,Default,,0,0,0,,Бір күні мені біреу басып алады.
Dialogue: 0,0:08:06.54,0:08:06.79,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:07.79,0:08:08.66,Default,,0,0,0,,Түсіру?
Dialogue: 0,0:08:09.54,0:08:12.75,Default,,0,0,0,,Ән көшеттері Ән көшеттері
Dialogue: 0,0:08:12.83,0:08:14.33,Default,,0,0,0,,-Утанае деген кім? -Иә.
Dialogue: 0,0:08:14.41,0:08:16.70,Default,,0,0,0,,-Ол сарайдың қызы сияқты. -Апыр-ай.
Dialogue: 0,0:08:17.95,0:08:20.33,Default,,0,0,0,,Гамагонмен қандай қарым-қатынастасыз?
Dialogue: 0,0:08:20.70,0:08:22.33,Default,,0,0,0,,Сіз де Гамагонсыз ба?
Dialogue: 0,0:08:22.62,0:08:24.29,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:24.75,0:08:27.29,Default,,0,0,0,,Қараңдаршы, Гамагондық жас ханым.
Dialogue: 0,0:08:28.16,0:08:29.20,Default,,0,0,0,,Шамасы
Dialogue: 0,0:08:29.54,0:08:31.54,Default,,0,0,0,,Жас болсаң да ұятсыз.
Dialogue: 0,0:08:31.66,0:08:32.54,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:08:33.58,0:08:35.75,Default,,0,0,0,,Гамагон, тауға қайт!
Dialogue: 0,0:08:36.00,0:08:37.45,Default,,0,0,0,,Үйге қайт
Dialogue: 0,0:08:37.58,0:08:39.45,Default,,0,0,0,,Қаланың адамгершілігін бұзбау.
Dialogue: 0,0:08:39.66,0:08:41.37,Default,,0,0,0,,Оған кедергі жасамаңыз
Dialogue: 0,0:08:41.45,0:08:41.91,Default,,0,0,0,,Га
Dialogue: 0,0:08:42.58,0:08:43.16,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:43.62,0:08:46.58,Default,,0,0,0,,Мен тым көп көңіл бөлемін Ахахаха
Dialogue: 0,0:08:46.83,0:08:47.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:51.62,0:08:54.41,Default,,0,0,0,,Бето? Сәлем Бето
Dialogue: 0,0:08:55.45,0:08:57.25,Default,,0,0,0,,Бар, солай ма? Бет…
Dialogue: 0,0:08:57.29,0:08:58.29,Default,,0,0,0,,Жоғалып кетті
Dialogue: 0,0:08:58.41,0:08:59.70,Default,,0,0,0,,О, ой, кешіріңіз...
Dialogue: 0,0:08:59.75,0:09:02.58,Default,,0,0,0,,Мен естідім, жоқ, жаңбырдың дыбысын көрдім
Dialogue: 0,0:09:03.00,0:09:04.70,Default,,0,0,0,,түзу қисық жоғалды
Dialogue: 0,0:09:04.79,0:09:05.83,Default,,0,0,0,,-Тағы да... -Кешіріңіз.
Dialogue: 0,0:09:05.95,0:09:07.91,Default,,0,0,0,,Көрдің бе, моту тауда тығылып жатыр.
Dialogue: 0,0:09:07.95,0:09:09.33,Default,,0,0,0,,Біраз дүрбелең болды.
Dialogue: 0,0:09:09.91,0:09:12.25,Default,,0,0,0,,Мен бұл туралы бірдеңе істей алғым келеді.
Dialogue: 0,0:09:14.45,0:09:14.83,Default,,0,0,0,,болып табылады
Dialogue: 0,0:09:15.41,0:09:19.33,Default,,0,0,0,,Хи хи хи хи хи хи
Dialogue: 0,0:09:19.58,0:09:20.54,Default,,0,0,0,,Бұл Шикато ма?
Dialogue: 0,0:09:20.62,0:09:24.00,Default,,0,0,0,,- Хи хи хи хи хи хи - Бэйт Эй Бэйт
Dialogue: 0,0:09:24.87,0:09:28.25,Default,,0,0,0,,Күрсін, маған сол бейбақ керек.
Dialogue: 0,0:09:28.45,0:09:29.91,Default,,0,0,0,,Қандай сергітеді!
Dialogue: 0,0:09:30.58,0:09:33.12,Default,,0,0,0,,Барлығы ондай адам ешқашан болмаған деп кейіп танытады.
Dialogue: 0,0:09:33.41,0:09:36.50,Default,,0,0,0,,Маған тек бейбіт өмір сүру керек. Иә.
Dialogue: 0,0:09:38.70,0:09:40.00,Default,,0,0,0,,А? Нуу
Dialogue: 0,0:09:40.50,0:09:42.00,Default,,0,0,0,,Уа
Dialogue: 0,0:09:42.08,0:09:46.45,Default,,0,0,0,,-    -
Dialogue: 0,0:09:46.54,0:09:48.66,Default,,0,0,0,,-Ах ки сен -гафугафусың
Dialogue: 0,0:09:50.50,0:09:52.87,Default,,0,0,0,,Gouvoooo
Dialogue: 0,0:09:52.95,0:09:54.83,Default,,0,0,0,,Міне.
Dialogue: 0,0:09:55.20,0:09:56.95,Default,,0,0,0,,Бұл Бетховен ағасына сыйлық.
Dialogue: 0,0:09:57.00,0:09:58.45,Default,,0,0,0,,Вууууу
Dialogue: 0,0:09:58.58,0:10:02.50,Default,,0,0,0,,-Уау, уау, -ой, көмектесші!
Dialogue: 0,0:10:02.66,0:10:04.41,Default,,0,0,0,,-Хихихихихихихи -Гал Гару
Dialogue: 0,0:10:04.50,0:10:05.91,Default,,0,0,0,,Әй, Гамагон.
Dialogue: 0,0:10:06.04,0:10:06.87,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:10:07.29,0:10:10.66,Default,,0,0,0,,-Маған көмектес - Гау Гау Гау Гау Гау Гау
Dialogue: 0,0:10:11.20,0:10:14.91,Default,,0,0,0,,Мен жеңілдім. Мен Бетоның шоғырлануынан жеңіліп қалдым.
Dialogue: 0,0:10:16.70,0:10:17.58,Default,,0,0,0,,Бұл Чоччаннан.
Dialogue: 0,0:10:18.87,0:10:20.62,Default,,0,0,0,,Моту немесе Хамагон?
Dialogue: 0,0:10:21.04,0:10:22.91,Default,,0,0,0,,Қалаға бірдеңе кіріп кеткен сияқты.
Dialogue: 0,0:10:23.29,0:10:23.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:24.54,0:10:26.50,Default,,0,0,0,,Интернетте видеолар таралуда.
Dialogue: 0,0:10:26.66,0:10:30.79,Default,,0,0,0,,-Гах гав гавг гавг гавг -Біреу маған көмектесші!
Dialogue: 0,0:10:31.20,0:10:33.45,Default,,0,0,0,,Бұл менің көршім.
Dialogue: 0,0:10:33.58,0:10:34.50,Default,,0,0,0,,-Босатыңыз -Ха!
Dialogue: 0,0:10:34.62,0:10:37.08,Default,,0,0,0,,-Я аа жоқ, өлсем де -ға ға ғау
Dialogue: 0,0:10:37.29,0:10:39.62,Default,,0,0,0,,-Тек осы гиоза менің ағама барады -Гауууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:10:41.58,0:10:42.08,Default,,0,0,0,,Га
Dialogue: 0,0:10:44.25,0:10:45.41,Default,,0,0,0,,Хмф аааааааааааааааааааааааа
Dialogue: 0,0:10:45.50,0:10:47.37,Default,,0,0,0,,-Тоқта, екеуің не істеп жатырсыңдар... -Хмф.
Dialogue: 0,0:10:47.58,0:10:48.37,Default,,0,0,0,,-Мынаны қара -Хунхун
Dialogue: 0,0:10:48.45,0:10:48.83,Default,,0,0,0,,-На -ғұн
Dialogue: 0,0:10:49.12,0:10:50.08,Default,,0,0,0,,-Хамагон емес пе? -Хунхун
Dialogue: 0,0:10:50.37,0:10:51.54,Default,,0,0,0,,-Неге бұл сарай? -Өтірік
Dialogue: 0,0:10:51.87,0:10:52.79,Default,,0,0,0,,Хахаха
Dialogue: 0,0:10:53.50,0:10:54.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:54.08,0:10:55.66,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:10:56.04,0:10:58.16,Default,,0,0,0,,Моцу Утанаэ сарайда.
Dialogue: 0,0:10:58.41,0:10:58.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:00.20,0:11:05.33,Default,,0,0,0,,жұмсақ шақ №
Dialogue: 0,0:11:06.00,0:11:08.04,Default,,0,0,0,,Моту Бұл не деген сұмдық?
Dialogue: 0,0:11:08.12,0:11:09.70,Default,,0,0,0,,Ой, тоқта, моту.
Dialogue: 0,0:11:09.83,0:11:10.70,Default,,0,0,0,,О, қазірдің өзінде
Dialogue: 0,0:11:11.00,0:11:14.87,Default,,0,0,0,,Сонымен моту моту?
Dialogue: 0,0:11:15.79,0:11:18.29,Default,,0,0,0,,-Гяа -Моту Гуо
Dialogue: 0,0:11:19.37,0:11:20.50,Default,,0,0,0,,Моту?
Dialogue: 0,0:11:21.58,0:11:24.20,Default,,0,0,0,,Сіз өте әдемісіз. Хмм…
Dialogue: 0,0:11:24.87,0:11:26.33,Default,,0,0,0,,-Маман -ха
Dialogue: 0,0:11:27.50,0:11:31.79,Default,,0,0,0,,Маман
Dialogue: 0,0:11:32.45,0:11:33.62,Default,,0,0,0,,О
Dialogue: 0,0:11:34.45,0:11:39.79,Default,,0,0,0,,Қашқан моту, жоқ, шабыт
Dialogue: 0,0:11:47.45,0:11:48.58,Default,,0,0,0,,Ааа
Dialogue: 0,0:11:48.66,0:11:50.58,Default,,0,0,0,,Қалада кенеттен Гамагон пайда болды.
Dialogue: 0,0:11:50.87,0:11:52.79,Default,,0,0,0,,Мақсаты не болды?
Dialogue: 0,0:11:53.12,0:11:56.12,Default,,0,0,0,,Содан көп ұзамай тауға жоғалып кеткен сияқты.
Dialogue: 0,0:11:56.66,0:11:58.58,Default,,0,0,0,,Біз сондай-ақ кейінгі тергеуді жалғастырамыз.
Dialogue: 0,0:11:58.83,0:12:01.45,Default,,0,0,0,,Мен шындыққа тезірек жеткім келеді...
Dialogue: 0,0:12:02.66,0:12:04.66,Default,,0,0,0,,Моту-сан айғайлап тұрған анау кім?
Dialogue: 0,0:12:05.12,0:12:07.54,Default,,0,0,0,,Мама? Менің анам туралы ма деп ойлаймын
Dialogue: 0,0:12:07.91,0:12:08.62,Default,,0,0,0,,Ана?
Dialogue: 0,0:12:09.12,0:12:12.33,Default,,0,0,0,,Әйтеуір, сол ақымаққа бірдеңе жасау керек.
Dialogue: 0,0:12:12.95,0:12:14.91,Default,,0,0,0,,Котенканың жағдайы нашарлап барады.
Dialogue: 0,0:12:14.95,0:12:15.83,Default,,0,0,0,,-Жетеді -А
Dialogue: 0,0:12:17.00,0:12:23.25,Default,,0,0,0,,Болды, мен Мотуды алып келейін.
Dialogue: 0,0:12:23.75,0:12:26.62,Default,,0,0,0,,Мен бұдан былай қиындық тудырғым келмейді.
Dialogue: 0,0:12:27.37,0:12:32.41,Default,,0,0,0,,Жүрегім сізге, үй иесі, бірақ уайымдамаңыз.
Dialogue: 0,0:12:32.95,0:12:34.33,Default,,0,0,0,,Үй иесінің алдында
Dialogue: 0,0:12:34.41,0:12:36.87,Default,,0,0,0,,Мына Шуберт оны өлтіреді.
Dialogue: 0,0:12:38.08,0:12:40.20,Default,,0,0,0,,Бетховен аға үшін сатып алынды.
Dialogue: 0,0:12:40.70,0:12:42.04,Default,,0,0,0,,Джозаның ашуы
Dialogue: 0,0:12:51.29,0:12:51.83,Default,,0,0,0,,Мұнда
Dialogue: 0,0:12:52.08,0:12:54.58,Default,,0,0,0,,Бұл Гамагонның мекен ететін тау.
Dialogue: 0,0:12:55.16,0:12:56.04,Default,,0,0,0,,Соңғы бірнеше күн
Dialogue: 0,0:12:56.25,0:12:58.37,Default,,0,0,0,,Адамдар Гамагонды бір қарағанда көруге жиналды.
Dialogue: 0,0:12:58.58,0:12:59.91,Default,,0,0,0,,Ол өте көп.
Dialogue: 0,0:13:02.12,0:13:05.20,Default,,0,0,0,,Әй, не деген ұят, ағай, қайталап көріңізші.
Dialogue: 0,0:13:05.45,0:13:06.16,Default,,0,0,0,,-Ммм -Ух
Dialogue: 0,0:13:06.37,0:13:09.58,Default,,0,0,0,,-Мен тез моту жинап, үйге барамын. -Мен үйге барамын.
Dialogue: 0,0:13:12.75,0:13:15.00,Default,,0,0,0,,Орманның жын патшасы менің олжам.
Dialogue: 0,0:13:16.45,0:13:17.37,Default,,0,0,0,,Чайко-чан?
Dialogue: 0,0:13:17.50,0:13:20.62,Default,,0,0,0,,-Сасық, сасық, осында -Хмм?
Dialogue: 0,0:13:21.33,0:13:24.83,Default,,0,0,0,,Менің солтүстік жаным Матағының қаны.
Dialogue: 0,0:13:25.62,0:13:29.45,Default,,0,0,0,,Чайко-чан, мен сенің соңынан бара алмаймын.
Dialogue: 0,0:13:30.41,0:13:34.41,Default,,0,0,0,,Моцу, сен қайдасың? Қайтып кел!
Dialogue: 0,0:13:34.58,0:13:37.83,Default,,0,0,0,,Моцу Мен ашуланбаймын.
Dialogue: 0,0:13:37.91,0:13:39.37,Default,,0,0,0,,-Маған көмектесші -Ах
Dialogue: 0,0:13:40.12,0:13:43.04,Default,,0,0,0,,Маған көмектесіңізші.
Dialogue: 0,0:13:43.12,0:13:44.00,Default,,0,0,0,,-hii -тұзақ?
Dialogue: 0,0:13:44.12,0:13:45.91,Default,,0,0,0,,-Өтінемін -Моту бар ма?
Dialogue: 0,0:13:46.04,0:13:46.91,Default,,0,0,0,,- Kyaa - Өтінемін, маған көмектесіңізші.
Dialogue: 0,0:13:47.33,0:13:48.37,Default,,0,0,0,,-Ол жерде болды -Ауф
Dialogue: 0,0:13:48.66,0:13:49.79,Default,,0,0,0,,-Уау -Уау Уау
Dialogue: 0,0:13:50.25,0:13:51.45,Default,,0,0,0,,-Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:13:51.62,0:13:53.45,Default,,0,0,0,,Бұл Гамагонның қарғысы.
Dialogue: 0,0:13:53.50,0:13:56.87,Default,,0,0,0,,Эй, сен не ойлап тұрсың?
Dialogue: 0,0:14:02.83,0:14:11.16,Default,,0,0,0,,Маман
Dialogue: 0,0:14:11.29,0:14:13.50,Default,,0,0,0,,Эй, мен бірдеңе естідім.
Dialogue: 0,0:14:14.29,0:14:15.25,Default,,0,0,0,,Табылды
Dialogue: 0,0:14:15.62,0:14:16.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:16.83,0:14:21.58,Default,,0,0,0,,Ой, орман патшасы саңырауқұлақ екен.
Dialogue: 0,0:14:21.66,0:14:22.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:22.33,0:14:24.58,Default,,0,0,0,,Мынау ғажап, мынау ғажап
Dialogue: 0,0:14:24.66,0:14:27.45,Default,,0,0,0,,- Көңіл көтеріңіз Уау - Орман патшасы жын жеткілікті ме?
Dialogue: 0,0:14:27.54,0:14:29.58,Default,,0,0,0,,Менің саңырауқұлақтарды қаншалықты жақсы көретінімді ұмыттыңыз ба?
Dialogue: 0,0:14:29.79,0:14:34.62,Default,,0,0,0,,- Керемет! Керемет! Саңырауқұлақтар, саңырауқұлақтар, саңырауқұлақтардан басқа ештеңе жоқ -Чайко-чан, мен саған ілесе алмаймын.
Dialogue: 0,0:14:36.95,0:14:38.83,Default,,0,0,0,,Ха ха ха ха ха
Dialogue: 0,0:14:39.12,0:14:41.91,Default,,0,0,0,,Әй, Утанае, неге бармайсың?
Dialogue: 0,0:14:42.12,0:14:43.45,Default,,0,0,0,,Ақымақ болма
Dialogue: 0,0:14:43.87,0:14:49.33,Default,,0,0,0,,Моту Бұл менмін! Мен сені алып кетуге келдім.
Dialogue: 0,0:14:50.29,0:14:51.20,Default,,0,0,0,,Ха ха
Dialogue: 0,0:14:51.33,0:14:51.91,Default,,0,0,0,,Ах
Dialogue: 0,0:14:55.91,0:14:56.45,Default,,0,0,0,,Ах
Dialogue: 0,0:14:57.87,0:14:59.79,Default,,0,0,0,,Моту?
Dialogue: 0,0:15:03.33,0:15:04.04,Default,,0,0,0,,Маман
Dialogue: 0,0:15:04.70,0:15:07.16,Default,,0,0,0,,Маман дегеніміз не? Не болды?
Dialogue: 0,0:15:07.54,0:15:10.00,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,0:15:11.16,0:15:12.70,Default,,0,0,0,,Маман Маман
Dialogue: 0,0:15:13.87,0:15:14.66,Default,,0,0,0,,Сосуке
Dialogue: 0,0:15:14.75,0:15:18.00,Default,,0,0,0,,Мама мама мама мама мама
Dialogue: 0,0:15:19.12,0:15:24.04,Default,,0,0,0,,Мама Мама Маман Маман
Dialogue: 0,0:15:25.62,0:15:26.70,Default,,0,0,0,,Таудан шығыңыз
Dialogue: 0,0:15:27.25,0:15:28.95,Default,,0,0,0,,Сөйлей алсаң, сөйле.
Dialogue: 0,0:15:29.70,0:15:33.41,Default,,0,0,0,,Бұл тау моту тауы емес, солай ма? Үйге бірге барайық.
Dialogue: 0,0:15:36.45,0:15:37.66,Default,,0,0,0,,Мен жалғызбын
Dialogue: 0,0:15:38.16,0:15:38.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:39.83,0:15:43.25,Default,,0,0,0,,Таудан шығыңыз!
Dialogue: 0,0:15:44.50,0:15:47.91,Default,,0,0,0,,А, жақын емес пе еді?
Dialogue: 0,0:15:48.62,0:15:49.29,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:15:49.70,0:15:50.33,Default,,0,0,0,,Га
Dialogue: 0,0:15:54.25,0:15:56.08,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:56.12,0:15:56.50,Default,,0,0,0,,Ах
Dialogue: 0,0:15:56.79,0:15:58.12,Default,,0,0,0,,-Хаа ха ха -Күте тұр.
Dialogue: 0,0:15:58.33,0:16:01.16,Default,,0,0,0,,Хахахахахахахаха
Dialogue: 0,0:16:01.33,0:16:04.20,Default,,0,0,0,,Хахахахахахахаха
Dialogue: 0,0:16:04.29,0:16:07.16,Default,,0,0,0,,Балам, аман бол.
Dialogue: 0,0:16:26.54,0:16:28.62,Default,,0,0,0,,Моту
Dialogue: 0,0:16:28.70,0:16:32.33,Default,,0,0,0,,Ah Ah Ah
Dialogue: 0,0:16:36.66,0:16:40.04,Default,,0,0,0,,Мүмкін осы баланың кесірінен шығар?
Dialogue: 0,0:16:44.87,0:16:48.50,Default,,0,0,0,,Нихихихихи Кейде таулар да тамаша
Dialogue: 0,0:16:49.16,0:16:50.70,Default,,0,0,0,,Біз не ойнауымыз керек?
Dialogue: 0,0:16:51.04,0:16:52.29,Default,,0,0,0,,-Кью -Ой?
Dialogue: 0,0:16:52.62,0:16:53.79,Default,,0,0,0,,Cu cu cu cuu
Dialogue: 0,0:16:55.20,0:16:57.58,Default,,0,0,0,,Кю Кю Кю
Dialogue: 0,0:16:58.45,0:16:58.87,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:17:00.50,0:17:02.58,Default,,0,0,0,,Кью Кью
Dialogue: 0,0:17:04.41,0:17:09.75,Default,,0,0,0,,Уф, бұл ана.
Dialogue: 0,0:17:12.12,0:17:12.54,Default,,0,0,0,,Cu
Dialogue: 0,0:17:14.16,0:17:16.83,Default,,0,0,0,,Жарайды, жасы, сәлем.
Dialogue: 0,0:17:17.62,0:17:18.04,Default,,0,0,0,,-кю -о
Dialogue: 0,0:17:18.54,0:17:22.62,Default,,0,0,0,,Хехехехехехехехехе
Dialogue: 0,0:17:30.25,0:17:31.33,Default,,0,0,0,,Ол қайтыс болды.
Dialogue: 0,0:17:32.58,0:17:36.83,Default,,0,0,0,,Хиуууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:17:36.95,0:17:40.87,Default,,0,0,0,,Уу сәлем уһ уһ сәлем
Dialogue: 0,0:17:48.58,0:17:49.16,Default,,0,0,0,,Моту
Dialogue: 0,0:17:51.95,0:17:53.04,Default,,0,0,0,,Реквием
Dialogue: 0,0:17:56.66,0:18:01.33,Default,,0,0,0,,Hör mal, meine Musik.
Dialogue: 0,0:18:13.00,0:18:13.87,Default,,0,0,0,,О
Dialogue: 0,0:18:14.00,0:18:16.37,Default,,0,0,0,,Менің ойнайтыным – реквиемнің әуені
Dialogue: 0,0:18:16.83,0:18:20.08,Default,,0,0,0,,Жүр, қазір бәрін шығар
Dialogue: 0,0:18:20.62,0:18:23.79,Default,,0,0,0,,Бір таза жанға қайтатын уақыт
Dialogue: 0,0:18:25.70,0:18:28.50,Default,,0,0,0,,Фуфуфуфуфуфу Моцарт
Dialogue: 0,0:18:29.04,0:18:32.12,Default,,0,0,0,,Көптен бері келе жатқан өшпенділіктен арылатын кез келді ме?
Dialogue: 0,0:18:32.70,0:18:33.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:38.33,0:18:40.12,Default,,0,0,0,,Оо монах
Dialogue: 0,0:18:41.37,0:18:42.87,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:45.45,0:18:46.08,Default,,0,0,0,,Уау
Dialogue: 0,0:18:46.50,0:18:48.16,Default,,0,0,0,,Бұл Гамагон
Dialogue: 0,0:18:48.25,0:18:50.62,Default,,0,0,0,,Тау құдайының қаһары!
Dialogue: 0,0:18:58.25,0:18:59.66,Default,,0,0,0,,Тағы да қасқыр?
Dialogue: 0,0:19:00.75,0:19:02.83,Default,,0,0,0,,Нуа Уау Ах
Dialogue: 0,0:19:03.16,0:19:04.12,Default,,0,0,0,,Біраз көңілсіз
Dialogue: 0,0:19:04.20,0:19:05.45,Default,,0,0,0,,Бірдеңе дұрыс емес
Dialogue: 0,0:19:05.58,0:19:09.83,Default,,0,0,0,,Хахаха ахахахаха
Dialogue: 0,0:19:10.20,0:19:11.58,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:19:12.25,0:19:13.70,Default,,0,0,0,,Уф Сосуке
Dialogue: 0,0:19:13.83,0:19:21.58,Default,,0,0,0,,Вау-а-а-а-а
Dialogue: 0,0:19:21.75,0:19:23.37,Default,,0,0,0,,Не? Ыстық емес пе?
Dialogue: 0,0:19:23.70,0:19:25.16,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:19:25.54,0:19:31.12,Default,,0,0,0,,Не, мен қатты қорықтым, бірақ кешіріңіз.
Dialogue: 0,0:19:31.91,0:19:33.04,Default,,0,0,0,,Тірі қалғаныма өкінемін
Dialogue: 0,0:19:33.70,0:19:36.50,Default,,0,0,0,,Талантыңыз болмаса да, сізді үнемі ұрып-соғатыным үшін кешіріңіз.
Dialogue: 0,0:19:36.79,0:19:37.54,Default,,0,0,0,,Сосуке?
Dialogue: 0,0:19:37.87,0:19:38.70,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:39.00,0:19:41.37,Default,,0,0,0,,Чайко-чанға ілесе алмағаным үшін кешіріңіз.
Dialogue: 0,0:19:41.62,0:19:42.50,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:42.75,0:19:45.16,Default,,0,0,0,,Тек толқудан әрекет еткенім үшін кешірім сұраймын.
Dialogue: 0,0:19:45.37,0:19:47.95,Default,,0,0,0,,Мен әлі тірі болғаныма өкінемін
Dialogue: 0,0:19:48.08,0:19:51.95,Default,,0,0,0,,Хахахахаха, барлық тіршілік иелері
Dialogue: 0,0:19:52.20,0:19:55.33,Default,,0,0,0,,Музыкамның алдында тізе бүгіп, тәубе ет.
Dialogue: 0,0:19:55.41,0:19:56.95,Default,,0,0,0,,Сізді алдап кеткенім үшін кешіріңіз.
Dialogue: 0,0:19:57.20,0:19:59.58,Default,,0,0,0,,Оның денесін жоқтау оты жалмады.
Dialogue: 0,0:20:00.16,0:20:05.08,Default,,0,0,0,,Өкініш, өкініш, өкіне бер.
Dialogue: 0,0:20:06.20,0:20:07.54,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:20:12.16,0:20:12.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:16.12,0:20:18.58,Default,,0,0,0,,Қосымша реквием
Dialogue: 0,0:20:18.87,0:20:22.41,Default,,0,0,0,,Әлемге реквием
Dialogue: 0,0:20:23.83,0:20:24.87,Default,,0,0,0,,Қазіргі жағдайда оның барар жері жоқ.
Dialogue: 0,0:20:25.37,0:20:27.83,Default,,0,0,0,,Ааа?
Dialogue: 0,0:20:28.62,0:20:32.79,Default,,0,0,0,,Бето, сен мұнда не үшін келдің? Неге жақсысың?
Dialogue: 0,0:20:35.16,0:20:40.25,Default,,0,0,0,,Менің өкінетін ештеңем жоқ.
Dialogue: 0,0:20:43.33,0:20:44.41,Default,,0,0,0,,Олар өте көп.
Dialogue: 0,0:20:45.70,0:20:47.12,Default,,0,0,0,,Ааа
Dialogue: 0,0:20:49.41,0:20:49.91,Default,,0,0,0,,Га
Dialogue: 0,0:21:07.95,0:21:09.25,Default,,0,0,0,,Бұл себеп пе?
Dialogue: 0,0:21:09.70,0:21:10.45,Default,,0,0,0,,Ұнады
Dialogue: 0,0:21:14.62,0:21:16.33,Default,,0,0,0,,А?
Dialogue: 0,0:21:23.50,0:21:25.41,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:25.75,0:21:27.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:27.12,0:21:29.70,Default,,0,0,0,,Мен оның есінен танып, есінен танып қалғанына сенімдімін.
Dialogue: 0,0:21:30.04,0:21:30.50,Default,,0,0,0,,Cu
Dialogue: 0,0:21:32.41,0:21:34.70,Default,,0,0,0,,О, балам
Dialogue: 0,0:21:36.79,0:21:38.91,Default,,0,0,0,,Бала
Dialogue: 0,0:21:40.75,0:21:41.33,Default,,0,0,0,,Гах
Dialogue: 0,0:21:41.83,0:21:42.50,Default,,0,0,0,,Ах аа
Dialogue: 0,0:21:42.70,0:21:45.16,Default,,0,0,0,,Неге?
Dialogue: 0,0:21:45.54,0:21:49.12,Default,,0,0,0,,Хо хо хо хо Сізді таң қалдыратыныңызға сенімдімін
Dialogue: 0,0:21:49.20,0:21:52.75,Default,,0,0,0,,Мені таң қалдырғаны сонша, ата-анамнан бөлінетін кез келді.
Dialogue: 0,0:21:53.83,0:21:54.29,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:22:01.12,0:22:06.16,Default,,0,0,0,,Фу ха ха ма икка
Dialogue: 0,0:22:12.12,0:22:15.50,Default,,0,0,0,,Жарайды, бұл махаббат.
Dialogue: 0,0:22:15.91,0:22:19.58,Default,,0,0,0,,Солай бола тұрса да, менің бұғы ана атанғанымда бір қателік бар.
Dialogue: 0,0:22:20.25,0:22:20.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:22:22.50,0:22:23.62,Default,,0,0,0,,Бұл Чоччаннан.
Dialogue: 0,0:22:24.83,0:22:26.95,Default,,0,0,0,,Иә, Хамагонның артынан.
Dialogue: 0,0:22:27.16,0:22:31.00,Default,,0,0,0,,Тағы бір жұмбақ тіршілік иесін көрді.
Dialogue: 0,0:22:31.25,0:22:34.58,Default,,0,0,0,,Мен оны Хамасси деп атап, тергеуді жалғастырғым келеді.
Dialogue: 0,0:22:35.41,0:22:37.75,Default,,0,0,0,,Маман
Dialogue: 0,0:22:37.95,0:22:38.29,Default,,0,0,0,,О.
Dialogue: 0,0:22:38.54,0:22:43.70,Default,,0,0,0,,Ах ха ха ха ха ха мен енді білмеймін
Dialogue: 0,0:22:53.12,0:22:57.91,Default,,0,0,0,,Қоңырау шалғаннан кейін де жауап жоқ
Dialogue: 0,0:22:58.08,0:23:01.33,Default,,0,0,0,,Сіз іздеген нәрсе
Dialogue: 0,0:23:02.58,0:23:06.33,Default,,0,0,0,,Жарқыраған жалын
Dialogue: 0,0:23:06.58,0:23:12.58,Default,,0,0,0,,Менің қателіктерімді де өрте
Dialogue: 0,0:23:12.95,0:23:17.91,Default,,0,0,0,,Мен сені қай жерде болсаң да іздеймін
Dialogue: 0,0:23:18.25,0:23:22.04,Default,,0,0,0,,сен сен сен
Dialogue: 0,0:23:22.41,0:23:29.58,Default,,0,0,0,,Бөлме шыққаннан кейін тыныш
Dialogue: 0,0:23:29.70,0:23:33.75,Default,,0,0,0,,Қайтару мүмкін емес уақыт
Dialogue: 0,0:23:33.91,0:23:37.58,Default,,0,0,0,,Қанша ойласам да
Dialogue: 0,0:23:38.08,0:23:48.29,Default,,0,0,0,,Тек сені кездестірсем деген тілекке толы түн
Dialogue: 0,0:23:48.50,0:23:53.20,Default,,0,0,0,,Қоңырау шалғаннан кейін де жауап жоқ
Dialogue: 0,0:23:53.41,0:23:56.41,Default,,0,0,0,,Сіз іздеген нәрсе
Dialogue: 0,0:23:57.79,0:24:01.62,Default,,0,0,0,,Жарқыраған жалын
Dialogue: 0,0:24:01.87,0:24:07.95,Default,,0,0,0,,Менің қателіктерімді өртеп жібер
Dialogue: 0,0:24:15.12,0:24:17.20,Default,,0,0,0,,Оны өртеп жіберіңіз
Dialogue: 0,0:24:19.54,0:24:20.95,Default,,0,0,0,,Көңіл көтеру - бұл қыздардың түні
Dialogue: 0,0:24:21.08,0:24:22.45,Default,,0,0,0,,Қызықты толқу
Dialogue: 0,0:24:22.70,0:24:24.95,Default,,0,0,0,,Қыздарға арналған қыздар кеші, қыздарға арналған
Dialogue: 0,0:24:25.12,0:24:27.45,Default,,0,0,0,,Бұл әдемі қыздар түні.
Dialogue: 0,0:24:27.54,0:24:30.12,Default,,0,0,0,,Қыздардың таңғаларлық кеші өтті...
Dialogue: 0,0:24:30.20,0:24:31.54,Default,,0,0,0,,Бұл нағыз қыздар түні ме?
Dialogue: 0,0:24:33.04,0:24:39.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory