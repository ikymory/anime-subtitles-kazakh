Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.16,0:00:11.04,Default,,0,0,0,,Кя, бұл қандай сүйкімді? Иә, сіз мұны шайқайсыз ба?
Dialogue: 0,0:00:11.41,0:00:13.70,Default,,0,0,0,,Утанае, сен мұны қолданасың ба? мен бұл
Dialogue: 0,0:00:13.95,0:00:16.12,Default,,0,0,0,,Ум, мен сондаймын.
Dialogue: 0,0:00:16.16,0:00:17.41,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:00:17.58,0:00:20.95,Default,,0,0,0,,Мен сені бүгін концертке және қыздар түніне тарту етемін деп айтқан жоқпын ба?
Dialogue: 0,0:00:21.87,0:00:23.62,Default,,0,0,0,,Ал мынау да, мынау да.
Dialogue: 0,0:00:23.70,0:00:25.25,Default,,0,0,0,,Уау, бұл жаман.
Dialogue: 0,0:00:26.08,0:00:27.62,Default,,0,0,0,,Кеңсе төлейді
Dialogue: 0,0:00:28.20,0:00:32.12,Default,,0,0,0,,Екеуміз ажырасқанда да алған заттарымды тастамайтын адаммын. Сен ше?
Dialogue: 0,0:00:32.33,0:00:33.83,Default,,0,0,0,,Мен мағынасын шынымен түсінбеймін.
Dialogue: 0,0:00:34.16,0:00:35.16,Default,,0,0,0,,Біраз
Dialogue: 0,0:00:35.33,0:00:37.83,Default,,0,0,0,,Маған осы дөрекі әңгімеге ерулеріңіз керек.
Dialogue: 0,0:00:38.08,0:00:39.87,Default,,0,0,0,,Бұл қыздардың түні, солай ма?
Dialogue: 0,0:00:40.00,0:00:42.50,Default,,0,0,0,,Сондықтан қыздар түнін бірінші рет өткізуім.
Dialogue: 0,0:00:43.00,0:00:46.20,Default,,0,0,0,,Ал Лист мырза бұрынғы адам.
Dialogue: 0,0:00:46.66,0:00:49.50,Default,,0,0,0,,Котен-чан, сен купальник алғың келе ме?
Dialogue: 0,0:00:49.58,0:00:53.66,Default,,0,0,0,,-Гах, сондықтан киер едім -Ааааааааааааааааааа
Dialogue: 0,0:00:54.12,0:00:55.66,Default,,0,0,0,,Бұл клубтың қызметі, солай ма?
Dialogue: 0,0:00:55.87,0:00:57.50,Default,,0,0,0,,Өйткені жүзу оңай
Dialogue: 0,0:00:57.91,0:01:02.12,Default,,0,0,0,,...
Dialogue: 0,0:01:02.25,0:01:03.62,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:01:03.87,0:01:05.12,Default,,0,0,0,,Сіз Шизукудың жерлеуіне келмедіңіз бе?
Dialogue: 0,0:01:05.79,0:01:07.29,Default,,0,0,0,,Олар келе жатыр ма?
Dialogue: 0,0:01:08.20,0:01:11.45,Default,,0,0,0,,Мистер Листтің барлық сән-салтанаты жасырын ма?
Dialogue: 0,0:01:11.83,0:01:15.04,Default,,0,0,0,,CLASKEY: KLASKY-дің тікелей эфирде орындауы жақын арада басталады.
Dialogue: 0,0:01:15.12,0:01:16.62,Default,,0,0,0,,Міне, осында.
Dialogue: 0,0:01:18.04,0:01:21.16,Default,,0,0,0,,Бассейнде тұру қызықсыз жұмыс.
Dialogue: 0,0:01:21.37,0:01:22.87,Default,,0,0,0,,Мен қашанға дейін мұны істеуге мәжбүр боламын?
Dialogue: 0,0:01:23.04,0:01:25.33,Default,,0,0,0,,Жазу және ұлттық турлар
Dialogue: 0,0:01:25.41,0:01:27.08,Default,,0,0,0,,Менің қолым бос емес.
Dialogue: 0,0:01:27.75,0:01:29.58,Default,,0,0,0,,-Иппиппи -Ауырып тұр
Dialogue: 0,0:01:29.95,0:01:31.54,Default,,0,0,0,,Сіз гиоза алғыңыз келе ме?
Dialogue: 0,0:01:32.04,0:01:33.45,Default,,0,0,0,,Сәлем Чаго-чан
Dialogue: 0,0:01:33.54,0:01:34.83,Default,,0,0,0,,Батаго
Dialogue: 0,0:01:35.12,0:01:38.25,Default,,0,0,0,,Есімдері сәйкес келмейді хаха
Dialogue: 0,0:01:38.58,0:01:42.79,Default,,0,0,0,,Сізге жақсырақ жұмыс таңдау керек емес пе?
Dialogue: 0,0:01:43.41,0:01:48.41,Default,,0,0,0,,Шынымен әркімнің жүрегіне жете ме деп ойлаймын.
Dialogue: 0,0:01:48.87,0:01:50.75,Default,,0,0,0,,Уф, кеттік.
Dialogue: 0,0:01:51.00,0:01:53.70,Default,,0,0,0,,Уф, күте тұрыңыз, Чайко-чан.
Dialogue: 0,0:01:54.29,0:01:57.08,Default,,0,0,0,,№
Dialogue: 0,0:01:57.20,0:01:59.50,Default,,0,0,0,,Сүйкімді және ұқыпты
Dialogue: 0,0:01:59.70,0:02:01.75,Default,,0,0,0,,Қаншалықты әйелдік
Dialogue: 0,0:02:02.08,0:02:05.37,Default,,0,0,0,,Мен олай тәрбиеленген жоқпын.
Dialogue: 0,0:02:07.04,0:02:09.08,Default,,0,0,0,,Мен мұны істей алмайтын сияқтымын Иә
Dialogue: 0,0:02:09.33,0:02:11.41,Default,,0,0,0,,Мен мұны істей алмайтын сияқтымын Иә
Dialogue: 0,0:02:11.79,0:02:14.83,Default,,0,0,0,,-Мен мұны істегім келмейді Иә, толығымен -Әрине, бұл керемет болуы мүмкін
Dialogue: 0,0:02:14.91,0:02:16.00,Default,,0,0,0,,Check Check Check Check Check
Dialogue: 0,0:02:16.33,0:02:18.66,Default,,0,0,0,,Мүмкін емес Мүлде мүмкін емес Мүмкін емес
Dialogue: 0,0:02:18.87,0:02:23.58,Default,,0,0,0,,- Мүмкін емес Мүлде мүмкін емес Мүмкін емес Мүмкін емес Мүлде мүмкін емес - Уау, құдайдың орындауының ең жоғары деңгейі -
Dialogue: 0,0:02:23.66,0:02:26.50,Default,,0,0,0,,-Мен енді мұны істей алмаймын -Бада Чайко
Dialogue: 0,0:02:27.33,0:02:30.41,Default,,0,0,0,,А, бұл қыздардың түні.
Dialogue: 0,0:02:31.20,0:02:34.08,Default,,0,0,0,,Утанаенің арқасында арманым орындалды. Рақмет сізге.
Dialogue: 0,0:02:34.54,0:02:37.45,Default,,0,0,0,,Осылай жүзіп, мен жақсы шоуды тамашалай алдым.
Dialogue: 0,0:02:37.50,0:02:40.16,Default,,0,0,0,,Бұл өте қызықты болды.
Dialogue: 0,0:02:40.45,0:02:41.95,Default,,0,0,0,,Бұл қыздар түні ме?
Dialogue: 0,0:02:42.70,0:02:46.70,Default,,0,0,0,,Қыздардың түні дейтін адамдармен сөйлесу қиын.
Dialogue: 0,0:02:47.04,0:02:48.12,Default,,0,0,0,,Олай болса үйге кететін уақыт келді...
Dialogue: 0,0:02:48.16,0:02:49.12,Default,,0,0,0,,Міне, келді.
Dialogue: 0,0:02:49.20,0:02:49.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:50.08,0:02:51.29,Default,,0,0,0,,Кокчи кокчи
Dialogue: 0,0:02:51.33,0:02:51.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:54.20,0:02:57.16,Default,,0,0,0,,-Біраз уақыт болды Чайко Бада -Угия
Dialogue: 0,0:02:57.25,0:02:57.91,Default,,0,0,0,,Чайко?
Dialogue: 0,0:02:58.25,0:02:58.75,Default,,0,0,0,,Бада?
Dialogue: 0,0:02:59.25,0:03:01.83,Default,,0,0,0,,Тш, мені олай атама.
Dialogue: 0,0:03:02.08,0:03:03.75,Default,,0,0,0,,Жанкүйерлер болса ше?
Dialogue: 0,0:03:03.79,0:03:06.29,Default,,0,0,0,,-Мен ауырдым, дем ала алмаймын -Ууууууу
Dialogue: 0,0:03:06.54,0:03:08.33,Default,,0,0,0,,Бұл шын ба?
Dialogue: 0,0:03:08.54,0:03:11.79,Default,,0,0,0,,Енді қыздар түнін бастайық!
Dialogue: 0,0:03:12.29,0:03:14.12,Default,,0,0,0,,Не, осы жерден?
Dialogue: 0,0:04:45.58,0:04:47.87,Default,,0,0,0,,А, дәмді көрінеді.
Dialogue: 0,0:04:48.00,0:04:49.00,Default,,0,0,0,,Бақытты
Dialogue: 0,0:04:49.29,0:04:52.33,Default,,0,0,0,,Қыздар түнін өткізіп жатырмыз, кездесейік!
Dialogue: 0,0:04:53.12,0:04:55.87,Default,,0,0,0,,-Сонда кенеттен электрондық хат алсаңыз, қиындыққа тап болмайсыз. -Хмм.
Dialogue: 0,0:04:56.25,0:04:59.91,Default,,0,0,0,,Иә, біз де бос емеспіз.
Dialogue: 0,0:05:00.25,0:05:02.41,Default,,0,0,0,,Өйткені қоңырау шалатын ешкім жоқ.
Dialogue: 0,0:05:02.87,0:05:05.79,Default,,0,0,0,,Ал, кеңседен рұқсатсыз шығып кетсең не айтасың?
Dialogue: 0,0:05:06.87,0:05:08.91,Default,,0,0,0,,Бұл өте дөрекі, солай емес пе?
Dialogue: 0,0:05:09.16,0:05:10.83,Default,,0,0,0,,Онда не үшін келдің?
Dialogue: 0,0:05:10.95,0:05:13.16,Default,,0,0,0,,-Менің ойымша, бұл маңызды. – Қыздар көбейді.
Dialogue: 0,0:05:13.33,0:05:16.20,Default,,0,0,0,,-Осындай атмосфера қыздардың кешіне жарай ма? -Жақсы емес пе?
Dialogue: 0,0:05:16.91,0:05:18.37,Default,,0,0,0,,Ууууууух
Dialogue: 0,0:05:18.91,0:05:20.20,Default,,0,0,0,,Ал сенің жігітің ше?
Dialogue: 0,0:05:20.45,0:05:21.70,Default,,0,0,0,,Амал жоқ
Dialogue: 0,0:05:22.04,0:05:23.62,Default,,0,0,0,,Сізге ұнайтын адам жоқ па?
Dialogue: 0,0:05:23.87,0:05:25.62,Default,,0,0,0,,Менің оны табуға уақытым жоқ.
Dialogue: 0,0:05:26.16,0:05:27.70,Default,,0,0,0,,Бұл тым көп жұмыс емес пе?
Dialogue: 0,0:05:28.00,0:05:29.50,Default,,0,0,0,,Мен жұмысты жек көрмеймін.
Dialogue: 0,0:05:32.37,0:05:35.70,Default,,0,0,0,,Бұл қызықсыз, балалар. Бұл қыздардың кеші.
Dialogue: 0,0:05:36.00,0:05:38.70,Default,,0,0,0,,Бұл менің сән-салтанатым, түсінемін.
Dialogue: 0,0:05:39.04,0:05:41.08,Default,,0,0,0,,Бұл бәрібір төлейтін кеңсе.
Dialogue: 0,0:05:41.41,0:05:42.79,Default,,0,0,0,,Бұл махаббатсыз жолдар.
Dialogue: 0,0:05:42.91,0:05:44.29,Default,,0,0,0,,Ах аа
Dialogue: 0,0:05:45.33,0:05:47.04,Default,,0,0,0,,Бұл бебебебебебе
Dialogue: 0,0:05:47.91,0:05:49.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:49.58,0:05:51.45,Default,,0,0,0,,Күрсін!
Dialogue: 0,0:05:51.62,0:05:52.45,Default,,0,0,0,,Иә
Dialogue: 0,0:05:52.58,0:05:54.45,Default,,0,0,0,,Жарайды, Утанае, сен де жақсысың.
Dialogue: 0,0:05:54.66,0:05:55.87,Default,,0,0,0,,Бір нәрсе киіңіз
Dialogue: 0,0:05:56.00,0:05:57.50,Default,,0,0,0,,Ух, біз күнде көрісеміз.
Dialogue: 0,0:05:57.62,0:05:59.50,Default,,0,0,0,,Сіз кенеттен осылай дедіңіз.
Dialogue: 0,0:05:59.54,0:06:01.87,Default,,0,0,0,,Жүрегімнің түбінде бәрі лай
Dialogue: 0,0:06:01.95,0:06:04.12,Default,,0,0,0,,Ондай қара нәрсе жоқ.
Dialogue: 0,0:06:04.54,0:06:05.08,Default,,0,0,0,,Әй
Dialogue: 0,0:06:05.50,0:06:06.08,Default,,0,0,0,,Га
Dialogue: 0,0:06:06.79,0:06:07.50,Default,,0,0,0,,-Ух-Деса
Dialogue: 0,0:06:07.54,0:06:07.79,Default,,0,0,0,,Әй
Dialogue: 0,0:06:07.87,0:06:10.29,Default,,0,0,0,,-Ол сол кезде Чочканның ғашығы болатын. -Хехе, хехе.
Dialogue: 0,0:06:10.66,0:06:14.54,Default,,0,0,0,,-Ол ерлермен қарым-қатынасы өте жарқыраған біртүрлі әйел -Хехехехе
Dialogue: 0,0:06:14.66,0:06:16.33,Default,,0,0,0,,- Кішкене ғана - Фуфуфуфу
Dialogue: 0,0:06:16.41,0:06:19.33,Default,,0,0,0,,-Мен де сол қызбен жүрдім. -Хехе, хехе, хехе.
Dialogue: 0,0:06:19.75,0:06:23.41,Default,,0,0,0,,-Бірақ 100 жылдан кейін бұл ескіру мерзімі. -Хехехехехе
Dialogue: 0,0:06:23.75,0:06:27.00,Default,,0,0,0,,-Бұл туралы біз алтыншы рет айтып отырмыз. -Хехе, хехе, хехе.
Dialogue: 0,0:06:27.12,0:06:28.87,Default,,0,0,0,,-Өтірік Бұл үшінші рет қана? -фуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфу
Dialogue: 0,0:06:28.95,0:06:30.75,Default,,0,0,0,,-Бір рет жеткілікті -Хехехехе
Dialogue: 0,0:06:31.12,0:06:31.50,Default,,0,0,0,,-Хаа -Ух
Dialogue: 0,0:06:31.62,0:06:31.87,Default,,0,0,0,,Әй
Dialogue: 0,0:06:32.29,0:06:32.66,Default,,0,0,0,,Әй
Dialogue: 0,0:06:32.83,0:06:33.29,Default,,0,0,0,,Әй
Dialogue: 0,0:06:33.54,0:06:33.87,Default,,0,0,0,,Әй
Dialogue: 0,0:06:34.04,0:06:34.58,Default,,0,0,0,,-Аа -Ах
Dialogue: 0,0:06:34.75,0:06:35.12,Default,,0,0,0,,Әй
Dialogue: 0,0:06:35.20,0:06:37.25,Default,,0,0,0,,-Жарайды мен саған кешірім ретінде бірдеңе сатып аламын -Хехе хехе
Dialogue: 0,0:06:37.62,0:06:38.16,Default,,0,0,0,,- Иә? -Хмф
Dialogue: 0,0:06:38.37,0:06:38.75,Default,,0,0,0,,Әй
Dialogue: 0,0:06:38.95,0:06:41.08,Default,,0,0,0,,Хмф, сағ, сағ, сағ.
Dialogue: 0,0:06:41.41,0:06:43.58,Default,,0,0,0,,Жоқ, жоқ, шынымен.
Dialogue: 0,0:06:44.08,0:06:46.12,Default,,0,0,0,,Егер сіз жай ғана қолданып көрсеңіз, бұл тегін.
Dialogue: 0,0:06:46.20,0:06:46.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:47.83,0:06:51.29,Default,,0,0,0,,Мен Китен екеумізді қыздардың кешіне шақырдым.
Dialogue: 0,0:06:52.25,0:06:55.50,Default,,0,0,0,,Бұдан былай бейтаныс адамның көзқарасы қандай? Егер солай болса
Dialogue: 0,0:06:55.54,0:06:57.58,Default,,0,0,0,,Күн екеуміз ғана болса жақсы болар еді.
Dialogue: 0,0:06:58.00,0:06:59.20,Default,,0,0,0,,Егер сіз осындай нәрсені айтқан болсаңыз да
Dialogue: 0,0:06:59.25,0:07:01.70,Default,,0,0,0,,Мен де ол қыздың осында болады деп күтпедім.
Dialogue: 0,0:07:02.00,0:07:04.37,Default,,0,0,0,,Иә, мен келгенде таң қалдым.
Dialogue: 0,0:07:04.87,0:07:06.62,Default,,0,0,0,,Сіз бұл котенок кінәлі дейсіз бе?
Dialogue: 0,0:07:07.54,0:07:08.66,Default,,0,0,0,,Мен оны кие алдым
Dialogue: 0,0:07:08.70,0:07:09.12,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:07:10.50,0:07:12.75,Default,,0,0,0,,Сіз қалай ойлайсыз? хехехе
Dialogue: 0,0:07:13.00,0:07:14.08,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:14.37,0:07:14.87,Default,,0,0,0,,Келесі
Dialogue: 0,0:07:15.20,0:07:15.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:16.66,0:07:19.16,Default,,0,0,0,,Өйткені, сен ол қызды танымайсың ғой?
Dialogue: 0,0:07:19.29,0:07:19.79,Default,,0,0,0,,Қый!
Dialogue: 0,0:07:20.33,0:07:22.87,Default,,0,0,0,,Үйге шабуыл жасаған және егеуқұйрықтарды қоздырған
Dialogue: 0,0:07:22.95,0:07:24.20,Default,,0,0,0,,Қандай ұят
Dialogue: 0,0:07:24.45,0:07:25.62,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:26.16,0:07:27.62,Default,,0,0,0,,Олай десеңіз, біз жаумыз.
Dialogue: 0,0:07:27.87,0:07:30.37,Default,,0,0,0,,Бірақ қазір мен қатты күлдім
Dialogue: 0,0:07:30.75,0:07:31.20,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:07:32.25,0:07:34.66,Default,,0,0,0,,Бұл аздап ыңғайсыз ба?
Dialogue: 0,0:07:36.66,0:07:37.41,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:07:37.91,0:07:38.45,Default,,0,0,0,,Келесі
Dialogue: 0,0:07:38.79,0:07:39.70,Default,,0,0,0,,Гарн
Dialogue: 0,0:07:41.04,0:07:43.58,Default,,0,0,0,,Ха, шынымды айтсам, балалар.
Dialogue: 0,0:07:44.16,0:07:46.70,Default,,0,0,0,,Сіз бірдеңе істеуге кедергі жасамадыңыз ба немесе мәжбүрлеген жоқсыз ба?
Dialogue: 0,0:07:47.08,0:07:48.37,Default,,0,0,0,,Мен сені асыға күтемін.
Dialogue: 0,0:07:48.58,0:07:49.08,Default,,0,0,0,,Ах
Dialogue: 0,0:07:50.79,0:07:51.83,Default,,0,0,0,,Не?
Dialogue: 0,0:07:52.41,0:07:55.37,Default,,0,0,0,,Бұл туралы шыншыл болыңыз.
Dialogue: 0,0:07:55.95,0:07:58.29,Default,,0,0,0,,Иә, менің айтқым келетін нәрселер көп.
Dialogue: 0,0:07:58.33,0:08:01.50,Default,,0,0,0,,Ол әлдеқашан ашылды, көңілсіз әйел.
Dialogue: 0,0:08:01.54,0:08:02.04,Default,,0,0,0,,На
Dialogue: 0,0:08:02.50,0:08:03.79,Default,,0,0,0,,Ақырында білдің бе?
Dialogue: 0,0:08:04.04,0:08:06.45,Default,,0,0,0,,Мен жинадым...
Dialogue: 0,0:08:08.20,0:08:08.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:09.20,0:08:10.20,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:08:10.75,0:08:11.41,Default,,0,0,0,,Иә
Dialogue: 0,0:08:11.79,0:08:12.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:12.50,0:08:14.12,Default,,0,0,0,,Кассадан шығу
Dialogue: 0,0:08:18.16,0:08:21.75,Default,,0,0,0,,Дүйсенбіден бастап қол алысу шарасы
Dialogue: 0,0:08:21.95,0:08:25.33,Default,,0,0,0,,Тұз сәйкестігін мазақтауға болады
Dialogue: 0,0:08:25.66,0:08:29.08,Default,,0,0,0,,Мен сейсенбі күні ән мәтінін ұмытып кетіппін
Dialogue: 0,0:08:29.33,0:08:32.83,Default,,0,0,0,,Мен күбірледім, бірақ ол бірден ашылды.
Dialogue: 0,0:08:33.16,0:08:36.50,Default,,0,0,0,,Сәрсенбі күні түні бойы қол қою
Dialogue: 0,0:08:36.83,0:08:40.29,Default,,0,0,0,,Жарылған қолдардан қан ағады
Dialogue: 0,0:08:40.66,0:08:44.16,Default,,0,0,0,,Бейсенбі күні жұмысқа кешігіп келу
Dialogue: 0,0:08:44.37,0:08:47.83,Default,,0,0,0,,Мен қоқыс және ақымақпын деп айғайлады.
Dialogue: 0,0:08:48.29,0:08:51.62,Default,,0,0,0,,Жұма күні би жаттығуы
Dialogue: 0,0:08:51.91,0:08:55.29,Default,,0,0,0,,Биік өкшелі туфли буын созады
Dialogue: 0,0:08:55.62,0:08:59.12,Default,,0,0,0,,Ауыруы сенбі күні де басылмады.
Dialogue: 0,0:08:59.37,0:09:02.83,Default,,0,0,0,,Тісімді қыссам, тісім жарылып кетті.
Dialogue: 0,0:09:03.20,0:09:06.58,Default,,0,0,0,,Жексенбіде үйге телефон соғу
Dialogue: 0,0:09:06.91,0:09:10.33,Default,,0,0,0,,Мен солай ойладым, бірақ менің үйім жоқ.
Dialogue: 0,0:09:10.70,0:09:14.12,Default,,0,0,0,,Бұл менің аптам
Dialogue: 0,0:09:14.37,0:09:18.00,Default,,0,0,0,,Icicle Icicle Icicle
Dialogue: 0,0:09:18.16,0:09:18.66,Default,,0,0,0,,Бұл не өзі? Бұл кішкентай ит
Dialogue: 0,0:09:22.83,0:09:24.41,Default,,0,0,0,,Уа аа аа аа
Dialogue: 0,0:09:24.91,0:09:28.45,Default,,0,0,0,,Балалар, сендерде қиын жұмыс бар.
Dialogue: 0,0:09:28.87,0:09:30.62,Default,,0,0,0,,Өйткені бұл орыс халық әні
Dialogue: 0,0:09:31.08,0:09:33.00,Default,,0,0,0,,Әннің сөзі қалай тыңдасаң да әр түрлі.
Dialogue: 0,0:09:33.12,0:09:33.75,Default,,0,0,0,,Мен берілмеймін. Бір адамның да өлуіне жол бермеймін
Dialogue: 0,0:09:34.00,0:09:34.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:35.29,0:09:38.04,Default,,0,0,0,,Өйткені, Чайко-сан мен Бада-санның әні
Dialogue: 0,0:09:38.91,0:09:41.08,Default,,0,0,0,,Бұл менің жүрегіме қатты әсер етті.
Dialogue: 0,0:09:41.33,0:09:41.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:42.54,0:09:44.04,Default,,0,0,0,,Біздің ән
Dialogue: 0,0:09:44.66,0:09:46.25,Default,,0,0,0,,Менің жүрегіме жетті
Dialogue: 0,0:09:47.08,0:09:48.00,Default,,0,0,0,,-Ах-хэ
Dialogue: 0,0:09:48.41,0:09:51.41,Default,,0,0,0,,Дұрыс, мен бар күшімді салдым.
Dialogue: 0,0:09:51.95,0:09:55.62,Default,,0,0,0,,Ер адамдар бәрібір түсінбейді.
Dialogue: 0,0:09:55.91,0:09:59.33,Default,,0,0,0,,Егер сіз дүйсенбі күні тазаласаңыз
Dialogue: 0,0:09:59.62,0:10:03.08,Default,,0,0,0,,Моту-сан сейсенбіде ластанған
Dialogue: 0,0:10:03.50,0:10:06.75,Default,,0,0,0,,Бетоны сәрсенбі күні өртеп жіберді
Dialogue: 0,0:10:07.00,0:10:10.50,Default,,0,0,0,,Бейсенбі күні мердігерлермен жойылды
Dialogue: 0,0:10:10.83,0:10:14.25,Default,,0,0,0,,Демалыс күні жалға алу күні болса да
Dialogue: 0,0:10:14.58,0:10:17.95,Default,,0,0,0,,Тек Лист мырза төлейді.
Dialogue: 0,0:10:18.25,0:10:21.87,Default,,0,0,0,,Icicle Icicle Icicle Icicle Icicle
Dialogue: 0,0:10:22.16,0:10:25.62,Default,,0,0,0,,-Цура Цура Icicle -Ахаха
Dialogue: 0,0:10:25.91,0:10:29.29,Default,,0,0,0,,Айдақ Айдақ Айдақ Айдақ
Dialogue: 0,0:10:29.54,0:10:33.00,Default,,0,0,0,,Icicle Icicle Icicle
Dialogue: 0,0:10:33.16,0:10:33.70,Default,,0,0,0,,Тағы бір рет
Dialogue: 0,0:10:33.91,0:10:36.75,Default,,0,0,0,,-Tsura tsura tsura tsura cicle icicle -Артық емес
Dialogue: 0,0:10:36.87,0:10:42.41,Default,,0,0,0,,-Еркектер үйден шығады--Жарайды, котенка, жарайды.
Dialogue: 0,0:10:43.45,0:10:45.95,Default,,0,0,0,,Хусси әйел? Еркек пе?
Dialogue: 0,0:10:46.91,0:10:51.41,Default,,0,0,0,,Рас, екі жағынан да маңызды емес, бірақ бөксеге қарап айта алмаймын.
Dialogue: 0,0:10:53.04,0:10:57.20,Default,,0,0,0,,- хекшоун
Dialogue: 0,0:10:58.25,0:11:01.33,Default,,0,0,0,,Сенпай, үй ішінде қанша уақыт боласың?
Dialogue: 0,0:11:02.50,0:11:04.95,Default,,0,0,0,,Icicle Icicle Icicle Icicle
Dialogue: 0,0:11:05.33,0:11:08.62,Default,,0,0,0,,-Цура Цура Цура -Жарайды, ашық айт.
Dialogue: 0,0:11:08.79,0:11:12.91,Default,,0,0,0,,-Олай десең, анау шашың болмайды.
Dialogue: 0,0:11:13.12,0:11:13.45,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:11:17.04,0:11:21.50,Default,,0,0,0,,Мен айттым, енді қайта алмаймын.
Dialogue: 0,0:11:21.54,0:11:24.41,Default,,0,0,0,,Жақсы, бұл жақсы.
Dialogue: 0,0:11:24.70,0:11:25.33,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:11:25.41,0:11:25.75,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:11:26.08,0:11:28.95,Default,,0,0,0,,Бұл қыздардың түні, бір-бірімізге ашық айтайық.
Dialogue: 0,0:11:29.00,0:11:31.37,Default,,0,0,0,,Алға қарай жүрейік
Dialogue: 0,0:11:31.75,0:11:32.70,Default,,0,0,0,,О
Dialogue: 0,0:11:33.12,0:11:33.62,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:11:34.25,0:11:36.33,Default,,0,0,0,,Ия
Dialogue: 0,0:11:36.50,0:11:37.62,Default,,0,0,0,,Мынау
Dialogue: 0,0:11:38.25,0:11:42.41,Default,,0,0,0,,-Қыздар түні демалу деген осы. -Айсұлу Тура Тура Тура Мұз айдыны
Dialogue: 0,0:11:42.83,0:11:46.37,Default,,0,0,0,,-Цура Цура Цура -Қыздар кеші қалай аталады?
Dialogue: 0,0:11:46.50,0:11:47.41,Default,,0,0,0,,Ойласам, біз ұзақ уақыт сөйлеспеген сияқтымыз
Dialogue: 0,0:11:54.12,0:11:57.58,Default,,0,0,0,,Ахахахаха
Dialogue: 0,0:11:57.70,0:12:00.04,Default,,0,0,0,,Не? Чайко-сан және Бада-сан
Dialogue: 0,0:12:00.08,0:12:03.37,Default,,0,0,0,,Сіз көп нәрсені білесіз бе? Бето немесе ішімдік
Dialogue: 0,0:12:03.50,0:12:06.20,Default,,0,0,0,,Сіз не білесіз? Олар қазір байсалды.
Dialogue: 0,0:12:08.12,0:12:10.95,Default,,0,0,0,,Увахахахахахаха
Dialogue: 0,0:12:11.04,0:12:13.37,Default,,0,0,0,,Сондай-ақ, Шопен жалғыз.
Dialogue: 0,0:12:15.08,0:12:17.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:17.54,0:12:19.29,Default,,0,0,0,,Сондықтан да
Dialogue: 0,0:12:20.83,0:12:22.91,Default,,0,0,0,,Ахахахаха
Dialogue: 0,0:12:26.37,0:12:28.20,Default,,0,0,0,,Мен бірдеңені анықтай алмаймын.
Dialogue: 0,0:12:29.04,0:12:31.79,Default,,0,0,0,,Сіз адам ретінде мүлдем бас тарттыңыз ба?
Dialogue: 0,0:12:32.25,0:12:35.08,Default,,0,0,0,,Біріншіден, олардың бәрі адам емес.
Dialogue: 0,0:12:35.41,0:12:37.83,Default,,0,0,0,,Сосуке адам ғой.
Dialogue: 0,0:12:38.00,0:12:38.91,Default,,0,0,0,,Бір жағдайда?
Dialogue: 0,0:12:39.08,0:12:41.00,Default,,0,0,0,,Бұл да ұят.
Dialogue: 0,0:12:41.08,0:12:42.50,Default,,0,0,0,,-Дұрыс. -А?
Dialogue: 0,0:12:42.58,0:12:43.54,Default,,0,0,0,,Қанағаттанарлықсыз
Dialogue: 0,0:12:43.62,0:12:45.41,Default,,0,0,0,,-Қызықсыз -Уф
Dialogue: 0,0:12:45.45,0:12:46.87,Default,,0,0,0,,Бұл сұмдық.
Dialogue: 0,0:12:47.20,0:12:50.04,Default,,0,0,0,,-Ахахахаха -Не істеуім керек?
Dialogue: 0,0:12:53.50,0:12:57.79,Default,,0,0,0,,Сәттілік Ахха Уфуфу
Dialogue: 0,0:12:57.87,0:12:59.04,Default,,0,0,0,,Ммм, бұл жақсы.
Dialogue: 0,0:12:59.08,0:13:02.04,Default,,0,0,0,,Бірақ сіз қайық жалдау үшін кеңсе картасын пайдалана аласыз.
Dialogue: 0,0:13:02.41,0:13:03.66,Default,,0,0,0,,-Бұл шынымен жақсы ма? -Хмммммм
Dialogue: 0,0:13:03.83,0:13:05.41,Default,,0,0,0,,Тоқтатпау одан да жаман.
Dialogue: 0,0:13:05.79,0:13:07.87,Default,,0,0,0,,Мен оны қазір толық пайдалануым керек.
Dialogue: 0,0:13:08.45,0:13:09.54,Default,,0,0,0,,Қазір сол адам
Dialogue: 0,0:13:09.62,0:13:12.50,Default,,0,0,0,,Егер сізден осылай есеп айырысатын болса, сіз оны мүлдем байқамайсыз деп ойлаймын.
Dialogue: 0,0:13:12.83,0:13:14.91,Default,,0,0,0,,Ол ауыртпауы немесе қышуы болмауы мүмкін.
Dialogue: 0,0:13:15.29,0:13:17.70,Default,,0,0,0,,Сіз соншалықты байсыз ба?
Dialogue: 0,0:13:18.33,0:13:19.70,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:20.33,0:13:22.66,Default,,0,0,0,,Ұлы үшін ақша ештеңе емес
Dialogue: 0,0:13:22.70,0:13:24.58,Default,,0,0,0,,Бұл болмашы нәрсе.
Dialogue: 0,0:13:24.75,0:13:27.29,Default,,0,0,0,,Сіз мені қатты құрметтейсіз.
Dialogue: 0,0:13:27.70,0:13:31.70,Default,,0,0,0,,Хмм, эй, сен сондай болсаң.
Dialogue: 0,0:13:32.54,0:13:33.91,Default,,0,0,0,,Егер біз кездесе бастасақ ше?
Dialogue: 0,0:13:34.33,0:13:37.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:37.79,0:13:40.25,Default,,0,0,0,,Мүмкін емес, мүмкін емес, сен қартсың ба?
Dialogue: 0,0:13:40.33,0:13:41.12,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:13:41.29,0:13:41.66,Default,,0,0,0,,О.
Dialogue: 0,0:13:42.95,0:13:47.58,Default,,0,0,0,,Да ба ах Анчан Шиокара
Dialogue: 0,0:13:47.66,0:13:48.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:48.16,0:13:50.50,Default,,0,0,0,,Ча, Чайко-чан қарт болып қайтады.
Dialogue: 0,0:13:50.66,0:13:51.12,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:51.50,0:13:52.95,Default,,0,0,0,,Ояджигари
Dialogue: 0,0:13:53.37,0:13:56.62,Default,,0,0,0,,Мен ол адам туралы уайымдағанда солай болады.
Dialogue: 0,0:13:56.83,0:13:57.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:57.95,0:14:00.37,Default,,0,0,0,,Шиокара мұнда француз ма?
Dialogue: 0,0:14:00.87,0:14:01.33,Default,,0,0,0,,Уф
Dialogue: 0,0:14:02.33,0:14:04.87,Default,,0,0,0,,Шарап ішетін жалғыз Риччан екені таңқаларлық емес.
Dialogue: 0,0:14:05.45,0:14:08.83,Default,,0,0,0,,Мен ересек болуға дайынмын, сондықтан...
Dialogue: 0,0:14:09.33,0:14:10.83,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:14:10.87,0:14:13.45,Default,,0,0,0,,Бізді жасөспірім ретінде орнатқанымыз осылай болады.
Dialogue: 0,0:14:13.50,0:14:14.62,Default,,0,0,0,,Бұл зімбір але.
Dialogue: 0,0:14:14.87,0:14:16.29,Default,,0,0,0,,Тек Риччан ғана жарайды.
Dialogue: 0,0:14:16.45,0:14:18.29,Default,,0,0,0,,-Не болып жатыр? -Чайко-чан, доғар.
Dialogue: 0,0:14:18.45,0:14:19.66,Default,,0,0,0,,Егер сізді біреу көрсе
Dialogue: 0,0:14:19.75,0:14:21.25,Default,,0,0,0,,Бұл бір соққының кереметі
Dialogue: 0,0:14:22.25,0:14:23.75,Default,,0,0,0,,Бір, бір, бір
Dialogue: 0,0:14:24.75,0:14:27.58,Default,,0,0,0,,Хехехе мен тараймын.
Dialogue: 0,0:14:27.70,0:14:29.33,Default,,0,0,0,,-Тынышталыңыз.
Dialogue: 0,0:14:29.62,0:14:31.50,Default,,0,0,0,,Бұл сізді тыныштандырады ма?
Dialogue: 0,0:14:31.54,0:14:33.29,Default,,0,0,0,,-Бұл сенің жолың -Ааа
Dialogue: 0,0:14:33.37,0:14:33.75,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:33.79,0:14:34.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:34.58,0:14:35.20,Default,,0,0,0,,Не?
Dialogue: 0,0:14:35.33,0:14:37.20,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:14:37.29,0:14:38.45,Default,,0,0,0,,-Сусуке Сосуке -Ой?
Dialogue: 0,0:14:40.33,0:14:44.29,Default,,0,0,0,,Мен «Bada one-hit wonder composer» деп іздедім. Нәтижелер бар
Dialogue: 0,0:14:46.00,0:14:48.79,Default,,0,0,0,,Текла Бадаевска?
Dialogue: 0,0:14:49.54,0:14:52.87,Default,,0,0,0,,Дүние жүзі бойынша бір ғана хитпен «Otome no Prayer»
Dialogue: 0,0:14:52.91,0:14:55.70,Default,,0,0,0,,Ол әйгілі поляк композиторы.
Dialogue: 0,0:14:56.20,0:14:57.50,Default,,0,0,0,,Сіз естіген әндер
Dialogue: 0,0:14:58.50,0:15:01.29,Default,,0,0,0,,Сонымен, Бада-чан да классикалоид болып табылады ма?
Dialogue: 0,0:15:01.54,0:15:03.45,Default,,0,0,0,,Сондай-ақ, Чайконы іздеңіз.
Dialogue: 0,0:15:03.50,0:15:06.45,Default,,0,0,0,,CLASKEY: KLASKY қатысты элементтерді қоспағанда, іздеу нәтижелері
Dialogue: 0,0:15:06.70,0:15:07.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:07.58,0:15:09.04,Default,,0,0,0,,Өте жақсы.
Dialogue: 0,0:15:09.20,0:15:09.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:10.70,0:15:12.37,Default,,0,0,0,,Петр Чайковский
Dialogue: 0,0:15:12.54,0:15:15.54,Default,,0,0,0,,1800 жылдардағы ұлы орыс композиторы
Dialogue: 0,0:15:16.37,0:15:19.33,Default,,0,0,0,,Бұл сақал Чайко ма?
Dialogue: 0,0:15:19.75,0:15:21.66,Default,,0,0,0,,Уф, өтіріктен басқа ештеңе айтпа.
Dialogue: 0,0:15:21.70,0:15:23.70,Default,,0,0,0,,-Иә? Пэд-кун өтірік айтпайды - Эй Ан-Чан
Dialogue: 0,0:15:23.83,0:15:24.33,Default,,0,0,0,,Иә
Dialogue: 0,0:15:24.66,0:15:26.12,Default,,0,0,0,,Кинккин арақ
Dialogue: 0,0:15:26.20,0:15:28.16,Default,,0,0,0,,-Жоқ, сіз кәмелетке толмаған шығарсыз.
Dialogue: 0,0:15:28.58,0:15:30.12,Default,,0,0,0,,-Қазір бас тарту -Nunu Nu
Dialogue: 0,0:15:30.20,0:15:30.58,Default,,0,0,0,,Иә
Dialogue: 0,0:15:30.79,0:15:32.79,Default,,0,0,0,,-Мен өзімді әдемі қыз болуға мәжбүрледім -Уф
Dialogue: 0,0:15:32.95,0:15:34.87,Default,,0,0,0,,Ішпей-ақ істей алмаймын.
Dialogue: 0,0:15:35.20,0:15:38.62,Default,,0,0,0,,Сіз ішімдік ішсеңіз ажырасамыз дедіңіз ғой? Мен айттым ғой, солай ма?
Dialogue: 0,0:15:39.00,0:15:42.37,Default,,0,0,0,,Ой, жарайды, мен ажырасамын. Қайтып кел.
Dialogue: 0,0:15:42.62,0:15:45.20,Default,,0,0,0,,Ол енді кәдімгі сақалды жігітке айналды.
Dialogue: 0,0:15:45.25,0:15:48.62,Default,,0,0,0,,-Ей, олай айтпа. -Өтірік.
Dialogue: 0,0:15:49.33,0:15:53.33,Default,,0,0,0,,О, құдай-ау, қыздардың түнгі түні соншалықты дөрекі бола ма?
Dialogue: 0,0:15:53.50,0:15:57.20,Default,,0,0,0,,Мен олай ойламаймын. Бұл не?
Dialogue: 0,0:15:57.58,0:15:58.00,Default,,0,0,0,,Ах
Dialogue: 0,0:15:58.37,0:15:58.87,Default,,0,0,0,,Ах
Dialogue: 0,0:16:00.50,0:16:01.00,Default,,0,0,0,,Ах
Dialogue: 0,0:16:01.83,0:16:03.25,Default,,0,0,0,,Сол адамнан
Dialogue: 0,0:16:06.29,0:16:07.29,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:16:08.20,0:16:08.83,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:16:10.75,0:16:11.25,Default,,0,0,0,,Га
Dialogue: 0,0:16:11.91,0:16:13.50,Default,,0,0,0,,Мен оны спикер ретінде қабылдаймын.
Dialogue: 0,0:16:13.79,0:16:14.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:15.12,0:16:17.50,Default,,0,0,0,,Бүгінгі қыздар кешінің көрнекті көрінісі осы.
Dialogue: 0,0:16:19.12,0:16:22.33,Default,,0,0,0,,Дұрыс айт, не айтқың келеді
Dialogue: 0,0:16:22.87,0:16:23.79,Default,,0,0,0,,Мен сені қолдаймын
Dialogue: 0,0:16:24.25,0:16:25.12,Default,,0,0,0,,Чайко-чан
Dialogue: 0,0:16:25.29,0:16:28.00,Default,,0,0,0,,уһ уһ уһ
Dialogue: 0,0:16:30.54,0:16:34.75,Default,,0,0,0,,Уу мо мо сус мосу
Dialogue: 0,0:16:35.41,0:16:36.54,Default,,0,0,0,,Лентезца
Dialogue: 0,0:16:36.70,0:16:40.33,Default,,0,0,0,,Ах аа Ку аа аа
Dialogue: 0,0:16:40.91,0:16:45.79,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:16:46.12,0:16:47.25,Default,,0,0,0,,Стретта
Dialogue: 0,0:16:48.62,0:16:51.00,Default,,0,0,0,,Мен шынымен кешірім сұраймын
Dialogue: 0,0:16:51.37,0:16:52.45,Default,,0,0,0,,Стретта
Dialogue: 0,0:16:52.62,0:16:56.75,Default,,0,0,0,,- Кешіріңізші, мен бірден үйге баруды жоспарлап едім - Ууууууууууууууууу
Dialogue: 0,0:16:56.95,0:16:58.87,Default,,0,0,0,,-у-у-у-ах
Dialogue: 0,0:16:59.00,0:17:01.75,Default,,0,0,0,,-Сіз толығымен басқарылады. -Ууууууууууууууууууууу
Dialogue: 0,0:17:01.83,0:17:05.58,Default,,0,0,0,,- Телефонның арғы жағындағы жігіт не болды?
Dialogue: 0,0:17:05.87,0:17:09.79,Default,,0,0,0,,-Түсіндім. Басы айналып кетті. -Уф.
Dialogue: 0,0:17:10.66,0:17:11.83,Default,,0,0,0,,Қазіргі жағдайда оның барар жері жоқ.
Dialogue: 0,0:17:12.29,0:17:14.29,Default,,0,0,0,,Жиренішті басқарушының кесірінен
Dialogue: 0,0:17:14.70,0:17:17.62,Default,,0,0,0,,Менің Чайко мен Бадакюн есінен танып қалды, солай емес пе?
Dialogue: 0,0:17:17.87,0:17:18.62,Default,,0,0,0,,Сосуке?
Dialogue: 0,0:17:20.16,0:17:21.58,Default,,0,0,0,,Хабарламаға қызмет көрсету
Dialogue: 0,0:17:21.91,0:17:25.62,Default,,0,0,0,,Ха, мен не айтып тұрғаныңды түсінбедім. Дұрыс сөйле.
Dialogue: 0,0:17:26.00,0:17:27.33,Default,,0,0,0,,Екеуміз де жылап қалдық.
Dialogue: 0,0:17:27.54,0:17:30.29,Default,,0,0,0,,Жүрегімде қариядай өзгеше бір тұлға туды.
Dialogue: 0,0:17:30.45,0:17:31.16,Default,,0,0,0,,О
Dialogue: 0,0:17:31.25,0:17:33.50,Default,,0,0,0,,Агенттік әртістерге дұрыс қарамаса, мен не істей аламын?
Dialogue: 0,0:17:33.87,0:17:37.37,Default,,0,0,0,,Маған бірдеңе айтшы, сен не істеп жатырсың?
Dialogue: 0,0:17:37.79,0:17:40.66,Default,,0,0,0,,Уф, Бах мырза.
Dialogue: 0,0:17:41.00,0:17:41.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:42.04,0:17:43.50,Default,,0,0,0,,Кура Кура Продюсер
Dialogue: 0,0:17:43.87,0:17:46.50,Default,,0,0,0,,Иоганн Себастьян Бах.
Dialogue: 0,0:17:46.83,0:17:51.37,Default,,0,0,0,,Иә, Бах? Сол данышпан?
Dialogue: 0,0:17:51.75,0:17:55.08,Default,,0,0,0,,Мен құрметтейтін қазіргі супер атақты адам кім?
Dialogue: 0,0:17:55.41,0:17:58.58,Default,,0,0,0,,Бұл менеджер немесе басқа нәрсе емес еді.
Dialogue: 0,0:17:58.91,0:18:01.45,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:18:02.04,0:18:03.25,Default,,0,0,0,,Уф
Dialogue: 0,0:18:04.91,0:18:10.83,Default,,0,0,0,,Уф, мен де сіздің талантыңызды танимын, солай ма?
Dialogue: 0,0:18:11.95,0:18:18.37,Default,,0,0,0,,Бірақ мен де суретшімін.
Dialogue: 0,0:18:18.75,0:18:19.12,Default,,0,0,0,,Уф
Dialogue: 0,0:18:19.20,0:18:22.45,Default,,0,0,0,,-Уау, бұл тамаша. -Аа, ааа.
Dialogue: 0,0:18:23.16,0:18:24.70,Default,,0,0,0,,Менің айтқым келгені
Dialogue: 0,0:18:25.25,0:18:27.12,Default,,0,0,0,,-Сәлем -Ах
Dialogue: 0,0:18:27.25,0:18:31.25,Default,,0,0,0,,-Сосуке сен неге сонша уайымдайсың? – Менің де айтарым бар.
Dialogue: 0,0:18:31.45,0:18:35.20,Default,,0,0,0,,-Дұрыс...
Dialogue: 0,0:18:37.16,0:18:40.79,Default,,0,0,0,,Менің ойымша, бұл махаббат.
Dialogue: 0,0:18:48.95,0:18:49.62,Default,,0,0,0,,О
Dialogue: 0,0:18:49.87,0:18:50.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:50.91,0:18:52.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:57.45,0:19:00.25,Default,,0,0,0,,Мойындау үшін батылдық - бұл шын махаббат
Dialogue: 0,0:19:00.91,0:19:04.33,Default,,0,0,0,,Егер бізде сол күш болса, бәріміз де қанатымызды кеңірек жая аламыз.
Dialogue: 0,0:19:06.45,0:19:08.50,Default,,0,0,0,,А, мен анық айтайын.
Dialogue: 0,0:19:09.08,0:19:11.25,Default,,0,0,0,,A. Суретшілерден қаша алатын продюсерлер.
Dialogue: 0,0:19:11.87,0:19:15.25,Default,,0,0,0,,Шынымды айтсам, бұл боқтық, солай емес пе?
Dialogue: 0,0:19:15.50,0:19:21.66,Default,,0,0,0,,Мен айттым. Көбірек айт. Бұл қыздардың түні. Бұл махаббат.
Dialogue: 0,0:19:21.91,0:19:23.50,Default,,0,0,0,,-Әдетте мен оны ешқашан аша алмаймын -Жоқ.
Dialogue: 0,0:19:23.62,0:19:26.45,Default,,0,0,0,,- Біздің сезімімізді мойындау кезеңі - Яфуу
Dialogue: 0,0:19:26.95,0:19:30.08,Default,,0,0,0,,Біз шын мәнінде бір рет қолданылатынбыз.
Dialogue: 0,0:19:30.33,0:19:32.54,Default,,0,0,0,,Бұл жүрексіз адам
Dialogue: 0,0:19:33.54,0:19:34.95,Default,,0,0,0,,Чай осында.
Dialogue: 0,0:19:35.54,0:19:39.08,Default,,0,0,0,,Менің әндеріме де, әндеріме де үлкен үміт күтпейсіз.
Dialogue: 0,0:19:39.45,0:19:40.87,Default,,0,0,0,,Үлкен өтірікші
Dialogue: 0,0:19:41.75,0:19:43.29,Default,,0,0,0,,Бада да келді
Dialogue: 0,0:19:43.79,0:19:45.66,Default,,0,0,0,,Париксіз жақсырақ
Dialogue: 0,0:19:46.16,0:19:48.45,Default,,0,0,0,,Бұл жақсырақ емес пе?
Dialogue: 0,0:19:49.08,0:19:53.87,Default,,0,0,0,,Аға ұрпақ келді. Әрбір азапты күн, жинақталған нәрсе - махаббат.
Dialogue: 0,0:19:54.37,0:19:56.12,Default,,0,0,0,,Егер біз іштей сүйіспеншілігімізді білдірсек
Dialogue: 0,0:19:56.58,0:19:58.83,Default,,0,0,0,,Сол кезде қыздардың түнгі демалысы гүлдейді
Dialogue: 0,0:20:00.95,0:20:03.66,Default,,0,0,0,,Шынымды айтсам, сіз мені ашқан жоқсыз.
Dialogue: 0,0:20:04.20,0:20:06.45,Default,,0,0,0,,Мен әлі құдаймын деп айта алмаймын.
Dialogue: 0,0:20:06.70,0:20:08.33,Default,,0,0,0,,Жүр!
Dialogue: 0,0:20:08.58,0:20:10.87,Default,,0,0,0,,Шынымды айтсам, жеке әндерім жоқ.
Dialogue: 0,0:20:11.25,0:20:13.45,Default,,0,0,0,,Жалғыз болсаң, бір әнмен бітіретіндіктен бе?
Dialogue: 0,0:20:13.70,0:20:16.87,Default,,0,0,0,,Мен бір-ақ рет ғажайыппын ба?
Dialogue: 0,0:20:17.04,0:20:18.20,Default,,0,0,0,,Иә, дондон
Dialogue: 0,0:20:18.66,0:20:22.29,Default,,0,0,0,,Шынымды айтсам, бұл фото экономикалық қуатты меңзеп тұр ма?
Dialogue: 0,0:20:22.66,0:20:25.91,Default,,0,0,0,,Сіз ақшаның иісі бар дейсіз бе?
Dialogue: 0,0:20:25.95,0:20:30.66,Default,,0,0,0,,Ол ағып жатыр. Біреуді сүй, өзіңді сүй.
Dialogue: 0,0:20:30.95,0:20:33.29,Default,,0,0,0,,Сондықтан да біз ашық айта аламыз.
Dialogue: 0,0:20:33.83,0:20:37.41,Default,,0,0,0,,Сол махаббатты қазір айт
Dialogue: 0,0:20:37.95,0:20:44.16,Default,,0,0,0,,Күрсін, менімен шықшы.
Dialogue: 0,0:20:45.87,0:20:47.33,Default,,0,0,0,,Жақсы айтылған
Dialogue: 0,0:21:03.00,0:21:03.58,Default,,0,0,0,,Көп емес екен, иә?
Dialogue: 0,0:21:04.12,0:21:05.20,Default,,0,0,0,,Біз
Dialogue: 0,0:21:05.75,0:21:06.95,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:07.50,0:21:08.54,Default,,0,0,0,,Мен айттым
Dialogue: 0,0:21:09.37,0:21:11.04,Default,,0,0,0,,Ахх
Dialogue: 0,0:21:16.95,0:21:19.79,Default,,0,0,0,,Әй, сен не айттың?
Dialogue: 0,0:21:20.50,0:21:22.12,Default,,0,0,0,,Бәріне Мусик кінәлі
Dialogue: 0,0:21:22.62,0:21:24.37,Default,,0,0,0,,Мен оның лорд Бах екенін білемін.
Dialogue: 0,0:21:25.37,0:21:30.04,Default,,0,0,0,,Ал бұл қыздардың түнгі демалысына байланысты, иә?
Dialogue: 0,0:21:30.87,0:21:33.08,Default,,0,0,0,,Иә
Dialogue: 0,0:21:34.45,0:21:37.08,Default,,0,0,0,,Бүгін екеуің келгендеріңе қуаныштымын.
Dialogue: 0,0:21:37.33,0:21:40.62,Default,,0,0,0,,Е-е, мен бір нәрсені сергітіп тастадым.
Dialogue: 0,0:21:41.16,0:21:44.29,Default,,0,0,0,,Келесі кездескенімізде мен жау болар ма, одақтас па, білмеймін.
Dialogue: 0,0:21:45.37,0:21:46.50,Default,,0,0,0,,Біз қайтадан кездесуіміз керек.
Dialogue: 0,0:21:47.33,0:21:47.91,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:48.62,0:21:49.58,Default,,0,0,0,,Ол қатты жараланған еді...
Dialogue: 0,0:21:49.95,0:21:50.37,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:21:51.00,0:21:53.70,Default,,0,0,0,,Негізі менің басым айналып кетті.
Dialogue: 0,0:21:56.00,0:21:56.70,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:57.08,0:22:00.16,Default,,0,0,0,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет hehe
Dialogue: 0,0:22:00.91,0:22:02.83,Default,,0,0,0,,«Донэван мырза, сіз мүлде дұрыс айтасыз» де.
Dialogue: 0,0:22:05.08,0:22:06.62,Default,,0,0,0,,3 бума гиоза беріңізші
Dialogue: 0,0:22:07.04,0:22:08.45,Default,,0,0,0,,Сіз әлі тамақтанып жатырсыз ба?
Dialogue: 0,0:22:08.95,0:22:09.91,Default,,0,0,0,,Барлығы
Dialogue: 0,0:22:10.91,0:22:13.91,Default,,0,0,0,,Бүгін зәулім үйдің балалары сыртта қалды.
Dialogue: 0,0:22:14.37,0:22:16.87,Default,,0,0,0,,Көмек болмас, бұл қыздардың түні.
Dialogue: 0,0:22:17.20,0:22:19.41,Default,,0,0,0,,Жоқ, түсіндім.
Dialogue: 0,0:22:19.87,0:22:22.62,Default,,0,0,0,,Еркек болсын, әйел болсын, қыздардың түнімен айналысуға еш қатысы жоқ.
Dialogue: 0,0:22:22.83,0:22:23.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:23.66,0:22:26.87,Default,,0,0,0,,Өзіңізге жарасатын нәрсені киіңіз, дәмді тағам жеңіз
Dialogue: 0,0:22:27.16,0:22:32.62,Default,,0,0,0,,Шынайы сезімдеріңді айта алсаң, бұл қыздардың түні.
Dialogue: 0,0:22:37.54,0:22:39.83,Default,,0,0,0,,Ах фух
Dialogue: 0,0:22:42.45,0:22:45.70,Default,,0,0,0,,Шынымды айтсам, қыздардың түнгі демалысы ең жақсысы
Dialogue: 0,0:22:58.33,0:23:03.45,Default,,0,0,0,,Хош иісті гүл жел
Dialogue: 0,0:23:04.45,0:23:08.95,Default,,0,0,0,,Жүгіре бастаған сезімдер
Dialogue: 0,0:23:10.41,0:23:16.12,Default,,0,0,0,,Толқып тасып, махаббат үніне айналады
Dialogue: 0,0:23:16.37,0:23:23.66,Default,,0,0,0,,Тоқтамас күн жырлағандай
Dialogue: 0,0:23:35.91,0:23:40.54,Default,,0,0,0,,Махаббат тамшыларда тұрады
Dialogue: 0,0:23:40.75,0:23:46.62,Default,,0,0,0,,Ақырында жарқырайтын хризалидің сезімі
Dialogue: 0,0:23:46.95,0:23:52.54,Default,,0,0,0,,Айқын өзгеретін арман тәрізді көбелек
Dialogue: 0,0:23:52.79,0:24:00.83,Default,,0,0,0,,Қанатыңды жайып, қалықтағанда
Dialogue: 0,0:24:19.50,0:24:22.79,Default,,0,0,0,,Кеудемде бірдеңе шуылдап жатыр.
Dialogue: 0,0:24:22.83,0:24:25.87,Default,,0,0,0,,Қайта ауырады. Бұл сұмдық болашақтың бастамасы ма?
Dialogue: 0,0:24:26.16,0:24:29.70,Default,,0,0,0,,Бұл өткеннен қалған тыртық па? Ереже болса, жүрек анықталады.
Dialogue: 0,0:24:29.79,0:24:31.95,Default,,0,0,0,,Маған жебе немесе мылтық әкел.
Dialogue: 0,0:24:33.45,0:24:39.45,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory