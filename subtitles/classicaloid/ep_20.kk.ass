Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:23.66,0:00:24.25,Default,,0,0,0,,Барып, емтиханға дайындалу стратегияңды жаса
Dialogue: 0,0:02:01.00,0:02:01.62,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:02:05.20,0:02:07.37,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:02:10.75,0:02:12.87,Default,,0,0,0,,Уф уаааааааааааааааааааааааа
Dialogue: 0,0:02:12.91,0:02:15.08,Default,,0,0,0,,Дахахахаха Ахахахаха
Dialogue: 0,0:02:15.16,0:02:16.08,Default,,0,0,0,,Уф
Dialogue: 0,0:02:20.91,0:02:22.66,Default,,0,0,0,,Хи хи хи хи хи
Dialogue: 0,0:02:22.91,0:02:24.04,Default,,0,0,0,,Кишааааа
Dialogue: 0,0:02:24.29,0:02:26.00,Default,,0,0,0,,Ммм
Dialogue: 0,0:02:26.08,0:02:27.08,Default,,0,0,0,,Гоооооооо
Dialogue: 0,0:02:27.12,0:02:28.50,Default,,0,0,0,,Иә
Dialogue: 0,0:02:29.08,0:02:30.87,Default,,0,0,0,,Шах
Dialogue: 0,0:02:31.54,0:02:33.33,Default,,0,0,0,,Хохохохохохохо
Dialogue: 0,0:02:33.41,0:02:34.12,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:02:34.41,0:02:36.12,Default,,0,0,0,,Сен шынымен де тамаша ФБР агенті болдың.
Dialogue: 0,0:02:36.41,0:02:38.91,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:02:39.16,0:02:41.66,Default,,0,0,0,,Дахахахаха Ахахахха
Dialogue: 0,0:02:41.70,0:02:43.16,Default,,0,0,0,,-Аха хаха а -хмм
Dialogue: 0,0:02:43.45,0:02:46.83,Default,,0,0,0,,-Моцарт ооооо -Ахахаха
Dialogue: 0,0:02:46.95,0:02:49.87,Default,,0,0,0,,Ішім жарылып кетті Ішім жарылып кетті
Dialogue: 0,0:02:50.00,0:02:53.62,Default,,0,0,0,,Эй, бәрі жақсы көрінеді Ахахахахахахах
Dialogue: 0,0:02:53.70,0:02:58.62,Default,,0,0,0,,Солай ма? Мүмкін сіз шынымен ашуланған шығарсыз?
Dialogue: 0,0:02:59.00,0:03:02.50,Default,,0,0,0,,Әй, түсінсем де, енді қайталамаймын, солай ма?
Dialogue: 0,0:03:02.95,0:03:04.95,Default,,0,0,0,,Бұл жігіт таңнан бері осында.
Dialogue: 0,0:03:05.12,0:03:06.29,Default,,0,0,0,,Күн сайын күн сайын
Dialogue: 0,0:03:06.54,0:03:08.45,Default,,0,0,0,,Бұл рас, мұның бәрі бос сөз.
Dialogue: 0,0:03:08.70,0:03:09.91,Default,,0,0,0,,Қасқыр
Dialogue: 0,0:03:10.29,0:03:13.08,Default,,0,0,0,,Зұлымдық, ақырзаманның уақыты келді.
Dialogue: 0,0:03:13.37,0:03:14.83,Default,,0,0,0,,Гааааааа
Dialogue: 0,0:03:15.08,0:03:17.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:20.41,0:03:23.58,Default,,0,0,0,,Пуддахахаха менің ішім жыртылды
Dialogue: 0,0:03:23.83,0:03:27.37,Default,,0,0,0,,Ол бұзылады. Жоқ, мен де осіремін.
Dialogue: 0,0:03:27.41,0:03:30.75,Default,,0,0,0,,Аха ахахахаха ааа болмайды
Dialogue: 0,0:03:30.83,0:03:33.70,Default,,0,0,0,,Мен мұның жақсы болатынын ойламадым. Мен оған дайындалдым.
Dialogue: 0,0:03:33.79,0:03:36.91,Default,,0,0,0,,Барлығы үлкен жетістік, иә? Бұл қалай болды?
Dialogue: 0,0:03:36.95,0:03:39.12,Default,,0,0,0,,Сізде үлкен жоспар болды ма?
Dialogue: 0,0:03:39.37,0:03:42.70,Default,,0,0,0,,Хе-хэ-хэ, оны түсіндірудің өзі ыңғайсыз.
Dialogue: 0,0:03:43.04,0:03:46.04,Default,,0,0,0,,Себебі бұзық жоспар
Dialogue: 0,0:03:46.54,0:03:51.25,Default,,0,0,0,,Мұның бәрі менің ойымда.
Dialogue: 0,0:03:52.12,0:03:57.66,Default,,0,0,0,,Иә? иә? иә? Барлығы қайда кетті?
Dialogue: 0,0:04:00.95,0:04:01.41,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:08.12,0:04:11.54,Default,,0,0,0,,Ахахахахаха уххухухухуху
Dialogue: 0,0:04:17.33,0:04:20.20,Default,,0,0,0,,Қайырлы таң, Хусси!
Dialogue: 0,0:04:24.08,0:04:24.75,Default,,0,0,0,,Әй
Dialogue: 0,0:04:26.83,0:04:27.37,Default,,0,0,0,,Га
Dialogue: 0,0:04:29.33,0:04:32.25,Default,,0,0,0,,О, қайырлы таң, Бетховен мырза.
Dialogue: 0,0:04:32.50,0:04:35.66,Default,,0,0,0,,Қайырлы таң Утанае-кун, таң тамаша.
Dialogue: 0,0:04:36.08,0:04:39.41,Default,,0,0,0,,Иә, мен шынымен неге деп ойлаймын.
Dialogue: 0,0:04:39.54,0:04:42.62,Default,,0,0,0,,-Аа, хмм -Жүр, неге екен деп ойлаймын.
Dialogue: 0,0:04:43.12,0:04:46.66,Default,,0,0,0,,Мүмкін адамдар нағыз бақытқа жеткенде
Dialogue: 0,0:04:47.20,0:04:51.41,Default,,0,0,0,,Мүмкін мен өзімді осы бейбіт өмірде ең бақытты сезінетін шығармын.
Dialogue: 0,0:04:51.83,0:04:54.75,Default,,0,0,0,,Күткендей, қандай тамаша теория.
Dialogue: 0,0:04:55.37,0:04:57.75,Default,,0,0,0,,-Ойланып қарасам, әлі де жалдау ақысын төлеу керек, солай ма? -Хмм?
Dialogue: 0,0:04:58.16,0:04:59.66,Default,,0,0,0,,Кешіріңіз, котенка
Dialogue: 0,0:05:00.62,0:05:02.41,Default,,0,0,0,,- Иә? жалға беру? - Гуруру
Dialogue: 0,0:05:03.12,0:05:06.00,Default,,0,0,0,,Бұл сұмдық жүйе қандай?
Dialogue: 0,0:05:06.37,0:05:08.12,Default,,0,0,0,,Не деген үлкен жүрек.
Dialogue: 0,0:05:08.33,0:05:10.50,Default,,0,0,0,,Ах, адамдар керемет.
Dialogue: 0,0:05:11.04,0:05:13.25,Default,,0,0,0,,Адамдар қиыншылықта бір-біріне көмектеседі.
Dialogue: 0,0:05:13.66,0:05:17.12,Default,,0,0,0,,Мен адамдарды жақсы көремін ахахаха
Dialogue: 0,0:05:17.20,0:05:18.50,Default,,0,0,0,,Эхехехе
Dialogue: 0,0:05:18.70,0:05:19.29,Default,,0,0,0,,Грул
Dialogue: 0,0:05:19.37,0:05:21.62,Default,,0,0,0,,Ммммм
Dialogue: 0,0:05:21.70,0:05:25.45,Default,,0,0,0,,Қайырлы таң Баршаңызға қайырлы таң
Dialogue: 0,0:05:25.50,0:05:27.16,Default,,0,0,0,,Ахаха керемет
Dialogue: 0,0:05:27.33,0:05:30.70,Default,,0,0,0,,Бұл төртке арналған ғажайып таң
Dialogue: 0,0:05:30.79,0:05:31.75,Default,,0,0,0,,-Даааааа -Гаруру
Dialogue: 0,0:05:31.83,0:05:32.83,Default,,0,0,0,,Төрт
Dialogue: 0,0:05:32.95,0:05:33.91,Default,,0,0,0,,-Даааааа -Гау
Dialogue: 0,0:05:34.00,0:05:35.04,Default,,0,0,0,,Төрт
Dialogue: 0,0:05:35.12,0:05:36.25,Default,,0,0,0,,-Даааааа -Гаруру
Dialogue: 0,0:05:36.41,0:05:38.87,Default,,0,0,0,,Ахххххххххх
Dialogue: 0,0:05:38.91,0:05:40.54,Default,,0,0,0,,...
Dialogue: 0,0:05:40.91,0:05:43.41,Default,,0,0,0,,Егер бұл жоспар
Dialogue: 0,0:05:43.79,0:05:46.50,Default,,0,0,0,,Менің ойымша, сізде керемет күн болады.
Dialogue: 0,0:05:47.16,0:05:47.75,Default,,0,0,0,,О… Ах…
Dialogue: 0,0:05:48.12,0:05:50.08,Default,,0,0,0,,Мүлдем жақсы емес.
Dialogue: 0,0:05:50.29,0:05:52.29,Default,,0,0,0,,Мені жолбарыс жеді
Dialogue: 0,0:05:52.41,0:05:55.83,Default,,0,0,0,,Бұл мүмкін емес, өйткені бұл үйде тор жоқ.
Dialogue: 0,0:05:55.95,0:05:56.79,Default,,0,0,0,,Жолбарыстар да жоқ.
Dialogue: 0,0:05:57.00,0:05:57.54,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:57.75,0:05:59.04,Default,,0,0,0,,Бұл емес, солай емес пе?
Dialogue: 0,0:05:59.25,0:06:01.45,Default,,0,0,0,,Бір жолбарыс шамамен 5 миллион иен
Dialogue: 0,0:06:01.75,0:06:03.54,Default,,0,0,0,,Жарайсыңдар, балалар, жұмысқа кірісейік.
Dialogue: 0,0:06:03.62,0:06:04.62,Default,,0,0,0,,Луға келсек?
Dialogue: 0,0:06:04.75,0:06:07.54,Default,,0,0,0,,Сіз менің кінәм сияқты бірдеңе айттыңыз.
Dialogue: 0,0:06:07.66,0:06:09.50,Default,,0,0,0,,Жалғыз сен кінәлісің
Dialogue: 0,0:06:09.79,0:06:12.50,Default,,0,0,0,,Шынында да ахахахаха ахахаха
Dialogue: 0,0:06:12.54,0:06:13.83,Default,,0,0,0,,-Ахаха, солай ма? -Ахахаха
Dialogue: 0,0:06:13.95,0:06:16.12,Default,,0,0,0,,-Мен таңертеңнен бері ақымақ істермен айналыстым -Хи аха хихахаха
Dialogue: 0,0:06:16.33,0:06:18.91,Default,,0,0,0,,Ішім жарылып, ысылып қаламын.
Dialogue: 0,0:06:19.12,0:06:21.08,Default,,0,0,0,,-Бұл бұрын не туралы болды? -Уху
Dialogue: 0,0:06:21.29,0:06:21.66,Default,,0,0,0,,Ууу
Dialogue: 0,0:06:21.70,0:06:23.83,Default,,0,0,0,,-Күлкілі болған кезде неге лүпілдейсің? -Уу хаха
Dialogue: 0,0:06:24.08,0:06:25.95,Default,,0,0,0,,- Өкінбейсің бе? - Фу хахафу
Dialogue: 0,0:06:26.04,0:06:28.79,Default,,0,0,0,,Хмм, рефлексия? Рефлексия дегеніміз не?
Dialogue: 0,0:06:29.08,0:06:30.20,Default,,0,0,0,,-Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:06:30.37,0:06:31.62,Default,,0,0,0,,-Уууууу -нууууу
Dialogue: 0,0:06:31.70,0:06:32.25,Default,,0,0,0,,Моту
Dialogue: 0,0:06:32.75,0:06:33.33,Default,,0,0,0,,Хмм?
Dialogue: 0,0:06:33.91,0:06:37.45,Default,,0,0,0,,Бұдан былай мұндай еркелікке тыйым салынады, жарай ма?
Dialogue: 0,0:06:37.54,0:06:39.87,Default,,0,0,0,,Иә? Бұл қызықсыз, солай емес пе?
Dialogue: 0,0:06:39.91,0:06:41.62,Default,,0,0,0,,Әйтпесе, күрішті өткізіп жіберуге тура келеді.
Dialogue: 0,0:06:41.70,0:06:45.29,Default,,0,0,0,,Эх, ахах, тағы бір әзіл.
Dialogue: 0,0:06:45.33,0:06:45.79,Default,,0,0,0,,Шынайы
Dialogue: 0,0:06:45.91,0:06:46.37,Default,,0,0,0,,Га
Dialogue: 0,0:06:47.29,0:06:50.12,Default,,0,0,0,,Motu Бұл барлығын шынымен мазалайды.
Dialogue: 0,0:06:53.12,0:06:57.12,Default,,0,0,0,,Ах ха ха? Хаа
Dialogue: 0,0:06:57.45,0:07:00.75,Default,,0,0,0,,Түсіндім, түсінемін, бұдан былай
Dialogue: 0,0:07:00.79,0:07:03.25,Default,,0,0,0,,Мен мұндай еркеліктен аулақ болуға тырысамын.
Dialogue: 0,0:07:03.70,0:07:06.41,Default,,0,0,0,,Жоқ, ұстап тұрудың пайдасы жоқ.
Dialogue: 0,0:07:06.70,0:07:08.62,Default,,0,0,0,,Шамамен 3 күнде бір рет
Dialogue: 0,0:07:08.66,0:07:09.70,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:07:09.79,0:07:11.00,Default,,0,0,0,,Ең нашар: екі аптада бір рет...
Dialogue: 0,0:07:11.04,0:07:11.79,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:07:12.58,0:07:15.79,Default,,0,0,0,,-Бұл уәде. Бұзып алсаң, мен тамақты өткізіп жіберемін. -А
Dialogue: 0,0:07:16.20,0:07:16.66,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:07:17.12,0:07:18.12,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:07:18.37,0:07:19.12,Default,,0,0,0,,Маған осылай аталған «толқындарды» жібергің келе ме?
Dialogue: 0,0:07:19.20,0:07:19.79,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:07:21.12,0:07:22.12,Default,,0,0,0,,-мм -мм
Dialogue: 0,0:07:23.00,0:07:24.54,Default,,0,0,0,,Жауап беру Жауап беру
Dialogue: 0,0:07:25.45,0:07:26.79,Default,,0,0,0,,Мазалағаным үшін кешіріңіз
Dialogue: 0,0:07:27.58,0:07:30.33,Default,,0,0,0,,А, окономияки? Хехе, сен олай жасамайсың.
Dialogue: 0,0:07:30.58,0:07:32.04,Default,,0,0,0,,Сосуке де көмектесті.
Dialogue: 0,0:07:32.33,0:07:35.62,Default,,0,0,0,,Эй, сен не істеп жатырсың, Моту-сан?
Dialogue: 0,0:07:36.75,0:07:41.12,Default,,0,0,0,,А, бұл Сосуке-кун ба? Қайырлы кеш.
Dialogue: 0,0:07:41.41,0:07:41.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:42.37,0:07:45.45,Default,,0,0,0,,Мен қайта тудым, Канчо.
Dialogue: 0,0:07:45.79,0:07:48.87,Default,,0,0,0,,Тізе Каккун Еркеліктердің қандай тұзақтары бар?
Dialogue: 0,0:07:49.45,0:07:52.41,Default,,0,0,0,,Мен оны жүрегімнің тереңіне мөрлей алдым.
Dialogue: 0,0:07:53.16,0:07:53.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:54.62,0:07:57.16,Default,,0,0,0,,Бұдан былай мен ғажайып адамдық тәрбие беремін.
Dialogue: 0,0:07:57.50,0:07:59.75,Default,,0,0,0,,Құрметті ересек адам ретінде өмір сүріңіз.
Dialogue: 0,0:08:00.33,0:08:02.50,Default,,0,0,0,,Күнделікті тамақ жеткілікті екеніне көз жеткізіңіз.
Dialogue: 0,0:08:03.08,0:08:04.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:06.08,0:08:07.91,Default,,0,0,0,,-Жарайды, орамжапырақ -Са, тез.
Dialogue: 0,0:08:08.12,0:08:09.91,Default,,0,0,0,,Кеттік! Барайық!
Dialogue: 0,0:08:10.62,0:08:13.91,Default,,0,0,0,,-Тәтті ме?- Мынау ма? -Окономиякидегі Канадэ менмін.
Dialogue: 0,0:08:14.75,0:08:15.33,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:08:15.45,0:08:16.33,Default,,0,0,0,,Осылай жасайық
Dialogue: 0,0:08:17.00,0:08:17.41,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:17.75,0:08:19.00,Default,,0,0,0,,Хмм
Dialogue: 0,0:08:19.83,0:08:20.29,Default,,0,0,0,,Олар – аң, ал біз – аңшылар!
Dialogue: 0,0:08:20.95,0:08:22.04,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:22.16,0:08:23.04,Default,,0,0,0,,А, солай ма?
Dialogue: 0,0:08:23.20,0:08:25.54,Default,,0,0,0,,Кууууууууууууу
Dialogue: 0,0:08:25.66,0:08:26.95,Default,,0,0,0,,-Уаааааааааааааааааааааааааааааа
Dialogue: 0,0:08:27.20,0:08:30.83,Default,,0,0,0,,Жоқ, бұл тым қызықсыз, мені жынды етеді.
Dialogue: 0,0:08:30.91,0:08:31.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:31.29,0:08:33.83,Default,,0,0,0,,Неліктен, неге бәрі қалыпты дайындалуда?
Dialogue: 0,0:08:34.08,0:08:35.70,Default,,0,0,0,,Жоқ, қазір окономияки кешін өткізейік.
Dialogue: 0,0:08:35.75,0:08:37.66,Default,,0,0,0,,Маған окономияки кешін өткізіп жатқаныңызды айтыңыз.
Dialogue: 0,0:08:37.70,0:08:40.08,Default,,0,0,0,,Окономиякиді сол күйінде грильдегіңіз келе ме? әдетте
Dialogue: 0,0:08:40.66,0:08:42.16,Default,,0,0,0,,Неге ашуланғаныңызды білмеймін.
Dialogue: 0,0:08:42.33,0:08:45.00,Default,,0,0,0,,Қызықты етудің тағы да жолдары бар.
Dialogue: 0,0:08:45.58,0:08:49.54,Default,,0,0,0,,Мысалы, мынандай шпательді қолданыңыз, жасыл балдырларды қолданыңыз, соусты қолданыңыз
Dialogue: 0,0:08:49.75,0:08:53.37,Default,,0,0,0,,Окономияки осылай жасалуы керек. Қанекей мынаны істейік.
Dialogue: 0,0:08:53.54,0:08:56.70,Default,,0,0,0,,Көңілді тойлайық бәріміз.
Dialogue: 0,0:08:56.79,0:08:58.70,Default,,0,0,0,,Біз бәріміз жиналдық, солай ма?
Dialogue: 0,0:09:02.16,0:09:05.70,Default,,0,0,0,,Бұл мүлдем өтпейді. Бұл өтірік.
Dialogue: 0,0:09:06.16,0:09:09.79,Default,,0,0,0,,Бұл жеткілікті. Менің ойымша, сіз уәдеңізді ұмытқан жоқсыз.
Dialogue: 0,0:09:10.12,0:09:10.45,Default,,0,0,0,,болып табылады
Dialogue: 0,0:09:10.50,0:09:13.25,Default,,0,0,0,,-Келесіде бірдеңе істесем, күрішті өткізіп жіберемін.-Ха
Dialogue: 0,0:09:13.58,0:09:14.00,Default,,0,0,0,,Жарайды. Бұл отбасыңызға ма?
Dialogue: 0,0:09:16.04,0:09:20.66,Default,,0,0,0,,Әй, бұл менің кінәм бе? Мен қателестім бе?
Dialogue: 0,0:09:21.87,0:09:24.87,Default,,0,0,0,,Эй, сен қалай ойлайсың? әже
Dialogue: 0,0:09:25.83,0:09:27.95,Default,,0,0,0,,Мен сізді мүлде танымаймын, бірақ айтыңызшы.
Dialogue: 0,0:09:28.87,0:09:31.62,Default,,0,0,0,,Менің ойымша, көбірек көңілді болғаны дұрыс.
Dialogue: 0,0:09:32.29,0:09:35.75,Default,,0,0,0,,Не? Дұрыс, көңілді болғаны дұрыс.
Dialogue: 0,0:09:36.20,0:09:37.75,Default,,0,0,0,,Окономияки жасайсыз деп айтыңыз.
Dialogue: 0,0:09:37.83,0:09:40.83,Default,,0,0,0,,Оны сол күйінде пісірудің қызық ештеңесі жоқ, солай ма?
Dialogue: 0,0:09:40.91,0:09:44.08,Default,,0,0,0,,Бірақ сен Утанаға бұдан былай еркелік жасамаймын деп уәде бердің бе?
Dialogue: 0,0:09:44.70,0:09:48.79,Default,,0,0,0,,Хмм, дұрыс. Мен де уәдені бұзғанды ​​ұнатпаймын.
Dialogue: 0,0:09:49.37,0:09:54.25,Default,,0,0,0,,Мұндай нәрсе қызық емес.
Dialogue: 0,0:09:55.12,0:09:58.25,Default,,0,0,0,,Жарайды, мен аздап тырысамын.
Dialogue: 0,0:09:58.95,0:10:01.12,Default,,0,0,0,,Бұзақылыққа тыйым салудың ең нашар жағдайы
Dialogue: 0,0:10:01.20,0:10:03.12,Default,,0,0,0,,Мен әйтеуір ләззат алуға тырысамын.
Dialogue: 0,0:10:04.29,0:10:07.37,Default,,0,0,0,,Көріскенше, әже, мен сізді мүлде танымаймын.
Dialogue: 0,0:10:07.79,0:10:08.41,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:10.75,0:10:14.66,Default,,0,0,0,,- Сіз айтып отырған жақтан, иә, эй, эй -фуфуфуфуфу
Dialogue: 0,0:10:14.79,0:10:17.04,Default,,0,0,0,,- Шу мырза, маған еркелік ойнаңызшы - Фуфуфуфуфу
Dialogue: 0,0:10:17.08,0:10:19.58,Default,,0,0,0,,-Ол нені айтып тұрсың? тұзақ? -Хехехехе
Dialogue: 0,0:10:19.79,0:10:23.79,Default,,0,0,0,,Сіз жасырынсыз. Сіз мені итеретін едіңіз. Бұл жағдайда кез келген адам болуы мүмкін.
Dialogue: 0,0:10:23.95,0:10:26.04,Default,,0,0,0,,Ой, жоқ, жоқ, жоқ, сен не істеп жатырсың?
Dialogue: 0,0:10:26.16,0:10:28.45,Default,,0,0,0,,Сіз оны қазір басып көрдіңіз бе? Мен қорқамын, қорқамын
Dialogue: 0,0:10:28.62,0:10:30.66,Default,,0,0,0,,Сіз мұны енді қайталамауға уәде бердіңіз.
Dialogue: 0,0:10:30.83,0:10:32.62,Default,,0,0,0,,Күрішсіз жүруге тура келетін шығар.
Dialogue: 0,0:10:33.91,0:10:38.25,Default,,0,0,0,,Бірақ бұл күлкілі, сондықтан жақсы емес.
Dialogue: 0,0:10:38.37,0:10:41.29,Default,,0,0,0,,Шыда, итерме, итерме
Dialogue: 0,0:10:41.45,0:10:43.04,Default,,0,0,0,,Итерме Итерме Итерме
Dialogue: 0,0:10:43.20,0:10:44.25,Default,,0,0,0,,Итерме Итерме Итерме
Dialogue: 0,0:10:44.37,0:10:47.29,Default,,0,0,0,,Оны итермеңіз Итермеңіз Моту
Dialogue: 0,0:10:47.41,0:10:52.41,Default,,0,0,0,,Гуу хиии ах де бірақ бірақ о
Dialogue: 0,0:10:52.62,0:10:52.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:53.04,0:10:54.87,Default,,0,0,0,,-Иә бум -Гвавававава
Dialogue: 0,0:10:55.12,0:10:56.00,Default,,0,0,0,,Уау бубу бубу бубу
Dialogue: 0,0:10:56.16,0:11:00.62,Default,,0,0,0,,-Бувава Бува -Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:11:00.87,0:11:01.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:10.66,0:11:13.70,Default,,0,0,0,,Моту? Сізге бұлай күйзелудің қажеті жоқ
Dialogue: 0,0:11:14.25,0:11:15.66,Default,,0,0,0,,Окономияки жейміз бе?
Dialogue: 0,0:11:16.16,0:11:18.25,Default,,0,0,0,,Барлығы онша ашулы емес.
Dialogue: 0,0:11:18.66,0:11:19.75,Default,,0,0,0,,Ағзаға улы
Dialogue: 0,0:11:20.08,0:11:20.66,Default,,0,0,0,,"Бүгін түнде біз батырды құрметтейміз!!"
Dialogue: 0,0:11:20.91,0:11:23.91,Default,,0,0,0,,Тез кел, Қасқыр, менің шедеврім суып барады.
Dialogue: 0,0:11:24.16,0:11:27.41,Default,,0,0,0,,Мен үшін бәріңіз уайымдауыңыз керек емес пе?
Dialogue: 0,0:11:27.83,0:11:28.29,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:11:29.75,0:11:32.33,Default,,0,0,0,,Шуе мырза да көңілімді көтеруді айтты.
Dialogue: 0,0:11:32.54,0:11:33.45,Default,,0,0,0,,Мен оны мүлдем жек көремін.
Dialogue: 0,0:11:33.83,0:11:35.79,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:11:36.58,0:11:37.33,Default,,0,0,0,,Жаяу жүру
Dialogue: 0,0:11:38.00,0:11:38.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:39.45,0:11:43.83,Default,,0,0,0,,Қызықсыз, бәрімен бірге болу қызық емес.
Dialogue: 0,0:11:47.29,0:11:48.70,Default,,0,0,0,,Не? Кері гаг?
Dialogue: 0,0:11:49.08,0:11:50.87,Default,,0,0,0,,-Ол кім? -Ол сондай.
Dialogue: 0,0:11:50.95,0:11:51.87,Default,,0,0,0,,Мен сені кешіремін
Dialogue: 0,0:11:51.91,0:11:53.45,Default,,0,0,0,,Менің шедеврім сізді қалай қызықтырмады?
Dialogue: 0,0:11:55.45,0:11:55.91,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:12:05.91,0:12:08.66,Default,,0,0,0,,Бірге дүкен аралағыңыз келе ме?
Dialogue: 0,0:12:10.45,0:12:10.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:14.58,0:12:16.95,Default,,0,0,0,,Қош келдіңіз, кешігіп қалдыңыз.
Dialogue: 0,0:12:18.58,0:12:20.79,Default,,0,0,0,,Моту? Күріш а
Dialogue: 0,0:12:21.41,0:12:23.04,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:12:23.83,0:12:27.29,Default,,0,0,0,,Эй моту ах хаа
Dialogue: 0,0:12:34.75,0:12:36.66,Default,,0,0,0,,Моту-сан, тағы да кеш.
Dialogue: 0,0:12:36.70,0:12:37.12,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:12:37.50,0:12:38.87,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:39.12,0:12:41.45,Default,,0,0,0,,Менің ойымша, бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:12:42.00,0:12:43.37,Default,,0,0,0,,Ол бастапқыда солай емес пе?
Dialogue: 0,0:12:43.75,0:12:46.45,Default,,0,0,0,,Көңіл-күйіңіз жоқ па, әлде өз қарқыныңызбен жүргіңіз келе ме?
Dialogue: 0,0:12:46.70,0:12:49.83,Default,,0,0,0,,Жоқ, бұл өте күдікті деп ойлаймын.
Dialogue: 0,0:12:50.20,0:12:52.16,Default,,0,0,0,,Қайда баратыныңызды айтпау Кеш қайту
Dialogue: 0,0:12:52.37,0:12:55.41,Default,,0,0,0,,Менің көзімнен қашқаны анық, яғни
Dialogue: 0,0:12:55.54,0:12:57.45,Default,,0,0,0,,Бұл қылмыс жасауды білдіреді.
Dialogue: 0,0:12:57.87,0:12:58.91,Default,,0,0,0,,қылмыс па?
Dialogue: 0,0:12:59.08,0:13:01.00,Default,,0,0,0,,Шу мырза тағы да асыра айтып отыр.
Dialogue: 0,0:13:01.33,0:13:03.75,Default,,0,0,0,,Жоқ, бұл шайтанның мүмкіндігі бар.
Dialogue: 0,0:13:04.37,0:13:06.37,Default,,0,0,0,,Гамагон оқиғасын ұмыттыңыз ба?
Dialogue: 0,0:13:06.50,0:13:06.79,Default,,0,0,0,,Га
Dialogue: 0,0:13:07.29,0:13:11.66,Default,,0,0,0,,Гамагон? Әй, бірдеңе болды, жұмбақ ояну
Dialogue: 0,0:13:12.33,0:13:15.20,Default,,0,0,0,,Бұл әлі де көптеген адамдарға көптеген қиындықтар туғызатынына сенімдімін.
Dialogue: 0,0:13:15.29,0:13:15.66,Default,,0,0,0,,Уф
Dialogue: 0,0:13:16.37,0:13:16.79,Default,,0,0,0,,Әй
Dialogue: 0,0:13:17.37,0:13:18.37,Default,,0,0,0,,Бұл қандай бет?
Dialogue: 0,0:13:19.58,0:13:20.00,Default,,0,0,0,,Ах
Dialogue: 0,0:13:20.91,0:13:21.58,Default,,0,0,0,,Моту
Dialogue: 0,0:13:22.00,0:13:22.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:23.04,0:13:24.95,Default,,0,0,0,,Осы сағатқа дейін не істедің?
Dialogue: 0,0:13:25.41,0:13:28.83,Default,,0,0,0,,Хмм, серуендеу?
Dialogue: 0,0:13:29.04,0:13:31.54,Default,,0,0,0,,ше? Эй, тамақ ше?
Dialogue: 0,0:13:31.70,0:13:32.50,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:13:34.37,0:13:37.20,Default,,0,0,0,,А, бұл тым күдікті. Өйткені бұл қылмыс.
Dialogue: 0,0:13:37.54,0:13:39.04,Default,,0,0,0,,Сондықтан олай емес.
Dialogue: 0,0:13:40.66,0:13:43.87,Default,,0,0,0,,Хун һүн һә һә һә һә
Dialogue: 0,0:13:44.20,0:13:47.37,Default,,0,0,0,,Хмф хехехехе
Dialogue: 0,0:13:47.75,0:13:50.50,Default,,0,0,0,,Хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе
Dialogue: 0,0:13:51.12,0:13:52.66,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:13:52.70,0:13:53.04,Default,,0,0,0,,(Бір күні сені қолға түсіреміз)
Dialogue: 0,0:13:53.50,0:13:54.20,Default,,0,0,0,,Котенка
Dialogue: 0,0:13:54.66,0:13:57.83,Default,,0,0,0,,Оны астыртын ұйымның бастығы сатып алып жатқаны рас па?
Dialogue: 0,0:13:57.91,0:13:58.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:58.58,0:14:01.91,Default,,0,0,0,,Кішкентай қыз, Қасқыр нағыз Гамагон ретінде қайта жанданды.
Dialogue: 0,0:14:02.29,0:14:04.00,Default,,0,0,0,,Осы қаладағы барлық жануарлар
Dialogue: 0,0:14:04.04,0:14:06.37,Default,,0,0,0,,Бірін-бірі жамандап жүгіріп жүргендері рас па?
Dialogue: 0,0:14:06.45,0:14:07.75,Default,,0,0,0,,Ертегіде не болып жатыр?
Dialogue: 0,0:14:07.95,0:14:09.62,Default,,0,0,0,,Бұл қорқынышты, себебі бұл мүмкін.
Dialogue: 0,0:14:09.70,0:14:10.54,Default,,0,0,0,,Шу мырза?
Dialogue: 0,0:14:10.87,0:14:11.41,Default,,0,0,0,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:14:11.87,0:14:12.50,Default,,0,0,0,,Барайық
Dialogue: 0,0:14:14.70,0:14:16.45,Default,,0,0,0,,Қараңызшы, бұл күдікті.
Dialogue: 0,0:14:17.25,0:14:18.29,Default,,0,0,0,,Жақсы
Dialogue: 0,0:14:18.45,0:14:20.08,Default,,0,0,0,,-Даааааааааааааааааааааааааааааааааааа -Күдікті?
Dialogue: 0,0:14:20.45,0:14:22.20,Default,,0,0,0,,Қараңдаршы, бұл белгінің бір түрі.
Dialogue: 0,0:14:22.83,0:14:24.41,Default,,0,0,0,,Сіз тек ақ жолды кесіп өтіп жатқан жоқсыз ба?
Dialogue: 0,0:14:24.79,0:14:26.87,Default,,0,0,0,,-Ара -Ахаха Ахахахаха
Dialogue: 0,0:14:33.41,0:14:36.00,Default,,0,0,0,,Бұл жеткілікті емес пе? Мұның мүлдем мағынасы жоқ.
Dialogue: 0,0:14:36.37,0:14:37.12,Default,,0,0,0,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:14:37.33,0:14:40.33,Default,,0,0,0,,Ақымақ, жер астындағы адамдармен қашан байланысқа түсесің?
Dialogue: 0,0:14:40.66,0:14:43.58,Default,,0,0,0,,Сондықтан мен олай ойламаймын.
Dialogue: 0,0:14:43.87,0:14:44.50,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:14:44.54,0:14:45.66,Default,,0,0,0,,Иә
Dialogue: 0,0:14:45.87,0:14:47.33,Default,,0,0,0,,-ihihihihi -sousuke
Dialogue: 0,0:14:47.41,0:14:48.16,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:14:48.29,0:14:50.25,Default,,0,0,0,,Хаха, бұл бананның қабығы.
Dialogue: 0,0:14:50.45,0:14:53.70,Default,,0,0,0,,Банан қабығы? Бұл ескі гаг сияқты
Dialogue: 0,0:14:53.79,0:14:55.45,Default,,0,0,0,,- Жоқ? Қазірдің өзінде - ха!
Dialogue: 0,0:14:55.70,0:14:56.50,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:15:00.95,0:15:02.83,Default,,0,0,0,,Ха, бұл қауіпті.
Dialogue: 0,0:15:02.87,0:15:03.41,Default,,0,0,0,,Уф
Dialogue: 0,0:15:04.25,0:15:05.87,Default,,0,0,0,,Ятоны таптың ба?
Dialogue: 0,0:15:06.25,0:15:09.37,Default,,0,0,0,,Оның іске қосылғанына күмән жоқ.
Dialogue: 0,0:15:09.58,0:15:10.70,Default,,0,0,0,,- Моту дүрбелеңі - Иә
Dialogue: 0,0:15:10.83,0:15:11.79,Default,,0,0,0,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:15:12.12,0:15:15.20,Default,,0,0,0,,Motu Panic Бұл не?
Dialogue: 0,0:15:15.50,0:15:17.29,Default,,0,0,0,,Түсіндірейін
Dialogue: 0,0:15:17.50,0:15:18.54,Default,,0,0,0,,Пэд-кун, сен білесің бе?
Dialogue: 0,0:15:19.00,0:15:22.20,Default,,0,0,0,,Motu Panic Бұл қорқынышты түс, оның алдын алу мүмкін емес
Dialogue: 0,0:15:22.87,0:15:25.54,Default,,0,0,0,,Адам ерекше ештеңе істемейді, бірақ
Dialogue: 0,0:15:25.75,0:15:28.41,Default,,0,0,0,,Күшті кедергі жасаушы аурасының арқасында ол
Dialogue: 0,0:15:28.58,0:15:30.62,Default,,0,0,0,,Адамдарды өздігінен қоршау
Dialogue: 0,0:15:30.66,0:15:32.58,Default,,0,0,0,,Бірінен соң бірі ұсталады.
Dialogue: 0,0:15:32.83,0:15:36.04,Default,,0,0,0,,Оның құдіреті сонша, ол үлкен кісіден ұрысуды ойламайды.
Dialogue: 0,0:15:36.16,0:15:38.66,Default,,0,0,0,,10 боқ баланың жамандығы
Dialogue: 0,0:15:39.12,0:15:41.45,Default,,0,0,0,,Қалдық? Бұл өте жақсы
Dialogue: 0,0:15:41.66,0:15:44.62,Default,,0,0,0,,Көбінесе ешқандай жарақат жоқ хехехехехе
Dialogue: 0,0:15:44.70,0:15:47.16,Default,,0,0,0,,Иә? Сонымен, сіз мұны қайдан білесіз?
Dialogue: 0,0:15:47.83,0:15:48.95,Default,,0,0,0,,Неге сонша бақытты көрінесің?
Dialogue: 0,0:15:49.08,0:15:51.66,Default,,0,0,0,,Куку, өзіңді күт, Сосуке.
Dialogue: 0,0:15:51.75,0:15:54.62,Default,,0,0,0,,А? Ааааааааааааааааааааа
Dialogue: 0,0:15:54.70,0:15:56.33,Default,,0,0,0,,Ақымақ болма, ақымақ.
Dialogue: 0,0:15:56.37,0:15:56.62,Default,,0,0,0,,Хун
Dialogue: 0,0:15:56.70,0:15:57.25,Default,,0,0,0,,-Ах-Ах
Dialogue: 0,0:15:57.75,0:15:59.20,Default,,0,0,0,,Бос сөз айтпа
Dialogue: 0,0:15:59.41,0:16:01.45,Default,,0,0,0,,Спонтанды дүрбелең?
Dialogue: 0,0:16:01.75,0:16:04.20,Default,,0,0,0,,Мангадағы осындай оқиға шындыққа айналады
Dialogue: 0,0:16:04.70,0:16:06.41,Default,,0,0,0,,Міне болды
Dialogue: 0,0:16:07.37,0:16:09.37,Default,,0,0,0,,U Senpaai
Dialogue: 0,0:16:10.66,0:16:11.29,Default,,0,0,0,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:16:12.29,0:16:15.41,Default,,0,0,0,,Уаааааааааааааааааааааа
Dialogue: 0,0:16:15.75,0:16:16.70,Default,,0,0,0,,Хм. Хахахаха
Dialogue: 0,0:16:16.83,0:16:17.95,Default,,0,0,0,,Келесі мақсатым —
Dialogue: 0,0:16:18.00,0:16:19.29,Default,,0,0,0,,-Оиссууууууууууууууаааааааааааааа
Dialogue: 0,0:16:22.62,0:16:24.75,Default,,0,0,0,,Қанша өмірің болса да, жетпейді.
Dialogue: 0,0:16:25.25,0:16:26.70,Default,,0,0,0,,Қорқынышты моту дүрбелеңі
Dialogue: 0,0:16:27.20,0:16:27.70,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:16:28.37,0:16:29.12,Default,,0,0,0,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:16:29.79,0:16:31.25,Default,,0,0,0,,Барлығы
Dialogue: 0,0:16:32.25,0:16:35.83,Default,,0,0,0,,Қожайын, тұрып, оны көрмей қал.
Dialogue: 0,0:16:36.66,0:16:38.50,Default,,0,0,0,,Мен енді мұны істей алмаймын
Dialogue: 0,0:16:38.54,0:16:41.45,Default,,0,0,0,,Берілме, біз оны қуамыз.
Dialogue: 0,0:16:41.75,0:16:44.04,Default,,0,0,0,,Ал шындықты өз көзіңмен көр
Dialogue: 0,0:16:44.54,0:16:45.75,Default,,0,0,0,,Шу мырза
Dialogue: 0,0:16:46.41,0:16:48.29,Default,,0,0,0,,Енді барайық
Dialogue: 0,0:16:49.87,0:16:54.33,Default,,0,0,0,,Уау, Моцарт!
Dialogue: 0,0:16:54.95,0:16:57.66,Default,,0,0,0,,Шу Сааан
Dialogue: 0,0:16:58.70,0:17:03.33,Default,,0,0,0,,...
Dialogue: 0,0:17:06.16,0:17:08.20,Default,,0,0,0,,Мен берілмеймін
Dialogue: 0,0:17:09.25,0:17:10.66,Default,,0,0,0,,Неліктен бұлай болды?
Dialogue: 0,0:17:11.04,0:17:12.58,Default,,0,0,0,,Менің есімде жақсы емес.
Dialogue: 0,0:17:13.33,0:17:16.95,Default,,0,0,0,,Бірақ мен сені ешқашан қаламаймын
Dialogue: 0,0:18:22.54,0:18:23.29,Default,,0,0,0,,Сіз мұны жақсы білесіз.
Dialogue: 0,0:18:24.12,0:18:25.41,Default,,0,0,0,,Бұл бастауыш сынып оқушысы
Dialogue: 0,0:18:25.79,0:18:26.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:26.83,0:18:29.45,Default,,0,0,0,,Ол үлкен, солай емес пе?
Dialogue: 0,0:18:29.79,0:18:31.41,Default,,0,0,0,,Аа, мен үнемі осылай жалғызбын
Dialogue: 0,0:18:32.20,0:18:33.95,Default,,0,0,0,,Мен достарыммен ойнайтынмын.
Dialogue: 0,0:18:34.66,0:18:35.83,Default,,0,0,0,,Қазір жалғыз кел
Dialogue: 0,0:18:36.58,0:18:39.29,Default,,0,0,0,,Жалғыз ойнап, үйге жалғыз қайт
Dialogue: 0,0:18:41.41,0:18:44.62,Default,,0,0,0,,Мен оны көргенді жақсы көремін.
Dialogue: 0,0:18:48.79,0:18:55.12,Default,,0,0,0,,Моту Бірдеңе болды ма? Сіз жақында біздің...
Dialogue: 0,0:18:55.16,0:18:58.25,Default,,0,0,0,,Үйге баруым керек пе?
Dialogue: 0,0:19:00.00,0:19:01.00,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:19:01.75,0:19:04.79,Default,,0,0,0,,Иә
Dialogue: 0,0:19:08.87,0:19:10.00,Default,,0,0,0,,Содан кейін осында
Dialogue: 0,0:19:10.25,0:19:10.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:11.37,0:19:12.95,Default,,0,0,0,,Өйткені мен осы жолда келе жатырмын
Dialogue: 0,0:19:13.12,0:19:15.45,Default,,0,0,0,,Әй, қайда бара жатырсың?
Dialogue: 0,0:19:15.79,0:19:16.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:17.70,0:19:20.83,Default,,0,0,0,,Хмм.
Dialogue: 0,0:19:22.95,0:19:24.04,Default,,0,0,0,,Ғашықтар орны
Dialogue: 0,0:19:24.29,0:19:25.00,Default,,0,0,0,,Ғашық?
Dialogue: 0,0:19:25.50,0:19:28.62,Default,,0,0,0,,Иә, мен 17 жасар қызымды кездестіріп жатырмын.
Dialogue: 0,0:19:28.79,0:19:33.08,Default,,0,0,0,,Ju 17 жаста? Моту
Dialogue: 0,0:19:36.50,0:19:38.45,Default,,0,0,0,,Сіз қайтасыз, солай ма?
Dialogue: 0,0:19:39.20,0:19:39.75,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:19:41.79,0:19:42.95,Default,,0,0,0,,Сіз қайтып келесіз, солай ма?
Dialogue: 0,0:19:45.12,0:19:45.75,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:19:54.58,0:19:57.12,Default,,0,0,0,,Шынымды айтсам, 17 жаста болу қауіпті емес пе?
Dialogue: 0,0:19:57.25,0:19:59.25,Default,,0,0,0,,Эй, қылмыс Эй
Dialogue: 0,0:19:59.66,0:20:01.83,Default,,0,0,0,,Бұл рас, мен ойлағаннан да жақсы.
Dialogue: 0,0:20:01.87,0:20:05.00,Default,,0,0,0,,Орындалсын, құтыла алсын.
Dialogue: 0,0:20:06.16,0:20:11.41,Default,,0,0,0,,Эй Қасқыр, сен менің 17 жасар ғашығымды кездестірдің бе?
Dialogue: 0,0:20:13.25,0:20:14.87,Default,,0,0,0,,Ах ха
Dialogue: 0,0:21:18.25,0:21:23.37,Default,,0,0,0,,Мен жүзеге асырғым келетін қиялдың соншалықты, мен оны қолыммен ұстай алмаймын.
Dialogue: 0,0:21:23.75,0:21:28.37,Default,,0,0,0,,Оны жеңу үшін өз басыңызды пайдаланыңыз
Dialogue: 0,0:21:28.45,0:21:33.29,Default,,0,0,0,,Мен түсінбейтін адамдарды түсінбеймін
Dialogue: 0,0:21:33.58,0:21:39.25,Default,,0,0,0,,Құтырған толқындар да бізге бірдеңе береді.
Dialogue: 0,0:21:39.54,0:21:41.91,Default,,0,0,0,,Қорқатын ештеңе жоқ
Dialogue: 0,0:21:42.33,0:21:46.87,Default,,0,0,0,,Кішкентай кедергілерден де, болашақтан да қорықпа.
Dialogue: 0,0:21:47.25,0:21:49.58,Default,,0,0,0,,Болашағыңды қолыңда ұстайсың
Dialogue: 0,0:21:52.29,0:21:54.91,Default,,0,0,0,,Болашағыңды қолыңда ұстайсың
Dialogue: 0,0:22:08.04,0:22:11.79,Default,,0,0,0,,Болашағыңды қолыңда ұстайсың.
Dialogue: 0,0:22:19.66,0:22:20.58,Default,,0,0,0,,Иә
Dialogue: 0,0:22:24.16,0:22:25.29,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:22:54.87,0:23:00.08,Default,,0,0,0,,Мен жүзеге асырғым келетін қиялдың соншалықты, мен оны қолыммен ұстай алмаймын.
Dialogue: 0,0:23:00.29,0:23:05.20,Default,,0,0,0,,Кішкене тік болса, дәмдірек және жақсырақ болар еді.
Dialogue: 0,0:23:05.75,0:23:10.58,Default,,0,0,0,,Басқаларға қарағанда басқа жолмен жүру қызық.
Dialogue: 0,0:23:10.87,0:23:15.50,Default,,0,0,0,,Оны жеңу үшін тек басыңызды пайдаланыңыз.
Dialogue: 0,0:23:15.58,0:23:20.33,Default,,0,0,0,,Мен түсінбейтін адамдарды түсінбеймін
Dialogue: 0,0:23:20.62,0:23:26.25,Default,,0,0,0,,Құтырған толқындар да бізге бірдеңе береді.
Dialogue: 0,0:23:26.54,0:23:31.54,Default,,0,0,0,,Жанымызды өртеп, мұратымызға жақындайық
Dialogue: 0,0:23:31.75,0:23:36.33,Default,,0,0,0,,Алланың берген МУЗИК
Dialogue: 0,0:23:37.16,0:23:39.62,Default,,0,0,0,,Қорқатын ештеңе жоқ
Dialogue: 0,0:23:39.91,0:23:44.50,Default,,0,0,0,,Кішкентай кедергілерден де, болашақтан да қорықпа.
Dialogue: 0,0:23:44.58,0:23:47.29,Default,,0,0,0,,Болашағыңды қолыңда ұстайсың
Dialogue: 0,0:23:49.66,0:23:52.50,Default,,0,0,0,,Өз болашағыңды қолыңда ұстайсың.
Dialogue: 0,0:24:05.58,0:24:08.50,Default,,0,0,0,,Өз болашағыңды қолыңда ұстайсың
Dialogue: 0,0:24:15.08,0:24:17.33,Default,,0,0,0,,Әй, тірлігімнің төзгісіз жеңілдігі.
Dialogue: 0,0:24:17.50,0:24:19.54,Default,,0,0,0,,Мен кіммін? Мен неге мұндамын?
Dialogue: 0,0:24:19.66,0:24:21.29,Default,,0,0,0,,Ешкім сізді қызықтырмайды және алаңдатпайды
Dialogue: 0,0:24:21.54,0:24:23.87,Default,,0,0,0,,Еркін болғаны дұрыс, Авокадо.
Dialogue: 0,0:24:24.16,0:24:25.62,Default,,0,0,0,,Сен сияқтылар еркіндік демейді.
Dialogue: 0,0:24:25.87,0:24:28.12,Default,,0,0,0,,Сіз салат, гамбургер немесе суши бола аласыз.
Dialogue: 0,0:24:28.25,0:24:31.79,Default,,0,0,0,,Аллигатор алмұрт бейбақ, о, көзге көрінбейтін адамның жалғыздығы.
Dialogue: 0,0:24:33.29,0:24:39.29,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory