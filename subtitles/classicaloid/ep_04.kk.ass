Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.62,0:00:13.37,Default,,0,0,0,,Көп нәрсе анық емес
Dialogue: 0,0:00:13.91,0:00:16.83,Default,,0,0,0,,Белгілілік пен белгісіздіктің арасында жатқан шөл далада
Dialogue: 0,0:00:17.16,0:00:18.62,Default,,0,0,0,,Мен кетіп бара жатырмын
Dialogue: 0,0:00:19.08,0:00:21.16,Default,,0,0,0,,Адал және шын жүректен
Dialogue: 0,0:00:22.58,0:00:24.45,Default,,0,0,0,,Мен Франц Шубертпін
Dialogue: 0,0:00:25.04,0:00:28.25,Default,,0,0,0,,Бұл рас па? Және тағы бір нәрсе.
Dialogue: 0,0:00:28.45,0:00:30.25,Default,,0,0,0,,Іздеуді тоқтатпайтын жауап бар.
Dialogue: 0,0:00:30.75,0:00:31.70,Default,,0,0,0,,-А хахахаха -Ах
Dialogue: 0,0:00:36.25,0:00:38.58,Default,,0,0,0,,Мен қазір қайдамын?
Dialogue: 0,0:00:38.70,0:00:42.54,Default,,0,0,0,,Fungyaa Fungyaa Fungyaa
Dialogue: 0,0:00:42.66,0:00:44.45,Default,,0,0,0,,Фунгяааааааааааааааааааааааа
Dialogue: 0,0:00:44.66,0:00:46.95,Default,,0,0,0,,Тахахахахаха
Dialogue: 0,0:00:47.25,0:00:54.00,Default,,0,0,0,,Уау уау аааа аааа
Dialogue: 0,0:02:25.58,0:02:28.83,Default,,0,0,0,,Бұл дүние мен білетін дүниеден бөлек.
Dialogue: 0,0:02:30.16,0:02:32.83,Default,,0,0,0,,Біртүрлі, бей-берекет және көзді таң қалдыратын
Dialogue: 0,0:02:33.83,0:02:37.62,Default,,0,0,0,,Бұл қандай да бір тұзақ болуы керек, әйтпесе
Dialogue: 0,0:02:38.50,0:02:40.50,Default,,0,0,0,,Адамдардың көп болуы мүмкін емес.
Dialogue: 0,0:02:43.95,0:02:47.00,Default,,0,0,0,,Бұрын мен музыкаға салған Гетенің өлеңі
Dialogue: 0,0:02:47.54,0:02:49.16,Default,,0,0,0,,Иә, «Жын патшасы»
Dialogue: 0,0:02:52.20,0:02:54.91,Default,,0,0,0,,Жын патша, мен жазған ән
Dialogue: 0,0:02:54.95,0:02:56.58,Default,,0,0,0,,Менің ойымша, бұл оған онша ұнамады.
Dialogue: 0,0:02:57.41,0:03:00.62,Default,,0,0,0,,Жалған дүние жасап, жүрегімді ұрла
Dialogue: 0,0:03:00.75,0:03:04.29,Default,,0,0,0,,Бірақ адамдарға өз мақсатын ұмыттыруға тырысу?
Dialogue: 0,0:03:04.45,0:03:08.04,Default,,0,0,0,,Мен оны ешқашан ұмытпаймын
Dialogue: 0,0:03:12.29,0:03:12.79,Default,,0,0,0,,Ол қашып кетті.
Dialogue: 0,0:03:12.87,0:03:13.16,Default,,0,0,0,,Ах
Dialogue: 0,0:03:13.25,0:03:13.95,Default,,0,0,0,,Сол жерде
Dialogue: 0,0:03:14.08,0:03:14.41,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:17.08,0:03:18.04,Default,,0,0,0,,Екіге бөлу.
Dialogue: 0,0:03:18.37,0:03:19.04,Default,,0,0,0,,Осылайша
Dialogue: 0,0:03:21.83,0:03:27.91,Default,,0,0,0,,Иә? Ах, яғни
Dialogue: 0,0:03:30.20,0:03:33.41,Default,,0,0,0,,Сол асыл көзқарас, Айналаңдағы асқан қадір-қасиет
Dialogue: 0,0:03:33.95,0:03:36.12,Default,,0,0,0,,Оның сыртқы түрі өзгергенімен, қателесуге болмайды.
Dialogue: 0,0:03:36.87,0:03:41.25,Default,,0,0,0,,Ол менің жанымның иесі Бетховен.
Dialogue: 0,0:03:45.66,0:03:48.37,Default,,0,0,0,,Өтірік әлемінде анық болатын жалғыз нәрсе
Dialogue: 0,0:03:49.12,0:03:51.20,Default,,0,0,0,,Бұл дүниенің бір жерінде Бетховен сенпай
Dialogue: 0,0:03:51.25,0:03:55.08,Default,,0,0,0,,Менің жолымды нұрландыратын жалғыз жарық
Dialogue: 0,0:03:55.75,0:03:57.33,Default,,0,0,0,,Оны іздеп тауып ал.
Dialogue: 0,0:03:57.41,0:04:01.00,Default,,0,0,0,,-Жердің түкпір-түкпірінде жүрсем де -Құтылдым, ағайын, көмектесші.
Dialogue: 0,0:04:01.29,0:04:05.50,Default,,0,0,0,,-Әдемі көрініс,жүректік күлкі -Уу хахахаха
Dialogue: 0,0:04:06.95,0:04:08.45,Default,,0,0,0,,Бірақ алданып қалмаңыз
Dialogue: 0,0:04:08.83,0:04:13.41,Default,,0,0,0,,-Күрсініп -Мына момын қария да шайтанның қолбасы
Dialogue: 0,0:04:14.75,0:04:16.79,Default,,0,0,0,,Осы дүниеде өмір сүретін барлық адамдар
Dialogue: 0,0:04:17.33,0:04:21.12,Default,,0,0,0,,Сіз жын патшасынан бұйрық алдыңыз және мені адастыруға тырысып жатырсыз.
Dialogue: 0,0:04:23.70,0:04:27.29,Default,,0,0,0,,Жоқ, әлде жын патшаға бәрі алданып қалған шығар.
Dialogue: 0,0:04:27.87,0:04:29.66,Default,,0,0,0,,Сіз бұл дүниеде қамалып қалдыңыз ба?
Dialogue: 0,0:04:31.70,0:04:36.91,Default,,0,0,0,,Қош келдіңіз, көп рахмет.
Dialogue: 0,0:04:37.95,0:04:41.50,Default,,0,0,0,,Қош келдіңіз, көп рахмет.
Dialogue: 0,0:04:42.12,0:04:45.58,Default,,0,0,0,,Қош келдіңіз, көп рахмет.
Dialogue: 0,0:04:45.95,0:04:47.04,Default,,0,0,0,,Таңқаларлық
Dialogue: 0,0:04:47.20,0:04:50.04,Default,,0,0,0,,Музыка барлық жерде.
Dialogue: 0,0:04:50.62,0:04:52.00,Default,,0,0,0,,Сіз кедергісіз
Dialogue: 0,0:05:00.25,0:05:03.87,Default,,0,0,0,,Уа, ау, әй?
Dialogue: 0,0:05:05.20,0:05:06.33,Default,,0,0,0,,Сіз қаншалықты алыс барасыз?
Dialogue: 0,0:05:07.08,0:05:12.25,Default,,0,0,0,,-Көп қызықты және жұмбақ музыка -Хафууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:05:12.91,0:05:16.37,Default,,0,0,0,,-Жүрегімнен ұстап ал, жіберме Ааааааааааааааааааааааааааааа
Dialogue: 0,0:05:16.58,0:05:21.54,Default,,0,0,0,,-Бұл дүниеде батып кеткің келетін ләззат пен хаос -Фуууууууууууууу
Dialogue: 0,0:05:21.70,0:05:24.83,Default,,0,0,0,,-Жоқ, жоқ, оян, Франц -Ууууууууу...
Dialogue: 0,0:05:31.91,0:05:32.33,Default,,0,0,0,,Хмм?
Dialogue: 0,0:05:32.75,0:05:34.87,Default,,0,0,0,,Қай көлікпен келгеніңізді білмейсіз бе?
Dialogue: 0,0:05:35.54,0:05:39.04,Default,,0,0,0,,Мен Франц Шубертпін, алға жылжайық.
Dialogue: 0,0:05:39.45,0:05:41.83,Default,,0,0,0,,Адал және шын жүректен
Dialogue: 0,0:05:42.33,0:05:44.70,Default,,0,0,0,,Мен аға Бетховенмен кездескенше
Dialogue: 0,0:05:47.91,0:05:49.33,Default,,0,0,0,,О-о
Dialogue: 0,0:05:49.70,0:05:52.04,Default,,0,0,0,,-Ахахахаха -Баланың домалауы тоқтамайды
Dialogue: 0,0:05:52.83,0:05:55.25,Default,,0,0,0,,-Адамдар топтасып сәбидей болып кетеді -Ахааааааааааааааааааааааааааааааааа
Dialogue: 0,0:05:55.66,0:05:57.70,Default,,0,0,0,,Бұл нәрестенің айналуы деп аталатын құбылыс.
Dialogue: 0,0:05:58.20,0:06:01.16,Default,,0,0,0,,Себеп толық белгісіз болғанымен, оның пайда болған жері
Dialogue: 0,0:06:01.41,0:06:04.04,Default,,0,0,0,,Бірте-бірте шығысқа қарай жылжиды дейді.
Dialogue: 0,0:06:04.08,0:06:05.04,Default,,0,0,0,,Бұл түсінікті болды
Dialogue: 0,0:06:05.37,0:06:06.87,Default,,0,0,0,,Қандай қызық оқиға.
Dialogue: 0,0:06:07.20,0:06:10.70,Default,,0,0,0,,Эй, осы жазда гёза маркалы митинг болады.
Dialogue: 0,0:06:11.04,0:06:12.45,Default,,0,0,0,,Марка митингі дегеніміз не?
Dialogue: 0,0:06:13.00,0:06:15.62,Default,,0,0,0,,Әртүрлі гиоза дүкендеріне барыңыз және гиоза жеңіз.
Dialogue: 0,0:06:15.83,0:06:19.41,Default,,0,0,0,,Мөр алыңыз. Егер сіз 10 марка жинасаңыз, сіз сыйлық аласыз.
Dialogue: 0,0:06:19.70,0:06:22.75,Default,,0,0,0,,Әй, бұл пикник сияқты.
Dialogue: 0,0:06:23.00,0:06:25.25,Default,,0,0,0,,Гиозаны іздеудегі саяхат?
Dialogue: 0,0:06:27.62,0:06:30.08,Default,,0,0,0,,От сиқыршыларымен оныншы шайқас
Dialogue: 0,0:06:30.75,0:06:33.75,Default,,0,0,0,,Оны жеңуден басқа амал жоқ па?
Dialogue: 0,0:06:33.83,0:06:35.20,Default,,0,0,0,,Көп қыз келе ме?
Dialogue: 0,0:06:35.41,0:06:38.20,Default,,0,0,0,,Бәлкім, батпырауық ұшыру жарысы болды ма.
Dialogue: 0,0:06:38.25,0:06:39.58,Default,,0,0,0,,Бұл өте үлкен фестиваль.
Dialogue: 0,0:06:39.70,0:06:41.08,Default,,0,0,0,,Олай болса біз де барайық.
Dialogue: 0,0:06:41.20,0:06:41.95,Default,,0,0,0,,Иә, мен де?
Dialogue: 0,0:06:42.20,0:06:45.45,Default,,0,0,0,,Өйткені Сосуке болмаса, төлейтін ешкім болмас еді.
Dialogue: 0,0:06:45.54,0:06:46.62,Default,,0,0,0,,Ал, өзің төле.
Dialogue: 0,0:06:47.45,0:06:48.45,Default,,0,0,0,,Утана да барады, солай ма?
Dialogue: 0,0:06:48.66,0:06:49.45,Default,,0,0,0,,Мен бармаймын.
Dialogue: 0,0:06:49.66,0:06:52.08,Default,,0,0,0,,Неге, неге, неге барамыз?
Dialogue: 0,0:06:52.25,0:06:54.75,Default,,0,0,0,,Утанае бармаса, мен жалықтырамын.
Dialogue: 0,0:06:55.00,0:06:57.29,Default,,0,0,0,,Тазалау, кір жуу, қабырғаларды жөндеу және т.б.
Dialogue: 0,0:06:57.37,0:06:59.66,Default,,0,0,0,,Еденді жөндеу, төбені жөндеу және т.б.
Dialogue: 0,0:06:59.95,0:07:02.70,Default,,0,0,0,,-Біреудің кесірінен жұмысым үйіліп жатыр. -Хахахахахаха
Dialogue: 0,0:07:03.04,0:07:04.16,Default,,0,0,0,,Кім? Сосуке?
Dialogue: 0,0:07:04.25,0:07:05.58,Default,,0,0,0,,«Тачи»
Dialogue: 0,0:07:07.50,0:07:09.04,Default,,0,0,0,,Бұл қала таныс сияқты.
Dialogue: 0,0:07:09.62,0:07:12.00,Default,,0,0,0,,Гармонияға ұқсас үлкен ғимарат
Dialogue: 0,0:07:14.16,0:07:14.87,Default,,0,0,0,,Белгілі
Dialogue: 0,0:07:18.16,0:07:19.16,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:21.75,0:07:24.50,Default,,0,0,0,,Үлкен доп болады ма?
Dialogue: 0,0:07:25.25,0:07:29.83,Default,,0,0,0,,Жоқ, бұл дүниенің ресми киімі шығар.
Dialogue: 0,0:07:31.08,0:07:33.62,Default,,0,0,0,,Жаңа патша таққа отыруы мүмкін
Dialogue: 0,0:07:34.87,0:07:36.87,Default,,0,0,0,,Бетховен ағасы да келуі мүмкін.
Dialogue: 0,0:07:51.00,0:07:53.79,Default,,0,0,0,,Бұл музыкалық қорап па?
Dialogue: 0,0:07:56.87,0:07:57.50,Default,,0,0,0,,Хмм?
Dialogue: 0,0:08:02.62,0:08:05.75,Default,,0,0,0,,Бұл шығарма шынымен аға Бетховендікі.
Dialogue: 0,0:08:06.83,0:08:10.12,Default,,0,0,0,,Неге, тіпті мына оғаш дүниеде
Dialogue: 0,0:08:10.37,0:08:13.12,Default,,0,0,0,,Қарттарымның асқақ әндері шырқайды
Dialogue: 0,0:08:13.62,0:08:15.70,Default,,0,0,0,,Күтілгендей, күткендей, ah
Dialogue: 0,0:08:17.62,0:08:19.70,Default,,0,0,0,,О, тамаша музыкалық қорап
Dialogue: 0,0:08:20.00,0:08:21.75,Default,,0,0,0,,Тон да тамаша болуы керек.
Dialogue: 0,0:08:22.79,0:08:23.87,Default,,0,0,0,,Хмм.
Dialogue: 0,0:08:28.70,0:08:31.87,Default,,0,0,0,,Ммммммммм
Dialogue: 0,0:08:34.54,0:08:36.66,Default,,0,0,0,,Бұл Моцарттікі
Dialogue: 0,0:08:38.91,0:08:42.12,Default,,0,0,0,,Сіздің музыкаңыз Моцартқа еліктеу ғана.
Dialogue: 0,0:08:42.20,0:08:44.12,Default,,0,0,0,,Доктор Са Сальери
Dialogue: 0,0:08:44.54,0:08:45.41,Default,,0,0,0,,Бұл плагиат.
Dialogue: 0,0:08:45.50,0:08:46.75,Default,,0,0,0,,Өтініш жасамаңыз
Dialogue: 0,0:08:47.37,0:08:49.00,Default,,0,0,0,,Сол қорлық күндер
Dialogue: 0,0:08:49.29,0:08:53.83,Default,,0,0,0,,Иә, мен сені ешқашан кешірмеймін, Моцарт.
Dialogue: 0,0:08:54.41,0:08:55.83,Default,,0,0,0,,О, ой
Dialogue: 0,0:08:56.16,0:08:58.70,Default,,0,0,0,,Ах, күткендей, Бетховен-сенпай.
Dialogue: 0,0:08:59.04,0:09:01.70,Default,,0,0,0,,Моцарт қарғыс атсын
Dialogue: 0,0:09:02.41,0:09:05.45,Default,,0,0,0,,-Ыңғайсыз -Ой, Уау, бір мезгілде
Dialogue: 0,0:09:05.54,0:09:07.58,Default,,0,0,0,,Дәл қазір мені бір нәрсе дірілдеп жіберді.
Dialogue: 0,0:09:07.83,0:09:10.41,Default,,0,0,0,,Мен де, отты жындардың өлтіруші рухы
Dialogue: 0,0:09:10.70,0:09:12.91,Default,,0,0,0,,Бұл менің бес сезім мүшелерім ойнаған жауынгер діріл ме?
Dialogue: 0,0:09:13.37,0:09:16.50,Default,,0,0,0,,Мен гиоза жеу үшін гиоза мейрамханасына бара жатырмын.
Dialogue: 0,0:09:18.00,0:09:19.75,Default,,0,0,0,,Ой
Dialogue: 0,0:09:22.33,0:09:23.95,Default,,0,0,0,,Ааа
Dialogue: 0,0:09:24.62,0:09:26.70,Default,,0,0,0,,...
Dialogue: 0,0:09:26.79,0:09:28.91,Default,,0,0,0,,-Кейде көгерген бөлмеден шығып кет.
Dialogue: 0,0:09:29.00,0:09:31.75,Default,,0,0,0,,-Күн сәулесінің түсуі маңызды, солай ма?
Dialogue: 0,0:09:31.79,0:09:35.33,Default,,0,0,0,,-Бүкіл тіршілікке жауатын шексіз игілік -мммммм
Dialogue: 0,0:09:35.91,0:09:37.37,Default,,0,0,0,,Бұл махаббат емес пе?
Dialogue: 0,0:09:37.79,0:09:40.91,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:09:43.79,0:09:44.33,Default,,0,0,0,,Хмм?
Dialogue: 0,0:09:52.29,0:09:56.29,Default,,0,0,0,,Бұл да Steamed Adagio музыкасы
Dialogue: 0,0:09:56.62,0:09:59.12,Default,,0,0,0,,Кенеттен аллегро шырылдады
Dialogue: 0,0:09:59.87,0:10:02.79,Default,,0,0,0,,Ал Далчегно керемет.
Dialogue: 0,0:10:03.70,0:10:07.12,Default,,0,0,0,,Ол сот концертін басқара алады.
Dialogue: 0,0:10:08.00,0:10:10.33,Default,,0,0,0,,О? Бұл жақсы. Біреуі ше?
Dialogue: 0,0:10:11.29,0:10:11.83,Default,,0,0,0,,Сонымен
Dialogue: 0,0:10:12.50,0:10:14.79,Default,,0,0,0,,Эй, өтінемін, мөр сол жерде.
Dialogue: 0,0:10:19.62,0:10:25.70,Default,,0,0,0,,Хмм ха ха ха
Dialogue: 0,0:10:28.45,0:10:29.62,Default,,0,0,0,,Ммм
Dialogue: 0,0:10:29.66,0:10:32.62,Default,,0,0,0,,А, аузымда нимфалар билеп жатыр
Dialogue: 0,0:10:32.75,0:10:35.29,Default,,0,0,0,,Бұл шынында да бір оқтын өлең.
Dialogue: 0,0:10:35.41,0:10:39.58,Default,,0,0,0,,Сіз бәрібір суретшісіз.
Dialogue: 0,0:10:41.25,0:10:42.41,Default,,0,0,0,,Не? Сәлем
Dialogue: 0,0:10:43.33,0:10:43.79,Default,,0,0,0,,Сонымен
Dialogue: 0,0:10:44.12,0:10:46.16,Default,,0,0,0,,Бұл қанша тұрады?
Dialogue: 0,0:10:51.04,0:10:54.50,Default,,0,0,0,,Еңбек ет, мен демаламын.
Dialogue: 0,0:10:55.00,0:10:56.66,Default,,0,0,0,,Қашсаң, жалғыз қалмайсың.
Dialogue: 0,0:10:57.75,0:10:58.12,Default,,0,0,0,,Иә
Dialogue: 0,0:11:02.58,0:11:06.58,Default,,0,0,0,,Adagio Allegro Dulsegno №
Dialogue: 0,0:11:06.79,0:11:10.12,Default,,0,0,0,,Бұл шайтанның азғыруы екенін білсем де, бұл ләззатымды тоқтата алмаймын.
Dialogue: 0,0:11:10.66,0:11:14.54,Default,,0,0,0,,Лах рах рах рах рах рах рах рах
Dialogue: 0,0:11:14.70,0:11:18.37,Default,,0,0,0,,-Рах-рах-рах-рах-рах-а?
Dialogue: 0,0:11:18.75,0:11:22.41,Default,,0,0,0,,Ла-ла-ла-ла-ла-ла-ла-ла-ла
Dialogue: 0,0:11:22.66,0:11:24.87,Default,,0,0,0,,-Ралала ла -Ән айту гёза дүкені?
Dialogue: 0,0:11:24.91,0:11:26.50,Default,,0,0,0,,-Лалалалалала -Қызық емес пе?
Dialogue: 0,0:11:26.75,0:11:32.41,Default,,0,0,0,,- Ла ла ла ла ла ла ла ла ла ла ла ла - Кешіріңіз, маған бір нәрсе беріңіз.
Dialogue: 0,0:11:32.50,0:11:33.50,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:33.66,0:11:34.16,Default,,0,0,0,,-мм -рах
Dialogue: 0,0:11:34.20,0:11:35.00,Default,,0,0,0,,-Дәмді -Ра-Ра-Ра
Dialogue: 0,0:11:35.37,0:11:36.70,Default,,0,0,0,,-Мен де беремін -Лалала
Dialogue: 0,0:11:37.04,0:11:38.12,Default,,0,0,0,,-Бұл екеуі -Ra
Dialogue: 0,0:11:38.16,0:11:38.45,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:38.54,0:11:39.50,Default,,0,0,0,,Менде үшеу бар.
Dialogue: 0,0:11:39.91,0:11:42.37,Default,,0,0,0,,-Аа, үлкен сызық бар -Лала ла ла ла
Dialogue: 0,0:11:42.54,0:11:44.58,Default,,0,0,0,,-Жарайды, осыдан бастайық -Ла Ла
Dialogue: 0,0:11:44.66,0:11:48.54,Default,,0,0,0,,Лала ла ла ла ла ла ла ла ла
Dialogue: 0,0:11:48.66,0:11:52.66,Default,,0,0,0,,Ла ла ла ла ла ла
Dialogue: 0,0:11:52.83,0:11:58.70,Default,,0,0,0,,-La-la-ran-la la-la-ran-la-la la-la-la-la -Мен бұл әнді бұрын естігенмін.
Dialogue: 0,0:11:58.79,0:12:00.66,Default,,0,0,0,,- «Жабайы раушан» - ла ла ла ла ла
Dialogue: 0,0:12:00.75,0:12:02.87,Default,,0,0,0,,- Франц Шуберт жазған әндердің ішінде - Ла ла ла ла ла ла ла ла ла
Dialogue: 0,0:12:02.91,0:12:06.50,Default,,0,0,0,,- «Жын патшасы» әніне ұқсас ең танымалдардың бірі - Лара
Dialogue: 0,0:12:06.54,0:12:08.58,Default,,0,0,0,,- Гетенің музыкаға қойылған поэмасы - ла ла ла ла
Dialogue: 0,0:12:09.16,0:12:12.20,Default,,0,0,0,,-Осы әйгілі әнді білмесең де ақымақсың О -Лалалала
Dialogue: 0,0:12:12.33,0:12:16.16,Default,,0,0,0,,-Ралала-рах-рах-рах-рах-Бетховен Сенпай Қазір қайдасың?
Dialogue: 0,0:12:16.25,0:12:18.66,Default,,0,0,0,,-Мм? Мен бұл әннің Ла Ла Ла Ран екеніне сенімдімін
Dialogue: 0,0:12:18.70,0:12:20.87,Default,,0,0,0,,-Ол дүкендегі гиоза да дәмді болды. -Лалалалала
Dialogue: 0,0:12:21.08,0:12:23.25,Default,,0,0,0,,-Ол күйіктің ең жақсысы -ха
Dialogue: 0,0:12:23.33,0:12:24.66,Default,,0,0,0,,-Лала -Өрттеніп кетті ме?
Dialogue: 0,0:12:24.75,0:12:28.20,Default,,0,0,0,,-Егер мен қуып келе жатқан елес Гиоза сонда болса ше -Ранра Ранран ла ла ла ла ла
Dialogue: 0,0:12:28.25,0:12:29.37,Default,,0,0,0,,-Мен көз жеткізуім керек -Ран Ра
Dialogue: 0,0:12:29.41,0:12:31.04,Default,,0,0,0,,- Иә? Біз осы уақытқа дейін сапқа тұрдық па? -Лара
Dialogue: 0,0:12:31.08,0:12:33.00,Default,,0,0,0,,- Оны жай қалдыру керек емес пе? -Лала ла ла ла
Dialogue: 0,0:12:33.37,0:12:34.91,Default,,0,0,0,,-Аа, бір пакет өтінемін -Лалалалалала
Dialogue: 0,0:12:35.08,0:12:36.95,Default,,0,0,0,,- Иә? Сосуке тамақ ішпей ме? -Лала Ла
Dialogue: 0,0:12:37.20,0:12:39.83,Default,,0,0,0,,-Бізде бюджет жоқ болғандықтан екі адамға тамақ ішеміз -Лара
Dialogue: 0,0:12:39.95,0:12:41.04,Default,,0,0,0,,Увааааааааааааааааааа
Dialogue: 0,0:12:41.20,0:12:43.41,Default,,0,0,0,,Не, мен бұл адамды көрген сәтте?
Dialogue: 0,0:12:43.50,0:12:44.50,Default,,0,0,0,,Нхихихи
Dialogue: 0,0:12:44.70,0:12:45.54,Default,,0,0,0,,О, қалтырау.
Dialogue: 0,0:12:45.83,0:12:48.41,Default,,0,0,0,,Не? Менің бетімде бірдеңе бар ма?
Dialogue: 0,0:12:48.50,0:12:50.70,Default,,0,0,0,,Жоқ, өтінемін.
Dialogue: 0,0:12:50.95,0:12:54.70,Default,,0,0,0,,-Ммф, ммф, хехехе -Мен бұл адамды қайта көргім келмейді.
Dialogue: 0,0:12:55.29,0:12:57.33,Default,,0,0,0,,Уау, бұл дәмді болды.
Dialogue: 0,0:12:57.66,0:13:00.37,Default,,0,0,0,,Уф, жалықтым, жетеді.
Dialogue: 0,0:13:00.41,0:13:00.62,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:00.66,0:13:01.70,Default,,0,0,0,,Олай болса сәттілік
Dialogue: 0,0:13:01.79,0:13:02.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:02.25,0:13:05.58,Default,,0,0,0,,-Қыз, қыз, -Қандай өзімшілсің? А?
Dialogue: 0,0:13:06.41,0:13:08.29,Default,,0,0,0,,Эй, сен Чоччанды көрмедің бе?
Dialogue: 0,0:13:08.54,0:13:10.29,Default,,0,0,0,,Не? Мен оны көрген жоқпын.
Dialogue: 0,0:13:10.58,0:13:12.70,Default,,0,0,0,,Мен сені пикникке апарсам да.
Dialogue: 0,0:13:12.95,0:13:14.83,Default,,0,0,0,,Мен білмей тұрып, екеуміз бөлініп кеттік.
Dialogue: 0,0:13:15.04,0:13:16.45,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:16.70,0:13:18.45,Default,,0,0,0,,Сіз менімен бірге іздейсіз, солай ма?
Dialogue: 0,0:13:18.79,0:13:19.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:20.95,0:13:24.29,Default,,0,0,0,,Сіз осындай сызықты құру үшін өте талантты болуыңыз керек.
Dialogue: 0,0:13:25.20,0:13:26.00,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:13:26.70,0:13:28.95,Default,,0,0,0,,Енді тегін ішіп-жеуге болмайды.
Dialogue: 0,0:13:30.58,0:13:34.54,Default,,0,0,0,,Әй, бақытты уақыт, жоқ, олай емес.
Dialogue: 0,0:13:34.95,0:13:38.50,Default,,0,0,0,,Мықты бол, Франц, мақсатыңды ұмытпа.
Dialogue: 0,0:13:39.41,0:13:40.70,Default,,0,0,0,,Қайтадан шығайық
Dialogue: 0,0:13:41.41,0:13:44.62,Default,,0,0,0,,Менің жарығым, аға Бетховенді іздеу
Dialogue: 0,0:13:56.45,0:13:56.83,Default,,0,0,0,,Хун
Dialogue: 0,0:13:58.45,0:14:00.83,Default,,0,0,0,,Хусси, бұл тамақ.
Dialogue: 0,0:14:03.50,0:14:08.75,Default,,0,0,0,,Хмм? Хмм хахаха
Dialogue: 0,0:14:15.00,0:14:19.54,Default,,0,0,0,,А, шулы фритерлерсіз өте ыңғайлы.
Dialogue: 0,0:14:25.20,0:14:28.75,Default,,0,0,0,,Хмм, бұл үй шынымен де тыныш болды ма?
Dialogue: 0,0:14:30.00,0:14:33.41,Default,,0,0,0,,Мен өзімді аздап жалғыз сезінемін.
Dialogue: 0,0:14:33.75,0:14:34.91,Default,,0,0,0,,Мүмкін мен оны кітаптан оқуым керек шығар
Dialogue: 0,0:14:37.75,0:14:40.04,Default,,0,0,0,,Хина, сен мұнда не үшін келдің?
Dialogue: 0,0:14:40.33,0:14:42.12,Default,,0,0,0,,Бұл қорқынышты, өйткені ол адам толы
Dialogue: 0,0:14:43.70,0:14:52.12,Default,,0,0,0,,-Мыңнан бір түйір үміт... -Хмм? Ал, сен кімсің?
Dialogue: 0,0:14:52.20,0:14:55.25,Default,,0,0,0,,-Неліктен әртүрлі сөздер көп? -Эй, сен онда не істеп жүрсің?
Dialogue: 0,0:14:55.95,0:14:58.87,Default,,0,0,0,,-Кәкеете -Ол адам қораптың ішінде неге ән айтып тұр?
Dialogue: 0,0:14:59.79,0:15:06.12,Default,,0,0,0,,-Өсіңдер, өсіңдер... -Балалар жиналып, денелеріне музыка ойналады.
Dialogue: 0,0:15:06.20,0:15:11.16,Default,,0,0,0,,-Менің музыкам осы қорқынышты әлемде жұмыс істей ме? -Өсіңдер, өсіңдер...
Dialogue: 0,0:15:12.45,0:15:15.83,Default,,0,0,0,,Ер адам үй-жайға рұқсатсыз кірді ме?
Dialogue: 0,0:15:16.20,0:15:20.41,Default,,0,0,0,,Хахаха Балабақшадағы балаларды қарап отырып, күдікті адам билеп тұрған.
Dialogue: 0,0:15:21.00,0:15:22.29,Default,,0,0,0,,Тамақ пен сусын тегін ме?
Dialogue: 0,0:15:22.66,0:15:23.00,Default,,0,0,0,,О
Dialogue: 0,0:15:23.50,0:15:25.91,Default,,0,0,0,,Мен оған үзіліс бердім, өйткені ол жұмыс істеймін және маған төлеймін деді.
Dialogue: 0,0:15:26.37,0:15:28.91,Default,,0,0,0,,Әлгі бейбақ тұшпара тегін берді.
Dialogue: 0,0:15:29.33,0:15:30.66,Default,,0,0,0,,«Ешқашан кешірме»
Dialogue: 0,0:15:30.75,0:15:32.70,Default,,0,0,0,,Сіз мұны қорқынышты жүзбен айттыңыз ба?
Dialogue: 0,0:15:32.83,0:15:34.00,Default,,0,0,0,,-ха хаха -э
Dialogue: 0,0:15:34.12,0:15:36.04,Default,,0,0,0,,Көптеген күдікті адамдар кезіп жүрген сияқты.
Dialogue: 0,0:15:36.54,0:15:37.83,Default,,0,0,0,,Патрульдерді көбейтіңіз.
Dialogue: 0,0:15:40.70,0:15:44.16,Default,,0,0,0,,Йойшо Йойшо Йойшо Йойшо
Dialogue: 0,0:15:44.50,0:15:46.70,Default,,0,0,0,,Йойшо Йойшо Йойшо
Dialogue: 0,0:15:46.79,0:15:47.50,Default,,0,0,0,,Сорей
Dialogue: 0,0:15:47.54,0:15:48.79,Default,,0,0,0,,Орындаңыз
Dialogue: 0,0:15:49.25,0:15:53.45,Default,,0,0,0,,Бетховен Сенпай, сен қазір мына лабиринтте не істеп жүрсің?
Dialogue: 0,0:15:54.12,0:15:55.50,Default,,0,0,0,,Сол асыл көзқараспен
Dialogue: 0,0:15:55.58,0:15:57.66,Default,,0,0,0,,Сіз қандай музыканы көріп тұрсыз?
Dialogue: 0,0:15:58.91,0:16:00.50,Default,,0,0,0,,Аз ғана дүкен қалды
Dialogue: 0,0:16:01.41,0:16:04.79,Default,,0,0,0,,Бірақ дәмдердің ешқайсысы мен іздегенге жақын емес.
Dialogue: 0,0:16:05.79,0:16:08.45,Default,,0,0,0,,Гиоза қаншалықты терең?
Dialogue: 0,0:16:09.08,0:16:10.95,Default,,0,0,0,,О, мен істеп жатырмын.
Dialogue: 0,0:16:11.58,0:16:14.79,Default,,0,0,0,,Биылғы жіп кесу тартысы да қызықты болатын сияқты.
Dialogue: 0,0:16:15.91,0:16:17.66,Default,,0,0,0,,Бұл қандай да бір рәсім ме?
Dialogue: 0,0:16:19.25,0:16:21.45,Default,,0,0,0,,Бетховен аға да мұны бір жерде жасады.
Dialogue: 0,0:16:21.58,0:16:22.79,Default,,0,0,0,,Қуырылған және қуырылған
Dialogue: 0,0:16:23.45,0:16:24.54,Default,,0,0,0,,-А да -Ада Доа
Dialogue: 0,0:16:24.62,0:16:26.50,Default,,0,0,0,,Ауырды
Dialogue: 0,0:16:26.58,0:16:27.45,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:16:27.54,0:16:27.91,Default,,0,0,0,,О.
Dialogue: 0,0:16:28.29,0:16:30.29,Default,,0,0,0,,Иә? Бұрынғы гиоза дүкені ме?
Dialogue: 0,0:16:31.79,0:16:33.37,Default,,0,0,0,,Эй, мен біреуді іздеп жүрмін.
Dialogue: 0,0:16:33.62,0:16:36.29,Default,,0,0,0,,Иә, бұл маған Құдай сияқты
Dialogue: 0,0:16:36.50,0:16:38.41,Default,,0,0,0,,Ол тамаша музыкант.
Dialogue: 0,0:16:38.66,0:16:39.58,Default,,0,0,0,,Құдай дегеніміз не?
Dialogue: 0,0:16:39.83,0:16:41.62,Default,,0,0,0,,Жалғыз данышпан, былайша айтқанда.
Dialogue: 0,0:16:42.12,0:16:45.33,Default,,0,0,0,,Тіпті данышпандардың өзі өз талантына әуестеніп, өзімшілдікпен әрекет етеді.
Dialogue: 0,0:16:45.62,0:16:48.29,Default,,0,0,0,,Музыканттардың болашақ ұрпақтарына жоғарыдан қысым көрсету
Dialogue: 0,0:16:48.41,0:16:50.16,Default,,0,0,0,,Жеңіл музыкант кім?
Dialogue: 0,0:16:50.29,0:16:51.83,Default,,0,0,0,,Аспан мен жердің айырмашылығы бар.
Dialogue: 0,0:16:51.91,0:16:52.58,Default,,0,0,0,,Сол жексұрын Аводл әлі тірі ғой, иә?
Dialogue: 0,0:16:52.66,0:16:53.95,Default,,0,0,0,,А, мен бір нәрсені білемін.
Dialogue: 0,0:16:54.25,0:16:56.45,Default,,0,0,0,,Талантты болсаң да, музыканы дұрыс орындамайсың.
Dialogue: 0,0:16:56.50,0:16:58.87,Default,,0,0,0,,Адамдар жай ойнағанда мен ашуланамын.
Dialogue: 0,0:16:59.41,0:17:01.16,Default,,0,0,0,,Менің ойымша, біз сенімен жақсы араласамыз.
Dialogue: 0,0:17:01.45,0:17:05.50,Default,,0,0,0,,Не? Түсінемін, мен Кагура Сосукемін.
Dialogue: 0,0:17:05.66,0:17:07.29,Default,,0,0,0,,Мен...
Dialogue: 0,0:17:07.54,0:17:09.41,Default,,0,0,0,,№. Франц Шубертпен
Dialogue: 0,0:17:09.50,0:17:11.08,Default,,0,0,0,,Толық аты-жөніңізді көрсетуіңіз керек
Dialogue: 0,0:17:11.54,0:17:13.25,Default,,0,0,0,,Танысқаныма қуаныштымын, Шу мырза.
Dialogue: 0,0:17:13.87,0:17:16.08,Default,,0,0,0,,Бірақ ол сондай керемет музыкант болса ше?
Dialogue: 0,0:17:16.20,0:17:18.25,Default,,0,0,0,,Менің де сізбен кездесіп, біраз нәрселерді білгім келетін шығар.
Dialogue: 0,0:17:19.16,0:17:20.45,Default,,0,0,0,,Сіз де музыка ойнайсыз ба?
Dialogue: 0,0:17:21.37,0:17:22.33,Default,,0,0,0,,Маған келесі сұраққа жауап бер.
Dialogue: 0,0:17:24.45,0:17:27.45,Default,,0,0,0,,Нффуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфу
Dialogue: 0,0:17:27.54,0:17:30.91,Default,,0,0,0,,-Аа, Бетховен-сенпай, мінекей -Хехехехехехехехехе
Dialogue: 0,0:17:31.29,0:17:33.25,Default,,0,0,0,,-Қанша күш салсаң да -Хехехехе
Dialogue: 0,0:17:33.33,0:17:36.12,Default,,0,0,0,,- Ешқашан биікке жете алмайтын қарапайым талант - Хехехехехехехе
Dialogue: 0,0:17:36.33,0:17:39.04,Default,,0,0,0,,-Қарапайым данышпандардың ізімен -Фуууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу?
Dialogue: 0,0:17:39.12,0:17:43.37,Default,,0,0,0,,-Алыстан үмітсіздікті қайталайтын бұл балаға бақыт болсын -Хунфуфуфууууу хей
Dialogue: 0,0:17:44.41,0:17:46.41,Default,,0,0,0,,Хмммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:17:46.75,0:17:48.50,Default,,0,0,0,,-Ммммммм -о? Сіз сондай әсер қалдырдыңыз ба?
Dialogue: 0,0:17:48.58,0:17:50.41,Default,,0,0,0,,Жыламасам тыңдай алмаймын.
Dialogue: 0,0:17:50.75,0:17:54.91,Default,,0,0,0,,Шынайы ма? Жарайды, мен де біреуді іздеу үстіндемін.
Dialogue: 0,0:17:55.37,0:18:00.04,Default,,0,0,0,,-Hyuu hyuu hyuu hyuu hyuuu -Саған жетпесем де, қуып кете беремін.
Dialogue: 0,0:18:00.66,0:18:02.79,Default,,0,0,0,,Бетховеннің үлкен арқасы аға
Dialogue: 0,0:18:07.29,0:18:10.00,Default,,0,0,0,,Йойшо Йойшо Йойшо Йойшо Йойшо
Dialogue: 0,0:18:14.83,0:18:18.29,Default,,0,0,0,,Ырғақ пен хаос сезімі
Dialogue: 0,0:18:18.83,0:18:20.45,Default,,0,0,0,,Ағаға кім жақындап келеді?
Dialogue: 0,0:18:20.70,0:18:23.95,Default,,0,0,0,,Әй, Бетховен сенпай, уау!
Dialogue: 0,0:18:24.04,0:18:24.37,Default,,0,0,0,,Ал егер Цуки Кира болса, онда Цуки Нианы өлтіреді
Dialogue: 0,0:18:24.83,0:18:26.50,Default,,0,0,0,,Мына адам
Dialogue: 0,0:18:26.70,0:18:28.70,Default,,0,0,0,,Сен де қыз алуға келдің бе?
Dialogue: 0,0:18:28.91,0:18:30.41,Default,,0,0,0,,Мм, көзілдірік алғаныңыз дұрыс па?
Dialogue: 0,0:18:30.62,0:18:33.00,Default,,0,0,0,,Қойшы мені, жақындама
Dialogue: 0,0:18:33.33,0:18:36.41,Default,,0,0,0,,Неге қашып бара жатырсың? Хаха, тег ойыны сияқты ма?
Dialogue: 0,0:18:36.66,0:18:39.54,Default,,0,0,0,,-Мен саған жақындама десем де, сен жын патшаның бейнесісің -Ахахахахахахахахахаха
Dialogue: 0,0:18:39.91,0:18:41.04,Default,,0,0,0,,Не? Мен оны ысқылап жатырмын
Dialogue: 0,0:18:41.41,0:18:44.29,Default,,0,0,0,,-Ашық қоңыр киім киген, дөңгелек көзілдірік киген адам -Ахахаха
Dialogue: 0,0:18:44.37,0:18:47.29,Default,,0,0,0,,- Бұталы қызыл шаш. Бұл күдікті адам ма? -Ахахаха Ахахха
Dialogue: 0,0:18:47.62,0:18:49.25,Default,,0,0,0,,Жарайды, екеуі де қорғалған.
Dialogue: 0,0:18:49.33,0:18:51.75,Default,,0,0,0,,-     -
Dialogue: 0,0:18:51.91,0:18:54.08,Default,,0,0,0,,-Ой, мен кетейін -ninini-ni-ni
Dialogue: 0,0:18:54.12,0:18:54.91,Default,,0,0,0,,Тоқта
Dialogue: 0,0:18:55.20,0:18:56.66,Default,,0,0,0,,-Ей, тыныштал. -Нинини.
Dialogue: 0,0:18:56.70,0:18:59.20,Default,,0,0,0,,Не? Сіз де қатысқыңыз келе ме?
Dialogue: 0,0:18:59.37,0:19:00.91,Default,,0,0,0,,Енді жын патшаның әскері
Dialogue: 0,0:19:01.16,0:19:04.33,Default,,0,0,0,,- Нихихи - Сен мұнда келіп, мені саботажға алмақшысың.
Dialogue: 0,0:19:04.58,0:19:06.29,Default,,0,0,0,,О, мүмкін
Dialogue: 0,0:19:06.62,0:19:09.70,Default,,0,0,0,,Менің ойымша, Бетховен осында.
Dialogue: 0,0:19:10.04,0:19:10.75,Default,,0,0,0,,Сенпай?
Dialogue: 0,0:19:11.12,0:19:11.58,Default,,0,0,0,,Хмм?
Dialogue: 0,0:19:11.66,0:19:13.83,Default,,0,0,0,,-Мен көптен бері іздедім. -Хмм.
Dialogue: 0,0:19:13.91,0:19:16.62,Default,,0,0,0,,Сенпаааи
Dialogue: 0,0:19:16.83,0:19:19.91,Default,,0,0,0,,-Шопин А? - Бетховен Сенпаай
Dialogue: 0,0:19:20.37,0:19:23.00,Default,,0,0,0,,Мен сені жақын сезінемін
Dialogue: 0,0:19:23.50,0:19:24.87,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:25.08,0:19:27.62,Default,,0,0,0,,Кешіріңіз, бұл мен күткеннен де танымал болды.
Dialogue: 0,0:19:27.87,0:19:29.29,Default,,0,0,0,,Оның қоймасы таусылды.
Dialogue: 0,0:19:29.62,0:19:34.50,Default,,0,0,0,,Ка, аа, іздедім, бірақ сауап болмады.
Dialogue: 0,0:19:34.95,0:19:39.29,Default,,0,0,0,,Бұл тағдыр ма?
Dialogue: 0,0:19:39.37,0:19:40.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:44.16,0:19:45.91,Default,,0,0,0,,Ааа
Dialogue: 0,0:19:46.45,0:19:50.75,Default,,0,0,0,,Оваааааааааааааааааааааа Бетховен
Dialogue: 0,0:19:51.20,0:19:57.70,Default,,0,0,0,,Соңғы орындалмаған музыка ерклинген!
Dialogue: 0,0:19:58.45,0:20:03.54,Default,,0,0,0,,Барамын, адымдап, Сапарға шыққандай.
Dialogue: 0,0:20:04.45,0:20:07.79,Default,,0,0,0,,Ноталардың бірінен соң бірі тұрақты сабақтастығы
Dialogue: 0,0:20:08.66,0:20:12.33,Default,,0,0,0,,-Менің музыкамның саяхатын аяқтаймыз -Шлаф,
Dialogue: 0,0:20:13.41,0:20:21.50,Default,,0,0,0,,-schlafe, holder süßer Knabe, -Франц Шуберттің бесік жыры
Dialogue: 0,0:20:21.62,0:20:23.04,Default,,0,0,0,,Лирик белгісіз
Dialogue: 0,0:20:23.16,0:20:26.04,Default,,0,0,0,,-Мен қатты жақсы көретін анамды еске алу үшін жасалған деседі... -Уф.
Dialogue: 0,0:20:26.08,0:20:27.16,Default,,0,0,0,,Әй
Dialogue: 0,0:20:27.50,0:20:30.79,Default,,0,0,0,,-УУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУУ NO OH OH OH OH OH OH OH HH
Dialogue: 0,0:20:31.00,0:20:33.37,Default,,0,0,0,,-А -О!
Dialogue: 0,0:20:33.87,0:20:35.83,Default,,0,0,0,,Огияа Огяа
Dialogue: 0,0:20:35.91,0:20:37.08,Default,,0,0,0,,Ой
Dialogue: 0,0:20:37.29,0:20:38.83,Default,,0,0,0,,Мм, апа
Dialogue: 0,0:20:39.00,0:20:43.58,Default,,0,0,0,,Няа хо няа хо няа хиенн
Dialogue: 0,0:20:44.33,0:20:46.75,Default,,0,0,0,,- Сосуке? Сосуке? -Баа Буу
Dialogue: 0,0:20:47.20,0:20:48.54,Default,,0,0,0,,-Талданбайтын -Буууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:20:48.75,0:20:50.95,Default,,0,0,0,,-Сәбиге еліктейтін орта мектеп оқушысы -Бооооооо
Dialogue: 0,0:20:51.08,0:20:53.58,Default,,0,0,0,,Жалпы бұл өте жиіркенішті әрекет деуге болады.
Dialogue: 0,0:20:55.95,0:20:58.04,Default,,0,0,0,,Бетховен аға
Dialogue: 0,0:20:58.66,0:21:01.12,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,0:21:01.16,0:21:06.95,Default,,0,0,0,,-Ха, мен не істеп жатырмын? Міне, тағы да осы жағдайға тап болдық.
Dialogue: 0,0:21:10.33,0:21:13.37,Default,,0,0,0,,Бұл бұрын бірнеше рет болған.
Dialogue: 0,0:21:14.45,0:21:16.00,Default,,0,0,0,,Жоқ, бұл жақсы.
Dialogue: 0,0:21:17.20,0:21:20.79,Default,,0,0,0,,-nmnmai ah ah ah -Бетховен Сенпай
Dialogue: 0,0:21:21.79,0:21:24.58,Default,,0,0,0,,-мммммммммм -Әйтеуір қалжыңдап тұрған сияқтысың.
Dialogue: 0,0:21:27.12,0:21:28.87,Default,,0,0,0,,Ақыры мен сені кездестірдім.
Dialogue: 0,0:21:30.87,0:21:33.20,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:21:33.29,0:21:35.75,Default,,0,0,0,,Аха ахаха хаха хаха
Dialogue: 0,0:21:35.83,0:21:38.00,Default,,0,0,0,,Бето
Dialogue: 0,0:21:38.12,0:21:38.70,Default,,0,0,0,,Китата мырза
Dialogue: 0,0:21:38.79,0:21:43.37,Default,,0,0,0,,Dowaaaaaaaaaaaaaaaaaaaaa
Dialogue: 0,0:21:44.33,0:21:47.20,Default,,0,0,0,,-мммммммммммммм -Чокчантара осындай жерде болды.
Dialogue: 0,0:21:47.87,0:21:51.50,Default,,0,0,0,,-Неге қорқасың? Барлық адамдар махаббатпен байланысты болса да - мм мм мм
Dialogue: 0,0:21:51.83,0:21:53.70,Default,,0,0,0,,Интернетке қосылу жақсырақ
Dialogue: 0,0:21:53.91,0:21:54.33,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:21:54.79,0:21:57.70,Default,,0,0,0,,- Бетховен Сенпаааи - А?
Dialogue: 0,0:21:59.66,0:22:00.87,Default,,0,0,0,,Жақсы ауа-райы
Dialogue: 0,0:22:02.70,0:22:04.54,Default,,0,0,0,,Сіз өте әдемісіз. Хмм…
Dialogue: 0,0:22:04.95,0:22:06.62,Default,,0,0,0,,- Иә? -Ой?
Dialogue: 0,0:22:07.08,0:22:08.20,Default,,0,0,0,,Не болды?
Dialogue: 0,0:22:08.25,0:22:09.25,Default,,0,0,0,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:22:10.00,0:22:11.37,Default,,0,0,0,,Қосулы
Dialogue: 0,0:22:22.66,0:22:24.50,Default,,0,0,0,,Кеше не болды?
Dialogue: 0,0:22:25.12,0:22:27.70,Default,,0,0,0,,Бұл нәрестені айналдыру құбылысы ма?
Dialogue: 0,0:22:27.87,0:22:29.29,Default,,0,0,0,,Бұл қызықты болды.
Dialogue: 0,0:22:29.66,0:22:34.25,Default,,0,0,0,,Ууууууууу фантом дәмі үшін басқаларға сенбе
Dialogue: 0,0:22:34.33,0:22:35.91,Default,,0,0,0,,-Жапония уақыты бүгінге дейін -Өз қолыммен
Dialogue: 0,0:22:36.04,0:22:39.58,Default,,0,0,0,,Шығыс Африкада нәрестенің қайта оралу құбылысы расталды
Dialogue: 0,0:22:39.83,0:22:43.54,Default,,0,0,0,,Неге екені белгісіз, жақын жерден жапондық батпырауық табылды.
Dialogue: 0,0:22:43.79,0:22:45.66,Default,,0,0,0,,-Жергілікті Жапония елшілігінде -Бұл шынымен де біртүрлі оқиға, солай емес пе?
Dialogue: 0,0:22:45.75,0:22:47.54,Default,,0,0,0,,Қазіргі уақытта қарым-қатынас тексерілуде.
Dialogue: 0,0:22:55.45,0:23:07.95,Default,,0,0,0,,Schlafe, schlafe, holder, süßer Knabe,
Dialogue: 0,0:23:08.37,0:23:20.12,Default,,0,0,0,,leise wiegt dich deiner Mutter Hand;
Dialogue: 0,0:23:21.41,0:23:34.37,Default,,0,0,0,,Schlafe, schlafe, in der Flaumen Schoße,
Dialogue: 0,0:23:35.04,0:23:47.16,Default,,0,0,0,,noch umtönt dich lauter Liebeston,
Dialogue: 0,0:23:48.54,0:24:01.91,Default,,0,0,0,,Лили, Роза,
Dialogue: 0,0:24:03.12,0:24:16.75,Default,,0,0,0,,nach dem Schlafe werd’ sie dir zum Lohn.
Dialogue: 0,0:24:19.33,0:24:22.95,Default,,0,0,0,,Терісі, іші, гриль жасауы, илеуі, тәттілігі, ащылығы.
Dialogue: 0,0:24:23.20,0:24:26.70,Default,,0,0,0,,Түптеп келгенде, бұл болмыс па, әлде құрылым ма? Азапталған гений
Dialogue: 0,0:24:26.87,0:24:29.58,Default,,0,0,0,,Қаңғыбас темір адам іздеген Гиозаның жұмбағы
Dialogue: 0,0:24:29.75,0:24:31.91,Default,,0,0,0,,ақыры ашылды
Dialogue: 0,0:24:33.41,0:24:39.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory