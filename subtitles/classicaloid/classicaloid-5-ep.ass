Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.91,0:00:13.00,Default,,0,0,0,,...
Dialogue: 0,0:00:16.16,0:00:16.70,Default,,0,0,0,,На
Dialogue: 0,0:00:19.83,0:00:22.54,Default,,0,0,0,,Енді ше? Уф Гехо
Dialogue: 0,0:00:25.58,0:00:29.66,Default,,0,0,0,,Жоқ, атыс күшін реттеу қиын.
Dialogue: 0,0:00:30.16,0:00:33.04,Default,,0,0,0,,Мен гиоза сияқты асыра сілтеуді қаламаймын.
Dialogue: 0,0:00:33.08,0:00:35.87,Default,,0,0,0,,-Керек емес деп қайта-қайта айттым... -Уау!
Dialogue: 0,0:00:35.95,0:00:37.45,Default,,0,0,0,,Мен білмеймін, білмеймін
Dialogue: 0,0:00:37.79,0:00:39.79,Default,,0,0,0,,Ол жерге қалай жетуге болады?
Dialogue: 0,0:00:40.00,0:00:44.70,Default,,0,0,0,,Жүрегімді дүр сілкіндірген қара-қара үндестікке жақсы
Dialogue: 0,0:00:44.91,0:00:47.25,Default,,0,0,0,,-Уаааааааааааааааааааааааааааааа
Dialogue: 0,0:02:18.16,0:02:21.54,Default,,0,0,0,,Құрметті Бах, әлгі классикалоидтар әлі де бар
Dialogue: 0,0:02:21.62,0:02:23.62,Default,,0,0,0,,Тез арада жинау керек
Dialogue: 0,0:02:23.95,0:02:26.50,Default,,0,0,0,,Musik белсендірілгеніне куә болған дейді.
Dialogue: 0,0:02:26.58,0:02:30.20,Default,,0,0,0,,Бізде де біраз ақпарат бар. Бұл әбігерге айналмас бұрын мүмкіндігінше тезірек.
Dialogue: 0,0:02:30.95,0:02:31.62,Default,,0,0,0,,-Na -Uh
Dialogue: 0,0:02:32.12,0:02:33.04,Default,,0,0,0,,Нақыл сөздер
Dialogue: 0,0:02:33.50,0:02:35.54,Default,,0,0,0,,Мен саған оны жай қалдыр деп жатырмын.
Dialogue: 0,0:02:35.75,0:02:36.50,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:02:36.95,0:02:40.62,Default,,0,0,0,,Allegro Vivace Presto
Dialogue: 0,0:02:41.04,0:02:41.62,Default,,0,0,0,,Жоспар
Dialogue: 0,0:02:41.70,0:02:44.37,Default,,0,0,0,,Сен маған тезірек ол кісіні тауып бер дедің.
Dialogue: 0,0:02:44.58,0:02:46.75,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:02:49.29,0:02:49.75,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:02:54.83,0:02:56.29,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:02:56.66,0:02:58.79,Default,,0,0,0,,Сіз не істеп жатырсыз? Жалғыз барбекю?
Dialogue: 0,0:02:59.00,0:03:02.29,Default,,0,0,0,,Бетоның бұлай еткені таңқаларлық емес.
Dialogue: 0,0:03:02.58,0:03:03.50,Default,,0,0,0,,Джоза тағы да?
Dialogue: 0,0:03:03.75,0:03:06.16,Default,,0,0,0,,Иә, мен сіздің не нәрсеге ерекше көңіл бөлетініңізді білмеймін.
Dialogue: 0,0:03:06.50,0:03:10.08,Default,,0,0,0,,Гиозаға құмар болсаңыз, басқа ештеңеге мән бермейсіз.
Dialogue: 0,0:03:10.79,0:03:11.16,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:03:12.04,0:03:14.00,Default,,0,0,0,,Әкеңе қара.
Dialogue: 0,0:03:14.20,0:03:14.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:15.16,0:03:17.37,Default,,0,0,0,,Әрқашан оқуыңызда болыңыз.
Dialogue: 0,0:03:18.54,0:03:19.25,Default,,0,0,0,,О
Dialogue: 0,0:03:22.87,0:03:24.87,Default,,0,0,0,,Әке, мен тамақтанып алдым.
Dialogue: 0,0:03:26.25,0:03:26.75,Default,,0,0,0,,О
Dialogue: 0,0:03:27.83,0:03:28.62,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:03:30.20,0:03:33.00,Default,,0,0,0,,Сіз керемет дәрігерсіз бе? Әке
Dialogue: 0,0:03:33.50,0:03:36.04,Default,,0,0,0,,Ол біртүрлі болды, бірақ ол өте қызықты адам еді.
Dialogue: 0,0:03:36.12,0:03:37.58,Default,,0,0,0,,-Мүлдем қызық емес -Уф
Dialogue: 0,0:03:38.25,0:03:40.33,Default,,0,0,0,,Бұл зерттеу үшін ме, әлде не үшін екенін білмеймін.
Dialogue: 0,0:03:40.75,0:03:42.45,Default,,0,0,0,,Қарыздарды мұнда және жерде жинақтау
Dialogue: 0,0:03:43.16,0:03:45.37,Default,,0,0,0,,Осының кесірінен анаң қанша қиындық көрді?
Dialogue: 0,0:03:45.79,0:03:46.54,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:03:47.79,0:03:48.16,Default,,0,0,0,,Жарайды…
Dialogue: 0,0:03:48.29,0:03:48.62,Default,,0,0,0,,Хмм
Dialogue: 0,0:03:48.83,0:03:51.95,Default,,0,0,0,,Осыны жеп, өзіңізді жақсы сезініңіз. Сізге ұнады, солай емес пе?
Dialogue: 0,0:03:52.91,0:03:55.95,Default,,0,0,0,,Хмм, мен кішкентай кезімнен тым көп жейтінмін.
Dialogue: 0,0:03:56.00,0:03:56.83,Default,,0,0,0,,Мен одан шаршадым.
Dialogue: 0,0:03:57.50,0:04:00.37,Default,,0,0,0,,Дұрыс, мен оны сатып алудың қиындығына бардым.
Dialogue: 0,0:04:01.25,0:04:03.04,Default,,0,0,0,,Чайко-чан керемет
Dialogue: 0,0:04:03.25,0:04:05.91,Default,,0,0,0,,Мен Бахтың барлық сөздерін түсінемін.
Dialogue: 0,0:04:06.20,0:04:07.79,Default,,0,0,0,,Мен емес
Dialogue: 0,0:04:08.12,0:04:11.95,Default,,0,0,0,,Мен ол адамның жүрегінде не жатқанын да білмеймін.
Dialogue: 0,0:04:12.45,0:04:12.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:13.62,0:04:16.00,Default,,0,0,0,,Бәрі сол адамның айтқанына сай болады.
Dialogue: 0,0:04:16.79,0:04:18.62,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:04:19.08,0:04:20.16,Default,,0,0,0,,Чайко-чан
Dialogue: 0,0:04:20.79,0:04:24.00,Default,,0,0,0,,Егер біз оларды қайтарсақ, олардың шын ниеттерін білетін боламыз.
Dialogue: 0,0:04:24.45,0:04:24.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:26.08,0:04:28.33,Default,,0,0,0,,Құрметпен, Король
Dialogue: 0,0:04:28.37,0:04:29.33,Default,,0,0,0,,Шайнау
Dialogue: 0,0:04:33.91,0:04:38.08,Default,,0,0,0,,Сәлеметсіз бе? Ой, сен қайсысысың?
Dialogue: 0,0:04:38.50,0:04:41.79,Default,,0,0,0,,Мен Киого Отовамен туысқанмын.
Dialogue: 0,0:04:42.29,0:04:43.00,Default,,0,0,0,,Әкенің?
Dialogue: 0,0:04:43.41,0:04:45.54,Default,,0,0,0,,Иә, мен сенің әкеңнен естігім келеді.
Dialogue: 0,0:04:45.62,0:04:47.83,Default,,0,0,0,,Менде бір нәрсе бар, оны қайтарғым келеді.
Dialogue: 0,0:04:48.12,0:04:49.33,Default,,0,0,0,,Ақша?
Dialogue: 0,0:04:50.04,0:04:53.04,Default,,0,0,0,,Кинг деген адам бізге қонаққа келмекші.
Dialogue: 0,0:04:53.16,0:04:55.66,Default,,0,0,0,,Тез арада қайтарыңыз.
Dialogue: 0,0:04:55.87,0:04:58.70,Default,,0,0,0,,Қайтар деп сұрасаң да менде ақша жоқ.
Dialogue: 0,0:04:59.16,0:04:59.58,Default,,0,0,0,,Кім?
Dialogue: 0,0:04:59.87,0:05:02.62,Default,,0,0,0,,Сені құтылу үшін менде қанша қиындық бар?
Dialogue: 0,0:05:02.75,0:05:03.66,Default,,0,0,0,,Әке
Dialogue: 0,0:05:04.25,0:05:05.50,Default,,0,0,0,,Иә yahooi
Dialogue: 0,0:05:05.54,0:05:06.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:06.16,0:05:07.41,Default,,0,0,0,,Ия
Dialogue: 0,0:05:07.45,0:05:09.45,Default,,0,0,0,,Не, не? Көңілді нәрсе ме?
Dialogue: 0,0:05:09.62,0:05:12.16,Default,,0,0,0,,Лу-кунның жаңа тұшпара дайындады.
Dialogue: 0,0:05:12.54,0:05:13.91,Default,,0,0,0,,Мен оны қайтадан жасадым
Dialogue: 0,0:05:14.45,0:05:17.50,Default,,0,0,0,,Бұл жолғы нәтиже өте керемет.
Dialogue: 0,0:05:17.95,0:05:20.91,Default,,0,0,0,,Мен бәріне ерекше қараймын деп ойладым.
Dialogue: 0,0:05:21.45,0:05:22.66,Default,,0,0,0,,Қалай ойлайсың, кішкентай қыз?
Dialogue: 0,0:05:22.95,0:05:24.33,Default,,0,0,0,,Мен аулақпын
Dialogue: 0,0:05:24.70,0:05:27.41,Default,,0,0,0,,Уау, бұл өте жақсы көрінеді.
Dialogue: 0,0:05:27.70,0:05:29.08,Default,,0,0,0,,Эмилияны құтқарғың келеді деп айтқан жоқсың.
Dialogue: 0,0:05:29.37,0:05:29.91,Default,,0,0,0,,Аму
Dialogue: 0,0:05:30.54,0:05:32.95,Default,,0,0,0,,-Менің ең керемет туындым ше? -Хмм хмм
Dialogue: 0,0:05:34.33,0:05:37.54,Default,,0,0,0,,Иә? Уф, лололололороро
Dialogue: 0,0:05:37.62,0:05:38.20,Default,,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:05:38.29,0:05:39.70,Default,,0,0,0,,Бұл не ақымақ?
Dialogue: 0,0:05:39.75,0:05:40.95,Default,,0,0,0,,Минус 20 ұпай
Dialogue: 0,0:05:41.04,0:05:43.20,Default,,0,0,0,,Бұл елестету мүмкін емес жаман.
Dialogue: 0,0:05:43.29,0:05:49.45,Default,,0,0,0,,...
Dialogue: 0,0:05:49.79,0:05:51.16,Default,,0,0,0,,Хун
Dialogue: 0,0:05:53.33,0:05:55.12,Default,,0,0,0,,Ороророророророророро
Dialogue: 0,0:05:55.16,0:05:55.70,Default,,0,0,0,,- Дұрыс па? - Ророророро
Dialogue: 0,0:05:56.00,0:05:58.45,Default,,0,0,0,,-Жер бетінде не бар? Бұл қара ингредиент - Ророророро
Dialogue: 0,0:05:59.12,0:06:02.66,Default,,0,0,0,,Ингредиенттер қалыпты, бірақ пісіру тәсілі жаңашыл.
Dialogue: 0,0:06:03.08,0:06:06.04,Default,,0,0,0,,Алдымен тек ішкі ингредиенттерді бірден пісіріңіз.
Dialogue: 0,0:06:06.37,0:06:07.70,Default,,0,0,0,,Қай жерде қара түсті
Dialogue: 0,0:06:07.87,0:06:10.25,Default,,0,0,0,,Алдын ала пісірілген терісі бар қытырлақ
Dialogue: 0,0:06:10.95,0:06:13.54,Default,,0,0,0,,Бұл жай ғана көмір ингредиенттеріне оралған, солай емес пе?
Dialogue: 0,0:06:13.83,0:06:18.70,Default,,0,0,0,,Бірақ неге ол нәтиже бермейді? Бұл менің тағдырым ба?
Dialogue: 0,0:06:18.87,0:06:21.87,Default,,0,0,0,,Жоқ, ешқашан тағдырдың тауқыметіне салынба.
Dialogue: 0,0:06:21.95,0:06:24.12,Default,,0,0,0,,Мен тағдырға қарсымын
Dialogue: 0,0:06:24.37,0:06:26.66,Default,,0,0,0,,-Тамағыңды қысып алайын -Уф ой-а-а
Dialogue: 0,0:06:26.75,0:06:28.87,Default,,0,0,0,,-Haa Мотивацияңыз бар ма? -Ааа аааа
Dialogue: 0,0:06:28.95,0:06:30.95,Default,,0,0,0,,-Көңілім келгенше істейін -Нунуну
Dialogue: 0,0:06:31.16,0:06:33.12,Default,,0,0,0,,-Лу-кун -Нунуну үшін реактивті қара үндестік
Dialogue: 0,0:06:33.20,0:06:35.12,Default,,0,0,0,,-Бұлар ерекше тұшпара -Нуууу
Dialogue: 0,0:06:35.41,0:06:36.95,Default,,0,0,0,,-Қара үндестігі? -Фунунуну
Dialogue: 0,0:06:37.29,0:06:39.66,Default,,0,0,0,,-Бұл неге екені белгісіз жұмбақ естілмейді -Фунуну
Dialogue: 0,0:06:39.87,0:06:41.58,Default,,0,0,0,,-Толық айтып берші -Фунуну
Dialogue: 0,0:06:41.66,0:06:41.95,Default,,0,0,0,,-Ха -Уау
Dialogue: 0,0:06:43.08,0:06:45.54,Default,,0,0,0,,Жарайды, сырты қытырлақ.
Dialogue: 0,0:06:45.95,0:06:48.33,Default,,0,0,0,,Іші қара және үлпілдек Гёза
Dialogue: 0,0:06:48.70,0:06:51.16,Default,,0,0,0,,Бұл біз іздейтін қара-қара үйлесімділік.
Dialogue: 0,0:06:51.45,0:06:53.41,Default,,0,0,0,,Ішіндегі қара гиоза ше?
Dialogue: 0,0:06:53.50,0:06:54.54,Default,,0,0,0,,Бұл жолы пісіру
Dialogue: 0,0:06:54.62,0:06:57.41,Default,,0,0,0,,Тек ішін қара ету үшін ойлап табылған құпия әдіс
Dialogue: 0,0:06:57.95,0:07:00.62,Default,,0,0,0,,Сол қараны шығару қандай тамаша идея.
Dialogue: 0,0:07:00.66,0:07:01.75,Default,,0,0,0,,Мен жалт қарадым
Dialogue: 0,0:07:02.20,0:07:05.20,Default,,0,0,0,,Сондықтан сіз әртүрлі пісіру әдістерімен тәжірибе жасап көрдіңіз.
Dialogue: 0,0:07:05.62,0:07:09.12,Default,,0,0,0,,Сырт келбеті тамаша қайталанған болса да.
Dialogue: 0,0:07:09.62,0:07:13.58,Default,,0,0,0,,Уау, айырмашылығы неде?
Dialogue: 0,0:07:14.04,0:07:14.66,Default,,0,0,0,,Эй
Dialogue: 0,0:07:15.37,0:07:15.91,Default,,0,0,0,,Не?
Dialogue: 0,0:07:16.45,0:07:18.50,Default,,0,0,0,,Сол тұшпаралардың ішінде не бар?
Dialogue: 0,0:07:19.00,0:07:23.16,Default,,0,0,0,,Мүмкін бастапқы ингредиенттер қара болуы мүмкін бе?
Dialogue: 0,0:07:23.83,0:07:24.62,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:07:29.45,0:07:30.41,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:07:30.75,0:07:32.25,Default,,0,0,0,,- Тезірек - А?
Dialogue: 0,0:07:32.29,0:07:33.37,Default,,0,0,0,,Неге мен?
Dialogue: 0,0:07:33.45,0:07:33.79,Default,,0,0,0,,Ах
Dialogue: 0,0:07:33.83,0:07:35.66,Default,,0,0,0,,Жүк тасымалдаушы хи хи
Dialogue: 0,0:07:36.75,0:07:39.91,Default,,0,0,0,,Сенің арғы жақтан шығатыныңа сенбеймін.
Dialogue: 0,0:07:41.87,0:07:49.04,Default,,0,0,0,,Қара ингредиенттер? Неліктен кенеттен?
Dialogue: 0,0:07:49.66,0:07:50.29,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:50.79,0:07:53.79,Default,,0,0,0,,Мен қара ингредиенттерді зерттеуге тырысқанда, кенеттен өзімді нашар сезіндім.
Dialogue: 0,0:07:54.00,0:07:55.58,Default,,0,0,0,,-Маған бәрібір, маған бәрібір -Болды
Dialogue: 0,0:07:55.75,0:07:57.91,Default,,0,0,0,,Қара түстің бәрін сатып ал
Dialogue: 0,0:07:58.75,0:07:59.20,Default,,0,0,0,,Әй
Dialogue: 0,0:08:00.62,0:08:01.91,Default,,0,0,0,,Ммм
Dialogue: 0,0:08:02.00,0:08:04.87,Default,,0,0,0,,Қара тағамдар таңқаларлық көп.
Dialogue: 0,0:08:05.66,0:08:06.08,Default,,0,0,0,,Тек біз екеуміз ғанамыз. Сондықтан шешімді сен екеуің қабылдаңдар.
Dialogue: 0,0:08:06.37,0:08:08.33,Default,,0,0,0,,Grrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr
Dialogue: 0,0:08:08.37,0:08:12.41,Default,,0,0,0,,-Ол сенің жүзіңде қандай сағыныш бар? Мен оны саған бермеймін. -Грррррррррр
Dialogue: 0,0:08:12.45,0:08:13.54,Default,,0,0,0,,Grrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr.
Dialogue: 0,0:08:13.58,0:08:15.58,Default,,0,0,0,,-Няаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:08:15.70,0:08:19.75,Default,,0,0,0,,Уахахахха мен сенікі нәрсеге қол тигізуге рұқсат бермеймін.
Dialogue: 0,0:08:20.08,0:08:23.12,Default,,0,0,0,,Мен мұның бәрін төледім, солай ма?
Dialogue: 0,0:08:23.20,0:08:25.00,Default,,0,0,0,,Бұл анық. Бұл сізге арналған, солай ма?
Dialogue: 0,0:08:25.41,0:08:26.29,Default,,0,0,0,,Мен үшін?
Dialogue: 0,0:08:27.00,0:08:29.79,Default,,0,0,0,,Сосуке Лукун екеумізге ақша береді
Dialogue: 0,0:08:30.04,0:08:32.91,Default,,0,0,0,,Бұл біздің шығармашылық іс-әрекетімізді жеделдетеді.
Dialogue: 0,0:08:33.12,0:08:35.12,Default,,0,0,0,,Менің қолымнан келген жұмыс стимулға айналады.
Dialogue: 0,0:08:35.37,0:08:39.75,Default,,0,0,0,,Сосукенің шабыты үлкен жарылыс.
Dialogue: 0,0:08:40.12,0:08:41.87,Default,,0,0,0,,Хмм, түсіндім бе?
Dialogue: 0,0:08:42.25,0:08:42.83,Default,,0,0,0,,На
Dialogue: 0,0:08:43.12,0:08:43.75,Default,,0,0,0,,Егеуқұйрық
Dialogue: 0,0:08:44.00,0:08:46.70,Default,,0,0,0,,ше? Күтпеген шабуыл - қорқақ
Dialogue: 0,0:08:46.79,0:08:48.75,Default,,0,0,0,,Не? Бір минут күтіңіз
Dialogue: 0,0:08:56.95,0:08:57.91,Default,,0,0,0,,-Чууу -Хааа
Dialogue: 0,0:08:58.54,0:08:59.20,Default,,0,0,0,,Гохо
Dialogue: 0,0:09:00.41,0:09:02.50,Default,,0,0,0,,Мен енді ілесе алмаймын.
Dialogue: 0,0:09:04.45,0:09:06.50,Default,,0,0,0,,Екеуің де баяусыңдар.
Dialogue: 0,0:09:07.04,0:09:09.29,Default,,0,0,0,,Ингредиенттерді таңдауда қиындықтар туындады ма?
Dialogue: 0,0:09:09.79,0:09:12.54,Default,,0,0,0,,Бетоның өзі кеткені жақсы емес пе еді?
Dialogue: 0,0:09:13.54,0:09:14.41,Default,,0,0,0,,Бұл мүмкін емес, солай ма?
Dialogue: 0,0:09:14.54,0:09:17.75,Default,,0,0,0,,-Олай мұңайма -Ааа аааааа
Dialogue: 0,0:09:17.83,0:09:19.37,Default,,0,0,0,,-Бұл өте таң қалдырды, солай емес пе? -Ааа
Dialogue: 0,0:09:19.70,0:09:21.95,Default,,0,0,0,,Тамақтың өзі қара түсті.
Dialogue: 0,0:09:22.45,0:09:24.58,Default,,0,0,0,,Біраз ойланып қарасаңыз, түсінікті сияқты.
Dialogue: 0,0:09:25.37,0:09:27.50,Default,,0,0,0,,Иә? Ал Чокчан ше?
Dialogue: 0,0:09:28.58,0:09:29.12,Default,,0,0,0,,С… Сол әйел
Dialogue: 0,0:09:37.54,0:09:42.50,Default,,0,0,0,,Күте тұрыңыз, сүйкімді семіз-чан
Dialogue: 0,0:09:43.08,0:09:44.12,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:09:44.29,0:09:45.62,Default,,0,0,0,,Кеш болды
Dialogue: 0,0:09:45.70,0:09:46.66,Default,,0,0,0,,Уау
Dialogue: 0,0:09:46.75,0:09:49.16,Default,,0,0,0,,Тым кеш тым кеш
Dialogue: 0,0:09:49.50,0:09:53.12,Default,,0,0,0,,Жол бойы мен аздап депрессияға ұшырадым.
Dialogue: 0,0:09:53.20,0:09:56.75,Default,,0,0,0,,Азапсыз қуаныш жоқ, Азап күшейеді мені.
Dialogue: 0,0:09:56.91,0:09:59.79,Default,,0,0,0,,Жаңа қуаныш алыңыз
Dialogue: 0,0:09:59.91,0:10:01.12,Default,,0,0,0,,Ауысу жылдам.
Dialogue: 0,0:10:06.16,0:10:10.04,Default,,0,0,0,,Нихихи Сіз білесіз бе? сен сияқты біреу
Dialogue: 0,0:10:10.33,0:10:12.37,Default,,0,0,0,,Оны егеуқұйрықтар қапшығы деп атайды.
Dialogue: 0,0:10:12.70,0:10:14.87,Default,,0,0,0,,Сен қаптағы егеуқұйрықсың.
Dialogue: 0,0:10:15.00,0:10:15.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:17.04,0:10:20.29,Default,,0,0,0,,О, мынаны қара ингредиенттер деп атайсың ба?
Dialogue: 0,0:10:20.79,0:10:24.58,Default,,0,0,0,,Мен оны көремін, мен оны көремін, бұл терең қара ағынның арғы жағында
Dialogue: 0,0:10:24.75,0:10:28.62,Default,,0,0,0,,Әлбетте жарқыраған үміт нұры сені күйдірер
Dialogue: 0,0:10:28.87,0:10:32.50,Default,,0,0,0,,Мен оны бір жағынан пісіріп, піскенше пісіремін.
Dialogue: 0,0:10:32.70,0:10:35.25,Default,,0,0,0,,-Тым болмаса сатып алғаныңызға рахмет -хахахахаха
Dialogue: 0,0:10:35.37,0:10:38.16,Default,,0,0,0,,-Бұл жақсы емес пе, өйткені мен өте қуаныштымын? -Хехехехехехахахаха
Dialogue: 0,0:10:38.50,0:10:40.70,Default,,0,0,0,,- Пункотсу да аздап көмектесті - Хахахахаха
Dialogue: 0,0:10:40.95,0:10:43.41,Default,,0,0,0,,-Өтінемін, ақымақ болуды қояр ма едіңіз? -хахахахахахахаха
Dialogue: 0,0:10:43.50,0:10:46.08,Default,,0,0,0,,-Айтпақшы, Моту-сан ше? -Хахаха хехахахаха
Dialogue: 0,0:10:46.12,0:10:46.58,Default,,0,0,0,,-Аа? -хаха
Dialogue: 0,0:10:47.08,0:10:48.79,Default,,0,0,0,,Ах, тышқанмен тег ойыны.
Dialogue: 0,0:10:49.16,0:10:49.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:50.83,0:10:52.04,Default,,0,0,0,,Жарайсың
Dialogue: 0,0:10:52.62,0:10:53.70,Default,,0,0,0,,Сіздің тінтуіріңіз?
Dialogue: 0,0:10:53.95,0:10:54.95,Default,,0,0,0,,бұл дұрыс
Dialogue: 0,0:10:55.50,0:10:58.54,Default,,0,0,0,,Әлгі бала мен сатып алған нәрсені аузына салып тұр.
Dialogue: 0,0:10:59.00,0:10:59.91,Default,,0,0,0,,Сіз оны қайтара аласыз ба?
Dialogue: 0,0:11:00.50,0:11:03.54,Default,,0,0,0,,Иә, мен оны қайтарғым келеді.
Dialogue: 0,0:11:04.20,0:11:04.70,Default,,0,0,0,,На
Dialogue: 0,0:11:04.91,0:11:06.33,Default,,0,0,0,,Осы жолмен
Dialogue: 0,0:11:06.41,0:11:07.45,Default,,0,0,0,,Иә? не
Dialogue: 0,0:11:07.62,0:11:09.16,Default,,0,0,0,,Сенімен бірге келгенімді қалайсың ба?
Dialogue: 0,0:11:09.20,0:11:12.00,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:11:12.37,0:11:15.16,Default,,0,0,0,,-Менің атым Король -Арғ
Dialogue: 0,0:11:22.58,0:11:25.50,Default,,0,0,0,,Келіңдер, балалар, көбірек әкеліңдер.
Dialogue: 0,0:11:25.91,0:11:27.91,Default,,0,0,0,,Бар құмарлығыммен
Dialogue: 0,0:11:28.08,0:11:30.70,Default,,0,0,0,,Мен пісіріп, пісіріп, пісіремін.
Dialogue: 0,0:11:31.41,0:11:33.91,Default,,0,0,0,,Неге маған көмектесуге мәжбүрлейсің?
Dialogue: 0,0:11:34.25,0:11:36.62,Default,,0,0,0,,Жарайды, бұл мереке, бұл мереке
Dialogue: 0,0:11:37.12,0:11:40.20,Default,,0,0,0,,-Болды, тезірек алыңыз! -Ооооооо
Dialogue: 0,0:11:40.25,0:11:41.95,Default,,0,0,0,,-Сондықтан ыңғайсыз -Ооо
Dialogue: 0,0:11:42.08,0:11:43.41,Default,,0,0,0,,Фейер
Dialogue: 0,0:11:45.62,0:11:46.37,Default,,0,0,0,,О
Dialogue: 0,0:11:49.12,0:11:50.50,Default,,0,0,0,,Мен үшін бұл не?
Dialogue: 0,0:11:50.66,0:11:53.12,Default,,0,0,0,,Сіз тиесілі жерге қайтасыз.
Dialogue: 0,0:11:53.16,0:11:55.29,Default,,0,0,0,,Не айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:11:55.50,0:11:57.00,Default,,0,0,0,,-Қайда қайтып барамын -Уау
Dialogue: 0,0:11:57.45,0:11:58.41,Default,,0,0,0,,Отовакан
Dialogue: 0,0:11:58.70,0:12:01.04,Default,,0,0,0,,Hmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmcc
Dialogue: 0,0:12:01.62,0:12:03.37,Default,,0,0,0,,Менен қашып құтыла алмайсың
Dialogue: 0,0:12:03.83,0:12:04.70,Default,,0,0,0,,Кетіңіз
Dialogue: 0,0:12:05.20,0:12:07.50,Default,,0,0,0,,Енді тыныш кел.
Dialogue: 0,0:12:08.29,0:12:09.70,Default,,0,0,0,,-Няао -Гит
Dialogue: 0,0:12:09.79,0:12:11.70,Default,,0,0,0,,-Няоооо -Ахахахахахахахахахахахахахахахахахаха
Dialogue: 0,0:12:11.79,0:12:14.12,Default,,0,0,0,,-Хаха Дахахаха -Хмм? Ihi
Dialogue: 0,0:12:14.20,0:12:17.00,Default,,0,0,0,,-Фугияаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:12:17.12,0:12:20.37,Default,,0,0,0,,-Хахахаха мен мысықтармен жақсы емеспін -Хааааааааааа
Dialogue: 0,0:12:20.45,0:12:22.25,Default,,0,0,0,,Фугияааааааа
Dialogue: 0,0:12:22.37,0:12:24.12,Default,,0,0,0,,Әй, әйтеуір, шалқалайсың.
Dialogue: 0,0:12:24.20,0:12:26.04,Default,,0,0,0,,-Уаааааааааааааааааааааааааааа
Dialogue: 0,0:12:26.20,0:12:28.95,Default,,0,0,0,,Пуххххххххххххххххххххххххххххххххх
Dialogue: 0,0:12:29.08,0:12:30.70,Default,,0,0,0,,Ха ха аа ха ха
Dialogue: 0,0:12:32.08,0:12:35.29,Default,,0,0,0,,Жоқ Жоқ Жоқ Жоқ
Dialogue: 0,0:12:35.58,0:12:39.50,Default,,0,0,0,,Қара-қара үндестігінің дәмінен алыс
Dialogue: 0,0:12:39.54,0:12:39.87,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:40.41,0:12:41.83,Default,,0,0,0,,Бұл жеткілікті емес пе?
Dialogue: 0,0:12:42.25,0:12:43.12,Default,,0,0,0,,Берілме
Dialogue: 0,0:12:43.33,0:12:43.70,Default,,0,0,0,,О
Dialogue: 0,0:12:44.41,0:12:47.91,Default,,0,0,0,,Ол дәм бар, ол мүлдем бар.
Dialogue: 0,0:12:48.70,0:12:50.12,Default,,0,0,0,,Неге сонша?
Dialogue: 0,0:12:51.00,0:12:55.75,Default,,0,0,0,,Азапты қуанышқа айналдыратын сол дәм.
Dialogue: 0,0:12:56.66,0:13:00.83,Default,,0,0,0,,Ғұн ғұн һұн хун һұн һұн хун
Dialogue: 0,0:13:01.00,0:13:05.62,Default,,0,0,0,,Хун ху хун хун хун хун хун хун хун
Dialogue: 0,0:13:06.62,0:13:10.62,Default,,0,0,0,,Қараңдар, бұл көріністі мәңгілікке қалдырма.
Dialogue: 0,0:13:11.41,0:13:12.66,Default,,0,0,0,,Осыны қолданып көріңіз
Dialogue: 0,0:13:14.62,0:13:17.50,Default,,0,0,0,,Амммм аа
Dialogue: 0,0:13:17.79,0:13:18.41,Default,,0,0,0,,Өлу мен өмір сүру туралы сөйлесу—
Dialogue: 0,0:13:18.50,0:13:21.41,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:13:22.16,0:13:23.04,Default,,0,0,0,,Фуфу
Dialogue: 0,0:13:23.50,0:13:26.16,Default,,0,0,0,,Әкем Бетоға
Dialogue: 0,0:13:27.12,0:13:29.75,Default,,0,0,0,,Сіз өзіңіздің естеліктеріңіздің дәмін жаңғыртқыңыз келді.
Dialogue: 0,0:13:30.08,0:13:32.08,Default,,0,0,0,,Маған тезірек айтып берсеңіз
Dialogue: 0,0:13:32.45,0:13:34.33,Default,,0,0,0,,Өйткені менен ештеңе сұраған жоқ.
Dialogue: 0,0:13:34.58,0:13:35.66,Default,,0,0,0,,Қазір
Dialogue: 0,0:13:35.91,0:13:38.70,Default,,0,0,0,,Қалай болғанда да, мен әрқашан сол дәмге жетемін.
Dialogue: 0,0:13:39.00,0:13:40.66,Default,,0,0,0,,-Жаңа қуаныш бар ма? -Ааааааааааааааааааааа
Dialogue: 0,0:13:41.00,0:13:44.20,Default,,0,0,0,,Мм, мынаны же.
Dialogue: 0,0:13:44.50,0:13:45.33,Default,,0,0,0,,Чокчан?
Dialogue: 0,0:13:45.70,0:13:47.91,Default,,0,0,0,,-Неге Шопен мырзада тұшпара болды? -Ааа аааа
Dialogue: 0,0:13:48.37,0:13:50.20,Default,,0,0,0,,Хмм? Аму
Dialogue: 0,0:13:51.66,0:13:55.20,Default,,0,0,0,,Ммм.
Dialogue: 0,0:13:55.33,0:13:57.50,Default,,0,0,0,,- Қымбаттым, бұл дәмді қайдан алуға болады?
Dialogue: 0,0:13:57.54,0:13:59.62,Default,,0,0,0,,-Тоқта, не істеп жатырсың? -Фунунну
Dialogue: 0,0:13:59.79,0:14:00.25,Default,,0,0,0,,-га -н
Dialogue: 0,0:14:01.37,0:14:03.45,Default,,0,0,0,,Бұл Анко ма?
Dialogue: 0,0:14:03.91,0:14:04.83,Default,,0,0,0,,Анко
Dialogue: 0,0:14:04.95,0:14:08.20,Default,,0,0,0,,-Хмф Чоччан -Мм, анау Анко, анау, анау.
Dialogue: 0,0:14:08.29,0:14:10.00,Default,,0,0,0,,-Ішіндегі қара тұшпара. -мм, мм, мм.
Dialogue: 0,0:14:10.08,0:14:12.04,Default,,0,0,0,,-Интернеттен қарағаныңызды естідім. -Мм.
Dialogue: 0,0:14:12.41,0:14:15.41,Default,,0,0,0,,ішінде қытырлақ пісірілген қабықтың ішіне қызыл бұршақ пастасын салыңыз.
Dialogue: 0,0:14:15.62,0:14:18.41,Default,,0,0,0,,Мен сізді ерекше тәттілерге арналған парақшаға келгеніңізді естідім.
Dialogue: 0,0:14:19.08,0:14:20.70,Default,,0,0,0,,-мммммм тәтті -аммммм
Dialogue: 0,0:14:20.91,0:14:23.00,Default,,0,0,0,,Аа, бұл солай.
Dialogue: 0,0:14:23.16,0:14:23.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:23.87,0:14:26.04,Default,,0,0,0,,Міне, анау, анау есіңізде жоқ.
Dialogue: 0,0:14:26.50,0:14:27.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:27.25,0:14:29.12,Default,,0,0,0,,Иә, кішкентай кезімізде
Dialogue: 0,0:14:29.62,0:14:32.62,Default,,0,0,0,,Әкем маған көрші балалармен бірге осылай жасады.
Dialogue: 0,0:14:33.04,0:14:34.08,Default,,0,0,0,,Тәтті
Dialogue: 0,0:14:34.20,0:14:35.45,Default,,0,0,0,,Неліктен онда қызыл бұршақ пастасы бар?
Dialogue: 0,0:14:35.50,0:14:36.70,Default,,0,0,0,,Біртүрлі дәм
Dialogue: 0,0:14:36.83,0:14:39.20,Default,,0,0,0,,Ахахаха ахахаха
Dialogue: 0,0:14:39.54,0:14:40.25,Default,,0,0,0,,О
Dialogue: 0,0:14:40.91,0:14:43.70,Default,,0,0,0,,Бұл гиозаның дәмі сол кездегі дәмге ұқсамайды ма?
Dialogue: 0,0:14:43.91,0:14:45.29,Default,,0,0,0,,-Жақсы жұмыс -мммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:14:45.45,0:14:48.37,Default,,0,0,0,,-Сенің арқаңда Бето азаптан құтылады. -Ммммммммм
Dialogue: 0,0:14:48.62,0:14:49.25,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:14:49.41,0:14:49.79,Default,,0,0,0,,- Иә? -иә?
Dialogue: 0,0:14:50.16,0:14:53.12,Default,,0,0,0,,Бұл реактивті қара гармонияның дәміне жақын екені сөзсіз.
Dialogue: 0,0:14:53.70,0:14:56.70,Default,,0,0,0,,маңызды нәрсе жетіспейді
Dialogue: 0,0:14:57.91,0:15:00.75,Default,,0,0,0,,Бұл тәтті және ащы
Dialogue: 0,0:15:01.91,0:15:03.83,Default,,0,0,0,,Тәтті ме, ащы ма?
Dialogue: 0,0:15:05.41,0:15:06.25,Default,,0,0,0,,Га
Dialogue: 0,0:15:06.45,0:15:09.54,Default,,0,0,0,,Ахахахаха Ахахахха
Dialogue: 0,0:15:09.58,0:15:11.29,Default,,0,0,0,,Нфффффффф
Dialogue: 0,0:15:12.00,0:15:13.83,Default,,0,0,0,,- Сосуке Бұл қайда? -Хмм
Dialogue: 0,0:15:13.91,0:15:14.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:14.62,0:15:16.75,Default,,0,0,0,,-Бұл таңғы Хаманоя -Хмм.
Dialogue: 0,0:15:16.91,0:15:20.00,Default,,0,0,0,,О, ой, қайда қойдыңыз?
Dialogue: 0,0:15:20.08,0:15:22.33,Default,,0,0,0,,-Тез тауып, маған әкел -Уау, жақсы!
Dialogue: 0,0:15:22.41,0:15:23.45,Default,,0,0,0,,Иә
Dialogue: 0,0:15:24.00,0:15:27.45,Default,,0,0,0,,-Не болды қызым, бірдеңе ойлап таптың ба? -Күрсін
Dialogue: 0,0:15:27.70,0:15:29.16,Default,,0,0,0,,(Кёко) Ах…
Dialogue: 0,0:15:29.41,0:15:32.04,Default,,0,0,0,,Ой, үйге кешігіп келдің.
Dialogue: 0,0:15:32.20,0:15:33.62,Default,,0,0,0,,Жоқ, жоқ, солай.
Dialogue: 0,0:15:33.66,0:15:35.50,Default,,0,0,0,,-Шарап па?
Dialogue: 0,0:15:35.70,0:15:38.16,Default,,0,0,0,,Хаха, керексіз нәрселерді айтпа.
Dialogue: 0,0:15:38.54,0:15:40.20,Default,,0,0,0,,Менің билетім туралы
Dialogue: 0,0:15:40.62,0:15:41.79,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:15:42.50,0:15:44.75,Default,,0,0,0,,Мен Патшамын
Dialogue: 0,0:15:45.20,0:15:46.33,Default,,0,0,0,,Король?
Dialogue: 0,0:15:46.50,0:15:48.83,Default,,0,0,0,,-Puffufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufu fufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufu fufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufu fufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufu бүгін таңертең телефоннан сізден?
Dialogue: 0,0:15:49.08,0:15:51.29,Default,,0,0,0,,Дәл
Dialogue: 0,0:15:51.37,0:15:53.83,Default,,0,0,0,,Егер бұлай болатын болса, мен мұнда басынан келуім керек еді.
Dialogue: 0,0:15:53.91,0:15:56.83,Default,,0,0,0,,Мен де әкемнің қарызға алған ақшасына өкінемін.
Dialogue: 0,0:15:57.12,0:16:00.45,Default,,0,0,0,,Мен сізге дәл қазір өтей алмаймын. Менде шынымен ақша жоқ.
Dialogue: 0,0:16:00.79,0:16:04.91,Default,,0,0,0,,Ақша? Менің қайтарғым келетіні - Classicaloid.
Dialogue: 0,0:16:05.66,0:16:07.00,Default,,0,0,0,,Классикалоид?
Dialogue: 0,0:16:07.79,0:16:09.29,Default,,0,0,0,,Мүмкін сіз
Dialogue: 0,0:16:09.58,0:16:12.50,Default,,0,0,0,,Иә, өйткені балалар алаңсыз ойнайсыңдар.
Dialogue: 0,0:16:12.75,0:16:14.20,Default,,0,0,0,,Мен келдім де жасадым.
Dialogue: 0,0:16:14.66,0:16:17.16,Default,,0,0,0,,Себебі мен мұнда өзімді жайлы сезінемін.
Dialogue: 0,0:16:17.45,0:16:17.91,Default,,0,0,0,,Иә
Dialogue: 0,0:16:18.70,0:16:23.33,Default,,0,0,0,,Олар таң қалды. Лорд Чайко, бізге көмектесіңізші.
Dialogue: 0,0:16:29.25,0:16:32.08,Default,,0,0,0,,пусть музыка принесет
Dialogue: 0,0:16:32.50,0:16:35.50,Default,,0,0,0,,всем счастье.
Dialogue: 0,0:16:37.79,0:16:38.91,Default,,0,0,0,,Басталып жатыр!
Dialogue: 0,0:16:39.04,0:16:43.95,Default,,0,0,0,,Бұл жай ғана арман болса
Dialogue: 0,0:16:44.50,0:16:45.95,Default,,0,0,0,,-Дәл сол жерде -Ол қайдан шықты?
Dialogue: 0,0:16:46.00,0:16:50.00,Default,,0,0,0,,-Мен сені жібермеймін -Екеуіңді қайтаруға келді.
Dialogue: 0,0:16:50.12,0:16:51.37,Default,,0,0,0,,Какари
Dialogue: 0,0:16:51.58,0:16:52.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:52.37,0:16:52.87,Default,,0,0,0,,Nu
Dialogue: 0,0:16:54.04,0:16:54.62,Default,,0,0,0,,О
Dialogue: 0,0:16:55.41,0:16:58.12,Default,,0,0,0,,Әй, біз де тиіспейміз.
Dialogue: 0,0:16:58.20,0:17:00.04,Default,,0,0,0,,Шынымен бе!? Иә
Dialogue: 0,0:17:00.16,0:17:02.62,Default,,0,0,0,,Фугияаааа, ол жұмыс істемейді.
Dialogue: 0,0:17:02.95,0:17:04.20,Default,,0,0,0,,Иә, бұл тітіркендіргіш.
Dialogue: 0,0:17:04.37,0:17:07.04,Default,,0,0,0,,Реактивті қара гармонияның сыры осында дерлік
Dialogue: 0,0:17:07.16,0:17:09.00,Default,,0,0,0,,Біз сонда жетеміз
Dialogue: 0,0:17:09.33,0:17:11.20,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:11.37,0:17:13.91,Default,,0,0,0,,Адамдарды ұрлаңыз, асығыңыз және барлығын құтқарыңыз!
Dialogue: 0,0:17:14.16,0:17:15.08,Default,,0,0,0,,Бұл өтірік, солай ма?
Dialogue: 0,0:17:16.08,0:17:16.91,Default,,0,0,0,,Атта
Dialogue: 0,0:17:17.04,0:17:20.25,Default,,0,0,0,,Әкесінің сыры.
Dialogue: 0,0:17:20.50,0:17:25.70,Default,,0,0,0,,Не? Фуууууууууууууууууууууу
Dialogue: 0,0:17:27.58,0:17:28.37,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:17:34.33,0:17:37.29,Default,,0,0,0,,Сол гёзаның сыры осында
Dialogue: 0,0:17:39.20,0:17:41.20,Default,,0,0,0,,Аму ах
Dialogue: 0,0:17:42.54,0:17:43.45,Default,,0,0,0,,Бето
Dialogue: 0,0:17:44.54,0:17:49.54,Default,,0,0,0,,Менің іздегенім осы еді.
Dialogue: 0,0:17:50.37,0:17:53.83,Default,,0,0,0,,Дехехехехаха толып жатыр
Dialogue: 0,0:17:54.00,0:17:58.50,Default,,0,0,0,,Жүрегімде жасырылған әуен тасып төгіледі
Dialogue: 0,0:17:58.91,0:18:04.12,Default,,0,0,0,,Музыканы тыңдау.
Dialogue: 0,0:18:08.66,0:18:09.12,Default,,0,0,0,,Хмм
Dialogue: 0,0:18:25.33,0:18:30.33,Default,,0,0,0,,- Пайдасы жоқ. Король абсолютті. Оның күшіне ешкім қарсы тұра алмайды - Маған қарсы шыққандар.
Dialogue: 0,0:18:31.12,0:18:34.25,Default,,0,0,0,,- Король абсолютті ме? Хун - Түс! және ұят
Dialogue: 0,0:18:34.91,0:18:36.45,Default,,0,0,0,,Му-кунның музыкасы
Dialogue: 0,0:18:36.66,0:18:39.75,Default,,0,0,0,,Фортепианоға арналған №5 концерт
Dialogue: 0,0:18:40.29,0:18:43.33,Default,,0,0,0,,«Император» ретінде де белгілі
Dialogue: 0,0:18:43.87,0:18:46.54,Default,,0,0,0,,Жақсы, егер сіз патша болсаңыз
Dialogue: 0,0:18:47.00,0:18:50.45,Default,,0,0,0,,Мен патшаларды басқаратын императормын.
Dialogue: 0,0:18:51.79,0:18:54.79,Default,,0,0,0,,Барлық билік әділ
Dialogue: 0,0:18:54.95,0:18:58.83,Default,,0,0,0,,Менің құдіретіме тағзым ету сен үшін.
Dialogue: 0,0:18:59.29,0:19:05.66,Default,,0,0,0,,Император терең көзқараспен ескертеді.
Dialogue: 0,0:19:06.20,0:19:12.95,Default,,0,0,0,,Зұлым патшаларға тектілік
Dialogue: 0,0:19:13.12,0:19:19.16,Default,,0,0,0,,-Жеңілгенін мойындау -Бұл императордың билігі
Dialogue: 0,0:19:19.45,0:19:22.04,Default,,0,0,0,,Гухаахияхаккккккккккккккккккккккккккккккккккккккккккккккккккккккк
Dialogue: 0,0:19:25.45,0:19:29.41,Default,,0,0,0,,А, о, о, өтінемін, ұлы мәртебелі император, мені кешіріңіз.
Dialogue: 0,0:19:29.50,0:19:30.95,Default,,0,0,0,,Хм. Хахахаха
Dialogue: 0,0:19:31.62,0:19:35.29,Default,,0,0,0,,Күш-қуатымның алдында бас иеді.
Dialogue: 0,0:19:35.54,0:19:38.50,Default,,0,0,0,,Бұл тағдыр
Dialogue: 0,0:19:41.75,0:19:43.00,Default,,0,0,0,,Габа Габа
Dialogue: 0,0:19:47.20,0:19:49.29,Default,,0,0,0,,Чууды алыңыз
Dialogue: 0,0:19:58.41,0:20:00.79,Default,,0,0,0,,Аяқталған
Dialogue: 0,0:20:11.79,0:20:13.58,Default,,0,0,0,,Музыка бұзылған
Dialogue: 0,0:20:13.70,0:20:16.00,Default,,0,0,0,,Ли Чайко-чанның күші?
Dialogue: 0,0:20:16.91,0:20:18.04,Default,,0,0,0,,Күріш крекерін көтеру
Dialogue: 0,0:20:19.25,0:20:22.50,Default,,0,0,0,,Біз олардың күшін бағаламауымыз керек пе?
Dialogue: 0,0:20:26.20,0:20:29.58,Default,,0,0,0,,Әлгі адам мені тағы да құтқарды.
Dialogue: 0,0:20:37.20,0:20:42.04,Default,,0,0,0,,Келіңіздер, көңіліңіз қалағандай ағынды-қара үйлесімділіктен ләззат алыңыз.
Dialogue: 0,0:20:43.08,0:20:45.33,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:20:45.41,0:20:48.00,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:20:48.50,0:20:51.00,Default,,0,0,0,,Тәтті ме, ащы ма?
Dialogue: 0,0:20:51.75,0:20:53.83,Default,,0,0,0,,Хаманоядан Мисо Манжу
Dialogue: 0,0:20:54.50,0:20:57.66,Default,,0,0,0,,Мен Утанаенің сүйікті тағамы гиозаның құпия ингредиенті екеніне сене алмаймын.
Dialogue: 0,0:20:58.00,0:20:59.66,Default,,0,0,0,,Ал, құпия ингредиент.
Dialogue: 0,0:21:00.00,0:21:02.08,Default,,0,0,0,,Бұл ингредиент негізінен мисо манжу болып табылады.
Dialogue: 0,0:21:02.70,0:21:04.54,Default,,0,0,0,,Папа Утана неліктен мұндай?
Dialogue: 0,0:21:04.58,0:21:06.16,Default,,0,0,0,,Оны тұшпараға салып қойған шығар.
Dialogue: 0,0:21:06.70,0:21:09.83,Default,,0,0,0,,Бұл адамның өмір жолы.
Dialogue: 0,0:21:10.70,0:21:11.83,Default,,0,0,0,,Және біз екеуміздің біреуіміз сиқырды іске қосқаннан кейін—
Dialogue: 0,0:21:12.04,0:21:13.58,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:21:13.87,0:21:17.33,Default,,0,0,0,,...
Dialogue: 0,0:21:18.04,0:21:20.70,Default,,0,0,0,,Иә, бұл бет – менмін.
Dialogue: 0,0:21:20.95,0:21:25.87,Default,,0,0,0,,Мен жасаған нәрседен біреу ләззат алса, мен бақыттымын.
Dialogue: 0,0:21:26.00,0:21:27.95,Default,,0,0,0,,-Ахахахахахахаха -Ах
Dialogue: 0,0:21:28.04,0:21:30.70,Default,,0,0,0,,-Хахахахахаха -Қара ағынды үйлесімділік
Dialogue: 0,0:21:31.50,0:21:34.58,Default,,0,0,0,,Оң мен солды ажырата алмағанымда нұр сыйладың
Dialogue: 0,0:21:35.08,0:21:37.33,Default,,0,0,0,,Бұл шынымен де тағдырдың туындысы.
Dialogue: 0,0:21:38.45,0:21:40.25,Default,,0,0,0,,Бұл махаббат, мен сенімдімін
Dialogue: 0,0:21:40.58,0:21:42.62,Default,,0,0,0,,Иә
Dialogue: 0,0:21:44.33,0:21:46.54,Default,,0,0,0,,Ахахахахаха Ахахахахаха
Dialogue: 0,0:21:46.75,0:21:48.95,Default,,0,0,0,,Эххехехехе ахахха
Dialogue: 0,0:21:49.04,0:21:52.50,Default,,0,0,0,,-Ахахахахаха Ахахахахха -Уххххххххххххххххххх
Dialogue: 0,0:21:52.79,0:21:54.45,Default,,0,0,0,,- Сізге ұнады ма? -хахахахахахахахаха
Dialogue: 0,0:21:54.58,0:21:57.25,Default,,0,0,0,,-Хаа Ухух -Ах хаха Эхехехехе
Dialogue: 0,0:21:59.70,0:22:00.29,Default,,0,0,0,,Егер өзіңді жақсы ұстасаң, мен саған зиян тигізбеймін.
Dialogue: 0,0:22:01.33,0:22:03.95,Default,,0,0,0,,-Бірақ бұл бір үлгі, Утанайдың әкесі де.
Dialogue: 0,0:22:04.33,0:22:07.66,Default,,0,0,0,,Той дегенде ойыма осы тұшпара ғана келетін шығар.
Dialogue: 0,0:22:07.95,0:22:08.54,Default,,0,0,0,,Қасқыр
Dialogue: 0,0:22:08.66,0:22:09.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:09.33,0:22:12.33,Default,,0,0,0,,Неліктен сіз әрқашан жақсы әңгімелерді айтасыз?
Dialogue: 0,0:22:12.75,0:22:14.79,Default,,0,0,0,,Бірақ бірінші кезекте, Classicaloid
Dialogue: 0,0:22:14.87,0:22:17.16,Default,,0,0,0,,Мен сені гёзаны тамақтандыруға тырысамын.
Dialogue: 0,0:22:17.33,0:22:18.58,Default,,0,0,0,,Әй, сәл күте тұрыңыз.
Dialogue: 0,0:22:18.66,0:22:19.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:19.45,0:22:21.87,Default,,0,0,0,,Классика бла бұл не?
Dialogue: 0,0:22:22.62,0:22:24.87,Default,,0,0,0,,Күндізгі адамдар да солай айтты.
Dialogue: 0,0:22:25.45,0:22:26.91,Default,,0,0,0,,Сен мұны айтпадың ба?
Dialogue: 0,0:22:27.50,0:22:31.29,Default,,0,0,0,,Классикалоидтар - біз.
Dialogue: 0,0:22:32.12,0:22:34.41,Default,,0,0,0,,Классика Ллойд?
Dialogue: 0,0:22:35.00,0:22:35.50,Default,,0,0,0,,Иә
Dialogue: 0,0:22:35.54,0:22:35.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:35.91,0:22:40.16,Default,,0,0,0,,Ал оларды жаратқан менмін.
Dialogue: 0,0:22:40.54,0:22:41.54,Default,,0,0,0,,Әке?
Dialogue: 0,0:23:00.20,0:23:04.00,Default,,0,0,0,,Маған қарсы шыққандар
Dialogue: 0,0:23:04.08,0:23:07.50,Default,,0,0,0,,Түсіңіз! және ұят
Dialogue: 0,0:23:07.79,0:23:13.50,Default,,0,0,0,,Мақтануға мың жыл әлі ерте.
Dialogue: 0,0:23:15.95,0:23:22.20,Default,,0,0,0,,Бейшара арық егеуқұйрығы
Dialogue: 0,0:23:22.54,0:23:25.08,Default,,0,0,0,,Қараңдар! әлем
Dialogue: 0,0:23:25.16,0:23:28.08,Default,,0,0,0,,Барлық билік әділ
Dialogue: 0,0:23:28.25,0:23:32.16,Default,,0,0,0,,Менің құдіретіме тағзым ету сен үшін.
Dialogue: 0,0:23:32.25,0:23:39.16,Default,,0,0,0,,Император терең көзқараспен ескертеді.
Dialogue: 0,0:23:39.41,0:23:46.20,Default,,0,0,0,,Зұлым патшаларға тектілік
Dialogue: 0,0:23:46.50,0:23:53.58,Default,,0,0,0,,Жеңілісті мойындау
Dialogue: 0,0:23:53.95,0:23:59.66,Default,,0,0,0,,Бұл да батылдық
Dialogue: 0,0:24:16.62,0:24:19.62,Default,,0,0,0,,Ұлы Бах былай дейді: Жоспар – Поко а Поко
Dialogue: 0,0:24:20.00,0:24:22.33,Default,,0,0,0,,Орындау - Сфорзандо Адажио
Dialogue: 0,0:24:22.54,0:24:25.00,Default,,0,0,0,,Іздегенім – тұңғиық пен кеңдік
Dialogue: 0,0:24:25.04,0:24:26.91,Default,,0,0,0,,Гран Грандиосу
Dialogue: 0,0:24:27.08,0:24:29.25,Default,,0,0,0,,Ах, классикалоид қауіп төніп тұр.
Dialogue: 0,0:24:29.79,0:24:31.58,Default,,0,0,0,,Түсінгеніңізге рахмет.
Dialogue: 0,0:24:33.08,0:24:39.08,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory