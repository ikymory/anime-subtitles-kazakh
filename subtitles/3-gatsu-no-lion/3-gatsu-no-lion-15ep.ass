Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.12,0:00:15.21,OP,,0,0,0,,Өзеннің жағасында келе жатқан пойыздың дыбысы
Dialogue: 0,0:00:15.21,0:00:18.08,OP,,0,0,0,,Төменге қарап гүлдеген күнбағыстың түсі
Dialogue: 0,0:00:18.08,0:00:21.71,OP,,0,0,0,,Күннің батуы жолақты жиекке айналады
Dialogue: 0,0:00:23.93,0:00:30.72,OP,,0,0,0,,«Рахмет» деген сайын неге жылағым келеді?
Dialogue: 0,0:00:30.72,0:00:33.39,OP,,0,0,0,,Мен бала сияқтымын
Dialogue: 0,0:00:33.39,0:00:41.68,OP,,0,0,0,,Мен барлық көз жасымды тоңазытқышта қалдырдым деп ойладым
Dialogue: 0,0:00:41.68,0:00:46.54,OP,,0,0,0,,Қызыл ровер, қызыл ровер, сол қызды дәл жанына жібер
Dialogue: 0,0:00:46.91,0:00:49.59,OP,,0,0,0,,Қош бол, көруші
Dialogue: 0,0:00:49.59,0:00:52.29,OP,,0,0,0,,Біз жүре береміз
Dialogue: 0,0:00:52.29,0:00:59.72,OP,,0,0,0,,Бұл жолдың соңында аспан немесе басқа нәрсе болмаса да
Dialogue: 0,0:00:59.72,0:01:04.11,OP,,0,0,0,,Мен тек сенімен бірге болып, бірге күлкім келеді
Dialogue: 0,0:01:04.11,0:01:08.47,OP,,0,0,0,,Мақтаныш, тілек және үміт
Dialogue: 0,0:01:08.47,0:01:11.60,OP,,0,0,0,,Менде сіз сияқты олар әрқашан болады
Dialogue: 0,0:01:11.60,0:01:17.52,OP,,0,0,0,,Сіз қорқып, қатты қорқып, депрессияға түскенде
Dialogue: 0,0:01:17.52,0:01:23.45,OP,,0,0,0,,Мен сені қорғаймын, Мен сені әрқашан қолымда бар нәрсемен қорғаймын
Dialogue: 0,0:01:23.45,0:01:26.24,OP,,0,0,0,,Мен саған жүзіңе сөз беремін
Dialogue: 0,0:01:32.41,0:01:35.50,titles,,0,0,0,,Ай сәулесі
Dialogue: 0,0:01:49.54,0:01:50.38,Default-ja,,0,0,0,,Ах
Dialogue: 5,0:02:22.14,0:02:23.34,Default,,0,0,0,,Маған тиіспе.
Dialogue: 0,0:02:22.16,0:02:23.24,Default-ja,,0,0,0,,Маған тиіспе
Dialogue: 0,0:02:29.08,0:02:30.59,Default-ja,,0,0,0,,Бірақ мені тастап кетпе
Dialogue: 5,0:02:29.10,0:02:30.68,Default,,0,0,0,,Бірақ менен алыстама.
Dialogue: 5,0:02:35.43,0:02:38.99,Default,,0,0,0,,Кьюко жарылған стақан тәрізді болды.
Dialogue: 0,0:02:35.46,0:02:38.93,Default-ja,,0,0,0,,Коко шыны жарылғандай қыз еді.
Dialogue: 0,0:02:42.35,0:02:46.81,Default-ja,,0,0,0,,Қанша су құйсаң да, ол ешқашан толмайды.
Dialogue: 5,0:02:42.46,0:02:46.78,Default,,0,0,0,,Оған қанша су құйсаң да, ол ешқашан толтырылмас еді.
Dialogue: 5,0:02:47.43,0:02:53.69,Default,,0,0,0,,Оның жанұясы бар, сыртқы келбеті бар, айналасындағы адамдарды басқара алатын күшке ие.
Dialogue: 0,0:02:47.44,0:02:50.19,Default-ja,,0,0,0,,Менің отбасым бар, көрікті адаммын.
Dialogue: 0,0:02:50.31,0:02:53.61,Default-ja,,0,0,0,,Олардың айналасындағы адамдарды басқаруға күші бар болса да.
Dialogue: 5,0:02:54.61,0:02:55.70,Default,,0,0,0,,Дегенмен,
Dialogue: 0,0:02:54.61,0:02:55.53,Default-ja,,0,0,0,,Әлі-
Dialogue: 5,0:02:56.60,0:03:01.21,Default,,0,0,0,,үнемі аштықтан өлетін жануар сияқты, жалғыздық оның жүрегін жеді.
Dialogue: 0,0:02:56.61,0:02:58.70,Default-ja,,0,0,0,,Әрқашан аш аң сияқты
Dialogue: 0,0:02:59.24,0:03:01.20,Default-ja,,0,0,0,,Жалғыздық мені жеп қойды
Dialogue: 0,0:03:03.20,0:03:04.16,Default-ja,,0,0,0,,Және…
Dialogue: 5,0:03:03.25,0:03:08.71,Default,,0,0,0,,Ал оның әйнегіне сол жарықшақтарды салғандар...
Dialogue: 0,0:03:05.20,0:03:08.62,Default-ja,,0,0,0,,Ешкім әйнекті жарған жоқ —
Dialogue: 5,0:03:12.59,0:03:14.22,Default,,0,0,0,,асырап алған әкем...
Dialogue: 0,0:03:12.67,0:03:16.13,Default-ja,,0,0,0,,Менің әкем және... бұл мен болатынмын.
Dialogue: 5,0:03:15.19,0:03:16.35,Default,,0,0,0,,және мен.
Dialogue: 5,0:03:22.59,0:03:23.86,Default,,0,0,0,,Мен үйден кетіп бара жатырмын.
Dialogue: 0,0:03:22.64,0:03:23.80,Default-ja,,0,0,0,,Мен үйден кетіп бара жатырмын
Dialogue: 0,0:03:24.85,0:03:26.31,Default-ja,,0,0,0,,Маған ол адам ұнайды
Dialogue: 5,0:03:24.89,0:03:26.36,Default,,0,0,0,,Мен оған ғашықпын.
Dialogue: 5,0:03:27.93,0:03:29.65,Default,,0,0,0,,Ол жігіт жақсы емес.
Dialogue: 0,0:03:27.98,0:03:31.10,Default-ja,,0,0,0,,No, he has a wife.
Dialogue: 5,0:03:29.65,0:03:31.11,Default,,0,0,0,,Оның әйелі бар.
Dialogue: 0,0:03:31.40,0:03:33.27,Default-ja,,0,0,0,,Мен ауруханада көп болдым.
Dialogue: 5,0:03:31.42,0:03:33.37,Default,,0,0,0,,Ол ауруханада мәңгі болды.
Dialogue: 0,0:03:33.73,0:03:36.82,Default-ja,,0,0,0,,Ол әрқашан жалғыз болды.
Dialogue: 5,0:03:33.75,0:03:36.74,Default,,0,0,0,,Ол осы уақыт бойы жалғыз болды.
Dialogue: 0,0:03:37.15,0:03:38.82,Default-ja,,0,0,0,,Әкем рұқсат бермейді.
Dialogue: 5,0:03:37.17,0:03:38.83,Default,,0,0,0,,Әкем сені осылай істесең кешірмейді.
Dialogue: 0,0:03:39.11,0:03:40.53,Default-ja,,0,0,0,,Бұл не?
Dialogue: 5,0:03:39.12,0:03:40.58,Default,,0,0,0,,Сонда не?
Dialogue: 5,0:03:44.00,0:03:46.63,Default,,0,0,0,,Мен де оны кешірмеймін.
Dialogue: 0,0:03:44.08,0:03:46.79,Default-ja,,0,0,0,,Оған жол бермеу үшін де солай.
Dialogue: 5,0:03:46.98,0:03:48.13,Default,,0,0,0,,Мен ұмытқан жоқпын.
Dialogue: 0,0:03:46.99,0:03:48.25,Default-ja,,0,0,0,,Мен ұмытпаймын
Dialogue: 5,0:03:48.74,0:03:53.13,Default,,0,0,0,,Ол сегізінші сынып оқушысы болған кезде өз қызын сәтсіздікке ұшыратты.
Dialogue: 0,0:03:48.79,0:03:50.16,Default-ja,,0,0,0,,Небәрі 2-курста оқитын қызыма.
Dialogue: 0,0:03:50.25,0:03:53.04,Default-ja,,0,0,0,,Мен сені өмірдегі сәтсіздік деп атадым.
Dialogue: 0,0:03:57.09,0:04:00.01,Default-ja,,0,0,0,,«Шогиден басқа өмір бар»
Dialogue: 5,0:03:57.10,0:04:02.77,Default,,0,0,0,,«Өмірде шоғидан басқа да нәрселер бар» деп, тіпті айтпағанда да айтты.
Dialogue: 0,0:04:00.42,0:04:02.39,Default-ja,,0,0,0,,Ойыңызда жоқ нәрселерді айту
Dialogue: 5,0:04:03.33,0:04:05.11,Default,,0,0,0,,Бірақ бұл шындық.
Dialogue: 0,0:04:03.51,0:04:04.97,Default-ja,,0,0,0,,Бұл дұрыс
Dialogue: 5,0:04:05.11,0:04:06.90,Default,,0,0,0,,Шоги бәрі емес.
Dialogue: 0,0:04:05.18,0:04:06.89,Default-ja,,0,0,0,,Шоги бәрі емес
Dialogue: 0,0:04:07.64,0:04:09.02,Default-ja,,0,0,0,,Өтірік айтпа.
Dialogue: 5,0:04:07.77,0:04:09.03,Default,,0,0,0,,Маған өтірік айтпа!
Dialogue: 5,0:04:10.36,0:04:14.11,Default,,0,0,0,,Әкең екеуіңді ойлайтын жалғыз нәрсе Шоги.
Dialogue: 0,0:04:10.43,0:04:14.02,Default-ja,,0,0,0,,Әкең екеуің ойлайтын жалғыз нәрсе Шоги.
Dialogue: 0,0:04:14.77,0:04:16.40,Default-ja,,0,0,0,,Мен жеткілікті болдым
Dialogue: 5,0:04:14.79,0:04:16.24,Default,,0,0,0,,Мен жеткілікті болдым.
Dialogue: 5,0:04:17.37,0:04:21.45,Default,,0,0,0,,Екеуің де маған жеңілген адамдай қарайсыңдар.
Dialogue: 0,0:04:17.40,0:04:19.19,Default-ja,,0,0,0,,Мен туралы—
Dialogue: 0,0:04:19.36,0:04:21.45,Default-ja,,0,0,0,,Маған жеңілген адам қарағандай қара
Dialogue: 5,0:04:22.71,0:04:25.33,Default,,0,0,0,,Аяқтың ұшымен айналасың.
Dialogue: 0,0:04:22.95,0:04:25.24,Default-ja,,0,0,0,,Қайнауды ұстағандай емдеңіз.
Dialogue: 5,0:04:28.34,0:04:29.96,Default,,0,0,0,,Бұл ашуландырады.
Dialogue: 0,0:04:28.45,0:04:29.91,Default-ja,,0,0,0,,Бұл көңілсіз.
Dialogue: 5,0:04:30.77,0:04:33.22,Default,,0,0,0,,Маған қанша уақыт керек...
Dialogue: 0,0:04:30.83,0:04:33.29,Default-ja,,0,0,0,,Мен қашанға дейін осылай боламын...
Dialogue: 5,0:04:34.72,0:04:37.22,Default,,0,0,0,,Сіз бұл аянышты сезінесіз бе?
Dialogue: 0,0:04:34.88,0:04:37.34,Default-ja,,0,0,0,,Өзін бақытсыз сезіну дұрыс па?
Dialogue: 5,0:04:41.57,0:04:42.98,Default,,0,0,0,,Мен кетемін.
Dialogue: 0,0:04:41.59,0:04:42.88,Default-ja,,0,0,0,,Мен кетемін.
Dialogue: 5,0:04:44.60,0:04:48.73,Default,,0,0,0,,Қайда барсам да мені ешкім уайымдамайды.
Dialogue: 0,0:04:44.68,0:04:48.68,Default-ja,,0,0,0,,Қайда барсам да, алаңдайтын адам жоқ.
Dialogue: 5,0:04:49.55,0:04:51.36,Default,,0,0,0,,Бірақ сізде бәрі басқаша, әпке.
Dialogue: 0,0:04:49.60,0:04:51.10,Default-ja,,0,0,0,,Бірақ менің әпкем басқаша.
Dialogue: 5,0:04:52.11,0:04:53.74,Default,,0,0,0,,Сіз әке үшін маңыздысыз...
Dialogue: 0,0:04:52.14,0:04:53.89,Default-ja,,0,0,0,,Әкем әпкем туралы айтты...
Dialogue: 5,0:04:57.01,0:04:59.32,Default,,0,0,0,,сіз басқаша ойласаңыз да.
Dialogue: 0,0:04:57.06,0:04:59.32,Default-ja,,0,0,0,,Бұл маңызды емес деп айтуға болмайды, солай ма?
Dialogue: 5,0:05:06.81,0:05:09.21,Default,,0,0,0,,Сондықтан тәжірибелі гид болғаны дұрыс.
Dialogue: 0,0:05:06.82,0:05:09.16,Default-ja,,0,0,0,,Менің қалағаным осы...
Dialogue: 5,0:05:09.21,0:05:10.50,Default,,0,0,0,,10:00
Dialogue: 0,0:05:09.29,0:05:10.37,Default-ja,,0,0,0,,10.00.
Dialogue: 5,0:05:11.14,0:05:12.88,Default,,0,0,0,,Матч басталып жатыр.
Dialogue: 0,0:05:11.16,0:05:12.50,Default-ja,,0,0,0,,Ойын басталады
Dialogue: 0,0:05:13.25,0:05:17.04,Default-ja,,0,0,0,,Lion King Challenger анықтау турнирінің финалы
Dialogue: 5,0:05:13.28,0:05:17.01,Default,,0,0,0,,Арыстан патша атағы үшін үміткерді анықтау үшін турнирдің финалы.
Dialogue: 5,0:05:17.52,0:05:19.30,Default,,0,0,0,,Үштің бірінші сәйкестігі.
Dialogue: 0,0:05:17.59,0:05:19.42,Default-ja,,0,0,0,,Үшінші матчтың бірінші матчы
Dialogue: 0,0:05:20.21,0:05:22.30,Default-ja,,0,0,0,,Қазір арнайы ойын бөлмесінде—
Dialogue: 5,0:05:20.22,0:05:22.31,Default,,0,0,0,,Дәл қазір, арнайы матч бөлмесінде,
Dialogue: 5,0:05:23.12,0:05:27.23,Default,,0,0,0,,бұл екеуі бір-біріне үнсіз қарап тұр.
Dialogue: 0,0:05:23.13,0:05:27.09,Default-ja,,0,0,0,,Әлгі екі адам бір-біріне үнсіз қарап тұр.
Dialogue: 5,0:05:33.73,0:05:36.32,Default,,0,0,0,,Бұл қандай жекпе-жек болады деп ойлаймын.
Dialogue: 0,0:05:33.77,0:05:36.15,Default-ja,,0,0,0,,Бұл қандай шайқас болады?
Dialogue: 5,0:05:38.42,0:05:43.42,Default,,0,0,0,,Мен Шимадаға қарсы ойнаған кезде мені біртүрлі сезім биледі.
Dialogue: 0,0:05:38.52,0:05:40.94,Default-ja,,0,0,0,,Мен Шимада мырзамен ойнап жүргенімде...
Dialogue: 0,0:05:41.36,0:05:43.40,Default-ja,,0,0,0,,Мені біртүрлі сезім биледі.
Dialogue: 5,0:05:44.71,0:05:47.04,Default,,0,0,0,,Мен ағаштар теңізіне қадам басқандай болдым.
Dialogue: 0,0:05:44.74,0:05:47.24,Default-ja,,0,0,0,,Ағаштар теңізіне қадам басқандай.
Dialogue: 5,0:05:47.58,0:05:51.59,Default,,0,0,0,,Күшті бір нәрсеге ілінгендей болдым.
Dialogue: 0,0:05:47.62,0:05:51.49,Default-ja,,0,0,0,,Мен басым бірдеңенің шырмауына түскендей болдым.
Dialogue: 5,0:05:52.24,0:05:56.17,Default,,0,0,0,,Мені бірдеңе үнсіз қысып тұрғандай.
Dialogue: 0,0:05:52.24,0:05:55.87,Default-ja,,0,0,0,,Тыныш тартқандай дыбыс жоқ.
Dialogue: 5,0:05:57.06,0:06:01.10,Default,,0,0,0,,Готуға қарсы қандай стратегия қолданады?
Dialogue: 0,0:05:57.08,0:06:01.05,Default-ja,,0,0,0,,Готоға қарсы қандай шайқас болады?
Dialogue: 0,0:06:01.85,0:06:03.47,signs,,0,0,0,,Факультет кабинеті
Dialogue: 1,0:06:01.85,0:06:03.47,signs,,0,0,0,,Факультет кабинеті
Dialogue: 5,0:06:04.54,0:06:07.23,Default,,0,0,0,,Хаяшида мырза, менде наурыз айында жұмысқа келмейтіндігі туралы хабарламалар бар.
Dialogue: 0,0:06:04.55,0:06:07.22,Default-ja,,0,0,0,,Мұғалім: Наурызға келмегеніңізді хабарлаңыз...
Dialogue: 5,0:06:07.64,0:06:09.10,Default,,0,0,0,,О, Кирияма.
Dialogue: 0,0:06:07.68,0:06:09.05,Default-ja,,0,0,0,,Ах Кирияма
Dialogue: 5,0:06:09.10,0:06:10.98,Default,,0,0,0,,Мынаны қараңыз. Бұл керемет.
Dialogue: 0,0:06:09.26,0:06:10.97,Default-ja,,0,0,0,,Қараңызшы, бұл таңқаларлық
Dialogue: 5,0:06:12.63,0:06:14.86,Default,,0,0,0,,Екі сағат болды, олар дәл осы жерде.
Dialogue: 0,0:06:12.64,0:06:14.81,Default-ja,,0,0,0,,Ойынға екі сағат қалды, міне осы.
Dialogue: 0,0:06:15.60,0:06:17.48,Default-ja,,0,0,0,,Мен... саусағымды есіктің арасына қыстырып алдым.
Dialogue: 5,0:06:15.64,0:06:17.74,Default,,0,0,0,,Оден дайын.
Dialogue: 5,0:06:19.69,0:06:21.82,Default,,0,0,0,,Осы уақытқа дейін орындалған қозғалыстарға қарап,
Dialogue: 0,0:06:19.69,0:06:21.98,Default-ja,,0,0,0,,Осы нүктеге дейінгі бірнеше қадамға қарап...
Dialogue: 0,0:06:22.23,0:06:24.19,Default-ja,,0,0,0,,Ауыр сүйектер бір-бірімен соқтығысады
Dialogue: 5,0:06:22.24,0:06:27.50,Default,,0,0,0,,ауыр сүйектердің бір-бірімен соқтығысқан күңгірт дыбысын естігендей болдым.
Dialogue: 0,0:06:25.36,0:06:27.45,Default-ja,,0,0,0,,Мен күңгірт дыбыс естідім деп ойладым.
Dialogue: 5,0:06:27.96,0:06:31.17,Default,,0,0,0,,Сол екі салтанатты жігіт бір-бірімен қалай ойнайды екен деп ойладым.
Dialogue: 0,0:06:28.07,0:06:31.12,Default-ja,,0,0,0,,Мен өзінің беріктігімен танымал екі адам қалай шығады деп ойладым...
Dialogue: 5,0:06:31.17,0:06:33.63,Default,,0,0,0,,Бірақ бұл слагфестке ұқсайды.
Dialogue: 0,0:06:31.45,0:06:33.79,Default-ja,,0,0,0,,Жұдырықтай ұрысқандай болды.
Dialogue: 5,0:06:33.91,0:06:35.50,Default,,0,0,0,,Адам, бұл ақылсыз.
Dialogue: 0,0:06:33.95,0:06:35.83,Default-ja,,0,0,0,,Жоқ, келе жатыр.
Dialogue: 0,0:06:43.05,0:06:44.21,Default-ja,,0,0,0,,Бара аласыз ба?
Dialogue: 5,0:06:43.06,0:06:44.14,Default,,0,0,0,,Неге бармайсың?
Dialogue: 0,0:06:45.09,0:06:47.30,Default-ja,,0,0,0,,О... не? Қайда?
Dialogue: 5,0:06:45.64,0:06:47.35,Default,,0,0,0,,Иә? Қайда бару?
Dialogue: 5,0:06:47.35,0:06:49.01,Default,,0,0,0,,Шоги залы.
Dialogue: 0,0:06:47.38,0:06:48.55,Default-ja,,0,0,0,,Шоги залы
Dialogue: 5,0:06:49.01,0:06:50.06,Default,,0,0,0,,Мен сенің жаныңа дүрлігіп бара жатырмын, дірілдеп
Dialogue: 0,0:06:49.14,0:06:49.97,Default-ja,,0,0,0,,А, бірақ
Dialogue: 0,0:06:50.05,0:06:53.72,Default-ja,,0,0,0,,Бұл блог тақырып сәйкес келмейтіндіктен үнемі жаңартылмайды.
Dialogue: 5,0:06:50.06,0:06:53.90,Default,,0,0,0,,Бұл тақырып сәйкес емес, сондықтан бұл блог тұрақты емес жаңартылып отырады.
Dialogue: 5,0:06:53.90,0:06:57.15,Default,,0,0,0,,Егер сіз оны тікелей қарасаңыз, бұл жақсы оқу тәжірибесі болмай ма?
Dialogue: 0,0:06:54.18,0:06:57.14,Default-ja,,0,0,0,,Тікелей барсаңыз, тәрбиелік мәні зор емес пе?
Dialogue: 5,0:06:57.85,0:07:00.03,Default,,0,0,0,,Бірақ менде өте көп келмейтіндер бар...
Dialogue: 0,0:06:58.10,0:07:00.02,Default-ja,,0,0,0,,Бірақ келген күндер саны...
Dialogue: 0,0:07:01.98,0:07:02.90,Default-ja,,0,0,0,,Ита
Dialogue: 5,0:07:02.12,0:07:02.70,Default,,0,0,0,,Ой!
Dialogue: 5,0:07:04.20,0:07:05.58,Default,,0,0,0,,Жақсы! Жәй жүр!
Dialogue: 0,0:07:04.23,0:07:05.48,Default-ja,,0,0,0,,Жүр!
