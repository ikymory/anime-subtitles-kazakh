Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Cece ikiko T·A·O
Dialogue: 0,0:00:12.28,0:00:13.24,Default,,0,0,0,,Мен бірінші барамын.
Dialogue: 0,0:00:13.24,0:00:14.38,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:00:15.06,0:00:16.67,Default,,0,0,0,,Мен бір нәрсені ұмытып қалдым
Dialogue: 0,0:00:16.76,0:00:17.89,Default,,0,0,0,,Түскі ас қорабы
Dialogue: 0,0:00:18.53,0:00:19.96,Default,,0,0,0,,Бүгінгі мәзір
Dialogue: 0,0:00:19.96,0:00:21.85,Default,,0,0,0,,Бұл омлет күріш.
Dialogue: 0,0:00:22.35,0:00:23.84,Default,,0,0,0,,Ято ондай Қасиетті Құралды неге сақтап жүр?
Dialogue: 0,0:00:24.09,0:00:26.57,Default,,0,0,0,,Ах, рахмет. Сіз де кешікпеңіз.
Dialogue: 0,0:00:26.57,0:00:28.24,Default,,0,0,0,,Иә.
Dialogue: 0,0:00:38.81,0:00:44.89,Default,,0,0,0,,Дүние күйреп, бітеді
Dialogue: 0,0:00:44.89,0:00:54.69,Default,,0,0,0,,Мейірімсіз айтыңыз
Dialogue: 0,0:00:54.69,0:01:07.37,Default,,0,0,0,,Өзіңіз не тыңдадыңыз?
Dialogue: 0,0:01:07.37,0:01:20.55,Default,,0,0,0,,Мен алыстағы түс көрдім
Dialogue: 0,0:01:20.55,0:01:23.60,Default,,0,0,0,,Нені таңдау керек және неден бас тарту керек
Dialogue: 0,0:01:23.60,0:01:26.92,Default,,0,0,0,,Мен кіммін, шешуге тырысамын?
Dialogue: 0,0:01:26.92,0:01:30.15,Default,,0,0,0,,Мен не таңдайтынымды шешіп қойдым.
Dialogue: 0,0:01:30.15,0:01:33.14,Default,,0,0,0,,Қателік бар ма, Құдайдан сұра
Dialogue: 0,0:01:33.14,0:01:35.99,Default,,0,0,0,,Мен жалғыз емес едім.
Dialogue: 0,0:01:35.99,0:01:38.77,Default,,0,0,0,,Мен әрқашан сенің жаныңда болдым
Dialogue: 0,0:01:38.77,0:01:45.72,Default,,0,0,0,,Мына қолды созыңыз
Dialogue: 0,0:01:45.72,0:01:49.04,Default,,0,0,0,,Қорқатын ештеңе жоқ
Dialogue: 0,0:01:49.04,0:02:00.93,Default,,0,0,0,,Құбыжық болып кетсем де, мен оны орындаймын.
Dialogue: 0,0:02:03.36,0:02:04.42,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:02:05.36,0:02:07.08,Default,,0,0,0,,Біздің мектепке қош келдіңіз
Dialogue: 0,0:02:15.97,0:02:18.96,Default,,0,0,0,,Мұндағы студенттердің барлығында ерекше қабілет бар ма?
Dialogue: 0,0:02:18.96,0:02:21.56,Default,,0,0,0,,Жоқ, мұндай мүмкіндігі барлар.
Dialogue: 0,0:02:21.56,0:02:23.06,Default,,0,0,0,,Белгілерді көре алатындар
Dialogue: 0,0:02:23.16,0:02:25.14,Default,,0,0,0,,Мұндай студенттер көп.
Dialogue: 0,0:02:25.31,0:02:27.35,Default,,0,0,0,,Бірақ бұл менің трансферім үшін жеткіліксіз.
Dialogue: 0,0:02:27.53,0:02:32.00,Default,,0,0,0,,Бұрын біз сияқты ерекше қабілеті бар адамдар
Dialogue: 0,0:02:32.17,0:02:35.66,Default,,0,0,0,,Олардың барлығын неврологтар теңіз шошқалары ретінде пайдаланған.
Dialogue: 0,0:02:36.06,0:02:38.60,Default,,0,0,0,,Бір рет ұсталсаң, өмірің бітеді.
Dialogue: 0,0:02:39.28,0:02:40.95,Default,,0,0,0,,Бұл өте асыра сілтеу.
Dialogue: 0,0:02:41.82,0:02:43.91,Default,,0,0,0,,Бұл менің ағам туралы.
Dialogue: 0,0:02:45.89,0:02:50.61,Default,,0,0,0,,Белгілі бір адам қабілеті бар адамдарды қорғау үшін қазіргі жүйені жасаған.
Dialogue: 0,0:02:51.24,0:02:53.16,Default,,0,0,0,,Менің ағам уақытында үлгермеді.
Dialogue: 0,0:02:53.24,0:02:55.49,Default,,0,0,0,,Бірақ сіз мені студенттер кеңесіне енгіздіңіз
Dialogue: 0,0:02:55.64,0:02:57.68,Default,,0,0,0,,Мен саған сол күшті пайдалан деп айтпадым ба?
Dialogue: 0,0:02:57.68,0:03:00.95,Default,,0,0,0,,Тек студенттік кеңеске арнайы миссия жүктеледі.
Dialogue: 0,0:03:01.11,0:03:04.18,Default,,0,0,0,,Сен сияқты табиғатта қалған қабілеті бар адам
Dialogue: 0,0:03:04.18,0:03:06.60,Default,,0,0,0,,Сіз оны бірінші болып қорғап, қорғайсыз ба?
Dialogue: 0,0:03:07.08,0:03:09.23,Default,,0,0,0,,Біреуді күш қолданбаймын деп қорқыту
Dialogue: 0,0:03:09.23,0:03:11.04,Default,,0,0,0,,Неліктен мен мұны істедім?
Dialogue: 0,0:03:11.13,0:03:14.19,Default,,0,0,0,,Оның орнына сіз тиісті жәрдемақы аласыз.
Dialogue: 0,0:03:14.39,0:03:16.32,Default,,0,0,0,,Менің тамаққа ақшам жетпейді.
Dialogue: 0,0:03:16.43,0:03:20.25,Default,,0,0,0,,Аюми-чан күн сайын өзіне тамақ дайындауға барынша тырысып жатқан жоқ па?
Dialogue: 0,0:03:23.66,0:03:26.26,Default,,0,0,0,,Бұл Юу Отосака.
Dialogue: 0,0:03:26.60,0:03:28.36,Default,,0,0,0,,Мен Хиномори орта мектебінен келдім
Dialogue: 0,0:03:29.02,0:03:30.32,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:03:31.56,0:03:33.76,Default,,0,0,0,,Әдемі
Dialogue: 0,0:03:48.36,0:03:51.93,Default,,0,0,0,,Эй, ол бірінші курс студенті және студенттік кеңестің президенті ме?
Dialogue: 0,0:03:51.93,0:03:52.60,Default,,0,0,0,,Иә
Dialogue: 0,0:03:52.87,0:03:56.35,Default,,0,0,0,,Бұл мектептің студенттік кеңесінің төрағасының сынып деңгейіне еш қатысы жоқ.
Dialogue: 0,0:03:56.76,0:04:00.88,Default,,0,0,0,,Жауапкершілікті сезіну және құзыретті тұлға ретінде әрекет ету қабілеті бірінші орынға қойылады.
Dialogue: 0,0:04:03.00,0:04:04.13,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:04:04.13,0:04:05.14,Default,,0,0,0,,Біз қай жерде тамақтануымыз керек?
Dialogue: 0,0:04:07.23,0:04:10.12,Default,,0,0,0,,Ол кешегі кешкі аспен толығымен сәйкес келеді.
Dialogue: 0,0:04:10.12,0:04:12.91,Default,,0,0,0,,Түскі асқа не бар, Отосака мырза?
Dialogue: 0,0:04:12.91,0:04:15.18,Default,,0,0,0,,Жоқ, ештеңе.
Dialogue: 0,0:04:15.30,0:04:17.77,Default,,0,0,0,,Енді мектеп асханасына бірге барайық.
Dialogue: 0,0:04:17.99,0:04:19.04,Default,,0,0,0,,Мен саған жол көрсетемін
Dialogue: 0,0:04:19.10,0:04:20.56,Default,,0,0,0,,Бұл көмектеседі.
Dialogue: 0,0:04:22.59,0:04:24.23,Default,,0,0,0,,Ол сені шақырмайды ма?
Dialogue: 0,0:04:24.41,0:04:27.07,Default,,0,0,0,,Қаласаңыз, сізді шақыруға қарсы емеспін.
Dialogue: 0,0:04:27.80,0:04:29.72,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:04:32.32,0:04:34.32,Default,,0,0,0,,Бос үстелдер жоқ сияқты.
Dialogue: 0,0:04:35.04,0:04:38.60,Default,,0,0,0,,Сэндвич сатып алып, сабаққа қайтамыз ба?
Dialogue: 0,0:04:38.60,0:04:41.52,Default,,0,0,0,,А, жоқ, ол жақта да толып жатыр.
Dialogue: 0,0:04:41.52,0:04:43.20,Default,,0,0,0,,Мұны маған қалдырыңыз.
Dialogue: 0,0:04:43.46,0:04:45.51,Default,,0,0,0,,Бұл жерде мен өз қабілеттерімді көрсете аламын.
Dialogue: 0,0:04:45.51,0:04:47.40,Default,,0,0,0,,Жарайды ма? Оны қолданыңыз.
Dialogue: 0,0:04:47.50,0:04:48.74,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:04:48.94,0:04:51.12,Default,,0,0,0,,Камераның соқыр нүктесінен көздеңіз, сондықтан
Dialogue: 0,0:04:51.44,0:04:57.40,Default,,0,0,0,,Дегенмен әлі ерте, сондықтан қандай нан алатыныңыз өз бақытыңызға байланысты.
Dialogue: 0,0:05:24.75,0:05:25.94,Default,,0,0,0,,Қазір бұл не?
Dialogue: 0,0:05:25.94,0:05:26.93,Default,,0,0,0,,Жарылыс
Dialogue: 0,0:05:27.12,0:05:28.53,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:05:30.61,0:05:33.24,Default,,0,0,0,,Ей, бүгін үлкен егін.
Dialogue: 0,0:05:33.24,0:05:34.53,Default,,0,0,0,,Бұл котлеттен жасалған сэндвич.
Dialogue: 0,0:05:34.90,0:05:36.49,Default,,0,0,0,,Бұл сәтті ме?
Dialogue: 0,0:05:36.49,0:05:37.78,Default,,0,0,0,,Осылайша тыртықтармен жабылған
Dialogue: 0,0:05:38.58,0:05:42.84,Default,,0,0,0,,Ешқандай терең сызаттар жоқ, өйткені ол киімінің астында қорғаныс киімін киген.
Dialogue: 0,0:05:43.64,0:05:45.70,Default,,0,0,0,,Басыңнан қан шығып жатыр.
Dialogue: 0,0:05:46.52,0:05:50.22,Default,,0,0,0,,Сіз сыртқы түріңізге қарамастан қауіпті адамсыз.
Dialogue: 0,0:05:50.44,0:05:51.79,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:05:52.42,0:05:54.95,Default,,0,0,0,,Менің ойымша, тек котлет сэндвичі бар.
Dialogue: 0,0:05:55.06,0:05:59.36,Default,,0,0,0,,Бұл лезде қозғалыс. Тіпті заттарды тексеруге уақытыңыз болса да.
Dialogue: 0,0:05:59.46,0:06:01.77,Default,,0,0,0,,Және олардың барлығы жойылды.
Dialogue: 0,0:06:01.77,0:06:09.03,Default,,0,0,0,,Бұл лезде қозғалыс. Қалай ойлайсыз, өнімді ұстайтын күшті арттыру немесе азайту мүмкін бе?
Dialogue: 0,0:06:09.03,0:06:11.42,Default,,0,0,0,,Бұл әлі толық емес қабілет.
Dialogue: 0,0:06:13.64,0:06:15.98,Default,,0,0,0,,Оның әйел достары жоқ па?
Dialogue: 0,0:06:15.98,0:06:17.59,Default,,0,0,0,,Мен студенттік кеңестің президенті болсам да
Dialogue: 0,0:06:17.90,0:06:22.23,Default,,0,0,0,,Оның қабілеттері белгілі бір адамға ғана көрінбейді.
Dialogue: 0,0:06:22.71,0:06:25.98,Default,,0,0,0,,​​Керісінше, басқа адамдар оны көре алады.
Dialogue: 0,0:06:26.40,0:06:29.87,Default,,0,0,0,,Сол жетілмегендік қазіргі жағдайға әкеліп соқтырса керек.
Dialogue: 0,0:06:31.12,0:06:33.21,Default,,0,0,0,,Жақсы себептер бар болса да
Dialogue: 0,0:06:33.33,0:06:38.03,Default,,0,0,0,,Егер оның айналасындағы адамдар оның күштерін зорлық-зомбылық жасау үшін пайдаланып жатқанын көрсе.
Dialogue: 0,0:06:38.33,0:06:39.52,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:06:40.40,0:06:44.06,Default,,0,0,0,,Оның үстіне ол бақылау камерасында тек төбелес сияқты көрінеді.
Dialogue: 0,0:06:44.81,0:06:49.00,Default,,0,0,0,,Егер сіз осылай жасай берсеңіз, сізді жек көруіңіз табиғи нәрсе.
Dialogue: 0,0:06:50.67,0:06:55.50,Default,,0,0,0,,Бірақ ол орта мектепте оқып жүргенге дейін ондай мінезге ие болмаған сияқты.
Dialogue: 0,0:06:55.98,0:06:58.28,Default,,0,0,0,,Ой, мен осында келе жатырмын.
Dialogue: 0,0:06:59.35,0:07:01.32,Default,,0,0,0,,Серіктес пайда болады
Dialogue: 0,0:07:01.40,0:07:02.52,Default,,0,0,0,,Не болып жатыр өзі?
Dialogue: 0,0:07:02.52,0:07:05.12,Default,,0,0,0,,Біз студенттер кеңесінің бөлмесінде кездесеміз.
Dialogue: 0,0:07:05.12,0:07:07.41,Default,,0,0,0,,Е, енді түсіндің бе?
Dialogue: 0,0:07:23.48,0:07:26.19,Default,,0,0,0,,Жер бетінде не басталады?
Dialogue: 0,0:07:33.68,0:07:35.01,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:07:45.92,0:07:48.28,Default,,0,0,0,,Міне, дәл осы жерде!
Dialogue: 0,0:07:52.31,0:07:53.13,Default,,0,0,0,,Мен сені жібермеймін
Dialogue: 0,0:07:53.63,0:07:58.03,Default,,0,0,0,,Ерекше қабілеті бар адамдардың орналасқан жерін және олардың қабілеттерін айтып беретін кооператор.
Dialogue: 0,0:07:58.17,0:08:01.22,Default,,0,0,0,,Нанба орта мектебі: Бұзылу?
Dialogue: 0,0:08:01.77,0:08:02.87,Default,,0,0,0,,Мен ерте кетемін.
Dialogue: 0,0:08:02.87,0:08:03.84,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:04.28,0:08:06.15,Default,,0,0,0,,Тергеуге шешім қабылданды.
Dialogue: 0,0:08:06.38,0:08:07.98,Default,,0,0,0,,Тіпті полиция да емес
Dialogue: 0,0:08:08.33,0:08:11.08,Default,,0,0,0,,Егер полиция оны бізден бұрын тапса.
Dialogue: 0,0:08:11.38,0:08:13.42,Default,,0,0,0,,Ол кісінің өмірі бітті.
Dialogue: 0,0:08:14.16,0:08:15.72,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:08:16.93,0:08:18.51,Default,,0,0,0,,Сұхбаттың басталуы
Dialogue: 0,0:08:18.51,0:08:19.04,Default,,0,0,0,,Иә
Dialogue: 0,0:08:20.68,0:08:22.20,Default,,0,0,0,,Біз де бастайық
Dialogue: 0,0:08:22.72,0:08:24.33,Default,,0,0,0,,Не істеуім керек?
Dialogue: 0,0:08:24.64,0:08:28.33,Default,,0,0,0,,Негізінде, соңғы кездері оғаш оқиғалар болып жатқан жоқ па?
Dialogue: 0,0:08:28.73,0:08:31.33,Default,,0,0,0,,Сонымен қатар, ол телефото мүмкіндігі ретінде анықталды.
Dialogue: 0,0:08:31.44,0:08:35.32,Default,,0,0,0,,Фотоның айналасында қауесеттер бар ма деп сұраған дұрыс болар еді.
Dialogue: 0,0:08:34.96,0:08:36.07,Default,,0,0,0,,Иә, рахмет.
Dialogue: 0,0:08:36.69,0:08:37.36,Default,,0,0,0,,Сонымен
Dialogue: 0,0:08:38.42,0:08:39.88,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:08:40.26,0:08:42.77,Default,,0,0,0,,Олар жай ғана жынды адамдар емес пе?
Dialogue: 0,0:08:48.16,0:08:49.98,Default,,0,0,0,,Біртүрлі мінез танытқан бір жігіт болды.
Dialogue: 0,0:08:50.28,0:08:53.16,Default,,0,0,0,,Жүкті тасымалдау және іздеу үшін күшіңізді пайдаланыңыз.
Dialogue: 0,0:08:53.36,0:08:54.58,Default,,0,0,0,,Не үшін?
Dialogue: 0,0:08:54.88,0:08:56.90,Default,,0,0,0,,Ерекше қабілеті бар адамдарды қорғау
Dialogue: 0,0:09:02.39,0:09:04.07,Default,,0,0,0,,Жарайды, бұл кім?
Dialogue: 0,0:09:04.07,0:09:07.35,Default,,0,0,0,,Боқ, менің уақытымды босқа өткізбе. Сіз оны жоғалттыңыз.
Dialogue: 0,0:09:11.26,0:09:11.96,Default,,0,0,0,,болды
Dialogue: 0,0:09:12.33,0:09:13.14,Default,,0,0,0,,Бұл ол.
Dialogue: 0,0:09:16.47,0:09:17.48,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:09:17.68,0:09:20.28,Default,,0,0,0,,Ей, мен мұны неге істеп жатырмын?
Dialogue: 0,0:09:35.31,0:09:37.48,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:37.81,0:09:39.32,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:09:39.32,0:09:41.55,Default,,0,0,0,,Осы мектептегі оқушы қыздардың суреті
Dialogue: 0,0:09:41.55,0:09:43.14,Default,,0,0,0,,Сіз әдемі адамсыз.
Dialogue: 0,0:09:43.14,0:09:47.07,Default,,0,0,0,,Келесі кезекте әйелдер іш киімі?
Dialogue: 0,0:09:47.16,0:09:50.72,Default,,0,0,0,,Бұл психикалық фотосурет пе? Оны көмектесуге болмайтын нәрсе үшін пайдаланбаңыз.
Dialogue: 0,0:09:52.35,0:09:54.24,Default,,0,0,0,,Бұл суретті сіз түсірдіңіз бе?
Dialogue: 0,0:09:54.24,0:09:55.92,Default,,0,0,0,,Жоқ, мен оны сатып алдым.
Dialogue: 0,0:09:55.92,0:09:57.64,Default,,0,0,0,,Оны кімнен сатып алдың?
Dialogue: 0,0:09:59.16,0:10:03.01,Default,,0,0,0,,Мен бұл мәселені үшінші тарапқа жарияламаймын.
Dialogue: 0,0:10:03.27,0:10:05.36,Default,,0,0,0,,Маған тек шындықты айтыңызшы
Dialogue: 0,0:10:05.89,0:10:07.34,Default,,0,0,0,,Маған сенің айтуың керек.
Dialogue: 0,0:10:07.41,0:10:11.56,Default,,0,0,0,,​​Мына фотодағы қызға мынаны айтамын.
Dialogue: 0,0:10:13.51,0:10:15.87,Default,,0,0,0,,Жұмысшы табы 2 курс Е
Dialogue: 0,0:10:15.95,0:10:17.44,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:17.70,0:10:21.02,Default,,0,0,0,,Ендеше 2-курс Е сыныбын белсенді түрде ұстайық.
Dialogue: 0,0:10:21.02,0:10:21.58,Default,,0,0,0,,Иә
Dialogue: 0,0:10:25.20,0:10:27.56,Default,,0,0,0,,Удо-сан үйіне қайтты ма?
Dialogue: 0,0:10:27.64,0:10:29.63,Default,,0,0,0,,Жұмыс істегіңіз келмесе
Dialogue: 0,0:10:31.35,0:10:33.52,Default,,0,0,0,,Директор, кешіріңіз.
Dialogue: 0,0:10:33.67,0:10:35.16,Default,,0,0,0,,Аа, қажырлы еңбегіңіз үшін рахмет.
Dialogue: 0,0:10:41.80,0:10:43.17,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:10:43.17,0:10:44.28,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:10:44.28,0:10:45.51,Default,,0,0,0,,Ол қайдан келді?
Dialogue: 0,0:10:46.76,0:10:50.82,Default,,0,0,0,,Мен өзімнің телефото қабілетіммен мұндай ұятсыз фотосуреттерді түсіре аламын деп ешқашан ойламадым.
Dialogue: 0,0:10:50.82,0:10:53.82,Default,,0,0,0,,Суретке түсіріп, сататын қылмыскер
Dialogue: 0,0:10:55.55,0:10:58.68,Default,,0,0,0,,Ол садақ ату клубының жетекшісі.
Dialogue: 0,0:11:00.24,0:11:02.64,Default,,0,0,0,,Фотоға түсіру қабілеті
Dialogue: 0,0:11:02.84,0:11:04.12,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:04.12,0:11:06.60,Default,,0,0,0,,Тұтынушы құсты.
Dialogue: 0,0:11:06.99,0:11:10.52,Default,,0,0,0,,Мен сіздің шкафыңызды да тексердім.
Dialogue: 0,0:11:10.76,0:11:12.58,Default,,0,0,0,,Көптеген фотосуреттер пайда болды
Dialogue: 0,0:11:12.70,0:11:15.57,Default,,0,0,0,,Дәлел ретінде осы бейнекамераға жазып алдым.
Dialogue: 0,0:11:17.69,0:11:20.94,Default,,0,0,0,,Клуб бөлмесінде шкафты оңай ашуға болады.
Dialogue: 0,0:11:22.99,0:11:24.98,Default,,0,0,0,,Неліктен мұны істейсің?
Dialogue: 0,0:11:25.36,0:11:27.32,Default,,0,0,0,,Бұл ақшаға тұрарлық болғандықтан.
Dialogue: 0,0:11:27.72,0:11:29.64,Default,,0,0,0,,Бұл тұрмыстық мәселе ме?
Dialogue: 0,0:11:30.72,0:11:33.98,Default,,0,0,0,,Егер сіз осындай ақша алсаңыз, ата-анаңыз риза болмайды.
Dialogue: 0,0:11:33.98,0:11:36.44,Default,,0,0,0,,Мен ауырып тұрмын. Еш нәрсе істей алмайсың.
Dialogue: 0,0:11:40.51,0:11:42.41,Default,,0,0,0,,Мен сені іш киіміңмен суретке түсірдім
Dialogue: 0,0:11:42.56,0:11:43.87,Default,,0,0,0,,Тіпті бет-әлпеті де көрсетілген
Dialogue: 0,0:11:43.99,0:11:45.78,Default,,0,0,0,,Фотосуреттеріңіздің шашыраңқы болуын қаламасаңыз
Dialogue: 0,0:11:45.78,0:11:47.38,Default,,0,0,0,,Бұның бәрі ешқашан болмағандай елестетіңіз
Dialogue: 0,0:11:48.04,0:11:50.74,Default,,0,0,0,,Эй, мен қазір суретке түсіруді аяқтадым деп ойлаймын. Бұл тез.
Dialogue: 0,0:11:51.14,0:11:53.46,Default,,0,0,0,,Бірақ бұған сұраныс жоқ.
Dialogue: 0,0:11:54.52,0:11:56.40,Default,,0,0,0,,Қай жағынан қарасаңыз да, бұл жақсы өнім.
Dialogue: 0,0:11:57.18,0:12:00.84,Default,,0,0,0,,Шынайы ма? Мені мақтады. Мен оны істедім.
Dialogue: 0,0:12:00.94,0:12:03.34,Default,,0,0,0,,Әй, жоғалып кет.
Dialogue: 0,0:12:07.48,0:12:08.40,Default,,0,0,0,,Жақсы
Dialogue: 0,0:12:10.85,0:12:12.34,Default,,0,0,0,,Фотосурет жоқ
Dialogue: 0,0:12:12.34,0:12:13.73,Default,,0,0,0,,Міне
Dialogue: 0,0:12:14.54,0:12:16.17,Default,,0,0,0,,Неге сен?
Dialogue: 0,0:12:17.07,0:12:18.12,Default,,0,0,0,,Таку
Dialogue: 0,0:12:18.73,0:12:21.59,Default,,0,0,0,,Мен кептеліп қалдым, бұл туралы ойланыңыз.
Dialogue: 0,0:12:24.11,0:12:26.56,Default,,0,0,0,,Бәрін көрмедім деп елестетіңіз
Dialogue: 0,0:12:28.20,0:12:30.76,Default,,0,0,0,,Біреуге жебені көрсету - ең жаманы.
Dialogue: 0,0:12:31.29,0:12:34.53,Default,,0,0,0,,Жауынгерлік өнер рухы Ештеңе емес пе?
Dialogue: 0,0:12:52.13,0:12:56.59,Default,,0,0,0,,Біз сізді полицияға тапсыруға ниетіміз жоқ.
Dialogue: 0,0:12:56.80,0:12:59.65,Default,,0,0,0,,Бірақ егер сіз сол күшті пайдалана берсеңіз
Dialogue: 0,0:12:59.87,0:13:01.42,Default,,0,0,0,,Бұл қорқынышты өмір болады.
Dialogue: 0,0:13:02.12,0:13:05.80,Default,,0,0,0,,Сынақ субъектісі ретінде ғалымның бөлгенін қалайсыз ба?
Dialogue: 0,0:13:05.88,0:13:06.77,Default,,0,0,0,,Анатомия
Dialogue: 0,0:13:06.97,0:13:08.44,Default,,0,0,0,,Демек, бұл ескерту.
Dialogue: 0,0:13:08.83,0:13:12.52,Default,,0,0,0,,Жасөспірімдік шаққа жеткенде ол күш жоғалады.
Dialogue: 0,0:13:13.00,0:13:16.76,Default,,0,0,0,,Толық емес жұмыс күнін алу арқылы ақша алыңыз.
Dialogue: 0,0:13:27.46,0:13:29.54,Default,,0,0,0,,​​Сіз оны сәтті тазаладыңыз.
Dialogue: 0,0:13:29.54,0:13:30.28,Default,,0,0,0,,Иә
Dialogue: 0,0:13:31.28,0:13:34.12,Default,,0,0,0,,Эй, сен әрқашан осылай істейсің бе?
Dialogue: 0,0:13:34.12,0:13:39.04,Default,,0,0,0,,Иә, бұл ерекше қабілеті бар адамның менің ағам сияқты кез келген нәрсеге қайта тап болмас үшін.
Dialogue: 0,0:13:39.20,0:13:40.37,Default,,0,0,0,,Жақсы
Dialogue: 0,0:13:40.80,0:13:45.26,Default,,0,0,0,,Ғалымдар қолға түсірген ағаңызбен шын мәнінде не болды?
Dialogue: 0,0:13:46.95,0:13:49.39,Default,,0,0,0,,Бұл жасыратын нәрсе емес.
Dialogue: 0,0:13:49.39,0:13:50.70,Default,,0,0,0,,Сіз ертең барасыз ба?
Dialogue: 0,0:13:51.71,0:13:52.68,Default,,0,0,0,,Қайда?
Dialogue: 0,0:13:53.34,0:13:54.84,Default,,0,0,0,,Менің ағамның орнында.
Dialogue: 0,0:13:57.88,0:13:59.36,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:14:00.96,0:14:01.77,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:14:02.31,0:14:04.12,Default,,0,0,0,,Мен мұны істеуден аулақ боламын.
Dialogue: 0,0:14:04.48,0:14:05.61,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:14:06.89,0:14:08.50,Default,,0,0,0,,Түскі ас уақыты әлі емес.
Dialogue: 0,0:14:09.65,0:14:12.48,Default,,0,0,0,,Енді дүңгіршектен екібен сатып алайық.
Dialogue: 0,0:14:13.18,0:14:14.44,Default,,0,0,0,,Бұл
Dialogue: 0,0:14:14.76,0:14:18.11,Default,,0,0,0,,Жіпті тартқанда қызып кететін сиыр тілі бентосы
Dialogue: 0,0:14:18.52,0:14:19.96,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:14:19.96,0:14:21.48,Default,,0,0,0,,Жоқ, мен білемін.
Dialogue: 0,0:14:27.15,0:14:29.37,Default,,0,0,0,,Жедел пойыз дегеніміз не?
Dialogue: 0,0:14:29.86,0:14:32.36,Default,,0,0,0,,Мен мұндай жағдайларда жақсы тамақтана алмаймын.
Dialogue: 0,0:14:34.16,0:14:36.52,Default,,0,0,0,,Бұл әдепті толығымен бұзу.
Dialogue: 0,0:14:37.47,0:14:40.30,Default,,0,0,0,,Эй, сен сэндвич жемейсің бе?
Dialogue: 0,0:14:48.14,0:14:51.27,Default,,0,0,0,,Біріншіден, ағам ерекше қабілеті бар адам болды.
Dialogue: 0,0:14:52.21,0:14:56.24,Default,,0,0,0,,Бұл мен қабылдау емтиханын тапсырып, ұлттық орта мектепте оқуға түскен кезде болды.
Dialogue: 0,0:14:57.82,0:14:59.33,Default,,0,0,0,,Жарайсың анашым
Dialogue: 0,0:14:59.33,0:15:01.33,Default,,0,0,0,,Мен мұны істедім. өттім.
Dialogue: 0,0:15:01.78,0:15:03.80,Default,,0,0,0,,Сіз керемет жұмыс жасадыңыз, Нао.
Dialogue: 0,0:15:04.19,0:15:07.21,Default,,0,0,0,,Сіздің дәрігер немесе министр болу маңызды емес.
Dialogue: 0,0:15:09.28,0:15:12.57,Default,,0,0,0,,Бауырым, мынаны қара, мен өтіп кеттім.
Dialogue: 0,0:15:12.57,0:15:13.77,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:15:14.03,0:15:16.36,Default,,0,0,0,,Менен ерекшесің және таң қалдырдың.
Dialogue: 0,0:15:16.36,0:15:19.66,Default,,0,0,0,,Жоқ, менің ағам одан да керемет.
Dialogue: 0,0:15:19.81,0:15:23.88,Default,,0,0,0,,Менің ағамның тобы рекордтық компаниялар оларға назар аударатынын айтты.
Dialogue: 0,0:15:24.29,0:15:25.89,Default,,0,0,0,,Өйткені біз кедейміз
Dialogue: 0,0:15:25.89,0:15:28.85,Default,,0,0,0,,Ол тез арада өзінің негізгі дебютін жасады және тәуелсіз болды.
Dialogue: 0,0:15:30.04,0:15:31.87,Default,,0,0,0,,Мен сізге бұрын берген CD тыңдадыңыз ба?
Dialogue: 0,0:15:32.02,0:15:35.02,Default,,0,0,0,,Мен оны тыңдамаймын, себебі бұл менің оқуыма кедергі келтіреді.
Dialogue: 0,0:15:35.02,0:15:37.56,Default,,0,0,0,,Емтиханды аяқтадыңыз, сондықтан оны тыңдаңыз.
Dialogue: 0,0:15:37.84,0:15:40.64,Default,,0,0,0,,Мен мұндай дыбысты ойнағым келеді
Dialogue: 0,0:15:40.87,0:15:43.71,Default,,0,0,0,,Мен рок-музыкаға қатты қызықпаймын.
Dialogue: 0,0:15:43.71,0:15:45.92,Default,,0,0,0,,Жоқ, ZWIEND рок емес.
Dialogue: 0,0:15:45.92,0:15:46.98,Default,,0,0,0,,Пост-рок.
Dialogue: 0,0:15:46.98,0:15:49.23,Default,,0,0,0,,Бұған дейін мақтанған.
Dialogue: 0,0:15:49.23,0:15:51.18,Default,,0,0,0,,Мен не айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:15:52.33,0:15:54.96,Default,,0,0,0,,Бірақ мен мектепке түсе алмадым
Dialogue: 0,0:15:57.13,0:15:59.00,Default,,0,0,0,,Менің айтуым керек маңызды нәрсе бар.
Dialogue: 0,0:15:59.96,0:16:02.40,Default,,0,0,0,,Осы екі адамның таланттарын одан әрі пайдалану
Dialogue: 0,0:16:02.72,0:16:06.21,Default,,0,0,0,,Мен оны мектеп-интернатқа қабылдауды шештім.
Dialogue: 0,0:16:06.96,0:16:09.90,Default,,0,0,0,,Мен рекордтық компаниямен келісім-шартқа отырамын.
Dialogue: 0,0:16:10.77,0:16:14.63,Default,,0,0,0,,Мүмкін біз мұны сәл кейінге қалдырамыз.
Dialogue: 0,0:16:15.03,0:16:16.61,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:16:16.73,0:16:20.20,Default,,0,0,0,,Өз бетіңізше тұра алу үй шаруашылығыңыздың қаржысы тұрғысынан бата болуы керек.
Dialogue: 0,0:16:20.68,0:16:22.27,Default,,0,0,0,,Бұл керісінше.
Dialogue: 0,0:16:22.52,0:16:24.98,Default,,0,0,0,,​​Бұл үй шаруашылығының бюджетіне көмектеседі.
Dialogue: 0,0:16:24.98,0:16:26.52,Default,,0,0,0,,Керісінше не бар?
Dialogue: 0,0:16:26.65,0:16:28.58,Default,,0,0,0,,Нао бірінші кезекте оқи алатын болса да,
Dialogue: 0,0:16:28.70,0:16:31.78,Default,,0,0,0,,Мен тек гитарада ойнай алатын ақымақпын.
Dialogue: 0,0:16:31.78,0:16:34.24,Default,,0,0,0,,Менің ойымша, бұл мойындалды.
Dialogue: 0,0:16:34.24,0:16:36.88,Default,,0,0,0,,Егер солай болса, бұл музыка мектебі ме?
Dialogue: 0,0:16:36.88,0:16:38.82,Default,,0,0,0,,Екі адам бірге дегенді қалай түсінесіңдер?
Dialogue: 0,0:16:41.06,0:16:45.30,Default,,0,0,0,,Сол күні біз догезаны анамызды алғаш рет көрдік.
Dialogue: 0,0:16:46.90,0:16:50.75,Default,,0,0,0,,Бізді ұзақ уақыт жалғыз өсірген анам.
Dialogue: 0,0:16:52.08,0:16:54.00,Default,,0,0,0,,Мектепке ұқсайды
Dialogue: 0,0:16:54.24,0:16:56.00,Default,,0,0,0,,Мен тез достар таптым.
Dialogue: 0,0:16:56.77,0:17:02.16,Default,,0,0,0,,Дегенмен, күн сайын сабақтан кейін мен медициналық тексеруден өтуге мәжбүр болдым.
Dialogue: 0,0:17:02.91,0:17:07.12,Default,,0,0,0,,Бір мектепте оқитын болсақ та, мен ағамды кездестіре алмадым.
Dialogue: 0,0:17:08.01,0:17:12.52,Default,,0,0,0,,Мен ағамды іздейін десем, достарым мені тоқтатты.
Dialogue: 0,0:17:13.41,0:17:17.44,Default,,0,0,0,,Ол кезде менің ағамды үнемі сынақтан өткізетін.
Dialogue: 0,0:17:18.63,0:17:22.84,Default,,0,0,0,,Менің ағамның қабілеті - ауаны еркін дірілдеу.
Dialogue: 0,0:17:23.83,0:17:25.91,Default,,0,0,0,,Бұл қабілетті тікелей пайдалану
Dialogue: 0,0:17:25.91,0:17:28.88,Default,,0,0,0,,Өйткені ол гитараны әртүрлі тондарға ауыстырған.
Dialogue: 0,0:17:29.12,0:17:30.45,Default,,0,0,0,,Олар мені тапты
Dialogue: 0,0:17:31.37,0:17:35.24,Default,,0,0,0,,Бұл мүмкіндікті пайдалансаңыз, байланыстарды кептелуге болады.
Dialogue: 0,0:17:35.40,0:17:38.64,Default,,0,0,0,,Ғалымдар радио ұясы да мүмкін деп ойлады.
Dialogue: 0,0:17:40.10,0:17:43.34,Default,,0,0,0,,Мен ағамды бір жылдан кейін кездестірдім.
Dialogue: 0,0:17:43.94,0:17:46.70,Default,,0,0,0,,Менің ағам бұрынғы ағасы емес.
Dialogue: 0,0:17:47.24,0:17:51.92,Default,,0,0,0,,Ол енді менің әпкем екенін айта алмады.
Dialogue: 0,0:17:53.24,0:17:56.28,Default,,0,0,0,,Мені ағамнан алыстатуға тырысқан барлық достарым
Dialogue: 0,0:17:56.48,0:17:59.20,Default,,0,0,0,,Ғалымдар дайындаған уақытша достар
Dialogue: 0,0:18:01.16,0:18:03.48,Default,,0,0,0,,Мен де күн сайын сынақтан өттім.
Dialogue: 0,0:18:03.66,0:18:07.73,Default,,0,0,0,,Егер олар ағайынды болса, екеуінің де ерекше қабілетке ие болу ықтималдығы жоғары.
Dialogue: 0,0:18:08.16,0:18:09.81,Default,,0,0,0,,Бұл жалғыз себеп болды.
Dialogue: 0,0:18:11.18,0:18:14.65,Default,,0,0,0,,Мен енді ешкімге сенбеймін деп ант еттім.
Dialogue: 0,0:18:15.64,0:18:17.76,Default,,0,0,0,,Мен ол мектептен қашып кеттім.
Dialogue: 0,0:18:20.91,0:18:23.15,Default,,0,0,0,,Бұдан кейін не болды?
Dialogue: 0,0:18:23.88,0:18:26.22,Default,,0,0,0,,Мен сенетін жалғыз адамды кездестірдім
Dialogue: 0,0:18:26.41,0:18:27.84,Default,,0,0,0,,Осы уақытқа дейін
Dialogue: 0,0:18:28.48,0:18:29.52,Default,,0,0,0,,Бұл адам кім?
Dialogue: 0,0:18:30.00,0:18:31.10,Default,,0,0,0,,Келесі қадам төмен
Dialogue: 0,0:18:37.80,0:18:39.23,Default,,0,0,0,,Бұл Нао Томори.
Dialogue: 0,0:18:39.23,0:18:41.05,Default,,0,0,0,,Мен ағамды көруге келдім.
Dialogue: 0,0:18:41.75,0:18:43.58,Default,,0,0,0,,Оның аты Нао болды ма?
Dialogue: 0,0:18:43.77,0:18:45.79,Default,,0,0,0,,12-бөлме, өтінемін.
Dialogue: 0,0:18:46.31,0:18:48.46,Default,,0,0,0,,Мен сені сыртқа апарсам болады ма?
Dialogue: 0,0:18:48.88,0:18:51.16,Default,,0,0,0,,Бөлменің ішінде болса, ешқандай проблема жоқ.
Dialogue: 0,0:18:51.50,0:18:52.74,Default,,0,0,0,,Рахмет
Dialogue: 0,0:18:54.92,0:18:55.79,Default,,0,0,0,,Осы жолмен
Dialogue: 0,0:18:58.81,0:18:59.67,Default,,0,0,0,,Міне
Dialogue: 0,0:19:13.69,0:19:16.10,Default,,0,0,0,,Тыныштандыратын дәрілер қайтадан таусылады.
Dialogue: 0,0:19:16.52,0:19:19.77,Default,,0,0,0,,Бұл адам не істеп жатыр?
Dialogue: 0,0:19:19.77,0:19:20.96,Default,,0,0,0,,Құрамы
Dialogue: 0,0:19:21.92,0:19:25.00,Default,,0,0,0,,Енді менің ағам гитарада ойнаймын деп ойлайды.
Dialogue: 0,0:19:25.75,0:19:29.38,Default,,0,0,0,,Естігеніңіз - әуен, негізгі әуен.
Dialogue: 0,0:19:33.34,0:19:36.61,Default,,0,0,0,,Әй, футон тағы бұзылды.
Dialogue: 0,0:19:38.66,0:19:40.30,Default,,0,0,0,,​​Сыртқа шыққыңыз келе ме?
Dialogue: 0,0:19:40.72,0:19:43.20,Default,,0,0,0,,Тәуліктің бұл уақыты ең керемет көрініс.
Dialogue: 0,0:19:51.10,0:19:52.23,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:19:54.92,0:19:56.10,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:19:59.30,0:20:00.12,Default,,0,0,0,,О
Dialogue: 0,0:20:00.71,0:20:03.98,Default,,0,0,0,,Бірақ мұндай ерекше ортада қалай жер бетінде?
Dialogue: 0,0:20:04.39,0:20:07.03,Default,,0,0,0,,Мен сенетін жалғыз адамға рахмет
Dialogue: 0,0:20:07.85,0:20:12.09,Default,,0,0,0,,Олар мені ең әдемі жердегі ауруханаға тегін жатқызды.
Dialogue: 0,0:20:13.37,0:20:15.80,Default,,0,0,0,,Осы уақытқа дейін баратын адам бар ма?
Dialogue: 0,0:20:19.71,0:20:21.66,Default,,0,0,0,,Өйткені, ол ешқандай қызығушылық танытпайды.
Dialogue: 0,0:20:21.66,0:20:25.43,Default,,0,0,0,,Бірақ жақын арада сиқырлы оқ пайда болуы мүмкін.
Dialogue: 0,0:20:25.43,0:20:28.94,Default,,0,0,0,,Ешкім мұндай науқастарды құтқару үшін зерттеу жүргізбейді.
Dialogue: 0,0:20:29.44,0:20:30.24,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:20:31.37,0:20:35.06,Default,,0,0,0,,Ғалымдар үшін қабілеті бар адамдар батарея сияқты.
Dialogue: 0,0:20:35.34,0:20:38.56,Default,,0,0,0,,Егер ол тозса, мүмкіндігі бар басқа адаммен тәжірибе жасауға болады.
Dialogue: 0,0:20:39.40,0:20:43.04,Default,,0,0,0,,Бұрынғы адамдарға мұндай қабілетпен көмектесудің пайдасы жоқ.
Dialogue: 0,0:20:43.59,0:20:44.57,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:20:45.35,0:20:48.73,Default,,0,0,0,,Біз де ертең қандай болатынын білмейміз.
Dialogue: 0,0:20:48.98,0:20:50.58,Default,,0,0,0,,Қорқынышты нәрселерді айтпа
Dialogue: 0,0:20:51.08,0:20:53.48,Default,,0,0,0,,Сөздерді таңдау туралы не айтасыз?
Dialogue: 0,0:20:55.35,0:20:56.32,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:56.79,0:20:58.54,Default,,0,0,0,,Енді қайтайық.
Dialogue: 0,0:21:00.17,0:21:02.96,Default,,0,0,0,,Сіз көп қиындыққа тап болған болуыңыз керек.
Dialogue: 0,0:21:02.96,0:21:04.45,Default,,0,0,0,,Сізде аяушылық бар ма?
Dialogue: 0,0:21:04.91,0:21:08.00,Default,,0,0,0,,Өтінемін, өтінемін, алаяқ болсаң да.
Dialogue: 0,0:21:09.31,0:21:12.24,Default,,0,0,0,,Мүлдем емес, мен сияқты емес.
Dialogue: 0,0:21:13.85,0:21:14.61,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:21:16.96,0:21:20.28,Default,,0,0,0,,Студенттік кеңес осыншама бос болады деп ойламадым.
Dialogue: 0,0:21:20.51,0:21:21.74,Default,,0,0,0,,Қолымыздан келмейді ғой, иә?
Dialogue: 0,0:21:22.48,0:21:24.92,Default,,0,0,0,,Ариу-оний-чан, ол студенттік кеңесте ме?
Dialogue: 0,0:21:25.71,0:21:26.86,Default,,0,0,0,,Сен мұны айтпадың ба?
Dialogue: 0,0:21:26.86,0:21:28.60,Default,,0,0,0,,Мен оны бірінші рет естіп тұрмын.
Dialogue: 0,0:21:28.79,0:21:31.45,Default,,0,0,0,,Олай болса, Аюдың арнайы көкөніс карриін алайық.
Dialogue: 0,0:21:31.45,0:21:33.92,Default,,0,0,0,,Бүгін менің шаршағанымды емдеңіз.
Dialogue: 0,0:21:35.96,0:21:39.44,Default,,0,0,0,,Карри карри көкөністері
Dialogue: 0,0:21:36.45,0:21:40.52,Default,,0,0,0,,Егер менің қабілетім болса, онда Аюмиде де қабілет бар болуы мүмкін.
Dialogue: 0,0:21:41.48,0:21:43.48,Default,,0,0,0,,Егер мен ұсталсам
Dialogue: 0,0:21:44.59,0:21:46.50,Default,,0,0,0,,Аюми де Юрий сияқты
Dialogue: 0,0:21:47.28,0:21:49.06,Default,,0,0,0,,Дайын
Dialogue: 0,0:21:49.56,0:21:51.92,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:21:51.92,0:21:52.74,Default,,0,0,0,,Ана
Dialogue: 0,0:21:53.59,0:21:58.27,Default,,0,0,0,,Хмм, мүмкін бұл карриде құпия ингредиент бар.
Dialogue: 0,0:21:58.33,0:22:01.26,Default,,0,0,0,,Бұл Отосака отбасының құпия пицца соусы.
Dialogue: 0,0:22:04.66,0:22:08.64,Default,,0,0,0,,Ол енді омлет күрішіне ұқсамайды.
Dialogue: 0,0:22:12.77,0:22:15.70,Default,,0,0,0,,Бұл күнделікті жұмыс па, білмеймін, бірақ ұйықтай бер.
Dialogue: 0,0:22:15.70,0:22:17.43,Default,,0,0,0,,Мен бүгін құйрықты жұлдызды көрдім, сондықтан
Dialogue: 0,0:22:17.43,0:22:20.24,Default,,0,0,0,,Мен қатты толқығандықтан ұйықтап қаламын.
Dialogue: 0,0:22:20.37,0:22:21.80,Default,,0,0,0,,Міне, сіз шеберсіз.
Dialogue: 0,0:22:21.80,0:22:25.32,Default,,0,0,0,,Бірақ мен көргім келетін тағы бір құйрықты жұлдыз бар.
Dialogue: 0,0:22:26.36,0:22:28.92,Default,,0,0,0,,Бұл ұзақ уақытқа созылатын комета.
Dialogue: 0,0:22:29.23,0:22:30.29,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:22:30.29,0:22:33.76,Default,,0,0,0,,Бұл жүздеген жылда бір рет келетін құйрықты жұлдыз.
Dialogue: 0,0:22:34.84,0:22:36.65,Default,,0,0,0,,Сондай құйрықты жұлдыз бар ма?
Dialogue: 0,0:22:45.65,0:22:52.64,Default,,0,0,0,,Бүгін таңертең мен көріністі көретін жерге келдім.
Dialogue: 0,0:22:52.64,0:23:00.02,Default,,0,0,0,,Темір жолдарға қарайтын қашықтықтағы ғимарат
Dialogue: 0,0:23:00.02,0:23:07.49,Default,,0,0,0,,Жел қатты соққанда, менің соққыларымды шайқағандай
Dialogue: 0,0:23:07.49,0:23:13.56,Default,,0,0,0,,Мен енді тартынбаймын
Dialogue: 0,0:23:13.56,0:23:20.96,Default,,0,0,0,,Біз тіпті дүниенің соңын білмейміз
Dialogue: 0,0:23:20.96,0:23:28.67,Default,,0,0,0,,Мен қайғысыз өмір сүруді де білмеймін
Dialogue: 0,0:23:28.67,0:23:35.81,Default,,0,0,0,,Бізді осы мақсаттан ары күтіп тұрған батылдық
Dialogue: 0,0:23:35.81,0:23:43.27,Default,,0,0,0,,Мен оны алған кезде аяқталатын арманым болғым келеді
Dialogue: 0,0:23:43.27,0:23:50.64,Default,,0,0,0,,Аспан өзгеріп, жұлдыздар айналады
Dialogue: 0,0:23:50.64,0:23:59.91,Default,,0,0,0,,Мен оянған бойда бүгін қайтадан жүре бастаймын.
Dialogue: 0,0:24:01.41,0:24:06.41,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
