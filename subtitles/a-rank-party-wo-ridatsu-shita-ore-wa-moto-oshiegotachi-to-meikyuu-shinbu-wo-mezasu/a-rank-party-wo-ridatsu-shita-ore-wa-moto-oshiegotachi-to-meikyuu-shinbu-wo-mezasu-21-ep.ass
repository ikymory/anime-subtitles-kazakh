Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.75,0:00:03.29,Default,,0,0,0,,Бенвуд және басқалармен мөрленген—
Dialogue: 0,0:00:03.37,0:00:05.79,Default,,0,0,0,,Түссіз қараңғылықтың шыңырау қақпасы ашық.
Dialogue: 0,0:00:05.88,0:00:08.29,Default,,0,0,0,,Бұл пломбаның сынғанын білдіре ме?
Dialogue: 0,0:00:08.38,0:00:12.80,Default,,0,0,0,,Ол жақтан аққан қараңғылық әлем лабиринтіне толып жатыр.
Dialogue: 0,0:00:12.88,0:00:16.47,Default,,0,0,0,,Түссіз қараңғылықты жеңіп, Тұңғиық қақпасын жабыңыз
Dialogue: 0,0:00:16.55,0:00:20.22,Default,,0,0,0,,Олай етсек, қараңғылықтың келуі де, оның әр жаққа ағуы да тоқтайды.
Dialogue: 0,0:00:20.31,0:00:21.93,Default,,0,0,0,,Әлемді құтқара алады
Dialogue: 0,0:00:24.77,0:00:27.02,Default,,0,0,0,,Тезірек Финиске оралайық.
Dialogue: 0,0:00:27.11,0:00:28.44,Default,,0,0,0,,Түссіз қараңғылыққа!
Dialogue: 0,0:00:29.52,0:00:31.53,Default,,0,0,0,,♪～
Dialogue: 0,0:01:56.95,0:01:58.95,Default,,0,0,0,,～♪
Dialogue: 0,0:01:59.82,0:02:00.74,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:02:00.82,0:02:02.62,Default,,0,0,0,,Тұңғиық қақпасын жабуға келгенде
Dialogue: 0,0:02:02.70,0:02:04.95,Default,,0,0,0,,Кәсіби тергеу қажет
Dialogue: 0,0:02:05.58,0:02:09.83,Default,,0,0,0,,Тергеушіні сол қауіпті зындан арқылы алып жүру
Dialogue: 0,0:02:09.92,0:02:11.46,Default,,0,0,0,,Сіз бұл мүмкін емес деп айта аласыз
Dialogue: 0,0:02:12.04,0:02:14.34,Default,,0,0,0,,Олай болса, тергеуші алынбайды.
Dialogue: 0,0:02:14.42,0:02:16.97,Default,,0,0,0,,Жабу орнына жою
Dialogue: 0,0:02:17.05,0:02:19.76,Default,,0,0,0,,Біз мұны да байқадық.
Dialogue: 0,0:02:19.84,0:02:22.26,Default,,0,0,0,,Бірақ қанша тырыссам да бұза алмадым.
Dialogue: 0,0:02:22.76,0:02:24.47,Default,,0,0,0,,Сондықтан мен оны мөрмен жаптым.
Dialogue: 0,0:02:32.48,0:02:36.78,Default,,0,0,0,,Бұл да өте құпия болып табылады және жария жазбаның бөлігі емес.
Dialogue: 0,0:02:37.86,0:02:41.74,Default,,0,0,0,,Дегенмен, мен әлемді құтқаратын бағытты көрдім.
Dialogue: 0,0:02:42.24,0:02:44.37,Default,,0,0,0,,Бичаның жігітіне хат жібер
Dialogue: 0,0:02:44.45,0:02:45.41,Default,,0,0,0,,О
Dialogue: 0,0:02:45.49,0:02:47.33,Default,,0,0,0,,Финиске оралу үшін
Dialogue: 0,0:02:47.41,0:02:50.33,Default,,0,0,0,,Мен Форнеияның ұшуына жол бере алмаймын.
Dialogue: 0,0:02:50.42,0:02:51.46,Default,,0,0,0,,Патшаның алдын ала бұйрығы бойынша
Dialogue: 0,0:02:51.54,0:02:54.42,Default,,0,0,0,,Мені А дәрежелі авантюрист шақыртқым келеді.
Dialogue: 0,0:02:55.30,0:02:56.63,Default,,0,0,0,,Біз оған кірсек те
Dialogue: 0,0:02:56.71,0:02:59.67,Default,,0,0,0,,Мына түссіз қараңғылықтың ішінде не болып жатыр?
Dialogue: 0,0:02:59.76,0:03:01.47,Default,,0,0,0,,Алдын ала тергеу де қажет
Dialogue: 0,0:03:01.55,0:03:03.51,Default,,0,0,0,,Финиске кім орала алады?
Dialogue: 0,0:03:03.60,0:03:04.93,Default,,0,0,0,,Қанша уақыт болады?
Dialogue: 0,0:03:05.01,0:03:09.68,Default,,0,0,0,,Дұрыс, рұқсатты дайындауға бару үшін хабарласыңыз...
Dialogue: 0,0:03:10.27,0:03:12.19,Default,,0,0,0,,Оған екі апта қажет болуы мүмкін.
Dialogue: 0,0:03:12.27,0:03:14.52,Default,,0,0,0,,Мен көп күте алмаймын!
Dialogue: 0,0:03:14.61,0:03:16.77,Default,,0,0,0,,Тағы бірдеңе бар ма? Бірдеңе...
Dialogue: 0,0:03:16.86,0:03:18.69,Default,,0,0,0,,Юк, бүгін демалуға болады.
Dialogue: 0,0:03:18.78,0:03:20.11,Default,,0,0,0,,Егер сіз демалып жатсаңыз...
Dialogue: 0,0:03:20.19,0:03:21.45,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:03:21.53,0:03:24.62,Default,,0,0,0,,Ғылмас ретінде мен саған демалуды бұйырамын.
Dialogue: 0,0:03:25.12,0:03:27.29,Default,,0,0,0,,Кешеден бері мүлдем ұйықтамадың.
Dialogue: 0,0:03:27.37,0:03:30.08,Default,,0,0,0,,Жақсылап демалып, сосын ойлан.
Dialogue: 0,0:03:30.16,0:03:30.91,Default,,0,0,0,,Не?
Dialogue: 0,0:03:34.42,0:03:35.25,Default,,0,0,0,,Бенвуд мырза
Dialogue: 0,0:03:35.34,0:03:37.17,Default,,0,0,0,,Дұрыс айтасың, онии-чан.
Dialogue: 0,0:03:37.25,0:03:39.26,Default,,0,0,0,,Кішкене демалып алайық, жарай ма?
Dialogue: 0,0:03:40.05,0:03:40.84,Default,,0,0,0,,Іске қосу…
Dialogue: 0,0:03:41.34,0:03:43.89,Default,,0,0,0,,Баланың айтқанын тыңдау.
Dialogue: 0,0:03:43.97,0:03:46.01,Default,,0,0,0,,Мақалада айтылғандай
Dialogue: 0,0:03:46.10,0:03:49.77,Default,,0,0,0,,«Асықсаң, қателесесің, асықпа».
Dialogue: 0,0:03:50.35,0:03:52.52,Default,,0,0,0,,Бұл тыныштандыру уақыты.
Dialogue: 0,0:03:52.60,0:03:54.40,Default,,0,0,0,,Мен де бас тартамын.
Dialogue: 0,0:03:56.52,0:03:58.40,Default,,0,0,0,,Жарайды, мен үзіліс жасайын.
Dialogue: 0,0:03:59.11,0:04:00.94,Default,,0,0,0,,Олай болса, үйге қайтайық.
Dialogue: 0,0:04:01.03,0:04:01.99,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:06.12,0:04:09.16,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:04:10.20,0:04:11.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:11.75,0:04:15.92,Default,,0,0,0,,Басқаша айтқанда, дүние жүзіндегі барлық зындандар түссіз қараңғылыққа апарады?
Dialogue: 0,0:04:16.00,0:04:16.71,Default,,0,0,0,,Иә
Dialogue: 0,0:04:16.79,0:04:19.17,Default,,0,0,0,,Барлық зындандар қосылған.
Dialogue: 0,0:04:24.84,0:04:27.68,Default,,0,0,0,,Дұрыс, бұл бір ғана бөлік.
Dialogue: 0,0:04:27.76,0:04:30.18,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:04:35.23,0:04:36.48,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:41.36,0:04:45.82,Default,,0,0,0,,Сіз мені ояту үшін қандай да бір ақылды идея ойлап таптыңыз ба?
Dialogue: 0,0:04:45.91,0:04:48.41,Default,,0,0,0,,Демалу өте маңызды.
Dialogue: 0,0:04:48.91,0:04:50.45,Default,,0,0,0,,Финиске оралмау
Dialogue: 0,0:04:50.54,0:04:51.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:51.29,0:04:53.83,Default,,0,0,0,,Барлық зындандар қосылған
Dialogue: 0,0:04:54.33,0:04:57.96,Default,,0,0,0,,Басқаша айтқанда, Корольдік ғибадатханадан Түссіз қараңғылыққа баруға болады.
Dialogue: 0,0:04:58.04,0:05:01.38,Default,,0,0,0,,Дунадан бір рет азапты көрмедің бе?
Dialogue: 0,0:05:01.46,0:05:02.21,Default,,0,0,0,,Батыр
Dialogue: 0,0:05:03.67,0:05:06.22,Default,,0,0,0,,Бірақ мен сіздің ойыңызды түсіндім.
Dialogue: 0,0:05:06.72,0:05:09.47,Default,,0,0,0,,Іздеуші компасы сізге бағыт-бағдар берсін.
Dialogue: 0,0:05:11.43,0:05:13.35,Default,,0,0,0,,Жеңіске жету мүмкіндігі қандай?
Dialogue: 0,0:05:13.85,0:05:15.56,Default,,0,0,0,,Менің ойымша, бұл 50/50.
Dialogue: 0,0:05:15.64,0:05:18.35,Default,,0,0,0,,Демек, мен ғана ол жерге кіремін.
Dialogue: 0,0:05:18.94,0:05:21.61,Default,,0,0,0,,Тек Юк? қауіпті болар еді
Dialogue: 0,0:05:22.53,0:05:26.74,Default,,0,0,0,,Негізі маған басқа дүниеден келген зұлым құдай батасын берді.
Dialogue: 0,0:05:28.82,0:05:31.24,Default,,0,0,0,,Солай ма? Бұл менің бірінші рет естуім.
Dialogue: 0,0:05:31.87,0:05:34.29,Default,,0,0,0,,Мазалайтын нәрсе емес.
Dialogue: 0,0:05:34.79,0:05:36.00,Default,,0,0,0,,Достан басқа ешкім жоқ
Dialogue: 0,0:05:37.00,0:05:40.46,Default,,0,0,0,,Бұл түссіз қараңғылыққа қатысты құдай ма, білмеймін.
Dialogue: 0,0:05:40.96,0:05:43.05,Default,,0,0,0,,Менің ол жермен тығыз байланысым бар.
Dialogue: 0,0:05:43.55,0:05:46.17,Default,,0,0,0,,Егер сізде іздеуші компасы болса...
Dialogue: 0,0:05:46.26,0:05:47.55,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:05:47.63,0:05:51.43,Default,,0,0,0,,Бұл 50/50 қатынасы екенін ескерсек, бұл өте жоспарлы емес пе?
Dialogue: 0,0:05:52.60,0:05:56.35,Default,,0,0,0,,Юк, мен сіздің идеяңызды ұсынғым келеді.
Dialogue: 0,0:05:56.85,0:05:58.69,Default,,0,0,0,,Сірә
Dialogue: 0,0:05:58.77,0:06:00.23,Default,,0,0,0,,Компасты қарызға бер
Dialogue: 0,0:06:00.31,0:06:01.31,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:06:01.40,0:06:03.69,Default,,0,0,0,,Бірақ бұған дейін...
Dialogue: 0,0:06:04.36,0:06:06.44,Default,,0,0,0,,Әйелдеріңізбен кеңесіңіз
Dialogue: 0,0:06:06.53,0:06:07.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:07.53,0:06:09.99,Default,,0,0,0,,Батыр және батыр
Dialogue: 0,0:06:10.07,0:06:12.33,Default,,0,0,0,,Егер сіз өз өміріңізге қауіп төндірсеңіз
Dialogue: 0,0:06:12.41,0:06:15.95,Default,,0,0,0,,Сіздің өміріңізге тәуелді адамдарды назардан тыс қалдырмаңыз.
Dialogue: 0,0:06:16.54,0:06:19.71,Default,,0,0,0,,Миссия үшін өміріңізді қатерге тігуге дайын болыңыз.
Dialogue: 0,0:06:19.79,0:06:23.84,Default,,0,0,0,,Жаныңда болу үшін өмірін қатерге тіккен адамдар да бар.
Dialogue: 0,0:06:25.30,0:06:27.84,Default,,0,0,0,,Сол жас әйел сияқты
Dialogue: 0,0:06:28.42,0:06:30.22,Default,,0,0,0,,Мен жас әйел емеспін
Dialogue: 0,0:06:30.84,0:06:31.84,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:06:31.93,0:06:34.14,Default,,0,0,0,,Мен... Сен қашаннан бері жүрсің?
Dialogue: 0,0:06:34.22,0:06:35.47,Default,,0,0,0,,Біраз бұрын
Dialogue: 0,0:06:36.06,0:06:38.23,Default,,0,0,0,,Сіз ашулысыз ба?
Dialogue: 0,0:06:40.90,0:06:42.48,Default,,0,0,0,,Рақмет сізге, Мәртебелі.
Dialogue: 0,0:06:42.56,0:06:46.23,Default,,0,0,0,,Не, мен тым араласып кеткен сияқтымын.
Dialogue: 0,0:06:46.32,0:06:49.78,Default,,0,0,0,,Жоқ, Юкенің достары көп емес.
Dialogue: 0,0:06:50.28,0:06:52.20,Default,,0,0,0,,Мен саған кейінірек уағыз айтамын.
Dialogue: 0,0:06:52.70,0:06:53.70,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:53.78,0:06:57.04,Default,,0,0,0,,Сізді түсінетін жақсы әйеліңіз бар.
Dialogue: 0,0:06:57.12,0:06:58.70,Default,,0,0,0,,Оны жиі талқылаңыз.
Dialogue: 0,0:06:58.79,0:07:01.00,Default,,0,0,0,,Сол семіз шошқа Полпо — өзі жалғыз шыға алмайды.
Dialogue: 0,0:07:01.08,0:07:02.71,Default,,0,0,0,,Рахмет Мастома
Dialogue: 0,0:07:03.29,0:07:06.46,Default,,0,0,0,,Досым, сенің де өлгеніңді қаламаймын.
Dialogue: 0,0:07:06.96,0:07:09.47,Default,,0,0,0,,Өмірге қауіп төндіретін кездер болады.
Dialogue: 0,0:07:10.13,0:07:13.47,Default,,0,0,0,,Барсам, мен де бір шешімге келемін.
Dialogue: 0,0:07:14.14,0:07:14.80,Default,,0,0,0,,О
Dialogue: 0,0:07:23.19,0:07:23.90,Default,,0,0,0,,Хун
Dialogue: 0,0:07:25.98,0:07:28.11,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:29.24,0:07:30.11,Default,,0,0,0,,Жаңбыр
Dialogue: 0,0:07:30.82,0:07:31.65,Default,,0,0,0,,Хун
Dialogue: 0,0:07:33.45,0:07:34.62,Default,,0,0,0,,Хаа…
Dialogue: 0,0:07:37.24,0:07:38.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:39.37,0:07:40.96,Default,,0,0,0,,Кешіріңіз жаңбыр
Dialogue: 0,0:07:42.04,0:07:43.25,Default,,0,0,0,,Иә
Dialogue: 0,0:07:48.13,0:07:50.01,Default,,0,0,0,,Не болды? Юк
Dialogue: 0,0:07:50.88,0:07:54.09,Default,,0,0,0,,Егер сіз өліп қалуыңыз мүмкін деп ойласаңыз
Dialogue: 0,0:07:54.18,0:07:57.68,Default,,0,0,0,,Мен кенет қорқып, Жаңбырға қол тигізгім келді.
Dialogue: 0,0:07:58.18,0:07:58.85,Default,,0,0,0,,Сізге бұл ұнамайды ма?
Dialogue: 0,0:07:59.85,0:08:02.27,Default,,0,0,0,,Жоқ, маған ұнамайды.
Dialogue: 0,0:08:15.62,0:08:17.41,Default,,0,0,0,,-Аа... -(Юк) Не болды?
Dialogue: 0,0:08:17.91,0:08:19.58,Default,,0,0,0,,-Мен сездім-(юк) А?
Dialogue: 0,0:08:20.08,0:08:22.71,Default,,0,0,0,,Хмм... бұл менің айтқым келгені емес.
Dialogue: 0,0:08:22.79,0:08:24.21,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:08:24.29,0:08:28.34,Default,,0,0,0,,Мүмкін... Юктегі осы сияқты
Dialogue: 0,0:08:31.05,0:08:33.67,Default,,0,0,0,,Сонымен... сіз қалай ойлайсыз?
Dialogue: 0,0:08:35.84,0:08:38.05,Default,,0,0,0,,Менімен сөйлескеніңізге рахмет.
Dialogue: 0,0:08:38.55,0:08:41.56,Default,,0,0,0,,Бірақ, сэр, сіз тым көп ұстайсыз.
Dialogue: 0,0:08:41.64,0:08:42.89,Default,,0,0,0,,Әдеттегідей.
Dialogue: 0,0:08:43.81,0:08:44.89,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:44.98,0:08:47.02,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:08:47.10,0:08:49.52,Default,,0,0,0,,Біз де абдырап қалдық.
Dialogue: 0,0:08:50.02,0:08:51.65,Default,,0,0,0,,Бірақ бұл туралы ойланудың қажеті жоқ.
Dialogue: 0,0:08:51.73,0:08:53.95,Default,,0,0,0,,Мен сізге еремін.
Dialogue: 0,0:08:54.03,0:08:54.95,Default,,0,0,0,,Марина…
Dialogue: 0,0:08:55.03,0:08:56.78,Default,,0,0,0,,Әрине мен де.
Dialogue: 0,0:08:56.86,0:08:58.91,Default,,0,0,0,,Мен кедергі болайын деген ниетім жоқ.
Dialogue: 0,0:08:59.66,0:09:02.87,Default,,0,0,0,,Барлаушыларсыз түссіз қараңғылыққа бару абайсыздық дейді.
Dialogue: 0,0:09:02.95,0:09:05.54,Default,,0,0,0,,Юк мырза жақсы білуі керек.
Dialogue: 0,0:09:06.54,0:09:07.29,Default,,0,0,0,,Сіз де жүгіріңіз!
Dialogue: 0,0:09:07.88,0:09:09.54,Default,,0,0,0,,Келесі жолы мен сенімен бірге барамын
Dialogue: 0,0:09:11.55,0:09:12.55,Default,,0,0,0,,Барлығың тыңдаңдар.
Dialogue: 0,0:09:12.63,0:09:14.38,Default,,0,0,0,,Жоқ, мен сұрамаймын.
Dialogue: 0,0:09:14.47,0:09:16.51,Default,,0,0,0,,Сіз бұл жолы жоқ деп айтасыз, солай ма?
Dialogue: 0,0:09:16.59,0:09:18.22,Default,,0,0,0,,Бірақ мен мұны естімеймін.
Dialogue: 0,0:09:18.30,0:09:19.14,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:19.22,0:09:21.06,Default,,0,0,0,,«бірақ» және «бірақ» екеуі де жақсы емес!
Dialogue: 0,0:09:21.14,0:09:22.47,Default,,0,0,0,,Мен сізге міндетті түрде еремін.
Dialogue: 0,0:09:23.06,0:09:26.48,Default,,0,0,0,,Ұстаз, бізді бағаламағаныңызды қаламаймын.
Dialogue: 0,0:09:26.56,0:09:28.56,Default,,0,0,0,,Мен саған төмен қарап тұрған жоқпын.
Dialogue: 0,0:09:28.65,0:09:31.57,Default,,0,0,0,,Барлығы шынымен жақсы авантюрист болды.
Dialogue: 0,0:09:31.65,0:09:32.48,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:09:32.57,0:09:35.19,Default,,0,0,0,,Біз авантюрист болдық.
Dialogue: 0,0:09:35.28,0:09:37.15,Default,,0,0,0,,Мен енді студент емеспін.
Dialogue: 0,0:09:37.66,0:09:41.58,Default,,0,0,0,,Мұғалім... Жоқ, Юке мырза, мен сізге еремін.
Dialogue: 0,0:09:41.66,0:09:42.79,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:09:43.79,0:09:45.20,Default,,0,0,0,,Мен бас тартамын
Dialogue: 0,0:09:45.29,0:09:47.33,Default,,0,0,0,,Біз шештік
Dialogue: 0,0:09:48.83,0:09:50.21,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:09:50.29,0:09:51.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:51.17,0:09:52.09,Default,,0,0,0,,Иә
Dialogue: 0,0:09:52.17,0:09:53.17,Default,,0,0,0,,Гааах!
Dialogue: 0,0:09:53.25,0:09:54.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:55.26,0:09:57.17,Default,,0,0,0,,Жаңбырдың қатесі бар ма?
Dialogue: 0,0:09:57.26,0:09:57.84,Default,,0,0,0,,Мен?
Dialogue: 0,0:09:58.47,0:10:00.85,Default,,0,0,0,,Мен саған өз сезімімді айттым.
Dialogue: 0,0:10:00.93,0:10:02.97,Default,,0,0,0,,Қашан? Қулық!
Dialogue: 0,0:10:03.06,0:10:04.43,Default,,0,0,0,,Хехехе
Dialogue: 0,0:10:05.31,0:10:08.44,Default,,0,0,0,,Енді, Юке мырза, жоспарыңызды түсіндіріп беріңізші.
Dialogue: 0,0:10:09.02,0:10:10.98,Default,,0,0,0,,Іздеуші компасын пайдаланыңыз
Dialogue: 0,0:10:12.06,0:10:15.07,Default,,0,0,0,,Түссіз қараңғылық барлық зындандарға қосылған.
Dialogue: 0,0:10:15.69,0:10:16.19,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:10:16.78,0:10:20.20,Default,,0,0,0,,Мүмкін сіз Король мавзолейіндегі Тенебраға асығатын шығарсыз?
Dialogue: 0,0:10:21.03,0:10:22.45,Default,,0,0,0,,Онда крем қосылған торттарды да жей алмайды ғой, иә?
Dialogue: 0,0:10:22.53,0:10:26.54,Default,,0,0,0,,Ол жер түссіз қараңғылыққа қосылуы керек.
Dialogue: 0,0:10:26.62,0:10:28.50,Default,,0,0,0,,Іздеуші компасын пайдалану
Dialogue: 0,0:10:28.58,0:10:31.46,Default,,0,0,0,,Түссіз қараңғылық пен Тұңғиық қақпасына апаратын жолды іздеу
Dialogue: 0,0:10:32.08,0:10:33.25,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:10:33.34,0:10:35.96,Default,,0,0,0,,Қажетті заттарды тазалаңыз
Dialogue: 0,0:10:36.05,0:10:39.09,Default,,0,0,0,,Мен кіру кестесін де үйлестіремін.
Dialogue: 0,0:10:39.59,0:10:41.76,Default,,0,0,0,,Мен де гильдиядан қолдау алғым келеді.
Dialogue: 0,0:10:41.84,0:10:44.97,Default,,0,0,0,,Жоспар құрып Ғылмаспен ақылдасайық.
Dialogue: 0,0:10:45.06,0:10:47.43,Default,,0,0,0,,Мен... Жарайды, өтінемін.
Dialogue: 0,0:10:47.52,0:10:49.56,Default,,0,0,0,,Маған қалдырыңызшы, Юк мырза.
Dialogue: 0,0:10:50.06,0:10:52.94,Default,,0,0,0,,Бізде бәрі жақсы болады... солай ма?
Dialogue: 0,0:10:53.02,0:10:54.02,Default,,0,0,0,,О
Dialogue: 0,0:10:55.11,0:10:57.15,Default,,0,0,0,,Мен сенен өтінемін, лорд Фердио.
Dialogue: 0,0:10:57.23,0:10:58.86,Default,,0,0,0,,Ханзада Мастмадан
Dialogue: 0,0:10:58.94,0:11:02.20,Default,,0,0,0,,Біз сіздің шытырман оқиғалылар гильдиясына мүмкіндігінше тезірек келгеніңізді қалаймыз.
Dialogue: 0,0:11:05.53,0:11:07.70,Default,,0,0,0,,Жоғары мәртебелі Рахума шайқасқа кетті ме?
Dialogue: 0,0:11:07.79,0:11:09.29,Default,,0,0,0,,Король ғибадатханасына
Dialogue: 0,0:11:09.37,0:11:12.71,Default,,0,0,0,,«Ол құбыжық ұяларын қиратады».
Dialogue: 0,0:11:13.33,0:11:16.34,Default,,0,0,0,,Ол менің сарайыма дейін келіп, құсты.
Dialogue: 0,0:11:16.42,0:11:19.97,Default,,0,0,0,,Тарату релесі құрылғысы іске қосуға дайын
Dialogue: 0,0:11:20.05,0:11:21.09,Default,,0,0,0,,Бета-санды іске қосу
Dialogue: 0,0:11:27.93,0:11:30.35,Default,,0,0,0,,- (Басқарма мүшесі) Алды - Күш жұмсайды
Dialogue: 0,0:11:31.02,0:11:33.10,Default,,0,0,0,,Кешіріңіз, ақымақ ағам
Dialogue: 0,0:11:33.73,0:11:35.86,Default,,0,0,0,,Онда...
Dialogue: 0,0:11:35.94,0:11:37.36,Default,,0,0,0,,(сарбаздардың айқайы)
Dialogue: 0,0:11:37.98,0:11:38.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:39.19,0:11:41.11,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:11:41.20,0:11:42.78,Default,,0,0,0,,Не істеу керек? Сіз құтқаруға келесіз бе?
Dialogue: 0,0:11:42.86,0:11:45.32,Default,,0,0,0,,Біз оны уақытында жасай алмаймыз.
Dialogue: 0,0:11:45.41,0:11:47.28,Default,,0,0,0,,Қарғыс атсын... анау жабайы!
Dialogue: 0,0:11:47.37,0:11:49.08,Default,,0,0,0,,Виконт Осымен.
Dialogue: 0,0:11:49.75,0:11:51.16,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:11:51.25,0:11:53.67,Default,,0,0,0,,Солдаттарды тастап, жалғыз қашу деген нені білдіреді?
Dialogue: 0,0:11:53.75,0:11:55.50,Default,,0,0,0,,Бұл сұмдық.
Dialogue: 0,0:11:57.50,0:11:58.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:58.59,0:12:00.55,Default,,0,0,0,,Мен жоғары мәртебелі Рахуманы көрмей қалдым.
Dialogue: 0,0:12:00.63,0:12:03.80,Default,,0,0,0,,Ол жеткізу ауқымынан шығып кеткен болуы мүмкін.
Dialogue: 0,0:12:04.30,0:12:05.09,Default,,0,0,0,,Іздеу
Dialogue: 0,0:12:05.72,0:12:06.85,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:12:06.93,0:12:09.39,Default,,0,0,0,,Біз қауіпсіздік жүйесін күшейтуіміз керек.
Dialogue: 0,0:12:09.47,0:12:11.98,Default,,0,0,0,,Адамның дәмін білген құбыжықтар
Dialogue: 0,0:12:12.06,0:12:14.65,Default,,0,0,0,,Олардың осы Ла Джоға келу мүмкіндігі бар.
Dialogue: 0,0:12:15.31,0:12:16.36,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:12:16.86,0:12:18.65,Default,,0,0,0,,Менің кірісуден басқа амалым жоқ деп ойлаймын.
Dialogue: 0,0:12:19.23,0:12:21.11,Default,,0,0,0,,А... Тенебрада?
Dialogue: 0,0:12:21.19,0:12:22.78,Default,,0,0,0,,Асыққан дұрыс сияқты.
Dialogue: 0,0:12:22.86,0:12:27.32,Default,,0,0,0,,Мен кеңес алмас бұрын дұрыс жоспар құруды ойладым.
Dialogue: 0,0:12:27.41,0:12:30.08,Default,,0,0,0,,Енді олай емес.
Dialogue: 0,0:12:30.75,0:12:33.33,Default,,0,0,0,,-Оны жасауға бола ма? -(Юк) Түсіндің бе?
Dialogue: 0,0:12:33.41,0:12:34.50,Default,,0,0,0,,Табылды
Dialogue: 0,0:12:35.00,0:12:36.00,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:12:36.08,0:12:38.17,Default,,0,0,0,,Әй... Шүкір!
Dialogue: 0,0:12:38.25,0:12:40.50,Default,,0,0,0,,А... аа!
Dialogue: 0,0:12:42.05,0:12:42.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:42.76,0:12:45.30,Default,,0,0,0,,Ол Тенебраға қолын тигізді.
Dialogue: 0,0:12:45.38,0:12:46.01,Default,,0,0,0,,О
Dialogue: 0,0:12:46.89,0:12:49.76,Default,,0,0,0,,…
Dialogue: 0,0:12:49.85,0:12:52.02,Default,,0,0,0,,-Аа... -(Юк) Көлеңке аңдыушы!
Dialogue: 0,0:12:52.10,0:12:55.77,Default,,0,0,0,,Ууу… Нуууу…
Dialogue: 0,0:13:01.86,0:13:03.57,Default,,0,0,0,,Не? Яғни
Dialogue: 0,0:13:03.65,0:13:05.40,Default,,0,0,0,,Көлеңкелік аңду
Dialogue: 0,0:13:05.99,0:13:08.87,Default,,0,0,0,,Зынданда пайда болатын жұмбақ қатысу
Dialogue: 0,0:13:09.45,0:13:10.58,Default,,0,0,0,,...бірақ
Dialogue: 0,0:13:10.66,0:13:14.04,Default,,0,0,0,,Біз оның шынайы тұлғасын жаңа ғана ашқан сияқтымыз.
Dialogue: 0,0:13:14.66,0:13:17.96,Default,,0,0,0,,Тенебраға тиген адам іші сыртқа шықты...
Dialogue: 0,0:13:18.04,0:13:19.54,Default,,0,0,0,,Бұл жақсы емес
Dialogue: 0,0:13:19.63,0:13:22.30,Default,,0,0,0,,Барлығын ол жерге апарма.
Dialogue: 0,0:13:23.71,0:13:25.17,Default,,0,0,0,,Юк мырза...
Dialogue: 0,0:13:30.26,0:13:32.43,Default,,0,0,0,,Атмосфера біршама ауыр.
Dialogue: 0,0:13:33.06,0:13:34.43,Default,,0,0,0,,Мен сені мазалаймын
Dialogue: 0,0:13:35.10,0:13:35.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:35.77,0:13:37.06,Default,,0,0,0,,Юк
Dialogue: 0,0:13:37.14,0:13:39.44,Default,,0,0,0,,Біраз уақыт өтсе де бұл бет не болды?
Dialogue: 0,0:13:39.52,0:13:41.48,Default,,0,0,0,,Әй... Ағай
Dialogue: 0,0:13:41.57,0:13:42.73,Default,,0,0,0,,Аға?
Dialogue: 0,0:13:42.82,0:13:44.19,Default,,0,0,0,,Сен сенімдісің бе, Сага-сан?
Dialogue: 0,0:13:44.28,0:13:48.28,Default,,0,0,0,,Ол үлкейді және сенімді дерлік.
Dialogue: 0,0:13:48.91,0:13:51.66,Default,,0,0,0,,Сіз жақсы авантюрист сияқтысыз.
Dialogue: 0,0:13:51.74,0:13:53.29,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,0:13:53.37,0:13:55.08,Default,,0,0,0,,Жоқ. Осы уақытқа дейін қайда болдың?
Dialogue: 0,0:13:55.16,0:13:56.46,Default,,0,0,0,,Сага!
Dialogue: 0,0:13:56.54,0:14:00.25,Default,,0,0,0,,Бәрін бізге күштеп салып, қайда жүрдің?
Dialogue: 0,0:14:00.33,0:14:01.79,Default,,0,0,0,,Бұл туралы кейінірек.
Dialogue: 0,0:14:02.38,0:14:05.80,Default,,0,0,0,,Артқы жағындағы қарапайым Юкенің сұлу әйелдерді өзіне тартып жатқанына сене алар емеспін.
Dialogue: 0,0:14:05.88,0:14:06.92,Default,,0,0,0,,Мен біраз таң қалдым.
Dialogue: 0,0:14:07.55,0:14:08.93,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:14:09.51,0:14:12.35,Default,,0,0,0,,Жас ханым, менің Юкім туралы не ойлайсыз?
Dialogue: 0,0:14:12.43,0:14:13.81,Default,,0,0,0,,Сізді еркелетіп жатыр ма?
Dialogue: 0,0:14:13.89,0:14:17.31,Default,,0,0,0,,Ю... Юк мырза маған өте пайдалы болды.
Dialogue: 0,0:14:17.39,0:14:18.69,Default,,0,0,0,,Ағай!
Dialogue: 0,0:14:18.77,0:14:20.77,Default,,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:14:20.86,0:14:23.11,Default,,0,0,0,,Барлығы аздап қобалжыды.
Dialogue: 0,0:14:23.61,0:14:25.69,Default,,0,0,0,,Бұлай байсалды сөйлей де алмайсың ғой?
Dialogue: 0,0:14:25.78,0:14:28.45,Default,,0,0,0,,Хмм, сен кімсің?
Dialogue: 0,0:14:28.53,0:14:30.49,Default,,0,0,0,,Мен Сага Фердиомын
Dialogue: 0,0:14:30.57,0:14:33.08,Default,,0,0,0,,Ол қарапайым авантюрист және оның ағасы.
Dialogue: 0,0:14:33.70,0:14:36.29,Default,,0,0,0,,Қош бол мен Мастома.
Dialogue: 0,0:14:36.79,0:14:39.71,Default,,0,0,0,,Ол Юктың досы және Ла-Джода билік жүргізеді.
Dialogue: 0,0:14:39.79,0:14:43.88,Default,,0,0,0,,Юкта сендей досым барына өте қуаныштымын.
Dialogue: 0,0:14:43.96,0:14:46.17,Default,,0,0,0,,Сага Себебі мен сені сағындым
Dialogue: 0,0:14:46.26,0:14:50.30,Default,,0,0,0,,Мен сияқты ақымақ да амалсыз Ғылмастың орындығына отырады.
Dialogue: 0,0:14:50.38,0:14:53.22,Default,,0,0,0,,Бұл өте жаман болды. Түрлі жағдайлар болды.
Dialogue: 0,0:14:53.30,0:14:54.97,Default,,0,0,0,,Бірақ сіз Мамару-санмен біргесіз, солай ма?
Dialogue: 0,0:14:55.56,0:14:58.18,Default,,0,0,0,,Ал, уәде еткендей, дұрыстап оралды.
Dialogue: 0,0:14:58.27,0:14:59.14,Default,,0,0,0,,Гррр…
Dialogue: 0,0:14:59.23,0:15:00.35,Default,,0,0,0,,Мұны тоқтатыңыз.
Dialogue: 0,0:15:01.02,0:15:04.90,Default,,0,0,0,,Сіз бұрынғыдай сенімдісіз.
Dialogue: 0,0:15:04.98,0:15:06.61,Default,,0,0,0,,Мен не істей аламын?
Dialogue: 0,0:15:06.69,0:15:08.15,Default,,0,0,0,,Әрине жоқ.
Dialogue: 0,0:15:08.24,0:15:10.07,Default,,0,0,0,,-Не... -(Саға) Жалғыз мен.
Dialogue: 0,0:15:10.15,0:15:10.95,Default,,0,0,0,,Мен?
Dialogue: 0,0:15:12.53,0:15:16.12,Default,,0,0,0,,А-дәрежелі авантюрист, лабиринт графы және қаһарман?
Dialogue: 0,0:15:16.20,0:15:18.62,Default,,0,0,0,,Әлгі кішкентай жиен?
Dialogue: 0,0:15:20.04,0:15:24.34,Default,,0,0,0,,Сонымен, ұқыпты, таза Жібек-чан және жігерлі Марина-чан.
Dialogue: 0,0:15:24.42,0:15:27.13,Default,,0,0,0,,Жабайы түрі Нене-чан Ведьма түрі Джейми-чан
Dialogue: 0,0:15:27.21,0:15:28.88,Default,,0,0,0,,Кім сүйікті?
Dialogue: 0,0:15:28.96,0:15:31.63,Default,,0,0,0,,Тоқта, олай емес.
Dialogue: 0,0:15:31.72,0:15:34.68,Default,,0,0,0,,Оның Нибельн-чан екеніне сенімдісің бе, қыз?
Dialogue: 0,0:15:34.76,0:15:37.43,Default,,0,0,0,,Шоджо-кей дегеніміз не? Бұл қыз
Dialogue: 0,0:15:37.51,0:15:40.64,Default,,0,0,0,,Вельмерияда... Жоқ, бұл кез келген елде қылмыс.
Dialogue: 0,0:15:40.73,0:15:42.85,Default,,0,0,0,,Онымен араласатыным жоқ.
Dialogue: 0,0:15:43.48,0:15:45.90,Default,,0,0,0,,Мен Рейн-Чанға қолымды ұстай аламын ба?
Dialogue: 0,0:15:45.98,0:15:46.90,Default,,0,0,0,,М-м-мұнда… мұнда… мұнда… осы зат!
Dialogue: 0,0:15:46.98,0:15:48.36,Default,,0,0,0,,Сондай жас бала
Dialogue: 0,0:15:48.44,0:15:50.40,Default,,0,0,0,,Ле... Жаңбыр меннен үлкен!
Dialogue: 0,0:15:50.49,0:15:51.95,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,0:15:52.03,0:15:55.24,Default,,0,0,0,,Бірер ай ғана... Әлде бағымды сынап көремін деуім керек пе?
Dialogue: 0,0:15:55.32,0:15:57.41,Default,,0,0,0,,Сіз қайдан білдіңіз? Жоқ...
Dialogue: 0,0:15:58.29,0:16:00.29,Default,,0,0,0,,Тіршіліктің дәлелі болды
Dialogue: 0,0:16:00.37,0:16:03.12,Default,,0,0,0,,Қарапайым халық түсінбеуі мүмкін, бірақ
Dialogue: 0,0:16:03.21,0:16:04.42,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:16:05.00,0:16:06.04,Default,,0,0,0,,Стигмат?
Dialogue: 0,0:16:06.63,0:16:10.67,Default,,0,0,0,,Дұрыс... Қарапайым тілмен айтқанда, адам болуымызға кедергі болатын элемент.
Dialogue: 0,0:16:12.42,0:16:13.93,Default,,0,0,0,,Персефонның...
Dialogue: 0,0:16:14.01,0:16:17.97,Default,,0,0,0,,Сіз оны ақшыл өлмейтін патшадан алдыңыз ба (Өмір патшасы жоқ)?
Dialogue: 0,0:16:18.06,0:16:19.06,Default,,0,0,0,,Ал...
Dialogue: 0,0:16:19.14,0:16:22.18,Default,,0,0,0,,Бұрын түссіз қараңғылыққа кіргенде
Dialogue: 0,0:16:22.69,0:16:24.90,Default,,0,0,0,,Тіпті мұндағыдан басқа әлемде
Dialogue: 0,0:16:24.98,0:16:29.07,Default,,0,0,0,,Бұл сіздің бар екендігіңізді анықтайтын куәлік сияқты.
Dialogue: 0,0:16:29.69,0:16:31.07,Default,,0,0,0,,Сертификат?
Dialogue: 0,0:16:33.45,0:16:37.62,Default,,0,0,0,,Ранның қауіпсіз болуының себебі Рог пен оның достарының қорғанысы болды.
Dialogue: 0,0:16:38.24,0:16:39.54,Default,,0,0,0,,Мен қауіпсіз болдым.
Dialogue: 0,0:16:39.62,0:16:42.71,Default,,0,0,0,,Мұның бәрі Стигматаның арқасында болды... Айтайын дегенім...
Dialogue: 0,0:16:42.79,0:16:46.38,Default,,0,0,0,,Мен Рейн-Чанға да дәл солай байланғанын сезіндім.
Dialogue: 0,0:16:46.88,0:16:48.34,Default,,0,0,0,,Сіз оны жұқтырдыңыз, солай ма?
Dialogue: 0,0:16:48.84,0:16:49.84,Default,,0,0,0,,Түсіндіңіз бе?
Dialogue: 0,0:16:49.92,0:16:50.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:59.30,0:17:00.26,Default,,0,0,0,,Денем қан-қырынға толды!
Dialogue: 0,0:17:02.31,0:17:05.10,Default,,0,0,0,,Егер мен Юке мырзадан сол стигманы аламын.
Dialogue: 0,0:17:05.19,0:17:08.19,Default,,0,0,0,,Бізге енді Tenebrae әсер етпейді, солай ма?
Dialogue: 0,0:17:08.27,0:17:09.98,Default,,0,0,0,,Дұрыс түсіну.
Dialogue: 0,0:17:10.07,0:17:11.57,Default,,0,0,0,,Ал, Юке мырза.
Dialogue: 0,0:17:11.65,0:17:13.69,Default,,0,0,0,,Бізге стигматаны беріңіз
Dialogue: 0,0:17:13.78,0:17:15.24,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:17:15.32,0:17:16.70,Default,,0,0,0,,Мен мұны талай рет айтқан болуым керек.
Dialogue: 0,0:17:16.78,0:17:18.74,Default,,0,0,0,,Мен сені жалғыз жібермеймін.
Dialogue: 0,0:17:18.82,0:17:22.70,Default,,0,0,0,,Мені отбасым деп атаған Юк мырзамен соңына дейін бірге боламын.
Dialogue: 0,0:17:22.79,0:17:24.04,Default,,0,0,0,,-Мен де -Мен де
Dialogue: 0,0:17:24.12,0:17:24.71,Default,,0,0,0,,Мен де
Dialogue: 0,0:17:25.58,0:17:27.21,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:17:27.29,0:17:29.96,Default,,0,0,0,,Мен аздап қызғанатын шығармын
Dialogue: 0,0:17:30.04,0:17:31.84,Default,,0,0,0,,Бірақ мен көзімді жұмамын
Dialogue: 0,0:17:33.21,0:17:36.38,Default,,0,0,0,,Ханымдар, сіз айтқандарыңызды мұқият ойластырып жатырсыз ба?
Dialogue: 0,0:17:36.47,0:17:38.84,Default,,0,0,0,,Сіз қайтып келе алмауыңыз мүмкін.
Dialogue: 0,0:17:38.93,0:17:40.05,Default,,0,0,0,,Сен оны білесің бе?
Dialogue: 0,0:17:40.14,0:17:43.52,Default,,0,0,0,,Жеті жапырақты бедеде шексіз бақыт бар.
Dialogue: 0,0:17:43.60,0:17:46.19,Default,,0,0,0,,Лун және басқалары үлкен ағаға сенеді.
Dialogue: 0,0:17:46.27,0:17:48.77,Default,,0,0,0,,Қандай жағдай болса да, сіз ешқашан бақытсыз болмайсыз.
Dialogue: 0,0:17:53.73,0:17:55.57,Default,,0,0,0,,Жеті жапырақ?
Dialogue: 0,0:17:56.07,0:17:57.20,Default,,0,0,0,,Белгілі бір серіктеспен ерекше командалық жұмыс көрсетуден гөрі—
Dialogue: 0,0:17:57.28,0:18:00.20,Default,,0,0,0,,Менің қыңыр жиенімнің ғашықтары бәрі қыңыр.
Dialogue: 0,0:18:00.28,0:18:01.45,Default,,0,0,0,,Ғашық...
Dialogue: 0,0:18:01.53,0:18:03.91,Default,,0,0,0,,Дайын болсаңыз, қалағаныңызды жасаңыз.
Dialogue: 0,0:18:04.62,0:18:08.25,Default,,0,0,0,,Сіз қазірдің өзінде авантюристсіз.
Dialogue: 0,0:18:15.01,0:18:18.30,Default,,0,0,0,,Сіз Кловердегі барлық адамдарға стигматалар бердіңіз бе?
Dialogue: 0,0:18:18.80,0:18:19.93,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,0:18:20.01,0:18:23.35,Default,,0,0,0,,Біз барлығын көлеңкелі аңдыушыларға айналдыра алмаймыз.
Dialogue: 0,0:18:23.43,0:18:27.10,Default,,0,0,0,,Әрине, бұл жүгіруге қажет емес, сондықтан мен ештеңе істемедім.
Dialogue: 0,0:18:27.18,0:18:30.31,Default,,0,0,0,,Мен сенен қалай деп сұрамаймын...
Dialogue: 0,0:18:31.44,0:18:34.78,Default,,0,0,0,,Жоспарлағандай, мен қазір Финиске бара жатырмын.
Dialogue: 0,0:18:34.86,0:18:36.24,Default,,0,0,0,,Түссіз қараңғылықты енгізіңіз
Dialogue: 0,0:18:36.74,0:18:38.36,Default,,0,0,0,,Бенвудпен.
Dialogue: 0,0:18:38.99,0:18:40.53,Default,,0,0,0,,Сұраймын.
Dialogue: 0,0:18:40.61,0:18:43.99,Default,,0,0,0,,Финиске тасымалдауға болатын сиқырлы құралмен (артефактпен).
Dialogue: 0,0:18:44.08,0:18:47.33,Default,,0,0,0,,Бізді алып кете алмайсың ба?
Dialogue: 0,0:18:47.41,0:18:49.54,Default,,0,0,0,,Өкінішке орай, бұл екі орындық.
Dialogue: 0,0:18:49.62,0:18:50.50,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:51.42,0:18:52.33,Default,,0,0,0,,Юк
Dialogue: 0,0:18:52.42,0:18:55.80,Default,,0,0,0,,Мұны сізге мәжбүрлегенім үшін кешіріңіз.
Dialogue: 0,0:18:56.42,0:18:59.26,Default,,0,0,0,,Бақытты өмір сүрсең де
Dialogue: 0,0:18:59.34,0:19:03.51,Default,,0,0,0,,Мәжбүрлейтін ештеңе жоқ, бұл біздің әлем.
Dialogue: 0,0:19:04.14,0:19:07.98,Default,,0,0,0,,Мен сізге шын мәнінде құрбандық шалудың қажеті жоқ екенін айтқым келеді.
Dialogue: 0,0:19:08.73,0:19:10.44,Default,,0,0,0,,Бірақ өтінемін
Dialogue: 0,0:19:12.23,0:19:13.48,Default,,0,0,0,,Алға жүр.
Dialogue: 0,0:19:15.65,0:19:17.53,Default,,0,0,0,,Бұл ностальгиялық есім.
Dialogue: 0,0:19:18.32,0:19:21.74,Default,,0,0,0,,Маған авантюрист болудың жолын көрсеткен ағам болды.
Dialogue: 0,0:19:22.32,0:19:26.03,Default,,0,0,0,,Ағам маған үнемі осылай жол көрсетеді.
Dialogue: 0,0:19:26.12,0:19:27.95,Default,,0,0,0,,Оны да айта алмайсың.
Dialogue: 0,0:19:28.45,0:19:32.33,Default,,0,0,0,,Енді саған жол көрсететін достарың бар, солай ма?
Dialogue: 0,0:19:32.42,0:19:34.71,Default,,0,0,0,,- (Юк) Мен білемін - (Сага) Жақсы.
Dialogue: 0,0:19:35.21,0:19:38.63,Default,,0,0,0,,Юк, жасайық, біз әлемді құтқарамыз.
Dialogue: 0,0:19:39.17,0:19:41.97,Default,,0,0,0,,Олай болса, Тұңғиық қақпасының алдында кездесейік.
Dialogue: 0,0:19:45.64,0:19:47.64,Default,,0,0,0,,Мен мұны сұрадым, Юк.
Dialogue: 0,0:19:47.72,0:19:49.81,Default,,0,0,0,,Мен эвакуация бойынша нұсқаулықты Ла Джоға қалдырдым.
Dialogue: 0,0:19:51.89,0:19:54.23,Default,,0,0,0,,Оны қалай қолдану керектігі есіңізде ме?
Dialogue: 0,0:19:54.31,0:19:55.94,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:19:56.61,0:19:59.53,Default,,0,0,0,,Менің дөрекілігімді кешіріңіз, тіпті Юктың алдында болса да.
Dialogue: 0,0:20:00.03,0:20:01.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:02.57,0:20:04.74,Default,,0,0,0,,Сізге үлкен рахмет, Мәртебелі.
Dialogue: 0,0:20:04.82,0:20:08.20,Default,,0,0,0,,Мұқият жүріңіз және Юкті жақсы қорғаңыз.
Dialogue: 0,0:20:09.58,0:20:10.87,Default,,0,0,0,,Міндетті түрде оралыңыз
Dialogue: 0,0:20:10.95,0:20:13.17,Default,,0,0,0,,Иә, тағы бірге шай ішейік.
Dialogue: 0,0:20:13.25,0:20:14.21,Default,,0,0,0,,Межалуна да
Dialogue: 0,0:20:14.79,0:20:15.71,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:15.79,0:20:20.05,Default,,0,0,0,,Мен Кловердің тікелей эфиріне жауапты боламын.
Dialogue: 0,0:20:20.13,0:20:22.34,Default,,0,0,0,,Бұл сенімді, Виконт.
Dialogue: 0,0:20:22.42,0:20:25.30,Default,,0,0,0,,Мен де өз міндетімді орындаймын.
Dialogue: 0,0:20:25.80,0:20:26.55,Default,,0,0,0,,Неге?! Неге?!
Dialogue: 0,0:20:26.64,0:20:28.64,Default,,0,0,0,,Иә, барамын.
Dialogue: 0,0:20:41.74,0:20:43.95,Default,,0,0,0,,Сонымен, дайынсың ба?
Dialogue: 0,0:20:44.03,0:20:46.70,Default,,0,0,0,,Мәселе жоқ! Барымызды салайық
Dialogue: 0,0:20:46.78,0:20:49.45,Default,,0,0,0,,Мен дайынмын, оны маған қалдырыңыз.
Dialogue: 0,0:20:50.12,0:20:52.58,Default,,0,0,0,,Маған алдын ала ескертуді қалдырыңыз.
Dialogue: 0,0:20:52.66,0:20:55.37,Default,,0,0,0,,Мен сізге кедергі жасамауға тырысамын.
Dialogue: 0,0:20:55.46,0:20:56.25,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:20:56.33,0:20:58.00,Default,,0,0,0,,Жүгіру де барын салады.
Dialogue: 0,0:20:58.09,0:21:00.75,Default,,0,0,0,,Иә, мен сенімен соңына дейін боламын.
Dialogue: 0,0:21:01.42,0:21:02.76,Default,,0,0,0,,Тарату басталады!
Dialogue: 0,0:21:02.84,0:21:04.76,Default,,0,0,0,,- (Камерат-кун) Тарату басталды - (Селфи-чан) Тарату басталды
Dialogue: 0,0:21:05.34,0:21:06.76,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:21:07.34,0:21:10.76,Default,,0,0,0,,Ақырзаманға ұмтылу. Мұқият ләззат алыңыз.
Dialogue: 0,0:21:11.39,0:21:14.27,Default,,0,0,0,,Жүр, жеті жапырақты беде
Dialogue: 0,0:21:14.35,0:21:15.89,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:21:16.48,0:21:18.48,Default,,0,0,0,,♪～
Dialogue: 0,0:22:43.48,0:22:45.48,Default,,0,0,0,,～♪
Dialogue: 0,0:22:47.03,0:22:49.49,Default,,0,0,0,,Келесі жолы «Күтпеген кездесу»
Dialogue: 0,0:22:50.99,0:22:56.99,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
