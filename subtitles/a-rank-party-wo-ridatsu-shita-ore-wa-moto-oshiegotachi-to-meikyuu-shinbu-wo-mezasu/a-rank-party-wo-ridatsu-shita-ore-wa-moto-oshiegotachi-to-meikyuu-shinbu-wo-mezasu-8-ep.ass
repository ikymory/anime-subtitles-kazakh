Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.17,0:00:08.25,Default,,0,0,0,,Ағамның дәрісі туралы...
Dialogue: 0,0:00:08.75,0:00:11.26,Default,,0,0,0,,Юк дайындаған медицина
Dialogue: 0,0:00:11.76,0:00:14.93,Default,,0,0,0,,Мен мұның соншалықты қымбат екенін білмедім.
Dialogue: 0,0:00:15.43,0:00:20.22,Default,,0,0,0,,Мен сенің орнында болсам, ештеңе төлемей «Танысқаныма қуаныштымын» дер едім.
Dialogue: 0,0:00:20.31,0:00:22.93,Default,,0,0,0,,Мен өзімді жек көремін.
Dialogue: 0,0:00:23.44,0:00:27.19,Default,,0,0,0,,Бұл менің өз отбасым туралы болса да, ең сорақысы.
Dialogue: 0,0:00:27.86,0:00:30.19,Default,,0,0,0,,Юк партиядан жоғалып кетті.
Dialogue: 0,0:00:30.28,0:00:33.61,Default,,0,0,0,,Сен бізді қалайша қорғадың?
Dialogue: 0,0:00:33.70,0:00:35.57,Default,,0,0,0,,Мен оны бірінші рет түсіндім
Dialogue: 0,0:00:36.20,0:00:37.53,Default,,0,0,0,,Кеш болды, солай емес пе?
Dialogue: 0,0:00:38.03,0:00:40.08,Default,,0,0,0,,А, мен сәтсіздікке ұшырадым.
Dialogue: 0,0:00:40.16,0:00:42.58,Default,,0,0,0,,Тезірек кешірім сұрауым керек еді.
Dialogue: 0,0:00:44.00,0:00:47.00,Default,,0,0,0,,Юку тәтті.
Dialogue: 0,0:00:47.08,0:00:49.71,Default,,0,0,0,,Барынша кешірім сұрасам, ол мені кешірер ме еді.
Dialogue: 0,0:00:50.21,0:00:52.59,Default,,0,0,0,,Мүмкін...
Dialogue: 0,0:00:53.21,0:00:57.26,Default,,0,0,0,,Мүмкін сен мені Кловерге шақырар едің.
Dialogue: 0,0:00:57.76,0:01:01.14,Default,,0,0,0,,Жоқ, бұл өте ыңғайлы.
Dialogue: 0,0:01:01.22,0:01:03.89,Default,,0,0,0,,Жоқ Жоқ Ағымдағы жоқ
Dialogue: 0,0:01:03.98,0:01:09.69,Default,,0,0,0,,Юк пен Кловердегілердің бәрі бақытты және бір-біріне арқа сүйейді.
Dialogue: 0,0:01:09.77,0:01:11.82,Default,,0,0,0,,Бұл бір отбасы сияқты...
Dialogue: 0,0:01:12.69,0:01:15.49,Default,,0,0,0,,Мен үшін де сондай болашақ болды ма деп ойлаймын.
Dialogue: 0,0:01:15.57,0:01:17.07,Default,,0,0,0,,Джейми!
Dialogue: 0,0:01:18.28,0:01:20.58,Default,,0,0,0,,Көрдіңіз бе, бұл сиқырлы таста бар
Dialogue: 0,0:01:20.66,0:01:24.16,Default,,0,0,0,,Thunderpike-тің көптеген теріс қылықтары жазылған.
Dialogue: 0,0:01:24.25,0:01:27.04,Default,,0,0,0,,Менің ойымша, бұл бір нәрсеге пайдалы болуы мүмкін.
Dialogue: 0,0:01:27.54,0:01:30.50,Default,,0,0,0,,Мені кешіріңіз, Юк.
Dialogue: 0,0:01:31.50,0:01:33.51,Default,,0,0,0,,♪～
Dialogue: 0,0:02:58.97,0:03:00.97,Default,,0,0,0,,～♪
Dialogue: 0,0:03:04.68,0:03:07.43,Default,,0,0,0,,Бұл өсиет сияқты.
Dialogue: 0,0:03:07.52,0:03:09.35,Default,,0,0,0,,Сіз өкіндіңіз.
Dialogue: 0,0:03:09.43,0:03:10.85,Default,,0,0,0,,Мен сәтсіздікке ұшырадым!
Dialogue: 0,0:03:10.94,0:03:14.36,Default,,0,0,0,,Джейми бізге көмектесті.
Dialogue: 0,0:03:14.44,0:03:16.36,Default,,0,0,0,,Мен оған мән бермедім.
Dialogue: 0,0:03:16.44,0:03:18.48,Default,,0,0,0,,Өзіңізді кінәламаңыз
Dialogue: 0,0:03:18.57,0:03:20.86,Default,,0,0,0,,Бұл жағдайда басқа таңдау болмады.
Dialogue: 0,0:03:21.65,0:03:24.70,Default,,0,0,0,,Негізі мен саған хабар бергім келмеді, бірақ...
Dialogue: 0,0:03:25.20,0:03:28.49,Default,,0,0,0,,Түссіз қараңғылықтан қайғылы хабар келеді.
Dialogue: 0,0:03:28.58,0:03:30.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:31.83,0:03:33.63,Default,,0,0,0,,Біреу... тыңдап жатыр ма?
Dialogue: 0,0:03:33.71,0:03:34.54,Default,,0,0,0,,Бұл Джейми.
Dialogue: 0,0:03:34.63,0:03:36.63,Default,,0,0,0,,Түссіз қараңғылық өте қауіпті
Dialogue: 0,0:03:37.42,0:03:39.51,Default,,0,0,0,,Иерархияның ыдырауы басталды...
Dialogue: 0,0:03:40.26,0:03:42.47,Default,,0,0,0,,Найзағай сиқыршысы—
Dialogue: 0,0:03:42.55,0:03:44.89,Default,,0,0,0,,Сіз бұл Джейми Осен екеніне сенімдісіз бе?
Dialogue: 0,0:03:45.60,0:03:48.14,Default,,0,0,0,,Мен қазір көмекке жіберу-жібермеу мәселесін талқылап жатырмын...
Dialogue: 0,0:03:48.22,0:03:50.39,Default,,0,0,0,,Мені шығаруыңызды өтінемін, жоқ...
Dialogue: 0,0:03:51.14,0:03:52.14,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:03:52.23,0:03:55.94,Default,,0,0,0,,Ей, сен әлі жақсы күйде емес шығарсың.
Dialogue: 0,0:03:56.02,0:03:56.90,Default,,0,0,0,,Абайсызда болмаңыз
Dialogue: 0,0:03:57.57,0:03:58.82,Default,,0,0,0,,Мені жіберіңізші
Dialogue: 0,0:03:58.90,0:04:00.49,Default,,0,0,0,,Мен қалдым...
Dialogue: 0,0:04:01.74,0:04:02.78,Default,,0,0,0,,Достар
Dialogue: 0,0:04:03.61,0:04:06.32,Default,,0,0,0,,Шығудың басқа шиыршығын табыңыз.
Dialogue: 0,0:04:06.82,0:04:07.66,Default,,0,0,0,,Садақ
Dialogue: 0,0:04:07.74,0:04:11.29,Default,,0,0,0,,Көмек жіберу-жібермеу туралы шешім қабылдаймын.
Dialogue: 0,0:04:15.63,0:04:17.71,Default,,0,0,0,,Мен құтқаруға жалғыз барамын.
Dialogue: 0,0:04:17.79,0:04:21.01,Default,,0,0,0,,Жоқ, Джейми мырза құтқарушы.
Dialogue: 0,0:04:21.09,0:04:22.84,Default,,0,0,0,,Мен де сенің соңынан еремін.
Dialogue: 0,0:04:22.92,0:04:25.30,Default,,0,0,0,,Жалғыз мұғалім болсаң, асығасың, солай ма?
Dialogue: 0,0:04:25.39,0:04:26.97,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:04:27.05,0:04:28.05,Default,,0,0,0,,Мен де барамын
Dialogue: 0,0:04:28.14,0:04:32.39,Default,,0,0,0,,Бұл маған байланысты болғандықтан, мен ең қауіпті болдым.
Dialogue: 0,0:04:32.89,0:04:34.56,Default,,0,0,0,,Сондықтан мен кетуім керек
Dialogue: 0,0:04:34.64,0:04:36.52,Default,,0,0,0,,Жаңбыр, мұнда кел.
Dialogue: 0,0:04:36.60,0:04:38.19,Default,,0,0,0,,Иә? Иә
Dialogue: 0,0:04:40.90,0:04:46.57,Default,,0,0,0,,Бұрмаланған күлімсіреу, үмітсіздік тізбегі, үзілген редуктор
Dialogue: 0,0:04:47.07,0:04:48.20,Default,,0,0,0,,Сиқырлы жойылу (сиқырды жою)
Dialogue: 0,0:04:53.04,0:04:53.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:54.04,0:04:57.67,Default,,0,0,0,,Ол шықты ма? Мен мұндай сиқырды білмеймін
Dialogue: 0,0:04:57.75,0:05:00.13,Default,,0,0,0,,Менің ойымша, бұл қара магия шығар.
Dialogue: 0,0:05:00.21,0:05:00.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:01.30,0:05:02.84,Default,,0,0,0,,Менің ішімде болса керек
Dialogue: 0,0:05:02.92,0:05:06.05,Default,,0,0,0,,Сіз білмейтін сиқырлар немесе дағдылар сіздің денеңізге бұралған
Dialogue: 0,0:05:06.68,0:05:08.18,Default,,0,0,0,,Мөр...
Dialogue: 0,0:05:08.68,0:05:11.18,Default,,0,0,0,,Ол Өлмейтін Патшаның (Өмір Патшасы жоқ) елшісі болған сияқты.
Dialogue: 0,0:05:11.68,0:05:13.85,Default,,0,0,0,,Ғибадатханада үндемеңіз.
Dialogue: 0,0:05:13.93,0:05:15.23,Default,,0,0,0,,Күлкілі емес
Dialogue: 0,0:05:15.31,0:05:17.85,Default,,0,0,0,,Сонымен... жақсысың ба?
Dialogue: 0,0:05:17.94,0:05:19.48,Default,,0,0,0,,Әзірге ешқандай проблема жоқ
Dialogue: 0,0:05:20.11,0:05:21.48,Default,,0,0,0,,Өлім құдайы ретінде
Dialogue: 0,0:05:21.57,0:05:23.57,Default,,0,0,0,,Менің ойымша, ол мені ұнатты.
Dialogue: 0,0:05:25.78,0:05:27.49,Default,,0,0,0,,Мен әркімнің сезімін түсінемін.
Dialogue: 0,0:05:27.57,0:05:30.12,Default,,0,0,0,,Жәмиге көмектесейік.
Dialogue: 0,0:05:30.20,0:05:30.99,Default,,0,0,0,,(Есікті қағу)
Dialogue: 0,0:05:31.08,0:05:32.54,Default,,0,0,0,,Эй, аш!
Dialogue: 0,0:05:32.62,0:05:34.75,Default,,0,0,0,,Қайтып келдіңіз бе? Тез ашыңыз!
Dialogue: 0,0:05:35.33,0:05:36.54,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:05:36.62,0:05:38.75,Default,,0,0,0,,Сұраудың қажеті жоқ.
Dialogue: 0,0:05:39.33,0:05:40.17,Default,,0,0,0,,Эй!
Dialogue: 0,0:05:41.13,0:05:44.01,Default,,0,0,0,,Оны бірден ашыңыз!
Dialogue: 0,0:05:44.09,0:05:47.76,Default,,0,0,0,,Бұдан былай мен сенің қожайын боламын.
Dialogue: 0,0:05:47.84,0:05:50.51,Default,,0,0,0,,Кешіріңіз, бірақ менің үйіме кірмеңіз.
Dialogue: 0,0:05:50.60,0:05:52.51,Default,,0,0,0,,Бұл қандай көзқарас?
Dialogue: 0,0:05:52.60,0:05:54.02,Default,,0,0,0,,Қара, қара, мен бастаған ісімді аяқтай алмаған адам боламын—
Dialogue: 0,0:05:55.31,0:05:56.31,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:58.10,0:05:59.15,Default,,0,0,0,,Гррр…
Dialogue: 0,0:05:59.65,0:06:01.61,Default,,0,0,0,,Саймоннан үлкен үміт күтсең
Dialogue: 0,0:06:01.69,0:06:03.44,Default,,0,0,0,,Сіз өз ойыңызды өзгертуіңіз керек
Dialogue: 0,0:06:03.94,0:06:05.03,Default,,0,0,0,,Ол қайтыс болды
Dialogue: 0,0:06:05.11,0:06:08.78,Default,,0,0,0,,Жоқ, бірақ мақсат орындалды.
Dialogue: 0,0:06:08.86,0:06:10.66,Default,,0,0,0,,Жаңбыр, шық.
Dialogue: 0,0:06:10.74,0:06:12.16,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:06:12.24,0:06:15.08,Default,,0,0,0,,Маған кек сақтаған демеушісің бе?
Dialogue: 0,0:06:15.58,0:06:18.16,Default,,0,0,0,,Сіз сондай-ақ заңсыз сиқырлы құралдарды (артефактілерді) дайындадыңыз.
Dialogue: 0,0:06:18.25,0:06:20.67,Default,,0,0,0,,Жаңбыр! жаңбыр!
Dialogue: 0,0:06:22.84,0:06:24.42,Default,,0,0,0,,Жаңбыр…
Dialogue: 0,0:06:24.50,0:06:27.17,Default,,0,0,0,,Жүр, мұнда кел.
Dialogue: 0,0:06:27.26,0:06:28.67,Default,,0,0,0,,-Рей... -Хехе!
Dialogue: 0,0:06:28.76,0:06:29.43,Default,,0,0,0,,N?
Dialogue: 0,0:06:29.51,0:06:31.18,Default,,0,0,0,,Хикаки Борг!
Dialogue: 0,0:06:31.26,0:06:32.18,Default,,0,0,0,,Боа…
Dialogue: 0,0:06:32.26,0:06:35.06,Default,,0,0,0,,-(Юк) Ле... Жаңбыр -Жақсы.
Dialogue: 0,0:06:37.27,0:06:39.27,Default,,0,0,0,,Бұл маңызды куәгер.
Dialogue: 0,0:06:39.35,0:06:42.06,Default,,0,0,0,,Оның үстіне мен оны өлтірсем қиын болар еді.
Dialogue: 0,0:06:42.15,0:06:44.73,Default,,0,0,0,,Мен Юкенің қиындыққа тап болғанын қаламаймын.
Dialogue: 0,0:06:44.82,0:06:45.69,Default,,0,0,0,,Шығыңыз
Dialogue: 0,0:06:46.19,0:06:48.40,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:48.49,0:06:50.78,Default,,0,0,0,,Уа, мен не істесем де...
Dialogue: 0,0:06:52.03,0:06:55.70,Default,,0,0,0,,Сіз маған осындай киім киюді сұрадыңыз, солай ма?
Dialogue: 0,0:06:55.79,0:06:57.08,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:57.16,0:06:58.25,Default,,0,0,0,,(Роко) Һм? (Масато) Хехехе
Dialogue: 0,0:06:58.75,0:07:00.08,Default,,0,0,0,,Ширауды одан сайын тартыңыз!
Dialogue: 0,0:07:01.17,0:07:02.25,Default,,0,0,0,,А... а...
Dialogue: 0,0:07:02.33,0:07:04.29,Default,,0,0,0,,Келесі жолы мен келемін
Dialogue: 0,0:07:04.38,0:07:07.59,Default,,0,0,0,,Оны өлудің ең жаман жолы деп ойлаңыз...
Dialogue: 0,0:07:07.67,0:07:09.72,Default,,0,0,0,,О, жақсы...
Dialogue: 0,0:07:09.80,0:07:13.34,Default,,0,0,0,,Жаңбыр, саған кел...
Dialogue: 0,0:07:13.43,0:07:15.93,Default,,0,0,0,,Мені жайбарақат атама
Dialogue: 0,0:07:18.81,0:07:21.81,Default,,0,0,0,,Өйткені мен қазірдің өзінде Юкке тиесілімін.
Dialogue: 0,0:07:21.89,0:07:22.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:22.85,0:07:24.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:24.11,0:07:27.44,Default,,0,0,0,,Бұл... бұл өтірік.
Dialogue: 0,0:07:27.53,0:07:30.15,Default,,0,0,0,,Тағы бір нәрсені қосайын.
Dialogue: 0,0:07:30.24,0:07:34.24,Default,,0,0,0,,Қарғыс атқан ханшайым, мына кісінің жүрегін құлыпта.
Dialogue: 0,0:07:34.74,0:07:38.54,Default,,0,0,0,,Өсиетті бұзғандарға, Қанына қайнаған май құй.
Dialogue: 0,0:07:39.37,0:07:41.21,Default,,0,0,0,,Эй... Гуа!
Dialogue: 0,0:07:41.29,0:07:45.67,Default,,0,0,0,,Жаңбырға жақындағанда қаным қайнап өлдім.
Dialogue: 0,0:07:46.25,0:07:47.21,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:07:48.00,0:07:49.92,Default,,0,0,0,,Болашақта абай болыңыз
Dialogue: 0,0:07:50.01,0:07:51.55,Default,,0,0,0,,Сол сұм Боинго! Ең болмағанда қазір! Мылтығым➡
Dialogue: 0,0:07:51.63,0:07:53.22,Default,,0,0,0,,Марина Нене
Dialogue: 0,0:07:53.72,0:07:56.26,Default,,0,0,0,,Сіз бұл жігітті Патшалық аудиторына тапсыра аласыз ба?
Dialogue: 0,0:07:56.35,0:07:58.68,Default,,0,0,0,,-Мен бақыттымын -Саған қалдырамын.
Dialogue: 0,0:08:00.77,0:08:03.81,Default,,0,0,0,,Қару-жарақ пен сауыт дайын
Dialogue: 0,0:08:03.90,0:08:06.36,Default,,0,0,0,,Барлық дәрілер осында.
Dialogue: 0,0:08:06.44,0:08:07.98,Default,,0,0,0,,Тамақ та жарайды.
Dialogue: 0,0:08:08.07,0:08:09.82,Default,,0,0,0,,Сіз қазір кете аласыз.
Dialogue: 0,0:08:10.40,0:08:12.32,Default,,0,0,0,,Жоқ, ең бастысы
Dialogue: 0,0:08:12.40,0:08:14.36,Default,,0,0,0,,«Шығу» сызбасы әлі жоқ
Dialogue: 0,0:08:14.45,0:08:16.78,Default,,0,0,0,,Қызық, Ғылмас та табылмады ма?
Dialogue: 0,0:08:16.87,0:08:18.45,Default,,0,0,0,,Өйткені бұл сирек
Dialogue: 0,0:08:18.53,0:08:19.45,Default,,0,0,0,,(Есікті қағу)
Dialogue: 0,0:08:20.41,0:08:22.83,Default,,0,0,0,,Скордиядан келген Люсент
Dialogue: 0,0:08:22.91,0:08:24.71,Default,,0,0,0,,Юк Фердио осында ма?
Dialogue: 0,0:08:25.29,0:08:26.42,Default,,0,0,0,,Люсент?
Dialogue: 0,0:08:30.42,0:08:32.84,Default,,0,0,0,,Біз бірінші рет жүзбе-жүз кездесіп тұрмыз.
Dialogue: 0,0:08:33.34,0:08:34.84,Default,,0,0,0,,Юк Фердио
Dialogue: 0,0:08:35.51,0:08:37.35,Default,,0,0,0,,Осыны іздеп жүргеніңізді естідім.
Dialogue: 0,0:08:37.43,0:08:39.60,Default,,0,0,0,,Шығу айналдыру…
Dialogue: 0,0:08:39.68,0:08:43.14,Default,,0,0,0,,Сіз түссіз қараңғылыққа тағы да қарсы шыққыңыз келе ме?
Dialogue: 0,0:08:43.23,0:08:44.48,Default,,0,0,0,,Солай болады.
Dialogue: 0,0:08:44.56,0:08:45.90,Default,,0,0,0,,Сізден сұраңыз
Dialogue: 0,0:08:46.40,0:08:48.73,Default,,0,0,0,,Неліктен түссіз қараңғылыққа қарсы тұрсың?
Dialogue: 0,0:08:49.36,0:08:50.98,Default,,0,0,0,,Достарыма көмектесу
Dialogue: 0,0:08:51.78,0:08:54.32,Default,,0,0,0,,Ол біздің құтқарушы еді...
Dialogue: 0,0:08:54.82,0:08:56.99,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,0:08:58.20,0:08:59.12,Default,,0,0,0,,Иә
Dialogue: 0,0:08:59.70,0:09:00.58,Default,,0,0,0,,Жарайды, жүр.
Dialogue: 0,0:09:00.66,0:09:01.95,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,0:09:02.45,0:09:06.87,Default,,0,0,0,,Егер авантюрист ненің маңызды екенін білсе, бұл жақсы.
Dialogue: 0,0:09:07.46,0:09:09.67,Default,,0,0,0,,Егер сіз оны қайтара алсаңыз, оны қайтарыңыз.
Dialogue: 0,0:09:11.09,0:09:12.38,Default,,0,0,0,,Рахмет
Dialogue: 0,0:09:12.46,0:09:14.30,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:09:14.38,0:09:16.51,Default,,0,0,0,,Люсент мырза жаңадан бастады.
Dialogue: 0,0:09:16.59,0:09:20.35,Default,,0,0,0,,Кештің жартысы лабиринтте жойылды деп естідім.
Dialogue: 0,0:09:20.43,0:09:22.47,Default,,0,0,0,,Меніңше, бәрі дұрыс емес.
Dialogue: 0,0:09:22.97,0:09:26.14,Default,,0,0,0,,Мен оны әлі де уақытында жасай аламын.
Dialogue: 0,0:09:29.73,0:09:32.15,Default,,0,0,0,,Түссіз қараңғылық жабылды.
Dialogue: 0,0:09:32.23,0:09:33.99,Default,,0,0,0,,Мәжбүрлеп кіру
Dialogue: 0,0:09:34.07,0:09:37.78,Default,,0,0,0,,Менің лауазымыма байланысты мен сізді жазалауым керек.
Dialogue: 0,0:09:38.28,0:09:39.57,Default,,0,0,0,,Сіз әлі барасыз ба?
Dialogue: 0,0:09:39.66,0:09:40.49,Default,,0,0,0,,Әрине
Dialogue: 0,0:09:40.58,0:09:43.91,Default,,0,0,0,,Егер сіз осы жерден шегінсеңіз, авантюрист ретінде дисквалификацияланасыз.
Dialogue: 0,0:09:44.00,0:09:46.83,Default,,0,0,0,,Өзінің қыңырлығымен Сағаға ұқсайды.
Dialogue: 0,0:09:46.91,0:09:47.79,Default,,0,0,0,,Хаа…
Dialogue: 0,0:09:47.87,0:09:50.88,Default,,0,0,0,,Бірақ Джейми қайда?
Dialogue: 0,0:09:50.96,0:09:52.50,Default,,0,0,0,,Сіз оны таба аласыз ба?
Dialogue: 0,0:09:52.59,0:09:54.13,Default,,0,0,0,,Менің ойымша, бұл қалай болады.
Dialogue: 0,0:09:54.63,0:09:57.55,Default,,0,0,0,,Түссіз қараңғылықтың сипаттамаларын жүйелеуге тырыстым.
Dialogue: 0,0:09:58.63,0:10:01.35,Default,,0,0,0,,Баспалдақ сияқты жалпы аумақтан бастап
Dialogue: 0,0:10:01.43,0:10:02.97,Default,,0,0,0,,Көптеген әртүрлі аймақтар...
Dialogue: 0,0:10:03.47,0:10:06.56,Default,,0,0,0,,Басқаша айтқанда, бұл сізді басқа әлемге апаратын зындан.
Dialogue: 0,0:10:06.64,0:10:08.44,Default,,0,0,0,,Бұл интерпретация ма?
Dialogue: 0,0:10:09.02,0:10:10.61,Default,,0,0,0,,Ал баратын жер
Dialogue: 0,0:10:10.69,0:10:14.69,Default,,0,0,0,,Менің ойымша, бұл біздің авантюрист ретіндегі санадан тыс анықталады.
Dialogue: 0,0:10:15.40,0:10:18.20,Default,,0,0,0,,Бенвуд пен Мамару-сан суға түскенде
Dialogue: 0,0:10:18.28,0:10:21.70,Default,,0,0,0,,Түссіз қараңғылық – ең қиын зындан, ең терең жер...
Dialogue: 0,0:10:22.28,0:10:23.70,Default,,0,0,0,,Мен солай ойлауым керек еді.
Dialogue: 0,0:10:23.78,0:10:25.20,Default,,0,0,0,,Әрине
Dialogue: 0,0:10:25.79,0:10:27.96,Default,,0,0,0,,Оған зындан жауап берді ме?
Dialogue: 0,0:10:28.04,0:10:29.25,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:29.33,0:10:31.83,Default,,0,0,0,,Сондықтан балалар аномалияларды іздедіңіздер.
Dialogue: 0,0:10:31.92,0:10:36.17,Default,,0,0,0,,Біз ең аномальды сұр өріске тез жеттік.
Dialogue: 0,0:10:36.67,0:10:40.01,Default,,0,0,0,,Енді осы арқылы бізді зынданға жіберіңіз.
Dialogue: 0,0:10:40.09,0:10:42.26,Default,,0,0,0,,Мен оны Джеймиге апарамын деп ойлаймын.
Dialogue: 0,0:10:42.76,0:10:45.89,Default,,0,0,0,,Джеймиді іздеу сезімі күшті барлық адамдар
Dialogue: 0,0:10:45.97,0:10:46.85,Default,,0,0,0,,Иә
Dialogue: 0,0:10:48.27,0:10:49.56,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:10:51.60,0:10:53.23,Default,,0,0,0,,Мұқият жүріңіз
Dialogue: 0,0:10:53.31,0:10:55.36,Default,,0,0,0,,Құтқару тобын күту режимінде ұстау
Dialogue: 0,0:10:55.94,0:10:58.99,Default,,0,0,0,,Сонымен қатар, олардан мерекеге арналған тәттілер мен тағамдар ұйымдастыруды сұраңыз.
Dialogue: 0,0:10:59.07,0:11:00.49,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:11:01.36,0:11:02.49,Default,,0,0,0,,Олай болса, кеттік
Dialogue: 0,0:11:02.57,0:11:03.49,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:11:04.45,0:11:06.29,Default,,0,0,0,,Мұқият ләззат алыңыз!
Dialogue: 0,0:11:10.08,0:11:12.08,Default,,0,0,0,,Се-жоқ... Бар!
Dialogue: 0,0:11:13.08,0:11:15.67,Default,,0,0,0,,Сыни қарудың сиқыршысы
Dialogue: 0,0:11:15.75,0:11:17.13,Default,,0,0,0,,Жалынды сызат!
Dialogue: 0,0:11:19.47,0:11:21.63,Default,,0,0,0,,Сиқырлы қылыштың өзгеруі! Хааааааа!
Dialogue: 0,0:11:28.56,0:11:31.06,Default,,0,0,0,,Жер, күнәкарларды таспен ат.
Dialogue: 0,0:11:31.14,0:11:32.73,Default,,0,0,0,,Тас оқ!
Dialogue: 0,0:11:34.69,0:11:36.36,Default,,0,0,0,,Мұғалім, аяқтаңыз!
Dialogue: 0,0:11:36.44,0:11:37.48,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:11:37.57,0:11:38.57,Default,,0,0,0,,Хмф!
Dialogue: 0,0:11:39.57,0:11:40.24,Default,,0,0,0,,Әй!
Dialogue: 0,0:11:46.83,0:11:48.83,Default,,0,0,0,,Жарайды, әрі қарай жүрейік.
Dialogue: 0,0:11:54.54,0:11:55.58,Default,,0,0,0,,Соңғысы, бәрібір тағы бір сапар шегу ғана қолымнан келеді
Dialogue: 0,0:11:55.67,0:11:59.00,Default,,0,0,0,,Джейми тұрған жерге өтейік.
Dialogue: 0,0:11:59.84,0:12:00.76,Default,,0,0,0,,Мен көрдім
Dialogue: 0,0:12:00.84,0:12:04.30,Default,,0,0,0,,Бұл тағы да сұр өріс емес деп үміттенемін.
Dialogue: 0,0:12:06.14,0:12:08.76,Default,,0,0,0,,Өткізу сәтті болған сияқты.
Dialogue: 0,0:12:09.47,0:12:11.27,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:12:11.35,0:12:15.40,Default,,0,0,0,,Ол құлады, бірақ Финис... солай ма?
Dialogue: 0,0:12:15.98,0:12:18.40,Default,,0,0,0,,Тез Джеймиге көмектесіп, үйге қайтайық.
Dialogue: 0,0:12:20.23,0:12:21.90,Default,,0,0,0,,Қан дақтары... а
Dialogue: 0,0:12:22.61,0:12:24.16,Default,,0,0,0,,Ол екінші жағынан жалғасады.
Dialogue: 0,0:12:24.82,0:12:26.57,Default,,0,0,0,,Мен Джеймидің қайда бара жатқанын білемін.
Dialogue: 0,0:12:26.66,0:12:27.66,Default,,0,0,0,,Қайда?
Dialogue: 0,0:12:29.83,0:12:31.29,Default,,0,0,0,,Мен ағамның үйіне бардым.
Dialogue: 0,0:12:32.29,0:12:33.25,Default,,0,0,0,,Джейми!
Dialogue: 0,0:12:36.04,0:12:37.13,Default,,0,0,0,,Сол пәтер.
Dialogue: 0,0:12:37.63,0:12:38.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:39.13,0:12:39.96,Default,,0,0,0,,Джейми!
Dialogue: 0,0:12:40.75,0:12:42.05,Default,,0,0,0,,Сәлем Юк
Dialogue: 0,0:12:42.13,0:12:43.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:43.13,0:12:45.22,Default,,0,0,0,,Сенің ол жақтан келе жатқаныңа сене алар емеспін.
Dialogue: 0,0:12:45.30,0:12:46.55,Default,,0,0,0,,Бұл мені көп қиындықтан құтқарды.
Dialogue: 0,0:12:47.89,0:12:50.85,Default,,0,0,0,,Саймон, неге...
Dialogue: 0,0:12:50.93,0:12:51.93,Default,,0,0,0,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:12:52.02,0:12:54.31,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:12:54.39,0:12:56.81,Default,,0,0,0,,Жоқ, сіз өлген болуыңыз керек.
Dialogue: 0,0:12:57.61,0:13:00.57,Default,,0,0,0,,Ол адам бұл дүниелік емес.
Dialogue: 0,0:13:01.15,0:13:03.07,Default,,0,0,0,,Бұл көлеңкелі адам сияқты (көлеңке аңдыушы)
Dialogue: 0,0:13:05.03,0:13:07.62,Default,,0,0,0,,-(Юк) Солай ма? -Юк?
Dialogue: 0,0:13:07.70,0:13:10.70,Default,,0,0,0,,Весио ұсынған заңсыз артефактілердің қатарында
Dialogue: 0,0:13:11.20,0:13:13.95,Default,,0,0,0,,Кейбір қауіпті нәрселер орын алуы мүмкін еді.
Dialogue: 0,0:13:14.04,0:13:17.08,Default,,0,0,0,,Тірі қалу үшін мен өзімді өлмегенге айналдырдым...
Dialogue: 0,0:13:18.67,0:13:21.71,Default,,0,0,0,,Енді, мойындау уақыты келді.
Dialogue: 0,0:13:21.80,0:13:24.47,Default,,0,0,0,,Юк! Өліп, сәлем айт!
Dialogue: 0,0:13:24.55,0:13:25.47,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:27.05,0:13:29.68,Default,,0,0,0,,Марина! Физикалық сиқырлық!
Dialogue: 0,0:13:32.06,0:13:33.47,Default,,0,0,0,,Иә! Хмф!
Dialogue: 0,0:13:33.56,0:13:35.31,Default,,0,0,0,,(Ринраку) Бұл тек бір теория ғана, бірақ адам еті мен қанын жеудің орнына, Незуко…
Dialogue: 0,0:13:35.85,0:13:37.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:37.44,0:13:38.23,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:13:40.06,0:13:42.53,Default,,0,0,0,,Тааааа!
Dialogue: 0,0:13:44.90,0:13:46.99,Default,,0,0,0,,Ауырды...!
Dialogue: 0,0:13:49.70,0:13:52.24,Default,,0,0,0,,-Ол кісі... -Оның қолы
Dialogue: 0,0:13:52.33,0:13:55.25,Default,,0,0,0,,Мен өлмейтін болдым.
Dialogue: 0,0:13:55.87,0:13:58.42,Default,,0,0,0,,Бұл жақсы, Юк, бұл жасырын.
Dialogue: 0,0:13:58.50,0:14:02.50,Default,,0,0,0,,Неге сен ғана аяныштысың?
Dialogue: 0,0:14:02.59,0:14:06.01,Default,,0,0,0,,Мен қызғанамын Мен қызғанамын
Dialogue: 0,0:14:06.59,0:14:08.51,Default,,0,0,0,,Сондықтан Юк
Dialogue: 0,0:14:08.59,0:14:12.05,Default,,0,0,0,,Бәрін алып, таптағым келеді.
Dialogue: 0,0:14:12.14,0:14:13.39,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:14:13.47,0:14:16.68,Default,,0,0,0,,Сәлем? Юк!
Dialogue: 0,0:14:17.31,0:14:19.60,Default,,0,0,0,,Lightshield шиыршығын іске қосыңыз!
Dialogue: 0,0:14:23.19,0:14:26.44,Default,,0,0,0,,Саймон... Саймон енді адам емес.
Dialogue: 0,0:14:27.03,0:14:29.95,Default,,0,0,0,,Бұл затты ұрып, Джеймиді құтқарыңыз.
Dialogue: 0,0:14:30.53,0:14:31.20,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:14:32.78,0:14:33.70,Default,,0,0,0,,Күз!
Dialogue: 0,0:14:35.83,0:14:36.54,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:36.62,0:14:39.79,Default,,0,0,0,,Жер, жартас тістеріңмен жауды тесіп ал.
Dialogue: 0,0:14:39.87,0:14:41.42,Default,,0,0,0,,- Ағаш рухы! - Рок-брейк!
Dialogue: 0,0:14:42.79,0:14:44.13,Default,,0,0,0,,Мынадай нәрсе...
Dialogue: 0,0:14:46.88,0:14:48.67,Default,,0,0,0,,Юк!
Dialogue: 0,0:14:48.76,0:14:50.22,Default,,0,0,0,,Саймон!
Dialogue: 0,0:14:51.72,0:14:54.14,Default,,0,0,0,,Уууу!
Dialogue: 0,0:14:54.89,0:14:58.39,Default,,0,0,0,,Ештеңе жоқ, биікке жеттім.
Dialogue: 0,0:14:59.18,0:15:02.27,Default,,0,0,0,,Осы өлмейтін денеммен ешкімге ұтыла алмаймын.
Dialogue: 0,0:15:02.35,0:15:03.77,Default,,0,0,0,,Ешкім қорықпайды
Dialogue: 0,0:15:03.86,0:15:04.77,Default,,0,0,0,,Саймон!
Dialogue: 0,0:15:04.86,0:15:08.53,Default,,0,0,0,,Юк Мен сені және достарыңды міндетті түрде өлтіремін.
Dialogue: 0,0:15:08.61,0:15:12.03,Default,,0,0,0,,Мені өлуге тастап кеткеніңді ешқашан кешірмеймін!
Dialogue: 0,0:15:12.11,0:15:14.41,Default,,0,0,0,,Саймон, сен...
Dialogue: 0,0:15:19.50,0:15:23.29,Default,,0,0,0,,Шіріген раушан гүлінің иісі, қара иттің ұлыған үні...
Dialogue: 0,0:15:23.38,0:15:25.29,Default,,0,0,0,,Не істесең де босқа
Dialogue: 0,0:15:25.38,0:15:29.55,Default,,0,0,0,,Ақ пен қара араласып, жан дүниенің құйынында жоғалады.
Dialogue: 0,0:15:30.38,0:15:32.55,Default,,0,0,0,,Жылау 5-деңгейдегі сиқыр
Dialogue: 0,0:15:34.14,0:15:36.06,Default,,0,0,0,,Бұрмаланған жарқыраған жебе (призмалық ракета)!
Dialogue: 0,0:15:36.14,0:15:36.81,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:15:42.48,0:15:45.36,Default,,0,0,0,,Мен айттым ғой, солай ма? мен өлмеймін
Dialogue: 0,0:15:45.44,0:15:48.61,Default,,0,0,0,,Өлмейтін тәніңізде қалағаныңызша ләззат алыңыз.
Dialogue: 0,0:15:50.40,0:15:51.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:51.70,0:15:52.95,Default,,0,0,0,,Ахх!
Dialogue: 0,0:15:54.45,0:15:56.37,Default,,0,0,0,,Уф... Бұл не?
Dialogue: 0,0:15:56.87,0:15:58.95,Default,,0,0,0,,Гррр... Гррр! Уф...
Dialogue: 0,0:15:59.04,0:16:00.50,Default,,0,0,0,,Оны аяқтау дұрыс па?
Dialogue: 0,0:16:01.16,0:16:04.04,Default,,0,0,0,,Егер дене өлуі мүмкін болса, ол әлдеқашан өлді.
Dialogue: 0,0:16:04.12,0:16:05.50,Default,,0,0,0,,Маған не істедің!
Dialogue: 0,0:16:05.58,0:16:08.96,Default,,0,0,0,,Теориялық тұрғыдан, ол сиқырды өлгенше бұзу мүмкін емес.
Dialogue: 0,0:16:09.46,0:16:12.63,Default,,0,0,0,,Призмалық зымыран Персефонның қарғыс күшімен өзгертілді.
Dialogue: 0,0:16:12.72,0:16:14.18,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:14.26,0:16:17.39,Default,,0,0,0,,Юк Біз доспыз, солай ма?
Dialogue: 0,0:16:17.47,0:16:20.39,Default,,0,0,0,,Юку... Юку!
Dialogue: 0,0:16:20.47,0:16:22.31,Default,,0,0,0,,Ах... аааа!
Dialogue: 0,0:16:22.39,0:16:23.77,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:27.40,0:16:28.73,Default,,0,0,0,,Сіз қалай ойлайсыз? жаңбыр
Dialogue: 0,0:16:29.86,0:16:32.07,Default,,0,0,0,,Жара терең...
Dialogue: 0,0:16:32.15,0:16:33.36,Default,,0,0,0,,Юк…
Dialogue: 0,0:16:34.36,0:16:35.03,Default,,0,0,0,,Джейми
Dialogue: 0,0:16:35.82,0:16:38.53,Default,,0,0,0,,Аха... Бұл Юк.
Dialogue: 0,0:16:39.16,0:16:40.37,Default,,0,0,0,,Емдік сусындар туралы не деуге болады?
Dialogue: 0,0:16:40.45,0:16:41.70,Default,,0,0,0,,Әлі де бар
Dialogue: 0,0:16:41.79,0:16:42.79,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:16:45.21,0:16:47.04,Default,,0,0,0,,Жара жабылмайды
Dialogue: 0,0:16:47.63,0:16:50.05,Default,,0,0,0,,Симонның сиқырлы қылышының әсері
Dialogue: 0,0:16:50.63,0:16:53.09,Default,,0,0,0,,Мен енді мұны істей алмаймын ...
Dialogue: 0,0:16:53.17,0:16:54.51,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:16:55.80,0:16:57.64,Default,,0,0,0,,Бұл Персефонда ойылған
Dialogue: 0,0:16:58.14,0:17:01.85,Default,,0,0,0,,Бұл сиқыр ма, әлде не екенін білмеймін.
Dialogue: 0,0:17:02.39,0:17:03.56,Default,,0,0,0,,Бірақ егер бұл...
Dialogue: 0,0:17:04.14,0:17:05.52,Default,,0,0,0,,Сиқырды жою
Dialogue: 0,0:17:09.02,0:17:11.53,Default,,0,0,0,,Сиқырлы жұмыс...
Dialogue: 0,0:17:14.53,0:17:16.16,Default,,0,0,0,,Юк…
Dialogue: 0,0:17:19.87,0:17:20.62,Default,,0,0,0,,Джейми!
Dialogue: 0,0:17:21.12,0:17:23.29,Default,,0,0,0,,Менің ойымша, қазір бәрі жақсы.
Dialogue: 0,0:17:23.87,0:17:28.54,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:17:30.63,0:17:32.55,Default,,0,0,0,,Жарайды, үйге қайтайық.
Dialogue: 0,0:17:33.30,0:17:35.05,Default,,0,0,0,,Тезірек кеткеніміз жөн сияқты.
Dialogue: 0,0:17:46.39,0:17:47.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:48.60,0:17:50.69,Default,,0,0,0,,Жаңа түрдегі рух толқыны пайда болды!
Dialogue: 0,0:17:50.77,0:17:53.69,Default,,0,0,0,,(Симонның айқайы)
Dialogue: 0,0:17:54.90,0:17:59.03,Default,,0,0,0,,Ол кісі осында мәңгілік азап шегеді.
Dialogue: 0,0:18:00.37,0:18:02.12,Default,,0,0,0,,Мен осылай жасадым.
Dialogue: 0,0:18:02.20,0:18:03.95,Default,,0,0,0,,Ахх!
Dialogue: 0,0:18:04.66,0:18:05.54,Default,,0,0,0,,Және…
Dialogue: 0,0:18:06.04,0:18:07.96,Default,,0,0,0,,Дио…
Dialogue: 0,0:18:08.04,0:18:10.96,Default,,0,0,0,,Ал мен оны қазір қалдырамын.
Dialogue: 0,0:18:12.67,0:18:14.34,Default,,0,0,0,,Шығу шиыршығын тексеріңіз!
Dialogue: 0,0:18:17.63,0:18:21.39,Default,,0,0,0,,Қош бол, бұрын Саймон болған
Dialogue: 0,0:18:22.26,0:18:26.64,Default,,0,0,0,,Қош бол, бір рет досым.
Dialogue: 0,0:18:30.27,0:18:31.10,Default,,0,0,0,,Юк
Dialogue: 0,0:18:31.19,0:18:35.53,Default,,0,0,0,,Кешіріңіз, бірақ мен Кловерді жазалауым керек.
Dialogue: 0,0:18:35.61,0:18:37.95,Default,,0,0,0,,Құлыптау туралы шешім қабылданды, мен зынданға кірдім.
Dialogue: 0,0:18:38.03,0:18:38.86,Default,,0,0,0,,Әрине
Dialogue: 0,0:18:38.95,0:18:41.49,Default,,0,0,0,,Кловер ұпайды азайтады
Dialogue: 0,0:18:41.57,0:18:43.62,Default,,0,0,0,,Қызметті бір айға тоқтату
Dialogue: 0,0:18:43.70,0:18:44.87,Default,,0,0,0,,Барлығы осы ма?
Dialogue: 0,0:18:44.95,0:18:47.41,Default,,0,0,0,,Сонымен қатар, қадағалаудың жоқтығынан
Dialogue: 0,0:18:47.50,0:18:50.25,Default,,0,0,0,,Менің жалақым 3 айға қысқарады.
Dialogue: 0,0:18:50.33,0:18:51.38,Default,,0,0,0,,Және…
Dialogue: 0,0:18:52.21,0:18:54.96,Default,,0,0,0,,Thunder Pike-тің бұрынғы мүшесі Джейми Осен
Dialogue: 0,0:18:55.46,0:18:56.55,Default,,0,0,0,,Иә
Dialogue: 0,0:18:56.63,0:19:02.30,Default,,0,0,0,,Авантюрист біліктілігін жою және бір жылға қайта тіркеуге тыйым салу
Dialogue: 0,0:19:02.39,0:19:04.81,Default,,0,0,0,,Мұның бәрі...?
Dialogue: 0,0:19:04.89,0:19:05.93,Default,,0,0,0,,Хмм
Dialogue: 0,0:19:06.01,0:19:06.68,Default,,0,0,0,,Бірақ
Dialogue: 0,0:19:06.77,0:19:09.18,Default,,0,0,0,,Мен Thunderpike мүшесі болдым.
Dialogue: 0,0:19:09.85,0:19:12.06,Default,,0,0,0,,Меніңше, жер аударылғаны таңқаларлық емес...
Dialogue: 0,0:19:12.15,0:19:13.31,Default,,0,0,0,,Джейми мырза
Dialogue: 0,0:19:13.40,0:19:16.40,Default,,0,0,0,,Thunder Pike қылмысының дәлелдемелерін жіберіңіз.
Dialogue: 0,0:19:16.48,0:19:19.57,Default,,0,0,0,,Ешқандай кемсітушілік пікірлер болмағаны расталды.
Dialogue: 0,0:19:19.65,0:19:20.95,Default,,0,0,0,,Осымен
Dialogue: 0,0:19:22.61,0:19:24.28,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:19:25.95,0:19:27.20,Default,,0,0,0,,Қыс болып қалды.
Dialogue: 0,0:19:27.79,0:19:30.04,Default,,0,0,0,,Юк сені сүйген жоқ па?
Dialogue: 0,0:19:30.54,0:19:33.54,Default,,0,0,0,,Мені депортацияламау үшін
Dialogue: 0,0:19:33.63,0:19:35.29,Default,,0,0,0,,А... жақсы.
Dialogue: 0,0:19:35.38,0:19:38.21,Default,,0,0,0,,Бірақ шешімді гильдия немесе ел қабылдады.
Dialogue: 0,0:19:38.30,0:19:39.17,Default,,0,0,0,,Иә
Dialogue: 0,0:19:39.67,0:19:41.22,Default,,0,0,0,,Бұл үшін кешіріңіз.
Dialogue: 0,0:19:41.72,0:19:44.47,Default,,0,0,0,,Тіпті Кловер де жазаланды.
Dialogue: 0,0:19:44.55,0:19:47.06,Default,,0,0,0,,Сенің көңіліңді көтеру үшін қанша рет кешірім сұрауым керек?
Dialogue: 0,0:19:47.56,0:19:48.97,Default,,0,0,0,,Солай ма...
Dialogue: 0,0:19:49.06,0:19:50.98,Default,,0,0,0,,Қайта-қайта кешірім сұраймын!
Dialogue: 0,0:19:51.06,0:19:54.61,Default,,0,0,0,,Көп нәрсе болғаны рас, бірақ енді ол үшін уайымдамаңыз.
Dialogue: 0,0:19:56.36,0:19:58.57,Default,,0,0,0,,Аа, шынымен жоқ.
Dialogue: 0,0:19:58.65,0:20:02.24,Default,,0,0,0,,Мен сенің мейірімділігіңді пайдаланғаным үшін өзімді жек көремін.
Dialogue: 0,0:20:02.74,0:20:06.70,Default,,0,0,0,,Мен сол кеште болдым, күлдім, күлдім сені.
Dialogue: 0,0:20:07.28,0:20:08.70,Default,,0,0,0,,Мен оны қатты жек көремін
Dialogue: 0,0:20:09.20,0:20:09.95,Default,,0,0,0,,Jamie
Dialogue: 0,0:20:10.04,0:20:12.46,Default,,0,0,0,,Мен сенің мұндай әйелдік қылықтарыңды жек көремін.
Dialogue: 0,0:20:12.54,0:20:14.71,Default,,0,0,0,,Жарайды... олай емес пе?
Dialogue: 0,0:20:14.79,0:20:17.21,Default,,0,0,0,,Мен аздап жұмыс істеймін, бірақ бұл маған ұнамайды.
Dialogue: 0,0:20:17.79,0:20:19.96,Default,,0,0,0,,Мен өзгерте аламын ба?
Dialogue: 0,0:20:20.05,0:20:22.26,Default,,0,0,0,,Жеткілікті өзгерді.
Dialogue: 0,0:20:22.76,0:20:26.05,Default,,0,0,0,,Өйткені сіз менімен әдеттегідей осылай сөйлесесіз.
Dialogue: 0,0:20:28.10,0:20:31.68,Default,,0,0,0,,Мүмкін мен көбірек сөйлесуім керек еді.
Dialogue: 0,0:20:32.56,0:20:36.15,Default,,0,0,0,,Мен сені адам ретінде түсінуге күш сала алсам
Dialogue: 0,0:20:36.94,0:20:38.98,Default,,0,0,0,,Нәтиже басқаша болуы мүмкін еді
Dialogue: 0,0:20:40.57,0:20:42.15,Default,,0,0,0,,Бұл Юктің кінәсі емес.
Dialogue: 0,0:20:42.24,0:20:44.74,Default,,0,0,0,,Оған Саймон мен біз кінәліміз.
Dialogue: 0,0:20:44.82,0:20:46.70,Default,,0,0,0,,Сіз мені жігерлендіріп жатырсыз ба?
Dialogue: 0,0:20:48.83,0:20:51.16,Default,,0,0,0,,Ал, үйге кететін уақыт болды.
Dialogue: 0,0:20:51.66,0:20:53.00,Default,,0,0,0,,Сені ағаң күтіп отыр, солай ма?
Dialogue: 0,0:20:53.08,0:20:54.58,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:20:58.59,0:21:01.59,Default,,0,0,0,,Юк көп рахмет
Dialogue: 0,0:21:05.68,0:21:08.05,Default,,0,0,0,,Ал, мен де үйге барайын ба?
Dialogue: 0,0:21:08.14,0:21:09.93,Default,,0,0,0,,Барлығы күтіп тұр.
Dialogue: 0,0:21:11.60,0:21:13.35,Default,,0,0,0,,Yuk Қайтадан қош келдіңіз!
Dialogue: 0,0:21:13.43,0:21:16.02,Default,,0,0,0,,-Қош келдіңіз -Мен көптен күттім.
Dialogue: 0,0:21:16.60,0:21:18.61,Default,,0,0,0,,♪～
Dialogue: 0,0:22:43.61,0:22:45.61,Default,,0,0,0,,～♪
Dialogue: 0,0:22:46.86,0:22:49.36,Default,,0,0,0,,Келесі жолы «Алты жапырақты беде»
Dialogue: 0,0:22:50.86,0:22:56.86,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
