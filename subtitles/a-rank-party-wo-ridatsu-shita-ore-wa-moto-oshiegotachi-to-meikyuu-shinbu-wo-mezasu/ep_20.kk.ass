Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.75,0:00:09.38,Default,,0,0,0,,Сізге рахмет
Dialogue: 0,0:00:09.46,0:00:13.09,Default,,0,0,0,,Елдер арасындағы саяси мәселелер оңай шешілді.
Dialogue: 0,0:00:13.17,0:00:16.09,Default,,0,0,0,,Бірақ бізге шынымен қажет нәрсе - уақытты сатып алу.
Dialogue: 0,0:00:16.18,0:00:17.22,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:00:17.30,0:00:18.43,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:00:19.01,0:00:20.68,Default,,0,0,0,,Оны қанша уақыт ұстауым керек?
Dialogue: 0,0:00:21.31,0:00:24.52,Default,,0,0,0,,Біздің патша авантюрист жіберді.
Dialogue: 0,0:00:24.60,0:00:27.77,Default,,0,0,0,,Forneia сиқырлы дирижабльмен ұшыңыз.
Dialogue: 0,0:00:27.86,0:00:30.94,Default,,0,0,0,,Сонда да біз жоғарғы дәрежелілерді жинап, жеткенше
Dialogue: 0,0:00:31.03,0:00:33.28,Default,,0,0,0,,Оған бір ай қажет болуы мүмкін.
Dialogue: 0,0:00:33.36,0:00:34.57,Default,,0,0,0,,Соншама?
Dialogue: 0,0:00:35.16,0:00:38.58,Default,,0,0,0,,Толық ауқымды қорғаныс тосқауылына дайындық аяқталды
Dialogue: 0,0:00:38.66,0:00:40.70,Default,,0,0,0,,Сіз оны тағы да қарастырғаныңыз жөн болар.
Dialogue: 0,0:00:40.79,0:00:43.37,Default,,0,0,0,,Ағымдағы күшпен бір ай...
Dialogue: 0,0:00:43.46,0:00:45.12,Default,,0,0,0,,Барсам болады ма? бенвуд
Dialogue: 0,0:00:45.21,0:00:46.58,Default,,0,0,0,,-Мүмкін емес - (Юк) Эй.
Dialogue: 0,0:00:46.67,0:00:48.33,Default,,0,0,0,,Әрине мен де келемін.
Dialogue: 0,0:00:48.92,0:00:51.84,Default,,0,0,0,,Бұл сенімді Бенвудтың қатыгез жұдырығы
Dialogue: 0,0:00:51.92,0:00:54.09,Default,,0,0,0,,Бұл ностальгиялық есім.
Dialogue: 0,0:00:54.17,0:00:56.47,Default,,0,0,0,,Бірақ мен шықсам да, ұрыс күші жетпейді.
Dialogue: 0,0:00:57.14,0:00:58.64,Default,,0,0,0,,Салмутарлық жақтың күші
Dialogue: 0,0:00:58.72,0:01:02.02,Default,,0,0,0,,Қашан және қаншалықты пайдалы екеніне байланысты.
Dialogue: 0,0:01:02.10,0:01:03.27,Default,,0,0,0,,Қатардағы жауынгерлер мен рыцарлар
Dialogue: 0,0:01:03.35,0:01:07.56,Default,,0,0,0,,Сонымен қатар, мен құбыжықтарды бағындырып күн көретін отбасы мүшесіне өтініш жасадым.
Dialogue: 0,0:01:07.65,0:01:09.11,Default,,0,0,0,,Баяу қозғалыс
Dialogue: 0,0:01:09.19,0:01:11.23,Default,,0,0,0,,Ағам мені мазалаған сияқты.
Dialogue: 0,0:01:11.82,0:01:12.65,Default,,0,0,0,,Хаа…
Dialogue: 0,0:01:12.73,0:01:16.74,Default,,0,0,0,,Олай болса, шектеулі қызметкерлермен бірдеңе істеуден басқа амалымыз қалмайды.
Dialogue: 0,0:01:16.82,0:01:19.07,Default,,0,0,0,,Жабдықтарды жеткізу тоқтатылған жоқ, солай ма?
Dialogue: 0,0:01:19.16,0:01:19.66,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:20.16,0:01:23.91,Default,,0,0,0,,Сіз бұрын сұраған заттар La Jo-ға жеткізіліп қойған.
Dialogue: 0,0:01:24.00,0:01:25.71,Default,,0,0,0,,Қосымшалар тізімі
Dialogue: 0,0:01:25.79,0:01:28.00,Default,,0,0,0,,Виконт бортмен, маған күшіңізді беріңізші.
Dialogue: 0,0:01:28.58,0:01:29.75,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:01:30.42,0:01:34.84,Default,,0,0,0,,Құбыжықтың жолына алхимиямен жасалған тұзақ орнатыңыз.
Dialogue: 0,0:01:34.92,0:01:38.89,Default,,0,0,0,,Бақытымызға орай, Салмуталия сиқырлы артефактілер туралы білімге бай жер.
Dialogue: 0,0:01:38.97,0:01:41.18,Default,,0,0,0,,Құбыжықпен бетпе-бет соқтығыссаңыз
Dialogue: 0,0:01:41.26,0:01:44.64,Default,,0,0,0,,Әскери күш пен қамсыздандыратынымыз анық.
Dialogue: 0,0:01:45.14,0:01:48.14,Default,,0,0,0,,Ақылмен, айламен қарсы алайық.
Dialogue: 0,0:01:48.23,0:01:51.31,Default,,0,0,0,,Алхимиктерді жинаңыз, Мәртебелі.
Dialogue: 0,0:01:51.40,0:01:52.36,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:01:52.44,0:01:53.40,Default,,0,0,0,,Дегенмен, енді ғана не болды?
Dialogue: 0,0:01:55.15,0:01:57.78,Default,,0,0,0,,Юк Егер айтарыңыз болса, айтыңыз.
Dialogue: 0,0:01:58.45,0:02:01.70,Default,,0,0,0,,Біз мұны істей аламыз ба, жоқ па, бәріміз шешуіміз керек.
Dialogue: 0,0:02:01.78,0:02:02.78,Default,,0,0,0,,Бұл жылдам шабуыл.
Dialogue: 0,0:02:02.87,0:02:06.12,Default,,0,0,0,,Бенвуд пен артефакт құбыжықтарды жұқартып тастаңыз.
Dialogue: 0,0:02:06.20,0:02:10.54,Default,,0,0,0,,Біз, Кловер, патша ғибадатханасын басып алып, басқарамыз...
Dialogue: 0,0:02:10.63,0:02:13.34,Default,,0,0,0,,Жоқ, ішкі ақпарат жоқ.
Dialogue: 0,0:02:13.42,0:02:16.59,Default,,0,0,0,,Бұл сіз бұрын-соңды көрмеген лабиринтке қарсы орындалатын стратегия емес.
Dialogue: 0,0:02:16.67,0:02:17.67,Default,,0,0,0,,Бұл өз-өзіне қол жұмсау
Dialogue: 0,0:02:18.34,0:02:20.30,Default,,0,0,0,,Хмм... жаман емес.
Dialogue: 0,0:02:20.89,0:02:22.30,Default,,0,0,0,,Жоқ, мүмкін емес.
Dialogue: 0,0:02:22.39,0:02:25.93,Default,,0,0,0,,Бұл жаман идея емес, менің ойымша, бұл шынайы идея.
Dialogue: 0,0:02:26.02,0:02:27.43,Default,,0,0,0,,Шынайы емес
Dialogue: 0,0:02:28.14,0:02:32.06,Default,,0,0,0,,Бұны дұрыстап соқсақ, құлап кетпейтіні сөзсіз.
Dialogue: 0,0:02:32.15,0:02:34.27,Default,,0,0,0,,Сіз артефактілермен уақыт сатып алдыңыз.
Dialogue: 0,0:02:34.36,0:02:37.82,Default,,0,0,0,,Егер төбелестің алдында тұрса, ол үш аптаға созылмайды.
Dialogue: 0,0:02:37.90,0:02:41.82,Default,,0,0,0,,Олай болса, серпілістің себебін жою ең шынайы болып табылады.
Dialogue: 0,0:02:41.91,0:02:45.29,Default,,0,0,0,,Мен өзім айттым, бірақ қайтарып аламын.
Dialogue: 0,0:02:45.37,0:02:47.20,Default,,0,0,0,,Достарыңызға қауіп төндірмеңіз
Dialogue: 0,0:02:47.29,0:02:48.16,Default,,0,0,0,,Хун
Dialogue: 0,0:02:48.25,0:02:51.96,Default,,0,0,0,,Олай дейтін едіңіз, бірақ ойланыңыз.
Dialogue: 0,0:02:52.54,0:02:55.50,Default,,0,0,0,,Мен сені қымбат бағаға сатып аламын.
Dialogue: 0,0:02:56.38,0:02:57.55,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:02:58.55,0:03:00.55,Default,,0,0,0,,♪～
Dialogue: 0,0:04:25.93,0:04:27.93,Default,,0,0,0,,～♪
Dialogue: 0,0:04:30.31,0:04:31.60,Default,,0,0,0,,Біз де
Dialogue: 0,0:04:31.68,0:04:33.52,Default,,0,0,0,,Мен бұл туралы ойладым
Dialogue: 0,0:04:34.27,0:04:37.61,Default,,0,0,0,,Қазіргі уақытта тиімді әдістер тым аз.
Dialogue: 0,0:04:37.69,0:04:38.56,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:04:38.65,0:04:41.69,Default,,0,0,0,,Қорғанысқа емес, шабуылға шыққан дұрыс болар.
Dialogue: 0,0:04:41.78,0:04:44.20,Default,,0,0,0,,Егер сіз объективті түрде қарасаңыз, менің ойымша.
Dialogue: 0,0:04:44.82,0:04:46.95,Default,,0,0,0,,Біз бедеміз, солай ма?
Dialogue: 0,0:04:47.57,0:04:51.83,Default,,0,0,0,,Бұл рас шығар, бірақ... Ран мені мазалайтын нәрсені айтты.
Dialogue: 0,0:04:52.41,0:04:54.83,Default,,0,0,0,,Жүгіру? Бірдеңе болды ма?
Dialogue: 0,0:04:55.71,0:04:57.42,Default,,0,0,0,,Қарашы, Рун-чан.
Dialogue: 0,0:04:58.04,0:05:00.96,Default,,0,0,0,,Қала сыртындағы зынданда біртүрлі нәрсе бар.
Dialogue: 0,0:05:01.55,0:05:02.21,Default,,0,0,0,,Біртүрлі?
Dialogue: 0,0:05:02.84,0:05:03.51,Default,,0,0,0,,Иә
Dialogue: 0,0:05:03.59,0:05:06.97,Default,,0,0,0,,Мен не айтарымды білмеймін, бірақ...
Dialogue: 0,0:05:07.05,0:05:08.80,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:05:08.89,0:05:10.97,Default,,0,0,0,,Қабаттасу аударылды.
Dialogue: 0,0:05:11.60,0:05:13.60,Default,,0,0,0,,Пияздың қабығын аршу сияқты
Dialogue: 0,0:05:13.68,0:05:16.02,Default,,0,0,0,,Зат бірте-бірте артып келеді.
Dialogue: 0,0:05:18.02,0:05:19.23,Default,,0,0,0,,Менің ойымша
Dialogue: 0,0:05:19.31,0:05:21.77,Default,,0,0,0,,Менің ойымша, мөр жойылған болуы мүмкін.
Dialogue: 0,0:05:21.86,0:05:22.98,Default,,0,0,0,,Пломба?
Dialogue: 0,0:05:23.07,0:05:25.32,Default,,0,0,0,,Осы уақытқа дейін табылмағанының өзі
Dialogue: 0,0:05:25.40,0:05:27.11,Default,,0,0,0,,Біртүрлі нәрсе
Dialogue: 0,0:05:27.20,0:05:30.70,Default,,0,0,0,,Ол көптеген мөрлер мен жасырын қабаттармен жасырылған.
Dialogue: 0,0:05:30.78,0:05:32.33,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:32.83,0:05:35.71,Default,,0,0,0,,Сонда мөр неліктен ашыла бастады?
Dialogue: 0,0:05:35.79,0:05:37.87,Default,,0,0,0,,Уақыт өте келе нашарлайды ма? Жоқ...
Dialogue: 0,0:05:41.17,0:05:43.21,Default,,0,0,0,,Қуанышты ма?
Dialogue: 0,0:05:43.30,0:05:44.46,Default,,0,0,0,,Иә
Dialogue: 0,0:05:44.55,0:05:47.88,Default,,0,0,0,,Соның әсерінен Ван храмы да іске қосылды.
Dialogue: 0,0:05:48.47,0:05:49.51,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:05:50.01,0:05:52.14,Default,,0,0,0,,Рахмет, Алтын Священие
Dialogue: 0,0:05:52.22,0:05:54.31,Default,,0,0,0,,Мен әркімнің пікірін тыңдағым келеді
Dialogue: 0,0:05:54.39,0:05:56.52,Default,,0,0,0,,Марина Ранның оқиғасы туралы не ойлайды?
Dialogue: 0,0:05:57.02,0:06:00.02,Default,,0,0,0,,Мен әдеттегідей Юктың соңынан еремін.
Dialogue: 0,0:06:00.10,0:06:01.15,Default,,0,0,0,,А...
Dialogue: 0,0:06:01.65,0:06:05.44,Default,,0,0,0,,Хмм... сен мені сәл ақымақ деп ойладың.
Dialogue: 0,0:06:05.53,0:06:08.61,Default,,0,0,0,,Жоқ, мен Юкке сенемін.
Dialogue: 0,0:06:08.70,0:06:11.03,Default,,0,0,0,,Ендеше, міне...
Dialogue: 0,0:06:11.12,0:06:14.87,Default,,0,0,0,,Марина мұғалімімен соңына дейін қалғысы келетінін айтқысы келеді.
Dialogue: 0,0:06:14.95,0:06:17.25,Default,,0,0,0,,Ол әлдеқашан жат жерде қыз.
Dialogue: 0,0:06:17.33,0:06:18.29,Default,,0,0,0,,Эххе
Dialogue: 0,0:06:18.92,0:06:21.29,Default,,0,0,0,,Бірақ бізде де солай.
Dialogue: 0,0:06:27.01,0:06:30.84,Default,,0,0,0,,Сіздің қашуға ниетіңіз жоқ, солай ма?
Dialogue: 0,0:06:30.93,0:06:31.68,Default,,0,0,0,,Jamie
Dialogue: 0,0:06:32.26,0:06:34.97,Default,,0,0,0,,Гилмас екеуміз қорғаныс шайқасында қалдық.
Dialogue: 0,0:06:35.06,0:06:36.68,Default,,0,0,0,,үшін патша ғибадатханасына бет алды
Dialogue: 0,0:06:36.77,0:06:39.44,Default,,0,0,0,,О, Джейми мырза, менімен бірге келмейсіз бе?
Dialogue: 0,0:06:39.52,0:06:42.11,Default,,0,0,0,,Мен Ямайаманың соңынан ергім келеді.
Dialogue: 0,0:06:42.19,0:06:44.86,Default,,0,0,0,,Мен енді ғана оралдым, сондықтан түйсігім түтіккен.
Dialogue: 0,0:06:44.94,0:06:48.95,Default,,0,0,0,,Бірақ мен сіздің арқаңызды және үйге баратын жеріңізді қорғаймын.
Dialogue: 0,0:06:49.03,0:06:51.20,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:51.78,0:06:54.70,Default,,0,0,0,,Мен де Кловердің мүшесімін.
Dialogue: 0,0:06:55.28,0:06:56.20,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:56.29,0:06:57.75,Default,,0,0,0,,Со Юк
Dialogue: 0,0:06:57.83,0:07:00.62,Default,,0,0,0,,Көшбасшы ретінде өзіңіз шешім қабылдаңыз.
Dialogue: 0,0:07:00.71,0:07:02.46,Default,,0,0,0,,Өзіңіз не істегіңіз келеді?
Dialogue: 0,0:07:02.54,0:07:03.96,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:16.81,0:07:17.43,Default,,0,0,0,,Rain
Dialogue: 0,0:07:17.93,0:07:19.02,Default,,0,0,0,,Yuk
Dialogue: 0,0:07:19.10,0:07:21.98,Default,,0,0,0,,Маған Юке не шешетіні маңызды емес.
Dialogue: 0,0:07:22.06,0:07:24.11,Default,,0,0,0,,Мен Юктың соңына дейін жүремін.
Dialogue: 0,0:07:25.23,0:07:25.98,Default,,0,0,0,,Ой
Dialogue: 0,0:07:26.61,0:07:28.65,Default,,0,0,0,,Бәріміз бірге барсақ жарайды.
Dialogue: 0,0:07:28.73,0:07:30.82,Default,,0,0,0,,Өйткені Юк – батыр.
Dialogue: 0,0:07:31.86,0:07:33.82,Default,,0,0,0,,Осылайша шешілді.
Dialogue: 0,0:07:34.91,0:07:36.74,Default,,0,0,0,,О, жасайық!
Dialogue: 0,0:07:39.91,0:07:43.04,Default,,0,0,0,,Сонымен, Кловер ертең әрекет ете бастайды.
Dialogue: 0,0:07:43.79,0:07:47.13,Default,,0,0,0,,Бұл жолы біз бір уақытта үш миссияны орындаймыз.
Dialogue: 0,0:07:47.21,0:07:50.30,Default,,0,0,0,,Үш? Бұл өте шиеленісті болды.
Dialogue: 0,0:07:50.38,0:07:51.59,Default,,0,0,0,,Жақсы
Dialogue: 0,0:07:51.67,0:07:55.05,Default,,0,0,0,,Бірақ олардың барлығы Корольдік храмды жаулап алу үшін қажет.
Dialogue: 0,0:07:55.14,0:07:56.51,Default,,0,0,0,,Біріншісі
Dialogue: 0,0:07:56.60,0:07:59.56,Default,,0,0,0,,Тарату үшін релелік артефакт орнату
Dialogue: 0,0:07:59.64,0:08:01.64,Default,,0,0,0,,Оны осылай орналастыру арқылы
Dialogue: 0,0:08:01.73,0:08:05.06,Default,,0,0,0,,Бейне Ла Джоға жеткізілетіні айтылады.
Dialogue: 0,0:08:05.15,0:08:09.19,Default,,0,0,0,,Негізі, мен мұны істеуім керек еді, бірақ кешіріңіз.
Dialogue: 0,0:08:09.28,0:08:10.82,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:08:10.90,0:08:14.11,Default,,0,0,0,,№ Өлім алқабы тым қауіпті.
Dialogue: 0,0:08:14.20,0:08:16.07,Default,,0,0,0,,Оны бізге қалдырыңыз
Dialogue: 0,0:08:16.66,0:08:17.99,Default,,0,0,0,,Виконт кеңесшісі
Dialogue: 0,0:08:18.08,0:08:20.66,Default,,0,0,0,,La Jo-да таратуды алуыңызға көз жеткізу үшін
Dialogue: 0,0:08:20.75,0:08:22.12,Default,,0,0,0,,Түзетулер енгізіңіз.
Dialogue: 0,0:08:22.21,0:08:22.71,Default,,0,0,0,,О
Dialogue: 0,0:08:23.29,0:08:25.75,Default,,0,0,0,,Екіншісі - патша ғибадатханасына баратын жолды қамтамасыз ету.
Dialogue: 0,0:08:25.83,0:08:29.25,Default,,0,0,0,,Ішкі ортаны тексеру және жеткізуді тексеру
Dialogue: 0,0:08:29.34,0:08:32.09,Default,,0,0,0,,Мен осы уақытқа дейін барлығын бірден орындағым келеді.
Dialogue: 0,0:08:32.67,0:08:34.63,Default,,0,0,0,,Алдыңғы жақтан асығыс кіресің бе?
Dialogue: 0,0:08:34.72,0:08:37.30,Default,,0,0,0,,Мен басқа кіру жолдарының бар-жоғын білгім келеді.
Dialogue: 0,0:08:37.39,0:08:40.18,Default,,0,0,0,,Сондай-ақ, егер таратылған бейне осы нүктеге жетсе,
Dialogue: 0,0:08:40.26,0:08:41.72,Default,,0,0,0,,Зерттеу және талдау барысы
Dialogue: 0,0:08:41.81,0:08:44.98,Default,,0,0,0,,Ал үшінші қадам – Ван храмын жаулап алу.
Dialogue: 0,0:08:45.06,0:08:49.32,Default,,0,0,0,,Біз ғибадатханаға кіріп, төбелесті аяқтаймыз.
Dialogue: 0,0:08:49.40,0:08:51.82,Default,,0,0,0,,Қазірдің өзінде көп болған құбыжықтар туралы.
Dialogue: 0,0:08:51.90,0:08:53.49,Default,,0,0,0,,Оны бізге қалдырыңыз
Dialogue: 0,0:08:53.57,0:08:54.36,Default,,0,0,0,,Иә
Dialogue: 0,0:08:55.36,0:08:58.07,Default,,0,0,0,,Салмутарлық алхимиктің көмегімен
Dialogue: 0,0:08:58.16,0:09:00.20,Default,,0,0,0,,Тұзақ құрып, жою
Dialogue: 0,0:09:00.28,0:09:01.49,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:01.58,0:09:03.20,Default,,0,0,0,,Айтқың келетін нәрсе бар ма?
Dialogue: 0,0:09:05.54,0:09:06.33,Default,,0,0,0,,Жүгіру?
Dialogue: 0,0:09:06.96,0:09:08.46,Default,,0,0,0,,Білесің бе, аға.
Dialogue: 0,0:09:08.54,0:09:11.55,Default,,0,0,0,,Бұл сұрақ па, дәлірек айтқанда өтініш пе?
Dialogue: 0,0:09:11.63,0:09:13.84,Default,,0,0,0,,Мен де өзіңмен бірге Run алып кеткеніңді қалаймын.
Dialogue: 0,0:09:13.92,0:09:17.47,Default,,0,0,0,,Жүгір, Өлім аңғары өте қауіпті жер емес пе?
Dialogue: 0,0:09:17.55,0:09:19.51,Default,,0,0,0,,Мүмкін сіз, мырза, сөгіс естігенді ұнататын сол қиын мінезді жандардың бірісіз бе?
Dialogue: 0,0:09:19.60,0:09:22.89,Default,,0,0,0,,Бірақ егер сіз Лунды ғибадатханаға апарсаңыз.
Dialogue: 0,0:09:22.97,0:09:25.18,Default,,0,0,0,,Менің ойымша, сіз түсінуге болатын нәрселер бар.
Dialogue: 0,0:09:26.06,0:09:29.11,Default,,0,0,0,,Не айтқыңыз келетінін түсіндіре аласыз ба?
Dialogue: 0,0:09:29.86,0:09:33.23,Default,,0,0,0,,Жүгіру – алтын әулие қыз, сондықтан ол бұрмалауды түсінеді.
Dialogue: 0,0:09:33.32,0:09:36.11,Default,,0,0,0,,Менің ойымша, Өлім алқабында көптеген бұрмалаулар бар.
Dialogue: 0,0:09:36.20,0:09:37.49,Default,,0,0,0,,Өйткені бұл біртүрлі.
Dialogue: 0,0:09:37.57,0:09:39.91,Default,,0,0,0,,Glad She-Im ұнай ма?
Dialogue: 0,0:09:39.99,0:09:41.53,Default,,0,0,0,,Дегенмен сәл басқаша.
Dialogue: 0,0:09:41.62,0:09:46.25,Default,,0,0,0,,Мм, мм... Кешіріңіз, мен оны Жүгіруге түсіндіре алмаймын.
Dialogue: 0,0:09:49.08,0:09:52.00,Default,,0,0,0,,- (Нибель) Уау - Жарайды, бірге барайық.
Dialogue: 0,0:09:52.09,0:09:52.75,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:09:52.84,0:09:56.67,Default,,0,0,0,,Егер Рун-чан біз түсінбейтін нәрсені сезінсе.
Dialogue: 0,0:09:56.76,0:09:58.51,Default,,0,0,0,,Бұл сізге кеңес беретініне сенімдімін.
Dialogue: 0,0:09:58.59,0:09:59.72,Default,,0,0,0,,Иә
Dialogue: 0,0:10:00.34,0:10:01.97,Default,,0,0,0,,Сіз қалай ойлайсыз? Юк мырза
Dialogue: 0,0:10:02.05,0:10:04.22,Default,,0,0,0,,Жарайды, сені алайық.
Dialogue: 0,0:10:04.31,0:10:05.52,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:10:05.60,0:10:08.73,Default,,0,0,0,,Әрине, Run да Кловердің мүшесі.
Dialogue: 0,0:10:09.40,0:10:10.73,Default,,0,0,0,,Уау...
Dialogue: 0,0:10:10.81,0:10:14.48,Default,,0,0,0,,үшін жеткілікті демалуы керек.
Dialogue: 0,0:10:14.57,0:10:16.49,Default,,0,0,0,,Таң атқанда шығу
Dialogue: 0,0:10:17.15,0:10:18.53,Default,,0,0,0,,Сақтықпен ләззат алыңыз
Dialogue: 0,0:10:18.61,0:10:19.99,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:10:24.37,0:10:27.08,Default,,0,0,0,,Жарайды, үшінші орнату аяқталды
Dialogue: 0,0:10:27.58,0:10:30.37,Default,,0,0,0,,Бұл өте ауыр жұмыс.
Dialogue: 0,0:10:30.88,0:10:32.75,Default,,0,0,0,,Өзіңіз ойлағаннан да абай болыңыз
Dialogue: 0,0:10:32.84,0:10:36.67,Default,,0,0,0,,Мұны істеу үшін сіз алхимик болуыңыз керек.
Dialogue: 0,0:10:36.76,0:10:39.55,Default,,0,0,0,,Виконт Бордман мұны бірнеше рет жасады ма?
Dialogue: 0,0:10:39.63,0:10:40.51,Default,,0,0,0,,Бұл оның әдеті.
Dialogue: 0,0:10:42.68,0:10:44.26,Default,,0,0,0,,Иә Іске қосуды растау
Dialogue: 0,0:10:44.35,0:10:48.27,Default,,0,0,0,,Енді жермен танысқанша күтсеңіз, ағынмен жіберуді бастауға болады.
Dialogue: 0,0:10:48.35,0:10:50.31,Default,,0,0,0,,Жақсы жұмыс, аға
Dialogue: 0,0:10:50.39,0:10:51.65,Default,,0,0,0,,Рахмет жүгіріңіз
Dialogue: 0,0:10:52.15,0:10:53.52,Default,,0,0,0,,Тағы бір орын бар.
Dialogue: 0,0:10:54.15,0:10:57.44,Default,,0,0,0,,Орнатуды бүгін аяқтай аласыз ба?
Dialogue: 0,0:10:57.53,0:10:58.40,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:58.49,0:11:01.57,Default,,0,0,0,,Алдымен жоспарланған орнату орнына көшейік.
Dialogue: 0,0:11:01.66,0:11:04.37,Default,,0,0,0,,Орналасқан жері өткен күні лагерь қонған жеріміз.
Dialogue: 0,0:11:05.49,0:11:07.16,Default,,0,0,0,,Гохогохо…
Dialogue: 0,0:11:07.24,0:11:09.54,Default,,0,0,0,,(тұншығу дыбысы)
Dialogue: 0,0:11:10.33,0:11:12.12,Default,,0,0,0,,Сіз өзіңізді тым қатты итермелейсіз бе?
Dialogue: 0,0:11:12.21,0:11:13.33,Default,,0,0,0,,Асығыс болса да
Dialogue: 0,0:11:13.42,0:11:16.42,Default,,0,0,0,,Оқытушы құлап қалса, оның пайдасы жоқ.
Dialogue: 0,0:11:16.50,0:11:17.96,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:11:18.05,0:11:21.30,Default,,0,0,0,,Сонымен қатар, егер жағдай дұрыс болмаса, Жібек сізді тоқтатады, солай ма?
Dialogue: 0,0:11:21.38,0:11:24.60,Default,,0,0,0,,Енді олай емес.
Dialogue: 0,0:11:24.68,0:11:27.43,Default,,0,0,0,,Жарайды, әзірге бәрі жоспар бойынша жүріп жатыр.
Dialogue: 0,0:11:27.52,0:11:30.39,Default,,0,0,0,,Менде қосымша күш бар, сендерге рахмет.
Dialogue: 0,0:11:36.27,0:11:37.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:38.44,0:11:39.94,Default,,0,0,0,,Не болды? Марина
Dialogue: 0,0:11:40.03,0:11:42.61,Default,,0,0,0,,Хмм... Қызық, бұл не?
Dialogue: 0,0:11:42.70,0:11:45.45,Default,,0,0,0,,Түсінуге оңай болсын деп мәжбүрлемеңіз.
Dialogue: 0,0:11:45.53,0:11:47.54,Default,,0,0,0,,Сіз маған өз ойыңызды айта аласыз.
Dialogue: 0,0:11:48.04,0:11:51.29,Default,,0,0,0,,Жарайды, мен бұл тітіркендіргіш сияқтымын.
Dialogue: 0,0:11:51.37,0:11:54.25,Default,,0,0,0,,Жүйкелеу, дәлірек айтқанда, мазасыздану
Dialogue: 0,0:11:54.33,0:11:55.42,Default,,0,0,0,,О...
Dialogue: 0,0:11:56.34,0:11:58.75,Default,,0,0,0,,Иә, бұл алаңдатады.
Dialogue: 0,0:11:58.84,0:12:00.92,Default,,0,0,0,,Егер сіз Yuke-ді ұстансаңыз, оңайырақ болады.
Dialogue: 0,0:12:01.01,0:12:01.76,Default,,0,0,0,,О, бұл естелік екен. Өте рахмет
Dialogue: 0,0:12:02.34,0:12:04.84,Default,,0,0,0,,Мен білмеймін. Бұл қорқынышты ма?
Dialogue: 0,0:12:04.93,0:12:06.80,Default,,0,0,0,,Біртүрлі сезіледі.
Dialogue: 0,0:12:06.89,0:12:09.06,Default,,0,0,0,,Кешіріңіз, Юк, осындай уақытта.
Dialogue: 0,0:12:09.14,0:12:11.10,Default,,0,0,0,,Жарайды, тынышталдыңыз ба?
Dialogue: 0,0:12:11.60,0:12:12.27,Default,,0,0,0,,Иә
Dialogue: 0,0:12:12.35,0:12:15.19,Default,,0,0,0,,Бірдеңе болуы мүмкін, абай болыңыз...
Dialogue: 0,0:12:15.27,0:12:16.90,Default,,0,0,0,,Не?! Һмм…
Dialogue: 0,0:12:17.40,0:12:18.77,Default,,0,0,0,,- Иә! -Юк?
Dialogue: 0,0:12:19.36,0:12:20.44,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:12:20.94,0:12:21.99,Default,,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:12:22.07,0:12:22.65,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:22.74,0:12:23.65,Default,,0,0,0,,Уф!
Dialogue: 0,0:12:23.74,0:12:27.66,Default,,0,0,0,,Мұндағы атмосфера ауыр.
Dialogue: 0,0:12:27.74,0:12:30.20,Default,,0,0,0,,Күте тұрыңыз, оны сол күйінде қалдырыңыз.
Dialogue: 0,0:12:30.79,0:12:31.66,Default,,0,0,0,,Жаңбыр?
Dialogue: 0,0:12:31.75,0:12:34.04,Default,,0,0,0,,Юк терең тыныс алды
Dialogue: 0,0:12:34.54,0:12:35.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:36.00,0:12:40.13,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:12:40.21,0:12:42.88,Default,,0,0,0,,Мұғалімнің манағы қатты бұзылады.
Dialogue: 0,0:12:42.97,0:12:44.34,Default,,0,0,0,,Хаа…
Dialogue: 0,0:12:46.47,0:12:50.26,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:12:51.18,0:12:53.14,Default,,0,0,0,,Мен сабырлымын, рахмет
Dialogue: 0,0:12:53.73,0:12:57.52,Default,,0,0,0,,Қалыпты емес жағдай орын алды. Мен жағдайды түсіндіруім керек пе?
Dialogue: 0,0:12:57.61,0:12:59.36,Default,,0,0,0,,Жол бойы тыңдаңыз
Dialogue: 0,0:12:59.44,0:13:00.86,Default,,0,0,0,,Физикалық сиқырлық!
Dialogue: 0,0:13:06.24,0:13:07.74,Default,,0,0,0,,Осы жолмен!
Dialogue: 0,0:13:12.50,0:13:14.29,Default,,0,0,0,,Мен Ванг храмына қарағаныңызды қалаймын.
Dialogue: 0,0:13:17.63,0:13:18.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:21.88,0:13:23.84,Default,,0,0,0,,О, Құдай-ай…
Dialogue: 0,0:13:23.92,0:13:25.22,Default,,0,0,0,,Эй... сіз дұрыс суретке түсіріп жатырсыз ба?
Dialogue: 0,0:13:25.30,0:13:26.51,Default,,0,0,0,,- (Камерат-кун) Келді - (Селфи-чан) Ұяшық
Dialogue: 0,0:13:29.18,0:13:30.55,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:13:30.64,0:13:32.06,Default,,0,0,0,,Юк?
Dialogue: 0,0:13:32.14,0:13:36.44,Default,,0,0,0,,Мен мұны бір жерден көргендей сезінемін...
Dialogue: 0,0:13:36.94,0:13:37.65,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:13:38.65,0:13:41.19,Default,,0,0,0,,Жоқ, мен оны бірінші рет көруім керек.
Dialogue: 0,0:13:41.27,0:13:44.86,Default,,0,0,0,,Мен мұндай құбылысты көрген де, естіген де емеспін.
Dialogue: 0,0:13:44.94,0:13:47.24,Default,,0,0,0,,-(Юк) Гуг... -Юк Жарайсың ба?
Dialogue: 0,0:13:47.32,0:13:50.78,Default,,0,0,0,,Уф... Жарайды, кешіріңіз.
Dialogue: 0,0:13:50.87,0:13:52.33,Default,,0,0,0,,Бұл туралы кейінірек айтамыз.
Dialogue: 0,0:13:52.83,0:13:54.25,Default,,0,0,0,,Алдымен осы жерден кетіңіз.
Dialogue: 0,0:13:54.83,0:13:57.54,Default,,0,0,0,,Silk Biblion-дан көмек сұраңыз.
Dialogue: 0,0:13:57.62,0:13:58.83,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:58.92,0:14:00.63,Default,,0,0,0,,Библия Маған күшіңді бер
Dialogue: 0,0:14:02.00,0:14:05.01,Default,,0,0,0,,Болашақты болжауда қандай да бір қауіп бар ма, маған хабарлаңыз.
Dialogue: 0,0:14:05.09,0:14:06.13,Default,,0,0,0,,Жүгіру
Dialogue: 0,0:14:06.22,0:14:07.55,Default,,0,0,0,,Иә
Dialogue: 0,0:14:08.22,0:14:10.43,Default,,0,0,0,,Нене Нұсқаулық сұрау
Dialogue: 0,0:14:10.51,0:14:14.64,Default,,0,0,0,,Осы қарқынмен айналадағы құбыжықтар үрейленуі мүмкін.
Dialogue: 0,0:14:14.72,0:14:18.06,Default,,0,0,0,,Жарайды, мен тағы да бар жылдамдықпен жүгіріп келемін.
Dialogue: 0,0:14:18.14,0:14:19.23,Default,,0,0,0,,Кеттік
Dialogue: 0,0:14:25.40,0:14:28.32,Default,,0,0,0,,(үшін ауыр тыныс алады)
Dialogue: 0,0:14:28.95,0:14:31.41,Default,,0,0,0,,Бұл Ла Джо, сен қайтып келдің.
Dialogue: 0,0:14:31.49,0:14:32.37,Default,,0,0,0,,Иә
Dialogue: 0,0:14:32.45,0:14:35.58,Default,,0,0,0,,Кеңейту әзірге тоқтаған сияқты.
Dialogue: 0,0:14:35.66,0:14:37.71,Default,,0,0,0,,Бірақ егер бұл орын алса
Dialogue: 0,0:14:37.79,0:14:41.08,Default,,0,0,0,,Патша ғибадатханасына тез шабуыл жасау және оның себебін жою әдісі
Dialogue: 0,0:14:41.17,0:14:42.38,Default,,0,0,0,,Мен енді шыдай алмаймын.
Dialogue: 0,0:14:42.46,0:14:45.50,Default,,0,0,0,,Сол қара қабырғадан асық...
Dialogue: 0,0:14:45.59,0:14:46.84,Default,,0,0,0,,Бұл тым абайсызда.
Dialogue: 0,0:14:47.51,0:14:50.26,Default,,0,0,0,,Мастма мен Бенвудқа тез есеп берейік.
Dialogue: 0,0:14:51.09,0:14:51.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:58.81,0:14:59.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:59.85,0:15:01.48,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:15:03.56,0:15:05.07,Default,,0,0,0,,(Хироко) Һм? О…
Dialogue: 0,0:15:05.15,0:15:07.61,Default,,0,0,0,,Иә? О, Фердио мырза
Dialogue: 0,0:15:07.69,0:15:10.07,Default,,0,0,0,,Рахума ханым келді.
Dialogue: 0,0:15:10.15,0:15:12.11,Default,,0,0,0,,Олар біраз қиналып жатқан сияқты.
Dialogue: 0,0:15:12.20,0:15:13.87,Default,,0,0,0,,Конфликт дегенді қалай түсінесіз?
Dialogue: 0,0:15:13.95,0:15:17.16,Default,,0,0,0,,Иә Бұл қала әрбір тарату артефакті үшін
Dialogue: 0,0:15:17.24,0:15:18.62,Default,,0,0,0,,Сұраныс?
Dialogue: 0,0:15:18.70,0:15:19.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:21.62,0:15:23.88,Default,,0,0,0,,Мастома, тағы айт!
Dialogue: 0,0:15:23.96,0:15:26.25,Default,,0,0,0,,Құлағыңыз алыстап кетті ме? Рахума
Dialogue: 0,0:15:26.34,0:15:27.88,Default,,0,0,0,,Мен саған жат дедім.
Dialogue: 0,0:15:27.96,0:15:29.51,Default,,0,0,0,,Не?
Dialogue: 0,0:15:31.88,0:15:32.89,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:32.97,0:15:35.60,Default,,0,0,0,,Юк, қайтып келдің бе?
Dialogue: 0,0:15:35.68,0:15:36.39,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:15:40.18,0:15:42.02,Default,,0,0,0,,Мен мәртебелі Рахумамен кездесемін.
Dialogue: 0,0:15:42.10,0:15:46.82,Default,,0,0,0,,Мен Юке Фердиомын, Вермерия Корольдігінің лабиринт графымын.
Dialogue: 0,0:15:46.90,0:15:48.19,Default,,0,0,0,,Мен мұның өрескел екенін білемін, бірақ
Dialogue: 0,0:15:48.28,0:15:52.32,Default,,0,0,0,,Шұғыл мәселелерді жеткізуге рұқсатсыз өзіңізді әшкерелеу
Dialogue: 0,0:15:52.40,0:15:53.53,Default,,0,0,0,,Өтінемін, мені кешір.
Dialogue: 0,0:15:53.61,0:15:56.62,Default,,0,0,0,,Хун, сіз лорд Фердиосыз ба?
Dialogue: 0,0:15:56.70,0:15:59.29,Default,,0,0,0,,Өзіңмен бірге әйел-баланы әкелу – алаңсыз іс.
Dialogue: 0,0:15:59.37,0:16:02.08,Default,,0,0,0,,Бұл жігіт үшін жақсы жаңалық. Есеп беру.
Dialogue: 0,0:16:02.16,0:16:02.92,Default,,0,0,0,,Ендеше, мен де саған сенемін
Dialogue: 0,0:16:03.00,0:16:05.04,Default,,0,0,0,,Бұл төтенше жағдай, Рахума.
Dialogue: 0,0:16:06.17,0:16:09.46,Default,,0,0,0,,Өлім алқабындағы патша ғибадатханасынан қара қабырға пайда болады.
Dialogue: 0,0:16:09.55,0:16:11.30,Default,,0,0,0,,Ол кең аумақты шарпыды.
Dialogue: 0,0:16:11.80,0:16:15.18,Default,,0,0,0,,Нәтижесінде айналадағы құбыжықтар қатыгез бола бастады.
Dialogue: 0,0:16:16.43,0:16:18.31,Default,,0,0,0,,Төбелестің белгілері туралы не деуге болады?
Dialogue: 0,0:16:18.39,0:16:20.10,Default,,0,0,0,,Осыған байланысты
Dialogue: 0,0:16:20.18,0:16:22.98,Default,,0,0,0,,Патша ғибадатханасы қара қабырғаның ішінде жұтылды.
Dialogue: 0,0:16:23.06,0:16:23.94,Default,,0,0,0,,расталмаған
Dialogue: 0,0:16:24.52,0:16:25.44,Default,,0,0,0,,Хмм…
Dialogue: 0,0:16:25.94,0:16:29.07,Default,,0,0,0,,Юк Сіз оны қалай көресіз? Бұл қара қабырға не?
Dialogue: 0,0:16:29.15,0:16:31.24,Default,,0,0,0,,Бұл жай ғана болжам...
Dialogue: 0,0:16:31.32,0:16:31.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:31.90,0:16:33.70,Default,,0,0,0,,Қош болыңыз
Dialogue: 0,0:16:34.32,0:16:36.53,Default,,0,0,0,,Менің ойымша, бұл зындан.
Dialogue: 0,0:16:36.62,0:16:38.87,Default,,0,0,0,,Бұл патша ғибадатханасының ағып кеткенін білдіре ме?
Dialogue: 0,0:16:38.95,0:16:39.66,Default,,0,0,0,,Тс… Тағы да кірлеп кетті.
Dialogue: 0,0:16:39.74,0:16:42.45,Default,,0,0,0,,Жоқ, бұл дүниенің ашық теңізі.
Dialogue: 0,0:16:43.08,0:16:44.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:48.13,0:16:49.46,Default,,0,0,0,,Сотом дегеніміз не?
Dialogue: 0,0:16:49.55,0:16:54.22,Default,,0,0,0,,Әр дүние қараңғылық теңізінде қалқып жүрген көпіршік сияқты.
Dialogue: 0,0:16:54.80,0:16:57.14,Default,,0,0,0,,Біз өмір сүріп жатқан әлемнен басқа
Dialogue: 0,0:16:57.22,0:16:59.85,Default,,0,0,0,,Мен көп дүние бар деп естідім.
Dialogue: 0,0:16:59.93,0:17:01.52,Default,,0,0,0,,Сіз бұл туралы айтып отырсыз ба?
Dialogue: 0,0:17:02.02,0:17:02.60,Default,,0,0,0,,Иә
Dialogue: 0,0:17:02.68,0:17:06.60,Default,,0,0,0,,Сол қараңғылық теңізі бұл әлемге толып жатыр...
Dialogue: 0,0:17:06.69,0:17:08.52,Default,,0,0,0,,Толып жатқаннан гөрі
Dialogue: 0,0:17:08.61,0:17:10.11,Default,,0,0,0,,Іші сыртқа бұрылған сияқты
Dialogue: 0,0:17:10.69,0:17:12.86,Default,,0,0,0,,Дәл осы дүниенің өзі сияқты
Dialogue: 0,0:17:12.94,0:17:16.11,Default,,0,0,0,,Зынданданың бастапқы нүктесі ретінде ол кері бұрылған сияқты.
Dialogue: 0,0:17:16.70,0:17:17.66,Default,,0,0,0,,Инверсия?
Dialogue: 0,0:17:17.74,0:17:19.45,Default,,0,0,0,,Төңкерілген лабиринт
Dialogue: 0,0:17:19.53,0:17:22.91,Default,,0,0,0,,Оның көне сөзі «тенебре».
Dialogue: 0,0:17:23.00,0:17:27.00,Default,,0,0,0,,Онии-чан мен Рун қаңғыған жер.
Dialogue: 0,0:17:29.25,0:17:32.46,Default,,0,0,0,,Ештеңе жоқ, не жоғары, не төмен екенін білмеймін
Dialogue: 0,0:17:32.55,0:17:34.67,Default,,0,0,0,,Бұл Тенебра
Dialogue: 0,0:17:34.76,0:17:36.13,Default,,0,0,0,,Хаа… Хаа… Хаа…
Dialogue: 0,0:17:36.22,0:17:39.43,Default,,0,0,0,,Salmutalia Tenebrae батады.
Dialogue: 0,0:17:39.51,0:17:40.72,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:40.80,0:17:41.43,Default,,0,0,0,,Иә
Dialogue: 0,0:17:44.60,0:17:46.44,Default,,0,0,0,,Сәлем! Бұл кім?
Dialogue: 0,0:17:46.52,0:17:48.85,Default,,0,0,0,,Мен түсінбейтін нәрселер көп.
Dialogue: 0,0:17:48.94,0:17:51.98,Default,,0,0,0,,Балалар сендер келе салысымен мына бір оғаш оқиға болды.
Dialogue: 0,0:17:52.07,0:17:55.19,Default,,0,0,0,,Бұл қасиетті Өлім алқабына апат әкелген болуы керек!
Dialogue: 0,0:17:55.78,0:17:58.41,Default,,0,0,0,,Үніңді жап немесе шық!
Dialogue: 0,0:17:58.91,0:18:00.57,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:04.87,0:18:06.71,Default,,0,0,0,,Мен сарайға барамын
Dialogue: 0,0:18:06.79,0:18:09.42,Default,,0,0,0,,Mustma! Әңгімені кейінірек жалғастырамын.
Dialogue: 0,0:18:10.25,0:18:11.21,Default,,0,0,0,,Хмф!
Dialogue: 0,0:18:12.50,0:18:15.80,Default,,0,0,0,,Кешіріңіз, Юк, осындай аға болғаным үшін.
Dialogue: 0,0:18:16.38,0:18:19.55,Default,,0,0,0,,Мәртебелі! Бұл төтенше жағдай
Dialogue: 0,0:18:19.64,0:18:21.47,Default,,0,0,0,,Дүние жүзінде болып жатқан әдеттен тыс құбылыстар
Dialogue: 0,0:18:21.55,0:18:23.81,Default,,0,0,0,,Бұл оқиға туралы хабарламалар болды.
Dialogue: 0,0:18:23.89,0:18:25.31,Default,,0,0,0,,Ерекше құбылыс?
Dialogue: 0,0:18:25.39,0:18:27.94,Default,,0,0,0,,Қорқынышты жарты шар тәрізді қара қабырға
Dialogue: 0,0:18:28.02,0:18:29.56,Default,,0,0,0,,Барлық жерде пайда болады
Dialogue: 0,0:18:29.65,0:18:31.10,Default,,0,0,0,,Не?
Dialogue: 0,0:18:31.19,0:18:32.69,Default,,0,0,0,,Бұл туралы Юк хабарлады—
Dialogue: 0,0:18:32.77,0:18:34.82,Default,,0,0,0,,Бұл патша ғибадатханасында болған оқиғамен бірдей емес пе?
Dialogue: 0,0:18:34.90,0:18:36.82,Default,,0,0,0,,Сонда патша храмында?
Dialogue: 0,0:18:39.20,0:18:43.16,Default,,0,0,0,,Қазіргі уақытта төрт елде Tenebrae індеттері расталды.
Dialogue: 0,0:18:43.24,0:18:47.37,Default,,0,0,0,,15... Жоқ, бұл 16 жылдан кейінгі түнгі түннің оралуы.
Dialogue: 0,0:18:47.45,0:18:47.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:48.62,0:18:50.00,Default,,0,0,0,,Не? Ол бет
Dialogue: 0,0:18:50.08,0:18:53.59,Default,,0,0,0,,Тенебраның 16 жыл бұрын болғанын бірінші рет естіп тұрмын.
Dialogue: 0,0:18:53.67,0:18:55.42,Default,,0,0,0,,Мұндай жазба болған жоқ.
Dialogue: 0,0:18:55.92,0:18:58.01,Default,,0,0,0,,Бұл өте құпия мәселе.
Dialogue: 0,0:18:58.09,0:19:00.43,Default,,0,0,0,,Бенвуд мұны қайдан біледі?
Dialogue: 0,0:19:00.51,0:19:02.09,Default,,0,0,0,,Түссіз қараңғыда
Dialogue: 0,0:19:02.18,0:19:05.39,Default,,0,0,0,,Сіздің ойыңызша, Тенебраны мөрленген кім?
Dialogue: 0,0:19:05.47,0:19:08.73,Default,,0,0,0,,Оған дейін Финис, Тенебраның түссіз қараңғылығында?
Dialogue: 0,0:19:08.81,0:19:11.15,Default,,0,0,0,,Тұңғиық қақпасы ашық.
Dialogue: 0,0:19:11.65,0:19:14.86,Default,,0,0,0,,Сол кезде мен қақпаны мөрлеп үлгердім, бірақ
Dialogue: 0,0:19:14.94,0:19:16.86,Default,,0,0,0,,Тұңғиық қақпасы дегеніміз не?
Dialogue: 0,0:19:16.94,0:19:20.40,Default,,0,0,0,,Басқа әлемге апаратын тұңғиыққа апаратын есік туралы айтқаныңызға сенімдісіз бе?
Dialogue: 0,0:19:20.49,0:19:21.36,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:21.45,0:19:24.87,Default,,0,0,0,,Түссіз қараңғылық дүниені байланыстыратын шеті.
Dialogue: 0,0:19:25.45,0:19:26.37,Default,,0,0,0,,Кизахаши?
Dialogue: 0,0:19:26.45,0:19:30.71,Default,,0,0,0,,Түссіз қараңғылық мөлдір және кез келген түске боялмаған.
Dialogue: 0,0:19:30.79,0:19:33.75,Default,,0,0,0,,Бұл барлық түстерді қамтитын қараңғылық.
Dialogue: 0,0:19:33.83,0:19:37.88,Default,,0,0,0,,Барлық зындандар осы жерден туып, осында оралады.
Dialogue: 0,0:19:37.96,0:19:42.13,Default,,0,0,0,,Басқаша айтқанда, дүние жүзіндегі барлық зындандар түссіз қараңғылыққа апарады?
Dialogue: 0,0:19:42.22,0:19:42.93,Default,,0,0,0,,Иә
Dialogue: 0,0:19:43.01,0:19:45.39,Default,,0,0,0,,Барлық зындандар қосылған.
Dialogue: 0,0:19:45.47,0:19:46.85,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:46.93,0:19:49.98,Default,,0,0,0,,Түссіз қараңғылық дүниенің зындандарымен байланысқан.
Dialogue: 0,0:19:50.48,0:19:53.15,Default,,0,0,0,,Ал түссіз қараңғыда Тұңғиық қақпасы жатыр.
Dialogue: 0,0:19:53.23,0:19:54.90,Default,,0,0,0,,Басқа әлемге қосылған
Dialogue: 0,0:19:55.48,0:19:56.77,Default,,0,0,0,,Бенвуд және басқалармен мөрленген
Dialogue: 0,0:19:56.86,0:19:59.61,Default,,0,0,0,,Түссіз қараңғылықтың шыңырау қақпасы ашық.
Dialogue: 0,0:19:59.69,0:20:01.90,Default,,0,0,0,,Бұл пломбаның сынғанын білдіре ме?
Dialogue: 0,0:20:01.99,0:20:04.24,Default,,0,0,0,,Сол жерден аққан қараңғылық
Dialogue: 0,0:20:04.32,0:20:06.41,Default,,0,0,0,,Дүние жүзіндегі зындандарға толы
Dialogue: 0,0:20:06.49,0:20:09.04,Default,,0,0,0,,Бұл Тенебраның қара қабырғасы ма?
Dialogue: 0,0:20:09.62,0:20:13.04,Default,,0,0,0,,Қойсам, Салмұталия... жоқ, дүние...
Dialogue: 0,0:20:13.12,0:20:15.29,Default,,0,0,0,,Tenebrae жұтып қойған
Dialogue: 0,0:20:16.50,0:20:18.17,Default,,0,0,0,,Олай болса, негізгі клапанды өшірейік.
Dialogue: 0,0:20:18.25,0:20:20.67,Default,,0,0,0,,Менің ойымша, бұл жалғыз шешім.
Dialogue: 0,0:20:20.76,0:20:24.05,Default,,0,0,0,,Түссіз қараңғылықты жеңіп, Тұңғиық қақпасын жабыңыз
Dialogue: 0,0:20:24.55,0:20:28.22,Default,,0,0,0,,Олай етсек, қараңғылықтың ағуы мен оның әр жаққа кетуі тоқтайды.
Dialogue: 0,0:20:28.31,0:20:29.81,Default,,0,0,0,,Әлемді құтқара алады
Dialogue: 0,0:20:32.39,0:20:34.98,Default,,0,0,0,,Тезірек Финиске оралайық.
Dialogue: 0,0:20:35.06,0:20:36.40,Default,,0,0,0,,Түссіз қараңғылыққа!
Dialogue: 0,0:20:38.82,0:20:40.61,Default,,0,0,0,,Сіз оны мөрлей алдыңыз.
Dialogue: 0,0:20:40.69,0:20:43.07,Default,,0,0,0,,Жою әзірше тоқтатылады.
Dialogue: 0,0:20:43.15,0:20:45.57,Default,,0,0,0,,Шығыс та, батыс жағалаулары да қызыл шөлдер болғандықтан—
Dialogue: 0,0:20:46.16,0:20:48.24,Default,,0,0,0,,Жын патшасы бағынбаса
Dialogue: 0,0:20:48.33,0:20:52.08,Default,,0,0,0,,Бір күні әлемді төңкерілген Тенебра лабиринті жұтып қояды.
Dialogue: 0,0:20:52.66,0:20:54.92,Default,,0,0,0,,Менің жиенімнің туған жеріндей.
Dialogue: 0,0:20:57.29,0:20:59.21,Default,,0,0,0,,Сіз неден үміт үзесіз?
Dialogue: 0,0:20:59.29,0:21:00.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:00.59,0:21:02.38,Default,,0,0,0,,Мен үмітсіз емеспін
Dialogue: 0,0:21:02.88,0:21:04.63,Default,,0,0,0,,Үмітті
Dialogue: 0,0:21:05.13,0:21:08.43,Default,,0,0,0,,Бір күні біздің өсиетімізді біреу мұрагер етеді
Dialogue: 0,0:21:08.51,0:21:09.97,Default,,0,0,0,,Ол әлемді құтқарады.
Dialogue: 0,0:21:10.64,0:21:14.43,Default,,0,0,0,,Иә, бір күні жаңа батыр шығады...
Dialogue: 0,0:21:16.56,0:21:18.56,Default,,0,0,0,,♪～
Dialogue: 0,0:22:43.57,0:22:45.57,Default,,0,0,0,,～♪
Dialogue: 0,0:22:47.49,0:22:49.70,Default,,0,0,0,,Келесі жолы «Төңкерілген лабиринт»
