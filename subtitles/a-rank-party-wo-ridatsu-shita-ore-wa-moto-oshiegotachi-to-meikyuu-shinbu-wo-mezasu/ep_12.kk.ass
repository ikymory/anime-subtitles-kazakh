Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.75,0:00:09.88,Default,,0,0,0,,Қуыршаққа ұқсайды, қалай ойлайсың?
Dialogue: 0,0:00:09.96,0:00:11.63,Default,,0,0,0,,Мана сезіледі
Dialogue: 0,0:00:11.72,0:00:14.05,Default,,0,0,0,,Бұл шынжырлы құбыжық сияқты көрінуі мүмкін.
Dialogue: 0,0:00:15.80,0:00:17.22,Default,,0,0,0,,Барлаайық
Dialogue: 0,0:00:22.31,0:00:23.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:25.52,0:00:26.94,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:44.91,0:00:45.87,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:00:47.63,0:00:49.67,Default,,0,0,0,,Бұл... көмектесті.
Dialogue: 0,0:00:49.75,0:00:51.09,Default,,0,0,0,,Мен өліп қала жаздадым
Dialogue: 0,0:00:52.67,0:00:54.22,Default,,0,0,0,,Не? Яғни
Dialogue: 0,0:00:54.30,0:00:55.59,Default,,0,0,0,,Бұл құрттың бір түрі ме?
Dialogue: 0,0:00:55.68,0:00:58.64,Default,,0,0,0,,Көз алмасы маған қараған сәтте денем қатып қалды.
Dialogue: 0,0:00:58.72,0:01:00.51,Default,,0,0,0,,Мен қозғала алмаймын.
Dialogue: 0,0:01:00.60,0:01:02.64,Default,,0,0,0,,Мен оны жалғыз қалдыра алмаймын.
Dialogue: 0,0:01:02.72,0:01:03.98,Default,,0,0,0,,Қашықтан шабуыл жасау
Dialogue: 0,0:01:04.06,0:01:04.85,Default,,0,0,0,,...
Dialogue: 0,0:01:04.93,0:01:06.56,Default,,0,0,0,,Енді мұның уақыты келді.
Dialogue: 0,0:01:07.23,0:01:09.19,Default,,0,0,0,,Өтінемін, Стингер Джо.
Dialogue: 0,0:01:09.27,0:01:10.57,Default,,0,0,0,,Мен ше?
Dialogue: 0,0:01:11.07,0:01:12.36,Default,,0,0,0,,Жанып тұрған жебені сұрау
Dialogue: 0,0:01:12.44,0:01:13.03,Default,,0,0,0,,Иә
Dialogue: 0,0:01:13.53,0:01:15.20,Default,,0,0,0,,Жаңбыр мұзға негізделген сиқырды пайдаланады.
Dialogue: 0,0:01:15.70,0:01:19.41,Default,,0,0,0,,Ол жәндіктердің қуыршақтарына ұқсайды және жылу өзгерістеріне сезімтал болуы мүмкін.
Dialogue: 0,0:01:19.49,0:01:20.78,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:01:21.28,0:01:22.70,Default,,0,0,0,,Физикалық сиқырлау
Dialogue: 0,0:01:25.29,0:01:26.37,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:01:26.46,0:01:28.33,Default,,0,0,0,,-Жарайды -Дайын
Dialogue: 0,0:01:28.42,0:01:30.09,Default,,0,0,0,,-Жарайды -Ссу!
Dialogue: 0,0:01:30.17,0:01:31.13,Default,,0,0,0,,Шық!
Dialogue: 0,0:01:34.55,0:01:35.84,Default,,0,0,0,,Жарқыл!
Dialogue: 0,0:01:40.76,0:01:41.93,Default,,0,0,0,,Соқырлық
Dialogue: 0,0:01:44.35,0:01:46.18,Default,,0,0,0,,Мұзбен жабылған тыйым салынған аймақ
Dialogue: 0,0:01:46.27,0:01:48.14,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:01:54.53,0:01:55.03,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:58.20,0:02:00.45,Default,,0,0,0,,Қатқан жұлдыздың астында, боран
Dialogue: 0,0:02:00.53,0:02:03.74,Default,,0,0,0,,Бесінші деңгейлі сиқырлы боран!
Dialogue: 0,0:02:06.75,0:02:07.79,Default,,0,0,0,,О...
Dialogue: 0,0:02:10.63,0:02:11.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:16.26,0:02:18.09,Default,,0,0,0,,Уф... аяқтай алмадым.
Dialogue: 0,0:02:18.17,0:02:19.72,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:02:19.80,0:02:20.47,Default,,0,0,0,,Сиқырлы қылыштың өзгеруі!
Dialogue: 0,0:02:22.18,0:02:22.72,Default,,0,0,0,,Әй!
Dialogue: 0,0:02:24.56,0:02:25.85,Default,,0,0,0,,Сыни қару
Dialogue: 0,0:02:27.43,0:02:28.69,Default,,0,0,0,,Хааах!
Dialogue: 0,0:02:29.56,0:02:30.27,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:02:32.15,0:02:33.15,Default,,0,0,0,,Даа!
Dialogue: 0,0:02:39.11,0:02:39.99,Default,,0,0,0,,Аа...
Dialogue: 0,0:02:40.07,0:02:41.99,Default,,0,0,0,,Жақсы, аяқталды ма?
Dialogue: 0,0:02:45.54,0:02:47.54,Default,,0,0,0,,♪～
Dialogue: 0,0:04:12.91,0:04:14.92,Default,,0,0,0,,～♪
Dialogue: 0,0:04:15.54,0:04:16.25,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:04:16.33,0:04:18.54,Default,,0,0,0,,Сақина қайтадан пайда болды.
Dialogue: 0,0:04:20.59,0:04:22.42,Default,,0,0,0,,Сиқырлы тастарды алмастыра ма?
Dialogue: 0,0:04:22.51,0:04:23.38,Default,,0,0,0,,Хмм
Dialogue: 0,0:04:23.88,0:04:27.30,Default,,0,0,0,,Бұл лабиринттегі құбыжықтарға ортақ нәрсе бар...
Dialogue: 0,0:04:27.39,0:04:28.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:30.35,0:04:31.31,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:33.06,0:04:34.44,Default,,0,0,0,,- (Юк) Марина? -Аа...
Dialogue: 0,0:04:34.52,0:04:37.19,Default,,0,0,0,,Иә, жақсы...
Dialogue: 0,0:04:40.53,0:04:42.94,Default,,0,0,0,,Мен оны сәл кейінірек ұйымдастырамын.
Dialogue: 0,0:04:43.65,0:04:44.78,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:47.16,0:04:48.66,Default,,0,0,0,,Сол жерде кішкене үзіліс жасайық.
Dialogue: 0,0:04:49.37,0:04:50.87,Default,,0,0,0,,Мен біраз уақыт үзіліс жасаймын.
Dialogue: 0,0:04:50.95,0:04:52.16,Default,,0,0,0,,Бөлу кесіндісі
Dialogue: 0,0:04:52.25,0:04:53.54,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,0:04:56.83,0:04:57.83,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:04:58.42,0:05:02.09,Default,,0,0,0,,Бұл жидек хош иістендірілген шай, бірақ сәл қымбат.
Dialogue: 0,0:05:02.17,0:05:04.84,Default,,0,0,0,,Хаа~ Мен оны жан-тәніммен сезінемін.
Dialogue: 0,0:05:06.05,0:05:07.93,Default,,0,0,0,,Печенье де дәмді.
Dialogue: 0,0:05:08.01,0:05:10.43,Default,,0,0,0,,Сізге ұнағанына қуаныштымын.
Dialogue: 0,0:05:12.14,0:05:13.27,Default,,0,0,0,,Аа...
Dialogue: 0,0:05:13.35,0:05:16.44,Default,,0,0,0,,Мм... Менен бірдеңе сұрайын деп едім.
Dialogue: 0,0:05:17.02,0:05:18.40,Default,,0,0,0,,Әңгімелеу
Dialogue: 0,0:05:18.48,0:05:20.82,Default,,0,0,0,,Бұл бұрынғы құбыжық.
Dialogue: 0,0:05:20.90,0:05:23.19,Default,,0,0,0,,Бұл адамның жауабы болды.
Dialogue: 0,0:05:23.28,0:05:24.24,Default,,0,0,0,,О
Dialogue: 0,0:05:24.74,0:05:27.74,Default,,0,0,0,,Бірақ бұл бәрі емес...
Dialogue: 0,0:05:28.82,0:05:32.04,Default,,0,0,0,,Сол кезде мен де діңгекті екпінмен шауып тастадым.
Dialogue: 0,0:05:33.79,0:05:37.08,Default,,0,0,0,,Біреуді кесіп тастайтын сезім де болды.
Dialogue: 0,0:05:37.17,0:05:38.50,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:38.58,0:05:43.96,Default,,0,0,0,,Шынында да, менің самурай бөлігім біреуді өлтіргенімді айтты.
Dialogue: 0,0:05:46.38,0:05:47.59,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:48.47,0:05:51.80,Default,,0,0,0,,Мен осы жерден кесіп, қайта тексерейін бе?
Dialogue: 0,0:05:51.89,0:05:52.93,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:53.01,0:05:56.35,Default,,0,0,0,,Шындығында, мен оны келесі бөлмеде қолданып көрдім.
Dialogue: 0,0:05:56.43,0:05:59.23,Default,,0,0,0,,Бірақ мен түсінбедім.
Dialogue: 0,0:05:59.31,0:06:02.57,Default,,0,0,0,,Бұл менің самурайымның жетілмегендігінен деп ойлаймын.
Dialogue: 0,0:06:02.65,0:06:06.40,Default,,0,0,0,,Мен оны өмір алмасып жатқанда ғана сезіне алатын сияқтымын.
Dialogue: 0,0:06:06.90,0:06:10.03,Default,,0,0,0,,Біртүрлі айтқаным үшін кешіріңіз.
Dialogue: 0,0:06:10.53,0:06:13.74,Default,,0,0,0,,Менімен сөйлескеніңізге рахмет, Марина.
Dialogue: 0,0:06:14.66,0:06:15.87,Default,,0,0,0,,Юк…
Dialogue: 0,0:06:16.45,0:06:19.58,Default,,0,0,0,,Бұл зындан шынымен де біртүрлі.
Dialogue: 0,0:06:19.67,0:06:21.67,Default,,0,0,0,,Рухтың да біртүрлі қатысуы бар...
Dialogue: 0,0:06:21.75,0:06:22.29,Default,,0,0,0,,Біртүрлі?
Dialogue: 0,0:06:22.38,0:06:25.96,Default,,0,0,0,,Қарым-қатынаста шамалы сәйкессіздік бар.
Dialogue: 0,0:06:26.05,0:06:27.80,Default,,0,0,0,,Сіз түсінбейтін адамға
Dialogue: 0,0:06:27.88,0:06:30.72,Default,,0,0,0,,ым-ишарамен сөйлесу, дәлірек айтсақ
Dialogue: 0,0:06:30.80,0:06:33.64,Default,,0,0,0,,Жауаптың мақсаты басқа.
Dialogue: 0,0:06:33.72,0:06:34.93,Default,,0,0,0,,-Ах... -(Юк) А?
Dialogue: 0,0:06:35.01,0:06:36.56,Default,,0,0,0,,Егер мен мұны айту керек болсам,
Dialogue: 0,0:06:37.18,0:06:39.69,Default,,0,0,0,,Сұр өріске жақын болуы мүмкін
Dialogue: 0,0:06:40.19,0:06:41.85,Default,,0,0,0,,Персефон әжей болды...
Dialogue: 0,0:06:42.77,0:06:44.19,Default,,0,0,0,,Бірақ мен түсіндім.
Dialogue: 0,0:06:44.27,0:06:46.94,Default,,0,0,0,,Бұл зындандағы мана да басқаша.
Dialogue: 0,0:06:47.03,0:06:49.70,Default,,0,0,0,,Атмосфера біз әдеттегіден басқаша.
Dialogue: 0,0:06:49.78,0:06:52.70,Default,,0,0,0,,Мен де солай сезінемін.
Dialogue: 0,0:06:52.78,0:06:55.08,Default,,0,0,0,,Мұғалім, біз не істеуіміз керек?
Dialogue: 0,0:06:56.16,0:06:57.62,Default,,0,0,0,,Шатырға шығайық
Dialogue: 0,0:06:57.70,0:07:00.33,Default,,0,0,0,,Мен қаланың жалпы көрінісін түсінгім келеді.
Dialogue: 0,0:07:00.42,0:07:02.00,Default,,0,0,0,,Масштабтау
Dialogue: 0,0:07:02.67,0:07:03.71,Default,,0,0,0,,кең
Dialogue: 0,0:07:03.79,0:07:06.67,Default,,0,0,0,,Бұл Дуна сияқты, тіпті жақсырақ.
Dialogue: 0,0:07:06.75,0:07:09.38,Default,,0,0,0,,Мұның бәрі зындан...
Dialogue: 0,0:07:09.47,0:07:10.59,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:07:10.68,0:07:11.88,Default,,0,0,0,,О
Dialogue: 0,0:07:11.97,0:07:14.68,Default,,0,0,0,,Бұл Мен бақыттымын ба?
Dialogue: 0,0:07:14.76,0:07:16.97,Default,,0,0,0,,Мен көрінетін диапазонды есте сақтадым.
Dialogue: 0,0:07:17.06,0:07:18.56,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:18.64,0:07:19.73,Default,,0,0,0,,Енді қамалға барыңыз
Dialogue: 0,0:07:20.43,0:07:22.98,Default,,0,0,0,,Құлып ішінде не болып жатқанын тексергеннен кейін
Dialogue: 0,0:07:23.73,0:07:25.23,Default,,0,0,0,,Бүгін біз бас тартамыз
Dialogue: 0,0:07:27.32,0:07:30.24,Default,,0,0,0,,Тыныштық сонша, қорқынышты.
Dialogue: 0,0:07:30.32,0:07:31.95,Default,,0,0,0,,Шынымен
Dialogue: 0,0:07:32.03,0:07:34.99,Default,,0,0,0,,Лодж әлі де тұрғындар бар екенін айтты.
Dialogue: 0,0:07:35.07,0:07:37.95,Default,,0,0,0,,Мына қария қайда?
Dialogue: 0,0:07:38.04,0:07:40.79,Default,,0,0,0,,Ол да трансляцияда көрсетілмеді.
Dialogue: 0,0:07:40.87,0:07:44.58,Default,,0,0,0,,Біз шынымен галлюцинация көрген шығармыз.
Dialogue: 0,0:07:44.67,0:07:46.38,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:07:46.46,0:07:48.63,Default,,0,0,0,,Бірақ сіз Жаңбырды да көре аласыз, солай ма?
Dialogue: 0,0:07:48.71,0:07:49.21,Default,,0,0,0,,Иә
Dialogue: 0,0:07:49.92,0:07:53.43,Default,,0,0,0,,Менде Юк сыйлаған ақыл сақинасы бар.
Dialogue: 0,0:07:53.51,0:07:55.22,Default,,0,0,0,,Психикалық кедергі жоқ
Dialogue: 0,0:07:55.30,0:07:58.97,Default,,0,0,0,,Өйткені, ол ата шынымен бар.
Dialogue: 0,0:07:59.06,0:08:00.77,Default,,0,0,0,,Қанша уақыт күтуімді күтесің? Жылдам бол.
Dialogue: 0,0:08:00.85,0:08:04.60,Default,,0,0,0,,Камераға бірдеңе әсер етті деп ойлаған дұрыс.
Dialogue: 0,0:08:04.69,0:08:06.23,Default,,0,0,0,,Бұл табиғи болуы мүмкін.
Dialogue: 0,0:08:06.31,0:08:07.73,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:07.82,0:08:09.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:09.32,0:08:11.99,Default,,0,0,0,,А, Юк ана жақта.
Dialogue: 0,0:08:17.87,0:08:19.16,Default,,0,0,0,,Журнал!
Dialogue: 0,0:08:19.24,0:08:20.66,Default,,0,0,0,,J-
Dialogue: 0,0:08:22.25,0:08:25.17,Default,,0,0,0,,Водан сарайына қош келдіңіз
Dialogue: 0,0:08:25.25,0:08:27.50,Default,,0,0,0,,Айтыңызшы, Қаскөй
Dialogue: 0,0:08:27.59,0:08:28.67,Default,,0,0,0,,Бұл қандай қала?
Dialogue: 0,0:08:28.75,0:08:29.92,Default,,0,0,0,,Хи хи...
Dialogue: 0,0:08:30.00,0:08:32.42,Default,,0,0,0,,Мұны білгенде не істейсің?
Dialogue: 0,0:08:32.51,0:08:35.55,Default,,0,0,0,,Осы ымыртта боялған көшелер мен адамдар
Dialogue: 0,0:08:35.64,0:08:40.18,Default,,0,0,0,,Мен құтқарылғаным сонша, енді көмектесе алмаймын
Dialogue: 0,0:08:40.93,0:08:43.94,Default,,0,0,0,,Бұл құбыжықтар бастапқыда адамдар ма?
Dialogue: 0,0:08:44.02,0:08:45.73,Default,,0,0,0,,Мынау
Dialogue: 0,0:08:45.81,0:08:48.98,Default,,0,0,0,,Енді адам дегеніміз не?
Dialogue: 0,0:08:49.07,0:08:53.03,Default,,0,0,0,,Аяқ-қолы мен басы бар тірі ма?
Dialogue: 0,0:08:53.11,0:08:53.82,Default,,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:08:53.90,0:08:56.70,Default,,0,0,0,,Менің сұрайтыным бұл емес.
Dialogue: 0,0:08:56.78,0:08:58.49,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:08:58.57,0:09:02.66,Default,,0,0,0,,Жоқ, Юке мырза, қалай болса да.
Dialogue: 0,0:09:02.75,0:09:08.21,Default,,0,0,0,,Адам тұлға бола ала ма деген сұрақ маңызды мәселе.
Dialogue: 0,0:09:08.29,0:09:11.34,Default,,0,0,0,,Лодж мырза, алтын сақина дегеніміз не?
Dialogue: 0,0:09:11.42,0:09:12.76,Default,,0,0,0,,Яғни
Dialogue: 0,0:09:12.84,0:09:16.22,Default,,0,0,0,,«Бір алтын» деп аталады.
Dialogue: 0,0:09:16.30,0:09:19.55,Default,,0,0,0,,Бір? Соншама көп пе?
Dialogue: 0,0:09:19.64,0:09:21.72,Default,,0,0,0,,Сен мұнымен не тоқисың?
Dialogue: 0,0:09:21.81,0:09:22.85,Default,,0,0,0,,Тоқу?
Dialogue: 0,0:09:23.43,0:09:27.31,Default,,0,0,0,,Ақылды болу міндетті түрде бақытты білдірмейді.
Dialogue: 0,0:09:27.40,0:09:30.48,Default,,0,0,0,,Әдемі көк шашы бар жас келіншек
Dialogue: 0,0:09:30.57,0:09:32.61,Default,,0,0,0,,Мен жай ғана білгім келеді
Dialogue: 0,0:09:33.11,0:09:34.99,Default,,0,0,0,,Бұл не әкеледі?
Dialogue: 0,0:09:35.07,0:09:38.28,Default,,0,0,0,,Сіз қазір байқаған боларсыз.
Dialogue: 0,0:09:38.36,0:09:39.53,Default,,0,0,0,,Ата!
Dialogue: 0,0:09:40.32,0:09:43.49,Default,,0,0,0,,Келесі кезде қашан көреміз?
Dialogue: 0,0:09:43.58,0:09:47.54,Default,,0,0,0,,Мен бұл лог ойынын асыға күтемін.
Dialogue: 0,0:09:47.62,0:09:50.67,Default,,0,0,0,,Сонда менің сұрақтарыма жауап бересіз бе?
Dialogue: 0,0:09:50.75,0:09:55.26,Default,,0,0,0,,Шындықты өзіңіз сезінсеңіз жақсы болар еді.
Dialogue: 0,0:09:55.76,0:09:58.59,Default,,0,0,0,,Сіз шынымен кімсіз?
Dialogue: 0,0:09:58.68,0:09:59.93,Default,,0,0,0,,Мен білмеймін...
Dialogue: 0,0:10:02.64,0:10:04.93,Default,,0,0,0,,Бізді шақырған сияқты
Dialogue: 0,0:10:05.02,0:10:09.48,Default,,0,0,0,,Жарайды, қамалға бір қарап алайық, сосын шегінеміз.
Dialogue: 0,0:10:10.61,0:10:12.82,Default,,0,0,0,,Водан қамалына жақындаудың басталуы
Dialogue: 0,0:10:12.90,0:10:14.53,Default,,0,0,0,,Сақтықпен ләззат алыңыз
Dialogue: 0,0:10:17.32,0:10:19.20,Default,,0,0,0,,Бұл деректерді талдау не болды?
Dialogue: 0,0:10:19.28,0:10:21.45,Default,,0,0,0,,Қазіргі уақытта шұғыл талдау жүргізілуде
Dialogue: 0,0:10:22.03,0:10:23.95,Default,,0,0,0,,Водан сарайы деп аталатын құлып
Dialogue: 0,0:10:24.04,0:10:25.66,Default,,0,0,0,,Мен жан-жақты зерттедім
Dialogue: 0,0:10:26.16,0:10:29.29,Default,,0,0,0,,Бақшалардағы және жаттығу алаңындағы қоралар...
Dialogue: 0,0:10:29.37,0:10:33.46,Default,,0,0,0,,Бірақ біз интерьерге кіретін есік таба алмадық.
Dialogue: 0,0:10:33.54,0:10:35.50,Default,,0,0,0,,Қаскөй деген қарт
Dialogue: 0,0:10:35.59,0:10:37.80,Default,,0,0,0,,Бұл жолы да көрсетілмеді.
Dialogue: 0,0:10:37.88,0:10:40.59,Default,,0,0,0,,Бұл жаппай галлюцинация емес сияқты.
Dialogue: 0,0:10:40.68,0:10:43.30,Default,,0,0,0,,Бұл сиқырдың бір түрі ме?
Dialogue: 0,0:10:43.39,0:10:47.60,Default,,0,0,0,,Шынымды айтсам, тергеудің мазмұны тамаша.
Dialogue: 0,0:10:47.68,0:10:50.44,Default,,0,0,0,,Журналыңыз жақсы ұйымдастырылған.
Dialogue: 0,0:10:50.52,0:10:52.10,Default,,0,0,0,,Сіз жақсы жұмыс жасайсыз.
Dialogue: 0,0:10:52.69,0:10:53.77,Default,,0,0,0,,Академиялық факультет ретінде
Dialogue: 0,0:10:53.86,0:10:55.98,Default,,0,0,0,,Көмегіңе рахмет, Юк мырза.
Dialogue: 0,0:10:56.07,0:10:59.11,Default,,0,0,0,,Жоқ, мен сізге көмектесе алғаныма қуаныштымын.
Dialogue: 0,0:10:59.20,0:11:03.49,Default,,0,0,0,,Мен Виконт Бордманның жақын арада сонда болады деп күткен жоқпын.
Dialogue: 0,0:11:04.12,0:11:05.53,Default,,0,0,0,,Оқиға болған зындан
Dialogue: 0,0:11:05.62,0:11:08.16,Default,,0,0,0,,Өз көзіммен көргім келді.
Dialogue: 0,0:11:08.25,0:11:10.75,Default,,0,0,0,,Жарайды, бұлай қобалжыма.
Dialogue: 0,0:11:11.25,0:11:14.17,Default,,0,0,0,,Біз де авантюристпіз.
Dialogue: 0,0:11:14.25,0:11:15.38,Default,,0,0,0,,Төтенше
Dialogue: 0,0:11:15.46,0:11:19.97,Default,,0,0,0,,Менің зындан туралы білімімнің жартысы Виконттың кітаптарынан алынған.
Dialogue: 0,0:11:20.05,0:11:21.76,Default,,0,0,0,,Мен басымды көтере алмаймын.
Dialogue: 0,0:11:21.84,0:11:25.18,Default,,0,0,0,,Далада пайдалы болса қуанамын.
Dialogue: 0,0:11:25.68,0:11:27.89,Default,,0,0,0,,Енді бұл зындан.
Dialogue: 0,0:11:28.64,0:11:32.19,Default,,0,0,0,,Кіруге шектеу қойылуы мүмкін.
Dialogue: 0,0:11:32.27,0:11:33.65,Default,,0,0,0,,Пломбаның белгісі?
Dialogue: 0,0:11:34.69,0:11:37.90,Default,,0,0,0,,Сіз әкелген құбыжық материалдары туралы
Dialogue: 0,0:11:37.98,0:11:39.78,Default,,0,0,0,,Тергеу аяқталды...
Dialogue: 0,0:11:40.86,0:11:42.91,Default,,0,0,0,,Материалды бағалау нәтижелері
Dialogue: 0,0:11:42.99,0:11:46.62,Default,,0,0,0,,«Адамдардан немесе ұқсас тіршілік иелерінен алынған»
Dialogue: 0,0:11:47.24,0:11:48.41,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:48.99,0:11:51.37,Default,,0,0,0,,Иә? Сіз білдіңіз бе?
Dialogue: 0,0:11:51.46,0:11:54.79,Default,,0,0,0,,Самурай жұмысы бар мүше бар.
Dialogue: 0,0:11:54.88,0:11:57.80,Default,,0,0,0,,Оның айтуынша, бұл біреуді кесіп алғандай болды.
Dialogue: 0,0:11:57.88,0:12:00.34,Default,,0,0,0,,Онда пайда болатын құбыжықтар
Dialogue: 0,0:12:00.42,0:12:04.72,Default,,0,0,0,,Егер Чейнмен, Хризалис және т.б. барлығы адам деп есептесек
Dialogue: 0,0:12:04.80,0:12:07.93,Default,,0,0,0,,Біз енді тұрақты авантюристерді кіргізе алмаймыз.
Dialogue: 0,0:12:08.68,0:12:09.93,Default,,0,0,0,,(Танжиро) Ал, баста! (Үшеуі) Бар күшіңді сал!
Dialogue: 0,0:12:10.02,0:12:13.14,Default,,0,0,0,,Егер сіз абайсызда қарапайым авантюристерді қоссаңыз
Dialogue: 0,0:12:13.23,0:12:17.02,Default,,0,0,0,,Бұл зақымданудың жоғарылауына және толып кетуіне әкелуі мүмкін.
Dialogue: 0,0:12:17.11,0:12:18.15,Default,,0,0,0,,Аа...
Dialogue: 0,0:12:18.65,0:12:21.15,Default,,0,0,0,,Біз өте қауіпті жерде тұрмыз.
Dialogue: 0,0:12:21.24,0:12:22.90,Default,,0,0,0,,Сонда сен сонда бардың ба?
Dialogue: 0,0:12:22.99,0:12:25.03,Default,,0,0,0,,Виконт Маньера
Dialogue: 0,0:12:25.11,0:12:27.66,Default,,0,0,0,,Марина да осылай деді...
Dialogue: 0,0:12:28.16,0:12:32.41,Default,,0,0,0,,(Маринаның гуілдеуі)
Dialogue: 0,0:12:33.66,0:12:37.50,Default,,0,0,0,,Бағана да біреуді кесіп тастайтындай сезімде болды.
Dialogue: 0,0:12:37.59,0:12:40.42,Default,,0,0,0,,Сізде осындай ақымақ әңгіме бар ма?
Dialogue: 0,0:12:40.50,0:12:42.17,Default,,0,0,0,,Бұл зынданда болды -
Dialogue: 0,0:12:42.26,0:12:44.97,Default,,0,0,0,,Жердің және ғимараттардың бөліктерін қайтару
Dialogue: 0,0:12:45.05,0:12:47.60,Default,,0,0,0,,Мен оны кеше тапсырдым деп ойлаймын...
Dialogue: 0,0:12:47.68,0:12:49.68,Default,,0,0,0,,- Әй! -(Қызметкерлер) А, иә.
Dialogue: 0,0:12:49.76,0:12:53.35,Default,,0,0,0,,Мына бала қайтып әкелген тақталар мен тастар болды.
Dialogue: 0,0:12:53.43,0:12:55.35,Default,,0,0,0,,Сіз бұл нәрсені бағалауды аяқтадыңыз ба?
Dialogue: 0,0:12:55.44,0:12:56.10,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:56.19,0:12:59.44,Default,,0,0,0,,Сіз оны ертең ресми бағалауға жіберетінін айттыңыз.
Dialogue: 0,0:12:59.52,0:13:02.78,Default,,0,0,0,,Бағалаушының бөксесін түртіп, оны дәл қазір оятыңыз!
Dialogue: 0,0:13:02.86,0:13:03.90,Default,,0,0,0,,Бұл аз
Dialogue: 0,0:13:03.99,0:13:05.03,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:13:05.53,0:13:06.45,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:13:06.53,0:13:09.12,Default,,0,0,0,,Ал мына алтын сақина.
Dialogue: 0,0:13:09.20,0:13:12.79,Default,,0,0,0,,Ах, Рейн-кун сұраған жабдық
Dialogue: 0,0:13:12.87,0:13:14.96,Default,,0,0,0,,Өндіріс қазірдің өзінде басталды
Dialogue: 0,0:13:15.04,0:13:16.08,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:16.71,0:13:20.00,Default,,0,0,0,,Мен тағы бір маңызды нәрсе туралы айтуым керек.
Dialogue: 0,0:13:20.50,0:13:22.34,Default,,0,0,0,,Сіз Мисти туралы білесіз, солай ма?
Dialogue: 0,0:13:22.42,0:13:25.84,Default,,0,0,0,,Денсаулығыңызға шағымданғаннан кейін зейнетке шықтыңыз, солай ма?
Dialogue: 0,0:13:26.51,0:13:29.72,Default,,0,0,0,,Хабарды тыңдап отырғандардың қатарында
Dialogue: 0,0:13:29.80,0:13:31.85,Default,,0,0,0,,Осыған ұқсас ауытқулар болған адамдар бар.
Dialogue: 0,0:13:31.93,0:13:32.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:32.93,0:13:37.06,Default,,0,0,0,,Кішігірім физикалық аурудан кенеттен зорлық-зомбылыққа ұшырағандарға дейін
Dialogue: 0,0:13:37.14,0:13:38.69,Default,,0,0,0,,Көптеген жағдайлар бар.
Dialogue: 0,0:13:39.19,0:13:42.36,Default,,0,0,0,,Тарату бейнежазбасында бірдеңе бар деп болжау орынды болар еді.
Dialogue: 0,0:13:42.44,0:13:45.53,Default,,0,0,0,,Бұл соншалықты жарық па?
Dialogue: 0,0:13:45.61,0:13:48.86,Default,,0,0,0,,Мүмкін бұл ақылға әсер етеді.
Dialogue: 0,0:13:48.95,0:13:52.66,Default,,0,0,0,,Қала көрінісі және осы ымыртта боялған адамдар
Dialogue: 0,0:13:52.74,0:13:57.00,Default,,0,0,0,,Мен құтқарылғаным сонша, енді көмектесе алмаймын
Dialogue: 0,0:13:59.08,0:14:01.88,Default,,0,0,0,,Тергеу стратегиясы тоқтатылғаннан кейін,
Dialogue: 0,0:14:01.96,0:14:04.26,Default,,0,0,0,,Мөрді белгілеу үшін не істеу керек
Dialogue: 0,0:14:04.34,0:14:07.01,Default,,0,0,0,,Мен патшалық парламентінен сот шешімін сұрағым келеді.
Dialogue: 0,0:14:07.09,0:14:10.97,Default,,0,0,0,,Жарайды, не істеуіміз керек?
Dialogue: 0,0:14:11.05,0:14:12.81,Default,,0,0,0,,Сондай-ақ тергеу стратегиясында бірнеше рет
Dialogue: 0,0:14:12.89,0:14:15.31,Default,,0,0,0,,Сізден кіру сұралуы мүмкін.
Dialogue: 0,0:14:15.39,0:14:18.35,Default,,0,0,0,,Сондықтан Дунамен біраз уақыт болғаныңызды қалаймын.
Dialogue: 0,0:14:18.44,0:14:21.44,Default,,0,0,0,,Әнші Ожикүтейге байланысты әңгіме бар
Dialogue: 0,0:14:21.52,0:14:22.02,Default,,0,0,0,,Иә
Dialogue: 0,0:14:22.65,0:14:25.28,Default,,0,0,0,,Енді Дунаға оралайық.
Dialogue: 0,0:14:28.24,0:14:32.07,Default,,0,0,0,,Та... бұл қиын! Бұл бала біртүрлі болып кетті
Dialogue: 0,0:14:32.16,0:14:32.78,Default,,0,0,0,,Біртүрлі?
Dialogue: 0,0:14:32.87,0:14:35.29,Default,,0,0,0,,...
Dialogue: 0,0:14:35.37,0:14:36.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:39.33,0:14:40.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:44.75,0:14:47.59,Default,,0,0,0,,...
Dialogue: 0,0:14:47.67,0:14:48.63,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:14:48.72,0:14:49.97,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:14:50.05,0:14:52.05,Default,,0,0,0,,...
Dialogue: 0,0:14:52.14,0:14:53.93,Default,,0,0,0,,...
Dialogue: 0,0:14:54.89,0:14:57.93,Default,,0,0,0,,Мен сені күттім, Юк Фердио.
Dialogue: 0,0:14:58.64,0:15:00.06,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:15:00.14,0:15:03.81,Default,,0,0,0,,Мен «Алтын діни әйел» атандым.
Dialogue: 0,0:15:04.52,0:15:05.69,Default,,0,0,0,,Алтын әулие қыз?
Dialogue: 0,0:15:07.07,0:15:10.45,Default,,0,0,0,,Уақытымыз аз қалды.
Dialogue: 0,0:15:10.53,0:15:12.36,Default,,0,0,0,,...
Dialogue: 0,0:15:12.45,0:15:15.20,Default,,0,0,0,,Енді жойылу қаупі бар
Dialogue: 0,0:15:15.28,0:15:17.04,Default,,0,0,0,,Келісім жасасамыз ба?
Dialogue: 0,0:15:17.12,0:15:18.50,Default,,0,0,0,,“”
Dialogue: 0,0:15:18.58,0:15:20.96,Default,,0,0,0,,Қажетсіз нәрселерден арылу
Dialogue: 0,0:15:21.62,0:15:24.29,Default,,0,0,0,,Біздің әлем тарайды
Dialogue: 0,0:15:24.38,0:15:26.55,Default,,0,0,0,,...
Dialogue: 0,0:15:26.63,0:15:27.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:28.76,0:15:31.51,Default,,0,0,0,,Сіз Glad She'yim-ді көрдіңіз, солай емес пе?
Dialogue: 0,0:15:32.22,0:15:36.35,Default,,0,0,0,,Тек ымырт, бұрмалау және үлкейген ерік
Dialogue: 0,0:15:36.43,0:15:39.10,Default,,0,0,0,,Жақында бұл әлемді қамтиды.
Dialogue: 0,0:15:39.68,0:15:42.56,Default,,0,0,0,,Ымырт деп сол жарықты айтасың ба?
Dialogue: 0,0:15:42.65,0:15:44.27,Default,,0,0,0,,Батып бара жатқан күннің жарығы
Dialogue: 0,0:15:44.77,0:15:48.32,Default,,0,0,0,,Бұрмалаудың себебі және таңдаудың мәні осында.
Dialogue: 0,0:15:48.40,0:15:50.82,Default,,0,0,0,,Бұл жаман болды ма?
Dialogue: 0,0:15:51.32,0:15:54.24,Default,,0,0,0,,Мисти мен басқаларды сол жарық жұтып қойған болуы керек.
Dialogue: 0,0:15:54.74,0:15:56.83,Default,,0,0,0,,Бізді де соған жұтып қояр ма екен?
Dialogue: 0,0:15:56.91,0:16:00.96,Default,,0,0,0,,Дүниенің шекарасынан бір рет өттіңіз.
Dialogue: 0,0:16:01.04,0:16:02.54,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:16:02.62,0:16:03.83,Default,,0,0,0,,...
Dialogue: 0,0:16:04.42,0:16:06.59,Default,,0,0,0,,...
Dialogue: 0,0:16:09.34,0:16:12.93,Default,,0,0,0,,Терең жүрмесең, жұтпассың.
Dialogue: 0,0:16:14.47,0:16:18.97,Default,,0,0,0,,Роджды табыңыз, ол бәрін біледі.
Dialogue: 0,0:16:19.06,0:16:20.85,Default,,0,0,0,,Бұл ата.
Dialogue: 0,0:16:20.93,0:16:24.48,Default,,0,0,0,,Мен сенімен бірнеше рет кездестім, бірақ сен маған ештеңе айтпадың.
Dialogue: 0,0:16:24.56,0:16:26.19,Default,,0,0,0,,Айтсын
Dialogue: 0,0:16:26.27,0:16:28.57,Default,,0,0,0,,Ол адам өзін бұрмалайды
Dialogue: 0,0:16:28.65,0:16:32.03,Default,,0,0,0,,Қазір ол әлем қалыптылықтың шыңында.
Dialogue: 0,0:16:32.11,0:16:34.99,Default,,0,0,0,,Сен бізге не үшін айтып тұрсың?
Dialogue: 0,0:16:35.07,0:16:36.95,Default,,0,0,0,,Өлу керек еді
Dialogue: 0,0:16:37.03,0:16:41.50,Default,,0,0,0,,Біз, ақымақ патша, надан халық,
Dialogue: 0,0:16:42.00,0:16:45.42,Default,,0,0,0,,Бірақ мен оны қабылдай алмадым.
Dialogue: 0,0:16:45.92,0:16:49.50,Default,,0,0,0,,Ал мен алтынмен мәңгілік тіледім
Dialogue: 0,0:16:49.59,0:16:50.80,Default,,0,0,0,,Алтын?
Dialogue: 0,0:16:50.88,0:16:53.42,Default,,0,0,0,,Адамдар ұстамауы керек заттар
Dialogue: 0,0:16:53.51,0:16:55.26,Default,,0,0,0,,Қарғыс атқан құдіретті
Dialogue: 0,0:16:55.34,0:16:59.26,Default,,0,0,0,,Барлық тілектеріңізді орындай алатын дүние ағашының жемісі.
Dialogue: 0,0:16:59.76,0:17:01.56,Default,,0,0,0,,Тілек дегеніміз не?
Dialogue: 0,0:17:01.64,0:17:04.94,Default,,0,0,0,,Осындай жат қаланы дүниеге әкелген қандай тілек?
Dialogue: 0,0:17:05.02,0:17:06.69,Default,,0,0,0,,Юк Фердио
Dialogue: 0,0:17:07.19,0:17:11.19,Default,,0,0,0,,Ымырт патшасын тоқтатыңыз және алтынды жойыңыз.
Dialogue: 0,0:17:11.69,0:17:14.90,Default,,0,0,0,,...
Dialogue: 0,0:17:14.99,0:17:17.32,Default,,0,0,0,,Ымырт сені жұтып қояды
Dialogue: 0,0:17:17.82,0:17:20.78,Default,,0,0,0,,Күнәларымызды кешіре көр...
Dialogue: 0,0:17:20.87,0:17:22.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:24.62,0:17:26.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:27.75,0:17:28.79,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:17:29.29,0:17:31.04,Default,,0,0,0,,Бет астында ғаламдық державалар қатал ақпараттық соғыстар жүргізетін дәуірде
Dialogue: 0,0:17:31.13,0:17:33.55,Default,,0,0,0,,Дауысы да, жүзі де өзгерген!
Dialogue: 0,0:17:35.01,0:17:39.93,Default,,0,0,0,,Ал, тағы да рахмет.
Dialogue: 0,0:17:40.01,0:17:42.22,Default,,0,0,0,,Оянғаныңызға қуаныштымын.
Dialogue: 0,0:17:42.31,0:17:43.64,Default,,0,0,0,,Ал...
Dialogue: 0,0:17:43.72,0:17:44.89,Default,,0,0,0,,Нибельн
Dialogue: 0,0:17:44.98,0:17:46.56,Default,,0,0,0,,Олай болса, Ран-чан.
Dialogue: 0,0:17:46.64,0:17:47.77,Default,,0,0,0,,...
Dialogue: 0,0:17:47.85,0:17:50.73,Default,,0,0,0,,Рун-чан, сенің денеңде ақау бар ма?
Dialogue: 0,0:17:51.61,0:17:52.57,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:17:53.19,0:17:55.69,Default,,0,0,0,,Құдайдың қатысуы жоғалып кетті
Dialogue: 0,0:17:55.78,0:17:59.70,Default,,0,0,0,,Бірақ сол ымырт сезімі жойылған жоқ.
Dialogue: 0,0:17:59.78,0:18:00.66,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:18:00.74,0:18:04.08,Default,,0,0,0,,Бұл біз оны сол қалаға қатысты адам ретінде көруіміз керек дегенді білдіре ме?
Dialogue: 0,0:18:04.16,0:18:05.45,Default,,0,0,0,,Әрине.
Dialogue: 0,0:18:05.54,0:18:07.08,Default,,0,0,0,,осы портта бір жерде жасырынып, бізді бақылап отыр.
Dialogue: 0,0:18:07.16,0:18:10.67,Default,,0,0,0,,Нибельн Бұрын не болғаны есіңізде ме?
Dialogue: 0,0:18:10.75,0:18:12.59,Default,,0,0,0,,Иә, сәл ғана
Dialogue: 0,0:18:12.67,0:18:15.59,Default,,0,0,0,,Бірақ бұл мен емес
Dialogue: 0,0:18:15.67,0:18:19.18,Default,,0,0,0,,Ол менің ішімдегі біреудің бір бөлігі
Dialogue: 0,0:18:19.26,0:18:20.84,Default,,0,0,0,,Мен кеттім
Dialogue: 0,0:18:20.93,0:18:22.26,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:22.35,0:18:25.14,Default,,0,0,0,,Жоқ, бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:18:26.27,0:18:30.06,Default,,0,0,0,,Егер бұл оқиға рас болса, бұл үлкен мәселе болар еді.
Dialogue: 0,0:18:30.56,0:18:34.94,Default,,0,0,0,,Бұл біз сияқты авантюристер көтере алатын деңгей емес.
Dialogue: 0,0:18:39.86,0:18:41.37,Default,,0,0,0,,Бетіңізді жауып тұратын бірдеңе бар ма?
Dialogue: 0,0:18:41.45,0:18:43.66,Default,,0,0,0,,Сіз мені Юкпен жалғыз қалдыра аласыз ба?
Dialogue: 0,0:18:43.74,0:18:47.00,Default,,0,0,0,,Немене, қарт кісілер әбігер болады дейсің бе?
Dialogue: 0,0:18:47.08,0:18:50.00,Default,,0,0,0,,Иә, иә, кеттік.
Dialogue: 0,0:18:52.54,0:18:54.75,Default,,0,0,0,,Бұлай қобалжудың қажеті жоқ.
Dialogue: 0,0:18:54.84,0:18:57.30,Default,,0,0,0,,Мен... Мен қобалжыдым.
Dialogue: 0,0:18:57.38,0:18:58.88,Default,,0,0,0,,Виконттар ғана емес
Dialogue: 0,0:18:58.97,0:19:01.89,Default,,0,0,0,,Мен директордың бұлай келеді деп күткен жоқпын.
Dialogue: 0,0:19:01.97,0:19:03.26,Default,,0,0,0,,О
Dialogue: 0,0:19:03.35,0:19:05.51,Default,,0,0,0,,Мен Бордманнан есеп алдым.
Dialogue: 0,0:19:05.60,0:19:07.47,Default,,0,0,0,,Сондықтан мен ұшып келдім.
Dialogue: 0,0:19:07.98,0:19:10.27,Default,,0,0,0,,Сіз шынымен де «тастау» деп айттыңыз ба?
Dialogue: 0,0:19:10.85,0:19:12.48,Default,,0,0,0,,Иә Маркиз
Dialogue: 0,0:19:12.56,0:19:14.65,Default,,0,0,0,,Мен сізге бұл сұрақты қоя аламын ба?
Dialogue: 0,0:19:14.73,0:19:16.11,Default,,0,0,0,,Әрине
Dialogue: 0,0:19:16.19,0:19:19.90,Default,,0,0,0,,Енді менің атағыма алаңдаудың қажеті жоқ.
Dialogue: 0,0:19:19.99,0:19:21.53,Default,,0,0,0,,Таңдау дегеніміз не?
Dialogue: 0,0:19:22.03,0:19:25.33,Default,,0,0,0,,Хм... Мен сізге айту керек сияқты.
Dialogue: 0,0:19:25.83,0:19:28.50,Default,,0,0,0,,Өйткені, сіз таңдалған адамсыз.
Dialogue: 0,0:19:28.58,0:19:29.29,Default,,0,0,0,,Таңдалған?
Dialogue: 0,0:19:31.50,0:19:34.38,Default,,0,0,0,,Патша сарайының жертөлесіндегі ескі қабырға суретінің көшірмесі.
Dialogue: 0,0:19:36.17,0:19:38.17,Default,,0,0,0,,Академиялық факультеттің бұрынғы президенті…
Dialogue: 0,0:19:38.67,0:19:41.63,Default,,0,0,0,,Міне, әкем осыны зерттеді.
Dialogue: 0,0:19:44.80,0:19:45.80,Default,,0,0,0,,Сіз оны оқи аласыз ба?
Dialogue: 0,0:19:45.89,0:19:48.93,Default,,0,0,0,,Жоқ, ежелгі кейіпкерлер аздап...
Dialogue: 0,0:19:49.02,0:19:53.15,Default,,0,0,0,,Әкемнің айтуы бойынша, қыру – дүниені сұрыптау.
Dialogue: 0,0:19:53.23,0:19:54.56,Default,,0,0,0,,Скрининг?
Dialogue: 0,0:19:54.65,0:19:57.73,Default,,0,0,0,,Хмм, параллель дүниенің болуы
Dialogue: 0,0:19:57.82,0:20:00.07,Default,,0,0,0,,Сіз не ұсынылып жатқанын білесіз бе?
Dialogue: 0,0:20:00.15,0:20:03.20,Default,,0,0,0,,Түссіз қараңғылыққа сүңгіп, сездім.
Dialogue: 0,0:20:03.28,0:20:05.82,Default,,0,0,0,,Дүние және параллель әлемдер
Dialogue: 0,0:20:06.62,0:20:08.49,Default,,0,0,0,,Негізінен сәйкес емес
Dialogue: 0,0:20:08.99,0:20:12.79,Default,,0,0,0,,Бірақ кейде олар бір-бірін қайталауға тырысады.
Dialogue: 0,0:20:13.37,0:20:17.42,Default,,0,0,0,,Сол уақытта қалған дүниені сұрыптау үшін ауқымды құбылыстар
Dialogue: 0,0:20:17.50,0:20:19.09,Default,,0,0,0,,Оны іріктеу деп атайтын сияқты.
Dialogue: 0,0:20:19.71,0:20:21.47,Default,,0,0,0,,Ертегіні тыңдау үшін
Dialogue: 0,0:20:21.97,0:20:25.14,Default,,0,0,0,,Бұл жағдай ерікті болып көрінеді.
Dialogue: 0,0:20:25.68,0:20:28.68,Default,,0,0,0,,Дүниеге әкелгеніміз емес
Dialogue: 0,0:20:29.18,0:20:33.10,Default,,0,0,0,,Мен бұл ымырт астанасынан мені мәжбүрлеген нәрсе сияқты сезінемін.
Dialogue: 0,0:20:33.89,0:20:35.60,Default,,0,0,0,,Нибельн әңгімесінде
Dialogue: 0,0:20:35.69,0:20:39.86,Default,,0,0,0,,Бұл дүниеге әкелгендей болды.
Dialogue: 0,0:20:44.03,0:20:47.45,Default,,0,0,0,,Қалай болғанда да, жою келді.
Dialogue: 0,0:20:47.95,0:20:50.33,Default,,0,0,0,,Мен бұл мәселеде сізге арқа сүйейтін боламын.
Dialogue: 0,0:20:50.41,0:20:51.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:51.79,0:20:55.58,Default,,0,0,0,,Жоюдың келуімен әлем қорғаныста болады
Dialogue: 0,0:20:56.08,0:20:59.13,Default,,0,0,0,,Кейбір қарсы шараларды ұсынады
Dialogue: 0,0:20:59.63,0:21:00.84,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:21:04.68,0:21:05.84,Default,,0,0,0,,Ол батыр.
Dialogue: 0,0:21:06.43,0:21:07.68,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:21:08.85,0:21:11.31,Default,,0,0,0,,Дұрыс, Юк Фердио.
Dialogue: 0,0:21:11.39,0:21:15.31,Default,,0,0,0,,Сіз батыр болып, бұл әлемді құтқарасыз.
Dialogue: 0,0:21:16.02,0:21:18.02,Default,,0,0,0,,♪～
Dialogue: 0,0:22:43.94,0:22:45.94,Default,,0,0,0,,～♪
Dialogue: 0,0:22:46.69,0:22:49.70,Default,,0,0,0,,Келесі жолы «Book Spirit Biblion»
Dialogue: 0,0:22:51.20,0:22:57.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
