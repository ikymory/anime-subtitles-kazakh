Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.50,0:00:04.29,Default,,0,0,0,,Енді нағыз мәміле келді.
Dialogue: 0,0:00:04.37,0:00:05.83,Default,,0,0,0,,Сіз дайынсыз ба?
Dialogue: 0,0:00:06.50,0:00:09.42,Default,,0,0,0,,Юке жақсы ма?
Dialogue: 0,0:00:10.42,0:00:12.97,Default,,0,0,0,,Біз үшін уайымдап жүрсің ғой, солай ма?
Dialogue: 0,0:00:13.05,0:00:15.43,Default,,0,0,0,,Бұл... иә
Dialogue: 0,0:00:15.93,0:00:16.68,Default,,0,0,0,,Мен, Ишикава және…
Dialogue: 0,0:00:19.68,0:00:21.18,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:00:21.27,0:00:25.10,Default,,0,0,0,,Жарайды, біздің бар екендігіміздің дәлелі бар.
Dialogue: 0,0:00:25.65,0:00:27.31,Default,,0,0,0,,Юк маған не берді
Dialogue: 0,0:00:29.57,0:00:31.61,Default,,0,0,0,,Үлкен аға, бәрібір.
Dialogue: 0,0:00:31.69,0:00:33.78,Default,,0,0,0,,Төтенше жағдайда Лун да сонда болады.
Dialogue: 0,0:00:33.86,0:00:35.49,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:00:35.57,0:00:37.53,Default,,0,0,0,,Мен саған сенемін.
Dialogue: 0,0:00:37.62,0:00:38.37,Default,,0,0,0,,Эхехе
Dialogue: 0,0:00:38.45,0:00:42.25,Default,,0,0,0,,Менің интуициям бойынша, мен бұл дұрыс деп ойлаймын.
Dialogue: 0,0:00:42.33,0:00:45.29,Default,,0,0,0,,Оны өз ішіңе қалдыру жақсы емес, Марина.
Dialogue: 0,0:00:45.37,0:00:47.04,Default,,0,0,0,,Олай болса мынаны орындайық.
Dialogue: 0,0:00:47.79,0:00:50.25,Default,,0,0,0,,Библия Болашақты болжаңыз.
Dialogue: 0,0:00:59.80,0:01:01.47,Default,,0,0,0,,Дәл ойлағанымдай
Dialogue: 0,0:01:01.56,0:01:05.94,Default,,0,0,0,,Көлеңке аңдыйтын болашақ жоқ сияқты.
Dialogue: 0,0:01:06.44,0:01:08.81,Default,,0,0,0,,Мен көремін. Рахмет, Библион.
Dialogue: 0,0:01:10.06,0:01:11.36,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:01:11.44,0:01:13.28,Default,,0,0,0,,Джейми, өтінемін
Dialogue: 0,0:01:14.90,0:01:17.49,Default,,0,0,0,,Дененің шегінен асатын қуат
Dialogue: 0,0:01:18.11,0:01:19.87,Default,,0,0,0,,Физикалық сиқырлау
Dialogue: 0,0:01:21.62,0:01:22.95,Default,,0,0,0,,Мананы жаңарту
Dialogue: 0,0:01:24.54,0:01:25.96,Default,,0,0,0,,Жақсарту аяқталды
Dialogue: 0,0:01:26.04,0:01:28.08,Default,,0,0,0,,Менің күшім артып келеді
Dialogue: 0,0:01:28.17,0:01:29.92,Default,,0,0,0,,Иә, кез келген уақытта бара аласыз.
Dialogue: 0,0:01:30.00,0:01:31.54,Default,,0,0,0,,Менің денем жеңіл!
Dialogue: 0,0:01:31.63,0:01:32.71,Default,,0,0,0,,Жарайды
Dialogue: 0,0:01:32.80,0:01:35.42,Default,,0,0,0,,Қол ұстасып, топ болып кіріңіз
Dialogue: 0,0:01:35.51,0:01:39.18,Default,,0,0,0,,Егер іші мөлдір Даркнесске айналған болса ше?
Dialogue: 0,0:01:39.26,0:01:41.30,Default,,0,0,0,,Кетсең адасып қалмайсың.
Dialogue: 0,0:01:42.76,0:01:43.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:43.85,0:01:44.60,Default,,0,0,0,,Хехе
Dialogue: 0,0:01:45.10,0:01:48.73,Default,,0,0,0,,Бұл менің тұрақты ұстанымым. Қолымды жіберме.
Dialogue: 0,0:01:48.81,0:01:49.69,Default,,0,0,0,,Әрине.
Dialogue: 0,0:01:51.15,0:01:53.57,Default,,0,0,0,,Көшбасшының орны осында.
Dialogue: 0,0:01:53.65,0:01:55.44,Default,,0,0,0,,Жасырын!
Dialogue: 0,0:01:55.53,0:01:58.03,Default,,0,0,0,,Сонда мен Жаңбырмен қосыламын деп ойлаймын.
Dialogue: 0,0:01:58.11,0:02:00.49,Default,,0,0,0,,Мен сені Маринамен байланыстырамын.
Dialogue: 0,0:02:00.57,0:02:03.03,Default,,0,0,0,,- (Джейми) Жүгір, мұнда кел - (Нибельн) Иә.
Dialogue: 0,0:02:03.12,0:02:04.83,Default,,0,0,0,,- (Камерат-кун) Келді - (Селфи-чан) Ұяшық
Dialogue: 0,0:02:39.53,0:02:41.53,Default,,0,0,0,,♪～
Dialogue: 0,0:04:06.91,0:04:08.91,Default,,0,0,0,,～♪
Dialogue: 0,0:04:19.25,0:04:20.17,Default,,0,0,0,,Хаа…
Dialogue: 0,0:04:20.25,0:04:22.92,Default,,0,0,0,,Дұрыс па? Менің болжамым дұрыс болды, солай ма?
Dialogue: 0,0:04:23.01,0:04:26.05,Default,,0,0,0,,Бұл Марина мақтанбайтын нәрсе емес.
Dialogue: 0,0:04:26.14,0:04:28.14,Default,,0,0,0,,Бірінші кезең түсінікті.
Dialogue: 0,0:04:28.22,0:04:30.81,Default,,0,0,0,,Міне, нақты нәрсе.
Dialogue: 0,0:04:31.43,0:04:33.18,Default,,0,0,0,,- (Камерат-кун) Келді - (Селфи-чан) Ұяшық
Dialogue: 0,0:04:36.44,0:04:37.65,Default,,0,0,0,,Беде
Dialogue: 0,0:04:37.73,0:04:40.94,Default,,0,0,0,,Төңкерілген лабиринт Tenebrae кірді
Dialogue: 0,0:04:41.03,0:04:42.74,Default,,0,0,0,,Стратегияны қазір бастаңыз
Dialogue: 0,0:04:43.24,0:04:45.07,Default,,0,0,0,,- (Юкс) Мұқият ләззат алыңыз - Абайлаңыз
Dialogue: 0,0:04:56.42,0:04:59.34,Default,,0,0,0,,Жаңбыр Іздеуші компасы қалай әрекет етеді?
Dialogue: 0,0:04:59.84,0:05:01.17,Default,,0,0,0,,Әлі ештеңе жоқ
Dialogue: 0,0:05:01.25,0:05:04.22,Default,,0,0,0,,Ендеше, сіз шын мәнінде Тұңғиық қақпасының қай жерде екенін білесіз бе?
Dialogue: 0,0:05:04.30,0:05:05.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:06.88,0:05:08.47,Default,,0,0,0,,Юк табылды
Dialogue: 0,0:05:08.55,0:05:11.14,Default,,0,0,0,,Жаңбыр күткендей, сен керемет жұмыс жасадың.
Dialogue: 0,0:05:11.22,0:05:13.27,Default,,0,0,0,,Иә, міне
Dialogue: 0,0:05:22.07,0:05:24.36,Default,,0,0,0,,Көз көргендей қараңғылық
Dialogue: 0,0:05:24.86,0:05:27.99,Default,,0,0,0,,Бұл Финистің түссіз қараңғылығына әкеледі, солай ма?
Dialogue: 0,0:05:28.07,0:05:32.04,Default,,0,0,0,,Дәлірек айтсақ, бұл жер де түссіз қараңғылықта болуы керек.
Dialogue: 0,0:05:32.54,0:05:36.37,Default,,0,0,0,,Бұл ерекше қысым сезімі ... бірдей нәрсе.
Dialogue: 0,0:05:36.46,0:05:39.96,Default,,0,0,0,,Баратын жерді санамызда елестетеміз
Dialogue: 0,0:05:40.04,0:05:44.76,Default,,0,0,0,,Егер қатты бағытталса, түссіз қараңғылыққа кіруге болады.
Dialogue: 0,0:05:44.84,0:05:49.68,Default,,0,0,0,,Олай болса, бұдан былай бәрі өзімізге байланысты.
Dialogue: 0,0:05:49.76,0:05:51.43,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:05:51.51,0:05:53.93,Default,,0,0,0,,Бірақ бұл әрқашан солай емес пе?
Dialogue: 0,0:05:54.02,0:05:55.77,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:05:55.85,0:05:56.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:16.50,0:06:19.12,Default,,0,0,0,,-Юк -Бұл...
Dialogue: 0,0:06:19.21,0:06:21.04,Default,,0,0,0,,Енді оны қалай көресіз?
Dialogue: 0,0:06:21.13,0:06:22.46,Default,,0,0,0,,Топографиялық
Dialogue: 0,0:06:22.54,0:06:25.92,Default,,0,0,0,,Ол Тенебра жұтқан өлім алқабына ұқсайды.
Dialogue: 0,0:06:26.01,0:06:29.68,Default,,0,0,0,,Өткеннен көзқарас? Немесе болашаққа деген көзқарас...
Dialogue: 0,0:06:30.30,0:06:32.68,Default,,0,0,0,,немесе мүмкіндіктер пейзажы
Dialogue: 0,0:06:32.76,0:06:36.10,Default,,0,0,0,,Ажал аңғары осындай болған шығар.
Dialogue: 0,0:06:36.18,0:06:39.81,Default,,0,0,0,,Түссіз қараңғылық тудырған лабиринтті адам жасаған...
Dialogue: 0,0:06:40.44,0:06:43.44,Default,,0,0,0,,Біздікі ме, әлде басқа біреу ме, білмеймін.
Dialogue: 0,0:06:43.52,0:06:45.02,Default,,0,0,0,,Біреудің қалауы немесе ойы бойынша
Dialogue: 0,0:06:45.11,0:06:47.86,Default,,0,0,0,,Шақыру ықтималдығы жоғары.
Dialogue: 0,0:06:48.69,0:06:51.32,Default,,0,0,0,,Әлде осы жердің өзі естелік пе?
Dialogue: 0,0:06:51.41,0:06:54.49,Default,,0,0,0,,Өлім алқабының бір мүмкіндігі?
Dialogue: 0,0:06:54.58,0:06:56.41,Default,,0,0,0,,Көремін, көремін.
Dialogue: 0,0:06:56.49,0:06:58.70,Default,,0,0,0,,Мен сізге алдын ала ескерту жасаймын.
Dialogue: 0,0:07:01.92,0:07:05.25,Default,,0,0,0,,Джейми мен Рейн телескопиялық көздерімен айналаны тексереді.
Dialogue: 0,0:07:05.75,0:07:06.71,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:07.30,0:07:08.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:08.92,0:07:10.05,Default,,0,0,0,,Иә
Dialogue: 0,0:07:13.93,0:07:17.22,Default,,0,0,0,,Апат деңгейіндегі зынданда флирт жасауға болады ма?
Dialogue: 0,0:07:17.31,0:07:19.68,Default,,0,0,0,,Жоқ... Мен сенімен сырласпаймын.
Dialogue: 0,0:07:19.77,0:07:21.48,Default,,0,0,0,,Бұл биіктік мәселесі.
Dialogue: 0,0:07:21.56,0:07:22.69,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:22.77,0:07:24.15,Default,,0,0,0,,Джейми мырза
Dialogue: 0,0:07:24.23,0:07:27.02,Default,,0,0,0,,Раин мен Юке мырза әрқашан солай.
Dialogue: 0,0:07:27.11,0:07:29.49,Default,,0,0,0,,-Не Берн-чан - (Нибельн) Иә, иә
Dialogue: 0,0:07:29.57,0:07:30.44,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:07:31.78,0:07:34.20,Default,,0,0,0,,Денем, құстай билей бер
Dialogue: 0,0:07:34.99,0:07:35.58,Default,,0,0,0,,Ұшу
Dialogue: 0,0:07:38.70,0:07:40.50,Default,,0,0,0,,Алыс және жақын заттар
Dialogue: 0,0:07:40.58,0:07:42.75,Default,,0,0,0,,Менің көзім, көр
Dialogue: 0,0:07:43.33,0:07:44.75,Default,,0,0,0,,Телескоптың көзі
Dialogue: 0,0:07:49.38,0:07:50.80,Default,,0,0,0,,Жау белгісі жоқ
Dialogue: 0,0:07:50.88,0:07:52.55,Default,,0,0,0,,Мен мұны да таба алмаймын.
Dialogue: 0,0:07:52.63,0:07:55.30,Default,,0,0,0,,Юке мырза, жаман жаңалық.
Dialogue: 0,0:07:55.39,0:07:58.01,Default,,0,0,0,,Корольдік ғибадатханаға ұқсайтын ғимарат ашылды.
Dialogue: 0,0:07:58.10,0:08:00.64,Default,,0,0,0,,-де айналада көлеңкелі аңдыушылар бар.
Dialogue: 0,0:08:00.73,0:08:02.31,Default,,0,0,0,,Адамдар көп
Dialogue: 0,0:08:02.39,0:08:04.48,Default,,0,0,0,,Сіз ғибадатхананы қорғайсыз ба?
Dialogue: 0,0:08:04.56,0:08:05.52,Default,,0,0,0,,Операцияны басқаратын шебер агент: Твайлайт
Dialogue: 0,0:08:05.61,0:08:08.52,Default,,0,0,0,,Менің кетуден басқа амалым жоқ. Негізгі қоршау – патша кесенесі.
Dialogue: 0,0:08:09.03,0:08:11.86,Default,,0,0,0,,Сол жерден түссіз қараңғылыққа кіру керек.
Dialogue: 0,0:08:11.94,0:08:12.74,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:12.82,0:08:15.45,Default,,0,0,0,,Алдымен жақындап, жағдайды тексерейік.
Dialogue: 0,0:08:15.53,0:08:16.03,Default,,0,0,0,,Иә
Dialogue: 0,0:08:16.12,0:08:17.45,Default,,0,0,0,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:08:18.66,0:08:20.33,Default,,0,0,0,,Марина Жақсысың ба?
Dialogue: 0,0:08:20.95,0:08:24.71,Default,,0,0,0,,Иә, менің ойымша, бәрі жақсы...
Dialogue: 0,0:08:25.21,0:08:26.54,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:08:26.63,0:08:28.38,Default,,0,0,0,,Егер сізге бірдеңе керек болса, маған хабарлаңыз.
Dialogue: 0,0:08:28.88,0:08:30.17,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:08:37.76,0:08:39.06,Default,,0,0,0,,А...
Dialogue: 0,0:08:39.14,0:08:42.02,Default,,0,0,0,,Эй, бірдеңе керек болса, маған хабарлаңыз.
Dialogue: 0,0:08:43.77,0:08:45.65,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:08:45.73,0:08:47.56,Default,,0,0,0,,Бұл аздап қорқынышты.
Dialogue: 0,0:08:47.65,0:08:49.61,Default,,0,0,0,,Мен өзімді мазасыз сезінемін.
Dialogue: 0,0:08:49.69,0:08:51.57,Default,,0,0,0,,Бұл қорқынышты болуы керек.
Dialogue: 0,0:08:51.65,0:08:52.53,Default,,0,0,0,,Мен де қорқамын
Dialogue: 0,0:08:53.03,0:08:54.65,Default,,0,0,0,,Көлеңкелік аңду
Dialogue: 0,0:08:54.74,0:08:57.57,Default,,0,0,0,,Ла-Джода сіз білетін адам болса, не істер едіңіз?
Dialogue: 0,0:08:57.66,0:08:59.66,Default,,0,0,0,,Мен бұл туралы өте қызықтымын
Dialogue: 0,0:08:59.74,0:09:01.33,Default,,0,0,0,,Марина мейірімді.
Dialogue: 0,0:09:01.41,0:09:03.37,Default,,0,0,0,,Хе-хе-хе…
Dialogue: 0,0:09:03.45,0:09:04.96,Default,,0,0,0,,Сәлем Марина
Dialogue: 0,0:09:05.04,0:09:07.88,Default,,0,0,0,,Көлеңке аңдып қалсаң
Dialogue: 0,0:09:07.96,0:09:11.05,Default,,0,0,0,,Бізге еріксіз шабуыл жасағаныңызға қалай қарайсыз?
Dialogue: 0,0:09:11.55,0:09:14.84,Default,,0,0,0,,Мен мұны қаламаймын. Мен мұны істегім келмейді.
Dialogue: 0,0:09:14.92,0:09:16.22,Default,,0,0,0,,Бұл жағдайда мен...
Dialogue: 0,0:09:16.80,0:09:17.59,Default,,0,0,0,,Иә
Dialogue: 0,0:09:18.09,0:09:20.93,Default,,0,0,0,,Содан кейін көлеңкелі аңдыушы болған адам.
Dialogue: 0,0:09:21.01,0:09:22.56,Default,,0,0,0,,Сіздің ойыңызша солай емес пе?
Dialogue: 0,0:09:22.64,0:09:23.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:24.23,0:09:25.98,Default,,0,0,0,,Иә, солай болуы мүмкін.
Dialogue: 0,0:09:27.19,0:09:29.86,Default,,0,0,0,,Кешіріңіз, Юк, қазір бәрі жақсы.
Dialogue: 0,0:09:29.94,0:09:32.36,Default,,0,0,0,,Қандай жағдай болмасын, біз бірге боламыз
Dialogue: 0,0:09:32.44,0:09:34.99,Default,,0,0,0,,Дұрыс! Ұқыпты
Dialogue: 0,0:09:35.07,0:09:36.24,Default,,0,0,0,,Жүр, кеттік.
Dialogue: 0,0:09:36.82,0:09:39.37,Default,,0,0,0,,Тоқта, мен өз бетіммен бармаймын!
Dialogue: 0,0:09:41.95,0:09:43.54,Default,,0,0,0,,- (Джейми) А... - (Юк) А?
Dialogue: 0,0:09:43.62,0:09:46.66,Default,,0,0,0,,Ақыр аяғында сен әйелқұмарсың ғой.
Dialogue: 0,0:09:46.75,0:09:47.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:50.67,0:09:53.34,Default,,0,0,0,,Алда, тоғайдың арғы жағында
Dialogue: 0,0:09:53.42,0:09:55.55,Default,,0,0,0,,Көлеңке аңдыушылар көп.
Dialogue: 0,0:09:55.63,0:09:57.26,Default,,0,0,0,,Әйтеуір ғибадатханаға баратын жолды табыңыз
Dialogue: 0,0:09:57.34,0:09:59.34,Default,,0,0,0,,Біз оны қорғауымыз керек.
Dialogue: 0,0:10:00.14,0:10:01.72,Default,,0,0,0,,Диверсия туралы не деуге болады?
Dialogue: 0,0:10:01.80,0:10:02.51,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:03.10,0:10:05.10,Default,,0,0,0,,Бұл олар үшін жұмыс істей ме...
Dialogue: 0,0:10:05.60,0:10:06.10,Default,,0,0,0,,Ах
Dialogue: 0,0:10:06.60,0:10:09.35,Default,,0,0,0,,Бұл жай ғана болжам.
Dialogue: 0,0:10:10.02,0:10:12.44,Default,,0,0,0,,Бұл құлаған Финнис туралы.
Dialogue: 0,0:10:12.52,0:10:14.15,Default,,0,0,0,,Мен қашан кеме апатқа ұшырадым?
Dialogue: 0,0:10:15.15,0:10:17.28,Default,,0,0,0,,Сіз оны еске түсіргіңіз келмейтін шығар.
Dialogue: 0,0:10:17.36,0:10:19.41,Default,,0,0,0,,Сол жерде де көлеңкелі аңдыушы болды.
Dialogue: 0,0:10:23.74,0:10:26.54,Default,,0,0,0,,Бірақ ол кезде бізге шабуыл жасалған жоқ.
Dialogue: 0,0:10:27.54,0:10:30.50,Default,,0,0,0,,Шынымен де... мұнда бірнеше жарақат алған адамдар болды.
Dialogue: 0,0:10:30.58,0:10:32.84,Default,,0,0,0,,Олар маған шабуыл жасаса, таң қалмас еді.
Dialogue: 0,0:10:32.92,0:10:34.34,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:10:34.42,0:10:35.80,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:10:35.88,0:10:38.51,Default,,0,0,0,,Сол кезде көлеңкелі аңдыушылар
Dialogue: 0,0:10:38.59,0:10:43.05,Default,,0,0,0,,Менің ойымша, бұл мен Саймонға атқан бұрмаланған жарқыраған жебеге (призмалық зымыран) әрекет етті.
Dialogue: 0,0:10:43.14,0:10:45.22,Default,,0,0,0,,Үлкен ағаның сиқыры үшін бе?
Dialogue: 0,0:10:45.31,0:10:47.43,Default,,0,0,0,,Жоқ, бұл қарғыс.
Dialogue: 0,0:10:51.10,0:10:52.44,Default,,0,0,0,,Мен жем боламын
Dialogue: 0,0:10:52.52,0:10:54.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:22.93,0:11:25.72,Default,,0,0,0,,Жарайды, біз өз орнындамыз.
Dialogue: 0,0:11:25.81,0:11:27.89,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:11:28.43,0:11:32.73,Default,,0,0,0,,Шіріген раушан гүлінің иісі Қара иттің ұлыған үні жаңғырық
Dialogue: 0,0:11:32.81,0:11:34.86,Default,,0,0,0,,Күннің батысын жұтқан теңіз
Dialogue: 0,0:11:35.44,0:11:39.11,Default,,0,0,0,,Ақ пен қара араласып, жан дүниенің құйынында жоғалады.
Dialogue: 0,0:11:41.70,0:11:43.61,Default,,0,0,0,,Шіріген раушан гүлдерінің иісі...
Dialogue: 0,0:11:45.45,0:11:47.87,Default,,0,0,0,,-Мені алды -Қазір.
Dialogue: 0,0:11:50.71,0:11:52.37,Default,,0,0,0,,Батып бара жатқан күнді жұтқан теңіз
Dialogue: 0,0:11:54.46,0:11:55.88,Default,,0,0,0,,Жан дүниенің құйынында...
Dialogue: 0,0:12:09.22,0:12:11.31,Default,,0,0,0,,Ой... жақсы өтті.
Dialogue: 0,0:12:11.39,0:12:13.60,Default,,0,0,0,,Юке мырза, жақсысыз ба?
Dialogue: 0,0:12:14.10,0:12:17.23,Default,,0,0,0,,Әй, олар мені елестетіп жатыр.
Dialogue: 0,0:12:17.73,0:12:20.03,Default,,0,0,0,,Диверсия Бұл сәтті болды.
Dialogue: 0,0:12:20.11,0:12:21.82,Default,,0,0,0,,- (Юк) Тозу ше? -Жоқ
Dialogue: 0,0:12:22.45,0:12:23.53,Default,,0,0,0,,Бұл да
Dialogue: 0,0:12:31.25,0:12:33.12,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:12:33.21,0:12:37.21,Default,,0,0,0,,Джемми Жібек Мана мен рухтардың ағынын бақылаңыз.
Dialogue: 0,0:12:37.29,0:12:39.50,Default,,0,0,0,,- (Джейми) Маған қалдырыңыз - түсінемін.
Dialogue: 0,0:12:39.59,0:12:41.67,Default,,0,0,0,,Маринарунды жақсы қорғаңыз.
Dialogue: 0,0:12:41.76,0:12:43.13,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:43.22,0:12:45.13,Default,,0,0,0,,Рун-чан, мені тастамашы.
Dialogue: 0,0:12:45.22,0:12:47.05,Default,,0,0,0,,Иә, Марина-Нечан.
Dialogue: 0,0:12:53.18,0:12:54.64,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:12:56.19,0:12:58.48,Default,,0,0,0,,- Міне - Түсіндім.
Dialogue: 0,0:12:58.56,0:13:01.28,Default,,0,0,0,,үшінмыз, бұдан да қаттырақ болайық
Dialogue: 0,0:13:01.36,0:13:03.15,Default,,0,0,0,,Сіз не болатынын ешқашан білмейсіз.
Dialogue: 0,0:13:05.20,0:13:06.20,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:13:06.28,0:13:07.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:07.53,0:13:10.53,Default,,0,0,0,,Юке мырза, бұл тым қиындап барады.
Dialogue: 0,0:13:10.62,0:13:11.79,Default,,0,0,0,,(Жан) Эй, Джотаро, сол Какёин жігіт туралы не ойлайсың?
Dialogue: 0,0:13:12.37,0:13:16.42,Default,,0,0,0,,Клевердің арманы Мен тағы да аңсаған сахнада тұрмын.
Dialogue: 0,0:13:16.92,0:13:18.42,Default,,0,0,0,,Кәдімгі, өтінемін.
Dialogue: 0,0:13:19.25,0:13:20.50,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:13:21.00,0:13:23.42,Default,,0,0,0,,Тарату да байланысты.
Dialogue: 0,0:13:25.47,0:13:28.80,Default,,0,0,0,,Армандарымызды абайлап ләззат алайық!
Dialogue: 0,0:13:28.89,0:13:29.64,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:13:29.72,0:13:31.06,Default,,0,0,0,,- Иә! -Иә!
Dialogue: 0,0:13:33.14,0:13:35.31,Default,,0,0,0,,Зұлымдарды өрте
Dialogue: 0,0:13:35.39,0:13:38.15,Default,,0,0,0,,Төртінші деңгейлі сиқырлы от добы!
Dialogue: 0,0:13:44.28,0:13:47.40,Default,,0,0,0,,Жарқылдаңыз, қуат болтынан атыңыз!
Dialogue: 0,0:13:49.28,0:13:50.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:51.53,0:13:52.58,Default,,0,0,0,,Мен оны өлтірдім!
Dialogue: 0,0:13:57.29,0:13:58.46,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:58.54,0:14:00.04,Default,,0,0,0,,Жоқ, әлі жоқ...
Dialogue: 0,0:14:01.79,0:14:05.21,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:14:13.47,0:14:14.39,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:14:16.81,0:14:18.06,Default,,0,0,0,,Лафума!
Dialogue: 0,0:14:19.73,0:14:22.65,Default,,0,0,0,,Тоқта, өтейік.
Dialogue: 0,0:14:25.73,0:14:26.53,Default,,0,0,0,,Әлі емес.
Dialogue: 0,0:14:27.03,0:14:30.11,Default,,0,0,0,,Кешіріңіз, егер сіз кедергі келтіргіңіз келсе, мен сізді алып тастаймын.
Dialogue: 0,0:14:31.53,0:14:33.03,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:33.12,0:14:34.49,Default,,0,0,0,,Маринаның соққысы
Dialogue: 0,0:14:34.58,0:14:35.49,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:35.58,0:14:37.25,Default,,0,0,0,,-Ей! -(Лахума) Го...
Dialogue: 0,0:14:43.21,0:14:43.88,Default,,0,0,0,,Қазір
Dialogue: 0,0:14:43.96,0:14:44.84,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:45.55,0:14:46.34,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:46.42,0:14:48.09,Default,,0,0,0,,Сиқырлы қылыштың өзгеруі!
Dialogue: 0,0:14:48.17,0:14:49.72,Default,,0,0,0,,Ахх!
Dialogue: 0,0:15:03.06,0:15:07.11,Default,,0,0,0,,Енді алда не күтіп тұр?
Dialogue: 0,0:15:07.19,0:15:09.95,Default,,0,0,0,,Мұнда өлшемдік шекара бар, солай ма?
Dialogue: 0,0:15:10.03,0:15:11.36,Default,,0,0,0,,Өлшемдік шекаралар?
Dialogue: 0,0:15:11.45,0:15:15.12,Default,,0,0,0,,Ал, зындан жағында белгілер анық болды.
Dialogue: 0,0:15:15.20,0:15:18.70,Default,,0,0,0,,Баспалдақ жағы біршама анық емес.
Dialogue: 0,0:15:18.79,0:15:21.12,Default,,0,0,0,,Ережелер басқаша екеніне сенімдімін.
Dialogue: 0,0:15:21.21,0:15:23.17,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:15:23.25,0:15:26.30,Default,,0,0,0,,Құбыжықтар баспалдақпен кіре алмайды.
Dialogue: 0,0:15:26.38,0:15:28.01,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:15:29.30,0:15:32.97,Default,,0,0,0,,Алтын әулие қыз күткендей, бұл біз түсінбейтін сезім.
Dialogue: 0,0:15:33.47,0:15:36.31,Default,,0,0,0,,Егер бірдеңе байқасаңыз, маған хабарлаңыз.
Dialogue: 0,0:15:36.39,0:15:37.56,Default,,0,0,0,,Иә
Dialogue: 0,0:15:37.64,0:15:38.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:47.52,0:15:48.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:49.65,0:15:53.53,Default,,0,0,0,,Бұл... Финнис бар, солай ма?
Dialogue: 0,0:15:53.61,0:15:56.16,Default,,0,0,0,,Жоқ, бұл зынданның ішінде.
Dialogue: 0,0:15:56.66,0:15:59.79,Default,,0,0,0,,Біреудің ойы... есте сақтаудың қалдығы?
Dialogue: 0,0:16:00.29,0:16:01.25,Default,,0,0,0,,Юк мырза
Dialogue: 0,0:16:01.33,0:16:04.38,Default,,0,0,0,,Біз жақсы орындаған шығармыз.
Dialogue: 0,0:16:04.88,0:16:08.67,Default,,0,0,0,,Мен патша ғибадатханасынан Финиске дейін иерархияны кесіп өттім.
Dialogue: 0,0:16:08.75,0:16:09.88,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:09.96,0:16:12.30,Default,,0,0,0,,- (Қонақтар) Сәттілік! -(Юк) А...
Dialogue: 0,0:16:14.76,0:16:17.76,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:16:23.60,0:16:26.56,Default,,0,0,0,,Хм... Сіз қалай ойлайсыз? Жүгіру
Dialogue: 0,0:16:26.65,0:16:29.65,Default,,0,0,0,,Білмеймін, бірақ бұл белгі...
Dialogue: 0,0:16:30.15,0:16:33.45,Default,,0,0,0,,Менің ойымша, бұл адамдар көлеңкелі аң аулаушылар.
Dialogue: 0,0:16:33.53,0:16:35.70,Default,,0,0,0,,Сиқырлы анықтау арқылы расталады
Dialogue: 0,0:16:35.78,0:16:36.78,Default,,0,0,0,,Күмән жоқ
Dialogue: 0,0:16:37.37,0:16:38.53,Default,,0,0,0,,Және…
Dialogue: 0,0:16:40.87,0:16:43.25,Default,,0,0,0,,Біздің баратын жеріміз сол жақта
Dialogue: 0,0:16:43.75,0:16:44.79,Default,,0,0,0,,Бірінші қабат арқылы
Dialogue: 0,0:16:44.87,0:16:48.04,Default,,0,0,0,,Бұл біз шығуға бет алуымыз керек дегенді білдіреді.
Dialogue: 0,0:16:48.13,0:16:49.04,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:49.63,0:16:51.71,Default,,0,0,0,,Юк Ху...
Dialogue: 0,0:16:53.01,0:16:53.80,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:53.88,0:16:56.47,Default,,0,0,0,,(Симонның күлкісі)
Dialogue: 0,0:16:57.18,0:16:59.26,Default,,0,0,0,,Бұл біз бе?
Dialogue: 0,0:17:00.47,0:17:02.35,Default,,0,0,0,,Өте қызық...
Dialogue: 0,0:17:03.27,0:17:05.56,Default,,0,0,0,,Мүмкін емес, бірақ...
Dialogue: 0,0:17:06.23,0:17:08.56,Default,,0,0,0,,Бұл мен бір кездері армандаған көрініс.
Dialogue: 0,0:17:09.06,0:17:12.44,Default,,0,0,0,,Менің ойымша, бұл мүмкіндіктердің бірі.
Dialogue: 0,0:17:20.08,0:17:21.37,Default,,0,0,0,,Бұл жерден кетейік
Dialogue: 0,0:17:21.45,0:17:22.45,Default,,0,0,0,,Операцияны басқаратын шебер агент: Твайлайт
Dialogue: 0,0:17:23.25,0:17:26.46,Default,,0,0,0,,Егер бұл Финис тавернасының демалысы болса.
Dialogue: 0,0:17:26.54,0:17:28.13,Default,,0,0,0,,Олар шабуыл жасамайды
Dialogue: 0,0:17:29.21,0:17:30.54,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:17:30.63,0:17:34.05,Default,,0,0,0,,Қару мен сиқырды барлар мен ұрыста қолдану
Dialogue: 0,0:17:34.13,0:17:36.47,Default,,0,0,0,,Заңмен қатаң тыйым салынған
Dialogue: 0,0:17:36.55,0:17:41.22,Default,,0,0,0,,Олар да сол заңға бағынады деп сенейік.
Dialogue: 0,0:17:42.35,0:17:46.48,Default,,0,0,0,,Кәне бәріміз бөлініп, назар аудармай шығуға бет алайық.
Dialogue: 0,0:17:46.98,0:17:48.48,Default,,0,0,0,,Ешқашан жүгірмеңіз
Dialogue: 0,0:17:48.98,0:17:50.73,Default,,0,0,0,,Кездейсоқ және лайықты түрде
Dialogue: 0,0:17:50.81,0:17:52.27,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:17:52.36,0:17:53.69,Default,,0,0,0,,Жасырын
Dialogue: 0,0:17:54.65,0:17:55.86,Default,,0,0,0,,- (Камерат-кун) Келді - (Селфи-чан) Ұяшық
Dialogue: 0,0:17:56.61,0:17:58.32,Default,,0,0,0,,Менімен жүгіру барады.
Dialogue: 0,0:17:58.41,0:17:59.11,Default,,0,0,0,,Иә
Dialogue: 0,0:18:00.91,0:18:01.87,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:24.31,0:18:25.22,Default,,0,0,0,,Хаа…
Dialogue: 0,0:18:26.23,0:18:27.35,Default,,0,0,0,,Бүгінгі жағдай бойынша
Dialogue: 0,0:18:27.43,0:18:30.10,Default,,0,0,0,,Мен бұл найзағай шортанның қашып кетуіне жол беремін!
Dialogue: 0,0:18:32.65,0:18:33.73,Default,,0,0,0,,Не?
Dialogue: 0,0:18:33.82,0:18:35.53,Default,,0,0,0,,(Симонның күлкісі)
Dialogue: 0,0:18:36.11,0:18:39.03,Default,,0,0,0,,Бұл әзіл болса керек, пайдасы жоқ.
Dialogue: 0,0:18:39.53,0:18:43.03,Default,,0,0,0,,Тек сенің арқаңда мен бар күшіммен күресе аламын.
Dialogue: 0,0:18:43.12,0:18:46.70,Default,,0,0,0,,Дұрыс. Мананы қалпына келтіруге қолдау көрсету.
Dialogue: 0,0:18:46.79,0:18:48.87,Default,,0,0,0,,Бұл маған шынымен көмектесті.
Dialogue: 0,0:18:48.96,0:18:49.79,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:18:49.87,0:18:53.04,Default,,0,0,0,,Сен болмасаң бәріміз тез арада жойылып кетер едік.
Dialogue: 0,0:18:53.13,0:18:55.13,Default,,0,0,0,,Сәлем, Джейми
Dialogue: 0,0:18:55.21,0:19:00.30,Default,,0,0,0,,Жоқ, егер Юке болмаса, біз бүгінгідей болмайтынымыз рас.
Dialogue: 0,0:19:00.38,0:19:01.89,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:19:01.97,0:19:05.26,Default,,0,0,0,,Эй, Юк, көбірек іш!
Dialogue: 0,0:19:05.35,0:19:06.39,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:11.77,0:19:13.56,Default,,0,0,0,,Иә? Сен сонда
Dialogue: 0,0:19:29.25,0:19:30.37,Default,,0,0,0,,Біз жас бәсекелестер ақыл-парасатымыз таусылып, әбден таңырқап қаламыз, солай ма~?
Dialogue: 0,0:19:30.46,0:19:34.79,Default,,0,0,0,,Костюм қызыл сиқырлы артефактілердің шедеврі ретінде қарастырылды.
Dialogue: 0,0:19:35.29,0:19:37.67,Default,,0,0,0,,Оны қайдан алғаныңызды айта аласыз ба?
Dialogue: 0,0:19:37.75,0:19:40.88,Default,,0,0,0,,Саймон олжаның қайдан келетінін сұрау
Dialogue: 0,0:19:40.97,0:19:42.18,Default,,0,0,0,,Бұл әдепті бұзу.
Dialogue: 0,0:19:42.26,0:19:44.47,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:19:44.97,0:19:46.05,Default,,0,0,0,,Юкке...
Dialogue: 0,0:19:46.56,0:19:49.77,Default,,0,0,0,,Мен бұл қызыл сиқыршыма жарасады деп ойладым, сондықтан мен
Dialogue: 0,0:19:50.43,0:19:51.69,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:19:52.48,0:19:55.77,Default,,0,0,0,,Жоқ, жақсы, ол үшін уайымдама.
Dialogue: 0,0:19:56.27,0:19:58.90,Default,,0,0,0,,Бұл Aurias Royal Castle Ruins зынданы.
Dialogue: 0,0:19:58.98,0:20:01.40,Default,,0,0,0,,Мен оны 10-қабатта алдым.
Dialogue: 0,0:20:01.49,0:20:03.61,Default,,0,0,0,,Әй, бұл дұрыс емес пе?
Dialogue: 0,0:20:03.70,0:20:06.66,Default,,0,0,0,,Иә, оны келесі стратегияда алуға болады.
Dialogue: 0,0:20:06.74,0:20:09.24,Default,,0,0,0,,Пайдалы ақпарат үшін рахмет
Dialogue: 0,0:20:09.75,0:20:10.62,Default,,0,0,0,,осы портта бір жерде жасырынып, бізді бақылап отыр.
Dialogue: 0,0:20:10.70,0:20:13.87,Default,,0,0,0,,Көшеде «жауынгер» ретінде белгілі
Dialogue: 0,0:20:13.96,0:20:15.25,Default,,0,0,0,,Мен Саймонмын
Dialogue: 0,0:20:15.75,0:20:19.38,Default,,0,0,0,,Ол әлі бастаушы, бірақ ол бір күні А дәрежесіне айналатын адам.
Dialogue: 0,0:20:19.46,0:20:21.76,Default,,0,0,0,,Бұл тағы да хахаха!
Dialogue: 0,0:20:21.84,0:20:23.88,Default,,0,0,0,,Саймонның бар болғаны осы
Dialogue: 0,0:20:23.97,0:20:25.51,Default,,0,0,0,,Бірақ мен оны жек көрмеймін.
Dialogue: 0,0:20:25.59,0:20:29.26,Default,,0,0,0,,Бірақ біз тіпті ұятқа қалдық, солай емес пе?
Dialogue: 0,0:20:29.35,0:20:31.52,Default,,0,0,0,,Көп күлме
Dialogue: 0,0:20:31.60,0:20:33.98,Default,,0,0,0,,Юкемен бірге Тұңғиық қақпасына бару
Dialogue: 0,0:20:34.06,0:20:36.27,Default,,0,0,0,,Сіз А дәрежелі болуыңыз керек.
Dialogue: 0,0:20:36.86,0:20:38.48,Default,,0,0,0,,Біз мұны істей аламыз.
Dialogue: 0,0:20:39.15,0:20:39.65,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:20:39.73,0:20:40.86,Default,,0,0,0,,О
Dialogue: 0,0:20:43.61,0:20:46.66,Default,,0,0,0,,Мен Тұңғиық қақпасына бара аламын деп үміттенемін
Dialogue: 0,0:20:47.16,0:20:51.08,Default,,0,0,0,,Юкдікі... Жоқ, бұл біздің арманымыз.
Dialogue: 0,0:20:51.58,0:20:53.41,Default,,0,0,0,,Мен міндетті түрде барып көремін.
Dialogue: 0,0:20:55.37,0:20:57.71,Default,,0,0,0,,Кездескенше, Саймон
Dialogue: 0,0:20:57.79,0:20:59.67,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:20:59.75,0:21:02.30,Default,,0,0,0,,Қайта кездескенше, Батыр!
Dialogue: 0,0:21:02.38,0:21:03.92,Default,,0,0,0,,(Симонның күлкісі)
Dialogue: 0,0:21:04.01,0:21:05.80,Default,,0,0,0,,- Сынақшы да - (Джейми) Дұрыс па?
Dialogue: 0,0:21:05.88,0:21:07.97,Default,,0,0,0,,-Ол жақсы жігіт еді. -Иә.
Dialogue: 0,0:21:08.47,0:21:11.06,Default,,0,0,0,,-Мен сені тағы көремін деп үміттенемін - (Джейми) Мен сені тағы көремін деп үміттенемін.
Dialogue: 0,0:21:11.14,0:21:12.81,Default,,0,0,0,,Жарайды, біз де бар күшімізді саламыз.
Dialogue: 0,0:21:12.89,0:21:14.18,Default,,0,0,0,,Мен Учидамын.
Dialogue: 0,0:21:16.48,0:21:18.48,Default,,0,0,0,,♪～
Dialogue: 0,0:22:43.48,0:22:45.48,Default,,0,0,0,,～♪
Dialogue: 0,0:22:46.78,0:22:49.11,Default,,0,0,0,,Келесі жолы «Қараңғылықтың соңы»
Dialogue: 0,0:22:50.61,0:22:56.61,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
