Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.25,0:00:02.87,Default,,0,0,0,,Юк Фердио
Dialogue: 0,0:00:03.37,0:00:07.38,Default,,0,0,0,,Ымырт патшасын тоқтатыңыз және алтынды жойыңыз
Dialogue: 0,0:00:07.88,0:00:13.51,Default,,0,0,0,,Әйтпесе, бұл дүние де ымыртта жұтылады.
Dialogue: 0,0:00:14.26,0:00:16.30,Default,,0,0,0,,Дұрыс, Юк Фердио.
Dialogue: 0,0:00:16.80,0:00:20.52,Default,,0,0,0,,Сіз батыр болып, бұл әлемді құтқарасыз.
Dialogue: 0,0:00:21.52,0:00:23.52,Default,,0,0,0,,♪～
Dialogue: 0,0:01:48.94,0:01:50.94,Default,,0,0,0,,～♪
Dialogue: 0,0:01:51.56,0:01:53.07,Default,,0,0,0,,Ол батыр...
Dialogue: 0,0:01:53.15,0:01:54.57,Default,,0,0,0,,(Сатушы) Жарайды, онда мен сата алатын зат та осы ғана болар.
Dialogue: 0,0:01:54.65,0:01:56.99,Default,,0,0,0,,Біреу жасамаса жұмыс істемейді.
Dialogue: 0,0:01:57.49,0:01:59.95,Default,,0,0,0,,Және бұл жай ғана біреу дегенді білдірмейді.
Dialogue: 0,0:02:00.03,0:02:01.41,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:02:01.49,0:02:03.28,Default,,0,0,0,,Олай етпеймін десең
Dialogue: 0,0:02:03.37,0:02:05.75,Default,,0,0,0,,Кловерден А дәрежесіне біреуді шақырыңыз.
Dialogue: 0,0:02:05.83,0:02:07.29,Default,,0,0,0,,Сізден сұралады
Dialogue: 0,0:02:07.79,0:02:10.00,Default,,0,0,0,,Сіз аздап ынталы сезінесіз бе?
Dialogue: 0,0:02:10.08,0:02:13.13,Default,,0,0,0,,Хмм... Жас кезінде Сағаға ұқсайды.
Dialogue: 0,0:02:13.21,0:02:16.34,Default,,0,0,0,,Онымен салыстырғанда, сіз тым сыпайы екенсіз.
Dialogue: 0,0:02:16.97,0:02:18.72,Default,,0,0,0,,Сіз өз ағаңызды білесіз бе?
Dialogue: 0,0:02:19.93,0:02:21.55,Default,,0,0,0,,Ескі дос
Dialogue: 0,0:02:21.64,0:02:23.89,Default,,0,0,0,,Түйсік пен сенімділікке толы адам.
Dialogue: 0,0:02:23.97,0:02:28.73,Default,,0,0,0,,Ол мұны дәлелдеуге жеткілікті қабілеті бар жақсы авантюрист болды.
Dialogue: 0,0:02:29.31,0:02:32.44,Default,,0,0,0,,Шынымды айтсам, мені қабылдасаңыз, риза болар едім.
Dialogue: 0,0:02:32.94,0:02:34.61,Default,,0,0,0,,Мүмкіндігінше көбірек қолдау көрсетіңіз
Dialogue: 0,0:02:34.69,0:02:37.24,Default,,0,0,0,,Менен көп нәрсе күтесің бе?
Dialogue: 0,0:02:37.32,0:02:38.90,Default,,0,0,0,,Түйсік
Dialogue: 0,0:02:39.49,0:02:42.74,Default,,0,0,0,,Сонымен қатар, сізді басқа дүниеден келген елші ұсынуды сұрады.
Dialogue: 0,0:02:43.41,0:02:45.99,Default,,0,0,0,,А... бір сәт ойланып көрейін.
Dialogue: 0,0:02:46.08,0:02:50.04,Default,,0,0,0,,Иә, бірақ неғұрлым тез жауап берсе, соғұрлым жақсы.
Dialogue: 0,0:02:50.12,0:02:51.17,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,0:02:51.67,0:02:53.25,Default,,0,0,0,,Әріптестермен кеңесу
Dialogue: 0,0:02:53.96,0:02:56.63,Default,,0,0,0,,Егер менің болжамым дұрыс болса.
Dialogue: 0,0:02:56.71,0:02:59.42,Default,,0,0,0,,Сіздің күмәніңіз жақында жойылады.
Dialogue: 0,0:02:59.51,0:03:02.84,Default,,0,0,0,,Сонымен қатар, сіз ғана жасай алатын нәрселер бар.
Dialogue: 0,0:03:08.10,0:03:10.39,Default,,0,0,0,,Батыр... ғажап
Dialogue: 0,0:03:10.48,0:03:12.98,Default,,0,0,0,,Бұл мен үшін ауыр жүк
Dialogue: 0,0:03:13.48,0:03:16.02,Default,,0,0,0,,Егер сізге қиын болса, жоқ деп айтыңыз.
Dialogue: 0,0:03:17.53,0:03:21.03,Default,,0,0,0,,Егер мен мұны істесем, маған Кловердегі біреу мені мұны істеуге мәжбүрлейді деп айтты.
Dialogue: 0,0:03:21.11,0:03:24.28,Default,,0,0,0,,Мүмкін Маринаға? Мен қиындыққа тап болдым
Dialogue: 0,0:03:25.16,0:03:26.95,Default,,0,0,0,,Сол ымырт қала...
Dialogue: 0,0:03:27.04,0:03:30.75,Default,,0,0,0,,Мен Қуаныштымын-ді шақыруға қарсы емеспін.
Dialogue: 0,0:03:30.83,0:03:35.75,Default,,0,0,0,,Әлемді дағдарыстан құтқару тым көп.
Dialogue: 0,0:03:35.84,0:03:36.71,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:36.79,0:03:40.55,Default,,0,0,0,,Бірақ сол кезде Лун Юктың атын атады.
Dialogue: 0,0:03:40.63,0:03:42.80,Default,,0,0,0,,Мағыналы екеніне сенімдімін.
Dialogue: 0,0:03:42.88,0:03:43.43,Default,,0,0,0,,Мағынасы?
Dialogue: 0,0:03:43.51,0:03:44.51,Default,,0,0,0,,Иә
Dialogue: 0,0:03:44.59,0:03:49.06,Default,,0,0,0,,Мұны тек Юк жасай алады. Бұл тек Юк сұрай алатын нәрсе.
Dialogue: 0,0:03:49.14,0:03:50.56,Default,,0,0,0,,Мен Юкті күттім.
Dialogue: 0,0:03:51.14,0:03:53.06,Default,,0,0,0,,Мұны мен ғана істей аламын...
Dialogue: 0,0:03:53.56,0:03:54.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:54.73,0:03:58.78,Default,,0,0,0,,Менің ойымша, Юке әдеттегідей авантюрист ретіндегі жұмысын орындауы керек.
Dialogue: 0,0:03:59.28,0:04:00.11,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:00.61,0:04:03.32,Default,,0,0,0,,Дүниенің дағдарысы ма, батырдың дағдарысы ма
Dialogue: 0,0:04:03.40,0:04:06.57,Default,,0,0,0,,Ақырында, біз не істейміз әдеттегідей?
Dialogue: 0,0:04:07.12,0:04:09.37,Default,,0,0,0,,Рахмет, мен өзімді жеңіл сезінемін.
Dialogue: 0,0:04:09.45,0:04:11.00,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:04:11.08,0:04:12.25,Default,,0,0,0,,О...
Dialogue: 0,0:04:13.29,0:04:16.83,Default,,0,0,0,,Ештеңе емес, не болса да, мен Юктың жағында боламын.
Dialogue: 0,0:04:17.42,0:04:20.84,Default,,0,0,0,,Дүние жойылса да, Ешкім қалмаса да
Dialogue: 0,0:04:20.92,0:04:22.92,Default,,0,0,0,,Өйткені біз әрқашан соңына дейін бірге боламыз
Dialogue: 0,0:04:24.93,0:04:26.18,Default,,0,0,0,,-Хехехе -(юк) А?
Dialogue: 0,0:04:26.76,0:04:27.80,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:27.89,0:04:30.97,Default,,0,0,0,,Саған жабысатын жалғыз уақыт - мен уайымдаған кезде.
Dialogue: 0,0:04:31.06,0:04:32.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:32.18,0:04:34.48,Default,,0,0,0,,Көрінбейтін немесе қашатын нәрсе
Dialogue: 0,0:04:35.65,0:04:37.23,Default,,0,0,0,,Бұл сізді алаңдатты ма?
Dialogue: 0,0:04:37.31,0:04:40.48,Default,,0,0,0,,Жарайды, мен сенімен дұрыс кеңестім.
Dialogue: 0,0:04:40.57,0:04:43.03,Default,,0,0,0,,Және мен бәрінің бірдей екеніне сенімдімін.
Dialogue: 0,0:04:43.11,0:04:46.24,Default,,0,0,0,,Біз Юк ойлағаннан да күштіміз.
Dialogue: 0,0:04:47.03,0:04:48.37,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:04:48.45,0:04:50.99,Default,,0,0,0,,Сонда да мен уайымдап жүрмін.
Dialogue: 0,0:04:51.66,0:04:55.25,Default,,0,0,0,,Сондықтан бізге Юк ұнайды.
Dialogue: 0,0:05:02.46,0:05:04.34,Default,,0,0,0,,Жоғарыда жаңадан шығарылды.
Dialogue: 0,0:05:04.42,0:05:06.63,Default,,0,0,0,,Бірлескен миссияның жоспары
Dialogue: 0,0:05:06.72,0:05:10.35,Default,,0,0,0,,Скордия толық бонд карминдік беде
Dialogue: 0,0:05:10.43,0:05:11.64,Default,,0,0,0,,Төрт тарап
Dialogue: 0,0:05:11.72,0:05:14.27,Default,,0,0,0,,Glad She-Im пломбалау талаптарын орындайды
Dialogue: 0,0:05:14.35,0:05:16.56,Default,,0,0,0,,Осы қиын жағдайдан өтуіңізді қалаймын.
Dialogue: 0,0:05:16.64,0:05:19.48,Default,,0,0,0,,Стратегияның таратылатынын ескеріңіз.
Dialogue: 0,0:05:19.56,0:05:21.32,Default,,0,0,0,,Көру шектеулерін орнату
Dialogue: 0,0:05:21.40,0:05:22.78,Default,,0,0,0,,Атап айтқанда
Dialogue: 0,0:05:22.86,0:05:27.45,Default,,0,0,0,,Оны тек академиялық авантюристер гильдиясының шектеулі саны ғана көре алады.
Dialogue: 0,0:05:27.53,0:05:29.95,Default,,0,0,0,,Сол ымыртта есінен танғандар
Dialogue: 0,0:05:30.03,0:05:33.58,Default,,0,0,0,,Егер ол бұдан да жоғарыласа, оны басқару мүмкін емес болады.
Dialogue: 0,0:05:33.66,0:05:35.62,Default,,0,0,0,,Сұрақтарыңыз бар ма?
Dialogue: 0,0:05:36.54,0:05:37.71,Default,,0,0,0,,Закарт мырза
Dialogue: 0,0:05:38.88,0:05:40.50,Default,,0,0,0,,Неліктен С дәрежелі беде бар?
Dialogue: 0,0:05:40.59,0:05:42.50,Default,,0,0,0,,Сіз стратегияны жалғастырып жатырсыз ба?
Dialogue: 0,0:05:42.59,0:05:45.05,Default,,0,0,0,,Олар ең қиын лабиринт.
Dialogue: 0,0:05:45.13,0:05:47.38,Default,,0,0,0,,Түссіз қараңғылықты зерттеу тәжірибесі бар.
Dialogue: 0,0:05:47.88,0:05:50.35,Default,,0,0,0,,Бұл сауалнама да нәтижеге қол жеткізді.
Dialogue: 0,0:05:50.43,0:05:53.64,Default,,0,0,0,,Миссия кезінде ол уақытша А дәрежесі ретінде қарастырылады.
Dialogue: 0,0:05:53.72,0:05:56.35,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:05:56.43,0:06:00.40,Default,,0,0,0,,Түссіз қараңғылық болса да, мен бірнеше қабат төмен түстім, солай ма?
Dialogue: 0,0:06:00.48,0:06:03.36,Default,,0,0,0,,Жалқау болсам да соны аламын.
Dialogue: 0,0:06:03.44,0:06:06.15,Default,,0,0,0,,Мен мұнымен келіспеймін.
Dialogue: 0,0:06:06.24,0:06:07.28,Default,,0,0,0,,Толық шек
Dialogue: 0,0:06:07.36,0:06:10.70,Default,,0,0,0,,Мен сенің зындандарды бағындыруды қаншалықты білетініңді білмеймін.
Dialogue: 0,0:06:11.20,0:06:15.41,Default,,0,0,0,,Түссіз қараңғылыққа осындай оймен қарсы тұрсаң, пәле болады.
Dialogue: 0,0:06:15.50,0:06:16.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:16.62,0:06:19.83,Default,,0,0,0,,Біз сол қызыл сиқыршылардан төменміз дейсіз бе?
Dialogue: 0,0:06:19.92,0:06:21.71,Default,,0,0,0,,Сол аймақта, Йошинахара
Dialogue: 0,0:06:22.29,0:06:23.75,Default,,0,0,0,,Atera қиындықтарды бірге көтереді -
Dialogue: 0,0:06:23.84,0:06:25.46,Default,,0,0,0,,Альянс?
Dialogue: 0,0:06:25.55,0:06:29.26,Default,,0,0,0,,Негізі, беде өсімдіктерінің ұзақтығы бір тәулік.
Dialogue: 0,0:06:29.34,0:06:32.30,Default,,0,0,0,,Сізге оңайырақ болады деп ойласаңыз, жақсы.
Dialogue: 0,0:06:32.80,0:06:35.06,Default,,0,0,0,,Нәтижені жұмыста көрсетуге болады.
Dialogue: 0,0:06:35.14,0:06:35.81,Default,,0,0,0,,Жасайық?
Dialogue: 0,0:06:35.89,0:06:38.48,Default,,0,0,0,,Хмф! Мен сенің не айтып тұрғаныңды білемін
Dialogue: 0,0:06:39.19,0:06:39.77,Default,,0,0,0,,Чи…
Dialogue: 0,0:06:41.19,0:06:43.77,Default,,0,0,0,,Хахаха! жас жас
Dialogue: 0,0:06:43.86,0:06:46.61,Default,,0,0,0,,Жарайды, жоқтан гөрі, жауынгерлік рухтың болғаны жақсы.
Dialogue: 0,0:06:46.69,0:06:50.11,Default,,0,0,0,,Мен өзімді атмосфераны бұзғандай сезінемін. Кешіріңіз.
Dialogue: 0,0:06:50.20,0:06:53.16,Default,,0,0,0,,Мен саған сенемін, Люсент.
Dialogue: 0,0:06:53.66,0:06:56.66,Default,,0,0,0,,Түссіз қараңғылыққа қарсы шығып, қайтқандар
Dialogue: 0,0:06:56.74,0:06:58.16,Default,,0,0,0,,Онша көп емес.
Dialogue: 0,0:06:58.25,0:07:00.67,Default,,0,0,0,,Мен бар күшімді саламын.
Dialogue: 0,0:07:00.75,0:07:02.58,Default,,0,0,0,,Хона зындандағы
Dialogue: 0,0:07:07.30,0:07:09.38,Default,,0,0,0,,Батырдың ісі сен қалағандай.
Dialogue: 0,0:07:09.47,0:07:12.05,Default,,0,0,0,,Оны басқа тараптардан жасыру жақсы идея болды.
Dialogue: 0,0:07:12.68,0:07:13.85,Default,,0,0,0,,Егер Закарт білсе
Dialogue: 0,0:07:13.93,0:07:16.31,Default,,0,0,0,,Бұл қиынырақ болар еді.
Dialogue: 0,0:07:16.39,0:07:16.93,Default,,0,0,0,,Иә
Dialogue: 0,0:07:17.52,0:07:20.69,Default,,0,0,0,,Олай болса, Рейн-кун сұраған жабдық
Dialogue: 0,0:07:20.77,0:07:23.73,Default,,0,0,0,,Жақында аяқталатыны туралы хабарлама алдық.
Dialogue: 0,0:07:23.81,0:07:25.31,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:25.40,0:07:27.15,Default,,0,0,0,,баруға болады ма?
Dialogue: 0,0:07:27.23,0:07:28.82,Default,,0,0,0,,Қолымнан келгенін істеймін.
Dialogue: 0,0:07:29.40,0:07:33.95,Default,,0,0,0,,Мен жақсы жаңалық күтемін, Батыр Юк Фердио.
Dialogue: 0,0:07:36.83,0:07:38.91,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:07:39.00,0:07:41.66,Default,,0,0,0,,Басқа тараптар туралы ақпаратты жинасаңыз да
Dialogue: 0,0:07:41.75,0:07:43.92,Default,,0,0,0,,Өйткені, Водан қамалына кіру жолы
Dialogue: 0,0:07:44.00,0:07:45.08,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:07:46.09,0:07:49.09,Default,,0,0,0,,Менің ойымша, сізге көмектесу үшін жүгіруден сұраған дұрыс болар еді.
Dialogue: 0,0:07:50.13,0:07:51.09,Default,,0,0,0,,Жүгіру керек пе?
Dialogue: 0,0:07:51.17,0:07:54.84,Default,,0,0,0,,Менің ойымша, Лун Глад Ше-Иммен байланысты.
Dialogue: 0,0:07:57.31,0:07:59.43,Default,,0,0,0,,Әрине, егер ол болса
Dialogue: 0,0:07:59.52,0:08:02.60,Default,,0,0,0,,Менің ойымша, қамал өз қақпасын аша алады...
Dialogue: 0,0:08:02.69,0:08:04.94,Default,,0,0,0,,Мен оның қауіпті екенін білемін.
Dialogue: 0,0:08:05.02,0:08:08.40,Default,,0,0,0,,Бірақ ішіме бірдеңе жабысып қалды.
Dialogue: 0,0:08:08.48,0:08:10.61,Default,,0,0,0,,Ол баланы өзіңізбен бірге алып кетуіңіз керек.
Dialogue: 0,0:08:10.69,0:08:13.65,Default,,0,0,0,,Бұл Rain үшін интуитивті пікір.
Dialogue: 0,0:08:14.16,0:08:15.87,Default,,0,0,0,,Мен де түсінбеймін.
Dialogue: 0,0:08:16.74,0:08:18.37,Default,,0,0,0,,Юк, сіз тұтынушысыз.
Dialogue: 0,0:08:19.12,0:08:20.12,Default,,0,0,0,,Тұтынушы?
Dialogue: 0,0:08:20.20,0:08:21.50,Default,,0,0,0,,Кіріңіз
Dialogue: 0,0:08:22.00,0:08:23.25,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:08:23.75,0:08:27.59,Default,,0,0,0,,Мен болашақ саясатқа қатысты сізбен кеңескім келеді.
Dialogue: 0,0:08:28.09,0:08:30.25,Default,,0,0,0,,Не болды? Тіпті проблема?
Dialogue: 0,0:08:30.34,0:08:31.13,Default,,0,0,0,,(Наширо) Рей (Джузо Сузуя) Хм?
Dialogue: 0,0:08:32.05,0:08:33.26,Default,,0,0,0,,Керемет жұмыс
Dialogue: 0,0:08:33.34,0:08:35.76,Default,,0,0,0,,Рун-чан, кеттік!
Dialogue: 0,0:08:35.84,0:08:37.26,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:08:37.35,0:08:41.22,Default,,0,0,0,,Жарайды, Нибельнді де қорғайық.
Dialogue: 0,0:08:41.31,0:08:42.56,Default,,0,0,0,,Сонымен, сіз қалай ойлайсыз?
Dialogue: 0,0:08:42.64,0:08:43.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:43.73,0:08:48.06,Default,,0,0,0,,Ол алтын әулие қыз болса, патшаның құрметті қонағы болар еді.
Dialogue: 0,0:08:48.56,0:08:50.69,Default,,0,0,0,,Егер бұл жұмыс істемесе, жай ғана шегініңіз.
Dialogue: 0,0:08:50.78,0:08:51.78,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:52.28,0:08:55.03,Default,,0,0,0,,Юк-кун, түсіндің, солай ма?
Dialogue: 0,0:08:55.11,0:08:58.37,Default,,0,0,0,,Егер ол Glad She-Im туысқан болса
Dialogue: 0,0:08:58.45,0:09:01.16,Default,,0,0,0,,Әдетте, сіз зынданнан біреуді алып кете алмайсыз.
Dialogue: 0,0:09:01.74,0:09:04.00,Default,,0,0,0,,Міне, бұл зындан
Dialogue: 0,0:09:04.08,0:09:06.58,Default,,0,0,0,,Жасанды толып кетуге жеткілікті
Dialogue: 0,0:09:06.67,0:09:08.79,Default,,0,0,0,,Қазірдің өзінде қауіп төніп тұр.
Dialogue: 0,0:09:09.50,0:09:12.55,Default,,0,0,0,,Бұл кез келген уақытта төбелесті тудыруы мүмкін.
Dialogue: 0,0:09:13.13,0:09:15.93,Default,,0,0,0,,Уақытымыз аз қалды.
Dialogue: 0,0:09:17.93,0:09:21.47,Default,,0,0,0,,Жарайды, бізбен бірге Нибельнді алайық.
Dialogue: 0,0:09:21.56,0:09:23.98,Default,,0,0,0,,Эй, күте тұр... иә?
Dialogue: 0,0:09:26.56,0:09:27.98,Default,,0,0,0,,Аа...
Dialogue: 0,0:09:30.82,0:09:32.98,Default,,0,0,0,,Бұл шынымен де біртүрлі қала.
Dialogue: 0,0:09:33.78,0:09:37.11,Default,,0,0,0,,Кіреберіс қай жерде?
Dialogue: 0,0:09:47.29,0:09:49.92,Default,,0,0,0,,көремін. Ол алаяқ па?
Dialogue: 0,0:09:50.00,0:09:51.75,Default,,0,0,0,,Жаппай галлюцинацияларда
Dialogue: 0,0:09:51.84,0:09:53.92,Default,,0,0,0,,Бұл оның болмағанын білдірмейді.
Dialogue: 0,0:09:54.01,0:09:57.17,Default,,0,0,0,,Қош келдіңіз, Нибельн.
Dialogue: 0,0:09:57.26,0:09:59.80,Default,,0,0,0,,Сыртқы дүние қалай болды?
Dialogue: 0,0:10:01.64,0:10:02.97,Default,,0,0,0,,Бұл сен бе?
Dialogue: 0,0:10:03.06,0:10:06.89,Default,,0,0,0,,О, мені қалай ұмыттың.
Dialogue: 0,0:10:06.98,0:10:08.31,Default,,0,0,0,,Жоқ, сіз
Dialogue: 0,0:10:08.39,0:10:11.48,Default,,0,0,0,,Бәрін ұмытқан дұрыс болар еді
Dialogue: 0,0:10:12.36,0:10:12.98,Default,,0,0,0,,Журнал
Dialogue: 0,0:10:13.48,0:10:16.49,Default,,0,0,0,,Алтын әулие қыз маған бәрін айтып беруімді өтінді.
Dialogue: 0,0:10:16.99,0:10:19.86,Default,,0,0,0,,Айтыңызшы, мұнда не болып жатыр?
Dialogue: 0,0:10:20.36,0:10:22.49,Default,,0,0,0,,Біздің әлем не болады?
Dialogue: 0,0:10:22.58,0:10:26.75,Default,,0,0,0,,Мен саған аманатымды тапсырдым.
Dialogue: 0,0:10:26.83,0:10:31.00,Default,,0,0,0,,Мұндай кәрі дененің жейтін нәрселері көп емес.
Dialogue: 0,0:10:31.08,0:10:34.59,Default,,0,0,0,,Алайда, егер сіз өзіңізбен бірге Нибельн шеберін әкелсеңіз.
Dialogue: 0,0:10:34.67,0:10:36.63,Default,,0,0,0,,Тіпті білмей-ақ қояйық
Dialogue: 0,0:10:46.18,0:10:47.22,Default,,0,0,0,,Мұнда басыңыз
Dialogue: 0,0:10:47.89,0:10:50.10,Default,,0,0,0,,Бізді қайда апаруды жоспарлайсыз?
Dialogue: 0,0:10:50.19,0:10:53.19,Default,,0,0,0,,Нені білгіңіз келетінін білуге ​​болатын орын
Dialogue: 0,0:10:53.69,0:10:57.40,Default,,0,0,0,,Егер бұл қақпан болса, оны бірден сүртіп тастау жаман болады.
Dialogue: 0,0:10:57.49,0:10:59.24,Default,,0,0,0,,Мориа ұстаз, маған еріңіз.
Dialogue: 0,0:10:59.32,0:11:00.49,Default,,0,0,0,,Хмм
Dialogue: 0,0:11:00.57,0:11:04.41,Default,,0,0,0,,Мириам, бұл туралы қалған партияға айту үшін жүгір.
Dialogue: 0,0:11:04.49,0:11:05.70,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:11:05.79,0:11:06.66,Default,,0,0,0,,Дереу
Dialogue: 0,0:11:07.62,0:11:09.54,Default,,0,0,0,,Даркас пен Мадже осы жерде күтеді.
Dialogue: 0,0:11:11.83,0:11:12.75,Default,,0,0,0,,Кеттік
Dialogue: 0,0:11:26.60,0:11:28.81,Default,,0,0,0,,Жарайды, барлығы осында.
Dialogue: 0,0:11:29.43,0:11:30.81,Default,,0,0,0,,Иә
Dialogue: 0,0:11:31.39,0:11:33.85,Default,,0,0,0,,Әй... Кәрі сүйегімде жаңғырады.
Dialogue: 0,0:11:33.94,0:11:36.69,Default,,0,0,0,,Бұл бас тарту сезімінің қысымы болып табылады
Dialogue: 0,0:11:37.40,0:11:40.03,Default,,0,0,0,,Бас тарту сезімі... Дұрыс.
Dialogue: 0,0:11:40.11,0:11:42.41,Default,,0,0,0,,Бұл бас тарту сезімі болса керек.
Dialogue: 0,0:11:42.49,0:11:43.20,Default,,0,0,0,,Иә
Dialogue: 0,0:11:50.91,0:11:52.33,Default,,0,0,0,,Кіріңіз.
Dialogue: 0,0:11:52.42,0:11:55.54,Default,,0,0,0,,Корольдік мұрағат
Dialogue: 0,0:11:56.29,0:11:58.21,Default,,0,0,0,,-Уау... -(Нибельн) Керемет
Dialogue: 0,0:11:58.30,0:12:01.63,Default,,0,0,0,,Осыншама көп кітапты бірінші рет көруім.
Dialogue: 0,0:12:05.39,0:12:09.22,Default,,0,0,0,,Сізге қажетті ақпаратты осы жерден аласыз деп үміттенемін.
Dialogue: 0,0:12:09.31,0:12:13.14,Default,,0,0,0,,Әттең, мен сөйлей алмаймын, хи хи хи...
Dialogue: 0,0:12:13.23,0:12:14.81,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:12:14.90,0:12:18.69,Default,,0,0,0,,Сөз арқылы тану
Dialogue: 0,0:12:18.77,0:12:20.15,Default,,0,0,0,,Сіз одан аулақ жүрсіз бе?
Dialogue: 0,0:12:22.70,0:12:24.24,Default,,0,0,0,,Олар қарт адамды шынымен сынап жатыр
Dialogue: 0,0:12:24.74,0:12:25.78,Default,,0,0,0,,Лорд Юк
Dialogue: 0,0:12:25.87,0:12:29.03,Default,,0,0,0,,Сен жай ғана сиқыршы болсаң, түсінесің.
Dialogue: 0,0:12:29.70,0:12:31.62,Default,,0,0,0,,Сөз дегеніміз не? Ол танымнан туындайды.
Dialogue: 0,0:12:31.70,0:12:35.54,Default,,0,0,0,,Құдіретті сөздер манамен құбылысқа айналады.
Dialogue: 0,0:12:35.62,0:12:40.13,Default,,0,0,0,,Бұл адамда өте күшті мана немесе қарғыс болуы мүмкін.
Dialogue: 0,0:12:40.21,0:12:43.67,Default,,0,0,0,,Тікелей сөйлеуден тайынғанша
Dialogue: 0,0:12:43.76,0:12:46.18,Default,,0,0,0,,Ал, сіз нені айтып тұрсыз?
Dialogue: 0,0:12:46.84,0:12:49.22,Default,,0,0,0,,Бұл адам сөйлескісі келеді.
Dialogue: 0,0:12:49.31,0:12:52.73,Default,,0,0,0,,Ал мен айту керек сөздерді осында жасырдым.
Dialogue: 0,0:12:55.98,0:12:58.40,Default,,0,0,0,,Люсент Бұл қызыл кітап.
Dialogue: 0,0:12:58.48,0:13:00.40,Default,,0,0,0,,үшінн әкел.
Dialogue: 0,0:13:00.48,0:13:01.53,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:13:03.36,0:13:05.99,Default,,0,0,0,,Кішкентай қыз, оқи аласың ба?
Dialogue: 0,0:13:06.07,0:13:07.70,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:13:07.78,0:13:08.95,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:13:09.03,0:13:13.66,Default,,0,0,0,,Шытырман оқиғаның нағыз толғанысы Білім жинауды бастайық
Dialogue: 0,0:13:13.75,0:13:18.04,Default,,0,0,0,,Сезімнің бұрмалануын анықтау қабілетіне мананы шоғырландырыңыз
Dialogue: 0,0:13:19.25,0:13:20.17,Default,,0,0,0,,Ах
Dialogue: 0,0:13:20.25,0:13:25.30,Default,,0,0,0,,Мм... ана жақта қоңыр омыртқалы үлкен кітап бар.
Dialogue: 0,0:13:25.38,0:13:28.43,Default,,0,0,0,,Сондай-ақ, үстелдің тартпасы біртүрлі екен.
Dialogue: 0,0:13:28.51,0:13:30.18,Default,,0,0,0,,Тексеріңіз
Dialogue: 0,0:13:30.26,0:13:31.68,Default,,0,0,0,,Мен кітапты алып келейін.
Dialogue: 0,0:13:34.43,0:13:35.18,Default,,0,0,0,,Жібек?
Dialogue: 0,0:13:35.27,0:13:37.65,Default,,0,0,0,,Біртүрлі рух бар
Dialogue: 0,0:13:37.73,0:13:40.44,Default,,0,0,0,,Glad She-Im үшін ғана болуы мүмкін
Dialogue: 0,0:13:40.52,0:13:42.07,Default,,0,0,0,,Қандай рух?
Dialogue: 0,0:13:42.73,0:13:45.44,Default,,0,0,0,,Сөзбен жеткізу қиын.
Dialogue: 0,0:13:45.53,0:13:50.49,Default,,0,0,0,,Табиғат құбылыстарынан гөрі естеліктер, әндер, дәстүрлер?
Dialogue: 0,0:13:50.57,0:13:52.95,Default,,0,0,0,,Рухқа қатысты рухтарға жақын сияқты.
Dialogue: 0,0:13:53.58,0:13:55.45,Default,,0,0,0,,...
Dialogue: 0,0:13:59.79,0:14:00.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:06.55,0:14:09.51,Default,,0,0,0,,...
Dialogue: 0,0:14:09.59,0:14:12.35,Default,,0,0,0,,...
Dialogue: 0,0:14:12.93,0:14:15.72,Default,,0,0,0,,Мен бұл баладан ақпарат жинаймын.
Dialogue: 0,0:14:16.23,0:14:17.18,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:14:17.27,0:14:18.98,Default,,0,0,0,,-（） -
Dialogue: 0,0:14:19.90,0:14:21.69,Default,,0,0,0,,Мм, түсіндім.
Dialogue: 0,0:14:21.77,0:14:24.36,Default,,0,0,0,,...
Dialogue: 0,0:14:24.44,0:14:25.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:27.95,0:14:30.20,Default,,0,0,0,,...
Dialogue: 0,0:14:30.28,0:14:32.16,Default,,0,0,0,,...
Dialogue: 0,0:14:32.24,0:14:35.16,Default,,0,0,0,,Журнал Бұл кітаптың не екенін білесіз бе?
Dialogue: 0,0:14:35.24,0:14:37.83,Default,,0,0,0,,Иә, әрине.
Dialogue: 0,0:14:38.41,0:14:40.29,Default,,0,0,0,,Бұл қауіпті емес, солай ма?
Dialogue: 0,0:14:40.37,0:14:44.21,Default,,0,0,0,,Оны өз аузымнан айта алмаймын.
Dialogue: 0,0:14:44.30,0:14:44.80,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:14:44.88,0:14:49.13,Default,,0,0,0,,Жоқ, айтыңызшы, «Бұл кітап қауіпті емес».
Dialogue: 0,0:14:51.09,0:14:53.51,Default,,0,0,0,,Аузыңыздан естіп көрейін
Dialogue: 0,0:14:55.51,0:14:56.60,Default,,0,0,0,,Қош бол
Dialogue: 0,0:14:56.68,0:14:59.14,Default,,0,0,0,,Бұл кітапта ешқандай қауіп жоқ.
Dialogue: 0,0:15:02.23,0:15:04.90,Default,,0,0,0,,Бұл кітап қазір қауіпсіз сияқты.
Dialogue: 0,0:15:04.98,0:15:06.53,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:15:06.61,0:15:07.90,Default,,0,0,0,,Сіз өзіңізді мәжбүрледіңіз бе?
Dialogue: 0,0:15:07.99,0:15:09.90,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:10.49,0:15:12.07,Default,,0,0,0,,Жарайды, ашайық.
Dialogue: 0,0:15:14.49,0:15:16.74,Default,,0,0,0,,Сиқырлы кітап? Бұл
Dialogue: 0,0:15:16.83,0:15:18.04,Default,,0,0,0,,Мен солай ойлаймын
Dialogue: 0,0:15:18.12,0:15:21.12,Default,,0,0,0,,Ұқсас сиқырлы формулалар бір-бірінің үстіне қойылады.
Dialogue: 0,0:15:21.21,0:15:23.21,Default,,0,0,0,,Бірақ бұл сәл басқаша сияқты.
Dialogue: 0,0:15:23.29,0:15:25.29,Default,,0,0,0,,Бұның айырмашылығы мынада
Dialogue: 0,0:15:25.88,0:15:28.80,Default,,0,0,0,,Мұнда үстіңгі және астыңғы жағы ауыстырылған... мүмкін?
Dialogue: 0,0:15:28.88,0:15:30.55,Default,,0,0,0,,Түсіну өте қиын.
Dialogue: 0,0:15:30.63,0:15:32.93,Default,,0,0,0,,Менде түсінік жоқ.
Dialogue: 0,0:15:33.01,0:15:34.43,Default,,0,0,0,,Мен де
Dialogue: 0,0:15:34.51,0:15:36.56,Default,,0,0,0,,Тіпті мен білмеймін
Dialogue: 0,0:15:36.64,0:15:38.52,Default,,0,0,0,,Мен оны қалай да оқысам екен.
Dialogue: 0,0:15:38.60,0:15:41.69,Default,,0,0,0,,Мүмкін мен сізге көмектесермін.
Dialogue: 0,0:15:41.77,0:15:43.98,Default,,0,0,0,,Жібек Бұл жеткілікті ме?
Dialogue: 0,0:15:44.06,0:15:46.07,Default,,0,0,0,,Иә, біз дос болдық.
Dialogue: 0,0:15:46.15,0:15:48.44,Default,,0,0,0,,Бұл не? Ол кішірейіп барады
Dialogue: 0,0:15:48.53,0:15:49.99,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:15:50.07,0:15:53.49,Default,,0,0,0,,Осы баланың көмегімен түсінуге болады деп ойлаймын.
Dialogue: 0,0:15:53.57,0:15:54.78,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:15:54.87,0:15:57.87,Default,,0,0,0,,Иә, мырза, қолыңызды осында қойыңыз.
Dialogue: 0,0:16:05.08,0:16:06.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:07.67,0:16:08.46,Default,,0,0,0,,Ой
Dialogue: 0,0:16:11.55,0:16:14.22,Default,,0,0,0,,Хехе, мен таң қалдым.
Dialogue: 0,0:16:15.05,0:16:16.35,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:16:16.43,0:16:20.22,Default,,0,0,0,,Кітап туралы Кітаптың ішінде Еске алу бойынша
Dialogue: 0,0:16:24.35,0:16:27.19,Default,,0,0,0,,Бұл бала кітап рухының Библиясы.
Dialogue: 0,0:16:27.27,0:16:31.07,Default,,0,0,0,,Менің ойымша, ежелгі рух қолданушысы мені кітапхананы қорғауға шақырды.
Dialogue: 0,0:16:31.15,0:16:32.78,Default,,0,0,0,,Библия…
Dialogue: 0,0:16:32.86,0:16:35.41,Default,,0,0,0,,Жібек Мынау жақсы екен
Dialogue: 0,0:16:35.49,0:16:38.41,Default,,0,0,0,,Иә, бұл менің мұғалімім.
Dialogue: 0,0:16:38.49,0:16:42.29,Default,,0,0,0,,Бұл кітап аздап қауіпті, абай болыңыз
Dialogue: 0,0:16:42.37,0:16:46.29,Default,,0,0,0,,Мазмұнын білгім келеді, Библион, не істеуім керек?
Dialogue: 0,0:16:46.38,0:16:48.96,Default,,0,0,0,,«Оқу» - Шито қағидасы
Dialogue: 0,0:16:49.04,0:16:51.55,Default,,0,0,0,,Өзімізше түсінейік, жарай ма?
Dialogue: 0,0:16:51.63,0:16:55.55,Default,,0,0,0,,Сіз нені айтасыз? Оның оқудан айырмашылығы бар ма?
Dialogue: 0,0:16:55.63,0:16:58.10,Default,,0,0,0,,Біз түсіндіреміз
Dialogue: 0,0:16:58.18,0:17:00.06,Default,,0,0,0,,Шито оқиды, бірақ жеткізбейді.
Dialogue: 0,0:17:00.14,0:17:02.27,Default,,0,0,0,,Жақсы, Вибрион.
Dialogue: 0,0:17:02.35,0:17:06.56,Default,,0,0,0,,Бірақ мен сенен ғана сұраймын, Жібектің сиқырлы астары жоқ.
Dialogue: 0,0:17:06.65,0:17:08.56,Default,,0,0,0,,Юку ұнай ма?
Dialogue: 0,0:17:08.65,0:17:10.32,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:17:10.40,0:17:12.74,Default,,0,0,0,,Жібек мені сұрады
Dialogue: 0,0:17:12.82,0:17:13.82,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:17:13.90,0:17:16.07,Default,,0,0,0,,Библия, өтінемін.
Dialogue: 0,0:17:16.16,0:17:18.16,Default,,0,0,0,,Сеніп тапсырылған
Dialogue: 0,0:17:30.17,0:17:32.96,Default,,0,0,0,,Бұл кім? Сен не істеп жатырсың?
Dialogue: 0,0:17:38.39,0:17:40.22,Default,,0,0,0,,Ә, қысқа үзіліс жасайық па?
Dialogue: 0,0:17:44.60,0:17:45.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:45.31,0:17:47.06,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:17:47.64,0:17:49.44,Default,,0,0,0,,Сіз бірдеңе білдіңіз бе?
Dialogue: 0,0:17:50.40,0:17:52.98,Default,,0,0,0,,Бұл сиқырлы кітап техникалық кітапқа көбірек ұқсайтын сияқты.
Dialogue: 0,0:17:53.69,0:17:57.99,Default,,0,0,0,,Автор «бірнеше құлдырау типті сиқырлы формула» деп аталатын нәрсені зерттеген сияқты.
Dialogue: 0,0:17:58.07,0:17:59.57,Default,,0,0,0,,Multiple…
Dialogue: 0,0:17:59.66,0:18:00.53,Default,,0,0,0,,Collapse?
Dialogue: 0,0:18:00.62,0:18:01.37,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:18:01.45,0:18:05.87,Default,,0,0,0,,Бірнеше сиқырды тізбектей әрекет ету техникасы... Менің ойымша.
Dialogue: 0,0:18:06.50,0:18:10.88,Default,,0,0,0,,Менің бұрмаланған жарқыраған жебелерім (призмалық зымырандар) сияқты бір уақытта араласып, белсендірудің орнына
Dialogue: 0,0:18:10.96,0:18:14.25,Default,,0,0,0,,Құлаған домино сияқты көптеген сиқырлы формулалар
Dialogue: 0,0:18:14.34,0:18:17.51,Default,,0,0,0,,Қайта конфигурациялау кезінде іске қосудың қысқаруы
Dialogue: 0,0:18:17.59,0:18:20.26,Default,,0,0,0,,Сізді бір нәтижеге жетелейтін нәрсе.
Dialogue: 0,0:18:20.34,0:18:21.55,Default,,0,0,0,,Өте үлкен нәтижелер
Dialogue: 0,0:18:21.64,0:18:23.39,Default,,0,0,0,,Сиқырмен шығаруға болады
Dialogue: 0,0:18:23.47,0:18:26.10,Default,,0,0,0,,- (Марина Нене) Мм... - Түсіндім.
Dialogue: 0,0:18:26.18,0:18:27.14,Default,,0,0,0,,Не?
Dialogue: 0,0:18:27.23,0:18:29.90,Default,,0,0,0,,Бұл өте қызық.
Dialogue: 0,0:18:29.98,0:18:30.65,Default,,0,0,0,,Мориа-сан
Dialogue: 0,0:18:31.23,0:18:33.27,Default,,0,0,0,,Сіз оларды декодтауды аяқтадыңыз ба?
Dialogue: 0,0:18:33.36,0:18:35.53,Default,,0,0,0,,Бұл тарих кітабы сияқты
Dialogue: 0,0:18:35.61,0:18:38.20,Default,,0,0,0,,Глад Шеймнің осылай болғаны туралы оқиға.
Dialogue: 0,0:18:38.28,0:18:40.53,Default,,0,0,0,,Жазылған
Dialogue: 0,0:18:41.11,0:18:42.49,Default,,0,0,0,,Қуаныштымын
Dialogue: 0,0:18:42.57,0:18:45.74,Default,,0,0,0,,Белгілі бір әлемдегі елдің патша астанасы болып көрінеді.
Dialogue: 0,0:18:45.83,0:18:48.41,Default,,0,0,0,,Аспан мен жерде көптеген құдайлар мекендеген елде
Dialogue: 0,0:18:48.50,0:18:52.00,Default,,0,0,0,,Тәңірлер кейде адамдармен соғысады, кейде бір-бірін жақсы көреді.
Dialogue: 0,0:18:52.08,0:18:54.42,Default,,0,0,0,,Заман тоқыған деседі.
Dialogue: 0,0:18:54.50,0:18:58.34,Default,,0,0,0,,Осы уақытта Күннің батуы деп аталатын дүниенің күйреуі...
Dialogue: 0,0:18:58.42,0:19:02.05,Default,,0,0,0,,Басқаша айтқанда, біз құлдық деп атайтын нәрсе келді.
Dialogue: 0,0:19:02.14,0:19:07.18,Default,,0,0,0,,Мұндағылар мен Водан патша сиқыршылыққа шебер болған сияқты.
Dialogue: 0,0:19:07.27,0:19:11.06,Default,,0,0,0,,Күйрейтін дүниеден қашуды ойласа керек.
Dialogue: 0,0:19:11.15,0:19:13.56,Default,,0,0,0,,Қашу... Солай ма?
Dialogue: 0,0:19:14.27,0:19:15.69,Default,,0,0,0,,Болмады? Юке-доно
Dialogue: 0,0:19:16.28,0:19:18.78,Default,,0,0,0,,Бұл гримуарда сипатталған сиқыр
Dialogue: 0,0:19:18.90,0:19:21.70,Default,,0,0,0,,Қарапайым тілмен айтқанда, тілектерді орындайтын сиқыр.
Dialogue: 0,0:19:21.78,0:19:22.53,Default,,0,0,0,,Хо
Dialogue: 0,0:19:22.61,0:19:27.45,Default,,0,0,0,,Бұл өлшемдерден асып түсетін сиқыр немесе жаппай эвакуациялауға мүмкіндік беретін сиқыр емес пе?
Dialogue: 0,0:19:27.54,0:19:29.66,Default,,0,0,0,,Осы гримуарды жазған сиқыршы
Dialogue: 0,0:19:29.75,0:19:33.17,Default,,0,0,0,,Оның орнына мәселенің түбегейлі шешімі...
Dialogue: 0,0:19:33.25,0:19:36.25,Default,,0,0,0,,Менің ойымша, олар жоюды жеңу туралы ойлайды.
Dialogue: 0,0:19:36.34,0:19:39.21,Default,,0,0,0,,Бұл сиқырға не болды?
Dialogue: 0,0:19:39.30,0:19:41.72,Default,,0,0,0,,Әсер жеткіліксіз
Dialogue: 0,0:19:42.22,0:19:45.35,Default,,0,0,0,,Жоқ, тілектің өзі орындалды.
Dialogue: 0,0:19:45.85,0:19:48.64,Default,,0,0,0,,Уф... Мен мұнда көп қалғым келмейді.
Dialogue: 0,0:19:48.72,0:19:51.14,Default,,0,0,0,,Мәліметтерді кейінірек айтамыз.
Dialogue: 0,0:19:51.23,0:19:52.19,Default,,0,0,0,,Мүмкін, мен кенеттен үйленуге ұсыныс жасағандықтан шығар—
Dialogue: 0,0:19:52.27,0:19:54.77,Default,,0,0,0,,Істегенім білім орманында болдым.
Dialogue: 0,0:19:54.86,0:19:56.90,Default,,0,0,0,,Мен күзетімді түсірдім.
Dialogue: 0,0:19:56.98,0:19:57.82,Default,,0,0,0,,Лорд Юк
Dialogue: 0,0:19:57.90,0:20:01.40,Default,,0,0,0,,Мен қайтып келгенде сізден ақпаратты салыстыруды сұрай аламын ба?
Dialogue: 0,0:20:01.49,0:20:03.03,Default,,0,0,0,,Әрине, Мория мырза.
Dialogue: 0,0:20:03.53,0:20:06.91,Default,,0,0,0,,Юк, маған да сиқырлы кітабыңның мазмұнын айтып берші.
Dialogue: 0,0:20:06.99,0:20:07.66,Default,,0,0,0,,О
Dialogue: 0,0:20:08.74,0:20:10.41,Default,,0,0,0,,Сіз осында болдыңыз.
Dialogue: 0,0:20:11.00,0:20:11.91,Default,,0,0,0,,Не таптың?
Dialogue: 0,0:20:12.00,0:20:13.75,Default,,0,0,0,,Мен көп нәрсені білдім.
Dialogue: 0,0:20:14.25,0:20:18.42,Default,,0,0,0,,Нәтижелерімізді үйге жеткізу үшін біз қазір бас тартуды жоспарлап отырмыз.
Dialogue: 0,0:20:18.50,0:20:19.30,Default,,0,0,0,,Ол үшін не істеуіміз керек?
Dialogue: 0,0:20:19.88,0:20:21.88,Default,,0,0,0,,Хона Атера да шығып кетеді.
Dialogue: 0,0:20:21.97,0:20:23.38,Default,,0,0,0,,Толық шектеу туралы не деуге болады?
Dialogue: 0,0:20:23.47,0:20:26.01,Default,,0,0,0,,Тереңдікке қадам бас
Dialogue: 0,0:20:26.09,0:20:27.64,Default,,0,0,0,,Тоқтаған дұрыс емес пе?
Dialogue: 0,0:20:28.76,0:20:30.72,Default,,0,0,0,,Жоқ, мен сізге қалдырамын.
Dialogue: 0,0:20:31.23,0:20:32.94,Default,,0,0,0,,Нибельн де осында.
Dialogue: 0,0:20:33.02,0:20:34.81,Default,,0,0,0,,Мен лагерьге тезірек оралғым келеді.
Dialogue: 0,0:20:34.90,0:20:35.60,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:20:35.69,0:20:38.40,Default,,0,0,0,,Мен оның артынан қусам да, Ран-чанды өзіммен бірге ала алмаймын.
Dialogue: 0,0:20:38.48,0:20:40.03,Default,,0,0,0,,Мен келісемін.
Dialogue: 0,0:20:40.11,0:20:43.15,Default,,0,0,0,,Үйге қайтып бара жатқанда мені ертіп барады, уайымдама.
Dialogue: 0,0:20:43.24,0:20:45.66,Default,,0,0,0,,Рахмет, Марона
Dialogue: 0,0:20:49.74,0:20:53.33,Default,,0,0,0,,Рун-чан, қайтқанда бірге шомылайық.
Dialogue: 0,0:20:53.41,0:20:53.91,Default,,0,0,0,,Иә
Dialogue: 0,0:20:54.00,0:20:55.79,Default,,0,0,0,,Мен де сенімен бірге боламын.
Dialogue: 0,0:20:55.87,0:20:57.38,Default,,0,0,0,,-Мен де -Мен де
Dialogue: 0,0:20:57.46,0:20:59.96,Default,,0,0,0,,Үлкен апалармен бірге кіріңіз!
Dialogue: 0,0:21:00.88,0:21:03.47,Default,,0,0,0,,Водан патша алтынды пайдаланды
Dialogue: 0,0:21:03.55,0:21:05.80,Default,,0,0,0,,Жалғыз тілегім орындалды
Dialogue: 0,0:21:05.88,0:21:08.35,Default,,0,0,0,,Нәтиже мынау
Dialogue: 0,0:21:08.43,0:21:09.72,Default,,0,0,0,,...сіз мұны айтасыз ба?
Dialogue: 0,0:21:16.02,0:21:18.06,Default,,0,0,0,,♪～
Dialogue: 0,0:22:43.98,0:22:45.98,Default,,0,0,0,,～♪
Dialogue: 0,0:22:47.36,0:22:49.82,Default,,0,0,0,,Келесі жолы «Бір алтын»
Dialogue: 0,0:22:51.32,0:22:57.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
