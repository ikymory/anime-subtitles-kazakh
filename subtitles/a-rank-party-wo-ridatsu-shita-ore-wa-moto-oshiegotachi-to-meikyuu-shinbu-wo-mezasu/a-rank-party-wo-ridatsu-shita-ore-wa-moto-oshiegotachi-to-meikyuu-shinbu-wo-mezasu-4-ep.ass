Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:06.67,Default,,0,0,0,,Арсис?
Dialogue: 0,0:00:07.34,0:00:08.80,Default,,0,0,0,,Бұл кандидатураны ұсыну туралы өтініш...
Dialogue: 0,0:00:08.88,0:00:10.38,Default,,0,0,0,,Жарайды, жасайық!
Dialogue: 0,0:00:10.46,0:00:12.84,Default,,0,0,0,,Күтіңіз, күтіңіз, мұқият тыңдаңыз.
Dialogue: 0,0:00:12.92,0:00:13.68,Default,,0,0,0,,Иә
Dialogue: 0,0:00:13.76,0:00:17.60,Default,,0,0,0,,Бұл Кварото қаласындағы бұрыннан қалыптасқан қару-жарақ шеберханасы.
Dialogue: 0,0:00:18.10,0:00:20.10,Default,,0,0,0,,Менің садағым да Арсис.
Dialogue: 0,0:00:20.18,0:00:22.35,Default,,0,0,0,,Иә, мен де білемін.
Dialogue: 0,0:00:22.43,0:00:24.39,Default,,0,0,0,,Тағайындау туралы өтініш сол жерден?
Dialogue: 0,0:00:24.89,0:00:26.19,Default,,0,0,0,,Неліктен беде?
Dialogue: 0,0:00:26.77,0:00:28.69,Default,,0,0,0,,Арсис үшін осы маусымның тақырыбы
Dialogue: 0,0:00:29.40,0:00:30.44,Default,,0,0,0,,Осыған байланысты шығар
Dialogue: 0,0:00:31.15,0:00:33.95,Default,,0,0,0,,«Авантюрист әйелдерге арналған жаңа стиль»
Dialogue: 0,0:00:34.03,0:00:37.12,Default,,0,0,0,,«Сәнді және қауіпсіз шытырманға барайық»
Dialogue: 0,0:00:37.20,0:00:38.95,Default,,0,0,0,,Оның тартымдылығына байланысты ма?
Dialogue: 0,0:00:39.03,0:00:42.41,Default,,0,0,0,,Балалар, сендер Арсидің жаңа сауытымен жабдықталғансыңдар.
Dialogue: 0,0:00:42.50,0:00:44.08,Default,,0,0,0,,Лабиринтті бағындыру
Dialogue: 0,0:00:44.16,0:00:46.54,Default,,0,0,0,,Кадрларды жарнама ретінде пайдаланыңыз
Dialogue: 0,0:00:46.62,0:00:47.29,Default,,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:00:47.38,0:00:49.71,Default,,0,0,0,,Ол жаңа образ кейіпкеріне айналады.
Dialogue: 0,0:00:49.79,0:00:52.46,Default,,0,0,0,,Ал, біз ше?
Dialogue: 0,0:00:53.01,0:00:54.63,Default,,0,0,0,,Мұны қабылдау керек
Dialogue: 0,0:00:54.72,0:00:57.22,Default,,0,0,0,,Юк оны қайтып әкелгенде білетін боласыз.
Dialogue: 0,0:00:57.84,0:00:59.14,Default,,0,0,0,,Алайық.
Dialogue: 0,0:00:59.22,0:01:01.93,Default,,0,0,0,,Маған сыйлықтың осы бөлігі ерекше ұнады.
Dialogue: 0,0:01:02.43,0:01:06.35,Default,,0,0,0,,«Біз сіз пайдаланған жабдықты сол күйінде береміз.»
Dialogue: 0,0:01:06.44,0:01:08.27,Default,,0,0,0,,О, бұл жақсы!
Dialogue: 0,0:01:08.35,0:01:10.32,Default,,0,0,0,,Ақша мен құрал-жабдық алғаныма сене алар емеспін.
Dialogue: 0,0:01:10.40,0:01:12.32,Default,,0,0,0,,Жасайық, істейік, Юк.
Dialogue: 0,0:01:12.40,0:01:12.98,Default,,0,0,0,,Иә
Dialogue: 0,0:01:13.07,0:01:14.61,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:01:14.69,0:01:19.24,Default,,0,0,0,,Арсистің жаңа жабдығын киген кезде зынданды қалай жеңу керектігін түсіндіреді.
Dialogue: 0,0:01:19.32,0:01:21.08,Default,,0,0,0,,Кловердің келесі квесті.
Dialogue: 0,0:01:21.16,0:01:22.24,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:22.33,0:01:25.25,Default,,0,0,0,,Сонымен, зындан қай зынданды жаулап алды?
Dialogue: 0,0:01:25.33,0:01:27.12,Default,,0,0,0,,Бұл сәл алыс, бірақ
Dialogue: 0,0:01:27.21,0:01:29.25,Default,,0,0,0,,Арсис Кварото қаласында орналасқан.
Dialogue: 0,0:01:30.29,0:01:32.34,Default,,0,0,0,,Аион қирандылары лабиринт
Dialogue: 0,0:01:33.51,0:01:35.51,Default,,0,0,0,,♪～
Dialogue: 0,0:03:00.88,0:03:02.89,Default,,0,0,0,,～♪
Dialogue: 0,0:03:07.27,0:03:09.56,Default,,0,0,0,,Thunderpike әлі нәрестелік кезеңде болған кезде
Dialogue: 0,0:03:09.64,0:03:10.89,Default,,0,0,0,,Сіз мұнда қанша рет болдыңыз?
Dialogue: 0,0:03:10.98,0:03:12.40,Default,,0,0,0,,Yuk Күткеніңізге рахмет!
Dialogue: 0,0:03:15.57,0:03:16.90,Default,,0,0,0,,Хехехе
Dialogue: 0,0:03:18.53,0:03:19.40,Default,,0,0,0,,Хехехе
Dialogue: 0,0:03:21.99,0:03:23.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:23.99,0:03:25.41,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:03:25.91,0:03:27.62,Default,,0,0,0,,Қалай... өзіңізді қалай сезінесіз?
Dialogue: 0,0:03:27.70,0:03:29.16,Default,,0,0,0,,Сізге сәйкес келе ме?
Dialogue: 0,0:03:29.83,0:03:32.67,Default,,0,0,0,,Олардың бәрі бірге жақсы көрінеді, сондай сүйкімді
Dialogue: 0,0:03:32.75,0:03:34.92,Default,,0,0,0,,-Эхе -мм...
Dialogue: 0,0:03:35.00,0:03:36.54,Default,,0,0,0,,Бұл қаншалықты ыңғайлы?
Dialogue: 0,0:03:36.63,0:03:38.92,Default,,0,0,0,,Қозғалу оңай және жеңіл, сондықтан жақсы.
Dialogue: 0,0:03:39.63,0:03:41.51,Default,,0,0,0,,Бұл жаңа садақ
Dialogue: 0,0:03:41.59,0:03:44.05,Default,,0,0,0,,Мен бұған үйренбегенмін, бірақ менің ойымша, бұл жақсы.
Dialogue: 0,0:03:44.14,0:03:45.22,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:03:45.30,0:03:48.77,Default,,0,0,0,,Бұл жабдық, сиқырлы құрал (артефакт) өте жақсы.
Dialogue: 0,0:03:48.85,0:03:50.56,Default,,0,0,0,,Бұл трансляцияда тамаша көрінеді
Dialogue: 0,0:03:50.64,0:03:53.06,Default,,0,0,0,,Артефактілер үшін өте қолайлы.
Dialogue: 0,0:03:53.14,0:03:54.31,Default,,0,0,0,,Уау! Өте әдемі!
Dialogue: 0,0:03:54.90,0:03:58.19,Default,,0,0,0,,Осының бәрін маған беріп қана қоймай, ақшасын да төлейсің.
Dialogue: 0,0:03:58.27,0:03:59.90,Default,,0,0,0,,Ол өте жомарт.
Dialogue: 0,0:03:59.98,0:04:01.57,Default,,0,0,0,,Рахмет сізге Арсис
Dialogue: 0,0:04:02.20,0:04:04.57,Default,,0,0,0,,Квестті дұрыс орындағаннан кейін ғана алғыс айта аласыз.
Dialogue: 0,0:04:05.07,0:04:06.99,Default,,0,0,0,,Бұл жолы тікелей эфир емес
Dialogue: 0,0:04:07.08,0:04:09.79,Default,,0,0,0,,Жазылған материал Арсиге беріледі
Dialogue: 0,0:04:10.29,0:04:12.12,Default,,0,0,0,,Бәріміз абайлап ләззат алайық.
Dialogue: 0,0:04:12.21,0:04:13.21,Default,,0,0,0,,Жазуды бастау
Dialogue: 0,0:04:13.29,0:04:14.46,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:15.04,0:04:15.71,Default,,0,0,0,,Хун
Dialogue: 0,0:04:15.79,0:04:17.71,Default,,0,0,0,,А... иә?
Dialogue: 0,0:04:27.51,0:04:29.14,Default,,0,0,0,,Бұл Эон қирандылары лабиринт болып табылады
Dialogue: 0,0:04:29.22,0:04:30.14,Default,,0,0,0,,өте ескі
Dialogue: 0,0:04:30.64,0:04:34.35,Default,,0,0,0,,Бұл өте үлкен зындан емес, жер астында 4 қабат.
Dialogue: 0,0:04:34.44,0:04:37.56,Default,,0,0,0,,Ең терең жері – негізгі зындан.
Dialogue: 0,0:04:37.65,0:04:40.53,Default,,0,0,0,,Aw-Dread тастанды қала лабиринтіне кіреберіс бар.
Dialogue: 0,0:04:41.07,0:04:43.19,Default,,0,0,0,,Басқаша айтқанда, бұл жер зындан қызметін де атқарады.
Dialogue: 0,0:04:43.28,0:04:45.28,Default,,0,0,0,,Бұл негізгі зынданға өтетін жол.
Dialogue: 0,0:04:45.86,0:04:49.12,Default,,0,0,0,,Квест - тастанды қала лабиринтінің кіреберісіне жету.
Dialogue: 0,0:04:52.16,0:04:56.83,Default,,0,0,0,,Шығыс және батыс шеттерде төмен түсуге болатын бір баспалдақ бар.
Dialogue: 0,0:04:56.92,0:04:58.00,Default,,0,0,0,,Алдымен сонда барайық.
Dialogue: 0,0:04:58.63,0:04:59.79,Default,,0,0,0,,Онда атриум
Dialogue: 0,0:04:59.88,0:05:02.13,Default,,0,0,0,,Арқанмен төмен түсу жылдамырақ емес пе?
Dialogue: 0,0:05:02.21,0:05:04.38,Default,,0,0,0,,Олай ойлайтындар да болды, бірақ...
Dialogue: 0,0:05:05.51,0:05:06.26,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:05:08.59,0:05:09.64,Default,,0,0,0,,Уау
Dialogue: 0,0:05:09.72,0:05:12.02,Default,,0,0,0,,Лабиринтке айналғандықтан болар.
Dialogue: 0,0:05:12.10,0:05:15.06,Default,,0,0,0,,Фаза бұрмаланған, мен одан өте алмаймын.
Dialogue: 0,0:05:15.56,0:05:16.64,Default,,0,0,0,,Ешқашан құламаңыз
Dialogue: 0,0:05:16.73,0:05:18.06,Default,,0,0,0,,Иә
Dialogue: 0,0:05:18.15,0:05:19.15,Default,,0,0,0,,-Түсіндім -Мм...
Dialogue: 0,0:05:21.15,0:05:23.61,Default,,0,0,0,,Жаңбыр Мен бірдеңе істедім бе?
Dialogue: 0,0:05:23.69,0:05:25.74,Default,,0,0,0,,Сіз біраз уақыттан бері бір нәрсеге ашуланған сияқтысыз.
Dialogue: 0,0:05:25.82,0:05:27.16,Default,,0,0,0,,Ммм~
Dialogue: 0,0:05:27.24,0:05:28.41,Default,,0,0,0,,Аа…
Dialogue: 0,0:05:28.99,0:05:31.91,Default,,0,0,0,,Жоқ, Юк, сен ештеңе айтпадың.
Dialogue: 0,0:05:31.99,0:05:32.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:32.99,0:05:36.16,Default,,0,0,0,,Әйелдің жүрегі не екенін түсінбейсің.
Dialogue: 0,0:05:36.25,0:05:37.42,Default,,0,0,0,,Хмм?
Dialogue: 0,0:05:38.12,0:05:41.29,Default,,0,0,0,,Олар жаңа жабдыққа сәйкес таспаның түсін өзгертпеді ме?
Dialogue: 0,0:05:42.09,0:05:44.42,Default,,0,0,0,,Бұл сізге жарасады. Бұл өте сүйкімді.
Dialogue: 0,0:05:44.51,0:05:45.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:46.67,0:05:47.93,Default,,0,0,0,,Эй... Эй, не болды?
Dialogue: 0,0:05:48.68,0:05:50.35,Default,,0,0,0,,Юк тым көп
Dialogue: 0,0:05:50.43,0:05:53.06,Default,,0,0,0,,Жаңбырға әлсірететін сиқырды қолданбаңыз.
Dialogue: 0,0:05:53.14,0:05:55.31,Default,,0,0,0,,- Дұрыс, мұғалім - (Юк) А...
Dialogue: 0,0:05:56.52,0:05:58.81,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:06:00.65,0:06:02.02,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:06:06.86,0:06:08.74,Default,,0,0,0,,Ой, бұл тұзақ.
Dialogue: 0,0:06:10.66,0:06:12.16,Default,,0,0,0,,Сәл артқа шегініңіз.
Dialogue: 0,0:06:18.62,0:06:19.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:21.21,0:06:23.50,Default,,0,0,0,,Жарайды, жарайды, ары қарай жүрейік.
Dialogue: 0,0:06:27.67,0:06:28.51,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:06:29.38,0:06:31.26,Default,,0,0,0,,Иә, шығуға болады.
Dialogue: 0,0:06:32.05,0:06:34.47,Default,,0,0,0,,Өйткені жаңа жабдық менің денеме сай келеді
Dialogue: 0,0:06:34.56,0:06:35.52,Default,,0,0,0,,Мүмкін бұл дұрыс болған шығар
Dialogue: 0,0:06:38.94,0:06:40.73,Default,,0,0,0,,Баспалдақтар дәл осы жерде.
Dialogue: 0,0:06:40.81,0:06:42.44,Default,,0,0,0,,Келген соң, азғана үзіліс алайық.
Dialogue: 0,0:06:43.02,0:06:44.57,Default,,0,0,0,,Бүгінгі көже қандай?
Dialogue: 0,0:06:45.23,0:06:48.40,Default,,0,0,0,,Соның бәрін сорпадан сұрау керек.
Dialogue: 0,0:06:48.49,0:06:50.32,Default,,0,0,0,,Бірақ мен Раинның сүйікті тағамы шығады деп үміттенемін.
Dialogue: 0,0:06:50.41,0:06:51.36,Default,,0,0,0,,Иә
Dialogue: 0,0:06:51.86,0:06:54.28,Default,,0,0,0,,Хмм... Жаңбыр өте жасырын.
Dialogue: 0,0:06:54.37,0:06:56.37,Default,,0,0,0,,Бүгін менің сүйікті тағамым беріледі.
Dialogue: 0,0:06:56.45,0:06:58.66,Default,,0,0,0,,Мен бұқтырылған сүтті жақсы көремін.
Dialogue: 0,0:06:58.75,0:07:00.58,Default,,0,0,0,,Ахаха... а
Dialogue: 0,0:07:01.71,0:07:02.67,Default,,0,0,0,,Ұрысқа дайындық
Dialogue: 0,0:07:09.84,0:07:13.26,Default,,0,0,0,,Отбасымнан алыста~!
Dialogue: 0,0:07:13.34,0:07:16.35,Default,,0,0,0,,Ах... Оркус
Dialogue: 0,0:07:17.27,0:07:18.27,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:07:18.35,0:07:19.27,Default,,0,0,0,,Жібек
Dialogue: 0,0:07:19.85,0:07:23.06,Default,,0,0,0,,Мен Оркустың эльфтердің қас жауы екенін білемін.
Dialogue: 0,0:07:23.56,0:07:26.02,Default,,0,0,0,,Жарайсың ба? Тек тынышталып, онымен күресіңіз.
Dialogue: 0,0:07:26.11,0:07:27.82,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:07:27.90,0:07:29.99,Default,,0,0,0,,Бірақ оны міндетті түрде жойайық.
Dialogue: 0,0:07:30.49,0:07:32.03,Default,,0,0,0,,Тіпті біреуін де өткізіп жібересіз бе?
Dialogue: 0,0:07:32.11,0:07:36.49,Default,,0,0,0,,Жарайды, олардың 4-еуі бар. Қару-жарақтарына қарағанда, олар төмен дәрежелі жауынгерлер.
Dialogue: 0,0:07:36.58,0:07:38.91,Default,,0,0,0,,Құбыжық дәрежесі бойынша бұл С қарсыласы.
Dialogue: 0,0:07:39.00,0:07:41.04,Default,,0,0,0,,Сақтығыңызды төмендетпеңіз, өйткені басқа адам мұны жақсы деп санайсыз.
Dialogue: 0,0:07:41.96,0:07:44.58,Default,,0,0,0,,Алдымен сиқырмен және садақпен алдын ала шабуыл жасаңыз.
Dialogue: 0,0:07:44.67,0:07:47.13,Default,,0,0,0,,Осыдан кейін Марина шабуыл жасайды және Жібек қолдау көрсетеді.
Dialogue: 0,0:07:47.21,0:07:47.88,Default,,0,0,0,,Мен ше?
Dialogue: 0,0:07:47.96,0:07:50.09,Default,,0,0,0,,Бірінші соққы үшін үлкенін сұраңыз.
Dialogue: 0,0:07:50.17,0:07:52.22,Default,,0,0,0,,Мүмкін болса санын азайтқым келеді.
Dialogue: 0,0:07:52.30,0:07:53.51,Default,,0,0,0,,Физикалық сиқырлау
Dialogue: 0,0:07:55.34,0:07:58.01,Default,,0,0,0,,Ашулы аң сияқты жанып тұрған от...
Dialogue: 0,0:07:58.10,0:07:59.35,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:07:59.43,0:08:00.81,Default,,0,0,0,,-Кез келген уақытта -Иә!
Dialogue: 0,0:08:00.89,0:08:01.39,Default,,0,0,0,,Жаңбыр!
Dialogue: 0,0:08:01.48,0:08:03.81,Default,,0,0,0,,Зұлымдарды өрте
Dialogue: 0,0:08:03.90,0:08:06.90,Default,,0,0,0,,Төртінші деңгейлі сиқырлы от добы!
Dialogue: 0,0:08:08.15,0:08:10.07,Default,,0,0,0,,Гваааах!
Dialogue: 0,0:08:10.15,0:08:11.24,Default,,0,0,0,,Іске қосу
Dialogue: 0,0:08:11.32,0:08:13.53,Default,,0,0,0,,Рок жарылысы шиыршығы!
Dialogue: 0,0:08:16.82,0:08:17.74,Default,,0,0,0,,Гуа!
Dialogue: 0,0:08:20.08,0:08:22.00,Default,,0,0,0,,Не болып жатыр? Не болып жатыр?
Dialogue: 0,0:08:22.08,0:08:23.12,Default,,0,0,0,,2 қалды!
Dialogue: 0,0:08:23.21,0:08:25.00,Default,,0,0,0,,Парализ баяу
Dialogue: 0,0:08:28.09,0:08:29.00,Default,,0,0,0,,Сиқырлы қылыштың өзгеруі!
Dialogue: 0,0:08:30.59,0:08:32.51,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:08:32.59,0:08:34.38,Default,,0,0,0,,-Гуооу -Үйрек... Хмф!
Dialogue: 0,0:08:38.05,0:08:39.97,Default,,0,0,0,,Гваааах!
Dialogue: 0,0:08:40.60,0:08:42.06,Default,,0,0,0,,Тез кетіңіз
Dialogue: 0,0:08:42.14,0:08:43.56,Default,,0,0,0,,Әдемі жібек
Dialogue: 0,0:08:44.14,0:08:44.64,Default,,0,0,0,,Кеудесіндегі бұл түтікке егер мен осы Молотов коктейлін ұрсам—
Dialogue: 0,0:08:44.73,0:08:45.85,Default,,0,0,0,,Иә
Dialogue: 0,0:08:47.56,0:08:49.07,Default,,0,0,0,,(Танжиро) Ал, баста! (Үшеуі) Бар күшіңді сал!
Dialogue: 0,0:08:54.78,0:08:56.95,Default,,0,0,0,,Жарайды, бағындыру аяқталды.
Dialogue: 0,0:08:57.03,0:08:58.82,Default,,0,0,0,,Меніңше… біз істеп қойған сияқтымыз, иә?
Dialogue: 0,0:09:02.45,0:09:03.70,Default,,0,0,0,,Аздап тынышталдыңыз ба?
Dialogue: 0,0:09:04.33,0:09:06.46,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:09:06.54,0:09:09.88,Default,,0,0,0,,Оркусты көргенде тітіркенемін.
Dialogue: 0,0:09:09.96,0:09:12.71,Default,,0,0,0,,Бұл перілердің табиғаты, оған алаңдамаңыз.
Dialogue: 0,0:09:13.92,0:09:15.13,Default,,0,0,0,,Мұғалім бұл
Dialogue: 0,0:09:15.22,0:09:17.84,Default,,0,0,0,,«Қараңғы эльф болғанымен» демейсің
Dialogue: 0,0:09:18.43,0:09:19.55,Default,,0,0,0,,Жібек – жібек, солай ма?
Dialogue: 0,0:09:20.89,0:09:24.23,Default,,0,0,0,,Қараңғы эльфтер эльфтердің сатқындары ма?
Dialogue: 0,0:09:24.31,0:09:25.56,Default,,0,0,0,,Сірә, тек ырым шығар
Dialogue: 0,0:09:26.06,0:09:29.69,Default,,0,0,0,,Ал біз Жібекті досымыз деп есептейміз.
Dialogue: 0,0:09:30.31,0:09:31.52,Default,,0,0,0,,5-үй, «Малкольм» үй меңгерушісі
Dialogue: 0,0:09:32.02,0:09:34.61,Default,,0,0,0,,Негізінен айта бастасаң Жаңбырға қара.
Dialogue: 0,0:09:35.11,0:09:37.53,Default,,0,0,0,,Ол артефактілерді ергежейлі сияқты тойлайды.
Dialogue: 0,0:09:37.61,0:09:39.28,Default,,0,0,0,,Хмм… Кешіріңіз.
Dialogue: 0,0:09:39.37,0:09:40.87,Default,,0,0,0,,Артефакт романтикалық
Dialogue: 0,0:09:40.95,0:09:42.33,Default,,0,0,0,,Мен мұны түсінемін.
Dialogue: 0,0:09:42.41,0:09:43.83,Default,,0,0,0,,Хм
Dialogue: 0,0:09:43.91,0:09:45.29,Default,,0,0,0,,Юк
Dialogue: 0,0:09:45.37,0:09:47.62,Default,,0,0,0,,Оркус біртүрлі нәрсені алып жүрді.
Dialogue: 0,0:09:47.71,0:09:48.83,Default,,0,0,0,,Біртүрлі нәрсе бар ма?
Dialogue: 0,0:09:50.42,0:09:51.71,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:52.50,0:09:54.21,Default,,0,0,0,,Сіз жақсы нәрсе таптыңыз, Марина.
Dialogue: 0,0:09:54.30,0:09:57.01,Default,,0,0,0,,-Солай ма? -Бұл не?
Dialogue: 0,0:09:57.09,0:10:00.55,Default,,0,0,0,,Бұл аздап бүлінген, бірақ бұл «аян туралы меморандум».
Dialogue: 0,0:10:01.05,0:10:03.06,Default,,0,0,0,,Аян туралы меморандум?
Dialogue: 0,0:10:03.14,0:10:06.23,Default,,0,0,0,,Жасырын қабілеттерді ашуға арналған артефакт
Dialogue: 0,0:10:06.31,0:10:09.23,Default,,0,0,0,,Оркус неліктен төмен класты құбыжық?
Dialogue: 0,0:10:09.31,0:10:10.23,Default,,0,0,0,,Сізде болды ма?
Dialogue: 0,0:10:10.31,0:10:12.11,Default,,0,0,0,,Сіз жоғары бағаға сата аласыз ба?
Dialogue: 0,0:10:12.19,0:10:14.32,Default,,0,0,0,,Бұл жылдамдықпен сіз екі-үш сөйлемді ғана аласыз.
Dialogue: 0,0:10:14.40,0:10:17.57,Default,,0,0,0,,Бірақ оны сату босқа кетеді, мен оны жөндеймін.
Dialogue: 0,0:10:17.65,0:10:18.74,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:10:18.82,0:10:22.28,Default,,0,0,0,,Міне, мен алхимик ретінде өз дағдыларымды көрсете аламын.
Dialogue: 0,0:10:22.37,0:10:24.74,Default,,0,0,0,,Егер жөндеу сәтті болса, оны басқа біреу пайдалана алады.
Dialogue: 0,0:10:24.83,0:10:26.75,Default,,0,0,0,,Мен оны пайдаланған кезде не болады?
Dialogue: 0,0:10:27.33,0:10:29.96,Default,,0,0,0,,Адамның таланты аздап гүлдейді.
Dialogue: 0,0:10:30.04,0:10:34.84,Default,,0,0,0,,Мысалы, екінші жұмыс қабілеті пайда болады немесе жаңа дағды пайда болады.
Dialogue: 0,0:10:34.92,0:10:36.88,Default,,0,0,0,,-Аа - түсіндім.
Dialogue: 0,0:10:36.96,0:10:39.88,Default,,0,0,0,,Дәл қазір менің жұмысым - сиқырлы қылышшы.
Dialogue: 0,0:10:39.97,0:10:42.01,Default,,0,0,0,,Маринаның оны пайдаланғаны жақсы болар еді.
Dialogue: 0,0:10:42.09,0:10:42.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:42.68,0:10:44.76,Default,,0,0,0,,Иә, бұл да жақсы деп ойлаймын.
Dialogue: 0,0:10:45.35,0:10:48.81,Default,,0,0,0,,Бірақ мен екінші мамандығымды оята аламын ба?
Dialogue: 0,0:10:48.89,0:10:50.64,Default,,0,0,0,,Өйткені сиқырлы қылышшылар сирек кездеседі.
Dialogue: 0,0:10:50.73,0:10:54.77,Default,,0,0,0,,Ғибадатханадағылар маған талантым осында шоғырланған шығар деп айтты.
Dialogue: 0,0:10:55.36,0:10:58.94,Default,,0,0,0,,Кейбір адамдар осылай ойлайды, бірақ бұл жұмыс болмаса да.
Dialogue: 0,0:10:59.03,0:11:01.41,Default,,0,0,0,,Сіз кейбір жасырын талантты ашуыңыз мүмкін.
Dialogue: 0,0:11:01.49,0:11:02.91,Default,,0,0,0,,Сіздің әйеліңіз?
Dialogue: 0,0:11:03.53,0:11:05.74,Default,,0,0,0,,Бұл талант па?
Dialogue: 0,0:11:06.24,0:11:06.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:07.75,0:11:08.91,Default,,0,0,0,,Бұл қазына сандығы.
Dialogue: 0,0:11:10.54,0:11:12.92,Default,,0,0,0,,Зарядталуда...
Dialogue: 0,0:11:14.75,0:11:17.67,Default,,0,0,0,,-Эхехехе... -Жақсы саған Жаңбыр
Dialogue: 0,0:11:18.26,0:11:21.18,Default,,0,0,0,,Кеудеден сиқырлы қапшық шыққанда үлкен соққы.
Dialogue: 0,0:11:21.26,0:11:22.43,Default,,0,0,0,,Иә
Dialogue: 0,0:11:22.51,0:11:25.01,Default,,0,0,0,,Бірақ оны алғаным дұрыс па?
Dialogue: 0,0:11:25.10,0:11:26.72,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:11:26.81,0:11:29.64,Default,,0,0,0,,Тыл сақшысында осындай нәрсе болғаны жақсы емес пе?
Dialogue: 0,0:11:30.23,0:11:31.27,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:31.35,0:11:33.60,Default,,0,0,0,,Сонымен, келесі жолы сиқырлы қапшық аласыз
Dialogue: 0,0:11:33.69,0:11:34.65,Default,,0,0,0,,Жібекті пайдалану керек.
Dialogue: 0,0:11:34.73,0:11:36.40,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:11:36.98,0:11:40.40,Default,,0,0,0,,Әрине, көрсеткілерді сақтауға ыңғайлы.
Dialogue: 0,0:11:40.49,0:11:43.03,Default,,0,0,0,,Оны алу оңай емес.
Dialogue: 0,0:11:43.61,0:11:45.91,Default,,0,0,0,,Мен оны еш үмітсіз күтемін.
Dialogue: 0,0:11:48.49,0:11:51.08,Default,,0,0,0,,Енді кетер алдында тозуды тексеріп алайық.
Dialogue: 0,0:11:51.58,0:11:54.08,Default,,0,0,0,,Мен бір ғана сиқырлы шиыршықты тұтындым.
Dialogue: 0,0:11:54.17,0:11:55.17,Default,,0,0,0,,Мана жақсы.
Dialogue: 0,0:11:55.25,0:11:57.67,Default,,0,0,0,,Мен де жақсымын, жақсымын!
Dialogue: 0,0:11:58.30,0:12:00.13,Default,,0,0,0,,5 көрсеткі жұмсалды.
Dialogue: 0,0:12:00.21,0:12:01.55,Default,,0,0,0,,20 дана қалды
Dialogue: 0,0:12:01.63,0:12:05.18,Default,,0,0,0,,Менің де қарным тоқ, манам толық қалпына келді.
Dialogue: 0,0:12:05.76,0:12:08.18,Default,,0,0,0,,Жарайды, квестті жалғастырайық.
Dialogue: 0,0:12:08.26,0:12:09.89,Default,,0,0,0,,Сақтықпен ләззат алыңыз
Dialogue: 0,0:12:09.97,0:12:11.14,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:12:14.60,0:12:17.40,Default,,0,0,0,,Құбыжықтар қайдан шабуыл жасайтынын білмеймін.
Dialogue: 0,0:12:17.48,0:12:18.57,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:12:18.65,0:12:20.65,Default,,0,0,0,,Мұнда еден бастығы жоқ, солай ма?
Dialogue: 0,0:12:21.53,0:12:23.53,Default,,0,0,0,,Бір кездері, ең терең тасталған қала лабиринтінде.
Dialogue: 0,0:12:23.61,0:12:24.91,Default,,0,0,0,,Есік алдында тұрса керек.
Dialogue: 0,0:12:25.70,0:12:28.24,Default,,0,0,0,,Бұл соңғы 10 жылда болмаған сияқты.
Dialogue: 0,0:12:29.62,0:12:32.37,Default,,0,0,0,,Мен көлеңкелі аңдыушы деген құбыжықтың бар екеніне сенімдімін.
Dialogue: 0,0:12:32.46,0:12:35.79,Default,,0,0,0,,Есікті бірнеше адам күзетіп тұрғаны жазылған.
Dialogue: 0,0:12:35.88,0:12:37.67,Default,,0,0,0,,Shadow Stalker?
Dialogue: 0,0:12:37.75,0:12:39.42,Default,,0,0,0,,«Көлеңке адам»?
Dialogue: 0,0:12:39.50,0:12:42.51,Default,,0,0,0,,Мен жазбаларды ғана оқыдым, бірақ ешқашан көрген емеспін.
Dialogue: 0,0:12:43.01,0:12:45.26,Default,,0,0,0,,Бұл қандай құбыжық?
Dialogue: 0,0:12:45.34,0:12:47.55,Default,,0,0,0,,Қошқар қара манекен сияқты.
Dialogue: 0,0:12:47.64,0:12:51.02,Default,,0,0,0,,Тек көздер жарқырап тұрғаны туралы сипаттама болды.
Dialogue: 0,0:12:51.10,0:12:52.52,Default,,0,0,0,,- Солай ма? -(Юк) А?
Dialogue: 0,0:12:57.27,0:12:59.23,Default,,0,0,0,,Shadow Stalker?
Dialogue: 0,0:12:59.32,0:13:01.61,Default,,0,0,0,,Оны 10 жылдан астам уақыт көрмеген еді...
Dialogue: 0,0:13:02.11,0:13:03.57,Default,,0,0,0,,Жақсы суретке түсіріңіз
Dialogue: 0,0:13:04.20,0:13:05.99,Default,,0,0,0,,Мақсатты құлыптау
Dialogue: 0,0:13:06.66,0:13:07.95,Default,,0,0,0,,Операцияны басқаратын шебер агент: Твайлайт
Dialogue: 0,0:13:08.03,0:13:10.83,Default,,0,0,0,,Көзге көріну жақсы емес.
Dialogue: 0,0:13:10.91,0:13:12.75,Default,,0,0,0,,Жүрекшеден өте алмайды
Dialogue: 0,0:13:12.83,0:13:15.37,Default,,0,0,0,,Олар сізге бірден шабуыл жасайтындай емес.
Dialogue: 0,0:13:15.46,0:13:16.12,Default,,0,0,0,,Не!
Dialogue: 0,0:13:19.59,0:13:20.71,Default,,0,0,0,,-(Юк) Енді... -Одан өттім!
Dialogue: 0,0:13:20.79,0:13:22.25,Default,,0,0,0,,(Көлеңке аңдыған күлкі)
Dialogue: 0,0:13:23.59,0:13:25.80,Default,,0,0,0,,Келе жатыр, шайқасқа дайын!
Dialogue: 0,0:13:25.88,0:13:26.72,Default,,0,0,0,,Бұл балаларды ойнауға әкелетін орын емес
Dialogue: 0,0:13:26.80,0:13:28.51,Default,,0,0,0,,Көп сиқырлы шиыршық
Dialogue: 0,0:13:30.35,0:13:32.14,Default,,0,0,0,,Гуфуфу…
Dialogue: 0,0:13:33.10,0:13:34.52,Default,,0,0,0,,Сіз кез келген уақытта бара аласыз.
Dialogue: 0,0:13:34.60,0:13:36.02,Default,,0,0,0,,Гуоо!
Dialogue: 0,0:13:36.98,0:13:38.81,Default,,0,0,0,,(Наширо) Рей (Джузо Сузуя) Хм?
Dialogue: 0,0:13:39.44,0:13:40.23,Default,,0,0,0,,Марина!
Dialogue: 0,0:13:40.86,0:13:42.11,Default,,0,0,0,,Не? Қазіргісі
Dialogue: 0,0:13:42.19,0:13:44.78,Default,,0,0,0,,Көп сиқырлы сиқырлы тосқауыл бұзылды ма?
Dialogue: 0,0:13:44.86,0:13:45.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:45.99,0:13:47.49,Default,,0,0,0,,Марина!
Dialogue: 0,0:13:47.99,0:13:50.83,Default,,0,0,0,,Жаратқан, ауырғанға шипа бер
Dialogue: 0,0:13:50.91,0:13:51.91,Default,,0,0,0,,Емдеу
Dialogue: 0,0:13:55.29,0:13:56.04,Default,,0,0,0,,(Шинсо) «Мен берілемін», ә… (Изуку) Һм?
Dialogue: 0,0:13:56.12,0:13:57.54,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:13:57.62,0:13:58.54,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:00.88,0:14:02.04,Default,,0,0,0,,Келесің бе?
Dialogue: 0,0:14:02.63,0:14:03.55,Default,,0,0,0,,Қорғау!
Dialogue: 0,0:14:05.38,0:14:06.55,Default,,0,0,0,,Гррр…
Dialogue: 0,0:14:08.26,0:14:11.22,Default,,0,0,0,,Мен көремін. Сиқырлы тосқауыл жойыла ма?
Dialogue: 0,0:14:11.72,0:14:12.43,Default,,0,0,0,,Мұндай уақыт бірлігі қалай?
Dialogue: 0,0:14:14.01,0:14:15.43,Default,,0,0,0,,Жыпылықтау көлеңкесі
Dialogue: 0,0:14:19.14,0:14:20.35,Default,,0,0,0,,Сыни қару
Dialogue: 0,0:14:20.44,0:14:21.61,Default,,0,0,0,,Сиқырлы әулие
Dialogue: 0,0:14:21.69,0:14:22.57,Default,,0,0,0,,Жалынды сызат
Dialogue: 0,0:14:24.65,0:14:25.32,Default,,0,0,0,,Бұл кішкентай вакуумдық торнадоның соңғы әсері!
Dialogue: 0,0:14:27.49,0:14:28.82,Default,,0,0,0,,(Емле)
Dialogue: 0,0:14:28.90,0:14:30.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:30.28,0:14:33.08,Default,,0,0,0,,Бұл қара сиқыр.
Dialogue: 0,0:14:33.91,0:14:37.33,Default,,0,0,0,,Жоқ, бәрі... қашыңдар.
Dialogue: 0,0:14:37.96,0:14:39.83,Default,,0,0,0,,Юк мырза! Қарғыс атқыр...
Dialogue: 0,0:14:39.92,0:14:41.92,Default,,0,0,0,,(Емле)
Dialogue: 0,0:14:43.25,0:14:46.67,Default,,0,0,0,,Ұлы, бізді қорға.
Dialogue: 0,0:14:46.76,0:14:47.92,Default,,0,0,0,,Қасиетті қалқан!
Dialogue: 0,0:14:50.68,0:14:51.93,Default,,0,0,0,,Ағаш рухы
Dialogue: 0,0:14:56.77,0:14:58.81,Default,,0,0,0,,Неліктен? тыныс алмау
Dialogue: 0,0:14:58.89,0:15:01.52,Default,,0,0,0,,Жаңбыр Енді алдыңыздағы жауға шоғырланыңыз...
Dialogue: 0,0:15:01.60,0:15:02.56,Default,,0,0,0,,Кя!
Dialogue: 0,0:15:03.90,0:15:05.23,Default,,0,0,0,,Жібек Жақсысың ба?
Dialogue: 0,0:15:05.32,0:15:06.23,Default,,0,0,0,,Иә
Dialogue: 0,0:15:06.32,0:15:08.44,Default,,0,0,0,,Жаңбыр Әулиені Маринаға сиқырлайды!
Dialogue: 0,0:15:08.53,0:15:12.82,Default,,0,0,0,,Қасиетті нұр, Әділдің, Сиқырлы Әулиенің жүзінде тұр
Dialogue: 0,0:15:12.91,0:15:14.70,Default,,0,0,0,,(Танжиро) Ал, баста! (Үшеуі) Бар күшіңді сал!
Dialogue: 0,0:15:14.78,0:15:16.58,Default,,0,0,0,,Қарғыс атсын! Хмм...
Dialogue: 0,0:15:16.66,0:15:18.08,Default,,0,0,0,,Чокомакато
Dialogue: 0,0:15:18.16,0:15:20.37,Default,,0,0,0,,Егер бұл кең ауқымды сиқыр болса...
Dialogue: 0,0:15:20.46,0:15:21.71,Default,,0,0,0,,Мұзды қиыршық тас
Dialogue: 0,0:15:21.79,0:15:25.71,Default,,0,0,0,,Аспаннан түскен сыпырғыш жұлдыздай, Жауыздарды атып таста.
Dialogue: 0,0:15:25.79,0:15:28.71,Default,,0,0,0,,Төртінші деңгейлі сиқырлы мұз қиыршық тас!
Dialogue: 0,0:15:30.30,0:15:32.30,Default,,0,0,0,,Жоғалып кетті ме? Қайда...
Dialogue: 0,0:15:32.38,0:15:33.22,Default,,0,0,0,,Кя!
Dialogue: 0,0:15:33.30,0:15:35.60,Default,,0,0,0,,Марина! Емдеу сиқыры қазір
Dialogue: 0,0:15:36.10,0:15:36.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:36.81,0:15:38.72,Default,,0,0,0,,Екеуің де! Қарғыс атқыр...
Dialogue: 0,0:15:38.81,0:15:41.56,Default,,0,0,0,,(Емле)
Dialogue: 0,0:15:42.81,0:15:43.90,Default,,0,0,0,,Әлі де солай...
Dialogue: 0,0:15:43.98,0:15:45.65,Default,,0,0,0,,(Емле)
Dialogue: 0,0:15:48.03,0:15:49.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:49.65,0:15:51.49,Default,,0,0,0,,Жарық қалқанының шиыршығы!
Dialogue: 0,0:15:52.49,0:15:53.99,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:15:54.70,0:15:56.62,Default,,0,0,0,,- Мұғалім! -(2 адам) Юк
Dialogue: 0,0:15:56.70,0:15:58.99,Default,,0,0,0,,Жақсысыз ба, сэр?
Dialogue: 0,0:15:59.08,0:16:01.87,Default,,0,0,0,,Досымды ренжіткенің үшін жарайсың.
Dialogue: 0,0:16:02.46,0:16:04.00,Default,,0,0,0,,Мың тұзақ!
Dialogue: 0,0:16:07.09,0:16:10.01,Default,,0,0,0,,Парализ баяу құлдырау соқырлық У тізбегі
Dialogue: 0,0:16:10.80,0:16:11.63,Default,,0,0,0,,Өтінемін, осы екеуін қорға
Dialogue: 0,0:16:12.22,0:16:12.88,Default,,0,0,0,,Гравитация!
Dialogue: 0,0:16:12.97,0:16:14.89,Default,,0,0,0,,Жақсы... Гааааа!
Dialogue: 0,0:16:18.06,0:16:20.35,Default,,0,0,0,,Төртінші деңгейлі рух сиқыры
Dialogue: 0,0:16:23.31,0:16:24.90,Default,,0,0,0,,Айви Мэйден
Dialogue: 0,0:16:24.98,0:16:26.40,Default,,0,0,0,,Сиқырлы қылыштың өзгеруі!
Dialogue: 0,0:16:27.61,0:16:30.03,Default,,0,0,0,,Тааааа!
Dialogue: 0,0:16:30.11,0:16:33.03,Default,,0,0,0,,Мені бейбіт аспанға жетеле
Dialogue: 0,0:16:33.53,0:16:34.53,Default,,0,0,0,,Өлгендерді тазарту (өлмегенге айналдыру)!
Dialogue: 0,0:16:44.33,0:16:45.79,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:16:45.87,0:16:48.17,Default,,0,0,0,,Уф... түсіндім.
Dialogue: 0,0:16:48.25,0:16:49.92,Default,,0,0,0,,В... Аман-есен жүрсең, жақсы.
Dialogue: 0,0:16:50.00,0:16:53.26,Default,,0,0,0,,Юк Марина да сол жастағы қыз.
Dialogue: 0,0:16:53.34,0:16:54.76,Default,,0,0,0,,Үнемі құшақтасып жүру жақсы емес
Dialogue: 0,0:16:54.84,0:16:57.34,Default,,0,0,0,,Эй, эй, мен мұны істеп жатырмын...
Dialogue: 0,0:16:57.43,0:16:58.30,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:16:58.39,0:16:59.68,Default,,0,0,0,,Хаа…
Dialogue: 0,0:16:59.76,0:17:02.60,Default,,0,0,0,,Бірақ мен оның секіретінін ешқашан күтпедім.
Dialogue: 0,0:17:02.68,0:17:05.81,Default,,0,0,0,,Егер Марина мені таппаса, мен таң қалатын едім.
Dialogue: 0,0:17:05.89,0:17:07.69,Default,,0,0,0,,Бұл жай ғана кездейсоқтық
Dialogue: 0,0:17:07.77,0:17:09.90,Default,,0,0,0,,Бірақ рахмет
Dialogue: 0,0:17:10.52,0:17:12.32,Default,,0,0,0,,Жаңбыр Ол қалай болды?
Dialogue: 0,0:17:12.40,0:17:15.49,Default,,0,0,0,,Өлмеген болса да, манағы да тәртіпсіз болды.
Dialogue: 0,0:17:15.57,0:17:17.32,Default,,0,0,0,,Мүмкін бұл дұрыс болмыс емес шығар.
Dialogue: 0,0:17:18.03,0:17:19.16,Default,,0,0,0,,Ақыр соңында?
Dialogue: 0,0:17:19.66,0:17:22.54,Default,,0,0,0,,өту мүмкін емес деп есептелген баспалдақ торы арқылы қабаттар арасында алға-артқа өту.
Dialogue: 0,0:17:22.62,0:17:23.95,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:17:24.91,0:17:25.96,Default,,0,0,0,,Бұл дәл солай...
Dialogue: 0,0:17:26.04,0:17:27.71,Default,,0,0,0,,Толып кеткен сияқты
Dialogue: 0,0:17:27.79,0:17:28.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:30.34,0:17:32.17,Default,,0,0,0,,Мұғалім, біз не істеуіміз керек?
Dialogue: 0,0:17:32.25,0:17:35.42,Default,,0,0,0,,Сіз төменгі қабаттасыз. Алдымен квестті аяқтайық.
Dialogue: 0,0:17:35.51,0:17:37.80,Default,,0,0,0,,Оны тікелей эфирде көрсетуге қалай қарайсыз?
Dialogue: 0,0:17:38.43,0:17:40.68,Default,,0,0,0,,Барлығы хабарландыру алдындағы жабдықты киеді.
Dialogue: 0,0:17:40.76,0:17:43.31,Default,,0,0,0,,Мен клиенттің рұқсатынсыз тікелей трансляциядан аулақ болғым келеді.
Dialogue: 0,0:17:43.81,0:17:45.43,Default,,0,0,0,,Сіз мұны істесеңіз де, бұл ең соңғы шара.
Dialogue: 0,0:17:45.52,0:17:47.23,Default,,0,0,0,,Мен, әрине, түсінемін.
Dialogue: 0,0:17:47.31,0:17:49.31,Default,,0,0,0,,Бұл әлі де біртүрлі.
Dialogue: 0,0:17:49.94,0:17:53.11,Default,,0,0,0,,Квесттен кейін Кварото авантюристі гильдиясына есеп беріңіз.
Dialogue: 0,0:17:53.19,0:17:55.24,Default,,0,0,0,,Тергеу тобын құрайық
Dialogue: 0,0:17:55.32,0:17:58.82,Default,,0,0,0,,Тіпті Арси гильдиясы да зерттеу мақсатында жазбаларды көре алады.
Dialogue: 0,0:17:58.91,0:18:00.37,Default,,0,0,0,,Олардың рұқсат беретініне сенімдімін.
Dialogue: 0,0:18:00.87,0:18:01.83,Default,,0,0,0,,Онда мен Тэцу мен басқаларға, тіпті аздап болса да, қолдау көрсету үшін тезірек барғаным дұрыс
Dialogue: 0,0:18:02.45,0:18:04.08,Default,,0,0,0,,Күте тұрыңыз, Юк.
Dialogue: 0,0:18:06.08,0:18:06.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:06.66,0:18:08.79,Default,,0,0,0,,Жараны сауықтырайық
Dialogue: 0,0:18:08.87,0:18:11.08,Default,,0,0,0,,Бұл асықпау керек уақыт.
Dialogue: 0,0:18:11.17,0:18:12.17,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:18:12.67,0:18:15.09,Default,,0,0,0,,Құдайым, ауырғанға шипа бер
Dialogue: 0,0:18:15.17,0:18:16.59,Default,,0,0,0,,Емдеу
Dialogue: 0,0:18:21.68,0:18:23.85,Default,,0,0,0,,Мен Юктың уайымын түсіндім.
Dialogue: 0,0:18:23.93,0:18:27.60,Default,,0,0,0,,Бірақ біз де толыққанды авантюристпіз.
Dialogue: 0,0:18:28.23,0:18:29.85,Default,,0,0,0,,Дұрыс, кешіріңіз.
Dialogue: 0,0:18:29.94,0:18:32.86,Default,,0,0,0,,Жалғыз алып жүрме, Бұл жақсы емес
Dialogue: 0,0:18:32.94,0:18:33.98,Default,,0,0,0,,Иә
Dialogue: 0,0:18:34.82,0:18:36.11,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:36.19,0:18:38.28,Default,,0,0,0,,Тозуды жеке тексеру
Dialogue: 0,0:18:38.36,0:18:41.11,Default,,0,0,0,,Мен аздап мананы жоғалттым. Жарайды.
Dialogue: 0,0:18:41.20,0:18:43.24,Default,,0,0,0,,Менде де проблема жоқ.
Dialogue: 0,0:18:43.33,0:18:44.49,Default,,0,0,0,,Мен де жақсымын
Dialogue: 0,0:18:45.20,0:18:46.37,Default,,0,0,0,,Менде де проблема жоқ.
Dialogue: 0,0:18:46.87,0:18:48.12,Default,,0,0,0,,Үздіксіз сиқырлы қалпына келтіру (мананы жаңарту)
Dialogue: 0,0:18:51.46,0:18:53.75,Default,,0,0,0,,Иә, рахмет, Юк.
Dialogue: 0,0:18:54.46,0:18:56.30,Default,,0,0,0,,Қалпына келтіру сиқыры Рахмет
Dialogue: 0,0:18:59.34,0:19:01.14,Default,,0,0,0,,Бұл Айон қирандылары лабиринті.
Dialogue: 0,0:19:01.22,0:19:02.51,Default,,0,0,0,,Бұл ең терең.
Dialogue: 0,0:19:03.68,0:19:04.64,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:19:04.72,0:19:07.14,Default,,0,0,0,,Бұл Ау-Дреад тастанды қала лабиринтінің кіреберісі.
Dialogue: 0,0:19:07.22,0:19:09.14,Default,,0,0,0,,-Уау... -Бұл қандай керемет.
Dialogue: 0,0:19:09.81,0:19:13.36,Default,,0,0,0,,Бастапқыда қаланың қараусыз қалған лабиринт жағы адамдар тұратын жер болатын.
Dialogue: 0,0:19:13.44,0:19:15.07,Default,,0,0,0,,Бұл қирандылар дүкендерді жинады.
Dialogue: 0,0:19:15.15,0:19:17.65,Default,,0,0,0,,Бұл ғимарат болуы мүмкін дейді.
Dialogue: 0,0:19:17.73,0:19:19.82,Default,,0,0,0,,Содан кейін, Ав-Дреадтың тереңдігінде
Dialogue: 0,0:19:19.90,0:19:21.11,Default,,0,0,0,,Бізде не бар?
Dialogue: 0,0:19:21.20,0:19:24.74,Default,,0,0,0,,Мұны анықтау авантюрист ретінде біздің міндетіміз.
Dialogue: 0,0:19:25.24,0:19:27.91,Default,,0,0,0,,Бұл зерттелмеген зындандардың бірі.
Dialogue: 0,0:19:28.00,0:19:30.79,Default,,0,0,0,,Олай болса, тіпті сол жердің ең терең жерінде де.
Dialogue: 0,0:19:30.87,0:19:33.08,Default,,0,0,0,,Тұңғиық қақпасы болуы мүмкін.
Dialogue: 0,0:19:33.17,0:19:35.42,Default,,0,0,0,,-(Юк) Мүмкін. -Солай ма?
Dialogue: 0,0:19:35.50,0:19:37.46,Default,,0,0,0,,Иә, Тұңғиық қақпасы
Dialogue: 0,0:19:37.55,0:19:42.30,Default,,0,0,0,,Бұл ежелгі адамдар басқа әлемге саяхаттау үшін пайдаланған жәдігер деген теория бар.
Dialogue: 0,0:19:42.38,0:19:44.68,Default,,0,0,0,,Сондықтан оны көп жерде кездестіруге болады.
Dialogue: 0,0:19:44.76,0:19:47.93,Default,,0,0,0,,Әй, түсіндім! Жаңбыр күткендей
Dialogue: 0,0:19:49.31,0:19:52.94,Default,,0,0,0,,Енді сұрауды аяқтау үшін есікті түртіңіз.
Dialogue: 0,0:20:00.32,0:20:02.57,Default,,0,0,0,,Есеп аяқталды. Баршаңыздың еңбегіңіз үшін рахмет.
Dialogue: 0,0:20:02.65,0:20:05.53,Default,,0,0,0,,Юк ең шаршаған, солай ма?
Dialogue: 0,0:20:05.62,0:20:06.45,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:20:07.03,0:20:09.45,Default,,0,0,0,,Бұндай ештеңе жоқ.
Dialogue: 0,0:20:10.37,0:20:11.37,Default,,0,0,0,,Гильдия ше?
Dialogue: 0,0:20:11.46,0:20:14.25,Default,,0,0,0,,Квестті аяқтаңыз Жазбаны жіберу
Dialogue: 0,0:20:14.75,0:20:17.38,Default,,0,0,0,,Содан кейін мен Shadow Stalker оқиғасы туралы хабарладым.
Dialogue: 0,0:20:17.88,0:20:19.71,Default,,0,0,0,,Сұхбат болуы мүмкін.
Dialogue: 0,0:20:19.80,0:20:22.67,Default,,0,0,0,,Жоспарланғандай, ертең және келесі күні демалыс күндері болады.
Dialogue: 0,0:20:22.76,0:20:23.51,Default,,0,0,0,,Кваротода болыңыз
Dialogue: 0,0:20:23.59,0:20:26.72,Default,,0,0,0,,Келісемін! 4 адаммен кездесуге барайық
Dialogue: 0,0:20:26.80,0:20:28.72,Default,,0,0,0,,Бұл қала маған бейтаныс.
Dialogue: 0,0:20:28.81,0:20:31.14,Default,,0,0,0,,Мұғалім сізге бағыт-бағдар берсе, пайдалы болар еді.
Dialogue: 0,0:20:31.23,0:20:34.52,Default,,0,0,0,,Мен де Юкпен бірге артефактілерді көргім келеді.
Dialogue: 0,0:20:35.19,0:20:36.15,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:20:36.23,0:20:39.32,Default,,0,0,0,,Шақыру болса, төртеуміз баратын шығармыз.
Dialogue: 0,0:20:39.40,0:20:40.94,Default,,0,0,0,,Ертең бәріміз көрікті жерлерге барайық
Dialogue: 0,0:20:41.03,0:20:44.11,Default,,0,0,0,,Сіз мұны істедіңіз! I hope for a delicious restaurant
Dialogue: 0,0:20:44.20,0:20:47.07,Default,,0,0,0,,Мен атақты ботаникалық баққа тоқталғым келеді.
Dialogue: 0,0:20:47.16,0:20:47.87,Default,,0,0,0,,Мен
Dialogue: 0,0:20:47.95,0:20:50.08,Default,,0,0,0,,Мен Артефакт базарына барғым келеді
Dialogue: 0,0:20:50.16,0:20:53.16,Default,,0,0,0,,Барлығын бірден жасау қиын.
Dialogue: 0,0:20:53.25,0:20:56.33,Default,,0,0,0,,Жарайды, тамақ ішіп отырып жоспар құрайық.
Dialogue: 0,0:20:56.42,0:20:59.59,Default,,0,0,0,,Жақын жерде тауық етінен дәмді тағамдар ұсынатын мейрамхана бар.
Dialogue: 0,0:20:59.67,0:21:01.67,Default,,0,0,0,,Жарайсың Юке, сен сондай тапқырсың!
Dialogue: 0,0:21:01.76,0:21:03.97,Default,,0,0,0,,А... маған қалдырыңыз.
Dialogue: 0,0:21:04.05,0:21:06.76,Default,,0,0,0,,Шытырман оқиғадан кейінгі қолдау да менің жұмысым.
Dialogue: 0,0:21:06.84,0:21:07.76,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:21:08.26,0:21:11.31,Default,,0,0,0,,(Марина мен басқалардың күлкісі)
Dialogue: 0,0:21:12.18,0:21:14.69,Default,,0,0,0,,-Енді не болды? -(Юк) Хаха, кеттік.
Dialogue: 0,0:21:16.52,0:21:18.52,Default,,0,0,0,,♪～
Dialogue: 0,0:22:43.94,0:22:45.94,Default,,0,0,0,,～♪
Dialogue: 0,0:22:47.57,0:22:49.53,Default,,0,0,0,,Келесі «Ұлттық сайлауға сұраныс»
Dialogue: 0,0:22:51.03,0:22:57.03,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
