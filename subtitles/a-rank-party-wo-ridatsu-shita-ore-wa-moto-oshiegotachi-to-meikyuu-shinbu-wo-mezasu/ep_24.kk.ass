Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.67,0:00:05.63,Default,,0,0,0,,Юк
Dialogue: 0,0:00:06.38,0:00:08.67,Default,,0,0,0,,Мен шешкім келетін бір нәрсе бар.
Dialogue: 0,0:00:09.17,0:00:09.92,Default,,0,0,0,,Аға?
Dialogue: 0,0:00:10.42,0:00:11.80,Default,,0,0,0,,Бұйрық
Dialogue: 0,0:00:13.13,0:00:18.14,Default,,0,0,0,,Біз Тұңғиық қақпасына жеткенде, біреу оны жабуы керек.
Dialogue: 0,0:00:18.64,0:00:21.06,Default,,0,0,0,,Бірақ мұны жасаған адам...
Dialogue: 0,0:00:21.93,0:00:24.31,Default,,0,0,0,,Сіз қайтып келе алмауыңыз мүмкін.
Dialogue: 0,0:00:25.44,0:00:28.73,Default,,0,0,0,,Сонымен мен 1-ші, ал Юк 2-ші нөмірмін.
Dialogue: 0,0:00:29.23,0:00:30.19,Default,,0,0,0,,Келісесің бе?
Dialogue: 0,0:00:31.32,0:00:32.36,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:00:33.32,0:00:35.20,Default,,0,0,0,,Ал үшінші...
Dialogue: 0,0:00:37.99,0:00:38.53,Default,,0,0,0,,Жүгіру
Dialogue: 0,0:00:39.53,0:00:41.54,Default,,0,0,0,,♪～
Dialogue: 0,0:02:06.91,0:02:08.92,Default,,0,0,0,,～♪
Dialogue: 0,0:02:23.81,0:02:24.89,Default,,0,0,0,,Міне, осында
Dialogue: 0,0:02:24.97,0:02:27.14,Default,,0,0,0,,Үлкен қақпа...
Dialogue: 0,0:02:27.23,0:02:29.73,Default,,0,0,0,,Бұл Тұңғиық қақпасы
Dialogue: 0,0:02:29.81,0:02:31.40,Default,,0,0,0,,дәл осы Пакистан жерінде.
Dialogue: 0,0:02:31.48,0:02:33.15,Default,,0,0,0,,Бұл мөр.
Dialogue: 0,0:02:33.65,0:02:36.11,Default,,0,0,0,,Тұңғиық қақпасын осында ұстау үшін
Dialogue: 0,0:02:36.19,0:02:38.65,Default,,0,0,0,,Мен және Бенвуд оны мөрлеп қойдық.
Dialogue: 0,0:02:39.36,0:02:42.53,Default,,0,0,0,,Әлемнің шеті Басқа әлемге есік
Dialogue: 0,0:02:43.03,0:02:45.08,Default,,0,0,0,,Бұлардың ешқайсысы дұрыс емес.
Dialogue: 0,0:02:45.16,0:02:49.04,Default,,0,0,0,,Бірақ сіз жақсырақ сөз білуіңіз керек.
Dialogue: 0,0:02:50.16,0:02:51.00,Default,,0,0,0,,Таңдау
Dialogue: 0,0:02:51.50,0:02:52.71,Default,,0,0,0,,Иә
Dialogue: 0,0:02:52.79,0:02:56.25,Default,,0,0,0,,Бұл дүние ұзақ уақыт бойы жойылуға ұшырады.
Dialogue: 0,0:02:56.75,0:03:00.18,Default,,0,0,0,,Ағайлар... алдыңғы топ осында келген күннен бері?
Dialogue: 0,0:03:00.26,0:03:02.01,Default,,0,0,0,,Мүмкін одан да ертерек
Dialogue: 0,0:03:02.51,0:03:06.76,Default,,0,0,0,,Лабиринттер әртүрлі жерлерде бақылаудан шығып, үлкен тепкілер жиі орын алды.
Dialogue: 0,0:03:13.27,0:03:14.98,Default,,0,0,0,,Сіздің туған қалаңыз
Dialogue: 0,0:03:15.06,0:03:18.03,Default,,0,0,0,,Бұл дүниеде Тенебра жұтып қойған бірінші орын болды.
Dialogue: 0,0:03:18.90,0:03:20.19,Default,,0,0,0,,Мені сүюге тиіс еді! Мені сүюге тиіс!
Dialogue: 0,0:03:20.28,0:03:23.28,Default,,0,0,0,,Ағам мені жас кезімде құтқарған.
Dialogue: 0,0:03:25.37,0:03:28.20,Default,,0,0,0,,Мен сізден кешірім сұрауым керек.
Dialogue: 0,0:03:28.70,0:03:33.88,Default,,0,0,0,,Мен сені авантюрист болуға жетеледім, енді сені осында қойдым.
Dialogue: 0,0:03:34.63,0:03:36.92,Default,,0,0,0,,Маған күшіңді бер, Юк.
Dialogue: 0,0:03:37.42,0:03:38.80,Default,,0,0,0,,Егер бұл сіз болмасаңыз...
Dialogue: 0,0:03:39.46,0:03:42.22,Default,,0,0,0,,Бір кезде төңкерілген сен болмасаң
Dialogue: 0,0:03:42.30,0:03:43.80,Default,,0,0,0,,Мен оны жеңе алмаймын
Dialogue: 0,0:03:44.51,0:03:45.64,Default,,0,0,0,,Сіз мені жек көре аласыз
Dialogue: 0,0:03:46.14,0:03:48.39,Default,,0,0,0,,Бірақ мұны тек сіз жасай аласыз.
Dialogue: 0,0:03:56.73,0:03:58.07,Default,,0,0,0,,Қараңдар, мырзалар.
Dialogue: 0,0:03:58.15,0:04:00.69,Default,,0,0,0,,Міне, Тұңғиық қақпасының соңы.
Dialogue: 0,0:04:01.28,0:04:03.70,Default,,0,0,0,,Бұл... шынымен бе?
Dialogue: 0,0:04:04.57,0:04:07.78,Default,,0,0,0,,Түсіндім, есіктен кірдің.
Dialogue: 0,0:04:07.87,0:04:09.37,Default,,0,0,0,,Мұнда келді
Dialogue: 0,0:04:09.45,0:04:12.46,Default,,0,0,0,,Бұл таңдаудың өзі ме?
Dialogue: 0,0:04:15.08,0:04:17.25,Default,,0,0,0,,Дұрыс, арамшөптерді жою...
Dialogue: 0,0:04:17.34,0:04:20.51,Default,,0,0,0,,Барлық әлемді байланыстыратын түссіз қараңғылық арқылы
Dialogue: 0,0:04:20.59,0:04:22.76,Default,,0,0,0,,Біздің әлемге келген тағы бір әлем
Dialogue: 0,0:04:23.72,0:04:26.09,Default,,0,0,0,,Бұл ұғымдар жинағы.
Dialogue: 0,0:04:29.35,0:04:31.72,Default,,0,0,0,,Қалай болғанда да, бұл жау, солай ма?
Dialogue: 0,0:04:31.81,0:04:33.77,Default,,0,0,0,,Достыққа ұқсамайды.
Dialogue: 0,0:04:33.85,0:04:36.52,Default,,0,0,0,,Артымыздан жүгіріңіз
Dialogue: 0,0:04:36.60,0:04:37.15,Default,,0,0,0,,Иә
Dialogue: 0,0:04:37.23,0:04:40.02,Default,,0,0,0,,Дененің шегінен асатын қуат
Dialogue: 0,0:04:40.11,0:04:41.53,Default,,0,0,0,,Физикалық сиқырлау
Dialogue: 0,0:04:41.61,0:04:43.15,Default,,0,0,0,,Мананы жаңарту
Dialogue: 0,0:04:58.84,0:04:59.75,Default,,0,0,0,,Қандай әйелдер ұнайды саған?
Dialogue: 0,0:05:00.25,0:05:02.76,Default,,0,0,0,,Қатерлі, арам
Dialogue: 0,0:05:03.42,0:05:06.34,Default,,0,0,0,,Олар термиттер сияқты, дүниені жеп жатыр.
Dialogue: 0,0:05:06.84,0:05:08.01,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:05:09.93,0:05:11.26,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:05:11.35,0:05:13.60,Default,,0,0,0,,Клевердің жауынгерлік әзірлігі
Dialogue: 0,0:05:13.68,0:05:16.31,Default,,0,0,0,,Жаңбыр Джейми Кең аумақты сиқырмен басқарыңыз
Dialogue: 0,0:05:16.39,0:05:18.15,Default,,0,0,0,,-Иә - (Джейми) Түсіндім.
Dialogue: 0,0:05:18.23,0:05:22.65,Default,,0,0,0,,Қар ханшайымы басқаратын мұзбен жабылған тыйым салынған аймақ
Dialogue: 0,0:05:22.73,0:05:26.65,Default,,0,0,0,,Жер-Ана, ежелден асқақтаған киелі тау.
Dialogue: 0,0:05:26.74,0:05:29.20,Default,,0,0,0,,Жібек Ұстамдылық пен ұстамдылықты сұраңыз
Dialogue: 0,0:05:29.28,0:05:29.78,Default,,0,0,0,,Иә
Dialogue: 0,0:05:29.87,0:05:31.74,Default,,0,0,0,,-(Юк) Нене партизан шабуылы -ссу!
Dialogue: 0,0:05:31.83,0:05:34.04,Default,,0,0,0,,Марина, уақытты қарап, ішке кір.
Dialogue: 0,0:05:34.12,0:05:35.00,Default,,0,0,0,,Жаңалықтар «Батырлар өлтіруші» туралы әңгімеге толы болды
Dialogue: 0,0:05:35.08,0:05:36.79,Default,,0,0,0,,- (Дастан) Мен ше? -(Юк) А?
Dialogue: 0,0:05:36.87,0:05:38.92,Default,,0,0,0,,Хахаха, әзілдеп тұрмын
Dialogue: 0,0:05:39.00,0:05:41.25,Default,,0,0,0,,Мен өзіме ұнайтын нәрсені істеймін.
Dialogue: 0,0:05:41.34,0:05:43.30,Default,,0,0,0,,Оны Юкке қалдырыңыз.
Dialogue: 0,0:05:43.38,0:05:46.26,Default,,0,0,0,,Көрдіңіз бе? Онымен тек Юк айналыса алады.
Dialogue: 0,0:05:46.34,0:05:48.68,Default,,0,0,0,,Қатқан жұлдыздың астында, боран
Dialogue: 0,0:05:48.76,0:05:51.26,Default,,0,0,0,,Бесінші деңгейлі сиқырлы мұзды боран!
Dialogue: 0,0:05:53.77,0:05:55.77,Default,,0,0,0,,Дауыл сияқты жартас
Dialogue: 0,0:05:56.27,0:05:58.69,Default,,0,0,0,,Бесінші деңгейдегі сиқырлы Рок дауыл!
Dialogue: 0,0:06:03.90,0:06:05.07,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:05.65,0:06:06.94,Default,,0,0,0,,Қиын... шығарылым
Dialogue: 0,0:06:07.03,0:06:07.95,Default,,0,0,0,,Уф!
Dialogue: 0,0:06:09.03,0:06:09.70,Default,,0,0,0,,Тұзақ
Dialogue: 0,0:06:11.28,0:06:11.82,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,0:06:11.91,0:06:12.95,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:13.79,0:06:16.66,Default,,0,0,0,,Егер сіз оны брондалған жауынгер деп ойласаңыз, сіз жасай алатын нәрсе бар.
Dialogue: 0,0:06:17.41,0:06:19.50,Default,,0,0,0,,Сиқырлы қылыштың өзгеруі!
Dialogue: 0,0:06:20.29,0:06:21.71,Default,,0,0,0,,Сіз мұны итермелей аласыз ба?
Dialogue: 0,0:06:21.79,0:06:23.46,Default,,0,0,0,,Қауіпті! Ахх...
Dialogue: 0,0:06:24.05,0:06:24.59,Default,,0,0,0,,Жібек!
Dialogue: 0,0:06:25.84,0:06:29.13,Default,,0,0,0,,Эй... жақсысың ба? Юк мырза
Dialogue: 0,0:06:29.22,0:06:29.72,Default,,0,0,0,,Суретке түсіріп алсам болар еді
Dialogue: 0,0:06:30.72,0:06:31.47,Default,,0,0,0,,Жібек!
Dialogue: 0,0:06:31.55,0:06:34.51,Default,,0,0,0,,Библион маған айтып берді.
Dialogue: 0,0:06:35.22,0:06:37.98,Default,,0,0,0,,Айдаһардан көрінбейтін шабуыл келгенде
Dialogue: 0,0:06:41.31,0:06:44.90,Default,,0,0,0,,Түсіндім Рахмет сізге Silk Biblion
Dialogue: 0,0:06:44.98,0:06:47.24,Default,,0,0,0,,Емдеу Жібекті жалғыз қалдырыңыз
Dialogue: 0,0:06:47.94,0:06:51.82,Default,,0,0,0,,Құдайым, ауырғанға шипа бер.
Dialogue: 0,0:06:52.87,0:06:54.28,Default,,0,0,0,,Жаңбыр, қалай?
Dialogue: 0,0:06:54.78,0:06:56.29,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:06:56.91,0:06:59.54,Default,,0,0,0,,Физикалық күш емес
Dialogue: 0,0:06:59.62,0:07:02.46,Default,,0,0,0,,Менің ойымша, бұл тұжырымдама шығар.
Dialogue: 0,0:07:02.54,0:07:03.38,Default,,0,0,0,,Тұжырымдама?
Dialogue: 0,0:07:03.46,0:07:05.50,Default,,0,0,0,,Бірақ бәрібір, оны емдеуге болады.
Dialogue: 0,0:07:09.34,0:07:11.13,Default,,0,0,0,,Оу! Екінші оқ сәл қалды!
Dialogue: 0,0:07:11.22,0:07:12.64,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:13.30,0:07:15.39,Default,,0,0,0,,Yuk Бұл басылған
Dialogue: 0,0:07:15.47,0:07:16.89,Default,,0,0,0,,Бұған сіз жауаптысыз!
Dialogue: 0,0:07:18.35,0:07:19.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:19.10,0:07:20.27,Default,,0,0,0,,- (Нибельн) Мен саған рұқсат бермеймін - (Джейми) Қаш!
Dialogue: 0,0:07:22.02,0:07:22.90,Default,,0,0,0,,Тілек!
Dialogue: 0,0:07:24.98,0:07:27.94,Default,,0,0,0,,Сиқыр? Жоқ, тілектердің күші
Dialogue: 0,0:07:28.03,0:07:29.40,Default,,0,0,0,,Үлкен аға, маған қалдырыңыз
Dialogue: 0,0:07:29.49,0:07:30.90,Default,,0,0,0,,Жүгіру бірдеңе жасайды
Dialogue: 0,0:07:31.40,0:07:33.66,Default,,0,0,0,,Тіпті жүгіру барлығына пайдалы болуы мүмкін.
Dialogue: 0,0:07:33.74,0:07:35.78,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:07:35.87,0:07:37.79,Default,,0,0,0,,Мен де қазір жақсымын.
Dialogue: 0,0:07:37.87,0:07:39.87,Default,,0,0,0,,Юк, мұны маған қалдыр.
Dialogue: 0,0:07:39.95,0:07:41.29,Default,,0,0,0,,Мен сені ешқашан жібермеймін.
Dialogue: 0,0:07:41.37,0:07:43.54,Default,,0,0,0,,Орындаңыз
Dialogue: 0,0:07:44.63,0:07:47.96,Default,,0,0,0,,Жарайсың, мен сенімен біргемін.
Dialogue: 0,0:07:48.05,0:07:49.13,Default,,0,0,0,,Мүмкін жай ғана жеп-ішіп, сәл шу шығарамыз да, сонымен бітті. (Миямура) Кешір.
Dialogue: 0,0:07:52.18,0:07:52.97,Default,,0,0,0,,Тілек!
Dialogue: 0,0:07:54.30,0:07:56.05,Default,,0,0,0,,Шіріген раушан гүлдерінің иісі
Dialogue: 0,0:08:01.35,0:08:02.52,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:08:02.60,0:08:03.52,Default,,0,0,0,,Жүгіру!
Dialogue: 0,0:08:03.60,0:08:07.15,Default,,0,0,0,,Теңіз батып бара жатқан күнді жұтып жатқанда, қара иттің ұлыған үні жаңғырады
Dialogue: 0,0:08:10.07,0:08:10.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:12.40,0:08:13.20,Default,,0,0,0,,Юк!
Dialogue: 0,0:08:14.16,0:08:15.57,Default,,0,0,0,,Жарық қалқаны!
Dialogue: 0,0:08:15.66,0:08:19.83,Default,,0,0,0,,Ақ пен қара араласып, жан дүниенің құйынында жоғалады.
Dialogue: 0,0:08:22.83,0:08:24.58,Default,,0,0,0,,Жарайсың Юк
Dialogue: 0,0:08:25.08,0:08:26.46,Default,,0,0,0,,Бұл біздің жеңісіміз.
Dialogue: 0,0:08:26.54,0:08:29.21,Default,,0,0,0,,Сіз жасай аласыз, бәрібір.
Dialogue: 0,0:08:29.30,0:08:30.50,Default,,0,0,0,,Гррр…
Dialogue: 0,0:08:33.05,0:08:35.30,Default,,0,0,0,,Ал, 5-деңгейдегі сиқыр
Dialogue: 0,0:08:35.38,0:08:37.14,Default,,0,0,0,,Ахх!
Dialogue: 0,0:08:37.64,0:08:38.47,Default,,0,0,0,,Әй!
Dialogue: 0,0:08:39.64,0:08:42.31,Default,,0,0,0,,Бұрмаланған жарқыраған жебе (призмалық ракета)!
Dialogue: 0,0:08:46.31,0:08:50.07,Default,,0,0,0,,Олардан алыс бол~!
Dialogue: 0,0:08:59.95,0:09:02.54,Default,,0,0,0,,Пайдасы жоқ, бәрі қарғыс...
Dialogue: 0,0:09:03.16,0:09:05.37,Default,,0,0,0,,Призмалық зымырандармен ластанған
Dialogue: 0,0:09:06.00,0:09:08.58,Default,,0,0,0,,Нашар тіршілік иесінің дүниеге келген сәті...
Dialogue: 0,0:09:10.13,0:09:10.63,Default,,0,0,0,,Өл
Dialogue: 0,0:09:20.26,0:09:21.93,Default,,0,0,0,,Шайқас аяқталды.
Dialogue: 0,0:09:22.43,0:09:24.64,Default,,0,0,0,,Ол ештеңе білмесе де, оны әлі де кепілге алуға болады
Dialogue: 0,0:09:29.73,0:09:32.82,Default,,0,0,0,,Шәкірт ретінде менің... құдіретім.
Dialogue: 0,0:09:33.32,0:09:35.65,Default,,0,0,0,,Сіз білесіз бе? Арамшөптерді кетіру.
Dialogue: 0,0:09:35.74,0:09:37.28,Default,,0,0,0,,Саға аға!
Dialogue: 0,0:09:38.45,0:09:40.28,Default,,0,0,0,,Жылама Юк
Dialogue: 0,0:09:40.37,0:09:42.83,Default,,0,0,0,,Достарыңызды қобалжытпаңыз
Dialogue: 0,0:09:43.33,0:09:45.79,Default,,0,0,0,,Сіз батырсыз
Dialogue: 0,0:09:46.54,0:09:48.37,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз
Dialogue: 0,0:09:49.08,0:09:53.30,Default,,0,0,0,,Кешіріңіз, бірақ мен әрлеуді жасауым керек.
Dialogue: 0,0:09:54.26,0:09:55.30,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:10:12.19,0:10:14.90,Default,,0,0,0,,Бәріңіз, бұл Тұңғиық қақпасы.
Dialogue: 0,0:10:15.40,0:10:17.36,Default,,0,0,0,,Өте әдемі
Dialogue: 0,0:10:17.45,0:10:19.66,Default,,0,0,0,,Бұл орындалған арман.
Dialogue: 0,0:10:19.74,0:10:20.95,Default,,0,0,0,,Құттықтаймыз
Dialogue: 0,0:10:21.62,0:10:23.95,Default,,0,0,0,,Рахмет, бәрі бәріңіздің арқаңызда.
Dialogue: 0,0:10:24.45,0:10:28.08,Default,,0,0,0,,Мынау басқа әлемде көріп тұрсың ба?
Dialogue: 0,0:10:28.16,0:10:31.00,Default,,0,0,0,,Бұл басқа әлем.
Dialogue: 0,0:10:31.50,0:10:33.42,Default,,0,0,0,,Басқа да сансыз дүниелер бар.
Dialogue: 0,0:10:33.92,0:10:36.76,Default,,0,0,0,,Юктың көргісі келгені осы ма?
Dialogue: 0,0:10:36.84,0:10:38.38,Default,,0,0,0,,Мүмкін сіз аздап түсінетін шығарсыз.
Dialogue: 0,0:10:38.47,0:10:40.72,Default,,0,0,0,,- (Джейми) Не Ран - (Нибельн) Иә
Dialogue: 0,0:10:41.34,0:10:43.72,Default,,0,0,0,,Кловер Мақсатқа қол жеткізілді
Dialogue: 0,0:10:44.81,0:10:45.47,Default,,0,0,0,,О...
Dialogue: 0,0:10:57.15,0:10:58.44,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:10:58.53,0:11:01.20,Default,,0,0,0,,Мен ағам тапсырған тазалықты жасауым керек.
Dialogue: 0,0:11:01.70,0:11:03.57,Default,,0,0,0,,Тұңғиық қақпасын жабыңыз
Dialogue: 0,0:11:06.70,0:11:08.75,Default,,0,0,0,,Сіз қалай ойлайсыз? Жабылуы мүмкін бе?
Dialogue: 0,0:11:09.25,0:11:11.08,Default,,0,0,0,,Оны жабуға болатын сияқты.
Dialogue: 0,0:11:11.17,0:11:12.79,Default,,0,0,0,,Жақсы
Dialogue: 0,0:11:12.88,0:11:15.54,Default,,0,0,0,,Бұл Тенебраны әртүрлі жерлерде жояды.
Dialogue: 0,0:11:15.63,0:11:17.55,Default,,0,0,0,,Бұл қазірге дейін жойылуы керек.
Dialogue: 0,0:11:18.17,0:11:21.30,Default,,0,0,0,,Мен жоғарыда айтқан айдаһар өзін өлтіріп жатыр.
Dialogue: 0,0:11:21.38,0:11:24.35,Default,,0,0,0,,Сонда әлем қазір қауіпсіз.
Dialogue: 0,0:11:24.43,0:11:28.06,Default,,0,0,0,,Бұндай нәрсе, егер сіз оны дұрыс жапсаңыз.
Dialogue: 0,0:11:28.14,0:11:30.94,Default,,0,0,0,,Сонымен? Оны қалай жабамын?
Dialogue: 0,0:11:32.14,0:11:33.69,Default,,0,0,0,,Екінші жағына өтіп, оны жабыңыз.
Dialogue: 0,0:11:33.77,0:11:35.69,Default,,0,0,0,,- Юк! -Мырза. Юк!
Dialogue: 0,0:11:35.77,0:11:36.77,Default,,0,0,0,,Юк?
Dialogue: 0,0:11:36.86,0:11:38.19,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:11:40.44,0:11:43.28,Default,,0,0,0,,Енді осы Шығу шиыршығында
Dialogue: 0,0:11:43.36,0:11:44.82,Default,,0,0,0,,Сізді жерге жібереді
Dialogue: 0,0:11:44.91,0:11:47.83,Default,,0,0,0,,Солай ма? Одан бас тарт, Юк.
Dialogue: 0,0:11:47.91,0:11:51.16,Default,,0,0,0,,Кешіріңіз, Джейми, мен шешіп қойғанмын.
Dialogue: 0,0:11:51.66,0:11:53.08,Default,,0,0,0,,Мен Тұңғиық қақпасын жабамын
Dialogue: 0,0:11:53.17,0:11:55.88,Default,,0,0,0,,Бұл не, Юк қалады деген сөз бе?
Dialogue: 0,0:11:55.96,0:11:56.71,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:11:56.79,0:11:59.46,Default,,0,0,0,,Юк үйге бару шытырман оқиға екенін айтқан жоқ.
Dialogue: 0,0:11:59.55,0:12:01.55,Default,,0,0,0,,Марина дұрыс айтады.
Dialogue: 0,0:12:01.63,0:12:04.72,Default,,0,0,0,,Бірақ бұл жолы олай болмайды.
Dialogue: 0,0:12:04.80,0:12:07.22,Default,,0,0,0,,Бұл Тұңғиық қақпасын жабудың жалғыз жолы
Dialogue: 0,0:12:07.30,0:12:09.14,Default,,0,0,0,,Бұл сиқырлы құрал (артефакт)
Dialogue: 0,0:12:09.22,0:12:11.98,Default,,0,0,0,,Оны тек екінші жағынан жабуға болатын сияқты.
Dialogue: 0,0:12:12.06,0:12:16.06,Default,,0,0,0,,Юке мырза, бәріміз бірге баруымыз керек емес пе?
Dialogue: 0,0:12:16.15,0:12:16.98,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:12:17.06,0:12:18.98,Default,,0,0,0,,Exit қолданбасын пайдалансаңыз... айналдыруы
Dialogue: 0,0:12:19.07,0:12:20.19,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:12:20.28,0:12:23.61,Default,,0,0,0,,Біз қандай әлемге бет алып бара жатырмыз? Біз аман қала аламыз ба?
Dialogue: 0,0:12:23.70,0:12:26.99,Default,,0,0,0,,Мен адам болу концепциясын сақтай алатынымды да білмеймін.
Dialogue: 0,0:12:27.07,0:12:29.37,Default,,0,0,0,,Мен бұрынғы айдаһар сияқты болуым мүмкін.
Dialogue: 0,0:12:29.45,0:12:31.87,Default,,0,0,0,,Сіз бізді артта қалдырасыз ба?
Dialogue: 0,0:12:31.95,0:12:34.17,Default,,0,0,0,,А... шынымен емес.
Dialogue: 0,0:12:34.67,0:12:37.38,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:12:39.21,0:12:42.13,Default,,0,0,0,,Жарайды...онда оны ашық қалдырыңыз.
Dialogue: 0,0:12:42.21,0:12:44.51,Default,,0,0,0,,Қарсы шараларды ойлап тапқаннан кейін қайта оралуымыз керек емес пе?
Dialogue: 0,0:12:44.59,0:12:46.30,Default,,0,0,0,,Марина дұрыс айтады.
Dialogue: 0,0:12:46.39,0:12:48.68,Default,,0,0,0,,Шешімі бар екеніне сенімдімін.
Dialogue: 0,0:12:48.76,0:12:51.77,Default,,0,0,0,,Айдаһар жеңілді, ал бізде уақыт бар...
Dialogue: 0,0:12:51.85,0:12:56.85,Default,,0,0,0,,Саға аға 10 жылдан астам уақыт бойы оның шешімін іздеді.
Dialogue: 0,0:12:56.94,0:13:01.15,Default,,0,0,0,,Ойланып, сіз мені пайдалану туралы шешім қабылдадыңыз.
Dialogue: 0,0:13:01.65,0:13:04.03,Default,,0,0,0,,Мен бұған да жақсы болдым.
Dialogue: 0,0:13:04.11,0:13:08.28,Default,,0,0,0,,Келесі таңдауды жеңе алатыныңызға кепілдік жоқ.
Dialogue: 0,0:13:09.07,0:13:10.12,Default,,0,0,0,,Түсініңіз
Dialogue: 0,0:13:10.66,0:13:12.45,Default,,0,0,0,,Мен сізге еремін
Dialogue: 0,0:13:13.29,0:13:15.16,Default,,0,0,0,,Жоқ, мен сені өзіммен бірге ала алмаймын.
Dialogue: 0,0:13:15.25,0:13:16.83,Default,,0,0,0,,Менің өзімшілдігім...
Dialogue: 0,0:13:16.92,0:13:19.29,Default,,0,0,0,,Әлемді құтқаруды қалау - бұл бос сөз
Dialogue: 0,0:13:20.17,0:13:21.80,Default,,0,0,0,,Мен сені жоғалтқым келмейді
Dialogue: 0,0:13:22.38,0:13:25.59,Default,,0,0,0,,Осылай айтсаң, жылайтын сияқтысың.
Dialogue: 0,0:13:25.67,0:13:27.68,Default,,0,0,0,,Юкті жалғыз қалдырмаңыз
Dialogue: 0,0:13:27.76,0:13:29.68,Default,,0,0,0,,Өйткені бұл менің өмір жолым
Dialogue: 0,0:13:30.35,0:13:32.10,Default,,0,0,0,,Мен үшін де солай.
Dialogue: 0,0:13:32.18,0:13:34.68,Default,,0,0,0,,Юкемен кез келген жерге бара алатыныңызға сенімдімін.
Dialogue: 0,0:13:35.27,0:13:36.94,Default,,0,0,0,,Мен де сенімен бірге боламын.
Dialogue: 0,0:13:37.02,0:13:40.94,Default,,0,0,0,,Өлсең де жалғыз жібермеймін.
Dialogue: 0,0:13:41.52,0:13:43.61,Default,,0,0,0,,Әрине мен де барамын.
Dialogue: 0,0:13:43.69,0:13:46.20,Default,,0,0,0,,Маған орын берген Юк мырза болды.
Dialogue: 0,0:13:46.82,0:13:48.99,Default,,0,0,0,,Сен шынымен ақымақсың.
Dialogue: 0,0:13:49.07,0:13:51.95,Default,,0,0,0,,Егер үлес қосқыңыз келсе, соңына дейін жауапкершілікті алыңыз.
Dialogue: 0,0:13:52.66,0:13:56.58,Default,,0,0,0,,үшінңызға рахмет, мен бақытты адаммын.
Dialogue: 0,0:13:57.08,0:13:58.75,Default,,0,0,0,,Сондықтан мен сені өзіммен бірге ала алмаймын.
Dialogue: 0,0:13:58.83,0:14:00.04,Default,,0,0,0,,Балалар...
Dialogue: 0,0:14:00.13,0:14:03.46,Default,,0,0,0,,Өйткені сен бұл дүниеде бәрінен де маңыздысың
Dialogue: 0,0:14:04.05,0:14:06.34,Default,,0,0,0,,Іске қосу! Шығу айналдыру
Dialogue: 0,0:14:07.80,0:14:08.59,Default,,0,0,0,,Юк!
Dialogue: 0,0:14:09.18,0:14:10.97,Default,,0,0,0,,- Юк мырза! - (Джемми) Тоқта!
Dialogue: 0,0:14:11.85,0:14:12.93,Default,,0,0,0,,Тілек
Dialogue: 0,0:14:19.02,0:14:20.86,Default,,0,0,0,,Кловердегілердің бәрі жоғалып кетті.
Dialogue: 0,0:14:20.94,0:14:22.86,Default,,0,0,0,,- (Адам) Не болды? -(Адам) Қайда бардың?
Dialogue: 0,0:14:24.11,0:14:27.03,Default,,0,0,0,,Балалар сыртқа дұрыс келді ме?
Dialogue: 0,0:14:27.11,0:14:28.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:28.45,0:14:29.49,Default,,0,0,0,,Жүгіру!
Dialogue: 0,0:14:29.57,0:14:30.45,Default,,0,0,0,,- (Әйел) Бұл беде - (Еркек) Сен амансың.
Dialogue: 0,0:14:30.53,0:14:31.62,Default,,0,0,0,,Неге мұндасың?
Dialogue: 0,0:14:31.70,0:14:34.08,Default,,0,0,0,,Біреу авантюрист гильдиясына хабарлауын өтінемін!
Dialogue: 0,0:14:34.16,0:14:36.16,Default,,0,0,0,,Үлкен аға мен әпке
Dialogue: 0,0:14:36.25,0:14:39.21,Default,,0,0,0,,үшін Финиске оралуы үшін.
Dialogue: 0,0:14:39.29,0:14:40.83,Default,,0,0,0,,Мен мұны сұрадым
Dialogue: 0,0:14:40.92,0:14:42.42,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:14:42.50,0:14:45.46,Default,,0,0,0,,Өйткені, Ранның шын жүректен қалағаны осы еді.
Dialogue: 0,0:14:46.05,0:14:47.97,Default,,0,0,0,,Жоқ... жүгір!
Dialogue: 0,0:14:48.05,0:14:51.01,Default,,0,0,0,,Жоқ... Жүгір, бұл дұрыс емес.
Dialogue: 0,0:14:51.09,0:14:53.18,Default,,0,0,0,,Бұл менмін! Менің кезегім!
Dialogue: 0,0:14:53.26,0:14:53.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:53.89,0:14:56.47,Default,,0,0,0,,Тенебраға кірер алдында шешім қабылдау керек еді.
Dialogue: 0,0:14:56.56,0:14:57.64,Default,,0,0,0,,Иә
Dialogue: 0,0:14:57.73,0:15:02.02,Default,,0,0,0,,Жүгіру соңғы болуы керек еді, бірақ мен оны ретсіз қалдырдым.
Dialogue: 0,0:15:02.10,0:15:02.98,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:03.06,0:15:06.36,Default,,0,0,0,,Өйткені жүгіру де бәрін жақсы көреді.
Dialogue: 0,0:15:06.44,0:15:08.61,Default,,0,0,0,,Жоқ, жүгір, тоқта!
Dialogue: 0,0:15:08.69,0:15:11.99,Default,,0,0,0,,Мен сенің бақытыңа уәде бердім!
Dialogue: 0,0:15:12.07,0:15:13.53,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:15:13.62,0:15:17.04,Default,,0,0,0,,Бірақ бұл жүгіру үшін бақыт.
Dialogue: 0,0:15:17.12,0:15:19.00,Default,,0,0,0,,Үлкен аға мен әпке
Dialogue: 0,0:15:19.08,0:15:20.91,Default,,0,0,0,,Мәңгілік бақытты болыңыз
Dialogue: 0,0:15:21.00,0:15:22.88,Default,,0,0,0,,Бөлінуге болмайды
Dialogue: 0,0:15:22.96,0:15:24.50,Default,,0,0,0,,Ран осыны қалайды.
Dialogue: 0,0:15:24.59,0:15:26.13,Default,,0,0,0,,Run-chan, күте тұрыңыз.
Dialogue: 0,0:15:26.21,0:15:28.59,Default,,0,0,0,,Біз сонда тағы барамыз!
Dialogue: 0,0:15:28.67,0:15:31.76,Default,,0,0,0,,Мұны істеме! Мен сізге кейінірек уағыз айтамын!
Dialogue: 0,0:15:32.64,0:15:36.01,Default,,0,0,0,,Рахмет Марина Они-чан Жібек Они-чан
Dialogue: 0,0:15:36.10,0:15:38.10,Default,,0,0,0,,Бірақ бұл ең жақсысы
Dialogue: 0,0:15:38.18,0:15:40.77,Default,,0,0,0,,Лун бар болса, жоюдың тамыры артта қалады.
Dialogue: 0,0:15:40.85,0:15:43.98,Default,,0,0,0,,Юк-сан сізге көмектесе алады.
Dialogue: 0,0:15:44.06,0:15:46.15,Default,,0,0,0,,Нене-ни-чанға да рахмет
Dialogue: 0,0:15:46.23,0:15:48.53,Default,,0,0,0,,Бірге шомылу қызық болды.
Dialogue: 0,0:15:48.61,0:15:52.36,Default,,0,0,0,,Сіз әлі ойын-сауық саябағына барған жоқсыз.
Dialogue: 0,0:15:52.45,0:15:56.53,Default,,0,0,0,,Ғылмас пен Мамаруға менімен бірге барамын деп уәде бердің.
Dialogue: 0,0:15:56.62,0:15:57.70,Default,,0,0,0,,Иә
Dialogue: 0,0:15:57.79,0:16:01.37,Default,,0,0,0,,Мен Джеймимен бірге ойын-сауық саябағына барғым келді.
Dialogue: 0,0:16:01.46,0:16:03.29,Default,,0,0,0,,Ол қандай жер еді?
Dialogue: 0,0:16:03.37,0:16:05.75,Default,,0,0,0,,Иә! Сонымен...
Dialogue: 0,0:16:06.25,0:16:08.92,Default,,0,0,0,,Бізбен бірге...
Dialogue: 0,0:16:09.00,0:16:11.09,Default,,0,0,0,,Жарайды, Рейн-ничан.
Dialogue: 0,0:16:11.17,0:16:14.43,Default,,0,0,0,,Бұл жеткілікті. Бұл шынымен көңілді болды.
Dialogue: 0,0:16:15.05,0:16:18.85,Default,,0,0,0,,Әй, бірақ мен қайта туғанда жазушы болғым келеді.
Dialogue: 0,0:16:18.93,0:16:22.18,Default,,0,0,0,,Көптеген шытырман оқиғаларға тап болыңыз және көптеген әңгімелер жазыңыз.
Dialogue: 0,0:16:22.27,0:16:25.06,Default,,0,0,0,,Көп адамды толғандырады
Dialogue: 0,0:16:25.15,0:16:28.69,Default,,0,0,0,,Ал кітап шыққанда қол қойдым.
Dialogue: 0,0:16:28.77,0:16:30.82,Default,,0,0,0,,Хехе, бұл керемет емес пе?
Dialogue: 0,0:16:31.90,0:16:34.20,Default,,0,0,0,,Иә, бұл жақсы идея.
Dialogue: 0,0:16:34.28,0:16:36.20,Default,,0,0,0,,Хехе, солай ма?
Dialogue: 0,0:16:36.95,0:16:39.20,Default,,0,0,0,,Олай болса мен кетейін.
Dialogue: 0,0:16:41.54,0:16:42.71,Default,,0,0,0,,Жүгіру!
Dialogue: 0,0:16:43.83,0:16:46.04,Default,,0,0,0,,Онии-чан және үлкен апалар
Dialogue: 0,0:16:46.13,0:16:48.67,Default,,0,0,0,,Сізге көп рахмет...
Dialogue: 0,0:16:48.75,0:16:50.55,Default,,0,0,0,,Жүгіру бақытты болды!
Dialogue: 0,0:16:57.55,0:16:58.39,Default,,0,0,0,,Іске қосу…
Dialogue: 0,0:16:58.47,0:17:00.39,Default,,0,0,0,,-(Камерат-кун) Келді~ -(Селфи-чан) Ұяшық
Dialogue: 0,0:17:00.47,0:17:01.10,Default,,0,0,0,,Келді ме?
Dialogue: 0,0:17:01.18,0:17:03.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:03.52,0:17:06.23,Default,,0,0,0,,...
Dialogue: 0,0:17:06.31,0:17:08.61,Default,,0,0,0,,Бұндай ештеңе жоқ.
Dialogue: 0,0:17:08.69,0:17:11.86,Default,,0,0,0,,Ал егер бала...
Dialogue: 0,0:17:11.94,0:17:14.36,Default,,0,0,0,,Неге, жүгіру?
Dialogue: 0,0:17:15.20,0:17:19.37,Default,,0,0,0,,(Марина және басқалардың айқайы)
Dialogue: 0,0:17:20.49,0:17:21.58,Default,,0,0,0,,Ах! Құдай-ай!
Dialogue: 0,0:17:21.66,0:17:24.79,Default,,0,0,0,,Иә, бұл жақсы емес.
Dialogue: 0,0:17:25.29,0:17:27.67,Default,,0,0,0,,Юк алға қара
Dialogue: 0,0:17:27.75,0:17:28.38,Default,,0,0,0,,Жаңбыр?
Dialogue: 0,0:17:28.46,0:17:31.38,Default,,0,0,0,,Лун жыламады, күлді.
Dialogue: 0,0:17:31.46,0:17:36.26,Default,,0,0,0,,Бізге өз еркіңізбен, ерік-жігеріңізбен көмектестіңіз.
Dialogue: 0,0:17:36.34,0:17:39.14,Default,,0,0,0,,Сондықтан біз жауап беруіміз керек
Dialogue: 0,0:17:39.22,0:17:42.93,Default,,0,0,0,,Мен Ранның үміті мен тілегін орындауым керек.
Dialogue: 0,0:17:43.56,0:17:45.77,Default,,0,0,0,,Ах, дұрыс.
Dialogue: 0,0:17:51.27,0:17:52.07,Default,,0,0,0,,Жүгіру
Dialogue: 0,0:17:57.61,0:17:59.32,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:18:00.49,0:18:01.70,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:01.78,0:18:04.29,Default,,0,0,0,,Юк мырза, мен сізге шай әкелдім.
Dialogue: 0,0:18:04.79,0:18:06.46,Default,,0,0,0,,Рахмет саған Жібек
Dialogue: 0,0:18:07.92,0:18:10.21,Default,,0,0,0,,Сіз не жаздыңыз?
Dialogue: 0,0:18:10.29,0:18:12.75,Default,,0,0,0,,Менің ойымша, бұл күнделік сияқты.
Dialogue: 0,0:18:12.84,0:18:16.97,Default,,0,0,0,,Құйын ай болды...
Dialogue: 0,0:18:17.05,0:18:19.51,Default,,0,0,0,,Мен есте сақтауды сәл реттеймін деп ойладым.
Dialogue: 0,0:18:19.59,0:18:22.81,Default,,0,0,0,,Иә, бұл нағыз дүрбелең болды.
Dialogue: 0,0:18:22.89,0:18:24.72,Default,,0,0,0,,Түссіз қараңғылықтан қайтып...
Dialogue: 0,0:18:26.48,0:18:29.56,Default,,0,0,0,,Маған дүниені құтқарған батыр екенімді айтты.
Dialogue: 0,0:18:29.65,0:18:34.53,Default,,0,0,0,,Медаль алып, түсінбеген көп жиналыстарға, парламенттерге шақырылдым.
Dialogue: 0,0:18:34.61,0:18:38.99,Default,,0,0,0,,Аристократтардың әдебін білмегендіктен ішіме шұңқыр түскендей болдым.
Dialogue: 0,0:18:39.07,0:18:40.16,Default,,0,0,0,,Мен де
Dialogue: 0,0:18:40.24,0:18:41.20,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:18:41.70,0:18:43.87,Default,,0,0,0,,Ағамды сізге жібере алдым деп үміттенемін.
Dialogue: 0,0:18:44.62,0:18:47.12,Default,,0,0,0,,Мастомамен қауышқаныма қуандым.
Dialogue: 0,0:18:47.20,0:18:48.08,Default,,0,0,0,,Ханзада
Dialogue: 0,0:18:48.16,0:18:52.46,Default,,0,0,0,,Король Винсент сізді құрметті қонақ ретінде ресми түрде шақырды.
Dialogue: 0,0:18:52.54,0:18:54.00,Default,,0,0,0,,Осы жетістікпен
Dialogue: 0,0:18:54.09,0:18:57.01,Default,,0,0,0,,Ол Сармуталияның келесі патшасы болып тағайындалғанға ұқсайды.
Dialogue: 0,0:18:57.09,0:18:59.68,Default,,0,0,0,,Мен сізге аз да болса көмектесе алғаныма қуаныштымын.
Dialogue: 0,0:18:59.76,0:19:01.68,Default,,0,0,0,,Аз ғана емес
Dialogue: 0,0:19:01.76,0:19:04.72,Default,,0,0,0,,Юк мырза Салмуталияны құтқарды.
Dialogue: 0,0:19:04.81,0:19:08.23,Default,,0,0,0,,Бұл тек мен емес, Кловердегілердің бәрі.
Dialogue: 0,0:19:08.31,0:19:10.02,Default,,0,0,0,,Рахмет
Dialogue: 0,0:19:10.10,0:19:11.90,Default,,0,0,0,,Бірақ мен де бұл мен болады деп күтпедім.
Dialogue: 0,0:19:11.98,0:19:14.98,Default,,0,0,0,,Мистер Юке сияқты Лабиринт Граф бола алу.
Dialogue: 0,0:19:15.07,0:19:16.69,Default,,0,0,0,,Сіздің қабілетіңіз
Dialogue: 0,0:19:17.19,0:19:20.65,Default,,0,0,0,,Мен сияқты А дәрежелі авантюрист және лабиринт граф.
Dialogue: 0,0:19:20.74,0:19:22.16,Default,,0,0,0,,Жібек амбер ағашы
Dialogue: 0,0:19:22.66,0:19:25.83,Default,,0,0,0,,Сіздің арқаңызда Жібектің туған жеріне бардым.
Dialogue: 0,0:19:25.91,0:19:27.12,Default,,0,0,0,,Бұл жұмыс.
Dialogue: 0,0:19:27.70,0:19:29.87,Default,,0,0,0,,Иә, бірақ басқа елдің ханшайымы.
Dialogue: 0,0:19:29.96,0:19:33.08,Default,,0,0,0,,Мен сені Вельмерияның асылы ете алмаймын.
Dialogue: 0,0:19:33.17,0:19:36.75,Default,,0,0,0,,Бұл патшаның өтініші, сіздің хал-жағдайларыңызды көру.
Dialogue: 0,0:19:37.34,0:19:39.42,Default,,0,0,0,,Қандай жақсы демалыс болды.
Dialogue: 0,0:19:39.51,0:19:40.13,Default,,0,0,0,,Иә
Dialogue: 0,0:19:40.76,0:19:45.72,Default,,0,0,0,,Әйтсе де, атаң мені өлтіре ме екен?
Dialogue: 0,0:19:45.80,0:19:49.73,Default,,0,0,0,,Оны қара пері ханшайымын ұрлап кеткен үлкен күнәкар деп атаған...
Dialogue: 0,0:19:49.81,0:19:51.89,Default,,0,0,0,,-Мүмкін, бірақ - (Юк) Мүмкін бе?
Dialogue: 0,0:19:54.44,0:19:56.90,Default,,0,0,0,,Мұндай болашақ жоқ сияқты.
Dialogue: 0,0:19:56.98,0:19:58.03,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:58.11,0:20:02.11,Default,,0,0,0,,Дегенмен, мен де біраз қобалжыдым.
Dialogue: 0,0:20:02.20,0:20:04.36,Default,,0,0,0,,Туған жеріңнен кеткенде алдарыңда
Dialogue: 0,0:20:04.45,0:20:07.03,Default,,0,0,0,,Мен не істерімді білмеймін
Dialogue: 0,0:20:07.12,0:20:10.37,Default,,0,0,0,,Мен түсіндім, жақсы, бұл қалай болады.
Dialogue: 0,0:20:10.45,0:20:13.42,Default,,0,0,0,,Хехе, дұрыс, мазалағаным үшін кешіріңіз.
Dialogue: 0,0:20:13.92,0:20:16.04,Default,,0,0,0,,Шай үшін рахмет, ханшайым.
Dialogue: 0,0:20:16.71,0:20:18.71,Default,,0,0,0,,Мағынасы жоқ.
Dialogue: 0,0:20:24.05,0:20:24.80,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:20:26.30,0:20:28.31,Default,,0,0,0,,♪～
Dialogue: 0,0:20:40.23,0:20:42.32,Default,,0,0,0,,Расында да көп нәрсе болды.
Dialogue: 0,0:20:42.82,0:20:44.07,Default,,0,0,0,,Юк
Dialogue: 0,0:20:44.15,0:20:45.70,Default,,0,0,0,,Жаңбыр, не болды?
Dialogue: 0,0:20:46.20,0:20:46.82,Default,,0,0,0,,Бұл…
Dialogue: 0,0:20:47.32,0:20:49.87,Default,,0,0,0,,А, мен оны Мастомаға қайтармадым.
Dialogue: 0,0:20:49.95,0:20:52.33,Default,,0,0,0,,Жоқ, мұқият қараңыз.
Dialogue: 0,0:20:55.12,0:20:56.08,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:56.17,0:20:57.63,Default,,0,0,0,,Жүгіруге нұсқау
Dialogue: 0,0:20:57.71,0:20:58.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:59.00,0:21:01.76,Default,,0,0,0,,Мен бұл әлемнен басқа әлемде жүргеніме сенімдімін.
Dialogue: 0,0:21:02.26,0:21:03.17,Default,,0,0,0,,О
Dialogue: 0,0:21:03.26,0:21:04.88,Default,,0,0,0,,Сіз қайта туылдыңыз ба?
Dialogue: 0,0:21:05.38,0:21:06.43,Default,,0,0,0,,Түстен кейін Фудзисаваға қайтасың да, мектепке барасың, иә?
Dialogue: 0,0:21:07.01,0:21:09.18,Default,,0,0,0,,Жазушы-сан, үйреніп қалдың ба?
Dialogue: 0,0:21:09.26,0:21:11.81,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:21:11.89,0:21:14.81,Default,,0,0,0,,Бірақ қазір бақытты екеніңізге сенімдімін.
Dialogue: 0,0:21:15.39,0:21:19.06,Default,,0,0,0,,Ол баршаның бата алған алтын әулие қыз.
Dialogue: 0,0:21:19.73,0:21:20.57,Default,,0,0,0,,Иә
Dialogue: 0,0:21:21.65,0:21:22.82,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:21:22.90,0:21:25.53,Default,,0,0,0,,Жүгір маған бақытты бол деді.
Dialogue: 0,0:21:25.61,0:21:27.36,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:21:27.45,0:21:28.82,Default,,0,0,0,,-Оңай - (Юк) А?
Dialogue: 0,0:21:36.00,0:21:37.92,Default,,0,0,0,,Қараңыз, бақыт
Dialogue: 0,0:21:38.71,0:21:39.71,Default,,0,0,0,,Хехехе
Dialogue: 0,0:21:39.79,0:21:40.46,Default,,0,0,0,,Ах
Dialogue: 0,0:21:40.54,0:21:42.75,Default,,0,0,0,,Юк Рейнді құшақтап жатыр.
Dialogue: 0,0:21:42.84,0:21:43.63,Default,,0,0,0,,Курогириден күткендей — сен Мидория жайлы бәрін білесің~
Dialogue: 0,0:21:43.71,0:21:45.72,Default,,0,0,0,,Бұл асығыс, бұл кінәлі.
Dialogue: 0,0:21:45.80,0:21:47.97,Default,,0,0,0,,Мен уақытты талап етемін!
Dialogue: 0,0:21:48.05,0:21:49.47,Default,,0,0,0,,Қайтадан ба?
Dialogue: 0,0:21:49.55,0:21:51.68,Default,,0,0,0,,Бұл сенсің, ылғи шу шығарасың.
Dialogue: 0,0:21:51.76,0:21:53.72,Default,,0,0,0,,Бұл туралы көбірек ойланыңыз.
Dialogue: 0,0:21:53.81,0:21:56.60,Default,,0,0,0,,Амал жоқ, бұл Юк мырза.
Dialogue: 0,0:21:56.69,0:21:57.98,Default,,0,0,0,,-(Камерат-кун) Келді~ -(Селфи-чан) Сатылым~
Dialogue: 0,0:21:58.06,0:22:01.02,Default,,0,0,0,,Хехехе, өйткені мен ең жақсымын.
Dialogue: 0,0:22:01.11,0:22:02.48,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:22:03.07,0:22:05.69,Default,,0,0,0,,Ертең жібектің отаны —
Dialogue: 0,0:22:05.78,0:22:07.20,Default,,0,0,0,,Вильмрен аралына келу
Dialogue: 0,0:22:07.28,0:22:09.03,Default,,0,0,0,,Ә… Мен келдім бе…
Dialogue: 0,0:22:09.11,0:22:10.07,Default,,0,0,0,,Жарайды
Dialogue: 0,0:22:10.16,0:22:11.45,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:22:11.53,0:22:13.41,Default,,0,0,0,,Уф, мен әлі де...
Dialogue: 0,0:22:13.49,0:22:15.70,Default,,0,0,0,,Мен сізге кейінірек көмектесемін.
Dialogue: 0,0:22:15.79,0:22:18.04,Default,,0,0,0,,Рахмет, Джейми, мен сені жақсы көремін!
Dialogue: 0,0:22:18.12,0:22:19.29,Default,,0,0,0,,Джейми мырза
Dialogue: 0,0:22:19.37,0:22:21.46,Default,,0,0,0,,Маринаны ренжітпе
Dialogue: 0,0:22:21.54,0:22:23.96,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:22:24.05,0:22:25.26,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:22:25.76,0:22:29.26,Default,,0,0,0,,Жаңа орын, не боларын білмеймін
Dialogue: 0,0:22:29.34,0:22:31.26,Default,,0,0,0,,Жарайды, өйткені бәріміз біргеміз
Dialogue: 0,0:22:31.34,0:22:32.60,Default,,0,0,0,,Өйткені біз бедеміз
Dialogue: 0,0:22:32.68,0:22:34.39,Default,,0,0,0,,-(Камерат-кун) Келді -Иә
Dialogue: 0,0:22:34.47,0:22:35.14,Default,,0,0,0,,Иә
Dialogue: 0,0:22:35.64,0:22:36.64,Default,,0,0,0,,- (Сельфи-чан) Ұяшық -Жарайды
Dialogue: 0,0:22:36.73,0:22:38.10,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:22:38.19,0:22:39.60,Default,,0,0,0,,Әрине.
Dialogue: 0,0:22:40.19,0:22:43.11,Default,,0,0,0,,Жарайды, мұқият рахат алыңыз!
Dialogue: 0,0:22:43.19,0:22:44.52,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:22:44.61,0:22:45.86,Default,,0,0,0,,～♪
Dialogue: 0,0:22:46.44,0:22:47.53,Default,,0,0,0,,Тыңдау
Dialogue: 0,0:22:47.61,0:22:49.40,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:22:49.49,0:22:50.86,Default,,0,0,0,,Келді~
Dialogue: 0,0:22:52.36,0:22:58.36,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
