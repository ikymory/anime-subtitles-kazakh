Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:03.50,Default,,0,0,0,,♪～
Dialogue: 0,0:01:28.92,0:01:30.92,Default,,0,0,0,,～♪
Dialogue: 0,0:01:33.51,0:01:37.05,Default,,0,0,0,,Бұл Glad She-Im оқиғасы туралы.
Dialogue: 0,0:01:37.13,0:01:38.18,Default,,0,0,0,,Есеп
Dialogue: 0,0:01:38.26,0:01:40.18,Default,,0,0,0,,Еңбектеріңіз үшін рахмет.
Dialogue: 0,0:01:40.26,0:01:41.47,Default,,0,0,0,,Бір аптадан кейін
Dialogue: 0,0:01:41.55,0:01:43.68,Default,,0,0,0,,Ең жақсы жағдайда бұл есептердің барлығы.
Dialogue: 0,0:01:43.77,0:01:45.89,Default,,0,0,0,,Соның ішінде жібек
Dialogue: 0,0:01:45.98,0:01:46.94,Default,,0,0,0,,үшін Кловерде
Dialogue: 0,0:01:47.02,0:01:48.94,Default,,0,0,0,,Көмегіңе рахмет.
Dialogue: 0,0:01:49.02,0:01:51.73,Default,,0,0,0,,Жоқ, мен не істедім
Dialogue: 0,0:01:51.82,0:01:54.61,Default,,0,0,0,,Мұғалімдердің есеп беру үшін түні бойы тұруына жол бермеу
Dialogue: 0,0:01:54.69,0:01:56.07,Default,,0,0,0,,Мен оны бақылап отырдым.
Dialogue: 0,0:01:56.15,0:01:57.49,Default,,0,0,0,,Ах... эй, эй
Dialogue: 0,0:01:57.57,0:01:58.57,Default,,0,0,0,,Хахаха
Dialogue: 0,0:01:59.20,0:02:01.70,Default,,0,0,0,,-де ғылым факультетінің есебі де бар.
Dialogue: 0,0:02:02.37,0:02:04.70,Default,,0,0,0,,Сіз және Нибельн кезген кеңістік
Dialogue: 0,0:02:04.79,0:02:08.00,Default,,0,0,0,,Ресми құжаттар сізді ашушы ретінде көрсетеді.
Dialogue: 0,0:02:08.08,0:02:08.75,Default,,0,0,0,,Келісесің бе?
Dialogue: 0,0:02:09.58,0:02:10.83,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:02:11.33,0:02:16.26,Default,,0,0,0,,Содан кейін сіз шағымданған граф Клауданың ісі.
Dialogue: 0,0:02:16.34,0:02:19.51,Default,,0,0,0,,Бұл да маған маркиз Бедибуа көмектесті.
Dialogue: 0,0:02:19.59,0:02:21.85,Default,,0,0,0,,Не, директор?
Dialogue: 0,0:02:21.93,0:02:25.39,Default,,0,0,0,,Меніңше, төрелік істерді тектілерге тапсырған дұрыс.
Dialogue: 0,0:02:25.47,0:02:26.81,Default,,0,0,0,,Ол туралы
Dialogue: 0,0:02:26.89,0:02:29.89,Default,,0,0,0,,Біраз уақыттан бері жаман өсектер көп болды.
Dialogue: 0,0:02:29.98,0:02:32.27,Default,,0,0,0,,Мен ұлы мәртебеліге баяндадым.
Dialogue: 0,0:02:32.36,0:02:32.90,Default,,0,0,0,,Мәртебелі?
Dialogue: 0,0:02:33.48,0:02:35.40,Default,,0,0,0,,Тағы кім бар?
Dialogue: 0,0:02:35.48,0:02:38.03,Default,,0,0,0,,Мәртебелі мұқият тыңдады.
Dialogue: 0,0:02:38.11,0:02:42.28,Default,,0,0,0,,Бұл біз сияқты көбікті авантюристер үшін проблема болады деп ойламаппын...
Dialogue: 0,0:02:42.37,0:02:44.08,Default,,0,0,0,,Тым көп кішіпейілділік
Dialogue: 0,0:02:44.58,0:02:45.99,Default,,0,0,0,,Кловер - бұл уақыт
Dialogue: 0,0:02:46.08,0:02:50.04,Default,,0,0,0,,Бұл ел сұранысын орындаған танымал, талантты партия.
Dialogue: 0,0:02:50.12,0:02:53.46,Default,,0,0,0,,Мәртебелі де ағынды көргісі келеді және оны ұнатады.
Dialogue: 0,0:02:53.96,0:02:55.88,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:02:55.96,0:02:57.80,Default,,0,0,0,,Сөз жоқ.
Dialogue: 0,0:02:57.88,0:02:59.09,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:02:59.17,0:03:03.55,Default,,0,0,0,,Жуырда Сармуталияға оралған екінші князь Мастмадан.
Dialogue: 0,0:03:03.64,0:03:06.35,Default,,0,0,0,,Келтірілген қолайсыздық үшін Граф Клауданы жауапты деп есептеңіз.
Dialogue: 0,0:03:06.43,0:03:08.60,Default,,0,0,0,,Сізге ресми құжат жіберілді.
Dialogue: 0,0:03:08.68,0:03:09.93,Default,,0,0,0,,Ханзада Мастмадан...
Dialogue: 0,0:03:10.02,0:03:15.19,Default,,0,0,0,,Осы хаттың қолдауымен граф Клауда қамауға алынды.
Dialogue: 0,0:03:15.27,0:03:16.69,Default,,0,0,0,,Сот талқылауын күтуде
Dialogue: 0,0:03:16.77,0:03:20.19,Default,,0,0,0,,Мәстма князының Іздеуші компасымен бір қатысы бар.
Dialogue: 0,0:03:20.28,0:03:22.86,Default,,0,0,0,,Сіз қайтадан қарызға батқан сияқтысыз.
Dialogue: 0,0:03:23.36,0:03:24.91,Default,,0,0,0,,Мм, бірақ...
Dialogue: 0,0:03:24.99,0:03:27.91,Default,,0,0,0,,Сіз Сармуталияның лабиринтін айтасыз, солай ма?
Dialogue: 0,0:03:27.99,0:03:28.83,Default,,0,0,0,,Иә
Dialogue: 0,0:03:28.91,0:03:30.21,Default,,0,0,0,,Зынданданы жаулап алу
Dialogue: 0,0:03:30.29,0:03:33.83,Default,,0,0,0,,Жоспар ресурстарға несие алу болып табылады.
Dialogue: 0,0:03:34.58,0:03:38.46,Default,,0,0,0,,Дегенмен, біздің елде нағыз авантюристер жоқ.
Dialogue: 0,0:03:39.05,0:03:41.76,Default,,0,0,0,,Менің ойымша, ханзада сенімді адам.
Dialogue: 0,0:03:42.26,0:03:44.47,Default,,0,0,0,,Егер біз, Кловер, көмектесе алсақ.
Dialogue: 0,0:03:44.55,0:03:46.10,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,0:03:46.18,0:03:50.06,Default,,0,0,0,,Мен бұл туралы не істей алатынымды қарастырамын.
Dialogue: 0,0:03:50.14,0:03:51.23,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:03:51.31,0:03:53.23,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:53.31,0:03:58.19,Default,,0,0,0,,Соңында, Нибельн мырза, Алтын священниктің емделуіне қатысты.
Dialogue: 0,0:03:58.69,0:04:01.11,Default,,0,0,0,,Мен оның жауабын тыңдай аламын ба?
Dialogue: 0,0:04:01.19,0:04:03.36,Default,,0,0,0,,Иә, ол...
Dialogue: 0,0:04:05.82,0:04:07.24,Default,,0,0,0,,Маркиз Бедибуа
Dialogue: 0,0:04:07.33,0:04:10.04,Default,,0,0,0,,Басқа әлемнен маңызды тұтынушы ретінде іске қосыңыз
Dialogue: 0,0:04:10.12,0:04:12.00,Default,,0,0,0,,Ол мені қарсы алатынын айтты.
Dialogue: 0,0:04:13.08,0:04:14.79,Default,,0,0,0,,Бірақ мен
Dialogue: 0,0:04:15.29,0:04:19.50,Default,,0,0,0,,Жоқ, біз Clover for Run мүшесіміз...
Dialogue: 0,0:04:19.59,0:04:22.13,Default,,0,0,0,,Басқаша айтқанда, олардың отбасы болғанын қалаймын.
Dialogue: 0,0:04:22.22,0:04:22.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:23.05,0:04:25.13,Default,,0,0,0,,Шешімді Іске қосуға қалдырыңыз
Dialogue: 0,0:04:25.22,0:04:27.93,Default,,0,0,0,,Қайсын таңдасаң да, сезіміңді сыйла.
Dialogue: 0,0:04:28.43,0:04:30.31,Default,,0,0,0,,-(Нибельн) Жүгіру бұл... -(Юк) Иә.
Dialogue: 0,0:04:30.85,0:04:33.64,Default,,0,0,0,,Мен ағам мен әпкемнің қасында болғым келеді.
Dialogue: 0,0:04:33.73,0:04:36.52,Default,,0,0,0,,Біз, Кловер, Жүгіруді қолға аламыз.
Dialogue: 0,0:04:36.60,0:04:38.11,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:04:38.19,0:04:42.69,Default,,0,0,0,,Бірақ егер сізде қандай да бір қиыншылық болса, сіз әрқашан Академияға келе аласыз.
Dialogue: 0,0:04:42.78,0:04:43.78,Default,,0,0,0,,Өзіңізді еркін сезініңіз
Dialogue: 0,0:04:44.28,0:04:45.07,Default,,0,0,0,,Иә
Dialogue: 0,0:04:45.15,0:04:47.66,Default,,0,0,0,,Финиске қашан қайтасыз?
Dialogue: 0,0:04:47.74,0:04:49.41,Default,,0,0,0,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:04:49.49,0:04:50.83,Default,,0,0,0,,Саяхатқа дайындалу
Dialogue: 0,0:04:50.91,0:04:53.66,Default,,0,0,0,,Бізге көмектескендерге сәлем
Dialogue: 0,0:04:53.75,0:04:55.92,Default,,0,0,0,,Мен 3 күннен кейін кетемін деп жоспарлап отырмын.
Dialogue: 0,0:04:56.00,0:04:59.09,Default,,0,0,0,,Әсіресе Скордия мен Карминге.
Dialogue: 0,0:04:59.17,0:05:00.84,Default,,0,0,0,,Өйткені сен маған көмектестің
Dialogue: 0,0:05:00.92,0:05:03.21,Default,,0,0,0,,Үйренетін көп нәрсе бар
Dialogue: 0,0:05:03.30,0:05:06.22,Default,,0,0,0,,Рахмет ретінде мен сізге бірнеше сұрақтар қойғым келеді.
Dialogue: 0,0:05:06.30,0:05:08.34,Default,,0,0,0,,Бұл ұят болды.
Dialogue: 0,0:05:08.43,0:05:10.43,Default,,0,0,0,,Скордия және Кармин
Dialogue: 0,0:05:10.51,0:05:13.22,Default,,0,0,0,,Мен басқа тапсырма алып, кетіп қалдым.
Dialogue: 0,0:05:13.31,0:05:16.19,Default,,0,0,0,,Солай ма? Бұл ұят
Dialogue: 0,0:05:16.27,0:05:18.35,Default,,0,0,0,,Мен сізге дұрыс алғыс айта алмадым.
Dialogue: 0,0:05:18.44,0:05:21.77,Default,,0,0,0,,Бұл балалар да Глад Ше-Имнің күш-жігерінің арқасында.
Dialogue: 0,0:05:21.86,0:05:24.03,Default,,0,0,0,,Өйткені менің атым барған сайын танымал болды.
Dialogue: 0,0:05:24.11,0:05:26.07,Default,,0,0,0,,Егер сіз авантюрист бола берсеңіз
Dialogue: 0,0:05:26.15,0:05:28.24,Default,,0,0,0,,Бір күні, бір жерде тағы кездесеміз.
Dialogue: 0,0:05:28.95,0:05:30.12,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:05:30.20,0:05:34.16,Default,,0,0,0,,Оған дейін біз Жоңышқа одан да көп өсуіміз керек.
Dialogue: 0,0:05:34.25,0:05:35.79,Default,,0,0,0,,Иә мырза
Dialogue: 0,0:05:35.87,0:05:38.25,Default,,0,0,0,,Өзімді ұялмай көрсете алуым үшін
Dialogue: 0,0:05:38.88,0:05:43.00,Default,,0,0,0,,Сонымен, Бордман екеуміз Финниске сәл ертерек оралдық.
Dialogue: 0,0:05:43.50,0:05:44.51,Default,,0,0,0,,Сондай-ақ бір күні
Dialogue: 0,0:05:44.59,0:05:46.84,Default,,0,0,0,,Осы уақыт үшін көп рахмет.
Dialogue: 0,0:05:47.34,0:05:49.09,Default,,0,0,0,,Әлемді құтқару үшін жақсы.
Dialogue: 0,0:05:50.09,0:05:52.60,Default,,0,0,0,,Юк Фердио, батыл адам
Dialogue: 0,0:05:55.81,0:05:59.31,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:06:03.98,0:06:06.90,Default,,0,0,0,,Квест шынымен аяқталды.
Dialogue: 0,0:06:06.99,0:06:08.91,Default,,0,0,0,,Иә, еңбегіңіз үшін рахмет.
Dialogue: 0,0:06:08.99,0:06:10.78,Default,,0,0,0,,Жібекке де ерен еңбектеріңізге рахмет.
Dialogue: 0,0:06:11.28,0:06:13.20,Default,,0,0,0,,Ал, ертең дүкенге барамыз.
Dialogue: 0,0:06:13.28,0:06:15.58,Default,,0,0,0,,Ұстазым мені жолықтырмайды.
Dialogue: 0,0:06:15.66,0:06:17.04,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:06:17.96,0:06:18.87,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:18.96,0:06:20.42,Default,,0,0,0,,Сіздің жүгіңізді таситын адам табыла ма?
Dialogue: 0,0:06:20.50,0:06:23.71,Default,,0,0,0,,Сізге Марина, Жаңбыр және Жүгіру көмектеседі.
Dialogue: 0,0:06:23.80,0:06:25.00,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:06:25.09,0:06:27.88,Default,,0,0,0,,Нене ше? Менімен неге бармайсың?
Dialogue: 0,0:06:27.97,0:06:31.55,Default,,0,0,0,,Мұғалім, ұмытып қалдыңыз ба? Водан сарайында...
Dialogue: 0,0:06:33.22,0:06:35.68,Default,,0,0,0,,Өйткені менің енді құшақтайтын жерім жоқ
Dialogue: 0,0:06:35.77,0:06:37.52,Default,,0,0,0,,Мен қайтып, күтемін.
Dialogue: 0,0:06:37.60,0:06:41.69,Default,,0,0,0,,Бірақ мен үйге келгенде, мен бір күндік нене уақытын сұраймын.
Dialogue: 0,0:06:41.77,0:06:42.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:42.65,0:06:45.48,Default,,0,0,0,,Нене тағатсыздана күтіп отыр.
Dialogue: 0,0:06:45.57,0:06:48.03,Default,,0,0,0,,Мұғаліміңізден сізді шақыруын сұраңыз.
Dialogue: 0,0:06:48.11,0:06:49.20,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:06:49.28,0:06:53.28,Default,,0,0,0,,Бірақ мен нене уақытпен не істеуім керек?
Dialogue: 0,0:06:53.37,0:06:54.95,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:06:55.03,0:06:58.70,Default,,0,0,0,,Егер сізге мұғаліммен бірге болу ұнаса, онда
Dialogue: 0,0:06:58.79,0:07:01.17,Default,,0,0,0,,Хмм, солай ма?
Dialogue: 0,0:07:01.25,0:07:02.71,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:07:02.79,0:07:06.21,Default,,0,0,0,,Бірақ мен мұғалімді өз бетімше алатыныма сене алмаймын.
Dialogue: 0,0:07:06.84,0:07:09.97,Default,,0,0,0,,Сол кезде мен сені құшақтап қарсылық көрсетсем ғой.
Dialogue: 0,0:07:10.93,0:07:14.14,Default,,0,0,0,,Жібек уақытын сұрасам болар еді.
Dialogue: 0,0:07:14.22,0:07:14.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:15.68,0:07:17.93,Default,,0,0,0,,Жоқ... бұл ештеңе емес.
Dialogue: 0,0:07:19.68,0:07:20.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:24.27,0:07:26.36,Default,,0,0,0,,Бұл туралы ойлаудың пайдасы бар ма?
Dialogue: 0,0:07:27.11,0:07:29.11,Default,,0,0,0,,Иә
Dialogue: 0,0:07:30.40,0:07:31.82,Default,,0,0,0,,Сізге бірдеңе керек пе?
Dialogue: 0,0:07:32.32,0:07:34.07,Default,,0,0,0,,-(Юк) Нене -Хяи!
Dialogue: 0,0:07:34.16,0:07:37.20,Default,,0,0,0,,Ю... Юк-сан, не болды?
Dialogue: 0,0:07:37.29,0:07:39.12,Default,,0,0,0,,Сіз орап жатырсыз ба?
Dialogue: 0,0:07:39.20,0:07:42.00,Default,,0,0,0,,Мен жинастыруға онша шебер емеспін.
Dialogue: 0,0:07:42.08,0:07:43.79,Default,,0,0,0,,Ерте дайындал!
Dialogue: 0,0:07:44.29,0:07:45.63,Default,,0,0,0,,Бұл жақсы идея.
Dialogue: 0,0:07:46.54,0:07:48.13,Default,,0,0,0,,Ал...
Dialogue: 0,0:07:48.96,0:07:49.51,Default,,0,0,0,,Нене
Dialogue: 0,0:07:50.09,0:07:51.88,Default,,0,0,0,,-Иә -(Юк) Ертең.
Dialogue: 0,0:07:51.97,0:07:52.72,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:53.80,0:07:56.60,Default,,0,0,0,,Өзіңіз қалайтыныңызды ойлаңыз.
Dialogue: 0,0:07:57.10,0:07:59.31,Default,,0,0,0,,үшінн ұмытып, тек көңіл көтеру
Dialogue: 0,0:07:59.81,0:08:02.56,Default,,0,0,0,,Себебі, бұл уақыт жоқ.
Dialogue: 0,0:08:06.19,0:08:07.98,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:08:10.07,0:08:11.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:14.07,0:08:16.99,Default,,0,0,0,,Фуна~о!
Dialogue: 0,0:08:22.79,0:08:24.50,Default,,0,0,0,,Пуха~!
Dialogue: 0,0:08:25.08,0:08:26.00,Default,,0,0,0,,Юк мырза?
Dialogue: 0,0:08:27.84,0:08:29.34,Default,,0,0,0,,- Юк мырза! -(Юк) А...
Dialogue: 0,0:08:29.42,0:08:32.88,Default,,0,0,0,,Жоқ, сіз тағы ойланып қалдыңыз, солай емес пе?
Dialogue: 0,0:08:32.97,0:08:35.34,Default,,0,0,0,,Тым көп нәрсе болды
Dialogue: 0,0:08:35.43,0:08:37.55,Default,,0,0,0,,Ойлау әдетінен арыла алмай жүрген сияқтымын.
Dialogue: 0,0:08:38.14,0:08:40.06,Default,,0,0,0,,Мен тым көп жұмысқа құмармын
Dialogue: 0,0:08:40.14,0:08:42.48,Default,,0,0,0,,Бүгін мен бәрін ұмытып, жай ғана көңіл көтеремін
Dialogue: 0,0:08:42.56,0:08:44.31,Default,,0,0,0,,Мұны Юке мырза айтпады ма?
Dialogue: 0,0:08:44.39,0:08:46.81,Default,,0,0,0,,О, кешіріңіз, Нене.
Dialogue: 0,0:08:46.90,0:08:48.19,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:48.27,0:08:51.32,Default,,0,0,0,,Бірақ бүгін нене уақыт, сондықтан
Dialogue: 0,0:08:51.40,0:08:54.40,Default,,0,0,0,,Мен өзімшілдігім туралы көп айтып беруіңізді сұраймын.
Dialogue: 0,0:08:57.07,0:08:57.95,Default,,0,0,0,,Пуха~
Dialogue: 0,0:08:58.66,0:08:59.95,Default,,0,0,0,,Жұмсақ болыңыз
Dialogue: 0,0:09:01.74,0:09:03.12,Default,,0,0,0,,Ах~
Dialogue: 0,0:09:03.20,0:09:06.96,Default,,0,0,0,,Күн астында шарап ішу - ең жақсысы!
Dialogue: 0,0:09:07.04,0:09:08.83,Default,,0,0,0,,Дунаға келгеннен кейін...
Dialogue: 0,0:09:08.92,0:09:12.76,Default,,0,0,0,,Жоқ, бұл бұрын-соңды болмаған, сондықтан сергітеді.
Dialogue: 0,0:09:13.26,0:09:14.47,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:09:14.55,0:09:18.47,Default,,0,0,0,,Мен Найзағай Шортан-ден бері көп ішкен жоқпын.
Dialogue: 0,0:09:19.05,0:09:21.64,Default,,0,0,0,,Алкоголь - шытырман оқиғадан кейінгі түнде ләззат алатын нәрсе.
Dialogue: 0,0:09:21.72,0:09:23.77,Default,,0,0,0,,Мүмкін мен оны елестеткен шығармын.
Dialogue: 0,0:09:27.19,0:09:27.81,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:09:28.31,0:09:29.40,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:30.31,0:09:31.86,Default,,0,0,0,,Қауіпті сезінудің жоқтығы, көріп тұрмын.
Dialogue: 0,0:09:32.69,0:09:34.74,Default,,0,0,0,,Жасағым келетін нәрселер көп.
Dialogue: 0,0:09:34.82,0:09:37.32,Default,,0,0,0,,Алдымен мен базарға барғым келеді.
Dialogue: 0,0:09:37.41,0:09:39.45,Default,,0,0,0,,Жібектер жүрмей ме?
Dialogue: 0,0:09:39.95,0:09:42.12,Default,,0,0,0,,Бұл авантюристер көшесіне ұқсамайды.
Dialogue: 0,0:09:42.20,0:09:45.04,Default,,0,0,0,,Түсіндім, мен ол жерге барған жоқпын.
Dialogue: 0,0:09:45.54,0:09:48.00,Default,,0,0,0,,Салмуталиядан және басқа елдерден тауарларды саудалау
Dialogue: 0,0:09:48.08,0:09:49.25,Default,,0,0,0,,Ол сатылып жатыр ма?
Dialogue: 0,0:09:49.33,0:09:52.63,Default,,0,0,0,,Менің ойымша, олардың көпшілігі шытырман оқиғаға қатысы жоқ.
Dialogue: 0,0:09:52.71,0:09:54.13,Default,,0,0,0,,Мен оны көргім келеді
Dialogue: 0,0:09:54.21,0:09:57.76,Default,,0,0,0,,Жарайды, онда дүкен аралап, көңіл көтерейік.
Dialogue: 0,0:09:57.84,0:09:59.64,Default,,0,0,0,,Ия, мен жасадым!
Dialogue: 0,0:09:59.72,0:10:03.89,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:10:03.97,0:10:06.48,Default,,0,0,0,,Хехе... Иә?
Dialogue: 0,0:10:08.10,0:10:09.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:09.10,0:10:10.77,Default,,0,0,0,,Сіз үйрендіңіз бе?
Dialogue: 0,0:10:10.86,0:10:12.61,Default,,0,0,0,,Жоқ, мен бұған үйренбегенмін.
Dialogue: 0,0:10:12.69,0:10:13.65,Default,,0,0,0,,...
Dialogue: 0,0:10:13.73,0:10:16.03,Default,,0,0,0,,Шынында да, Юке мырзаның қолынан бәрі келеді.
Dialogue: 0,0:10:16.11,0:10:18.40,Default,,0,0,0,,Қыздарға келгенде, оңай.
Dialogue: 0,0:10:18.99,0:10:20.45,Default,,0,0,0,,Тек ептілігі нашар болғандықтан
Dialogue: 0,0:10:20.53,0:10:23.16,Default,,0,0,0,,Көптеген нәрселер бар, тіпті менің тәжірибем де жоқ.
Dialogue: 0,0:10:23.24,0:10:26.70,Default,,0,0,0,,Сүйкімді қызбен кездесуге қалай бару керек
Dialogue: 0,0:10:26.79,0:10:27.91,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:10:28.00,0:10:29.04,Default,,0,0,0,,(Масато) Денең болмауы біраз қиын ғой, иә?
Dialogue: 0,0:10:29.92,0:10:31.96,Default,,0,0,0,,Табиғат нашар.
Dialogue: 0,0:10:32.04,0:10:32.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:32.63,0:10:35.09,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:10:35.76,0:10:37.30,Default,,0,0,0,,Әй, базар!
Dialogue: 0,0:10:41.89,0:10:45.18,Default,,0,0,0,,Қараңыз! Бұл туника мөлдір.
Dialogue: 0,0:10:45.26,0:10:47.68,Default,,0,0,0,,Мына сырғалар маржан ма?
Dialogue: 0,0:10:47.77,0:10:51.94,Default,,0,0,0,,Бұл Раяхима тауындағы тас тұзынан жасалған косметика ма?
Dialogue: 0,0:10:52.02,0:10:54.94,Default,,0,0,0,,Сатылымда бұрын көрмеген дүниелер көп.
Dialogue: 0,0:10:55.02,0:10:57.28,Default,,0,0,0,,-Міне, -(Юк) Уау, әй...
Dialogue: 0,0:10:57.36,0:10:58.82,Default,,0,0,0,,Келесі - бұл!
Dialogue: 0,0:10:58.90,0:11:01.07,Default,,0,0,0,,-(Юк) Ой... -Мен де сол жаққа барамын.
Dialogue: 0,0:11:01.16,0:11:02.91,Default,,0,0,0,,Уау~
Dialogue: 0,0:11:02.99,0:11:04.45,Default,,0,0,0,,Егер сіз бірдеңе алғыңыз келсе
Dialogue: 0,0:11:04.53,0:11:05.58,Default,,0,0,0,,Мен оны саған сатып аламын
Dialogue: 0,0:11:05.66,0:11:07.87,Default,,0,0,0,,Я, бұл жаман.
Dialogue: 0,0:11:07.95,0:11:10.71,Default,,0,0,0,,Бірдеңені қаласаңыз, оны өз әмияныңыздан алыңыз.
Dialogue: 0,0:11:10.79,0:11:14.04,Default,,0,0,0,,Олай десеңіз де, ештеңе сатып алған жоқсыз.
Dialogue: 0,0:11:14.13,0:11:16.55,Default,,0,0,0,,Жарайды, сіз оны түсіне алмайсыз, солай ма?
Dialogue: 0,0:11:16.63,0:11:17.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:18.30,0:11:19.84,Default,,0,0,0,,Бұл менің алғысым.
Dialogue: 0,0:11:19.92,0:11:24.18,Default,,0,0,0,,Бұл жағдайда мен сізді көп қиналып, алаңдаттым.
Dialogue: 0,0:11:24.26,0:11:25.85,Default,,0,0,0,,Маған еркін айтыңыз
Dialogue: 0,0:11:26.39,0:11:27.72,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:11:27.81,0:11:31.06,Default,,0,0,0,,Әрине, бүгін нене уақыт, солай ма?
Dialogue: 0,0:11:31.56,0:11:33.02,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:33.10,0:11:34.86,Default,,0,0,0,,Мен мұны өзім де түсінбеймін.
Dialogue: 0,0:11:34.94,0:11:38.73,Default,,0,0,0,,Кәдесыйлардан гөрі өзімшіл болған дұрыс.
Dialogue: 0,0:11:38.82,0:11:40.24,Default,,0,0,0,,Тағы?
Dialogue: 0,0:11:40.32,0:11:40.90,Default,,0,0,0,,Иә
Dialogue: 0,0:11:41.40,0:11:44.24,Default,,0,0,0,,Маған не ойласаңыз, айтыңыз.
Dialogue: 0,0:11:44.74,0:11:47.58,Default,,0,0,0,,Нене өзімшіл болуды үйренуі керек...
Dialogue: 0,0:11:48.70,0:11:51.58,Default,,0,0,0,,Мен айттым ғой, солай ма? Мен енді тоқтай алмаймын
Dialogue: 0,0:11:51.66,0:11:53.12,Default,,0,0,0,,Дондокода
Dialogue: 0,0:11:53.62,0:11:56.25,Default,,0,0,0,,Ал, осы дүкеннен бастайық!
Dialogue: 0,0:11:56.34,0:11:59.76,Default,,0,0,0,,Кәдесый сатып алған соң барғым келетін жерлер көп.
Dialogue: 0,0:11:59.84,0:12:01.76,Default,,0,0,0,,Мен не істегім келеді және не істегім келеді
Dialogue: 0,0:12:01.84,0:12:03.26,Default,,0,0,0,,Көп нәрсе бар.
Dialogue: 0,0:12:03.34,0:12:06.10,Default,,0,0,0,,Нене уақыты түнге дейін бітпейді.
Dialogue: 0,0:12:06.18,0:12:07.56,Default,,0,0,0,,Өзіңізді дайындаңыз!
Dialogue: 0,0:12:07.64,0:12:10.27,Default,,0,0,0,,(Юк пен Нененің күлкілері)
Dialogue: 0,0:12:13.23,0:12:14.90,Default,,0,0,0,,Көмегің үшін көп рахмет.
Dialogue: 0,0:12:14.98,0:12:16.02,Default,,0,0,0,,Маньера мырза
Dialogue: 0,0:12:16.52,0:12:17.90,Default,,0,0,0,,Міне.
Dialogue: 0,0:12:17.98,0:12:21.36,Default,,0,0,0,,Фина-сан да маған жақсы қарады.
Dialogue: 0,0:12:21.44,0:12:22.53,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:12:22.61,0:12:26.66,Default,,0,0,0,,Бұл көңілді күн болды. Бізге қайта келіңіз.
Dialogue: 0,0:12:26.74,0:12:29.12,Default,,0,0,0,,Иә! Мен міндетті түрде келемін
Dialogue: 0,0:12:29.20,0:12:30.91,Default,,0,0,0,,Қайтадан ыстық бұлаққа барғым келеді.
Dialogue: 0,0:12:31.00,0:12:33.87,Default,,0,0,0,,Жүгіру де ыстық бұлақтарды жақсы көреді!
Dialogue: 0,0:12:33.96,0:12:35.79,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,0:12:35.88,0:12:39.13,Default,,0,0,0,,Иә, мен оны үйге апарғым келеді.
Dialogue: 0,0:12:39.21,0:12:41.55,Default,,0,0,0,,Бұл біраз қиын
Dialogue: 0,0:12:41.63,0:12:43.55,Default,,0,0,0,,Бірақ мен тағы келемін
Dialogue: 0,0:12:43.63,0:12:44.93,Default,,0,0,0,,(үшінның жауабы)
Dialogue: 0,0:12:45.93,0:12:46.51,Default,,0,0,0,,Сонымен
Dialogue: 0,0:12:47.01,0:12:50.43,Default,,0,0,0,,Барлық көмектеріңіз үшін көп рахмет.
Dialogue: 0,0:12:50.51,0:12:52.18,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:12:56.27,0:12:59.11,Default,,0,0,0,,Енді Финиске оралайық.
Dialogue: 0,0:12:59.61,0:13:01.07,Default,,0,0,0,,Біздің үйге
Dialogue: 0,0:13:07.03,0:13:09.70,Default,,0,0,0,,- Мынаны ұста... - (Нибельн) Иә, иә.
Dialogue: 0,0:13:09.78,0:13:12.37,Default,,0,0,0,,Хам Хам Хам…
Dialogue: 0,0:13:25.05,0:13:27.09,Default,,0,0,0,,Ах, сіз қайтып келдіңіз.
Dialogue: 0,0:13:27.18,0:13:30.30,Default,,0,0,0,,Ностальгиялық финнистер!
Dialogue: 0,0:13:35.06,0:13:36.85,Default,,0,0,0,,Бұл әдемі қала.
Dialogue: 0,0:13:36.94,0:13:40.06,Default,,0,0,0,,Рун-чан да бүгіннен бастап осы қаланың тұрғыны.
Dialogue: 0,0:13:40.15,0:13:40.98,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:41.07,0:13:42.86,Default,,0,0,0,,- (Ер адам) Марина-чан емес пе? -иә?
Dialogue: 0,0:13:42.94,0:13:45.61,Default,,0,0,0,,Бұл рас, Кловер қайтып келді.
Dialogue: 0,0:13:45.69,0:13:47.36,Default,,0,0,0,,Сәлем, қош келдіңіз!
Dialogue: 0,0:13:47.45,0:13:48.61,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:48.70,0:13:49.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:49.45,0:13:51.74,Default,,0,0,0,,Беде! Мен эфирді қарап отырдым
Dialogue: 0,0:13:51.83,0:13:54.87,Default,,0,0,0,,Аман-есен оралғаныңызға қуаныштымын. Қайтадан қош келдіңіз!
Dialogue: 0,0:13:54.95,0:13:57.00,Default,,0,0,0,,Әпке, бұл...
Dialogue: 0,0:13:57.08,0:14:01.17,Default,,0,0,0,,Иә, олар бізді қарсы алады.
Dialogue: 0,0:14:01.67,0:14:02.88,Default,,0,0,0,,Эй!
Dialogue: 0,0:14:02.96,0:14:05.80,Default,,0,0,0,,Мен мұндай нәрсе болады деп ешқашан күтпедім.
Dialogue: 0,0:14:05.88,0:14:07.47,Default,,0,0,0,,Дәл жазылғандай жауап беріп отырсың — қазір сәнде жүрген сол «қолмен басқарылатын» кішкентай қыздардың бірісің бе?
Dialogue: 0,0:14:07.55,0:14:08.97,Default,,0,0,0,,Бірақ мен бақыттымын.
Dialogue: 0,0:14:09.05,0:14:12.26,Default,,0,0,0,,үшін ағынды тамашалап, бізді қолдады.
Dialogue: 0,0:14:12.35,0:14:14.68,Default,,0,0,0,,Иә, мен өзімді жетістікке жеткендей сезінемін.
Dialogue: 0,0:14:14.77,0:14:16.39,Default,,0,0,0,,Жылағым келеді
Dialogue: 0,0:14:16.48,0:14:19.14,Default,,0,0,0,,үшінңызға рахмет
Dialogue: 0,0:14:19.23,0:14:21.27,Default,,0,0,0,,Кловер қайтып келді
Dialogue: 0,0:14:21.36,0:14:22.52,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:14:22.61,0:14:24.90,Default,,0,0,0,,Қайтадан қош келдіңіз!
Dialogue: 0,0:14:25.61,0:14:27.78,Default,,0,0,0,,Мен Бенвудқа есеп беремін.
Dialogue: 0,0:14:27.86,0:14:29.91,Default,,0,0,0,,үшін бірінші үйге қайтсын.
Dialogue: 0,0:14:29.99,0:14:31.62,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:14:32.99,0:14:35.20,Default,,0,0,0,,Қош келдіңіз, Юк мырза.
Dialogue: 0,0:14:35.29,0:14:37.29,Default,,0,0,0,,Ұзақ жолдағы қажырлы еңбектеріңіз үшін рахмет.
Dialogue: 0,0:14:37.37,0:14:40.79,Default,,0,0,0,,Мен жаңа ғана Дунадан оралдым, Мамару-сан.
Dialogue: 0,0:14:40.87,0:14:43.42,Default,,0,0,0,,Сізден сұрайын дегенім көп.
Dialogue: 0,0:14:43.50,0:14:45.55,Default,,0,0,0,,Бұл туралы кейінірек айтамыз.
Dialogue: 0,0:14:45.63,0:14:47.80,Default,,0,0,0,,Жаңбыр үшін көп рахмет.
Dialogue: 0,0:14:49.13,0:14:52.60,Default,,0,0,0,,Граф Клаудаға қатысты тергеу және отбасылық тіркеуді бұрмалау
Dialogue: 0,0:14:52.68,0:14:53.80,Default,,0,0,0,,Және...
Dialogue: 0,0:14:53.89,0:14:56.39,Default,,0,0,0,,Сіз кімнің тыңдап жатқанын ешқашан білмейсіз.
Dialogue: 0,0:14:56.89,0:15:00.19,Default,,0,0,0,,Қажетсіз сөздерді айтпау маңызды.
Dialogue: 0,0:15:00.77,0:15:01.48,Default,,0,0,0,,Иә
Dialogue: 0,0:15:01.98,0:15:03.94,Default,,0,0,0,,Бірақ көп рахмет.
Dialogue: 0,0:15:04.02,0:15:05.44,Default,,0,0,0,,Жоқ
Dialogue: 0,0:15:05.52,0:15:09.07,Default,,0,0,0,,Бірақ сіз бұл несиені қалай өтейсіз?
Dialogue: 0,0:15:09.15,0:15:10.57,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:15:10.65,0:15:14.07,Default,,0,0,0,,Жоқ... хахахаха...
Dialogue: 0,0:15:15.24,0:15:17.20,Default,,0,0,0,,...Осымен іс бітті.
Dialogue: 0,0:15:17.29,0:15:18.45,Default,,0,0,0,,О
Dialogue: 0,0:15:18.54,0:15:21.62,Default,,0,0,0,,Көбінесе кемпірден естідім.
Dialogue: 0,0:15:21.71,0:15:24.21,Default,,0,0,0,,- (Юк) Әже? - Маниера Нона
Dialogue: 0,0:15:24.29,0:15:25.46,Default,,0,0,0,,Әже...
Dialogue: 0,0:15:26.05,0:15:29.72,Default,,0,0,0,,Сондай-ақ, менің ойымша, князь Мастома туралы хабарлар болды.
Dialogue: 0,0:15:29.80,0:15:31.38,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:15:31.47,0:15:34.01,Default,,0,0,0,,Бұл жерде қазірдің өзінде жұмыс істеп тұрса да.
Dialogue: 0,0:15:34.09,0:15:37.60,Default,,0,0,0,,Бірдеңені бірден жасау қиын.
Dialogue: 0,0:15:37.68,0:15:40.43,Default,,0,0,0,,Жарайды, асықпа, сәл күт.
Dialogue: 0,0:15:40.52,0:15:41.19,Default,,0,0,0,,О
Dialogue: 0,0:15:41.27,0:15:43.85,Default,,0,0,0,,Бұл миссияның сыйлығы.
Dialogue: 0,0:15:43.94,0:15:46.86,Default,,0,0,0,,Мен оны кейінірек Кловердің шотына аударамын.
Dialogue: 0,0:15:46.94,0:15:48.73,Default,,0,0,0,,Аудару? Неліктен?
Dialogue: 0,0:15:49.32,0:15:50.57,Default,,0,0,0,,Қолма-қол ақшамен үйге қалай апаруға болады
Dialogue: 0,0:15:50.65,0:15:52.24,Default,,0,0,0,,Өйткені тым көп
Dialogue: 0,0:15:52.32,0:15:53.20,Default,,0,0,0,,Соншама?
Dialogue: 0,0:15:53.28,0:15:54.99,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:15:55.07,0:15:59.50,Default,,0,0,0,,Мен өзіме келген елден тапсырманы сәтті орындадым.
Dialogue: 0,0:15:59.58,0:16:02.00,Default,,0,0,0,,Маңдайыңа қарап, берілме.
Dialogue: 0,0:16:02.08,0:16:05.50,Default,,0,0,0,,Көп күтпе, үмітіңді үз
Dialogue: 0,0:16:06.13,0:16:08.09,Default,,0,0,0,,Юк қайтып келді ме?
Dialogue: 0,0:16:08.17,0:16:09.05,Default,,0,0,0,,Юк…
Dialogue: 0,0:16:09.13,0:16:10.26,Default,,0,0,0,,Мен үйдемін, Джейми.
Dialogue: 0,0:16:11.01,0:16:13.80,Default,,0,0,0,,Жақсы болды ма? Бір жерің ауырды ма?
Dialogue: 0,0:16:13.88,0:16:15.01,Default,,0,0,0,,Ауырсыну бар ма?
Dialogue: 0,0:16:15.09,0:16:17.01,Default,,0,0,0,,О... сәлем Джейми
Dialogue: 0,0:16:17.10,0:16:19.14,Default,,0,0,0,,Бұл жігіт, сен бақыттысың.
Dialogue: 0,0:16:19.22,0:16:21.68,Default,,0,0,0,,Біреудің жоғалып кеткені туралы хабарлама алған кезде
Dialogue: 0,0:16:21.77,0:16:23.85,Default,,0,0,0,,Бұл қиын болған болуы керек.
Dialogue: 0,0:16:23.94,0:16:24.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:24.73,0:16:26.94,Default,,0,0,0,,«Мен де Дунаға барамын, көмектесемін».
Dialogue: 0,0:16:27.02,0:16:28.77,Default,,0,0,0,,Мынандай шу шығарып жатырсың.
Dialogue: 0,0:16:28.86,0:16:30.94,Default,,0,0,0,,Мен сені жұбатуға қиналдым.
Dialogue: 0,0:16:31.03,0:16:33.36,Default,,0,0,0,,Мен Юке жақсы болады дедім.
Dialogue: 0,0:16:33.45,0:16:35.61,Default,,0,0,0,,Уайымдап, көз жасын төгу
Dialogue: 0,0:16:35.70,0:16:37.24,Default,,0,0,0,,Сәлем Ғылмас!
Dialogue: 0,0:16:37.32,0:16:39.16,Default,,0,0,0,,Бұл жаман болды.
Dialogue: 0,0:16:39.24,0:16:40.70,Default,,0,0,0,,Рахмет, Джейми
Dialogue: 0,0:16:40.79,0:16:43.33,Default,,0,0,0,,Жоқ... Мен жыламаймын.
Dialogue: 0,0:16:43.41,0:16:45.83,Default,,0,0,0,,Бірақ сен уайымдадың.
Dialogue: 0,0:16:45.92,0:16:46.63,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:16:46.71,0:16:48.42,Default,,0,0,0,,Мен уайымдадым
Dialogue: 0,0:16:48.50,0:16:51.21,Default,,0,0,0,,Техтің дәрісін ала алмасам не істеймін?
Dialogue: 0,0:16:51.30,0:16:52.38,Default,,0,0,0,,Бұл алаңдаушылық
Dialogue: 0,0:16:52.46,0:16:55.26,Default,,0,0,0,,-(Юк) Хахаха... -Сен шыншыл емессің.
Dialogue: 0,0:16:55.34,0:16:58.43,Default,,0,0,0,,Басшылардың алаңдауы қалыпты жағдай емес.
Dialogue: 0,0:16:58.51,0:17:01.14,Default,,0,0,0,,Мен де Кловердің мүшесімін.
Dialogue: 0,0:17:01.22,0:17:02.10,Default,,0,0,0,,Иә
Dialogue: 0,0:17:02.60,0:17:07.48,Default,,0,0,0,,Эй, мен авантюрист болған кезде, мен бұл жолы Юкеге көмектесемін.
Dialogue: 0,0:17:07.56,0:17:08.40,Default,,0,0,0,,Мен қатты толқыдым.
Dialogue: 0,0:17:08.48,0:17:09.77,Default,,0,0,0,,Гилмас!
Dialogue: 0,0:17:09.86,0:17:13.03,Default,,0,0,0,,Мен сенен оны құпия ұстауды сұрамаймын.
Dialogue: 0,0:17:13.11,0:17:14.24,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:17:14.32,0:17:16.07,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:17:16.16,0:17:18.49,Default,,0,0,0,,Пфф…
Dialogue: 0,0:17:18.57,0:17:22.29,Default,,0,0,0,,Иә, бұл Юк Кловердің негізі.
Dialogue: 0,0:17:22.37,0:17:24.46,Default,,0,0,0,,Мен және жылжымайтын мүлік агенті дүйсенбі.
Dialogue: 0,0:17:24.54,0:17:25.75,Default,,0,0,0,,Мен оны бақылауда ұстадым.
Dialogue: 0,0:17:25.83,0:17:29.88,Default,,0,0,0,,Мен әзірге ингредиенттерді жинап, дайындадым.
Dialogue: 0,0:17:29.96,0:17:31.59,Default,,0,0,0,,Күтілгендей, сенімді
Dialogue: 0,0:17:31.67,0:17:33.88,Default,,0,0,0,,Үйге келгенде жақсылап демалыңыз.
Dialogue: 0,0:17:34.38,0:17:37.72,Default,,0,0,0,,Иә, жақында оралуымызды тойлайтын кеш болады.
Dialogue: 0,0:17:37.80,0:17:39.55,Default,,0,0,0,,Джейми де
Dialogue: 0,0:17:39.64,0:17:41.22,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:17:41.31,0:17:44.43,Default,,0,0,0,,Балалар сендерге кештер өте ұнайды.
Dialogue: 0,0:17:44.52,0:17:46.23,Default,,0,0,0,,Бенвуд келуге міндетті емес.
Dialogue: 0,0:17:46.31,0:17:49.77,Default,,0,0,0,,Жоқ, мен барамын, мен ішімдікті тегін іше аламын.
Dialogue: 0,0:17:49.86,0:17:52.23,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:17:54.32,0:17:57.45,Default,,0,0,0,,Джеймимен екінші қабаттағы шағын бөлме туралы сөйлесіңіз.
Dialogue: 0,0:17:57.53,0:17:58.99,Default,,0,0,0,,Кішкене жөндеу
Dialogue: 0,0:17:59.07,0:18:01.99,Default,,0,0,0,,Нибельннің өмірін жеңілдету.
Dialogue: 0,0:18:02.08,0:18:03.20,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:18:03.29,0:18:04.87,Default,,0,0,0,,Иә, Ранның бөлмесі!
Dialogue: 0,0:18:04.95,0:18:08.08,Default,,0,0,0,,Сондай-ақ, жуынатын бөлменің есігі сәл бос болды.
Dialogue: 0,0:18:08.17,0:18:09.37,Default,,0,0,0,,жөнделді
Dialogue: 0,0:18:09.46,0:18:11.50,Default,,0,0,0,,Қалғанының бәрі жақсы.
Dialogue: 0,0:18:11.59,0:18:12.96,Default,,0,0,0,,Тағы да бәрі
Dialogue: 0,0:18:13.05,0:18:16.13,Default,,0,0,0,,Үйге аман-есен оралғаныңызға қуаныштымын.
Dialogue: 0,0:18:16.22,0:18:18.68,Default,,0,0,0,,Жақсылап демалыңыз.
Dialogue: 0,0:18:18.76,0:18:22.01,Default,,0,0,0,,Дүйсенбі мырза, мен жоқта уақыт бөлгеніңізге рахмет.
Dialogue: 0,0:18:22.10,0:18:24.89,Default,,0,0,0,,-Иә, шынымен -Рахмет
Dialogue: 0,0:18:24.97,0:18:27.10,Default,,0,0,0,,Енді кешіріңіз.
Dialogue: 0,0:18:30.69,0:18:33.32,Default,,0,0,0,,Бүгіннен бастап сіз осында тұратын боласыз.
Dialogue: 0,0:18:34.07,0:18:35.11,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:18:35.19,0:18:37.07,Default,,0,0,0,,Бірге шомылайық
Dialogue: 0,0:18:37.15,0:18:38.24,Default,,0,0,0,,Енгізіңіз!
Dialogue: 0,0:18:38.32,0:18:39.32,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:18:39.40,0:18:40.99,Default,,0,0,0,,Оған не кіреді?
Dialogue: 0,0:18:41.49,0:18:42.20,Default,,0,0,0,,Ванна!
Dialogue: 0,0:18:42.28,0:18:43.95,Default,,0,0,0,,Юк те кіреді ме?
Dialogue: 0,0:18:44.54,0:18:45.29,Default,,0,0,0,,А...
Dialogue: 0,0:18:45.37,0:18:47.37,Default,,0,0,0,,Мені мазақ етпе
Dialogue: 0,0:18:47.87,0:18:49.33,Default,,0,0,0,,Бәріңе сәлем, өтінемін?
Dialogue: 0,0:18:49.41,0:18:50.54,Default,,0,0,0,,Иә
Dialogue: 0,0:18:50.62,0:18:52.42,Default,,0,0,0,,Осы жолы тынымсыз еңбек еткеніңіз үшін рахмет.
Dialogue: 0,0:18:52.92,0:18:56.96,Default,,0,0,0,,Алдағы жоспарларыма келетін болсақ, біраз уақыт үзіліс жасаймын деп ойлаймын.
Dialogue: 0,0:18:57.05,0:18:58.05,Default,,0,0,0,,Иә
Dialogue: 0,0:18:58.13,0:19:01.22,Default,,0,0,0,,Бірақ демалғысы келмейтін адам – мұғалім.
Dialogue: 0,0:19:02.01,0:19:04.10,Default,,0,0,0,,Юке мырза жақсы демалып жатыр.
Dialogue: 0,0:19:04.18,0:19:04.85,Default,,0,0,0,,Иә
Dialogue: 0,0:19:04.93,0:19:06.22,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,0:19:06.31,0:19:08.14,Default,,0,0,0,,Бұл күдікті.
Dialogue: 0,0:19:08.23,0:19:10.69,Default,,0,0,0,,Рун-чан, Юк дұрыс демала ма?
Dialogue: 0,0:19:10.77,0:19:12.48,Default,,0,0,0,,Оны мұқият бақылап отырайық.
Dialogue: 0,0:19:12.56,0:19:14.48,Default,,0,0,0,,- (Нибельн) Иә! -(Юк) Ахах...
Dialogue: 0,0:19:14.57,0:19:18.24,Default,,0,0,0,,Аа, бүгін Скордия эфирі емес пе еді?
Dialogue: 0,0:19:18.32,0:19:20.95,Default,,0,0,0,,Ал, мен планшетті саламын.
Dialogue: 0,0:19:21.03,0:19:22.11,Default,,0,0,0,,Сондай-ақ «Іске қосу» бөлімін қараңыз
Dialogue: 0,0:19:22.20,0:19:25.20,Default,,0,0,0,,Марина Нене жүгіруді күтіңіз
Dialogue: 0,0:19:25.70,0:19:27.70,Default,,0,0,0,,Алдымен заттарыңызды жинап алыңыз.
Dialogue: 0,0:19:27.79,0:19:29.50,Default,,0,0,0,,-Мен мұны кейінірек жасаймын -ssu~
Dialogue: 0,0:19:29.58,0:19:31.58,Default,,0,0,0,,Ах… олар ақылды да, сүйкімді де көрінеді, иә, Аня?
Dialogue: 0,0:19:33.54,0:19:35.88,Default,,0,0,0,,Тек... сәл ғана.
Dialogue: 0,0:19:35.96,0:19:37.88,Default,,0,0,0,,Иә! жібек рахмет
Dialogue: 0,0:19:37.96,0:19:39.67,Default,,0,0,0,,-(Нибельн) Рахмет -ssu
Dialogue: 0,0:19:39.76,0:19:42.43,Default,,0,0,0,,-Балалар, оны асыға күтіп отырсыңдар.
Dialogue: 0,0:19:42.51,0:19:45.22,Default,,0,0,0,,Бірақ шын мәнінде мен де қызық болдым.
Dialogue: 0,0:19:51.10,0:19:52.94,Default,,0,0,0,,-Юк - (Юк) А?
Dialogue: 0,0:19:53.02,0:19:55.69,Default,,0,0,0,,Сіз қайтадан қиын болып көрінесіз.
Dialogue: 0,0:19:55.77,0:19:57.86,Default,,0,0,0,,Иә? Шынымен бе?
Dialogue: 0,0:19:57.94,0:20:01.07,Default,,0,0,0,,Мен тек болашақты ойладым.
Dialogue: 0,0:20:01.15,0:20:04.41,Default,,0,0,0,,Сондықтан мен Юкеге бақылау жасауым керек.
Dialogue: 0,0:20:04.49,0:20:06.91,Default,,0,0,0,,Мен саған жаңа ғана демалып ал дедім.
Dialogue: 0,0:20:07.41,0:20:08.45,Default,,0,0,0,,Мүлдем емес.
Dialogue: 0,0:20:10.62,0:20:13.00,Default,,0,0,0,,Сәлем Юк
Dialogue: 0,0:20:13.08,0:20:13.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:15.08,0:20:16.67,Default,,0,0,0,,Юк керемет
Dialogue: 0,0:20:17.88,0:20:20.71,Default,,0,0,0,,Бізге көп көмек көрсетілді.
Dialogue: 0,0:20:21.22,0:20:24.80,Default,,0,0,0,,Мен тек Yuke болған кезде бәрін істей алатынымды сезінемін.
Dialogue: 0,0:20:25.47,0:20:26.89,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:20:26.97,0:20:28.26,Default,,0,0,0,,Керісінше, I
Dialogue: 0,0:20:28.35,0:20:30.81,Default,,0,0,0,,Маған барлығы көмектесіп жатыр деп ойлаймын.
Dialogue: 0,0:20:30.89,0:20:32.18,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:32.27,0:20:34.44,Default,,0,0,0,,Юкті сол қалпында қалдыруға болады.
Dialogue: 0,0:20:35.19,0:20:36.69,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:20:36.77,0:20:38.86,Default,,0,0,0,,Сіз қайтадан қиын болып көрінесіз.
Dialogue: 0,0:20:38.94,0:20:39.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:40.15,0:20:41.90,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:20:41.99,0:20:44.07,Default,,0,0,0,,Юк Бүгін ішейік.
Dialogue: 0,0:20:44.15,0:20:46.16,Default,,0,0,0,,Бұл туралы ойланбастан
Dialogue: 0,0:20:46.24,0:20:48.20,Default,,0,0,0,,Дұрыс, ол құлағанша.
Dialogue: 0,0:20:49.45,0:20:50.20,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:50.29,0:20:53.96,Default,,0,0,0,,Егер сәтсіз болсаң, таңға дейін жаныңда боламын.
Dialogue: 0,0:20:55.08,0:20:56.46,Default,,0,0,0,,О, жаңбыр
Dialogue: 0,0:20:57.54,0:21:00.09,Default,,0,0,0,,-Олай болса, кеттік.-(Юк) Иә.
Dialogue: 0,0:21:00.17,0:21:02.30,Default,,0,0,0,,А, Юк, кешігіп қалдың.
Dialogue: 0,0:21:02.38,0:21:03.42,Default,,0,0,0,,-(Юк) Күткеніңізге рахмет -Кеш болды~
Dialogue: 0,0:21:03.51,0:21:05.80,Default,,0,0,0,,- (Нибел) Қарным ашты - кешіріңіз
Dialogue: 0,0:21:05.88,0:21:07.59,Default,,0,0,0,,Мұғалім, әдеттегідей.
Dialogue: 0,0:21:07.68,0:21:10.14,Default,,0,0,0,,Содан кейін, Кловерге.
Dialogue: 0,0:21:10.22,0:21:11.97,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:21:16.06,0:21:18.06,Default,,0,0,0,,♪～
Dialogue: 0,0:22:43.98,0:22:45.98,Default,,0,0,0,,～♪
Dialogue: 0,0:22:46.78,0:22:49.40,Default,,0,0,0,,Келесі жолы «Патша бұйрығы»
