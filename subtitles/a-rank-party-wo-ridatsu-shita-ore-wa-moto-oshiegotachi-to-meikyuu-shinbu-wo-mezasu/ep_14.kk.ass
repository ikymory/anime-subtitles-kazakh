Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.50,0:00:03.50,Default,,0,0,0,,♪～
Dialogue: 0,0:01:28.92,0:01:30.92,Default,,0,0,0,,～♪
Dialogue: 0,0:01:41.05,0:01:43.43,Default,,0,0,0,,Сонымен лабиринт
Dialogue: 0,0:01:43.52,0:01:47.23,Default,,0,0,0,,Басқа әлемде, Glad She-Im деген қалада.
Dialogue: 0,0:01:47.31,0:01:50.94,Default,,0,0,0,,Водан патша қала мен халықты құтқаруға тырысты.
Dialogue: 0,0:01:51.52,0:01:53.23,Default,,0,0,0,,Арнайы сиқырды қолдану
Dialogue: 0,0:01:53.73,0:01:57.95,Default,,0,0,0,,Бұл сіз біздің әлемде өлшемдерге тап болдыңыз дегенді білдіре ме?
Dialogue: 0,0:01:58.03,0:01:59.11,Default,,0,0,0,,Иә
Dialogue: 0,0:01:59.20,0:02:00.82,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:02:00.91,0:02:03.37,Default,,0,0,0,,Тұрғындар жойылады
Dialogue: 0,0:02:03.45,0:02:06.25,Default,,0,0,0,,Біртүрлі құбыжық айналып жүрген сияқты.
Dialogue: 0,0:02:06.33,0:02:08.46,Default,,0,0,0,,Бұл құбыжықтар
Dialogue: 0,0:02:08.54,0:02:10.96,Default,,0,0,0,,Мен Glad She-Im тұрғынымын.
Dialogue: 0,0:02:11.04,0:02:13.09,Default,,0,0,0,,(Қатты желдің дыбысы)
Dialogue: 0,0:02:15.17,0:02:18.34,Default,,0,0,0,,Адамдығыңды құрбан еттің.
Dialogue: 0,0:02:18.42,0:02:19.84,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:02:19.93,0:02:22.05,Default,,0,0,0,,(Саяма) Тыныш бол, бәрің!
Dialogue: 0,0:02:22.55,0:02:25.18,Default,,0,0,0,,Мен бұл туралы біраздан бері ойланып жүрмін.
Dialogue: 0,0:02:25.27,0:02:27.35,Default,,0,0,0,,Бұл сиқырлы құрал (артефакт) қандай?
Dialogue: 0,0:02:27.43,0:02:29.39,Default,,0,0,0,,Мұны Рейн-кун сұрады.
Dialogue: 0,0:02:29.48,0:02:31.31,Default,,0,0,0,,Мен оны өзім жасадым.
Dialogue: 0,0:02:31.86,0:02:34.98,Default,,0,0,0,,Бұл сақиналарды талдауға арналған... иә?
Dialogue: 0,0:02:35.07,0:02:36.57,Default,,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:02:43.32,0:02:44.87,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:02:44.95,0:02:46.66,Default,,0,0,0,,Батып бара жатқан күн жауған —
Dialogue: 0,0:02:46.74,0:02:49.33,Default,,0,0,0,,Өткен күндердің қуанышты әйелі
Dialogue: 0,0:02:49.41,0:02:52.71,Default,,0,0,0,,Сонымен құбыжықтан табылған сақина
Dialogue: 0,0:02:52.79,0:02:54.75,Default,,0,0,0,,Сіз бұл көрнекі құрал деп айтасыз ба?
Dialogue: 0,0:02:55.34,0:02:57.67,Default,,0,0,0,,Ағындағы сиқырлы тас сияқты
Dialogue: 0,0:02:59.47,0:03:00.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:00.59,0:03:03.30,Default,,0,0,0,,Мен де басында солай ойладым.
Dialogue: 0,0:03:03.80,0:03:06.31,Default,,0,0,0,,Бұл қоңырау...
Dialogue: 0,0:03:07.10,0:03:09.89,Default,,0,0,0,,Адамның өзі туралы мәлімет
Dialogue: 0,0:03:09.98,0:03:11.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:11.35,0:03:14.90,Default,,0,0,0,,Водан патша қаладан қалаға көшті.
Dialogue: 0,0:03:14.98,0:03:18.15,Default,,0,0,0,,Бірақ сиқыр аяқталмады.
Dialogue: 0,0:03:18.23,0:03:21.40,Default,,0,0,0,,Адам ретінде өлшемдерді кесіп өту қиын.
Dialogue: 0,0:03:21.49,0:03:25.28,Default,,0,0,0,,Онда адам болмаса жақсы болар еді.
Dialogue: 0,0:03:25.87,0:03:27.87,Default,,0,0,0,,Патша солай ойлады.
Dialogue: 0,0:03:28.62,0:03:31.54,Default,,0,0,0,,Бұл ақылсыз идея
Dialogue: 0,0:03:31.62,0:03:36.17,Default,,0,0,0,,Батып бара жатқан күн патшаға әбден әсер еткен болуы керек.
Dialogue: 0,0:03:38.67,0:03:39.80,Default,,0,0,0,,Король Водан
Dialogue: 0,0:03:39.88,0:03:44.30,Default,,0,0,0,,Оның «бір алтын» деп аталатын бірдеңесі болды.
Dialogue: 0,0:03:44.89,0:03:48.97,Default,,0,0,0,,Бұл не және оны қайдан алдың?
Dialogue: 0,0:03:49.06,0:03:50.73,Default,,0,0,0,,Әлі де тергеуде
Dialogue: 0,0:03:51.23,0:03:52.89,Default,,0,0,0,,Алтын әулие қыз айтады...
Dialogue: 0,0:03:52.98,0:03:55.48,Default,,0,0,0,,Адамдар ұстамау керек нәрселер
Dialogue: 0,0:03:55.56,0:03:57.40,Default,,0,0,0,,Қарғыс атқан құдіретті
Dialogue: 0,0:03:57.48,0:04:01.24,Default,,0,0,0,,Барлық тілектеріңізді орындай алатын дүние ағашының жемісі.
Dialogue: 0,0:04:01.74,0:04:07.37,Default,,0,0,0,,Бір кесек алтын патшаның тілегін орындап, алтын сақина пайда болды.
Dialogue: 0,0:04:07.45,0:04:12.83,Default,,0,0,0,,Патша сақинаны өз халқына беріп, өлшемдерді аралап шықты.
Dialogue: 0,0:04:12.91,0:04:14.21,Default,,0,0,0,,Нәтиже...
Dialogue: 0,0:04:14.29,0:04:17.92,Default,,0,0,0,,Аяқталмаған сиқыр мен батып бара жатқан күннің әсерінен,
Dialogue: 0,0:04:18.00,0:04:19.84,Default,,0,0,0,,Адамдар құбыжықтарға айналды
Dialogue: 0,0:04:19.92,0:04:22.17,Default,,0,0,0,,Град Ше-Им зынданға айналады.
Dialogue: 0,0:04:22.26,0:04:24.01,Default,,0,0,0,,Бұл дүниеде пайда болды
Dialogue: 0,0:04:24.09,0:04:25.09,Default,,0,0,0,,Иә
Dialogue: 0,0:04:25.18,0:04:28.10,Default,,0,0,0,,(Қатты желдің дыбысы)
Dialogue: 0,0:04:28.18,0:04:32.52,Default,,0,0,0,,Оны сол күйінде қалдырсақ не болады?
Dialogue: 0,0:04:32.60,0:04:33.73,Default,,0,0,0,,Құрметті батыр
Dialogue: 0,0:04:33.81,0:04:36.56,Default,,0,0,0,,Алтын әулие де былай деді:
Dialogue: 0,0:04:36.65,0:04:38.27,Default,,0,0,0,,Юк Фердио
Dialogue: 0,0:04:38.77,0:04:42.82,Default,,0,0,0,,Ымырт патшасын тоқтатыңыз және алтынды жойыңыз
Dialogue: 0,0:04:42.90,0:04:48.91,Default,,0,0,0,,Әйтпесе, бұл дүние де ымыртта жұтылады.
Dialogue: 0,0:04:49.41,0:04:51.58,Default,,0,0,0,,(Қатты желдің дыбысы)
Dialogue: 0,0:04:52.95,0:04:56.08,Default,,0,0,0,,Ол дұрыс, оны жоюдан басқа амалымыз жоқ.
Dialogue: 0,0:04:56.17,0:04:57.83,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:04:57.92,0:04:59.46,Default,,0,0,0,,Бізде мұны істеуден басқа амал жоқ.
Dialogue: 0,0:05:00.30,0:05:01.84,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:03.51,0:05:04.76,Default,,0,0,0,,Юк Фердио
Dialogue: 0,0:05:04.84,0:05:08.22,Default,,0,0,0,,Сізге батыр ретінде міндеттер мен құқықтар берілген.
Dialogue: 0,0:05:08.80,0:05:10.60,Default,,0,0,0,,Патшалыққа қызмет ет
Dialogue: 0,0:05:11.26,0:05:12.10,Default,,0,0,0,,Иә
Dialogue: 0,0:05:12.81,0:05:15.35,Default,,0,0,0,,Мама, қарным ашты.
Dialogue: 0,0:05:15.44,0:05:16.23,Default,,0,0,0,,О.
Dialogue: 0,0:05:16.31,0:05:19.23,Default,,0,0,0,,Олай болса кешкі асты көп жасап алайық.
Dialogue: 0,0:05:19.31,0:05:21.07,Default,,0,0,0,,Бұл дүние
Dialogue: 0,0:05:21.15,0:05:23.86,Default,,0,0,0,,Батып бара жатқан күннің мені жұтып қоюына жол бермеймін.
Dialogue: 0,0:05:23.94,0:05:25.99,Default,,0,0,0,,Қастардың арасындағы Юку
Dialogue: 0,0:05:26.07,0:05:27.24,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:28.57,0:05:30.32,Default,,0,0,0,,Қонақ үйге оралу
Dialogue: 0,0:05:30.41,0:05:33.16,Default,,0,0,0,,Мүмкіндігінше көп демалыңыз.
Dialogue: 0,0:05:33.24,0:05:33.87,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:05:33.95,0:05:35.62,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:35.71,0:05:37.12,Default,,0,0,0,,Әрқашан жақсы орындаңыз
Dialogue: 0,0:05:37.21,0:05:39.75,Default,,0,0,0,,көрсете білуі керек
Dialogue: 0,0:05:39.83,0:05:40.88,Default,,0,0,0,,Иә
Dialogue: 0,0:05:44.76,0:05:45.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:48.89,0:05:50.22,Default,,0,0,0,,Мен сені іздедім.
Dialogue: 0,0:05:51.47,0:05:52.47,Default,,0,0,0,,Кім?
Dialogue: 0,0:05:54.31,0:05:56.35,Default,,0,0,0,,Ренис ағаңыз.
Dialogue: 0,0:05:56.43,0:05:57.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:57.69,0:05:59.81,Default,,0,0,0,,Хат келді.
Dialogue: 0,0:05:59.90,0:06:01.48,Default,,0,0,0,,Тез кел.
Dialogue: 0,0:06:01.56,0:06:05.74,Default,,0,0,0,,Мен сіздің кім екеніңізді білмеймін, бірақ қате адам екеніңізге сенімдісіз бе?
Dialogue: 0,0:06:05.82,0:06:09.11,Default,,0,0,0,,Сіз Юк Фердиосыз ба?
Dialogue: 0,0:06:09.20,0:06:11.28,Default,,0,0,0,,Қыз бала біздің отбасымыз.
Dialogue: 0,0:06:11.37,0:06:12.99,Default,,0,0,0,,Оны тапсырайық
Dialogue: 0,0:06:13.08,0:06:14.37,Default,,0,0,0,,Енді?
Dialogue: 0,0:06:14.45,0:06:17.46,Default,,0,0,0,,Мен оны өмір бойы жалғыздықта деп естідім?
Dialogue: 0,0:06:18.12,0:06:21.29,Default,,0,0,0,,Ұстап алшы, аздап ренжіп қалсаң бәрібір.
Dialogue: 0,0:06:21.38,0:06:22.25,Default,,0,0,0,,Иә
Dialogue: 0,0:06:22.34,0:06:23.29,Default,,0,0,0,,Тұзақ
Dialogue: 0,0:06:24.38,0:06:25.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:25.38,0:06:26.63,Default,,0,0,0,,Ұйқы тұманы
Dialogue: 0,0:06:28.42,0:06:29.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:29.38,0:06:30.38,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:06:30.47,0:06:32.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:33.51,0:06:38.64,Default,,0,0,0,,Мен... Мен Бран Клаудамын, граф Клауда отбасының өкілімін.
Dialogue: 0,0:06:38.73,0:06:42.44,Default,,0,0,0,,Ондағы Ренилер қазіргі отағасы Димиттің қызы.
Dialogue: 0,0:06:42.52,0:06:43.94,Default,,0,0,0,,Беру
Dialogue: 0,0:06:44.02,0:06:45.44,Default,,0,0,0,,Өлемін деп ойлайтын ешқандай жағдайға тап болған емеспін
Dialogue: 0,0:06:45.53,0:06:47.61,Default,,0,0,0,,Хат келуі керек еді.
Dialogue: 0,0:06:47.69,0:06:48.49,Default,,0,0,0,,Ренис
Dialogue: 0,0:06:48.57,0:06:51.45,Default,,0,0,0,,Оны Салмутарий патша отбасына ұсыну туралы шешім қабылданды.
Dialogue: 0,0:06:51.53,0:06:54.20,Default,,0,0,0,,Мен мұны естіген жоқпын және мойындай алмаймын.
Dialogue: 0,0:06:54.28,0:06:55.62,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:06:55.70,0:06:58.62,Default,,0,0,0,,Раин ненің негізінде графтың қызы?
Dialogue: 0,0:06:58.70,0:07:00.21,Default,,0,0,0,,Сіз бұл Ренис деп айтасыз ба?
Dialogue: 0,0:07:00.29,0:07:01.46,Default,,0,0,0,,Дәлел дегеніміз не?
Dialogue: 0,0:07:01.54,0:07:03.46,Default,,0,0,0,,Бұл дәлелдеме ме?
Dialogue: 0,0:07:03.54,0:07:09.30,Default,,0,0,0,,Сондай-ақ, егер ақсүйек дәрежесі бар адам басқа елдің тұрғынымен некелік қатынасқа түссе,
Dialogue: 0,0:07:09.38,0:07:11.55,Default,,0,0,0,,Рұқсат қажет
Dialogue: 0,0:07:11.63,0:07:12.84,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,0:07:12.93,0:07:15.10,Default,,0,0,0,,Жақсы мырза...
Dialogue: 0,0:07:15.18,0:07:18.60,Default,,0,0,0,,Басқаша айтқанда, сіз граф Клауда отбасысыз.
Dialogue: 0,0:07:18.68,0:07:21.69,Default,,0,0,0,,Өйткені олар біздің қандас туыстарымыз болуы мүмкін
Dialogue: 0,0:07:21.77,0:07:25.06,Default,,0,0,0,,Рейнді ұрлап, Сармуталияға сатыңыз
Dialogue: 0,0:07:25.15,0:07:27.23,Default,,0,0,0,,Корольдік отбасына рұқсатсыз қосылу
Dialogue: 0,0:07:27.32,0:07:29.82,Default,,0,0,0,,Демек, сіз пайда табуға тырысасыз ба?
Dialogue: 0,0:07:29.90,0:07:31.90,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:07:31.99,0:07:35.12,Default,,0,0,0,,Клаудия есімінің арқасында сіз патшайым тәжін киесіз.
Dialogue: 0,0:07:35.20,0:07:37.83,Default,,0,0,0,,Сізге пайдалы болатын уақыт келді.
Dialogue: 0,0:07:37.91,0:07:41.96,Default,,0,0,0,,Ренис, кел, әкең сені көргісі келді.
Dialogue: 0,0:07:42.04,0:07:44.00,Default,,0,0,0,,Жарық жарқылы, ату
Dialogue: 0,0:07:44.50,0:07:46.21,Default,,0,0,0,,Мен сенімен кездескім келмейді.
Dialogue: 0,0:07:46.29,0:07:48.59,Default,,0,0,0,,О... сіз патшайым бола аласыз.
Dialogue: 0,0:07:48.67,0:07:50.47,Default,,0,0,0,,Энергетикалық болт
Dialogue: 0,0:07:52.63,0:07:54.18,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:07:54.26,0:07:55.51,Default,,0,0,0,,...
Dialogue: 0,0:07:55.60,0:07:59.06,Default,,0,0,0,,Мен Кловердегі Рейнис емеспін.
Dialogue: 0,0:07:59.14,0:08:00.52,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:08:04.27,0:08:06.56,Default,,0,0,0,,Куууу…
Dialogue: 0,0:08:08.94,0:08:10.74,Default,,0,0,0,,Сіз оны жақсы қайтара алдыңыз.
Dialogue: 0,0:08:11.24,0:08:13.49,Default,,0,0,0,,Иә, Юкке рахмет.
Dialogue: 0,0:08:13.57,0:08:16.99,Default,,0,0,0,,Мамару-санға Раинның графтың қызы екенін дәлелдеңіз.
Dialogue: 0,0:08:17.07,0:08:19.74,Default,,0,0,0,,Оның жойылғаны дұрыс болды.
Dialogue: 0,0:08:19.83,0:08:20.91,Default,,0,0,0,,Иә
Dialogue: 0,0:08:21.00,0:08:24.92,Default,,0,0,0,,Мен Финиске қайтып келгенде, Мамару-санға алғыс айтуым керек.
Dialogue: 0,0:08:25.54,0:08:27.04,Default,,0,0,0,,Хаа…
Dialogue: 0,0:08:27.13,0:08:29.13,Default,,0,0,0,,Мүмкін мен аздап шаршаған шығармын
Dialogue: 0,0:08:29.21,0:08:31.13,Default,,0,0,0,,Ыстық бұлақтардағы емдік
Dialogue: 0,0:08:31.63,0:08:32.88,Default,,0,0,0,,Мен де солай істеймін.
Dialogue: 0,0:08:33.47,0:08:34.63,Default,,0,0,0,,Біз бірге кірейік пе?
Dialogue: 0,0:08:35.89,0:08:39.14,Default,,0,0,0,,Менің бір ісім бар, бірінші барыңыз.
Dialogue: 0,0:08:39.22,0:08:41.52,Default,,0,0,0,,Бір сәтке адасып қалдыңыз ба?
Dialogue: 0,0:08:41.60,0:08:42.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:42.85,0:08:45.27,Default,,0,0,0,,Шынында жыртылған екен ғой?
Dialogue: 0,0:08:49.82,0:08:52.03,Default,,0,0,0,,Кебек Моно қайда орналасқан?
Dialogue: 0,0:08:52.11,0:08:57.49,Default,,0,0,0,,Ал... Мен осы мәселеге біраз уақыт бөлгім келеді.
Dialogue: 0,0:08:57.57,0:09:00.74,Default,,0,0,0,,Менің ойымша, уәде етілген күн жақындап қалды.
Dialogue: 0,0:09:00.83,0:09:04.37,Default,,0,0,0,,Ренис – авантюрист.
Dialogue: 0,0:09:04.46,0:09:07.08,Default,,0,0,0,,Аздап жаман мінез
Dialogue: 0,0:09:07.17,0:09:10.50,Default,,0,0,0,,Мен сені Мастұма-самаға шақырсам да,
Dialogue: 0,0:09:10.59,0:09:12.76,Default,,0,0,0,,Маған сиқырлы оқ тиді...
Dialogue: 0,0:09:12.84,0:09:15.97,Default,,0,0,0,,Хмф, әйел еркекке қол көтере ме?
Dialogue: 0,0:09:16.05,0:09:19.26,Default,,0,0,0,,Мен Вельмерия елін түсінбеймін.
Dialogue: 0,0:09:19.35,0:09:22.35,Default,,0,0,0,,Жарайды... Мен оны тезірек дайындаймын.
Dialogue: 0,0:09:22.43,0:09:24.77,Default,,0,0,0,,Біраз күтіңіз.
Dialogue: 0,0:09:24.85,0:09:26.31,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:09:26.81,0:09:30.98,Default,,0,0,0,,Ол қыздың басқа әйелдерде жоқ пайдасы бар.
Dialogue: 0,0:09:31.07,0:09:32.48,Default,,0,0,0,,Ха... иә?
Dialogue: 0,0:09:32.57,0:09:34.82,Default,,0,0,0,,-Ноу Блан -Ах... иә.
Dialogue: 0,0:09:34.90,0:09:36.53,Default,,0,0,0,,Осы кезде
Dialogue: 0,0:09:36.61,0:09:39.95,Default,,0,0,0,,Әйелдерді де Ренистің қасына жинай аламыз ба?
Dialogue: 0,0:09:40.03,0:09:40.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:41.03,0:09:44.45,Default,,0,0,0,,Патшайым мұны істей алмайды, бірақ оның пайдасы бар.
Dialogue: 0,0:09:44.54,0:09:46.33,Default,,0,0,0,,Тынш, бірақ бұл...
Dialogue: 0,0:09:46.41,0:09:49.42,Default,,0,0,0,,Ақшаны 3 есе жұмсайық... жоқ, ақшаны 5 есе.
Dialogue: 0,0:09:49.50,0:09:50.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:51.59,0:09:55.09,Default,,0,0,0,,Түсіндім, маған қалдырыңыз.
Dialogue: 0,0:09:55.17,0:09:58.05,Default,,0,0,0,,Мен көремін, содан кейін түс.
Dialogue: 0,0:09:58.13,0:09:59.72,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:02.68,0:10:04.85,Default,,0,0,0,,Хэхе... 5 рет?
Dialogue: 0,0:10:04.93,0:10:08.31,Default,,0,0,0,,Мен не болса да беде аламын.
Dialogue: 0,0:10:08.39,0:10:10.23,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:10:10.31,0:10:12.23,Default,,0,0,0,,(Нибельннің гуілдеуі)
Dialogue: 0,0:10:12.90,0:10:16.28,Default,,0,0,0,,Дұрыс, Нибельн-чан, сен жақсысың.
Dialogue: 0,0:10:16.36,0:10:17.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:17.99,0:10:19.16,Default,,0,0,0,,Сондықтан...
Dialogue: 0,0:10:19.66,0:10:21.99,Default,,0,0,0,,Бір алтынды жою
Dialogue: 0,0:10:22.07,0:10:24.49,Default,,0,0,0,,Glad She-Im-дің ең терең бөлігіне ұмтылу
Dialogue: 0,0:10:24.99,0:10:29.54,Default,,0,0,0,,Мүмкін, Водан қамалында патшалардың арасында алтынның сынығы бар шығар.
Dialogue: 0,0:10:30.50,0:10:32.17,Default,,0,0,0,,Бұл қиын квест болады деп ойлаймын.
Dialogue: 0,0:10:32.92,0:10:33.67,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:10:34.17,0:10:35.42,Default,,0,0,0,,-Иә -Иә
Dialogue: 0,0:10:35.50,0:10:38.05,Default,,0,0,0,,Көп уайымдамаңыз
Dialogue: 0,0:10:38.13,0:10:39.80,Default,,0,0,0,,Бетіңізге көрінді ме?
Dialogue: 0,0:10:39.88,0:10:42.80,Default,,0,0,0,,Жарайды, қолымыздан келеді.
Dialogue: 0,0:10:42.89,0:10:44.06,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:44.14,0:10:47.56,Default,,0,0,0,,Кловердегі бәріміз бірге жұмыс жасасақ, қолымыздан бәрі келеді!
Dialogue: 0,0:10:47.64,0:10:50.64,Default,,0,0,0,,Мен Юке мырзаға қиындық тудырмаймын.
Dialogue: 0,0:10:50.73,0:10:53.69,Default,,0,0,0,,Иә, бізді асыра қорғама.
Dialogue: 0,0:10:53.77,0:10:56.19,Default,,0,0,0,,Түсіндім, рахмет
Dialogue: 0,0:10:58.90,0:11:03.12,Default,,0,0,0,,Енді, Нене мен Марина, шығын материалдарын сатып алыңыз.
Dialogue: 0,0:11:03.20,0:11:04.08,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:11:04.16,0:11:06.41,Default,,0,0,0,,Рун-чан, мен сені өзіммен бірге ала аламын ба?
Dialogue: 0,0:11:06.49,0:11:08.12,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:11:08.20,0:11:09.62,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:11:09.71,0:11:10.75,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:11:10.83,0:11:12.54,Default,,0,0,0,,Кейін кездескенше
Dialogue: 0,0:11:12.63,0:11:15.59,Default,,0,0,0,,Мұғалім кешкі асқа дейін ыстық суға шомылды.
Dialogue: 0,0:11:15.67,0:11:17.21,Default,,0,0,0,,Уақытыңызды бөліңіз
Dialogue: 0,0:11:17.30,0:11:19.34,Default,,0,0,0,,Жаңбыр да үзіліс жасайды.
Dialogue: 0,0:11:19.42,0:11:20.34,Default,,0,0,0,,Иә
Dialogue: 0,0:11:20.42,0:11:21.68,Default,,0,0,0,,Жоқ, жібек
Dialogue: 0,0:11:21.76,0:11:24.64,Default,,0,0,0,,Алдымен зынданға шабуылыңызды жоспарлаңыз.
Dialogue: 0,0:11:25.18,0:11:28.85,Default,,0,0,0,,Мен мұны кешкі астан кейін барлығымен талқылағым келеді.
Dialogue: 0,0:11:28.93,0:11:29.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:30.06,0:11:32.35,Default,,0,0,0,,Сенсей?
Dialogue: 0,0:11:32.44,0:11:34.36,Default,,0,0,0,,Юуку?
Dialogue: 0,0:11:34.98,0:11:37.73,Default,,0,0,0,,Мен... жарайсың ба?
Dialogue: 0,0:11:37.82,0:11:39.19,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:11:39.28,0:11:42.11,Default,,0,0,0,,Мен сенің кеше түнде ұйықтамағаныңды білемін.
Dialogue: 0,0:11:42.20,0:11:45.16,Default,,0,0,0,,Бұл рас...
Dialogue: 0,0:11:45.24,0:11:47.66,Default,,0,0,0,,Жаңбыр, сені ыстық бұлақтарға апарайық.
Dialogue: 0,0:11:48.16,0:11:49.12,Default,,0,0,0,,Жарайды
Dialogue: 0,0:11:51.21,0:11:52.46,Default,,0,0,0,,Тоқта, күт, түсіндім.
Dialogue: 0,0:11:52.54,0:11:54.50,Default,,0,0,0,,Мен демаламын. Күте тұрыңыз.
Dialogue: 0,0:11:54.58,0:11:56.59,Default,,0,0,0,,Иә, иә, барамын.
Dialogue: 0,0:11:56.67,0:11:58.09,Default,,0,0,0,,Ойлану
Dialogue: 0,0:12:03.43,0:12:05.72,Default,,0,0,0,,Жағдайды реттеп көрейін.
Dialogue: 0,0:12:05.80,0:12:07.47,Default,,0,0,0,,Иә мырза
Dialogue: 0,0:12:07.56,0:12:11.10,Default,,0,0,0,,Мен неге екеуіңмен бірге ыстық бұлақта жүрмін?
Dialogue: 0,0:12:11.18,0:12:13.10,Default,,0,0,0,,Мұғалімді жалғыз қалдыру
Dialogue: 0,0:12:13.19,0:12:16.27,Default,,0,0,0,,Өйткені жұмысты кез келген жерден бастауға болады.
Dialogue: 0,0:12:16.94,0:12:19.02,Default,,0,0,0,,Юке көп ұзамай оны асыра алады.
Dialogue: 0,0:12:19.11,0:12:21.57,Default,,0,0,0,,Мен... Мен оны білемін.
Dialogue: 0,0:12:21.65,0:12:23.61,Default,,0,0,0,,Бірақ бұл ауыртпайды.
Dialogue: 0,0:12:23.70,0:12:27.53,Default,,0,0,0,,Мен барлығына қолымнан келгеннің бәрін жасағым келеді.
Dialogue: 0,0:12:27.62,0:12:28.58,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:12:28.66,0:12:31.58,Default,,0,0,0,,Мұғалім осылайша қулық танытады.
Dialogue: 0,0:12:32.25,0:12:33.29,Default,,0,0,0,,Әй...
Dialogue: 0,0:12:34.17,0:12:36.58,Default,,0,0,0,,Бұл өзімді қауіпсіз сезінеді.
Dialogue: 0,0:12:37.08,0:12:40.71,Default,,0,0,0,,Мұғалім бізге жақсы қарайды, бірақ
Dialogue: 0,0:12:40.80,0:12:43.55,Default,,0,0,0,,Өйткені мен өзіме көп мән бермеймін.
Dialogue: 0,0:12:44.72,0:12:46.89,Default,,0,0,0,,Мен өзімді бір жерге бара жатқандай сезінемін
Dialogue: 0,0:12:47.39,0:12:50.39,Default,,0,0,0,,Мен шынымен де осында екенімді тексергім келеді.
Dialogue: 0,0:12:50.47,0:12:51.56,Default,,0,0,0,,Иә
Dialogue: 0,0:12:52.06,0:12:53.48,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:12:53.98,0:12:56.69,Default,,0,0,0,,Бірақ Юк жақсы.
Dialogue: 0,0:12:56.77,0:12:59.40,Default,,0,0,0,,Біз сізге осылай демалуға мүмкіндік береміз.
Dialogue: 0,0:12:59.48,0:13:00.48,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:13:00.57,0:13:03.53,Default,,0,0,0,,Мен түсіндім, сондықтан біраз уақытқа кетіп қалуыңызды өтінемін?
Dialogue: 0,0:13:03.61,0:13:04.65,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:13:04.74,0:13:07.11,Default,,0,0,0,,Неліктен менің партиямның көшбасшысы
Dialogue: 0,0:13:07.20,0:13:08.99,Default,,0,0,0,,Сонша аңғал, солай емес пе?
Dialogue: 0,0:13:09.07,0:13:12.12,Default,,0,0,0,,Бізді кешірме
Dialogue: 0,0:13:12.20,0:13:13.62,Default,,0,0,0,,Мен өзімді аздап жалғыз сезінемін
Dialogue: 0,0:13:13.70,0:13:15.75,Default,,0,0,0,,Мұндай нәрсе бар ма?
Dialogue: 0,0:13:18.88,0:13:21.05,Default,,0,0,0,,Юк әрқашан тік.
Dialogue: 0,0:13:21.63,0:13:23.09,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:13:23.17,0:13:26.01,Default,,0,0,0,,Мені осылай қоздырса, жүйкем тозып кетер еді.
Dialogue: 0,0:13:26.09,0:13:27.38,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:13:27.47,0:13:30.18,Default,,0,0,0,,Ұстаз, сіз оғаш нәрселерге нашарсыз.
Dialogue: 0,0:13:30.26,0:13:33.52,Default,,0,0,0,,Мен жай ғана А дәрежелі авантюристпін.
Dialogue: 0,0:13:33.60,0:13:34.60,Default,,0,0,0,,Екі сөз жоқ!
Dialogue: 0,0:13:34.68,0:13:36.60,Default,,0,0,0,,Шын мәнінде маңызды емес
Dialogue: 0,0:13:36.69,0:13:38.15,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:13:38.23,0:13:40.40,Default,,0,0,0,,Өйткені, мұғалім біртүрлі екен.
Dialogue: 0,0:13:42.44,0:13:43.57,Default,,0,0,0,,- (2 адам) Хэхе - (Юк) Уау!
Dialogue: 0,0:13:43.65,0:13:46.32,Default,,0,0,0,,Өтінемін... мені тастап кетші!
Dialogue: 0,0:13:46.40,0:13:48.32,Default,,0,0,0,,Қашуға тыйым салынады.
Dialogue: 0,0:13:48.91,0:13:49.99,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:13:50.07,0:13:54.08,Default,,0,0,0,,...
Dialogue: 0,0:13:54.16,0:13:55.29,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,0:13:59.38,0:14:01.17,Default,,0,0,0,,Нибельнді алып кетті ме?
Dialogue: 0,0:14:01.25,0:14:02.38,Default,,0,0,0,,Толық шек
Dialogue: 0,0:14:02.46,0:14:04.84,Default,,0,0,0,,Сол баланы алып, зынданға кіріңіз.
Dialogue: 0,0:14:04.92,0:14:06.84,Default,,0,0,0,,Оған қызметкер куә болды.
Dialogue: 0,0:14:06.92,0:14:09.80,Default,,0,0,0,,...
Dialogue: 0,0:14:09.89,0:14:12.68,Default,,0,0,0,,Жоқ, бұл Маринаның кінәсі емес.
Dialogue: 0,0:14:12.76,0:14:14.47,Default,,0,0,0,,Мен де бейқам болдым...
Dialogue: 0,0:14:14.56,0:14:17.18,Default,,0,0,0,,...
Dialogue: 0,0:14:17.27,0:14:19.02,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:14:19.10,0:14:22.27,Default,,0,0,0,,...
Dialogue: 0,0:14:26.78,0:14:30.57,Default,,0,0,0,,Fullbound-ті қуып жетіп, Нибельнді қорғағаннан кейін,
Dialogue: 0,0:14:30.66,0:14:32.87,Default,,0,0,0,,Водан қамалының ең терең бөлігіне ұмтылыңыз
Dialogue: 0,0:14:32.95,0:14:35.45,Default,,0,0,0,,...
Dialogue: 0,0:14:35.54,0:14:39.00,Default,,0,0,0,,Соңғы мақсат – бір алтынды жою.
Dialogue: 0,0:14:39.08,0:14:40.79,Default,,0,0,0,,үшінңыз өтінемін
Dialogue: 0,0:14:41.29,0:14:43.04,Default,,0,0,0,,Мен соншалықты алаңдамаймын.
Dialogue: 0,0:14:43.13,0:14:44.55,Default,,0,0,0,,Балалар мұны істей аласыңдар.
Dialogue: 0,0:14:44.63,0:14:45.80,Default,,0,0,0,,Сея Сея
Dialogue: 0,0:14:45.88,0:14:48.51,Default,,0,0,0,,Өйткені, Atera сізді қолдайды.
Dialogue: 0,0:14:48.59,0:14:50.59,Default,,0,0,0,,Мен саған көп өтіндім.
Dialogue: 0,0:14:50.68,0:14:51.72,Default,,0,0,0,,Тыңдаңыз
Dialogue: 0,0:14:51.80,0:14:54.39,Default,,0,0,0,,үшінның аман-есен оралатынына сенімдімін.
Dialogue: 0,0:14:54.47,0:14:56.89,Default,,0,0,0,,Skordia Прогресс басталады!
Dialogue: 0,0:14:56.97,0:14:59.52,Default,,0,0,0,,Кармин кеттік!
Dialogue: 0,0:15:03.06,0:15:04.32,Default,,0,0,0,,Сіз дайынсыз ба?
Dialogue: 0,0:15:04.40,0:15:06.98,Default,,0,0,0,,Иә, Ран-чанды алып кетейік.
Dialogue: 0,0:15:07.07,0:15:08.78,Default,,0,0,0,,Сәттілік Юк
Dialogue: 0,0:15:08.86,0:15:10.82,Default,,0,0,0,,Маршрут назарда
Dialogue: 0,0:15:10.90,0:15:11.86,Default,,0,0,0,,Осындай күйде тежеліп тұру аса жағымды емес
Dialogue: 0,0:15:11.95,0:15:14.53,Default,,0,0,0,,Маған алдын ала ескерту қалдырыңыз.
Dialogue: 0,0:15:14.62,0:15:16.74,Default,,0,0,0,,Кеттік, Кловер
Dialogue: 0,0:15:16.83,0:15:17.95,Default,,0,0,0,,Мұқият
Dialogue: 0,0:15:18.04,0:15:19.04,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:15:25.00,0:15:26.50,Default,,0,0,0,,Алға Хризалис!
Dialogue: 0,0:15:26.59,0:15:27.80,Default,,0,0,0,,№ 10
Dialogue: 0,0:15:31.47,0:15:32.18,Default,,0,0,0,,Марона мырза!
Dialogue: 0,0:15:32.26,0:15:34.97,Default,,0,0,0,,Мұны сізге қалдыруға рұқсат етіңіз.
Dialogue: 0,0:15:35.05,0:15:36.43,Default,,0,0,0,,Өтінемін, алға.
Dialogue: 0,0:15:36.51,0:15:37.72,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:15:37.81,0:15:39.68,Default,,0,0,0,,Рун-чан, сен маған көмектесесің бе?
Dialogue: 0,0:15:39.77,0:15:43.44,Default,,0,0,0,,Юк мырза, басымдықтарыңызды қате түсінбеңіз.
Dialogue: 0,0:15:43.52,0:15:46.98,Default,,0,0,0,,Бұл жолы біз сізге қолдау көрсетуге дайынбыз.
Dialogue: 0,0:15:47.07,0:15:48.98,Default,,0,0,0,,Мақсатыңды ұмытпа
Dialogue: 0,0:15:49.07,0:15:50.19,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:15:50.78,0:15:52.70,Default,,0,0,0,,үшінңыз, шайқас басталады!
Dialogue: 0,0:15:52.78,0:15:55.16,Default,,0,0,0,,Ол көздерге қарама!
Dialogue: 0,0:16:04.17,0:16:06.67,Default,,0,0,0,,15 16…
Dialogue: 0,0:16:06.75,0:16:11.13,Default,,0,0,0,,Хмм, бұл біраз... Не істеу керек? Люсент
Dialogue: 0,0:16:11.63,0:16:13.55,Default,,0,0,0,,Әрине, біз оларды тоқтаттық.
Dialogue: 0,0:16:13.63,0:16:15.22,Default,,0,0,0,,Бедені қорғасын
Dialogue: 0,0:16:15.30,0:16:17.72,Default,,0,0,0,,Алайда бұл сан...
Dialogue: 0,0:16:17.81,0:16:21.98,Default,,0,0,0,,Бәрі де болады. Жастар тек алға.
Dialogue: 0,0:16:22.85,0:16:23.81,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:16:24.31,0:16:25.48,Default,,0,0,0,,Кейін кездесейік
Dialogue: 0,0:16:25.56,0:16:26.48,Default,,0,0,0,,Иә
Dialogue: 0,0:16:28.57,0:16:31.65,Default,,0,0,0,,Мұздатылған шөл даланың боранын же
Dialogue: 0,0:16:31.74,0:16:35.36,Default,,0,0,0,,Бесінші деңгейлі сиқырлы боран
Dialogue: 0,0:16:38.87,0:16:41.33,Default,,0,0,0,,Зұлымдарды өрте
Dialogue: 0,0:16:41.41,0:16:44.33,Default,,0,0,0,,Төртінші деңгейлі сиқырлы от добы!
Dialogue: 0,0:16:47.04,0:16:47.88,Default,,0,0,0,,Кеттік
Dialogue: 0,0:16:48.63,0:16:51.00,Default,,0,0,0,,Водун қамалын жаулап алу басталды!
Dialogue: 0,0:16:57.76,0:16:59.97,Default,,0,0,0,,Бірнеше із
Dialogue: 0,0:17:00.06,0:17:02.56,Default,,0,0,0,,...Ұсақ іздер бар.
Dialogue: 0,0:17:02.64,0:17:04.64,Default,,0,0,0,,...
Dialogue: 0,0:17:04.73,0:17:05.69,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:05.77,0:17:08.44,Default,,0,0,0,,Мен тікелей патшаның бөлмесіне бара жатырмын.
Dialogue: 0,0:17:08.52,0:17:12.57,Default,,0,0,0,,Біз оны соңғы жерімізде кездестіретін сияқтымыз.
Dialogue: 0,0:17:13.07,0:17:13.99,Default,,0,0,0,,Кеттік
Dialogue: 0,0:17:16.66,0:17:17.32,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:17:22.66,0:17:24.08,Default,,0,0,0,,Журнал
Dialogue: 0,0:17:24.16,0:17:27.04,Default,,0,0,0,,Бірнеше күн болды.
Dialogue: 0,0:17:27.12,0:17:29.71,Default,,0,0,0,,Фердио мырза, бәріңіз.
Dialogue: 0,0:17:30.34,0:17:32.80,Default,,0,0,0,,Маған мұрағаттарды көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:17:32.88,0:17:35.51,Default,,0,0,0,,Мен Glad She-Im туралы көп нәрсе білдім.
Dialogue: 0,0:17:36.01,0:17:37.93,Default,,0,0,0,,Сіз кімсіз
Dialogue: 0,0:17:38.01,0:17:40.30,Default,,0,0,0,,Қош бол?
Dialogue: 0,0:17:40.80,0:17:42.47,Default,,0,0,0,,Лодж Водханиан
Dialogue: 0,0:17:42.56,0:17:44.73,Default,,0,0,0,,Водан патшаның ұлы.
Dialogue: 0,0:17:45.23,0:17:48.44,Default,,0,0,0,,Бұл ертедегі оқиға.
Dialogue: 0,0:17:48.52,0:17:53.44,Default,,0,0,0,,Ал Лун сенің қарындасың Фрейяның қызы.
Dialogue: 0,0:17:53.53,0:17:56.86,Default,,0,0,0,,Басқаша айтқанда, Рун-чан...
Dialogue: 0,0:17:56.95,0:17:59.11,Default,,0,0,0,,Водан патшаның немересі
Dialogue: 0,0:17:59.20,0:18:00.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:00.12,0:18:05.29,Default,,0,0,0,,Бұл бала оның әкесі, сиқыршы-доно екеуміз қалдырған баламыз.
Dialogue: 0,0:18:05.37,0:18:07.41,Default,,0,0,0,,Бұл кілт
Dialogue: 0,0:18:08.50,0:18:12.92,Default,,0,0,0,,Водан патша... Әкем қателесті.
Dialogue: 0,0:18:13.00,0:18:18.76,Default,,0,0,0,,Адамдарды мұндай нәрсеге сыйғызу мүмкін емес еді.
Dialogue: 0,0:18:21.85,0:18:26.18,Default,,0,0,0,,Жақсырақ таңдау жасаңыз.
Dialogue: 0,0:18:37.49,0:18:39.53,Default,,0,0,0,,Енді сен байсың!
Dialogue: 0,0:18:39.61,0:18:41.66,Default,,0,0,0,,Закарттың дауысы
Dialogue: 0,0:18:41.74,0:18:43.70,Default,,0,0,0,,Бұл патшаның бөлмесі...
Dialogue: 0,0:18:43.78,0:18:46.58,Default,,0,0,0,,Бұл жерде алтын бар, солай ма?
Dialogue: 0,0:18:46.66,0:18:48.66,Default,,0,0,0,,Сондай-ақ Run болуы керек.
Dialogue: 0,0:18:48.75,0:18:51.00,Default,,0,0,0,,Кел, Вибрион.
Dialogue: 0,0:18:57.13,0:18:59.88,Default,,0,0,0,,Қандай да бір қауіп-қатерді алдын ала көрсеңіз, маған хабарлаңыз.
Dialogue: 0,0:19:00.88,0:19:01.43,Default,,0,0,0,,Тек жалаңаш, бос жер учаскесін қалдырады…
Dialogue: 0,0:19:02.01,0:19:05.18,Default,,0,0,0,,Қорғаңыз Жүгіріп, алтынды жойыңыз
Dialogue: 0,0:19:05.93,0:19:06.81,Default,,0,0,0,,Кеттік
Dialogue: 0,0:19:07.52,0:19:11.44,Default,,0,0,0,,Хахахаха Ахахаха!
Dialogue: 0,0:19:11.52,0:19:13.06,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:19:13.15,0:19:14.31,Default,,0,0,0,,Zackart!
Dialogue: 0,0:19:15.90,0:19:17.44,Default,,0,0,0,,Нибельн қайда!
Dialogue: 0,0:19:17.53,0:19:18.82,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:18.90,0:19:20.57,Default,,0,0,0,,- Иә! -(Юк) А...
Dialogue: 0,0:19:25.53,0:19:27.58,Default,,0,0,0,,- (Юк) Водан патша? -Оның қасында!
Dialogue: 0,0:19:30.66,0:19:32.42,Default,,0,0,0,,- (Юк) Жүгір! -Жүгір Чан!
Dialogue: 0,0:19:34.92,0:19:36.46,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:19:36.55,0:19:39.84,Default,,0,0,0,,Бұл зындан әлдеқашан жаулап алынған.
Dialogue: 0,0:19:39.92,0:19:41.43,Default,,0,0,0,,Балалар сендер емес
Dialogue: 0,0:19:41.51,0:19:45.35,Default,,0,0,0,,Wai және т.б. Fullbound толық түсіру өз бетімен орындалды.
Dialogue: 0,0:19:45.43,0:19:46.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:46.85,0:19:48.97,Default,,0,0,0,,Мен сол баланы алып келгенімде
Dialogue: 0,0:19:49.06,0:19:51.81,Default,,0,0,0,,Бұл жарыс біз үшін жеңіс.
Dialogue: 0,0:19:51.89,0:19:53.40,Default,,0,0,0,,Race?
Dialogue: 0,0:19:53.48,0:19:57.65,Default,,0,0,0,,Енді сіз осында болсаңыз да, сіз әлі де шабуыл тәртібі үшін жарысып жатырсыз ба?
Dialogue: 0,0:19:57.73,0:19:59.32,Default,,0,0,0,,Тіпті Run қатысты
Dialogue: 0,0:19:59.90,0:20:01.65,Default,,0,0,0,,Балалар, естерің дұрыс па?
Dialogue: 0,0:20:01.74,0:20:04.20,Default,,0,0,0,,Сіздер шетелдіктер
Dialogue: 0,0:20:04.28,0:20:08.41,Default,,0,0,0,,Басқаларға тапсырыс беріп, алға жүруге болмайды.
Dialogue: 0,0:20:09.95,0:20:10.66,Default,,0,0,0,,Хун
Dialogue: 0,0:20:15.71,0:20:17.50,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:20:17.59,0:20:20.13,Default,,0,0,0,,Бұл біздің ұрысатын уақыт емес!
Dialogue: 0,0:20:20.21,0:20:23.63,Default,,0,0,0,,Jakaashii! Маған бұл басынан ұнамады
Dialogue: 0,0:20:23.72,0:20:25.93,Default,,0,0,0,,Дуна Утара Вайра Ярога
Dialogue: 0,0:20:26.01,0:20:29.72,Default,,0,0,0,,Сендер, бейтаныс адамдар, оны таптадыңдар.
Dialogue: 0,0:20:29.81,0:20:31.64,Default,,0,0,0,,Мені күлдіргеніңіз үшін рахмет!
Dialogue: 0,0:20:33.23,0:20:35.73,Default,,0,0,0,,Мен сені әсіресе ұнатпаймын.
Dialogue: 0,0:20:35.81,0:20:38.15,Default,,0,0,0,,Мен бұл танымал стриминг кеші ме, әлде басқа нәрсе ме, білмеймін.
Dialogue: 0,0:20:38.23,0:20:41.11,Default,,0,0,0,,Әйелдердің бәрі маған қыдырып, сырласуды айтып жатыр.
Dialogue: 0,0:20:41.19,0:20:42.65,Default,,0,0,0,,Авантюрист Менің атымды айтып жатырсыз ба?
Dialogue: 0,0:20:42.74,0:20:45.28,Default,,0,0,0,,Не? Бұл жай ғана масқара емес.
Dialogue: 0,0:20:45.36,0:20:47.66,Default,,0,0,0,,Адамның қызғанышы орынсыз
Dialogue: 0,0:20:47.74,0:20:49.20,Default,,0,0,0,,Олардың екеуі
Dialogue: 0,0:20:49.28,0:20:51.79,Default,,0,0,0,,Отқа май құюды тоқтату керек пе?
Dialogue: 0,0:20:51.87,0:20:54.50,Default,,0,0,0,,Ұсқынсыз болмаса, жоқ.
Dialogue: 0,0:20:54.58,0:20:56.92,Default,,0,0,0,,Бетіңді жу да, қайтып кел.
Dialogue: 0,0:20:57.00,0:20:58.25,Default,,0,0,0,,Ғү… Ақымақ, шегінбе! ➡
Dialogue: 0,0:20:59.21,0:21:00.67,Default,,0,0,0,,Бұл жігіт кім?
Dialogue: 0,0:21:01.25,0:21:03.67,Default,,0,0,0,,Сәлем, патша, өтінемін.
Dialogue: 0,0:21:03.76,0:21:06.43,Default,,0,0,0,,Бізге Пауэрді беріңіз
Dialogue: 0,0:21:06.51,0:21:07.93,Default,,0,0,0,,Пауэр!
Dialogue: 0,0:21:13.14,0:21:14.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:15.98,0:21:17.98,Default,,0,0,0,,♪～
Dialogue: 0,0:22:43.90,0:22:45.90,Default,,0,0,0,,～♪
Dialogue: 0,0:22:47.32,0:22:49.70,Default,,0,0,0,,Келесі жолы «Уақыттан тыс»
Dialogue: 0,0:22:51.20,0:22:57.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
