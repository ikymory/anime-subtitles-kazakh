Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.58,0:00:02.91,Default,,0,0,0,,Мен Саймонмын
Dialogue: 0,0:00:03.00,0:00:06.67,Default,,0,0,0,,Ол әлі бастаушы, бірақ ол бір күні А дәрежесіне айналатын адам.
Dialogue: 0,0:00:06.75,0:00:09.09,Default,,0,0,0,,Бұл тағы да хахаха!
Dialogue: 0,0:00:09.17,0:00:11.21,Default,,0,0,0,,Саймонның бәрі осы
Dialogue: 0,0:00:11.30,0:00:12.80,Default,,0,0,0,,Бірақ мен оны жек көрмеймін.
Dialogue: 0,0:00:12.88,0:00:16.55,Default,,0,0,0,,Бірақ біз тіпті ұятқа қалдық, солай емес пе?
Dialogue: 0,0:00:16.64,0:00:18.81,Default,,0,0,0,,Көп күлме
Dialogue: 0,0:00:18.89,0:00:21.31,Default,,0,0,0,,Юкемен бірге Тұңғиық қақпасына бару
Dialogue: 0,0:00:21.39,0:00:23.56,Default,,0,0,0,,Сіз А дәрежелі болуыңыз керек.
Dialogue: 0,0:00:24.14,0:00:25.85,Default,,0,0,0,,Біз мұны істей аламыз.
Dialogue: 0,0:00:26.44,0:00:26.94,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,0:00:27.02,0:00:28.15,Default,,0,0,0,,О
Dialogue: 0,0:00:30.90,0:00:33.95,Default,,0,0,0,,Мен Тұңғиық қақпасына бара аламын деп үміттенемін
Dialogue: 0,0:00:34.45,0:00:38.37,Default,,0,0,0,,Юктікі... Жоқ, бұл біздің арманымыз.
Dialogue: 0,0:00:38.87,0:00:40.70,Default,,0,0,0,,Мен онда міндетті түрде барамын.
Dialogue: 0,0:00:42.66,0:00:45.00,Default,,0,0,0,,Кездескенше, Саймон
Dialogue: 0,0:00:45.08,0:00:46.96,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:00:47.04,0:00:49.59,Default,,0,0,0,,Қайта кездескенше, Бүкілодақ!
Dialogue: 0,0:00:49.67,0:00:51.25,Default,,0,0,0,,(Симонның күлкісі)
Dialogue: 0,0:00:51.34,0:00:53.09,Default,,0,0,0,,Тіпті жауынгерлер
Dialogue: 0,0:00:53.17,0:00:54.72,Default,,0,0,0,,Ол жақсы жігіт еді.
Dialogue: 0,0:00:55.80,0:00:57.30,Default,,0,0,0,,Мен сені тағы көремін деп үміттенемін.
Dialogue: 0,0:01:02.47,0:01:04.48,Default,,0,0,0,,♪～
Dialogue: 0,0:02:29.94,0:02:31.94,Default,,0,0,0,,～♪
Dialogue: 0,0:02:37.82,0:02:38.95,Default,,0,0,0,,Сізді күтуге мәжбүр етті
Dialogue: 0,0:02:39.03,0:02:42.07,Default,,0,0,0,,Қалай болды? Найзағай шортаны
Dialogue: 0,0:02:42.91,0:02:44.74,Default,,0,0,0,,Олар жақсы жігіттер еді.
Dialogue: 0,0:02:45.24,0:02:47.70,Default,,0,0,0,,Сіз мұнда көңіл көтеріп жүрген сияқтысыз.
Dialogue: 0,0:02:48.20,0:02:51.33,Default,,0,0,0,,Мүмкін біз де солай болған шығармыз.
Dialogue: 0,0:02:51.42,0:02:55.34,Default,,0,0,0,,Бірақ мен қазір дүниенің болғанына қуаныштымын.
Dialogue: 0,0:02:55.92,0:02:57.46,Default,,0,0,0,,Әрине мен де.
Dialogue: 0,0:02:57.55,0:02:59.67,Default,,0,0,0,,Ең жақсы достармен
Dialogue: 0,0:02:59.76,0:03:02.68,Default,,0,0,0,,Мен армандаған шыңырау қақпасына бара жатырмын.
Dialogue: 0,0:03:04.01,0:03:05.10,Default,,0,0,0,,Келесі кезекте біз
Dialogue: 0,0:03:06.18,0:03:08.10,Default,,0,0,0,,Финис авантюристер гильдиясы
Dialogue: 0,0:03:08.68,0:03:10.23,Default,,0,0,0,,Ақыры осында.
Dialogue: 0,0:03:10.31,0:03:12.35,Default,,0,0,0,,Біздің мақсатымыз – осы үлкен жер асты үңгірлері.
Dialogue: 0,0:03:12.94,0:03:14.86,Default,,0,0,0,,Бұл түссіз қараңғылықтың кіреберісі.
Dialogue: 0,0:03:14.94,0:03:18.23,Default,,0,0,0,,Тұңғиық қақпасы жер астында екені сөзсіз.
Dialogue: 0,0:03:18.74,0:03:22.28,Default,,0,0,0,,Мұндағы барлық адамдарды көлеңкелі аң аулаушылар деп санауға болады.
Dialogue: 0,0:03:22.36,0:03:23.62,Default,,0,0,0,,Сақтығыңызды түсірмеңіз
Dialogue: 0,0:03:23.70,0:03:25.20,Default,,0,0,0,,Көшбасшы
Dialogue: 0,0:03:37.92,0:03:38.92,Default,,0,0,0,,О Нене
Dialogue: 0,0:03:39.55,0:03:41.76,Default,,0,0,0,,Және бәріңіз де сәйкессіздер.
Dialogue: 0,0:03:41.84,0:03:43.05,Default,,0,0,0,,Мама Мама… Мама…
Dialogue: 0,0:03:43.13,0:03:47.35,Default,,0,0,0,,Нене мені "мама" деп атайтынына сенбеймін.
Dialogue: 0,0:03:47.43,0:03:49.60,Default,,0,0,0,,Кейде бұл мені қуантады.
Dialogue: 0,0:03:49.68,0:03:53.94,Default,,0,0,0,,Айтпақшы, бұл аймаққа қатысы барлардан басқа кез келген адамға тыйым салынған.
Dialogue: 0,0:03:54.81,0:03:57.07,Default,,0,0,0,,Маған өтуге рұқсат бере аласыз ба? Mamaru-san
Dialogue: 0,0:03:57.69,0:03:59.69,Default,,0,0,0,,Неге?
Dialogue: 0,0:03:59.78,0:04:01.69,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:04:03.57,0:04:05.99,Default,,0,0,0,,Хехехе, әзілдеп тұрмын.
Dialogue: 0,0:04:06.07,0:04:07.20,Default,,0,0,0,,Ақыры оларға бақыт келді
Dialogue: 0,0:04:08.45,0:04:09.58,Default,,0,0,0,,Мамару-сан?
Dialogue: 0,0:04:09.66,0:04:12.21,Default,,0,0,0,,Иә, иә, бұл не? Юк мырза
Dialogue: 0,0:04:12.79,0:04:14.58,Default,,0,0,0,,Ол нағыз Мамару-сан.
Dialogue: 0,0:04:14.67,0:04:17.50,Default,,0,0,0,,Иә, мен де сиқырлы анықтау арқылы растадым.
Dialogue: 0,0:04:17.59,0:04:18.84,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:04:18.92,0:04:20.88,Default,,0,0,0,,Кешіріңіз, Мамару-сан.
Dialogue: 0,0:04:20.96,0:04:23.63,Default,,0,0,0,,Күдіктену таң қалдырады.
Dialogue: 0,0:04:23.72,0:04:26.43,Default,,0,0,0,,Мен Юке мырзаны бұрыннан білемін.
Dialogue: 0,0:04:26.51,0:04:27.43,Default,,0,0,0,,Хаа…
Dialogue: 0,0:04:28.18,0:04:30.47,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:04:30.56,0:04:33.94,Default,,0,0,0,,Менің көшірмесім болған Көлеңке Сталкер.
Dialogue: 0,0:04:34.44,0:04:37.48,Default,,0,0,0,,Мен оның кедергі болғанын қаламадым, сондықтан мен оған қамқорлық жасадым.
Dialogue: 0,0:04:37.56,0:04:40.27,Default,,0,0,0,,Сұр гермиттерден күткендей
Dialogue: 0,0:04:40.36,0:04:41.78,Default,,0,0,0,,Аңызға айналған авантюрист
Dialogue: 0,0:04:41.86,0:04:45.53,Default,,0,0,0,,Сенің терің менікінен жақсы дегенім үшін кешіріңіз.
Dialogue: 0,0:04:45.61,0:04:47.24,Default,,0,0,0,,Сага ағай мен Бенвуд ше?
Dialogue: 0,0:04:47.32,0:04:48.24,Default,,0,0,0,,Артқы жағында бар ма?
Dialogue: 0,0:04:48.83,0:04:49.66,Default,,0,0,0,,Иә
Dialogue: 0,0:04:49.74,0:04:51.54,Default,,0,0,0,,Менің осында болу себебім
Dialogue: 0,0:04:51.62,0:04:54.29,Default,,0,0,0,,үшінңызды тартатын жолды жасау.
Dialogue: 0,0:04:54.37,0:04:55.29,Default,,0,0,0,,өту керек пе?
Dialogue: 0,0:04:55.37,0:04:58.25,Default,,0,0,0,,Мен де оны толық түсінбеймін.
Dialogue: 0,0:04:58.33,0:05:02.46,Default,,0,0,0,,Бірақ Сага айтқандай, мен барлығымен кездесе алдым.
Dialogue: 0,0:05:02.55,0:05:04.84,Default,,0,0,0,,Мүмкін компас да әрекет еткен шығар.
Dialogue: 0,0:05:04.92,0:05:05.88,Default,,0,0,0,,Соның арқасында
Dialogue: 0,0:05:06.47,0:05:08.39,Default,,0,0,0,,Мен көремін... түсінемін.
Dialogue: 0,0:05:08.47,0:05:11.22,Default,,0,0,0,,Енді жер астына барайық.
Dialogue: 0,0:05:11.31,0:05:14.89,Default,,0,0,0,,Қымбатты Кловер, нағыз іс осыдан басталады.
Dialogue: 0,0:05:18.60,0:05:20.52,Default,,0,0,0,,Хмф! Ха!
Dialogue: 0,0:05:22.11,0:05:23.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:27.95,0:05:29.62,Default,,0,0,0,,Келдің бе?
Dialogue: 0,0:05:29.70,0:05:31.12,Default,,0,0,0,,Жағдай қалай?
Dialogue: 0,0:05:31.20,0:05:32.49,Default,,0,0,0,,Көріп отырғаныңыздай.
Dialogue: 0,0:05:32.58,0:05:33.95,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:05:34.04,0:05:37.00,Default,,0,0,0,,Саға жігіт, ол жай ғана пәле жігіт
Dialogue: 0,0:05:38.08,0:05:39.54,Default,,0,0,0,,Хааах!
Dialogue: 0,0:05:40.50,0:05:42.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:43.00,0:05:46.09,Default,,0,0,0,,Оның дөрекі болуы қалыпты жағдай.
Dialogue: 0,0:05:46.17,0:05:48.05,Default,,0,0,0,,Біраз уақыттан бері мұндай оқиға болған жоқ.
Dialogue: 0,0:05:48.13,0:05:49.51,Default,,0,0,0,,Маньера!
Dialogue: 0,0:05:49.59,0:05:52.01,Default,,0,0,0,,Сен Дунадан келдің.
Dialogue: 0,0:05:52.10,0:05:55.77,Default,,0,0,0,,Ол... мені Сағаға шақырды.
Dialogue: 0,0:05:56.39,0:05:58.31,Default,,0,0,0,,Қарттарды қорламаңыз!
Dialogue: 0,0:05:58.39,0:05:59.15,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:06:03.02,0:06:06.28,Default,,0,0,0,,Әйелдердің де жағдайы жақсы сияқты.
Dialogue: 0,0:06:06.36,0:06:09.16,Default,,0,0,0,,Жарайды, жарайды. Джеймидің де жағдайы жақсы сияқты.
Dialogue: 0,0:06:09.24,0:06:11.24,Default,,0,0,0,,Нибельн де қауіпсіз.
Dialogue: 0,0:06:11.32,0:06:14.16,Default,,0,0,0,,Күтілгендей, Сағаның үміті ақталды.
Dialogue: 0,0:06:14.24,0:06:15.79,Default,,0,0,0,,Саға аға ше?
Dialogue: 0,0:06:15.87,0:06:18.83,Default,,0,0,0,,Мен дайын екенімді айтып, бірінші ішке кірдім.
Dialogue: 0,0:06:18.92,0:06:21.54,Default,,0,0,0,,Біз сенің шықтарыңбыз.
Dialogue: 0,0:06:22.13,0:06:24.05,Default,,0,0,0,,Бұл солай сияқты.
Dialogue: 0,0:06:25.88,0:06:27.26,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:06:30.97,0:06:31.59,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:34.76,0:06:36.81,Default,,0,0,0,,Ал... Күткендей.
Dialogue: 0,0:06:36.89,0:06:40.23,Default,,0,0,0,,Нене, сен он жыл бойы мені уайымдап жүрсің...
Dialogue: 0,0:06:40.31,0:06:42.69,Default,,0,0,0,,Жоқ, жүз жыл ерте.
Dialogue: 0,0:06:42.77,0:06:44.07,Default,,0,0,0,,Мен мұны есте сақтаймын
Dialogue: 0,0:06:49.65,0:06:53.70,Default,,0,0,0,,Бенвуд Маниера Мен Юк пен басқаларды жіберемін.
Dialogue: 0,0:06:53.78,0:06:55.16,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:06:55.24,0:06:56.58,Default,,0,0,0,,Жасайық
Dialogue: 0,0:06:56.66,0:06:59.29,Default,,0,0,0,,Мен сізді тоқтатуды сізге қалдырамын.
Dialogue: 0,0:06:59.83,0:07:00.96,Default,,0,0,0,,Бірақ содан кейін...
Dialogue: 0,0:07:02.00,0:07:04.54,Default,,0,0,0,,Біз үшін алаңдамаңыз.
Dialogue: 0,0:07:04.63,0:07:07.71,Default,,0,0,0,,Бала мені уайымдайтындай мен әлсіз емеспін.
Dialogue: 0,0:07:07.80,0:07:11.55,Default,,0,0,0,,Мен оны дұрыстап дөңгелетемін және бірінші көтерілуге ​​рұқсат етемін.
Dialogue: 0,0:07:14.05,0:07:15.18,Default,,0,0,0,,Екеуі де осы Спорт фестивалінде жоғары деңгейдегі нәтижелерге қол жеткізді!
Dialogue: 0,0:07:15.26,0:07:18.39,Default,,0,0,0,,Бенвуд Қатыгез жұдырық және Жазалаушы Маньера
Dialogue: 0,0:07:18.47,0:07:21.89,Default,,0,0,0,,Сұр гермиттерден Мамару бар.
Dialogue: 0,0:07:21.98,0:07:23.81,Default,,0,0,0,,Мен біраз уақыттан кейін бірінші рет жабайы боламын
Dialogue: 0,0:07:23.90,0:07:24.40,Default,,0,0,0,,Уау
Dialogue: 0,0:07:24.48,0:07:28.94,Default,,0,0,0,,Маньера, өлгенше ұрып-соғу, ностальгиялық естіледі.
Dialogue: 0,0:07:29.03,0:07:31.90,Default,,0,0,0,,Аяғыңызды тартпаңыз, Ми Бенвуд
Dialogue: 0,0:07:31.99,0:07:34.78,Default,,0,0,0,,Nukase ми бұлшықетінің маньерасы
Dialogue: 0,0:07:35.58,0:07:36.41,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:36.49,0:07:40.29,Default,,0,0,0,,Негізі Мория деген жалған данышпан да бар.
Dialogue: 0,0:07:42.12,0:07:43.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:43.12,0:07:46.46,Default,,0,0,0,,Көптен бері көрмегелі, Юке-доно.
Dialogue: 0,0:07:46.54,0:07:48.75,Default,,0,0,0,,Мориа мырза! Неге мұндасың?
Dialogue: 0,0:07:48.84,0:07:49.55,Default,,0,0,0,,Эй!
Dialogue: 0,0:07:49.63,0:07:52.26,Default,,0,0,0,,Мен де бір кездері ақиқаттың бір бөлігіне тап болдым.
Dialogue: 0,0:07:52.34,0:07:54.97,Default,,0,0,0,,Жаяулаушылардың біреуі ғана
Dialogue: 0,0:07:56.30,0:07:59.64,Default,,0,0,0,,Оның үстіне ол бұрынғы батырлардың соңғысы.
Dialogue: 0,0:07:59.72,0:08:00.48,Default,,0,0,0,,Батыр?
Dialogue: 0,0:08:00.56,0:08:02.60,Default,,0,0,0,,Мория да батыр болды ма?
Dialogue: 0,0:08:02.69,0:08:04.48,Default,,0,0,0,,Бұл Yuk сәйкес келеді.
Dialogue: 0,0:08:04.56,0:08:07.40,Default,,0,0,0,,Саға баланың өтініші бойынша
Dialogue: 0,0:08:07.48,0:08:10.74,Default,,0,0,0,,Мен жаңа ғана Скордияның квестін аяқтадым.
Dialogue: 0,0:08:10.82,0:08:15.11,Default,,0,0,0,,Бенвуд Маниера Мамар Дайынсың ба?
Dialogue: 0,0:08:15.20,0:08:16.12,Default,,0,0,0,,О
Dialogue: 0,0:08:16.20,0:08:18.95,Default,,0,0,0,,Морианың қарт адамы осында болса, біз оны төлей аламыз.
Dialogue: 0,0:08:19.04,0:08:22.75,Default,,0,0,0,,Ха, мен қарттың салқын сусынына айналмаспын деп үміттенемін.
Dialogue: 0,0:08:23.33,0:08:24.37,Default,,0,0,0,,Кез келген уақытта
Dialogue: 0,0:08:26.83,0:08:29.30,Default,,0,0,0,,Қалғанын маған қалдырыңыз
Dialogue: 0,0:08:29.38,0:08:32.55,Default,,0,0,0,,Алға, армандарыңа жете бер.
Dialogue: 0,0:08:32.63,0:08:33.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:33.88,0:08:36.47,Default,,0,0,0,,Хмм, оны бөлшектеңіз!
Dialogue: 0,0:08:39.47,0:08:43.02,Default,,0,0,0,,Жетінші баспалдақтың сиқырлы кеңістіктік жарылуы (әлемді бөлгіш)
Dialogue: 0,0:08:43.10,0:08:45.65,Default,,0,0,0,,Уау, бұл өте оңай...
Dialogue: 0,0:08:47.48,0:08:49.27,Default,,0,0,0,,-Хмф! -Ах!
Dialogue: 0,0:08:52.99,0:08:54.78,Default,,0,0,0,,-(Юк) үшін, асығыңыздар -Иә.
Dialogue: 0,0:08:56.53,0:08:59.78,Default,,0,0,0,,Жарайды, мен мұны сізге қалдырамын.
Dialogue: 0,0:09:00.37,0:09:01.79,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:02.41,0:09:03.54,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:09:04.12,0:09:04.75,Default,,0,0,0,,Нене!
Dialogue: 0,0:09:05.75,0:09:07.92,Default,,0,0,0,,Нене Юк, өтінемін.
Dialogue: 0,0:09:08.58,0:09:09.84,Default,,0,0,0,,Иә Мастер
Dialogue: 0,0:09:09.92,0:09:12.67,Default,,0,0,0,,Үйге келгенде айтқым келетін нәрселер көп.
Dialogue: 0,0:09:12.76,0:09:14.47,Default,,0,0,0,,О, мен өте қуаныштымын.
Dialogue: 0,0:09:14.55,0:09:17.30,Default,,0,0,0,,Олай болса, Бенвудтың ішімдігін жұтып алайық.
Dialogue: 0,0:09:17.39,0:09:18.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:18.09,0:09:19.10,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:09:19.18,0:09:20.18,Default,,0,0,0,,Мен келемін
Dialogue: 0,0:09:20.26,0:09:22.52,Default,,0,0,0,,- (Юк) Нене кеттік - Иә.
Dialogue: 0,0:09:22.60,0:09:23.43,Default,,0,0,0,,Юк
Dialogue: 0,0:09:23.52,0:09:25.02,Default,,0,0,0,,Асықпаңыз
Dialogue: 0,0:09:25.10,0:09:27.69,Default,,0,0,0,,Зынданда жұмыс істеу теориясын ұмытпаңыз
Dialogue: 0,0:09:27.77,0:09:28.85,Default,,0,0,0,,О
Dialogue: 0,0:09:36.53,0:09:39.16,Default,,0,0,0,,Гилмас және басқалары, жақсысыңдар ма?
Dialogue: 0,0:09:39.24,0:09:40.62,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:09:40.70,0:09:43.33,Default,,0,0,0,,Сол төрт адам оңай жеңіледі деп ойлайсың ба?
Dialogue: 0,0:09:43.41,0:09:45.45,Default,,0,0,0,,Жоқ, мен олай ойламаймын.
Dialogue: 0,0:09:45.54,0:09:46.83,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:46.91,0:09:49.33,Default,,0,0,0,,Бенвуд және басқалары өте жақсы.
Dialogue: 0,0:09:49.88,0:09:53.34,Default,,0,0,0,,Ендеше өз миссиямызды орындайық.
Dialogue: 0,0:09:53.84,0:09:57.22,Default,,0,0,0,,Кловердің мақсаты - ең төменгі қабат, Тұңғиық қақпасы.
Dialogue: 0,0:09:57.30,0:10:00.01,Default,,0,0,0,,Міне, осында. Мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:10:00.09,0:10:01.55,Default,,0,0,0,,Иә, кеттік.
Dialogue: 0,0:10:12.65,0:10:15.36,Default,,0,0,0,,Бұл қайдан басталады, Онии-чан?
Dialogue: 0,0:10:15.44,0:10:17.45,Default,,0,0,0,,Иә, түссіз қараңғылық...
Dialogue: 0,0:10:17.53,0:10:21.03,Default,,0,0,0,,Сіздің әлеміңіздің күйреуіне себеп болған орын
Dialogue: 0,0:10:21.12,0:10:23.58,Default,,0,0,0,,Мұнда бәрі байланысты, солай ма?
Dialogue: 0,0:10:23.66,0:10:24.74,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:10:25.33,0:10:26.50,Default,,0,0,0,,Күшті қатысу
Dialogue: 0,0:10:27.00,0:10:28.25,Default,,0,0,0,,Бұрын басқаша болатын
Dialogue: 0,0:10:28.33,0:10:29.71,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:10:29.79,0:10:33.75,Default,,0,0,0,,Біртүрлі болды, бірақ мен оның соншалықты ауыр болғанын қаламадым...
Dialogue: 0,0:10:33.84,0:10:37.92,Default,,0,0,0,,Басқа өлшемдер мен уақыт ережелері ағып жатқан сияқты.
Dialogue: 0,0:10:38.42,0:10:39.13,Default,,0,0,0,,Хмм…
Dialogue: 0,0:10:42.76,0:10:45.06,Default,,0,0,0,,Бұл ностальгиялық.
Dialogue: 0,0:10:45.14,0:10:46.39,Default,,0,0,0,,О
Dialogue: 0,0:10:46.47,0:10:50.27,Default,,0,0,0,,Бұл Paintal Abandoned Mine Ruins зынданының еден бастық есігі.
Dialogue: 0,0:10:50.35,0:10:52.52,Default,,0,0,0,,Бұл мынаны білдіреді ...
Dialogue: 0,0:10:52.61,0:10:55.15,Default,,0,0,0,,Болат краб бар (болат краб)
Dialogue: 0,0:10:55.65,0:10:58.15,Default,,0,0,0,,Бұл да біздің естеліктеріміздің әсері ме?
Dialogue: 0,0:10:58.24,0:11:00.15,Default,,0,0,0,,Біз үшін
Dialogue: 0,0:11:00.24,0:11:04.49,Default,,0,0,0,,Міне, сол күн өте жарқын болды, Юке мырза.
Dialogue: 0,0:11:04.58,0:11:06.04,Default,,0,0,0,,Жоқ, сэр.
Dialogue: 0,0:11:06.12,0:11:07.37,Default,,0,0,0,,Иә
Dialogue: 0,0:11:07.45,0:11:10.16,Default,,0,0,0,,Бұл мен үшін де ұмытылмас күн.
Dialogue: 0,0:11:10.25,0:11:13.17,Default,,0,0,0,,Сол кезде Юк мұны жалғыз жасады.
Dialogue: 0,0:11:13.25,0:11:15.17,Default,,0,0,0,,Бұл жолы барлық Кловермен
Dialogue: 0,0:11:15.75,0:11:16.46,Default,,0,0,0,,О
Dialogue: 0,0:11:16.55,0:11:20.51,Default,,0,0,0,,Бояу тасталған шахта қирандылары Зынданда еденіндегі Босс шайқасы басталды!
Dialogue: 0,0:11:21.01,0:11:22.72,Default,,0,0,0,,Қабат бастықтарының шайқасы басталады!
Dialogue: 0,0:11:26.76,0:11:27.39,Default,,0,0,0,,Мен келе жатырмын
Dialogue: 0,0:11:27.47,0:11:28.72,Default,,0,0,0,,-Маған қалдырыңыз -ssu
Dialogue: 0,0:11:29.48,0:11:31.98,Default,,0,0,0,,Гүрілдеген күн күркіреуі, дүбірлі дауыл
Dialogue: 0,0:11:32.06,0:11:34.77,Default,,0,0,0,,Құрғақ жер, нұрлы күн
Dialogue: 0,0:11:34.86,0:11:36.02,Default,,0,0,0,,Паралич
Dialogue: 0,0:11:36.11,0:11:39.40,Default,,0,0,0,,Баяу және өлімге әкелетін улы бас айналу
Dialogue: 0,0:11:41.49,0:11:44.41,Default,,0,0,0,,Жарықтың қамшысы, Жамандарды шаб
Dialogue: 0,0:11:44.49,0:11:48.04,Default,,0,0,0,,Бесінші деңгейдегі сиқырлы найзағай!
Dialogue: 0,0:11:52.00,0:11:53.29,Default,,0,0,0,,Дауыл
Dialogue: 0,0:11:53.79,0:11:56.92,Default,,0,0,0,,Бесінші деңгейлі сиқырлы құмды дауыл!
Dialogue: 0,0:11:58.50,0:11:59.30,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:02.68,0:12:03.18,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:06.01,0:12:07.18,Default,,0,0,0,,Хмф!
Dialogue: 0,0:12:11.14,0:12:12.27,Default,,0,0,0,,Аа...
Dialogue: 0,0:12:14.69,0:12:16.06,Default,,0,0,0,,Жаудың белгісі жоқ
Dialogue: 0,0:12:16.69,0:12:18.11,Default,,0,0,0,,Ұрыстың соңы
Dialogue: 0,0:12:18.19,0:12:19.94,Default,,0,0,0,,үшін тозуды тексереді
Dialogue: 0,0:12:20.57,0:12:22.24,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:22.32,0:12:23.99,Default,,0,0,0,,Менде де проблема жоқ.
Dialogue: 0,0:12:24.07,0:12:25.82,Default,,0,0,0,,5 атрибут көрсеткісін пайдаланыңыз
Dialogue: 0,0:12:25.91,0:12:29.20,Default,,0,0,0,,Бізде кем дегенде 10 қалды.
Dialogue: 0,0:12:29.29,0:12:30.45,Default,,0,0,0,,Жарақаттар жоқ
Dialogue: 0,0:12:30.54,0:12:32.50,Default,,0,0,0,,Мен де жақсымын.
Dialogue: 0,0:12:32.58,0:12:33.96,Default,,0,0,0,,Жүгіру де жақсы.
Dialogue: 0,0:12:34.58,0:12:36.04,Default,,0,0,0,,Жарайды, әрі қарай жүрейік.
Dialogue: 0,0:12:41.59,0:12:43.01,Default,,0,0,0,,Бұл ауа...
Dialogue: 0,0:12:43.09,0:12:45.47,Default,,0,0,0,,Баратын жер жақын шығар
Dialogue: 0,0:12:45.55,0:12:47.55,Default,,0,0,0,,Мен де сеземін.
Dialogue: 0,0:12:47.64,0:12:51.27,Default,,0,0,0,,Тағы бір нәрсе, тағы екі... Баспалдақтан түскенде
Dialogue: 0,0:12:51.35,0:12:52.73,Default,,0,0,0,,Бұл шыңырау қақпасы.
Dialogue: 0,0:12:53.35,0:12:55.48,Default,,0,0,0,,Үлкен аға, абай болыңыз
Dialogue: 0,0:12:56.10,0:12:58.23,Default,,0,0,0,,Бұл белгі жақсы емес.
Dialogue: 0,0:12:58.31,0:13:00.02,Default,,0,0,0,,Сіз де соны сезінесіз бе?
Dialogue: 0,0:13:00.11,0:13:02.74,Default,,0,0,0,,Ол жер сияқты тұрақты емес
Dialogue: 0,0:13:03.24,0:13:07.24,Default,,0,0,0,,Мен де маған басқа әлем ағып жатқанын сеземін.
Dialogue: 0,0:13:07.32,0:13:09.33,Default,,0,0,0,,Яғни...
Dialogue: 0,0:13:09.41,0:13:11.62,Default,,0,0,0,,үшінңыз, бұрынғыдан да мұқият болыңыз.
Dialogue: 0,0:13:12.58,0:13:13.87,Default,,0,0,0,,- (Нибель) Ах - (Джейми) Иә?
Dialogue: 0,0:13:13.95,0:13:14.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:18.46,0:13:20.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:22.21,0:13:24.01,Default,,0,0,0,,- Юк мырза! -жаңбыр!
Dialogue: 0,0:13:24.67,0:13:26.63,Default,,0,0,0,,Жоқ... қайда жоғалып кетті?
Dialogue: 0,0:13:26.72,0:13:28.09,Default,,0,0,0,,Юк!
Dialogue: 0,0:13:31.14,0:13:32.64,Default,,0,0,0,,Мен де «Жүгіруді» түсінбеймін.
Dialogue: 0,0:13:32.72,0:13:35.52,Default,,0,0,0,,Біз не істеуіміз керек? Жібек...
Dialogue: 0,0:13:37.69,0:13:38.77,Default,,0,0,0,,Осы шу-шудың бәрімен—
Dialogue: 0,0:13:38.85,0:13:39.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:39.90,0:13:40.86,Default,,0,0,0,,Библия
Dialogue: 0,0:13:40.94,0:13:43.65,Default,,0,0,0,,Ол Юк мырза мен Рейнді қайта кездестіре алатынын айтады.
Dialogue: 0,0:13:44.15,0:13:45.40,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:13:45.49,0:13:47.91,Default,,0,0,0,,Мен бұл туралы білмеймін ...
Dialogue: 0,0:13:47.99,0:13:51.03,Default,,0,0,0,,Юке мырзаға сеніңіз, әрі қарай жүрейік.
Dialogue: 0,0:13:51.70,0:13:54.95,Default,,0,0,0,,Юк мырза да дәл осылай айтатынына сенімдімін.
Dialogue: 0,0:13:55.04,0:13:57.62,Default,,0,0,0,,«үшінңыз өз мақсатыңызды орындаңыз»
Dialogue: 0,0:13:58.79,0:14:00.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:00.54,0:14:01.84,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:01.92,0:14:04.17,Default,,0,0,0,,Ми... Бәрі жақсы ма?
Dialogue: 0,0:14:04.26,0:14:04.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:12.56,0:14:13.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:16.98,0:14:18.69,Default,,0,0,0,,Мен осындай жерде болдым
Dialogue: 0,0:14:18.77,0:14:19.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:20.86,0:14:22.69,Default,,0,0,0,,Жақсы нәрсе болды ма?
Dialogue: 0,0:14:22.77,0:14:23.86,Default,,0,0,0,,Юк
Dialogue: 0,0:14:24.53,0:14:25.61,Default,,0,0,0,,Мен сені ұмытып кеттім.
Dialogue: 0,0:14:26.19,0:14:28.70,Default,,0,0,0,,Иә, иә, не болды?
Dialogue: 0,0:14:30.61,0:14:34.41,Default,,0,0,0,,Қараңдаршы, аспан бұлттанып бара жатыр. Үйге барайық.
Dialogue: 0,0:14:34.49,0:14:36.37,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:39.25,0:14:41.17,Default,,0,0,0,,Жоқ, мама, бұл...
Dialogue: 0,0:14:41.75,0:14:43.71,Default,,0,0,0,,Бұл не? Бұл
Dialogue: 0,0:14:43.79,0:14:45.13,Default,,0,0,0,,- (Юктың анасы) А... - (Юк) Қашайық!
Dialogue: 0,0:14:48.42,0:14:50.63,Default,,0,0,0,,Юк, тез қаш!
Dialogue: 0,0:14:50.72,0:14:52.22,Default,,0,0,0,,(Көрермен) Оның стратегиясы болмады ма — жай ғана барып оны қоздырды?
Dialogue: 0,0:14:54.10,0:14:56.64,Default,,0,0,0,,А... аа!
Dialogue: 0,0:15:02.10,0:15:03.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:04.98,0:15:07.94,Default,,0,0,0,,Юк, қайтып кел, олай істей алмайсың!
Dialogue: 0,0:15:08.03,0:15:08.61,Default,,0,0,0,,Жаңбыр…
Dialogue: 0,0:15:13.95,0:15:15.91,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:15.99,0:15:17.95,Default,,0,0,0,,Юку... Юку!
Dialogue: 0,0:15:18.75,0:15:20.46,Default,,0,0,0,,Жаңбыр I...
Dialogue: 0,0:15:20.54,0:15:24.38,Default,,0,0,0,,Сөйлеме. Көлеңкенің аңдыушысына айналайын деп едім.
Dialogue: 0,0:15:24.96,0:15:25.84,Default,,0,0,0,,(Ер адам) Бұл жауыз!
Dialogue: 0,0:15:29.76,0:15:30.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:31.47,0:15:34.43,Default,,0,0,0,,Сіз мені құтқардыңыз. Мен қазір жақсымын.
Dialogue: 0,0:15:34.51,0:15:37.68,Default,,0,0,0,,Мен оны Юке жоғалып кеткен сәтте ұстадым.
Dialogue: 0,0:15:37.77,0:15:40.35,Default,,0,0,0,,Саған рахмет, бірге ұштық хехе
Dialogue: 0,0:15:40.43,0:15:42.44,Default,,0,0,0,,Бірақ бұл қорқынышты болды
Dialogue: 0,0:15:42.52,0:15:46.27,Default,,0,0,0,,Егер Юке көлеңкелі аңдыушыға айналса ше?
Dialogue: 0,0:15:46.36,0:15:47.48,Default,,0,0,0,,Мен де
Dialogue: 0,0:15:47.57,0:15:51.11,Default,,0,0,0,,Бұл менің әлемім төңкерілгенін білдіре ме?
Dialogue: 0,0:15:51.74,0:15:53.53,Default,,0,0,0,,үшін қауіпсіз бола ма?
Dialogue: 0,0:15:54.03,0:15:55.24,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:15:55.74,0:15:58.66,Default,,0,0,0,,Бірақ Юк қазір жақсы.
Dialogue: 0,0:15:58.74,0:16:00.12,Default,,0,0,0,,Әрине.
Dialogue: 0,0:16:02.71,0:16:04.96,Default,,0,0,0,,Тұңғиық қақпасы осында.
Dialogue: 0,0:16:05.04,0:16:07.17,Default,,0,0,0,,үшін бір бағытта
Dialogue: 0,0:16:07.25,0:16:10.13,Default,,0,0,0,,Қатысу жақын, мен де көріп тұрмын.
Dialogue: 0,0:16:11.26,0:16:13.51,Default,,0,0,0,,- Эй Юк - (Юк) Не болды?
Dialogue: 0,0:16:14.01,0:16:15.39,Default,,0,0,0,,Бұл сіздің бетіңізде
Dialogue: 0,0:16:15.47,0:16:16.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:17.72,0:16:19.72,Default,,0,0,0,,Юк түсінуге оңай
Dialogue: 0,0:16:19.81,0:16:22.64,Default,,0,0,0,,Бұл жолы не жасырып тұрсың?
Dialogue: 0,0:16:23.27,0:16:24.14,Default,,0,0,0,,Егер сен осы екеуін қорғасаң, мен шабуылға көңіл бөле аламын
Dialogue: 0,0:16:25.02,0:16:26.15,Default,,0,0,0,,Мен үшін де?
Dialogue: 0,0:16:27.27,0:16:28.40,Default,,0,0,0,,Сондай-ақ жаңбыр үшін
Dialogue: 0,0:16:29.07,0:16:30.78,Default,,0,0,0,,Енді мен ғана
Dialogue: 0,0:16:31.40,0:16:32.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:34.45,0:16:36.82,Default,,0,0,0,,Бұл маған тіпті айта алмайтын нәрсе.
Dialogue: 0,0:16:37.66,0:16:38.53,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:38.62,0:16:41.08,Default,,0,0,0,,Айтқым келеді, бірақ
Dialogue: 0,0:16:41.16,0:16:44.92,Default,,0,0,0,,Бірақ содан кейін мен тағы да бәрінен ерінемін.
Dialogue: 0,0:16:45.00,0:16:47.42,Default,,0,0,0,,Ынтымақтасырақ болсам ғой.
Dialogue: 0,0:16:48.00,0:16:49.80,Default,,0,0,0,,Юк қорқынышты.
Dialogue: 0,0:16:50.30,0:16:51.51,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:16:51.59,0:16:53.97,Default,,0,0,0,,Мен сені жоғалтып алудан қорқамын
Dialogue: 0,0:16:54.05,0:16:56.55,Default,,0,0,0,,Мен осы күнделікті өмірден айырылып қаламын ба деп қорқамын
Dialogue: 0,0:16:57.05,0:17:00.18,Default,,0,0,0,,Мен сенімен мәңгі бірге болып, күлімдеп жүргім келеді.
Dialogue: 0,0:17:01.06,0:17:03.52,Default,,0,0,0,,Жарайды, мен енді сұрамаймын.
Dialogue: 0,0:17:04.64,0:17:05.64,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:17:06.15,0:17:09.40,Default,,0,0,0,,Айтқыңыз келмейді, солай ма? Олай болса, жақсы
Dialogue: 0,0:17:11.48,0:17:12.61,Default,,0,0,0,,Кеттік
Dialogue: 0,0:17:12.69,0:17:14.49,Default,,0,0,0,,үшін алаңдаулы.
Dialogue: 0,0:17:21.41,0:17:23.33,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:17:24.00,0:17:26.08,Default,,0,0,0,,Юке мырза, Раин мырза!
Dialogue: 0,0:17:26.17,0:17:28.46,Default,,0,0,0,,Амансың деп үміттенемін...Жаңбыр да.
Dialogue: 0,0:17:29.04,0:17:30.09,Default,,0,0,0,,Жақсы
Dialogue: 0,0:17:30.17,0:17:31.92,Default,,0,0,0,,үшінңыз күтіңіздер.
Dialogue: 0,0:17:32.00,0:17:33.34,Default,,0,0,0,,Мен уайымдадым...
Dialogue: 0,0:17:33.42,0:17:34.59,Default,,0,0,0,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,0:17:34.67,0:17:35.88,Default,,0,0,0,,Жылы...
Dialogue: 0,0:17:35.97,0:17:38.30,Default,,0,0,0,,Сіз қаншалықты уайымдадыңыз?
Dialogue: 0,0:17:38.39,0:17:39.47,Default,,0,0,0,,Жаңбыр да
Dialogue: 0,0:17:40.10,0:17:41.47,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:17:41.56,0:17:42.85,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:42.93,0:17:45.43,Default,,0,0,0,,Бірақ біз осылай қайта кездесеміз, солай ма?
Dialogue: 0,0:17:45.93,0:17:47.14,Default,,0,0,0,,Ағай!
Dialogue: 0,0:17:47.23,0:17:49.31,Default,,0,0,0,,Бұл өте баяу болды, солай емес пе?
Dialogue: 0,0:17:49.40,0:17:50.23,Default,,0,0,0,,Юк
Dialogue: 0,0:17:51.27,0:17:52.94,Default,,0,0,0,,Көп нәрсе болды.
Dialogue: 0,0:17:56.07,0:17:59.16,Default,,0,0,0,,Онии-чан Рейн-ничан Қош келдіңіз
Dialogue: 0,0:17:59.66,0:18:02.70,Default,,0,0,0,,Мен бұл сен туралы болғандықтан жақсы болар деп ойладым.
Dialogue: 0,0:18:02.79,0:18:04.12,Default,,0,0,0,,Мен уайымдадым.
Dialogue: 0,0:18:04.20,0:18:06.87,Default,,0,0,0,,Мені Тенебра жұтып қоя жаздады
Dialogue: 0,0:18:06.96,0:18:09.12,Default,,0,0,0,,Жаңбыр маған көмектесті.
Dialogue: 0,0:18:09.21,0:18:10.92,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:11.00,0:18:14.00,Default,,0,0,0,,Түссіз қараңғылық Юкті жоюға тырысты ма?
Dialogue: 0,0:18:14.51,0:18:16.80,Default,,0,0,0,,Олар Юкті қауіп ретінде қабылдайды.
Dialogue: 0,0:18:16.88,0:18:18.80,Default,,0,0,0,,Менің жиенім күткендей.
Dialogue: 0,0:18:18.88,0:18:21.60,Default,,0,0,0,,Мен бақытты болуым керек пе? ол
Dialogue: 0,0:18:21.68,0:18:24.10,Default,,0,0,0,,Есіңде бірдеңе бар ма?
Dialogue: 0,0:18:24.18,0:18:25.89,Default,,0,0,0,,Жағымсыз нәрсе жасаңыз.
Dialogue: 0,0:18:25.97,0:18:28.44,Default,,0,0,0,,Сонда сіз оның не екенін білесіз бе?
Dialogue: 0,0:18:42.03,0:18:42.87,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:46.83,0:18:47.91,Default,,0,0,0,,Мұндай жағдайлар бола ма?
Dialogue: 0,0:18:50.04,0:18:52.54,Default,,0,0,0,,Мен де аздап түсіндім.
Dialogue: 0,0:18:52.63,0:18:56.05,Default,,0,0,0,,Бұрынғы Юкенің белгісімен бірдей.
Dialogue: 0,0:18:57.09,0:19:00.22,Default,,0,0,0,,Ағай, мұнда не бар?
Dialogue: 0,0:19:00.30,0:19:01.89,Default,,0,0,0,,Бұл Тұңғиық қақпасы емес пе?
Dialogue: 0,0:19:02.39,0:19:05.47,Default,,0,0,0,,Мұндай алдамшы қатысудың не болуы мүмкін ...
Dialogue: 0,0:19:06.52,0:19:07.98,Default,,0,0,0,,Тұңғиық қақпасы
Dialogue: 0,0:19:16.11,0:19:18.15,Default,,0,0,0,,Сіз оларға айтпаған сияқтысыз.
Dialogue: 0,0:19:18.65,0:19:20.90,Default,,0,0,0,,Мен сізге араласуға рұқсат ете алмаймын.
Dialogue: 0,0:19:21.41,0:19:24.74,Default,,0,0,0,,Ол менің жиенім болса да, әйелдердің сезімін түсінбейді.
Dialogue: 0,0:19:24.83,0:19:26.99,Default,,0,0,0,,Мен оларды қатыстырғым келеді.
Dialogue: 0,0:19:27.91,0:19:30.25,Default,,0,0,0,,Махаббаттың әр түрі әртүрлі.
Dialogue: 0,0:19:30.83,0:19:32.17,Default,,0,0,0,,Мен айтамын
Dialogue: 0,0:19:32.25,0:19:34.21,Default,,0,0,0,,Қандай таңдау жасасаңыз да.
Dialogue: 0,0:19:34.29,0:19:36.59,Default,,0,0,0,,Мен өз ісімді істеймін
Dialogue: 0,0:19:36.67,0:19:40.63,Default,,0,0,0,,Бәрін өзім шешіп алсам жақсы болар еді.
Dialogue: 0,0:19:42.76,0:19:46.60,Default,,0,0,0,,Қызық, сен неге танымалсың, мен неге танымал емеспін?
Dialogue: 0,0:19:46.68,0:19:49.85,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Ағай, сіз танымал болдыңыз ғой?
Dialogue: 0,0:19:49.93,0:19:51.19,Default,,0,0,0,,Сіз білдіңіз бе?
Dialogue: 0,0:19:52.19,0:19:56.15,Default,,0,0,0,,Сонда да менің артымнан тозақтың түбіне дейін еретін әйел бар.
Dialogue: 0,0:19:56.23,0:19:57.57,Default,,0,0,0,,Онда ешкім болған жоқ.
Dialogue: 0,0:20:11.41,0:20:12.50,Default,,0,0,0,,Баруға дайын
Dialogue: 0,0:20:12.58,0:20:13.71,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,0:20:13.79,0:20:16.42,Default,,0,0,0,,Иә, трансляцияны бастаңыз
Dialogue: 0,0:20:16.50,0:20:17.96,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:20:20.01,0:20:23.80,Default,,0,0,0,,Бұл үлестірімнің жерге қосылғанына сеніңіз
Dialogue: 0,0:20:24.43,0:20:28.18,Default,,0,0,0,,Кловер енді түссіз қараңғылықтың ең терең қойнауына енеді...
Dialogue: 0,0:20:28.26,0:20:29.93,Default,,0,0,0,,Тұңғиық қақпасына барыңыз
Dialogue: 0,0:20:30.02,0:20:33.89,Default,,0,0,0,,Бірақ бұл мен ойлағандай болмауы мүмкін.
Dialogue: 0,0:20:33.98,0:20:35.10,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:20:35.19,0:20:37.48,Default,,0,0,0,,Аздап қорқынышты
Dialogue: 0,0:20:37.56,0:20:41.61,Default,,0,0,0,,Бұл бас тарту сезімі, осы қысым сезімі, осы жек көру сезімі
Dialogue: 0,0:20:42.11,0:20:44.32,Default,,0,0,0,,Бұл еденнің басты есігіне ұқсайды.
Dialogue: 0,0:20:44.40,0:20:47.91,Default,,0,0,0,,Иә, бұл дәл өрнек деп ойлаймын.
Dialogue: 0,0:20:47.99,0:20:50.62,Default,,0,0,0,,«Көру – сену»
Dialogue: 0,0:20:50.70,0:20:51.58,Default,,0,0,0,,Кеттік
Dialogue: 0,0:20:51.66,0:20:55.42,Default,,0,0,0,,Бұл мені дірілдейді, дәлірек айтсақ.
Dialogue: 0,0:20:55.50,0:20:58.34,Default,,0,0,0,,Мен баруға болмайтын жерге бара жатқан сияқтымын.
Dialogue: 0,0:20:58.42,0:21:01.55,Default,,0,0,0,,Иә, бұл өте жаман.
Dialogue: 0,0:21:01.63,0:21:03.47,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:21:16.56,0:21:18.56,Default,,0,0,0,,♪～
Dialogue: 0,0:22:43.57,0:22:45.57,Default,,0,0,0,,～♪
Dialogue: 0,0:22:46.90,0:22:49.70,Default,,0,0,0,,Келесі жолы «Арманнан тыс»
Dialogue: 0,0:22:51.20,0:22:57.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
