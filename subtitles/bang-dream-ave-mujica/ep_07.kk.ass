Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.00,0:00:07.17,Default,,0,0,0,,Шо-чан. (Шоко) Ах!
Dialogue: 0,0:00:07.17,0:00:10.17,Default,,0,0,0,,Мен оны Айнчаннан естідім.
Dialogue: 0,0:00:10.17,0:00:14.08,Default,,0,0,0,,Сіз шынымен Муцу-чанды танымаймын дедіңіз бе?
Dialogue: 0,0:00:17.01,0:00:20.02,Default,,0,0,0,,Оның сізге қатысы жоқ. Ах!
Dialogue: 0,0:00:22.52,0:00:26.36,Default,,0,0,0,,Муцу-чанмен таныс болыңыз! Тоқта!
Dialogue: 0,0:00:26.36,0:00:28.52,Default,,0,0,0,,Муцу-чан-чи, кеттік!
Dialogue: 0,0:00:28.52,0:00:30.53,Default,,0,0,0,,Иә? Қараңыз.
Dialogue: 0,0:00:30.53,0:00:32.53,Default,,0,0,0,,Тоқта! Жарайды!
Dialogue: 0,0:00:32.53,0:00:34.70,Default,,0,0,0,,Мен саған тоқтауыңды айтып тұрмын! Мен қашқым келеді! ?
Dialogue: 0,0:00:34.70,0:00:37.03,Default,,0,0,0,,Жібер! Барайық!
Dialogue: 0,0:00:37.03,0:00:40.37,Default,,0,0,0,,Сіз бармайтыныңызды айттыңыз!
Dialogue: 0,0:00:40.37,0:00:42.70,Default,,0,0,0,,Ах! Кяах!
Dialogue: 0,0:00:42.70,0:00:45.54,Default,,0,0,0,,Ха ха…. Уф...
Dialogue: 0,0:00:45.54,0:00:49.21,Default,,0,0,0,,Муцу-чан сенімен танысқысы келді! Ах...
Dialogue: 0,0:00:49.21,0:00:52.71,Default,,0,0,0,,Шоу Чан Муцучанмен не болып жатқанын білетін шығар.
Dialogue: 0,0:00:52.71,0:00:54.72,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:00:54.72,0:00:56.72,Default,,0,0,0,,Хмм….
Dialogue: 0,0:00:56.72,0:00:59.22,Default,,0,0,0,,Егер кездессек... А?
Dialogue: 0,0:00:59.22,0:01:01.92,Default,,0,0,0,,Баяғыда...
Dialogue: 0,0:01:05.99,0:01:10.60,Default,,0,0,0,,Тағы кездессем... Муцуми...!
Dialogue: 0,0:01:15.00,0:01:19.51,Default,,0,0,0,,Мен Шо-чанның пәтеріне бардым. Ха!
Dialogue: 0,0:01:19.51,0:01:23.68,Default,,0,0,0,,Шо-чанға не болғанын қазір білемін.
Dialogue: 0,0:01:23.68,0:01:27.68,Default,,0,0,0,,Ешқашан болған жоқ деп ойлап қалмаңыз.
Dialogue: 0,0:01:33.36,0:01:35.36,Default,,0,0,0,,⚟Қайырлы таң! ⚟Қайырлы таң!
Dialogue: 0,0:01:35.36,0:01:39.86,Default,,0,0,0,,Иә? Соёрин?
Dialogue: 0,0:01:39.86,0:01:42.20,Default,,0,0,0,,(Ескерту дыбысы)
Dialogue: 0,0:01:42.20,0:01:44.37,Default,,0,0,0,,Томори! (жарық) А?
Dialogue: 0,0:01:44.37,0:01:46.37,Default,,0,0,0,,Міне, міне!
Dialogue: 0,0:03:29.00,0:03:31.01,Default,,0,0,0,,Артқа қайт!
Dialogue: 0,0:03:31.01,0:03:34.18,Default,,0,0,0,,Мені мұнда неге әкелдің? ? Шоко-чан, сен жаман қызсың!
Dialogue: 0,0:03:34.18,0:03:36.51,Default,,0,0,0,,Өтінемін, сәл ғана жеткілікті.
Dialogue: 0,0:03:36.51,0:03:39.35,Default,,0,0,0,,Шо-чан да.
Dialogue: 0,0:03:39.35,0:03:43.02,Default,,0,0,0,,Адамның қаны шынымен ағып жатыр ма? Ах.
Dialogue: 0,0:03:43.02,0:03:45.69,Default,,0,0,0,,Бұл адам емес! Неге!
Dialogue: 0,0:03:45.69,0:03:48.19,Default,,0,0,0,,Осы уақытқа дейін жай қалдырыңыз...
Dialogue: 0,0:03:48.19,0:03:50.69,Default,,0,0,0,,Иә? Қайтып келу!
Dialogue: 0,0:03:50.69,0:03:53.53,Default,,0,0,0,,Сенің жүзіңді көргім де келмейді! Қайтып келу!
Dialogue: 0,0:03:53.53,0:03:55.70,Default,,0,0,0,,Мортис... Сен де сатқынсың!
Dialogue: 0,0:03:55.70,0:03:57.70,Default,,0,0,0,,Сіз де! сен де!
Dialogue: 0,0:03:57.70,0:04:01.60,Default,,0,0,0,,Қайту...!
Dialogue: 0,0:04:03.97,0:04:09.48,Default,,0,0,0,,Бұл драмадағы «Хитоденаши» желісі ме?
Dialogue: 0,0:04:09.48,0:04:12.81,Default,,0,0,0,,Драма? Минами Моридің "Махаббат айлағы".
Dialogue: 0,0:04:12.81,0:04:15.82,Default,,0,0,0,,А, ол да.
Dialogue: 0,0:04:15.82,0:04:18.82,Default,,0,0,0,,((Артқа қайт! Сенің жүзіңді көргім де келмейді!
Dialogue: 0,0:04:18.82,0:04:21.49,Default,,0,0,0,,Артқа қайтыңыз! Сенің жүзіңді көргім де келмейді! ))
Dialogue: 0,0:04:21.49,0:04:25.59,Default,,0,0,0,,Не... ойлайсың...?
Dialogue: 0,0:04:27.83,0:04:31.50,Default,,0,0,0,,Бұл қуыршақ... Иә?
Dialogue: 0,0:04:31.50,0:04:36.51,Default,,0,0,0,,Мен бос әрекет етіп жатырмын...
Dialogue: 0,0:04:36.51,0:04:40.68,Default,,0,0,0,,Өйткені мен... Муцумиді қуыршаққа айналдырдым...
Dialogue: 0,0:04:40.68,0:04:44.18,Default,,0,0,0,,Ах! Муцуми қазірдің өзінде ...
Dialogue: 0,0:04:44.18,0:04:50.85,Default,,0,0,0,,Адам болғысы келу деген осы...
Dialogue: 0,0:04:50.85,0:04:53.02,Default,,0,0,0,,Ах... (жылау)
Dialogue: 0,0:04:53.02,0:04:58.03,Default,,0,0,0,,Дәл сол қыз айтқандай, мен адам емеспін...
Dialogue: 0,0:04:58.03,0:05:08.14,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:05:15.31,0:05:18.01,Default,,0,0,0,,Шо-чан….
Dialogue: 0,0:05:26.99,0:05:28.99,Default,,0,0,0,,Маған тұз беріңізші!
Dialogue: 0,0:05:28.99,0:05:32.99,Default,,0,0,0,,Кешіріңіз, бірақ Муцуми менімен кездесе алмайды.
Dialogue: 0,0:05:32.99,0:05:37.50,Default,,0,0,0,,Мен кездескенше осында күте аласыз ба?
Dialogue: 0,0:05:37.50,0:05:41.84,Default,,0,0,0,,Ішінде күтіңіз. үй.
Dialogue: 0,0:05:41.84,0:06:00.96,Default,,0,0,0,,♬～
Dialogue: 0,0:06:00.96,0:06:04.79,Default,,0,0,0,,📱
Dialogue: 0,0:06:04.79,0:06:08.63,Default,,0,0,0,,Барған дұрыс емес пе? Хмм...
Dialogue: 0,0:06:08.63,0:06:11.03,Default,,0,0,0,,Шо-чан бара жатқан сияқты.
Dialogue: 0,0:06:12.97,0:06:15.14,Default,,0,0,0,,Жаттығуды бастайық.
Dialogue: 0,0:06:15.14,0:06:18.14,Default,,0,0,0,,Муцу-чан түсінбейді.
Dialogue: 0,0:06:18.14,0:06:20.31,Default,,0,0,0,,Түсіну үшін неше рет айтуым керек?
Dialogue: 0,0:06:20.31,0:06:22.48,Default,,0,0,0,,Мен жаман емеспін.
Dialogue: 0,0:06:22.48,0:06:24.65,Default,,0,0,0,,Маған Шомен танысуға рұқсат етіңіз.
Dialogue: 0,0:06:24.65,0:06:27.82,Default,,0,0,0,,Біз кездескен кезде Муцуми мұңаяды. Ол аурады.
Dialogue: 0,0:06:27.82,0:06:29.82,Default,,0,0,0,,Мен сені қорғаймын.
Dialogue: 0,0:06:29.82,0:06:34.49,Default,,0,0,0,,Ах... Шо: Ол көптен бері тұр...
Dialogue: 0,0:06:34.49,0:06:36.49,Default,,0,0,0,,Сіз мені жақсы көргеніңіз үшін тұрсыз, солай ма?
Dialogue: 0,0:06:36.49,0:06:41.50,Default,,0,0,0,,Мортис өтінемін. Енді сөйлеме.
Dialogue: 0,0:06:41.50,0:06:44.00,Default,,0,0,0,,Өйткені мен тек жағымсыз нәрселерді айтамын➡
Dialogue: 0,0:06:44.00,0:06:46.00,Default,,0,0,0,,Аузыңды жап. Ах➡
Dialogue: 0,0:06:46.00,0:06:48.50,Default,,0,0,0,,Бірақ... (Мортис) Тоқта...
Dialogue: 0,0:06:48.50,0:06:53.17,Default,,0,0,0,,Мен Шомен танысқым келеді. Қарғыс атсын!
Dialogue: 0,0:06:53.17,0:06:55.18,Default,,0,0,0,,Тоқта, тоқта, тоқта!
Dialogue: 0,0:06:55.18,0:06:57.18,Default,,0,0,0,,Тоқта! (айнаның сынған дыбысы)
Dialogue: 0,0:06:57.18,0:06:59.35,Default,,0,0,0,,Ах! (Алдыңғы есіктің ашылған дыбысы)
Dialogue: 0,0:06:59.35,0:07:02.95,Default,,0,0,0,,Сендер, үндемеңдер!➡
Dialogue: 0,0:07:02.95,0:07:06.62,Default,,0,0,0,,Ха ха ха Шо…. Ха! Муцуми!
Dialogue: 0,0:07:06.62,0:07:10.13,Default,,0,0,0,,Ха ха ха шян… ха ха….
Dialogue: 0,0:07:10.13,0:07:12.46,Default,,0,0,0,,Шо...!
Dialogue: 0,0:07:12.46,0:07:15.80,Default,,0,0,0,,Оған қол тигізбеңіз! Ах!
Dialogue: 0,0:07:15.80,0:07:17.80,Default,,0,0,0,,Муцу….
Dialogue: 0,0:07:17.80,0:07:20.47,Default,,0,0,0,,Ха! Жоқ, мен...
Dialogue: 0,0:07:20.47,0:07:25.14,Default,,0,0,0,,Муцуми! жақсы…. ақырында….
Dialogue: 0,0:07:25.14,0:07:27.98,Default,,0,0,0,,Ақырында...! Эх...!
Dialogue: 0,0:07:27.98,0:07:30.81,Default,,0,0,0,,Егер мен оны қайтарып алсам, мен бәрін істеймін...!
Dialogue: 0,0:07:30.81,0:07:35.65,Default,,0,0,0,,Мен... сені міндетті түрде аламын... Уф...
Dialogue: 0,0:07:35.65,0:07:37.85,Default,,0,0,0,,Уф! Ах!
Dialogue: 0,0:07:40.66,0:07:43.83,Default,,0,0,0,,(алдыңғы есік жабылған дыбыс)
Dialogue: 0,0:07:43.83,0:07:46.49,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:07:46.49,0:07:51.33,Default,,0,0,0,,Мен жаман баламын ба...?
Dialogue: 0,0:07:51.33,0:07:58.67,Default,,0,0,0,,♬ (өнімділік)
Dialogue: 0,0:07:58.67,0:08:01.78,Default,,0,0,0,,)
Dialogue: 0,0:08:01.78,0:08:05.45,Default,,0,0,0,,《Әйтеуір, барғаным дұрыс емес сияқты.》
Dialogue: 0,0:08:05.45,0:08:07.45,Default,,0,0,0,,(Таяқтардың соғу дыбысы)
Dialogue: 0,0:08:07.45,0:08:09.45,Default,,0,0,0,,Басс Сіз қайтадан қателесесіз.
Dialogue: 0,0:08:09.45,0:08:11.62,Default,,0,0,0,,Сіз оны дұрыс ойнадыңыз, солай ма? Қайда?
Dialogue: 0,0:08:11.62,0:08:14.46,Default,,0,0,0,,Сіз қайтадан Муцуми туралы ойлайсыз ба?
Dialogue: 0,0:08:14.46,0:08:17.96,Default,,0,0,0,,Мен шынымен де қызықпын. Муцу-чан да➡
Dialogue: 0,0:08:17.96,0:08:20.63,Default,,0,0,0,,Шоко-чан да жылап отырды. иә?
Dialogue: 0,0:08:20.63,0:08:22.63,Default,,0,0,0,,Бұл жаман болды...
Dialogue: 0,0:08:22.63,0:08:25.53,Default,,0,0,0,,Мен Шоко-чанды дұрыс түсінбеген шығармын.
Dialogue: 0,0:08:27.47,0:08:30.14,Default,,0,0,0,,Тұрақты тікелей эфир Сіз ертең екенін білесіз бе?
Dialogue: 0,0:08:30.14,0:08:33.14,Default,,0,0,0,,Сойо да, Айн да мүлде шоғырлана алмайды.
Dialogue: 0,0:08:33.14,0:08:35.64,Default,,0,0,0,,Жаңа ән шығара алмасам да...
Dialogue: 0,0:08:35.64,0:08:38.15,Default,,0,0,0,,Тек шамдар дұрыс жұмыс істеп тұр.
Dialogue: 0,0:08:38.15,0:08:42.65,Default,,0,0,0,,Соңғы кездері ән мәтінін көп жазып жүрмін.
Dialogue: 0,0:08:42.65,0:08:46.32,Default,,0,0,0,,Ынталы болыңыз. Біз MyGO! ! ! ! ! Өйткені бұл солай.
Dialogue: 0,0:08:46.32,0:08:48.82,Default,,0,0,0,,Сіз дұрыс тікелей шоу жасауды шештіңіз.
Dialogue: 0,0:08:48.82,0:08:50.83,Default,,0,0,0,,(құбырдың құлаған дыбысы)
Dialogue: 0,0:08:50.83,0:08:53.83,Default,,0,0,0,,Сондықтан студия 2 сағатқа ұзартылады! ?
Dialogue: 0,0:08:53.83,0:08:55.83,Default,,0,0,0,,Аз ғана. иә?
Dialogue: 0,0:08:55.83,0:08:59.17,Default,,0,0,0,,Муцудың үйі Айтшы. Мен сені шегемен шаншып аламын.
Dialogue: 0,0:08:59.17,0:09:02.10,Default,,0,0,0,,Тырнақ! ? Тоқтамаңыз! Жарайды.
Dialogue: 0,0:09:02.10,0:09:05.81,Default,,0,0,0,,Дұрысы, неге мен? Сойоруннан сұрауым керек пе?
Dialogue: 0,0:09:10.61,0:09:14.28,Default,,0,0,0,,Хмм, мен көмектесе алмаймын. Мен сенімен барайын ба?
Dialogue: 0,0:09:14.28,0:09:17.29,Default,,0,0,0,,Жалғыз жүр.
Dialogue: 0,0:09:21.79,0:09:24.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:24.13,0:09:27.80,Default,,0,0,0,,Сіз білесіз. Ах.
Dialogue: 0,0:09:27.80,0:09:30.97,Default,,0,0,0,,Рики…. Не істесең де өзіңе байланысты➡
Dialogue: 0,0:09:30.97,0:09:33.64,Default,,0,0,0,,MyGO! ! ! ! ! Мені мазаламаңыз. иә?
Dialogue: 0,0:09:33.64,0:09:37.47,Default,,0,0,0,,Сойо да, Айн да топқа шоғырлана алмайды.
Dialogue: 0,0:09:37.47,0:09:39.64,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:09:39.64,0:09:42.81,Default,,0,0,0,,Сіз жыладыңыз ба? иә?
Dialogue: 0,0:09:42.81,0:09:44.98,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:09:44.98,0:09:47.48,Default,,0,0,0,,Мен Сойодан көп нәрсе болғанын естідім.
Dialogue: 0,0:09:47.48,0:09:51.99,Default,,0,0,0,,Ха! Өйткені мен ауыр сөз айттым.
Dialogue: 0,0:09:51.99,0:09:53.99,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:09:56.49,0:10:00.66,Default,,0,0,0,,Ах... КРИЧИК кезінде...
Dialogue: 0,0:10:00.66,0:10:02.83,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:02.83,0:10:06.33,Default,,0,0,0,,Муцуми ше? иә?
Dialogue: 0,0:10:06.33,0:10:09.00,Default,,0,0,0,,Тіпті Тацуки де уайымдамайды.
Dialogue: 0,0:10:09.00,0:10:12.34,Default,,0,0,0,,А... сен мұнда неге келдің? Репетициядан бұрын да жаттығу бар➡
Dialogue: 0,0:10:12.34,0:10:14.34,Default,,0,0,0,,Түсіндің бе? Әсіресе.
Dialogue: 0,0:10:14.34,0:10:17.01,Default,,0,0,0,,Кішкене ескерту. Ах...
Dialogue: 0,0:10:17.01,0:10:19.01,Default,,0,0,0,,Аа...
Dialogue: 0,0:10:19.01,0:10:22.85,Default,,0,0,0,,Сіз Муцумимен кездестіңіз бе?
Dialogue: 0,0:10:22.85,0:10:25.85,Default,,0,0,0,,Бұл өткінші. иә.
Dialogue: 0,0:10:25.85,0:10:28.19,Default,,0,0,0,,⚟Мм. (Алдыңғы есіктің ашылған дыбысы)
Dialogue: 0,0:10:28.19,0:10:30.69,Default,,0,0,0,,Ішінде күткіңіз келе ме?
Dialogue: 0,0:10:30.69,0:10:33.19,Default,,0,0,0,,Жоқ, мұнда... Мазалағаным үшін кешіріңіз. Ха!
Dialogue: 0,0:10:35.86,0:10:38.07,Default,,0,0,0,,Сіз дұрыс сөйлемейсіз, солай ма?
Dialogue: 0,0:10:40.87,0:10:43.87,Default,,0,0,0,,Айн маған хабарласты. Жауап берізші, өтінемін.
Dialogue: 0,0:10:43.87,0:10:47.58,Default,,0,0,0,,Мен болсам ше? Расында да солай.
Dialogue: 0,0:10:50.21,0:10:53.11,Default,,0,0,0,,Екеуің кездескен кездер болды ма?
Dialogue: 0,0:10:55.22,0:10:59.72,Default,,0,0,0,,Біз бәріміз әртүрлі мектепте оқимыз, сондықтан кездесуге мүмкіндік бар ма деп ойлаймын.
Dialogue: 0,0:10:59.72,0:11:02.66,Default,,0,0,0,,Шоу-чан мен Ту-чан бір мектепте оқиды, солай ма?
Dialogue: 0,0:11:02.66,0:11:06.16,Default,,0,0,0,,Егер Тацуки-чан Хаокаға жаңа ғана барса, біз бірге болар едік.
Dialogue: 0,0:11:06.16,0:11:09.36,Default,,0,0,0,,Жақсы. Ханаджоға не үшін бардың?
Dialogue: 0,0:11:13.33,0:11:15.34,Default,,0,0,0,,Уф….
Dialogue: 0,0:11:15.34,0:11:19.14,Default,,0,0,0,,Өйткені ол Маки-санның сіңлісі дейді. иә?
Dialogue: 0,0:11:21.18,0:11:24.51,Default,,0,0,0,,Үлкен апа, сіз атақтысыз. Ха~.
Dialogue: 0,0:11:24.51,0:11:27.12,Default,,0,0,0,,Ах. 📱
Dialogue: 0,0:11:29.35,0:11:31.52,Default,,0,0,0,,Сондай-ақ Айнадан. 📱
Dialogue: 0,0:11:31.52,0:11:34.19,Default,,0,0,0,,Жаттығу уақыты өтті.
Dialogue: 0,0:11:34.19,0:11:37.19,Default,,0,0,0,,Осы уақытқа дейін келсең, мені жалғыз қалдыра алмайсың. Ах.
Dialogue: 0,0:11:37.19,0:11:40.36,Default,,0,0,0,,Таратылғанымен, мен әлі мүше болдым.
Dialogue: 0,0:11:40.36,0:11:43.53,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:11:43.53,0:11:46.87,Default,,0,0,0,,Мен Муцуми не ойлайтынын білмеймін.
Dialogue: 0,0:11:46.87,0:11:50.57,Default,,0,0,0,,Топ Бұл қызық болмаған сияқты.
Dialogue: 0,0:11:52.87,0:11:57.55,Default,,0,0,0,,Айтқаныңыздың бәрі дұрыс емес.
Dialogue: 0,0:11:57.55,0:12:00.48,Default,,0,0,0,,Мм. (Шоко) Әсіресе Муцуми➡
Dialogue: 0,0:12:00.48,0:12:05.65,Default,,0,0,0,,Мен өз қателіктерім үшін өзімді кінәлап келемін.
Dialogue: 0,0:12:05.65,0:12:07.66,Default,,0,0,0,,Онда неге олай істедің?
Dialogue: 0,0:12:07.66,0:12:10.66,Default,,0,0,0,,Көңіл көтермеген Муцудың өзі➡
Dialogue: 0,0:12:10.66,0:12:13.83,Default,,0,0,0,,Себебі гитарада ойнау мені қанағаттандырмады.
Dialogue: 0,0:12:13.83,0:12:15.83,Default,,0,0,0,,Ах! Өтірік...
Dialogue: 0,0:12:17.83,0:12:24.01,Default,,0,0,0,,Муцуми КРИЧИКті жақсы көрді...
Dialogue: 0,0:12:24.01,0:12:26.01,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:12:26.01,0:12:28.34,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:28.34,0:12:31.35,Default,,0,0,0,,Ах! Муцуми! Мортис-чан.
Dialogue: 0,0:12:31.35,0:12:37.02,Default,,0,0,0,,Мен саған Муцу-чанмен кездесуге рұқсат етемін.
Dialogue: 0,0:12:37.02,0:12:39.19,Default,,0,0,0,,Муцу...?
Dialogue: 0,0:12:39.19,0:12:41.86,Default,,0,0,0,,Шо…. Ах!
Dialogue: 0,0:12:41.86,0:12:44.03,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:12:44.03,0:12:47.03,Default,,0,0,0,,Шо, жараланған жоқсың ба?
Dialogue: 0,0:12:47.03,0:12:50.37,Default,,0,0,0,,Ха... Муцуми ештеңе емес...
Dialogue: 0,0:12:50.37,0:12:53.70,Default,,0,0,0,,Барлығы… Мен істейтіндердің барлығы➡
Dialogue: 0,0:12:53.70,0:12:57.54,Default,,0,0,0,,Себебі мен саған арқа сүйедім...
Dialogue: 0,0:12:57.54,0:13:00.34,Default,,0,0,0,,Кешірші менмін...!
Dialogue: 0,0:13:02.48,0:13:04.48,Default,,0,0,0,,Сойо. Ах!
Dialogue: 0,0:13:04.48,0:13:06.48,Default,,0,0,0,,Рики. иә?
Dialogue: 0,0:13:06.48,0:13:11.49,Default,,0,0,0,,Кешіріңіз... Мен топты бұздым...
Dialogue: 0,0:13:11.49,0:13:14.32,Default,,0,0,0,,Мен гитарада жақсы емеспін...
Dialogue: 0,0:13:14.32,0:13:16.49,Default,,0,0,0,,Мен әрқашан кешірім сұрағым келді...
Dialogue: 0,0:13:16.49,0:13:22.33,Default,,0,0,0,,Жарайды, қазір! Дұрысы, мен де... Кешіріңіз!
Dialogue: 0,0:13:22.33,0:13:25.83,Default,,0,0,0,,Мен де Торудан кешірім сұрағым келеді.
Dialogue: 0,0:13:25.83,0:13:28.67,Default,,0,0,0,,Менің ойымша, Муцумиде кешірім сұрайтын ештеңе жоқ.
Dialogue: 0,0:13:28.67,0:13:30.67,Default,,0,0,0,,А... 📱 (дірілдеген дыбыс)
Dialogue: 0,0:13:30.67,0:13:32.67,Default,,0,0,0,,📱 (дірілдеген дыбыс)
Dialogue: 0,0:13:32.67,0:13:34.68,Default,,0,0,0,,Иә. Апыр-ай! ? (қатты гитара)
Dialogue: 0,0:13:34.68,0:13:37.01,Default,,0,0,0,,📱Жақында жаттығу басталады! ? (қатты гитара)
Dialogue: 0,0:13:37.01,0:13:39.81,Default,,0,0,0,,📱Тікелей эфирді дұрыс көрсетпеуім керек еді! (қатты гитара)
Dialogue: 0,0:13:42.35,0:13:45.35,Default,,0,0,0,,Жарық…. Муцу-чан…
Dialogue: 0,0:13:47.36,0:13:49.36,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:13:54.86,0:13:57.37,Default,,0,0,0,,Бұл…. Ах...
Dialogue: 0,0:13:57.37,0:13:59.37,Default,,0,0,0,,Бұл дәптер...!
Dialogue: 0,0:13:59.37,0:14:03.14,Default,,0,0,0,,«Адам болғысы келетін ән»….
Dialogue: 0,0:14:03.14,0:14:05.14,Default,,0,0,0,,Ән мәтіні Біртүрлі.
Dialogue: 0,0:14:05.14,0:14:07.31,Default,,0,0,0,,Соңғы уақытта жазып жүргендеріңіз осы ма?
Dialogue: 0,0:14:07.31,0:14:11.65,Default,,0,0,0,,Неліктен? Өйткені Шо-чан осылай деді.
Dialogue: 0,0:14:11.65,0:14:14.82,Default,,0,0,0,,Мен адам болғым келеді.
Dialogue: 0,0:14:14.82,0:14:16.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:16.82,0:14:20.82,Default,,0,0,0,,Дәлірек айтсақ, бұл әндер... Uppup...!
Dialogue: 0,0:14:20.82,0:14:23.66,Default,,0,0,0,,Ахахаха! Неге күлесің?
Dialogue: 0,0:14:23.66,0:14:26.99,Default,,0,0,0,,Өйткені бұл әндер Ахахха!
Dialogue: 0,0:14:26.99,0:14:32.50,Default,,0,0,0,,(жеңіл күлкі)
Dialogue: 0,0:14:32.50,0:14:37.00,Default,,0,0,0,,Ху... Ту Чан: Бұл керемет.
Dialogue: 0,0:14:37.00,0:14:39.17,Default,,0,0,0,,Аа...
Dialogue: 0,0:14:39.17,0:14:41.51,Default,,0,0,0,,Бұрынғы қолайсыздықтар үшін кешірім сұраймын.
Dialogue: 0,0:14:41.51,0:14:43.51,Default,,0,0,0,,Иә? Мен оған комплимент айттым. Фу.
Dialogue: 0,0:14:43.51,0:14:46.51,Default,,0,0,0,,Ол әнді енді ойнатпа.
Dialogue: 0,0:14:46.51,0:14:48.52,Default,,0,0,0,,Иә! иә?
Dialogue: 0,0:14:48.52,0:14:52.02,Default,,0,0,0,,Ракуна-чан бір жерге кетті, сондықтан біз репетиция жасай алмаймыз.
Dialogue: 0,0:14:52.02,0:14:54.02,Default,,0,0,0,,Сахнаны пайдалансам ше?
Dialogue: 0,0:15:05.30,0:15:20.65,Default,,0,0,0,,♬～
Dialogue: 0,0:15:20.65,0:15:26.49,Default,,0,0,0,,♬ «Мен жер іздедім, бақыт іздедім».
Dialogue: 0,0:15:26.49,0:15:29.49,Default,,0,0,0,,♬ «Мен оны жоғалтқым келмейді».
Dialogue: 0,0:15:29.49,0:15:32.33,Default,,0,0,0,,♬～
Dialogue: 0,0:15:32.33,0:15:38.17,Default,,0,0,0,,♬ «Әр минутты қатты ұстаңыз».
Dialogue: 0,0:15:38.17,0:15:45.01,Default,,0,0,0,,♬ «Менің қолымнан келетіні осы.»
Dialogue: 0,0:15:45.01,0:15:48.18,Default,,0,0,0,,♬～
Dialogue: 0,0:15:48.18,0:15:55.02,Default,,0,0,0,,♬ «Жарықта билеп жүрген сен тым алыссың».
Dialogue: 0,0:15:55.02,0:15:58.69,Default,,0,0,0,,♬ «Мен оны түсіне алмаймын»
Dialogue: 0,0:15:58.69,0:16:04.13,Default,,0,0,0,,♬ «Не болды және мен не жыладым»
Dialogue: 0,0:16:04.13,0:16:11.30,Default,,0,0,0,,♬ «Ол жерден не көрдің?»
Dialogue: 0,0:16:11.30,0:16:18.31,Default,,0,0,0,,♬ «Мен бұл қауырсынға қарап тұрдым».
Dialogue: 0,0:16:18.31,0:16:24.15,Default,,0,0,0,,♬ «Адам болғың келді деп күбірлеген саған».
Dialogue: 0,0:16:24.15,0:16:30.15,Default,,0,0,0,,♬ «Айтқан сөзің де, мейірімділігің де бөлек».
Dialogue: 0,0:16:30.15,0:16:36.66,Default,,0,0,0,,♬«Тіпті бақыт бірдей емес»
Dialogue: 0,0:16:36.66,0:16:42.33,Default,,0,0,0,,♬ «Әркім басынан»
Dialogue: 0,0:16:42.33,0:16:48.00,Default,,0,0,0,,♬ «Мен әлі де денемді ашып, қолымды созғым келеді».
Dialogue: 0,0:16:48.00,0:16:54.34,Default,,0,0,0,,♬ «Қанша қателессем де, бұл менің жүрегімнің зары».
Dialogue: 0,0:16:54.34,0:17:00.78,Default,,0,0,0,,♬ «Тыныс ал және жыла»
Dialogue: 0,0:17:00.78,0:17:07.62,Default,,0,0,0,,♬ «Мен адам болғым келеді»
Dialogue: 0,0:17:07.62,0:17:20.03,Default,,0,0,0,,♬～
Dialogue: 0,0:17:29.48,0:17:31.78,Default,,0,0,0,,Уф… Уф….
Dialogue: 0,0:17:33.81,0:17:35.82,Default,,0,0,0,,Бұл ән...
Dialogue: 0,0:17:35.82,0:17:39.15,Default,,0,0,0,,Ах...! Ха! Ах...
Dialogue: 0,0:17:39.15,0:17:41.82,Default,,0,0,0,,Бұл ән➡
Dialogue: 0,0:17:41.82,0:17:47.33,Default,,0,0,0,,Шо-чанды ойлап жазған өлеңім.
Dialogue: 0,0:17:49.33,0:17:54.00,Default,,0,0,0,,Бірақ ойланып қарасам да, бәрібір бейберекет...
Dialogue: 0,0:17:54.00,0:17:57.34,Default,,0,0,0,,Мен ештеңе көрмеймін...
Dialogue: 0,0:17:57.34,0:18:02.61,Default,,0,0,0,,Бірақ... мен ештеңе түсінбеймін...
Dialogue: 0,0:18:02.61,0:18:04.61,Default,,0,0,0,,Бірақ...!
Dialogue: 0,0:18:04.61,0:18:07.45,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:18:07.45,0:18:09.45,Default,,0,0,0,,ＣＲＹＣＨＩＣ…。
Dialogue: 0,0:18:09.45,0:18:13.45,Default,,0,0,0,,КРИЧИК... Жасай...
Dialogue: 0,0:18:13.45,0:18:16.29,Default,,0,0,0,,Жақсы….
Dialogue: 0,0:18:16.29,0:18:18.46,Default,,0,0,0,,Жарық….
Dialogue: 0,0:18:18.46,0:18:21.80,Default,,0,0,0,,Уф….
Dialogue: 0,0:18:21.80,0:18:23.97,Default,,0,0,0,,Аа...
Dialogue: 0,0:18:23.97,0:18:28.30,Default,,0,0,0,,Я... Тағы бір ән жақсы!
Dialogue: 0,0:18:28.30,0:18:30.30,Default,,0,0,0,,А... Сіз жасайсыз.
Dialogue: 0,0:18:30.30,0:18:33.01,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:35.98,0:18:38.28,Default,,0,0,0,,Шо-чан.
Dialogue: 0,0:18:46.65,0:18:48.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:58.83,0:19:08.28,Default,,0,0,0,,♬ «Касуга көлеңкесі»
Dialogue: 0,0:19:08.28,0:19:12.45,Default,,0,0,0,,《Сойо: Менің ойымша, біз тек көргіміз келген нәрсені көрдік.
Dialogue: 0,0:19:12.45,0:19:16.78,Default,,0,0,0,,Мен оларды ешкімге ұқсамайтын ерекше топ деп ойладым.
Dialogue: 0,0:19:16.78,0:19:20.79,Default,,0,0,0,,Мен бұл тағдыр деп сенемін...
Dialogue: 0,0:19:20.79,0:19:25.79,Default,,0,0,0,,Барлығымен бас қосқан әр күнім көңілді, жарқын өтті.
Dialogue: 0,0:19:25.79,0:19:30.97,Default,,0,0,0,,Жоғалтқанымнан болар, одан да сұлу болып көріндім.
Dialogue: 0,0:19:30.97,0:19:36.14,Default,,0,0,0,,Мен мұны қалап, қайтқым келді.》
Dialogue: 0,0:19:36.14,0:19:38.81,Default,,0,0,0,,《Тацуки: Жарық әнімен құтқарылды.
Dialogue: 0,0:19:38.81,0:19:41.48,Default,,0,0,0,,Сол күндегі ең жақсы тікелей эфир➡
Dialogue: 0,0:19:41.48,0:19:44.48,Default,,0,0,0,,Мәңгілік жалғасатын сияқты...
Dialogue: 0,0:19:44.48,0:19:46.81,Default,,0,0,0,,Мұны істей алатын жеңілмейтін топ➡
Dialogue: 0,0:19:46.81,0:19:49.15,Default,,0,0,0,,Мен оны асыға күттім.
Dialogue: 0,0:19:49.15,0:19:54.82,Default,,0,0,0,,Бірақ шын мәнінде біз топта ойнайтын қарапайым адамдар едік➡
Dialogue: 0,0:19:54.82,0:19:57.99,Default,,0,0,0,,Бұл қарапайым топ болды.
Dialogue: 0,0:19:57.99,0:20:00.33,Default,,0,0,0,,Осындай кәдімгі CRYCHIC➡
Dialogue: 0,0:20:00.33,0:20:03.66,Default,,0,0,0,,Маған сол кезде керек еді.
Dialogue: 0,0:20:03.66,0:20:06.67,Default,,0,0,0,,Мен сияқты мұнда қалуға болады➡
Dialogue: 0,0:20:06.67,0:20:09.50,Default,,0,0,0,,Бұл маған ұнаған бірінші орын болғандықтан》
Dialogue: 0,0:20:09.50,0:20:12.84,Default,,0,0,0,,♬ «Сол күні мен жылай алмадым».
Dialogue: 0,0:20:12.84,0:20:21.02,Default,,0,0,0,,♬ «Жарық сізге ақырын еріп жүреді».
Dialogue: 0,0:20:21.02,0:20:24.69,Default,,0,0,0,,《Шоко: Бұл менің жақсы жұмысым болды.
Dialogue: 0,0:20:24.69,0:20:27.19,Default,,0,0,0,,Мен алысқа қарауға тырысамын➡
Dialogue: 0,0:20:27.19,0:20:29.69,Default,,0,0,0,,Оның тереңдігі сонша, мен оған жабысып қалдым.
Dialogue: 0,0:20:29.69,0:20:32.53,Default,,0,0,0,,Бірақ бұл соңы.
Dialogue: 0,0:20:32.53,0:20:36.70,Default,,0,0,0,,CRYCHIC енді жоқ.
Dialogue: 0,0:20:36.70,0:20:39.70,Default,,0,0,0,,《Сойо: Рахмет, мен сені жақсы көремін》
Dialogue: 0,0:20:39.70,0:20:43.70,Default,,0,0,0,,《Тацуки: Қазір біздің жеріміз болмаса да》
Dialogue: 0,0:20:43.70,0:20:48.54,Default,,0,0,0,,《Шоко: Бүгінгі спектакль мен ешқашан ұмытпаймын》
Dialogue: 0,0:20:48.54,0:20:53.35,Default,,0,0,0,,♬ «Мені жіберме»
Dialogue: 0,0:20:56.05,0:21:10.16,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:21:10.16,0:21:12.17,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:21:12.17,0:21:14.34,Default,,0,0,0,,Күтіңіз, күтіңіз, MyGO! ! ! ! ! Репетиция!
Dialogue: 0,0:21:14.34,0:21:16.34,Default,,0,0,0,,Мұның аяқталуына жол бермеңіз!
Dialogue: 0,0:21:16.34,0:21:19.51,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:21:19.51,0:21:21.51,Default,,0,0,0,,Көзді салқындату керек.
Dialogue: 0,0:21:21.51,0:21:24.35,Default,,0,0,0,,Муцуми. Хмм.
Dialogue: 0,0:21:24.35,0:21:26.51,Default,,0,0,0,,Иә. Ах.
Dialogue: 0,0:21:26.51,0:21:28.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:28.68,0:21:32.02,Default,,0,0,0,,Рахмет. оқасы жоқ!
Dialogue: 0,0:21:32.02,0:21:34.86,Default,,0,0,0,,Мен де оны Муцуми-чанның қолданғанына қуаныштымын.
Dialogue: 0,0:21:34.86,0:21:38.19,Default,,0,0,0,,Әлі де жылап жатыр. (Тацуки) Шулы.
Dialogue: 0,0:21:38.19,0:21:41.53,Default,,0,0,0,,Сіз орамал қолданасыз ба? Бұл жақсы, өйткені менде бар.
Dialogue: 0,0:21:41.53,0:21:44.03,Default,,0,0,0,,Аяқталды ма? Күткеніңізге рахмет.
Dialogue: 0,0:21:44.03,0:21:47.03,Default,,0,0,0,,Иә, содан кейін MyGO! ! ! ! ! Жаттығу жасайық!
Dialogue: 0,0:21:47.03,0:21:49.04,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:21:51.54,0:21:53.54,Default,,0,0,0,,Ах. Хмм.
Dialogue: 0,0:21:53.54,0:21:55.54,Default,,0,0,0,,Хачиман мырза….
Dialogue: 0,0:21:55.54,0:21:58.05,Default,,0,0,0,,Сіз бұрынғы Саясыз ба? Бұл тамаша.
Dialogue: 0,0:21:58.05,0:22:00.65,Default,,0,0,0,,Ах... Жарайды онда ➡
Dialogue: 0,0:22:00.65,0:22:05.05,Default,,0,0,0,,Бұрынғы Саяға қайта оралғыңыз келе ме?
Dialogue: 0,0:22:06.55,0:22:12.55,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
