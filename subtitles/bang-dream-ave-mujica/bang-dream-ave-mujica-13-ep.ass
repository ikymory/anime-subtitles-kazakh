Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.10,0:00:03.10,Default,,0,0,0,,(аудитория дауысы)
Dialogue: 0,0:00:03.10,0:00:06.07,Default,,0,0,0,,Тоёкава мырза, уақыт келді.
Dialogue: 0,0:00:10.11,0:00:12.11,Default,,0,0,0,,Кеттік
Dialogue: 0,0:00:12.11,0:00:14.11,Default,,0,0,0,,Орындайық, шеңберге!
Dialogue: 0,0:00:14.11,0:00:16.11,Default,,0,0,0,,Менің кезегім келді.
Dialogue: 0,0:00:16.11,0:00:18.11,Default,,0,0,0,,Егер сіз мұны істегіңіз келсе, оны тез орындаңыз.
Dialogue: 0,0:00:18.11,0:00:20.12,Default,,0,0,0,,Қараңызшы, Рики де!
Dialogue: 0,0:00:20.12,0:00:22.12,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын~Менің~...
Dialogue: 0,0:00:22.12,0:00:24.12,Default,,0,0,0,,Мен мұны істейтін болсам, бұл Ту болар еді!
Dialogue: 0,0:00:24.12,0:00:26.12,Default,,0,0,0,,Иә? Олай болса, Томорин!
Dialogue: 0,0:00:26.12,0:00:28.12,Default,,0,0,0,,«Менің жүрмін!»
Dialogue: 0,0:00:28.12,0:00:32.43,Default,,0,0,0,,Ух... иә, у... барамын~!
Dialogue: 0,0:00:32.43,0:00:34.13,Default,,0,0,0,,Е, күте тұр, күт (Ракуна) Жүр~
Dialogue: 0,0:00:34.13,0:00:37.13,Default,,0,0,0,,Бұл күн, бұл түн тек бір рет
Dialogue: 0,0:00:37.13,0:00:39.13,Default,,0,0,0,,...
Dialogue: 0,0:00:39.13,0:00:41.14,Default,,0,0,0,,Бүгін аталатын гүлді теру➡
Dialogue: 0,0:00:41.14,0:00:43.14,Default,,0,0,0,,Бүгінгі кешке ләззат сыйлайық
Dialogue: 0,0:00:43.14,0:00:45.14,Default,,0,0,0,,Бұл рахат па?
Dialogue: 0,0:00:45.14,0:00:47.14,Default,,0,0,0,,Жамандық жасайтын сияқтысың.
Dialogue: 0,0:00:47.14,0:00:49.14,Default,,0,0,0,,Хэхе...
Dialogue: 0,0:00:49.14,0:00:52.15,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:00:52.15,0:00:54.15,Default,,0,0,0,,Ａｖｅ Ｍｕｊｉｃａ
Dialogue: 0,0:00:54.15,0:00:57.15,Default,,0,0,0,,Моккай Моккай! «Жүр!» Мұның бәрі болған жоқ!
Dialogue: 0,0:00:57.15,0:01:00.16,Default,,0,0,0,,Келесі кездескенше (Айне) Келесі жолы қашан болады?
Dialogue: 0,0:01:00.16,0:01:03.09,Default,,0,0,0,,Ах~ (Рики) Мен қазір тамақ ішпеймін!
Dialogue: 0,0:01:03.09,0:01:05.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:05.09,0:01:08.06,Default,,0,0,0,,Ши~тоу Мен сезім тудырып жатырмын
Dialogue: 0,0:01:11.10,0:01:14.10,Default,,0,0,0,,Рикки кеттік
Dialogue: 0,0:01:14.10,0:01:16.07,Default,,0,0,0,,Ннн…
Dialogue: 0,0:01:20.11,0:01:25.11,Default,,0,0,0,,♪ «Ничисен күзі»
Dialogue: 0,0:01:25.11,0:01:37.13,Default,,0,0,0,,♪～
Dialogue: 0,0:01:37.13,0:01:42.13,Default,,0,0,0,,♪ Жүрегімді жаулап алған сөздерді аршып алып, өзіммен бірге ала кет.
Dialogue: 0,0:01:42.13,0:01:48.14,Default,,0,0,0,,♪ Жолдағы бұрылыстың соңына қарай жүре бастаймыз
Dialogue: 0,0:01:48.14,0:01:53.14,Default,,0,0,0,,♪ Айналғанда не істеуім керек?
Dialogue: 0,0:01:53.14,0:01:58.15,Default,,0,0,0,,♪ Жыл мезгілдері де өзгереді, мен де өзгеретін сияқтымын.
Dialogue: 0,0:01:58.15,0:02:04.09,Default,,0,0,0,,♪ Тербеліп, Мен бүгін тағы бір бұрышта тұрмын
Dialogue: 0,0:02:04.09,0:02:09.09,Default,,0,0,0,,♪ Оң мен солды таңдау мүмкін емес
Dialogue: 0,0:02:09.09,0:02:14.10,Default,,0,0,0,,♪ Қайда қаңғып жүргенімді білмеймін.
Dialogue: 0,0:02:14.10,0:02:19.10,Default,,0,0,0,,♪ Бірақ мен сәл әріге барамын.
Dialogue: 0,0:02:19.10,0:02:24.11,Default,,0,0,0,,♪ Күндерімізді сюжетсіз өткіземіз
Dialogue: 0,0:02:24.11,0:02:30.11,Default,,0,0,0,,♪ Мені бейтаныс эмоциялар билейді
Dialogue: 0,0:02:30.11,0:02:36.12,Default,,0,0,0,,♪ Зардап алсам да, Қайтадан жараласам да
Dialogue: 0,0:02:36.12,0:02:43.13,Default,,0,0,0,,♪ Мен дәл осында қалғым келеді
Dialogue: 0,0:02:43.13,0:02:51.13,Default,,0,0,0,,♪～
Dialogue: 0,0:02:51.13,0:02:56.14,Default,,0,0,0,,♪ Тіпті өзімді түсінбесем де
Dialogue: 0,0:02:56.14,0:03:02.08,Default,,0,0,0,,♪ Сонда да мен сені түсінгім келді.
Dialogue: 0,0:03:02.08,0:03:07.08,Default,,0,0,0,,♪ Алақандағы кеңсе тауарлары жылы
Dialogue: 0,0:03:07.08,0:03:12.09,Default,,0,0,0,,♪ Сенімен қол ұстасып тұрғандай
Dialogue: 0,0:03:12.09,0:03:17.09,Default,,0,0,0,,♪ Бас айналса, қабақтарыңызды жабыңыз.
Dialogue: 0,0:03:17.09,0:03:23.10,Default,,0,0,0,,♪ Кеше кері айналдырған сайын
Dialogue: 0,0:03:23.10,0:03:28.10,Default,,0,0,0,,♪ Егер сыйлық төгілсе
Dialogue: 0,0:03:28.10,0:03:33.11,Default,,0,0,0,,♪ Көзімді ашып қарап тұруым керек
Dialogue: 0,0:03:33.11,0:03:38.11,Default,,0,0,0,,♪ Мен кесектерді жинасам да қайта алмаймын
Dialogue: 0,0:03:38.11,0:03:43.12,Default,,0,0,0,,♪ Мен сол сәтке қайта орала алмаймын
Dialogue: 0,0:03:43.12,0:03:50.13,Default,,0,0,0,,♪ Тығылып, алға жылжи алмай қаламын деп ойладым.
Dialogue: 0,0:03:50.13,0:03:55.13,Default,,0,0,0,,♪ Мені жаңа жел соқты
Dialogue: 0,0:03:55.13,0:04:04.07,Default,,0,0,0,,♪ Ажырасқан жолымыз болашақта қайта тоғысса
Dialogue: 0,0:04:04.07,0:04:10.08,Default,,0,0,0,,♪ Басымды төмен салып ән айтамын, өйткені мен сені тапқым келеді
Dialogue: 0,0:04:10.08,0:04:18.09,Default,,0,0,0,,♪ Хидамари сияқты күлгеніңді қалаймын, аа
Dialogue: 0,0:04:18.09,0:04:28.10,Default,,0,0,0,,♪～
Dialogue: 0,0:04:28.10,0:04:34.10,Default,,0,0,0,,♪ Дәл қазір біз ғана адасып кете аламыз
Dialogue: 0,0:04:34.10,0:04:39.11,Default,,0,0,0,,♪ Ұмытқым келмегендіктен ән айтып жатырмын
Dialogue: 0,0:04:39.11,0:04:45.11,Default,,0,0,0,,♪ Мейірімді сен, сол қалпыңда қалуың үшін.
Dialogue: 0,0:04:45.11,0:04:49.12,Default,,0,0,0,,♪ Мен оны осы дауысқа салдым
Dialogue: 0,0:04:49.12,0:04:55.12,Default,,0,0,0,,♪ Күндерімізді сюжетсіз өткіземіз
Dialogue: 0,0:04:55.12,0:05:00.13,Default,,0,0,0,,♪ Тұрақты уайымға шығу
Dialogue: 0,0:05:00.13,0:05:06.07,Default,,0,0,0,,♪ Зардап алсам да, Қайтадан жараласам да
Dialogue: 0,0:05:06.07,0:05:13.07,Default,,0,0,0,,♪ Мен мұнда ән айтып жатырмын
Dialogue: 0,0:05:13.07,0:05:20.08,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:05:20.08,0:05:23.08,Default,,0,0,0,,Таң Османттың иісі
Dialogue: 0,0:05:23.08,0:05:26.09,Default,,0,0,0,,Сол қыз гүлдеп тұрған жерді тауып алды➡
Dialogue: 0,0:05:26.09,0:05:29.09,Default,,0,0,0,,Ағаштарды сүзіп өткен күн сәулесі жұмсақ болды.
Dialogue: 0,0:05:29.09,0:05:32.09,Default,,0,0,0,,♪ (гитара орындауы)
Dialogue: 0,0:05:32.09,0:05:35.10,Default,,0,0,0,,Студияда нота дайындау кезінде➡
Dialogue: 0,0:05:35.10,0:05:38.10,Default,,0,0,0,,Арқамдағы Тачи-чанның дыбысы... (Тацуки) Фуфу...
Dialogue: 0,0:05:38.10,0:05:43.10,Default,,0,0,0,,Жаттығу алдында түртудің тыныштандыратын дыбысы
Dialogue: 0,0:05:43.10,0:05:47.11,Default,,0,0,0,,Мен Ракуна-чанмен конпейто жедім.
Dialogue: 0,0:05:47.11,0:05:50.11,Default,,0,0,0,,Ракуна-чан жасыл қытырлақ битті тістеп жатыр➡
Dialogue: 0,0:05:50.11,0:05:52.11,Default,,0,0,0,,«Бұл матчтың дәмі емес»
Dialogue: 0,0:05:52.11,0:05:54.12,Default,,0,0,0,,Дәмі қауын сияқты болды.
Dialogue: 0,0:05:54.12,0:06:00.12,Default,,0,0,0,,Мен ертерек сүрінгенде, Соё Чан қолымнан ұстады.
Dialogue: 0,0:06:00.12,0:06:05.06,Default,,0,0,0,,Соё-чанның қолдары бұрынғыдан сәл суық.
Dialogue: 0,0:06:05.06,0:06:08.03,Default,,0,0,0,,Жыл мезгілдері өзгерді
Dialogue: 0,0:06:10.07,0:06:12.03,Default,,0,0,0,,Томорин
Dialogue: 0,0:06:14.07,0:06:16.07,Default,,0,0,0,,♪ 『Такионучи』
Dialogue: 0,0:06:16.07,0:06:20.08,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:20.08,0:06:25.08,Default,,0,0,0,,"Біздің себептеріміздің бәрі басқаша болғанына сенімдімін. Ол күнге дейін жүгінетін жеріміз болмады".
Dialogue: 0,0:06:25.08,0:06:29.08,Default,,0,0,0,,«Қайта жарақат алғым келмейді деп төмен қарадым».
Dialogue: 0,0:06:29.08,0:06:31.09,Default,,0,0,0,,«Мен адасып қалдым, сондықтан мен сені кездестірдім».
Dialogue: 0,0:06:31.09,0:06:34.09,Default,,0,0,0,,«Ақырында бірге ұстаған қолды жібермеймін».
Dialogue: 0,0:06:34.09,0:06:38.09,Default,,0,0,0,,«Не болса да, мен оны ұстанамын».
Dialogue: 0,0:06:38.09,0:06:42.10,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:42.10,0:06:58.11,Default,,0,0,0,,♪～
Dialogue: 0,0:06:58.11,0:07:02.05,Default,,0,0,0,,«Мен дұрыс жауаптың қандай екенін білмедім, сондықтан мен құладым да, ауырсынуды қайтадан білдім».
Dialogue: 0,0:07:02.05,0:07:05.05,Default,,0,0,0,,«Әйтеуір, тұрғаның үшін күлетін болмаспын».
Dialogue: 0,0:07:05.05,0:07:08.06,Default,,0,0,0,,«Тұйық болса да, мен басқа жол табамын»
Dialogue: 0,0:07:08.06,0:07:11.06,Default,,0,0,0,,♪ Осы дыбыспен үндесу, осында тұру
Dialogue: 0,0:07:11.06,0:07:15.06,Default,,0,0,0,,♪ Біз бір-бірімізге соқтығысқанда (көп рет), жүрегімде бір нұр лезде жанды.
Dialogue: 0,0:07:15.06,0:07:18.07,Default,,0,0,0,,«Кішкентай өрт, оны өшірме».
Dialogue: 0,0:07:18.07,0:07:20.07,Default,,0,0,0,,♪ (Жоғалмайды) «Әлі мағынасы да, баратын жері де жоқ».
Dialogue: 0,0:07:20.07,0:07:23.07,Default,,0,0,0,,«Біз кемелден алыспыз.»
Dialogue: 0,0:07:23.07,0:07:25.07,Default,,0,0,0,,«Мен тек осы тонмен атыс жасай аламын».
Dialogue: 0,0:07:25.07,0:07:28.08,Default,,0,0,0,,«Менің кеудем дәл қазір толқуда».
Dialogue: 0,0:07:28.08,0:07:30.08,Default,,0,0,0,,♪ Жүрегімнің ортасында
Dialogue: 0,0:07:30.08,0:07:33.08,Default,,0,0,0,,♪ (о, ортасында) ♪ Томорибиниде қалу үшін ән бар
Dialogue: 0,0:07:33.08,0:07:37.09,Default,,0,0,0,,♪ Мен дыбысымызды қаттырақ шығарғым келеді
Dialogue: 0,0:07:37.09,0:07:40.09,Default,,0,0,0,,♪ Ертең алыс (ах)
Dialogue: 0,0:07:40.09,0:07:45.09,Default,,0,0,0,,♪ Дәл қазір осы жерде тұрған бізге жарқыратайық
Dialogue: 0,0:07:45.09,0:07:52.10,Default,,0,0,0,,♪ Адасқанда адасып қалма.
Dialogue: 0,0:07:52.10,0:07:56.10,Default,,0,0,0,,♪（Ｉｔ’ｓ ｏｕｒ ｓｏｕｎｄ）
Dialogue: 0,0:07:56.10,0:07:59.11,Default,,0,0,0,,♪～
Dialogue: 0,0:07:59.11,0:08:03.04,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:03.04,0:08:09.05,Default,,0,0,0,,♪～
Dialogue: 0,0:08:09.05,0:08:13.05,Default,,0,0,0,,«Мен не айтсам да, адамдардың абдыраған көздерінен қорықтым».
Dialogue: 0,0:08:13.05,0:08:16.06,Default,,0,0,0,,«Мен ұстаған дауысты әлі де қабылдайтын музыка»
Dialogue: 0,0:08:16.06,0:08:18.06,Default,,0,0,0,,«Төгілген көз жасы да осында соғысады».
Dialogue: 0,0:08:18.06,0:08:20.06,Default,,0,0,0,,♪ Жүр, Ананың тұратын үйіне
Dialogue: 0,0:08:20.06,0:08:23.06,Default,,0,0,0,,♪ Мен соққан сайын гүлдеген жылу (өшпейді)
Dialogue: 0,0:08:23.06,0:08:26.07,Default,,0,0,0,,♪ Біз бөлісетін пилоттық жалын резонанс тудырады
Dialogue: 0,0:08:26.07,0:08:28.07,Default,,0,0,0,,«Ұзын от, саған нұр жаусын».
Dialogue: 0,0:08:28.07,0:08:31.07,Default,,0,0,0,,♪ «Әр жұдырықта»
Dialogue: 0,0:08:31.07,0:08:33.07,Default,,0,0,0,,«Ұстаған нәрсең басқаша болса, жарайды».
Dialogue: 0,0:08:33.07,0:08:38.08,Default,,0,0,0,,«Енді біз осы панк-рок музыкасына бірдей құмарлықты бөлісе аламыз.
Dialogue: 0,0:08:38.08,0:08:40.08,Default,,0,0,0,,♪ Мына көмейді жылат
Dialogue: 0,0:08:40.08,0:08:44.09,Default,,0,0,0,,♪ (ау дыбыс) ♪ Сол күні маған дыбыс әсер еткенде
Dialogue: 0,0:08:44.09,0:08:48.09,Default,,0,0,0,,♪ Дірілдеген кеудемде қонған көк жалын
Dialogue: 0,0:08:48.09,0:08:51.09,Default,,0,0,0,,♪ Соқпауы керек желде (ах)
Dialogue: 0,0:08:51.09,0:08:56.10,Default,,0,0,0,,♪ Үрленген қораптың ішінде сіз еркін ұша аласыз.
Dialogue: 0,0:08:56.10,0:08:59.10,Default,,0,0,0,,♪ Мен сенімен кез келген жерге барғым келеді
Dialogue: 0,0:08:59.10,0:09:08.04,Default,,0,0,0,,♪～
Dialogue: 0,0:09:08.04,0:09:12.05,Default,,0,0,0,,♪（Ｉｔ’ｓ ｏｕｒ ｓｏｕｎｄ）
Dialogue: 0,0:09:12.05,0:09:22.06,Default,,0,0,0,,♪～
Dialogue: 0,0:09:22.06,0:09:27.06,Default,,0,0,0,,♪（Ｉｔ’ｓ ｔｈｅ ｂｌａｚｉｎｇ ｏｕｒ ｓｏｕｎｄ．）
Dialogue: 0,0:09:27.06,0:09:32.07,Default,,0,0,0,,♪（Ｗｅ ａｌｌ ｓｉｎｇ ｏｕｔ ｗｉｔｈ ｔｈｅ ｓａｍｅ ｈｅａｔ．）
Dialogue: 0,0:09:32.07,0:09:42.08,Default,,0,0,0,,♪（Ｗｅ ｗｉｌｌ ｇｏ ｗｉｔｈ ｏｕｒ ｓｏｎｇ． Ｙｅｔ ｓｔｉｌｌ ｔｏｍｏｒｒｏｗ ｉｓ ｕｎｋｎｏｗｎ．）
Dialogue: 0,0:09:42.08,0:09:46.08,Default,,0,0,0,,«Тіпті қараңғыда да менімен бірге кезіп жүретін адам бар».
Dialogue: 0,0:09:46.08,0:09:51.09,Default,,0,0,0,,«Солай болса да, мен жалғыз қалған күндерімде осы әнді қосып жүремін».
Dialogue: 0,0:09:51.09,0:09:55.09,Default,,0,0,0,,«Осыдан кейін де тағы да жарақат аламын».
Dialogue: 0,0:09:55.09,0:09:57.09,Default,,0,0,0,,«Әйтеуір, мен жібергім келмейтін қол бар».
Dialogue: 0,0:09:57.09,0:09:59.09,Default,,0,0,0,,«Ажыратсам да берілмеймін».
Dialogue: 0,0:09:59.09,0:10:02.10,Default,,0,0,0,,«Құлап кетсем де, сен сияқты қайта тұрамын».
Dialogue: 0,0:10:02.10,0:10:06.10,Default,,0,0,0,,«Жарайды, ары қарай жүрейік».
Dialogue: 0,0:10:06.10,0:10:11.11,Default,,0,0,0,,«Мен енді адасып кетпеймін».
Dialogue: 0,0:10:11.11,0:10:15.11,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:15.11,0:10:35.13,Default,,0,0,0,,♬～
Dialogue: 0,0:10:35.13,0:10:38.13,Default,,0,0,0,,♪ 『Сегіз бұрышты жұлдыз биі』
Dialogue: 0,0:10:38.13,0:10:46.14,Default,,0,0,0,,♪ қызыл піл арыстан аю жынды
Dialogue: 0,0:10:46.14,0:10:54.15,Default,,0,0,0,,♪ Крекер шебері азап үйіне қош келдіңіз
Dialogue: 0,0:10:54.15,0:11:02.09,Default,,0,0,0,,♪ Бұл түнде цирк, бетперде киген сайқымазақ, тұрма.
Dialogue: 0,0:11:02.09,0:11:04.09,Default,,0,0,0,,♪ ｍａｋｅ ｉｔ ｈｏｔ
Dialogue: 0,0:11:04.09,0:11:11.10,Default,,0,0,0,,♪ Тағдырдың ашылуын акробатикалық поцелумен тұтандырыңыз
Dialogue: 0,0:11:11.10,0:11:16.10,Default,,0,0,0,,♪ Мен апат стилін ұстанбаймын.
Dialogue: 0,0:11:16.10,0:11:20.11,Default,,0,0,0,,♪ Қайғы, күлкі, иә, өлгенше
Dialogue: 0,0:11:20.11,0:11:22.11,Default,,0,0,0,,♪ ｂｕｄｄｙ， ａｌｒｉｇｈｔ？
Dialogue: 0,0:11:22.11,0:11:24.11,Default,,0,0,0,,♪ ｙｅｓ ｙａ ｇｏｎｎａ ｊｕｍｐ ｙｅｓ ｙａ ｇｏｎｎａ ｊｕｍｐ
Dialogue: 0,0:11:24.11,0:11:26.11,Default,,0,0,0,,♪ Жарып өту
Dialogue: 0,0:11:26.11,0:11:28.12,Default,,0,0,0,,♪ ｌｅｔ ｍｅ ｂｅ ｔｈｅ ｏｎｅ ｌｅｔ ｍｅ ｂｅ ｔｈｅ ｏｎｅ
Dialogue: 0,0:11:28.12,0:11:30.12,Default,,0,0,0,,♪‘ИӘ’ Сегіз бұрышты жұлдызға
Dialogue: 0,0:11:30.12,0:11:32.12,Default,,0,0,0,,♪ ｙｅｓ ｙａ ｇｏｎｎａ ｊｕｍｐ ｙｅｓ ｙａ ｇｏｎｎａ ｊｕｍｐ
Dialogue: 0,0:11:32.12,0:11:34.12,Default,,0,0,0,,♪ Күліңіз және айқайлаңыз
Dialogue: 0,0:11:34.12,0:11:39.13,Default,,0,0,0,,♪ Шынайы өмірді ұмытыңыз
Dialogue: 0,0:11:39.13,0:11:47.14,Default,,0,0,0,,♪ қызыл піл арыстан аю жынды
Dialogue: 0,0:11:47.14,0:11:57.11,Default,,0,0,0,,♪ Крекер шебері азап үйіне қош келдіңіз
Dialogue: 0,0:12:00.15,0:12:05.09,Default,,0,0,0,,♪『Бет』
Dialogue: 0,0:12:05.09,0:12:21.10,Default,,0,0,0,,♪～
Dialogue: 0,0:12:21.10,0:12:28.11,Default,,0,0,0,,♪ Ａｈ－ Ａｈ－ Ａｈ－
Dialogue: 0,0:12:28.11,0:12:32.11,Default,,0,0,0,,♪ Сіз жағдайды нашарлатып жатырсыз ба?
Dialogue: 0,0:12:32.11,0:12:36.12,Default,,0,0,0,,♪ Арлеккино, корсетіңізді реттеңіз.
Dialogue: 0,0:12:36.12,0:12:40.12,Default,,0,0,0,,♪ Иегімді сәл көтеріп, айнадан өзімді көремін
Dialogue: 0,0:12:40.12,0:12:43.12,Default,,0,0,0,,♪ Бірдей көрінетін әртүрлі беттер
Dialogue: 0,0:12:43.12,0:12:47.13,Default,,0,0,0,,♪ Макияж қос сүйкімділігі'
Dialogue: 0,0:12:47.13,0:12:50.13,Default,,0,0,0,,♪ Жүрегімді көрсетпеймін, расында.
Dialogue: 0,0:12:50.13,0:12:53.13,Default,,0,0,0,,♪ Уайымдама/Уайымдама, көз жасын төкейік.
Dialogue: 0,0:12:53.13,0:12:57.14,Default,,0,0,0,,♪ Есіңіз дұрыс па? Менің есі дұрыс
Dialogue: 0,0:12:57.14,0:13:04.08,Default,,0,0,0,,♪ Тегіс күндер өтірік ♪ Тегіс
Dialogue: 0,0:13:04.08,0:13:10.08,Default,,0,0,0,,♪ Емделмеу ♪ [1-2,]
Dialogue: 0,0:13:10.08,0:13:13.09,Default,,0,0,0,,♪ ｉ ａｍ ａ ｐｒｅｔｅｎｄｅｒ ｕｐ， ｕｐ， ｕｐ， ｕｐ，
Dialogue: 0,0:13:13.09,0:13:15.09,Default,,0,0,0,,♪ ｓｈａｋｅ， ｓｈａｋｅ， ｓｈａｋｅ ｉｔ ｕｐ
Dialogue: 0,0:13:15.09,0:13:18.09,Default,,0,0,0,,♪ Сен мені артымнан мазақтап тұрсың ♪ [Эй! ]
Dialogue: 0,0:13:18.09,0:13:20.09,Default,,0,0,0,,♪ ｔｈｅ ｐｒｅｔｅｎｄｅｒ ｕｐ， ｕｐ， ｕｐ， ｕｐ，
Dialogue: 0,0:13:20.09,0:13:22.10,Default,,0,0,0,,♪ ｓｈａｋｅ， ｓｈａｋｅ， ｓｈａｋｅ ｉｔ ｕｐ， ｉｔ ｕｐ
Dialogue: 0,0:13:22.10,0:13:25.10,Default,,0,0,0,,♪ [Ой жоқ] ♪ Ақымақ, сау бол.
Dialogue: 0,0:13:25.10,0:13:28.10,Default,,0,0,0,,♪ ｌｏｓｅｒ， ｌｏｓｅｒ， ｌｏｓｅｒ ♪ ［ｂｙｅ－ｂｙｅ ａｎｄ ｂｙｅ］
Dialogue: 0,0:13:28.10,0:13:31.11,Default,,0,0,0,,♪ Мен боянамын, макияж жасаймын, боянамын, балақай
Dialogue: 0,0:13:31.11,0:13:34.08,Default,,0,0,0,,♪ сізді басып тұрыңыз
Dialogue: 0,0:13:36.11,0:13:38.11,Default,,0,0,0,,♪ ｈｅｙ！
Dialogue: 0,0:13:38.11,0:13:51.13,Default,,0,0,0,,♪～
Dialogue: 0,0:13:51.13,0:13:56.13,Default,,0,0,0,,♪ Өтірік/Өтірік Жеті түрлі-түсті өтірік Күлімсіресеңіз, бұл бір төбе.
Dialogue: 0,0:13:56.13,0:13:58.13,Default,,0,0,0,,♪ Мына қытықтай жүрек
Dialogue: 0,0:13:58.13,0:14:02.07,Default,,0,0,0,,♪ Одан құтылу алгоритмі
Dialogue: 0,0:14:02.07,0:14:07.08,Default,,0,0,0,,♪ Бірақ бірдеңе жетіспейді. Мен білмеймін/білмеймін.
Dialogue: 0,0:14:07.08,0:14:12.08,Default,,0,0,0,,♪ Ах, мен қазір үйреніп қалдым ♪ [салқын-салқын,]
Dialogue: 0,0:14:12.08,0:14:14.08,Default,,0,0,0,,♪ ｉ ａｍ ａ ｐｒｅｔｅｎｄｅｒ ｕｐ， ｕｐ， ｕｐ， ｕｐ，
Dialogue: 0,0:14:14.08,0:14:16.08,Default,,0,0,0,,♪ ｓｈａｋｅ， ｓｈａｋｅ， ｓｈａｋｅ ｉｔ ｕｐ
Dialogue: 0,0:14:16.08,0:14:19.09,Default,,0,0,0,,♪ Сен мені артымнан мазақ етіп тұрсың ♪ [Эй! ]
Dialogue: 0,0:14:19.09,0:14:21.09,Default,,0,0,0,,♪ ｔｈｅ ｐｒｅｔｅｎｄｅｒ ｕｐ， ｕｐ， ｕｐ， ｕｐ，
Dialogue: 0,0:14:21.09,0:14:23.09,Default,,0,0,0,,♪ ｓｈａｋｅ， ｓｈａｋｅ， ｓｈａｋｅ ｉｔ ｕｐ， ｉｔ ｕｐ
Dialogue: 0,0:14:23.09,0:14:26.09,Default,,0,0,0,,♪ [Ой жоқ] ♪ Ақымақ, сау бол.
Dialogue: 0,0:14:26.09,0:14:32.10,Default,,0,0,0,,♪ ｌｏｓｅｒ， ｌｏｓｅｒ， ｌｏｓｅｒ
Dialogue: 0,0:14:32.10,0:14:35.10,Default,,0,0,0,,♪～
Dialogue: 0,0:14:35.10,0:14:39.11,Default,,0,0,0,,♪ Иә? [О, жоқ] Иә? [О, жоқ] Иә? сурет?
Dialogue: 0,0:14:39.11,0:14:43.11,Default,,0,0,0,,♪～
Dialogue: 0,0:14:43.11,0:14:46.11,Default,,0,0,0,,♪ Жақсы, жақсы, жақсы
Dialogue: 0,0:14:46.11,0:14:51.12,Default,,0,0,0,,♪ немесе сол сияқты.
Dialogue: 0,0:14:51.12,0:14:53.12,Default,,0,0,0,,♪ Айтыңызшы
Dialogue: 0,0:14:53.12,0:14:59.13,Default,,0,0,0,,♪ Бос өзін-өзі қорғау
Dialogue: 0,0:14:59.13,0:15:01.06,Default,,0,0,0,,♪ ［ｈａｔｅ］
Dialogue: 0,0:15:01.06,0:15:03.06,Default,,0,0,0,,♪ сіз тек жоғарыдан жоғары қарай қорғаушысыз
Dialogue: 0,0:15:03.06,0:15:05.07,Default,,0,0,0,,♪ ｓｈａｋｅ， ｓｈａｋｅ， ｓｈａｋｅ ｉｔ ｕｐ
Dialogue: 0,0:15:05.07,0:15:08.07,Default,,0,0,0,,♪ Қызық, сен бұлай кейіп танытасың қаншалықты ♪ [жек! ]
Dialogue: 0,0:15:08.07,0:15:10.07,Default,,0,0,0,,♪ «Ұнатпау» қорғаушы қолданбасы қолданбасы қолданбасы қолданбасы
Dialogue: 0,0:15:10.07,0:15:12.07,Default,,0,0,0,,♪ ｓｈａｋｅ， ｓｈａｋｅ， ｓｈａｋｅ ｉｔ ｕｐ， ｉｔ ｕｐ
Dialogue: 0,0:15:12.07,0:15:15.08,Default,,0,0,0,,♪ [О, жоқ] ♪ Сіз мұны қашанға дейін жасайсыз?
Dialogue: 0,0:15:15.08,0:15:17.08,Default,,0,0,0,,♪ Appu Appu Appu Appu қорғау құралын жабыңыз
Dialogue: 0,0:15:17.08,0:15:19.08,Default,,0,0,0,,♪ ｓｈａｋｅ， ｓｈａｋｅ， ｓｈａｋｅ ｉｔ ｕｐ
Dialogue: 0,0:15:19.08,0:15:22.08,Default,,0,0,0,,♪ Алдамай жай ғана қарсы алсаң ♪ [жек! ]
Dialogue: 0,0:15:22.08,0:15:24.09,Default,,0,0,0,,♪ Маған ұнамайды, ұнамайды.
Dialogue: 0,0:15:24.09,0:15:26.09,Default,,0,0,0,,♪ ｓｈａｋｅ， ｓｈａｋｅ， ｓｈａｋｅ ｉｔ ｕｐ， ｉｔ ｕｐ
Dialogue: 0,0:15:26.09,0:15:29.09,Default,,0,0,0,,♪ [О, жоқ] ♪ Бұл нақты нәрсе
Dialogue: 0,0:15:29.09,0:15:32.09,Default,,0,0,0,,♪ Жеңімпаз Жеңімпаз Жеңімпаз Жеңімпаз ♪ [қош бол және қош]
Dialogue: 0,0:15:32.09,0:15:36.10,Default,,0,0,0,,♪ ｉ’ｍ ａ ｐｒｅｔｅｎｄｅｒ ｈａｔｅｒ， ｈａｔｅｒ， ｈａｔｅ ｔｈｅ ｆａｋｅ
Dialogue: 0,0:15:36.10,0:15:44.11,Default,,0,0,0,,♪ Айнада сізді көрсету
Dialogue: 0,0:15:44.11,0:15:48.11,Default,,0,0,0,,♪～
Dialogue: 0,0:15:48.11,0:15:55.08,Default,,0,0,0,,♪ Ａｈ－ Ａｈ－ Ａｈ－
Dialogue: 0,0:15:57.12,0:15:59.12,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:15:59.12,0:16:03.06,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:03.06,0:16:05.06,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:16:05.06,0:16:08.06,Default,,0,0,0,,Бұл жұмақ па?
Dialogue: 0,0:16:08.06,0:16:10.06,Default,,0,0,0,,Сіз жаңасыз ба?
Dialogue: 0,0:16:10.06,0:16:12.07,Default,,0,0,0,,Мен Қайғы Рыцарьмын, Долорис.
Dialogue: 0,0:16:12.07,0:16:16.07,Default,,0,0,0,,Мен Oblibionis құдайына қызмет етуге келдім.
Dialogue: 0,0:16:16.07,0:16:20.07,Default,,0,0,0,,Хмм, бізден басқа да мұндай нәрсені ұнататын адамдар болды.
Dialogue: 0,0:16:20.07,0:16:25.08,Default,,0,0,0,,Біз де, Долорис, мен Тимор, Қорқыныш серімін.
Dialogue: 0,0:16:25.08,0:16:29.08,Default,,0,0,0,,Махаббат рыцары Аморис және сонда...
Dialogue: 0,0:16:29.08,0:16:31.09,Default,,0,0,0,,Сіз не істеп жатырсыз? (Муцуми) Мен тыңдап тұрмын.
Dialogue: 0,0:16:31.09,0:16:34.09,Default,,0,0,0,,Сонымен не?
Dialogue: 0,0:16:34.09,0:16:36.09,Default,,0,0,0,,Дүниенің жарылған дыбысы
Dialogue: 0,0:16:36.09,0:16:40.09,Default,,0,0,0,,Өлім Рыцарь Мортис біртүрлі жігіт
Dialogue: 0,0:16:40.09,0:16:43.10,Default,,0,0,0,,Уайымдама, мұнда болуда қорқынышты ештеңе жоқ.
Dialogue: 0,0:16:43.10,0:16:45.10,Default,,0,0,0,,Мен уәде беремін
Dialogue: 0,0:16:45.10,0:16:48.10,Default,,0,0,0,,Ахахха! үшін дұрыс!
Dialogue: 0,0:16:48.10,0:16:50.10,Default,,0,0,0,,Кім қолайлы?
Dialogue: 0,0:16:50.10,0:16:54.11,Default,,0,0,0,,Әннің миниатюралық бағы шығар.
Dialogue: 0,0:16:54.11,0:17:01.08,Default,,0,0,0,,Дүние ыдырағанша, мен билеп, өмір сүремін...
Dialogue: 0,0:17:03.05,0:17:07.05,Default,,0,0,0,,Алдамдыққа толы жұмақ
Dialogue: 0,0:17:07.05,0:17:10.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:10.06,0:17:14.06,Default,,0,0,0,,Oblibionis жоқ. Өкінішке орай, не?
Dialogue: 0,0:17:14.06,0:17:16.06,Default,,0,0,0,,Ол әлдеқашан жоғалып кеткен
Dialogue: 0,0:17:16.06,0:17:18.07,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:18.07,0:17:21.07,Default,,0,0,0,,Біз де тілек тілейміз
Dialogue: 0,0:17:21.07,0:17:28.08,Default,,0,0,0,,Бір күні ол жұмаққа оралып, бізге ұмыту сыйлайды...
Dialogue: 0,0:17:28.08,0:17:32.08,Default,,0,0,0,,Менің өмірім көп өлімге тіреледі
Dialogue: 0,0:17:32.08,0:17:37.08,Default,,0,0,0,,Үміт жоқ болса да, өмір сүргім келеді...
Dialogue: 0,0:17:37.08,0:17:41.09,Default,,0,0,0,,Кеше де бір, бүгін де бір
Dialogue: 0,0:17:41.09,0:17:46.09,Default,,0,0,0,,Мен бәрін ұмытқым келеді
Dialogue: 0,0:17:46.09,0:17:51.10,Default,,0,0,0,,Дүниенің жарылған дыбысы? Мен оны ести алмаймын
Dialogue: 0,0:17:51.10,0:17:53.10,Default,,0,0,0,,Неге... неге ол...
Dialogue: 0,0:17:53.10,0:17:59.11,Default,,0,0,0,,Мені қызғаныш пен жек көретін махаббатты ұмытайын!
Dialogue: 0,0:17:59.11,0:18:03.04,Default,,0,0,0,,Маған ешкім сенбейді! Сіз маған сенбейсіз!
Dialogue: 0,0:18:03.04,0:18:07.05,Default,,0,0,0,,Мен бұл сұмдықты ұмытқым келеді...
Dialogue: 0,0:18:07.05,0:18:10.05,Default,,0,0,0,,Менің қолымнан келетіні – үміт
Dialogue: 0,0:18:10.05,0:18:14.06,Default,,0,0,0,,Жоқ! Мен енді шыдай алмаймын!
Dialogue: 0,0:18:14.06,0:18:18.06,Default,,0,0,0,,Менің күнәһар мен... менің бар болуым - күнә!
Dialogue: 0,0:18:18.06,0:18:21.06,Default,,0,0,0,,Мен бәрін ұмытып, құтқарылғым келеді!
Dialogue: 0,0:18:21.06,0:18:24.07,Default,,0,0,0,,Махаббат жаман ба? Жақсы емес
Dialogue: 0,0:18:24.07,0:18:26.07,Default,,0,0,0,,Қорқыныш? Жоқ...
Dialogue: 0,0:18:26.07,0:18:28.07,Default,,0,0,0,,Өлім беру
Dialogue: 0,0:18:28.07,0:18:34.08,Default,,0,0,0,,Қажет емес! Махаббат емес, қорқыныш емес, өлім емес, қайғы емес!
Dialogue: 0,0:18:34.08,0:18:39.08,Default,,0,0,0,,Мені бұл азаптан тек ұмыту ғана құтқара алады!
Dialogue: 0,0:18:39.08,0:18:42.08,Default,,0,0,0,,Хахахахаха... (Хатсуканың есінде қалған дауыс) «Шынымен бе?»
Dialogue: 0,0:18:42.08,0:18:44.09,Default,,0,0,0,,Ха... бұл дауыс...
Dialogue: 0,0:18:44.09,0:18:47.09,Default,,0,0,0,,«Мұнда келгеніңнің жалғыз себебі ұмыту ма?»
Dialogue: 0,0:18:47.09,0:18:51.09,Default,,0,0,0,,Бұл дауысты мен қайта-қайта естимін!
Dialogue: 0,0:18:51.09,0:18:57.10,Default,,0,0,0,,«Долорис, сенің шын тілегің қандай...»
Dialogue: 0,0:18:57.10,0:19:00.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:00.10,0:19:02.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:02.04,0:19:05.01,Default,,0,0,0,,Жоқ... (Қаири) Облибионис пе?
Dialogue: 0,0:19:08.04,0:19:14.05,Default,,0,0,0,,Ұмыту құдайы! Өтінемін, мені рыцарь етіңіз
Dialogue: 0,0:19:14.05,0:19:16.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:20.05,0:19:22.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:26.06,0:19:30.06,Default,,0,0,0,,Күте тұрыңыз! Мен де сенің рыцарь боламын... Ұмыту туралы Інжіл...
Dialogue: 0,0:19:30.06,0:19:33.07,Default,,0,0,0,,Оны неше рет қайталауым керек? Эх...
Dialogue: 0,0:19:33.07,0:19:38.07,Default,,0,0,0,,Мен сені қанша ұмытсам да, жұмаққа қайтасың.
Dialogue: 0,0:19:38.07,0:19:42.08,Default,,0,0,0,,Не айтасыз... Бүгін мен мұнда бірінші рет...
Dialogue: 0,0:19:42.08,0:19:45.08,Default,,0,0,0,,«Шынымен бе?» Ах...
Dialogue: 0,0:19:45.08,0:19:52.09,Default,,0,0,0,,«Есіңде ме, Долорис, сен бұл жерге неше рет бардың?»
Dialogue: 0,0:19:52.09,0:19:56.09,Default,,0,0,0,,«Сіз Oblibionis деген есімді қайдан білесіз?»
Dialogue: 0,0:19:56.09,0:20:00.09,Default,,0,0,0,,«Неге ұмытылуға ұмтыласыз?»
Dialogue: 0,0:20:00.09,0:20:02.10,Default,,0,0,0,,Мен сені көргім келеді...
Dialogue: 0,0:20:02.10,0:20:05.07,Default,,0,0,0,,Сен менің рыцарым емессің
Dialogue: 0,0:20:07.10,0:20:09.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:11.11,0:20:13.11,Default,,0,0,0,,Сені ұмытамын!
Dialogue: 0,0:20:13.11,0:20:17.11,Default,,0,0,0,,Егер мен сенің жаныңда болсам, бәрін ұмытар едім.
Dialogue: 0,0:20:17.11,0:20:22.08,Default,,0,0,0,,Мен сені ұмытамын, тіпті ұмытамын бұл мұңды...
Dialogue: 0,0:20:25.12,0:20:28.09,Default,,0,0,0,,Сосын қолында қылышпен
Dialogue: 0,0:20:36.13,0:20:43.14,Default,,0,0,0,,♬～
Dialogue: 0,0:20:43.14,0:20:45.14,Default,,0,0,0,,үшін ұмытуға тырысады➡
Dialogue: 0,0:20:45.14,0:20:49.14,Default,,0,0,0,,Ұмытудың құдайы мен ғана ұмытпаймын...
Dialogue: 0,0:20:49.14,0:20:54.12,Default,,0,0,0,,Дүние біткенше
Dialogue: 0,0:20:57.15,0:21:02.12,Default,,0,0,0,,Мен осы ымырт жұмағында патшалық етуді жалғастырамын
Dialogue: 0,0:21:04.09,0:21:09.10,Default,,0,0,0,,♪ 『Аспан сферасының музыкасы』
Dialogue: 0,0:21:09.10,0:21:22.11,Default,,0,0,0,,♪～
Dialogue: 0,0:21:22.11,0:21:26.11,Default,,0,0,0,,♪ Ертеңге барайық
Dialogue: 0,0:21:26.11,0:21:32.12,Default,,0,0,0,,♪ Керемет кездер
Dialogue: 0,0:21:32.12,0:21:37.12,Default,,0,0,0,,♪ Адамдар ұмытады
Dialogue: 0,0:21:37.12,0:21:43.13,Default,,0,0,0,,♪ Жүрегім соқты, оны қабылдау үшін.
Dialogue: 0,0:21:43.13,0:21:46.13,Default,,0,0,0,,♪ Басқа жағы бар ма?
Dialogue: 0,0:21:46.13,0:21:50.14,Default,,0,0,0,,♪ Бұл өтірік те, шындық та болуы мүмкін.
Dialogue: 0,0:21:50.14,0:21:57.14,Default,,0,0,0,,♪ Бұрмалау «ұқсастық» болуы мүмкін
Dialogue: 0,0:21:57.14,0:22:08.09,Default,,0,0,0,,♪ Әй, дәл алдымнан асыққан соңғы азап
Dialogue: 0,0:22:08.09,0:22:10.09,Default,,0,0,0,,♪ Егер сіз кесіп өтсеңіз
Dialogue: 0,0:22:10.09,0:22:15.10,Default,,0,0,0,,♪ Біз қазір ағып жатырмыз
Dialogue: 0,0:22:15.10,0:22:20.10,Default,,0,0,0,,♪ ｌｅｔ’ｓ ｓｉｎｇ ａｌｏｎｇ ｌｅｔ’ｓ ｓｉｎｇ ａｌｏｎｇ
Dialogue: 0,0:22:20.10,0:22:27.11,Default,,0,0,0,,♪ Жарқыраған таңмен бірге
Dialogue: 0,0:22:27.11,0:22:30.11,Default,,0,0,0,,♪ Келіңіздер
Dialogue: 0,0:22:30.11,0:22:35.12,Default,,0,0,0,,♪ Ертеңге барайық
Dialogue: 0,0:22:35.12,0:22:40.12,Default,,0,0,0,,♪ Керемет кездер
Dialogue: 0,0:22:40.12,0:22:45.13,Default,,0,0,0,,♪ Адамдар ұмытады
Dialogue: 0,0:22:45.13,0:22:50.13,Default,,0,0,0,,♪ Ол бір күні жоғалады
Dialogue: 0,0:22:50.13,0:23:05.08,Default,,0,0,0,,♪～
Dialogue: 0,0:23:05.08,0:23:10.08,Default,,0,0,0,,♪ Неліктен мен өз сезімімді жаза бастадым?
Dialogue: 0,0:23:10.08,0:23:15.09,Default,,0,0,0,,♪ Жарық пен қараңғылықты басқаратын өмір
Dialogue: 0,0:23:15.09,0:23:19.09,Default,,0,0,0,,♪ Әр нәрсенің тарихы бар екеніне сенімдімін
Dialogue: 0,0:23:19.09,0:23:25.10,Default,,0,0,0,,♪ оқиғаны айтып бер, егер ол шындыққа айналса, айтып бер
Dialogue: 0,0:23:25.10,0:23:30.10,Default,,0,0,0,,♪ Аа, мен неге біреуді қатты сезінемін?
Dialogue: 0,0:23:30.10,0:23:35.11,Default,,0,0,0,,♪ Жарық пен қараңғылықты құшақтап, жүрегім оттайды
Dialogue: 0,0:23:35.11,0:23:39.11,Default,,0,0,0,,♪ Иә, әр нәрсенің тарихы бар.
Dialogue: 0,0:23:39.11,0:23:46.12,Default,,0,0,0,,♪ ｔｅｌｌ ｍｅ ｍｏｒｅ ｔｅｌｌ ｍｅ ｍｏｒｅ ｄｏｎ’ｔ ｓｔｏｐ
Dialogue: 0,0:23:46.12,0:24:00.13,Default,,0,0,0,,♪～
Dialogue: 0,0:24:00.13,0:24:03.07,Default,,0,0,0,,♪ Біз кездескен шудың ішінде
Dialogue: 0,0:24:03.07,0:24:07.07,Default,,0,0,0,,♪ жанның асқынуы
Dialogue: 0,0:24:07.07,0:24:10.08,Default,,0,0,0,,♪ Қайта-қайта жарқырай бер
Dialogue: 0,0:24:10.08,0:24:13.08,Default,,0,0,0,,♪ Мен құлап жатырмын, мен жеңілемін
Dialogue: 0,0:24:13.08,0:24:21.09,Default,,0,0,0,,♪ Әй, мен іздеген кездің алыстан түсі
Dialogue: 0,0:24:21.09,0:24:32.10,Default,,0,0,0,,♪ Егер бұл өлең аспан сферасындағы арманның жалғасын суреттесе
Dialogue: 0,0:24:32.10,0:24:34.10,Default,,0,0,0,,♪ Маған қара
Dialogue: 0,0:24:34.10,0:24:39.11,Default,,0,0,0,,♪ Бокурайма шығарылымы
Dialogue: 0,0:24:39.11,0:24:44.11,Default,,0,0,0,,♪ ｌｅｔ’ｓ ｓｉｎｇ ａｌｏｎｇ ｌｅｔ’ｓ ｓｉｎｇ ａｌｏｎｇ
Dialogue: 0,0:24:44.11,0:24:52.12,Default,,0,0,0,,♪ Жарылғалы тұрған жүрегімді ойнайық
Dialogue: 0,0:24:52.12,0:24:54.12,Default,,0,0,0,,♪ Келіңіздер
Dialogue: 0,0:24:54.12,0:24:59.13,Default,,0,0,0,,♪ (үшін) Ертеңге барайық
Dialogue: 0,0:24:59.13,0:25:04.06,Default,,0,0,0,,♪ Керемет кездер
Dialogue: 0,0:25:04.06,0:25:09.07,Default,,0,0,0,,♪ Адамдар ұмытады
Dialogue: 0,0:25:09.07,0:25:14.07,Default,,0,0,0,,♪ Ол бір күні жоғалады
Dialogue: 0,0:25:14.07,0:25:18.08,Default,,0,0,0,,♪ Аве Мухикаға (әлем)
Dialogue: 0,0:25:18.08,0:25:24.08,Default,,0,0,0,,♪ Керемет кездер
Dialogue: 0,0:25:24.08,0:25:28.09,Default,,0,0,0,,♪ Адамдар ұмытады
Dialogue: 0,0:25:28.09,0:25:36.06,Default,,0,0,0,,♪ Ол бір күні жоғалады
Dialogue: 0,0:25:38.40,0:25:43.10,Default,,0,0,0,,♬～
Dialogue: 0,0:25:43.10,0:25:49.08,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:25:55.12,0:26:00.09,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:26:02.06,0:26:05.03,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:26:07.06,0:26:09.03,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:26:11.07,0:26:15.04,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:26:20.07,0:26:24.08,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:26:24.08,0:26:29.08,Default,,0,0,0,,♬～
Dialogue: 0,0:26:29.08,0:26:36.09,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:26:36.09,0:26:38.09,Default,,0,0,0,,Тоқта... (Айне) Ортада~!
Dialogue: 0,0:26:38.09,0:26:40.09,Default,,0,0,0,,Иә? Ааа! (Ракуна) Хехе
Dialogue: 0,0:26:40.09,0:26:43.06,Default,,0,0,0,,Тацуки-чан (Айне) Сәлем айтамын~
Dialogue: 0,0:26:45.10,0:26:47.07,Default,,0,0,0,,Я...
Dialogue: 0,0:26:52.11,0:26:54.11,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:26:54.11,0:26:56.11,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:26:56.11,0:26:59.18,Default,,0,0,0,,Профессор Такаянаги
