Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.45,0:00:04.17,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:00:04.46,0:00:05.83,Default,,0,0,0,,Я...
Dialogue: 0,0:00:06.75,0:00:08.34,Default,,0,0,0,,Ағай (Сеичи) Хмм
Dialogue: 0,0:00:09.96,0:00:11.26,Default,,0,0,0,,Не?
Dialogue: 0,0:00:11.38,0:00:13.51,Default,,0,0,0,,Ағай, мен жақында өлемін.
Dialogue: 0,0:00:13.63,0:00:14.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:23.35,0:00:24.73,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:00:26.77,0:00:32.15,Default,,0,0,0,,♪～
Dialogue: 0,0:01:48.69,0:01:53.69,Default,,0,0,0,,～♪
Dialogue: 0,0:02:01.95,0:02:05.41,Default,,0,0,0,,«Алғы сөз алынып тасталды: Бұл менің бірінші хатым».
Dialogue: 0,0:02:06.00,0:02:09.79,Default,,0,0,0,,«Мен сіздің кітаптарыңызды оқығанды ​​ұнататын адаммын».
Dialogue: 0,0:02:10.08,0:02:12.59,Default,,0,0,0,,«Шындығында, мен сенің білгеніңді қалаймын.»
Dialogue: 0,0:02:12.71,0:02:13.71,Default,,0,0,0,,«Мен қаламымды алдым»
Dialogue: 0,0:02:15.46,0:02:16.97,Default,,0,0,0,,«Мен жақында өлемін»
Dialogue: 0,0:02:18.01,0:02:19.68,Default,,0,0,0,,«Өлтіру»
Dialogue: 0,0:02:22.01,0:02:26.02,Default,,0,0,0,,«Мен біртүрлі талантпен туғанмын».
Dialogue: 0,0:02:26.64,0:02:29.23,Default,,0,0,0,,«Бұл әлеммен үйлеспейді».
Dialogue: 0,0:02:29.35,0:02:33.11,Default,,0,0,0,,«Білсе, бейбіт өмір сүре алмайтын шығар...»
Dialogue: 0,0:02:33.31,0:02:35.44,Default,,0,0,0,,«Осындай нәрсе болды».
Dialogue: 0,0:02:36.57,0:02:40.03,Default,,0,0,0,,«Бірақ мен сіздің кітабыңызды таптым».
Dialogue: 0,0:02:40.95,0:02:44.24,Default,,0,0,0,,«Сенің жалғыздығың да сенің құндылығың».
Dialogue: 0,0:02:44.74,0:02:46.62,Default,,0,0,0,,«Сен неғұрлым жалғыз болсаң...»
Dialogue: 0,0:02:47.33,0:02:50.42,Default,,0,0,0,,«Сізде көптеген адамдармен қарым-қатынас жасау қабілетіңіз бар».
Dialogue: 0,0:02:50.54,0:02:51.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:52.13,0:02:54.38,Default,,0,0,0,,«Менде сол уақытқа дейін жасырып келген талантым бар еді...»
Dialogue: 0,0:02:55.38,0:02:58.42,Default,,0,0,0,,«Мен оны әлемге біртіндеп ашамын деп ойладым».
Dialogue: 0,0:02:59.67,0:03:03.51,Default,,0,0,0,,«Бірақ әлем мені бөтен адам ретінде қабылдамайтын сияқты».
Dialogue: 0,0:03:04.47,0:03:06.01,Default,,0,0,0,,(Лақтыру дыбысы)
Dialogue: 0,0:03:06.47,0:03:09.39,Default,,0,0,0,,«Соңғы уақытта мен айналамда біртүрлі адамдарды көріп жүрмін».
Dialogue: 0,0:03:09.98,0:03:12.60,Default,,0,0,0,,«Ол бақылаушының өлтірушісі болуы керек».
Dialogue: 0,0:03:13.98,0:03:15.69,Default,,0,0,0,,«Мен күткендей-»
Dialogue: 0,0:03:16.15,0:03:20.24,Default,,0,0,0,,«Мен қазіргі қоғамның жауына айналдым».
Dialogue: 0,0:03:20.65,0:03:23.78,Default,,0,0,0,,«Сондықтан мен соңында рахмет айтқым келді».
Dialogue: 0,0:03:23.99,0:03:26.12,Default,,0,0,0,,Қоғам жаулары...
Dialogue: 0,0:03:26.53,0:03:30.54,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:03:31.87,0:03:34.25,Default,,0,0,0,,Жол бүгін боссың ба?
Dialogue: 0,0:03:34.46,0:03:37.92,Default,,0,0,0,,Ал, не? Тағы бір тергеу?
Dialogue: 0,0:03:38.05,0:03:42.80,Default,,0,0,0,,А, бұл сәл ерекше...
Dialogue: 0,0:03:46.80,0:03:51.52,Default,,0,0,0,,Сейичи Қорытындылай келе, бұл жігіт шынымен өлді.
Dialogue: 0,0:03:52.02,0:03:52.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:52.98,0:03:54.98,Default,,0,0,0,,Бір ай бұрын қайтыс болды
Dialogue: 0,0:03:55.10,0:03:57.77,Default,,0,0,0,,Осы хатқа пошта маркасы қойылған күннен кейінгі күні.
Dialogue: 0,0:03:57.90,0:04:00.28,Default,,0,0,0,,Келесі күні? (Жіптер) О, және-
Dialogue: 0,0:04:00.40,0:04:03.66,Default,,0,0,0,,Хат жіберілгенге дейін үш күн хабарсыз кеткен.
Dialogue: 0,0:04:04.07,0:04:06.03,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:04:06.16,0:04:08.41,Default,,0,0,0,,Ол бірдеңе істеп жатыр ма?
Dialogue: 0,0:04:08.79,0:04:10.66,Default,,0,0,0,,Міне...
Dialogue: 0,0:04:10.79,0:04:12.16,Default,,0,0,0,,Не болды? (жіптер) Жоқ
Dialogue: 0,0:04:13.00,0:04:16.00,Default,,0,0,0,,Мүмкін бұл ерекше емес шығар...
Dialogue: 0,0:04:16.13,0:04:17.46,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:18.67,0:04:21.46,Default,,0,0,0,,Айналадағы достарымның бағаларын көтердім.
Dialogue: 0,0:04:21.59,0:04:22.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:22.76,0:04:26.76,Default,,0,0,0,,Мен саған оқуды немесе басқасын үйреткен сияқты емес.
Dialogue: 0,0:04:27.68,0:04:30.47,Default,,0,0,0,,Сіз кеңес алдыңыз ба?
Dialogue: 0,0:04:30.60,0:04:34.35,Default,,0,0,0,,Ол басынан сипап қалды, болды деді.
Dialogue: 0,0:04:34.48,0:04:35.90,Default,,0,0,0,,Тек мектеп емес
Dialogue: 0,0:04:36.02,0:04:40.11,Default,,0,0,0,,Топ мүшелеріне өздерінің ерекше әндерін жасауға мүмкіндік бердім.
Dialogue: 0,0:04:40.23,0:04:43.11,Default,,0,0,0,,Мұндай әңгімелер өте көп.
Dialogue: 0,0:04:43.90,0:04:45.74,Default,,0,0,0,,Яғни...
Dialogue: 0,0:04:45.86,0:04:49.53,Default,,0,0,0,,Мысалы, мен болсам, негізгі жұмысым ретінде роман жазуға шебер болар едім.
Dialogue: 0,0:04:49.78,0:04:51.20,Default,,0,0,0,,Осымен
Dialogue: 0,0:04:51.33,0:04:55.54,Default,,0,0,0,,Қысқасы, өзіңіздің баяу өсуіңіз туралы не айта аласыз?
Dialogue: 0,0:04:55.67,0:04:59.84,Default,,0,0,0,,«жарып өтуге» мүмкіндік беретін талант? Ондай жағдай болды дейді.
Dialogue: 0,0:04:59.96,0:05:02.01,Default,,0,0,0,,Рохан мырза, кеш жарысыңыз~
Dialogue: 0,0:05:02.13,0:05:05.22,Default,,0,0,0,,Ол ғажайыптар жасай алатын сияқты.
Dialogue: 0,0:05:05.34,0:05:07.34,Default,,0,0,0,,Мен «ұнату» дегенді білдіремін…
Dialogue: 0,0:05:07.47,0:05:10.81,Default,,0,0,0,,Бұл шындық сияқты.
Dialogue: 0,0:05:10.93,0:05:12.18,Default,,0,0,0,,Өлімнің себебі не болды?
Dialogue: 0,0:05:12.68,0:05:16.23,Default,,0,0,0,,Шамасы, баспалдақтан тайып түсіп, басын соқты.
Dialogue: 0,0:05:16.35,0:05:17.56,Default,,0,0,0,,Куәгерлер жоқ.
Dialogue: 0,0:05:17.98,0:05:21.94,Default,,0,0,0,,Жоғалып кеткен соң баспалдақтан құлап өлдім...
Dialogue: 0,0:05:22.07,0:05:23.07,Default,,0,0,0,,Бұл дегеніміз?
Dialogue: 0,0:05:23.48,0:05:25.74,Default,,0,0,0,,Бұл дүрбелең тудыруы мүмкін, солай ма?
Dialogue: 0,0:05:25.86,0:05:28.07,Default,,0,0,0,,Бірақ ешқандай мәселе қалмайды.
Dialogue: 0,0:05:28.61,0:05:31.91,Default,,0,0,0,,Отбасы көп ұзамай көшіп кетті, олардың қайда екені белгісіз.
Dialogue: 0,0:05:32.04,0:05:35.00,Default,,0,0,0,,А... Із жоқ па?
Dialogue: 0,0:05:35.12,0:05:37.67,Default,,0,0,0,,Аа, бұл мәселе.
Dialogue: 0,0:05:37.79,0:05:41.09,Default,,0,0,0,,Эй, Сейчи, бұл қауіпті.
Dialogue: 0,0:05:41.21,0:05:44.96,Default,,0,0,0,,Егер сіз басыңызды дұрыс емес бағытта сілкіп алсаңыз, одан құтыла алмауыңыз мүмкін.
Dialogue: 0,0:05:48.26,0:05:52.10,Default,,0,0,0,,Ғажайыптар жасайтын бала қоғамның жауы ма?
Dialogue: 0,0:05:52.68,0:05:55.10,Default,,0,0,0,,``Өзіңіздің жасырын талантыңызды әлеммен бөлісіңіз...''
Dialogue: 0,0:05:56.02,0:05:56.85,Default,,0,0,0,,Ах
Dialogue: 0,0:05:57.35,0:06:01.98,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:06:03.36,0:06:05.94,Default,,0,0,0,,(тінтуірдің жұмыс дыбысы)
Dialogue: 0,0:06:07.82,0:06:10.82,Default,,0,0,0,,Бұл не болып жатыр...
Dialogue: 0,0:06:11.03,0:06:13.74,Default,,0,0,0,,Қария, не болды?
Dialogue: 0,0:06:14.16,0:06:17.37,Default,,0,0,0,,Жоқ... жоқ, ештеңе.
Dialogue: 0,0:06:18.75,0:06:19.83,Default,,0,0,0,,Не?
Dialogue: 0,0:06:19.96,0:06:22.84,Default,,0,0,0,,Сондықтан анам мені көргісі келеді.
Dialogue: 0,0:06:22.96,0:06:25.17,Default,,0,0,0,,Неліктен? (Наги) Жүр.
Dialogue: 0,0:06:25.30,0:06:28.26,Default,,0,0,0,,Қайта үйленемін деп шешілгендіктен, оған дейін бір рет жасаймын.
Dialogue: 0,0:06:28.67,0:06:30.59,Default,,0,0,0,,Бірақ... Бірақ...
Dialogue: 0,0:06:30.72,0:06:33.39,Default,,0,0,0,,Мені көргің келмей ме? Егер солай болса, мен сізге айтамын.
Dialogue: 0,0:06:33.51,0:06:34.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:35.06,0:06:38.81,Default,,0,0,0,,Жоқ... түсіндім. Түсінгеніңді айт.
Dialogue: 0,0:06:39.52,0:06:40.69,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:41.23,0:06:42.86,Default,,0,0,0,,Ерекше ештеңе жоқ
Dialogue: 0,0:06:42.98,0:06:45.57,Default,,0,0,0,,Не, маған қызық.
Dialogue: 0,0:06:45.69,0:06:49.53,Default,,0,0,0,,Анаңның жаңа күйеуі бай екен ғой?
Dialogue: 0,0:06:49.65,0:06:50.99,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:06:51.11,0:06:55.16,Default,,0,0,0,,Сондықтан бір-екі баламыз көп болса, бұл маңызды емес.
Dialogue: 0,0:06:55.58,0:06:56.62,Default,,0,0,0,,Ах
Dialogue: 0,0:06:57.45,0:06:59.41,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:06:59.75,0:07:00.96,Default,,0,0,0,,(Нагидің дауысы)
Dialogue: 0,0:07:01.08,0:07:04.92,Default,,0,0,0,,Ахаха, олай жылайтын сияқты болма.
Dialogue: 0,0:07:05.34,0:07:07.26,Default,,0,0,0,,Мен сенімен қаламын
Dialogue: 0,0:07:07.67,0:07:09.92,Default,,0,0,0,,Сіз мені қалжыңдап тұрсыз ба?
Dialogue: 0,0:07:10.13,0:07:12.93,Default,,0,0,0,,Болды, барлығын шық.
Dialogue: 0,0:07:15.26,0:07:18.60,Default,,0,0,0,,Сіз маған қарағанда мықты екенсіз.
Dialogue: 0,0:07:19.43,0:07:22.60,Default,,0,0,0,,Бастауыш сыныпта оқып жүрген кезімнен бері бұл мүмкін емес.
Dialogue: 0,0:07:22.73,0:07:24.36,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:07:24.48,0:07:26.57,Default,,0,0,0,,Бізден кейінгі дәуірде туғандар...
Dialogue: 0,0:07:26.69,0:07:29.44,Default,,0,0,0,,Сенің аға буыннан да ақылды болатыныңа сенімдімін.
Dialogue: 0,0:07:29.57,0:07:33.66,Default,,0,0,0,,Солай ма? (Наги) Эволюция - бұл нәрсе. Эволюция!
Dialogue: 0,0:07:33.78,0:07:36.74,Default,,0,0,0,,Эволюция? Жақсы айтты.
Dialogue: 0,0:07:36.87,0:07:41.83,Default,,0,0,0,,Әй, «бала – адамзаттың әкесі» деген сөз...
Dialogue: 0,0:07:41.96,0:07:43.08,Default,,0,0,0,,Ha
Dialogue: 0,0:07:48.55,0:07:52.63,Default,,0,0,0,,Эволюция… «Қоғамның жауы» деген осы ма?
Dialogue: 0,0:07:53.76,0:07:54.80,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:07:54.93,0:07:59.39,Default,,0,0,0,,«жарып өтуге» мүмкіндік беретін талант? Ондай жағдай болды дейді.
Dialogue: 0,0:08:00.52,0:08:02.23,Default,,0,0,0,,«Болашақтың» пайда болуына
Dialogue: 0,0:08:02.35,0:08:04.48,Default,,0,0,0,,Қазіргі уақытта қоғам қарсы күресуде
Dialogue: 0,0:08:05.19,0:08:07.11,Default,,0,0,0,,Бұл өмір сүру үшін күрес
Dialogue: 0,0:08:08.27,0:08:12.82,Default,,0,0,0,,«Сақшылар» маған жеткенше аз ғана уақыт қалды.
Dialogue: 0,0:08:15.24,0:08:17.28,Default,,0,0,0,,Ағай, мен жақында өлемін.
Dialogue: 0,0:08:18.87,0:08:20.12,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:08:20.66,0:08:23.04,Default,,0,0,0,,Сіз білуге ​​жарайсыз ба?
Dialogue: 0,0:08:23.16,0:08:25.88,Default,,0,0,0,,Сіз ештеңе істей алмайтын нәрселер бар.
Dialogue: 0,0:08:26.33,0:08:28.50,Default,,0,0,0,,Сіз мұнда не қарап тұрдыңыз?
Dialogue: 0,0:08:28.92,0:08:31.21,Default,,0,0,0,,Бұл құс (Туко) Құс?
Dialogue: 0,0:08:31.59,0:08:35.26,Default,,0,0,0,,Құстардың не үшін ұшатынын білесің бе?
Dialogue: 0,0:08:35.97,0:08:38.18,Default,,0,0,0,,Өйткені оның қанаттары бар, солай ма?
Dialogue: 0,0:08:38.55,0:08:41.52,Default,,0,0,0,,Себебі ұшатын басқа заттар көп емес.
Dialogue: 0,0:08:42.06,0:08:45.27,Default,,0,0,0,,Аспанда құстар сияқты ешбір тіршілік иесі емін-еркін ұша алмайды.
Dialogue: 0,0:08:45.39,0:08:46.94,Default,,0,0,0,,Сондықтан мен ұшамын
Dialogue: 0,0:08:47.23,0:08:49.02,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:08:49.15,0:08:52.49,Default,,0,0,0,,Егер бәсекелесетін басқа ештеңе болмаса, өмір сүре аласыз.
Dialogue: 0,0:08:52.61,0:08:56.66,Default,,0,0,0,,Құстар көне заманнан осылайша өмір сүрген.
Dialogue: 0,0:08:57.53,0:09:01.74,Default,,0,0,0,,Бірақ ұшатын құстар да аспаннан құлауы мүмкін.
Dialogue: 0,0:09:01.87,0:09:04.75,Default,,0,0,0,,Сәуірде кейде қар жауады
Dialogue: 0,0:09:04.87,0:09:05.71,Default,,0,0,0,,Ах
Dialogue: 0,0:09:06.00,0:09:10.13,Default,,0,0,0,,Барлық тәуекелдер мен тосын жағдайлар бірдей.
Dialogue: 0,0:09:10.42,0:09:13.84,Default,,0,0,0,,Мәселе оның ішінде қалай өмір сүруге болады.
Dialogue: 0,0:09:14.38,0:09:15.80,Default,,0,0,0,,Адамдар да?
Dialogue: 0,0:09:17.18,0:09:20.60,Default,,0,0,0,,Адамдар және басқалар...
Dialogue: 0,0:09:21.51,0:09:25.18,Default,,0,0,0,,Тіпті бұрынғы адамдардан аздап ерекшеленетіндер үшін...
Dialogue: 0,0:09:25.31,0:09:27.73,Default,,0,0,0,,Өйткені, мұндай шайқас күтіп тұр.
Dialogue: 0,0:09:28.31,0:09:31.19,Default,,0,0,0,,Онымен қалай күресетініңіз сізге байланысты.
Dialogue: 0,0:09:31.61,0:09:33.82,Default,,0,0,0,,Ағаң ұлы тұлға ма?
Dialogue: 0,0:09:33.94,0:09:39.24,Default,,0,0,0,,Аа, сен кішіпейіл жазушысың, бірақ шын мәнінде сен үлкен іссің.
Dialogue: 0,0:09:40.03,0:09:42.54,Default,,0,0,0,,Қоғамның бірінші жауы
Dialogue: 0,0:09:42.66,0:09:43.49,Default,,0,0,0,,Жау?
Dialogue: 0,0:09:44.16,0:09:49.04,Default,,0,0,0,,Қазіргі әлемге тым жаңа және тек жау бола алатын адамдар бар ...
Dialogue: 0,0:09:49.17,0:09:53.17,Default,,0,0,0,,Неге екені белгісіз, менің жазған кітаптарым әркімге әсер етеді.
Dialogue: 0,0:09:53.55,0:09:56.55,Default,,0,0,0,,Ол, былайша айтқанда, олардың көшбасшысы сияқты.
Dialogue: 0,0:09:56.67,0:09:57.51,Default,,0,0,0,,Иә
Dialogue: 0,0:09:57.93,0:10:03.85,Default,,0,0,0,,Дегенмен, менің қолымнан келетіні - оларды кері итеру.
Dialogue: 0,0:10:04.85,0:10:08.14,Default,,0,0,0,,Мен сөздің құдіретіне онша сенбеймін.
Dialogue: 0,0:10:08.27,0:10:10.73,Default,,0,0,0,,Бұйрық беруге немесе тоқтатуға болмайды
Dialogue: 0,0:10:10.86,0:10:12.86,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:10:13.40,0:10:14.53,Default,,0,0,0,,Ах
Dialogue: 0,0:10:15.69,0:10:18.28,Default,,0,0,0,,Бірақ менің ағам өледі.
Dialogue: 0,0:10:18.40,0:10:21.03,Default,,0,0,0,,Иә... Менің ойымша.
Dialogue: 0,0:10:21.82,0:10:27.00,Default,,0,0,0,,Сайып келгенде, бәрі ойлағандай болмайды және сіз бұл жолда сәтсіздікке ұшырайсыз.
Dialogue: 0,0:10:27.29,0:10:29.21,Default,,0,0,0,,Сәтсіздік деп кім шешеді?
Dialogue: 0,0:10:29.33,0:10:30.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:30.50,0:10:33.29,Default,,0,0,0,,Сіз адамдардың өліп жатқанын көре аласыз, солай ма?
Dialogue: 0,0:10:33.63,0:10:34.59,Default,,0,0,0,,Иә
Dialogue: 0,0:10:34.71,0:10:38.72,Default,,0,0,0,,Сіздің біртүрлі талантыңыз қарғысқа ұшырады деп ойлайсыз ба?
Dialogue: 0,0:10:38.84,0:10:40.30,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:10:40.55,0:10:44.56,Default,,0,0,0,,А, мұны ешкім білмейді.
Dialogue: 0,0:10:44.89,0:10:47.56,Default,,0,0,0,,Егер сіз қазірден бастап бірдеңе жасасаңыз...
Dialogue: 0,0:10:47.89,0:10:50.19,Default,,0,0,0,,Ортаға бітсе де...
Dialogue: 0,0:10:50.31,0:10:53.44,Default,,0,0,0,,Оның сәтсіздікке ұшырау-болмауын ешкім шеше алмайды.
Dialogue: 0,0:10:54.27,0:10:57.23,Default,,0,0,0,,Бұл тек жаман нәрсе сияқты көрінсе де...
Dialogue: 0,0:10:57.36,0:11:01.07,Default,,0,0,0,,Сіздің бірдеңе жасауға ниетіңіз, салмақты сезімдеріңіз...
Dialogue: 0,0:11:01.36,0:11:05.45,Default,,0,0,0,,Мұндай нәрсе әрқашан басқа адамдарда қалады.
Dialogue: 0,0:11:06.33,0:11:10.87,Default,,0,0,0,,Жаныңдағы біреу мұны жақсырақ орындауы мүмкін.
Dialogue: 0,0:11:11.33,0:11:12.63,Default,,0,0,0,,Кім?
Dialogue: 0,0:11:12.92,0:11:15.21,Default,,0,0,0,,Мүмкін саған жау болған біреу...
Dialogue: 0,0:11:15.54,0:11:18.09,Default,,0,0,0,,Ол жай ғана өтіп бара жатқан адам болуы мүмкін.
Dialogue: 0,0:11:19.26,0:11:21.09,Default,,0,0,0,,Мұны ешкім білмейді
Dialogue: 0,0:11:21.93,0:11:24.72,Default,,0,0,0,,Және ол келесі...
Dialogue: 0,0:11:24.85,0:11:26.35,Default,,0,0,0,,Олардың арасында біреу-
Dialogue: 0,0:11:26.47,0:11:30.02,Default,,0,0,0,,Мүмкін бір күні біз әлемнің орталығына жететін шығармыз
Dialogue: 0,0:11:30.77,0:11:32.60,Default,,0,0,0,,Ағаң ше? (Сейчи) Иә?
Dialogue: 0,0:11:33.40,0:11:37.32,Default,,0,0,0,,Сіздің ізіңізді біреу жалғастырады деп сенесіз бе?
Dialogue: 0,0:11:38.03,0:11:38.98,Default,,0,0,0,,Сол жігіт пен оның адамдарының бәрі Стэнд қолданушылары сияқты
Dialogue: 0,0:11:39.53,0:11:41.24,Default,,0,0,0,,Негізі мен романдарды ұнатамын.
Dialogue: 0,0:11:41.36,0:11:44.37,Default,,0,0,0,,Оқығаныңды қалаймын.
Dialogue: 0,0:11:45.12,0:11:47.62,Default,,0,0,0,,Ағай, атыңыз кім?
Dialogue: 0,0:11:48.41,0:11:51.25,Default,,0,0,0,,Бұл Сейчи Кирима. Сен ше?
Dialogue: 0,0:11:52.58,0:11:54.42,Default,,0,0,0,,Тоуко Мизунобоши
Dialogue: 0,0:11:55.08,0:11:58.25,Default,,0,0,0,,(Сейчидің ыңырсыуы)
Dialogue: 0,0:11:58.88,0:12:01.76,Default,,0,0,0,,(Сейчидің ыңырануы)
Dialogue: 0,0:12:02.17,0:12:04.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:06.89,0:12:09.22,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:12:09.35,0:12:11.27,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:12:13.89,0:12:14.94,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:12:15.86,0:12:21.53,Default,,0,0,0,,Қызым кенеттен өлсе, үлкен оқиға болады. Бұл жақсы ма?
Dialogue: 0,0:12:21.65,0:12:23.57,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:12:24.20,0:12:27.95,Default,,0,0,0,,Өлтіретініңді білдің бе?
Dialogue: 0,0:12:28.37,0:12:30.41,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:12:30.91,0:12:33.50,Default,,0,0,0,,Мен бүгін жұмыстан ерте шықтым.
Dialogue: 0,0:12:33.62,0:12:34.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:37.67,0:12:40.38,Default,,0,0,0,,Ха... қария!
Dialogue: 0,0:12:42.55,0:12:43.38,Default,,0,0,0,,Ах
Dialogue: 0,0:12:44.47,0:12:49.39,Default,,0,0,0,,Наги Қалыпты болу туралы не ойлайсыз?
Dialogue: 0,0:12:50.56,0:12:51.77,Default,,0,0,0,,А...
Dialogue: 0,0:12:53.39,0:12:54.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:57.98,0:12:59.32,Default,,0,0,0,,Кәдімгі...?
Dialogue: 0,0:13:00.44,0:13:02.32,Default,,0,0,0,,Сіз бірдеңе айттыңыз ба? (Мо Мардер) Жоқ.
Dialogue: 0,0:13:04.61,0:13:06.57,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:13:06.78,0:13:09.78,Default,,0,0,0,,Бұл сіз үшін қалыпты жағдай емес пе?
Dialogue: 0,0:13:09.91,0:13:13.16,Default,,0,0,0,,Сіз өлтіру машинасысыз.
Dialogue: 0,0:13:16.17,0:13:18.50,Default,,0,0,0,,Ішіңізде қате бар
Dialogue: 0,0:13:19.42,0:13:22.63,Default,,0,0,0,,Жәндік бірте-бірте үлкейеді.
Dialogue: 0,0:13:23.42,0:13:26.88,Default,,0,0,0,,Тамақтану кезінде нені ұмытуға тырысасыз
Dialogue: 0,0:13:28.80,0:13:33.72,Default,,0,0,0,,Сенің тағдырыңды сол жәндік шешеді
Dialogue: 0,0:13:34.35,0:13:38.73,Default,,0,0,0,,Ал сен ол үшін өлетін шығарсың.
Dialogue: 0,0:13:39.31,0:13:44.07,Default,,0,0,0,,Сонымен, сізде идея бар ма? Сол кісі өлтіруші сияқты
Dialogue: 0,0:13:44.19,0:13:45.53,Default,,0,0,0,,Жоқ, ештеңе.
Dialogue: 0,0:13:45.82,0:13:49.28,Default,,0,0,0,,Иә... онда бұл сіздің жұмысыңыз енді.
Dialogue: 0,0:13:49.91,0:13:53.24,Default,,0,0,0,,Қылмыскер неліктен осылай өлтіргенін табыңыз.
Dialogue: 0,0:13:53.37,0:13:55.20,Default,,0,0,0,,Кейбір жағдайларда кәдеге жаратыңыз
Dialogue: 0,0:13:55.33,0:13:57.41,Default,,0,0,0,,Жарайды, бастайық...
Dialogue: 0,0:13:57.75,0:13:59.58,Default,,0,0,0,,Мен қайдан біле аламын?
Dialogue: 0,0:13:59.71,0:14:01.88,Default,,0,0,0,,Алдымен кісі өлтіру орнына барайық.
Dialogue: 0,0:14:02.38,0:14:05.71,Default,,0,0,0,,Ол қалай өлтірілді және оның мақсаты қандай...
Dialogue: 0,0:14:05.84,0:14:08.51,Default,,0,0,0,,Полиция мұндай әрекетті көптен бері істеп келеді.
Dialogue: 0,0:14:08.84,0:14:12.72,Default,,0,0,0,,Полиция байқамайтын ортақ нәрсе бар.
Dialogue: 0,0:14:12.85,0:14:16.68,Default,,0,0,0,,Бұл қылмыскер белгілі бір мақсатпен әрекет етеді.
Dialogue: 0,0:14:16.81,0:14:20.10,Default,,0,0,0,,Күтілгендей, дәл солай. Бұл жиіркенішті.
Dialogue: 0,0:14:20.23,0:14:22.57,Default,,0,0,0,,Көгершін мырза... болды ма?
Dialogue: 0,0:14:22.69,0:14:25.99,Default,,0,0,0,,Сіз өзіңіздің эмоцияларыңызды тым көп көрсетесіз.
Dialogue: 0,0:14:28.28,0:14:32.32,Default,,0,0,0,,Кісі өлтірушінің бұлай айтуының мағынасы жоқ.
Dialogue: 0,0:14:43.21,0:14:45.38,Default,,0,0,0,,Бұл жерде назар аудару оңай.
Dialogue: 0,0:14:45.75,0:14:47.88,Default,,0,0,0,,Ал айғайлар сізге жақын арада жетеді.
Dialogue: 0,0:14:48.67,0:14:50.89,Default,,0,0,0,,Басқаша айтқанда, тыңдамай...
Dialogue: 0,0:14:51.39,0:14:54.72,Default,,0,0,0,,Мақсатқа әп-сәтте жететін күшке ие болу
Dialogue: 0,0:14:56.35,0:15:00.64,Default,,0,0,0,,Солай бола тұрса да, қылмыс тым пісіп-жетілмеген, сақтық пен есепсіз болды.
Dialogue: 0,0:15:05.23,0:15:07.94,Default,,0,0,0,,Мен оны таба алмағаным кездейсоқтық шығар...
Dialogue: 0,0:15:08.07,0:15:09.36,Default,,0,0,0,,Бұл дәл солай...
Dialogue: 0,0:15:09.49,0:15:12.45,Default,,0,0,0,,Етқоректілерді аулау сияқты...?
Dialogue: 0,0:15:13.78,0:15:15.03,Default,,0,0,0,,Сіз… сіз…
Dialogue: 0,0:15:17.79,0:15:21.12,Default,,0,0,0,,Ағай, бұл жерді неге зерттеп жатырсыз?
Dialogue: 0,0:15:21.25,0:15:22.29,Default,,0,0,0,,Газет тілшісі?
Dialogue: 0,0:15:22.54,0:15:23.92,Default,,0,0,0,,Мен оны бөлек қарадым...
Dialogue: 0,0:15:24.04,0:15:25.09,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:25.21,0:15:28.17,Default,,0,0,0,,Егер сіз оны зерттемеген болсаңыз, сіз нені айтып отырсыз?
Dialogue: 0,0:15:28.59,0:15:29.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:30.05,0:15:32.64,Default,,0,0,0,,Оқиға орнына сұңқардай жалт қарады...
Dialogue: 0,0:15:33.26,0:15:37.01,Default,,0,0,0,,Айналадағы ғимараттардан көрінетінін немесе көрінбейтінін тексеріңіз.
Dialogue: 0,0:15:37.14,0:15:38.52,Default,,0,0,0,,Сіз мұны үнемі көріп жүрсіз бе?
Dialogue: 0,0:15:38.64,0:15:40.14,Default,,0,0,0,,Сіз өзіңізге көрінгіңіз келмейтін адамсыз ба?
Dialogue: 0,0:15:40.85,0:15:44.52,Default,,0,0,0,,Егер мен тергеп жатсам, оның сізге қатысы бар ма?
Dialogue: 0,0:15:44.86,0:15:47.78,Default,,0,0,0,,Ашуланбаңыз, мен аздап уайымдап тұрмын.
Dialogue: 0,0:15:48.48,0:15:51.61,Default,,0,0,0,,Мен сіздің жүзіңізді бұрын көрдім.
Dialogue: 0,0:15:51.74,0:15:55.53,Default,,0,0,0,,«Өлген танымал автордың жалғыз қызы» апта сайынғы журнал немесе басқалары.
Dialogue: 0,0:15:55.91,0:15:57.12,Default,,0,0,0,,Иә
Dialogue: 0,0:15:59.20,0:16:01.46,Default,,0,0,0,,Мен оны міндетті түрде зерттедім.
Dialogue: 0,0:16:01.58,0:16:02.62,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:16:02.75,0:16:06.42,Default,,0,0,0,,Мен бұл оқиғаны түсінгендей болдым.
Dialogue: 0,0:16:06.67,0:16:08.80,Default,,0,0,0,,Қарапайым кеңсе қызметкері?
Dialogue: 0,0:16:08.92,0:16:11.34,Default,,0,0,0,,I find it creepy myself...
Dialogue: 0,0:16:11.47,0:16:16.30,Default,,0,0,0,,Неге екені белгісіз, мен бұл жағдайда кінәлі адаммен ортақ бір нәрсе бар сияқты сезінемін.
Dialogue: 0,0:16:17.14,0:16:19.14,Default,,0,0,0,,Сіз бұл оқиғаны не үшін жасадыңыз?
Dialogue: 0,0:16:19.39,0:16:22.73,Default,,0,0,0,,Мен скучно (Мо Мардер) Мен скучно...
Dialogue: 0,0:16:22.85,0:16:26.94,Default,,0,0,0,,Эй, Сасаки мырза, сіз бірге тергеу жүргізгіңіз келе ме? бұл оқиға
Dialogue: 0,0:16:27.06,0:16:27.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:28.02,0:16:31.82,Default,,0,0,0,,Менде ақша бар. Сіз қылмыскердің сезімін түсінесіз.
Dialogue: 0,0:16:32.40,0:16:34.61,Default,,0,0,0,,Менің ойымша, олар жақсы комбинация жасайды.
Dialogue: 0,0:16:36.20,0:16:40.08,Default,,0,0,0,,I knew that the system in question was working, but...
Dialogue: 0,0:16:40.66,0:16:43.83,Default,,0,0,0,,But what do you mean? Наги-чан
Dialogue: 0,0:16:44.50,0:16:47.08,Default,,0,0,0,,Менің дәмін татқанымды қалайсың ба?
Dialogue: 0,0:16:48.29,0:16:52.09,Default,,0,0,0,,Дәмі керемет, хаха.
Dialogue: 0,0:16:54.59,0:16:58.43,Default,,0,0,0,,Бұрынғыдан мүлде басқа жер ғой, солай емес пе?
Dialogue: 0,0:16:58.55,0:17:00.22,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:17:00.68,0:17:01.89,Default,,0,0,0,,Бірақ мен Юлий деген адам емеспін.
Dialogue: 0,0:17:02.02,0:17:03.56,Default,,0,0,0,,Сәлем, Сасаки мырза
Dialogue: 0,0:17:03.68,0:17:06.56,Default,,0,0,0,,Қылмыскердің психологиясын елестете аласыз ба?
Dialogue: 0,0:17:06.85,0:17:08.69,Default,,0,0,0,,Сіз ештеңе сезбейсіз бе?
Dialogue: 0,0:17:08.94,0:17:10.69,Default,,0,0,0,,Айтсаңыз да...
Dialogue: 0,0:17:11.28,0:17:13.74,Default,,0,0,0,,The place where it is easy to attract attention and...
Dialogue: 0,0:17:13.86,0:17:16.66,Default,,0,0,0,,Неліктен біз дәл солай істейміз?
Dialogue: 0,0:17:16.78,0:17:19.99,Default,,0,0,0,,Адамдар мені көрді ме, не істегенім маңызды емес еді.
Dialogue: 0,0:17:20.12,0:17:21.83,Default,,0,0,0,,...Олай дейсіз бе?
Dialogue: 0,0:17:21.95,0:17:26.21,Default,,0,0,0,,Басқалардың не ойлайтыны сізді қызықтырмайды дейсіз бе?
Dialogue: 0,0:17:26.62,0:17:28.46,Default,,0,0,0,,What would you do?
Dialogue: 0,0:17:28.96,0:17:32.34,Default,,0,0,0,,Адамның бас сүйегінің ішіндегісін сорып алудың себебі бар деп есептесек...
Dialogue: 0,0:17:33.05,0:17:36.05,Default,,0,0,0,,Сіз мұны назарда болмай жасай аласыз ба?
Dialogue: 0,0:17:37.93,0:17:40.47,Default,,0,0,0,,Мен болсам, оны жасамас бұрын денені жасырар едім.
Dialogue: 0,0:17:41.10,0:17:43.22,Default,,0,0,0,,After all, I am afraid of being seen by others.
Dialogue: 0,0:17:43.93,0:17:45.68,Default,,0,0,0,,Сіз қорқасыз ба...
Dialogue: 0,0:17:46.02,0:17:49.31,Default,,0,0,0,,Бұл қылмыскер қорықпағанын білдіре ме?
Dialogue: 0,0:17:49.65,0:17:52.19,Default,,0,0,0,,Кирима мырза да ондай емес сияқты.
Dialogue: 0,0:17:52.32,0:17:54.44,Default,,0,0,0,,Are you trying to call me insensitive?
Dialogue: 0,0:17:54.57,0:17:56.99,Default,,0,0,0,,Мен қорықпаймын...
Dialogue: 0,0:17:57.49,0:17:59.95,Default,,0,0,0,,Сіз қорықпайсыз.
Dialogue: 0,0:18:00.37,0:18:03.58,Default,,0,0,0,,Қорқынышты нәрсе... Мен қорқамын...
Dialogue: 0,0:18:04.58,0:18:07.79,Default,,0,0,0,,Бұл мүмкін емес. Мен кіре алмаймын.
Dialogue: 0,0:18:08.29,0:18:10.50,Default,,0,0,0,,Сасаки мырза, сіз біреуді көтеріп көрдіңіз бе?
Dialogue: 0,0:18:10.63,0:18:13.50,Default,,0,0,0,,Не? (Наги) Бұл алып кету. Бұл алып кету.
Dialogue: 0,0:18:13.63,0:18:16.22,Default,,0,0,0,,Жоқ... жоқ, бірақ
Dialogue: 0,0:18:16.34,0:18:18.80,Default,,0,0,0,,Well, it's your first experience.
Dialogue: 0,0:18:21.30,0:18:23.01,Default,,0,0,0,,Сіз...
Dialogue: 0,0:18:23.14,0:18:24.77,Default,,0,0,0,,Не...?
Dialogue: 0,0:18:24.89,0:18:26.56,Default,,0,0,0,,Э-э…
Dialogue: 0,0:18:26.85,0:18:28.23,Default,,0,0,0,,Мүмкін сен-
Dialogue: 0,0:18:28.35,0:18:30.73,Default,,0,0,0,,Мен жәбірленушіге қатысы бар шығар деп ойладым.
Dialogue: 0,0:18:31.81,0:18:35.44,Default,,0,0,0,,А, жоқ, мен олай емеспін... күдікті.
Dialogue: 0,0:18:37.24,0:18:38.24,Default,,0,0,0,,Ах
Dialogue: 0,0:18:38.61,0:18:41.24,Default,,0,0,0,,Біз бұл оқиғаны зерттеп жатырмыз.
Dialogue: 0,0:18:41.78,0:18:44.20,Default,,0,0,0,,Сізбен бір сәт сөйлесе аламын ба?
Dialogue: 0,0:18:46.41,0:18:47.87,Default,,0,0,0,,Сақтандыру тергеушісі?
Dialogue: 0,0:18:48.50,0:18:51.58,Default,,0,0,0,,Ол осындай және 26 жаста.
Dialogue: 0,0:18:52.13,0:18:54.59,Default,,0,0,0,,Эй, Рика-сан, сен неге қашып кеттің?
Dialogue: 0,0:18:54.71,0:18:58.47,Default,,0,0,0,,Жарайды, сен менің досым болсаң, ақпарат құралдары да сені тыңдайды.
Dialogue: 0,0:18:58.92,0:19:01.18,Default,,0,0,0,,Екеуің қандай зерттеу жүргізіп жатырсыңдар?
Dialogue: 0,0:19:01.30,0:19:03.22,Default,,0,0,0,,А, аа, мм.
Dialogue: 0,0:19:03.55,0:19:05.93,Default,,0,0,0,,Бұл оқиға кездейсоқ қылмыс болды ма?
Dialogue: 0,0:19:06.06,0:19:08.48,Default,,0,0,0,,Бұл өшпенділік деп аталатын жағдай ма, әлде осыған ұқсас нәрсе ме...
Dialogue: 0,0:19:08.60,0:19:11.27,Default,,0,0,0,,Шизуэ неткен кек...
Dialogue: 0,0:19:12.86,0:19:15.40,Default,,0,0,0,,Шизуэ қандай адам болды?
Dialogue: 0,0:19:15.52,0:19:17.53,Default,,0,0,0,,Ешқандай реніш жоқ, солай ма?
Dialogue: 0,0:19:17.65,0:19:18.49,Default,,0,0,0,,Иә
Dialogue: 0,0:19:18.94,0:19:21.86,Default,,0,0,0,,Мен ешкімді ренжітетін бала емес едім.
Dialogue: 0,0:19:21.99,0:19:23.37,Default,,0,0,0,,Онда мен сізді арттан сәл итермелеуге тура келеді —
Dialogue: 0,0:19:23.49,0:19:25.20,Default,,0,0,0,,Сіз көңілді адам болдыңыз ба?
Dialogue: 0,0:19:25.33,0:19:28.79,Default,,0,0,0,,Иә, ол жарқын, жігерлі адам еді.
Dialogue: 0,0:19:28.91,0:19:30.12,Default,,0,0,0,,Сізде күшті өзегі бар ма?
Dialogue: 0,0:19:30.83,0:19:35.46,Default,,0,0,0,,Жүрегің түзу, жеңіске деген жігерің бар, тайсалмайсың дер едім.
Dialogue: 0,0:19:35.79,0:19:39.38,Default,,0,0,0,,Мен түнде қаңырап бос жатқан көшелерге мән бермейтін адаммын.
Dialogue: 0,0:19:39.88,0:19:41.76,Default,,0,0,0,,Сондықтан мұндай оқиға...
Dialogue: 0,0:19:42.13,0:19:44.18,Default,,0,0,0,,Ол Кирима-санға ұқсас.
Dialogue: 0,0:19:44.30,0:19:47.01,Default,,0,0,0,,Мен де қорқатын нәрселер бар.
Dialogue: 0,0:19:47.14,0:19:49.22,Default,,0,0,0,,Бірақ Шизуэ-сан басқаша болды, солай ма?
Dialogue: 0,0:19:49.35,0:19:51.98,Default,,0,0,0,,А... Иә, мүмкін.
Dialogue: 0,0:19:52.23,0:19:55.69,Default,,0,0,0,,Мүмкін бұл жай ғана мен басқаларға қарағанда көбірек қорқатын шығармын.
Dialogue: 0,0:19:55.81,0:19:56.65,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:57.23,0:20:00.61,Default,,0,0,0,,Мен бала кезімнен қорқамын.
Dialogue: 0,0:20:00.74,0:20:01.65,Default,,0,0,0,,Ах
Dialogue: 0,0:20:04.53,0:20:06.99,Default,,0,0,0,,Неліктен қорқыныш деген ұғым бар?
Dialogue: 0,0:20:07.12,0:20:08.29,Default,,0,0,0,,А...
Dialogue: 0,0:20:08.99,0:20:10.04,Default,,0,0,0,,Шынын айтсам, мен әлі де «Арнайы сынып» дегеннің не екенін түсінбеймін.
Dialogue: 0,0:20:10.16,0:20:12.87,Default,,0,0,0,,Жаңа кездескен адам да дәл осылай істеді...
Dialogue: 0,0:20:13.25,0:20:14.25,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:20:17.00,0:20:19.80,Default,,0,0,0,,Бұл қорқынышты болса керек.
Dialogue: 0,0:20:19.92,0:20:20.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:21.22,0:20:24.26,Default,,0,0,0,,Неліктен қорқыныш деген ұғым бар?
Dialogue: 0,0:20:25.01,0:20:26.64,Default,,0,0,0,,Қорқыныш болмаса...
Dialogue: 0,0:20:26.76,0:20:30.43,Default,,0,0,0,,Ол күліп тұра алар еді
Dialogue: 0,0:20:31.27,0:20:33.35,Default,,0,0,0,,Бұл шынымен қорқынышты...
Dialogue: 0,0:20:33.48,0:20:36.65,Default,,0,0,0,,Екі адам менімен сөйлескенде, мен жай ғана...
Dialogue: 0,0:20:37.27,0:20:40.48,Default,,0,0,0,,(Тодороки) Мен сол жігіттен барынша көп нәрсе үйренгім келеді
Dialogue: 0,0:20:40.61,0:20:41.78,Default,,0,0,0,,Менің қалай сезініп жүргенімді елестетіп көр.
Dialogue: 0,0:20:41.90,0:20:44.57,Default,,0,0,0,,Жаман аккаунтты артқа қалдырамын.
Dialogue: 0,0:20:46.49,0:20:50.16,Default,,0,0,0,,Тоқта, сен нені айтып тұрсың?
Dialogue: 0,0:20:50.29,0:20:53.12,Default,,0,0,0,,Сіздің күдіктеріңіз жойылды, Сасаки мырза.
Dialogue: 0,0:20:53.25,0:20:55.12,Default,,0,0,0,,Ху... (Наги) Өте жаман.
Dialogue: 0,0:20:55.25,0:20:58.84,Default,,0,0,0,,Менің де саған күмәнім бар еді, бірақ ол рас болып шықты.
Dialogue: 0,0:20:59.59,0:21:01.55,Default,,0,0,0,,Сонымен қоштасамыз
Dialogue: 0,0:21:01.67,0:21:04.97,Default,,0,0,0,,Неліктен менің күдігім жойылды? мен...
Dialogue: 0,0:21:05.22,0:21:07.47,Default,,0,0,0,,Мен абдырап қалдым, Сасаки мырза.
Dialogue: 0,0:21:07.59,0:21:11.27,Default,,0,0,0,,Ішіңдегі қате аздап шу шығаратын сияқты.
Dialogue: 0,0:21:12.02,0:21:14.77,Default,,0,0,0,,Сіз шынымен мейірімді адамсыз.
Dialogue: 0,0:21:14.89,0:21:17.90,Default,,0,0,0,,Мен өз бастамаммен кісі өлтірмеймін.
Dialogue: 0,0:21:18.15,0:21:21.36,Default,,0,0,0,,Біз жаңа ғана таныстық, неге сонша...
Dialogue: 0,0:21:21.48,0:21:22.94,Default,,0,0,0,,Бұл болжам.
Dialogue: 0,0:21:23.07,0:21:25.86,Default,,0,0,0,,Алайда мен Рика-санға ертерек қоңырау шалуын айтқанда...
Dialogue: 0,0:21:25.99,0:21:27.99,Default,,0,0,0,,Сіз шынымен абдырап қалдыңыз.
Dialogue: 0,0:21:28.12,0:21:30.41,Default,,0,0,0,,Онда ешқандай өтірік болған жоқ.
Dialogue: 0,0:21:31.37,0:21:34.12,Default,,0,0,0,,Бұл жеткілікті емес пе? Сонда кездескенше
Dialogue: 0,0:21:37.17,0:21:41.80,Default,,0,0,0,,Сіз... кінәлінің кім екенін білдіңіз бе?
Dialogue: 0,0:21:44.13,0:21:47.47,Default,,0,0,0,,Мен сізге кеңес бердім, енді күту керек.
Dialogue: 0,0:21:48.22,0:21:51.10,Default,,0,0,0,,Сен келесің, Наги-чан.
Dialogue: 0,0:21:51.31,0:21:54.85,Default,,0,0,0,,Егер сізде теңдесі жоқ әділеттілік сезімі болса, мен сенімдімін...
Dialogue: 0,0:21:56.02,0:21:58.56,Default,,0,0,0,,Ал маған дәлелде.
Dialogue: 0,0:21:59.15,0:22:03.73,Default,,0,0,0,,Ішінде бәрі өртеніп бара жатқандай...
Dialogue: 0,0:22:04.19,0:22:07.99,Default,,0,0,0,,Оның от күші бар екендігі
Dialogue: 0,0:22:11.45,0:22:16.83,Default,,0,0,0,,♪～
Dialogue: 0,0:23:34.83,0:23:39.04,Default,,0,0,0,,～♪
Dialogue: 0,0:23:40.54,0:23:46.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory