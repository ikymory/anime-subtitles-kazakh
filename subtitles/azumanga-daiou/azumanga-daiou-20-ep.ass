Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.02,0:01:32.85,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:01:48.54,0:01:50.71,Default,,0000,0000,0000,,Хмм, мен оны шеше алмаймын...
Dialogue: 0,0:01:50.71,0:01:54.71,Default,,0000,0000,0000,,Ммм... Ах~.
Dialogue: 0,0:01:54.71,0:01:58.38,Default,,0000,0000,0000,,Осака мырза…
Dialogue: 0,0:01:54.71,0:01:58.38,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:01:58.38,0:02:00.88,Default,,0000,0000,0000,,Рахмет, Чио-чан.
Dialogue: 0,0:02:02.98,0:02:07.32,Default,,0000,0000,0000,,Бүгіннен бастап 3-ші жыл. Барымызды салайық!
Dialogue: 0,0:02:07.32,0:02:10.33,Default,,0000,0000,0000,,Сояна~ Қолыңнан келгенін істе~.
Dialogue: 0,0:02:10.33,0:02:21.00,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:21.00,0:02:23.00,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:02:23.00,0:02:25.34,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:25.34,0:02:28.18,Default,,0000,0000,0000,,Ахх.
Dialogue: 0,0:02:25.34,0:02:28.18,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:28.18,0:02:30.35,Default,,0000,0000,0000,,О, жоқ... күрсін...
Dialogue: 0,0:02:30.35,0:02:35.52,Default,,0000,0000,0000,,Күн сайын үшінші қабатқа көтерілу
Dialogue: 0,0:02:30.35,0:02:35.52,Default,,0000,0000,0000,,Мен бас тартатын сияқтымын...
Dialogue: 0,0:02:30.35,0:02:35.52,Default,,0000,0000,0000,,Бұл ерте...
Dialogue: 0,0:02:35.52,0:02:38.52,Default,,0000,0000,0000,,Қайырлы таң!
Dialogue: 0,0:02:38.52,0:02:41.19,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:02:38.52,0:02:41.19,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:02:41.19,0:02:43.69,Default,,0000,0000,0000,,Біз бәріміз қайтадан біргеміз.
Dialogue: 0,0:02:43.69,0:02:45.86,Default,,0000,0000,0000,,Томо-чан мен Каорин ше?
Dialogue: 0,0:02:45.86,0:02:49.03,Default,,0000,0000,0000,,Сатоши әлі де сонда болды, бірақ Каорин басқаша болды.
Dialogue: 0,0:02:49.03,0:02:52.53,Default,,0000,0000,0000,,Түсіндім... Кешіріңіз.
Dialogue: 0,0:02:52.53,0:02:55.87,Default,,0000,0000,0000,,Сәлем бәріңе
Dialogue: 0,0:02:52.53,0:02:55.87,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:02:55.87,0:02:58.71,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:02:55.87,0:02:58.71,Default,,0000,0000,0000,,Сіз шашыңызды қидыңыз ба?
Dialogue: 0,0:02:58.71,0:03:00.64,Default,,0000,0000,0000,,Иә! Кеше жел болды!
Dialogue: 0,0:03:00.64,0:03:05.48,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Менің жаңа сүйкімділігім
Dialogue: 0,0:03:00.64,0:03:05.48,Default,,0000,0000,0000,,Көктемгі пері де тажитажи~?
Dialogue: 0,0:03:05.48,0:03:09.15,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:03:05.48,0:03:09.15,Default,,0000,0000,0000,,Өйткені, мен қазір үшінші курс студентімін.
Dialogue: 0,0:03:09.15,0:03:12.49,Default,,0000,0000,0000,,《Чиё: Мен бірінші курста оқып жүрген кезім
Dialogue: 0,0:03:09.15,0:03:12.49,Default,,0000,0000,0000,,Мен өзімді жаңа ғана оралғандай сезінемін...》
Dialogue: 0,0:03:12.49,0:03:14.59,Default,,0000,0000,0000,,Бірақ неге кесіп тастадың... Ах.
Dialogue: 0,0:03:16.66,0:03:20.33,Default,,0000,0000,0000,,Ахаха, олай емес!
Dialogue: 0,0:03:16.66,0:03:20.33,Default,,0000,0000,0000,,Дұрыс!
Dialogue: 0,0:03:20.33,0:03:22.83,Default,,0000,0000,0000,,Оны неге кесіп тастадың?
Dialogue: 0,0:03:22.83,0:03:25.33,Default,,0000,0000,0000,,Бұл біраз түсініксіз, бірақ бәрібір.
Dialogue: 0,0:03:25.33,0:03:29.67,Default,,0000,0000,0000,,Өткен жылға дейін мен болдым
Dialogue: 0,0:03:25.33,0:03:29.67,Default,,0000,0000,0000,,Сексуалды көріну үшін шашыңызды ұзартыңыз➡
Dialogue: 0,0:03:29.67,0:03:32.07,Default,,0000,0000,0000,,Ал, Фудзико-чан.
Dialogue: 0,0:03:29.67,0:03:32.07,Default,,0000,0000,0000,,Менің көздегенім осы еді.
Dialogue: 0,0:03:34.01,0:03:36.31,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:34.01,0:03:36.31,Default,,0000,0000,0000,,Фудзико-чан?
Dialogue: 0,0:03:38.35,0:03:41.35,Default,,0000,0000,0000,,Еш нәрсеге ұмтылу
Dialogue: 0,0:03:38.35,0:03:41.35,Default,,0000,0000,0000,,Бұл түбегейлі басқа, солай емес пе?
Dialogue: 0,0:03:41.35,0:03:44.85,Default,,0000,0000,0000,,Жоқ, кеудеден басқа.
Dialogue: 0,0:03:41.35,0:03:44.85,Default,,0000,0000,0000,,Мен біраз үлгердім.
Dialogue: 0,0:03:44.85,0:03:49.19,Default,,0000,0000,0000,,Қай жағынан?
Dialogue: 0,0:03:44.85,0:03:49.19,Default,,0000,0000,0000,,Луппан!
Dialogue: 0,0:03:44.85,0:03:49.19,Default,,0000,0000,0000,,Ахх...
Dialogue: 0,0:03:49.19,0:03:52.86,Default,,0000,0000,0000,,Сондықтан Фудзико-чанның маршруты
Dialogue: 0,0:03:49.19,0:03:52.86,Default,,0000,0000,0000,,Мен кеттім!
Dialogue: 0,0:03:52.86,0:03:55.70,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:52.86,0:03:55.70,Default,,0000,0000,0000,,Бірақ егер бұл «Аю» туралы болса
Dialogue: 0,0:03:52.86,0:03:55.70,Default,,0000,0000,0000,,Барсақ болады ма?
Dialogue: 0,0:03:55.70,0:03:57.70,Default,,0000,0000,0000,,туралы...
Dialogue: 0,0:03:57.70,0:04:01.47,Default,,0000,0000,0000,,Чиё-чан, мұндай кезде ашулануға болмайды!
Dialogue: 0,0:04:04.97,0:04:07.98,Default,,0000,0000,0000,,Бұл Юкари Танизаки, 3-сыныптың сынып жетекшісі.
Dialogue: 0,0:04:07.98,0:04:10.98,Default,,0000,0000,0000,,Сен де биыл
Dialogue: 0,0:04:07.98,0:04:10.98,Default,,0000,0000,0000,,Енді емтихан тапсыру уақыты келді.
Dialogue: 0,0:04:10.98,0:04:14.32,Default,,0000,0000,0000,,Мен қатты күйзеліске ұшырадым
Dialogue: 0,0:04:10.98,0:04:14.32,Default,,0000,0000,0000,,Бұл қиын болады.
Dialogue: 0,0:04:14.32,0:04:17.82,Default,,0000,0000,0000,,Бірақ жұмыс істейтін ересектер үшін бұл одан да қиын.
Dialogue: 0,0:04:17.82,0:04:20.16,Default,,0000,0000,0000,,Бұзбаңыз.
Dialogue: 0,0:04:17.82,0:04:20.16,Default,,0000,0000,0000,,Ахх...
Dialogue: 0,0:04:20.16,0:04:24.66,Default,,0000,0000,0000,,Қазіргі білімнің құрбаны сияқты
Dialogue: 0,0:04:20.16,0:04:24.66,Default,,0000,0000,0000,,Бұл трагедия емес!
Dialogue: 0,0:04:24.66,0:04:28.16,Default,,0000,0000,0000,,Юкари-чан
Dialogue: 0,0:04:24.66,0:04:28.16,Default,,0000,0000,0000,,Тырнақтың болуы біртүрлі емес пе?
Dialogue: 0,0:04:28.16,0:04:31.83,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:04:28.16,0:04:31.83,Default,,0000,0000,0000,,Шамамен
Dialogue: 0,0:04:28.16,0:04:31.83,Default,,0000,0000,0000,,Оқығың келмесе➡
Dialogue: 0,0:04:31.83,0:04:35.67,Default,,0000,0000,0000,,Мен университетке барамын. Күрсіну….
Dialogue: 0,0:04:35.67,0:04:39.67,Default,,0000,0000,0000,,Сонда, Юкари-чан?
Dialogue: 0,0:04:35.67,0:04:39.67,Default,,0000,0000,0000,,Сіз университетке оқығыңыз келгендіктен бардыңыз ба?
Dialogue: 0,0:04:39.67,0:04:42.07,Default,,0000,0000,0000,,Ха, бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:04:44.01,0:04:48.35,Default,,0000,0000,0000,,Басқаларға айтпа
Dialogue: 0,0:04:44.01,0:04:48.35,Default,,0000,0000,0000,,Бұл да жүрегіңдегі жара емес пе?
Dialogue: 0,0:04:48.35,0:04:50.52,Default,,0000,0000,0000,,Әрқашан осылай...
Dialogue: 0,0:04:50.52,0:04:55.52,Default,,0000,0000,0000,,Жарайсыңдар, балалар, емтиханды өз беттерінше тапсыру туралы ойлануларың керек➡
Dialogue: 0,0:04:55.52,0:04:59.69,Default,,0000,0000,0000,,Мұғалім ондаған адамға емтихан тапсырды.
Dialogue: 0,0:04:55.52,0:04:59.69,Default,,0000,0000,0000,,Бұл туралы ойлану керек.
Dialogue: 0,0:04:59.69,0:05:04.30,Default,,0000,0000,0000,,Юкари-чан
Dialogue: 0,0:04:59.69,0:05:04.30,Default,,0000,0000,0000,,Мұғалім: Менің ойымша, бұл біртүрлі болды.
Dialogue: 0,0:05:04.30,0:05:06.80,Default,,0000,0000,0000,,Осылай десеңіз
Dialogue: 0,0:05:04.30,0:05:06.80,Default,,0000,0000,0000,,Қашатын жер болмайды...
Dialogue: 0,0:05:06.80,0:05:11.31,Default,,0000,0000,0000,,Тоқтау керек пе деп ойлаймын.
Dialogue: 0,0:05:06.80,0:05:11.31,Default,,0000,0000,0000,,Ахх...
Dialogue: 0,0:05:11.31,0:05:16.31,Default,,0000,0000,0000,,《Аа... маңызды нәрсе
Dialogue: 0,0:05:11.31,0:05:16.31,Default,,0000,0000,0000,,Мен ұмытып кеткендей болдым...》
Dialogue: 0,0:05:19.15,0:05:22.85,Default,,0000,0000,0000,,I
Dialogue: 0,0:05:19.15,0:05:22.85,Default,,0000,0000,0000,,Бұл Кимура, осы төрт сыныптың сынып жетекшісі.
Dialogue: 0,0:05:24.82,0:05:34.82,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:05:39.67,0:05:43.17,Default,,0000,0000,0000,,Құттықтаймыз!
Dialogue: 0,0:05:39.67,0:05:43.17,Default,,0000,0000,0000,,Туған күнің құтты болсын!
Dialogue: 0,0:05:43.17,0:05:45.34,Default,,0000,0000,0000,,Иә, шынымен бе? Рақмет сізге!
Dialogue: 0,0:05:45.34,0:05:47.34,Default,,0000,0000,0000,,(Цимбал дыбысы)
Dialogue: 0,0:05:47.34,0:05:50.04,Default,,0000,0000,0000,,Мұғалім, ашыңызшы.
Dialogue: 0,0:05:47.34,0:05:50.04,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:05:54.35,0:05:56.69,Default,,0000,0000,0000,,Бір сәтке танымадым.
Dialogue: 0,0:05:54.35,0:05:56.69,Default,,0000,0000,0000,,Куросава Ах!
Dialogue: 0,0:05:54.35,0:05:56.69,Default,,0000,0000,0000,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:05:56.69,0:05:59.19,Default,,0000,0000,0000,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:05:56.69,0:05:59.19,Default,,0000,0000,0000,,Сіз не алдыңыз?
Dialogue: 0,0:06:01.96,0:06:04.46,Default,,0000,0000,0000,,Сөмке….
Dialogue: 0,0:06:01.96,0:06:04.46,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:06:06.46,0:06:10.47,Default,,0000,0000,0000,,Менде тіпті сөмке бар!
Dialogue: 0,0:06:06.46,0:06:10.47,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:06:10.47,0:06:13.13,Default,,0000,0000,0000,,Сөмке!
Dialogue: 0,0:06:10.47,0:06:13.13,Default,,0000,0000,0000,,Оның болмағаны жақсы!
Dialogue: 0,0:06:13.13,0:06:15.13,Default,,0000,0000,0000,,Неліктен...?
Dialogue: 0,0:06:17.14,0:06:20.14,Default,,0000,0000,0000,,Бұл жігіт жаман адам!
Dialogue: 0,0:06:17.14,0:06:20.14,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:06:20.14,0:06:24.65,Default,,0000,0000,0000,,Біз ересекпіз!
Dialogue: 0,0:06:20.14,0:06:24.65,Default,,0000,0000,0000,,Туған күн қандай қуаныш!
Dialogue: 0,0:06:24.65,0:06:26.98,Default,,0000,0000,0000,,Мен оны толығымен естимін ...
Dialogue: 0,0:06:26.98,0:06:30.32,Default,,0000,0000,0000,,Ойланып қарасақ, биыл тағы да осындамыз...
Dialogue: 0,0:06:30.32,0:06:32.49,Default,,0000,0000,0000,,Мен оны саған берген жоқпын...
Dialogue: 0,0:06:32.49,0:06:34.99,Default,,0000,0000,0000,,Нямо-чан
Dialogue: 0,0:06:32.49,0:06:34.99,Default,,0000,0000,0000,,Өткен жылы да...
Dialogue: 0,0:06:36.99,0:06:39.16,Default,,0000,0000,0000,,Ухуу хеху~.
Dialogue: 0,0:06:39.16,0:06:41.83,Default,,0000,0000,0000,,Не болды? Күлімсіреу.
Dialogue: 0,0:06:41.83,0:06:45.67,Default,,0000,0000,0000,,Иә? Қараңдар!
Dialogue: 0,0:06:45.67,0:06:49.84,Default,,0000,0000,0000,,Сыныптағы барлық адамдар.
Dialogue: 0,0:06:45.67,0:06:49.84,Default,,0000,0000,0000,,Оны туған күніме сыйлық ретінде берді.
Dialogue: 0,0:06:49.84,0:06:53.34,Default,,0000,0000,0000,,Сіз мені бір нәрсеге алаңдатып отырсыз.
Менің ойымша, бұл
Dialogue: 0,0:06:49.84,0:06:53.34,Default,,0000,0000,0000,,➡
Dialogue: 0,0:06:53.34,0:06:55.34,Default,,0000,0000,0000,,Мен шынымен бақыттымын.
Dialogue: 0,0:06:55.34,0:06:57.35,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:06:57.35,0:07:00.95,Default,,0000,0000,0000,,Бірдеңе дұрыс емес! ? жастар драмасы
Dialogue: 0,0:06:57.35,0:07:00.95,Default,,0000,0000,0000,,Сіз мұғалім болуға тырысасыз ба? ?
Dialogue: 0,0:07:00.95,0:07:02.95,Default,,0000,0000,0000,,Неге сонша ашуланасың?
Dialogue: 0,0:07:02.95,0:07:05.79,Default,,0000,0000,0000,,(Тақтадағы жазу дыбысы)
Dialogue: 0,0:07:05.79,0:07:08.79,Default,,0000,0000,0000,,Юкари-чан бүгін біртүрлі болып көрінеді.
Dialogue: 0,0:07:08.79,0:07:11.09,Default,,0000,0000,0000,,Әй, біртүрлі тыныш...
Dialogue: 0,0:07:17.97,0:07:21.30,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:07:17.97,0:07:21.30,Default,,0000,0000,0000,,Куросава мырза көрші сыныпта➡
Dialogue: 0,0:07:21.30,0:07:24.50,Default,,0000,0000,0000,,Менің туған күніме сыныптағылардың барлығынан
Dialogue: 0,0:07:21.30,0:07:24.50,Default,,0000,0000,0000,,Мен сізге сыйлық алғаныңызды естідім.
Dialogue: 0,0:07:32.98,0:07:36.08,Default,,0000,0000,0000,,Юкари-сенсэйдің туған күні қандай?
Dialogue: 0,0:07:32.98,0:07:36.08,Default,,0000,0000,0000,,Қашан?
Dialogue: 0,0:07:38.82,0:07:41.02,Default,,0000,0000,0000,,Ол әлдеқашан өтті.
Dialogue: 0,0:07:42.99,0:07:45.66,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:07:42.99,0:07:45.66,Default,,0000,0000,0000,,Юкари-чанның туған күні➡
Dialogue: 0,0:07:45.66,0:07:49.66,Default,,0000,0000,0000,,Мен көктемгі демалыстамын.
Dialogue: 0,0:07:45.66,0:07:49.66,Default,,0000,0000,0000,,Бұл өте жаман. Мен оны қазір саған беремін.
Dialogue: 0,0:07:49.66,0:07:52.00,Default,,0000,0000,0000,,Сыйлықтар және т.б.
Dialogue: 0,0:07:49.66,0:07:52.00,Default,,0000,0000,0000,,Маған керек емес!
Dialogue: 0,0:07:52.00,0:07:54.84,Default,,0000,0000,0000,,Ах... Кешіріңіз...
Dialogue: 0,0:07:54.84,0:07:58.34,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:07:58.34,0:08:01.84,Default,,0000,0000,0000,,Туған күніңмен...?
Dialogue: 0,0:08:08.12,0:08:10.12,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:08:10.12,0:08:13.45,Default,,0000,0000,0000,,Сол мұғалім!
Dialogue: 0,0:08:10.12,0:08:13.45,Default,,0000,0000,0000,,А~?
Dialogue: 0,0:08:13.45,0:08:15.46,Default,,0000,0000,0000,,Мен кешігіп қалдым, бірақ➡
Dialogue: 0,0:08:15.46,0:08:18.96,Default,,0000,0000,0000,,Сыныптағы барлық адамдардан
Dialogue: 0,0:08:15.46,0:08:18.96,Default,,0000,0000,0000,,Бұл туған күніне сыйлық!
Dialogue: 0,0:08:15.46,0:08:18.96,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:08:20.96,0:08:25.97,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:08:20.96,0:08:25.97,Default,,0000,0000,0000,,Сен маған оны Нямоға бер деп жатырсың ба?
Dialogue: 0,0:08:25.97,0:08:29.14,Default,,0000,0000,0000,,Жоқ! Бұл Юкари Сенсейдікі!
Dialogue: 0,0:08:29.14,0:08:31.64,Default,,0000,0000,0000,,Менің сыйлығым?
Dialogue: 0,0:08:29.14,0:08:31.64,Default,,0000,0000,0000,,Иә, иә….
Dialogue: 0,0:08:33.64,0:08:39.31,Default,,0000,0000,0000,,Туған күнің құтты болсын!
Dialogue: 0,0:08:33.64,0:08:39.31,Default,,0000,0000,0000,,Туған күнің құтты болсын!
Dialogue: 0,0:08:39.31,0:08:43.15,Default,,0000,0000,0000,,Туған күніңмен Құрметті Юкари-чан!
Dialogue: 0,0:08:43.15,0:08:45.35,Default,,0000,0000,0000,,Туған күнің құтты болсын!
Dialogue: 0,0:08:47.32,0:08:49.82,Default,,0000,0000,0000,,Сіз бақыттысыз ба?
Dialogue: 0,0:08:47.32,0:08:49.82,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:08:49.82,0:08:53.49,Default,,0000,0000,0000,,А, бұл сөмке...
Dialogue: 0,0:08:49.82,0:08:53.49,Default,,0000,0000,0000,,Изуку Мидория…
Dialogue: 0,0:08:53.49,0:08:55.49,Default,,0000,0000,0000,,Мен біраз уақытқа шығамын!
Dialogue: 0,0:08:57.67,0:08:59.93,Default,,0000,0000,0000,,Мен 2-сыныпқа өзімді көрсетуге бардым.
Dialogue: 0,0:08:59.93,0:09:03.27,Default,,0000,0000,0000,,Сенің бақытты болғаныңа қуаныштымын.
Dialogue: 0,0:09:03.27,0:09:07.28,Default,,0000,0000,0000,,(сыбырлау)
Dialogue: 0,0:09:07.28,0:09:09.44,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:09:09.44,0:09:12.61,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:09:12.61,0:09:18.62,Default,,0000,0000,0000,,♬ «Туған күніңмен құттықтаймын»
Dialogue: 0,0:09:12.61,0:09:18.62,Default,,0000,0000,0000,,Туған күніңмен»
Dialogue: 0,0:09:18.62,0:09:22.79,Default,,0000,0000,0000,,♬ “Туған күніңмен Қымбатты Кимрин!”
Dialogue: 0,0:09:22.79,0:09:24.79,Default,,0000,0000,0000,,Кимурин?
Dialogue: 0,0:09:24.79,0:09:29.09,Default,,0000,0000,0000,,♬ «Туған күніңмен құттықтаймын»
Dialogue: 0,0:09:36.80,0:09:39.97,Default,,0000,0000,0000,,《Мен? 》
Dialogue: 0,0:09:39.97,0:09:44.81,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:09:44.81,0:09:46.81,Default,,0000,0000,0000,,Сіздің мансап жолыңыз қандай?
Dialogue: 0,0:09:46.81,0:09:49.32,Default,,0000,0000,0000,,Иә, мен үшінші курс студентімін.
Dialogue: 0,0:09:49.32,0:09:52.49,Default,,0000,0000,0000,,көремін. Мен де.
Dialogue: 0,0:09:49.32,0:09:52.49,Default,,0000,0000,0000,,Сіз әлдеқашан тест тапсырушысыз.
Dialogue: 0,0:09:52.49,0:09:55.99,Default,,0000,0000,0000,,Емтихан….
Dialogue: 0,0:09:52.49,0:09:55.99,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:09:55.99,0:09:58.99,Default,,0000,0000,0000,,Хаха, түсіндім!
Dialogue: 0,0:09:55.99,0:09:58.99,Default,,0000,0000,0000,,Дене тәрбиесі ұсынылады!
Dialogue: 0,0:09:58.99,0:10:02.33,Default,,0000,0000,0000,,Шулы!
Dialogue: 0,0:09:58.99,0:10:02.33,Default,,0000,0000,0000,,Даналық не істеуі керек?
Dialogue: 0,0:10:02.33,0:10:07.50,Default,,0000,0000,0000,,Иә, мен? I.C.P.O.
Dialogue: 0,0:10:02.33,0:10:07.50,Default,,0000,0000,0000,,ICPO дегеніміз не?
Dialogue: 0,0:10:07.50,0:10:09.50,Default,,0000,0000,0000,,Интерпол!
Dialogue: 0,0:10:07.50,0:10:09.50,Default,,0000,0000,0000,,О!
Dialogue: 0,0:10:09.50,0:10:14.84,Default,,0000,0000,0000,,Халықаралық полиция!
Dialogue: 0,0:10:09.50,0:10:14.84,Default,,0000,0000,0000,,О, керемет! Сіз баласыз ба?
Dialogue: 0,0:10:14.84,0:10:17.85,Default,,0000,0000,0000,,Бірақ бұл шынымен рас па?
Dialogue: 0,0:10:17.85,0:10:19.85,Default,,0000,0000,0000,,Мен бұл тек фильмдер деп ойладым.
Dialogue: 0,0:10:19.85,0:10:24.19,Default,,0000,0000,0000,,Иә! ? Жоқ! ?
Dialogue: 0,0:10:19.85,0:10:24.19,Default,,0000,0000,0000,,Иә, ICPO.
Dialogue: 0,0:10:24.19,0:10:26.69,Default,,0000,0000,0000,,Міне, мінекей!
Dialogue: 0,0:10:26.69,0:10:28.69,Default,,0000,0000,0000,,Бұл қалай болады?
Dialogue: 0,0:10:28.69,0:10:31.03,Default,,0000,0000,0000,,Білмеймін!
Dialogue: 0,0:10:28.69,0:10:31.03,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:10:31.03,0:10:33.03,Default,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:10:33.03,0:10:36.70,Default,,0000,0000,0000,,Алғашында полиция қызметкері болдым.
Dialogue: 0,0:10:33.03,0:10:36.70,Default,,0000,0000,0000,,Қызық, сол жерден таңдалады ма?
Dialogue: 0,0:10:36.70,0:10:40.54,Default,,0000,0000,0000,,О, мынау-ау! ?
Dialogue: 0,0:10:36.70,0:10:40.54,Default,,0000,0000,0000,,Мен шынымен білмеймін.
Dialogue: 0,0:10:40.54,0:10:44.37,Default,,0000,0000,0000,,Ал, сен қаласаң да ештеңе білмейсің.
Dialogue: 0,0:10:44.37,0:10:48.04,Default,,0000,0000,0000,,Мен көріп тұрмын~ Сатоши-чан
Dialogue: 0,0:10:44.37,0:10:48.04,Default,,0000,0000,0000,,Сіз полиция қызметкері боласыз ба?
Dialogue: 0,0:10:48.04,0:10:50.38,Default,,0000,0000,0000,,Сондықтан бұл ICPO.
Dialogue: 0,0:10:50.38,0:10:52.71,Default,,0000,0000,0000,,Полиция туралы айту➡
Dialogue: 0,0:10:52.71,0:10:55.05,Default,,0000,0000,0000,,Бұрынғыдан
Dialogue: 0,0:10:52.71,0:10:55.05,Default,,0000,0000,0000,,Мені бір нәрсе қызықтырды.
Dialogue: 0,0:10:55.05,0:10:57.05,Default,,0000,0000,0000,,Адамдардың айтқанын тыңдаңыз.
Dialogue: 0,0:10:57.05,0:11:00.32,Default,,0000,0000,0000,,Полиция дәптерінде
Dialogue: 0,0:10:57.05,0:11:00.32,Default,,0000,0000,0000,,Ол не дейді?
Dialogue: 0,0:11:00.32,0:11:03.32,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:11:03.32,0:11:08.16,Default,,0000,0000,0000,,Өйткені, мекен-жай кітапшасы, жадынамалар т.б.
Dialogue: 0,0:11:03.32,0:11:08.16,Default,,0000,0000,0000,,Бұл сіздің артыңызда ма?
Dialogue: 0,0:11:08.16,0:11:10.33,Default,,0000,0000,0000,,Олай десеңіз...
Dialogue: 0,0:11:10.33,0:11:13.00,Default,,0000,0000,0000,,Онда қылмыскердің мекенжайы және
Dialogue: 0,0:11:10.33,0:11:13.00,Default,,0000,0000,0000,,Телефон нөмірі!
Dialogue: 0,0:11:13.00,0:11:15.00,Default,,0000,0000,0000,,Уау, ыңғайлы!
Dialogue: 0,0:11:15.00,0:11:18.67,Default,,0000,0000,0000,,Амал жоқ, солай ма?
Dialogue: 0,0:11:15.00,0:11:18.67,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:11:18.67,0:11:22.34,Default,,0000,0000,0000,,Содан кейін, сізге ұнайтын адам
Dialogue: 0,0:11:18.67,0:11:22.34,Default,,0000,0000,0000,,Сіз фотосуретті қосасыз ба?
Dialogue: 0,0:11:22.34,0:11:26.18,Default,,0000,0000,0000,,Сіздің сүйікті әйел полиция қызметкерінің суреті
Dialogue: 0,0:11:22.34,0:11:26.18,Default,,0000,0000,0000,,Пурикура сияқты нәрсе.
Dialogue: 0,0:11:26.18,0:11:28.18,Default,,0000,0000,0000,,Бұл әйел полиция қызметкері ме?
Dialogue: 0,0:11:28.18,0:11:31.52,Default,,0000,0000,0000,,Бірақ полиция қызметкеріне
Dialogue: 0,0:11:28.18,0:11:31.52,Default,,0000,0000,0000,,Маған ғашық болып қалсаң сұмдық болар еді.
Dialogue: 0,0:11:31.52,0:11:33.69,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:11:33.69,0:11:38.19,Default,,0000,0000,0000,,Қараңдаршы, әлгі адамдар бізді аңдып жатыр.
Dialogue: 0,0:11:33.69,0:11:38.19,Default,,0000,0000,0000,,Мен оны көтере алмаймын.
Dialogue: 0,0:11:38.19,0:11:41.20,Default,,0000,0000,0000,,ICPO-ға не болды?
Dialogue: 0,0:11:38.19,0:11:41.20,Default,,0000,0000,0000,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:11:45.20,0:11:47.54,Default,,0000,0000,0000,,Чио-чан университетке түсе ме?
Dialogue: 0,0:11:47.54,0:11:49.54,Default,,0000,0000,0000,,Токио университеті сияқты ма?
Dialogue: 0,0:11:49.54,0:11:53.21,Default,,0000,0000,0000,,Жоқ
Dialogue: 0,0:11:49.54,0:11:53.21,Default,,0000,0000,0000,,Шетелге барып көру керек деп ойлаймын.
Dialogue: 0,0:11:53.21,0:11:55.21,Default,,0000,0000,0000,,Әй, шетелде оқы! ?
Dialogue: 0,0:11:53.21,0:11:55.21,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:11:55.21,0:11:59.38,Default,,0000,0000,0000,,Америка университеттері бағаны жіберіп алатын балаларға арналған.
Dialogue: 0,0:11:55.21,0:11:59.38,Default,,0000,0000,0000,,Оқушыларды қабылдауда да жақсы жұмыс жасаймыз.
Dialogue: 0,0:11:59.38,0:12:02.48,Default,,0000,0000,0000,,Керемет! Шетелде оқу?
Dialogue: 0,0:12:02.48,0:12:06.65,Default,,0000,0000,0000,,Сасаки мен Ичиродан кейін Чиё Чан болады ма?
Dialogue: 0,0:12:06.65,0:12:09.16,Default,,0000,0000,0000,,Бұл сәл басқаша...
Dialogue: 0,0:12:09.16,0:12:11.99,Default,,0000,0000,0000,,Чио-чанның шетелде оқитыны таң қалдырады.
Dialogue: 0,0:12:11.99,0:12:15.00,Default,,0000,0000,0000,,Иә, бұл керемет.
Dialogue: 0,0:12:11.99,0:12:15.00,Default,,0000,0000,0000,,Жоқ, солай...
Dialogue: 0,0:12:15.00,0:12:18.17,Default,,0000,0000,0000,,Өлтірме.
Dialogue: 0,0:12:15.00,0:12:18.17,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:12:15.00,0:12:18.17,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:12:18.17,0:12:21.67,Default,,0000,0000,0000,,Себебі менің отбасым бай.
Dialogue: 0,0:12:18.17,0:12:21.67,Default,,0000,0000,0000,,Бұл кішкентай...
Dialogue: 0,0:12:23.67,0:12:26.17,Default,,0000,0000,0000,,Оны ұстау оңай.
Dialogue: 0,0:12:26.17,0:12:28.18,Default,,0000,0000,0000,,Сіз бұлай айтқанда...
Dialogue: 0,0:12:28.18,0:12:32.68,Default,,0000,0000,0000,,Бірақ төтенше жағдайда
Dialogue: 0,0:12:28.18,0:12:32.68,Default,,0000,0000,0000,,Тадайоши сізді қорғайды!
Dialogue: 0,0:12:34.68,0:12:38.69,Default,,0000,0000,0000,,Өртеп жібер! Тадаёси атылды.
Dialogue: 0,0:12:38.69,0:12:42.52,Default,,0000,0000,0000,,Иә! ? Сонымен, мен не істеуім керек ...
Dialogue: 0,0:12:42.52,0:12:45.03,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:12:45.03,0:12:47.03,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:12:47.03,0:12:51.37,Default,,0000,0000,0000,,Драма сияқты
Dialogue: 0,0:12:47.03,0:12:51.37,Default,,0000,0000,0000,,Сол данышпан миды пайдаланыңыз.
Dialogue: 0,0:12:51.37,0:12:53.87,Default,,0000,0000,0000,,Бекер қарсылық көрсету.
Dialogue: 0,0:12:53.87,0:12:56.37,Default,,0000,0000,0000,,Өлтірілді.
Dialogue: 0,0:12:53.87,0:12:56.37,Default,,0000,0000,0000,,Хэхе! ?
Dialogue: 0,0:12:56.37,0:13:00.81,Default,,0000,0000,0000,,Жарайды. Төтенше жағдайда
Dialogue: 0,0:12:56.37,0:13:00.81,Default,,0000,0000,0000,,Чио-чанның әкесі...
Dialogue: 0,0:13:00.81,0:13:03.14,Default,,0000,0000,0000,,Әке?
Dialogue: 0,0:13:03.14,0:13:15.99,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:13:15.99,0:13:18.29,Default,,0000,0000,0000,,Эй, маған көмектес!
Dialogue: 0,0:13:21.83,0:13:24.33,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:13:24.33,0:13:28.00,Default,,0000,0000,0000,,Оның ұшып өтетініне сенімдімін.
Dialogue: 0,0:13:24.33,0:13:28.00,Default,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:13:28.00,0:13:31.50,Default,,0000,0000,0000,,Дабыр!
Dialogue: 0,0:13:28.00,0:13:31.50,Default,,0000,0000,0000,,Иә! ? Әке де! ?
Dialogue: 0,0:13:34.34,0:13:37.68,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:13:37.68,0:13:41.02,Default,,0000,0000,0000,,Хмм!
Dialogue: 0,0:13:37.68,0:13:41.02,Default,,0000,0000,0000,,(оқтардың тойтарыс беру дыбысы)
Dialogue: 0,0:13:41.02,0:13:45.02,Default,,0000,0000,0000,,Жарайды, мен кері қайттым.
Dialogue: 0,0:13:41.02,0:13:45.02,Default,,0000,0000,0000,,Өтірік! ?
Dialogue: 0,0:13:45.02,0:13:49.36,Default,,0000,0000,0000,,Бірақ Америкада оқу?
Dialogue: 0,0:13:45.02,0:13:49.36,Default,,0000,0000,0000,,Ата-анаң мақұлдады ма?
Dialogue: 0,0:13:49.36,0:13:53.03,Default,,0000,0000,0000,,Иә! Келіңіздер, білімдеріңізді кеңейтіңіздер
Dialogue: 0,0:13:49.36,0:13:53.03,Default,,0000,0000,0000,,Айтылды.
Dialogue: 0,0:13:53.03,0:13:56.20,Default,,0000,0000,0000,,«Сұлу бала саяхаттасын».
Dialogue: 0,0:13:56.20,0:13:59.20,Default,,0000,0000,0000,,Ах... Чиё-чан сүйкімді.
Dialogue: 0,0:13:59.20,0:14:02.80,Default,,0000,0000,0000,,Саяхат Жарайды!
Dialogue: 0,0:13:59.20,0:14:02.80,Default,,0000,0000,0000,,Хаха….
Dialogue: 0,0:14:02.80,0:14:05.47,Default,,0000,0000,0000,,Жарайды, егер бұл орын алса ше?
Dialogue: 0,0:14:02.80,0:14:05.47,Default,,0000,0000,0000,,Президент бол!
Dialogue: 0,0:14:05.47,0:14:09.64,Default,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:14:05.47,0:14:09.64,Default,,0000,0000,0000,,Американы Чио-чанның елі етейік!
Dialogue: 0,0:14:09.64,0:14:12.81,Default,,0000,0000,0000,,Онда маған Гавайи сияқты бірдеңе беріңіз.
Dialogue: 0,0:14:12.81,0:14:15.15,Default,,0000,0000,0000,,Сондықтан бұл мүмкін емес...
Dialogue: 0,0:14:15.15,0:14:19.99,Default,,0000,0000,0000,,Чио-чанның елі?
Dialogue: 0,0:14:15.15,0:14:19.99,Default,,0000,0000,0000,,Мен сонда барғым келеді...
Dialogue: 0,0:14:19.99,0:14:22.99,Default,,0000,0000,0000,,《Күнтізбе: мен тағы бір қызық нәрсе ойлап тұрмын》
Dialogue: 0,0:14:22.99,0:14:24.99,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:14:22.99,0:14:24.99,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:14:24.99,0:14:33.67,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:14:33.67,0:14:37.84,Default,,0000,0000,0000,,Мен... Америка.
Dialogue: 0,0:14:33.67,0:14:37.84,Default,,0000,0000,0000,,Сәлеметсіз бе!
Dialogue: 0,0:14:37.84,0:14:41.68,Default,,0000,0000,0000,,Сәлем Сәлем Сәлем Сәлем!
Dialogue: 0,0:14:41.68,0:14:45.35,Default,,0000,0000,0000,,Қош келдіңіз!
Dialogue: 0,0:14:41.68,0:14:45.35,Default,,0000,0000,0000,,Масита!
Dialogue: 0,0:14:45.35,0:14:48.68,Default,,0000,0000,0000,,Кішкентай Чиё-чан өте сүйкімді.
Dialogue: 0,0:14:48.68,0:14:51.02,Default,,0000,0000,0000,,(Чиби Чионың жүру дыбысы)
Dialogue: 0,0:14:51.02,0:14:54.69,Default,,0000,0000,0000,,Жүгіңді әкелейік.
Dialogue: 0,0:14:51.02,0:14:54.69,Default,,0000,0000,0000,,Шимашоу~.
Dialogue: 0,0:14:54.69,0:14:58.19,Default,,0000,0000,0000,,Солай ма? Үлкен уақыт.
Dialogue: 0,0:14:58.19,0:15:00.29,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,0:15:00.29,0:15:02.30,Default,,0000,0000,0000,,Машоу Машоу!
Dialogue: 0,0:15:02.30,0:15:04.80,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:15:08.14,0:15:12.81,Default,,0000,0000,0000,,Аа, Осака мырза, оны артта қалдырғаныңызға қуаныштысыз ба?
Dialogue: 0,0:15:12.81,0:15:15.48,Default,,0000,0000,0000,,Яғни
Dialogue: 0,0:15:12.81,0:15:15.48,Default,,0000,0000,0000,,Ол біраз уақыт оралмайды.
Dialogue: 0,0:15:15.48,0:15:18.15,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:15:15.48,0:15:18.15,Default,,0000,0000,0000,,Ахаха….
Dialogue: 0,0:15:18.15,0:15:20.48,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:15:20.48,0:15:23.15,Default,,0000,0000,0000,,Мына шошқа тоқаш
Dialogue: 0,0:15:20.48,0:15:23.15,Default,,0000,0000,0000,,Дәмді екен!
Dialogue: 0,0:15:23.15,0:15:25.15,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:15:25.15,0:15:27.15,Default,,0000,0000,0000,,Чио-чан дегеніміз не?
Dialogue: 0,0:15:25.15,0:15:27.15,Default,,0000,0000,0000,,Сіз бұл туралы көп білесіз.
Dialogue: 0,0:15:27.15,0:15:30.83,Default,,0000,0000,0000,,Эххе~.
Dialogue: 0,0:15:27.15,0:15:30.83,Default,,0000,0000,0000,,Пицца немесе гратин тоқаш жоқ па?
Dialogue: 0,0:15:30.83,0:15:32.83,Default,,0000,0000,0000,,Мұнда тек шошқа тоқаштары бар!
Dialogue: 0,0:15:32.83,0:15:35.50,Default,,0000,0000,0000,,Жарайды, біраз уақыт өтті.
Dialogue: 0,0:15:32.83,0:15:35.50,Default,,0000,0000,0000,,Мен бірдеңе сатып алып, үйге баруым керек пе?
Dialogue: 0,0:15:35.50,0:15:39.17,Default,,0000,0000,0000,,Сәлем! Эй.
Dialogue: 0,0:15:35.50,0:15:39.17,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:15:39.17,0:15:41.17,Default,,0000,0000,0000,,Жоқ, олай емес.
Dialogue: 0,0:15:41.17,0:15:44.34,Default,,0000,0000,0000,,Шошқа тоқаштары қантты пайдаланбайды.
Dialogue: 0,0:15:41.17,0:15:44.34,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:15:44.34,0:15:48.01,Default,,0000,0000,0000,,Бұл таңқаларлық
Dialogue: 0,0:15:44.34,0:15:48.01,Default,,0000,0000,0000,,Бұл ыңғайлы.
Dialogue: 0,0:15:48.01,0:15:50.34,Default,,0000,0000,0000,,(тамақтану дауысы)
Dialogue: 0,0:15:50.34,0:15:53.51,Default,,0000,0000,0000,,Әй, дәмді!
Dialogue: 0,0:15:50.34,0:15:53.51,Default,,0000,0000,0000,,Бұл өте дәмді.
Dialogue: 0,0:15:53.51,0:15:58.85,Default,,0000,0000,0000,,Бұл 100% сиыр еті! Міне осы!
Dialogue: 0,0:15:53.51,0:15:58.85,Default,,0000,0000,0000,,Шошқа шығар.
Dialogue: 0,0:15:58.85,0:16:00.96,Default,,0000,0000,0000,,Бұл дәмді болды.
Dialogue: 0,0:16:00.96,0:16:02.96,Default,,0000,0000,0000,,Өйткені шошқа тоқаштары негізгі болып табылады.
Dialogue: 0,0:16:02.96,0:16:05.29,Default,,0000,0000,0000,,Жоқ, мен такояки тоқаштарын да тастай алмаймын.
Dialogue: 0,0:16:05.29,0:16:09.30,Default,,0000,0000,0000,,Мен мұны ешқашан жеген емеспін.
Dialogue: 0,0:16:05.29,0:16:09.30,Default,,0000,0000,0000,,Ондай нәрсе бар ма?
Dialogue: 0,0:16:09.30,0:16:13.63,Default,,0000,0000,0000,,Бұл күндері бәрі болады!
Dialogue: 0,0:16:09.30,0:16:13.63,Default,,0000,0000,0000,,Чио-чанның сүйікті тағамы қандай?
Dialogue: 0,0:16:13.63,0:16:16.14,Default,,0000,0000,0000,,Акула жүзбегі?
Dialogue: 0,0:16:13.63,0:16:16.14,Default,,0000,0000,0000,,Бізде де акула жүзетін тоқаш бар!
Dialogue: 0,0:16:16.14,0:16:18.34,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:16:20.47,0:16:22.98,Default,,0000,0000,0000,,Га, тефтели!
Dialogue: 0,0:16:22.98,0:16:26.65,Default,,0000,0000,0000,,Уау, менің балам бар!
Dialogue: 0,0:16:22.98,0:16:26.65,Default,,0000,0000,0000,,Мен бала емеспін!
Dialogue: 0,0:16:26.65,0:16:28.98,Default,,0000,0000,0000,,♬ «Балалар ~ Балалар балалар ~»
Dialogue: 0,0:16:28.98,0:16:31.78,Default,,0000,0000,0000,,Сонымен Томо-чанға не ұнайды?
Dialogue: 0,0:16:28.98,0:16:31.78,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:35.16,0:16:38.16,Default,,0000,0000,0000,,Ах! Мүмкін банан!
Dialogue: 0,0:16:38.16,0:16:42.33,Default,,0000,0000,0000,,Уау, мында бір ақымақ бар!
Dialogue: 0,0:16:38.16,0:16:42.33,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:16:42.33,0:16:44.33,Default,,0000,0000,0000,,Чиёчан!
Dialogue: 0,0:16:44.33,0:16:48.50,Default,,0000,0000,0000,,Сүтті Юка-чан!
Dialogue: 0,0:16:44.33,0:16:48.50,Default,,0000,0000,0000,,Кім?
Dialogue: 0,0:16:48.50,0:16:52.01,Default,,0000,0000,0000,,Бастауыш сыныптағы менің сыныптасым!
Dialogue: 0,0:16:52.01,0:16:54.34,Default,,0000,0000,0000,,Сәлеметсіз бе.
Dialogue: 0,0:16:54.34,0:16:57.01,Default,,0000,0000,0000,,Чио-чан да орта мектеп оқушысы ма?
Dialogue: 0,0:16:57.01,0:17:00.45,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Мен орта мектеп оқушысымын.
Dialogue: 0,0:17:00.45,0:17:03.62,Default,,0000,0000,0000,,Қараңдаршы, біз де.
Dialogue: 0,0:17:00.45,0:17:03.62,Default,,0000,0000,0000,,Мен матрос формасын киемін.
Dialogue: 0,0:17:03.62,0:17:07.29,Default,,0000,0000,0000,,Уау~ Мен бұны бұрын киіп көрмеппін.
Dialogue: 0,0:17:07.29,0:17:09.62,Default,,0000,0000,0000,,Бірақ мен де
Dialogue: 0,0:17:07.29,0:17:09.62,Default,,0000,0000,0000,,Чио-чан және мына форма➡
Dialogue: 0,0:17:09.62,0:17:12.29,Default,,0000,0000,0000,,Мен оны кие алмаймын. Ол қиын.
Dialogue: 0,0:17:12.29,0:17:14.63,Default,,0000,0000,0000,,Әркім оқи алады.
Dialogue: 0,0:17:14.63,0:17:17.47,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:17:14.63,0:17:17.47,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:17:17.47,0:17:21.80,Default,,0000,0000,0000,,Біздің мектепте еркін рух бар.
Dialogue: 0,0:17:17.47,0:17:21.80,Default,,0000,0000,0000,,Босаңсып, сәтсіздікке ұшырайтын адамдар көп.
Dialogue: 0,0:17:21.80,0:17:25.14,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:17:21.80,0:17:25.14,Default,,0000,0000,0000,,Бұл мен емес.
Dialogue: 0,0:17:25.14,0:17:29.31,Default,,0000,0000,0000,,Кейбір адамдар Токио университетіне барады
Dialogue: 0,0:17:25.14,0:17:29.31,Default,,0000,0000,0000,,Кейбір адамдар ешқайда бара алмайды.
Dialogue: 0,0:17:29.31,0:17:31.51,Default,,0000,0000,0000,,Бұл мен емес.
Dialogue: 0,0:17:34.32,0:17:36.48,Default,,0000,0000,0000,,Сау болыңыз.
Dialogue: 0,0:17:34.32,0:17:36.48,Default,,0000,0000,0000,,Сонда кездескенше.
Dialogue: 0,0:17:36.48,0:17:38.58,Default,,0000,0000,0000,,Қош бол!
Dialogue: 0,0:17:41.49,0:17:43.49,Default,,0000,0000,0000,,Күткеніңізге рахмет!
Dialogue: 0,0:17:43.49,0:17:46.83,Default,,0000,0000,0000,,(Қарғаның айқайы)
Dialogue: 0,0:17:46.83,0:17:50.00,Default,,0000,0000,0000,,Мен емеспін, солай ма?
Dialogue: 0,0:17:46.83,0:17:50.00,Default,,0000,0000,0000,,Солай дегің келе ме? Кешір мені.
Dialogue: 0,0:17:50.00,0:17:59.01,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:17:59.01,0:18:01.01,Default,,0000,0000,0000,,Енді міне...
Dialogue: 0,0:18:02.94,0:18:05.24,Default,,0000,0000,0000,,Каорин.
Dialogue: 0,0:18:02.94,0:18:05.24,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:18:07.45,0:18:09.95,Default,,0000,0000,0000,,Каорин
Dialogue: 0,0:18:07.45,0:18:09.95,Default,,0000,0000,0000,,Өтінемін, айтпаңыз...
Dialogue: 0,0:18:09.95,0:18:13.12,Default,,0000,0000,0000,,Өйткені мұны бәрі айтып жатыр!
Dialogue: 0,0:18:13.12,0:18:16.82,Default,,0000,0000,0000,,Сондықтан~ Неге мен жалғызбын?
Dialogue: 0,0:18:13.12,0:18:16.82,Default,,0000,0000,0000,,Бұл лақап ат па?
Dialogue: 0,0:18:19.29,0:18:22.96,Default,,0000,0000,0000,,Сосын... мен туралы да.
Dialogue: 0,0:18:19.29,0:18:22.96,Default,,0000,0000,0000,,Кимлин деп айтуға болады.
Dialogue: 0,0:18:22.96,0:18:24.97,Default,,0000,0000,0000,,Да~кара~ра~!
Dialogue: 0,0:18:28.97,0:18:31.31,Default,,0000,0000,0000,,Е, Каорин, сен төраға болдың ба?
Dialogue: 0,0:18:31.31,0:18:34.64,Default,,0000,0000,0000,,Дәлірек айтқанда, ол болды
Dialogue: 0,0:18:31.31,0:18:34.64,Default,,0000,0000,0000,,Сіз мені оқытылдым деп айта аласыз.
Dialogue: 0,0:18:34.64,0:18:36.64,Default,,0000,0000,0000,,Сіз мені қорлайсыз ба?
Dialogue: 0,0:18:36.64,0:18:40.64,Default,,0000,0000,0000,,Менің ойымша, бұл қорлаудың керісінше...
Dialogue: 0,0:18:36.64,0:18:40.64,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:45.65,0:18:47.99,Default,,0000,0000,0000,,Ал, кандидатура
Dialogue: 0,0:18:45.65,0:18:47.99,Default,,0000,0000,0000,,Біреуі жоқ сияқты➡
Dialogue: 0,0:18:47.99,0:18:50.49,Default,,0000,0000,0000,,Мен ұсыныстар негізінде шешім қабылдағым келеді.
Dialogue: 0,0:18:50.49,0:18:52.99,Default,,0000,0000,0000,,Комитетті басқаратын адам
Dialogue: 0,0:18:50.49,0:18:52.99,Default,,0000,0000,0000,,Сіздің ұсыныстарыңыз бар ма?
Dialogue: 0,0:18:52.99,0:18:55.59,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:18:52.99,0:18:55.59,Default,,0000,0000,0000,,Менің ойымша, Каорин керемет!
Dialogue: 0,0:18:57.67,0:18:59.87,Default,,0000,0000,0000,,Тағы бірдеңе бар ма?
Dialogue: 0,0:19:02.27,0:19:05.77,Default,,0000,0000,0000,,Кимура маған ұнады.
Dialogue: 0,0:19:02.27,0:19:05.77,Default,,0000,0000,0000,,Бұл қорлаудан артық па? ?
Dialogue: 0,0:19:10.61,0:19:12.81,Default,,0000,0000,0000,,күрсіну...
Dialogue: 0,0:19:17.45,0:19:21.79,Default,,0000,0000,0000,,Мен келесі жылы Кимурамен бірге боламын...
Dialogue: 0,0:19:17.45,0:19:21.79,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:21.79,0:19:26.96,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:19:26.96,0:19:29.13,Default,,0000,0000,0000,,Күрсін... Күрсін!
Dialogue: 0,0:19:29.13,0:19:33.30,Default,,0000,0000,0000,,Сакаки-сан өте керемет.
Dialogue: 0,0:19:33.30,0:19:59.99,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:19:59.99,0:20:03.83,Default,,0000,0000,0000,,Қалай... неге?
Dialogue: 0,0:19:59.99,0:20:03.83,Default,,0000,0000,0000,,Мен басқа сыныптағы жалғыз адаммын!
Dialogue: 0,0:20:03.83,0:20:05.83,Default,,0000,0000,0000,,(котенка мияу)
Dialogue: 0,0:20:09.00,0:20:11.60,Default,,0000,0000,0000,,《Мен де бүгін көрдім...》
Dialogue: 0,0:20:14.84,0:20:17.68,Default,,0000,0000,0000,,《Сакаки: Мен бақыттымын...》
Dialogue: 0,0:20:17.68,0:20:21.68,Default,,0000,0000,0000,,(қатты тыныс алу)
Dialogue: 0,0:20:21.68,0:20:26.52,Default,,0000,0000,0000,,Қалай… неге?
Dialogue: 0,0:20:21.68,0:20:26.52,Default,,0000,0000,0000,,Мен басқа сыныптағы жалғыз адаммын!
Dialogue: 0,0:20:26.52,0:20:29.52,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:20:26.52,0:20:29.52,Default,,0000,0000,0000,,Ум...
Dialogue: 0,0:20:26.52,0:20:29.52,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:20:29.52,0:20:33.86,Default,,0000,0000,0000,,Ум, қызметкерлер бөлмесінде.
Dialogue: 0,0:20:29.52,0:20:33.86,Default,,0000,0000,0000,,Қалай жүруім керек?
Dialogue: 0,0:20:33.86,0:20:36.20,Default,,0000,0000,0000,,《Кимураның әйелі...》
Dialogue: 0,0:20:36.20,0:20:38.37,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:20:38.37,0:20:41.37,Default,,0000,0000,0000,,Күйеуім түскі ас әкелді.
Dialogue: 0,0:20:38.37,0:20:41.37,Default,,0000,0000,0000,,Мен ұмытып қалдым.
Dialogue: 0,0:20:41.37,0:20:43.37,Default,,0000,0000,0000,,Бұл таңқаларлықтай алаңдататын сияқты.
Dialogue: 0,0:20:43.37,0:20:45.54,Default,,0000,0000,0000,,《Әйелі Бентоны жақсы көр! 》
Dialogue: 0,0:20:45.54,0:20:49.54,Default,,0000,0000,0000,,Мен мұнда бұрын болғанмын.
Dialogue: 0,0:20:45.54,0:20:49.54,Default,,0000,0000,0000,,Мен есімде жоқ.
Dialogue: 0,0:20:49.54,0:20:52.21,Default,,0000,0000,0000,,Сол жерден қызметкерлер бөлмесіне кіріңіз➡
Dialogue: 0,0:20:52.21,0:20:55.05,Default,,0000,0000,0000,,Дереу баспалдақпен жоғары көтеріліңіз
Dialogue: 0,0:20:52.21,0:20:55.05,Default,,0000,0000,0000,,Бұл екінші қабаттың артқы жағында.
Dialogue: 0,0:20:55.05,0:20:57.35,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:20:59.39,0:21:02.32,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:20:59.39,0:21:02.32,Default,,0000,0000,0000,,Ух... уф.
Dialogue: 0,0:20:59.39,0:21:02.32,Default,,0000,0000,0000,,(жарылған дыбыс)
Dialogue: 0,0:21:02.32,0:21:04.49,Default,,0000,0000,0000,,《Қандай жақсы адам~》
Dialogue: 0,0:21:04.49,0:21:08.33,Default,,0000,0000,0000,,Дұрыс, сондай жақсы адам.
Dialogue: 0,0:21:04.49,0:21:08.33,Default,,0000,0000,0000,,Мен сенің әйелің боламын➡
Dialogue: 0,0:21:08.33,0:21:11.67,Default,,0000,0000,0000,,Сондай-ақ Кимура мырзаға
Dialogue: 0,0:21:08.33,0:21:11.67,Default,,0000,0000,0000,,Бұл жерде жақсы нәрсе болуы керек!
Dialogue: 0,0:21:11.67,0:21:14.17,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:14.17,0:21:16.67,Default,,0000,0000,0000,,Биылғы жылы
Dialogue: 0,0:21:14.17,0:21:16.67,Default,,0000,0000,0000,,Кимура мырза менің сынып жетекшім➡
Dialogue: 0,0:21:16.67,0:21:19.34,Default,,0000,0000,0000,,Жақсы жер тауып алайық! иә?
Dialogue: 0,0:21:19.34,0:21:23.34,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:23.34,0:21:26.84,Default,,0000,0000,0000,,《Гүлзарға күтім жасау?
Dialogue: 0,0:21:23.34,0:21:26.84,Default,,0000,0000,0000,,Ондай жағы да бар~》
Dialogue: 0,0:21:28.85,0:21:30.85,Default,,0000,0000,0000,,Сәлем Каорин.
Dialogue: 0,0:21:30.85,0:21:34.36,Default,,0000,0000,0000,,Ах хаха...
Dialogue: 0,0:21:30.85,0:21:34.36,Default,,0000,0000,0000,,Мұғалім, сіз гүлдерге күтім жасайсыз ба?
Dialogue: 0,0:21:34.36,0:21:36.36,Default,,0000,0000,0000,,Қандай гүлдер...эй! ?
Dialogue: 0,0:21:39.86,0:21:43.86,Default,,0000,0000,0000,,Жақсы нәрсе ...
Dialogue: 0,0:21:39.86,0:21:43.86,Default,,0000,0000,0000,,Қандай жақсы нәрсе...
Dialogue: 0,0:21:39.86,0:21:43.86,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:43.86,0:21:46.86,Default,,0000,0000,0000,,Сіз оны таба аласыз ба? !
Dialogue: 0,0:21:48.36,0:21:54.36,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory