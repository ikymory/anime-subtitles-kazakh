Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.83,0:00:07.30,Default,,0,0,0,,Лу Ла Лу Ла Пианино - әлемдік
Dialogue: 0,0:00:07.33,0:00:10.81,Default,,0,0,0,,Арман гүлдеген далада әуен
Dialogue: 0,0:00:10.84,0:00:14.27,Default,,0,0,0,,Сынған сағатқа сену
Dialogue: 0,0:00:14.30,0:00:17.73,Default,,0,0,0,,Уақыт сенің жаныңда кім?
Dialogue: 0,0:00:17.76,0:00:21.10,Default,,0,0,0,,Менің кеудем неге үлкен?
Dialogue: 0,0:00:21.31,0:00:24.72,Default,,0,0,0,,Сіз мейірімді адамды күтесіз бе?
Dialogue: 0,0:00:24.80,0:00:28.29,Default,,0,0,0,,Маған тамаша болашағыңыз туралы айтып беріңіз
Dialogue: 0,0:00:28.32,0:00:28.99,Default,,0,0,0,,Ай
Dialogue: 0,0:00:29.08,0:00:29.84,Default,,0,0,0,,Жарық
Dialogue: 0,0:00:29.96,0:00:31.70,Default,,0,0,0,,Ай сәулесі ұйықтап жатыр
Dialogue: 0,0:00:31.73,0:00:35.27,Default,,0,0,0,,Лу Ла Лу Ла Есте сақтау алмасына
Dialogue: 0,0:00:35.30,0:00:38.64,Default,,0,0,0,,Оянған қыз мені сүйеді
Dialogue: 0,0:00:38.68,0:00:42.19,Default,,0,0,0,,Азаппен жайылған кітапта
Dialogue: 0,0:00:42.22,0:00:45.46,Default,,0,0,0,,Екі қоңырау соғылады
Dialogue: 0,0:00:45.61,0:00:48.90,Default,,0,0,0,,Мен жақсы көретін адам, өйткені мен оны құшақтағым келеді
Dialogue: 0,0:00:49.14,0:00:52.67,Default,,0,0,0,,Енді жылама Қош бол қайғы
Dialogue: 0,0:00:52.69,0:00:56.17,Default,,0,0,0,,Жұмбақ есіктегі жазу
Dialogue: 0,0:00:56.20,0:00:59.61,Default,,0,0,0,,«Сорамими торты»
Dialogue: 0,0:00:59.63,0:01:00.94,Default,,0,0,0,,Ғажайыптар әлемі!
Dialogue: 0,0:01:00.97,0:01:02.69,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:01:02.72,0:01:04.01,Default,,0,0,0,,Ертегілер елі!
Dialogue: 0,0:01:04.04,0:01:05.68,Default,,0,0,0,,Бұл махаббаттың сиқыры
Dialogue: 0,0:01:05.71,0:01:07.02,Default,,0,0,0,,Махаббат бәрібір!
Dialogue: 0,0:01:07.05,0:01:08.80,Default,,0,0,0,,Күн сайын үлпілдек
Dialogue: 0,0:01:08.83,0:01:12.29,Default,,0,0,0,,Бидайдың азғыруы
Dialogue: 0,0:01:12.32,0:01:13.59,Default,,0,0,0,,Сізге арналған торт!
Dialogue: 0,0:01:13.62,0:01:15.32,Default,,0,0,0,,Бүгін кешке тамақтаныңыз.
Dialogue: 0,0:01:15.34,0:01:16.66,Default,,0,0,0,,Сізге шай!
Dialogue: 0,0:01:16.69,0:01:18.38,Default,,0,0,0,,Шоқжұлдыз шай ішу
Dialogue: 0,0:01:18.40,0:01:19.69,Default,,0,0,0,,Терезеде
Dialogue: 0,0:01:19.72,0:01:21.46,Default,,0,0,0,,Періштелер хоры
Dialogue: 0,0:01:21.49,0:01:24.87,Default,,0,0,0,,Құлағыңыз бос па?
Dialogue: 0,0:01:24.90,0:01:28.46,Default,,0,0,0,,Мен сені сүйемін, мен сені сүйемін дауыс
Dialogue: 0,0:01:31.89,0:01:33.39,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:01:35.50,0:01:37.76,Default,,0,0,0,,Бұл не, Куросава мырза?
Dialogue: 0,0:01:38.18,0:01:38.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:38.60,0:01:39.85,Default,,0,0,0,,А Чио-чан
Dialogue: 0,0:01:39.90,0:01:41.90,Default,,0,0,0,,Сізді шақырғаным үшін кешіріңіз.
Dialogue: 0,0:01:44.81,0:01:46.81,Default,,0,0,0,,Мен оны жаңа ғана алдым.
Dialogue: 0,0:01:47.84,0:01:50.12,Default,,0,0,0,,Иә Чио Чанның купальнигі
Dialogue: 0,0:01:50.40,0:01:51.64,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:01:52.81,0:01:54.54,Default,,0,0,0,,Рахмет
Dialogue: 0,0:01:54.66,0:01:56.58,Default,,0,0,0,,Купальниктерге тапсырыс беруге болады.
Dialogue: 0,0:01:56.64,0:01:59.07,Default,,0,0,0,,Бассейндерді тапсырыс бойынша жасауға болмайтынын ескеріңіз.
Dialogue: 0,0:01:59.24,0:02:01.05,Default,,0,0,0,,Мұндағы бассейн терең.
Dialogue: 0,0:02:01.49,0:02:01.97,Default,,0,0,0,,Иә
Dialogue: 0,0:02:02.00,0:02:03.46,Default,,0,0,0,,Мияу
Dialogue: 0,0:02:03.48,0:02:06.71,Default,,0,0,0,,Бүгін сабақтан кейін сусын ішейік.
Dialogue: 0,0:02:06.74,0:02:09.41,Default,,0,0,0,,Енді вокзал алдындағы изакая Йоччанда.
Dialogue: 0,0:02:09.43,0:02:11.64,Default,,0,0,0,,Нямононың сүйікті құйма сырасы
Dialogue: 0,0:02:11.66,0:02:14.56,Default,,0,0,0,,Әйелдер күнінде Гатон 150 иен
Dialogue: 0,0:02:14.65,0:02:17.57,Default,,0,0,0,,Көрдіңіз бе, біз қазір маңызды нәрсе туралы айтып жатырмыз.
Dialogue: 0,0:02:17.59,0:02:18.97,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:02:19.00,0:02:20.94,Default,,0,0,0,,Мен байсалды емеспін.
Dialogue: 0,0:02:20.94,0:02:22.06,Default,,0,0,0,,Денсаулыққа зиян
Dialogue: 0,0:02:22.08,0:02:23.20,Default,,0,0,0,,О? Біреуге ғашық болдың ба?
Dialogue: 0,0:02:23.28,0:02:26.17,Default,,0,0,0,,Мм... Нямо деген не?
Dialogue: 0,0:02:26.26,0:02:29.32,Default,,0,0,0,,Ах, Минамо Куросава, сондықтан Нямо
Dialogue: 0,0:02:29.34,0:02:31.08,Default,,0,0,0,,Бұл менің студент кезімнен лақап атым.
Dialogue: 0,0:02:31.11,0:02:32.17,Default,,0,0,0,,О
Dialogue: 0,0:02:32.41,0:02:35.32,Default,,0,0,0,,Мектепте олай айтпа деді.
Dialogue: 0,0:02:35.80,0:02:37.70,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:02:39.11,0:02:42.07,Default,,0,0,0,,Бұл сіз, бәрібір, егер ол жеке болса.
Dialogue: 0,0:02:42.18,0:02:44.22,Default,,0,0,0,,Мектепте әдепті болу
Dialogue: 0,0:02:44.24,0:02:46.04,Default,,0,0,0,,Мен бұл үстелге не істеуім керек?
Dialogue: 0,0:02:46.62,0:02:49.90,Default,,0,0,0,,Жарайды, мен мұны қазір реттедім.
Dialogue: 0,0:02:50.14,0:02:52.54,Default,,0,0,0,,Мен барлығының қайда екенін нақты білемін.
Dialogue: 0,0:02:53.13,0:02:55.42,Default,,0,0,0,,Олай болса, маған өткен күні берген жапон сөздігін қайтарып беріңізші.
Dialogue: 0,0:02:55.44,0:02:57.09,Default,,0,0,0,,О, кешіріңіз, кешіріңіз
Dialogue: 0,0:02:57.12,0:02:59.35,Default,,0,0,0,,Ум сөздік...
Dialogue: 0,0:02:59.37,0:03:00.00,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:01.60,0:03:04.22,Default,,0,0,0,,Уау, бұл қауіпті!
Dialogue: 0,0:03:07.08,0:03:09.38,Default,,0,0,0,,Маған көмектесіп тұра берме!
Dialogue: 0,0:03:10.39,0:03:12.54,Default,,0,0,0,,Чиё-чан Чиё-чан, жақсысың ба?
Dialogue: 0,0:03:17.04,0:03:20.73,Default,,0,0,0,,Юкари-сенсэй, тазалаңызшы! Өтінемін, тазалаңыз!
Dialogue: 0,0:03:20.76,0:03:22.30,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:03:22.78,0:03:23.88,Default,,0,0,0,,Ах, Чио-чан!
Dialogue: 0,0:03:24.53,0:03:25.39,Default,,0,0,0,,… өтіңіз.
Dialogue: 0,0:03:26.08,0:03:30.18,Default,,0,0,0,,Куросава-сенсэй мен Юкари-сенсэй сыныптас болды.
Dialogue: 0,0:03:30.42,0:03:34.11,Default,,0,0,0,,Иә, ол осы мектептің түлегі болса керек.
Dialogue: 0,0:03:34.14,0:03:37.59,Default,,0,0,0,,Сыныптас болсақ, сенен жақсымыз.
Dialogue: 0,0:03:37.62,0:03:39.04,Default,,0,0,0,,Не болды?
Dialogue: 0,0:03:39.23,0:03:42.39,Default,,0,0,0,,Фуфуфуфу Шын мәнінде, мен және Коёми
Dialogue: 0,0:03:42.41,0:03:45.10,Default,,0,0,0,,Біз бастауыш сыныптан бері біргеміз!
Dialogue: 0,0:03:45.12,0:03:47.16,Default,,0,0,0,,О, бұл керемет.
Dialogue: 0,0:03:47.44,0:03:50.80,Default,,0,0,0,,Бастауыш сыныптан бері жанымда ешкім болған емес.
Dialogue: 0,0:03:51.77,0:03:53.36,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:03:53.70,0:03:54.80,Default,,0,0,0,,Эй
Dialogue: 0,0:03:54.82,0:03:57.23,Default,,0,0,0,,Сондықтан мен сізді танымаймын
Dialogue: 0,0:03:57.26,0:04:00.08,Default,,0,0,0,,Ол да күнтізбенің көп сырын біледі!
Dialogue: 0,0:04:00.26,0:04:01.22,Default,,0,0,0,,(Балалардың шуы)
Dialogue: 0,0:04:01.38,0:04:03.10,Default,,0,0,0,,Күте тұрыңыз! Не айтайын деп жатырсың?
Dialogue: 0,0:04:04.18,0:04:06.54,Default,,0,0,0,,Қорқынышты көгерудегі оқиға
Dialogue: 0,0:04:06.81,0:04:07.54,Default,,0,0,0,,Қалып?
Dialogue: 0,0:04:08.18,0:04:09.04,Default,,0,0,0,,Нан?
Dialogue: 0,0:04:09.60,0:04:10.91,Default,,0,0,0,,Бастауыш мектеп
Dialogue: 0,0:04:10.93,0:04:14.21,Default,,0,0,0,,Коёмидің үстелінде қалған нандары шіріп кетті.
Dialogue: 0,0:04:14.23,0:04:16.37,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:04:16.40,0:04:16.95,Default,,0,0,0,,Манга салмас бұрын жаттығулар
Dialogue: 0,0:04:16.98,0:04:20.59,Default,,0,0,0,,Енді сол мольде интеллект бар, бұл үлкен мәселе!
Dialogue: 0,0:04:20.76,0:04:23.06,Default,,0,0,0,,Біз ғылым дайындайтын бөлмеде тосқауыл қойдық.
Dialogue: 0,0:04:23.08,0:04:24.59,Default,,0,0,0,,Қолдағы спирт шамы
Dialogue: 0,0:04:24.62,0:04:27.08,Default,,0,0,0,,Біз зең тобына шабуыл жасадық!
Dialogue: 0,0:04:27.10,0:04:27.79,Default,,0,0,0,,О
Dialogue: 0,0:04:28.00,0:04:29.64,Default,,0,0,0,,Ачио-чан, кеттік.
Dialogue: 0,0:04:29.67,0:04:32.26,Default,,0,0,0,,Сол кезде менде эпифания болды.
Dialogue: 0,0:04:32.64,0:04:35.66,Default,,0,0,0,,Сізге тек дәретханадағы зеңді кетіргіш қажет
Dialogue: 0,0:04:35.68,0:04:37.72,Default,,0,0,0,,Оларды жеңуге болады
Dialogue: 0,0:04:37.96,0:04:38.72,Default,,0,0,0,,О
Dialogue: 0,0:04:39.16,0:04:43.17,Default,,0,0,0,,Не, көгерген рух туралы әңгіме өтірік болды ма?
Dialogue: 0,0:04:43.33,0:04:45.34,Default,,0,0,0,,Неліктен бұл дұрыс деп ойлайсыз?
Dialogue: 0,0:04:45.36,0:04:47.96,Default,,0,0,0,,Мен шындықтың бұлыңғыр сезімін сезіндім.
Dialogue: 0,0:04:48.00,0:04:50.74,Default,,0,0,0,,Дұрыс. Ол шынайы оқиғаға негізделген.
Dialogue: 0,0:04:50.79,0:04:52.09,Default,,0,0,0,,Соның негізінде!
Dialogue: 0,0:04:52.83,0:04:54.43,Default,,0,0,0,,Аа, Куросава мырза!
Dialogue: 0,0:04:55.12,0:04:56.20,Default,,0,0,0,,Куросава мырза!
Dialogue: 0,0:04:57.18,0:04:57.75,Default,,0,0,0,,Не?
Dialogue: 0,0:04:58.26,0:04:59.73,Default,,0,0,0,,Куросава мырза кім?
Dialogue: 0,0:04:59.75,0:05:02.28,Default,,0,0,0,,Юкари-чанмен сыныптас болдың, солай ма?
Dialogue: 0,0:05:02.74,0:05:03.84,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:05:03.94,0:05:07.40,Default,,0,0,0,,Юкари-сенсэй қандай оқушы болды?
Dialogue: 0,0:05:07.56,0:05:10.00,Default,,0,0,0,,Хмм, иә...
Dialogue: 0,0:05:11.45,0:05:14.01,Default,,0,0,0,,Жарайды, әртүрлі анекдоттар бар.
Dialogue: 0,0:05:14.04,0:05:18.87,Default,,0,0,0,,Махаббат хаты ла ла ла ла махаббат махаббат махаббат хаты
Dialogue: 0,0:05:18.90,0:05:23.14,Default,,0,0,0,,Махаббат хаты Махаббат хаты Махаббат махаббат махаббат махаббат хаты
Dialogue: 0,0:05:23.16,0:05:26.64,Default,,0,0,0,,Махаббат Лала Махаббат Махаббат махаббат хаты
Dialogue: 0,0:05:26.66,0:05:29.93,Default,,0,0,0,,Менің ойымша, ол қарапайым студент еді.
Dialogue: 0,0:05:32.60,0:05:34.47,Default,,0,0,0,,Сіз бірдеңе ұстайсыз ба...
Dialogue: 0,0:05:41.29,0:05:42.98,Default,,0,0,0,,Эй, бұл сен...
Dialogue: 0,0:05:43.00,0:05:45.75,Default,,0,0,0,,Сізге кімді ұнатасыз, Куросава-сенсэй ме, әлде Юкари-сенсэй ме?
Dialogue: 0,0:05:45.79,0:05:47.68,Default,,0,0,0,,Әрине!
Dialogue: 0,0:05:49.48,0:05:51.01,Default,,0,0,0,,Бұл Юкари Сенсей.
Dialogue: 0,0:05:52.43,0:05:54.48,Default,,0,0,0,,Не, сен түрлі-түсті адамсың ба?
Dialogue: 0,0:05:54.48,0:05:56.30,Default,,0,0,0,,Юкари-чан әлдеқайда жақсырақ
Dialogue: 0,0:05:56.32,0:05:56.77,Default,,0,0,0,,Гухаа
Dialogue: 0,0:05:59.70,0:06:03.56,Default,,0,0,0,,Олай болса, Куросава мырзамен кеңесіңіз.
Dialogue: 0,0:06:03.69,0:06:05.02,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:06:05.05,0:06:07.51,Default,,0,0,0,,Мүмкін, Куросава-сенсэй түсінетін шығар.
Dialogue: 0,0:06:07.53,0:06:10.91,Default,,0,0,0,,Сізге еркін сөйлесе алатын мұғалім керек емес пе?
Dialogue: 0,0:06:12.03,0:06:13.39,Default,,0,0,0,,Бұл сізге керек емес пе?
Dialogue: 0,0:06:14.98,0:06:16.76,Default,,0,0,0,,Бұл қазірдің өзінде мысық
Dialogue: 0,0:06:16.78,0:06:19.06,Default,,0,0,0,,Неліктен ол соншалықты танымал?
Dialogue: 0,0:06:21.92,0:06:23.08,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:06:23.42,0:06:24.04,Default,,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:06:24.06,0:06:26.65,Default,,0,0,0,,Куросава мырза, міне, міне!
Dialogue: 0,0:06:27.17,0:06:28.70,Default,,0,0,0,,Хаха мен көрдім.
Dialogue: 0,0:06:29.93,0:06:31.41,Default,,0,0,0,,Себет! !
Dialogue: 0,0:06:31.74,0:06:32.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:33.48,0:06:35.42,Default,,0,0,0,,Қазір баскетбол уақыты!
Dialogue: 0,0:06:35.66,0:06:39.07,Default,,0,0,0,,Ұстазбен бірге жастықтың терін төкейік!
Dialogue: 0,0:06:39.35,0:06:42.19,Default,,0,0,0,,Енді барлығы спортзалға жиналды~!
Dialogue: 0,0:06:46.12,0:06:47.41,Default,,0,0,0,,Жинаңыз! !
Dialogue: 0,0:06:50.84,0:06:52.34,Default,,0,0,0,,Юкари командасы!
Dialogue: 0,0:06:52.55,0:06:53.63,Default,,0,0,0,,О
Dialogue: 0,0:06:53.92,0:06:55.44,Default,,0,0,0,,Теңіз қиярының командасы
Dialogue: 0,0:06:57.11,0:06:57.91,Default,,0,0,0,,Неге...
Dialogue: 0,0:06:58.12,0:06:59.32,Default,,0,0,0,,Теңіз қияры дегеніміз не? …
Dialogue: 0,0:07:02.38,0:07:04.00,Default,,0,0,0,,Теңіз қиярының командасы
Dialogue: 0,0:07:04.17,0:07:05.23,Default,,0,0,0,,О
Dialogue: 0,0:07:05.88,0:07:06.75,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:07:06.77,0:07:10.20,Default,,0,0,0,,Бір ойында кім бірінші жеңсе, сол жеңеді делік.
Dialogue: 0,0:07:11.13,0:07:14.58,Default,,0,0,0,,Сонымен қатар, жеңілген адам шырын сатып алады.
Dialogue: 0,0:07:14.61,0:07:15.42,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:07:15.55,0:07:16.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:16.38,0:07:17.98,Default,,0,0,0,,Бәс тігуді қалайсыз ба?
Dialogue: 0,0:07:18.00,0:07:20.19,Default,,0,0,0,,Мұғалім бәс тігуге бола ма?
Dialogue: 0,0:07:20.52,0:07:22.83,Default,,0,0,0,,Егер сіз бәс тікпесеңіз, бұл қызықты болмайды.
Dialogue: 0,0:07:23.33,0:07:25.36,Default,,0,0,0,,Әдетте сыйлық болмаса да
Dialogue: 0,0:07:25.38,0:07:27.62,Default,,0,0,0,,Сіз жаттығу жасай аласыз ба?
Dialogue: 0,0:07:35.93,0:07:36.55,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:37.94,0:07:39.84,Default,,0,0,0,,Шаа! Келесі барайық!
Dialogue: 0,0:07:48.61,0:07:51.46,Default,,0,0,0,,Үлпілдек! Жақында келеді!
Dialogue: 0,0:07:52.41,0:07:53.66,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:07:53.69,0:07:55.73,Default,,0,0,0,,Бұлай жалғаса берсе, біз жеңеміз.
Dialogue: 0,0:07:56.73,0:07:57.71,Default,,0,0,0,,Юкари!
Dialogue: 0,0:07:57.94,0:08:00.29,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:08:01.82,0:08:04.43,Default,,0,0,0,,Чио-чан, ойыншыларды ауыстырамыз ба?
Dialogue: 0,0:08:04.54,0:08:05.36,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:06.44,0:08:09.54,Default,,0,0,0,,Қулық! Мұғалім кіріп келеді
Dialogue: 0,0:08:09.71,0:08:11.65,Default,,0,0,0,,Сіз де мұғалімсіз, солай ма?
Dialogue: 0,0:08:11.68,0:08:13.48,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:08:13.50,0:08:15.73,Default,,0,0,0,,Сіз дене шынықтыру пәнінің мұғалімі болуыңыз керек.
Dialogue: 0,0:08:16.24,0:08:16.86,Default,,0,0,0,,Бұл
Dialogue: 0,0:08:20.05,0:08:21.76,Default,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,0:08:21.78,0:08:23.31,Default,,0,0,0,,Мен оны тоқтатамын!
Dialogue: 0,0:08:24.42,0:08:25.57,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:08:25.77,0:08:27.88,Default,,0,0,0,,Гияа! Маған істеуге рұқсат етіңіз!
Dialogue: 0,0:08:38.16,0:08:39.28,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:40.16,0:08:42.61,Default,,0,0,0,,Куросава сенси керемет!
Dialogue: 0,0:08:42.77,0:08:44.94,Default,,0,0,0,,Дене шынықтыру мұғалімі күткендей.
Dialogue: 0,0:08:45.50,0:08:47.41,Default,,0,0,0,,Мен орта мектепте оқып жүрген кезімде, аздап.
Dialogue: 0,0:08:48.32,0:08:50.77,Default,,0,0,0,,Өйткені, оны дұрыс орындаған адамдар әртүрлі.
Dialogue: 0,0:08:51.73,0:08:53.36,Default,,0,0,0,,Өйткені адам аз
Dialogue: 0,0:08:53.39,0:08:55.83,Default,,0,0,0,,Мен жаңа ғана екінші жұмыспен келдім.
Dialogue: 0,0:08:55.89,0:08:57.25,Default,,0,0,0,,Бұл дәл сен күткендей.
Dialogue: 0,0:08:57.27,0:09:00.19,Default,,0,0,0,,Оның жылдам қозғалғаны сонша, мен оны мүлдем көрмедім.
Dialogue: 0,0:09:00.22,0:09:02.93,Default,,0,0,0,,Жоқ, шынында да, дене шынықтыру мұғалімі күткендей!
Dialogue: 0,0:09:02.97,0:09:04.77,Default,,0,0,0,,Ааааааааааааааааааа! ! !
Dialogue: 0,0:09:04.99,0:09:07.07,Default,,0,0,0,,Уау, Юкари-чан бұзылды!
Dialogue: 0,0:09:07.16,0:09:08.51,Default,,0,0,0,,Ааааааааааааа! !
Dialogue: 0,0:09:08.61,0:09:10.57,Default,,0,0,0,,Эй, Юкари, тоқта!
Dialogue: 0,0:09:10.62,0:09:11.81,Default,,0,0,0,,Ааааааааааа!
Dialogue: 0,0:09:14.85,0:09:17.03,Default,,0,0,0,,Менің ойымша, кола жақсы.
Dialogue: 0,0:09:17.42,0:09:19.39,Default,,0,0,0,,Бұл өте жаман, Юкари.
Dialogue: 0,0:09:19.83,0:09:21.83,Default,,0,0,0,,Куросава-сенсэй, маған бір сәт болады ма?
Dialogue: 0,0:09:21.90,0:09:22.61,Default,,0,0,0,,Иә
Dialogue: 0,0:09:26.98,0:09:29.79,Default,,0,0,0,,Аа, кешіріңіз, мен шұғыл бірдеңе істеуім керек еді.
Dialogue: 0,0:09:29.81,0:09:32.09,Default,,0,0,0,,Ол коланы ішуге болады.
Dialogue: 0,0:09:32.11,0:09:34.47,Default,,0,0,0,,Е, эй, эй, эй...
Dialogue: 0,0:09:48.09,0:09:48.87,Default,,0,0,0,,Уа!
Dialogue: 0,0:09:49.90,0:09:51.24,Default,,0,0,0,,Міне!
Dialogue: 0,0:09:51.57,0:09:52.61,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:09:54.95,0:09:55.76,Default,,0,0,0,,Бұл алғаш рет.
Dialogue: 0,0:09:55.79,0:09:59.35,Default,,0,0,0,,Оның сізден шығуы әдеттен тыс.
Dialogue: 0,0:09:59.55,0:10:01.55,Default,,0,0,0,,Не? Солай ма?
Dialogue: 0,0:10:01.77,0:10:03.44,Default,,0,0,0,,Кіріңіз.
Dialogue: 0,0:10:03.47,0:10:07.19,Default,,0,0,0,,Жоқ, бүгін таңертеңнен бері менің көршімде құрылыс жұмыстары жүріп жатыр.
Dialogue: 0,0:10:07.46,0:10:09.45,Default,,0,0,0,,Не шулы?
Dialogue: 0,0:10:09.47,0:10:10.61,Default,,0,0,0,,Иә
Dialogue: 0,0:10:18.79,0:10:21.10,Default,,0,0,0,,Олай болса, қайырлы түн...
Dialogue: 0,0:10:21.46,0:10:22.86,Default,,0,0,0,,Сіз ұйықтайсыз ба?
Dialogue: 0,0:10:25.92,0:10:27.44,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:10:35.14,0:10:35.97,Default,,0,0,0,,Нямо!
Dialogue: 0,0:10:36.08,0:10:37.69,Default,,0,0,0,,Иә Бұл не?
Dialogue: 0,0:10:37.95,0:10:38.98,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:39.05,0:10:40.01,Default,,0,0,0,,Ой, аралы тен
Dialogue: 0,0:10:40.04,0:10:43.38,Default,,0,0,0,,Мынау! Бұл не жастық?
Dialogue: 0,0:10:43.47,0:10:45.46,Default,,0,0,0,,А, мен оны басқа күні сатып алдым.
Dialogue: 0,0:10:50.42,0:10:51.32,Default,,0,0,0,,Бұл қанша тұрады?
Dialogue: 0,0:10:51.90,0:10:53.41,Default,,0,0,0,,Он мың чой
Dialogue: 0,0:10:54.19,0:10:56.36,Default,,0,0,0,,Кет, буржуазия!
Dialogue: 0,0:10:56.88,0:10:58.12,Default,,0,0,0,,Шық!
Dialogue: 0,0:10:59.31,0:11:00.90,Default,,0,0,0,,Бірақ мен не айта аламын?
Dialogue: 0,0:11:01.13,0:11:04.40,Default,,0,0,0,,Бұл босаңсытатын, шайнайтын, жұмбақ сезім керемет.
Dialogue: 0,0:11:04.50,0:11:06.88,Default,,0,0,0,,Жарайды, мен жақсы ұйықтай аламын.
Dialogue: 0,0:11:08.25,0:11:09.63,Default,,0,0,0,,Францияда жасалған, солай ма?
Dialogue: 0,0:11:09.95,0:11:12.30,Default,,0,0,0,,Ум...Дания...
Dialogue: 0,0:11:16.57,0:11:17.57,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:11:17.73,0:11:19.39,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:11:19.48,0:11:20.23,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:11:20.25,0:11:23.08,Default,,0,0,0,,Мен сенің қаншалықты жақсы ұйықтайтыныңды көремін.
Dialogue: 0,0:11:25.24,0:11:27.78,Default,,0,0,0,,Әй, анау жастық төңкеріліп тұр.
Dialogue: 0,0:11:50.02,0:11:50.95,Default,,0,0,0,,Уа!
Dialogue: 0,0:11:51.45,0:11:52.77,Default,,0,0,0,,Бұл жеткізу.
Dialogue: 0,0:11:53.30,0:11:55.62,Default,,0,0,0,,Бұл Хоккайдодан келген Ямадаки мырзадан.
Dialogue: 0,0:11:56.22,0:11:58.10,Default,,0,0,0,,Аға, бұл менің ағамнан.
Dialogue: 0,0:11:58.12,0:11:59.27,Default,,0,0,0,,Хоккайдо? ! !
Dialogue: 0,0:12:02.54,0:12:03.72,Default,,0,0,0,,Әй, сәл!
Dialogue: 0,0:12:05.99,0:12:08.24,Default,,0,0,0,,Хоккайдо туралы айту
Dialogue: 0,0:12:08.50,0:12:12.50,Default,,0,0,0,,Бұл шаян ба? Әлде теңіз кірпі ме? Әлде теңіз кірпі ме?
Dialogue: 0,0:12:13.72,0:12:14.74,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:16.32,0:12:19.16,Default,,0,0,0,,(Аю жылауы)
Dialogue: 0,0:12:23.61,0:12:25.67,Default,,0,0,0,,Бұл тамақ емес еді.
Dialogue: 0,0:12:28.59,0:12:30.45,Default,,0,0,0,,Әй, сен не істеп жатырсың?!
Dialogue: 0,0:12:30.93,0:12:33.57,Default,,0,0,0,,Мына жігітті Ямазаки деп атаңыз.
Dialogue: 0,0:12:33.63,0:12:35.27,Default,,0,0,0,,Шаянға өзгерту
Dialogue: 0,0:12:35.42,0:12:36.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:36.32,0:12:37.42,Default,,0,0,0,,Ах Моши Моши
Dialogue: 0,0:12:37.64,0:12:39.72,Default,,0,0,0,,Бұл Ямадаки мырзаның үйі ме?
Dialogue: 0,0:12:40.25,0:12:43.57,Default,,0,0,0,,Алынған нәрселерге тапсырыс беруді тоқтатыңыз.
Dialogue: 0,0:12:43.64,0:12:46.01,Default,,0,0,0,,Аа, кешіріңіз, мен қателік жібердім.
Dialogue: 0,0:12:46.95,0:12:48.10,Default,,0,0,0,,Бұл сенсің!
Dialogue: 0,0:12:48.20,0:12:50.36,Default,,0,0,0,,Бұл аюмен не істеуді жоспарлап отырсың?
Dialogue: 0,0:12:50.98,0:12:53.61,Default,,0,0,0,,Иә, оны кіреберісте көрсету сияқты...
Dialogue: 0,0:12:53.64,0:12:55.94,Default,,0,0,0,,Сіз тіпті шаянмен безендіре алмайсыз ба?!
Dialogue: 0,0:12:56.04,0:12:57.84,Default,,0,0,0,,Шаянды безендірмеңіз.
Dialogue: 0,0:12:58.46,0:13:00.20,Default,,0,0,0,,Жарайды, қайтарайық!
Dialogue: 0,0:13:00.52,0:13:01.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:01.35,0:13:02.22,Default,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,0:13:03.44,0:13:06.10,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:13:06.56,0:13:07.61,Default,,0,0,0,,Сіз
Dialogue: 0,0:13:07.63,0:13:09.80,Default,,0,0,0,,Осылайша сіз көпшіліктің көрінісіне алаңдайсыз.
Dialogue: 0,0:13:09.83,0:13:11.33,Default,,0,0,0,,Ер адамдар мұны істей алмайды!
Dialogue: 0,0:13:11.64,0:13:13.52,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:13:13.67,0:13:15.40,Default,,0,0,0,,Тіпті университетте оқып жүрген кезімде.
Dialogue: 0,0:13:15.42,0:13:17.80,Default,,0,0,0,,Мен бір көргеннен күңіреніп тұрғанымда
Dialogue: 0,0:13:17.83,0:13:20.04,Default,,0,0,0,,Мама мен Кохани #
Dialogue: 0,0:13:20.06,0:13:21.88,Default,,0,0,0,,Ах! аа! аа! аа!
Dialogue: 0,0:13:22.51,0:13:25.38,Default,,0,0,0,,Сіз не істеп жатырсыз? Мұның бәрі рас, солай емес пе?
Dialogue: 0,0:13:26.55,0:13:29.85,Default,,0,0,0,,Жақсы да, жаман да болады.
Dialogue: 0,0:13:35.91,0:13:38.67,Default,,0,0,0,,Сен, әрқашан, әрқашан
Dialogue: 0,0:13:38.69,0:13:41.07,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл сенсің.
Dialogue: 0,0:13:41.10,0:13:44.82,Default,,0,0,0,,Мм...алу үшін қол қойыңыз...
Dialogue: 0,0:13:59.21,0:14:00.91,Default,,0,0,0,,Ішуге барайық па?
Dialogue: 0,0:14:02.27,0:14:02.97,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:08.67,0:14:10.02,Default,,0,0,0,,Сонда қайда бара жатырсың?
Dialogue: 0,0:14:10.42,0:14:13.56,Default,,0,0,0,,Оны жақын жерде ұстауым керек пе? Әлде вокзалға бару керек пе?
Dialogue: 0,0:14:15.41,0:14:18.23,Default,,0,0,0,,Мен мұны демеушіге қалдырамын.
Dialogue: 0,0:14:18.44,0:14:20.34,Default,,0,0,0,,Демеуші кім?
Dialogue: 0,0:14:20.64,0:14:24.48,Default,,0,0,0,,Міне, сондықтан бүгін мысықтарды тамақтандыру күні деп айтасыз.
Dialogue: 0,0:14:24.55,0:14:27.56,Default,,0,0,0,,Мен түсінбейтін нәрсені неге айтып тұрсың?
Dialogue: 0,0:14:27.58,0:14:28.80,Default,,0,0,0,,Білмейсіз бе?
Dialogue: 0,0:14:28.83,0:14:31.70,Default,,0,0,0,,Басқаша айтқанда, сізде менің эмоцияларымның үлесі бар.
Dialogue: 0,0:14:31.72,0:14:33.40,Default,,0,0,0,,Аузыңды жап!
Dialogue: 0,0:14:33.46,0:14:36.55,Default,,0,0,0,,Жарайды, келесі жолы сатып аламын.
Dialogue: 0,0:14:36.69,0:14:37.33,Default,,0,0,0,,Ол ма?
Dialogue: 0,0:14:37.59,0:14:39.09,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,0:14:39.12,0:14:40.25,Default,,0,0,0,,Не болды, апа?
Dialogue: 0,0:14:40.28,0:14:42.30,Default,,0,0,0,,Мен өтірік айттым
Dialogue: 0,0:14:42.96,0:14:45.38,Default,,0,0,0,,Уау! Бір сәт осында болыңыз
Dialogue: 0,0:14:46.16,0:14:47.84,Default,,0,0,0,,Не? сурет? Қайда бара жатырсың?
Dialogue: 0,0:14:49.05,0:14:50.33,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:51.22,0:14:51.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:52.20,0:14:53.26,Default,,0,0,0,,еркін
Dialogue: 0,0:14:53.59,0:14:56.30,Default,,0,0,0,,А...м...о, осы сәт
Dialogue: 0,0:14:56.42,0:14:59.78,Default,,0,0,0,,Менің досым Kia Pink Ағылшын тілі
Dialogue: 0,0:14:59.88,0:15:00.43,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:01.14,0:15:04.80,Default,,0,0,0,,Осы кенеттен қайда бардың?
Dialogue: 0,0:15:05.21,0:15:05.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:06.62,0:15:08.86,Default,,0,0,0,,Нені жасырып, қарап отырсың?!
Dialogue: 0,0:15:09.34,0:15:10.71,Default,,0,0,0,,Бұл қызықты болды
Dialogue: 0,0:15:10.80,0:15:12.67,Default,,0,0,0,,Сіз ағылшын тілі мұғалімісіз бе?
Dialogue: 0,0:15:12.69,0:15:14.56,Default,,0,0,0,,Бірдеңе істе!
Dialogue: 0,0:15:15.58,0:15:16.40,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:15:16.42,0:15:17.86,Default,,0,0,0,,Бұл не, шетелдік?
Dialogue: 0,0:15:17.88,0:15:20.22,Default,,0,0,0,,Пера Пера Пера Пера
Dialogue: 0,0:15:21.22,0:15:22.73,Default,,0,0,0,,еркін
Dialogue: 0,0:15:22.75,0:15:25.11,Default,,0,0,0,,Пера Пера Пера Пера
Dialogue: 0,0:15:25.32,0:15:27.90,Default,,0,0,0,,Пера Пера Пера Пера Пера Пера Пера Пера Пера Пера Пера Пера Пера
Dialogue: 0,0:15:28.84,0:15:31.30,Default,,0,0,0,,Уау, сен ақымақ емес сияқтысың.
Dialogue: 0,0:15:31.72,0:15:32.55,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:15:32.58,0:15:34.26,Default,,0,0,0,,Бұл дене шынықтыру мұғалімі
Dialogue: 0,0:15:34.82,0:15:37.66,Default,,0,0,0,,Пера Пера Пера Пера
Dialogue: 0,0:15:37.91,0:15:39.80,Default,,0,0,0,,Пера Пера Пера Пера
Dialogue: 0,0:15:39.99,0:15:41.69,Default,,0,0,0,,Пера Пера
Dialogue: 0,0:15:41.78,0:15:43.16,Default,,0,0,0,,Пера Пера
Dialogue: 0,0:15:43.50,0:15:46.32,Default,,0,0,0,,Ахахахахаха
Dialogue: 0,0:15:46.54,0:15:47.70,Default,,0,0,0,,Не? не?
Dialogue: 0,0:15:47.95,0:15:49.11,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:15:49.25,0:15:50.47,Default,,0,0,0,,Тіпті менің елімде
Dialogue: 0,0:15:50.54,0:15:53.07,Default,,0,0,0,,Дене шынықтыру пәнінің мұғалімдерін мылқау дейді.
Dialogue: 0,0:15:53.14,0:15:54.77,Default,,0,0,0,,Өтірікші!!
Dialogue: 0,0:16:04.37,0:16:05.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:05.70,0:16:07.44,Default,,0,0,0,,Иә? Осака емес пе?
Dialogue: 0,0:16:08.43,0:16:09.37,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:16:09.85,0:16:12.89,Default,,0,0,0,,Осака! Эй! Осака!
Dialogue: 0,0:16:16.08,0:16:20.42,Default,,0,0,0,,Мен Томо-чан мен Коёми-чанды ұмыта алмаймын.
Dialogue: 0,0:16:20.96,0:16:22.70,Default,,0,0,0,,Не болды? Кенеттен
Dialogue: 0,0:16:23.50,0:16:24.91,Default,,0,0,0,,Сіз тағы да мектептерді ауыстырмақсыз ба?
Dialogue: 0,0:16:25.59,0:16:26.71,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:16:27.04,0:16:28.80,Default,,0,0,0,,Бұл өмірде бір рет болатын мүмкіндік
Dialogue: 0,0:16:29.90,0:16:30.98,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:32.05,0:16:33.16,Default,,0,0,0,,Адамдармен кездескенде
Dialogue: 0,0:16:33.18,0:16:36.54,Default,,0,0,0,,Бұл сіз ол адамды енді ешқашан көрмейді деп ойлайсыз дегенді білдіреді.
Dialogue: 0,0:16:37.08,0:16:38.60,Default,,0,0,0,,Өте рахмет. Енді барамын.
Dialogue: 0,0:16:39.03,0:16:41.11,Default,,0,0,0,,Мен мұны түсінбеймін, бірақ...
Dialogue: 0,0:16:41.45,0:16:44.79,Default,,0,0,0,,Қалай болғанда да, өмірде бір рет берілген мүмкіндікті бағалай білу керек.
Dialogue: 0,0:16:45.10,0:16:46.31,Default,,0,0,0,,Өте көп!
Dialogue: 0,0:16:46.55,0:16:49.03,Default,,0,0,0,,Саяхаттау ұятынан құтыл!
Dialogue: 0,0:16:49.08,0:16:49.81,Default,,0,0,0,,Е! ?
Dialogue: 0,0:16:50.03,0:16:52.76,Default,,0,0,0,,А, бұл рас болуы мүмкін.
Dialogue: 0,0:16:52.79,0:16:55.60,Default,,0,0,0,,Жарайсыңдар! Сіз мұнда дауыстап ән айтасыз ба?
Dialogue: 0,0:16:56.40,0:17:00.56,Default,,0,0,0,,Мен бананның қабығына құлағым келеді.
Dialogue: 0,0:17:01.58,0:17:03.36,Default,,0,0,0,,Өмірде бір рет болатын мүмкіндік!
Dialogue: 0,0:17:03.53,0:17:04.98,Default,,0,0,0,,Өмірде бір рет болатын мүмкіндік!
Dialogue: 0,0:17:05.11,0:17:06.80,Default,,0,0,0,,Өмірде бір рет болатын мүмкіндік!
Dialogue: 0,0:17:06.93,0:17:08.45,Default,,0,0,0,,Өмірде бір рет болатын мүмкіндік!
Dialogue: 0,0:17:13.95,0:17:15.21,Default,,0,0,0,,Тағы не!
Dialogue: 0,0:17:15.24,0:17:16.87,Default,,0,0,0,,Тіпті сен университетке түскенше.
Dialogue: 0,0:17:16.89,0:17:19.23,Default,,0,0,0,,Мен қызанақты жеміс деп ойласам да!
Dialogue: 0,0:17:19.26,0:17:20.69,Default,,0,0,0,,Тіпті сен!
Dialogue: 0,0:17:20.72,0:17:22.09,Default,,0,0,0,,Тәкеда-сенпайдың үйінің алдында
Dialogue: 0,0:17:22.11,0:17:24.47,Default,,0,0,0,,Естелік суретке жасырын түссем де!
Dialogue: 0,0:17:24.53,0:17:26.41,Default,,0,0,0,,Баяғыда!
Dialogue: 0,0:17:26.48,0:17:29.17,Default,,0,0,0,,Біреудің өткенін қазып алу өте керемет.
Dialogue: 0,0:17:29.19,0:17:31.92,Default,,0,0,0,,Жоқ! Тоқта, тоқта, тоқта!
Dialogue: 0,0:17:34.55,0:17:35.80,Default,,0,0,0,,Үйге қайтайық?
Dialogue: 0,0:17:35.82,0:17:36.58,Default,,0,0,0,,Сейана
Dialogue: 0,0:17:37.50,0:17:38.78,Default,,0,0,0,,Ән айтуда не бар?
Dialogue: 0,0:17:39.46,0:17:42.60,Default,,0,0,0,,Сапардың ұятын тастамадың ба?
Dialogue: 0,0:17:43.26,0:17:44.59,Default,,0,0,0,,Өйткені сені лақтырып жібереді
Dialogue: 0,0:17:44.61,0:17:47.75,Default,,0,0,0,,Мен өзімді ұятқа қалдырмаймын деп ойлаймын.
Dialogue: 0,0:17:48.83,0:17:50.01,Default,,0,0,0,,Екеуін зорлап, өлтірді
Dialogue: 0,0:18:09.38,0:18:10.56,Default,,0,0,0,,Бірақ мен өз күнәларыммен осылай бетпе-бет келгенім…
Dialogue: 0,0:18:10.71,0:18:11.91,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:18:12.43,0:18:13.89,Default,,0,0,0,,Міне, сен!
Dialogue: 0,0:18:13.91,0:18:16.52,Default,,0,0,0,,Саяхаттаудың ұятын тастау керек!
Dialogue: 0,0:18:16.55,0:18:19.73,Default,,0,0,0,,Саяхат дегеніміз не? Бұл жер өте жақын емес.
Dialogue: 0,0:18:19.93,0:18:22.41,Default,,0,0,0,,Сіз не туралы айтып тұрсыз? Маңай дегеніміз не?
Dialogue: 0,0:18:22.48,0:18:24.62,Default,,0,0,0,,Бұл сіздің қолыңыздан келгенше!
Dialogue: 0,0:18:24.65,0:18:27.24,Default,,0,0,0,,Иә, иә, екеуі де жақсы.
Dialogue: 0,0:18:27.41,0:18:30.78,Default,,0,0,0,,Жарайсыңдар! Негізі бұл менің жеңісім.
Dialogue: 0,0:18:30.97,0:18:32.65,Default,,0,0,0,,Бүгінгі Коконахарай!
Dialogue: 0,0:18:32.85,0:18:34.16,Default,,0,0,0,,Неліктен мен?
Dialogue: 0,0:18:34.29,0:18:35.99,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:18:36.10,0:18:39.28,Default,,0,0,0,,Мәліметтерге алаңдамаңыз.
Dialogue: 0,0:18:39.44,0:18:39.98,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:18:40.93,0:18:42.70,Default,,0,0,0,,Не? …Бұл…
Dialogue: 0,0:18:44.25,0:18:46.74,Default,,0,0,0,,Мен мұны біраздан бері айтқым келді.
Dialogue: 0,0:18:46.83,0:18:49.43,Default,,0,0,0,,Таяқшаларды ұстау тәсілі әртүрлі.
Dialogue: 0,0:18:49.46,0:18:51.47,Default,,0,0,0,,Не? Таяқшаларға не болды?
Dialogue: 0,0:18:52.34,0:18:56.08,Default,,0,0,0,,Қараңыз, таяқшаларыңыз параллель болуы керек.
Dialogue: 0,0:18:56.51,0:18:58.90,Default,,0,0,0,,Бастапқыда ол артқы жағынан осылай ашылды
Dialogue: 0,0:18:59.83,0:19:01.20,Default,,0,0,0,,Коко?
Dialogue: 0,0:19:01.33,0:19:03.22,Default,,0,0,0,,Жоқ, жоқ, қара!
Dialogue: 0,0:19:06.05,0:19:07.84,Default,,0,0,0,,Жарайды, мен жасап көремін.
Dialogue: 0,0:19:08.81,0:19:09.51,Default,,0,0,0,,Мағынасыздық
Dialogue: 0,0:19:11.33,0:19:12.94,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:19:13.85,0:19:14.71,Default,,0,0,0,,Мағынасыздық
Dialogue: 0,0:19:15.86,0:19:16.92,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:19:17.07,0:19:18.64,Default,,0,0,0,,Крокеттерді берме, жарай ма?
Dialogue: 0,0:19:19.14,0:19:22.12,Default,,0,0,0,,Олай жасасаңыз, оны дұрыс түсіне алмайсыз.
Dialogue: 0,0:19:23.01,0:19:23.81,Default,,0,0,0,,Мұнда қараңыз
Dialogue: 0,0:19:24.57,0:19:25.71,Default,,0,0,0,,О...
Dialogue: 0,0:19:27.58,0:19:30.07,Default,,0,0,0,,Оңай, солай ма? Қараңызшы, осылай
Dialogue: 0,0:19:30.27,0:19:30.97,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:19:31.84,0:19:32.53,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:19:33.80,0:19:34.56,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:19:36.01,0:19:36.71,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:19:37.79,0:19:38.50,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:19:39.64,0:19:40.38,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:19:41.42,0:19:42.07,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:19:43.42,0:19:44.15,Default,,0,0,0,,Мынау да.
Dialogue: 0,0:19:44.83,0:19:46.19,Default,,0,0,0,,Ахх! ! !
Dialogue: 0,0:20:05.91,0:20:07.05,Default,,0,0,0,,Уми!
Dialogue: 0,0:20:07.93,0:20:10.83,Default,,0,0,0,,Сондықтан мен құспын!
Dialogue: 0,0:20:11.16,0:20:13.23,Default,,0,0,0,,Әй, сен бүгін көп ішкен жоқсың ба?
Dialogue: 0,0:20:13.25,0:20:15.00,Default,,0,0,0,,Тоқтау уақыты келді
Dialogue: 0,0:20:15.14,0:20:20.02,Default,,0,0,0,,Сыртқы түрі бірінші! Сіз оны соңына дейін жеткізгенше!
Dialogue: 0,0:20:20.06,0:20:21.82,Default,,0,0,0,,Соңы қайда?
Dialogue: 0,0:20:24.89,0:20:26.02,Default,,0,0,0,,＃
Dialogue: 0,0:20:26.18,0:20:29.39,Default,,0,0,0,,Басқаша айтқанда, бұл якитори сияқты нәрсе!
Dialogue: 0,0:20:29.59,0:20:32.80,Default,,0,0,0,,Бұл ет мен, ал сен көк пиязсың! Түсінесіз бе?
Dialogue: 0,0:20:32.83,0:20:34.08,Default,,0,0,0,,Мен мүлде түсінбеймін
Dialogue: 0,0:20:35.58,0:20:37.35,Default,,0,0,0,,Сондықтан Ня да ақымақ.
Dialogue: 0,0:20:37.37,0:20:38.90,Default,,0,0,0,,Қандай бейбақ!
Dialogue: 0,0:20:38.94,0:20:40.07,Default,,0,0,0,,Юкари-чан бұл~
Dialogue: 0,0:20:40.09,0:20:42.88,Default,,0,0,0,,Мен ағылшын тілінің мұғалімі болғандықтан, бұл Таманокоши Нян!
Dialogue: 0,0:20:42.90,0:20:43.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:43.47,0:20:45.68,Default,,0,0,0,,Мияу құтты болсын!
Dialogue: 0,0:20:45.83,0:20:48.60,Default,,0,0,0,,Эй, эй! Юкари!
Dialogue: 0,0:20:50.79,0:20:53.89,Default,,0,0,0,,Енді ол жерде ұйықтама!
Dialogue: 0,0:20:54.02,0:20:55.58,Default,,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:20:55.88,0:20:58.00,Default,,0,0,0,,Тек олай жасамаңыз.
Dialogue: 0,0:20:59.22,0:21:00.82,Default,,0,0,0,,Сондықтан ұйықтамаңыз!
Dialogue: 0,0:21:04.08,0:21:06.48,Default,,0,0,0,,Сіз жастық сатып алдыңыз!
Dialogue: 0,0:21:07.39,0:21:09.28,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:21:12.03,0:21:14.47,Default,,0,0,0,,Әй, абайлап жүр!
Dialogue: 0,0:21:14.99,0:21:16.77,Default,,0,0,0,,Жиренішті...
Dialogue: 0,0:21:16.82,0:21:17.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:18.37,0:21:20.52,Default,,0,0,0,,(Юкари құсу дыбысы)
Dialogue: 0,0:21:22.30,0:21:24.31,Default,,0,0,0,,Сіз қатты қиналып қалуыңыз мүмкін...
Dialogue: 0,0:21:24.35,0:21:26.02,Default,,0,0,0,,Сатору мен жоғары лауазымды тұлғалар арасындағы қақтығыс осыны ұйымдастырды деген сыбыс бар, солай емес пе?
Dialogue: 0,0:21:26.41,0:21:29.92,Default,,0,0,0,,Мен көп ішетін болмасам да, үнемі көп ішемін.
Dialogue: 0,0:21:30.49,0:21:31.84,Default,,0,0,0,,Кеттік
Dialogue: 0,0:21:32.10,0:21:33.86,Default,,0,0,0,,Өзіңізге сеніңіз!
Dialogue: 0,0:21:33.88,0:21:35.40,Default,,0,0,0,,Сенбеңіз
Dialogue: 0,0:21:36.96,0:21:39.48,Default,,0,0,0,,Мен қазір такси ұстаймын.
Dialogue: 0,0:21:39.48,0:21:41.26,Default,,0,0,0,,Қараңдар, мен көшеге шығамын.
Dialogue: 0,0:21:42.84,0:21:45.38,Default,,0,0,0,,Кері жел диірмені! #
Dialogue: 0,0:21:45.86,0:21:48.13,Default,,0,0,0,,Салво от!
Dialogue: 0,0:21:59.18,0:22:01.74,Default,,0,0,0,,Жүрегіңде қанат қағып
Dialogue: 0,0:22:03.36,0:22:06.46,Default,,0,0,0,,Жүрегіңдегі сыбырды айт
Dialogue: 0,0:22:07.61,0:22:10.29,Default,,0,0,0,,Енді желде
Dialogue: 0,0:22:13.95,0:22:16.51,Default,,0,0,0,,Жүрек жұлдыздардан тыс
Dialogue: 0,0:22:18.18,0:22:21.32,Default,,0,0,0,,Тілектер әрқашан орындалады
Dialogue: 0,0:22:22.39,0:22:30.00,Default,,0,0,0,,Кел мені көр, Кілт – болашақ
Dialogue: 0,0:22:31.13,0:22:35.28,Default,,0,0,0,,Терезеге ақырын шақырған дауыс
Dialogue: 0,0:22:35.38,0:22:39.12,Default,,0,0,0,,Махаббатты алдын ала ескерту және
Dialogue: 0,0:22:39.68,0:22:43.32,Default,,0,0,0,,Махаббат әлі алыс болса да
Dialogue: 0,0:22:43.62,0:22:45.60,Default,,0,0,0,,Мен ертеңге сенемін
Dialogue: 0,0:22:45.63,0:22:47.64,Default,,0,0,0,,Мен саған сенемін
Dialogue: 0,0:22:47.76,0:22:49.61,Default,,0,0,0,,Таңқурай аспаны
Dialogue: 0,0:22:49.65,0:22:55.10,Default,,0,0,0,,Жалғыз болмаймын деп уәде бердің, аспан
Dialogue: 0,0:22:56.24,0:22:58.05,Default,,0,0,0,,Таңқурай аспаны
Dialogue: 0,0:22:58.12,0:22:59.78,Default,,0,0,0,,Тәтті көз жасы
Dialogue: 0,0:23:00.18,0:23:04.51,Default,,0,0,0,,Жұмақта тағы да күл
Dialogue: 0,0:23:04.74,0:23:06.49,Default,,0,0,0,,Таңқурай аспаны
Dialogue: 0,0:23:06.57,0:23:12.05,Default,,0,0,0,,Мен сені нәзік армандардың аспанына алып кетуге келдім
Dialogue: 0,0:23:13.20,0:23:16.86,Default,,0,0,0,,Таңқурай аспаны мен саған қайтып келемін
Dialogue: 0,0:23:17.16,0:23:21.48,Default,,0,0,0,,Жұмақ гүлі жайқалған күні
Dialogue: 0,0:23:21.61,0:23:23.58,Default,,0,0,0,,Сен және мен...
Dialogue: 0,0:23:24.19,0:23:28.46,Default,,0,0,0,,Бірге кездесейік
Dialogue: 0,0:23:33.86,0:23:37.04,Default,,0,0,0,,Келесі жаз! Бұл купальник! Бассейн! Бассейн! Бассейн!
Dialogue: 0,0:23:37.17,0:23:39.21,Default,,0,0,0,,Әлі көктем емес пе?
Dialogue: 0,0:23:39.23,0:23:40.64,Default,,0,0,0,,Сіз сәл асығыссыз.
Dialogue: 0,0:23:40.75,0:23:42.00,Default,,0,0,0,,Бассейн жақсы
Dialogue: 0,0:23:42.03,0:23:43.91,Default,,0,0,0,,Форма да өзгерді, жеңі қысқа!
Dialogue: 0,0:23:44.01,0:23:45.71,Default,,0,0,0,,Ал, ұзын жеңде ыстық.
Dialogue: 0,0:23:45.93,0:23:49.55,Default,,0,0,0,,Бұл жағдайда сабаққа фитнес киімімен, тіпті купальникпен бару қиын болады.
Dialogue: 0,0:23:49.88,0:23:54.05,Default,,0,0,0,,Келесі жолы жаз гүлдейді! Азуманга Дайох! Оны асыға күтіңіздер!
Dialogue: 0,0:23:54.10,0:23:55.60,Default,,0,0,0,,Өйткені, дымқыл болған жақсы
Dialogue: 0,0:23:55.68,0:23:56.56,Default,,0,0,0,,Шу!
Dialogue: 0,0:23:58.06,0:24:04.06,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory