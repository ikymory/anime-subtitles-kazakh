Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.83,0:00:07.30,Default,,0,0,0,,Лу Ла Лу Ла Пианино - әлемдік
Dialogue: 0,0:00:07.33,0:00:10.81,Default,,0,0,0,,Арман гүлдеген далада әуен
Dialogue: 0,0:00:10.84,0:00:14.27,Default,,0,0,0,,Сынған сағатқа сену
Dialogue: 0,0:00:14.30,0:00:17.73,Default,,0,0,0,,Уақыт сенің жаныңда кім?
Dialogue: 0,0:00:17.76,0:00:21.10,Default,,0,0,0,,Менің кеудем неге үлкен?
Dialogue: 0,0:00:21.31,0:00:24.72,Default,,0,0,0,,Сіз мейірімді адамды күтесіз бе?
Dialogue: 0,0:00:24.80,0:00:28.29,Default,,0,0,0,,Маған тамаша болашағыңыз туралы айтып беріңіз
Dialogue: 0,0:00:28.32,0:00:28.99,Default,,0,0,0,,Ай
Dialogue: 0,0:00:29.08,0:00:29.84,Default,,0,0,0,,Жарық
Dialogue: 0,0:00:29.96,0:00:31.70,Default,,0,0,0,,Ай сәулесі ұйықтап жатыр
Dialogue: 0,0:00:31.73,0:00:35.27,Default,,0,0,0,,Лу Ла Лу Ла Есте сақтау алмасына
Dialogue: 0,0:00:35.30,0:00:38.64,Default,,0,0,0,,Оянған қыз мені сүйеді
Dialogue: 0,0:00:38.68,0:00:42.19,Default,,0,0,0,,Азаппен жайылған кітапта
Dialogue: 0,0:00:42.22,0:00:45.46,Default,,0,0,0,,Екі қоңырау соғылады
Dialogue: 0,0:00:45.61,0:00:48.90,Default,,0,0,0,,Мен жақсы көретін адам, өйткені мен оны құшақтағым келеді
Dialogue: 0,0:00:49.14,0:00:52.67,Default,,0,0,0,,Енді жылама Қош бол қайғы
Dialogue: 0,0:00:52.69,0:00:56.17,Default,,0,0,0,,Жұмбақ есіктегі жазу
Dialogue: 0,0:00:56.20,0:00:59.61,Default,,0,0,0,,«Сорамими торты»
Dialogue: 0,0:00:59.63,0:01:00.94,Default,,0,0,0,,Ғажайыптар әлемі!
Dialogue: 0,0:01:00.97,0:01:02.69,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:01:02.72,0:01:04.01,Default,,0,0,0,,Ертегілер елі!
Dialogue: 0,0:01:04.04,0:01:05.68,Default,,0,0,0,,Бұл махаббаттың сиқыры
Dialogue: 0,0:01:05.71,0:01:07.02,Default,,0,0,0,,Махаббат бәрібір!
Dialogue: 0,0:01:07.05,0:01:08.80,Default,,0,0,0,,Күн сайын үлпілдек
Dialogue: 0,0:01:08.83,0:01:12.29,Default,,0,0,0,,Бидайдың азғыруы
Dialogue: 0,0:01:12.32,0:01:13.59,Default,,0,0,0,,Сізге арналған торт!
Dialogue: 0,0:01:13.62,0:01:15.32,Default,,0,0,0,,Бүгін кешке тамақтаныңыз.
Dialogue: 0,0:01:15.34,0:01:16.66,Default,,0,0,0,,Сізге шай!
Dialogue: 0,0:01:16.69,0:01:18.38,Default,,0,0,0,,Шоқжұлдыз шай ішу
Dialogue: 0,0:01:18.40,0:01:19.69,Default,,0,0,0,,Терезеде
Dialogue: 0,0:01:19.72,0:01:21.46,Default,,0,0,0,,Періштелер хоры
Dialogue: 0,0:01:21.49,0:01:24.87,Default,,0,0,0,,Құлағыңыз бос па?
Dialogue: 0,0:01:24.90,0:01:28.46,Default,,0,0,0,,Мен сені сүйемін, мен сені сүйемін дауыс
Dialogue: 0,0:01:40.28,0:01:42.76,Default,,0,0,0,,Ертең басталатын көңілді жазғы демалыс.
Dialogue: 0,0:01:43.01,0:01:45.19,Default,,0,0,0,,Әркім өз уақытын қалай өткізеді деп ойлаймын
Dialogue: 0,0:01:45.48,0:01:46.17,Default,,0,0,0,,Иә
Dialogue: 0,0:01:46.28,0:01:48.41,Default,,0,0,0,,Менің отбасым Жаңа Зеландияға барады.
Dialogue: 0,0:01:48.48,0:01:50.11,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:01:50.13,0:01:52.51,Default,,0,0,0,,Астрономия үйірмесіндегі оқу-жаттығу жиынында.
Dialogue: 0,0:01:52.67,0:01:54.37,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:01:54.43,0:01:57.58,Default,,0,0,0,,Мұғалім саяхатқа қайда барды?
Dialogue: 0,0:01:57.66,0:01:59.93,Default,,0,0,0,,Мен Нептунға барамын
Dialogue: 0,0:02:02.77,0:02:05.29,Default,,0,0,0,,Иә! Мен сізге есеп карточкамды қайтарамын!
Dialogue: 0,0:02:08.06,0:02:10.62,Default,,0,0,0,,-де маған берген бұл не?
Dialogue: 0,0:02:10.72,0:02:13.68,Default,,0,0,0,,Иә, бұрғы да берілген адам
Dialogue: 0,0:02:13.71,0:02:16.41,Default,,0,0,0,,Ешқайда бармай аяқтау үшін бар күшіңізді салыңыз!
Dialogue: 0,0:02:29.30,0:02:32.70,Default,,0,0,0,,Сондай қатты күн астында... Қызық емес пе...
Dialogue: 0,0:02:53.35,0:02:54.49,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:02:54.55,0:02:56.78,Default,,0,0,0,,Сіз үшін кеш болды.
Dialogue: 0,0:02:58.59,0:03:00.75,Default,,0,0,0,,Мерекеден кейін түнде ме?
Dialogue: 0,0:03:00.97,0:03:02.02,Default,,0,0,0,,Түн?
Dialogue: 0,0:03:02.24,0:03:04.20,Default,,0,0,0,,Әрине ұйықтап жатырмын
Dialogue: 0,0:03:04.24,0:03:07.48,Default,,0,0,0,,Сен, осында отыр.
Dialogue: 0,0:03:07.66,0:03:08.48,Default,,0,0,0,,Ах
Dialogue: 0,0:03:08.56,0:03:10.04,Default,,0,0,0,,Отырыңыз!
Dialogue: 0,0:03:10.06,0:03:12.47,Default,,0,0,0,,А, қазірдің өзінде шулы.
Dialogue: 0,0:03:12.94,0:03:16.52,Default,,0,0,0,,Неліктен таң ерте? (Куросава) Сонымен, кешке!
Dialogue: 0,0:03:17.38,0:03:19.36,Default,,0,0,0,,Күніңізді жоспарлаңыз
Dialogue: 0,0:03:19.41,0:03:21.81,Default,,0,0,0,,Демалыс күні деп жалқау болмаңыз!
Dialogue: 0,0:03:22.02,0:03:23.41,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:23.50,0:03:24.86,Default,,0,0,0,,Сіз мұғалімсіз бе?
Dialogue: 0,0:03:24.89,0:03:26.08,Default,,0,0,0,,Сіз де
Dialogue: 0,0:03:26.10,0:03:27.81,Default,,0,0,0,,Қарап отырып сурет сала алмайсың
Dialogue: 0,0:03:27.84,0:03:28.73,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:03:29.07,0:03:30.06,Default,,0,0,0,,Әлі емес пе?
Dialogue: 0,0:03:31.50,0:03:32.78,Default,,0,0,0,,Дайын!
Dialogue: 0,0:03:32.92,0:03:33.67,Default,,0,0,0,,Тіпті оның есту қабілетінен айырылғаны туралы қауесет те бар
Dialogue: 0,0:03:33.72,0:03:36.14,Default,,0,0,0,,[Бос уақыт Суимин]
Dialogue: 0,0:03:38.09,0:03:40.88,Default,,0,0,0,,Бұл не? Сіз мотивациясыз.
Dialogue: 0,0:03:40.91,0:03:43.21,Default,,0,0,0,,№.
Dialogue: 0,0:03:43.55,0:03:44.87,Default,,0,0,0,,Керемет жазғы демалыс
Dialogue: 0,0:03:44.89,0:03:48.09,Default,,0,0,0,,Уақытыңызды біршама мағыналы пайдалана алмайсыз ба?
Dialogue: 0,0:03:48.20,0:03:51.69,Default,,0,0,0,,Кітап оқу, екінші семестрдің сабақ жоспарын ойластыру, т.б.
Dialogue: 0,0:03:51.73,0:03:53.67,Default,,0,0,0,,А, бұл тым шулы
Dialogue: 0,0:03:53.78,0:03:54.24,Default,,0,0,0,,Ах
Dialogue: 0,0:03:54.43,0:03:55.13,Default,,0,0,0,,Не?!
Dialogue: 0,0:03:55.70,0:03:57.25,Default,,0,0,0,,Ертең бір жерге шығайық!
Dialogue: 0,0:03:57.35,0:03:58.41,Default,,0,0,0,,Сіз ойнап жатырсыз ба?
Dialogue: 0,0:03:58.43,0:04:00.59,Default,,0,0,0,,Не! Ештеңе жоқ!
Dialogue: 0,0:04:00.62,0:04:02.29,Default,,0,0,0,,Жоқ, менде бәрі жақсы!
Dialogue: 0,0:04:02.79,0:04:04.04,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:04.42,0:04:07.43,Default,,0,0,0,,Оған көмектесу мүмкін емес, мен ертең жүземін.
Dialogue: 0,0:04:07.52,0:04:09.75,Default,,0,0,0,,Хмм, мен не істеуім керек?
Dialogue: 0,0:04:09.78,0:04:10.51,Default,,0,0,0,,Жүзу?
Dialogue: 0,0:04:10.55,0:04:11.09,Default,,0,0,0,,Не?
Dialogue: 0,0:04:11.14,0:04:13.23,Default,,0,0,0,,Бұл бассейн, солай ма? Бірге барайық!
Dialogue: 0,0:04:13.44,0:04:15.31,Default,,0,0,0,,Бұл мектеп бассейні!
Dialogue: 0,0:04:15.34,0:04:17.94,Default,,0,0,0,,Мен жүзу үйірмесінің кеңесшісімін.
Dialogue: 0,0:04:23.75,0:04:26.44,Default,,0,0,0,,Егер бұл мектеп бассейні болса, ол тегін.
Dialogue: 0,0:04:26.47,0:04:28.46,Default,,0,0,0,,Сондықтан бұл ойын емес!
Dialogue: 0,0:04:31.35,0:04:32.58,Default,,0,0,0,,Не!
Dialogue: 0,0:04:32.61,0:04:34.00,Default,,0,0,0,,Ештеңеден қалмасаң болды!
Dialogue: 0,0:04:34.03,0:04:37.99,Default,,0,0,0,,Менің қолымнан келмейді, мен мұғаліммін, сондықтан бәрі жақсы! Бұл таңқалғаннан жақсы!
Dialogue: 0,0:04:38.64,0:04:40.18,Default,,0,0,0,,Мен де мұғаліммін.
Dialogue: 0,0:04:40.21,0:04:41.89,Default,,0,0,0,,Мен мұны білемін.
Dialogue: 0,0:04:46.15,0:04:47.31,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:04:48.61,0:04:50.98,Default,,0,0,0,,[Бос уақыт] [Жүзу]
Dialogue: 0,0:04:51.82,0:04:54.94,Default,,0,0,0,,Білесің бе, менде мотивация жоқ.
Dialogue: 0,0:04:55.52,0:04:57.72,Default,,0,0,0,,№.
Dialogue: 0,0:05:01.39,0:05:03.41,Default,,0,0,0,,Өйткені, жаздың бәрі купальниктерге арналған!
Dialogue: 0,0:05:04.47,0:05:07.33,Default,,0,0,0,,Осы жылы мен аздап көбірек қызмет көрсетуге тырыстым.
Dialogue: 0,0:05:07.40,0:05:08.58,Default,,0,0,0,,Не?
Dialogue: 0,0:05:08.60,0:05:10.29,Default,,0,0,0,,Нибо Нибой
Dialogue: 0,0:05:16.82,0:05:19.41,Default,,0,0,0,,Иә! Акула пайда болды!
Dialogue: 0,0:05:23.44,0:05:26.35,Default,,0,0,0,,Мұғалім: Әлемде тек 8 курстың айырмашылығы бар ма? …
Dialogue: 0,0:05:26.37,0:05:27.57,Default,,0,0,0,,Хм, солай ма?
Dialogue: 0,0:05:30.05,0:05:31.45,Default,,0,0,0,,Маған әлі де қызық...
Dialogue: 0,0:05:31.62,0:05:32.81,Default,,0,0,0,,Хм, солай ма?
Dialogue: 0,0:05:35.23,0:05:36.90,Default,,0,0,0,,Жазғы демалыстың арнайы жобасы
Dialogue: 0,0:05:36.92,0:05:38.16,Default,,0,0,0,,Үйіңізге барыңыз!
Dialogue: 0,0:05:38.23,0:05:40.23,Default,,0,0,0,,Бүгін мен Чио Чанның үйіне барамын!
Dialogue: 0,0:05:40.39,0:05:42.13,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:44.89,0:05:46.81,Default,,0,0,0,,Әй, қайда барасың?!
Dialogue: 0,0:05:46.83,0:05:49.45,Default,,0,0,0,,Ұят болды, вокзал алдында айқайлаңыз.
Dialogue: 0,0:05:49.48,0:05:50.93,Default,,0,0,0,,Жақсы, ол үшін уайымдама!
Dialogue: 0,0:05:50.95,0:05:52.78,Default,,0,0,0,,Әй, эй, мен мұны көптен бері айтып жүрмін.
Dialogue: 0,0:05:52.80,0:05:54.61,Default,,0,0,0,,Үш адам қосылса, зина болып саналады!
Dialogue: 0,0:05:54.63,0:05:56.66,Default,,0,0,0,,Сондықтан мен саған қосылма дедім.
Dialogue: 0,0:06:01.09,0:06:03.77,Default,,0,0,0,,Менімен жыныстық қатынасқа түскіңіз келе ме?
Dialogue: 0,0:06:03.79,0:06:05.85,Default,,0,0,0,,А, түсіндім, түсіндім.
Dialogue: 0,0:06:06.01,0:06:07.09,Default,,0,0,0,,Олай болса
Dialogue: 0,0:06:07.43,0:06:10.95,Default,,0,0,0,,Е, жазғы демалыста үйге бару арнайы жоба
Dialogue: 0,0:06:10.97,0:06:13.34,Default,,0,0,0,,Бүгін мен Чио Чанның үйіне барамын.
Dialogue: 0,0:06:13.37,0:06:15.26,Default,,0,0,0,,Ия
Dialogue: 0,0:06:16.82,0:06:18.88,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:06:18.90,0:06:21.22,Default,,0,0,0,,Өйткені, даналық дегеннің өзі шулы.
Dialogue: 0,0:06:21.24,0:06:23.51,Default,,0,0,0,,Оған көмектесу мүмкін емес, сондықтан бұл туралы алаңдамаңыз.
Dialogue: 0,0:06:23.54,0:06:26.16,Default,,0,0,0,,Біздің өмір сүруіміздің өзі күнәкар!
Dialogue: 0,0:06:26.18,0:06:28.02,Default,,0,0,0,,Сондықтан сіз бізге қосылуыңыз керек!
Dialogue: 0,0:06:31.97,0:06:35.83,Default,,0,0,0,,Біздің өмір сүруіміздің өзі күнәкар ма?
Dialogue: 0,0:06:35.86,0:06:37.92,Default,,0,0,0,,А, түсіндім, түсіндім.
Dialogue: 0,0:06:38.03,0:06:40.06,Default,,0,0,0,,Олай болса, Осакадағы Хачио-чанның үйіне барайық.
Dialogue: 0,0:06:40.09,0:06:41.78,Default,,0,0,0,,Мен оны суретке түсірмеймін.
Dialogue: 0,0:06:41.87,0:06:42.93,Default,,0,0,0,,Көшіру?
Dialogue: 0,0:06:43.50,0:06:44.17,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:06:44.19,0:06:47.47,Default,,0,0,0,,Жазғы демалысыңызды босқа өткізбеу үшін
Dialogue: 0,0:06:47.50,0:06:50.94,Default,,0,0,0,,Мен Чио-чанның үй тапсырмасын көшіруге де дайын емеспін!
Dialogue: 0,0:06:51.87,0:06:53.93,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:54.03,0:06:54.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:54.92,0:06:57.68,Default,,0,0,0,,А, мен суда жүзіп жүрдім.
Dialogue: 0,0:06:58.07,0:07:00.94,Default,,0,0,0,,Ей, мені көшірме!
Dialogue: 0,0:07:01.02,0:07:02.10,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:07:02.16,0:07:02.83,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:03.16,0:07:04.57,Default,,0,0,0,,Мен мұны өзім жасаймын
Dialogue: 0,0:07:05.22,0:07:07.96,Default,,0,0,0,,Ха, оқи алатын адам болса жақсы болар еді.
Dialogue: 0,0:07:07.99,0:07:09.70,Default,,0,0,0,,Сізде жақсы стиль бар.
Dialogue: 0,0:07:09.77,0:07:12.31,Default,,0,0,0,,Жаз мезгілі болғандықтан көңіл-күйлерің жақсы.
Dialogue: 0,0:07:13.37,0:07:16.66,Default,,0,0,0,,Әркімнің соны көрсететін жігіті жоқ.
Dialogue: 0,0:07:18.96,0:07:22.28,Default,,0,0,0,,Кәне, кәдесый ретінде торт сатып алайық.
Dialogue: 0,0:07:22.41,0:07:25.91,Default,,0,0,0,,Yay Cake Cake Коёми-чан ең жақсысы!
Dialogue: 0,0:07:26.58,0:07:28.08,Default,,0,0,0,,Торт
Dialogue: 0,0:07:46.26,0:07:46.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:54.51,0:07:57.04,Default,,0,0,0,,Әй, біздің жететін кезіміз емес пе?
Dialogue: 0,0:07:57.50,0:08:00.82,Default,,0,0,0,,Иә, ол сіз сұраған мекенжайдың айналасында.
Dialogue: 0,0:08:04.30,0:08:06.64,Default,,0,0,0,,Эй, сен шынымен де осындасың ба? …
Dialogue: 0,0:08:06.67,0:08:09.02,Default,,0,0,0,,Есім тақтасы Чио Чанның үйіне айналды...
Dialogue: 0,0:08:09.22,0:08:10.36,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:08:14.26,0:08:16.14,Default,,0,0,0,,Өзін-өзі жоюға болмайды.
Dialogue: 0,0:08:16.58,0:08:17.82,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:08:19.96,0:08:21.74,Default,,0,0,0,,Сізге сызықша жазудың қажеті жоқ
Dialogue: 0,0:08:21.80,0:08:25.56,Default,,0,0,0,,Сәлем баршаңызға, біз сізді күттік!
Dialogue: 0,0:08:26.15,0:08:28.59,Default,,0,0,0,,Сондықтан сізге сызықша салудың қажеті жоқ
Dialogue: 0,0:08:31.84,0:08:35.47,Default,,0,0,0,,Ей, мүмкін кәдесый қауын жақсы болар еді.
Dialogue: 0,0:08:35.90,0:08:38.07,Default,,0,0,0,,Менің ойымша, қалыпты - жақсы, қалыпты - жақсы.
Dialogue: 0,0:08:38.23,0:08:41.06,Default,,0,0,0,,Барлығыңызға қош келдіңіздер.
Dialogue: 0,0:08:41.16,0:08:44.81,Default,,0,0,0,,Мен қуаныштымын, өйткені мен бірінші рет орта мектептен достарым келді.
Dialogue: 0,0:08:44.85,0:08:47.66,Default,,0,0,0,,Келіңіздер.
Dialogue: 0,0:08:47.76,0:08:49.62,Default,,0,0,0,,Уу-у-у-у, мазалағаным үшін кешіріңіз.
Dialogue: 0,0:08:49.64,0:08:50.50,Default,,0,0,0,,Айқай
Dialogue: 0,0:08:51.22,0:08:53.17,Default,,0,0,0,,Бұл менің бөлмем.
Dialogue: 0,0:08:53.30,0:08:54.59,Default,,0,0,0,,Міне, мен күткен реакция.
Dialogue: 0,0:08:54.62,0:08:55.76,Default,,0,0,0,,кең
Dialogue: 0,0:08:58.02,0:09:01.34,Default,,0,0,0,,Бірақ Чио-чан таңғажайып жерде тұрады.
Dialogue: 0,0:09:01.37,0:09:03.43,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:09:03.45,0:09:05.16,Default,,0,0,0,,Егер бұл таңқаларлық болса
Dialogue: 0,0:09:05.18,0:09:08.42,Default,,0,0,0,,Дұрыс, сіз жеңдіңіз.
Dialogue: 0,0:09:09.00,0:09:10.02,Default,,0,0,0,,Сәлем Осака
Dialogue: 0,0:09:14.64,0:09:17.79,Default,,0,0,0,,Бәріміз сыртқа шығып, бір жерде көңіл көтерейік
Dialogue: 0,0:09:17.87,0:09:21.10,Default,,0,0,0,,Күрсін, қолымнан келсе істеймін.
Dialogue: 0,0:09:21.68,0:09:23.46,Default,,0,0,0,,Не болды?
Dialogue: 0,0:09:25.02,0:09:26.82,Default,,0,0,0,,Маған ақша керек
Dialogue: 0,0:09:28.99,0:09:30.50,Default,,0,0,0,,Олай болса.
Dialogue: 0,0:09:30.52,0:09:33.19,Default,,0,0,0,,Бәріміз менің виллама барайық па?
Dialogue: 0,0:09:34.53,0:09:37.54,Default,,0,0,0,,Вилла бол! ⁈?
Dialogue: 0,0:09:37.80,0:09:39.71,Default,,0,0,0,,Вилла?
Dialogue: 0,0:09:39.93,0:09:43.13,Default,,0,0,0,,Жазғы демалыста үйге бару
Dialogue: 0,0:09:43.22,0:09:45.34,Default,,0,0,0,,Бүгін мен Чио-чанның вилласына барамын!
Dialogue: 0,0:09:45.52,0:09:47.10,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:47.36,0:09:49.63,Default,,0,0,0,,Иә, ауа райы жақсарды.
Dialogue: 0,0:09:49.84,0:09:52.64,Default,,0,0,0,,Бұл вилла үшін тамаша күн.
Dialogue: 0,0:09:53.93,0:09:56.58,Default,,0,0,0,,Жақсы, бұл вилла үшін жақсы күн ме, жоқ па, қарамастан.
Dialogue: 0,0:09:56.61,0:09:59.02,Default,,0,0,0,,Сакаки-санды шақырған Чиё-чан болды.
Dialogue: 0,0:09:59.05,0:09:59.48,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:59.50,0:10:02.32,Default,,0,0,0,,Мен сені кеше кітапханада кездестірдім, сондықтан мен сені шақырдым.
Dialogue: 0,0:10:02.64,0:10:03.80,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:10:04.29,0:10:05.41,Default,,0,0,0,,Әрине!
Dialogue: 0,0:10:05.73,0:10:08.18,Default,,0,0,0,,Жарайсыңдар! Алақай!
Dialogue: 0,0:10:08.23,0:10:09.19,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:09.22,0:10:10.40,Default,,0,0,0,,＃
Dialogue: 0,0:10:13.21,0:10:15.55,Default,,0,0,0,,Бұл кім? Мына жігіттерді кім шақырды!
Dialogue: 0,0:10:15.63,0:10:17.28,Default,,0,0,0,,Мына жігіттер!
Dialogue: 0,0:10:17.33,0:10:19.84,Default,,0,0,0,,Бізге рахмет, біз ол жаққа көлікпен бара аламыз.
Dialogue: 0,0:10:19.86,0:10:21.30,Default,,0,0,0,,Тасымалдау ақысы тегін.
Dialogue: 0,0:10:21.40,0:10:23.94,Default,,0,0,0,,Бұл рас, бірақ...
Dialogue: 0,0:10:23.97,0:10:27.52,Default,,0,0,0,,Иә, онда Такино-сан ғана пойызбен барады.
Dialogue: 0,0:10:27.55,0:10:28.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:29.46,0:10:31.51,Default,,0,0,0,,Иә! машина! машина!
Dialogue: 0,0:10:31.82,0:10:33.15,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:10:33.18,0:10:36.37,Default,,0,0,0,,Менің көлігімдегі адам мен Нямоның көлігіндегі адам бөлініп кетті.
Dialogue: 0,0:10:36.39,0:10:38.88,Default,,0,0,0,,Айтпақшы, менің көлігім қымбатырақ.
Dialogue: 0,0:10:38.90,0:10:40.00,Default,,0,0,0,,Менің ата-анам
Dialogue: 0,0:10:40.35,0:10:41.23,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:10:41.27,0:10:41.93,Default,,0,0,0,,Не?
Dialogue: 0,0:10:41.98,0:10:44.02,Default,,0,0,0,,Қымбат болуына қарамастан
Dialogue: 0,0:10:44.47,0:10:47.02,Default,,0,0,0,,Бұл машина барлық жерде...
Dialogue: 0,0:10:47.24,0:10:48.91,Default,,0,0,0,,Маған бәрібір, маған бәрібір
Dialogue: 0,0:10:48.94,0:10:51.80,Default,,0,0,0,,Егер сіз бұл туралы алаңдасаңыз, сіз өз өміріңізді толықтай өткізе алмайсыз.
Dialogue: 0,0:10:51.86,0:10:52.55,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:10:53.09,0:10:56.53,Default,,0,0,0,,Сонда меннен үш адам, менің отбасымнан екі адам.
Dialogue: 0,0:10:56.81,0:10:57.91,Default,,0,0,0,,Ум...
Dialogue: 0,0:10:57.94,0:11:00.94,Default,,0,0,0,,Юкари-сенсэйдің көлігі кеңірек көрінеді.
Dialogue: 0,0:11:00.96,0:11:04.14,Default,,0,0,0,,Ол көлікте үш адам жоқ па?
Dialogue: 0,0:11:06.27,0:11:08.63,Default,,0,0,0,,Неғұрлым аз өлсең, соғұрлым жақсы.
Dialogue: 0,0:11:08.77,0:11:09.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:11.64,0:11:12.64,Default,,0,0,0,,Тас, қағаз, қайшы
Dialogue: 0,0:11:14.32,0:11:17.37,Default,,0,0,0,,Ха! Керемет вилла екен
Dialogue: 0,0:11:17.39,0:11:20.31,Default,,0,0,0,,Атмосфера тамаша және орналасқан жері тамаша!
Dialogue: 0,0:11:21.96,0:11:22.94,Default,,0,0,0,,Мен оны көріп тұрдым.
Dialogue: 0,0:11:24.24,0:11:27.97,Default,,0,0,0,,Біздің роликтен қорықпа
Dialogue: 0,0:11:28.59,0:11:30.79,Default,,0,0,0,,Уау! Бұл теңіз! Бұл теңіз! Бұл теңіз!
Dialogue: 0,0:11:31.94,0:11:33.67,Default,,0,0,0,,Теңіз туралы айтсақ, кеттік
Dialogue: 0,0:11:33.69,0:11:35.00,Default,,0,0,0,,Қарбыз жарылған!
Dialogue: 0,0:11:35.02,0:11:37.68,Default,,0,0,0,,Классикалық туралы айтатын болсақ, бұл классикалық.
Dialogue: 0,0:11:37.71,0:11:39.53,Default,,0,0,0,,Бірақ таяқ немесе жарғанақ болмаса...
Dialogue: 0,0:11:39.56,0:11:41.38,Default,,0,0,0,,Е, жарғанат құлаған жоқ.
Dialogue: 0,0:11:41.44,0:11:42.30,Default,,0,0,0,,Маған біртіндеп орал
Dialogue: 0,0:11:42.74,0:11:44.50,Default,,0,0,0,,Қарбыз жарылған?
Dialogue: 0,0:11:48.15,0:11:48.75,Default,,0,0,0,,Не?
Dialogue: 0,0:11:48.78,0:11:51.86,Default,,0,0,0,,Ол қалай сонша үлкен болады?
Dialogue: 0,0:11:53.97,0:11:55.43,Default,,0,0,0,,Сізге жарғанақтың қажеті жоқ!
Dialogue: 0,0:11:55.45,0:11:56.49,Default,,0,0,0,,Мен қызып кеттім! Қуаныңыз!
Dialogue: 0,0:12:06.05,0:12:07.37,Default,,0,0,0,,Геморрой дегеніміз не?
Dialogue: 0,0:12:07.45,0:12:07.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:08.14,0:12:10.55,Default,,0,0,0,,Хираганадағы «Ши».
Dialogue: 0,0:12:10.58,0:12:12.96,Default,,0,0,0,,Сіз ``чи'' әрпімен нүкте жазасыз ба?
Dialogue: 0,0:12:13.39,0:12:16.77,Default,,0,0,0,,Әдетте «чи» үшін нүктелерді пайдалана алмайсыз...
Dialogue: 0,0:12:17.97,0:12:20.93,Default,,0,0,0,,Күні кеше сөздіктен іздеп көрдім.
Dialogue: 0,0:12:21.06,0:12:25.21,Default,,0,0,0,,«Ши» үстіндегі нүктелер нақты болды.
Dialogue: 0,0:12:26.41,0:12:28.27,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:33.73,0:12:35.73,Default,,0,0,0,,Сонымен теңіз барысы дегеніміз не?
Dialogue: 0,0:12:36.01,0:12:36.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:36.81,0:12:39.17,Default,,0,0,0,,«Теңіз барысы» деп жаза аласыз ба?
Dialogue: 0,0:12:39.83,0:12:41.55,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:12:41.64,0:12:46.11,Default,,0,0,0,,Әйтеуір, солай көрінсе де, жауыз болса керек...
Dialogue: 0,0:12:47.19,0:12:48.19,Default,,0,0,0,,О
Dialogue: 0,0:12:52.21,0:12:54.47,Default,,0,0,0,,Сіз көп... көп нәрсе туралы білесіз.
Dialogue: 0,0:12:54.59,0:12:55.84,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:12:59.68,0:13:01.50,Default,,0,0,0,,Теңіз туралы айтсам, мен
Dialogue: 0,0:13:01.52,0:13:03.60,Default,,0,0,0,,Мен теңіз шошқасына мінгім келеді
Dialogue: 0,0:13:07.03,0:13:08.24,Default,,0,0,0,,Хмм, жарайды…
Dialogue: 0,0:13:08.27,0:13:09.08,Default,,0,0,0,,Саяро
Dialogue: 0,0:13:09.55,0:13:13.91,Default,,0,0,0,,Сонымен, Кайтон теңіз шошқасы деп жазылған ба?
Dialogue: 0,0:13:15.25,0:13:19.12,Default,,0,0,0,,Ал, шошқа шошқа болса да, неге теңізде?
Dialogue: 0,0:13:19.14,0:13:22.73,Default,,0,0,0,,Менің ойымша, бұл өзен шошқасы деп жазылып, кавабута деп оқылады.
Dialogue: 0,0:13:39.66,0:13:41.36,Default,,0,0,0,,Екеуіңе не болды?
Dialogue: 0,0:13:41.38,0:13:43.52,Default,,0,0,0,,Мен геморрой туралы ойладым.
Dialogue: 0,0:13:43.54,0:13:44.77,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:46.21,0:13:48.42,Default,,0,0,0,,Жазғы демалыстың арнайы жобасы
Dialogue: 0,0:13:48.69,0:13:52.25,Default,,0,0,0,,Жазғы түндерді қалай толық өткізуге болады
Dialogue: 0,0:13:52.81,0:13:56.55,Default,,0,0,0,,Жазғы түндердің барлығы елес хикаялары туралы
Dialogue: 0,0:13:58.67,0:14:00.60,Default,,0,0,0,,Бұл негізгі болуы мүмкін.
Dialogue: 0,0:14:00.62,0:14:02.23,Default,,0,0,0,,Сіз қорқынышты нәрсені білесіз бе?
Dialogue: 0,0:14:03.85,0:14:06.03,Default,,0,0,0,,Мен білмеймін~
Dialogue: 0,0:14:06.29,0:14:07.83,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:14:07.86,0:14:10.32,Default,,0,0,0,,Ах! Ойланып көрейікші
Dialogue: 0,0:14:10.34,0:14:12.94,Default,,0,0,0,,Мен басқа вилла туралы айтып отырмын.
Dialogue: 0,0:14:12.96,0:14:14.63,Default,,0,0,0,,О, солай.
Dialogue: 0,0:14:14.89,0:14:19.11,Default,,0,0,0,,Жазда тарақандар көп болатын сияқты.
Dialogue: 0,0:14:20.31,0:14:21.79,Default,,0,0,0,,Сонымен
Dialogue: 0,0:14:21.79,0:14:23.07,Default,,0,0,0,,Міне.
Dialogue: 0,0:14:23.10,0:14:25.19,Default,,0,0,0,,Барлық жерде тарақандар бар
Dialogue: 0,0:14:26.66,0:14:28.59,Default,,0,0,0,,Жазғы түнде лас сөз!
Dialogue: 0,0:14:28.72,0:14:29.66,Default,,0,0,0,,Лас әңгіме?
Dialogue: 0,0:14:30.07,0:14:31.64,Default,,0,0,0,,Иә
Dialogue: 0,0:14:31.68,0:14:33.88,Default,,0,0,0,,Міне, біреуі
Dialogue: 0,0:14:33.91,0:14:36.74,Default,,0,0,0,,Екі үлкенге де пайдалы әңгіме тыңдайық!
Dialogue: 0,0:14:36.84,0:14:37.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:37.46,0:14:39.59,Default,,0,0,0,,Саса! Екі ересек адамға ғана тән
Dialogue: 0,0:14:39.62,0:14:42.23,Default,,0,0,0,,Юкари Сенсейдің тәжірибесі мол!
Dialogue: 0,0:14:42.44,0:14:43.35,Default,,0,0,0,,Мен?
Dialogue: 0,0:14:43.49,0:14:44.08,Default,,0,0,0,,Бұл дәл «қуалап ұстау» ойыны сияқты.
Dialogue: 0,0:14:46.99,0:14:49.53,Default,,0,0,0,,Бұзық сөзге болмайды!
Dialogue: 0,0:14:49.63,0:14:52.19,Default,,0,0,0,,Міне, мұғалімдер қиыншылықта.
Dialogue: 0,0:14:52.22,0:14:54.25,Default,,0,0,0,,Барлығы оны асыға күтеді!
Dialogue: 0,0:14:55.97,0:14:57.48,Default,,0,0,0,,Саса! Өтінемін
Dialogue: 0,0:15:04.87,0:15:07.59,Default,,0,0,0,,Өз бетінше өмір сүруге әбден болады.
Dialogue: 0,0:15:07.96,0:15:10.42,Default,,0,0,0,,Бұл пайдалы емес.
Dialogue: 0,0:15:10.45,0:15:14.55,Default,,0,0,0,,Куросава мырза ше? Өте танымал сияқты
Dialogue: 0,0:15:14.63,0:15:15.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:15.72,0:15:18.79,Default,,0,0,0,,Саса! Мен сізді күтемін, Куросава-сенсэй!
Dialogue: 0,0:15:18.82,0:15:20.61,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:15:23.55,0:15:24.36,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:15:28.56,0:15:30.27,Default,,0,0,0,,Өйткені мен де жалғызбын...
Dialogue: 0,0:15:30.66,0:15:32.96,Default,,0,0,0,,Ондай ештеңе жоқ.
Dialogue: 0,0:15:33.07,0:15:34.92,Default,,0,0,0,,Сіздің үмітіңізді ақтамағаным үшін кешіріңіз.
Dialogue: 0,0:15:35.87,0:15:36.86,Default,,0,0,0,,Не...
Dialogue: 0,0:15:38.69,0:15:41.25,Default,,0,0,0,,Өткен жазда мен жалғыз болған жоқпын.
Dialogue: 0,0:15:42.27,0:15:42.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:53.30,0:15:55.30,Default,,0,0,0,,Мен аздап күйзеліп жатырмын.
Dialogue: 0,0:15:55.33,0:15:56.53,Default,,0,0,0,,Асоя
Dialogue: 0,0:15:56.72,0:15:59.18,Default,,0,0,0,,Не? Тағы бір елес оқиға?
Dialogue: 0,0:15:59.34,0:16:03.20,Default,,0,0,0,,Мұндай жағдайларда сериялық кісі өлтірулер болуы мүмкін деп ойламаймын.
Dialogue: 0,0:16:03.26,0:16:04.89,Default,,0,0,0,,Егер сіз драма жасасаңыз
Dialogue: 0,0:16:04.92,0:16:06.37,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:08.13,0:16:10.46,Default,,0,0,0,,бір адам екінші адам
Dialogue: 0,0:16:11.10,0:16:14.82,Default,,0,0,0,,Сіз білмей тұрып жоғалып кеттім деп ойлаған кезде...
Dialogue: 0,0:16:14.99,0:16:16.24,Default,,0,0,0,,О, бұл жақсы.
Dialogue: 0,0:16:17.52,0:16:18.73,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:16:19.99,0:16:22.11,Default,,0,0,0,,Бірінші құрбан Томо-чан...
Dialogue: 0,0:16:23.16,0:16:24.22,Default,,0,0,0,,Және…
Dialogue: 0,0:16:24.25,0:16:26.69,Default,,0,0,0,,Барлығы бірінен соң бірі өлтірілуде
Dialogue: 0,0:16:28.80,0:16:29.84,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:16:30.92,0:16:33.72,Default,,0,0,0,,Сонда? …
Dialogue: 0,0:16:34.35,0:16:36.00,Default,,0,0,0,,Кінәлі менмін
Dialogue: 0,0:16:36.10,0:16:37.42,Default,,0,0,0,,Сіз кінәлісіз бе?
Dialogue: 0,0:16:37.55,0:16:40.05,Default,,0,0,0,,А, бұл жақсы емес.
Dialogue: 0,0:16:40.61,0:16:41.84,Default,,0,0,0,,Аа, дұрыс!
Dialogue: 0,0:16:41.87,0:16:44.33,Default,,0,0,0,,Жазғы түн десең, сол түн ғой.
Dialogue: 0,0:16:54.78,0:16:57.63,Default,,0,0,0,,Оны маған біреу сатып алды, сондықтан мен бәріне онымен көңіл көтеруді айттым.
Dialogue: 0,0:16:58.27,0:17:01.21,Default,,0,0,0,,Сакаки-сан от шашуға шебер.
Dialogue: 0,0:17:01.28,0:17:01.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:01.94,0:17:02.90,Default,,0,0,0,,О
Dialogue: 0,0:17:32.41,0:17:34.58,Default,,0,0,0,,Әй, жақсы.
Dialogue: 0,0:17:35.11,0:17:37.41,Default,,0,0,0,,Мен үйге бармай-ақ осында қалғым келеді.
Dialogue: 0,0:17:37.56,0:17:38.99,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:17:40.08,0:17:40.72,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:41.33,0:17:41.81,Default,,0,0,0,,Бірақ?
Dialogue: 0,0:17:43.19,0:17:46.14,Default,,0,0,0,,Немесе мен үйге тірі қайтқым келеді.
Dialogue: 0,0:17:46.16,0:17:47.29,Default,,0,0,0,,Юкари көлігі...
Dialogue: 0,0:17:47.32,0:17:49.89,Default,,0,0,0,,Мен тас-қағаз-қайшыдан әлсізмін!
Dialogue: 0,0:18:07.04,0:18:09.82,Default,,0,0,0,,Бүгін жазғы демалыстың соңғы күні болса да
Dialogue: 0,0:18:18.92,0:18:22.04,Default,,0,0,0,,Қайырлы таң! Барлығы қалай болды?
Dialogue: 0,0:18:22.10,0:18:24.88,Default,,0,0,0,,Мен жазғы каникулда жасаған саяхатымнан фотолар әкелдім!
Dialogue: 0,0:18:24.96,0:18:26.11,Default,,0,0,0,,Көрсет, көрсет
Dialogue: 0,0:18:26.14,0:18:27.56,Default,,0,0,0,,О, мен де!
Dialogue: 0,0:18:27.58,0:18:29.66,Default,,0,0,0,,Мен сенімен барғым келді.
Dialogue: 0,0:18:29.84,0:18:33.26,Default,,0,0,0,,Егер бұл менің клубымның оқу-жаттығу жиынымен сәйкес келмесе, мен бара алар едім...
Dialogue: 0,0:18:33.37,0:18:34.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:42.51,0:18:44.57,Default,,0,0,0,,Тоқта, Сакаки-сан да кетті ме?
Dialogue: 0,0:18:44.71,0:18:46.29,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:18:48.00,0:18:50.15,Default,,0,0,0,,Мен неге ол жерде болған жоқпын?
Dialogue: 0,0:18:50.22,0:18:52.78,Default,,0,0,0,,Сондықтан бұл клубтық оқу-жаттығу жиыны.
Dialogue: 0,0:19:06.17,0:19:07.16,Default,,0,0,0,,О, бұл
Dialogue: 0,0:19:07.18,0:19:09.55,Default,,0,0,0,,Менің ұйықтай алмай жатқан сияқтымын.
Dialogue: 0,0:19:09.59,0:19:10.49,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:19:10.52,0:19:13.13,Default,,0,0,0,,Жоқ, себебін сұрасаңыз да...
Dialogue: 0,0:19:21.89,0:19:23.07,Default,,0,0,0,,Не?Бұл
Dialogue: 0,0:19:23.19,0:19:24.93,Default,,0,0,0,,О, мынау соған қатысты көлік.
Dialogue: 0,0:19:25.09,0:19:26.87,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:19:27.20,0:19:29.72,Default,,0,0,0,,Нечиё-чан қиын кезеңді бастан өткерген сияқты
Dialogue: 0,0:19:31.88,0:19:33.18,Default,,0,0,0,,Чио-чан
Dialogue: 0,0:19:33.63,0:19:35.04,Default,,0,0,0,,Пён
Dialogue: 0,0:19:35.79,0:19:37.22,Default,,0,0,0,,Тоқтаңыз
Dialogue: 0,0:19:38.18,0:19:40.65,Default,,0,0,0,,Юкари-сенсэй, тоқташы өтінемін.
Dialogue: 0,0:19:40.67,0:19:42.27,Default,,0,0,0,,Тоқтаңыз
Dialogue: 0,0:19:42.67,0:19:45.47,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,0:19:45.80,0:19:48.97,Default,,0,0,0,,Жоқ, сен өлесің...
Dialogue: 0,0:19:49.32,0:19:52.65,Default,,0,0,0,,Ата! Ата! ! !
Dialogue: 0,0:19:53.32,0:19:55.35,Default,,0,0,0,,Қаш! !
Dialogue: 0,0:19:57.45,0:20:00.32,Default,,0,0,0,,Сакаки-сан! Мен сапардан фотолар саламын!
Dialogue: 0,0:20:01.96,0:20:04.44,Default,,0,0,0,,Менің достарыммен алғашқы сапарымнан түскен суреттер
Dialogue: 0,0:20:06.21,0:20:07.02,Default,,0,0,0,,Рахмет
Dialogue: 0,0:20:10.08,0:20:11.32,Default,,0,0,0,,Сіз мұны байқадыңыз ба?
Dialogue: 0,0:20:11.69,0:20:14.95,Default,,0,0,0,,Артыңызда адам жүзіне ұқсайды.
Dialogue: 0,0:20:18.89,0:20:20.64,Default,,0,0,0,,Аа, бұл рас.
Dialogue: 0,0:20:27.46,0:20:31.09,Default,,0,0,0,,Жақсы, Сакаки-сан, мына суретке түсіріп тұрсың.
Dialogue: 0,0:20:37.75,0:20:39.53,Default,,0,0,0,,Мен Осакада болған кезім еді.
Dialogue: 0,0:20:39.55,0:20:42.12,Default,,0,0,0,,Жақын жерде тұратын Хорикос мырза
Dialogue: 0,0:20:52.04,0:20:53.46,Default,,0,0,0,,Күйіп қалған шығар.
Dialogue: 0,0:21:02.06,0:21:03.78,Default,,0,0,0,,Иә, бүгін екінші семестр басталады.
Dialogue: 0,0:21:03.88,0:21:06.06,Default,,0,0,0,,Барлығымыз жақсы оқиық
Dialogue: 0,0:21:06.40,0:21:08.72,Default,,0,0,0,,Осылай жазғы демалыс аяқталды.
Dialogue: 0,0:21:08.74,0:21:11.15,Default,,0,0,0,,Барлығы бір жерге шықты ма?
Dialogue: 0,0:21:11.18,0:21:14.05,Default,,0,0,0,,Соңында әртүрлі себептермен ешқайда бара алмадым.
Dialogue: 0,0:21:14.15,0:21:16.37,Default,,0,0,0,,О, бұл ұят болды.
Dialogue: 0,0:21:16.65,0:21:19.18,Default,,0,0,0,,Астрономия клубының оқу-жаттығу лагерінен басқа кез келген жерде
Dialogue: 0,0:21:19.20,0:21:21.82,Default,,0,0,0,,О, бұл ұят болды.
Dialogue: 0,0:21:26.03,0:21:26.91,Default,,0,0,0,,Қазір!
Dialogue: 0,0:21:27.26,0:21:29.66,Default,,0,0,0,,Жазғы демалысыңыз қаншалықты қызықты болса, соғұрлым қызықты болады.
Dialogue: 0,0:21:29.69,0:21:31.01,Default,,0,0,0,,Кейінірек не келеді
Dialogue: 0,0:21:31.03,0:21:32.20,Default,,0,0,0,,Жазғы демалыстың бұлыңғырлығы
Dialogue: 0,0:21:32.24,0:21:34.38,Default,,0,0,0,,Қызық, сыныптағылардың бәрі жақсы ма?
Dialogue: 0,0:21:34.70,0:21:37.41,Default,,0,0,0,,Сонда ең қауіптісі мұғалім емес пе?
Dialogue: 0,0:21:37.43,0:21:39.38,Default,,0,0,0,,Иә! Сіз айтқандай!
Dialogue: 0,0:21:39.60,0:21:44.18,Default,,0,0,0,,Аа, Даруу, қысқы демалыс қашан басталады...
Dialogue: 0,0:21:46.17,0:21:53.75,Default,,0,0,0,,(Юкаридің ұйқысы)
Dialogue: 0,0:21:59.18,0:22:01.74,Default,,0,0,0,,Жүрегіңде қанат қағып
Dialogue: 0,0:22:03.36,0:22:06.46,Default,,0,0,0,,Жүрегіңдегі сыбырларды айт
Dialogue: 0,0:22:07.61,0:22:10.29,Default,,0,0,0,,Енді желде
Dialogue: 0,0:22:13.95,0:22:16.51,Default,,0,0,0,,Жүрек жұлдыздардың сыртында
Dialogue: 0,0:22:18.18,0:22:21.32,Default,,0,0,0,,Тілектер әрқашан орындалады
Dialogue: 0,0:22:22.39,0:22:30.00,Default,,0,0,0,,Кел мені көр, кілті болашақтың
Dialogue: 0,0:22:31.13,0:22:35.28,Default,,0,0,0,,Терезеге ақырын шақырған дауыс
Dialogue: 0,0:22:35.38,0:22:39.12,Default,,0,0,0,,Махаббатты алдын ала ескерту және
Dialogue: 0,0:22:39.68,0:22:43.32,Default,,0,0,0,,Махаббат әлі алыс болса да
Dialogue: 0,0:22:43.62,0:22:45.60,Default,,0,0,0,,Мен ертеңге сенемін
Dialogue: 0,0:22:45.63,0:22:47.64,Default,,0,0,0,,Мен саған сенемін
Dialogue: 0,0:22:47.76,0:22:49.61,Default,,0,0,0,,Таңқурай аспаны
Dialogue: 0,0:22:49.65,0:22:55.10,Default,,0,0,0,,Жалғыз болмаймын деп уәде бердің, аспан
Dialogue: 0,0:22:56.24,0:22:58.05,Default,,0,0,0,,Таңқурай аспаны
Dialogue: 0,0:22:58.12,0:22:59.78,Default,,0,0,0,,Тәтті көз жас
Dialogue: 0,0:23:00.18,0:23:04.51,Default,,0,0,0,,Жұмақта тағы да күлімде
Dialogue: 0,0:23:04.74,0:23:06.49,Default,,0,0,0,,Таңқурай аспаны
Dialogue: 0,0:23:06.57,0:23:12.05,Default,,0,0,0,,Мен сені нәзік армандардың аспанына алып кетуге келдім
Dialogue: 0,0:23:13.20,0:23:16.86,Default,,0,0,0,,Таңқурай аспаны, мен саған қайтамын
Dialogue: 0,0:23:17.16,0:23:21.48,Default,,0,0,0,,Жұмақ гүлі жайқалған күні
Dialogue: 0,0:23:21.61,0:23:23.58,Default,,0,0,0,,Сен және мен...
Dialogue: 0,0:23:24.19,0:23:28.46,Default,,0,0,0,,Бірге кездесейік
Dialogue: 0,0:23:33.67,0:23:36.09,Default,,0,0,0,,Келесі Азуманга Дайохтың тақырыбы
Dialogue: 0,0:23:36.11,0:23:37.08,Default,,0,0,0,,Жеңіс!
Dialogue: 0,0:23:37.17,0:23:40.02,Default,,0,0,0,,Жеңіс деген екі сөзді жүрегіңде сақта!
Dialogue: 0,0:23:40.12,0:23:41.82,Default,,0,0,0,,Және жең!
Dialogue: 0,0:23:42.02,0:23:44.38,Default,,0,0,0,,Юкари-сенсэй барын салып жатыр.
Dialogue: 0,0:23:44.57,0:23:47.28,Default,,0,0,0,,Олар спорт мерекесіне шынымен бәс тігуде.
Dialogue: 0,0:23:47.30,0:23:50.59,Default,,0,0,0,,Жеңіске жетемін десең де, бұл 5-сынып! Nyamono сыныбы!
Dialogue: 0,0:23:50.62,0:23:53.01,Default,,0,0,0,,Бұл басқа нәрсені білдіреді ме?
Dialogue: 0,0:23:53.18,0:23:54.84,Default,,0,0,0,,Жеңіске жетсем, саған бірдеңе сыйлаймын!
Dialogue: 0,0:23:56.34,0:24:02.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory