Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.02,0:01:48.04,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:48.04,0:01:52.04,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,0:01:55.71,0:01:57.71,Default,,0000,0000,0000,,Чиёчан….
Dialogue: 0,0:01:57.71,0:02:02.48,Default,,0000,0000,0000,,Чио-чан не үшін ұшады?
Dialogue: 0,0:02:02.48,0:02:05.99,Default,,0000,0000,0000,,Чиё: Хахахаха! Ахахха!
Dialogue: 0,0:02:05.99,0:02:08.82,Default,,0000,0000,0000,,Хахаха Ахахха!
Dialogue: 0,0:02:08.82,0:02:11.83,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:02:11.83,0:02:20.50,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:20.50,0:02:22.50,Default,,0000,0000,0000,,Чиёчан.
Dialogue: 0,0:02:28.51,0:02:30.51,Default,,0000,0000,0000,,Неге ұшасыз?
Dialogue: 0,0:02:36.52,0:02:38.52,Default,,0000,0000,0000,,Мен 10 жастамын.
Dialogue: 0,0:02:38.52,0:02:58.62,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:03:02.31,0:03:04.31,Default,,0000,0000,0000,,Ахаха.
Dialogue: 0,0:03:07.82,0:03:10.49,Default,,0000,0000,0000,,Осака да ұшады ма?
Dialogue: 0,0:03:10.49,0:03:12.65,Default,,0000,0000,0000,,Не? Сіз ұша аласыз ба?
Dialogue: 0,0:03:12.65,0:03:15.05,Default,,0000,0000,0000,,Мен оны сізге тегін беремін.
Dialogue: 0,0:03:17.33,0:03:20.83,Default,,0000,0000,0000,,Иә, өтінемін.
Dialogue: 0,0:03:17.33,0:03:20.83,Default,,0000,0000,0000,,Бұл сізде болса, тегін ұша аласыз ба?
Dialogue: 0,0:03:20.83,0:03:22.83,Default,,0000,0000,0000,,Мәңгі.
Dialogue: 0,0:03:22.83,0:03:24.83,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:03:28.84,0:03:31.51,Default,,0000,0000,0000,,Енді бұл сізге жақсы көрінеді.
Dialogue: 0,0:03:31.51,0:03:36.01,Default,,0000,0000,0000,,Ал, мен...
Dialogue: 0,0:03:36.01,0:03:39.68,Default,,0000,0000,0000,,А, бұл сізге керек емес пе? Танымал болса да.
Dialogue: 0,0:03:39.68,0:03:41.68,Default,,0000,0000,0000,,Не болды!
Dialogue: 0,0:03:41.68,0:03:43.68,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:03:49.69,0:03:53.53,Default,,0000,0000,0000,,《Дұрыс... Чиё-чан сондай➡
Dialogue: 0,0:03:53.53,0:03:55.63,Default,,0000,0000,0000,,Мені манипуляциялауда...》
Dialogue: 0,0:03:59.03,0:04:01.03,Default,,0000,0000,0000,,Оң.
Dialogue: 0,0:04:02.97,0:04:04.97,Default,,0000,0000,0000,,Солға.
Dialogue: 0,0:04:06.98,0:04:09.14,Default,,0000,0000,0000,,Полиция қызметкері.
Dialogue: 0,0:04:09.14,0:04:11.14,Default,,0000,0000,0000,,Абайлаңыз.
Dialogue: 0,0:04:14.65,0:04:16.65,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:04:25.99,0:04:30.00,Default,,0000,0000,0000,,Чиё-чан, мен саған көмектесемін!
Dialogue: 0,0:04:30.00,0:04:33.67,Default,,0000,0000,0000,,Хамф!
Dialogue: 0,0:04:30.00,0:04:33.67,Default,,0000,0000,0000,,(Шошқалардың құлаған дыбысы)
Dialogue: 0,0:04:33.67,0:04:36.37,Default,,0000,0000,0000,,(құстардың сайрауы)
Dialogue: 0,0:04:38.34,0:04:40.84,Default,,0000,0000,0000,,(құстардың сайрауы)
Dialogue: 0,0:04:43.01,0:04:45.01,Default,,0000,0000,0000,,Ах! ?
Dialogue: 0,0:04:48.18,0:04:50.85,Default,,0000,0000,0000,,Хокухоку~.
Dialogue: 0,0:04:50.85,0:04:54.02,Default,,0000,0000,0000,,Ju~.
Dialogue: 0,0:04:54.02,0:04:56.32,Default,,0000,0000,0000,,Торо~н.
Dialogue: 0,0:05:01.13,0:05:03.80,Default,,0000,0000,0000,,Күрсін.
Dialogue: 0,0:05:03.80,0:05:06.80,Default,,0000,0000,0000,,Кешіріңіз, Чио-чан….
Dialogue: 0,0:05:06.80,0:05:09.47,Default,,0000,0000,0000,,Мен оны қате алып тастадым...
Dialogue: 0,0:05:09.47,0:05:16.31,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:05:16.31,0:05:20.01,Default,,0000,0000,0000,,Мен
Dialogue: 0,0:05:16.31,0:05:20.01,Default,,0000,0000,0000,,Кет!
Dialogue: 0,0:05:22.15,0:05:24.15,Default,,0000,0000,0000,,Әй...
Dialogue: 0,0:05:24.15,0:05:32.65,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:05:35.83,0:05:39.13,Default,,0000,0000,0000,,(құстардың сайрауы)
Dialogue: 0,0:05:41.84,0:05:45.84,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,0:05:47.84,0:05:51.35,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:05:51.35,0:05:53.85,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:05:53.85,0:05:56.52,Default,,0000,0000,0000,,Сатоси: Уау!
Dialogue: 0,0:05:56.52,0:05:59.35,Default,,0000,0000,0000,,Уау! Апыр-ай! Апыр-ай!
Dialogue: 0,0:05:59.35,0:06:01.46,Default,,0000,0000,0000,,Уау! Апыр-ай! Апыр-ай!
Dialogue: 0,0:06:01.46,0:06:04.79,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:06:04.79,0:06:07.80,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:06:07.80,0:06:10.97,Default,,0000,0000,0000,,Ла ла ла~!
Dialogue: 0,0:06:10.97,0:06:15.77,Default,,0000,0000,0000,,Ла~ла ла ла ла~! Lu~lulululu~!
Dialogue: 0,0:06:24.48,0:06:27.98,Default,,0000,0000,0000,,Руппан.
Dialogue: 0,0:06:24.48,0:06:27.98,Default,,0000,0000,0000,,Профессор Такаянаги
Dialogue: 0,0:06:27.98,0:06:33.16,Default,,0000,0000,0000,,Кя~! Банк тонау!
Dialogue: 0,0:06:33.16,0:06:36.32,Default,,0000,0000,0000,,Не болды! Апыр-ай!
Dialogue: 0,0:06:36.32,0:06:39.16,Default,,0000,0000,0000,,Керемет жұмыс Сатоси Такино!
Dialogue: 0,0:06:39.16,0:06:41.33,Default,,0000,0000,0000,,Банк тонаушыны нокаутқа түсіріңіз!
Dialogue: 0,0:06:41.33,0:06:44.50,Default,,0000,0000,0000,,Жоқ, жоқ, жоқ
Dialogue: 0,0:06:41.33,0:06:44.50,Default,,0000,0000,0000,,Бұл үлкен мәселе емес.
Dialogue: 0,0:06:44.50,0:06:49.34,Default,,0000,0000,0000,,Ахх, менің Тама-чанымды басып бара жатыр!
Dialogue: 0,0:06:49.34,0:06:51.84,Default,,0000,0000,0000,,Қазір кеттік!
Dialogue: 0,0:06:51.84,0:06:54.51,Default,,0000,0000,0000,,Көше қиылысында кішкентай әсер!
Dialogue: 0,0:06:54.51,0:06:58.01,Default,,0000,0000,0000,,Котенканы құтқарған супер мектеп оқушысы
Dialogue: 0,0:06:54.51,0:06:58.01,Default,,0000,0000,0000,,Сатоси Такино!
Dialogue: 0,0:06:58.01,0:07:01.45,Default,,0000,0000,0000,,Жоқ, жоқ, жоқ
Dialogue: 0,0:06:58.01,0:07:01.45,Default,,0000,0000,0000,,Бұл үлкен мәселе емес.
Dialogue: 0,0:07:01.45,0:07:03.45,Default,,0000,0000,0000,,Кя~!
Dialogue: 0,0:07:08.29,0:07:10.29,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:07:10.29,0:07:14.13,Default,,0000,0000,0000,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:14.13,0:07:16.97,Default,,0000,0000,0000,,10 жыл қатарынан! Сатоси Такино!
Dialogue: 0,0:07:16.97,0:07:19.80,Default,,0000,0000,0000,,Биыл тағы да сұлулық байқауында 1 орын!
Dialogue: 0,0:07:19.80,0:07:23.31,Default,,0000,0000,0000,,Жоқ, жоқ, жоқ
Dialogue: 0,0:07:19.80,0:07:23.31,Default,,0000,0000,0000,,Бұл үлкен мәселе емес.
Dialogue: 0,0:07:23.31,0:07:26.64,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:07:26.64,0:07:29.81,Default,,0000,0000,0000,,О...!
Dialogue: 0,0:07:29.81,0:07:32.65,Default,,0000,0000,0000,,Кя~! Сондай сүйкімді!
Dialogue: 0,0:07:32.65,0:07:35.48,Default,,0000,0000,0000,,Уау! Ах!
Dialogue: 0,0:07:35.48,0:07:38.78,Default,,0000,0000,0000,,Жоқ, жоқ, жоқ
Dialogue: 0,0:07:35.48,0:07:38.78,Default,,0000,0000,0000,,Бұл үлкен мәселе емес.
Dialogue: 0,0:07:41.32,0:07:44.49,Default,,0000,0000,0000,,Жоқ, жоқ….
Dialogue: 0,0:07:44.49,0:07:48.09,Default,,0000,0000,0000,,Бұл үлкен мәселе емес.
Dialogue: 0,0:07:50.67,0:07:54.17,Default,,0000,0000,0000,,Юкари: Олай болса.
Dialogue: 0,0:07:50.67,0:07:54.17,Default,,0000,0000,0000,,Осы уақыт ішінде сынақты қайтарады.
Dialogue: 0,0:07:54.17,0:07:57.01,Default,,0000,0000,0000,,Бұл жолғы ең жақсы адам - ​​Сатоси Такино!
Dialogue: 0,0:07:57.01,0:07:59.94,Default,,0000,0000,0000,,Ｉ ｈａｖｅ ｎｏｔｈｉｎｇ ｔｏ ｔｅａｃｈ ｙｏｕ．
Dialogue: 0,0:07:59.94,0:08:02.61,Default,,0000,0000,0000,,Ｔｈａｎｋｓ ｔｏ Ｍｉｓｓ ｙｕｋａｒｉ．
Dialogue: 0,0:08:02.61,0:08:05.78,Default,,0000,0000,0000,,Ой~!
Dialogue: 0,0:08:02.61,0:08:05.78,Default,,0000,0000,0000,,Не болды, Чио-чан?
Dialogue: 0,0:08:05.78,0:08:08.95,Default,,0000,0000,0000,,0 ұпай болды...
Dialogue: 0,0:08:08.95,0:08:11.45,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:08:11.45,0:08:15.12,Default,,0000,0000,0000,,Мен 100 ұпай алдым.
Dialogue: 0,0:08:11.45,0:08:15.12,Default,,0000,0000,0000,,Мен жеңіліп қалсам, жарайды.
Dialogue: 0,0:08:15.12,0:08:17.63,Default,,0000,0000,0000,,Томо-чан сондай мейірімді.
Dialogue: 0,0:08:17.63,0:08:20.33,Default,,0000,0000,0000,,Бұл дұрыс емес
Dialogue: 0,0:08:17.63,0:08:20.33,Default,,0000,0000,0000,,Мұқият қараңыз.
Dialogue: 0,0:08:22.63,0:08:25.97,Default,,0000,0000,0000,,Ха! 100-ден 100 ұпай!
Dialogue: 0,0:08:25.97,0:08:29.30,Default,,0000,0000,0000,,Бұл керемет!
Dialogue: 0,0:08:25.97,0:08:29.30,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:08:29.30,0:08:31.64,Default,,0000,0000,0000,,Менің ойымша, бұл Томо-чанда бар➡
Dialogue: 0,0:08:31.64,0:08:34.64,Default,,0000,0000,0000,,Мен оны жеңе алмаймын. Бұл керемет.
Dialogue: 0,0:08:34.64,0:08:38.15,Default,,0000,0000,0000,,Ондай нәрсе жоқ.
Dialogue: 0,0:08:38.15,0:08:40.48,Default,,0000,0000,0000,,Мизухара-сан.
Dialogue: 0,0:08:40.48,0:08:43.15,Default,,0000,0000,0000,,Мизухара-сан, сен сонда емессің бе?
Dialogue: 0,0:08:43.15,0:08:45.49,Default,,0000,0000,0000,,Сәлем Мизувон!
Dialogue: 0,0:08:45.49,0:08:47.49,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:08:45.49,0:08:47.49,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:47.49,0:08:50.66,Default,,0000,0000,0000,,Мизухара мырза 0 ұпаймен.
Dialogue: 0,0:08:47.49,0:08:50.66,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:08:50.66,0:08:54.50,Default,,0000,0000,0000,,А, мен көмектесе алмаймын ...
Dialogue: 0,0:08:54.50,0:08:57.00,Default,,0000,0000,0000,,Мұғалім қоңырау шалып жатыр. Қараңыз.
Dialogue: 0,0:08:57.00,0:08:59.33,Default,,0000,0000,0000,,Уф, кешіріңіз.
Dialogue: 0,0:08:59.33,0:09:01.27,Default,,0000,0000,0000,,Қандай жағдай болмасын, біз доспыз, солай ма?
Dialogue: 0,0:09:01.27,0:09:04.94,Default,,0000,0000,0000,,(Хироко) Шынымен бе? (Косэй) Иә.
Dialogue: 0,0:09:01.27,0:09:04.94,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:09:04.94,0:09:23.12,Default,,0000,0000,0000,,Неліктен жоқ? Неге жоқ!
Dialogue: 0,0:09:23.12,0:09:25.32,Default,,0000,0000,0000,,Неліктен жоқ? Неге жоқ!
Dialogue: 0,0:09:27.30,0:09:35.14,Default,,0000,0000,0000,,Неліктен жоқ? Неге жоқ!
Dialogue: 0,0:09:35.14,0:09:37.81,Default,,0000,0000,0000,,Әже….
Dialogue: 0,0:09:37.81,0:09:39.98,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:09:39.98,0:09:43.78,Default,,0000,0000,0000,,(құстардың сайрауы)
Dialogue: 0,0:09:47.65,0:09:51.65,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,0:09:57.66,0:09:59.66,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:09:59.66,0:10:18.01,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:10:18.01,0:10:20.85,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:10:20.85,0:10:22.85,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,0:10:30.19,0:10:33.36,Default,,0000,0000,0000,,(қоңырау дыбысы)
Dialogue: 0,0:10:33.36,0:10:35.36,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:10:35.36,0:10:38.37,Default,,0000,0000,0000,,Сакаки-сан
Dialogue: 0,0:10:35.36,0:10:38.37,Default,,0000,0000,0000,,Қайырлы таң!
Dialogue: 0,0:10:38.37,0:10:42.54,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:10:38.37,0:10:42.54,Default,,0000,0000,0000,,Мына жақта, былай!
Dialogue: 0,0:10:42.54,0:10:46.21,Default,,0000,0000,0000,,Қайырлы таң, Сакаки-сан!
Dialogue: 0,0:10:46.21,0:10:48.88,Default,,0000,0000,0000,,О... Қайырлы таң.
Dialogue: 0,0:10:48.88,0:10:52.55,Default,,0000,0000,0000,,Сакаки-санға
Dialogue: 0,0:10:48.88,0:10:52.55,Default,,0000,0000,0000,,Мен сендерге сүйкімді мысық сыйлағым келеді.
Dialogue: 0,0:10:52.55,0:10:56.05,Default,,0000,0000,0000,,Бірақ біз
Dialogue: 0,0:10:52.55,0:10:56.05,Default,,0000,0000,0000,,Себебі менің анам аллергиямен ауырады.
Dialogue: 0,0:10:56.05,0:10:59.55,Default,,0000,0000,0000,,Бірақ бұл мысық
Dialogue: 0,0:10:56.05,0:10:59.55,Default,,0000,0000,0000,,Өйткені ол тасталған➡
Dialogue: 0,0:10:59.55,0:11:01.82,Default,,0000,0000,0000,,Біз үлкен қиындыққа тап болдық.
Dialogue: 0,0:11:01.82,0:11:03.82,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:06.49,0:11:08.49,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:11:06.49,0:11:08.49,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:11:12.17,0:12:05.15,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:12:05.15,0:12:07.16,Default,,0000,0000,0000,,Сізге мысықтар ұнайды ма?
Dialogue: 0,0:12:07.16,0:12:09.16,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:12:09.16,0:12:19.17,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:12:19.17,0:12:22.50,Default,,0000,0000,0000,,Менің мысық екенімді білген соң солай айтқың келді ме?
Dialogue: 0,0:12:22.50,0:12:24.51,Default,,0000,0000,0000,,Ух... иә.
Dialogue: 0,0:12:24.51,0:12:27.81,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:12:29.84,0:12:37.19,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:12:37.19,0:12:43.19,Default,,0000,0000,0000,,(Жапырақтардың түсу дыбысы)
Dialogue: 0,0:12:43.19,0:13:01.98,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:13:01.98,0:13:04.31,Default,,0000,0000,0000,,Олай болса, қош бол.
Dialogue: 0,0:13:04.31,0:13:06.31,Default,,0000,0000,0000,,Неге! ?
Dialogue: 0,0:13:06.31,0:13:09.48,Default,,0000,0000,0000,,Негізі мен мұндай болсам да, мысық емеспін.
Dialogue: 0,0:13:09.48,0:13:11.82,Default,,0000,0000,0000,,Чионың әкесі.
Dialogue: 0,0:13:11.82,0:13:15.32,Default,,0000,0000,0000,,Менің қызым әрқашан
Dialogue: 0,0:13:11.82,0:13:15.32,Default,,0000,0000,0000,,Көмегің үшін рахмет.
Dialogue: 0,0:13:15.32,0:13:17.99,Default,,0000,0000,0000,,А, жоқ... жарайсың.
Dialogue: 0,0:13:17.99,0:13:20.66,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:13:17.99,0:13:20.66,Default,,0000,0000,0000,,Сізде нағыз мысық бар➡
Dialogue: 0,0:13:20.66,0:13:24.00,Default,,0000,0000,0000,,Оны іздеңіз, бірақ дәл қазір бұл мүмкін емес.
Dialogue: 0,0:13:24.00,0:13:26.00,Default,,0000,0000,0000,,Не? Не істеуім керек!
Dialogue: 0,0:13:26.00,0:13:28.00,Default,,0000,0000,0000,,Менен сұрасаң да.
Dialogue: 0,0:13:28.00,0:13:30.00,Default,,0000,0000,0000,,Уф, күте тұрыңыз!
Dialogue: 0,0:13:37.35,0:13:39.35,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:13:39.35,0:13:41.85,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:13:45.02,0:13:47.32,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:13:55.20,0:13:58.70,Default,,0000,0000,0000,,Түсіндім. Чио-чан, Чика.
Dialogue: 0,0:13:58.70,0:14:00.97,Default,,0000,0000,0000,,Қош келдіңіз.
Dialogue: 0,0:14:00.97,0:14:02.97,Default,,0000,0000,0000,,Алға, алға.
Dialogue: 0,0:14:05.81,0:14:07.81,Default,,0000,0000,0000,,Алға, алға.
Dialogue: 0,0:14:10.81,0:14:12.81,Default,,0000,0000,0000,,Мен үйдемін.
Dialogue: 0,0:14:12.81,0:14:14.82,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:14:14.82,0:14:17.32,Default,,0000,0000,0000,,(Айсбергтің жарылған дыбысы)
Dialogue: 0,0:14:17.32,0:14:20.49,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:14:20.49,0:14:23.32,Default,,0000,0000,0000,,Уф, аа, фу...!
Dialogue: 0,0:14:23.32,0:14:26.16,Default,,0000,0000,0000,,Уф, уф, бұл!
Dialogue: 0,0:14:26.16,0:14:29.33,Default,,0000,0000,0000,,Ах~ бұл адам
Dialogue: 0,0:14:26.16,0:14:29.33,Default,,0000,0000,0000,,Мен көмекшімін.
Dialogue: 0,0:14:29.33,0:14:31.33,Default,,0000,0000,0000,,Көмекші?
Dialogue: 0,0:14:31.33,0:14:33.67,Default,,0000,0000,0000,,Иә, мен саған бөлме жинаймын.
Dialogue: 0,0:14:33.67,0:14:37.34,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:14:37.34,0:14:39.34,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:14:39.34,0:14:55.36,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:14:55.36,0:14:58.36,Default,,0000,0000,0000,,Кейде ойлар
Dialogue: 0,0:14:55.36,0:14:58.36,Default,,0000,0000,0000,,Ол тоқтайды.
Dialogue: 0,0:14:58.36,0:15:00.30,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,0:15:00.30,0:15:02.80,Default,,0000,0000,0000,,Не? Ааа.
Dialogue: 0,0:15:02.80,0:15:07.30,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:15:07.30,0:15:12.97,Default,,0000,0000,0000,,(Айсбергтің құлаған дыбысы)
Dialogue: 0,0:15:12.97,0:15:15.64,Default,,0000,0000,0000,,(уақыт сигналының дыбысы)
Dialogue: 0,0:15:15.64,0:15:17.65,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:15:17.65,0:15:19.81,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:15:17.65,0:15:19.81,Default,,0000,0000,0000,,《Сакаки: Қалай ойлайсың?》
Dialogue: 0,0:15:19.81,0:15:23.65,Default,,0000,0000,0000,,Сіз доссыз ба?
Dialogue: 0,0:15:19.81,0:15:23.65,Default,,0000,0000,0000,,Иә, менің атым Сакаки-сан.
Dialogue: 0,0:15:23.65,0:15:27.32,Default,,0000,0000,0000,,Қош келдіңіз, бұл Чиёның әкесі.
Dialogue: 0,0:15:27.32,0:15:30.66,Default,,0000,0000,0000,,Менің қызым әрқашан
Dialogue: 0,0:15:27.32,0:15:30.66,Default,,0000,0000,0000,,Көмегің үшін рахмет.
Dialogue: 0,0:15:30.66,0:15:35.00,Default,,0000,0000,0000,,Аа, жоқ...
Dialogue: 0,0:15:30.66,0:15:35.00,Default,,0000,0000,0000,,Иә, кешкі асты бірге ішсек ше?
Dialogue: 0,0:15:35.00,0:15:38.67,Default,,0000,0000,0000,,Жоқ, солай.
Dialogue: 0,0:15:35.00,0:15:38.67,Default,,0000,0000,0000,,Ал, тартынба.
Dialogue: 0,0:15:38.67,0:15:42.34,Default,,0000,0000,0000,,Ішінде қызыл түсті де бар.
Dialogue: 0,0:15:42.34,0:15:46.04,Default,,0000,0000,0000,,Ұстамаңыз.
Dialogue: 0,0:15:42.34,0:15:46.04,Default,,0000,0000,0000,,《Қызыл? 》
Dialogue: 0,0:15:48.18,0:15:51.35,Default,,0000,0000,0000,,Жақында мектепте
Dialogue: 0,0:15:48.18,0:15:51.35,Default,,0000,0000,0000,,Не трендте?
Dialogue: 0,0:15:51.35,0:15:54.02,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:15:51.35,0:15:54.02,Default,,0000,0000,0000,,Мүмкін Коккури-сан.
Dialogue: 0,0:15:54.02,0:15:57.19,Default,,0000,0000,0000,,Көккури-сан
Dialogue: 0,0:15:54.02,0:15:57.19,Default,,0000,0000,0000,,Сіз әлі жалғызсыз ба?
Dialogue: 0,0:15:57.19,0:15:59.85,Default,,0000,0000,0000,,Иә, өткен күні мені тастап кетті.
Dialogue: 0,0:15:59.85,0:16:01.85,Default,,0000,0000,0000,,(шайдың төгілген дыбысы)
Dialogue: 0,0:16:05.63,0:16:09.30,Default,,0000,0000,0000,,Эй, сен де қызанақ же.
Dialogue: 0,0:16:09.30,0:16:12.30,Default,,0000,0000,0000,,Иә, мен қызанақты жақсы көремін.
Dialogue: 0,0:16:12.30,0:16:14.47,Default,,0000,0000,0000,,Оны ұнату немесе ұнатпау жақсы.
Dialogue: 0,0:16:14.47,0:16:16.80,Default,,0000,0000,0000,,Қызанақ жеу.
Dialogue: 0,0:16:16.80,0:16:19.97,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:16:19.97,0:16:21.98,Default,,0000,0000,0000,,Бұл қалай? Жақсы ма?
Dialogue: 0,0:16:21.98,0:16:24.31,Default,,0000,0000,0000,,Қызанақ жақсы ма?
Dialogue: 0,0:16:24.31,0:16:26.61,Default,,0000,0000,0000,,Иә, бұл дәмді.
Dialogue: 0,0:16:31.82,0:16:34.32,Default,,0000,0000,0000,,Өте қызыл болса да➡
Dialogue: 0,0:16:34.32,0:16:37.66,Default,,0000,0000,0000,,Чио бұл дәмді дейді...
Dialogue: 0,0:16:37.66,0:16:39.66,Default,,0000,0000,0000,,(Айсбергтің жарылған дыбысы)
Dialogue: 0,0:16:39.66,0:16:43.33,Default,,0000,0000,0000,,Ах! Бұрынғы айтқаным осы еді➡
Dialogue: 0,0:16:43.33,0:16:45.67,Default,,0000,0000,0000,,Нағыз мысық қайда бара алады?
Dialogue: 0,0:16:45.67,0:16:48.00,Default,,0000,0000,0000,,Нағыз мысық?
Dialogue: 0,0:16:48.00,0:16:52.01,Default,,0000,0000,0000,,Мен жалған мысықпын ба?
Dialogue: 0,0:16:52.01,0:16:54.01,Default,,0000,0000,0000,,Кешіріңіз. Кешіріңіз.
Dialogue: 0,0:16:54.01,0:16:56.51,Default,,0000,0000,0000,,Жоқ, мен ашуланбаймын.
Dialogue: 0,0:16:56.51,0:16:59.51,Default,,0000,0000,0000,,Мен фейк емеспін.
Dialogue: 0,0:16:59.51,0:17:01.78,Default,,0000,0000,0000,,нағыз мысық➡
Dialogue: 0,0:17:01.78,0:17:05.29,Default,,0000,0000,0000,,Мысықтар
Dialogue: 0,0:17:01.78,0:17:05.29,Default,,0000,0000,0000,,Бұл бар дегенді білдіре ме?
Dialogue: 0,0:17:05.29,0:17:08.46,Default,,0000,0000,0000,,Хо, сен шынымен ашулы емессің бе?
Dialogue: 0,0:17:08.46,0:17:12.46,Default,,0000,0000,0000,,(Айсбергтің жарылған дыбысы)
Dialogue: 0,0:17:12.46,0:17:15.13,Default,,0000,0000,0000,,Әкесі: Сіз тұтынушысыз.
Dialogue: 0,0:17:15.13,0:17:18.13,Default,,0000,0000,0000,,Маған кіруге рұқсат етіңіз.
Dialogue: 0,0:17:15.13,0:17:18.13,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:17:18.13,0:17:20.80,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:17:18.13,0:17:20.80,Default,,0000,0000,0000,,О, ау.
Dialogue: 0,0:17:20.80,0:17:24.31,Default,,0000,0000,0000,,Сакаки-сан, мен сені оятуға келдім.
Dialogue: 0,0:17:24.31,0:17:26.47,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:24.31,0:17:26.47,Default,,0000,0000,0000,,Така!
Dialogue: 0,0:17:26.47,0:17:28.48,Default,,0000,0000,0000,,Насуби!
Dialogue: 0,0:17:28.48,0:17:30.98,Default,,0000,0000,0000,,Оян!
Dialogue: 0,0:17:33.31,0:17:35.31,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:17:37.32,0:17:40.12,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:17:45.83,0:17:47.83,Default,,0000,0000,0000,,Бірінші арман...
Dialogue: 0,0:17:50.16,0:17:57.00,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:17:57.00,0:17:59.17,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:17:59.17,0:18:01.17,Default,,0000,0000,0000,,Мама...
Dialogue: 0,0:18:03.61,0:18:06.28,Default,,0000,0000,0000,,Мені тыңда!
Dialogue: 0,0:18:03.61,0:18:06.28,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:18:06.28,0:18:08.28,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:08.28,0:18:10.28,Default,,0000,0000,0000,,өтіңіз.
Dialogue: 0,0:18:10.28,0:18:13.12,Default,,0000,0000,0000,,Хехе!
Dialogue: 0,0:18:13.12,0:18:16.12,Default,,0000,0000,0000,,Ни Чан, менімен біраз уақыт аралас.
Dialogue: 0,0:18:16.12,0:18:19.46,Default,,0000,0000,0000,,Ято өледі.
Dialogue: 0,0:18:16.12,0:18:19.46,Default,,0000,0000,0000,,Барлығы? Тіпті Чиё Чан...
Dialogue: 0,0:18:19.46,0:18:22.63,Default,,0000,0000,0000,,Менің бастығыма
Dialogue: 0,0:18:19.46,0:18:22.63,Default,,0000,0000,0000,,Ұсақ ауызды қолданба!
Dialogue: 0,0:18:22.63,0:18:26.47,Default,,0000,0000,0000,,Менің айтқанымды орындауың керек.
Dialogue: 0,0:18:22.63,0:18:26.47,Default,,0000,0000,0000,,Сасық.
Dialogue: 0,0:18:26.47,0:18:28.64,Default,,0000,0000,0000,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:18:26.47,0:18:28.64,Default,,0000,0000,0000,,Бұл сасық.
Dialogue: 0,0:18:28.64,0:18:30.64,Default,,0000,0000,0000,,О~ Кусса Кусса!
Dialogue: 0,0:18:28.64,0:18:30.64,Default,,0000,0000,0000,,Ум...
Dialogue: 0,0:18:30.64,0:18:33.64,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:18:30.64,0:18:33.64,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:18:33.64,0:18:35.98,Default,,0000,0000,0000,,Не! ?
Dialogue: 0,0:18:33.64,0:18:35.98,Default,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:18:35.98,0:18:37.98,Default,,0000,0000,0000,,Жылқылар!
Dialogue: 0,0:18:35.98,0:18:37.98,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:18:37.98,0:18:40.48,Default,,0000,0000,0000,,(жылқының көрісі)
Dialogue: 0,0:18:40.48,0:18:44.15,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:18:44.15,0:18:47.32,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:18:44.15,0:18:47.32,Default,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:18:44.15,0:18:47.32,Default,,0000,0000,0000,,Мазасыз адамсың!
Dialogue: 0,0:18:47.32,0:18:49.49,Default,,0000,0000,0000,,Сакаки-сан!
Dialogue: 0,0:18:47.32,0:18:49.49,Default,,0000,0000,0000,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,0:18:49.49,0:18:52.49,Default,,0000,0000,0000,,Ха...!
Dialogue: 0,0:18:49.49,0:18:52.49,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:18:52.49,0:18:56.66,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:18:56.66,0:18:58.67,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:18:56.66,0:18:58.67,Default,,0000,0000,0000,,Жарыс басталмас бұрын Қвиркіңді қолданба! Өзіңді шаршатпа!
Dialogue: 0,0:18:58.67,0:19:00.77,Default,,0000,0000,0000,,Иә….
Dialogue: 0,0:18:58.67,0:19:00.77,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:19:00.77,0:19:02.77,Default,,0000,0000,0000,,Жоқ. Менің тіземнен қан кетіп жатыр.
Dialogue: 0,0:19:00.77,0:19:02.77,Default,,0000,0000,0000,,Харисеня~!
Dialogue: 0,0:19:02.77,0:19:04.77,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:04.77,0:19:06.77,Default,,0000,0000,0000,,Тезірек емханаға барыңыз.
Dialogue: 0,0:19:06.77,0:19:09.61,Default,,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:19:06.77,0:19:09.61,Default,,0000,0000,0000,,Маған көмектескеніңіз үшін...
Dialogue: 0,0:19:09.61,0:19:12.45,Default,,0000,0000,0000,,Бұл туралы уайымдаудың қажеті жоқ, Каорин.
Dialogue: 0,0:19:12.45,0:19:14.45,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:19:14.45,0:19:17.62,Default,,0000,0000,0000,,Мм... Сакаки мырза...
Dialogue: 0,0:19:17.62,0:19:19.79,Default,,0000,0000,0000,,Каорин емес, мен туралы➡
Dialogue: 0,0:19:19.79,0:19:23.09,Default,,0000,0000,0000,,«Каори»
Dialogue: 0,0:19:19.79,0:19:23.09,Default,,0000,0000,0000,,Маған қоңырау шала аласыз ба?
Dialogue: 0,0:19:25.96,0:19:28.63,Default,,0000,0000,0000,,А, мен түсіндім.
Dialogue: 0,0:19:28.63,0:19:30.63,Default,,0000,0000,0000,,Ха...!
Dialogue: 0,0:19:33.97,0:19:36.30,Default,,0000,0000,0000,,Каори Каори….
Dialogue: 0,0:19:36.30,0:19:39.47,Default,,0000,0000,0000,,Каори!
Dialogue: 0,0:19:39.47,0:19:41.48,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:19:39.47,0:19:41.48,Default,,0000,0000,0000,,Сәл ояныңыз➡
Dialogue: 0,0:19:41.48,0:19:43.48,Default,,0000,0000,0000,,Каори!
Dialogue: 0,0:19:41.48,0:19:43.48,Default,,0000,0000,0000,,(перделердің ашылған дыбысы)
Dialogue: 0,0:19:43.48,0:19:45.65,Default,,0000,0000,0000,,Хмм... Уау.
Dialogue: 0,0:19:45.65,0:19:48.15,Default,,0000,0000,0000,,Достармен
Dialogue: 0,0:19:45.65,0:19:48.15,Default,,0000,0000,0000,,Жаңа жылдық қонаққа барасыз ба?
Dialogue: 0,0:19:48.15,0:19:50.48,Default,,0000,0000,0000,,Сіз қанша уақыт ұйықтайсыз?
Dialogue: 0,0:19:50.48,0:19:52.49,Default,,0000,0000,0000,,Дәрі мүлде ағып кетпейді.
Dialogue: 0,0:19:52.49,0:19:54.82,Default,,0000,0000,0000,,Бұл бала
Dialogue: 0,0:19:52.49,0:19:54.82,Default,,0000,0000,0000,,Ең алғаш қандай түс көрдіңіз...?
Dialogue: 0,0:19:54.82,0:19:56.82,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:19:56.82,0:19:58.99,Default,,0000,0000,0000,,《Арманда! ? 》
Dialogue: 0,0:19:58.99,0:20:04.33,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:20:04.33,0:20:06.67,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:20:06.67,0:20:09.57,Default,,0000,0000,0000,,Асықпасаң, кешігіп қаласың.
Dialogue: 0,0:20:13.34,0:20:16.18,Default,,0000,0000,0000,,Жалғасы!
Dialogue: 0,0:20:13.34,0:20:16.18,Default,,0000,0000,0000,,Не істеп жатырсың!
Dialogue: 0,0:20:16.18,0:20:19.51,Default,,0000,0000,0000,,Эй, оян!
Dialogue: 0,0:20:16.18,0:20:19.51,Default,,0000,0000,0000,,Жоқ, жалғастырыңыз!
Dialogue: 0,0:20:19.51,0:20:22.68,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:20:19.51,0:20:22.68,Default,,0000,0000,0000,,Доспен уәде!
Dialogue: 0,0:20:22.68,0:20:26.69,Default,,0000,0000,0000,,Жоқ, жоқ, жалғастырыңыз!
Dialogue: 0,0:20:26.69,0:20:30.19,Default,,0000,0000,0000,,Бұл сәл ғана болды...
Dialogue: 0,0:20:30.19,0:20:32.19,Default,,0000,0000,0000,,Құттықтаймыз.
Dialogue: 0,0:20:30.19,0:20:32.19,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:20:32.19,0:20:36.53,Default,,0000,0000,0000,,Е-а-а
Dialogue: 0,0:20:32.19,0:20:36.53,Default,,0000,0000,0000,,Жаңа жыл құтты болсын!
Dialogue: 0,0:20:36.53,0:20:39.20,Default,,0000,0000,0000,,Ах, у...
Dialogue: 0,0:20:39.20,0:20:41.87,Default,,0000,0000,0000,,А, ат!
Dialogue: 0,0:20:41.87,0:20:43.87,Default,,0000,0000,0000,,Е, биыл қоян екен.
Dialogue: 0,0:20:43.87,0:20:46.21,Default,,0000,0000,0000,,Әй, Хакуба!
Dialogue: 0,0:20:46.21,0:20:48.21,Default,,0000,0000,0000,,Ха ха!
Dialogue: 0,0:20:46.21,0:20:48.21,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:48.21,0:20:51.38,Default,,0000,0000,0000,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,0:20:48.21,0:20:51.38,Default,,0000,0000,0000,,Құттықтаймыз!
Dialogue: 0,0:20:51.38,0:20:53.38,Default,,0000,0000,0000,,Құттықтаймыз.
Dialogue: 0,0:20:53.38,0:20:56.38,Default,,0000,0000,0000,,Не, не, не туралы айтып тұрсың?
Dialogue: 0,0:20:56.38,0:20:59.99,Default,,0000,0000,0000,,О, аа... Хатсуюме...
Dialogue: 0,0:20:59.99,0:21:04.16,Default,,0000,0000,0000,,А~ мен
Dialogue: 0,0:20:59.99,0:21:04.16,Default,,0000,0000,0000,,Биылғы бірінші арманымды орындай алмадым.
Dialogue: 0,0:21:04.16,0:21:06.16,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:21:06.16,0:21:09.33,Default,,0000,0000,0000,,Ойланып көрейікші
Dialogue: 0,0:21:06.16,0:21:09.33,Default,,0000,0000,0000,,Чиё-чан менің бірінші түсімде көрінді.
Dialogue: 0,0:21:09.33,0:21:11.33,Default,,0000,0000,0000,,А, мен де.
Dialogue: 0,0:21:11.33,0:21:14.17,Default,,0000,0000,0000,,Мен де.
Dialogue: 0,0:21:11.33,0:21:14.17,Default,,0000,0000,0000,,Мен де ойлап қарасам...
Dialogue: 0,0:21:14.17,0:21:16.50,Default,,0000,0000,0000,,О, бұл керемет!
Dialogue: 0,0:21:16.50,0:21:19.34,Default,,0000,0000,0000,,Түсімде мен қандай болдым?
Dialogue: 0,0:21:19.34,0:21:21.51,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:21:21.51,0:21:23.68,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:21:23.68,0:21:26.01,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:21:26.01,0:21:28.52,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:21:28.52,0:21:32.35,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:32.35,0:21:34.65,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:21:38.36,0:21:41.20,Default,,0000,0000,0000,,Сізде проблема болды ма?
Dialogue: 0,0:21:41.20,0:21:43.20,Default,,0000,0000,0000,,Айтыңызшы.
Dialogue: 0,0:21:43.20,0:21:45.20,Default,,0000,0000,0000,,Мен қандай адам едім?
Dialogue: 0,0:21:45.20,0:21:48.37,Default,,0000,0000,0000,,Эй, эй, эй!
Dialogue: 0,0:21:48.37,0:21:51.37,Default,,0000,0000,0000,,Айтыңызшы!
Dialogue: 0,0:21:52.87,0:21:58.87,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory