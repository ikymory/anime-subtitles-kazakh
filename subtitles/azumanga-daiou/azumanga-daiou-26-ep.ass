Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.19,0:01:32.59,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:01:35.86,0:01:50.21,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:50.21,0:01:52.71,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:01:52.71,0:01:55.21,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:01:55.21,0:01:57.71,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:01:55.21,0:01:57.71,Default,,0000,0000,0000,,Ня?
Dialogue: 0,0:02:00.32,0:02:02.32,Default,,0000,0000,0000,,Бұл маған бүгін керек емес еді.
Dialogue: 0,0:02:02.32,0:02:04.99,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:02:04.99,0:02:06.99,Default,,0000,0000,0000,,Хахахаха!
Dialogue: 0,0:02:06.99,0:02:09.16,Default,,0000,0000,0000,,Қайырлы таң, Тадаёси-сан.
Dialogue: 0,0:02:06.99,0:02:09.16,Default,,0000,0000,0000,,Кун.
Dialogue: 0,0:02:09.16,0:02:11.16,Default,,0000,0000,0000,,Құлайтындай… Бұл қылыш…
Dialogue: 0,0:02:11.16,0:02:14.83,Default,,0000,0000,0000,,Тадаёси-сан, бүгін мектеп бітіру рәсімі.
Dialogue: 0,0:02:14.83,0:02:17.13,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:02:14.83,0:02:17.13,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:02:22.00,0:02:25.00,Default,,0000,0000,0000,,Бұл менің бірінші рет бітіруім.
Dialogue: 0,0:02:28.51,0:02:30.85,Default,,0000,0000,0000,,Мен барамын.
Dialogue: 0,0:02:28.51,0:02:30.85,Default,,0000,0000,0000,,Бір!
Dialogue: 0,0:02:30.85,0:02:46.86,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:46.86,0:02:48.86,Default,,0000,0000,0000,,Хмм, хмм, хмм, хмм…
Dialogue: 0,0:02:48.86,0:02:50.86,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:02:57.54,0:03:01.84,Default,,0000,0000,0000,,Осы уақытқа дейін кешіріңіз
Dialogue: 0,0:02:57.54,0:03:01.84,Default,,0000,0000,0000,,Мен оны сипау үшін өзімді мәжбүрлемек болдым.
Dialogue: 0,0:03:12.32,0:03:14.32,Default,,0000,0000,0000,,Ня~.
Dialogue: 0,0:03:12.32,0:03:14.32,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:18.49,0:03:20.50,Default,,0000,0000,0000,,Ня~.
Dialogue: 0,0:03:20.50,0:03:24.10,Default,,0000,0000,0000,,Мм... мен сені еркелетсем бола ма?
Dialogue: 0,0:03:33.68,0:03:36.85,Default,,0000,0000,0000,,Хмм, хмм, хмм, хмм…
Dialogue: 0,0:03:33.68,0:03:36.85,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:03:36.85,0:03:38.85,Default,,0000,0000,0000,,Ой.
Dialogue: 0,0:03:43.02,0:03:45.85,Default,,0000,0000,0000,,(Сәлемдесу)
Dialogue: 0,0:03:45.85,0:03:48.55,Default,,0000,0000,0000,,Қайырлы таң Ах...
Dialogue: 0,0:03:52.36,0:03:55.86,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:03:52.36,0:03:55.86,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:03:55.86,0:04:00.47,Default,,0000,0000,0000,,Колледжді бітірген әйелдердің жұмысқа орналасу деңгейі
Dialogue: 0,0:03:55.86,0:04:00.47,Default,,0000,0000,0000,,Ең нашар рекорд.
Dialogue: 0,0:04:00.47,0:04:03.64,Default,,0000,0000,0000,,Сіз университетті бітірсеңіз де
Dialogue: 0,0:04:00.47,0:04:03.64,Default,,0000,0000,0000,,Бұл ештеңе болмауы мүмкін.
Dialogue: 0,0:04:03.64,0:04:05.64,Default,,0000,0000,0000,,Мен өтемін.
Dialogue: 0,0:04:05.64,0:04:07.64,Default,,0000,0000,0000,,Буфеттегі әйелге
Dialogue: 0,0:04:05.64,0:04:07.64,Default,,0000,0000,0000,,Мен естідім➡
Dialogue: 0,0:04:07.64,0:04:10.15,Default,,0000,0000,0000,,Университетті бітіргеннен кейін
Dialogue: 0,0:04:07.64,0:04:10.15,Default,,0000,0000,0000,,Неке мерзімі кешіктіріледі!
Dialogue: 0,0:04:10.15,0:04:12.15,Default,,0000,0000,0000,,Саған жақсылық, Коёми~!
Dialogue: 0,0:04:12.15,0:04:14.15,Default,,0000,0000,0000,,Сіз өтесіз!
Dialogue: 0,0:04:14.15,0:04:17.49,Default,,0000,0000,0000,,Хэхе...
Dialogue: 0,0:04:14.15,0:04:17.49,Default,,0000,0000,0000,,Чиё-чан Қайырлы таң.
Dialogue: 0,0:04:17.49,0:04:20.82,Default,,0000,0000,0000,,О? Қайырлы таң, Осака-сан...
Dialogue: 0,0:04:20.82,0:04:23.49,Default,,0000,0000,0000,,Хмм, бұл не?
Dialogue: 0,0:04:23.49,0:04:27.16,Default,,0000,0000,0000,,Ұлпа?
Dialogue: 0,0:04:23.49,0:04:27.16,Default,,0000,0000,0000,,Ой, бұл майлық.
Dialogue: 0,0:04:27.16,0:04:30.00,Default,,0000,0000,0000,,Бұл шынымен де жоғары сынып.
Dialogue: 0,0:04:30.00,0:04:33.67,Default,,0000,0000,0000,,Ха, неге олай істейсің?
Dialogue: 0,0:04:33.67,0:04:35.67,Default,,0000,0000,0000,,Құпия ашылды.
Dialogue: 0,0:04:38.01,0:04:40.01,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:04:40.01,0:04:43.18,Default,,0000,0000,0000,,Сондықтан.
Dialogue: 0,0:04:40.01,0:04:43.18,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:04:43.18,0:04:46.01,Default,,0000,0000,0000,,А, сізде шөп безгегі бар ма?
Dialogue: 0,0:04:46.01,0:04:48.02,Default,,0000,0000,0000,,Иә, шөп безгегі.
Dialogue: 0,0:04:48.02,0:04:50.02,Default,,0000,0000,0000,,Енді сіз сенімді бола аласыз.
Dialogue: 0,0:04:50.02,0:04:52.02,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:04:52.02,0:04:54.02,Default,,0000,0000,0000,,Көз тамшылары да бар.
Dialogue: 0,0:04:54.02,0:04:58.36,Default,,0000,0000,0000,,Бірақ мен жатпаймын
Dialogue: 0,0:04:54.02,0:04:58.36,Default,,0000,0000,0000,,Ол көз тамшысын беруге болмайтын адам.
Dialogue: 0,0:04:58.36,0:05:00.96,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:05:00.96,0:05:03.30,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:05:03.30,0:05:05.97,Default,,0000,0000,0000,,Осака мырза маған көз тамшысын берді...
Dialogue: 0,0:05:05.97,0:05:07.97,Default,,0000,0000,0000,,Көз тамшылары?
Dialogue: 0,0:05:07.97,0:05:11.31,Default,,0000,0000,0000,,Дұрыс. Менде шөп безгегі бар.
Dialogue: 0,0:05:11.31,0:05:13.31,Default,,0000,0000,0000,,Ха ха….
Dialogue: 0,0:05:13.31,0:05:15.31,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:05:15.31,0:05:17.98,Default,,0000,0000,0000,,Не? Сіз жай түшкірдіңіз бе?
Dialogue: 0,0:05:17.98,0:05:20.82,Default,,0000,0000,0000,,Хахахаха Бұл керемет.
Dialogue: 0,0:05:20.82,0:05:24.32,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:05:20.82,0:05:24.32,Default,,0000,0000,0000,,Мүлдем жақсы емес.
Dialogue: 0,0:05:24.32,0:05:27.49,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:05:24.32,0:05:27.49,Default,,0000,0000,0000,,Кухахаха!
Dialogue: 0,0:05:27.49,0:05:31.99,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:05:27.49,0:05:31.99,Default,,0000,0000,0000,,Хэхехахахаха!
Dialogue: 0,0:05:31.99,0:05:35.16,Default,,0000,0000,0000,,Шөп безгегі көңілді көрінеді.
Dialogue: 0,0:05:31.99,0:05:35.16,Default,,0000,0000,0000,,Бұл қызық емес.
Dialogue: 0,0:05:35.16,0:05:38.33,Default,,0000,0000,0000,,📢 Магистранттарға қабылдау.
Dialogue: 0,0:05:38.33,0:05:43.13,Default,,0000,0000,0000,,(Шапалақтау)
Dialogue: 0,0:05:58.85,0:06:03.46,Default,,0000,0000,0000,,📢Сосын директордан.
Dialogue: 0,0:05:58.85,0:06:03.46,Default,,0000,0000,0000,,Біз ресми мекенжай аламыз.
Dialogue: 0,0:06:03.46,0:06:05.96,Default,,0000,0000,0000,,Құрметті түлектер➡
Dialogue: 0,0:06:05.96,0:06:07.96,Default,,0000,0000,0000,,Сізді мектеп бітіруіңізбен құттықтаймыз.
Dialogue: 0,0:06:07.96,0:06:11.47,Default,,0000,0000,0000,,Қонақтар
Dialogue: 0,0:06:07.96,0:06:11.47,Default,,0000,0000,0000,,Ал ата-аналар...
Dialogue: 0,0:06:11.47,0:06:13.47,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:06:16.97,0:06:19.64,Default,,0000,0000,0000,,Бүгін қатысқаныңыз үшін рахмет...
Dialogue: 0,0:06:19.64,0:06:22.48,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:06:22.48,0:06:25.65,Default,,0000,0000,0000,,Бүгін қатысқаныңыз үшін рахмет➡
Dialogue: 0,0:06:25.65,0:06:27.65,Default,,0000,0000,0000,,Хаа… Хаа… Хаа….
Dialogue: 0,0:06:27.65,0:06:31.49,Default,,0000,0000,0000,,Мен жай ғана жеңіске жету мақсатымен келдім—
Dialogue: 0,0:06:27.65,0:06:31.49,Default,,0000,0000,0000,,Енді барлық түлектерге...
Dialogue: 0,0:06:31.49,0:06:34.32,Default,,0000,0000,0000,,📢Дипломмен марапаттау.
Dialogue: 0,0:06:34.32,0:06:37.16,Default,,0000,0000,0000,,Түлектердің өкілі Масаки Ояма.
Dialogue: 0,0:06:37.16,0:06:41.33,Default,,0000,0000,0000,,Әй, мен неге бітіруші сыныптың өкілі емеспін?
Dialogue: 0,0:06:41.33,0:06:43.33,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:06:47.50,0:06:50.00,Default,,0000,0000,0000,,Сенде ми жоқ па?
Dialogue: 0,0:06:52.01,0:06:55.84,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:06:52.01,0:06:55.84,Default,,0000,0000,0000,,Ең күшті болғандықтан ба?
Dialogue: 0,0:06:55.84,0:06:57.85,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:55.84,0:06:57.85,Default,,0000,0000,0000,,О!
Dialogue: 0,0:06:57.85,0:06:59.85,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:06:59.85,0:07:04.29,Default,,0000,0000,0000,,📢Сосын биыл
Dialogue: 0,0:06:59.85,0:07:04.29,Default,,0000,0000,0000,,Ең жоғары баға алған оқушыларға➡
Dialogue: 0,0:07:04.29,0:07:06.29,Default,,0000,0000,0000,,«Алтын орхидея» сыйлығы беріледі.
Dialogue: 0,0:07:06.29,0:07:08.29,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:06.29,0:07:08.29,Default,,0000,0000,0000,,Бұл сен емессің. Отыр.
Dialogue: 0,0:07:10.63,0:07:12.63,Default,,0000,0000,0000,,Аха!
Dialogue: 0,0:07:10.63,0:07:12.63,Default,,0000,0000,0000,,Отырыңыз!
Dialogue: 0,0:07:14.63,0:07:18.63,Default,,0000,0000,0000,,📢Биылғы Кинран сыйлығы
Dialogue: 0,0:07:14.63,0:07:18.63,Default,,0000,0000,0000,,Чиё Михама, 3-сынып, 3-сынып.
Dialogue: 0,0:07:18.63,0:07:21.14,Default,,0000,0000,0000,,Аха!
Dialogue: 0,0:07:18.63,0:07:21.14,Default,,0000,0000,0000,,Демек бұл сен емессің!
Dialogue: 0,0:07:21.14,0:07:23.64,Default,,0000,0000,0000,,📢Чиё Михама Өтінемін алға.
Dialogue: 0,0:07:23.64,0:07:27.48,Default,,0000,0000,0000,,Чио-чан
Dialogue: 0,0:07:23.64,0:07:27.48,Default,,0000,0000,0000,,Бұл Чиё Чан туралы.
Dialogue: 0,0:07:27.48,0:07:29.98,Default,,0000,0000,0000,,Не, сен мен туралы айтып тұрсың ба?
Dialogue: 0,0:07:33.31,0:07:36.82,Default,,0000,0000,0000,,Чио Михама
Dialogue: 0,0:07:33.31,0:07:36.82,Default,,0000,0000,0000,,Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:07:36.82,0:07:38.82,Default,,0000,0000,0000,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің.
Dialogue: 0,0:07:38.82,0:07:41.32,Default,,0000,0000,0000,,Ха...!
Dialogue: 0,0:07:41.32,0:07:44.83,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:07:44.83,0:07:49.16,Default,,0000,0000,0000,,Браво! Браво~ Браво~ Браво~!
Dialogue: 0,0:07:44.83,0:07:49.16,Default,,0000,0000,0000,,Бурабо!
Dialogue: 0,0:07:49.16,0:07:52.33,Default,,0000,0000,0000,,Браво~ Браво~ Браво~!
Dialogue: 0,0:07:49.16,0:07:52.33,Default,,0000,0000,0000,,Бурабо!
Dialogue: 0,0:07:52.33,0:07:54.34,Default,,0000,0000,0000,,(Шапалақтау)
Dialogue: 0,0:07:54.34,0:07:56.34,Default,,0000,0000,0000,,Сіз тұрсыз ба?
Dialogue: 0,0:07:56.34,0:07:58.34,Default,,0000,0000,0000,,Енді?
Dialogue: 0,0:07:58.34,0:08:01.34,Default,,0000,0000,0000,,(Шапалақтау)
Dialogue: 0,0:08:06.28,0:08:12.12,Default,,0000,0000,0000,,♬ «Жоғарыдан қарасаң, абыройлы боласың»
Dialogue: 0,0:08:12.12,0:08:22.46,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:08:22.46,0:08:25.97,Default,,0000,0000,0000,,♬ «Егер сен жоғары қарасаң»
Dialogue: 0,0:08:25.97,0:08:29.47,Default,,0000,0000,0000,,♬ «құрмет»
Dialogue: 0,0:08:29.47,0:08:36.64,Default,,0000,0000,0000,,♬ «Менің қожайынымның рақымы»
Dialogue: 0,0:08:36.64,0:08:43.82,Default,,0000,0000,0000,,♬ «Мұғалімдік бақшада да»
Dialogue: 0,0:08:43.82,0:08:50.99,Default,,0000,0000,0000,,♬ «Хая Икутосе»
Dialogue: 0,0:08:50.99,0:08:58.17,Default,,0000,0000,0000,,♬ «Ойланып қарасаң, бұл тәтті».
Dialogue: 0,0:08:58.17,0:09:05.27,Default,,0000,0000,0000,,♬ «Осы жылдар»
Dialogue: 0,0:09:05.27,0:09:14.45,Default,,0000,0000,0000,,♬ «Қазір қоштасатын кез келді».
Dialogue: 0,0:09:14.45,0:09:19.79,Default,,0000,0000,0000,,♬ «Қоштасу»
Dialogue: 0,0:09:19.79,0:09:22.12,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:09:22.12,0:09:25.79,Default,,0000,0000,0000,,《Жоқ, жасама!》
Dialogue: 0,0:09:25.79,0:09:39.99,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:09:43.65,0:09:46.15,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:09:46.15,0:09:48.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:46.15,0:09:48.98,Default,,0000,0000,0000,,Уау...
Dialogue: 0,0:09:48.98,0:09:50.99,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:09:50.99,0:09:52.99,Default,,0000,0000,0000,,Ух... Юу➡
Dialogue: 0,0:09:52.99,0:09:55.66,Default,,0000,0000,0000,,Юкари Сенсей….
Dialogue: 0,0:09:55.66,0:09:57.83,Default,,0000,0000,0000,,Мен әмиянымды тастадым.
Dialogue: 0,0:09:57.83,0:10:00.50,Default,,0000,0000,0000,,Эх!
Dialogue: 0,0:10:00.50,0:10:02.50,Default,,0000,0000,0000,,Бұл енді маңызды емес.
Dialogue: 0,0:10:02.50,0:10:05.00,Default,,0000,0000,0000,,Мектеп бітіру туралы куәлік.
Dialogue: 0,0:10:05.00,0:10:07.00,Default,,0000,0000,0000,,Оны жойыңыз!
Dialogue: 0,0:10:07.00,0:10:10.50,Default,,0000,0000,0000,,А... е-е... қазір.
Dialogue: 0,0:10:14.01,0:10:16.01,Default,,0000,0000,0000,,Кагура.
Dialogue: 0,0:10:14.01,0:10:16.01,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:10:19.68,0:10:22.08,Default,,0000,0000,0000,,Осака.
Dialogue: 0,0:10:19.68,0:10:22.08,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:10:25.19,0:10:27.59,Default,,0000,0000,0000,,Даналық.
Dialogue: 0,0:10:25.19,0:10:27.59,Default,,0000,0000,0000,,Сәлеметсіз бе.
Dialogue: 0,0:10:31.86,0:10:33.86,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:10:42.04,0:10:46.21,Default,,0000,0000,0000,,Гах~ Мен сені аяймын!
Dialogue: 0,0:10:42.04,0:10:46.21,Default,,0000,0000,0000,,Уау! Эй!
Dialogue: 0,0:10:46.21,0:10:48.54,Default,,0000,0000,0000,,Куууу... Менің он мың шотым...➡
Dialogue: 0,0:10:48.54,0:10:50.55,Default,,0000,0000,0000,,Менің он мың шоттарым!
Dialogue: 0,0:10:50.55,0:10:52.55,Default,,0000,0000,0000,,Шынымен
Dialogue: 0,0:10:50.55,0:10:52.55,Default,,0000,0000,0000,,Оны қосу керек еді...
Dialogue: 0,0:10:55.55,0:10:57.72,Default,,0000,0000,0000,,Олай болса, соңғы сөздер.
Dialogue: 0,0:10:57.72,0:10:59.99,Default,,0000,0000,0000,,Ал, бәріңе сау болыңдар.
Dialogue: 0,0:10:59.99,0:11:01.99,Default,,0000,0000,0000,,Оны жойыңыз!
Dialogue: 0,0:11:01.99,0:11:04.59,Default,,0000,0000,0000,,Ах... Танизаки мырза...
Dialogue: 0,0:11:06.66,0:11:08.66,Default,,0000,0000,0000,,Әй, солай.
Dialogue: 0,0:11:08.66,0:11:11.17,Default,,0000,0000,0000,,Нямо кайо~.
Dialogue: 0,0:11:11.17,0:11:14.50,Default,,0000,0000,0000,,Бұны көтерген адам
Dialogue: 0,0:11:11.17,0:11:14.50,Default,,0000,0000,0000,,Оны маған жеткізді.
Dialogue: 0,0:11:14.50,0:11:17.00,Default,,0000,0000,0000,,Бұл әмиян сізге қатысты.
Dialogue: 0,0:11:19.01,0:11:21.51,Default,,0000,0000,0000,,Қаа!
Dialogue: 0,0:11:21.51,0:11:24.85,Default,,0000,0000,0000,,Бәріңе сәлем!
Dialogue: 0,0:11:24.85,0:11:28.05,Default,,0000,0000,0000,,Сізді мектеп бітіруіңізбен құттықтаймыз!
Dialogue: 0,0:11:31.52,0:11:34.52,Default,,0000,0000,0000,,Кешіріңіз, барлығыңыз~
Dialogue: 0,0:11:31.52,0:11:34.52,Default,,0000,0000,0000,,Кеш батты...
Dialogue: 0,0:11:34.52,0:11:36.52,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:34.52,0:11:36.52,Default,,0000,0000,0000,,(Шапалақтау)
Dialogue: 0,0:11:36.52,0:11:39.53,Default,,0000,0000,0000,,Рахмет, мұғалім!
Dialogue: 0,0:11:39.53,0:11:43.03,Default,,0000,0000,0000,,Мен көптен күттім.
Dialogue: 0,0:11:39.53,0:11:43.03,Default,,0000,0000,0000,,Қош бол, ұстаз.
Dialogue: 0,0:11:43.03,0:11:45.70,Default,,0000,0000,0000,,Көңілді болды.
Dialogue: 0,0:11:43.03,0:11:45.70,Default,,0000,0000,0000,,Міне, келдіңіз.
Dialogue: 0,0:11:45.70,0:11:47.70,Default,,0000,0000,0000,,Әлі біткен жоқ.
Dialogue: 0,0:11:47.70,0:11:50.37,Default,,0000,0000,0000,,Дипломы жоқ адамдар болуы мүмкін.
Dialogue: 0,0:11:50.37,0:11:52.37,Default,,0000,0000,0000,,Эх!
Dialogue: 0,0:11:52.37,0:11:55.54,Default,,0000,0000,0000,,Алайда
Dialogue: 0,0:11:52.37,0:11:55.54,Default,,0000,0000,0000,,Мен сендермен бірге өткізген үш жыл➡
Dialogue: 0,0:11:55.54,0:11:57.71,Default,,0000,0000,0000,,Мен үшін өте қызықты➡
Dialogue: 0,0:11:57.71,0:11:59.88,Default,,0000,0000,0000,,ЖӘНЕ Бұл мәнді күн болды.
Dialogue: 0,0:11:59.88,0:12:02.98,Default,,0000,0000,0000,,Мен сіздермен бөлісе алдым.
Dialogue: 0,0:11:59.88,0:12:02.98,Default,,0000,0000,0000,,Сондай тамаша уақытта да➡
Dialogue: 0,0:12:02.98,0:12:06.65,Default,,0000,0000,0000,,Бүгін... Ууууууууу...
Dialogue: 0,0:12:06.65,0:12:08.66,Default,,0000,0000,0000,,Э? Тұр... не?
Dialogue: 0,0:12:08.66,0:12:11.49,Default,,0000,0000,0000,,Сенсей...
Dialogue: 0,0:12:11.49,0:12:14.83,Default,,0000,0000,0000,,Бірақ
Dialogue: 0,0:12:11.49,0:12:14.83,Default,,0000,0000,0000,,Каорин екеуміз мәңгі бірге боламыз!
Dialogue: 0,0:12:14.83,0:12:17.33,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:12:17.33,0:12:20.33,Default,,0000,0000,0000,,Міне, солай!
Dialogue: 0,0:12:20.33,0:12:22.34,Default,,0000,0000,0000,,Барлығы орындарынан тұрыңдар!
Dialogue: 0,0:12:22.34,0:12:25.01,Default,,0000,0000,0000,,Рахмет!
Dialogue: 0,0:12:25.01,0:12:27.84,Default,,0000,0000,0000,,Олай болса, сэр.
Dialogue: 0,0:12:25.01,0:12:27.84,Default,,0000,0000,0000,,Бұл барлығынан.
Dialogue: 0,0:12:27.84,0:12:29.84,Default,,0000,0000,0000,,О, қандай гүл шоғы!
Dialogue: 0,0:12:29.84,0:12:34.85,Default,,0000,0000,0000,,(Шапалақтау)
Dialogue: 0,0:12:34.85,0:12:36.85,Default,,0000,0000,0000,,Хэхе...
Dialogue: 0,0:12:36.85,0:12:40.02,Default,,0000,0000,0000,,Бір адамға бір гүл.
Dialogue: 0,0:12:40.02,0:12:42.02,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:12:44.53,0:12:46.53,Default,,0000,0000,0000,,Бұл жақсы емес.
Dialogue: 0,0:12:46.53,0:12:48.86,Default,,0000,0000,0000,,Кім бірінші келді?
Dialogue: 0,0:12:46.53,0:12:48.86,Default,,0000,0000,0000,,Кеуіп кетер ме екен!
Dialogue: 0,0:12:48.86,0:12:50.87,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:12:50.87,0:12:53.37,Default,,0000,0000,0000,,Юкари Сенсэй~.
Dialogue: 0,0:12:55.37,0:12:57.71,Default,,0000,0000,0000,,Уф... ой...
Dialogue: 0,0:12:57.71,0:13:01.14,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:13:01.14,0:13:04.65,Default,,0000,0000,0000,,Мм...!
Dialogue: 0,0:13:04.65,0:13:06.65,Default,,0000,0000,0000,,Мм...!
Dialogue: 0,0:13:06.65,0:13:09.82,Default,,0000,0000,0000,,О...!
Dialogue: 0,0:13:09.82,0:13:13.82,Default,,0000,0000,0000,,Боу!
Dialogue: 0,0:13:13.82,0:13:17.83,Default,,0000,0000,0000,,Буха, сен не істеп жатырсың~!
Dialogue: 0,0:13:13.82,0:13:17.83,Default,,0000,0000,0000,,Жоқ, әйтеуір.
Dialogue: 0,0:13:17.83,0:13:22.50,Default,,0000,0000,0000,,Сенсэй~ Шынымен де
Dialogue: 0,0:13:17.83,0:13:22.50,Default,,0000,0000,0000,,Орта мектеп бітті.
Dialogue: 0,0:13:22.50,0:13:25.17,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:13:22.50,0:13:25.17,Default,,0000,0000,0000,,Күн сайын барлығымен➡
Dialogue: 0,0:13:25.17,0:13:28.00,Default,,0000,0000,0000,,Сондықтан мен сені көре алмаймын.
Dialogue: 0,0:13:25.17,0:13:28.00,Default,,0000,0000,0000,,Эй, күте тұрыңыз!
Dialogue: 0,0:13:28.00,0:13:30.51,Default,,0000,0000,0000,,Хахахахаха~!
Dialogue: 0,0:13:28.00,0:13:30.51,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:13:30.51,0:13:33.51,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:13:30.51,0:13:33.51,Default,,0000,0000,0000,,Ауырды. Ол аурады.
Dialogue: 0,0:13:33.51,0:13:35.84,Default,,0000,0000,0000,,Иә хахахахаха!
Dialogue: 0,0:13:35.84,0:13:38.51,Default,,0000,0000,0000,,Аха Осака Эх, жоқ, жоқ!
Dialogue: 0,0:13:35.84,0:13:38.51,Default,,0000,0000,0000,,Ахахха~!
Dialogue: 0,0:13:38.51,0:13:41.18,Default,,0000,0000,0000,,Күте тұрыңыз, не болып жатыр?
Dialogue: 0,0:13:38.51,0:13:41.18,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:13:41.18,0:13:43.18,Default,,0000,0000,0000,,Балалар сендер жақсы боласыңдар.
Dialogue: 0,0:13:43.18,0:13:45.19,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:13:43.18,0:13:45.19,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:48.86,0:13:50.86,Default,,0000,0000,0000,,Мен суретке түсемін.
Dialogue: 0,0:13:50.86,0:13:53.03,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:13:50.86,0:13:53.03,Default,,0000,0000,0000,,(Ысырма дыбысы)
Dialogue: 0,0:13:53.03,0:13:55.53,Default,,0000,0000,0000,,Иә, басқасы.
Dialogue: 0,0:13:55.53,0:13:58.87,Default,,0000,0000,0000,,А, Сакаки-сан... Жарайды.
Dialogue: 0,0:13:58.87,0:14:02.80,Default,,0000,0000,0000,,Сакаки-сан
Dialogue: 0,0:13:58.87,0:14:02.80,Default,,0000,0000,0000,,Менімен суретке түскіңіз келе ме?
Dialogue: 0,0:14:02.80,0:14:05.97,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:14:02.80,0:14:05.97,Default,,0000,0000,0000,,Сатоси бізді де суретке түсіріңіз!
Dialogue: 0,0:14:05.97,0:14:07.98,Default,,0000,0000,0000,,Эй, 1000 иен.
Dialogue: 0,0:14:07.98,0:14:10.31,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:14:10.31,0:14:12.81,Default,,0000,0000,0000,,Жоқ, мен қалжыңдап тұрмын...
Dialogue: 0,0:14:12.81,0:14:14.82,Default,,0000,0000,0000,,Хэхехе.
Dialogue: 0,0:14:14.82,0:14:16.82,Default,,0000,0000,0000,,Онда мен суретке түсемін.
Dialogue: 0,0:14:16.82,0:14:18.82,Default,,0000,0000,0000,,(Ысырма дыбысы)
Dialogue: 0,0:14:18.82,0:14:21.16,Default,,0000,0000,0000,,Иә Жарайды.
Dialogue: 0,0:14:18.82,0:14:21.16,Default,,0000,0000,0000,,Ей!
Dialogue: 0,0:14:21.16,0:14:23.49,Default,,0000,0000,0000,,Сіз жаңа ғана камераны өшірдіңіз!
Dialogue: 0,0:14:23.49,0:14:26.49,Default,,0000,0000,0000,,Менің ойымша, оған көмектесу мүмкін емес.
Dialogue: 0,0:14:23.49,0:14:26.49,Default,,0000,0000,0000,,Дұрыс суретке түсіріңіз!
Dialogue: 0,0:14:26.49,0:14:29.83,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,0:14:26.49,0:14:29.83,Default,,0000,0000,0000,,(Ысырма дыбысы)
Dialogue: 0,0:14:29.83,0:14:33.00,Default,,0000,0000,0000,,Ағымдағы фотосурет
Dialogue: 0,0:14:29.83,0:14:33.00,Default,,0000,0000,0000,,Мүмкін болса, маған жіберіңізші.
Dialogue: 0,0:14:33.00,0:14:36.00,Default,,0000,0000,0000,,Иә, иә, Осака~!
Dialogue: 0,0:14:33.00,0:14:36.00,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:14:36.00,0:14:38.01,Default,,0000,0000,0000,,Сіз дұрыс тыңдайсыз ба? Корра~!
Dialogue: 0,0:14:38.01,0:14:42.01,Default,,0000,0000,0000,,Маған жіберіңіз. Жеткізу кезінде қолма-қол ақша бар!
Dialogue: 0,0:14:38.01,0:14:42.01,Default,,0000,0000,0000,,Иә, иә….
Dialogue: 0,0:14:42.01,0:14:44.01,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:14:47.68,0:14:51.52,Default,,0000,0000,0000,,Иә? Эй, Кагура не болды?
Dialogue: 0,0:14:51.52,0:14:55.19,Default,,0000,0000,0000,,Мұғалім.
Dialogue: 0,0:14:51.52,0:14:55.19,Default,,0000,0000,0000,,Не, бірдеңені ұмыттың ба?
Dialogue: 0,0:14:55.19,0:14:59.03,Default,,0000,0000,0000,,Әй, мұғалім, үстел және орындық➡
Dialogue: 0,0:14:59.03,0:15:01.30,Default,,0000,0000,0000,,Мен оны алсам, шынымен жаман ба?
Dialogue: 0,0:15:01.30,0:15:03.30,Default,,0000,0000,0000,,Бұл жаман болар еді.
Dialogue: 0,0:15:05.30,0:15:08.47,Default,,0000,0000,0000,,Мен кәдесый ретінде үйге бірдеңе апаруды ойладым...
Dialogue: 0,0:15:08.47,0:15:11.14,Default,,0000,0000,0000,,Иә? Ni!
Dialogue: 0,0:15:11.14,0:15:15.48,Default,,0000,0000,0000,,Жарайды
Dialogue: 0,0:15:11.14,0:15:15.48,Default,,0000,0000,0000,,Сіз оны үйге апарып қойғансыз.
Dialogue: 0,0:15:15.48,0:15:17.48,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:17.48,0:15:20.65,Default,,0000,0000,0000,,Иә, барлығымен естеліктер!
Dialogue: 0,0:15:20.65,0:15:22.98,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:15:22.98,0:15:27.49,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:15:27.49,0:15:30.83,Default,,0000,0000,0000,,А, рахмет, ұстаз!
Dialogue: 0,0:15:30.83,0:15:33.03,Default,,0000,0000,0000,,Ах… олар ақылды да, сүйкімді де көрінеді, иә, Аня?
Dialogue: 0,0:15:36.00,0:15:39.50,Default,,0000,0000,0000,,Ал, енді мектеп бітірушілерге саяхатқа барайық.
Dialogue: 0,0:15:36.00,0:15:39.50,Default,,0000,0000,0000,,Сиқырлы елге барайық.
Dialogue: 0,0:15:39.50,0:15:42.17,Default,,0000,0000,0000,,Коёми-сан деген кім?
Dialogue: 0,0:15:39.50,0:15:42.17,Default,,0000,0000,0000,,Себебі мен бара алмадым.
Dialogue: 0,0:15:42.17,0:15:44.67,Default,,0000,0000,0000,,көремін.
Dialogue: 0,0:15:42.17,0:15:44.67,Default,,0000,0000,0000,,Күндер күнтізбеде ➡
Dialogue: 0,0:15:44.67,0:15:46.84,Default,,0000,0000,0000,,Нәтижелер жарияланғанға дейін.
Dialogue: 0,0:15:44.67,0:15:46.84,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:46.84,0:15:49.84,Default,,0000,0000,0000,,Өйткені ол құлап кетсе
Dialogue: 0,0:15:46.84,0:15:49.84,Default,,0000,0000,0000,,Атмосфера нашар!
Dialogue: 0,0:15:49.84,0:15:52.68,Default,,0000,0000,0000,,Сіз өтесіз деген сөз.
Dialogue: 0,0:15:49.84,0:15:52.68,Default,,0000,0000,0000,,Презентациядан кейін!
Dialogue: 0,0:15:52.68,0:15:55.52,Default,,0000,0000,0000,,Иә, дұрыс, сен өтесің!
Dialogue: 0,0:15:55.52,0:15:58.02,Default,,0000,0000,0000,,Сену маңызды.
Dialogue: 0,0:15:55.52,0:15:58.02,Default,,0000,0000,0000,,Хоо!
Dialogue: 0,0:15:58.02,0:16:00.12,Default,,0000,0000,0000,,Мен қатты ашуландым!
Dialogue: 0,0:16:00.12,0:16:02.29,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:16:02.29,0:16:05.63,Default,,0000,0000,0000,,Коёми-чан да
Dialogue: 0,0:16:02.29,0:16:05.63,Default,,0000,0000,0000,,Мен тапсырсам тамаша болар еді.
Dialogue: 0,0:16:05.63,0:16:08.80,Default,,0000,0000,0000,,Соя аздап
Dialogue: 0,0:16:05.63,0:16:08.80,Default,,0000,0000,0000,,Маған Чио-чанның тұмарын беріңіз.
Dialogue: 0,0:16:08.80,0:16:11.63,Default,,0000,0000,0000,,Тағы да бар, солай ма?
Dialogue: 0,0:16:08.80,0:16:11.63,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:16:11.63,0:16:13.63,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:16:13.63,0:16:15.64,Default,,0000,0000,0000,,Мен не істеуім керек...?
Dialogue: 0,0:16:15.64,0:16:17.64,Default,,0000,0000,0000,,Эй~!
Dialogue: 0,0:16:17.64,0:16:21.31,Default,,0000,0000,0000,,Мён Мён
Dialogue: 0,0:16:17.64,0:16:21.31,Default,,0000,0000,0000,,Мён Мён Мён.
Dialogue: 0,0:16:21.31,0:16:23.81,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:16:23.81,0:16:26.48,Default,,0000,0000,0000,,Мен оған күшімді салып жатырмын.
Dialogue: 0,0:16:26.48,0:16:28.48,Default,,0000,0000,0000,,Қажетсіз ештеңе жасамаңыз!
Dialogue: 0,0:16:30.65,0:16:32.65,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:16:32.65,0:16:35.66,Default,,0000,0000,0000,,Не болды? Өтінемін, үйге ерте қайт.
Dialogue: 0,0:16:32.65,0:16:35.66,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:16:35.66,0:16:38.49,Default,,0000,0000,0000,,Тезірек үйге қайтайық?
Dialogue: 0,0:16:35.66,0:16:38.49,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:16:38.49,0:16:40.83,Default,,0000,0000,0000,,Сонда кездескенше
Dialogue: 0,0:16:38.49,0:16:40.83,Default,,0000,0000,0000,,Үйге қайтқанда сақ болыңыз.
Dialogue: 0,0:16:40.83,0:16:44.50,Default,,0000,0000,0000,,Юкари-чан да.
Dialogue: 0,0:16:40.83,0:16:44.50,Default,,0000,0000,0000,,О.
Dialogue: 0,0:16:44.50,0:16:46.83,Default,,0000,0000,0000,,Осы жазда тағы да саяхатқа шығайық!
Dialogue: 0,0:16:46.83,0:16:49.17,Default,,0000,0000,0000,,Аа, егер сізге ұнаса.
Dialogue: 0,0:16:49.17,0:16:51.17,Default,,0000,0000,0000,,Хонжа, көп болды.
Dialogue: 0,0:16:51.17,0:17:11.63,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:17:11.63,0:17:13.63,Default,,0000,0000,0000,,А, түсіндім.
Dialogue: 0,0:17:13.63,0:17:48.53,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:17:50.50,0:17:54.67,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:18:01.11,0:18:03.11,Default,,0000,0000,0000,,№ 3661.
Dialogue: 0,0:18:03.11,0:18:05.11,Default,,0000,0000,0000,,Самурай?
Dialogue: 0,0:18:05.11,0:18:08.28,Default,,0000,0000,0000,,Бұл жақсы ма, әлде жаман ба?
Dialogue: 0,0:18:05.11,0:18:08.28,Default,,0000,0000,0000,,Бұл мен түсінбейтін сан.
Dialogue: 0,0:18:08.28,0:18:10.79,Default,,0000,0000,0000,,Ауа райы жақсы болды.
Dialogue: 0,0:18:08.28,0:18:10.79,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:18:10.79,0:18:13.79,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:18:10.79,0:18:13.79,Default,,0000,0000,0000,,Хмм...!
Dialogue: 0,0:18:13.79,0:18:15.79,Default,,0000,0000,0000,,Бүгін біз мұны істейміз бе?
Dialogue: 0,0:18:15.79,0:18:19.29,Default,,0000,0000,0000,,Бұл да қызықты көрінеді.
Dialogue: 0,0:18:15.79,0:18:19.29,Default,,0000,0000,0000,,О, бұл да жақсы!
Dialogue: 0,0:18:19.29,0:18:22.13,Default,,0000,0000,0000,,Чио-чан, мен оны асыға күтемін.
Dialogue: 0,0:18:19.29,0:18:22.13,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:18:22.13,0:18:25.30,Default,,0000,0000,0000,,Өткен күні мен мінген роликті
Dialogue: 0,0:18:22.13,0:18:25.30,Default,,0000,0000,0000,,Қайтадан атқа мінейік.
Dialogue: 0,0:18:25.30,0:18:28.14,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:18:25.30,0:18:28.14,Default,,0000,0000,0000,,Барлығы сондай батыл.
Dialogue: 0,0:18:28.14,0:18:30.81,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:18:28.14,0:18:30.81,Default,,0000,0000,0000,,А, күнтізбе.
Dialogue: 0,0:18:30.81,0:18:33.47,Default,,0000,0000,0000,,Сіз келдіңіз бе?
Dialogue: 0,0:18:30.81,0:18:33.47,Default,,0000,0000,0000,,Нәтижелер жарияланғаннан кейін➡
Dialogue: 0,0:18:33.47,0:18:36.14,Default,,0000,0000,0000,,Сиқырлы жерге тура бару
Dialogue: 0,0:18:33.47,0:18:36.14,Default,,0000,0000,0000,,Сіз байыпты болдыңыз ба?
Dialogue: 0,0:18:36.14,0:18:38.15,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:18:38.15,0:18:40.48,Default,,0000,0000,0000,,Тек осы жерде ыңғайлы
Dialogue: 0,0:18:38.15,0:18:40.48,Default,,0000,0000,0000,,Өйткені ол сәйкес келмеді.
Dialogue: 0,0:18:40.48,0:18:43.98,Default,,0000,0000,0000,,Жарайды, жұбату сөздері
Dialogue: 0,0:18:40.48,0:18:43.98,Default,,0000,0000,0000,,Себебі мен бұл туралы ойладым➡
Dialogue: 0,0:18:43.98,0:18:45.99,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:18:45.99,0:18:49.32,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:18:45.99,0:18:49.32,Default,,0000,0000,0000,,Тұмарыңызды әкелдіңіз бе?
Dialogue: 0,0:18:49.32,0:18:51.49,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:18:49.32,0:18:51.49,Default,,0000,0000,0000,,Маған аздап қарыз беріңізші.
Dialogue: 0,0:18:51.49,0:18:55.09,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:18:51.49,0:18:55.09,Default,,0000,0000,0000,,Соңында қайтадан қуат...
Dialogue: 0,0:18:57.16,0:19:00.10,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:18:57.16,0:19:00.10,Default,,0000,0000,0000,,​​О?
Dialogue: 0,0:19:00.10,0:19:03.44,Default,,0000,0000,0000,,Чио-чан
Dialogue: 0,0:19:00.10,0:19:03.44,Default,,0000,0000,0000,,Тіпті Сатоши де емтихан тапсырған дейді➡
Dialogue: 0,0:19:03.44,0:19:05.61,Default,,0000,0000,0000,,Маған өтуге күш беріңіз!
Dialogue: 0,0:19:03.44,0:19:05.61,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:19:05.61,0:19:08.44,Default,,0000,0000,0000,,Фугиин~!
Dialogue: 0,0:19:08.44,0:19:11.45,Default,,0000,0000,0000,,Мм...!
Dialogue: 0,0:19:08.44,0:19:11.45,Default,,0000,0000,0000,,Күнтізбе ~.
Dialogue: 0,0:19:11.45,0:19:14.11,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:11.45,0:19:14.11,Default,,0000,0000,0000,,Қарасам, нөмір жоқ.
Dialogue: 0,0:19:14.11,0:19:16.12,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:19:16.12,0:19:18.29,Default,,0000,0000,0000,,Сіз әлі де қуат қосып жатырсыз!
Dialogue: 0,0:19:18.29,0:19:22.79,Default,,0000,0000,0000,,Қарама! Апыр-ай!
Dialogue: 0,0:19:22.79,0:19:24.79,Default,,0000,0000,0000,,Хаха….
Dialogue: 0,0:19:24.79,0:19:27.49,Default,,0000,0000,0000,,Ах, а... а.
Dialogue: 0,0:19:32.47,0:19:34.80,Default,,0000,0000,0000,,Ах... бұл...
Dialogue: 0,0:19:34.80,0:19:36.97,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:19:36.97,0:19:39.64,Default,,0000,0000,0000,,《Болды. Ол болды.
Dialogue: 0,0:19:39.64,0:19:41.64,Default,,0000,0000,0000,,Міне болды! 》
Dialogue: 0,0:19:41.64,0:19:45.15,Default,,0000,0000,0000,,Міне, сол жерде болды!
Dialogue: 0,0:19:45.15,0:19:47.65,Default,,0000,0000,0000,,Уау! Құттықтаймыз!
Dialogue: 0,0:19:47.65,0:19:50.65,Default,,0000,0000,0000,,Құттықтаймыз!
Dialogue: 0,0:19:47.65,0:19:50.65,Default,,0000,0000,0000,,Керемет!
Dialogue: 0,0:19:50.65,0:19:52.65,Default,,0000,0000,0000,,Құттықтаймыз.
Dialogue: 0,0:19:50.65,0:19:52.65,Default,,0000,0000,0000,,Рахмет.
Dialogue: 0,0:19:52.65,0:19:55.66,Default,,0000,0000,0000,,Барлығыңызға рахмет….
Dialogue: 0,0:19:55.66,0:19:57.86,Default,,0000,0000,0000,,Күнтізбе~!
Dialogue: 0,0:19:59.83,0:20:01.83,Default,,0000,0000,0000,,Жылдамдық көрсетілсе, тере аласың ба?
Dialogue: 0,0:20:01.83,0:20:03.83,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:20:01.83,0:20:03.83,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:20:03.83,0:20:06.67,Default,,0000,0000,0000,,Денеңізді көтеріңіз!
Dialogue: 0,0:20:03.83,0:20:06.67,Default,,0000,0000,0000,,Керемет идея!
Dialogue: 0,0:20:06.67,0:20:09.84,Default,,0000,0000,0000,,Жарайды...
Dialogue: 0,0:20:06.67,0:20:09.84,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:20:09.84,0:20:13.67,Default,,0000,0000,0000,,Йо, күнтізбе ауыр, сондықтан Чиё-чан!
Dialogue: 0,0:20:09.84,0:20:13.67,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:20:13.67,0:20:15.84,Default,,0000,0000,0000,,Кя~ Кя~!
Dialogue: 0,0:20:13.67,0:20:15.84,Default,,0000,0000,0000,,Васшои Васшои!
Dialogue: 0,0:20:15.84,0:20:18.35,Default,,0000,0000,0000,,Кя~ Кя~!
Dialogue: 0,0:20:15.84,0:20:18.35,Default,,0000,0000,0000,,Васшои Васшои!
Dialogue: 0,0:20:18.35,0:20:21.52,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:20:18.35,0:20:21.52,Default,,0000,0000,0000,,Олай болса, ойынға барайық!
Dialogue: 0,0:20:21.52,0:20:23.85,Default,,0000,0000,0000,,Мен оны асыға күтемін, Сакаки-сан.
Dialogue: 0,0:20:23.85,0:20:26.35,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:20:23.85,0:20:26.35,Default,,0000,0000,0000,,Бүгін ойнайық.
Dialogue: 0,0:20:26.35,0:20:28.36,Default,,0000,0000,0000,,Шуппа~цу!
Dialogue: 0,0:20:28.36,0:20:30.86,Default,,0000,0000,0000,,Эй, ол жерге қалай жетеміз?
Dialogue: 0,0:20:30.86,0:20:33.36,Default,,0000,0000,0000,,Әзірше бұл станция, станция.
Dialogue: 0,0:20:33.36,0:20:36.53,Default,,0000,0000,0000,,Йоши Сакаки, ​​станцияға жүгіреміз бе?
Dialogue: 0,0:20:36.53,0:20:38.53,Default,,0000,0000,0000,,Жоқ, мен...
Dialogue: 0,0:20:38.53,0:20:40.87,Default,,0000,0000,0000,,Біріншіден, менің ойымша, роликтер.
Dialogue: 0,0:20:40.87,0:20:44.20,Default,,0000,0000,0000,,Бұл қорқынышты~
Dialogue: 0,0:20:40.87,0:20:44.20,Default,,0000,0000,0000,,Күнтізбеге көңіліңіз түспесін.
Dialogue: 0,0:20:44.20,0:20:47.54,Default,,0000,0000,0000,,бәрі жақсы.
Dialogue: 0,0:20:44.20,0:20:47.54,Default,,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:20:47.54,0:20:49.88,Default,,0000,0000,0000,,Жаңасы да жасалған сияқты.
Dialogue: 0,0:20:49.88,0:20:52.21,Default,,0000,0000,0000,,Бұл да өте қорқынышты сияқты.
Dialogue: 0,0:20:52.21,0:20:54.21,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:20:54.21,0:20:56.22,Default,,0000,0000,0000,,Жарайды, міндетті түрде мінейік.
Dialogue: 0,0:20:56.22,0:20:58.22,Default,,0000,0000,0000,,《Мен...
Dialogue: 0,0:20:58.22,0:21:00.22,Default,,0000,0000,0000,,Оқуды бітіргеннен кейін де》
Dialogue: 0,0:21:02.16,0:21:04.16,Default,,0000,0000,0000,,《Чиё: Барлығы бірдей》
Dialogue: 0,0:21:07.16,0:21:09.50,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:21:07.16,0:21:09.50,Default,,0000,0000,0000,,Чиёчан!
Dialogue: 0,0:21:09.50,0:21:12.33,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:21:09.50,0:21:12.33,Default,,0000,0000,0000,,Кеттік, Чио-чан.
Dialogue: 0,0:21:12.33,0:21:14.34,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:21:14.34,0:21:50.04,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:51.54,0:21:57.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory