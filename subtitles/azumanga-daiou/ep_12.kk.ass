Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.02,0:01:34.02,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:01:34.02,0:01:43.87,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:01:43.87,0:01:47.87,Default,,0000,0000,0000,,Ах, бай адамдар осындай кемені бос уақыттарында пайдаланады —
Dialogue: 0,0:01:52.87,0:01:55.57,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:01:57.88,0:01:59.88,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:02:03.49,0:02:07.16,Default,,0000,0000,0000,,Бір!
Dialogue: 0,0:02:03.49,0:02:07.16,Default,,0000,0000,0000,,Иә? Қайырлы таң Тадаёси-сан.
Dialogue: 0,0:02:07.16,0:02:09.16,Default,,0000,0000,0000,,Е.
Dialogue: 0,0:02:09.16,0:02:13.50,Default,,0000,0000,0000,,< Чиё: Әрқашан менің
Dialogue: 0,0:02:09.16,0:02:13.50,Default,,0000,0000,0000,,Бұл менің қасымда Тадайоши-сан.
Dialogue: 0,0:02:13.50,0:02:17.00,Default,,0000,0000,0000,,Мен 5 жасымнан бастап
Dialogue: 0,0:02:13.50,0:02:17.00,Default,,0000,0000,0000,,Біз бірге тұрамыз.
Dialogue: 0,0:02:17.00,0:02:19.00,Default,,0000,0000,0000,,Біз алғаш кездескен кезде, менімен➡
Dialogue: 0,0:02:19.00,0:02:21.84,Default,,0000,0000,0000,,Онша ерекшеленбейді
Dialogue: 0,0:02:19.00,0:02:21.84,Default,,0000,0000,0000,,Үлкен болса да...
Dialogue: 0,0:02:21.84,0:02:24.67,Default,,0000,0000,0000,,Тадаёси мырза
Dialogue: 0,0:02:21.84,0:02:24.67,Default,,0000,0000,0000,,Үлкенірек және үлкендеу➡
Dialogue: 0,0:02:24.67,0:02:28.01,Default,,0000,0000,0000,,Сіз мені тастап кеттіңіз＞
Dialogue: 0,0:02:28.01,0:02:30.01,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:02:30.01,0:02:32.18,Default,,0000,0000,0000,,Нин!
Dialogue: 0,0:02:30.01,0:02:32.18,Default,,0000,0000,0000,,Уау?
Dialogue: 0,0:02:32.18,0:02:36.35,Default,,0000,0000,0000,,<Менің күнім
Dialogue: 0,0:02:32.18,0:02:36.35,Default,,0000,0000,0000,,Түскі ас қорабын жасаудан бастаңыз.
Dialogue: 0,0:02:36.35,0:02:39.19,Default,,0000,0000,0000,,Спаржа бекон салаты.
Dialogue: 0,0:02:39.19,0:02:42.36,Default,,0000,0000,0000,,Және кішкентай омлет.
Dialogue: 0,0:02:42.36,0:02:45.03,Default,,0000,0000,0000,,Содан кейін әкеммен
Dialogue: 0,0:02:42.36,0:02:45.03,Default,,0000,0000,0000,,Анашым ояныңыз...>
Dialogue: 0,0:02:45.03,0:02:47.53,Default,,0000,0000,0000,,Таң атты!
Dialogue: 0,0:02:47.53,0:02:50.03,Default,,0000,0000,0000,,<Мен таңғы ас ішемін>
Dialogue: 0,0:02:50.03,0:02:53.33,Default,,0000,0000,0000,,Ммм... мммм.
Dialogue: 0,0:02:58.04,0:03:01.64,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:03:01.64,0:03:05.31,Default,,0000,0000,0000,,＜Сосын мен мектепке барамын＞
Dialogue: 0,0:03:05.31,0:03:08.31,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:03:10.65,0:03:14.99,Default,,0000,0000,0000,,<Жақсы күнде өзімді жақсы сезінемін.
Dialogue: 0,0:03:14.99,0:03:18.16,Default,,0000,0000,0000,,А, бірақ
Dialogue: 0,0:03:14.99,0:03:18.16,Default,,0000,0000,0000,,Себебі мен жаңа қолшатыр алдым➡
Dialogue: 0,0:03:18.16,0:03:20.83,Default,,0000,0000,0000,,Жаңбыр да жақсы болуы мүмкін>
Dialogue: 0,0:03:20.83,0:03:23.17,Default,,0000,0000,0000,,Чиёчан!
Dialogue: 0,0:03:20.83,0:03:23.17,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:23.17,0:03:26.67,Default,,0000,0000,0000,,Чиёчан!
Dialogue: 0,0:03:23.17,0:03:26.67,Default,,0000,0000,0000,,Көптен бері көрмедім!
Dialogue: 0,0:03:26.67,0:03:30.01,Default,,0000,0000,0000,,Әй, Миручи~ Юка-чан! Хехе.
Dialogue: 0,0:03:30.01,0:03:32.34,Default,,0000,0000,0000,,<Бастауыш сыныптағы сыныптасы➡
Dialogue: 0,0:03:32.34,0:03:34.68,Default,,0000,0000,0000,,Бұл Мирчи~ мен Юка-чан>
Dialogue: 0,0:03:34.68,0:03:38.85,Default,,0000,0000,0000,,Көптен бері көрмедім.
Dialogue: 0,0:03:34.68,0:03:38.85,Default,,0000,0000,0000,,Ой, бұл сіздің орта мектеп формасы ма?
Dialogue: 0,0:03:38.85,0:03:40.85,Default,,0000,0000,0000,,Жазғы киімдерді бірінші рет көру.
Dialogue: 0,0:03:40.85,0:03:43.19,Default,,0000,0000,0000,,Хехе, сүйкімді емес пе?
Dialogue: 0,0:03:43.19,0:03:46.02,Default,,0000,0000,0000,,Бірақ формаға қысқы киімдер мен жазғы киімдер жатады➡
Dialogue: 0,0:03:46.02,0:03:48.52,Default,,0000,0000,0000,,Юбка ұзындығы өзгермейді.
Dialogue: 0,0:03:48.52,0:03:51.19,Default,,0000,0000,0000,,<Екеуі де бастауыш мектептің 6-сыныбында оқиды➡
Dialogue: 0,0:03:51.19,0:03:53.86,Default,,0000,0000,0000,,Мен орта мектептің екінші курс студентімін.
Dialogue: 0,0:03:53.86,0:03:58.03,Default,,0000,0000,0000,,Бастауыш мектептің 5-сыныбында оқып жүрген кезім
Dialogue: 0,0:03:53.86,0:03:58.03,Default,,0000,0000,0000,,Себебі мен орта мектептің бірінші жылына баға жіберіп алдым》
Dialogue: 0,0:03:58.03,0:04:01.47,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:03:58.03,0:04:01.47,Default,,0000,0000,0000,,Мектепте не танымал?
Dialogue: 0,0:04:01.47,0:04:04.47,Default,,0000,0000,0000,,Арқанмен секіру!
Dialogue: 0,0:04:01.47,0:04:04.47,Default,,0000,0000,0000,,Жақында қайтадан танымал болды.
Dialogue: 0,0:04:04.47,0:04:07.14,Default,,0000,0000,0000,,Иә! Бұл өте қызық, солай емес пе?
Dialogue: 0,0:04:07.14,0:04:09.14,Default,,0000,0000,0000,,Барлығы бірге ойнай алады.
Dialogue: 0,0:04:09.14,0:04:12.65,Default,,0000,0000,0000,,Уау, арқанмен секіргенім есімде.
Dialogue: 0,0:04:12.65,0:04:14.98,Default,,0000,0000,0000,,Орта мектепте
Dialogue: 0,0:04:12.65,0:04:14.98,Default,,0000,0000,0000,,Не трендте?
Dialogue: 0,0:04:14.98,0:04:17.49,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:04:14.98,0:04:17.49,Default,,0000,0000,0000,,Юка Чио-чан➡
Dialogue: 0,0:04:17.49,0:04:20.32,Default,,0000,0000,0000,,Мен орта мектеп оқушысымын.
Dialogue: 0,0:04:17.49,0:04:20.32,Default,,0000,0000,0000,,Мен ойнамаймын.
Dialogue: 0,0:04:20.32,0:04:22.32,Default,,0000,0000,0000,,А, мен түсіндім.
Dialogue: 0,0:04:25.66,0:04:28.33,Default,,0000,0000,0000,,Тіпті жоғары сынып оқушылары да ойнай алады...
Dialogue: 0,0:04:25.66,0:04:28.33,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:28.33,0:04:31.03,Default,,0000,0000,0000,,Бірақ мен арқаннан секірмейтін шығармын...
Dialogue: 0,0:04:34.00,0:04:36.00,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:38.01,0:04:40.01,Default,,0000,0000,0000,,Сонда кездескенше.
Dialogue: 0,0:04:38.01,0:04:40.01,Default,,0000,0000,0000,,Жақында кездескенше.
Dialogue: 0,0:04:40.01,0:04:42.51,Default,,0000,0000,0000,,Сау болыңыз.
Dialogue: 0,0:04:40.01,0:04:42.51,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:04:42.51,0:04:44.68,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:04:44.68,0:04:48.68,Default,,0000,0000,0000,,< Сүтті~ және Юка-чан
Dialogue: 0,0:04:44.68,0:04:48.68,Default,,0000,0000,0000,,Бастауыш мектепке бару.
Dialogue: 0,0:04:48.68,0:04:52.69,Default,,0000,0000,0000,,Келесі күнге дейін
Dialogue: 0,0:04:48.68,0:04:52.69,Default,,0000,0000,0000,,Мен де бардым, бірақ...>
Dialogue: 0,0:04:52.69,0:04:56.02,Default,,0000,0000,0000,,Бүгін бассейн!
Dialogue: 0,0:04:52.69,0:04:56.02,Default,,0000,0000,0000,,Бірінші сағаттан бастап бұл бассейн!
Dialogue: 0,0:04:56.02,0:04:58.03,Default,,0000,0000,0000,,А, күте тұрыңыз!
Dialogue: 0,0:04:58.03,0:04:59.96,Default,,0000,0000,0000,,Хехехе Ахаха!
Dialogue: 0,0:04:59.96,0:05:02.56,Default,,0000,0000,0000,,Күте тұрыңыз! Фуфуфу!
Dialogue: 0,0:05:06.64,0:05:08.64,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:05:08.64,0:05:12.04,Default,,0000,0000,0000,,＜ Бірақ... Бірақ мен...＞
Dialogue: 0,0:05:13.98,0:05:16.48,Default,,0000,0000,0000,,<Мен жоғары сынып оқушысымын>
Dialogue: 0,0:05:16.48,0:05:19.98,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:05:16.48,0:05:19.98,Default,,0000,0000,0000,,Иә? Ах, қайырлы таң.
Dialogue: 0,0:05:19.98,0:05:21.98,Default,,0000,0000,0000,,Сау бол, Джоджо!
Dialogue: 0,0:05:21.98,0:05:25.82,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:05:21.98,0:05:25.82,Default,,0000,0000,0000,,Бастауыш сыныпта менің сыныптасым болды.
Dialogue: 0,0:05:25.82,0:05:27.82,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:05:25.82,0:05:27.82,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:05:30.16,0:05:33.86,Default,,0000,0000,0000,,< Егер сіз түзу жүрсеңіз
Dialogue: 0,0:05:30.16,0:05:33.86,Default,,0000,0000,0000,,Бұл мен оқитын орта мектеп＞
Dialogue: 0,0:05:35.83,0:05:38.33,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:05:40.50,0:05:45.17,Default,,0000,0000,0000,,Бастауыш мектепте
Dialogue: 0,0:05:40.50,0:05:45.17,Default,,0000,0000,0000,,Арқанмен секіру танымал болып бара жатқан сияқты.
Dialogue: 0,0:05:45.17,0:05:48.84,Default,,0000,0000,0000,,Сағынышпен секіру.
Dialogue: 0,0:05:48.84,0:05:51.35,Default,,0000,0000,0000,,<Бұл менімен бір сыныпта оқитын Сакаки-сан.
Dialogue: 0,0:05:51.35,0:05:54.18,Default,,0000,0000,0000,,Сакаки мырза
Dialogue: 0,0:05:51.35,0:05:54.18,Default,,0000,0000,0000,,Өйткені менің үйім көршім➡
Dialogue: 0,0:05:54.18,0:05:56.18,Default,,0000,0000,0000,,Біз мектепке барар жолда жиі кездесеміз＞
Dialogue: 0,0:05:56.18,0:05:58.69,Default,,0000,0000,0000,,Сен де істедің бе, Сакаки?
Dialogue: 0,0:05:58.69,0:06:01.29,Default,,0000,0000,0000,,Мен оны жақсы меңгердім.
Dialogue: 0,0:06:01.29,0:06:03.63,Default,,0000,0000,0000,,Әй... Әй!
Dialogue: 0,0:06:03.63,0:06:05.63,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,0:06:05.63,0:06:08.63,Default,,0000,0000,0000,,<Сакаки-сан үлкен, бірақ тыныш.
Dialogue: 0,0:06:08.63,0:06:11.13,Default,,0000,0000,0000,,Ол мені жақсы тыңдайды＞
Dialogue: 0,0:06:11.13,0:06:13.64,Default,,0000,0000,0000,,Ойланып көрейікші
Dialogue: 0,0:06:11.13,0:06:13.64,Default,,0000,0000,0000,,Біз бүгіннен бастап жүзуге барамыз.
Dialogue: 0,0:06:13.64,0:06:15.64,Default,,0000,0000,0000,,Мен оны асыға күтемін.
Dialogue: 0,0:06:15.64,0:06:19.14,Default,,0000,0000,0000,,Сакаки-сан сияқты мен де өте қуаныштымын...
Dialogue: 0,0:06:19.14,0:06:21.81,Default,,0000,0000,0000,,Міне! ? О, о...
Dialogue: 0,0:06:21.81,0:06:25.15,Default,,0000,0000,0000,,＜ Бірақ кейде олар кенеттен жоғалып кетеді.
Dialogue: 0,0:06:25.15,0:06:27.15,Default,,0000,0000,0000,,Бұл жұмбақ...》
Dialogue: 0,0:06:27.15,0:06:30.15,Default,,0000,0000,0000,,Қайырлы таң!
Dialogue: 0,0:06:30.15,0:06:33.82,Default,,0000,0000,0000,,Балалар, аяқтадыңдар ма?
Dialogue: 0,0:06:30.15,0:06:33.82,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:06:33.82,0:06:37.83,Default,,0000,0000,0000,,О Чиё-чан, қайырлы таң Коёми~!
Dialogue: 0,0:06:33.82,0:06:37.83,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:06:37.83,0:06:41.00,Default,,0000,0000,0000,,<Бұл Томо-чан мен Коёми-сан.
Dialogue: 0,0:06:37.83,0:06:41.00,Default,,0000,0000,0000,,Жақсы…>
Dialogue: 0,0:06:41.00,0:06:43.00,Default,,0000,0000,0000,,Даналық.
Dialogue: 0,0:06:41.00,0:06:43.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:43.00,0:06:46.50,Default,,0000,0000,0000,,Кеше мен сұраған бағдарламаны жаздыңыз ба?
Dialogue: 0,0:06:46.50,0:06:48.84,Default,,0000,0000,0000,,О, мен ұмытып қалдым.
Dialogue: 0,0:06:48.84,0:06:50.84,Default,,0000,0000,0000,,Күрсіндім, мен оны білдім...
Dialogue: 0,0:06:50.84,0:06:53.68,Default,,0000,0000,0000,,Мен сенен сұрағаным үшін ақымақ болдым...
Dialogue: 0,0:06:53.68,0:06:56.51,Default,,0000,0000,0000,,Барка! ақымақ!
Dialogue: 0,0:06:53.68,0:06:56.51,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:06:56.51,0:06:59.01,Default,,0000,0000,0000,,Барка Барка!
Dialogue: 0,0:06:59.01,0:07:00.95,Default,,0000,0000,0000,,Барка! ақымақ!
Dialogue: 0,0:07:00.95,0:07:03.12,Default,,0000,0000,0000,,Барка! Баа….
Dialogue: 0,0:07:03.12,0:07:08.62,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:07:03.12,0:07:08.62,Default,,0000,0000,0000,,Ммм...!
Dialogue: 0,0:07:08.62,0:07:11.46,Default,,0000,0000,0000,,＜Бұл адамдар...＞
Dialogue: 0,0:07:11.46,0:07:15.30,Default,,0000,0000,0000,,Сен ақымақсың!
Dialogue: 0,0:07:11.46,0:07:15.30,Default,,0000,0000,0000,,(қарлығаш айқайы)
Dialogue: 0,0:07:15.30,0:07:20.14,Default,,0000,0000,0000,,Қара, қарашы, жалқаулап жүгірсең одан сайын шаршайсың!
Dialogue: 0,0:07:20.14,0:07:24.14,Default,,0000,0000,0000,,Е, «Шитари» бұл
Dialogue: 0,0:07:20.14,0:07:24.14,Default,,0000,0000,0000,,Бұл «су» етістігінің жалғаулық түрі➡
Dialogue: 0,0:07:24.14,0:07:27.48,Default,,0000,0000,0000,,зат есім және
Dialogue: 0,0:07:24.14,0:07:27.48,Default,,0000,0000,0000,,Сын есім ретінде де қолданылады….
Dialogue: 0,0:07:27.48,0:07:30.31,Default,,0000,0000,0000,,Келмейді.
Dialogue: 0,0:07:30.31,0:07:32.65,Default,,0000,0000,0000,,Юкари-чан жиі кешігіп қалады.
Dialogue: 0,0:07:32.65,0:07:34.65,Default,,0000,0000,0000,,Бұл рекордтық жаңарту...
Dialogue: 0,0:07:34.65,0:07:36.65,Default,,0000,0000,0000,,Бүгін бірдеңе болды ма?
Dialogue: 0,0:07:36.65,0:07:38.65,Default,,0000,0000,0000,,Енді, өйткені бұл Юкари-сенсэй➡ туралы
Dialogue: 0,0:07:38.65,0:07:40.82,Default,,0000,0000,0000,,Бұл жай ғана артық ұйықтау емес...
Dialogue: 0,0:07:40.82,0:07:43.49,Default,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:07:40.82,0:07:43.49,Default,,0000,0000,0000,,Өйткені бұл Юкари-чан➡ туралы
Dialogue: 0,0:07:43.49,0:07:45.49,Default,,0000,0000,0000,,Шектеулі BOX ойындарының шығу күні➡
Dialogue: 0,0:07:45.49,0:07:47.66,Default,,0000,0000,0000,,Бірдеңе болып жатыр ма деп, саған қарап тұрмын.
Dialogue: 0,0:07:47.66,0:07:49.66,Default,,0000,0000,0000,,Бұл өте ақымақ...
Dialogue: 0,0:07:49.66,0:07:53.00,Default,,0000,0000,0000,,Аа, күнтізбе ақымақ.
Dialogue: 0,0:07:49.66,0:07:53.00,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:07:53.00,0:07:55.00,Default,,0000,0000,0000,,Бұл!
Dialogue: 0,0:07:53.00,0:07:55.00,Default,,0000,0000,0000,,Абаба...!
Dialogue: 0,0:07:57.01,0:08:00.28,Default,,0000,0000,0000,,《Мен не істеуім керек...?
Dialogue: 0,0:08:00.28,0:08:02.28,Default,,0000,0000,0000,,Дос болып қалсақ...》
Dialogue: 0,0:08:02.28,0:08:04.58,Default,,0000,0000,0000,,Хумяаааааааааааааааааааааа!
Dialogue: 0,0:08:07.12,0:08:09.95,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:08:09.95,0:08:11.95,Default,,0000,0000,0000,,Бұл мысық!
Dialogue: 0,0:08:11.95,0:08:14.46,Default,,0000,0000,0000,,(Мысық мияу)
Dialogue: 0,0:08:14.46,0:08:17.46,Default,,0000,0000,0000,,Ах... уф...
Dialogue: 0,0:08:17.46,0:08:22.13,Default,,0000,0000,0000,,Ммм?
Dialogue: 0,0:08:22.13,0:08:24.13,Default,,0000,0000,0000,,Бұл өздігінен оқу емес!
Dialogue: 0,0:08:24.13,0:08:26.30,Default,,0000,0000,0000,,<Бұл Юкари-сенсэй, менің сыныптағы мұғалімім.
Dialogue: 0,0:08:26.30,0:08:28.47,Default,,0000,0000,0000,,Мен оқытатын пән ағылшын тілі＞
Dialogue: 0,0:08:28.47,0:08:30.81,Default,,0000,0000,0000,,Әй, келмес бұрын➡
Dialogue: 0,0:08:30.81,0:08:33.14,Default,,0000,0000,0000,,Біраз
Dialogue: 0,0:08:30.81,0:08:33.14,Default,,0000,0000,0000,,Мен бірнеше ойын бағдарламалық құралын сатып алуға бардым.
Dialogue: 0,0:08:33.14,0:08:36.98,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:08:33.14,0:08:36.98,Default,,0000,0000,0000,,Жұмыс күні болса да, сызық бар.
Dialogue: 0,0:08:36.98,0:08:38.98,Default,,0000,0000,0000,,Мен сіздің колледж студенті екеніңізге сенімдімін.
Dialogue: 0,0:08:38.98,0:08:41.15,Default,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:08:38.98,0:08:41.15,Default,,0000,0000,0000,,Сізге рахмет, мен кешігіп қалдым!
Dialogue: 0,0:08:41.15,0:08:43.65,Default,,0000,0000,0000,,<Ол дәстүрлі емес мұғалім...>
Dialogue: 0,0:08:43.65,0:08:46.15,Default,,0000,0000,0000,,Жарайды, су ал.
Dialogue: 0,0:08:43.65,0:08:46.15,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:08:46.15,0:08:50.99,Default,,0000,0000,0000,,<Жоғары мектеп сыныптары
Dialogue: 0,0:08:46.15,0:08:50.99,Default,,0000,0000,0000,,Бұл менің бастауыш мектепте оқыған кезімнен де қызық＞
Dialogue: 0,0:08:50.99,0:08:53.83,Default,,0000,0000,0000,,Олай болса, міне... Чиё-чан!
Dialogue: 0,0:08:53.83,0:08:55.83,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:08:55.83,0:08:58.03,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:09:05.61,0:09:07.94,Default,,0000,0000,0000,,Дұрыс, күткендей!
Dialogue: 0,0:09:05.61,0:09:07.94,Default,,0000,0000,0000,,Эххе~.
Dialogue: 0,0:09:07.94,0:09:09.94,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:07.94,0:09:09.94,Default,,0000,0000,0000,,(Құлаған заттардың дыбысы)
Dialogue: 0,0:09:13.28,0:09:15.28,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:09:15.28,0:09:17.62,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:17.62,0:09:20.46,Default,,0000,0000,0000,,Аха….
Dialogue: 0,0:09:20.46,0:09:24.13,Default,,0000,0000,0000,,Хмм, жақсы...
Dialogue: 0,0:09:24.13,0:09:27.30,Default,,0000,0000,0000,,Жақсы ұйықтадың ба?
Dialogue: 0,0:09:24.13,0:09:27.30,Default,,0000,0000,0000,,Жоқ, онша емес.
Dialogue: 0,0:09:27.30,0:09:32.30,Default,,0000,0000,0000,,Ах! Әй, мен жынды боламын.
Dialogue: 0,0:09:32.30,0:09:35.30,Default,,0000,0000,0000,,<Мырза. Осака
Dialogue: 0,0:09:32.30,0:09:35.30,Default,,0000,0000,0000,,Сабақ кезінде көп ұйықтаймын.
Dialogue: 0,0:09:35.30,0:09:37.31,Default,,0000,0000,0000,,Түнгі үкі? ＞
Dialogue: 0,0:09:37.31,0:09:39.97,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:39.97,0:09:44.81,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:09:44.81,0:09:47.15,Default,,0000,0000,0000,,Кейде Вакашибе және т.б.
Dialogue: 0,0:09:47.15,0:09:49.65,Default,,0000,0000,0000,,<Бастауыш мектептен айырмашылығы, орта мектепте➡
Dialogue: 0,0:09:49.65,0:09:52.82,Default,,0000,0000,0000,,Әр сыныпта әр түрлі мұғалім бар.
Dialogue: 0,0:09:52.82,0:09:55.82,Default,,0000,0000,0000,,Сондықтан әртүрлі мұғалімдер көп＞
Dialogue: 0,0:09:55.82,0:09:58.16,Default,,0000,0000,0000,,Шынымен, бұл...
Dialogue: 0,0:09:58.16,0:10:00.50,Default,,0000,0000,0000,,Иә, солай.
Dialogue: 0,0:09:58.16,0:10:00.50,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:10:00.50,0:10:04.17,Default,,0000,0000,0000,,Сізде туған күніңізді растайтын құжат бар ма?
Dialogue: 0,0:10:00.50,0:10:04.17,Default,,0000,0000,0000,,Оны оқуды кімнен сұрауым керек?
Dialogue: 0,0:10:04.17,0:10:07.00,Default,,0000,0000,0000,,Иә, өткен күні
Dialogue: 0,0:10:04.17,0:10:07.00,Default,,0000,0000,0000,,Басқа қыздар орта мектебінің мұғалімімен➡
Dialogue: 0,0:10:07.00,0:10:09.50,Default,,0000,0000,0000,,Менің сізбен сөйлесудің сәті түсті...
Dialogue: 0,0:10:09.50,0:10:11.84,Default,,0000,0000,0000,,Ааа!
Dialogue: 0,0:10:11.84,0:10:14.84,Default,,0000,0000,0000,,Бірінші кезең дене шынықтыру...
Dialogue: 0,0:10:14.84,0:10:19.35,Default,,0000,0000,0000,,Уайымдамаңыз, тіпті сабақ кезінде де
Dialogue: 0,0:10:14.84,0:10:19.35,Default,,0000,0000,0000,,Бұл спортзалға арналған киім болса керек!
Dialogue: 0,0:10:19.35,0:10:21.35,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:21.35,0:10:25.02,Default,,0000,0000,0000,,Жүзуге келетін болсақ... және купальниктерге де қатысты!
Dialogue: 0,0:10:25.02,0:10:28.36,Default,,0000,0000,0000,,Шынымен...
Dialogue: 0,0:10:25.02,0:10:28.36,Default,,0000,0000,0000,,Мен қатты жылап отырмын...
Dialogue: 0,0:10:28.36,0:10:31.19,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:10:31.19,0:10:34.36,Default,,0000,0000,0000,,＜Рас, әр түрлі мұғалімдер көп＞
Dialogue: 0,0:10:34.36,0:10:36.36,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:36.36,0:10:39.06,Default,,0000,0000,0000,,Чио-чан Бұл...
Dialogue: 0,0:10:36.36,0:10:39.06,Default,,0000,0000,0000,,Сәлеметсіз бе.
Dialogue: 0,0:10:42.20,0:10:44.54,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:10:44.54,0:10:48.21,Default,,0000,0000,0000,,Ихихи.
Dialogue: 0,0:10:44.54,0:10:48.21,Default,,0000,0000,0000,,Е.
Dialogue: 0,0:10:48.21,0:10:51.21,Default,,0000,0000,0000,,＜ Мұндай нәрсе
Dialogue: 0,0:10:48.21,0:10:51.21,Default,,0000,0000,0000,,Бастауыш сыныптан айырмашылығы жоқ>
Dialogue: 0,0:10:51.21,0:10:53.38,Default,,0000,0000,0000,,Жооой!
Dialogue: 0,0:10:53.38,0:10:55.55,Default,,0000,0000,0000,,Бұл жолы!
Dialogue: 0,0:10:57.89,0:11:00.32,Default,,0000,0000,0000,,<Чиё: Бастауыш мектептен айырмашылығы➡
Dialogue: 0,0:11:00.32,0:11:02.99,Default,,0000,0000,0000,,Орта мектепте түскі ас жоқ＞
Dialogue: 0,0:11:02.99,0:11:05.33,Default,,0000,0000,0000,,Сіз ақы аласыз ба?
Dialogue: 0,0:11:05.33,0:11:10.00,Default,,0000,0000,0000,,＜ Сол үшін мен түскі асымды әкелдім.
Dialogue: 0,0:11:05.33,0:11:10.00,Default,,0000,0000,0000,,Сатып алу бөлімінде нан сатып алу➡
Dialogue: 0,0:11:10.00,0:11:12.67,Default,,0000,0000,0000,,Мектеп асханасында тамақтану＞
Dialogue: 0,0:11:12.67,0:11:16.34,Default,,0000,0000,0000,,Соғыстан кейінгі сияқты...
Dialogue: 0,0:11:12.67,0:11:16.34,Default,,0000,0000,0000,,Бұл соғыстан кейін болғанымен...
Dialogue: 0,0:11:16.34,0:11:19.51,Default,,0000,0000,0000,,Вахаха, күте тұрыңыз!
Dialogue: 0,0:11:16.34,0:11:19.51,Default,,0000,0000,0000,,Қайтадан қош келдіңіз.
Dialogue: 0,0:11:19.51,0:11:21.68,Default,,0000,0000,0000,,Якисоба нанын алыңыз!
Dialogue: 0,0:11:21.68,0:11:23.68,Default,,0000,0000,0000,,Уау~ Сатоси күткендей!
Dialogue: 0,0:11:23.68,0:11:25.68,Default,,0000,0000,0000,,Иә, бұл Осакадан келген Бунна.
Dialogue: 0,0:11:27.85,0:11:30.35,Default,,0000,0000,0000,,Қауын нан….
Dialogue: 0,0:11:27.85,0:11:30.35,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:30.35,0:11:34.02,Default,,0000,0000,0000,,Мен қауын нан дедім...
Dialogue: 0,0:11:34.02,0:11:37.69,Default,,0000,0000,0000,,Якисоба наны жақсырақ
Dialogue: 0,0:11:34.02,0:11:37.69,Default,,0000,0000,0000,,Қиындық деңгейі жоғары!
Dialogue: 0,0:11:37.69,0:11:39.86,Default,,0000,0000,0000,,《Қиындық деңгейі...》
Dialogue: 0,0:11:39.86,0:11:42.16,Default,,0000,0000,0000,,Мен әмиянымды ұмытып қалдым!
Dialogue: 0,0:11:46.03,0:11:48.83,Default,,0000,0000,0000,,Оны ашық қалдырыңыз!
Dialogue: 0,0:11:46.03,0:11:48.83,Default,,0000,0000,0000,,Себебі ол жерден жел өтеді.
Dialogue: 0,0:11:50.87,0:11:54.71,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:11:54.71,0:11:58.71,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:12:01.82,0:12:03.82,Default,,0000,0000,0000,,Ауа райы жақсы.
Dialogue: 0,0:12:03.82,0:12:06.82,Default,,0000,0000,0000,,Жел де жақсы сезінеді.
Dialogue: 0,0:12:06.82,0:12:09.49,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:12:09.49,0:12:12.16,Default,,0000,0000,0000,,Мен әйтеуір секіріп кетсем де➡
Dialogue: 0,0:12:12.16,0:12:16.50,Default,,0000,0000,0000,,Ұша алатындай сезіледі.
Dialogue: 0,0:12:16.50,0:12:19.67,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:19.67,0:12:22.17,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:12:19.67,0:12:22.17,Default,,0000,0000,0000,,Осака мырза➡
Dialogue: 0,0:12:22.17,0:12:25.17,Default,,0000,0000,0000,,Шынымен солай істе
Dialogue: 0,0:12:22.17,0:12:25.17,Default,,0000,0000,0000,,Мен мұны істей алатындай сезінемін.
Dialogue: 0,0:12:25.17,0:12:29.51,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:12:25.17,0:12:29.51,Default,,0000,0000,0000,,Осы жерден тамақтанайық!
Dialogue: 0,0:12:29.51,0:12:31.51,Default,,0000,0000,0000,,Даа~!
Dialogue: 0,0:12:35.18,0:12:37.38,Default,,0000,0000,0000,,Қарғыс атсын, ол сатылып кетті!
Dialogue: 0,0:12:40.36,0:12:43.52,Default,,0000,0000,0000,,Түскі асты төбесінде ішу жақсы болар еді!
Dialogue: 0,0:12:43.52,0:12:46.52,Default,,0000,0000,0000,,Өйткені, биік жерде тамақ ішу
Dialogue: 0,0:12:43.52,0:12:46.52,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:12:52.03,0:12:54.87,Default,,0000,0000,0000,,Хмм? Бұл не?
Dialogue: 0,0:12:54.87,0:12:57.21,Default,,0000,0000,0000,,Жоқ….
Dialogue: 0,0:12:54.87,0:12:57.21,Default,,0000,0000,0000,,Даналық.
Dialogue: 0,0:12:57.21,0:12:59.87,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:57.21,0:12:59.87,Default,,0000,0000,0000,,Бұл дәмді көрінеді.
Dialogue: 0,0:12:59.87,0:13:03.31,Default,,0000,0000,0000,,Маған тістеп беріңізші.
Dialogue: 0,0:12:59.87,0:13:03.31,Default,,0000,0000,0000,,Е.
Dialogue: 0,0:13:03.31,0:13:06.48,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:13:03.31,0:13:06.48,Default,,0000,0000,0000,,Сен маған үй тапсырмасын үнемі көрсетесің.
Dialogue: 0,0:13:06.48,0:13:08.48,Default,,0000,0000,0000,,Бұл менің жолым!
Dialogue: 0,0:13:08.48,0:13:10.49,Default,,0000,0000,0000,,Бұл жақсы!
Dialogue: 0,0:13:10.49,0:13:12.65,Default,,0000,0000,0000,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:13:12.65,0:13:15.49,Default,,0000,0000,0000,,Ах! Ах~.
Dialogue: 0,0:13:15.49,0:13:17.49,Default,,0000,0000,0000,,Күрсін.
Dialogue: 0,0:13:17.49,0:13:20.83,Default,,0000,0000,0000,,Паа!
Dialogue: 0,0:13:20.83,0:13:24.33,Default,,0000,0000,0000,,Жақсы болды ма?
Dialogue: 0,0:13:20.83,0:13:24.33,Default,,0000,0000,0000,,Уау, дәмді болды!
Dialogue: 0,0:13:24.33,0:13:26.33,Default,,0000,0000,0000,,Ооо...
Dialogue: 0,0:13:26.33,0:13:28.84,Default,,0000,0000,0000,,Менде бәрі жақсы.
Dialogue: 0,0:13:28.84,0:13:30.84,Default,,0000,0000,0000,,< Чиё: Томо-чан және Коёми-сан➡
Dialogue: 0,0:13:30.84,0:13:36.01,Default,,0000,0000,0000,,Біз бастауыш сыныптан бері біргеміз.
Dialogue: 0,0:13:30.84,0:13:36.01,Default,,0000,0000,0000,,Екеуің бірге көңіл көтеріп жүрген сияқтысыңдар＞
Dialogue: 0,0:13:36.01,0:13:38.35,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:13:38.35,0:13:41.85,Default,,0000,0000,0000,,<Чиё: Үйдің төбесі жақсы сезіледі>
Dialogue: 0,0:13:41.85,0:13:44.85,Default,,0000,0000,0000,,О, сен~!
Dialogue: 0,0:13:47.52,0:13:50.82,Default,,0000,0000,0000,,Иә
Dialogue: 0,0:13:47.52,0:13:50.82,Default,,0000,0000,0000,,Денені қыздыру жаттығулары аяқталды!
Dialogue: 0,0:13:53.36,0:13:55.36,Default,,0000,0000,0000,,~ орнатыңыз.
Dialogue: 0,0:13:55.36,0:13:58.53,Default,,0000,0000,0000,,< Чиё: Төртінші кезең дене шынықтыру.
Dialogue: 0,0:13:55.36,0:13:58.53,Default,,0000,0000,0000,,Бүгін біз жүземіз＞
Dialogue: 0,0:13:58.53,0:14:01.47,Default,,0000,0000,0000,,Он соққылы қарғыс техникасы: Тайл құлау, Тайл құлау!
Dialogue: 0,0:13:58.53,0:14:01.47,Default,,0000,0000,0000,,25 метрге төрт рет жүгіру.
Dialogue: 0,0:14:01.47,0:14:04.81,Default,,0000,0000,0000,,Жүзе алмайтындар
Dialogue: 0,0:14:01.47,0:14:04.81,Default,,0000,0000,0000,,Сіз бит тақтасын пайдалана аласыз.
Dialogue: 0,0:14:04.81,0:14:06.81,Default,,0000,0000,0000,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:14:06.81,0:14:09.31,Default,,0000,0000,0000,,Чио-чан не істейді? Сіз соққы тақтасын пайдаланасыз ба?
Dialogue: 0,0:14:09.31,0:14:13.15,Default,,0000,0000,0000,,Жоқ, оны бүгін қолданбаңыз.
Dialogue: 0,0:14:09.31,0:14:13.15,Default,,0000,0000,0000,,Ортаға дейін жүзу.
Dialogue: 0,0:14:13.15,0:14:15.65,Default,,0000,0000,0000,,О, сәттілік.
Dialogue: 0,0:14:13.15,0:14:15.65,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:14:15.65,0:14:17.65,Default,,0000,0000,0000,,<Чиё: Бұл Кагура-сан>
Dialogue: 0,0:14:17.65,0:14:19.99,Default,,0000,0000,0000,,Бассейннің ортасында
Dialogue: 0,0:14:17.65,0:14:19.99,Default,,0000,0000,0000,,Себебі ол сәл тереңірек➡
Dialogue: 0,0:14:19.99,0:14:22.16,Default,,0000,0000,0000,,Абайлаңыз.
Dialogue: 0,0:14:19.99,0:14:22.16,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:14:22.16,0:14:24.33,Default,,0000,0000,0000,,Екі алыңыз!
Dialogue: 0,0:14:24.33,0:14:26.83,Default,,0000,0000,0000,,Кааааа….
Dialogue: 0,0:14:26.83,0:14:31.67,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:14:31.67,0:14:34.34,Default,,0000,0000,0000,,Уау, қайтар!
Dialogue: 0,0:14:34.34,0:14:37.34,Default,,0000,0000,0000,,Сізге екі қажет емес.
Dialogue: 0,0:14:34.34,0:14:37.34,Default,,0000,0000,0000,,Сізге екі керек!
Dialogue: 0,0:14:41.68,0:14:44.01,Default,,0000,0000,0000,,< Чиё: Кагура мырза
Dialogue: 0,0:14:41.68,0:14:44.01,Default,,0000,0000,0000,,Өйткені мен жүзу үйірмесінің мүшесімін➡
Dialogue: 0,0:14:44.01,0:14:46.68,Default,,0000,0000,0000,,Мен өз сыныбымдағы ең жақсы жүзушімін.
Dialogue: 0,0:14:46.68,0:14:48.68,Default,,0000,0000,0000,,Ұлдардан жеңілген жоқ＞
Dialogue: 0,0:14:48.68,0:14:50.69,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:14:50.69,0:14:58.69,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:14:58.69,0:15:00.89,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:15:03.46,0:15:05.47,Default,,0000,0000,0000,,Сәттілік Чиё Чан.
Dialogue: 0,0:15:05.47,0:15:08.64,Default,,0000,0000,0000,,Иә, жарайды, мен де... хаха!
Dialogue: 0,0:15:08.64,0:15:12.81,Default,,0000,0000,0000,,< Чиё: 10 метрдей жорғалаумен
Dialogue: 0,0:15:08.64,0:15:12.81,Default,,0000,0000,0000,,Енді жалғастыруға болады.
Dialogue: 0,0:15:12.81,0:15:15.31,Default,,0000,0000,0000,,Әрі қарай жүру
Dialogue: 0,0:15:12.81,0:15:15.31,Default,,0000,0000,0000,,Тыныс алуды меңгеру керек➡
Dialogue: 0,0:15:15.31,0:15:17.31,Default,,0000,0000,0000,,Мен олай ойламаймын>
Dialogue: 0,0:15:17.31,0:15:20.48,Default,,0000,0000,0000,,Фааа! ?
Dialogue: 0,0:15:17.31,0:15:20.48,Default,,0000,0000,0000,,Бірдеңе болды ма?
Dialogue: 0,0:15:20.48,0:15:22.48,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:15:22.48,0:15:25.65,Default,,0000,0000,0000,,Гохогохо!
Dialogue: 0,0:15:22.48,0:15:25.65,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:15:22.48,0:15:25.65,Default,,0000,0000,0000,,Жоқ, жаман, жаман.
Dialogue: 0,0:15:25.65,0:15:28.32,Default,,0000,0000,0000,,Чио-чан
Dialogue: 0,0:15:25.65,0:15:28.32,Default,,0000,0000,0000,,Кішкентай болғандықтан көре алмадым.
Dialogue: 0,0:15:28.32,0:15:32.33,Default,,0000,0000,0000,,Ей, абай бол.
Dialogue: 0,0:15:28.32,0:15:32.33,Default,,0000,0000,0000,,Чиё-чанның аяғы оған жете алмайды.
Dialogue: 0,0:15:32.33,0:15:35.00,Default,,0000,0000,0000,,Жүзу - өлім
Dialogue: 0,0:15:32.33,0:15:35.00,Default,,0000,0000,0000,,Олар бір-бірінің қасында.
Dialogue: 0,0:15:35.00,0:15:37.00,Default,,0000,0000,0000,,Өлім~! ?
Dialogue: 0,0:15:37.00,0:15:41.80,Default,,0000,0000,0000,,Мен тез есейгім келеді!
Dialogue: 0,0:15:43.84,0:15:52.68,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:15:52.68,0:15:55.68,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:15:52.68,0:15:55.68,Default,,0000,0000,0000,,< Чиё: Ең соңғы нәрсе - тазалау.
Dialogue: 0,0:15:55.68,0:15:58.58,Default,,0000,0000,0000,,Маған тазалау ұнайды. Өйткені ол әдемі болады>
Dialogue: 0,0:16:00.45,0:16:03.46,Default,,0000,0000,0000,,№.
Dialogue: 0,0:16:03.46,0:16:07.63,Default,,0000,0000,0000,,Ммм... Мм...
Dialogue: 0,0:16:07.63,0:16:10.30,Default,,0000,0000,0000,,Иә? Ха!
Dialogue: 0,0:16:10.30,0:16:13.80,Default,,0000,0000,0000,,Сатоши-чан
Dialogue: 0,0:16:10.30,0:16:13.80,Default,,0000,0000,0000,,Бұлай сыпыруға болмайды.
Dialogue: 0,0:16:13.80,0:16:15.80,Default,,0000,0000,0000,,< Чиё: Шынайы
Dialogue: 0,0:16:13.80,0:16:15.80,Default,,0000,0000,0000,,Мен мұны қалаймын>
Dialogue: 0,0:16:15.80,0:16:18.31,Default,,0000,0000,0000,,Ада! Гохо гохо!
Dialogue: 0,0:16:18.31,0:16:29.65,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:16:29.65,0:16:31.65,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:31.65,0:16:33.82,Default,,0000,0000,0000,,< Чиё: Осака мырза
Dialogue: 0,0:16:31.65,0:16:33.82,Default,,0000,0000,0000,,Мен байсалды боламын➡
Dialogue: 0,0:16:33.82,0:16:35.82,Default,,0000,0000,0000,,Маған шаң жинағыш ұнамайды＞
Dialogue: 0,0:16:37.83,0:16:40.83,Default,,0000,0000,0000,,<Чиё: Ал мектептен кететін уақыт келді>
Dialogue: 0,0:16:40.83,0:16:45.00,Default,,0000,0000,0000,,Бүгінгі күн де қиын болды.
Dialogue: 0,0:16:45.00,0:16:48.00,Default,,0000,0000,0000,,Сау болыңыз.
Dialogue: 0,0:16:48.00,0:16:52.17,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:16:52.17,0:16:54.18,Default,,0000,0000,0000,,Мен үйдемін!
Dialogue: 0,0:16:54.18,0:16:59.18,Default,,0000,0000,0000,,< Чиё: Орта мектеп бастауыш мектептен ерекшеленеді.
Dialogue: 0,0:16:54.18,0:16:59.18,Default,,0000,0000,0000,,Ол баяу аяқталады.
Dialogue: 0,0:16:59.18,0:17:03.62,Default,,0000,0000,0000,,Сонымен, үй тапсырмасын аяқтаған кезде
Dialogue: 0,0:16:59.18,0:17:03.62,Default,,0000,0000,0000,,Жақында кеш болады＞
Dialogue: 0,0:17:03.62,0:17:10.79,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:17:10.79,0:17:13.63,Default,,0000,0000,0000,,Куун.
Dialogue: 0,0:17:10.79,0:17:13.63,Default,,0000,0000,0000,,Е.
Dialogue: 0,0:17:13.63,0:17:19.47,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:17:19.47,0:17:22.80,Default,,0000,0000,0000,,кеттік~ Тадаёси-сан.
Dialogue: 0,0:17:22.80,0:17:26.00,Default,,0000,0000,0000,,< Чиё: Кеш батқанда
Dialogue: 0,0:17:22.80,0:17:26.00,Default,,0000,0000,0000,,Тадаёси-санмен серуендеу＞
Dialogue: 0,0:17:28.48,0:17:30.48,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:17:30.48,0:17:32.48,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:17:32.48,0:17:36.15,Default,,0000,0000,0000,,< Чиё: Соңғы уақытта
Dialogue: 0,0:17:32.48,0:17:36.15,Default,,0000,0000,0000,,Сакаки-сан да менімен бірге серуендейді.
Dialogue: 0,0:17:36.15,0:17:40.32,Default,,0000,0000,0000,,Сакаки мырза да
Dialogue: 0,0:17:36.15,0:17:40.32,Default,,0000,0000,0000,,Оған Тадайоши-сан ұнайтын сияқты.
Dialogue: 0,0:17:40.32,0:17:44.02,Default,,0000,0000,0000,,Үшеуміз қызық көріп жатырмыз>
Dialogue: 0,0:17:49.83,0:17:52.33,Default,,0000,0000,0000,,(Қарғаның айқайы)
Dialogue: 0,0:17:55.00,0:17:57.67,Default,,0000,0000,0000,,Саябақты аралап көрейік.
Dialogue: 0,0:17:57.67,0:17:59.67,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:17:59.67,0:18:12.62,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:18:12.62,0:18:15.79,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:18:12.62,0:18:15.79,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:18:15.79,0:18:22.13,Default,,0000,0000,0000,,～ ～
Dialogue: 0,0:18:15.79,0:18:22.13,Default,,0000,0000,0000,,Санши~.
Dialogue: 0,0:18:22.13,0:18:25.13,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:18:22.13,0:18:25.13,Default,,0000,0000,0000,,А, Мими сәтсіз аяқталды!
Dialogue: 0,0:18:25.13,0:18:28.47,Default,,0000,0000,0000,,Ауыстыру.
Dialogue: 0,0:18:25.13,0:18:28.47,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:18:28.47,0:18:30.64,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:18:28.47,0:18:30.64,Default,,0000,0000,0000,,(кешкі қоңырау)
Dialogue: 0,0:18:30.64,0:18:34.81,Default,,0000,0000,0000,,(кешкі қоңырау)
Dialogue: 0,0:18:34.81,0:18:38.15,Default,,0000,0000,0000,,Аа, 5:30 болып қалды!
Dialogue: 0,0:18:34.81,0:18:38.15,Default,,0000,0000,0000,,Мен мектепке кешігіп барамын!
Dialogue: 0,0:18:38.15,0:18:40.65,Default,,0000,0000,0000,,Сонда кездескенше!
Dialogue: 0,0:18:38.15,0:18:40.65,Default,,0000,0000,0000,,Қош бол!
Dialogue: 0,0:18:40.65,0:18:44.15,Default,,0000,0000,0000,,Мен серуеннің ортасындамын...
Dialogue: 0,0:18:40.65,0:18:44.15,Default,,0000,0000,0000,,(Мұғалім) О, қандай жаһандық көзқарас. (Цубаки) 《Уф! Сол сұм~》
Dialogue: 0,0:18:44.15,0:18:48.32,Default,,0000,0000,0000,,Кішкене ойнайық.
Dialogue: 0,0:18:48.32,0:18:50.32,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:53.99,0:18:56.00,Default,,0000,0000,0000,,Са….
Dialogue: 0,0:18:56.00,0:18:59.17,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:18:59.17,0:19:03.44,Default,,0000,0000,0000,,♬ «Ханым, кіріңіз.»
Dialogue: 0,0:19:03.44,0:19:07.27,Default,,0000,0000,0000,,♬ «Тас, қағаз, қайшы
Dialogue: 0,0:19:03.44,0:19:07.27,Default,,0000,0000,0000,,Айко, солай ма?
Dialogue: 0,0:19:07.27,0:19:10.78,Default,,0000,0000,0000,,♬ «Егер жеңілсең, кет.»
Dialogue: 0,0:19:10.78,0:19:14.95,Default,,0000,0000,0000,,♬ «Ханым, кіріңіз.»
Dialogue: 0,0:19:14.95,0:19:18.62,Default,,0000,0000,0000,,Ахх! Бұл Айко!
Dialogue: 0,0:19:18.62,0:19:21.79,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:19:18.62,0:19:21.79,Default,,0000,0000,0000,,Нуувааа!
Dialogue: 0,0:19:21.79,0:19:25.46,Default,,0000,0000,0000,,Хехе, Чио-чан.
Dialogue: 0,0:19:25.46,0:19:29.63,Default,,0000,0000,0000,,Сатоши-чан!
Dialogue: 0,0:19:25.46,0:19:29.63,Default,,0000,0000,0000,,Арқанмен секіру - сағыныш.
Dialogue: 0,0:19:29.63,0:19:33.47,Default,,0000,0000,0000,,Тіпті дене шынықтыру сабағында
Dialogue: 0,0:19:29.63,0:19:33.47,Default,,0000,0000,0000,,Мен мұны тоқтатқанымды қалаймын.
Dialogue: 0,0:19:33.47,0:19:35.80,Default,,0000,0000,0000,,Коёми-сан! Осака мырза!
Dialogue: 0,0:19:35.80,0:19:39.64,Default,,0000,0000,0000,,Эй, мен Токиоға жауын құрттарын көруге келдім.
Dialogue: 0,0:19:39.64,0:19:43.81,Default,,0000,0000,0000,,Мен емес.
Dialogue: 0,0:19:39.64,0:19:43.81,Default,,0000,0000,0000,,Біз сол жерде кездейсоқ кездесіп қалдық.
Dialogue: 0,0:19:43.81,0:19:46.48,Default,,0000,0000,0000,,Жарайсыңдар! Чио-чан - жеңімпаз!
Dialogue: 0,0:19:46.48,0:19:48.82,Default,,0000,0000,0000,,Сіз жаңа ғана жеңілдіңіз!
Dialogue: 0,0:19:48.82,0:19:52.99,Default,,0000,0000,0000,,Жақсы! Мұндай нәрсе
Dialogue: 0,0:19:48.82,0:19:52.99,Default,,0000,0000,0000,,Бұл негізінен үш раундтық шайқас!
Dialogue: 0,0:19:52.99,0:19:55.66,Default,,0000,0000,0000,,А, иә.
Dialogue: 0,0:19:52.99,0:19:55.66,Default,,0000,0000,0000,,Иә, мынаны алыңыз!
Dialogue: 0,0:19:55.66,0:19:59.16,Default,,0000,0000,0000,,Түсіндім. Түсіндім.
Dialogue: 0,0:19:55.66,0:19:59.16,Default,,0000,0000,0000,,Осака, оны ал!
Dialogue: 0,0:19:59.16,0:20:02.33,Default,,0000,0000,0000,,Сіз не айтып жатырсыз?
Dialogue: 0,0:19:59.16,0:20:02.33,Default,,0000,0000,0000,,Чио-чанға баптайық.
Dialogue: 0,0:20:02.33,0:20:04.50,Default,,0000,0000,0000,,Чийосуке Бұл ойын!
Dialogue: 0,0:20:04.50,0:20:06.50,Default,,0000,0000,0000,,Қане, қабыл алайық.
Dialogue: 0,0:20:06.50,0:20:40.53,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:20:40.53,0:20:45.54,Default,,0000,0000,0000,,(күлкі)
Dialogue: 0,0:20:45.54,0:20:49.71,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:20:49.71,0:20:52.11,Default,,0000,0000,0000,,Мен жалғыз қалдым ба?
Dialogue: 0,0:20:55.38,0:20:58.88,Default,,0000,0000,0000,,< Чиё: Жақында түн болады
Dialogue: 0,0:20:55.38,0:20:58.88,Default,,0000,0000,0000,,Менің ұйқым келіп тұр>
Dialogue: 0,0:21:04.49,0:21:06.66,Default,,0000,0000,0000,,＜ Барлығы түнде теледидар көреді ➡
Dialogue: 0,0:21:06.66,0:21:09.16,Default,,0000,0000,0000,,Радиодан біреудің сөйлегенін естігенде➡
Dialogue: 0,0:21:09.16,0:21:11.16,Default,,0000,0000,0000,,Мен аздап қызғаншақпын＞
Dialogue: 0,0:21:14.17,0:21:17.50,Default,,0000,0000,0000,,<Сен өскенде
Dialogue: 0,0:21:14.17,0:21:17.50,Default,,0000,0000,0000,,Кеш болса да жарайды.
Dialogue: 0,0:21:17.50,0:21:20.17,Default,,0000,0000,0000,,Мен мүмкіндігінше тезірек ересек болғым келеді＞
Dialogue: 0,0:21:20.17,0:21:22.67,Default,,0000,0000,0000,,Қайырлы түн, Тадаёси-сан...
Dialogue: 0,0:21:26.85,0:21:31.02,Default,,0000,0000,0000,,Сендер тым талапшылсыңдар — менің кимоном мүлдем кір емес.
Dialogue: 0,0:21:26.85,0:21:31.02,Default,,0000,0000,0000,,(теледидар дыбысы)
Dialogue: 0,0:21:31.02,0:21:33.52,Default,,0000,0000,0000,,Күрсін.
Dialogue: 0,0:21:37.19,0:21:39.19,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:21:39.19,0:21:42.53,Default,,0000,0000,0000,,бұл….
Dialogue: 0,0:21:42.53,0:21:46.53,Default,,0000,0000,0000,,< Чиё: Олай болса...
Dialogue: 0,0:21:46.53,0:21:49.63,Default,,0000,0000,0000,,Қайырлы түн＞
Dialogue: 0,0:21:51.13,0:21:57.13,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory