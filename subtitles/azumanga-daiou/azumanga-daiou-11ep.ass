Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.52,0:01:35.02,Default,,0000,0000,0000,,(Көлік сигналы дыбысы)
Dialogue: 0,0:01:35.02,0:01:37.86,Default,,0000,0000,0000,,(Қала шуы)
Dialogue: 0,0:01:37.86,0:01:40.70,Default,,0000,0000,0000,,(Көлік сигналы дыбысы)
Dialogue: 0,0:01:40.70,0:01:43.87,Default,,0000,0000,0000,,Ммм.
Dialogue: 0,0:01:43.87,0:01:46.54,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:01:43.87,0:01:46.54,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:01:46.54,0:01:50.37,Default,,0000,0000,0000,,Хаха….
Dialogue: 0,0:01:46.54,0:01:50.37,Default,,0000,0000,0000,,Мен саған жүктеріңмен көмектесейін бе?
Dialogue: 0,0:01:50.37,0:01:52.37,Default,,0000,0000,0000,,Ум...
Dialogue: 0,0:01:52.37,0:01:54.54,Default,,0000,0000,0000,,《Бұл гайджин! 》
Dialogue: 0,0:01:54.54,0:01:57.55,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:01:57.55,0:02:00.32,Default,,0000,0000,0000,,Ум, мен саған көмектесемін.
Dialogue: 0,0:02:00.32,0:02:02.48,Default,,0000,0000,0000,,Мен...
Dialogue: 0,0:02:02.48,0:02:04.49,Default,,0000,0000,0000,,Бұл...
Dialogue: 0,0:02:02.48,0:02:04.49,Default,,0000,0000,0000,,Ｗｈａｔ？
Dialogue: 0,0:02:04.49,0:02:08.32,Default,,0000,0000,0000,,Білмеймін...
Dialogue: 0,0:02:08.32,0:02:11.16,Default,,0000,0000,0000,,Анықтама….
Dialogue: 0,0:02:08.32,0:02:11.16,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:02:11.16,0:02:15.33,Default,,0000,0000,0000,,Маған көмектес!
Dialogue: 0,0:02:11.16,0:02:15.33,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:02:15.33,0:02:17.33,Default,,0000,0000,0000,,А, аа!
Dialogue: 0,0:02:17.33,0:02:25.01,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:02:25.01,0:02:28.84,Default,,0000,0000,0000,,(ағылшынша)
Dialogue: 0,0:02:28.84,0:02:32.18,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:02:32.18,0:02:34.18,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:02:34.18,0:02:36.18,Default,,0000,0000,0000,,Мен—
Dialogue: 0,0:02:40.69,0:02:43.19,Default,,0000,0000,0000,,Күрсін... Міне, осында.
Dialogue: 0,0:02:43.19,0:02:45.69,Default,,0000,0000,0000,,Мен оны көрдім.
Dialogue: 0,0:02:43.19,0:02:45.69,Default,,0000,0000,0000,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:02:45.69,0:02:48.86,Default,,0000,0000,0000,,Уфуфуфу Сен сондай мейірімдісің, мияу.
Dialogue: 0,0:02:48.86,0:02:52.37,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:02:48.86,0:02:52.37,Default,,0000,0000,0000,,Уау, бірдеңе➡
Dialogue: 0,0:02:52.37,0:02:54.70,Default,,0000,0000,0000,,Ешқандай сөз таба алмадым...
Dialogue: 0,0:02:54.70,0:02:58.21,Default,,0000,0000,0000,,Ағылшын тілі сабағы
Dialogue: 0,0:02:54.70,0:02:58.21,Default,,0000,0000,0000,,Егер дұрыс орындасаңыз➡
Dialogue: 0,0:02:58.21,0:03:00.31,Default,,0000,0000,0000,,Бұл туралы уайымдаудың қажеті жоқ!
Dialogue: 0,0:03:00.31,0:03:02.61,Default,,0000,0000,0000,,Ал, мұғалім ше?
Dialogue: 0,0:03:00.31,0:03:02.61,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:03:05.31,0:03:07.98,Default,,0000,0000,0000,,А, дәл ана жерде үйрек бар.
Dialogue: 0,0:03:07.98,0:03:09.98,Default,,0000,0000,0000,,Оған таңданамын!
Dialogue: 0,0:03:07.98,0:03:09.98,Default,,0000,0000,0000,,О, күткендей!
Dialogue: 0,0:03:19.33,0:03:23.00,Default,,0000,0000,0000,,Бұл! ?
Dialogue: 0,0:03:19.33,0:03:23.00,Default,,0000,0000,0000,,Жоқ, мен неміспін.
Dialogue: 0,0:03:23.00,0:03:26.17,Default,,0000,0000,0000,,Ал, мен қашып кеттім.
Dialogue: 0,0:03:23.00,0:03:26.17,Default,,0000,0000,0000,,Амансың ба?
Dialogue: 0,0:03:26.17,0:03:29.67,Default,,0000,0000,0000,,Хе-хи-е болды.
Dialogue: 0,0:03:29.67,0:03:31.67,Default,,0000,0000,0000,,Кеше қиын болды.
Dialogue: 0,0:03:31.67,0:03:35.01,Default,,0000,0000,0000,,Бұл оқиға туралы менің ойым...
Dialogue: 0,0:03:31.67,0:03:35.01,Default,,0000,0000,0000,,Қандай кенеттен!
Dialogue: 0,0:03:35.01,0:03:37.68,Default,,0000,0000,0000,,Бұл сіздің ақымақ екеніңізді білдіреді.
Dialogue: 0,0:03:37.68,0:03:39.68,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:03:41.68,0:03:44.69,Default,,0000,0000,0000,,суық тигізесің.
Dialogue: 0,0:03:41.68,0:03:44.69,Default,,0000,0000,0000,,Ағылшын тілінде сөйлей алмайтыныңызға сенбеймін.
Dialogue: 0,0:03:44.69,0:03:47.02,Default,,0000,0000,0000,,Мұның бәрі кеудеге қатысты. Бұл өте үлкен.
Dialogue: 0,0:03:47.02,0:03:49.19,Default,,0000,0000,0000,,Емшектің оған қатысы жоқ. Кеуделер!
Dialogue: 0,0:03:49.19,0:03:51.69,Default,,0000,0000,0000,,Сонымен, сіз ағылшын тілінде сөйлей аласыз ба?
Dialogue: 0,0:03:51.69,0:03:53.70,Default,,0000,0000,0000,,Сізден жақсырақ.
Dialogue: 0,0:03:53.70,0:03:56.53,Default,,0000,0000,0000,,Жарайды, онда мен саған сұрақ қояйын.
Dialogue: 0,0:03:56.53,0:03:59.20,Default,,0000,0000,0000,,Иә, иә, кез келген нәрсені сұраңыз!
Dialogue: 0,0:03:59.20,0:04:02.10,Default,,0000,0000,0000,,АТ дегеніміз не?
Dialogue: 0,0:04:04.31,0:04:06.64,Default,,0000,0000,0000,,Қарамаңдар!
Dialogue: 0,0:04:06.64,0:04:09.98,Default,,0000,0000,0000,,Сонымен, солай емес пе?
Dialogue: 0,0:04:09.98,0:04:11.98,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:04:11.98,0:04:15.48,Default,,0000,0000,0000,,Электрондық пошта, басты бет және т.б.
Dialogue: 0,0:04:15.48,0:04:18.15,Default,,0000,0000,0000,,Со~ю~
Dialogue: 0,0:04:15.48,0:04:18.15,Default,,0000,0000,0000,,Мен атмосфераны шамамен түсінемін.
Dialogue: 0,0:04:18.15,0:04:21.65,Default,,0000,0000,0000,,Сонымен АТ нені білдіреді?
Dialogue: 0,0:04:25.49,0:04:27.50,Default,,0000,0000,0000,,Ал, бұл туралы уайымдамаңыз.
Dialogue: 0,0:04:27.50,0:04:29.50,Default,,0000,0000,0000,,Сіз бұған жауап бере алмайсыз!
Dialogue: 0,0:04:29.50,0:04:32.00,Default,,0000,0000,0000,,Сіз бұл туралы білесіз бе? ?
Dialogue: 0,0:04:32.00,0:04:34.34,Default,,0000,0000,0000,,Мен білмеймін, сондықтан сұраймын!
Dialogue: 0,0:04:34.34,0:04:37.17,Default,,0000,0000,0000,,Мен оны бетіңе орап тастаймын да, біраз уақыт бойы шешіп ала алмайтындай қылып қоямын!
Dialogue: 0,0:04:37.17,0:04:40.84,Default,,0000,0000,0000,,Уф...~!
Dialogue: 0,0:04:40.84,0:04:43.85,Default,,0000,0000,0000,,Күнтізбе Оның нені білдіретінін айтыңызшы!
Dialogue: 0,0:04:43.85,0:04:45.85,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:47.85,0:04:49.85,Default,,0000,0000,0000,,М-М-Мен….
Dialogue: 0,0:04:49.85,0:04:51.85,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:04:51.85,0:04:54.02,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:04:54.02,0:04:56.62,Default,,0000,0000,0000,,Интернет техникасы….
Dialogue: 0,0:04:59.03,0:05:01.46,Default,,0000,0000,0000,,О! Соған ұқсайды.
Dialogue: 0,0:05:01.46,0:05:03.47,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:05:03.47,0:05:07.14,Default,,0000,0000,0000,,АТ
Dialogue: 0,0:05:03.47,0:05:07.14,Default,,0000,0000,0000,,Ол ақпараттық технологияны білдіреді.
Dialogue: 0,0:05:07.14,0:05:11.14,Default,,0000,0000,0000,,Жапон тілінде
Dialogue: 0,0:05:07.14,0:05:11.14,Default,,0000,0000,0000,,Бұл ақпараттық технология.
Dialogue: 0,0:05:11.14,0:05:15.14,Default,,0000,0000,0000,,Бірақ ағылшын
Dialogue: 0,0:05:11.14,0:05:15.14,Default,,0000,0000,0000,,Сіз мұны істей аласыз ба деп сұрау үшін➡
Dialogue: 0,0:05:15.14,0:05:17.84,Default,,0000,0000,0000,,АТ сұрақтары туралы не деуге болады?
Dialogue: 0,0:05:20.65,0:05:22.65,Default,,0000,0000,0000,,Ум...
Dialogue: 0,0:05:20.65,0:05:22.65,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:22.65,0:05:24.82,Default,,0000,0000,0000,,Со-ю-жоқ дегенді қайдан үйренемін?
Dialogue: 0,0:05:24.82,0:05:27.16,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:05:27.16,0:05:29.16,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:05:32.66,0:05:35.00,Default,,0000,0000,0000,,Мен қай жерде...
Dialogue: 0,0:05:35.00,0:05:37.33,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:05:37.33,0:05:39.33,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:05:37.33,0:05:39.33,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:39.33,0:05:41.67,Default,,0000,0000,0000,,Сакаки~!
Dialogue: 0,0:05:41.67,0:05:43.67,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:05:43.67,0:05:48.51,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:05:48.51,0:05:51.18,Default,,0000,0000,0000,,Сонымен, дәл қазір мен ең қалайтын нәрсе➡
Dialogue: 0,0:05:51.18,0:05:53.52,Default,,0000,0000,0000,,Бұл тау велосипеді, солай ма?
Dialogue: 0,0:05:53.52,0:05:57.69,Default,,0000,0000,0000,,Бірақ бұл
Dialogue: 0,0:05:53.52,0:05:57.69,Default,,0000,0000,0000,,Мен түстер туралы көп шатастырамын.
Dialogue: 0,0:05:57.69,0:05:59.69,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:05:59.69,0:06:01.69,Default,,0000,0000,0000,,Гүлдену.
Dialogue: 0,0:06:05.29,0:06:08.63,Default,,0000,0000,0000,,Гүл? Ал, гибискус.
Dialogue: 0,0:06:08.63,0:06:10.83,Default,,0000,0000,0000,,Анар.
Dialogue: 0,0:06:13.97,0:06:17.47,Default,,0000,0000,0000,,Жоқ, гүлдер т.б.
Dialogue: 0,0:06:13.97,0:06:17.47,Default,,0000,0000,0000,,Мен оны мүлдем түсінбеймін.
Dialogue: 0,0:06:17.47,0:06:20.98,Default,,0000,0000,0000,,Мүмкін күнбағыс және таңғы даңқ.
Dialogue: 0,0:06:20.98,0:06:23.31,Default,,0000,0000,0000,,Лилия?
Dialogue: 0,0:06:23.31,0:06:25.31,Default,,0000,0000,0000,,Гардения.
Dialogue: 0,0:06:27.48,0:06:29.48,Default,,0000,0000,0000,,Күлгін.
Dialogue: 0,0:06:29.48,0:06:31.98,Default,,0000,0000,0000,,Рододендрон.
Dialogue: 0,0:06:34.32,0:06:36.83,Default,,0000,0000,0000,,Ал, мен гүлдерге мән бермеймін.
Dialogue: 0,0:06:36.83,0:06:39.83,Default,,0000,0000,0000,,Демек, бұл тау велосипеді.
Dialogue: 0,0:06:39.83,0:06:42.83,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:42.83,0:06:45.17,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:45.17,0:06:47.34,Default,,0000,0000,0000,,Мүмкін қазір➡
Dialogue: 0,0:06:47.34,0:06:49.34,Default,,0000,0000,0000,,Жеңіс?
Dialogue: 0,0:06:49.34,0:06:51.84,Default,,0000,0000,0000,,Ойын ба?
Dialogue: 0,0:06:51.84,0:06:54.68,Default,,0000,0000,0000,,Гүл атын болжау ойыны?
Dialogue: 0,0:06:54.68,0:06:57.01,Default,,0000,0000,0000,,Жоқ….
Dialogue: 0,0:06:57.01,0:07:00.62,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:07:00.62,0:07:03.95,Default,,0000,0000,0000,,-де қандай түсті шатастырдыңыз?
Dialogue: 0,0:07:00.62,0:07:03.95,Default,,0000,0000,0000,,Ол қандай?
Dialogue: 0,0:07:03.95,0:07:06.79,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:07:10.96,0:07:18.97,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:07:18.97,0:07:21.14,Default,,0000,0000,0000,,Эй Сакаки, ​​бұл ойын!
Dialogue: 0,0:07:21.14,0:07:23.14,Default,,0000,0000,0000,,Күресейік!
Dialogue: 0,0:07:21.14,0:07:23.14,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:23.14,0:07:26.14,Default,,0000,0000,0000,,Келесі оқиға
Dialogue: 0,0:07:23.14,0:07:26.14,Default,,0000,0000,0000,,Бұл түскі ас қорапшасын жеу жарысы.
Dialogue: 0,0:07:26.14,0:07:28.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:28.98,0:07:31.65,Default,,0000,0000,0000,,Олай болса, кеттік~ Эй Дон!
Dialogue: 0,0:07:31.65,0:07:35.15,Default,,0000,0000,0000,,Агу агу агу агу.
Dialogue: 0,0:07:35.15,0:07:41.15,Default,,0000,0000,0000,,(тамақтану дыбысы)
Dialogue: 0,0:07:45.99,0:07:49.59,Default,,0000,0000,0000,,А, сен не істеп жатырсың?
Dialogue: 0,0:07:52.33,0:07:55.34,Default,,0000,0000,0000,,Күріш ше?
Dialogue: 0,0:07:52.33,0:07:55.34,Default,,0000,0000,0000,,Тамақ ішер алдында тамақты жақсылап шайнау керек.
Dialogue: 0,0:07:55.34,0:07:57.34,Default,,0000,0000,0000,,Мені тыңда!
Dialogue: 0,0:08:00.61,0:08:03.95,Default,,0000,0000,0000,,Олай болса, бәріңе.
Dialogue: 0,0:08:00.61,0:08:03.95,Default,,0000,0000,0000,,Топтарға бөліну.
Dialogue: 0,0:08:03.95,0:08:05.95,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:08:05.95,0:08:10.45,Default,,0000,0000,0000,,Жарайды, Сакаки, ​​софтбол ойнайық!
Dialogue: 0,0:08:10.45,0:08:24.63,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:08:24.63,0:08:26.63,Default,,0000,0000,0000,,Сәттілік, Сакаки-сан!
Dialogue: 0,0:08:26.63,0:08:29.47,Default,,0000,0000,0000,,Үйге жүгіріп ұшайық!
Dialogue: 0,0:08:29.47,0:08:32.64,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:08:32.64,0:08:34.64,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:36.64,0:08:39.65,Default,,0000,0000,0000,,Үйге жүгіру қанша ұпай?
Dialogue: 0,0:08:36.64,0:08:39.65,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:39.65,0:08:42.15,Default,,0000,0000,0000,,Кеттік~ Сакаки~!
Dialogue: 0,0:08:44.15,0:08:47.82,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:08:44.15,0:08:47.82,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:08:47.82,0:08:52.49,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:08:52.49,0:08:55.66,Default,,0000,0000,0000,,Жеңіл шыбын!
Dialogue: 0,0:08:52.49,0:08:55.66,Default,,0000,0000,0000,,Ха ха ха!
Dialogue: 0,0:08:55.66,0:08:58.00,Default,,0000,0000,0000,,Ха!?
Dialogue: 0,0:08:55.66,0:08:58.00,Default,,0000,0000,0000,,Ха ха~ ха~!
Dialogue: 0,0:08:58.00,0:09:00.10,Default,,0000,0000,0000,,О, жарайды, ха!
Dialogue: 0,0:09:00.10,0:09:02.10,Default,,0000,0000,0000,,Жарайсыңдар!
Dialogue: 0,0:09:04.27,0:09:07.94,Default,,0000,0000,0000,,А-а-а-а!
Dialogue: 0,0:09:07.94,0:09:09.94,Default,,0000,0000,0000,,Ухммм… ммм…
Dialogue: 0,0:09:14.45,0:09:18.05,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:09:24.29,0:09:26.29,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:09:28.30,0:09:31.47,Default,,0000,0000,0000,,Ах...!
Dialogue: 0,0:09:28.30,0:09:31.47,Default,,0000,0000,0000,,Чиёчан!
Dialogue: 0,0:09:31.47,0:09:34.30,Default,,0000,0000,0000,,Чио-чан!
Dialogue: 0,0:09:31.47,0:09:34.30,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:09:34.30,0:09:37.47,Default,,0000,0000,0000,,Чио-чан, мықты бол.
Dialogue: 0,0:09:34.30,0:09:37.47,Default,,0000,0000,0000,,Чиёчан!
Dialogue: 0,0:09:37.47,0:09:39.77,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:09:41.81,0:09:43.81,Default,,0000,0000,0000,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:09:43.81,0:09:47.15,Default,,0000,0000,0000,,Бүгін физикалық өлшем.
Dialogue: 0,0:09:43.81,0:09:47.15,Default,,0000,0000,0000,,Көңіл-күйімізді көтерейік!
Dialogue: 0,0:09:47.15,0:09:50.32,Default,,0000,0000,0000,,Неліктен бұл Томо-чан?
Dialogue: 0,0:09:47.15,0:09:50.32,Default,,0000,0000,0000,,Сіз шынымен де жақсы сезінесіз бе?
Dialogue: 0,0:09:50.32,0:09:52.65,Default,,0000,0000,0000,,Енді?
Dialogue: 0,0:09:52.65,0:09:54.66,Default,,0000,0000,0000,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:09:54.66,0:09:57.99,Default,,0000,0000,0000,,Бюст 3 сантиметрге өсті! Алақай!
Dialogue: 0,0:09:57.99,0:10:01.16,Default,,0000,0000,0000,,Сізге жақсы.
Dialogue: 0,0:09:57.99,0:10:01.16,Default,,0000,0000,0000,,Бірақ бұл соншалықты қатты емес...
Dialogue: 0,0:10:01.16,0:10:04.33,Default,,0000,0000,0000,,Дегенмен, Сакаки-санның әлі де бағындыратын жолы көп.
Dialogue: 0,0:10:04.33,0:10:06.33,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:10:04.33,0:10:06.33,Default,,0000,0000,0000,,Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:10:06.33,0:10:08.34,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:10:12.67,0:10:14.68,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:14.68,0:10:16.68,Default,,0000,0000,0000,,Дегенмен—
Dialogue: 0,0:10:20.85,0:10:23.05,Default,,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,0:10:25.02,0:10:27.02,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:10:31.53,0:10:34.03,Default,,0000,0000,0000,,Жарайды, мен тезірек сабаққа баруым керек.
Dialogue: 0,0:10:34.03,0:10:36.13,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:39.03,0:10:41.87,Default,,0000,0000,0000,,Эй
Dialogue: 0,0:10:39.03,0:10:41.87,Default,,0000,0000,0000,,Күнтізбенің уақыты келді емес пе?
Dialogue: 0,0:10:41.87,0:10:43.87,Default,,0000,0000,0000,,Мен қатты қобалжыдым.
Dialogue: 0,0:10:43.87,0:10:48.21,Default,,0000,0000,0000,,Бұл күнтізбенің ең қорқатын уақыты.
Dialogue: 0,0:10:43.87,0:10:48.21,Default,,0000,0000,0000,,Өйткені бұл оқиға.
Dialogue: 0,0:10:48.21,0:10:50.21,Default,,0000,0000,0000,,Менде ешқандай проблема жоқ.
Dialogue: 0,0:10:48.21,0:10:50.21,Default,,0000,0000,0000,,(асқазанның айқайлауы)
Dialogue: 0,0:10:50.21,0:10:52.71,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:10:50.21,0:10:52.71,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:10:52.71,0:10:55.55,Default,,0000,0000,0000,,Жарайды, таңғы асты өткізіп жіберу қалыпты жағдай.
Dialogue: 0,0:10:55.55,0:10:58.55,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:10:58.55,0:11:01.99,Default,,0000,0000,0000,,Хмм, бұл жақсы.
Dialogue: 0,0:11:01.99,0:11:04.83,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:11:04.83,0:11:06.83,Default,,0000,0000,0000,,Ах, о!
Dialogue: 0,0:11:06.83,0:11:10.16,Default,,0000,0000,0000,,Бұл да жақсы.
Dialogue: 0,0:11:10.16,0:11:13.67,Default,,0000,0000,0000,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:11:13.67,0:11:16.00,Default,,0000,0000,0000,,Мен де жаңа жылдық ақшамды жинадым.
Dialogue: 0,0:11:16.00,0:11:18.01,Default,,0000,0000,0000,,Мен де біраз уақыт толық емес жұмыс жасадым➡
Dialogue: 0,0:11:18.01,0:11:20.34,Default,,0000,0000,0000,,Менің ақшам бар.
Dialogue: 0,0:11:20.34,0:11:23.34,Default,,0000,0000,0000,,Хмм, бірақ...
Dialogue: 0,0:11:23.34,0:11:25.85,Default,,0000,0000,0000,,Бірдеңе сатып алатын уақыт келгенде, мен уайымдаймын.
Dialogue: 0,0:11:25.85,0:11:28.18,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:11:28.18,0:11:31.08,Default,,0000,0000,0000,,Түсі, пішіні және т.б.
Dialogue: 0,0:11:33.52,0:11:36.02,Default,,0000,0000,0000,,Қымбат болғандықтан жақсы деп ойлаймын.
Dialogue: 0,0:11:36.02,0:11:38.03,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:11:38.03,0:11:41.53,Default,,0000,0000,0000,,Бірақ бұл арзан
Dialogue: 0,0:11:38.03,0:11:41.53,Default,,0000,0000,0000,,Маған ұнамайды.
Dialogue: 0,0:11:41.53,0:11:44.70,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:11:44.70,0:11:46.70,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:11:49.54,0:11:51.54,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:11:51.54,0:11:53.88,Default,,0000,0000,0000,,Не? А, мынау?
Dialogue: 0,0:11:53.88,0:11:57.88,Default,,0000,0000,0000,,Хмм, ерекше ештеңе жоқ...
Dialogue: 0,0:11:57.88,0:12:01.48,Default,,0000,0000,0000,,Бірақ мүлдем
Dialogue: 0,0:11:57.88,0:12:01.48,Default,,0000,0000,0000,,Керемет емес пе?
Dialogue: 0,0:12:01.48,0:12:03.48,Default,,0000,0000,0000,,Тағы, тағы!
Dialogue: 0,0:12:03.48,0:12:06.58,Default,,0000,0000,0000,,Толығырақ осында.
Dialogue: 0,0:12:08.82,0:12:12.83,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:12:12.83,0:12:15.50,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:12:15.50,0:12:17.80,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:12:15.50,0:12:17.80,Default,,0000,0000,0000,,(Мысық мияу)
Dialogue: 0,0:12:21.17,0:12:23.17,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:12:23.17,0:12:28.18,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:12:28.18,0:12:30.18,Default,,0000,0000,0000,,《Мына мысық...》
Dialogue: 0,0:12:30.18,0:12:38.69,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:12:38.69,0:12:40.69,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:12:44.69,0:12:46.86,Default,,0000,0000,0000,,А, аа!
Dialogue: 0,0:12:46.86,0:12:52.03,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:12:52.03,0:12:54.33,Default,,0000,0000,0000,,Нуаааа!
Dialogue: 0,0:12:56.37,0:12:58.37,Default,,0000,0000,0000,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:13:02.48,0:13:04.48,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:13:04.48,0:13:07.15,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:13:07.15,0:13:09.65,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,0:13:07.15,0:13:09.65,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:13:07.15,0:13:09.65,Default,,0000,0000,0000,,Мен әскермен бәрін реттедім.
Dialogue: 0,0:13:11.65,0:13:13.82,Default,,0000,0000,0000,,Мориёх қандай әдемі қала.
Dialogue: 0,0:13:11.65,0:13:13.82,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:13:13.82,0:13:16.16,Default,,0000,0000,0000,,Тістемеңіз!
Dialogue: 0,0:13:16.16,0:13:18.33,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,0:13:16.16,0:13:18.33,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:13:18.33,0:13:20.33,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:13:23.66,0:13:25.83,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:13:25.83,0:13:29.17,Default,,0000,0000,0000,,Не? аа….
Dialogue: 0,0:13:29.17,0:13:33.01,Default,,0000,0000,0000,,Мұндай мысық
Dialogue: 0,0:13:29.17,0:13:33.01,Default,,0000,0000,0000,,Оған дұрыс ұрысу керек.
Dialogue: 0,0:13:33.01,0:13:35.68,Default,,0000,0000,0000,,Бәрібір мені ұр
Dialogue: 0,0:13:33.01,0:13:35.68,Default,,0000,0000,0000,,Мені түсіндірмеңіз.
Dialogue: 0,0:13:35.68,0:13:37.68,Default,,0000,0000,0000,,Бірақ!
Dialogue: 0,0:13:35.68,0:13:37.68,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:37.68,0:13:40.68,Default,,0000,0000,0000,,Олармен сөйлессең, түсінеді.
Dialogue: 0,0:13:42.85,0:13:44.85,Default,,0000,0000,0000,,Амал жоқ.
Dialogue: 0,0:13:44.85,0:14:01.80,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:14:01.80,0:14:07.80,Default,,0000,0000,0000,,(Мысық мияу)
Dialogue: 0,0:14:15.48,0:14:22.66,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:14:22.66,0:14:25.16,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,0:14:28.50,0:14:30.50,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:14:35.34,0:14:38.34,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:14:38.34,0:14:44.35,Default,,0000,0000,0000,,(Мысық мияу)
Dialogue: 0,0:14:44.35,0:14:47.68,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:14:47.68,0:14:53.68,Default,,0000,0000,0000,,(Мысық мияу)
Dialogue: 0,0:15:02.46,0:15:04.47,Default,,0000,0000,0000,,Ха ха!
Dialogue: 0,0:15:04.47,0:15:06.47,Default,,0000,0000,0000,,Аха!
Dialogue: 0,0:15:06.47,0:15:12.47,Default,,0000,0000,0000,,(Мысық мияу)
Dialogue: 0,0:15:16.48,0:15:19.48,Default,,0000,0000,0000,,(Сағат дыбысы)
Dialogue: 0,0:15:19.48,0:15:21.82,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:15:19.48,0:15:21.82,Default,,0000,0000,0000,,(Журналдың құлаған дыбысы)
Dialogue: 0,0:15:21.82,0:15:24.65,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:15:24.65,0:15:30.65,Default,,0000,0000,0000,,(Сағат дыбысы)
Dialogue: 0,0:15:36.83,0:15:39.50,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:15:39.50,0:15:56.85,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:15:56.85,0:15:58.85,Default,,0000,0000,0000,,Ммм.
Dialogue: 0,0:15:58.85,0:16:01.55,Default,,0000,0000,0000,,Әй, Сакаки-сан!
Dialogue: 0,0:16:03.46,0:16:05.46,Default,,0000,0000,0000,,Сіз шығасыз ба?
Dialogue: 0,0:16:05.46,0:16:07.46,Default,,0000,0000,0000,,Мен шығамын.
Dialogue: 0,0:16:05.46,0:16:07.46,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:16:07.46,0:16:09.63,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:16:09.63,0:16:11.63,Default,,0000,0000,0000,,О...
Dialogue: 0,0:16:11.63,0:16:14.14,Default,,0000,0000,0000,,Қош келдіңіз.
Dialogue: 0,0:16:11.63,0:16:14.14,Default,,0000,0000,0000,,Мен барамын.
Dialogue: 0,0:16:14.14,0:16:16.34,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:16:19.81,0:16:21.81,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:16:21.81,0:16:26.98,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:16:26.98,0:16:28.98,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:16:32.82,0:16:36.66,Default,,0000,0000,0000,,Уау, осындай нәрсе
Dialogue: 0,0:16:32.82,0:16:36.66,Default,,0000,0000,0000,,Мен өте қуаныштымын!
Dialogue: 0,0:16:36.66,0:17:01.12,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:17:01.12,0:17:05.82,Default,,0000,0000,0000,,Хахаха...
Dialogue: 0,0:17:20.13,0:17:22.64,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:17:22.64,0:17:25.31,Default,,0000,0000,0000,,өтіңіз
Dialogue: 0,0:17:22.64,0:17:25.31,Default,,0000,0000,0000,,Мен Чиё Чанмен де таныстым.
Dialogue: 0,0:17:25.31,0:17:28.14,Default,,0000,0000,0000,,Дұрыс, осындай нәрсе➡
Dialogue: 0,0:17:28.14,0:17:31.15,Default,,0000,0000,0000,,Сақаки жігіт қатты толқыды.
Dialogue: 0,0:17:31.15,0:17:34.48,Default,,0000,0000,0000,,Сакаки бір жерде.
Dialogue: 0,0:17:34.48,0:17:36.82,Default,,0000,0000,0000,,Иә? О, Сакаки-сан.
Dialogue: 0,0:17:36.82,0:17:38.82,Default,,0000,0000,0000,,Қош келдіңіз... Ах!
Dialogue: 0,0:17:36.82,0:17:38.82,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:17:41.66,0:17:43.99,Default,,0000,0000,0000,,Барлығы бірден….
Dialogue: 0,0:17:43.99,0:17:46.83,Default,,0000,0000,0000,,А, а...
Dialogue: 0,0:17:46.83,0:17:49.83,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:17:49.83,0:17:55.34,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:17:55.34,0:17:57.34,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:05.28,0:18:07.28,Default,,0000,0000,0000,,Әй!
Dialogue: 0,0:18:10.79,0:18:13.62,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? Сакаки.
Dialogue: 0,0:18:13.62,0:18:16.52,Default,,0000,0000,0000,,Ооо!
Dialogue: 0,0:18:21.30,0:18:23.30,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:18:23.30,0:18:25.30,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:18:28.97,0:18:30.97,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,0:18:28.97,0:18:30.97,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:18:36.14,0:18:39.81,Default,,0000,0000,0000,,бөліміне өтіңіз. Сізді мысықтар жиі тістейді ме?
Dialogue: 0,0:18:39.81,0:18:42.32,Default,,0000,0000,0000,,Мүмкін➡
Dialogue: 0,0:18:42.32,0:18:45.65,Default,,0000,0000,0000,,Қолдарың балықтың иісін сезіп тұр ма?
Dialogue: 0,0:18:45.65,0:18:48.32,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:48.32,0:18:50.32,Default,,0000,0000,0000,,Жарайды, түсіндім!
Dialogue: 0,0:18:52.33,0:18:55.16,Default,,0000,0000,0000,,Сакакиге жақындап келе жатқан мысық
Dialogue: 0,0:18:52.33,0:18:55.16,Default,,0000,0000,0000,,Мен олардың бәрін қуып жіберемін!
Dialogue: 0,0:18:55.16,0:18:57.50,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:18:55.16,0:18:57.50,Default,,0000,0000,0000,,Ой...
Dialogue: 0,0:18:57.50,0:19:00.00,Default,,0000,0000,0000,,Міне болды!
Dialogue: 0,0:19:03.44,0:19:05.74,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:19:03.44,0:19:05.74,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:07.78,0:19:09.94,Default,,0000,0000,0000,,Га~!
Dialogue: 0,0:19:07.78,0:19:09.94,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,0:19:09.94,0:19:12.45,Default,,0000,0000,0000,,га~га~!
Dialogue: 0,0:19:12.45,0:19:14.45,Default,,0000,0000,0000,,мотивацияң — мүлде басқаша болады ғой?
Dialogue: 0,0:19:14.45,0:19:16.78,Default,,0000,0000,0000,,Га~!
Dialogue: 0,0:19:14.45,0:19:16.78,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,0:19:16.78,0:19:19.45,Default,,0000,0000,0000,,Га~!
Dialogue: 0,0:19:16.78,0:19:19.45,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,0:19:19.45,0:19:22.12,Default,,0000,0000,0000,,Га~!
Dialogue: 0,0:19:19.45,0:19:22.12,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,0:19:22.12,0:19:24.13,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:19:24.13,0:19:26.96,Default,,0000,0000,0000,,га~ га~ га~!
Dialogue: 0,0:19:24.13,0:19:26.96,Default,,0000,0000,0000,,Иә Тоқта...
Dialogue: 0,0:19:26.96,0:19:30.46,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:26.96,0:19:30.46,Default,,0000,0000,0000,,га~ га~!
Dialogue: 0,0:19:30.46,0:19:32.47,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:19:30.46,0:19:32.47,Default,,0000,0000,0000,,Га~!
Dialogue: 0,0:19:32.47,0:19:34.47,Default,,0000,0000,0000,,Ga~! о?
Dialogue: 0,0:19:34.47,0:19:36.80,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:19:36.80,0:19:40.64,Default,,0000,0000,0000,,Жоқ, жоқ... бұл….
Dialogue: 0,0:19:40.64,0:19:42.64,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:19:45.15,0:19:47.15,Default,,0000,0000,0000,,Қашпа.
Dialogue: 0,0:19:47.15,0:19:49.15,Default,,0000,0000,0000,,Менің ойымша...
Dialogue: 0,0:19:49.15,0:19:51.32,Default,,0000,0000,0000,,О...
Dialogue: 0,0:19:51.32,0:19:53.99,Default,,0000,0000,0000,,Тұрыңыз➡
Dialogue: 0,0:19:53.99,0:19:55.99,Default,,0000,0000,0000,,Жеңу керек.
Dialogue: 0,0:19:55.99,0:19:58.83,Default,,0000,0000,0000,,О~ Сакаки!
Dialogue: 0,0:19:58.83,0:20:00.83,Default,,0000,0000,0000,,Жаңа ғана жақсы нәрсе айттыңыз!
Dialogue: 0,0:20:00.83,0:20:03.13,Default,,0000,0000,0000,,Дұрыс, иә!
Dialogue: 0,0:20:05.17,0:20:08.17,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:20:05.17,0:20:08.17,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:20:11.51,0:20:13.81,Default,,0000,0000,0000,,Жарайды, Сакаки жүр!
Dialogue: 0,0:20:17.51,0:20:19.51,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:20:19.51,0:20:30.19,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:20:30.19,0:20:32.69,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:20:32.69,0:20:34.69,Default,,0000,0000,0000,,Га.
Dialogue: 0,0:20:37.87,0:20:39.87,Default,,0000,0000,0000,,Ku….
Dialogue: 0,0:20:43.37,0:20:45.37,Default,,0000,0000,0000,,Хмм, хмм, хмм, хмм…
Dialogue: 0,0:20:43.37,0:20:45.37,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:20:45.37,0:20:48.54,Default,,0000,0000,0000,,Ах! Күрсіну….
Dialogue: 0,0:20:48.54,0:20:50.88,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:20:50.88,0:20:53.38,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:20:57.05,0:21:00.32,Default,,0000,0000,0000,,Эй, жақсысың ба?
Dialogue: 0,0:21:00.32,0:21:07.83,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:07.83,0:21:09.83,Default,,0000,0000,0000,,Жарай ма? Сонымен...
Dialogue: 0,0:21:11.83,0:21:15.17,Default,,0000,0000,0000,,(қарбалас)
Dialogue: 0,0:21:15.17,0:21:17.34,Default,,0000,0000,0000,,Дұрыс, мен қазірдің өзінде таң қалдым.
Dialogue: 0,0:21:17.34,0:21:20.34,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:21:17.34,0:21:20.34,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:21:20.34,0:21:23.84,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:23.84,0:21:26.18,Default,,0000,0000,0000,,Сакаки мырза.
Dialogue: 0,0:21:23.84,0:21:26.18,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:21:26.18,0:21:28.52,Default,,0000,0000,0000,,Сакаки-сан, сен де ойын ойнайсың ба?
Dialogue: 0,0:21:28.52,0:21:31.35,Default,,0000,0000,0000,,А, а.
Dialogue: 0,0:21:28.52,0:21:31.35,Default,,0000,0000,0000,,Сакаки-санмен➡
Dialogue: 0,0:21:31.35,0:21:33.85,Default,,0000,0000,0000,,Күтілгендей
Dialogue: 0,0:21:31.35,0:21:33.85,Default,,0000,0000,0000,,Ұрыс ойындары, жарыс ойындары, т.б.➡
Dialogue: 0,0:21:33.85,0:21:35.86,Default,,0000,0000,0000,,Сіз мұны істейсіз бе?
Dialogue: 0,0:21:35.86,0:21:39.53,Default,,0000,0000,0000,,Жақсы, жақсы.
Dialogue: 0,0:21:35.86,0:21:39.53,Default,,0000,0000,0000,,~ Бұл керемет!
Dialogue: 0,0:21:39.53,0:21:42.20,Default,,0000,0000,0000,,Мен осылай істеймін
Dialogue: 0,0:21:39.53,0:21:42.20,Default,,0000,0000,0000,,Бұл мүлдем жақсы емес.
Dialogue: 0,0:21:42.20,0:21:44.70,Default,,0000,0000,0000,,Келесі жолы маған хабарлаңыз.
Dialogue: 0,0:21:42.20,0:21:44.70,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:21:44.70,0:21:46.70,Default,,0000,0000,0000,,Олай болса, кешіріңіз.
Dialogue: 0,0:21:50.37,0:21:52.37,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:21:53.87,0:21:59.87,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory