Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.85,0:01:34.19,Default,,0000,0000,0000,,Биыл тағы виллаға барасыз ба?
Dialogue: 0,0:01:34.19,0:01:37.86,Default,,0000,0000,0000,,Иә. Сонымен, бәрі де
Dialogue: 0,0:01:34.19,0:01:37.86,Default,,0000,0000,0000,,Мен сізді шақырғым келді!
Dialogue: 0,0:01:37.86,0:01:40.36,Default,,0000,0000,0000,,Иә, кеттік, кеттік.
Dialogue: 0,0:01:40.36,0:01:43.03,Default,,0000,0000,0000,,Келесі аптада. Түсінді.
Dialogue: 0,0:01:43.03,0:01:45.03,Default,,0000,0000,0000,,📞Арғы жағында
Dialogue: 0,0:01:43.03,0:01:45.03,Default,,0000,0000,0000,,Бізде де фестивальдер бар➡
Dialogue: 0,0:01:45.03,0:01:47.03,Default,,0000,0000,0000,,Юката әкеліңіз.
Dialogue: 0,0:01:49.04,0:01:52.71,Default,,0000,0000,0000,,Келесі аптада
Dialogue: 0,0:01:49.04,0:01:52.71,Default,,0000,0000,0000,,Бұл жақсы, өйткені менде үйірме жұмыстарынан демалыс бар.
Dialogue: 0,0:01:52.71,0:01:57.55,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:01:52.71,0:01:57.55,Default,,0000,0000,0000,,Келесі аптада астрономия клубының оқу-жаттығу жиыны.
Dialogue: 0,0:01:57.55,0:02:01.35,Default,,0000,0000,0000,,📞Ұят болды~
Dialogue: 0,0:01:57.55,0:02:01.35,Default,,0000,0000,0000,,Олай болса мен сені қайта шақырамын.
Dialogue: 0,0:02:03.65,0:02:05.99,Default,,0000,0000,0000,,Мен де... жарайды ма?
Dialogue: 0,0:02:05.99,0:02:09.32,Default,,0000,0000,0000,,📞Иә!
Dialogue: 0,0:02:05.99,0:02:09.32,Default,,0000,0000,0000,,Бізді көруге келіңіздер!
Dialogue: 0,0:02:09.32,0:02:12.49,Default,,0000,0000,0000,,Не~! ?
Dialogue: 0,0:02:09.32,0:02:12.49,Default,,0000,0000,0000,,Мен биыл тағы да виллаға барамын! ?
Dialogue: 0,0:02:12.49,0:02:15.33,Default,,0000,0000,0000,,Иә, биыл да...
Dialogue: 0,0:02:15.33,0:02:18.50,Default,,0000,0000,0000,,📞(Даналық) Нуа~! Сіз мұны мақтан етесіз бе?
Dialogue: 0,0:02:15.33,0:02:18.50,Default,,0000,0000,0000,,Бұл мақтануға тұрарлық нәрсе!
Dialogue: 0,0:02:18.50,0:02:21.34,Default,,0000,0000,0000,,📞 (Сатоши) Бір ғана адам буржуазиялық~
Dialogue: 0,0:02:18.50,0:02:21.34,Default,,0000,0000,0000,,Жазғы демалысты жақсы өткізейік➡
Dialogue: 0,0:02:21.34,0:02:23.67,Default,,0000,0000,0000,,Бұл дұрыс емес! Конц шоу!
Dialogue: 0,0:02:23.67,0:02:26.18,Default,,0000,0000,0000,,📞 (Томо) Мені де алыңыз!
Dialogue: 0,0:02:23.67,0:02:26.18,Default,,0000,0000,0000,,Мені ал!
Dialogue: 0,0:02:26.18,0:02:30.18,Default,,0000,0000,0000,,А-а-а... мен мұны айтқым келді.
Dialogue: 0,0:02:26.18,0:02:30.18,Default,,0000,0000,0000,,Мен сізге қоңырау шалып жатырмын ...
Dialogue: 0,0:02:30.18,0:02:32.35,Default,,0000,0000,0000,,📞 (Даналық) Хмм, онда бұл жақсы!
Dialogue: 0,0:02:32.35,0:02:35.35,Default,,0000,0000,0000,,Енді сіз барлығына қоңырау шалдыңыз.
Dialogue: 0,0:02:35.35,0:02:38.35,Default,,0000,0000,0000,,Иә, бұл Михама!
Dialogue: 0,0:02:35.35,0:02:38.35,Default,,0000,0000,0000,,📞
Dialogue: 0,0:02:38.35,0:02:42.36,Default,,0000,0000,0000,,Сәлем, бұл менмін.
Dialogue: 0,0:02:38.35,0:02:42.36,Default,,0000,0000,0000,,Ю Юкари Сенсэй!
Dialogue: 0,0:02:42.36,0:02:44.53,Default,,0000,0000,0000,,Кездесу орны Чиё Чан, солай ма?
Dialogue: 0,0:02:44.53,0:02:47.33,Default,,0000,0000,0000,,Уақыт 9:30. Кешіктірме.
Dialogue: 0,0:02:49.53,0:02:52.33,Default,,0000,0000,0000,,Сіз... қайдан білесіз?
Dialogue: 0,0:02:54.54,0:02:58.21,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:02:54.54,0:02:58.21,Default,,0000,0000,0000,,О Чио-чан, қайда бара жатырсың?
Dialogue: 0,0:02:58.21,0:03:01.14,Default,,0000,0000,0000,,Виллаға баруға дайындық кезінде шопинг!
Dialogue: 0,0:03:01.14,0:03:03.15,Default,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,0:03:03.15,0:03:05.48,Default,,0000,0000,0000,,Мен сенімен бара аламын ба?
Dialogue: 0,0:03:05.48,0:03:08.28,Default,,0000,0000,0000,,Жақсы. Сіз мінгіңіз келе ме?
Dialogue: 0,0:03:05.48,0:03:08.28,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:03:10.32,0:03:12.62,Default,,0000,0000,0000,,Мен барамын.
Dialogue: 0,0:03:10.32,0:03:12.62,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:03:14.99,0:03:18.66,Default,,0000,0000,0000,,Ааа….
Dialogue: 0,0:03:14.99,0:03:18.66,Default,,0000,0000,0000,,Ах... Уау!
Dialogue: 0,0:03:18.66,0:03:22.00,Default,,0000,0000,0000,,Эхха….
Dialogue: 0,0:03:18.66,0:03:22.00,Default,,0000,0000,0000,,Мен айдаймын.
Dialogue: 0,0:03:22.00,0:03:24.17,Default,,0000,0000,0000,,Бұл жақсы...
Dialogue: 0,0:03:24.17,0:03:27.84,Default,,0000,0000,0000,,Кеттік.
Dialogue: 0,0:03:24.17,0:03:27.84,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:03:27.84,0:03:31.34,Default,,0000,0000,0000,,Ух... аа...
Dialogue: 0,0:03:27.84,0:03:31.34,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:03:31.34,0:03:35.04,Default,,0000,0000,0000,,Екі адаммен мінуге болмайды ғой.
Dialogue: 0,0:03:31.34,0:03:35.04,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:03:37.18,0:03:40.18,Default,,0000,0000,0000,,Иә? Эй!
Dialogue: 0,0:03:37.18,0:03:40.18,Default,,0000,0000,0000,,Екеуіңіз де шоппинг жасайсыз ба?
Dialogue: 0,0:03:40.18,0:03:42.18,Default,,0000,0000,0000,,Иә! Бұл дұрыс!
Dialogue: 0,0:03:42.18,0:03:45.19,Default,,0000,0000,0000,,Мен де сатып аламын!
Dialogue: 0,0:03:42.18,0:03:45.19,Default,,0000,0000,0000,,Өте керемет купальник!
Dialogue: 0,0:03:45.19,0:03:48.86,Default,,0000,0000,0000,,Келесі сапарыңыз үшін бе?
Dialogue: 0,0:03:45.19,0:03:48.86,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:03:45.19,0:03:48.86,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:03:48.86,0:03:52.69,Default,,0000,0000,0000,,Хмм, бір бөлік те жақсы.
Dialogue: 0,0:03:48.86,0:03:52.69,Default,,0000,0000,0000,,Менің ойымша, бұл бикини.
Dialogue: 0,0:03:52.69,0:03:57.03,Default,,0000,0000,0000,,Сексуалды жігіт!
Dialogue: 0,0:03:52.69,0:03:57.03,Default,,0000,0000,0000,,Сонымен, түс қандай?
Dialogue: 0,0:03:57.03,0:03:59.70,Default,,0000,0000,0000,,Аа, ол толып қалды.
Dialogue: 0,0:03:59.70,0:04:02.14,Default,,0000,0000,0000,,Барлығын қабылдамаңыз!
Dialogue: 0,0:04:02.14,0:04:06.48,Default,,0000,0000,0000,,Бірақ одан бас тарту қиын...
Dialogue: 0,0:04:02.14,0:04:06.48,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:04:06.48,0:04:09.48,Default,,0000,0000,0000,,Оған мән бермеңіз.
Dialogue: 0,0:04:06.48,0:04:09.48,Default,,0000,0000,0000,,Көзге тиюден аулақ болыңыз.
Dialogue: 0,0:04:09.48,0:04:11.48,Default,,0000,0000,0000,,Сондықтан қабылдамаңыз!
Dialogue: 0,0:04:11.48,0:04:15.65,Default,,0000,0000,0000,,Әдепті адам болғандықтан...
Dialogue: 0,0:04:11.48,0:04:15.65,Default,,0000,0000,0000,,Сіз қанша алғыңыз келеді?
Dialogue: 0,0:04:15.65,0:04:18.65,Default,,0000,0000,0000,,Мен оны онша көп қолданбаймын.
Dialogue: 0,0:04:15.65,0:04:18.65,Default,,0000,0000,0000,,Міне...
Dialogue: 0,0:04:18.65,0:04:20.65,Default,,0000,0000,0000,,Осы жолы маған бересің бе?
Dialogue: 0,0:04:22.82,0:04:25.33,Default,,0000,0000,0000,,Содан кейін I
Dialogue: 0,0:04:22.82,0:04:25.33,Default,,0000,0000,0000,,Мен купальник бөліміне барамын!
Dialogue: 0,0:04:25.33,0:04:27.33,Default,,0000,0000,0000,,Содан кейін біз ➡
Dialogue: 0,0:04:27.33,0:04:30.83,Default,,0000,0000,0000,,Сырттағы тауарлар дүкеніне барайық.
Dialogue: 0,0:04:27.33,0:04:30.83,Default,,0000,0000,0000,,Сейана.
Dialogue: 0,0:04:30.83,0:04:34.50,Default,,0000,0000,0000,,Ах~ Жарайды... О, жоқ!
Dialogue: 0,0:04:34.50,0:04:38.01,Default,,0000,0000,0000,,Бұл жолы... Чачаунен....
Dialogue: 0,0:04:38.01,0:04:41.51,Default,,0000,0000,0000,,Тағы бір рет...
Dialogue: 0,0:04:38.01,0:04:41.51,Default,,0000,0000,0000,,Осака-сан!
Dialogue: 0,0:04:46.01,0:04:50.35,Default,,0000,0000,0000,,Осака-сан, жақсысың ба?
Dialogue: 0,0:04:46.01,0:04:50.35,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:04:50.35,0:04:52.52,Default,,0000,0000,0000,,Бұл эскалатор...
Dialogue: 0,0:04:52.52,0:04:55.52,Default,,0000,0000,0000,,I… I….
Dialogue: 0,0:04:55.52,0:04:58.53,Default,,0000,0000,0000,,Сіз мұны оңай айдай аласыз.
Dialogue: 0,0:04:58.53,0:05:03.80,Default,,0000,0000,0000,,Бұл S... элеваторы.
Dialogue: 0,0:04:58.53,0:05:03.80,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:03.80,0:05:06.13,Default,,0000,0000,0000,,Кейде заттар араласып кетеді...
Dialogue: 0,0:05:06.13,0:05:09.47,Default,,0000,0000,0000,,Лифт эскалаторы.
Dialogue: 0,0:05:09.47,0:05:12.81,Default,,0000,0000,0000,,Эскалаторлы лифт?
Dialogue: 0,0:05:12.81,0:05:15.14,Default,,0000,0000,0000,,Ах... түсіндім.
Dialogue: 0,0:05:15.14,0:05:18.31,Default,,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,0:05:15.14,0:05:18.31,Default,,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,0:05:18.31,0:05:20.32,Default,,0000,0000,0000,,Хмм, сені мазақ етсем кешір...
Dialogue: 0,0:05:20.32,0:05:23.82,Default,,0000,0000,0000,,Жәшік тәрізді зат – эскалатор.
Dialogue: 0,0:05:23.82,0:05:28.16,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:05:23.82,0:05:28.16,Default,,0000,0000,0000,,Бәрі араласып кетті... у...
Dialogue: 0,0:05:28.16,0:05:31.33,Default,,0000,0000,0000,,Жәшік тәрізді зат – лифт....
Dialogue: 0,0:05:31.33,0:05:33.83,Default,,0000,0000,0000,,Түсіндім!
Dialogue: 0,0:05:41.50,0:05:44.84,Default,,0000,0000,0000,,(оятар сағат)
Dialogue: 0,0:05:44.84,0:05:47.51,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:05:47.51,0:05:50.35,Default,,0000,0000,0000,,Хаааах! Гүх!
Dialogue: 0,0:05:50.35,0:05:53.02,Default,,0000,0000,0000,,Саяхаттауға тамаша күн!
Dialogue: 0,0:05:53.02,0:05:59.19,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:05:59.19,0:06:01.46,Default,,0000,0000,0000,,Барлығы келгенше дайындалу керек!
Dialogue: 0,0:06:01.46,0:06:04.06,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:06:06.13,0:06:09.80,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:06:06.13,0:06:09.80,Default,,0000,0000,0000,,А, Сакаки-сан, келдің бе?
Dialogue: 0,0:06:09.80,0:06:13.14,Default,,0000,0000,0000,,Кездесу уақытына дейін
Dialogue: 0,0:06:09.80,0:06:13.14,Default,,0000,0000,0000,,Әлі бір сағат қалды, солай ма?
Dialogue: 0,0:06:13.14,0:06:17.34,Default,,0000,0000,0000,,Иә, мен күтемін. Тадаёси-санмен.
Dialogue: 0,0:06:19.64,0:06:22.14,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:06:22.14,0:06:24.15,Default,,0000,0000,0000,,Чио-чан, күткеніңізге рахмет.
Dialogue: 0,0:06:24.15,0:06:26.15,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:06:26.15,0:06:28.65,Default,,0000,0000,0000,,Мен бұл жолы адаспадым.
Dialogue: 0,0:06:28.65,0:06:31.15,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:06:31.15,0:06:33.66,Default,,0000,0000,0000,,Usu!
Dialogue: 0,0:06:31.15,0:06:33.66,Default,,0000,0000,0000,,Барлығы осында ма?
Dialogue: 0,0:06:33.66,0:06:37.06,Default,,0000,0000,0000,,Және Томо-чанмен
Dialogue: 0,0:06:33.66,0:06:37.06,Default,,0000,0000,0000,,Кагура-сан келе жатыр.
Dialogue: 0,0:06:40.16,0:06:43.17,Default,,0000,0000,0000,,《Сакаки: Мен бақыттымын...》
Dialogue: 0,0:06:43.17,0:06:45.83,Default,,0000,0000,0000,,Ей, мен кешікпей келдім!
Dialogue: 0,0:06:45.83,0:06:47.84,Default,,0000,0000,0000,,(Аня) Кешкі асқа не бермек екен? (Іштің күркіреген дыбысы)
Dialogue: 0,0:06:47.84,0:06:52.67,Default,,0000,0000,0000,,Шикаши, бұл керемет.
Dialogue: 0,0:06:47.84,0:06:52.67,Default,,0000,0000,0000,,Чиёчанчи Үй дегеніміз не?
Dialogue: 0,0:06:52.67,0:06:55.84,Default,,0000,0000,0000,,Қандай керемет!
Dialogue: 0,0:06:52.67,0:06:55.84,Default,,0000,0000,0000,,О, бұл керемет.
Dialogue: 0,0:06:55.84,0:06:59.18,Default,,0000,0000,0000,,Хамф~ солай емес пе? Емес пе?
Dialogue: 0,0:06:59.18,0:07:01.45,Default,,0000,0000,0000,,Неліктен мақтанасың?
Dialogue: 0,0:07:01.45,0:07:04.12,Default,,0000,0000,0000,,Кагура-чан, бұл тас қараңғы.
Dialogue: 0,0:07:04.12,0:07:06.29,Default,,0000,0000,0000,,Өйткені бұл жүзу үйірмесі!
Dialogue: 0,0:07:06.29,0:07:09.29,Default,,0000,0000,0000,,Мен бірдеңе ойнап жатқан сияқтымын.
Dialogue: 0,0:07:09.29,0:07:11.46,Default,,0000,0000,0000,,Ол ойыншы.
Dialogue: 0,0:07:11.46,0:07:13.80,Default,,0000,0000,0000,,А-а... шынымен де солай ма?
Dialogue: 0,0:07:13.80,0:07:15.80,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:07:15.80,0:07:19.97,Default,,0000,0000,0000,,Мен бастауыш сыныпта оқып жүрген кезімде, менің сыныбымдағы ұлдар
Dialogue: 0,0:07:15.80,0:07:19.97,Default,,0000,0000,0000,,Дәл солай болды.
Dialogue: 0,0:07:19.97,0:07:24.47,Default,,0000,0000,0000,,Жоқ, бұл ондай ойын емес деп ойлаймын.
Dialogue: 0,0:07:19.97,0:07:24.47,Default,,0000,0000,0000,,Мені тыңда!
Dialogue: 0,0:07:24.47,0:07:27.48,Default,,0000,0000,0000,,О!
Dialogue: 0,0:07:24.47,0:07:27.48,Default,,0000,0000,0000,,Бұл жолы Масин ба?
Dialogue: 0,0:07:27.48,0:07:30.31,Default,,0000,0000,0000,,Чио-чан өте мұқият.
Dialogue: 0,0:07:30.31,0:07:33.65,Default,,0000,0000,0000,,Барлығы мінетін көлік
Dialogue: 0,0:07:30.31,0:07:33.65,Default,,0000,0000,0000,,Маған дайындағанына сене алар емеспін!
Dialogue: 0,0:07:33.65,0:07:37.65,Default,,0000,0000,0000,,Эххе, әкеңнен сұра.
Dialogue: 0,0:07:33.65,0:07:37.65,Default,,0000,0000,0000,,Мен оны қарызға алдым!
Dialogue: 0,0:07:37.65,0:07:40.66,Default,,0000,0000,0000,,Аха~ Бұл керемет. Жарайды, жарайды.
Dialogue: 0,0:07:40.66,0:07:43.33,Default,,0000,0000,0000,,Юкари~ Аз ғана~.
Dialogue: 0,0:07:40.66,0:07:43.33,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:07:43.33,0:07:47.33,Default,,0000,0000,0000,,Бұл қатысты машиналарға қарсы шара ма?
Dialogue: 0,0:07:43.33,0:07:47.33,Default,,0000,0000,0000,,Бұлай етпе, Чио-чан.
Dialogue: 0,0:07:47.33,0:07:49.83,Default,,0000,0000,0000,,Юкари-чан
Dialogue: 0,0:07:47.33,0:07:49.83,Default,,0000,0000,0000,,Мен ештеңе түсінбеймін.
Dialogue: 0,0:07:49.83,0:07:52.00,Default,,0000,0000,0000,,«Юкаригурума» дегеніміз не?
Dialogue: 0,0:07:52.00,0:07:56.34,Default,,0000,0000,0000,,Чио-чан былтыр атқа мінген
Dialogue: 0,0:07:52.00,0:07:56.34,Default,,0000,0000,0000,,Ол терең психикалық жарақат алған.
Dialogue: 0,0:07:56.34,0:07:59.01,Default,,0000,0000,0000,,Хмм, солай ма? Чиё-чан.
Dialogue: 0,0:07:59.01,0:08:00.94,Default,,0000,0000,0000,,Мені тыңда!
Dialogue: 0,0:08:00.94,0:08:04.11,Default,,0000,0000,0000,,Жоқ, қазір бәрі жақсы, солай ма?
Dialogue: 0,0:08:04.11,0:08:06.11,Default,,0000,0000,0000,,Jo?
Dialogue: 0,0:08:06.11,0:08:09.28,Default,,0000,0000,0000,,Сіз жылдамдықты арттырасыз ба?
Dialogue: 0,0:08:06.11,0:08:09.28,Default,,0000,0000,0000,,Жылдамдық онша үлкен емес➡
Dialogue: 0,0:08:09.28,0:08:11.45,Default,,0000,0000,0000,,Кейде тым ерте➡
Dialogue: 0,0:08:11.45,0:08:14.96,Default,,0000,0000,0000,,Кейде өте
Dialogue: 0,0:08:11.45,0:08:14.96,Default,,0000,0000,0000,,Кейде ол баяу.
Dialogue: 0,0:08:11.45,0:08:14.96,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:08:14.96,0:08:19.96,Default,,0000,0000,0000,,Юкари Сенсей
Dialogue: 0,0:08:14.96,0:08:19.96,Default,,0000,0000,0000,,Сол және оң жақтарды көбірек тексеру керек.
Dialogue: 0,0:08:19.96,0:08:22.63,Default,,0000,0000,0000,,Мүмкін болса, артқы жағы да
Dialogue: 0,0:08:19.96,0:08:22.63,Default,,0000,0000,0000,,Сақ болыңыз.
Dialogue: 0,0:08:22.63,0:08:27.13,Default,,0000,0000,0000,,Ал кейде бағдаршамдар мен жаяу жүргіншілер жүреді.
Dialogue: 0,0:08:22.63,0:08:27.13,Default,,0000,0000,0000,,Мен оны көрмей тұрғандай сезінемін.
Dialogue: 0,0:08:29.14,0:08:31.47,Default,,0000,0000,0000,,Бұл мүлдем жаман емес пе?
Dialogue: 0,0:08:31.47,0:08:33.98,Default,,0000,0000,0000,,Иә, иә….
Dialogue: 0,0:08:31.47,0:08:33.98,Default,,0000,0000,0000,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:08:33.98,0:08:36.81,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:33.98,0:08:36.81,Default,,0000,0000,0000,,Ал, мен көлік жүргіземін!
Dialogue: 0,0:08:36.81,0:08:39.82,Default,,0000,0000,0000,,Барлығың бортқа мініңдер!
Dialogue: 0,0:08:36.81,0:08:39.82,Default,,0000,0000,0000,,Не~! ?
Dialogue: 0,0:08:39.82,0:08:42.48,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:08:42.48,0:08:44.99,Default,,0000,0000,0000,,А, а...
Dialogue: 0,0:08:44.99,0:08:47.32,Default,,0000,0000,0000,,Ой….
Dialogue: 0,0:08:51.83,0:08:56.67,Default,,0000,0000,0000,,Егер менде үйірме жұмыстары болмаса...
Dialogue: 0,0:08:51.83,0:08:56.67,Default,,0000,0000,0000,,Қазір мен Сакаки-санмен жағажайда боламын...
Dialogue: 0,0:08:56.67,0:09:00.44,Default,,0000,0000,0000,,Мен осындамын.
Dialogue: 0,0:08:56.67,0:09:00.44,Default,,0000,0000,0000,,Сен мұнда не үшін келдің?
Dialogue: 0,0:09:00.44,0:09:14.04,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:09:16.12,0:09:18.45,Default,,0000,0000,0000,,Келу~!
Dialogue: 0,0:09:18.45,0:09:23.46,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:09:23.46,0:09:26.46,Default,,0000,0000,0000,,О, бұл Чиёчанчидің вилласы ма?
Dialogue: 0,0:09:26.46,0:09:29.56,Default,,0000,0000,0000,,Ұнады, лайк!
Dialogue: 0,0:09:26.46,0:09:29.56,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:09:31.80,0:09:35.97,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:31.80,0:09:35.97,Default,,0000,0000,0000,,солай емес пе? Емес пе? Хмф.
Dialogue: 0,0:09:35.97,0:09:39.07,Default,,0000,0000,0000,,Сен неге мақтандың?
Dialogue: 0,0:09:35.97,0:09:39.07,Default,,0000,0000,0000,,Менің естігім келетіні осы.
Dialogue: 0,0:09:43.98,0:09:46.65,Default,,0000,0000,0000,,Иә, ашайық!
Dialogue: 0,0:09:46.65,0:09:50.85,Default,,0000,0000,0000,,Бұл кілтті қазір жоғалтып алсаңыз, кіре алмайсыз.
Dialogue: 0,0:09:53.66,0:09:56.16,Default,,0000,0000,0000,,Қабыл ал!
Dialogue: 0,0:09:53.66,0:09:56.16,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:09:59.66,0:10:02.33,Default,,0000,0000,0000,,Ахх...
Dialogue: 0,0:10:02.33,0:10:06.17,Default,,0000,0000,0000,,Мен жасадым!
Dialogue: 0,0:10:02.33,0:10:06.17,Default,,0000,0000,0000,,Сіз мұны істедіңіз!
Dialogue: 0,0:10:06.17,0:10:10.34,Default,,0000,0000,0000,,Жоқ~ Бұл~ болды ма?
Dialogue: 0,0:10:10.34,0:10:13.84,Default,,0000,0000,0000,,Білесіз бе, сіз бұлай айтқанда, керісінше әрекет еткіңіз келеді.
Dialogue: 0,0:10:13.84,0:10:16.01,Default,,0000,0000,0000,,Сондықтан оны лақтырмаңыз.
Dialogue: 0,0:10:16.01,0:10:18.51,Default,,0000,0000,0000,,Хмм, бұл біртүрлі...
Dialogue: 0,0:10:16.01,0:10:18.51,Default,,0000,0000,0000,,Мен оларды қырдым
Dialogue: 0,0:10:18.51,0:10:20.52,Default,,0000,0000,0000,,Масалар көп...
Dialogue: 0,0:10:18.51,0:10:20.52,Default,,0000,0000,0000,,Мен оларды қырдым
Dialogue: 0,0:10:20.52,0:10:24.85,Default,,0000,0000,0000,,Аа... Таку
Dialogue: 0,0:10:20.52,0:10:24.85,Default,,0000,0000,0000,,Оны әлі таба алмайсыз ба?
Dialogue: 0,0:10:24.85,0:10:27.36,Default,,0000,0000,0000,,Сізді де іздеңіз!
Dialogue: 0,0:10:27.36,0:10:30.03,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:10:27.36,0:10:30.03,Default,,0000,0000,0000,,Не деген сұмдық!
Dialogue: 0,0:10:30.03,0:10:32.19,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:10:30.03,0:10:32.19,Default,,0000,0000,0000,,Мен кілтті таптым➡
Dialogue: 0,0:10:32.19,0:10:36.03,Default,,0000,0000,0000,,Қайта лақтырсаң, күлесің!
Dialogue: 0,0:10:32.19,0:10:36.03,Default,,0000,0000,0000,,Қатты күлмеңіз!
Dialogue: 0,0:10:36.03,0:10:40.37,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:10:40.37,0:10:43.20,Default,,0000,0000,0000,,№.
Dialogue: 0,0:10:43.20,0:10:46.37,Default,,0000,0000,0000,,Ах~ Ах! Міне болды!
Dialogue: 0,0:10:46.37,0:10:48.88,Default,,0000,0000,0000,,Сакаки!
Dialogue: 0,0:10:46.37,0:10:48.88,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:10:48.88,0:10:50.88,Default,,0000,0000,0000,,Енді оның құлпын ашыңыз!
Dialogue: 0,0:10:48.88,0:10:50.88,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:10:50.88,0:10:54.38,Default,,0000,0000,0000,,Мен~! Үш адам алатын қорқақтық!
Dialogue: 0,0:10:50.88,0:10:54.38,Default,,0000,0000,0000,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:10:58.05,0:11:01.55,Default,,0000,0000,0000,,Күрсін, енді не болатынын ойламай тұра алмаймын...
Dialogue: 0,0:11:04.33,0:11:06.49,Default,,0000,0000,0000,,Ах~ Біз де жеттік~.
Dialogue: 0,0:11:06.49,0:11:08.50,Default,,0000,0000,0000,,О, іші де жақсы!
Dialogue: 0,0:11:08.50,0:11:10.67,Default,,0000,0000,0000,,күрсіну.
Dialogue: 0,0:11:10.67,0:11:16.50,Default,,0000,0000,0000,,Күрсін, мен кіру үшін барлық қиындықтарды бастан өткергенде ерекше бір нәрсені сезінемін.
Dialogue: 0,0:11:16.50,0:11:18.67,Default,,0000,0000,0000,,Сөйлемеңіз.
Dialogue: 0,0:11:18.67,0:11:21.51,Default,,0000,0000,0000,,Енді қысқа үзілістен кейін
Dialogue: 0,0:11:18.67,0:11:21.51,Default,,0000,0000,0000,,Теңізге барайық!
Dialogue: 0,0:11:21.51,0:11:23.51,Default,,0000,0000,0000,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:11:23.51,0:11:27.11,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:11:23.51,0:11:27.11,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:11:29.18,0:11:31.58,Default,,0000,0000,0000,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:11:29.18,0:11:31.58,Default,,0000,0000,0000,,Хахахаха…
Dialogue: 0,0:11:29.18,0:11:31.58,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:11:35.19,0:11:37.19,Default,,0000,0000,0000,,Умм~!
Dialogue: 0,0:11:37.19,0:11:40.19,Default,,0000,0000,0000,,Теңіз туралы айтсақ, былтырғыдай.
Dialogue: 0,0:11:37.19,0:11:40.19,Default,,0000,0000,0000,,Қарбыз жарылған!
Dialogue: 0,0:11:42.20,0:11:45.20,Default,,0000,0000,0000,,Биыл бізде жарғанаттар бар!
Dialogue: 0,0:11:45.20,0:11:48.70,Default,,0000,0000,0000,,Қараңдар! Осы өлімге әкелетін оң қолмен➡
Dialogue: 0,0:11:48.70,0:11:51.20,Default,,0000,0000,0000,,Никкуки қарбызы биыл!
Dialogue: 0,0:11:53.21,0:11:55.61,Default,,0000,0000,0000,,А? Ааа!
Dialogue: 0,0:11:53.21,0:11:55.61,Default,,0000,0000,0000,,(қарбыз сынған дыбыс)
Dialogue: 0,0:11:58.05,0:12:01.32,Default,,0000,0000,0000,,Біз мұны жасадық! Екіден екі! а?
Dialogue: 0,0:12:01.32,0:12:04.32,Default,,0000,0000,0000,,Сіз не істеп жатырсыз...?
Dialogue: 0,0:12:01.32,0:12:04.32,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:07.82,0:12:09.82,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:12:13.33,0:12:15.66,Default,,0000,0000,0000,,Ах! ? аа….
Dialogue: 0,0:12:15.66,0:12:18.17,Default,,0000,0000,0000,,Бөліп тұрған мен болсам да...
Dialogue: 0,0:12:18.17,0:12:21.50,Default,,0000,0000,0000,,Мен! Мен оны бөлемін!
Dialogue: 0,0:12:21.50,0:12:23.67,Default,,0000,0000,0000,,Жылама...
Dialogue: 0,0:12:23.67,0:12:25.84,Default,,0000,0000,0000,,Мен шырын сатып аламын, бірақ оны кім қалайды?
Dialogue: 0,0:12:25.84,0:12:27.84,Default,,0000,0000,0000,,Иә, Кола!
Dialogue: 0,0:12:27.84,0:12:29.84,Default,,0000,0000,0000,,Сыра!
Dialogue: 0,0:12:27.84,0:12:29.84,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:12:29.84,0:12:32.35,Default,,0000,0000,0000,,Мен қызғылт сарымын~!
Dialogue: 0,0:12:32.35,0:12:35.35,Default,,0000,0000,0000,,Улонг шайы.
Dialogue: 0,0:12:32.35,0:12:35.35,Default,,0000,0000,0000,,Жарайды, сәл күте тұрыңыз.
Dialogue: 0,0:12:40.19,0:12:48.39,Default,,0000,0000,0000,,Ай!
Dialogue: 0,0:12:50.37,0:12:52.70,Default,,0000,0000,0000,,(аяқ дыбысы)
Dialogue: 0,0:12:52.70,0:12:55.20,Default,,0000,0000,0000,,Күтіңіз~ Апельсин деген кім?
Dialogue: 0,0:12:59.21,0:13:01.31,Default,,0000,0000,0000,,Эй.
Dialogue: 0,0:12:59.21,0:13:01.31,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:13:01.31,0:13:06.31,Default,,0000,0000,0000,,Шикі ветчина қауын дегеніміз не?
Dialogue: 0,0:13:01.31,0:13:06.31,Default,,0000,0000,0000,,Бұл байлау ісі.
Dialogue: 0,0:13:08.48,0:13:11.32,Default,,0000,0000,0000,,Шошқаның тәтті және қышқыл еті қосылған ананас жақсы емес пе?
Dialogue: 0,0:13:11.32,0:13:13.82,Default,,0000,0000,0000,,О, бұл рас!
Dialogue: 0,0:13:16.66,0:13:18.99,Default,,0000,0000,0000,,Уау~ Бұл не?
Dialogue: 0,0:13:18.99,0:13:22.00,Default,,0000,0000,0000,,Мысық, мысық….
Dialogue: 0,0:13:22.00,0:13:24.50,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:13:24.50,0:13:27.50,Default,,0000,0000,0000,,Құлағыңыз кішкентай ма?
Dialogue: 0,0:13:27.50,0:13:29.84,Default,,0000,0000,0000,,Мен үйдемін.
Dialogue: 0,0:13:27.50,0:13:29.84,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:13:29.84,0:13:32.67,Default,,0000,0000,0000,,Осака~Апельсин Бұл сенікі, солай ма?
Dialogue: 0,0:13:32.67,0:13:35.57,Default,,0000,0000,0000,,А, мен солай істедім.
Dialogue: 0,0:13:43.02,0:13:45.02,Default,,0000,0000,0000,,《Сакаки: Кешіріңіз...》
Dialogue: 0,0:13:45.02,0:13:48.86,Default,,0000,0000,0000,,(Хигурашидің айқайы)
Dialogue: 0,0:13:48.86,0:13:50.86,Default,,0000,0000,0000,,Түн!
Dialogue: 0,0:13:50.86,0:13:53.86,Default,,0000,0000,0000,,Түнде бұл жыл сайынғы банкет!
Dialogue: 0,0:13:53.86,0:13:56.36,Default,,0000,0000,0000,,Ішейік! Ән салайық!
Dialogue: 0,0:13:56.36,0:13:59.70,Default,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:13:56.36,0:13:59.70,Default,,0000,0000,0000,,Оның алдында фестиваль бар.
Dialogue: 0,0:13:59.70,0:14:02.97,Default,,0000,0000,0000,,Жақын жерде болып жатыр.
Dialogue: 0,0:13:59.70,0:14:02.97,Default,,0000,0000,0000,,Мен мұны айтқан жоқпын ба?
Dialogue: 0,0:14:02.97,0:14:05.64,Default,,0000,0000,0000,,О, түсіндім! Солай ма!
Dialogue: 0,0:14:05.64,0:14:08.31,Default,,0000,0000,0000,,Міне, келдің!
Dialogue: 0,0:14:05.64,0:14:08.31,Default,,0000,0000,0000,,Алтын балық аулайық!
Dialogue: 0,0:14:08.31,0:14:10.48,Default,,0000,0000,0000,,Ал теңізге
Dialogue: 0,0:14:08.31,0:14:10.48,Default,,0000,0000,0000,,Оны босатайық!
Dialogue: 0,0:14:10.48,0:14:12.48,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:14:12.48,0:14:15.65,Default,,0000,0000,0000,,Олай болса, бәріңе.
Dialogue: 0,0:14:12.48,0:14:15.65,Default,,0000,0000,0000,,Юкатаға ауысайық!
Dialogue: 0,0:14:15.65,0:14:17.99,Default,,0000,0000,0000,,Сіз оны дұрыс әкелдіңіз бе?
Dialogue: 0,0:14:15.65,0:14:17.99,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:14:17.99,0:14:22.16,Default,,0000,0000,0000,,Куросава мырза~
Dialogue: 0,0:14:17.99,0:14:22.16,Default,,0000,0000,0000,,Мұны не үшін киесің?
Dialogue: 0,0:14:22.16,0:14:26.49,Default,,0000,0000,0000,,Не? Ах, мм...
Dialogue: 0,0:14:26.49,0:14:30.67,Default,,0000,0000,0000,,А, мен сені киіндіре аламын.
Dialogue: 0,0:14:26.49,0:14:30.67,Default,,0000,0000,0000,,Мен де.
Dialogue: 0,0:14:30.67,0:14:34.67,Default,,0000,0000,0000,,Олай болса.
Dialogue: 0,0:14:30.67,0:14:34.67,Default,,0000,0000,0000,,Олай болса, айта аласыз ба?
Dialogue: 0,0:14:34.67,0:14:36.67,Default,,0000,0000,0000,,Бұл жақсы емес.
Dialogue: 0,0:14:34.67,0:14:36.67,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:36.67,0:14:40.18,Default,,0000,0000,0000,,Ересектен балаға
Dialogue: 0,0:14:36.67,0:14:40.18,Default,,0000,0000,0000,,Маған кимоно киюді үйретіңізші.
Dialogue: 0,0:14:40.18,0:14:42.18,Default,,0000,0000,0000,,Сенің де қолыңнан келмейді!
Dialogue: 0,0:14:42.18,0:14:44.35,Default,,0000,0000,0000,,Бірақ бұл таңқаларлық.
Dialogue: 0,0:14:44.35,0:14:47.68,Default,,0000,0000,0000,,Юкари-чан бәрібір
Dialogue: 0,0:14:44.35,0:14:47.68,Default,,0000,0000,0000,,Менің ойымша, Нямо-чан мұны істей алады.
Dialogue: 0,0:14:47.68,0:14:51.19,Default,,0000,0000,0000,,Нямо-чан...
Dialogue: 0,0:14:47.68,0:14:51.19,Default,,0000,0000,0000,,Шынымен.
Dialogue: 0,0:14:51.19,0:14:53.19,Default,,0000,0000,0000,,Біреудің галстукін байлауға болады➡
Dialogue: 0,0:14:53.19,0:14:56.86,Default,,0000,0000,0000,,Бұл Куросава мырзаға ұқсамайды.
Dialogue: 0,0:14:53.19,0:14:56.86,Default,,0000,0000,0000,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:14:56.86,0:14:59.36,Default,,0000,0000,0000,,Е! Болды
Dialogue: 0,0:14:56.86,0:14:59.36,Default,,0000,0000,0000,,Бұл қалай мүмкін? ?
Dialogue: 0,0:14:59.36,0:15:04.97,Default,,0000,0000,0000,,Бір кездері Нямо екеуміз ғашық болған кезде, бұл әйел мені сынаушы ретінде пайдаланды➡
Dialogue: 0,0:15:04.97,0:15:07.64,Default,,0000,0000,0000,,Мен галстук байлауды жаттықтым!
Dialogue: 0,0:15:04.97,0:15:07.64,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:15:07.64,0:15:11.81,Default,,0000,0000,0000,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:15:07.64,0:15:11.81,Default,,0000,0000,0000,,Жақсы! Бұл көп уақыт бұрын!
Dialogue: 0,0:15:11.81,0:15:13.81,Default,,0000,0000,0000,,Бұл тәжірибенің нәтижесі➡
Dialogue: 0,0:15:13.81,0:15:16.81,Default,,0000,0000,0000,,Көрінбей
Dialogue: 0,0:15:13.81,0:15:16.81,Default,,0000,0000,0000,,Бәрі бітті...
Dialogue: 0,0:15:16.81,0:15:19.15,Default,,0000,0000,0000,,Оның келесі амбициясы қандай!
Dialogue: 0,0:15:16.81,0:15:19.15,Default,,0000,0000,0000,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:15:19.15,0:15:21.98,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:15:19.15,0:15:21.98,Default,,0000,0000,0000,,Не, не!
Dialogue: 0,0:15:21.98,0:15:25.15,Default,,0000,0000,0000,,Сен де, үш жаз бұрын.
Dialogue: 0,0:15:21.98,0:15:25.15,Default,,0000,0000,0000,,Ұмытпа! ?
Dialogue: 0,0:15:25.15,0:15:28.16,Default,,0000,0000,0000,,О? Сондықтан 4 жыл бұрын шкафқа жасырдым➡
Dialogue: 0,0:15:28.16,0:15:30.33,Default,,0000,0000,0000,,Бұл туралы айту дұрыс па?
Dialogue: 0,0:15:30.33,0:15:32.99,Default,,0000,0000,0000,,Оу, бұ да керемет екен. Сендер тез жеп қойыңдар.
Dialogue: 0,0:15:30.33,0:15:32.99,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:15:32.99,0:15:35.66,Default,,0000,0000,0000,,О! Бұл ескі жаралардың шайқасы!
Dialogue: 0,0:15:35.66,0:15:38.00,Default,,0000,0000,0000,,Барлығы
Dialogue: 0,0:15:35.66,0:15:38.00,Default,,0000,0000,0000,,Дайынсың ба?
Dialogue: 0,0:15:38.00,0:15:40.17,Default,,0000,0000,0000,,О!
Dialogue: 0,0:15:38.00,0:15:40.17,Default,,0000,0000,0000,,Кеттік!
Dialogue: 0,0:15:40.17,0:15:47.34,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:15:47.34,0:15:51.51,Default,,0000,0000,0000,,Ха, юката кигеніме көп болды.
Dialogue: 0,0:15:51.51,0:15:53.51,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:15:53.51,0:15:56.18,Default,,0000,0000,0000,,Бұл жаңалық па?
Dialogue: 0,0:15:56.18,0:15:59.52,Default,,0000,0000,0000,,Әй, ата-анама.
Dialogue: 0,0:15:56.18,0:15:59.52,Default,,0000,0000,0000,,Юката бар ма деп сұрағанда ➡
Dialogue: 0,0:15:59.52,0:16:02.79,Default,,0000,0000,0000,,Әкем қуанып қалды...
Dialogue: 0,0:15:59.52,0:16:02.79,Default,,0000,0000,0000,,Ол мен үшін сатып алды.
Dialogue: 0,0:16:02.79,0:16:06.29,Default,,0000,0000,0000,,Сонымен, сен мұны істедің бе?
Dialogue: 0,0:16:02.79,0:16:06.29,Default,,0000,0000,0000,,Обиді айнала және айнала тартыңыз.
Dialogue: 0,0:16:06.29,0:16:08.30,Default,,0000,0000,0000,,Жоқ, судья мырза!
Dialogue: 0,0:16:08.30,0:16:10.97,Default,,0000,0000,0000,,Жақсы емес пе!
Dialogue: 0,0:16:08.30,0:16:10.97,Default,,0000,0000,0000,,Жақсы емес пе!
Dialogue: 0,0:16:10.97,0:16:13.80,Default,,0000,0000,0000,,Оның аты ``Yoi Nai Kagokko''.
Dialogue: 0,0:16:13.80,0:16:15.80,Default,,0000,0000,0000,,Мұны жасамаңыз.
Dialogue: 0,0:16:13.80,0:16:15.80,Default,,0000,0000,0000,,Эх!
Dialogue: 0,0:16:15.80,0:16:20.00,Default,,0000,0000,0000,,Мен юката сатып алған кезде жасадым.
Dialogue: 0,0:16:15.80,0:16:20.00,Default,,0000,0000,0000,,Бұл қандай үй?
Dialogue: 0,0:16:27.98,0:16:30.49,Default,,0000,0000,0000,,Такояки, грильдегі кальмар, алма кәмпит!
Dialogue: 0,0:16:30.49,0:16:32.82,Default,,0000,0000,0000,,Ас ішейік, жейміз, жейміз!
Dialogue: 0,0:16:32.82,0:16:35.82,Default,,0000,0000,0000,,Мүлдем дұрыс емес
Dialogue: 0,0:16:32.82,0:16:35.82,Default,,0000,0000,0000,,Лотереяны да ойнап көріңіз!
Dialogue: 0,0:16:35.82,0:16:39.16,Default,,0000,0000,0000,,Пайдасыз
Dialogue: 0,0:16:35.82,0:16:39.16,Default,,0000,0000,0000,,Біз де йо-йо шарымен балық аулаймыз!
Dialogue: 0,0:16:39.16,0:16:41.66,Default,,0000,0000,0000,,Тек көңіл көтеру үшін ештеңе жасауға тырыспаңыз!
Dialogue: 0,0:16:41.66,0:16:43.67,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:16:43.67,0:16:46.33,Default,,0000,0000,0000,,Уау, тасбақа шегелеп жатыр.
Dialogue: 0,0:16:46.33,0:16:50.00,Default,,0000,0000,0000,,Өте сүйкімді.
Dialogue: 0,0:16:46.33,0:16:50.00,Default,,0000,0000,0000,,әр сессияға 300 иен!
Dialogue: 0,0:16:50.00,0:16:53.00,Default,,0000,0000,0000,,Ой, не істеуім керек?
Dialogue: 0,0:16:55.18,0:16:59.51,Default,,0000,0000,0000,,Бірақ егер сіз бұл туралы сабырмен ойласаңыз,
Dialogue: 0,0:16:55.18,0:16:59.51,Default,,0000,0000,0000,,Маған тасбақа керек емес.
Dialogue: 0,0:16:59.51,0:17:01.45,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:17:01.45,0:17:06.29,Default,,0000,0000,0000,,Өте сүйкімді.
Dialogue: 0,0:17:01.45,0:17:06.29,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:17:06.29,0:17:08.29,Default,,0000,0000,0000,,А, бұл...
Dialogue: 0,0:17:08.29,0:17:10.49,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:12.46,0:17:14.96,Default,,0000,0000,0000,,Бұл 10 ату үшін 200 иен.
Dialogue: 0,0:17:14.96,0:17:23.14,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:17:23.14,0:17:26.81,Default,,0000,0000,0000,,Әй, солай істе, Сақаки! Ат!
Dialogue: 0,0:17:26.81,0:17:28.81,Default,,0000,0000,0000,,Әй, қандай ұят!
Dialogue: 0,0:17:28.81,0:17:30.81,Default,,0000,0000,0000,,Ах~ сәл оңға қарай!
Dialogue: 0,0:17:30.81,0:17:32.81,Default,,0000,0000,0000,,А, мен дұрыс түсіндім!
Dialogue: 0,0:17:32.81,0:17:34.98,Default,,0000,0000,0000,,Айо Құттықтаймыз.
Dialogue: 0,0:17:34.98,0:17:37.65,Default,,0000,0000,0000,,Жарайсың Сакаки! Күткендей!
Dialogue: 0,0:17:37.65,0:17:40.49,Default,,0000,0000,0000,,Мен мысықты атып өлтірдім!
Dialogue: 0,0:17:37.65,0:17:40.49,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:17:40.49,0:17:43.09,Default,,0000,0000,0000,,Әй, аңшы! Мерген!
Dialogue: 0,0:17:45.33,0:17:47.63,Default,,0000,0000,0000,,《Өлі емес... Өлі емес...! 》
Dialogue: 0,0:17:50.00,0:17:52.50,Default,,0000,0000,0000,,Мен жалғыз қалдым ба?
Dialogue: 0,0:17:52.50,0:17:56.00,Default,,0000,0000,0000,,Иә, онда.
Dialogue: 0,0:17:52.50,0:17:56.00,Default,,0000,0000,0000,,Жарықты сөндіретін уақыт таяп қалды.
Dialogue: 0,0:17:56.00,0:17:58.51,Default,,0000,0000,0000,,Түн енді ғана басталып жатыр!
Dialogue: 0,0:17:58.51,0:18:02.61,Default,,0000,0000,0000,,Жоқ, мұндай кезде
Dialogue: 0,0:17:58.51,0:18:02.61,Default,,0000,0000,0000,,Ерте ұйықтап, ерте тұрған дұрыс➡
Dialogue: 0,0:18:02.61,0:18:05.28,Default,,0000,0000,0000,,Күндер ұзағырақ сияқты.
Dialogue: 0,0:18:05.28,0:18:07.28,Default,,0000,0000,0000,,О, солай.
Dialogue: 0,0:18:05.28,0:18:07.28,Default,,0000,0000,0000,,Мүмкін көзілдірік дұрыс шығар!
Dialogue: 0,0:18:07.28,0:18:09.28,Default,,0000,0000,0000,,Көзілдірік...?
Dialogue: 0,0:18:09.28,0:18:12.12,Default,,0000,0000,0000,,Жоқ, бірақ
Dialogue: 0,0:18:09.28,0:18:12.12,Default,,0000,0000,0000,,Өйткені саяхаттың керемет дәмі➡
Dialogue: 0,0:18:12.12,0:18:14.29,Default,,0000,0000,0000,,Оны түнгі үкі дейді.
Dialogue: 0,0:18:14.29,0:18:18.63,Default,,0000,0000,0000,,Ах! Бұл жігіт бірінші өзі төсекке жатады
Dialogue: 0,0:18:14.29,0:18:18.63,Default,,0000,0000,0000,,Сіз пайда табуға бел байладыңыз!
Dialogue: 0,0:18:18.63,0:18:21.96,Default,,0000,0000,0000,,Мен сені кешіре алмаймын!
Dialogue: 0,0:18:18.63,0:18:21.96,Default,,0000,0000,0000,,Жоқ, өйткені мен 11 жастамын...
Dialogue: 0,0:18:21.96,0:18:25.30,Default,,0000,0000,0000,,Өте тітіркендіргіш! Сұрақтар қойылмаған!
Dialogue: 0,0:18:25.30,0:18:27.30,Default,,0000,0000,0000,,Күрсін.
Dialogue: 0,0:18:29.80,0:18:31.81,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:18:31.81,0:18:35.64,Default,,0000,0000,0000,,перде артындағы бөлме – священник кіретін бөлме екенін
Dialogue: 0,0:18:31.81,0:18:35.64,Default,,0000,0000,0000,,Эй, сен...
Dialogue: 0,0:18:35.64,0:18:38.81,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:18:35.64,0:18:38.81,Default,,0000,0000,0000,,Бәріміз ұйықтайық.
Dialogue: 0,0:18:38.81,0:18:41.32,Default,,0000,0000,0000,,Ал, күте тұрыңыз.
Dialogue: 0,0:18:41.32,0:18:44.15,Default,,0000,0000,0000,,Бүгінгі күн туралы
Dialogue: 0,0:18:41.32,0:18:44.15,Default,,0000,0000,0000,,Тек Муикёу деп айту дұрыс емес пе?
Dialogue: 0,0:18:44.15,0:18:46.99,Default,,0000,0000,0000,,Ой! Күткендей, Юкарин оқиғаны түсінеді!
Dialogue: 0,0:18:46.99,0:18:49.66,Default,,0000,0000,0000,,Дұрыс. Бүгінгі күн жақсы ма?
Dialogue: 0,0:18:49.66,0:18:51.99,Default,,0000,0000,0000,,Иә! Нямо-чан, сәлем!
Dialogue: 0,0:18:51.99,0:18:54.00,Default,,0000,0000,0000,,Олай болса, сау болыңыз!
Dialogue: 0,0:18:54.00,0:18:56.50,Default,,0000,0000,0000,,Бұл жақсы емес!
Dialogue: 0,0:18:54.00,0:18:56.50,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:18:56.50,0:18:59.50,Default,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:18:56.50,0:18:59.50,Default,,0000,0000,0000,,Оны қайдан алдың?
Dialogue: 0,0:18:59.50,0:19:03.27,Default,,0000,0000,0000,,Мен көмектесе алмаймын.
Dialogue: 0,0:18:59.50,0:19:03.27,Default,,0000,0000,0000,,Мен мұның бәрін жоямын.
Dialogue: 0,0:19:03.27,0:19:05.27,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:19:03.27,0:19:05.27,Default,,0000,0000,0000,,Хаааах! Гүх!
Dialogue: 0,0:19:07.28,0:19:09.28,Default,,0000,0000,0000,,Бірақ бұл жақсы.
Dialogue: 0,0:19:09.28,0:19:11.45,Default,,0000,0000,0000,,Негізі мен саке алып келдім!
Dialogue: 0,0:19:11.45,0:19:13.45,Default,,0000,0000,0000,,Бұл аздап жаман емес пе!
Dialogue: 0,0:19:13.45,0:19:16.28,Default,,0000,0000,0000,,《Егер мен Юкариге бәрін ішуге рұқсат етсем
Dialogue: 0,0:19:13.45,0:19:16.28,Default,,0000,0000,0000,,Өте жаман...
Dialogue: 0,0:19:16.28,0:19:18.62,Default,,0000,0000,0000,,Мен мұнда ішуім керек...! 》
Dialogue: 0,0:19:18.62,0:19:20.62,Default,,0000,0000,0000,,Хамф!
Dialogue: 0,0:19:18.62,0:19:20.62,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:19:20.62,0:19:22.62,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:19:25.13,0:19:28.63,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:19:31.47,0:19:34.97,Default,,0000,0000,0000,,Ммммммммммм!
Dialogue: 0,0:19:34.97,0:19:37.81,Default,,0000,0000,0000,,Мынау не деген жігіт?
Dialogue: 0,0:19:37.81,0:19:41.48,Default,,0000,0000,0000,,Тіпті бір адам болса да жақсы! Ахахха!
Dialogue: 0,0:19:41.48,0:19:43.64,Default,,0000,0000,0000,,Жоқ, мен мас болдым...
Dialogue: 0,0:19:43.64,0:19:45.81,Default,,0000,0000,0000,,Міне, солай.
Dialogue: 0,0:19:43.64,0:19:45.81,Default,,0000,0000,0000,,Қызық көрінеді!
Dialogue: 0,0:19:45.81,0:19:47.82,Default,,0000,0000,0000,,Мен... көремін?
Dialogue: 0,0:19:47.82,0:19:51.49,Default,,0000,0000,0000,,Амансың ба?
Dialogue: 0,0:19:47.82,0:19:51.49,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:19:51.49,0:19:54.16,Default,,0000,0000,0000,,Тыныш!
Dialogue: 0,0:19:51.49,0:19:54.16,Default,,0000,0000,0000,,Кочитора ересек адам!
Dialogue: 0,0:19:54.16,0:19:57.49,Default,,0000,0000,0000,,Иә, сэр!
Dialogue: 0,0:19:54.16,0:19:57.49,Default,,0000,0000,0000,,Бұл не, Чи?
Dialogue: 0,0:19:57.49,0:20:01.00,Default,,0000,0000,0000,,Үлкендердің қарым-қатынасына келгенде
Dialogue: 0,0:19:57.49,0:20:01.00,Default,,0000,0000,0000,,Бұл шынымен эротикалық ма?
Dialogue: 0,0:20:01.00,0:20:03.66,Default,,0000,0000,0000,,О, сондай эротикалық!
Dialogue: 0,0:20:03.66,0:20:08.17,Default,,0000,0000,0000,,О! мысалы! ?
Dialogue: 0,0:20:03.66,0:20:08.17,Default,,0000,0000,0000,,Мысалы...
Dialogue: 0,0:20:08.17,0:20:25.02,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:20:25.02,0:20:27.69,Default,,0000,0000,0000,,Ахахха Ахахха!
Dialogue: 0,0:20:27.69,0:20:35.86,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:20:35.86,0:20:38.87,Default,,0000,0000,0000,,Иә? мм...
Dialogue: 0,0:20:35.86,0:20:38.87,Default,,0000,0000,0000,,Енді нені білдіреді...?
Dialogue: 0,0:20:38.87,0:20:41.20,Default,,0000,0000,0000,,Тынш~ Тыныштық және тыңдау уақыты келді.
Dialogue: 0,0:20:41.20,0:20:44.04,Default,,0000,0000,0000,,Өскенде түсінерсің.
Dialogue: 0,0:20:44.04,0:20:46.87,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:20:46.87,0:20:49.88,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:20:49.88,0:20:51.88,Default,,0000,0000,0000,,Нуа~.
Dialogue: 0,0:20:51.88,0:20:55.38,Default,,0000,0000,0000,,Менің басым ауырып тұр~ Бірақ неге~?
Dialogue: 0,0:20:55.38,0:20:58.39,Default,,0000,0000,0000,,Ах, қайырлы таң, Сакаки-сан.
Dialogue: 0,0:20:55.38,0:20:58.39,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:20:58.39,0:21:01.49,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:58.39,0:21:01.49,Default,,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:21:01.49,0:21:05.33,Default,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:21:01.49,0:21:05.33,Default,,0000,0000,0000,,Амансың ба?
Dialogue: 0,0:21:05.33,0:21:09.66,Default,,0000,0000,0000,,Аа, мұғалім менің сұрағым бар.
Dialogue: 0,0:21:05.33,0:21:09.66,Default,,0000,0000,0000,,Оны ұмытып қалдың ба?
Dialogue: 0,0:21:09.66,0:21:15.00,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:15.00,0:21:19.01,Default,,0000,0000,0000,,Хмм... уф!
Dialogue: 0,0:21:19.01,0:21:21.51,Default,,0000,0000,0000,,нені білдіреді?
Dialogue: 0,0:21:21.51,0:21:24.51,Default,,0000,0000,0000,,Чио-чан!
Dialogue: 0,0:21:21.51,0:21:24.51,Default,,0000,0000,0000,,Мұны қайдан білдіңіз? ?
Dialogue: 0,0:21:24.51,0:21:27.85,Default,,0000,0000,0000,,Бұл сенсің, сен.
Dialogue: 0,0:21:24.51,0:21:27.85,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:21:27.85,0:21:31.19,Default,,0000,0000,0000,,Қайырлы таң, Куросава Сенсей!
Dialogue: 0,0:21:27.85,0:21:31.19,Default,,0000,0000,0000,,Иә! ?
Dialogue: 0,0:21:31.19,0:21:33.35,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:21:33.35,0:21:35.36,Default,,0000,0000,0000,,Мен көп нәрсені білдім!
Dialogue: 0,0:21:35.36,0:21:39.03,Default,,0000,0000,0000,,Ұстаз, мен сізді құрметтеймін!
Dialogue: 0,0:21:35.36,0:21:39.03,Default,,0000,0000,0000,,Сізге көп рахмет!
Dialogue: 0,0:21:39.03,0:21:41.86,Default,,0000,0000,0000,,Не? Ей, не айтып тұрсың! ?
Dialogue: 0,0:21:41.86,0:21:44.03,Default,,0000,0000,0000,,Сенің басыңа түскен қарғыс—
Dialogue: 0,0:21:44.03,0:21:47.20,Default,,0000,0000,0000,,Әй, мен не істедім? ?
Dialogue: 0,0:21:47.20,0:21:50.60,Default,,0000,0000,0000,,Айтыңызшы!
Dialogue: 0,0:21:52.10,0:21:58.10,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory