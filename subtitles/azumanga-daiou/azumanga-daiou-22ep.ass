Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:30.19,0:01:37.86,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:01:37.86,0:01:40.16,Default,,0000,0000,0000,,Жаз мезгілі.
Dialogue: 0,0:01:42.20,0:01:44.20,Default,,0000,0000,0000,,Күрсін.
Dialogue: 0,0:01:44.20,0:01:46.20,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:01:46.20,0:01:48.20,Default,,0000,0000,0000,,Хмм, бұл не...?
Dialogue: 0,0:01:50.54,0:01:53.88,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:01:50.54,0:01:53.88,Default,,0000,0000,0000,,Өртенген...
Dialogue: 0,0:01:53.88,0:01:55.88,Default,,0000,0000,0000,,Осыншама күйіп кетсе➡
Dialogue: 0,0:01:55.88,0:01:59.38,Default,,0000,0000,0000,,Ол қанша уақыт жанады?
Dialogue: 0,0:01:55.88,0:01:59.38,Default,,0000,0000,0000,,Мен түсінбеймін.
Dialogue: 0,0:01:59.38,0:02:02.15,Default,,0000,0000,0000,,Аа, солай.
Dialogue: 0,0:02:06.99,0:02:09.83,Default,,0000,0000,0000,,Купальник түрі және...
Dialogue: 0,0:02:09.83,0:02:12.50,Default,,0000,0000,0000,,Егер бұл орын алса
Dialogue: 0,0:02:09.83,0:02:12.50,Default,,0000,0000,0000,,Егер сіз бассейнге ештеңе кимей кірсеңіз де➡
Dialogue: 0,0:02:12.50,0:02:15.33,Default,,0000,0000,0000,,Ешкім байқамайтын сияқты.
Dialogue: 0,0:02:12.50,0:02:15.33,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:02:15.33,0:02:17.33,Default,,0000,0000,0000,,Кагура Оны қарсылас ретінде қабылдамаңыз.
Dialogue: 0,0:02:21.34,0:02:24.84,Default,,0000,0000,0000,,Күн ыстық! Жаз келді!
Dialogue: 0,0:02:21.34,0:02:24.84,Default,,0000,0000,0000,,Жаз туралы айтасыз ба?
Dialogue: 0,0:02:24.84,0:02:28.01,Default,,0000,0000,0000,,Ертең басталатын жазғы демалысыңызды жақсы өткізіңіз!
Dialogue: 0,0:02:28.01,0:02:30.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:02:30.01,0:02:33.85,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:02:30.01,0:02:33.85,Default,,0000,0000,0000,,Жазғы демалыс - бұл дәстүр!
Dialogue: 0,0:02:33.85,0:02:35.85,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:02:39.86,0:02:42.53,Default,,0000,0000,0000,,Биыл да Чиёчанчи вилласында
Dialogue: 0,0:02:39.86,0:02:42.53,Default,,0000,0000,0000,,Сіз баруға дайынсыз ба?
Dialogue: 0,0:02:42.53,0:02:44.86,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:02:42.53,0:02:44.86,Default,,0000,0000,0000,,Қабылдау емтихандарына оқитындардың барлығы➡
Dialogue: 0,0:02:44.86,0:02:47.36,Default,,0000,0000,0000,,Бос емессіз бе?
Dialogue: 0,0:02:51.70,0:02:53.70,Default,,0000,0000,0000,,Нану?
Dialogue: 0,0:02:53.70,0:02:56.71,Default,,0000,0000,0000,,Олай болса қабылдау емтиханы оқу лагерін өткізейік!
Dialogue: 0,0:02:56.71,0:02:59.04,Default,,0000,0000,0000,,Қаланың күйбең тірлігінен алыс
Dialogue: 0,0:02:56.71,0:02:59.04,Default,,0000,0000,0000,,Тыныш жерде➡
Dialogue: 0,0:02:59.04,0:03:00.98,Default,,0000,0000,0000,,Бар назарымызды оқуға аударайық!
Dialogue: 0,0:03:00.98,0:03:03.48,Default,,0000,0000,0000,,О, бұл тамаша!
Dialogue: 0,0:03:03.48,0:03:05.48,Default,,0000,0000,0000,,Эхехе.
Dialogue: 0,0:03:05.48,0:03:07.98,Default,,0000,0000,0000,,Чио-чан, алданба.
Dialogue: 0,0:03:12.32,0:03:14.49,Default,,0000,0000,0000,,Хехехе….
Dialogue: 0,0:03:14.49,0:03:18.49,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:03:23.33,0:03:25.33,Default,,0000,0000,0000,,Yaho!
Dialogue: 0,0:03:25.33,0:03:28.17,Default,,0000,0000,0000,,Барлығыңыз, біз сізді күттік!
Dialogue: 0,0:03:28.17,0:03:31.67,Default,,0000,0000,0000,,Бұл жолы Каорин бірінші рет қатысып отыр!
Dialogue: 0,0:03:31.67,0:03:33.68,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:03:33.68,0:03:35.68,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:03:35.68,0:03:38.51,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:03:38.51,0:03:40.51,Default,,0000,0000,0000,,Ум...
Dialogue: 0,0:03:44.02,0:03:48.02,Default,,0000,0000,0000,,Мен Изуку Мидориямын!
Dialogue: 0,0:03:44.02,0:03:48.02,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:03:48.02,0:03:51.69,Default,,0000,0000,0000,,Бір-екі адам ғана...!
Dialogue: 0,0:03:48.02,0:03:51.69,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:03:51.69,0:03:55.53,Default,,0000,0000,0000,,Сонымен
Dialogue: 0,0:03:51.69,0:03:55.53,Default,,0000,0000,0000,,Биыл барлығы 9 адам.
Dialogue: 0,0:03:55.53,0:03:58.20,Default,,0000,0000,0000,,Мен екі көлікке мінуді шештім...
Dialogue: 0,0:03:58.20,0:04:00.14,Default,,0000,0000,0000,,Тоғыз адам?
Dialogue: 0,0:04:00.14,0:04:02.81,Default,,0000,0000,0000,,Екі бірлік...
Dialogue: 0,0:04:02.81,0:04:06.14,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:04:02.81,0:04:06.14,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:04:06.14,0:04:08.14,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:04:18.32,0:04:25.16,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:04:25.16,0:04:27.83,Default,,0000,0000,0000,,Юкари көлігі….
Dialogue: 0,0:04:27.83,0:04:29.83,Default,,0000,0000,0000,,Ең ауыр жарақат алған – Зенитсу-сан
Dialogue: 0,0:04:29.83,0:04:31.83,Default,,0000,0000,0000,,Бұл кеше болды
Dialogue: 0,0:04:29.83,0:04:31.83,Default,,0000,0000,0000,,Чийо-чан мінеді➡
Dialogue: 0,0:04:31.83,0:04:33.84,Default,,0000,0000,0000,,Психикалық жарам бар дейсің.
Dialogue: 0,0:04:33.84,0:04:35.84,Default,,0000,0000,0000,,Бұл менің жанымды ауыртады! ?
Dialogue: 0,0:04:35.84,0:04:37.84,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:04:37.84,0:04:42.51,Default,,0000,0000,0000,,Ах! Чиё Чан
Dialogue: 0,0:04:37.84,0:04:42.51,Default,,0000,0000,0000,,Қазір доктор Нямоның көлігінде!
Dialogue: 0,0:04:42.51,0:04:45.51,Default,,0000,0000,0000,,Сіз қандай көлік жүргізесіз...?
Dialogue: 0,0:04:45.51,0:04:47.52,Default,,0000,0000,0000,,Мен не істеуім керек...?
Dialogue: 0,0:04:47.52,0:04:51.69,Default,,0000,0000,0000,,Юкари Сенсэй деген кім?
Dialogue: 0,0:04:47.52,0:04:51.69,Default,,0000,0000,0000,,Сіз оны міне алмайсыз ба?
Dialogue: 0,0:04:51.69,0:04:54.02,Default,,0000,0000,0000,,Ал, Чиё-чаннан басқа...
Dialogue: 0,0:04:54.02,0:04:56.03,Default,,0000,0000,0000,,Няхахаха.
Dialogue: 0,0:04:56.03,0:05:00.46,Default,,0000,0000,0000,,Уау, мен көлікті жақсы меңгермеймін.
Dialogue: 0,0:04:56.03,0:05:00.46,Default,,0000,0000,0000,,Мүмкін болса...
Dialogue: 0,0:05:00.46,0:05:02.46,Default,,0000,0000,0000,,Онда мен мінемін.
Dialogue: 0,0:05:02.46,0:05:04.47,Default,,0000,0000,0000,,О.
Dialogue: 0,0:05:02.46,0:05:04.47,Default,,0000,0000,0000,,О...! ?
Dialogue: 0,0:05:04.47,0:05:06.64,Default,,0000,0000,0000,,Эй, мен сені ертіп барамын!
Dialogue: 0,0:05:04.47,0:05:06.64,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:06.64,0:05:08.64,Default,,0000,0000,0000,,Салқын.
Dialogue: 0,0:05:08.64,0:05:11.64,Default,,0000,0000,0000,,Онда жүр~ Юкари-чан!
Dialogue: 0,0:05:11.64,0:05:13.64,Default,,0000,0000,0000,,О!
Dialogue: 0,0:05:13.64,0:05:19.15,Default,,0000,0000,0000,,Шыу!
Dialogue: 0,0:05:19.15,0:05:21.15,Default,,0000,0000,0000,,Жер бетінде не болып жатыр! ?
Dialogue: 0,0:05:21.15,0:05:23.15,Default,,0000,0000,0000,,Бұл қорқынышты...
Dialogue: 0,0:05:23.15,0:05:25.15,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:05:23.15,0:05:25.15,Default,,0000,0000,0000,,Не, не! ?
Dialogue: 0,0:05:27.16,0:05:29.99,Default,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:05:27.16,0:05:29.99,Default,,0000,0000,0000,,Бұл менің сөмкемде болды.
Dialogue: 0,0:05:29.99,0:05:32.16,Default,,0000,0000,0000,,Жоқ, Юкари-чан.
Dialogue: 0,0:05:32.16,0:05:35.00,Default,,0000,0000,0000,,Эхехехе.
Dialogue: 0,0:05:32.16,0:05:35.00,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:05:35.00,0:05:38.00,Default,,0000,0000,0000,,Барыңыз~ Юкари-чан!
Dialogue: 0,0:05:35.00,0:05:38.00,Default,,0000,0000,0000,,О!
Dialogue: 0,0:05:40.34,0:05:43.17,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:05:40.34,0:05:43.17,Default,,0000,0000,0000,,Нямо көлігін басып озыңыз!
Dialogue: 0,0:05:43.17,0:05:45.17,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:05:45.17,0:05:50.85,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:05:50.85,0:05:53.68,Default,,0000,0000,0000,,Ах~.
Dialogue: 0,0:05:53.68,0:05:56.52,Default,,0000,0000,0000,,Хехехе біртүрлі дауыс.
Dialogue: 0,0:05:56.52,0:05:59.82,Default,,0000,0000,0000,,Иә? Ах~.
Dialogue: 0,0:05:56.52,0:05:59.82,Default,,0000,0000,0000,,(көлік дыбысы)
Dialogue: 0,0:06:01.96,0:06:03.96,Default,,0000,0000,0000,,Әй, сен неге тоқтап тұрсың?
Dialogue: 0,0:06:03.96,0:06:06.13,Default,,0000,0000,0000,,Ба-ка-ба-ка!
Dialogue: 0,0:06:06.13,0:06:08.30,Default,,0000,0000,0000,,Қызыл!
Dialogue: 0,0:06:06.13,0:06:08.30,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:08.30,0:06:10.30,Default,,0000,0000,0000,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:06:10.30,0:06:12.97,Default,,0000,0000,0000,,О~ Мен ұшамын~.
Dialogue: 0,0:06:12.97,0:06:16.14,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:06:16.14,0:06:18.64,Default,,0000,0000,0000,,Аман-есен жеттік!
Dialogue: 0,0:06:18.64,0:06:20.64,Default,,0000,0000,0000,,Ия, келдік, жеттік!
Dialogue: 0,0:06:20.64,0:06:22.64,Default,,0000,0000,0000,,А, келдің.
Dialogue: 0,0:06:26.15,0:06:28.15,Default,,0000,0000,0000,,Амансың ба...?
Dialogue: 0,0:06:28.15,0:06:30.15,Default,,0000,0000,0000,,Ролик костер бұл➡
Dialogue: 0,0:06:30.15,0:06:33.99,Default,,0000,0000,0000,,Апат болмаған жерде
Dialogue: 0,0:06:30.15,0:06:33.99,Default,,0000,0000,0000,,Бұл жақсы...
Dialogue: 0,0:06:33.99,0:06:35.99,Default,,0000,0000,0000,,Хе хе хе.
Dialogue: 0,0:06:35.99,0:06:37.99,Default,,0000,0000,0000,,О.
Dialogue: 0,0:06:37.99,0:06:40.00,Default,,0000,0000,0000,,Бүйірлік айна Ол әлі бүктелген.
Dialogue: 0,0:06:40.00,0:06:42.50,Default,,0000,0000,0000,,Уау! Ахх...
Dialogue: 0,0:06:42.50,0:06:45.67,Default,,0000,0000,0000,,is ~ алаңсыз ~.
Dialogue: 0,0:06:45.67,0:06:47.67,Default,,0000,0000,0000,,《Теңізге келу➡
Dialogue: 0,0:06:47.67,0:06:50.51,Default,,0000,0000,0000,,Соншалықты
Dialogue: 0,0:06:47.67,0:06:50.51,Default,,0000,0000,0000,,Оның соншалықты ауырғанына сене алар емеспін...》
Dialogue: 0,0:06:50.51,0:06:52.51,Default,,0000,0000,0000,,Ия, келдік, жеттік!
Dialogue: 0,0:06:52.51,0:06:55.18,Default,,0000,0000,0000,,Иә, иә, келдік.
Dialogue: 0,0:06:55.18,0:06:59.01,Default,,0000,0000,0000,,Олай болса барлығына
Dialogue: 0,0:06:55.18,0:06:59.01,Default,,0000,0000,0000,,Тыныс алған соң...
Dialogue: 0,0:06:59.01,0:07:01.95,Default,,0000,0000,0000,,Теңізге барайық!
Dialogue: 0,0:06:59.01,0:07:01.95,Default,,0000,0000,0000,,Не, бұл теңіз! ?
Dialogue: 0,0:07:01.95,0:07:05.79,Default,,0000,0000,0000,,Мен бастауыш сынып оқушысы емеспін.
Dialogue: 0,0:07:01.95,0:07:05.79,Default,,0000,0000,0000,,Астынан купальник кимеңіз.
Dialogue: 0,0:07:05.79,0:07:08.59,Default,,0000,0000,0000,,Бұл жолы
Dialogue: 0,0:07:05.79,0:07:08.59,Default,,0000,0000,0000,,Бұл оқу лагері емес пе?
Dialogue: 0,0:07:10.79,0:07:13.29,Default,,0000,0000,0000,,Бұл өтірік.
Dialogue: 0,0:07:10.79,0:07:13.29,Default,,0000,0000,0000,,О, бұл оңай! ?
Dialogue: 0,0:07:15.46,0:07:17.46,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:21.97,0:07:23.97,Default,,0000,0000,0000,,Жоқ?
Dialogue: 0,0:07:30.48,0:07:34.48,Default,,0000,0000,0000,,～～
Dialogue: 0,0:07:30.48,0:07:34.48,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:07:34.48,0:07:36.82,Default,,0000,0000,0000,,Иә! Бұл теңіз! Бұл теңіз!
Dialogue: 0,0:07:36.82,0:07:38.82,Default,,0000,0000,0000,,Иә, иә, бұл теңіз.
Dialogue: 0,0:07:38.82,0:07:40.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:40.99,0:07:43.66,Default,,0000,0000,0000,,１ ２ ３ ４➡
Dialogue: 0,0:07:43.66,0:07:46.66,Default,,0000,0000,0000,,５ ６ ７ ８。
Dialogue: 0,0:07:46.66,0:07:49.67,Default,,0000,0000,0000,,１ ２ ３ ４。
Dialogue: 0,0:07:49.67,0:07:51.67,Default,,0000,0000,0000,,Көлік ауруына байланысты теңізге шыға алмау➡
Dialogue: 0,0:07:51.67,0:07:56.17,Default,,0000,0000,0000,,Оның соншалықты ауыр екеніне сене алар емеспін...
Dialogue: 0,0:07:51.67,0:07:56.17,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:07:56.17,0:07:59.94,Default,,0000,0000,0000,,Хахаха хехехехе.
Dialogue: 0,0:07:59.94,0:08:02.78,Default,,0000,0000,0000,,Ача ача ачача.
Dialogue: 0,0:08:02.78,0:08:05.28,Default,,0000,0000,0000,,Aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa~.
Dialogue: 0,0:08:05.28,0:08:07.28,Default,,0000,0000,0000,,Ыстық...
Dialogue: 0,0:08:07.28,0:08:09.28,Default,,0000,0000,0000,,Бүгін сандал киюім керек➡
Dialogue: 0,0:08:09.28,0:08:11.95,Default,,0000,0000,0000,,Табаныңыз күйіп қалуы мүмкін.
Dialogue: 0,0:08:09.28,0:08:11.95,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:08:11.95,0:08:18.13,Default,,0000,0000,0000,,Ай!
Dialogue: 0,0:08:18.13,0:08:20.33,Default,,0000,0000,0000,,Ия, қарбыз, қарбыз!
Dialogue: 0,0:08:26.30,0:08:28.30,Default,,0000,0000,0000,,Иә...
Dialogue: 0,0:08:28.30,0:08:30.31,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:08:30.31,0:08:33.48,Default,,0000,0000,0000,,Шынымен! нақты сандар
Dialogue: 0,0:08:30.31,0:08:33.48,Default,,0000,0000,0000,,Мазасыздықтар.
Dialogue: 0,0:08:33.48,0:08:36.98,Default,,0000,0000,0000,,Мен де жақында.
Dialogue: 0,0:08:33.48,0:08:36.98,Default,,0000,0000,0000,,Бұл өсуде.
Dialogue: 0,0:08:36.98,0:08:39.78,Default,,0000,0000,0000,,Не, біз доспыз...?
Dialogue: 0,0:08:46.32,0:08:50.16,Default,,0000,0000,0000,,Әй, достарым...
Dialogue: 0,0:08:50.16,0:08:52.16,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:08:52.16,0:08:57.67,Default,,0000,0000,0000,,(дауыс ойнату)
Dialogue: 0,0:08:57.67,0:09:01.10,Default,,0000,0000,0000,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:08:57.67,0:09:01.10,Default,,0000,0000,0000,,Сабақ оқымай ойнау➡
Dialogue: 0,0:09:01.10,0:09:03.27,Default,,0000,0000,0000,,Бұл шынымен жақсы ма деп ойлаймын...
Dialogue: 0,0:09:03.27,0:09:06.11,Default,,0000,0000,0000,,Не дедіңіз!
Dialogue: 0,0:09:03.27,0:09:06.11,Default,,0000,0000,0000,,Кагура өте салмақты.
Dialogue: 0,0:09:06.11,0:09:08.11,Default,,0000,0000,0000,,Ойнауға болмайды!
Dialogue: 0,0:09:08.11,0:09:10.45,Default,,0000,0000,0000,,Бірақ ойнайық!
Dialogue: 0,0:09:10.45,0:09:12.61,Default,,0000,0000,0000,,Сіз кереметсіз...
Dialogue: 0,0:09:12.61,0:09:14.62,Default,,0000,0000,0000,,Сақ болу керек.
Dialogue: 0,0:09:12.61,0:09:14.62,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:14.62,0:09:16.79,Default,,0000,0000,0000,,Оқыған кезде зейінін оқуға аудар.
Dialogue: 0,0:09:16.79,0:09:19.29,Default,,0000,0000,0000,,Үзіліс кезінде назарыңызды үзіліске аударыңыз.
Dialogue: 0,0:09:19.29,0:09:22.96,Default,,0000,0000,0000,,Иә! Басқаша айтқанда, осы оқу-жаттығу жиынында көңіліңізден шыққанша ойнаңыз!
Dialogue: 0,0:09:22.96,0:09:26.80,Default,,0000,0000,0000,,Бұл дұрыс емес!
Dialogue: 0,0:09:22.96,0:09:26.80,Default,,0000,0000,0000,,Дұрыс, ойнама.
Dialogue: 0,0:09:26.80,0:09:29.30,Default,,0000,0000,0000,,Қараңызшы, оны сынып жетекшісі бекіткен!
Dialogue: 0,0:09:29.30,0:09:31.30,Default,,0000,0000,0000,,Оқысаң да
Dialogue: 0,0:09:29.30,0:09:31.30,Default,,0000,0000,0000,,Балалар, емтихан тапсырып жатырсыңдар➡
Dialogue: 0,0:09:31.30,0:09:34.14,Default,,0000,0000,0000,,Уақытында үлгере алмасаңыз...
Dialogue: 0,0:09:34.14,0:09:36.14,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:36.14,0:09:38.14,Default,,0000,0000,0000,,Солай ма...?
Dialogue: 0,0:09:40.14,0:09:42.48,Default,,0000,0000,0000,,Тамақ бергеніңіз үшін рахмет!
Dialogue: 0,0:09:42.48,0:09:44.98,Default,,0000,0000,0000,,is ~ алаңсыз ~.
Dialogue: 0,0:09:44.98,0:09:48.32,Default,,0000,0000,0000,,Сәлем бәріңе!
Dialogue: 0,0:09:44.98,0:09:48.32,Default,,0000,0000,0000,,Мен күріш жедім, сонда!
Dialogue: 0,0:09:48.32,0:09:50.32,Default,,0000,0000,0000,,Иә! Ұйықтап алайық! Ұйықтап алайық!
Dialogue: 0,0:09:50.32,0:09:52.32,Default,,0000,0000,0000,,Дұрыс, мен ұйықтауым керек.
Dialogue: 0,0:09:56.66,0:09:58.66,Default,,0000,0000,0000,,Жоқ...?
Dialogue: 0,0:09:56.66,0:09:58.66,Default,,0000,0000,0000,,Ихихи.
Dialogue: 0,0:10:01.66,0:10:04.50,Default,,0000,0000,0000,,Мен нені түсінбеймін
Dialogue: 0,0:10:01.66,0:10:04.50,Default,,0000,0000,0000,,Біреуден сұрауға болады.
Dialogue: 0,0:10:04.50,0:10:06.50,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:10:06.50,0:10:10.84,Default,,0000,0000,0000,,Мм... Сакаки-сан...
Dialogue: 0,0:10:06.50,0:10:10.84,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:10.84,0:10:12.84,Default,,0000,0000,0000,,Ум...
Dialogue: 0,0:10:12.84,0:10:15.01,Default,,0000,0000,0000,,Ия, оқы, оқы.
Dialogue: 0,0:10:15.01,0:10:18.01,Default,,0000,0000,0000,,Емтиханға әлі уақыт бар
Dialogue: 0,0:10:15.01,0:10:18.01,Default,,0000,0000,0000,,Уақытында жасаңыз!
Dialogue: 0,0:10:18.01,0:10:20.35,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:10:18.01,0:10:20.35,Default,,0000,0000,0000,,Екеуміз де шулы.
Dialogue: 0,0:10:20.35,0:10:23.35,Default,,0000,0000,0000,,Осакадан біраз үйренейік.
Dialogue: 0,0:10:23.35,0:10:27.19,Default,,0000,0000,0000,,Сіз шынымен де зейін қойып отырсыз.
Dialogue: 0,0:10:23.35,0:10:27.19,Default,,0000,0000,0000,,Бүгінгі Осака-сан...
Dialogue: 0,0:10:27.19,0:10:29.89,Default,,0000,0000,0000,,(Ұйқыға кеткен дыбыс)
Dialogue: 0,0:10:35.86,0:10:39.66,Default,,0000,0000,0000,,Чио-чан, маған осы жерден айт.
Dialogue: 0,0:10:35.86,0:10:39.66,Default,,0000,0000,0000,,Иә, иә….
Dialogue: 0,0:10:41.70,0:10:45.60,Default,,0000,0000,0000,,Коёми-чан, мына жерден айт.
Dialogue: 0,0:10:41.70,0:10:45.60,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:10:47.54,0:10:49.88,Default,,0000,0000,0000,,Юкари Сенсей Мұнда.
Dialogue: 0,0:10:49.88,0:10:52.38,Default,,0000,0000,0000,,Сіз шынымен ойланып жүрсіз бе?
Dialogue: 0,0:10:57.89,0:10:59.89,Default,,0000,0000,0000,,Осака мырза, сіз осылай киінсеңіз➡
Dialogue: 0,0:10:59.89,0:11:02.09,Default,,0000,0000,0000,,Мен қайтадан ұйықтаймын.
Dialogue: 0,0:11:08.66,0:11:10.67,Default,,0000,0000,0000,,Хехе….
Dialogue: 0,0:11:10.67,0:11:13.50,Default,,0000,0000,0000,,Мен нені түсінбеймін
Dialogue: 0,0:11:10.67,0:11:13.50,Default,,0000,0000,0000,,Біреуден сұрауға болады.
Dialogue: 0,0:11:13.50,0:11:15.50,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:11:15.50,0:11:18.01,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:11:18.01,0:11:20.51,Default,,0000,0000,0000,,Эй, міне.
Dialogue: 0,0:11:20.51,0:11:23.01,Default,,0000,0000,0000,,Ия, оқы, оқы.
Dialogue: 0,0:11:23.01,0:11:25.85,Default,,0000,0000,0000,,Юкари-чан, мына жерден айт.
Dialogue: 0,0:11:25.85,0:11:29.05,Default,,0000,0000,0000,,Нені түсінбеймін
Dialogue: 0,0:11:25.85,0:11:29.05,Default,,0000,0000,0000,,Біреуден сұрауға болады.
Dialogue: 0,0:11:31.02,0:11:33.02,Default,,0000,0000,0000,,Мұғалім, мына жерден айтыңызшы!
Dialogue: 0,0:11:33.02,0:11:35.36,Default,,0000,0000,0000,,Иә! ? О, мен! ?
Dialogue: 0,0:11:35.36,0:11:37.69,Default,,0000,0000,0000,,Математика...?
Dialogue: 0,0:11:37.69,0:11:40.59,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:11:44.37,0:11:46.37,Default,,0000,0000,0000,,Не!
Dialogue: 0,0:11:46.37,0:11:48.37,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:11:48.37,0:11:52.21,Default,,0000,0000,0000,,Мен не айта аламын...?
Dialogue: 0,0:11:52.21,0:11:55.04,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:11:52.21,0:11:55.04,Default,,0000,0000,0000,,Иә, иә! бұл!
Dialogue: 0,0:11:55.04,0:11:57.71,Default,,0000,0000,0000,,Читчиянен….
Dialogue: 0,0:11:57.71,0:12:02.15,Default,,0000,0000,0000,,Читчия… чияунен….
Dialogue: 0,0:12:02.15,0:12:05.65,Default,,0000,0000,0000,,Читчия чияу….
Dialogue: 0,0:12:05.65,0:12:08.99,Default,,0000,0000,0000,,Сондықтан
Dialogue: 0,0:12:05.65,0:12:08.99,Default,,0000,0000,0000,,Студент кезімде қолымнан келді!
Dialogue: 0,0:12:08.99,0:12:11.66,Default,,0000,0000,0000,,Хо, шынымен, шынымен!
Dialogue: 0,0:12:08.99,0:12:11.66,Default,,0000,0000,0000,,Бұл шын мәнінде қандай?
Dialogue: 0,0:12:11.66,0:12:13.66,Default,,0000,0000,0000,,Сонда сіз түсінбейсіз бе?
Dialogue: 0,0:12:11.66,0:12:13.66,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:16.16,0:12:19.00,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:12:19.00,0:12:21.00,Default,,0000,0000,0000,,Міне...
Dialogue: 0,0:12:23.00,0:12:25.51,Default,,0000,0000,0000,,Джин мен білмеймін...
Dialogue: 0,0:12:25.51,0:12:29.34,Default,,0000,0000,0000,,Иә, иә, өйткені мен дене шынықтыру пәнінің мұғалімімін.
Dialogue: 0,0:12:25.51,0:12:29.34,Default,,0000,0000,0000,,Мені ақымақ болғаным үшін кешіріңіз!
Dialogue: 0,0:12:29.34,0:12:31.51,Default,,0000,0000,0000,,Тч, жоқ! Мен де...!
Dialogue: 0,0:12:31.51,0:12:35.35,Default,,0000,0000,0000,,Ｉｔ’ｓ ｓａｉｄ ｔｈａｔ
Dialogue: 0,0:12:31.51,0:12:35.35,Default,,0000,0000,0000,,ｍｏｓｔ Ｊａｐａｎｅｓｅ ｈａｖｅ➡
Dialogue: 0,0:12:35.35,0:12:37.52,Default,,0000,0000,0000,,ｕｎｉｑｕｅ ｃｈａｒａｃｔｅｒ ｏｆ ｓｈａｍｅ．
Dialogue: 0,0:12:35.35,0:12:37.52,Default,,0000,0000,0000,,Ахх...
Dialogue: 0,0:12:37.52,0:12:41.02,Default,,0000,0000,0000,,Ｉ ｌｉｋｅ ｔｈａｔ ｃｈａｒａｃｔｅｒ
Dialogue: 0,0:12:37.52,0:12:41.02,Default,,0000,0000,0000,,ａｎｄ Ｉ’ｍ ｐｒｏｕｄ ｏｆ ｉｔ ｖｅｒｙ ｍｕｃｈ．
Dialogue: 0,0:12:41.02,0:12:43.19,Default,,0000,0000,0000,,Ｇｅｎｅｒａｌｌｙ，ｍｏｓｔ ｏｆ Ｊａｐａｎｅｓｅ…．
Dialogue: 0,0:12:43.19,0:12:45.36,Default,,0000,0000,0000,,Әй, бәрің, алданбаңдар!
Dialogue: 0,0:12:45.36,0:12:47.36,Default,,0000,0000,0000,,Ｉ ｔｈｉｎｋ ｔｈｉｓ
Dialogue: 0,0:12:45.36,0:12:47.36,Default,,0000,0000,0000,,ｎａｔｕｒｅ ｏｆ ｓｈａｍｅ ｐｒｅｖｅｎｔ…．
Dialogue: 0,0:12:47.36,0:12:50.03,Default,,0000,0000,0000,,Бұл адам ағылшын тілі мұғалімі.
Dialogue: 0,0:12:47.36,0:12:50.03,Default,,0000,0000,0000,,Бұл соншалықты керемет емес...!
Dialogue: 0,0:12:50.03,0:12:52.03,Default,,0000,0000,0000,,Юкари-чан жақсырақ...
Dialogue: 0,0:12:52.03,0:12:54.04,Default,,0000,0000,0000,,Ｂｅｃａｕｓｅ ｗｅ ｓｔｏｐ ｔｒｙｉｎｇ ｔｏ➡
Dialogue: 0,0:12:54.04,0:12:56.04,Default,,0000,0000,0000,,ｓｐｅａｋ Ｅｎｇｌｉｓｈ…．
Dialogue: 0,0:12:54.04,0:12:56.04,Default,,0000,0000,0000,,О, бұл тамаша...
Dialogue: 0,0:12:56.04,0:12:58.54,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:12:56.04,0:12:58.54,Default,,0000,0000,0000,,Барлығы, алданбаңдар!
Dialogue: 0,0:12:58.54,0:13:02.98,Default,,0000,0000,0000,,Алданбаңыз...!
Dialogue: 0,0:13:02.98,0:13:06.48,Default,,0000,0000,0000,,Аха Енді үзіліс алайық.
Dialogue: 0,0:13:06.48,0:13:09.15,Default,,0000,0000,0000,,Эй, эй, бәріңе
Dialogue: 0,0:13:06.48,0:13:09.15,Default,,0000,0000,0000,,Сіз көтере аласыз ба?
Dialogue: 0,0:13:09.15,0:13:11.65,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:13:11.65,0:13:14.16,Default,,0000,0000,0000,,Менің сабағымды не бұзып тұрсың?
Dialogue: 0,0:13:14.16,0:13:16.83,Default,,0000,0000,0000,,Ахх...
Dialogue: 0,0:13:16.83,0:13:19.53,Default,,0000,0000,0000,,Уааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:13:21.66,0:13:24.17,Default,,0000,0000,0000,,Хм! Сол қол
Dialogue: 0,0:13:24.17,0:13:26.37,Default,,0000,0000,0000,,Аа….
Dialogue: 0,0:13:31.84,0:13:34.68,Default,,0000,0000,0000,,А, анау... көтеру➡
Dialogue: 0,0:13:34.68,0:13:37.01,Default,,0000,0000,0000,,Айтыңызшы...
Dialogue: 0,0:13:37.01,0:13:41.02,Default,,0000,0000,0000,,Ештеңе етпейді, өзіңізді күштеп салудың қажеті жоқ...
Dialogue: 0,0:13:41.02,0:13:43.02,Default,,0000,0000,0000,,Иә, иә….
Dialogue: 0,0:13:45.02,0:13:48.19,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:13:48.19,0:13:51.36,Default,,0000,0000,0000,,Ммм….
Dialogue: 0,0:13:51.36,0:13:54.36,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:13:54.36,0:13:57.20,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:13:57.20,0:14:01.14,Default,,0000,0000,0000,,Аа~ Қазірдің өзінде таң болды...
Dialogue: 0,0:13:57.20,0:14:01.14,Default,,0000,0000,0000,,♬ (Радиогимнастика)
Dialogue: 0,0:14:01.14,0:14:05.64,Default,,0000,0000,0000,,Иә? Көрпені кім алды... иә?
Dialogue: 0,0:14:01.14,0:14:05.64,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:14:05.64,0:14:11.31,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:14:11.31,0:14:14.32,Default,,0000,0000,0000,,１ ２ ３ ４。
Dialogue: 0,0:14:11.31,0:14:14.32,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:14:14.32,0:14:16.82,Default,,0000,0000,0000,,５ ６ ７ ８。
Dialogue: 0,0:14:16.82,0:14:20.16,Default,,0000,0000,0000,,１ ２ ３ ４ ５…。
Dialogue: 0,0:14:20.16,0:14:22.49,Default,,0000,0000,0000,,《Мүлдем...
Dialogue: 0,0:14:20.16,0:14:22.49,Default,,0000,0000,0000,,Бұл бала бала сияқты ма?
Dialogue: 0,0:14:22.49,0:14:24.49,Default,,0000,0000,0000,,Бұл тітіркендіргіш пе...》
Dialogue: 0,0:14:26.83,0:14:30.17,Default,,0000,0000,0000,,Ах~
Dialogue: 0,0:14:26.83,0:14:30.17,Default,,0000,0000,0000,,Чио-чан, бұл не?
Dialogue: 0,0:14:30.17,0:14:32.83,Default,,0000,0000,0000,,Эхехе Бұл мөр кітап.
Dialogue: 0,0:14:32.83,0:14:35.17,Default,,0000,0000,0000,,Оны мен үшін Куросава мырза жасады.
Dialogue: 0,0:14:35.17,0:14:37.17,Default,,0000,0000,0000,,Таңертең радио жаттығуларын орындағаннан кейін➡
Dialogue: 0,0:14:37.17,0:14:41.01,Default,,0000,0000,0000,,Олар сізге мөр береді.
Dialogue: 0,0:14:37.17,0:14:41.01,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:14:41.01,0:14:43.01,Default,,0000,0000,0000,,Радиожаттығулар?
Dialogue: 0,0:14:41.01,0:14:43.01,Default,,0000,0000,0000,,Иә? Ха!
Dialogue: 0,0:14:45.51,0:14:48.85,Default,,0000,0000,0000,,《Күн сайын таңертең бір-бірден...》
Dialogue: 0,0:14:48.85,0:14:51.19,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:14:51.19,0:14:53.69,Default,,0000,0000,0000,,Сурет!
Dialogue: 0,0:14:51.19,0:14:53.69,Default,,0000,0000,0000,,Оны қалыпты күйде сақтаңыз.
Dialogue: 0,0:14:53.69,0:14:55.69,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:14:55.69,0:14:58.86,Default,,0000,0000,0000,,Релакс Релакс….
Dialogue: 0,0:14:55.69,0:14:58.86,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:14:58.86,0:15:01.30,Default,,0000,0000,0000,,Ірімшік!
Dialogue: 0,0:15:01.30,0:15:04.97,Default,,0000,0000,0000,,Мен… біраз ойланып алайын.
Dialogue: 0,0:15:04.97,0:15:06.97,Default,,0000,0000,0000,,Tsk!
Dialogue: 0,0:15:04.97,0:15:06.97,Default,,0000,0000,0000,,О!
Dialogue: 0,0:15:06.97,0:15:09.97,Default,,0000,0000,0000,,１ ２ ３ ４➡
Dialogue: 0,0:15:09.97,0:15:12.81,Default,,0000,0000,0000,,５ ６ ７ ８。
Dialogue: 0,0:15:12.81,0:15:16.48,Default,,0000,0000,0000,,１ ２ ３ ４ ５ ６…。
Dialogue: 0,0:15:16.48,0:15:18.48,Default,,0000,0000,0000,,Ерте тұру➡
Dialogue: 0,0:15:18.48,0:15:21.48,Default,,0000,0000,0000,,Соншалықты
Dialogue: 0,0:15:18.48,0:15:21.48,Default,,0000,0000,0000,,Қандай керемет нәрсе...
Dialogue: 0,0:15:21.48,0:15:23.65,Default,,0000,0000,0000,,５ ６ ７ ８。
Dialogue: 0,0:15:23.65,0:15:25.82,Default,,0000,0000,0000,,Ірімшік!
Dialogue: 0,0:15:25.82,0:15:28.16,Default,,0000,0000,0000,,(Жедел жәрдем сигналы)
Dialogue: 0,0:15:28.16,0:15:30.16,Default,,0000,0000,0000,,Tsk!
Dialogue: 0,0:15:28.16,0:15:30.16,Default,,0000,0000,0000,,Онда мен бүгінге кетемін.
Dialogue: 0,0:15:30.16,0:15:32.16,Default,,0000,0000,0000,,Кяа~!
Dialogue: 0,0:15:32.16,0:15:34.83,Default,,0000,0000,0000,,О~ Мен ұшамын~.
Dialogue: 0,0:15:34.83,0:15:39.33,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:15:39.33,0:15:41.34,Default,,0000,0000,0000,,Ммм.
Dialogue: 0,0:15:41.34,0:15:43.84,Default,,0000,0000,0000,,Ах
Dialogue: 0,0:15:41.34,0:15:43.84,Default,,0000,0000,0000,,Осака мырза оянып кетті.
Dialogue: 0,0:15:43.84,0:15:46.51,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:15:46.51,0:15:49.51,Default,,0000,0000,0000,,Мұнымен кім ұйықтап жатыр?
Dialogue: 0,0:15:46.51,0:15:49.51,Default,,0000,0000,0000,,Тек Юкари-сенсэй.
Dialogue: 0,0:15:49.51,0:15:51.51,Default,,0000,0000,0000,,Бірақ бірдеңе болса
Dialogue: 0,0:15:49.51,0:15:51.51,Default,,0000,0000,0000,,Себебі ол ашулы көрінеді➡
Dialogue: 0,0:15:51.51,0:15:53.52,Default,,0000,0000,0000,,Мен сені оята алмаймын.
Dialogue: 0,0:15:53.52,0:15:55.68,Default,,0000,0000,0000,,А?
Dialogue: 0,0:15:55.68,0:15:59.69,Default,,0000,0000,0000,,Онда мен сені оятамын.
Dialogue: 0,0:15:55.68,0:15:59.69,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:15:59.69,0:16:04.29,Default,,0000,0000,0000,,Мен бұл туралы көптен бері армандадым.
Dialogue: 0,0:16:04.29,0:16:08.80,Default,,0000,0000,0000,,Қуыруға арналған табамен ояту
Dialogue: 0,0:16:04.29,0:16:08.80,Default,,0000,0000,0000,,Мен оны байқап көргім келді.
Dialogue: 0,0:16:08.80,0:16:14.64,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:16:14.64,0:16:18.31,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:18.31,0:16:20.31,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:16:20.31,0:16:25.61,Default,,0000,0000,0000,,Га~ Га~.
Dialogue: 0,0:16:20.31,0:16:25.61,Default,,0000,0000,0000,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:27.82,0:16:30.02,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:16:32.99,0:16:36.99,Default,,0000,0000,0000,,Хмм?
Dialogue: 0,0:16:36.99,0:16:39.99,Default,,0000,0000,0000,,Не, Осака?
Dialogue: 0,0:16:39.99,0:16:43.09,Default,,0000,0000,0000,,Ммм….
Dialogue: 0,0:16:47.00,0:16:49.84,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:16:49.84,0:16:52.84,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:16:52.84,0:16:56.01,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:16:56.01,0:16:58.18,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:16:58.18,0:17:01.38,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:17:03.28,0:17:06.08,Default,,0000,0000,0000,,Ол ұшып кетті...
Dialogue: 0,0:17:12.79,0:17:14.80,Default,,0000,0000,0000,,Не...?
Dialogue: 0,0:17:14.80,0:17:16.80,Default,,0000,0000,0000,,Мен енді ғана ояндым.
Dialogue: 0,0:17:19.47,0:17:21.47,Default,,0000,0000,0000,,Сәтсіздік немесе...
Dialogue: 0,0:17:21.47,0:17:23.77,Default,,0000,0000,0000,,Иә, иә….
Dialogue: 0,0:17:26.14,0:17:29.64,Default,,0000,0000,0000,,О, Осака-сан
Dialogue: 0,0:17:26.14,0:17:29.64,Default,,0000,0000,0000,,Сізде не бар?
Dialogue: 0,0:17:29.64,0:17:31.65,Default,,0000,0000,0000,,Иә? А, иә?
Dialogue: 0,0:17:31.65,0:17:35.32,Default,,0000,0000,0000,,Мен табаны әкелуім керек еді➡
Dialogue: 0,0:17:35.32,0:17:37.49,Default,,0000,0000,0000,,Қайда?
Dialogue: 0,0:17:37.49,0:17:40.32,Default,,0000,0000,0000,,Иә, Осака-сан.
Dialogue: 0,0:17:37.49,0:17:40.32,Default,,0000,0000,0000,,Маған серме!
Dialogue: 0,0:17:40.32,0:17:42.32,Default,,0000,0000,0000,,Чио-чан, сен білмейсің бе?
Dialogue: 0,0:17:42.32,0:17:45.66,Default,,0000,0000,0000,,Бұл жерде тербелме! Ахх!
Dialogue: 0,0:17:45.66,0:17:47.66,Default,,0000,0000,0000,,(құлаған дыбыс)
Dialogue: 0,0:17:47.66,0:17:50.00,Default,,0000,0000,0000,,Пышақ ұшады...
Dialogue: 0,0:17:50.00,0:17:53.17,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:17:53.17,0:17:56.67,Default,,0000,0000,0000,,Жазғы демалыс аяқталды...
Dialogue: 0,0:18:01.61,0:18:04.78,Default,,0000,0000,0000,,Күз.
Dialogue: 0,0:18:01.61,0:18:04.78,Default,,0000,0000,0000,,Күз?
Dialogue: 0,0:18:04.78,0:18:08.98,Default,,0000,0000,0000,,Күз - каштан күріш дегенді білдіреді.
Dialogue: 0,0:18:04.78,0:18:08.98,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:11.79,0:18:14.29,Default,,0000,0000,0000,,Грильде пісірілген сауыр да...
Dialogue: 0,0:18:14.29,0:18:18.13,Default,,0000,0000,0000,,Кагура-чан
Dialogue: 0,0:18:14.29,0:18:18.13,Default,,0000,0000,0000,,Оның қаншасы грильде пісірілген сауыр...?
Dialogue: 0,0:18:18.13,0:18:20.13,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:20.13,0:18:22.53,Default,,0000,0000,0000,,Жоқ! Хмм.
Dialogue: 0,0:18:26.13,0:18:29.64,Default,,0000,0000,0000,,Бұршақ және күріш…үлкен порция….
Dialogue: 0,0:18:29.64,0:18:31.64,Default,,0000,0000,0000,,Кагура Қарсылас болма.
Dialogue: 0,0:18:31.64,0:18:35.64,Default,,0000,0000,0000,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:18:38.31,0:18:40.32,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:18:40.32,0:18:42.32,Default,,0000,0000,0000,,Сатоши-чан, не болды?
Dialogue: 0,0:18:42.32,0:18:44.52,Default,,0000,0000,0000,,Көздерің өлімге ұқсайды~?
Dialogue: 0,0:18:46.82,0:18:51.52,Default,,0000,0000,0000,,Бүгін мектептегі алғашқы күн...
Dialogue: 0,0:18:46.82,0:18:51.52,Default,,0000,0000,0000,,Бүгін мектептегі алғашқы күн...
Dialogue: 0,0:18:56.50,0:18:58.50,Default,,0000,0000,0000,,Хахахаха….
Dialogue: 0,0:18:58.50,0:19:01.44,Default,,0000,0000,0000,,Жазғы демалыс жалғасуда...
Dialogue: 0,0:19:01.44,0:19:04.77,Default,,0000,0000,0000,,Бәріміз көк теңізге барайық...
Dialogue: 0,0:19:04.77,0:19:08.44,Default,,0000,0000,0000,,Қарбызды жару жағажай волейболы.
Dialogue: 0,0:19:08.44,0:19:12.11,Default,,0000,0000,0000,,Бұл қызық.
Dialogue: 0,0:19:12.11,0:19:14.12,Default,,0000,0000,0000,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:19:14.12,0:19:18.95,Default,,0000,0000,0000,,Бүгін мектептегі алғашқы күн...
Dialogue: 0,0:19:14.12,0:19:18.95,Default,,0000,0000,0000,,Бүгін мектептегі алғашқы күн...
Dialogue: 0,0:19:18.95,0:19:22.62,Default,,0000,0000,0000,,Мықты болыңыз!
Dialogue: 0,0:19:18.95,0:19:22.62,Default,,0000,0000,0000,,Бүгін басталатын екінші семестр!
Dialogue: 0,0:19:22.62,0:19:24.63,Default,,0000,0000,0000,,Сатоши-чан, мықты бол.
Dialogue: 0,0:19:24.63,0:19:27.30,Default,,0000,0000,0000,,Бүгін мектептің бірінші күні.
Dialogue: 0,0:19:27.30,0:19:32.10,Default,,0000,0000,0000,,Бүгін мектептегі алғашқы күн...
Dialogue: 0,0:19:27.30,0:19:32.10,Default,,0000,0000,0000,,Бүгін мектептегі алғашқы күн...
Dialogue: 0,0:19:37.14,0:19:39.14,Default,,0000,0000,0000,,Хахахаха….
Dialogue: 0,0:19:39.14,0:19:41.98,Default,,0000,0000,0000,,Жазғы демалыс жалғасуда...
Dialogue: 0,0:19:41.98,0:19:45.15,Default,,0000,0000,0000,,Бәріміз көк теңізге барайық...
Dialogue: 0,0:19:45.15,0:19:48.32,Default,,0000,0000,0000,,Қарбызды жару жағажай волейболы.
Dialogue: 0,0:19:48.32,0:19:51.12,Default,,0000,0000,0000,,Мен мұны істегім келеді.
Dialogue: 0,0:19:55.99,0:20:01.00,Default,,0000,0000,0000,,Бүгін мектептің бірінші күні... Бүгін мектептің бірінші күні...
Dialogue: 0,0:20:01.00,0:20:03.33,Default,,0000,0000,0000,,Бүгін мектептегі алғашқы күн...
Dialogue: 0,0:20:01.00,0:20:03.33,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:20:03.33,0:20:05.33,Default,,0000,0000,0000,,Чиё-чан бірдеңе➡
Dialogue: 0,0:20:05.33,0:20:08.17,Default,,0000,0000,0000,,Маған мотивация алу үшін заклинание беріңіз.
Dialogue: 0,0:20:08.17,0:20:10.51,Default,,0000,0000,0000,,О, сиқыр бар ма...?
Dialogue: 0,0:20:10.51,0:20:13.17,Default,,0000,0000,0000,,Ммммммм... Ах.
Dialogue: 0,0:20:13.17,0:20:19.07,Default,,0000,0000,0000,,Мотивация алыңыз! Мотивация алыңыз!
Dialogue: 0,0:20:21.68,0:20:26.68,Default,,0000,0000,0000,,Мотивация алыңыз! Мотивация алыңыз!
Dialogue: 0,0:20:35.03,0:20:38.53,Default,,0000,0000,0000,,Хаха….
Dialogue: 0,0:20:38.53,0:20:41.54,Default,,0000,0000,0000,,Ах! Ия, мотивация алыңыз!
Dialogue: 0,0:20:41.54,0:20:45.14,Default,,0000,0000,0000,,Мотивация алыңыз! Мотивация алыңыз!
Dialogue: 0,0:20:48.04,0:20:52.21,Default,,0000,0000,0000,,Ах~ Ах~ Ах~!
Dialogue: 0,0:20:52.21,0:20:55.55,Default,,0000,0000,0000,,Жоқ, жоқ, Чио-чан
Dialogue: 0,0:20:52.21,0:20:55.55,Default,,0000,0000,0000,,Осындай кезде осылай істейсің!
Dialogue: 0,0:20:55.55,0:20:58.22,Default,,0000,0000,0000,,Мотивация инъекциясы!
Dialogue: 0,0:20:55.55,0:20:58.22,Default,,0000,0000,0000,,Хогяа!
Dialogue: 0,0:20:58.22,0:21:00.32,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:21:00.32,0:21:02.82,Default,,0000,0000,0000,,Уау, жақсысың ба! ?
Dialogue: 0,0:21:02.82,0:21:04.83,Default,,0000,0000,0000,,Мияу!
Dialogue: 0,0:21:04.83,0:21:18.01,Default,,0000,0000,0000,,♬～
Dialogue: 0,0:21:18.01,0:21:20.01,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:21:20.01,0:21:27.61,Default,,0000,0000,0000,,Мотивация алыңыз! Мотивация алыңыз!
Dialogue: 0,0:21:31.52,0:21:36.12,Default,,0000,0000,0000,,Мотивация алыңыз! Мотивация алыңыз!
Dialogue: 0,0:21:42.36,0:21:45.70,Default,,0000,0000,0000,,Хаха….
Dialogue: 0,0:21:45.70,0:21:48.20,Default,,0000,0000,0000,,А, бар! ? Мотивация алыңыз!
Dialogue: 0,0:21:48.20,0:21:51.71,Default,,0000,0000,0000,,Мотивация алыңыз! Мотивация алыңыз!
Dialogue: 0,0:21:51.71,0:21:54.61,Default,,0000,0000,0000,,Мотивация алыңыз! Мотивация алыңыз!
Dialogue: 0,0:21:51.71,0:21:54.61,Default,,0000,0000,0000,,Онда! ?
