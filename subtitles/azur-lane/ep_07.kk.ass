Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.86,0:00:03.92,Default,,0,0,0,,<Кәсіпорын: шайқас>
Dialogue: 0,0:00:05.30,0:00:39.00,Default,,0,0,0,,♬～
Dialogue: 0,0:00:39.00,0:00:42.67,Default,,0,0,0,,Сол жақ қолыңдағы ырғақ артта қалып жатыр
Dialogue: 0,0:00:42.67,0:01:08.96,Default,,0,0,0,,♬～
Dialogue: 0,0:01:08.96,0:01:13.96,Default,,0,0,0,,<Дұрыс...ұрыс ешқашан өзгермейді>
Dialogue: 0,0:02:52.34,0:02:56.64,Default,,0,0,0,,Шайқастан кейін тағы бір шайқас...?
Dialogue: 0,0:03:09.29,0:03:12.25,Default,,0,0,0,,Бұл мен қалаған флот.
Dialogue: 0,0:03:16.76,0:03:18.26,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:19.24,0:03:21.26,Default,,0,0,0,,Біз жалғыз емеспіз
Dialogue: 0,0:03:21.78,0:03:25.26,Default,,0,0,0,,Бұл Одақпен біріккен флот болады, Мәртебелі.
Dialogue: 0,0:03:26.34,0:03:28.97,Default,,0,0,0,,Бұл керемет көрініс.
Dialogue: 0,0:03:29.14,0:03:32.02,Default,,0,0,0,,Сіз оған сене алатын болсаңыз.
Dialogue: 0,0:03:32.92,0:03:34.27,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:03:35.08,0:03:36.95,Default,,0,0,0,,Шешуші шайқас
Dialogue: 0,0:03:41.48,0:03:42.86,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:03:43.22,0:03:46.12,Default,,0,0,0,,Біз, теңіз рыцарлары, ешқашан артта қалмаймыз.
Dialogue: 0,0:03:46.66,0:03:49.08,Default,,0,0,0,,Мен апаңның үмітін ақтамаймын.
Dialogue: 0,0:03:49.08,0:03:51.50,Default,,0,0,0,,Тағы да жеңілдеп алайық.
Dialogue: 0,0:03:51.50,0:03:54.33,Default,,0,0,0,,Иығыңды босаңдатпасаң, жараланасың.
Dialogue: 0,0:03:54.68,0:03:58.10,Default,,0,0,0,,Дұрыс, олардың бәрі менің асыл әпкелерім.
Dialogue: 0,0:03:58.40,0:04:00.11,Default,,0,0,0,,Сіз мұны тым көп жасай алмайсыз.
Dialogue: 0,0:04:00.11,0:04:01.54,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:04:09.58,0:04:11.44,Default,,0,0,0,,Енді бұл сөзсіз.
Dialogue: 0,0:04:14.00,0:04:15.19,Default,,0,0,0,,Бұл дуэль.
Dialogue: 0,0:04:15.62,0:04:41.31,Default,,0,0,0,,♬～
Dialogue: 0,0:04:41.31,0:04:43.47,Default,,0,0,0,,Не болды? Такао-чан
Dialogue: 0,0:04:43.82,0:04:46.99,Default,,0,0,0,,Әлі ерте емес пе? иә?
Dialogue: 0,0:04:46.99,0:04:51.66,Default,,0,0,0,,Орочи жобасы ілгерілемей тұрып, мұндай ауқымды операция...
Dialogue: 0,0:04:51.66,0:04:54.66,Default,,0,0,0,,Акаги-доно не ойлайды?
Dialogue: 0,0:04:54.66,0:04:58.60,Default,,0,0,0,,Мен қара психикалық текшені қайтара алмағандықтан...
Dialogue: 0,0:04:58.60,0:05:01.60,Default,,0,0,0,,Мүмкін сіз асығыссыз.
Dialogue: 0,0:05:10.94,0:05:13.95,Default,,0,0,0,,Акаги-сенпай жоспары дегеніміз не?
Dialogue: 0,0:05:13.95,0:05:17.28,Default,,0,0,0,,Білмеймін, бірақ... бәрібір, Зуйкаку.
Dialogue: 0,0:05:17.28,0:05:20.29,Default,,0,0,0,,Менің әпкем сені қорғайды.
Dialogue: 0,0:05:20.29,0:05:22.59,Default,,0,0,0,,Өте әсерлі Қвирк қой, иә!➡
Dialogue: 0,0:05:26.96,0:05:29.96,Default,,0,0,0,,Иә! Ақырында кететін уақыт келді!
Dialogue: 0,0:05:29.96,0:05:33.36,Default,,0,0,0,,Мен саған Юкиказэ-саманың күшін көрсетемін!
Dialogue: 0,0:05:35.63,0:05:39.30,Default,,0,0,0,,Өзіңізді жақсы сезінбейсіз, солай ма? Содан бері бұл біртүрлі болды ма?
Dialogue: 0,0:05:39.30,0:05:43.64,Default,,0,0,0,,Ештеңе емес, бәрі жақсы.
Dialogue: 0,0:05:43.64,0:05:46.31,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:05:46.31,0:05:49.98,Default,,0,0,0,,Бұл жолы Шигуре-самада сәттілік құдайы бар.
Dialogue: 0,0:05:49.98,0:05:54.98,Default,,0,0,0,,Юкиказэ-сама да! (Сигуре) Иә, иә, ұмытқан жоқпын.
Dialogue: 0,0:06:10.60,0:06:13.90,Default,,0,0,0,,Аянами-чан екінші жақта...
Dialogue: 0,0:06:18.61,0:06:20.61,Default,,0,0,0,,Ах
Dialogue: 0,0:06:22.61,0:06:24.62,Default,,0,0,0,,Хехе
Dialogue: 0,0:06:24.62,0:06:28.95,Default,,0,0,0,,Жарайды, мен әлі не істерімді білмеймін...
Dialogue: 0,0:06:28.95,0:06:32.35,Default,,0,0,0,,Бірақ мен енді жоғалған жоқпын
Dialogue: 0,0:06:40.30,0:06:42.97,Default,,0,0,0,,Құрметті кәсіпорын
Dialogue: 0,0:06:42.97,0:06:45.97,Default,,0,0,0,,Сіз ойланып отырсыз ба?
Dialogue: 0,0:06:45.97,0:06:49.98,Default,,0,0,0,,Жоқ, шамалы жел соқты.
Dialogue: 0,0:06:49.98,0:06:54.31,Default,,0,0,0,,Шешуші шайқастың уақыты жақын, біз өзімізді дайындап алуымыз керек.
Dialogue: 0,0:06:54.31,0:06:58.31,Default,,0,0,0,,Тым абайсызда әрекет етуден аулақ болыңыз.
Dialogue: 0,0:07:00.25,0:07:02.25,Default,,0,0,0,,Жақсы қарым-қатынас жасаңыз
Dialogue: 0,0:07:02.25,0:07:04.26,Default,,0,0,0,,Құрметті кәсіпорын
Dialogue: 0,0:07:04.26,0:07:07.93,Default,,0,0,0,,А... жарайды, бұл туралы уайымдамаңыз.
Dialogue: 0,0:07:07.93,0:07:11.33,Default,,0,0,0,,Ештеңе жоқ, ойлануға болмайды.
Dialogue: 0,0:07:18.60,0:07:23.28,Default,,0,0,0,,Керемет рух... Йорктаунның сіңлісі күткендей.
Dialogue: 0,0:07:23.28,0:07:26.28,Default,,0,0,0,,Ха... Менің қарындасым да жеңіліп жатқан жоқ!
Dialogue: 0,0:07:26.28,0:07:28.95,Default,,0,0,0,,Бұл өте сүйкімді~
Dialogue: 0,0:07:28.95,0:07:31.62,Default,,0,0,0,,Бәсекелестік қай жерде өртеніп жатыр?
Dialogue: 0,0:07:31.62,0:07:33.62,Default,,0,0,0,,Уау~
Dialogue: 0,0:07:51.30,0:07:54.31,Default,,0,0,0,,Радар біраз уақыттан бері жақсы жұмыс істемейді.
Dialogue: 0,0:07:54.31,0:07:57.31,Default,,0,0,0,,Ештеңе болмайды деп үміттенемін...
Dialogue: 0,0:08:00.91,0:08:05.61,Default,,0,0,0,,Жақсы емес Бірдеңе шынымен жағымсыз.
Dialogue: 0,0:08:11.92,0:08:17.62,Default,,0,0,0,,Дастархан жайып қойдым, қалғаны өзіңе байланысты Ақағи.
Dialogue: 0,0:08:25.27,0:08:30.28,Default,,0,0,0,,Аспан желі, бұлт жолы жабылады.
Dialogue: 0,0:08:30.28,0:08:35.28,Default,,0,0,0,,Қыз кейпі біраз уақытқа созылады
Dialogue: 0,0:08:35.28,0:08:51.96,Default,,0,0,0,,♬～
Dialogue: 0,0:08:51.96,0:08:55.63,Default,,0,0,0,,Кя!!
Dialogue: 0,0:08:55.63,0:08:57.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:57.57,0:08:59.57,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:09:10.58,0:09:12.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:16.25,0:09:18.59,Default,,0,0,0,,Уф… Ууу…
Dialogue: 0,0:09:18.59,0:09:25.59,Default,,0,0,0,,♬～
Dialogue: 0,0:09:28.77,0:10:02.80,Default,,0,0,0,,♬～
Dialogue: 0,0:10:02.80,0:10:06.47,Default,,0,0,0,,О... бұл не? Мұнда...
Dialogue: 0,0:10:06.47,0:10:09.37,Default,,0,0,0,,Әпке, бұл! (Кливленд және басқалар) Ах.
Dialogue: 0,0:10:16.65,0:10:18.65,Default,,0,0,0,,Сирена!?
Dialogue: 0,0:10:20.65,0:10:22.65,Default,,0,0,0,,Ах
Dialogue: 0,0:10:28.33,0:10:30.66,Default,,0,0,0,,Акаги…
Dialogue: 0,0:10:30.66,0:10:34.67,Default,,0,0,0,,Менің Azur Lane теңізіме қош келдіңіз
Dialogue: 0,0:10:34.67,0:10:36.97,Default,,0,0,0,,Сізді мұнда көргеніме өте қуаныштымын.
Dialogue: 0,0:10:49.01,0:10:52.02,Default,,0,0,0,,Жүр! патша жауынгерлері
Dialogue: 0,0:10:52.02,0:11:18.64,Default,,0,0,0,,♬～
Dialogue: 0,0:11:18.64,0:11:21.65,Default,,0,0,0,,Талғампаздық тек көңіл көтеру үшін ғана емес.
Dialogue: 0,0:11:21.65,0:11:44.67,Default,,0,0,0,,♬～
Dialogue: 0,0:11:44.67,0:11:46.97,Default,,0,0,0,,Бірдеңе істейміз бе?
Dialogue: 0,0:12:03.96,0:12:06.96,Default,,0,0,0,,А... а...
Dialogue: 0,0:12:06.96,0:12:08.96,Default,,0,0,0,,А, мен барын саламын.
Dialogue: 0,0:12:14.30,0:12:16.90,Default,,0,0,0,,Элдридж-чан керемет...
Dialogue: 0,0:12:22.31,0:12:24.64,Default,,0,0,0,,Жарайды, бұл соңы.
Dialogue: 0,0:12:24.64,0:12:26.64,Default,,0,0,0,,Ах (мылтық дыбысы)
Dialogue: 0,0:12:33.99,0:12:35.99,Default,,0,0,0,,Ха...
Dialogue: 0,0:12:35.99,0:12:39.32,Default,,0,0,0,,Жақсы қимыл, көңілді болатын сияқты.
Dialogue: 0,0:12:39.32,0:12:42.92,Default,,0,0,0,,Осыны тез бітіріп, ішіп алайық.
Dialogue: 0,0:12:46.33,0:12:49.00,Default,,0,0,0,,Бұл шие гүлінен тұратын ауыр кеме ме...
Dialogue: 0,0:12:49.00,0:13:37.98,Default,,0,0,0,,♬～
Dialogue: 0,0:13:37.98,0:13:41.32,Default,,0,0,0,,Жүр, көңіл көтеруге рұқсат ет.
Dialogue: 0,0:13:41.32,0:13:44.32,Default,,0,0,0,,Хмф! (Атаго) Хехе
Dialogue: 0,0:13:44.32,0:13:46.32,Default,,0,0,0,,Оқ жаудыр!
Dialogue: 0,0:13:49.66,0:13:54.36,Default,,0,0,0,,Бар, Джузакура Цувамоно! Аспанның бақыты бізбен бірге
Dialogue: 0,0:14:09.28,0:14:11.28,Default,,0,0,0,,Бұл басталды.
Dialogue: 0,0:14:11.28,0:14:15.29,Default,,0,0,0,,Бірақ Сорю-сама, бұл теңіз аймағы қандай?
Dialogue: 0,0:14:15.29,0:14:18.29,Default,,0,0,0,,Ақағы-сенпай не істеді?
Dialogue: 0,0:14:18.29,0:14:21.59,Default,,0,0,0,,Мен де білмеймін.
Dialogue: 0,0:14:25.63,0:14:29.33,Default,,0,0,0,,Ах... Бұл нағыз одемаши ма?
Dialogue: 0,0:14:32.80,0:14:35.10,Default,,0,0,0,,Сұр елес
Dialogue: 0,0:14:45.65,0:14:47.65,Default,,0,0,0,,Күте тұрыңыз!!
Dialogue: 0,0:14:47.65,0:14:49.65,Default,,0,0,0,,Артта қал, Бес кеме шайқасы
Dialogue: 0,0:14:49.65,0:14:52.66,Default,,0,0,0,,Қаға-сенпай Мен сұр елеспен айналысамын...
Dialogue: 0,0:14:52.66,0:14:57.93,Default,,0,0,0,,Бұл менің кек алу соғысым. Әлі жетілмеген балапандарға орын жоқ.
Dialogue: 0,0:14:57.93,0:15:25.29,Default,,0,0,0,,♬～
Dialogue: 0,0:15:25.29,0:15:27.63,Default,,0,0,0,,Ондай нәрсе бар ма?
Dialogue: 0,0:15:27.63,0:15:42.31,Default,,0,0,0,,♬～
Dialogue: 0,0:15:42.31,0:15:45.64,Default,,0,0,0,,Балалар, шынымен де Сиренмен бірге болдыңыз ба?
Dialogue: 0,0:15:45.64,0:15:49.65,Default,,0,0,0,,Мен Акашиден естідім, ол көмекке келмейтін адам.
Dialogue: 0,0:15:49.65,0:15:55.32,Default,,0,0,0,,Акаги екеуің бізге емес, Шигесакурадағы қандастарымызға опасыздық жасадыңдар.
Dialogue: 0,0:15:55.32,0:15:58.32,Default,,0,0,0,,Менің әпкем туралы не білесің?
Dialogue: 0,0:16:06.93,0:16:10.63,Default,,0,0,0,,Мен оны Қағаға қалдыра алмаймын.
Dialogue: 0,0:16:12.60,0:16:14.94,Default,,0,0,0,,Солай болса, олар менің
Dialogue: 0,0:16:14.94,0:16:18.34,Default,,0,0,0,,Қате келген сияқты.
Dialogue: 0,0:16:20.95,0:16:24.65,Default,,0,0,0,,Көз жараларын тазалау керек
Dialogue: 0,0:16:27.29,0:16:29.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:31.79,0:16:34.29,Default,,0,0,0,,Келіңіздер, рахат алыңыз!
Dialogue: 0,0:16:39.96,0:16:41.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:41.97,0:16:43.97,Default,,0,0,0,,Мен оны түсіндім...
Dialogue: 0,0:16:43.97,0:16:59.25,Default,,0,0,0,,♬～
Dialogue: 0,0:16:59.25,0:17:01.55,Default,,0,0,0,,Құрметті кәсіпорын!? Қарғыс атқыр...
Dialogue: 0,0:17:12.26,0:17:14.26,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:25.28,0:17:29.28,Default,,0,0,0,,)
Dialogue: 0,0:17:29.28,0:17:33.28,Default,,0,0,0,,《Мен туғаннан бері теңіз майдан даласы...》
Dialogue: 0,0:17:35.79,0:17:39.96,Default,,0,0,0,,《Гүрілдеген мылтық, түтін иісі
Dialogue: 0,0:17:39.96,0:17:45.36,Default,,0,0,0,,Жанып тұрған жалынның қызуы, теңіз суының салқыны》
Dialogue: 0,0:17:49.63,0:17:52.93,Default,,0,0,0,,《Мен үшін теңіз...》
Dialogue: 0,0:17:56.24,0:17:58.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:02.25,0:18:04.25,Default,,0,0,0,,)
Dialogue: 0,0:18:29.61,0:18:32.94,Default,,0,0,0,,Ұйқы, сұр елес
Dialogue: 0,0:18:32.94,0:18:38.64,Default,,0,0,0,,Сіздің ойларыңыз қара жәшікте сақталады және ұлы күштің бір бөлігіне айналады.
Dialogue: 0,0:18:48.29,0:18:50.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:50.29,0:18:52.29,Default,,0,0,0,,Не болып жатыр!?
Dialogue: 0,0:18:54.30,0:18:56.23,Default,,0,0,0,,А...
Dialogue: 0,0:18:56.23,0:18:58.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:58.24,0:19:00.24,Default,,0,0,0,,Құрметті кәсіпорын?
Dialogue: 0,0:19:02.57,0:19:05.24,Default,,0,0,0,,Сіз ояусыз.
Dialogue: 0,0:19:05.24,0:19:07.91,Default,,0,0,0,,Бұл сізсіз.
Dialogue: 0,0:19:07.91,0:19:11.31,Default,,0,0,0,,Бұл дүниеде де сен кілтсің.
Dialogue: 0,0:19:13.25,0:19:15.25,Default,,0,0,0,,Кәсіпорын
Dialogue: 0,0:19:17.92,0:19:20.26,Default,,0,0,0,,Ха...
Dialogue: 0,0:19:20.26,0:19:23.26,Default,,0,0,0,,Енді... не...
Dialogue: 0,0:19:26.26,0:19:28.26,Default,,0,0,0,,Қаға!
Dialogue: 0,0:19:37.94,0:19:40.28,Default,,0,0,0,,Ақағы-сенпай! Қаға-сенпай!
Dialogue: 0,0:19:40.28,0:19:42.28,Default,,0,0,0,,Зуикаку!
Dialogue: 0,0:19:42.28,0:19:44.28,Default,,0,0,0,,Бұл не!? Міне бітті!
Dialogue: 0,0:19:44.74,0:19:47.29,Default,,0,0,0,,Әпке... не істедің?
Dialogue: 0,0:19:49.62,0:19:51.34,Default,,0,0,0,,Лаффи-чан!
Dialogue: 0,0:19:52.14,0:19:53.40,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:20:04.64,0:20:06.64,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:20:13.86,0:20:15.30,Default,,0,0,0,,Мен саған кедергі келтірмеймін.
Dialogue: 0,0:20:24.48,0:20:27.32,Default,,0,0,0,,Менің махаббатым осылай болуы керек
Dialogue: 0,0:20:27.64,0:20:33.33,Default,,0,0,0,,Менің махаббатым уақыттан асып, Құдайдан да асып түседі, ал шие гүлдейді ...
Dialogue: 0,0:20:33.33,0:20:34.82,Default,,0,0,0,,Ал менің әпкем!
Dialogue: 0,0:20:49.68,0:20:51.40,Default,,0,0,0,,Ха...
Dialogue: 0,0:21:04.30,0:21:05.36,Default,,0,0,0,,((Ах
Dialogue: 0,0:21:08.98,0:21:10.60,Default,,0,0,0,,Ах...))
Dialogue: 0,0:21:25.26,0:21:26.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:26.52,0:21:28.16,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:21:28.65,0:21:41.33,Default,,0,0,0,,♬～
Dialogue: 0,0:21:41.62,0:21:44.33,Default,,0,0,0,,)
Dialogue: 0,0:21:48.34,0:21:52.64,Default,,0,0,0,,А... түсіндім.
Dialogue: 0,0:21:54.18,0:21:57.95,Default,,0,0,0,,Теңіз бұл...
Dialogue: 0,0:21:58.67,0:21:59.88,Default,,0,0,0,,Міне, алма мен жаңғақ қосылған карамельді вафлилер.
Dialogue: 0,0:23:37.36,0:23:40.48,Default,,0,0,0,,((Мен сені кездестірдім, Амаги апа)
Dialogue: 0,0:23:44.48,0:23:46.66,Default,,0,0,0,,Ха…))
Dialogue: 0,0:23:47.22,0:23:50.66,Default,,0,0,0,,Әлі біткен жоқ, Акаги.
Dialogue: 0,0:23:52.16,0:23:58.16,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory