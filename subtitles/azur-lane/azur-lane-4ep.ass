Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.91,0:00:26.93,Default,,0,0,0,,♬～
Dialogue: 0,0:00:26.93,0:00:29.94,Default,,0,0,0,,О
Dialogue: 0,0:00:30.48,0:00:34.94,Default,,0,0,0,,Мен оралдым Мен оралдым! Ах...
Dialogue: 0,0:00:45.40,0:00:49.46,Default,,0,0,0,,Қош келдіңіз, Акаги-сан (Акаги) Қажырлы еңбегіңіз үшін рахмет, Како Фурутака
Dialogue: 0,0:00:49.90,0:00:51.96,Default,,0,0,0,,Сіз жоқта бірдеңе болды ма?
Dialogue: 0,0:00:52.14,0:00:55.96,Default,,0,0,0,,Иә, айтпақшы, Нагато-сама қоңырау шалып жатыр.
Dialogue: 0,0:00:56.50,0:00:59.49,Default,,0,0,0,,Мен білемін. Мен есеп беруге бара жатырмын.
Dialogue: 0,0:00:59.98,0:01:02.66,Default,,0,0,0,,Қош келдіңіз Аянами (Аянами) Мен үйдемін.
Dialogue: 0,0:01:02.66,0:01:05.58,Default,,0,0,0,,Сіз ауырып қалдыңыз ба? (Сигуре) Қараңдар, мен қайтып келдім.
Dialogue: 0,0:01:05.58,0:01:07.41,Default,,0,0,0,,Сәлем Аянами!
Dialogue: 0,0:01:08.36,0:01:11.08,Default,,0,0,0,,Мына Юкиказэ-сама менімен амандасу үшін барын салды.
Dialogue: 0,0:01:11.08,0:01:13.32,Default,,0,0,0,,Рахмет. Қалай болды?
Dialogue: 0,0:01:13.51,0:01:16.51,Default,,0,0,0,,Қанша кемені жеңдіңіз? Ах...
Dialogue: 0,0:01:17.08,0:01:20.28,Default,,0,0,0,,Шай үстінде кәдесыйлар туралы сөйлесейік.
Dialogue: 0,0:01:20.28,0:01:24.32,Default,,0,0,0,,Иә! Тамақ! (Принц Евген) Уууу...
Dialogue: 0,0:01:24.32,0:01:26.76,Default,,0,0,0,,Мүлдем мазасыз...
Dialogue: 0,0:01:26.76,0:01:28.81,Default,,0,0,0,,Жарайды, бұл мені күлдіреді.
Dialogue: 0,0:01:38.54,0:01:40.42,Default,,0,0,0,,Мен жаңа ғана оралдым.
Dialogue: 0,0:01:40.42,0:01:42.94,Default,,0,0,0,,Иә, еңбектеріңіз үшін рахмет. Аман жүргеніңізге қуаныштымын.
Dialogue: 0,0:01:43.54,0:01:45.95,Default,,0,0,0,,Өтінемін, қазір мені тыңда, Сорю-сан.
Dialogue: 0,0:01:46.40,0:01:50.62,Default,,0,0,0,,Бірінші рейстегі қарт адамдар адамдарға өте қатал.
Dialogue: 0,0:01:51.06,0:01:54.32,Default,,0,0,0,,Не болды? Зуикаку: Сіз бақытты емес сияқтысыз.
Dialogue: 0,0:01:57.54,0:02:00.96,Default,,0,0,0,,Жоқ, бәрібір, Хирю-сан ештеңе емес.
Dialogue: 0,0:02:10.00,0:02:11.36,Default,,0,0,0,,Сұр елес
Dialogue: 0,0:02:16.00,0:02:17.91,Default,,0,0,0,,Келесі жолы сөзсіз!
Dialogue: 0,0:03:50.44,0:04:30.42,Default,,0,0,0,,♬～
Dialogue: 0,0:04:30.42,0:04:32.72,Default,,0,0,0,,(перделердің ашылған дыбысы)
Dialogue: 0,0:04:38.09,0:04:41.13,Default,,0,0,0,,Қайырлы таң, Кәсіпорын мырза.
Dialogue: 0,0:04:47.43,0:04:49.54,Default,,0,0,0,,Бұл қандай жағдай?
Dialogue: 0,0:04:51.20,0:04:53.11,Default,,0,0,0,,Мен кофе ішетінмін
Dialogue: 0,0:04:53.11,0:04:55.68,Default,,0,0,0,,Кофе де өте жақсы, бірақ...
Dialogue: 0,0:04:55.68,0:04:58.02,Default,,0,0,0,,Көп ішу асқазаныңызды ауыртады.
Dialogue: 0,0:04:58.02,0:04:59.77,Default,,0,0,0,,Әсіресе қарныңыз ашса.
Dialogue: 0,0:05:00.16,0:05:01.90,Default,,0,0,0,,Тамақ болса, мен алып жатырмын.
Dialogue: 0,0:05:03.08,0:05:06.20,Default,,0,0,0,,Бұл сөз жоқ, Кәсіпорын-сама.
Dialogue: 0,0:05:06.20,0:05:09.02,Default,,0,0,0,,Өмір салтыңызды жақсартыңыз
Dialogue: 0,0:05:09.02,0:05:12.28,Default,,0,0,0,,Әдемі болу үшін тұрақты өмір қажет.
Dialogue: 0,0:05:12.28,0:05:13.96,Default,,0,0,0,,Ең маңыздысы
Dialogue: 0,0:05:19.68,0:05:22.40,Default,,0,0,0,,Менің өміріме неге араласасың?
Dialogue: 0,0:05:22.40,0:05:24.24,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:05:25.07,0:05:28.24,Default,,0,0,0,,Мен нені көргім келеді?
Dialogue: 0,0:05:28.24,0:05:31.44,Default,,0,0,0,,Сіздің ішіңізде тұратын адам жүрегі
Dialogue: 0,0:05:36.96,0:05:39.01,Default,,0,0,0,,Мен түсінбеймін...
Dialogue: 0,0:05:43.42,0:05:46.09,Default,,0,0,0,,Тукидің қыздары қалай?
Dialogue: 0,0:05:46.09,0:05:48.26,Default,,0,0,0,,Менің әпкем ауыр жарақат алды, бірақ
Dialogue: 0,0:05:48.26,0:05:50.43,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:05:50.43,0:05:52.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:54.93,0:05:57.73,Default,,0,0,0,,Иә, бір адам күтіп тұр!
Dialogue: 0,0:06:01.37,0:06:05.71,Default,,0,0,0,,Уау! Неліктен Хамман көмектесу үшін жасалған!?
Dialogue: 0,0:06:05.71,0:06:09.71,Default,,0,0,0,,Сәттілік Jayou! Хирауми: Сатылымдағыны жеме!
Dialogue: 0,0:06:09.71,0:06:12.05,Default,,0,0,0,,Бизнес бастау...
Dialogue: 0,0:06:12.05,0:06:15.72,Default,,0,0,0,,Бұл өте күшті жас ханымдар.
Dialogue: 0,0:06:15.72,0:06:19.72,Default,,0,0,0,,Иә, өтінемін, жоқ, мен...
Dialogue: 0,0:06:19.72,0:06:22.92,Default,,0,0,0,,Әпкем маған ақшаны уайымдама деді.
Dialogue: 0,0:06:24.90,0:06:28.00,Default,,0,0,0,,Хираумиге және басқаларға көмектескеніңіз үшін рахмет.
Dialogue: 0,0:06:33.07,0:06:49.09,Default,,0,0,0,,♬～
Dialogue: 0,0:06:49.09,0:06:52.79,Default,,0,0,0,,Дәмді Иә, бұл дәмді!
Dialogue: 0,0:06:59.03,0:07:02.87,Default,,0,0,0,,Келесі жолы мен де Аянамимен тамақтанғым келеді!?
Dialogue: 0,0:07:02.87,0:07:05.97,Default,,0,0,0,,Жоқ? Жоқ, бұл дұрыс емес.
Dialogue: 0,0:07:08.71,0:07:13.71,Default,,0,0,0,,Дұрыс, Аянами-чан да сенімен бірге деп үміттенемін.
Dialogue: 0,0:07:15.71,0:07:18.05,Default,,0,0,0,,《Нинхай: Біз, Дунхуан...
Dialogue: 0,0:07:18.05,0:07:21.05,Default,,0,0,0,,Мен Сиренада күдікті қозғалыстарды байқадым.
Dialogue: 0,0:07:21.05,0:07:24.22,Default,,0,0,0,,Ауқымды шабуылдың белгісі болуы мүмкін
Dialogue: 0,0:07:24.22,0:07:28.06,Default,,0,0,0,,Білу үшін барлау ісіне бардық.
Dialogue: 0,0:07:28.06,0:07:46.08,Default,,0,0,0,,♬～
Dialogue: 0,0:07:46.08,0:07:49.08,Default,,0,0,0,,Жоғарғы сиреналар қозғалып жатыр дейсіз бе?
Dialogue: 0,0:07:49.08,0:07:52.08,Default,,0,0,0,,Иә
Dialogue: 0,0:07:52.08,0:07:54.92,Default,,0,0,0,,Сіз өзіңізді нашар ұстайсыз, Хорнет-чан.
Dialogue: 0,0:07:54.92,0:07:59.19,Default,,0,0,0,,Донфан, сонымен қатар Туки деген атпен белгілі, Азур Лейнге жататын фракциялардың бірі.
Dialogue: 0,0:07:59.19,0:08:02.53,Default,,0,0,0,,Ол біз үшін бұл ақпаратты алды.
Dialogue: 0,0:08:02.53,0:08:06.20,Default,,0,0,0,,Azur Lane мен Red Axis арасындағы шайқасты пайдаланып...
Dialogue: 0,0:08:06.20,0:08:08.40,Default,,0,0,0,,Мүмкін ол бірдеңе орнатуға тырысып жатқан шығар.
Dialogue: 0,0:08:10.37,0:08:13.37,Default,,0,0,0,,Сиреннің қызметі және Шигезакураның жаңа технологиясы -
Dialogue: 0,0:08:13.37,0:08:16.04,Default,,0,0,0,,Жаппай шығарылатын сиреналарды басқаратын қуат
Dialogue: 0,0:08:16.04,0:08:20.05,Default,,0,0,0,,Менің ойымша, бұл байланыссыз. Мен оны қарауым керек.
Dialogue: 0,0:08:20.05,0:08:24.05,Default,,0,0,0,,Бұл біз Royal-де жақсы.
Dialogue: 0,0:08:24.05,0:08:27.05,Default,,0,0,0,,Не? Біздің қызметшілер тобы қазірдің өзінде...
Dialogue: 0,0:08:27.05,0:08:29.22,Default,,0,0,0,,Менің жаңа миссиям бар.
Dialogue: 0,0:08:29.22,0:08:32.02,Default,,0,0,0,,Қызметші? Миссия?
Dialogue: 0,0:08:34.39,0:08:38.99,Default,,0,0,0,,Жадағай және қанжар Жадағай мен қанжар.
Dialogue: 0,0:08:42.40,0:08:45.24,Default,,0,0,0,,Хаха жарыс! (Ямаширо) Әпкесі -
Dialogue: 0,0:08:45.24,0:08:47.91,Default,,0,0,0,,Анмитсу жейік (Фусо) Уфуфу -
Dialogue: 0,0:08:47.91,0:08:52.41,Default,,0,0,0,,Көп жесең жақсы емес. Олар тым жігерлі.
Dialogue: 0,0:09:08.36,0:09:12.36,Default,,0,0,0,,Бұл қара жәшік Сиренді бағындыра ала ма?
Dialogue: 0,0:09:12.36,0:09:16.20,Default,,0,0,0,,Иә, бірақ бұл жанама өнім.
Dialogue: 0,0:09:16.20,0:09:19.87,Default,,0,0,0,,Бұл қара жәшік те ақыл текше
Dialogue: 0,0:09:19.87,0:09:22.87,Default,,0,0,0,,Біз кеменің материалымыз.
Dialogue: 0,0:09:22.87,0:09:25.04,Default,,0,0,0,,Орочи жоспары
Dialogue: 0,0:09:25.04,0:09:28.38,Default,,0,0,0,,Иә, Жузакураға тілегіміз осы.
Dialogue: 0,0:09:28.38,0:09:32.88,Default,,0,0,0,,Бірақ бұл үшін бізге бірдеңе орнату керек...
Dialogue: 0,0:09:32.88,0:09:36.39,Default,,0,0,0,,Сиреналармен соғыс сөзсіз...
Dialogue: 0,0:09:36.39,0:09:39.06,Default,,0,0,0,,Ол бұрын бірнеше рет ойналған.
Dialogue: 0,0:09:39.06,0:09:42.06,Default,,0,0,0,,Адамзат әрең дегенде аман қалды.
Dialogue: 0,0:09:42.06,0:09:45.06,Default,,0,0,0,,Azur Lane әдісі оны уақытында орындамайды.
Dialogue: 0,0:09:45.06,0:09:50.40,Default,,0,0,0,,Джузакураның ертеңі үшін біз қандай жағдай болмасын жоспарды орындауымыз керек.
Dialogue: 0,0:09:50.40,0:09:54.00,Default,,0,0,0,,Жарайды, артқа шегінуге болады.
Dialogue: 0,0:10:00.25,0:10:04.75,Default,,0,0,0,,Бұл шайқастар ешқашан өзгермейді дегенді білдіре ме?
Dialogue: 0,0:10:04.75,0:10:09.42,Default,,0,0,0,,Нагатода осы кезеңнен кейін әлі де шатасу үшін жеткілікті шешім жоқ.
Dialogue: 0,0:10:09.42,0:10:12.42,Default,,0,0,0,,Менің айтып тұрғаным бұл емес.
Dialogue: 0,0:10:12.42,0:10:14.76,Default,,0,0,0,,Бұл да терең махаббаттан
Dialogue: 0,0:10:14.76,0:10:17.43,Default,,0,0,0,,Бірақ, әпке...
Dialogue: 0,0:10:17.43,0:10:21.10,Default,,0,0,0,,Бірақ бұл жеткіліксіз... Акагінің махаббаты...
Dialogue: 0,0:10:21.10,0:10:24.30,Default,,0,0,0,,Дүниені өртеп, әлі де жанып жатыр...
Dialogue: 0,0:10:28.44,0:10:31.11,Default,,0,0,0,,Иә... жақында келеді.
Dialogue: 0,0:10:31.11,0:10:33.51,Default,,0,0,0,,Акаги апа...
Dialogue: 0,0:10:46.12,0:10:50.63,Default,,0,0,0,,Иә!? Кәсіпорын деген кім?
Dialogue: 0,0:10:50.63,0:10:53.97,Default,,0,0,0,,Сол Кага-санды жеңдіңіз бе? Бұл ақылсыз...
Dialogue: 0,0:10:53.97,0:10:59.24,Default,,0,0,0,,Хмф, егер бұл Юкиказэ-сама оның қолына түссе, Одақ та, Корольдік те жойылады!
Dialogue: 0,0:10:59.24,0:11:01.57,Default,,0,0,0,,Иә! Ха! (Сигуре) Тыныштанып тамақтан.
Dialogue: 0,0:11:01.57,0:11:04.08,Default,,0,0,0,,Әй, шай
Dialogue: 0,0:11:04.08,0:11:08.25,Default,,0,0,0,,Пуха! Керемет~ Аянами сұрыптай алды.
Dialogue: 0,0:11:08.25,0:11:10.75,Default,,0,0,0,,Душ түсе салысымен ұрысқым келеді
Dialogue: 0,0:11:14.09,0:11:19.42,Default,,0,0,0,,Мен төбелескенді ұнатпаймын, мен әдеттегідей ұрыстым...
Dialogue: 0,0:11:19.42,0:11:24.93,Default,,0,0,0,,Әдетте, бұл жын құдай Аянами не дейді?
Dialogue: 0,0:11:24.93,0:11:27.10,Default,,0,0,0,,Бұл жын! Цуноцуно!
Dialogue: 0,0:11:27.10,0:11:31.10,Default,,0,0,0,,Хмм, бұл Аянамидің құлағы. Бұл мүйіз емес...
Dialogue: 0,0:11:31.10,0:11:34.61,Default,,0,0,0,,Бірақ Шигурэ-сама сияқты тек күшті болу жеткіліксіз...
Dialogue: 0,0:11:34.61,0:11:38.51,Default,,0,0,0,,Менің жолым болған шығар. Аа, мен дұрыс айттым!
Dialogue: 0,0:11:40.45,0:11:43.95,Default,,0,0,0,,Шайқас, Юкиказэ! Мен бүгін шешемін!
Dialogue: 0,0:11:43.95,0:11:46.75,Default,,0,0,0,,Дүкенде тыныш болыңыз!
Dialogue: 0,0:11:56.39,0:11:58.69,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:12:05.74,0:12:08.07,Default,,0,0,0,,Бұл қызықты, Каосюн
Dialogue: 0,0:12:08.07,0:12:11.41,Default,,0,0,0,,Зуйкаку-доно, қайтып келші.
Dialogue: 0,0:12:11.41,0:12:15.08,Default,,0,0,0,,Иә, бұл өте жақсы емес еді...
Dialogue: 0,0:12:15.08,0:12:17.42,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:17.42,0:12:40.77,Default,,0,0,0,,♬～
Dialogue: 0,0:12:40.77,0:12:44.78,Default,,0,0,0,,Ақырында, Gray Ghost маған сәйкес келмеді.
Dialogue: 0,0:12:44.78,0:12:47.28,Default,,0,0,0,,Қазіргідей жақсы емес...
Dialogue: 0,0:12:47.28,0:12:52.78,Default,,0,0,0,,Егер мен күшеймесем, Шоукаку-ниді де, басқаларды да қорғай алмаймын.
Dialogue: 0,0:12:52.78,0:12:54.95,Default,,0,0,0,,Уг!?
Dialogue: 0,0:12:54.95,0:12:59.22,Default,,0,0,0,,А, кешіріңіз, бұл тым күшті болды ма? Уф...
Dialogue: 0,0:12:59.22,0:13:02.23,Default,,0,0,0,,Бірақ оны жалғыз ойлап табу жақсы идея емес.
Dialogue: 0,0:13:02.23,0:13:04.90,Default,,0,0,0,,Маған көбірек сенім артыңызшы.
Dialogue: 0,0:13:04.90,0:13:07.70,Default,,0,0,0,,Такао... Сіз доссыз ба?
Dialogue: 0,0:13:19.74,0:13:25.42,Default,,0,0,0,,Дәл... Акашидің үлкен соққысы олар мұнайды қайда сатады?
Dialogue: 0,0:13:25.42,0:13:29.75,Default,,0,0,0,,Уф! кінә? Сенімен бәрі жақсы ма?
Dialogue: 0,0:13:29.75,0:13:32.05,Default,,0,0,0,,Айтпақшы, сіз...
Dialogue: 0,0:13:39.76,0:13:41.77,Default,,0,0,0,,Ах
Dialogue: 0,0:13:41.77,0:13:44.10,Default,,0,0,0,,Егер
Dialogue: 0,0:13:44.10,0:13:47.50,Default,,0,0,0,,Бұл жоғалған зат.
Dialogue: 0,0:14:05.39,0:14:08.73,Default,,0,0,0,,Қазірдің өзінде! Неліктен мен жасырын тапсырмадамын?
Dialogue: 0,0:14:08.73,0:14:12.23,Default,,0,0,0,,Бұл сізге сәйкес емес! (Шеффилд) Бұл қатты.
Dialogue: 0,0:14:12.23,0:14:14.40,Default,,0,0,0,,Жабдықтардың ағынына қарағанда...
Dialogue: 0,0:14:14.40,0:14:17.40,Default,,0,0,0,,Олар ауқымды нәрсе салып жатқан сияқты.
Dialogue: 0,0:14:17.40,0:14:20.00,Default,,0,0,0,,Бірақ қайда...
Dialogue: 0,0:14:25.08,0:14:28.08,Default,,0,0,0,,Толтырылған мысық мысықпен дөрекі.
Dialogue: 0,0:14:28.08,0:14:32.58,Default,,0,0,0,,Менің қолымнан келмейді! Мұнда қайда?
Dialogue: 0,0:14:38.76,0:14:42.59,Default,,0,0,0,,О
Dialogue: 0,0:14:42.59,0:14:44.99,Default,,0,0,0,,Ах... иә?
Dialogue: 0,0:14:55.11,0:14:58.31,Default,,0,0,0,,Мен адасып қалдым...
Dialogue: 0,0:15:02.38,0:15:05.72,Default,,0,0,0,,Мүмкін бұл Орочи жобасының кемесі шығар?
Dialogue: 0,0:15:05.72,0:15:08.39,Default,,0,0,0,,Бұл сиренаға ұқсайды
Dialogue: 0,0:15:08.39,0:15:11.72,Default,,0,0,0,,Шынымен де осындай нәрсені салу дұрыс па?
Dialogue: 0,0:15:11.72,0:15:16.42,Default,,0,0,0,,О? Akagi? Сен не істеп жатырсың?
Dialogue: 0,0:15:20.06,0:15:22.26,Default,,0,0,0,,Мияу!?
Dialogue: 0,0:15:29.41,0:15:31.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:31.41,0:15:36.41,Default,,0,0,0,,Егер осыншама энергия жиналса, Орочи жоспары жақын арада іске қосылады.
Dialogue: 0,0:15:36.41,0:15:38.71,Default,,0,0,0,,Ня!? Бұл...
Dialogue: 0,0:15:41.09,0:15:46.49,Default,,0,0,0,,Егер бұлай болса... жақсы, менің ойымша, тағы бір нәрсе бар.
Dialogue: 0,0:15:49.93,0:15:54.77,Default,,0,0,0,,Орочи жобасы кемеден көп нәрсені шығарады.
Dialogue: 0,0:15:54.77,0:16:00.57,Default,,0,0,0,,Олай дейтін болсаң, мынау теңізді кешіп, бар ойыңды арқалаған кеме.
Dialogue: 0,0:16:06.04,0:16:09.05,Default,,0,0,0,,Жақында кездесеміз бе? Оны жіберіңіз
Dialogue: 0,0:16:09.05,0:16:12.38,Default,,0,0,0,,Біреу білсе, қиын болады, бұл үлкен мәселе...
Dialogue: 0,0:16:12.38,0:16:15.39,Default,,0,0,0,,Мен шынымен біртүрлі нәрсені көрдім.
Dialogue: 0,0:16:15.39,0:16:19.06,Default,,0,0,0,,Сіз не істеп жатырсыз? Мияу!?
Dialogue: 0,0:16:19.06,0:16:22.39,Default,,0,0,0,,Көрдіңіз бе? Нана... Не айтып тұрсың?
Dialogue: 0,0:16:22.39,0:16:24.90,Default,,0,0,0,,Акаши: Мен жаңа ғана адасып қалдым...
Dialogue: 0,0:16:24.90,0:16:27.90,Default,,0,0,0,,Мияу!? О, сен оны көрдің!
Dialogue: 0,0:16:27.90,0:16:30.07,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:16:30.07,0:16:33.40,Default,,0,0,0,,Қызығушылығы мысықты өлтіреді.
Dialogue: 0,0:16:33.40,0:16:35.91,Default,,0,0,0,,Мияу! Өтінемін маған көмектесіңіз!
Dialogue: 0,0:16:35.91,0:16:40.08,Default,,0,0,0,,Күте тұрыңыз! Шие гүлінің ортасында маған еліктеуіңізге жол бермеймін.
Dialogue: 0,0:16:40.08,0:16:42.41,Default,,0,0,0,,Соны айтсаң да
Dialogue: 0,0:16:42.41,0:16:44.71,Default,,0,0,0,,Біз сені жалғыз қалдыра алмаймыз, солай ма?
Dialogue: 0,0:16:46.75,0:16:49.42,Default,,0,0,0,,Мияу!?
Dialogue: 0,0:16:49.42,0:16:52.42,Default,,0,0,0,,Сіз кімсіз!?
Dialogue: 0,0:16:52.42,0:16:54.72,Default,,0,0,0,,Ха!
Dialogue: 0,0:16:58.03,0:17:01.03,Default,,0,0,0,,Бұл ойнақы көрініс патшалық па?
Dialogue: 0,0:17:01.03,0:17:15.05,Default,,0,0,0,,♬～
Dialogue: 0,0:17:15.05,0:17:18.05,Default,,0,0,0,,Әпке!
Dialogue: 0,0:17:18.05,0:17:20.38,Default,,0,0,0,,Эдинбург!
Dialogue: 0,0:17:20.38,0:17:23.55,Default,,0,0,0,,Ей, у-у-у...
Dialogue: 0,0:17:23.55,0:17:28.39,Default,,0,0,0,,Ой-ау... Мен оны Шеффилдке алдым!
Dialogue: 0,0:17:28.39,0:17:30.69,Default,,0,0,0,,Шығу
Dialogue: 0,0:17:32.90,0:17:35.70,Default,,0,0,0,,Қарғыс атсын... менімен араласпа!
Dialogue: 0,0:17:39.57,0:17:43.47,Default,,0,0,0,,Бұл өте қиын! Қандай қателік, Акаги
Dialogue: 0,0:17:50.41,0:17:53.08,Default,,0,0,0,,Не болды!?
Dialogue: 0,0:17:53.08,0:17:55.78,Default,,0,0,0,,Бұл не!? Бұл не!?
Dialogue: 0,0:17:58.36,0:18:00.69,Default,,0,0,0,,Эй, не болып жатыр?
Dialogue: 0,0:18:00.69,0:18:04.19,Default,,0,0,0,,Фурутака: Сақтықты түсірме!
Dialogue: 0,0:18:06.36,0:18:09.37,Default,,0,0,0,,Мен жай ғана жеңіске жету мақсатымен келдім—
Dialogue: 0,0:18:09.37,0:18:12.37,Default,,0,0,0,,Мен алтын құйма алып жүргенді жөн көремін!
Dialogue: 0,0:18:12.37,0:18:14.87,Default,,0,0,0,,Қыңсылау кейінірек келеді Айтпақшы, бұл не?
Dialogue: 0,0:18:14.87,0:18:17.88,Default,,0,0,0,,Бонус: Акашиді артта қалдырмаңыз.
Dialogue: 0,0:18:17.88,0:18:19.88,Default,,0,0,0,,Менің артымнан неге ердің?
Dialogue: 0,0:18:19.88,0:18:22.05,Default,,0,0,0,,Осылай қалса, Акаши өшіріледі.
Dialogue: 0,0:18:22.05,0:18:25.22,Default,,0,0,0,,Аузыңды жаппа, өлілермен сөйлеспе...
Dialogue: 0,0:18:25.22,0:18:28.42,Default,,0,0,0,,Менің таңдауым жоқ. Мен жай ғана теңізге шығамын.
Dialogue: 0,0:18:36.39,0:18:39.06,Default,,0,0,0,,Егер мен сол кішкентай аралға барсам
Dialogue: 0,0:18:39.06,0:18:41.46,Default,,0,0,0,,Қауіпті! иә? Апыр-ай!
Dialogue: 0,0:18:45.74,0:18:48.91,Default,,0,0,0,,Қашпа! Мен мұнымен айналысамын.
Dialogue: 0,0:18:48.91,0:18:52.74,Default,,0,0,0,,Алға, Эдинбург! Бірақ... Бірақ Шефи!
Dialogue: 0,0:18:52.74,0:19:15.03,Default,,0,0,0,,♬～
Dialogue: 0,0:19:15.03,0:19:17.43,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:19.37,0:19:21.71,Default,,0,0,0,,Бұл ақылсыз...
Dialogue: 0,0:19:21.71,0:19:24.71,Default,,0,0,0,,Балық аулайтын бөтелке ұңғысының арқалығын кесіп, жаңбыр тамшыларының тастарын бұрғылаңыз
Dialogue: 0,0:19:24.71,0:19:29.05,Default,,0,0,0,,Менің жақсы үйретілген семсерім кеспейтін ештеңе жоқ!
Dialogue: 0,0:19:29.05,0:19:48.07,Default,,0,0,0,,♬～
Dialogue: 0,0:19:48.07,0:19:51.77,Default,,0,0,0,,Мұны жасамаңыз. Жау болса да таң қалдырады.
Dialogue: 0,0:20:00.75,0:20:03.08,Default,,0,0,0,,Сіз жаңасыз ба?
Dialogue: 0,0:20:03.08,0:20:06.42,Default,,0,0,0,,Не істеуім керек? Мен не істеуім керек...
Dialogue: 0,0:20:06.42,0:20:08.75,Default,,0,0,0,,Мм... қашып кетпейсің бе?
Dialogue: 0,0:20:08.75,0:20:11.45,Default,,0,0,0,,Мен бірдеңе істеуім керек...
Dialogue: 0,0:20:14.09,0:20:16.79,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:21.10,0:20:23.10,Default,,0,0,0,,(мотор дыбысы)
Dialogue: 0,0:20:23.10,0:20:25.77,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:20:25.77,0:20:29.27,Default,,0,0,0,,Эдинбург! Шефи, мұнда кел!
Dialogue: 0,0:20:29.27,0:20:32.61,Default,,0,0,0,,Уау! өрт! От жағып жатыр!
Dialogue: 0,0:20:32.61,0:20:35.78,Default,,0,0,0,,Бұл аздап... жаман.
Dialogue: 0,0:20:35.78,0:20:38.28,Default,,0,0,0,,Мұнда келме!
Dialogue: 0,0:20:38.28,0:20:41.45,Default,,0,0,0,,Тоқтаңыз!
Dialogue: 0,0:20:41.45,0:20:44.05,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:20:56.40,0:21:00.07,Default,,0,0,0,,Кешіріңіз, апа, жауды сағынып қалған сияқтымыз.
Dialogue: 0,0:21:00.07,0:21:03.07,Default,,0,0,0,,Иә, оған көмектесу мүмкін емес.
Dialogue: 0,0:21:03.07,0:21:06.24,Default,,0,0,0,,Қара жәшік олардың қолдарына түседі.
Dialogue: 0,0:21:06.24,0:21:08.91,Default,,0,0,0,,Іздеу тобын құрыңыз.
Dialogue: 0,0:21:08.91,0:21:12.08,Default,,0,0,0,,Бірақ бұл жақсы нәрсе болуы мүмкін.
Dialogue: 0,0:21:12.08,0:21:15.09,Default,,0,0,0,,Әпке? Azur Lane -
Dialogue: 0,0:21:15.09,0:21:19.79,Default,,0,0,0,,Егер сіз маған қара жәшік көтеруге көмектесуге дайын болсаңыз, мен сізге мейірімді боламын.
Dialogue: 0,0:21:23.43,0:21:26.26,Default,,0,0,0,,Кешіріңіз Аянами, сіз маған көмектестіңіз.
Dialogue: 0,0:21:26.26,0:21:28.60,Default,,0,0,0,,Жоқ, сенің аман болғаныңа қуаныштымын.
Dialogue: 0,0:21:28.60,0:21:31.44,Default,,0,0,0,,Аянами!
Dialogue: 0,0:21:31.44,0:21:34.36,Default,,0,0,0,,Уау~ Аянами, жақсысың ба?
Dialogue: 0,0:21:34.36,0:21:37.68,Default,,0,0,0,,Сәттілік құдайы Юкиказэ сенімен бірге.
Dialogue: 0,0:21:37.68,0:21:41.11,Default,,0,0,0,,Бәрі жақсы болатынына сенімдімін. Мен тағы да пойыздан қалып қойдым.
Dialogue: 0,0:21:41.11,0:21:44.45,Default,,0,0,0,,Мен тіпті Юудачимен де күрескім келеді...
Dialogue: 0,0:21:45.24,0:21:47.05,Default,,0,0,0,,Біз жақсы доспыз, солай емес пе?
Dialogue: 0,0:21:50.04,0:21:53.70,Default,,0,0,0,,Иә, мен қымбатты доспын.
Dialogue: 0,0:22:01.07,0:22:04.09,Default,,0,0,0,,Сондықтан Аянами барлығына арналған.
Dialogue: 0,0:22:04.40,0:22:20.40,Default,,0,0,0,,♬～
Dialogue: 0,0:22:21.90,0:22:27.90,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory