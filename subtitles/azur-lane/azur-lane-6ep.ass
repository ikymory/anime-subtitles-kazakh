Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.26,0:00:03.19,Default,,0,0,0,,Ах
Dialogue: 0,0:00:18.86,0:00:19.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:20.54,0:00:21.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:24.38,0:00:26.38,Default,,0,0,0,,Күте тұрыңыз, Аянами-чан!
Dialogue: 0,0:02:11.10,0:02:15.77,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:02:16.02,0:02:17.45,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:02:18.32,0:02:21.47,Default,,0,0,0,,Қайырлы таң, Кәсіпорын мырза.
Dialogue: 0,0:02:24.44,0:02:27.04,Default,,0,0,0,,Таңғы ас ішетін уақыт.
Dialogue: 0,0:02:34.52,0:02:36.21,Default,,0,0,0,,Мейрамханада тамақтанайық
Dialogue: 0,0:02:39.40,0:02:42.22,Default,,0,0,0,,Әлі біртүрлі өрнекті шалбар сізде бар ма?
Dialogue: 0,0:02:45.64,0:02:48.74,Default,,0,0,0,,Бұл тым көп емес пе? Ұстамаңыз
Dialogue: 0,0:02:50.22,0:02:53.80,Default,,0,0,0,,Оклахомалық жігіт саған қамқор болды, солай ма? Сол сыпайылық
Dialogue: 0,0:02:54.54,0:02:55.23,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:02:58.42,0:03:02.08,Default,,0,0,0,,Ах, қайырлы таң, Кәсіпорын мырза.
Dialogue: 0,0:03:02.08,0:03:03.74,Default,,0,0,0,,Ах, қайырлы таң.
Dialogue: 0,0:03:04.08,0:03:05.58,Default,,0,0,0,,Қайырлы таң, не жегің келеді?
Dialogue: 0,0:03:05.58,0:03:09.12,Default,,0,0,0,,Негізі бүгін базарда шалбар сатылып жатыр.
Dialogue: 0,0:03:10.48,0:03:11.96,Default,,0,0,0,,Сәлем кәсіпорын
Dialogue: 0,0:03:13.00,0:03:15.13,Default,,0,0,0,,Таңертеңнен бері көп тамақ жедің.
Dialogue: 0,0:03:15.43,0:03:18.43,Default,,0,0,0,,Жоқ, бұл... Ахах...
Dialogue: 0,0:03:20.76,0:03:21.58,Default,,0,0,0,,Фу…
Dialogue: 0,0:03:22.77,0:03:25.47,Default,,0,0,0,,Неге біз Белфастта отырмасқа?
Dialogue: 0,0:03:27.44,0:03:30.44,Default,,0,0,0,,Менде қызметші қыздың рөлі бар.
Dialogue: 0,0:03:32.44,0:03:35.44,Default,,0,0,0,,Мен мұның бәрін өзім жей алмаймын деп ойлаймын.
Dialogue: 0,0:03:38.78,0:03:43.48,Default,,0,0,0,,Егер солай болса, мен сізбен жұмыс істеуге қуаныштымын.
Dialogue: 0,0:03:51.80,0:03:54.47,Default,,0,0,0,,А... (Қорқа) Уау~
Dialogue: 0,0:03:54.47,0:03:56.73,Default,,0,0,0,,Ммм? Не болды?
Dialogue: 0,0:03:56.73,0:03:58.73,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:04:00.74,0:04:05.41,Default,,0,0,0,,Кәсіпорын-чан, көңіл-күйің сәл өзгерді ме деп ойлаймын.
Dialogue: 0,0:04:05.41,0:04:19.42,Default,,0,0,0,,♬～
Dialogue: 0,0:04:19.42,0:04:22.76,Default,,0,0,0,,Сәлем Кәсіпорын, қалыңыз қалай?
Dialogue: 0,0:04:22.76,0:04:25.43,Default,,0,0,0,,Ой, жаман емес, рахмет
Dialogue: 0,0:04:25.43,0:04:29.03,Default,,0,0,0,,Қазірдің өзінде... тойтарыс! Дәлізде жүгірме!
Dialogue: 0,0:04:31.10,0:04:33.77,Default,,0,0,0,,Сәлем, кәсіпорын!
Dialogue: 0,0:04:33.77,0:04:35.77,Default,,0,0,0,,Хехе
Dialogue: 0,0:04:39.78,0:04:43.11,Default,,0,0,0,,Сен маған әпкелеріңді таныстырмадың ба?
Dialogue: 0,0:04:43.11,0:04:45.12,Default,,0,0,0,,Әй, сәлем айт.
Dialogue: 0,0:04:45.12,0:04:49.45,Default,,0,0,0,,Танысқаныма қуаныштымын, Колумбия, Кливленд класының екінші кемесі.
Dialogue: 0,0:04:49.45,0:04:53.12,Default,,0,0,0,,Бұл үшінші кеме Монпелье. Маған әпкем қамқор болды.
Dialogue: 0,0:04:53.12,0:04:57.73,Default,,0,0,0,,Бұл төртінші кеме, Денвер. Кейіпкерімізбен танысу үлкен мәртебе.
Dialogue: 0,0:04:57.73,0:05:00.40,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:05:00.40,0:05:05.07,Default,,0,0,0,,Мен апаларымды мақтан тұтамын. Жоқ, әпкелеріммен салыстырғанда мен...
Dialogue: 0,0:05:05.07,0:05:08.07,Default,,0,0,0,,Клив апа ең жақсы!
Dialogue: 0,0:05:08.07,0:05:10.07,Default,,0,0,0,,Эй... Эй... Эй!
Dialogue: 0,0:05:10.07,0:05:13.08,Default,,0,0,0,,Сіз әрқашан мұндай нәрсені жақсы деп айтасыз, солай ма?
Dialogue: 0,0:05:13.08,0:05:15.75,Default,,0,0,0,,Біз апалы-сіңліліміз, жақсы араласамыз.
Dialogue: 0,0:05:15.75,0:05:19.75,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:19.75,0:05:21.75,Default,,0,0,0,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:05:21.75,0:05:24.76,Default,,0,0,0,,Джузакурадан тапқан затқа не болды?
Dialogue: 0,0:05:24.76,0:05:27.76,Default,,0,0,0,,Иә, егер солай болса...
Dialogue: 0,0:05:32.76,0:05:35.43,Default,,0,0,0,,Қара... Психикалық текше...
Dialogue: 0,0:05:35.43,0:05:39.03,Default,,0,0,0,,Сиреннің технологиясын қолданатын Жузакураның козирі ме?
Dialogue: 0,0:05:41.11,0:05:44.11,Default,,0,0,0,,Егер сізде бұл болса, сіз сол жаппай шығарылған Сиренаны пайдалана аласыз...
Dialogue: 0,0:05:44.11,0:05:46.11,Default,,0,0,0,,Оны бейтараптандыру мүмкін емес пе?
Dialogue: 0,0:05:46.11,0:05:48.78,Default,,0,0,0,,Орочи - жаппай шығарылатын түрін басқарады.
Dialogue: 0,0:05:48.78,0:05:51.12,Default,,0,0,0,,Бұл жай ғана көмек.
Dialogue: 0,0:05:51.12,0:05:53.45,Default,,0,0,0,,«Орочи» алып әскери кемесі...
Dialogue: 0,0:05:53.45,0:05:56.39,Default,,0,0,0,,Мен Шигезакураның мұндай нәрсені салғанына сене алар емеспін.
Dialogue: 0,0:05:56.39,0:05:59.99,Default,,0,0,0,,Орочидің бұл текшемен қандай қатынасы бар?
Dialogue: 0,0:06:02.06,0:06:06.06,Default,,0,0,0,,Біздің білетініміз, бұл текшені бізге Сирена берген...
Dialogue: 0,0:06:06.06,0:06:09.76,Default,,0,0,0,,Акаги сол сиренамен бірігіп жатыр.
Dialogue: 0,0:06:12.07,0:06:15.74,Default,,0,0,0,,Егер бұл рас болса, онда шие ағашының өзі алданып қалған.
Dialogue: 0,0:06:15.74,0:06:18.41,Default,,0,0,0,,...
Dialogue: 0,0:06:18.41,0:06:22.01,Default,,0,0,0,,Акаги, сен не ойлап тұрсың...?
Dialogue: 0,0:06:24.08,0:06:26.08,Default,,0,0,0,,Ах
Dialogue: 0,0:06:40.10,0:06:42.10,Default,,0,0,0,,((Na…
Dialogue: 0,0:06:46.44,0:06:48.44,Default,,0,0,0,,Ах...))
Dialogue: 0,0:06:59.05,0:07:01.05,Default,,0,0,0,,Құрметті кәсіпорын
Dialogue: 0,0:07:01.05,0:07:04.05,Default,,0,0,0,,Ха... қалай болды?
Dialogue: 0,0:07:04.05,0:07:07.06,Default,,0,0,0,,Көңіл-күйің жоқ сияқты көрінді.
Dialogue: 0,0:07:07.06,0:07:09.73,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:07:09.73,0:07:13.03,Default,,0,0,0,,Жарайды, ештеңе емес.
Dialogue: 0,0:07:22.41,0:07:25.08,Default,,0,0,0,,Қараңызшы, бұл сізге жақсы көрінеді, солай ма?
Dialogue: 0,0:07:25.08,0:07:27.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:27.08,0:07:30.08,Default,,0,0,0,,Маған қарағанда әпкемнің осындай киім кигені жақсы болар еді...
Dialogue: 0,0:07:30.08,0:07:34.42,Default,,0,0,0,,Бұл дұрыс емес, жай ғана қараңыз.
Dialogue: 0,0:07:34.42,0:07:38.72,Default,,0,0,0,,Мен ойлағандай. Бұл түс Кагаға жақсы көрінеді.
Dialogue: 0,0:07:41.09,0:07:43.09,Default,,0,0,0,,Мен мұны аламын.
Dialogue: 0,0:07:43.09,0:07:45.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:50.10,0:07:52.10,Default,,0,0,0,,Тайяки тамақ ішу
Dialogue: 0,0:07:52.10,0:07:55.11,Default,,0,0,0,,Бұл дүкеннің құйрығында қызыл бұршақ пастасы да бар.
Dialogue: 0,0:07:55.11,0:07:57.71,Default,,0,0,0,,Асықпасаңыз, сатылып кетеді. Күтіңіз~
Dialogue: 0,0:07:57.71,0:07:59.71,Default,,0,0,0,,Мен бұл кішкентайды не болса да ынталандырып отыруым керек
Dialogue: 0,0:07:59.71,0:08:02.05,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:08:02.05,0:08:05.72,Default,,0,0,0,,Оны артта қалдырмаңыз! Ахх...
Dialogue: 0,0:08:05.72,0:08:07.72,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:07.72,0:08:09.72,Default,,0,0,0,,Ах
Dialogue: 0,0:08:09.72,0:08:13.02,Default,,0,0,0,,Уф... у... а!
Dialogue: 0,0:08:15.06,0:08:17.39,Default,,0,0,0,,Колла, жүгіру қауіпті.
Dialogue: 0,0:08:17.39,0:08:20.73,Default,,0,0,0,,А... не істеуім керек...
Dialogue: 0,0:08:20.73,0:08:23.40,Default,,0,0,0,,Мм... Кешіріңіз.
Dialogue: 0,0:08:23.40,0:08:26.74,Default,,0,0,0,,Бұл ерке емес~ Ой? Не болды?
Dialogue: 0,0:08:26.74,0:08:29.07,Default,,0,0,0,,Өтінемін... тамақ ішпеңіз...
Dialogue: 0,0:08:29.07,0:08:31.77,Default,,0,0,0,,Тоқта, мен ашуланбаймын...
Dialogue: 0,0:08:33.74,0:08:36.08,Default,,0,0,0,,Пико, ол шырылдайды!
Dialogue: 0,0:08:36.08,0:08:38.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:38.08,0:08:41.08,Default,,0,0,0,,Әй, Қаға, бұл жақсы емес.
Dialogue: 0,0:08:41.08,0:08:45.42,Default,,0,0,0,,Ондай кішкентай баланы жылатпа, апа!
Dialogue: 0,0:08:45.42,0:08:48.76,Default,,0,0,0,,Мм... мм...
Dialogue: 0,0:08:48.76,0:08:50.76,Default,,0,0,0,,Мен Иносукэні құтқарамын
Dialogue: 0,0:08:50.76,0:08:53.76,Default,,0,0,0,,Муцукидің Аме-саны, мен саған бәрін беремін, сондықтан мені кешірші!
Dialogue: 0,0:08:53.76,0:08:57.37,Default,,0,0,0,,Жоқ, сондықтан... хехехе
Dialogue: 0,0:08:57.37,0:09:00.67,Default,,0,0,0,,Олай болса, мен оны аламын деп ойлаймын...
Dialogue: 0,0:09:04.71,0:09:07.38,Default,,0,0,0,,Хехехе
Dialogue: 0,0:09:07.38,0:09:11.98,Default,,0,0,0,,Мен де Қағаны кешіремін, солай ма? Е... иә...
Dialogue: 0,0:09:16.05,0:09:19.06,Default,,0,0,0,,Бұл дұрыс кешірім сұрай білудің сыйы.
Dialogue: 0,0:09:19.06,0:09:22.76,Default,,0,0,0,,Оны барлығымен бөлісу жақсы болар еді. А... иә?
Dialogue: 0,0:09:27.40,0:09:29.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:32.07,0:09:35.07,Default,,0,0,0,,Рахмет, әпке!
Dialogue: 0,0:09:35.07,0:09:37.41,Default,,0,0,0,,Тайяки! Асығыңыз, асығыңыз!
Dialogue: 0,0:09:37.41,0:09:39.74,Default,,0,0,0,,Мен де конпейто жеймін~
Dialogue: 0,0:09:39.74,0:09:43.08,Default,,0,0,0,,Мүлдем... Мен саған жүгірме дедім ғой.
Dialogue: 0,0:09:43.08,0:09:45.08,Default,,0,0,0,,Сәлем Қаға
Dialogue: 0,0:09:45.08,0:09:49.75,Default,,0,0,0,,Мен бұл балалар мәңгі бірге болады деп үміттенемін.
Dialogue: 0,0:09:49.75,0:09:51.75,Default,,0,0,0,,Бірақ ол неге—
Dialogue: 0,0:09:58.43,0:10:01.43,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:10:07.77,0:10:10.44,Default,,0,0,0,,Көптеген керемет ұсыныстар бар!
Dialogue: 0,0:10:10.44,0:10:13.78,Default,,0,0,0,,Сатып алуды жіберіп алсаңыз, өкінесіз~
Dialogue: 0,0:10:13.78,0:10:18.12,Default,,0,0,0,,Балапандар! Мұны оқып, аздап үйреніңіз!
Dialogue: 0,0:10:18.12,0:10:20.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:29.13,0:10:32.46,Default,,0,0,0,,Дүкендердің саны артып келеді
Dialogue: 0,0:10:32.46,0:10:34.76,Default,,0,0,0,,Бұл өте жанды, солай емес пе?
Dialogue: 0,0:10:39.14,0:10:41.81,Default,,0,0,0,,Не!? Сіз соншалықты көп жейсіз бе?
Dialogue: 0,0:10:41.81,0:10:44.14,Default,,0,0,0,,Бұл менің апама арналған кәдесый.
Dialogue: 0,0:10:44.14,0:10:47.81,Default,,0,0,0,,Уау... бұл өте ассортимент.
Dialogue: 0,0:10:47.81,0:10:50.51,Default,,0,0,0,,Оны оқу материалы ретінде пайдалануға болатын сияқты.
Dialogue: 0,0:10:53.82,0:10:56.75,Default,,0,0,0,,Адамдардың қаласы сияқты.
Dialogue: 0,0:10:56.75,0:10:59.42,Default,,0,0,0,,Біз адамбыз.
Dialogue: 0,0:10:59.42,0:11:03.09,Default,,0,0,0,,Сіз тағы да сол нәрсені айтып отырсыз.
Dialogue: 0,0:11:03.09,0:11:06.49,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:11:10.10,0:11:14.77,Default,,0,0,0,,Кәсіпорынға қажет нәрсе - бұл ақылдылық.
Dialogue: 0,0:11:14.77,0:11:18.78,Default,,0,0,0,,Не? Мен мұны шынымен түсінбеймін.
Dialogue: 0,0:11:18.78,0:11:21.78,Default,,0,0,0,,Сіз мені өзіңізбен бірге қызметші болып жұмыс істеуімді сұрайсыз ба?
Dialogue: 0,0:11:21.78,0:11:24.11,Default,,0,0,0,,О, сен сенімдісің бе?
Dialogue: 0,0:11:24.11,0:11:28.45,Default,,0,0,0,,Мен сені ешқайда көрінуге ұялмайтын тамаша қызметші етіп дайындаймын.
Dialogue: 0,0:11:28.45,0:11:32.12,Default,,0,0,0,,А... жоқ, бұл...
Dialogue: 0,0:11:32.12,0:11:34.62,Default,,0,0,0,,Уау
Dialogue: 0,0:11:34.62,0:11:37.29,Default,,0,0,0,,Әйтеуір, қызметші...
Dialogue: 0,0:11:37.29,0:11:41.13,Default,,0,0,0,,Менің ойымша, жаңа нәрсені сынап көру жақсы идея.
Dialogue: 0,0:11:41.13,0:11:46.80,Default,,0,0,0,,Ұрысудан басқа нәрсемен айналысыңыз, мейлі ол хобби немесе қандай да бір жұмыс түрі болсын.
Dialogue: 0,0:11:46.80,0:11:49.81,Default,,0,0,0,,Бұл мен үшін сынақ.
Dialogue: 0,0:11:49.81,0:11:52.48,Default,,0,0,0,,Барлығы сынақ.
Dialogue: 0,0:11:52.48,0:11:55.48,Default,,0,0,0,,Өмір әрқашан шытырман оқиға
Dialogue: 0,0:11:57.41,0:11:59.41,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:12:01.42,0:12:03.42,Default,,0,0,0,,Мазалағаныңызға рахмет.
Dialogue: 0,0:12:03.42,0:12:08.42,Default,,0,0,0,,Сондықтан да біз адам кейпін алдық.
Dialogue: 0,0:12:11.76,0:12:13.76,Default,,0,0,0,,(Ватару) Не болып жатыр? Бұл әңгіме… (Ер оқушы) Ол ұялы телефонымен дауласып жатыр.
Dialogue: 0,0:12:17.77,0:12:19.77,Default,,0,0,0,,Я...
Dialogue: 0,0:12:24.44,0:12:28.78,Default,,0,0,0,,Уф... Жылтырақ па?
Dialogue: 0,0:12:28.78,0:12:31.78,Default,,0,0,0,,Біз жаумыз
Dialogue: 0,0:12:41.79,0:12:43.79,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:12:49.47,0:12:52.47,Default,,0,0,0,,Бірақ... Мен еш өкінгім келмейді!
Dialogue: 0,0:12:52.47,0:12:54.47,Default,,0,0,0,,Кя!
Dialogue: 0,0:12:57.41,0:13:00.08,Default,,0,0,0,,Найза Боспаңыз
Dialogue: 0,0:13:00.08,0:13:02.75,Default,,0,0,0,,Ах...хехе
Dialogue: 0,0:13:02.75,0:13:05.42,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:13:05.42,0:13:08.42,Default,,0,0,0,,Бұл сіздің қайтып келуіңіз!
Dialogue: 0,0:13:08.42,0:13:10.75,Default,,0,0,0,,Бар күшіңмен жүр
Dialogue: 0,0:13:10.75,0:13:12.76,Default,,0,0,0,,Не? Апыр-ай!
Dialogue: 0,0:13:12.76,0:13:14.76,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:13:14.76,0:13:16.76,Default,,0,0,0,,Эй, эй... қазірдің өзінде!
Dialogue: 0,0:13:18.76,0:13:21.43,Default,,0,0,0,,≪Оны қайдан сатып алдыңыз? сол
Dialogue: 0,0:13:21.43,0:13:24.03,Default,,0,0,0,,≪Мен де соны қалаймын.
Dialogue: 0,0:13:30.44,0:13:32.78,Default,,0,0,0,,Әпке, сен ол шалбарды неге кидің?
Dialogue: 0,0:13:32.78,0:13:36.08,Default,,0,0,0,,Маған кейінірек көрсетіңіз, бұл Оклахома.
Dialogue: 0,0:13:39.45,0:13:42.45,Default,,0,0,0,,Иә? Unicorn? Ах...
Dialogue: 0,0:13:44.45,0:13:46.46,Default,,0,0,0,,Мен осы құдай таңдаған ессіз ғалыммын…
Dialogue: 0,0:13:46.46,0:13:50.79,Default,,0,0,0,,Сен неге дымқылсың? Бұл... Ахахха...
Dialogue: 0,0:13:50.79,0:13:54.46,Default,,0,0,0,,Бір мүйізді мүйізді мүйізді де шомылады ма? Сосын бірге кірейік.
Dialogue: 0,0:13:54.46,0:13:58.07,Default,,0,0,0,,Иә!? Бірмүйіз - бұл...
Dialogue: 0,0:13:58.07,0:14:01.07,Default,,0,0,0,,Суық. Осылай қалсаң, суық тиіп қаласың.
Dialogue: 0,0:14:01.07,0:14:05.47,Default,,0,0,0,,Сасаса, тез, тез Ах... у...
Dialogue: 0,0:14:09.41,0:14:12.75,Default,,0,0,0,,Уау, бұл керемет!
Dialogue: 0,0:14:12.75,0:14:15.75,Default,,0,0,0,,Әпке, барлық патша адамдары...
Dialogue: 0,0:14:15.75,0:14:18.75,Default,,0,0,0,,Сіз осылай ересектерге арналған іш киім киесіз бе?
Dialogue: 0,0:14:24.09,0:14:26.76,Default,,0,0,0,,Эй, мұнда не болып жатыр?
Dialogue: 0,0:14:26.76,0:14:29.77,Default,,0,0,0,,Сіз шалбарға шынымен ерекше қарайсыз ба?
Dialogue: 0,0:14:29.77,0:14:32.77,Default,,0,0,0,,Жоқ, мен оны кимеймін.
Dialogue: 0,0:14:34.77,0:14:37.11,Default,,0,0,0,,Кешіріңіз, мен сізді анық ести алмадым.
Dialogue: 0,0:14:37.11,0:14:39.51,Default,,0,0,0,,Сондықтан мен оны кимеймін.
Dialogue: 0,0:14:41.44,0:14:43.45,Default,,0,0,0,,Иә!? О~
Dialogue: 0,0:14:43.45,0:14:48.12,Default,,0,0,0,,На... а... а...
Dialogue: 0,0:14:48.12,0:14:50.52,Default,,0,0,0,,Ача~
Dialogue: 0,0:14:52.46,0:14:54.46,Default,,0,0,0,,Тез шомылыңыз
Dialogue: 0,0:14:54.46,0:14:56.73,Default,,0,0,0,,Не? Тіпті мұндай асықпау керек болса да
Dialogue: 0,0:14:56.73,0:14:59.40,Default,,0,0,0,,Су салқындайды. Суық болмайды.
Dialogue: 0,0:14:59.40,0:15:02.40,Default,,0,0,0,,Жалғыз мүйізді-чан, әрі қарай жүрейік.
Dialogue: 0,0:15:21.75,0:15:24.75,Default,,0,0,0,,≪Ах~ Жақсы сезінеді~
Dialogue: 0,0:15:24.75,0:15:27.09,Default,,0,0,0,,Yaho! Ваннаға!
Dialogue: 0,0:15:27.09,0:15:29.43,Default,,0,0,0,,Колла Жүгіру қауіпті!
Dialogue: 0,0:15:29.43,0:15:32.10,Default,,0,0,0,,Yotto! (Норфолк) О, сонда...
Dialogue: 0,0:15:32.10,0:15:35.43,Default,,0,0,0,,Аба баба! Мен жыртылып қалдым~
Dialogue: 0,0:15:35.43,0:15:38.44,Default,,0,0,0,,А... неге...
Dialogue: 0,0:15:38.44,0:15:41.04,Default,,0,0,0,,Ванна қыжылдап жатыр...
Dialogue: 0,0:15:45.11,0:15:48.51,Default,,0,0,0,,Элдридж-чан электр энергиясын шығарады...
Dialogue: 0,0:15:51.11,0:15:55.12,Default,,0,0,0,,Әпке, патша адамдары керемет.
Dialogue: 0,0:15:55.12,0:15:58.52,Default,,0,0,0,,Уф... уау!
Dialogue: 0,0:16:00.39,0:16:03.39,Default,,0,0,0,,Шынымен... Мен оны киген жоқпын...
Dialogue: 0,0:16:03.39,0:16:05.40,Default,,0,0,0,,Уф~
Dialogue: 0,0:16:05.40,0:16:09.40,Default,,0,0,0,,Жұмыстан кейін ыстық бұлақта шомылу керемет.
Dialogue: 0,0:16:12.07,0:16:15.74,Default,,0,0,0,,Менің патша қолымнан жасалған терме стиліндегі қоғамдық монша.
Dialogue: 0,0:16:16.12,0:16:19.41,Default,,0,0,0,,Ыстық бұлақ тек Жузакураға арналған деп ойламаңыз.
Dialogue: 0,0:16:19.76,0:16:21.48,Default,,0,0,0,,Күткендей, Мәртебелі.
Dialogue: 0,0:16:22.08,0:16:25.50,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:16:30.82,0:16:31.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:35.18,0:16:38.74,Default,,0,0,0,,Уау~ Бір мүйізді-чанның кеудесі үлкен!?
Dialogue: 0,0:16:39.56,0:16:41.02,Default,,0,0,0,,А... иә?
Dialogue: 0,0:16:44.43,0:16:47.43,Default,,0,0,0,,Иә!? Не болды... Бір мүйізді-чан!
Dialogue: 0,0:16:51.64,0:16:54.92,Default,,0,0,0,,Жалғыз мүйізді қысқа болса да...
Dialogue: 0,0:16:55.44,0:16:59.03,Default,,0,0,0,,Менің кеудем ғана, бұл сондай біртүрлі...
Dialogue: 0,0:16:59.72,0:17:01.79,Default,,0,0,0,,Менің ойымша, олай емес.
Dialogue: 0,0:17:02.05,0:17:03.30,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:05.20,0:17:09.30,Default,,0,0,0,,Unicorn Жақсы стиль және керемет
Dialogue: 0,0:17:10.26,0:17:11.30,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:17:12.06,0:17:13.30,Default,,0,0,0,,Өтірік емес
Dialogue: 0,0:17:14.12,0:17:18.18,Default,,0,0,0,,Бірақ бір мүйізділер басқалардан ерекшеленеді...
Dialogue: 0,0:17:18.66,0:17:22.18,Default,,0,0,0,,Әркім әр түрлі Әрине Иә Иә
Dialogue: 0,0:17:22.52,0:17:24.44,Default,,0,0,0,,Біртүрлі адамдар жоқ.
Dialogue: 0,0:17:27.76,0:17:29.41,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:31.68,0:17:32.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:33.42,0:17:53.44,Default,,0,0,0,,♬～
Dialogue: 0,0:17:53.44,0:17:56.74,Default,,0,0,0,,Иә... Менің ойымша.
Dialogue: 0,0:18:05.38,0:18:06.70,Default,,0,0,0,,Уау
Dialogue: 0,0:18:07.38,0:18:09.48,Default,,0,0,0,,Окаринге не болды екен?
Dialogue: 0,0:18:10.05,0:18:11.98,Default,,0,0,0,,Иә, өте
Dialogue: 0,0:18:13.12,0:18:16.04,Default,,0,0,0,,Хехехехехе...
Dialogue: 0,0:18:16.39,0:18:42.92,Default,,0,0,0,,♬～
Dialogue: 0,0:18:42.92,0:18:46.32,Default,,0,0,0,,Аянами-чан? Сол кездегі бала?
Dialogue: 0,0:18:47.90,0:18:50.27,Default,,0,0,0,,Біз жау болсақ та...
Dialogue: 0,0:18:50.52,0:18:53.06,Default,,0,0,0,,Мен бұл туралы қателесуім мүмкін, бірақ...
Dialogue: 0,0:18:55.26,0:18:57.28,Default,,0,0,0,,Бірақ мен бас тартқым келмейді
Dialogue: 0,0:18:58.03,0:19:01.78,Default,,0,0,0,,Мен Аянами-чанмен дос болғым келеді
Dialogue: 0,0:19:04.37,0:19:08.04,Default,,0,0,0,,Жалғыз мүйізді мен ол қыз туралы әлі ештеңе білмеймін.
Dialogue: 0,0:19:08.04,0:19:10.56,Default,,0,0,0,,Сондықтан мен бұлай күресуді жалғастырғым келмейді.
Dialogue: 0,0:19:10.80,0:19:13.74,Default,,0,0,0,,Лаффи және басқалары, әлі ештеңе басталған жоқ.
Dialogue: 0,0:19:15.14,0:19:16.39,Default,,0,0,0,,Иә
Dialogue: 0,0:19:16.39,0:19:32.74,Default,,0,0,0,,♬～
Dialogue: 0,0:19:32.92,0:19:36.19,Default,,0,0,0,,((Йорктаун: Адамдар сіздің атыңызға қойған сезімдер...
Dialogue: 0,0:19:36.68,0:19:39.45,Default,,0,0,0,,Бір күні есімде болатынына сенімдімін))
Dialogue: 0,0:19:55.76,0:19:59.10,Default,,0,0,0,,Құрметті Кәсіпорын, ұйықтай алмай жүрсіз бе?
Dialogue: 0,0:19:59.10,0:20:02.77,Default,,0,0,0,,Мені теңіз жағасы шақырғандай...
Dialogue: 0,0:20:03.54,0:20:04.62,Default,,0,0,0,,Әзіл.
Dialogue: 0,0:20:05.36,0:20:09.26,Default,,0,0,0,,Кейде сирек кездеседі, солай емес пе?
Dialogue: 0,0:20:09.26,0:20:11.88,Default,,0,0,0,,Мүмкін мен аздап сентименталданып жатқан шығармын.
Dialogue: 0,0:20:12.78,0:20:15.02,Default,,0,0,0,,Өзіңізді суытып алмаңыз
Dialogue: 0,0:20:17.04,0:20:19.50,Default,,0,0,0,,Бұл кеште кофе жоқ.
Dialogue: 0,0:20:20.45,0:20:21.54,Default,,0,0,0,,Ах
Dialogue: 0,0:20:22.45,0:20:24.24,Default,,0,0,0,,Хехехе
Dialogue: 0,0:20:27.62,0:20:29.76,Default,,0,0,0,,Нашар ересек
Dialogue: 0,0:20:40.04,0:20:41.26,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:20:42.12,0:20:42.98,Default,,0,0,0,,О
Dialogue: 0,0:20:45.22,0:20:47.77,Default,,0,0,0,,Мен тыныш теңізді жек көрмеймін.
Dialogue: 0,0:20:57.56,0:21:00.42,Default,,0,0,0,,Әй, әдемі екен, Ақағидың сезімі.
Dialogue: 0,0:21:00.76,0:21:02.00,Default,,0,0,0,,Рұқсатсыз кіруге болмайды
Dialogue: 0,0:21:02.22,0:21:05.60,Default,,0,0,0,,Жарайды, мен де сенімен ішіп алғым келеді.
Dialogue: 0,0:21:05.92,0:21:06.78,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:21:07.62,0:21:09.03,Default,,0,0,0,,Алкогольдің дәмі жағымсыз
Dialogue: 0,0:21:09.39,0:21:12.29,Default,,0,0,0,,Хехе, мен бұрынғыдай жалықтым.
Dialogue: 0,0:21:12.94,0:21:17.04,Default,,0,0,0,,Қара ой текшесін алып кетсе де, уақытым аз қалды.
Dialogue: 0,0:21:17.86,0:21:20.44,Default,,0,0,0,,Балалар, сендер не ойлап тұрсыңдар?
Dialogue: 0,0:21:20.66,0:21:22.78,Default,,0,0,0,,Сізге білудің қажеті жоқ
Dialogue: 0,0:21:22.78,0:21:24.34,Default,,0,0,0,,Сіз және Акаги...
Dialogue: 0,0:21:25.11,0:21:27.93,Default,,0,0,0,,Біз шынымен бірдей нәрсені көріп отырмыз ба?
Dialogue: 0,0:21:29.82,0:21:31.34,Default,,0,0,0,,Уайымдама!!
Dialogue: 0,0:21:35.62,0:21:37.62,Default,,0,0,0,,Жауапсыз махаббат азап, солай емес пе?
Dialogue: 0,0:21:39.84,0:21:42.38,Default,,0,0,0,,Гутен Нахт Түніңіз жақсы өтсін
Dialogue: 0,0:21:43.66,0:21:45.10,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:21:51.14,0:21:54.81,Default,,0,0,0,,Жақында кездесеміз... Жақында кездесеміз.
Dialogue: 0,0:21:57.33,0:21:58.70,Default,,0,0,0,,Амаги апа
Dialogue: 0,0:21:59.42,0:22:19.42,Default,,0,0,0,,♬～
Dialogue: 0,0:22:20.92,0:22:26.92,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory