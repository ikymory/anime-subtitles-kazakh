Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.30,0:00:17.64,Default,,0,0,0,,♬～
Dialogue: 0,0:00:17.64,0:00:20.81,Default,,0,0,0,,Иә Арнайы теңіз аймағының ыдырауына байланысты -
Dialogue: 0,0:00:20.81,0:00:24.32,Default,,0,0,0,,Бұл жердегі кеңістік тұрақсыз сияқты.
Dialogue: 0,0:00:24.32,0:00:27.32,Default,,0,0,0,,Мұның бәрі сиреналардың жұмысы ма?
Dialogue: 0,0:00:27.32,0:00:32.00,Default,,0,0,0,,Шигесакураның Орочи жоспары және Кәсіпорын тудырған жұмбақ құбылыс.
Dialogue: 0,0:00:32.00,0:00:33.84,Default,,0,0,0,,Менің ойымша, бұл байланыссыз.
Dialogue: 0,0:00:33.84,0:00:36.14,Default,,0,0,0,,Сиренаның жоспарларын бұзу үшін...
Dialogue: 0,0:00:36.98,0:00:39.38,Default,,0,0,0,,Ауыр шие гүлдерін сағынуға болмайды.
Dialogue: 0,0:00:43.24,0:00:46.87,Default,,0,0,0,,Әпке... Қызық, не болып жатыр?
Dialogue: 0,0:00:47.08,0:00:50.90,Default,,0,0,0,,Мен мұны түсінбеймін...
Dialogue: 0,0:00:51.64,0:00:54.71,Default,,0,0,0,,Не істедің... Әпке?
Dialogue: 0,0:00:54.71,0:01:04.99,Default,,0,0,0,,♬～
Dialogue: 0,0:01:05.36,0:01:06.90,Default,,0,0,0,,Құрметті кәсіпорын
Dialogue: 0,0:02:44.33,0:02:47.00,Default,,0,0,0,,Кучи... суық...
Dialogue: 0,0:02:47.00,0:02:49.00,Default,,0,0,0,,Мен бәрінен айырылдым...
Dialogue: 0,0:02:49.00,0:02:51.40,Default,,0,0,0,,Мен флотпен тез кездесуім керек...
Dialogue: 0,0:02:51.50,0:02:53.90,Default,,0,0,0,,(Қарлы боран)
Dialogue: 0,0:02:58.28,0:03:01.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:01.54,0:03:02.99,Default,,0,0,0,,Аянами-чан...
Dialogue: 0,0:03:04.86,0:03:07.75,Default,,0,0,0,,《Кәсіпорын: Бір кездері дүние қарапайым еді.
Dialogue: 0,0:03:08.76,0:03:11.12,Default,,0,0,0,,Біз күресу үшін бармыз...
Dialogue: 0,0:03:11.79,0:03:13.66,Default,,0,0,0,,Жау – сырттан келген басқыншы
Dialogue: 0,0:03:14.34,0:03:17.76,Default,,0,0,0,,Ал адамзат бұрышқа тығылды
Dialogue: 0,0:03:19.00,0:03:20.64,Default,,0,0,0,,Дүние қатал болды, бірақ...
Dialogue: 0,0:03:21.13,0:03:22.98,Default,,0,0,0,,Шайқаста еш кідіріс болған жоқ.
Dialogue: 0,0:03:24.30,0:03:27.16,Default,,0,0,0,,Соғыс және қорғаныс
Dialogue: 0,0:03:27.80,0:03:31.77,Default,,0,0,0,,Екеуі дәйекті және тең болды.
Dialogue: 0,0:03:34.84,0:03:35.80,Default,,0,0,0,,《Алайда...》
Dialogue: 0,0:03:44.65,0:03:48.54,Default,,0,0,0,,Хекшун (Аянами) Тағы да солай...
Dialogue: 0,0:03:48.98,0:03:51.30,Default,,0,0,0,,Неге ұрыспайсың!
Dialogue: 0,0:03:51.30,0:03:54.16,Default,,0,0,0,,Балалар, сендер нені айтасыңдар?
Dialogue: 0,0:03:54.16,0:03:55.92,Default,,0,0,0,,Мен мұны бұрын да айтқанмын
Dialogue: 0,0:03:56.17,0:03:58.68,Default,,0,0,0,,Мен Аянамимен дос болғым келеді
Dialogue: 0,0:03:58.68,0:04:02.06,Default,,0,0,0,,Иә! Біз Аянами-чанмен дос болдық...
Dialogue: 0,0:04:02.06,0:04:04.61,Default,,0,0,0,,Жаулар бір-біріне не дейді?
Dialogue: 0,0:04:04.90,0:04:07.43,Default,,0,0,0,,Маңызды емес Бұл бар!
Dialogue: 0,0:04:08.02,0:04:13.28,Default,,0,0,0,,Аянами және басқалары кеме болғандықтан, олардың жаумен соғысуы заңды!
Dialogue: 0,0:04:13.66,0:04:14.72,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:04:15.79,0:04:18.24,Default,,0,0,0,,Біз соншалықты қарапайым емеспіз!
Dialogue: 0,0:04:20.62,0:04:22.34,Default,,0,0,0,,Қауіпті! Кя!
Dialogue: 0,0:04:24.36,0:04:27.66,Default,,0,0,0,,Гарруруру! Аянамиді қорламаңыз!
Dialogue: 0,0:04:30.97,0:04:32.14,Default,,0,0,0,,Міне!
Dialogue: 0,0:04:32.54,0:04:34.82,Default,,0,0,0,,Күте тұрыңыз! Біз күресуге дайынбыз...!
Dialogue: 0,0:04:37.31,0:04:39.48,Default,,0,0,0,,Қолыңызға түспесін!
Dialogue: 0,0:04:39.48,0:04:42.28,Default,,0,0,0,,Сен неге сонша ретсізсің? Тез қашайық!
Dialogue: 0,0:04:42.28,0:04:45.64,Default,,0,0,0,,Ха ха ха! Мен шайқасты саған қалдырамын!
Dialogue: 0,0:04:45.64,0:04:47.72,Default,,0,0,0,,Келесі жолы кездессек, мен саған мейірім көрсетпеймін!
Dialogue: 0,0:04:48.15,0:04:49.14,Default,,0,0,0,,Аянами-чан!
Dialogue: 0,0:04:50.15,0:04:52.06,Default,,0,0,0,,Кя! (Лаффи) Найза
Dialogue: 0,0:04:58.26,0:04:59.48,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:05:01.26,0:05:02.77,Default,,0,0,0,,Белфаст мырза...
Dialogue: 0,0:05:03.10,0:05:05.72,Default,,0,0,0,,Кеттік. Бұл жерде қауіпті.
Dialogue: 0,0:05:17.61,0:05:20.28,Default,,0,0,0,,<Кәсіпорын: Бізді қоршаған әлем...
Dialogue: 0,0:05:20.28,0:05:24.62,Default,,0,0,0,,Қашан сонша күрделене түсті?
Dialogue: 0,0:05:24.62,0:05:26.79,Default,,0,0,0,,Ортақ жауға қарсы тұру
Dialogue: 0,0:05:26.79,0:05:31.29,Default,,0,0,0,,Неге екені белгісіз, біз бір-бірімізге мылтық сілтедік...〉
Dialogue: 0,0:05:31.29,0:05:39.80,Default,,0,0,0,,♬～
Dialogue: 0,0:05:39.80,0:05:42.80,Default,,0,0,0,,《Кәсіпорын: Мен неге...》
Dialogue: 0,0:05:47.81,0:05:54.82,Default,,0,0,0,,(Кішкентай қыздың күлкісі)
Dialogue: 0,0:05:54.82,0:06:03.59,Default,,0,0,0,,♬～
Dialogue: 0,0:06:03.59,0:06:08.77,Default,,0,0,0,,А... әлгі балалар тағы ойланып отыр.
Dialogue: 0,0:06:08.77,0:06:14.60,Default,,0,0,0,,Екеуміз бірге жүрсек те, Жыласам жалғызбын.
Dialogue: 0,0:06:14.60,0:06:18.78,Default,,0,0,0,,Екеуі де ебедейсіз...
Dialogue: 0,0:06:18.78,0:06:21.28,Default,,0,0,0,,Сізге ұқсас
Dialogue: 0,0:06:23.28,0:06:26.28,Default,,0,0,0,,Біз бір жерде кездестік пе?
Dialogue: 0,0:06:29.29,0:06:32.29,Default,,0,0,0,,Бірақ байланысты
Dialogue: 0,0:06:32.29,0:06:36.79,Default,,0,0,0,,Біз кемелер туралы естеліктермен тудық.
Dialogue: 0,0:06:36.79,0:06:39.13,Default,,0,0,0,,Уақыттан тыс алыс теңіз
Dialogue: 0,0:06:39.13,0:06:42.13,Default,,0,0,0,,Көп ойды жинақтау
Dialogue: 0,0:06:42.13,0:06:44.47,Default,,0,0,0,,Өтінемін, ұмытпаңыз
Dialogue: 0,0:06:44.47,0:06:48.64,Default,,0,0,0,,Сізде тұратын адам дұғасы...
Dialogue: 0,0:06:48.64,0:07:02.34,Default,,0,0,0,,♬～
Dialogue: 0,0:07:05.42,0:07:08.43,Default,,0,0,0,,Ах! Мен ояндым!
Dialogue: 0,0:07:08.43,0:07:11.26,Default,,0,0,0,,Әпке! Кя!
Dialogue: 0,0:07:11.26,0:07:13.93,Default,,0,0,0,,Қаға-сенпай!
Dialogue: 0,0:07:13.93,0:07:17.60,Default,,0,0,0,,Сіз ауыр жарақат алдыңыз. Өзіңізді мәжбүрлемеңіз!
Dialogue: 0,0:07:17.60,0:07:21.60,Default,,0,0,0,,Бес навигатордың шайқасы? Жер бетінде мен қандаймын...
Dialogue: 0,0:07:25.94,0:07:31.61,Default,,0,0,0,,Егер есімде дұрыс болса, мен сұр елеспен шайқастым...
Dialogue: 0,0:07:31.61,0:07:34.95,Default,,0,0,0,,Әпке... Дұрыс...
Dialogue: 0,0:07:34.95,0:07:37.35,Default,,0,0,0,,Ақағи апаға не болды!
Dialogue: 0,0:07:39.29,0:07:41.29,Default,,0,0,0,,Бұл...
Dialogue: 0,0:07:46.30,0:07:49.63,Default,,0,0,0,,Енді не болады екен...
Dialogue: 0,0:07:49.63,0:07:52.30,Default,,0,0,0,,Хмм... Қиын жағдай.
Dialogue: 0,0:07:52.30,0:07:54.64,Default,,0,0,0,,Уф... Бұл қорқынышты...
Dialogue: 0,0:07:54.64,0:07:57.07,Default,,0,0,0,,Жарайды, жарайды, жарайды~
Dialogue: 0,0:07:57.07,0:07:59.91,Default,,0,0,0,,Мен қуаныштымын~ Сен амансың~
Dialogue: 0,0:07:59.91,0:08:02.58,Default,,0,0,0,,Сонымен? Не болып жатыр?
Dialogue: 0,0:08:02.58,0:08:04.91,Default,,0,0,0,,Осыны естігім келеді.
Dialogue: 0,0:08:04.91,0:08:09.61,Default,,0,0,0,,Мен елес көріп тұрғандай болдым
Dialogue: 0,0:08:11.75,0:08:16.26,Default,,0,0,0,,Зуйкакуға барсам, Қаға-сенпайды ғана көремін.
Dialogue: 0,0:08:16.26,0:08:18.43,Default,,0,0,0,,Ахаха…
Dialogue: 0,0:08:18.43,0:08:20.93,Default,,0,0,0,,Әпке, мен сізді сағындым.
Dialogue: 0,0:08:22.93,0:08:26.27,Default,,0,0,0,,Ақағы сенпайдың қайда екені әлі белгісіз.
Dialogue: 0,0:08:26.27,0:08:29.44,Default,,0,0,0,,Бөлінген адамдардың көпшілігі қайта қосылды.
Dialogue: 0,0:08:29.44,0:08:32.11,Default,,0,0,0,,Әлі де табылмады...
Dialogue: 0,0:08:32.11,0:08:34.81,Default,,0,0,0,,Күткендей, бұл сұр елес...
Dialogue: 0,0:08:37.45,0:08:39.78,Default,,0,0,0,,Бас тартуға әлі ерте!
Dialogue: 0,0:08:39.78,0:08:42.12,Default,,0,0,0,,Маған мұқият қарау керек...
Dialogue: 0,0:08:42.12,0:08:46.62,Default,,0,0,0,,Бірақ мен жай демала алмаймын.
Dialogue: 0,0:08:46.62,0:08:48.96,Default,,0,0,0,,Бұл теңіз аймағы қауіпті.
Dialogue: 0,0:08:48.96,0:08:51.63,Default,,0,0,0,,Мен мәңгі қала алмаймын
Dialogue: 0,0:08:51.63,0:08:54.13,Default,,0,0,0,,Және бір мәселе бар.
Dialogue: 0,0:08:57.57,0:09:00.24,Default,,0,0,0,,Неге, ол мүлдем қозғалмайды.
Dialogue: 0,0:09:00.24,0:09:02.24,Default,,0,0,0,,Сіз қатты қызып кеттіңіз бе?
Dialogue: 0,0:09:02.24,0:09:05.74,Default,,0,0,0,,Мм... Бұл да жаудың айласы ма?
Dialogue: 0,0:09:05.74,0:09:10.25,Default,,0,0,0,,Мен не болды деп ойлаймын.
Dialogue: 0,0:09:10.25,0:09:16.25,Default,,0,0,0,,Жаппай шығарылатын Сирена жұмысын тоқтатты...
Dialogue: 0,0:09:16.25,0:09:19.75,Default,,0,0,0,,Бір ғана кеме емес, барлық кемелер...?
Dialogue: 0,0:09:23.43,0:09:26.43,Default,,0,0,0,,Оның мұхиттағы ауытқуларға қатысы бар ма?
Dialogue: 0,0:09:26.43,0:09:29.77,Default,,0,0,0,,Орочимен байланыс үзілген болуы мүмкін.
Dialogue: 0,0:09:29.77,0:09:33.94,Default,,0,0,0,,Қара ақыл текшеден айырылу ауырады...
Dialogue: 0,0:09:33.94,0:09:37.94,Default,,0,0,0,,Орочи жоспары дегеніміз не?
Dialogue: 0,0:09:37.94,0:09:39.94,Default,,0,0,0,,Шокаку?
Dialogue: 0,0:09:39.94,0:09:44.28,Default,,0,0,0,,Қара психикалық текшенің шынайы тұлғасы және сиреналарды басқару механизмі...
Dialogue: 0,0:09:44.28,0:09:47.62,Default,,0,0,0,,Бізге егжей-тегжейлі хабарланған жоқ...
Dialogue: 0,0:09:47.62,0:09:51.29,Default,,0,0,0,,Эй, Шоукаку... Осындай уақытта...
Dialogue: 0,0:09:51.29,0:09:55.46,Default,,0,0,0,,Ақағы-сенпайдың тосқауылы? Сондай-ақ... сияқты техникалар бар.
Dialogue: 0,0:09:55.46,0:09:58.29,Default,,0,0,0,,Құпиялар тым көп пе?
Dialogue: 0,0:09:58.29,0:10:02.63,Default,,0,0,0,,Бірінші рейстен ересектер -
Dialogue: 0,0:10:02.63,0:10:06.33,Default,,0,0,0,,Маған қызық, сен не жасырып жүрсің...
Dialogue: 0,0:10:21.82,0:10:26.32,Default,,0,0,0,,Сіз Шигезакура баласы үшін алаңдайсыз ба?
Dialogue: 0,0:10:26.32,0:10:29.49,Default,,0,0,0,,Көрдіңіз... Иә.
Dialogue: 0,0:10:29.49,0:10:34.66,Default,,0,0,0,,Көмек алудың кешігуі үшін кешірім сұраймыз.
Dialogue: 0,0:10:34.66,0:10:37.50,Default,,0,0,0,,Мм... ашуланбайсың ба?
Dialogue: 0,0:10:37.50,0:10:39.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:39.67,0:10:42.17,Default,,0,0,0,,Аянами-чан жау...
Dialogue: 0,0:10:42.17,0:10:46.34,Default,,0,0,0,,Бірақ біз шынымен ұрысқымыз келмейді...
Dialogue: 0,0:10:46.34,0:10:50.34,Default,,0,0,0,,Бірақ мен не істерімді білмеймін...
Dialogue: 0,0:10:52.35,0:10:55.35,Default,,0,0,0,,Мен көп уайымдауым керек пе?
Dialogue: 0,0:10:55.35,0:10:57.29,Default,,0,0,0,,Мен алаңдаймын
Dialogue: 0,0:10:57.29,0:11:01.29,Default,,0,0,0,,Жағдайға байланысты триггерді тартпаңыз.
Dialogue: 0,0:11:01.29,0:11:05.46,Default,,0,0,0,,Біздің күшіміз онша жарық емес.
Dialogue: 0,0:11:05.46,0:11:09.47,Default,,0,0,0,,Біз соғысу үшін туылғанбыз
Dialogue: 0,0:11:09.47,0:11:11.63,Default,,0,0,0,,Жоюға болмайды
Dialogue: 0,0:11:11.63,0:11:13.97,Default,,0,0,0,,Иә! Иә
Dialogue: 0,0:11:13.97,0:11:16.87,Default,,0,0,0,,(Қарлы боран)
Dialogue: 0,0:11:21.14,0:11:23.65,Default,,0,0,0,,Бұл аймақ ерекше қауіпті.
Dialogue: 0,0:11:23.65,0:11:27.32,Default,,0,0,0,,Екеуіңіз де флотқа тез қосылыңыздар.
Dialogue: 0,0:11:27.32,0:11:29.32,Default,,0,0,0,,Белфаст мырза ше?
Dialogue: 0,0:11:29.32,0:11:32.66,Default,,0,0,0,,Мен кәсіпорынды іздеп жатырмын.
Dialogue: 0,0:11:32.66,0:11:34.66,Default,,0,0,0,,Мен қызметшімін
Dialogue: 0,0:11:34.66,0:11:39.00,Default,,0,0,0,,Менің жұмысым Кәсіпорын-саманың жанында болу.
Dialogue: 0,0:11:39.00,0:11:41.20,Default,,0,0,0,,Лаффи де көмектеседі.
Dialogue: 0,0:11:43.17,0:11:45.17,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:45.17,0:11:48.00,Default,,0,0,0,,Біз сондай-ақ кәсіпорынды іздейміз!
Dialogue: 0,0:11:48.00,0:11:50.40,Default,,0,0,0,,Бәріміз үйге қайтайық!
Dialogue: 0,0:11:52.68,0:11:54.68,Default,,0,0,0,,Не!?
Dialogue: 0,0:11:54.68,0:11:56.78,Default,,0,0,0,,Тағы да айтыңыз!
Dialogue: 0,0:11:56.78,0:11:59.28,Default,,0,0,0,,Қаға-сенпай, сабыр ет!
Dialogue: 0,0:11:59.28,0:12:03.29,Default,,0,0,0,,Біз қазіргі уақытта Акагиді іздеуді тоқтатамыз.
Dialogue: 0,0:12:03.29,0:12:06.62,Default,,0,0,0,,Барлық кемелер дереу осы аймақтан шығады.
Dialogue: 0,0:12:06.62,0:12:08.62,Default,,0,0,0,,Мен Джузакураның негізгі лагеріне қайтамын.
Dialogue: 0,0:12:08.62,0:12:11.63,Default,,0,0,0,,бірақ мен міндетті түрде Незуконы қайтадан адамға айналдырамын.
Dialogue: 0,0:12:11.63,0:12:13.63,Default,,0,0,0,,Akagi - бұл флагман!
Dialogue: 0,0:12:13.63,0:12:15.63,Default,,0,0,0,,Мен әпкемді тастап кете алмаймын!
Dialogue: 0,0:12:15.63,0:12:17.63,Default,,0,0,0,,Иә, сіз айтқандай.
Dialogue: 0,0:12:17.63,0:12:20.47,Default,,0,0,0,,Флагманымыздан айырылдық, Акаги...
Dialogue: 0,0:12:20.47,0:12:24.47,Default,,0,0,0,,Жаппай шығарылатын сиреналар да өз қызметін тоқтатты.
Dialogue: 0,0:12:24.47,0:12:27.64,Default,,0,0,0,,Флоттың операцияларды орындауға мүмкіндігі жоқ.
Dialogue: 0,0:12:27.64,0:12:31.31,Default,,0,0,0,,Бұл аймақта қалу мүмкін емес.
Dialogue: 0,0:12:31.31,0:12:33.32,Default,,0,0,0,,Бір Akagi кемесі үшін――
Dialogue: 0,0:12:33.32,0:12:35.65,Default,,0,0,0,,Сіз өзіңіздің флотыңызға қауіп төндіре алмайсыз.
Dialogue: 0,0:12:35.65,0:12:38.99,Default,,0,0,0,,Қарғыс атсын... Сорю, сен!
Dialogue: 0,0:12:38.99,0:12:41.99,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааа...
Dialogue: 0,0:12:41.99,0:12:47.69,Default,,0,0,0,,Әпке... Ақағы апа...
Dialogue: 0,0:12:50.83,0:12:54.84,Default,,0,0,0,,Өйткені... оған көмектесу мүмкін емес...
Dialogue: 0,0:12:54.84,0:12:57.94,Default,,0,0,0,,Сорю апа...
Dialogue: 0,0:13:04.11,0:13:06.12,Default,,0,0,0,,Есеп
Dialogue: 0,0:13:06.12,0:13:11.62,Default,,0,0,0,,Джузакураның негізгі флоты ашылды
Dialogue: 0,0:13:11.62,0:13:15.29,Default,,0,0,0,,Менің мұны істеуден басқа амалым жоқ...
Dialogue: 0,0:13:15.29,0:13:19.63,Default,,0,0,0,,Ах, Шиге Сакураның сирена күші қауіпті.
Dialogue: 0,0:13:19.63,0:13:23.83,Default,,0,0,0,,Егер біз осы жерден өтіп кететін болсақ, жағдай одан да нашарлауы мүмкін.
Dialogue: 0,0:13:26.80,0:13:29.14,Default,,0,0,0,,Менің таңдауым жоқ...
Dialogue: 0,0:13:29.14,0:13:31.34,Default,,0,0,0,,Бұл шайқас...
Dialogue: 0,0:13:35.31,0:13:39.32,Default,,0,0,0,,Олар сені тегін жібермейтін сияқты.
Dialogue: 0,0:13:39.32,0:13:43.99,Default,,0,0,0,,Қазіргі күшімізбен бір-бірімізбен бетпе-бет күресе алмаймыз.
Dialogue: 0,0:13:43.99,0:13:47.82,Default,,0,0,0,,Сорю әпке, шегінуге жетекшілік етіңіз.
Dialogue: 0,0:13:47.82,0:13:50.83,Default,,0,0,0,,Мен Азур Лейнді тартамын.
Dialogue: 0,0:13:50.83,0:13:54.16,Default,,0,0,0,,Жоқ, тақтайшаны маған қалдырыңыз!
Dialogue: 0,0:13:54.16,0:13:56.17,Default,,0,0,0,,Зуикаку!?
Dialogue: 0,0:13:56.17,0:13:58.43,Default,,0,0,0,,Мен кіші қызыма бұлай істеуге жол бере алмаймын!
Dialogue: 0,0:13:58.43,0:14:01.60,Default,,0,0,0,,Бұл сізді қызықтыратын нәрсе емес, солай ма?
Dialogue: 0,0:14:01.60,0:14:04.94,Default,,0,0,0,,Шокаку-ни... Бұл менмін.
Dialogue: 0,0:14:04.94,0:14:09.28,Default,,0,0,0,,Қаға-сенпайдың сезімін қинап түсінуге болады.
Dialogue: 0,0:14:09.28,0:14:11.78,Default,,0,0,0,,Мен де, әпкем жоғалып кетсе...
Dialogue: 0,0:14:11.78,0:14:15.28,Default,,0,0,0,,Сіз шыдай алмайтыныңызға сенімдімін...
Dialogue: 0,0:14:20.29,0:14:22.79,Default,,0,0,0,,Жарайды, Зуйкаку.
Dialogue: 0,0:14:22.79,0:14:25.29,Default,,0,0,0,,Менің әпкем әрқашан қасымда болады.
Dialogue: 0,0:14:25.29,0:14:28.79,Default,,0,0,0,,Екеуің де асықпаңдар.
Dialogue: 0,0:14:35.81,0:14:37.97,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:14:37.97,0:14:41.37,Default,,0,0,0,,Түрім осындай болса да, мен де бақытты кемемін!
Dialogue: 0,0:14:43.31,0:14:46.32,Default,,0,0,0,,Барлығыңыздан көмек сұраймын.
Dialogue: 0,0:14:46.32,0:14:48.32,Default,,0,0,0,,Шокаку-сан...
Dialogue: 0,0:14:51.32,0:15:23.29,Default,,0,0,0,,♬～
Dialogue: 0,0:15:23.29,0:15:25.79,Default,,0,0,0,,Бардың ба...
Dialogue: 0,0:15:25.79,0:15:30.29,Default,,0,0,0,,Аянами не істерін білмей тұр.
Dialogue: 0,0:15:30.29,0:15:32.96,Default,,0,0,0,,Аянами…
Dialogue: 0,0:15:32.96,0:15:34.96,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:34.96,0:15:45.64,Default,,0,0,0,,♬～
Dialogue: 0,0:15:45.64,0:15:47.94,Default,,0,0,0,,Сіз жалтардыңыз ба...
Dialogue: 0,0:15:53.82,0:15:57.25,Default,,0,0,0,,Адамзат шынымен де қызық емес пе?
Dialogue: 0,0:15:57.25,0:16:01.26,Default,,0,0,0,,Жанжалдан қорыққанына қарамастан, күресуді таңдау
Dialogue: 0,0:16:01.26,0:16:04.26,Default,,0,0,0,,Бұл өте қарама-қайшы, оны түсіндіру қиын.
Dialogue: 0,0:16:04.26,0:16:09.10,Default,,0,0,0,,Олар адамдардың ойын, тарихын бейнелейтін айна
Dialogue: 0,0:16:09.10,0:16:11.60,Default,,0,0,0,,Күрес – адамзаттың мәні.
Dialogue: 0,0:16:11.60,0:16:16.94,Default,,0,0,0,,Иә, шайқас ешқашан өзгермейді.
Dialogue: 0,0:16:16.94,0:16:20.44,Default,,0,0,0,,Не? Сіз оны алдыңыз ба? ол
Dialogue: 0,0:16:20.44,0:16:23.94,Default,,0,0,0,,Иә, бұл баланың әлі де рөлі бар.
Dialogue: 0,0:16:26.95,0:16:30.79,Default,,0,0,0,,Кәсіпорынның арқасында қара психикалық текше...
Dialogue: 0,0:16:30.79,0:16:33.29,Default,,0,0,0,,Біз деректердің үлкен көлемін алдық.
Dialogue: 0,0:16:33.29,0:16:35.96,Default,,0,0,0,,Жоспарлауға жеткілікті энергия.
Dialogue: 0,0:16:35.96,0:16:39.63,Default,,0,0,0,,Иә, ақырында, иә.
Dialogue: 0,0:16:39.63,0:16:42.30,Default,,0,0,0,,Орочи оянады
Dialogue: 0,0:16:42.30,0:17:17.60,Default,,0,0,0,,♬～
Dialogue: 0,0:17:17.60,0:17:19.60,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:17:19.60,0:17:54.64,Default,,0,0,0,,♬～
Dialogue: 0,0:17:54.64,0:17:56.57,Default,,0,0,0,,Сұр елес!?
Dialogue: 0,0:17:56.57,0:18:14.09,Default,,0,0,0,,♬～
Dialogue: 0,0:18:14.09,0:18:16.09,Default,,0,0,0,,Зуикаку!
Dialogue: 0,0:18:16.09,0:18:18.09,Default,,0,0,0,,Үлкен әпке!?
Dialogue: 0,0:18:18.09,0:18:32.94,Default,,0,0,0,,♬～
Dialogue: 0,0:18:32.94,0:18:35.61,Default,,0,0,0,,Әпке...?
Dialogue: 0,0:18:35.61,0:19:16.59,Default,,0,0,0,,♬～
Dialogue: 0,0:19:16.59,0:19:19.26,Default,,0,0,0,,Біреу маған айтыңызшы...
Dialogue: 0,0:19:19.26,0:19:23.51,Default,,0,0,0,,Дау-дамайсыз күн келе ме?
Dialogue: 0,0:19:23.74,0:19:27.88,Default,,0,0,0,,Сіз жауапты жақсы білесіз, солай ма?
Dialogue: 0,0:19:36.14,0:19:38.57,Default,,0,0,0,,《О, мен түсіндім...
Dialogue: 0,0:19:39.54,0:19:42.51,Default,,0,0,0,,Шайқас... ешқашан өзгермейді.
Dialogue: 0,0:19:47.62,0:19:49.64,Default,,0,0,0,,Сұр елес!!
Dialogue: 0,0:19:50.29,0:20:09.14,Default,,0,0,0,,♬～
Dialogue: 0,0:20:09.14,0:20:13.64,Default,,0,0,0,,Қарғыс атсын... Кешіріңіз, Шоукаку-ни...
Dialogue: 0,0:20:14.64,0:20:29.66,Default,,0,0,0,,♬～
Dialogue: 0,0:20:29.90,0:20:31.02,Default,,0,0,0,,Аянами!?
Dialogue: 0,0:20:37.67,0:20:40.78,Default,,0,0,0,,《Аянами не істерін білмей тұр.
Dialogue: 0,0:20:41.62,0:20:42.78,Default,,0,0,0,,Бірақ! 》
Dialogue: 0,0:20:43.34,0:20:44.58,Default,,0,0,0,,Бұл басқаша!
Dialogue: 0,0:20:46.34,0:20:47.60,Default,,0,0,0,,Маған ұнамайды!
Dialogue: 0,0:20:48.51,0:21:00.79,Default,,0,0,0,,♬～
Dialogue: 0,0:21:00.79,0:21:02.79,Default,,0,0,0,,Ах...! Ах...
Dialogue: 0,0:21:07.30,0:21:10.63,Default,,0,0,0,,О... күте тұрыңыз...
Dialogue: 0,0:21:10.63,0:21:20.98,Default,,0,0,0,,♬～
Dialogue: 0,0:21:21.86,0:21:22.98,Default,,0,0,0,,Жүр!
Dialogue: 0,0:21:22.98,0:21:24.98,Default,,0,0,0,,Иә! иә!
Dialogue: 0,0:21:32.99,0:21:34.52,Default,,0,0,0,,Өзін-өзі шектегіш шығарылды!
Dialogue: 0,0:21:35.32,0:21:57.11,Default,,0,0,0,,♬～
Dialogue: 0,0:21:57.11,0:22:01.41,Default,,0,0,0,,Уф... бұл ауыр!
Dialogue: 0,0:22:10.46,0:22:15.66,Default,,0,0,0,,Уу~ Тез кел~!
Dialogue: 0,0:22:17.92,0:22:20.06,Default,,0,0,0,,Рахмет...
Dialogue: 0,0:22:21.56,0:22:27.56,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory