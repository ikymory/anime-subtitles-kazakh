Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:16.16,0:00:22.16,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,0:01:06.12,0:01:11.12,Default,,0,0,0,,(Шөптегі жүгіру дыбысы)
Dialogue: 0,0:01:12.54,0:01:16.50,Default,,0,0,0,,(мүшенің жарқыраған дыбысы)
Dialogue: 0,0:01:20.45,0:01:22.37,Default,,0,0,0,,Әке
Dialogue: 0,0:01:22.45,0:01:25.87,Default,,0,0,0,,Құлау~
Dialogue: 0,0:01:25.95,0:01:28.25,Default,,0,0,0,,Әке
Dialogue: 0,0:01:32.00,0:01:35.08,Default,,0,0,0,,А... енді жоқ...
Dialogue: 0,0:01:36.12,0:01:40.54,Default,,0,0,0,,(мүлдем жарқыраған дыбыс)
Dialogue: 0,0:01:40.62,0:01:44.04,Default,,0,0,0,,(Үлпілдеп құлаған дыбыс)
Dialogue: 0,0:01:55.58,0:01:57.20,Default,,0,0,0,,Әкем…
Dialogue: 0,0:02:13.00,0:02:15.91,Default,,0,0,0,,Канна-чан, сен ояусың ба?
Dialogue: 0,0:02:16.00,0:02:17.16,Default,,0,0,0,,(разряд дыбысы)
Dialogue: 0,0:02:17.79,0:02:18.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:18.58,0:02:19.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:18.58,0:02:19.20,Default,,0,0,0,,(разряд және жарықты дыбыс)
Dialogue: 0,0:02:19.20,0:02:20.66,Default,,0,0,0,,(разряд және жарықты дыбыс)
Dialogue: 0,0:02:21.54,0:02:23.87,Default,,0,0,0,,Уау~
Dialogue: 0,0:02:24.41,0:02:26.29,Default,,0,0,0,,Қайырлы таң Кобаяши
Dialogue: 0,0:02:27.75,0:02:29.62,Default,,0,0,0,,Қайырлы таң Канна-чан
Dialogue: 0,0:02:29.70,0:02:32.00,Default,,0,0,0,,(Айдаһардың айқайы)
Dialogue: 0,0:02:33.91,0:02:36.37,Default,,0,0,0,,Айдаһар... Бұл...
Dialogue: 0,0:02:36.45,0:02:38.12,Default,,0,0,0,,Ең күшті тіршілік иесі
Dialogue: 0,0:02:39.29,0:02:42.41,Default,,0,0,0,,Жалынмен тыныстап, аспанда ұш
Dialogue: 0,0:02:43.00,0:02:47.12,Default,,0,0,0,,Сиқырды кейде қолданатын қиялдағы тіршілік иесі...
Dialogue: 0,0:02:48.95,0:02:50.87,Default,,0,0,0,,(Үру)
Dialogue: 0,0:02:54.08,0:02:57.29,Default,,0,0,0,,Мен ойладым...
Dialogue: 0,0:02:58.54,0:03:02.50,Default,,0,0,0,,Мен сондай айдаһарлармен бірге тұрамын.
Dialogue: 0,0:03:03.50,0:03:07.91,Default,,0,0,0,,♪～
Dialogue: 0,0:04:24.91,0:04:29.91,Default,,0,0,0,,～♪
Dialogue: 0,0:04:30.91,0:04:33.25,Default,,0,0,0,,Көкектің анасы
Dialogue: 0,0:04:33.33,0:04:36.37,Default,,0,0,0,,Басқа құстардың ұясына, жапырақтарына жұмыртқа салады
Dialogue: 0,0:04:36.45,0:04:37.91,Default,,0,0,0,,О...
Dialogue: 0,0:04:38.00,0:04:39.58,Default,,0,0,0,,Нуфф хоон
Dialogue: 0,0:04:38.00,0:04:39.58,Default,,0,0,0,,Жаңа туған көкек балапан
Dialogue: 0,0:04:39.58,0:04:41.12,Default,,0,0,0,,Жаңа туған көкек балапан
Dialogue: 0,0:04:41.20,0:04:45.16,Default,,0,0,0,,Бастапқыда болған басқа жұмыртқаларды лақтырыңыз.
Dialogue: 0,0:04:45.25,0:04:47.37,Default,,0,0,0,,-Ой! -Ол керемет.
Dialogue: 0,0:04:47.45,0:04:49.04,Default,,0,0,0,,Оны ата-ана құс білмейді
Dialogue: 0,0:04:47.45,0:04:49.04,Default,,0,0,0,,Аха…
Dialogue: 0,0:04:49.12,0:04:50.33,Default,,0,0,0,,Тамақты ұқыптылықпен тасымалдау
Dialogue: 0,0:04:50.41,0:04:54.33,Default,,0,0,0,,Көкек балапан оны жеп, үлкен болып өседі.
Dialogue: 0,0:04:54.41,0:04:58.79,Default,,0,0,0,,Қараңызшы, Кобаяши мырза, мынаны жеп, есейіңіз.
Dialogue: 0,0:04:58.87,0:05:00.70,Default,,0,0,0,,Дөрекі болмаңыз
Dialogue: 0,0:05:00.79,0:05:03.16,Default,,0,0,0,,Ммм~ Егер сіз мұны жесеңіз
Dialogue: 0,0:05:03.25,0:05:05.79,Default,,0,0,0,,Бір асқыну, Армагеддон
Dialogue: 0,0:05:05.87,0:05:08.08,Default,,0,0,0,,Хаостан ғарышқа...
Dialogue: 0,0:05:08.16,0:05:10.83,Default,,0,0,0,,Көрнекіліктер - Армагеддон...
Dialogue: 0,0:05:10.91,0:05:12.62,Default,,0,0,0,,Кобаяши сіз аштықтасыз ба?
Dialogue: 0,0:05:12.70,0:05:15.04,Default,,0,0,0,,Жоқ, Десмадан босатылды
Dialogue: 0,0:05:15.12,0:05:17.33,Default,,0,0,0,,Мен абайсызда көп ішіп алдым
Dialogue: 0,0:05:17.41,0:05:18.37,Default,,0,0,0,,(құйрықтың өсу дыбысы)
Dialogue: 0,0:05:19.08,0:05:22.12,Default,,0,0,0,,Кобаяши-сан, егер Десма бітсе.
Dialogue: 0,0:05:22.20,0:05:24.12,Default,,0,0,0,,...
Dialogue: 0,0:05:24.20,0:05:27.83,Default,,0,0,0,,Екеуміз бірге ыстық бұлаққа барайық.
Dialogue: 0,0:05:27.91,0:05:29.91,Default,,0,0,0,,- (Кобаяши) Ханым! -(Тор) Е~
Dialogue: 0,0:05:30.00,0:05:33.12,Default,,0,0,0,,Мен қымбат ақылы демалысымды мұндай нәрсеге пайдаланғым келмейді.
Dialogue: 0,0:05:33.20,0:05:36.79,Default,,0,0,0,,Сіз жапондық сияқты бірдеңе айтып тұрсыз ба?
Dialogue: 0,0:05:36.87,0:05:38.20,Default,,0,0,0,,Мен жапонмын.
Dialogue: 0,0:05:38.29,0:05:40.79,Default,,0,0,0,,Екеумізді ғана қалдыру - алдау!
Dialogue: 0,0:05:40.87,0:05:42.50,Default,,0,0,0,,Канна да барғысы келеді, солай ма?
Dialogue: 0,0:05:42.58,0:05:43.62,Default,,0,0,0,,Менің барғым келеді
Dialogue: 0,0:05:43.70,0:05:45.25,Default,,0,0,0,,Жарайды, бәріміз кеттік.
Dialogue: 0,0:05:45.33,0:05:46.50,Default,,0,0,0,,Қазір кеттік!
Dialogue: 0,0:05:46.58,0:05:47.00,Default,,0,0,0,,Яй яй яй
Dialogue: 0,0:05:47.00,0:05:49.91,Default,,0,0,0,,Яй яй яй
Dialogue: 0,0:05:47.00,0:05:49.91,Default,,0,0,0,,Бүгін емес. Сайкавамен және басқалармен кездесуім бар.
Dialogue: 0,0:05:49.91,0:05:50.00,Default,,0,0,0,,Бүгін емес. Сайкавамен және басқалармен кездесуім бар.
Dialogue: 0,0:05:50.00,0:05:50.70,Default,,0,0,0,,Бүгін емес. Сайкавамен және басқалармен кездесуім бар.
Dialogue: 0,0:05:50.00,0:05:50.70,Default,,0,0,0,,Менің де жарты күндік жұмысым бар еді...
Dialogue: 0,0:05:50.70,0:05:52.16,Default,,0,0,0,,Менің де толық емес жұмысым бар еді...
Dialogue: 0,0:05:52.25,0:05:54.41,Default,,0,0,0,,Тордың да толық емес жұмыс күні болған
Dialogue: 0,0:05:54.50,0:05:56.08,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:05:56.16,0:05:58.45,Default,,0,0,0,,Мен келемін, Кобаяши мырза.
Dialogue: 0,0:05:58.54,0:06:00.00,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:06:00.66,0:06:01.70,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:06:01.79,0:06:02.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:03.25,0:06:04.62,Default,,0,0,0,,Кобаяши
Dialogue: 0,0:06:06.00,0:06:07.20,Default,,0,0,0,,Смартфон сатып алу
Dialogue: 0,0:06:07.29,0:06:08.20,Default,,0,0,0,,Ха!
Dialogue: 0,0:06:09.33,0:06:11.12,Default,,0,0,0,,Смартфон? Бастауыш сынып оқушысы ма?
Dialogue: 0,0:06:11.12,0:06:11.95,Default,,0,0,0,,Смартфон? Бастауыш сынып оқушысы ма?
Dialogue: 0,0:06:11.12,0:06:11.95,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:06:12.04,0:06:15.25,Default,,0,0,0,,Дүкенге келген балаларда да көп нәрсе бар.
Dialogue: 0,0:06:15.33,0:06:17.37,Default,,0,0,0,,Бүгінгі балалар...
Dialogue: 0,0:06:17.45,0:06:21.33,Default,,0,0,0,,Мектепте барлығында да бар. Бұл көптеген жолдармен пайдалы.
Dialogue: 0,0:06:21.41,0:06:24.04,Default,,0,0,0,,Сондай-ақ бейне түсіруге және бейне жазуға болады.
Dialogue: 0,0:06:24.12,0:06:26.16,Default,,0,0,0,,Жоқ, әлі ерте, солай емес пе?
Dialogue: 0,0:06:26.25,0:06:29.70,Default,,0,0,0,,Ех! Бөтен адамның дауысын жазыңыз!
Dialogue: 0,0:06:29.79,0:06:32.08,Default,,0,0,0,,- Ммммммммммм - (Кобаяши) Бөтен планета? Сен не туралы айтып тұрсың?
Dialogue: 0,0:06:32.16,0:06:36.66,Default,,0,0,0,,Мен досым екеуміз бөтен дауыстарды тыңдаймыз.
Dialogue: 0,0:06:36.75,0:06:39.79,Default,,0,0,0,,Канна, өзімшіл болма, мен барамын.
Dialogue: 0,0:06:39.87,0:06:41.95,Default,,0,0,0,,Ммммммммм
Dialogue: 0,0:06:42.04,0:06:43.83,Default,,0,0,0,,Хмм!
Dialogue: 0,0:06:43.91,0:06:45.00,Default,,0,0,0,,Я...
Dialogue: 0,0:06:45.08,0:06:46.95,Default,,0,0,0,,бас тартты
Dialogue: 0,0:06:47.62,0:06:50.37,Default,,0,0,0,,-Келемін.-(Кобаяши) Иә, келіңізші.
Dialogue: 0,0:06:51.04,0:06:52.00,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:52.08,0:06:55.08,Default,,0,0,0,,А... Канна-чан, сәл күте тұрыңыз.
Dialogue: 0,0:06:55.16,0:06:56.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:58.16,0:07:02.04,Default,,0,0,0,,Канна-санмен менің демалыс күнім де кездескенім керемет.
Dialogue: 0,0:07:02.12,0:07:04.16,Default,,0,0,0,,Сайкава Сайкава
Dialogue: 0,0:07:04.25,0:07:06.70,Default,,0,0,0,,Канна мырза? қайда? Бұл қайда?
Dialogue: 0,0:07:06.79,0:07:08.41,Default,,0,0,0,,Сайкава Сайкава
Dialogue: 0,0:07:09.33,0:07:10.95,Default,,0,0,0,,Сайкава Сайкава
Dialogue: 0,0:07:12.79,0:07:15.20,Default,,0,0,0,,- Джаан - (Сайкава) Канна-сан!
Dialogue: 0,0:07:15.29,0:07:16.70,Default,,0,0,0,,Сол сияқты, бір күні, бір жерде кездесесіздер.
Dialogue: 0,0:07:18.45,0:07:22.66,Default,,0,0,0,,Қанна бұзықты жақсы көреді.
Dialogue: 0,0:07:24.41,0:07:25.95,Default,,0,0,0,,Дай Сейко!
Dialogue: 0,0:07:26.04,0:07:27.54,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:27.62,0:07:31.41,Default,,0,0,0,,Диктофон Кобаяши маған қарызға берді
Dialogue: 0,0:07:31.50,0:07:35.04,Default,,0,0,0,,Осылайша жазуға және ойнатуға болады
Dialogue: 0,0:07:35.12,0:07:36.87,Default,,0,0,0,,Сайкава Сайкава
Dialogue: 0,0:07:36.95,0:07:39.16,Default,,0,0,0,,Эй, мынандай нәрсе бар.
Dialogue: 0,0:07:39.25,0:07:41.58,Default,,0,0,0,,Сәлем Кобаяши!
Dialogue: 0,0:07:41.66,0:07:45.83,Default,,0,0,0,,Бұл нәрсеге не болды! Алдымен менің тапсырыстарымды орындаңыз!
Dialogue: 0,0:07:45.91,0:07:47.75,Default,,0,0,0,,Бұл ескі
Dialogue: 0,0:07:47.83,0:07:49.33,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:07:49.41,0:07:50.66,Default,,0,0,0,,Эй
Dialogue: 0,0:07:50.75,0:07:52.04,Default,,0,0,0,,Барлығы келді.
Dialogue: 0,0:07:52.12,0:07:54.12,Default,,0,0,0,,- (Хачисука) Хэхехе - (Курода) Ой...
Dialogue: 0,0:07:52.12,0:07:54.12,Default,,0,0,0,,Хехе
Dialogue: 0,0:07:54.20,0:07:57.91,Default,,0,0,0,,(Лукоаның гуілдеуі)
Dialogue: 0,0:07:58.00,0:08:01.00,Default,,0,0,0,,-(Сайкава) Уф... -(Хачисука) Баспа!
Dialogue: 0,0:08:01.08,0:08:02.37,Default,,0,0,0,,- (Курода) Ауырды... - (Сайкава) Ыстық!
Dialogue: 0,0:08:02.45,0:08:06.54,Default,,0,0,0,,Бұл ақша салған кезде телефон соғуға мүмкіндік беретін құрылғы.
Dialogue: 0,0:08:06.62,0:08:11.20,Default,,0,0,0,,Ақшаны салыңыз, түймені басыңыз және бөтен адамның дауысын тыңдаңыз.
Dialogue: 0,0:08:11.29,0:08:13.66,Default,,0,0,0,,Олар мені алып кетіп жатыр!
Dialogue: 0,0:08:13.75,0:08:16.12,Default,,0,0,0,,Қала аңызы...
Dialogue: 0,0:08:16.20,0:08:18.58,Default,,0,0,0,,- Хачисука тез - (Сайкава) Уф...
Dialogue: 0,0:08:18.66,0:08:20.45,Default,,0,0,0,,Уф... Ууу...
Dialogue: 0,0:08:20.54,0:08:22.20,Default,,0,0,0,,Богема!
Dialogue: 0,0:08:22.29,0:08:24.08,Default,,0,0,0,,Уау! Бұл қандай дауыс?
Dialogue: 0,0:08:24.16,0:08:26.58,Default,,0,0,0,,- (Курамото) Бұл шықты. Ол шықты, солай ма? -(Курода) Сондықтан бұл қалалық аңыз...
Dialogue: 0,0:08:26.66,0:08:29.29,Default,,0,0,0,,О, мен саған әлі телефон соққан жоқпын.
Dialogue: 0,0:08:29.37,0:08:31.41,Default,,0,0,0,,Жарайды, маған тез қоңырау шалыңыз!
Dialogue: 0,0:08:31.50,0:08:32.33,Default,,0,0,0,,Астық
Dialogue: 0,0:08:32.41,0:08:35.70,Default,,0,0,0,,- (Хачисука) Дайынсың ба? -(Курамото) Керемет бейне өтінемін
Dialogue: 0,0:08:35.79,0:08:37.66,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,0:08:43.12,0:08:45.87,Default,,0,0,0,,(тұтқадан қоңырау естіледі)
Dialogue: 0,0:08:45.95,0:08:46.95,Default,,0,0,0,,Жапонияның метеорологиялық агенттігінің болжау департаменті жариялады...
Dialogue: 0,0:08:46.95,0:08:48.41,Default,,0,0,0,,Жапонияның метеорологиялық агенттігінің болжау департаменті жариялады...
Dialogue: 0,0:08:46.95,0:08:48.41,Default,,0,0,0,,Қый!
Dialogue: 0,0:08:48.50,0:08:51.20,Default,,0,0,0,,- (Хачисука) Уау! -(Барлығы) Уау!
Dialogue: 0,0:08:51.29,0:08:52.87,Default,,0,0,0,,- (Сайкава) Енді ше? -(Хачисука) Ия!
Dialogue: 0,0:08:52.95,0:08:54.95,Default,,0,0,0,,-Жат планеталық? -(Сайкава) А?
Dialogue: 0,0:08:55.04,0:08:57.66,Default,,0,0,0,,Бізді алып кетуі мүмкін.
Dialogue: 0,0:08:57.75,0:08:58.66,Default,,0,0,0,,- (Сайкава) Е! -Ой
Dialogue: 0,0:08:58.75,0:09:01.70,Default,,0,0,0,,- (Курода) деп аталатын қалалық аңыз - (Хачисука) Сонымен, сіз...
Dialogue: 0,0:09:01.79,0:09:04.25,Default,,0,0,0,,- (Хачисуканың әкесі) Эй, Лен! - (Хачисука) Иә?
Dialogue: 0,0:09:04.33,0:09:06.58,Default,,0,0,0,,- (Хачисука) Әкем - (Сайкава) Иә?
Dialogue: 0,0:09:06.66,0:09:08.83,Default,,0,0,0,,Сыртқа шығатын уақыт келді.
Dialogue: 0,0:09:08.91,0:09:10.70,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:09:11.58,0:09:13.08,Default,,0,0,0,,Сонда кездескенше!
Dialogue: 0,0:09:13.16,0:09:14.45,Default,,0,0,0,,Ха... Уф...
Dialogue: 0,0:09:14.54,0:09:16.04,Default,,0,0,0,,-Сау бол-(Курамото) Жақында кездескенше
Dialogue: 0,0:09:16.12,0:09:18.45,Default,,0,0,0,,Бұл құпия!
Dialogue: 0,0:09:22.12,0:09:24.50,Default,,0,0,0,,Қоңырауды дұрыс жасадыңыз ба?
Dialogue: 0,0:09:24.58,0:09:26.87,Default,,0,0,0,,Мені алып кетуі мүмкін...
Dialogue: 0,0:09:26.95,0:09:28.91,Default,,0,0,0,,Мен оны… қолданамын деп ойламаған едім
Dialogue: 0,0:09:29.00,0:09:30.45,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:09:30.54,0:09:33.54,Default,,0,0,0,,- (Хачисуканың әкесі) Хахаха, бұл жақсы - (Хачисука) Уау! Хахаха
Dialogue: 0,0:09:34.54,0:09:36.62,Default,,0,0,0,,Мен бүгін армандадым
Dialogue: 0,0:09:36.70,0:09:38.66,Default,,0,0,0,,Арман? қандай?
Dialogue: 0,0:09:39.25,0:09:43.91,Default,,0,0,0,,Жүгіріп бара жатқан әкемнің арқасына мінсе арман
Dialogue: 0,0:09:44.54,0:09:47.66,Default,,0,0,0,,Бұл жақсы емес деп ойлағанымда, құлап қалатын болдым.
Dialogue: 0,0:09:47.75,0:09:52.16,Default,,0,0,0,,Әкем тоқтап, мені дұрыс ұстады.
Dialogue: 0,0:09:52.25,0:09:54.12,Default,,0,0,0,,Мұндай арман...
Dialogue: 0,0:09:56.58,0:09:58.37,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:09:58.45,0:10:03.16,Default,,0,0,0,,Шота-кун сиқырды оқудан қолы бос емес, маған назар аудармайды.
Dialogue: 0,0:10:03.25,0:10:05.95,Default,,0,0,0,,Сиқыр? Бұл қиын сияқты.
Dialogue: 0,0:10:06.04,0:10:08.20,Default,,0,0,0,,Мана бұл дүниеде аз.
Dialogue: 0,0:10:08.29,0:10:10.83,Default,,0,0,0,,Бұл біраз қиын.
Dialogue: 0,0:10:10.91,0:10:12.79,Default,,0,0,0,,Жаттығу жасасаң, Кобаяши-сан боласың.
Dialogue: 0,0:10:12.87,0:10:15.00,Default,,0,0,0,,Сіз сиқырды қолдана аласыз.
Dialogue: 0,0:10:15.08,0:10:18.79,Default,,0,0,0,,Мен одан пайда жоқ деп қорқамын.
Dialogue: 0,0:10:19.45,0:10:20.62,Default,,0,0,0,,Пуха~
Dialogue: 0,0:10:20.70,0:10:24.12,Default,,0,0,0,,Кешіріңіз, маған ішуге рұқсат етіңіз.
Dialogue: 0,0:10:24.20,0:10:26.45,Default,,0,0,0,,Мен қымбатты демалыс күні ойнауға келдім.
Dialogue: 0,0:10:26.54,0:10:28.16,Default,,0,0,0,,Өйткені бұл менікі~
Dialogue: 0,0:10:28.25,0:10:30.00,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:10:30.70,0:10:33.83,Default,,0,0,0,,Одан гөрі мені тыңда, Кобаяши-сан.
Dialogue: 0,0:10:33.91,0:10:35.25,Default,,0,0,0,,Иә иә
Dialogue: 0,0:10:35.79,0:10:37.12,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:41.25,0:10:42.66,Default,,0,0,0,,Кобаяши мырза
Dialogue: 0,0:10:42.75,0:10:47.50,Default,,0,0,0,,Кешіріңіз, мен бірдеңені есіме түсірдім, сондықтан үйге бара жатырмын.
Dialogue: 0,0:10:47.58,0:10:49.54,Default,,0,0,0,,Не? Иә
Dialogue: 0,0:10:49.62,0:10:51.41,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:10:51.50,0:10:52.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:52.70,0:10:53.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:55.87,0:10:57.95,Default,,0,0,0,,сыра сырасы
Dialogue: 0,0:10:58.91,0:10:59.75,Default,,0,0,0,,(разряд дыбысы)
Dialogue: 0,0:11:00.58,0:11:01.66,Default,,0,0,0,,Иә? (Зарядтау дыбысы)
Dialogue: 0,0:11:08.25,0:11:09.87,Default,,0,0,0,,(Қатты найзағай дыбысы)
Dialogue: 0,0:11:09.95,0:11:11.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:14.20,0:11:15.66,Default,,0,0,0,,Суасты кемесі ме?
Dialogue: 0,0:11:15.75,0:11:17.29,Default,,0,0,0,,(Пойыздың тежегішінің дыбысы)
Dialogue: 0,0:11:17.37,0:11:19.04,Default,,0,0,0,,…менің бөлмесіне келуім керек деді—
Dialogue: 0,0:11:19.12,0:11:21.04,Default,,0,0,0,,(қуаттың түсу дыбысы)
Dialogue: 0,0:11:24.37,0:11:25.50,Default,,0,0,0,,Хмм?
Dialogue: 0,0:11:28.66,0:11:30.04,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:30.12,0:11:33.12,Default,,0,0,0,,Ируру Они-чан, ойын бұзылды.
Dialogue: 0,0:11:33.20,0:11:34.04,Default,,0,0,0,,Бұл да
Dialogue: 0,0:11:37.29,0:11:39.87,Default,,0,0,0,,Еееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееееее...
Dialogue: 0,0:11:39.87,0:11:40.79,Default,,0,0,0,,Иә, иә, иә, жоқ, жоқ, иә... Иә?
Dialogue: 0,0:11:39.87,0:11:40.79,Default,,0,0,0,,Электр қуатын өшіру?
Dialogue: 0,0:11:40.87,0:11:43.33,Default,,0,0,0,,Біртүрлі екен, Джансу.
Dialogue: 0,0:11:43.41,0:11:46.37,Default,,0,0,0,,Фаф-кун, жақсысың ба, Янс?
Dialogue: 0,0:11:47.04,0:11:48.29,Default,,0,0,0,,Фаф мырза?
Dialogue: 0,0:11:48.95,0:11:51.08,Default,,0,0,0,,Tsk, бұл қиын...
Dialogue: 0,0:11:51.16,0:11:52.70,Default,,0,0,0,,Менің смартфоным да құлап жатыр...
Dialogue: 0,0:11:52.79,0:11:54.70,Default,,0,0,0,,Ажыратқыш қалыпты
Dialogue: 0,0:11:54.79,0:11:56.95,Default,,0,0,0,,Мен қиналып жатырмын...
Dialogue: 0,0:11:57.75,0:11:59.20,Default,,0,0,0,,Неге...
Dialogue: 0,0:12:00.58,0:12:04.50,Default,,0,0,0,,Мен таң қалдым. Бұл қорқынышты болды... Иә?
Dialogue: 0,0:12:06.95,0:12:11.54,Default,,0,0,0,,А, мен таң қалдым. Бұл таңғажайып найзағай болды.
Dialogue: 0,0:12:11.62,0:12:12.75,Default,,0,0,0,,Ыстық болды.
Dialogue: 0,0:12:13.45,0:12:16.25,Default,,0,0,0,,А... сыра ішкен жоқсың ба?
Dialogue: 0,0:12:19.91,0:12:20.75,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:12:21.37,0:12:23.95,Default,,0,0,0,,Иә? жақсылықтың иісі
Dialogue: 0,0:12:28.83,0:12:30.83,Default,,0,0,0,,Үлкен аға...
Dialogue: 0,0:12:31.54,0:12:34.37,Default,,0,0,0,,Иә? Эй, ішгің келе ме?
Dialogue: 0,0:12:34.45,0:12:36.70,Default,,0,0,0,,Жоқ, бейтаныс адамнан.
Dialogue: 0,0:12:36.79,0:12:38.41,Default,,0,0,0,,Заттарды қалай қабылдауға болады...
Dialogue: 0,0:12:38.50,0:12:41.20,Default,,0,0,0,,Сізді бұл алкоголь қызықтырады ма?
Dialogue: 0,0:12:41.83,0:12:45.54,Default,,0,0,0,,Сакенің не екенін білетін адаммен батамды беремін.
Dialogue: 0,0:12:45.62,0:12:47.83,Default,,0,0,0,,Сонымен... сәл ғана...
Dialogue: 0,0:12:47.91,0:12:50.37,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:50.45,0:12:52.45,Default,,0,0,0,,Жоқ, ішуге болады, қыз.
Dialogue: 0,0:12:52.54,0:12:54.66,Default,,0,0,0,,онша емес~
Dialogue: 0,0:12:54.75,0:12:56.83,Default,,0,0,0,,Хмм... Ах!
Dialogue: 0,0:12:56.91,0:12:59.00,Default,,0,0,0,,Қарт – жақсы адам.
Dialogue: 0,0:12:59.08,0:13:03.45,Default,,0,0,0,,Иә? Солай ма? Хахахаха!
Dialogue: 0,0:13:03.54,0:13:06.20,Default,,0,0,0,,Сонымен... ішімдік таусылды ма?
Dialogue: 0,0:13:06.29,0:13:07.87,Default,,0,0,0,,О, қандай ұят.
Dialogue: 0,0:13:08.45,0:13:10.54,Default,,0,0,0,,Жарайды, онда мен барамын.
Dialogue: 0,0:13:11.16,0:13:12.58,Default,,0,0,0,,Сосын мен де
Dialogue: 0,0:13:14.04,0:13:15.66,Default,,0,0,0,,Үлкен
Dialogue: 0,0:13:16.66,0:13:19.33,Default,,0,0,0,,Иә? Сіз бір бағытта келе жатырсыз ба?
Dialogue: 0,0:13:19.41,0:13:20.66,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:13:22.83,0:13:24.91,Default,,0,0,0,,Мен бұрын айтқан шығармын.
Dialogue: 0,0:13:25.62,0:13:28.75,Default,,0,0,0,,Мен қызымды көруге біраз уақыттан кейін бірінші рет келдім.
Dialogue: 0,0:13:28.83,0:13:30.41,Default,,0,0,0,,Менің бір ісім бар.
Dialogue: 0,0:13:31.33,0:13:34.50,Default,,0,0,0,,Қызыңды көре алмау жалғыздық емес пе еді?
Dialogue: 0,0:13:34.58,0:13:36.16,Default,,0,0,0,,Жалғызсың ба?
Dialogue: 0,0:13:36.25,0:13:39.16,Default,,0,0,0,,Мен мұны түсінбеймін.
Dialogue: 0,0:13:39.25,0:13:40.62,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:44.45,0:13:46.95,Default,,0,0,0,,Иә? Сіз бір пәтердесіз бе?
Dialogue: 0,0:13:47.04,0:13:48.16,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:13:50.08,0:13:51.45,Default,,0,0,0,,Тар...
Dialogue: 0,0:13:54.50,0:13:56.83,Default,,0,0,0,,Сол қабат... Иә?
Dialogue: 0,0:13:56.91,0:13:59.83,Default,,0,0,0,,Сіз Талл Битке бардыңыз...
Dialogue: 0,0:13:59.91,0:14:02.29,Default,,0,0,0,,Неге келдің... Кимун Камуи!
Dialogue: 0,0:14:02.95,0:14:04.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:06.91,0:14:08.29,Default,,0,0,0,,Қызым…
Dialogue: 0,0:14:09.33,0:14:11.37,Default,,0,0,0,,Каннамен кездесу
Dialogue: 0,0:14:12.12,0:14:14.66,Default,,0,0,0,,Қария Канна-чанның әкесі...
Dialogue: 0,0:14:15.29,0:14:18.54,Default,,0,0,0,,Сонда сен Канна-чанды алуға келдің бе?
Dialogue: 0,0:14:18.62,0:14:19.87,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:20.45,0:14:24.16,Default,,0,0,0,,Оны кезең-кезеңімен түсіндірейін.
Dialogue: 0,0:14:25.50,0:14:26.95,Default,,0,0,0,,Иә
Dialogue: 0,0:14:27.04,0:14:28.08,Default,,0,0,0,,Кім?
Dialogue: 0,0:14:28.16,0:14:32.04,Default,,0,0,0,,Әй, келдің, біздің армияның стратегі.
Dialogue: 0,0:14:32.70,0:14:35.41,Default,,0,0,0,,Түсіндірудің бұл түрі қиын, сондықтан мен оны сізге қалдырамын.
Dialogue: 0,0:14:35.50,0:14:37.41,Default,,0,0,0,,Азад
Dialogue: 0,0:14:39.00,0:14:40.66,Default,,0,0,0,,(сықырлау)
Dialogue: 0,0:14:41.54,0:14:43.16,Default,,0,0,0,,Айдаһар добы…\NСіз
Dialogue: 0,0:14:43.25,0:14:45.79,Default,,0,0,0,,туралы білесіз бе?
Dialogue: 0,0:14:45.87,0:14:47.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:47.45,0:14:49.66,Default,,0,0,0,,Айдаһарлар жүздеген жылдарды өткізді
Dialogue: 0,0:14:49.75,0:14:52.12,Default,,0,0,0,,Бұл қуатты қамтитын құрал.
Dialogue: 0,0:14:52.83,0:14:57.08,Default,,0,0,0,,Сіз оны шайқаста қолдану арқылы күшті күшке ие бола аласыз.
Dialogue: 0,0:14:57.16,0:15:01.08,Default,,0,0,0,,Неге екенін білмеймін, бірақ Канна бұзды.
Dialogue: 0,0:15:01.16,0:15:04.16,Default,,0,0,0,,Жауапкершілікті мойныма ал деп достарым шу шығарып жатыр.
Dialogue: 0,0:15:04.25,0:15:06.16,Default,,0,0,0,,Канна табиғатқа жіберілді.
Dialogue: 0,0:15:06.25,0:15:07.87,Default,,0,0,0,,Мен өлшемнен өтемін деп ешқашан күткен емеспін
Dialogue: 0,0:15:07.95,0:15:11.41,Default,,0,0,0,,Біз бұл деңгейге жетеміз деп ешқашан ойламаппын.
Dialogue: 0,0:15:11.50,0:15:13.37,Default,,0,0,0,,Күміс шашты жарты эльф
Dialogue: 0,0:15:15.08,0:15:18.25,Default,,0,0,0,,Сіз бұзақылық үшін шығарылдыңыз ба?
Dialogue: 0,0:15:18.33,0:15:21.04,Default,,0,0,0,,Канна бұзақылықты жақсы көреді.
Dialogue: 0,0:15:22.83,0:15:27.08,Default,,0,0,0,,Сонда мен сені кешіргенім үшін келдің бе?
Dialogue: 0,0:15:27.83,0:15:29.79,Default,,0,0,0,,Кешіру немесе кешіру
Dialogue: 0,0:15:29.87,0:15:31.41,Default,,0,0,0,,Басынан бері емес.
Dialogue: 0,0:15:31.50,0:15:33.91,Default,,0,0,0,,- (Кобаяши) Е... - Бұл енді керек.
Dialogue: 0,0:15:34.00,0:15:36.37,Default,,0,0,0,,Бұлай айту дұрысырақ па?
Dialogue: 0,0:15:36.45,0:15:39.16,Default,,0,0,0,,Қажет... Иә?
Dialogue: 0,0:15:39.25,0:15:42.16,Default,,0,0,0,,Біздің хаотикалық күштер аумағына жақын.
Dialogue: 0,0:15:42.91,0:15:47.16,Default,,0,0,0,,Гармониялық күштер база құрып, шайқас басталды.
Dialogue: 0,0:15:47.25,0:15:48.83,Default,,0,0,0,,Не келді
Dialogue: 0,0:15:48.91,0:15:51.29,Default,,0,0,0,,Ақ Айдаһар Герцог Люминдері
Dialogue: 0,0:15:51.37,0:15:53.20,Default,,0,0,0,,Қиын қарсылас
Dialogue: 0,0:15:53.29,0:15:56.41,Default,,0,0,0,,Міне, тағы бір мықтысы келді.
Dialogue: 0,0:15:56.50,0:16:00.37,Default,,0,0,0,,Менде де қиналамын, сондықтан менде айдаһар шары бар
Dialogue: 0,0:16:00.45,0:16:03.12,Default,,0,0,0,,Канна бұзды, солай ма?
Dialogue: 0,0:16:03.20,0:16:05.41,Default,,0,0,0,,Иә... бірақ
Dialogue: 0,0:16:06.25,0:16:08.62,Default,,0,0,0,,Оның жойылғанын білдіреді
Dialogue: 0,0:16:08.70,0:16:13.33,Default,,0,0,0,,Айдаһар шарының күші Канна-самаға түсуі керек.
Dialogue: 0,0:16:13.41,0:16:15.66,Default,,0,0,0,,оны шығарып алыңыз
Dialogue: 0,0:16:17.79,0:16:21.62,Default,,0,0,0,,Ал, мен Каннаны өзіммен бірге үйге апарамын.
Dialogue: 0,0:16:21.70,0:16:26.75,Default,,0,0,0,,Егер сіз маған қамқорлық жасағаным үшін алғыс айтқыңыз келсе, маған хабарлаңыз.
Dialogue: 0,0:16:30.25,0:16:31.41,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:31.50,0:16:34.12,Default,,0,0,0,,Мен тек мән-жайларды түсінемін.
Dialogue: 0,0:16:34.87,0:16:37.41,Default,,0,0,0,,Канна-чан туралы не ойлайсың?
Dialogue: 0,0:16:37.50,0:16:39.08,Default,,0,0,0,,Достар!
Dialogue: 0,0:16:39.16,0:16:42.95,Default,,0,0,0,,Достар бірге соғысып, жауды жеңу
Dialogue: 0,0:16:43.04,0:16:44.70,Default,,0,0,0,,Ата-ана мен бала емес пе?
Dialogue: 0,0:16:44.79,0:16:47.16,Default,,0,0,0,,Мен мұны түсінбеймін дедім.
Dialogue: 0,0:16:48.45,0:16:50.54,Default,,0,0,0,,Неге қарап тұрсың?
Dialogue: 0,0:16:52.83,0:16:56.29,Default,,0,0,0,,Біз адами құндылықтардан тым алшақпыз ба?
Dialogue: 0,0:16:56.37,0:16:57.50,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,0:16:57.58,0:16:59.83,Default,,0,0,0,,Сіз мұны түсінесіз.
Dialogue: 0,0:16:59.91,0:17:01.00,Default,,0,0,0,,Иә
Dialogue: 0,0:17:02.58,0:17:05.41,Default,,0,0,0,,Енді маған каннаны беріңіз.
Dialogue: 0,0:17:05.50,0:17:09.08,Default,,0,0,0,,Канна бастауыш сыныптағы достарымен қыдырып жүр.
Dialogue: 0,0:17:09.16,0:17:12.66,Default,,0,0,0,,Бастауыш мектеп? Бұл не?
Dialogue: 0,0:17:12.75,0:17:15.91,Default,,0,0,0,,Мұндағыдан мүлде басқаша.
Dialogue: 0,0:17:16.00,0:17:20.41,Default,,0,0,0,,Канна-сама Кимун Камуи-самаға керек болғысы келеді.
Dialogue: 0,0:17:20.50,0:17:23.50,Default,,0,0,0,,Еркелік тарта берген екен.
Dialogue: 0,0:17:24.12,0:17:26.91,Default,,0,0,0,,Олай болса, қазір қажет уақыт.
Dialogue: 0,0:17:27.00,0:17:30.75,Default,,0,0,0,,Тілектің орындалатын кезі емес пе?
Dialogue: 0,0:17:30.83,0:17:33.66,Default,,0,0,0,,Не? Бұл не деген...
Dialogue: 0,0:17:33.75,0:17:35.12,Default,,0,0,0,,Ең алдымен...
Dialogue: 0,0:17:35.75,0:17:39.16,Default,,0,0,0,,Мен сендердің Канна-чанмен кездескендеріңді қаламаймын.
Dialogue: 0,0:17:39.25,0:17:41.54,Default,,0,0,0,,Иә? Сол себепті
Dialogue: 0,0:17:41.62,0:17:44.66,Default,,0,0,0,,Себебі мен оның ауыратынын білемін.
Dialogue: 0,0:17:45.41,0:17:49.04,Default,,0,0,0,,Адамдық тұрғыдан сіз немқұрайлы адамсыз...
Dialogue: 0,0:17:49.12,0:17:51.41,Default,,0,0,0,,Ол ең нашар әке.
Dialogue: 0,0:17:52.04,0:17:53.37,Default,,0,0,0,,850 жылы адамзат алғаш рет Титаннан өз жерін қайтарып алды
Dialogue: 0,0:17:55.29,0:17:58.16,Default,,0,0,0,,Адами құндылықтарды есте сақтаңыз және басынан бастаңыз!
Dialogue: 0,0:17:58.25,0:18:00.08,Default,,0,0,0,,Гваааах!
Dialogue: 0,0:18:00.16,0:18:01.83,Default,,0,0,0,,(Кісі өлтіру ниетінің дыбысы)
Dialogue: 0,0:18:05.04,0:18:06.16,Default,,0,0,0,,Осы сатыға разы емессің бе?
Dialogue: 0,0:18:06.25,0:18:08.37,Default,,0,0,0,,Қорықпа...
Dialogue: 0,0:18:08.45,0:18:12.16,Default,,0,0,0,,Жалғыз нәрсе болды, менің өлім императорына деген өшім болды.
Dialogue: 0,0:18:13.70,0:18:14.54,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:18:16.37,0:18:17.54,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:19.50,0:18:22.08,Default,,0,0,0,,Қолыңды тарт, Кимун Камуи!
Dialogue: 0,0:18:22.16,0:18:23.79,Default,,0,0,0,,Мен сені өлтіремін!
Dialogue: 0,0:18:23.87,0:18:24.83,Default,,0,0,0,,Һм?
Dialogue: 0,0:18:26.41,0:18:28.00,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:18:29.91,0:18:31.33,Default,,0,0,0,,Мм! Ннн!
Dialogue: 0,0:18:31.95,0:18:34.29,Default,,0,0,0,,Гах! (қирату дыбысы)
Dialogue: 0,0:18:37.75,0:18:38.66,Default,,0,0,0,,Нуу...
Dialogue: 0,0:18:38.75,0:18:39.70,Default,,0,0,0,,Гррр…
Dialogue: 0,0:18:39.79,0:18:40.70,Default,,0,0,0,,Ху-хун ха... (жойылған дыбыс)
Dialogue: 0,0:18:43.00,0:18:44.75,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:18:44.83,0:18:47.08,Default,,0,0,0,,Гууууууууууууууууууу!
Dialogue: 0,0:18:49.70,0:18:50.79,Default,,0,0,0,,Гах...
Dialogue: 0,0:18:52.62,0:18:53.87,Default,,0,0,0,,Уау! (қирату дыбысы)
Dialogue: 0,0:18:53.95,0:18:55.29,Default,,0,0,0,,Тор!
Dialogue: 0,0:18:56.54,0:18:57.91,Default,,0,0,0,,Кимун Камуи мырза
Dialogue: 0,0:18:58.00,0:19:00.62,Default,,0,0,0,,Сабырлы бол деп айтуым керек еді.
Dialogue: 0,0:19:00.70,0:19:01.87,Default,,0,0,0,,Я...
Dialogue: 0,0:19:02.62,0:19:05.08,Default,,0,0,0,,Кобаяши мырза, тоқтаңыз.
Dialogue: 0,0:19:05.16,0:19:08.20,Default,,0,0,0,,Раббым жанжалға келгенде аямайды.
Dialogue: 0,0:19:08.29,0:19:13.16,Default,,0,0,0,,Әй, төбелесу тезірек болатын сияқты, Азад.
Dialogue: 0,0:19:13.75,0:19:16.58,Default,,0,0,0,,Басынан бастап мен мұны жақсы көремін ...
Dialogue: 0,0:19:16.66,0:19:19.12,Default,,0,0,0,,Жоқ, ымыраға келейік.
Dialogue: 0,0:19:19.20,0:19:20.37,Default,,0,0,0,,Не?
Dialogue: 0,0:19:20.45,0:19:23.83,Default,,0,0,0,,Бізге тек айдаһар шары керек.
Dialogue: 0,0:19:24.45,0:19:27.29,Default,,0,0,0,,Оны даусыз жасауға болады
Dialogue: 0,0:19:27.37,0:19:30.37,Default,,0,0,0,,Тіпті қолында Канна-сама болмаса да
Dialogue: 0,0:19:30.45,0:19:34.66,Default,,0,0,0,,Бұл дүниедегі айдаһар шарының күшін шығарыңыз.
Dialogue: 0,0:19:35.29,0:19:39.16,Default,,0,0,0,,Канна-самадан сұрай аласыз ба? Кобаяши мырза
Dialogue: 0,0:19:40.62,0:19:43.08,Default,,0,0,0,,Бұл қақтығыстың құралы, солай ма?
Dialogue: 0,0:19:43.16,0:19:44.00,Default,,0,0,0,,Солай ма...
Dialogue: 0,0:19:44.00,0:19:44.66,Default,,0,0,0,,Солай ма...
Dialogue: 0,0:19:44.00,0:19:44.66,Default,,0,0,0,,(шу)
Dialogue: 0,0:19:44.66,0:19:44.75,Default,,0,0,0,,(шу)
Dialogue: 0,0:19:44.75,0:19:45.83,Default,,0,0,0,,(шу)
Dialogue: 0,0:19:44.75,0:19:45.83,Default,,0,0,0,,Жасаңыз
Dialogue: 0,0:19:46.45,0:19:48.04,Default,,0,0,0,,Канна-чан?
Dialogue: 0,0:19:51.87,0:19:53.04,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:19:54.41,0:19:58.29,Default,,0,0,0,,Әке, мен істеймін...
Dialogue: 0,0:20:00.45,0:20:01.75,Default,,0,0,0,,Маған мадақтаңдар
Dialogue: 0,0:20:02.41,0:20:03.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:06.91,0:20:10.08,Default,,0,0,0,,Оны бастапқыда сіз жойған болсаңыз да?
Dialogue: 0,0:20:10.16,0:20:12.04,Default,,0,0,0,,Көңілсіз болмаңыз
Dialogue: 0,0:20:12.62,0:20:15.45,Default,,0,0,0,,Дос ретінде өз міндеттеріңізді орындаңыз
Dialogue: 0,0:20:15.54,0:20:18.20,Default,,0,0,0,,Егер жетістікке жетсең, мен сені марапаттаймын.
Dialogue: 0,0:20:18.91,0:20:20.08,Default,,0,0,0,,(өлшемді қақпаның ашылу дыбысы)
Dialogue: 0,0:20:20.16,0:20:23.12,Default,,0,0,0,,Ісімді бітірдім, үйге бара жатырмын.
Dialogue: 0,0:20:23.20,0:20:24.45,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:20:25.16,0:20:27.00,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:20:27.08,0:20:28.58,Default,,0,0,0,,Өте жаман...
Dialogue: 0,0:20:28.66,0:20:33.00,Default,,0,0,0,,Ішімдіктің дәмі бірдей болса да, тіл табыса алмайтын сияқтымыз.
Dialogue: 0,0:20:33.08,0:20:36.79,Default,,0,0,0,,Оның үстіне менімен қанағаттанарлықтай күресуге де күшің жетпейді.
Dialogue: 0,0:20:37.95,0:20:41.79,Default,,0,0,0,,Сіз ештеңе істей алмайсыз.
Dialogue: 0,0:20:45.91,0:20:47.16,Default,,0,0,0,,Кобаяши мырза...
Dialogue: 0,0:20:49.20,0:20:53.08,Default,,0,0,0,,Біз сізге кейінірек қайта хабарласамыз.
Dialogue: 0,0:20:53.16,0:20:54.95,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:57.62,0:20:59.08,Default,,0,0,0,,(Өлшем қақпасының жабылу дыбысы)
Dialogue: 0,0:21:06.25,0:21:10.16,Default,,0,0,0,,Мен қалағанымды жасадым.
Dialogue: 0,0:21:10.25,0:21:11.54,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:21:11.62,0:21:18.04,Default,,0,0,0,,(Жөнделіп жатқан бөлменің дыбысы)
Dialogue: 0,0:21:19.25,0:21:20.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:29.87,0:21:33.29,Default,,0,0,0,,Ха... Бүгін тамақ ішуге шығайық!
Dialogue: 0,0:21:35.12,0:21:36.25,Default,,0,0,0,,Хмм! Ветчина! Муммугу!
Dialogue: 0,0:21:36.25,0:21:38.00,Default,,0,0,0,,Хмм! Ветчина! Муммугу!
Dialogue: 0,0:21:36.25,0:21:38.00,Default,,0,0,0,,Сен көп жейсің, Канна.
Dialogue: 0,0:21:38.08,0:21:40.66,Default,,0,0,0,,Танысқанымызға көп уақыт болды, бұл керемет!
Dialogue: 0,0:21:40.75,0:21:44.62,Default,,0,0,0,,Ашулы! Қаһарлы жанасу!
Dialogue: 0,0:21:44.70,0:21:45.79,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:45.87,0:21:49.04,Default,,0,0,0,,Қасыңдағы адам кім болды?
Dialogue: 0,0:21:49.12,0:21:53.95,Default,,0,0,0,,Мен де білмеймін. Ол сиқыршы болса керек.
Dialogue: 0,0:21:54.04,0:21:57.00,Default,,0,0,0,,Сіз «Азард» сияқты бірдеңе айттыңыз.
Dialogue: 0,0:21:57.62,0:21:59.29,Default,,0,0,0,,Азад…
Dialogue: 0,0:21:59.37,0:22:00.75,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз~
Dialogue: 0,0:22:00.83,0:22:03.25,Default,,0,0,0,,Теппаняки кеспесі және төзімділік!
Dialogue: 0,0:22:03.33,0:22:06.75,Default,,0,0,0,,Ассорти ірімшік пен шұжықты қосыңыз!
Dialogue: 0,0:22:08.12,0:22:11.04,Default,,0,0,0,,Ахаха мен осы жолмен келе жатырмын~ Хахаха...
Dialogue: 0,0:22:11.12,0:22:12.12,Default,,0,0,0,,Сен кереметсің, Кёко. Ол қандай? Сымбатты ма?
Dialogue: 0,0:22:12.20,0:22:13.50,Default,,0,0,0,,Қараңдаршы, жүгіру қауіпті.
Dialogue: 0,0:22:13.58,0:22:19.58,Default,,0,0,0,,(Ата-ана мен балалардың сөйлескен дыбыстары)
Dialogue: 0,0:22:21.62,0:22:24.58,Default,,0,0,0,,Бірақ бұл дұрыс емес сияқты, Кобаяши мырза.
Dialogue: 0,0:22:24.66,0:22:25.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:25.54,0:22:26.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:25.54,0:22:26.08,Default,,0,0,0,,Айдаһар шарын немесе басқа нәрсені жасаудың орнына
Dialogue: 0,0:22:26.08,0:22:28.25,Default,,0,0,0,,Айдаһар шарын немесе басқа нәрсені жасаудың орнына
Dialogue: 0,0:22:28.33,0:22:29.95,Default,,0,0,0,,Мен саған Канна-чанды бермеймін.
Dialogue: 0,0:22:30.04,0:22:34.00,Default,,0,0,0,,Әдетте бұл ұсынысты Кобаяши мырза жасайды.
Dialogue: 0,0:22:34.08,0:22:35.33,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:22:35.41,0:22:38.83,Default,,0,0,0,,Мен Канна-чанды адам баласындай көремін.
Dialogue: 0,0:22:38.91,0:22:41.54,Default,,0,0,0,,Канна-чан да осылай көрінгісі келеді.
Dialogue: 0,0:22:42.87,0:22:45.91,Default,,0,0,0,,Мен оған тым араластым ба?
Dialogue: 0,0:22:46.00,0:22:47.37,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:22:48.08,0:22:52.58,Default,,0,0,0,,Егер сіз шынымен де сол күндерден ләззат алғыңыз келсе, байыптырақ болуыңыз керек.
Dialogue: 0,0:22:52.66,0:22:54.91,Default,,0,0,0,,Нағыз адамдар осындай емес пе?
Dialogue: 0,0:22:55.00,0:22:57.87,Default,,0,0,0,,Қарт керек емес десе
Dialogue: 0,0:22:57.95,0:23:00.87,Default,,0,0,0,,Канна-чанның әкесі болғаныңды қалаймын.
Dialogue: 0,0:23:04.50,0:23:05.58,Default,,0,0,0,,Кобаяши
Dialogue: 0,0:23:07.91,0:23:09.04,Default,,0,0,0,,Мен...
Dialogue: 0,0:23:09.66,0:23:12.87,Default,,0,0,0,,Кобаяши мен Тору-сама
Dialogue: 0,0:23:12.95,0:23:14.75,Default,,0,0,0,,Сайкава мен Ируру
Dialogue: 0,0:23:15.62,0:23:17.70,Default,,0,0,0,,Мектептегі достар
Dialogue: 0,0:23:18.91,0:23:22.04,Default,,0,0,0,,Жарайды, өйткені бәрі осында...
Dialogue: 0,0:23:22.87,0:23:24.08,Default,,0,0,0,,Уайымдамаңыз...
Dialogue: 0,0:23:24.83,0:23:27.04,Default,,0,0,0,,Мен мұндай әкені білмеймін...
Dialogue: 0,0:23:27.12,0:23:30.16,Default,,0,0,0,,(Су тамшылары құлаған дыбыс)
Dialogue: 0,0:23:33.25,0:23:34.70,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:23:35.37,0:23:38.91,Default,,0,0,0,,Мен Канна-чанның әкесіне жаман сөз айттым.
Dialogue: 0,0:23:39.00,0:23:41.16,Default,,0,0,0,,Мүмкін менің эгоым шықты
Dialogue: 0,0:23:42.00,0:23:44.08,Default,,0,0,0,,Отбасы қалыпты адам ретінде
Dialogue: 0,0:23:44.16,0:23:47.04,Default,,0,0,0,,Себебі мен Канна-чанның мұны қалайтынын білдім.
Dialogue: 0,0:23:47.12,0:23:49.16,Default,,0,0,0,,Мен солай деп үміттенемін
Dialogue: 0,0:23:50.00,0:23:54.04,Default,,0,0,0,,Бірақ анау қарт түсінбейді.
Dialogue: 0,0:23:55.37,0:23:57.50,Default,,0,0,0,,Уф... бұл ақылсыз!
Dialogue: 0,0:23:57.58,0:23:58.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:59.91,0:24:04.33,Default,,0,0,0,,Бірақ... Мен де басында түсінбедім.
Dialogue: 0,0:24:07.16,0:24:10.04,Default,,0,0,0,,Жылы жерде...
Dialogue: 0,0:24:10.12,0:24:14.29,Default,,0,0,0,,(Оттың шуы)
Dialogue: 0,0:24:14.37,0:24:18.37,Default,,0,0,0,,Адамдар суықтан осылай аман қалады.
Dialogue: 0,0:24:20.62,0:24:24.54,Default,,0,0,0,,Жылы көрінді, мен де соған еліктедім.
Dialogue: 0,0:24:26.12,0:24:29.37,Default,,0,0,0,,Сосын шынымен жылы сезінді...
Dialogue: 0,0:24:29.45,0:24:31.41,Default,,0,0,0,,Тек дене емес...
Dialogue: 0,0:24:32.12,0:24:35.16,Default,,0,0,0,,Мен оны жылытудың бір жолы бар деп ойладым.
Dialogue: 0,0:24:35.16,0:24:36.16,Default,,0,0,0,,Мен оны жылытудың бір жолы бар деп ойладым.
Dialogue: 0,0:24:35.16,0:24:36.16,Default,,0,0,0,,(Кимун Камуи есінеу)
Dialogue: 0,0:24:36.16,0:24:38.12,Default,,0,0,0,,(Кимун Камуи есінеу)
Dialogue: 0,0:24:45.20,0:24:46.91,Default,,0,0,0,,Үйге кететін уақыт келді
Dialogue: 0,0:24:47.62,0:24:49.75,Default,,0,0,0,,Маған айдаһар шарын жасау керек
Dialogue: 0,0:24:49.83,0:24:54.00,Default,,0,0,0,,Алдымен үйге бара аласыз. Мен үйге ақырын барамын.
Dialogue: 0,0:24:54.08,0:24:54.95,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:25:03.41,0:25:06.00,Default,,0,0,0,,Мен өз өмірімді бірнеше рет тәуекел еттім.
Dialogue: 0,0:25:06.91,0:25:09.83,Default,,0,0,0,,Менің сезімдерім қарапайым адамдармен үндес емес шығар деп ойладым.
Dialogue: 0,0:25:12.87,0:25:16.87,Default,,0,0,0,,Бірақ мен өзім мықты емес екенімді білемін.
Dialogue: 0,0:25:18.58,0:25:20.70,Default,,0,0,0,,Ол сүйкімді қыз
Dialogue: 0,0:25:27.08,0:25:28.87,Default,,0,0,0,,Төзе бер, шыдай бер!
Dialogue: 0,0:25:30.33,0:25:32.58,Default,,0,0,0,,Бұл балаларға арналған
Dialogue: 0,0:25:33.83,0:25:34.91,Default,,0,0,0,,Кобаяши
Dialogue: 0,0:25:35.58,0:25:37.20,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:25:37.29,0:25:38.75,Default,,0,0,0,,Неліктен мұнда?
Dialogue: 0,0:25:38.83,0:25:40.75,Default,,0,0,0,,Жаңа ойындарды сатып алу
Dialogue: 0,0:25:41.62,0:25:43.00,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:25:43.08,0:25:47.45,Default,,0,0,0,,Сіз Кимун Камуи құндылықтарына үлкен үміт артасыз.
Dialogue: 0,0:25:47.54,0:25:49.41,Default,,0,0,0,,Сіз тәкаппарсыз ба?
Dialogue: 0,0:25:49.50,0:25:52.08,Default,,0,0,0,,Мұны істеу мүмкін емес дейді.
Dialogue: 0,0:25:52.16,0:25:53.45,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:25:53.54,0:25:56.12,Default,,0,0,0,,Бірінші орында айдаһар рухы
Dialogue: 0,0:25:56.20,0:25:57.83,Default,,0,0,0,,Ересектер мен балалар жоқ
Dialogue: 0,0:25:58.41,0:26:00.79,Default,,0,0,0,,Сізге тек күш қажет
Dialogue: 0,0:26:00.87,0:26:03.66,Default,,0,0,0,,Сондықтан ата-ана да балаларын қорғамайды.
Dialogue: 0,0:26:04.41,0:26:08.08,Default,,0,0,0,,Адам баласы айтқандай ата-ана мен бала махаббаты деген ұғым жоқ.
Dialogue: 0,0:26:09.12,0:26:11.62,Default,,0,0,0,,«Адам ойнау» дегеніміз не?
Dialogue: 0,0:26:11.70,0:26:12.91,Default,,0,0,0,,Иә.
Dialogue: 0,0:26:13.58,0:26:16.08,Default,,0,0,0,,Мұны сізден бұрын сұрап көрдіңіз бе?
Dialogue: 0,0:26:16.16,0:26:19.00,Default,,0,0,0,,«Сіз айдаһармен тең болуға тырысасыз ба?»
Dialogue: 0,0:26:19.08,0:26:19.91,Default,,0,0,0,,О
Dialogue: 0,0:26:20.79,0:26:23.79,Default,,0,0,0,,Сол кезде мен иә дедім.
Dialogue: 0,0:26:23.87,0:26:28.66,Default,,0,0,0,,Егер мен осында және қазір өз сезімімді тыйып отырсам, мен бірдей жауап бере алмаймын.
Dialogue: 0,0:26:28.75,0:26:30.87,Default,,0,0,0,,Сізге күш жетпейді деп айту
Dialogue: 0,0:26:30.95,0:26:34.62,Default,,0,0,0,,Жоқ, шынымен де, мені мазалайтыны осы...
Dialogue: 0,0:26:34.70,0:26:36.08,Default,,0,0,0,,Мұндай уақыт бірлігі қалай?
Dialogue: 0,0:26:36.16,0:26:40.16,Default,,0,0,0,,Күшті болуға тырысу туралы не айтасыз? Кобаяши мырза
Dialogue: 0,0:26:40.25,0:26:41.54,Default,,0,0,0,,Мен ынтымақтастық жасаймын.
Dialogue: 0,0:26:41.62,0:26:42.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:42.70,0:26:45.54,Default,,0,0,0,,- (Басқарушы директор) Эй - (Кобаяши) Басқарушы директор!
Dialogue: 0,0:26:50.95,0:26:51.79,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:26:52.41,0:26:54.12,Default,,0,0,0,,Рахмет Шота-кун
Dialogue: 0,0:26:54.79,0:26:57.45,Default,,0,0,0,,Мен Лукоаны соңғы бірнеше күнде көрмедім...
Dialogue: 0,0:26:57.54,0:26:58.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:59.66,0:27:01.66,Default,,0,0,0,,Өйткені Лукоа шетте.
Dialogue: 0,0:27:01.75,0:27:04.62,Default,,0,0,0,,Қақтығыс болған жерлерде сіз көрінбейсіз.
Dialogue: 0,0:27:04.70,0:27:08.50,Default,,0,0,0,,Ұзақ уақыт бойы, араласусыз немесе кедергісіз
Dialogue: 0,0:27:08.58,0:27:11.12,Default,,0,0,0,,Бұл өкініштің нәтижесі болса керек.
Dialogue: 0,0:27:11.70,0:27:14.79,Default,,0,0,0,,Өтінемін, ол адамды кінәламаңыз.
Dialogue: 0,0:27:14.87,0:27:17.20,Default,,0,0,0,,А... Мен олай ойламаймын.
Dialogue: 0,0:27:18.75,0:27:20.37,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:27:22.95,0:27:24.16,Default,,0,0,0,,Бірдеңе...
Dialogue: 0,0:27:24.25,0:27:28.00,Default,,0,0,0,,Хаос пен Гармония күштері арасындағы шайқас басталғалы тұрған сияқты.
Dialogue: 0,0:27:28.08,0:27:29.41,Default,,0,0,0,,Солай сияқты.
Dialogue: 0,0:27:30.04,0:27:33.00,Default,,0,0,0,,Жоқ, мен қызық...
Dialogue: 0,0:27:33.62,0:27:36.12,Default,,0,0,0,,Айдаһарлар неге мұндай...
Dialogue: 0,0:27:36.83,0:27:38.70,Default,,0,0,0,,Бұл мағынасы жоқ па?
Dialogue: 0,0:27:38.79,0:27:42.70,Default,,0,0,0,,Ата-ана өз балаларын пайдаланады деген ой
Dialogue: 0,0:27:42.79,0:27:44.58,Default,,0,0,0,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:27:44.66,0:27:47.66,Default,,0,0,0,,Мен сенбеймін...
Dialogue: 0,0:27:47.75,0:27:53.58,Default,,0,0,0,,Кейде қанағаттану сезімі қанағаттану және бостандық сезімі болып табылады.
Dialogue: 0,0:27:53.66,0:27:58.91,Default,,0,0,0,,Біреулер біліммен, біреулер күшпен алады.
Dialogue: 0,0:27:59.00,0:28:03.75,Default,,0,0,0,,Адам нені жинаса, сол арқылы нәтиже жинайды
Dialogue: 0,0:28:03.83,0:28:08.41,Default,,0,0,0,,Өлімнің соңғы нәтижесін қабылдау үшін өмір сүру
Dialogue: 0,0:28:08.50,0:28:11.16,Default,,0,0,0,,Менің теориям бұл...
Dialogue: 0,0:28:11.25,0:28:16.58,Default,,0,0,0,,Бірақ қанша адам сізді бұған сендіре алады?
Dialogue: 0,0:28:17.20,0:28:20.66,Default,,0,0,0,,Айдаһарға мән қосу әрекеті
Dialogue: 0,0:28:20.75,0:28:27.37,Default,,0,0,0,,Өмірінің соңында қанағат алумен бірдей құндылық деп ойлаймын...
Dialogue: 0,0:28:27.45,0:28:30.62,Default,,0,0,0,,Бұл сіз жеткілікті тырыспасаңыз, мүмкін емес дегенді білдіре ме?
Dialogue: 0,0:28:30.70,0:28:31.95,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:28:32.04,0:28:34.50,Default,,0,0,0,,200 жылға жуық дайындық?
Dialogue: 0,0:28:34.58,0:28:37.83,Default,,0,0,0,,Адам болуды доғар деп тұрған жоқсың ба?
Dialogue: 0,0:28:37.91,0:28:39.66,Default,,0,0,0,,Бұл жақсы емес...
Dialogue: 0,0:28:39.75,0:28:40.95,Default,,0,0,0,,Немесе...
Dialogue: 0,0:28:41.04,0:28:44.37,Default,,0,0,0,,Тағы бір нұсқа - айла қолдану.
Dialogue: 0,0:28:44.45,0:28:45.75,Default,,0,0,0,,Хмм... құпия қулық?
Dialogue: 0,0:28:48.75,0:28:50.45,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:28:50.54,0:28:52.45,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:28:53.25,0:28:55.83,Default,,0,0,0,,Бұл менікі ме?
Dialogue: 0,0:28:55.91,0:28:56.37,Default,,0,0,0,,Хун хун хун хун!
Dialogue: 0,0:28:56.37,0:28:59.91,Default,,0,0,0,,Хун хун хун хун!
Dialogue: 0,0:28:56.37,0:28:59.91,Default,,0,0,0,,Эй, Канна, Кобаяши мырзаға алғыс айтқыңыз келе ме?
Dialogue: 0,0:29:02.12,0:29:03.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:29:04.00,0:29:06.29,Default,,0,0,0,,Рахмет Кобаяши
Dialogue: 0,0:29:13.33,0:29:16.33,Default,,0,0,0,,Қобаяшиден алғанымды бағалаймын
Dialogue: 0,0:29:16.41,0:29:17.87,Default,,0,0,0,,Иә
Dialogue: 0,0:29:17.95,0:29:19.41,Default,,0,0,0,,Ха~
Dialogue: 0,0:29:20.41,0:29:22.70,Default,,0,0,0,,Менің ойымша, қазір өзімді жақсы сезінемін.
Dialogue: 0,0:29:22.79,0:29:23.75,Default,,0,0,0,,Кобаяши!
Dialogue: 0,0:29:24.41,0:29:27.45,Default,,0,0,0,,-Рютама жасаңыз! -(Кобаяши) А... Иә.
Dialogue: 0,0:29:28.70,0:29:29.75,Default,,0,0,0,,Хмм~
Dialogue: 0,0:29:29.83,0:29:30.87,Default,,0,0,0,,(разряд дыбысы)
Dialogue: 0,0:29:30.95,0:29:32.45,Default,,0,0,0,,Айдаһар шары дегеніміз не?
Dialogue: 0,0:29:32.54,0:29:36.75,Default,,0,0,0,,Принцип сиқыршының ыдысқа мананы салғанымен бірдей.
Dialogue: 0,0:29:37.45,0:29:40.50,Default,,0,0,0,,Бөлу арқылы біз жинақталған қуатты аламыз.
Dialogue: 0,0:29:40.58,0:29:43.87,Default,,0,0,0,,Неліктен Канна оны еркелік ретінде бұзды?
Dialogue: 0,0:29:43.95,0:29:46.04,Default,,0,0,0,,Сіз бұл күшке ие болмадыңыз ба?
Dialogue: 0,0:29:46.12,0:29:51.33,Default,,0,0,0,,Қуат массасы денеге әлі сығылған кезде қабылданған болуы керек.
Dialogue: 0,0:29:52.62,0:29:56.08,Default,,0,0,0,,Сығылған сыдырманың ішінде қысылған сыдырма бар.
Dialogue: 0,0:29:56.16,0:29:58.79,Default,,0,0,0,,Сонымен, сіз жай ғана қалтаның ішіне көштіңіз бе?
Dialogue: 0,0:29:58.87,0:30:02.37,Default,,0,0,0,,Мен бұл ұқсастықты түсінбеймін, бірақ... иә?
Dialogue: 0,0:30:02.45,0:30:05.33,Default,,0,0,0,,Кобаяши мырза не істеп жатыр?
Dialogue: 0,0:30:05.41,0:30:06.83,Default,,0,0,0,,Хмм?
Dialogue: 0,0:30:06.91,0:30:08.70,Default,,0,0,0,,Хат жазу
Dialogue: 0,0:30:08.79,0:30:09.62,Default,,0,0,0,,Хат?
Dialogue: 0,0:30:10.33,0:30:13.58,Default,,0,0,0,,Мен бұл сиқырлы кітапты басқарушы директордан алдым.
Dialogue: 0,0:30:13.66,0:30:17.08,Default,,0,0,0,,200 жыл бойы өңделген сиқырлы технология
Dialogue: 0,0:30:17.16,0:30:19.91,Default,,0,0,0,,Бұл бір кітапта жазылған.
Dialogue: 0,0:30:20.00,0:30:21.29,Default,,0,0,0,,(Танжиро) Бір сәт бұрын осы адам осы жерде жай ғана серуендеп жүрген еді…
Dialogue: 0,0:30:21.91,0:30:25.12,Default,,0,0,0,,Адамдар ұзақ уақыт жалғыз өмір сүре алмайды, бірақ
Dialogue: 0,0:30:25.20,0:30:27.54,Default,,0,0,0,,Ниеттер, идеялар және құндылықтар
Dialogue: 0,0:30:27.62,0:30:30.54,Default,,0,0,0,,Таяқшаны беру кезінде қатарға тұру
Dialogue: 0,0:30:30.62,0:30:34.54,Default,,0,0,0,,Тіпті басқалармен сөйлесу тәсілі де тиімдірек болуы керек.
Dialogue: 0,0:30:36.58,0:30:40.45,Default,,0,0,0,,Сол себепті мен күнделікті өмірде жинағанымды осы дүниеде пайдаланамын.
Dialogue: 0,0:30:41.12,0:30:44.41,Default,,0,0,0,,Мен Канна-чанның әкесіне айтамын деп ойлаймын.
Dialogue: 0,0:30:45.12,0:30:46.25,Default,,0,0,0,,Бұл хат!
Dialogue: 0,0:30:46.83,0:30:49.70,Default,,0,0,0,,-Кобаяши мен де жазамын! -(Кобаяши) Иә.
Dialogue: 0,0:30:49.79,0:30:51.41,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:30:53.83,0:30:57.00,Default,,0,0,0,,Кимун Камуи айдаһар шарын тартып алмақшы.
Dialogue: 0,0:30:57.08,0:30:59.20,Default,,0,0,0,,Өйткені жау – Люминас.
Dialogue: 0,0:30:59.95,0:31:03.08,Default,,0,0,0,,Неліктен үйлесімді күш агрессивті қозғалады?
Dialogue: 0,0:31:03.70,0:31:05.00,Default,,0,0,0,,Жек көру...
Dialogue: 0,0:31:05.08,0:31:07.66,Default,,0,0,0,,Люминдер бастапқыда қалыпты.
Dialogue: 0,0:31:07.75,0:31:10.33,Default,,0,0,0,,Хаотикалық күштер зорлық-зомбылық жасайды
Dialogue: 0,0:31:10.41,0:31:13.41,Default,,0,0,0,,Егер ештеңе шықпаса, мен ештеңе істемеймін.
Dialogue: 0,0:31:13.50,0:31:15.25,Default,,0,0,0,,Кимун Камуи
Dialogue: 0,0:31:15.33,0:31:18.54,Default,,0,0,0,,Өйткені мен 100 жылдан кейінгі соғысқа дейін күшімді жинағым келеді.
Dialogue: 0,0:31:18.62,0:31:21.79,Default,,0,0,0,,Қажетсіз төбелес пен зорлық-зомбылықтың салдарынан назар аудару.
Dialogue: 0,0:31:21.87,0:31:23.87,Default,,0,0,0,,Толқындар болмайды
Dialogue: 0,0:31:23.95,0:31:25.29,Default,,0,0,0,,Хмм...
Dialogue: 0,0:31:25.37,0:31:29.75,Default,,0,0,0,,Алайда, айдаһар добы Кимун Камуиге барғанда,
Dialogue: 0,0:31:29.83,0:31:32.83,Default,,0,0,0,,Шайқас қызу басталады.
Dialogue: 0,0:31:32.91,0:31:35.08,Default,,0,0,0,,Екі тарап та зардап шегеді.
Dialogue: 0,0:31:35.16,0:31:36.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:36.29,0:31:38.95,Default,,0,0,0,,Саған қалдырамын, Азад.
Dialogue: 0,0:31:39.70,0:31:41.08,Default,,0,0,0,,Екеуі де...
Dialogue: 0,0:31:42.25,0:31:43.16,Default,,0,0,0,,Не болды?
Dialogue: 0,0:31:43.25,0:31:45.45,Default,,0,0,0,,Маған бірдеңе дұрыс емес...
Dialogue: 0,0:31:46.50,0:31:47.66,Default,,0,0,0,,Дайын!
Dialogue: 0,0:31:49.00,0:31:54.54,Default,,0,0,0,,Айдаһар шарларын жасау барысы туралы есеп ретінде егжей-тегжейлі сөйлесейік.
Dialogue: 0,0:31:54.62,0:31:55.95,Default,,0,0,0,,Оу!
Dialogue: 0,0:31:56.04,0:31:57.33,Default,,0,0,0,,- (Кобаяши) Тор - (Тор) Иә
Dialogue: 0,0:31:57.41,0:31:58.75,Default,,0,0,0,,Мен сізге бір жақсылық сұрасам болады ма?
Dialogue: 0,0:31:58.83,0:32:00.12,Default,,0,0,0,,Иә
Dialogue: 0,0:32:11.00,0:32:12.83,Default,,0,0,0,,Хат
Dialogue: 0,0:32:12.91,0:32:17.41,Default,,0,0,0,,Айдаһар шары жасалған соң маған жіберсеңіздер жақсы болар еді.
Dialogue: 0,0:32:17.50,0:32:21.16,Default,,0,0,0,,Сакені дұрыс ішу туралы кітап бар сияқты.
Dialogue: 0,0:32:21.25,0:32:23.12,Default,,0,0,0,,Хо
Dialogue: 0,0:32:23.20,0:32:25.25,Default,,0,0,0,,Демек, бұл менмін
Dialogue: 0,0:32:25.33,0:32:27.12,Default,,0,0,0,,Бірақ, сендер—
Dialogue: 0,0:32:30.91,0:32:32.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:32:32.29,0:32:33.45,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:32:33.54,0:32:36.20,Default,,0,0,0,,Прогресс туралы не деуге болады?
Dialogue: 0,0:32:36.29,0:32:39.45,Default,,0,0,0,,Мен туралы жеккөрінішті сөздерге толы.
Dialogue: 0,0:32:39.54,0:32:43.12,Default,,0,0,0,,Мені осындай адам құмартады.
Dialogue: 0,0:32:43.20,0:32:44.45,Default,,0,0,0,,Бұл менің бірінші рет.
Dialogue: 0,0:32:45.62,0:32:49.33,Default,,0,0,0,,Тіпті Канна үшін мектепте болған оқиғалар немесе соған ұқсас нәрселер бар.
Dialogue: 0,0:32:49.41,0:32:54.16,Default,,0,0,0,,Сайкава деген кім? Ол мені бейтаныс адаммен таныстырып жатыр ма?
Dialogue: 0,0:32:54.25,0:32:55.66,Default,,0,0,0,,Әй?
Dialogue: 0,0:32:55.75,0:32:59.33,Default,,0,0,0,,Бұл алкогольді ішудің тамаша тәсілі.
Dialogue: 0,0:32:59.41,0:33:01.29,Default,,0,0,0,,Мен оны келесі жолы көремін.
Dialogue: 0,0:33:03.58,0:33:04.41,Default,,0,0,0,,Көрінбейтін белгілері жоқ, біртіндеп өршіп бара жатқан ауру сияқты—
Dialogue: 0,0:33:07.25,0:33:08.12,Default,,0,0,0,,Жауап беру
Dialogue: 0,0:33:08.83,0:33:10.50,Default,,0,0,0,,Оны Кобаяшиге беріңіз.
Dialogue: 0,0:33:11.16,0:33:13.29,Default,,0,0,0,,Сіз оны дұрыс оқыдыңыз...
Dialogue: 0,0:33:13.37,0:33:15.79,Default,,0,0,0,,Иә? Бұл табиғи
Dialogue: 0,0:33:15.87,0:33:19.66,Default,,0,0,0,,Мен адамға бағытталған нәрседен қашатын адам емеспін.
Dialogue: 0,0:33:19.75,0:33:23.08,Default,,0,0,0,,Егер айтар сөзің болса, бар күшіңмен айт!
Dialogue: 0,0:33:23.16,0:33:26.50,Default,,0,0,0,,Барлығын алып, қайтарыңыз.
Dialogue: 0,0:33:26.58,0:33:28.20,Default,,0,0,0,,Сіз…
Dialogue: 0,0:33:28.29,0:33:32.83,Default,,0,0,0,,Ол шайқаста өте жағымды жауынгер.
Dialogue: 0,0:33:32.91,0:33:36.25,Default,,0,0,0,,Сенің табиғатыңды өзгертуді сол жақтағылар айтып жатыр.\NБұл
Dialogue: 0,0:33:37.33,0:33:40.08,Default,,0,0,0,,жауабы ма?
Dialogue: 0,0:33:40.16,0:33:43.00,Default,,0,0,0,,Алкогольді ішу туралы ақпарат үшін рахмет!!
Dialogue: 0,0:33:43.08,0:33:44.25,Default,,0,0,0,,Қарғыс атқыр қарт!
Dialogue: 0,0:33:44.33,0:33:45.66,Default,,0,0,0,,Жақсы қарт жоқ!
Dialogue: 0,0:33:45.75,0:33:48.12,Default,,0,0,0,,Канна-чан, көбірек жауаптар!
Dialogue: 0,0:33:48.20,0:33:50.04,Default,,0,0,0,,Жазғыңыз келгеннің бәрін жазыңыз!
Dialogue: 0,0:33:50.12,0:33:52.00,Default,,0,0,0,,Уау! Ресба!
Dialogue: 0,0:33:53.54,0:33:57.45,Default,,0,0,0,,Қарапайым айтқанда, бұл бір адамның магниттік күшінің екі есесі.
Dialogue: 0,0:33:57.54,0:33:58.75,Default,,0,0,0,,(Айдаһардың айқайы)
Dialogue: 0,0:34:00.29,0:34:05.58,Default,,0,0,0,,(Тыныс алу жалынының дыбысы)
Dialogue: 0,0:34:05.66,0:34:10.66,Default,,0,0,0,,♪～
Dialogue: 0,0:34:44.95,0:34:47.00,Default,,0,0,0,,Шыу!
Dialogue: 0,0:34:47.08,0:34:50.08,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:34:59.79,0:35:01.41,Default,,0,0,0,,Сізге тағы хат келді ме?
Dialogue: 0,0:35:01.50,0:35:03.20,Default,,0,0,0,,Әй, мен оны оқымаймын.
Dialogue: 0,0:35:03.83,0:35:05.95,Default,,0,0,0,,Сіз генералсыз.
Dialogue: 0,0:35:06.04,0:35:08.70,Default,,0,0,0,,Осы сияқты нәрселерге көп уақыт жұмсамаңыз...
Dialogue: 0,0:35:08.79,0:35:11.16,Default,,0,0,0,,Мен білемін, білемін
Dialogue: 0,0:35:11.25,0:35:12.91,Default,,0,0,0,,Бұл мені үнемі уайымдайтын нәрсе.
Dialogue: 0,0:35:13.00,0:35:14.20,Default,,0,0,0,,Өйткені мен оны жазуым керек.
Dialogue: 0,0:35:14.29,0:35:19.33,Default,,0,0,0,,Бір күні мен бұл жігіттерді түсіне алар ма екенмін?
Dialogue: 0,0:35:19.41,0:35:20.70,Default,,0,0,0,,Біріншісі – сараймен байланысты адамдардың сеніміне ие болу.
Dialogue: 0,0:35:22.54,0:35:24.91,Default,,0,0,0,,Сіз түсінуге мүмкіндік жоқ.
Dialogue: 0,0:35:35.33,0:35:36.95,Default,,0,0,0,,(сиқырлы белсендіру дыбысы)
Dialogue: 0,0:35:42.83,0:35:45.08,Default,,0,0,0,,Ол... қайда?
Dialogue: 0,0:35:54.41,0:35:56.79,Default,,0,0,0,,Ынтымағы жарасқан күштер әскері емес пе?
Dialogue: 0,0:35:58.70,0:36:01.00,Default,,0,0,0,,Қарсылас – Люминас
Dialogue: 0,0:36:01.08,0:36:03.08,Default,,0,0,0,,Мұндағы бас қолбасшы...
Dialogue: 0,0:36:04.45,0:36:07.70,Default,,0,0,0,,Кимун Камуидің қатыгездігі айқын.
Dialogue: 0,0:36:07.79,0:36:12.58,Default,,0,0,0,,Барлаушы болсам да, жүрегім ауырды.
Dialogue: 0,0:36:12.66,0:36:15.95,Default,,0,0,0,,Адамдарды тапсақ, оларды қорлап, өлтіреміз.
Dialogue: 0,0:36:16.04,0:36:21.00,Default,,0,0,0,,Табиғаты мол жер еш себепсіз тапталады, ластанады.
Dialogue: 0,0:36:21.08,0:36:22.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:36:23.04,0:36:28.45,Default,,0,0,0,,Біз өсек естіп, осы жерге келдік.
Dialogue: 0,0:36:28.54,0:36:30.70,Default,,0,0,0,,Асыққаныңыз жөн!
Dialogue: 0,0:36:30.79,0:36:34.95,Default,,0,0,0,,Айдаһар допты алған бойда біз сізге шабуыл жасаймыз.
Dialogue: 0,0:36:35.04,0:36:36.50,Default,,0,0,0,,Айдаһар добы?
Dialogue: 0,0:36:36.58,0:36:38.08,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:36:38.16,0:36:43.50,Default,,0,0,0,,Бәлкім, бұл болмай тұрып көшуіміз керек...
Dialogue: 0,0:36:43.58,0:36:45.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:36:45.79,0:36:47.25,Default,,0,0,0,,Хехе
Dialogue: 0,0:36:47.33,0:36:48.91,Default,,0,0,0,,Не...
Dialogue: 0,0:36:50.29,0:36:53.20,Default,,0,0,0,,Люминдер жақында шабуыл жасайды.
Dialogue: 0,0:36:53.29,0:36:57.79,Default,,0,0,0,,Біздің бұл қазіргі позициядан көшуге ниетіміз жоқ, солай ма?
Dialogue: 0,0:36:57.87,0:36:58.70,Default,,0,0,0,,Иә
Dialogue: 0,0:36:58.79,0:37:01.62,Default,,0,0,0,,Ұрысуға келсем, қайтпаймын.
Dialogue: 0,0:37:01.70,0:37:04.25,Default,,0,0,0,,Айдаһар шары дер кезінде келмесе де, мен шайқасамын.
Dialogue: 0,0:37:04.33,0:37:06.70,Default,,0,0,0,,Сіз оған сене алатын болсаңыз.
Dialogue: 0,0:37:06.79,0:37:10.37,Default,,0,0,0,,Мен сізге көмектесу үшін бар күшімді саламын.
Dialogue: 0,0:37:11.37,0:37:12.95,Default,,0,0,0,,Сіз жеңдіңіз!
Dialogue: 0,0:37:13.87,0:37:18.33,Default,,0,0,0,,Екі жаққа басып кіріп, төбелес тудыру...
Dialogue: 0,0:37:18.87,0:37:19.83,Default,,0,0,0,,Не...
Dialogue: 0,0:37:19.91,0:37:22.50,Default,,0,0,0,,Мен Торға тез айтуым керек.
Dialogue: 0,0:37:23.12,0:37:26.41,Default,,0,0,0,,Ал, өлшемді қақпаның орны...
Dialogue: 0,0:37:27.25,0:37:28.41,Default,,0,0,0,,болды
Dialogue: 0,0:37:29.91,0:37:31.00,Default,,0,0,0,,Не!
Dialogue: 0,0:37:31.08,0:37:35.25,Default,,0,0,0,,Басқа дүниенің қақпасын ашу үшін көп сиқырлы күш қолданылады...
Dialogue: 0,0:37:36.00,0:37:37.87,Default,,0,0,0,,Оны анықтау оңай болды.
Dialogue: 0,0:37:37.95,0:37:42.29,Default,,0,0,0,,Сізді иісшіл қаңғыбас ит жеңген сияқты, Ируру.
Dialogue: 0,0:37:42.37,0:37:44.50,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:37:44.58,0:37:48.41,Default,,0,0,0,,Мен бұл сөздердің соғысқа құмар айдаһардан шыққанына сене алар емеспін.
Dialogue: 0,0:37:48.50,0:37:52.50,Default,,0,0,0,,Әй, айдаһарлар төбелес іздеп жатырсыңдар.
Dialogue: 0,0:37:52.58,0:37:55.04,Default,,0,0,0,,Мен оны саған ғана беріп тұрмын.
Dialogue: 0,0:37:55.12,0:37:57.54,Default,,0,0,0,,Керісінше, олар мұны істеудің себептерін де ойлап тапты.
Dialogue: 0,0:37:57.62,0:37:59.83,Default,,0,0,0,,Мен сізге тек рахмет айтқым келеді.
Dialogue: 0,0:37:59.91,0:38:03.29,Default,,0,0,0,,«Неге бұлай етер едіңдер?»
Dialogue: 0,0:38:03.37,0:38:07.58,Default,,0,0,0,,Кукукуку…
Dialogue: 0,0:38:07.66,0:38:11.58,Default,,0,0,0,,Маған ұнады! Айдаһар азап шегеді!
Dialogue: 0,0:38:11.66,0:38:14.91,Default,,0,0,0,,Бөлініп, өліп кетсем жақсы болар еді!
Dialogue: 0,0:38:15.00,0:38:17.75,Default,,0,0,0,,Ол маған сондай өрескел түрде қарсы тұрады.
Dialogue: 0,0:38:17.83,0:38:19.79,Default,,0,0,0,,Оны сақтаудың жолы жоқ!
Dialogue: 0,0:38:19.87,0:38:21.91,Default,,0,0,0,,Өйткені басқа адам туралы ойланғым келмейді
Dialogue: 0,0:38:22.00,0:38:24.87,Default,,0,0,0,,Сіз оны өте жақсы басқара аласыз!
Dialogue: 0,0:38:25.95,0:38:29.29,Default,,0,0,0,,Ендеше, ауызымызды жапайық.
Dialogue: 0,0:38:29.87,0:38:31.04,Default,,0,0,0,,Ннн!
Dialogue: 0,0:38:32.29,0:38:34.08,Default,,0,0,0,,(қолдың пішінін өзгерту дыбысы)
Dialogue: 0,0:38:37.79,0:38:38.75,Default,,0,0,0,,Не!
Dialogue: 0,0:38:39.66,0:38:40.70,Default,,0,0,0,,Телепортация?
Dialogue: 0,0:38:41.37,0:38:45.54,Default,,0,0,0,,Бірақ сиқыршының айдаһарды ренжітуге күші жетпейді!
Dialogue: 0,0:38:45.62,0:38:48.12,Default,,0,0,0,,Ніл өзенінің батыс жағалауындағы қиын өткелі бар шатқалдың тереңінде —
Dialogue: 0,0:38:48.20,0:38:49.29,Default,,0,0,0,,оның шынымен білмегенінің дәлелі.
Dialogue: 0,0:38:49.37,0:38:51.70,Default,,0,0,0,,Айдаһардың жаман әдеті.
Dialogue: 0,0:38:51.79,0:38:53.29,Default,,0,0,0,,Мен болғандықтан
Dialogue: 0,0:38:53.37,0:38:57.16,Default,,0,0,0,,Қарсыласым тек өзінің шикі күшін пайдаланып, маған қарсы шығады деп сенемін.
Dialogue: 0,0:38:57.25,0:38:58.79,Default,,0,0,0,,Қасиетті қылыш?
Dialogue: 0,0:38:58.87,0:38:59.95,Default,,0,0,0,,Иә! Ннн!
Dialogue: 0,0:39:00.04,0:39:01.25,Default,,0,0,0,,Гах...
Dialogue: 0,0:39:02.75,0:39:04.54,Default,,0,0,0,,Ух... аа...
Dialogue: 0,0:39:05.75,0:39:06.95,Default,,0,0,0,,Фуфун
Dialogue: 0,0:39:07.04,0:39:09.87,Default,,0,0,0,,-Ах... -(Азар) Кепіннен жасалған.
Dialogue: 0,0:39:09.95,0:39:13.08,Default,,0,0,0,,Сіздің шабуылдарыңыз өтпейді.
Dialogue: 0,0:39:13.16,0:39:15.41,Default,,0,0,0,,Көріп отырғаныңыздай
Dialogue: 0,0:39:16.12,0:39:21.33,Default,,0,0,0,,Маған бәрі бір, сендерді өлтіру, бейбақтар!
Dialogue: 0,0:39:24.91,0:39:27.54,Default,,0,0,0,,Киелі қылыш пен киелі кепен...
Dialogue: 0,0:39:27.62,0:39:30.66,Default,,0,0,0,,Айдаһарды өлтіру үшін ғана қарсы әрекет жасайтын сиқыршылар бар.
Dialogue: 0,0:39:30.75,0:39:33.16,Default,,0,0,0,,Мен бұл туралы ешқашан естіген емеспін.
Dialogue: 0,0:39:34.58,0:39:35.66,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:39:40.45,0:39:41.87,Default,,0,0,0,,(Аспанды тырналаған дыбыс)
Dialogue: 0,0:39:45.45,0:39:46.41,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:39:47.54,0:39:48.45,Default,,0,0,0,,- Ха! - (Азард) Хмф!
Dialogue: 0,0:39:48.54,0:39:49.91,Default,,0,0,0,,Гах...
Dialogue: 0,0:39:52.45,0:39:53.58,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:40:01.54,0:40:05.54,Default,,0,0,0,,(Тыныс алу жалынының дыбысы)
Dialogue: 0,0:40:06.83,0:40:08.87,Default,,0,0,0,,Мен біраз жинадым.
Dialogue: 0,0:40:08.95,0:40:12.00,Default,,0,0,0,,Маған бұл әдіс ұнайды, бірақ...
Dialogue: 0,0:40:12.08,0:40:16.12,Default,,0,0,0,,Бұл Кимун Камуи құндылықтарын өзгерте ме?
Dialogue: 0,0:40:16.20,0:40:17.66,Default,,0,0,0,,-Мен үйдемін-(Тор) Ах...
Dialogue: 0,0:40:18.41,0:40:22.45,Default,,0,0,0,,Кеш болды, солай емес пе? Осы сағатқа дейін не істеп жатырсың...
Dialogue: 0,0:40:22.54,0:40:24.75,Default,,0,0,0,,Не болды?
Dialogue: 0,0:40:24.83,0:40:27.16,Default,,0,0,0,,А... Мен мысықпен тым көп ойнадым.
Dialogue: 0,0:40:27.25,0:40:29.91,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:40:30.62,0:40:34.20,Default,,0,0,0,,Сондықтан мен өмір үшін жүгірдім.
Dialogue: 0,0:40:34.29,0:40:36.20,Default,,0,0,0,,Терең тырнақтар
Dialogue: 0,0:40:36.29,0:40:39.54,Default,,0,0,0,,Сіз ол кісіні бұрыннан танисыз, солай емес пе?
Dialogue: 0,0:40:39.62,0:40:42.25,Default,,0,0,0,,Мен Азад деген есімді естідім.
Dialogue: 0,0:40:42.33,0:40:45.91,Default,,0,0,0,,Мен оған айтпас бұрын оның шынымен ол екеніне көз жеткізуді ойладым.
Dialogue: 0,0:40:46.00,0:40:47.25,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:40:48.29,0:40:51.95,Default,,0,0,0,,Ол бір рет мен болған топта болды.
Dialogue: 0,0:40:52.95,0:40:56.95,Default,,0,0,0,,Сонда да отар басшысы өз пікірін ұстанды.
Dialogue: 0,0:40:57.04,0:40:58.50,Default,,0,0,0,,Бұл аймақтағы таулар Мориё қаласынан солтүстік-батысқа қарай шамамен 80 шақырым жерде орналасқан.
Dialogue: 0,0:40:58.58,0:41:01.45,Default,,0,0,0,,Оның ойлары тым радикалды болды
Dialogue: 0,0:41:01.54,0:41:04.00,Default,,0,0,0,,Менің барлық серіктерім топтан шықты.
Dialogue: 0,0:41:04.08,0:41:08.20,Default,,0,0,0,,Бастықтың соңынан ерген айдаһарлар жараланған болуы керек.
Dialogue: 0,0:41:09.41,0:41:10.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:41:11.33,0:41:14.58,Default,,0,0,0,,Бір нәрсені қайталаған адамдарды көргенде
Dialogue: 0,0:41:14.66,0:41:17.87,Default,,0,0,0,,Сенің айдаһарға деген кекің көп сияқты.
Dialogue: 0,0:41:17.95,0:41:22.08,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, бұл екі жаққа да пайдасыз шайқас болады.
Dialogue: 0,0:41:22.16,0:41:25.75,Default,,0,0,0,,Мен Азардты өшіремін және ұрысты тоқтатамын.
Dialogue: 0,0:41:25.83,0:41:29.08,Default,,0,0,0,,Төбелес тудырғанына заттай дәлел жоқ.
Dialogue: 0,0:41:29.16,0:41:30.70,Default,,0,0,0,,Оны тоқтату мүмкін емес пе?
Dialogue: 0,0:41:30.79,0:41:36.37,Default,,0,0,0,,Рас, тек Ирурудың куәлігі сізді сендіру үшін жеткіліксіз болуы мүмкін.
Dialogue: 0,0:41:36.45,0:41:37.66,Default,,0,0,0,,- Эй - (Тор) Иә?
Dialogue: 0,0:41:37.75,0:41:41.37,Default,,0,0,0,,Ештеңе жасамау дұрыс па?
Dialogue: 0,0:41:41.45,0:41:42.79,Default,,0,0,0,,Е...
Dialogue: 0,0:41:42.87,0:41:45.20,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:41:45.29,0:41:46.79,Default,,0,0,0,,Хмм... Маған ұнамайды...
Dialogue: 0,0:41:46.87,0:41:51.79,Default,,0,0,0,,Ол дүниедегі шайқастардың бізге еш қатысы жоқ деп ойлаймын.
Dialogue: 0,0:41:52.37,0:41:55.87,Default,,0,0,0,,Соғысқысы келетін адамдар еркін күресіп, өмір сүріп, өлетін әлемде.
Dialogue: 0,0:41:55.95,0:41:58.50,Default,,0,0,0,,Мен Кобаяшиді тартқым келмейді
Dialogue: 0,0:41:59.75,0:42:01.00,Default,,0,0,0,,Ируру…
Dialogue: 0,0:42:01.08,0:42:04.91,Default,,0,0,0,,Каннаны осында қуып жіберген Кимун Камуи болды.
Dialogue: 0,0:42:05.00,0:42:09.83,Default,,0,0,0,,Олар сізге шайқас болды деп қайтып кел деп айтпайды.
Dialogue: 0,0:42:10.70,0:42:15.08,Default,,0,0,0,,Егер мен сізге айдаһар шарын берсем, бұл оқиға аяқталды дегенді білдіре ме?
Dialogue: 0,0:42:17.83,0:42:20.37,Default,,0,0,0,,То... Мен адамдарға сенбеймін!
Dialogue: 0,0:42:20.45,0:42:23.62,Default,,0,0,0,,Ол бірдеңе жоспарлап отыр! Мен оны қолдануға тырысамын!
Dialogue: 0,0:42:28.37,0:42:30.08,Default,,0,0,0,,Кешіріңіз, Ируру
Dialogue: 0,0:42:30.75,0:42:32.87,Default,,0,0,0,,Мен әлі де бірдеңе істегім келеді
Dialogue: 0,0:42:32.95,0:42:35.87,Default,,0,0,0,,Мен әлі не істей аламын деп ойлаймын...
Dialogue: 0,0:42:35.95,0:42:39.50,Default,,0,0,0,,Түсіндім... Қалай болғанда да.
Dialogue: 0,0:42:39.58,0:42:42.58,Default,,0,0,0,,Азад жігітінен кек аламын.
Dialogue: 0,0:42:42.66,0:42:43.54,Default,,0,0,0,,Хмм...
Dialogue: 0,0:42:43.62,0:42:45.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:42:45.08,0:42:47.12,Default,,0,0,0,,Тор? не болды?
Dialogue: 0,0:42:47.20,0:42:51.00,Default,,0,0,0,,А-а, жоқ... Ойлануға біраз уақыт болады деп ойлаймын.
Dialogue: 0,0:42:51.08,0:42:53.83,Default,,0,0,0,,Мен дүкенге барамын. Эххе...
Dialogue: 0,0:42:54.45,0:42:55.41,Default,,0,0,0,,Осы сағатта?
Dialogue: 0,0:42:55.50,0:42:57.91,Default,,0,0,0,,Мен сатып алуды ұмытып кеткен бір нәрсе бар...
Dialogue: 0,0:42:58.00,0:42:59.04,Default,,0,0,0,,Олай болса!
Dialogue: 0,0:42:59.12,0:43:00.37,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:43:00.45,0:43:02.70,Default,,0,0,0,,Бұл жаман емес пе...?
Dialogue: 0,0:43:02.79,0:43:06.25,Default,,0,0,0,,Кобаяши мырза өзін дайындауға тырысады.
Dialogue: 0,0:43:06.33,0:43:07.91,Default,,0,0,0,,Канна үшін—
Dialogue: 0,0:43:08.00,0:43:11.20,Default,,0,0,0,,Қанды шайқасқа секіруге дайын бол...
Dialogue: 0,0:43:11.91,0:43:16.12,Default,,0,0,0,,Мен Кобаяши мырзаның қазір бірдеңе істеп жатқанын білемін.
Dialogue: 0,0:43:16.87,0:43:21.25,Default,,0,0,0,,Сіздің денеңізге сиқырлы күшті сіңіре бастағаныңыз анық...
Dialogue: 0,0:43:21.87,0:43:26.04,Default,,0,0,0,,Бірақ бұл соншалықты тәтті емес шығар...
Dialogue: 0,0:43:28.12,0:43:33.04,Default,,0,0,0,,Мен Кобаяши мырзаны қорғай аламын ба...
Dialogue: 0,0:43:33.75,0:43:35.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:37.37,0:43:38.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:38.45,0:43:41.20,Default,,0,0,0,,Біреу қатты уайымдаса!
Dialogue: 0,0:43:41.29,0:43:43.91,Default,,0,0,0,,Сіз өте қарапайымсыз, Фафнир мырза!
Dialogue: 0,0:43:44.00,0:43:45.41,Default,,0,0,0,,Не айту керек
Dialogue: 0,0:43:45.50,0:43:47.87,Default,,0,0,0,,Мен ұзақ шайқасқа кірейін деп жатырмын.
Dialogue: 0,0:43:48.66,0:43:50.75,Default,,0,0,0,,Рейд бастығы өлімге әкелетін шайқас болады.
Dialogue: 0,0:43:50.83,0:43:53.66,Default,,0,0,0,,Бұл Такитанидің босап шығуы үшін отын.
Dialogue: 0,0:43:53.75,0:43:56.79,Default,,0,0,0,,Біз бәрібір ойындар туралы айтып отырмыз, солай ма?
Dialogue: 0,0:43:56.87,0:43:59.29,Default,,0,0,0,,Уайымдап тұрсыз ба...?
Dialogue: 0,0:44:00.04,0:44:03.95,Default,,0,0,0,,Хмф... Сіз әрқашан оңай уайымдайтын адамсыз.
Dialogue: 0,0:44:04.04,0:44:07.12,Default,,0,0,0,,Мен сенің бұлай айтқаныңды қаламаймын.
Dialogue: 0,0:44:08.29,0:44:10.70,Default,,0,0,0,,Хмм... Солай деп ойлаймын.
Dialogue: 0,0:44:10.79,0:44:13.54,Default,,0,0,0,,Мүмкін екеуміз де жеткілікті жаттығу жасамаймыз.
Dialogue: 0,0:44:13.62,0:44:14.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:15.58,0:44:17.95,Default,,0,0,0,,Денеңізді анда-санда қозғалтасыз ба?
Dialogue: 0,0:44:18.04,0:44:19.37,Default,,0,0,0,,(буын дыбысы)
Dialogue: 0,0:44:19.95,0:44:21.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:44:30.16,0:44:33.95,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,0:44:34.04,0:44:35.50,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:44:43.50,0:44:44.62,Default,,0,0,0,,Төзе бер, шыдай бер!
Dialogue: 0,0:44:44.70,0:44:46.87,Default,,0,0,0,,Жалпы жағдайды түсінемін.
Dialogue: 0,0:44:47.79,0:44:48.70,Default,,0,0,0,,Гррр…
Dialogue: 0,0:44:51.29,0:44:53.79,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:44:54.54,0:44:56.04,Default,,0,0,0,,Менің ойымша...
Dialogue: 0,0:44:57.04,0:44:58.50,Default,,0,0,0,,Сізді не уайымдады?
Dialogue: 0,0:44:59.12,0:45:03.04,Default,,0,0,0,,Кобаяши өз еркімен күреске басын салады.
Dialogue: 0,0:45:04.12,0:45:05.37,Default,,0,0,0,,Мен өлгенде
Dialogue: 0,0:45:05.45,0:45:09.79,Default,,0,0,0,,Себебі ол орынсыз күшпен отқа секірді.
Dialogue: 0,0:45:09.87,0:45:12.00,Default,,0,0,0,,Тіпті берекелі болмайтын нәрселерді айтпа!
Dialogue: 0,0:45:14.12,0:45:15.58,Default,,0,0,0,,Әлі жоқ.
Dialogue: 0,0:45:16.12,0:45:19.12,Default,,0,0,0,,Адамдар мұндай арандатушылық деңгейінде жақсы болар еді.
Dialogue: 0,0:45:19.20,0:45:20.04,Default,,0,0,0,,А...
Dialogue: 0,0:45:20.70,0:45:22.70,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,0:45:24.12,0:45:25.75,Default,,0,0,0,,Өкінішті...
Dialogue: 0,0:45:25.83,0:45:27.95,Default,,0,0,0,,Егер сіз бұрын болған болсаңыз
Dialogue: 0,0:45:28.04,0:45:32.70,Default,,0,0,0,,Мен уайымдасам да, мен әлдеқайда ауқымды нәрсеге алаңдадым.
Dialogue: 0,0:45:33.25,0:45:38.12,Default,,0,0,0,,Мен құдайлардың барлық әскерлерін қалай жоя аламын... т.б.
Dialogue: 0,0:45:38.20,0:45:41.54,Default,,0,0,0,,Тор, сен тым көп адамдарды білесің.
Dialogue: 0,0:45:41.62,0:45:44.75,Default,,0,0,0,,Адамдардың стандарттарына негізделген нәрселер туралы ойламайсыз ба?
Dialogue: 0,0:45:44.83,0:45:46.91,Default,,0,0,0,,Сіз нені айтасыз!
Dialogue: 0,0:45:49.79,0:45:51.70,Default,,0,0,0,,Ха! Ннн...
Dialogue: 0,0:45:51.79,0:45:53.79,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:45:56.45,0:45:58.70,Default,,0,0,0,,Сіз не істей аласыз?
Dialogue: 0,0:45:59.83,0:46:01.54,Default,,0,0,0,,Бұл шайқас
Dialogue: 0,0:46:02.41,0:46:05.29,Default,,0,0,0,,Сіз күшті айдаһар болғандықтан жасай алатын нәрселер бар.
Dialogue: 0,0:46:02.41,0:46:05.29,Default,,0,0,0,,(Тордың жөтелі)
Dialogue: 0,0:46:05.29,0:46:06.37,Default,,0,0,0,,(Тордың жөтелі)
Dialogue: 0,0:46:06.45,0:46:10.87,Default,,0,0,0,,Барынша күшті болуға тырысып, күшіңізді пайдалану керек.
Dialogue: 0,0:46:11.54,0:46:13.62,Default,,0,0,0,,Мен мұны білемін
Dialogue: 0,0:46:13.70,0:46:19.62,Default,,0,0,0,,Дегенмен, мен Кобаяши-санды бар күшіммен қорғай алмаған шығармын деп ойлаймын...
Dialogue: 0,0:46:19.70,0:46:20.62,Default,,0,0,0,,Түсінбеген
Dialogue: 0,0:46:20.70,0:46:22.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:22.20,0:46:25.95,Default,,0,0,0,,Менімен кездесіп, бірінші болып маған шабуыл жасағанда.
Dialogue: 0,0:46:26.04,0:46:29.33,Default,,0,0,0,,Мен Кецалькоатльмен жекпе-жек таңдаған кезде
Dialogue: 0,0:46:29.41,0:46:33.45,Default,,0,0,0,,Ал құдайлар әскеріне жалғыз сүңгіп кеткенде
Dialogue: 0,0:46:34.54,0:46:39.58,Default,,0,0,0,,Неге екенін білмеймін, бірақ сен ол кездегіден әлдеқайда күштісің.
Dialogue: 0,0:46:40.54,0:46:43.95,Default,,0,0,0,,Қорғайтын қазынаны тапқан адамның күші.
Dialogue: 0,0:46:44.04,0:46:47.41,Default,,0,0,0,,Азардты өлтір! Қақтығысқа не болды?
Dialogue: 0,0:46:47.50,0:46:50.00,Default,,0,0,0,,Кимун Камуи мен Люминдерді өлтіріңіз!
Dialogue: 0,0:46:50.08,0:46:53.04,Default,,0,0,0,,Екі күшті де өлтіріңіз!
Dialogue: 0,0:46:53.12,0:46:55.62,Default,,0,0,0,,Кобаяшиді қорғау - бұл жай ғана ой.
Dialogue: 0,0:46:55.70,0:46:57.45,Default,,0,0,0,,Егер уайымдауға уақытыңыз болса
Dialogue: 0,0:46:57.54,0:47:00.91,Default,,0,0,0,,Сіздің міндетіңіз - өз қабілеттеріңізді шыңдау.
Dialogue: 0,0:47:02.45,0:47:06.87,Default,,0,0,0,,Адамдармен бірге өмір сүргеніңізге өкінбейсіз, солай ма?
Dialogue: 0,0:47:06.95,0:47:08.70,Default,,0,0,0,,Фафнир мырза...
Dialogue: 0,0:47:12.04,0:47:13.87,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:47:14.62,0:47:16.54,Default,,0,0,0,,Ең алдымен!
Dialogue: 0,0:47:16.62,0:47:18.95,Default,,0,0,0,,Мен сені өлтіремін!
Dialogue: 0,0:47:19.04,0:47:20.20,Default,,0,0,0,,Байқап көріңіз!
Dialogue: 0,0:47:20.29,0:47:27.16,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:47:27.25,0:47:28.66,Default,,0,0,0,,Бұл...
Dialogue: 0,0:47:28.75,0:47:32.75,Default,,0,0,0,,Мен Фафнир мырзаға алғаш рет кір салғандай болдым.
Dialogue: 0,0:47:33.91,0:47:37.58,Default,,0,0,0,,Ал... Хана менің не істейтінімді шешіп қойған ба?
Dialogue: 0,0:47:38.37,0:47:41.04,Default,,0,0,0,,Мен ол жаққа шығу үшін бәрін жасаймын!
Dialogue: 0,0:47:41.12,0:47:43.50,Default,,0,0,0,,Мен жаңа ғана оралдым~
Dialogue: 0,0:47:43.58,0:47:47.25,Default,,0,0,0,,Мен Фафнир мырзамен аздап сөйлестім... Иә?
Dialogue: 0,0:47:48.87,0:47:49.75,Default,,0,0,0,,(Хироко) Һм? О…
Dialogue: 0,0:47:50.41,0:47:51.50,Default,,0,0,0,,Канна-чан...
Dialogue: 0,0:47:52.45,0:47:53.87,Default,,0,0,0,,Жоқ
Dialogue: 0,0:47:55.75,0:47:57.75,Default,,0,0,0,,Менің жүгім жоқ.
Dialogue: 0,0:47:58.20,0:48:00.04,Default,,0,0,0,,Хат қалды
Dialogue: 0,0:48:02.66,0:48:03.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:03.91,0:48:07.54,Default,,0,0,0,,Канна, сен қайтасың ба?
Dialogue: 0,0:48:09.83,0:48:12.83,Default,,0,0,0,,Маған сенен керегі сол
Dialogue: 0,0:48:12.91,0:48:16.95,Default,,0,0,0,,Қазір де, бұрын да біз дос ретінде бірге күресуіміз керек.
Dialogue: 0,0:48:17.04,0:48:19.45,Default,,0,0,0,,Сондай-ақ айдаһар шары
Dialogue: 0,0:48:19.54,0:48:23.45,Default,,0,0,0,,Бұл алдағы шайқасқа қажет болды.
Dialogue: 0,0:48:24.04,0:48:27.54,Default,,0,0,0,,Мен сенің ол жерден қуат алып жатқаныңа сене алмаймын.
Dialogue: 0,0:48:27.62,0:48:29.29,Default,,0,0,0,,Мен күте алмаймын
Dialogue: 0,0:48:30.54,0:48:32.87,Default,,0,0,0,,Мен сенің осында келіп, істегеніңді қалаймын.
Dialogue: 0,0:48:33.62,0:48:35.25,Default,,0,0,0,,Мен өтірік айта алмаймын
Dialogue: 0,0:48:35.33,0:48:39.12,Default,,0,0,0,,Мен саған адал боламын, сенде маған не бар
Dialogue: 0,0:48:39.20,0:48:41.75,Default,,0,0,0,,Мен әлі де түсінбеймін
Dialogue: 0,0:48:41.83,0:48:45.45,Default,,0,0,0,,Бірақ қайтып келсеңіз
Dialogue: 0,0:48:45.54,0:48:50.37,Default,,0,0,0,,Ата-ана мен бала арасындағы сүйіспеншіліктің маңыздылығын да ескеру керек деп ойлаймын.
Dialogue: 0,0:48:51.87,0:48:56.45,Default,,0,0,0,,Өлшемді қақпаны тұрғызып, сол жерден орал.
Dialogue: 0,0:48:57.00,0:48:58.95,Default,,0,0,0,,Мен күтемін, Канна.
Dialogue: 0,0:48:59.58,0:49:01.70,Default,,0,0,0,,Оны айтудың өзі қандай күлкілі!
Dialogue: 0,0:49:01.79,0:49:04.04,Default,,0,0,0,,Канна жазған жазба да болды.
Dialogue: 0,0:49:06.91,0:49:07.75,Default,,0,0,0,,Таңертең ерте тұрып-ақ қазірден-ақ қажырлы еңбек етіп жатырсың ғой.
Dialogue: 0,0:49:08.62,0:49:12.33,Default,,0,0,0,,Айдаһар шары болса, әкелер жеңеді.
Dialogue: 0,0:49:12.41,0:49:14.54,Default,,0,0,0,,Мен де көмектесемін
Dialogue: 0,0:49:14.62,0:49:15.75,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:49:17.16,0:49:18.95,Default,,0,0,0,,Сонда, әрине...
Dialogue: 0,0:49:19.79,0:49:26.58,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:49:38.20,0:49:40.95,Default,,0,0,0,,Біз енді ешқашан кездесе алмауымыз мүмкін.
Dialogue: 0,0:49:41.95,0:49:43.25,Default,,0,0,0,,Бірақ...!
Dialogue: 0,0:49:45.83,0:49:47.00,Default,,0,0,0,,О.
Dialogue: 0,0:49:47.08,0:49:48.58,Default,,0,0,0,,Канна мырза
Dialogue: 0,0:49:48.66,0:49:51.70,Default,,0,0,0,,Мен жай ғана көңіл көтеру үшін шығуды ойладым.
Dialogue: 0,0:49:52.66,0:49:55.33,Default,,0,0,0,,Не болды? Тыныш
Dialogue: 0,0:49:57.62,0:49:59.33,Default,,0,0,0,,Сайкава кешіріңіз
Dialogue: 0,0:49:59.41,0:50:00.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:01.83,0:50:03.29,Default,,0,0,0,,Мен...
Dialogue: 0,0:50:03.37,0:50:05.20,Default,,0,0,0,,осы жерден жоғалады
Dialogue: 0,0:50:07.91,0:50:08.83,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:50:09.62,0:50:11.41,Default,,0,0,0,,Мен сенімен бірге болғым келді...
Dialogue: 0,0:50:11.50,0:50:13.08,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:50:13.16,0:50:16.16,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:50:16.25,0:50:17.87,Default,,0,0,0,,Бұл жақсы емес...
Dialogue: 0,0:50:17.95,0:50:20.83,Default,,0,0,0,,Канна сиқырдың белгілерін жасырады
Dialogue: 0,0:50:20.91,0:50:24.33,Default,,0,0,0,,Өлшемдік қақпаның сиқырының іздері тым сирек.
Dialogue: 0,0:50:24.41,0:50:27.70,Default,,0,0,0,,Каннаның сезу қабілеті жоғары болмаса, сіз оған жете алмайсыз.
Dialogue: 0,0:50:32.58,0:50:35.25,Default,,0,0,0,,(Су тамшылары құлаған дыбыс)
Dialogue: 0,0:50:39.58,0:50:41.08,Default,,0,0,0,,Мен Канна-чанды қуамын!
Dialogue: 0,0:50:42.04,0:50:42.91,Default,,0,0,0,,Бұл...
Dialogue: 0,0:50:43.00,0:50:45.91,Default,,0,0,0,,Біздің әлемге барамыз деп тұрсыз ба?
Dialogue: 0,0:50:46.00,0:50:49.04,Default,,0,0,0,,Бұл өте қауіпті. Мен сіздің өміріңізге кепілдік бере алмаймын.
Dialogue: 0,0:50:49.12,0:50:51.08,Default,,0,0,0,,Біз жалғыз барамыз
Dialogue: 0,0:50:51.16,0:50:54.37,Default,,0,0,0,,Сіздің жараңыз жазылмады.
Dialogue: 0,0:50:54.45,0:50:55.87,Default,,0,0,0,,Мені үйде қалдырыңызшы.
Dialogue: 0,0:50:55.95,0:50:56.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:56.91,0:50:59.70,Default,,0,0,0,,Менің екі адамды қорғауға шамам жетпейді.
Dialogue: 0,0:50:59.79,0:51:01.08,Default,,0,0,0,,Хмм…
Dialogue: 0,0:51:01.87,0:51:02.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:04.91,0:51:06.08,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:51:06.62,0:51:09.79,Default,,0,0,0,,Мына үй... оны қорға
Dialogue: 0,0:51:09.87,0:51:11.33,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:51:12.16,0:51:14.91,Default,,0,0,0,,Сол қарияны тағы кездестірдім.
Dialogue: 0,0:51:15.00,0:51:17.08,Default,,0,0,0,,Менің ойымша, біз сөйлесуіміз керек.
Dialogue: 0,0:51:17.16,0:51:18.20,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:51:18.91,0:51:21.45,Default,,0,0,0,,Мен бұл Торға жүк болатынын білемін.
Dialogue: 0,0:51:22.08,0:51:24.16,Default,,0,0,0,,Егер ол жұмыс істемесе, анық айтыңыз
Dialogue: 0,0:51:24.25,0:51:26.12,Default,,0,0,0,,Үйде Ирурумен бірге бол
Dialogue: 0,0:51:35.33,0:51:37.37,Default,,0,0,0,,Маған сенесің бе?
Dialogue: 0,0:51:37.45,0:51:39.58,Default,,0,0,0,,Жарайды, тағы біреуін сатып аламыз ба?
Dialogue: 0,0:51:41.54,0:51:43.29,Default,,0,0,0,,Мен өз өмірімді қатерге тігемін
Dialogue: 0,0:51:45.95,0:51:50.75,Default,,0,0,0,,(түрлендіру дыбысы)
Dialogue: 0,0:51:58.33,0:52:00.41,Default,,0,0,0,,Онда мен барамын
Dialogue: 0,0:52:00.50,0:52:02.66,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:52:04.29,0:52:09.66,Default,,0,0,0,,Бұл «ауыр күнә» деген не?
Dialogue: 0,0:52:26.33,0:52:28.62,Default,,0,0,0,,- (Тор) Кобаяши мырза - (Кобаяши) Иә?
Dialogue: 0,0:52:28.70,0:52:33.45,Default,,0,0,0,,Осы уақытқа дейін ұрысу себебім тек өзіме қатысты болды...
Dialogue: 0,0:52:34.04,0:52:37.41,Default,,0,0,0,,Мұндай адам үшін күресу керемет!
Dialogue: 0,0:52:37.50,0:52:39.54,Default,,0,0,0,,Бұл жосықсыз.
Dialogue: 0,0:52:39.62,0:52:43.20,Default,,0,0,0,,Кобаяши мырзаның таңғажайып құпия қаруы бар.
Dialogue: 0,0:52:43.29,0:52:45.95,Default,,0,0,0,,Сіз Кимун Камуиді бір соққымен жеңе аласыз, солай ма?
Dialogue: 0,0:52:46.04,0:52:49.29,Default,,0,0,0,,- (Кобаяши) Бұл рас болуы мүмкін емес - (Тор) Иә?
Dialogue: 0,0:52:49.37,0:52:51.16,Default,,0,0,0,,Иә.
Dialogue: 0,0:52:51.25,0:52:53.29,Default,,0,0,0,,Тор әлеміне алғаш рет бару...
Dialogue: 0,0:52:54.08,0:52:57.54,Default,,0,0,0,,Мені ақыл да, заң да қорғамайды.
Dialogue: 0,0:52:59.00,0:53:02.83,Default,,0,0,0,,Мен үшін тым қорқынышты, сүйкімді қыз...
Dialogue: 0,0:53:02.91,0:53:05.54,Default,,0,0,0,,Кеттік, Кобаяши-сан!
Dialogue: 0,0:53:08.58,0:53:13.08,Default,,0,0,0,,Егер мені қорғайтын Тор болса...
Dialogue: 0,0:53:16.16,0:53:17.54,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:53:18.50,0:53:19.58,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:53:25.37,0:53:29.66,Default,,0,0,0,,Қақпаның реакциясы Қайтыс болған императордың қызы...
Dialogue: 0,0:53:29.75,0:53:33.33,Default,,0,0,0,,О, тіпті Кобаяши деген адам.
Dialogue: 0,0:53:34.91,0:53:37.83,Default,,0,0,0,,Мен бұл жерде сиқырлы күштің ағынын түсінемін.
Dialogue: 0,0:53:37.91,0:53:40.33,Default,,0,0,0,,Қазір келсең қиын болар еді.
Dialogue: 0,0:53:40.41,0:53:41.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:43.12,0:53:44.75,Default,,0,0,0,,Ой...
Dialogue: 0,0:53:44.83,0:53:47.75,Default,,0,0,0,,Кобаяши мырза, мықтап ұстаңыз!
Dialogue: 0,0:53:48.33,0:53:52.54,Default,,0,0,0,,- (Кобаяши) Уау! -(Тор) Кобаяши мырза!
Dialogue: 0,0:53:53.75,0:53:57.70,Default,,0,0,0,,Ол жеңілді! Мені мүлдем басқа жерге апарды!
Dialogue: 0,0:53:58.95,0:54:01.08,Default,,0,0,0,,Кобаяши мырза...
Dialogue: 0,0:54:01.16,0:54:04.00,Default,,0,0,0,,Иә? Балалар сендер қандайсыңдар!
Dialogue: 0,0:54:04.58,0:54:06.66,Default,,0,0,0,,Ол қайтыс болған императордың қызы емес пе?
Dialogue: 0,0:54:06.75,0:54:08.62,Default,,0,0,0,,Енді жарысатын кез келді!
Dialogue: 0,0:54:09.25,0:54:11.91,Default,,0,0,0,,Менің сендермен айналысатын уақытым жоқ!
Dialogue: 0,0:54:12.00,0:54:14.66,Default,,0,0,0,,Мен саған Кимун Камуи-саманың жолына түсуге жол бермеймін!
Dialogue: 0,0:54:14.75,0:54:17.62,Default,,0,0,0,,Айдаһардың мұндай тұзақ салуы мүмкін емес.
Dialogue: 0,0:54:18.41,0:54:19.95,Default,,0,0,0,,Ол...
Dialogue: 0,0:54:21.00,0:54:26.50,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,0:54:27.70,0:54:29.45,Default,,0,0,0,,-Мен сені қуамын! -Хё~!
Dialogue: 0,0:54:29.54,0:54:30.83,Default,,0,0,0,,Иә!
Dialogue: 0,0:54:32.16,0:54:33.54,Default,,0,0,0,,Бұл жігіт жылдам!
Dialogue: 0,0:54:33.62,0:54:35.75,Default,,0,0,0,,Менің қашып кетуіме жол берме!
Dialogue: 0,0:54:37.87,0:54:41.45,Default,,0,0,0,,(Жалын сәулесінің ату дыбысы)
Dialogue: 0,0:55:07.50,0:55:11.79,Default,,0,0,0,,Сен сондай табандысың... Басқа амалым жоқ. Менімен айналысқыңыз келе ме?
Dialogue: 0,0:55:17.95,0:55:18.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:55:19.83,0:55:21.70,Default,,0,0,0,,Ол бұлттан атып шықты!
Dialogue: 0,0:55:22.29,0:55:23.33,Default,,0,0,0,,Ақымақ болуды доғар!
Dialogue: 0,0:55:23.41,0:55:25.54,Default,,0,0,0,,Сіздің орналасқан жеріңіз анықталады!
Dialogue: 0,0:55:25.62,0:55:27.08,Default,,0,0,0,,Кя!
Dialogue: 0,0:55:27.16,0:55:28.66,Default,,0,0,0,,Төбе де зақымдалған!
Dialogue: 0,0:55:28.75,0:55:30.50,Default,,0,0,0,,А, жайылып кет!
Dialogue: 0,0:55:30.58,0:55:32.41,Default,,0,0,0,,-Сіз төмендесіз! -Түсінікті!
Dialogue: 0,0:55:32.50,0:55:34.20,Default,,0,0,0,,Сіз жоғарыдасыз!
Dialogue: 0,0:55:35.16,0:55:37.29,Default,,0,0,0,,(өлшемді қақпаның ашылу дыбысы)
Dialogue: 0,0:55:37.91,0:55:42.37,Default,,0,0,0,,Уау!
Dialogue: 0,0:55:42.45,0:55:44.41,Default,,0,0,0,,Уау! Уф!
Dialogue: 0,0:55:44.50,0:55:45.91,Default,,0,0,0,,Уф... Эй!
Dialogue: 0,0:55:46.58,0:55:47.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:55:47.66,0:55:49.62,Default,,0,0,0,,Ахх! Уф...
Dialogue: 0,0:55:49.70,0:55:50.54,Default,,0,0,0,,♬~
Dialogue: 0,0:55:50.62,0:55:53.25,Default,,0,0,0,,Айтыңызшы...
Dialogue: 0,0:55:54.70,0:55:55.79,Default,,0,0,0,,Тірі!
Dialogue: 0,0:55:58.25,0:56:01.62,Default,,0,0,0,,Тор қайда? Канна Чан ше?
Dialogue: 0,0:56:02.70,0:56:04.25,Default,,0,0,0,,Иә, смартфон!
Dialogue: 0,0:56:04.33,0:56:06.58,Default,,0,0,0,,(Құбыжық құстың айқайы)
Dialogue: 0,0:56:06.66,0:56:07.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:08.50,0:56:11.33,Default,,0,0,0,,Ах! Менің смартфоным!
Dialogue: 0,0:56:12.04,0:56:14.87,Default,,0,0,0,,Қалжыңдауды доғар! Баккааро!
Dialogue: 0,0:56:16.04,0:56:19.00,Default,,0,0,0,,Иә yahoo!
Dialogue: 0,0:56:19.08,0:56:20.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:56:20.95,0:56:24.00,Default,,0,0,0,,Сен қайда бардың? Хехе
Dialogue: 0,0:56:24.08,0:56:26.08,Default,,0,0,0,,Хмм? Ах!
Dialogue: 0,0:56:26.16,0:56:28.08,Default,,0,0,0,,Арх... мына жігіт!
Dialogue: 0,0:56:28.16,0:56:29.66,Default,,0,0,0,,Не... не істеп жатырсың...
Dialogue: 0,0:56:29.75,0:56:30.91,Default,,0,0,0,,(Польнарефф) Ә? Бұл не? Бұл жабысқақ не?
Dialogue: 0,0:56:31.00,0:56:32.58,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:56:33.33,0:56:34.58,Default,,0,0,0,,Асахи...
Dialogue: 0,0:56:36.16,0:56:37.70,Default,,0,0,0,,Самеда да жеңілді
Dialogue: 0,0:56:37.79,0:56:40.37,Default,,0,0,0,,Бұлттардың арасынан өтіп бара жатырмын, қайда бардың...
Dialogue: 0,0:56:40.45,0:56:41.91,Default,,0,0,0,,Гуааа...
Dialogue: 0,0:56:42.00,0:56:45.37,Default,,0,0,0,,Уау! Бұл өте күлкілі!
Dialogue: 0,0:56:45.45,0:56:47.29,Default,,0,0,0,,Қайдан атқалы жатырсың?
Dialogue: 0,0:56:49.75,0:56:50.66,Default,,0,0,0,,Хмм?
Dialogue: 0,0:56:52.75,0:56:54.91,Default,,0,0,0,,Күнде?
Dialogue: 0,0:56:56.45,0:56:58.58,Default,,0,0,0,,(Зарядтау дыбысы және ату дыбысы)
Dialogue: 0,0:56:58.66,0:57:01.29,Default,,0,0,0,,(Жылдам дыбыс)
Dialogue: 0,0:57:06.08,0:57:08.12,Default,,0,0,0,,Бұл жігіт...!
Dialogue: 0,0:57:10.37,0:57:12.54,Default,,0,0,0,,Ахх...
Dialogue: 0,0:57:12.62,0:57:15.79,Default,,0,0,0,,Мен Кобаяши мырзаға тез баруым керек!
Dialogue: 0,0:57:16.62,0:57:19.25,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:57:19.83,0:57:22.16,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:57:22.75,0:57:24.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:57:25.50,0:57:26.70,Default,,0,0,0,,♬~
Dialogue: 0,0:57:26.79,0:57:28.75,Default,,0,0,0,,Уау!
Dialogue: 0,0:57:28.75,0:57:29.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:57:28.75,0:57:29.25,Default,,0,0,0,,(Жыртқыш өсімдіктер өседі)
Dialogue: 0,0:57:29.25,0:57:29.33,Default,,0,0,0,,(Жыртқыш өсімдіктер өседі)
Dialogue: 0,0:57:29.33,0:57:32.70,Default,,0,0,0,,(Жыртқыш өсімдіктер өседі)
Dialogue: 0,0:57:29.33,0:57:32.70,Default,,0,0,0,,Эй, эй... Жегің келе ме?
Dialogue: 0,0:57:32.79,0:57:36.87,Default,,0,0,0,,Әй, бұл өтірік, солай ма? Тоқта, тоқта! Тоқта! Ах...
Dialogue: 0,0:57:38.00,0:57:40.66,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:57:40.75,0:57:44.62,Default,,0,0,0,,Мен... Дәмі жоқ деп ойлаймын! Тоқта! Тоқта!
Dialogue: 0,0:57:45.37,0:57:46.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:57:46.66,0:57:47.70,Default,,0,0,0,,♬~
Dialogue: 0,0:57:48.79,0:57:49.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:51.29,0:57:53.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:57:53.29,0:57:55.75,Default,,0,0,0,,Өл! Өл, өл! Мен өлемін! Уф...
Dialogue: 0,0:57:55.83,0:57:58.62,Default,,0,0,0,,Кобаяши мырза! Өтінемін, маған жазылыңыз!
Dialogue: 0,0:57:58.70,0:58:00.54,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:58:00.62,0:58:02.33,Default,,0,0,0,,Бұл туралы кейінірек айтамыз!
Dialogue: 0,0:58:02.41,0:58:06.37,Default,,0,0,0,,(Кобаяшидің ауыр тыныс алуы)
Dialogue: 0,0:58:08.41,0:58:09.87,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:58:09.95,0:58:11.00,Default,,0,0,0,,♬~
Dialogue: 0,0:58:16.95,0:58:19.54,Default,,0,0,0,,Сіз мұнда қауіпсізсіз.
Dialogue: 0,0:58:19.62,0:58:21.70,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:58:21.79,0:58:24.08,Default,,0,0,0,,Сіз Кобаяши мырзасыз, солай ма?
Dialogue: 0,0:58:24.16,0:58:26.66,Default,,0,0,0,,Менің атымды қайдан білесің?
Dialogue: 0,0:58:26.75,0:58:27.91,Default,,0,0,0,,Мен—
Dialogue: 0,0:58:28.00,0:58:31.37,Default,,0,0,0,,Канна мырзаға көмегіңіз үшін көп рахмет.
Dialogue: 0,0:58:31.45,0:58:34.41,Default,,0,0,0,,Ах! Сен сол қариясың!
Dialogue: 0,0:58:34.50,0:58:37.25,Default,,0,0,0,,Сол бөлімде маған әкем көмектесті.
Dialogue: 0,0:58:37.33,0:58:39.29,Default,,0,0,0,,Бұл менің қызым
Dialogue: 0,0:58:39.37,0:58:41.20,Default,,0,0,0,,Қайырлы күн!
Dialogue: 0,0:58:41.29,0:58:42.70,Default,,0,0,0,,О, сәлем...
Dialogue: 0,0:58:43.75,0:58:46.62,Default,,0,0,0,,Сәлем, бұл Кобаяши-сандікі, солай ма?
Dialogue: 0,0:58:46.70,0:58:48.25,Default,,0,0,0,,Мен оны қайтардым.
Dialogue: 0,0:58:48.33,0:58:50.58,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:58:52.33,0:58:55.08,Default,,0,0,0,,Бұл «ауыр күнә» деген не?
Dialogue: 0,0:58:57.62,0:59:02.41,Default,,0,0,0,,(түрлендіру дыбысы)
Dialogue: 0,0:59:13.70,0:59:15.54,Default,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:59:15.62,0:59:19.70,Default,,0,0,0,,Өзіңіз алып келеді деп ойламадым.
Dialogue: 0,0:59:21.04,0:59:22.62,Default,,0,0,0,,Әкем…
Dialogue: 0,0:59:23.25,0:59:26.12,Default,,0,0,0,,Сол хат мені қуантты...
Dialogue: 0,0:59:26.20,0:59:29.62,Default,,0,0,0,,Хмм? Сіз тек алкоголь туралы жазасыз ба?
Dialogue: 0,0:59:37.83,0:59:39.62,Default,,0,0,0,,Айдаһар шары...
Dialogue: 0,0:59:39.70,0:59:42.12,Default,,0,0,0,,Бірнеше сағатта аяқталады
Dialogue: 0,0:59:42.70,0:59:46.37,Default,,0,0,0,,Жақын арада шайқас басталады. Асығыңыз!
Dialogue: 0,0:59:47.29,0:59:49.41,Default,,0,0,0,,Зейініңізді шоғырландыра алатын бөлме дайындаңыз...
Dialogue: 0,0:59:49.50,0:59:50.62,Default,,0,0,0,,Әкем
Dialogue: 0,0:59:51.29,0:59:53.62,Default,,0,0,0,,Мен қайтып келгенде...
Dialogue: 0,0:59:53.70,0:59:54.62,Default,,0,0,0,,Сіз бақыттысыз ба?
Dialogue: 0,0:59:55.66,0:59:59.62,Default,,0,0,0,,А, мен өте қуаныштымын! күшке айналасың
Dialogue: 0,0:59:59.70,1:00:02.04,Default,,0,0,0,,Бірге күресейік!
Dialogue: 0,1:00:17.75,1:00:19.95,Default,,0,0,0,,Бұл жай ғана доп
Dialogue: 0,1:00:20.54,1:00:22.75,Default,,0,0,0,,Бұл теңгерімсіз, сондықтан оны ұстаңыз.
Dialogue: 0,1:00:25.54,1:00:26.45,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,1:00:29.75,1:00:32.58,Default,,0,0,0,,Канна мырза осы шайқаста.
Dialogue: 0,1:00:29.75,1:00:32.58,Default,,0,0,0,,Хи хи...
Dialogue: 0,1:00:32.58,1:00:32.66,Default,,0,0,0,,Хи хи...
Dialogue: 0,1:00:32.66,1:00:33.75,Default,,0,0,0,,Хи хи...
Dialogue: 0,1:00:32.66,1:00:33.75,Default,,0,0,0,,Ұсталып қала жаздағанымды естігенде қатты уайымдадым!
Dialogue: 0,1:00:33.75,1:00:36.33,Default,,0,0,0,,Ұсталып қала жаздағанымды естігенде қатты уайымдадым!
Dialogue: 0,1:00:36.41,1:00:39.58,Default,,0,0,0,,Мен де солай болмас үшін келдім.
Dialogue: 0,1:00:39.66,1:00:42.58,Default,,0,0,0,,Кимун Камуи сияқты үлкен қарсылас қандай?
Dialogue: 0,1:00:42.66,1:00:45.45,Default,,0,0,0,,Бұл қорқынышты, бірақ...
Dialogue: 0,1:00:45.54,1:00:48.91,Default,,0,0,0,,Біз сені оның сарайына апарамыз.
Dialogue: 0,1:00:49.00,1:00:51.75,Default,,0,0,0,,Басыңыз! Ах... Сабу...
Dialogue: 0,1:00:51.83,1:00:53.08,Default,,0,0,0,,Пайдалы!
Dialogue: 0,1:00:53.16,1:00:55.70,Default,,0,0,0,,Кеттік! Міне бітті!
Dialogue: 0,1:00:59.00,1:01:01.12,Default,,0,0,0,,Сіз оны Ирурудан естідіңіз, солай ма?
Dialogue: 0,1:01:02.29,1:01:05.70,Default,,0,0,0,,Мен туралы әкеңе айтуың керек еді.
Dialogue: 0,1:01:06.54,1:01:08.20,Default,,0,0,0,,Бұл сенің мінезің.
Dialogue: 0,1:01:08.87,1:01:11.87,Default,,0,0,0,,Әке саған сенеді...
Dialogue: 0,1:01:11.95,1:01:13.08,Default,,0,0,0,,Сенбейтініңізге сенімдімін
Dialogue: 0,1:01:13.16,1:01:15.58,Default,,0,0,0,,Ата-анаға қажет
Dialogue: 0,1:01:15.66,1:01:18.87,Default,,0,0,0,,Бірге күресе алатыныңызға қуаныштысыз ба?
Dialogue: 0,1:01:18.95,1:01:22.70,Default,,0,0,0,,Сондықтан мен бұл адамға қарағанда Кимун Камуиді таңдадым.
Dialogue: 0,1:01:22.79,1:01:27.62,Default,,0,0,0,,Сіз адам болып ойнауды қойып, достарыңызды тастап кеттіңіз, солай емес пе?
Dialogue: 0,1:01:28.62,1:01:34.33,Default,,0,0,0,,Әкесі бұйырса, ол қалай оңай ынтымақтаса болды?
Dialogue: 0,1:01:36.08,1:01:39.50,Default,,0,0,0,,Шайқас басталғанда мен бұл жерден кетемін.
Dialogue: 0,1:01:39.58,1:01:42.25,Default,,0,0,0,,Қалғандарымен өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,1:01:43.50,1:01:47.00,Default,,0,0,0,,Ендеше... тағы да солай істейсің бе?
Dialogue: 0,1:01:47.08,1:01:48.37,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:01:50.62,1:01:53.00,Default,,0,0,0,,Мен айдаһарларды жек көремін
Dialogue: 0,1:01:57.58,1:02:00.95,Default,,0,0,0,,Адамдар үшін ең жақсы нәрсе...
Dialogue: 0,1:02:01.70,1:02:05.37,Default,,0,0,0,,Айдаһардың өзі ғайып болады.
Dialogue: 0,1:02:05.45,1:02:08.41,Default,,0,0,0,,Осылайша сіз қалағаныңызша күресе аласыз.
Dialogue: 0,1:02:09.33,1:02:11.70,Default,,0,0,0,,Ол жоғалып кеткенше
Dialogue: 0,1:02:13.33,1:02:15.58,Default,,0,0,0,,Барлық айдаһарлар ондай емес.
Dialogue: 0,1:02:15.66,1:02:16.70,Default,,0,0,0,,Менің айналам...
Dialogue: 0,1:02:16.79,1:02:18.79,Default,,0,0,0,,Адамдардың эмоциясын түсіну
Dialogue: 0,1:02:18.87,1:02:21.75,Default,,0,0,0,,Сіз бір-бірімізді сыйлай аламыз және бір-бірімізбен бірге бола аламыз дейсіз бе?
Dialogue: 0,1:02:21.83,1:02:25.20,Default,,0,0,0,,Сіз ермек үшін адам болып көрінесіз!
Dialogue: 0,1:02:25.29,1:02:27.91,Default,,0,0,0,,Сонымен, сен де сол хатты қайта жаздың ба?
Dialogue: 0,1:02:28.00,1:02:29.12,Default,,0,0,0,,Ах...
Dialogue: 0,1:02:29.20,1:02:31.62,Default,,0,0,0,,Мен сіздің бұрын айтқаныңызды түсінемін.
Dialogue: 0,1:02:31.70,1:02:35.08,Default,,0,0,0,,Мен әкеме олай жаза алмаймын.
Dialogue: 0,1:02:36.66,1:02:39.29,Default,,0,0,0,,Айдаһарлар туралы не біле аламыз...
Dialogue: 0,1:02:39.37,1:02:41.54,Default,,0,0,0,,Түсіндім! Өйткені, олар ата-аналар мен балалар!
Dialogue: 0,1:02:41.62,1:02:45.04,Default,,0,0,0,,Адамдардан не үйренгенімді білмеймін.
Dialogue: 0,1:02:45.12,1:02:47.62,Default,,0,0,0,,Соңында бәрін лақтырып тастадың, солай ма?
Dialogue: 0,1:02:47.70,1:02:48.54,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:02:49.20,1:02:54.04,Default,,0,0,0,,Адамның сезімдері жай ғана жылы және мейірімді емес!
Dialogue: 0,1:02:54.91,1:02:58.08,Default,,0,0,0,,Ха ха ха... Яда Яда Мен ешқашан қоштаспаймын!
Dialogue: 0,1:02:58.16,1:03:02.29,Default,,0,0,0,,Қайда жүрсең де, мен сені қумаймын!
Dialogue: 0,1:03:02.37,1:03:03.79,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:03:03.87,1:03:06.04,Default,,0,0,0,,Қашқаннан пайда жоқ! Кеткен соң тіліңді тісте...
Dialogue: 0,1:03:06.12,1:03:09.37,Default,,0,0,0,,Керемет құмар жүрек...
Dialogue: 0,1:03:11.20,1:03:13.12,Default,,0,0,0,,Мен үлгіні ұстанамын.
Dialogue: 0,1:03:14.00,1:03:15.50,Default,,0,0,0,,Ұрысты тоқтатыңыз
Dialogue: 0,1:03:16.12,1:03:19.12,Default,,0,0,0,,Әкең көп болсын!
Dialogue: 0,1:03:19.70,1:03:22.37,Default,,0,0,0,,Азард... Сіз жеңілесіз!
Dialogue: 0,1:03:23.41,1:03:28.37,Default,,0,0,0,,Мен бәрін алып, Сайкава мен Кобаяшиге қайтамын!
Dialogue: 0,1:03:28.45,1:03:30.33,Default,,0,0,0,,Кішкентай қыз...
Dialogue: 0,1:03:30.41,1:03:33.45,Default,,0,0,0,,Сіз мені қатты тітіркендіргіңіз келетін сияқты.
Dialogue: 0,1:03:35.37,1:03:38.45,Default,,0,0,0,,Сіз ештеңе істей алмайсыз!
Dialogue: 0,1:03:40.04,1:03:45.29,Default,,0,0,0,,(разряд дыбысы)
Dialogue: 0,1:03:45.37,1:03:47.04,Default,,0,0,0,,- (Кобаяши) Ха ха... - (Кәрі пері) Кобаяши мырза!
Dialogue: 0,1:03:47.12,1:03:49.00,Default,,0,0,0,,Біз жақындап қалдық!
Dialogue: 0,1:03:49.08,1:03:50.29,Default,,0,0,0,,Сәлем~
Dialogue: 0,1:03:51.16,1:03:53.62,Default,,0,0,0,,Менімен Азад хабарласты.
Dialogue: 0,1:03:53.70,1:03:56.25,Default,,0,0,0,,Айдаһар шары жақын арада аяқталатын сияқты.
Dialogue: 0,1:03:56.33,1:03:58.58,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,1:03:58.66,1:04:03.62,Default,,0,0,0,,(разряд дыбысы)
Dialogue: 0,1:04:05.54,1:04:06.37,Default,,0,0,0,,Хмф!
Dialogue: 0,1:04:08.66,1:04:09.50,Default,,0,0,0,,Чи…
Dialogue: 0,1:04:19.20,1:04:20.37,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:04:23.83,1:04:25.37,Default,,0,0,0,,- (Азар) Әй! - Қарғыс атсын...
Dialogue: 0,1:04:30.62,1:04:31.62,Default,,0,0,0,,Ннн!
Dialogue: 0,1:04:33.25,1:04:34.25,Default,,0,0,0,,Иә!
Dialogue: 0,1:04:35.45,1:04:36.29,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:04:36.83,1:04:37.66,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,1:04:39.33,1:04:40.20,Default,,0,0,0,,Ах!
Dialogue: 0,1:04:41.54,1:04:42.83,Default,,0,0,0,,- (Азад) Ха! -Гах...
Dialogue: 0,1:04:42.91,1:04:44.29,Default,,0,0,0,,А...
Dialogue: 0,1:04:45.87,1:04:47.00,Default,,0,0,0,,Бұл қылыш та
Dialogue: 0,1:04:48.45,1:04:50.87,Default,,0,0,0,,Бұл жай қылыш емес.
Dialogue: 0,1:04:50.95,1:04:54.95,Default,,0,0,0,,(Каннаның ауыр тыныс алуы)
Dialogue: 0,1:04:55.66,1:04:56.87,Default,,0,0,0,,Өйткені
Dialogue: 0,1:04:58.79,1:05:00.58,Default,,0,0,0,,Бұл туралы.
Dialogue: 0,1:05:04.16,1:05:07.95,Default,,0,0,0,,Сенің адам болып көрінуің бітті.
Dialogue: 0,1:05:09.12,1:05:10.16,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:10.25,1:05:12.08,Default,,0,0,0,,Бұл жоспарланғаннан ерте болды...
Dialogue: 0,1:05:13.29,1:05:16.29,Default,,0,0,0,,Қобаяши деген адам келе жатқан сияқты.
Dialogue: 0,1:05:16.37,1:05:17.54,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:17.62,1:05:19.79,Default,,0,0,0,,Бірақ тым кеш
Dialogue: 0,1:05:20.58,1:05:21.91,Default,,0,0,0,,Кобаяши…
Dialogue: 0,1:05:22.79,1:05:24.16,Default,,0,0,0,,Кобаяши мырза!
Dialogue: 0,1:05:24.25,1:05:27.79,Default,,0,0,0,,Сол таудан өтсең, Кимун Камуи қамалына жетесің!
Dialogue: 0,1:05:27.87,1:05:29.12,Default,,0,0,0,,Міне!
Dialogue: 0,1:05:30.58,1:05:33.41,Default,,0,0,0,,Сол тау...
Dialogue: 0,1:05:33.50,1:05:34.75,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,1:05:34.83,1:05:37.45,Default,,0,0,0,,Бұл хаотикалық айдаһар!
Dialogue: 0,1:05:37.54,1:05:41.20,Default,,0,0,0,,Уау! Гармониялық күш артта келеді!
Dialogue: 0,1:05:42.25,1:05:43.66,Default,,0,0,0,,А...
Dialogue: 0,1:05:43.75,1:05:46.50,Default,,0,0,0,,Уау!
Dialogue: 0,1:05:54.79,1:05:57.33,Default,,0,0,0,,Неліктен мұндай жерде адамдар бар?
Dialogue: 0,1:05:57.41,1:06:00.62,Default,,0,0,0,,- (Хаос) Сіз үйлесімді күштің мүшесісіз бе? -(Кобаяши) Ой... Жоқ, жоқ!
Dialogue: 0,1:06:00.70,1:06:02.54,Default,,0,0,0,,Жаса!
Dialogue: 0,1:06:03.20,1:06:06.12,Default,,0,0,0,,- (Кәрі пері) Мен сені қорғаймын... - (Пери қыз) Міне, келдік!
Dialogue: 0,1:06:06.20,1:06:07.87,Default,,0,0,0,,Иә!
Dialogue: 0,1:06:07.95,1:06:09.87,Default,,0,0,0,,Жоооу!
Dialogue: 0,1:06:09.95,1:06:11.91,Default,,0,0,0,,Мен жеңілдім!
Dialogue: 0,1:06:12.00,1:06:14.37,Default,,0,0,0,,Қария! Қызым!
Dialogue: 0,1:06:14.45,1:06:16.95,Default,,0,0,0,,Эй, мынаны қара!
Dialogue: 0,1:06:19.54,1:06:21.95,Default,,0,0,0,,Гармониялық күштердің негізгі күші!
Dialogue: 0,1:06:22.04,1:06:24.87,Default,,0,0,0,,Сізді осында ынталандырасыз ба?
Dialogue: 0,1:06:39.12,1:06:42.12,Default,,0,0,0,,Кимун Камуидің қызы осында болуы керек!
Dialogue: 0,1:06:42.20,1:06:44.25,Default,,0,0,0,,Бұған не болды!
Dialogue: 0,1:06:47.08,1:06:49.16,Default,,0,0,0,,Канна-чанды қайтарыңыз!
Dialogue: 0,1:06:51.33,1:06:53.95,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:06:54.04,1:06:54.95,Default,,0,0,0,,Гррр…
Dialogue: 0,1:06:55.04,1:06:56.41,Default,,0,0,0,,(Жалын сәулесінің жылдам өрт дыбысы)
Dialogue: 0,1:06:56.50,1:06:57.91,Default,,0,0,0,,(Екі армияның таңғалған дыбыстары)
Dialogue: 0,1:06:58.50,1:06:59.37,Default,,0,0,0,,Хмм...
Dialogue: 0,1:06:59.45,1:07:00.54,Default,,0,0,0,,(Жылдам дыбыс)
Dialogue: 0,1:07:02.08,1:07:03.20,Default,,0,0,0,,(Соққы дыбысы)
Dialogue: 0,1:07:03.29,1:07:06.25,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,1:07:06.33,1:07:07.62,Default,,0,0,0,,Кобаяши-сан!
Dialogue: 0,1:07:09.12,1:07:10.16,Default,,0,0,0,,Тор!
Dialogue: 0,1:07:12.91,1:07:15.04,Default,,0,0,0,,(Жылдам дыбыс)
Dialogue: 0,1:07:15.12,1:07:19.16,Default,,0,0,0,,сәби әлі тірі. Бұл адам баланы қорғап қалған болар.
Dialogue: 0,1:07:26.91,1:07:28.33,Default,,0,0,0,,Тор…
Dialogue: 0,1:07:28.41,1:07:30.83,Default,,0,0,0,,Олар оны өлтіре алмады ма?
Dialogue: 0,1:07:30.91,1:07:33.16,Default,,0,0,0,,Ақыр заман императорының қызы...
Dialogue: 0,1:07:33.25,1:07:35.83,Default,,0,0,0,,Бізбен соғысуға оралдың ба?
Dialogue: 0,1:07:35.91,1:07:38.20,Default,,0,0,0,,Кобаяши-сан, кешіккенім үшін кешіріңіз!
Dialogue: 0,1:07:38.29,1:07:39.79,Default,,0,0,0,,- (Кобаяши) Кешіктің! -(Тор) Ух...
Dialogue: 0,1:07:40.41,1:07:42.62,Default,,0,0,0,,Бұл жаман, бұл жанасу жағдайы...
Dialogue: 0,1:07:42.70,1:07:45.00,Default,,0,0,0,,Біз төбелессек те, бұл жерде қысқыш шабуыл.
Dialogue: 0,1:07:45.08,1:07:46.79,Default,,0,0,0,,Неге басымдық беру керек...
Dialogue: 0,1:07:46.87,1:07:47.87,Default,,0,0,0,,Кобаяши мырза?
Dialogue: 0,1:07:47.95,1:07:52.58,Default,,0,0,0,,Егер Тор осында болса, мен өзімді тыныштандыратын сияқтымын...
Dialogue: 0,1:07:53.41,1:07:55.33,Default,,0,0,0,,Мені таң қалдырды...
Dialogue: 0,1:07:56.33,1:07:59.33,Default,,0,0,0,,Айдаһарлар сапқа тұрды
Dialogue: 0,1:08:00.16,1:08:04.41,Default,,0,0,0,,Бұл сурет әлемі сияқты...
Dialogue: 0,1:08:06.04,1:08:08.66,Default,,0,0,0,,- (Тор) Кобаяши мырза! -(Кобаяши) А? Ах...
Dialogue: 0,1:08:08.75,1:08:11.25,Default,,0,0,0,,Мен бұл жерден әзірге кетемін!
Dialogue: 0,1:08:11.33,1:08:13.62,Default,,0,0,0,,Жоқ, күте тұрыңыз, бұл шын мәнінде ыңғайлырақ.
Dialogue: 0,1:08:13.70,1:08:14.54,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:14.62,1:08:18.00,Default,,0,0,0,,Тор Даусымды қаттырақ шығара аласыз ба?
Dialogue: 0,1:08:18.08,1:08:22.50,Default,,0,0,0,,Өлім императорының қызы болсаң маған бәрібір, бірге істейік!
Dialogue: 0,1:08:22.58,1:08:24.79,Default,,0,0,0,,Өнер бойынша тест
Dialogue: 0,1:08:24.87,1:08:27.58,Default,,0,0,0,,Мен енді шыдай алмаймын! Мен жасаймын!
Dialogue: 0,1:08:27.66,1:08:30.16,Default,,0,0,0,,Жоқ, Кимун Камуи-саманың бұйрығы әлі...
Dialogue: 0,1:08:30.25,1:08:32.50,Default,,0,0,0,,Бүгін күн ашық
Dialogue: 0,1:08:32.58,1:08:34.37,Default,,0,0,0,,Бүгін күн ашық
Dialogue: 0,1:08:34.45,1:08:37.16,Default,,0,0,0,,(Екі әскердің толқуы)
Dialogue: 0,1:08:37.25,1:08:39.91,Default,,0,0,0,,Тыныш!
Dialogue: 0,1:08:41.50,1:08:43.16,Default,,0,0,0,,(Екі армияның таңғаларлық дыбыстары)
Dialogue: 0,1:08:43.25,1:08:48.41,Default,,0,0,0,,Мен бітімге келу туралы ұсыныс жасауға келген үшінші тараппын...
Dialogue: 0,1:08:48.50,1:08:51.79,Default,,0,0,0,,Мен жай ғана адам Кобаяшимін!
Dialogue: 0,1:08:52.87,1:08:55.58,Default,,0,0,0,,Сіздің конфликтіңіз реттелді.
Dialogue: 0,1:08:55.66,1:08:57.54,Default,,0,0,0,,Өйткені бұл өте тітіркендіргіш.
Dialogue: 0,1:08:57.62,1:09:02.08,Default,,0,0,0,,Осы арқылы біз шындықты айтуды және бітімге шақыруды ұсынамыз.
Dialogue: 0,1:09:02.16,1:09:04.79,Default,,0,0,0,,(Наразылық білдірген екі армияның дауысы)
Dialogue: 0,1:09:04.87,1:09:07.33,Default,,0,0,0,,Ол жігіттер бізге ештеңе істеп жатқан жоқ.
Dialogue: 0,1:09:07.41,1:09:08.41,Default,,0,0,0,,Сіз кенет төбелесіп қалдыңыз!
Dialogue: 0,1:09:08.41,1:09:09.95,Default,,0,0,0,,Сіз кенет төбелесіп қалдыңыз!
Dialogue: 0,1:09:08.41,1:09:09.95,Default,,0,0,0,,А, иә...
Dialogue: 0,1:09:10.04,1:09:11.87,Default,,0,0,0,,Ештеңе жасамасаңыз ше?
Dialogue: 0,1:09:11.95,1:09:14.58,Default,,0,0,0,,Мен сендердің діндарларға қысым көрсетіп жатырсыңдар деп естідім!
Dialogue: 0,1:09:14.58,1:09:15.54,Default,,0,0,0,,Мен сендердің діндарларға қысым көрсетіп жатырсыңдар деп естідім!
Dialogue: 0,1:09:14.58,1:09:15.54,Default,,0,0,0,,Иә, иә…
Dialogue: 0,1:09:15.62,1:09:19.41,Default,,0,0,0,,Хаос күштері адамдар бір-бірімен соғысқан жерді қиратуда.
Dialogue: 0,1:09:19.50,1:09:21.79,Default,,0,0,0,,Мен оларды жай ғана пайдаланады деп естідім.
Dialogue: 0,1:09:21.87,1:09:26.45,Default,,0,0,0,,Ал жарасымды күштер жалған ақпарат естіп, осында келді!
Dialogue: 0,1:09:26.54,1:09:28.33,Default,,0,0,0,,Жалған ақпарат?
Dialogue: 0,1:09:28.41,1:09:29.91,Default,,0,0,0,,Азад?
Dialogue: 0,1:09:30.00,1:09:33.04,Default,,0,0,0,,Тоқта, күт! Бұл кенеттен пайда болған адам.
Dialogue: 0,1:09:33.12,1:09:34.41,Default,,0,0,0,,Оған қалай сенуге болады?
Dialogue: 0,1:09:34.50,1:09:38.29,Default,,0,0,0,,Бірақ егер бұл рас болса, біз еш себепсіз ұрысып қаламыз.
Dialogue: 0,1:09:38.37,1:09:41.04,Default,,0,0,0,,Маңызды емес! Мен ұрысамын!
Dialogue: 0,1:09:41.79,1:09:44.20,Default,,0,0,0,,Ренжімеңіз!
Dialogue: 0,1:09:44.29,1:09:45.58,Default,,0,0,0,,Құрметті Люминдер...
Dialogue: 0,1:09:45.66,1:09:49.79,Default,,0,0,0,,Азад бізге көп жыл қызмет еткен барлаушы.
Dialogue: 0,1:09:49.87,1:09:53.08,Default,,0,0,0,,Өтірік айтып жатқаның жәй ғана қорлық!
Dialogue: 0,1:09:53.16,1:09:56.58,Default,,0,0,0,,Иә, мен алданып қала жаздадым.
Dialogue: 0,1:09:56.66,1:10:00.08,Default,,0,0,0,,Қандай өтірік! Кешір мені, адам!
Dialogue: 0,1:10:00.16,1:10:03.04,Default,,0,0,0,,Иә? Бірақ Азад маған опасыздық жасады ма?
Dialogue: 0,1:10:03.12,1:10:04.08,Default,,0,0,0,,Мен таң қалдым...
Dialogue: 0,1:10:04.91,1:10:07.41,Default,,0,0,0,,Айдаһар Тым көп емес пе?
Dialogue: 0,1:10:07.50,1:10:09.95,Default,,0,0,0,,Бұлай айтатын уақыт емес.
Dialogue: 0,1:10:10.04,1:10:12.70,Default,,0,0,0,,Дүрбелең емес Дүрбелең емес...
Dialogue: 0,1:10:12.79,1:10:14.95,Default,,0,0,0,,А... мұнда сигнал жоқ па?
Dialogue: 0,1:10:15.04,1:10:16.62,Default,,0,0,0,,Кешіріңіз! (Жартылай жұмыс істейтін қызметкер) Ә?
Dialogue: 0,1:10:17.20,1:10:19.83,Default,,0,0,0,,Жақында үйренген сиқыр
Dialogue: 0,1:10:19.91,1:10:22.58,Default,,0,0,0,,Анықтау және радиотолқынды тарату (сиқырлы шеңберді кеңейту дыбысы)
Dialogue: 0,1:10:26.91,1:10:27.50,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:10:27.50,1:10:29.62,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:10:27.50,1:10:29.62,Default,,0,0,0,,Ха! Бұл қандай дыбыс?
Dialogue: 0,1:10:29.62,1:10:31.00,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,1:10:31.08,1:10:33.33,Default,,0,0,0,,-Ах... -(Азар) Бұл не?
Dialogue: 0,1:10:33.41,1:10:34.58,Default,,0,0,0,,Телефон
Dialogue: 0,1:10:34.66,1:10:36.04,Default,,0,0,0,,Кобаяшиден...
Dialogue: 0,1:10:36.12,1:10:38.66,Default,,0,0,0,,А... сөйлейтін құрал?
Dialogue: 0,1:10:39.54,1:10:42.16,Default,,0,0,0,,Жарайды, сөйлесейік.
Dialogue: 0,1:10:42.87,1:10:45.91,Default,,0,0,0,,Соңғы сөздеріңізді бір-біріңізге айтыңыз.
Dialogue: 0,1:10:46.00,1:10:47.29,Default,,0,0,0,,Кобаяши
Dialogue: 0,1:10:47.87,1:10:49.04,Default,,0,0,0,,Мен...
Dialogue: 0,1:10:49.12,1:10:50.41,Default,,0,0,0,,Жаман емес
Dialogue: 0,1:10:50.50,1:10:53.04,Default,,0,0,0,,Мен тіпті рұқсатсыз дауыс жазғышты да алдым.
Dialogue: 0,1:10:55.87,1:10:57.04,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,1:10:57.12,1:10:59.04,Default,,0,0,0,,Бірақ ол дұрыс жазылған.
Dialogue: 0,1:10:59.12,1:11:02.20,Default,,0,0,0,,Сіз бұзақылықты жақсы көресіз.
Dialogue: 0,1:11:02.29,1:11:05.54,Default,,0,0,0,,Соны да сұрасам бола ма?
Dialogue: 0,1:11:05.62,1:11:07.45,Default,,0,0,0,,Иә, жақсы!
Dialogue: 0,1:11:08.12,1:11:10.45,Default,,0,0,0,,Онда мұны істеу дұрыс па?
Dialogue: 0,1:11:10.54,1:11:12.54,Default,,0,0,0,,Жарайды, сеніңіз!
Dialogue: 0,1:11:13.45,1:11:14.54,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,1:11:15.50,1:11:18.04,Default,,0,0,0,,Мен сізге дереу көмектесемін.
Dialogue: 0,1:11:23.20,1:11:25.91,Default,,0,0,0,,Бұл соңғы чат болды ма?
Dialogue: 0,1:11:28.04,1:11:30.87,Default,,0,0,0,,Ал, бәрің тыныш болыңдар!
Dialogue: 0,1:11:30.95,1:11:33.50,Default,,0,0,0,,Менде сіз естігіңіз келетін нәрсе бар!
Dialogue: 0,1:11:35.04,1:11:37.29,Default,,0,0,0,,Не? қару?
Dialogue: 0,1:11:37.95,1:11:40.83,Default,,0,0,0,,Бірақ бұл қауіпті ештеңеге ұқсамайды!
Dialogue: 0,1:11:40.91,1:11:43.83,Default,,0,0,0,,Қандай жағдай болмасын, сіздің қорғанысыңыз мінсіз!
Dialogue: 0,1:11:45.62,1:11:48.29,Default,,0,0,0,,Мен айдаһарларды жек көремін
Dialogue: 0,1:11:49.00,1:11:51.04,Default,,0,0,0,,Адам үшін ең жақсы нәрсе –...
Dialogue: 0,1:11:51.12,1:11:54.33,Default,,0,0,0,,Айдаһардың өзі ғайып болады.
Dialogue: 0,1:11:54.41,1:11:56.62,Default,,0,0,0,,Осылайша сіз қалағаныңызша күресе аласыз.
Dialogue: 0,1:11:56.70,1:11:58.04,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:58.70,1:12:01.04,Default,,0,0,0,,Ол жоғалып кеткенше
Dialogue: 0,1:12:03.41,1:12:08.25,Default,,0,0,0,,Бұл шешуші... Сиқырмен жасалған дауыстың реакциясын да байқай алмаймын.
Dialogue: 0,1:12:08.33,1:12:12.95,Default,,0,0,0,,Біз сіздің дауысыңызды сиқыр арқылы тікелей жеткіземіз!
Dialogue: 0,1:12:13.04,1:12:16.45,Default,,0,0,0,,Азад... Маған опасыздық жасадың ба?
Dialogue: 0,1:12:16.54,1:12:19.29,Default,,0,0,0,,Не? Менің дауысым?
Dialogue: 0,1:12:19.37,1:12:23.62,Default,,0,0,0,,Ондай құрал...жоқ, айдаһар мұндай қулық жасай алар еді...
Dialogue: 0,1:12:23.70,1:12:25.12,Default,,0,0,0,,Алшақтық бар!
Dialogue: 0,1:12:25.20,1:12:29.95,Default,,0,0,0,,(разряд дыбысы)
Dialogue: 0,1:12:32.16,1:12:33.75,Default,,0,0,0,,Дұрыс байқадың
Dialogue: 0,1:12:36.12,1:12:38.20,Default,,0,0,0,,Мен сізді қорлағанымды мойындаймын...
Dialogue: 0,1:12:39.04,1:12:41.25,Default,,0,0,0,,Келесі жолы мұқият боламын
Dialogue: 0,1:12:44.16,1:12:45.08,Default,,0,0,0,,Ашу...
Dialogue: 0,1:12:45.87,1:12:47.04,Default,,0,0,0,,Олай емес...
Dialogue: 0,1:12:49.25,1:12:50.79,Default,,0,0,0,,Мұңды көздер...
Dialogue: 0,1:12:50.87,1:12:52.20,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:12:56.91,1:12:58.12,Default,,0,0,0,,Уф...
Dialogue: 0,1:12:58.20,1:12:59.25,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:00.29,1:13:01.50,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:13:01.58,1:13:02.91,Default,,0,0,0,,(Кимун Камуидің ырылдауы)
Dialogue: 0,1:13:04.66,1:13:06.25,Default,,0,0,0,,Дегенмен, бұл аянышты көрініс әдемі
Dialogue: 0,1:13:06.33,1:13:09.12,Default,,0,0,0,,Сіз шайқас алдында медитация жасауыңыз керек...
Dialogue: 0,1:13:09.20,1:13:10.37,Default,,0,0,0,,Иә
Dialogue: 0,1:13:10.45,1:13:12.41,Default,,0,0,0,,Төзе бер, шыдай бер!
Dialogue: 0,1:13:16.04,1:13:18.04,Default,,0,0,0,,Я... (зарядтау дыбысы)
Dialogue: 0,1:13:18.12,1:13:21.54,Default,,0,0,0,,Осы асыл шайқаста мен сараң болдым...
Dialogue: 0,1:13:21.62,1:13:24.33,Default,,0,0,0,,Майданнан келсе жақсы болар еді.
Dialogue: 0,1:13:24.41,1:13:27.29,Default,,0,0,0,,Өкінішке орай, мен ондай нәрсеге шебер емеспін!
Dialogue: 0,1:13:28.83,1:13:30.58,Default,,0,0,0,,Мен ұялшақпын
Dialogue: 0,1:13:32.12,1:13:32.95,Default,,0,0,0,,Гуааа…
Dialogue: 0,1:13:33.70,1:13:35.50,Default,,0,0,0,,(соққы тесетін дыбыс)
Dialogue: 0,1:13:41.00,1:13:43.75,Default,,0,0,0,,Мен сені өлтіремін, Азад.
Dialogue: 0,1:13:43.83,1:13:46.83,Default,,0,0,0,,Меніңше, сенің достарыңның ешқайсысы сенің өліміңді жоқтамайды.
Dialogue: 0,1:13:47.79,1:13:49.04,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:49.12,1:13:51.12,Default,,0,0,0,,Мен саған көрсетемін...
Dialogue: 0,1:13:51.95,1:13:53.41,Default,,0,0,0,,Айдаһар шарының күші!
Dialogue: 0,1:13:57.45,1:13:58.50,Default,,0,0,0,,Иә?
Dialogue: 0,1:14:02.45,1:14:04.62,Default,,0,0,0,,Айдаһар шарының күші...
Dialogue: 0,1:14:04.70,1:14:08.58,Default,,0,0,0,,Бұл сіздің айдаһарыңыздың қабілеттерін жақсарту туралы ғана емес.
Dialogue: 0,1:14:09.45,1:14:11.29,Default,,0,0,0,,Не болды? Уф...
Dialogue: 0,1:14:11.37,1:14:12.54,Default,,0,0,0,,Тіпті шебер
Dialogue: 0,1:14:12.62,1:14:16.41,Default,,0,0,0,,Сіз айдаһардың күшін ала аласыз.
Dialogue: 0,1:14:16.50,1:14:18.41,Default,,0,0,0,,Айдаһарлар қалай?
Dialogue: 0,1:14:18.50,1:14:20.00,Default,,0,0,0,,Және…
Dialogue: 0,1:14:20.08,1:14:23.70,Default,,0,0,0,,Бұл күтпеген қосымша өнім жасады.
Dialogue: 0,1:14:24.37,1:14:27.29,Default,,0,0,0,,Сиқырдың сипатын өзгерту
Dialogue: 0,1:14:27.37,1:14:30.50,Default,,0,0,0,,Айдаһарға сырғанау
Dialogue: 0,1:14:31.08,1:14:32.00,Default,,0,0,0,,Әке...!
Dialogue: 0,1:14:32.08,1:14:34.95,Default,,0,0,0,,-Ннннн... -(Азард) Сол дене және—
Dialogue: 0,1:14:35.04,1:14:36.79,Default,,0,0,0,,Рухты бұзу…
Dialogue: 0,1:14:37.66,1:14:39.75,Default,,0,0,0,,- (Азард) Манипуляция! -Ха!
Dialogue: 0,1:14:39.83,1:14:42.58,Default,,0,0,0,,(Екі армияның даусы)
Dialogue: 0,1:14:42.66,1:14:43.83,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,1:14:43.91,1:14:48.87,Default,,0,0,0,,(Жерді тербеткен дыбыс)
Dialogue: 0,1:14:48.95,1:14:49.79,Default,,0,0,0,,Ах!
Dialogue: 0,1:14:55.95,1:14:56.95,Default,,0,0,0,,Тор!
Dialogue: 0,1:14:57.79,1:14:59.87,Default,,0,0,0,,Бұл... Кобаяши мырза! Ха!
Dialogue: 0,1:14:59.95,1:15:01.62,Default,,0,0,0,,(Айдаһарлардың айқайы)
Dialogue: 0,1:15:01.70,1:15:02.62,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,1:15:02.70,1:15:05.87,Default,,0,0,0,,(Желді жарып өту дыбысы)
Dialogue: 0,1:15:05.95,1:15:07.66,Default,,0,0,0,,Тааааааааааа!
Dialogue: 0,1:15:07.75,1:15:08.75,Default,,0,0,0,,(Үлдеген дыбыс)
Dialogue: 0,1:15:08.83,1:15:11.04,Default,,0,0,0,,(Айдаһардың айқайы)
Dialogue: 0,1:15:11.91,1:15:13.29,Default,,0,0,0,,А...
Dialogue: 0,1:15:14.41,1:15:17.41,Default,,0,0,0,,Уф... жерлесімді ұрдым...
Dialogue: 0,1:15:17.50,1:15:20.16,Default,,0,0,0,,Айдаһар шарының күшін пайдаландың ба?
Dialogue: 0,1:15:20.25,1:15:22.33,Default,,0,0,0,,Жағдай тез өзгеріп жатқан сияқты.
Dialogue: 0,1:15:22.41,1:15:24.41,Default,,0,0,0,,Жүр! Мұны маған қалдырыңыз!
Dialogue: 0,1:15:24.50,1:15:26.45,Default,,0,0,0,,Балалар...
Dialogue: 0,1:15:26.54,1:15:29.83,Default,,0,0,0,,Қол ұшын созатын жағдайыңыз жоқ екеніне сенімдімін...
Dialogue: 0,1:15:29.91,1:15:33.12,Default,,0,0,0,,Вокзал алдында креппен тамақтаныңыз!
Dialogue: 0,1:15:33.20,1:15:35.95,Default,,0,0,0,,Маған соңғы Grabo нұсқасын беріңіз.
Dialogue: 0,1:15:36.04,1:15:37.41,Default,,0,0,0,,А...
Dialogue: 0,1:15:37.50,1:15:39.66,Default,,0,0,0,,Азардтың көшкені осыны білдіреді
Dialogue: 0,1:15:39.75,1:15:42.25,Default,,0,0,0,,Канна қауіпті. Барайық!
Dialogue: 0,1:15:42.33,1:15:43.20,Default,,0,0,0,,Иә!
Dialogue: 0,1:15:43.29,1:15:46.29,Default,,0,0,0,,Екеуіңізге де рахмет!
Dialogue: 0,1:15:48.04,1:15:50.75,Default,,0,0,0,,Мен хаос күштеріне қарсы күресемін.
Dialogue: 0,1:15:50.83,1:15:53.91,Default,,0,0,0,,Мен барлық үйлесімді күштерді өлтіремін.
Dialogue: 0,1:15:54.00,1:15:54.91,Default,,0,0,0,,Эй!
Dialogue: 0,1:15:55.00,1:15:56.75,Default,,0,0,0,,Цк... жартылай өлі.
Dialogue: 0,1:15:56.83,1:15:57.70,Default,,0,0,0,,Біз де!
Dialogue: 0,1:15:57.79,1:15:59.66,Default,,0,0,0,,Мен сізге қосыламын!
Dialogue: 0,1:15:59.75,1:16:00.70,Default,,0,0,0,,Бұл кім?
Dialogue: 0,1:16:02.20,1:16:05.79,Default,,0,0,0,,Егер араласу болмаса, шайқас аяқталар еді.
Dialogue: 0,1:16:05.87,1:16:07.95,Default,,0,0,0,,Кобаяши мырза күткендей!
Dialogue: 0,1:16:08.04,1:16:09.45,Default,,0,0,0,,Жоқ.
Dialogue: 0,1:16:09.54,1:16:12.62,Default,,0,0,0,,Айдаһарлар оңай алданып қалады.
Dialogue: 0,1:16:12.70,1:16:15.79,Default,,0,0,0,,Мен оңай алдандым, сондықтан мен оңай ояндым.
Dialogue: 0,1:16:16.54,1:16:18.25,Default,,0,0,0,,Менің ойымша, бұл таза.
Dialogue: 0,1:16:18.79,1:16:19.75,Default,,0,0,0,,Мен нені қозғадым
Dialogue: 0,1:16:20.58,1:16:23.29,Default,,0,0,0,,Еш нәрсеге қарамастан өз ойыңызды өзгерте аласыз...
Dialogue: 0,1:16:26.33,1:16:28.16,Default,,0,0,0,,Бұл таудың арғы жағында.
Dialogue: 0,1:16:32.12,1:16:33.25,Default,,0,0,0,,Не!
Dialogue: 0,1:16:45.58,1:16:49.70,Default,,0,0,0,,Оны көргенде білесің. Бұл Кимун Камуй...
Dialogue: 0,1:16:50.79,1:16:52.50,Default,,0,0,0,,Канна-чан ше?
Dialogue: 0,1:16:52.58,1:16:53.66,Default,,0,0,0,,Міне!
Dialogue: 0,1:16:57.70,1:16:59.12,Default,,0,0,0,,Канна-чан, жақсысың ба?
Dialogue: 0,1:16:59.20,1:17:01.00,Default,,0,0,0,,Мури Шину…
Dialogue: 0,1:17:02.41,1:17:05.91,Default,,0,0,0,,Осы уақытқа дейін қарапайым адам келді.
Dialogue: 0,1:17:06.00,1:17:07.16,Default,,0,0,0,,Азард...!
Dialogue: 0,1:17:07.25,1:17:08.75,Default,,0,0,0,,Айдаһардың қорғауымен
Dialogue: 0,1:17:08.83,1:17:11.75,Default,,0,0,0,,Міне, соншалықты ерінбей кетесің.
Dialogue: 0,1:17:11.83,1:17:14.12,Default,,0,0,0,,Адамдар туралы айта аласыз ба?
Dialogue: 0,1:17:14.20,1:17:17.70,Default,,0,0,0,,Бұл Рыгёку деп аталады, сондықтан сіз айдаһарды басқарасыз, солай ма?
Dialogue: 0,1:17:17.79,1:17:21.66,Default,,0,0,0,,Күтілгендей, адамдар айдаһардан да өткір.
Dialogue: 0,1:17:21.75,1:17:25.12,Default,,0,0,0,,Барлық айдаһарларды басқару мүмкін емес.
Dialogue: 0,1:17:25.20,1:17:27.37,Default,,0,0,0,,Сиқырлы күштің қасиетін түсінеді
Dialogue: 0,1:17:28.00,1:17:31.37,Default,,0,0,0,,Тіпті бұл аймақтағы бұрыннан араласқан айдаһарлар да!
Dialogue: 0,1:17:31.45,1:17:33.04,Default,,0,0,0,,Мынау не жігіт...
Dialogue: 0,1:17:33.12,1:17:35.45,Default,,0,0,0,,Мен шамалы сиқыр қолдансам да,
Dialogue: 0,1:17:35.54,1:17:38.37,Default,,0,0,0,,Аз ғана білім емес пе?
Dialogue: 0,1:17:39.00,1:17:41.41,Default,,0,0,0,,Кимун Камуй да, сиқырлы күштің қасиетін түсінсең.
Dialogue: 0,1:17:41.50,1:17:43.83,Default,,0,0,0,,Міне, жағдай осылай...
Dialogue: 0,1:17:43.91,1:17:46.04,Default,,0,0,0,,Бұл аянышты...
Dialogue: 0,1:17:46.12,1:17:48.50,Default,,0,0,0,,Балаларға шабуыл жасау үшін ата-аналарды манипуляциялау
Dialogue: 0,1:17:48.58,1:17:50.08,Default,,0,0,0,,Бұл өте төмен емес пе?
Dialogue: 0,1:17:50.16,1:17:52.41,Default,,0,0,0,,Бұл айдаһар ғой
Dialogue: 0,1:17:52.50,1:17:56.83,Default,,0,0,0,,Біз ешқашан адамның сүйіспеншілігін түсінбейміз.
Dialogue: 0,1:17:56.91,1:17:58.45,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,1:17:58.54,1:18:00.29,Default,,0,0,0,,Сіз ата-ана мен бала махаббатын пайдаланасыз ба?
Dialogue: 0,1:18:00.37,1:18:02.29,Default,,0,0,0,,Мен Канна-чанға телефон соқтым.
Dialogue: 0,1:18:02.37,1:18:06.91,Default,,0,0,0,,Сіз оны одан да қатты жоққа шығарғыңыз келді, сондықтан онымен ойнадыңыз, солай ма?
Dialogue: 0,1:18:07.00,1:18:08.04,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:18:08.12,1:18:10.29,Default,,0,0,0,,Мұның бәрі чат үшін!
Dialogue: 0,1:18:10.37,1:18:11.50,Default,,0,0,0,,Жүр!
Dialogue: 0,1:18:15.58,1:18:18.87,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,1:18:23.25,1:18:24.41,Default,,0,0,0,,Әке!
Dialogue: 0,1:18:25.95,1:18:27.54,Default,,0,0,0,,Дио, жүрегім ауыр.
Dialogue: 0,1:18:27.62,1:18:28.95,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:18:30.75,1:18:32.79,Default,,0,0,0,,Әке, тоқтатыңыз!
Dialogue: 0,1:18:36.04,1:18:37.29,Default,,0,0,0,,(Зарядтау дыбысы)
Dialogue: 0,1:18:37.37,1:18:38.29,Default,,0,0,0,,Сені махаббат сиқырымен баурап алатын боламын.
Dialogue: 0,1:18:41.62,1:18:44.25,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:18:44.33,1:18:47.04,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:18:53.41,1:18:55.45,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:19:05.70,1:19:08.54,Default,,0,0,0,,Сізді толығымен басқарып жатырсыз ба...
Dialogue: 0,1:19:09.12,1:19:10.37,Default,,0,0,0,,Бұл жұмыс істемеді...
Dialogue: 0,1:19:11.00,1:19:15.66,Default,,0,0,0,,Мен саған талай рет хабарластым, бірақ ешкім байқамады...
Dialogue: 0,1:19:16.25,1:19:17.45,Default,,0,0,0,,Канна-чан...
Dialogue: 0,1:19:39.79,1:19:42.20,Default,,0,0,0,,Менің ойымша, бұл жақсы емес ...?
Dialogue: 0,1:19:59.75,1:20:03.04,Default,,0,0,0,,Даусым саған жетпей ме екен...?
Dialogue: 0,1:20:06.16,1:20:07.16,Default,,0,0,0,,Хмм...
Dialogue: 0,1:20:09.83,1:20:11.41,Default,,0,0,0,,Мен оны сізге жеткіземін.
Dialogue: 0,1:20:11.50,1:20:17.29,Default,,0,0,0,,Менің қазіргі әкемді Кобаяши де тоқтата алмайды.
Dialogue: 0,1:20:17.37,1:20:18.62,Default,,0,0,0,,Фокустар
Dialogue: 0,1:20:21.16,1:20:25.87,Default,,0,0,0,,(фокусталған энергия дыбысы)
Dialogue: 0,1:20:26.95,1:20:27.79,Default,,0,0,0,,Айла?
Dialogue: 0,1:20:27.87,1:20:30.66,Default,,0,0,0,,Иә, бұл жолы 3 күн жаттықтым.
Dialogue: 0,1:20:30.75,1:20:32.91,Default,,0,0,0,,Оларды бір соққымен жеңу курсымен жүрейік.
Dialogue: 0,1:20:33.00,1:20:35.16,Default,,0,0,0,,Осындай ыңғайлы курс бар ма?
Dialogue: 0,1:20:35.25,1:20:37.62,Default,,0,0,0,,Өзіңіз бара аласыз.
Dialogue: 0,1:20:37.70,1:20:39.41,Default,,0,0,0,,Маған кітапты беріңізші
Dialogue: 0,1:20:40.16,1:20:44.45,Default,,0,0,0,,Бұл жай ғана... үлкенірек нәрсені құрбан ету керек.
Dialogue: 0,1:20:44.54,1:20:46.79,Default,,0,0,0,,Бұл солай емес пе...
Dialogue: 0,1:20:46.87,1:20:50.83,Default,,0,0,0,,Бұл сіз үшін баға жетпес құрбандық болуы мүмкін.
Dialogue: 0,1:20:50.91,1:20:54.12,Default,,0,0,0,,Күдікті адамдар үнемі осылай айтады...
Dialogue: 0,1:20:55.41,1:20:57.12,Default,,0,0,0,,дегеніміз не?
Dialogue: 0,1:20:57.91,1:20:59.37,Default,,0,0,0,,Құрбан шалу
Dialogue: 0,1:21:03.25,1:21:06.54,Default,,0,0,0,,Мен оның Кимун Камуимен тең болатынын ешқашан күткен емеспін...
Dialogue: 0,1:21:06.62,1:21:08.50,Default,,0,0,0,,Кобаяши мен Канна ше?
Dialogue: 0,1:21:08.58,1:21:10.58,Default,,0,0,0,,Ніл өзенінің батыс жағалауындағы қиын өткелі бар шатқалдың тереңінде —
Dialogue: 0,1:21:16.66,1:21:18.45,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:18.54,1:21:19.95,Default,,0,0,0,,Айдаһар шары...?
Dialogue: 0,1:21:20.04,1:21:21.54,Default,,0,0,0,,Бұл айдаһар шары ма?
Dialogue: 0,1:21:21.62,1:21:23.75,Default,,0,0,0,,Бірақ бұл өлшем қандай?
Dialogue: 0,1:21:23.83,1:21:29.58,Default,,0,0,0,,Тіпті он мыңдаған сиқыршылар айдаһар шарын құрғату үшін күш қолданса да,
Dialogue: 0,1:21:29.66,1:21:32.20,Default,,0,0,0,,Бұл соншалықты үлкен болмаса да...
Dialogue: 0,1:21:32.91,1:21:34.45,Default,,0,0,0,,Жоқ, күте тұрыңыз...
Dialogue: 0,1:21:34.54,1:21:35.83,Default,,0,0,0,,Күте тұрыңыз, эй!
Dialogue: 0,1:21:35.91,1:21:37.45,Default,,0,0,0,,Ол таусылады!
Dialogue: 0,1:21:37.54,1:21:39.75,Default,,0,0,0,,Қаншама талант
Dialogue: 0,1:21:39.83,1:21:43.41,Default,,0,0,0,,Сіз оны дәл осы сәт үшін құрбан етуге дайынсыз ба?
Dialogue: 0,1:21:43.50,1:21:46.45,Default,,0,0,0,,Сіз өмір бойы сиқырды пайдалана алмайсыз!
Dialogue: 0,1:21:47.00,1:21:49.62,Default,,0,0,0,,Ал, жұмыста пайдаланбайтын заттар.
Dialogue: 0,1:21:49.70,1:21:52.08,Default,,0,0,0,,Мен бұл біраз ысырап сияқты сезінемін.
Dialogue: 0,1:21:52.16,1:21:53.41,Default,,0,0,0,,Бұл жеткілікті, солай емес пе?
Dialogue: 0,1:21:54.04,1:21:56.91,Default,,0,0,0,,Балаңызды жылататын ата-ананы қалай ұру керек
Dialogue: 0,1:21:57.00,1:22:00.00,Default,,0,0,0,,Түсіндім, сенің айтқың келгені осы!
Dialogue: 0,1:22:02.83,1:22:04.70,Default,,0,0,0,,Менде бар нәрсені сақтаймын!
Dialogue: 0,1:22:04.79,1:22:05.70,Default,,0,0,0,,Мен де!
Dialogue: 0,1:22:05.79,1:22:09.08,Default,,0,0,0,,Маған рұқсат етіңіз! Бәрін өшір!
Dialogue: 0,1:22:15.04,1:22:18.12,Default,,0,0,0,,(сәулелену дыбысы)
Dialogue: 0,1:22:18.20,1:22:19.58,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:22:19.66,1:22:22.16,Default,,0,0,0,,Кім...? Қайдан...
Dialogue: 0,1:22:22.25,1:22:23.91,Default,,0,0,0,,Тор жинақталған сияқты!
Dialogue: 0,1:22:24.00,1:22:26.33,Default,,0,0,0,,Сосын Тор бұны оған берді...
Dialogue: 0,1:22:26.41,1:22:28.12,Default,,0,0,0,,Иә! Кобаяши-сан, кеттік!
Dialogue: 0,1:22:28.20,1:22:30.37,Default,,0,0,0,,- (Кобаяши) Иә? -(Тор) Телепорт!
Dialogue: 0,1:22:30.45,1:22:32.41,Default,,0,0,0,,Эй... (телепортация дыбысы)
Dialogue: 0,1:22:33.25,1:22:34.62,Default,,0,0,0,,Ах...
Dialogue: 0,1:22:38.91,1:22:40.37,Default,,0,0,0,,(сыртқы дыбыс)
Dialogue: 0,1:22:41.20,1:22:42.04,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,1:22:42.83,1:22:44.58,Default,,0,0,0,,Эй... бұл қайда?
Dialogue: 0,1:22:45.83,1:22:46.95,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,1:22:47.04,1:22:49.00,Default,,0,0,0,,Күте тұрыңыз! асылу! асылу!
Dialogue: 0,1:22:49.08,1:22:51.95,Default,,0,0,0,,Уау!
Dialogue: 0,1:22:52.04,1:22:54.00,Default,,0,0,0,,Деяаааааааааааа!
Dialogue: 0,1:22:54.08,1:22:55.20,Default,,0,0,0,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,1:22:57.58,1:22:58.41,Default,,0,0,0,,Хмф!
Dialogue: 0,1:23:03.87,1:23:05.00,Default,,0,0,0,,Хмф! сәуле!
Dialogue: 0,1:23:05.08,1:23:07.25,Default,,0,0,0,,Ааах, жаным-ай!
Dialogue: 0,1:23:14.08,1:23:15.25,Default,,0,0,0,,(айналмалы дыбыс)
Dialogue: 0,1:23:15.33,1:23:16.91,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:23:18.08,1:23:19.00,Default,,0,0,0,,Хмм...
Dialogue: 0,1:23:19.08,1:23:20.25,Default,,0,0,0,,Хохохохо...
Dialogue: 0,1:23:20.33,1:23:21.50,Default,,0,0,0,,Ачуу ачуу...
Dialogue: 0,1:23:21.58,1:23:23.58,Default,,0,0,0,,-(Кәрі пері) Хохохохо... -(Пери қыз) Ачо, ачо...
Dialogue: 0,1:23:30.91,1:23:32.00,Default,,0,0,0,,Мен...
Dialogue: 0,1:23:32.54,1:23:36.08,Default,,0,0,0,,Кобаяши мен Тор-сама
Dialogue: 0,1:23:36.16,1:23:38.50,Default,,0,0,0,,Сайкава мен Ируру
Dialogue: 0,1:23:38.58,1:23:40.50,Default,,0,0,0,,Мектептегі достар
Dialogue: 0,1:23:41.54,1:23:44.87,Default,,0,0,0,,Жарайды, өйткені бәрі осында...
Dialogue: 0,1:23:47.04,1:23:48.25,Default,,0,0,0,,Уайымдамаңыз...
Dialogue: 0,1:23:48.33,1:23:50.66,Default,,0,0,0,,Мен мұндай әкені білмеймін...
Dialogue: 0,1:23:52.54,1:23:55.20,Default,,0,0,0,,(көз жасының дыбысы)
Dialogue: 0,1:23:59.16,1:24:04.95,Default,,0,0,0,,Сен бейбақ!
Dialogue: 0,1:24:10.54,1:24:15.12,Default,,0,0,0,,Ууууууу!
Dialogue: 0,1:24:25.62,1:24:29.04,Default,,0,0,0,,(хит дыбысы)
Dialogue: 0,1:24:29.12,1:24:32.20,Default,,0,0,0,,(фокусталған дыбыс)
Dialogue: 0,1:24:36.75,1:24:42.45,Default,,0,0,0,,(Кеңейту энергиясының дыбысы)
Dialogue: 0,1:24:42.54,1:24:45.75,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:24:45.83,1:24:47.54,Default,,0,0,0,,Ой...
Dialogue: 0,1:24:47.62,1:24:50.50,Default,,0,0,0,,(Кимун Камуидің арылдаған дауысы)
Dialogue: 0,1:24:52.50,1:24:56.16,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,1:25:09.70,1:25:12.58,Default,,0,0,0,,Кимун Камуйге бір оқ...
Dialogue: 0,1:25:12.66,1:25:13.54,Default,,0,0,0,,Кобаяши күткендей...
Dialogue: 0,1:25:13.62,1:25:17.08,Default,,0,0,0,,Кім кенеттен сонша биікке секіреді?
Dialogue: 0,1:25:17.16,1:25:20.37,Default,,0,0,0,,Не? Жоқ, Кобаяши мырзаның қолынан келе ме деп ойлаймын...
Dialogue: 0,1:25:20.45,1:25:23.12,Default,,0,0,0,,Сен істей аласың ба, ақымақ!
Dialogue: 0,1:25:23.91,1:25:25.62,Default,,0,0,0,,Замамиро
Dialogue: 0,1:25:28.41,1:25:30.87,Default,,0,0,0,,Мен тек жекпе-жекке қызығамын
Dialogue: 0,1:25:30.95,1:25:33.37,Default,,0,0,0,,Оңай алданады
Dialogue: 0,1:25:33.45,1:25:35.37,Default,,0,0,0,,Қолданылуда…
Dialogue: 0,1:25:36.20,1:25:37.37,Default,,0,0,0,,Қараңызшы!
Dialogue: 0,1:25:37.45,1:25:41.16,Default,,0,0,0,,(жаңғырық дауыс)
Dialogue: 0,1:25:44.87,1:25:47.62,Default,,0,0,0,,Шынымен...
Dialogue: 0,1:25:47.70,1:25:49.91,Default,,0,0,0,,Сіз есін жия алдыңыз ба?
Dialogue: 0,1:25:50.00,1:25:53.62,Default,,0,0,0,,Ортасынан бұлыңғыр естеліктерім бар...
Dialogue: 0,1:25:53.70,1:25:57.33,Default,,0,0,0,,Мен сені жеңеді деп ешқашан ойламаппын.
Dialogue: 0,1:25:57.41,1:25:59.12,Default,,0,0,0,,Ол таңқаларлықтай жақсы көрінеді.
Dialogue: 0,1:25:59.20,1:26:01.50,Default,,0,0,0,,Жоқ, тұрмаңыз.
Dialogue: 0,1:26:01.58,1:26:04.70,Default,,0,0,0,,Мен бірінші рет бір оқпен өлтірілдім.
Dialogue: 0,1:26:04.79,1:26:06.41,Default,,0,0,0,,Бұл үлкен мәселе
Dialogue: 0,1:26:06.50,1:26:09.12,Default,,0,0,0,,Менің істегенім көп емес.
Dialogue: 0,1:26:09.20,1:26:12.83,Default,,0,0,0,,Жеңіске жетсем, ішу тойында мақтанамын.
Dialogue: 0,1:26:12.91,1:26:16.79,Default,,0,0,0,,(түрлендіру дыбысы)
Dialogue: 0,1:26:17.83,1:26:19.29,Default,,0,0,0,,Мен түсінбеймін...
Dialogue: 0,1:26:19.95,1:26:22.79,Default,,0,0,0,,Осы уақытқа дейін қалай жеттіңіз?
Dialogue: 0,1:26:23.58,1:26:26.29,Default,,0,0,0,,Бұл сіздің досыңыз Канна үшін бе?
Dialogue: 0,1:26:26.37,1:26:28.62,Default,,0,0,0,,Олар бір түр болмаса да...
Dialogue: 0,1:26:29.58,1:26:31.79,Default,,0,0,0,,Канна сенікі ме?
Dialogue: 0,1:26:33.29,1:26:34.79,Default,,0,0,0,,Мен...
Dialogue: 0,1:26:35.58,1:26:37.20,Default,,0,0,0,,Біз доспыз.
Dialogue: 0,1:26:37.29,1:26:40.16,Default,,0,0,0,,Сіз оңай жауап бермейсіз бе?
Dialogue: 0,1:26:40.79,1:26:43.16,Default,,0,0,0,,Мен бұл туралы көп ойладым.
Dialogue: 0,1:26:43.25,1:26:45.50,Default,,0,0,0,,Мен ата-ана болған дұрыс шығар деп ойладым.
Dialogue: 0,1:26:46.95,1:26:49.20,Default,,0,0,0,,Бірақ мен әлі де...
Dialogue: 0,1:26:49.29,1:26:52.12,Default,,0,0,0,,Мен ата-ана ретінде әрекет ете аламын, бірақ мен жай ғана доспын.
Dialogue: 0,1:26:52.20,1:26:54.91,Default,,0,0,0,,Сол үшін өміріңді қатерге тіктің бе?
Dialogue: 0,1:26:55.58,1:26:57.91,Default,,0,0,0,,Сіз ішуді жақсырақ аласыз.
Dialogue: 0,1:26:58.66,1:27:01.91,Default,,0,0,0,,Сонда... түсіндім.
Dialogue: 0,1:27:02.83,1:27:06.79,Default,,0,0,0,,Олай болса, дәмдірек етіп жасай аласыз ба?
Dialogue: 0,1:27:15.25,1:27:17.00,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,1:27:25.41,1:27:26.91,Default,,0,0,0,,Неліктен...
Dialogue: 0,1:27:27.00,1:27:28.20,Default,,0,0,0,,Неге...
Dialogue: 0,1:27:28.29,1:27:32.12,Default,,0,0,0,,Мен... Жаңа ғана айдаһарларға қайта оралдым!
Dialogue: 0,1:27:32.20,1:27:33.04,Default,,0,0,0,,Ха!
Dialogue: 0,1:27:39.62,1:27:42.04,Default,,0,0,0,,Сіз қателеспейсіз
Dialogue: 0,1:27:43.62,1:27:47.29,Default,,0,0,0,,Дегенмен, мен таңдағанның бәрі дұрыс болды.
Dialogue: 0,1:27:47.87,1:27:52.16,Default,,0,0,0,,Сондықтан бұл жалғауды дұрыс деп қабылдауымыз керек.
Dialogue: 0,1:27:52.25,1:27:53.58,Default,,0,0,0,,Менің уақытымда!
Dialogue: 0,1:27:53.66,1:27:57.25,Default,,0,0,0,,Ондай адам болған жоқ! Мені құтқаратын ешкім жоқ!
Dialogue: 0,1:27:57.33,1:28:01.37,Default,,0,0,0,,Мені айдаһардан алыңыз! Менің әпкемді кім қорғайды?
Dialogue: 0,1:28:02.37,1:28:05.75,Default,,0,0,0,,Дұрыс, сені қорғайтын ешкім жоқ.
Dialogue: 0,1:28:05.83,1:28:07.87,Default,,0,0,0,,Енді біз айдаһарды жеңдік
Dialogue: 0,1:28:07.95,1:28:10.62,Default,,0,0,0,,Мен құтқарушы бола алмаймын
Dialogue: 0,1:28:11.45,1:28:15.12,Default,,0,0,0,,Сосын сенің құтқарушың келді
Dialogue: 0,1:28:15.20,1:28:16.20,Default,,0,0,0,,Ха!
Dialogue: 0,1:28:18.91,1:28:19.91,Default,,0,0,0,,(буын дыбысы)
Dialogue: 0,1:28:21.25,1:28:22.75,Default,,0,0,0,,Бітті
Dialogue: 0,1:28:24.54,1:28:26.12,Default,,0,0,0,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,1:28:26.75,1:28:28.04,Default,,0,0,0,,Мен күресемін!
Dialogue: 0,1:28:28.91,1:28:30.16,Default,,0,0,0,,Ұрыс!
Dialogue: 0,1:28:31.91,1:28:37.04,Default,,0,0,0,,Ууууууууууууууууууу!
Dialogue: 0,1:28:37.12,1:28:37.95,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,1:28:43.08,1:28:47.87,Default,,0,0,0,,Кобаяшимен бірге тұру керек.
Dialogue: 0,1:28:51.12,1:28:56.04,Default,,0,0,0,,Қандай жағдай болса да, мен сен қалағандай бола алмаймын.
Dialogue: 0,1:28:57.12,1:28:58.20,Default,,0,0,0,,Я...
Dialogue: 0,1:29:01.83,1:29:05.33,Default,,0,0,0,,Жетер, Кобаяши... үйге қайт.
Dialogue: 0,1:29:05.41,1:29:06.41,Default,,0,0,0,,(Изуна) Ә? (Сора) Қашан?
Dialogue: 0,1:29:21.25,1:29:22.33,Default,,0,0,0,,Хмм...
Dialogue: 0,1:29:24.00,1:29:26.87,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,1:29:33.12,1:29:34.79,Default,,0,0,0,,Кеттік
Dialogue: 0,1:29:34.87,1:29:35.91,Default,,0,0,0,,Ах...
Dialogue: 0,1:29:51.70,1:29:53.00,Default,,0,0,0,,Ах...
Dialogue: 0,1:30:16.45,1:30:20.45,Default,,0,0,0,,(мүлдем жарқыраған дыбыс)
Dialogue: 0,1:30:37.16,1:30:41.16,Default,,0,0,0,,(Каннаның ауыр тыныс алуы)
Dialogue: 0,1:31:01.95,1:31:03.66,Default,,0,0,0,,<Эрен басынан бері мүлде өзгерген жоқ. ➡
Dialogue: 0,1:31:03.75,1:31:06.41,Default,,0,0,0,,Мен ұзақ уақыт жалғыздықта болдым ...
Dialogue: 0,1:31:10.79,1:31:13.83,Default,,0,0,0,,Мен сондай жалғыз болдым!
Dialogue: 0,1:31:13.91,1:31:17.00,Default,,0,0,0,,Мен жалғыз болдым! Бұл жалғыздық болды!
Dialogue: 0,1:31:17.08,1:31:19.16,Default,,0,0,0,,Мен жалғыз болдым!
Dialogue: 0,1:31:19.70,1:31:24.33,Default,,0,0,0,,Жалғыз болды... Жалғыз болды...
Dialogue: 0,1:31:25.16,1:31:28.50,Default,,0,0,0,,(Каннаның айқайы)
Dialogue: 0,1:32:01.50,1:32:03.00,Default,,0,0,0,,…Осылайша мен осы сұмдыққа ат қойдым
Dialogue: 0,1:32:03.91,1:32:06.79,Default,,0,0,0,,Мен өзімді жалғыз сезінемін...
Dialogue: 0,1:32:14.20,1:32:15.12,Default,,0,0,0,,Хмф!
Dialogue: 0,1:32:18.50,1:32:20.33,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,1:32:31.12,1:32:35.25,Default,,0,0,0,,Енді бұл әбігер аяқталды.
Dialogue: 0,1:32:35.33,1:32:38.25,Default,,0,0,0,,(жарқыраған дыбыс)
Dialogue: 0,1:32:40.33,1:32:41.45,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:41.54,1:32:43.08,Default,,0,0,0,,Біз не істеп жатырмыз...?
Dialogue: 0,1:32:43.16,1:32:44.29,Default,,0,0,0,,Хмм…
Dialogue: 0,1:32:44.37,1:32:46.62,Default,,0,0,0,,- (Люминас) Ах... - (Фафнир) Байқадың ба?
Dialogue: 0,1:32:51.50,1:32:53.29,Default,,0,0,0,,Жарайсың Тор
Dialogue: 0,1:32:54.83,1:32:56.00,Default,,0,0,0,,Ой-ау!
Dialogue: 0,1:32:56.08,1:32:57.37,Default,,0,0,0,,Иә.
Dialogue: 0,1:33:03.04,1:33:06.04,Default,,0,0,0,,Мен сенің сиқырлы ыдысыңды соруға рұқсат етемін.
Dialogue: 0,1:33:06.12,1:33:10.00,Default,,0,0,0,,Алайда... көп нәрсе қалмаған сияқты.
Dialogue: 0,1:33:10.75,1:33:13.08,Default,,0,0,0,,Енді сіз басқа адамсыз.
Dialogue: 0,1:33:13.66,1:33:16.87,Default,,0,0,0,,Себебі Канна оны маған аяқталмай әкелді...
Dialogue: 0,1:33:16.95,1:33:18.70,Default,,0,0,0,,Мен оның орнын толтырдым.
Dialogue: 0,1:33:19.25,1:33:23.50,Default,,0,0,0,,Егер сіз осы уақытқа дейін оқыған болсаңыз, сіз үлкен мәселе болуыңыз керек ... Кобаяши.
Dialogue: 0,1:33:24.41,1:33:27.33,Default,,0,0,0,,Канна әкесін тастамады.
Dialogue: 0,1:33:27.41,1:33:30.37,Default,,0,0,0,,Кобаяши мырза Каннадан бас тартпады.
Dialogue: 0,1:33:31.16,1:33:33.87,Default,,0,0,0,,Сіз сол сезімдерден жеңілдіңіз.
Dialogue: 0,1:33:34.54,1:33:36.20,Default,,0,0,0,,Бұл клише...
Dialogue: 0,1:33:36.75,1:33:39.41,Default,,0,0,0,,Тіпті мұндай нәрсе орындалмаса да
Dialogue: 0,1:33:39.50,1:33:41.87,Default,,0,0,0,,Мен сенбеймін...
Dialogue: 0,1:33:42.79,1:33:46.20,Default,,0,0,0,,Менің ойымша, бұл процестің тағы бір бөлігі ғана.
Dialogue: 0,1:33:46.29,1:33:47.12,Default,,0,0,0,,Не?
Dialogue: 0,1:33:47.20,1:33:49.04,Default,,0,0,0,,Мен өлгенше...
Dialogue: 0,1:33:49.12,1:33:51.04,Default,,0,0,0,,Бұл идея соңғы мақсат болып табылады
Dialogue: 0,1:33:51.12,1:33:52.75,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,1:33:53.41,1:33:56.79,Default,,0,0,0,,Сенбейтін нәрсе сенуге айналады
Dialogue: 0,1:33:56.87,1:34:00.75,Default,,0,0,0,,Ойымды өзгерттім, қайттым, қайта өзгерттім...
Dialogue: 0,1:34:00.83,1:34:04.16,Default,,0,0,0,,Өмірдің соңына дейін жалғасады...
Dialogue: 0,1:34:05.41,1:34:06.83,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,1:34:06.91,1:34:08.08,Default,,0,0,0,,Мынаны есте сақта: негізінен, демонның күші ол жеген адамдар санына байланысты анықталады.
Dialogue: 0,1:34:08.16,1:34:12.04,Default,,0,0,0,,Айдаһардың өз ойын оңай өзгертуі мүмкін емес!
Dialogue: 0,1:34:12.12,1:34:15.16,Default,,0,0,0,,Олар сіздің ойыңызды білгісі келмейді!
Dialogue: 0,1:34:15.25,1:34:19.45,Default,,0,0,0,,Дәл Кимун Камуи өз қызына мән бермеген сияқты!
Dialogue: 0,1:34:19.54,1:34:22.87,Default,,0,0,0,,Оны әдеттегідей кемсітіп айтуға болады.
Dialogue: 0,1:34:22.95,1:34:26.04,Default,,0,0,0,,Сіз төмен және ақымақ адамсыз!
Dialogue: 0,1:34:26.12,1:34:29.95,Default,,0,0,0,,Тоқта, қайда бара жатырсың! Маған соңғы соққыны бермейсіз бе?
Dialogue: 0,1:34:30.04,1:34:32.41,Default,,0,0,0,,Мен бұл істі Кимун Камуиге қалдырамын.
Dialogue: 0,1:34:32.95,1:34:37.45,Default,,0,0,0,,Сіз енді қозғала алмайсыз және қайтадан сиқырды пайдалана алмайсыз.
Dialogue: 0,1:34:38.12,1:34:39.50,Default,,0,0,0,,Және...
Dialogue: 0,1:34:40.20,1:34:43.58,Default,,0,0,0,,Кобаяши мырза сізге оны өлтірмеңіз дейтін шығар.
Dialogue: 0,1:34:45.00,1:34:46.45,Default,,0,0,0,,Кобаяши…
Dialogue: 0,1:34:47.58,1:34:49.83,Default,,0,0,0,,Ол не деді...
Dialogue: 0,1:34:49.91,1:34:51.62,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:34:52.37,1:34:55.95,Default,,0,0,0,,Менің ойымды өзгерткен ол.
Dialogue: 0,1:34:56.04,1:35:00.45,Default,,0,0,0,,Ұзақ, ұзақ өмір жолында болған мүмкіндіктер...
Dialogue: 0,1:35:00.54,1:35:04.95,Default,,0,0,0,,Сіз де осындай адамды кездестіре аласыз деп үміттенемін.
Dialogue: 0,1:35:11.00,1:35:12.16,Default,,0,0,0,,(Киришима) Сенпай Амагири жақсы жүр ме екен?
Dialogue: 0,1:35:12.95,1:35:14.20,Default,,0,0,0,,Уг!?
Dialogue: 0,1:35:14.91,1:35:16.37,Default,,0,0,0,,Уг!?
Dialogue: 0,1:35:17.33,1:35:18.79,Default,,0,0,0,,Уг!?
Dialogue: 0,1:35:26.45,1:35:27.29,Default,,0,0,0,,Сәлем
Dialogue: 0,1:35:28.91,1:35:31.25,Default,,0,0,0,,Көруші болу қиын.
Dialogue: 0,1:35:31.33,1:35:32.79,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:35:34.04,1:35:38.54,Default,,0,0,0,,Жоқ, бұл жолы мен өзімді сәл жақсы сезінемін...
Dialogue: 0,1:35:39.83,1:35:41.29,Default,,0,0,0,,Иә
Dialogue: 0,1:35:42.25,1:35:44.66,Default,,0,0,0,,Оның орнына, қараңыз.
Dialogue: 0,1:35:45.50,1:35:46.95,Default,,0,0,0,,- (Кобаяши) Сізге көп рахмет - Жоқ, жоқ.
Dialogue: 0,1:35:46.95,1:35:48.45,Default,,0,0,0,,- (Кобаяши) Сізге көп рахмет - Жоқ, жоқ.
Dialogue: 0,1:35:46.95,1:35:48.45,Default,,0,0,0,,Кобаяши-сан!
Dialogue: 0,1:35:48.45,1:35:48.54,Default,,0,0,0,,Кобаяши-сан!
Dialogue: 0,1:35:48.54,1:35:49.37,Default,,0,0,0,,Кобаяши-сан!
Dialogue: 0,1:35:48.54,1:35:49.37,Default,,0,0,0,,Иә?
Dialogue: 0,1:35:49.45,1:35:51.54,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:35:56.91,1:35:58.04,Default,,0,0,0,,Үйге барасыз ба?
Dialogue: 0,1:35:59.45,1:36:00.29,Default,,0,0,0,,Иә...
Dialogue: 0,1:36:00.37,1:36:01.45,Default,,0,0,0,,Иә?
Dialogue: 0,1:36:02.41,1:36:03.50,Default,,0,0,0,,Иә?
Dialogue: 0,1:36:05.70,1:36:07.12,Default,,0,0,0,,Канна ше?
Dialogue: 0,1:36:11.41,1:36:13.95,Default,,0,0,0,,(жылау)
Dialogue: 0,1:36:14.04,1:36:15.62,Default,,0,0,0,,Канна сааан!
Dialogue: 0,1:36:15.70,1:36:17.41,Default,,0,0,0,,Сайкава, сабыр ет.
Dialogue: 0,1:36:17.50,1:36:21.37,Default,,0,0,0,,Ируру мырза, Канна мырза қайда кетті?
Dialogue: 0,1:36:21.45,1:36:23.08,Default,,0,0,0,,Мен сенің қайтып келетініңе сенімдімін
Dialogue: 0,1:36:23.16,1:36:26.58,Default,,0,0,0,,Шынымен бе? Оған дейін осында тұра аламын ба?
Dialogue: 0,1:36:26.66,1:36:29.70,Default,,0,0,0,,Бұл... Мен Кобаяшиден сұрауым керек...
Dialogue: 0,1:36:29.79,1:36:32.08,Default,,0,0,0,,(Сайкаваның жылауы)
Dialogue: 0,1:36:32.16,1:36:33.00,Default,,0,0,0,,- (Сайкава) Ха! -Аа...
Dialogue: 0,1:36:33.08,1:36:35.45,Default,,0,0,0,,Мен үйдемін~ Ируру, мен үйде болудан шаршадым...
Dialogue: 0,1:36:35.54,1:36:37.70,Default,,0,0,0,,- (Сайкава) Канна Сааан! - (Кобаяши) Уау!
Dialogue: 0,1:36:37.79,1:36:39.12,Default,,0,0,0,,Сайкава мырза?
Dialogue: 0,1:36:39.20,1:36:41.58,Default,,0,0,0,,Мәңгі осылай болды.
Dialogue: 0,1:36:41.66,1:36:43.37,Default,,0,0,0,,Жақсы жұмыс Ируру
Dialogue: 0,1:36:43.45,1:36:44.91,Default,,0,0,0,,Сонда Канна ше?
Dialogue: 0,1:36:45.00,1:36:47.41,Default,,0,0,0,,Иә, Канна қайда?
Dialogue: 0,1:36:47.50,1:36:50.08,Default,,0,0,0,,Ал, Канна-чан...
Dialogue: 0,1:36:52.66,1:36:55.87,Default,,0,0,0,,Канна-чан қазірдің өзінде...
Dialogue: 0,1:36:58.45,1:36:59.75,Default,,0,0,0,,Өтірік…
Dialogue: 0,1:37:01.50,1:37:04.58,Default,,0,0,0,,Бұл өтірік! Себебі Канна-сан айтты!
Dialogue: 0,1:37:04.66,1:37:09.08,Default,,0,0,0,,Мен қайтемін дедім... Қайтып келе жатырмын!
Dialogue: 0,1:37:13.25,1:37:14.95,Default,,0,0,0,,Богема!
Dialogue: 0,1:37:15.04,1:37:16.75,Default,,0,0,0,,Уау! Бұл қандай дауыс?
Dialogue: 0,1:37:16.83,1:37:19.66,Default,,0,0,0,,- (Курамото) Бұл шықты. Ол шықты, солай ма? -(Курода) Сондықтан бұл қалалық аңыз...
Dialogue: 0,1:37:19.75,1:37:22.00,Default,,0,0,0,,Мен әлі қоңырау шалған жоқпын.
Dialogue: 0,1:37:22.08,1:37:23.91,Default,,0,0,0,,Тез қоңырау шалыңыз!
Dialogue: 0,1:37:23.91,1:37:24.25,Default,,0,0,0,,Жарайды, маған тез қоңырау шалыңыз!
Dialogue: 0,1:37:23.91,1:37:24.25,Default,,0,0,0,,Хехехе
Dialogue: 0,1:37:24.25,1:37:24.33,Default,,0,0,0,,Хехехе
Dialogue: 0,1:37:24.33,1:37:25.08,Default,,0,0,0,,Хехехе
Dialogue: 0,1:37:24.33,1:37:25.08,Default,,0,0,0,,Астық
Dialogue: 0,1:37:25.08,1:37:25.79,Default,,0,0,0,,Астық
Dialogue: 0,1:37:26.87,1:37:29.37,Default,,0,0,0,,Мен әрқашан осында болдым
Dialogue: 0,1:37:30.54,1:37:34.41,Default,,0,0,0,,Сіз бұл сәтті тек бірге бола алатын адаммен өткізе аласыз.
Dialogue: 0,1:37:35.62,1:37:38.83,Default,,0,0,0,,Маған анда-санда келіп тұрсаң, жарайды.
Dialogue: 0,1:37:39.41,1:37:42.54,Default,,0,0,0,,Мен сенімен кездесіп тұрамын.
Dialogue: 0,1:37:49.91,1:37:51.66,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,1:37:52.83,1:37:54.54,Default,,0,0,0,,Канна-сан…
Dialogue: 0,1:38:12.83,1:38:13.91,Default,,0,0,0,,Хехе
Dialogue: 0,1:38:15.91,1:38:17.04,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,1:38:17.12,1:38:19.91,Default,,0,0,0,,Жарайды, мен сенемін.
Dialogue: 0,1:38:22.83,1:38:24.62,Default,,0,0,0,,Мен сенімен қала аламын ба?
Dialogue: 0,1:38:24.70,1:38:26.62,Default,,0,0,0,,(Сайкаваның ауыр тыныс алуы)
Dialogue: 0,1:38:27.54,1:38:28.58,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:38:28.66,1:38:29.58,Default,,0,0,0,,♬~
Dialogue: 0,1:38:43.45,1:38:44.87,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:38:51.20,1:38:54.62,Default,,0,0,0,,Канна үшін соншалықты алысқа барғаныма сене алар емеспін...
Dialogue: 0,1:38:54.70,1:38:57.50,Default,,0,0,0,,Шынымды айтсам, аздап қызғаншақпын...
Dialogue: 0,1:38:58.91,1:39:02.75,Default,,0,0,0,,Сіз Тор үшін қанша жерге барар едіңіз?
Dialogue: 0,1:39:03.75,1:39:04.75,Default,,0,0,0,,(күрсіну)
Dialogue: 0,1:39:16.20,1:39:18.12,Default,,0,0,0,,Мен ақылы еңбек демалысын аламын.
Dialogue: 0,1:39:20.29,1:39:25.29,Default,,0,0,0,,♪～
Dialogue: 0,1:43:39.83,1:43:44.83,Default,,0,0,0,,～♪
Dialogue: 0,1:43:48.37,1:43:52.87,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,1:43:52.95,1:43:55.08,Default,,0,0,0,,Көкек дегеніміз не?
Dialogue: 0,1:43:55.16,1:43:59.62,Default,,0,0,0,,Сені өсірген ата-ана құстың ұясында
Dialogue: 0,1:43:59.70,1:44:01.87,Default,,0,0,0,,Ол қайтадан жұмыртқалайтын сияқты.
Dialogue: 0,1:44:01.95,1:44:03.58,Default,,0,0,0,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,1:44:03.66,1:44:07.87,Default,,0,0,0,,Мені өсірген анамды, әкемді жақсы көремін.
Dialogue: 0,1:44:12.25,1:44:14.25,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,1:44:15.75,1:44:21.75,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory