Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.41,0:00:02.79,Default,,0,0,0,,Хосши ату!
Dialogue: 0,0:00:02.91,0:00:04.58,Default,,0,0,0,,Ах! (Қыздар В) Қайта серпілу!
Dialogue: 0,0:00:04.75,0:00:05.71,Default,,0,0,0,,Бұзушылық!
Dialogue: 0,0:00:05.83,0:00:08.59,Default,,0,0,0,,Иә? неге?
Dialogue: 0,0:00:08.71,0:00:10.88,Default,,0,0,0,,Дене тәрбиесін жек көретінмін.
Dialogue: 0,0:00:11.76,0:00:14.80,Default,,0,0,0,,Себебі дәрігер мені тоқтатты дегенмен.
Dialogue: 0,0:00:14.97,0:00:17.64,Default,,0,0,0,,Баға мейірімсіз әрқашан 1
Dialogue: 0,0:00:18.39,0:00:20.64,Default,,0,0,0,,Тек табиғи жағдай
Dialogue: 0,0:00:21.02,0:00:23.27,Default,,0,0,0,,Мен ешқашан 1-ден басқа ештеңе алған емеспін.
Dialogue: 0,0:00:23.94,0:00:26.23,Default,,0,0,0,,Сондықтан мен басқа жердемін
Dialogue: 0,0:00:26.35,0:00:29.11,Default,,0,0,0,,Біз өз болмысымызды табуымыз керек
Dialogue: 0,0:00:30.36,0:00:34.40,Default,,0,0,0,,Мен анам екеуміз қиналып жүрген ауруды толық емдейтін дәрі жасағым келеді.
Dialogue: 0,0:00:34.95,0:00:37.95,Default,,0,0,0,,Фармация кафедрасындағы университеттерде 6 жылдық курс бар.
Dialogue: 0,0:00:38.07,0:00:40.70,Default,,0,0,0,,Біз жеке мектепке бара алмаймыз.
Dialogue: 0,0:00:41.04,0:00:45.12,Default,,0,0,0,,Менің шәкіртақым бар, сондықтан мен жақсы оқимын.
Dialogue: 0,0:00:45.25,0:00:48.08,Default,,0,0,0,,Бірақ мен қазіргіден де көп тырысуым керек.
Dialogue: 0,0:00:48.59,0:00:49.42,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:00:49.54,0:00:51.09,Default,,0,0,0,,Барыңды істе, Бенисуэ
Dialogue: 0,0:00:51.59,0:00:52.46,Default,,0,0,0,,Иә
Dialogue: 0,0:00:52.59,0:00:53.42,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:00:56.05,0:00:57.39,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:00:59.89,0:01:01.18,Default,,0,0,0,,(Толық шоғырлану тынысы)
Dialogue: 0,0:01:01.39,0:01:02.52,Default,,0,0,0,,Не? (Токитате) Иә!
Dialogue: 0,0:01:02.64,0:01:03.56,Default,,0,0,0,,Жел!
Dialogue: 0,0:01:04.10,0:01:04.93,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:07.81,0:01:09.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:11.98,0:01:13.15,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:01:13.86,0:01:16.49,Default,,0,0,0,,Жаман! Барлығы жеңілді ме?
Dialogue: 0,0:01:16.61,0:01:19.16,Default,,0,0,0,,Шықпа! Мен оны осы жерден таба алмаймын
Dialogue: 0,0:01:19.49,0:01:20.95,Default,,0,0,0,,Ол әлі де сонда! Өлтір!
Dialogue: 0,0:01:21.08,0:01:22.41,Default,,0,0,0,,Әй... (Ұры D) Әй!
Dialogue: 0,0:01:23.70,0:01:24.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:31.92,0:01:34.84,Default,,0,0,0,,Бірақ бір күні кенеттен...
Dialogue: 0,0:01:37.47,0:01:40.22,Default,,0,0,0,,Құрметті Батыр, мен үш адамды таптым.
Dialogue: 0,0:01:41.93,0:01:43.89,Default,,0,0,0,,Ух... (Синдо) Гросс
Dialogue: 0,0:01:44.47,0:01:47.56,Default,,0,0,0,,Мен үшін мағынасыз болуы керек болатын зорлық-зомбылық
Dialogue: 0,0:01:48.02,0:01:52.36,Default,,0,0,0,,Бұл өмірдегі ең маңызды дағдыға айналды.
Dialogue: 0,0:01:53.27,0:01:55.49,Default,,0,0,0,,Әй, сен мына лашықты көрдің бе?
Dialogue: 0,0:01:55.82,0:01:59.49,Default,,0,0,0,,Алтын заттарыңызды өртеу алдында жинауды ұмытпаңыз.
Dialogue: 0,0:01:59.74,0:02:02.91,Default,,0,0,0,,Уа, бұл керемет!
Dialogue: 0,0:02:03.24,0:02:06.33,Default,,0,0,0,,Біз оны кейінірек бөлеміз, сондықтан оны сол жерде қалдырыңыз.
Dialogue: 0,0:02:06.79,0:02:09.62,Default,,0,0,0,,Аяқтарыңыз құлап бара жатқандай сезім
Dialogue: 0,0:02:11.08,0:02:13.00,Default,,0,0,0,,Жеке тұлғадан алыс...
Dialogue: 0,0:02:16.26,0:02:20.09,Default,,0,0,0,,Тірі қалудың алғы шарттары өзгерді.
Dialogue: 0,0:02:21.22,0:02:23.97,Default,,0,0,0,,Бейбітшіліктің алғы шарты
Dialogue: 0,0:02:32.86,0:02:34.11,Default,,0,0,0,,Мен...
Dialogue: 0,0:02:37.65,0:02:43.66,Default,,0,0,0,,♪〜
Dialogue: 0,0:04:00.44,0:04:06.45,Default,,0,0,0,,〜♪
Dialogue: 0,0:04:11.25,0:04:13.33,Default,,0,0,0,,Тез арада атымды демалуым керек.
Dialogue: 0,0:04:13.46,0:04:15.21,Default,,0,0,0,,Осы жерде лагерь жасайық.
Dialogue: 0,0:04:15.63,0:04:18.21,Default,,0,0,0,,Иә, жақында күн батады.
Dialogue: 0,0:04:22.76,0:04:24.22,Default,,0,0,0,,О, бұл өте дәмді.
Dialogue: 0,0:04:24.55,0:04:26.22,Default,,0,0,0,,Бұл өте дәмді
Dialogue: 0,0:04:26.34,0:04:28.64,Default,,0,0,0,,Жоқ~ Хахаха...
Dialogue: 0,0:04:29.47,0:04:31.31,Default,,0,0,0,,Оны әлі жей алмайсыз ба?
Dialogue: 0,0:04:31.47,0:04:32.89,Default,,0,0,0,,Бір ғана тістеу...
Dialogue: 0,0:04:33.02,0:04:35.81,Default,,0,0,0,,Бұл өрескел болды (Хакозаки) Иә...
Dialogue: 0,0:04:35.98,0:04:37.06,Default,,0,0,0,,(қиғаш дыбыс)
Dialogue: 0,0:04:38.31,0:04:42.82,Default,,0,0,0,,Сол сәт санамда мәңгі сақталып, өшпейді.
Dialogue: 0,0:04:43.24,0:04:45.99,Default,,0,0,0,,Тәбетіңіздің жоқтығына алаңдамаңыз.
Dialogue: 0,0:04:46.41,0:04:49.53,Default,,0,0,0,,Бұл дүниеде мен онша қарным ашпайды.
Dialogue: 0,0:04:49.66,0:04:50.79,Default,,0,0,0,,Мен...
Dialogue: 0,0:04:52.79,0:04:54.66,Default,,0,0,0,,Мен барлығын қорғағым келеді
Dialogue: 0,0:04:55.75,0:04:56.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:57.00,0:05:00.42,Default,,0,0,0,,Менің достарым да, бұл дүниенің адамдары да
Dialogue: 0,0:05:01.34,0:05:04.01,Default,,0,0,0,,Бірақ мен өзімді қорғай да алмаймын
Dialogue: 0,0:05:04.34,0:05:06.05,Default,,0,0,0,,Тек тірек
Dialogue: 0,0:05:06.84,0:05:07.93,Default,,0,0,0,,Бенису…
Dialogue: 0,0:05:09.18,0:05:10.35,Default,,0,0,0,,Бұл жұмыс істемеуі мүмкін.
Dialogue: 0,0:05:13.47,0:05:16.31,Default,,0,0,0,,Бірақ батырға тамақ дайындауға жол берме.
Dialogue: 0,0:05:16.44,0:05:17.73,Default,,0,0,0,,Мен өзімді жайсыз сезінемін.
Dialogue: 0,0:05:17.90,0:05:19.77,Default,,0,0,0,,О, бұл туралы уайымдама
Dialogue: 0,0:05:19.90,0:05:21.48,Default,,0,0,0,,Мен тамақ әзірлеуге жақсымын.
Dialogue: 0,0:05:21.73,0:05:24.24,Default,,0,0,0,,Сіз бәрібір тәжірибе ұпайларын алғыңыз келеді.
Dialogue: 0,0:05:24.69,0:05:26.45,Default,,0,0,0,,Дәреже де 10-ға көтерілді
Dialogue: 0,0:05:26.57,0:05:29.16,Default,,0,0,0,,Енді кәстрөлдер мен ыдыстарды алуға болады.
Dialogue: 0,0:05:29.28,0:05:30.28,Default,,0,0,0,,Дәреже?
Dialogue: 0,0:05:30.70,0:05:33.62,Default,,0,0,0,,Йоцуя-кун, сен өте жақсы көрінесің.
Dialogue: 0,0:05:33.83,0:05:34.70,Default,,0,0,0,,Иә
Dialogue: 0,0:05:34.91,0:05:37.83,Default,,0,0,0,,Соңында басынан бастап күшті дене күші бар адам
Dialogue: 0,0:05:37.96,0:05:41.88,Default,,0,0,0,,Сіз көп деңгейге көтеріліп, бәрін аласыз.
Dialogue: 0,0:05:42.00,0:05:43.09,Default,,0,0,0,,Батыр-сама
Dialogue: 0,0:05:44.17,0:05:45.76,Default,,0,0,0,,А, сіз көбірек алғыңыз келе ме?
Dialogue: 0,0:05:45.88,0:05:47.84,Default,,0,0,0,,Қазір жаттығуды бастайық!
Dialogue: 0,0:05:48.13,0:05:48.97,Default,,0,0,0,,Жаттығу…
Dialogue: 0,0:05:49.59,0:05:51.43,Default,,0,0,0,,Ол маған бұрын сабақ бергенін айтты.
Dialogue: 0,0:05:51.55,0:05:52.81,Default,,0,0,0,,Сіз мұны айттыңыз, солай ма?
Dialogue: 0,0:05:52.93,0:05:53.77,Default,,0,0,0,,О
Dialogue: 0,0:05:54.39,0:05:57.98,Default,,0,0,0,,Мен мүгедек болдым және 100 ойынның үшеуінде ғана жеңе алдым.
Dialogue: 0,0:05:59.10,0:06:01.31,Default,,0,0,0,,Дәлірек айтсақ, ортасынан бастап байыпты болдым.
Dialogue: 0,0:06:01.44,0:06:04.40,Default,,0,0,0,,Өлмей-ақ қиып алуды жалғастыр
Dialogue: 0,0:06:05.03,0:06:06.74,Default,,0,0,0,,Мен бұл тозақ деп ойладым
Dialogue: 0,0:06:06.86,0:06:09.49,Default,,0,0,0,,Тш, өлмесеңше...
Dialogue: 0,0:06:10.03,0:06:12.28,Default,,0,0,0,,Енді ойлап қарасам, көмекке келгенде...
Dialogue: 0,0:06:12.99,0:06:17.21,Default,,0,0,0,,Сіз төртеуіңізді қылыш үйретуге үйреткенімді қалайсыз!
Dialogue: 0,0:06:17.37,0:06:18.96,Default,,0,0,0,,Егер сіз батырмен айналыссаңыз
Dialogue: 0,0:06:19.08,0:06:23.13,Default,,0,0,0,,Мен байыпты қылыш қолданып, оны кесіп тастасам да, менде проблема жоқ, солай ма?
Dialogue: 0,0:06:24.63,0:06:25.71,Default,,0,0,0,,Ал...
Dialogue: 0,0:06:25.84,0:06:29.05,Default,,0,0,0,,Жоқ, менде басқа нұсқалар жоқ, сондықтан жақсы.
Dialogue: 0,0:06:29.30,0:06:32.47,Default,,0,0,0,,Иә! Енді ет қалауыңызша кесуге болады!
Dialogue: 0,0:06:32.93,0:06:36.52,Default,,0,0,0,,Иә! Үйге барып, әкеңе хабар бер.
Dialogue: 0,0:06:37.64,0:06:39.64,Default,,0,0,0,,Соны айтып қуанып қалдым
Dialogue: 0,0:06:39.77,0:06:41.52,Default,,0,0,0,,Мен уайымдап жүрмін...
Dialogue: 0,0:06:41.65,0:06:42.86,Default,,0,0,0,,Сізден
Dialogue: 0,0:06:42.98,0:06:43.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:44.94,0:06:46.23,Default,,0,0,0,,Сәлем! Шынайы ма?
Dialogue: 0,0:06:46.73,0:06:49.20,Default,,0,0,0,,Мен 5 секундтан кейін шабуыл жасай бастаймын
Dialogue: 0,0:06:49.32,0:06:50.15,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:50.86,0:06:53.91,Default,,0,0,0,,Мен тірі ет кескенді ұнатамын...
Dialogue: 0,0:06:54.66,0:06:56.45,Default,,0,0,0,,Мен оны жақсы көремін!
Dialogue: 0,0:06:56.74,0:06:58.62,Default,,0,0,0,,Қызық, бұл не?
Dialogue: 0,0:06:58.75,0:07:01.87,Default,,0,0,0,,Сырт келбетім жақсы болса да, алшақтық көп емес.
Dialogue: 0,0:07:02.38,0:07:04.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:05.88,0:07:07.80,Default,,0,0,0,,Юка-сан, жақсысың ба?
Dialogue: 0,0:07:08.21,0:07:09.97,Default,,0,0,0,,Бұл ең нашар!
Dialogue: 0,0:07:10.09,0:07:13.43,Default,,0,0,0,,Бұл дүниеде ауырсыну сезімі 1/36 болса да
Dialogue: 0,0:07:13.55,0:07:15.72,Default,,0,0,0,,Өйткенi, кесiп алсаң, бәрiнен кейiн.
Dialogue: 0,0:07:16.31,0:07:17.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:17.68,0:07:20.27,Default,,0,0,0,,Сонымен келесі... (Хокозаки) Хяаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:07:24.61,0:07:28.07,Default,,0,0,0,,Ұзын қылышты да көтере алмайсың ба?
Dialogue: 0,0:07:28.19,0:07:30.07,Default,,0,0,0,,Бұл уақытты алады.
Dialogue: 0,0:07:32.11,0:07:35.74,Default,,0,0,0,,Мен өмір сүрген қазіргі Жапония бейбіт болды.
Dialogue: 0,0:07:37.49,0:07:38.49,Default,,0,0,0,,Не болды!
Dialogue: 0,0:07:39.62,0:07:43.29,Default,,0,0,0,,Макуа отын жинауға кетті, оған гоблиндер шабуыл жасады...
Dialogue: 0,0:07:43.42,0:07:45.38,Default,,0,0,0,,Мен жай ғана сақамды түсірдім.
Dialogue: 0,0:07:45.50,0:07:48.96,Default,,0,0,0,,Гоблин сияқты жараланды ма? Сіз әлі де менің қарамағымдасыз ба?
Dialogue: 0,0:07:49.09,0:07:51.01,Default,,0,0,0,,Сондай-ақ... Кешіріңіз!
Dialogue: 0,0:07:52.76,0:07:56.47,Default,,0,0,0,,Бұл басқа дүниеде бәрі күйреді.
Dialogue: 0,0:08:02.85,0:08:04.60,Default,,0,0,0,,Көптеген сызаттар бар...
Dialogue: 0,0:08:05.77,0:08:08.36,Default,,0,0,0,,Ол емдік сиқырды қолдана алды.
Dialogue: 0,0:08:08.82,0:08:11.32,Default,,0,0,0,,Жасушалық зат алмасуды жеделдету арқылы
Dialogue: 0,0:08:11.78,0:08:14.07,Default,,0,0,0,,Жараның жазылуын тездетеді.
Dialogue: 0,0:08:14.20,0:08:18.20,Default,,0,0,0,,Сондықтан ол адамның регенерация қабілетінен асып кете алмайды.
Dialogue: 0,0:08:18.53,0:08:20.12,Default,,0,0,0,,Дәл солай тағам дайындауға да қатысты.
Dialogue: 0,0:08:20.24,0:08:24.67,Default,,0,0,0,,Тәжірибе ұпайларын ұрыспай-ақ жинай алатыныңыз жасырын емес пе?
Dialogue: 0,0:08:25.37,0:08:28.54,Default,,0,0,0,,Бұл туралы жүйеге шағымданыңыз.
Dialogue: 0,0:08:30.09,0:08:31.59,Default,,0,0,0,,Жүйе…
Dialogue: 0,0:08:32.17,0:08:36.93,Default,,0,0,0,,Бізге мәжбүрленген бұл жүйеден қашып құтыла алмаймыз.
Dialogue: 0,0:08:37.97,0:08:39.10,Default,,0,0,0,,Иә! (Хакозаки) Уф!
Dialogue: 0,0:08:39.31,0:08:41.10,Default,,0,0,0,,Мен барлығын қорғағым келеді
Dialogue: 0,0:08:41.22,0:08:44.02,Default,,0,0,0,,Ол үшін тәжірибе ұпайларын алу керек...
Dialogue: 0,0:08:44.14,0:08:45.02,Default,,0,0,0,,Ахх!
Dialogue: 0,0:08:45.19,0:08:46.94,Default,,0,0,0,,Мен күштірек болуым керек!
Dialogue: 0,0:08:47.15,0:08:49.65,Default,,0,0,0,,Енді сіз көп қозғала аласыз.
Dialogue: 0,0:08:51.48,0:08:55.28,Default,,0,0,0,,Умм... аа!
Dialogue: 0,0:08:55.40,0:08:58.45,Default,,0,0,0,,Ұзын қылыш әлі де уақыт алады.
Dialogue: 0,0:08:59.33,0:09:00.66,Default,,0,0,0,,Ах... Эй!
Dialogue: 0,0:09:01.16,0:09:04.25,Default,,0,0,0,,Мен тәжірибе ұпайларын алуым керек...
Dialogue: 0,0:09:04.66,0:09:06.17,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:09:08.04,0:09:09.75,Default,,0,0,0,,Біз гоблиндер ордасын таптық!
Dialogue: 0,0:09:10.42,0:09:11.42,Default,,0,0,0,,Айналмалы жолмен жүргіңіз келе ме?
Dialogue: 0,0:09:11.84,0:09:14.76,Default,,0,0,0,,Жоқ, біз оларды қуып жіберсек тезірек болар еді.
Dialogue: 0,0:09:14.88,0:09:16.01,Default,,0,0,0,,Жоқ
Dialogue: 0,0:09:16.55,0:09:18.22,Default,,0,0,0,,Біз орындаймыз.
Dialogue: 0,0:09:19.64,0:09:24.02,Default,,0,0,0,,Мен соңғы уақытта тәжірибе ұпайларын жинай алмадым, өйткені мен тек жаттығумен айналыстым.
Dialogue: 0,0:09:24.14,0:09:24.98,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:09:25.64,0:09:27.52,Default,,0,0,0,,Емдеу тәжірибе ұпайларын арттырады
Dialogue: 0,0:09:27.65,0:09:28.90,Default,,0,0,0,,Егер ол өліп қалған болса
Dialogue: 0,0:09:29.90,0:09:30.82,Default,,0,0,0,,Қызыл ұшы ше?
Dialogue: 0,0:09:31.02,0:09:31.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:32.02,0:09:33.86,Default,,0,0,0,,Өзіңізді мәжбүрлеудің қажеті жоқ.
Dialogue: 0,0:09:34.07,0:09:35.24,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:09:35.65,0:09:38.41,Default,,0,0,0,,Жарайды, маған ақша табуға рұқсат етіңіз!
Dialogue: 0,0:09:42.95,0:09:46.75,Default,,0,0,0,,Егер бұл гоблиннің өлшемі болса, менің ойымша, ұзын қылыш қажет емес.
Dialogue: 0,0:09:47.04,0:09:48.58,Default,,0,0,0,,Мен әлі де уайымдаймын.
Dialogue: 0,0:09:48.87,0:09:50.33,Default,,0,0,0,,Жарайды, бұл сынақ деп аталғанымен,
Dialogue: 0,0:09:50.46,0:09:51.88,Default,,0,0,0,,Енді мен сені өз қолыммен бөліп-жарып тастауға мәжбүрмін.
Dialogue: 0,0:09:52.00,0:09:53.50,Default,,0,0,0,,Жел! Вуги!
Dialogue: 0,0:09:53.88,0:09:55.46,Default,,0,0,0,,А... а...
Dialogue: 0,0:09:55.59,0:09:56.92,Default,,0,0,0,,Гах!
Dialogue: 0,0:09:57.47,0:09:59.09,Default,,0,0,0,,Угья~!
Dialogue: 0,0:09:59.30,0:10:00.39,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:00.51,0:10:01.64,Default,,0,0,0,,Батыр!
Dialogue: 0,0:10:08.77,0:10:11.15,Default,,0,0,0,,Гах!
Dialogue: 0,0:10:15.28,0:10:16.49,Default,,0,0,0,,…
Dialogue: 0,0:10:21.32,0:10:23.78,Default,,0,0,0,,Ха ха ха... Ах!
Dialogue: 0,0:10:25.20,0:10:26.50,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:28.62,0:10:29.75,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:30.63,0:10:32.67,Default,,0,0,0,,'Otoishi-kun' деп жазып қойыңызшы
Dialogue: 0,0:10:34.00,0:10:35.59,Default,,0,0,0,,Мен Иносукэні құтқарамын
Dialogue: 0,0:10:36.30,0:10:40.18,Default,,0,0,0,,Қанша талпынсам да, онша алға жете алмадым.
Dialogue: 0,0:10:40.93,0:10:44.51,Default,,0,0,0,,Менің ойымша, бұл сіздің жоғары дәрежелі адам болғандықтан шығар.
Dialogue: 0,0:10:44.89,0:10:47.31,Default,,0,0,0,,Бенисуэ: Гоблинді жеңдіңіз бе?
Dialogue: 0,0:10:47.56,0:10:50.19,Default,,0,0,0,,Иә... әйтеуір
Dialogue: 0,0:10:50.31,0:10:51.77,Default,,0,0,0,,Сіз мұны ақырында орындадыңыз!
Dialogue: 0,0:10:51.94,0:10:52.77,Default,,0,0,0,,Иә
Dialogue: 0,0:10:53.23,0:10:55.36,Default,,0,0,0,,Менің қолымда әлі бар...
Dialogue: 0,0:10:57.40,0:11:00.74,Default,,0,0,0,,Сол шымыр сезім
Dialogue: 0,0:11:04.66,0:11:07.33,Default,,0,0,0,,Батыр семсердей оянды.
Dialogue: 0,0:11:07.45,0:11:08.58,Default,,0,0,0,,Мен шынымен бақыттымын
Dialogue: 0,0:11:08.70,0:11:10.29,Default,,0,0,0,,Ахаха... Бірақ!
Dialogue: 0,0:11:10.58,0:11:12.17,Default,,0,0,0,,Е?.. Иә.
Dialogue: 0,0:11:12.50,0:11:16.13,Default,,0,0,0,,Гоблиннің етін өз қолыммен кесіп алмағаным ұят.
Dialogue: 0,0:11:16.38,0:11:17.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:17.84,0:11:18.80,Default,,0,0,0,,Ум...
Dialogue: 0,0:11:19.13,0:11:22.30,Default,,0,0,0,,Неліктен тірі етті кескенді ұнатасың?
Dialogue: 0,0:11:23.05,0:11:24.55,Default,,0,0,0,,Тыңдағаныңызға жарайсың!
Dialogue: 0,0:11:24.68,0:11:26.72,Default,,0,0,0,,Тірі еттің сансыз пайдасы бар!
Dialogue: 0,0:11:27.18,0:11:28.72,Default,,0,0,0,,Біріншіден, бұлшықеттің қаттылығы!
Dialogue: 0,0:11:28.85,0:11:32.02,Default,,0,0,0,,Ұрыс кезінде, қозғалыс кезінде ет бұлшықеттері
Dialogue: 0,0:11:32.14,0:11:35.27,Default,,0,0,0,,Пышақ өткен жерінен кесекпен кесілген.
Dialogue: 0,0:11:35.40,0:11:39.44,Default,,0,0,0,,Сырттан бірте-бірте өлі етке айналу сезімі.
Dialogue: 0,0:11:39.57,0:11:40.57,Default,,0,0,0,,Мыналар!
Dialogue: 0,0:11:40.95,0:11:43.41,Default,,0,0,0,,Қылышты бір сәтте көтеріп, төмен қарай сермеу
Dialogue: 0,0:11:43.53,0:11:46.03,Default,,0,0,0,,Бұл болып жатқан оқиға!
Dialogue: 0,0:11:46.49,0:11:49.12,Default,,0,0,0,,Ал сол кездегі қолдарыңыздың сезімі!
Dialogue: 0,0:11:49.41,0:11:52.16,Default,,0,0,0,,Бұл ең жақсылар!
Dialogue: 0,0:11:52.37,0:11:54.13,Default,,0,0,0,,Ах... (Токит) Жақсы...
Dialogue: 0,0:11:54.25,0:11:56.00,Default,,0,0,0,,Ух... (Синдо) Иә...
Dialogue: 0,0:11:57.75,0:12:00.71,Default,,0,0,0,,Олардың кейбіреулері әлі де қалуы мүмкін.
Dialogue: 0,0:12:00.84,0:12:02.43,Default,,0,0,0,,Мен патрульге шығамын.
Dialogue: 0,0:12:02.55,0:12:03.84,Default,,0,0,0,,Бимсбург Макуа!
Dialogue: 0,0:12:03.97,0:12:04.93,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:05.05,0:12:07.47,Default,,0,0,0,,Сіз етті турап аласыз деп үміттенемін~♪
Dialogue: 0,0:12:07.60,0:12:08.85,Default,,0,0,0,,Қырықша… әрине!
Dialogue: 0,0:12:10.81,0:12:13.94,Default,,0,0,0,,Мен Қаджабельдің әкесінен сұрадым...
Dialogue: 0,0:12:15.65,0:12:19.69,Default,,0,0,0,,Кішкентай кезінде әкесі ағасына семсерді үйреткен.
Dialogue: 0,0:12:19.82,0:12:22.36,Default,,0,0,0,,«Тірі қарсыласпен ауыр шайқас болған кезде».
Dialogue: 0,0:12:22.49,0:12:25.78,Default,,0,0,0,,Мен сіздің «Бұл ең тәжірибелі тәжірибе» деп айтқаныңызды естідім.
Dialogue: 0,0:12:25.91,0:12:28.99,Default,,0,0,0,,Мен өзімді іштей солай өзгерткендей сезінемін.
Dialogue: 0,0:12:29.66,0:12:33.29,Default,,0,0,0,,Менің ойымша, бұл бос ми деп аталады, балаларға тән нәрсе.
Dialogue: 0,0:12:33.62,0:12:34.87,Default,,0,0,0,,Сонымен... бос ми?
Dialogue: 0,0:12:35.00,0:12:36.63,Default,,0,0,0,,Сорамидің ми нұсқасы жоқ
Dialogue: 0,0:12:36.88,0:12:37.71,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:12:45.68,0:12:47.22,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:47.93,0:12:51.81,Default,,0,0,0,,Бірақ мен... барлығын қорғаймын.
Dialogue: 0,0:12:52.85,0:12:56.56,Default,,0,0,0,,Тірі оралып, армандарыңызды орындаңыз
Dialogue: 0,0:12:57.69,0:12:59.36,Default,,0,0,0,,Сонымен мен де...
Dialogue: 0,0:13:01.07,0:13:02.11,Default,,0,0,0,,Мен оны кесуім керек!
Dialogue: 0,0:13:13.70,0:13:15.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:16.12,0:13:18.88,Default,,0,0,0,,Не? Сіз қалай ойлайсыз...
Dialogue: 0,0:13:19.42,0:13:20.42,Default,,0,0,0,,Аха~
Dialogue: 0,0:13:20.54,0:13:21.80,Default,,0,0,0,,Мен оны елемей қалдым ба?
Dialogue: 0,0:13:23.34,0:13:25.72,Default,,0,0,0,,Мен бұған әбден көндім.
Dialogue: 0,0:13:26.05,0:13:28.26,Default,,0,0,0,,Сынып кете жаздады.
Dialogue: 0,0:13:28.59,0:13:29.68,Default,,0,0,0,,Барлығы жақсы ма?
Dialogue: 0,0:13:29.80,0:13:32.14,Default,,0,0,0,,Әйтеуір... (Токит) Мен таң қалдым~
Dialogue: 0,0:13:32.26,0:13:33.47,Default,,0,0,0,,Биммсбург
Dialogue: 0,0:13:33.68,0:13:34.73,Default,,0,0,0,,Мен бірдеңе істеймін
Dialogue: 0,0:13:34.85,0:13:36.14,Default,,0,0,0,,Мен де көмектесемін.
Dialogue: 0,0:13:37.94,0:13:39.06,Default,,0,0,0,,Кеттік
Dialogue: 0,0:13:39.27,0:13:41.94,Default,,0,0,0,,Ичи Нино-сан!
Dialogue: 0,0:13:42.07,0:13:45.40,Default,,0,0,0,,Бұл жүйкеңе тиіп тұр ма? Егер ашуланатын батылың болса, ашулан да.
Dialogue: 0,0:13:47.20,0:13:48.91,Default,,0,0,0,,Сәл көтерілді!
Dialogue: 0,0:13:49.41,0:13:50.87,Default,,0,0,0,,Баяу (синдо) Иә
Dialogue: 0,0:13:51.37,0:13:53.29,Default,,0,0,0,,бірақ ол да маған күдікпен қарады…
Dialogue: 0,0:13:54.95,0:13:57.25,Default,,0,0,0,,Қымбатты батыр, тағы бір дем.
Dialogue: 0,0:13:57.37,0:13:58.21,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:00.71,0:14:02.04,Default,,0,0,0,,Ия, шықты!
Dialogue: 0,0:14:02.34,0:14:03.71,Default,,0,0,0,,Ах... (3 адам) Уау!
Dialogue: 0,0:14:07.97,0:14:09.76,Default,,0,0,0,,Бұл таңқаларлық оңай болды.
Dialogue: 0,0:14:09.89,0:14:12.68,Default,,0,0,0,,Дұрыс (бәрі) хахахаха
Dialogue: 0,0:14:13.01,0:14:15.02,Default,,0,0,0,,Жарайды, тезірек барайық.
Dialogue: 0,0:14:16.06,0:14:17.18,Default,,0,0,0,,Польнарефф?
Dialogue: 0,0:14:17.94,0:14:21.23,Default,,0,0,0,,Қалған уақыт: Шамамен 15 күн 5 сағат
Dialogue: 0,0:14:22.44,0:14:23.86,Default,,0,0,0,,Жай ғана.
Dialogue: 0,0:14:27.28,0:14:29.28,Default,,0,0,0,,Каджабель мырза, мен бір нәрсені көріп тұрмын.
Dialogue: 0,0:14:29.41,0:14:30.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:32.12,0:14:34.83,Default,,0,0,0,,Армияға құбыжықтар шабуыл жасауда.
Dialogue: 0,0:14:35.20,0:14:36.54,Default,,0,0,0,,Қай армия?
Dialogue: 0,0:14:36.66,0:14:39.79,Default,,0,0,0,,Азаматтар да бар... балалар.
Dialogue: 0,0:14:40.79,0:14:41.92,Default,,0,0,0,,Маған көмек керек!
Dialogue: 0,0:14:42.21,0:14:43.17,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:14:43.29,0:14:46.46,Default,,0,0,0,,Уақытым жеткілікті ме, жоқ па, білмеймін.
Dialogue: 0,0:14:46.59,0:14:48.84,Default,,0,0,0,,Мен мүмкіндігінше айналма жолға барғым келмейді.
Dialogue: 0,0:14:52.93,0:14:55.51,Default,,0,0,0,,Олай болса, мені тастап кетуге рұқсат ете аламын ба?
Dialogue: 0,0:14:56.64,0:14:58.56,Default,,0,0,0,,Мен жалғыз барамын, сондықтан
Dialogue: 0,0:14:58.68,0:14:59.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:59.64,0:15:02.19,Default,,0,0,0,,Бір минут күте тұрыңыз, Бенисуе, ойланыңыз.
Dialogue: 0,0:15:02.81,0:15:06.11,Default,,0,0,0,,Тірі қайтып келетініне сенімді емес пе едің?
Dialogue: 0,0:15:06.23,0:15:07.69,Default,,0,0,0,,Егер тазалау қажет болса...
Dialogue: 0,0:15:07.82,0:15:09.03,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:09.40,0:15:11.99,Default,,0,0,0,,Бірақ мен мұны бұрын айтқанмын, солай ма?
Dialogue: 0,0:15:12.11,0:15:12.95,Default,,0,0,0,,Не?
Dialogue: 0,0:15:13.28,0:15:17.24,Default,,0,0,0,,Адамдар өз өмірін сақтап қалғандықтан ғана құтқарылмайды.
Dialogue: 0,0:15:17.37,0:15:18.75,Default,,0,0,0,,Хмм... ой
Dialogue: 0,0:15:19.04,0:15:21.17,Default,,0,0,0,,Мен...
Dialogue: 0,0:15:22.37,0:15:24.08,Default,,0,0,0,,Егер сіз балаларыңызды тастап кетсеңіз
Dialogue: 0,0:15:24.92,0:15:27.17,Default,,0,0,0,,Енді ешқандай мән жоқ.
Dialogue: 0,0:15:27.92,0:15:30.80,Default,,0,0,0,,Сондықтан... мүмкін емес!
Dialogue: 0,0:15:31.51,0:15:32.72,Default,,0,0,0,,Не?
Dialogue: 0,0:15:32.93,0:15:36.93,Default,,0,0,0,,Егер сіз балаңызды тастап кетсеңіз, қалған өміріңіздің мәні жоқ па?
Dialogue: 0,0:15:37.06,0:15:40.14,Default,,0,0,0,,Жоқ, сіз тым кереметсіз.
Dialogue: 0,0:15:40.27,0:15:41.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:42.56,0:15:43.98,Default,,0,0,0,,Бірақ бұл?
Dialogue: 0,0:15:44.15,0:15:46.57,Default,,0,0,0,,Қандай да бір оқиғаның болуы мүмкін бе?
Dialogue: 0,0:15:46.82,0:15:47.90,Default,,0,0,0,,Оқиға?
Dialogue: 0,0:15:48.65,0:15:51.99,Default,,0,0,0,,Сізге көмектескіңіз келетінін білу үшін ойын шебері қарап тұр ма?
Dialogue: 0,0:15:52.11,0:15:56.41,Default,,0,0,0,,Мысалы, сол топтың Радодовоға бару мүмкіндігі.
Dialogue: 0,0:15:56.74,0:15:57.83,Default,,0,0,0,,Ах~
Dialogue: 0,0:15:58.37,0:15:59.20,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:15:59.33,0:16:01.58,Default,,0,0,0,,Ендеше екіге бөлейік.
Dialogue: 0,0:16:01.75,0:16:03.92,Default,,0,0,0,,Хакозаки-сан екеуміз сонда барамыз.
Dialogue: 0,0:16:04.04,0:16:06.59,Default,,0,0,0,,Енді барлығы әрі қарай жүре алады.
Dialogue: 0,0:16:06.75,0:16:08.38,Default,,0,0,0,,Не, біз ажыратамыз ба?
Dialogue: 0,0:16:08.50,0:16:11.34,Default,,0,0,0,,Мен мүмкіндігінше тез барып, тез ораламын.
Dialogue: 0,0:16:11.97,0:16:13.05,Default,,0,0,0,,Жақсы, солай ма?
Dialogue: 0,0:16:13.51,0:16:14.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:18.60,0:16:20.81,Default,,0,0,0,,(Сарбаздардың айқайы)
Dialogue: 0,0:16:21.02,0:16:23.69,Default,,0,0,0,,Бірақ олар дерлік жойылды.
Dialogue: 0,0:16:24.14,0:16:26.15,Default,,0,0,0,,Ахх!
Dialogue: 0,0:16:27.86,0:16:29.07,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:16:29.36,0:16:30.53,Default,,0,0,0,,Уау?
Dialogue: 0,0:16:31.19,0:16:32.65,Default,,0,0,0,,Барлығы осында!
Dialogue: 0,0:16:32.82,0:16:34.78,Default,,0,0,0,,Бұл да батырдың түзетуі ме?
Dialogue: 0,0:16:35.78,0:16:39.45,Default,,0,0,0,,Meri Kobold Koboldidae Қауіп деңгейі Е минус
Dialogue: 0,0:16:39.58,0:16:41.29,Default,,0,0,0,,Патша сарбаздарынан күшті...
Dialogue: 0,0:16:41.41,0:16:44.71,Default,,0,0,0,,Менің айтайын дегенім, сен екеумізді қосқаннан да мықтысың.
Dialogue: 0,0:16:44.87,0:16:47.08,Default,,0,0,0,,Бұл... Батыр-сама ма?
Dialogue: 0,0:16:47.46,0:16:50.00,Default,,0,0,0,,Біз сізді тартамыз, сондықтан артыңыздан келіңіз!
Dialogue: 0,0:16:50.67,0:16:51.92,Default,,0,0,0,,Түсіндім! Түсіндім!
Dialogue: 0,0:16:52.05,0:16:53.51,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:17:00.22,0:17:01.47,Default,,0,0,0,,Сәлем! Уга~!
Dialogue: 0,0:17:02.68,0:17:05.39,Default,,0,0,0,,Ах... уф!
Dialogue: 0,0:17:05.98,0:17:07.52,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:17:07.65,0:17:08.48,Default,,0,0,0,,А...
Dialogue: 0,0:17:11.78,0:17:14.28,Default,,0,0,0,,Бұл мүмкін емес. Олар күші мен саны жағынан басым.
Dialogue: 0,0:17:14.40,0:17:16.66,Default,,0,0,0,,Барлығы бірден бізді көздейді.
Dialogue: 0,0:17:19.74,0:17:21.79,Default,,0,0,0,,Қараңызшы, артқа!
Dialogue: 0,0:17:22.70,0:17:26.00,Default,,0,0,0,,Бұл жұмыс істемейді! Әй, сөйлесе алмағандықтан ба?
Dialogue: 0,0:17:26.12,0:17:27.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:27.88,0:17:28.79,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:17:29.67,0:17:31.25,Default,,0,0,0,,Сен зорлыққа жанын сатқан адамсың деп сену қиын.
Dialogue: 0,0:17:32.46,0:17:34.09,Default,,0,0,0,,Ггаааах!
Dialogue: 0,0:17:36.76,0:17:37.76,Default,,0,0,0,,Қазір!
Dialogue: 0,0:17:37.89,0:17:38.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:40.97,0:17:42.68,Default,,0,0,0,,Артында! Артында!
Dialogue: 0,0:17:45.77,0:17:48.69,Default,,0,0,0,,Мен мұнда не үшін келдім?
Dialogue: 0,0:17:49.02,0:17:51.23,Default,,0,0,0,,Төбелесе алмасаңыз, пайда жоқ
Dialogue: 0,0:18:12.17,0:18:15.42,Default,,0,0,0,,Қайтадан қорғалудың қажеті жоқ.
Dialogue: 0,0:18:41.45,0:18:42.28,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:18:46.75,0:18:48.12,Default,,0,0,0,,Ах~!
Dialogue: 0,0:18:53.13,0:18:56.34,Default,,0,0,0,,Сақтандырар алдында ұзын қылыш шығады.
Dialogue: 0,0:18:56.46,0:18:58.22,Default,,0,0,0,,Оны ұстауға тым ауыр, себебі ол бір сәтке ғана
Dialogue: 0,0:18:58.34,0:19:01.76,Default,,0,0,0,,Кемшіліктерді жеңіп, екі құсты бір оқпен өлтіру?
Dialogue: 0,0:19:02.30,0:19:03.97,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:19:05.97,0:19:08.43,Default,,0,0,0,,Хакозаки мырза, мінезіңіз өзгерді ме?
Dialogue: 0,0:19:08.89,0:19:10.14,Default,,0,0,0,,Қалай болғанда да...
Dialogue: 0,0:19:11.19,0:19:13.36,Default,,0,0,0,,Тағы біреуі қалды! Ах...
Dialogue: 0,0:19:14.19,0:19:17.78,Default,,0,0,0,,Жарайды, эй, міне, міне!
Dialogue: 0,0:19:18.24,0:19:19.15,Default,,0,0,0,,Батыр!
Dialogue: 0,0:19:19.28,0:19:20.20,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:19:31.29,0:19:33.58,Default,,0,0,0,,Бұл өте жақсы ет.
Dialogue: 0,0:19:43.55,0:19:44.60,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:44.72,0:19:46.47,Default,,0,0,0,,Ол ұялшақ болуы керек.
Dialogue: 0,0:19:46.72,0:19:51.64,Default,,0,0,0,,Тірі қалғандардың саны сарбаздар мен бейбіт тұрғындарды қосқанда 3, 4... 6?
Dialogue: 0,0:19:52.10,0:19:54.90,Default,,0,0,0,,Зардап шеккендер бар, бірақ олар жақсы ма?
Dialogue: 0,0:19:55.48,0:19:56.82,Default,,0,0,0,,Иә, мүмкін
Dialogue: 0,0:19:57.44,0:19:59.99,Default,,0,0,0,,Мен құбыжықтың қанынан сиқырлы күшті жұтып алдым.
Dialogue: 0,0:20:00.11,0:20:01.82,Default,,0,0,0,,Себебі мен депутатты толтырдым
Dialogue: 0,0:20:01.99,0:20:03.57,Default,,0,0,0,,Бұл мүмкін бе?
Dialogue: 0,0:20:03.70,0:20:05.91,Default,,0,0,0,,Ұрының жасырынған жеріндегі ашулы
Dialogue: 0,0:20:06.41,0:20:09.08,Default,,0,0,0,,Сиқырлы құбыжықтың етін көп жеу
Dialogue: 0,0:20:09.20,0:20:11.00,Default,,0,0,0,,Мен бұл жағдайды естідім.
Dialogue: 0,0:20:11.16,0:20:13.87,Default,,0,0,0,,Соны да сіңіре алар ма деп едім.
Dialogue: 0,0:20:14.54,0:20:16.67,Default,,0,0,0,,Маған тезірек айтыңыз.
Dialogue: 0,0:20:16.79,0:20:19.92,Default,,0,0,0,,Жоқ, мен де қолданып көрдім.
Dialogue: 0,0:20:20.09,0:20:21.09,Default,,0,0,0,,Батыр-сама
Dialogue: 0,0:20:21.88,0:20:24.97,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:20:25.09,0:20:25.93,Default,,0,0,0,,Үйсу
Dialogue: 0,0:20:26.22,0:20:28.85,Default,,0,0,0,,Бұл қандай топқа барады?
Dialogue: 0,0:20:29.18,0:20:31.98,Default,,0,0,0,,Біз Деок Патшалығының сарбаздарымыз.
Dialogue: 0,0:20:32.18,0:20:35.15,Default,,0,0,0,,Патшаның бұйрығымен кәпірлер Радодовоға әкелінді.
Dialogue: 0,0:20:35.27,0:20:37.02,Default,,0,0,0,,Қазіргі уақытта тасымалдануда
Dialogue: 0,0:20:37.27,0:20:38.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:41.11,0:20:43.20,Default,,0,0,0,,Континенттен діндерге тыйым салу
Dialogue: 0,0:20:43.32,0:20:46.95,Default,,0,0,0,,Тыйым салынған Альтерос жарлығын бұзған бұл үлкен күнәкарлар
Dialogue: 0,0:20:47.07,0:20:50.41,Default,,0,0,0,,Ең жасырын Alteros сенушілер бар сияқты.
Dialogue: 0,0:20:50.54,0:20:52.08,Default,,0,0,0,,Радодово төбесінде
Dialogue: 0,0:20:52.20,0:20:55.17,Default,,0,0,0,,Ол әшкереленіп, өлім жазасына кесіледі.
Dialogue: 0,0:20:55.46,0:20:58.25,Default,,0,0,0,,Радодобо шынымен шықты
Dialogue: 0,0:20:58.59,0:21:01.42,Default,,0,0,0,,Пакет дегеніміз не? Әлі белгісіз
Dialogue: 0,0:21:01.80,0:21:04.22,Default,,0,0,0,,Адамдар? Өлім жазасына кесілген тұтқын?
Dialogue: 0,0:21:05.05,0:21:08.76,Default,,0,0,0,,Пұтқа табынушы бала... Бұл не?
Dialogue: 0,0:21:09.30,0:21:11.18,Default,,0,0,0,,Жүк сол адамдар ма?
Dialogue: 0,0:21:11.39,0:21:12.85,Default,,0,0,0,,Бірақ мен оны қайтарып жіберсем
Dialogue: 0,0:21:12.98,0:21:16.31,Default,,0,0,0,,Сол адамдар мен мына бала міндетті түрде өлтіріледі.
Dialogue: 0,0:21:17.77,0:21:19.48,Default,,0,0,0,,Адамның шабуылы анықталды.
Dialogue: 0,0:21:19.61,0:21:21.57,Default,,0,0,0,,Тәжірибе ұпайлары азаяды.
Dialogue: 0,0:21:22.23,0:21:25.57,Default,,0,0,0,,Адамдардың өз әрекеттерінің салдарынан өлуі дұрыс па?
Dialogue: 0,0:21:26.78,0:21:29.24,Default,,0,0,0,,Бұл оқиға квест па?
Dialogue: 0,0:21:29.57,0:21:32.12,Default,,0,0,0,,Әлде қол ұшын берсең сырттасың ба?
Dialogue: 0,0:21:32.91,0:21:33.83,Default,,0,0,0,,Бұл...
Dialogue: 0,0:21:34.58,0:21:35.79,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,0:21:41.38,0:21:47.38,Default,,0,0,0,,♪〜
Dialogue: 0,0:23:04.42,0:23:10.43,Default,,0,0,0,,〜♪
Dialogue: 0,0:23:22.77,0:23:25.77,Default,,0,0,0,,О, Йоцуя, өлу деген не?
Dialogue: 0,0:23:25.90,0:23:27.19,Default,,0,0,0,,Бұл мүмкін емес ойын!
Dialogue: 0,0:23:35.95,0:23:38.79,Default,,0,0,0,,Бұл тазалаудың дұрыс жолы.
Dialogue: 0,0:23:38.91,0:23:40.62,Default,,0,0,0,,Бұл ақымақ ойын!
Dialogue: 0,0:23:42.12,0:23:48.12,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory