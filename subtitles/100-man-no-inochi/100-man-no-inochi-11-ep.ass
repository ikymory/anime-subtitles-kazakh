Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.37,0:00:06.04,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:00:23.02,0:00:25.15,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,0:00:25.27,0:00:27.81,Default,,0,0,0,,Менің күшімді есте сақта
Dialogue: 0,0:00:27.94,0:00:29.61,Default,,0,0,0,,Қараңғылық найзағай!
Dialogue: 0,0:00:31.23,0:00:32.32,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:00:40.37,0:00:41.95,Default,,0,0,0,,Маджиха қызғылт
Dialogue: 0,0:00:42.08,0:00:46.17,Default,,0,0,0,,Үміт нұры қалған жоқ саған!
Dialogue: 0,0:00:46.92,0:00:48.46,Default,,0,0,0,,Бұл дұрыс емес...
Dialogue: 0,0:00:48.63,0:00:49.84,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:00:51.05,0:00:52.13,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:00:53.09,0:00:53.92,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:01:00.39,0:01:01.81,Default,,0,0,0,,Маджиха күлгін!
Dialogue: 0,0:01:01.97,0:01:02.85,Default,,0,0,0,,Басаши!
Dialogue: 0,0:01:02.97,0:01:03.81,Default,,0,0,0,,Джусаши!
Dialogue: 0,0:01:04.02,0:01:06.73,Default,,0,0,0,,Сіз әлі де жалғастырасыз ба?
Dialogue: 0,0:01:06.85,0:01:08.27,Default,,0,0,0,,Серіктеріне сенгені өзінің қателігі екенін түсінген Эрен
Dialogue: 0,0:01:08.81,0:01:10.11,Default,,0,0,0,,Бітті!
Dialogue: 0,0:01:12.19,0:01:13.03,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:01:13.90,0:01:17.07,Default,,0,0,0,,Әлемді осы жын патша Люцифер басқарады.
Dialogue: 0,0:01:17.20,0:01:19.45,Default,,0,0,0,,Үмітсіздіктің қараңғылығымен басқар
Dialogue: 0,0:01:19.57,0:01:21.58,Default,,0,0,0,,Дүние жүзіндегі балалардан
Dialogue: 0,0:01:21.70,0:01:26.08,Default,,0,0,0,,Армандарды сіңірген қара түннің басы.
Dialogue: 0,0:01:26.54,0:01:29.04,Default,,0,0,0,,Ақыл-ой сынақтарының атымен—
Dialogue: 0,0:01:29.17,0:01:32.30,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:01:32.42,0:01:33.84,Default,,0,0,0,,Мен берілмеймін
Dialogue: 0,0:01:43.89,0:01:47.10,Default,,0,0,0,,Мен бұған жол бермеймін...
Dialogue: 0,0:01:47.27,0:01:50.02,Default,,0,0,0,,Қандай жағдай болмасын, мен...
Dialogue: 0,0:01:50.40,0:01:52.32,Default,,0,0,0,,Біз, Маджиха апалы-сіңлілер,
Dialogue: 0,0:01:52.90,0:01:54.44,Default,,0,0,0,,Мен берілмеймін!
Dialogue: 0,0:02:11.33,0:02:14.71,Default,,0,0,0,,Өйткені біз болашаққа сенеміз!
Dialogue: 0,0:02:20.01,0:02:22.39,Default,,0,0,0,,Мен оны сеземін, Маджиха Күлгін
Dialogue: 0,0:02:23.05,0:02:24.76,Default,,0,0,0,,Өйткені мен махаббатқа сенемін!
Dialogue: 0,0:02:28.27,0:02:30.69,Default,,0,0,0,,Үміт нұры сөнбейді
Dialogue: 0,0:02:31.06,0:02:32.27,Default,,0,0,0,,Бұл әрқашан
Dialogue: 0,0:02:32.77,0:02:34.52,Default,,0,0,0,,Бұл жерде жанып жатыр!
Dialogue: 0,0:02:35.15,0:02:36.48,Default,,0,0,0,,Қып-қызыл жалынмен
Dialogue: 0,0:02:36.82,0:02:38.03,Default,,0,0,0,,Өртеп жібер!
Dialogue: 0,0:02:39.24,0:02:41.99,Default,,0,0,0,,Қатты өрт!
Dialogue: 0,0:02:45.74,0:02:48.41,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:02:48.87,0:02:52.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:53.50,0:02:59.51,Default,,0,0,0,,♪～
Dialogue: 0,0:04:16.21,0:04:22.22,Default,,0,0,0,,～♪
Dialogue: 0,0:04:24.59,0:04:26.59,Default,,0,0,0,,«Мәңгілік Маджиха»
Dialogue: 0,0:04:28.01,0:04:29.26,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:04:29.39,0:04:30.64,Default,,0,0,0,,Балалық шақ
Dialogue: 0,0:04:30.93,0:04:33.98,Default,,0,0,0,,Маджиха апалары мені таңдандыратын нәрсе болды.
Dialogue: 0,0:04:34.52,0:04:35.85,Default,,0,0,0,,Махаббат пен достық
Dialogue: 0,0:04:35.98,0:04:37.31,Default,,0,0,0,,Батылдыққа үміт
Dialogue: 0,0:04:37.94,0:04:39.07,Default,,0,0,0,,Егер солай болса
Dialogue: 0,0:04:39.23,0:04:42.65,Default,,0,0,0,,Біз де әлемді құтқарып, керемет сиқырлы қыздар бола аламыз
Dialogue: 0,0:04:43.82,0:04:46.07,Default,,0,0,0,,Сиқыр... Өрт
Dialogue: 0,0:04:47.53,0:04:51.66,Default,,0,0,0,,Ақыр соңында, біз бір бола алмаймыз.
Dialogue: 0,0:04:52.37,0:04:54.71,Default,,0,0,0,,Мен өзіме не болып жатқанын білдім.
Dialogue: 0,0:04:58.50,0:05:01.42,Default,,0,0,0,,Әрқашан күштінің жағын алу арқылы
Dialogue: 0,0:05:01.55,0:05:03.30,Default,,0,0,0,,Мен бұл денені қорғадым.
Dialogue: 0,0:05:03.80,0:05:05.72,Default,,0,0,0,,Артымнан ғайбаттап жүрсе де
Dialogue: 0,0:05:06.26,0:05:10.43,Default,,0,0,0,,Мен ортақ жау тапқанда, мен оларға қосылдым.
Dialogue: 0,0:05:13.39,0:05:15.69,Default,,0,0,0,,Қалғандары да солай.
Dialogue: 0,0:05:15.81,0:05:19.23,Default,,0,0,0,,Сондықтан да бізде ешқандай күмән болған жоқ.
Dialogue: 0,0:05:19.98,0:05:22.15,Default,,0,0,0,,Атмосфераны оқымасаң, өмір сүре алмайсың
Dialogue: 0,0:05:22.48,0:05:24.61,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:05:25.32,0:05:28.28,Default,,0,0,0,,Махаббат пен үміттің қандай сиқырлы қызы...
Dialogue: 0,0:05:56.23,0:05:58.48,Default,,0,0,0,,Қайта өрлеу... мүмкін болды ма?
Dialogue: 0,0:06:00.81,0:06:04.15,Default,,0,0,0,,Ол кезде мен бәрі бітті деп ойладым.
Dialogue: 0,0:06:07.61,0:06:08.78,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:06:17.00,0:06:19.21,Default,,0,0,0,,Мен осында құлап өлдім.
Dialogue: 0,0:06:19.33,0:06:22.00,Default,,0,0,0,,Оның дене қызуы сақталды ма және оны қалпына келтіруге мүмкіндік болды ма?
Dialogue: 0,0:06:22.38,0:06:23.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:24.92,0:06:26.84,Default,,0,0,0,,Жасырын зындан параметрі?
Dialogue: 0,0:06:27.17,0:06:28.42,Default,,0,0,0,,Егер мен солай істесем, Шукуна оны өзінің Инверсия формуласымен емдей алған болар еді.
Dialogue: 0,0:06:33.47,0:06:37.39,Default,,0,0,0,,Мен тауда мұндай жер бар екенін білмедім.
Dialogue: 0,0:06:50.57,0:06:53.20,Default,,0,0,0,,Мен қанша уақытқа созылатынын білмеймін
Dialogue: 0,0:06:53.37,0:06:56.45,Default,,0,0,0,,Осы жерден жүре берсеңіз, сонда жете аласыз!
Dialogue: 0,0:06:56.58,0:06:57.41,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:07:02.67,0:07:05.09,Default,,0,0,0,,Қалай...
Dialogue: 0,0:07:06.00,0:07:08.17,Default,,0,0,0,,Эй, оян!
Dialogue: 0,0:07:09.80,0:07:10.68,Default,,0,0,0,,Ниндзялар Эдо дәуірінде жойылып кеткен жоқ па?
Dialogue: 0,0:07:11.22,0:07:15.10,Default,,0,0,0,,Өтінемін, мұндай жерде өлме!
Dialogue: 0,0:07:16.72,0:07:19.89,Default,,0,0,0,,Жоқ! Мен бір сәтке есімді жоғалттым
Dialogue: 0,0:07:21.60,0:07:22.81,Default,,0,0,0,,Бенисуэ?
Dialogue: 0,0:07:25.02,0:07:26.82,Default,,0,0,0,,Мұндай ақымақ ізденіс
Dialogue: 0,0:07:26.94,0:07:28.40,Default,,0,0,0,,Мен оны міндетті түрде тазалаймын!
Dialogue: 0,0:07:32.07,0:07:33.66,Default,,0,0,0,,Басынан бастап осылай
Dialogue: 0,0:07:33.78,0:07:36.49,Default,,0,0,0,,Мен бағытты тексере отырып, жалғастыруым керек еді.
Dialogue: 0,0:07:36.78,0:07:38.70,Default,,0,0,0,,Жел біршама басылды.
Dialogue: 0,0:07:38.83,0:07:42.54,Default,,0,0,0,,Шынымды айтсам, жүрудің қиындығы өзгерген жоқ, бірақ бәрібір...
Dialogue: 0,0:07:46.67,0:07:48.88,Default,,0,0,0,,Керемет, ауыл бар!
Dialogue: 0,0:07:52.34,0:07:53.72,Default,,0,0,0,,Күтілгендей!
Dialogue: 0,0:07:54.09,0:07:56.64,Default,,0,0,0,,Онда барсаң ат арба немесе шана болады.
Dialogue: 0,0:07:56.80,0:07:59.72,Default,,0,0,0,,Сізді жылдамырақ жылжытатын нәрсені жалға алуыңыз керек!
Dialogue: 0,0:08:00.27,0:08:01.52,Default,,0,0,0,,Мені күт, Бенису
Dialogue: 0,0:08:01.64,0:08:03.73,Default,,0,0,0,,Мен сені бірден өмірге қайтарамын!
Dialogue: 0,0:08:11.74,0:08:14.32,Default,,0,0,0,,Йоцуя-кун да, Юка-сан да әлі тірі.
Dialogue: 0,0:08:17.91,0:08:20.08,Default,,0,0,0,,Сәл ғана, тағы біраз!
Dialogue: 0,0:08:22.41,0:08:23.92,Default,,0,0,0,,Бәріміз қолымыздан келгеннің бәрін жасасақ...
Dialogue: 0,0:08:24.04,0:08:25.50,Default,,0,0,0,,Е...
Dialogue: 0,0:08:25.96,0:08:29.75,Default,,0,0,0,,(Жарықтың дыбысы)
Dialogue: 0,0:08:34.68,0:08:36.26,Default,,0,0,0,,Фуза… Кенна
Dialogue: 0,0:08:37.85,0:08:38.85,Default,,0,0,0,,Қый!
Dialogue: 0,0:08:48.11,0:08:49.52,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:08:50.27,0:08:51.44,Default,,0,0,0,,Синдо мырза...
Dialogue: 0,0:08:51.78,0:08:53.19,Default,,0,0,0,,Біраз уақыт тоқтады.
Dialogue: 0,0:08:53.32,0:08:55.95,Default,,0,0,0,,Осыдан кейін мен тұрақты түрде қашықтықты алуым керек еді.
Dialogue: 0,0:08:56.11,0:08:58.28,Default,,0,0,0,,Шынымды айтсам, мен оған көп сенетінмін.
Dialogue: 0,0:08:58.49,0:09:01.62,Default,,0,0,0,,Осы уақытта, иә...
Dialogue: 0,0:09:02.75,0:09:05.62,Default,,0,0,0,,Мен қайтып, басқа жолды қолданып көруім керек.
Dialogue: 0,0:09:13.51,0:09:14.51,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:09:18.93,0:09:20.18,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:09:26.89,0:09:27.73,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:32.82,0:09:33.65,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:09:34.69,0:09:36.07,Default,,0,0,0,,Тұйық жол!
Dialogue: 0,0:09:36.28,0:09:38.53,Default,,0,0,0,,Бұл өте мүмкін емес ойын.
Dialogue: 0,0:09:38.66,0:09:40.49,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:09:40.83,0:09:42.49,Default,,0,0,0,,Жер сілкінісі?
Dialogue: 0,0:09:57.30,0:10:01.30,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:10:10.19,0:10:11.65,Default,,0,0,0,,Эй, эй
Dialogue: 0,0:10:12.90,0:10:14.94,Default,,0,0,0,,Шамасы, бұл дүниенің жауын құрттары да.
Dialogue: 0,0:10:15.07,0:10:19.03,Default,,0,0,0,,Біздің дүниедегідей олар топырақ жеп өмір сүретін сияқты.
Dialogue: 0,0:10:19.53,0:10:22.95,Default,,0,0,0,,Оның үстіне бұл жігіт бұрын мен бармаған жаққа қарай беттеп келеді.
Dialogue: 0,0:10:23.33,0:10:24.66,Default,,0,0,0,,Нөлдік қауіп
Dialogue: 0,0:10:24.79,0:10:28.33,Default,,0,0,0,,Қазіргі жағдайда мен өте ризамын.
Dialogue: 0,0:10:29.21,0:10:31.88,Default,,0,0,0,,Хаа… Күте тұрыңыз.
Dialogue: 0,0:10:32.42,0:10:34.46,Default,,0,0,0,,Ол сағатына қаншалықты жылдам?
Dialogue: 0,0:10:34.59,0:10:36.80,Default,,0,0,0,,Мен енді жерге қайта алмаймын.
Dialogue: 0,0:10:37.05,0:10:39.68,Default,,0,0,0,,Менің бұл жігітке қолынан келгеннің бәрін жасауға мүмкіндік беруден басқа амалым жоқ.
Dialogue: 0,0:10:39.84,0:10:42.64,Default,,0,0,0,,Әй, сәл тезірек жібере аласыз ба?
Dialogue: 0,0:10:42.80,0:10:45.47,Default,,0,0,0,,Уақыт бітті... Иә?
Dialogue: 0,0:10:45.72,0:10:49.44,Default,,0,0,0,,О, тамаша! Сенің қолыңнан келеді, Мимизу Таро!
Dialogue: 0,0:10:49.56,0:10:51.90,Default,,0,0,0,,Сен жақсы жігітсің, алға!
Dialogue: 0,0:10:52.02,0:10:53.36,Default,,0,0,0,,Зэн'ин әулетінен қалған техникалардың бірі.
Dialogue: 0,0:10:58.49,0:11:00.03,Default,,0,0,0,,Джиро сонда болды ма?
Dialogue: 0,0:11:00.20,0:11:02.66,Default,,0,0,0,,Сәлем! Таро қазған шұңқырды ұрламаңыз.
Dialogue: 0,0:11:02.78,0:11:04.91,Default,,0,0,0,,Бірінші Сіз жеген топырақ осында...
Dialogue: 0,0:11:07.79,0:11:08.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:10.87,0:11:13.08,Default,,0,0,0,,Жем - бұл... мен!
Dialogue: 0,0:11:14.71,0:11:15.92,Default,,0,0,0,,(тамақтану дыбысы)
Dialogue: 0,0:11:27.93,0:11:30.98,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:11:31.10,0:11:32.98,Default,,0,0,0,,Шынымды айтсам, бұл мүмкін емес.
Dialogue: 0,0:11:33.31,0:11:37.82,Default,,0,0,0,,Бұл жағдайда біз және Йоцуя ғана қалды!
Dialogue: 0,0:11:38.07,0:11:40.95,Default,,0,0,0,,Иу мырза және басқалары әлі де реанимацияның нөл секундында тұрып қалды.
Dialogue: 0,0:11:41.07,0:11:41.90,Default,,0,0,0,,(Үкідің ұлуы)
Dialogue: 0,0:11:42.45,0:11:44.87,Default,,0,0,0,,Демек, сіз мұны өшіре алмайсыз ба?
Dialogue: 0,0:11:44.99,0:11:45.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:46.66,0:11:49.08,Default,,0,0,0,,Өтірік... Бұл не?
Dialogue: 0,0:11:54.83,0:11:59.00,Default,,0,0,0,,Бұл сұмдық... Денем де, санам да қатып қалды.
Dialogue: 0,0:12:02.76,0:12:03.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:05.47,0:12:07.97,Default,,0,0,0,,Өзіңізді жеңілдеп қалдыңыз ба?
Dialogue: 0,0:12:08.10,0:12:09.68,Default,,0,0,0,,Бұрын… пышақ еді.
Dialogue: 0,0:12:09.81,0:12:13.77,Default,,0,0,0,,Мен әрқашан бас тартудың себебін қалайтынмын.
Dialogue: 0,0:12:13.98,0:12:15.73,Default,,0,0,0,,Менің өлгім келмейді, бірақ
Dialogue: 0,0:12:16.06,0:12:19.69,Default,,0,0,0,,Шағым жоқ, бәрі бірінші өлді.
Dialogue: 0,0:12:20.11,0:12:23.11,Default,,0,0,0,,Мен мұны бәрібір жалғыз істей алмаймын.
Dialogue: 0,0:12:23.24,0:12:26.57,Default,,0,0,0,,Маған енді тырысудың қажеті жоқ... Жоқ.
Dialogue: 0,0:12:27.37,0:12:31.08,Default,,0,0,0,,Аа... Көңілді өлемін.
Dialogue: 0,0:12:31.20,0:12:33.37,Default,,0,0,0,,Өте оңай...
Dialogue: 0,0:12:35.00,0:12:37.13,Default,,0,0,0,,Осындай жерде...
Dialogue: 0,0:12:37.75,0:12:38.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:39.38,0:12:42.26,Default,,0,0,0,,Сіз немен ұйықтап жатырсыз? Шынымен қызғылт!
Dialogue: 0,0:12:43.42,0:12:45.55,Default,,0,0,0,,Шынымен... Күлгін?
Dialogue: 0,0:12:46.26,0:12:48.60,Default,,0,0,0,,Жоқ, бұл арман.
Dialogue: 0,0:12:48.72,0:12:50.93,Default,,0,0,0,,Сізді соңында көргім келеді
Dialogue: 0,0:12:51.52,0:12:52.52,Default,,0,0,0,,адасу
Dialogue: 0,0:12:53.27,0:12:55.98,Default,,0,0,0,,Алдану деп аталатын иллюзия
Dialogue: 0,0:12:56.31,0:12:57.52,Default,,0,0,0,,Маджиха қызғылт!
Dialogue: 0,0:12:59.02,0:13:00.44,Default,,0,0,0,,Біз ше?
Dialogue: 0,0:13:02.28,0:13:05.36,Default,,0,0,0,,Осы уақытқа дейін бізден не көрдіңіз?
Dialogue: 0,0:13:07.49,0:13:10.74,Default,,0,0,0,,Түпнұсқа Майха Пинк соңғы эпизодта жын патшасы Люциферге айналады.
Dialogue: 0,0:13:10.87,0:13:13.45,Default,,0,0,0,,Қараңғылық найзағайынан жеңілгеннен кейін не болды?
Dialogue: 0,0:13:14.83,0:13:16.42,Default,,0,0,0,,Қазіргі уақытта концерттік турда
Dialogue: 0,0:13:16.54,0:13:17.46,Default,,0,0,0,,Біз!
Dialogue: 0,0:13:17.67,0:13:20.21,Default,,0,0,0,,Маджиха Пинктің екінші буыны соңғы эпизодта.
Dialogue: 0,0:13:20.34,0:13:23.88,Default,,0,0,0,,Ороборостың энергия ағынынан жеңілгеннен кейін не болды?
Dialogue: 0,0:13:24.01,0:13:25.55,Default,,0,0,0,,Қазіргі уақытта концерттік турда
Dialogue: 0,0:13:25.76,0:13:26.80,Default,,0,0,0,,Ол сонда—сол жақта~
Dialogue: 0,0:13:27.13,0:13:28.84,Default,,0,0,0,,Үшінші буын Majiha Pink болып табылады
Dialogue: 0,0:13:28.97,0:13:32.18,Default,,0,0,0,,Горгонның тас көзінен жеңілгеннен кейін не болды?
Dialogue: 0,0:13:32.39,0:13:33.81,Default,,0,0,0,,Мен бәрін көрдім, берілмеймін!
Dialogue: 0,0:13:33.93,0:13:36.10,Default,,0,0,0,,Сондықтан мен бәрін білемін!
Dialogue: 0,0:13:36.23,0:13:37.85,Default,,0,0,0,,Мен сізден тағы сұраймын.
Dialogue: 0,0:13:37.98,0:13:40.94,Default,,0,0,0,,Осы уақытқа дейін бізден не көрдіңіз?
Dialogue: 0,0:13:41.07,0:13:41.90,Default,,0,0,0,,Маған жауап бер!
Dialogue: 0,0:13:42.65,0:13:45.95,Default,,0,0,0,,Маджиха апалар әрқашан!
Dialogue: 0,0:13:46.28,0:13:49.37,Default,,0,0,0,,Дүние жүзіндегі балалардың махаббаты мен үміті үшін...
Dialogue: 0,0:13:50.28,0:13:52.28,Default,,0,0,0,,Тұр!
Dialogue: 0,0:13:59.67,0:14:02.55,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:14:02.67,0:14:04.84,Default,,0,0,0,,Оны қызыл жалынмен өрте!
Dialogue: 0,0:14:05.71,0:14:08.80,Default,,0,0,0,,Қатты өрт!
Dialogue: 0,0:14:16.68,0:14:17.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:28.90,0:14:30.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:32.66,0:14:33.91,Default,,0,0,0,,Юка-сан...
Dialogue: 0,0:14:39.08,0:14:41.63,Default,,0,0,0,,Хе хе хе хе хе хе...
Dialogue: 0,0:14:42.17,0:14:44.55,Default,,0,0,0,,Жүр, мұнда тез кел.
Dialogue: 0,0:14:45.00,0:14:47.63,Default,,0,0,0,,Ахххх...
Dialogue: 0,0:14:49.22,0:14:52.30,Default,,0,0,0,,Мен сенің күлкіңді жақсы көремін
Dialogue: 0,0:14:52.85,0:14:54.89,Default,,0,0,0,,Цубаса-кюн
Dialogue: 0,0:14:55.01,0:14:56.43,Default,,0,0,0,,Қараңызшы, тағы біраз
Dialogue: 0,0:14:56.56,0:14:57.39,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:14:57.52,0:14:58.56,Default,,0,0,0,,Ұрыс
Dialogue: 0,0:14:59.73,0:15:01.23,Default,,0,0,0,,Сіз мұны істей аласыз.
Dialogue: 0,0:15:01.35,0:15:02.90,Default,,0,0,0,,Бақыт~
Dialogue: 0,0:15:06.90,0:15:10.61,Default,,0,0,0,,Ха ха ха... Мен берілмеймін
Dialogue: 0,0:15:11.28,0:15:15.33,Default,,0,0,0,,Өйткені мен сиқырлы қызбын...
Dialogue: 0,0:15:15.66,0:15:17.16,Default,,0,0,0,,Онда ұйықтасаң, өлесің.
Dialogue: 0,0:15:29.05,0:15:31.01,Default,,0,0,0,,Сіз ойыншысыз, солай ма?
Dialogue: 0,0:15:31.13,0:15:32.59,Default,,0,0,0,,Қаласаңыз, мінуге болады.
Dialogue: 0,0:15:33.14,0:15:33.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:34.97,0:15:36.01,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:15:45.15,0:15:47.27,Default,,0,0,0,,Иә~ 4-тур?
Dialogue: 0,0:15:47.40,0:15:50.69,Default,,0,0,0,,Бұл күтпеген ізденістің бұл қарға еш қатысы жоқ.
Dialogue: 0,0:15:50.82,0:15:51.82,Default,,0,0,0,,Иә
Dialogue: 0,0:15:51.95,0:15:54.11,Default,,0,0,0,,Сонымен... қай жолмен жүруім керек?
Dialogue: 0,0:15:54.28,0:15:56.08,Default,,0,0,0,,А, солай ма?
Dialogue: 0,0:15:58.29,0:15:59.12,Default,,0,0,0,,Өтірік!
Dialogue: 0,0:15:59.33,0:16:02.04,Default,,0,0,0,,Бұл уақытында орындалмайды!
Dialogue: 0,0:16:02.54,0:16:03.96,Default,,0,0,0,,Сіз асығыссыз ба?
Dialogue: 0,0:16:06.88,0:16:08.38,Default,,0,0,0,,Міне!
Dialogue: 0,0:16:08.50,0:16:10.88,Default,,0,0,0,,Жарайды, сен қатты асығасың.
Dialogue: 0,0:16:11.01,0:16:12.55,Default,,0,0,0,,Содан кейін мықтап ұстаңыз.
Dialogue: 0,0:16:12.68,0:16:14.30,Default,,0,0,0,,үшін? Жылдамдаңыз!
Dialogue: 0,0:16:14.68,0:16:18.93,Default,,0,0,0,,Жел рухы Сильфид, маған күшіңізді беріңізші.
Dialogue: 0,0:16:19.35,0:16:22.14,Default,,0,0,0,,Сиқыршы Фатина атымен, ей, жел!
Dialogue: 0,0:16:24.48,0:16:25.52,Default,,0,0,0,,Уф… Ах…
Dialogue: 0,0:16:25.77,0:16:27.15,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:16:27.27,0:16:30.69,Default,,0,0,0,,Ой, сіз де ойыншысыз ба?
Dialogue: 0,0:16:30.82,0:16:32.32,Default,,0,0,0,,дәл осы Пакистан жерінде.
Dialogue: 0,0:16:32.44,0:16:34.70,Default,,0,0,0,,Мен жай ғана сиқыршымын
Dialogue: 0,0:16:34.95,0:16:36.62,Default,,0,0,0,,Шебер...
Dialogue: 0,0:16:37.37,0:16:38.62,Default,,0,0,0,,Жел!
Dialogue: 0,0:16:45.42,0:16:47.63,Default,,0,0,0,,Өтінемін, сәл ғана өтінемін!
Dialogue: 0,0:16:50.17,0:16:53.38,Default,,0,0,0,,Жел, мына батырды жарылқа!
Dialogue: 0,0:16:55.63,0:16:57.47,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:17:13.78,0:17:17.03,Default,,0,0,0,,Не, бұл өтірік... Тірісің бе?
Dialogue: 0,0:17:17.16,0:17:19.66,Default,,0,0,0,,Соңында не болды?
Dialogue: 0,0:17:19.78,0:17:21.37,Default,,0,0,0,,Оны кім тазартты?
Dialogue: 0,0:17:23.45,0:17:24.37,Default,,0,0,0,,Иә! (Йоцуя) Олай емес!
Dialogue: 0,0:17:24.71,0:17:25.96,Default,,0,0,0,,Юка-сан!
Dialogue: 0,0:17:26.33,0:17:28.00,Default,,0,0,0,,Эй, бұл...
Dialogue: 0,0:17:28.42,0:17:31.09,Default,,0,0,0,,Біз үшін несиені өзімізге алу мүмкіндігі!
Dialogue: 0,0:17:31.21,0:17:33.13,Default,,0,0,0,,Бұл бір оқ, мейіріміңді сат...
Dialogue: 0,0:17:33.26,0:17:34.97,Default,,0,0,0,,Жақсы жұмыс. (Токитате) Уау!
Dialogue: 0,0:17:35.09,0:17:37.38,Default,,0,0,0,,Қазірдің өзінде! Артынан шықпа!
Dialogue: 0,0:17:37.51,0:17:41.10,Default,,0,0,0,,Нақты марапатқа қатысты бір сұрақ.
Dialogue: 0,0:17:41.39,0:17:44.52,Default,,0,0,0,,Неге сонша қиындықтан өтіп, бір ғана сұрақ қойдыңыз!
Dialogue: 0,0:17:44.98,0:17:46.77,Default,,0,0,0,,Бұл сұрақ.
Dialogue: 0,0:17:47.23,0:17:48.98,Default,,0,0,0,,Жоқ, жоқ! Бір минут күтіңіз
Dialogue: 0,0:17:49.10,0:17:51.52,Default,,0,0,0,,Қазір ойлап қарасам, ол кісі әрең дегенде тұрған.
Dialogue: 0,0:17:51.65,0:17:54.90,Default,,0,0,0,,Мүмкін бұл біреу маған көмектесуге келетін жағдай шығар.
Dialogue: 0,0:17:55.28,0:17:58.66,Default,,0,0,0,,Шынымды айтсам, бәріміз өлім аузында едік.
Dialogue: 0,0:17:58.78,0:18:00.99,Default,,0,0,0,,Бұл шебер кім?
Dialogue: 0,0:18:01.41,0:18:02.95,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:18:03.08,0:18:04.66,Default,,0,0,0,,Бір қымбат уақыт...
Dialogue: 0,0:18:09.42,0:18:10.71,Default,,0,0,0,,Бұл дүние...
Dialogue: 0,0:18:11.38,0:18:14.17,Default,,0,0,0,,Бұл әлем виртуалды...
Dialogue: 0,0:18:14.55,0:18:16.97,Default,,0,0,0,,Бұл виртуалды шындық, солай ма?
Dialogue: 0,0:18:21.80,0:18:23.72,Default,,0,0,0,,Параллель дүние...
Dialogue: 0,0:18:23.85,0:18:27.06,Default,,0,0,0,,Параллель дүниелер деген ұғым бар.
Dialogue: 0,0:18:28.23,0:18:29.65,Default,,0,0,0,,Параллель дүние?
Dialogue: 0,0:18:29.94,0:18:32.11,Default,,0,0,0,,Мысалы, қиылысу бар
Dialogue: 0,0:18:32.23,0:18:34.48,Default,,0,0,0,,Мен сол жаққа бұрылдым
Dialogue: 0,0:18:34.61,0:18:36.90,Default,,0,0,0,,Басқа мүмкін әлемде
Dialogue: 0,0:18:37.03,0:18:39.99,Default,,0,0,0,,Сіз солға бұрылып жатырсыз делік.
Dialogue: 0,0:18:40.49,0:18:41.91,Default,,0,0,0,,Осы басқа мүмкіндік туралы
Dialogue: 0,0:18:42.03,0:18:44.87,Default,,0,0,0,,Солға бұрылған мен бар дүние
Dialogue: 0,0:18:44.99,0:18:47.20,Default,,0,0,0,,Параллель әлемде.
Dialogue: 0,0:18:47.87,0:18:49.67,Default,,0,0,0,,Демек, параллель дүние
Dialogue: 0,0:18:49.79,0:18:52.08,Default,,0,0,0,,Біз бір нәрсені таңдаған сайын
Dialogue: 0,0:18:52.21,0:18:56.34,Default,,0,0,0,,Ол бүкіл ғаламдағы мүмкіндіктердің бірдей санына тармақталу арқылы артады.
Dialogue: 0,0:18:56.71,0:18:59.22,Default,,0,0,0,,Бұл теорияда дұрыс па?
Dialogue: 0,0:18:59.97,0:19:03.39,Default,,0,0,0,,Сондықтан мен солға бұрылуды жөн көрдім.
Dialogue: 0,0:19:03.51,0:19:06.10,Default,,0,0,0,,Егер сіз апатқа ұшырап, өлсеңіз ше?
Dialogue: 0,0:19:06.22,0:19:09.85,Default,,0,0,0,,Параллель әлемде мен өлдім де кеттім.
Dialogue: 0,0:19:10.48,0:19:15.36,Default,,0,0,0,,Сонда бұл таңдау бүгін емес, үш жыл бұрын жасалған болса ше?
Dialogue: 0,0:19:15.69,0:19:18.61,Default,,0,0,0,,Параллельді әлемде үш жыл бұрын адам апаттан қайтыс болды.
Dialogue: 0,0:19:18.74,0:19:22.32,Default,,0,0,0,,Мен жоқ дүние бар.
Dialogue: 0,0:19:22.87,0:19:27.45,Default,,0,0,0,,Ал егер таңдау сіздің ата-анаңыздың 20 жыл бұрынғы әрекеті болса ше?
Dialogue: 0,0:19:28.16,0:19:29.16,Default,,0,0,0,,Параллель әлемде
Dialogue: 0,0:19:29.29,0:19:33.38,Default,,0,0,0,,Сіздің ата-анаңыз 20 жыл бұрын қайтыс болған әлем бар.
Dialogue: 0,0:19:33.63,0:19:36.55,Default,,0,0,0,,Әрине сен ешқашан тумайсың
Dialogue: 0,0:19:37.21,0:19:41.22,Default,,0,0,0,,Осылайша параллель дүниелер өткенде алшақтайды
Dialogue: 0,0:19:41.34,0:19:44.22,Default,,0,0,0,,Дүние шындыққа жанаспайды.
Dialogue: 0,0:19:44.34,0:19:45.93,Default,,0,0,0,,Бұл тармақ
Dialogue: 0,0:19:46.10,0:19:50.10,Default,,0,0,0,,Ғаламның пайда болғанынан бастап осы уақытқа дейін шексіз қайталанды.
Dialogue: 0,0:19:51.02,0:19:52.23,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:19:52.35,0:19:56.32,Default,,0,0,0,,Бұл параллель дүниелердің шексіз дерлік саны бар дегенді білдіре ме?
Dialogue: 0,0:19:56.94,0:19:59.28,Default,,0,0,0,,Біз арнайы құралдарды қолданамыз
Dialogue: 0,0:19:59.40,0:20:04.24,Default,,0,0,0,,Белгілі бір шарттарды қанағаттандыратын параллель әлемдерді бақылап, саяхаттауға болады.
Dialogue: 0,0:20:05.20,0:20:09.16,Default,,0,0,0,,Нақты шарт - әлемдердің толқын ұзындығының ұқсас болуы.
Dialogue: 0,0:20:09.45,0:20:11.04,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:20:12.08,0:20:14.71,Default,,0,0,0,,4,6 млрд жыл бұрын бөлінген
Dialogue: 0,0:20:14.83,0:20:18.34,Default,,0,0,0,,Адамға ұқсайтын интеллектуалды тіршілік формасы дүниеге келеді.
Dialogue: 0,0:20:18.46,0:20:21.42,Default,,0,0,0,,Адамзат тарихына ұқсас тарихты өмір сүру
Dialogue: 0,0:20:21.55,0:20:24.64,Default,,0,0,0,,Басқа мүмкін Жер.
Dialogue: 0,0:20:24.76,0:20:25.80,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:20:27.85,0:20:30.39,Default,,0,0,0,,Сұрақ қоюға құқығыңыз жоқ.
Dialogue: 0,0:20:32.43,0:20:37.23,Default,,0,0,0,,Әрине, жұлдыздың өзі, оның ұлпалық құрамдас бөліктері, жер бедері де әртүрлі.
Dialogue: 0,0:20:37.52,0:20:41.32,Default,,0,0,0,,Алайда, бұл орын виртуалды кеңістік емес.
Dialogue: 0,0:20:41.49,0:20:45.91,Default,,0,0,0,,Бұл параллель әлемде Жермен бір жерде орналасқан планета.
Dialogue: 0,0:20:46.16,0:20:48.24,Default,,0,0,0,,Керісінше, бұл әлемдегі виртуалды нәрсе
Dialogue: 0,0:20:48.37,0:20:50.20,Default,,0,0,0,,Бұл сізге байланысты.
Dialogue: 0,0:20:50.54,0:20:51.58,Default,,0,0,0,,Біз ше?
Dialogue: 0,0:20:51.70,0:20:54.67,Default,,0,0,0,,Әй, бірақ әйтпесе сен мені қайта тірілте алмас едің.
Dialogue: 0,0:20:54.79,0:20:55.62,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:57.46,0:21:00.09,Default,,0,0,0,,Қалғанының бәрі
Dialogue: 0,0:21:00.67,0:21:03.59,Default,,0,0,0,,Аспан теңізі құрлығы
Dialogue: 0,0:21:03.97,0:21:07.01,Default,,0,0,0,,Онда тіршілік ететін тіршілік иелері және адамдар
Dialogue: 0,0:21:07.14,0:21:11.14,Default,,0,0,0,,Барлығы шындықта бар және шынайы.
Dialogue: 0,0:21:16.31,0:21:18.56,Default,,0,0,0,,Бұл дүниенің тұрғындары
Dialogue: 0,0:21:19.02,0:21:22.36,Default,,0,0,0,,Виртуалды емес, параллель дүниедегі жер адамы ма?
Dialogue: 0,0:21:36.96,0:21:39.71,Default,,0,0,0,,Біреуді өлтірді...
Dialogue: 0,0:21:41.34,0:21:47.34,Default,,0,0,0,,♪～
Dialogue: 0,0:23:03.50,0:23:09.51,Default,,0,0,0,,～♪
Dialogue: 0,0:23:10.97,0:23:13.01,Default,,0,0,0,,Салиқалы болыңыз.
Dialogue: 0,0:23:13.22,0:23:14.60,Default,,0,0,0,,Хехехе
Dialogue: 0,0:23:14.85,0:23:16.06,Default,,0,0,0,,Король Дик
Dialogue: 0,0:23:16.31,0:23:18.10,Default,,0,0,0,,Маған Бимсбургтың жауын ұстауға рұқсат етіңіз!
Dialogue: 0,0:23:18.23,0:23:19.18,Default,,0,0,0,,Сиқырлы түн!
Dialogue: 0,0:23:19.52,0:23:20.94,Default,,0,0,0,,Жарықтандыру!
Dialogue: 0,0:23:25.27,0:23:27.86,Default,,0,0,0,,Оны қызыл жалынмен өртеп жібер!
Dialogue: 0,0:23:27.98,0:23:30.45,Default,,0,0,0,,Маджиха керемет оты!
Dialogue: 0,0:23:30.57,0:23:31.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:32.07,0:23:32.91,Default,,0,0,0,,Ha
Dialogue: 0,0:23:33.95,0:23:34.78,Default,,0,0,0,,Арман?
Dialogue: 0,0:23:35.28,0:23:37.70,Default,,0,0,0,,Маджиха осындай кезде келсе екен.
Dialogue: 0,0:23:37.95,0:23:39.25,Default,,0,0,0,,Мен сізге қоңырау шалдым ба?
Dialogue: 0,0:23:39.37,0:23:40.83,Default,,0,0,0,,Сіз емес!
Dialogue: 0,0:23:42.33,0:23:48.33,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory