Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:06.00,Default,,0,0,0,,♪～
Dialogue: 0,0:00:55.88,0:01:00.89,Default,,0,0,0,,～♪
Dialogue: 0,0:01:02.02,0:01:04.77,Default,,0,0,0,,Ммммм...
Dialogue: 0,0:01:05.10,0:01:07.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:09.27,0:01:10.44,Default,,0,0,0,,Хмм
Dialogue: 0,0:01:10.57,0:01:12.53,Default,,0,0,0,,Хмм, эй!
Dialogue: 0,0:01:12.65,0:01:14.49,Default,,0,0,0,,Уф! Ха...
Dialogue: 0,0:01:15.82,0:01:17.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:18.07,0:01:19.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:19.74,0:01:21.62,Default,,0,0,0,,Ах~ Жоқ~
Dialogue: 0,0:01:21.74,0:01:23.41,Default,,0,0,0,,Сіз не істеп жатырсыз? Хмм
Dialogue: 0,0:01:23.75,0:01:27.54,Default,,0,0,0,,А... жоқ, адам кейпіне қайта орала аламын ба... хехехе
Dialogue: 0,0:01:27.67,0:01:30.38,Default,,0,0,0,,Мичиру-чан, сен сөзсіз өзгердің.
Dialogue: 0,0:01:31.00,0:01:34.51,Default,,0,0,0,,Әй, одан гөрі маған қалалық әкімдіктен телефон соқты.
Dialogue: 0,0:01:34.63,0:01:35.84,Default,,0,0,0,,Итке ұнайтын бірдеңе берейік
Dialogue: 0,0:01:39.84,0:01:42.85,Default,,0,0,0,,Бұл Кагемори мырзаның жануарларды тіркеу картасы және сақтандыру картасы.
Dialogue: 0,0:01:43.22,0:01:45.35,Default,,0,0,0,,Процедура Себебі мен оны әлі де көргім келеді
Dialogue: 0,0:01:45.48,0:01:47.89,Default,,0,0,0,,Медициналық орталықтағы жарылыс оқиғасы үшін рахмет
Dialogue: 0,0:01:48.02,0:01:49.81,Default,,0,0,0,,Сіз көп қиындыққа тап болдыңыз.
Dialogue: 0,0:01:49.94,0:01:51.31,Default,,0,0,0,,Рахмет
Dialogue: 0,0:01:51.73,0:01:54.28,Default,,0,0,0,,Енді сіз де Анима Ситидің мүшесісіз
Dialogue: 0,0:01:54.98,0:01:56.86,Default,,0,0,0,,Аңдар қаласына қош келдіңіз
Dialogue: 0,0:01:56.99,0:01:59.66,Default,,0,0,0,,А... иә
Dialogue: 0,0:01:59.78,0:02:00.74,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:02:01.37,0:02:02.70,Default,,0,0,0,,Мен мұны саған қайтарамын.
Dialogue: 0,0:02:03.12,0:02:05.16,Default,,0,0,0,,Жарайды, сақтаңыз.
Dialogue: 0,0:02:05.29,0:02:07.33,Default,,0,0,0,,Бірақ мен оны пайдалана алмаймын.
Dialogue: 0,0:02:07.75,0:02:11.25,Default,,0,0,0,,Интернетке қосыла алмаймын, солай ма?
Dialogue: 0,0:02:11.38,0:02:14.30,Default,,0,0,0,,Қанша тырыссаңыз да, қалалық әкімдіктің веб-сайты пайда болады.
Dialogue: 0,0:02:14.75,0:02:18.68,Default,,0,0,0,,Иә, Анима қаласы Beastman арнайы аймағының арнайы заңына негізделген.
Dialogue: 0,0:02:18.80,0:02:21.05,Default,,0,0,0,,Адамзат қоғамы туралы ақпаратты шектеу
Dialogue: 0,0:02:21.18,0:02:22.18,Default,,0,0,0,,Бұл алдау
Dialogue: 0,0:02:22.85,0:02:26.14,Default,,0,0,0,,Мичиру-сан, мұны есте сақтаңыз, өйткені бұл жақсы мүмкіндік.
Dialogue: 0,0:02:29.35,0:02:33.82,Default,,0,0,0,,Жыртқыш аңдар Жыртқыштар Хомо сапиенстен басқа адамдар.
Dialogue: 0,0:02:33.94,0:02:36.23,Default,,0,0,0,,«Аң факторы» деп аталатын арнайы генге байланысты
Dialogue: 0,0:02:36.36,0:02:39.32,Default,,0,0,0,,Денені өзгерте алады
Dialogue: 0,0:02:39.45,0:02:43.32,Default,,0,0,0,,Ежелгі заманда әр тайпа...
Dialogue: 0,0:02:43.45,0:02:45.87,Default,,0,0,0,,Өзін жануар құдайына ұқсатты
Dialogue: 0,0:02:46.41,0:02:48.96,Default,,0,0,0,,Құдайға жақын болғың келді.
Dialogue: 0,0:02:49.08,0:02:49.83,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:02:50.25,0:02:53.75,Default,,0,0,0,,Демек, аңға айналған жануарларды ата-бабалары анықтайды.
Dialogue: 0,0:02:53.88,0:02:55.30,Default,,0,0,0,,Арыстанның күшігі – арыстан
Dialogue: 0,0:02:55.84,0:02:57.17,Default,,0,0,0,,Нәсіларалық неке жағдайында -
Dialogue: 0,0:02:57.30,0:02:59.76,Default,,0,0,0,,Ата-ананың бірінің қасиетіне айналады
Dialogue: 0,0:02:59.88,0:03:00.84,Default,,0,0,0,,Туған нәрсе -
Dialogue: 0,0:03:00.97,0:03:03.05,Default,,0,0,0,,Не арыстан, не жолбарыс
Dialogue: 0,0:03:03.18,0:03:05.51,Default,,0,0,0,,Ешқашан лигер болма
Dialogue: 0,0:03:05.97,0:03:08.60,Default,,0,0,0,,Одан да хайуандық факторы жоқ адамдар...
Dialogue: 0,0:03:08.73,0:03:10.98,Default,,0,0,0,,Жануарға айналу мүмкін емес.
Dialogue: 0,0:03:11.90,0:03:13.44,Default,,0,0,0,,Мен дұрыс шоғырлана алмай жатырмын—
Dialogue: 0,0:03:13.98,0:03:18.15,Default,,0,0,0,,Иә, мүмкін емес нәрсе сіздің басыңыздан өтті.
Dialogue: 0,0:03:20.82,0:03:23.32,Default,,0,0,0,,Жыртқыштар әрқашан гомо сапиенс болған...
Dialogue: 0,0:03:23.45,0:03:26.28,Default,,0,0,0,,Мен адамдармен араласудан аулақ болып өмір сүрдім.
Dialogue: 0,0:03:26.41,0:03:29.50,Default,,0,0,0,,Ормандар мен таулар, оқшауланған аралдар, шөлдер...
Dialogue: 0,0:03:29.91,0:03:32.62,Default,,0,0,0,,Алайда адамның қоршаған ортаның дамуына байланысты-
Dialogue: 0,0:03:32.75,0:03:35.46,Default,,0,0,0,,Өзімді көрсетуден басқа амалым қалмады.
Dialogue: 0,0:03:36.54,0:03:39.26,Default,,0,0,0,,Жануар адамдар өздерінің бар екенін ашқаннан кейін...
Dialogue: 0,0:03:39.38,0:03:43.89,Default,,0,0,0,,Түрлі қақтығыстар болғанымен, Анима қаласы әйтеуір құрылды.
Dialogue: 0,0:03:44.01,0:03:45.80,Default,,0,0,0,,Сосын сен келдің
Dialogue: 0,0:03:45.93,0:03:46.68,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:03:47.14,0:03:49.39,Default,,0,0,0,,Мен сіздің гендеріңізді зерттедім.
Dialogue: 0,0:03:49.52,0:03:51.64,Default,,0,0,0,,Қарапайым хайуандық факторлардан айырмашылығы
Dialogue: 0,0:03:52.10,0:03:57.77,Default,,0,0,0,,Тұрақсыз болғанымен, пішіні өзгерген кезде жарылғыш жасушаның бөлінуі жүреді
Dialogue: 0,0:03:57.90,0:04:01.65,Default,,0,0,0,,Өз қалауыңыз бойынша пішініңізді өзгертуге болатын себебі де осы шығар деп ойлаймын.
Dialogue: 0,0:04:01.78,0:04:03.61,Default,,0,0,0,,Бұл әлі де гипотеза.
Dialogue: 0,0:04:03.74,0:04:04.82,Default,,0,0,0,,Ол емделе ме?
Dialogue: 0,0:04:04.95,0:04:06.41,Default,,0,0,0,,Осы уақытқа дейін бұл әлі түсініксіз
Dialogue: 0,0:04:07.16,0:04:09.12,Default,,0,0,0,,Маған тағы біраз уақыт беріңізші.
Dialogue: 0,0:04:09.24,0:04:12.29,Default,,0,0,0,,Әзірше мен хайуанаттар бағында қиналып жүрмін.
Dialogue: 0,0:04:12.41,0:04:13.37,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:04:15.88,0:04:19.30,Default,,0,0,0,,Мен бір нәрсені түсінгендей сезінемін, түсінбейтін сияқтымын...
Dialogue: 0,0:04:19.71,0:04:22.80,Default,,0,0,0,,Мен мұны қолдануға болмайтынын білемін, бірақ
Dialogue: 0,0:04:22.92,0:04:24.72,Default,,0,0,0,,Сәлем, Тануки-чан!
Dialogue: 0,0:04:24.84,0:04:27.39,Default,,0,0,0,,О, бұл Уизельдің (Мари) күзені.
Dialogue: 0,0:04:27.51,0:04:30.47,Default,,0,0,0,,Менде одан да жақсы нәрсе бар, сіз қарап шыққыңыз келе ме?
Dialogue: 0,0:04:30.60,0:04:32.52,Default,,0,0,0,,Жоқ, бұл жақсы.
Dialogue: 0,0:04:32.64,0:04:34.52,Default,,0,0,0,,Не?
Dialogue: 0,0:04:36.35,0:04:37.90,Default,,0,0,0,,Анима қаласының брандмауэрі-
Dialogue: 0,0:04:38.02,0:04:40.90,Default,,0,0,0,,Бұзылуы мүмкін заңсыз смартфондар?
Dialogue: 0,0:04:41.28,0:04:44.15,Default,,0,0,0,,тек SIM картасына 50% жеңілдік
Dialogue: 0,0:04:44.28,0:04:46.41,Default,,0,0,0,,Бұл дәл қазір уақыт бойынша сатылым...
Dialogue: 0,0:04:46.70,0:04:48.53,Default,,0,0,0,,Ах... иә (Мари) 10 9...
Dialogue: 0,0:04:48.66,0:04:49.66,Default,,0,0,0,,Бірақ менде ақша бар...
Dialogue: 0,0:04:49.66,0:04:50.99,Default,,0,0,0,,Бірақ менде ақша бар...
Dialogue: 0,0:04:49.66,0:04:50.99,Default,,0,0,0,,８ ７…
Dialogue: 0,0:04:50.99,0:04:51.12,Default,,0,0,0,,８ ７…
Dialogue: 0,0:04:51.12,0:04:52.54,Default,,0,0,0,,８ ７…
Dialogue: 0,0:04:51.12,0:04:52.54,Default,,0,0,0,,Төлей аламын ба?
Dialogue: 0,0:04:52.66,0:04:54.29,Default,,0,0,0,,Маған емес, Широ-санға.
Dialogue: 0,0:05:00.92,0:05:04.55,Default,,0,0,0,,Жақында қызым маған ашуланып, электронды темекіге көштім...
Dialogue: 0,0:05:04.67,0:05:06.26,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:05:06.38,0:05:07.43,Default,,0,0,0,,Онда мен сізді арттан сәл итермелеуге тура келеді —
Dialogue: 0,0:05:07.84,0:05:10.85,Default,,0,0,0,,Медициналық керек-жарақтар Кім жіберілетініне қарай...
Dialogue: 0,0:05:10.97,0:05:13.27,Default,,0,0,0,,Аххх!
Dialogue: 0,0:05:13.39,0:05:15.64,Default,,0,0,0,,Ширу Огами бақылаған
Dialogue: 0,0:05:15.77,0:05:18.40,Default,,0,0,0,,Бұл нағыз мәселе.
Dialogue: 0,0:05:18.52,0:05:19.94,Default,,0,0,0,,Сәлем Құсақабе
Dialogue: 0,0:05:20.06,0:05:23.82,Default,,0,0,0,,Бір әзіл де қоя алмайтын адам мұны қалай істейді?
Dialogue: 0,0:05:24.28,0:05:25.82,Default,,0,0,0,,Әй!
Dialogue: 0,0:05:27.41,0:05:29.32,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:31.62,0:05:34.20,Default,,0,0,0,,Flip Менің ол кісіге қатысым бар.
Dialogue: 0,0:05:37.21,0:05:38.17,Default,,0,0,0,,Бұл апат апат па, әлде бір зұлымның бүлігі ме
Dialogue: 0,0:05:39.08,0:05:42.00,Default,,0,0,0,,Мен де өз ісімді аяқтаған жоқпын.
Dialogue: 0,0:05:46.17,0:05:47.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:51.14,0:05:52.01,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:05:54.89,0:05:56.31,Default,,0,0,0,,О, тоқта...
Dialogue: 0,0:05:56.43,0:05:57.31,Default,,0,0,0,,Цк
Dialogue: 0,0:06:04.78,0:06:08.11,Default,,0,0,0,,Сіздің бизнесіңіз жойылды.
Dialogue: 0,0:06:18.00,0:06:19.04,Default,,0,0,0,,Ах
Dialogue: 0,0:06:30.38,0:06:31.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:33.35,0:06:34.51,Default,,0,0,0,,Жылы Жыны
Dialogue: 0,0:06:34.64,0:06:36.47,Default,,0,0,0,,Кенеттен сыртқа шығуға тура келгенде...
Dialogue: 0,0:06:36.77,0:06:38.27,Default,,0,0,0,,Бұл өте қиын, солай емес пе?
Dialogue: 0,0:06:38.39,0:06:41.73,Default,,0,0,0,,Мұндай жағдайларда біз ұсынылған косметиканы енгіземіз.
Dialogue: 0,0:06:41.85,0:06:43.52,Default,,0,0,0,,Тіпті өте қысқа уақытқа...
Dialogue: 0,0:06:43.65,0:06:45.36,Default,,0,0,0,,Нәтиже сіз оған жүрегіңізді салған сияқтысыз.
Dialogue: 0,0:06:45.48,0:06:46.86,Default,,0,0,0,,Эру дауысы: Ей, ей, сонша қорғанысқа көшпе.
Dialogue: 0,0:06:52.24,0:06:53.57,Default,,0,0,0,,Онда адамдар тұрады ма?
Dialogue: 0,0:06:57.25,0:06:59.12,Default,,0,0,0,,Міне, мен бүгін негіз ретінде пайдаландым...
Dialogue: 0,0:06:59.25,0:07:00.21,Default,,0,0,0,,Бұл! Ах
Dialogue: 0,0:07:01.08,0:07:02.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:02.58,0:07:04.13,Default,,0,0,0,,Мм... Кешіріңіз.
Dialogue: 0,0:07:04.67,0:07:05.80,Default,,0,0,0,,Егер мені өлтірсең, сен де менің сияқты қарғыс атқан жанға айналасың.
Dialogue: 0,0:07:05.92,0:07:07.21,Default,,0,0,0,,Уф
Dialogue: 0,0:07:10.88,0:07:11.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:12.93,0:07:14.30,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:07:14.60,0:07:16.35,Default,,0,0,0,,Е, бұл не! ?
Dialogue: 0,0:07:16.47,0:07:17.77,Default,,0,0,0,,Ей, сен, кішкентай бүлікші.
Dialogue: 0,0:07:18.18,0:07:20.73,Default,,0,0,0,,Сізге жас ханымға жақындауға кім бұйырды?
Dialogue: 0,0:07:21.14,0:07:23.73,Default,,0,0,0,,Мм... жас ханым кім?
Dialogue: 0,0:07:24.81,0:07:26.32,Default,,0,0,0,,(Үлкен сағаттың соққы дыбысы)
Dialogue: 0,0:07:27.36,0:07:29.19,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:07:30.78,0:07:32.32,Default,,0,0,0,,Егер ойында жеңбесең
Dialogue: 0,0:07:32.45,0:07:37.54,Default,,0,0,0,,Менің ойымша, ол оның Отбасының қызы екенін білгеннен кейін оған жақындады.
Dialogue: 0,0:07:37.66,0:07:40.12,Default,,0,0,0,,Отбасы? иә?
Dialogue: 0,0:07:41.87,0:07:43.12,Default,,0,0,0,,Өте кешіріңіз, бірақ бізді бұны басқа уақытта жалғастыруға тура келеді.
Dialogue: 0,0:07:43.46,0:07:44.96,Default,,0,0,0,,Сол кездегі бандылар тобы?
Dialogue: 0,0:07:45.08,0:07:46.75,Default,,0,0,0,,Бірдеңе есіңе түскен сияқты.
Dialogue: 0,0:07:46.88,0:07:47.96,Default,,0,0,0,,Уф, енді түкіріңіз!
Dialogue: 0,0:07:48.09,0:07:50.34,Default,,0,0,0,,Жас ханымға жақындаудағы мақсат не?
Dialogue: 0,0:07:50.47,0:07:53.51,Default,,0,0,0,,Жоқ, жоқ! Мен жай ғана жүзіне қарадым...
Dialogue: 0,0:07:53.63,0:07:55.05,Default,,0,0,0,,Бет көрінісі! ? (Мичиру Пеликан) Иә?
Dialogue: 0,0:07:55.47,0:07:57.18,Default,,0,0,0,,Бет келбеті Сіз білесіз бе?
Dialogue: 0,0:07:57.47,0:07:58.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:59.02,0:08:01.06,Default,,0,0,0,,Мен мұнда өткен күні келдім.
Dialogue: 0,0:08:01.35,0:08:03.02,Default,,0,0,0,,Сонымен, сіз ел ішінде болдыңыз ба?
Dialogue: 0,0:08:03.14,0:08:05.61,Default,,0,0,0,,Сооооо!
Dialogue: 0,0:08:07.06,0:08:10.99,Default,,0,0,0,,Шынымен бе? қайда? Токио? Шибуя? Хараджуку? Омотесандо?
Dialogue: 0,0:08:11.11,0:08:12.74,Default,,0,0,0,,Көбірек ауылдық жерлер...
Dialogue: 0,0:08:12.86,0:08:14.86,Default,,0,0,0,,Мен Нинамын, сен ше?
Dialogue: 0,0:08:14.99,0:08:16.62,Default,,0,0,0,,Мичиру
Dialogue: 0,0:08:17.20,0:08:19.74,Default,,0,0,0,,Сіз хайуан едіңіз...
Dialogue: 0,0:08:19.87,0:08:22.00,Default,,0,0,0,,Бұл оның адамға ұқсайтынын білдіре ме?
Dialogue: 0,0:08:22.25,0:08:23.92,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:24.04,0:08:26.46,Default,,0,0,0,,Интернетте өзімді адам етіп көрсетемін.
Dialogue: 0,0:08:26.58,0:08:28.67,Default,,0,0,0,,Жалған жарқыраған аңшы
Dialogue: 0,0:08:28.79,0:08:29.96,Default,,0,0,0,,Қазір түс.
Dialogue: 0,0:08:34.34,0:08:36.26,Default,,0,0,0,,Әй, сенің әкең...
Dialogue: 0,0:08:37.68,0:08:39.60,Default,,0,0,0,,Мен әкемді жек көремін
Dialogue: 0,0:08:39.93,0:08:41.22,Default,,0,0,0,,Бұл ата
Dialogue: 0,0:08:41.72,0:08:44.27,Default,,0,0,0,,Мен туылғанға дейін адамдар басып алған...
Dialogue: 0,0:08:44.39,0:08:47.73,Default,,0,0,0,,Әкем оны соя тұздығына қайнатып жегенін айтады.
Dialogue: 0,0:08:47.86,0:08:48.69,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:08:49.02,0:08:52.15,Default,,0,0,0,,Дұрыс~ Бұлай болуы мүмкін емес.
Dialogue: 0,0:08:52.28,0:08:54.82,Default,,0,0,0,,Күні кеше мен адам музыкасын тыңдайтынымды білдім...
Dialogue: 0,0:08:54.95,0:08:56.66,Default,,0,0,0,,Маған қазір шығуға рұқсат жоқ.
Dialogue: 0,0:08:57.16,0:08:59.45,Default,,0,0,0,,Бұл әдепсіз және зиянды.
Dialogue: 0,0:09:00.08,0:09:02.12,Default,,0,0,0,,Иә, мен саған жақсы нәрсе көрсетемін.
Dialogue: 0,0:09:03.12,0:09:05.08,Default,,0,0,0,,Бұл менің қазынам!
Dialogue: 0,0:09:05.50,0:09:09.04,Default,,0,0,0,,Жағада шайылып кеткендер мен кәдесый ретінде алғандарым.
Dialogue: 0,0:09:09.71,0:09:12.00,Default,,0,0,0,,Ностальгиялық? Сіз мұны білесіз бе?
Dialogue: 0,0:09:12.38,0:09:14.22,Default,,0,0,0,,Бір ғана кесек шайылған сияқты.
Dialogue: 0,0:09:14.80,0:09:17.80,Default,,0,0,0,,Кабель жоқ, солай ма? Арғы жағында не бар?
Dialogue: 0,0:09:20.43,0:09:25.43,Default,,0,0,0,,(«ТҮНГІ ЖҮРГІЗУ» құлаққапта ойнайды)
Dialogue: 0,0:09:37.86,0:09:40.91,Default,,0,0,0,,Ах! Тыңдау алдында диета ұстайсыз ба?
Dialogue: 0,0:09:41.03,0:09:42.74,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:09:42.87,0:09:45.75,Default,,0,0,0,,Е... хахаха... хехехе...
Dialogue: 0,0:09:46.08,0:09:49.17,Default,,0,0,0,,Мичиру басқалардан мүлде бөлек.
Dialogue: 0,0:09:49.29,0:09:52.92,Default,,0,0,0,,Мұнда келгендер арғы жағы туралы айтқысы келмейді.
Dialogue: 0,0:09:53.84,0:09:55.26,Default,,0,0,0,,Қайтып оралғыңыз келе ме?
Dialogue: 0,0:10:03.18,0:10:06.39,Default,,0,0,0,,Бірақ мен бұлай қарап қайта алмаймын.
Dialogue: 0,0:10:09.19,0:10:10.61,Default,,0,0,0,,Мен қайтқым келеді
Dialogue: 0,0:10:12.32,0:10:13.07,Default,,0,0,0,,Мичиру?
Dialogue: 0,0:10:13.52,0:10:15.53,Default,,0,0,0,,Иә? Ха! ?
Dialogue: 0,0:10:15.90,0:10:18.99,Default,,0,0,0,,Мен қайтып келдім... Мен қайттым? Неге! ?
Dialogue: 0,0:10:19.11,0:10:20.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:20.82,0:10:22.83,Default,,0,0,0,,Оның құйрығы болмағандықтан, саңылаулардан өте алады!
Dialogue: 0,0:10:23.03,0:10:24.49,Default,,0,0,0,,Қалпақ киюге де болады!
Dialogue: 0,0:10:24.62,0:10:27.50,Default,,0,0,0,,Ахаха! Алақай!
Dialogue: 0,0:10:28.46,0:10:32.21,Default,,0,0,0,,Иә, бұл нағыз мен.
Dialogue: 0,0:10:33.09,0:10:34.96,Default,,0,0,0,,Сіз үнемі аңға айналдыңыз ба? иә?
Dialogue: 0,0:10:35.38,0:10:37.80,Default,,0,0,0,,А-а, мм... у... иә!
Dialogue: 0,0:10:37.92,0:10:40.38,Default,,0,0,0,,Адам кейпіне қалай оралу керектігін ұмытып қалдым.
Dialogue: 0,0:10:40.51,0:10:42.35,Default,,0,0,0,,Сонымен мен үйге бара аламын ба? иә?
Dialogue: 0,0:10:43.22,0:10:44.81,Default,,0,0,0,,Сіз ішке кіре аласыз!
Dialogue: 0,0:10:53.31,0:10:54.19,Default,,0,0,0,,Нина-чан
Dialogue: 0,0:10:55.61,0:10:57.15,Default,,0,0,0,,Күте тұрыңыз, Нина-чан
Dialogue: 0,0:10:59.95,0:11:02.66,Default,,0,0,0,,Білесің бе, Face Look-тегі Лиза есімді қыз...
Dialogue: 0,0:11:02.78,0:11:04.91,Default,,0,0,0,,Олар үй кешін өткізіп жатыр.
Dialogue: 0,0:11:05.16,0:11:07.12,Default,,0,0,0,,Мені шақырып жатыр.
Dialogue: 0,0:11:08.91,0:11:11.04,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:11:11.17,0:11:13.38,Default,,0,0,0,,Менің арқама мін, сонда боласың.
Dialogue: 0,0:11:13.50,0:11:15.84,Default,,0,0,0,,Жақын арада қайтып келгенше, ешқандай проблема болмайды.
Dialogue: 0,0:11:17.84,0:11:20.51,Default,,0,0,0,,Онда неге сонша барғың келеді?
Dialogue: 0,0:11:22.22,0:11:26.60,Default,,0,0,0,,Мен өмір бойы тек осы қаланы білгім келмейді.
Dialogue: 0,0:11:26.72,0:11:28.27,Default,,0,0,0,,Және...
Dialogue: 0,0:11:30.68,0:11:32.73,Default,,0,0,0,,Өйткені ол жарқыраған
Dialogue: 0,0:11:45.24,0:11:46.37,Default,,0,0,0,,Хехе
Dialogue: 0,0:11:47.20,0:11:48.87,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,0:11:49.58,0:11:51.33,Default,,0,0,0,,Нина-чан
Dialogue: 0,0:11:51.83,0:11:55.29,Default,,0,0,0,,Әкем қайтып келді~ Хахаха...
Dialogue: 0,0:11:55.84,0:11:57.71,Default,,0,0,0,,Нина-чан
Dialogue: 0,0:11:58.30,0:11:59.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:00.63,0:12:01.47,Default,,0,0,0,,Нина-чан?
Dialogue: 0,0:12:02.76,0:12:03.93,Default,,0,0,0,,Меніңше, бұл матч…
Dialogue: 0,0:12:08.26,0:12:09.35,Default,,0,0,0,,(Айналдыру)
Dialogue: 0,0:12:13.48,0:12:15.27,Default,,0,0,0,,Мен ойлағаннан да алыс болды.
Dialogue: 0,0:12:18.02,0:12:19.53,Default,,0,0,0,,Мұндай жағдайда бәрін маған қалдыр.
Dialogue: 0,0:12:23.15,0:12:24.95,Default,,0,0,0,,Бұл қауіпті, мен жасыруым керек.
Dialogue: 0,0:12:25.07,0:12:26.74,Default,,0,0,0,,(Дос) Не? «Chōzetsu Zekkyō Keikaku 5 (Бес)» деген бар ма?
Dialogue: 0,0:12:26.87,0:12:29.62,Default,,0,0,0,,Сондай-ақ аң аулайтын полицейлер де бар.
Dialogue: 0,0:12:29.74,0:12:30.70,Default,,0,0,0,,Жарайсыңдар балалар
Dialogue: 0,0:12:31.75,0:12:35.04,Default,,0,0,0,,Бұл жерде қараңғы, абай болыңыз.
Dialogue: 0,0:12:35.96,0:12:36.88,Default,,0,0,0,,Е...
Dialogue: 0,0:12:37.00,0:12:39.17,Default,,0,0,0,,Мичиру тым көп уайымдайды
Dialogue: 0,0:12:39.30,0:12:41.01,Default,,0,0,0,,Мұнда қалай аман қалдыңыз?
Dialogue: 0,0:12:44.59,0:12:46.84,Default,,0,0,0,,А, мінекей.
Dialogue: 0,0:12:52.68,0:12:53.89,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:12:57.81,0:12:58.73,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:13:01.23,0:13:03.57,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:13:04.24,0:13:09.03,Default,,0,0,0,,(Дене музыкасы)
Dialogue: 0,0:13:09.16,0:13:11.04,Default,,0,0,0,,(әйелдердің әйел дауысы)
Dialogue: 0,0:13:21.30,0:13:26.30,Default,,0,0,0,,(«ТҮНГІ ЖҮРГІЗУ» динамиктен ойнатылады)
Dialogue: 0,0:13:28.51,0:13:29.39,Default,,0,0,0,,Ах
Dialogue: 0,0:13:41.40,0:13:43.28,Default,,0,0,0,,Мичиру... Ах.
Dialogue: 0,0:13:43.86,0:13:46.86,Default,,0,0,0,,Макаронның дәмі осылай болды.
Dialogue: 0,0:13:48.11,0:13:50.78,Default,,0,0,0,,О, не болды? Сенімен бәрі жақсы ма?
Dialogue: 0,0:13:51.78,0:13:53.79,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:13:54.83,0:13:57.41,Default,,0,0,0,,Келгеніңіз жақсы болды... иә?
Dialogue: 0,0:13:58.00,0:14:00.38,Default,,0,0,0,,Иә, қайтып келгеніме қуаныштымын.
Dialogue: 0,0:14:00.83,0:14:02.09,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:02.59,0:14:04.09,Default,,0,0,0,,Сәлем, Нина-чан? Ах
Dialogue: 0,0:14:04.59,0:14:05.59,Default,,0,0,0,,Бұл Нина Чан, солай ма?
Dialogue: 0,0:14:06.22,0:14:09.30,Default,,0,0,0,,Сіз шынымен келдіңіз. Сізбен тікелей эфирде бірінші рет кездесіп отырмын.
Dialogue: 0,0:14:09.43,0:14:12.05,Default,,0,0,0,,Иә, мүмкін Лиза?
Dialogue: 0,0:14:12.18,0:14:14.22,Default,,0,0,0,,Ақыры кездестік!
Dialogue: 0,0:14:15.77,0:14:17.98,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:14:19.06,0:14:20.69,Default,,0,0,0,,Уф... О, жоқ!
Dialogue: 0,0:14:22.65,0:14:25.61,Default,,0,0,0,,Өтірік... Өтірік өтірік Өтірік!
Dialogue: 0,0:14:25.99,0:14:30.57,Default,,0,0,0,,Нина хайуан болды ма? Бұл дельфин, өте сүйкімді!
Dialogue: 0,0:14:30.87,0:14:32.24,Default,,0,0,0,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:14:32.62,0:14:33.78,Default,,0,0,0,,Барлығы маған көмектессін
Dialogue: 0,0:14:33.91,0:14:35.70,Default,,0,0,0,,Матто! А... А?
Dialogue: 0,0:14:36.20,0:14:37.16,Default,,0,0,0,,Барлығы тыңдайды
Dialogue: 0,0:14:37.79,0:14:41.63,Default,,0,0,0,,Бүгінгі жыртқыш киім кешіне лайықты қонақ келді.
Dialogue: 0,0:14:41.75,0:14:43.84,Default,,0,0,0,,Жыртқыш... Нина-чан!
Dialogue: 0,0:14:43.96,0:14:47.46,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:14:47.59,0:14:50.55,Default,,0,0,0,,Сіз ұмыттыңыз ба? Мен оны саған қарызға беремін
Dialogue: 0,0:14:51.14,0:14:55.85,Default,,0,0,0,,Кемсітушілікке қарсы күрескен Нина-чанның осы уақытқа дейін көрген азабы мен азабы қандай?
Dialogue: 0,0:14:55.97,0:14:58.02,Default,,0,0,0,,Біз елестете алмаймыз
Dialogue: 0,0:14:58.73,0:15:00.52,Default,,0,0,0,,Бұл ауырған болуы керек.
Dialogue: 0,0:15:00.64,0:15:03.15,Default,,0,0,0,,Не? Жоқ, мен емес...
Dialogue: 0,0:15:03.27,0:15:07.23,Default,,0,0,0,,Мықты өмір сүретін Нина-чанның сұлулығы мен батылдығын мадақтаймыз!
Dialogue: 0,0:15:07.36,0:15:12.36,Default,,0,0,0,,(Адамдар қол соғып, қол шапалақтайды)
Dialogue: 0,0:15:15.58,0:15:17.20,Default,,0,0,0,,Уау...
Dialogue: 0,0:15:19.37,0:15:20.96,Default,,0,0,0,,Широ-сан телефоны
Dialogue: 0,0:15:21.75,0:15:26.09,Default,,0,0,0,,Огами-кун, сен Мичирудың қазір кім және қайда екенін білесің бе?
Dialogue: 0,0:15:26.84,0:15:29.55,Default,,0,0,0,,Мен сол жерде Флиптің қызымен ойнап жатырмын.
Dialogue: 0,0:15:30.01,0:15:32.51,Default,,0,0,0,,Егер отбасы анықтаса...
Dialogue: 0,0:15:32.64,0:15:34.01,Default,,0,0,0,,Бұл қиын болады
Dialogue: 0,0:15:34.51,0:15:38.02,Default,,0,0,0,,Қандай да бір қиындық туындамас бұрын мен оны үйіне апаруым керек дейсіз бе?
Dialogue: 0,0:15:38.14,0:15:39.68,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:40.64,0:15:41.48,Default,,0,0,0,,Я...
Dialogue: 0,0:15:48.94,0:15:51.74,Default,,0,0,0,,Уф! (тежегіш дыбысы)
Dialogue: 0,0:15:52.57,0:15:55.20,Default,,0,0,0,,Ақымақ! Өлгің келсе, басқа жерде өл!
Dialogue: 0,0:15:55.70,0:15:57.16,Default,,0,0,0,,Төңкерудің қолданылуы бар
Dialogue: 0,0:16:00.25,0:16:02.37,Default,,0,0,0,,Мен қазір бос емеспін.
Dialogue: 0,0:16:03.08,0:16:05.75,Default,,0,0,0,,Сіз адамдармен соғысуды жоспарлап отырсыз ба?
Dialogue: 0,0:16:06.50,0:16:07.96,Default,,0,0,0,,Сонда не істеуіміз керек?
Dialogue: 0,0:16:08.63,0:16:10.42,Default,,0,0,0,,Мен қызымды қайтарамын.
Dialogue: 0,0:16:11.01,0:16:12.38,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:16:12.80,0:16:16.93,Default,,0,0,0,,Сіз мұны маған қалдырасыз ба, әлде бір-бірімізбен осы жерде және қазір айналысамыз ба?
Dialogue: 0,0:16:17.05,0:16:18.10,Default,,0,0,0,,Маған таңдауға рұқсат етіңіз
Dialogue: 0,0:16:18.68,0:16:21.56,Default,,0,0,0,,Хмф... Түн ортасына дейін күтемін.
Dialogue: 0,0:16:21.98,0:16:25.81,Default,,0,0,0,,Осы уақытқа дейін қайтып келмесек, бәрімізді ұсақтап тастаймыз.
Dialogue: 0,0:16:29.86,0:16:30.99,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:16:32.53,0:16:37.53,Default,,0,0,0,,(Барлығы қуанады)
Dialogue: 0,0:16:41.04,0:16:43.00,Default,,0,0,0,,Сіз жаңа көргеніңізді көрдіңіз бе?
Dialogue: 0,0:16:43.41,0:16:46.79,Default,,0,0,0,,Нина-чан, қазір үйге қайтайық. Неліктен?
Dialogue: 0,0:16:47.25,0:16:50.13,Default,,0,0,0,,Білмеймін... Білмеймін дегенмен
Dialogue: 0,0:16:50.25,0:16:52.05,Default,,0,0,0,,Басқа нәрсе бар ма?
Dialogue: 0,0:16:52.17,0:16:54.76,Default,,0,0,0,,Бұл менің қайтқым келген жер емес.
Dialogue: 0,0:16:55.18,0:16:57.89,Default,,0,0,0,,Неліктен? Барлығы жақсы емес
Dialogue: 0,0:16:58.01,0:17:01.72,Default,,0,0,0,,Бәлкім Нинаға ғана ұнамайтын шығар, себебі ол танымал болды?
Dialogue: 0,0:17:02.18,0:17:03.52,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:17:03.64,0:17:07.48,Default,,0,0,0,,Ондай жағдайда Мичиру да хайуан деп айтуға болады.
Dialogue: 0,0:17:07.60,0:17:09.94,Default,,0,0,0,,Мен үйге бармаймын.
Dialogue: 0,0:17:10.07,0:17:11.07,Default,,0,0,0,,Ах
Dialogue: 0,0:17:19.78,0:17:23.08,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:17:24.71,0:17:28.13,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:17:28.25,0:17:29.13,Default,,0,0,0,,Иә
Dialogue: 0,0:17:29.71,0:17:32.96,Default,,0,0,0,,Сіз Анима қаласынан кетесіз бе, жоқ па, білмеймін.
Dialogue: 0,0:17:33.09,0:17:33.96,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:17:34.80,0:17:37.13,Default,,0,0,0,,Бірақ Флиптің қызы тез арада үйіне барсын.
Dialogue: 0,0:17:37.26,0:17:39.76,Default,,0,0,0,,Не? Сіз қалай білесіз?
Dialogue: 0,0:17:39.89,0:17:43.39,Default,,0,0,0,,Флип адамдарға қарсы соғыс бастауға алаңдайды.
Dialogue: 0,0:17:43.52,0:17:46.89,Default,,0,0,0,,Мен сол портқа бара жатырмын, сондықтан оған дейін бірдеңе жасаңыз.
Dialogue: 0,0:17:47.02,0:17:47.85,Default,,0,0,0,,Тек жалаңаш, бос жер учаскесін қалдырады…
Dialogue: 0,0:17:47.98,0:17:49.31,Default,,0,0,0,,Е, күте тұр... Мен... Кенет...
Dialogue: 0,0:17:49.31,0:17:50.06,Default,,0,0,0,,Е, күте тұр... Мен... Кенет...
Dialogue: 0,0:17:49.31,0:17:50.06,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,0:17:50.06,0:17:50.19,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,0:17:50.19,0:17:51.02,Default,,0,0,0,,Цубаки қыз.
Dialogue: 0,0:17:50.19,0:17:51.02,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:52.15,0:17:54.49,Default,,0,0,0,,Сіз оны біреуге қалдырасыз...
Dialogue: 0,0:17:54.61,0:17:56.40,Default,,0,0,0,,Қар жауа ма?
Dialogue: 0,0:17:56.82,0:17:58.41,Default,,0,0,0,,О, Құдай-ай…
Dialogue: 0,0:17:58.53,0:18:01.12,Default,,0,0,0,,Нағыз аң адамды бірінші рет көріп тұрмын.
Dialogue: 0,0:18:01.24,0:18:02.62,Default,,0,0,0,,Мен де~
Dialogue: 0,0:18:03.29,0:18:08.04,Default,,0,0,0,,Бірақ бұл шынымен қорқынышты емес пе? Бұл жануардың жартысы сияқты, солай ма?
Dialogue: 0,0:18:08.17,0:18:12.54,Default,,0,0,0,,Эй~ Бірге тұру мүмкін емес~ Хаха
Dialogue: 0,0:18:16.38,0:18:18.01,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,0:18:21.18,0:18:22.60,Default,,0,0,0,,Не істеп жатырсың! ?
Dialogue: 0,0:18:22.72,0:18:26.68,Default,,0,0,0,,Нина-чан шаршады, сондықтан мен оны теңіз суына салып көрейін деп ойладым.
Dialogue: 0,0:18:27.23,0:18:28.89,Default,,0,0,0,,Өйткені бұл дельфин, солай ма?
Dialogue: 0,0:18:29.44,0:18:30.85,Default,,0,0,0,,Ах
Dialogue: 0,0:18:33.11,0:18:35.28,Default,,0,0,0,,Ах, Нина-чан
Dialogue: 0,0:18:35.40,0:18:36.24,Default,,0,0,0,,Нина-чан!
Dialogue: 0,0:18:37.65,0:18:38.78,Default,,0,0,0,,Әй!
Dialogue: 0,0:18:38.90,0:18:39.95,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:41.37,0:18:42.57,Default,,0,0,0,,Хмф!
Dialogue: 0,0:18:43.08,0:18:44.58,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:45.12,0:18:50.25,Default,,0,0,0,,Адамдар өмір бойы жүрек тереңдерін өзгелерден жасырып өтеді.
Dialogue: 0,0:18:53.88,0:18:57.51,Default,,0,0,0,,Уряаааааааа!
Dialogue: 0,0:19:06.77,0:19:09.06,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:19:09.18,0:19:11.15,Default,,0,0,0,,Ах... (адам болған дыбыс)
Dialogue: 0,0:19:13.48,0:19:14.90,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:19:16.36,0:19:19.07,Default,,0,0,0,,Қазір үйге қайтайық. Иә...
Dialogue: 0,0:19:23.53,0:19:26.20,Default,,0,0,0,,Сол жігіт… Көзіне латкі таққан Какужа ма?
Dialogue: 0,0:19:38.55,0:19:39.42,Default,,0,0,0,,Мичиру...
Dialogue: 0,0:19:40.47,0:19:42.93,Default,,0,0,0,,Кешіріңіз, жоқ.
Dialogue: 0,0:19:43.05,0:19:44.89,Default,,0,0,0,,Кешіріңіз, иә?
Dialogue: 0,0:19:45.39,0:19:47.85,Default,,0,0,0,,Адам әлеміне бармасам...
Dialogue: 0,0:19:47.97,0:19:49.85,Default,,0,0,0,,Қалағаныңызша қала аласыз.
Dialogue: 0,0:19:51.19,0:19:53.52,Default,,0,0,0,,Мен оны тоқтатуым керек еді.
Dialogue: 0,0:19:54.02,0:19:57.57,Default,,0,0,0,,Мен сізді ерекше ұнатпаймын.
Dialogue: 0,0:19:58.73,0:20:01.82,Default,,0,0,0,,Өйткені оның жарқырап тұрғаны рас еді.
Dialogue: 0,0:20:02.24,0:20:03.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:03.91,0:20:04.78,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:06.45,0:20:07.74,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:15.29,0:20:16.13,Default,,0,0,0,,Сіз-
Dialogue: 0,0:20:17.34,0:20:19.96,Default,,0,0,0,,Ол жаққа қайта барғың келмей ме?
Dialogue: 0,0:20:20.09,0:20:23.38,Default,,0,0,0,,Дұрыс, мен бір күні Анима қаласынан кетемін.
Dialogue: 0,0:20:24.13,0:20:26.72,Default,,0,0,0,,Бірақ қазір емес
Dialogue: 0,0:20:27.10,0:20:30.27,Default,,0,0,0,,Мен барлық аңдар туралы көбірек білгім келеді.
Dialogue: 0,0:20:30.39,0:20:32.52,Default,,0,0,0,,Менің ойымша, білуім керек
Dialogue: 0,0:20:33.69,0:20:37.61,Default,,0,0,0,,Сондықтан мен әлі де сол қалада болғым келеді.
Dialogue: 0,0:20:39.07,0:20:41.99,Default,,0,0,0,,Рұқсатсыз мені кінәладың.
Dialogue: 0,0:20:42.40,0:20:43.53,Default,,0,0,0,,Еңбек ет және қайтар
Dialogue: 0,0:20:43.65,0:20:45.74,Default,,0,0,0,,Иә? Маған сыйлық беріңіз
Dialogue: 0,0:20:45.86,0:20:48.16,Default,,0,0,0,,Бүгін менің туған күнім. (Широу) Мен білмеймін.
Dialogue: 0,0:20:48.28,0:20:49.70,Default,,0,0,0,,Сараң (Широу) Сараң ба?
Dialogue: 0,0:20:49.83,0:20:51.95,Default,,0,0,0,,Сараң қасқыр (Широу) ұры енот ит
Dialogue: 0,0:20:52.08,0:20:53.58,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:21:03.05,0:21:06.80,Default,,0,0,0,,Жануардан, өлмейтін денеден жоғары өзгеру қабілеті...
Dialogue: 0,0:21:07.64,0:21:10.26,Default,,0,0,0,,Мен оны кәдімгі хайуан емес деп ойлаймын.
Dialogue: 0,0:21:11.01,0:21:12.72,Default,,0,0,0,,Бұл екі адам
Dialogue: 0,0:21:24.49,0:21:25.61,Default,,0,0,0,,Ах
Dialogue: 0,0:21:47.76,0:21:49.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:51.39,0:21:56.39,Default,,0,0,0,,♪～
Dialogue: 0,0:22:45.40,0:22:50.41,Default,,0,0,0,,～♪
