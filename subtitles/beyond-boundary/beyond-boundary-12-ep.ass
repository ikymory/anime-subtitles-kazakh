Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Бұл субтитр білім беру және алмасу үшін пайдалануға арналған, коммерциялық пайдалануға тыйым салынған құдай субтитрлерінің тіркесімі болып табылады.
Dialogue: 0,0:00:08.03,0:00:09.03,Default,,0,0,0,,Аға
Dialogue: 0,0:00:10.01,0:00:12.04,Default,,0,0,0,,Мұнда не үшін келдің?
Dialogue: 0,0:00:12.09,0:00:15.06,Default,,0,0,0,,Үлкен ағаң келсе, мағынасыз болады, солай ма?
Dialogue: 0,0:00:16.01,0:00:17.04,Default,,0,0,0,,Мен не үшінмін?
Dialogue: 0,0:00:17.04,0:00:18.03,Default,,0,0,0,,бұл мәселе болар еді.
Dialogue: 0,0:00:19.01,0:00:21.03,Default,,0,0,0,,Өтінемін, өмір сүріңіз
Dialogue: 0,0:00:22.00,0:00:25.01,Default,,0,0,0,,Сенпай, қарапайым адам болып кетші.
Dialogue: 0,0:00:25.05,0:00:26.09,Default,,0,0,0,,Кім мұны қалайды?
Dialogue: 0,0:00:27.01,0:00:28.06,Default,,0,0,0,,Кім және қашан сұрады?
Dialogue: 0,0:00:30.00,0:00:30.50,Default,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,0:00:31.03,0:00:33.04,Default,,0,0,0,,Өте жағымсыз
Dialogue: 0,0:00:33.07,0:00:35.04,Default,,0,0,0,,Мен ыңғайсызданамын
Dialogue: 0,0:00:35.08,0:00:37.05,Default,,0,0,0,,Мен мұны бәрібір қабылдамаймын.
Dialogue: 0,0:00:38.00,0:00:42.00,Default,,0,0,0,,Курияма-санның құрбандығына салынған өмір мен болашақ қандай?
Dialogue: 0,0:00:42.08,0:00:44.01,Default,,0,0,0,,Ештеңені білдірмейді
Dialogue: 0,0:00:44.07,0:00:46.04,Default,,0,0,0,,Сіз мұны түсінбейсіз бе?
Dialogue: 0,0:00:49.02,0:00:52.03,Default,,0,0,0,,Сіз мұны білмедіңіз бе?
Dialogue: 0,0:01:00.00,0:01:03.05,Default,,0,0,0,,Мен сені осында кездестіремін деп ойламаппын Яйой Канбара
Dialogue: 0,0:01:03.07,0:01:05.01,Default,,0,0,0,,Біраз уақыт өтті
Dialogue: 0,0:01:05.04,0:01:07.03,Default,,0,0,0,,Субұрқақ та үлкейді
Dialogue: 0,0:01:07.08,0:01:08.05,Default,,0,0,0,,Мен тепкім келеді
Dialogue: 0,0:01:09.01,0:01:10.01,Default,,0,0,0,,Мақсаты не?
Dialogue: 0,0:01:10.06,0:01:12.05,Default,,0,0,0,,Акито Канбара деген не?
Dialogue: 0,0:01:13.00,0:01:15.04,Default,,0,0,0,,Не? Аккун - Якчанның ұлы Пён.
Dialogue: 0,0:01:16.01,0:01:18.08,Default,,0,0,0,,Ұлым десем де, лас деп айтпаймын.
Dialogue: 0,0:01:20.07,0:01:22.01,Default,,0,0,0,,Бұл тағы бір тұзақ болуы мүмкін бе?
Dialogue: 0,0:01:22.04,0:01:25.09,Default,,0,0,0,,Уайымдама, сен жасамасаң да мен жасадым.
Dialogue: 0,0:01:26.02,0:01:27.04,Default,,0,0,0,,Сұрақтарға жауап беріңіз
Dialogue: 0,0:01:28.01,0:01:29.05,Default,,0,0,0,,Өлмейтін жартылай жын дегеніміз не?
Dialogue: 0,0:01:29.09,0:01:31.02,Default,,0,0,0,,Сіз нені мақсат етесіз?
Dialogue: 0,0:01:31.06,0:01:33.09,Default,,0,0,0,,Мұндай қызықсыз нәрселерді тыңдауға қалай дәтің бар?
Dialogue: 0,0:01:34.01,0:01:35.08,Default,,0,0,0,,Субұрқақ та қызықсыз болды
Dialogue: 0,0:01:36.06,0:01:38.09,Default,,0,0,0,,Жалықтыратын ересек адам болып өссең жақсы емес.
Dialogue: 0,0:01:40.08,0:01:42.05,Default,,0,0,0,,Мен ешкімге ғашық болған емеспін
Dialogue: 0,0:01:43.05,0:01:43.55,Default,,0,0,0,,Изуми
Dialogue: 0,0:01:45.05,0:01:46.03,Default,,0,0,0,,Изуми апа
Dialogue: 0,0:01:49.04,0:01:50.00,Default,,0,0,0,,Қуыршақ
Dialogue: 0,0:01:51.05,0:01:55.00,Default,,0,0,0,,Қашанға дейін бұл балаларға үлкендермен араласуға рұқсат бересіз?
Dialogue: 0,0:01:55.06,0:01:58.00,Default,,0,0,0,,Басқа әлем қауымдастығы қазірдің өзінде жұмыс істейді.
Dialogue: 0,0:02:03.04,0:02:05.00,Default,,0,0,0,,Хирууми-кун Мизуки-чан
Dialogue: 0,0:02:05.06,0:02:08.08,Default,,0,0,0,,Акито мен Мираи-чан жай сен және шетелдіктер емес.
Dialogue: 0,0:02:09.01,0:02:10.03,Default,,0,0,0,,Бұл ерекше болмыс.
Dialogue: 0,0:02:13.03,0:02:14.04,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:02:15.04,0:02:16.00,Default,,0,0,0,,Жалғасы
Dialogue: 0,0:02:16.00,0:02:16.50,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:02:18.01,0:02:18.51,Default,,0,0,0,,Қазір
Dialogue: 0,0:02:20.09,0:02:22.05,Default,,0,0,0,,Сол жарық бірінші болып тұрған жоқ па?
Dialogue: 0,0:02:23.01,0:02:26.03,Default,,0,0,0,,«Youmu» деп айту тым бос сөз болар еді.
Dialogue: 0,0:02:26.09,0:02:27.08,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:02:28.01,0:02:30.06,Default,,0,0,0,,Бастапқыда мен үлкендер арасында болдым.
Dialogue: 0,0:02:31.02,0:02:32.06,Default,,0,0,0,,Бұл орталық
Dialogue: 0,0:02:33.00,0:02:36.01,Default,,0,0,0,,Ішінде не бар, мұнда бардың бәрі бар.
Dialogue: 0,0:02:38.01,0:02:40.05,Default,,0,0,0,,Соңғы кездері иығым қатайғанын түсінуге болады.
Dialogue: 0,0:02:40.07,0:02:42.06,Default,,0,0,0,,Бұл әзілдейтін уақыт емес.
Dialogue: 0,0:02:49.06,0:02:51.08,Default,,0,0,0,,Сенпай, бірдеңе түсіндің бе?
Dialogue: 0,0:02:52.00,0:02:52.50,Default,,0,0,0,,Не?
Dialogue: 0,0:02:53.03,0:02:54.06,Default,,0,0,0,,Бұл әлсіздік.
Dialogue: 0,0:02:55.01,0:02:58.07,Default,,0,0,0,,Қараңыз Мысалы, менің ағам сияқты менің қолтығым әлсіз.
Dialogue: 0,0:02:59.00,0:03:01.07,Default,,0,0,0,,Оның қолтығы қайда?
Dialogue: 0,0:03:02.04,0:03:04.08,Default,,0,0,0,,Сонда сізге ұнамайтын нәрсе жоқ па?
Dialogue: 0,0:03:05.02,0:03:06.03,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:03:06.08,0:03:08.00,Default,,0,0,0,,Бұл сіз жек көретін нәрсе ме?
Dialogue: 0,0:03:10.05,0:03:11.08,Default,,0,0,0,,Шишамо балалармен
Dialogue: 0,0:03:12.09,0:03:15.04,Default,,0,0,0,,Шишамо балалармен
Dialogue: 0,0:03:17.05,0:03:18.04,Default,,0,0,0,,Сіз ашулысыз ба?
Dialogue: 0,0:03:18.04,0:03:19.07,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:03:32.00,0:03:32.50,Default,,0,0,0,,Курияма мырза
Dialogue: 0,0:03:47.06,0:03:48.08,Default,,0,0,0,,Менің қазіргі ағам
Dialogue: 0,0:03:49.03,0:03:50.00,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:03:51.05,0:03:53.08,Default,,0,0,0,,Бұл қол елес болуы мүмкін бе?
Dialogue: 0,0:03:57.01,0:03:59.04,Default,,0,0,0,,Бұл youmu тас шекарадан тыс
Dialogue: 0,0:04:00.02,0:04:02.00,Default,,0,0,0,,Ол менің үлкендерімнің бір бөлігі болды.
Dialogue: 0,0:04:02.07,0:04:03.03,Default,,0,0,0,,Иә
Dialogue: 0,0:04:04.00,0:04:08.04,Default,,0,0,0,,Сенпай, шекарадан тыс биліктің бір бөлігі сіздің қолыңызда.
Dialogue: 0,0:04:09.00,0:04:10.01,Default,,0,0,0,,Мен қалай екенін білмеймін
Dialogue: 0,0:04:10.08,0:04:13.06,Default,,0,0,0,,Бірақ ағаның күші тең болса
Dialogue: 0,0:04:15.02,0:04:17.07,Default,,0,0,0,,Бұл жақынырақ қарап шығуға тұрарлық сияқты.
Dialogue: 0,0:04:18.07,0:04:20.08,Default,,0,0,0,,Сіз әлі тамақ ішпеген сияқтысыз.
Dialogue: 0,0:04:21.04,0:04:24.01,Default,,0,0,0,,Шекарадан тыс Youmu соншалықты күшті ме?
Dialogue: 0,0:04:24.06,0:04:27.07,Default,,0,0,0,,Әлде Мирай Курияманың еркі соншалықты күшті ме?
Dialogue: 0,0:04:28.00,0:04:29.06,Default,,0,0,0,,Бұл, әрине, соңғысы, солай емес пе?
Dialogue: 0,0:04:32.01,0:04:34.04,Default,,0,0,0,,Ей, ол жақсы адам емес.
Dialogue: 0,0:04:35.00,0:04:36.07,Default,,0,0,0,,Бұл менің ісім емес.
Dialogue: 0,0:04:38.00,0:04:40.00,Default,,0,0,0,,Сіздің күш-жігеріңіздің арқасында
Dialogue: 0,0:04:40.05,0:04:42.05,Default,,0,0,0,,Менің біраз күш-қуатым қайтып кеткен сияқты.
Dialogue: 0,0:04:43.00,0:04:44.08,Default,,0,0,0,,Тоқта, мен сені ұрамын.
Dialogue: 0,0:04:44.08,0:04:45.07,Default,,0,0,0,,Сіз емес
Dialogue: 0,0:04:49.05,0:04:50.09,Default,,0,0,0,,Бүгін кеш.
Dialogue: 0,0:04:51.04,0:04:52.07,Default,,0,0,0,,Мен көптен күттім.
Dialogue: 0,0:05:03.07,0:05:05.04,Default,,0,0,0,,Сіз әлдеқайда күшті болдыңыз, солай емес пе?
Dialogue: 0,0:05:05.09,0:05:08.03,Default,,0,0,0,,Мен сізге арналған бос көлеңкені алдым.
Dialogue: 0,0:05:08.06,0:05:10.05,Default,,0,0,0,,Ақыры жақсы көріне бастады.
Dialogue: 0,0:05:25.05,0:05:29.00,Default,,0,0,0,,Кешіріңіз, әпкеммен араласқан адам...
Dialogue: 0,0:05:29.02,0:05:31.05,Default,,0,0,0,,Оны жойғанша аңдыу принципін ұстаныңыз.
Dialogue: 0,0:05:33.01,0:05:34.03,Default,,0,0,0,,Бірге үш?
Dialogue: 0,0:05:34.08,0:05:36.09,Default,,0,0,0,,Жоқ, төртке бір.
Dialogue: 0,0:05:37.02,0:05:37.52,Default,,0,0,0,,Мицуки
Dialogue: 0,0:05:38.04,0:05:42.06,Default,,0,0,0,,Мен ең кенжесі болғандықтан, кішкентай кезімнен үйде отырдым.
Dialogue: 0,0:05:42.08,0:05:45.02,Default,,0,0,0,,Мен сені еш ойланбастан бітіремін.
Dialogue: 0,0:05:45.07,0:05:46.02,Default,,0,0,0,,Келісім
Dialogue: 0,0:05:47.07,0:05:50.04,Default,,0,0,0,,Ол орақ алғашында маған аманат болған.
Dialogue: 0,0:05:50.06,0:05:52.06,Default,,0,0,0,,Мен де жауаптымын.
Dialogue: 0,0:05:53.01,0:05:56.04,Default,,0,0,0,,Біз жақсы араласып кеткен сияқтымыз.
Dialogue: 0,0:05:59.03,0:06:00.00,Default,,0,0,0,,Әпке
Dialogue: 0,0:06:00.00,0:06:00.50,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:06:04.07,0:06:07.00,Default,,0,0,0,,Енді мен сенің жолыңа кедергі жасамаймын.
Dialogue: 0,0:06:07.05,0:06:08.07,Default,,0,0,0,,Қанша уақыт?
Dialogue: 0,0:06:09.04,0:06:10.03,Default,,0,0,0,,Тағы бір дем
Dialogue: 0,0:06:13.05,0:06:15.00,Default,,0,0,0,,Жарайды, кілт кептеліп қалды.
Dialogue: 0,0:06:15.03,0:06:17.08,Default,,0,0,0,,Эй, сенде үлкен лицензия бар ма?
Dialogue: 0,0:06:18.06,0:06:20.00,Default,,0,0,0,,This isn't a public road.
Dialogue: 0,0:06:20.02,0:06:21.09,Default,,0,0,0,,Курияма мырза да кемеге тез қонды.
Dialogue: 0,0:06:22.02,0:06:23.05,Default,,0,0,0,,Эй, қазірдің өзінде
Dialogue: 0,0:06:25.04,0:06:26.01,Default,,0,0,0,,Онда?
Dialogue: 0,0:06:26.09,0:06:28.04,Default,,0,0,0,,Менің алдымда Юму тұр.
Dialogue: 0,0:06:29.01,0:06:30.00,Default,,0,0,0,,Сондай-ақ төменде
Dialogue: 0,0:06:39.08,0:06:41.02,Default,,0,0,0,,Курияма мырза күткендей
Dialogue: 0,0:06:41.06,0:06:43.04,Default,,0,0,0,,Осылайша сіз жай ғана жалғастыра аласыз.
Dialogue: 0,0:06:44.00,0:06:45.01,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:06:45.09,0:06:47.06,Default,,0,0,0,,But the accelerator is fully open.
Dialogue: 0,0:06:47.09,0:06:48.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:48.06,0:06:49.03,Default,,0,0,0,,Ойласам, ол бәріне белгілі нәрсе ғой.
Dialogue: 0,0:06:50.04,0:06:53.03,Default,,0,0,0,,Тоқтасақ та, дер кезінде жете алмаймыз.
Dialogue: 0,0:06:55.00,0:06:55.50,Default,,0,0,0,,Аға
Dialogue: 0,0:07:12.09,0:07:15.05,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:07:26.08,0:07:27.05,Default,,0,0,0,,Аға
Dialogue: 0,0:07:34.04,0:07:35.07,Default,,0,0,0,,Тым кездейсоқ
Dialogue: 0,0:07:36.02,0:07:38.04,Default,,0,0,0,,Бұл жердің өмір сүруінің өзі кездейсоқ.
Dialogue: 0,0:07:38.08,0:07:41.03,Default,,0,0,0,,Былайша айтқанда, менің ағам тек ақымақ.
Dialogue: 0,0:07:41.03,0:07:42.01,Default,,0,0,0,,Мен бе?
Dialogue: 0,0:07:45.07,0:07:47.05,Default,,0,0,0,,But I managed to get there.
Dialogue: 0,0:07:48.08,0:07:49.07,Default,,0,0,0,,Бұл
Dialogue: 0,0:07:50.09,0:07:51.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:55.05,0:07:56.07,Default,,0,0,0,,Арғы жағы да шыдамсыз.
Dialogue: 0,0:07:56.07,0:07:57.06,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:07:57.06,0:07:58.03,Default,,0,0,0,,Тұр, мен өзі қандай ұлтпын? Хехехе
Dialogue: 0,0:07:59.04,0:08:01.08,Default,,0,0,0,,But I feel that way.
Dialogue: 0,0:08:02.08,0:08:04.03,Default,,0,0,0,,I'm sure it will work out somehow.
Dialogue: 0,0:08:04.08,0:08:07.02,Default,,0,0,0,,Курияма-санға ұқсамайды.
Dialogue: 0,0:08:07.07,0:08:09.03,Default,,0,0,0,,I don't know about that.
Dialogue: 0,0:08:10.05,0:08:11.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:08:14.06,0:08:16.00,Default,,0,0,0,,Курияманың болашағы қазір
Dialogue: 0,0:08:16.04,0:08:18.08,Default,,0,0,0,,It's unpleasantly positive.
Dialogue: 0,0:08:23.05,0:08:25.04,Default,,0,0,0,,What unnecessary things are you saying?
Dialogue: 0,0:08:25.06,0:08:28.04,Default,,0,0,0,,Сіз оны шынымен естіп жатырсыз ба?
Dialogue: 0,0:08:28.09,0:08:30.05,Default,,0,0,0,,Қылмыс деңгейінің төмендегені туралы сол мәлімдеме...
Dialogue: 0,0:08:56.00,0:08:58.08,Default,,0,0,0,,Курияма-сан, жүр.
Dialogue: 0,0:09:28.02,0:09:29.00,Default,,0,0,0,,Курияма мырза
Dialogue: 0,0:09:29.07,0:09:30.03,Default,,0,0,0,,Акки
Dialogue: 0,0:09:32.03,0:09:33.05,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:09:34.04,0:09:37.01,Default,,0,0,0,,Шекарадан тыс Мираи Куриямадан босатылды
Dialogue: 0,0:09:37.08,0:09:40.07,Default,,0,0,0,,Ол барлық жындарды жұтып, үлкен құйынға айналады.
Dialogue: 0,0:09:41.02,0:09:42.06,Default,,0,0,0,,Әлемді құрту
Dialogue: 0,0:09:43.06,0:09:46.05,Default,,0,0,0,,Енді не істеуіміз керек, Изуми мырза?
Dialogue: 0,0:09:52.00,0:09:52.50,Default,,0,0,0,,Райнер, кейін кездескенше.
Dialogue: 0,0:09:53.09,0:09:54.07,Default,,0,0,0,,Курияма мырза
Dialogue: 0,0:09:55.04,0:09:57.06,Default,,0,0,0,,Курияма мырза Курияма мырза
Dialogue: 0,0:10:02.07,0:10:03.05,Default,,0,0,0,,Мені өлтірме
Dialogue: 0,0:10:03.08,0:10:04.09,Default,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 0,0:10:04.09,0:10:05.06,Default,,0,0,0,,Канжу Нагаре
Dialogue: 0,0:10:05.06,0:10:06.02,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:10:06.02,0:10:07.03,Default,,0,0,0,,(Мадо) Бірақ… (Иба) Мадо!
Dialogue: 0,0:10:07.03,0:10:09.00,Default,,0,0,0,,Мені көлік қағып кетсе де Бұл менікі
Dialogue: 0,0:10:11.04,0:10:12.03,Default,,0,0,0,,Аға
Dialogue: 0,0:10:16.08,0:10:20.09,Default,,0,0,0,,Ініңіз де, қарындасыңыз да өзіңіз сияқты табанды.
Dialogue: 0,0:10:24.02,0:10:25.03,Default,,0,0,0,,Бауырым, жүр.
Dialogue: 0,0:10:25.05,0:10:26.00,Default,,0,0,0,,Мицуки
Dialogue: 0,0:10:26.04,0:10:29.06,Default,,0,0,0,,Осы жерде Изуми-ни-самаға қалдырсам, бұрынғыдай болады.
Dialogue: 0,0:10:29.09,0:10:30.09,Default,,0,0,0,,Ештеңе өзгермейді.
Dialogue: 0,0:10:32.01,0:10:33.00,Default,,0,0,0,,Эден мектебіне қабылдау нәтижелері
Dialogue: 0,0:10:34.00,0:10:36.03,Default,,0,0,0,,Оны ағаңа қалдыр.
Dialogue: 0,0:10:37.07,0:10:39.03,Default,,0,0,0,,Хироми Сенпай жиіркенішті
Dialogue: 0,0:10:39.04,0:10:40.01,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:10:43.06,0:10:45.05,Default,,0,0,0,,Неге сонша асығасың?
Dialogue: 0,0:10:46.07,0:10:50.00,Default,,0,0,0,,Ол жүзді, мен сенің жүзіңді көргім келді.
Dialogue: 0,0:10:50.04,0:10:52.04,Default,,0,0,0,,қорқып, шыдамсыз
Dialogue: 0,0:10:52.06,0:10:54.03,Default,,0,0,0,,Бір нәрсені жөндеп жатқанда
Dialogue: 0,0:10:55.01,0:10:57.03,Default,,0,0,0,,Мені жеңуге тырысқан фигура
Dialogue: 0,0:10:57.03,0:10:58.01,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:10:58.02,0:10:59.06,Default,,0,0,0,,Сіз соншалықты қорқасыз ба?
Dialogue: 0,0:10:59.08,0:11:02.08,Default,,0,0,0,,А, мен саған ұнайтын шығармын?
Dialogue: 0,0:11:04.00,0:11:07.07,Default,,0,0,0,,Әлде ағаңның өткеніңді білгенін қаламайсың ба?
Dialogue: 0,0:11:10.07,0:11:11.04,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:11:12.03,0:11:13.09,Default,,0,0,0,,Юмуға бағынған бөтен адам
Dialogue: 0,0:11:14.02,0:11:15.06,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:11:16.02,0:11:18.00,Default,,0,0,0,,Бастапқыда сол тесіктегі цикада
Dialogue: 0,0:11:18.03,0:11:21.00,Default,,0,0,0,,Біз сізді денемізде ұстайтын адамдар емеспіз бе?
Dialogue: 0,0:11:21.07,0:11:23.08,Default,,0,0,0,,Білдім, аға.
Dialogue: 0,0:11:26.00,0:11:26.50,Default,,0,0,0,,Изуми апа
Dialogue: 0,0:11:29.08,0:11:30.05,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:11:30.08,0:11:32.05,Default,,0,0,0,,Тыныш, үндеме, үндеме
Dialogue: 0,0:11:38.08,0:11:40.03,Default,,0,0,0,,Бұл шынымен де солай болуы мүмкін
Dialogue: 0,0:11:41.00,0:11:45.02,Default,,0,0,0,,Бірақ мен адам ретінде мақтанышымды әлі тастаған жоқпын.
Dialogue: 0,0:11:46.03,0:11:47.07,Default,,0,0,0,,Мұны сізбен жасамаңыз
Dialogue: 0,0:11:49.06,0:11:52.01,Default,,0,0,0,,Бос сөз айтпаңыз.
Dialogue: 0,0:11:59.08,0:12:00.03,Default,,0,0,0,,Апа
Dialogue: 0,0:12:04.09,0:12:05.09,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:06.04,0:12:10.00,Default,,0,0,0,,Шұңқыр көлеңкеде пайда болғанға ұқсас нәрсе болуы мүмкін.
Dialogue: 0,0:12:11.09,0:12:12.09,Default,,0,0,0,,Хироми Сенпай
Dialogue: 0,0:12:14.05,0:12:15.01,Default,,0,0,0,,Юи
Dialogue: 0,0:12:15.02,0:12:16.06,Default,,0,0,0,,Курияма мырза, көзіңізді жұмыңыз.
Dialogue: 0,0:12:17.06,0:12:18.04,Default,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:12:20.01,0:12:20.51,Default,,0,0,0,,Иә
Dialogue: 0,0:12:24.00,0:12:25.00,Default,,0,0,0,,Алданбаңыз
Dialogue: 0,0:12:26.04,0:12:31.00,Default,,0,0,0,,Олар сенді адамдардың жүрегіндегі бұрмалаушылық пен жек көрушіліктің көрінісі дейді.
Dialogue: 0,0:12:33.00,0:12:36.04,Default,,0,0,0,,Жүрегіміздің әлсіздігі формада көрінеді.
Dialogue: 0,0:12:37.03,0:12:39.03,Default,,0,0,0,,Мен мұны алғаш кездескен кезде айтқанмын.
Dialogue: 0,0:12:40.01,0:12:41.04,Default,,0,0,0,,Мен де солаймын
Dialogue: 0,0:12:42.03,0:12:44.02,Default,,0,0,0,,Мен Курияма мырзаның қасындамын
Dialogue: 0,0:12:45.06,0:12:46.07,Default,,0,0,0,,Біз кездестік
Dialogue: 0,0:12:47.03,0:12:48.04,Default,,0,0,0,,Әлем өзгерді
Dialogue: 0,0:12:49.08,0:12:52.00,Default,,0,0,0,,Өткен өкініштеріңізбен айналыспаңыз
Dialogue: 0,0:12:53.03,0:12:55.08,Default,,0,0,0,,Курияма мырза енді жалғыз емес.
Dialogue: 0,0:12:59.07,0:13:01.02,Default,,0,0,0,,Менде Курияма-сан бар
Dialogue: 0,0:13:02.04,0:13:03.02,Default,,0,0,0,,Аға
Dialogue: 0,0:13:03.09,0:13:04.05,Default,,0,0,0,,Көзіңді аш
Dialogue: 0,0:13:12.06,0:13:15.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:19.00,0:13:19.50,Default,,0,0,0,,Мен сені жеңемін
Dialogue: 0,0:13:20.08,0:13:22.03,Default,,0,0,0,,Не? Мұның бәрі ме?
Dialogue: 0,0:13:22.05,0:13:23.08,Default,,0,0,0,,Басқа жол бар ма?
Dialogue: 0,0:13:29.05,0:13:30.04,Default,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,0:14:13.08,0:14:14.06,Default,,0,0,0,,Аяка-сан
Dialogue: 0,0:14:15.08,0:14:16.05,Default,,0,0,0,,Ай-чан
Dialogue: 0,0:14:17.00,0:14:18.00,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,0:14:49.05,0:14:51.05,Default,,0,0,0,,Сіз олардың бәрін жеңдіңіз бе?
Dialogue: 0,0:14:52.05,0:14:53.01,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:15:00.07,0:15:01.07,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:15:04.00,0:15:04.50,Default,,0,0,0,,О
Dialogue: 0,0:15:12.05,0:15:14.01,Default,,0,0,0,,Сіз неден қорқасыз?
Dialogue: 0,0:15:15.05,0:15:16.04,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:15:17.00,0:15:19.01,Default,,0,0,0,,Бәрің менікісіңдер
Dialogue: 0,0:15:20.03,0:15:23.05,Default,,0,0,0,,Мұның бәрі менің ішімде болды.
Dialogue: 0,0:15:24.00,0:15:26.02,Default,,0,0,0,,Сол қара қызғаныш та
Dialogue: 0,0:15:28.09,0:15:32.03,Default,,0,0,0,,Ешқашан адам болмаймын деген үмітсіздік
Dialogue: 0,0:15:32.05,0:15:34.01,Default,,0,0,0,,Тастап кетудің мұңы
Dialogue: 0,0:15:34.05,0:15:36.05,Default,,0,0,0,,Біреуді ренжіткені үшін өкіну
Dialogue: 0,0:15:37.01,0:15:38.00,Default,,0,0,0,,Аға
Dialogue: 0,0:15:38.00,0:15:39.08,Default,,0,0,0,,Өзімшілдік пен күдік
Dialogue: 0,0:15:39.08,0:15:41.03,Default,,0,0,0,,Жек көру және отставкаға кету
Dialogue: 0,0:15:41.03,0:15:43.00,Default,,0,0,0,,Қулық та, өзін-өзі сақтау да
Dialogue: 0,0:15:44.09,0:15:47.01,Default,,0,0,0,,Ештеңені сыртқа шығармаңыз
Dialogue: 0,0:15:47.05,0:15:50.01,Default,,0,0,0,,Бәрі менікі
Dialogue: 0,0:15:50.05,0:15:53.00,Default,,0,0,0,,Мен бәрін аламын.
Dialogue: 0,0:15:55.04,0:15:58.07,Default,,0,0,0,,Мен өлмейтін жартылай жынмын.
Dialogue: 0,0:16:11.03,0:16:12.01,Default,,0,0,0,,Аға
Dialogue: 0,0:16:23.02,0:16:26.08,Default,,0,0,0,,Сенпай, осында келе аласың ба?
Dialogue: 0,0:16:29.09,0:16:30.09,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:32.01,0:16:34.04,Default,,0,0,0,,Мм...м...
Dialogue: 0,0:16:34.07,0:16:35.03,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:16:36.05,0:16:39.08,Default,,0,0,0,,Менің сізден бір өтінішім бар.
Dialogue: 0,0:16:41.02,0:16:42.02,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:16:42.04,0:16:45.02,Default,,0,0,0,,2-эпизод: Буггарати келеді
Dialogue: 0,0:16:45.08,0:16:47.09,Default,,0,0,0,,Маған қолыңды бер
Dialogue: 0,0:16:48.09,0:16:49.03,Default,,0,0,0,,Hand?
Dialogue: 0,0:16:50.04,0:16:50.54,Default,,0,0,0,,Иә
Dialogue: 0,0:16:59.06,0:17:01.06,Default,,0,0,0,,Мені сипаңызшы
Dialogue: 0,0:17:02.04,0:17:04.05,Default,,0,0,0,,Мені сипағаныңды қалаймын.
Dialogue: 0,0:17:16.05,0:17:17.06,Default,,0,0,0,,Курияма мырза...
Dialogue: 0,0:17:18.03,0:17:20.06,Default,,0,0,0,,Рахмет айтыңыз
Dialogue: 0,0:17:23.06,0:17:24.04,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:24.07,0:17:26.04,Default,,0,0,0,,Мен шын жүректен емеспін
Dialogue: 0,0:17:29.07,0:17:30.06,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:37.00,0:17:37.50,Default,,0,0,0,,Мен бақыттымын.
Dialogue: 0,0:17:40.00,0:17:41.00,Default,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:17:41.09,0:17:42.06,Default,,0,0,0,,Курияма мырза
Dialogue: 0,0:17:43.07,0:17:46.08,Default,,0,0,0,,Мен бақыттымын Мен бақыттымын
Dialogue: 0,0:17:48.02,0:17:49.06,Default,,0,0,0,,Курияма мырзаның аяқтары
Dialogue: 0,0:17:50.05,0:17:53.07,Default,,0,0,0,,Шекараның арғы беті менің сенпайыма оралды.
Dialogue: 0,0:17:55.00,0:17:56.08,Default,,0,0,0,,Бұл жер құлағалы тұр.
Dialogue: 0,0:17:57.07,0:17:59.06,Default,,0,0,0,,Мен де жоғалып кететін шығармын.
Dialogue: 0,0:18:01.00,0:18:03.06,Default,,0,0,0,,Енді шекараның арғы жағы қарттардың арасына оралды
Dialogue: 0,0:18:04.04,0:18:06.03,Default,,0,0,0,,Мен өмір сүре алмауым керек
Dialogue: 0,0:18:07.03,0:18:10.04,Default,,0,0,0,,Нағыз мен баяғыда кетті.
Dialogue: 0,0:18:11.03,0:18:14.06,Default,,0,0,0,,Сізбен танысқаныма өте қуаныштымын.
Dialogue: 0,0:18:14.06,0:18:15.02,Default,,0,0,0,,Йосе
Dialogue: 0,0:18:15.08,0:18:19.03,Default,,0,0,0,,Сенпайға ғашық болғаныма өте қуаныштымын...
Dialogue: 0,0:18:19.03,0:18:20.07,Default,,0,0,0,,Айтпа.
Dialogue: 0,0:18:22.06,0:18:25.08,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:18:27.07,0:18:28.06,Default,,0,0,0,,Курияма мырза
Dialogue: 0,0:18:29.00,0:18:33.07,Default,,0,0,0,,Бұл өтірік. Күте тұрыңыз, Курияма-сан.
Dialogue: 0,0:18:35.00,0:18:35.50,Default,,0,0,0,,Курияма мырза
Dialogue: 0,0:18:51.00,0:18:53.01,Default,,0,0,0,,Ол алдын ала анықталды ма?
Dialogue: 0,0:18:53.05,0:18:56.07,Default,,0,0,0,,Әлде Курияма мырзаның еңбекқорлығынан ба, білмеймін.
Dialogue: 0,0:18:58.00,0:19:01.00,Default,,0,0,0,,Мен міндетті түрде соңғысын таңдар едім.
Dialogue: 0,0:19:01.09,0:19:05.02,Default,,0,0,0,,Қалай болғанда да, шекараның екінші жағы менің ішімде.
Dialogue: 0,0:19:05.09,0:19:07.08,Default,,0,0,0,,Дүниеде тыныштық орнады.
Dialogue: 0,0:19:08.07,0:19:11.02,Default,,0,0,0,,100 иен болмайды. 100 иен
Dialogue: 0,0:19:11.04,0:19:12.08,Default,,0,0,0,,О, дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,0:19:13.01,0:19:14.03,Default,,0,0,0,,Махаббат Қайырлы таң
Dialogue: 0,0:19:15.02,0:19:16.04,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:19:17.04,0:19:18.04,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:19:18.08,0:19:19.08,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:19:20.03,0:19:21.03,Default,,0,0,0,,Не? ұйықтау
Dialogue: 0,0:19:21.07,0:19:23.02,Default,,0,0,0,,Сакура-чан, қазір оян.
Dialogue: 0,0:19:23.02,0:19:25.01,Default,,0,0,0,,Youmu әлі де бар
Dialogue: 0,0:19:25.06,0:19:28.09,Default,,0,0,0,,Басқа әлем оны жеңіп, өмірін әдеттегідей жалғастырады.
Dialogue: 0,0:19:29.07,0:19:32.01,Default,,0,0,0,,Аяка мен Ай да бұрынғы үйлеріне қайтты.
Dialogue: 0,0:19:35.01,0:19:37.00,Default,,0,0,0,,Мироку Фудзиманың қайда екені белгісіз.
Dialogue: 0,0:19:37.03,0:19:40.00,Default,,0,0,0,,Ол басқа әлем қауымдастығы атауымен әрекет етті. Барлығы
Dialogue: 0,0:19:40.03,0:19:42.01,Default,,0,0,0,,жолында реттеледі
Dialogue: 0,0:19:43.01,0:19:46.06,Default,,0,0,0,,Хироми Изуми мырзаның орнына Назэ отбасын басқарады.
Dialogue: 0,0:19:46.08,0:19:48.07,Default,,0,0,0,,Бұл позицияны алуда өзгеріс болғанымен.
Dialogue: 0,0:19:49.04,0:19:51.05,Default,,0,0,0,,Өмірде ерекше өзгеріс болмайды.
Dialogue: 0,0:19:53.00,0:19:53.50,Default,,0,0,0,,Апа
Dialogue: 0,0:19:54.06,0:19:57.06,Default,,0,0,0,,Сен де түсінетін уақыт келеді.
Dialogue: 0,0:19:58.08,0:19:59.05,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:00.08,0:20:01.05,Default,,0,0,0,,Изуми апа
Dialogue: 0,0:20:02.07,0:20:04.05,Default,,0,0,0,,Мен әпкемді әрқашан жақсы көретінмін
Dialogue: 0,0:20:05.03,0:20:07.03,Default,,0,0,0,,Мен мұнда әпкемдей боламын деп келдім.
Dialogue: 0,0:20:08.01,0:20:08.51,Default,,0,0,0,,Бірақ тоқтаңыз
Dialogue: 0,0:20:09.07,0:20:11.03,Default,,0,0,0,,Мен әпкемдей болмаймын.
Dialogue: 0,0:20:12.01,0:20:12.51,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:20:13.06,0:20:15.00,Default,,0,0,0,,Идеалдармен әрекет ету
Dialogue: 0,0:20:15.04,0:20:16.09,Default,,0,0,0,,Ешқашан нәтиже бермесе де
Dialogue: 0,0:20:17.05,0:20:18.08,Default,,0,0,0,,Егер сіз идеалдарыңызды жоғалтсаңыз
Dialogue: 0,0:20:18.08,0:20:20.03,Default,,0,0,0,,Одан ештеңе шықпайды
Dialogue: 0,0:20:21.05,0:20:23.06,Default,,0,0,0,,Мен өзімді де, жақындарымды да қорғай алмаймын
Dialogue: 0,0:20:26.02,0:20:28.05,Default,,0,0,0,,Сен күштірек болдың, Хироми.
Dialogue: 0,0:20:31.07,0:20:34.08,Default,,0,0,0,,Жақсы, Хируами, сен Назе отбасысың.
Dialogue: 0,0:20:34.08,0:20:35.08,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:20:37.00,0:20:39.00,Default,,0,0,0,,Бұдан басқа, әзірге...
Dialogue: 0,0:20:40.00,0:20:42.01,Default,,0,0,0,,Мизуки әдеттегідей клуб бөлмесінде қалады.
Dialogue: 0,0:20:42.03,0:20:43.06,Default,,0,0,0,,Сіз мені қорлап жатырсыз.
Dialogue: 0,0:20:43.09,0:20:47.05,Default,,0,0,0,,Соңында зұлымдық жойылатынын білсек те.
Dialogue: 0,0:20:47.05,0:20:50.02,Default,,0,0,0,,Әрі қарай оқу уақытты босқа өткізу емес
Dialogue: 0,0:20:50.03,0:20:52.04,Default,,0,0,0,,Көңіл көтеру деген осы.
Dialogue: 0,0:20:53.04,0:20:54.04,Default,,0,0,0,,Тоқтау
Dialogue: 0,0:20:54.07,0:20:56.09,Default,,0,0,0,,Қыс қолды жылытатын мезгіл болса керек.
Dialogue: 0,0:20:57.04,0:20:59.00,Default,,0,0,0,,Табиғи емес ештеңе жоқ.
Dialogue: 0,0:20:59.00,0:21:00.04,Default,,0,0,0,,Үлкен құмырсқа жегіш
Dialogue: 0,0:21:00.04,0:21:01.01,Default,,0,0,0,,Үш ұпай
Dialogue: 0,0:21:05.05,0:21:07.08,Default,,0,0,0,,Бірақ Мираи Курияма жоқ.
Dialogue: 0,0:21:08.06,0:21:11.01,Default,,0,0,0,,Соңында мен жеңілдім.
Dialogue: 0,0:21:11.09,0:21:14.09,Default,,0,0,0,,Мираи Курияманың құрбандығына салынған болашақ.
Dialogue: 0,0:21:15.01,0:21:16.02,Default,,0,0,0,,Ештеңені білдірмейді
Dialogue: 0,0:21:17.03,0:21:21.05,Default,,0,0,0,,Айқайладым, енді мен өмір сүріп, сол болашақты қабылдаймын.
Dialogue: 0,0:21:22.08,0:21:24.09,Default,,0,0,0,,Курияма мырза сізге айтып қойған болуы керек.
Dialogue: 0,0:21:26.03,0:21:28.00,Default,,0,0,0,,«Зама-ми-ро»
Dialogue: 0,0:21:29.03,0:21:30.07,Default,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,0:21:41.04,0:21:43.01,Default,,0,0,0,,Түнде де жарық болсын
Dialogue: 0,0:21:43.07,0:21:45.05,Default,,0,0,0,,Күндіз де қараңғылық болатыны сияқты
Dialogue: 0,0:21:46.05,0:21:48.09,Default,,0,0,0,,Дүниеден қараңғылық ешқашан жоғалмайды
Dialogue: 0,0:21:49.09,0:21:53.02,Default,,0,0,0,,Сонымен бірге дүниені қараңғылық толтырмайды.
Dialogue: 0,0:21:54.02,0:21:56.00,Default,,0,0,0,,Осындай екіұшты түстермен
Dialogue: 0,0:21:56.04,0:21:59.03,Default,,0,0,0,,Барлығы ілгерілей береді және шешіледі.
Dialogue: 0,0:22:00.02,0:22:02.00,Default,,0,0,0,,Олардың ішінде И
Dialogue: 0,0:22:12.02,0:22:17.01,Default,,0,0,0,,Тыныштықты кесуге келген адам болды
Dialogue: 0,0:22:18.00,0:22:23.01,Default,,0,0,0,,Біз үшін сөзсіз кездесу
Dialogue: 0,0:22:23.06,0:22:25.09,Default,,0,0,0,,Өкінішті жылатқан көздер
Dialogue: 0,0:22:24.07,0:22:26.01,Default,,0,0,0,,2-эпизод: Буггарати келеді
Dialogue: 0,0:22:26.01,0:22:28.04,Default,,0,0,0,,Сіз осылайша көрініс табасыз
Dialogue: 0,0:22:28.06,0:22:34.08,Default,,0,0,0,,Әдемі гүлдеді, Мұңға оранып
Dialogue: 0,0:22:29.02,0:22:30.00,Default,,0,0,0,,Көзілдірік
Dialogue: 0,0:22:31.08,0:22:36.04,Default,,0,0,0,,Қысқасы, көзілдірік киген Курияма-санды жақсы көремін.
Dialogue: 0,0:22:35.02,0:22:39.03,Default,,0,0,0,,Біреудің өміріне балқыған гүл
Dialogue: 0,0:22:39.04,0:22:46.08,Default,,0,0,0,,Эй, сен де көре алатыныңа сенімдімін.
Dialogue: 0,0:22:48.01,0:22:49.01,Default,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,0:22:49.00,0:22:54.05,Default,,0,0,0,,Қайталанған қателерді қайта жазайық
Dialogue: 0,0:22:50.02,0:22:52.03,Default,,0,0,0,,Ол алдын ала анықталды ма?
Dialogue: 0,0:22:52.08,0:22:55.08,Default,,0,0,0,,Әлде Курияма мырзаның еңбекқорлығынан ба, білмеймін.
Dialogue: 0,0:22:54.06,0:22:59.09,Default,,0,0,0,,Бастапқы жолды қалағаныңызша қайталаңыз
Dialogue: 0,0:22:56.05,0:23:00.01,Default,,0,0,0,,Әлде Курияма мырзаға деген сезімім сізге жетті ме?
Dialogue: 0,0:23:00.03,0:23:05.08,Default,,0,0,0,,Өткеннен өзгеше ертең
Dialogue: 0,0:23:01.01,0:23:04.00,Default,,0,0,0,,Осылайша Мирай Курияма екеуміз қайта қауыштық.
Dialogue: 0,0:23:05.00,0:23:11.01,Default,,0,0,0,,Егер бұл екі адам бір реттік қарым-қатынаста болса ше? Екеумізге ғана үміт сызу, бастау сызығы
Dialogue: 0,0:23:08.08,0:23:12.00,Default,,0,0,0,,Бұл дүниеде барлық оқиғалар болуы мүмкін емес
Dialogue: 0,0:23:11.09,0:23:15.02,Default,,0,0,0,,Мен ешқашан қоштаспаймын
Dialogue: 0,0:23:13.01,0:23:14.07,Default,,0,0,0,,Аа, дұрыс, Курияма мырза.
Dialogue: 0,0:23:15.03,0:23:17.03,Default,,0,0,0,,Әрқашан солай Мен бір нәрсені ұмытып қалдым.
Dialogue: 0,0:23:22.06,0:23:26.00,Default,,0,0,0,,Мына көзілдірікті киіп бере аласыз ба?
Dialogue: 0,0:23:27.50,0:23:32.50,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
