Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:05.00,LOGO,,0,0,0,,Бұл субтитр білім беру және алмасу үшін пайдалануға арналған, коммерциялық пайдалануға тыйым салынған құдай субтитрлерінің тіркесімі болып табылады.
Dialogue: 0,0:00:05.00,0:00:10.00,LOGO,,0,0,0,,:&Hunter :& : : : : rivercrab
Dialogue: 0,0:00:08.32,0:00:09.30,JPDB,,0,0,0,,Аға
Dialogue: 0,0:00:10.16,0:00:12.48,JPDB,,0,0,0,,Мұнда не үшін келдің?
Dialogue: 0,0:00:12.96,0:00:15.68,JPDB,,0,0,0,,Үлкен ағаң келсе, мағынасыз болады, солай ма?
Dialogue: 0,0:00:16.12,0:00:17.44,JPDB,,0,0,0,,Мен не үшінмін?
Dialogue: 0,0:00:17.44,0:00:18.30,JPDB,,0,0,0,,бұл мәселе болар еді.
Dialogue: 0,0:00:19.14,0:00:21.36,JPDB,,0,0,0,,Өтінемін, өмір сүріңіз
Dialogue: 0,0:00:22.08,0:00:25.18,JPDB,,0,0,0,,Сенпай, қарапайым адам болып кетші.
Dialogue: 0,0:00:25.52,0:00:26.92,JPDB,,0,0,0,,Кім мұны қалайды?
Dialogue: 0,0:00:27.10,0:00:28.64,JPDB,,0,0,0,,Кім және қашан сұрады?
Dialogue: 0,0:00:30.00,0:00:30.84,JPDB,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,0:00:31.30,0:00:33.42,JPDB,,0,0,0,,Өте жағымсыз
Dialogue: 0,0:00:33.76,0:00:35.46,JPDB,,0,0,0,,Мен ыңғайсызданамын
Dialogue: 0,0:00:35.84,0:00:37.58,JPDB,,0,0,0,,Мен мұны бәрібір қабылдамаймын.
Dialogue: 0,0:00:38.02,0:00:42.00,JPDB,,0,0,0,,Курияма-санның құрбандығына салынған өмір мен болашақ қандай?
Dialogue: 0,0:00:42.88,0:00:44.16,JPDB,,0,0,0,,Ештеңені білдірмейді
Dialogue: 0,0:00:44.78,0:00:46.42,JPDB,,0,0,0,,Сіз мұны түсінбейсіз бе?
Dialogue: 0,0:00:49.26,0:00:52.36,JPDB,,0,0,0,,Сіз мұны білмедіңіз бе?
Dialogue: 0,0:01:00.02,0:01:03.58,JPDB,,0,0,0,,Мен сені осында кездестіремін деп ойламаппын Яйой Канбара
Dialogue: 0,0:01:03.70,0:01:05.18,JPDB,,0,0,0,,Біраз уақыт өтті
Dialogue: 0,0:01:05.44,0:01:07.30,JPDB,,0,0,0,,Субұрқақ та үлкейді
Dialogue: 0,0:01:07.84,0:01:08.54,JPDB,,0,0,0,,Мен тепкім келеді
Dialogue: 0,0:01:09.18,0:01:10.14,JPDB,,0,0,0,,Мақсаты не?
Dialogue: 0,0:01:10.62,0:01:12.56,JPDB,,0,0,0,,Акито Канбара деген не?
Dialogue: 0,0:01:13.02,0:01:15.44,JPDB,,0,0,0,,Не? Аккун - Якчанның ұлы Пён.
Dialogue: 0,0:01:16.18,0:01:18.86,JPDB,,0,0,0,,Ұлым десем де, лас деп айтпаймын.
Dialogue: 0,0:01:20.76,0:01:22.18,JPDB,,0,0,0,,Бұл тағы бір тұзақ болуы мүмкін бе?
Dialogue: 0,0:01:22.42,0:01:25.96,JPDB,,0,0,0,,Уайымдама, сен жасамасаң да мен жасадым.
Dialogue: 0,0:01:26.22,0:01:27.42,JPDB,,0,0,0,,Сұрақтарға жауап беріңіз
Dialogue: 0,0:01:28.14,0:01:29.52,JPDB,,0,0,0,,Өлмейтін жартылай жын дегеніміз не?
Dialogue: 0,0:01:29.92,0:01:31.26,JPDB,,0,0,0,,Сіз нені мақсат етесіз?
Dialogue: 0,0:01:31.68,0:01:33.96,JPDB,,0,0,0,,Мұндай қызықсыз нәрселерді тыңдауға қалай дәтің бар?
Dialogue: 0,0:01:34.10,0:01:35.88,JPDB,,0,0,0,,Субұрқақ та қызықсыз болды
Dialogue: 0,0:01:36.64,0:01:38.96,JPDB,,0,0,0,,Жалықтыратын ересек адам болып өссең жақсы емес.
Dialogue: 0,0:01:40.82,0:01:42.56,JPDB,,0,0,0,,Мен ешкімге ғашық болған емеспін
Dialogue: 0,0:01:43.50,0:01:43.86,JPDB,,0,0,0,,Изуми
Dialogue: 0,0:01:45.58,0:01:46.36,JPDB,,0,0,0,,Изуми апа
Dialogue: 0,0:01:49.42,0:01:50.00,JPDB,,0,0,0,,Қуыршақ
Dialogue: 0,0:01:51.50,0:01:55.06,JPDB,,0,0,0,,Қашанға дейін бұл балаларға үлкендермен араласуға рұқсат бересіз?
Dialogue: 0,0:01:55.64,0:01:58.06,JPDB,,0,0,0,,Басқа әлем қауымдастығы қазірдің өзінде жұмыс істейді.
Dialogue: 0,0:02:03.40,0:02:05.02,JPDB,,0,0,0,,Хирууми-кун Мизуки-чан
Dialogue: 0,0:02:05.64,0:02:08.80,JPDB,,0,0,0,,Акито мен Мираи-чан жай сен және шетелдіктер емес.
Dialogue: 0,0:02:09.16,0:02:10.34,JPDB,,0,0,0,,Бұл ерекше болмыс.
Dialogue: 0,0:02:13.38,0:02:14.44,JPDB,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:02:15.44,0:02:16.04,JPDB,,0,0,0,,Жалғасы
Dialogue: 0,0:02:16.04,0:02:16.44,JPDB,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:02:16.44,0:02:16.98,JPDB,,0,0,0,,Апа
Dialogue: 0,0:02:18.18,0:02:18.78,JPDB,,0,0,0,,Қазір
Dialogue: 0,0:02:20.98,0:02:22.50,JPDB,,0,0,0,,Сол жарық бірінші болып тұрған жоқ па?
Dialogue: 0,0:02:23.18,0:02:26.32,JPDB,,0,0,0,,«Youmu» деп айту тым бос сөз болар еді.
Dialogue: 0,0:02:26.92,0:02:27.84,JPDB,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:02:28.10,0:02:30.62,JPDB,,0,0,0,,Бастапқыда мен үлкендер арасында болдым.
Dialogue: 0,0:02:31.22,0:02:32.62,JPDB,,0,0,0,,Бұл орталық
Dialogue: 0,0:02:33.00,0:02:36.14,JPDB,,0,0,0,,Ішінде не бар, мұнда бардың бәрі бар.
Dialogue: 0,0:02:38.12,0:02:40.52,JPDB,,0,0,0,,Соңғы кездері иығым қатайғанын түсінуге болады.
Dialogue: 0,0:02:40.70,0:02:42.66,JPDB,,0,0,0,,Бұл әзілдейтін уақыт емес.
Dialogue: 0,0:02:49.68,0:02:51.82,JPDB,,0,0,0,,Сенпай, бірдеңе түсіндің бе?
Dialogue: 0,0:02:52.04,0:02:52.88,JPDB,,0,0,0,,Не?
Dialogue: 0,0:02:53.36,0:02:54.62,JPDB,,0,0,0,,Бұл әлсіздік.
Dialogue: 0,0:02:55.16,0:02:55.52,JPDB,,0,0,0,,Қараңыз
Dialogue: 0,0:02:55.82,0:02:58.70,JPDB,,0,0,0,,Мысалы, менің ағам сияқты менің қолтығым әлсіз.
Dialogue: 0,0:02:59.08,0:03:01.76,JPDB,,0,0,0,,Оның қолтығы қайда?
Dialogue: 0,0:03:02.44,0:03:04.88,JPDB,,0,0,0,,Сонда сізге ұнамайтын нәрсе жоқ па?
Dialogue: 0,0:03:05.26,0:03:06.30,JPDB,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:03:06.84,0:03:08.08,JPDB,,0,0,0,,Бұл сіз жек көретін нәрсе ме?
Dialogue: 0,0:03:10.56,0:03:11.84,JPDB,,0,0,0,,Шишамо балалармен
Dialogue: 0,0:03:12.98,0:03:15.44,JPDB,,0,0,0,,Шишамо балалармен
Dialogue: 0,0:03:17.58,0:03:18.48,JPDB,,0,0,0,,Сіз ашулысыз ба?
Dialogue: 0,0:03:18.48,0:03:19.72,JPDB,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:03:32.02,0:03:32.92,JPDB,,0,0,0,,Курияма мырза
Dialogue: 0,0:03:47.62,0:03:48.82,JPDB,,0,0,0,,Менің қазіргі ағам
Dialogue: 0,0:03:49.38,0:03:50.02,JPDB,,0,0,0,,Мүмкін
Dialogue: 0,0:03:51.52,0:03:53.80,JPDB,,0,0,0,,Бұл қол елес болуы мүмкін бе?
Dialogue: 0,0:03:57.16,0:03:59.42,JPDB,,0,0,0,,Бұл youmu тас шекарадан тыс
Dialogue: 0,0:04:00.26,0:04:02.08,JPDB,,0,0,0,,Ол менің үлкендерімнің бір бөлігі болды.
Dialogue: 0,0:04:02.72,0:04:03.34,JPDB,,0,0,0,,Иә
Dialogue: 0,0:04:04.06,0:04:08.40,JPDB,,0,0,0,,Сенпай, шекарадан тыс биліктің бір бөлігі сіздің қолыңызда.
Dialogue: 0,0:04:09.06,0:04:10.16,JPDB,,0,0,0,,Мен қалай екенін білмеймін
Dialogue: 0,0:04:10.84,0:04:13.60,JPDB,,0,0,0,,Бірақ ағаның күші тең болса
Dialogue: 0,0:04:15.28,0:04:17.72,JPDB,,0,0,0,,Бұл жақынырақ қарап шығуға тұрарлық сияқты.
Dialogue: 0,0:04:18.76,0:04:20.86,JPDB,,0,0,0,,Сіз әлі тамақ ішпеген сияқтысыз.
Dialogue: 0,0:04:21.42,0:04:24.12,JPDB,,0,0,0,,Шекарадан тыс Youmu соншалықты күшті ме?
Dialogue: 0,0:04:24.64,0:04:27.72,JPDB,,0,0,0,,Әлде Мирай Курияманың еркі соншалықты күшті ме?
Dialogue: 0,0:04:28.00,0:04:29.64,JPDB,,0,0,0,,Бұл, әрине, соңғысы, солай емес пе?
Dialogue: 0,0:04:32.10,0:04:34.44,JPDB,,0,0,0,,Ей, ол жақсы адам емес.
Dialogue: 0,0:04:35.00,0:04:36.70,JPDB,,0,0,0,,Бұл менің ісім емес.
Dialogue: 0,0:04:38.04,0:04:40.06,JPDB,,0,0,0,,Сіздің күш-жігеріңіздің арқасында
Dialogue: 0,0:04:40.52,0:04:42.54,JPDB,,0,0,0,,Менің біраз күш-қуатым қайтып кеткен сияқты.
Dialogue: 0,0:04:43.06,0:04:44.80,JPDB,,0,0,0,,Тоқта, мен сені ұрамын.
Dialogue: 0,0:04:44.80,0:04:45.70,JPDB,,0,0,0,,Сіз емес
Dialogue: 0,0:04:49.58,0:04:50.98,JPDB,,0,0,0,,Бүгін кеш.
Dialogue: 0,0:04:51.44,0:04:52.72,JPDB,,0,0,0,,Мен көптен күттім.
Dialogue: 0,0:05:03.76,0:05:05.40,JPDB,,0,0,0,,Сіз әлдеқайда күшті болдыңыз, солай емес пе?
Dialogue: 0,0:05:05.98,0:05:08.32,JPDB,,0,0,0,,Мен сізге арналған бос көлеңкені алдым.
Dialogue: 0,0:05:08.64,0:05:10.50,JPDB,,0,0,0,,Ақыры жақсы көріне бастады.
Dialogue: 0,0:05:25.56,0:05:29.06,JPDB,,0,0,0,,Кешіріңіз, әпкеммен араласқан адам...
Dialogue: 0,0:05:29.22,0:05:31.56,JPDB,,0,0,0,,Оны жойғанша аңдыу принципін ұстаныңыз.
Dialogue: 0,0:05:33.12,0:05:34.38,JPDB,,0,0,0,,Бірге үш?
Dialogue: 0,0:05:34.80,0:05:36.98,JPDB,,0,0,0,,Жоқ, төртке бір.
Dialogue: 0,0:05:37.22,0:05:37.84,JPDB,,0,0,0,,Мицуки
Dialogue: 0,0:05:38.46,0:05:42.62,JPDB,,0,0,0,,Мен ең кенжесі болғандықтан, кішкентай кезімнен үйде отырдым.
Dialogue: 0,0:05:42.82,0:05:45.22,JPDB,,0,0,0,,Мен сені еш ойланбастан бітіремін.
Dialogue: 0,0:05:45.74,0:05:46.22,JPDB,,0,0,0,,Келісім
Dialogue: 0,0:05:47.70,0:05:50.40,JPDB,,0,0,0,,Ол орақ алғашында маған аманат болған.
Dialogue: 0,0:05:50.68,0:05:52.64,JPDB,,0,0,0,,Мен де жауаптымын.
Dialogue: 0,0:05:53.10,0:05:56.40,JPDB,,0,0,0,,Біз жақсы араласып кеткен сияқтымыз.
Dialogue: 0,0:05:59.32,0:06:00.00,JPDB,,0,0,0,,Әпке
Dialogue: 0,0:06:00.00,0:06:00.74,JPDB,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:06:04.72,0:06:07.00,JPDB,,0,0,0,,Енді мен сенің жолыңа кедергі жасамаймын.
Dialogue: 0,0:06:07.56,0:06:08.72,JPDB,,0,0,0,,Қанша уақыт?
Dialogue: 0,0:06:09.48,0:06:10.38,JPDB,,0,0,0,,Тағы бір дем
Dialogue: 0,0:06:13.54,0:06:15.00,JPDB,,0,0,0,,Жарайды, кілт кептеліп қалды.
Dialogue: 0,0:06:15.36,0:06:17.86,JPDB,,0,0,0,,Эй, сенде үлкен лицензия бар ма?
Dialogue: 0,0:06:18.60,0:06:20.06,JPDB,,0,0,0,,This isn't a public road.
Dialogue: 0,0:06:20.24,0:06:21.90,JPDB,,0,0,0,,Курияма мырза да кемеге тез қонды.
Dialogue: 0,0:06:22.24,0:06:23.52,JPDB,,0,0,0,,Эй, қазірдің өзінде
Dialogue: 0,0:06:25.40,0:06:26.18,JPDB,,0,0,0,,Онда?
Dialogue: 0,0:06:26.98,0:06:28.40,JPDB,,0,0,0,,Менің алдымда Юму тұр.
Dialogue: 0,0:06:29.14,0:06:30.08,JPDB,,0,0,0,,Сондай-ақ төменде
Dialogue: 0,0:06:39.86,0:06:41.28,JPDB,,0,0,0,,Курияма мырза күткендей
Dialogue: 0,0:06:41.68,0:06:43.46,JPDB,,0,0,0,,Осылайша сіз жай ғана жалғастыра аласыз.
Dialogue: 0,0:06:44.00,0:06:45.10,JPDB,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:06:45.90,0:06:47.60,JPDB,,0,0,0,,But the accelerator is fully open.
Dialogue: 0,0:06:47.96,0:06:48.26,JPDB,,0,0,0,,Иә?
Dialogue: 0,0:06:48.62,0:06:49.36,JPDB,,0,0,0,,Ойласам, ол бәріне белгілі нәрсе ғой.
Dialogue: 0,0:06:50.44,0:06:53.34,JPDB,,0,0,0,,Тоқтасақ та, дер кезінде жете алмаймыз.
Dialogue: 0,0:06:55.00,0:06:55.54,JPDB,,0,0,0,,Аға
Dialogue: 0,0:07:12.92,0:07:15.52,JPDB,,0,0,0,,Бұл өтірік
Dialogue: 0,0:07:26.88,0:07:27.52,JPDB,,0,0,0,,Аға
Dialogue: 0,0:07:34.48,0:07:35.72,JPDB,,0,0,0,,Тым кездейсоқ
Dialogue: 0,0:07:36.22,0:07:38.48,JPDB,,0,0,0,,Бұл жердің өмір сүруінің өзі кездейсоқ.
Dialogue: 0,0:07:38.84,0:07:41.34,JPDB,,0,0,0,,Былайша айтқанда, менің ағам тек ақымақ.
Dialogue: 0,0:07:41.34,0:07:42.18,JPDB,,0,0,0,,Мен бе?
Dialogue: 0,0:07:45.70,0:07:47.56,JPDB,,0,0,0,,But I managed to get there.
Dialogue: 0,0:07:48.86,0:07:49.72,JPDB,,0,0,0,,Бұл
Dialogue: 0,0:07:50.98,0:07:51.32,JPDB,,0,0,0,,Иә?
Dialogue: 0,0:07:55.54,0:07:56.78,JPDB,,0,0,0,,Арғы жағы да шыдамсыз.
Dialogue: 0,0:07:56.78,0:07:57.60,JPDB,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:07:57.60,0:07:58.36,JPDB,,0,0,0,,Тұр, мен өзі қандай ұлтпын? Хехехе
Dialogue: 0,0:07:59.46,0:08:01.80,JPDB,,0,0,0,,But I feel that way.
Dialogue: 0,0:08:02.88,0:08:04.38,JPDB,,0,0,0,,I'm sure it will work out somehow.
Dialogue: 0,0:08:04.86,0:08:07.26,JPDB,,0,0,0,,Курияма-санға ұқсамайды.
Dialogue: 0,0:08:07.78,0:08:09.32,JPDB,,0,0,0,,I don't know about that.
Dialogue: 0,0:08:10.56,0:08:11.00,JPDB,,0,0,0,,Бірақ
Dialogue: 0,0:08:14.66,0:08:16.00,JPDB,,0,0,0,,Курияманың болашағы қазір
Dialogue: 0,0:08:16.40,0:08:18.86,JPDB,,0,0,0,,It's unpleasantly positive.
Dialogue: 0,0:08:23.56,0:08:25.42,JPDB,,0,0,0,,What unnecessary things are you saying?
Dialogue: 0,0:08:25.64,0:08:28.44,JPDB,,0,0,0,,Сіз оны шынымен естіп жатырсыз ба?
Dialogue: 0,0:08:28.98,0:08:30.56,JPDB,,0,0,0,,Қылмыс деңгейінің төмендегені туралы сол мәлімдеме...
Dialogue: 0,0:08:56.02,0:08:58.88,JPDB,,0,0,0,,Курияма-сан, жүр.
Dialogue: 0,0:09:28.22,0:09:29.06,JPDB,,0,0,0,,Курияма мырза
Dialogue: 0,0:09:29.70,0:09:30.32,JPDB,,0,0,0,,Акки
Dialogue: 0,0:09:32.36,0:09:33.52,JPDB,,0,0,0,,Уақыт келді
Dialogue: 0,0:09:34.40,0:09:37.16,JPDB,,0,0,0,,Шекарадан тыс Мираи Куриямадан босатылды
Dialogue: 0,0:09:37.88,0:09:40.72,JPDB,,0,0,0,,Ол барлық жындарды жұтып, үлкен құйынға айналады.
Dialogue: 0,0:09:41.20,0:09:42.60,JPDB,,0,0,0,,Әлемді құрту
Dialogue: 0,0:09:43.64,0:09:46.50,JPDB,,0,0,0,,Енді не істеуіміз керек, Изуми мырза?
Dialogue: 0,0:09:52.08,0:09:52.60,JPDB,,0,0,0,,Райнер, кейін кездескенше.
Dialogue: 0,0:09:53.96,0:09:54.74,JPDB,,0,0,0,,Курияма мырза
Dialogue: 0,0:09:55.42,0:09:57.60,JPDB,,0,0,0,,Курияма мырза Курияма мырза
Dialogue: 0,0:10:02.70,0:10:03.56,JPDB,,0,0,0,,Мені өлтірме
Dialogue: 0,0:10:03.86,0:10:04.92,JPDB,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 0,0:10:04.92,0:10:05.66,JPDB,,0,0,0,,Канжу Нагаре
Dialogue: 0,0:10:05.66,0:10:06.26,JPDB,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:10:06.26,0:10:07.34,JPDB,,0,0,0,,(Мадо) Бірақ… (Иба) Мадо!
Dialogue: 0,0:10:07.34,0:10:09.04,JPDB,,0,0,0,,Мені көлік қағып кетсе де
Dialogue: 0,0:10:07.34,0:10:09.04,JPDB,,0,0,0,,Бұл менікі
Dialogue: 0,0:10:11.44,0:10:12.32,JPDB,,0,0,0,,Аға
Dialogue: 0,0:10:16.80,0:10:20.92,JPDB,,0,0,0,,Ініңіз де, қарындасыңыз да өзіңіз сияқты табанды.
Dialogue: 0,0:10:24.22,0:10:25.32,JPDB,,0,0,0,,Бауырым, жүр.
Dialogue: 0,0:10:25.50,0:10:26.00,JPDB,,0,0,0,,Мицуки
Dialogue: 0,0:10:26.44,0:10:29.60,JPDB,,0,0,0,,Осы жерде Изуми-ни-самаға қалдырсам, бұрынғыдай болады.
Dialogue: 0,0:10:29.94,0:10:30.98,JPDB,,0,0,0,,Ештеңе өзгермейді.
Dialogue: 0,0:10:32.14,0:10:33.06,JPDB,,0,0,0,,Эден мектебіне қабылдау нәтижелері
Dialogue: 0,0:10:34.08,0:10:36.32,JPDB,,0,0,0,,Оны ағаңа қалдыр.
Dialogue: 0,0:10:37.72,0:10:39.30,JPDB,,0,0,0,,Хироми Сенпай жиіркенішті
Dialogue: 0,0:10:39.48,0:10:40.18,JPDB,,0,0,0,,Дұрыс па?
Dialogue: 0,0:10:43.64,0:10:45.52,JPDB,,0,0,0,,Неге сонша асығасың?
Dialogue: 0,0:10:46.78,0:10:50.02,JPDB,,0,0,0,,Ол жүзді, мен сенің жүзіңді көргім келді.
Dialogue: 0,0:10:50.44,0:10:52.40,JPDB,,0,0,0,,қорқып, шыдамсыз
Dialogue: 0,0:10:52.68,0:10:54.30,JPDB,,0,0,0,,Бір нәрсені жөндеп жатқанда
Dialogue: 0,0:10:55.14,0:10:57.36,JPDB,,0,0,0,,Мені жеңуге тырысқан фигура
Dialogue: 0,0:10:57.36,0:10:58.10,JPDB,,0,0,0,,Үндетпе
Dialogue: 0,0:10:58.22,0:10:59.62,JPDB,,0,0,0,,Сіз соншалықты қорқасыз ба?
Dialogue: 0,0:10:59.86,0:11:02.86,JPDB,,0,0,0,,А, мен саған ұнайтын шығармын?
Dialogue: 0,0:11:04.06,0:11:07.76,JPDB,,0,0,0,,Әлде ағаңның өткеніңді білгенін қаламайсың ба?
Dialogue: 0,0:11:10.70,0:11:11.40,JPDB,,0,0,0,,Үндетпе
Dialogue: 0,0:11:12.34,0:11:13.98,JPDB,,0,0,0,,Юмуға бағынған бөтен адам
Dialogue: 0,0:11:14.26,0:11:15.60,JPDB,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:11:16.24,0:11:18.04,JPDB,,0,0,0,,Бастапқыда сол тесіктегі цикада
Dialogue: 0,0:11:18.32,0:11:21.06,JPDB,,0,0,0,,Біз сізді денемізде ұстайтын адамдар емеспіз бе?
Dialogue: 0,0:11:21.72,0:11:23.82,JPDB,,0,0,0,,Білдім, аға.
Dialogue: 0,0:11:26.00,0:11:26.92,JPDB,,0,0,0,,Изуми апа
Dialogue: 0,0:11:29.86,0:11:30.50,JPDB,,0,0,0,,Үндетпе
Dialogue: 0,0:11:30.86,0:11:32.58,JPDB,,0,0,0,,Тыныш, үндеме, үндеме
Dialogue: 0,0:11:38.80,0:11:40.36,JPDB,,0,0,0,,Бұл шынымен де солай болуы мүмкін
Dialogue: 0,0:11:41.04,0:11:45.28,JPDB,,0,0,0,,Бірақ мен адам ретінде мақтанышымды әлі тастаған жоқпын.
Dialogue: 0,0:11:46.38,0:11:47.78,JPDB,,0,0,0,,Мұны сізбен жасамаңыз
Dialogue: 0,0:11:49.66,0:11:52.10,JPDB,,0,0,0,,Бос сөз айтпаңыз.
Dialogue: 0,0:11:59.82,0:12:00.34,JPDB,,0,0,0,,Апа
Dialogue: 0,0:12:04.98,0:12:05.96,JPDB,,0,0,0,,Бұл не?
Dialogue: 0,0:12:06.44,0:12:10.08,JPDB,,0,0,0,,Шұңқыр көлеңкеде пайда болғанға ұқсас нәрсе болуы мүмкін.
Dialogue: 0,0:12:11.94,0:12:12.94,JPDB,,0,0,0,,Хироми Сенпай
Dialogue: 0,0:12:14.52,0:12:15.14,JPDB,,0,0,0,,Юи
Dialogue: 0,0:12:15.24,0:12:16.68,JPDB,,0,0,0,,Курияма мырза, көзіңізді жұмыңыз.
Dialogue: 0,0:12:17.66,0:12:18.40,JPDB,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:12:20.14,0:12:20.80,JPDB,,0,0,0,,Иә
Dialogue: 0,0:12:24.04,0:12:25.00,JPDB,,0,0,0,,Алданбаңыз
Dialogue: 0,0:12:26.40,0:12:31.04,JPDB,,0,0,0,,Олар сенді адамдардың жүрегіндегі бұрмалаушылық пен жек көрушіліктің көрінісі дейді.
Dialogue: 0,0:12:33.00,0:12:36.48,JPDB,,0,0,0,,Жүрегіміздің әлсіздігі формада көрінеді.
Dialogue: 0,0:12:37.38,0:12:39.30,JPDB,,0,0,0,,Мен мұны алғаш кездескен кезде айтқанмын.
Dialogue: 0,0:12:40.10,0:12:41.40,JPDB,,0,0,0,,Мен де солаймын
Dialogue: 0,0:12:42.36,0:12:44.22,JPDB,,0,0,0,,Мен Курияма мырзаның қасындамын
Dialogue: 0,0:12:45.68,0:12:46.74,JPDB,,0,0,0,,Біз кездестік
Dialogue: 0,0:12:47.36,0:12:48.46,JPDB,,0,0,0,,Әлем өзгерді
Dialogue: 0,0:12:49.84,0:12:52.04,JPDB,,0,0,0,,Өткен өкініштеріңізбен айналыспаңыз
Dialogue: 0,0:12:53.36,0:12:55.88,JPDB,,0,0,0,,Курияма мырза енді жалғыз емес.
Dialogue: 0,0:12:59.74,0:13:01.24,JPDB,,0,0,0,,Менде Курияма-сан бар
Dialogue: 0,0:13:02.44,0:13:03.24,JPDB,,0,0,0,,Аға
Dialogue: 0,0:13:03.96,0:13:04.56,JPDB,,0,0,0,,Көзіңді аш
Dialogue: 0,0:13:12.60,0:13:15.08,JPDB,,0,0,0,,Бұл не?
Dialogue: 0,0:13:19.08,0:13:19.70,JPDB,,0,0,0,,Мен сені жеңемін
Dialogue: 0,0:13:20.84,0:13:22.30,JPDB,,0,0,0,,Не? Мұның бәрі ме?
Dialogue: 0,0:13:22.52,0:13:23.84,JPDB,,0,0,0,,Басқа жол бар ма?
Dialogue: 0,0:13:29.52,0:13:30.48,JPDB,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,0:14:13.88,0:14:14.68,JPDB,,0,0,0,,Аяка-сан
Dialogue: 0,0:14:15.86,0:14:16.54,JPDB,,0,0,0,,Ай-чан
Dialogue: 0,0:14:17.00,0:14:18.06,JPDB,,0,0,0,,Жақсы болды ма?
Dialogue: 0,0:14:49.56,0:14:51.52,JPDB,,0,0,0,,Сіз олардың бәрін жеңдіңіз бе?
Dialogue: 0,0:14:52.56,0:14:53.12,JPDB,,0,0,0,,Келіңіздер
Dialogue: 0,0:15:00.74,0:15:01.74,JPDB,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:15:04.02,0:15:04.56,JPDB,,0,0,0,,О
Dialogue: 0,0:15:12.58,0:15:14.16,JPDB,,0,0,0,,Сіз неден қорқасыз?
Dialogue: 0,0:15:15.52,0:15:16.42,JPDB,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:15:17.00,0:15:19.10,JPDB,,0,0,0,,Бәрің менікісіңдер
Dialogue: 0,0:15:20.34,0:15:23.54,JPDB,,0,0,0,,Мұның бәрі менің ішімде болды.
Dialogue: 0,0:15:24.04,0:15:26.24,JPDB,,0,0,0,,Сол қара қызғаныш та
Dialogue: 0,0:15:28.94,0:15:32.38,JPDB,,0,0,0,,Ешқашан адам болмаймын деген үмітсіздік
Dialogue: 0,0:15:32.56,0:15:34.16,JPDB,,0,0,0,,Тастап кетудің мұңы
Dialogue: 0,0:15:34.50,0:15:36.56,JPDB,,0,0,0,,Біреуді ренжіткені үшін өкіну
Dialogue: 0,0:15:37.12,0:15:38.02,JPDB,,0,0,0,,Аға
Dialogue: 0,0:15:38.02,0:15:39.80,JPDB,,0,0,0,,Өзімшілдік пен күдік
Dialogue: 0,0:15:39.80,0:15:41.38,JPDB,,0,0,0,,Жек көру және отставкаға кету
Dialogue: 0,0:15:41.38,0:15:43.04,JPDB,,0,0,0,,Қулық та, өзін-өзі сақтау да
Dialogue: 0,0:15:44.92,0:15:47.18,JPDB,,0,0,0,,Ештеңені сыртқа шығармаңыз
Dialogue: 0,0:15:47.56,0:15:50.16,JPDB,,0,0,0,,Бәрі менікі
Dialogue: 0,0:15:50.54,0:15:53.02,JPDB,,0,0,0,,Мен бәрін аламын.
Dialogue: 0,0:15:55.44,0:15:58.70,JPDB,,0,0,0,,Мен өлмейтін жартылай жынмын.
Dialogue: 0,0:16:11.30,0:16:12.10,JPDB,,0,0,0,,Аға
Dialogue: 0,0:16:23.22,0:16:26.80,JPDB,,0,0,0,,Сенпай, осында келе аласың ба?
Dialogue: 0,0:16:29.98,0:16:30.98,JPDB,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:32.18,0:16:34.40,JPDB,,0,0,0,,Мм...м...
Dialogue: 0,0:16:34.78,0:16:35.30,JPDB,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:16:36.54,0:16:39.80,JPDB,,0,0,0,,Менің сізден бір өтінішім бар.
Dialogue: 0,0:16:41.20,0:16:42.22,JPDB,,0,0,0,,Өтінемін
Dialogue: 0,0:16:42.46,0:16:45.20,JPDB,,0,0,0,,2-эпизод: Буггарати келеді
Dialogue: 0,0:16:45.82,0:16:47.98,JPDB,,0,0,0,,Маған қолыңды бер
Dialogue: 0,0:16:48.92,0:16:49.30,JPDB,,0,0,0,,Hand?
Dialogue: 0,0:16:50.42,0:16:50.88,JPDB,,0,0,0,,Иә
Dialogue: 0,0:16:59.62,0:17:01.66,JPDB,,0,0,0,,Мені сипаңызшы
Dialogue: 0,0:17:02.42,0:17:04.50,JPDB,,0,0,0,,Мені сипағаныңды қалаймын.
Dialogue: 0,0:17:16.58,0:17:17.60,JPDB,,0,0,0,,Курияма мырза...
Dialogue: 0,0:17:18.32,0:17:20.62,JPDB,,0,0,0,,Рахмет айтыңыз
Dialogue: 0,0:17:23.66,0:17:24.42,JPDB,,0,0,0,,Рахмет
Dialogue: 0,0:17:24.78,0:17:26.44,JPDB,,0,0,0,,Мен шын жүректен емеспін
Dialogue: 0,0:17:29.76,0:17:30.68,JPDB,,0,0,0,,Рахмет
Dialogue: 0,0:17:37.04,0:17:37.90,JPDB,,0,0,0,,Мен бақыттымын.
Dialogue: 0,0:17:40.04,0:17:41.02,JPDB,,0,0,0,,Мен бақыттымын
Dialogue: 0,0:17:41.92,0:17:42.66,JPDB,,0,0,0,,Курияма мырза
Dialogue: 0,0:17:43.78,0:17:46.86,JPDB,,0,0,0,,Мен бақыттымын Мен бақыттымын
Dialogue: 0,0:17:48.28,0:17:49.68,JPDB,,0,0,0,,Курияма мырзаның аяқтары
Dialogue: 0,0:17:50.58,0:17:53.74,JPDB,,0,0,0,,Шекараның арғы беті менің сенпайыма оралды.
Dialogue: 0,0:17:55.04,0:17:56.80,JPDB,,0,0,0,,Бұл жер құлағалы тұр.
Dialogue: 0,0:17:57.72,0:17:59.68,JPDB,,0,0,0,,Мен де жоғалып кететін шығармын.
Dialogue: 0,0:18:01.00,0:18:03.60,JPDB,,0,0,0,,Енді шекараның арғы жағы қарттардың арасына оралды
Dialogue: 0,0:18:04.44,0:18:06.32,JPDB,,0,0,0,,Мен өмір сүре алмауым керек
Dialogue: 0,0:18:07.38,0:18:10.46,JPDB,,0,0,0,,Нағыз мен баяғыда кетті.
Dialogue: 0,0:18:11.36,0:18:14.60,JPDB,,0,0,0,,Сізбен танысқаныма өте қуаныштымын.
Dialogue: 0,0:18:14.60,0:18:15.28,JPDB,,0,0,0,,Йосе
Dialogue: 0,0:18:15.82,0:18:19.30,JPDB,,0,0,0,,Сенпайға ғашық болғаныма өте қуаныштымын...
Dialogue: 0,0:18:19.30,0:18:20.74,JPDB,,0,0,0,,Айтпа.
Dialogue: 0,0:18:22.62,0:18:25.80,JPDB,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:18:27.78,0:18:28.66,JPDB,,0,0,0,,Курияма мырза
Dialogue: 0,0:18:29.02,0:18:33.76,JPDB,,0,0,0,,Бұл өтірік. Күте тұрыңыз, Курияма-сан.
Dialogue: 0,0:18:35.04,0:18:35.92,JPDB,,0,0,0,,Курияма мырза
Dialogue: 0,0:18:51.04,0:18:53.14,JPDB,,0,0,0,,Ол алдын ала анықталды ма?
Dialogue: 0,0:18:53.50,0:18:56.76,JPDB,,0,0,0,,Әлде Курияма мырзаның еңбекқорлығынан ба, білмеймін.
Dialogue: 0,0:18:58.02,0:19:01.02,JPDB,,0,0,0,,Мен міндетті түрде соңғысын таңдар едім.
Dialogue: 0,0:19:01.96,0:19:05.22,JPDB,,0,0,0,,Қалай болғанда да, шекараның екінші жағы менің ішімде.
Dialogue: 0,0:19:05.90,0:19:07.88,JPDB,,0,0,0,,Дүниеде тыныштық орнады.
Dialogue: 0,0:19:08.78,0:19:11.24,JPDB,,0,0,0,,100 иен болмайды. 100 иен
Dialogue: 0,0:19:11.48,0:19:12.82,JPDB,,0,0,0,,О, дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,0:19:13.16,0:19:14.32,JPDB,,0,0,0,,Махаббат Қайырлы таң
Dialogue: 0,0:19:15.22,0:19:16.42,JPDB,,0,0,0,,Қайырлы таң
Dialogue: 0,0:19:17.42,0:19:18.42,JPDB,,0,0,0,,Абайлаңыз
Dialogue: 0,0:19:18.82,0:19:19.84,JPDB,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:19:20.30,0:19:21.32,JPDB,,0,0,0,,Не? ұйықтау
Dialogue: 0,0:19:21.78,0:19:23.26,JPDB,,0,0,0,,Сакура-чан, қазір оян.
Dialogue: 0,0:19:23.26,0:19:25.18,JPDB,,0,0,0,,Youmu әлі де бар
Dialogue: 0,0:19:25.62,0:19:28.96,JPDB,,0,0,0,,Басқа әлем оны жеңіп, өмірін әдеттегідей жалғастырады.
Dialogue: 0,0:19:29.70,0:19:32.10,JPDB,,0,0,0,,Аяка мен Ай да бұрынғы үйлеріне қайтты.
Dialogue: 0,0:19:35.14,0:19:37.06,JPDB,,0,0,0,,Мироку Фудзиманың қайда екені белгісіз.
Dialogue: 0,0:19:37.38,0:19:40.06,JPDB,,0,0,0,,Ол басқа әлем қауымдастығы атауымен әрекет етті.
Барлығы
Dialogue: 0,0:19:40.36,0:19:42.16,JPDB,,0,0,0,,жолында реттеледі
Dialogue: 0,0:19:43.10,0:19:46.62,JPDB,,0,0,0,,Хироми Изуми мырзаның орнына Назэ отбасын басқарады.
Dialogue: 0,0:19:46.80,0:19:48.76,JPDB,,0,0,0,,Бұл позицияны алуда өзгеріс болғанымен.
Dialogue: 0,0:19:49.44,0:19:51.50,JPDB,,0,0,0,,Өмірде ерекше өзгеріс болмайды.
Dialogue: 0,0:19:53.08,0:19:53.60,JPDB,,0,0,0,,Апа
Dialogue: 0,0:19:54.66,0:19:57.62,JPDB,,0,0,0,,Сен де түсінетін уақыт келеді.
Dialogue: 0,0:19:58.82,0:19:59.52,JPDB,,0,0,0,,Кешіріңіз
Dialogue: 0,0:20:00.82,0:20:01.58,JPDB,,0,0,0,,Изуми апа
Dialogue: 0,0:20:02.70,0:20:04.56,JPDB,,0,0,0,,Мен әпкемді әрқашан жақсы көретінмін
Dialogue: 0,0:20:05.34,0:20:07.32,JPDB,,0,0,0,,Мен мұнда әпкемдей боламын деп келдім.
Dialogue: 0,0:20:08.10,0:20:08.92,JPDB,,0,0,0,,Бірақ тоқтаңыз
Dialogue: 0,0:20:09.78,0:20:11.34,JPDB,,0,0,0,,Мен әпкемдей болмаймын.
Dialogue: 0,0:20:12.12,0:20:12.90,JPDB,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:20:13.64,0:20:15.04,JPDB,,0,0,0,,Идеалдармен әрекет ету
Dialogue: 0,0:20:15.42,0:20:16.92,JPDB,,0,0,0,,Ешқашан нәтиже бермесе де
Dialogue: 0,0:20:17.52,0:20:18.84,JPDB,,0,0,0,,Егер сіз идеалдарыңызды жоғалтсаңыз
Dialogue: 0,0:20:18.84,0:20:20.38,JPDB,,0,0,0,,Одан ештеңе шықпайды
Dialogue: 0,0:20:21.54,0:20:23.68,JPDB,,0,0,0,,Мен өзімді де, жақындарымды да қорғай алмаймын
Dialogue: 0,0:20:26.26,0:20:28.52,JPDB,,0,0,0,,Сен күштірек болдың, Хироми.
Dialogue: 0,0:20:31.70,0:20:34.80,JPDB,,0,0,0,,Жақсы, Хируами, сен Назе отбасысың.
Dialogue: 0,0:20:34.80,0:20:35.88,JPDB,,0,0,0,,Мен білемін
Dialogue: 0,0:20:37.04,0:20:39.06,JPDB,,0,0,0,,Бұдан басқа, әзірге...
Dialogue: 0,0:20:40.00,0:20:42.14,JPDB,,0,0,0,,Мизуки әдеттегідей клуб бөлмесінде қалады.
Dialogue: 0,0:20:42.38,0:20:43.66,JPDB,,0,0,0,,Сіз мені қорлап жатырсыз.
Dialogue: 0,0:20:43.98,0:20:47.56,JPDB,,0,0,0,,Соңында зұлымдық жойылатынын білсек те.
Dialogue: 0,0:20:47.56,0:20:50.24,JPDB,,0,0,0,,Әрі қарай оқу уақытты босқа өткізу емес
Dialogue: 0,0:20:50.34,0:20:52.44,JPDB,,0,0,0,,Көңіл көтеру деген осы.
Dialogue: 0,0:20:53.40,0:20:54.42,JPDB,,0,0,0,,Тоқтау
Dialogue: 0,0:20:54.76,0:20:56.98,JPDB,,0,0,0,,Қыс қолды жылытатын мезгіл болса керек.
Dialogue: 0,0:20:57.44,0:20:59.06,JPDB,,0,0,0,,Табиғи емес ештеңе жоқ.
Dialogue: 0,0:20:59.06,0:21:00.46,JPDB,,0,0,0,,Үлкен құмырсқа жегіш
Dialogue: 0,0:21:00.46,0:21:01.18,JPDB,,0,0,0,,Үш ұпай
Dialogue: 0,0:21:05.56,0:21:07.88,JPDB,,0,0,0,,Бірақ Мираи Курияма жоқ.
Dialogue: 0,0:21:08.68,0:21:11.12,JPDB,,0,0,0,,Соңында мен жеңілдім.
Dialogue: 0,0:21:11.90,0:21:14.92,JPDB,,0,0,0,,Мираи Курияманың құрбандығына салынған болашақ.
Dialogue: 0,0:21:15.18,0:21:16.22,JPDB,,0,0,0,,Ештеңені білдірмейді
Dialogue: 0,0:21:17.32,0:21:21.56,JPDB,,0,0,0,,Айқайладым, енді мен өмір сүріп, сол болашақты қабылдаймын.
Dialogue: 0,0:21:22.86,0:21:24.94,JPDB,,0,0,0,,Курияма мырза сізге айтып қойған болуы керек.
Dialogue: 0,0:21:26.30,0:21:28.06,JPDB,,0,0,0,,«Зама-ми-ро»
Dialogue: 0,0:21:29.34,0:21:30.72,JPDB,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,0:21:41.44,0:21:43.14,JPDB,,0,0,0,,Түнде де жарық болсын
Dialogue: 0,0:21:43.78,0:21:45.52,JPDB,,0,0,0,,Күндіз де қараңғылық болатыны сияқты
Dialogue: 0,0:21:46.50,0:21:48.98,JPDB,,0,0,0,,Дүниеден қараңғылық ешқашан жоғалмайды
Dialogue: 0,0:21:49.98,0:21:53.28,JPDB,,0,0,0,,Сонымен бірге дүниені қараңғылық толтырмайды.
Dialogue: 0,0:21:54.28,0:21:56.00,JPDB,,0,0,0,,Осындай екіұшты түстермен
Dialogue: 0,0:21:56.44,0:21:59.32,JPDB,,0,0,0,,Барлығы ілгерілей береді және шешіледі.
Dialogue: 0,0:22:00.26,0:22:02.02,JPDB,,0,0,0,,Олардың ішінде И
Dialogue: 0,0:22:24.76,0:22:26.12,JPDB,,0,0,0,,2-эпизод: Буггарати келеді
Dialogue: 0,0:22:29.28,0:22:30.02,JPDB,,0,0,0,,Көзілдірік
Dialogue: 0,0:22:31.80,0:22:36.42,JPDB,,0,0,0,,Қысқасы, көзілдірік киген Курияма-санды жақсы көремін.
Dialogue: 0,0:22:48.10,0:22:49.18,JPDB,,0,0,0,,Сол кезде бұл шайқас аяқталады
Dialogue: 0,0:22:50.22,0:22:52.34,JPDB,,0,0,0,,Ол алдын ала анықталды ма?
Dialogue: 0,0:22:52.86,0:22:55.80,JPDB,,0,0,0,,Әлде Курияма мырзаның еңбекқорлығынан ба, білмеймін.
Dialogue: 0,0:22:56.56,0:23:00.18,JPDB,,0,0,0,,Әлде Курияма мырзаға деген сезімім сізге жетті ме?
Dialogue: 0,0:23:01.16,0:23:04.08,JPDB,,0,0,0,,Осылайша Мирай Курияма екеуміз қайта қауыштық.
Dialogue: 0,0:23:05.00,0:23:08.42,JPDB,,0,0,0,,Егер бұл екі адам бір реттік қарым-қатынаста болса ше?
Dialogue: 0,0:23:08.84,0:23:12.06,JPDB,,0,0,0,,Бұл дүниеде барлық оқиғалар болуы мүмкін емес
Dialogue: 0,0:23:13.16,0:23:14.72,JPDB,,0,0,0,,Аа, дұрыс, Курияма мырза.
Dialogue: 0,0:23:15.84,0:23:16.84,JPDB,,0,0,0,,Мен бір нәрсені ұмытып қалдым.
Dialogue: 0,0:23:22.66,0:23:26.02,JPDB,,0,0,0,,Мына көзілдірікті киіп бере аласыз ба?
Dialogue: 0,0:22:12.24,0:22:17.18,JPED,,0,0,0,,Тыныштықты кесуге келген адам болды
Dialogue: 0,0:22:18.06,0:22:23.18,JPED,,0,0,0,,Біз үшін сөзсіз кездесу
Dialogue: 0,0:22:23.64,0:22:25.96,JPED,,0,0,0,,Өкінішті жылатқан көздер
Dialogue: 0,0:22:26.14,0:22:28.44,JPED,,0,0,0,,Сіз осылайша көрініс табасыз
Dialogue: 0,0:22:28.60,0:22:34.88,JPED,,0,0,0,,Әдемі гүлдеді, Мұңға оранып
Dialogue: 0,0:22:35.28,0:22:39.32,JPED,,0,0,0,,Біреудің өміріне балқыған гүл
Dialogue: 0,0:22:39.46,0:22:46.82,JPED,,0,0,0,,Эй, сен де көре алатыныңа сенімдімін.
Dialogue: 0,0:22:49.04,0:22:54.52,JPED,,0,0,0,,Қайталанған қателерді қайта жазайық
Dialogue: 0,0:22:54.64,0:22:59.90,JPED,,0,0,0,,Бастапқы жолды қалағаныңызша қайталаңыз
Dialogue: 0,0:23:00.30,0:23:05.82,JPED,,0,0,0,,Өткеннен өзгеше ертең
Dialogue: 0,0:23:05.90,0:23:11.16,JPED,,0,0,0,,Екеумізге ғана үміт сызу, бастау сызығы
Dialogue: 0,0:23:11.92,0:23:15.28,JPED,,0,0,0,,Мен ешқашан қоштаспаймын
Dialogue: 0,0:23:15.36,0:23:17.30,JPED,,0,0,0,,Әрқашан солай
Dialogue: 0,0:23:27.52,0:23:33.52,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
