Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:05.00,LOGO,,0,0,0,,Бұл субтитр білім беру және алмасу үшін пайдалануға арналған, коммерциялық пайдалануға тыйым салынған құдай субтитрлерінің тіркесімі болып табылады.
Dialogue: 0,0:00:05.00,0:00:10.00,LOGO,,0,0,0,,:&Hunter :& : : : : rivercrab
Dialogue: 0,0:01:36.64,0:01:42.14,JPOP,,0,0,0,fx,Жалғыздық бетімді дымқыл етеді, бірақ
Dialogue: 0,0:01:42.50,0:01:47.36,JPOP,,0,0,0,fx,Таңның атысы тып-тыныш толады.
Dialogue: 0,0:01:47.64,0:01:52.60,JPOP,,0,0,0,fx,Мені аспанға шақыр
Dialogue: 0,0:01:52.82,0:01:56.00,JPOP,,0,0,0,fx,Арғы жағында үміт күтіп тұр
Dialogue: 0,0:01:56.00,0:02:01.28,JPOP,,0,0,0,fx,Иә, мен барамын.
Dialogue: 0,0:02:02.62,0:02:08.22,JPOP,,0,0,0,fx,Мен адасып кетсем де сені іздейтін саяхат
Dialogue: 0,0:02:08.46,0:02:13.32,JPOP,,0,0,0,fx,Біздің санамыз бір-бірімізден өтті, қолымыз тиді, солай ма?
Dialogue: 0,0:02:14.82,0:02:23.14,JPOP,,0,0,0,fx,Ұстаймын сені, Жүрегіміз бірін-бірі іздейді
Dialogue: 0,0:02:23.14,0:02:28.70,JPOP,,0,0,0,fx,Бұл арманның дәлелі
Dialogue: 0,0:02:28.88,0:02:34.34,JPOP,,0,0,0,fx,Бір-бірімізді ұстаған сайын біз бір-бірімізге тартыламыз.
Dialogue: 0,0:02:34.60,0:02:39.18,JPOP,,0,0,0,fx,Енді қайғылы күндер болмайды
Dialogue: 0,0:02:39.36,0:02:44.70,JPOP,,0,0,0,fx,Бір-бірін қабылдау және өмір сүру қуанышы
Dialogue: 0,0:02:44.76,0:02:53.98,JPOP,,0,0,0,fx,Екеуіңіздің оянатыныңызға сенімдімін.
Dialogue: 0,0:02:54.80,0:03:03.66,JPOP,,0,0,0,fx,Адасып кетсем де, сені таптым
Dialogue: 0,0:22:07.56,0:22:12.50,JPED,,0,0,0,,Тыныштықты кесуге келген адам болды
Dialogue: 0,0:22:13.38,0:22:18.50,JPED,,0,0,0,,Біз үшін сөзсіз кездесу
Dialogue: 0,0:22:18.96,0:22:21.28,JPED,,0,0,0,,Өкінішті жылатқан көздер
Dialogue: 0,0:22:21.46,0:22:23.76,JPED,,0,0,0,,Сіз осылайша көрініс табасыз
Dialogue: 0,0:22:23.92,0:22:30.20,JPED,,0,0,0,,Мұңға оранып, әдемі гүлдеді
Dialogue: 0,0:22:30.60,0:22:34.64,JPED,,0,0,0,,Біреудің өміріне балқыған гүл
Dialogue: 0,0:22:34.78,0:22:42.14,JPED,,0,0,0,,Эй, сен де көре алатыныңа сенімдімін.
Dialogue: 0,0:22:44.36,0:22:49.84,JPED,,0,0,0,,Қайталанған қателерді қайта жазайық
Dialogue: 0,0:22:49.96,0:22:55.22,JPED,,0,0,0,,Бастапқы жолды қалағаныңызша қайталаңыз
Dialogue: 0,0:22:55.62,0:23:01.14,JPED,,0,0,0,,Өткеннен өзгеше ертең
Dialogue: 0,0:23:01.22,0:23:06.48,JPED,,0,0,0,,Екеумізге ғана үміт сызу, бастау сызығы
Dialogue: 0,0:23:07.24,0:23:10.60,JPED,,0,0,0,,Мен ешқашан қоштаспаймын
Dialogue: 0,0:23:10.68,0:23:12.62,JPED,,0,0,0,,Әрқашан солай
Dialogue: 0,0:01:12.28,0:01:12.96,JPDB,,0,0,0,,Акито
Dialogue: 0,0:01:13.56,0:01:14.10,JPDB,,0,0,0,,Мицуки
Dialogue: 0,0:01:14.40,0:01:15.82,JPDB,,0,0,0,,Жақсы, мен байқадым.
Dialogue: 0,0:01:16.42,0:01:17.06,JPDB,,0,0,0,,Курияма мырза
Dialogue: 0,0:01:17.66,0:01:18.68,JPDB,,0,0,0,,Курияма мырза қайда?
Dialogue: 0,0:01:22.74,0:01:26.50,JPDB,,0,0,0,,Жын – адамның кекінен қалыптасатын нәрсе болса, онда
Dialogue: 0,0:01:27.30,0:01:31.00,JPDB,,0,0,0,,Бұл адамның өшпенділігінің массасы.
Dialogue: 0,0:01:31.46,0:01:34.84,JPDB,,0,0,0,,Бұл маған сәйкес келеді.
Dialogue: 0,0:03:09.54,0:03:10.44,JPDB,,0,0,0,,Вент ашылғанына үш күн болды.
Dialogue: 0,0:03:11.02,0:03:13.26,JPDB,,0,0,0,,Әй, сен көптен бері комадасың ғой.
Dialogue: 0,0:03:13.76,0:03:14.94,JPDB,,0,0,0,,Осы уақытқа дейін
Dialogue: 0,0:03:15.42,0:03:18.38,JPDB,,0,0,0,,Әрине, сен енді өлмейтін емессің.
Dialogue: 0,0:03:18.60,0:03:22.74,JPDB,,0,0,0,,Бұрын сіздің ішіңізде өмір сүрген шекаралар жойылды.
Dialogue: 0,0:03:23.04,0:03:24.70,JPDB,,0,0,0,,Оның әлі тірі екені таң қалдырады
Dialogue: 0,0:03:25.02,0:03:29.64,JPDB,,0,0,0,,Бұл не? Менің өлмейтіндігім жартылай жын болғанымнан емес пе?
Dialogue: 0,0:03:30.18,0:03:30.88,JPDB,,0,0,0,,Мүмкін
Dialogue: 0,0:03:32.22,0:03:33.36,JPDB,,0,0,0,,Мен сенімді емеспін
Dialogue: 0,0:03:35.14,0:03:36.78,JPDB,,0,0,0,,Анаңмен сөйлесіп көр.
Dialogue: 0,0:03:39.02,0:03:40.50,JPDB,,0,0,0,,Сонымен, Курияма мырза
Dialogue: 0,0:03:43.22,0:03:43.92,JPDB,,0,0,0,,Жоқ
Dialogue: 0,0:03:44.14,0:03:48.64,JPDB,,0,0,0,,Мираи Курияма сені құтқару үшін бар қанын салады.
Dialogue: 0,0:03:49.00,0:03:52.22,JPDB,,0,0,0,,Шекараның арғы бетімен бірге бұл дүниеден ғайып болды
Dialogue: 0,0:03:53.96,0:03:55.24,JPDB,,0,0,0,,Сіз өлдіңіз бе?
Dialogue: 0,0:03:55.80,0:03:58.74,JPDB,,0,0,0,,Басқа мүмкіндіктерді ойлау қиынырақ болар еді.
Dialogue: 0,0:04:04.84,0:04:06.10,JPDB,,0,0,0,,Бұл қандай дыбыс?
Dialogue: 0,0:04:07.54,0:04:07.96,JPDB,,0,0,0,,Ж-жақсы, олай болар деп ойлаймын.
Dialogue: 0,0:04:09.14,0:04:10.56,JPDB,,0,0,0,,Мен ештеңе естімедім
Dialogue: 0,0:04:12.98,0:04:14.70,JPDB,,0,0,0,,Қараңдаршы, бұл дыбыс.
Dialogue: 0,0:04:15.72,0:04:16.48,JPDB,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:04:19.84,0:04:22.52,JPDB,,0,0,0,,Акки, сен маған қарасаң бірдеңе өзгерді.
Dialogue: 0,0:04:25.16,0:04:27.66,JPDB,,0,0,0,,Дұрыс, мен глушитель киген жоқпын.
Dialogue: 0,0:04:28.38,0:04:30.38,JPDB,,0,0,0,,Басқаша айтқанда, суыққа сезімталдық жақсарды.
Dialogue: 0,0:04:30.84,0:04:32.58,JPDB,,0,0,0,,Сонымен, сіз не айтасыз?
Dialogue: 0,0:04:32.98,0:04:36.52,JPDB,,0,0,0,,Менің суыққа өте сезімтал болуым табиғаттан тыс күштердің әсерінен.
Dialogue: 0,0:04:37.00,0:04:40.88,JPDB,,0,0,0,,Оның жақсарғаны менің күшімнің әлсіреп бара жатқанын білдіреді.
Dialogue: 0,0:04:41.48,0:04:42.32,JPDB,,0,0,0,,Бірдеңе дұрыс емес
Dialogue: 0,0:04:42.94,0:04:44.72,JPDB,,0,0,0,,Мүмкін бұл дыбысқа қатысы бар шығар.
Dialogue: 0,0:04:49.68,0:04:54.40,JPDB,,0,0,0,,Сізді күткенім үшін кешіріңіз. Қосымша омлет күріш және үлкен омлет күріш.
Dialogue: 0,0:05:01.68,0:05:04.20,JPDB,,0,0,0,,Жарайды, мен үш айдан бері ештеңе жеген жоқпын.
Dialogue: 0,0:05:04.72,0:05:06.66,JPDB,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:05:07.28,0:05:09.56,JPDB,,0,0,0,,Акки аспаннан дыбыс шығып жатыр дейді.
Dialogue: 0,0:05:10.14,0:05:13.70,JPDB,,0,0,0,,Бастапқыда Канбара-кунның ішінде болған нәрсе шекарадан тыс болды.
Dialogue: 0,0:05:15.52,0:05:19.28,JPDB,,0,0,0,,Менің денемнен бір сұмдық шықты!
Dialogue: 0,0:05:19.42,0:05:22.68,JPDB,,0,0,0,,Бұл дыбысты естісек ше?
Dialogue: 0,0:05:23.24,0:05:26.46,JPDB,,0,0,0,,Мен оны шекарадан тыс әсер ретінде ғана ойлай аламын.
Dialogue: 0,0:05:27.70,0:05:30.26,JPDB,,0,0,0,,Хироми Изуми қайда орналасқан?
Dialogue: 0,0:05:30.98,0:05:31.80,JPDB,,0,0,0,,Барған кезде не істеуім керек?
Dialogue: 0,0:05:32.16,0:05:34.26,JPDB,,0,0,0,,Ол адам бәрін білген болуы керек.
Dialogue: 0,0:05:34.62,0:05:35.98,JPDB,,0,0,0,,Онда барудың қажеті жоқ.
Dialogue: 0,0:05:36.42,0:05:38.00,JPDB,,0,0,0,,Мен мұның бәрі бұрын айттым.
Dialogue: 0,0:05:38.58,0:05:42.74,JPDB,,0,0,0,,Қалай ойлайсыңдар, Акки ұйықтап жатқанда Изуми-нимен неше рет сөйлесті?
Dialogue: 0,0:05:44.20,0:05:47.40,JPDB,,0,0,0,,Сол себепті Мираи Курияманы өлімді таңдауға мәжбүр еттіңіз бе?
Dialogue: 0,0:05:48.20,0:05:50.44,JPDB,,0,0,0,,Неге ештеңе айтпадың?
Dialogue: 0,0:05:51.14,0:05:52.54,JPDB,,0,0,0,,Егер мен мән-жайды естіген болсам
Dialogue: 0,0:05:52.54,0:05:53.64,JPDB,,0,0,0,,Егер сіз тыңдаған болсаңыз
Dialogue: 0,0:05:54.42,0:05:56.26,JPDB,,0,0,0,,Тыңдағаныңда не істер едің?
Dialogue: 0,0:05:57.40,0:05:58.54,JPDB,,0,0,0,,Курияма-санды тоқтатыңыз ба?
Dialogue: 0,0:05:59.46,0:06:01.62,JPDB,,0,0,0,,Немесе бірігіп, Акихито-кунды өлтіріңіз.
Dialogue: 0,0:06:01.86,0:06:02.76,JPDB,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:06:03.22,0:06:06.40,JPDB,,0,0,0,,Таңдау. Тек екі нұсқа бар.
Dialogue: 0,0:06:07.10,0:06:09.58,JPDB,,0,0,0,,Сіз кімді өлтірер едіңіз?
Dialogue: 0,0:06:11.20,0:06:12.86,JPDB,,0,0,0,,Сондықтан үндемедің бе?
Dialogue: 0,0:06:13.58,0:06:14.74,JPDB,,0,0,0,,Сонда мен не істеуім керек?
Dialogue: 0,0:06:14.98,0:06:18.32,JPDB,,0,0,0,,Мираи Курияманы қайтару үшін Изуми-ни-санға айқайлауым керек пе еді?
Dialogue: 0,0:06:18.32,0:06:20.06,JPDB,,0,0,0,,Сіз білесіз бе? Өзіңіз ойлаңыз.
Dialogue: 0,0:06:20.26,0:06:21.82,JPDB,,0,0,0,,Екеуің де тоқтаңдар.
Dialogue: 0,0:06:21.90,0:06:25.98,JPDB,,0,0,0,,Сізді күткенім үшін кешіріңіз. Бұл гратин омлетінің қосымша тапсырысы.
Dialogue: 0,0:06:26.36,0:06:28.28,JPDB,,0,0,0,,Акито әлі тамақтанып жатыр ма?
Dialogue: 0,0:06:28.62,0:06:29.78,JPDB,,0,0,0,,Мен сұрамадым.
Dialogue: 0,0:06:30.10,0:06:31.02,JPDB,,0,0,0,,Менен
Dialogue: 0,0:06:37.40,0:06:41.90,JPDB,,0,0,0,,Шекарадан тыс, бірнеше мың жылда бір рет, адамның ашуы қаныққан күйге жеткенде,
Dialogue: 0,0:06:42.52,0:06:44.80,JPDB,,0,0,0,,Осы Уцушиёде пайда болады деп айтылатын түс
Dialogue: 0,0:06:47.10,0:06:51.50,JPDB,,0,0,0,,Адамзат өшпенділік құйынында өзінің өмір сүру мақсатын ұмытқанда
Dialogue: 0,0:06:52.08,0:06:53.76,JPDB,,0,0,0,,Әлемнің бір жерінде орын алған
Dialogue: 0,0:06:54.14,0:06:58.20,JPDB,,0,0,0,,Бұл адам әлемін инициализациялауға арналған табиғат заңы деп те айтылады.
Dialogue: 0,0:06:59.14,0:06:59.80,JPDB,,0,0,0,,Қарапайым
Dialogue: 0,0:06:59.96,0:07:03.34,JPDB,,0,0,0,,Қандай адам мұндай сені тірі және өз денесінде сақтай алады?
Dialogue: 0,0:07:03.50,0:07:04.84,JPDB,,0,0,0,,Бұл дүниеде жоқ
Dialogue: 0,0:07:05.98,0:07:08.72,JPDB,,0,0,0,,Бірақ қандай да бір себептермен Акихито оны орнында қалдырды.
Dialogue: 0,0:07:09.02,0:07:12.10,JPDB,,0,0,0,,Өлмейтін жартылай жын ретінде өте қиын тіршілікке айналды.
Dialogue: 0,0:07:12.74,0:07:14.24,JPDB,,0,0,0,,Неге екенін өзім де білмеймін
Dialogue: 0,0:07:14.84,0:07:16.66,JPDB,,0,0,0,,Мұны білетін адам - Яйой Канбара.
Dialogue: 0,0:07:16.66,0:07:18.66,JPDB,,0,0,0,,Маған ондай әңгіме маңызды емес.
Dialogue: 0,0:07:18.82,0:07:20.12,JPDB,,0,0,0,,Оның орнына бұл Курияма мырза.
Dialogue: 0,0:07:20.62,0:07:21.92,JPDB,,0,0,0,,Курияма мырзаны неге шақырдыңыз?
Dialogue: 0,0:07:22.68,0:07:26.98,JPDB,,0,0,0,,Шекараның арғы жағында тек қарғыс атқан қанды тайпа жеңе алатын жын бар еді.
Dialogue: 0,0:07:28.10,0:07:29.00,JPDB,,0,0,0,,Барлығы осы.
Dialogue: 0,0:07:30.14,0:07:32.40,JPDB,,0,0,0,,Бірақ мәселе туындады
Dialogue: 0,0:07:33.10,0:07:36.18,JPDB,,0,0,0,,Мираи Курияма сені өлтіргісі келмейтінін айтты.
Dialogue: 0,0:07:37.32,0:07:40.60,JPDB,,0,0,0,,Сондықтан сізге қалай көмектесетінімді көрсетуден басқа амалым қалмады.
Dialogue: 0,0:07:41.14,0:07:43.22,JPDB,,0,0,0,,Тыныштық кезінде ғана қолдануға болатын әдіс
Dialogue: 0,0:07:44.06,0:07:46.88,JPDB,,0,0,0,,Қалай ойлайсың, мен мұндай түсініктемеге қанағаттанамын ба?
Dialogue: 0,0:07:47.44,0:07:50.38,JPDB,,0,0,0,,Курияма мырзаның бұл әдісті таңдайтынын білуім керек еді.
Dialogue: 0,0:07:51.68,0:07:54.08,JPDB,,0,0,0,,Иә, кек сақтағың келсе, кек сақта.
Dialogue: 0,0:07:54.74,0:07:56.62,JPDB,,0,0,0,,Бірақ Назе отбасының мүшесі ретінде
Dialogue: 0,0:07:56.78,0:07:58.20,JPDB,,0,0,0,,Мен барлығын қорғауға міндетті едім.
Dialogue: 0,0:07:59.30,0:08:00.88,JPDB,,0,0,0,,Мен бұл дүниені қорғауға міндеттімін.
Dialogue: 0,0:08:01.96,0:08:04.98,JPDB,,0,0,0,,Мираи Курияманың да қорғағысы келетін бірдеңесі бар еді.
Dialogue: 0,0:08:06.34,0:08:08.34,JPDB,,0,0,0,,Өз өміріңізден маңыздырақ не бар
Dialogue: 0,0:08:09.14,0:08:14.58,JPDB,,0,0,0,,Ол өлсе де қорғағысы келген нәрсені өз еркімен қорғады.
Dialogue: 0,0:08:16.50,0:08:18.36,JPDB,,0,0,0,,Мен Мираи Куриямаға ризамын.
Dialogue: 0,0:08:19.26,0:08:21.76,JPDB,,0,0,0,,Егер ол бұл опцияны таңдамаған болса, қазір
Dialogue: 0,0:08:22.32,0:08:24.50,JPDB,,0,0,0,,Біз бұл жерде ешқашан тұрған емеспіз
Dialogue: 0,0:08:25.18,0:08:28.18,JPDB,,0,0,0,,Жоқ, бұл дүниенің өзі жоғалып кетуі керек еді.
Dialogue: 0,0:08:29.70,0:08:34.08,JPDB,,0,0,0,,Соңында ол сен оянғанда ашуланасың деді.
Dialogue: 0,0:08:35.06,0:08:37.36,JPDB,,0,0,0,,Бұл Замамиро.
Dialogue: 0,0:08:48.22,0:08:50.46,JPDB,,0,0,0,,Күндер қысқарып барады.
Dialogue: 0,0:08:51.58,0:08:53.80,JPDB,,0,0,0,,Мен мұны істей аламын деп ойладым, себебі бұл арман болды
Dialogue: 0,0:08:54.82,0:08:56.62,JPDB,,0,0,0,,Әлі де қиын, солай емес пе?
Dialogue: 0,0:09:00.18,0:09:00.98,JPDB,,0,0,0,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:09:05.00,0:09:06.00,JPDB,,0,0,0,,"Бүгін түнде біз батырды құрметтейміз!!"
Dialogue: 0,0:09:15.36,0:09:17.50,JPDB,,0,0,0,,Егер болашақта болса, мен үйге оралмас едім.
Dialogue: 0,0:09:18.22,0:09:19.00,JPDB,,0,0,0,,Инами мырза
Dialogue: 0,0:09:19.38,0:09:20.30,JPDB,,0,0,0,,Болашақ қайда?
Dialogue: 0,0:09:24.44,0:09:26.42,JPDB,,0,0,0,,Жауап Болашақ қайда?
Dialogue: 0,0:09:43.92,0:09:44.98,JPDB,,0,0,0,,Мұндай арқа
Dialogue: 0,0:09:48.04,0:09:50.04,JPDB,,0,0,0,,Арқаңды олай көрсетпе.
Dialogue: 0,0:10:17.16,0:10:20.36,JPDB,,0,0,0,,Бұл электрондық хат менің ағама жетеді ме, жоқ па?
Dialogue: 0,0:10:21.26,0:10:23.72,JPDB,,0,0,0,,Менің қарттарым бұл құжатты оқи ма?
Dialogue: 0,0:10:24.58,0:10:27.56,JPDB,,0,0,0,,Тіпті бұл маған қазір түсініксіз.
Dialogue: 0,0:10:29.02,0:10:31.46,JPDB,,0,0,0,,Менің ағам Мираи Курияма.
Dialogue: 0,0:10:32.98,0:10:36.52,JPDB,,0,0,0,,Енді мен ағама барамын.
Dialogue: 0,0:10:37.92,0:10:41.38,JPDB,,0,0,0,,Барыңыз да, «Шекарадан тыс» ойынын жеңіңіз
Dialogue: 0,0:10:46.08,0:10:49.20,JPDB,,0,0,0,,Мен өзімді біртүрлі сезінемін.
Dialogue: 0,0:10:50.14,0:10:52.52,JPDB,,0,0,0,,Мен аздап бақыттымын.
Dialogue: 0,0:10:53.44,0:10:57.34,JPDB,,0,0,0,,Мен қарғыс атқан қанның руында тудым.
Dialogue: 0,0:10:58.26,0:11:00.10,JPDB,,0,0,0,,Менде әрқашан жаман нәрселер болды.
Dialogue: 0,0:11:01.28,0:11:03.80,JPDB,,0,0,0,,Мен әрқашан қалай туылдым деп ойлаймын.
Dialogue: 0,0:11:04.68,0:11:06.20,JPDB,,0,0,0,,Менің өлгім келеді
Dialogue: 0,0:11:06.72,0:11:07.86,JPDB,,0,0,0,,Мен бір жерде ойланып қалдым
Dialogue: 0,0:11:09.24,0:11:10.82,JPDB,,0,0,0,,Бірақ бұл қате болды
Dialogue: 0,0:11:11.92,0:11:14.84,JPDB,,0,0,0,,Мен туғаныма қуаныштымын
Dialogue: 0,0:11:15.74,0:11:19.60,JPDB,,0,0,0,,Бұл құдірет қарғысқа ұшырады делінді.
Dialogue: 0,0:11:20.62,0:11:22.38,JPDB,,0,0,0,,Бұл жексұрын күш
Dialogue: 0,0:11:23.38,0:11:28.84,JPDB,,0,0,0,,Себебі күш біреуді ренжіту емес, біреуді құтқару екенін түсіндім.
Dialogue: 0,0:11:30.10,0:11:34.34,JPDB,,0,0,0,,Осы уақытқа дейін өмір сүріп, өлмегеніме өте қуаныштымын.
Dialogue: 0,0:11:35.28,0:11:39.56,JPDB,,0,0,0,,Мен осы қалаға келіп, үлкендермен танысқаныма өте қуаныштымын.
Dialogue: 0,0:11:40.78,0:11:43.86,JPDB,,0,0,0,,Мен ойлағаннан да көп
Dialogue: 0,0:11:44.86,0:11:46.70,JPDB,,0,0,0,,Мен мәңгі бақытты болдым.
Dialogue: 0,0:11:47.74,0:11:50.64,JPDB,,0,0,0,,Мен қарғысқа ұшыраған жоқпын
Dialogue: 0,0:11:51.76,0:11:52.32,JPDB,,0,0,0,,Аға
Dialogue: 0,0:11:53.16,0:11:56.56,JPDB,,0,0,0,,Сенпай қазірдің өзінде қалыпты өледі.
Dialogue: 0,0:11:57.64,0:12:02.50,JPDB,,0,0,0,,Олай болса, қазірден бастап қалыпты өмір сүріңіз.
Dialogue: 0,0:12:05.44,0:12:09.42,JPDB,,0,0,0,,Дәл сол жолы аға ағам айтқандай.
Dialogue: 0,0:12:11.98,0:12:15.08,JPDB,,0,0,0,,Сенпай I
Dialogue: 0,0:12:33.10,0:12:36.40,JPDB,,0,0,0,,Қарғыс атқан қан жоғала салысымен Наз халқы
Dialogue: 0,0:12:36.66,0:12:38.78,JPDB,,0,0,0,,Жағдай бақылауда деп есептейміз.
Dialogue: 0,0:12:39.44,0:12:43.54,JPDB,,0,0,0,,Алайда, Акихито Канбараның денесінен сүйреп шығарылған шекарадан тыс,
Dialogue: 0,0:12:43.86,0:12:47.38,JPDB,,0,0,0,,Мираи Курияманың қанымен қосылу арқылы ол жойылып кетуден сақтанды.
Dialogue: 0,0:12:48.22,0:12:51.96,JPDB,,0,0,0,,Ол әлсірегенімен, Мираи Куриямамен күресіп жатыр.
Dialogue: 0,0:12:53.28,0:12:54.98,JPDB,,0,0,0,,Шайқаста жеңіске жету
Dialogue: 0,0:12:55.50,0:12:58.82,JPDB,,0,0,0,,Көптеген жындар мен табиғаттан тыс күштердің күшін тартады және өзіне сіңіреді.
Dialogue: 0,0:12:59.30,0:13:00.76,JPDB,,0,0,0,,Қуатыңызды күшейтіңіз
Dialogue: 0,0:13:01.12,0:13:03.08,JPDB,,0,0,0,,Мираи Курияманы жеңуге тырысу
Dialogue: 0,0:13:04.20,0:13:06.74,JPDB,,0,0,0,,Оқшауланған кеңістік құрыңыз
Dialogue: 0,0:13:09.16,0:13:12.50,JPDB,,0,0,0,,Бұл қуат одан әрі күшейтілсе не болады?
Dialogue: 0,0:13:14.08,0:13:15.82,JPDB,,0,0,0,,Ал, Изуми мырза
Dialogue: 0,0:13:23.12,0:13:24.88,JPDB,,0,0,0,,Мұқият қараңыз.
Dialogue: 0,0:13:43.38,0:13:45.18,JPDB,,0,0,0,,Бұл не?
Dialogue: 0,0:13:45.80,0:13:46.38,JPDB,,0,0,0,,Не?
Dialogue: 0,0:13:49.42,0:13:49.96,JPDB,,0,0,0,,Махаббат
Dialogue: 0,0:13:58.36,0:13:59.56,JPDB,,0,0,0,,Осы ойынды қазір тоқтатайық
Dialogue: 0,0:14:05.22,0:14:06.22,JPDB,,0,0,0,,Бұл анық
Dialogue: 0,0:14:30.44,0:14:33.56,JPDB,,0,0,0,,Сенпай, дұрыс тығылуың керек, солай ма?
Dialogue: 0,0:14:49.08,0:14:52.98,JPDB,,0,0,0,,Сенпай Мен ағамын
Dialogue: 0,0:14:55.48,0:14:57.54,JPDB,,0,0,0,,Мен қорғаймын
Dialogue: 0,0:15:46.42,0:15:48.10,JPDB,,0,0,0,,Аспанда не көріп тұрсың?
Dialogue: 0,0:15:48.30,0:15:48.96,JPDB,,0,0,0,,Саана
Dialogue: 0,0:15:49.26,0:15:52.64,JPDB,,0,0,0,,Бірақ мен оның Аккидің айтқанына қатысы бар екеніне сенімдімін.
Dialogue: 0,0:15:57.86,0:15:58.50,JPDB,,0,0,0,,Youmu
Dialogue: 0,0:16:01.72,0:16:02.42,JPDB,,0,0,0,,Нино-сан
Dialogue: 0,0:16:02.86,0:16:05.16,JPDB,,0,0,0,,Бұл кезекті фестиваль сияқты.
Dialogue: 0,0:16:07.00,0:16:07.50,JPDB,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:16:15.78,0:16:17.36,JPDB,,0,0,0,,Бұл не сұмдық?
Dialogue: 0,0:16:20.78,0:16:21.48,JPDB,,0,0,0,,Инами мырза
Dialogue: 0,0:16:22.82,0:16:23.38,JPDB,,0,0,0,,Уваааах! Ашылмай жатыр!
Dialogue: 0,0:16:25.02,0:16:25.60,JPDB,,0,0,0,,Акки
Dialogue: 0,0:16:26.40,0:16:26.96,JPDB,,0,0,0,,Хироми
Dialogue: 0,0:16:27.32,0:16:29.02,JPDB,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:16:29.34,0:16:30.70,JPDB,,0,0,0,,Мұны біреу жасады
Dialogue: 0,0:16:30.92,0:16:31.46,JPDB,,0,0,0,,Уваааах! Ашылмай жатыр!
Dialogue: 0,0:16:37.88,0:16:39.26,JPDB,,0,0,0,,Тартымды болу
Dialogue: 0,0:16:39.78,0:16:40.24,JPDB,,0,0,0,,Тезірек барайық
Dialogue: 0,0:16:46.68,0:16:47.12,JPDB,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:16:47.20,0:16:48.92,JPDB,,0,0,0,,Күт, күт, күт, жоқ, қайт.
Dialogue: 0,0:16:48.92,0:16:49.80,JPDB,,0,0,0,,Сен несін?
Dialogue: 0,0:16:49.80,0:16:50.34,JPDB,,0,0,0,,Бұл тұзақ па?
Dialogue: 0,0:16:50.34,0:16:50.84,JPDB,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:16:50.84,0:16:52.46,JPDB,,0,0,0,,Ендеше артқа түсіңіз.
Dialogue: 0,0:16:57.76,0:16:58.88,JPDB,,0,0,0,,Алайда дәл сол адамдар, олар өмірін қатерге тігіп қорғайтындар
Dialogue: 0,0:16:59.58,0:17:01.04,JPDB,,0,0,0,,Оған тимеңіз, бұл қауіпті.
Dialogue: 0,0:17:04.32,0:17:06.30,JPDB,,0,0,0,,Жоқ
Dialogue: 0,0:17:06.76,0:17:07.40,JPDB,,0,0,0,,Нян
Dialogue: 0,0:17:08.06,0:17:10.84,JPDB,,0,0,0,,Сіз не істеп жатырсыз? Жағдай туралы ойланыңыз.
Dialogue: 0,0:17:10.92,0:17:14.64,JPDB,,0,0,0,,Сіз не істемексіз? Якчан керемет көрініс жасап жатыр.
Dialogue: 0,0:17:14.64,0:17:16.64,JPDB,,0,0,0,,Көп уақыттан кейін шықты деп ойласам, не болды?
Dialogue: 0,0:17:16.64,0:17:17.94,JPDB,,0,0,0,,Ол хат сіз де болдыңыз ба?
Dialogue: 0,0:17:17.94,0:17:20.10,JPDB,,0,0,0,,Қанша күрделі істерді орындадың?
Dialogue: 0,0:17:20.10,0:17:21.10,JPDB,,0,0,0,,Тыныс алу қиын
Dialogue: 0,0:17:21.10,0:17:22.48,JPDB,,0,0,0,,Тұрмыстық зорлық-зомбылық
Dialogue: 0,0:17:22.48,0:17:24.34,JPDB,,0,0,0,,Эди Эдиді тітіркендіреді
Dialogue: 0,0:17:24.52,0:17:26.04,JPDB,,0,0,0,,Бұл D-буй, сен ақымақ ана.
Dialogue: 0,0:17:26.16,0:17:28.04,JPDB,,0,0,0,,Әкеңе айт.
Dialogue: 0,0:17:28.04,0:17:30.10,JPDB,,0,0,0,,Аккун ақымақырақ
Dialogue: 0,0:17:26.76,0:17:27.28,JPDB,,0,0,0,,Аристократтар академиясына сұхбат
Dialogue: 0,0:17:27.58,0:17:28.98,JPDB,,0,0,0,,Аккидің анасы
Dialogue: 0,0:17:30.68,0:17:32.65,JPDB,,0,0,0,,Ақкун көтеріліс кезеңі
Dialogue: 0,0:17:32.65,0:17:34.66,JPDB,,0,0,0,,Егер сіз олардың анасы болсаңыз, кез келген адам бүлік шығарар еді.
Dialogue: 0,0:17:34.72,0:17:37.60,JPDB,,0,0,0,,Сіздің отбасыңызбен көңілді жүргеніңізді естігеніме өкінішті.
Dialogue: 0,0:17:37.80,0:17:42.34,JPDB,,0,0,0,,Бізді шақырудағы мақсатты анаңнан сұрайтын кез келді ме деп ойлаймын.
Dialogue: 0,0:17:42.90,0:17:46.10,JPDB,,0,0,0,,Бұл рас па? Курияма мырза шынымен де тірі.
Dialogue: 0,0:17:46.42,0:17:48.08,JPDB,,0,0,0,,Иә, сен тірісің.
Dialogue: 0,0:17:48.54,0:17:50.78,JPDB,,0,0,0,,Мираи-чан әлі жалғыз соғысуда.
Dialogue: 0,0:17:51.28,0:17:53.30,JPDB,,0,0,0,,Негізі мен сізге көмектесе алмаймын.
Dialogue: 0,0:17:53.56,0:17:56.92,JPDB,,0,0,0,,Егер шекарадан тыс адамдар жеңіске жете берсе, әлем жойылады.
Dialogue: 0,0:17:57.38,0:18:01.38,JPDB,,0,0,0,,Сондықтан біз төтенше жағдайға икемді түрде әрекет етуді шештік.
Dialogue: 0,0:18:01.64,0:18:05.86,JPDB,,0,0,0,,Акито Бұл адамның сыртқы түрі мен аяқталуы енді байланысты емес.
Dialogue: 0,0:18:06.06,0:18:07.12,JPDB,,0,0,0,,Бір нәрсеге көмектесу мүмкін емес
Dialogue: 0,0:18:07.32,0:18:07.70,JPDB,,0,0,0,,соққы
Dialogue: 0,0:18:07.70,0:18:10.04,JPDB,,0,0,0,,Күте тұрыңыз, егер сіз мені ұрсаңыз, мен қуанамын, сондықтан оны елемеңіз.
Dialogue: 0,0:18:10.42,0:18:12.78,JPDB,,0,0,0,,Сонымен, Курияма мырзаға қалай көмектесе аламыз?
Dialogue: 0,0:18:13.20,0:18:16.14,JPDB,,0,0,0,,Осының алдында бір нәрсе сұрайын.
Dialogue: 0,0:18:17.70,0:18:21.02,JPDB,,0,0,0,,Барлығы Мираи Куриямаға барғысы келеді...
Dialogue: 0,0:18:21.92,0:18:24.42,JPDB,,0,0,0,,Жақсы, тез айт.
Dialogue: 0,0:18:24.42,0:18:25.78,JPDB,,0,0,0,,Түсіндім.
Dialogue: 0,0:18:26.16,0:18:26.88,JPDB,,0,0,0,,Төменге жылжыңыз
Dialogue: 0,0:18:29.14,0:18:29.94,JPDB,,0,0,0,,Сіз тассыз ба?
Dialogue: 0,0:18:33.30,0:18:34.72,JPDB,,0,0,0,,Бұл не?
Dialogue: 0,0:18:35.16,0:18:38.72,JPDB,,0,0,0,,Мен бұл бос көлеңкені жеңу кезінде қолданылған Youmu тасы екеніне сенімдімін.
Dialogue: 0,0:18:39.04,0:18:41.12,JPDB,,0,0,0,,Бұл қуыс көлеңке емес пе?
Dialogue: 0,0:18:42.44,0:18:42.90,JPDB,,0,0,0,,Мүмкін емес
Dialogue: 0,0:18:43.50,0:18:46.24,JPDB,,0,0,0,,Иә, бұл тас Ақкүннің бір бөлігі.
Dialogue: 0,0:18:47.22,0:18:50.76,JPDB,,0,0,0,,Басқаша айтқанда, ол да шекараның екінші жағының бөлігі.
Dialogue: 0,0:19:11.84,0:19:14.52,JPDB,,0,0,0,,Шекарадан тыс Мираи Курияма жасаған
Dialogue: 0,0:19:15.46,0:19:19.22,JPDB,,0,0,0,,Акитоның күшті сезімінен жасалған қуыршақ бар.
Dialogue: 0,0:19:21.18,0:19:23.64,JPDB,,0,0,0,,Оны бар күшіңізбен ұстаңыз
Dialogue: 0,0:19:24.22,0:19:26.86,JPDB,,0,0,0,,Youmu тасы қалғандары арқылы сізді алып жүреді.
Dialogue: 0,0:19:28.02,0:19:30.72,JPDB,,0,0,0,,Сіз мұны қайдан білесіз?
Dialogue: 0,0:19:35.92,0:19:39.92,JPDB,,0,0,0,,Білесің бе, сенің анаң Яйой Канбара.
Dialogue: 0,0:19:45.70,0:19:48.86,JPDB,,0,0,0,,Мен сені бір күні мен туралы дұрыс айтуды сұраймын.
Dialogue: 0,0:19:51.06,0:19:54.72,JPDB,,0,0,0,,Жоқ, мен таң қалдым.
Dialogue: 0,0:19:54.84,0:19:55.70,JPDB,,0,0,0,,Яйои Канбара
Dialogue: 0,0:19:55.88,0:19:57.56,JPDB,,0,0,0,,Таң қалма, Изуми
Dialogue: 0,0:19:57.90,0:19:59.32,JPDB,,0,0,0,,Жүр, тез жүр.
Dialogue: 0,0:19:59.60,0:20:01.60,JPDB,,0,0,0,,Тоқта, сен не істейсің?
Dialogue: 0,0:20:02.04,0:20:02.80,JPDB,,0,0,0,,Сіз қазірдің өзінде...
Dialogue: 0,0:20:03.38,0:20:04.28,JPDB,,0,0,0,,Өлмейтін
Dialogue: 0,0:20:05.94,0:20:06.86,JPDB,,0,0,0,,Мен білемін.
Dialogue: 0,0:20:07.72,0:20:11.98,JPDB,,0,0,0,,Бірақ мен көзілдірік пен көзілдірікті әдемі қыздарға бәрібір қолымнан келеді.
Dialogue: 0,0:20:12.48,0:20:13.30,JPDB,,0,0,0,,Ол бұзық.
Dialogue: 0,0:20:18.54,0:20:21.04,JPDB,,0,0,0,,Кешіріңіз, бірақ енді біздің кезегіміз.
Dialogue: 0,0:20:23.98,0:20:26.90,JPDB,,0,0,0,,Тартуыңыз әдеттен тыс.
Dialogue: 0,0:20:27.56,0:20:28.50,JPDB,,0,0,0,,Қанбара Сенпай
Dialogue: 0,0:20:28.78,0:20:32.18,JPDB,,0,0,0,,Мені теууге дайындал, мен сені қайтарамын.
Dialogue: 0,0:20:34.12,0:20:34.58,JPDB,,0,0,0,,Иә
Dialogue: 0,0:21:23.74,0:21:24.50,JPDB,,0,0,0,,Курияма мырза
Dialogue: 0,0:21:56.76,0:21:58.02,JPDB,,0,0,0,,Аға
Dialogue: 0,0:22:02.54,0:22:03.44,JPDB,,0,0,0,,Курияма мырза
Dialogue: 0,0:22:05.72,0:22:06.96,JPDB,,0,0,0,,Замамиро
Dialogue: 0,0:23:27.72,0:23:29.48,JPDB YG,,0,0,0,,Мен мұны алғаш кездескенімізде айттым.
Dialogue: 0,0:23:30.46,0:23:31.82,JPDB YG,,0,0,0,,Мен де солаймын
Dialogue: 0,0:23:32.78,0:23:34.62,JPDB YG,,0,0,0,,Мен Курияма-санның қасындамын
Dialogue: 0,0:23:35.50,0:23:36.58,JPDB YG,,0,0,0,,Енді жалғыз емес
Dialogue: 0,0:23:37.02,0:23:37.88,JPDB YG,,0,0,0,,Аға
Dialogue: 0,0:23:39.38,0:23:45.38,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
