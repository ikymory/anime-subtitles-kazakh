Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:05.00,LOGO,,0000,0000,0000,,Бұл субтитр білім беру және алмасу үшін пайдалануға арналған, коммерциялық пайдалануға тыйым салынған құдай субтитрлерінің тіркесімі болып табылады.
Dialogue: 0,0:00:05.00,0:00:10.00,LOGO,,0000,0000,0000,,Жапон: Анонимді және Сяоран аудармасы: Мори Луо және Йоко Жапон мектебі: үлпілдек Кіші орта мектеп: Ан Шао Уақыты: Сяо Сяо ауруы Мектеп жүйесі: Наксиа өзен крабы
Dialogue: 0,0:00:56.68,0:01:02.18,JPOP,,0000,0000,0000,fx,Жалғыздық бетімді дымқыл етеді, бірақ
Dialogue: 0,0:01:02.54,0:01:07.40,JPOP,,0000,0000,0000,fx,Таңның атысы тып-тыныш толады.
Dialogue: 0,0:01:07.68,0:01:12.64,JPOP,,0000,0000,0000,fx,Мені аспанға шақыр
Dialogue: 0,0:01:12.86,0:01:16.04,JPOP,,0000,0000,0000,fx,Арғы жағында үміт күтіп тұр
Dialogue: 0,0:01:16.04,0:01:21.32,JPOP,,0000,0000,0000,fx,Иә, мен барамын.
Dialogue: 0,0:01:22.66,0:01:28.26,JPOP,,0000,0000,0000,fx,Мен адасып кетсем де сені іздейтін саяхат
Dialogue: 0,0:01:28.50,0:01:33.36,JPOP,,0000,0000,0000,fx,Біздің санамыз бір-бірімізден өтті, қолымыз тиді, солай ма?
Dialogue: 0,0:01:34.86,0:01:43.18,JPOP,,0000,0000,0000,fx,Ұстаймын сені, Жүрегіміз бірін-бірі іздейді
Dialogue: 0,0:01:43.18,0:01:48.74,JPOP,,0000,0000,0000,fx,Бұл арманның дәлелі
Dialogue: 0,0:01:48.92,0:01:54.38,JPOP,,0000,0000,0000,fx,Бір-бірімізді ұстаған сайын біз бір-бірімізге тартыламыз.
Dialogue: 0,0:01:54.64,0:01:59.22,JPOP,,0000,0000,0000,fx,Енді қайғылы күндер болмайды
Dialogue: 0,0:01:59.40,0:02:04.74,JPOP,,0000,0000,0000,fx,Бір-бірін қабылдау және өмір сүру қуанышы
Dialogue: 0,0:02:04.80,0:02:14.02,JPOP,,0000,0000,0000,fx,Екеуіңіздің оянатыныңызға сенімдімін.
Dialogue: 0,0:02:14.84,0:02:23.70,JPOP,,0000,0000,0000,fx,Адасып кетсем де, сені таптым
Dialogue: 0,0:22:07.56,0:22:12.50,JPED,,0000,0000,0000,,Тыныштықты кесуге келген адам болды
Dialogue: 0,0:22:13.38,0:22:18.50,JPED,,0000,0000,0000,,Біз үшін сөзсіз кездесу
Dialogue: 0,0:22:18.96,0:22:21.28,JPED,,0000,0000,0000,,Өкінішті жылатқан көздер
Dialogue: 0,0:22:21.46,0:22:23.76,JPED,,0000,0000,0000,,Сіз осылайша көрініс табасыз
Dialogue: 0,0:22:23.92,0:22:30.20,JPED,,0000,0000,0000,,Мұңға оранып, әдемі гүлдеді
Dialogue: 0,0:22:30.60,0:22:34.64,JPED,,0000,0000,0000,,Біреудің өміріне балқыған гүл
Dialogue: 0,0:22:34.78,0:22:42.14,JPED,,0000,0000,0000,,Эй, сен де көре алатыныңа сенімдімін.
Dialogue: 0,0:22:44.36,0:22:49.84,JPED,,0000,0000,0000,,Қайталанған қателерді қайта жазайық
Dialogue: 0,0:22:49.96,0:22:55.22,JPED,,0000,0000,0000,,Бастапқы жолды қалағаныңызша қайталаңыз
Dialogue: 0,0:22:55.62,0:23:01.14,JPED,,0000,0000,0000,,Өткеннен өзгеше ертең
Dialogue: 0,0:23:01.22,0:23:06.48,JPED,,0000,0000,0000,,Екеумізге ғана үміт сызу, бастау сызығы
Dialogue: 0,0:23:07.24,0:23:10.60,JPED,,0000,0000,0000,,Мен ешқашан қоштаспаймын
Dialogue: 0,0:23:10.68,0:23:12.62,JPED,,0000,0000,0000,,Әрқашан солай
Dialogue: 0,0:00:12.62,0:00:14.16,JPDB,,0000,0000,0000,,(Курокири) Шигараки, күткен нәтижеңді алдың ба?
Dialogue: 0,0:00:15.09,0:00:16.29,JPDB,,0000,0000,0000,,Менің атым Изуми Назэ.
Dialogue: 0,0:00:17.04,0:00:17.75,JPDB,,0000,0000,0000,,Назе
Dialogue: 0,0:00:18.22,0:00:19.01,JPDB,,0000,0000,0000,,Назе отбасы
Dialogue: 0,0:00:19.46,0:00:19.77,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:00:20.26,0:00:23.06,JPDB,,0000,0000,0000,,Мен саған бірдеңе айтайын деп телефон соқтым.
Dialogue: 0,0:02:39.47,0:02:40.49,JPDB,,0000,0000,0000,,Курияма мырза
Dialogue: 0,0:02:47.53,0:02:50.89,JPDB,,0000,0000,0000,,Сенпай, байқадың ба?
Dialogue: 0,0:02:55.88,0:02:57.52,JPDB,,0000,0000,0000,,Бұл болды ма?
Dialogue: 0,0:02:57.71,0:02:58.24,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:02:58.79,0:03:00.62,JPDB,,0000,0000,0000,,Елеске айналу қиын болды.
Dialogue: 0,0:03:01.16,0:03:03.55,JPDB,,0000,0000,0000,,Бақытымызға орай, ешкім зардап шеккен жоқ.
Dialogue: 0,0:03:03.93,0:03:04.85,JPDB,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:03:09.06,0:03:11.38,JPDB,,0000,0000,0000,,Тыныштық әсерінен шығар деп ойлаймын.
Dialogue: 0,0:03:11.82,0:03:13.88,JPDB,,0000,0000,0000,,Өйткені тыртық мәңгі қалды
Dialogue: 0,0:03:14.36,0:03:15.94,JPDB,,0000,0000,0000,,Егер сіз тыныш кезеңде шабуыл жасасаңыз
Dialogue: 0,0:03:16.32,0:03:19.01,JPDB,,0000,0000,0000,,Маған үлкен ағам өлуі мүмкін деді.
Dialogue: 0,0:03:19.46,0:03:21.17,JPDB,,0000,0000,0000,,Сондықтан мен де қорқамын
Dialogue: 0,0:03:24.52,0:03:24.90,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:03:25.19,0:03:26.77,JPDB,,0000,0000,0000,,Оған тимеңіз
Dialogue: 0,0:03:26.94,0:03:29.57,JPDB,,0000,0000,0000,,Тыныштық біткен соң көп ұзамай сауығып кетуі керек.
Dialogue: 0,0:03:31.64,0:03:34.63,JPDB,,0000,0000,0000,,Сіз халықаралық тағамдарда дәмді ештеңе жоқ деп айтатын шығарсыз.
Dialogue: 0,0:03:35.63,0:03:36.76,JPDB,,0000,0000,0000,,Омлет күріш
Dialogue: 0,0:03:36.76,0:03:37.72,JPDB,,0000,0000,0000,,Омлет күріш
Dialogue: 0,0:03:38.18,0:03:38.69,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:03:39.15,0:03:43.49,JPDB,,0000,0000,0000,,Мен Мизуки-сенпайдан сұрағанымда, ол сенпайдың омлет күрішінің сүйікті тағамы екенін айтты.
Dialogue: 0,0:03:44.06,0:03:44.86,JPDB,,0000,0000,0000,,Жұмыртқа туралы не деуге болады?
Dialogue: 0,0:03:46.49,0:03:47.16,JPDB,,0000,0000,0000,,Мұнда
Dialogue: 0,0:03:49.18,0:03:49.73,JPDB,,0000,0000,0000,,Қайнатылған
Dialogue: 0,0:03:49.99,0:03:54.23,JPDB,,0000,0000,0000,,Амал жоқ, жұмыртқа таңқурай еді.
Dialogue: 0,0:03:54.50,0:03:56.25,JPDB,,0000,0000,0000,,Расичи? Болды
Dialogue: 0,0:03:58.88,0:04:00.26,JPDB,,0000,0000,0000,,Сіз қанша қолдандыңыз?
Dialogue: 0,0:04:02.87,0:04:03.84,JPDB,,0000,0000,0000,,Аннигиляция
Dialogue: 0,0:04:07.57,0:04:08.87,JPDB,,0000,0000,0000,,Нана...бұл не?
Dialogue: 0,0:04:09.24,0:04:11.23,JPDB,,0000,0000,0000,,Шие гүлдері қалпына келу мерекесі.
Dialogue: 0,0:04:11.27,0:04:12.47,JPDB,,0000,0000,0000,,Бұл салт қай жерде?
Dialogue: 0,0:04:12.76,0:04:14.38,JPDB,,0000,0000,0000,,Қанша санасыз болсаң да,
Dialogue: 0,0:04:14.57,0:04:16.31,JPDB,,0000,0000,0000,,Басқа біреудің тоңазытқышын рұқсатсыз ашпаңыз.
Dialogue: 0,0:04:16.34,0:04:17.60,JPDB,,0000,0000,0000,,Шошқаның басын қоспаңыз
Dialogue: 0,0:04:17.85,0:04:19.85,JPDB,,0000,0000,0000,,Жарайды, Сенпай, ұйықта.
Dialogue: 0,0:04:20.29,0:04:23.07,JPDB,,0000,0000,0000,,Мен дүкенге барып, оны қайтадан дұрыстап жасаймын.
Dialogue: 0,0:04:23.42,0:04:24.02,JPDB,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:04:24.43,0:04:25.39,JPDB,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:04:26.10,0:04:26.77,JPDB,,0000,0000,0000,,Бұл
Dialogue: 0,0:04:27.36,0:04:27.94,JPDB,,0000,0000,0000,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:04:28.33,0:04:29.51,JPDB,,0000,0000,0000,,№.
Dialogue: 0,0:04:29.51,0:04:31.17,JPDB,,0000,0000,0000,,Мен мұны тіпті түсінбеймін.
Dialogue: 0,0:04:31.33,0:04:32.18,JPDB,,0000,0000,0000,,Сакура
Dialogue: 0,0:04:32.29,0:04:32.99,JPDB,,0000,0000,0000,,Юкине, сонда ісіңді бітірген соң дүкенге қара.
Dialogue: 0,0:04:33.37,0:04:35.02,JPDB,,0000,0000,0000,,Қанбара-сенпай құлаған соң
Dialogue: 0,0:04:35.47,0:04:38.73,JPDB,,0000,0000,0000,,Болашақ мені ешқашан тастамады, мен оған қамқор болдым.
Dialogue: 0,0:04:40.45,0:04:41.56,JPDB,,0000,0000,0000,,Әлі білмеймін
Dialogue: 0,0:04:41.87,0:04:42.39,JPDB,,0000,0000,0000,,Не
Dialogue: 0,0:04:42.92,0:04:44.72,JPDB,,0000,0000,0000,,Болашақ Бұл адам жақсы болмауы мүмкін
Dialogue: 0,0:04:46.15,0:04:48.88,JPDB,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Сен не туралы айтып тұрсың?
Dialogue: 0,0:04:48.91,0:04:50.38,JPDB,,0000,0000,0000,,Оны анық айтқан дұрыс
Dialogue: 0,0:04:50.44,0:04:52.21,JPDB,,0000,0000,0000,,Сіз не істейсіз? Сіз не істейсіз?
Dialogue: 0,0:04:52.46,0:04:53.50,JPDB,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:04:55.13,0:04:55.57,JPDB,,0000,0000,0000,,Күн ыстық
Dialogue: 0,0:04:56.16,0:04:58.75,JPDB,,0000,0000,0000,,Міне, жаз мезгілі.
Dialogue: 0,0:05:03.13,0:05:03.89,JPDB,,0000,0000,0000,,Жаз?
Dialogue: 0,0:05:27.78,0:05:29.39,JPDB,,0000,0000,0000,,Қайырлы таң, Сенпай.
Dialogue: 0,0:05:30.06,0:05:31.32,JPDB,,0000,0000,0000,,Бүгін тағы да салқын.
Dialogue: 0,0:05:55.53,0:05:56.31,JPDB,,0000,0000,0000,,Шие гүлдері ше?
Dialogue: 0,0:05:56.87,0:05:58.54,JPDB,,0000,0000,0000,,Ол бірінші барамын деді.
Dialogue: 0,0:06:00.48,0:06:01.69,JPDB,,0000,0000,0000,,Жазғы демалыстан күткендей
Dialogue: 0,0:06:02.23,0:06:04.81,JPDB,,0000,0000,0000,,Бірақ мен жаңа ғана Мизуки-сенпайға электрондық хат жібердім.
Dialogue: 0,0:06:04.89,0:06:05.76,JPDB,,0000,0000,0000,,Тіпті мектеп
Dialogue: 0,0:06:06.53,0:06:07.72,JPDB,,0000,0000,0000,,Қайтадан көбейген болуы керек.
Dialogue: 0,0:06:08.22,0:06:09.66,JPDB,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:06:09.97,0:06:12.07,JPDB,,0000,0000,0000,,Әрине сатып алатын ақшам жоқ.
Dialogue: 0,0:06:12.61,0:06:14.52,JPDB,,0000,0000,0000,,Эй, бұл Сакурадан келген электрондық хат.
Dialogue: 0,0:06:14.68,0:06:14.87,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:17.90,0:06:19.51,JPDB,,0000,0000,0000,,Неліктен мұндай жерде болдың?
Dialogue: 0,0:06:19.76,0:06:20.88,JPDB,,0000,0000,0000,,Көзілдірік
Dialogue: 0,0:06:23.78,0:06:27.10,JPDB,,0000,0000,0000,,Мен Акихитоның дауысын естіп тұрғаным біртүрлі.
Dialogue: 0,0:06:27.34,0:06:28.25,JPDB,,0000,0000,0000,,Бұл галлюцинация ма?
Dialogue: 0,0:06:28.45,0:06:29.43,JPDB,,0000,0000,0000,,Бұл үлкен!
Dialogue: 0,0:06:29.75,0:06:34.07,JPDB,,0000,0000,0000,,Күннен қорғайтын көзілдірік көзілдірікке қарағанда аздап деструктивті күшке ие екені даусыз.
Dialogue: 0,0:06:34.30,0:06:38.09,JPDB,,0000,0000,0000,,бала әдетте кимейтін купальник пен көзілдірік киген жағдайда ғана.
Dialogue: 0,0:06:37.45,0:06:39.47,JPDB,,0000,0000,0000,,Көп сөйлейтін иллюзия.
Dialogue: 0,0:06:39.73,0:06:40.57,JPDB,,0000,0000,0000,,Иллюзия
Dialogue: 0,0:06:40.95,0:06:42.38,JPDB,,0000,0000,0000,,Акито өлген болуы керек.
Dialogue: 0,0:06:42.91,0:06:44.27,JPDB,,0000,0000,0000,,Шамамен екі апта бұрын
Dialogue: 0,0:06:44.85,0:06:46.75,JPDB,,0000,0000,0000,,Осыны ойласам, аядым.
Dialogue: 0,0:06:47.60,0:06:50.63,JPDB,,0000,0000,0000,,Адамдар сізді қаншалықты таңдандырса, өміріңіз соншалықты қысқа болады дейді.
Dialogue: 0,0:06:51.21,0:06:54.52,JPDB,,0000,0000,0000,,Акихитоға келетін болсақ, бұл мүлде болған жоқ.
Dialogue: 0,0:06:55.06,0:06:58.40,JPDB,,0000,0000,0000,,Жек көру, менсінбеу және мазасыздану
Dialogue: 0,0:07:02.83,0:07:04.32,JPDB,,0000,0000,0000,,Өйткені ол қайтыс болды және өмірден өтті.
Dialogue: 0,0:07:04.57,0:07:05.30,JPDB,,0000,0000,0000,,Өлмеген
Dialogue: 0,0:07:09.15,0:07:10.92,JPDB,,0000,0000,0000,,Бұл шынайы сияқты
Dialogue: 0,0:07:11.60,0:07:13.46,JPDB,,0000,0000,0000,,Олай болса тез кет.
Dialogue: 0,0:07:14.05,0:07:19.15,JPDB,,0000,0000,0000,,Менің купальникімді Акитоға тегін көрсету - қорлаудан басқа ештеңе емес.
Dialogue: 0,0:07:19.35,0:07:22.24,JPDB,,0000,0000,0000,,Менің ойымша, Мизуки өз бетімен купальник киіп жүр.
Dialogue: 0,0:07:22.70,0:07:23.43,JPDB,,0000,0000,0000,,Акито
Dialogue: 0,0:07:24.22,0:07:24.69,JPDB,,0000,0000,0000,,Не?
Dialogue: 0,0:07:25.15,0:07:28.94,JPDB,,0000,0000,0000,,Осыдан сабақ алып, өзіңізге қайта қараңыз.
Dialogue: 0,0:07:29.60,0:07:33.15,JPDB,,0000,0000,0000,,Мен мұндай сезімнен шаршадым.
Dialogue: 0,0:07:37.61,0:07:37.94,JPDB,,0000,0000,0000,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:07:38.74,0:07:42.11,JPDB,,0000,0000,0000,,Ал сол азғынды клуб бөлмесіне апарыңыз.
Dialogue: 0,0:07:42.45,0:07:43.26,JPDB,,0000,0000,0000,,Эй, бұзық
Dialogue: 0,0:07:43.96,0:07:45.05,JPDB,,0000,0000,0000,,Қандай бұзық
Dialogue: 0,0:07:48.24,0:07:50.57,JPDB,,0000,0000,0000,,Қар тоқтамайды.
Dialogue: 0,0:07:53.08,0:07:55.36,JPDB,,0000,0000,0000,,ауырсыну сезімі
Dialogue: 0,0:07:56.26,0:07:57.04,JPDB,,0000,0000,0000,,Аға
Dialogue: 0,0:08:00.32,0:08:01.15,JPDB,,0000,0000,0000,,Аға
Dialogue: 0,0:08:07.65,0:08:08.22,JPDB,,0000,0000,0000,,Ол мойнын қорғап қалды
Dialogue: 0,0:08:09.44,0:08:11.10,JPDB,,0000,0000,0000,,Күте тұрыңыз, Сенпай.
Dialogue: 0,0:08:12.45,0:08:15.78,JPDB,,0000,0000,0000,,Күте тұрыңыз
Dialogue: 0,0:08:21.93,0:08:24.00,JPDB,,0000,0000,0000,,Күндер қысқарып барады.
Dialogue: 0,0:08:24.53,0:08:26.21,JPDB,,0000,0000,0000,,Жазғы күн тоқырау маусымы.
Dialogue: 0,0:08:27.47,0:08:28.60,JPDB,,0000,0000,0000,,Тағы біраз оқығыңыз келе ме?
Dialogue: 0,0:08:29.12,0:08:29.75,JPDB,,0000,0000,0000,,Жоқ
Dialogue: 0,0:08:30.82,0:08:32.58,JPDB,,0000,0000,0000,,Хироми мен Мизуки баяу.
Dialogue: 0,0:08:33.31,0:08:34.31,JPDB,,0000,0000,0000,,Мен үйге қайттым.
Dialogue: 0,0:08:34.54,0:08:35.01,JPDB,,0000,0000,0000,,Ал сен ше, Хори-сан? Қандай музыка ұнайды?
Dialogue: 0,0:08:35.99,0:08:36.55,JPDB,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:08:36.55,0:08:39.74,JPDB,,0000,0000,0000,,Адам өмір мен өлім арасында адасып, ақыры қайтады.
Dialogue: 0,0:08:40.03,0:08:41.38,JPDB,,0000,0000,0000,,Сол себепті емес пе?
Dialogue: 0,0:08:42.27,0:08:44.22,JPDB,,0000,0000,0000,,Бұл ұят екеніне сенімдімін.
Dialogue: 0,0:08:47.67,0:08:48.51,JPDB,,0000,0000,0000,,Не болды?
Dialogue: 0,0:08:48.70,0:08:49.66,JPDB,,0000,0000,0000,,Жоқ
Dialogue: 0,0:08:53.58,0:08:55.23,JPDB,,0000,0000,0000,,Курияма мырза, уақытыңыз бар ма?
Dialogue: 0,0:08:56.36,0:08:58.96,JPDB,,0000,0000,0000,,Жоқ, мен күріш алайын деп ойлаймын.
Dialogue: 0,0:08:59.48,0:09:01.62,JPDB,,0000,0000,0000,,Ах, ақшам болмаса, сатып алар едім.
Dialogue: 0,0:09:02.63,0:09:03.17,JPDB,,0000,0000,0000,,болып табылады
Dialogue: 0,0:09:03.58,0:09:05.50,JPDB,,0000,0000,0000,,Қараңызшы, мен мүлде түсінбеймін.
Dialogue: 0,0:09:05.79,0:09:07.91,JPDB,,0000,0000,0000,,Сіз көп қиындық тудырғаныңызға сенімдімін.
Dialogue: 0,0:09:13.97,0:09:16.40,JPDB,,0000,0000,0000,,Маған тезірек айтқаныңызды қалаймын.
Dialogue: 0,0:09:16.72,0:09:17.24,JPDB,,0000,0000,0000,,Жақсы емес.
Dialogue: 0,0:09:17.93,0:09:18.32,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:09:20.32,0:09:22.99,JPDB,,0000,0000,0000,,Күн батқанда бітетін шығар.
Dialogue: 0,0:09:23.67,0:09:24.43,JPDB,,0000,0000,0000,,Оны өз бетінше қалдыр
Dialogue: 0,0:09:27.10,0:09:32.59,JPDB,,0000,0000,0000,,Маған неге сонша мейірімдісің?
Dialogue: 0,0:09:32.99,0:09:33.24,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:37.86,0:09:39.54,JPDB,,0000,0000,0000,,Өйткені сен маған ұқсайсың
Dialogue: 0,0:09:41.42,0:09:44.01,JPDB,,0000,0000,0000,,Олай десеңіз, Курияма мырза ашуланады.
Dialogue: 0,0:09:44.59,0:09:45.80,JPDB,,0000,0000,0000,,Сізге бұл ұнамайды ма?
Dialogue: 0,0:09:45.93,0:09:48.07,JPDB,,0000,0000,0000,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:09:48.07,0:09:50.28,JPDB,,0000,0000,0000,,Сіз шынымен ашуланған сияқтысыз, солай емес пе?
Dialogue: 0,0:09:50.59,0:09:52.21,JPDB,,0000,0000,0000,,Хмм...сен бақыттысың ба?
Dialogue: 0,0:09:52.34,0:09:53.57,JPDB,,0000,0000,0000,,Неліктен бұл болып жатыр?
Dialogue: 0,0:09:53.75,0:09:55.90,JPDB,,0000,0000,0000,,Жоқ Мизуки-сенпайдан
Dialogue: 0,0:09:56.38,0:10:00.96,JPDB,,0000,0000,0000,,Қанбара-сенпай қысым көргеннен күшті ләззат алады деген.
Dialogue: 0,0:10:01.49,0:10:04.34,JPDB,,0000,0000,0000,,Бірақ істер әрқашан жақсы бола бермейді.
Dialogue: 0,0:10:04.34,0:10:05.70,JPDB,,0000,0000,0000,,Бұл жақсы өтуі керек емес.
Dialogue: 0,0:10:05.95,0:10:07.89,JPDB,,0000,0000,0000,,Мизукидің сізге айтқанын ұмытыңыз.
Dialogue: 0,0:10:07.99,0:10:08.53,JPDB,,0000,0000,0000,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:10:09.57,0:10:10.39,JPDB,,0000,0000,0000,,Мен ұмытпаймын
Dialogue: 0,0:10:11.86,0:10:12.95,JPDB,,0000,0000,0000,,Мен ұмытпаймын
Dialogue: 0,0:10:18.42,0:10:19.84,JPDB,,0000,0000,0000,,696-санды тұтқын – Мұнда не болып жатыр өзі?
Dialogue: 0,0:10:21.54,0:10:22.43,JPDB,,0000,0000,0000,,Мен ағамын.
Dialogue: 0,0:10:23.37,0:10:24.63,JPDB,,0000,0000,0000,,Шекарадан тыс
Dialogue: 0,0:10:25.53,0:10:29.83,JPDB,,0000,0000,0000,,Дүниені бұзады делінетін адам санасындағы бұрмалаулар жинағы.
Dialogue: 0,0:10:30.73,0:10:34.02,JPDB,,0000,0000,0000,,Бұл менің аға сыныптағы Юму болатын.
Dialogue: 0,0:10:34.97,0:10:36.44,JPDB,,0000,0000,0000,,Бұл менмін
Dialogue: 0,0:10:37.15,0:10:42.21,JPDB,,0000,0000,0000,,Мен бұл қалаға «Шекарадан тыс» командасын жеңу үшін келдім.
Dialogue: 0,0:10:42.97,0:10:45.90,JPDB,,0000,0000,0000,,Бірақ нәтиже болмады.
Dialogue: 0,0:10:46.94,0:10:49.40,JPDB,,0000,0000,0000,,Мен ағамды өлтіре алмадым.
Dialogue: 0,0:10:50.41,0:10:51.64,JPDB,,0000,0000,0000,,Мен сені өлтіргім келмеді
Dialogue: 0,0:10:52.37,0:10:52.96,JPDB,,0000,0000,0000,,Сонымен
Dialogue: 0,0:11:02.67,0:11:03.84,JPDB,,0000,0000,0000,,Осындай тыныш уақытта
Dialogue: 0,0:11:04.19,0:11:05.85,JPDB,,0000,0000,0000,,Қанымның құдіретімен
Dialogue: 0,0:11:06.47,0:11:10.14,JPDB,,0000,0000,0000,,Мен сендердің үлкендеріңді шекарадан тыс жерде қуып шығуға болады деп естідім.
Dialogue: 0,0:11:10.90,0:11:13.54,JPDB,,0000,0000,0000,,Мен мұны шынымен істегім келеді
Dialogue: 0,0:11:26.66,0:11:29.30,JPDB,,0000,0000,0000,,Курияма мырзаға не болды?
Dialogue: 0,0:11:29.91,0:11:30.68,JPDB,,0000,0000,0000,,Жоғалып кетті
Dialogue: 0,0:11:31.75,0:11:35.12,JPDB,,0000,0000,0000,,Сонда...онда Курияма мырза мұнда кім?
Dialogue: 0,0:11:35.82,0:11:38.66,JPDB,,0000,0000,0000,,Сенпай, ол әлі оянған жоқ.
Dialogue: 0,0:11:39.29,0:11:39.59,JPDB,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:40.13,0:11:42.51,JPDB,,0000,0000,0000,,Мен мұнда әлі армандамын.
Dialogue: 0,0:11:44.11,0:11:47.61,JPDB,,0000,0000,0000,,Сенің ішіңде қалған менің қанымның кішкене бөлігі
Dialogue: 0,0:11:47.82,0:11:49.22,JPDB,,0000,0000,0000,,Мен саған бұл түсімді көрсетіп тұрмын.
Dialogue: 0,0:11:53.96,0:11:55.82,JPDB,,0000,0000,0000,,Бірақ бәрі бітті.
Dialogue: 0,0:11:56.26,0:11:58.17,JPDB,,0000,0000,0000,,Сенпай, мен қазір ояумын.
Dialogue: 0,0:11:58.59,0:11:59.35,JPDB,,0000,0000,0000,,Курияма мырза
Dialogue: 0,0:12:15.69,0:12:17.86,JPDB,,0000,0000,0000,,Мен мұны істей аламын деп ойладым, себебі бұл арман болды
Dialogue: 0,0:12:19.19,0:12:20.94,JPDB,,0000,0000,0000,,Әлі де қиын, солай емес пе?
Dialogue: 0,0:12:23.13,0:12:23.79,JPDB,,0000,0000,0000,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:12:37.24,0:12:37.75,JPDB,,0000,0000,0000,,Сіз жақсысыз ба?
Dialogue: 0,0:12:48.41,0:12:49.35,JPDB,,0000,0000,0000,,Мираи Курияма
Dialogue: 0,0:12:51.47,0:12:53.76,JPDB,,0000,0000,0000,,Танысқаныма қуаныштымын, мен Изуми Назимін.
Dialogue: 0,0:12:55.18,0:12:55.93,JPDB,,0000,0000,0000,,Мираи Курияма
Dialogue: 0,0:12:56.84,0:12:59.27,JPDB,,0000,0000,0000,,Қарғыс атқан қанды заңды түрде мұра еткен бөтен адам.
Dialogue: 0,0:12:59.77,0:13:04.80,JPDB,,0000,0000,0000,,Басқа көптеген шетелдіктер жек көретін отбасы?
Dialogue: 0,0:13:05.25,0:13:05.52,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:13:06.46,0:13:07.08,JPDB,,0000,0000,0000,,Курияма мырза
Dialogue: 0,0:13:19.30,0:13:21.73,JPDB,,0000,0000,0000,,Шабуыл жасау үшін өз қанын басқарады
Dialogue: 0,0:13:22.55,0:13:25.20,JPDB,,0000,0000,0000,,Тек қатып қана қоймайды, сонымен қатар күшті уы да бар.
Dialogue: 0,0:13:26.00,0:13:28.56,JPDB,,0000,0000,0000,,Қарсыластың ішкі тіндерін де жоюға болады
Dialogue: 0,0:13:29.18,0:13:30.89,JPDB,,0000,0000,0000,,Сіз оны жеңе аласыз ба?
Dialogue: 0,0:13:31.31,0:13:32.39,JPDB,,0000,0000,0000,,Қазіргі уақытта ештеңе мүмкін емес.
Dialogue: 0,0:13:33.25,0:13:35.38,JPDB,,0000,0000,0000,,Бірақ біз бұл мүмкін деп ойлаймыз
Dialogue: 0,0:13:35.84,0:13:38.42,JPDB,,0000,0000,0000,,Субъект өлмейтін деп айтылады.
Dialogue: 0,0:13:38.84,0:13:39.05,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:13:40.40,0:13:41.03,JPDB,,0000,0000,0000,,Өлмейтіндік?
Dialogue: 0,0:13:41.59,0:13:45.03,JPDB,,0000,0000,0000,,Шындығында, регенерация қабілеті қорқынышты тез.
Dialogue: 0,0:13:46.10,0:13:50.20,JPDB,,0000,0000,0000,,Өлмейтін жарты жын Айналадағылар осылай дейді.
Dialogue: 0,0:13:51.25,0:13:53.17,JPDB,,0000,0000,0000,,Өлмейтін жартылай жын?
Dialogue: 0,0:13:53.91,0:13:54.72,JPDB,,0000,0000,0000,,Мен саған көрсетемін
Dialogue: 0,0:13:57.16,0:13:58.40,JPDB,,0000,0000,0000,,Жын ұстаудан айырмашылығы
Dialogue: 0,0:13:58.82,0:14:02.08,JPDB,,0000,0000,0000,,Жартылай адам, жартылай сен, мүмкін емес және қауіпті тіршілік
Dialogue: 0,0:14:03.23,0:14:07.10,JPDB,,0000,0000,0000,,Қарасам, youmu бөлігі шекараның сыртында тұрған сияқты.
Dialogue: 0,0:14:08.28,0:14:11.72,JPDB,,0000,0000,0000,,Бағыну кезінде ініме шабуыл жасалды.
Dialogue: 0,0:14:12.47,0:14:13.83,JPDB,,0000,0000,0000,,Мен ауыр жарақат алдым, өлім аузында.
Dialogue: 0,0:14:16.17,0:14:17.40,JPDB,,0000,0000,0000,,Мен сізге ғана сене аламын
Dialogue: 0,0:14:18.31,0:14:18.74,JPDB,,0000,0000,0000,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:14:20.61,0:14:23.12,JPDB,,0000,0000,0000,,Бұл шекарадан тыс
Dialogue: 0,0:14:23.82,0:14:24.56,JPDB,,0000,0000,0000,,Бұл адам
Dialogue: 0,0:14:25.01,0:14:27.52,JPDB,,0000,0000,0000,,Басқа әлем қауымдастығы хабардар ма?
Dialogue: 0,0:14:28.06,0:14:28.63,JPDB,,0000,0000,0000,,Мүмкін
Dialogue: 0,0:14:29.54,0:14:31.51,JPDB,,0000,0000,0000,,Мен оны қолдаймын
Dialogue: 0,0:14:33.03,0:14:33.91,JPDB,,0000,0000,0000,,Жоқ—сол қолымды пайдаланбай-ақ ең үздікке айналу арқылы—
Dialogue: 0,0:14:34.51,0:14:36.72,JPDB,,0000,0000,0000,,Мен оны өзіммен бірге ресми жерде отырғыздым.
Dialogue: 0,0:14:37.59,0:14:39.31,JPDB,,0000,0000,0000,,Бұл жер ескі жер болғандықтан ба?
Dialogue: 0,0:14:39.76,0:14:40.66,JPDB,,0000,0000,0000,,Көптеген әдет-ғұрыптар
Dialogue: 0,0:14:41.71,0:14:42.23,JPDB,,0000,0000,0000,,Бонсай?
Dialogue: 0,0:14:42.70,0:14:43.14,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:14:43.84,0:14:45.04,JPDB,,0000,0000,0000,,одан да көп
Dialogue: 0,0:14:45.30,0:14:45.74,JPDB,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:14:46.05,0:14:48.34,JPDB,,0000,0000,0000,,Бұл шекарадан қай жерде?
Dialogue: 0,0:14:49.06,0:14:50.01,JPDB,,0000,0000,0000,,Қарсымын!
Dialogue: 0,0:14:50.57,0:14:51.71,JPDB,,0000,0000,0000,,Мен оны дұрыс бақылап отырмын.
Dialogue: 0,0:14:52.33,0:14:54.90,JPDB,,0000,0000,0000,,Қалай болғанда да, оны өлтіру керек.
Dialogue: 0,0:14:55.50,0:14:56.87,JPDB,,0000,0000,0000,,Неғұрлым тезірек болса, соғұрлым жақсы
Dialogue: 0,0:14:57.19,0:14:57.81,JPDB,,0000,0000,0000,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:14:59.11,0:15:00.89,JPDB,,0000,0000,0000,,Сіз мұны түсінбейсіз бе?
Dialogue: 0,0:15:01.38,0:15:02.33,JPDB,,0000,0000,0000,,Сіз де дәл қазір
Dialogue: 0,0:15:02.14,0:15:02.58,JPDB,,0000,0000,0000,,Жоқ
Dialogue: 0,0:15:03.71,0:15:06.25,JPDB,,0000,0000,0000,,Бұл сіздің жүрегіңіз дайын дегенді білдіреді.
Dialogue: 0,0:15:06.94,0:15:07.52,JPDB,,0000,0000,0000,,Мен тыңдап жатырмын.
Dialogue: 0,0:15:08.07,0:15:09.15,JPDB,,0000,0000,0000,,Юи Инами туралы
Dialogue: 0,0:15:10.55,0:15:11.37,JPDB,,0000,0000,0000,,Жоқ—сол қолымды пайдаланбай-ақ ең үздікке айналу арқылы—
Dialogue: 0,0:15:12.31,0:15:15.93,JPDB,,0000,0000,0000,,Осы уақытқа дейін мені жат планеталықтар туралы жаман сезіндім.
Dialogue: 0,0:15:16.29,0:15:17.45,JPDB,,0000,0000,0000,,Осыны орындаңыз
Dialogue: 0,0:15:18.34,0:15:20.71,JPDB,,0000,0000,0000,,Мен сенің бұлай айтқаныңды қаламаймын.
Dialogue: 0,0:15:29.33,0:15:31.21,JPDB,,0000,0000,0000,,Жартылай жынның аты - Акито Канбара.
Dialogue: 0,0:15:32.22,0:15:33.13,JPDB,,0000,0000,0000,,Орта мектептің екінші курс студенті
Dialogue: 0,0:15:34.28,0:15:34.70,JPDB,,0000,0000,0000,,Сен
Dialogue: 0,0:15:37.75,0:15:39.90,JPDB,,0000,0000,0000,,А...екінші жақ жаман болды.
Dialogue: 0,0:15:41.27,0:15:44.76,JPDB,,0000,0000,0000,,А...мм...
Dialogue: 0,0:15:45.54,0:15:48.67,JPDB,,0000,0000,0000,,Әзірше мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:15:49.42,0:15:50.24,JPDB,,0000,0000,0000,,«Сенім артамын.»
Dialogue: 0,0:15:50.59,0:15:53.10,JPDB,,0000,0000,0000,,Бұл адам шынымен қауіпті ме?
Dialogue: 0,0:15:55.89,0:15:57.31,JPDB,,0000,0000,0000,,Сен маған неге көңіл бөлесің?
Dialogue: 0,0:15:58.62,0:16:00.42,JPDB,,0000,0000,0000,,Олай болса, неге жат планеталық болуды тоқтатпайсың?
Dialogue: 0,0:16:00.54,0:16:02.83,JPDB,,0000,0000,0000,,Егер мен тастай алатын болсам, баяғыда тастар едім.
Dialogue: 0,0:16:04.81,0:16:10.41,JPDB,,0000,0000,0000,,Бірақ ішімде ағып жатқан мына қарғыс атқан қан қалыпты емес.
Dialogue: 0,0:16:10.99,0:16:11.88,JPDB,,0000,0000,0000,,Бұл қуат
Dialogue: 0,0:16:13.31,0:16:14.87,JPDB,,0000,0000,0000,,Мен үшін де солай.
Dialogue: 0,0:16:22.16,0:16:25.39,JPDB,,0000,0000,0000,,Неге олай дейсің?
Dialogue: 0,0:16:26.13,0:16:26.67,JPDB,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:16:29.70,0:16:33.35,JPDB,,0000,0000,0000,,Өйткені, өлместік сипаттарын түсіну оңай емес.
Dialogue: 0,0:16:33.79,0:16:34.27,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:16:35.09,0:16:36.73,JPDB,,0000,0000,0000,,Мен қарап шыққаным жөн.
Dialogue: 0,0:16:37.65,0:16:39.38,JPDB,,0000,0000,0000,,Соқыр шабуыл жасасаңыз да
Dialogue: 0,0:16:39.68,0:16:40.98,JPDB,,0000,0000,0000,,Бір нәрсені қайталау
Dialogue: 0,0:16:41.61,0:16:42.16,JPDB,,0000,0000,0000,,Бірақ
Dialogue: 0,0:16:42.50,0:16:43.68,JPDB,,0000,0000,0000,,Хироми сияқты
Dialogue: 0,0:16:44.17,0:16:47.13,JPDB,,0000,0000,0000,,Бетінде әрқашан шекарадан тыс нәрсе пайда болады.
Dialogue: 0,0:16:48.06,0:16:49.10,JPDB,,0000,0000,0000,,Сол сәтті мақсат ету
Dialogue: 0,0:16:50.27,0:16:51.17,JPDB,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:16:51.80,0:16:56.15,JPDB,,0000,0000,0000,,Алдымен мынаны айтайын
Dialogue: 0,0:16:56.62,0:16:59.42,JPDB,,0000,0000,0000,,Акихитодан қашық болған дұрыс.
Dialogue: 0,0:17:02.41,0:17:04.20,JPDB,,0000,0000,0000,,Аа, дұрыс, Курияма мырза.
Dialogue: 0,0:17:04.46,0:17:05.40,JPDB,,0000,0000,0000,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:17:05.74,0:17:07.49,JPDB,,0000,0000,0000,,Бұл кеше туралы, бірақ мен білмеймін.
Dialogue: 0,0:17:08.07,0:17:11.17,JPDB,,0000,0000,0000,,Мен сені бір рет әдебиет үйірмесіне шақырайын деп жатырмын, жарай ма?
Dialogue: 0,0:17:11.58,0:17:13.39,JPDB,,0000,0000,0000,,Ол ешқандай клуб іс-шараларында емес екенін айтады.
Dialogue: 0,0:17:13.64,0:17:16.23,JPDB,,0000,0000,0000,,Бір мектептен басқа шетелдіктер жоқтың қасы.
Dialogue: 0,0:17:16.56,0:17:18.03,JPDB,,0000,0000,0000,,Ол жаңа ғана осында келді.
Dialogue: 0,0:17:17.68,0:17:19.59,JPDB,,0000,0000,0000,,Мен жоқ дедім.
Dialogue: 0,0:17:21.00,0:17:21.64,JPDB,,0000,0000,0000,,Ол мойнын қорғап қалды
Dialogue: 0,0:17:22.59,0:17:24.09,JPDB,,0000,0000,0000,,Менің артымнан ерме
Dialogue: 0,0:17:25.15,0:17:25.74,JPDB,,0000,0000,0000,,Бірақ
Dialogue: 0,0:17:26.18,0:17:27.89,JPDB,,0000,0000,0000,,Неге менің артымнан ердің?
Dialogue: 0,0:17:28.17,0:17:29.64,JPDB,,0000,0000,0000,,Өйткені ол көзілдірік киген әдемі қыз
Dialogue: 0,0:17:30.04,0:17:31.69,JPDB,,0000,0000,0000,,Менің ағам мені қуып келеді
Dialogue: 0,0:17:32.40,0:17:32.88,JPDB,,0000,0000,0000,,Пышақ
Dialogue: 0,0:17:33.88,0:17:35.08,JPDB,,0000,0000,0000,,Мен өлмейтінмін
Dialogue: 0,0:17:33.11,0:17:36.05,JPDB,,0000,0000,0000,,Мен тек өзімді ойлаймын
Dialogue: 0,0:17:36.66,0:17:42.08,JPDB,,0000,0000,0000,,Сонымен өмір сүр
Dialogue: 0,0:17:36.97,0:17:38.50,JPDB,,0000,0000,0000,,Үлкендердің достары бар
Dialogue: 0,0:17:39.02,0:17:41.25,JPDB,,0000,0000,0000,,Мен сені менен басқаша деп ойладым.
Dialogue: 0,0:17:42.47,0:17:43.42,JPDB,,0000,0000,0000,,Аға
Dialogue: 0,0:17:44.97,0:17:45.67,JPDB,,0000,0000,0000,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:17:46.73,0:17:47.15,JPDB,,0000,0000,0000,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:17:48.00,0:17:51.01,JPDB,,0000,0000,0000,,Мен ағам туралы ештеңе түсінбедім.
Dialogue: 0,0:17:51.63,0:17:53.36,JPDB,,0000,0000,0000,,Сіздің аға буыныңыз қаншалықты қиын?
Dialogue: 0,0:17:54.13,0:17:56.25,JPDB,,0000,0000,0000,,Сіз қаншалықты қиын болдыңыз?
Dialogue: 0,0:17:56.70,0:17:57.44,JPDB,,0000,0000,0000,,Тоқтау керек
Dialogue: 0,0:17:59.77,0:18:01.81,JPDB,,0000,0000,0000,,Сонымен, I
Dialogue: 0,0:18:02.75,0:18:03.86,JPDB,,0000,0000,0000,,Өлтіре алмадым
Dialogue: 0,0:18:05.47,0:18:06.25,JPDB,,0000,0000,0000,,Мен айттым ғой.
Dialogue: 0,0:18:06.83,0:18:08.47,JPDB,,0000,0000,0000,,Акихитодан қашықтықты сақтаңыз.
Dialogue: 0,0:18:09.11,0:18:12.14,JPDB,,0000,0000,0000,,Шекараның ар жағында қуыс көлеңке бар
Dialogue: 0,0:18:12.55,0:18:13.72,JPDB,,0000,0000,0000,,Оның әлсіз екені анық.
Dialogue: 0,0:18:14.56,0:18:17.84,JPDB,,0000,0000,0000,,Сіз шекараның екінші жағын жеңу мүмкіндігін жіберіп алдыңыз.
Dialogue: 0,0:18:20.44,0:18:20.91,JPDB,,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:18:23.02,0:18:24.84,JPDB,,0000,0000,0000,,Шекараның арғы бетін жалғыз қалдырсаңыз
Dialogue: 0,0:18:25.34,0:18:27.49,JPDB,,0000,0000,0000,,Әлемді құдіретті күшімен жойыңыз
Dialogue: 0,0:18:29.19,0:18:30.63,JPDB,,0000,0000,0000,,Бұл орын алған соң, тым кеш.
Dialogue: 0,0:18:31.95,0:18:32.52,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:18:35.78,0:18:36.81,JPDB,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:18:48.23,0:18:49.59,JPDB,,0000,0000,0000,,Содан бері ойланып жүрмін.
Dialogue: 0,0:18:50.58,0:18:52.21,JPDB,,0000,0000,0000,,Жоғалғаннан пайда жоқ.
Dialogue: 0,0:18:52.97,0:18:57.95,JPDB,,0000,0000,0000,,Менің ағамды шекарадан тыс бағындырудан басқа амалым жоқ екенін айтты.
Dialogue: 0,0:18:59.82,0:19:03.34,JPDB,,0000,0000,0000,,Бірақ мен, ағам.
Dialogue: 0,0:19:04.26,0:19:05.54,JPDB,,0000,0000,0000,,Мен сені өлтіргім келмейді
Dialogue: 0,0:19:07.62,0:19:09.96,JPDB,,0000,0000,0000,,Мен сені өлтіргім келмейді.
Dialogue: 0,0:19:17.17,0:19:17.94,JPDB,,0000,0000,0000,,Тыныштық келеді
Dialogue: 0,0:19:19.37,0:19:19.83,JPDB,,0000,0000,0000,,Наги?
Dialogue: 0,0:19:20.89,0:19:22.33,JPDB,,0000,0000,0000,,Менің бір ойым бар
Dialogue: 0,0:19:23.43,0:19:24.11,JPDB,,0000,0000,0000,,Не?
Dialogue: 0,0:19:25.06,0:19:25.37,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:19:27.96,0:19:34.01,JPDB,,0000,0000,0000,,Біріншіден, біз Акито Канбараның адамдық бөлігін өшіру үшін мұздатылған әлемді орнаттық.
Dialogue: 0,0:19:34.77,0:19:38.39,JPDB,,0000,0000,0000,,Тыныштықтан әлсіреген шекарадан жер бетіне шығару
Dialogue: 0,0:19:41.33,0:19:44.18,JPDB,,0000,0000,0000,,Ал Курияма Мираи Нагиді пайдаланады
Dialogue: 0,0:19:44.67,0:19:47.88,JPDB,,0000,0000,0000,,Оған Акито Канбараны өлтірмей-ақ құтқарудың жолы бар екенін айту.
Dialogue: 0,0:19:49.75,0:19:50.51,JPDB,,0000,0000,0000,,Өлтіру
Dialogue: 0,0:19:51.47,0:19:54.07,JPDB,,0000,0000,0000,,Мираи Курияманың қазіргі психикалық жағдайын ескере отырып,
Dialogue: 0,0:19:54.62,0:19:56.05,JPDB,,0000,0000,0000,,Сіз шешім қабылдауыңыз керек
Dialogue: 0,0:19:56.96,0:20:00.43,JPDB,,0000,0000,0000,,Дегенмен, Басқа әлем қауымдастығы шекарадан тыс әрекет етеді.
Dialogue: 0,0:20:00.43,0:20:01.46,JPDB,,0000,0000,0000,,Ол міндетті түрде жұмыс істеуі керек
Dialogue: 0,0:20:02.68,0:20:06.32,JPDB,,0000,0000,0000,,Олар менен озып кетпей тұрып мен оларды міндетті түрде жеңемін.
Dialogue: 0,0:20:07.81,0:20:09.32,JPDB,,0000,0000,0000,,Электрондық поштада не жазылған
Dialogue: 0,0:20:10.11,0:20:11.13,JPDB,,0000,0000,0000,,Бұл рас, солай емес пе?
Dialogue: 0,0:20:11.79,0:20:12.17,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:20:12.58,0:20:14.86,JPDB,,0000,0000,0000,,Бұл youmu болғандықтан, бұл Нагидің әсерінен.
Dialogue: 0,0:20:15.28,0:20:17.55,JPDB,,0000,0000,0000,,Шекарадан тыс жерде де әлсіз болуы керек.
Dialogue: 0,0:20:18.41,0:20:20.45,JPDB,,0000,0000,0000,,Бүкіл қаныңызбен және тәніңізбен
Dialogue: 0,0:20:20.79,0:20:22.53,JPDB,,0000,0000,0000,,Акихитоның өмірін қимай
Dialogue: 0,0:20:23.06,0:20:27.01,JPDB,,0000,0000,0000,,Бетінде пайда болатын шекарадан тыс сүйреп апару мүмкіндігі болуы керек.
Dialogue: 0,0:20:28.74,0:20:29.44,JPDB,,0000,0000,0000,,Бірақ бұл
Dialogue: 0,0:20:30.36,0:20:33.45,JPDB,,0000,0000,0000,,Сіз туралы барлық нәрсе шекараның арғы жағына шабуыл жасайды.
Dialogue: 0,0:20:34.59,0:20:37.19,JPDB,,0000,0000,0000,,Бірақ үлкендер көмектеседі, солай емес пе?
Dialogue: 0,0:20:37.68,0:20:39.32,JPDB,,0000,0000,0000,,Сіз шешіп қойғансыз.
Dialogue: 0,0:20:41.58,0:20:41.87,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:20:44.49,0:20:45.77,JPDB,,0000,0000,0000,,Бұл Акихитоның орны.
Dialogue: 0,0:20:46.24,0:20:47.22,JPDB,,0000,0000,0000,,Мен бір күні оянамын
Dialogue: 0,0:20:47.94,0:20:50.05,JPDB,,0000,0000,0000,,Егер сіз Акихитоға шындап көмектескіңіз келсе,
Dialogue: 0,0:20:50.52,0:20:51.46,JPDB,,0000,0000,0000,,Неғұрлым тезірек болса, соғұрлым жақсы
Dialogue: 0,0:20:55.11,0:20:55.71,JPDB,,0000,0000,0000,,Курияма мырза
Dialogue: 0,0:20:57.31,0:20:59.67,JPDB,,0000,0000,0000,,Акито-кун сенің өмір сүргеніңді қалайды.
Dialogue: 0,0:21:00.49,0:21:02.51,JPDB,,0000,0000,0000,,Мені өлтіру арқылы өмір сүргеніңді қалаймын
Dialogue: 0,0:21:03.59,0:21:04.97,JPDB,,0000,0000,0000,,Мен міндетті түрде солай ойлаймын.
Dialogue: 0,0:21:06.40,0:21:07.16,JPDB,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:21:07.81,0:21:10.96,JPDB,,0000,0000,0000,,Сонда да сіз Акихитоға көмектесіп жатырсыз.
Dialogue: 0,0:21:11.73,0:21:12.12,JPDB,,0000,0000,0000,,Иә
Dialogue: 0,0:21:13.03,0:21:15.39,JPDB,,0000,0000,0000,,Мен ағам ашуланатынына сенімдімін.
Dialogue: 0,0:21:18.22,0:21:20.27,JPDB,,0000,0000,0000,,Менің мұны істегенімді естігенде
Dialogue: 0,0:21:21.05,0:21:22.42,JPDB,,0000,0000,0000,,Сіз ештеңе білмейсіз
Dialogue: 0,0:21:23.57,0:21:24.66,JPDB,,0000,0000,0000,,Сол кездегідей
Dialogue: 0,0:21:30.95,0:21:32.21,JPDB,,0000,0000,0000,,Бұл Зама Миро.
Dialogue: 0,0:21:47.35,0:21:49.48,JPDB,,0000,0000,0000,,Қар барған сайын күшейе түседі.
Dialogue: 0,0:21:50.14,0:21:52.54,JPDB,,0000,0000,0000,,Бұл шекарадан тыс орталық
Dialogue: 0,0:22:00.83,0:22:01.75,JPDB,,0000,0000,0000,,Курияма мырза
Dialogue: 0,0:23:27.42,0:23:32.04,JPDB,,0000,0000,0000,,Сенпай, туғаныма қуанамын.
Dialogue: 0,0:23:33.22,0:23:37.62,JPDB,,0000,0000,0000,,Мен осы қалаға келгеніме және үлкендермен танысқаныма өте қуаныштымын.
Dialogue: 0,0:23:39.12,0:23:45.12,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
