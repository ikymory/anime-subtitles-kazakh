Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.33,0:00:09.63,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:20.89,0:00:21.89,Default,,0,0,0,,(ломбард)
Dialogue: 0,0:00:23.06,0:00:25.06,Default,,0,0,0,,Құтқару объектілерін екі рет тексеріңіз
Dialogue: 0,0:00:25.81,0:00:27.48,Default,,0,0,0,,Хинодзава Био Фарматек
Dialogue: 0,0:00:27.69,0:00:29.48,Default,,0,0,0,,Үшінші класс үлгі контейнері
Dialogue: 0,0:00:29.77,0:00:32.03,Default,,0,0,0,,7-ші қабат бөлімі ILS
Dialogue: 0,0:00:32.61,0:00:33.74,Default,,0,0,0,,Кеттік
Dialogue: 0,0:00:46.37,0:00:47.63,Default,,0,0,0,,(дыбыстық сигнал…)
Dialogue: 0,0:00:51.13,0:00:52.17,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:53.05,0:00:53.97,Default,,0,0,0,,(Парин!)
Dialogue: 0,0:00:55.18,0:00:56.51,Default,,0,0,0,,(Шыны сынып жатқан дыбыс)
Dialogue: 0,0:01:01.89,0:01:03.89,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:01:06.44,0:01:07.98,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:01:08.15,0:01:09.77,Default,,0,0,0,,Тіпті үш минут өткен жоқ.
Dialogue: 0,0:01:10.02,0:01:10.98,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:01:15.53,0:01:16.82,Default,,0,0,0,,Керемет! Харука
Dialogue: 0,0:01:17.03,0:01:18.70,Default,,0,0,0,,Сіз қай қабатқа бұрылдыңыз?
Dialogue: 0,0:01:18.82,0:01:19.87,Default,,0,0,0,,Хинозава фармациясы
Dialogue: 0,0:01:20.03,0:01:22.87,Default,,0,0,0,,Мен Матердің көп ұнататын тағамдарын сонда қалдырдым.
Dialogue: 0,0:01:23.37,0:01:25.29,Default,,0,0,0,,Сауықтыруды тездетейік (Кэде) Вилко!
Dialogue: 0,0:01:25.41,0:01:26.29,Default,,0,0,0,,(Дон!)
Dialogue: 0,0:01:30.34,0:01:31.38,Default,,0,0,0,,Оны құтқарудың жолы бар ма?
Dialogue: 0,0:01:32.09,0:01:33.59,Default,,0,0,0,,Сіз сондасыз ба?
Dialogue: 0,0:01:33.96,0:01:35.59,Default,,0,0,0,,Сіз де осы зертханадасыз ба?
Dialogue: 0,0:01:35.80,0:01:38.09,Default,,0,0,0,,Тұтынушы белгілеген маршрут жабық.
Dialogue: 0,0:01:38.22,0:01:39.97,Default,,0,0,0,,Оның астында жаншылып қалсаң не істер едің?
Dialogue: 0,0:01:40.55,0:01:41.93,Default,,0,0,0,,Астыңғы жағына қою жаман.
Dialogue: 0,0:01:42.51,0:01:43.81,Default,,0,0,0,,Хмм, қазірдің өзінде!
Dialogue: 0,0:01:45.02,0:01:46.68,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:01:49.10,0:01:50.40,Default,,0,0,0,,Дәлелдер!
Dialogue: 0,0:01:52.57,0:01:54.03,Default,,0,0,0,,Браво екі тоғыз гамма!
Dialogue: 0,0:01:56.24,0:01:57.24,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:01:59.11,0:02:01.78,Default,,0,0,0,,Бір ақымақ мұны әдейі қойды.
Dialogue: 0,0:02:01.91,0:02:03.45,Default,,0,0,0,,Басқа сүңгуір командалары?
Dialogue: 0,0:02:03.58,0:02:05.33,Default,,0,0,0,,Бұл көп жалдамалы үй.
Dialogue: 0,0:02:08.33,0:02:09.87,Default,,0,0,0,,Иә? Ах!
Dialogue: 0,0:02:09.96,0:02:10.92,Default,,0,0,0,,Балалар!
Dialogue: 0,0:02:11.21,0:02:12.88,Default,,0,0,0,,Бұл жерде материяны қоздырған кім!
Dialogue: 0,0:02:13.04,0:02:15.09,Default,,0,0,0,,Онда болды ма? (Казуки) Сіз сонда болдыңыз!
Dialogue: 0,0:02:15.38,0:02:16.67,Default,,0,0,0,,Мен мұны білмедім.
Dialogue: 0,0:02:16.80,0:02:17.72,Default,,0,0,0,,Біріншіден, аяқтарыңыздың астындағы қорапқа қараңыздар
Dialogue: 0,0:02:18.63,0:02:19.72,Default,,0,0,0,,Сіз солсыз
Dialogue: 0,0:02:19.80,0:02:21.68,Default,,0,0,0,,Мені осы жерге әкеліңіз
Dialogue: 0,0:02:22.01,0:02:23.30,Default,,0,0,0,,Сіз айтасыз!
Dialogue: 0,0:02:24.22,0:02:25.10,Default,,0,0,0,,Эй!
Dialogue: 0,0:02:25.18,0:02:26.77,Default,,0,0,0,,Бұл аймақта қандай қатерлі ісік бар?
Dialogue: 0,0:02:26.85,0:02:28.18,Default,,0,0,0,,Браво сыныбы емес пе еді?
Dialogue: 0,0:02:28.43,0:02:29.81,Default,,0,0,0,,...болу керек!
Dialogue: 0,0:02:30.81,0:02:33.23,Default,,0,0,0,,Осыншама түсіргеннен кейін ол әлі де белсенді ме?
Dialogue: 0,0:02:33.52,0:02:35.98,Default,,0,0,0,,Қазіргі жігіттердің бір ерекшелігі бар.
Dialogue: 0,0:02:36.90,0:02:38.70,Default,,0,0,0,,Олай болса мен оларға қалдырамын.
Dialogue: 0,0:02:39.11,0:02:40.16,Default,,0,0,0,,Ей!
Dialogue: 0,0:02:41.91,0:02:44.12,Default,,0,0,0,,Сұралған нысан Қате жасамаңыз!
Dialogue: 0,0:02:44.41,0:02:45.66,Default,,0,0,0,,Оны үйге әкелу үшін аянып қал
Dialogue: 0,0:02:45.74,0:02:48.66,Default,,0,0,0,,Егер оның жанындағы үлгі болса, мен оған мән бере алмас едім.
Dialogue: 0,0:02:49.37,0:02:52.21,Default,,0,0,0,,0782 0782…
Dialogue: 0,0:02:52.63,0:02:53.46,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:02:53.96,0:02:56.92,Default,,0,0,0,,Жұлын нервінің прототипі материалы 0782
Dialogue: 0,0:02:57.42,0:03:00.13,Default,,0,0,0,,Енді мен жарты жылымды шетелде саяхаттауға жұмсай аламын.
Dialogue: 0,0:03:05.68,0:03:06.89,Default,,0,0,0,,О... Уау!
Dialogue: 0,0:03:10.06,0:03:11.44,Default,,0,0,0,,Б-бірақ… сәби аман.
Dialogue: 0,0:03:11.69,0:03:12.52,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:15.02,0:03:18.07,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:03:29.29,0:03:31.00,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:03:34.00,0:03:35.13,Default,,0,0,0,,Таңбаша
Dialogue: 0,0:03:35.29,0:03:37.59,Default,,0,0,0,,Каэде Біз осындамыз.
Dialogue: 0,0:03:38.50,0:03:39.46,Default,,0,0,0,,Ашық!
Dialogue: 0,0:03:43.76,0:03:44.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:46.14,0:03:48.97,Default,,0,0,0,,Уау! Сагами мырза, Сагами мырза!
Dialogue: 0,0:03:49.22,0:03:50.68,Default,,0,0,0,,Бет-әлпетің мен екпінің—
Dialogue: 0,0:03:50.85,0:03:52.27,Default,,0,0,0,,Әлі көп жол бар
Dialogue: 0,0:03:52.77,0:03:55.90,Default,,0,0,0,,Нағыз қол болса, жұлып кетер еді, Казуки.
Dialogue: 0,0:03:56.11,0:03:56.94,Default,,0,0,0,,Біріншіден, аяқтарыңыздың астындағы қорапқа қараңыздар
Dialogue: 0,0:03:58.82,0:04:00.53,Default,,0,0,0,,Уф хаа...
Dialogue: 0,0:04:01.61,0:04:02.45,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:09.41,0:04:10.50,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:11.83,0:04:12.66,Default,,0,0,0,,Мен саған ешқашан осы туралы сұрастырамын деп айтқан жоқпын
Dialogue: 0,0:04:13.71,0:04:15.67,Default,,0,0,0,,Ах... аа~!
Dialogue: 0,0:04:19.67,0:04:21.59,Default,,0,0,0,,Айко, жақсысың ба?
Dialogue: 0,0:04:22.13,0:04:24.01,Default,,0,0,0,,Тачибана-сан! (Б қыз) Айко-чан!
Dialogue: 0,0:04:28.97,0:04:29.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:31.10,0:04:31.93,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:32.56,0:04:34.89,Default,,0,0,0,,Тачибана-сан, жақсысың ба?
Dialogue: 0,0:04:34.98,0:04:36.02,Default,,0,0,0,,Иә
Dialogue: 0,0:04:36.85,0:04:40.48,Default,,0,0,0,,Жоқ! Қараңғы, солай емес пе, медицина қызметкері?
Dialogue: 0,0:04:40.65,0:04:42.49,Default,,0,0,0,,Бұл... Жарайды.
Dialogue: 0,0:04:46.61,0:04:48.62,Default,,0,0,0,,Мен оны сыпырып тастады деп ойладым.
Dialogue: 0,0:04:49.33,0:04:51.83,Default,,0,0,0,,Сенің зардап шекпегеніңе қуаныштымын.
Dialogue: 0,0:04:52.29,0:04:54.62,Default,,0,0,0,,Ойын кезінде қалай ұйықтайсың?
Dialogue: 0,0:04:54.75,0:04:57.00,Default,,0,0,0,,Дене шынықтыру әлі де мүмкін емес, солай емес пе?
Dialogue: 0,0:04:57.13,0:05:00.21,Default,,0,0,0,,Соңғы кездері мен ұйықтап жатқанымды байқадым.
Dialogue: 0,0:05:00.34,0:05:01.59,Default,,0,0,0,,Мен ұйықтамаймын
Dialogue: 0,0:05:01.92,0:05:03.21,Default,,0,0,0,,Мен біртүрлі түс көремін...
Dialogue: 0,0:05:03.42,0:05:04.92,Default,,0,0,0,,Түнде дұрыс ұйықтамайсыз ба?
Dialogue: 0,0:05:05.26,0:05:07.34,Default,,0,0,0,,А, жарайды, жарайды.
Dialogue: 0,0:05:07.64,0:05:08.55,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:05:09.14,0:05:10.64,Default,,0,0,0,,Нахо тым қорғаншы
Dialogue: 0,0:05:11.01,0:05:12.56,Default,,0,0,0,,жақсы болар еді.
Dialogue: 0,0:05:13.18,0:05:15.94,Default,,0,0,0,,Тезірек үйге барсам екен.
Dialogue: 0,0:05:16.81,0:05:17.65,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:18.69,0:05:20.15,Default,,0,0,0,,Иә... дұрыс.
Dialogue: 0,0:05:24.78,0:05:26.24,Default,,0,0,0,,Бүгін үйірмеге барасыз ба?
Dialogue: 0,0:05:26.36,0:05:28.95,Default,,0,0,0,,А, менде раундтар бар, сондықтан үзіліс жасаймын.
Dialogue: 0,0:05:29.07,0:05:31.08,Default,,0,0,0,,Жарайды, ертең сені қайтадан алып кетемін.
Dialogue: 0,0:05:31.20,0:05:32.20,Default,,0,0,0,,Иә
Dialogue: 0,0:05:38.37,0:05:39.38,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:05:39.46,0:05:41.00,Default,,0,0,0,,Қош келдіңіз Тачибана-сан
Dialogue: 0,0:05:51.80,0:05:53.97,Default,,0,0,0,,Ах, Айко-чан, қош келдіңіз
Dialogue: 0,0:05:54.06,0:05:55.10,Default,,0,0,0,,Мизуки-сан, мен үйдемін.
Dialogue: 0,0:05:55.52,0:05:56.77,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,0:05:56.98,0:05:59.69,Default,,0,0,0,,...
Dialogue: 0,0:05:59.98,0:06:01.36,Default,,0,0,0,,Жаңа ғана құладым.
Dialogue: 0,0:06:02.52,0:06:04.90,Default,,0,0,0,,Бірақ бұл үлкен мәселе емес еді.
Dialogue: 0,0:06:05.90,0:06:08.82,Default,,0,0,0,,Маған мектептен "жақсы" деген хабарлама келді.
Dialogue: 0,0:06:09.03,0:06:10.11,Default,,0,0,0,,Жоқ, өмірден үміт үзбе
Dialogue: 0,0:06:10.41,0:06:11.53,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:11.70,0:06:13.87,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз әлі сабаққа үйрендіңіз бе?
Dialogue: 0,0:06:14.12,0:06:15.75,Default,,0,0,0,,Иә біртіндеп
Dialogue: 0,0:06:16.12,0:06:18.04,Default,,0,0,0,,Менің де бала күнгі достарым бар.
Dialogue: 0,0:06:19.04,0:06:22.21,Default,,0,0,0,,Бірақ аурухана аумағындағы мектепке бару керек пе?
Dialogue: 0,0:06:22.29,0:06:23.46,Default,,0,0,0,,Біртүрлі сезім
Dialogue: 0,0:06:23.67,0:06:26.26,Default,,0,0,0,,Бұл жақсы мәміле емес пе? Мен таңертең көп ұйықтай аламын
Dialogue: 0,0:06:26.55,0:06:28.01,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:06:32.47,0:06:34.06,Default,,0,0,0,,(Айко ауыр тыныс алуда)
Dialogue: 0,0:06:42.36,0:06:44.77,Default,,0,0,0,,Менің бұлшықет күшім қалпына келеді.
Dialogue: 0,0:06:45.23,0:06:47.78,Default,,0,0,0,,Қайырлы кеш Исацу мырза.
Dialogue: 0,0:06:48.03,0:06:50.66,Default,,0,0,0,,Жақында дұрыс жүре аласыз.
Dialogue: 0,0:06:51.03,0:06:53.28,Default,,0,0,0,,Нервтердің шамалы зақымдануы болды.
Dialogue: 0,0:06:53.45,0:06:56.24,Default,,0,0,0,,Үйренгенше біртүрлі сезінуі мүмкін, бірақ
Dialogue: 0,0:06:56.70,0:06:58.66,Default,,0,0,0,,Сізде қиындық бар ма?
Dialogue: 0,0:07:00.50,0:07:01.37,Default,,0,0,0,,Иә
Dialogue: 0,0:07:01.54,0:07:03.42,Default,,0,0,0,,Сіз маған кез келген нәрсені айта аласыз.
Dialogue: 0,0:07:03.96,0:07:05.38,Default,,0,0,0,,Енді біз
Dialogue: 0,0:07:05.55,0:07:08.05,Default,,0,0,0,,Мен сенің ата-анаңның орнындамын.
Dialogue: 0,0:07:10.01,0:07:11.47,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:37.33,0:07:38.79,Default,,0,0,0,,Кешігіп қалғаныңыз өкінішті!
Dialogue: 0,0:07:38.87,0:07:40.71,Default,,0,0,0,,Мен тағы біртүрлі түс көрдім.
Dialogue: 0,0:07:40.79,0:07:42.37,Default,,0,0,0,,Сен сондай бейқамсың!
Dialogue: 0,0:07:49.30,0:07:50.13,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,0:07:50.42,0:07:51.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:52.72,0:07:53.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:54.01,0:07:54.97,Default,,0,0,0,,Айко!
Dialogue: 0,0:07:56.35,0:07:57.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:57.31,0:07:58.18,Default,,0,0,0,,Ах...!
Dialogue: 0,0:08:03.56,0:08:05.02,Default,,0,0,0,,Айко! Ха!
Dialogue: 0,0:08:05.44,0:08:07.36,Default,,0,0,0,,Амансың ба? Айко, жараланып қалдың ба?
Dialogue: 0,0:08:08.15,0:08:09.23,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,0:08:10.44,0:08:12.24,Default,,0,0,0,,Эмма! Рэй!
Dialogue: 0,0:08:12.78,0:08:15.11,Default,,0,0,0,,Тезірек, мен сабаққа кешігіп қаламын.
Dialogue: 0,0:08:17.70,0:08:18.74,Default,,0,0,0,,Айко?
Dialogue: 0,0:08:22.50,0:08:23.79,Default,,0,0,0,,Қарашы, Айко!
Dialogue: 0,0:08:23.87,0:08:24.96,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:08:29.59,0:08:31.96,Default,,0,0,0,,бастайық
Dialogue: 0,0:08:32.97,0:08:35.43,Default,,0,0,0,,Жарайды, уақытында келдің.
Dialogue: 0,0:08:35.64,0:08:39.39,Default,,0,0,0,,Бірақ бұл не болды? Ол мен бұрын көрмеген бала еді
Dialogue: 0,0:08:40.89,0:08:41.81,Default,,0,0,0,,Айко?
Dialogue: 0,0:08:43.77,0:08:44.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:45.27,0:08:47.10,Default,,0,0,0,,Не болды? иә?
Dialogue: 0,0:08:47.40,0:08:49.11,Default,,0,0,0,,Сіз бұрыннан таныссыз ба?
Dialogue: 0,0:08:49.32,0:08:50.27,Default,,0,0,0,,Тағдырлы кездесу?
Dialogue: 0,0:08:50.78,0:08:52.49,Default,,0,0,0,,Бұл шындық болуы мүмкін емес.
Dialogue: 0,0:08:52.74,0:08:55.15,Default,,0,0,0,,Иә, барлығымыз, үлкен жаңалық!
Dialogue: 0,0:08:55.49,0:08:58.24,Default,,0,0,0,,Осы уақытта, ертеңгі жабылу салтанатымен
Dialogue: 0,0:08:58.37,0:09:00.87,Default,,0,0,0,,Ауыстыру студенті келді.
Dialogue: 0,0:09:01.20,0:09:04.37,Default,,0,0,0,,Келіңіздер, күш-қуатқа толы болайық!
Dialogue: 0,0:09:06.37,0:09:07.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:08.33,0:09:09.21,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:09:10.34,0:09:12.30,Default,,0,0,0,,Бұл қай қыздың мангасы?
Dialogue: 0,0:09:12.55,0:09:14.47,Default,,0,0,0,,Бұл не... Иә?
Dialogue: 0,0:09:15.76,0:09:16.72,Default,,0,0,0,,Не!
Dialogue: 0,0:09:22.68,0:09:24.81,Default,,0,0,0,,Айко тұрып
Dialogue: 0,0:09:24.89,0:09:25.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:26.69,0:09:27.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:28.73,0:09:30.57,Default,,0,0,0,,Маған айта аласыз ба?
Dialogue: 0,0:09:30.86,0:09:31.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:39.07,0:09:41.12,Default,,0,0,0,,...
Dialogue: 0,0:09:41.41,0:09:43.79,Default,,0,0,0,,Ей, сендер бір-біріңді білесіңдер ме?
Dialogue: 0,0:09:43.87,0:09:44.91,Default,,0,0,0,,Қандай қатынас?
Dialogue: 0,0:09:45.00,0:09:45.96,Default,,0,0,0,,Тағдырлы кездесу?
Dialogue: 0,0:09:46.50,0:09:47.58,Default,,0,0,0,,Міне...
Dialogue: 0,0:09:47.79,0:09:49.46,Default,,0,0,0,,Мен сені төменде кездестірдім!
Dialogue: 0,0:09:50.04,0:09:52.38,Default,,0,0,0,,...
Dialogue: 0,0:09:53.30,0:09:55.55,Default,,0,0,0,,Тестілеу ертең Кирю ауруханасында басталады
Dialogue: 0,0:09:55.76,0:09:57.13,Default,,0,0,0,,Мен көремін. (5-қыз) Жарақат алдыңыз ба?
Dialogue: 0,0:09:57.26,0:09:58.43,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:09:58.51,0:10:00.05,Default,,0,0,0,,Бұл топ жарылған.
Dialogue: 0,0:10:08.98,0:10:10.77,Default,,0,0,0,,Сіз не істеп жатырсыз? студентті ауыстыру
Dialogue: 0,0:10:11.36,0:10:13.15,Default,,0,0,0,,Бұл туралы не деуге болады? (Нахо) Клуб қызметі
Dialogue: 0,0:10:13.32,0:10:14.98,Default,,0,0,0,,Мен Охашиге барамын
Dialogue: 0,0:10:15.57,0:10:17.19,Default,,0,0,0,,Қағаздан жасалған ұшақтарды зерттеу бөлімі
Dialogue: 0,0:10:17.32,0:10:19.11,Default,,0,0,0,,Қағаздан жасалған ұшақтарды зерттеу бөлімі?
Dialogue: 0,0:10:20.99,0:10:23.12,Default,,0,0,0,,Эй, ұшады.
Dialogue: 0,0:10:23.95,0:10:24.87,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:10:28.21,0:10:30.75,Default,,0,0,0,,Хмм, жарайсың.
Dialogue: 0,0:10:31.04,0:10:32.92,Default,,0,0,0,,Қағаз ұшақтар Сізді қызықтырады ма?
Dialogue: 0,0:10:33.17,0:10:35.09,Default,,0,0,0,,Ондай жағдайда сіз бірден клубқа қосылуыңыз керек...
Dialogue: 0,0:10:35.17,0:10:36.63,Default,,0,0,0,,Шимада! Келесі!
Dialogue: 0,0:10:36.84,0:10:38.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:42.22,0:10:43.35,Default,,0,0,0,,Не? Эй
Dialogue: 0,0:10:43.97,0:10:47.35,Default,,0,0,0,,Жарайды, мен оны жай ғана орнаттым...
Dialogue: 0,0:10:48.18,0:10:50.31,Default,,0,0,0,,Сіз де ауруханадан келе жатырсыз ба?
Dialogue: 0,0:10:50.44,0:10:51.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:51.69,0:10:52.94,Default,,0,0,0,,Тіпті тексеру
Dialogue: 0,0:10:53.73,0:10:54.73,Default,,0,0,0,,О
Dialogue: 0,0:10:56.78,0:10:57.61,Default,,0,0,0,,Жарылыс?
Dialogue: 0,0:11:01.24,0:11:02.78,Default,,0,0,0,,Мені атыммен атап тұрсың ба?
Dialogue: 0,0:11:04.49,0:11:08.04,Default,,0,0,0,,Мұндай нәзік заттарды ашық ауада ұшпаңыз.
Dialogue: 0,0:11:08.79,0:11:12.21,Default,,0,0,0,,Оның ішіне чип орнатылған, сондықтан оны бақылауға болады.
Dialogue: 0,0:11:12.63,0:11:14.92,Default,,0,0,0,,Сізге ұнады ма? қағаз ұшақ
Dialogue: 0,0:11:15.13,0:11:19.09,Default,,0,0,0,,Негізі бұл оригами клубы болуы керек еді.
Dialogue: 0,0:11:19.22,0:11:20.42,Default,,0,0,0,,Оригами?
Dialogue: 0,0:11:20.67,0:11:23.97,Default,,0,0,0,,Ауруханаға түскенде мен реабилитацияға кірістім.
Dialogue: 0,0:11:24.14,0:11:26.56,Default,,0,0,0,,Сондықтан мен бұл бөлімге қосылдым.
Dialogue: 0,0:11:26.85,0:11:29.60,Default,,0,0,0,,Мен білмей тұрып, қағаз ұшақтар ұшып жатты.
Dialogue: 0,0:11:30.85,0:11:32.44,Default,,0,0,0,,Жарайсыңдар! Тачибана!
Dialogue: 0,0:11:33.31,0:11:34.69,Default,,0,0,0,,Иә
Dialogue: 0,0:11:37.53,0:11:38.69,Default,,0,0,0,,Алысқа ұшсаң
Dialogue: 0,0:11:39.19,0:11:40.86,Default,,0,0,0,,Жүр! Айко
Dialogue: 0,0:11:42.66,0:11:43.61,Default,,0,0,0,,Бұл жақсы сезінеді!
Dialogue: 0,0:11:44.99,0:11:46.41,Default,,0,0,0,,Алыста...
Dialogue: 0,0:11:48.33,0:11:50.96,Default,,0,0,0,,Шекара аймағына дейін... әлде бір нәрсе ме?
Dialogue: 0,0:11:51.21,0:11:52.25,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:52.33,0:11:56.00,Default,,0,0,0,,Оның үстіне мұнша алысқа барсаң, ала алмайсың.
Dialogue: 0,0:11:57.55,0:11:59.76,Default,,0,0,0,,Канзаки-кун... солай ма?
Dialogue: 0,0:12:00.26,0:12:01.42,Default,,0,0,0,,Осы қаланың адамдары?
Dialogue: 0,0:12:01.55,0:12:02.55,Default,,0,0,0,,О
Dialogue: 0,0:12:03.18,0:12:04.30,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:04.89,0:12:08.26,Default,,0,0,0,,Сіз сол күннен бастап мүлде өзгердіңіз.
Dialogue: 0,0:12:08.93,0:12:11.93,Default,,0,0,0,,Қала және тау пейзаждары
Dialogue: 0,0:12:12.44,0:12:14.90,Default,,0,0,0,,Көптеген әртүрлі заттар
Dialogue: 0,0:12:16.98,0:12:18.40,Default,,0,0,0,,Қара жәшік?
Dialogue: 0,0:12:18.52,0:12:19.86,Default,,0,0,0,,Кейбіреулері толығымен
Dialogue: 0,0:12:20.48,0:12:22.40,Default,,0,0,0,,AICO жобасы
Dialogue: 0,0:12:22.49,0:12:25.82,Default,,0,0,0,,Юра тіпті топ құрмады және өз бетімен жүрді.
Dialogue: 0,0:12:26.37,0:12:27.58,Default,,0,0,0,,Куросе ше?
Dialogue: 0,0:12:27.78,0:12:30.41,Default,,0,0,0,,Тіпті ол егжей-тегжейлі білмейді.
Dialogue: 0,0:12:30.70,0:12:34.37,Default,,0,0,0,,Нәтижелерді қорытындыламай жатып, Юра қайтыс болды.
Dialogue: 0,0:12:35.00,0:12:37.84,Default,,0,0,0,,Сонымен, сен тек сол Юра дәптеріне сүйенсең болды ма?
Dialogue: 0,0:12:38.17,0:12:42.05,Default,,0,0,0,,Біріншіден, мен мұндай нәрсенің шынымен бар-жоғын білмеймін.
Dialogue: 0,0:12:42.17,0:12:43.76,Default,,0,0,0,,Ах
Dialogue: 0,0:12:44.26,0:12:45.26,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:12:45.68,0:12:47.64,Default,,0,0,0,,Сұрақтарыңыз болса, маған қайта хабарласыңыз.
Dialogue: 0,0:12:47.93,0:12:49.05,Default,,0,0,0,,Секір!!
Dialogue: 0,0:12:49.68,0:12:51.14,Default,,0,0,0,,Сіз Нанбара ханымсыз ба?
Dialogue: 0,0:12:51.52,0:12:52.43,Default,,0,0,0,,Сіздің талапыңыз қандай?
Dialogue: 0,0:12:52.77,0:12:54.06,Default,,0,0,0,,Иә
Dialogue: 0,0:12:54.27,0:12:57.06,Default,,0,0,0,,Мектеп туралы не білгің келеді?
Dialogue: 0,0:12:57.44,0:12:59.94,Default,,0,0,0,,Мен аурухана жақтанмын.
Dialogue: 0,0:13:00.23,0:13:01.94,Default,,0,0,0,,Мен ойладым
Dialogue: 0,0:13:02.57,0:13:04.99,Default,,0,0,0,,Осы жолы мектебіме ауысқан ер оқушыға қатысты.
Dialogue: 0,0:13:05.45,0:13:07.11,Default,,0,0,0,,Менде бірнеше алаңдаушылық бар...
Dialogue: 0,0:13:07.28,0:13:08.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:12.24,0:13:14.25,Default,,0,0,0,,Қайырлы таң Айко-чан
Dialogue: 0,0:13:14.96,0:13:16.54,Default,,0,0,0,,Жазғы демалыс ертең басталады.
Dialogue: 0,0:13:16.83,0:13:17.83,Default,,0,0,0,,Иә
Dialogue: 0,0:13:18.08,0:13:18.96,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:13:19.08,0:13:21.59,Default,,0,0,0,,Енді мен өз бетіммен тұра аламын
Dialogue: 0,0:13:21.75,0:13:25.34,Default,,0,0,0,,Неге бір рет үйге бармайсың, өзіңе қажетті жеке заттарыңды аласың?
Dialogue: 0,0:13:25.67,0:13:26.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:31.01,0:13:34.06,Default,,0,0,0,,Менің жүрегімде ол әлі де бар
Dialogue: 0,0:13:34.27,0:13:37.31,Default,,0,0,0,,Әкем, шешем және інім қайтыс болды.
Dialogue: 0,0:13:37.85,0:13:39.69,Default,,0,0,0,,Мен сене алар емеспін
Dialogue: 0,0:13:40.77,0:13:44.07,Default,,0,0,0,,Мүмкін ол әлі бір жерде тірі шығар.
Dialogue: 0,0:13:44.69,0:13:45.57,Default,,0,0,0,,Мен аш емеспін. Хүү…
Dialogue: 0,0:13:45.95,0:13:50.37,Default,,0,0,0,,Үйге келсем бос үйді көрдім.
Dialogue: 0,0:13:50.82,0:13:54.08,Default,,0,0,0,,Менің ойымша, бұл рас.
Dialogue: 0,0:13:55.08,0:13:59.29,Default,,0,0,0,,Қазір мойындаудан басқа амалым қалмайтынына сенімдімін.
Dialogue: 0,0:14:00.38,0:14:03.38,Default,,0,0,0,,Жүрегімде, Тірі болғандардың бәріне
Dialogue: 0,0:14:03.71,0:14:05.42,Default,,0,0,0,,Жоғалып кетеді деп ойладым.
Dialogue: 0,0:14:07.51,0:14:08.93,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:14:10.01,0:14:11.18,Default,,0,0,0,,Канзаки-кун
Dialogue: 0,0:14:12.39,0:14:14.97,Default,,0,0,0,,Егер мен сенің отбасың болсам
Dialogue: 0,0:14:16.06,0:14:19.56,Default,,0,0,0,,Үйге бара алмай мұңайып тұрған шығарсың.
Dialogue: 0,0:14:21.48,0:14:22.61,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:14:25.15,0:14:26.65,Default,,0,0,0,,Менің де отбасым болды.
Dialogue: 0,0:14:27.15,0:14:28.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:33.58,0:14:34.70,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:14:36.91,0:14:38.37,Default,,0,0,0,,Мен сенімен бірге барамын.
Dialogue: 0,0:14:38.46,0:14:40.92,Default,,0,0,0,,Сізде әкелгіңіз келетін жүк көп, солай ма?
Dialogue: 0,0:14:41.71,0:14:44.25,Default,,0,0,0,,Маған да көмектесіңізші, Канзаки-кун.
Dialogue: 0,0:14:44.80,0:14:46.34,Default,,0,0,0,,Ой, ой, екеуің шынымен тамаша жұп екенсіңдер.
Dialogue: 0,0:15:17.37,0:15:19.25,Default,,0,0,0,,Дайын болғанда маған хабарлаңыз
Dialogue: 0,0:15:19.58,0:15:20.54,Default,,0,0,0,,Иә
Dialogue: 0,0:16:24.60,0:16:26.61,Default,,0,0,0,,Бұрынғы мектеп...
Dialogue: 0,0:16:32.65,0:16:34.45,Default,,0,0,0,,Тағы біраз күтіңіз.
Dialogue: 0,0:16:35.11,0:16:36.12,Default,,0,0,0,,Иә
Dialogue: 0,0:16:37.70,0:16:40.74,Default,,0,0,0,,Біраз уақыттан бері іске қосылмаған екі көлік бар.
Dialogue: 0,0:16:45.87,0:16:49.71,Default,,0,0,0,,Әкеңнің бөлмесін көрмегелі қанша жыл болды?
Dialogue: 0,0:16:53.88,0:16:54.72,Default,,0,0,0,,Ах
Dialogue: 0,0:17:06.94,0:17:07.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:13.69,0:17:16.57,Default,,0,0,0,,Әкемнің позасы ақсап тұр
Dialogue: 0,0:17:16.78,0:17:17.99,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:17:20.12,0:17:23.04,Default,,0,0,0,,Маған қызық, біз неге көбірек бірге болдық?
Dialogue: 0,0:17:24.16,0:17:27.46,Default,,0,0,0,,Қызық, неге көп сөйлемедіңіз?
Dialogue: 0,0:17:28.50,0:17:31.09,Default,,0,0,0,,Неліктен көбірек… толығырақ…
Dialogue: 0,0:17:32.09,0:17:33.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:35.05,0:17:36.43,Default,,0,0,0,,(Con… CoroCoro)
Dialogue: 0,0:17:41.06,0:17:41.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:50.73,0:17:52.78,Default,,0,0,0,,Ағам да еріктілер қатарына қосылуға қатты ынталанды,
Dialogue: 0,0:17:54.40,0:17:55.78,Default,,0,0,0,,Сыйлық па?
Dialogue: 0,0:17:57.74,0:18:01.03,Default,,0,0,0,,Әкеңіздің жаңа өнімінің үлгісі.
Dialogue: 0,0:18:03.37,0:18:05.79,Default,,0,0,0,,Айко мен саған ұнайды деп ойладым.
Dialogue: 0,0:18:08.42,0:18:10.75,Default,,0,0,0,,Бұл не? (Соқтығыс дыбысы)
Dialogue: 0,0:18:11.75,0:18:13.13,Default,,0,0,0,,Бұл қиын!
Dialogue: 0,0:18:15.88,0:18:18.76,Default,,0,0,0,,Мен қараймын. Айко, осында қал.
Dialogue: 0,0:18:19.01,0:18:19.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:21.18,0:18:22.01,Default,,0,0,0,,Айко!
Dialogue: 0,0:18:22.14,0:18:23.26,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:18:23.51,0:18:24.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:26.56,0:18:28.81,Default,,0,0,0,,Уақыт таусылып бара жатқан сияқты.
Dialogue: 0,0:18:29.27,0:18:30.19,Default,,0,0,0,,А…?
Dialogue: 0,0:18:30.73,0:18:33.07,Default,,0,0,0,,Менімен жүр, жарай ма?
Dialogue: 0,0:18:33.32,0:18:34.40,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:18:35.78,0:18:36.61,Default,,0,0,0,,Аспанда не болып жатыр?
Dialogue: 0,0:18:36.94,0:18:38.03,Default,,0,0,0,,Жарылыс…
Dialogue: 0,0:18:40.24,0:18:42.78,Default,,0,0,0,,Бұл апатты не тоқтатуға болады?
Dialogue: 0,0:18:43.74,0:18:45.16,Default,,0,0,0,,Менде жалғыз сенсің
Dialogue: 0,0:18:45.58,0:18:47.33,Default,,0,0,0,,Әкелген тамақ пен суды мүмкіндігінше ұзаққа созайық.
Dialogue: 0,0:18:47.41,0:18:49.46,Default,,0,0,0,,Жолға түскен адамдар пайда болады
Dialogue: 0,0:18:50.04,0:18:51.50,Default,,0,0,0,,Кеттік, иә?
Dialogue: 0,0:18:51.67,0:18:54.09,Default,,0,0,0,,Эй, эй! Иә?
Dialogue: 0,0:18:54.71,0:18:55.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:55.80,0:18:58.38,Default,,0,0,0,,Студентті ауыстыру~! Қайда бардың?
Dialogue: 0,0:18:59.26,0:19:01.14,Default,,0,0,0,,Ол жоғалып кетті ме? (Қосаха) Кеттік!
Dialogue: 0,0:19:01.68,0:19:03.39,Default,,0,0,0,,Эй, не?
Dialogue: 0,0:19:04.10,0:19:05.26,Default,,0,0,0,,Не? Апыр-ай!
Dialogue: 0,0:19:05.64,0:19:08.89,Default,,0,0,0,,Тачибана-сан, жүгің осында ма?
Dialogue: 0,0:19:14.23,0:19:16.19,Default,,0,0,0,,Әй, не дейсің... (Юя) Қауіпсіздік белдігі!
Dialogue: 0,0:19:16.69,0:19:17.99,Default,,0,0,0,,Не? Апыр-ай!
Dialogue: 0,0:19:21.74,0:19:23.32,Default,,0,0,0,,(Косей) Аа, дұрыс. Шыны мен ауыстыратын киім—
Dialogue: 0,0:19:29.50,0:19:30.62,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:19:32.67,0:19:33.79,Default,,0,0,0,,Не?
Dialogue: 0,0:19:34.25,0:19:35.92,Default,,0,0,0,,Өмірлік маңызды мониторды өшірді
Dialogue: 0,0:19:36.25,0:19:37.80,Default,,0,0,0,,Егер сіз оны қоссаңыз, сізді орналасқан жеріңізден қуып жібереді.
Dialogue: 0,0:19:46.68,0:19:50.35,Default,,0,0,0,,Мақсат... Юя Канзаки Айко Тачибанамен бірге қашып кетеді.
Dialogue: 0,0:19:50.52,0:19:51.73,Default,,0,0,0,,Қазіргі уақытта бақылауда!
Dialogue: 0,0:20:01.28,0:20:03.78,Default,,0,0,0,,Нашар! Қарсы шаралар туралы штаб!
Dialogue: 0,0:20:14.67,0:20:16.00,Default,,0,0,0,,Не? Қала?
Dialogue: 0,0:20:16.59,0:20:18.25,Default,,0,0,0,,Неліктен біз оларды ішке кіргіздік...
Dialogue: 0,0:20:20.88,0:20:22.97,Default,,0,0,0,,Не? (Қосаба) Тым терең қума.
Dialogue: 0,0:20:27.43,0:20:29.51,Default,,0,0,0,,Егер итеріп өтсеңіз, бұл жағы сынып қалады.
Dialogue: 0,0:20:29.64,0:20:30.47,Default,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:20:53.66,0:20:54.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:06.18,0:21:07.47,Default,,0,0,0,,«бір жылдық төтенше көмек заттарын қамтамасыз етеді»
Dialogue: 0,0:21:08.60,0:21:10.89,Default,,0,0,0,,(баспалдақпен көтерілу)
Dialogue: 0,0:21:17.73,0:21:18.81,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:21:19.90,0:21:22.32,Default,,0,0,0,,Эй, сен неге мұндасың?
Dialogue: 0,0:21:25.45,0:21:26.82,Default,,0,0,0,,Онымен сөйлесуім керек пе?
Dialogue: 0,0:21:26.99,0:21:27.95,Default,,0,0,0,,Өміріңде —
Dialogue: 0,0:21:28.24,0:21:29.24,Default,,0,0,0,,Хмм…
Dialogue: 0,0:21:30.28,0:21:31.83,Default,,0,0,0,,Не деген сұмдық!
Dialogue: 0,0:21:32.04,0:21:34.16,Default,,0,0,0,,Сабырланып тыңдауларыңызды қалаймын.
Dialogue: 0,0:21:35.29,0:21:39.75,Default,,0,0,0,,Сіздің денеңіз нақты нәрсеге ұқсайтын етіп жасалған.
Dialogue: 0,0:21:40.67,0:21:41.75,Default,,0,0,0,,Бұл жалған
Dialogue: 0,0:21:43.21,0:21:45.42,Default,,0,0,0,,Не... айтасыз ба?
Dialogue: 0,0:21:45.84,0:21:48.93,Default,,0,0,0,,Біз сіздің шынайы денеңізді қайтарамыз
Dialogue: 0,0:21:49.22,0:21:53.18,Default,,0,0,0,,Айырбастап, мен жалған дене алғым келеді.
Dialogue: 0,0:21:53.64,0:21:57.81,Default,,0,0,0,,Жаруды сол денемен аяқтаймыз
Dialogue: 0,0:21:58.35,0:21:59.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:59.56,0:22:02.19,Default,,0,0,0,,Сіз нені айтасыз? Сен не туралы айтып тұрсың?
Dialogue: 0,0:22:02.73,0:22:04.15,Default,,0,0,0,,Балалар сендер кімсіңдер?
Dialogue: 0,0:22:04.40,0:22:07.03,Default,,0,0,0,,Менің денем жалған деген нені білдіреді?
Dialogue: 0,0:22:12.91,0:22:14.24,Default,,0,0,0,,Тек шыдамды болыңыз
Dialogue: 0,0:22:15.08,0:22:16.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:22.09,0:22:23.21,Default,,0,0,0,,(Айко айғайлайды)
Dialogue: 0,0:22:30.89,0:22:31.89,Default,,0,0,0,,Не!
Dialogue: 0,0:22:35.22,0:22:36.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:41.19,0:22:47.19,Default,,0,0,0,,♪〜
Dialogue: 0,0:24:04.86,0:24:10.86,Default,,0,0,0,,〜♪
Dialogue: 0,0:24:12.36,0:24:18.36,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory