Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.33,0:00:09.63,Default,,0,0,0,,NETFLIX түпнұсқа сериясы
Dialogue: 0,0:00:11.13,0:00:17.14,Default,,0,0,0,,♪〜
Dialogue: 0,0:01:34.55,0:01:40.55,Default,,0,0,0,,〜♪
Dialogue: 0,0:01:42.72,0:01:44.47,Default,,0,0,0,,Бұл Янагавара лагері
Dialogue: 0,0:01:44.56,0:01:46.77,Default,,0,0,0,,Қарсы іс-қимыл агенттігінің арнайы жұмыс тобы
Dialogue: 0,0:01:46.89,0:01:49.60,Default,,0,0,0,,Бұл аймаққа кіру кезінде бастапқы нүкте ретінде пайдаланылатын нысан.
Dialogue: 0,0:01:50.56,0:01:52.90,Default,,0,0,0,,Гильотинді жапқыштың электр тогының соғуынан
Dialogue: 0,0:01:52.98,0:01:55.11,Default,,0,0,0,,Бұл жердегі материя салданған.
Dialogue: 0,0:01:55.74,0:01:57.15,Default,,0,0,0,,Біраз уақыт болса да болады.
Dialogue: 0,0:01:57.82,0:01:58.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:01.16,0:02:03.58,Default,,0,0,0,,Не? Сіз алдыңғы жақтан кіре аласыз ба?
Dialogue: 0,0:02:07.21,0:02:09.50,Default,,0,0,0,,Менің келгеніме біраз болды.
Dialogue: 0,0:02:09.58,0:02:10.75,Default,,0,0,0,,Иә.
Dialogue: 0,0:02:10.96,0:02:13.59,Default,,0,0,0,,Бұл адам кім?
Dialogue: 0,0:02:14.05,0:02:15.05,Default,,0,0,0,,Саана
Dialogue: 0,0:02:15.80,0:02:16.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:22.89,0:02:23.81,Default,,0,0,0,,(Инъекция дыбысы)
Dialogue: 0,0:02:23.89,0:02:27.27,Default,,0,0,0,,Сыртқы әлемнен оқшаулану және тұйық қан айналымы ешқандай қиындық тудырмайды.
Dialogue: 0,0:02:28.06,0:02:29.81,Default,,0,0,0,,Қанатымызды біраз созайық
Dialogue: 0,0:02:37.36,0:02:39.20,Default,,0,0,0,,Костюмді шешуге болады.
Dialogue: 0,0:02:44.20,0:02:45.41,Default,,0,0,0,,Мұнда душ бар.
Dialogue: 0,0:02:46.16,0:02:47.16,Default,,0,0,0,,Kyahoo!
Dialogue: 0,0:02:47.83,0:02:49.62,Default,,0,0,0,,Жанды костюм, өтінемін Харука!
Dialogue: 0,0:02:49.71,0:02:50.92,Default,,0,0,0,,Сәлем Каэде!
Dialogue: 0,0:02:51.21,0:02:52.54,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:02:53.38,0:02:56.17,Default,,0,0,0,,Мен тырыстым, бірақ шеше алмадым...
Dialogue: 0,0:02:56.71,0:02:59.17,Default,,0,0,0,,Сепаратор жұмыс істеп тұрса да
Dialogue: 0,0:02:59.59,0:03:02.89,Default,,0,0,0,,Сіздің теріңіз жанды костюмдермен жоғары жақындыққа ие.
Dialogue: 0,0:03:03.14,0:03:05.22,Default,,0,0,0,,Не? Солай ма?
Dialogue: 0,0:03:05.68,0:03:08.06,Default,,0,0,0,,Костюм сізге ұнап қалған сияқты.
Dialogue: 0,0:03:09.43,0:03:11.19,Default,,0,0,0,,Мұның бәрі жұмыс тапсырмалары үшін.
Dialogue: 0,0:03:11.85,0:03:14.90,Default,,0,0,0,,Осы нүктеден кейін толықтыру нүктелері жоқ.
Dialogue: 0,0:03:15.06,0:03:16.44,Default,,0,0,0,,Қалдықтардың жоқтығына көз жеткізіңіз.
Dialogue: 0,0:03:16.52,0:03:17.53,Default,,0,0,0,,Уссу (Харука) Иә
Dialogue: 0,0:03:17.94,0:03:20.11,Default,,0,0,0,,Минасе аймақтың айналасында қырағы болуды сұрайды.
Dialogue: 0,0:03:20.32,0:03:21.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:22.41,0:03:23.57,Default,,0,0,0,,Ум... (барлығы) Иә?
Dialogue: 0,0:03:24.07,0:03:25.91,Default,,0,0,0,,Мен бірге келе аламын ба?
Dialogue: 0,0:03:25.91,0:03:26.41,Default,,0,0,0,,Мен бірге келе аламын ба?
Dialogue: 0,0:03:25.91,0:03:26.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:26.91,0:03:30.04,Default,,0,0,0,,Мен аймақты дұрыстап көргім келді.
Dialogue: 0,0:03:30.37,0:03:31.96,Default,,0,0,0,,Бұл мүлдем қауіпсіз емес...
Dialogue: 0,0:03:32.04,0:03:33.12,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:03:33.79,0:03:35.46,Default,,0,0,0,,Мен сенің оққағарың боламын.
Dialogue: 0,0:03:35.96,0:03:37.00,Default,,0,0,0,,Рахмет
Dialogue: 0,0:03:37.09,0:03:37.92,Default,,0,0,0,,«қаһарман» мамандығы пайда болды
Dialogue: 0,0:03:38.00,0:03:42.34,Default,,0,0,0,,Өлшенген мәндер бойынша, енді осы маңайда қауіпсіздік қамтамасыз етілген.
Dialogue: 0,0:03:42.76,0:03:44.18,Default,,0,0,0,,Көлемді анықтау
Dialogue: 0,0:03:44.26,0:03:48.26,Default,,0,0,0,,Менің ойымша, сіз мұны негізгі нүктеге нұсқаулық ретінде жасай аласыз ба?
Dialogue: 0,0:03:49.06,0:03:50.06,Default,,0,0,0,,(Юя күрсініп)
Dialogue: 0,0:03:59.44,0:04:02.15,Default,,0,0,0,,Енді мен сені жұмысқа шақырамын.
Dialogue: 0,0:04:09.16,0:04:10.08,Default,,0,0,0,,Гуманоид?
Dialogue: 0,0:04:10.75,0:04:14.25,Default,,0,0,0,,Өткен күнгі үлкен белсендіру Материяның өзгеруіне себеп болды ма?
Dialogue: 0,0:04:14.58,0:04:17.96,Default,,0,0,0,,Әлде материяның өзгеруінің өзі үлкен белсенділіктің себебі ме?
Dialogue: 0,0:04:18.42,0:04:21.51,Default,,0,0,0,,Қандай жағдай болмасын мен сені қолымнан келгенше қолдаймын.
Dialogue: 0,0:04:21.63,0:04:22.63,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:22.72,0:04:23.55,Default,,0,0,0,,На~ни
Dialogue: 0,0:04:23.80,0:04:26.80,Default,,0,0,0,,Мен Токиоға баруды жоспарлап едім, бірақ бұл мені көп қиындықтан құтқарды.
Dialogue: 0,0:04:27.18,0:04:29.14,Default,,0,0,0,,Мен онымен біраз уақыт кездесемін.
Dialogue: 0,0:04:30.01,0:04:32.81,Default,,0,0,0,,Қалай болғанда да, мен мұны Хориге қалдырамын.
Dialogue: 0,0:04:33.43,0:04:37.19,Default,,0,0,0,,Нагатачоның айналасында қандай да бір қозғалыс болса, бір-бірден хабарлаңыз.
Dialogue: 0,0:04:37.40,0:04:38.23,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:04:41.19,0:04:43.57,Default,,0,0,0,,Біз сізді күттік, бастық Намбара.
Dialogue: 0,0:04:44.36,0:04:46.53,Default,,0,0,0,,Мен сені алып кетудің қажеті жоқ дедім...
Dialogue: 0,0:04:48.12,0:04:50.91,Default,,0,0,0,,Кешіріңіз. Сіз қазір директорсыз ба?
Dialogue: 0,0:04:51.29,0:04:52.95,Default,,0,0,0,,Ах... Куросе-кун
Dialogue: 0,0:04:54.83,0:04:56.42,Default,,0,0,0,,Мен білмедім
Dialogue: 0,0:04:56.50,0:04:59.54,Default,,0,0,0,,Барлық сүңгуірлер осындай ғажайып жұмыстарды атқаруда.
Dialogue: 0,0:04:59.63,0:05:02.71,Default,,0,0,0,,Жоқ, онша емес, Тачибана-сан.
Dialogue: 0,0:05:03.01,0:05:04.84,Default,,0,0,0,,Аа, Айко жақсы.
Dialogue: 0,0:05:04.97,0:05:06.68,Default,,0,0,0,,Онда мен де Кадзукимін.
Dialogue: 0,0:05:08.18,0:05:10.39,Default,,0,0,0,,Айко...чан?
Dialogue: 0,0:05:10.64,0:05:11.97,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,0:05:12.18,0:05:14.39,Default,,0,0,0,,Иә! Сіз мұны K1 тілінде айттыңыз, солай ма?
Dialogue: 0,0:05:15.77,0:05:16.64,Default,,0,0,0,,Отбасы үшін
Dialogue: 0,0:05:16.77,0:05:18.98,Default,,0,0,0,,Мен негізгі нүктеге өтуім керек.
Dialogue: 0,0:05:19.06,0:05:19.90,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:20.27,0:05:21.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:21.86,0:05:22.69,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:05:22.90,0:05:25.03,Default,,0,0,0,,А, жаман нәрсе...
Dialogue: 0,0:05:25.53,0:05:28.32,Default,,0,0,0,,Жоқ, кешіріңіз...
Dialogue: 0,0:05:35.83,0:05:37.79,Default,,0,0,0,,Эй, тыныш~ (Казуки) А.
Dialogue: 0,0:05:38.37,0:05:40.79,Default,,0,0,0,,Гильотинаның күші керемет.
Dialogue: 0,0:05:41.38,0:05:42.50,Default,,0,0,0,,Неге...
Dialogue: 0,0:05:42.59,0:05:45.63,Default,,0,0,0,,Мен жалғыз сені уайымдағандықтан осы жолмен келген жоқпын.
Dialogue: 0,0:05:46.38,0:05:49.43,Default,,0,0,0,,Сіз Сери-санмен бірге толықтыруға жауаптысыз, солай ма?
Dialogue: 0,0:05:50.43,0:05:53.43,Default,,0,0,0,,Өйткені, Каэде болмаса бәрі бір қалыпты жүрмейді.
Dialogue: 0,0:05:54.10,0:05:58.39,Default,,0,0,0,,Бұл жылдам болғанымен, ол әлі де мемлекеттік мекеме.
Dialogue: 0,0:05:58.56,0:06:00.15,Default,,0,0,0,,Бұл керемет қор.
Dialogue: 0,0:06:01.36,0:06:03.69,Default,,0,0,0,,Гидро да жақсы.
Dialogue: 0,0:06:04.32,0:06:07.20,Default,,0,0,0,,Мен оны тастап кетсем де, жақсы күйде болғаны менің жолым болды.
Dialogue: 0,0:06:07.32,0:06:09.45,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:06:10.62,0:06:11.87,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:06:12.53,0:06:16.16,Default,,0,0,0,,Міне, мен осындай батыл стратегия жасауды ойладым.
Dialogue: 0,0:06:16.29,0:06:17.62,Default,,0,0,0,,Юя Канзаки
Dialogue: 0,0:06:18.79,0:06:22.42,Default,,0,0,0,,Ширайши мырзаның ынтымақтастығы болмаса, бұл мүмкін емес еді.
Dialogue: 0,0:06:23.92,0:06:26.59,Default,,0,0,0,,Әдеттегідей мұрның жақсы.
Dialogue: 0,0:06:27.05,0:06:30.59,Default,,0,0,0,,Бұл жақсы. Айко Тачибана жоғалып кетті деп естимін.
Dialogue: 0,0:06:31.18,0:06:33.14,Default,,0,0,0,,Ақпарат жылдам
Dialogue: 0,0:06:33.22,0:06:35.72,Default,,0,0,0,,Сізге рахмет, мен ауруханада жоғарыдан төмен қараймын.
Dialogue: 0,0:06:36.93,0:06:37.93,Default,,0,0,0,,Сіз бірдеңе білесіз бе?
Dialogue: 0,0:06:38.31,0:06:40.52,Default,,0,0,0,,Барлық көздер (Нанбара) Иә.
Dialogue: 0,0:06:40.98,0:06:42.61,Default,,0,0,0,,Сіз туралы бірдеңе бар...
Dialogue: 0,0:06:42.73,0:06:43.69,Default,,0,0,0,,Көк!
Dialogue: 0,0:06:43.94,0:06:44.94,Default,,0,0,0,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,0:06:47.15,0:06:51.45,Default,,0,0,0,,Бұл студент кезімде тастап кеткен Йошими. Мен де ести аламын ба?
Dialogue: 0,0:06:52.91,0:06:54.28,Default,,0,0,0,,Мұнда кім келді?
Dialogue: 0,0:06:54.37,0:06:56.87,Default,,0,0,0,,Енді сіз материяның үлкен активтенуімен айналысасыз ба?
Dialogue: 0,0:06:57.62,0:06:58.45,Default,,0,0,0,,Иә
Dialogue: 0,0:06:58.54,0:07:01.21,Default,,0,0,0,,Сонда Токиодан нұсқау беруге болады, солай ма?
Dialogue: 0,0:07:02.08,0:07:04.13,Default,,0,0,0,,Бұл шын мәнінде не?
Dialogue: 0,0:07:05.00,0:07:06.13,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:07:06.30,0:07:11.05,Default,,0,0,0,,Әкесі апаттан қайтыс болды, ал анасы мен інісі жарылыстан хабарсыз кетті.
Dialogue: 0,0:07:11.80,0:07:12.76,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:07:12.93,0:07:13.76,Default,,0,0,0,,Эй!
Dialogue: 0,0:07:13.85,0:07:17.89,Default,,0,0,0,,Бірақ көмекке барғанда шынымен тірісің бе?
Dialogue: 0,0:07:18.93,0:07:20.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:20.48,0:07:22.94,Default,,0,0,0,,Ол шынымен де нәзік емес!
Dialogue: 0,0:07:23.06,0:07:24.06,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:25.52,0:07:26.73,Default,,0,0,0,,Бұл өзен...
Dialogue: 0,0:07:29.28,0:07:34.32,Default,,0,0,0,,Менің отбасым бұрын осында болған өзеннің жоғарғы ағысына жиі келетін.
Dialogue: 0,0:07:34.82,0:07:38.04,Default,,0,0,0,,Кішкентай кезімде әкем балық аулағанды ​​жақсы көретін.
Dialogue: 0,0:07:38.16,0:07:41.12,Default,,0,0,0,,Мен де отбасыммен болғанды ​​ұнататынмын.
Dialogue: 0,0:07:41.33,0:07:43.25,Default,,0,0,0,,Артыңыздан қуанып қалдым.
Dialogue: 0,0:07:43.62,0:07:48.55,Default,,0,0,0,,Бірақ мұндай нәрселер барған сайын мазалай бастады.
Dialogue: 0,0:07:49.42,0:07:53.09,Default,,0,0,0,,Ақырында әкем де жұмысқа араласты.
Dialogue: 0,0:07:53.30,0:07:55.85,Default,,0,0,0,,Менің енді үйге баратын көп нәрсем жоқ...
Dialogue: 0,0:07:56.89,0:08:00.81,Default,,0,0,0,,Бірақ ол анда-санда қайтатынын айтады.
Dialogue: 0,0:08:01.56,0:08:04.35,Default,,0,0,0,,Айко, балық аулауға барайық.
Dialogue: 0,0:08:05.19,0:08:07.40,Default,,0,0,0,,Анам мен Риота...
Dialogue: 0,0:08:07.86,0:08:11.78,Default,,0,0,0,,Бүкіл отбасымен үлкен балық аулауға барайық.
Dialogue: 0,0:08:13.78,0:08:16.32,Default,,0,0,0,,Мен мұндайды ешқашан ұстаған емеспін.
Dialogue: 0,0:08:17.41,0:08:20.20,Default,,0,0,0,,Қазір ойлап қарасам, әкем сияқты
Dialogue: 0,0:08:20.37,0:08:24.17,Default,,0,0,0,,Менің ойымша, мен отбасыма уақыт бөлуге тырыстым.
Dialogue: 0,0:08:24.92,0:08:27.00,Default,,0,0,0,,Бірақ мен ебедейсіз болғандықтан
Dialogue: 0,0:08:27.13,0:08:29.42,Default,,0,0,0,,Менің ойыма басқа ештеңе келмеді.
Dialogue: 0,0:08:33.22,0:08:37.35,Default,,0,0,0,,Сенімен бірге болғым келеді қазір кеш.
Dialogue: 0,0:08:37.93,0:08:41.81,Default,,0,0,0,,Маңызды екенін ақырында түсіну
Dialogue: 0,0:08:42.48,0:08:44.94,Default,,0,0,0,,Иә? маңызды? Отбасы?
Dialogue: 0,0:08:46.23,0:08:48.02,Default,,0,0,0,,Не айтып тұрсың! Тіпті сен...
Dialogue: 0,0:08:48.11,0:08:49.61,Default,,0,0,0,,Жоқ! Болды
Dialogue: 0,0:08:50.90,0:08:53.74,Default,,0,0,0,,Мен дүниеге келгенде әкем жоқ еді.
Dialogue: 0,0:08:53.95,0:08:58.53,Default,,0,0,0,,Мен дүниеге келгенде анам жаңа адаммен қашып кетті.
Dialogue: 0,0:08:58.82,0:09:01.91,Default,,0,0,0,,Қалғанымыз туыстарымыздың арасында өтіп жатыр.
Dialogue: 0,0:09:02.70,0:09:05.04,Default,,0,0,0,,Жалғыз қалғанда бар күшімді саламын
Dialogue: 0,0:09:05.29,0:09:06.92,Default,,0,0,0,,Бұл сіздің тарихыңыз!
Dialogue: 0,0:09:07.38,0:09:10.04,Default,,0,0,0,,Сен де қашып кеттің ғой, солай ма? отбасынан
Dialogue: 0,0:09:10.38,0:09:11.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:12.51,0:09:13.76,Default,,0,0,0,,Қаладағы әйгілі
Dialogue: 0,0:09:13.84,0:09:16.13,Default,,0,0,0,,Бір монах мені келеке ету үшін келді.
Dialogue: 0,0:09:16.22,0:09:17.39,Default,,0,0,0,,Бұл емес...
Dialogue: 0,0:09:17.51,0:09:20.81,Default,,0,0,0,,Мен... Мен өз өмірімді қалай өткізу керектігін шешкім келді.
Dialogue: 0,0:09:21.10,0:09:24.06,Default,,0,0,0,,Басқа адамдардың бақыты мен бақытсыздығымен мақтануынан шаршадым!
Dialogue: 0,0:09:24.14,0:09:26.06,Default,,0,0,0,,Бұл күлкі деп аталады.
Dialogue: 0,0:09:26.39,0:09:30.40,Default,,0,0,0,,Бұны материя жеп қойды, ал бір қолы жасанды қолмен ауыстырылды!
Dialogue: 0,0:09:30.90,0:09:33.94,Default,,0,0,0,,Өз бақытсыздығыңмен мақтанасың ба? Дасса!
Dialogue: 0,0:09:34.15,0:09:37.82,Default,,0,0,0,,Бір протездік қолды толығымен жасанды денеден тапсырыс бойынша жасауға болады.
Dialogue: 0,0:09:37.91,0:09:39.66,Default,,0,0,0,,Бұл оның монах екенін білдіреді!
Dialogue: 0,0:09:39.99,0:09:41.20,Default,,0,0,0,,Бұл жанды.
Dialogue: 0,0:09:41.91,0:09:44.20,Default,,0,0,0,,Денеңізді демалудан басқа ештеңе істемеңіз.
Dialogue: 0,0:09:44.58,0:09:46.04,Default,,0,0,0,,Сагами мырза...
Dialogue: 0,0:09:46.25,0:09:48.00,Default,,0,0,0,,Сергек болыңыз
Dialogue: 0,0:09:48.25,0:09:51.96,Default,,0,0,0,,Дәл қазір аймақта кез келген нәрсе болуы мүмкін.
Dialogue: 0,0:09:52.55,0:09:55.97,Default,,0,0,0,,Ақырында, оқиға орнына келмейінше түсінбейтін нәрселер көп.
Dialogue: 0,0:09:56.13,0:10:00.55,Default,,0,0,0,,Ал, сіз аймаққа кіре алмағандықтан, алуға болатын ақпарат шектеулі.
Dialogue: 0,0:10:01.22,0:10:03.26,Default,,0,0,0,,Неге тергеу тобын жібермеске?
Dialogue: 0,0:10:03.39,0:10:05.98,Default,,0,0,0,,Бұл аймақ қазір абсолютті құлыптаулы.
Dialogue: 0,0:10:06.06,0:10:08.48,Default,,0,0,0,,Ешкімге кіруге рұқсат етілмейді.
Dialogue: 0,0:10:09.02,0:10:11.65,Default,,0,0,0,,Қанша адам болса да... Әй.
Dialogue: 0,0:10:15.94,0:10:19.78,Default,,0,0,0,,Айко-чанға енгізілген бейтараптандырғыш зат дұрыс жұмыс істеп тұрған сияқты.
Dialogue: 0,0:10:20.41,0:10:22.53,Default,,0,0,0,,Барлығына түсінуге мүмкіндік бермеңіз.
Dialogue: 0,0:10:22.83,0:10:27.12,Default,,0,0,0,,Тірі және жасанды организмдердің құрама денелері шығаратын физиологиялық белсенді заттар
Dialogue: 0,0:10:27.20,0:10:31.00,Default,,0,0,0,,Материяны тарту сүңгуірлер қауымдастығында белгілі факт.
Dialogue: 0,0:10:31.71,0:10:33.29,Default,,0,0,0,,Айтудың қажеті жоқ
Dialogue: 0,0:10:34.05,0:10:35.63,Default,,0,0,0,,Сізден бір нәрсе сұрасам болады ма?
Dialogue: 0,0:10:36.51,0:10:40.34,Default,,0,0,0,,Материя ең алғаш неліктен жаратылған деп ойлайсың?
Dialogue: 0,0:10:41.18,0:10:44.81,Default,,0,0,0,,Айко Тачибанаға жазатайым оқиғадан кейін бөліну емі
Dialogue: 0,0:10:45.06,0:10:49.60,Default,,0,0,0,,Репликант жасанды тірі жасушалардың аномальды пролиферациясын тудырды
Dialogue: 0,0:10:50.14,0:10:52.56,Default,,0,0,0,,Дәл қазір дәл осыны айта аламын.
Dialogue: 0,0:10:52.94,0:10:54.15,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:54.23,0:10:57.11,Default,,0,0,0,,Тыйымдарды бұзғысы келетіндерге ескерту?
Dialogue: 0,0:10:57.49,0:10:59.86,Default,,0,0,0,,Ешқандай қарсы көрсетілімдер немесе ескертулер жоқ
Dialogue: 0,0:11:00.20,0:11:04.66,Default,,0,0,0,,Жасанды организмдер туралы болжамдар әлі жетілмеген.
Dialogue: 0,0:11:05.20,0:11:08.04,Default,,0,0,0,,Сіздің ойыңызша, Тошихиде Юрада мұндай жетілмегендік бар ма?\NСіз құрған басқа қызбен не істеуді жоспарлап отырсыз
Dialogue: 0,0:11:08.29,0:11:09.96,Default,,0,0,0,,Осымен
Dialogue: 0,0:11:10.25,0:11:13.92,Default,,0,0,0,,?
Dialogue: 0,0:11:14.42,0:11:16.00,Default,,0,0,0,,Тиісті жерін қайтарыңыз
Dialogue: 0,0:11:16.63,0:11:18.51,Default,,0,0,0,,Оны рұқсатсыз тууға қалдырыңыз ба?
Dialogue: 0,0:11:18.80,0:11:21.47,Default,,0,0,0,,Бұл Юраның күнәлары шынымен кешірілуі мүмкін дегенді білдіре ме?
Dialogue: 0,0:11:22.05,0:11:23.47,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:11:23.93,0:11:26.31,Default,,0,0,0,,Себеп белгісіз болса да
Dialogue: 0,0:11:26.39,0:11:29.02,Default,,0,0,0,,Болдырмау процесінің өзі қарапайым.
Dialogue: 0,0:11:29.31,0:11:30.64,Default,,0,0,0,,Шындыққа жақын модельдеу...
Dialogue: 0,0:11:30.73,0:11:32.23,Default,,0,0,0,,Анасы: Йор Форджер, жергілікті кеңсенің қызметкері
Dialogue: 0,0:11:32.90,0:11:36.19,Default,,0,0,0,,Ми мен дене адам сияқты жұмыс істейді.
Dialogue: 0,0:11:36.69,0:11:40.49,Default,,0,0,0,,Құрылған басқа қыз адам емес деп нақты айта аламыз ба?
Dialogue: 0,0:11:40.86,0:11:43.11,Default,,0,0,0,,Адам емес екені анық
Dialogue: 0,0:11:43.24,0:11:44.87,Default,,0,0,0,,Ол жай ғана...
Dialogue: 0,0:11:47.24,0:11:49.91,Default,,0,0,0,,Бипод батареясы ауыстырылды.
Dialogue: 0,0:11:50.00,0:11:51.08,Default,,0,0,0,,Дайсуке…
Dialogue: 0,0:11:51.29,0:11:55.33,Default,,0,0,0,,Біз бәріміз флакон картридждерін кейінірек осында саламыз.
Dialogue: 0,0:11:55.96,0:11:59.38,Default,,0,0,0,,Бұдан былай материяның белсенділік деңгейі тез артады.
Dialogue: 0,0:11:59.55,0:12:02.47,Default,,0,0,0,,Сонда да... барасың, солай ма?
Dialogue: 0,0:12:07.01,0:12:09.27,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:12:09.39,0:12:10.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:10.72,0:12:12.69,Default,,0,0,0,,Юя Канзаки...
Dialogue: 0,0:12:13.94,0:12:16.27,Default,,0,0,0,,Сыныптас... (Казуки) Сыныптас?
Dialogue: 0,0:12:16.61,0:12:19.44,Default,,0,0,0,,Негізі бұл туралы мен де көп білмеймін...
Dialogue: 0,0:12:19.57,0:12:20.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:20.82,0:12:25.36,Default,,0,0,0,,Мен мектепке жазғы каникулдың алдында ғана ауыстым, сонда біз алғаш рет кездестік...
Dialogue: 0,0:12:25.57,0:12:28.03,Default,,0,0,0,,Барлығына дереу жеткізілді
Dialogue: 0,0:12:28.16,0:12:30.95,Default,,0,0,0,,Мен негізгі нүктеге өтуім керек.
Dialogue: 0,0:12:31.33,0:12:34.12,Default,,0,0,0,,Эй, бұл не? Бұл өте күдікті!
Dialogue: 0,0:12:34.33,0:12:36.88,Default,,0,0,0,,Сондықтан қауіпті жерде жүрсің бе? неге?
Dialogue: 0,0:12:37.29,0:12:38.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:38.79,0:12:40.25,Default,,0,0,0,,Казуки! (Казуки) Ах...
Dialogue: 0,0:12:40.38,0:12:43.47,Default,,0,0,0,,Сүңгуірлер клиенттің мәселелерін зерттемейді
Dialogue: 0,0:12:43.59,0:12:46.76,Default,,0,0,0,,Не айтқыңыз келгенін білемін, бірақ бұл жолы тек жинақ...
Dialogue: 0,0:12:47.05,0:12:50.47,Default,,0,0,0,,Дәл солай емес пе? Клиент
Dialogue: 0,0:12:50.64,0:12:51.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:52.64,0:12:57.19,Default,,0,0,0,,Шинояма мырза менің биподымның жеке заттарын Beetle-ге апаруымды өтінді.
Dialogue: 0,0:12:57.52,0:13:01.65,Default,,0,0,0,,Сагами мырзаға оның күзетшісі бір сағаттан кейін ауыстырылатынын айтты.
Dialogue: 0,0:13:05.70,0:13:08.53,Default,,0,0,0,,Маған ескерту жібергеніңіз үшін алғыс айтқым келеді.
Dialogue: 0,0:13:08.95,0:13:12.75,Default,,0,0,0,,Бұл аймаққа енді араласпағаныңыз жөн.
Dialogue: 0,0:13:13.54,0:13:14.25,Default,,0,0,0,,(көлік есігі жабылады)
Dialogue: 0,0:13:14.58,0:13:17.71,Default,,0,0,0,,Мен мәңгі жақсы дос болғым келеді.
Dialogue: 0,0:13:18.13,0:13:19.04,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:13:30.18,0:13:32.97,Default,,0,0,0,,Ішіне қарамай бірдеңе әкелдім.
Dialogue: 0,0:13:34.60,0:13:35.85,Default,,0,0,0,,Бакка…
Dialogue: 0,0:13:37.23,0:13:38.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:38.90,0:13:41.07,Default,,0,0,0,,Ах... бұл...
Dialogue: 0,0:13:48.57,0:13:50.28,Default,,0,0,0,,Ағам да еріктілер қатарына қосылуға қатты ынталанды,
Dialogue: 0,0:13:52.41,0:13:53.99,Default,,0,0,0,,Айко-чан, мен саған көмектесе аламын ба?
Dialogue: 0,0:13:53.99,0:13:54.54,Default,,0,0,0,,Айко-чан, мен саған көмектесе аламын ба?
Dialogue: 0,0:13:53.99,0:13:54.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:54.54,0:13:54.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:54.83,0:13:55.87,Default,,0,0,0,,Ах! Сенімен бәрі жақсы ма!
Dialogue: 0,0:13:56.12,0:13:58.04,Default,,0,0,0,,Ах! (Казуки) Иә? сурет? сурет?
Dialogue: 0,0:14:00.17,0:14:01.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:01.21,0:14:02.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:02.38,0:14:03.88,Default,,0,0,0,,Уау! (Кэде) Иә? не!
Dialogue: 0,0:14:04.67,0:14:05.59,Default,,0,0,0,,Не?
Dialogue: 0,0:14:05.67,0:14:07.97,Default,,0,0,0,,Солтүстік блок қоймасында
Dialogue: 0,0:14:08.05,0:14:10.76,Default,,0,0,0,,Тіркелмеген тіршілік иесі анықталды.
Dialogue: 0,0:14:10.84,0:14:12.22,Default,,0,0,0,,Қайталау…
Dialogue: 0,0:14:13.47,0:14:15.64,Default,,0,0,0,,Не болды!
Dialogue: 0,0:14:16.60,0:14:17.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:17.43,0:14:18.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:21.19,0:14:22.40,Default,,0,0,0,,Кезек
Dialogue: 0,0:14:22.48,0:14:23.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:25.69,0:14:26.57,Default,,0,0,0,,Cui?
Dialogue: 0,0:14:27.15,0:14:28.32,Default,,0,0,0,,Холос Хабилис
Dialogue: 0,0:14:28.40,0:14:31.49,Default,,0,0,0,,Үлгілер тек кейбір тұтынушыларға таратылады.
Dialogue: 0,0:14:31.87,0:14:35.83,Default,,0,0,0,,Холос Хабилис Әкем жұмыс істеген компания...
Dialogue: 0,0:14:36.79,0:14:38.91,Default,,0,0,0,,Сонымен, бұл Айко-чандікі ме?
Dialogue: 0,0:14:39.04,0:14:42.21,Default,,0,0,0,,Бірақ мен түсіргенім сонша дөңгелек болды...
Dialogue: 0,0:14:43.04,0:14:44.30,Default,,0,0,0,,Сақтау пішімі.
Dialogue: 0,0:14:44.84,0:14:46.80,Default,,0,0,0,,Ток соғудан ояндыңыз ба?
Dialogue: 0,0:14:47.09,0:14:48.34,Default,,0,0,0,,Электр ағуы?
Dialogue: 0,0:14:48.51,0:14:49.55,Default,,0,0,0,,Әкеңізден?
Dialogue: 0,0:14:49.88,0:14:53.35,Default,,0,0,0,,Иә, туған күніне сыйлық ретінде
Dialogue: 0,0:14:53.93,0:14:57.73,Default,,0,0,0,,Бірақ... Мен оны алған соң бірден апатқа ұшырадым.
Dialogue: 0,0:14:57.98,0:15:00.73,Default,,0,0,0,,Ақырында оның не екенін білмедім...
Dialogue: 0,0:15:00.94,0:15:02.06,Default,,0,0,0,,Бүгінгі жүргізуші – сіздің көршіңіз Кай Хатарада
Dialogue: 0,0:15:02.56,0:15:04.48,Default,,0,0,0,,Сіздің атыңыз кім? иә?
Dialogue: 0,0:15:04.61,0:15:05.73,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:15:06.23,0:15:08.65,Default,,0,0,0,,Дәлірек айтсақ, бұл тірі зат болды.
Dialogue: 0,0:15:08.74,0:15:09.90,Default,,0,0,0,,Енді мен...
Dialogue: 0,0:15:10.20,0:15:12.24,Default,,0,0,0,,Бұл өте құнды.
Dialogue: 0,0:15:12.62,0:15:14.03,Default,,0,0,0,,Холус түрі…
Dialogue: 0,0:15:14.12,0:15:17.12,Default,,0,0,0,,Бір дара, тұтас жасанды организм?
Dialogue: 0,0:15:17.62,0:15:21.37,Default,,0,0,0,,Не? Бүкіл дене жасанды организм...
Dialogue: 0,0:15:22.12,0:15:24.92,Default,,0,0,0,,Жарылыс салдарынан әзірлеу тоқтатылды.
Dialogue: 0,0:15:25.50,0:15:27.71,Default,,0,0,0,,Мен мұндай прототип бар екенін білмедім ...
Dialogue: 0,0:15:30.22,0:15:31.68,Default,,0,0,0,,Менің денем қандай?
Dialogue: 0,0:15:31.97,0:15:36.60,Default,,0,0,0,,Тірі костюм осы жануармен бірдей материалдан жасалған, солай ма?
Dialogue: 0,0:15:37.10,0:15:37.93,Default,,0,0,0,,О
Dialogue: 0,0:15:38.35,0:15:42.35,Default,,0,0,0,,Өйткені бүкіл дене жасанды организмдерден тұрады
Dialogue: 0,0:15:42.81,0:15:46.44,Default,,0,0,0,,Бұл үлгі де, сіз де өте құндысыз.
Dialogue: 0,0:15:47.19,0:15:49.28,Default,,0,0,0,,Бір нәрсе сияқты сөйлеу...
Dialogue: 0,0:15:49.69,0:15:50.90,Default,,0,0,0,,Бұл бір нәрсе.
Dialogue: 0,0:15:51.20,0:15:53.32,Default,,0,0,0,,Жоқ, дәлірек айтсақ.
Dialogue: 0,0:15:53.41,0:15:56.99,Default,,0,0,0,,Бұл өмір құбылыстарын жасанды түрде жасауға арналған жүйе.
Dialogue: 0,0:15:57.33,0:15:58.83,Default,,0,0,0,,Менің айтып тұрғаным бұл емес.
Dialogue: 0,0:15:59.33,0:16:00.75,Default,,0,0,0,,Бірақ бұл шындық
Dialogue: 0,0:16:00.91,0:16:03.46,Default,,0,0,0,,Сізді қазір өмір сүріп жатқан жүйе
Dialogue: 0,0:16:03.58,0:16:05.83,Default,,0,0,0,,Бұл адамдар әрқашан иемденгісі келетін нәрсе.
Dialogue: 0,0:16:06.09,0:16:07.71,Default,,0,0,0,,Тоқта! (көк организм) белгі
Dialogue: 0,0:16:08.21,0:16:10.55,Default,,0,0,0,,Мен Канзаки-кунның түсінбейтініне сенімдімін!
Dialogue: 0,0:16:13.30,0:16:14.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:14.55,0:16:18.18,Default,,0,0,0,,Ах... Сагамиді алмастыратын кез келді.
Dialogue: 0,0:16:18.31,0:16:21.14,Default,,0,0,0,,Егер тірі костюм сақталған сияқты болса...
Dialogue: 0,0:16:28.15,0:16:29.32,Default,,0,0,0,,Солай ма...
Dialogue: 0,0:16:29.40,0:16:33.40,Default,,0,0,0,,Менен ешкім сені елес етіп көрсетуді сұраған жоқ.
Dialogue: 0,0:16:33.78,0:16:35.74,Default,,0,0,0,,Сықырлау...
Dialogue: 0,0:16:38.99,0:16:40.24,Default,,0,0,0,,Кюкюкю
Dialogue: 0,0:16:44.75,0:16:46.25,Default,,0,0,0,,Шырылдаған...
Dialogue: 0,0:16:46.67,0:16:47.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:55.22,0:16:56.55,Default,,0,0,0,,Сыйлық па?
Dialogue: 0,0:17:02.68,0:17:03.93,Default,,0,0,0,,Кирю мырзаның атынан
Dialogue: 0,0:17:04.02,0:17:06.85,Default,,0,0,0,,Егер Куросе өкіл болатын болса
Dialogue: 0,0:17:07.10,0:17:09.94,Default,,0,0,0,,Жарылыс біткенше ол осылай қалады.
Dialogue: 0,0:17:10.02,0:17:13.24,Default,,0,0,0,,2-ұяшық ассемблеріндегі зерттеулер тоқтатылады.
Dialogue: 0,0:17:14.15,0:17:14.99,Default,,0,0,0,,Тоқтаңдар, екеуің де
Dialogue: 0,0:17:15.07,0:17:18.20,Default,,0,0,0,,Біз бұл елдің экономикасының зардап шегуіне жол бере алмаймыз.
Dialogue: 0,0:17:18.82,0:17:20.87,Default,,0,0,0,,Мен де солай сезінемін.
Dialogue: 0,0:17:21.12,0:17:24.87,Default,,0,0,0,,Бұл Кирю зертханасы алға жылжуын тоқтатпауы керек.
Dialogue: 0,0:17:25.29,0:17:27.79,Default,,0,0,0,,Не... Қолдарым қысылды.
Dialogue: 0,0:17:29.08,0:17:30.84,Default,,0,0,0,,Жоқ! (Кейде) Мен оны таба алмаймын!
Dialogue: 0,0:17:30.92,0:17:32.80,Default,,0,0,0,,Неге мені жалғыз қалдырдың!
Dialogue: 0,0:17:32.92,0:17:35.67,Default,,0,0,0,,Бұл жаман! Менде бір қорғаныс костюмі жоқ!
Dialogue: 0,0:17:35.84,0:17:37.89,Default,,0,0,0,,Не? (дабыл дыбысы)
Dialogue: 0,0:17:38.05,0:17:41.93,Default,,0,0,0,,Заттың активтенуі нысанның жанында расталды.
Dialogue: 0,0:17:42.51,0:17:45.73,Default,,0,0,0,,Біз де! Мен де Дайсукеге айтуым керек!
Dialogue: 0,0:17:46.14,0:17:48.44,Default,,0,0,0,,Сәлем! қайда~?
Dialogue: 0,0:17:48.69,0:17:50.23,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:17:50.44,0:17:52.23,Default,,0,0,0,,Сықырлау... Ах...
Dialogue: 0,0:17:57.91,0:18:01.66,Default,,0,0,0,,Сәлем! Қайда бардың?
Dialogue: 0,0:18:02.58,0:18:04.37,Default,,0,0,0,,Уау! Алақай!
Dialogue: 0,0:18:07.04,0:18:09.25,Default,,0,0,0,,Бұл қайда! Тачибана!
Dialogue: 0,0:18:10.38,0:18:12.84,Default,,0,0,0,,Ауырсыну... жоқ
Dialogue: 0,0:18:13.55,0:18:14.59,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:18:14.76,0:18:20.05,Default,,0,0,0,,Мені сол балаларды жаратқан құдірет құтқарды.
Dialogue: 0,0:18:21.60,0:18:23.68,Default,,0,0,0,,Егер жоқ болса...
Dialogue: 0,0:18:28.77,0:18:30.85,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:18:35.28,0:18:36.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:37.24,0:18:40.45,Default,,0,0,0,,Жоқ, мен оны әлі таппадым. Тағы біраз ауқым...
Dialogue: 0,0:18:41.03,0:18:42.07,Default,,0,0,0,,О...
Dialogue: 0,0:18:43.70,0:18:47.37,Default,,0,0,0,,Жағдай қаншалықты қауіпсіз болса да, ешқашан жалғыз шықпау керек.
Dialogue: 0,0:18:47.45,0:18:50.04,Default,,0,0,0,,Қанша өмір сүрсек те, жетпейді.
Dialogue: 0,0:18:50.12,0:18:51.13,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:18:52.63,0:18:54.42,Default,,0,0,0,,Бірақ мен өте шешімдімін.
Dialogue: 0,0:18:55.42,0:18:57.67,Default,,0,0,0,,Тіпті сүңгуірлер де жақындағысы келмейтін жерге
Dialogue: 0,0:18:57.92,0:18:59.84,Default,,0,0,0,,Сіз бара жатырсыз
Dialogue: 0,0:19:01.72,0:19:03.30,Default,,0,0,0,,Түсіну керек.
Dialogue: 0,0:19:03.93,0:19:05.93,Default,,0,0,0,,Ол да сен сияқты
Dialogue: 0,0:19:06.01,0:19:09.39,Default,,0,0,0,,Мен үлкен бір нәрсені арқама көтеріп, алға ұмтылып жатырмын.
Dialogue: 0,0:19:11.60,0:19:13.65,Default,,0,0,0,,Ол жұмбақ адам.
Dialogue: 0,0:19:13.81,0:19:17.44,Default,,0,0,0,,Бәлкім мұны жай ғана білген дұрыс шығар.
Dialogue: 0,0:19:18.94,0:19:19.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:21.28,0:19:22.82,Default,,0,0,0,,Ах! Райчо!
Dialogue: 0,0:19:22.95,0:19:26.99,Default,,0,0,0,,Әке! Қарсы емеспін, найзағайдың суретін сал!
Dialogue: 0,0:19:27.16,0:19:29.04,Default,,0,0,0,,Әке!
Dialogue: 0,0:19:31.21,0:19:33.88,Default,,0,0,0,,Бүгін Муродода Юра Сенсеймен бірге
Dialogue: 0,0:19:34.00,0:19:37.38,Default,,0,0,0,,Әкем мен Юзуха бірге келді!
Dialogue: 0,0:19:38.51,0:19:42.72,Default,,0,0,0,,Эй Юра-сенсэй, мен жасаған түскі қорап дәмді ме?
Dialogue: 0,0:19:44.43,0:19:45.51,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:19:45.85,0:19:49.64,Default,,0,0,0,,Юзуха: Мүмкін мен Юра-сенсейдің әйелі болуым керек шығар!
Dialogue: 0,0:19:50.81,0:19:52.19,Default,,0,0,0,,Юзуха...
Dialogue: 0,0:19:52.56,0:19:53.94,Default,,0,0,0,,Сол Юра да
Dialogue: 0,0:19:54.06,0:19:56.94,Default,,0,0,0,,Мен сені оята алмадым.
Dialogue: 0,0:19:57.57,0:20:01.07,Default,,0,0,0,,Yura Notes сияқты нәрселер өтірік шығар.
Dialogue: 0,0:20:02.07,0:20:05.32,Default,,0,0,0,,Сіздің әкеңіз болуы керек...
Dialogue: 0,0:20:07.87,0:20:09.20,Default,,0,0,0,,Айко-чан!
Dialogue: 0,0:20:10.54,0:20:12.79,Default,,0,0,0,,Кешіріңіз, барлығыңыз.
Dialogue: 0,0:20:13.50,0:20:15.38,Default,,0,0,0,,Табылғаныңызға қуаныштымын.
Dialogue: 0,0:20:15.50,0:20:18.67,Default,,0,0,0,,Сақ бол, сенің өмірің жалғыз сенікі емес.
Dialogue: 0,0:20:18.75,0:20:19.80,Default,,0,0,0,,Сен менің абыройымды осы лайға батырдың!
Dialogue: 0,0:20:20.51,0:20:22.55,Default,,0,0,0,,А, Канзаки-кун?
Dialogue: 0,0:20:23.72,0:20:25.39,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,0:20:26.22,0:20:28.39,Default,,0,0,0,,Ха ха ха... Жақсы.
Dialogue: 0,0:20:29.39,0:20:31.43,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:20:32.89,0:20:35.35,Default,,0,0,0,,Кешіріңіз, мен...
Dialogue: 0,0:20:36.98,0:20:39.02,Default,,0,0,0,,Егер мен өлсем...
Dialogue: 0,0:20:39.73,0:20:43.03,Default,,0,0,0,,Мен анама және Риотаға көмектесуге бара алмаймын.
Dialogue: 0,0:20:43.99,0:20:47.78,Default,,0,0,0,,Мен осылай өмір сүріп жатқандықтан, мен барып көмектесе аламын.
Dialogue: 0,0:20:52.25,0:20:53.41,Default,,0,0,0,,Кю
Dialogue: 0,0:20:53.50,0:20:54.75,Default,,0,0,0,,Бұл маңызды, солай ма?
Dialogue: 0,0:20:56.67,0:20:57.63,Default,,0,0,0,,Кілт!
Dialogue: 0,0:20:57.92,0:20:58.75,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:02.67,0:21:03.97,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:04.51,0:21:06.22,Default,,0,0,0,,Рахмет сізге Канзаки-кун
Dialogue: 0,0:21:10.93,0:21:13.10,Default,,0,0,0,,Эй, сағыздар дұрыс мініп жүр ме?
Dialogue: 0,0:21:13.52,0:21:14.35,Default,,0,0,0,,Гумми?
Dialogue: 0,0:21:14.94,0:21:18.65,Default,,0,0,0,,Баланың аты-жөні! Өйткені ол сағыз кәмпитке ұқсайды
Dialogue: 0,0:21:19.11,0:21:20.23,Default,,0,0,0,,Дәмді көрінеді!
Dialogue: 0,0:21:20.40,0:21:21.40,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:21:21.48,0:21:23.11,Default,,0,0,0,,Иә! жақсы! (Харука) Жарайды...
Dialogue: 0,0:21:24.11,0:21:25.28,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:21:25.53,0:21:27.20,Default,,0,0,0,,Дұрыс! Cui
Dialogue: 0,0:21:29.20,0:21:30.74,Default,,0,0,0,,Шамасы, түнгі дабыл
Dialogue: 0,0:21:31.08,0:21:34.58,Default,,0,0,0,,К2 маңында материялық белсенділікті анықтаған сияқты.
Dialogue: 0,0:21:35.08,0:21:36.96,Default,,0,0,0,,Осы уақытқа дейін жеттіңіз бе?
Dialogue: 0,0:21:37.08,0:21:41.34,Default,,0,0,0,,Ол К2 қақпасының күзетшісі болуы керек. Біз бәрібір сақ болуымыз керек.
Dialogue: 0,0:21:41.96,0:21:43.55,Default,,0,0,0,,Барлығың дайынсыңдар ма?
Dialogue: 0,0:21:44.38,0:21:45.30,Default,,0,0,0,,Вилко!
Dialogue: 0,0:21:45.67,0:21:46.55,Default,,0,0,0,,Мен саған беремін!
Dialogue: 0,0:22:08.16,0:22:09.82,Default,,0,0,0,,Арнайы ескертуі бар көліктер
Dialogue: 0,0:22:10.12,0:22:14.12,Default,,0,0,0,,Біз қазір Аймото тосқауылынан өтіп, 1-аймаққа кірдік.
Dialogue: 0,0:22:14.75,0:22:17.04,Default,,0,0,0,,Түсіндім, шыдамдылығыңызға рахмет.
Dialogue: 0,0:22:24.09,0:22:27.55,Default,,0,0,0,,Бүгінгі тақырып Куросе зертханасының директоры
Dialogue: 0,0:22:27.88,0:22:29.63,Default,,0,0,0,,Доктор Сусуму Куросенің сенімін бұзу
Dialogue: 0,0:22:30.14,0:22:35.47,Default,,0,0,0,,Арнайы бюджет қаражатын ысырап ету және кәсіпкерлік қызмет барысында жымқыру туралы.
Dialogue: 0,0:22:37.18,0:22:40.27,Default,,0,0,0,,Сонымен… бастайық.
Dialogue: 0,0:22:41.23,0:22:47.24,Default,,0,0,0,,♪〜
Dialogue: 0,0:24:04.56,0:24:10.57,Default,,0,0,0,,〜♪
