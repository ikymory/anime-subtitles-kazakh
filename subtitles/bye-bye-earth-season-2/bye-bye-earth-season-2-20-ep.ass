Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.00,0:00:06.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:08.00,0:00:10.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:12.01,0:00:14.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:15.01,0:00:18.01,Default,,0,0,0,,Аа... Аа (сыбдырлаған дыбыс)
Dialogue: 0,0:00:21.02,0:00:25.02,Default,,0,0,0,,(Қоңыраудың ұйқысы)
Dialogue: 0,0:00:25.02,0:00:27.02,Default,,0,0,0,,Иә
Dialogue: 0,0:00:45.04,0:00:47.04,Default,,0,0,0,,Ах
Dialogue: 0,0:00:48.04,0:00:50.05,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:00:50.05,0:00:54.05,Default,,0,0,0,,Себебі сұралды ма?
Dialogue: 0,0:00:54.05,0:00:57.05,Default,,0,0,0,,Көгілдір... Ах
Dialogue: 0,0:01:01.06,0:01:18.07,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:18.07,0:01:22.08,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:22.08,0:01:42.10,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:42.10,0:02:02.12,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:02.12,0:02:22.14,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:22.14,0:02:31.15,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:31.15,0:02:34.15,Default,,0,0,0,,Менің есімім есіңізде ме?
Dialogue: 0,0:02:34.15,0:02:38.15,Default,,0,0,0,,Н... Ғафтың аузынан естідім.
Dialogue: 0,0:02:38.15,0:02:43.16,Default,,0,0,0,,көремін. Бұл қылышты кім жалғады?
Dialogue: 0,0:02:43.16,0:02:46.16,Default,,0,0,0,,Бұлт семсерді алған кезде.
Dialogue: 0,0:02:46.16,0:02:49.16,Default,,0,0,0,,Ол сол адамды байланыстыруды сеніп тапсырғанын айтты.
Dialogue: 0,0:02:49.16,0:02:53.17,Default,,0,0,0,,Бірден сауығып кетсе де, семсерге салынған ниеттің пішіні екеніне сенімдімін.
Dialogue: 0,0:02:53.17,0:02:56.17,Default,,0,0,0,,Менің ойымша, бұл басқа қылыштардан түбегейлі ерекшеленеді ...
Dialogue: 0,0:02:56.17,0:02:58.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:59.17,0:03:01.18,Default,,0,0,0,,Жарайсың Белл
Dialogue: 0,0:03:01.18,0:03:03.18,Default,,0,0,0,,Ах...!
Dialogue: 0,0:03:03.18,0:03:07.18,Default,,0,0,0,,Сіз Құдайды және халықты керемет түрде дәріптедіңіз.
Dialogue: 0,0:03:07.18,0:03:12.19,Default,,0,0,0,,Өзіңіздің шығу тегіңіз туралы саяхатыңыздың кілтін сұрау ғана қалды.
Dialogue: 0,0:03:12.19,0:03:16.19,Default,,0,0,0,,Білмеймін, «Дуаж» маған нені білдіреді?
Dialogue: 0,0:03:16.19,0:03:21.20,Default,,0,0,0,,Маған үйретсең, ұмытып кетіппін.
Dialogue: 0,0:03:21.20,0:03:23.20,Default,,0,0,0,,Тыңда, Белл.
Dialogue: 0,0:03:23.20,0:03:26.20,Default,,0,0,0,,Гүл ашса, бүршік жоғалады
Dialogue: 0,0:03:26.20,0:03:30.21,Default,,0,0,0,,Жемістер піскен кезде гүлдер де жойылады.
Dialogue: 0,0:03:30.21,0:03:34.21,Default,,0,0,0,,Бірақ гүлсіз жеміс өспейді.
Dialogue: 0,0:03:34.21,0:03:39.21,Default,,0,0,0,,Сондықтан гүлдер әрқашан гүлдейді, бүршіктер де қажет.
Dialogue: 0,0:03:39.21,0:03:44.22,Default,,0,0,0,,Бәрі де қайталап жүретін жол.
Dialogue: 0,0:03:44.22,0:03:49.22,Default,,0,0,0,,Өмірдің аяқталуы айға ұқсас іс-әрекеттердің шексіз ілгерілеуін білдіреді.
Dialogue: 0,0:03:49.22,0:03:52.23,Default,,0,0,0,,Мәңгілік сағынышты аңдығандай
Dialogue: 0,0:03:52.56,0:03:57.11,Default,,0,0,0,,Қылышыңдағы белгі осыны білдіреді.
Dialogue: 0,0:03:57.23,0:04:00.24,Default,,0,0,0,,Сіз мұны бұрыннан білесіз
Dialogue: 0,0:04:00.24,0:04:06.24,Default,,0,0,0,,Менің қамытымнан әлдеқашан құтылдың, ұстаз.
Dialogue: 0,0:04:09.24,0:04:12.25,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:04:12.25,0:04:14.25,Default,,0,0,0,,Сен елессің
Dialogue: 0,0:04:14.25,0:04:18.25,Default,,0,0,0,,Мен сені баяғыда өлтірдім.
Dialogue: 0,0:04:18.25,0:04:20.26,Default,,0,0,0,,Бірақ, бірақ...
Dialogue: 0,0:04:20.26,0:04:22.26,Default,,0,0,0,,Осылай кездессек те
Dialogue: 0,0:04:22.26,0:04:25.26,Default,,0,0,0,,Менің ойымша, бұл жаман емес.
Dialogue: 0,0:04:25.26,0:04:27.26,Default,,0,0,0,,Бірде мен мүлде ұмыттым
Dialogue: 0,0:04:27.26,0:04:32.27,Default,,0,0,0,,Мен бірінші рет кездескенім жақсы болар деп ойладым.
Dialogue: 0,0:04:32.27,0:04:34.27,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:35.27,0:04:37.27,Default,,0,0,0,,)
Dialogue: 0,0:04:37.27,0:04:39.27,Default,,0,0,0,,Га
Dialogue: 0,0:04:39.27,0:04:43.28,Default,,0,0,0,,Иә? Ха...
Dialogue: 0,0:04:45.28,0:04:47.28,Default,,0,0,0,,Сен менің үмітімсің
Dialogue: 0,0:04:47.28,0:04:52.29,Default,,0,0,0,,Мен сияқты жалғыздық миссиясы бар адам үшін шынайы үміт деген не?
Dialogue: 0,0:04:52.29,0:04:55.29,Default,,0,0,0,,Тіпті өз болмысымның жұмбақ ортасында
Dialogue: 0,0:04:55.29,0:04:58.29,Default,,0,0,0,,Бұл жалғыз емес екеніңізді білу туралы.
Dialogue: 0,0:04:58.29,0:05:00.30,Default,,0,0,0,,Уф…
Dialogue: 0,0:05:00.30,0:05:04.30,Default,,0,0,0,,Бір күні сіз саяхатшы да, Аштық альянсының мүшесі де болмайсыз.
Dialogue: 0,0:05:04.30,0:05:07.30,Default,,0,0,0,,Сондай-ақ, бұл екеуі де сияқты.
Dialogue: 0,0:05:07.30,0:05:12.31,Default,,0,0,0,,Осы дүниеде өз өміріңіз үшін күресетін адам болуды мақсат етіңіз.
Dialogue: 0,0:05:12.31,0:05:15.31,Default,,0,0,0,,Бұл менің тілегім
Dialogue: 0,0:05:16.31,0:05:19.31,Default,,0,0,0,,Фу…
Dialogue: 0,0:05:27.32,0:05:30.33,Default,,0,0,0,,Сапарыңызда тағы кездесейік
Dialogue: 0,0:05:30.33,0:05:32.33,Default,,0,0,0,,Оны асыға күтейік
Dialogue: 0,0:05:36.33,0:05:40.34,Default,,0,0,0,,Қош бол, Сиан
Dialogue: 0,0:05:42.34,0:05:45.34,Default,,0,0,0,,(Өлім құсының сайрауы)
Dialogue: 0,0:05:45.34,0:05:48.34,Default,,0,0,0,,Ол адам әлі сапарға шықты ма?
Dialogue: 0,0:05:48.34,0:05:51.35,Default,,0,0,0,,Иә (Беннет) Енді сіздің кезегіңіз Белл.
Dialogue: 0,0:05:51.35,0:05:54.35,Default,,0,0,0,,Рахмет, бірақ бұған дейін
Dialogue: 0,0:05:54.35,0:05:58.35,Default,,0,0,0,,Мен бір нәрсеге назар аударуым керек.
Dialogue: 0,0:05:58.35,0:06:00.36,Default,,0,0,0,,Сіз...
Dialogue: 0,0:06:00.36,0:06:02.36,Default,,0,0,0,,Сэнди Коллинз
Dialogue: 0,0:06:02.36,0:06:04.36,Default,,0,0,0,,Адонистің ағалары туралы
Dialogue: 0,0:06:04.36,0:06:06.36,Default,,0,0,0,,Қайтыс болған ата-анамның орнына
Dialogue: 0,0:06:06.36,0:06:10.37,Default,,0,0,0,,Мен арыстанның құрсағындағы бас діни қызметкерді ұстаймын.
Dialogue: 0,0:06:13.37,0:06:16.37,Default,,0,0,0,,Қашу мен сезімталдықтың қазына қылышы
Dialogue: 0,0:06:16.37,0:06:19.37,Default,,0,0,0,,Біз мұнда не көреміз?
Dialogue: 0,0:06:19.37,0:06:23.38,Default,,0,0,0,,Мұны қылышты тірілтетін сынақ сиқыры деп атауға болады.
Dialogue: 0,0:06:23.38,0:06:24.84,Default,,0,0,0,,Жұмбақ сиқыр
Dialogue: 0,0:06:25.09,0:06:28.38,Default,,0,0,0,,Не? Егер сіз мұны жасасаңыз ...
Dialogue: 0,0:06:29.38,0:06:32.39,Default,,0,0,0,,Тыныш жүрекпен қараңыздар.
Dialogue: 0,0:06:32.39,0:06:37.39,Default,,0,0,0,,Бұл біз Коллинз қорғайтын тағы бір құдай құпиясы.
Dialogue: 0,0:06:37.39,0:06:39.39,Default,,0,0,0,,Басқа Құдай?
Dialogue: 0,0:06:39.39,0:06:41.40,Default,,0,0,0,,Гиннес, сіз не жоспарлап отырсыз?
Dialogue: 0,0:06:41.40,0:06:44.40,Default,,0,0,0,,Мен де анық білмеймін.
Dialogue: 0,0:06:44.40,0:06:46.40,Default,,0,0,0,,Сіз тағы да...
Dialogue: 0,0:06:46.40,0:06:48.40,Default,,0,0,0,,бастайық
Dialogue: 0,0:06:48.40,0:06:51.41,Default,,0,0,0,,Міне, мен саған көрсеткім келді, Белл.
Dialogue: 0,0:06:51.41,0:06:53.41,Default,,0,0,0,,А...
Dialogue: 0,0:06:58.41,0:07:11.43,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:11.43,0:07:13.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:13.43,0:07:16.43,Default,,0,0,0,,Біз жұмбақты осы жерде және қазір аштық.
Dialogue: 0,0:07:16.43,0:07:19.43,Default,,0,0,0,,(Өлім құсының сайрауы)
Dialogue: 0,0:07:19.43,0:07:38.45,Default,,0,0,0,,♪♪～
Dialogue: 0,0:07:38.45,0:07:41.46,Default,,0,0,0,,Соңында 300-ден астам оқ аттым
Dialogue: 0,0:07:41.46,0:07:43.46,Default,,0,0,0,,Не бар?
Dialogue: 0,0:07:43.46,0:07:45.46,Default,,0,0,0,,Бар нәрсенің аты
Dialogue: 0,0:07:45.88,0:07:48.46,Default,,0,0,0,,Бұл атау механикалық құдайға қатысты.
Dialogue: 0,0:07:48.46,0:07:52.47,Default,,0,0,0,,Біздің өмір сүруіміздің себебі туралы ойымызды қамтиды.
Dialogue: 0,0:07:52.47,0:07:56.47,Default,,0,0,0,,Дене болмаса, ақыл ғана
Dialogue: 0,0:07:56.47,0:08:00.48,Default,,0,0,0,,Алайда халықты билеуші құдай болу үшін,
Dialogue: 0,0:08:00.48,0:08:03.48,Default,,0,0,0,,Өзіңіздің кім екеніңізбен өсу
Dialogue: 0,0:08:03.48,0:08:06.48,Default,,0,0,0,,Менің өзім тыйым салудан басқа амалым қалмады.
Dialogue: 0,0:08:06.48,0:08:09.48,Default,,0,0,0,,Құдайдың механикалық ойлары
Dialogue: 0,0:08:09.48,0:08:12.49,Default,,0,0,0,,《Машина құдайы үшін өлім жоқ》
Dialogue: 0,0:08:12.49,0:08:14.49,Default,,0,0,0,,《Тіршілік бітеді
Dialogue: 0,0:08:14.49,0:08:17.49,Default,,0,0,0,,Әу бастан ешқашан болмаған сияқты
Dialogue: 0,0:08:17.49,0:08:19.49,Default,,0,0,0,,Жоғалып кетуден басқа амал жоқ》
Dialogue: 0,0:08:19.49,0:08:23.50,Default,,0,0,0,,Шындықты іздеуде бөтеннің денесіне ие болу
Dialogue: 0,0:08:23.50,0:08:26.50,Default,,0,0,0,,Құдайдың жын-шайтан қалауы
Dialogue: 0,0:08:26.50,0:08:29.50,Default,,0,0,0,,Ақыры қарға гүлге айналды.
Dialogue: 0,0:08:29.50,0:08:33.51,Default,,0,0,0,,Қарға гүлі марқұмның жүрегін оның қайтыс болғаны туралы хабар ретінде жеткізеді.
Dialogue: 0,0:08:33.51,0:08:37.10,Default,,0,0,0,,Ол алғашында құдайлар ағашынан туғандықтан ба?
Dialogue: 0,0:08:37.51,0:08:39.51,Default,,0,0,0,,Құдайда бір рет
Dialogue: 0,0:08:39.51,0:08:43.52,Default,,0,0,0,,Болмыстың себебі туралы ойлар бір-біріне қарама-қайшы болған кезде
Dialogue: 0,0:08:43.52,0:08:46.52,Default,,0,0,0,,Сол сезім қорды бөліскендей құтылады.
Dialogue: 0,0:08:46.52,0:08:49.52,Default,,0,0,0,,Осы катакомбаны құрады
Dialogue: 0,0:08:49.52,0:08:52.53,Default,,0,0,0,,Міне, Құдай өз халқына өліммен күресуге мүмкіндік береді.
Dialogue: 0,0:08:52.53,0:08:55.53,Default,,0,0,0,,дүниеге келген
Dialogue: 0,0:08:55.53,0:08:59.53,Default,,0,0,0,,Бірақ құлып құдайы жаңадан келе жатқан адамның еркін жоққа шығарды.
Dialogue: 0,0:08:59.53,0:09:04.54,Default,,0,0,0,,Осыдан кейін ол өшпенділікпен Катакомбаға бірнеше рет шабуыл жасады.
Dialogue: 0,0:09:04.54,0:09:08.54,Default,,0,0,0,,Бұл ағаш одан қашу сезіміне толы.
Dialogue: 0,0:09:08.54,0:09:12.55,Default,,0,0,0,,Мен де өз болмысыма деген сезімталдыққа батып кеттім.
Dialogue: 0,0:09:12.55,0:09:15.55,Default,,0,0,0,,Сіз бұл ағашпен не істеуді жоспарлап отырсыз?
Dialogue: 0,0:09:15.55,0:09:17.55,Default,,0,0,0,,Кесу
Dialogue: 0,0:09:17.55,0:09:21.56,Default,,0,0,0,,Кесуден кейін қылыш өсіру үшін діңді питомник ретінде пайдаланыңыз.
Dialogue: 0,0:09:21.56,0:09:25.31,Default,,0,0,0,,Бұл заклинанияны екі дайын қылышқа бөліңіз.
Dialogue: 0,0:09:25.56,0:09:27.56,Default,,0,0,0,,Тамырлар қарға көшеттеріне айналады.
Dialogue: 0,0:09:27.56,0:09:29.56,Default,,0,0,0,,Қалғандары күйдірілген және тазартылған.
Dialogue: 0,0:09:29.56,0:09:31.57,Default,,0,0,0,,Сынаушының күлі бол
Dialogue: 0,0:09:31.57,0:09:33.57,Default,,0,0,0,,Қылыш қайтадан сынғанда
Dialogue: 0,0:09:33.57,0:09:35.57,Default,,0,0,0,,Жандану
Dialogue: 0,0:09:35.57,0:09:38.57,Default,,0,0,0,,Бұл катакомбалардың құпия заңы.
Dialogue: 0,0:09:38.57,0:09:42.58,Default,,0,0,0,,Бұл Құдай болудың тағы бір жолы.
Dialogue: 0,0:09:42.58,0:09:44.58,Default,,0,0,0,,Ловерак Белл-доно, ах.
Dialogue: 0,0:09:44.58,0:09:48.58,Default,,0,0,0,,Мына ағашты кесуіңізді өтінемін.
Dialogue: 0,0:09:48.58,0:09:50.59,Default,,0,0,0,,Маған? (Қылышшылардың шуы)
Dialogue: 0,0:09:50.59,0:09:56.59,Default,,0,0,0,,Қамал құдайының құмарлығын сол қылышпен босатқан саған.
Dialogue: 0,0:09:56.59,0:09:59.59,Default,,0,0,0,,Осы ағашта қылышымды сынауға рұқсат етсеңіз.
Dialogue: 0,0:09:59.59,0:10:01.60,Default,,0,0,0,,Қуанышпен
Dialogue: 0,0:10:01.60,0:10:04.60,Default,,0,0,0,,Махаббат Қара = Қоңырау! (Қылыш шебері) Жабайы сұлу!
Dialogue: 0,0:10:04.60,0:10:07.60,Default,,0,0,0,,Бұл қылыш тіпті құдайларды да кесіп тастайды!
Dialogue: 0,0:10:07.60,0:10:11.61,Default,,0,0,0,,Әлемді тесіңіз
Dialogue: 0,0:10:11.61,0:10:13.61,Default,,0,0,0,,《Сіз сыйлық аласыз》
Dialogue: 0,0:10:16.61,0:10:18.61,Default,,0,0,0,,Хааах!
Dialogue: 0,0:10:18.61,0:10:20.62,Default,,0,0,0,,Таа!
Dialogue: 0,0:10:24.62,0:10:26.62,Default,,0,0,0,,О...
Dialogue: 0,0:10:31.63,0:10:34.63,Default,,0,0,0,,《Кесу...》
Dialogue: 0,0:10:40.64,0:10:44.64,Default,,0,0,0,,Саяхаттың кілті - тәртіп орталығы.
Dialogue: 0,0:10:44.64,0:10:46.64,Default,,0,0,0,,Ол тек ағынды қара көлеңкеде болады
Dialogue: 0,0:10:46.64,0:10:50.65,Default,,0,0,0,,Қара уақыт, қара бағыт, мінекей!
Dialogue: 0,0:10:50.65,0:10:53.65,Default,,0,0,0,,Сіз оны алуыңыз керек!
Dialogue: 0,0:10:53.65,0:10:55.65,Default,,0,0,0,,Біздің шайқаста
Dialogue: 0,0:10:55.65,0:10:58.65,Default,,0,0,0,,Кілттер өте маңызды болады
Dialogue: 0,0:10:58.65,0:11:02.66,Default,,0,0,0,,Бұдан былай катакомбаларды қорғаймыз.
Dialogue: 0,0:11:02.66,0:11:04.66,Default,,0,0,0,,Жоғарғы иттер мен бағыныштыларды бағындыру үшін шайқаста
Dialogue: 0,0:11:04.66,0:11:06.66,Default,,0,0,0,,Менің кетуім керек
Dialogue: 0,0:11:06.66,0:11:09.66,Default,,0,0,0,,Мен әлемдегі өзгерістердің бастамашысымын.
Dialogue: 0,0:11:09.66,0:11:12.67,Default,,0,0,0,,Сенің семсеріңнен басқа ешкім ашылмады.
Dialogue: 0,0:11:12.67,0:11:14.67,Default,,0,0,0,,Мен үлкен үміт күтемін.
Dialogue: 0,0:11:14.67,0:11:16.67,Default,,0,0,0,,Бұл үшін рахмет.
Dialogue: 0,0:11:16.67,0:11:21.68,Default,,0,0,0,,Сіз әрқашан жойылу ішінде жасайсыз.
Dialogue: 0,0:11:21.68,0:11:26.68,Default,,0,0,0,,Сенің семсерің жолдың кілтіне не әкеледі деп ойлаймын.
Dialogue: 0,0:11:26.68,0:11:30.69,Default,,0,0,0,,Сенің сөзің менің үмітім Гиннес
Dialogue: 0,0:11:30.69,0:11:33.69,Default,,0,0,0,,Менің семсерім жойылуда
Dialogue: 0,0:11:33.69,0:11:36.69,Default,,0,0,0,,Бір нәрсені жасау мүмкіндігі бар екенін білдіреді.
Dialogue: 0,0:11:36.69,0:11:39.69,Default,,0,0,0,,Маған батылдық береді
Dialogue: 0,0:11:39.69,0:11:43.70,Default,,0,0,0,,Біз сені жалғыз қалдырмаймыз, уәде береміз
Dialogue: 0,0:11:43.70,0:11:47.70,Default,,0,0,0,,Мен сынау үшін қылыш ұстаймын
Dialogue: 0,0:11:47.70,0:11:50.71,Default,,0,0,0,,Кез келген уақытта, кез келген жерде
Dialogue: 0,0:11:50.71,0:11:53.71,Default,,0,0,0,,Қоңырау! (Тұман) Қара қоңырауды жақсы көр!
Dialogue: 0,0:11:53.71,0:11:55.71,Default,,0,0,0,,Шық!
Dialogue: 0,0:11:55.71,0:11:58.71,Default,,0,0,0,,Барлығы, бұл жігіт...
Dialogue: 0,0:11:58.71,0:12:01.72,Default,,0,0,0,,Мен саяхатқа шығу керек деп ойладым.
Dialogue: 0,0:12:01.72,0:12:03.72,Default,,0,0,0,,Бізде бар нәрсе іштен
Dialogue: 0,0:12:03.72,0:12:07.72,Default,,0,0,0,,Бірінші жүлде: Мен Беллге ұнайтынын таңдадым.
Dialogue: 0,0:12:07.72,0:12:10.73,Default,,0,0,0,,Сіз қалай ойлайсыз? Жарайды ма?
Dialogue: 0,0:12:10.73,0:12:12.73,Default,,0,0,0,,Я, мен саған мынаны беремін.
Dialogue: 0,0:12:12.73,0:12:17.73,Default,,0,0,0,,Беннетт: Мүмкін сіз оны орындаған шығарсыз?
Dialogue: 0,0:12:17.73,0:12:19.73,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:12:19.73,0:12:21.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:21.74,0:12:23.74,Default,,0,0,0,,Қош келдіңіз, Белл
Dialogue: 0,0:12:23.74,0:12:25.74,Default,,0,0,0,,Фу…
Dialogue: 0,0:12:25.74,0:12:27.74,Default,,0,0,0,,Фуфу
Dialogue: 0,0:12:27.74,0:12:29.74,Default,,0,0,0,,Фу…
Dialogue: 0,0:12:30.75,0:12:33.75,Default,,0,0,0,,Фуфуфу…
Dialogue: 0,0:12:33.75,0:12:37.75,Default,,0,0,0,,Енді соңғы тармаққа тоқталайық.
Dialogue: 0,0:12:37.75,0:12:39.75,Default,,0,0,0,,Бұл, Белл-доно.
Dialogue: 0,0:12:39.75,0:12:41.76,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:41.76,0:12:43.76,Default,,0,0,0,,Біздің жұмбақ киім
Dialogue: 0,0:12:43.76,0:12:47.76,Default,,0,0,0,,Адонис осылай киюі керек еді. Ах...
Dialogue: 0,0:12:47.76,0:12:52.77,Default,,0,0,0,,Менің ойымша, бұл саяхат үшін жаман идея емес.
Dialogue: 0,0:12:53.77,0:12:58.77,Default,,0,0,0,,《Мен бұл елде тұрдым》
Dialogue: 0,0:12:58.77,0:13:00.78,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:03.28,0:13:06.28,Default,,0,0,0,,Мен кілтті таба алмадым
Dialogue: 0,0:13:06.28,0:13:08.28,Default,,0,0,0,,Бұл сізге мүмкін бе?
Dialogue: 0,0:13:08.28,0:13:12.29,Default,,0,0,0,,Менің ойымша, біз тырысамыз.
Dialogue: 0,0:13:12.29,0:13:15.29,Default,,0,0,0,,Белл, маған кілт маңызды емес.
Dialogue: 0,0:13:15.29,0:13:18.29,Default,,0,0,0,,Басқа таңдау бар сияқты.
Dialogue: 0,0:13:18.29,0:13:20.30,Default,,0,0,0,,Бұл мөр.
Dialogue: 0,0:13:20.30,0:13:22.30,Default,,0,0,0,,Сіздің қылыш достарыңыз
Dialogue: 0,0:13:22.30,0:13:24.30,Default,,0,0,0,,Ұлтты тыныштандыру үшін күрестің белгісі ретінде
Dialogue: 0,0:13:24.30,0:13:29.30,Default,,0,0,0,,Сондай-ақ тапсырыстан құтылу жолы ретінде кілтті іздеу.
Dialogue: 0,0:13:29.30,0:13:31.31,Default,,0,0,0,,Егер кілтті жою мүмкін болмаса
Dialogue: 0,0:13:31.31,0:13:34.31,Default,,0,0,0,,Оны осылай мәңгілікке мөрлеуге болады.
Dialogue: 0,0:13:34.31,0:13:37.31,Default,,0,0,0,,Бұл менің ережем.
Dialogue: 0,0:13:37.31,0:13:40.32,Default,,0,0,0,,Иа, мен үшін әрқашан бір жол бар
Dialogue: 0,0:13:40.32,0:13:43.32,Default,,0,0,0,,Егер бірдеңеде жасырын ниет болса
Dialogue: 0,0:13:43.32,0:13:46.32,Default,,0,0,0,,Мен оны босатамын
Dialogue: 0,0:13:46.32,0:13:50.33,Default,,0,0,0,,Қара уақыт Қара бағыт
Dialogue: 0,0:13:50.33,0:13:53.33,Default,,0,0,0,,Сенің семсерің жұмбақты шеше ме?
Dialogue: 0,0:13:53.33,0:13:56.33,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:13:56.33,0:14:12.35,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:12.35,0:14:14.35,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:14:21.36,0:14:24.36,Default,,0,0,0,,Бұл... жолдың кілті ме?
Dialogue: 0,0:14:24.36,0:14:27.36,Default,,0,0,0,,Бұл Аштық Одағының көлеңкесі сияқты.
Dialogue: 0,0:14:27.36,0:14:31.37,Default,,0,0,0,,Мен Аштық Альянсының саяхаты мен аштығының кілті екеніне сенімдімін
Dialogue: 0,0:14:31.37,0:14:34.37,Default,,0,0,0,,Мен осы илаһи ағаштың көлеңкесінен тудым.
Dialogue: 0,0:14:34.37,0:14:36.37,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:14:41.38,0:14:43.38,Default,,0,0,0,,《сыналуда》
Dialogue: 0,0:14:43.38,0:14:47.38,Default,,0,0,0,,《Көшпенділер мен аштық одақтарының шығу тегі бір ме?》
Dialogue: 0,0:14:47.38,0:14:50.39,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:14:50.39,0:14:52.39,Default,,0,0,0,,А... уф
Dialogue: 0,0:14:52.39,0:14:54.39,Default,,0,0,0,,Дааа!
Dialogue: 0,0:14:57.39,0:15:00.40,Default,,0,0,0,,《Жаңа нені кестің? 》
Dialogue: 0,0:15:01.40,0:15:04.40,Default,,0,0,0,,Қатысу
Dialogue: 0,0:15:09.40,0:15:11.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:18.41,0:15:23.42,Default,,0,0,0,,♪(『La Campanella』)
Dialogue: 0,0:15:23.42,0:15:25.42,Default,,0,0,0,,♪～
Dialogue: 0,0:15:25.42,0:15:27.42,Default,,0,0,0,,Ән айту...
Dialogue: 0,0:15:27.42,0:15:37.43,Default,,0,0,0,,♪～
Dialogue: 0,0:15:37.43,0:15:40.44,Default,,0,0,0,,《Сағыныш…》
Dialogue: 0,0:15:40.44,0:16:00.46,Default,,0,0,0,,♪～
Dialogue: 0,0:16:00.46,0:16:04.46,Default,,0,0,0,,♪～
Dialogue: 0,0:16:04.46,0:16:09.46,Default,,0,0,0,,《Мен тірі тұрмын》
Dialogue: 0,0:16:09.46,0:16:16.47,Default,,0,0,0,,♪～
Dialogue: 0,0:16:16.47,0:16:18.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:18.47,0:16:22.48,Default,,0,0,0,,Қалай! Саяхаттың кілті біздің көлеңкемізде
Dialogue: 0,0:16:22.48,0:16:25.48,Default,,0,0,0,,Көшпеліліктің жаңа түрі
Dialogue: 0,0:16:25.48,0:16:30.49,Default,,0,0,0,,Саяхат кілтінің әуенін өз көлеңкесінде естіген адам
Dialogue: 0,0:16:30.49,0:16:33.49,Default,,0,0,0,,Жаңа көшпенді бол
Dialogue: 0,0:16:34.49,0:16:37.49,Default,,0,0,0,,Мен оны қиып алдым (сүю дыбысы)
Dialogue: 0,0:16:37.49,0:16:41.50,Default,,0,0,0,,《Гиннес бірінші, сен мұны тыңдап тұрсың ба?》
Dialogue: 0,0:16:41.50,0:16:46.50,Default,,0,0,0,,《Енді Ғафф екеуіңнің арасындағы кикілжіңнің себебі жойылды》
Dialogue: 0,0:16:46.50,0:16:50.51,Default,,0,0,0,,《Кілт сенің көлеңкеңде! 》
Dialogue: 0,0:16:50.51,0:16:52.51,Default,,0,0,0,,Дәл осы сәт сияқты
Dialogue: 0,0:16:52.51,0:16:57.51,Default,,0,0,0,,Елдің бәрі айдалаға бет алған көшпендіге айналғандай.
Dialogue: 0,0:16:57.51,0:17:00.52,Default,,0,0,0,,Сынақ сәтті аяқталды.
Dialogue: 0,0:17:00.52,0:17:02.52,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:02.52,0:17:07.52,Default,,0,0,0,,Мен сені патша ретінде және жай қылышшы ретінде жіберемін.
Dialogue: 0,0:17:07.52,0:17:10.53,Default,,0,0,0,,Күндердің күнінде тағы да осы елдің сахнасына шығасың.
Dialogue: 0,0:17:10.53,0:17:13.53,Default,,0,0,0,,Қылыш музыкасы ойналатын уақытқа дейін
Dialogue: 0,0:17:13.53,0:17:16.53,Default,,0,0,0,,Қоштасу қоңырауы
Dialogue: 0,0:17:16.53,0:17:18.53,Default,,0,0,0,,Мен сәл қателестім — саусағым сырғып кетті.
Dialogue: 0,0:17:18.53,0:17:21.54,Default,,0,0,0,,Қош бол
Dialogue: 0,0:17:24.54,0:17:26.54,Default,,0,0,0,,сіз бізге
Dialogue: 0,0:17:26.54,0:17:30.55,Default,,0,0,0,,Сен маған сыйлық ретінде мына көбелек бақшасын көрсеттің.
Dialogue: 0,0:17:30.55,0:17:33.55,Default,,0,0,0,,Мен жаңа ғана қылышты сермедім
Dialogue: 0,0:17:33.55,0:17:37.55,Default,,0,0,0,,Керісінше, сен өміріңді қатерге тігіп, ән айтып, Құдайдан сұрадың
Dialogue: 0,0:17:37.55,0:17:40.56,Default,,0,0,0,,Менің ойымша, бұл жауап.
Dialogue: 0,0:17:40.56,0:17:43.56,Default,,0,0,0,,Мына көбелекке қарап
Dialogue: 0,0:17:43.56,0:17:46.56,Default,,0,0,0,,Мен өзімнің қалай өзгергенімді көріп тұрғандай сезінемін.
Dialogue: 0,0:17:46.56,0:17:50.57,Default,,0,0,0,,Мен кім екенімді білемін деп ойлаған кезде
Dialogue: 0,0:17:50.57,0:17:53.57,Default,,0,0,0,,Тағы бір жауап алыс.
Dialogue: 0,0:17:53.57,0:17:56.57,Default,,0,0,0,,Ха... шынымен шексіз
Dialogue: 0,0:17:56.57,0:18:01.58,Default,,0,0,0,,Дүние үшін осылай күресесің бе?
Dialogue: 0,0:18:01.58,0:18:03.58,Default,,0,0,0,,Осы дүниенің барлық адамдарына
Dialogue: 0,0:18:03.58,0:18:09.58,Default,,0,0,0,,Біздің кім екенімізді дәлелдеу.
Dialogue: 0,0:18:09.58,0:18:12.59,Default,,0,0,0,,Дүниені иығыммен көтергім келмейді
Dialogue: 0,0:18:12.59,0:18:15.59,Default,,0,0,0,,Мен жай ғана адам болғым келеді
Dialogue: 0,0:18:15.59,0:18:20.60,Default,,0,0,0,,Дүниеде мен басқалармен араласатын адам болғым келеді.
Dialogue: 0,0:18:20.60,0:18:24.60,Default,,0,0,0,,Менің атым Белл, басқа ештеңе жоқ.
Dialogue: 0,0:18:24.60,0:18:28.60,Default,,0,0,0,,Сонда да қылышымды әлемге бұлғап сұрағым келеді
Dialogue: 0,0:18:28.60,0:18:31.61,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:18:31.61,0:18:35.61,Default,,0,0,0,,Еркіндігім, Сағынышымның бастауы
Dialogue: 0,0:18:35.61,0:18:38.61,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:18:38.61,0:18:41.62,Default,,0,0,0,,Егер сіз кішкене болса да құндылықты сезінсеңіз
Dialogue: 0,0:18:41.62,0:18:43.62,Default,,0,0,0,,Мен мұнымен жақсымын.
Dialogue: 0,0:18:43.62,0:18:46.62,Default,,0,0,0,,өте жақсы
Dialogue: 0,0:18:46.62,0:18:49.62,Default,,0,0,0,,Белл шешім қабылдады
Dialogue: 0,0:18:49.62,0:18:51.63,Default,,0,0,0,,Мен бақсы болғым келеді.
Dialogue: 0,0:18:51.63,0:18:53.63,Default,,0,0,0,,Ведьма?
Dialogue: 0,0:18:53.63,0:18:56.63,Default,,0,0,0,,Өйткені мен соңғы жынмын.
Dialogue: 0,0:18:56.63,0:18:59.63,Default,,0,0,0,,Құдайдың махаббаты туралы ән айттым.
Dialogue: 0,0:18:59.63,0:19:04.64,Default,,0,0,0,,Бұдан былай мен әулие қыздың орнына бақсы болып ән айтамын.
Dialogue: 0,0:19:04.64,0:19:06.64,Default,,0,0,0,,Бір күні адамдар
Dialogue: 0,0:19:06.64,0:19:10.65,Default,,0,0,0,,Сіз «Маған сиқырдың қажеті жоқ» деп шырқағанға дейін
Dialogue: 0,0:19:12.65,0:19:14.65,Default,,0,0,0,,Иә
Dialogue: 0,0:19:14.65,0:19:18.65,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:19:18.65,0:19:22.66,Default,,0,0,0,,Бұл тамаша, Шерри, мен оны тыңдағым келеді.
Dialogue: 0,0:19:22.66,0:19:26.66,Default,,0,0,0,,Иә, Белл, шынымен...
Dialogue: 0,0:19:26.66,0:19:29.66,Default,,0,0,0,,Ха, Шерри?
Dialogue: 0,0:19:29.66,0:19:35.67,Default,,0,0,0,,(жылау)
Dialogue: 0,0:19:35.67,0:19:38.67,Default,,0,0,0,,Мен жыламауды шештім
Dialogue: 0,0:19:38.67,0:19:43.68,Default,,0,0,0,,Себебі мен сіздің бетіңізді анық көре алмаймын...
Dialogue: 0,0:19:49.68,0:19:52.69,Default,,0,0,0,,Сіз... барасыз ба?
Dialogue: 0,0:19:52.69,0:19:55.69,Default,,0,0,0,,Ах, көшпенді болу
Dialogue: 0,0:19:55.69,0:19:59.69,Default,,0,0,0,,Осы жерге оралуыңызды өтінемін.
Dialogue: 0,0:19:59.69,0:20:01.70,Default,,0,0,0,,Мен осы елдемін
Dialogue: 0,0:20:01.70,0:20:05.70,Default,,0,0,0,,Тағы да менің әнім...
Dialogue: 0,0:20:05.70,0:20:10.71,Default,,0,0,0,,Бір күні қайтып келемін, әніңді тыңдауға келемін
Dialogue: 0,0:20:10.71,0:20:14.71,Default,,0,0,0,,Сол жерде бір-біріміздің саяхатымыз туралы сөйлесейік.
Dialogue: 0,0:20:14.71,0:20:18.71,Default,,0,0,0,,Қош бол Қоңырау
Dialogue: 0,0:20:18.71,0:20:21.72,Default,,0,0,0,,Қош бол Шерри
Dialogue: 0,0:20:40.23,0:20:44.24,Default,,0,0,0,,Оның себебі неде?
Dialogue: 0,0:20:44.24,0:20:47.24,Default,,0,0,0,,(жіптер дыбысы)
Dialogue: 0,0:20:47.24,0:21:05.26,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:05.26,0:21:07.26,Default,,0,0,0,,Мен бұл қақпадан кеткім келеді
Dialogue: 0,0:21:07.26,0:21:09.26,Default,,0,0,0,,Сіз оны маған аша аласыз ба?
Dialogue: 0,0:21:09.26,0:21:11.27,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:21:11.27,0:21:15.27,Default,,0,0,0,,Сізде шынымен де осы жерден өтуге себеп бар ма?
Dialogue: 0,0:21:15.27,0:21:17.27,Default,,0,0,0,,Барлығы жақсы
Dialogue: 0,0:21:17.27,0:21:19.27,Default,,0,0,0,,Жақсы жүз
Dialogue: 0,0:21:19.27,0:21:21.28,Default,,0,0,0,,Сәл күте тұрыңыз.
Dialogue: 0,0:21:21.28,0:21:23.28,Default,,0,0,0,,Фу
Dialogue: 0,0:21:24.28,0:21:27.28,Default,,0,0,0,,Ах
Dialogue: 0,0:21:27.28,0:21:30.28,Default,,0,0,0,,О, сәлем Китти
Dialogue: 0,0:21:30.28,0:21:32.29,Default,,0,0,0,,Менімен келесің бе?
Dialogue: 0,0:21:34.29,0:21:36.29,Default,,0,0,0,,Иә
Dialogue: 0,0:21:37.29,0:21:40.29,Default,,0,0,0,,Сәттілік...
Dialogue: 0,0:21:40.29,0:21:43.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:47.30,0:21:50.30,Default,,0,0,0,,Қош бол Кити
Dialogue: 0,0:21:50.30,0:21:53.31,Default,,0,0,0,,Қақпаны аш!
Dialogue: 0,0:21:53.31,0:21:56.31,Default,,0,0,0,,♪♪～
Dialogue: 0,0:21:56.31,0:22:16.33,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:16.33,0:22:28.34,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:28.34,0:22:36.35,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:36.35,0:22:38.35,Default,,0,0,0,,Бұл қай жер?
Dialogue: 0,0:22:38.35,0:22:41.36,Default,,0,0,0,,Шекара аймағы хаха
Dialogue: 0,0:22:41.36,0:22:44.36,Default,,0,0,0,,Басқа елдің арасындағы құдайлық тосқауыл бір-біріне тию арқылы жасалады.
Dialogue: 0,0:22:44.36,0:22:47.36,Default,,0,0,0,,Шекарадағы әлем
Dialogue: 0,0:22:47.36,0:22:50.36,Default,,0,0,0,,Тоқта, барма~
Dialogue: 0,0:22:50.36,0:22:52.37,Default,,0,0,0,,Тіпті кері қайтпа. Бұл жігіт...
Dialogue: 0,0:22:52.37,0:22:55.37,Default,,0,0,0,,Ішке кірмеңіз...
Dialogue: 0,0:22:55.37,0:22:59.37,Default,,0,0,0,,Кедергі қысымынан жеңілгендердің ойларының көлеңкесі
Dialogue: 0,0:22:59.37,0:23:02.38,Default,,0,0,0,,Шекарадан тыс сапарға аттанатындар үшін
Dialogue: 0,0:23:02.38,0:23:04.38,Default,,0,0,0,,Барлығын ішуге тырысу
Dialogue: 0,0:23:04.38,0:23:08.38,Default,,0,0,0,,Қызық хаха!
Dialogue: 0,0:23:09.38,0:23:11.39,Default,,0,0,0,,Хааах!
Dialogue: 0,0:23:11.39,0:23:13.39,Default,,0,0,0,,Жоғалып кетіңдер, елестер.
Dialogue: 0,0:23:13.39,0:23:16.39,Default,,0,0,0,,Мен саған жұтқым келеді
Dialogue: 0,0:23:16.39,0:23:20.39,Default,,0,0,0,,Мұнда болу үшін тым тірі!
Dialogue: 0,0:23:20.39,0:23:31.41,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:31.41,0:23:34.41,Default,,0,0,0,,(Сағат тасының шырылдаған дыбысы)
Dialogue: 0,0:23:35.91,0:23:41.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory