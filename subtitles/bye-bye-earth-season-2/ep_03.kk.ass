Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.13,0:00:08.10,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:14.14,0:00:16.14,Default,,0,0,0,,Белл иә?
Dialogue: 0,0:00:16.14,0:00:18.15,Default,,0,0,0,,Бір күні Адонис қамалға келді.
Dialogue: 0,0:00:18.15,0:00:20.15,Default,,0,0,0,,Адонис?
Dialogue: 0,0:00:20.15,0:00:24.15,Default,,0,0,0,,Хм, ол патшамен жасырын түрде аудиторияда болған сияқты...
Dialogue: 0,0:00:24.15,0:00:27.16,Default,,0,0,0,,Маған неге олай айтып тұрсың?
Dialogue: 0,0:00:27.16,0:00:29.16,Default,,0,0,0,,Мен ол адаммен біргемін➡
Dialogue: 0,0:00:29.16,0:00:32.16,Default,,0,0,0,,1 Қылыш үшін жанжал
Dialogue: 0,0:00:32.16,0:00:34.16,Default,,0,0,0,,Катакомбаларды басқаратын Коллинз отбасына➡
Dialogue: 0,0:00:34.16,0:00:36.16,Default,,0,0,0,,Ұрпақтан ұрпаққа жалғасып келе жатқан асыл қылыш.
Dialogue: 0,0:00:36.16,0:00:38.17,Default,,0,0,0,,Ах
Dialogue: 0,0:00:38.17,0:00:41.17,Default,,0,0,0,,Сол қылышпен мен Том Коллинзмен шайқастым➡
Dialogue: 0,0:00:41.17,0:00:43.17,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:00:43.17,0:00:45.17,Default,,0,0,0,,Бұл қандай қылыш?
Dialogue: 0,0:00:45.17,0:00:48.18,Default,,0,0,0,,Кенхада – бұл патшалықтың қылышы➡
Dialogue: 0,0:00:48.18,0:00:51.15,Default,,0,0,0,,Патшалыққа өте ұқсас...
Dialogue: 0,0:00:53.18,0:00:55.18,Default,,0,0,0,,Оған осындай мөр басылған
Dialogue: 0,0:00:55.18,0:00:57.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:00.19,0:01:05.19,Default,,0,0,0,,Бұл семсерді алу үшін болған шайқас болды ма?
Dialogue: 0,0:01:05.19,0:01:08.13,Default,,0,0,0,,Бұл Құдай Сөзінің өмірі болды.
Dialogue: 0,0:01:08.13,0:01:11.13,Default,,0,0,0,,Шын мәні өлшеусіз, бірақ...
Dialogue: 0,0:01:11.13,0:01:14.14,Default,,0,0,0,,Әйтеуір, енді менде бар, қолымнан келсе ➡
Dialogue: 0,0:01:14.14,0:01:18.14,Default,,0,0,0,,Мен оны Том Коллинздің кіші ұлы Адониске беруді ойладым.
Dialogue: 0,0:01:18.14,0:01:22.14,Default,,0,0,0,,Онда неге тез бермеске?
Dialogue: 0,0:01:22.14,0:01:24.15,Default,,0,0,0,,Ол үшін шарттар бар.
Dialogue: 0,0:01:24.15,0:01:26.15,Default,,0,0,0,,Сол адамның осы уақытқа дейін алған қылыш➡
Dialogue: 0,0:01:26.15,0:01:28.15,Default,,0,0,0,,Барлығын босатыңыз
Dialogue: 0,0:01:28.15,0:01:32.15,Default,,0,0,0,,Иә? Оның мұндай шарттарды қабылдауға мүмкіндігі жоқ.
Dialogue: 0,0:01:32.15,0:01:35.16,Default,,0,0,0,,Менің кіші інім патша ретінде мұны істемесең➡
Dialogue: 0,0:01:35.16,0:01:38.16,Default,,0,0,0,,Осы елді арқаммен сүйем➡
Dialogue: 0,0:01:38.16,0:01:40.16,Default,,0,0,0,,Мүлде мүмкін емес
Dialogue: 0,0:01:40.16,0:01:43.17,Default,,0,0,0,,Кіші інісі патша? Бұл дұрыс
Dialogue: 0,0:01:43.17,0:01:46.17,Default,,0,0,0,,Қылыш шебері болып биікке көтеріле берсең➡
Dialogue: 0,0:01:46.17,0:01:48.17,Default,,0,0,0,,Болары сөзсіз.
Dialogue: 0,0:01:48.17,0:01:52.17,Default,,0,0,0,,Эй, ол патша...
Dialogue: 0,0:01:52.17,0:01:55.18,Default,,0,0,0,,Демек, сен менің ағам патшасың.
Dialogue: 0,0:01:55.18,0:01:59.18,Default,,0,0,0,,Сондықтан біз бұл мәселені мүмкіндігінше тезірек шешуіміз керек...
Dialogue: 0,0:01:59.18,0:02:01.18,Default,,0,0,0,,Белл а
Dialogue: 0,0:02:01.18,0:02:04.19,Default,,0,0,0,,Ей... Мен ол жігітпен көп болды.
Dialogue: 0,0:02:04.19,0:02:08.12,Default,,0,0,0,,Түсінемін, өтінемін.
Dialogue: 0,0:02:08.12,0:02:14.10,Default,,0,0,0,,Мен де онымен қайта кездесіп, сөйлесуіміз керек деп ойладым.
Dialogue: 0,0:02:15.13,0:02:17.13,Default,,0,0,0,,Жарасын жара деп емдейді➡
Dialogue: 0,0:02:17.13,0:02:21.14,Default,,0,0,0,,Өйткені мен ақымақпын, мен оны ешқашан мойындамаймын.
Dialogue: 0,0:02:21.14,0:02:23.14,Default,,0,0,0,,Мен оны дұрыс жеткізгім келеді.
Dialogue: 0,0:02:23.14,0:02:26.14,Default,,0,0,0,,Ауырсыну дегеніміз не?
Dialogue: 0,0:02:26.14,0:02:31.15,Default,,0,0,0,,Өйткені мен мұны қазір істей аламын деп ойлаймын.
Dialogue: 0,0:02:31.15,0:02:49.16,Default,,0,0,0,,♬～
Dialogue: 0,0:02:49.16,0:02:53.17,Default,,0,0,0,,♬～
Dialogue: 0,0:02:53.17,0:03:13.12,Default,,0,0,0,,♬～
Dialogue: 0,0:03:13.12,0:03:33.14,Default,,0,0,0,,♬～
Dialogue: 0,0:03:33.14,0:03:53.16,Default,,0,0,0,,♬～
Dialogue: 0,0:03:53.16,0:04:01.14,Default,,0,0,0,,♬～
Dialogue: 0,0:04:02.17,0:04:06.11,Default,,0,0,0,,Сол... (дворян) Катакомба шайқасы...
Dialogue: 0,0:04:06.11,0:04:08.11,Default,,0,0,0,,Хо Өтініш дегеніміз не?
Dialogue: 0,0:04:08.11,0:04:10.11,Default,,0,0,0,,Осындай қауесеттер бар сияқты.
Dialogue: 0,0:04:10.11,0:04:14.12,Default,,0,0,0,,Бір күні осы киіммен тасбақа мінгенім есімде.
Dialogue: 0,0:04:14.12,0:04:18.12,Default,,0,0,0,,Біз бір-бірімізді бірінші рет кездестірдік.
Dialogue: 0,0:04:18.12,0:04:20.12,Default,,0,0,0,,Мен ол кезде кім едім➡
Dialogue: 0,0:04:20.12,0:04:24.13,Default,,0,0,0,,Мен әрқашан өз жүрегімді өлтіруге тырыстым, бірақ...
Dialogue: 0,0:04:24.13,0:04:26.13,Default,,0,0,0,,Толық өзгерсе өзгереді.
Dialogue: 0,0:04:26.13,0:04:30.13,Default,,0,0,0,,Хехе, өзгерген нәрселерді айтсақ...
Dialogue: 0,0:04:30.13,0:04:33.14,Default,,0,0,0,,Хехехе, мен де өзгердім, білесің бе?
Dialogue: 0,0:04:33.14,0:04:36.14,Default,,0,0,0,,Ал... бұл нені білдіреді?
Dialogue: 0,0:04:36.14,0:04:38.14,Default,,0,0,0,,Менің бойым өсті!
Dialogue: 0,0:04:38.14,0:04:40.14,Default,,0,0,0,,О, бұл.
Dialogue: 0,0:04:40.14,0:04:42.14,Default,,0,0,0,,Бұл рас! Хмм...
Dialogue: 0,0:04:42.14,0:04:45.15,Default,,0,0,0,,Бұл костюмді жөндеген дизайнер маған осылай деді.
Dialogue: 0,0:04:45.15,0:04:47.15,Default,,0,0,0,,Оның кеудесі де сәл үлкейіп кеткен.
Dialogue: 0,0:04:47.15,0:04:49.15,Default,,0,0,0,,Хохо
Dialogue: 0,0:04:49.15,0:04:51.15,Default,,0,0,0,,Түсініксіз (қол шапалақтау)
Dialogue: 0,0:04:51.15,0:04:54.16,Default,,0,0,0,,Уф... Барса ставкасы.
Dialogue: 0,0:04:54.16,0:04:56.16,Default,,0,0,0,,Қоңырау! Ах
Dialogue: 0,0:04:56.16,0:04:58.16,Default,,0,0,0,,О, сәлем, Шерри!
Dialogue: 0,0:04:58.16,0:05:01.16,Default,,0,0,0,,Қоңырау өте жақсы.
Dialogue: 0,0:05:01.16,0:05:03.17,Default,,0,0,0,,Сен де әдемісің
Dialogue: 0,0:05:03.17,0:05:07.10,Default,,0,0,0,,Бұл әншінің труппасының костюмі емес пе? Саған өте жарасады
Dialogue: 0,0:05:07.10,0:05:11.11,Default,,0,0,0,,Ержүрек қылышшы және нәзік әнші (Шелли/Белл) Ах!
Dialogue: 0,0:05:11.11,0:05:13.11,Default,,0,0,0,,Шынымен де көркем (Шерри) О...
Dialogue: 0,0:05:13.11,0:05:15.11,Default,,0,0,0,,Кәдімгі қылышшының әңгімесі сияқты.
Dialogue: 0,0:05:15.11,0:05:17.11,Default,,0,0,0,,Енді Белл еркек болса...
Dialogue: 0,0:05:17.11,0:05:19.11,Default,,0,0,0,,Менімен... (Беннет/Гиннес) Ах.
Dialogue: 0,0:05:19.11,0:05:22.12,Default,,0,0,0,,Мүмкін олар құлыптың дивасы үшін жарысып жатқан шығар.
Dialogue: 0,0:05:22.12,0:05:25.12,Default,,0,0,0,,Не? Бұл жағдайда біз ➡
Dialogue: 0,0:05:25.12,0:05:28.12,Default,,0,0,0,,Сен Беллді қорғап, күнәға батуың керек.
Dialogue: 0,0:05:28.12,0:05:33.09,Default,,0,0,0,,Бұл қылышшы әңгімелерінің стандарты.
Dialogue: 0,0:05:37.13,0:05:40.14,Default,,0,0,0,,Демек, ол Беллдің жақсы қылышшысы ма?
Dialogue: 0,0:05:40.14,0:05:46.14,Default,,0,0,0,,Иә, біз шайқаста бір-бірімізге арқа сүйей аламыз.
Dialogue: 0,0:05:46.14,0:05:51.15,Default,,0,0,0,,Иә, өсек-аяңға қарағанда, оның бойында қандай да бір ерекшеліктер бар, бірақ оның ой-өрісі керемет.
Dialogue: 0,0:05:51.15,0:05:54.15,Default,,0,0,0,,Дұрыс? Ғафф, бүгінгі күн үшін рахмет.
Dialogue: 0,0:05:54.15,0:05:56.15,Default,,0,0,0,,Не?
Dialogue: 0,0:05:56.15,0:06:00.16,Default,,0,0,0,,Солай бола тұрса да, ол енді қайта бөлінбейтін сияқты.
Dialogue: 0,0:06:00.16,0:06:03.16,Default,,0,0,0,,Сізге қалай бергенімді қалайсыз?
Dialogue: 0,0:06:03.16,0:06:06.09,Default,,0,0,0,,О, ондай жағдайда мен де соны қалаймын.
Dialogue: 0,0:06:06.09,0:06:09.10,Default,,0,0,0,,Солай етіңіз.
Dialogue: 0,0:06:09.10,0:06:11.10,Default,,0,0,0,,Шери Мен олай ойламаймын...
Dialogue: 0,0:06:11.10,0:06:13.10,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:06:13.10,0:06:16.10,Default,,0,0,0,,(Сағат тасының шырылдаған дыбысы)
Dialogue: 0,0:06:16.10,0:06:19.11,Default,,0,0,0,,Уақыт жеткен сияқты
Dialogue: 0,0:06:19.11,0:06:37.13,Default,,0,0,0,,♬～
Dialogue: 0,0:06:37.13,0:06:41.13,Default,,0,0,0,,Қылыш шебері аралық дирижер Гиннес
Dialogue: 0,0:06:41.13,0:06:46.13,Default,,0,0,0,,Мен бүгін семсершілер тобының бас қылышшысы Гафф-дононың рұқсатымен келдім➡
Dialogue: 0,0:06:46.13,0:06:52.14,Default,,0,0,0,,Мен өз өтінішімді кішіпейілділікпен ұсыну үшін осы залға келдім.
Dialogue: 0,0:06:52.14,0:06:56.14,Default,,0,0,0,,Біз Катакомбты бейтарап орынға айналдырғымыз келеді...
Dialogue: 0,0:06:56.14,0:07:01.12,Default,,0,0,0,,Шикі тері патшасы, сенің қандай екеніңді көрейік.
Dialogue: 0,0:07:05.15,0:07:07.09,Default,,0,0,0,,​​О?
Dialogue: 0,0:07:07.09,0:07:10.09,Default,,0,0,0,,Патша, мұндағылардың даусын тыңдаңыз...
Dialogue: 0,0:07:10.09,0:07:14.06,Default,,0,0,0,,Халық үні естілуін қалаймын!
Dialogue: 0,0:07:16.10,0:07:19.10,Default,,0,0,0,,⚟ (ырылдау)
Dialogue: 0,0:07:19.10,0:07:21.10,Default,,0,0,0,,Ах! ше? Беннетт
Dialogue: 0,0:07:21.10,0:07:24.11,Default,,0,0,0,,А... сен мені естисің бе?
Dialogue: 0,0:07:24.11,0:07:26.11,Default,,0,0,0,,⚟ (ырылдады) Ах
Dialogue: 0,0:07:26.11,0:07:30.11,Default,,0,0,0,,Сол перденің артында жүздеген адам бар...
Dialogue: 0,0:07:30.11,0:07:32.11,Default,,0,0,0,,Ах
Dialogue: 0,0:07:32.11,0:07:35.12,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:35.12,0:07:37.12,Default,,0,0,0,,Хи... ха
Dialogue: 0,0:07:37.12,0:07:41.09,Default,,0,0,0,,Жыл!
Dialogue: 0,0:07:42.12,0:07:44.13,Default,,0,0,0,,Ах! Мұнан кеттік!
Dialogue: 0,0:07:44.13,0:07:47.13,Default,,0,0,0,,Мен сізге құдайдың ғибадатханасы ретінде айтамын ...
Dialogue: 0,0:07:47.13,0:07:49.13,Default,,0,0,0,,Құдай сөзі?
Dialogue: 0,0:07:49.13,0:07:53.13,Default,,0,0,0,,Мен бұл қамалдағы адамдарға қауіп төндіруге тырысамын...
Dialogue: 0,0:07:53.13,0:07:56.14,Default,,0,0,0,,Жын... Не! ?
Dialogue: 0,0:07:56.14,0:08:01.14,Default,,0,0,0,,Ол Құдайда тұрғанда➡
Dialogue: 0,0:08:01.14,0:08:08.08,Default,,0,0,0,,Жындық болмысыңызды ашыңыз және енді барлық қамыттарды сындырыңыз...
Dialogue: 0,0:08:08.08,0:08:10.09,Default,,0,0,0,,Оның аты...
Dialogue: 0,0:08:10.09,0:08:12.09,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:08:12.09,0:08:14.09,Default,,0,0,0,,Қаш, Гиннес!
Dialogue: 0,0:08:14.09,0:08:17.06,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:08:23.10,0:08:25.07,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:27.10,0:08:31.11,Default,,0,0,0,,Шикі тері патшасы...?
Dialogue: 0,0:08:31.11,0:08:36.08,Default,,0,0,0,,(Раухид патшаның ыңырануы)
Dialogue: 0,0:08:40.12,0:08:43.12,Default,,0,0,0,,(Гиран) Қалай болғанда да, Курокири-сан, комиссия үшін саған сенемін.
Dialogue: 0,0:08:43.12,0:08:46.12,Default,,0,0,0,,Гиннес... Гиннесті сол нәрсе жеп қойды!
Dialogue: 0,0:08:46.12,0:08:50.13,Default,,0,0,0,,Мен Құдайдың үнімен бұйырамын
Dialogue: 0,0:08:50.13,0:08:53.13,Default,,0,0,0,,Нидхог үшін ессіз патша➡
Dialogue: 0,0:08:53.13,0:08:56.13,Default,,0,0,0,,Стрелецпен жеңіліс
Dialogue: 0,0:08:56.13,0:08:59.13,Default,,0,0,0,,Не айтып тұрсың! Әннің аты солай!
Dialogue: 0,0:08:59.13,0:09:01.14,Default,,0,0,0,,Тек кез келген ғимараттарды бұзу үшін➡
Dialogue: 0,0:09:01.14,0:09:03.14,Default,,0,0,0,,Жою әні!
Dialogue: 0,0:09:03.14,0:09:06.07,Default,,0,0,0,,Әншінің аты Шерри
Dialogue: 0,0:09:06.07,0:09:08.08,Default,,0,0,0,,Құдайдың әншісі бол➡
Dialogue: 0,0:09:08.08,0:09:11.05,Default,,0,0,0,,Патша апа...
Dialogue: 0,0:09:12.08,0:09:14.08,Default,,0,0,0,,Шерри! Бұл келе жатыр!
Dialogue: 0,0:09:14.08,0:09:19.05,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:09:21.09,0:09:23.09,Default,,0,0,0,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:09:23.09,0:09:26.09,Default,,0,0,0,,Кішкентай, аа
Dialogue: 0,0:09:26.09,0:09:28.10,Default,,0,0,0,,Шикі тері патшасы!
Dialogue: 0,0:09:28.10,0:09:31.10,Default,,0,0,0,,Өзіңді жоғалтып ал, ха...
Dialogue: 0,0:09:31.10,0:09:35.10,Default,,0,0,0,,Маған бұл залдан шығуға рұқсат етпеңіз.
Dialogue: 0,0:09:35.10,0:09:40.08,Default,,0,0,0,,Халық мені көрсін...
Dialogue: 0,0:09:42.11,0:09:45.08,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:09:46.11,0:09:50.09,Default,,0,0,0,,Мені тоқтатыңыз...
Dialogue: 0,0:09:52.12,0:09:55.12,Default,,0,0,0,,Ух... Ух... Ух...
Dialogue: 0,0:09:55.12,0:09:59.09,Default,,0,0,0,,Ол түкіріп жатқан бұл қан не?
Dialogue: 0,0:10:00.13,0:10:03.13,Default,,0,0,0,,Шыу!
Dialogue: 0,0:10:03.13,0:10:06.13,Default,,0,0,0,,Нх ха ха ха... Шери, жойылу әні, тезірек!
Dialogue: 0,0:10:06.13,0:10:10.14,Default,,0,0,0,,Маған ұнамайды! Маған ұнамайды, әке...
Dialogue: 0,0:10:10.14,0:10:14.14,Default,,0,0,0,,Шери Әкең бұдан былай қиналмасын!
Dialogue: 0,0:10:14.14,0:10:17.15,Default,,0,0,0,,Маған ұнамайды... егер солай істесем➡
Dialogue: 0,0:10:17.15,0:10:20.15,Default,,0,0,0,,Мен енді ешқашан ән айта алмаймын
Dialogue: 0,0:10:20.15,0:10:22.15,Default,,0,0,0,,Гафф мен жасаймын!
Dialogue: 0,0:10:22.15,0:10:25.15,Default,,0,0,0,,Жоқ! Құдайдың сөзіне мойынсұнбайды
Dialogue: 0,0:10:25.15,0:10:28.16,Default,,0,0,0,,Патша айтты! Айтыңызшы, тоқтаймын!
Dialogue: 0,0:10:28.16,0:10:31.16,Default,,0,0,0,,Жоқ! Апыр-ай!
Dialogue: 0,0:10:31.16,0:10:34.16,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:10:34.16,0:10:36.16,Default,,0,0,0,,Фуууууу!
Dialogue: 0,0:10:36.16,0:10:38.17,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:10:38.17,0:10:42.17,Default,,0,0,0,,Уф! Ууууууууу...!
Dialogue: 0,0:10:42.17,0:10:44.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:44.17,0:10:46.17,Default,,0,0,0,,Иә! Ха...
Dialogue: 0,0:10:46.17,0:10:49.18,Default,,0,0,0,,Қат! Өмірлік нүкте қайда?
Dialogue: 0,0:10:49.18,0:10:51.18,Default,,0,0,0,,Табылды
Dialogue: 0,0:10:51.18,0:10:53.18,Default,,0,0,0,,Қоңырау! Гиннес әлі тірі!
Dialogue: 0,0:10:53.18,0:10:55.15,Default,,0,0,0,,Бұл – Огимотоя.
Dialogue: 0,0:11:00.19,0:11:02.16,Default,,0,0,0,,Шыу!
Dialogue: 0,0:11:04.19,0:11:06.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:07.13,0:11:10.10,Default,,0,0,0,,Мен күркіреген қылышты көрдім!
Dialogue: 0,0:11:14.14,0:11:19.11,Default,,0,0,0,,Шыу!
Dialogue: 0,0:11:22.14,0:11:24.15,Default,,0,0,0,,Не?
Dialogue: 0,0:11:24.15,0:11:26.11,Default,,0,0,0,,Ол күйіктерді суық сумен салқындатып отырған
Dialogue: 0,0:11:29.15,0:11:31.15,Default,,0,0,0,,Неге...
Dialogue: 0,0:11:31.15,0:11:34.12,Default,,0,0,0,,О, сен...
Dialogue: 0,0:11:35.16,0:11:37.16,Default,,0,0,0,,Мен?
Dialogue: 0,0:11:37.16,0:11:40.16,Default,,0,0,0,,Неліктен ояндың?
Dialogue: 0,0:11:40.16,0:11:43.16,Default,,0,0,0,,Оянбасам ғой.
Dialogue: 0,0:11:43.16,0:11:46.17,Default,,0,0,0,,Мәңгі сол таста...
Dialogue: 0,0:11:46.17,0:11:48.17,Default,,0,0,0,,Не? Ах...
Dialogue: 0,0:11:48.17,0:11:53.14,Default,,0,0,0,,Сенің бар болғандықтан, біз...
Dialogue: 0,0:11:54.18,0:11:56.18,Default,,0,0,0,,Бұл жақтастық! Бұл жақтастық~!
Dialogue: 0,0:11:56.18,0:12:02.18,Default,,0,0,0,,Құтқарушыны растаудан кейін өшіру бағдарламасы...
Dialogue: 0,0:12:02.18,0:12:04.19,Default,,0,0,0,,...жаса
Dialogue: 0,0:12:04.19,0:12:10.12,Default,,0,0,0,,Дене бітімін нығайтуға арналған өмірді ұзартатын ем...
Dialogue: 0,0:12:10.12,0:12:13.13,Default,,0,0,0,,Ұзақ мерзімді криоұйқыға төтеп беру үшін...
Dialogue: 0,0:12:13.13,0:12:18.13,Default,,0,0,0,,Бұдан былай барлық...ойындар...➡
Dialogue: 0,0:12:18.13,0:12:23.14,Default,,0,0,0,,Тірі қалғанның ниеті расталғанға дейін➡
Dialogue: 0,0:12:23.14,0:12:27.14,Default,,0,0,0,,Тоқтату бағдарламасын белгісіз уақытқа кейінге қалдырыңыз
Dialogue: 0,0:12:27.14,0:12:32.15,Default,,0,0,0,,Бұдан былай барлық... нысандар ➡ болып табылады
Dialogue: 0,0:12:32.15,0:12:37.15,Default,,0,0,0,,Өміршең орта құруды бастаңыз
Dialogue: 0,0:12:37.15,0:12:41.16,Default,,0,0,0,,Тіршіліктің бар екендігін босатыңыз➡
Dialogue: 0,0:12:41.16,0:12:45.16,Default,,0,0,0,,Эволюциялық орта құру➡
Dialogue: 0,0:12:45.16,0:12:50.16,Default,,0,0,0,,Біз өмір сүруіміздің себебін осы тұлғаға қойдық...
Dialogue: 0,0:12:50.16,0:12:52.17,Default,,0,0,0,,Ал профессор Гожо ше?
Dialogue: 0,0:12:52.17,0:12:54.17,Default,,0,0,0,,Ууууууу...!
Dialogue: 0,0:12:54.17,0:12:59.17,Default,,0,0,0,,Парасатты қыз Себебі сен ояндың
Dialogue: 0,0:12:59.17,0:13:02.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:02.18,0:13:05.15,Default,,0,0,0,,Неге...
Dialogue: 0,0:13:06.11,0:13:09.12,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:13:09.12,0:13:12.09,Default,,0,0,0,,Ах... Уф.
Dialogue: 0,0:13:13.12,0:13:17.09,Default,,0,0,0,,Не болып жатыр... А?
Dialogue: 0,0:13:27.14,0:13:32.14,Default,,0,0,0,,Мен нені кесіп алдым?
Dialogue: 0,0:13:32.14,0:13:34.11,Default,,0,0,0,,Гиннес! Ха…
Dialogue: 0,0:13:35.14,0:13:37.15,Default,,0,0,0,,Эй, жақсысың ба? Гиннес
Dialogue: 0,0:13:37.15,0:13:39.15,Default,,0,0,0,,Гиннесті ояту!
Dialogue: 0,0:13:39.15,0:13:43.15,Default,,0,0,0,,Уаааааааа...
Dialogue: 0,0:13:43.15,0:13:45.15,Default,,0,0,0,,Гиннес!
Dialogue: 0,0:13:45.15,0:13:47.16,Default,,0,0,0,,Жарайды, Белл.
Dialogue: 0,0:13:47.16,0:13:50.16,Default,,0,0,0,,Өйткені мен жай ғана армандаймын...
Dialogue: 0,0:13:50.16,0:13:52.16,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:13:52.16,0:13:54.16,Default,,0,0,0,,Құдай ағашы көрген армандар➡
Dialogue: 0,0:13:54.16,0:13:59.17,Default,,0,0,0,,Мен сол тастан көргенімдей...
Dialogue: 0,0:13:59.17,0:14:01.14,Default,,0,0,0,,Ах
Dialogue: 0,0:14:04.17,0:14:06.14,Default,,0,0,0,,Не...
Dialogue: 0,0:14:07.11,0:14:10.08,Default,,0,0,0,,Ха... осындай нәрсе...
Dialogue: 0,0:14:12.11,0:14:15.12,Default,,0,0,0,,Әке... не болса да!
Dialogue: 0,0:14:15.12,0:14:18.12,Default,,0,0,0,,Бұл, сөзсіз, Раухид патшасы.
Dialogue: 0,0:14:18.12,0:14:20.12,Default,,0,0,0,,Мен өз денемді Құдай ағашына ұсынамын деп ешқашан ойламадым➡
Dialogue: 0,0:14:20.12,0:14:22.12,Default,,0,0,0,,Сіз оны осылай қайтара аласыз...
Dialogue: 0,0:14:22.12,0:14:24.13,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:14:24.13,0:14:27.13,Default,,0,0,0,,Не? Жоқ, мен жай ғана кесіп алдым...
Dialogue: 0,0:14:27.13,0:14:32.13,Default,,0,0,0,,А... мен білетін әке➡
Dialogue: 0,0:14:32.13,0:14:35.14,Default,,0,0,0,,Соңында мен...
Dialogue: 0,0:14:35.14,0:14:38.14,Default,,0,0,0,,Рахмет сізге Белл
Dialogue: 0,0:14:38.14,0:14:40.14,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:40.14,0:14:42.14,Default,,0,0,0,,Мен...
Dialogue: 0,0:14:42.14,0:14:45.11,Default,,0,0,0,,Тірі басылды, ә...
Dialogue: 0,0:14:47.15,0:14:49.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:49.15,0:14:51.15,Default,,0,0,0,,Адонис!
Dialogue: 0,0:14:51.15,0:14:53.12,Default,,0,0,0,,Иә
Dialogue: 0,0:14:55.16,0:14:59.16,Default,,0,0,0,,Күтілгендей, Нидхогтың қалдықтарын кеспей➡
Dialogue: 0,0:14:59.16,0:15:02.16,Default,,0,0,0,,Болмыстың өзі өмір сүруін тоқтатты ма?
Dialogue: 0,0:15:02.16,0:15:06.10,Default,,0,0,0,,Сенің қарғысың осыны айтады.
Dialogue: 0,0:15:06.10,0:15:09.10,Default,,0,0,0,,Бұл жерде қарғыс батаға айналады.
Dialogue: 0,0:15:09.10,0:15:11.11,Default,,0,0,0,,Сіз нені айтып тұрсыз, Адонис?
Dialogue: 0,0:15:11.11,0:15:14.11,Default,,0,0,0,,Құдай Сөзі әлі аяқталған жоқ (саусақтарды сермеу)
Dialogue: 0,0:15:14.11,0:15:17.11,Default,,0,0,0,,А... Шерри?
Dialogue: 0,0:15:17.11,0:15:21.12,Default,,0,0,0,,Тәңірлік тәртіптегі бұйрық
Dialogue: 0,0:15:21.12,0:15:26.12,Default,,0,0,0,,Құдайдың еркіне қарсы зорлық қылышын ұстағандар➡
Dialogue: 0,0:15:26.12,0:15:30.12,Default,,0,0,0,,Тыйым салынған адам деп есептелді... түрмеде.
Dialogue: 0,0:15:30.12,0:15:32.13,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:32.13,0:15:38.13,Default,,0,0,0,,Сол сияқты илаһи тәртіпті бұзатын өтініштер жасайтындар...
Dialogue: 0,0:15:38.13,0:15:42.14,Default,,0,0,0,,О, Белл А...
Dialogue: 0,0:15:42.14,0:15:44.11,Default,,0,0,0,,Ах! Мұнан кеттік!
Dialogue: 0,0:15:46.14,0:15:49.14,Default,,0,0,0,,Эй, сәл күте тұрыңыз!
Dialogue: 0,0:15:49.14,0:15:54.15,Default,,0,0,0,,Гиннес Сіздің сценарийіңізде бұл мүмкін бе?
Dialogue: 0,0:15:54.15,0:15:56.15,Default,,0,0,0,,Әй, ғафф! бірден бірдеңе жасаңыз
Dialogue: 0,0:15:56.15,0:16:00.12,Default,,0,0,0,,А... әзірше сабыр ет, Белл.
Dialogue: 0,0:16:02.16,0:16:06.09,Default,,0,0,0,,Алдамшы, қылышыңды маған қаратпа!
Dialogue: 0,0:16:06.09,0:16:09.10,Default,,0,0,0,,Жүр, мұнда тыныш бол... Маған қарашы, ғаф!
Dialogue: 0,0:16:09.10,0:16:11.10,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,0:16:11.10,0:16:13.10,Default,,0,0,0,,Әй, Адонис!
Dialogue: 0,0:16:13.10,0:16:15.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:16.10,0:16:18.07,Default,,0,0,0,,Сол қылыш...
Dialogue: 0,0:16:19.11,0:16:21.11,Default,,0,0,0,,Тот басқан тырнақ
Dialogue: 0,0:16:21.11,0:16:23.11,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:23.11,0:16:28.12,Default,,0,0,0,,Гафф Божественный Сөз соғыс жүргізетіндерді арнайы белгілемейді.
Dialogue: 0,0:16:28.12,0:16:30.12,Default,,0,0,0,,Адонис, мырзалар...
Dialogue: 0,0:16:30.12,0:16:35.12,Default,,0,0,0,,Осы қамалдың иесі ретінде маған тезірек бұйрық беріңіз!
Dialogue: 0,0:16:35.12,0:16:39.13,Default,,0,0,0,,Адонис Қоңырауды сізге қалдырамын.
Dialogue: 0,0:16:39.13,0:16:41.13,Default,,0,0,0,,Цукамацуру Анио-ден
Dialogue: 0,0:16:41.13,0:16:44.13,Default,,0,0,0,,Не... Ғафф!
Dialogue: 0,0:16:44.13,0:16:47.10,Default,,0,0,0,,Қоңырау Сіз мені кесіп тастай аласыз ба?
Dialogue: 0,0:16:48.14,0:16:50.10,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:16:55.14,0:17:01.15,Default,,0,0,0,,Сіз біздің не үшін келгенімізді білесіз бе?
Dialogue: 0,0:17:01.15,0:17:06.09,Default,,0,0,0,,Жарайды, бәрі де кеш.
Dialogue: 0,0:17:06.09,0:17:08.09,Default,,0,0,0,,Мен мұны істедім.
Dialogue: 0,0:17:08.09,0:17:11.09,Default,,0,0,0,,Сіз... сіз мұны істедіңіз бе?
Dialogue: 0,0:17:11.09,0:17:13.09,Default,,0,0,0,,Мына шу! Фуфу
Dialogue: 0,0:17:13.09,0:17:15.10,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:17:15.10,0:17:18.10,Default,,0,0,0,,Сен... ақымақ!
Dialogue: 0,0:17:18.10,0:17:20.10,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:17:20.10,0:17:22.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:23.10,0:17:25.11,Default,,0,0,0,,Цк... Уф!
Dialogue: 0,0:17:25.11,0:17:27.11,Default,,0,0,0,,Уф! Ууууууууууууу!
Dialogue: 0,0:17:27.11,0:17:29.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:29.11,0:17:32.11,Default,,0,0,0,,Ха! Ах...
Dialogue: 0,0:17:32.11,0:17:34.08,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:17:35.12,0:17:37.08,Default,,0,0,0,,Уф…
Dialogue: 0,0:17:39.12,0:17:42.12,Default,,0,0,0,,Уау күшті...
Dialogue: 0,0:17:42.12,0:17:46.09,Default,,0,0,0,,Ах... жалаң қолды қылыш...
Dialogue: 0,0:17:50.13,0:17:53.13,Default,,0,0,0,,Бұл қылыш сіздің жауабыңыз ба?
Dialogue: 0,0:17:53.13,0:17:56.14,Default,,0,0,0,,Содан кейін мен...
Dialogue: 0,0:17:56.14,0:17:58.14,Default,,0,0,0,,Хаа!
Dialogue: 0,0:17:58.14,0:18:00.11,Default,,0,0,0,,Ой!
Dialogue: 0,0:18:02.14,0:18:05.15,Default,,0,0,0,,)
Dialogue: 0,0:18:05.15,0:18:09.12,Default,,0,0,0,,Ақыры қылыш шешеді!
Dialogue: 0,0:18:13.09,0:18:15.06,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:18:20.09,0:18:23.06,Default,,0,0,0,,Ах... Уф! Ха…
Dialogue: 0,0:18:24.10,0:18:26.10,Default,,0,0,0,,Ландинг!
Dialogue: 0,0:18:26.10,0:18:29.10,Default,,0,0,0,,Хе, ха, болды...
Dialogue: 0,0:18:29.10,0:18:31.11,Default,,0,0,0,,Ол жаншылған болуы керек!
Dialogue: 0,0:18:31.11,0:18:34.11,Default,,0,0,0,,Мәңгі өшетін қылыш
Dialogue: 0,0:18:34.11,0:18:37.11,Default,,0,0,0,,Рустинердің жүзін жоюға болатын қылыштар, т.б.➡
Dialogue: 0,0:18:37.11,0:18:39.11,Default,,0,0,0,,Бұл дүниеде жоқ!
Dialogue: 0,0:18:39.11,0:18:41.12,Default,,0,0,0,,《Тамақ жедіңіз бе? Сол қылышқа➡
Dialogue: 0,0:18:41.12,0:18:44.12,Default,,0,0,0,,Лундинг күші》 (Тот басқан тырнақтардың жылауы)
Dialogue: 0,0:18:44.12,0:18:47.12,Default,,0,0,0,,Не?
Dialogue: 0,0:18:47.12,0:18:51.13,Default,,0,0,0,,Бір жасаушы жасаған екі қылыш жаңғыруда.
Dialogue: 0,0:18:51.13,0:18:55.13,Default,,0,0,0,,Лундингтің жүзінде, мәңгілік туа беретін қылыш➡
Dialogue: 0,0:18:55.13,0:18:57.13,Default,,0,0,0,,Менің жүзім тартылды
Dialogue: 0,0:18:57.13,0:19:00.13,Default,,0,0,0,,Қат! Уууу
Dialogue: 0,0:19:00.13,0:19:03.14,Default,,0,0,0,,Бұл сіздің қарғысыңыздың шынайы табиғаты ма?
Dialogue: 0,0:19:03.14,0:19:07.07,Default,,0,0,0,,Ақыры қолыңызға сай қылыш таптыңыз!
Dialogue: 0,0:19:07.07,0:19:10.08,Default,,0,0,0,,Сонымен бірге ол бата берудің де бір түрі.
Dialogue: 0,0:19:10.08,0:19:12.05,Default,,0,0,0,,Уф…
Dialogue: 0,0:19:13.08,0:19:16.08,Default,,0,0,0,,Ух... ннн!
Dialogue: 0,0:19:16.08,0:19:18.09,Default,,0,0,0,,Сондай сұмдық қылыш➡
Dialogue: 0,0:19:18.09,0:19:20.09,Default,,0,0,0,,Тіпті Лундингтің ағасы да! ?
Dialogue: 0,0:19:20.09,0:19:22.06,Default,,0,0,0,,Иә
Dialogue: 0,0:19:27.09,0:19:30.10,Default,,0,0,0,,《Неге...》 Ах!
Dialogue: 0,0:19:30.10,0:19:33.10,Default,,0,0,0,,Сонда сіздің қарғысыңыздың түрі солай ма?
Dialogue: 0,0:19:33.10,0:19:35.10,Default,,0,0,0,,Қарғыс атқыр, бұл қиын!
Dialogue: 0,0:19:35.10,0:19:37.10,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:19:37.10,0:19:40.11,Default,,0,0,0,,Мен сені кесіп тастаймын!
Dialogue: 0,0:19:40.11,0:19:44.11,Default,,0,0,0,,Менің бар болмысымды бағындыра аласың ба?
Dialogue: 0,0:19:44.11,0:19:46.11,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:19:46.11,0:19:48.08,Default,,0,0,0,,Ахх...!
Dialogue: 0,0:19:56.12,0:19:59.13,Default,,0,0,0,,Уф, у…
Dialogue: 0,0:19:59.13,0:20:03.13,Default,,0,0,0,,《Адонис…》
Dialogue: 0,0:20:03.13,0:20:06.13,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,0:20:06.13,0:20:08.14,Default,,0,0,0,,А…
Dialogue: 0,0:20:08.14,0:20:10.14,Default,,0,0,0,,A… a… aa
Dialogue: 0,0:20:10.14,0:20:12.14,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:20:12.14,0:20:15.14,Default,,0,0,0,,Тек қылыштың бетпердесін жеңу керек➡
Dialogue: 0,0:20:15.14,0:20:20.11,Default,,0,0,0,,Қылыш жасаушы ұсталарымызға аманат еткен болашақ.
Dialogue: 0,0:20:21.15,0:20:26.15,Default,,0,0,0,,(Тот басқан тырнақтардың айқайы)
Dialogue: 0,0:20:26.15,0:20:28.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:28.16,0:20:30.16,Default,,0,0,0,,Мені көтере алмай➡
Dialogue: 0,0:20:30.16,0:20:34.13,Default,,0,0,0,,Құдайды ұлықтауға бола ма?
Dialogue: 0,0:20:35.16,0:20:37.16,Default,,0,0,0,,Мен өлемін...
Dialogue: 0,0:20:37.16,0:20:39.17,Default,,0,0,0,,《Кім? Не? 》
Dialogue: 0,0:20:39.17,0:20:42.17,Default,,0,0,0,,《Бұл қылыш. Қылыш... өледі.》
Dialogue: 0,0:20:42.17,0:20:44.17,Default,,0,0,0,,иә...
Dialogue: 0,0:20:44.17,0:20:49.18,Default,,0,0,0,,《Оны жоғалтып алсам, үмітсіздіктен өлемін》
Dialogue: 0,0:20:49.18,0:20:53.18,Default,,0,0,0,,《Мен сынамын》
Dialogue: 0,0:20:53.18,0:20:56.15,Default,,0,0,0,,Парасатты қыз! Ха…
Dialogue: 0,0:20:58.19,0:21:01.16,Default,,0,0,0,,А, сен...
Dialogue: 0,0:21:02.19,0:21:05.19,Default,,0,0,0,,(Тот басқан қылыштың зары)
Dialogue: 0,0:21:05.19,0:21:16.14,Default,,0,0,0,,(Аштық Одағының айқайы)
Dialogue: 0,0:21:16.14,0:21:18.14,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:18.14,0:21:20.14,Default,,0,0,0,,Уф…
Dialogue: 0,0:21:20.14,0:21:23.11,Default,,0,0,0,,Адонис!
Dialogue: 0,0:21:25.15,0:21:27.15,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:27.15,0:21:30.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:42.16,0:21:44.13,Default,,0,0,0,,《Саяхатта...》
Dialogue: 0,0:21:49.17,0:21:54.14,Default,,0,0,0,,《Бірге саяхатқа шығайық...》
Dialogue: 0,0:22:05.19,0:22:25.14,Default,,0,0,0,,♬～
Dialogue: 0,0:22:25.14,0:22:45.16,Default,,0,0,0,,♬～
