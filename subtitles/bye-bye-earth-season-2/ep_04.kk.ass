Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.17,0:00:09.17,Default,,0,0,0,,Осы қылышта мен бәрін сұраймын
Dialogue: 0,0:00:09.17,0:00:12.17,Default,,0,0,0,,Басты рөлді шешуге ерік-жігер!
Dialogue: 0,0:00:12.17,0:00:16.14,Default,,0,0,0,,Патша мен еркектің арасында шешім қабылдай алатын адам бар ма?
Dialogue: 0,0:00:21.18,0:00:25.19,Default,,0,0,0,,Патша мен оның семсері осымен шешілді.
Dialogue: 0,0:00:25.19,0:00:29.19,Default,,0,0,0,,Мен де осы Құдай ағашында тұрамын.
Dialogue: 0,0:00:29.19,0:00:32.16,Default,,0,0,0,,Қарт патша өлді!
Dialogue: 0,0:00:38.20,0:00:42.20,Default,,0,0,0,,Мен патшамын!
Dialogue: 0,0:00:42.20,0:00:44.21,Default,,0,0,0,,(Қылышшылардың дауысы)
Dialogue: 0,0:00:44.21,0:00:48.21,Default,,0,0,0,,《Бұл тәртіп, Белл. Тапсырыс әрекет етуде.》
Dialogue: 0,0:00:48.21,0:00:50.21,Default,,0,0,0,,《Барлық адамдар➡
Dialogue: 0,0:00:50.21,0:00:54.22,Default,,0,0,0,,Құдай берген рөлді ойнау деген сөз.
Dialogue: 0,0:00:54.22,0:00:56.22,Default,,0,0,0,,《Мен патшаның рөлін ойнаймын➡
Dialogue: 0,0:00:56.22,0:00:59.22,Default,,0,0,0,,Бар болмысымызбен өнер көрсетейік.
Dialogue: 0,0:00:59.22,0:01:02.16,Default,,0,0,0,,《Қоңырау, сен үшін Құдайдың рөлі➡
Dialogue: 0,0:01:02.16,0:01:05.13,Default,,0,0,0,,Бұл шешім қабылданды.
Dialogue: 0,0:01:06.16,0:01:08.16,Default,,0,0,0,,《Сені кесіп тастауға рұқсат етпе》
Dialogue: 0,0:01:08.16,0:01:10.13,Default,,0,0,0,,Ха…
Dialogue: 0,0:01:12.17,0:01:15.17,Default,,0,0,0,,Құдалық бақсы ретінде сөзді жеткізу
Dialogue: 0,0:01:15.17,0:01:17.17,Default,,0,0,0,,《Құдай сөзі! ? 》
Dialogue: 0,0:01:17.17,0:01:22.18,Default,,0,0,0,,Оны жаңа патшаның жарлығы ретінде табыңыз.
Dialogue: 0,0:01:22.18,0:01:24.18,Default,,0,0,0,,Саяхаттың кілті
Dialogue: 0,0:01:24.18,0:01:29.18,Default,,0,0,0,,《Ха, Шерри, сен бұл илаһи хабарды естімедің бе? 》
Dialogue: 0,0:01:29.18,0:01:32.19,Default,,0,0,0,,Оны жойыңыз 《Ха》
Dialogue: 0,0:01:32.19,0:01:37.19,Default,,0,0,0,,Кілт - қара уақыт пен қара бағыт.
Dialogue: 0,0:01:37.19,0:01:40.20,Default,,0,0,0,,Оны таба алатын адам➡
Dialogue: 0,0:01:40.20,0:01:44.20,Default,,0,0,0,,Тақты аға ғана ұстай алады.
Dialogue: 0,0:01:44.20,0:01:48.20,Default,,0,0,0,,Саяхаттың кілтін жойыңыз
Dialogue: 0,0:01:48.20,0:02:06.15,Default,,0,0,0,,♬～
Dialogue: 0,0:02:06.15,0:02:10.16,Default,,0,0,0,,♬～
Dialogue: 0,0:02:10.16,0:02:30.18,Default,,0,0,0,,♬～
Dialogue: 0,0:02:30.18,0:02:50.20,Default,,0,0,0,,♬～
Dialogue: 0,0:02:50.20,0:03:10.15,Default,,0,0,0,,♬～
Dialogue: 0,0:03:10.15,0:03:18.13,Default,,0,0,0,,♬～
Dialogue: 0,0:03:19.16,0:03:22.16,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:03:22.16,0:03:26.17,Default,,0,0,0,,⚟ (қоңырау дыбысы)
Dialogue: 0,0:03:26.17,0:03:28.14,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:30.17,0:03:32.17,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:03:32.17,0:03:34.18,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:03:34.18,0:03:36.18,Default,,0,0,0,,Адонис…
Dialogue: 0,0:03:36.18,0:03:40.18,Default,,0,0,0,,Қылыш қалдықтарын құшақтап, жібермеймін
Dialogue: 0,0:03:40.18,0:03:43.19,Default,,0,0,0,,Сол көрініс бәрін айтып береді
Dialogue: 0,0:03:43.19,0:03:46.19,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:03:46.19,0:03:48.19,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:03:48.19,0:03:50.19,Default,,0,0,0,,Уф…
Dialogue: 0,0:03:50.19,0:03:52.19,Default,,0,0,0,,Маған тиіспе!
Dialogue: 0,0:03:52.19,0:03:55.20,Default,,0,0,0,,Мен де, Лундинг те әлі өлген жоқпын!
Dialogue: 0,0:03:55.20,0:03:58.17,Default,,0,0,0,,Ақырында толығымен ыдырайтын болады
Dialogue: 0,0:04:00.20,0:04:03.14,Default,,0,0,0,,Көлеңкеден өз күшіңізді босатыңыз
Dialogue: 0,0:04:03.14,0:04:05.14,Default,,0,0,0,,(Юки) Қыз ба? (Миямура) Ұл ба?
Dialogue: 0,0:04:05.14,0:04:09.14,Default,,0,0,0,,Ха, қасиетті күл? ...жоқ
Dialogue: 0,0:04:09.14,0:04:11.15,Default,,0,0,0,,Қылыштарды қосу үшін...
Dialogue: 0,0:04:11.15,0:04:13.15,Default,,0,0,0,,Сынақшының күлі
Dialogue: 0,0:04:13.15,0:04:16.15,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:04:16.15,0:04:21.16,Default,,0,0,0,,Неге еліктейсің, Адонис? Осындай нәрсені әкеліңіз!
Dialogue: 0,0:04:21.16,0:04:24.16,Default,,0,0,0,,Мына ақымақ...
Dialogue: 0,0:04:24.16,0:04:27.13,Default,,0,0,0,,Сізді күтуде
Dialogue: 0,0:04:31.17,0:04:33.17,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:04:33.17,0:04:37.17,Default,,0,0,0,,Сіз оны әлі тапмадыңыз ба? (Дін қызметкері) Кешіріңіз.
Dialogue: 0,0:04:37.17,0:04:39.17,Default,,0,0,0,,Қылыш тобына жауаптылардан басқа кез келген адам➡
Dialogue: 0,0:04:39.17,0:04:42.18,Default,,0,0,0,,Осы миссияға барлық діни қызметкерлерді тағайындаңыз.
Dialogue: 0,0:04:42.18,0:04:44.18,Default,,0,0,0,,Га
Dialogue: 0,0:04:44.18,0:04:47.18,Default,,0,0,0,,《Қара уақыт, қара бағыт》
Dialogue: 0,0:04:47.18,0:04:52.19,Default,,0,0,0,,《Сенбеймін, қамалда тұратын біздер оны таба алмай жатырмыз...》
Dialogue: 0,0:04:52.19,0:04:57.19,Default,,0,0,0,,《Бірақ оны тапқаннан кейін ше? Мен жолдың кілтін сындырамын ба? 》
Dialogue: 0,0:04:57.19,0:04:59.19,Default,,0,0,0,,《Не үшін...》
Dialogue: 0,0:04:59.19,0:05:01.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:01.13,0:05:03.13,Default,,0,0,0,,Адонис Сіз қазір қозғала аласыз ба?
Dialogue: 0,0:05:03.13,0:05:05.13,Default,,0,0,0,,Әлі бес минут қалды.
Dialogue: 0,0:05:05.13,0:05:08.14,Default,,0,0,0,,Мен сізге Белл туралы бәрін қалдырдым.
Dialogue: 0,0:05:08.14,0:05:10.14,Default,,0,0,0,,Бұл қиын рөл болса керек...
Dialogue: 0,0:05:10.14,0:05:12.14,Default,,0,0,0,,Сәлем Гафф
Dialogue: 0,0:05:12.14,0:05:15.14,Default,,0,0,0,,Катакомб қылышын патшаның жерлеу рәсіміне әкеле аласыз ба?
Dialogue: 0,0:05:15.14,0:05:17.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:17.15,0:05:20.15,Default,,0,0,0,,Оның орнына мен інім патшаны қабылдай аламын.
Dialogue: 0,0:05:20.15,0:05:23.15,Default,,0,0,0,,Мырза, сіз қылышты қайтаруды жоспарлап отырсыз ба?
Dialogue: 0,0:05:23.15,0:05:26.15,Default,,0,0,0,,Осы уақытқа дейін ұрланған барлық қылыштар
Dialogue: 0,0:05:26.15,0:05:31.16,Default,,0,0,0,,Бұл мүмкін, мен бұл елге қарсымын➡
Dialogue: 0,0:05:31.16,0:05:34.16,Default,,0,0,0,,Бұл сіздің соңғы күмәніңізді сұрауға мүмкіндік болады.
Dialogue: 0,0:05:34.16,0:05:37.17,Default,,0,0,0,,Қалай ойлайсың, мен мұндай нәрсені кешіре аламын ба?
Dialogue: 0,0:05:37.17,0:05:40.17,Default,,0,0,0,,Мен сіздің скептицизміңізді қабылдаймын.
Dialogue: 0,0:05:40.17,0:05:43.17,Default,,0,0,0,,Тәртіптің күңгірт жағын түсініңіз.
Dialogue: 0,0:05:43.17,0:05:48.14,Default,,0,0,0,,Сіз сенімді боласыз және жарқыраған бөліктің даңқына бөлене аласыз.
Dialogue: 0,0:06:00.19,0:06:02.12,Default,,0,0,0,,Сіз бұзылмайтынсыз ба?
Dialogue: 0,0:06:02.12,0:06:04.09,Default,,0,0,0,,Ах
Dialogue: 0,0:06:08.13,0:06:13.13,Default,,0,0,0,,Шерри ханшайым, күн сайын сауығу туралы ән айтудан шаршағаныңызға сенімдімін.
Dialogue: 0,0:06:13.13,0:06:17.14,Default,,0,0,0,,Неліктен Беллмен соғыстың?
Dialogue: 0,0:06:17.14,0:06:21.14,Default,,0,0,0,,Егер біреу Беллді түрмеге отырғызу керек болса➡
Dialogue: 0,0:06:21.14,0:06:23.14,Default,,0,0,0,,Мұны істейтін менмін.
Dialogue: 0,0:06:23.14,0:06:26.15,Default,,0,0,0,,Неліктен Белл екеуің төбелесулерің керек?
Dialogue: 0,0:06:26.15,0:06:28.15,Default,,0,0,0,,Иә? Ха...
Dialogue: 0,0:06:28.15,0:06:31.15,Default,,0,0,0,,Хахаха хахахаха
Dialogue: 0,0:06:31.15,0:06:33.15,Default,,0,0,0,,Сен маған ұқсайсың
Dialogue: 0,0:06:33.15,0:06:35.16,Default,,0,0,0,,Алдамаңыз! Хахахахахаха...!
Dialogue: 0,0:06:35.16,0:06:38.16,Default,,0,0,0,,Сіз Беллдің сезімі туралы ойладыңыз ба? ?
Dialogue: 0,0:06:38.16,0:06:41.16,Default,,0,0,0,,Ахахаха хахаха
Dialogue: 0,0:06:41.16,0:06:43.16,Default,,0,0,0,,Мен тоқтай алмаймын!
Dialogue: 0,0:06:43.16,0:06:45.17,Default,,0,0,0,,Неге күлесің? Уууу...
Dialogue: 0,0:06:45.17,0:06:49.17,Default,,0,0,0,,Өкініштісі, мен осындаймын.
Dialogue: 0,0:06:49.17,0:06:55.18,Default,,0,0,0,,Сіз... Беллмен күрескеніңізге өкінесіз бе?
Dialogue: 0,0:06:55.18,0:06:59.18,Default,,0,0,0,,Өкініп, жыла алсам, бәрібір өзімді жақсы сезінемін.
Dialogue: 0,0:06:59.18,0:07:01.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:01.12,0:07:05.12,Default,,0,0,0,,Сіз тек Құдайға деген күмәніңізді маған көрсетіп жатырсыз.
Dialogue: 0,0:07:05.12,0:07:07.12,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:07.12,0:07:12.13,Default,,0,0,0,,Сіз маған берген илаһи хабар бойынша мен Беллге қарсы күрестім.
Dialogue: 0,0:07:12.13,0:07:16.13,Default,,0,0,0,,Аузыңды жап! Мен бұл туралы енді айтқым келмейді.
Dialogue: 0,0:07:16.13,0:07:19.13,Default,,0,0,0,,А...
Dialogue: 0,0:07:19.13,0:07:23.14,Default,,0,0,0,,Шерри, мен сенің күмәнділігіңді естігім келеді.
Dialogue: 0,0:07:23.14,0:07:25.14,Default,,0,0,0,,Мен не айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:07:25.14,0:07:27.14,Default,,0,0,0,,Сіз өзіңіз, осы ел, т.б.➡
Dialogue: 0,0:07:27.14,0:07:30.15,Default,,0,0,0,,Менде күмәнданатыным сонша, ол жай ғана жоғалып кетсе екен.
Dialogue: 0,0:07:30.15,0:07:32.15,Default,,0,0,0,,Не!
Dialogue: 0,0:07:32.15,0:07:34.15,Default,,0,0,0,,Тәртіптің көлеңкесін қабылдаңыз
Dialogue: 0,0:07:34.15,0:07:36.15,Default,,0,0,0,,Жібер!
Dialogue: 0,0:07:36.15,0:07:40.16,Default,,0,0,0,,Сіз өзіңізді құрбан етуге дайынсыз ба?
Dialogue: 0,0:07:40.16,0:07:44.16,Default,,0,0,0,,Менің шығу тегім сол жерде.
Dialogue: 0,0:07:44.16,0:07:47.16,Default,,0,0,0,,Себебі сен Беллмен төбелескенсің➡
Dialogue: 0,0:07:47.16,0:07:49.16,Default,,0,0,0,,Олар бірдей ме?
Dialogue: 0,0:07:49.16,0:07:52.17,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:52.17,0:07:56.17,Default,,0,0,0,,Мен Құдайдың өз халқына деген сүйіспеншілігін жақсы көремін➡
Dialogue: 0,0:07:56.17,0:07:59.17,Default,,0,0,0,,Менің күмәнім бар
Dialogue: 0,0:07:59.17,0:08:03.11,Default,,0,0,0,,Адамдардың бақытына алдын ала белгіленген келісімге қол жеткізу арқылы қол жеткізуге болады➡
Dialogue: 0,0:08:03.11,0:08:07.12,Default,,0,0,0,,Құдай өз халқын жақсы көретіндіктен деп ойлаймын.
Dialogue: 0,0:08:07.12,0:08:09.12,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:09.12,0:08:12.12,Default,,0,0,0,,Маған Белл және басқалары тұтқынға алынды➡
Dialogue: 0,0:08:12.12,0:08:15.12,Default,,0,0,0,,Мен махаббатты сезінбеймін
Dialogue: 0,0:08:15.12,0:08:18.13,Default,,0,0,0,,Бұл ғана емес, осы уақытқа дейін бәрі...
Dialogue: 0,0:08:18.13,0:08:23.13,Default,,0,0,0,,Сіз құлыпта Құдайдың сөзін еститін жалғыз адамсыз➡
Dialogue: 0,0:08:23.13,0:08:27.14,Default,,0,0,0,,Құдайдың ең жақсы көретінін білдірмейді.
Dialogue: 0,0:08:27.14,0:08:29.14,Default,,0,0,0,,А... Меніңше, сенің күдігің осы шығар.
Dialogue: 0,0:08:29.14,0:08:31.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:32.14,0:08:35.14,Default,,0,0,0,,Ханшайым ретінде бұл сөзді ешқашан айтпау керек.
Dialogue: 0,0:08:35.14,0:08:38.15,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:08:38.15,0:08:40.15,Default,,0,0,0,,Мен бұл скептицизмді қабылдаймын➡
Dialogue: 0,0:08:40.15,0:08:44.12,Default,,0,0,0,,Барлық күмәніңізді тікелей Құдайдан сұраңыз
Dialogue: 0,0:08:45.15,0:08:48.16,Default,,0,0,0,,Мен сізге әнші ретінде өтініш білдіргім келеді.
Dialogue: 0,0:08:48.16,0:08:53.16,Default,,0,0,0,,Менің шығу тегімді білуге ​​мүмкіндік беруіңізді қалаймын.
Dialogue: 0,0:08:53.16,0:08:55.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:57.17,0:08:59.13,Default,,0,0,0,,Иә...
Dialogue: 0,0:09:08.11,0:09:11.11,Default,,0,0,0,,⚟ (Шикі тері патшасы) Қара қарашы, о
Dialogue: 0,0:09:11.11,0:09:15.12,Default,,0,0,0,,⚟ (Шикі тері патшасы) Қара түс кез келген бағытта, кез келген уақытта ➡
Dialogue: 0,0:09:15.12,0:09:17.12,Default,,0,0,0,,Бұл сәйкес емес түс.
Dialogue: 0,0:09:17.12,0:09:19.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:19.12,0:09:22.12,Default,,0,0,0,,⚟ (Шикі тері патшасы) Керісінше, кез келген бағытта, кез келген уақытта ➡
Dialogue: 0,0:09:22.12,0:09:25.13,Default,,0,0,0,,Бұл да қайтарылатын түс.
Dialogue: 0,0:09:25.13,0:09:29.13,Default,,0,0,0,,⚟Қара барлық регрессияның соңында➡
Dialogue: 0,0:09:29.13,0:09:33.13,Default,,0,0,0,,Аяқтау мен басын қатар хабарлау
Dialogue: 0,0:09:33.13,0:09:35.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:36.14,0:09:38.11,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:42.14,0:09:44.15,Default,,0,0,0,,(Танжиро) Тұр, тұр! Тоқта, Иносукэ~!
Dialogue: 0,0:09:44.15,0:09:48.15,Default,,0,0,0,,⚟ (Шикі тері патшасы) Құпияны тек патша біледі➡
Dialogue: 0,0:09:48.15,0:09:52.15,Default,,0,0,0,,Қара бағыт Қара уақытты анықтау
Dialogue: 0,0:09:52.15,0:09:55.16,Default,,0,0,0,,Неге... неге бұл мен болуым керек!
Dialogue: 0,0:09:55.16,0:09:57.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:57.16,0:10:01.16,Default,,0,0,0,,⚟ (Шикі тері патшасы) Құдайдың соқыр дағы... Қара
Dialogue: 0,0:10:01.16,0:10:05.17,Default,,0,0,0,,⚟Кілтті табыңыз
Dialogue: 0,0:10:05.17,0:10:08.17,Default,,0,0,0,,⚟Өйткені Құдай олардың соқыр жері➡
Dialogue: 0,0:10:08.17,0:10:12.17,Default,,0,0,0,,Жоюға ниеттену алдында
Dialogue: 0,0:10:12.17,0:10:15.18,Default,,0,0,0,,⚟Жаңа патша
Dialogue: 0,0:10:15.18,0:10:18.18,Default,,0,0,0,,Ха... неге мен...
Dialogue: 0,0:10:18.18,0:10:20.18,Default,,0,0,0,,Шикі тері патшасы!
Dialogue: 0,0:10:20.18,0:10:22.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:25.19,0:10:29.19,Default,,0,0,0,,Ха, не... түрме?
Dialogue: 0,0:10:29.19,0:10:32.16,Default,,0,0,0,,⚟(шу) Ах.
Dialogue: 0,0:10:37.20,0:10:41.20,Default,,0,0,0,,Эй, бәрі реттелген сияқты, Беннетт.
Dialogue: 0,0:10:41.20,0:10:44.21,Default,,0,0,0,,Әй, сен ояндың ба?
Dialogue: 0,0:10:44.21,0:10:47.21,Default,,0,0,0,,Жағдайды түсіндіру қажет емес пе?
Dialogue: 0,0:10:47.21,0:10:49.21,Default,,0,0,0,,Байланыс жоспарланғандай ма?
Dialogue: 0,0:10:49.21,0:10:53.21,Default,,0,0,0,,Дерлік, бірақ қазір мен қылышшыларды жинап жатырмын➡
Dialogue: 0,0:10:53.21,0:10:55.22,Default,,0,0,0,,Бұл қауіпті емес пе?
Dialogue: 0,0:10:55.22,0:10:58.22,Default,,0,0,0,,Төтенше жағдайда, Тұманға хабарласыңыз...
Dialogue: 0,0:10:58.22,0:11:00.19,Default,,0,0,0,,Ах
Dialogue: 0,0:11:01.16,0:11:03.12,Default,,0,0,0,,А...
Dialogue: 0,0:11:06.16,0:11:08.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:11.17,0:11:14.17,Default,,0,0,0,,А... (Байланыс: Беннетт) Не болды, Гиннес?
Dialogue: 0,0:11:14.17,0:11:17.14,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:11:20.17,0:11:22.14,Default,,0,0,0,,Біртүрлі...
Dialogue: 0,0:11:26.18,0:11:29.15,Default,,0,0,0,,Ол менің қолымда
Dialogue: 0,0:11:32.19,0:11:35.19,Default,,0,0,0,,Сіз нені айтасыз? (Сат алмасу: Беннетт) Не?
Dialogue: 0,0:11:35.19,0:11:39.19,Default,,0,0,0,,Қазір бұл қалада бізді бейтаныс адамдардай қабылдайды.
Dialogue: 0,0:11:39.19,0:11:42.20,Default,,0,0,0,,Бұл түрме де Құдайдың соқыр жері.
Dialogue: 0,0:11:42.20,0:11:45.20,Default,,0,0,0,,Бәлкім, Құдайдың бұл идеясының өзі... (Сәйкестік: Беннетт) Сіз не туралы айтып отырсыз?
Dialogue: 0,0:11:45.20,0:11:47.20,Default,,0,0,0,,Бұл аңыз заманнан бері келе жатыр... (Байланыс: Беннетт) Бұл қорқынышты.
Dialogue: 0,0:11:47.20,0:11:50.21,Default,,0,0,0,,Бұл ең үлкен сиқырлы белгі. (Сат алмасу: Беннетт) Онда біреу бар ма?
Dialogue: 0,0:11:50.21,0:11:53.21,Default,,0,0,0,,Бірақ біздің жетілмегендігімізден➡
Dialogue: 0,0:11:53.21,0:11:57.21,Default,,0,0,0,,Құдайдың сиқыры берілістің ішінде мөрленді.
Dialogue: 0,0:11:57.21,0:11:59.21,Default,,0,0,0,,Біз не істеуіміз керек➡
Dialogue: 0,0:11:59.21,0:12:03.15,Default,,0,0,0,,Құдайды болмыс қамытынан босату.
Dialogue: 0,0:12:03.15,0:12:05.15,Default,,0,0,0,,Сосын бір күні боламыз➡
Dialogue: 0,0:12:05.15,0:12:07.16,Default,,0,0,0,,Құдайға ие болу құқығы➡
Dialogue: 0,0:12:07.16,0:12:10.16,Default,,0,0,0,,Бәрінен бас тартатын кез келді!
Dialogue: 0,0:12:10.16,0:12:16.16,Default,,0,0,0,,Гиннес Қазір есіңді жоғалтсаң, маған не болады?
Dialogue: 0,0:12:16.16,0:12:18.13,Default,,0,0,0,,Ах
Dialogue: 0,0:12:20.17,0:12:24.14,Default,,0,0,0,,Белл, сіз мұны қабылдамайсыз.
Dialogue: 0,0:12:25.17,0:12:30.14,Default,,0,0,0,,Мен ол жерден ешкімнің көмегінсіз кетемін.
Dialogue: 0,0:12:31.18,0:12:35.18,Default,,0,0,0,,Қоңырау Бұл жолдың қиылысы.
Dialogue: 0,0:12:35.18,0:12:39.15,Default,,0,0,0,,Сіз және біз
Dialogue: 0,0:12:45.19,0:12:47.20,Default,,0,0,0,,Барлық уақыттағы патшалар
Dialogue: 0,0:12:47.20,0:12:52.20,Default,,0,0,0,,Ал Құдайдың ішкі әлемінде өмір сүретін батыр рухтар.
Dialogue: 0,0:12:52.20,0:12:57.21,Default,,0,0,0,,Маған қарапайымдылығымды бұзып, сізге тікелей хабарласуға рұқсат етіңіз.
Dialogue: 0,0:12:57.21,0:13:02.18,Default,,0,0,0,,Сізден тікелей сұраудан басқа амалым жоқ.
Dialogue: 0,0:13:04.15,0:13:06.15,Default,,0,0,0,,Неліктен Құдай➡
Dialogue: 0,0:13:06.15,0:13:10.15,Default,,0,0,0,,Сен маған Катакомбадан бұл қылышты алуды бұйырдың ба?
Dialogue: 0,0:13:10.15,0:13:14.16,Default,,0,0,0,,Мен бұл қылышты інім патшаға бере аламын ба?
Dialogue: 0,0:13:14.16,0:13:17.16,Default,,0,0,0,,Катакомбаның ұрпағы болған адамға.
Dialogue: 0,0:13:17.16,0:13:20.16,Default,,0,0,0,,Және тағы да кілт неде?
Dialogue: 0,0:13:20.16,0:13:22.16,Default,,0,0,0,,Бұл жердің қай жері?
Dialogue: 0,0:13:22.16,0:13:24.17,Default,,0,0,0,,Түсінбеуіңіз таңқаларлық емес.
Dialogue: 0,0:13:24.17,0:13:28.17,Default,,0,0,0,,Ах... Көгілдір!
Dialogue: 0,0:13:28.17,0:13:32.17,Default,,0,0,0,,Әй... Біраз уақыт болды, Ғафф.
Dialogue: 0,0:13:32.17,0:13:35.18,Default,,0,0,0,,Ол әлі тірі еді.
Dialogue: 0,0:13:35.18,0:13:38.18,Default,,0,0,0,,Сіз Құдайдың хабарын естідіңіз бе?
Dialogue: 0,0:13:38.18,0:13:43.18,Default,,0,0,0,,Бірақ Құдай сөзіне соқыр мойынсұну патшаның жалғыз міндеті емес.
Dialogue: 0,0:13:43.18,0:13:47.19,Default,,0,0,0,,Көгілдір! Аллаға көбірек құл болғандар➡
Dialogue: 0,0:13:47.19,0:13:52.19,Default,,0,0,0,,Маған халқыма патша бола алатынымды үйреткен сен емес пе едің?
Dialogue: 0,0:13:52.19,0:13:54.20,Default,,0,0,0,,Неліктен біз Құдай Сөзіне мән береміз?
Dialogue: 0,0:13:54.20,0:13:56.20,Default,,0,0,0,,Мен...!
Dialogue: 0,0:13:56.20,0:14:01.14,Default,,0,0,0,,Мен бұрын Құдай сөзін естіген емеспін.
Dialogue: 0,0:14:01.14,0:14:05.14,Default,,0,0,0,,Мен Құдайдың бар екенін ешқашан сезінген емеспін.
Dialogue: 0,0:14:05.14,0:14:08.14,Default,,0,0,0,,Онсыз ол не үшін болар еді?➡
Dialogue: 0,0:14:08.14,0:14:10.14,Default,,0,0,0,,Мен осы сарайдың иесі болып туып-өстім.
Dialogue: 0,0:14:10.14,0:14:12.15,Default,,0,0,0,,Бірақ қазір емес!
Dialogue: 0,0:14:12.15,0:14:16.15,Default,,0,0,0,,Мен шынымен патша болу біліктілігін алдым.
Dialogue: 0,0:14:16.15,0:14:19.15,Default,,0,0,0,,Осы илаһи хабармен, ақырында!
Dialogue: 0,0:14:19.15,0:14:24.16,Default,,0,0,0,,Балам, енді сені ілімімнің қамытынан босататын кез.
Dialogue: 0,0:14:24.16,0:14:26.16,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:14:26.16,0:14:29.16,Default,,0,0,0,,Сізді байланыстыратын сол себептік тізбек➡
Dialogue: 0,0:14:29.16,0:14:33.17,Default,,0,0,0,,Уақыт өте келе менің орнымды басқаратын адамның қылышы оны кесіп тастайды.
Dialogue: 0,0:14:33.17,0:14:38.17,Default,,0,0,0,,Қазір көптеген адамдар Құдайдың даусын естімей өмір сүреді.
Dialogue: 0,0:14:38.17,0:14:41.18,Default,,0,0,0,,Бұл туралы мұқият ойланыңыз.
Dialogue: 0,0:14:41.18,0:14:44.18,Default,,0,0,0,,Сіз патшасыз
Dialogue: 0,0:14:44.18,0:14:47.15,Default,,0,0,0,,Қоштасу Ғафф
Dialogue: 0,0:14:50.18,0:14:54.16,Default,,0,0,0,,Мен патшамын...
Dialogue: 0,0:15:02.13,0:15:06.10,Default,,0,0,0,,Хм, құдай-ау, қашуға тым кеш болдым.
Dialogue: 0,0:15:08.14,0:15:10.14,Default,,0,0,0,,Сізге айтылды
Dialogue: 0,0:15:10.14,0:15:14.14,Default,,0,0,0,,Құсты сайратпай торға салу
Dialogue: 0,0:15:14.14,0:15:19.15,Default,,0,0,0,,Еліміздегі алауыздықты ауыздықтаудың жалғыз жолы осы.
Dialogue: 0,0:15:19.15,0:15:24.15,Default,,0,0,0,,Бірақ сонымен бірге әлемдік үстемдікке жаңа амбиция➡
Dialogue: 0,0:15:24.15,0:15:26.15,Default,,0,0,0,,Ұзын құлақты руға бердім.
Dialogue: 0,0:15:26.15,0:15:28.16,Default,,0,0,0,,Тағдырыңды қайғыру➡
Dialogue: 0,0:15:28.16,0:15:32.16,Default,,0,0,0,,Адам болу – мәртебе, Ханзада.
Dialogue: 0,0:15:32.16,0:15:35.16,Default,,0,0,0,,Күлуді тоқтат! Бұл мені өлтіре жаздады!
Dialogue: 0,0:15:35.16,0:15:40.17,Default,,0,0,0,,Кішкентай құсты аңдып тұрған жыланды ақыры қабылдадыңыз.
Dialogue: 0,0:15:40.17,0:15:45.17,Default,,0,0,0,,Мені басқаратын қырағы көз сені қауіп ретінде көреді.
Dialogue: 0,0:15:45.17,0:15:50.18,Default,,0,0,0,,Енді маған сағатты шынымен ашудың құпиясы берілді.
Dialogue: 0,0:15:50.18,0:15:53.18,Default,,0,0,0,,Барлығы сіз күткендей болды
Dialogue: 0,0:15:53.18,0:15:55.18,Default,,0,0,0,,Бұл мені қанша ашуландырса!
Dialogue: 0,0:15:55.18,0:15:58.19,Default,,0,0,0,,Ал, келіңдер.
Dialogue: 0,0:15:58.19,0:16:02.12,Default,,0,0,0,,Сені өз қолыммен сүрткенімді қалайсың ба?
Dialogue: 0,0:16:02.12,0:16:06.13,Default,,0,0,0,,Сіз өзіңіздің студенттеріңізге кез келген уақытта осындай міндеттемелерді жүктейсіз.
Dialogue: 0,0:16:06.13,0:16:08.13,Default,,0,0,0,,Олай болса, жауап берейік.
Dialogue: 0,0:16:08.13,0:16:10.13,Default,,0,0,0,,Мен де, тиындар елінде➡
Dialogue: 0,0:16:10.13,0:16:13.13,Default,,0,0,0,,Өйткені мен сенің шәкіртің болдым
Dialogue: 0,0:16:13.13,0:16:16.14,Default,,0,0,0,,Ей, күннің қанаттары!
Dialogue: 0,0:16:16.14,0:16:18.14,Default,,0,0,0,,Менің қолымда➡
Dialogue: 0,0:16:18.14,0:16:21.14,Default,,0,0,0,,Сіздің жарқыраған қаныңыздың табақшасы көтерілді.
Dialogue: 0,0:16:21.14,0:16:24.15,Default,,0,0,0,,Ежелден аспанға саяхат➡
Dialogue: 0,0:16:24.15,0:16:27.15,Default,,0,0,0,,Күннің жарығы мен жылуын басқаратын Құдай
Dialogue: 0,0:16:27.15,0:16:32.15,Default,,0,0,0,,Құдайдың от тамшысын осында және қазір тастаңыз!
Dialogue: 0,0:16:32.15,0:16:35.16,Default,,0,0,0,,Тек ақылды қыз!
Dialogue: 0,0:16:35.16,0:16:39.16,Default,,0,0,0,,Менің елімнен және әлемнің барлық елдерінен➡
Dialogue: 0,0:16:39.16,0:16:43.16,Default,,0,0,0,,Бедеулік пен тоқырауды не жояды?
Dialogue: 0,0:16:43.16,0:16:45.17,Default,,0,0,0,,Мен Беллге тілеймін
Dialogue: 0,0:16:45.17,0:16:48.17,Default,,0,0,0,,Барлық құдайлық күштер мәңгілікке жоғалады➡
Dialogue: 0,0:16:48.17,0:16:53.14,Default,,0,0,0,,Қақтығысты тамырынан басу үшін!
Dialogue: 0,0:16:54.18,0:16:56.14,Default,,0,0,0,,Ах
Dialogue: 0,0:16:57.18,0:16:59.18,Default,,0,0,0,,Ооо... Ооо!
Dialogue: 0,0:16:59.18,0:17:02.12,Default,,0,0,0,,Бұл ежелгі құдайлардың мұрасы
Dialogue: 0,0:17:02.12,0:17:04.12,Default,,0,0,0,,Орнатушы
Dialogue: 0,0:17:04.12,0:17:06.12,Default,,0,0,0,,Уф, у…
Dialogue: 0,0:17:06.12,0:17:09.09,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:17:10.12,0:17:13.13,Default,,0,0,0,,Сіз құдайдың күшін бұза аласыз ба?
Dialogue: 0,0:17:13.13,0:17:16.13,Default,,0,0,0,,Ақылдың қызына бәрін аманат еткен саған
Dialogue: 0,0:17:16.13,0:17:19.13,Default,,0,0,0,,Дәл солай. Не?
Dialogue: 0,0:17:19.13,0:17:23.14,Default,,0,0,0,,Ханзада құдайларды жоюды ойлап жүргенде➡
Dialogue: 0,0:17:23.14,0:17:27.14,Default,,0,0,0,,Осылайша біз Құдайдан басқа ешкімнің күшін пайдаланамыз.➡
Dialogue: 0,0:17:27.14,0:17:31.15,Default,,0,0,0,,Себеп болған қызды қауіп төндірдім.
Dialogue: 0,0:17:31.15,0:17:33.15,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:17:33.15,0:17:36.15,Default,,0,0,0,,Неге маған осылай опасыздық жасай бересің?
Dialogue: 0,0:17:36.15,0:17:41.16,Default,,0,0,0,,Құдайды, халықты және ақылды бір рет толығымен жоққа шығару керек➡
Dialogue: 0,0:17:41.16,0:17:44.16,Default,,0,0,0,,Шынайы жойылуға қол жеткізілмейді!
Dialogue: 0,0:17:44.16,0:17:48.16,Default,,0,0,0,,Олай болса, сүйікті қызымды толық растау үшін➡
Dialogue: 0,0:17:48.16,0:17:50.16,Default,,0,0,0,,Осы күшке ие болыңыз!
Dialogue: 0,0:17:50.16,0:17:52.13,Default,,0,0,0,,Хаа! Апыр-ай!
Dialogue: 0,0:18:05.11,0:18:07.08,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:18:13.12,0:18:17.12,Default,,0,0,0,,Мен сен жасаған көгілдір қылышты сездім.
Dialogue: 0,0:18:17.12,0:18:20.13,Default,,0,0,0,,Мен кіммен жұмыс істеп жатқанымды білмеймін, Лабития.
Dialogue: 0,0:18:20.13,0:18:22.13,Default,,0,0,0,,Бір күні сен де ұрысып қалдың
Dialogue: 0,0:18:22.13,0:18:24.13,Default,,0,0,0,,Оны өлтіру керек еді.
Dialogue: 0,0:18:24.13,0:18:26.13,Default,,0,0,0,,Саяхаттың қарғысы
Dialogue: 0,0:18:26.13,0:18:30.14,Default,,0,0,0,,Ол өзін екі бөлікке бөлді.
Dialogue: 0,0:18:30.14,0:18:36.14,Default,,0,0,0,,Түн данышпан қанша азап тартса да, өлмейді➡
Dialogue: 0,0:18:36.14,0:18:41.15,Default,,0,0,0,,Ақымақ кез келген ауруды оны тудырған адамға қайтарады.
Dialogue: 0,0:18:41.15,0:18:45.15,Default,,0,0,0,,Не істедің, мұндай қарғысқа шыдадың...
Dialogue: 0,0:18:45.15,0:18:47.15,Default,,0,0,0,,Дәл біз сияқты
Dialogue: 0,0:18:47.15,0:18:51.16,Default,,0,0,0,,Құдайдың жойылуын қалау
Dialogue: 0,0:18:51.16,0:18:56.16,Default,,0,0,0,,Бірақ ол мұны ешқашан өзі жасай алмайды
Dialogue: 0,0:18:56.16,0:18:59.17,Default,,0,0,0,,Сондықтан сіз оны Беллге сеніп тапсырасыз ба?
Dialogue: 0,0:18:59.17,0:19:02.10,Default,,0,0,0,,Лундинг сынаушының күлін жеңген кезде➡
Dialogue: 0,0:19:02.10,0:19:06.11,Default,,0,0,0,,Мен Беллмен қылыш айқастырар едім.
Dialogue: 0,0:19:06.11,0:19:09.11,Default,,0,0,0,,Мен оған соңғы рет тиісемін.
Dialogue: 0,0:19:09.11,0:19:11.11,Default,,0,0,0,,Сіз жылап жатырсыз ба?
Dialogue: 0,0:19:11.11,0:19:15.12,Default,,0,0,0,,Менің жылағым келмейді, бұл жай ғана ауырады
Dialogue: 0,0:19:15.12,0:19:18.12,Default,,0,0,0,,Өлім келе жатыр
Dialogue: 0,0:19:18.12,0:19:22.12,Default,,0,0,0,,Ішімнің түбінде бірдеңе өліп қалғандай сезінемін.
Dialogue: 0,0:19:22.12,0:19:24.13,Default,,0,0,0,,(Тот басқан тырнақтардың дірілдеген дыбысы)
Dialogue: 0,0:19:24.13,0:19:27.13,Default,,0,0,0,,Мм... Көгілдір жақсы.
Dialogue: 0,0:19:27.13,0:19:31.13,Default,,0,0,0,,Уайымдама, құдірет Құдайға байланысты➡
Dialogue: 0,0:19:31.13,0:19:35.14,Default,,0,0,0,,Оны мен жасаған қылыш ұстады.
Dialogue: 0,0:19:35.14,0:19:38.14,Default,,0,0,0,,Драмбуи мен оны саған беремін
Dialogue: 0,0:19:38.14,0:19:43.14,Default,,0,0,0,,Мен Сианды жеңіп, оның қалдықтарын саған беремін.
Dialogue: 0,0:19:43.14,0:19:47.11,Default,,0,0,0,,Екеуің мәңгі бірге боласыңдар
Dialogue: 0,0:19:53.15,0:19:57.16,Default,,0,0,0,,Ей, ақымақ... Тек осылай істеу керек.
Dialogue: 0,0:19:57.16,0:20:00.16,Default,,0,0,0,,Сақталуыңыз мүмкін.
Dialogue: 0,0:20:00.16,0:20:04.13,Default,,0,0,0,,Өлесің, солай өлесің.
Dialogue: 0,0:20:05.17,0:20:08.17,Default,,0,0,0,,Киль сияқты болма.
Dialogue: 0,0:20:08.17,0:20:12.17,Default,,0,0,0,,Сен тірі болғанша, мен жақсымын.
Dialogue: 0,0:20:12.17,0:20:17.18,Default,,0,0,0,,Бірге, бірге... Ей
Dialogue: 0,0:20:17.18,0:20:19.18,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:20:19.18,0:20:23.15,Default,,0,0,0,,Чикшо Лундинг!
Dialogue: 0,0:20:30.19,0:20:32.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:37.20,0:20:39.17,Default,,0,0,0,,Я...
Dialogue: 0,0:20:40.20,0:20:44.21,Default,,0,0,0,,Маған лайықты орнымды бер
Dialogue: 0,0:20:44.21,0:20:48.21,Default,,0,0,0,,Ха... (Қылыш ырылдап) Маған берші.
Dialogue: 0,0:20:48.21,0:20:50.21,Default,,0,0,0,,Сіздің ішіңізде
Dialogue: 0,0:20:50.21,0:20:53.18,Default,,0,0,0,,Заңды ұстаным
Dialogue: 0,0:20:57.22,0:20:59.22,Default,,0,0,0,,Ақымақ.
Dialogue: 0,0:20:59.22,0:21:04.16,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,0:21:04.16,0:21:24.18,Default,,0,0,0,,♬～
Dialogue: 0,0:21:24.18,0:21:35.19,Default,,0,0,0,,♬～
Dialogue: 0,0:21:35.19,0:21:38.19,Default,,0,0,0,,《Қалай...》
Dialogue: 0,0:21:38.19,0:21:43.20,Default,,0,0,0,,《Бір ғана себеп – Құдайдың көлеңкесін тесіп өту...》
Dialogue: 0,0:21:43.20,0:21:47.20,Default,,0,0,0,,《Мен де Құдайдың көлеңкесінде қалдым》
Dialogue: 0,0:21:47.20,0:21:50.20,Default,,0,0,0,,《Бірақ олай емес》
Dialogue: 0,0:21:50.20,0:21:54.18,Default,,0,0,0,,《Мені осылай жұтқаным үшін жек көруің керек.》
Dialogue: 0,0:22:00.21,0:22:20.17,Default,,0,0,0,,♬～
Dialogue: 0,0:22:20.17,0:22:40.19,Default,,0,0,0,,♬～
Dialogue: 0,0:22:40.19,0:22:43.19,Default,,0,0,0,,♬～
Dialogue: 0,0:22:43.19,0:23:01.14,Default,,0,0,0,,♬～
Dialogue: 0,0:23:01.14,0:23:10.15,Default,,0,0,0,,♬～
Dialogue: 0,0:23:10.15,0:23:21.16,Default,,0,0,0,,♬～
Dialogue: 0,0:23:21.16,0:23:29.14,Default,,0,0,0,,♬～
Dialogue: 0,0:23:30.17,0:23:32.17,Default,,0,0,0,,《Мен өзімді білдім...》
Dialogue: 0,0:23:32.17,0:23:34.17,Default,,0,0,0,,Мен бұл жерде Құдайға сұрақ қоямын.
Dialogue: 0,0:23:34.17,0:23:36.18,Default,,0,0,0,,Мен де Аштық альянсына сенемін.
Dialogue: 0,0:23:36.18,0:23:39.15,Default,,0,0,0,,Осы жерден бізге қалдырыңыз!
Dialogue: 0,0:23:40.65,0:23:46.65,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory