Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.50,0:00:09.51,Default,,0,0,0,,Ах
Dialogue: 0,0:00:15.51,0:00:17.51,Default,,0,0,0,,Шектеу бар ма?
Dialogue: 0,0:00:17.51,0:00:19.52,Default,,0,0,0,,Сізді азу тістер шақырды
Dialogue: 0,0:00:19.52,0:00:23.52,Default,,0,0,0,,Мен сені өз иегіме тартып көрейін
Dialogue: 0,0:00:23.52,0:00:25.52,Default,,0,0,0,,Тыныш ұйықта
Dialogue: 0,0:00:28.02,0:00:31.03,Default,,0,0,0,,А... кеттік.
Dialogue: 0,0:00:31.03,0:00:34.03,Default,,0,0,0,,Құдайдың жүрегі жақында келеді
Dialogue: 0,0:00:34.53,0:00:52.55,Default,,0,0,0,,♪♪～
Dialogue: 0,0:00:52.55,0:00:56.55,Default,,0,0,0,,♪♪～
Dialogue: 0,0:00:56.55,0:01:16.57,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:16.57,0:01:36.59,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:36.59,0:01:56.61,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:56.61,0:02:03.62,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:05.62,0:02:11.63,Default,,0,0,0,,Бұл құдайдың отты қаны ма?
Dialogue: 0,0:02:11.63,0:02:13.63,Default,,0,0,0,,Ескі құдайлардың дәуірінде
Dialogue: 0,0:02:13.63,0:02:19.64,Default,,0,0,0,,Құдайдың құдіреті әлемге осы жерден жеткізілді.
Dialogue: 0,0:02:19.64,0:02:24.64,Default,,0,0,0,,Бұл Құдайдың қатысуын бірінші рет сезіну сияқты.
Dialogue: 0,0:02:24.64,0:02:26.64,Default,,0,0,0,,Хун
Dialogue: 0,0:02:26.64,0:02:29.65,Default,,0,0,0,,Сіз басқаратын көлеңкелі топтың көзі
Dialogue: 0,0:02:29.65,0:02:31.65,Default,,0,0,0,,Міне, сіз осы жерден келдіңіз.
Dialogue: 0,0:02:31.65,0:02:33.65,Default,,0,0,0,,Иә.
Dialogue: 0,0:02:33.65,0:02:38.65,Default,,0,0,0,,Бірде Құдайда, енді мәңгілік жер аударылды
Dialogue: 0,0:02:38.65,0:02:40.66,Default,,0,0,0,,Жоюға ерік беру
Dialogue: 0,0:02:40.66,0:02:46.66,Default,,0,0,0,,Мен Құдайдың қасіретін және жойылып кетудің адам төзгісіз қорқынышын сезінемін.
Dialogue: 0,0:02:46.66,0:02:49.67,Default,,0,0,0,,Және тілек
Dialogue: 0,0:02:49.67,0:02:51.67,Default,,0,0,0,,Неге...
Dialogue: 0,0:02:51.67,0:02:55.67,Default,,0,0,0,,Құдай тіпті өз өлімін де ашты дейсіз бе?
Dialogue: 0,0:02:55.67,0:03:00.68,Default,,0,0,0,,Мұнда адамдарға Құдайдың сүйіспеншілігі жоқ.
Dialogue: 0,0:03:00.68,0:03:04.68,Default,,0,0,0,,Бірақ жойылу көлеңкесі сыртқа қуылды.
Dialogue: 0,0:03:04.68,0:03:07.68,Default,,0,0,0,,Аштық одағына айналғандай
Dialogue: 0,0:03:07.68,0:03:10.69,Default,,0,0,0,,Құдайдың сүйіспеншілігі қандай да бір формада болады
Dialogue: 0,0:03:10.69,0:03:12.69,Default,,0,0,0,,Сырттай көрініп тұрған жоқ па?
Dialogue: 0,0:03:12.69,0:03:15.69,Default,,0,0,0,,Белл де, басқалар да соны қалайды.
Dialogue: 0,0:03:15.69,0:03:18.69,Default,,0,0,0,,Менің ойымша, бұл маған сеніп тапсырылған.
Dialogue: 0,0:03:19.70,0:03:22.70,Default,,0,0,0,,Қоңырау келе жатыр
Dialogue: 0,0:03:22.70,0:03:26.70,Default,,0,0,0,,Аштық альянсы абсолютті күйреуде.
Dialogue: 0,0:03:26.70,0:03:29.71,Default,,0,0,0,,Жаңа өмір салтын ашатын болмыс.
Dialogue: 0,0:03:29.71,0:03:32.71,Default,,0,0,0,,Құдайды да оның кейпінен танисың.
Dialogue: 0,0:03:32.71,0:03:34.71,Default,,0,0,0,,Сіз мені босатқыңыз келе ме?
Dialogue: 0,0:03:34.71,0:03:37.71,Default,,0,0,0,,Сондықтан мен
Dialogue: 0,0:03:37.71,0:03:40.72,Default,,0,0,0,,Көлеңкесі бар адам деп қарсы алды
Dialogue: 0,0:03:40.72,0:03:46.72,Default,,0,0,0,,Ал олар тек жою үшін ән айтсын.
Dialogue: 0,0:03:47.72,0:03:50.73,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:03:54.73,0:03:56.73,Default,,0,0,0,,Еш жерде…
Dialogue: 0,0:03:56.73,0:03:58.73,Default,,0,0,0,,Ах
Dialogue: 0,0:03:58.73,0:04:05.74,Default,,0,0,0,,Ешқайда… Ешқайда…
Dialogue: 0,0:04:05.74,0:04:08.74,Default,,0,0,0,,♪ (ән айту)
Dialogue: 0,0:04:08.74,0:04:13.75,Default,,0,0,0,,(Көлеңке шеберлерінің ыңырануы)
Dialogue: 0,0:04:13.75,0:04:17.75,Default,,0,0,0,,♪～
Dialogue: 0,0:04:17.75,0:04:19.76,Default,,0,0,0,,Жақсы…
Dialogue: 0,0:04:19.76,0:04:22.76,Default,,0,0,0,,Хмм... ол тіпті көлеңкелерді күйдіреді ме?
Dialogue: 0,0:04:22.76,0:04:25.76,Default,,0,0,0,,Хахаха, мойындайық!
Dialogue: 0,0:04:25.76,0:04:29.77,Default,,0,0,0,,Сіз шынымен Құдайдың перзентісіз.
Dialogue: 0,0:04:29.77,0:04:33.77,Default,,0,0,0,,Дәл сол себепті Аштық Альянсы сіздің тістеріңізді іздейді!
Dialogue: 0,0:04:33.77,0:04:39.78,Default,,0,0,0,,Қасқыр, киелі жеріңді тастап, айдалаға қайт.
Dialogue: 0,0:04:39.78,0:04:41.78,Default,,0,0,0,,Бұл сіздің сөздеріңіз емес
Dialogue: 0,0:04:41.78,0:04:43.78,Default,,0,0,0,,Құдай айтады!
Dialogue: 0,0:04:43.78,0:04:45.78,Default,,0,0,0,,(Көлеңке шеберлерінің ыңырануы)
Dialogue: 0,0:04:45.78,0:04:47.78,Default,,0,0,0,,Ах
Dialogue: 0,0:04:47.78,0:04:51.79,Default,,0,0,0,,Неліктен Құдай аштық альянсымен қылыш ойнаудан қорқады?
Dialogue: 0,0:04:51.79,0:04:55.79,Default,,0,0,0,,Бұл жауап! (Көлеңке шеберлерінің ыңырануы)
Dialogue: 0,0:04:55.79,0:04:57.79,Default,,0,0,0,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:04:59.80,0:05:04.80,Default,,0,0,0,,Аштық альянсының қараңғылығы бәрін бірдей жейді!
Dialogue: 0,0:05:05.80,0:05:08.80,Default,,0,0,0,,Ренжіме, Құдайдың баласы!
Dialogue: 0,0:05:08.80,0:05:10.81,Default,,0,0,0,,Кух... қарсылық білдірсеңіз.
Dialogue: 0,0:05:10.81,0:05:14.81,Default,,0,0,0,,Осы қылышпен мұңның таңбасын тәніңе ойып саламын!
Dialogue: 0,0:05:14.81,0:05:17.81,Default,,0,0,0,,Баака Адонис па?
Dialogue: 0,0:05:21.82,0:05:24.82,Default,,0,0,0,,Хмм... аа
Dialogue: 0,0:05:32.83,0:05:35.83,Default,,0,0,0,,Қоңырау! Сәлем Шерри
Dialogue: 0,0:05:35.83,0:05:37.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:37.83,0:05:39.84,Default,,0,0,0,,Иә
Dialogue: 0,0:05:39.84,0:05:41.84,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:05:41.84,0:05:44.84,Default,,0,0,0,,Ақылдың қызы, сені күттім.
Dialogue: 0,0:05:44.84,0:05:47.84,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:05:47.84,0:05:52.85,Default,,0,0,0,,Сіз аштық одағының қараңғылығы да жей алмайтын жарықсыз.
Dialogue: 0,0:05:52.85,0:05:57.85,Default,,0,0,0,,Тағы да, тіпті Құдайдың нұры да қараңғылықты өшіре алмайды.
Dialogue: 0,0:05:57.85,0:06:03.86,Default,,0,0,0,,Сізді ішу арқылы Аштық Альянсы шынымен де абсолютті қараңғылыққа айналады.
Dialogue: 0,0:06:03.86,0:06:05.86,Default,,0,0,0,,Сылтаулар көп.
Dialogue: 0,0:06:05.86,0:06:08.86,Default,,0,0,0,,Менімен істегіңіз келсе, айтыңыз.
Dialogue: 0,0:06:08.86,0:06:11.87,Default,,0,0,0,,О, бұл пішінсіз.
Dialogue: 0,0:06:11.87,0:06:14.87,Default,,0,0,0,,Хмм... Ха!
Dialogue: 0,0:06:16.87,0:06:19.88,Default,,0,0,0,,Сіз! Өлгісі келмейтін ұзын құлақтар
Dialogue: 0,0:06:19.88,0:06:21.88,Default,,0,0,0,,Иә
Dialogue: 0,0:06:21.88,0:06:24.88,Default,,0,0,0,,Китти, тезірек шерри алып кел, иә.
Dialogue: 0,0:06:24.88,0:06:26.88,Default,,0,0,0,,Мм, сіздің әніңіз
Dialogue: 0,0:06:26.88,0:06:28.88,Default,,0,0,0,,Бұл сіз ойлағаннан да шешуші!
Dialogue: 0,0:06:28.88,0:06:30.89,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:30.89,0:06:35.89,Default,,0,0,0,,Сенің өлеңің Құдайдың нені ашқанын ашады!
Dialogue: 0,0:06:35.89,0:06:37.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:37.89,0:06:42.90,Default,,0,0,0,,Эй Шелли, сен менің бөлмемде бір рет ән айттың.
Dialogue: 0,0:06:42.90,0:06:45.90,Default,,0,0,0,,Тағы да ән айтасың ба?
Dialogue: 0,0:06:45.90,0:06:49.91,Default,,0,0,0,,Иә, Белл!
Dialogue: 0,0:06:49.91,0:06:51.91,Default,,0,0,0,,Қашпа!
Dialogue: 0,0:06:51.91,0:06:55.91,Default,,0,0,0,,Әдеттегідей сіз әйелдерге қалай қарау керектігін білмейсіз.
Dialogue: 0,0:06:55.91,0:06:58.91,Default,,0,0,0,,Цк... Алдымен сені жеңуім керек пе?
Dialogue: 0,0:06:58.91,0:07:00.92,Default,,0,0,0,,Парасатты қыз! Хааа!
Dialogue: 0,0:07:00.92,0:07:02.92,Default,,0,0,0,,Мен Ловерак Беллмін!
Dialogue: 0,0:07:02.92,0:07:04.92,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:07:04.92,0:07:06.92,Default,,0,0,0,,Иә! Ннн! Тааааа!
Dialogue: 0,0:07:06.92,0:07:09.93,Default,,0,0,0,,Қарғыс атсын... Хмф! Ха!
Dialogue: 0,0:07:09.93,0:07:12.93,Default,,0,0,0,,Жақсы! Нан хааа! Хмм...
Dialogue: 0,0:07:15.93,0:07:19.94,Default,,0,0,0,,Ммм!
Dialogue: 0,0:07:23.44,0:07:25.44,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:25.44,0:07:27.44,Default,,0,0,0,,Ах
Dialogue: 0,0:07:28.44,0:07:31.45,Default,,0,0,0,,Хаха, мен сенің жүзіңді көрдім.
Dialogue: 0,0:07:31.45,0:07:33.45,Default,,0,0,0,,Сіз жақсы көрінесіз, солай емес пе?
Dialogue: 0,0:07:33.45,0:07:36.45,Default,,0,0,0,,Әрқашан өкініштің балқыған қазаны
Dialogue: 0,0:07:36.45,0:07:39.45,Default,,0,0,0,,Мен сені жойылудың кілті деп санаймын
Dialogue: 0,0:07:39.45,0:07:44.46,Default,,0,0,0,,Қойшы, сенен көңілім қалды.
Dialogue: 0,0:07:44.46,0:07:47.46,Default,,0,0,0,,Аа, дұрыс, Барса.
Dialogue: 0,0:07:47.46,0:07:49.46,Default,,0,0,0,,Иә? Сіз шынымен түсінесіз бе?
Dialogue: 0,0:07:49.46,0:07:54.47,Default,,0,0,0,,Маған қоңырау шалыңыз, мен сізді кесіп тастаймын.
Dialogue: 0,0:07:54.47,0:07:59.47,Default,,0,0,0,,Фасадты жеңдің деп сенемін, ақылды қыз.
Dialogue: 0,0:07:59.47,0:08:04.48,Default,,0,0,0,,Ешқайда... Ешқайда... Иә?
Dialogue: 0,0:08:04.48,0:08:08.48,Default,,0,0,0,,Не? Сіздің достарыңыз көп, солай емес пе?
Dialogue: 0,0:08:08.48,0:08:11.49,Default,,0,0,0,,Жабу! Себепке батқан менмін!
Dialogue: 0,0:08:11.49,0:08:16.49,Default,,0,0,0,,Уайымдама, ол сені құртпайды.
Dialogue: 0,0:08:16.49,0:08:20.50,Default,,0,0,0,,Бірақ сіз әлі жеткілікті түрде сыналған жоқсыз.
Dialogue: 0,0:08:20.50,0:08:23.50,Default,,0,0,0,,Сіз нені айтып тұрсыз, Драмбю?
Dialogue: 0,0:08:23.50,0:08:25.50,Default,,0,0,0,,Хехе... (аяқ дыбысы)
Dialogue: 0,0:08:25.50,0:08:27.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:32.51,0:08:36.51,Default,,0,0,0,,Ех… Ах…
Dialogue: 0,0:08:36.51,0:08:40.52,Default,,0,0,0,,Не? Сен кімсің?
Dialogue: 0,0:08:40.52,0:08:42.52,Default,,0,0,0,,(Презентациялық микрофон) Финалдық турнир, бірінші раунд, 1-ші жекпе-жек
Dialogue: 0,0:08:44.52,0:08:46.52,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:46.52,0:08:49.52,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:08:52.53,0:08:56.53,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:08:57.53,0:09:03.54,Default,,0,0,0,,Бұл менің мұғалім ретіндегі соңғы рөлім.
Dialogue: 0,0:09:04.54,0:09:07.54,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:07.54,0:09:12.55,Default,,0,0,0,,Неліктен мен емес басқа біреуге бұлай айтасың?
Dialogue: 0,0:09:12.55,0:09:18.55,Default,,0,0,0,,Маған берген сөздерің, тек мен үшін!
Dialogue: 0,0:09:18.55,0:09:21.56,Default,,0,0,0,,Не? Уф боқ
Dialogue: 0,0:09:21.56,0:09:23.56,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:09:23.56,0:09:27.56,Default,,0,0,0,,Яаааа! Қылыш нұсқауы? Адониске?
Dialogue: 0,0:09:27.56,0:09:30.57,Default,,0,0,0,,Неге... а
Dialogue: 0,0:09:30.57,0:09:32.57,Default,,0,0,0,,Сен неменесің...
Dialogue: 0,0:09:32.57,0:09:34.57,Default,,0,0,0,,Ha
Dialogue: 0,0:09:34.57,0:09:37.57,Default,,0,0,0,,Сіз Лундинг...
Dialogue: 0,0:09:37.57,0:09:40.58,Default,,0,0,0,,Болашақ жақын арада пайда болады
Dialogue: 0,0:09:40.58,0:09:44.58,Default,,0,0,0,,Сіз және сіздің қара балаңызға
Dialogue: 0,0:09:44.58,0:09:47.58,Default,,0,0,0,,Иә! (Мас) Біраз күте тұрыңыз.
Dialogue: 0,0:09:47.58,0:09:49.58,Default,,0,0,0,,Парасатты қыз
Dialogue: 0,0:09:49.58,0:09:52.59,Default,,0,0,0,,Бұл жігіт кім...
Dialogue: 0,0:09:52.59,0:09:56.59,Default,,0,0,0,,Қалай ойлайсыңдар, адамдар қандай?
Dialogue: 0,0:10:00.60,0:10:02.60,Default,,0,0,0,,Белл жақсы ма?
Dialogue: 0,0:10:02.60,0:10:05.60,Default,,0,0,0,,Бұл өте қауіпті.
Dialogue: 0,0:10:05.60,0:10:08.60,Default,,0,0,0,,Дегенмен, бұл шайқастың кілті
Dialogue: 0,0:10:08.60,0:10:11.61,Default,,0,0,0,,Бұл сенсің, Шерри.
Dialogue: 0,0:10:11.61,0:10:14.61,Default,,0,0,0,,Не, мен?
Dialogue: 0,0:10:16.61,0:10:20.62,Default,,0,0,0,,Біз қылышымызды ешқашан тастамаймыз!
Dialogue: 0,0:10:20.62,0:10:24.62,Default,,0,0,0,,Біз шынымен бас тартуымыз керек нәрсе - Құдайға ие болуға тырысу!
Dialogue: 0,0:10:24.62,0:10:26.62,Default,,0,0,0,,Дирижер Гиннесс
Dialogue: 0,0:10:26.62,0:10:30.63,Default,,0,0,0,,Менің ғана емес, Құдайдың сөзіне де мойынсұнбайсың ба?
Dialogue: 0,0:10:30.63,0:10:34.63,Default,,0,0,0,,Тәңір – аңыз дәуірінен бері жалғасып келе жатқан алғашқы сиқыр.
Dialogue: 0,0:10:34.63,0:10:37.63,Default,,0,0,0,,Бірақ халық Құдайды білді
Dialogue: 0,0:10:37.63,0:10:41.64,Default,,0,0,0,,Мен оны станоктың берілістерінің арасынан тауып алып, сүйсіндім.
Dialogue: 0,0:10:41.64,0:10:44.64,Default,,0,0,0,,Механикалық құдай!
Dialogue: 0,0:10:44.64,0:10:47.64,Default,,0,0,0,,Құдайды тісті тіс дегенді қалай түсінесіңдер?
Dialogue: 0,0:10:47.64,0:10:50.65,Default,,0,0,0,,Біздің актерлер құрамын белгілеп, барлығының өмірін үйлестіріңіз.
Dialogue: 0,0:10:50.65,0:10:53.65,Default,,0,0,0,,Ең жоғарғы болмыс емес пе?
Dialogue: 0,0:10:53.65,0:10:56.65,Default,,0,0,0,,Құдайды жібер, енді бізге уақыт
Dialogue: 0,0:10:56.65,0:11:00.66,Default,,0,0,0,,Тәртіпті өз қолымызбен жасауымыз керек!
Dialogue: 0,0:11:00.66,0:11:03.66,Default,,0,0,0,,Әйтпесе біз мәңгі боламыз
Dialogue: 0,0:11:03.66,0:11:07.66,Default,,0,0,0,,Менің өмірімді механикалық ойыншық ретінде жалғастырудан басқа амалым жоқ!
Dialogue: 0,0:11:07.66,0:11:12.67,Default,,0,0,0,,Неліктен Адонис үмітін үзді және абсолютті жойылуды қалайды?
Dialogue: 0,0:11:12.67,0:11:14.67,Default,,0,0,0,,Сіз әлі білмейсіз бе?
Dialogue: 0,0:11:14.67,0:11:17.67,Default,,0,0,0,,Аштық альянсынан үйреніп, қирауды ішіңіз!
Dialogue: 0,0:11:17.67,0:11:21.68,Default,,0,0,0,,Катакомба! Катакомбалардағы бейтараптық символы ретінде
Dialogue: 0,0:11:21.68,0:11:23.68,Default,,0,0,0,,Саяхат кілтін тойлау!
Dialogue: 0,0:11:23.68,0:11:27.68,Default,,0,0,0,,Балалар, сендер Катакомбаның қызметшісі болуды жоспарлап отырсыңдар!
Dialogue: 0,0:11:27.68,0:11:31.69,Default,,0,0,0,,Катакомбалар адамдардың жаңа жолын көрсетеді.
Dialogue: 0,0:11:31.69,0:11:33.69,Default,,0,0,0,,Бір үміт!
Dialogue: 0,0:11:33.69,0:11:35.69,Default,,0,0,0,,Жоғарғы ит жоқ, бағынбайтын адам жоқ
Dialogue: 0,0:11:35.69,0:11:38.69,Default,,0,0,0,,Бір күні сырты да, іші де болмайды!
Dialogue: 0,0:11:38.69,0:11:40.70,Default,,0,0,0,,...
Dialogue: 0,0:11:40.70,0:11:44.70,Default,,0,0,0,,Менің бұл сөздерді осы жүзбен қысқартудан басқа амалым жоқ!
Dialogue: 0,0:11:44.70,0:11:46.70,Default,,0,0,0,,Мен сәл қателестім — саусағым сырғып кетті.
Dialogue: 0,0:11:46.70,0:11:48.70,Default,,0,0,0,,Бұл тартыстың жеңімпазы
Dialogue: 0,0:11:48.70,0:11:51.71,Default,,0,0,0,,Халықтың болашақ бағдарын көрсететін тұлға бол.
Dialogue: 0,0:11:51.71,0:11:54.71,Default,,0,0,0,,Соған сенген Белл төбелесіп жатыр.
Dialogue: 0,0:11:54.71,0:11:58.71,Default,,0,0,0,,Тәңірдің жүрек лүпілі сені тебірентеді.
Dialogue: 0,0:11:58.71,0:12:00.72,Default,,0,0,0,,Мен сол жерге баруым керек.
Dialogue: 0,0:12:00.72,0:12:02.72,Default,,0,0,0,,Иә
Dialogue: 0,0:12:02.72,0:12:07.72,Default,,0,0,0,,Бұл қақтығысты одан сайын күшейту керек пе, әлде оны толығымен жою керек пе?
Dialogue: 0,0:12:07.72,0:12:10.73,Default,,0,0,0,,Барлығы сізге байланысты.
Dialogue: 0,0:12:10.73,0:12:15.73,Default,,0,0,0,,Түсіндім, бұл менің рөлім.
Dialogue: 0,0:12:15.73,0:12:18.73,Default,,0,0,0,,Бірақ менің қолымнан келетіні ән айту ғана
Dialogue: 0,0:12:18.73,0:12:20.74,Default,,0,0,0,,Иә
Dialogue: 0,0:12:20.74,0:12:22.74,Default,,0,0,0,,Белл семсерін бір-ақ сермеп тұрғандай
Dialogue: 0,0:12:22.74,0:12:24.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:26.74,0:12:29.74,Default,,0,0,0,,Мен сонда тұрамын.
Dialogue: 0,0:12:29.74,0:12:31.75,Default,,0,0,0,,Растау
Dialogue: 0,0:12:31.75,0:12:34.75,Default,,0,0,0,,Барлығы сынақ
Dialogue: 0,0:12:35.25,0:12:37.25,Default,,0,0,0,,О...
Dialogue: 0,0:12:39.25,0:12:41.26,Default,,0,0,0,,Шерри! (Джинс) Неге мұндасың...
Dialogue: 0,0:12:41.26,0:12:44.26,Default,,0,0,0,,Шерри ханшайым! Ханшайым!
Dialogue: 0,0:12:44.26,0:12:48.26,Default,,0,0,0,,Шерри қайта қош келдіңіз! Ха…
Dialogue: 0,0:12:48.26,0:12:50.27,Default,,0,0,0,,《Қандай ұлылық》
Dialogue: 0,0:12:50.27,0:12:56.27,Default,,0,0,0,,《Ол құдайдың қысымынан шығып не ұттым?》
Dialogue: 0,0:12:56.27,0:12:59.27,Default,,0,0,0,,Тәңірлік ғибадатхана қызы ретінде мен сізге осы жерде айтып отырмын.
Dialogue: 0,0:12:59.27,0:13:03.28,Default,,0,0,0,,Енді бейбіт өлімнің тыныш орнында
Dialogue: 0,0:13:03.28,0:13:06.28,Default,,0,0,0,,Құдайдың тыныштығына қауіп төндіргісі келетіндер бар.
Dialogue: 0,0:13:06.28,0:13:09.28,Default,,0,0,0,,Бұл дауды діни қызметкер шеше ме?
Dialogue: 0,0:13:09.28,0:13:14.29,Default,,0,0,0,,Бірақ бұл Құдайдың сөздері емес; олар Шеллидің өз сөздері.
Dialogue: 0,0:13:14.29,0:13:18.29,Default,,0,0,0,,Ол адам халыққа бейтарап болмысын көрсетеді.
Dialogue: 0,0:13:18.29,0:13:21.30,Default,,0,0,0,,Адамдарға Құдайдан бас тартуға көмектеседі
Dialogue: 0,0:13:21.30,0:13:23.30,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:23.30,0:13:26.30,Default,,0,0,0,,Адамның наным-сеніміне қарамастан шығу тегі қандай?
Dialogue: 0,0:13:26.30,0:13:30.31,Default,,0,0,0,,Тіпті Құдайды жойғысы келетіндер де
Dialogue: 0,0:13:30.31,0:13:33.31,Default,,0,0,0,,Бата мен қорғаудан басқа ештеңе жоқ.
Dialogue: 0,0:13:33.31,0:13:36.31,Default,,0,0,0,,Бұл сіздің айтып отырғаныңыз емес пе? (Джинс) Ах
Dialogue: 0,0:13:36.31,0:13:38.31,Default,,0,0,0,,Сіз кім туралы айтып отырсыз?
Dialogue: 0,0:13:38.31,0:13:43.32,Default,,0,0,0,,Тәңірді мадақтаушының аты – сарайдағы есімі.
Dialogue: 0,0:13:43.32,0:13:47.32,Default,,0,0,0,,Мэри Шелли, бас әнші
Dialogue: 0,0:13:47.32,0:13:50.33,Default,,0,0,0,,Бұл менмін (бәрі) Ах...
Dialogue: 0,0:13:50.33,0:13:53.33,Default,,0,0,0,,Құдай Сөзіне мойынсұнған, мені кесіп таста.
Dialogue: 0,0:13:53.33,0:13:58.33,Default,,0,0,0,,Мұндағы кез келген адам мені өлтіруі мүмкін.
Dialogue: 0,0:13:58.33,0:14:00.34,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:14:00.34,0:14:02.34,Default,,0,0,0,,Неге, Шерри!
Dialogue: 0,0:14:02.34,0:14:05.34,Default,,0,0,0,,Мен әлі түсінбеймін
Dialogue: 0,0:14:05.34,0:14:08.34,Default,,0,0,0,,Бірақ бұл болашақта көрсетіледі.
Dialogue: 0,0:14:08.34,0:14:11.35,Default,,0,0,0,,Дұрыс (гуфф) Сіз қандайсыз?
Dialogue: 0,0:14:11.35,0:14:13.35,Default,,0,0,0,,Китти бәрі
Dialogue: 0,0:14:13.35,0:14:16.35,Default,,0,0,0,,Осы диваны басқаратын және ұстап алған адам
Dialogue: 0,0:14:16.35,0:14:19.35,Default,,0,0,0,,Онда бұрын-соңды болмаған масштабтағы есептеулер
Dialogue: 0,0:14:19.35,0:14:22.36,Default,,0,0,0,,Көру үшін жайыңыз
Dialogue: 0,0:14:22.36,0:14:24.36,Default,,0,0,0,,Құдайдың қанын мөрлеу
Dialogue: 0,0:14:24.36,0:14:29.36,Default,,0,0,0,,Өлімге әкелетін күлді мәңгілікке жойыңыз
Dialogue: 0,0:14:29.36,0:14:31.37,Default,,0,0,0,,А... ау, менің (Шерри) ха.
Dialogue: 0,0:14:31.37,0:14:34.37,Default,,0,0,0,,Жақында кездескенше.
Dialogue: 0,0:14:34.37,0:14:36.37,Default,,0,0,0,,Сіз осы жолмен бара жатырсыз.
Dialogue: 0,0:14:36.37,0:14:39.37,Default,,0,0,0,,Өліммен сыналған сол.
Dialogue: 0,0:14:39.37,0:14:42.38,Default,,0,0,0,,Оны сынақ ретінде қарастырыңыз.
Dialogue: 0,0:14:42.38,0:14:46.38,Default,,0,0,0,,Мен өз жеңісіме сенемін
Dialogue: 0,0:14:46.38,0:14:48.38,Default,,0,0,0,,Қарғыс атсын... (Шерри) Енді ше?
Dialogue: 0,0:14:48.38,0:14:51.39,Default,,0,0,0,,Менің әрекетімнің себебін ешкім білмесе де,
Dialogue: 0,0:14:51.39,0:14:54.39,Default,,0,0,0,,Дәлелдеу ақыр соңында өседі.
Dialogue: 0,0:14:54.39,0:14:57.39,Default,,0,0,0,,Шерри Бұл дұрыс емес!
Dialogue: 0,0:14:57.39,0:15:00.40,Default,,0,0,0,,Сонда бұл шайтанның жеңісі емес пе?
Dialogue: 0,0:15:00.40,0:15:03.40,Default,,0,0,0,,Иә, мен соңғы Нидхогпын.
Dialogue: 0,0:15:03.40,0:15:08.40,Default,,0,0,0,,Жындық қуанышқа құдайдың даңқы мен ән айтамын!
Dialogue: 0,0:15:08.40,0:15:11.41,Default,,0,0,0,,Ха! Уф...
Dialogue: 0,0:15:11.41,0:15:13.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:13.41,0:15:15.41,Default,,0,0,0,,Кук
Dialogue: 0,0:15:15.41,0:15:18.41,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:18.41,0:15:21.42,Default,,0,0,0,,Бұл Құдайдың жүрегі ме?
Dialogue: 0,0:15:21.42,0:15:25.42,Default,,0,0,0,,Сіз Құдайдың дірілін сезінесіз бе?
Dialogue: 0,0:15:25.42,0:15:30.43,Default,,0,0,0,,Себеп іздеп, көтерген себебім осы.
Dialogue: 0,0:15:30.43,0:15:33.43,Default,,0,0,0,,Саған сенімсіздікпен қарауымның себебі де бар.
Dialogue: 0,0:15:33.43,0:15:36.43,Default,,0,0,0,,А... Қоңырау
Dialogue: 0,0:15:36.43,0:15:39.43,Default,,0,0,0,,Құдайдың қысымында емес пе?
Dialogue: 0,0:15:39.43,0:15:43.44,Default,,0,0,0,,Ой, сен құладың, Сиан!
Dialogue: 0,0:15:43.44,0:15:46.44,Default,,0,0,0,,Белл деген кім?
Dialogue: 0,0:15:46.44,0:15:51.45,Default,,0,0,0,,Мен аштық альянсының қараңғылығына оранып, ақыры осында келдім.
Dialogue: 0,0:15:51.45,0:15:54.45,Default,,0,0,0,,Бірақ Белл жай ғана Белл.
Dialogue: 0,0:15:54.45,0:15:56.45,Default,,0,0,0,,Осы киелі жерде
Dialogue: 0,0:15:56.45,0:15:59.45,Default,,0,0,0,,Ол қандай шындық, бала?
Dialogue: 0,0:15:59.45,0:16:02.46,Default,,0,0,0,,Хаа, дауыстап жауап бер.
Dialogue: 0,0:16:02.46,0:16:04.46,Default,,0,0,0,,Deus Ex Machina-мен бірге туған
Dialogue: 0,0:16:04.46,0:16:08.46,Default,,0,0,0,,Дүниеде зұлымдықтан құтылатын бір ғана адам бар!
Dialogue: 0,0:16:08.46,0:16:10.47,Default,,0,0,0,,сол құдайларды әкелді
Dialogue: 0,0:16:10.47,0:16:13.47,Default,,0,0,0,,Ежелгі Құдайдан басқа ешкім жоқ!
Dialogue: 0,0:16:13.47,0:16:16.47,Default,,0,0,0,,Жарайсың.
Dialogue: 0,0:16:16.47,0:16:19.47,Default,,0,0,0,,Ал біз, жұмақ тұрғындары,
Dialogue: 0,0:16:19.47,0:16:22.48,Default,,0,0,0,,Механикалық құдайлар жасаған
Dialogue: 0,0:16:22.48,0:16:25.48,Default,,0,0,0,,Зэпелли мырза, ол бала ғой.
Dialogue: 0,0:16:25.48,0:16:28.48,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:16:30.49,0:16:33.49,Default,,0,0,0,,Бар, ақылды қыз
Dialogue: 0,0:16:33.49,0:16:37.49,Default,,0,0,0,,Барып, болашақты басқар
Dialogue: 0,0:16:37.49,0:16:40.50,Default,,0,0,0,,Оны жалама! Хмм
Dialogue: 0,0:16:40.50,0:16:43.50,Default,,0,0,0,,Менің жауым болма, Адонис!
Dialogue: 0,0:16:43.50,0:16:45.50,Default,,0,0,0,,Бұл шынымен де біз... боламыз ба?
Dialogue: 0,0:16:45.50,0:16:49.50,Default,,0,0,0,,Сен шынайы Құдайдың ұрпағы Беллді жеңе аласың ба?
Dialogue: 0,0:16:49.50,0:16:53.51,Default,,0,0,0,,Тағдырымызға күмән келтіретін сенсің.
Dialogue: 0,0:16:53.51,0:16:56.51,Default,,0,0,0,,Мен сені өлтіру үшін үйреткенімнің бәрін пайдаланамын.
Dialogue: 0,0:16:56.51,0:16:59.51,Default,,0,0,0,,Ал мен Беллді жеңемін!
Dialogue: 0,0:16:59.51,0:17:03.52,Default,,0,0,0,,Тәңір мен бұл ел күдіктің жүзінен айырылды.
Dialogue: 0,0:17:03.52,0:17:05.52,Default,,0,0,0,,Мен саған көрсетемін!
Dialogue: 0,0:17:05.52,0:17:07.52,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:15.53,0:17:19.53,Default,,0,0,0,,Бұл тамаша... иә.
Dialogue: 0,0:17:22.54,0:17:24.54,Default,,0,0,0,,Ах
Dialogue: 0,0:17:24.54,0:17:26.54,Default,,0,0,0,,Уф…
Dialogue: 0,0:17:26.54,0:17:29.54,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:17:29.54,0:17:33.55,Default,,0,0,0,,Сіз Беллесіз бе?
Dialogue: 0,0:17:35.55,0:17:37.55,Default,,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:17:37.55,0:17:41.56,Default,,0,0,0,,Мен сізді танымаймын
Dialogue: 0,0:17:41.56,0:17:43.56,Default,,0,0,0,,Иә
Dialogue: 0,0:17:43.56,0:17:46.56,Default,,0,0,0,,(жылау)
Dialogue: 0,0:17:46.56,0:17:48.56,Default,,0,0,0,,Уууууууу!!
Dialogue: 0,0:17:48.56,0:17:51.57,Default,,0,0,0,,Көптен айтқан тілегіңді көрсет
Dialogue: 0,0:17:51.57,0:17:55.57,Default,,0,0,0,,Менің... үмітім
Dialogue: 0,0:17:56.57,0:18:02.58,Default,,0,0,0,,Ұлы жұмбақтың соңында тас жұмыртқаны көрдім.
Dialogue: 0,0:18:02.58,0:18:06.58,Default,,0,0,0,,Онда сен жас балаша ұйықтайсың...
Dialogue: 0,0:18:06.58,0:18:09.58,Default,,0,0,0,,Бұл дүниенің себептері…
Dialogue: 0,0:18:18.59,0:18:23.60,Default,,0,0,0,,Мен сені бір жұппен қалдырдым... және күттім.
Dialogue: 0,0:18:23.60,0:18:29.60,Default,,0,0,0,,Драмбуи жасаған қылыштың жетегінде жүргенде
Dialogue: 0,0:18:29.60,0:18:33.61,Default,,0,0,0,,Ұзақ, ұзақ уақыт
Dialogue: 0,0:18:33.61,0:18:35.61,Default,,0,0,0,,Саяхатшы…
Dialogue: 0,0:18:35.61,0:18:39.61,Default,,0,0,0,,Өз болмысымыздың құпиясы ортасында
Dialogue: 0,0:18:39.61,0:18:43.62,Default,,0,0,0,,Жалғыз емес екеніңізді дәлелдеу
Dialogue: 0,0:18:43.62,0:18:46.62,Default,,0,0,0,,Нағыз үміт
Dialogue: 0,0:18:46.62,0:18:50.63,Default,,0,0,0,,Сіз менің ішімде өліп қалдыңыз, солай емес пе?
Dialogue: 0,0:18:50.63,0:18:56.63,Default,,0,0,0,,Мен жүрген жолдан енді ыңғайсыздық тудырмайды.
Dialogue: 0,0:18:56.63,0:19:02.64,Default,,0,0,0,,Өйткені мен... бос боламын.
Dialogue: 0,0:19:04.64,0:19:07.64,Default,,0,0,0,,Қарғыс атсын... неге...
Dialogue: 0,0:19:09.64,0:19:12.65,Default,,0,0,0,,Мен күттім, ха
Dialogue: 0,0:19:12.65,0:19:15.65,Default,,0,0,0,,Тек болашаққа құмар бол
Dialogue: 0,0:19:15.65,0:19:19.65,Default,,0,0,0,,Мен бүгін мен өткен күннен үмітсіз болдым.
Dialogue: 0,0:19:19.65,0:19:22.66,Default,,0,0,0,,Қазір мұнда тек қараңғылық бар
Dialogue: 0,0:19:22.66,0:19:26.66,Default,,0,0,0,,Қараңғыда тек мәңгілік тыныштық бар
Dialogue: 0,0:19:28.66,0:19:31.67,Default,,0,0,0,,Жақсы, мен саған беремін.
Dialogue: 0,0:19:31.67,0:19:35.67,Default,,0,0,0,,Мен оны саған беремін! Хмм!
Dialogue: 0,0:19:35.67,0:19:38.67,Default,,0,0,0,,Ха... Адонис!
Dialogue: 0,0:19:38.67,0:19:42.68,Default,,0,0,0,,Ннн, мен саған ғашық болдым.
Dialogue: 0,0:19:42.68,0:19:48.68,Default,,0,0,0,,Мен сенімен осылай байланысу үшін ол кісіні өз қолыммен кесіп тастадым.
Dialogue: 0,0:19:48.68,0:19:51.69,Default,,0,0,0,,Сен мені қаламадың.
Dialogue: 0,0:19:51.69,0:19:53.69,Default,,0,0,0,,Мен жай ғана өзім болғым келді!
Dialogue: 0,0:19:53.69,0:19:56.69,Default,,0,0,0,,Ол кісі де сен болғысы келді!
Dialogue: 0,0:19:56.69,0:19:59.69,Default,,0,0,0,,Хаха...
Dialogue: 0,0:20:01.70,0:20:04.70,Default,,0,0,0,,Оны кесуге бола ма? қоңырау
Dialogue: 0,0:20:04.70,0:20:09.70,Default,,0,0,0,,Мен сені өлтіремін, сондықтан осы уақытқа дейін келдім.
Dialogue: 0,0:20:09.70,0:20:12.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:13.71,0:20:15.71,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:20:15.71,0:20:18.71,Default,,0,0,0,,Сіз әлі де пышақтың кейпінде қалыпсыз ба?
Dialogue: 0,0:20:18.71,0:20:20.72,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:20.72,0:20:24.72,Default,,0,0,0,,Пышақ сынып қалады деп қорықпай мені кесіп аламын деп ойлама!
Dialogue: 0,0:20:24.72,0:20:26.72,Default,,0,0,0,,Оны қалдырыңыз!
Dialogue: 0,0:20:26.72,0:20:28.72,Default,,0,0,0,,Ооо!
Dialogue: 0,0:20:28.72,0:20:31.73,Default,,0,0,0,,Сіз үнемі сылтау айтасыз.
Dialogue: 0,0:20:31.73,0:20:34.73,Default,,0,0,0,,Нағыз сені қашан кездестіремін деп ойлаймын
Dialogue: 0,0:20:34.73,0:20:37.73,Default,,0,0,0,,Мен сол ғанамын...
Dialogue: 0,0:20:37.73,0:20:40.74,Default,,0,0,0,,Мені қаладың ба?
Dialogue: 0,0:20:40.74,0:20:43.74,Default,,0,0,0,,Мен кіммін? шулы!
Dialogue: 0,0:20:43.74,0:20:47.74,Default,,0,0,0,,Сенің қалағаның Сиан еді, әлгі адам!
Dialogue: 0,0:20:47.74,0:20:50.75,Default,,0,0,0,,Тыныш! Хааа
Dialogue: 0,0:20:50.75,0:20:53.75,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:20:53.75,0:20:56.75,Default,,0,0,0,,Сіз мені естисіз бе? Құдайдың жүрек соғысы
Dialogue: 0,0:20:56.75,0:20:58.75,Default,,0,0,0,,Құдай да бұл шайқаста мақтанады
Dialogue: 0,0:20:58.75,0:21:01.76,Default,,0,0,0,,Бұл қылыш жекпе-жектің жалғыз көрермені – Құдай!
Dialogue: 0,0:21:01.76,0:21:07.76,Default,,0,0,0,,Қоңырау! Енді менің барлық күмәнімді сізден сұрайтын кез келді!
Dialogue: 0,0:21:07.76,0:21:09.76,Default,,0,0,0,,Coo... Coo...
Dialogue: 0,0:21:09.76,0:21:12.77,Default,,0,0,0,,Nnnnn 《Мен оны ұшырып жібергім келеді》
Dialogue: 0,0:21:12.77,0:21:17.77,Default,,0,0,0,,《Бұл зорлық-зомбылықты жеңетін күш! 》
Dialogue: 0,0:21:18.77,0:21:20.78,Default,,0,0,0,,《Жоқ》
Dialogue: 0,0:21:20.78,0:21:24.78,Default,,0,0,0,,《Мен қылышты не үшін ұстап тұрмын? 》
Dialogue: 0,0:21:24.78,0:21:28.78,Default,,0,0,0,,《Сен маған не үйреттің? 》
Dialogue: 0,0:21:28.78,0:21:30.79,Default,,0,0,0,,Тоқта
Dialogue: 0,0:21:31.79,0:21:33.79,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:33.79,0:21:37.79,Default,,0,0,0,,Отан туралы ойлар Утопияны аңсау
Dialogue: 0,0:21:37.79,0:21:43.80,Default,,0,0,0,,Мен тұрған жерді де, өзімді де сүйе алмаудың азабы
Dialogue: 0,0:21:43.80,0:21:46.80,Default,,0,0,0,,Мұнда емес, бір жерде
Dialogue: 0,0:21:47.80,0:21:50.81,Default,,0,0,0,,Әлемді тесіп өту
Dialogue: 0,0:21:50.81,0:21:53.81,Default,,0,0,0,,Әлемді тесіп өт!
Dialogue: 0,0:22:00.82,0:22:20.84,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:20.84,0:22:40.86,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:40.86,0:22:47.86,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:47.86,0:23:00.88,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:00.88,0:23:10.89,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:10.89,0:23:22.90,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:22.90,0:23:29.90,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:29.90,0:23:31.91,Default,,0,0,0,,Менің ерекше емлесі...
Dialogue: 0,0:23:31.91,0:23:33.91,Default,,0,0,0,,Бір ғана жеке болмыс
Dialogue: 0,0:23:33.91,0:23:36.91,Default,,0,0,0,,Күнә менің қолымда! (Китти) Бұл сіздің сахнаңыз.
Dialogue: 0,0:23:36.91,0:23:39.91,Default,,0,0,0,,Иә, сапарға шыққандай.
Dialogue: 0,0:23:41.41,0:23:47.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory