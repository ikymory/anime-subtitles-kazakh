Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:03.00,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:09.51,0:00:11.51,Default,,0,0,0,,Қоңырау?
Dialogue: 0,0:00:11.51,0:00:13.51,Default,,0,0,0,,Бір күні Адонис қамалға келді.
Dialogue: 0,0:00:13.51,0:00:15.51,Default,,0,0,0,,Адонис?
Dialogue: 0,0:00:15.51,0:00:19.52,Default,,0,0,0,,Хм, ол патшамен жасырын түрде аудиторияда болған сияқты...
Dialogue: 0,0:00:19.52,0:00:22.52,Default,,0,0,0,,Маған неге олай айтып тұрсың?
Dialogue: 0,0:00:22.52,0:00:24.52,Default,,0,0,0,,Мен ол адаммен біргемін
Dialogue: 0,0:00:24.52,0:00:27.52,Default,,0,0,0,,1 Қылыш үшін жанжал
Dialogue: 0,0:00:27.52,0:00:29.53,Default,,0,0,0,,Катакомбаларды басқаратын Коллинз отбасына
Dialogue: 0,0:00:29.53,0:00:31.53,Default,,0,0,0,,Ұрпақтан ұрпаққа жалғасып келе жатқан асыл қылыш.
Dialogue: 0,0:00:31.53,0:00:33.53,Default,,0,0,0,,Ах
Dialogue: 0,0:00:33.53,0:00:36.53,Default,,0,0,0,,Сол қылышпен мен Том Коллинзмен шайқастым.
Dialogue: 0,0:00:36.53,0:00:38.53,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:00:38.53,0:00:40.54,Default,,0,0,0,,Бұл қандай қылыш?
Dialogue: 0,0:00:40.54,0:00:43.54,Default,,0,0,0,,Кенхада – бұл патшалықтың қылышы
Dialogue: 0,0:00:43.54,0:00:46.54,Default,,0,0,0,,Патшалыққа өте ұқсас...
Dialogue: 0,0:00:48.54,0:00:50.55,Default,,0,0,0,,Оған осындай мөр басылған
Dialogue: 0,0:00:50.55,0:00:52.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:55.55,0:01:00.56,Default,,0,0,0,,Бұл семсерді алу үшін болған шайқас болды ма?
Dialogue: 0,0:01:00.56,0:01:03.56,Default,,0,0,0,,Бұл Құдай Сөзінің өмірі болды.
Dialogue: 0,0:01:03.56,0:01:06.56,Default,,0,0,0,,Шын мәні өлшеусіз, бірақ...
Dialogue: 0,0:01:06.56,0:01:09.57,Default,,0,0,0,,Қалай болғанда да, қазір менде бар, егер қолымнан келсе
Dialogue: 0,0:01:09.57,0:01:13.57,Default,,0,0,0,,Мен оны Том Коллинздің кіші ұлы Адониске беруді ойладым.
Dialogue: 0,0:01:13.57,0:01:17.57,Default,,0,0,0,,Онда неге тез бермеске?
Dialogue: 0,0:01:17.57,0:01:19.58,Default,,0,0,0,,Ол үшін шарттар бар.
Dialogue: 0,0:01:19.58,0:01:21.58,Default,,0,0,0,,Сол кісінің осы уақытқа дейін алған қылыш.
Dialogue: 0,0:01:21.58,0:01:23.58,Default,,0,0,0,,Барлығын босатыңыз
Dialogue: 0,0:01:23.58,0:01:27.58,Default,,0,0,0,,Иә? Оның мұндай шарттарды қабылдауға мүмкіндігі жоқ.
Dialogue: 0,0:01:27.58,0:01:30.59,Default,,0,0,0,,Менің кіші інім патша ретінде мұны істемесеңіз.
Dialogue: 0,0:01:30.59,0:01:33.59,Default,,0,0,0,,Арқамнан бұл елге тірек.
Dialogue: 0,0:01:33.59,0:01:35.59,Default,,0,0,0,,Мүлде мүмкін емес
Dialogue: 0,0:01:35.59,0:01:38.59,Default,,0,0,0,,Кіші інісі патша? (Гуфф) Иә.
Dialogue: 0,0:01:38.59,0:01:41.60,Default,,0,0,0,,Қылыш шебері болып биікке көтеріле берсең,
Dialogue: 0,0:01:41.60,0:01:43.60,Default,,0,0,0,,Болары сөзсіз.
Dialogue: 0,0:01:43.60,0:01:47.60,Default,,0,0,0,,Эй, ол патша...
Dialogue: 0,0:01:47.60,0:01:50.61,Default,,0,0,0,,Демек, сен менің ағам патшасың.
Dialogue: 0,0:01:50.61,0:01:54.61,Default,,0,0,0,,Сондықтан біз бұл мәселені мүмкіндігінше тезірек шешуіміз керек...
Dialogue: 0,0:01:54.61,0:01:56.61,Default,,0,0,0,,Белл а
Dialogue: 0,0:01:56.61,0:01:59.62,Default,,0,0,0,,Ей... Мен ол жігітпен көп болды.
Dialogue: 0,0:01:59.62,0:02:03.62,Default,,0,0,0,,Түсінемін, өтінемін.
Dialogue: 0,0:02:03.62,0:02:09.63,Default,,0,0,0,,Мен де онымен қайта кездесіп, сөйлесуіміз керек деп ойладым.
Dialogue: 0,0:02:10.63,0:02:12.63,Default,,0,0,0,,Өз жарасын жара ретінде пайдаланады
Dialogue: 0,0:02:12.63,0:02:16.63,Default,,0,0,0,,Өйткені мен ақымақпын, мен оны ешқашан мойындамаймын.
Dialogue: 0,0:02:16.63,0:02:18.63,Default,,0,0,0,,Мен оны дұрыс жеткізгім келеді.
Dialogue: 0,0:02:18.63,0:02:21.64,Default,,0,0,0,,Ауырсыну дегеніміз не?
Dialogue: 0,0:02:21.64,0:02:26.64,Default,,0,0,0,,Өйткені мен мұны қазір істей аламын деп ойлаймын.
Dialogue: 0,0:02:27.64,0:02:45.66,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:45.66,0:02:49.67,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:49.67,0:03:09.69,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:09.69,0:03:29.71,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:29.71,0:03:49.73,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:49.73,0:03:56.73,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:57.73,0:04:01.74,Default,,0,0,0,,Сол... (Асыл) Катакомба шайқасы...
Dialogue: 0,0:04:01.74,0:04:03.74,Default,,0,0,0,,Хо Өтініш дегеніміз не?
Dialogue: 0,0:04:03.74,0:04:05.74,Default,,0,0,0,,Осындай қауесеттер бар сияқты.
Dialogue: 0,0:04:05.74,0:04:09.75,Default,,0,0,0,,Бір күні осы киіммен тасбақа мінгенім есімде.
Dialogue: 0,0:04:09.75,0:04:13.75,Default,,0,0,0,,Біз бір-бірімізді бірінші рет кездестірдік.
Dialogue: 0,0:04:13.75,0:04:15.75,Default,,0,0,0,,Сол кезде И
Dialogue: 0,0:04:15.75,0:04:19.76,Default,,0,0,0,,Мен әрқашан өз жүрегімді өлтіруге тырыстым, бірақ...
Dialogue: 0,0:04:19.76,0:04:21.76,Default,,0,0,0,,Толық өзгерсе өзгереді.
Dialogue: 0,0:04:21.76,0:04:25.76,Default,,0,0,0,,Хехе, өзгерген нәрселерді айтсақ...
Dialogue: 0,0:04:25.76,0:04:28.76,Default,,0,0,0,,Хехехе, мен де өзгердім, білесің бе?
Dialogue: 0,0:04:28.76,0:04:31.77,Default,,0,0,0,,Хмм... (күрсініп) Бұл нені білдіреді?
Dialogue: 0,0:04:31.77,0:04:33.77,Default,,0,0,0,,Менің бойым өсті!
Dialogue: 0,0:04:33.77,0:04:35.77,Default,,0,0,0,,Хо (Гинесу) Міне, міне, осы
Dialogue: 0,0:04:35.77,0:04:37.77,Default,,0,0,0,,Бұл рас! Хмм...
Dialogue: 0,0:04:37.77,0:04:40.78,Default,,0,0,0,,Маған бұл костюмді жөндеген дизайнер айтты.
Dialogue: 0,0:04:40.78,0:04:42.78,Default,,0,0,0,,Оның кеудесі де сәл үлкейіп кетті.
Dialogue: 0,0:04:42.78,0:04:44.78,Default,,0,0,0,,Хохо
Dialogue: 0,0:04:44.78,0:04:46.78,Default,,0,0,0,,Түсініксіз (қол шапалақтау)
Dialogue: 0,0:04:46.78,0:04:49.79,Default,,0,0,0,,Ой... Барса ставкасы.
Dialogue: 0,0:04:49.79,0:04:51.79,Default,,0,0,0,,Қоңырау! Ах
Dialogue: 0,0:04:51.79,0:04:53.79,Default,,0,0,0,,О, сәлем, Шерри!
Dialogue: 0,0:04:53.79,0:04:56.79,Default,,0,0,0,,Өте жақсы қоңырау
Dialogue: 0,0:04:56.79,0:04:58.79,Default,,0,0,0,,Сен де әдемісің
Dialogue: 0,0:04:58.79,0:05:02.80,Default,,0,0,0,,Бұл әншілер тобының костюмі емес пе? Саған өте жарасады
Dialogue: 0,0:05:02.80,0:05:06.80,Default,,0,0,0,,Ержүрек қылышшы және сымбатты әнші (Шерри/Белл) Ах
Dialogue: 0,0:05:06.80,0:05:08.80,Default,,0,0,0,,Шынымен де көркем (Шерри) О...
Dialogue: 0,0:05:08.80,0:05:10.81,Default,,0,0,0,,Кәдімгі қылышшының әңгімесі сияқты.
Dialogue: 0,0:05:10.81,0:05:12.81,Default,,0,0,0,,Енді Белл еркек болса...
Dialogue: 0,0:05:12.81,0:05:14.81,Default,,0,0,0,,Менімен... (Беннет/Джинс) Ах
Dialogue: 0,0:05:14.81,0:05:17.81,Default,,0,0,0,,Мүмкін олар құлыптың дивасы үшін жарысып жатқан шығар.
Dialogue: 0,0:05:17.81,0:05:20.82,Default,,0,0,0,,Не? Ондай жағдайда біз
Dialogue: 0,0:05:20.82,0:05:23.82,Default,,0,0,0,,Сен Беллді қорғап, күнәға батуың керек.
Dialogue: 0,0:05:23.82,0:05:28.82,Default,,0,0,0,,Бұл қылышшы әңгімелерінің стандарты.
Dialogue: 0,0:05:32.83,0:05:35.83,Default,,0,0,0,,Демек, ол Беллдің жақсы қылышшысы ма?
Dialogue: 0,0:05:35.83,0:05:41.84,Default,,0,0,0,,Иә, шайқаста бір-бірімізге арқа сүйей аламыз.
Dialogue: 0,0:05:41.84,0:05:46.84,Default,,0,0,0,,Иә, өсек айтатын болсақ, оның кейбір ерекшеліктері бар, бірақ оның ақыл-ойы шын мәнінде таң қалдырады.
Dialogue: 0,0:05:46.84,0:05:49.85,Default,,0,0,0,,Дұрыс па? Ғафф, бүгінгі күн үшін рахмет.
Dialogue: 0,0:05:49.85,0:05:51.85,Default,,0,0,0,,Не?
Dialogue: 0,0:05:51.85,0:05:55.85,Default,,0,0,0,,Солай бола тұрса да, ол қайта бөлінбейтін сияқты.
Dialogue: 0,0:05:55.85,0:05:58.85,Default,,0,0,0,,Неліктен мен сізге біреуін беруім керек?
Dialogue: 0,0:05:58.85,0:06:01.86,Default,,0,0,0,,О, мен де соны қалаймын.
Dialogue: 0,0:06:01.86,0:06:04.86,Default,,0,0,0,,Солай етіңіз.
Dialogue: 0,0:06:04.86,0:06:06.86,Default,,0,0,0,,Шери Мен олай ойламаймын...
Dialogue: 0,0:06:06.86,0:06:08.86,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:06:08.86,0:06:11.87,Default,,0,0,0,,(Сағат тасының шырылдаған дыбысы)
Dialogue: 0,0:06:11.87,0:06:14.87,Default,,0,0,0,,Уақыт жеткен сияқты
Dialogue: 0,0:06:14.87,0:06:32.89,Default,,0,0,0,,♪♪～
Dialogue: 0,0:06:32.89,0:06:36.89,Default,,0,0,0,,Қылыш шебері аралық дирижер Гиннес
Dialogue: 0,0:06:36.89,0:06:41.90,Default,,0,0,0,,Мен бүгін қылышшылар тобының бас қылышшысы Гафф-дононың рұқсатымен келдім.
Dialogue: 0,0:06:41.90,0:06:47.90,Default,,0,0,0,,Мен өз өтінішімді кішіпейілділікпен ұсыну үшін осы залға келдім.
Dialogue: 0,0:06:47.90,0:06:51.91,Default,,0,0,0,,Біз Катакомбты бейтарап орынға айналдырғымыз келеді...
Dialogue: 0,0:06:51.91,0:06:56.91,Default,,0,0,0,,Шикі тері патшасы, сенің қандай екеніңді көрейік.
Dialogue: 0,0:07:00.92,0:07:02.92,Default,,0,0,0,,​​О?
Dialogue: 0,0:07:02.92,0:07:05.92,Default,,0,0,0,,Патша, мұндағылардың даусын тыңдаңыз...
Dialogue: 0,0:07:05.92,0:07:09.93,Default,,0,0,0,,Халық үні естілуін қалаймын!
Dialogue: 0,0:07:11.93,0:07:14.93,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:07:14.93,0:07:16.93,Default,,0,0,0,,Ах! ше? Беннетт
Dialogue: 0,0:07:16.93,0:07:19.94,Default,,0,0,0,,А... сен мені естисің бе?
Dialogue: 0,0:07:19.94,0:07:21.94,Default,,0,0,0,,Ах
Dialogue: 0,0:07:21.94,0:07:25.94,Default,,0,0,0,,Сол перденің артында жүздеген адам бар...
Dialogue: 0,0:07:25.94,0:07:27.94,Default,,0,0,0,,Ах
Dialogue: 0,0:07:27.94,0:07:30.95,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:30.95,0:07:32.95,Default,,0,0,0,,Ха... (гуф) ха
Dialogue: 0,0:07:32.95,0:07:36.95,Default,,0,0,0,,Жыл!
Dialogue: 0,0:07:37.95,0:07:39.96,Default,,0,0,0,,Ах! Мұнан кеттік!
Dialogue: 0,0:07:39.96,0:07:42.96,Default,,0,0,0,,Мен сізге құдайдың әулие қызы ретінде айтамын ...
Dialogue: 0,0:07:42.96,0:07:44.96,Default,,0,0,0,,Құдай сөзі?
Dialogue: 0,0:07:44.96,0:07:48.96,Default,,0,0,0,,Мен бұл қамалдағы адамдарға қауіп төндіруге тырысамын...
Dialogue: 0,0:07:48.96,0:07:51.97,Default,,0,0,0,,Жын... (Гуфф) Не!?
Dialogue: 0,0:07:51.97,0:07:56.97,Default,,0,0,0,,Ол Құдайда тұрғанда,
Dialogue: 0,0:07:56.97,0:08:03.98,Default,,0,0,0,,Жындық болмысыңызды ашыңыз және енді барлық қамыттарды сындырыңыз...
Dialogue: 0,0:08:03.98,0:08:05.98,Default,,0,0,0,,Оның аты...
Dialogue: 0,0:08:05.98,0:08:07.98,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:08:07.98,0:08:09.99,Default,,0,0,0,,Қаш, Гиннес!
Dialogue: 0,0:08:09.99,0:08:12.99,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:08:18.99,0:08:21.00,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:23.00,0:08:27.00,Default,,0,0,0,,Шикі тері патшасы...?
Dialogue: 0,0:08:27.00,0:08:32.01,Default,,0,0,0,,(Рухиде Кингтің ыңырануы)
Dialogue: 0,0:08:36.01,0:08:39.01,Default,,0,0,0,,(Гиран) Қалай болғанда да, Курокири-сан, комиссия үшін саған сенемін.
Dialogue: 0,0:08:39.01,0:08:42.02,Default,,0,0,0,,Гиннес... Гиннесті сол нәрсе жеп қойды!
Dialogue: 0,0:08:42.02,0:08:46.02,Default,,0,0,0,,Құдайдың үнімен бұйырамын
Dialogue: 0,0:08:46.02,0:08:49.02,Default,,0,0,0,,Нидхог үшін ессіз патша
Dialogue: 0,0:08:49.02,0:08:52.03,Default,,0,0,0,,Стрелецпен жеңіліс
Dialogue: 0,0:08:52.03,0:08:55.03,Default,,0,0,0,,Сіз нені айтып тұрсыз! Әннің аты солай!
Dialogue: 0,0:08:55.03,0:08:57.03,Default,,0,0,0,,Тек кез келген ғимараттарды бұзу үшін
Dialogue: 0,0:08:57.03,0:08:59.03,Default,,0,0,0,,Жою әні!
Dialogue: 0,0:08:59.03,0:09:02.04,Default,,0,0,0,,Әншінің аты Шерри
Dialogue: 0,0:09:02.04,0:09:04.04,Default,,0,0,0,,Әнші бол
Dialogue: 0,0:09:04.04,0:09:07.04,Default,,0,0,0,,Патша апа...
Dialogue: 0,0:09:07.54,0:09:09.54,Default,,0,0,0,,Шери! (Беннет) Бұл келе жатыр!
Dialogue: 0,0:09:09.54,0:09:14.55,Default,,0,0,0,,Не болып жатыр өзі…? ➡
Dialogue: 0,0:09:16.55,0:09:18.55,Default,,0,0,0,,(Мектеп оқушысы) Ой, Хори ханым саған бұны өзі жасап берді ме? Өте сүйкімді екен~
Dialogue: 0,0:09:18.55,0:09:21.56,Default,,0,0,0,,Кішкентай, аа
Dialogue: 0,0:09:21.56,0:09:23.56,Default,,0,0,0,,Шикі тері патшасы!
Dialogue: 0,0:09:23.56,0:09:26.56,Default,,0,0,0,,Өзіңді жоғалт, ха...
Dialogue: 0,0:09:26.56,0:09:30.57,Default,,0,0,0,,Менің бұл залдан кетуіме жол берме.
Dialogue: 0,0:09:30.57,0:09:35.57,Default,,0,0,0,,Мен өзімнің осы қырымды халыққа көрсете алмаймын...
Dialogue: 0,0:09:37.57,0:09:40.58,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:09:41.58,0:09:45.58,Default,,0,0,0,,Мені өлтір...
Dialogue: 0,0:09:47.58,0:09:50.59,Default,,0,0,0,,Ух... Ух... Ух...
Dialogue: 0,0:09:50.59,0:09:54.59,Default,,0,0,0,,Ол түкіріп жатқан бұл қан не?
Dialogue: 0,0:09:55.59,0:09:58.59,Default,,0,0,0,,(айқайлау)
Dialogue: 0,0:09:58.59,0:10:01.60,Default,,0,0,0,,Нх ха ха ха... Шери, қирау әні, тез!
Dialogue: 0,0:10:01.60,0:10:05.60,Default,,0,0,0,,Маған ұнамайды! Маған ұнамайды, әке...
Dialogue: 0,0:10:05.60,0:10:09.60,Default,,0,0,0,,Шери Әкең бұдан былай қиналмасын!
Dialogue: 0,0:10:09.60,0:10:12.61,Default,,0,0,0,,Маған ұнамайды... егер солай істесем...
Dialogue: 0,0:10:12.61,0:10:15.61,Default,,0,0,0,,Мен енді ешқашан ән айта алмаймын
Dialogue: 0,0:10:15.61,0:10:17.61,Default,,0,0,0,,Гафф мен жасаймын!
Dialogue: 0,0:10:17.61,0:10:20.62,Default,,0,0,0,,Жоқ! Құдайдың сөзіне мойынсұнбайды
Dialogue: 0,0:10:20.62,0:10:23.62,Default,,0,0,0,,Патша айтты! Айтыңызшы, тоқтаймын!
Dialogue: 0,0:10:23.62,0:10:26.62,Default,,0,0,0,,Жоқ! Апыр-ай!
Dialogue: 0,0:10:26.62,0:10:29.62,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:10:29.62,0:10:31.63,Default,,0,0,0,,Фуууууу!
Dialogue: 0,0:10:31.63,0:10:33.63,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:10:33.63,0:10:37.63,Default,,0,0,0,,Уф! Ууууууууу...!
Dialogue: 0,0:10:37.63,0:10:39.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:39.63,0:10:41.64,Default,,0,0,0,,Иә! Ха...
Dialogue: 0,0:10:41.64,0:10:44.64,Default,,0,0,0,,Қат! Өмірлік нүкте қайда?
Dialogue: 0,0:10:44.64,0:10:46.64,Default,,0,0,0,,Табылды
Dialogue: 0,0:10:46.64,0:10:48.64,Default,,0,0,0,,Қоңырау! Гиннес әлі тірі!
Dialogue: 0,0:10:48.64,0:10:50.65,Default,,0,0,0,,Бұл – Огимотоя.
Dialogue: 0,0:10:55.65,0:10:57.65,Default,,0,0,0,,(айқайлау)
Dialogue: 0,0:10:59.65,0:11:01.66,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:02.66,0:11:05.66,Default,,0,0,0,,Мен күркіреген қылышты көрдім!
Dialogue: 0,0:11:09.66,0:11:14.67,Default,,0,0,0,,(айқайлау)
Dialogue: 0,0:11:17.67,0:11:19.67,Default,,0,0,0,,Не?
Dialogue: 0,0:11:19.67,0:11:21.68,Default,,0,0,0,,Ол күйіктерді суық сумен салқындатып отырған
Dialogue: 0,0:11:24.68,0:11:26.68,Default,,0,0,0,,Неге...
Dialogue: 0,0:11:26.68,0:11:29.68,Default,,0,0,0,,О, сен...
Dialogue: 0,0:11:30.69,0:11:32.69,Default,,0,0,0,,Мен?
Dialogue: 0,0:11:32.69,0:11:35.69,Default,,0,0,0,,Неліктен ояндың?
Dialogue: 0,0:11:35.69,0:11:38.69,Default,,0,0,0,,Оянбасам ғой.
Dialogue: 0,0:11:38.69,0:11:41.70,Default,,0,0,0,,Мәңгі сол таста...
Dialogue: 0,0:11:41.70,0:11:43.70,Default,,0,0,0,,Не? Ах...
Dialogue: 0,0:11:43.70,0:11:48.70,Default,,0,0,0,,Сенің бар болғандықтан, біз...
Dialogue: 0,0:11:49.70,0:11:51.71,Default,,0,0,0,,Бұл жақтастық! Бұл жақтастық~!
Dialogue: 0,0:11:51.71,0:11:57.71,Default,,0,0,0,,Құтқарушыны растаудан кейін өшіру бағдарламасы...
Dialogue: 0,0:11:57.71,0:11:59.71,Default,,0,0,0,,...жаса
Dialogue: 0,0:11:59.71,0:12:05.72,Default,,0,0,0,,Дене бітімін нығайтуға арналған өмірді ұзартатын ем...
Dialogue: 0,0:12:05.72,0:12:08.72,Default,,0,0,0,,Ұзақ мерзімді криоұйқыға төтеп беру үшін...
Dialogue: 0,0:12:08.72,0:12:13.73,Default,,0,0,0,,Бұдан былай барлық... ойындар...
Dialogue: 0,0:12:13.73,0:12:18.73,Default,,0,0,0,,Тірі қалғанның еркі расталғанға дейін
Dialogue: 0,0:12:18.73,0:12:22.74,Default,,0,0,0,,Тоқтату бағдарламасын белгісіз уақытқа кейінге қалдырыңыз
Dialogue: 0,0:12:22.74,0:12:27.74,Default,,0,0,0,,Бұдан былай барлық... нысандар
Dialogue: 0,0:12:27.74,0:12:32.75,Default,,0,0,0,,Өміршең орта құруды бастаңыз
Dialogue: 0,0:12:32.75,0:12:36.75,Default,,0,0,0,,Тірі жандарды босату
Dialogue: 0,0:12:36.75,0:12:40.76,Default,,0,0,0,,Эволюциялық орта құру
Dialogue: 0,0:12:40.76,0:12:45.76,Default,,0,0,0,,Біз өмір сүруіміздің себебін осы тұлғаға қойдық...
Dialogue: 0,0:12:45.76,0:12:47.76,Default,,0,0,0,,Ал профессор Гожо ше?
Dialogue: 0,0:12:47.76,0:12:49.76,Default,,0,0,0,,Ууууууу...!
Dialogue: 0,0:12:49.76,0:12:54.77,Default,,0,0,0,,Парасатты қыз Себебі сен ояндың
Dialogue: 0,0:12:54.77,0:12:57.77,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:57.77,0:13:00.78,Default,,0,0,0,,Неге...
Dialogue: 0,0:13:01.78,0:13:04.78,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:13:04.78,0:13:07.78,Default,,0,0,0,,Ах... Уф.
Dialogue: 0,0:13:08.78,0:13:12.79,Default,,0,0,0,,Не болып жатыр... А?
Dialogue: 0,0:13:22.80,0:13:27.80,Default,,0,0,0,,Мен нені кесіп алдым?
Dialogue: 0,0:13:27.80,0:13:29.80,Default,,0,0,0,,Гиннес! Ха…
Dialogue: 0,0:13:30.81,0:13:32.81,Default,,0,0,0,,Эй, жақсысың ба? Гиннес
Dialogue: 0,0:13:32.81,0:13:34.81,Default,,0,0,0,,Гиннесті ояту!
Dialogue: 0,0:13:34.81,0:13:38.81,Default,,0,0,0,,Уаааааааа...
Dialogue: 0,0:13:38.81,0:13:40.82,Default,,0,0,0,,Гиннес!
Dialogue: 0,0:13:40.82,0:13:42.82,Default,,0,0,0,,Жарайды, Белл.
Dialogue: 0,0:13:42.82,0:13:45.82,Default,,0,0,0,,Өйткені мен жай ғана армандаймын...
Dialogue: 0,0:13:45.82,0:13:47.82,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:13:47.82,0:13:49.82,Default,,0,0,0,,Құдай ағашының арманы
Dialogue: 0,0:13:49.82,0:13:54.83,Default,,0,0,0,,Мен сол тастан көргенімдей...
Dialogue: 0,0:13:54.83,0:13:56.83,Default,,0,0,0,,Ах
Dialogue: 0,0:13:59.83,0:14:01.84,Default,,0,0,0,,Не...
Dialogue: 0,0:14:02.84,0:14:05.84,Default,,0,0,0,,Ха... осындай нәрсе...
Dialogue: 0,0:14:07.84,0:14:10.85,Default,,0,0,0,,Әке... не болса да!
Dialogue: 0,0:14:10.85,0:14:13.85,Default,,0,0,0,,Бұл, сөзсіз, Раухид патшасы.
Dialogue: 0,0:14:13.85,0:14:15.85,Default,,0,0,0,,Мен өз денемді Құдай ағашына ұсынамын деп ешқашан ойламадым.
Dialogue: 0,0:14:15.85,0:14:17.85,Default,,0,0,0,,Сіз оны осылай қайтара аласыз...
Dialogue: 0,0:14:17.85,0:14:19.85,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:14:19.85,0:14:22.86,Default,,0,0,0,,Не? Жоқ, мен жай ғана кесіп алдым...
Dialogue: 0,0:14:22.86,0:14:27.86,Default,,0,0,0,,А... мен білетін әке
Dialogue: 0,0:14:27.86,0:14:30.87,Default,,0,0,0,,Соңында мен...
Dialogue: 0,0:14:30.87,0:14:33.87,Default,,0,0,0,,Рахмет сізге Белл
Dialogue: 0,0:14:33.87,0:14:35.87,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:35.87,0:14:37.87,Default,,0,0,0,,Мен...
Dialogue: 0,0:14:37.87,0:14:40.88,Default,,0,0,0,,Тірі басылды, ә...
Dialogue: 0,0:14:42.88,0:14:44.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:44.88,0:14:46.88,Default,,0,0,0,,Адонис!
Dialogue: 0,0:14:46.88,0:14:48.88,Default,,0,0,0,,Иә
Dialogue: 0,0:14:50.89,0:14:54.89,Default,,0,0,0,,Күтілгендей, Нидхогтың қалдықтарын кеспей.
Dialogue: 0,0:14:54.89,0:14:57.89,Default,,0,0,0,,Болмыстың өзі бағындырылды ма?
Dialogue: 0,0:14:57.89,0:15:01.90,Default,,0,0,0,,Сенің қарғысың осыны айтады
Dialogue: 0,0:15:01.90,0:15:04.90,Default,,0,0,0,,Бұл жерде қарғыс батаға айналады.
Dialogue: 0,0:15:04.90,0:15:06.90,Default,,0,0,0,,Сіз нені айтып тұрсыз, Адонис?
Dialogue: 0,0:15:06.90,0:15:09.90,Default,,0,0,0,,Құдай Сөзі әлі аяқталған жоқ (саусақтарды сермеу)
Dialogue: 0,0:15:09.90,0:15:12.91,Default,,0,0,0,,А... Шерри?
Dialogue: 0,0:15:12.91,0:15:16.91,Default,,0,0,0,,Тәңірлік тәртіптегі бұйрық
Dialogue: 0,0:15:16.91,0:15:21.92,Default,,0,0,0,,Құдай Сөзінің еркіне қарсы зорлық семсерін ұстағандар.
Dialogue: 0,0:15:21.92,0:15:25.92,Default,,0,0,0,,Тыйым салынған адам деп есептелді... түрмеде.
Dialogue: 0,0:15:25.92,0:15:27.92,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:27.92,0:15:33.93,Default,,0,0,0,,Сол сияқты илаһи тәртіпті бұзатын өтініштер жасағандар...
Dialogue: 0,0:15:33.93,0:15:37.93,Default,,0,0,0,,Ah Bell Ah...
Dialogue: 0,0:15:37.93,0:15:39.93,Default,,0,0,0,,Ах! Мұнан кеттік!
Dialogue: 0,0:15:41.44,0:15:44.44,Default,,0,0,0,,Эй, сәл күте тұрыңыз!
Dialogue: 0,0:15:44.44,0:15:49.44,Default,,0,0,0,,Гиннес Сіздің сценарийіңізде бұл мүмкін бе?
Dialogue: 0,0:15:49.44,0:15:51.45,Default,,0,0,0,,Әй, ғафф! (Гуфф) Бірден бірдеңе жасаңыз
Dialogue: 0,0:15:51.45,0:15:55.45,Default,,0,0,0,,А... (Гуфф) Әзірше шыда, Белл.
Dialogue: 0,0:15:57.45,0:16:01.46,Default,,0,0,0,,Маған ақымақ болма, қылышыңды маған қаратпа!
Dialogue: 0,0:16:01.46,0:16:04.46,Default,,0,0,0,,Жүр, мұнда тыныш бол... Маған қарашы, ғаф!
Dialogue: 0,0:16:04.46,0:16:06.46,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,0:16:06.46,0:16:08.46,Default,,0,0,0,,Әй, Адонис!
Dialogue: 0,0:16:08.46,0:16:10.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:11.47,0:16:13.47,Default,,0,0,0,,Сол қылыш...
Dialogue: 0,0:16:14.47,0:16:16.47,Default,,0,0,0,,Тот басқан тырнақ
Dialogue: 0,0:16:16.47,0:16:18.47,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:18.47,0:16:23.48,Default,,0,0,0,,Гафф Құдай Сөзі соғысатындарды арнайы белгілемейді.
Dialogue: 0,0:16:23.48,0:16:25.48,Default,,0,0,0,,Адонис Лорд...
Dialogue: 0,0:16:25.48,0:16:30.49,Default,,0,0,0,,Осы сарайдың қожасы ретінде маған тезірек бұйрық беріңіз!
Dialogue: 0,0:16:30.49,0:16:34.49,Default,,0,0,0,,Адонис Қоңырауды сізге қалдырамын.
Dialogue: 0,0:16:34.49,0:16:36.49,Default,,0,0,0,,Цукамацуру Анио-ден
Dialogue: 0,0:16:36.49,0:16:39.49,Default,,0,0,0,,Не... Ғафф!
Dialogue: 0,0:16:39.49,0:16:42.50,Default,,0,0,0,,Қоңырау Сіз мені кесіп тастай аласыз ба?
Dialogue: 0,0:16:43.50,0:16:45.50,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:16:50.51,0:16:56.51,Default,,0,0,0,,Біздің мұнда не үшін келгенімізді білесіз бе?
Dialogue: 0,0:16:56.51,0:17:01.52,Default,,0,0,0,,Жарайды, бәрі де кеш.
Dialogue: 0,0:17:01.52,0:17:03.52,Default,,0,0,0,,Мен мұны істедім.
Dialogue: 0,0:17:03.52,0:17:06.52,Default,,0,0,0,,Сіз... сіз мұны істедіңіз бе?
Dialogue: 0,0:17:06.52,0:17:08.52,Default,,0,0,0,,Мына шу! Фуфу
Dialogue: 0,0:17:08.52,0:17:10.53,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:17:10.53,0:17:13.53,Default,,0,0,0,,Сен... ақымақ!
Dialogue: 0,0:17:13.53,0:17:15.53,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:17:15.53,0:17:17.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:18.53,0:17:20.54,Default,,0,0,0,,Цк... Уф!
Dialogue: 0,0:17:20.54,0:17:22.54,Default,,0,0,0,,Уф! Ууууууууууууу!
Dialogue: 0,0:17:22.54,0:17:24.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:24.54,0:17:27.54,Default,,0,0,0,,Ха! Ах...
Dialogue: 0,0:17:27.54,0:17:29.54,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:17:30.55,0:17:32.55,Default,,0,0,0,,Уф…
Dialogue: 0,0:17:34.55,0:17:37.55,Default,,0,0,0,,Уау күшті...
Dialogue: 0,0:17:37.55,0:17:41.56,Default,,0,0,0,,Ах... жалаң қолды қылыш...
Dialogue: 0,0:17:45.56,0:17:48.56,Default,,0,0,0,,Бұл қылыш сіздің жауабыңыз ба?
Dialogue: 0,0:17:48.56,0:17:51.57,Default,,0,0,0,,Содан кейін мен...
Dialogue: 0,0:17:51.57,0:17:53.57,Default,,0,0,0,,Хаа!
Dialogue: 0,0:17:53.57,0:17:55.57,Default,,0,0,0,,Фуууууууу!
Dialogue: 0,0:17:57.57,0:18:00.58,Default,,0,0,0,,)
Dialogue: 0,0:18:00.58,0:18:04.58,Default,,0,0,0,,Ақыры қылыш шешеді!
Dialogue: 0,0:18:08.58,0:18:10.59,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:18:15.59,0:18:18.59,Default,,0,0,0,,Ах... Уф! Ха…
Dialogue: 0,0:18:19.59,0:18:21.60,Default,,0,0,0,,Ландинг!
Dialogue: 0,0:18:21.60,0:18:24.60,Default,,0,0,0,,Хе, ха, анау...
Dialogue: 0,0:18:24.60,0:18:26.60,Default,,0,0,0,,Ол жаншылған болуы керек!
Dialogue: 0,0:18:26.60,0:18:29.60,Default,,0,0,0,,Мәңгі өшетін қылыш
Dialogue: 0,0:18:29.60,0:18:32.61,Default,,0,0,0,,Рустинердің жүзін жоя алатын қылыш, т.б.
Dialogue: 0,0:18:32.61,0:18:34.61,Default,,0,0,0,,Бұл дүниеде жоқ!
Dialogue: 0,0:18:34.61,0:18:36.61,Default,,0,0,0,,《Тамақ іштің бе? Сол қылышқа
Dialogue: 0,0:18:36.61,0:18:39.61,Default,,0,0,0,,Лундинг күші》 (Тот басқан тырнақтардың айқайы)
Dialogue: 0,0:18:39.61,0:18:42.62,Default,,0,0,0,,Не?
Dialogue: 0,0:18:42.62,0:18:46.62,Default,,0,0,0,,Бір жасаушы жасаған екі қылыш жаңғыруда.
Dialogue: 0,0:18:46.62,0:18:50.63,Default,,0,0,0,,Лундингтің жүзінде, мәңгілік туа беретін қылыш
Dialogue: 0,0:18:50.63,0:18:52.63,Default,,0,0,0,,Менің жүзім тартылды
Dialogue: 0,0:18:52.63,0:18:55.63,Default,,0,0,0,,Қиямет! Уууу
Dialogue: 0,0:18:55.63,0:18:58.63,Default,,0,0,0,,Бұл сіздің қарғысыңыздың шынайы табиғаты ма?
Dialogue: 0,0:18:58.63,0:19:02.64,Default,,0,0,0,,Ақыры қолыңа сай қылыш таптың!
Dialogue: 0,0:19:02.64,0:19:05.64,Default,,0,0,0,,Бұл да бата берудің бір түрі.
Dialogue: 0,0:19:05.64,0:19:07.64,Default,,0,0,0,,Уф…
Dialogue: 0,0:19:08.64,0:19:11.65,Default,,0,0,0,,Ой... ннн!
Dialogue: 0,0:19:11.65,0:19:13.65,Default,,0,0,0,,Сондай сұмдық қылыш
Dialogue: 0,0:19:13.65,0:19:15.65,Default,,0,0,0,,Лундингтің ағасы!?
Dialogue: 0,0:19:15.65,0:19:17.65,Default,,0,0,0,,Иә
Dialogue: 0,0:19:22.66,0:19:25.66,Default,,0,0,0,,《Неге...》 Ах!
Dialogue: 0,0:19:25.66,0:19:28.66,Default,,0,0,0,,Сонда сіздің қарғысыңыздың түрі солай ма?
Dialogue: 0,0:19:28.66,0:19:30.67,Default,,0,0,0,,Қарғыс атқыр, бұл қиын!
Dialogue: 0,0:19:30.67,0:19:32.67,Default,,0,0,0,,(Қылыштың айқайы)
Dialogue: 0,0:19:32.67,0:19:35.67,Default,,0,0,0,,Мен сені кесіп тастаймын!
Dialogue: 0,0:19:35.67,0:19:39.67,Default,,0,0,0,,Менің бар болмысымды бағындыра аласың ба?
Dialogue: 0,0:19:39.67,0:19:41.68,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:19:41.68,0:19:43.68,Default,,0,0,0,,Ахх...!
Dialogue: 0,0:19:51.69,0:19:54.69,Default,,0,0,0,,Уф, у…
Dialogue: 0,0:19:54.69,0:19:58.69,Default,,0,0,0,,《Адонис…》
Dialogue: 0,0:19:58.69,0:20:01.70,Default,,0,0,0,,Оның күші одан сайын артып барады.
Dialogue: 0,0:20:01.70,0:20:03.70,Default,,0,0,0,,А…
Dialogue: 0,0:20:03.70,0:20:05.70,Default,,0,0,0,,A… a… aa
Dialogue: 0,0:20:05.70,0:20:07.70,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:20:07.70,0:20:10.71,Default,,0,0,0,,Тек қылыштың бетпердесін жеңу керек.
Dialogue: 0,0:20:10.71,0:20:15.71,Default,,0,0,0,,Қылыш жасаушы ұсталарымызға аманат еткен болашақ
Dialogue: 0,0:20:16.71,0:20:21.72,Default,,0,0,0,,(Тот басқан тырнақтардың айқайы)
Dialogue: 0,0:20:21.72,0:20:23.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:23.72,0:20:25.72,Default,,0,0,0,,Мені көтере алмай
Dialogue: 0,0:20:25.72,0:20:29.72,Default,,0,0,0,,Құдайды сублимациялау мүмкін бе?
Dialogue: 0,0:20:30.73,0:20:32.73,Default,,0,0,0,,Мен өлемін...
Dialogue: 0,0:20:32.73,0:20:34.73,Default,,0,0,0,,《Кім? Не? 》
Dialogue: 0,0:20:34.73,0:20:37.73,Default,,0,0,0,,《Қылыш, қылыш... өледі》
Dialogue: 0,0:20:37.73,0:20:39.73,Default,,0,0,0,,иә...
Dialogue: 0,0:20:39.73,0:20:44.74,Default,,0,0,0,,《Оны жоғалтып алсам, үмітсіздіктен өлемін》
Dialogue: 0,0:20:44.74,0:20:48.74,Default,,0,0,0,,《Мен сынамын》
Dialogue: 0,0:20:48.74,0:20:51.75,Default,,0,0,0,,Парасатты қыз! Ха…
Dialogue: 0,0:20:53.75,0:20:56.75,Default,,0,0,0,,А, сен...
Dialogue: 0,0:20:57.75,0:21:00.76,Default,,0,0,0,,(Тот басқан қылыштың зары)
Dialogue: 0,0:21:00.76,0:21:11.77,Default,,0,0,0,,(Аштық Альянсы Grunt)
Dialogue: 0,0:21:11.77,0:21:13.77,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:13.77,0:21:15.77,Default,,0,0,0,,Уф…
Dialogue: 0,0:21:15.77,0:21:18.77,Default,,0,0,0,,Адонис!
Dialogue: 0,0:21:20.27,0:21:22.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:22.28,0:21:25.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:37.29,0:21:39.29,Default,,0,0,0,,《Саяхатта...》
Dialogue: 0,0:21:44.30,0:21:49.30,Default,,0,0,0,,《Бірге саяхатқа шығайық...》
Dialogue: 0,0:22:00.31,0:22:20.33,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:20.33,0:22:40.35,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:40.35,0:22:43.36,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:43.36,0:23:01.38,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:01.38,0:23:10.38,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:10.38,0:23:21.40,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:21.40,0:23:29.40,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:30.40,0:23:32.41,Default,,0,0,0,,Ақырында толығымен ыдырайтын болады
Dialogue: 0,0:23:32.41,0:23:35.41,Default,,0,0,0,,Саяхаттың кілтін жойыңыз (Ген) Мен неге...
Dialogue: 0,0:23:35.41,0:23:39.41,Default,,0,0,0,,Бұл сіз бен біздің арамыздағы тоғысқан жер.
Dialogue: 0,0:23:40.91,0:23:46.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory