Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.50,0:00:05.50,Default,,0,0,0,,《Мен күштің ұшып кеткенін қалаймын》
Dialogue: 0,0:00:05.50,0:00:10.51,Default,,0,0,0,,《Бұл зорлық-зомбылықты жеңетін күш! 》
Dialogue: 0,0:00:11.51,0:00:13.51,Default,,0,0,0,,《Жоқ》
Dialogue: 0,0:00:13.51,0:00:17.51,Default,,0,0,0,,《Мен қылышты не үшін ұстап тұрмын? 》
Dialogue: 0,0:00:17.51,0:00:21.52,Default,,0,0,0,,Сіз... маған не үйреттіңіз?
Dialogue: 0,0:00:24.52,0:00:26.52,Default,,0,0,0,,((Мен қайтып барғым келеді...теңізге...)) (Кити)((Менің іздегенім
Dialogue: 0,0:00:26.52,0:00:28.52,Default,,0,0,0,,Сіз оны таптыңыз ба? )) (Том)((Менің жүрегімде, кенеттен
Dialogue: 0,0:00:28.52,0:00:30.53,Default,,0,0,0,,Аянның бір көрінісіне сену))
Dialogue: 0,0:00:30.53,0:00:33.53,Default,,0,0,0,,《Менде қазір не бар? 》
Dialogue: 0,0:00:33.53,0:00:36.53,Default,,0,0,0,,《Сен бұл қолдармен не істедің? 》
Dialogue: 0,0:00:36.53,0:00:38.53,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:00:38.53,0:00:42.54,Default,,0,0,0,,《Менің ерекше мөрім қандай...? 》
Dialogue: 0,0:00:42.54,0:00:44.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:47.54,0:00:49.55,Default,,0,0,0,,Тек сол жерде тұрып ұйықтап жат.
Dialogue: 0,0:00:49.55,0:00:55.55,Default,,0,0,0,,Қылышым сынса да, Тегім өзгерсе де
Dialogue: 0,0:00:55.55,0:01:00.56,Default,,0,0,0,,Өзгерісімнің тағдырын өзім шешем.
Dialogue: 0,0:01:00.56,0:01:05.56,Default,,0,0,0,,Мука Югоға саяхатқа бару
Dialogue: 0,0:01:09.57,0:01:11.57,Default,,0,0,0,,О!
Dialogue: 0,0:01:11.57,0:01:13.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:21.58,0:01:23.58,Default,,0,0,0,,Иә
Dialogue: 0,0:01:23.58,0:01:26.58,Default,,0,0,0,,Мен өзімді сынап көремін
Dialogue: 0,0:01:26.58,0:01:29.59,Default,,0,0,0,,Өзіңнің шыққан тегін білу
Dialogue: 0,0:01:29.59,0:01:32.59,Default,,0,0,0,,Сондықтан мен қылышымды сермеп тұрмын
Dialogue: 0,0:01:33.59,0:01:35.59,Default,,0,0,0,,Ха…
Dialogue: 0,0:01:35.59,0:01:40.60,Default,,0,0,0,,Мен де сені осы қылышпен сынаймын.
Dialogue: 0,0:01:40.60,0:01:42.60,Default,,0,0,0,,Иә, Белл.
Dialogue: 0,0:01:42.60,0:01:47.60,Default,,0,0,0,,Қарғыс пен батаңның себебі осы.
Dialogue: 0,0:01:49.61,0:01:51.61,Default,,0,0,0,,Сіз мені кесіп тастай аласыз ба?
Dialogue: 0,0:01:51.61,0:01:54.61,Default,,0,0,0,,Бір ғана жеке болмыс
Dialogue: 0,0:01:54.61,0:01:56.61,Default,,0,0,0,,Қарғыс атсын... Ха!
Dialogue: 0,0:01:57.61,0:01:59.62,Default,,0,0,0,,Мен ол жігітке ештеңе істей алмаймын
Dialogue: 0,0:01:59.62,0:02:02.62,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:02:03.62,0:02:06.62,Default,,0,0,0,,Әлемді тесіп өт!
Dialogue: 0,0:02:07.62,0:02:09.63,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:02:09.63,0:02:13.63,Default,,0,0,0,,Сол кезде мен әлемге қашаламын!
Dialogue: 0,0:02:13.63,0:02:15.63,Default,,0,0,0,,Егер мен шынымен... Уау!
Dialogue: 0,0:02:15.63,0:02:17.63,Default,,0,0,0,,Гүлдену!
Dialogue: 0,0:02:17.63,0:02:35.65,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:35.65,0:02:53.67,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:53.67,0:02:57.67,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:57.67,0:03:17.69,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:17.69,0:03:37.71,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:37.71,0:03:57.73,Default,,0,0,0,,♪♪～
Dialogue: 0,0:03:57.73,0:04:05.74,Default,,0,0,0,,♪♪～
Dialogue: 0,0:04:06.74,0:04:08.74,Default,,0,0,0,,Катакомбалар үшін бұл үлкен мәселе ме?
Dialogue: 0,0:04:08.74,0:04:10.75,Default,,0,0,0,,Катакомбалар мен сарайлар
Dialogue: 0,0:04:10.75,0:04:13.75,Default,,0,0,0,,Бізді кенет жер асты өткелі қосты.
Dialogue: 0,0:04:13.75,0:04:15.75,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:04:15.75,0:04:17.75,Default,,0,0,0,,Бас діни қызметкер Кернел былай дейді:
Dialogue: 0,0:04:17.75,0:04:20.76,Default,,0,0,0,,Ол тек Коллинздің үйінде ғана ұрпақтан-ұрпаққа берілді.
Dialogue: 0,0:04:20.76,0:04:24.76,Default,,0,0,0,,Катакомбалар жұмбақтарымен тығыз байланысты
Dialogue: 0,0:04:24.76,0:04:26.76,Default,,0,0,0,,Құлыпта бірдеңе болып жатыр ма?
Dialogue: 0,0:04:26.76,0:04:28.76,Default,,0,0,0,,Гиннес?
Dialogue: 0,0:04:28.76,0:04:32.77,Default,,0,0,0,,Негізі бізді таң қалдырғаны сол еді
Dialogue: 0,0:04:32.77,0:04:34.77,Default,,0,0,0,,Бұл Гиннестен басқа ешкім туралы емес.
Dialogue: 0,0:04:34.77,0:04:36.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:36.77,0:04:40.78,Default,,0,0,0,,Бұрын Гиннес мырза ядроға жеткізілген қауесеттерді естіген.
Dialogue: 0,0:04:40.78,0:04:44.78,Default,,0,0,0,,Бұл анық болжанған болатын.
Dialogue: 0,0:04:44.78,0:04:47.78,Default,,0,0,0,,Полковник Гиннес және оның тобы
Dialogue: 0,0:04:47.78,0:04:52.79,Default,,0,0,0,,Біз сізді Катакомбтың маңызды мүшесі ретінде қарсы алуды шештік.
Dialogue: 0,0:04:52.79,0:04:59.80,Default,,0,0,0,,Ол... ақыры бізді сценарийіне түсірді.
Dialogue: 0,0:04:59.80,0:05:02.80,Default,,0,0,0,,Біздің отбасы алдыңғы қатарда
Dialogue: 0,0:05:02.80,0:05:05.80,Default,,0,0,0,,Сол жер асты жолын анықтайық.
Dialogue: 0,0:05:05.80,0:05:07.80,Default,,0,0,0,,Мен бұған шыдай алмаймын
Dialogue: 0,0:05:07.80,0:05:10.81,Default,,0,0,0,,Жарайды, бәрібір Гиннеске барамыз.
Dialogue: 0,0:05:10.81,0:05:12.81,Default,,0,0,0,,Мен баруым керек екенін білдім.
Dialogue: 0,0:05:12.81,0:05:14.81,Default,,0,0,0,,Әсіресе тұман.
Dialogue: 0,0:05:14.81,0:05:16.81,Default,,0,0,0,,Уф... ақымақ! (Бұлт) хун
Dialogue: 0,0:05:16.81,0:05:18.81,Default,,0,0,0,,Тез арада кетуге дайындалыңыз!
Dialogue: 0,0:05:18.81,0:05:20.82,Default,,0,0,0,,Мен катакомбалар арқылы қамалға барамын.
Dialogue: 0,0:05:20.82,0:05:22.82,Default,,0,0,0,,О!
Dialogue: 0,0:05:22.82,0:05:24.82,Default,,0,0,0,,Еш жерде…
Dialogue: 0,0:05:24.82,0:05:28.82,Default,,0,0,0,,Ха... Аштық альянсы!
Dialogue: 0,0:05:28.82,0:05:31.83,Default,,0,0,0,,Еш жерде…
Dialogue: 0,0:05:31.83,0:05:34.83,Default,,0,0,0,,Цк... (күрсініп) Қозғалма, Беннет.
Dialogue: 0,0:05:34.83,0:05:37.83,Default,,0,0,0,,Ал... Бірақ жағдай осылай жалғаса берсе...
Dialogue: 0,0:05:37.83,0:05:39.84,Default,,0,0,0,,Бұл сынақ
Dialogue: 0,0:05:39.84,0:05:41.84,Default,,0,0,0,,Мен бас қылышшымын.
Dialogue: 0,0:05:41.84,0:05:44.84,Default,,0,0,0,,Мен халық ретінде мақтанышқа сенемін.
Dialogue: 0,0:05:44.84,0:05:48.84,Default,,0,0,0,,Барлық халықтардың патшасы болуға ұмтылу
Dialogue: 0,0:05:49.85,0:05:52.85,Default,,0,0,0,,Алдамшыны жеңу
Dialogue: 0,0:05:52.85,0:05:56.85,Default,,0,0,0,,《Осындай нәрсеге бағынамын ба?》
Dialogue: 0,0:05:56.85,0:05:59.86,Default,,0,0,0,,《Өздерін жын деп атайтындарды кесіп таста》
Dialogue: 0,0:05:59.86,0:06:02.86,Default,,0,0,0,,《Басқа жол жоқ.》
Dialogue: 0,0:06:02.86,0:06:08.86,Default,,0,0,0,,《Мен көптеген достарымды осы бұйрыққа құрбан еттім, бірақ қазір...》
Dialogue: 0,0:06:08.86,0:06:10.87,Default,,0,0,0,,(Әйел турист 1) Санта-Киара шіркеуіне қалай жетуге болады?
Dialogue: 0,0:06:10.87,0:06:15.87,Default,,0,0,0,,Құдай діни қызметкерлерді де басқарып, Шерри ханшайымға қол қояды ма?
Dialogue: 0,0:06:15.87,0:06:17.87,Default,,0,0,0,,《Мен білмеймін...》
Dialogue: 0,0:06:17.87,0:06:21.88,Default,,0,0,0,,《Менің бұл семсерім қайдан шыққан?》
Dialogue: 0,0:06:21.88,0:06:24.88,Default,,0,0,0,,)
Dialogue: 0,0:06:24.88,0:06:26.88,Default,,0,0,0,,Ха ((менің қылышымда)
Dialogue: 0,0:06:26.88,0:06:29.89,Default,,0,0,0,,Тиісті мәртебе беріңіз))
Dialogue: 0,0:06:29.89,0:06:31.89,Default,,0,0,0,,《Мен оны бір жерден естідім...》
Dialogue: 0,0:06:31.89,0:06:36.89,Default,,0,0,0,,《Бір күні, бір жерде, мен дәл осы сөздерді естідім! 》
Dialogue: 0,0:06:41.90,0:06:44.90,Default,,0,0,0,,Күнә менің қолымда!
Dialogue: 0,0:06:44.90,0:06:46.90,Default,,0,0,0,,Гааа (Дін қызметкері) Уау
Dialogue: 0,0:06:48.90,0:06:51.91,Default,,0,0,0,,Ақыры есіме түсті
Dialogue: 0,0:06:51.91,0:06:54.91,Default,,0,0,0,,Осы қылышты қолыма алған кезде.
Dialogue: 0,0:06:54.91,0:07:00.92,Default,,0,0,0,,Сол мұңды қылыш жазушы маған айтып берді.
Dialogue: 0,0:07:00.92,0:07:03.92,Default,,0,0,0,,((Сіздің ішкі әділдігіңізбен
Dialogue: 0,0:07:03.92,0:07:08.92,Default,,0,0,0,,Осы қылышқа лайықты орын берілсін))
Dialogue: 0,0:07:09.93,0:07:11.93,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:14.43,0:07:18.43,Default,,0,0,0,,Қылышым, маған жол көрсетесің бе?
Dialogue: 0,0:07:18.43,0:07:22.44,Default,,0,0,0,,Менен Құдайға құл болу идеясынан бас тартуымды сұрайсыз ба?
Dialogue: 0,0:07:22.44,0:07:26.44,Default,,0,0,0,,Артықшылықты мақсат тұтып, жалғыз қалған кезім есімде.
Dialogue: 0,0:07:26.44,0:07:30.45,Default,,0,0,0,,Оны өзім кесіп алғанымды қалайсың ба?
Dialogue: 0,0:07:30.45,0:07:33.45,Default,,0,0,0,,Сіз патшасыз
Dialogue: 0,0:07:36.45,0:07:40.46,Default,,0,0,0,,Патша, мені қорғаңызшы.
Dialogue: 0,0:07:40.46,0:07:46.46,Default,,0,0,0,,Таң атқан аспанда түн бойы көтерілгендей
Dialogue: 0,0:07:46.46,0:07:49.46,Default,,0,0,0,,Қасиетті жұлдыздай
Dialogue: 0,0:07:54.47,0:07:59.47,Default,,0,0,0,,Мен патшаның соңғы сынағынан өттім.
Dialogue: 0,0:07:59.47,0:08:01.48,Default,,0,0,0,,Құдай өлді!
Dialogue: 0,0:08:01.48,0:08:04.48,Default,,0,0,0,,Құдайдың еркі менің қолымда!
Dialogue: 0,0:08:04.48,0:08:08.48,Default,,0,0,0,,Енді Алланың қалауы жойылды, шын мәнінде елдің белгісі кім?
Dialogue: 0,0:08:08.48,0:08:11.49,Default,,0,0,0,,Құдай ағашының болаттан соғылған
Dialogue: 0,0:08:11.49,0:08:15.49,Default,,0,0,0,,Бұл патшалықтың қылышы Эмокуру ғана!
Dialogue: 0,0:08:15.49,0:08:17.49,Default,,0,0,0,,Қылышқа бұйрық бер!
Dialogue: 0,0:08:17.49,0:08:21.50,Default,,0,0,0,,Тәңірлік ханшайым халқының әніне кедергі келтірмек болғандар
Dialogue: 0,0:08:21.50,0:08:24.50,Default,,0,0,0,,Олардың бәрін өлтіріңіз!
Dialogue: 0,0:08:27.50,0:08:29.50,Default,,0,0,0,,(Діни қызметкерлердің айқайы)
Dialogue: 0,0:08:29.50,0:08:32.51,Default,,0,0,0,,Кеттік! Қанекей мынаны істейік!
Dialogue: 0,0:08:32.51,0:08:35.51,Default,,0,0,0,,Біз мұны істей аламыз! Қанекей мынаны істейік!
Dialogue: 0,0:08:35.51,0:08:40.52,Default,,0,0,0,,Бас қылышшы! Сіз де біз сияқтысыз...
Dialogue: 0,0:08:40.52,0:08:43.52,Default,,0,0,0,,Елдің жаңа нышаны – осы патшалықтың қылышы.
Dialogue: 0,0:08:43.52,0:08:45.52,Default,,0,0,0,,Сөзсіз саяхаттың кілті
Dialogue: 0,0:08:45.52,0:08:49.52,Default,,0,0,0,,Катакомбтың әні: Бұл идеал емес.
Dialogue: 0,0:08:49.52,0:08:52.53,Default,,0,0,0,,Саяхаттың кілтін ақыры мен бұзады.
Dialogue: 0,0:08:52.53,0:08:56.53,Default,,0,0,0,,А... кілт қолымызда
Dialogue: 0,0:08:56.53,0:09:01.54,Default,,0,0,0,,Кеңғақудың қамалға ұқсамайтын түрі мен халық жолына ұқсайтыны айтылады.
Dialogue: 0,0:09:01.54,0:09:03.54,Default,,0,0,0,,Қалалар мен сарайлар әрқашан болады
Dialogue: 0,0:09:03.54,0:09:07.54,Default,,0,0,0,,Ол Кенгаку үшін эталон және адамдар болуы керек сияқты өмір сүре береді.
Dialogue: 0,0:09:07.54,0:09:10.55,Default,,0,0,0,,Сен сол жерде халықтың патшасы боласың ба?
Dialogue: 0,0:09:10.55,0:09:12.55,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:09:12.55,0:09:16.55,Default,,0,0,0,,Бірінші қадам - ​​бірге күресіп, оларды жеңу.
Dialogue: 0,0:09:16.55,0:09:18.55,Default,,0,0,0,,Қарсылық бар ма?
Dialogue: 0,0:09:18.55,0:09:21.56,Default,,0,0,0,,Сіздің қалауыңыз бойынша, бауырым.
Dialogue: 0,0:09:21.56,0:09:23.56,Default,,0,0,0,,Осы уақытқа дейін жау болдық.
Dialogue: 0,0:09:23.56,0:09:27.56,Default,,0,0,0,,Сіз сыртқы келбетіңіз үшін тым радикалсыз, Беннетт.
Dialogue: 0,0:09:27.56,0:09:29.56,Default,,0,0,0,,Біз Гафф-дономен мәселені шешуіміз керек!
Dialogue: 0,0:09:29.56,0:09:33.57,Default,,0,0,0,,Жау – қараңғылар мен құдайдың аруақтары!
Dialogue: 0,0:09:33.57,0:09:35.57,Default,,0,0,0,,О!
Dialogue: 0,0:09:35.57,0:09:37.57,Default,,0,0,0,,Жақсы! (Діни қызметкерлер) Уау!
Dialogue: 0,0:09:37.57,0:09:39.57,Default,,0,0,0,,Ха! (Дін қызметкері) Хмф!
Dialogue: 0,0:09:39.57,0:09:42.58,Default,,0,0,0,,Ура! (Ай көзді тайпа) Дея!
Dialogue: 0,0:09:42.58,0:09:45.58,Default,,0,0,0,,Бұл шынымен де Құдайдың жаназасы!
Dialogue: 0,0:09:45.58,0:09:48.58,Default,,0,0,0,,Тек өз тегін білетіндерге ғана кешіріледі
Dialogue: 0,0:09:48.58,0:09:51.59,Default,,0,0,0,,Реквием айт!
Dialogue: 0,0:09:59.59,0:10:02.60,Default,,0,0,0,,Қош келдіңіз Шерри ханшайым
Dialogue: 0,0:10:02.60,0:10:05.60,Default,,0,0,0,,Барлығы сахнаға қойылған.
Dialogue: 0,0:10:06.60,0:10:08.60,Default,,0,0,0,,Бұл менің шын тілегім
Dialogue: 0,0:10:08.60,0:10:12.61,Default,,0,0,0,,Барлығы өзіңізге байланысты
Dialogue: 0,0:10:20.62,0:10:22.62,Default,,0,0,0,,Сіз қазір кетесіз бе?
Dialogue: 0,0:10:22.62,0:10:26.62,Default,,0,0,0,,Аштық альянсы қайта пайда болды деген нені білдіреді?
Dialogue: 0,0:10:26.62,0:10:31.63,Default,,0,0,0,,Әлгі жас қасқырдың қауіпті іс жасағалы тұрғанының дәлелі.
Dialogue: 0,0:10:31.63,0:10:36.63,Default,,0,0,0,,Сонда менің әндерімді ешкім тыңдамайды?
Dialogue: 0,0:10:36.63,0:10:39.63,Default,,0,0,0,,Өз әнімді бірінші рет айтып отырмын.
Dialogue: 0,0:10:39.63,0:10:42.64,Default,,0,0,0,,Бұл сарайдың барлығы сіздің аудиторияңыз.
Dialogue: 0,0:10:42.64,0:10:46.64,Default,,0,0,0,,Сіздің әніңіз Беллге де, бізге де керек.
Dialogue: 0,0:10:46.64,0:10:50.65,Default,,0,0,0,,Тегіңді жоғалтпай дүниеден өтесің.
Dialogue: 0,0:10:51.65,0:10:55.65,Default,,0,0,0,,Жүріңіз, Шерри ханшайым, бұл сіздің сахнаңыз.
Dialogue: 0,0:10:55.65,0:10:58.65,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:11:03.66,0:11:08.66,Default,,0,0,0,,Құрметті Саяхатшы Ұзынқұлақ тайпасы, маған тағы бір нәрсе айтқым келеді.
Dialogue: 0,0:11:08.66,0:11:13.67,Default,,0,0,0,,Менің әнімді білесің бе?
Dialogue: 0,0:11:13.67,0:11:16.67,Default,,0,0,0,,Тек ән айт
Dialogue: 0,0:11:16.67,0:11:20.68,Default,,0,0,0,,Саяхатқа шыққандай
Dialogue: 0,0:11:24.68,0:11:29.68,Default,,0,0,0,,Иә, сапарға шыққандай.
Dialogue: 0,0:11:40.70,0:11:42.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:42.70,0:11:46.70,Default,,0,0,0,,Гаха! Ах...
Dialogue: 0,0:11:46.70,0:11:50.71,Default,,0,0,0,,《Сен нені кестің? 》
Dialogue: 0,0:11:50.71,0:11:52.71,Default,,0,0,0,,Ах
Dialogue: 0,0:11:52.71,0:11:56.71,Default,,0,0,0,,Дүрілдеген қылыш қалыпты жағдайға оралады...
Dialogue: 0,0:11:56.71,0:11:58.71,Default,,0,0,0,,Ах
Dialogue: 0,0:11:58.71,0:12:02.72,Default,,0,0,0,,Хэхе... хахаха
Dialogue: 0,0:12:02.72,0:12:09.72,Default,,0,0,0,,Бұл қылыштың маған зиян тигізуі мүмкін емес.
Dialogue: 0,0:12:09.72,0:12:13.73,Default,,0,0,0,,Өлуін жалғастыратын болат
Dialogue: 0,0:12:13.73,0:12:16.73,Default,,0,0,0,,Қанша сынса да
Dialogue: 0,0:12:16.73,0:12:21.74,Default,,0,0,0,,Өлуді жалғастыру және қайта тірілу
Dialogue: 0,0:12:21.74,0:12:23.74,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:12:23.74,0:12:26.74,Default,,0,0,0,,Жаңғыру өте баяу
Dialogue: 0,0:12:26.74,0:12:32.75,Default,,0,0,0,,Өйткені сенің жүзің бұл қылышты басқа нәрсеге айналдырды.
Dialogue: 0,0:12:32.75,0:12:35.75,Default,,0,0,0,,Сөйлеме, өлесің, ха...
Dialogue: 0,0:12:35.75,0:12:38.75,Default,,0,0,0,,Мен өлетін болсам, мұндай нәрседен өлгенім артық.
Dialogue: 0,0:12:38.75,0:12:40.76,Default,,0,0,0,,Осыны айт және өл
Dialogue: 0,0:12:40.76,0:12:44.76,Default,,0,0,0,,Күткендей мен саған ғашық болдым. Кешіріңіз.
Dialogue: 0,0:12:45.76,0:12:48.76,Default,,0,0,0,,Тағы бір… үкі ме?
Dialogue: 0,0:12:49.76,0:12:51.77,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:12:51.77,0:12:54.77,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:12:54.77,0:12:56.77,Default,,0,0,0,,Ах
Dialogue: 0,0:12:58.27,0:13:00.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:00.28,0:13:02.28,Default,,0,0,0,,Шірімейді
Dialogue: 0,0:13:02.28,0:13:05.28,Default,,0,0,0,,Ах... иә.
Dialogue: 0,0:13:05.28,0:13:09.28,Default,,0,0,0,,Дүние әрқашан кеш болғанша күтеді
Dialogue: 0,0:13:09.28,0:13:11.29,Default,,0,0,0,,Татуласу үшін маған хабарласыңыз.
Dialogue: 0,0:13:11.29,0:13:13.29,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:15.29,0:13:17.29,Default,,0,0,0,,Сіз мені әлі өлтірген жоқсыз!
Dialogue: 0,0:13:17.29,0:13:20.30,Default,,0,0,0,,Уау... Иә?
Dialogue: 0,0:13:20.30,0:13:22.30,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:22.30,0:13:24.30,Default,,0,0,0,,(Құдайдың жүрек соғысы)
Dialogue: 0,0:13:24.30,0:13:28.30,Default,,0,0,0,,(жылау)
Dialogue: 0,0:13:28.30,0:13:30.31,Default,,0,0,0,,Уф…
Dialogue: 0,0:13:30.31,0:13:33.31,Default,,0,0,0,,Қоңырау, оянатын кез келді.
Dialogue: 0,0:13:33.31,0:13:38.31,Default,,0,0,0,,Құдай енді өзінің әпкесі Шеллидің әнін де тыңдамайды.
Dialogue: 0,0:13:38.31,0:13:42.32,Default,,0,0,0,,Тіпті ағасы Ғаффтың қылышына да сезімтал емес.
Dialogue: 0,0:13:42.32,0:13:47.32,Default,,0,0,0,,Әрине, мен сенің қарындасыңның патшасы болуым керек, тіпті сен ырылдасаң да.
Dialogue: 0,0:13:48.32,0:13:52.33,Default,,0,0,0,,Менің көлеңкемнен кел, Ашаршылық Одағының азуы.
Dialogue: 0,0:13:52.33,0:13:58.33,Default,,0,0,0,,Енді механикалық құдайға сұрақ қоятын кез келді!
Dialogue: 0,0:13:58.33,0:14:00.34,Default,,0,0,0,,Еш жерде…
Dialogue: 0,0:14:00.34,0:14:02.34,Default,,0,0,0,,Қарғыс атсын... қара.
Dialogue: 0,0:14:02.34,0:14:08.34,Default,,0,0,0,,Механикалық құдай не үшін туды және ол не үшін аш болды?
Dialogue: 0,0:14:08.34,0:14:13.35,Default,,0,0,0,,Кіші патша ретінде менің жоқтауым оның аштығын көрсетеді!
Dialogue: 0,0:14:13.35,0:14:23.36,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:23.36,0:14:26.36,Default,,0,0,0,,Бұл... сынаушының күлі ме!?
Dialogue: 0,0:14:26.36,0:14:31.37,Default,,0,0,0,,(Көлеңке шеберлерінің ыңырануы)
Dialogue: 0,0:14:37.37,0:14:39.37,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:14:39.37,0:14:42.38,Default,,0,0,0,,Енді соны ашып, табынатын кез!
Dialogue: 0,0:14:42.38,0:14:45.38,Default,,0,0,0,,Бұл құдайдың түрінен босатылған нәрсе - бұл
Dialogue: 0,0:14:45.38,0:14:47.38,Default,,0,0,0,,Құдайдың аштығы
Dialogue: 0,0:14:47.38,0:14:51.39,Default,,0,0,0,,Аштық альянсының туған жері!
Dialogue: 0,0:14:51.39,0:14:53.39,Default,,0,0,0,,Адонис!
Dialogue: 0,0:14:55.39,0:14:57.39,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:14:57.39,0:14:59.39,Default,,0,0,0,,Ха! Китти!
Dialogue: 0,0:14:59.39,0:15:02.40,Default,,0,0,0,,Қандай күш!
Dialogue: 0,0:15:04.40,0:15:07.40,Default,,0,0,0,,Ха... не?
Dialogue: 0,0:15:09.40,0:15:11.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:11.41,0:15:14.41,Default,,0,0,0,,Бұл... Құдай ма?
Dialogue: 0,0:15:15.41,0:15:18.41,Default,,0,0,0,,Деміңді ұста, а
Dialogue: 0,0:15:18.41,0:15:20.42,Default,,0,0,0,,Жүздеген және мыңдаған жылдардан кейін
Dialogue: 0,0:15:20.42,0:15:25.42,Default,,0,0,0,,Сақталған ақпарат Жадының тигельінен
Dialogue: 0,0:15:25.42,0:15:30.43,Default,,0,0,0,,Құдай аштық енді қалыптаса бастады
Dialogue: 0,0:15:30.43,0:15:32.43,Default,,0,0,0,,Ha
Dialogue: 0,0:15:32.43,0:15:36.43,Default,,0,0,0,,Менің... келбетім?
Dialogue: 0,0:15:37.43,0:15:42.44,Default,,0,0,0,,Құдай мен үшін аш болды ма?
Dialogue: 0,0:15:42.44,0:15:44.44,Default,,0,0,0,,Әлі жоқ, Белл! Ах...
Dialogue: 0,0:15:44.44,0:15:47.44,Default,,0,0,0,,Егер сіз аралассаңыз, ештеңе істей алмайсыз.
Dialogue: 0,0:15:47.44,0:15:49.44,Default,,0,0,0,,Күтіңіз
Dialogue: 0,0:15:49.44,0:15:54.45,Default,,0,0,0,,Мен шақырған басқа құстың әні шырқалғанша.
Dialogue: 0,0:15:56.45,0:15:58.45,Default,,0,0,0,,Ha
Dialogue: 0,0:15:58.45,0:16:09.46,Default,,0,0,0,,♪♪～
Dialogue: 0,0:16:09.46,0:16:11.47,Default,,0,0,0,,Адонис?
Dialogue: 0,0:16:12.47,0:16:15.47,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:15.47,0:16:18.47,Default,,0,0,0,,Парасатты қыз...
Dialogue: 0,0:16:18.47,0:16:24.48,Default,,0,0,0,,Мен сенің ішіңде еріп барамын
Dialogue: 0,0:16:24.48,0:16:28.48,Default,,0,0,0,,Сен шынымен мен болғың келе ме?
Dialogue: 0,0:16:28.48,0:16:30.49,Default,,0,0,0,,Бүгін жаңа мектепке бірінші күнің ғой?
Dialogue: 0,0:16:32.49,0:16:35.49,Default,,0,0,0,,♪ (ән айту)
Dialogue: 0,0:16:35.49,0:16:38.49,Default,,0,0,0,,Ха (Адонис/бұл) иә?
Dialogue: 0,0:16:38.49,0:16:40.50,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:40.50,0:16:43.50,Default,,0,0,0,,♪(Шерридің ән салған дауысы)
Dialogue: 0,0:16:43.50,0:16:45.50,Default,,0,0,0,,Бұл ән.
Dialogue: 0,0:16:45.50,0:16:59.51,Default,,0,0,0,,♪～
Dialogue: 0,0:16:59.51,0:17:01.52,Default,,0,0,0,,Шерри…
Dialogue: 0,0:17:01.52,0:17:12.53,Default,,0,0,0,,♪～
Dialogue: 0,0:17:12.53,0:17:14.53,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:17:15.53,0:17:17.53,Default,,0,0,0,,Көк әулиелік!
Dialogue: 0,0:17:17.53,0:17:19.53,Default,,0,0,0,,Тіпті мына жігіттер ме?
Dialogue: 0,0:17:19.53,0:17:32.55,Default,,0,0,0,,♪～
Dialogue: 0,0:17:32.55,0:17:34.55,Default,,0,0,0,,Хаа!
Dialogue: 0,0:17:34.55,0:17:38.55,Default,,0,0,0,,Еш қағыспа, арғы жақтан нағыз құдайдың әні естіледі.
Dialogue: 0,0:17:38.55,0:17:41.56,Default,,0,0,0,,Біздің қорғаныш әнімізді тыңдаңдар!
Dialogue: 0,0:17:41.56,0:17:45.56,Default,,0,0,0,,Біз қорғайтын нәрсе бізді де қорғайды!
Dialogue: 0,0:17:45.56,0:17:49.56,Default,,0,0,0,,Жүр! Қылыш мақтаныш әнін шырқасын!
Dialogue: 0,0:17:49.56,0:17:51.57,Default,,0,0,0,,Діни қызметкерлер де, қылышшылар да
Dialogue: 0,0:17:51.57,0:17:54.57,Default,,0,0,0,,Барлығы Құдай Сөзінсіз күресіп жатыр!
Dialogue: 0,0:17:54.57,0:17:59.57,Default,,0,0,0,,Әркім өз заңын іздеуде өз билігін пайдаланады!
Dialogue: 0,0:17:59.57,0:18:05.58,Default,,0,0,0,,Бұл елді жаңа бағытқа апаратын қылыштаудың бұрын-соңды болмаған түрі!
Dialogue: 0,0:18:05.58,0:18:15.59,Default,,0,0,0,,♪～
Dialogue: 0,0:18:15.59,0:18:18.59,Default,,0,0,0,,Ханшайым әні орындалады
Dialogue: 0,0:18:18.59,0:18:22.60,Default,,0,0,0,,♪～
Dialogue: 0,0:18:22.60,0:18:26.60,Default,,0,0,0,,(Moon Eye Clan) сарайы... ән айтып жатыр ма?
Dialogue: 0,0:18:26.60,0:18:28.60,Default,,0,0,0,,♪～
Dialogue: 0,0:18:28.60,0:18:30.61,Default,,0,0,0,,Бұл не? Бұл
Dialogue: 0,0:18:30.61,0:18:33.61,Default,,0,0,0,,Иә? (Тұман) Бұлт! Сіздің аяқтарыңыз ...
Dialogue: 0,0:18:33.61,0:18:35.61,Default,,0,0,0,,Ауырсыну басылды!
Dialogue: 0,0:18:35.61,0:18:39.61,Default,,0,0,0,,Енді менің қылышымды мазақ ететін ешкім жоқ!
Dialogue: 0,0:18:39.61,0:18:42.62,Default,,0,0,0,,Менің қылышымда Құдайдың қалауы бар!
Dialogue: 0,0:18:42.62,0:18:46.62,Default,,0,0,0,,Кел, ән айт! Біздің жаңа шайқас!
Dialogue: 0,0:18:46.62,0:18:49.62,Default,,0,0,0,,Бұл біздің бастапқы нүктеміз болсын!
Dialogue: 0,0:18:49.62,0:18:52.63,Default,,0,0,0,,Сәлем Сиан
Dialogue: 0,0:18:52.63,0:18:56.63,Default,,0,0,0,,Мен өте қатыгез ән естимін
Dialogue: 0,0:18:56.63,0:18:59.63,Default,,0,0,0,,Қуаныш үшін
Dialogue: 0,0:18:59.63,0:19:02.64,Default,,0,0,0,,Өлген және механикаландырылған
Dialogue: 0,0:19:02.64,0:19:06.64,Default,,0,0,0,,Мен саған жүгірейін деп жатырмын, Сол аштықтың көзі.
Dialogue: 0,0:19:06.64,0:19:10.65,Default,,0,0,0,,Бұл Құдайдың аштығы
Dialogue: 0,0:19:10.65,0:19:15.65,Default,,0,0,0,,Сайып келгенде, діни қызметкер мен «Аштық альянсының» тамыры бір.
Dialogue: 0,0:19:15.65,0:19:21.66,Default,,0,0,0,,Менің мұндағы мақсатым сенен қылышымды сынау!
Dialogue: 0,0:19:22.66,0:19:38.67,Default,,0,0,0,,♪～
Dialogue: 0,0:19:38.67,0:19:40.68,Default,,0,0,0,,《…》
Dialogue: 0,0:19:40.68,0:19:47.68,Default,,0,0,0,,《Құдайдың жадының өзегінде тұрған жазылған дене?》
Dialogue: 0,0:19:47.68,0:19:53.69,Default,,0,0,0,,《Дүниенің басында Құдайдың бар болу себебін осылай жаратты》
Dialogue: 0,0:19:53.69,0:19:56.69,Default,,0,0,0,,Жақсы... Жоқ!
Dialogue: 0,0:19:56.69,0:20:00.70,Default,,0,0,0,,Мен өлмеймін.
Dialogue: 0,0:20:00.70,0:20:07.70,Default,,0,0,0,,Оған дейін бұл дүниеден құдайдың құдіреті сөнеді!
Dialogue: 0,0:20:07.70,0:20:11.71,Default,,0,0,0,,♪～
Dialogue: 0,0:20:11.71,0:20:13.71,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:20:13.71,0:20:16.71,Default,,0,0,0,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:20:16.71,0:20:21.72,Default,,0,0,0,,Құдайдың ақыл-ойы өзінің себебін жадында іздейді.
Dialogue: 0,0:20:21.72,0:20:25.72,Default,,0,0,0,,Ол сол формада пайда болды.
Dialogue: 0,0:20:25.72,0:20:27.72,Default,,0,0,0,,Бұл жігіт кім...
Dialogue: 0,0:20:27.72,0:20:30.73,Default,,0,0,0,,Қызық, менің бет-әлпетіме еліктеу оңай ма?
Dialogue: 0,0:20:30.73,0:20:32.73,Default,,0,0,0,,Жоғарыдағылардан мен шынайы Кира екенімді түсінесіз деп ойлаймын.
Dialogue: 0,0:20:32.73,0:20:35.73,Default,,0,0,0,,Өйткені сен жалғызсың
Dialogue: 0,0:20:35.73,0:20:39.73,Default,,0,0,0,,Өйткені бұл дүниеде барлардың барлығының бастауы.
Dialogue: 0,0:20:39.73,0:20:41.74,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:20:41.74,0:20:47.74,Default,,0,0,0,,Біздің ұйым көптеген ұрпақтар бойына буындық өзгерістерге ұшырады.
Dialogue: 0,0:20:47.74,0:20:51.75,Default,,0,0,0,,Бірінші орында себеп-салдар қыз
Dialogue: 0,0:20:51.75,0:20:56.75,Default,,0,0,0,,Ақылдың қызы дүниені тескенде
Dialogue: 0,0:20:56.75,0:21:00.76,Default,,0,0,0,,Біз өз болмысымызды жоғалтамыз
Dialogue: 0,0:21:00.76,0:21:05.76,Default,,0,0,0,,Менің шыққан жерімді білу сені өлтіре ме?
Dialogue: 0,0:21:05.76,0:21:09.76,Default,,0,0,0,,Иә, себебі мен салдарын айтып берейін.
Dialogue: 0,0:21:09.76,0:21:14.77,Default,,0,0,0,,Өйткені біз сол мақсаттың механизміміз.
Dialogue: 0,0:21:14.77,0:21:19.77,Default,,0,0,0,,Біз тұрған кеңістікке қадам бас.
Dialogue: 0,0:21:19.77,0:21:21.78,Default,,0,0,0,,Парасатты қыз
Dialogue: 0,0:21:21.78,0:21:23.78,Default,,0,0,0,,Мен оны… есептей алмаймын.
Dialogue: 0,0:21:23.78,0:21:25.78,Default,,0,0,0,,Мен сені сол балшық қайыққа мінгіземін.
Dialogue: 0,0:21:25.78,0:21:28.78,Default,,0,0,0,,Сіз қандай жоспар құрсаңыз да
Dialogue: 0,0:21:28.78,0:21:31.79,Default,,0,0,0,,Бұл қылыш бәрін сынап көреді!
Dialogue: 0,0:21:32.79,0:21:38.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:40.80,0:21:42.80,Default,,0,0,0,,Ах
Dialogue: 0,0:21:44.80,0:21:46.80,Default,,0,0,0,,Ha
Dialogue: 0,0:21:46.80,0:21:48.80,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:21:48.80,0:21:54.81,Default,,0,0,0,,Бұл ескі құдайлардың жұмағы
Dialogue: 0,0:22:00.82,0:22:20.84,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:20.84,0:22:40.86,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:40.86,0:22:47.86,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:47.86,0:23:01.88,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:01.88,0:23:09.88,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:09.88,0:23:22.90,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:22.90,0:23:29.90,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:30.40,0:23:32.41,Default,,0,0,0,,Мен жалғыз ойнағанды ​​ұнатпаймын!
Dialogue: 0,0:23:32.41,0:23:35.41,Default,,0,0,0,,Қарым-қатынасыңызды өзгертіңіз! Оның жойылуын бізден сұрайсың ба?
Dialogue: 0,0:23:35.41,0:23:39.41,Default,,0,0,0,,Енді меннен қалаған сөздеріңді айта аласыңдар
Dialogue: 0,0:23:40.91,0:23:46.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory