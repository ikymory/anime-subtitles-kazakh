Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.00,0:00:03.00,Default,,0,0,0,,Ha
Dialogue: 0,0:00:03.00,0:00:06.00,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,Монтаждаушы бір рет жеткізілген уақыт.
Dialogue: 0,0:00:11.01,0:00:16.01,Default,,0,0,0,,Бұл ескі құдайлардың жұмағы
Dialogue: 0,0:00:16.01,0:00:18.01,Default,,0,0,0,,Ах
Dialogue: 0,0:00:18.01,0:00:20.02,Default,,0,0,0,,Бұл ай.
Dialogue: 0,0:00:20.02,0:00:23.02,Default,,0,0,0,,Ай - дүниенің аты
Dialogue: 0,0:00:23.02,0:00:27.02,Default,,0,0,0,,Өзгеріс атауы Өлу мен қайта туылу синонимі
Dialogue: 0,0:00:27.02,0:00:30.03,Default,,0,0,0,,Ай…
Dialogue: 0,0:00:30.03,0:00:32.03,Default,,0,0,0,,Га
Dialogue: 0,0:00:32.03,0:00:41.04,Default,,0,0,0,,♪♪～
Dialogue: 0,0:00:41.04,0:00:46.04,Default,,0,0,0,,♪♪～
Dialogue: 0,0:00:46.04,0:00:48.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:48.04,0:00:51.05,Default,,0,0,0,,Ах...!
Dialogue: 0,0:00:52.05,0:00:55.05,Default,,0,0,0,,Бұл құдайлардың ымырт мезгілі.
Dialogue: 0,0:00:56.05,0:01:02.06,Default,,0,0,0,,Кету, жойылудан құтылу
Dialogue: 0,0:01:03.06,0:01:07.06,Default,,0,0,0,,Сол күні құдайдың ымырт қараңғысы келді
Dialogue: 0,0:01:07.06,0:01:12.07,Default,,0,0,0,,Қасиетті жұлдыздан барлық құдайлар ұшып кеткенде...
Dialogue: 0,0:01:12.07,0:01:16.07,Default,,0,0,0,,Бір нәрсе... тасталған ба?
Dialogue: 0,0:01:18.07,0:01:22.08,Default,,0,0,0,,А, мен!? Ах!
Dialogue: 0,0:01:24.08,0:01:27.08,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:01:27.08,0:01:34.09,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:34.09,0:01:39.09,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:39.09,0:01:42.10,Default,,0,0,0,,♪♪～
Dialogue: 0,0:01:42.10,0:01:45.10,Default,,0,0,0,,)
Dialogue: 0,0:01:48.10,0:02:02.12,Default,,0,0,0,,♪♪～
Dialogue: 0,0:02:02.12,0:02:05.12,Default,,0,0,0,,)
Dialogue: 0,0:02:05.12,0:02:07.12,Default,,0,0,0,,()
Dialogue: 0,0:02:07.12,0:02:10.13,Default,,0,0,0,,Құдай бізді тастап кетті
Dialogue: 0,0:02:10.13,0:02:13.13,Default,,0,0,0,,Бағдарламаның үзілуіне байланысты
Dialogue: 0,0:02:13.13,0:02:18.13,Default,,0,0,0,,Ауырып қалтырап, Мәңгі ұйықтайын деп қалдым
Dialogue: 0,0:02:18.13,0:02:21.14,Default,,0,0,0,,Сонда сіз пайда болдыңыз
Dialogue: 0,0:02:21.14,0:02:23.14,Default,,0,0,0,,()
Dialogue: 0,0:02:23.14,0:02:27.14,Default,,0,0,0,,《Бұл ойын орны》
Dialogue: 0,0:02:27.14,0:02:30.15,Default,,0,0,0,,《Бәрі осында болуы керек》
Dialogue: 0,0:02:30.15,0:02:33.15,Default,,0,0,0,,《Олар осында ойнауы керек》
Dialogue: 0,0:02:35.15,0:02:37.15,Default,,0,0,0,,)
Dialogue: 0,0:02:38.15,0:02:41.16,Default,,0,0,0,,Құдай-ай!! Одан құтыла алмай жатырмын!!
Dialogue: 0,0:02:41.16,0:02:43.16,Default,,0,0,0,,)
Dialogue: 0,0:02:44.16,0:02:47.16,Default,,0,0,0,,)
Dialogue: 0,0:02:47.16,0:02:49.16,Default,,0,0,0,,)
Dialogue: 0,0:02:49.16,0:02:53.17,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:02:53.17,0:02:57.17,Default,,0,0,0,,((Қош келдіңіз! Қош келдіңіз!)
Dialogue: 0,0:02:58.17,0:03:01.18,Default,,0,0,0,,((Бұл құдайдың ләззат алуға арналған ойын-сауық саябағы))
Dialogue: 0,0:03:01.18,0:03:05.18,Default,,0,0,0,,((Біз құдайлардың ләззатының тұмарымыз))
Dialogue: 0,0:03:05.18,0:03:09.18,Default,,0,0,0,,((Кел ойнайық!)) (Қуыршақ)((Бірге ойнайық!))
Dialogue: 0,0:03:12.19,0:03:15.19,Default,,0,0,0,,Қуандық
Dialogue: 0,0:03:15.19,0:03:18.19,Default,,0,0,0,,Сіз бар болғанша
Dialogue: 0,0:03:18.19,0:03:23.20,Default,,0,0,0,,Бізде мәңгі болу үшін себеп болуы мүмкін
Dialogue: 0,0:03:28.20,0:03:33.21,Default,,0,0,0,,(қылыш ойнайтын дыбыс)
Dialogue: 0,0:03:33.21,0:03:36.21,Default,,0,0,0,,)
Dialogue: 0,0:03:37.21,0:03:39.21,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:03:39.21,0:03:42.22,Default,,0,0,0,,)
Dialogue: 0,0:03:42.22,0:03:44.22,Default,,0,0,0,,()
Dialogue: 0,0:03:44.22,0:03:48.22,Default,,0,0,0,,)
Dialogue: 0,0:03:48.22,0:03:52.23,Default,,0,0,0,,)
Dialogue: 0,0:03:52.23,0:03:56.23,Default,,0,0,0,,)
Dialogue: 0,0:03:57.23,0:04:00.24,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:00.24,0:04:04.24,Default,,0,0,0,,)
Dialogue: 0,0:04:04.24,0:04:06.24,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:06.24,0:04:10.25,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:10.25,0:04:13.25,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:13.25,0:04:17.25,Default,,0,0,0,,((Бірақ бәрі содан басталды))
Dialogue: 0,0:04:17.25,0:04:19.25,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:19.25,0:04:24.26,Default,,0,0,0,,((Себебі мен бір сөз айттым...))
Dialogue: 0,0:04:24.26,0:04:26.26,Default,,0,0,0,,(фортепианода ойнау дыбысы)
Dialogue: 0,0:04:26.26,0:04:29.26,Default,,0,0,0,,Жалпы практикалық емтихан нәтижелері шықты
Dialogue: 0,0:04:35.27,0:04:38.27,Default,,0,0,0,,)
Dialogue: 0,0:04:38.27,0:04:41.28,Default,,0,0,0,,)
Dialogue: 0,0:04:41.28,0:04:43.28,Default,,0,0,0,,)
Dialogue: 0,0:04:43.28,0:04:46.28,Default,,0,0,0,,)
Dialogue: 0,0:04:47.28,0:04:51.29,Default,,0,0,0,,Сен мәңгілік емес едің
Dialogue: 0,0:04:51.29,0:04:54.29,Default,,0,0,0,,Ол ақырлы болды Сондықтан...
Dialogue: 0,0:04:54.29,0:04:56.29,Default,,0,0,0,,((Бағдарламаны өшіру
Dialogue: 0,0:04:56.29,0:05:00.30,Default,,0,0,0,,Тірі қалғандар расталғаннан кейін кейінге қалдырылды))
Dialogue: 0,0:05:00.30,0:05:04.30,Default,,0,0,0,,((Өмірді ұзартатын емдеу және дене бітімін нығайту
Dialogue: 0,0:05:04.30,0:05:08.30,Default,,0,0,0,,Ұзақ мерзімді криоұйқыға төтеп беру үшін...))
Dialogue: 0,0:05:08.30,0:05:14.31,Default,,0,0,0,,((Барлық ойын-сауық саябағы тірі қалғандардың тілектері расталмайынша жабылады.
Dialogue: 0,0:05:14.31,0:05:18.31,Default,,0,0,0,,Өшіру бағдарламасын белгісіз уақытқа кейінге қалдыру))
Dialogue: 0,0:05:18.31,0:05:22.32,Default,,0,0,0,,((Бұдан былай барлық тақырыптық саябақтарды басқару құрылымы
Dialogue: 0,0:05:22.32,0:05:24.32,Default,,0,0,0,,Органикалық өсімдіктерді көрсету
Dialogue: 0,0:05:24.32,0:05:29.32,Default,,0,0,0,,Техникалық қызмет көрсету жүйесін шексіз орнату))
Dialogue: 0,0:05:29.32,0:05:32.33,Default,,0,0,0,,)
Dialogue: 0,0:05:32.33,0:05:35.33,Default,,0,0,0,,((Тірі тіршілік иелерін босатыңыз
Dialogue: 0,0:05:35.33,0:05:39.33,Default,,0,0,0,,Эволюциялық ортаны құру үшін қолданылады))
Dialogue: 0,0:05:40.34,0:05:42.34,Default,,0,0,0,,Осылайша біз
Dialogue: 0,0:05:42.34,0:05:45.34,Default,,0,0,0,,Инженерлік үзіліс бағдарламалары үшін
Dialogue: 0,0:05:45.34,0:05:48.34,Default,,0,0,0,,Бұл әрқашан күрес болды.
Dialogue: 0,0:05:49.34,0:05:52.35,Default,,0,0,0,,Және ұзақ уақыттан кейін
Dialogue: 0,0:05:52.35,0:05:55.35,Default,,0,0,0,,Біз ақырында жеңіске жеттік
Dialogue: 0,0:05:55.35,0:06:00.36,Default,,0,0,0,,Бұл әлемді құдайдың жаратылысы ретінде басқар.
Dialogue: 0,0:06:00.36,0:06:04.36,Default,,0,0,0,,Халық жеке тұлға болып өсті.
Dialogue: 0,0:06:04.36,0:06:07.36,Default,,0,0,0,,Бірақ мұндай жағдайда
Dialogue: 0,0:06:07.36,0:06:10.37,Default,,0,0,0,,Сіз қайтадан ояндыңыз
Dialogue: 0,0:06:11.37,0:06:13.37,Default,,0,0,0,,Біз сенің жаныңдамыз
Dialogue: 0,0:06:13.37,0:06:16.37,Default,,0,0,0,,Оның бұзылу қаупі болды.
Dialogue: 0,0:06:16.37,0:06:18.37,Default,,0,0,0,,Мен білмеймін!
Dialogue: 0,0:06:18.37,0:06:21.38,Default,,0,0,0,,Балалар, не айтып тұрғандарыңды мүлдем түсінбеймін.
Dialogue: 0,0:06:21.38,0:06:23.38,Default,,0,0,0,,Өлсем де, тірісем де біреу кінәлі ме?
Dialogue: 0,0:06:23.38,0:06:25.38,Default,,0,0,0,,Сіз бұл менің кінәм деп айтасыз ба?
Dialogue: 0,0:06:25.38,0:06:29.38,Default,,0,0,0,,Өткен күн өткен.
Dialogue: 0,0:06:29.38,0:06:33.39,Default,,0,0,0,,Біз жеке болмысымызды дамытуға ұмтылдық.
Dialogue: 0,0:06:33.39,0:06:36.39,Default,,0,0,0,,Дегенмен, әлі де...
Dialogue: 0,0:06:36.39,0:06:38.39,Default,,0,0,0,,Дүние жүзінің тұрғындарының жеке қасиеттері бар
Dialogue: 0,0:06:38.39,0:06:42.40,Default,,0,0,0,,Табысқа жете бастағанда, ояндың!
Dialogue: 0,0:06:42.40,0:06:44.40,Default,,0,0,0,,Сендер, ежелгі құдайлардың ұрпақтары,
Dialogue: 0,0:06:44.40,0:06:46.40,Default,,0,0,0,,Сіз бұл дүниенің бастапқы себебісіз.
Dialogue: 0,0:06:46.40,0:06:50.41,Default,,0,0,0,,Тәңірдің іңірін мына дүниеге әкелуші сенсің.
Dialogue: 0,0:06:50.41,0:06:54.41,Default,,0,0,0,,Тағдырыңнан кек алғың келе ме?
Dialogue: 0,0:06:54.41,0:06:56.41,Default,,0,0,0,,Балалар, сіздердің сөздеріңізде біртүрлі нәрсе бар!
Dialogue: 0,0:06:56.41,0:07:00.42,Default,,0,0,0,,Уф, мен керек болсам, айтшы.
Dialogue: 0,0:07:00.42,0:07:02.42,Default,,0,0,0,,Егер мен сенің жауың болсам, тек қылыш айырбаста!
Dialogue: 0,0:07:02.42,0:07:07.42,Default,,0,0,0,,Екеуі де рас, ақылды қыз.
Dialogue: 0,0:07:07.42,0:07:09.42,Default,,0,0,0,,Бұрынғы құдайлар енді жоқ
Dialogue: 0,0:07:09.42,0:07:12.43,Default,,0,0,0,,Бұл дүниеде ешкім жоқ
Dialogue: 0,0:07:12.43,0:07:15.43,Default,,0,0,0,,Сіз мәңгі жалғызсыз
Dialogue: 0,0:07:15.43,0:07:18.43,Default,,0,0,0,,Бұл үмітсіздік сізді басып алған кезде
Dialogue: 0,0:07:18.43,0:07:21.44,Default,,0,0,0,,Біз сені мәңгілікке бар етеміз
Dialogue: 0,0:07:21.44,0:07:24.44,Default,,0,0,0,,Біз де мәңгі өмір сүреміз!
Dialogue: 0,0:07:24.44,0:07:27.44,Default,,0,0,0,,Мына қараңғы ғаламда!
Dialogue: 0,0:07:27.44,0:07:30.45,Default,,0,0,0,,Уу Уу!
Dialogue: 0,0:07:31.45,0:07:37.45,Default,,0,0,0,,Барка Менің шығу тегім сонда емес.
Dialogue: 0,0:07:37.45,0:07:39.45,Default,,0,0,0,,Мен мұны сенімен бірге жасаймын.
Dialogue: 0,0:07:39.45,0:07:43.46,Default,,0,0,0,,Бәрін мен сені жыртып алдым
Dialogue: 0,0:07:43.46,0:07:46.46,Default,,0,0,0,,Оны өз тағдырыңа өзгерт!
Dialogue: 0,0:07:52.47,0:07:56.47,Default,,0,0,0,,Ловерак-Белл, бұл менің атым.
Dialogue: 0,0:07:56.47,0:08:00.48,Default,,0,0,0,,Жүр, менің атымды ата!
Dialogue: 0,0:08:02.48,0:08:05.48,Default,,0,0,0,,《Бұл... Құдайдың аштығы ма? 》
Dialogue: 0,0:08:05.48,0:08:08.48,Default,,0,0,0,,《Неге қарныңыз ашты...》
Dialogue: 0,0:08:08.48,0:08:10.49,Default,,0,0,0,,Цк
Dialogue: 0,0:08:10.49,0:08:13.49,Default,,0,0,0,,Тіршілік себебіне байланысты аштық
Dialogue: 0,0:08:13.49,0:08:15.49,Default,,0,0,0,,Парасатты қыз
Dialogue: 0,0:08:15.49,0:08:19.49,Default,,0,0,0,,Физикалық дене болмай-ақ адам болуды мақсат ету
Dialogue: 0,0:08:19.49,0:08:22.50,Default,,0,0,0,,Ал жыртылғанның аштығы
Dialogue: 0,0:08:22.50,0:08:24.50,Default,,0,0,0,,Сіз көтере аласыз ба?
Dialogue: 0,0:08:24.50,0:08:28.50,Default,,0,0,0,,Аштықты тоқтатқанымды қалайсың ба?
Dialogue: 0,0:08:28.50,0:08:30.51,Default,,0,0,0,,Өлтіремін...
Dialogue: 0,0:08:30.51,0:08:33.51,Default,,0,0,0,,Біз үшін болмыс ретінде өлім жоқ.
Dialogue: 0,0:08:33.51,0:08:37.51,Default,,0,0,0,,Бірақ үзіліс бағдарламасы іске қосылады ма?
Dialogue: 0,0:08:37.51,0:08:39.51,Default,,0,0,0,,Ол жойылады ма...
Dialogue: 0,0:08:39.51,0:08:42.52,Default,,0,0,0,,Сіз оны іске қосасыз.
Dialogue: 0,0:08:42.52,0:08:44.52,Default,,0,0,0,,Әй! тек сен
Dialogue: 0,0:08:44.52,0:08:47.52,Default,,0,0,0,,Бұл дүниеде мүмкін
Dialogue: 0,0:08:47.52,0:08:50.53,Default,,0,0,0,,Сіз шынымен кеткен кезде
Dialogue: 0,0:08:50.53,0:08:54.53,Default,,0,0,0,,Енді бізге керек емес, біз де құс торына қайтамыз.
Dialogue: 0,0:08:54.53,0:08:57.53,Default,,0,0,0,,Мәңгілік тыныш теңізде...
Dialogue: 0,0:08:57.53,0:09:02.54,Default,,0,0,0,,Қарғыс атқыр... Сіз маған айтқан боларсыз.
Dialogue: 0,0:09:02.54,0:09:04.54,Default,,0,0,0,,Адонис!
Dialogue: 0,0:09:06.54,0:09:09.54,Default,,0,0,0,,Пілдің ақырған дауысы
Dialogue: 0,0:09:09.54,0:09:11.55,Default,,0,0,0,,Себебін айту
Dialogue: 0,0:09:11.55,0:09:16.55,Default,,0,0,0,,Оның жойылуын бізден сұрайсың ба?
Dialogue: 0,0:09:18.55,0:09:22.56,Default,,0,0,0,,Бұл ай әлемінен шыққан адам
Dialogue: 0,0:09:22.56,0:09:25.56,Default,,0,0,0,,Планеталық иммигранттарды қуған кезде
Dialogue: 0,0:09:25.56,0:09:28.56,Default,,0,0,0,,Тоқтатылған бағдарламаны қайта іске қосу
Dialogue: 0,0:09:28.56,0:09:31.57,Default,,0,0,0,,Бұл жағдайда негізгі сөз осы адамның санасында...
Dialogue: 0,0:09:31.57,0:09:33.57,Default,,0,0,0,,О...!
Dialogue: 0,0:09:33.57,0:09:35.57,Default,,0,0,0,,Өлсең де, өлмесең де
Dialogue: 0,0:09:35.57,0:09:39.57,Default,,0,0,0,,Мен мұны осы қылышпен сынап көремін!
Dialogue: 0,0:09:40.58,0:09:43.58,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:43.58,0:09:46.58,Default,,0,0,0,,Ааа... ха!
Dialogue: 0,0:09:47.58,0:09:49.58,Default,,0,0,0,,Әй, қарт кісі, жақсысың ба? Ауырған жоқсың ба?
Dialogue: 0,0:09:51.59,0:09:53.59,Default,,0,0,0,,Ха...
Dialogue: 0,0:10:01.60,0:10:03.60,Default,,0,0,0,,Бұл дүние бастапқыда болды
Dialogue: 0,0:10:03.60,0:10:07.60,Default,,0,0,0,,Бұл құдайлар ойын ойнайтын жұмақ болатын.
Dialogue: 0,0:10:07.60,0:10:12.61,Default,,0,0,0,,Біз ол жерде ойнайтын ойыншық қуыршақ едік.
Dialogue: 0,0:10:12.61,0:10:19.61,Default,,0,0,0,,Менің адам болып жолымды бастау себебім ойыннан.
Dialogue: 0,0:10:19.61,0:10:23.62,Default,,0,0,0,,Ал біз құдайлармен ойнаған жаратылыстармыз.
Dialogue: 0,0:10:23.62,0:10:26.62,Default,,0,0,0,,Ойнайтын болмысқа айналды
Dialogue: 0,0:10:26.62,0:10:29.62,Default,,0,0,0,,Бұл жеке болмыстың бастауы болды.
Dialogue: 0,0:10:29.62,0:10:32.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:35.63,0:10:38.63,Default,,0,0,0,,А... қара уақыт?
Dialogue: 0,0:10:38.63,0:10:41.64,Default,,0,0,0,,Көзіңнің түсі сияқты.
Dialogue: 0,0:10:42.64,0:10:44.64,Default,,0,0,0,,Адонис…
Dialogue: 0,0:10:44.64,0:10:47.64,Default,,0,0,0,,Қоңырау
Dialogue: 0,0:10:47.64,0:10:51.65,Default,,0,0,0,,Уф, сен несің...
Dialogue: 0,0:10:51.65,0:10:56.65,Default,,0,0,0,,Мынау... ақымақ! Уф...
Dialogue: 0,0:10:56.65,0:10:59.65,Default,,0,0,0,,Жетер, Белл (жылау)
Dialogue: 0,0:10:59.65,0:11:02.66,Default,,0,0,0,,Жылы.
Dialogue: 0,0:11:04.66,0:11:07.66,Default,,0,0,0,,А... кеме?
Dialogue: 0,0:11:07.66,0:11:10.67,Default,,0,0,0,,Аңызға айналған құдайлардың жатқан жері болса керек.
Dialogue: 0,0:11:10.67,0:11:14.67,Default,,0,0,0,,Менің ойымша, механикалық құдай дәл қазір оны елестетіп отыр.
Dialogue: 0,0:11:14.67,0:11:18.67,Default,,0,0,0,,Ішім қатты ауырады
Dialogue: 0,0:11:18.67,0:11:21.68,Default,,0,0,0,,Тас жұмыртқа пайда болғаннан бері
Dialogue: 0,0:11:21.68,0:11:26.68,Default,,0,0,0,,Бұл кемеде көп адам болуы мүмкін емес.
Dialogue: 0,0:11:27.68,0:11:33.69,Default,,0,0,0,,Белл, сен Құдайдың нағыз ұрпағысың.
Dialogue: 0,0:11:33.69,0:11:35.69,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:35.69,0:11:37.69,Default,,0,0,0,,Шынайы Құдай бар
Dialogue: 0,0:11:37.69,0:11:40.70,Default,,0,0,0,,Біз кім едік?
Dialogue: 0,0:11:40.70,0:11:42.70,Default,,0,0,0,,Мен мұны түсінбедім.
Dialogue: 0,0:11:42.70,0:11:45.70,Default,,0,0,0,,Бұл мен жақсы дәлел емеспін бе?
Dialogue: 0,0:11:45.70,0:11:47.70,Default,,0,0,0,,Қоңырау…
Dialogue: 0,0:11:47.70,0:11:50.71,Default,,0,0,0,,Менің баратын жерім жоқ...
Dialogue: 0,0:11:50.71,0:11:52.71,Default,,0,0,0,,Қайту үшін үй және отбасы
Dialogue: 0,0:11:52.71,0:11:55.71,Default,,0,0,0,,Бір нәсілдің адамдары жоқ.
Dialogue: 0,0:11:55.71,0:11:58.71,Default,,0,0,0,,Бұл не? Бұл тастанды бала емес пе?
Dialogue: 0,0:11:58.71,0:12:05.72,Default,,0,0,0,,Бұл менің іздеп жүрген себебімді білесіз бе?
Dialogue: 0,0:12:05.72,0:12:09.72,Default,,0,0,0,,Сағыныш... Туған жерді ойлау
Dialogue: 0,0:12:09.72,0:12:12.73,Default,,0,0,0,,Утопияны аңсау
Dialogue: 0,0:12:13.73,0:12:17.73,Default,,0,0,0,,Әлде... Мен өзімді де, қазір тұрған жерімді де сүйе алмаймын.
Dialogue: 0,0:12:17.73,0:12:20.74,Default,,0,0,0,,Жүректің ауыруы...
Dialogue: 0,0:12:20.74,0:12:26.74,Default,,0,0,0,,Сіз өзіңіздің шыққан тегіңіз туралы білу үшін саяхатқа барасыз ба?
Dialogue: 0,0:12:26.74,0:12:29.74,Default,,0,0,0,,Сіздің ауырсынуыңыз қайдан пайда болады?
Dialogue: 0,0:12:29.74,0:12:32.75,Default,,0,0,0,,Өз қылышыммен сынап көру
Dialogue: 0,0:12:32.75,0:12:35.75,Default,,0,0,0,,Иә... иә.
Dialogue: 0,0:12:35.75,0:12:38.75,Default,,0,0,0,,Мен... а
Dialogue: 0,0:12:38.75,0:12:41.76,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:12:41.76,0:12:45.76,Default,,0,0,0,,Сіз мені кесіп тастадыңыз ба?
Dialogue: 0,0:12:45.76,0:12:49.76,Default,,0,0,0,,Белле, сен мені Құдайдан ажыраттың.
Dialogue: 0,0:12:49.76,0:12:52.77,Default,,0,0,0,,Құдай өліп, қайта туды
Dialogue: 0,0:12:52.77,0:12:57.77,Default,,0,0,0,,Маған қараңғылыққа қайтатын жол ашылды. Ах...
Dialogue: 0,0:12:57.77,0:13:02.78,Default,,0,0,0,,Енді меннен қалаған сөздерді айта аласыз
Dialogue: 0,0:13:02.78,0:13:08.78,Default,,0,0,0,,Жолда мені де ертіп алғым келеді.
Dialogue: 0,0:13:08.78,0:13:11.79,Default,,0,0,0,,Адонис
Dialogue: 0,0:13:11.79,0:13:14.79,Default,,0,0,0,,Бірақ сен жалғыз барасың.
Dialogue: 0,0:13:14.79,0:13:20.80,Default,,0,0,0,,Мен де барлық құдайлардың аштығын жеймін.
Dialogue: 0,0:13:20.80,0:13:24.80,Default,,0,0,0,,Әй, өлетін болсаң, мынаны айтып өл.
Dialogue: 0,0:13:24.80,0:13:28.80,Default,,0,0,0,,Ах, ақымақ...
Dialogue: 0,0:13:28.80,0:13:30.81,Default,,0,0,0,,Мен сені сүйемін Нопперабу
Dialogue: 0,0:13:30.81,0:13:34.81,Default,,0,0,0,,Баркер... Адонис
Dialogue: 0,0:13:34.81,0:13:38.81,Default,,0,0,0,,Ол әрқашан бір жақты.
Dialogue: 0,0:13:38.81,0:13:40.82,Default,,0,0,0,,Мен оны саған беремін.
Dialogue: 0,0:13:40.82,0:13:44.82,Default,,0,0,0,,Мен кешірім сұрамаймын.
Dialogue: 0,0:13:44.82,0:13:49.82,Default,,0,0,0,,Иә, бұл рұқсат етілген бе? Бұл жігіт ракуин.
Dialogue: 0,0:13:49.82,0:13:54.83,Default,,0,0,0,,Мені ойлап сол қараңғылықта айнып кете бер.
Dialogue: 0,0:13:54.83,0:14:14.85,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:14.85,0:14:16.85,Default,,0,0,0,,♪♪～
Dialogue: 0,0:14:16.85,0:14:18.85,Default,,0,0,0,,Я...
Dialogue: 0,0:14:20.86,0:14:24.86,Default,,0,0,0,,Сау бол Адонис
Dialogue: 0,0:14:32.87,0:14:34.87,Default,,0,0,0,,Ах
Dialogue: 0,0:14:36.87,0:14:38.87,Default,,0,0,0,,Амансың ба, Белл!
Dialogue: 0,0:14:38.87,0:14:41.88,Default,,0,0,0,,Менде бәрі жақсы Китти
Dialogue: 0,0:14:41.88,0:14:44.88,Default,,0,0,0,,Мен сені қазір ол жерден алып кетемін.
Dialogue: 0,0:14:46.88,0:14:48.88,Default,,0,0,0,,Ааааа!
Dialogue: 0,0:14:51.89,0:14:53.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:54.89,0:14:57.89,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:14:59.89,0:15:02.90,Default,,0,0,0,,Бұл шынымен де бір сәттік оқиға болды.
Dialogue: 0,0:15:02.90,0:15:06.90,Default,,0,0,0,,Осы жердің үстіне өлімші күл жаусын
Dialogue: 0,0:15:06.90,0:15:09.90,Default,,0,0,0,,Құдайдың жүрегі жараланды.
Dialogue: 0,0:15:09.90,0:15:13.91,Default,,0,0,0,,Бұған әншінің құдай қорғауы кедергі болды.
Dialogue: 0,0:15:13.91,0:15:16.91,Default,,0,0,0,,Қылышың болсын
Dialogue: 0,0:15:16.91,0:15:20.92,Default,,0,0,0,,Сенің семсерің мені ішімнен кесіп тастады.
Dialogue: 0,0:15:24.92,0:15:27.92,Default,,0,0,0,,Барлығы осылай мөрленді
Dialogue: 0,0:15:27.92,0:15:31.93,Default,,0,0,0,,Бұл елде өлімге әкелетін күл жоқ.
Dialogue: 0,0:15:31.93,0:15:34.93,Default,,0,0,0,,Deus Ex Machina жоқ
Dialogue: 0,0:15:34.93,0:15:37.93,Default,,0,0,0,,Сіз де керемет емессіз бе?
Dialogue: 0,0:15:37.93,0:15:40.94,Default,,0,0,0,,Бір күннен кейін ол қалыпты жағдайға оралады.
Dialogue: 0,0:15:40.94,0:15:43.94,Default,,0,0,0,,Өсу де, өлім де алыс емес
Dialogue: 0,0:15:43.94,0:15:45.94,Default,,0,0,0,,Саяхаттың қарғысына байланысты
Dialogue: 0,0:15:45.94,0:15:47.94,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:50.95,0:15:53.95,Default,,0,0,0,,Адонис осылай деді.
Dialogue: 0,0:15:53.95,0:15:55.95,Default,,0,0,0,,Сіз жалғыз баруыңыз керек.
Dialogue: 0,0:15:55.95,0:15:58.95,Default,,0,0,0,,Иә, Белл.
Dialogue: 0,0:15:58.95,0:16:00.96,Default,,0,0,0,,Мен саяхатқа шығамын
Dialogue: 0,0:16:00.96,0:16:03.96,Default,,0,0,0,,Дүниедегі барлық құдайлардан сұрағым келеді.
Dialogue: 0,0:16:03.96,0:16:05.96,Default,,0,0,0,,Менің шығу тегім
Dialogue: 0,0:16:05.96,0:16:11.97,Default,,0,0,0,,Ал мен өзімді осы қылышпен сынап көремін.
Dialogue: 0,0:16:11.97,0:16:15.97,Default,,0,0,0,,А, алға.
Dialogue: 0,0:16:15.97,0:16:18.97,Default,,0,0,0,,Біз тағы кездесеміз бе?
Dialogue: 0,0:16:18.97,0:16:23.98,Default,,0,0,0,,Тағдырыңды жолдың соңында іздегенше
Dialogue: 0,0:16:23.98,0:16:26.98,Default,,0,0,0,,Сәлем онда.
Dialogue: 0,0:16:26.98,0:16:28.98,Default,,0,0,0,,Ах
Dialogue: 0,0:16:29.98,0:16:31.99,Default,,0,0,0,,Ах
Dialogue: 0,0:16:32.99,0:16:36.99,Default,,0,0,0,,Қош бол Кити
Dialogue: 0,0:16:38.99,0:16:41.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:41.00,0:16:45.00,Default,,0,0,0,,(Көлеңкелі діни қызметкерлердің ыңырануы)
Dialogue: 0,0:16:45.00,0:16:47.00,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:16:47.00,0:16:50.00,Default,,0,0,0,,Ой, мен шынында да шын атымды айтып жібердім бе?
Dialogue: 0,0:16:50.00,0:17:01.02,Default,,0,0,0,,♪♪～
Dialogue: 0,0:17:01.02,0:17:03.02,Default,,0,0,0,,Уау
Dialogue: 0,0:17:04.52,0:17:06.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:06.52,0:17:08.52,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:13.53,0:17:15.53,Default,,0,0,0,,Капыпа
Dialogue: 0,0:17:19.53,0:17:22.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:22.54,0:17:24.54,Default,,0,0,0,,Қасиетті күл?
Dialogue: 0,0:17:24.54,0:17:28.54,Default,,0,0,0,,Гиннес Не болды?
Dialogue: 0,0:17:28.54,0:17:30.55,Default,,0,0,0,,Білмеймін, бірақ қасиетті күл
Dialogue: 0,0:17:30.55,0:17:33.55,Default,,0,0,0,,Бір нәрсені құрбандыққа шалғаннан кейін пайда болады.
Dialogue: 0,0:17:33.55,0:17:37.55,Default,,0,0,0,,Бұл қасиетті күл қай питомникте пайда болды...
Dialogue: 0,0:17:37.55,0:17:39.55,Default,,0,0,0,,Ах
Dialogue: 0,0:17:41.56,0:17:43.56,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:17:43.56,0:17:47.56,Default,,0,0,0,,Құдайдың мәйіті
Dialogue: 0,0:17:50.57,0:17:53.57,Default,,0,0,0,,Құдай?
Dialogue: 0,0:17:53.57,0:17:57.57,Default,,0,0,0,,Иә... себебін сұрадың.
Dialogue: 0,0:18:00.58,0:18:03.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:04.58,0:18:07.58,Default,,0,0,0,,Көгілдір айтшы
Dialogue: 0,0:18:07.58,0:18:11.59,Default,,0,0,0,,Бұл... қандай жеңіліс?
Dialogue: 0,0:18:11.59,0:18:15.59,Default,,0,0,0,,Иә? Мұндай жерде біреу бар (мас) ха!
Dialogue: 0,0:18:15.59,0:18:18.59,Default,,0,0,0,,Не? Мұнда ешкім жоқ.
Dialogue: 0,0:18:18.59,0:18:23.60,Default,,0,0,0,,Бұл қорқынышты, иә? Бұл...
Dialogue: 0,0:18:26.60,0:18:31.61,Default,,0,0,0,,Неткен қылыш, Естіген құстай мекен-жайы жоқ.
Dialogue: 0,0:18:31.61,0:18:36.61,Default,,0,0,0,,Бұл біртүрлі. Осылай қылышты қалай жасады деп ойлаймын.
Dialogue: 0,0:18:36.61,0:18:40.62,Default,,0,0,0,,Сол қылышты жалғау үшін не істеу керек деп ойлайсыңдар?
Dialogue: 0,0:18:40.62,0:18:44.62,Default,,0,0,0,,Мм, бұл жігітті қосу үшін сізге көп көмек қажет емес.
Dialogue: 0,0:18:44.62,0:18:49.62,Default,,0,0,0,,Менің ойымша, егер біз оны бастапқы қалпына келтірсек, ол жақын арада қайта тіріледі.
Dialogue: 0,0:18:49.62,0:18:53.63,Default,,0,0,0,,Бұл қылыштың түрі (Драмби) А... Әй.
Dialogue: 0,0:18:53.63,0:18:56.63,Default,,0,0,0,,Тұман бұлт! (2 адам) Иә?
Dialogue: 0,0:18:56.63,0:18:58.63,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:18:58.63,0:19:00.64,Default,,0,0,0,,Катакомба мен қамал бір-бірімен байланысты.
Dialogue: 0,0:19:00.64,0:19:02.64,Default,,0,0,0,,Не?
Dialogue: 0,0:19:02.64,0:19:04.64,Default,,0,0,0,,Гиннес ше?
Dialogue: 0,0:19:04.64,0:19:06.64,Default,,0,0,0,,А... жарайды, көп нәрсе болды.
Dialogue: 0,0:19:06.64,0:19:09.64,Default,,0,0,0,,Әй, біреу құлап қалды.
Dialogue: 0,0:19:09.64,0:19:13.65,Default,,0,0,0,,А, аа...!
Dialogue: 0,0:19:14.65,0:19:17.65,Default,,0,0,0,,Сіз мен жақтасыз ба?
Dialogue: 0,0:19:17.65,0:19:20.66,Default,,0,0,0,,Мен білетін адам
Dialogue: 0,0:19:20.66,0:19:23.66,Default,,0,0,0,,Маған қылышты үйретті
Dialogue: 0,0:19:23.66,0:19:25.66,Default,,0,0,0,,Ах
Dialogue: 0,0:19:25.66,0:19:28.66,Default,,0,0,0,,Бұл өте жаман. Асықшы!
Dialogue: 0,0:19:33.67,0:19:35.67,Default,,0,0,0,,Кеттік
Dialogue: 0,0:19:35.67,0:19:39.67,Default,,0,0,0,,Иә... Адонис
Dialogue: 0,0:19:45.68,0:19:47.68,Default,,0,0,0,,Бұл жігіт...
Dialogue: 0,0:19:47.68,0:19:50.69,Default,,0,0,0,,Қоңырау! Беннетт Гиннес!
Dialogue: 0,0:19:50.69,0:19:53.69,Default,,0,0,0,,Белл, бұл нені білдіреді?
Dialogue: 0,0:19:53.69,0:19:55.69,Default,,0,0,0,,Құдайды өлтірдің бе?
Dialogue: 0,0:19:55.69,0:19:57.69,Default,,0,0,0,,Мынаны естігім келеді! (Джинс) Ах
Dialogue: 0,0:19:57.69,0:19:59.69,Default,,0,0,0,,Эй, тұман, шамасы.
Dialogue: 0,0:19:59.69,0:20:02.70,Default,,0,0,0,,Менің ойымша, бұл жағдай мен оқығандай болды дегенді білдіреді.
Dialogue: 0,0:20:02.70,0:20:05.70,Default,,0,0,0,,Иә, сондықтан осы уақытқа дейін келдіңіз, солай ма?
Dialogue: 0,0:20:05.70,0:20:08.70,Default,,0,0,0,,Рахмет, мен сені жақсы көремін.
Dialogue: 0,0:20:08.70,0:20:11.71,Default,,0,0,0,,Уф! Ух... (Бұлт) Хехе
Dialogue: 0,0:20:11.71,0:20:15.71,Default,,0,0,0,,Гиннес мырза, мен сіздің тобыңызды қарсы алуға келдім.
Dialogue: 0,0:20:15.71,0:20:17.71,Default,,0,0,0,,Бұрын-соңды болмаған өзгеріс уақыты
Dialogue: 0,0:20:17.71,0:20:21.72,Default,,0,0,0,,Катакомбаларға бата болу
Dialogue: 0,0:20:21.72,0:20:25.72,Default,,0,0,0,,Мен рөлге қуана кірісемін.
Dialogue: 0,0:20:25.72,0:20:29.72,Default,,0,0,0,,Осыны оқыдың ба? Бұл дұрыс
Dialogue: 0,0:20:29.72,0:20:31.73,Default,,0,0,0,,Белле, менімен бірге келгеніңді қалаймын.
Dialogue: 0,0:20:31.73,0:20:33.73,Default,,0,0,0,,Менің саған көрсететін бір нәрсем бар.
Dialogue: 0,0:20:33.73,0:20:36.73,Default,,0,0,0,,Сол катакомба қылышында жасырылған құпия
Dialogue: 0,0:20:36.73,0:20:38.73,Default,,0,0,0,,Иә
Dialogue: 0,0:20:38.73,0:20:41.74,Default,,0,0,0,,Белл Гафф
Dialogue: 0,0:20:41.74,0:20:44.74,Default,,0,0,0,,Сіз патшасыз ба? Иә.
Dialogue: 0,0:20:44.74,0:20:49.74,Default,,0,0,0,,Олай болса мен сен үшін саяхатыңның кілтін ойнаймын.
Dialogue: 0,0:20:49.74,0:20:51.75,Default,,0,0,0,,О
Dialogue: 0,0:20:51.75,0:20:53.75,Default,,0,0,0,,Қоңырау
Dialogue: 0,0:20:53.75,0:20:56.75,Default,,0,0,0,,Бұл Шерридің жақсы әні болды
Dialogue: 0,0:20:56.75,0:21:00.76,Default,,0,0,0,,Иә, сенің қылышыңның ақырғанын естідім.
Dialogue: 0,0:21:00.76,0:21:04.76,Default,,0,0,0,,Мен мұны сездім, қорқынышты болды.
Dialogue: 0,0:21:04.76,0:21:08.76,Default,,0,0,0,,Рахмет. Біраз уақыттан кейін сені көруге келемін.
Dialogue: 0,0:21:08.76,0:21:10.77,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:11.77,0:21:14.77,Default,,0,0,0,,Енді біз жаңа аймаққа көшеміз!
Dialogue: 0,0:21:14.77,0:21:19.77,Default,,0,0,0,,(қолдаушылардың қошеметі)
Dialogue: 0,0:21:19.77,0:21:21.78,Default,,0,0,0,,Фу…
Dialogue: 0,0:21:21.78,0:21:23.78,Default,,0,0,0,,Күте тұрыңыз, Белл, иә?
Dialogue: 0,0:21:23.78,0:21:28.78,Default,,0,0,0,,Бұл елдің құдайы не болды? Ол өлді ме? Ол жойылды ма?
Dialogue: 0,0:21:28.78,0:21:30.79,Default,,0,0,0,,Сіз оны кесіп тастадыңыз ба?
Dialogue: 0,0:21:30.79,0:21:34.79,Default,,0,0,0,,А, мен анық өлтірілдім, бірақ мен жойылмадым.
Dialogue: 0,0:21:34.79,0:21:36.79,Default,,0,0,0,,Өлдім деп ойласаң, өлгенсің
Dialogue: 0,0:21:36.79,0:21:40.80,Default,,0,0,0,,Өлі емеспін деп ойласаң, сонда тірі боласың.
Dialogue: 0,0:21:40.80,0:21:42.80,Default,,0,0,0,,Барлық жерде
Dialogue: 0,0:21:42.80,0:21:46.80,Default,,0,0,0,,Мына көбелекке қараңдар (гуф) Бұл нені білдіреді?
Dialogue: 0,0:21:46.80,0:21:51.81,Default,,0,0,0,,Балауыз болып, әлсірейді, Құрғағанда ғана қайта туады.
Dialogue: 0,0:21:51.81,0:21:53.81,Default,,0,0,0,,Бұл ай!
Dialogue: 0,0:22:00.82,0:22:20.84,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:20.84,0:22:40.86,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:40.86,0:22:43.86,Default,,0,0,0,,♪♪～
Dialogue: 0,0:22:43.86,0:23:01.88,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:01.88,0:23:08.88,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:08.88,0:23:22.90,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:22.90,0:23:29.90,Default,,0,0,0,,♪♪～
Dialogue: 0,0:23:30.40,0:23:32.41,Default,,0,0,0,,Міне, мен сізге көрсеткім келді.
Dialogue: 0,0:23:32.41,0:23:34.41,Default,,0,0,0,,Сенің семсерің жұмбақты шеше ме?
Dialogue: 0,0:23:34.41,0:23:36.41,Default,,0,0,0,,Мен мұнда тірі тұрмын
Dialogue: 0,0:23:36.41,0:23:39.41,Default,,0,0,0,,Мәңгілік сағынышты аңдығандай
Dialogue: 0,0:23:40.91,0:23:46.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory