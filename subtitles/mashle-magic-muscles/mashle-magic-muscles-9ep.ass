Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,♪~
Dialogue: 0,0:01:28.92,0:01:30.92,Default,,0,0,0,,~♪
Dialogue: 0,0:01:32.21,0:01:34.55,Default,,0,0,0,,Мен Мудлге тұрарлық
Dialogue: 0,0:01:34.63,0:01:38.18,Default,,0,0,0,,Бұл түкке тұрғысыз әлсіздік болса ше?
Dialogue: 0,0:01:38.26,0:01:40.55,Default,,0,0,0,,Себебі мен сені кешірмеймін бе?
Dialogue: 0,0:01:40.64,0:01:41.93,Default,,0,0,0,,Гравиол
Dialogue: 0,0:01:44.02,0:01:47.06,Default,,0,0,0,,Менің досыңа уақытым жоқ.
Dialogue: 0,0:01:48.39,0:01:49.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:57.24,0:02:00.82,Default,,0,0,0,,Мен бұл гравитацияның сиқыры екеніне таң қалдым.
Dialogue: 0,0:02:03.58,0:02:06.75,Default,,0,0,0,,Бұл аздап көңілді болатын сияқты.
Dialogue: 0,0:02:07.79,0:02:08.33,Default,,0,0,0,,Эй?
Dialogue: 0,0:02:10.42,0:02:11.33,Default,,0,0,0,,Гравиол
Dialogue: 0,0:02:17.22,0:02:20.72,Default,,0,0,0,,Кухахаха Мудамуда
Dialogue: 0,0:02:23.01,0:02:24.51,Default,,0,0,0,,Балшық
Dialogue: 0,0:02:24.60,0:02:27.68,Default,,0,0,0,,Бұл заттың өзін ұсақтауымыз керек дегенді білдіре ме?
Dialogue: 0,0:02:28.18,0:02:30.31,Default,,0,0,0,,Онда тез.
Dialogue: 0,0:02:30.40,0:02:31.86,Default,,0,0,0,,Бұл бүкіл аймақ...
Dialogue: 0,0:02:32.36,0:02:33.48,Default,,0,0,0,,Гравиол
Dialogue: 0,0:02:38.65,0:02:40.28,Default,,0,0,0,,Өте жаман
Dialogue: 0,0:02:41.11,0:02:42.07,Default,,0,0,0,,Жарылыс
Dialogue: 0,0:02:44.49,0:02:47.20,Default,,0,0,0,,Менің аяғым бекітілген. Мен білмей тұрып...
Dialogue: 0,0:02:48.33,0:02:50.00,Default,,0,0,0,,Гуаааа!
Dialogue: 0,0:02:53.46,0:02:56.50,Default,,0,0,0,,Гравитация сиқыры туралы айтатын болсақ, Crown отбасы
Dialogue: 0,0:02:56.59,0:02:59.13,Default,,0,0,0,,Сіз өте жақсы шыққансыз, солай емес пе?
Dialogue: 0,0:02:59.22,0:03:00.88,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:03:01.51,0:03:04.80,Default,,0,0,0,,Оны Жеті жын азуының ішіне салыңыз (Магия Лупус)
Dialogue: 0,0:03:05.31,0:03:07.43,Default,,0,0,0,,Менің байқауымша, сюжет жаман емес.
Dialogue: 0,0:03:08.27,0:03:11.56,Default,,0,0,0,,Егер сен менің кенжем болсаң, менің ойымша, сен жеткілікті жақсы болады.
Dialogue: 0,0:03:11.64,0:03:15.27,Default,,0,0,0,,Оның үстіне Теманың өзін де аяймын.
Dialogue: 0,0:03:15.36,0:03:19.11,Default,,0,0,0,,Теменің өзі талантты, бірақ ортасы нашар
Dialogue: 0,0:03:19.78,0:03:23.66,Default,,0,0,0,,Қасылған адам өте маңызды.
Dialogue: 0,0:03:23.74,0:03:26.99,Default,,0,0,0,,Айналаңыздың бәрі шірік болса, сіз де шірисіз.
Dialogue: 0,0:03:27.66,0:03:29.29,Default,,0,0,0,,Не айтпақшысың?
Dialogue: 0,0:03:29.37,0:03:32.46,Default,,0,0,0,,Эй, эй, мен білемін, бірақ енді менен сұрама.
Dialogue: 0,0:03:33.12,0:03:35.67,Default,,0,0,0,,Адораның қоқысымен бірге
Dialogue: 0,0:03:35.75,0:03:38.46,Default,,0,0,0,,Соңына дейін шіримін дедім.
Dialogue: 0,0:03:39.34,0:03:40.72,Default,,0,0,0,,Адам дегеніміз не?
Dialogue: 0,0:03:40.80,0:03:44.39,Default,,0,0,0,,Сіз өзіңізбен бір деңгейде тұрған адамдарға жабысуыңыз керек.
Dialogue: 0,0:03:44.89,0:03:48.72,Default,,0,0,0,,Құнсыз адамдармен аралассаң, құндылығың біржола төмендейді.
Dialogue: 0,0:03:49.72,0:03:53.48,Default,,0,0,0,,Жеті жын азу жақсы, бәрі де талантты.
Dialogue: 0,0:03:54.27,0:03:58.52,Default,,0,0,0,,Сонымен қатар, жоғары сапалы білім беру үшін Сиқырлы құралдар Сиқырлы сусындар
Dialogue: 0,0:03:58.61,0:04:01.78,Default,,0,0,0,,Сиқырды барынша пайдалану үшін бізде орта бар.
Dialogue: 0,0:04:02.28,0:04:05.24,Default,,0,0,0,,А... Бұл күштірек болу ортасы ма?
Dialogue: 0,0:04:06.03,0:04:08.03,Default,,0,0,0,,Менің сенімімнің күші
Dialogue: 0,0:04:08.12,0:04:12.50,Default,,0,0,0,,Қоршаған ортаға байланысты... Бұл жайдан-жай қабылдайтын нәрсе емес.
Dialogue: 0,0:04:13.21,0:04:14.00,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:14.08,0:04:17.29,Default,,0,0,0,,А? Сіз оны анықтай алмадыңыз ба?
Dialogue: 0,0:04:17.38,0:04:21.76,Default,,0,0,0,,Мен үшін сіз екінші дәрежелісіз.
Dialogue: 0,0:04:23.55,0:04:27.51,Default,,0,0,0,,Ка~, екінші деңгей! Иә иә
Dialogue: 0,0:04:28.18,0:04:30.77,Default,,0,0,0,,Оның мағынасын білемін дейсіз бе?
Dialogue: 0,0:04:32.27,0:04:33.27,Default,,0,0,0,,Гравиол
Dialogue: 0,0:04:35.85,0:04:38.52,Default,,0,0,0,,Бұл жігіт ауырлық күшін бүйір қабырғаға қолданады...
Dialogue: 0,0:04:42.44,0:04:44.82,Default,,0,0,0,,Қанша тырыссаң да пайдасы жоқ.
Dialogue: 0,0:04:45.32,0:04:48.99,Default,,0,0,0,,Қабырғалар мен еден астынан балшықтан жастық жасадым.
Dialogue: 0,0:04:49.08,0:04:51.12,Default,,0,0,0,,Соққыны сіңіреді
Dialogue: 0,0:04:51.62,0:04:56.04,Default,,0,0,0,,Гравитация сиқыры жауды соғу үшін орынды қажет етеді.
Dialogue: 0,0:04:56.87,0:05:01.30,Default,,0,0,0,,Осы механизмді көрмейінше, сен менің...
Dialogue: 0,0:05:03.13,0:05:08.05,Default,,0,0,0,,Бұл жігіт бұрын жасалған қоқысты осы жерге жіберу үшін ауырлық күшін пайдаланады...
Dialogue: 0,0:05:13.85,0:05:14.81,Default,,0,0,0,,≫ Тап-тап-тап (аяқ дыбысы) (Ол Майт) Һм?
Dialogue: 0,0:05:15.39,0:05:19.73,Default,,0,0,0,,Мен ауырлық сиқырының маған әсер етпейтінін баяғыда түсіндім...
Dialogue: 0,0:05:20.57,0:05:23.82,Default,,0,0,0,,Қоршаған орта жақсы болса, соғұрлым күшті боламын дедіңіз.
Dialogue: 0,0:05:23.90,0:05:24.94,Default,,0,0,0,,Әй?
Dialogue: 0,0:05:25.03,0:05:27.32,Default,,0,0,0,,Сіздің теорияңыз...
Dialogue: 0,0:05:28.36,0:05:31.83,Default,,0,0,0,,Менің ортам жақсырақ сияқты.
Dialogue: 0,0:05:33.91,0:05:35.33,Default,,0,0,0,,Мен күштімін
Dialogue: 0,0:05:36.50,0:05:38.88,Default,,0,0,0,,Екі таңбалы туылған
Dialogue: 0,0:05:39.54,0:05:43.09,Default,,0,0,0,,Сиқырлы күштің мөлшері басқа Закостармен салыстыруға келмейді.
Dialogue: 0,0:05:43.96,0:05:47.43,Default,,0,0,0,,Орта мектептен кейін мен Истон сиқыр мектебіне бардым.
Dialogue: 0,0:05:47.93,0:05:50.85,Default,,0,0,0,,Әрине, ол Жеті жын азуға жатады.
Dialogue: 0,0:05:50.93,0:05:55.52,Default,,0,0,0,,Мен сиқырлы білім алдым, оны тек Линна жатақханасының жоғарғы класы оқи алады.
Dialogue: 0,0:05:56.68,0:06:00.10,Default,,0,0,0,,Иә, әрине мен күштімін.
Dialogue: 0,0:06:00.19,0:06:02.61,Default,,0,0,0,,Күшті болмайтындай жол жоқ.
Dialogue: 0,0:06:02.69,0:06:06.19,Default,,0,0,0,,Мен күшті емеспін...
Dialogue: 0,0:06:07.24,0:06:10.11,Default,,0,0,0,,Сіз өте тәкаппарсыз, 1 курс.
Dialogue: 0,0:06:10.62,0:06:12.62,Default,,0,0,0,,Сен мені ұрдым деп ойлайсың ба?
Dialogue: 0,0:06:12.70,0:06:13.70,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:15.08,0:06:19.37,Default,,0,0,0,,Бұл басқа оқушыдан алынған сиқырлы күштің шоғырланған сұйықтығы.
Dialogue: 0,0:06:20.96,0:06:25.46,Default,,0,0,0,,Біз, Жеті жын азу, осы шоғырланған сұйықтықты аламыз.
Dialogue: 0,0:06:26.51,0:06:28.38,Default,,0,0,0,,Ерекше болыңыз!
Dialogue: 0,0:06:31.80,0:06:34.14,Default,,0,0,0,,Сиқырлы күш одан әрі артты
Dialogue: 0,0:06:35.35,0:06:36.64,Default,,0,0,0,,Фу…
Dialogue: 0,0:06:36.72,0:06:39.85,Default,,0,0,0,,Мен дәл осы жерде және қазір дәлелдеймін.
Dialogue: 0,0:06:40.56,0:06:43.15,Default,,0,0,0,,Қайсысы дұрыс?
Dialogue: 0,0:06:44.73,0:06:47.15,Default,,0,0,0,,Madros секундтары
Dialogue: 0,0:06:59.71,0:07:01.54,Default,,0,0,0,,(Көзілдірікті адам) Саған кім рұқсат берді? (Жан) Ә?
Dialogue: 0,0:07:01.62,0:07:03.54,Default,,0,0,0,,Мадро шайтандар!
Dialogue: 0,0:07:06.46,0:07:09.05,Default,,0,0,0,,Сиқырдың кезеңдері бар.
Dialogue: 0,0:07:09.55,0:07:12.14,Default,,0,0,0,,Негізгі магияға тән сиқыр
Dialogue: 0,0:07:12.22,0:07:15.64,Default,,0,0,0,,Осыдан тағы бір даму: шартты сиқыр
Dialogue: 0,0:07:15.72,0:07:17.64,Default,,0,0,0,,Бірақ секундтар
Dialogue: 0,0:07:17.72,0:07:21.14,Default,,0,0,0,,Бір жолды қолдануға болатын деңгейде сиқырдан ерекшеленеді.
Dialogue: 0,0:07:21.94,0:07:26.82,Default,,0,0,0,,Тіпті 2 жол болса да, бұл тек шектеулі адамдар санына рұқсат етілген жоғары деңгейдегі сиқыр.
Dialogue: 0,0:07:27.32,0:07:31.90,Default,,0,0,0,,Иә... Оны кейбір лайықты адамдар ғана пайдалана алады.
Dialogue: 0,0:07:32.41,0:07:33.74,Default,,0,0,0,,Тыңда, тұр.
Dialogue: 0,0:07:33.82,0:07:37.83,Default,,0,0,0,,Адамның құндылығы оның осы дүниеде қаншалықты табысты болуымен анықталады.
Dialogue: 0,0:07:37.91,0:07:39.37,Default,,0,0,0,,Лайықты адам болу...
Dialogue: 0,0:07:39.45,0:07:40.29,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:07:40.37,0:07:44.25,Default,,0,0,0,,Басқаша айтқанда, сиқырдың бәрі бар бұл әлемде.
Dialogue: 0,0:07:44.33,0:07:46.59,Default,,0,0,0,,Сиқыр адамның құндылығын анықтайды.
Dialogue: 0,0:07:46.67,0:07:48.50,Default,,0,0,0,,Лайықты адам болу...
Dialogue: 0,0:07:49.21,0:07:52.38,Default,,0,0,0,,Сиқырлы таланты барлар құнды.
Dialogue: 0,0:07:52.47,0:07:55.60,Default,,0,0,0,,Сиқырлы таланты жоқтардың құны жоқ.
Dialogue: 0,0:07:56.89,0:07:57.76,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:07:58.43,0:08:00.60,Default,,0,0,0,,Мен жай ғана талантты емеспін
Dialogue: 0,0:08:00.68,0:08:03.48,Default,,0,0,0,,Мен қазір осы орынды жеңіп алдым.
Dialogue: 0,0:08:03.98,0:08:05.86,Default,,0,0,0,,Мен құнды адаммын
Dialogue: 0,0:08:06.98,0:08:08.48,Default,,0,0,0,,Бұл сиқыр
Dialogue: 0,0:08:08.57,0:08:11.69,Default,,0,0,0,,Сіз түкке тұрғысыз мансаптармен араласып жүрсіз.
Dialogue: 0,0:08:11.78,0:08:14.82,Default,,0,0,0,,Бұл сіз ешқашан жете алмайтын аймақ!
Dialogue: 0,0:08:16.12,0:08:17.28,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:08:19.08,0:08:22.91,Default,,0,0,0,,Хмф... сіз оларды төмен деп атадыңыз.
Dialogue: 0,0:08:23.00,0:08:25.46,Default,,0,0,0,,Сіз ештеңе білмейтін сияқтысыз.
Dialogue: 0,0:08:25.96,0:08:26.92,Default,,0,0,0,,Әй?
Dialogue: 0,0:08:27.54,0:08:31.42,Default,,0,0,0,,Оның сөздері маған маңызды нәрсені есіме түсірді.
Dialogue: 0,0:08:32.26,0:08:34.55,Default,,0,0,0,,Рационалды шешім қабылдауға жеткілікті
Dialogue: 0,0:08:35.05,0:08:37.14,Default,,0,0,0,,Өйткені мен епті емеспін
Dialogue: 0,0:08:38.01,0:08:43.10,Default,,0,0,0,,Мен ғана оларды төмен деп айта аламын.
Dialogue: 0,0:08:44.39,0:08:46.65,Default,,0,0,0,,Гравиол секундтары
Dialogue: 0,0:08:54.95,0:08:56.49,Default,,0,0,0,,Тухер полюсі
Dialogue: 0,0:09:00.99,0:09:03.33,Default,,0,0,0,,Мадро Ібілістердің қозғалысы...
Dialogue: 0,0:09:03.91,0:09:05.08,Default,,0,0,0,,Бұл тірек...
Dialogue: 0,0:09:05.16,0:09:06.67,Default,,0,0,0,,Иә (құнды) Ах...
Dialogue: 0,0:09:06.75,0:09:11.05,Default,,0,0,0,,Бағаналар жеке күшті тартылыс күшін тудырады.
Dialogue: 0,0:09:11.55,0:09:13.67,Default,,0,0,0,,Бағананың өзіне қарай
Dialogue: 0,0:09:14.30,0:09:17.43,Default,,0,0,0,,Ал бағандармен қоршалған құбыжық
Dialogue: 0,0:09:17.51,0:09:20.18,Default,,0,0,0,,Ауырлық күші барлық жағынан тартылған...
Dialogue: 0,0:09:21.14,0:09:22.18,Default,,0,0,0,,Тарту
Dialogue: 0,0:09:27.48,0:09:30.40,Default,,0,0,0,,Менің максималды сиқырым сәтсіз болды ма?
Dialogue: 0,0:09:32.78,0:09:35.15,Default,,0,0,0,,Мен жеңіліп қалдым деп ойлайсың ба?
Dialogue: 0,0:09:35.86,0:09:36.70,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:37.91,0:09:40.28,Default,,0,0,0,,Сізді жатақхана меңгерушісі таныды ма?
Dialogue: 0,0:09:41.28,0:09:43.87,Default,,0,0,0,,Сіздің мақсатыңыз – Истон шыңында болу.
Dialogue: 0,0:09:44.75,0:09:48.71,Default,,0,0,0,,Сиқырлы бюроға қосылудың өзі сізді құруға тұрарлық емес.
Dialogue: 0,0:09:49.54,0:09:54.59,Default,,0,0,0,,Түсіндің бе? Сен мен үшін әлі де түкке тұрғысызсың
Dialogue: 0,0:09:56.26,0:10:00.05,Default,,0,0,0,,Сіз қашан лайықты адамға айналасыз?
Dialogue: 0,0:10:00.14,0:10:01.05,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:10:04.52,0:10:06.48,Default,,0,0,0,,Мен түкке тұрғысызмын...
Dialogue: 0,0:10:08.77,0:10:11.40,Default,,0,0,0,,Сіздікі құлаған болуы керек.
Dialogue: 0,0:10:12.52,0:10:15.94,Default,,0,0,0,,Анықтамалық кітап әбден тозған.
Dialogue: 0,0:10:16.44,0:10:19.57,Default,,0,0,0,,Адамдық құндылық дегенді қалай түсінесіз?
Dialogue: 0,0:10:21.28,0:10:26.58,Default,,0,0,0,,Менің ата-анам құрметті және өз орнын бәрінен де жоғары санайтын.
Dialogue: 0,0:10:27.91,0:10:32.75,Default,,0,0,0,,Сөздеріңіз бен іс-әрекеттеріңізге қарап, сіз менікінен онша ерекшеленбейтін ортада өскен шығарсыз.
Dialogue: 0,0:10:33.34,0:10:37.17,Default,,0,0,0,,Мен болашақта әнші болғым келеді.
Dialogue: 0,0:10:37.76,0:10:38.76,Default,,0,0,0,,Хехе
Dialogue: 0,0:10:38.84,0:10:45.01,Default,,0,0,0,,Сол ортада бір қарағанда құндылық талант пен лауазымға байланысты айқындалатын сияқты, бірақ
Dialogue: 0,0:10:45.60,0:10:47.31,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:10:47.39,0:10:50.85,Default,,0,0,0,,Эй, сен ешқашан ондай болмаймын деп ойладың, солай ма?
Dialogue: 0,0:10:51.35,0:10:55.65,Default,,0,0,0,,Бірақ менің ойымша, сіз қолыңыздан келгеннің бәрін істеуге шешім қабылдағаныңыз маңызды.
Dialogue: 0,0:10:58.24,0:11:01.32,Default,,0,0,0,,Маған сенің айтқаның мен істегенің ұнамайды.
Dialogue: 0,0:11:02.62,0:11:05.33,Default,,0,0,0,,Мен сіздің күш-жігеріңізді мойындаймын.
Dialogue: 0,0:11:05.41,0:11:06.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:11.92,0:11:13.13,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:13.92,0:11:18.92,Default,,0,0,0,,Мен құнды адам болғым келмеді... Шындық.
Dialogue: 0,0:11:21.09,0:11:22.34,Default,,0,0,0,,The shitty kid
Dialogue: 0,0:11:23.97,0:11:27.60,Default,,0,0,0,,Оны мойындауыңды кім сұрады?
Dialogue: 0,0:11:55.58,0:11:59.80,Default,,0,0,0,,Сіз маған қарсы жеңе алмайсыз
Dialogue: 0,0:12:00.30,0:12:01.84,Default,,0,0,0,,Жылдамдату
Dialogue: 0,0:12:13.23,0:12:17.19,Default,,0,0,0,,Түсіндіңіз бе? Толық айырмашылық
Dialogue: 0,0:12:17.77,0:12:21.28,Default,,0,0,0,,Осы айырмашылыққа қарамастан, егер сіз әлі де маған қарсы тұрсаңыз.
Dialogue: 0,0:12:21.86,0:12:24.11,Default,,0,0,0,,Мен де бұрыштарды кеспеймін.
Dialogue: 0,0:12:24.61,0:12:25.11,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:12:25.20,0:12:26.28,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:12:27.74,0:12:31.04,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:12:32.54,0:12:36.04,Default,,0,0,0,,Отбасыңмен тату өмір сүру үшін...?
Dialogue: 0,0:12:38.38,0:12:40.42,Default,,0,0,0,,Жәндіктердің сілекейі ағады
Dialogue: 0,0:12:41.76,0:12:45.47,Default,,0,0,0,,Менімен бірдей жағдайда болғанымен, бұл ой...
Dialogue: 0,0:12:45.97,0:12:48.80,Default,,0,0,0,,Айналаңыздағы адамдар сізге өте батасын берді.
Dialogue: 0,0:12:49.76,0:12:55.14,Default,,0,0,0,,Жарайды, маған қаншалықты байсалды екеніңізді көрсетіңізші.
Dialogue: 0,0:12:56.65,0:12:59.69,Default,,0,0,0,,Бұл сиқырлы күшті соратын сиқырлы құрал.
Dialogue: 0,0:13:00.19,0:13:04.07,Default,,0,0,0,,30 минуттан кейін досыңның сиқырлы күші жойылады.
Dialogue: 0,0:13:04.15,0:13:08.16,Default,,0,0,0,,Туа біткен белгі жойылып, өмір бойы сиқырды пайдалана алмайсыз.
Dialogue: 0,0:13:09.62,0:13:14.41,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіздің досыңыз сізбен бірдей жағдайда болады.
Dialogue: 0,0:13:14.91,0:13:16.83,Default,,0,0,0,,Сіз бақыттысыз ба?
Dialogue: 0,0:13:18.63,0:13:21.21,Default,,0,0,0,,Егер сіз шынымен солай айтқыңыз келсе.
Dialogue: 0,0:13:21.30,0:13:25.09,Default,,0,0,0,,Мен бұл масканы сындырамын.
Dialogue: 0,0:13:25.76,0:13:27.97,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:13:28.05,0:13:29.35,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:13:30.10,0:13:31.60,Default,,0,0,0,,Сондықтан өзіңізді еркін сезініңіз
Dialogue: 0,0:13:32.43,0:13:34.10,Default,,0,0,0,,Сфераны жеделдету
Dialogue: 0,0:13:37.44,0:13:40.86,Default,,0,0,0,,Кез келген адам өзінің идеалдары туралы айта алады
Dialogue: 0,0:13:41.44,0:13:43.61,Default,,0,0,0,,Сен тек ауыз ғанасың ғой.
Dialogue: 0,0:13:49.16,0:13:50.20,Default,,0,0,0,,(тесетін дыбыс)
Dialogue: 0,0:13:56.25,0:14:00.38,Default,,0,0,0,,Ақырында ешкімді қорғай алмайсың.
Dialogue: 0,0:14:01.21,0:14:01.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:02.34,0:14:04.13,Default,,0,0,0,,Қылыш... шықпайды.
Dialogue: 0,0:14:05.76,0:14:07.22,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:14:07.30,0:14:09.93,Default,,0,0,0,,Мен іш бұлшықеттеріне күш саламын деп ойламадым...
Dialogue: 0,0:14:10.97,0:14:13.85,Default,,0,0,0,,Менің іш қуысым қатты, солай емес пе?
Dialogue: 0,0:14:14.81,0:14:15.68,Default,,0,0,0,,Эй!
Dialogue: 0,0:14:17.56,0:14:18.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:21.98,0:14:22.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:28.82,0:14:32.24,Default,,0,0,0,,Мына қызыл көздер, мүмкін...
Dialogue: 0,0:14:35.70,0:14:37.08,Default,,0,0,0,,Сізде кептеліс бар ма?
Dialogue: 0,0:14:40.37,0:14:43.13,Default,,0,0,0,,Сіз білмейсіз бе? бұл көздер
Dialogue: 0,0:14:43.71,0:14:44.63,Default,,0,0,0,,Иә
Dialogue: 0,0:14:45.80,0:14:47.05,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:47.13,0:14:48.59,Default,,0,0,0,,Кешірім сұрама
Dialogue: 0,0:14:49.09,0:14:50.01,Default,,0,0,0,,Иә
Dialogue: 0,0:14:51.26,0:14:55.01,Default,,0,0,0,,Бұл көз – Жаман көз.
Dialogue: 0,0:14:56.18,0:14:59.98,Default,,0,0,0,,Қарсыластың сиқырлы Ібіліс көзін қолдануына уақытша кедергі жасайды
Dialogue: 0,0:15:01.27,0:15:04.02,Default,,0,0,0,,Сиқырдың бәрі бар бұл дүниеде
Dialogue: 0,0:15:04.11,0:15:07.78,Default,,0,0,0,,Мен қорқыныш объектісі ретінде аулақ болдым.
Dialogue: 0,0:15:09.32,0:15:11.82,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:15:11.91,0:15:14.41,Default,,0,0,0,,Маған жарамайды... Сол көздер
Dialogue: 0,0:15:15.12,0:15:17.66,Default,,0,0,0,,Хехе, жарайды.
Dialogue: 0,0:15:18.58,0:15:22.37,Default,,0,0,0,,Мен сиқырды қолдана алатындардың табиғи жауымын.
Dialogue: 0,0:15:22.88,0:15:26.25,Default,,0,0,0,,Мені әрқашан қорқынышты және қорқынышты деп санайтын.
Dialogue: 0,0:15:27.30,0:15:30.51,Default,,0,0,0,,Айналамдағылардың бәрі, тіпті ата-анам да.
Dialogue: 0,0:15:31.01,0:15:32.93,Default,,0,0,0,,Сізге ұнайды
Dialogue: 0,0:15:33.01,0:15:36.89,Default,,0,0,0,,Айналаңыздағы адамдар сізге батаға ие болса, сенбес едіңіз...
Dialogue: 0,0:15:38.97,0:15:42.98,Default,,0,0,0,,Кейбір адамдар бар, бұл дүниеде туылмаса жақсы болар еді.
Dialogue: 0,0:15:46.52,0:15:49.32,Default,,0,0,0,,Секундтарды жеделдету
Dialogue: 0,0:15:56.95,0:15:58.54,Default,,0,0,0,,Күш өрісі
Dialogue: 0,0:16:01.00,0:16:01.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:03.12,0:16:03.62,Default,,0,0,0,,Хекл...
Dialogue: 0,0:16:11.01,0:16:15.51,Default,,0,0,0,,Сіз таң қалдыңыз ба? Мен кешіккенімді түсіндім
Dialogue: 0,0:16:16.01,0:16:20.02,Default,,0,0,0,,Бұл кеңістік меннен басқаның қимылын баяулатады.
Dialogue: 0,0:16:20.52,0:16:24.02,Default,,0,0,0,,Бұл менің қозғалысымды тездетеді.
Dialogue: 0,0:16:32.65,0:16:36.03,Default,,0,0,0,,Екінші мүмкіндік болмайды. Бұл шын мәнінде ақырзаман.
Dialogue: 0,0:16:42.87,0:16:44.16,Default,,0,0,0,,(Присцилла) Сол тәрбиесіз шлюхаға—
Dialogue: 0,0:16:50.09,0:16:52.88,Default,,0,0,0,,Жылдамдық төмендесе де, бұл қуат
Dialogue: 0,0:16:53.38,0:16:55.26,Default,,0,0,0,,Бірақ бұл менің шабуылымның ауқымы ...
Dialogue: 0,0:16:55.34,0:16:55.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:58.22,0:16:59.22,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:03.35,0:17:04.89,Default,,0,0,0,,Ха... Түсіндім.
Dialogue: 0,0:17:04.98,0:17:10.15,Default,,0,0,0,,Мен еденді ертерек сындырған себебім, қозғалыс маршрутымды шектеу болды...
Dialogue: 0,0:17:11.69,0:17:13.36,Default,,0,0,0,,Артқа шегініп, қалыпқа келіңіз...
Dialogue: 0,0:17:14.19,0:17:15.36,Default,,0,0,0,,Аяқтар...
Dialogue: 0,0:17:19.87,0:17:22.49,Default,,0,0,0,,Мен оны екінші рет алдым.
Dialogue: 0,0:17:23.08,0:17:24.37,Default,,0,0,0,,Толық маскалар сиқыры
Dialogue: 0,0:17:26.12,0:17:27.62,Default,,0,0,0,,Дауыл
Dialogue: 0,0:17:27.71,0:17:28.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:29.33,0:17:30.09,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:32.59,0:17:33.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:37.01,0:17:42.06,Default,,0,0,0,,Менің секундтарым осындай түсініксіз зорлық-зомбылыққа ұшырады...
Dialogue: 0,0:17:46.89,0:17:48.23,Default,,0,0,0,,Грюц!
Dialogue: 0,0:17:49.40,0:17:51.82,Default,,0,0,0,,Әртүрлі өлшемдер...
Dialogue: 0,0:17:54.53,0:17:56.57,Default,,0,0,0,,Мен осы жерде жеңілсем, мен...
Dialogue: 0,0:17:57.57,0:17:59.95,Default,,0,0,0,,Менің бар болу себебім...
Dialogue: 0,0:18:01.37,0:18:02.12,Default,,0,0,0,,Жылдамдаңыз!
Dialogue: 0,0:18:11.46,0:18:12.34,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:18:12.84,0:18:13.88,Default,,0,0,0,,Форум!
Dialogue: 0,0:18:15.67,0:18:17.09,Default,,0,0,0,,Уф! Гах...
Dialogue: 0,0:18:18.38,0:18:19.97,Default,,0,0,0,,Квадрицепс
Dialogue: 0,0:18:22.05,0:18:23.06,Default,,0,0,0,,Pectal!
Dialogue: 0,0:18:25.81,0:18:27.18,Default,,0,0,0,,Илиосоас!
Dialogue: 0,0:18:36.24,0:18:39.03,Default,,0,0,0,,Эриктрия омыртқасы!
Dialogue: 0,0:18:52.29,0:18:54.55,Default,,0,0,0,,Мен бұл туралы ойланбай тұра алмаймын.
Dialogue: 0,0:18:55.30,0:18:58.01,Default,,0,0,0,,Егер мен қалыпты дүниеге келсем...
Dialogue: 0,0:19:00.26,0:19:05.43,Default,,0,0,0,,Бұл көз есіме түспей тұрып пайда болды.
Dialogue: 0,0:19:06.60,0:19:09.77,Default,,0,0,0,,Әрине, ата-анам қатты ренжіді.
Dialogue: 0,0:19:10.77,0:19:14.61,Default,,0,0,0,,Өйткені ол Құдай берген сиқырдың бар екенін жоққа шығарады...
Dialogue: 0,0:19:15.11,0:19:17.11,Default,,0,0,0,,Өйткені бұл шайтанның көзі
Dialogue: 0,0:19:19.53,0:19:23.07,Default,,0,0,0,,Туған ізі жоқ баланы өлтіргендей.
Dialogue: 0,0:19:23.16,0:19:26.03,Default,,0,0,0,,Мен де бұл дүниеде біртүрлі жанмын.
Dialogue: 0,0:19:27.04,0:19:32.88,Default,,0,0,0,,Менің бар екенімді білмеу үшін үйдегілер мені үйімнің жертөлесіне қамап қойды.
Dialogue: 0,0:19:33.54,0:19:37.46,Default,,0,0,0,,Уақыты келгенде сыртта тамақ қана қалады.
Dialogue: 0,0:19:37.96,0:19:40.55,Default,,0,0,0,,Өмір бір күні осылай жалғаса берді...
Dialogue: 0,0:19:42.55,0:19:45.76,Default,,0,0,0,,Ата-анам мені өлтірмек болды
Dialogue: 0,0:19:46.89,0:19:50.06,Default,,0,0,0,,Мен сияқты бала дүниеге келгендіктен болар.
Dialogue: 0,0:19:50.14,0:19:52.31,Default,,0,0,0,,Толған болуы керек.
Dialogue: 0,0:19:55.73,0:19:58.28,Default,,0,0,0,,Мен мұны түсіндім
Dialogue: 0,0:19:59.86,0:20:03.11,Default,,0,0,0,,Мен туылмауым керек еді.
Dialogue: 0,0:20:06.33,0:20:09.58,Default,,0,0,0,,Әбілқайыр мырза маған солай керек болды.
Dialogue: 0,0:20:10.79,0:20:14.83,Default,,0,0,0,,Пайдалы құрал болса да
Dialogue: 0,0:20:16.34,0:20:17.63,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:18.13,0:20:21.63,Default,,0,0,0,,Мен бұл үміттерді ақтай алмадым.
Dialogue: 0,0:20:22.59,0:20:27.85,Default,,0,0,0,,Мен қайтадан қажетсіз адамға айналдым.
Dialogue: 0,0:20:28.97,0:20:33.39,Default,,0,0,0,,Өзіңіз айтқандай, мен жарылқадым деп ойлаймын.
Dialogue: 0,0:20:33.48,0:20:36.48,Default,,0,0,0,,Сезіміңізге жанашырлық таныта алмаймын
Dialogue: 0,0:20:36.98,0:20:40.28,Default,,0,0,0,,Қарсы болмасаң, мен саған дос боламын...
Dialogue: 0,0:20:40.36,0:20:41.65,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:41.74,0:20:45.20,Default,,0,0,0,,Сен шынында да адал, жақсы қызсың.
Dialogue: 0,0:20:45.70,0:20:47.62,Default,,0,0,0,,Шынымды айтсам мен қызғанамын
Dialogue: 0,0:20:48.49,0:20:50.41,Default,,0,0,0,,Бірақ бұл мүмкін емес.
Dialogue: 0,0:20:50.91,0:20:55.00,Default,,0,0,0,,Осы көздерің бар болса, санаң бір күні өзгереді.
Dialogue: 0,0:20:56.04,0:21:00.75,Default,,0,0,0,,Дегенмен, мейірімділігіңізге қарамастан, сізге айтар бір кеңесім бар.
Dialogue: 0,0:21:01.76,0:21:04.34,Default,,0,0,0,,Одан әрі қарай жүрмеңіз.
Dialogue: 0,0:21:05.09,0:21:07.51,Default,,0,0,0,,Сіз Абыл мырзаны жеңе алмайсыз.
Dialogue: 0,0:21:09.76,0:21:13.77,Default,,0,0,0,,Ол кісінің күші мен сенімен бетпе-бет келген кезіммен салыстырғанда ештеңе емес.
Dialogue: 0,0:21:14.27,0:21:15.98,Default,,0,0,0,,Сен мені біраз күш-қуатпен жеңсең де...
Dialogue: 0,0:21:16.06,0:21:18.06,Default,,0,0,0,,Кеңес Рахмет
Dialogue: 0,0:21:18.65,0:21:21.98,Default,,0,0,0,,Бірақ мен сені ұруым керек.
Dialogue: 0,0:21:22.07,0:21:23.15,Default,,0,0,0,,Мені тезірек үйге жіберші.
Dialogue: 0,0:21:24.03,0:21:26.91,Default,,0,0,0,,Мен өз ойымды өзгертпеймін.
Dialogue: 0,0:21:26.99,0:21:27.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:28.41,0:21:31.99,Default,,0,0,0,,Бұл дүниеде көзің қанша қажетсіз болса да
Dialogue: 0,0:21:32.66,0:21:36.16,Default,,0,0,0,,Сол себепті, адамдар не десе де,
Dialogue: 0,0:21:37.21,0:21:40.42,Default,,0,0,0,,Менің саған деген көзқарасым өзгермейді.
Dialogue: 0,0:21:43.42,0:21:46.17,Default,,0,0,0,,Өйткені мен сиқырды қолдана алмаймын
Dialogue: 0,0:21:46.26,0:21:48.93,Default,,0,0,0,,Мені атам солай өсірді.
Dialogue: 0,0:21:51.30,0:21:53.85,Default,,0,0,0,,Келесі жолы бірге кілегейлі бөренелерді жейміз.
Dialogue: 0,0:21:54.43,0:21:55.56,Default,,0,0,0,,Олай болса
Dialogue: 0,0:21:59.90,0:22:03.48,Default,,0,0,0,,Хехе, қызық бала екен.
Dialogue: 0,0:22:05.94,0:22:07.95,Default,,0,0,0,,♪~
Dialogue: 0,0:23:33.87,0:23:35.87,Default,,0,0,0,,~♪
