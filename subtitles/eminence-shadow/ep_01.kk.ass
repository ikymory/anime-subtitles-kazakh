Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.46,0:00:13.51,Default,,0,0,0,,(оятар дабылы)
Dialogue: 0,0:00:13.59,0:00:16.14,Default,,0,0,0,,(Оқушылар) Э-э… Мүмкін емес! Мүмкін емес!
Dialogue: 0,0:00:20.22,0:00:21.35,Default,,0,0,0,,(Дабылды тоқтату үшін дыбыс)
Dialogue: 0,0:00:21.43,0:00:23.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:24.35,0:00:26.69,Default,,0,0,0,,Жаңа ғана ұйықтап қалдыңыз ба?
Dialogue: 0,0:00:27.69,0:00:28.77,Default,,0,0,0,,Хмм
Dialogue: 0,0:00:30.73,0:00:33.74,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:01:09.69,0:01:11.57,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:12.61,0:01:14.28,Default,,0,0,0,,Ханым, а
Dialogue: 0,0:01:16.82,0:01:17.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:20.49,0:01:23.04,Default,,0,0,0,,Ха... ештеңе жоқ.
Dialogue: 0,0:01:24.75,0:01:25.87,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,0:01:25.96,0:01:27.58,Default,,0,0,0,,(қозғалтқыштың іске қосу дыбысы)
Dialogue: 0,0:01:35.47,0:01:40.05,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:01:46.31,0:01:48.10,Default,,0,0,0,,Қайырлы таң, Нишино-сан
Dialogue: 0,0:01:48.19,0:01:49.65,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:01:49.73,0:01:51.69,Default,,0,0,0,,Қайырлы таң, Сенпай.
Dialogue: 0,0:01:51.77,0:01:53.73,Default,,0,0,0,,Иә, қайырлы таң
Dialogue: 0,0:01:53.82,0:01:54.78,Default,,0,0,0,,Ах
Dialogue: 0,0:02:00.20,0:02:03.12,Default,,0,0,0,,Мен жек көретін бір бала болды
Dialogue: 0,0:02:03.20,0:02:04.45,Default,,0,0,0,,Я...
Dialogue: 0,0:02:05.04,0:02:06.54,Default,,0,0,0,,Қайырлы таң, Кагено-кун
Dialogue: 0,0:02:06.62,0:02:10.04,Default,,0,0,0,,Бағалар орташадан төмен, жеңіл атлетика да орташадан төмен.
Dialogue: 0,0:02:10.12,0:02:12.17,Default,,0,0,0,,Сыртқы түрі өте қарапайым
Dialogue: 0,0:02:12.25,0:02:14.34,Default,,0,0,0,,Қайырлы таң, Нишимура мырза
Dialogue: 0,0:02:19.93,0:02:21.93,Default,,0,0,0,,Сол Кагено-кун
Dialogue: 0,0:02:22.01,0:02:23.72,Default,,0,0,0,,Бұл не, Нишимура мырза?
Dialogue: 0,0:02:23.81,0:02:27.06,Default,,0,0,0,,Менің атым Нишимура емес.
Dialogue: 0,0:02:28.64,0:02:29.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:30.06,0:02:32.36,Default,,0,0,0,,Хе хехе...
Dialogue: 0,0:02:33.82,0:02:36.94,Default,,0,0,0,,Менің атым Нишимура емес.
Dialogue: 0,0:02:37.53,0:02:38.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:38.78,0:02:40.57,Default,,0,0,0,,Бұл Нишимура емес.
Dialogue: 0,0:02:41.41,0:02:43.28,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:02:43.37,0:02:45.20,Default,,0,0,0,,Иә, менің атым...
Dialogue: 0,0:02:45.29,0:02:47.79,Default,,0,0,0,,А, күте тұр, есімде.
Dialogue: 0,0:02:47.87,0:02:51.46,Default,,0,0,0,,Сіз атаулы кейіпкер болдыңыз, солай ма?
Dialogue: 0,0:02:51.54,0:02:53.17,Default,,0,0,0,,Аталды?
Dialogue: 0,0:02:53.25,0:02:54.79,Default,,0,0,0,,Әй, бұл оқиға.
Dialogue: 0,0:02:55.55,0:02:59.34,Default,,0,0,0,,Маңызды адамдардың есімдерін жақсы есте сақтаймын.
Dialogue: 0,0:02:59.42,0:03:00.97,Default,,0,0,0,,Соңғы кездері ұйқым қанбай жүр.
Dialogue: 0,0:03:01.72,0:03:03.72,Default,,0,0,0,,Мен абайсызда болдым деп ойлаймын.
Dialogue: 0,0:03:04.35,0:03:05.85,Default,,0,0,0,,Сіз абайсыз ба?
Dialogue: 0,0:03:05.93,0:03:06.93,Default,,0,0,0,,Бір сынып
Dialogue: 0,0:03:07.02,0:03:10.48,Default,,0,0,0,,Қасыңа отырғаныма 3 ай болды. 3 ай.
Dialogue: 0,0:03:10.56,0:03:13.77,Default,,0,0,0,,Жарайды, барлығы қателеседі.
Dialogue: 0,0:03:13.86,0:03:15.69,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:03:15.77,0:03:17.03,Default,,0,0,0,,Нишитани мырза
Dialogue: 0,0:03:17.11,0:03:18.74,Default,,0,0,0,,Нишиноя емес!
Dialogue: 0,0:03:18.82,0:03:20.74,Default,,0,0,0,,Нишино (Кагено) Иә?
Dialogue: 0,0:03:20.82,0:03:22.70,Default,,0,0,0,,Мен Акане Нишиномын
Dialogue: 0,0:03:29.29,0:03:31.16,Default,,0,0,0,,А, онда Нишимура мырза.
Dialogue: 0,0:03:31.25,0:03:34.04,Default,,0,0,0,,Нишино! Қайтып келді!
Dialogue: 0,0:03:34.96,0:03:36.25,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:03:36.34,0:03:37.46,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:38.34,0:03:40.17,Default,,0,0,0,,Ең бастысы, мен кешіре алмадым
Dialogue: 0,0:03:40.26,0:03:42.26,Default,,0,0,0,,Бұл оның атын қате алғанында емес.
Dialogue: 0,0:03:43.05,0:03:45.72,Default,,0,0,0,,Ол мені көрмейді
Dialogue: 0,0:03:46.26,0:03:48.47,Default,,0,0,0,,Кейде адамдар маған қарайды
Dialogue: 0,0:03:48.56,0:03:52.23,Default,,0,0,0,,Әрқашан алыстан басқа жаққа қарау
Dialogue: 0,0:03:52.81,0:03:56.27,Default,,0,0,0,,Мен мұны түсінгенде, мен оны мүлдем жек көрдім.
Dialogue: 0,0:03:56.36,0:03:59.11,Default,,0,0,0,,Акане, келесі айда 9-да драманың басты кейіпкері боласыз, солай ма?
Dialogue: 0,0:03:59.69,0:04:00.78,Default,,0,0,0,,Ха? Эээ!
Dialogue: 0,0:04:00.86,0:04:02.20,Default,,0,0,0,,Бұл неше рет?
Dialogue: 0,0:04:02.28,0:04:04.11,Default,,0,0,0,,Өткен жылмен салыстырғанда қарқын жоғары емес пе?
Dialogue: 0,0:04:04.20,0:04:07.74,Default,,0,0,0,,Мен күйзелістен өлейін деп тұрмын.
Dialogue: 0,0:04:07.83,0:04:09.87,Default,,0,0,0,,Міндетті түрде көремін, хехе
Dialogue: 0,0:04:10.62,0:04:14.12,Default,,0,0,0,,Мен Кагено-кунмен мүмкіндігінше араласпауға тырыстым.
Dialogue: 0,0:04:14.62,0:04:17.17,Default,,0,0,0,,Негізі мен оны мүлдем елемей кеткім келді, бірақ
Dialogue: 0,0:04:17.25,0:04:20.34,Default,,0,0,0,,Жағдайға байланысты мен назар аудартудан аулақ болғым келді.
Dialogue: 0,0:04:20.88,0:04:24.76,Default,,0,0,0,,20,553 20,554 20,000...
Dialogue: 0,0:04:27.80,0:04:29.68,Default,,0,0,0,,Хехехе
Dialogue: 0,0:04:30.26,0:04:32.43,Default,,0,0,0,,(Ағын су дыбысы)
Dialogue: 0,0:04:36.02,0:04:37.77,Default,,0,0,0,,Мен орта мектепте оқып жүрген кезім
Dialogue: 0,0:04:37.86,0:04:41.40,Default,,0,0,0,,Оның жанжалдарға байланысты ойын-сауық қызметін тоқтату тарихы бар.
Dialogue: 0,0:04:45.15,0:04:47.28,Default,,0,0,0,,Сол оқиғадан кейін
Dialogue: 0,0:04:47.37,0:04:50.79,Default,,0,0,0,,Мен маска кие бастадым
Dialogue: 0,0:04:51.45,0:04:54.29,Default,,0,0,0,,Ядролық... Тірі заттардың шектері
Dialogue: 0,0:04:59.84,0:05:02.34,Default,,0,0,0,,көбірек қуат…
Dialogue: 0,0:05:04.01,0:05:07.14,Default,,0,0,0,,Сонымен, мектептегі фестиваль сауалнамасы туралы не айтасыз?
Dialogue: 0,0:05:07.22,0:05:08.97,Default,,0,0,0,,А, мұғалім, И
Dialogue: 0,0:05:09.05,0:05:11.81,Default,,0,0,0,,Әй, бірақ Нишино-сан, сенде қазір қосымша сабақ болады.
Dialogue: 0,0:05:11.89,0:05:12.72,Default,,0,0,0,,Ах
Dialogue: 0,0:05:12.81,0:05:14.48,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:05:15.10,0:05:17.40,Default,,0,0,0,,Соңғы кездері сіз жұмыстан бос емес сияқтысыз.
Dialogue: 0,0:05:17.48,0:05:19.94,Default,,0,0,0,,Ақанені олай жек көруге болмайды.
Dialogue: 0,0:05:20.02,0:05:21.77,Default,,0,0,0,,Барлығы тым қатты күліп жатыр
Dialogue: 0,0:05:21.86,0:05:24.65,Default,,0,0,0,,Олай болса көршіңізден сұраңыз...
Dialogue: 0,0:05:24.74,0:05:25.86,Default,,0,0,0,,Иә
Dialogue: 0,0:05:26.57,0:05:28.36,Default,,0,0,0,,Кәне, үйірме жұмыстары
Dialogue: 0,0:05:28.45,0:05:30.45,Default,,0,0,0,,Үйге бара жатқанда Мицугошиге тоқтағыңыз келе ме?
Dialogue: 0,0:05:31.16,0:05:33.75,Default,,0,0,0,,Мен мұғалімнің мені жек көргенін қаламаймын⸺
Dialogue: 0,0:05:33.83,0:05:35.50,Default,,0,0,0,,Құрметті студент
Dialogue: 0,0:05:35.58,0:05:39.33,Default,,0,0,0,,Оқушылар сізді ұнатпайтындай танымал болыңыз.
Dialogue: 0,0:05:39.42,0:05:42.80,Default,,0,0,0,,Мені ешкім жек көрмейтіндей еңбек еттім.
Dialogue: 0,0:05:43.46,0:05:46.84,Default,,0,0,0,,Бүгінге дейін осылай өмір сүрдім.
Dialogue: 0,0:05:45.09,0:05:50.09,Default,,0,0,0,,Ватару!
Dialogue: 0,0:06:46.15,0:06:47.40,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:06:49.86,0:06:54.24,Default,,0,0,0,,Бітіргеннен кейін маған кел.
Dialogue: 0,0:06:54.33,0:06:55.70,Default,,0,0,0,,Ол шықпайды.
Dialogue: 0,0:07:12.51,0:07:15.93,Default,,0,0,0,,Мен сол оқиғадан бері үйге жаяу барған жоқпын.
Dialogue: 0,0:07:20.89,0:07:22.02,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:24.94,0:07:26.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:27.65,0:07:30.32,Default,,0,0,0,,Аа... Ааа
Dialogue: 0,0:07:31.20,0:07:32.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:35.70,0:07:37.70,Default,,0,0,0,,Акане Нишино
Dialogue: 0,0:07:39.91,0:07:41.66,Default,,0,0,0,,Неліктен неге...
Dialogue: 0,0:07:42.17,0:07:43.46,Default,,0,0,0,,Тағы да!?
Dialogue: 0,0:07:44.58,0:07:45.54,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:07:48.09,0:07:48.96,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:07:49.05,0:07:50.17,Default,,0,0,0,,Жоқ... а
Dialogue: 0,0:07:53.84,0:07:55.64,Default,,0,0,0,,Ей, ашуланба.
Dialogue: 0,0:07:55.72,0:08:00.14,Default,,0,0,0,,(Ақанның қиналған дауысы)
Dialogue: 0,0:08:09.48,0:08:11.19,Default,,0,0,0,,Ол ақырында жұмыс істеді.
Dialogue: 0,0:08:11.28,0:08:12.82,Default,,0,0,0,,Жарайды, тез апар.
Dialogue: 0,0:08:12.90,0:08:15.87,Default,,0,0,0,,А? Маған бұйрық берме, бейтаныс.
Dialogue: 0,0:08:27.34,0:08:28.42,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:36.01,0:08:37.05,Default,,0,0,0,,Ах
Dialogue: 0,0:08:38.05,0:08:39.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:39.39,0:08:41.39,Default,,0,0,0,,Ха-ха-ха-ха…
Dialogue: 0,0:08:42.10,0:08:43.68,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:08:43.77,0:08:48.65,Default,,0,0,0,,Нишино Зайбатсудан келген жас келіншек түнде жалғыз жүреді.
Dialogue: 0,0:08:48.73,0:08:51.36,Default,,0,0,0,,Жаман жігіттің қолына түсесің, солай ма?
Dialogue: 0,0:08:51.44,0:08:55.66,Default,,0,0,0,,Тыныш болыңыз. Мен саған қорқытып хат жібердім. Егер сіз маған ақша төлесеңіз, мен сізді үйге жіберемін.
Dialogue: 0,0:08:55.74,0:08:57.99,Default,,0,0,0,,Шындық дегеннің бетінде болғаны.
Dialogue: 0,0:08:58.07,0:09:01.33,Default,,0,0,0,,Қартыңыздың оған деген реніші көп сияқты.
Dialogue: 0,0:09:01.41,0:09:03.33,Default,,0,0,0,,Әй, үндеме! (Ұрлаушы) Әй?
Dialogue: 0,0:09:03.91,0:09:06.83,Default,,0,0,0,,Сырт келбетіңіз сізді бастық етіп көрсетуіне жол бермеңіз!
Dialogue: 0,0:09:06.92,0:09:10.50,Default,,0,0,0,,Сен маған аузыңды жап деп тұрсың, көне бұзақы!
Dialogue: 0,0:09:29.40,0:09:31.86,Default,,0,0,0,,А, бұл тітіркендіргіш.
Dialogue: 0,0:09:32.82,0:09:35.82,Default,,0,0,0,,Ақыры сәті түссе де, бәрібір әбігер.
Dialogue: 0,0:09:36.49,0:09:39.16,Default,,0,0,0,,Ха, мені жұбатыңыз.
Dialogue: 0,0:09:39.24,0:09:40.95,Default,,0,0,0,,Бұл желдеткіш қызметі.
Dialogue: 0,0:09:41.03,0:09:43.24,Default,,0,0,0,,Біріншіден, сол әдемі ауызбен...
Dialogue: 0,0:09:43.33,0:09:44.79,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:45.29,0:09:47.00,Default,,0,0,0,,Қарсылық жасамаңыз!
Dialogue: 0,0:09:47.08,0:09:48.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:49.04,0:09:49.92,Default,,0,0,0,,Я...
Dialogue: 0,0:09:51.21,0:09:56.22,Default,,0,0,0,,Ха, бәрібір үйреніп қалдың ғой, солай ма? Мен екінші рет ұрланып отырмын.
Dialogue: 0,0:09:56.30,0:09:57.34,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:57.43,0:10:01.26,Default,,0,0,0,,Бұрынғы қылмыскер аңдыушы болды ма?
Dialogue: 0,0:10:01.35,0:10:03.72,Default,,0,0,0,,Мен оны сол кезден жақсы есте қалдырамын.
Dialogue: 0,0:10:03.81,0:10:05.68,Default,,0,0,0,,(Ақанның қиналған дауысы)
Dialogue: 0,0:10:05.77,0:10:08.14,Default,,0,0,0,,Зорлық-зомбылық жасама, ешкім...
Dialogue: 0,0:10:08.23,0:10:09.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:09.69,0:10:10.61,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:10.69,0:10:14.03,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:10:16.86,0:10:19.28,Default,,0,0,0,,Не!? Жоқ, ол кім!
Dialogue: 0,0:10:19.36,0:10:20.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:24.54,0:10:27.37,Default,,0,0,0,,Ах... а
Dialogue: 0,0:10:36.42,0:10:38.34,Default,,0,0,0,,Қарғыс атсын, саған!
Dialogue: 0,0:10:38.42,0:10:44.31,Default,,0,0,0,,Мен? Мен жай ғана стильді бұзақымын
Dialogue: 0,0:10:44.97,0:10:48.48,Default,,0,0,0,,Стильді... (Ұрлап алушы) Қасқыр өлтіруші ме?
Dialogue: 0,0:10:49.35,0:10:51.69,Default,,0,0,0,,Ақымақ болма, кел!
Dialogue: 0,0:10:52.52,0:10:53.65,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:53.73,0:10:56.57,Default,,0,0,0,,Қозғалыс ысырап, Кеңістікке толы
Dialogue: 0,0:10:56.65,0:10:58.07,Default,,0,0,0,,Гуааа…
Dialogue: 0,0:11:00.36,0:11:01.57,Default,,0,0,0,,《Міне, басталды!》
Dialogue: 0,0:11:02.95,0:11:06.24,Default,,0,0,0,,Түсіндім, сіз жақсы жұмыс істеп жатқан сияқтысыз.
Dialogue: 0,0:11:06.33,0:11:09.71,Default,,0,0,0,,Стильді бұзақы өлтіруші
Dialogue: 0,0:11:12.00,0:11:16.25,Default,,0,0,0,,Әскерден қуылғаннан бері жалықтым.
Dialogue: 0,0:11:16.34,0:11:20.88,Default,,0,0,0,,Қарапайым жас қызды ұрлау, серіктес гей әуесқой
Dialogue: 0,0:11:21.76,0:11:23.84,Default,,0,0,0,,Бұл ел тым тыныш
Dialogue: 0,0:11:23.93,0:11:28.31,Default,,0,0,0,,Мен түсіндім, бұл дұрыс. Бірде солдатпен соғысқым келді.
Dialogue: 0,0:11:28.39,0:11:32.77,Default,,0,0,0,,Хо, қош келдіңіз, стильді бұзақы өлтіруші!
Dialogue: 0,0:11:33.69,0:11:37.19,Default,,0,0,0,,Осы ақылсыз әлемге қош келдіңіз!
Dialogue: 0,0:11:40.24,0:11:41.78,Default,,0,0,0,,Кухаха...
Dialogue: 0,0:11:42.49,0:11:44.57,Default,,0,0,0,,Мен енді білемін
Dialogue: 0,0:11:46.91,0:11:49.29,Default,,0,0,0,,Осы ләззаттан ләззат алыңыз!
Dialogue: 0,0:11:52.75,0:11:54.63,Default,,0,0,0,,Бар... Бар!?
Dialogue: 0,0:11:55.84,0:11:57.21,Default,,0,0,0,,Гррр…
Dialogue: 0,0:11:57.29,0:11:59.30,Default,,0,0,0,,Лом жақсы, бұрынғы солдат.
Dialogue: 0,0:11:59.38,0:12:02.68,Default,,0,0,0,,Берік және сынбайтын Тасымалдау оңай
Dialogue: 0,0:12:02.76,0:12:05.30,Default,,0,0,0,,Жұмысыңыз сұралса да, сіз ақтауға болады.
Dialogue: 0,0:12:05.39,0:12:06.64,Default,,0,0,0,,Гррр…
Dialogue: 0,0:12:06.72,0:12:08.22,Default,,0,0,0,,Ең бастысы
Dialogue: 0,0:12:08.31,0:12:10.47,Default,,0,0,0,,Тонфа сияқты қолдануға болады
Dialogue: 0,0:12:10.56,0:12:12.44,Default,,0,0,0,,Қап!
Dialogue: 0,0:12:12.52,0:12:15.69,Default,,0,0,0,,Сенің мықты екенің рас, бірақ үлкен кемшілігің бар.
Dialogue: 0,0:12:15.77,0:12:18.82,Default,,0,0,0,,Бұл үлкен физикалық айырмашылық!
Dialogue: 0,0:12:19.90,0:12:20.90,Default,,0,0,0,,Танжиро! Сақ бол!
Dialogue: 0,0:12:22.61,0:12:23.53,Default,,0,0,0,,Иә
Dialogue: 0,0:12:23.61,0:12:28.74,Default,,0,0,0,,Маған тек басымды қорғау керек, бірақ бір рет болса да ұрып кетсем, бітті.
Dialogue: 0,0:12:29.62,0:12:31.00,Default,,0,0,0,,Ал, әрине, мен де сондаймын
Dialogue: 0,0:12:31.79,0:12:34.67,Default,,0,0,0,,Қазір мен бұрынғыдай бір ғана бұрынғы сарбазбен сөйлесу қиынға соғады.
Dialogue: 0,0:12:35.50,0:12:37.08,Default,,0,0,0,,Бұл – шындық.
Dialogue: 0,0:12:38.21,0:12:41.09,Default,,0,0,0,,Олай болса, сәл байыпты болғың келе ме? (Ұрлаушы) А?
Dialogue: 0,0:12:44.88,0:12:46.97,Default,,0,0,0,,Не! Гуаааа...
Dialogue: 0,0:12:47.64,0:12:50.22,Default,,0,0,0,,Мен ломда потенциалды көрдім
Dialogue: 0,0:12:50.31,0:12:55.23,Default,,0,0,0,,Пішіні тонфа тәрізді Оның салмағы Берікті тасымалдануы
Dialogue: 0,0:12:55.31,0:12:58.11,Default,,0,0,0,,Барлық аспектілерде жоғары потенциал
Dialogue: 0,0:12:58.19,0:13:02.19,Default,,0,0,0,,Ол түнде түнде шу шығарған байкерлер тобын ұрып-соғуды жалғастырды.
Dialogue: 0,0:13:02.28,0:13:04.57,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:13:06.57,0:13:11.41,Default,,0,0,0,,Эй, байкерлер тобын ломмен соқ⸺
Dialogue: 0,0:13:11.99,0:13:14.71,Default,,0,0,0,,Әлгі балақай!?
Dialogue: 0,0:13:16.75,0:13:19.88,Default,,0,0,0,,Соңғы уақытта олар дулыға кие бастады.
Dialogue: 0,0:13:19.96,0:13:22.71,Default,,0,0,0,,Басынан ұрса жарайды.
Dialogue: 0,0:13:23.51,0:13:27.38,Default,,0,0,0,,Сонымен мен қорытынды жасадым...
Dialogue: 0,0:13:27.47,0:13:29.35,Default,,0,0,0,,Ух... Ха!
Dialogue: 0,0:13:29.43,0:13:32.60,Default,,0,0,0,,Тонфа ретінде ломды пайдаланудың орнына...
Dialogue: 0,0:13:35.52,0:13:36.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:36.48,0:13:38.56,Default,,0,0,0,,Қалыпты соғу жақсы⸺
Dialogue: 0,0:13:39.61,0:13:40.86,Default,,0,0,0,,Күшті!
Dialogue: 0,0:13:40.94,0:13:42.82,Default,,0,0,0,,Гррр…
Dialogue: 0,0:13:43.86,0:13:46.03,Default,,0,0,0,,Бұл ломның потенциалы
Dialogue: 0,0:13:46.70,0:13:48.41,Default,,0,0,0,,Айла L-тәрізді жағымен соғу.
Dialogue: 0,0:13:48.49,0:13:49.66,Default,,0,0,0,,Мені жеңіл санама!
Dialogue: 0,0:13:50.95,0:13:53.41,Default,,0,0,0,,Себебі әсер шоғырланған
Dialogue: 0,0:13:53.49,0:13:56.91,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:13:57.00,0:13:58.62,Default,,0,0,0,,Ал... күте тұрыңыз.
Dialogue: 0,0:13:58.71,0:13:59.83,Default,,0,0,0,,Аһ! (соққы дыбысы)
Dialogue: 0,0:14:00.58,0:14:02.25,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:14:02.34,0:14:03.38,Default,,0,0,0,,(Көрермен) Мен оны мінген күйдегі шайқасқа дейін қызықты жігіт деп ойладым… (соққы дыбысы)
Dialogue: 0,0:14:03.46,0:14:05.13,Default,,0,0,0,,Ал... күте тұрыңыз...
Dialogue: 0,0:14:05.21,0:14:06.34,Default,,0,0,0,,Ой, жаңбыр жауып тұр— (соққы дыбысы)
Dialogue: 0,0:14:07.05,0:14:08.38,Default,,0,0,0,,Тано... (соққы дыбысы)
Dialogue: 0,0:14:09.05,0:14:10.68,Default,,0,0,0,,Бір... Гувах
Dialogue: 0,0:14:09.34,0:14:10.68,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:14:11.43,0:14:12.81,Default,,0,0,0,,Ой, жаңбыр жауып тұр— (соққы дыбысы)
Dialogue: 0,0:14:14.35,0:14:17.10,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:14:28.36,0:14:29.49,Default,,0,0,0,,Ах
Dialogue: 0,0:14:39.25,0:14:40.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:46.46,0:14:47.34,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:14:47.42,0:14:48.55,Default,,0,0,0,,(кесу дыбысы)
Dialogue: 0,0:14:50.84,0:14:53.26,Default,,0,0,0,,Келесі жолы үйге бара жатқанда абай болыңыз.
Dialogue: 0,0:14:53.35,0:14:54.47,Default,,0,0,0,,Не!
Dialogue: 0,0:14:55.72,0:14:57.02,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:05.11,0:15:06.03,Default,,0,0,0,,Ах
Dialogue: 0,0:15:09.57,0:15:11.16,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:17.24,0:15:21.17,Default,,0,0,0,,Жоқ, бұл бұрынғы әскери адам үшін жақсы емес.
Dialogue: 0,0:15:21.25,0:15:22.71,Default,,0,0,0,,Қолжетімсіз
Dialogue: 0,0:15:24.34,0:15:26.17,Default,,0,0,0,,Жасырын күшке
Dialogue: 0,0:15:29.72,0:15:34.14,Default,,0,0,0,,Осыдан кейін мен полицияға хабарласып, көп қиналдым.
Dialogue: 0,0:15:34.22,0:15:38.64,Default,,0,0,0,,Әкем араласып, оқиға ешқашан жария болған жоқ.
Dialogue: 0,0:15:39.22,0:15:43.10,Default,,0,0,0,,Стильді қаскөй Қанішер кім?
Dialogue: 0,0:15:43.69,0:15:45.11,Default,,0,0,0,,Жұмбақ болып қалады
Dialogue: 0,0:15:49.61,0:15:51.28,Default,,0,0,0,,Қайырлы таң, Нишино-сан
Dialogue: 0,0:15:51.36,0:15:52.95,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:15:53.03,0:15:54.99,Default,,0,0,0,,Қайырлы таң, Сенпай.
Dialogue: 0,0:15:55.07,0:15:57.08,Default,,0,0,0,,Иә, қайырлы таң
Dialogue: 0,0:15:57.16,0:15:58.49,Default,,0,0,0,,Ах
Dialogue: 0,0:16:02.46,0:16:03.67,Default,,0,0,0,,Я...
Dialogue: 0,0:16:04.25,0:16:05.58,Default,,0,0,0,,Қайырлы таң, Кагено-кун
Dialogue: 0,0:16:07.92,0:16:10.13,Default,,0,0,0,,Қайырлы таң Нишино-сан
Dialogue: 0,0:16:11.22,0:16:14.34,Default,,0,0,0,,Иә, иә, Нишино емес... Иә?
Dialogue: 0,0:16:15.80,0:16:18.68,Default,,0,0,0,,Мен атын қате түсінбедім.
Dialogue: 0,0:16:18.76,0:16:22.60,Default,,0,0,0,,Оның да маған қарап тұрғанын сезіндім.
Dialogue: 0,0:16:23.23,0:16:28.57,Default,,0,0,0,,Мен сияқты Кагено-кун да бетперде киіп өмір сүреді.
Dialogue: 0,0:16:28.65,0:16:31.11,Default,,0,0,0,,Неге екені белгісіз, өзімді солай сезіндім.
Dialogue: 0,0:16:31.19,0:16:34.61,Default,,0,0,0,,Енді сенімді болудың жолы жоқ.
Dialogue: 0,0:16:35.70,0:16:41.58,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:16:36.41,0:16:38.12,Default,,0,0,0,,Келесі жаңалықтар
Dialogue: 0,0:16:38.20,0:16:41.58,Default,,0,0,0,,Өткен түнде таң атқанша, Сакуразака қаласындағы қалалық жолда.
Dialogue: 0,0:16:41.66,0:16:44.67,Default,,0,0,0,,Минору Кагено, қалада тұратын орта мектеп оқушысы,
Dialogue: 0,0:16:44.75,0:16:47.08,Default,,0,0,0,,Жүк көлігі қағып өлтірілді
Dialogue: 0,0:16:47.71,0:16:51.76,Default,,0,0,0,,Полиция жүк көлігінің жүргізушісі алға қарамады деп есептейді.
Dialogue: 0,0:16:51.84,0:16:53.47,Default,,0,0,0,,Апаттың егжей-тегжейлі мән-жайын зерттеңіз...
Dialogue: 0,0:16:54.51,0:16:59.51,Default,,0,0,0,,♪~
Dialogue: 0,0:17:49.44,0:17:54.44,Default,,0,0,0,,~♪
Dialogue: 0,0:17:56.95,0:17:59.53,Default,,0,0,0,,Оған не себеп болғаны есімде жоқ.
Dialogue: 0,0:18:00.20,0:18:03.99,Default,,0,0,0,,Алайда, есіме түскенше мен саған тәнті болдым.
Dialogue: 0,0:18:04.08,0:18:08.04,Default,,0,0,0,,Әр адам бала кезінде батырларға сүйсінетіні сияқты.
Dialogue: 0,0:18:08.12,0:18:09.96,Default,,0,0,0,,Мен сондай болғым келді.
Dialogue: 0,0:18:12.04,0:18:14.88,Default,,0,0,0,,Олардың басқа балалардан айырмашылығы сол
Dialogue: 0,0:18:14.96,0:18:18.63,Default,,0,0,0,,Менікі уақытша қызба емес еді.
Dialogue: 0,0:18:18.72,0:18:21.35,Default,,0,0,0,,Жүрегіңнің тереңінде оттай бер
Dialogue: 0,0:18:21.43,0:18:25.31,Default,,0,0,0,,Мені жоғалтпай мәңгілікке елжіретті.
Dialogue: 0,0:18:26.10,0:18:30.48,Default,,0,0,0,,Мен мықты болу үшін не қажет екенін білуге ​​тырыстым.
Dialogue: 0,0:18:30.98,0:18:33.65,Default,,0,0,0,,Мен мектепте орташа болдым.
Dialogue: 0,0:18:33.73,0:18:37.11,Default,,0,0,0,,Ешқашан байқалмайтын, зиянсыз тобыр А
Dialogue: 0,0:18:37.19,0:18:40.99,Default,,0,0,0,,Бірақ сахнаның артында ол бәрін жаттығуына жұмсады.
Dialogue: 0,0:18:41.07,0:18:42.83,Default,,0,0,0,,Менің айналамдағылардың бәрі өсті
Dialogue: 0,0:18:42.91,0:18:46.33,Default,,0,0,0,,Мен тамсанған батырдың барын ұмытсам да
Dialogue: 0,0:18:46.41,0:18:51.25,Default,,0,0,0,,Мен аз болса да, аздап сезіндім.
Dialogue: 0,0:18:51.33,0:18:53.38,Default,,0,0,0,,Мен жай ғана көздедім
Dialogue: 0,0:18:54.38,0:18:57.34,Default,,0,0,0,,Бір күні келетін сол күн үшін
Dialogue: 0,0:18:58.26,0:19:01.30,Default,,0,0,0,,Бірақ шындықпен бетпе-бет келетін уақыт келді.
Dialogue: 0,0:19:02.22,0:19:04.26,Default,,0,0,0,,Мен Ремнің дәптерін тастасам да, Рем менің есімнен кетпейді
Dialogue: 0,0:19:04.93,0:19:07.77,Default,,0,0,0,,Қанша жекпе-жек үйренсең де,
Dialogue: 0,0:19:07.85,0:19:11.10,Default,,0,0,0,,Сіз хикая сияқты басым күшке ие бола алмайсыз.
Dialogue: 0,0:19:11.60,0:19:14.61,Default,,0,0,0,,Ең көп дегенде, мен бірнеше бұзақыларды ұрып-соғатын едім.
Dialogue: 0,0:19:17.48,0:19:21.36,Default,,0,0,0,,Мысалы, егер сізді толық қаруланған сарбаздар қоршап алса, сіз аяқтадыңыз.
Dialogue: 0,0:19:24.32,0:19:27.33,Default,,0,0,0,,Егер мен әлемдегі ең мықты боксшы атансам.
Dialogue: 0,0:19:27.41,0:19:30.25,Default,,0,0,0,,Сізге қайта хабарласу мүмкіндігім болуы мүмкін.
Dialogue: 0,0:19:32.83,0:19:34.84,Default,,0,0,0,,Бірақ сонда?
Dialogue: 0,0:19:37.05,0:19:39.67,Default,,0,0,0,,Аспаннан ядролық зымыран түссе ше?
Dialogue: 0,0:19:40.34,0:19:44.64,Default,,0,0,0,,Қанша денеңізді жаттықтырсаңыз да, ақыл-ойыңызды жаттықтырсаңыз да, дағдыларыңызды шыңдасаңыз да,
Dialogue: 0,0:19:45.43,0:19:48.77,Default,,0,0,0,,Егер өзек құласа, оның буланудан басқа амалы жоқ.
Dialogue: 0,0:19:49.39,0:19:50.60,Default,,0,0,0,,Бұл адам
Dialogue: 0,0:19:51.35,0:19:52.90,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:19:57.07,0:19:59.23,Default,,0,0,0,,Лимиттерден асып кету керек
Dialogue: 0,0:20:00.07,0:20:04.28,Default,,0,0,0,,Мен таң қалдыратын тіршілік атом энергиясында буланып кетпейді.
Dialogue: 0,0:20:06.41,0:20:08.24,Default,,0,0,0,,Ешқандай ымыраға жол берілмейді
Dialogue: 0,0:20:24.30,0:20:25.84,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:20:28.76,0:20:30.81,Default,,0,0,0,,Қоршау қазірдің өзінде аяқталды.
Dialogue: 0,0:20:31.64,0:20:33.35,Default,,0,0,0,,Олар үшін қашып құтылу мүмкін емес
Dialogue: 0,0:20:33.85,0:20:36.77,Default,,0,0,0,,Бәрі де ұстаздың даналығымен.
Dialogue: 0,0:20:37.27,0:20:41.24,Default,,0,0,0,,Мен бұл қарапайымдылыққа таңданысымды айта аламын.
Dialogue: 0,0:20:41.32,0:20:44.45,Default,,0,0,0,,Мен біраз уақыттан кейін бірінші үлкен аң аулауымды асыға күтемін.
Dialogue: 0,0:20:44.53,0:20:46.28,Default,,0,0,0,,Мейірім жоқ
Dialogue: 0,0:20:47.82,0:20:48.99,Default,,0,0,0,,Иә
Dialogue: 0,0:20:49.49,0:20:52.87,Default,,0,0,0,,Барлығы қожайынының бұйрығын күтуде.
Dialogue: 0,0:20:56.63,0:20:59.00,Default,,0,0,0,,Бір Жокер бар; карталар мінсіз рет-ретімен тұрған сияқты.
Dialogue: 0,0:20:59.09,0:21:01.00,Default,,0,0,0,,Мен қайсы жақсы екенін білмеймін
Dialogue: 0,0:21:01.09,0:21:02.51,Default,,0,0,0,,Жақсы шығар.
Dialogue: 0,0:21:03.09,0:21:06.47,Default,,0,0,0,,Бағалы реинкарнация, асыл басқа дүние
Dialogue: 0,0:21:06.55,0:21:08.47,Default,,0,0,0,,Сосын...
Dialogue: 0,0:21:08.55,0:21:13.06,Default,,0,0,0,,Маған көбірек қуат керек
Dialogue: 0,0:21:16.56,0:21:18.02,Default,,0,0,0,,Сиқырлы күш
Dialogue: 0,0:21:18.11,0:21:20.86,Default,,0,0,0,,Менің қолымда осы жаңа күшпен
Dialogue: 0,0:21:21.94,0:21:24.49,Default,,0,0,0,,Мен көздеген бір ғана шың бар
Dialogue: 0,0:21:25.32,0:21:26.70,Default,,0,0,0,,Кеттік
Dialogue: 0,0:21:38.63,0:21:41.55,Default,,0,0,0,,Мен сонда жетемін
Dialogue: 0,0:21:41.63,0:21:44.09,Default,,0,0,0,,Мен ол үшін бәрінен бас тарта аламын.
Dialogue: 0,0:21:44.59,0:21:46.93,Default,,0,0,0,,Жоқ, оны лақтырып жіберейік.
Dialogue: 0,0:21:47.01,0:21:50.97,Default,,0,0,0,,Егер мен сондай болғым келсе, мен де солай болғым келеді.
Dialogue: 0,0:21:51.05,0:21:52.93,Default,,0,0,0,,Тіпті басты кейіпкер де емес
Dialogue: 0,0:21:53.81,0:21:55.18,Default,,0,0,0,,Тіпті соңғы бастық емес
Dialogue: 0,0:21:56.77,0:22:01.57,Default,,0,0,0,,Сахна артындағы оқиғаға араласып, өз қабілеттерін көрсететін тұлға.
Dialogue: 0,0:22:08.99,0:22:10.87,Default,,0,0,0,,Сахна артындағы қуатты күшке айнал!
Dialogue: 0,0:22:10.95,0:22:15.12,Default,,0,0,0,,♪~
Dialogue: 0,0:23:36.79,0:23:40.87,Default,,0,0,0,,~♪
