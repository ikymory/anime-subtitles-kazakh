Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.79,0:00:07.46,Default,,0,0,0,,Ештеңені босқа істеме
Dialogue: 0,0:00:07.63,0:00:10.46,Default,,0,0,0,,Енді сіз Арчерден айырылдыңыз, Берсеркер осы жерде жеңіледі.
Dialogue: 0,0:00:12.09,0:00:12.72,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,0:00:18.68,0:00:19.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:20.14,0:00:24.69,Default,,0,0,0,,(Орфография)
Dialogue: 0,0:00:30.44,0:00:32.99,Default,,0,0,0,,Жабырқаушы! Мына нәрсені құрт!
Dialogue: 0,0:00:33.57,0:00:38.58,Default,,0,0,0,,♪~
Dialogue: 0,0:01:58.45,0:02:03.45,Default,,0,0,0,,~♪
Dialogue: 0,0:02:05.62,0:02:07.96,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:09.33,0:02:10.83,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,0:02:15.84,0:02:17.38,Default,,0,0,0,,Хмф!
Dialogue: 0,0:02:20.93,0:02:23.43,Default,,0,0,0,,Уф! (Широу) Сабер
Dialogue: 0,0:02:23.60,0:02:25.93,Default,,0,0,0,,Тынышкер, тез істе!
Dialogue: 0,0:02:26.35,0:02:28.10,Default,,0,0,0,,(Риннің ыңырсыуы)
Dialogue: 0,0:02:29.77,0:02:30.60,Default,,0,0,0,,Сабер
Dialogue: 0,0:02:31.06,0:02:32.19,Default,,0,0,0,,Таа!
Dialogue: 0,0:02:43.12,0:02:43.70,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:45.03,0:02:45.87,Default,,0,0,0,,Хе-хе…
Dialogue: 0,0:02:46.04,0:02:48.04,Default,,0,0,0,,(ДжоДжо) Какёин (Анн) Ааах!
Dialogue: 0,0:02:48.58,0:02:50.79,Default,,0,0,0,,Жібер!
Dialogue: 0,0:02:51.04,0:02:51.58,Default,,0,0,0,,Ширу
Dialogue: 0,0:02:52.88,0:02:53.71,Default,,0,0,0,,Уау
Dialogue: 0,0:02:58.67,0:03:00.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:00.51,0:03:02.22,Default,,0,0,0,,Ширу! (жөтел)
Dialogue: 0,0:03:04.97,0:03:07.81,Default,,0,0,0,,Ақымақ! Жетер, кетіңіз, ұстаз.
Dialogue: 0,0:03:08.06,0:03:09.14,Default,,0,0,0,,Босатыңыз
Dialogue: 0,0:03:16.15,0:03:16.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:21.24,0:03:22.28,Default,,0,0,0,,Бір-бірден, кезекпен—
Dialogue: 0,0:03:30.37,0:03:32.71,Default,,0,0,0,,Жоқ, Saber қолданбаңыз
Dialogue: 0,0:03:38.42,0:03:40.59,Default,,0,0,0,,Не... неге?
Dialogue: 0,0:03:41.88,0:03:45.60,Default,,0,0,0,,Бұл жалғыз нұсқа емес пе?
Dialogue: 0,0:03:46.64,0:03:49.39,Default,,0,0,0,,Қылышын босатып жіберді, бітті.
Dialogue: 0,0:03:49.89,0:03:52.52,Default,,0,0,0,,Енді ол қылышты пайдалана алмайсың.
Dialogue: 0,0:03:53.14,0:03:54.56,Default,,0,0,0,,Сондықтан күте тұрыңыз.
Dialogue: 0,0:03:55.52,0:04:00.03,Default,,0,0,0,,Егер сіз қарсыласты шын мәнінде жеңе алмасаңыз, өз қиялыңызда жеңуге болатын нәрсені қиялдаңыз.
Dialogue: 0,0:04:03.49,0:04:04.78,Default,,0,0,0,,Мен жасаймын
Dialogue: 0,0:04:06.66,0:04:10.58,Default,,0,0,0,,Сіз жасай алатын көп нәрсе бар.
Dialogue: 0,0:04:22.30,0:04:25.34,Default,,0,0,0,,Менде сен үшін қолданатын қылыш бар.
Dialogue: 0,0:04:27.14,0:04:28.81,Default,,0,0,0,,Мен оны саған дайындаймын!
Dialogue: 0,0:04:38.23,0:04:39.19,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:42.69,0:04:45.32,Default,,0,0,0,,Бұл қылыш менікі...
Dialogue: 0,0:04:45.57,0:04:47.07,Default,,0,0,0,,(Берсеркердің ырылдауы)
Dialogue: 0,0:04:48.87,0:04:50.16,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:04:51.83,0:04:53.96,Default,,0,0,0,,(кесу дыбысы)
Dialogue: 0,0:04:57.50,0:05:00.55,Default,,0,0,0,,Шыу!
Dialogue: 0,0:05:08.01,0:05:09.39,Default,,0,0,0,,Тағы да
Dialogue: 0,0:05:09.51,0:05:14.27,Default,,0,0,0,,Сынбайтын қылыш сынды, өйткені болжамда тайраңқы болды.
Dialogue: 0,0:05:14.48,0:05:16.35,Default,,0,0,0,,Проекцияның басталуы
Dialogue: 0,0:05:19.86,0:05:22.32,Default,,0,0,0,,
Dialogue: 0,0:05:22.65,0:05:25.03,Default,,0,0,0,,Мен өзімді сынауым керек
Dialogue: 0,0:05:25.70,0:05:28.03,Default,,0,0,0,,Бірыңғай ымыраға немесе ымыраға жол берілмейді.
Dialogue: 0,0:05:29.87,0:05:30.41,Default,,0,0,0,,Ширу!
Dialogue: 0,0:05:33.41,0:05:35.50,Default,,0,0,0,,Негізгі контурды қабылдау
Dialogue: 0,0:05:36.16,0:05:38.75,Default,,0,0,0,,Құрылған материалдарды қайталау
Dialogue: 0,0:05:38.88,0:05:41.38,Default,,0,0,0,,Жиналған жылдарды жаңғырту
Dialogue: 0,0:05:41.50,0:05:44.26,Default,,0,0,0,,Барлық процестерден асып кету
Dialogue: 0,0:05:48.30,0:05:50.72,Default,,0,0,0,,Иллюзияны осы жерге қосып, қылышқа айналдыр
Dialogue: 0,0:05:56.48,0:05:57.77,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:06:00.94,0:06:03.36,Default,,0,0,0,,Уау! Ах...
Dialogue: 0,0:06:03.86,0:06:04.69,Default,,0,0,0,,Ширу
Dialogue: 0,0:06:04.98,0:06:08.20,Default,,0,0,0,,Хмф! Мен Берсеркерге тең келе алмаймын.
Dialogue: 0,0:06:08.49,0:06:10.41,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:10.99,0:06:14.24,Default,,0,0,0,,Олар Берсеркерден асып түсетін қылыш жасаса да.
Dialogue: 0,0:06:14.49,0:06:17.50,Default,,0,0,0,,Мен оны меңгере алмаймын ба?
Dialogue: 0,0:06:28.30,0:06:30.01,Default,,0,0,0,,Ширу қолдары
Dialogue: 0,0:06:43.27,0:06:45.69,Default,,0,0,0,,Уау! (Сабыр) Ах!
Dialogue: 0,0:06:46.65,0:06:48.44,Default,,0,0,0,,Эй!
Dialogue: 0,0:07:38.04,0:07:42.79,Default,,0,0,0,,Бұл сенің қылышың ба, Сабер?
Dialogue: 0,0:07:43.25,0:07:47.30,Default,,0,0,0,,Бұл Калиберн, патшаны таңдайтын жартас қылыш.
Dialogue: 0,0:07:47.42,0:07:49.46,Default,,0,0,0,,Менің қылышым мәңгілікке жоғалды
Dialogue: 0,0:07:50.09,0:07:55.01,Default,,0,0,0,,Шындық – сол адам жасаған елес.
Dialogue: 0,0:07:55.39,0:07:58.10,Default,,0,0,0,,Енді ешқашан болмайтын қылыш
Dialogue: 0,0:07:58.72,0:08:03.56,Default,,0,0,0,,Бірақ бұл иллюзияны бағаламаңыз.
Dialogue: 0,0:08:03.90,0:08:06.40,Default,,0,0,0,,Бір ғана соққы...
Dialogue: 0,0:08:06.52,0:08:10.57,Default,,0,0,0,,Бұл денені жеті рет жою.
Dialogue: 0,0:08:20.83,0:08:22.08,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:08:22.75,0:08:24.79,Default,,0,0,0,,Уф... (Сабер) Ширу
Dialogue: 0,0:08:24.92,0:08:27.04,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:08:29.96,0:08:30.92,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:08:32.01,0:08:35.30,Default,,0,0,0,,Берсеркер өлді ме?
Dialogue: 0,0:08:38.39,0:08:42.10,Default,,0,0,0,,Жоқ, Сабер, Ильяға тиіспе.
Dialogue: 0,0:08:42.35,0:08:45.56,Default,,0,0,0,,Берсеркер кетсе, Илья...
Dialogue: 0,0:09:06.75,0:09:09.21,Default,,0,0,0,,Ояндың, Ширу.
Dialogue: 0,0:09:10.42,0:09:12.84,Default,,0,0,0,,Ой... а
Dialogue: 0,0:09:13.55,0:09:16.13,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:09:16.26,0:09:20.14,Default,,0,0,0,,Не болды? Сабер, сен таңнан бері қышқылдайсың.
Dialogue: 0,0:09:20.39,0:09:24.60,Default,,0,0,0,,Жоқ, мен жай ғана түс көрдім.
Dialogue: 0,0:09:24.73,0:09:25.89,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,0:09:26.60,0:09:30.40,Default,,0,0,0,,Хмм, бұл шулы.
Dialogue: 0,0:09:32.07,0:09:32.90,Default,,0,0,0,,Уф! ?
Dialogue: 0,0:09:39.16,0:09:42.37,Default,,0,0,0,,Бұл ыдыс. (Широу) О, бұл жаман.
Dialogue: 0,0:09:43.37,0:09:44.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:54.92,0:09:56.09,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:09:56.22,0:09:57.84,Default,,0,0,0,,
Dialogue: 0,0:09:59.55,0:10:02.35,Default,,0,0,0,,Кешіріңіз, сүт ішуге рұқсат етіңіз, Ширу.
Dialogue: 0,0:10:02.64,0:10:03.89,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:10:04.02,0:10:06.98,Default,,0,0,0,,Ха... басым ауырып тұр.
Dialogue: 0,0:10:07.27,0:10:10.52,Default,,0,0,0,,Иә? не? Таңнан бері қобалжыдыңыз.
Dialogue: 0,0:10:10.65,0:10:12.82,Default,,0,0,0,,Иә, жапондық стильдегі гамбургер стейк
Dialogue: 0,0:10:14.61,0:10:16.65,Default,,0,0,0,,Барлығы жерде, Рин.
Dialogue: 0,0:10:17.53,0:10:19.49,Default,,0,0,0,,Себебі Берсеркер кетті...
Dialogue: 0,0:10:19.61,0:10:21.12,Default,,0,0,0,,Ол да заттарға толы.
Dialogue: 0,0:10:21.24,0:10:22.83,Default,,0,0,0,,Қалған қызметшілер:
Dialogue: 0,0:10:22.95,0:10:25.83,Default,,0,0,0,,Қазіргі Сабер оны оңай тойтарады.
Dialogue: 0,0:10:26.12,0:10:28.91,Default,,0,0,0,,Шайқаста сенімділік жоқ.
Dialogue: 0,0:10:29.08,0:10:30.92,Default,,0,0,0,,Кішіпейілділік Кішіпейілділік
Dialogue: 0,0:10:31.04,0:10:33.00,Default,,0,0,0,,Артур патшаның қолына түсу...
Dialogue: 0,0:10:33.13,0:10:36.63,Default,,0,0,0,,Сол аз ғана батырлар саусақпен санарлық емес пе?
Dialogue: 0,0:10:36.80,0:10:39.05,Default,,0,0,0,,Тохсака сен-
Dialogue: 0,0:10:39.18,0:10:41.84,Default,,0,0,0,,Сабердің кім екенін түсіндіңіз бе?
Dialogue: 0,0:10:42.39,0:10:45.64,Default,,0,0,0,,Күні кеше ғана көзім жетті.
Dialogue: 0,0:10:48.27,0:10:52.61,Default,,0,0,0,,Осыншама қасиетті қылышты бір ғана батыр пайдаланады.
Dialogue: 0,0:11:00.86,0:11:03.91,Default,,0,0,0,,Ширу, енді не істейсің?
Dialogue: 0,0:11:04.03,0:11:06.74,Default,,0,0,0,,Не? Не істеуім керек?
Dialogue: 0,0:11:06.87,0:11:09.71,Default,,0,0,0,,Жапон үлгісіндегі бөлмеде ұйықтап жатқан шулы бала туралы
Dialogue: 0,0:11:09.87,0:11:13.50,Default,,0,0,0,,Дәлірек айтсақ, бұл жапондық үлгідегі бөлме емес, Ширудың бөлмесі.
Dialogue: 0,0:11:13.63,0:11:15.84,Default,,0,0,0,,Не? Хмм
Dialogue: 0,0:11:15.96,0:11:18.88,Default,,0,0,0,,Жоқ, мен... бұл...
Dialogue: 0,0:11:19.01,0:11:20.67,Default,,0,0,0,,Ширу Менің де айтқым келеді.
Dialogue: 0,0:11:21.38,0:11:24.72,Default,,0,0,0,,Ширу Ильясвиелді қорғау сияқты оғаш істер істеп жатыр.
Dialogue: 0,0:11:25.10,0:11:27.18,Default,,0,0,0,,Мен сені жалғыз қалдыра алмаймын.
Dialogue: 0,0:11:27.31,0:11:28.93,Default,,0,0,0,,Илья әлі бала.
Dialogue: 0,0:11:29.39,0:11:32.56,Default,,0,0,0,,Саған болған оқиғадан кейін неге әлі де солай айтасың?
Dialogue: 0,0:11:32.69,0:11:34.81,Default,,0,0,0,,Маған дұрыс айта алатын адам болса
Dialogue: 0,0:11:34.94,0:11:37.48,Default,,0,0,0,,Ілияс енді олай істемейді.
Dialogue: 0,0:11:37.61,0:11:42.07,Default,,0,0,0,,Ал мен қожайынымды өлтіру үшін ұрыспаймын.
Dialogue: 0,0:11:42.61,0:11:45.70,Default,,0,0,0,,Олар тек шайқасты аяқтау үшін күресеміз дейді.
Dialogue: 0,0:11:46.03,0:11:48.70,Default,,0,0,0,,Сонымен Ильясвиел не істеді?
Dialogue: 0,0:11:48.83,0:11:50.58,Default,,0,0,0,,Сіз бәрін кешіресіз бе?
Dialogue: 0,0:11:50.70,0:11:51.29,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:54.83,0:11:57.25,Default,,0,0,0,,Менің Арчерді кешіретін ойым жоқ.
Dialogue: 0,0:11:57.38,0:11:59.13,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:59.46,0:12:00.51,Default,,0,0,0,,Не?
Dialogue: 0,0:12:00.63,0:12:04.14,Default,,0,0,0,,Қызметшілердің бәрі ақырында жоғалып кетпейді.
Dialogue: 0,0:12:04.68,0:12:08.51,Default,,0,0,0,,Егер сіз бұл туралы уайымдасаңыз, сіз өзіңізді шеберліктен шеттетесіз, Рин.
Dialogue: 0,0:12:08.64,0:12:09.47,Default,,0,0,0,,'Жоқ—ол қайта қосылып жатыр ма? Бөлініп кеткен бөліктері…'
Dialogue: 0,0:12:13.85,0:12:16.81,Default,,0,0,0,,Рахмет, Сабер шебері.
Dialogue: 0,0:12:17.02,0:12:20.99,Default,,0,0,0,,Дұшпаныма алаңдағаныңыз үшін шын жүректен рахмет.
Dialogue: 0,0:12:21.11,0:12:23.45,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:12:27.20,0:12:28.41,Default,,0,0,0,,Мен аштан өліп бара жатырмын! Жұт, тез!
Dialogue: 0,0:12:28.66,0:12:32.04,Default,,0,0,0,,А, жақсы иіс шығады. Бұл мен үшін бе?
Dialogue: 0,0:12:32.16,0:12:33.41,Default,,0,0,0,,Мен бақыттымын!
Dialogue: 0,0:12:33.79,0:12:36.13,Default,,0,0,0,,Менен аулақ жүр, арсыз адам.
Dialogue: 0,0:12:36.29,0:12:38.96,Default,,0,0,0,,Тамақтану кезінде
Dialogue: 0,0:12:39.09,0:12:41.05,Default,,0,0,0,,Бұл өте дөрекі.
Dialogue: 0,0:12:41.17,0:12:41.71,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:41.84,0:12:44.97,Default,,0,0,0,,Ширу: Ильясвиелді жасыру және т.б.
Dialogue: 0,0:12:45.22,0:12:47.47,Default,,0,0,0,,Зиян да, пайда да жоқ.
Dialogue: 0,0:12:47.60,0:12:49.68,Default,,0,0,0,,Бұл қауіпті емес.
Dialogue: 0,0:12:49.85,0:12:52.48,Default,,0,0,0,,Илья енді шебер емес.
Dialogue: 0,0:12:52.81,0:12:54.31,Default,,0,0,0,,Жарайсың ба? Ширу
Dialogue: 0,0:12:54.48,0:12:56.81,Default,,0,0,0,,Ол әлі де шебер.
Dialogue: 0,0:12:57.31,0:12:58.77,Default,,0,0,0,,Мен қызметшімнен айырылсам да...
Dialogue: 0,0:12:58.90,0:13:01.82,Default,,0,0,0,,Мен саған айтпадым ба, егер сенде бұйрық бар болса, сен шеберсің?
Dialogue: 0,0:13:02.78,0:13:04.15,Default,,0,0,0,,Қызметшілерге де солай.
Dialogue: 0,0:13:04.86,0:13:08.32,Default,,0,0,0,,Қожайыннан айырылсаң да, ол жоғалғанша сенің рақымың бар.
Dialogue: 0,0:13:08.45,0:13:11.24,Default,,0,0,0,,Осындай адасқан қызметшімен келісім жасаса...
Dialogue: 0,0:13:13.12,0:13:17.50,Default,,0,0,0,,Мен басқа қызметшілермен қосылмаймын.
Dialogue: 0,0:13:21.46,0:13:26.38,Default,,0,0,0,,Ильяның қызметшісі әрқашан Берсеркер болды.
Dialogue: 0,0:13:39.15,0:13:43.53,Default,,0,0,0,,Ах, бірақ Ширу жеңілсе, мен Саберді аламын.
Dialogue: 0,0:13:43.86,0:13:48.03,Default,,0,0,0,,Саған қызметші болайын деген ойым жоқ.
Dialogue: 0,0:13:48.86,0:13:50.07,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:50.20,0:13:52.87,Default,,0,0,0,,Иә, мен бұған қарсы емеспін.
Dialogue: 0,0:13:52.99,0:13:56.08,Default,,0,0,0,,Мен жеңсем де, Сабер Шируды қорғайды.
Dialogue: 0,0:13:56.21,0:13:57.62,Default,,0,0,0,,Соңы бірдей
Dialogue: 0,0:13:57.75,0:13:58.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:01.71,0:14:02.84,Default,,0,0,0,,Мен емес
Dialogue: 0,0:14:03.09,0:14:05.05,Default,,0,0,0,,Рин Сізден Шируға дейін
Dialogue: 0,0:14:05.17,0:14:09.18,Default,,0,0,0,,Кешіріңіз, мен сізді естімедім. Қайта айт, Сабер.
Dialogue: 0,0:14:09.30,0:14:11.97,Default,,0,0,0,,Сондықтан Ильясвиелді осында жасыру...
Dialogue: 0,0:14:12.10,0:14:13.35,Default,,0,0,0,,Мен керісінше айтып отырмын.
Dialogue: 0,0:14:13.47,0:14:14.85,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:14:15.06,0:14:15.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:16.18,0:14:17.60,Default,,0,0,0,,Тохсака Сіз жай ғана...
Dialogue: 0,0:14:17.73,0:14:20.31,Default,,0,0,0,,Мен мұны істегеніме қуаныштымын
Dialogue: 0,0:14:20.52,0:14:22.48,Default,,0,0,0,,Мұндай өзімшілдікке жол берілмейді.
Dialogue: 0,0:14:22.61,0:14:26.07,Default,,0,0,0,,Ілияс, жүр, таңғы ас іш.
Dialogue: 0,0:14:26.49,0:14:31.07,Default,,0,0,0,,Ширудың таңдауы керемет ақылды қадам болуы мүмкін.
Dialogue: 0,0:14:31.20,0:14:34.08,Default,,0,0,0,,(бамбук қылыштарының бір-біріне тиген дыбысы)
Dialogue: 0,0:14:35.74,0:14:37.79,Default,,0,0,0,,Ха! (Широу) Ух...
Dialogue: 0,0:14:40.42,0:14:41.25,Default,,0,0,0,,Иә! (Широу) Уф!
Dialogue: 0,0:14:45.17,0:14:47.63,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:47.76,0:14:49.93,Default,,0,0,0,,Вертолёт қонды.
Dialogue: 0,0:14:50.05,0:14:53.30,Default,,0,0,0,,Хмм, бұл шынымен жаттығу ма?
Dialogue: 0,0:14:53.51,0:14:54.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:55.35,0:15:00.23,Default,,0,0,0,,Сабер: Сен ұялып тұрсың ба? Әлде сіз оны әдейі елемейсіз бе?
Dialogue: 0,0:15:00.35,0:15:02.35,Default,,0,0,0,,Ол байсалды көрінбеді.
Dialogue: 0,0:15:02.48,0:15:04.23,Default,,0,0,0,,Жағдайлар?
Dialogue: 0,0:15:04.36,0:15:09.40,Default,,0,0,0,,Бірақ менен сұрасаңыз, ол әдеттегіден гөрі пассивті болған сияқты.
Dialogue: 0,0:15:09.78,0:15:13.95,Default,,0,0,0,,Біз бір-бірімізге байыптырақ қарауымыз керек...
Dialogue: 0,0:15:14.07,0:15:15.58,Default,,0,0,0,,Бұл пайдалы емес.
Dialogue: 0,0:15:15.87,0:15:18.08,Default,,0,0,0,,Ал... алдыңғы жақтан?
Dialogue: 0,0:15:18.29,0:15:21.71,Default,,0,0,0,,Алайда дамуына байланысты...
Dialogue: 0,0:15:22.83,0:15:25.09,Default,,0,0,0,,Біздің денелеріміз соқтығысады...
Dialogue: 0,0:15:25.25,0:15:28.30,Default,,0,0,0,,Әрине, олар кездесу өткізіп жатыр.
Dialogue: 0,0:15:28.67,0:15:29.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:32.55,0:15:34.01,Default,,0,0,0,,Түс болды
Dialogue: 0,0:15:37.64,0:15:39.81,Default,,0,0,0,,Уфуфу... Иә, бұл дәмді.
Dialogue: 0,0:15:40.43,0:15:42.85,Default,,0,0,0,,Ширу жақсы аспазшы, солай емес пе?
Dialogue: 0,0:15:46.23,0:15:48.19,Default,,0,0,0,,Күте тұрыңыз, не?
Dialogue: 0,0:15:48.32,0:15:49.61,Default,,0,0,0,,Сабер?
Dialogue: 0,0:15:53.99,0:15:56.58,Default,,0,0,0,,А... не айтып тұрсың?
Dialogue: 0,0:15:56.87,0:15:59.62,Default,,0,0,0,,Сабер мені жек көреді, солай ма?
Dialogue: 0,0:16:00.00,0:16:04.88,Default,,0,0,0,,Саған ешқандай дұшпандық болған жоқ, Ширу сені қонақ ретінде қарсы алды.
Dialogue: 0,0:16:05.00,0:16:09.38,Default,,0,0,0,,Сондықтан мен әдептілікті де көрсетуім керек.
Dialogue: 0,0:16:11.01,0:16:12.01,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:21.14,0:16:23.56,Default,,0,0,0,,Ха, мен терлеп тұрмын.
Dialogue: 0,0:16:26.81,0:16:29.11,Default,,0,0,0,,Ах! Кешіріңіз, бұл жаман болды
Dialogue: 0,0:16:29.23,0:16:31.57,Default,,0,0,0,,Мен ол жерде жоқ деп ойлаймын.
Dialogue: 0,0:16:31.78,0:16:33.49,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:33.61,0:16:37.53,Default,,0,0,0,,Мм... Әзірше сұраудан аулақ болғаныңызды қалаймын.
Dialogue: 0,0:16:38.16,0:16:40.95,Default,,0,0,0,,Ширудың денесін жууы табиғи нәрсе.
Dialogue: 0,0:16:41.41,0:16:44.16,Default,,0,0,0,,Шебердің әрекетін онша шектемейді.
Dialogue: 0,0:16:44.29,0:16:45.54,Default,,0,0,0,,қуыршақтай киімінен мүлде алшақ еді—
Dialogue: 0,0:16:45.87,0:16:51.84,Default,,0,0,0,,Менің денем Риндікіндей қыз емес.
Dialogue: 0,0:16:52.34,0:16:53.92,Default,,0,0,0,,Сабер
Dialogue: 0,0:16:54.05,0:16:56.80,Default,,0,0,0,,Мен Ширудың соншалықты көп көргенін қаламаймын.
Dialogue: 0,0:16:56.93,0:17:01.02,Default,,0,0,0,,Бұлшық ет денелі болса, бөкселер үшін жағымсыз болар еді.
Dialogue: 0,0:17:01.14,0:17:02.68,Default,,0,0,0,,Идиот! Сол сияқты...
Dialogue: 0,0:17:03.39,0:17:04.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:06.98,0:17:09.81,Default,,0,0,0,,Солай... Сонымен...
Dialogue: 0,0:17:09.94,0:17:11.90,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:17:15.03,0:17:17.24,Default,,0,0,0,,Еш нәрсе бұзылмайды.
Dialogue: 0,0:17:17.53,0:17:22.29,Default,,0,0,0,,Мен проекциялық сиқырды пайдаланғаныңызға сене алмаймын.
Dialogue: 0,0:17:22.41,0:17:23.41,Default,,0,0,0,,Проекция?
Dialogue: 0,0:17:23.75,0:17:28.21,Default,,0,0,0,,Иә, нағыз өнер туындылары, атақты қылыштар, т.б.
Dialogue: 0,0:17:28.33,0:17:31.25,Default,,0,0,0,,Оны өзіңіздің сиқырлы күшіңізбен бейне ретінде қайта жасаңыз
Dialogue: 0,0:17:31.55,0:17:34.67,Default,,0,0,0,,Бірақ адам бейнесі тесіктерге толы емес пе?
Dialogue: 0,0:17:35.38,0:17:39.60,Default,,0,0,0,,Сіз оны нақты нәрсе сияқты қайталай алмайсыз. Бұл жартылай күйдірілген сиқыр.
Dialogue: 0,0:17:41.68,0:17:43.85,Default,,0,0,0,,Әрине, тез жоғалып кетті.
Dialogue: 0,0:17:43.97,0:17:47.52,Default,,0,0,0,,Сондай-ақ, проекция сиқырлы қуатты көп тұтынады.
Dialogue: 0,0:17:47.64,0:17:49.10,Default,,0,0,0,,Сабыр семсерінің сиқырлы күші...
Dialogue: 0,0:17:49.23,0:17:51.61,Default,,0,0,0,,Бұл Ширудың мүмкіндігінен тыс.
Dialogue: 0,0:17:51.73,0:17:54.40,Default,,0,0,0,,Бұған еліктеу өз-өзіне қол жұмсау болар еді.
Dialogue: 0,0:17:54.69,0:17:55.94,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:56.07,0:17:59.07,Default,,0,0,0,,Сіз Excalibur не екенін білесіз бе?
Dialogue: 0,0:17:59.20,0:18:00.99,Default,,0,0,0,,Excalibur туралы айтатын болсақ...
Dialogue: 0,0:18:01.12,0:18:03.29,Default,,0,0,0,,Артур патшаның синонимі.
Dialogue: 0,0:18:03.41,0:18:07.92,Default,,0,0,0,,Кеспейтін ешнәрсе жоқ, Төгілмейтін атақты қылыш.
Dialogue: 0,0:18:08.58,0:18:12.46,Default,,0,0,0,,Әйтеуір... Мен солай деп ойладым.
Dialogue: 0,0:18:12.59,0:18:17.42,Default,,0,0,0,,Жарайсың ба? Ең бастысы - қылыш емес, қын.
Dialogue: 0,0:18:17.55,0:18:18.43,Default,,0,0,0,,Қабық?
Dialogue: 0,0:18:18.68,0:18:24.14,Default,,0,0,0,,Иә, қынасын таққанша, Артур патша ешқашан қан кетпейді.
Dialogue: 0,0:18:24.26,0:18:26.27,Default,,0,0,0,,Бұл сіздің өлмейтін екеніңізді білдіреді.
Dialogue: 0,0:18:26.56,0:18:30.02,Default,,0,0,0,,Иә, онда Артур патша неге өлді?
Dialogue: 0,0:18:30.23,0:18:32.48,Default,,0,0,0,,Иә.
Dialogue: 0,0:18:32.61,0:18:36.03,Default,,0,0,0,,Аңыз бойынша Экскалибурдың қабығы ұрланған.
Dialogue: 0,0:18:36.15,0:18:38.99,Default,,0,0,0,,Не, сен? Неліктен бұл туралы ойладыңыз?
Dialogue: 0,0:18:39.11,0:18:40.20,Default,,0,0,0,,Сендер тым шулысыңдар.
Dialogue: 0,0:18:40.70,0:18:43.41,Default,,0,0,0,,Егер солай болса, мен өзімді жеңілмейтінмін деп есептемеймін.
Dialogue: 0,0:18:43.53,0:18:46.20,Default,,0,0,0,,Мен де кейде қателесемін.
Dialogue: 0,0:18:46.33,0:18:47.20,Default,,0,0,0,,Кейде?
Dialogue: 0,0:18:48.66,0:18:50.33,Default,,0,0,0,,О... жоқ.
Dialogue: 0,0:18:54.42,0:18:57.09,Default,,0,0,0,,Тохсака маған оны қолданбауымды айтты, бірақ...
Dialogue: 0,0:19:01.39,0:19:03.30,Default,,0,0,0,,Проекцияның басталуы
Dialogue: 0,0:19:09.77,0:19:10.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:11.85,0:19:13.73,Default,,0,0,0,,Сіз осында болдыңыз ба?
Dialogue: 0,0:19:14.69,0:19:19.65,Default,,0,0,0,,А, мен ұйықтай алмадым, сондықтан мен ақыл-ой жаттығуларын жасадым.
Dialogue: 0,0:19:19.78,0:19:21.99,Default,,0,0,0,,Бір күнді жібермей орындаңыз ба?
Dialogue: 0,0:19:22.11,0:19:24.16,Default,,0,0,0,,Мүмкіндігінше
Dialogue: 0,0:19:24.62,0:19:26.74,Default,,0,0,0,,Бұл әкемнің маған айтқан күнделікті жұмысы.
Dialogue: 0,0:19:30.58,0:19:35.13,Default,,0,0,0,,Айтпақшы, сіз бүгін таңертең түс көрдіңіз дедіңіз.
Dialogue: 0,0:19:35.75,0:19:38.30,Default,,0,0,0,,Қызметшілер армандамайды
Dialogue: 0,0:19:39.72,0:19:43.05,Default,,0,0,0,,Менің көргенім сенің арманың еді
Dialogue: 0,0:19:43.18,0:19:44.93,Default,,0,0,0,,Сіздің өткеніңіз
Dialogue: 0,0:19:45.10,0:19:49.56,Default,,0,0,0,,Қожайын мен қызметші рухани байланыста.
Dialogue: 0,0:19:49.89,0:19:52.06,Default,,0,0,0,,Байланыстар күшейсе...
Dialogue: 0,0:19:52.19,0:19:55.15,Default,,0,0,0,,Кейде біз басқа адамның өткеніне көз жүгіртеміз.
Dialogue: 0,0:19:55.77,0:19:57.27,Default,,0,0,0,,Мені кешіріңіз
Dialogue: 0,0:19:58.94,0:20:01.40,Default,,0,0,0,,Бұл Сабер кінәлі...
Dialogue: 0,0:20:02.53,0:20:05.53,Default,,0,0,0,,Одан да сол арман...
Dialogue: 0,0:20:06.03,0:20:07.70,Default,,0,0,0,,Үлкен өрт болды.
Dialogue: 0,0:20:08.95,0:20:12.87,Default,,0,0,0,,Ширу маған ұқсайды, сондықтан мен сенің қатеңді көремін.
Dialogue: 0,0:20:13.29,0:20:16.67,Default,,0,0,0,,Осылай жүре берсек не болады?
Dialogue: 0,0:20:17.38,0:20:19.34,Default,,0,0,0,,Мен түсіндім, өйткені олар бірдей
Dialogue: 0,0:20:19.76,0:20:22.22,Default,,0,0,0,,Сіз ештеңе жасай алмайсыз.
Dialogue: 0,0:20:22.34,0:20:24.59,Default,,0,0,0,,Мен әкемдей әділдік жағындамын...
Dialogue: 0,0:20:24.72,0:20:27.68,Default,,0,0,0,,Сондықтан бұл дұрыс емес.
Dialogue: 0,0:20:27.80,0:20:28.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:28.68,0:20:31.06,Default,,0,0,0,,Рин мұны бұрын айтқан.
Dialogue: 0,0:20:31.18,0:20:33.56,Default,,0,0,0,,Ширудың өзіне берілгендігі қалыпты емес.
Dialogue: 0,0:20:35.15,0:20:38.65,Default,,0,0,0,,Сіздің өміріңіз басынан бастап...
Dialogue: 0,0:20:38.77,0:20:41.03,Default,,0,0,0,,Есепке кіргізілген жоқ па?
Dialogue: 0,0:20:45.53,0:20:48.53,Default,,0,0,0,,Мен Қасиетті Граалды алуым керек
Dialogue: 0,0:20:48.66,0:20:53.29,Default,,0,0,0,,Бірақ Шируға да Қасиетті Граил қажет.
Dialogue: 0,0:20:53.83,0:20:58.00,Default,,0,0,0,,Ұстаз, сізді шақыруыңыз сөзсіз болды.
Dialogue: 0,0:21:03.55,0:21:06.26,Default,,0,0,0,,Бұл біздің шайқастың ортасында екенімізді білдіре ме?
Dialogue: 0,0:21:07.18,0:21:09.76,Default,,0,0,0,,Жоқ, Берсеркер жоғалып кеткенше...
Dialogue: 0,0:21:09.89,0:21:12.56,Default,,0,0,0,,Бізде қорқатын ештеңе жоқ
Dialogue: 0,0:21:12.98,0:21:15.77,Default,,0,0,0,,Жалғыз жаулары Лансер мен Сабер қалды.
Dialogue: 0,0:21:16.40,0:21:19.52,Default,,0,0,0,,Сиқырлы қуатты сақтау жақын арада критикалық массаға жетеді.
Dialogue: 0,0:21:19.94,0:21:23.19,Default,,0,0,0,,Алушы ретінде қызмет ететін бір сиқыршыны табу ғана қалды...
Dialogue: 0,0:21:23.32,0:21:26.28,Default,,0,0,0,,Сіз Қасиетті Граалды күшпен шақыра аласыз.
Dialogue: 0,0:21:26.45,0:21:28.16,Default,,0,0,0,,Сиқыршы?
Dialogue: 0,0:21:28.28,0:21:30.28,Default,,0,0,0,,Оның маған пайдасы жоқ.
Dialogue: 0,0:21:30.53,0:21:32.29,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:21:32.45,0:21:36.75,Default,,0,0,0,,Құрбандық сиқыршы сияқты басқа шеберлерді пайдаланудан құтылуға болады.
Dialogue: 0,0:21:36.87,0:21:39.88,Default,,0,0,0,,Дегенмен, бұл дене Қасиетті Граилдың ыдысы болады.
Dialogue: 0,0:21:40.00,0:21:44.67,Default,,0,0,0,,Мүмкіндігі зор сиқыршы ғана жұмыс істей алады.
Dialogue: 0,0:21:45.67,0:21:49.01,Default,,0,0,0,,Қабілеті жағынан бұл жас ханым ең жақсы.
Dialogue: 0,0:21:49.14,0:21:51.68,Default,,0,0,0,,Бәлкім, мен тым ерке болып кеткен шығармын.
Dialogue: 0,0:21:53.10,0:21:56.69,Default,,0,0,0,,Сізге тек сиқыршы текті болса болғаны.
Dialogue: 0,0:21:56.81,0:22:02.07,Default,,0,0,0,,Сіз негізгі дене ретінде жақсы болсаңыз, сиқырды қолдана аласыз ба, жоқ па маңызды емес.
Dialogue: 0,0:22:02.86,0:22:05.32,Default,,0,0,0,,Сізге көмектесетін сияқты, хехе...
Dialogue: 0,0:22:06.86,0:22:08.45,Default,,0,0,0,,Бұл тек болжам ғана, айтпақшы.
Dialogue: 0,0:22:10.57,0:22:15.58,Default,,0,0,0,,♪~
Dialogue: 0,0:23:35.45,0:23:40.46,Default,,0,0,0,,~♪
