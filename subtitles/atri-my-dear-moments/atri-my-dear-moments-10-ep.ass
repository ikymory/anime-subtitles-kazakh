Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.45,0:00:05.33,Default,,0,0,0,,(Нацуоның қатты тыныс алуы)
Dialogue: 0,0:00:12.42,0:00:13.68,Default,,0,0,0,,Нацуо-сан…
Dialogue: 0,0:00:24.64,0:00:25.90,Default,,0,0,0,,Аториге
Dialogue: 0,0:00:26.60,0:00:27.61,Default,,0,0,0,,Қол тигізбеңіз
Dialogue: 0,0:00:30.61,0:00:31.99,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:00:39.74,0:00:42.95,Default,,0,0,0,,Сіз гуманоидтар жағындамын дейсіз бе?
Dialogue: 0,0:00:43.58,0:00:45.42,Default,,0,0,0,,Атридің жүрегі бар
Dialogue: 0,0:00:45.92,0:00:48.46,Default,,0,0,0,,Оның да адамдар сияқты ақыл-ойы бар!
Dialogue: 0,0:00:54.42,0:00:55.38,Default,,0,0,0,,Атори!
Dialogue: 0,0:00:58.60,0:00:59.93,Default,,0,0,0,,Нацуо-сан…
Dialogue: 0,0:01:00.43,0:01:02.60,Default,,0,0,0,,Хаа... мүлдем
Dialogue: 0,0:01:03.64,0:01:06.77,Default,,0,0,0,,Қандай қорқынышты гуманоид.
Dialogue: 0,0:01:07.27,0:01:09.90,Default,,0,0,0,,Қалайша халықты сонша алдауға болады?
Dialogue: 0,0:01:10.40,0:01:12.86,Default,,0,0,0,,(Эндевор) Менің ұлым, Шото, Бүкіл Құдірет-ты басып озуға міндетті.
Dialogue: 0,0:01:13.78,0:01:14.36,Default,,0,0,0,,Нацу!
Dialogue: 0,0:01:14.44,0:01:16.11,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:17.20,0:01:18.87,Default,,0,0,0,,Доктор Кониши де...
Dialogue: 0,0:01:20.45,0:01:21.79,Default,,0,0,0,,Ол күнәкар адам.
Dialogue: 0,0:01:21.87,0:01:25.83,Default,,0,0,0,,(Эндевор) Менің ұлым, Шото, Бүкіл Құдірет-ты басып озуға міндетті.
Dialogue: 0,0:01:26.33,0:01:29.33,Default,,0,0,0,,Бұл шынымен де шайтанның ойлап тапқаны.
Dialogue: 0,0:01:29.42,0:01:32.71,Default,,0,0,0,,(Тодорокидің анасы) Бірақ сен әлі де батыр болғың келеді ғой, иә?
Dialogue: 0,0:01:35.17,0:01:36.63,Default,,0,0,0,,♪ Вуф-вуф, вуф-вуф
Dialogue: 0,0:01:36.72,0:01:39.26,Default,,0,0,0,,Егер бұл жігіт апатқа себепкер болмаса
Dialogue: 0,0:01:39.34,0:01:41.43,Default,,0,0,0,,Қашып кетпейінше
Dialogue: 0,0:01:41.93,0:01:44.85,Default,,0,0,0,,Дәрігер де, компания да қорғалды.
Dialogue: 0,0:01:45.35,0:01:49.65,Default,,0,0,0,,Ал мына жігіт... Бұл ақаулы өнім...
Dialogue: 0,0:01:51.19,0:01:51.90,Default,,0,0,0,,Жоқ
Dialogue: 0,0:01:54.19,0:01:56.61,Default,,0,0,0,,Atori – ақаулы өнім...
Dialogue: 0,0:01:57.61,0:02:00.91,Default,,0,0,0,,Бұл ақаулы өнім емес...
Dialogue: 0,0:02:02.28,0:02:03.54,Default,,0,0,0,,Мұны істеу қиын
Dialogue: 0,0:02:03.62,0:02:04.99,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:02:06.70,0:02:10.25,Default,,0,0,0,,Нацуо-сан... бәрібір!
Dialogue: 0,0:02:10.33,0:02:11.29,Default,,0,0,0,,Иә
Dialogue: 0,0:02:11.92,0:02:15.17,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:02:17.01,0:02:18.05,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:02:19.51,0:02:21.51,Default,,0,0,0,,♪～
Dialogue: 0,0:03:43.80,0:03:45.80,Default,,0,0,0,,～♪
Dialogue: 0,0:03:50.02,0:03:53.35,Default,,0,0,0,,Сіз не істейсіз?
Dialogue: 0,0:03:54.69,0:03:55.61,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:04:04.82,0:04:05.78,Default,,0,0,0,,Фу…
Dialogue: 0,0:04:06.53,0:04:09.70,Default,,0,0,0,,Жарайды. Қайсысын оқығың келеді?
Dialogue: 0,0:04:10.20,0:04:13.12,Default,,0,0,0,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:04:13.83,0:04:17.67,Default,,0,0,0,,Бәріңіз көрдіңіз бе? қазіргі зорлық-зомбылық
Dialogue: 0,0:04:18.17,0:04:21.67,Default,,0,0,0,,Бұл жігіт гуманоид болса да мені ұрды.
Dialogue: 0,0:04:22.17,0:04:25.43,Default,,0,0,0,,Бұл жігіт адам жасаған құрал ғана.
Dialogue: 0,0:04:25.51,0:04:27.64,Default,,0,0,0,,Мен біреуді ұрдым!
Dialogue: 0,0:04:27.72,0:04:30.89,Default,,0,0,0,,Ахахха! Күткендей
Dialogue: 0,0:04:30.97,0:04:33.48,Default,,0,0,0,,Мен мұны күттім.
Dialogue: 0,0:04:33.56,0:04:36.23,Default,,0,0,0,,Робот адамға зиян келтіреді
Dialogue: 0,0:04:36.81,0:04:40.86,Default,,0,0,0,,Бұл дәлел, солай ма? Бұл ақаулы өнім
Dialogue: 0,0:04:41.48,0:04:44.70,Default,,0,0,0,,Оны бақылаусыз қалдыру мүмкін емес.
Dialogue: 0,0:04:47.57,0:04:49.87,Default,,0,0,0,,Уф... Ааа!
Dialogue: 0,0:04:49.95,0:04:50.54,Default,,0,0,0,,Уф!
Dialogue: 0,0:04:51.37,0:04:52.20,Default,,0,0,0,,Гррр…
Dialogue: 0,0:04:52.29,0:04:53.58,Default,,0,0,0,,Гухо... Гуаа!
Dialogue: 0,0:04:54.33,0:04:55.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:57.92,0:04:59.34,Default,,0,0,0,,Я... Ясуда-сан!
Dialogue: 0,0:05:00.50,0:05:02.51,Default,,0,0,0,,Сәлем! Келме!
Dialogue: 0,0:05:09.80,0:05:14.89,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:05:16.60,0:05:17.77,Default,,0,0,0,,Атори
Dialogue: 0,0:05:21.23,0:05:22.94,Default,,0,0,0,,Нацуо-сан
Dialogue: 0,0:05:25.78,0:05:29.28,Default,,0,0,0,,Мені құртуыңызды өтінемін
Dialogue: 0,0:05:30.95,0:05:31.78,Default,,0,0,0,,Атри…
Dialogue: 0,0:05:31.87,0:05:33.91,Default,,0,0,0,,Мен ақаулымын
Dialogue: 0,0:05:34.00,0:05:37.42,Default,,0,0,0,,Адамдарды ұру және жарақаттау —
Dialogue: 0,0:05:37.92,0:05:39.92,Default,,0,0,0,,Ақаулы гуманоид
Dialogue: 0,0:05:45.21,0:05:46.92,Default,,0,0,0,,Жоюыңызды өтінемін
Dialogue: 0,0:05:55.39,0:05:57.35,Default,,0,0,0,,Кешіріңіз Атри
Dialogue: 0,0:05:59.65,0:06:02.07,Default,,0,0,0,,Мен саған қорқынышты нәрсе айттым.
Dialogue: 0,0:06:03.27,0:06:07.11,Default,,0,0,0,,Мен кешірім сұрауым керек болғандықтан осы жолмен жүгірдім.
Dialogue: 0,0:06:10.41,0:06:11.78,Default,,0,0,0,,Біз оның жайлы өте аз білеміз… Бұл не, мырза Ринатаки?
Dialogue: 0,0:06:12.78,0:06:15.70,Default,,0,0,0,,Менің ойымша, бұл шынымен сорды.
Dialogue: 0,0:06:18.16,0:06:21.83,Default,,0,0,0,,Кешіріңіз, ақаулы өнім менікі.
Dialogue: 0,0:06:22.34,0:06:24.17,Default,,0,0,0,,Айттым ғой! Апаттар – нағыз азап.
Dialogue: 0,0:06:24.67,0:06:27.17,Default,,0,0,0,,Нацуодан кешірім сұраудың қажеті жоқ...
Dialogue: 0,0:06:31.22,0:06:32.18,Default,,0,0,0,,Атори
Dialogue: 0,0:06:32.68,0:06:33.68,Default,,0,0,0,,Иә
Dialogue: 0,0:06:34.76,0:06:37.48,Default,,0,0,0,,Сізде жүрек бар
Dialogue: 0,0:06:38.02,0:06:38.94,Default,,0,0,0,,Қате
Dialogue: 0,0:06:39.56,0:06:41.19,Default,,0,0,0,,Ақыл емес
Dialogue: 0,0:06:42.19,0:06:45.53,Default,,0,0,0,,Менде жүрек жоқ...
Dialogue: 0,0:06:46.03,0:06:47.19,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:48.24,0:06:50.78,Default,,0,0,0,,Оның бар-жоғын білмейсің.
Dialogue: 0,0:06:51.32,0:06:54.12,Default,,0,0,0,,Сенің жүрегіңнің қайда екенін ешкім білмейді.
Dialogue: 0,0:06:55.33,0:07:00.33,Default,,0,0,0,,Менің жүрегім қайда? Ол шынымен бар ма?
Dialogue: 0,0:07:00.42,0:07:01.96,Default,,0,0,0,,Ешқандай сенімділік болуы мүмкін емес
Dialogue: 0,0:07:03.25,0:07:04.46,Default,,0,0,0,,Барлығы бірдей
Dialogue: 0,0:07:09.30,0:07:10.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:13.55,0:07:16.10,Default,,0,0,0,,Қазір не сезінесіз?
Dialogue: 0,0:07:17.56,0:07:18.85,Default,,0,0,0,,Мен оны Солтүстік-Шығыс әскери театрдан алдым.
Dialogue: 0,0:07:18.93,0:07:20.64,Default,,0,0,0,,Ұстаудың қажеті жоқ
Dialogue: 0,0:07:21.44,0:07:23.10,Default,,0,0,0,,Оны ұстап тұрудың қажеті жоқ
Dialogue: 0,0:07:24.11,0:07:25.86,Default,,0,0,0,,Оны сол күйінде сезініңіз
Dialogue: 0,0:07:29.36,0:07:30.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:30.65,0:07:31.90,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:07:37.70,0:07:38.62,Default,,0,0,0,,Барлығы
Dialogue: 0,0:07:39.20,0:07:39.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:52.09,0:07:53.30,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:07:55.05,0:07:58.47,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:08:04.56,0:08:07.57,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:08:07.65,0:08:12.49,Default,,0,0,0,,(Атридың айқайы)
Dialogue: 0,0:08:14.41,0:08:15.45,Default,,0,0,0,,Жылау...
Dialogue: 0,0:08:15.95,0:08:22.96,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:08:38.14,0:08:39.56,Default,,0,0,0,,Шина…
Dialogue: 0,0:08:39.64,0:08:43.35,Default,,0,0,0,,Бұл сіздің бірінші шеберіңіз бе?
Dialogue: 0,0:08:43.85,0:08:45.44,Default,,0,0,0,,- (Нацуо) Ах - (2 адам) Ах...
Dialogue: 0,0:08:45.52,0:08:47.52,Default,,0,0,0,,Бұл менің анам.
Dialogue: 0,0:08:48.11,0:08:49.57,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:49.65,0:08:52.82,Default,,0,0,0,,Сонымен сіз әжеңіздің үйінде ұйықтап жатқансыз.
Dialogue: 0,0:08:56.16,0:08:58.03,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:08:58.53,0:09:01.08,Default,,0,0,0,,Әй, көз жасының ізі.
Dialogue: 0,0:09:01.16,0:09:02.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:02.87,0:09:06.96,Default,,0,0,0,,Атри тіпті байқамай жылап жатты.
Dialogue: 0,0:09:07.04,0:09:09.92,Default,,0,0,0,,Бірақ Атри-чан жылай алмайды...
Dialogue: 0,0:09:10.00,0:09:11.75,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:09:12.26,0:09:14.22,Default,,0,0,0,,«Мен жылай алмаймын, өйткені мен гуманоидпын».
Dialogue: 0,0:09:14.72,0:09:15.93,Default,,0,0,0,,«Көз жасы жоқ»
Dialogue: 0,0:09:16.43,0:09:19.60,Default,,0,0,0,,«Жүрек жоқ, шынайы сезім жоқ»
Dialogue: 0,0:09:19.68,0:09:21.18,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:21.26,0:09:24.60,Default,,0,0,0,,Бірақ сол көз жасының ізін көргенде көзім жетті.
Dialogue: 0,0:09:24.68,0:09:27.23,Default,,0,0,0,,Олар Атридің жүрегі бар дейді.
Dialogue: 0,0:09:28.40,0:09:32.23,Default,,0,0,0,,Бұл жігіт туылғаннан бері қиналып келеді.
Dialogue: 0,0:09:33.23,0:09:35.57,Default,,0,0,0,,Бұл дұрыс болуы керек, бірақ мен мұны қаламаймын.
Dialogue: 0,0:09:35.65,0:09:38.57,Default,,0,0,0,,Бұл дұрыс емес болса да, оны істемей тұра алмайсың
Dialogue: 0,0:09:39.07,0:09:42.87,Default,,0,0,0,,Менің жүрегім тудыратын импульстармен шатасуда ...
Dialogue: 0,0:09:42.95,0:09:43.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:46.04,0:09:47.25,Default,,0,0,0,,Сіз ояндыңыз ба?
Dialogue: 0,0:09:47.75,0:09:48.75,Default,,0,0,0,,Нацуо-сан
Dialogue: 0,0:09:48.83,0:09:49.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:50.04,0:09:52.46,Default,,0,0,0,,Қолың жақсы ма? Оны аздап жылжытып көріңіз.
Dialogue: 0,0:09:52.96,0:09:53.71,Default,,0,0,0,,Иә
Dialogue: 0,0:09:57.05,0:09:59.55,Default,,0,0,0,,Иә, ерекше проблема жоқ
Dialogue: 0,0:09:59.64,0:10:01.22,Default,,0,0,0,,Түсінемін, бұл жақсы.
Dialogue: 0,0:10:03.18,0:10:04.27,Default,,0,0,0,,Ум...
Dialogue: 0,0:10:04.35,0:10:07.77,Default,,0,0,0,,Ясуда енді ешқашан Атриге тиісе алмайды.
Dialogue: 0,0:10:07.85,0:10:11.31,Default,,0,0,0,,Кэтрин мен Рюджи материктік полициямен сөйлеспекші.
Dialogue: 0,0:10:11.40,0:10:14.98,Default,,0,0,0,,Оған гуманоидқа зиян келтіргені үшін айып тағылмауы мүмкін.
Dialogue: 0,0:10:15.07,0:10:16.65,Default,,0,0,0,,Баланы кепілге алу
Dialogue: 0,0:10:16.74,0:10:19.86,Default,,0,0,0,,Оның Рюджиге мылтық бағыттағаны анық.
Dialogue: 0,0:10:21.28,0:10:22.62,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:23.70,0:10:25.12,Default,,0,0,0,,Атри-чан…
Dialogue: 0,0:10:25.62,0:10:27.54,Default,,0,0,0,,Уайымдайтын ештеңе жоқ
Dialogue: 0,0:10:27.62,0:10:29.83,Default,,0,0,0,,Керісінше, өзімді сергек сезіндім.
Dialogue: 0,0:10:30.46,0:10:31.33,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:10:32.34,0:10:33.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:38.84,0:10:39.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:40.76,0:10:42.89,Default,,0,0,0,,кейде дұрыс емес әрекет жасайды
Dialogue: 0,0:10:43.51,0:10:46.10,Default,,0,0,0,,Ешқашан істеуге болмайтын нәрсені жасау
Dialogue: 0,0:10:46.68,0:10:49.52,Default,,0,0,0,,Айтуға болмайтын нәрсені айту
Dialogue: 0,0:10:50.94,0:10:55.15,Default,,0,0,0,,Сондықтан адамдар қуанады, жылайды, ашуланады.
Dialogue: 0,0:10:57.23,0:11:00.07,Default,,0,0,0,,Мен Атридің қасында болғым келеді.
Dialogue: 0,0:11:00.57,0:11:04.08,Default,,0,0,0,,Өйткені маған Атли ұнайды...
Dialogue: 0,0:11:05.49,0:11:06.62,Default,,0,0,0,,Нацуо-сан…
Dialogue: 0,0:11:07.12,0:11:08.79,Default,,0,0,0,,Бұл жүрек
Dialogue: 0,0:11:09.29,0:11:10.54,Default,,0,0,0,,Атри түсінді, солай ма?
Dialogue: 0,0:11:11.46,0:11:12.63,Default,,0,0,0,,Иә
Dialogue: 0,0:11:14.09,0:11:17.59,Default,,0,0,0,,Ең бастысы - ақыл-ойды басқару.
Dialogue: 0,0:11:18.09,0:11:20.26,Default,,0,0,0,,Өз сезімдеріңізді бақылаңыз
Dialogue: 0,0:11:20.88,0:11:23.01,Default,,0,0,0,,Біз мұны қазірден бастап жасай аламыз.
Dialogue: 0,0:11:23.09,0:11:27.35,Default,,0,0,0,,Дұрыс, өйткені барлық адамдар оны жақсы меңгере бермейді.
Dialogue: 0,0:11:27.43,0:11:28.77,Default,,0,0,0,,О
Dialogue: 0,0:11:29.81,0:11:33.60,Default,,0,0,0,,Мен гуманоид болғандықтан, мені көп нәрсе үшін сынға алуы мүмкін.
Dialogue: 0,0:11:33.69,0:11:36.15,Default,,0,0,0,,Мен міндетті түрде сенің жаныңда боламын
Dialogue: 0,0:11:40.28,0:11:41.20,Default,,0,0,0,,Ум...
Dialogue: 0,0:11:41.28,0:11:43.20,Default,,0,0,0,,О... не?
Dialogue: 0,0:11:43.28,0:11:46.74,Default,,0,0,0,,Неге екені белгісіз, кенет қысып кеткім келді.
Dialogue: 0,0:11:48.99,0:11:50.79,Default,,0,0,0,,Мен сені қыссам болады ма?
Dialogue: 0,0:11:53.46,0:11:53.96,Default,,0,0,0,,О
Dialogue: 0,0:11:59.17,0:12:01.67,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:12:02.17,0:12:03.30,Default,,0,0,0,,Саана
Dialogue: 0,0:12:03.80,0:12:06.72,Default,,0,0,0,,Бірақ бұл жүрек
Dialogue: 0,0:12:10.31,0:12:12.52,Default,,0,0,0,,Біз сізді алаңдатып отырмыз ба?
Dialogue: 0,0:12:13.10,0:12:15.27,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:12:15.35,0:12:15.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:15.98,0:12:19.40,Default,,0,0,0,,Тереңірек байланыс сияқты.
Dialogue: 0,0:12:20.65,0:12:21.90,Default,,0,0,0,,Маған
Dialogue: 0,0:12:24.57,0:12:25.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:25.70,0:12:26.82,Default,,0,0,0,,Atri?
Dialogue: 0,0:12:27.53,0:12:29.16,Default,,0,0,0,,Сәлем Атри
Dialogue: 0,0:12:29.66,0:12:31.12,Default,,0,0,0,,Шаршаған жоқсың ба?
Dialogue: 0,0:12:31.79,0:12:36.21,Default,,0,0,0,,Бұл, әрине, бұрын-соңды болмаған нәтижемен жұмыс істеді ...
Dialogue: 0,0:12:36.29,0:12:37.88,Default,,0,0,0,,Ә? Шынында ма?
Dialogue: 0,0:12:41.26,0:12:43.88,Default,,0,0,0,,Мектепке барар алдында кеше болса керек
Dialogue: 0,0:12:43.97,0:12:45.80,Default,,0,0,0,,Мен мұны оқып жатырмын.
Dialogue: 0,0:12:45.89,0:12:48.18,Default,,0,0,0,,Мен қандай болмыспын?
Dialogue: 0,0:12:48.68,0:12:50.72,Default,,0,0,0,,Маған не болды?
Dialogue: 0,0:12:51.39,0:12:52.89,Default,,0,0,0,,Ол қайта тірілді
Dialogue: 0,0:12:52.98,0:12:55.77,Default,,0,0,0,,Тасқындай төгілді басыма.
Dialogue: 0,0:12:55.85,0:13:00.11,Default,,0,0,0,,Қуаныш пен қайғы қатар
Dialogue: 0,0:13:00.19,0:13:02.65,Default,,0,0,0,,Шина ханым...
Dialogue: 0,0:13:06.91,0:13:10.12,Default,,0,0,0,,Оянған сатып алушының сөздері
Dialogue: 0,0:13:10.62,0:13:12.16,Default,,0,0,0,,Мен бос емеспін
Dialogue: 0,0:13:12.66,0:13:15.83,Default,,0,0,0,,Оның орнына осы баланы күтуіңізді өтінемін.
Dialogue: 0,0:13:16.87,0:13:19.42,Default,,0,0,0,,Ой, сен гуманоидсың ба?
Dialogue: 0,0:13:19.50,0:13:20.34,Default,,0,0,0,,Иә
Dialogue: 0,0:13:20.84,0:13:22.92,Default,,0,0,0,,Дос болайық, иә?
Dialogue: 0,0:13:23.01,0:13:25.13,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:13:25.22,0:13:27.80,Default,,0,0,0,,Менің атым Шина. Сіздің атыңыз кім?
Dialogue: 0,0:13:28.30,0:13:30.76,Default,,0,0,0,,Әлі жоқ
Dialogue: 0,0:13:30.85,0:13:33.14,Default,,0,0,0,,Бұл мен оны кие аламын дегенді білдіре ме?
Dialogue: 0,0:13:33.22,0:13:34.81,Default,,0,0,0,,Әдетте сен сөгіс естуді марапат деп есептеп,
Dialogue: 0,0:13:35.31,0:13:37.77,Default,,0,0,0,,Рури… Нацуми…
Dialogue: 0,0:13:38.27,0:13:40.36,Default,,0,0,0,,А, дұрыс, Робоко!
Dialogue: 0,0:13:40.44,0:13:43.32,Default,,0,0,0,,«Робоко» роботтарды қорлайтын термин.
Dialogue: 0,0:13:43.40,0:13:46.07,Default,,0,0,0,,Уау, бұл сүйкімді.
Dialogue: 0,0:13:46.15,0:13:48.66,Default,,0,0,0,,Хмм, онда...
Dialogue: 0,0:13:52.24,0:13:53.41,Default,,0,0,0,,Атри…
Dialogue: 0,0:13:54.04,0:13:55.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:55.79,0:13:58.83,Default,,0,0,0,,Бала – Атри атты қоныс аударатын құс.
Dialogue: 0,0:13:58.92,0:14:00.84,Default,,0,0,0,,Сен де
Dialogue: 0,0:14:00.92,0:14:02.75,Default,,0,0,0,,Сіз қалай ойлайсыз? Жақсы есім, солай ма?
Dialogue: 0,0:14:04.59,0:14:06.01,Default,,0,0,0,,Атри…
Dialogue: 0,0:14:07.84,0:14:11.47,Default,,0,0,0,,Маған осылай аталды
Dialogue: 0,0:14:18.23,0:14:21.69,Default,,0,0,0,,«Атри» Маған бұл есім берілді.
Dialogue: 0,0:14:22.27,0:14:25.11,Default,,0,0,0,,Мен Шина-самамен бірге тұрдым.
Dialogue: 0,0:14:25.78,0:14:26.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:27.49,0:14:29.41,Default,,0,0,0,,А, жақсысың ба?
Dialogue: 0,0:14:31.70,0:14:33.28,Default,,0,0,0,,Шина ханым...
Dialogue: 0,0:14:33.37,0:14:34.79,Default,,0,0,0,,Уау
Dialogue: 0,0:14:34.87,0:14:38.46,Default,,0,0,0,,Сіз мұны жақын арада орындай аласыз, себебі Atri өнімділігі жоғары.
Dialogue: 0,0:14:38.54,0:14:40.37,Default,,0,0,0,,Жоғары өнімділік?
Dialogue: 0,0:14:42.08,0:14:43.04,Default,,0,0,0,,Иә
Dialogue: 0,0:14:43.13,0:14:46.88,Default,,0,0,0,,Анам бұл ең соңғы жоғары өнімді модель екенін айтты.
Dialogue: 0,0:14:46.96,0:14:48.80,Default,,0,0,0,,Сондықтан уайымдамаңыз
Dialogue: 0,0:14:48.88,0:14:50.26,Default,,0,0,0,,Дұрыс. Соңында соғыс дәл сол себепті басталды.
Dialogue: 0,0:14:50.34,0:14:52.76,Default,,0,0,0,,Анам үнемі солай айтады
Dialogue: 0,0:14:52.85,0:14:54.81,Default,,0,0,0,,Сөздер сөзде тұрады
Dialogue: 0,0:14:54.89,0:15:00.31,Default,,0,0,0,,Сондықтан жақсы сөз айту керек, жаман сөз айтпау керек дейміз.
Dialogue: 0,0:15:00.39,0:15:01.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:02.02,0:15:06.57,Default,,0,0,0,,Сондықтан да Атри сөздерді өзі айтады.
Dialogue: 0,0:15:07.28,0:15:09.95,Default,,0,0,0,,«Мен жоғары орындаушымын»
Dialogue: 0,0:15:11.41,0:15:13.82,Default,,0,0,0,,I... Жоғары өнімділік
Dialogue: 0,0:15:13.91,0:15:15.74,Default,,0,0,0,,Тағы да иә
Dialogue: 0,0:15:15.83,0:15:17.49,Default,,0,0,0,,Мен жоғары көрсеткішмін
Dialogue: 0,0:15:17.58,0:15:18.45,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:21.96,0:15:24.96,Default,,0,0,0,,Өйткені мен өнімділігі жоғары адаммын!
Dialogue: 0,0:15:27.34,0:15:31.59,Default,,0,0,0,,Шина-самамен өмірімнің көп бөлігі екеуміз ғана болды.
Dialogue: 0,0:15:32.84,0:15:36.22,Default,,0,0,0,,Қазірдің өзінде! Сәл демалыңыз
Dialogue: 0,0:15:36.31,0:15:39.98,Default,,0,0,0,,Неліктен тек сол жәндік қауіпті деп ойлайсыңдар?
Dialogue: 0,0:15:40.06,0:15:41.69,Default,,0,0,0,,Оны өлтір!
Dialogue: 0,0:15:42.19,0:15:43.52,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:15:43.60,0:15:46.07,Default,,0,0,0,,Оны жасаудың не қажеті бар?
Dialogue: 0,0:15:46.15,0:15:47.48,Default,,0,0,0,,Мен оны сатып алсам тезірек болар еді.
Dialogue: 0,0:15:47.98,0:15:51.40,Default,,0,0,0,,Жоқ, ол естелікке айналады, өйткені біз оны бірге жасаймыз.
Dialogue: 0,0:15:52.15,0:15:56.08,Default,,0,0,0,,Бірақ Шина-сама бүгін де көңілінен шыққан сияқты.
Dialogue: 0,0:15:56.16,0:15:57.45,Default,,0,0,0,,Мәселе жоқ
Dialogue: 0,0:16:00.25,0:16:03.42,Default,,0,0,0,,Бүгіннен бастап Шина-сама орта мектепте оқитын болады.
Dialogue: 0,0:16:03.50,0:16:06.38,Default,,0,0,0,,Өзгерістерді сәйкесінше тексеріңіз
Dialogue: 0,0:16:07.59,0:16:09.05,Default,,0,0,0,,Сіз қалай ойлайсыз? Атри
Dialogue: 0,0:16:09.13,0:16:10.67,Default,,0,0,0,,Сізге сәйкес келе ме?
Dialogue: 0,0:16:10.76,0:16:12.01,Default,,0,0,0,,Иә
Dialogue: 0,0:16:12.09,0:16:16.97,Default,,0,0,0,,Бірақ фотосуреттерге қарасаңыз, форманың бәрі бірдей.
Dialogue: 0,0:16:17.05,0:16:20.68,Default,,0,0,0,,Осыншама көп болса, қайсысы Шина-сама екенін ажырату қиын.
Dialogue: 0,0:16:20.77,0:16:22.31,Default,,0,0,0,,Уау
Dialogue: 0,0:16:22.39,0:16:25.48,Default,,0,0,0,,Сонымен, бір-біріміздің қайда екенімізді білмесек ше?
Dialogue: 0,0:16:25.56,0:16:26.94,Default,,0,0,0,,Ән айтамыз ба?
Dialogue: 0,0:16:27.02,0:16:29.69,Default,,0,0,0,,Өткен күні саған үйреткен әнім бар, солай ма?
Dialogue: 0,0:16:29.78,0:16:30.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:33.15,0:16:37.03,Default,,0,0,0,,♪ жаңбыр суланады
Dialogue: 0,0:16:37.91,0:16:39.66,Default,,0,0,0,,♪ Терезе жанында
Dialogue: 0,0:16:39.74,0:16:41.16,Default,,0,0,0,,Иә, бұл!
Dialogue: 0,0:16:41.66,0:16:42.62,Default,,0,0,0,,Иә
Dialogue: 0,0:16:43.12,0:16:44.21,Default,,0,0,0,,Фу…
Dialogue: 0,0:16:44.71,0:16:46.79,Default,,0,0,0,,Қазір оның бойы шамамен бірдей.
Dialogue: 0,0:16:48.09,0:16:48.88,Default,,0,0,0,,Иә
Dialogue: 0,0:16:49.88,0:16:54.93,Default,,0,0,0,,Бұдан былай мен Атридан үлкен боламын.
Dialogue: 0,0:16:57.55,0:16:58.43,Default,,0,0,0,,Хехе
Dialogue: 0,0:16:59.10,0:17:03.43,Default,,0,0,0,,Осыдан кейін Шина-сама күлуді қойды.
Dialogue: 0,0:17:08.52,0:17:10.77,Default,,0,0,0,,Мектеп есебі бойынша
Dialogue: 0,0:17:10.86,0:17:13.74,Default,,0,0,0,,«Триггер болмашы нәрсе болды» деп жазылған.
Dialogue: 0,0:17:14.74,0:17:19.24,Default,,0,0,0,,Сабақ үстінде Шина-сама студент қызға оның жеке тілі туралы ескертті.
Dialogue: 0,0:17:19.32,0:17:22.95,Default,,0,0,0,,Ескерту алған студент қыздың оған деген өшпенділігі болған деген болжам бар.
Dialogue: 0,0:17:23.70,0:17:27.75,Default,,0,0,0,,Себебі мектеп қабырғасында оқушы қыздардың билігі болды
Dialogue: 0,0:17:28.42,0:17:31.67,Default,,0,0,0,,Бұл өшпенділікке көптеген адамдар қосылды.
Dialogue: 0,0:17:33.01,0:17:37.01,Default,,0,0,0,,«Қорқыту» деп аталатын әлеуметтік проблемалық мінез-құлық ретінде танылған
Dialogue: 0,0:17:37.09,0:17:39.97,Default,,0,0,0,,Мен саған оны өз бетімен жылжытпа дедім!
Dialogue: 0,0:17:40.05,0:17:41.47,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:41.56,0:17:45.85,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:17:46.35,0:17:47.44,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:50.06,0:17:51.98,Default,,0,0,0,,Кернеу мәнінің жоғарылауын растаңыз
Dialogue: 0,0:17:52.07,0:17:56.86,Default,,0,0,0,,Бүгін 3 ай болды және менің стресс деңгейім қызыл аймақта қалады.
Dialogue: 0,0:17:57.78,0:17:59.20,Default,,0,0,0,,Сол күйінде қалдырылған жағдайда қауіпті
Dialogue: 0,0:18:04.45,0:18:05.20,Default,,0,0,0,,Не?
Dialogue: 0,0:18:05.29,0:18:07.71,Default,,0,0,0,,Нункоға айту керек.
Dialogue: 0,0:18:07.79,0:18:10.25,Default,,0,0,0,,Сіз бос емессіз, мама.
Dialogue: 0,0:18:10.33,0:18:11.42,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:18:11.50,0:18:17.22,Default,,0,0,0,,Теңіз деңгейі жақын арада көтеріліп, адамзатқа үлкен қауіп төнеді.
Dialogue: 0,0:18:17.30,0:18:20.26,Default,,0,0,0,,Институтта маған ешкім сенбейді.
Dialogue: 0,0:18:20.34,0:18:23.10,Default,,0,0,0,,Сіз жынды болып кеттіңіз, мама.
Dialogue: 0,0:18:24.47,0:18:25.64,Default,,0,0,0,,Түзетіңіз
Dialogue: 0,0:18:25.72,0:18:26.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:26.93,0:18:30.02,Default,,0,0,0,,Сөздің рухы сөзде тұрады дейді.
Dialogue: 0,0:18:30.81,0:18:32.82,Default,,0,0,0,,-Егер шын ниетің болмаса... -(Шина) Қатты болма!
Dialogue: 0,0:18:34.32,0:18:37.61,Default,,0,0,0,,Мен саған арқамды бұрсам болғаны.
Dialogue: 0,0:18:38.11,0:18:40.24,Default,,0,0,0,,Сен не білесің?
Dialogue: 0,0:18:41.37,0:18:42.57,Default,,0,0,0,,Көрші, ол лай шұңқырға түсіп кеткен сияқты.
Dialogue: 0,0:18:43.08,0:18:47.16,Default,,0,0,0,,Менің сезімдерім туралы ойландың ба?
Dialogue: 0,0:18:48.33,0:18:51.42,Default,,0,0,0,,Ха, сіз түсіне алмайсыз.
Dialogue: 0,0:18:51.50,0:18:55.17,Default,,0,0,0,,Гуманоидтарда сезім болмайды.
Dialogue: 0,0:18:56.34,0:18:57.34,Default,,0,0,0,,Иә
Dialogue: 0,0:18:58.55,0:19:00.55,Default,,0,0,0,,Стресс деңгейі жоғарылайды
Dialogue: 0,0:19:01.05,0:19:02.51,Default,,0,0,0,,Біз бұлай жалғастыра алмаймыз.
Dialogue: 0,0:19:03.51,0:19:05.31,Default,,0,0,0,,Бірдеңе істеу керек
Dialogue: 0,0:19:07.64,0:19:08.73,Default,,0,0,0,,Әйтеуір...
Dialogue: 0,0:19:18.11,0:19:19.32,Default,,0,0,0,,Мектепте
Dialogue: 0,0:19:19.40,0:19:22.74,Default,,0,0,0,,Мектеп фестивалінде спектакльдің басты рөлі шешілген сияқты.
Dialogue: 0,0:19:23.24,0:19:23.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:25.16,0:19:26.79,Default,,0,0,0,,Мәдени мерекенің басты кейіпкеріне айналу
Dialogue: 0,0:19:26.87,0:19:31.17,Default,,0,0,0,,Қарсылығыңызды білдіргеніңізге қарамастан, сізді таңдалды деп болжау
Dialogue: 0,0:19:34.00,0:19:36.46,Default,,0,0,0,,Ол шатырдан секірмек болып жатыр.
Dialogue: 0,0:19:36.96,0:19:37.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:37.96,0:19:40.05,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:19:57.57,0:19:59.19,Default,,0,0,0,,Ақылсыз ештеңе жасама!
Dialogue: 0,0:19:59.28,0:20:02.15,Default,,0,0,0,,Дұрыс, Ячигуса-сан, тынышталайық.
Dialogue: 0,0:20:02.24,0:20:04.53,Default,,0,0,0,,Менің ұшуға ниетім жоқ болса да.
Dialogue: 0,0:20:04.62,0:20:05.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:05.74,0:20:06.58,Default,,0,0,0,,Эй!
Dialogue: 0,0:20:06.66,0:20:08.99,Default,,0,0,0,,Егер байсалды болсаң, өлу керек пе?
Dialogue: 0,0:20:09.08,0:20:11.91,Default,,0,0,0,,Сонда сахнада тұрудың қажеті жоқ.
Dialogue: 0,0:20:12.41,0:20:14.42,Default,,0,0,0,,Жүр, ұш!
Dialogue: 0,0:20:14.92,0:20:16.42,Default,,0,0,0,,Тобе!
Dialogue: 0,0:20:16.50,0:20:17.59,Default,,0,0,0,,Тобе!
Dialogue: 0,0:20:17.67,0:20:22.17,Default,,0,0,0,,Осылай ұшуды жалғастырсаңыз, өлім ықтималдығы 97%.
Dialogue: 0,0:20:22.67,0:20:24.34,Default,,0,0,0,,-(Оқушылар) Болашақ! - қауіп
Dialogue: 0,0:20:24.43,0:20:27.35,Default,,0,0,0,,-(Оқушылар) Болашақ! Тобе! - Қауіпті қауіп
Dialogue: 0,0:20:28.26,0:20:29.43,Default,,0,0,0,,Тоқтату керек
Dialogue: 0,0:20:29.93,0:20:31.23,Default,,0,0,0,,Тобе!
Dialogue: 0,0:20:31.31,0:20:32.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:33.23,0:20:33.85,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:20:33.94,0:20:36.31,Default,,0,0,0,,Мен түсінгенде...
Dialogue: 0,0:20:54.62,0:20:55.33,Default,,0,0,0,,…
Dialogue: 0,0:20:55.42,0:20:56.83,Default,,0,0,0,,Мұны істеуді кім сұрады?
Dialogue: 0,0:20:57.46,0:20:58.46,Default,,0,0,0,,Шина ханым...
Dialogue: 0,0:21:05.18,0:21:06.30,Default,,0,0,0,,Бұл…
Dialogue: 0,0:21:08.30,0:21:09.68,Default,,0,0,0,,Құбыжық
Dialogue: 0,0:21:15.48,0:21:18.15,Default,,0,0,0,,Сеземін... Сөз жоқ.
Dialogue: 0,0:21:18.65,0:21:23.07,Default,,0,0,0,,Бірақ Атри әлі де Шинаны жақсы көрді.
Dialogue: 0,0:21:23.74,0:21:27.24,Default,,0,0,0,,Мен Шинаға пайдалы болғым келді.
Dialogue: 0,0:21:28.66,0:21:32.24,Default,,0,0,0,,Сол себепті сауығып кеткен соң қашып кетті.
Dialogue: 0,0:21:32.33,0:21:33.50,Default,,0,0,0,,О
Dialogue: 0,0:21:34.00,0:21:36.25,Default,,0,0,0,,Ал анаң білмесін
Dialogue: 0,0:21:36.33,0:21:38.25,Default,,0,0,0,,Мен сені үнсіз бақылап отырдым.
Dialogue: 0,0:21:41.67,0:21:45.76,Default,,0,0,0,,♪ жаңбыр суланады
Dialogue: 0,0:21:47.18,0:21:50.35,Default,,0,0,0,,♪ Терезе жанында
Dialogue: 0,0:21:50.85,0:21:54.31,Default,,0,0,0,,Оқуды бітіріп, кәмелетке толған
Dialogue: 0,0:21:55.10,0:21:56.85,Default,,0,0,0,,Мен туылғаннан кейін де
Dialogue: 0,0:21:58.52,0:21:59.65,Default,,0,0,0,,Атли
Dialogue: 0,0:22:01.36,0:22:02.86,Default,,0,0,0,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,0:22:03.48,0:22:04.90,Default,,0,0,0,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,0:22:05.61,0:22:06.90,Default,,0,0,0,,<Эрен басынан бері мүлде өзгерген жоқ. ➡
Dialogue: 0,0:22:07.49,0:22:11.20,Default,,0,0,0,,Мүмкін кемпір Атри туралы білетін шығар.
Dialogue: 0,0:22:11.78,0:22:13.91,Default,,0,0,0,,Жадты өшіруге батылы бар
Dialogue: 0,0:22:14.83,0:22:16.91,Default,,0,0,0,,Менің ойымша, ол мені ұйықтатты.
Dialogue: 0,0:22:20.75,0:22:22.34,Default,,0,0,0,,Нацуо-сан…
Dialogue: 0,0:22:22.42,0:22:23.88,Default,,0,0,0,,Сіз қалай ойлайсыз? Денесі
Dialogue: 0,0:22:24.67,0:22:27.59,Default,,0,0,0,,Мен түс көрдім...
Dialogue: 0,0:22:28.38,0:22:29.38,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:22:29.89,0:22:33.31,Default,,0,0,0,,Мм... Менің сенен бір жақсылығым бар.
Dialogue: 0,0:22:33.39,0:22:34.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:43.90,0:22:46.90,Default,,0,0,0,,Мен декорация сәл өзгерген болар деп ойладым.
Dialogue: 0,0:22:47.40,0:22:49.57,Default,,0,0,0,,Бір қызығы, бәрі сол кездегідей.
Dialogue: 0,0:22:50.16,0:22:53.49,Default,,0,0,0,,Мен сол жақтан Нацуды бақылап тұрдым.
Dialogue: 0,0:22:54.03,0:22:55.54,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:22:56.54,0:23:01.58,Default,,0,0,0,,Мен... Ол кезде функцияны осы жерден тоқтатуды ойладым.
Dialogue: 0,0:23:02.21,0:23:04.38,Default,,0,0,0,,Нацуо-сан сияқты
Dialogue: 0,0:23:06.55,0:23:10.30,Default,,0,0,0,,Өйткені мен сүйіктім Шина-самаға көмектесе алмадым.
Dialogue: 0,0:23:12.14,0:23:13.10,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:23:13.97,0:23:19.10,Default,,0,0,0,,Ол кезде Нацуо мүлде күлмейтін.
Dialogue: 0,0:23:20.02,0:23:25.36,Default,,0,0,0,,Сонымен, Шина-сама маған үйреткен әндер мен сөздермен ...
Dialogue: 0,0:23:25.86,0:23:28.78,Default,,0,0,0,,Жарайды, жарайды, жарайды.
Dialogue: 0,0:23:32.11,0:23:33.12,Default,,0,0,0,,Бәрі жақсы, Буккирати
Dialogue: 0,0:23:33.20,0:23:33.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:35.37,0:23:39.16,Default,,0,0,0,,Сенің анаң да риза болатынына сенімдімін.
Dialogue: 0,0:23:40.08,0:23:41.79,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:23:41.87,0:23:43.04,Default,,0,0,0,,О
Dialogue: 0,0:23:43.54,0:23:45.92,Default,,0,0,0,,Ана үнемі айтатын
Dialogue: 0,0:23:46.75,0:23:49.34,Default,,0,0,0,,Мен кешірім сұрағым келетін адам бар.
Dialogue: 0,0:23:51.97,0:23:53.76,Default,,0,0,0,,Ең жақын дос
Dialogue: 0,0:23:54.26,0:23:56.56,Default,,0,0,0,,Мен сені басқалардан артық жақсы көрсем де
Dialogue: 0,0:23:56.64,0:23:59.27,Default,,0,0,0,,Мен айтпауым керек нәрсені айттым.
Dialogue: 0,0:23:59.77,0:24:02.06,Default,,0,0,0,,Мен сені қатты ренжіттім.
Dialogue: 0,0:24:05.86,0:24:08.32,Default,,0,0,0,,Мен сені қайта көргім келеді.
Dialogue: 0,0:24:09.78,0:24:10.94,Default,,0,0,0,,Оған
Dialogue: 0,0:24:14.78,0:24:16.99,Default,,0,0,0,,Шина-сама...
Dialogue: 0,0:24:17.74,0:24:18.70,Default,,0,0,0,,О
Dialogue: 0,0:24:19.45,0:24:22.87,Default,,0,0,0,,Мен оның кім екенін көпке дейін білмедім.
Dialogue: 0,0:24:23.37,0:24:26.42,Default,,0,0,0,,Бұл сөзсіз Атри.
Dialogue: 0,0:24:27.84,0:24:32.34,Default,,0,0,0,,Атри менің ең жақын досым болды, басқалардан да маңызды.
Dialogue: 0,0:24:35.68,0:24:40.47,Default,,0,0,0,,Шина ханым... Шина ханым
Dialogue: 0,0:24:40.56,0:24:42.60,Default,,0,0,0,,Танжиро~!
Dialogue: 0,0:24:43.31,0:24:45.31,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:24:45.81,0:24:48.73,Default,,0,0,0,,(Атридің айқайы)
Dialogue: 0,0:24:50.61,0:24:54.49,Default,,0,0,0,,Жарайды, мен ешкімге айт деп сұрамаймын.
Dialogue: 0,0:24:56.11,0:24:59.12,Default,,0,0,0,,Мен біреуге айта алатын адам болғым келді.
Dialogue: 0,0:25:00.33,0:25:01.66,Default,,0,0,0,,Бұл сөз
Dialogue: 0,0:25:02.45,0:25:03.71,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:25:05.17,0:25:06.46,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:25:08.08,0:25:09.67,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:25:11.42,0:25:12.96,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:25:14.84,0:25:15.97,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:25:17.18,0:25:18.09,Default,,0,0,0,,Атори
Dialogue: 0,0:25:20.97,0:25:22.97,Default,,0,0,0,,♪～
Dialogue: 0,0:26:48.52,0:26:50.52,Default,,0,0,0,,～♪
