Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:29.68,0:02:32.27,jp,NTP,0000,0000,0000,,Сіз табандысыз.
Dialogue: 0,0:02:41.39,0:02:43.18,jp,NTP,0000,0000,0000,,Маған ұнамайды, оқушым.
Dialogue: 0,0:02:43.24,0:02:45.11,jp,NTP,0000,0000,0000,,Бұл ұрыс па? Мен сенбеймін.
Dialogue: 0,0:02:50.51,0:02:53.61,jp,NTP,0000,0000,0000,,Бұл дүниеде ол жұмыс істемейді ғой, солай ма?
Dialogue: 0,0:02:58.82,0:03:01.46,jp,NTP,0000,0000,0000,,Жақсы, балалар сендер жайдарлы екенсіңдер.
Dialogue: 0,0:03:09.71,0:03:16.06,jp,NTP,0000,0000,0000,,Баршаңызды қазіргі заманғы өнер факультетіне қош келдіңіздер, мен, Юкико Хирохара, кафедра меңгерушісімін.
Dialogue: 0,0:03:16.62,0:03:20.24,jp,NTP,0000,0000,0000,,Экомодернизм – қазіргі қоғамның бүкіл әлемін қарастыратын ілім.
Dialogue: 0,0:03:20.24,0:03:22.38,jp,NTP,0000,0000,0000,,Зерттеу жүргізетін көптеген пәндер
Dialogue: 0,0:03:22.46,0:03:25.77,jp,NTP,0000,0000,0000,,Бұл археологияның заманауи нұсқасы.
Dialogue: 0,0:03:28.17,0:03:30.07,jp,NTP,0000,0000,0000,,Мен мұны талай рет естідім.
Dialogue: 0,0:03:31.45,0:03:34.69,jp,NTP,0000,0000,0000,,Яй, қазіргі заманғы өнер факультетінің көптен күткен мүшесі
Dialogue: 0,0:03:34.82,0:03:37.36,jp,NTP,0000,0000,0000,,Оның үстіне екі қыз, бір ұл.
Dialogue: 0,0:03:48.26,0:03:48.90,jp,NTP,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:03:49.79,0:03:51.84,jp,NTP,0000,0000,0000,,Менің әпкем жеті жыл бұрын қайтыс болды.
Dialogue: 0,0:03:52.58,0:03:55.62,jp,NTP,0000,0000,0000,,Қызыл түнде көргенім аян болса керек.
Dialogue: 0,0:03:56.52,0:03:58.34,jp,NTP,0000,0000,0000,,Бірақ сол кезде
Dialogue: 0,0:04:01.09,0:04:03.26,jp,NTP,0000,0000,0000,,Какеру-кун, не болды?
Dialogue: 0,0:04:04.90,0:04:07.06,jp,NTP,0000,0000,0000,,Көп ойланбаған дұрыс
Dialogue: 0,0:04:07.73,0:04:10.07,jp,NTP,0000,0000,0000,,Осылай бәріміз жиналдық.
Dialogue: 0,0:04:11.81,0:04:12.71,jp,NTP,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:04:13.28,0:04:16.50,jp,NTP,0000,0000,0000,,Мен бақыттымын. Мен көп достар таптым.
Dialogue: 0,0:04:16.93,0:04:18.61,jp,NTP,0000,0000,0000,,Юкико-чан керемет
Dialogue: 0,0:04:18.87,0:04:22.15,jp,NTP,0000,0000,0000,,Менің ойымша, сен сол қызыл түнде жалғыз аман қалдың.
Dialogue: 0,0:04:22.15,0:04:22.77,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:04:23.06,0:04:25.60,jp,NTP,0000,0000,0000,,Басқаша айтқанда, Юкико-чанның да ерекше өкілеттіктері бар.
Dialogue: 0,0:04:25.90,0:04:28.18,jp,NTP,0000,0000,0000,,Мен қарапайым қызбын.
Dialogue: 0,0:04:29.91,0:04:32.17,jp,NTP,0000,0000,0000,,Бірақ сынып кетсе қорқамын.
Dialogue: 0,0:04:35.17,0:04:37.43,jp,NTP,0000,0000,0000,,Сен әрқашан жарқынсың, Юкико-чан.
Dialogue: 0,0:04:38.18,0:04:39.93,jp,NTP,0000,0000,0000,,Мұның бәрі маңызды.
Dialogue: 0,0:04:42.74,0:04:46.98,jp,NTP,0000,0000,0000,,Дәл қай жерде және кіммен осылай жарақат алуым мүмкін еді?
Dialogue: 0,0:04:48.97,0:04:51.15,jp,NTP,0000,0000,0000,,Сіздің қатысуыңыз шектеулі.
Dialogue: 0,0:04:51.52,0:04:54.99,jp,NTP,0000,0000,0000,,Соңғы кездері мектепте қиналып жүрмін, жоғарыға көтерілуді ойлап жүрмін.
Dialogue: 0,0:04:55.51,0:04:59.69,jp,NTP,0000,0000,0000,,Өзіңе байланысты, бұл мәңгілік кеш адам.
Dialogue: 0,0:05:03.36,0:05:08.42,jp,NTP,0000,0000,0000,,Кенхиса, сенің әйелдерге қолыңды тигізбегеніңе қуаныштымын.
Dialogue: 0,0:05:10.78,0:05:11.81,jp,NTP,0000,0000,0000,,Қ-Қандай?
Dialogue: 0,0:05:12.06,0:05:13.75,jp,NTP,0000,0000,0000,,Күте тұр, Кенкю
Dialogue: 0,0:05:15.51,0:05:16.35,jp,NTP,0000,0000,0000,,Фрагмент
Dialogue: 0,0:05:18.38,0:05:21.73,jp,NTP,0000,0000,0000,,Қара рыцарь бізді сынықтар деп айтты.
Dialogue: 0,0:05:22.13,0:05:25.36,jp,NTP,0000,0000,0000,,Жоғалып бара жатқан бөліктерге жауап берудің қажеті жоқ.
Dialogue: 0,0:05:25.93,0:05:27.71,jp,NTP,0000,0000,0000,,Үзінділер дегенді қалай түсінесіңдер?
Dialogue: 0,0:05:28.02,0:05:30.24,jp,NTP,0000,0000,0000,,Және тағы неше фрагмент бар?
Dialogue: 0,0:05:32.61,0:05:34.53,jp,NTP,0000,0000,0000,,Мен ғана білемін
Dialogue: 0,0:05:36.42,0:05:38.07,jp,NTP,0000,0000,0000,,Қызыл түннің басталуы
Dialogue: 0,0:05:38.29,0:05:41.72,jp,NTP,0000,0000,0000,,Маған дұрыс көзқараста болған адам көмектесті.
Dialogue: 0,0:05:42.92,0:05:45.69,jp,NTP,0000,0000,0000,,Юкико-кун, сен де онымен кездесесің бе?
Dialogue: 0,0:05:46.15,0:05:49.13,jp,NTP,0000,0000,0000,,Бұл қыз емес, ұл.
Dialogue: 0,0:05:52.43,0:05:55.38,jp,NTP,0000,0000,0000,,Сіз айта аласыз ба?
Dialogue: 0,0:05:55.50,0:05:57.21,jp,NTP,0000,0000,0000,,Сол дүние және осы құдірет туралы
Dialogue: 0,0:05:57.47,0:06:01.54,jp,NTP,0000,0000,0000,,Кенхиса Мен сенің қашып кетуіңе жол бермеймін.
Dialogue: 0,0:06:01.78,0:06:02.95,jp,NTP,0000,0000,0000,,Ұсталу аяқталды.
Dialogue: 0,0:06:05.11,0:06:09.44,jp,NTP,0000,0000,0000,,Жарайды, шешілді. Бүгінгі клуб қызметі сол адамды іздеу болмақ.
Dialogue: 0,0:06:11.35,0:06:13.42,jp,NTP,0000,0000,0000,,Бұйыртса, жақсылық асығыс.
Dialogue: 0,0:06:13.69,0:06:14.28,jp,NTP,0000,0000,0000,,Қазір
Dialogue: 0,0:06:16.61,0:06:17.59,jp,NTP,0000,0000,0000,,Мен сізді аздап алаңдатамын.
Dialogue: 0,0:06:18.28,0:06:22.44,jp,NTP,0000,0000,0000,,Кенхиса Таджима қайда?
Dialogue: 0,0:06:24.73,0:06:26.45,jp,NTP,0000,0000,0000,,Бұл жақын қоңырау болды.
Dialogue: 0,0:06:26.83,0:06:28.41,jp,NTP,0000,0000,0000,,Итатата
Dialogue: 0,0:06:28.85,0:06:32.05,jp,NTP,0000,0000,0000,,Бұл кенеттен болды ма? Бұл қорқынышты.
Dialogue: 0,0:06:33.64,0:06:35.51,jp,NTP,0000,0000,0000,,Сіз әділ адамсыз.
Dialogue: 0,0:06:36.60,0:06:39.04,jp,NTP,0000,0000,0000,,Көзілдірікті қыз Қайтадан сен бе?
Dialogue: 0,0:06:40.96,0:06:43.21,jp,NTP,0000,0000,0000,,Баршаңызға, іздеу аяқталды.
Dialogue: 0,0:06:45.18,0:06:46.29,jp,NTP,0000,0000,0000,,Бұл адам
Dialogue: 0,0:06:51.15,0:06:52.37,jp,NTP,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,0:06:53.21,0:06:56.29,jp,NTP,0000,0000,0000,,Қара айды көрген адамдар қаншама еді.
Dialogue: 0,0:06:56.99,0:06:58.70,jp,NTP,0000,0000,0000,,Сацуки сіз бе?
Dialogue: 0,0:06:59.43,0:07:00.08,jp,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:07:00.84,0:07:03.99,jp,NTP,0000,0000,0000,,Сізде шынымен де қабілет жоқ па?
Dialogue: 0,0:07:05.98,0:07:09.87,jp,NTP,0000,0000,0000,,Міне, сен осы күнге дейін осылай аман қалдың. Бұл үлкен мәселе.
Dialogue: 0,0:07:10.30,0:07:10.87,jp,NTP,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:07:11.58,0:07:13.69,jp,NTP,0000,0000,0000,,Ашуланба, мен сені мақтаймын.
Dialogue: 0,0:07:14.24,0:07:15.29,jp,NTP,0000,0000,0000,,Тәтті картоп жегің келе ме?
Dialogue: 0,0:07:15.84,0:07:16.41,jp,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:07:16.81,0:07:18.36,jp,NTP,0000,0000,0000,,Қажет емес
Dialogue: 0,0:07:19.41,0:07:20.14,jp,NTP,0000,0000,0000,,Өте көп
Dialogue: 0,0:07:20.62,0:07:22.13,jp,NTP,0000,0000,0000,,Олай болса өзіңізді еркін сезініңіз
Dialogue: 0,0:07:29.48,0:07:30.85,jp,NTP,0000,0000,0000,,Бірақ иә?
Dialogue: 0,0:07:31.13,0:07:34.51,jp,NTP,0000,0000,0000,,Қызыл түн туралы ешкім ештеңе білмейді ме?
Dialogue: 0,0:07:34.70,0:07:35.70,jp,NTP,0000,0000,0000,,Содан кейін I
Dialogue: 0,0:07:37.04,0:07:38.83,jp,NTP,0000,0000,0000,,Күте тұрыңыз, Кенхиса Таджима
Dialogue: 0,0:07:39.10,0:07:41.10,jp,NTP,0000,0000,0000,,Қазіргі өнер факультетіне қосылғыңыз келе ме?
Dialogue: 0,0:07:41.52,0:07:43.39,jp,NTP,0000,0000,0000,,Әлсіз иттер бір-біріне үйір болады
Dialogue: 0,0:07:43.98,0:07:46.54,jp,NTP,0000,0000,0000,,Кенхиса Таджима Көпшілікте болу хобби емес.
Dialogue: 0,0:07:46.86,0:07:47.79,jp,NTP,0000,0000,0000,,Тіпті иттер
Dialogue: 0,0:07:48.11,0:07:49.86,jp,NTP,0000,0000,0000,,Қызыл түн қайтадан келгенде
Dialogue: 0,0:07:50.92,0:07:53.20,jp,NTP,0000,0000,0000,,Мен өзім бірдеңе істеймін.
Dialogue: 0,0:07:58.35,0:07:59.30,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:08:00.46,0:08:01.75,jp,NTP,0000,0000,0000,,Ол дөрекі адам.
Dialogue: 0,0:08:02.12,0:08:05.73,jp,NTP,0000,0000,0000,,Жоқ. Ол өте мейірімді адам сияқты.
Dialogue: 0,0:08:06.93,0:08:09.51,jp,NTP,0000,0000,0000,,Иә, сен мейірімдісің.
Dialogue: 0,0:08:10.16,0:08:14.90,jp,NTP,0000,0000,0000,,Бұл жиіркенішті емес. Негізі барлығы қызғаншақ.
Dialogue: 0,0:08:38.30,0:08:43.16,jp,NTP,0000,0000,0000,,Кәкеру-сенпай, Мұшараға ғана көңіл бөле алмаймын.
Dialogue: 0,0:08:47.27,0:08:50.81,jp,NTP,0000,0000,0000,,Асықсаң, қылышың бейберекет болады.
Dialogue: 0,0:09:00.38,0:09:02.21,jp,NTP,0000,0000,0000,,Сіз не үшін күресіп жатырсыз?
Dialogue: 0,0:09:04.15,0:09:05.18,jp,NTP,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:09:06.88,0:09:08.49,jp,NTP,0000,0000,0000,,Юканы қорғау үшін
Dialogue: 0,0:09:10.98,0:09:13.10,jp,NTP,0000,0000,0000,,Қандай бос дыбыс!
Dialogue: 0,0:09:14.61,0:09:18.11,jp,NTP,0000,0000,0000,,Тек сөздер сырғып, ет пен қан емес.
Dialogue: 0,0:09:19.17,0:09:21.34,jp,NTP,0000,0000,0000,,Менің ойым менің күшім емес
Dialogue: 0,0:09:23.24,0:09:26.20,jp,NTP,0000,0000,0000,,Қолыңдағы қылышта қайсарлық бар ма?
Dialogue: 0,0:09:26.59,0:09:27.26,jp,NTP,0000,0000,0000,,Дайындық
Dialogue: 0,0:09:28.40,0:09:31.03,jp,NTP,0000,0000,0000,,Дайын болу – бұл іске асыру және есте сақтау
Dialogue: 0,0:09:31.58,0:09:35.15,jp,NTP,0000,0000,0000,,Бірақ сіздің ақыл-ойыңыз әлі жарықтық дәрежесіне жеткен жоқ.
Dialogue: 0,0:09:36.33,0:09:38.59,jp,NTP,0000,0000,0000,,Ең алдымен денені емес, ақылды жаттықтыру керек.
Dialogue: 0,0:09:39.73,0:09:43.29,jp,NTP,0000,0000,0000,,Өз ойларыңызды күш ретінде пайдаланыңыз, тек соны ойлаңыз.
Dialogue: 0,0:09:44.93,0:09:45.43,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:09:49.97,0:09:51.38,jp,NTP,0000,0000,0000,,Өз ойларыңызды күшке айналдырыңыз
Dialogue: 0,0:09:57.91,0:10:01.35,jp,NTP,0000,0000,0000,,Мен Юканы қорғайтын күш алғым келеді
Dialogue: 0,0:10:09.04,0:10:09.54,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:10:21.54,0:10:22.65,jp,NTP,0000,0000,0000,,Какеру Сенпай
Dialogue: 0,0:10:22.85,0:10:24.60,jp,NTP,0000,0000,0000,,Какеру-кун, не болды?
Dialogue: 0,0:10:25.45,0:10:28.47,jp,NTP,0000,0000,0000,,Жоқ, мен не істеп жатырмын?
Dialogue: 0,0:10:28.72,0:10:32.32,jp,NTP,0000,0000,0000,,Не айтарымды білмеймін, бірақ қазір ұрысқа түсіп қалсам ше?
Dialogue: 0,0:10:32.35,0:10:36.10,jp,NTP,0000,0000,0000,,Юканы қорғауға тырысып жатырсыз ба? Кәкеру-сенпай әп-сәтте өледі.
Dialogue: 0,0:10:36.58,0:10:38.28,jp,NTP,0000,0000,0000,,Менің ойымша, солай.
Dialogue: 0,0:10:39.09,0:10:41.21,jp,NTP,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:10:42.15,0:10:44.88,jp,NTP,0000,0000,0000,,Жоқ, бұл факт.
Dialogue: 0,0:10:45.91,0:10:46.87,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:10:48.97,0:10:54.48,jp,NTP,0000,0000,0000,,Кәкерудің қайсарлығын сынау үшін мен оған қылышымды сілтеуді ойладым.
Dialogue: 0,0:10:57.94,0:10:59.11,jp,NTP,0000,0000,0000,,Ағымдағы қозғалыс дегеніміз не?
Dialogue: 0,0:00:00.00,0:00:00.00,jp,NTP,0000,0000,0000,,??
Dialogue: 0,0:11:20.37,0:11:21.07,jp,NTP,0000,0000,0000,,Сәлем Юка
Dialogue: 0,0:11:22.93,0:11:25.61,jp,NTP,0000,0000,0000,,Мен қазір аянышты түрде дәрменсізмін.
Dialogue: 0,0:11:26.31,0:11:28.92,jp,NTP,0000,0000,0000,,Бірақ мен әрқашан Юканы қорғаймын.
Dialogue: 0,0:11:29.66,0:11:30.73,jp,NTP,0000,0000,0000,,Өзіңізді қатты итермеңіз
Dialogue: 0,0:11:31.35,0:11:34.01,jp,NTP,0000,0000,0000,,Менің де күшім жоқ.
Dialogue: 0,0:11:34.69,0:11:38.44,jp,NTP,0000,0000,0000,,Кәкеру қасымда болса екен.
Dialogue: 0,0:11:42.02,0:11:44.24,jp,NTP,0000,0000,0000,,Менің ойымша, бұл да өзім үшін.
Dialogue: 0,0:11:45.52,0:11:49.40,jp,NTP,0000,0000,0000,,Мен Юканы қорғағым келеді. Мен бұл сезімді күшке айналдырғым келеді.
Dialogue: 0,0:11:49.68,0:11:50.60,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:11:51.72,0:11:52.68,jp,NTP,0000,0000,0000,,О Чао~!
Dialogue: 0,0:11:52.83,0:11:54.71,jp,NTP,0000,0000,0000,,Бон Джорно ~ Шиори
Dialogue: 0,0:11:55.63,0:11:57.87,jp,NTP,0000,0000,0000,,Piacere Comesta Бетбелгі
Dialogue: 0,0:11:58.05,0:11:59.14,jp,NTP,0000,0000,0000,,Куанто Коста
Dialogue: 0,0:11:59.62,0:12:02.68,jp,NTP,0000,0000,0000,,Айтылмайтын итальян тілін қолданбаңыз
Dialogue: 0,0:12:02.70,0:12:06.72,jp,NTP,0000,0000,0000,,Өйткені мен тамырымда латын құмарлығы ағып жатқан оралманмын.
Dialogue: 0,0:12:06.74,0:12:10.02,jp,NTP,0000,0000,0000,,Мен отты қос тілді махаббатты қалаймын.
Dialogue: 0,0:12:10.40,0:12:13.09,jp,NTP,0000,0000,0000,,Оны өртеп күлге айналдыр
Dialogue: 0,0:12:13.26,0:12:14.65,jp,NTP,0000,0000,0000,,Окапито
Dialogue: 0,0:12:14.72,0:12:17.88,jp,NTP,0000,0000,0000,,Эй, Шиори-чан, менің ойымша, сіз Леди Фаст екенсіз.
Dialogue: 0,0:12:17.89,0:12:20.22,jp,NTP,0000,0000,0000,,Мен не айтсаң да тыңдаймын.
Dialogue: 0,0:12:20.83,0:12:25.03,jp,NTP,0000,0000,0000,,Осы жолдың бойымен тура жүріңіз де, оңға бұрылған жерде өліңіз.
Dialogue: 0,0:12:25.07,0:12:28.30,jp,NTP,0000,0000,0000,,Қуанышпен
Dialogue: 0,0:12:28.34,0:12:29.86,jp,NTP,0000,0000,0000,,Тура жүріңіз
Dialogue: 0,0:12:30.23,0:12:31.34,jp,NTP,0000,0000,0000,,Оңға бұрылыңыз
Dialogue: 0,0:12:32.72,0:12:34.66,jp,NTP,0000,0000,0000,,Шинбашира~!
Dialogue: 0,0:12:35.36,0:12:37.60,jp,NTP,0000,0000,0000,,Алли Ведерчи Қош бол
Dialogue: 0,0:12:39.68,0:12:42.40,jp,NTP,0000,0000,0000,,Сен сондай ақымақсың.
Dialogue: 0,0:12:44.88,0:12:48.66,jp,NTP,0000,0000,0000,,Егер сен одан сайын ақымақ болып кетсең, мен сені ақымақ деп не айтарымды білмеймін.
Dialogue: 0,0:12:59.28,0:13:00.26,jp,NTP,0000,0000,0000,,Құсақабе сенпай
Dialogue: 0,0:13:02.21,0:13:03.68,jp,NTP,0000,0000,0000,,Алдымен Юка барады.
Dialogue: 0,0:13:04.98,0:13:05.74,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:13:06.47,0:13:08.26,jp,NTP,0000,0000,0000,,Кешегі жаттығу туралы.
Dialogue: 0,0:13:08.56,0:13:09.05,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:13:11.56,0:13:13.24,jp,NTP,0000,0000,0000,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:13:22.76,0:13:23.92,jp,NTP,0000,0000,0000,,Ю Юка
Dialogue: 0,0:13:25.33,0:13:30.30,jp,NTP,0000,0000,0000,,Еңбегіңіз үшін рахмет. Қазіргі уақытта мен заманауи ғылым бойынша өз бетінше жұмыс істеп жатырмын.
Dialogue: 0,0:13:30.35,0:13:32.41,jp,NTP,0000,0000,0000,,Заманауитануды өз бетінше оқу
Dialogue: 0,0:13:32.45,0:13:32.99,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:13:33.21,0:13:37.32,jp,NTP,0000,0000,0000,,Неліктен Юканың кеудесі баланың денесі болса да ісіп кеткен?
Dialogue: 0,0:13:37.39,0:13:40.65,jp,NTP,0000,0000,0000,,Тоқта, Юкико-чан
Dialogue: 0,0:13:41.27,0:13:43.13,jp,NTP,0000,0000,0000,,Жақындаған да, жоғарылатпаған да.
Dialogue: 0,0:13:43.52,0:13:46.86,jp,NTP,0000,0000,0000,,Түзеткіш кеудеше болмаса, бұл заманауи керемет.
Dialogue: 0,0:13:48.78,0:13:51.86,jp,NTP,0000,0000,0000,,Киелі мектепте не деген ұятсыз іс.
Dialogue: 0,0:13:52.81,0:13:55.59,jp,NTP,0000,0000,0000,,Эй, Юкико-чан, тоқта, тоқта!
Dialogue: 0,0:14:08.81,0:14:09.32,jp,NTP,0000,0000,0000,,Мен келе жатырмын
Dialogue: 0,0:14:24.85,0:14:25.69,jp,NTP,0000,0000,0000,,Қызыл түн
Dialogue: 0,0:14:29.14,0:14:29.79,jp,NTP,0000,0000,0000,,Яғни
Dialogue: 0,0:14:29.93,0:14:32.56,jp,NTP,0000,0000,0000,,Кенкю-сенпай төбелесіп жатыр.
Dialogue: 0,0:14:32.74,0:14:33.23,jp,NTP,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:14:41.54,0:14:42.92,jp,NTP,0000,0000,0000,,Күйіп қалу
Dialogue: 0,0:14:48.61,0:14:54.58,jp,NTP,0000,0000,0000,,Кенкю-сенпайдың пирокинездік қасиеті бар.
Dialogue: 0,0:15:05.92,0:15:06.76,jp,NTP,0000,0000,0000,,Қара рыцарь
Dialogue: 0,0:15:09.88,0:15:12.96,jp,NTP,0000,0000,0000,,Фрагмент, мен бүгін түнде жеңілмеймін.
Dialogue: 0,0:15:13.32,0:15:15.42,jp,NTP,0000,0000,0000,,Балалар сендер кімсіңдер?
Dialogue: 0,0:15:15.68,0:15:19.17,jp,NTP,0000,0000,0000,,Мәйітке айналған күнәһарға айтар сөз жоқ.
Dialogue: 0,0:15:19.55,0:15:20.82,jp,NTP,0000,0000,0000,,Сұрақтар қойылмаған ба?
Dialogue: 0,0:15:21.55,0:15:23.25,jp,NTP,0000,0000,0000,,Юкико-кун, екеуіңізден сұраңыз.
Dialogue: 0,0:15:23.63,0:15:24.09,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:15:28.90,0:15:30.48,jp,NTP,0000,0000,0000,,Ұшақ Нагамицуды кесіп тастады
Dialogue: 0,0:15:34.53,0:15:34.93,jp,NTP,0000,0000,0000,,Қасиетті орындарым қалайша күйреді.
Dialogue: 0,0:15:45.61,0:15:47.75,jp,NTP,0000,0000,0000,,Koyatsu Kenpo пайдалануым керек пе?
Dialogue: 0,0:15:49.46,0:15:50.02,jp,NTP,0000,0000,0000,,Ерте
Dialogue: 0,0:15:50.74,0:15:52.33,jp,NTP,0000,0000,0000,,Құсақабе-сенпайға қысым түседі.
Dialogue: 0,0:16:02.11,0:16:03.21,jp,NTP,0000,0000,0000,,Ол басталды.
Dialogue: 0,0:16:03.94,0:16:05.74,jp,NTP,0000,0000,0000,,Иә, Аварития.
Dialogue: 0,0:16:06.38,0:16:09.05,jp,NTP,0000,0000,0000,,Гураны жеңу - фрагмент.
Dialogue: 0,0:16:09.67,0:16:10.87,jp,NTP,0000,0000,0000,,(Идзуми) Уау! Бұл өте қызықты естіледі.
Dialogue: 0,0:16:11.34,0:16:13.46,jp,NTP,0000,0000,0000,,Бұл жолы Ира мен Инвидия
Dialogue: 0,0:16:14.17,0:16:17.33,jp,NTP,0000,0000,0000,,Бұл Superbia тым суық.
Dialogue: 0,0:16:27.49,0:16:27.92,jp,NTP,0000,0000,0000,,Қауіпті
Dialogue: 0,0:16:30.98,0:16:31.70,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:16:32.80,0:16:35.59,jp,NTP,0000,0000,0000,,Ештеңе етпейді, менің үлкендерім одан жақсы.
Dialogue: 0,0:16:39.55,0:16:42.01,jp,NTP,0000,0000,0000,,Мисузу-сенпай шымшып қалды.
Dialogue: 0,0:16:43.43,0:16:45.38,jp,NTP,0000,0000,0000,,Күшім болса ғой
Dialogue: 0,0:16:45.91,0:16:49.47,jp,NTP,0000,0000,0000,,Менің ойымша, бұл тек сіз қалағаныңыз үшін алатын күш емес.
Dialogue: 0,0:16:51.15,0:16:55.86,jp,NTP,0000,0000,0000,,Менің билікке жетуден басқа амалым қалмады. Менің жағдайым солай болды.
Dialogue: 0,0:16:57.06,0:16:57.92,jp,NTP,0000,0000,0000,,Мен келемін
Dialogue: 0,0:17:06.50,0:17:08.79,jp,NTP,0000,0000,0000,,Юкико-чан
Dialogue: 0,0:17:37.05,0:17:38.18,jp,NTP,0000,0000,0000,,Бұл жылдамдық
Dialogue: 0,0:17:45.72,0:17:47.69,jp,NTP,0000,0000,0000,,Қандай жауынгерлік қабілет!
Dialogue: 0,0:17:48.40,0:17:49.37,jp,NTP,0000,0000,0000,,Аня Форджер
Dialogue: 0,0:17:57.13,0:17:57.77,jp,NTP,0000,0000,0000,,Юкико-кун
Dialogue: 0,0:18:15.61,0:18:18.41,jp,NTP,0000,0000,0000,,Кішкентай қызды жалама
Dialogue: 0,0:18:19.64,0:18:20.04,jp,NTP,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:18:42.86,0:18:43.73,jp,NTP,0000,0000,0000,,Юкико-чан
Dialogue: 0,0:18:44.70,0:18:46.54,jp,NTP,0000,0000,0000,,Бұл басқа адам сияқты
Dialogue: 0,0:19:13.95,0:19:15.11,jp,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:19:15.11,0:19:15.70,jp,NTP,0000,0000,0000,,Юкико
Dialogue: 0,0:19:17.86,0:19:18.37,jp,NTP,0000,0000,0000,,Ира
Dialogue: 0,0:19:19.29,0:19:20.42,jp,NTP,0000,0000,0000,,Invidia?
Dialogue: 0,0:19:22.06,0:19:25.52,jp,NTP,0000,0000,0000,,Мен үзінділерді өшіру жеткілікті деп ойладым, бірақ
Dialogue: 0,0:19:26.33,0:19:27.87,jp,NTP,0000,0000,0000,,Бәріміз бірге өлейік
Dialogue: 0,0:19:30.37,0:19:31.85,jp,NTP,0000,0000,0000,,Ято-сама!
Dialogue: 0,0:19:33.32,0:19:36.17,jp,NTP,0000,0000,0000,,Әділет одақтастары пайда болады
Dialogue: 0,0:19:48.28,0:19:49.44,jp,NTP,0000,0000,0000,,Менің бетім
Dialogue: 0,0:19:50.28,0:19:51.26,jp,NTP,0000,0000,0000,,Наранция Гилго 1984 жылы, Арыстан белгісінің астында дүниеге келген
Dialogue: 0,0:19:53.99,0:19:55.25,jp,NTP,0000,0000,0000,,Э? Қайда?
Dialogue: 0,0:20:00.72,0:20:02.00,jp,NTP,0000,0000,0000,,Қызыл түн аяқталды
Dialogue: 0,0:20:04.37,0:20:05.80,jp,NTP,0000,0000,0000,,Бұл баға ауыр.
Dialogue: 0,0:20:06.12,0:20:08.86,jp,NTP,0000,0000,0000,,Келесі жолы кездесетініміз сөзсіз
Dialogue: 0,0:20:22.71,0:20:23.60,jp,NTP,0000,0000,0000,,Өте шиеленісті, иә?
Dialogue: 0,0:20:26.48,0:20:27.51,jp,NTP,0000,0000,0000,,Юка не болды?
Dialogue: 0,0:20:28.22,0:20:29.72,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:20:35.94,0:20:38.31,jp,NTP,0000,0000,0000,,Ақымақ, сонша терең.
Dialogue: 0,0:20:57.00,0:20:59.11,jp,NTP,0000,0000,0000,,Мен мұны істедім.
Dialogue: 0,0:20:59.83,0:21:00.40,jp,NTP,0000,0000,0000,,Юкико
Dialogue: 0,0:21:00.85,0:21:01.74,jp,NTP,0000,0000,0000,,Юкико-чан
Dialogue: 0,0:21:02.51,0:21:05.12,jp,NTP,0000,0000,0000,,Көзілдірікті шешкенде солай болады
Dialogue: 0,0:21:05.96,0:21:07.24,jp,NTP,0000,0000,0000,,Қос тұлға?
Dialogue: 0,0:21:09.03,0:21:12.23,jp,NTP,0000,0000,0000,,Адамгершіліктен тыс жауынгерлік қабілеті және орасан зор өлтіру ниеті
Dialogue: 0,0:21:12.61,0:21:14.31,jp,NTP,0000,0000,0000,,Оны қайдан алдың?
Dialogue: 0,0:21:15.42,0:21:19.17,jp,NTP,0000,0000,0000,,Солай ма? Мен бұл туралы шынымен айтқым келмейді.
Dialogue: 0,0:21:19.44,0:21:22.09,jp,NTP,0000,0000,0000,,Юкико-чан, жарақатың жақсы.
Dialogue: 0,0:21:23.78,0:21:24.45,jp,NTP,0000,0000,0000,,Сауықты
Dialogue: 0,0:21:25.75,0:21:28.59,jp,NTP,0000,0000,0000,,Шындығында, мен қайта жаңғырмақпын.
Dialogue: 0,0:21:29.45,0:21:31.99,jp,NTP,0000,0000,0000,,Мен өлмейтін денемен тудым.
Dialogue: 0,0:21:36.85,0:21:37.83,jp,NTP,0000,0000,0000,,Сіз өле алмайсыз ба?
Dialogue: 0,0:21:38.41,0:21:38.94,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:21:39.46,0:21:41.78,jp,NTP,0000,0000,0000,,Бұл жиіркенішті, солай емес пе?
Dialogue: 0,0:21:48.31,0:21:49.12,jp,NTP,0000,0000,0000,,Жарайды.
Dialogue: 0,0:21:50.17,0:21:54.84,jp,NTP,0000,0000,0000,,Мен үйреніп қалғандықтан, мен туралы көптен бері айтып жүр.
Dialogue: 0,0:22:11.38,0:22:14.72,jp,NTP,0000,0000,0000,,Мен Драсвения деген елде дүниеге келдім.
Dialogue: 0,0:22:14.96,0:22:17.53,jp,NTP,0000,0000,0000,,Бұл соғыс пен қырғын жері.
Dialogue: 0,0:22:17.63,0:22:18.40,jp,NTP,0000,0000,0000,,(Присцилла Барриэлл) Бұл мен естіген ең жалықтырарлық, мағынасыз әңгіме.
Dialogue: 0,0:22:22.61,0:22:24.21,jp,NTP,0000,0000,0000,,Жарайды, Юкико.
Dialogue: 0,0:22:27.97,0:22:33.29,jp,NTP,0000,0000,0000,,Мені қабылдаған төрт адам бар: сен, және
Dialogue: 0,0:22:43.41,0:22:47.53,jp,NTP,0000,0000,0000,,Мен бұған ренжімеймін, шын мәнінде мен бәрін қызғанамын.
Dialogue: 0,0:22:50.13,0:22:52.78,jp,NTP,0000,0000,0000,,Жарақат алсаңыз да, бірден орала алмайсыз.
Dialogue: 0,0:22:53.56,0:22:55.24,jp,NTP,0000,0000,0000,,Түпнұсқа сұлу қыз
Dialogue: 0,0:23:04.46,0:23:05.17,jp,NTP,0000,0000,0000,,Юкико-чан
Dialogue: 0,0:23:05.68,0:23:07.07,jp,NTP,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:23:07.07,0:23:07.90,jp,NTP,0000,0000,0000,,Юка-сан
Dialogue: 0,0:23:08.45,0:23:10.55,jp,NTP,0000,0000,0000,,Какеру Сенпай Мисузу Сенпай
Dialogue: 0,0:23:13.02,0:23:14.04,jp,NTP,0000,0000,0000,,Және
Dialogue: 0,0:23:17.56,0:23:19.63,jp,NTP,0000,0000,0000,,Кенкю Сенпай
Dialogue: 0,0:23:21.21,0:23:23.98,jp,NTP,0000,0000,0000,,Бізге қосылуыңызды күтеміз.
Dialogue: 0,0:25:02.46,0:25:04.90,jp,NTP,0000,0000,0000,,Келесі жолы Достарға және ертеңге
Dialogue: 0,0:25:05.88,0:25:08.74,jp,NTP,0000,0000,0000,,Қорқыныштың соңында жауап бар ма?
Dialogue: 0,0:25:10.24,0:25:16.24,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory