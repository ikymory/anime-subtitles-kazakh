Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:14.46,0:02:15.59,jp,NTP,0000,0000,0000,,Мен Юканы қорғағым келеді
Dialogue: 0,0:02:27.21,0:02:27.97,jp,NTP,0000,0000,0000,,Мен қорғағым келеді
Dialogue: 0,0:02:30.87,0:02:31.47,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:02:32.23,0:02:34.07,jp,NTP,0000,0000,0000,,Юкага қиын
Dialogue: 0,0:02:35.62,0:02:36.04,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:02:45.21,0:02:45.95,jp,NTP,0000,0000,0000,,Анемия
Dialogue: 0,0:02:46.43,0:02:48.62,jp,NTP,0000,0000,0000,,Иә, бұл жай ғана анемия.
Dialogue: 0,0:02:50.20,0:02:50.91,jp,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:02:51.50,0:02:54.58,jp,NTP,0000,0000,0000,,Жарайды десем де, Каори-чан
Dialogue: 0,0:02:54.97,0:02:57.06,jp,NTP,0000,0000,0000,,Ол сыныпта құлап қалғанын айтты.
Dialogue: 0,0:02:58.11,0:03:02.19,jp,NTP,0000,0000,0000,,Бірақ бұл үлкен мәселе емес; біраз жат, сонда бәрі жақсы болады.
Dialogue: 0,0:03:02.64,0:03:04.90,jp,NTP,0000,0000,0000,,Мені одан гөрі Какеру көбірек уайымдайды.
Dialogue: 0,0:03:06.35,0:03:07.69,jp,NTP,0000,0000,0000,,Менде бәрі жақсы
Dialogue: 0,0:03:08.69,0:03:09.80,jp,NTP,0000,0000,0000,,Суреттер дәптері
Dialogue: 0,0:00:00.00,0:00:00.00,jp,NTP,0000,0000,0000,,...
Dialogue: 0,0:03:15.90,0:03:17.75,jp,NTP,0000,0000,0000,,Мұның нені білдіретінін жақын арада түсінесіз.
Dialogue: 0,0:03:18.54,0:03:19.87,jp,NTP,0000,0000,0000,,Бұл туралы уайымдаудың пайдасы жоқ.
Dialogue: 0,0:03:20.27,0:03:21.25,jp,NTP,0000,0000,0000,,Маған бәрібір
Dialogue: 0,0:03:27.05,0:03:29.10,jp,NTP,0000,0000,0000,,Маған өтірік айтпа
Dialogue: 0,0:03:31.41,0:03:32.03,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:03:33.83,0:03:34.79,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:03:38.91,0:03:40.46,jp,NTP,0000,0000,0000,,Біз жақсы араласамыз.
Dialogue: 0,0:03:42.25,0:03:43.44,jp,NTP,0000,0000,0000,,Жоқ, бұл
Dialogue: 0,0:03:50.84,0:03:52.97,jp,NTP,0000,0000,0000,,Қиын екенін естігеніме өкінемін.
Dialogue: 0,0:03:53.01,0:03:53.44,jp,NTP,0000,0000,0000,,На
Dialogue: 0,0:04:00.27,0:04:02.05,jp,NTP,0000,0000,0000,,Бұл шынымен сүйкімді емес, солай ма?
Dialogue: 0,0:04:03.31,0:04:04.01,jp,NTP,0000,0000,0000,,Сол жігіт
Dialogue: 0,0:04:16.61,0:04:18.36,jp,NTP,0000,0000,0000,,Итатата
Dialogue: 0,0:04:19.22,0:04:22.62,jp,NTP,0000,0000,0000,,Кешіріңіз, мен алға қарай алмаймын.
Dialogue: 0,0:04:27.61,0:04:28.90,jp,NTP,0000,0000,0000,,Кенкю Сенпай
Dialogue: 0,0:04:34.67,0:04:35.51,jp,NTP,0000,0000,0000,,Мен аламын.
Dialogue: 0,0:04:38.35,0:04:39.60,jp,NTP,0000,0000,0000,,Ол қатты жараланған еді...
Dialogue: 0,0:05:01.22,0:05:03.66,jp,NTP,0000,0000,0000,,Қазір шынымен жақсысың ба?
Dialogue: 0,0:05:05.05,0:05:05.87,jp,NTP,0000,0000,0000,,Қазір бәрі жақсы
Dialogue: 0,0:05:06.51,0:05:07.18,jp,NTP,0000,0000,0000,,Минас
Dialogue: 0,0:05:07.55,0:05:08.94,jp,NTP,0000,0000,0000,,Иә, Аяко мырза.
Dialogue: 0,0:05:09.26,0:05:12.52,jp,NTP,0000,0000,0000,,Ұйқы жетіспеді дедің, бірақ не себеп болды?
Dialogue: 0,0:05:19.06,0:05:23.02,jp,NTP,0000,0000,0000,,Жарайды, мен көп нәрсе болатын жастамын.
Dialogue: 0,0:05:23.53,0:05:25.92,jp,NTP,0000,0000,0000,,Бірақ дұрыс ұйықтау керек.
Dialogue: 0,0:05:27.37,0:05:27.88,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:05:28.25,0:05:32.62,jp,NTP,0000,0000,0000,,Ал, егер ұйықтай алмасаң, біреуден бесік жырын айтуын сұра.
Dialogue: 0,0:05:33.45,0:05:34.72,jp,NTP,0000,0000,0000,,Бұл бесік жыры ма?
Dialogue: 0,0:05:35.05,0:05:36.31,jp,NTP,0000,0000,0000,,Сәлем Сатсуки
Dialogue: 0,0:05:37.12,0:05:38.25,jp,NTP,0000,0000,0000,,Мен бе?
Dialogue: 0,0:05:38.38,0:05:40.41,jp,NTP,0000,0000,0000,,Сіз маған телефон арқылы ән айта аласыз.
Dialogue: 0,0:05:40.48,0:05:43.29,jp,NTP,0000,0000,0000,,Жоқ, бірақ менде бесік жыры жоқ.
Dialogue: 0,0:05:43.39,0:05:45.90,jp,NTP,0000,0000,0000,,Басында ұят болады, бірақ тез үйреніп кетесің.
Dialogue: 0,0:05:46.65,0:05:47.92,jp,NTP,0000,0000,0000,,Мен де солай болдым.
Dialogue: 0,0:05:49.77,0:05:52.42,jp,NTP,0000,0000,0000,,Айя мұғалім де бесік жырын айтады
Dialogue: 0,0:05:53.57,0:05:54.35,jp,NTP,0000,0000,0000,,О, бұл біртүрлі.
Dialogue: 0,0:05:54.88,0:05:55.67,jp,NTP,0000,0000,0000,,Өйткені
Dialogue: 0,0:05:56.13,0:05:57.41,jp,NTP,0000,0000,0000,,Оны кімге арнадыңыз?
Dialogue: 0,0:05:58.43,0:05:59.45,jp,NTP,0000,0000,0000,,Кімге?
Dialogue: 0,0:06:00.58,0:06:01.52,jp,NTP,0000,0000,0000,,Балама
Dialogue: 0,0:06:01.82,0:06:02.57,jp,NTP,0000,0000,0000,,Менің балам?
Dialogue: 0,0:06:02.83,0:06:04.90,jp,NTP,0000,0000,0000,,Мұғалім, балаларыңыз бар ма?
Dialogue: 0,0:06:05.37,0:06:07.11,jp,NTP,0000,0000,0000,,Балалар сендер де кездестірдіңдер.
Dialogue: 0,0:06:07.57,0:06:10.29,jp,NTP,0000,0000,0000,,Қараңызшы, әлгі кесілмеген қылмыскер.
Dialogue: 0,0:06:10.37,0:06:11.56,jp,NTP,0000,0000,0000,,Апай әдеттегідей
Dialogue: 0,0:06:14.14,0:06:15.27,jp,NTP,0000,0000,0000,,Сіз неге таң қалдыңыз?
Dialogue: 0,0:06:16.33,0:06:17.23,jp,NTP,0000,0000,0000,,Өйткені
Dialogue: 0,0:06:18.48,0:06:19.87,jp,NTP,0000,0000,0000,,Эмоциялар сәйкес келмейді
Dialogue: 0,0:06:21.92,0:06:23.00,jp,NTP,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:06:23.61,0:06:28.90,jp,NTP,0000,0000,0000,,Сіздің биологиялық балаларыңыз емес, былайша айтқанда, сізбен бірге өскен ата-ана.
Dialogue: 0,0:06:28.98,0:06:29.88,jp,NTP,0000,0000,0000,,Өсу
Dialogue: 0,0:06:30.52,0:06:35.35,jp,NTP,0000,0000,0000,,Мен велосипедке әуесқой болдым.
Dialogue: 0,0:06:35.65,0:06:37.98,jp,NTP,0000,0000,0000,,Бұзық ғашықтар
Dialogue: 0,0:06:39.62,0:06:40.95,jp,NTP,0000,0000,0000,,Сіз ханымсыз ба?
Dialogue: 0,0:06:43.16,0:06:45.14,jp,NTP,0000,0000,0000,,Қарапайым тілмен айтқанда.
Dialogue: 0,0:06:45.99,0:06:50.32,jp,NTP,0000,0000,0000,,Сол түні біз көп кездестік, бізді Маппо қуды.
Dialogue: 0,0:07:06.68,0:07:07.06,jp,NTP,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:07:11.45,0:07:12.20,jp,NTP,0000,0000,0000,,Оған өз күнәларының ауырлығын түсіну үшін—
Dialogue: 0,0:07:16.41,0:07:19.00,jp,NTP,0000,0000,0000,,Көше балалары деп аталатындар.
Dialogue: 0,0:07:19.45,0:07:21.63,jp,NTP,0000,0000,0000,,Мен бала сияқты өмір сүруге тырыстым.
Dialogue: 0,0:07:22.18,0:07:24.10,jp,NTP,0000,0000,0000,,Бірақ бала әлі бала
Dialogue: 0,0:07:24.96,0:07:31.00,jp,NTP,0000,0000,0000,,Осы кезде мен кенет бұл баланы кім қорғайды деп ойладым.
Dialogue: 0,0:08:13.12,0:08:14.67,jp,NTP,0000,0000,0000,,Жастық тапқырлық
Dialogue: 0,0:08:15.12,0:08:17.44,jp,NTP,0000,0000,0000,,Енді мен оны алғаныма өкінемін.
Dialogue: 0,0:08:18.88,0:08:20.31,jp,NTP,0000,0000,0000,,Көшедегі балалар
Dialogue: 0,0:08:22.34,0:08:25.00,jp,NTP,0000,0000,0000,,Мекемеде өскен біз сияқты.
Dialogue: 0,0:08:26.55,0:08:27.24,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:08:28.48,0:08:29.63,jp,NTP,0000,0000,0000,,Сіз де
Dialogue: 0,0:08:44.55,0:08:45.50,jp,NTP,0000,0000,0000,,Онда мен қайтамын.
Dialogue: 0,0:08:48.60,0:08:50.30,jp,NTP,0000,0000,0000,,Сізге бесік жырын айтыңыз.
Dialogue: 0,0:08:50.69,0:08:51.16,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:08:52.47,0:08:53.00,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:08:53.49,0:08:55.47,jp,NTP,0000,0000,0000,,Ән айтасың, Какеру-кун.
Dialogue: 0,0:08:55.63,0:08:57.14,jp,NTP,0000,0000,0000,,Жоқ, солай.
Dialogue: 0,0:09:00.80,0:09:02.88,jp,NTP,0000,0000,0000,,(Рюкю) Барлығының өмірі сорып алынып жатыр; тіпті дұрыс тұра да алмайды
Dialogue: 0,0:09:03.19,0:09:04.89,jp,NTP,0000,0000,0000,,Қ-Қандай?
Dialogue: 0,0:09:06.08,0:09:07.35,jp,NTP,0000,0000,0000,,Мен мұны істедім
Dialogue: 0,0:09:08.53,0:09:12.99,jp,NTP,0000,0000,0000,,Енді қорқудың қажеті жоқ, сүйкімді жоғалған котенка.
Dialogue: 0,0:09:13.27,0:09:15.72,jp,NTP,0000,0000,0000,,Тадаши: Егер сіз сақтықты төмендетсеңіз, бұл қауіпті.
Dialogue: 0,0:09:19.78,0:09:22.09,jp,NTP,0000,0000,0000,,Қараңызшы, мен қазірдің өзінде сөйлеп тұрмын.
Dialogue: 0,0:09:28.95,0:09:31.65,jp,NTP,0000,0000,0000,,Абайлаңыз, бұл қатыгез котенка.
Dialogue: 0,0:09:40.76,0:09:41.28,jp,NTP,0000,0000,0000,,Ер
Dialogue: 0,0:09:46.38,0:09:47.12,jp,NTP,0000,0000,0000,,Оқ жаудырыңдар! Бүйіріне нысана ал!
Dialogue: 0,0:09:48.21,0:09:49.12,jp,NTP,0000,0000,0000,,Жоғалып кетті ме?
Dialogue: 0,0:09:50.19,0:09:50.99,jp,NTP,0000,0000,0000,,Не
Dialogue: 0,0:09:52.58,0:09:54.64,jp,NTP,0000,0000,0000,,Көпшіліктен құпия
Dialogue: 0,0:10:03.88,0:10:07.28,jp,NTP,0000,0000,0000,,Қызық, бұл баланы кім қорғайды?
Dialogue: 0,0:10:08.56,0:10:09.48,jp,NTP,0000,0000,0000,,Құсақабе сенпай
Dialogue: 0,0:10:11.55,0:10:12.26,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:10:13.17,0:10:13.98,jp,NTP,0000,0000,0000,,Бұл дұрыс болды.
Dialogue: 0,0:10:14.26,0:10:16.28,jp,NTP,0000,0000,0000,,Бүгін де сабақтан кейін келіңізші.
Dialogue: 0,0:10:16.61,0:10:20.11,jp,NTP,0000,0000,0000,,Қылыш шеберлігі? Оның алдында мен бүгін біреуді таныстырамын.
Dialogue: 0,0:10:21.07,0:10:21.63,jp,NTP,0000,0000,0000,,(Джунпей) Тағы айтамын: шегін, сиқыршы.
Dialogue: 0,0:10:23.07,0:10:24.17,jp,NTP,0000,0000,0000,,Менің ағам айтты
Dialogue: 0,0:10:25.49,0:10:28.32,jp,NTP,0000,0000,0000,,Ол кездесуге дайын сияқты.
Dialogue: 0,0:10:29.01,0:10:31.13,jp,NTP,0000,0000,0000,,Какеру-кун, жаттығу содан кейін болады.
Dialogue: 0,0:10:31.96,0:10:33.68,jp,NTP,0000,0000,0000,,Қазіргі өнер факультетінде мектептен кейін
Dialogue: 0,0:10:39.95,0:10:41.73,jp,NTP,0000,0000,0000,,Еңбегіңіз үшін рахмет
Dialogue: 0,0:10:48.25,0:10:49.63,jp,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:10:50.40,0:10:51.97,jp,NTP,0000,0000,0000,,Есеп берудің кешігуі үшін кешірім сұраймыз.
Dialogue: 0,0:10:52.69,0:10:57.59,jp,NTP,0000,0000,0000,,Кенхиса-сенпай, бүгіннен бастап біздің заманауи өнер факультетінің мүшесі болдыңыз.
Dialogue: 0,0:10:57.74,0:11:02.01,jp,NTP,0000,0000,0000,,Жоқ, мен тек тәттілерді жей аламын дегендіктен ғана келдім.
Dialogue: 0,0:11:06.87,0:11:08.46,jp,NTP,0000,0000,0000,,Шүберек шүберек
Dialogue: 0,0:11:09.08,0:11:09.79,jp,NTP,0000,0000,0000,,Жарайды
Dialogue: 0,0:11:17.28,0:11:17.77,jp,NTP,0000,0000,0000,,Қ-Қандай?
Dialogue: 0,0:11:18.25,0:11:18.93,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:11:20.23,0:11:21.83,jp,NTP,0000,0000,0000,,Кешіріңіз, кешігіп қалдым
Dialogue: 0,0:11:23.28,0:11:24.52,jp,NTP,0000,0000,0000,,Бірдеңе болды ма?
Dialogue: 0,0:11:24.62,0:11:25.52,jp,NTP,0000,0000,0000,,Бөлек
Dialogue: 0,0:11:26.80,0:11:27.80,jp,NTP,0000,0000,0000,,өте қиын
Dialogue: 0,0:11:29.34,0:11:33.61,jp,NTP,0000,0000,0000,,Барлығын таныстыруға рұқсат етіңіздер. Мен 3 В сыныбының Кикури Тачибана.
Dialogue: 0,0:11:38.89,0:11:41.06,jp,NTP,0000,0000,0000,,Кикури мырза
Dialogue: 0,0:11:43.35,0:11:43.88,jp,NTP,0000,0000,0000,,Апа
Dialogue: 0,0:11:59.57,0:12:02.72,jp,NTP,0000,0000,0000,,Мен Сатсуки-кунның үлкен әпкесіне.
Dialogue: 0,0:12:02.97,0:12:03.37,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:12:03.82,0:12:06.40,jp,NTP,0000,0000,0000,,Мен оны бірнеше рет көріп, қатты толқыдым.
Dialogue: 0,0:12:06.69,0:12:08.22,jp,NTP,0000,0000,0000,,Олар бір-біріне ұқсайды.
Dialogue: 0,0:12:11.56,0:12:13.13,jp,NTP,0000,0000,0000,,Кикури сөйлей алмайды.
Dialogue: 0,0:12:14.52,0:12:16.65,jp,NTP,0000,0000,0000,,Құлақ естиді, сондықтан әңгімені түсінуге болады.
Dialogue: 0,0:12:17.17,0:12:21.31,jp,NTP,0000,0000,0000,,Әңгімелескен кезде біз жазбаша қарым-қатынасты пайдаланамыз, бірақ менің ойымша, бәрі тез үйренеді.
Dialogue: 0,0:12:24.64,0:12:26.86,jp,NTP,0000,0000,0000,,Мен көремін. Мен түссіндім.
Dialogue: 0,0:12:27.30,0:12:30.08,jp,NTP,0000,0000,0000,,Менің атым Юкико Хирохара. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:12:39.40,0:12:42.34,jp,NTP,0000,0000,0000,,Сенпай, сенің кеуделерің таңқаларлық әдемі.
Dialogue: 0,0:12:44.28,0:12:45.81,jp,NTP,0000,0000,0000,,Юкико-чан
Dialogue: 0,0:12:46.77,0:12:47.27,jp,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:12:56.13,0:12:57.30,jp,NTP,0000,0000,0000,,Дәл жазылғандай жауап беріп отырсың — қазір сәнде жүрген сол «қолмен басқарылатын» кішкентай қыздардың бірісің бе?
Dialogue: 0,0:12:57.52,0:13:00.33,jp,NTP,0000,0000,0000,,Бұл таңқаларлық. Дәл қазір не болды?
Dialogue: 0,0:13:04.28,0:13:05.09,jp,NTP,0000,0000,0000,,дедім
Dialogue: 0,0:13:05.86,0:13:06.73,jp,NTP,0000,0000,0000,,Шетел тілі?
Dialogue: 0,0:13:07.01,0:13:09.94,jp,NTP,0000,0000,0000,,Бұл менің туып-өскен жерім Драсвенияның сөзі.
Dialogue: 0,0:13:10.22,0:13:13.46,jp,NTP,0000,0000,0000,,Бұл нені білдіреді? Достарыма және ертеңге.
Dialogue: 0,0:13:13.99,0:13:14.56,jp,NTP,0000,0000,0000,,Қалай?
Dialogue: 0,0:13:14.88,0:13:16.41,jp,NTP,0000,0000,0000,,Жоқ, олар не айтса да
Dialogue: 0,0:13:16.45,0:13:18.53,jp,NTP,0000,0000,0000,,Бұл біздің құпия сөзіміз.
Dialogue: 0,0:13:18.83,0:13:19.80,jp,NTP,0000,0000,0000,,Құпия сөз?
Dialogue: 0,0:13:20.03,0:13:22.49,jp,NTP,0000,0000,0000,,Қолыңнан келгеннің бәрін істеймін деген кезде қолданылады.
Dialogue: 0,0:13:22.98,0:13:24.82,jp,NTP,0000,0000,0000,,Менің ойымша, бұл жақсы болар еді.
Dialogue: 0,0:13:25.80,0:13:28.65,jp,NTP,0000,0000,0000,,Түсіндім, мүмкін бұл жаман емес.
Dialogue: 0,0:13:28.89,0:13:31.35,jp,NTP,0000,0000,0000,,Иә, достарыма және ертеңге.
Dialogue: 0,0:13:32.07,0:13:33.54,jp,NTP,0000,0000,0000,,Жақсы Жақсы
Dialogue: 0,0:13:33.80,0:13:34.93,jp,NTP,0000,0000,0000,,Бұл болады
Dialogue: 0,0:13:35.38,0:13:37.30,jp,NTP,0000,0000,0000,,Қалай ойлайсың, Кикури-сенпай?
Dialogue: 0,0:13:39.37,0:13:41.76,jp,NTP,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:13:43.76,0:13:45.59,jp,NTP,0000,0000,0000,,Мен Юкико-кунға тең келер емеспін.
Dialogue: 0,0:13:46.21,0:13:48.31,jp,NTP,0000,0000,0000,,Достар мен ертеңге
Dialogue: 0,0:13:49.39,0:13:50.17,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:13:50.90,0:13:53.21,jp,NTP,0000,0000,0000,,Кәкеру-сенпайға да ұнады ма?
Dialogue: 0,0:13:53.58,0:13:56.34,jp,NTP,0000,0000,0000,,Жарайды, онда бәріміз айтып көрейік.
Dialogue: 0,0:13:56.40,0:13:59.02,jp,NTP,0000,0000,0000,,Жақсы ма, Сино?
Dialogue: 0,0:13:59.03,0:14:00.30,jp,NTP,0000,0000,0000,,Күлкілі
Dialogue: 0,0:14:01.17,0:14:04.16,jp,NTP,0000,0000,0000,,Құпия сөзіңіз қандай? Мен бала емеспін.
Dialogue: 0,0:14:08.13,0:14:11.21,jp,NTP,0000,0000,0000,,Мен Кенкю-сенпайдан ұялып қалдым.
Dialogue: 0,0:14:11.68,0:14:13.18,jp,NTP,0000,0000,0000,,Мен сені қайтарамын.
Dialogue: 0,0:14:13.83,0:14:16.48,jp,NTP,0000,0000,0000,,Бұл адамды жалғыз қалдырыңыз.
Dialogue: 0,0:14:16.95,0:14:17.70,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:14:20.41,0:14:21.80,jp,NTP,0000,0000,0000,,Ол менің досым емес
Dialogue: 0,0:14:30.17,0:14:31.03,jp,NTP,0000,0000,0000,,Жақсы.
Dialogue: 0,0:14:32.17,0:14:35.70,jp,NTP,0000,0000,0000,,Кикури-сан, атымыздың бір екеніне таң қалдым.
Dialogue: 0,0:14:36.27,0:14:37.76,jp,NTP,0000,0000,0000,,Мен басқа адам болғандықтан жеңілдеп қалдым.
Dialogue: 0,0:14:41.24,0:14:42.56,jp,NTP,0000,0000,0000,,Сіз не ойлап отырсыз?
Dialogue: 0,0:14:43.49,0:14:45.00,jp,NTP,0000,0000,0000,,Достар мен ертеңге
Dialogue: 0,0:14:46.77,0:14:48.86,jp,NTP,0000,0000,0000,,Достар және ертең
Dialogue: 0,0:14:50.22,0:14:54.61,jp,NTP,0000,0000,0000,,Мен бұл туралы ешқашан ойламағандықтан шошып кеттім.
Dialogue: 0,0:14:55.35,0:14:56.26,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:14:57.18,0:15:00.01,jp,NTP,0000,0000,0000,,Жақсы сөз, достарыма, ертеңге.
Dialogue: 0,0:15:00.95,0:15:01.72,jp,NTP,0000,0000,0000,,Көптен бері көрмеген
Dialogue: 0,0:15:03.05,0:15:06.50,jp,NTP,0000,0000,0000,,Кәкерудің күлкісін көріп қуанып қалдым
Dialogue: 0,0:15:06.66,0:15:07.20,jp,NTP,0000,0000,0000,,Юка
Dialogue: 0,0:15:16.21,0:15:16.80,jp,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:15:25.80,0:15:26.21,jp,NTP,0000,0000,0000,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:15:27.19,0:15:28.60,jp,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:15:33.24,0:15:33.89,jp,NTP,0000,0000,0000,,Қабырға?
Dialogue: 0,0:15:41.09,0:15:41.41,jp,NTP,0000,0000,0000,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:15:45.26,0:15:46.20,jp,NTP,0000,0000,0000,,Жалғыз мен бе?
Dialogue: 0,0:15:53.10,0:15:53.94,jp,NTP,0000,0000,0000,,Кикури мырза
Dialogue: 0,0:15:54.88,0:15:55.85,jp,NTP,0000,0000,0000,,Бұл туралы айтатын болсақ
Dialogue: 0,0:15:56.32,0:15:59.14,jp,NTP,0000,0000,0000,,Менің ойымша, бұл дәретхана. Мен барып қарап көрейін.
Dialogue: 0,0:16:01.79,0:16:02.49,jp,NTP,0000,0000,0000,,Құсақабе сенпай
Dialogue: 0,0:16:04.41,0:16:07.02,jp,NTP,0000,0000,0000,,Мен семсермен айналысу туралы нұсқаулық алғым келеді.
Dialogue: 0,0:16:08.97,0:16:11.43,jp,NTP,0000,0000,0000,,Какеру-кун, бүгін кеш болып қалды.
Dialogue: 0,0:16:20.16,0:16:20.96,jp,NTP,0000,0000,0000,,Түсіңіз
Dialogue: 0,0:16:21.81,0:16:22.95,jp,NTP,0000,0000,0000,,Сіз мұны осында істеп жатырсыз ба?
Dialogue: 0,0:16:34.90,0:16:35.55,jp,NTP,0000,0000,0000,,Оған дейін
Dialogue: 0,0:16:37.22,0:16:38.18,jp,NTP,0000,0000,0000,,Аяғыңызға қараңыз
Dialogue: 0,0:16:41.03,0:16:41.99,jp,NTP,0000,0000,0000,,сағат нешеде?
Dialogue: 0,0:16:42.83,0:16:43.85,jp,NTP,0000,0000,0000,,Бассаң, тайып кетесің.
Dialogue: 0,0:16:44.45,0:16:46.45,jp,NTP,0000,0000,0000,,Тепе-теңдікті жоғалтып, тізбекті аяқтаңыз.
Dialogue: 0,0:16:48.98,0:16:51.71,jp,NTP,0000,0000,0000,,Сіз жай ғана басқа адаммен соқыр бетпе-бет келуге тырысасыз.
Dialogue: 0,0:16:52.22,0:16:54.82,jp,NTP,0000,0000,0000,,Қазір ғана емес, әрқашан.
Dialogue: 0,0:16:56.34,0:16:57.70,jp,NTP,0000,0000,0000,,Мен Юка-кунды қорғағым келеді
Dialogue: 0,0:16:59.52,0:17:03.65,jp,NTP,0000,0000,0000,,Сол сезім басымдыққа ие болады және сіз айналаңызға мүлдем қарамайсыз.
Dialogue: 0,0:17:07.16,0:17:10.65,jp,NTP,0000,0000,0000,,Алдымен сабыр сақтаңыз, бәрі содан басталады.
Dialogue: 0,0:17:11.25,0:17:14.06,jp,NTP,0000,0000,0000,,Асыққандардың жеңіске жету мүмкіндігі жоқ.
Dialogue: 0,0:17:17.54,0:17:18.43,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:17:20.83,0:17:21.89,jp,NTP,0000,0000,0000,,Олай болса үйге қайтайық.
Dialogue: 0,0:17:27.71,0:17:28.27,jp,NTP,0000,0000,0000,,Астанада ханым Куруш оларды қор ретінде жинап жатқанын естідім.
Dialogue: 0,0:17:41.16,0:17:42.63,jp,NTP,0000,0000,0000,,Фрагмент өшірілді
Dialogue: 0,0:17:48.55,0:17:49.58,jp,NTP,0000,0000,0000,,Сыртта жүгіру
Dialogue: 0,0:17:49.94,0:17:50.36,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:17:54.16,0:17:56.97,jp,NTP,0000,0000,0000,,Мен оны бөліктерге бөлемін.
Dialogue: 0,0:18:03.48,0:18:03.85,jp,NTP,0000,0000,0000,,Уууууууу!!
Dialogue: 0,0:18:04.25,0:18:04.62,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:18:15.59,0:18:19.74,jp,NTP,0000,0000,0000,,Сен қайда бардың? Кикури-сенпай, жақсысың ба?
Dialogue: 0,0:18:33.94,0:18:35.35,jp,NTP,0000,0000,0000,,Кенкю Сенпай
Dialogue: 0,0:18:36.03,0:18:38.21,jp,NTP,0000,0000,0000,,Егер сіз оны ашатын болсаңыз, қағып алсаңыз болды.
Dialogue: 0,0:18:39.01,0:18:41.02,jp,NTP,0000,0000,0000,,Бұл әйелдер дәретханасы.
Dialogue: 0,0:18:44.56,0:18:45.20,jp,NTP,0000,0000,0000,,Тырнақтарыңды қадалама.
Dialogue: 0,0:18:57.79,0:18:59.95,jp,NTP,0000,0000,0000,,Сіз мені жеңе алмайсыз
Dialogue: 0,0:19:01.21,0:19:01.92,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:19:05.80,0:19:07.32,jp,NTP,0000,0000,0000,,Бірде-бір сызат жоқ
Dialogue: 0,0:19:18.25,0:19:18.92,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:19:19.87,0:19:23.46,jp,NTP,0000,0000,0000,,Қорғамақ болған адамның соңын қараңыз.
Dialogue: 0,0:19:25.25,0:19:28.18,jp,NTP,0000,0000,0000,,Және өз дәрменсіздігіңізге шүкіршілік етіңіз.
Dialogue: 0,0:19:31.37,0:19:32.39,jp,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:19:32.94,0:19:34.98,jp,NTP,0000,0000,0000,,Келме, жоқ.
Dialogue: 0,0:19:42.24,0:19:43.07,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:19:44.39,0:19:46.83,jp,NTP,0000,0000,0000,,Сіз шынымен бірінші өлгіңіз келетін сияқты.
Dialogue: 0,0:19:47.86,0:19:49.65,jp,NTP,0000,0000,0000,,Енді өз қалауымызша жасайық.
Dialogue: 0,0:19:51.06,0:19:52.60,jp,NTP,0000,0000,0000,,Қуаттың тым көп айырмашылығы
Dialogue: 0,0:19:53.37,0:19:54.73,jp,NTP,0000,0000,0000,,Сен мені тура шабуылмен жеңе алмайсың
Dialogue: 0,0:19:55.62,0:19:56.48,jp,NTP,0000,0000,0000,,Тек соққы.
Dialogue: 0,0:19:57.47,0:19:59.77,jp,NTP,0000,0000,0000,,Бірақ біз не істеуіміз керек?
Dialogue: 0,0:20:05.57,0:20:06.34,jp,NTP,0000,0000,0000,,Яғни
Dialogue: 0,0:20:08.50,0:20:09.33,jp,NTP,0000,0000,0000,,Когарасумару
Dialogue: 0,0:20:11.12,0:20:12.63,jp,NTP,0000,0000,0000,,Ең алдымен сабырлы болыңыз.
Dialogue: 0,0:20:14.33,0:20:17.53,jp,NTP,0000,0000,0000,,Асыққандардың жеңіске жету мүмкіндігі жоқ.
Dialogue: 0,0:20:18.63,0:20:19.20,jp,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:20:20.26,0:20:23.36,jp,NTP,0000,0000,0000,,Асықпа, сабырлы бол.
Dialogue: 0,0:20:23.88,0:20:25.64,jp,NTP,0000,0000,0000,,Не болды? Бұл жұмыс істемеді.
Dialogue: 0,0:20:26.22,0:20:26.98,jp,NTP,0000,0000,0000,,Маған қоңырау шалыңыз
Dialogue: 0,0:20:31.80,0:20:34.27,jp,NTP,0000,0000,0000,,Сіз қатты қорқып кеткендіктен де ойладыңыз ба?
Dialogue: 0,0:20:34.63,0:20:35.50,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:20:39.30,0:20:42.76,jp,NTP,0000,0000,0000,,Өз ойларыңызды күш ретінде пайдаланыңыз, тек соны ойлаңыз.
Dialogue: 0,0:20:43.90,0:20:46.05,jp,NTP,0000,0000,0000,,Өз ойларыңызды күшке айналдырыңыз
Dialogue: 0,0:20:47.55,0:20:49.06,jp,NTP,0000,0000,0000,,Мен Юканы қорғаймын
Dialogue: 0,0:20:57.17,0:20:57.96,jp,NTP,0000,0000,0000,,Өл
Dialogue: 0,0:21:01.38,0:21:03.14,jp,NTP,0000,0000,0000,,Сіз неден жалтардыңыз?
Dialogue: 0,0:21:03.81,0:21:04.49,jp,NTP,0000,0000,0000,,Мен сені жібермеймін
Dialogue: 0,0:21:05.36,0:21:07.09,jp,NTP,0000,0000,0000,,Түсіндім, сен осылай айтып тұрсың ба?
Dialogue: 0,0:21:10.48,0:21:11.07,jp,NTP,0000,0000,0000,,Көздер
Dialogue: 0,0:21:11.52,0:21:12.14,jp,NTP,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:21:12.75,0:21:14.52,jp,NTP,0000,0000,0000,,Жоқ, бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:21:14.94,0:21:18.10,jp,NTP,0000,0000,0000,,Мұндай осал адамның оянуы мүмкін емес.
Dialogue: 0,0:21:24.46,0:21:24.94,jp,NTP,0000,0000,0000,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:21:38.43,0:21:41.33,jp,NTP,0000,0000,0000,,Менің сауытым ақымақ
Dialogue: 0,0:22:03.59,0:22:04.77,jp,NTP,0000,0000,0000,,Енді Ира
Dialogue: 0,0:22:09.04,0:22:09.95,jp,NTP,0000,0000,0000,,Оянды
Dialogue: 0,0:22:10.82,0:22:11.35,jp,NTP,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:22:11.77,0:22:13.43,jp,NTP,0000,0000,0000,,Лизет қазір не істеп жатыр?
Dialogue: 0,0:22:16.26,0:22:17.05,jp,NTP,0000,0000,0000,,Ол
Dialogue: 0,0:22:26.76,0:22:27.70,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:22:34.96,0:22:35.57,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:22:42.61,0:22:43.11,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:22:44.28,0:22:46.47,jp,NTP,0000,0000,0000,,Какеру-кун, не болды?
Dialogue: 0,0:22:47.66,0:22:48.39,jp,NTP,0000,0000,0000,,Сәлем Какеру-кун
Dialogue: 0,0:22:48.97,0:22:50.92,jp,NTP,0000,0000,0000,,Какеру-кун
Dialogue: 0,0:24:28.81,0:24:30.50,jp,NTP,0000,0000,0000,,Сіз ақыры ояндыңыз ба?
Dialogue: 0,0:24:31.37,0:24:33.55,jp,NTP,0000,0000,0000,,Өз күшіңізден қорқыңыз
Dialogue: 0,0:24:34.30,0:24:38.30,jp,NTP,0000,0000,0000,,Ол көздер бәрін беріп, бәрін алып кетеді
Dialogue: 0,0:24:40.15,0:24:43.78,jp,NTP,0000,0000,0000,,Мен сүйетін әлем, мен сүйетін адамдар
Dialogue: 0,0:24:44.97,0:24:46.74,jp,NTP,0000,0000,0000,,А, сен
Dialogue: 0,0:24:47.96,0:24:49.50,jp,NTP,0000,0000,0000,,Менің атым Верард
Dialogue: 0,0:24:50.38,0:24:52.03,jp,NTP,0000,0000,0000,,Қираған патшалықтың патшасы
Dialogue: 0,0:24:53.02,0:24:55.82,jp,NTP,0000,0000,0000,,Қасірет көзі ешкімді сиқырламайды
Dialogue: 0,0:25:01.47,0:25:03.88,jp,NTP,0000,0000,0000,,Келесі жолы мен абдырап қалдым
