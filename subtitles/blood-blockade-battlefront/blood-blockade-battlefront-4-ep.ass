Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:27.88,0:01:32.56,OP JP,,0,0,0,,m 0 0 l 100 0 l 100 1 l 0 1
Dialogue: 0,0:01:27.88,0:01:32.26,OP JP,,0,0,0,,Есікті ашсам, күн-түн
Dialogue: 0,0:01:32.26,0:01:32.56,OP JP,,0,0,0,,Есікті ашсаң, күн мен түн
Dialogue: 0,0:01:32.56,0:01:37.00,OP JP,,0,0,0,,m 0 0 l 100 0 l 100 1 l 0 1
Dialogue: 0,0:01:32.56,0:01:36.68,OP JP,,0,0,0,,Кеше үйге қалай келдіңіз? Тек сіздің денеңіз сенімді.
Dialogue: 0,0:01:36.68,0:01:37.00,OP JP,,0,0,0,,Кеше үйге қалай келдіңіз? Тек сіздің денеңіз сенімді.
Dialogue: 0,0:01:37.00,0:01:41.55,OP JP,,0,0,0,,m 0 0 l 100 0 l 100 1 l 0 1
Dialogue: 0,0:01:37.00,0:01:41.27,OP JP,,0,0,0,,Қайырлы таң, мен тағы да адасуды жалғастырамын.
Dialogue: 0,0:01:41.27,0:01:41.55,OP JP,,0,0,0,,Қайырлы таң, мен тағы да адасуды жалғастырамын.
Dialogue: 0,0:01:41.55,0:01:46.65,OP JP,,0,0,0,,m 0 0 l 100 0 l 100 1 l 0 1
Dialogue: 0,0:01:41.55,0:01:46.36,OP JP,,0,0,0,,Таныс және бейтаныс пейзажда
Dialogue: 0,0:01:46.36,0:01:46.65,OP JP,,0,0,0,,Таныс және бейтаныс пейзажда
Dialogue: 0,0:01:55.11,0:01:59.79,OP JP,,0,0,0,,m 0 0 l 100 0 l 100 1 l 0 1
Dialogue: 0,0:01:55.11,0:01:59.50,OP JP,,0,0,0,,Бұл жақсы емес деп ойлағаннан кейін мен бірдеңе істей алдым.
Dialogue: 0,0:01:59.50,0:01:59.79,OP JP,,0,0,0,,Мен мұны жақсы емес деп ойлағаннан кейін, мен бірдеңе істей алдым.
Dialogue: 0,0:01:59.79,0:02:04.32,OP JP,,0,0,0,,m 0 0 l 100 0 l 100 1 l 0 1
Dialogue: 0,0:01:59.79,0:02:04.04,OP JP,,0,0,0,,Өлмейтіні сонша, Біраз ұят
Dialogue: 0,0:02:04.04,0:02:04.32,OP JP,,0,0,0,,Өлмейтіні сонша, Біраз ұят
Dialogue: 0,0:02:04.32,0:02:08.76,OP JP,,0,0,0,,m 0 0 l 100 0 l 100 1 l 0 1
Dialogue: 0,0:02:04.32,0:02:08.47,OP JP,,0,0,0,,Ұмытып қалсаңыз да не істеу керектігін біліңіз
Dialogue: 0,0:02:08.47,0:02:08.76,OP JP,,0,0,0,,Мен не істеу керектігін ұмытсам да білемін
Dialogue: 0,0:02:08.76,0:02:13.63,OP JP,,0,0,0,,m 0 0 l 100 0 l 100 1 l 0 1
Dialogue: 0,0:02:08.76,0:02:13.34,OP JP,,0,0,0,,Олай етпесең, өте ауыр болады.
Dialogue: 0,0:02:13.34,0:02:13.63,OP JP,,0,0,0,,Олай етпесең, өте ауыр болады.
Dialogue: 0,0:02:13.63,0:02:17.89,OP JP,,0,0,0,,m 0 0 l 100 0 l 100 1 l 0 1
Dialogue: 0,0:02:13.63,0:02:17.60,OP JP,,0,0,0,,Жоғары қарашы, қара көзді адам
Dialogue: 0,0:02:17.60,0:02:17.89,OP JP,,0,0,0,,Жоғары қарашы, қара көзді адам.
Dialogue: 0,0:02:17.89,0:02:22.55,OP JP,,0,0,0,,m 0 0 l 100 0 l 100 1 l 0 1
Dialogue: 0,0:02:17.89,0:02:22.27,OP JP,,0,0,0,,Жарық сен оны көргендіктен туды.
Dialogue: 0,0:02:22.27,0:02:22.55,OP JP,,0,0,0,,Өйткені жарық дүниеге келгенін көрдіңіз
Dialogue: 0,0:02:22.55,0:02:27.33,OP JP,,0,0,0,,m 0 0 l 100 0 l 100 1 l 0 1
Dialogue: 0,0:02:22.55,0:02:27.03,OP JP,,0,0,0,,Сіз таңдаған түстермен боялған әлеммен қоршалған
Dialogue: 0,0:02:27.03,0:02:27.33,OP JP,,0,0,0,,Сіз таңдаған түстермен боялған әлеммен қоршалған
Dialogue: 0,0:02:27.33,0:02:31.55,OP JP,,0,0,0,,m 0 0 l 100 0 l 100 1 l 0 1
Dialogue: 0,0:02:27.33,0:02:31.24,OP JP,,0,0,0,,Таңдауға болмайтын тыртықтардың мәні неде?
Dialogue: 0,0:02:31.24,0:02:31.55,OP JP,,0,0,0,,Таңдауға болмайтын жаралар нені білдіреді?
Dialogue: 0,0:02:31.55,0:02:36.37,OP JP,,0,0,0,,m 0 0 l 100 0 l 100 1 l 0 1
Dialogue: 0,0:02:31.55,0:02:36.08,OP JP,,0,0,0,,Дүниенің ортасында жалғыз батырсың
Dialogue: 0,0:02:36.08,0:02:36.37,OP JP,,0,0,0,,Дүниенің ортасында жалғыз батырсың
Dialogue: 0,0:02:36.37,0:02:40.37,OP JP,,0,0,0,,m 0 0 l 100 0 l 100 1 l 0 1
Dialogue: 0,0:02:36.37,0:02:40.08,OP JP,,0,0,0,,Соңына дейін сахнада
Dialogue: 0,0:02:40.08,0:02:40.37,OP JP,,0,0,0,,Соңына дейін сахнада
Dialogue: 0,0:02:40.37,0:02:45.85,OP JP,,0,0,0,,m 0 0 l 100 0 l 100 1 l 0 1
Dialogue: 0,0:02:40.37,0:02:45.54,OP JP,,0,0,0,,Мен не істеуім керек? Мен тіпті бос адам сияқты бола алмаймын.
Dialogue: 0,0:02:45.54,0:02:45.85,OP JP,,0,0,0,,Мен не істеуім керек? Мен тіпті бос адам сияқты бола алмаймын.
Dialogue: 0,0:02:45.85,0:02:50.07,OP JP,,0,0,0,,m 0 0 l 100 0 l 100 1 l 0 1
Dialogue: 0,0:02:45.85,0:02:49.76,OP JP,,0,0,0,,Сәлеметсіз бе, мен осындамын.
Dialogue: 0,0:02:49.76,0:02:50.07,OP JP,,0,0,0,,Сәлеметсіз бе, мен осындамын.
Dialogue: 0,0:02:50.30,0:02:54.68,OP JP,,0,0,0,,m 0 0 l 100 0 l 100 1 l 0 1
Dialogue: 0,0:02:50.30,0:02:54.39,OP JP,,0,0,0,,Сәлеметсіз бе, мен осындамын.
Dialogue: 0,0:02:54.39,0:02:54.68,OP JP,,0,0,0,,Сәлеметсіз бе, мен осындамын.
Dialogue: 0,0:22:30.28,0:22:33.33,ED JP,,0,0,0,,Табиғи апат сияқты ессіздікке үйреніңіз.
Dialogue: 0,0:22:33.33,0:22:36.70,ED JP,,0,0,0,,Күнделікті өмірдің мұндай түрін тыныштық деп қателесу
Dialogue: 0,0:22:36.70,0:22:40.04,ED JP,,0,0,0,,шайқалып жатқан кездегі жағажай
Dialogue: 0,0:22:40.46,0:22:44.13,ED JP,,0,0,0,,Біз нені ешқашан ұмытпаймыз?
Dialogue: 0,0:22:44.55,0:22:47.80,ED JP,,0,0,0,,Теңдік фундаментализм концепциясы жұтылды
Dialogue: 0,0:22:47.80,0:22:51.29,ED JP,,0,0,0,,Менің жүрегім де т.б
Dialogue: 0,0:22:51.29,0:22:55.19,ED JP,,0,0,0,,Мен оны жек көремін Мен оны жақсы көремін Мен дұрыс сөйлесуім керек
Dialogue: 0,0:22:55.19,0:22:58.39,ED JP,,0,0,0,,Оның қуыршақтан айырмашылығы көп емес.
Dialogue: 0,0:22:59.06,0:23:06.15,ED JP,,0,0,0,,Кешкі көшелерді аралап жүрген қалың жұрт бірде бақытты, бірде жалғыз көрінеді.
Dialogue: 0,0:23:06.15,0:23:13.66,ED JP,,0,0,0,,Таяқтың айналасында қарама-қайшылықтар ұшып, ән мен ырғаққа айналады
Dialogue: 0,0:23:13.66,0:23:15.29,ED JP,,0,0,0,,Мармелад пен қант әні
Dialogue: 0,0:23:15.29,0:23:17.04,ED JP,,0,0,0,,Жержаңғақ және ащы қадам
Dialogue: 0,0:23:17.04,0:23:20.33,ED JP,,0,0,0,,Тәтті де ащы да, бас айналдырады.
Dialogue: 0,0:23:20.96,0:23:24.17,ED JP,,0,0,0,,Оңтүстік-оңтүстік-батысқа қарай партияны жалғастырыңыз.
Dialogue: 0,0:23:24.17,0:23:28.63,ED JP,,0,0,0,,Бүкіл әлемді дүр сілкіндіретін түн болады.
Dialogue: 0,0:23:28.63,0:23:31.76,ED JP,,0,0,0,,Мен өзімді керемет сезінемін, тізбекте көрініс табамын
Dialogue: 0,0:23:35.43,0:23:37.03,ED JP,,0,0,0,,Мармелад пен қант әні
Dialogue: 0,0:23:37.03,0:23:38.84,ED JP,,0,0,0,,Жержаңғақ және ащы қадам
Dialogue: 0,0:23:38.84,0:23:42.69,ED JP,,0,0,0,,Тәтті де ащы да, бас айналдырады.
Dialogue: 0,0:23:42.69,0:23:46.19,ED JP,,0,0,0,,Оңтүстік-оңтүстік-батысқа қарай партияны жалғастырыңыз.
Dialogue: 0,0:23:46.19,0:23:50.45,ED JP,,0,0,0,,Бүкіл әлемді дүр сілкіндіретін түн болады.
Dialogue: 0,0:23:50.45,0:23:54.12,ED JP,,0,0,0,,Мен өзімді керемет сезінемін, ой толғау тізбегі жалғасады
Dialogue: 0,0:23:54.12,0:23:56.91,ED JP,,0,0,0,,Бір күн бақыт, бір күн азап, тағы бір күн бақыт
Dialogue: 0,0:02:56.78,0:03:00.78,STAFF-,,0,0,0,,Бұл субтитр көзі көрмеге қойылған құдай субтитрлер жұбы,коммерциялық пайдалану үшін оқуға және алмасуға тыйым салынады және қытай-жапон тіліндегі қосымша субтитрлер қолжетімді.
Dialogue: 0,0:02:56.78,0:03:00.78,STAFF-,,0,0,0,,:paper& : :winter : : K.K. :KiLin
Dialogue: 0,0:00:18.82,0:00:22.51,JP,,0,0,0,,4-платформадағы пойыз Шигуарафу-Нараку жағына қарай жүреді.
Dialogue: 0,0:00:22.51,0:00:24.63,JP,,0,0,0,,Келісім паспортыңызды дайындаңыз
Dialogue: 0,0:00:25.17,0:00:27.39,JP,,0,0,0,,Өмір сүру деңгейі 12%
Dialogue: 0,0:00:34.57,0:00:37.89,JP,,0,0,0,,Уау,осындай жарық шығаратын адамдар бар.
Dialogue: 0,0:00:38.40,0:00:41.52,JP,,0,0,0,,Барлық жерде адамдар жеткілікті
Dialogue: 0,0:00:42.23,0:00:48.20,JP,,0,0,0,,Мұндағы тұрғындар 50% біртүрлі және 20% жұмбақ.
Dialogue: 0,0:00:48.23,0:00:53.51,JP,,0,0,0,,25% адам, бірақ оның жартысы белгілі бір себептермен,сіз білесіз.
Dialogue: 0,0:01:01.08,0:01:02.70,JP,,0,0,0,,Қалған 5% ше?
Dialogue: 0,0:01:04.41,0:01:09.25,JP,,0,0,0,,Қалған 5% қалыпты көзге көрінбейді.
Dialogue: 0,0:01:09.57,0:01:12.21,JP,,0,0,0,,Бұл жай ғана қауіпті нәрсе.
Dialogue: 0,0:01:13.20,0:01:17.21,JP,,0,0,0,,Хеллсалем лоты,басқа әлем мен осы дүние қиылысатын қала
Dialogue: 0,0:01:17.93,0:01:24.85,JP,,0,0,0,,Бұл әлемдегі тепе-теңдікті сақтау үшін сахна артында жұмыс істейтін суперадамдардың құпия қоғамы Таразы туралы оқиға.
Dialogue: 0,0:01:24.89,0:01:27.85,JP,,0,0,0,,Бұл белгісіз әрекеттердің жазбасы.
Dialogue: 0,0:03:04.81,0:03:07.64,JP,,0,0,0,,Франческо Лазороло жасырын келді ме?
Dialogue: 0,0:03:07.73,0:03:12.19,JP,,0,0,0,,Голдрейктің өз бастамасымен қастандық жасағы құрғандығы айтылады.
Dialogue: 0,0:03:12.39,0:03:16.50,JP,,0,0,0,,Сіз зейнеткерлікке шыққаннан кейін Флоридада ойнауды жоспарлап отырсыз ба?
Dialogue: 0,0:03:16.95,0:03:21.63,JP,,0,0,0,,Мен тік байлаулы Тонидің ашуланып бара жатқанын көріп тұрмын.
Dialogue: 0,0:03:26.82,0:03:30.71,JP,,0,0,0,,Бірақ, әй,мұндай нәрсенің анда-санда болғаны жақсы.
Dialogue: 0,0:03:30.73,0:03:33.44,JP,,0,0,0,,Балалар,соңғы уақытта тым көп жұмыс істеп жүрсіңдер.
Dialogue: 0,0:03:33.75,0:03:36.57,JP,,0,0,0,,Сіз толықтай болдыңыз,Патрик.
Dialogue: 0,0:03:36.60,0:03:41.55,JP,,0,0,0,,Мен үшін жақсы,өйткені менде бизнесті басқаратын қабілетті көмекшім бар.
Dialogue: 0,0:03:41.98,0:03:44.49,JP,,0,0,0,,Қару-жараққа күтім жасау - өмірдегі мақсатыңыздың бір бөлігі.
Dialogue: 0,0:03:45.15,0:03:47.74,JP,,0,0,0,,Көбірек әкел
Dialogue: 0,0:03:49.30,0:03:52.20,JP,,0,0,0,,Айтпасаң да,келесі аптада қолым бос емес сияқты.
Dialogue: 0,0:03:54.33,0:03:55.46,JP,,0,0,0,,(Қыңқыл) Бірақ қазір менде қорқыныштың бір ұшқыны да жоқ
Dialogue: 0,0:03:59.17,0:04:00.59,JP,,0,0,0,,Лео не болды?
Dialogue: 0,0:04:01.17,0:04:03.84,JP,,0,0,0,,Қызықты бірдеңе айтқыңыз келе ме?
Dialogue: 0,0:04:04.14,0:04:05.09,JP,,0,0,0,,Жоқ…
Dialogue: 0,0:04:05.18,0:04:08.10,JP,,0,0,0,,Иә,ол болашағы зор жаңадан келген адам.
Dialogue: 0,0:04:08.60,0:04:10.35,JP,,0,0,0,,Сізді қатты күлдіріп жібергенді айтыңыз
Dialogue: 0,0:04:12.81,0:04:14.98,JP,,0,0,0,,Мен мұны істей алмаймын, Патрик,тоқтат.
Dialogue: 0,0:04:15.48,0:04:17.94,JP,,0,0,0,,Осы күндері өзіңізді қалай сезінесіз?
Dialogue: 0,0:04:17.96,0:04:20.38,JP,,0,0,0,,Сіз бұл жерге көп үйреніп қалған шығарсыз.
Dialogue: 0,0:04:22.16,0:04:23.50,JP,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:04:25.74,0:04:29.08,JP,,0,0,0,,Оның мінез-құлқы әлі де біршама күдікті болуы мүмкін.
Dialogue: 0,0:04:29.68,0:04:34.09,JP,,0,0,0,,Бүгін метрода қанатындай таңғажайып ашық қызыл аураны жайған адам болды.
Dialogue: 0,0:04:34.17,0:04:39.28,JP,,0,0,0,,Әдемі болғаны сонша,мен біраз жарылып кеттім...
Dialogue: 0,0:04:44.55,0:04:45.40,JP,,0,0,0,,Леонардо мырза
Dialogue: 0,0:04:46.00,0:04:50.85,JP,,0,0,0,,«Қызыл жарқыраған қауырсындай жарық» дедім бе?
Dialogue: 0,0:04:52.67,0:04:53.64,JP,,0,0,0,,Иә...
Dialogue: 0,0:04:54.30,0:04:57.44,JP,,0,0,0,,Дәл осы түс пе?
Dialogue: 0,0:04:58.19,0:04:59.10,JP,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:04:59.30,0:05:00.40,JP,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:05:00.56,0:05:01.43,JP,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:05:02.41,0:05:04.40,JP,,0,0,0,,Міне,солай...
Dialogue: 0,0:05:05.78,0:05:08.78,JP,,0,0,0,,Айтып берейін,дәрменсіз адамдар.
Dialogue: 0,0:05:09.53,0:05:12.29,JP,,0,0,0,,Бұл қытырлақ патша кейіпкері қандай?
Dialogue: 0,0:05:12.34,0:05:13.73,JP,,0,0,0,,Үш тиын арқанмен ойнау?
Dialogue: 0,0:05:14.66,0:05:18.04,JP,,0,0,0,,Сіз көрген нәрсе вампир болды.
Dialogue: 0,0:05:22.76,0:05:24.80,JP,,0,0,0,,Мен не көрдім?
Dialogue: 0,0:05:24.90,0:05:26.30,JP,,0,0,0,,Сәлем
Dialogue: 0,0:05:28.00,0:05:31.22,JP,,0,0,0,,«Қызыл қауырсын киген асыл адам»
Dialogue: 0,0:05:31.86,0:05:34.00,JP,,0,0,0,,Атақты көне мәтіннің сөздерімен.
Dialogue: 0,0:05:34.79,0:05:38.60,JP,,0,0,0,,Зерттеу нәтижелері: Оның шын мәнінде бар екеніне күмән жоқ.
Dialogue: 0,0:05:38.95,0:05:43.48,JP,,0,0,0,,Оптикалық аспаптар мен датчиктердің барлық түрлері не бақыланбайды?
Dialogue: 0,0:05:43.74,0:05:45.08,JP,,0,0,0,,Бұл «құбылыс» болды
Dialogue: 0,0:05:45.53,0:05:48.11,JP,,0,0,0,,Вампирлер тағы біртүрлі...
Dialogue: 0,0:05:48.53,0:05:51.90,JP,,0,0,0,,Сіз мені кейінірек көп жылатасыз.
Dialogue: 0,0:05:52.83,0:05:55.40,JP,,0,0,0,,Менің ойымша,бұл ақсақалдар үйі.
Dialogue: 0,0:05:55.59,0:05:58.79,JP,,0,0,0,,Оның сырттағы қоқыс жәшігінен айырмашылығы бар емес пе?
Dialogue: 0,0:05:59.35,0:06:04.71,JP,,0,0,0,,Оның арқасында біз қазірден бастап алатын ақпараттың сапасы мен саны аспанға көтеріледі.
Dialogue: 0,0:06:04.76,0:06:06.72,JP,,0,0,0,,Маманның уақыты келді
Dialogue: 0,0:06:07.97,0:06:08.88,JP,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:06:10.02,0:06:12.39,JP,,0,0,0,,Сен маған телефон соғасың ба? Сол адам
Dialogue: 0,0:06:12.93,0:06:16.52,JP,,0,0,0,,Шынымды айтсам,маған телефон соғудың қажеті жоқ деп ойлаймын.
Dialogue: 0,0:06:18.47,0:06:22.00,JP,,0,0,0,,Мен бұл жағдайды ол адамсыз елестете алмаймын.
Dialogue: 0,0:06:25.42,0:06:26.90,JP,,0,0,0,,Сол адам...
Dialogue: 0,0:06:28.13,0:06:29.15,JP,,0,0,0,,Мистер Запп
Dialogue: 0,0:06:42.54,0:06:44.50,JP,,0,0,0,,Абрамс үлкен бақыт?
Dialogue: 0,0:06:44.50,0:06:49.79,JP,,0,0,0,,Бір сөзбен айтқанда,вампирге қарсы күрес жөніндегі әлемдегі жетекші сарапшылардың бірі.
Dialogue: 0,0:06:49.95,0:06:52.22,JP,,0,0,0,,Ол менің күйеуімнің тәлімгері.
Dialogue: 0,0:06:54.70,0:06:56.89,JP,,0,0,0,,Менің күйеуім бастапқыда сондай болған.
Dialogue: 0,0:06:57.65,0:06:59.29,JP,,0,0,0,,Жарайды,бәріміз де сондаймыз.
Dialogue: 0,0:06:59.60,0:07:04.39,JP,,0,0,0,,Бұрын адамдар дүниенің артқы жолдарында құбыжықтарды жою үшін көп еңбек еткен.
Dialogue: 0,0:07:04.89,0:07:05.86,JP,,0,0,0,,Сіз байқадыңыз ба?
Dialogue: 0,0:07:08.33,0:07:12.66,JP,,0,0,0,,Бақытты болғаныңыз үшін сізге әдетте екі атау бермейді.
Dialogue: 0,0:07:13.58,0:07:14.50,JP,,0,0,0,,Уг!?
Dialogue: 0,0:07:15.16,0:07:19.50,JP,,0,0,0,,Мен оны таптым.
Dialogue: 0,0:07:30.27,0:07:33.47,JP,,0,0,0,,Зап,жақсысың ба?
Dialogue: 0,0:07:33.90,0:07:36.26,JP,,0,0,0,,Әлі де шулы қала.
Dialogue: 0,0:07:38.55,0:07:40.68,JP,,0,0,0,,Қанша өмірің болса да,жетпейді
Dialogue: 0,0:07:46.35,0:07:49.07,JP,,0,0,0,,Кешіріңіз,Абрамс мырза.
Dialogue: 0,0:07:49.25,0:07:51.85,JP,,0,0,0,,Мен сізді біраз уақытқа қалдыра аламын ба?
Dialogue: 0,0:07:55.06,0:07:57.87,JP,,0,0,0,,Қалың қалай,уатқыш?
Dialogue: 0,0:07:57.89,0:08:02.08,JP,,0,0,0,,Клаус,әдеттегідей.
Dialogue: 0,0:08:02.87,0:08:06.42,JP,,0,0,0,,Сіз әлемге қысым жасау үшін дұрыс жұмыс жасайсыз ба?
Dialogue: 0,0:08:07.67,0:08:10.17,JP,,0,0,0,,Менің ойымша,сенің келетін уақытың таяп қалды.
Dialogue: 0,0:08:10.55,0:08:14.60,JP,,0,0,0,,Мен сізге арнайы хабарласпасам да,түсіндім.
Dialogue: 0,0:08:15.19,0:08:21.70,JP,,0,0,0,,Бұрын Ньюарк халықаралық әуежайында сәтсіз қону болды.
Dialogue: 0,0:08:22.26,0:08:22.81,JP,,0,0,0,,келді
Dialogue: 0,0:08:22.81,0:08:23.93,JP,,0,0,0,,келді
Dialogue: 0,0:08:23.94,0:08:25.53,JP,,0,0,0,,Сіз осындасыз.
Dialogue: 0,0:08:29.17,0:08:33.09,JP,,0,0,0,,Бұл менің көзқарасымның белгісі.
Dialogue: 0,0:08:36.28,0:08:38.93,JP,,0,0,0,,Келсем мені жүк көлігі соғып кете жаздады.
Dialogue: 0,0:08:39.30,0:08:40.89,JP,,0,0,0,,Мен дер кезінде құтқарылдым.
Dialogue: 0,0:08:41.53,0:08:46.23,JP,,0,0,0,,Сіз енді түсіндіңіз бе? Екі атымыздың мағынасы және мимикамыздың себебі
Dialogue: 0,0:09:03.23,0:09:04.77,JP,,0,0,0,,Леонардо мырза
Dialogue: 0,0:09:05.83,0:09:06.44,JP,,0,0,0,,Иә
Dialogue: 0,0:09:06.48,0:09:09.78,JP,,0,0,0,,Сіз «Құдайлардың жасанды көзі» иесі болдыңыз ба?
Dialogue: 0,0:09:10.22,0:09:11.00,JP,,0,0,0,,Иә
Dialogue: 0,0:09:11.66,0:09:13.82,JP,,0,0,0,,Неге маған ертерек айтпадың?
Dialogue: 0,0:09:16.28,0:09:18.99,JP,,0,0,0,,Алдымен мынаны қарағаныңызды қалаймын.
Dialogue: 0,0:09:23.25,0:09:25.21,JP,,0,0,0,,Қолдар...?
Dialogue: 0,0:09:25.57,0:09:31.25,JP,,0,0,0,,Бұл жай ғана қол емес,бұл ``13 Құрылған ақсақалға'' қатысты маңызды қасиет.
Dialogue: 0,0:09:31.48,0:09:37.47,JP,,0,0,0,,Солардың бірімен біздің қоғам өткенде бір рет қана бетпе-бет кездесті.
Dialogue: 0,0:09:38.50,0:09:42.34,JP,,0,0,0,,Нәтиже: Бүкіл әскери кеме басып алынды.
Dialogue: 0,0:09:42.38,0:09:45.68,JP,,0,0,0,,Ол бізге күліп тұрғандай болды.
Dialogue: 0,0:09:45.80,0:09:50.73,JP,,0,0,0,,343 экипаж мүшесі крест жасады
Dialogue: 0,0:09:50.94,0:09:52.11,JP,,0,0,0,,Және…
Dialogue: 0,0:09:54.08,0:09:59.03,JP,,0,0,0,,Бұл қулық үшін қырық жеті таңдаулы адам өлді.
Dialogue: 0,0:09:59.09,0:10:04.83,JP,,0,0,0,,Дәлірек айтсақ,бұл қол ұстаған борпылдақ жапырақтың кесірінен.
Dialogue: 0,0:10:08.05,0:10:11.34,JP,,0,0,0,,Бұл қосымша негізгі бөліктен бөлек қалады.
Dialogue: 0,0:10:11.69,0:10:14.00,JP,,0,0,0,,Менің ойымша,бұл тізім
Dialogue: 0,0:10:14.13,0:10:18.22,JP,,0,0,0,,''Жаратылған 13 ақсақалдың'' шын есімдерін қамтиды
Dialogue: 0,0:10:19.20,0:10:20.92,JP,,0,0,0,,Аты – «Котодама»
Dialogue: 0,0:10:21.42,0:10:26.14,JP,,0,0,0,,Олар «аталуы мүмкін тұлға» болуды жек көреді
Dialogue: 0,0:10:29.25,0:10:31.70,JP,,0,0,0,,Енді оқы,Леонардо.
Dialogue: 0,0:10:32.24,0:10:37.24,JP,,0,0,0,,Тұман сияқты ұстанбайтын болмыстың мәнін түсіріңіз.
Dialogue: 0,0:10:49.07,0:10:49.69,JP,,0,0,0,,Арыстан
Dialogue: 0,0:10:50.31,0:10:51.00,JP,,0,0,0,,Сендердің міндетің не,көпшілік?
Dialogue: 0,0:10:54.04,0:10:55.55,JP,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:10:58.90,0:11:00.09,JP,,0,0,0,,Бұл...
Dialogue: 0,0:11:02.31,0:11:03.44,JP,,0,0,0,,Клаус мырза
Dialogue: 0,0:11:04.16,0:11:07.48,JP,,0,0,0,,Барған сайын жарық...
Dialogue: 0,0:11:07.56,0:11:08.34,JP,,0,0,0,,Арыстан
Dialogue: 0,0:11:27.11,0:11:28.20,JP,,0,0,0,,Көп емес екен,иә?
Dialogue: 0,0:11:28.70,0:11:31.96,JP,,0,0,0,,Бір керемет сиқырлы нәрсе метеоритке соғылып құлады.
Dialogue: 0,0:11:32.62,0:11:35.21,JP,,0,0,0,,Мен біреуді метеоритпен соққанын бірінші рет көруім.
Dialogue: 0,0:11:35.71,0:11:39.43,JP,,0,0,0,,Мемлекеттік мекемедесің, Зап,тыныш бол.
Dialogue: 0,0:11:39.49,0:11:42.13,JP,,0,0,0,,Бұндай нәрселер мұнда сирек емес.
Dialogue: 0,0:11:42.51,0:11:44.47,JP,,0,0,0,,Өте сирек
Dialogue: 0,0:11:46.05,0:11:49.68,JP,,0,0,0,,Неліктен мен бұл жерге бұл адаммен келуім керек?
Dialogue: 0,0:11:53.65,0:11:56.88,JP,,0,0,0,,Менің күйеуім пойыздарға ерекше қуанады,өйткені олар сирек кездеседі.
Dialogue: 0,0:11:57.90,0:12:01.66,JP,,0,0,0,,Қарттар – миы, мінезі, жолы болмаса,қарапайым адамдар.
Dialogue: 0,0:12:05.16,0:12:06.33,JP,,0,0,0,,Мына жігіт жақсы ма?
Dialogue: 0,0:12:06.95,0:12:10.95,JP,,0,0,0,,Оның көздері жеңіл бұзылған көрінеді.
Dialogue: 0,0:12:11.46,0:12:14.96,JP,,0,0,0,,Сіз әдетте кесілетін заттарды қашықтықтан көре алатын сияқтысыз.
Dialogue: 0,0:12:16.34,0:12:17.75,JP,,0,0,0,,Бұл мүмкіндік
Dialogue: 0,0:12:18.76,0:12:21.49,JP,,0,0,0,,Мен арғы бетте жасырынып жатқан Ақсақалдарды ұстаймын.
Dialogue: 0,0:12:21.53,0:12:23.64,JP,,0,0,0,,Йггдрасиад орталық вокзалы
Dialogue: 0,0:12:23.64,0:12:27.12,JP,,0,0,0,,Йггдрасиад орталық вокзалы
Dialogue: 0,0:12:35.56,0:12:36.86,JP,,0,0,0,,Тек L өз ықпалындағы біреумен алмастырылған
Dialogue: 0,0:12:37.66,0:12:41.23,JP,,0,0,0,,Маған енді ұнамайды.
Dialogue: 0,0:12:41.93,0:12:43.24,JP,,0,0,0,,Жарайды,бұрыңыз.
Dialogue: 0,0:12:44.20,0:12:50.04,JP,,0,0,0,,12 қыркүйек 16:45:32
Dialogue: 0,0:12:50.83,0:12:54.94,JP,,0,0,0,,Барлығыңызға сәлем,бұл Блиц Т.Абрамс.
Dialogue: 0,0:12:54.98,0:12:58.46,JP,,0,0,0,,Біз қазір тозақ лотының қақ ортасындамыз
Dialogue: 0,0:12:58.50,0:13:02.34,JP,,0,0,0,,Шұңқырдың үстінде орналасқан Йггдрасиад орталық станциясында.
Dialogue: 0,0:13:02.75,0:13:09.22,JP,,0,0,0,,Енді құдайлардың көзді протезі бар баланың «мәңгілік қуысты» барлауы болады.
Dialogue: 0,0:13:09.56,0:13:15.52,JP,,0,0,0,,Адамзат тарихында алғаш рет жаратылған 13 ақсақалдың толық бейнесі болуы мүмкін.
Dialogue: 0,0:13:16.30,0:13:20.02,JP,,0,0,0,,Тыңдаңыз, егер сіз әдеттен тыс нәрсені сезсеңіз,дереу көзіңізді жабыңыз.
Dialogue: 0,0:13:21.53,0:13:25.99,JP,,0,0,0,,Жоқ, мүмкіндігінше бар күшіңізді салып көріңіз,содан кейін көзіңізді жұмыңыз.
Dialogue: 0,0:13:27.03,0:13:29.78,JP,,0,0,0,,Жоқ,соңғы сәтке дейін бар күшіңізді салыңыз.
Dialogue: 0,0:13:29.80,0:13:33.33,JP,,0,0,0,,«Енді менің қолымнан ештеңе келмейді, өлетінім анық,өлетінім анық.
Dialogue: 0,0:13:33.33,0:13:36.72,JP,,0,0,0,,Бұл өте жаман, бұл өте жаман,өте жаман.''
Dialogue: 0,0:13:38.09,0:13:39.18,JP,,0,0,0,,Мен дәл осылай ойлағанымда,көзімді жұмдым...
Dialogue: 0,0:13:39.18,0:13:40.21,JP,,0,0,0,,Жетеді
Dialogue: 0,0:13:46.45,0:13:48.93,JP,,0,0,0,,Қып-қызыл қанатты асылдар
Dialogue: 0,0:13:49.45,0:13:51.81,JP,,0,0,0,,Сол жарықтың түсі есімде.
Dialogue: 0,0:13:52.81,0:13:53.43,JP,,0,0,0,,Иә
Dialogue: 0,0:13:55.02,0:13:57.94,JP,,0,0,0,,Бір адам ма,әлде 13 адам ма?
Dialogue: 0,0:13:58.21,0:14:01.73,JP,,0,0,0,,Шұңқырдың түбінде оның бар екенін растай алсаңыз,бұл – игілік.
Dialogue: 0,0:14:26.18,0:14:27.80,JP,,0,0,0,,Лео,жақсысың ба?
Dialogue: 0,0:14:30.14,0:14:31.60,JP,,0,0,0,,Не көрдің?
Dialogue: 0,0:14:35.21,0:14:36.20,JP,,0,0,0,,Бұл қауіпті
Dialogue: 0,0:14:37.64,0:14:40.02,JP,,0,0,0,,Асты... ашық қызыл түске боялған.
Dialogue: 0,0:14:41.15,0:14:42.40,JP,,0,0,0,,Тіпті 13 адам емес.
Dialogue: 0,0:14:44.38,0:14:48.14,JP,,0,0,0,,Ол жақта... олар толы.
Dialogue: 0,0:14:53.05,0:14:53.83,JP,,0,0,0,,Клаус
Dialogue: 0,0:14:53.84,0:14:56.79,JP,,0,0,0,,Бочама,бұл төтенше жағдай.
Dialogue: 0,0:14:56.91,0:15:00.71,JP,,0,0,0,,Мен жаңа ғана Федералдық тергеу бюросынан сұрау алдым.
Dialogue: 0,0:15:01.46,0:15:04.46,JP,,0,0,0,,Стромкред авеню станциясындағы қатысу
Dialogue: 0,0:15:08.34,0:15:12.26,JP,,0,0,0,,Қарсылас ақсақал қанды тұқымды болуы мүмкін.
Dialogue: 0,0:15:20.44,0:15:24.48,JP,,0,0,0,,Ол шебер болмаса,бағындыру мүмкін емес қарсылас деп есептеледі.
Dialogue: 0,0:15:27.07,0:15:29.15,JP,,0,0,0,,Мүмкіндігінше тезірек оралыңыз.
Dialogue: 0,0:15:30.73,0:15:33.66,JP,,0,0,0,,Екінші қорғаныс шебі бұзылды және толығымен жойылды.
Dialogue: 0,0:15:33.68,0:15:36.41,JP,,0,0,0,,Сақ болыңыз, ол аруаққа айналып,сізге шабуыл жасайды.
Dialogue: 0,0:15:36.46,0:15:39.89,JP,,0,0,0,,Ол жақтағы әскер санын көбейтпе.
Dialogue: 0,0:15:40.24,0:15:41.08,JP,,0,0,0,,Шегіну
Dialogue: 0,0:15:42.10,0:15:44.04,JP,,0,0,0,,Балалар сендер сондай жеңіл киім киіп жүрсіңдер...
Dialogue: 0,0:15:44.10,0:15:47.13,JP,,0,0,0,,Жарайды. Мочи - бұл мочи дүкені.
Dialogue: 0,0:15:49.05,0:15:50.06,JP,,0,0,0,,Хироко,неге осындай жағдайға жеттік?
Dialogue: 0,0:15:50.24,0:15:53.16,JP,,0,0,0,,Екі кісілік камерада қара жүрек адам болмайды.
Dialogue: 0,0:15:53.35,0:15:55.23,JP,,0,0,0,,Олай айтпа,Қ.Қ.
Dialogue: 0,0:15:55.45,0:15:59.00,JP,,0,0,0,,Ақсақалға жалғыз шабуыл жасағаннан әлдеқайда жақсы.
Dialogue: 0,0:15:59.25,0:16:00.38,JP,,0,0,0,,Парасатты болайық
Dialogue: 0,0:16:01.60,0:16:03.69,JP,,0,0,0,,Мен 3 жыл күттім.
Dialogue: 0,0:16:05.40,0:16:06.48,JP,,0,0,0,,Міне,таптырмас нәрсе! Керемет!
Dialogue: 0,0:16:06.49,0:16:10.24,JP,,0,0,0,,Бұл күн ешқашан келмесе екен деп армандайтынмын.
Dialogue: 0,0:16:10.73,0:16:12.11,JP,,0,0,0,,Ол жақсы адам емес.
Dialogue: 0,0:16:12.61,0:16:14.49,JP,,0,0,0,,Мен жай ғана тыныш жүргім келеді
Dialogue: 0,0:16:17.38,0:16:19.85,JP,,0,0,0,,954 Blood Bullet жауынгерлік өнері
Dialogue: 0,0:16:19.46,0:16:21.71,JP,,0,0,0,,Эсмеральда стиліндегі қанды мұздататын жол
Dialogue: 0,0:16:27.29,0:16:30.67,JP,,0,0,0,,Абсолютті нөлдік қылыш
Dialogue: 0,0:16:27.29,0:16:30.67,JP-UP,,0,0,0,,Электр қосқышы 1,25 ГВт
Dialogue: 0,0:16:35.94,0:16:39.20,JP,,0,0,0,,Сіз жоғалтқыңыз келетін досыңыз бар ма?
Dialogue: 0,0:16:39.67,0:16:41.39,JP,,0,0,0,,Артқа тұрыңыз.
Dialogue: 0,0:16:41.57,0:16:43.56,JP,,0,0,0,,Сақтансаң,өлесің.
Dialogue: 0,0:16:43.77,0:16:45.06,JP,,0,0,0,,Мен саған 4 минут беремін.
Dialogue: 0,0:16:45.27,0:16:46.40,JP,,0,0,0,,Бұйрық бермеңіз
Dialogue: 0,0:16:49.27,0:16:50.28,JP,,0,0,0,,Маюшиі енді ғана айтылған сөздердің бір ауызын да түсінбеді.
Dialogue: 0,0:16:50.30,0:16:51.11,JP,,0,0,0,,О
Dialogue: 0,0:16:54.03,0:16:57.41,JP,,0,0,0,,Варина,тезірек келуіңді қалаймын.
Dialogue: 0,0:17:03.91,0:17:05.33,JP,,0,0,0,,Бұл...
Dialogue: 0,0:17:28.48,0:17:30.97,JP,,0,0,0,,Осыған ұқсас нәрселер өте көп
Dialogue: 0,0:17:31.34,0:17:34.03,JP,,0,0,0,,Неліктен осы уақытқа дейін қауіпсіз болды?
Dialogue: 0,0:17:34.90,0:17:39.82,JP,,0,0,0,,Біреуі де қызығып, жасырын кіріп,эрозияны бастаса.
Dialogue: 0,0:17:39.85,0:17:41.41,JP,,0,0,0,,Адам әлемі – бұл...
Dialogue: 0,0:17:45.78,0:17:47.10,JP,,0,0,0,,Оңай аяқталады
Dialogue: 0,0:17:53.88,0:17:58.13,JP,,0,0,0,,Леонардо,сенің көзің оны ұстауы керек.
Dialogue: 0,0:17:58.64,0:18:00.30,JP,,0,0,0,,Қанды тұқымның пайда болуы
Dialogue: 0,0:18:02.96,0:18:04.77,JP,,0,0,0,,Оның әлсіз жақтары да
Dialogue: 0,0:18:17.19,0:18:20.51,JP,,0,0,0,,Бұл ностальгиялық. Суретке түсірген сол ма еді?
Dialogue: 0,0:18:22.73,0:18:23.33,JP,,0,0,0,,Дұрыс,қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:18:23.77,0:18:26.21,JP,,0,0,0,,Бұл көздер ақиқат.
Dialogue: 0,0:18:28.45,0:18:31.54,JP,,0,0,0,,Менің сендерден көңілім қалды.
Dialogue: 0,0:18:32.46,0:18:34.25,JP,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:18:35.45,0:18:40.76,JP,,0,0,0,,Бұл біз үшін арнайы жасалған адам қаруы екенін естідім,бірақ ол бір қадам ғана қалды.
Dialogue: 0,0:18:42.88,0:18:47.52,JP,,0,0,0,,Жасушалық деңгейге еніп,зақымдайтын қан
Dialogue: 0,0:18:48.04,0:18:50.69,JP,,0,0,0,,Ол, әрине,біздің табиғи жауымыз.
Dialogue: 0,0:18:51.35,0:18:54.60,JP,,0,0,0,,Бірақ сол сәттен бастап қайта тірілу басталады.
Dialogue: 0,0:18:55.40,0:18:57.38,JP,,0,0,0,,Қараңызшы,ол толық жазылып кетті.
Dialogue: 0,0:19:00.70,0:19:03.53,JP,,0,0,0,,Жарайсың,құбыжық қыз.
Dialogue: 0,0:19:04.66,0:19:11.08,JP,,0,0,0,,1000 жыл керек пе, 1500 жыл керек пе,бәрібір адамзат сізді міндетті түрде қуып жетеді.
Dialogue: 0,0:19:12.39,0:19:17.59,JP,,0,0,0,,Біз өлмейтіндердің өлуіне жол бермеу қайшылығын басқара алатын күн міндетті түрде келеді.
Dialogue: 0,0:19:19.21,0:19:22.14,JP,,0,0,0,,Бұл уақытты үнемдейтін тамаша құрал.
Dialogue: 0,0:19:22.77,0:19:25.16,JP,,0,0,0,,Бірақ сол уақытты сатып алу
Dialogue: 0,0:19:25.63,0:19:30.03,JP,,0,0,0,,Тіпті үлкен деңгейге жететін азу тістер болса ше?
Dialogue: 0,0:19:32.35,0:19:33.15,JP,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:19:37.23,0:19:41.91,JP,,0,0,0,,Мен Blengrid қанмен күресу техникасын ұсынамын.
Dialogue: 0,0:19:49.50,0:19:52.55,JP,,0,0,0,,Валькель Роццо Вальктовоэль Гирика
Dialogue: 0,0:19:53.46,0:19:54.63,JP,,0,0,0,,Сіз...
Dialogue: 0,0:19:54.75,0:19:55.71,JP-UP,,0,0,0,,Аты…
Dialogue: 0,0:19:55.28,0:19:56.90,JP,,0,0,0,,«Пломба»
Dialogue: 0,0:19:58.31,0:20:02.45,JP,,0,0,0,,Мені жек көр, кешір мені,бас тарт.
Dialogue: 0,0:20:02.80,0:20:06.97,JP,,0,0,0,,Менің адам әлемін қорғау үшін жасаған айуандық әрекеттерім
Dialogue: 0,0:20:08.93,0:20:14.40,JP,,0,0,0,,999 типті Мәңгілік табыт түрмесі
Dialogue: 0,0:20:27.27,0:20:30.36,JP,,0,0,0,,Ешкім үндеген жоқ.
Dialogue: 0,0:20:31.64,0:20:35.68,JP,,0,0,0,,Бұл аға сыныптың қандас туысының күші.
Dialogue: 0,0:20:39.42,0:20:44.53,JP,,0,0,0,,Тұңғиық түбінде осындай мыңға жуық заттар жасырынып жатыр.
Dialogue: 0,0:20:45.39,0:20:49.19,JP,,0,0,0,,Бүгін аман қалсақ та,ертең не болады?
Dialogue: 0,0:20:57.69,0:20:58.77,JP,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:59.38,0:21:00.36,JP,,0,0,0,,Ол сөзсіз осында—
Dialogue: 0,0:21:02.13,0:21:03.95,JP,,0,0,0,,Кері қайтаруға үміт аз
Dialogue: 0,0:21:04.34,0:21:07.93,JP,,0,0,0,,Күйзелісті қазір жеңсеңіз де,ертеңгі күніңіздің қандай болатынын білмейсіз.
Dialogue: 0,0:21:09.65,0:21:12.23,JP,,0,0,0,,Бірақ бұл адамдар біледі
Dialogue: 0,0:21:13.04,0:21:19.25,JP,,0,0,0,,Фактілерге батып кету мен бас тартудың айырмашылығы бар.
Dialogue: 0,0:21:30.20,0:21:32.18,JP,,0,0,0,,Сіз де солайсыз ба?
Dialogue: 0,0:21:33.45,0:21:35.09,JP,,0,0,0,,Мен оны сіз де көре аласыз деп ойлаймын.
Dialogue: 0,0:21:39.94,0:21:40.94,JP,,0,0,0,,Түстен кейін Фудзисаваға қайтасың да, мектепке барасың,иә?
Dialogue: 0,0:21:43.14,0:21:43.34,JP,,0,0,0,,696-санды тұтқын – Мұнда не болып жатыр өзі?
Dialogue: 0,0:21:43.31,0:21:45.65,JP,,0,0,0,,Менің қандай екенімді тап
Dialogue: 0,0:21:46.91,0:21:50.36,JP,,0,0,0,,Сіз менің атымды білесіз.
Dialogue: 0,0:21:57.93,0:21:59.09,JP,,0,0,0,,Бұл
Dialogue: 0,0:22:01.30,0:22:02.34,JP,,0,0,0,,Қайтып оралмаңыз
Dialogue: 0,0:22:02.59,0:22:04.71,JP,,0,0,0,,Бірақ бәрі оны іздейді...
Dialogue: 0,0:22:04.02,0:22:05.72,JP-UP,,0,0,0,,Мен қайтып оралғым келмейді
Dialogue: 0,0:22:18.92,0:22:20.65,JP,,0,0,0,,Әй,қалайсың?
Dialogue: 0,0:22:20.85,0:22:24.16,JP,,0,0,0,,Сен әлі ақымақ істер істеп жатырсың,Фемто.
Dialogue: 0,0:22:24.37,0:22:25.26,JP,,0,0,0,,Бұл менмін
Dialogue: 0,0:22:25.78,0:22:29.51,JP,,0,0,0,,Сіздің досыңыз - Үмітсіздік патшасы.
Dialogue: 0,0:24:11.54,0:24:14.26,JP,,0,0,0,,Не айтып тұрғаныңызды түсінбеймін.
Dialogue: 0,0:24:14.34,0:24:15.83,JP,,0,0,0,,Оған көмектесу мүмкін емес,мынаны же.
Dialogue: 0,0:24:16.26,0:24:18.97,JP,,0,0,0,,Басқа әлемде шығарылған сәл жұмбақ конняку.
Dialogue: 0,0:24:18.97,0:24:19.93,JP,,0,0,0,,Егер сіз мынаны жесеңіз...
Dialogue: 0,0:24:20.14,0:24:23.81,JP,,0,0,0,,Келесі қанды блокада шайқасы: Шокерлік қан балғасы
Dialogue: 0,0:24:23.84,0:24:25.62,JP,,0,0,0,,Келесі сіз боласыз.
Dialogue: 0,0:24:25.62,0:24:27.19,JP,,0,0,0,,Мынау бар.
Dialogue: 0,0:24:27.19,0:24:28.83,JP,,0,0,0,,екінші Кира тек бет-әлпетке қарап кісі өлтіре алатынын көрсетеді.
Dialogue: 0,0:09:25.57,0:09:31.25,JP,,0,0,0,,Он үш ақсақалдар
Dialogue: 0,0:13:09.56,0:13:15.52,JP,,0,0,0,,Он үш ақсақалдар
Dialogue: 0,0:16:17.38,0:16:19.85,JP,,0,0,0,,Қан оқтары өнері
Dialogue: 0,0:16:27.29,0:16:30.67,JP,,0,0,0,,Espada del Cerro Absolute
Dialogue: 0,0:19:00.70,0:19:03.53,JP,,0,0,0,,Құбыжық
Dialogue: 0,0:19:25.63,0:19:30.03,JP,,0,0,0,,Ақсақалдар
Dialogue: 0,0:20:08.93,0:20:14.40,JP,,0,0,0,,Ewigkeitgefengnis
Dialogue: 0,0:20:31.64,0:20:35.68,JP,,0,0,0,,Үлкен қанды тұқым
Dialogue: 0,0:24:20.14,0:24:23.81,JP,,0,0,0,,Қанды балға
Dialogue: 0,0:24:30.33,0:24:36.33,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
