Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.76,0:00:17.51,Default,,0,0,0,,Өзіңізді жақсы сезінген сияқтысыз.
Dialogue: 0,0:00:17.60,0:00:20.52,Default,,0,0,0,,Басқа қызметші
Dialogue: 0,0:00:22.06,0:00:23.85,Default,,0,0,0,,Кез келген уақытта бара аласыз
Dialogue: 0,0:00:24.52,0:00:27.02,Default,,0,0,0,,Кез келген уақытта жойылуы мүмкін
Dialogue: 0,0:00:27.11,0:00:32.40,Default,,0,0,0,,Ештеңе жасамаған 20 жас шамасындағы әлеуметтік қоқыс...
Dialogue: 0,0:00:32.49,0:00:35.32,Default,,0,0,0,,Маған не көрсетесіз?
Dialogue: 0,0:00:35.41,0:00:37.45,Default,,0,0,0,,Өлім ағашының жерлеу рәсімі
Dialogue: 0,0:00:37.53,0:00:39.66,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:00:42.16,0:00:47.50,Default,,0,0,0,,Ұстазым екеуіңіз кездескенге дейін не болғаны есімде жоқ.
Dialogue: 0,0:00:47.59,0:00:50.63,Default,,0,0,0,,А, мен өте жақсы білемін.
Dialogue: 0,0:00:50.71,0:00:51.92,Default,,0,0,0,,Бірақ
Dialogue: 0,0:00:52.63,0:00:57.30,Default,,0,0,0,,Әркімге киінсең, Ашу қайнайды.
Dialogue: 0,0:00:57.39,0:00:59.64,Default,,0,0,0,,Мен бұл туралы ойладым.
Dialogue: 0,0:00:59.72,0:01:02.31,Default,,0,0,0,,Сол күннен бастап
Dialogue: 0,0:01:03.35,0:01:07.77,Default,,0,0,0,,Маған ешкім көмектеспеді.
Dialogue: 0,0:01:08.36,0:01:09.98,Default,,0,0,0,,Бұл қиын болды.
Dialogue: 0,0:01:10.07,0:01:12.11,Default,,0,0,0,,Шимура Тенкун
Dialogue: 0,0:01:12.19,0:01:16.16,Default,,0,0,0,,Қорқынышты болды, ауырды.
Dialogue: 0,0:01:16.74,0:01:19.62,Default,,0,0,0,,Ол көмекке жүгірер еді.
Dialogue: 0,0:01:20.49,0:01:22.62,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:01:22.70,0:01:24.37,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:01:24.46,0:01:25.83,Default,,0,0,0,,«Батыр»
Dialogue: 0,0:01:25.92,0:01:28.00,Default,,0,0,0,,«Осындай күндердің бірінде батыр»
Dialogue: 0,0:01:28.54,0:01:32.42,Default,,0,0,0,,Міне, бәрі сені көрмегендей кейіп танытты.
Dialogue: 0,0:01:32.51,0:01:36.05,Default,,0,0,0,,Бұны мұндай әлемге кім салды?
Dialogue: 0,0:01:36.88,0:01:37.97,Default,,0,0,0,,(Доғаның айқайы)
Dialogue: 0,0:01:38.05,0:01:39.85,Default,,0,0,0,,Енді бәрі жақсы
Dialogue: 0,0:01:40.68,0:01:42.26,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:01:43.85,0:01:46.56,Default,,0,0,0,,Батырлар қоғамы күйреді де
Dialogue: 0,0:01:46.64,0:01:48.94,Default,,0,0,0,,Сахна артында қожайын болсаң да
Dialogue: 0,0:01:49.02,0:01:51.86,Default,,0,0,0,,Бұл жетекші ешқашан кетпейді
Dialogue: 0,0:01:51.94,0:01:56.45,Default,,0,0,0,,Иә, мен бәрін жек көремін.
Dialogue: 0,0:01:56.53,0:01:59.82,Default,,0,0,0,,Тыныс алатынның бәрі мені тітіркендіреді
Dialogue: 0,0:02:00.37,0:02:04.04,Default,,0,0,0,,Жарайды, барлығын бірден құртайық.
Dialogue: 0,0:02:04.12,0:02:07.83,Default,,0,0,0,,Сіз әлемдегі ең әдемі көкжиекті көре аласыз.
Dialogue: 0,0:02:07.92,0:02:10.92,Default,,0,0,0,,Ендеше, дәрігер, маған қол ұшын беріңіз.
Dialogue: 0,0:02:11.00,0:02:13.92,Default,,0,0,0,,Мен саған тозақтан жұмаққа дейін көрсетемін
Dialogue: 0,0:02:14.00,0:02:18.63,Default,,0,0,0,,♪～
Dialogue: 0,0:03:38.92,0:03:43.93,Default,,0,0,0,,～♪
Dialogue: 0,0:03:44.55,0:03:47.14,Default,,0,0,0,,Сол үйден басталды
Dialogue: 0,0:03:47.81,0:03:53.56,Default,,0,0,0,,Азғантай өшпенділік!
Dialogue: 0,0:03:53.65,0:03:54.31,Default,,0,0,0,,Қайтадан батыр ойнайсыз ба?
Dialogue: 0,0:03:54.31,0:03:55.40,Default,,0,0,0,,Қайтадан батыр ойнайсыз ба?
Dialogue: 0,0:03:54.31,0:03:55.40,Default,,0,0,0,,(Доғаның айқайы)
Dialogue: 0,0:03:55.40,0:03:55.48,Default,,0,0,0,,(Доғаның айқайы)
Dialogue: 0,0:03:55.48,0:03:56.11,Default,,0,0,0,,(Доғаның айқайы)
Dialogue: 0,0:03:55.48,0:03:56.11,Default,,0,0,0,,Коутару-сан, тоқтат! Мұндай зорлық-зомбылықты доғар!
Dialogue: 0,0:03:56.11,0:03:56.19,Default,,0,0,0,,Акутаро-сан, тоқта, зорлық көрсетуді доғар!
Dialogue: 0,0:03:56.19,0:03:57.98,Default,,0,0,0,,Коутару-сан, тоқта, зорлық көрсетуді доғар!
Dialogue: 0,0:03:56.19,0:03:57.98,Default,,0,0,0,,О, жоқ, эй, ой
Dialogue: 0,0:03:57.98,0:03:58.07,Default,,0,0,0,,О, жоқ, эй, ой
Dialogue: 0,0:03:58.07,0:04:00.07,Default,,0,0,0,,О, жоқ, эй, ой
Dialogue: 0,0:03:58.07,0:04:00.07,Default,,0,0,0,,Егер сізге ұнамаса, тыңдаңыз.
Dialogue: 0,0:04:00.07,0:04:00.15,Default,,0,0,0,,Егер сізге ұнамаса, тыңдаңыз.
Dialogue: 0,0:04:00.15,0:04:00.53,Default,,0,0,0,,Егер сізге ұнамаса, тыңдаңыз.
Dialogue: 0,0:04:00.15,0:04:00.53,Default,,0,0,0,,Әке Жоқ!
Dialogue: 0,0:04:00.53,0:04:00.61,Default,,0,0,0,,Әке Жоқ!
Dialogue: 0,0:04:00.61,0:04:01.70,Default,,0,0,0,,Әке, жоқ!
Dialogue: 0,0:04:00.61,0:04:01.70,Default,,0,0,0,,Акутаро мырза!
Dialogue: 0,0:04:01.70,0:04:02.45,Default,,0,0,0,,Әке, жоқ!
Dialogue: 0,0:04:02.53,0:04:04.70,Default,,0,0,0,,Біздің үйде ережелер болды.
Dialogue: 0,0:04:05.41,0:04:08.66,Default,,0,0,0,,Әкем қойған бір ғана ереже
Dialogue: 0,0:04:08.74,0:04:10.91,Default,,0,0,0,,Батырлар туралы айтпау
Dialogue: 0,0:04:11.00,0:04:13.12,Default,,0,0,0,,Бұл құпия (өтпелі) иә?
Dialogue: 0,0:04:13.71,0:04:15.96,Default,,0,0,0,,Бұл адам менің әжем.
Dialogue: 0,0:04:16.54,0:04:18.34,Default,,0,0,0,,Ол батыр.
Dialogue: 0,0:04:18.42,0:04:21.09,Default,,0,0,0,,Хана-чан, сен неге маған бұлай істейсің?
Dialogue: 0,0:04:21.17,0:04:24.72,Default,,0,0,0,,Әкем иә дейді, бірақ бәрібір.
Dialogue: 0,0:04:25.43,0:04:27.97,Default,,0,0,0,,Мен доғаның тамырын басып жатырмын.
Dialogue: 0,0:04:28.06,0:04:32.10,Default,,0,0,0,,Әкеміз жоқ ағайын батыр болайық
Dialogue: 0,0:04:32.18,0:04:34.10,Default,,0,0,0,,(Юки) Бірақ Хори, сен мықтысың ғой, иә? (Хидэ Иура) Һмм…
Dialogue: 0,0:04:37.36,0:04:38.23,Default,,0,0,0,,Айналмалы доға! (доға)
Dialogue: 0,0:04:38.32,0:04:40.44,Default,,0,0,0,,Сіз оқуға кірдіңіз!?
Dialogue: 0,0:04:41.19,0:04:42.49,Default,,0,0,0,,Мен оны көрдім.
Dialogue: 0,0:04:44.45,0:04:45.41,Default,,0,0,0,,Доға...
Dialogue: 0,0:04:45.49,0:04:48.99,Default,,0,0,0,,Мен доғаны көргім келетінін айттым!
Dialogue: 0,0:04:50.37,0:04:51.41,Default,,0,0,0,,Акутаро мырза!
Dialogue: 0,0:04:52.62,0:04:54.54,Default,,0,0,0,,Бұл әже емес
Dialogue: 0,0:04:55.29,0:04:56.92,Default,,0,0,0,,Баланы тастап кеткен -
Dialogue: 0,0:04:57.75,0:04:59.67,Default,,0,0,0,,Бұл аң.
Dialogue: 0,0:04:59.75,0:05:01.05,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:05:01.71,0:05:04.55,Default,,0,0,0,,Батыр - басқаларға көмектесетін адам.
Dialogue: 0,0:05:04.63,0:05:07.22,Default,,0,0,0,,Сіз менің отбасымды ренжітіп жатырсыз!
Dialogue: 0,0:05:07.30,0:05:09.30,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:05:09.39,0:05:11.89,Default,,0,0,0,,Маған ұнамайды... Уф
Dialogue: 0,0:05:11.97,0:05:14.31,Default,,0,0,0,,Мен мұнымен біттім
Dialogue: 0,0:05:14.39,0:05:17.10,Default,,0,0,0,,Мон-чан I...
Dialogue: 0,0:05:17.19,0:05:17.90,Default,,0,0,0,,(тері тырнаған дыбыс)
Dialogue: 0,0:05:17.90,0:05:19.48,Default,,0,0,0,,(тері тырналған дыбыс)
Dialogue: 0,0:05:17.90,0:05:19.48,Default,,0,0,0,,Артық емес
Dialogue: 0,0:05:19.48,0:05:19.57,Default,,0,0,0,,(тері тырналған дыбыс)
Dialogue: 0,0:05:19.57,0:05:20.61,Default,,0,0,0,,(тері тырналған дыбыс)
Dialogue: 0,0:05:19.57,0:05:20.61,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:05:20.61,0:05:20.69,Default,,0,0,0,,(Тері тырналған дыбыс)
Dialogue: 0,0:05:20.69,0:05:21.65,Default,,0,0,0,,(тері тырналған дыбыс)
Dialogue: 0,0:05:20.69,0:05:21.65,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:05:21.65,0:05:21.73,Default,,0,0,0,,(тері тырнаған дыбыс)
Dialogue: 0,0:05:21.73,0:05:23.82,Default,,0,0,0,,(тері тырналған дыбыс)
Dialogue: 0,0:05:21.73,0:05:23.82,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:05:23.90,0:05:25.24,Default,,0,0,0,,(Дүйсенбінің айқайы)
Dialogue: 0,0:05:25.32,0:05:26.70,Default,,0,0,0,,Мен оны жек көремін
Dialogue: 0,0:05:33.50,0:05:34.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:35.12,0:05:37.92,Default,,0,0,0,,Мон-чан? Апыр-ай!
Dialogue: 0,0:05:38.00,0:05:41.46,Default,,0,0,0,,Не? Ха ха ха э? Ха ха ха
Dialogue: 0,0:05:41.55,0:05:42.84,Default,,0,0,0,,Доға (домалау) соққысы
Dialogue: 0,0:05:44.34,0:05:45.97,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:48.80,0:05:50.14,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:05:52.22,0:05:56.52,Default,,0,0,0,,Тоқта, барма, мен дыбыс шығара алмаймын, Хана-чан!
Dialogue: 0,0:05:56.60,0:05:59.48,Default,,0,0,0,,Сіз кешірім сұрауға келдіңіз, солай ма?
Dialogue: 0,0:05:59.56,0:06:03.90,Default,,0,0,0,,Олай болса бұл жолы мені қорғап, көмектес!
Dialogue: 0,0:06:09.91,0:06:12.74,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,0:06:15.70,0:06:17.41,Default,,0,0,0,,(Жер жарылған дыбыс)
Dialogue: 0,0:06:20.63,0:06:22.42,Default,,0,0,0,,Ах… Ух…
Dialogue: 0,0:06:29.13,0:06:30.93,Default,,0,0,0,,Мен бәрін жек көремін
Dialogue: 0,0:06:33.68,0:06:35.14,Default,,0,0,0,,Айналмалы доға…
Dialogue: 0,0:06:48.40,0:06:49.82,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:06:56.50,0:06:58.75,Default,,0,0,0,,Өл!
Dialogue: 0,0:07:07.80,0:07:09.68,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:07:09.76,0:07:14.22,Default,,0,0,0,,Көз жасыңды тый, тісіңді қайрап, қайта тудың.
Dialogue: 0,0:07:15.31,0:07:17.43,Default,,0,0,0,,Жүр, көрсетші.
Dialogue: 0,0:07:17.52,0:07:18.98,Default,,0,0,0,,Сіздің сыртқы келбетіңіз
Dialogue: 0,0:07:19.06,0:07:21.81,Default,,0,0,0,,Өлім ағашының жерлеу рәсімі
Dialogue: 0,0:07:21.90,0:07:24.69,Default,,0,0,0,,Бәрі есімде.
Dialogue: 0,0:07:25.19,0:07:28.28,Default,,0,0,0,,Мен заттарды шынымен құртып жіберемін.
Dialogue: 0,0:07:29.07,0:07:31.36,Default,,0,0,0,,Маған болашақ керек емес
Dialogue: 0,0:07:32.32,0:07:36.49,Default,,0,0,0,,Ол жерден Альянс жігіттері қалағанын жасай алады.
Dialogue: 0,0:07:37.79,0:07:40.75,Default,,0,0,0,,Маған бұлардың ешқайсысы керек емес!
Dialogue: 0,0:07:40.83,0:07:43.79,Default,,0,0,0,,Сіз боссыз
Dialogue: 0,0:07:43.88,0:07:46.21,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:07:47.25,0:07:48.71,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:07:48.80,0:07:51.38,Default,,0,0,0,,Баршаңыз да сапарыңызды жалғастырғанда абай болыңыздар
Dialogue: 0,0:07:51.47,0:07:53.80,Default,,0,0,0,,(Өлі ағаштың күлкісі)
Dialogue: 0,0:07:53.89,0:07:55.43,Default,,0,0,0,,Бұзыңыз!
Dialogue: 0,0:08:15.49,0:08:16.99,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:08:17.08,0:08:20.20,Default,,0,0,0,,Білесіз бе, кешіріңіз, бұл дұрыс емес.
Dialogue: 0,0:08:20.29,0:08:23.92,Default,,0,0,0,,Бұл құпия екенін саған айтып, көрсеткен мен едім.
Dialogue: 0,0:08:24.63,0:08:29.09,Default,,0,0,0,,А... Жарайды, жарайды.
Dialogue: 0,0:08:29.88,0:08:31.26,Default,,0,0,0,,Сәлем, Тэнку
Dialogue: 0,0:08:32.13,0:08:34.76,Default,,0,0,0,,Сіз әлі де батыр болғыңыз келе ме?
Dialogue: 0,0:08:36.76,0:08:40.72,Default,,0,0,0,,Мен сенің не нәрсеге аллергияң бар екенін білмеймін.
Dialogue: 0,0:08:40.81,0:08:43.98,Default,,0,0,0,,Енді бәрі жақсы, мама.
Dialogue: 0,0:08:44.06,0:08:45.56,Default,,0,0,0,,Айналмалы доға!
Dialogue: 0,0:08:45.65,0:08:47.23,Default,,0,0,0,,Сіз оқуға кірдіңіз!?
Dialogue: 0,0:08:48.02,0:08:49.27,Default,,0,0,0,,Иә
Dialogue: 0,0:08:58.70,0:09:00.29,Default,,0,0,0,,Көңіл айту
Dialogue: 0,0:09:03.41,0:09:07.21,Default,,0,0,0,,Мұғалім, сіз Курогириге ұқсай бастадыңыз.
Dialogue: 0,0:09:07.96,0:09:09.50,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:09:09.59,0:09:11.96,Default,,0,0,0,,Жеңілістің алдын ала отырып, ол
Dialogue: 0,0:09:12.05,0:09:14.59,Default,,0,0,0,,Мен мұрагеріме бәрін сеніп тапсырдым.
Dialogue: 0,0:09:14.68,0:09:17.97,Default,,0,0,0,,Мен өзімнің «даралығымды» тапсыруды ұйғардым.
Dialogue: 0,0:09:18.05,0:09:20.43,Default,,0,0,0,,Өзіңіздің қайталанатын «тұлғаңызды» қосыңыз
Dialogue: 0,0:09:21.01,0:09:25.39,Default,,0,0,0,,Түпнұсқаны Шигараги Соуға беруді жөн көрдім.
Dialogue: 0,0:09:26.73,0:09:27.69,Default,,0,0,0,,Он доға!
Dialogue: 0,0:09:30.65,0:09:32.32,Default,,0,0,0,,Ішімде…
Dialogue: 0,0:09:42.20,0:09:43.29,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:09:45.12,0:09:47.54,Default,,0,0,0,,Мені жоққа шығарма
Dialogue: 0,0:09:50.04,0:09:53.63,Default,,0,0,0,,Сіз білмей тұрып, айналаңыз құлады.
Dialogue: 0,0:09:54.84,0:09:58.59,Default,,0,0,0,,Мен не істеуім керек екенін есіме түсірдім.
Dialogue: 0,0:10:01.26,0:10:02.72,Default,,0,0,0,,Өлі ағаш!
Dialogue: 0,0:10:02.81,0:10:06.60,Default,,0,0,0,,Ей, мен ерте тұрып, 1-ші едім.
Dialogue: 0,0:10:06.69,0:10:08.10,Default,,0,0,0,,Ағын…
Dialogue: 0,0:10:08.19,0:10:09.27,Default,,0,0,0,,Уф
Dialogue: 0,0:10:09.98,0:10:15.24,Default,,0,0,0,,Алдағы төрт айда тозақ азабы жалғасады.
Dialogue: 0,0:10:15.32,0:10:20.20,Default,,0,0,0,,Оны жеңсең, бәрі алақанда болады.
Dialogue: 0,0:10:23.20,0:10:25.70,Default,,0,0,0,,«Біреуі бәрі үшін»...
Dialogue: 0,0:10:25.79,0:10:29.08,Default,,0,0,0,,Барлығы бір үшін қалаған нәрселерден
Dialogue: 0,0:10:29.17,0:10:33.59,Default,,0,0,0,,Бұл менің жолымнан өтпеген жалғыз күш.
Dialogue: 0,0:10:34.88,0:10:37.51,Default,,0,0,0,,Шигараки мені нысанаға алуы мүмкін.
Dialogue: 0,0:10:39.55,0:10:42.10,Default,,0,0,0,,Өлі ағаш Декуды қуып келе жатыр!?
Dialogue: 0,0:10:43.85,0:10:44.81,Default,,0,0,0,,Бұл сезім
Dialogue: 0,0:10:45.81,0:10:47.81,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:10:50.31,0:10:51.86,Default,,0,0,0,,Уф... (Бакуго) Уф.
Dialogue: 0,0:10:57.57,0:11:02.70,Default,,0,0,0,,Менің басымда жаңғырық, «Ал» деп.
Dialogue: 0,0:11:05.99,0:11:10.62,Default,,0,0,0,,Маған «Барлығы үшін бір» Изуку Мидория беріңіз
Dialogue: 0,0:11:11.58,0:11:17.05,Default,,0,0,0,,Мендік бол, інім.
Dialogue: 0,0:11:17.13,0:11:18.51,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:18.59,0:11:20.84,Default,,0,0,0,,Дегенмен, оның уақытша жүргізуші куәлігіне арналған қосымша сабақтары қиын екен—
Dialogue: 0,0:11:22.84,0:11:27.06,Default,,0,0,0,,інісі? Жоқ, мен сөйлеспеймін.
Dialogue: 0,0:11:27.14,0:11:31.06,Default,,0,0,0,,Мен тым күштімін, мұғалім.
Dialogue: 0,0:11:31.14,0:11:34.56,Default,,0,0,0,,Бұл менің күшім, бұл менің денем
Dialogue: 0,0:11:34.65,0:11:38.99,Default,,0,0,0,,Мені өсіру үшін жасаған барлық істеріңіз үшін шынымен ризамын.
Dialogue: 0,0:11:39.07,0:11:42.66,Default,,0,0,0,,Бірақ мен сен сияқты болғым келмейді.
Dialogue: 0,0:11:43.28,0:11:45.83,Default,,0,0,0,,Мен сенен артық болғым келеді
Dialogue: 0,0:11:45.91,0:11:49.66,Default,,0,0,0,,Олай болса үндемеңіз.
Dialogue: 0,0:11:49.75,0:11:52.96,Default,,0,0,0,,Бұл менің еркім.
Dialogue: 0,0:11:54.38,0:11:59.84,Default,,0,0,0,,Сіз қоғамды қорғаймын деп жүрдіңіз.
Dialogue: 0,0:12:00.92,0:12:03.51,Default,,0,0,0,,өткен көптеген ұрпақтар
Dialogue: 0,0:12:04.55,0:12:07.81,Default,,0,0,0,,Мен қорғай алмағанды көрмеймін деп
Dialogue: 0,0:12:07.89,0:12:10.60,Default,,0,0,0,,Зақымдалған жерді қақпақпен жабыңыз.
Dialogue: 0,0:12:10.68,0:12:14.06,Default,,0,0,0,,Мен ұятсыз бірдеңе құрастырдым.
Dialogue: 0,0:12:15.36,0:12:17.65,Default,,0,0,0,,Осы уақытқа дейін көргенімнің бәрі
Dialogue: 0,0:12:18.57,0:12:22.53,Default,,0,0,0,,Сіз жасаған барлық нәрсе жоққа шығарылды.
Dialogue: 0,0:12:23.32,0:12:26.95,Default,,0,0,0,,Сондықтан бұл да жоққа шығарылады.
Dialogue: 0,0:12:27.03,0:12:31.54,Default,,0,0,0,,Сондықтан мен оны бұзамын, сондықтан мен қуат аламын
Dialogue: 0,0:12:31.62,0:12:33.33,Default,,0,0,0,,Қарапайым, солай ма?
Dialogue: 0,0:12:34.08,0:12:37.29,Default,,0,0,0,,Ха... Түсінбесең жарайды.
Dialogue: 0,0:12:38.00,0:12:41.67,Default,,0,0,0,,Қолынан келмейтіндіктен, оларды «батырлар» және «жаулар (жауыздар)» деп атайды.
Dialogue: 0,0:12:44.22,0:12:47.10,Default,,0,0,0,,Қорғаудан басқа не бар?
Dialogue: 0,0:12:47.18,0:12:52.93,Default,,0,0,0,,Қанша кейінге қалдыруға тырыссаң да, сені күтіп тұрғанның бәрі жойылу.
Dialogue: 0,0:13:02.61,0:13:05.95,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:13:06.99,0:13:07.95,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:13:09.74,0:13:10.70,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:12.04,0:13:13.33,Default,,0,0,0,,Цк
Dialogue: 0,0:13:14.04,0:13:16.21,Default,,0,0,0,,5 «Қара қамшы»!
Dialogue: 0,0:13:18.34,0:13:20.25,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:20.88,0:13:23.01,Default,,0,0,0,,Сіздің есіңізде не қалды?
Dialogue: 0,0:13:29.10,0:13:29.93,Default,,0,0,0,,Ха~ ха ха ха ха! Қандай бет-әлпет ол?
Dialogue: 0,0:13:31.10,0:13:32.52,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:35.60,0:13:38.40,Default,,0,0,0,,Бүгінгі шайқаста
Dialogue: 0,0:13:38.48,0:13:41.98,Default,,0,0,0,,Қан бекер төгілсе де
Dialogue: 0,0:13:42.07,0:13:46.15,Default,,0,0,0,,Бұл ең ысырапшыл болды.
Dialogue: 0,0:14:00.46,0:14:02.96,Default,,0,0,0,,Болдырмау
Dialogue: 0,0:14:06.26,0:14:08.76,Default,,0,0,0,,Соңында тоқталды
Dialogue: 0,0:14:09.34,0:14:10.64,Default,,0,0,0,,Га
Dialogue: 0,0:14:12.51,0:14:15.85,Default,,0,0,0,,...
Dialogue: 0,0:14:15.93,0:14:16.85,Default,,0,0,0,,Ах
Dialogue: 0,0:14:24.11,0:14:26.03,Default,,0,0,0,,Өлім үлгісі…
Dialogue: 0,0:14:26.11,0:14:28.95,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:14:29.03,0:14:31.87,Default,,0,0,0,,Шық... Келме...
Dialogue: 0,0:14:31.95,0:14:34.66,Default,,0,0,0,,Осыны айтып, көңіл айту
Dialogue: 0,0:14:35.25,0:14:39.83,Default,,0,0,0,,Мен саған көмектеспесем, көмірге айналып өлетін едің.
Dialogue: 0,0:14:39.92,0:14:42.71,Default,,0,0,0,,Тірі қалған күнде де құлап өлетін еді.
Dialogue: 0,0:14:42.79,0:14:46.67,Default,,0,0,0,,Мен саған үндеме дедім, мұғалім.
Dialogue: 0,0:14:47.17,0:14:50.30,Default,,0,0,0,,Бұл менің еркім
Dialogue: 0,0:14:50.39,0:14:51.80,Default,,0,0,0,,Бұл менің арманым
Dialogue: 0,0:14:55.60,0:14:56.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:57.39,0:14:59.02,Default,,0,0,0,,Гррррр... gggg...
Dialogue: 0,0:14:59.10,0:15:02.61,Default,,0,0,0,,Сіз бұл дүниеде әлі қозғала алмайсыз.
Dialogue: 0,0:15:02.69,0:15:06.48,Default,,0,0,0,,Сонымен, біз бұл туралы бірдеңе жасаймыз.
Dialogue: 0,0:15:11.70,0:15:16.75,Default,,0,0,0,,Өлген соң тағы кездесеміз бе, Бәрі бір үшін
Dialogue: 0,0:15:16.83,0:15:18.83,Default,,0,0,0,,Жерлеу рәсімін қараңыз.
Dialogue: 0,0:15:18.91,0:15:21.67,Default,,0,0,0,,Бұл керемет. Ол өлді.
Dialogue: 0,0:15:21.75,0:15:27.46,Default,,0,0,0,,Сенің әжең, қабілетсіз және аянышты Нана Шимура сонда.
Dialogue: 0,0:15:28.55,0:15:30.22,Default,,0,0,0,,Сен неге...
Dialogue: 0,0:15:30.30,0:15:32.93,Default,,0,0,0,,Сіз Акутаросыз...
Dialogue: 0,0:15:33.60,0:15:36.35,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,0:15:36.43,0:15:38.27,Default,,0,0,0,,Аударма былай
Dialogue: 0,0:15:39.02,0:15:41.27,Default,,0,0,0,,Уайымдамаңыз, әже.
Dialogue: 0,0:15:41.35,0:15:44.19,Default,,0,0,0,,Мен де сені жек көремін.
Dialogue: 0,0:15:44.86,0:15:46.11,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:46.19,0:15:47.73,Default,,0,0,0,,Эрозияға ұшырады!
Dialogue: 0,0:15:48.99,0:15:53.20,Default,,0,0,0,,Жақсы қайғы, Сеземін сенің жек көруіңді.
Dialogue: 0,0:15:53.28,0:15:57.33,Default,,0,0,0,,Меншік иесінің еркімен ғана қозғала алатын «біреуі бәрі үшін» принципі.
Dialogue: 0,0:15:57.41,0:16:01.41,Default,,0,0,0,,Сіздің ашуыңыз енді басыла бастады.
Dialogue: 0,0:16:01.50,0:16:02.67,Default,,0,0,0,,Ах
Dialogue: 0,0:16:04.29,0:16:05.63,Default,,0,0,0,,Ах (Изуку) Ха...
Dialogue: 0,0:16:05.71,0:16:08.34,Default,,0,0,0,,Бірақ бұл әлі де жеткіліксіз сияқты.
Dialogue: 0,0:16:09.34,0:16:12.84,Default,,0,0,0,,Менің інім мен сияқты қыңыр.
Dialogue: 0,0:16:12.93,0:16:15.60,Default,,0,0,0,,Келесісі осы ма, ағайын?
Dialogue: 0,0:16:16.10,0:16:19.47,Default,,0,0,0,,Сен менікі емессің кінәлі.
Dialogue: 0,0:16:20.23,0:16:23.35,Default,,0,0,0,,Біз ол жаққа бармаймыз.
Dialogue: 0,0:16:23.44,0:16:26.82,Default,,0,0,0,,Біз осы баланың ішінде болуды таңдадық.
Dialogue: 0,0:16:28.73,0:16:31.99,Default,,0,0,0,,Бауырым, сен таңдадың ба?
Dialogue: 0,0:16:33.49,0:16:37.53,Default,,0,0,0,,Батыраңқы болмаңыз, түсіндіңіз бе?
Dialogue: 0,0:16:37.62,0:16:42.37,Default,,0,0,0,,Бұл сәтсіздікке ұшырағандықтан, оны беру қате болды!
Dialogue: 0,0:16:42.46,0:16:44.21,Default,,0,0,0,,Қате емес
Dialogue: 0,0:16:44.96,0:16:48.25,Default,,0,0,0,,Басқаны пайдаланатын ағайын түсінбейді.
Dialogue: 0,0:16:48.34,0:16:51.97,Default,,0,0,0,,Бұл бала қан төккенде не ойлайды?
Dialogue: 0,0:16:52.05,0:16:53.38,Default,,0,0,0,,Басқаларға ашулану
Dialogue: 0,0:16:53.47,0:16:57.89,Default,,0,0,0,,Мен басқалар үшін қолымнан келгеннің бәрін жасай аламын.
Dialogue: 0,0:16:57.97,0:17:02.23,Default,,0,0,0,,«құтқаруға» деген ессіз құштарлыққа бой алдырған бала
Dialogue: 0,0:17:02.93,0:17:05.98,Default,,0,0,0,,Біз бұл баланың артынан барамыз.
Dialogue: 0,0:17:16.16,0:17:18.62,Default,,0,0,0,,(Идзукуның айқайы)
Dialogue: 0,0:17:21.24,0:17:22.87,Default,,0,0,0,,Тағы кездескенше
Dialogue: 0,0:17:24.58,0:17:26.00,Default,,0,0,0,,Гах...
Dialogue: 0,0:17:26.62,0:17:29.67,Default,,0,0,0,,Өлі ағаш...
Dialogue: 0,0:17:29.75,0:17:32.30,Default,,0,0,0,,Кешіруге болмайды
Dialogue: 0,0:17:32.38,0:17:34.09,Default,,0,0,0,,Мен кешіре алмаймын
Dialogue: 0,0:17:34.17,0:17:35.68,Default,,0,0,0,,көрінгендей, шамамен 36 дана шығады.
Dialogue: 0,0:17:35.76,0:17:40.47,Default,,0,0,0,,Ол кезде сені бәрі бір үшін жұтқан...
Dialogue: 0,0:17:40.56,0:17:44.10,Default,,0,0,0,,Сол кезде сіз...
Dialogue: 0,0:17:44.77,0:17:47.69,Default,,0,0,0,,Сіздің бетіңіз...
Dialogue: 0,0:17:47.77,0:17:51.86,Default,,0,0,0,,Көмек сұрап тұрғандай көрінді.
Dialogue: 0,0:17:52.53,0:17:55.99,Default,,0,0,0,,Сіз Шигараки Соуды өлтіре аласыз ба?
Dialogue: 0,0:17:58.87,0:18:03.54,Default,,0,0,0,,Бұл нәрсе үлкен зұлымдыққа айналғаннан кейін оны ешкім тоқтата алмайды.
Dialogue: 0,0:18:03.62,0:18:07.21,Default,,0,0,0,,Бір-бірін кешіру, түсіну мүмкін емес.
Dialogue: 0,0:18:07.29,0:18:10.59,Default,,0,0,0,,Құтқарыла алмайтын адамдар бар.
Dialogue: 0,0:18:11.29,0:18:14.46,Default,,0,0,0,,«Көмек сұрап тұрғандай» адам
Dialogue: 0,0:18:14.55,0:18:16.97,Default,,0,0,0,,Үмітсіз адам болған кезім
Dialogue: 0,0:18:17.72,0:18:18.97,Default,,0,0,0,,Сен…
Dialogue: 0,0:18:19.05,0:18:22.72,Default,,0,0,0,,Сіз мені өлтіріп тастасаңыз да, мені тоқтатуға дайынсыз ба?
Dialogue: 0,0:18:24.77,0:18:27.60,Default,,0,0,0,,«Біреуі бәрі үшін» өлтіру күші емес.
Dialogue: 0,0:18:27.69,0:18:32.48,Default,,0,0,0,,Бүкіл Құдірет маған күш адамдарды құтқару үшін екенін үйретті.
Dialogue: 0,0:18:33.07,0:18:34.94,Default,,0,0,0,,Мен жалғыз емеспін
Dialogue: 0,0:18:35.03,0:18:38.07,Default,,0,0,0,,Құдіреті күшті және әркім өсірген күш
Dialogue: 0,0:18:38.15,0:18:41.78,Default,,0,0,0,,Сансыз адамдардың жүрегін қолдадым деп есептеймін.
Dialogue: 0,0:18:41.87,0:18:44.24,Default,,0,0,0,,Бастысы өлтіретін күш болса да
Dialogue: 0,0:18:46.12,0:18:48.46,Default,,0,0,0,,Осы шығарманы айналдыру үшін өз өмірін қатерге тіккен әрбір адамға рахмет.
Dialogue: 0,0:18:49.54,0:18:52.75,Default,,0,0,0,,Енді оның тағы бір үлкен мағынасы бар.
Dialogue: 0,0:18:54.38,0:18:57.84,Default,,0,0,0,,Оны өлтіріп, тоқтатудан басқа амал жоқ шығар.
Dialogue: 0,0:18:57.92,0:19:00.80,Default,,0,0,0,,Мен нақты не істеу керектігін білмесем де
Dialogue: 0,0:19:04.18,0:19:06.06,Default,,0,0,0,,Мен ол баланы құтқарғым келеді!
Dialogue: 0,0:19:06.68,0:19:08.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:09.98,0:19:11.60,Default,,0,0,0,,Иә
Dialogue: 0,0:19:11.69,0:19:13.86,Default,,0,0,0,,Сол себепті мен сізге еремін
Dialogue: 0,0:19:13.94,0:19:18.57,Default,,0,0,0,,«Біріміз бәріміз үшін» фильмінің сіздерге өткеніне өте қуаныштымын.
Dialogue: 0,0:19:19.28,0:19:22.20,Default,,0,0,0,,Мүмкіндігінше ынтымақтастықта болыңыз.
Dialogue: 0,0:19:23.74,0:19:27.29,Default,,0,0,0,,Мені алдымен Манава-кун босатып алды.
Dialogue: 0,0:19:27.37,0:19:29.37,Default,,0,0,0,,Келесі, Шиномори-кун
Dialogue: 0,0:19:29.46,0:19:30.96,Default,,0,0,0,,Шимура-кун да
Dialogue: 0,0:19:31.04,0:19:33.08,Default,,0,0,0,,Смок-кун да келіседі.
Dialogue: 0,0:19:33.17,0:19:36.38,Default,,0,0,0,,Тоғызыншы ұрпақтың күшін толығымен босату
Dialogue: 0,0:19:37.30,0:19:40.47,Default,,0,0,0,,Сіз шынымен де сол баламен бітемін деп ойлайсыз ба?
Dialogue: 0,0:19:40.55,0:19:41.76,Default,,0,0,0,,О
Dialogue: 0,0:19:41.84,0:19:45.43,Default,,0,0,0,,«Біреу – бәрі үшін» дегеннің түп-төркіні – ағайынға берілмеу.
Dialogue: 0,0:19:46.72,0:19:51.27,Default,,0,0,0,,Бірақ сол кезде сен қолыңды создың.
Dialogue: 0,0:19:51.35,0:19:53.73,Default,,0,0,0,,«Біріміз бәріміз үшін» басталды
Dialogue: 0,0:20:04.20,0:20:06.41,Default,,0,0,0,,Қалай екенін білмесеңіз де
Dialogue: 0,0:20:07.16,0:20:09.75,Default,,0,0,0,,Тіпті соғысу керек болса да
Dialogue: 0,0:20:10.50,0:20:12.21,Default,,0,0,0,,Сонда да мен...
Dialogue: 0,0:20:12.29,0:20:14.96,Default,,0,0,0,,Сахна қойылды!
Dialogue: 0,0:20:15.04,0:20:17.38,Default,,0,0,0,,Барлығы бір үшін...
Dialogue: 0,0:20:17.46,0:20:19.51,Default,,0,0,0,,Біз нені қостық...
Dialogue: 0,0:20:19.59,0:20:21.51,Default,,0,0,0,,Осы жерге жиналыңыз...
Dialogue: 0,0:20:21.59,0:20:23.72,Default,,0,0,0,,«Біреуі бәрі үшін» күші…
Dialogue: 0,0:20:23.80,0:20:26.35,Default,,0,0,0,,Толық шығарылым!
Dialogue: 0,0:20:26.43,0:20:29.81,Default,,0,0,0,,Тыңда, балақай, біз осы жерден жылдамдаймыз.
Dialogue: 0,0:20:29.89,0:20:30.81,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:32.23,0:20:37.57,Default,,0,0,0,,Түрмеде үнемі сені ойлап жүретінмін.
Dialogue: 0,0:20:37.65,0:20:43.28,Default,,0,0,0,,Мені енді ол Удо қызықтырмайды... Бүкіл Құдірет.
Dialogue: 0,0:20:45.28,0:20:46.37,Default,,0,0,0,,үшінші курс студенті Цугата — басты фаворит болды —
Dialogue: 0,0:20:46.37,0:20:49.04,Default,,0,0,0,,үшінші курс студенті Цугата — басты фаворит болды —
Dialogue: 0,0:20:46.37,0:20:49.04,Default,,0,0,0,,Хаха...
Dialogue: 0,0:20:49.12,0:20:52.75,Default,,0,0,0,,Уайымдама, сол аңғал ойды таста.
Dialogue: 0,0:20:52.83,0:20:55.00,Default,,0,0,0,,Егер солай болса, сіз жеңе алмайсыз.
Dialogue: 0,0:20:55.08,0:20:56.79,Default,,0,0,0,,Тіпті қураған ағаштарда
Dialogue: 0,0:20:57.59,0:20:59.67,Default,,0,0,0,,Сондай-ақ Барлығы бір үшін
Dialogue: 0,0:21:02.76,0:21:04.30,Default,,0,0,0,,Мен оны тоқтатамын
Dialogue: 0,0:21:05.18,0:21:08.81,Default,,0,0,0,,Мен оны міндетті түрде тоқтатамын
Dialogue: 0,0:21:09.93,0:21:13.02,Default,,0,0,0,,Соңғы шайқас басталғалы тұр еді.
Dialogue: 0,0:21:14.27,0:21:19.07,Default,,0,0,0,,Кейде үзіліп кете жаздаған сезімдерімді тым-тырыс ұстаймын.
Dialogue: 0,0:21:19.15,0:21:20.48,Default,,0,0,0,,Оны бір етіп жасаңыз
Dialogue: 0,0:21:21.78,0:21:25.66,Default,,0,0,0,,Әркімнің болашағы мен күлкісін қалпына келтіру үшін күрес
Dialogue: 0,0:21:27.95,0:21:28.99,Default,,0,0,0,,Бірақ
Dialogue: 0,0:21:29.08,0:21:34.00,Default,,0,0,0,,Осыған дейін өткенге сәл ғана шегініс жасап, осы туралы айтқым келеді.
Dialogue: 0,0:21:35.33,0:21:40.42,Default,,0,0,0,,Мен Жапонияны Одақтан және қашқан жаудан (жауыздан) құтқаруға келдім.
Dialogue: 0,0:21:41.21,0:21:44.17,Default,,0,0,0,,Американың №1 қаһарманы
Dialogue: 0,0:21:44.26,0:21:47.14,Default,,0,0,0,,Жұлдыздар мен жолақтар туралы
Dialogue: 0,0:21:51.01,0:21:55.69,Default,,0,0,0,,♪～
Dialogue: 0,0:23:13.97,0:23:18.98,Default,,0,0,0,,～♪
Dialogue: 0,0:23:21.69,0:23:22.90,Default,,0,0,0,,Келесі алдын ала қарау
Dialogue: 0,0:23:22.98,0:23:24.40,Default,,0,0,0,,Барлығы мүмкін
Dialogue: 0,0:23:24.48,0:23:26.90,Default,,0,0,0,,Дүние жүзіндегі кейіпкерлерден жөнелтуді сұрау
Dialogue: 0,0:23:28.11,0:23:30.61,Default,,0,0,0,,Ұлттық көшбасшылардың жауап беруді қаламағанына қарамастан
Dialogue: 0,0:23:30.70,0:23:32.91,Default,,0,0,0,,Батыр ерлік көрсетті
Dialogue: 0,0:23:34.33,0:23:38.12,Default,,0,0,0,,Американың №1 қаһарман жұлдыздары мен жолақтары
Dialogue: 0,0:23:38.66,0:23:43.33,Default,,0,0,0,,Келесі жолы «Еуропа мен Американың шетінде!! Ең керемет жігіт»
Dialogue: 0,0:23:43.42,0:23:46.88,Default,,0,0,0,,Американың №1 суретінің басқа «сурет стилі» бар.
Dialogue: 0,0:23:46.96,0:23:50.88,Default,,0,0,0,,Әрі қарай!Plus Ultra!
Dialogue: 0,0:23:52.38,0:23:58.38,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
