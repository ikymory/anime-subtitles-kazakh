Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:07.73,Default,,0,0,0,,Бұл біртүрлі. Болып жатқан жоқ.
Dialogue: 0,0:00:09.03,0:00:10.57,Default,,0,0,0,,Эй, оян
Dialogue: 0,0:00:11.11,0:00:12.74,Default,,0,0,0,,Ояныңыз
Dialogue: 0,0:00:22.00,0:00:24.50,Default,,0,0,0,,Әкем ана
Dialogue: 0,0:00:33.72,0:00:34.76,Default,,0,0,0,,Тоқта
Dialogue: 0,0:00:38.10,0:00:44.35,Default,,0,0,0,,Маған көмектес, Амано-кун
Dialogue: 0,0:02:27.79,0:02:29.46,Default,,0,0,0,,Өйткені соңғы уақытта көп қиындық болды.
Dialogue: 0,0:02:29.58,0:02:30.92,Default,,0,0,0,,Үйге қайтқанда абай болыңыз
Dialogue: 0,0:02:31.08,0:02:32.63,Default,,0,0,0,,Жоғарыда
Dialogue: 0,0:02:32.84,0:02:33.71,Default,,0,0,0,,Құдай-ай, неге қыздар дәретханасында граффити жазып жүрсің өзің?!
Dialogue: 0,0:02:37.01,0:02:38.17,Default,,0,0,0,,Бүгін боссыз ба?
Dialogue: 0,0:02:38.30,0:02:39.47,Default,,0,0,0,,Сіз оны пайдалана аласыз.
Dialogue: 0,0:02:39.59,0:02:41.18,Default,,0,0,0,,Бірақ адамдар жеткіліксіз.
Dialogue: 0,0:02:41.30,0:02:43.51,Default,,0,0,0,,Барлығы бір бетте болғанша, жақсы.
Dialogue: 0,0:02:45.56,0:02:47.10,Default,,0,0,0,,Эй Амано, бұл сенсің.
Dialogue: 0,0:02:47.23,0:02:48.06,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:02:48.27,0:02:49.60,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:02:49.73,0:02:52.02,Default,,0,0,0,,Менің онымен қарым-қатынасым нашар.
Dialogue: 0,0:02:52.19,0:02:53.15,Default,,0,0,0,,Мұнда келме
Dialogue: 0,0:02:53.31,0:02:56.44,Default,,0,0,0,,Ол телефонмен ғана ойнап жүргенде не істеп жатыр?
Dialogue: 0,0:02:56.57,0:02:57.36,Default,,0,0,0,,Ойын
Dialogue: 0,0:02:57.53,0:02:59.65,Default,,0,0,0,,Жоқ, мен күнделік жүргіземін.
Dialogue: 0,0:03:02.78,0:03:03.66,Default,,0,0,0,,Агацума
Dialogue: 0,0:03:03.83,0:03:07.29,Default,,0,0,0,,Осы баспаны кейінірек қызметкерлер бөлмесіне жеткізе аласыз ба?
Dialogue: 0,0:03:07.41,0:03:09.46,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:03:09.54,0:03:12.88,Default,,0,0,0,,Сондай-ақ, кітапханашыға көмектесіңіз.
Dialogue: 0,0:03:12.92,0:03:13.50,Default,,0,0,0,,Иә
Dialogue: 0,0:03:21.55,0:03:23.34,Default,,0,0,0,,Мен әрқашан бақылаушымын
Dialogue: 0,0:03:24.85,0:03:28.85,Default,,0,0,0,,Осыған қарамастан, мен бастауыш мектепте оқып жүрген кезімде, мені кейде ойнауға шақыратын.
Dialogue: 0,0:03:29.02,0:03:31.02,Default,,0,0,0,,Мен бас тартқанда солай болды.
Dialogue: 0,0:03:32.06,0:03:36.19,Default,,0,0,0,,Менің шаруам болмады, сондықтан мен күнделік жүргізе бастадым.
Dialogue: 0,0:03:37.11,0:03:39.49,Default,,0,0,0,,Көргенін жай ғана жазатын жан
Dialogue: 0,0:03:39.65,0:03:40.99,Default,,0,0,0,,Бұл ыңғайлы болды.
Dialogue: 0,0:03:56.79,0:03:59.13,Default,,0,0,0,,Тіпті менің достарым бар
Dialogue: 0,0:03:59.30,0:04:02.63,Default,,0,0,0,,Бұл жай ғана қиял.
Dialogue: 0,0:04:05.01,0:04:06.22,Default,,0,0,0,,Деус
Dialogue: 0,0:04:09.43,0:04:10.52,Default,,0,0,0,,Юкитеру?
Dialogue: 0,0:04:10.81,0:04:14.52,Default,,0,0,0,,Сәл күте тұрыңыз, біз қазір себеп-салдар заңын реттеп жатырмыз.
Dialogue: 0,0:04:14.65,0:04:16.77,Default,,0,0,0,,Мен бір нәрсені қайта бастағым келеді
Dialogue: 0,0:04:16.94,0:04:20.07,Default,,0,0,0,,Кейде әлем кейбір ынталандыруды қажет етеді.
Dialogue: 0,0:04:20.23,0:04:24.11,Default,,0,0,0,,Мен соғысты бастау үшін шабыттандыратын бір ауыз сөзді қаламаймын.
Dialogue: 0,0:04:24.24,0:04:25.99,Default,,0,0,0,,Олай айтпа
Dialogue: 0,0:04:26.16,0:04:30.04,Default,,0,0,0,,Келесі ойын қызық.
Dialogue: 0,0:04:30.20,0:04:33.00,Default,,0,0,0,,Бұл жігіт уақыт пен кеңістік патшасы, Деус Экс Машина
Dialogue: 0,0:04:33.12,0:04:36.21,Default,,0,0,0,,Құдай уақыт пен кеңістікті басқарады.
Dialogue: 0,0:04:36.38,0:04:37.79,Default,,0,0,0,,Тағы бір күнделік пе?
Dialogue: 0,0:04:37.92,0:04:41.01,Default,,0,0,0,,Мен оны жиі киемін деп ойлаймын.
Dialogue: 0,0:04:42.09,0:04:44.47,Default,,0,0,0,,Уақыт, орын және болған оқиға
Dialogue: 0,0:04:44.63,0:04:47.43,Default,,0,0,0,,Мен көргеннің бәрін киемін
Dialogue: 0,0:04:47.76,0:04:50.14,Default,,0,0,0,,Ештеңені төгіп алмаңыз, Мурумуру.
Dialogue: 0,0:04:50.18,0:04:50.97,Default,,0,0,0,,Сен ақымақсың
Dialogue: 0,0:04:52.39,0:04:54.14,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:04:54.31,0:04:56.77,Default,,0,0,0,,Бұл бір-бірінен ажырату емес пе?
Dialogue: 0,0:04:56.94,0:04:58.73,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:04:58.90,0:05:01.53,Default,,0,0,0,,Менің күнделігімнің мақсаты жоқ
Dialogue: 0,0:05:01.69,0:05:03.24,Default,,0,0,0,,Бұл таңдамайтын күнделік.
Dialogue: 0,0:05:05.20,0:05:08.32,Default,,0,0,0,,Арман жоқ, мақсат жоқ
Dialogue: 0,0:05:08.49,0:05:12.20,Default,,0,0,0,,Менде бар болғаны мына күнделік пен қиял әлемі
Dialogue: 0,0:05:17.71,0:05:19.04,Default,,0,0,0,,Жалғызсың ба?
Dialogue: 0,0:05:19.21,0:05:20.42,Default,,0,0,0,,Бөлек
Dialogue: 0,0:05:20.80,0:05:24.92,Default,,0,0,0,,Бірақ өзгере алсаңыз, өзгерткіңіз келе ме?
Dialogue: 0,0:05:25.09,0:05:28.47,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:28.64,0:05:30.81,Default,,0,0,0,,Мен саған болашақ беремін
Dialogue: 0,0:05:34.35,0:05:35.14,Default,,0,0,0,,Кіріс қоңырау
Dialogue: 0,0:05:35.48,0:05:37.60,Default,,0,0,0,,Бұл сіздің болашағыңыз болады
Dialogue: 0,0:05:37.77,0:05:39.31,Default,,0,0,0,,Бұл менің ұялы телефоным емес пе?
Dialogue: 0,0:05:40.73,0:05:42.82,Default,,0,0,0,,Сіз не жоспарлап отырсыз?
Dialogue: 0,0:05:42.98,0:05:44.61,Default,,0,0,0,,Көңілді ойындар
Dialogue: 0,0:05:45.95,0:05:47.82,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:47.99,0:05:49.95,Default,,0,0,0,,Бұл бәрібір қиял.
Dialogue: 0,0:06:00.63,0:06:02.38,Default,,0,0,0,,Оны ашыңыз.
Dialogue: 0,0:06:02.59,0:06:03.92,Default,,0,0,0,,Біреу өтінемін
Dialogue: 0,0:06:08.59,0:06:12.76,Default,,0,0,0,,Жоқ, жоқ, неге?
Dialogue: 0,0:06:25.36,0:06:26.57,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:32.53,0:06:36.87,Default,,0,0,0,,Күнделікті дартс ойыны қос бұқа болды.
Dialogue: 0,0:06:37.04,0:06:39.58,Default,,0,0,0,,7:05 Үй
Dialogue: 0,0:06:39.71,0:06:42.88,Default,,0,0,0,,Асханада өткен-кеткен оқиға туралы хабарлар бар.
Dialogue: 0,0:06:43.04,0:06:44.84,Default,,0,0,0,,Дәл көрші тұрған сияқты
Dialogue: 0,0:06:45.00,0:06:47.55,Default,,0,0,0,,Оның үстіне қылмыскер қашып кеткенде
Dialogue: 0,0:06:47.67,0:06:51.05,Default,,0,0,0,,Шамасы, ол менің орта мектептің алаңынан өткен.
Dialogue: 0,0:06:51.22,0:06:54.06,Default,,0,0,0,,Неліктен бүгінгі күнде күнделік жоқ?
Dialogue: 0,0:06:54.22,0:06:55.68,Default,,0,0,0,,Сіз оны жартылай ұйықтап жаздыңыз ба?
Dialogue: 0,0:06:55.81,0:06:58.52,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:07:05.61,0:07:06.86,Default,,0,0,0,,Қос бұқа
Dialogue: 0,0:07:07.07,0:07:09.28,Default,,0,0,0,,Сіз жақсы жұмыс істеп жатырсыз.
Dialogue: 0,0:07:10.15,0:07:11.41,Default,,0,0,0,,Келесі жаңалықтар
Dialogue: 0,0:07:11.57,0:07:14.49,Default,,0,0,0,,Бүгін ерте, Сакурамичоның артқы аллеясында
Dialogue: 0,0:07:14.62,0:07:17.29,Default,,0,0,0,,Пышақпен пышақталған әйелдің денесі табылды.
Dialogue: 0,0:07:17.41,0:07:20.08,Default,,0,0,0,,Сакурами полиция бөлімі қылмыстың әдісін зерттейді.
Dialogue: 0,0:07:20.25,0:07:24.00,Default,,0,0,0,,Бұл Сакурами-чо төңірегінде орналасқан көше жындары жасаған қылмыстар сериясы сияқты.
Dialogue: 0,0:07:24.13,0:07:27.17,Default,,0,0,0,,Біз тергеу штабын құрып, тергеуді бастауды жоспарлап отырмыз.
Dialogue: 0,0:07:27.55,0:07:28.30,Default,,0,0,0,,Қылмыскердің қашу жолы Сакурами орта мектебінің аумағы арқылы өтті.
Dialogue: 0,0:07:28.30,0:07:29.63,Default,,0,0,0,,Қылмыскер қашып кету жолы ретінде Сакурами орта мектебінің ғимараты арқылы өткен тағы бір оқиға.
Dialogue: 0,0:07:29.63,0:07:31.72,Default,,0,0,0,,Қылмыскердің қашу жолы Сакурами орта мектебінің аумағы арқылы өтті.
Dialogue: 0,0:07:31.88,0:07:35.72,Default,,0,0,0,,Өйткені ол мектепті жақсы білетіндер ғана қолданатын жолды ұстанды.
Dialogue: 0,0:07:36.22,0:07:38.68,Default,,0,0,0,,Менің ойымша, бұл рас.
Dialogue: 0,0:07:39.60,0:07:40.81,Default,,0,0,0,,Бұл кездейсоқтық
Dialogue: 0,0:07:41.52,0:07:42.77,Default,,0,0,0,,Кездейсоқ анықталған
Dialogue: 0,0:07:46.15,0:07:49.90,Default,,0,0,0,,Бұл әдеттен тыс, Қосака мен Ширайшидің мектептегі уақытымен сәйкес келеді.
Dialogue: 0,0:07:50.07,0:07:51.28,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:07:51.32,0:07:51.99,Default,,0,0,0,,О
Dialogue: 0,0:07:53.20,0:07:56.12,Default,,0,0,0,,Қосака мен Ширайши Неге тек бүгін?
Dialogue: 0,0:07:56.24,0:07:58.54,Default,,0,0,0,,Балалар, сендер жеңіл атлетика клубына жатасыңдар, солай ма?
Dialogue: 0,0:07:58.70,0:08:00.29,Default,,0,0,0,,Чоренге не болды?
Dialogue: 0,0:08:00.41,0:08:03.17,Default,,0,0,0,,Неліктен бұл жай ғана кездейсоқтық бүгінде?
Dialogue: 0,0:08:13.93,0:08:15.22,Default,,0,0,0,,Бұл кездейсоқтық емес
Dialogue: 0,0:08:15.39,0:08:17.47,Default,,0,0,0,,Күте тұрыңыз, эй.
Dialogue: 0,0:08:17.64,0:08:19.68,Default,,0,0,0,,Жауап жазылған.
Dialogue: 0,0:08:19.85,0:08:23.19,Default,,0,0,0,,А, бұл дұрыс па?
Dialogue: 0,0:08:26.15,0:08:28.69,Default,,0,0,0,,Эй, қалай болды, Юкитеру?
Dialogue: 0,0:08:28.86,0:08:32.95,Default,,0,0,0,,​​Әдеттегідей Қосакамен бәсекеге түсе алмайсың.
Dialogue: 0,0:08:36.07,0:08:37.37,Default,,0,0,0,,Жынды болмаңыз
Dialogue: 0,0:08:42.04,0:08:44.25,Default,,0,0,0,,12:32 Сынып бөлмесі
Dialogue: 0,0:08:44.58,0:08:47.29,Default,,0,0,0,,Түскі үзіліс кезінде Қосака тағы бір мысқылмен пікір айтады.
Dialogue: 0,0:08:55.89,0:08:57.14,Default,,0,0,0,,Бұл күнделік
Dialogue: 0,0:09:06.77,0:09:08.15,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:09:08.61,0:09:13.32,Default,,0,0,0,,Иә, бұл сіздің болашағыңызды білуге мүмкіндік беретін күнделік.
Dialogue: 0,0:09:13.44,0:09:16.16,Default,,0,0,0,,Неліктен? Сіз шынайы емессіз.
Dialogue: 0,0:09:16.28,0:09:18.16,Default,,0,0,0,,Менің болашағымды қайдан білесің?
Dialogue: 0,0:09:18.32,0:09:18.91,Default,,0,0,0,,Деус
Dialogue: 0,0:09:19.12,0:09:21.49,Default,,0,0,0,,Сен мен елестеткен құдайсың
Dialogue: 0,0:09:21.66,0:09:27.67,Default,,0,0,0,,Егер сіз құдай болсаңыз, сіздің қиялыңызда өмір сүру мүмкін емес пе?
Dialogue: 0,0:09:27.79,0:09:29.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:29.13,0:09:32.80,Default,,0,0,0,,Бірақ сол күнделік, болашақты білудің орнына
Dialogue: 0,0:09:32.84,0:09:33.92,Default,,0,0,0,,Кемшіліктері де бар.
Dialogue: 0,0:09:34.92,0:09:37.55,Default,,0,0,0,,«Болашақ күнделік» иесінің өзі
Dialogue: 0,0:09:37.68,0:09:39.93,Default,,0,0,0,,«Болашақ күнделік» жойылады деген нені білдіреді?
Dialogue: 0,0:09:40.05,0:09:43.14,Default,,0,0,0,,Сен де болашағыңнан айырыласың.
Dialogue: 0,0:09:43.56,0:09:45.27,Default,,0,0,0,,Бұл сенің өлетініңді білдіреді.
Dialogue: 0,0:09:48.23,0:09:50.44,Default,,0,0,0,,Менің «Болашақ күнделігім»
Dialogue: 0,0:09:50.65,0:09:53.07,Default,,0,0,0,,Менің көргенім
Dialogue: 0,0:09:53.28,0:09:57.20,Default,,0,0,0,,Жоқ, бұдан былай көретінім, жазатыным сол
Dialogue: 0,0:09:57.32,0:09:58.53,Default,,0,0,0,,Қазірдің өзінде жазылған
Dialogue: 0,0:09:59.99,0:10:02.99,Default,,0,0,0,,Болашақты бей-берекет баяндайтын күнделік
Dialogue: 0,0:10:04.37,0:10:07.08,Default,,0,0,0,,Юкитеру соңғы уақытта жақсы жұмыс істеуде.
Dialogue: 0,0:10:08.33,0:10:10.79,Default,,0,0,0,,Сіз жақсы істеп жатқан сияқтысыз.
Dialogue: 0,0:10:10.96,0:10:13.05,Default,,0,0,0,,Ах, бұл аздап жиіркенішті.
Dialogue: 0,0:10:13.21,0:10:15.09,Default,,0,0,0,,Мен оны қиратамын
Dialogue: 0,0:10:15.30,0:10:16.42,Default,,0,0,0,,Мені тұтқынға ал
Dialogue: 0,0:10:18.13,0:10:22.18,Default,,0,0,0,,Ол жігіт жиі келмейді.
Dialogue: 0,0:10:22.30,0:10:26.06,Default,,0,0,0,,14:12 Мектеп Мектеп ғимаратының артқы жағы
Dialogue: 0,0:10:26.23,0:10:28.98,Default,,0,0,0,,Бірнеше сыныптастары тұтқынға алынды.
Dialogue: 0,0:10:29.14,0:10:32.77,Default,,0,0,0,,Бұлар мені жек көретін адамдар.
Dialogue: 0,0:10:32.98,0:10:34.36,Default,,0,0,0,,Ақымақ адамдар
Dialogue: 0,0:10:34.57,0:10:36.94,Default,,0,0,0,,Менің ойымша, біз болашақты құртпауымыз керек.
Dialogue: 0,0:10:37.15,0:10:40.87,Default,,0,0,0,,Өмір жауаптары жазылған жауап парағы сияқты.
Dialogue: 0,0:10:42.45,0:10:45.58,Default,,0,0,0,,Жеңімпаз, супер жеңімпаз
Dialogue: 0,0:10:54.46,0:10:56.46,Default,,0,0,0,,Өйткені
Dialogue: 0,0:11:02.80,0:11:04.05,Default,,0,0,0,,Жанартау мырза
Dialogue: 0,0:11:04.18,0:11:08.18,Default,,0,0,0,,Үшінші мәселе қандай? Мен мұндай ештеңе үйренген жоқпын.
Dialogue: 0,0:11:08.31,0:11:11.73,Default,,0,0,0,,Түсініп тұрмын, мен сені бір күні жасады деп ойладым.
Dialogue: 0,0:11:11.90,0:11:14.48,Default,,0,0,0,,Мен кез келген мәселемен жақсымын.
Dialogue: 0,0:11:14.61,0:11:16.57,Default,,0,0,0,,Өйткені мен болашақты оқи аламын
Dialogue: 0,0:11:16.73,0:11:20.24,Default,,0,0,0,,Tsk, оған сенбе.
Dialogue: 0,0:11:20.40,0:11:24.24,Default,,0,0,0,,Егер өкініп жатсаңыз, менің ойымды оқып көріңіз.
Dialogue: 0,0:11:24.37,0:11:27.45,Default,,0,0,0,,Ой, мен сізге оны оңай оқуға рұқсат бермеймін.
Dialogue: 0,0:11:32.58,0:11:35.38,Default,,0,0,0,,Мен жай ғана саған қарадым
Dialogue: 0,0:11:35.54,0:11:36.34,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:11:39.97,0:11:41.47,Default,,0,0,0,,Сәлем Агацума
Dialogue: 0,0:11:41.59,0:11:43.18,Default,,0,0,0,,Мен оны қазір сынап жатырмын.
Dialogue: 0,0:11:43.30,0:11:46.22,Default,,0,0,0,,Бұл ақыл-ой жаттығуы, ешқандай проблема жоқ.
Dialogue: 0,0:11:47.56,0:11:49.43,Default,,0,0,0,,Оны қалыпты жағдайда орындаңыз.
Dialogue: 0,0:11:49.60,0:11:51.48,Default,,0,0,0,,Юно Агацума
Dialogue: 0,0:11:51.69,0:11:56.82,Default,,0,0,0,,Өте жақсы бағалар, сұлулық және мектептегі таңдану нысаны.
Dialogue: 0,0:11:58.61,0:11:59.69,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:12:05.24,0:12:06.16,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:12:07.28,0:12:08.24,Default,,0,0,0,,Ой, аралы тен
Dialogue: 0,0:12:12.25,0:12:14.75,Default,,0,0,0,,ТҰҚЫҒЫ деген не?
Dialogue: 0,0:12:15.92,0:12:18.34,Default,,0,0,0,,Бұл не өзі?
Dialogue: 0,0:12:18.55,0:12:20.80,Default,,0,0,0,,Бұл болашақ
Dialogue: 0,0:12:20.97,0:12:23.88,Default,,0,0,0,,Әрине, бұл сіздің болашағыңыз.
Dialogue: 0,0:12:24.05,0:12:26.43,Default,,0,0,0,,Амано-кун
Dialogue: 0,0:12:26.64,0:12:28.01,Default,,0,0,0,,Юно Агацума
Dialogue: 0,0:12:28.18,0:12:30.72,Default,,0,0,0,,Бұл сіздің болашағыңыз
Dialogue: 0,0:12:30.89,0:12:32.56,Default,,0,0,0,,Не?
Dialogue: 0,0:12:32.77,0:12:34.94,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:12:45.45,0:12:48.49,Default,,0,0,0,,Неліктен болашақ қайтадан өзгерді?
Dialogue: 0,0:12:49.12,0:12:51.20,Default,,0,0,0,,18:09 Қалада
Dialogue: 0,0:12:51.33,0:12:53.50,Default,,0,0,0,,Юно Агацума қисықтан алда болды.
Dialogue: 0,0:12:53.71,0:12:55.58,Default,,0,0,0,,Қашпа
Dialogue: 0,0:12:55.79,0:12:58.67,Default,,0,0,0,,Неге өзіңнен озып бара жатырсың?
Dialogue: 0,0:13:05.09,0:13:07.14,Default,,0,0,0,,Ойланып көріңізші, не болып жатыр?
Dialogue: 0,0:13:07.30,0:13:08.18,Default,,0,0,0,,Не
Dialogue: 0,0:13:08.39,0:13:12.93,Default,,0,0,0,,Менен басқа мұндай нәрсені жасай алатын ешкім жоқ.
Dialogue: 0,0:13:13.10,0:13:14.64,Default,,0,0,0,,Менен басқа
Dialogue: 0,0:13:18.81,0:13:19.44,Default,,0,0,0,,Бірақ
Dialogue: 0,0:13:20.57,0:13:21.94,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:13:29.62,0:13:30.70,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:13:33.16,0:13:35.04,Default,,0,0,0,,Юкки байқады
Dialogue: 0,0:13:35.25,0:13:39.13,Default,,0,0,0,,Тағы бір күнделік иесі
Dialogue: 0,0:13:41.17,0:13:42.59,Default,,0,0,0,,Жоқ, олар шын мәнінде тамақтанбай-ақ қоятындай деңгейге дейін дамыды, бірақ…
Dialogue: 0,0:13:45.97,0:13:48.39,Default,,0,0,0,,Әрине Да Дартс
Dialogue: 0,0:13:48.47,0:13:49.55,Default,,0,0,0,,Мен сені пышақтай алмаймын.
Dialogue: 0,0:14:00.11,0:14:01.69,Default,,0,0,0,,Мен саған пышақ салмаймын.
Dialogue: 0,0:14:03.19,0:14:04.65,Default,,0,0,0,,Сіз тістемейсіз.
Dialogue: 0,0:14:04.78,0:14:06.11,Default,,0,0,0,,Бұл болашақ
Dialogue: 0,0:14:06.24,0:14:08.70,Default,,0,0,0,,Болашақ қандай?
Dialogue: 0,0:14:10.57,0:14:13.66,Default,,0,0,0,,Сіз мұны дұрыс түсінбейсіз, Юкки.
Dialogue: 0,0:14:15.66,0:14:16.66,Default,,0,0,0,,Тайбар әулеті келді!!
Dialogue: 0,0:14:20.17,0:14:23.96,Default,,0,0,0,,News commuter үшінші күнделік иесі
Dialogue: 0,0:14:24.13,0:14:26.05,Default,,0,0,0,,3-ші
Dialogue: 0,0:14:26.55,0:14:30.01,Default,,0,0,0,,Мен Юккиді оның өлтіретінін болжадым.
Dialogue: 0,0:14:30.18,0:14:32.35,Default,,0,0,0,,Юккидің болашағына қараңыз
Dialogue: 0,0:14:33.64,0:14:35.81,Default,,0,0,0,,Бұл менің «болашақ күнделігім»
Dialogue: 0,0:14:36.64,0:14:40.94,Default,,0,0,0,,Юкки 18:20-да ғимараттың 14-ші қабатында өлуі керек.
Dialogue: 0,0:14:41.98,0:14:48.49,Default,,0,0,0,,Бұл мен туралы көп жазылған.
Dialogue: 0,0:14:49.45,0:14:51.49,Default,,0,0,0,,Менің күнделігім - Юкитеру күнделігі.
Dialogue: 0,0:14:51.66,0:14:55.12,Default,,0,0,0,,Юккидің болашағын 10 минуттық қадамдармен түсініңіз
Dialogue: 0,0:14:55.24,0:14:56.79,Default,,0,0,0,,Махаббаттың "Болашақ күнделігі"
Dialogue: 0,0:14:57.00,0:14:58.54,Default,,0,0,0,,10 минуттық қадамдар
Dialogue: 0,0:14:58.71,0:14:59.87,Default,,0,0,0,,онда Әйел Титанның ішіндегі адам қазір
Dialogue: 0,0:15:00.00,0:15:03.50,Default,,0,0,0,,Бұл жігіт күнделігінде 10 минут сайын мені бақылап отырды ма?
Dialogue: 0,0:15:03.67,0:15:05.17,Default,,0,0,0,,Ол өте ізденуші.
Dialogue: 0,0:15:05.34,0:15:08.80,Default,,0,0,0,,Сондықтан Юккидің болашағы қазіргідей болып қалады.
Dialogue: 0,0:15:12.59,0:15:13.85,Default,,0,0,0,,Не?
Dialogue: 0,0:15:13.97,0:15:16.97,Default,,0,0,0,,Демек, 14-ші қабаттан түссең, өлесің.
Dialogue: 0,0:15:17.14,0:15:21.10,Default,,0,0,0,,Бұлай жалғаса берсе, мен аман қалу ойынынан бірінші болып шығып қаламын.
Dialogue: 0,0:15:21.23,0:15:24.77,Default,,0,0,0,,Аман қалу ойыны
Dialogue: 0,0:15:25.61,0:15:29.36,Default,,0,0,0,,«Болашақ күнделік» иелері бір-бірінің өмірін көздеп отыр.
Dialogue: 0,0:15:29.57,0:15:31.91,Default,,0,0,0,,Ол сияқты.
Dialogue: 0,0:15:32.07,0:15:35.16,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:15:35.33,0:15:39.37,Default,,0,0,0,,Юкки күнделігін тым көп қолданды.
Dialogue: 0,0:15:39.54,0:15:41.75,Default,,0,0,0,,​​Бір жерде қамыс болыпты.
Dialogue: 0,0:15:52.47,0:15:54.09,Default,,0,0,0,,Төбесі дегеніміз не?
Dialogue: 0,0:15:54.26,0:15:56.05,Default,,0,0,0,,Мен осылай шықсам не істеуім керек?
Dialogue: 0,0:15:56.18,0:15:59.18,Default,,0,0,0,,Оның тіпті күнделігі де бар.
Dialogue: 0,0:15:59.35,0:16:01.89,Default,,0,0,0,,Қайда қашсаң да, бәрібір
Dialogue: 0,0:16:02.06,0:16:05.36,Default,,0,0,0,,Қараңызшы, кеңірек ыңғайлырақ, солай ма?
Dialogue: 0,0:16:05.52,0:16:08.94,Default,,0,0,0,,Жоқ, мен бұл жігітпен бірге болсам өлемін.
Dialogue: 0,0:16:09.11,0:16:10.24,Default,,0,0,0,,Міндетті түрде өледі
Dialogue: 0,0:16:11.45,0:16:13.24,Default,,0,0,0,,Олармен осында танысайық.
Dialogue: 0,0:16:13.49,0:16:14.57,Default,,0,0,0,,Әзіл әзіл
Dialogue: 0,0:16:15.49,0:16:16.99,Default,,0,0,0,,Менің жоспарым бар.
Dialogue: 0,0:16:20.08,0:16:21.12,Default,,0,0,0,,Дарт
Dialogue: 0,0:16:25.67,0:16:27.92,Default,,0,0,0,,Сіздің болашағыңызды шешетін дарттар
Dialogue: 0,0:16:28.09,0:16:30.88,Default,,0,0,0,,Бүгін қалайсың?
Dialogue: 0,0:16:47.90,0:16:51.90,Default,,0,0,0,,Жоқ, олар қайда жасырынып жатыр?
Dialogue: 0,0:16:54.91,0:16:56.32,Default,,0,0,0,,Сізде бір ғана мүмкіндік бар
Dialogue: 0,0:16:56.53,0:16:59.03,Default,,0,0,0,,Ол «Болашақ күнделігіне» сенуге тырысқанда
Dialogue: 0,0:17:05.87,0:17:09.25,Default,,0,0,0,,«Болашақ күнделігі» – әрі қару, әрі әлсіздік.
Dialogue: 0,0:17:09.42,0:17:11.67,Default,,0,0,0,,Өйткені күнделік иесінің өзі
Dialogue: 0,0:17:11.84,0:17:15.72,Default,,0,0,0,,Қарғыс атсын, олар қайда кетті?
Dialogue: 0,0:17:17.09,0:17:19.89,Default,,0,0,0,,Сондықтан оның күнделігін жойсаң,
Dialogue: 0,0:17:25.48,0:17:26.23,Default,,0,0,0,,Соқты
Dialogue: 0,0:17:53.05,0:17:53.92,Default,,0,0,0,,Осыншама
Dialogue: 0,0:17:54.63,0:17:56.51,Default,,0,0,0,,Не, бұл қызықсыз ба?
Dialogue: 0,0:18:02.43,0:18:05.18,Default,,0,0,0,,Юкки тамақ ішуге шықпайды.
Dialogue: 0,0:18:05.35,0:18:08.35,Default,,0,0,0,,Анаң да бүгін үйге келмейді, солай ма?
Dialogue: 0,0:18:11.98,0:18:13.82,Default,,0,0,0,,Сіз нені айтасыз, Деус?
Dialogue: 0,0:18:14.03,0:18:16.57,Default,,0,0,0,,Неліктен басқа адамдарда «Болашақ күнделігі» бар?
Dialogue: 0,0:18:16.78,0:18:21.78,Default,,0,0,0,,Күнделіктің иесі бір ғана адам болғанын айтқаным есімде жоқ.
Dialogue: 0,0:18:21.91,0:18:22.70,Default,,0,0,0,,Деус
Dialogue: 0,0:18:22.87,0:18:24.95,Default,,0,0,0,,Ал, ашуланба.
Dialogue: 0,0:18:25.12,0:18:26.79,Default,,0,0,0,,Мен мұны алдымен айтуым керек еді.
Dialogue: 0,0:18:27.00,0:18:29.08,Default,,0,0,0,,Бұл ойын
Dialogue: 0,0:18:29.25,0:18:31.79,Default,,0,0,0,,Бірінші жеңімпаз 1-ші.
Dialogue: 0,0:18:32.00,0:18:32.92,Default,,0,0,0,,1-ші
Dialogue: 0,0:18:38.76,0:18:41.60,Default,,0,0,0,,Бұл сіз туралы біріншісі.
Dialogue: 0,0:18:41.93,0:18:46.18,Default,,0,0,0,,Ол кісі өлтірушіні өлтіргеніңді естідім.
Dialogue: 0,0:18:46.39,0:18:49.52,Default,,0,0,0,,Бұл жігіттер, басқа күнделік иелері
Dialogue: 0,0:18:51.31,0:18:52.27,Default,,0,0,0,,Яғни
Dialogue: 0,0:18:52.52,0:18:54.11,Default,,0,0,0,,Юно
Dialogue: 0,0:18:54.86,0:18:57.86,Default,,0,0,0,,Енді барлығы осында,
Dialogue: 0,0:18:57.99,0:19:01.91,Default,,0,0,0,,Осы аман қалу ойынын тағы да түсіндіремін.
Dialogue: 0,0:19:02.12,0:19:05.49,Default,,0,0,0,,Ең алдымен қолыңыздағы күнделік.
Dialogue: 0,0:19:05.62,0:19:08.16,Default,,0,0,0,,Бұл «Болашақ күнделік» деп аталады
Dialogue: 0,0:19:08.33,0:19:12.21,Default,,0,0,0,,Бастапқыда бұл сіз балалар пайдаланатын кәдімгі күнделік болатын.
Dialogue: 0,0:19:12.33,0:19:17.71,Default,,0,0,0,,Уақыт бұрмаланған, сондықтан сипаттамалар 90 күн бұрын жасалады.
Dialogue: 0,0:19:17.76,0:19:18.76,Default,,0,0,0,,Менің ойымша, бұл жақсы
Dialogue: 0,0:19:19.30,0:19:21.76,Default,,0,0,0,,10-шы нәрсе
Dialogue: 0,0:19:21.89,0:19:26.06,Default,,0,0,0,,Бұл күнделіктің рұқсатсыз өзгертілгеніне бірнеше рет куә болдым.
Dialogue: 0,0:19:26.22,0:19:27.31,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:19:27.43,0:19:30.85,Default,,0,0,0,,Болашақ иесінің әрекетіне байланысты өзгереді
Dialogue: 0,0:19:32.10,0:19:34.40,Default,,0,0,0,,Иесі апатқа ұшырады делік.
Dialogue: 0,0:19:34.52,0:19:38.15,Default,,0,0,0,,​​Күнделік адамның болашақта жарақат алатынын болжайды делік.
Dialogue: 0,0:19:38.28,0:19:41.78,Default,,0,0,0,,Иесі хабарлау нүктесіне жеткенде
Dialogue: 0,0:19:41.95,0:19:43.95,Default,,0,0,0,,Ескертуге қайшы әрекет етсеңіз
Dialogue: 0,0:19:44.07,0:19:47.16,Default,,0,0,0,,Фактілер өзгереді және болашақ өзгереді.
Dialogue: 0,0:19:47.33,0:19:49.83,Default,,0,0,0,,Болжалды апаттардан аулақ болсаңыз
Dialogue: 0,0:19:49.96,0:19:51.71,Default,,0,0,0,,Жарақат алудың болашағы да өзгереді.
Dialogue: 0,0:19:51.87,0:19:55.92,Default,,0,0,0,,Және болашақ сипаттама да қайта жазылады.
Dialogue: 0,0:19:56.09,0:19:57.09,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:19:57.25,0:19:59.76,Default,,0,0,0,,Мен ештеңе жасамай-ақ қайта жазылды.
Dialogue: 0,0:19:59.88,0:20:02.84,Default,,0,0,0,,Маған 3-ке дейін өлтірілетінін ескертті.
Dialogue: 0,0:20:03.64,0:20:07.89,Default,,0,0,0,,Болашақты өзгерте алатын жалғыз сен емессің.
Dialogue: 0,0:20:08.10,0:20:10.68,Default,,0,0,0,,Сондықтан бұл аман қалу ойыны.
Dialogue: 0,0:20:10.85,0:20:14.90,Default,,0,0,0,,Күнделік иесінің басқа иесін өлтіретіні расталған кезде.
Dialogue: 0,0:20:15.06,0:20:16.65,Default,,0,0,0,,Өлім үкімі шығарылды.
Dialogue: 0,0:20:16.77,0:20:19.36,Default,,0,0,0,,Бұл ӨЛІК СОҢының алдын ала көрінісі
Dialogue: 0,0:20:19.53,0:20:22.57,Default,,0,0,0,,Бір-бірімізді өлтіреміз десек те, бір-бірімізді көре алмаймыз.
Dialogue: 0,0:20:22.74,0:20:27.83,Default,,0,0,0,,Оны өздерінің күнделіктеріндегі ақпаратты пайдаланып табуын сұраңыз, т.б.
Dialogue: 0,0:20:27.91,0:20:31.08,Default,,0,0,0,,Ойын қарсыластың жеке басын табудан басталады, солай емес пе?
Dialogue: 0,0:20:31.25,0:20:33.08,Default,,0,0,0,,Білсе, өлтіріледі.
Dialogue: 0,0:20:33.25,0:20:37.09,Default,,0,0,0,,Сәйкестікті анықтап, ӨЛІК ЖАҚ жалауын орнатыңыз
Dialogue: 0,0:20:37.25,0:20:39.92,Default,,0,0,0,,Жалауша қойылған жағдайда
Dialogue: 0,0:20:40.05,0:20:41.51,Default,,0,0,0,,Бар күшіңізбен аулақ болыңыз
Dialogue: 0,0:20:41.67,0:20:44.72,Default,,0,0,0,,Бұл аман қалу.
Dialogue: 0,0:20:44.89,0:20:49.85,Default,,0,0,0,,1-ші, ол кезде өлуің керек еді.
Dialogue: 0,0:20:49.97,0:20:53.56,Default,,0,0,0,,Сен оны өлтірдің
Dialogue: 0,0:20:53.73,0:20:56.02,Default,,0,0,0,,Бұл мұғжизадан тыс мұғжиза
Dialogue: 0,0:20:56.19,0:20:59.57,Default,,0,0,0,,Барлығын өлтіріп аман қалған адам бірінші болуы мүмкін.
Dialogue: 0,0:20:59.69,0:21:03.36,Default,,0,0,0,,Сіз менің сүйіктімсіз деп ойлаймын.
Dialogue: 0,0:21:04.57,0:21:08.87,Default,,0,0,0,,Жоқ, бұл кереметті саған әкелген мен емес едім.
Dialogue: 0,0:21:11.83,0:21:16.67,Default,,0,0,0,,Енді осы аман қалу ойынынан аман қалған соңғы адамға,
Dialogue: 0,0:21:16.83,0:21:22.09,Default,,0,0,0,,Мен өзімнің мұрагерім ретінде уақыт пен кеңістікті басқаратын құдайды қабылдаймын.
Dialogue: 0,0:21:22.26,0:21:23.59,Default,,0,0,0,,Өлім бе, өмір бе?
Dialogue: 0,0:21:23.76,0:21:25.59,Default,,0,0,0,,Мұнда тек 11 адам қалды.
Dialogue: 0,0:21:25.72,0:21:28.05,Default,,0,0,0,,Өлтірмес бұрын өлтір
Dialogue: 0,0:21:28.22,0:21:31.06,Default,,0,0,0,,Және Құдайдың тағына ие бол.
Dialogue: 0,0:21:31.43,0:21:34.35,Default,,0,0,0,,Бұл жағдайда тікелей кедергі болып табылады
Dialogue: 0,0:21:34.52,0:21:35.85,Default,,0,0,0,,1-ші.
Dialogue: 0,0:21:36.94,0:21:39.81,Default,,0,0,0,,Қайырлы күн 1-ші
Dialogue: 0,0:21:39.94,0:21:42.53,Default,,0,0,0,,Мен барып, сені өлтіргенше өлесің деп үміттенемін.
Dialogue: 0,0:21:42.69,0:21:46.32,Default,,0,0,0,,Қош бол, сәттілік 1-күн
Dialogue: 0,0:21:46.45,0:21:48.20,Default,,0,0,0,,Аз ғана
Dialogue: 0,0:21:48.37,0:21:50.28,Default,,0,0,0,,Мен сенің қорқып тұрғаныңды көріп тұрмын.
Dialogue: 0,0:21:50.45,0:21:54.33,Default,,0,0,0,,Ғажайыптарды жеңетін қаттылық аздап қиындық тудырады.
Dialogue: 0,0:21:54.50,0:21:56.87,Default,,0,0,0,,Жоқ, бұл мен емес.
Dialogue: 0,0:21:57.04,0:21:58.12,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:21:58.29,0:22:00.75,Default,,0,0,0,,Мен сені қорғаймын
Dialogue: 0,0:22:00.92,0:22:02.92,Default,,0,0,0,,Әй, бейшара.
Dialogue: 0,0:22:03.09,0:22:04.05,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:22:04.21,0:22:06.93,Default,,0,0,0,,Осымен кездесу аяқталады.
Dialogue: 0,0:22:12.64,0:22:15.43,Default,,0,0,0,,Бұл қандай жағдай?
Dialogue: 0,0:22:15.64,0:22:17.52,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:22:21.77,0:22:22.86,Default,,0,0,0,,Жарайды
Dialogue: 0,0:22:23.53,0:22:24.65,Default,,0,0,0,,Юкки
Dialogue: 0,0:22:26.36,0:22:28.78,Default,,0,0,0,,Юно сені қорғайды
Dialogue: 0,0:22:30.12,0:22:32.37,Default,,0,0,0,,Сәлем Юкки
Dialogue: 0,0:23:55.41,0:23:56.91,Default,,0,0,0,,Сонымен 3-ші.
Dialogue: 0,0:23:57.08,0:24:00.25,Default,,0,0,0,,Сіз сондай-ақ «Болашақ күнделігінің» 12 иесінің бірі ретінде таңдалдыңыз.
Dialogue: 0,0:24:03.04,0:24:04.88,Default,,0,0,0,,Куәгер?
Dialogue: 0,0:24:05.04,0:24:05.67,Default,,0,0,0,,Ноджа
Dialogue: 0,0:24:06.25,0:24:08.00,Default,,0,0,0,,Тірі бол және үйге қайт
Dialogue: 0,0:24:08.17,0:24:10.38,Default,,0,0,0,,Күте тұрыңыз, сөйлесіңіз.
Dialogue: 0,0:24:20.52,0:24:23.19,Default,,0,0,0,,Басқа адамдардың айтқанын аздап тыңдағыңыз келе ме?
Dialogue: 0,0:24:23.35,0:24:26.61,Default,,0,0,0,,Аман қалу ойынының алдында жоғалып кетсеңіз не істеу керек
Dialogue: 0,0:24:26.77,0:24:31.28,Default,,0,0,0,,Бұл сіз сақтаған кісі өлтіру жазбасы. Бұл кісі өлтіру күнделігі.
Dialogue: 0,0:24:31.44,0:24:34.53,Default,,0,0,0,,Мен оны ертерек қарызға алдым және онымен аздап ойнауға рұқсат етемін.
Dialogue: 0,0:24:34.70,0:24:36.83,Default,,0,0,0,,Неліктен мұны істедің?
Dialogue: 0,0:24:36.99,0:24:38.87,Default,,0,0,0,,Хехе, таң қалдыңыз ба?
Dialogue: 0,0:24:39.04,0:24:40.83,Default,,0,0,0,,Кісі өлтіру айғағы жойылды
Dialogue: 0,0:24:43.04,0:24:45.42,Default,,0,0,0,,Сондықтан мені тыңдайсың
Dialogue: 0,0:24:51.32,0:24:52.29,Default,,0,0,0,,Алынған сабақтар
Dialogue: 0,0:24:52.92,0:24:55.93,Default,,0,0,0,,Күдікті адамдар қиындық тудырады.
Dialogue: 0,0:24:56.14,0:25:02.18,Default,,0,0,0,,Бірақ мен 3-ші себеп немесе салдар қандай болмасын, бірінші болып оқуды тастайтын сияқтымын.
Dialogue: 0,0:25:03.68,0:25:08.68,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
