Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Бұл менің орным
Dialogue: 0,0:00:06.90,0:00:10.44,Default,,0,0,0,,Мен өзімді ең еркін сезінетін жер
Dialogue: 0,0:00:10.82,0:00:12.11,Default,,0,0,0,,Юки-кун
Dialogue: 0,0:00:14.24,0:00:15.57,Default,,0,0,0,,Артында ештеңе қалмады
Dialogue: 0,0:00:15.70,0:00:16.32,Default,,0,0,0,,Иә
Dialogue: 0,0:00:16.62,0:00:17.99,Default,,0,0,0,,Бұл менің әкем.
Dialogue: 0,0:00:18.16,0:00:19.91,Default,,0,0,0,,Жоқ, күте тұрыңыз.
Dialogue: 0,0:00:20.12,0:00:22.41,Default,,0,0,0,,Юки-кун, сен де ваннаға бардың ба?
Dialogue: 0,0:00:22.58,0:00:24.67,Default,,0,0,0,,Бұл қазірдің өзінде тым босаңсытады
Dialogue: 0,0:00:24.83,0:00:27.00,Default,,0,0,0,,Ананың түскі ас қорабы
Dialogue: 0,0:00:27.13,0:00:29.92,Default,,0,0,0,,Иә, мен оны ас үйде қалдырдым.
Dialogue: 0,0:00:30.05,0:00:31.26,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:00:31.42,0:00:35.93,Default,,0,0,0,,Менің анам өте күшті сияқты, бірақ оған бір нәрсе дұрыс емес.
Dialogue: 0,0:00:37.14,0:00:39.10,Default,,0,0,0,,Сен бақытты көрінесің, Юки-кун.
Dialogue: 0,0:00:39.26,0:00:39.76,Default,,0,0,0,,Иә
Dialogue: 0,0:00:39.81,0:00:43.06,Default,,0,0,0,,Мен барлығымен бірге жұлдыздарды көруге баруды асыға күттім.
Dialogue: 0,0:02:33.63,0:02:37.09,Default,,0,0,0,,Юкитеру мөрленді, мен 9-шыны да жеңдім.
Dialogue: 0,0:02:37.22,0:02:38.26,Default,,0,0,0,,Одан кейін
Dialogue: 0,0:02:39.97,0:02:42.76,Default,,0,0,0,,Мен қазір өлсем де, бұл себеп-салдар мәселесі болар еді.
Dialogue: 0,0:02:43.01,0:02:46.47,Default,,0,0,0,,Тоқтатылған анимацияда болған нәрсені жылдам түзетіңіз.
Dialogue: 0,0:02:48.94,0:02:49.85,Default,,0,0,0,,(Айзава) Сондықтан мен қабылдау емтиханы логикаға жат дедім
Dialogue: 0,0:02:50.35,0:02:52.86,Default,,0,0,0,,Енді ойынның үшінші кезеңін бастайық.
Dialogue: 0,0:02:54.98,0:02:58.69,Default,,0,0,0,,2-ші Тездетіп, үшінші раундта Юно Агацуманы өлтіріңіз.
Dialogue: 0,0:03:00.11,0:03:03.41,Default,,0,0,0,,Егер сіз бұл жігітті өлтірсеңіз, ойынға қайта қосыла аласыз.
Dialogue: 0,0:03:04.03,0:03:07.20,Default,,0,0,0,,Осы үшінші әлемде Юкки өзінің үшінші аптасында.
Dialogue: 0,0:03:07.45,0:03:09.37,Default,,0,0,0,,Аман қалу ойынының үшінші раунды
Dialogue: 0,0:03:10.33,0:03:12.33,Default,,0,0,0,,Бұл жерде ешқандай қате жоқ.
Dialogue: 0,0:03:12.79,0:03:15.13,Default,,0,0,0,,Мен Юккимен бұрыннан қоштастым.
Dialogue: 0,0:03:15.42,0:03:17.17,Default,,0,0,0,,Келесі Юккимен танысыңыз
Dialogue: 0,0:03:19.92,0:03:21.22,Default,,0,0,0,,Бұл жерде ешқандай қате жоқ.
Dialogue: 0,0:03:23.39,0:03:29.23,Default,,0,0,0,,Па Па Ма Ма
Dialogue: 0,0:03:29.93,0:03:33.81,Default,,0,0,0,,Мен әлі ештеңе білмеген кездегі менмін.
Dialogue: 0,0:03:34.94,0:03:37.73,Default,,0,0,0,,Мен анам мен әкемді өлтірмегенімде
Dialogue: 0,0:03:42.70,0:03:43.49,Default,,0,0,0,,Мен
Dialogue: 0,0:03:44.74,0:03:47.20,Default,,0,0,0,,Мен сіз жақсы білетін адаммын
Dialogue: 0,0:03:47.70,0:03:51.58,Default,,0,0,0,,Иә, мен саған болашағымды айтамын.
Dialogue: 0,0:03:52.54,0:03:55.04,Default,,0,0,0,,Менің болашағым
Dialogue: 0,0:03:56.00,0:03:59.96,Default,,0,0,0,,Иә, мен сенің болашағыңды не күтіп тұрғанын білемін.
Dialogue: 0,0:04:00.72,0:04:02.76,Default,,0,0,0,,Тыңда, Юно Агацума
Dialogue: 0,0:04:04.05,0:04:07.60,Default,,0,0,0,,Анамның психикалық ауруы бұдан былай күшейе түседі.
Dialogue: 0,0:04:07.81,0:04:10.35,Default,,0,0,0,,Әкем де жұмысына байланысты үйге келмейді.
Dialogue: 0,0:04:10.60,0:04:12.27,Default,,0,0,0,,Мүмкін сіз үйге барғыңыз келмейтін шығар
Dialogue: 0,0:04:13.48,0:04:16.44,Default,,0,0,0,,Анам сені одан сайын ұрады
Dialogue: 0,0:04:17.23,0:04:19.94,Default,,0,0,0,,Анамның азапты жазасы
Dialogue: 0,0:04:21.11,0:04:24.66,Default,,0,0,0,,Екеуін де ұйықтататын дәрімен дәрілеп, торға қамап қоясың.
Dialogue: 0,0:04:26.16,0:04:28.45,Default,,0,0,0,,Бастапқыда мен қашып кеткім келді.
Dialogue: 0,0:04:28.99,0:04:31.95,Default,,0,0,0,,Мен жай ғана менің ауырғанымды білуді қаладым.
Dialogue: 0,0:04:32.96,0:04:33.75,Default,,0,0,0,,Бірақ
Dialogue: 0,0:04:35.63,0:04:37.29,Default,,0,0,0,,Бірақ бәрі жақсы болды.
Dialogue: 0,0:04:37.92,0:04:39.84,Default,,0,0,0,,Сізге енді азап шегудің қажеті жоқ
Dialogue: 0,0:04:40.67,0:04:41.34,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:42.55,0:04:46.18,Default,,0,0,0,,Мен ауырмаймын.
Dialogue: 0,0:04:47.18,0:04:51.31,Default,,0,0,0,,Бұл өтірік. Ауырған болуы керек. Бұл соншалықты ауыр болса керек.
Dialogue: 0,0:04:52.43,0:04:53.06,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:54.14,0:04:59.86,Default,,0,0,0,,Анам ауырып жатыр. Әкем жұмыстан бос емес.
Dialogue: 0,0:05:01.40,0:05:03.82,Default,,0,0,0,,Мен анам мен әкемді жақсы көремін
Dialogue: 0,0:05:05.70,0:05:09.99,Default,,0,0,0,,Бір күні екеуміз де мені түсінетін боламыз
Dialogue: 0,0:05:11.62,0:05:13.20,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:05:13.96,0:05:18.83,Default,,0,0,0,,Осы кезде мен әлі де жарқын болашаққа сенетінмін.
Dialogue: 0,0:05:20.21,0:05:23.59,Default,,0,0,0,,Мен қай жерде бұрмаландым?
Dialogue: 0,0:05:26.72,0:05:30.39,Default,,0,0,0,,Сонда да маған кездесу керек біреу бар.
Dialogue: 0,0:05:30.85,0:05:36.14,Default,,0,0,0,,Сізге де ұнайтын адам бар ма?
Dialogue: 0,0:05:40.57,0:05:41.23,Default,,0,0,0,,Не?
Dialogue: 0,0:05:42.32,0:05:45.24,Default,,0,0,0,,Себептік байланыстың ауытқуы тез өсуде.
Dialogue: 0,0:05:45.44,0:05:46.57,Default,,0,0,0,,Дереккөз
Dialogue: 0,0:05:47.57,0:05:48.32,Default,,0,0,0,,(Қыңқыл) Бірақ қазір менде қорқыныштың бір ұшқыны да жоқ
Dialogue: 0,0:05:55.79,0:05:57.37,Default,,0,0,0,,Не болды, Юки-кун?
Dialogue: 0,0:06:01.13,0:06:04.13,Default,,0,0,0,,Кешіріңіз, әке, ана.
Dialogue: 0,0:06:04.71,0:06:06.17,Default,,0,0,0,,Мен мұны істей алмаймын деп ойлаймын
Dialogue: 0,0:06:06.84,0:06:07.59,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:08.22,0:06:10.80,Default,,0,0,0,,Мен бүгінгі күнді қатты күттім.
Dialogue: 0,0:06:11.39,0:06:12.31,Default,,0,0,0,,Ол сөзсіз осында—
Dialogue: 0,0:06:12.93,0:06:13.93,Default,,0,0,0,,Юки-кун
Dialogue: 0,0:06:14.10,0:06:19.48,Default,,0,0,0,,Маған дәл қазір тағы бір нәрсе істеу керек сияқты.
Dialogue: 0,0:06:20.10,0:06:20.81,Default,,0,0,0,,Сонымен
Dialogue: 0,0:06:31.24,0:06:32.45,Default,,0,0,0,,Ақымақ болма.
Dialogue: 0,0:06:32.83,0:06:33.87,Default,,0,0,0,,Ой...
Dialogue: 0,0:06:35.20,0:06:37.12,Default,,0,0,0,,Төбеде біреу бар.
Dialogue: 0,0:06:38.58,0:06:40.67,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:06:41.75,0:06:43.71,Default,,0,0,0,,Ей, жалғыз барма.
Dialogue: 0,0:06:44.00,0:06:47.76,Default,,0,0,0,,Нишижима: Өтінемін, айналып өтіп, зардап шеккендердің жоқтығына көз жеткізіңіз.
Dialogue: 0,0:06:47.76,0:06:48.55,Default,,0,0,0,,Иә
Dialogue: 0,0:06:48.80,0:06:49.51,Default,,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:06:50.22,0:06:52.39,Default,,0,0,0,,Себептілікке тым көп әсер ету
Dialogue: 0,0:06:53.14,0:06:56.18,Default,,0,0,0,,2-ші Бұл жігітті тез өлтіріп, орнына қойыңыз.
Dialogue: 0,0:06:56.39,0:06:58.06,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:06:58.77,0:07:01.65,Default,,0,0,0,,Болашақ керемет жылдамдықпен қайта жазылуда
Dialogue: 0,0:07:01.81,0:07:03.48,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:07:03.90,0:07:06.53,Default,,0,0,0,,Эй, жақсысың ба? Мықты болыңыз.
Dialogue: 0,0:07:09.70,0:07:11.78,Default,,0,0,0,,Бұл бет қайда?
Dialogue: 0,0:07:16.41,0:07:17.62,Default,,0,0,0,,Камелия ханым
Dialogue: 0,0:07:17.79,0:07:20.33,Default,,0,0,0,,Киосю-саманың көлігінде осындай нәрсе бар.
Dialogue: 0,0:07:20.54,0:07:21.58,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:07:21.75,0:07:23.54,Default,,0,0,0,,Менің ойымша, бұл бомба.
Dialogue: 0,0:07:23.75,0:07:24.71,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:07:24.88,0:07:28.46,Default,,0,0,0,,Әкем мен шешемнің ойларына қайшы келетін нәрсе
Dialogue: 0,0:07:29.38,0:07:30.34,Default,,0,0,0,,Хана-сан?
Dialogue: 0,0:07:31.09,0:07:32.22,Default,,0,0,0,,Фунацу
Dialogue: 0,0:07:32.39,0:07:34.35,Default,,0,0,0,,Бұл кішкентай қыз
Dialogue: 0,0:07:35.14,0:07:39.43,Default,,0,0,0,,Әкең мен шешеңді өлтіріп, культті басып алмақшысың ба?
Dialogue: 0,0:07:40.14,0:07:41.64,Default,,0,0,0,,Қандай ақымақтық
Dialogue: 0,0:07:41.85,0:07:46.15,Default,,0,0,0,,Үндеме, мен ештеңе істей алмайтын баламын.
Dialogue: 0,0:07:46.32,0:07:47.27,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:07:47.44,0:07:50.32,Default,,0,0,0,,Омега-кё - әлсіздерді құтқаратын культ.
Dialogue: 0,0:07:50.44,0:07:53.61,Default,,0,0,0,,Мен енді зұлым күштерге көнбеймін.
Dialogue: 0,0:07:53.78,0:07:56.20,Default,,0,0,0,,6-ның болашағы өзгерді.
Dialogue: 0,0:07:56.41,0:07:57.62,Default,,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:07:57.79,0:08:00.62,Default,,0,0,0,,6-шы зұлымдық культтің негізін қалаушы болуы керек еді.
Dialogue: 0,0:08:02.37,0:08:05.54,Default,,0,0,0,,5-ші ата-анасы бұл сектаға қосылуы керек еді.
Dialogue: 0,0:08:05.71,0:08:08.30,Default,,0,0,0,,5-тің болашағы өзгереді
Dialogue: 0,0:08:12.93,0:08:15.09,Default,,0,0,0,,Дүрбелеңнен ләззат алған от ұры
Dialogue: 0,0:08:15.09,0:08:17.30,Default,,0,0,0,,Жоқ, Цудзигири - шу шығаруды ұнататын ұры. Жоқ, Цудзигири деген не?
Dialogue: 0,0:08:17.51,0:08:19.93,Default,,0,0,0,,Бұл дұрыс па?
Dialogue: 0,0:08:20.98,0:08:25.35,Default,,0,0,0,,Сіз соңғы кезде пайда болған азғынсыз ба?
Dialogue: 0,0:08:25.52,0:08:26.73,Default,,0,0,0,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,0:08:26.90,0:08:29.28,Default,,0,0,0,,Мен әділеттің одақтасымын.
Dialogue: 0,0:08:35.49,0:08:37.32,Default,,0,0,0,,Сыртта шулы болса да
Dialogue: 0,0:08:37.49,0:08:40.12,Default,,0,0,0,,Мен иттер шынымен сабырлы деп ойладым.
Dialogue: 0,0:08:40.29,0:08:41.83,Default,,0,0,0,,Анықталды
Dialogue: 0,0:08:42.00,0:08:46.33,Default,,0,0,0,,Хината: Иттер қашан сонша бауыр басып қалды?
Dialogue: 0,0:08:46.46,0:08:48.59,Default,,0,0,0,,Әкемнің сәби алақаны
Dialogue: 0,0:08:49.50,0:08:52.51,Default,,0,0,0,,Жүгіруден бұрын баламды күту күнделікті әдетке айналды.
Dialogue: 0,0:08:52.67,0:08:55.43,Default,,0,0,0,,Мен мұны білмедім
Dialogue: 0,0:08:55.63,0:08:58.26,Default,,0,0,0,,Келесі жолы маған ит үйретуді үйрет.
Dialogue: 0,0:09:02.27,0:09:05.02,Default,,0,0,0,,Әкім менің үйімде не істеп жатыр?
Dialogue: 0,0:09:11.82,0:09:14.61,Default,,0,0,0,,Осы нысанға көмек
Dialogue: 0,0:09:17.62,0:09:18.57,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:09:18.74,0:09:20.24,Default,,0,0,0,,Ай-чанке
Dialogue: 0,0:09:24.33,0:09:26.25,Default,,0,0,0,,Мұнда ерекше ештеңе жоқ.
Dialogue: 0,0:09:26.46,0:09:28.21,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:28.38,0:09:29.50,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:09:29.67,0:09:31.25,Default,,0,0,0,,Бәрі жақсы сияқты
Dialogue: 0,0:09:31.42,0:09:34.09,Default,,0,0,0,,Бірақ барлық жерде сиреналар естіледі.
Dialogue: 0,0:09:34.26,0:09:38.05,Default,,0,0,0,,Мен таңертең жаңалықтарды көремін. Ұйықтау.
Dialogue: 0,0:09:38.89,0:09:40.76,Default,,0,0,0,,Сіз сенімдісіз бе, мэр?
Dialogue: 0,0:09:41.31,0:09:44.68,Default,,0,0,0,,Оған көмектесу мүмкін емес, бұл болашақты өзгерту.
Dialogue: 0,0:09:44.85,0:09:48.10,Default,,0,0,0,,Бұл болашақ күнделік зерттеу сатысында
Dialogue: 0,0:09:48.27,0:09:50.77,Default,,0,0,0,,Менің өлімім алдын ала айтылған.
Dialogue: 0,0:09:50.98,0:09:56.15,Default,,0,0,0,,Ойын басталмай тұрып ойынның нәтижесін болжауға бола ма?
Dialogue: 0,0:09:57.82,0:09:59.37,Default,,0,0,0,,1-күнделік бойынша
Dialogue: 0,0:09:59.57,0:10:02.49,Default,,0,0,0,,Менің болашақ адамым ойыннан жеңіліп қалған сияқты.
Dialogue: 0,0:10:02.66,0:10:07.21,Default,,0,0,0,,Оның үстіне жеңімпаздар болашақты құтқармай, өткенге қайтады.
Dialogue: 0,0:10:07.71,0:10:12.75,Default,,0,0,0,,Біз құдайларды таңдаудың бұл әдісін қайта қарауымыз керек.
Dialogue: 0,0:10:20.97,0:10:24.35,Default,,0,0,0,,Иесінің болашағы домино сияқты өзгереді
Dialogue: 0,0:10:24.60,0:10:27.06,Default,,0,0,0,,Осы қарқынмен екінші айналымды қайталау былай тұрсын.
Dialogue: 0,0:10:27.10,0:10:29.44,Default,,0,0,0,,Ойынның өмір сүруіне қауіп төніп тұр.
Dialogue: 0,0:10:31.61,0:10:36.19,Default,,0,0,0,,Мен Юккимен бірге болғым келеді
Dialogue: 0,0:10:37.95,0:10:38.70,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:10:39.86,0:10:42.07,Default,,0,0,0,,Сондықтан мен сені өлтіремін
Dialogue: 0,0:10:54.63,0:10:55.92,Default,,0,0,0,,Юно
Dialogue: 0,0:10:57.84,0:10:59.76,Default,,0,0,0,,Папа папа
Dialogue: 0,0:11:00.38,0:11:01.14,Default,,0,0,0,,Иә
Dialogue: 0,0:11:02.14,0:11:04.81,Default,,0,0,0,,Мен бірдеңе істеуім керек сияқты.
Dialogue: 0,0:11:05.39,0:11:06.47,Default,,0,0,0,,Юки-кун
Dialogue: 0,0:11:06.85,0:11:10.14,Default,,0,0,0,,Мен оның не екенін білмеймін, бірақ
Dialogue: 0,0:11:10.77,0:11:13.11,Default,,0,0,0,,Бірақ бұл басқаша.
Dialogue: 0,0:11:14.27,0:11:15.57,Default,,0,0,0,,Сіз ол туралы айтып отырсыз ба?
Dialogue: 0,0:11:16.86,0:11:20.61,Default,,0,0,0,,Юки-кунның есімі есімде жоқ сүйікті қызы
Dialogue: 0,0:11:23.62,0:11:24.28,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:11:24.49,0:11:25.28,Default,,0,0,0,,Юно
Dialogue: 0,0:11:26.54,0:11:27.16,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:11:28.20,0:11:29.16,Default,,0,0,0,,Не керек, Крюгер мырза?
Dialogue: 0,0:11:29.46,0:11:30.21,Default,,0,0,0,,Сайка
Dialogue: 0,0:11:31.21,0:11:32.08,Default,,0,0,0,,Юно
Dialogue: 0,0:11:35.25,0:11:36.92,Default,,0,0,0,,Анам
Dialogue: 0,0:11:38.21,0:11:39.17,Default,,0,0,0,,Юно
Dialogue: 0,0:11:40.59,0:11:44.22,Default,,0,0,0,,Юки-кун, біз сенің жағындамыз.
Dialogue: 0,0:11:44.39,0:11:47.51,Default,,0,0,0,,Сен біздің баламызсың
Dialogue: 0,0:11:50.68,0:11:51.48,Default,,0,0,0,,Бір күні
Dialogue: 0,0:11:52.73,0:11:57.11,Default,,0,0,0,,Мен бір күні әкем мен шешемді түсіне алатыныма сендім.
Dialogue: 0,0:11:58.40,0:12:00.95,Default,,0,0,0,,Бірақ бұл маған ешқашан келмеді.
Dialogue: 0,0:12:02.40,0:12:03.28,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:12:04.11,0:12:06.12,Default,,0,0,0,,Бұл жерді жарып жіберген сен бе?
Dialogue: 0,0:12:06.28,0:12:07.20,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:12:08.49,0:12:11.46,Default,,0,0,0,,Болашақты үшінші рет өзгертсем де, мен бұл балаға көмектесемін.
Dialogue: 0,0:12:13.71,0:12:15.92,Default,,0,0,0,,Өйткені Юкки болашақты өзгертті
Dialogue: 0,0:12:16.42,0:12:18.59,Default,,0,0,0,,Үшеуміз бірге бола алдық.
Dialogue: 0,0:12:19.71,0:12:22.01,Default,,0,0,0,,Юкки керемет
Dialogue: 0,0:12:24.09,0:12:26.22,Default,,0,0,0,,Есіміңізді есте сақтаңыз
Dialogue: 0,0:12:26.89,0:12:29.39,Default,,0,0,0,,Сен қазір есіңе ал, Юки-кун.
Dialogue: 0,0:12:30.14,0:12:35.81,Default,,0,0,0,,Өйткені мен жоғалтқан армандардан маңыздырақ нәрсені таңдадым.
Dialogue: 0,0:12:36.52,0:12:38.57,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:12:39.23,0:12:40.82,Default,,0,0,0,,Бар, Юки-кун.
Dialogue: 0,0:12:41.49,0:12:43.86,Default,,0,0,0,,Өз жолыңмен жүр
Dialogue: 0,0:12:47.70,0:12:51.45,Default,,0,0,0,,Мен зұлым адам сияқтымын
Dialogue: 0,0:12:53.12,0:12:54.54,Default,,0,0,0,,Мен қызғанамын.
Dialogue: 0,0:12:55.92,0:12:59.67,Default,,0,0,0,,Жақсы, мен үшеуіңді де өлтіремін.
Dialogue: 0,0:13:00.25,0:13:00.92,Default,,0,0,0,,Юно
Dialogue: 0,0:13:01.63,0:13:06.93,Default,,0,0,0,,Сізге де ұнайтын адам бар ма?
Dialogue: 0,0:13:07.80,0:13:08.51,Default,,0,0,0,,Иә
Dialogue: 0,0:13:09.68,0:13:12.06,Default,,0,0,0,,Мен Юккиді жақсы көремін
Dialogue: 0,0:13:12.27,0:13:12.85,Default,,0,0,0,,Юно
Dialogue: 0,0:13:13.27,0:13:14.81,Default,,0,0,0,,Маған Юкки ұнайды
Dialogue: 0,0:13:14.94,0:13:15.48,Default,,0,0,0,,Юно
Dialogue: 0,0:13:16.48,0:13:17.90,Default,,0,0,0,,Мен Юккиді жақсы көремін
Dialogue: 0,0:13:18.23,0:13:19.02,Default,,0,0,0,,Юно
Dialogue: 0,0:13:19.94,0:13:21.53,Default,,0,0,0,,Мен Юккиді жақсы көремін
Dialogue: 0,0:13:21.69,0:13:22.32,Default,,0,0,0,,Юно
Dialogue: 0,0:13:23.53,0:13:24.90,Default,,0,0,0,,Мен өлсем де
Dialogue: 0,0:13:25.24,0:13:26.36,Default,,0,0,0,,Юно
Dialogue: 0,0:13:34.62,0:13:35.71,Default,,0,0,0,,Сид?
Dialogue: 0,0:13:49.89,0:13:50.51,Default,,0,0,0,,Юно
Dialogue: 0,0:13:51.76,0:13:52.47,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:13:52.97,0:13:55.43,Default,,0,0,0,,Мен сені құтқару үшін келдім.
Dialogue: 0,0:13:58.27,0:14:01.07,Default,,0,0,0,,Тәңірім – менің екінші тіземдегі.
Dialogue: 0,0:14:01.27,0:14:03.19,Default,,0,0,0,,Біраз уақыттан кейін бірінші рет
Dialogue: 0,0:14:03.78,0:14:05.82,Default,,0,0,0,,Мен допқа мөрленгеннен бері
Dialogue: 0,0:14:05.99,0:14:11.49,Default,,0,0,0,,Мен оның көшірме болғандықтан, оның өзіне мөрленетінін ешқашан күткен емеспін.
Dialogue: 0,0:14:15.58,0:14:17.04,Default,,0,0,0,,О, ауырады
Dialogue: 0,0:14:18.21,0:14:18.92,Default,,0,0,0,,Олардың өлімі ұйым ішінде дүрбелең тудырды
Dialogue: 0,0:14:19.58,0:14:24.67,Default,,0,0,0,,Сен мені бақытты арман әлемінен таңдадың
Dialogue: 0,0:14:27.05,0:14:28.01,Default,,0,0,0,,Юно
Dialogue: 0,0:14:28.93,0:14:30.39,Default,,0,0,0,,Мені осылайша пышақтай бер
Dialogue: 0,0:14:33.31,0:14:33.97,Default,,0,0,0,,Юно
Dialogue: 0,0:14:34.39,0:14:35.18,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:14:36.73,0:14:37.89,Default,,0,0,0,,Сіз білесіз.
Dialogue: 0,0:14:38.60,0:14:40.52,Default,,0,0,0,,Юноның орны бұл жерде емес.
Dialogue: 0,0:14:42.15,0:14:42.82,Default,,0,0,0,,Иә
Dialogue: 0,0:14:43.73,0:14:44.65,Default,,0,0,0,,бірақ манга суретшісінің үйіне алты минут ерте бару—
Dialogue: 0,0:14:45.90,0:14:48.28,Default,,0,0,0,,Мен өліп, сендерге орын жасаймын
Dialogue: 0,0:14:57.04,0:15:01.08,Default,,0,0,0,,Мен түсінемін, егер Юкки мұны қалайды.
Dialogue: 0,0:15:01.88,0:15:02.88,Default,,0,0,0,,Шиметоножа
Dialogue: 0,0:15:03.38,0:15:05.84,Default,,0,0,0,,1-ші өлтірсең де бәрібір.
Dialogue: 0,0:15:06.76,0:15:08.13,Default,,0,0,0,,Мен көптеген адамдарды өлтірдім.
Dialogue: 0,0:15:09.13,0:15:12.09,Default,,0,0,0,,Бірақ қазір Юно жалғыз
Dialogue: 0,0:15:12.26,0:15:14.01,Default,,0,0,0,,Сен ақымақ Юкки
Dialogue: 0,0:15:21.85,0:15:22.56,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан Қабырғаны бұзып өтті,
Dialogue: 0,0:15:25.02,0:15:26.69,Default,,0,0,0,,Мен осында қаламын
Dialogue: 0,0:15:27.53,0:15:28.36,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:29.07,0:15:32.66,Default,,0,0,0,,Мен саған айттым, мен сені пышақтай алмаймын.
Dialogue: 0,0:15:33.07,0:15:33.74,Default,,0,0,0,,Юно
Dialogue: 0,0:15:35.91,0:15:37.08,Default,,0,0,0,,Мен шақпаймын
Dialogue: 0,0:15:38.37,0:15:40.12,Default,,0,0,0,,Бұл болашақ
Dialogue: 0,0:15:40.96,0:15:41.83,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:15:42.75,0:15:46.92,Default,,0,0,0,,Эй, мені сүй, Юкки.
Dialogue: 0,0:15:48.67,0:15:49.38,Default,,0,0,0,,Иә
Dialogue: 0,0:15:52.80,0:15:55.51,Default,,0,0,0,,Бұл менің орным
Dialogue: 0,0:15:59.77,0:16:05.23,Default,,0,0,0,,Сіздің сүйісуіңіз қайтадан жақсарды, Юкки.
Dialogue: 0,0:16:11.61,0:16:12.36,Default,,0,0,0,,Юно
Dialogue: 0,0:16:15.49,0:16:18.74,Default,,0,0,0,,Жеңімпаз 1-ші Юкитеру Амано деп танылды
Dialogue: 0,0:16:19.41,0:16:21.96,Default,,0,0,0,,Менің уақытым жоқ, мен бірден 1-ші ұшамын
Dialogue: 0,0:16:26.13,0:16:26.92,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:16:28.75,0:16:29.42,Default,,0,0,0,,Юно
Dialogue: 0,0:16:31.09,0:16:32.13,Default,,0,0,0,,Юно
Dialogue: 0,0:17:14.55,0:17:17.97,Default,,0,0,0,,Минене Амагаре - Жапонияға еніп кеткен сияқты халықаралық террорист.
Dialogue: 0,0:17:18.14,0:17:19.60,Default,,0,0,0,,Әлі қашуда
Dialogue: 0,0:17:19.85,0:17:22.77,Default,,0,0,0,,Сакурами қалалық полиция бөлімшесі қоршау орнатып, оның тұрған жерін іздеп жатыр.
Dialogue: 0,0:17:22.93,0:17:23.43,Default,,0,0,0,,Амагаре Минеха
Dialogue: 0,0:17:23.06,0:17:24.31,Default,,0,0,0,,О, мен қолымнан келгеннің бәрін жасаймын, Минене Амагаре, үшінші айналымда.
Dialogue: 0,0:17:24.31,0:17:27.10,Default,,0,0,0,,О, мен қолымнан келгеннің бәрін жасаймын. Мен үшінші айналымдамын.
Dialogue: 0,0:17:27.27,0:17:29.11,Default,,0,0,0,,Бұл адамдар туралы емес.
Dialogue: 0,0:17:29.27,0:17:32.69,Default,,0,0,0,,Мені қайтадан ұстау үшін бар күшіңді сал.
Dialogue: 0,0:17:32.69,0:17:34.44,Default,,0,0,0,,Әрине болар едім.
Dialogue: 0,0:17:39.28,0:17:40.49,Default,,0,0,0,,Иә, бұл Нисидзима.
Dialogue: 0,0:17:40.58,0:17:43.25,Default,,0,0,0,,Сіз кешіктіңіз. Ол сені алып кетуге келуі керек.
Dialogue: 0,0:17:43.45,0:17:45.41,Default,,0,0,0,,Кешіріңіз, мен бірден келемін.
Dialogue: 0,0:17:46.37,0:17:47.21,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:17:53.34,0:17:56.55,Default,,0,0,0,,Мен қайтып келдім. Қалыңыз қалай?
Dialogue: 0,0:17:58.43,0:18:01.14,Default,,0,0,0,,Сен де жалқау жігітсің.
Dialogue: 0,0:18:06.31,0:18:08.98,Default,,0,0,0,,Сонда, бұл шаш аз
Dialogue: 0,0:18:09.19,0:18:10.77,Default,,0,0,0,,Мен оны қалдырамын.
Dialogue: 0,0:18:10.94,0:18:16.15,Default,,0,0,0,,​​Бірақ Марко қазірден бастап көп жұмыс істеуі керек.
Dialogue: 0,0:18:16.32,0:18:18.45,Default,,0,0,0,,Кеттік, кеттік
Dialogue: 0,0:18:24.12,0:18:26.29,Default,,0,0,0,,Жарайды, қара.
Dialogue: 0,0:18:28.04,0:18:29.33,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:18:46.22,0:18:47.93,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:18:48.56,0:18:50.10,Default,,0,0,0,,Бірақ мен Юлий деген адам емеспін.
Dialogue: 0,0:18:50.48,0:18:52.44,Default,,0,0,0,,Иә, кеттік.
Dialogue: 0,0:18:52.86,0:18:54.73,Default,,0,0,0,,Бүгін қайдасың?
Dialogue: 0,0:18:54.90,0:18:57.03,Default,,0,0,0,,Бұл әлі құпия
Dialogue: 0,0:19:08.08,0:19:10.54,Default,,0,0,0,,Олар не істеп жатыр?
Dialogue: 0,0:19:10.67,0:19:12.96,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:19:13.17,0:19:16.38,Default,,0,0,0,,Ей, сыртқа шығатын кез келді.
Dialogue: 0,0:19:17.38,0:19:18.30,Default,,0,0,0,,Yes
Dialogue: 0,0:19:26.18,0:19:29.68,Default,,0,0,0,,Бақылаушының есебі қандай?
Dialogue: 0,0:19:30.35,0:19:34.40,Default,,0,0,0,,Басқа өлшемдерден келетін кедергі толығымен жойылған сияқты.
Dialogue: 0,0:19:34.65,0:19:35.98,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:41.74,0:19:44.62,Default,,0,0,0,,Юно отбасымен қалай жүрді?
Dialogue: 0,0:19:48.08,0:19:49.75,Default,,0,0,0,,Бұл күнделік не?
Dialogue: 0,0:19:49.91,0:19:52.17,Default,,0,0,0,,Иә Фотосуреттері бар отбасы күнделігі
Dialogue: 0,0:19:52.33,0:19:53.96,Default,,0,0,0,,Планетарийге барды
Dialogue: 0,0:19:54.13,0:19:57.84,Default,,0,0,0,,Мен планетарийлер сияқты нәрселерді қатты сағындым.
Dialogue: 0,0:19:58.00,0:19:59.09,Default,,0,0,0,,Мишите Мишите
Dialogue: 0,0:19:59.26,0:20:01.84,Default,,0,0,0,,Телефонда күнделік жүргізу сирек кездеседі.
Dialogue: 0,0:20:02.01,0:20:07.60,Default,,0,0,0,,Иә, бірақ кейде бір нәрсені ұмытып кеткендей боламын.
Dialogue: 0,0:20:07.76,0:20:09.98,Default,,0,0,0,,Нені ұмытасың?
Dialogue: 0,0:20:10.98,0:20:12.23,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:20:12.39,0:20:13.65,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:13.85,0:20:17.98,Default,,0,0,0,,Бірақ бұл өте маңызды
Dialogue: 0,0:20:19.48,0:20:20.24,Default,,0,0,0,,Юно
Dialogue: 0,0:20:34.33,0:20:38.96,Default,,0,0,0,,Менің құдай болғаныма 10 000 жылдай болған шығар.
Dialogue: 0,0:20:42.88,0:20:48.14,Default,,0,0,0,,Юкитеру Ноу Мен бұл манганы шамамен 10 000 рет оқыдым.
Dialogue: 0,0:20:48.31,0:20:50.02,Default,,0,0,0,,Мен одан шаршадым
Dialogue: 0,0:20:50.22,0:20:53.31,Default,,0,0,0,,Мен басқа нәрсемен ойнағым келеді.
Dialogue: 0,0:20:53.48,0:20:56.98,Default,,0,0,0,,Оны Құдайдың құдіретімен жасай алмайсың ба?
Dialogue: 0,0:20:58.02,0:20:59.48,Default,,0,0,0,,Егер Юно жоқ болса
Dialogue: 0,0:20:59.98,0:21:02.03,Default,,0,0,0,,Дүниенің кез келген түрін жасаудың мәні жоқ.
Dialogue: 0,0:21:02.24,0:21:04.65,Default,,0,0,0,,Егер мен шатассам, көмектесе алмайды деп ойлаймын.
Dialogue: 0,0:21:04.82,0:21:07.41,Default,,0,0,0,,Екінші және үшінші раундтар бөлінді.
Dialogue: 0,0:21:07.57,0:21:10.79,Default,,0,0,0,,Мен әйелді өзім жасауым керек деп ойлаймын.
Dialogue: 0,0:21:10.95,0:21:14.16,Default,,0,0,0,,Мурумуру да біреуді ұнататыныңызды түсінеді.
Dialogue: 0,0:21:14.33,0:21:16.67,Default,,0,0,0,,Бұл жерде тек Иеміз бар.
Dialogue: 0,0:21:16.83,0:21:19.46,Default,,0,0,0,,Оған қоса, сен маған ұнайсың.
Dialogue: 0,0:21:19.63,0:21:22.21,Default,,0,0,0,,Бұл басқаша.
Dialogue: 0,0:21:24.13,0:21:27.18,Default,,0,0,0,,Қызық, содан бері үшінші аптада Юноға не болды?
Dialogue: 0,0:21:28.01,0:21:29.89,Default,,0,0,0,,Сіз бақыттысыз ба?
Dialogue: 0,0:21:30.72,0:21:32.97,Default,,0,0,0,,Бұл уайым сізге енді ешқашан жетпейді.
Dialogue: 0,0:21:34.06,0:21:36.31,Default,,0,0,0,,Мұның бәрі баяғыда болды.
Dialogue: 0,0:21:37.56,0:21:39.19,Default,,0,0,0,,Менде қалды
Dialogue: 0,0:21:40.07,0:21:41.98,Default,,0,0,0,,Тек осы соңғы күнделік
Dialogue: 0,0:21:43.48,0:21:48.48,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
