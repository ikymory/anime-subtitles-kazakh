Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.00,0:00:05.17,Default,,0,0,0,,Ах, бай адамдар осындай кемені бос уақыттарында пайдаланады —
Dialogue: 0,0:00:05.17,0:00:07.17,Default,,0,0,0,,Хмм….
Dialogue: 0,0:00:10.01,0:00:12.51,Default,,0,0,0,,Хмм….
Dialogue: 0,0:00:12.51,0:00:15.01,Default,,0,0,0,,<Лиза: Уақыттың өзгермелі ағынында➡
Dialogue: 0,0:00:15.01,0:00:18.35,Default,,0,0,0,,Өзгеретін және өзгеріссіз қалатын заттар бар.
Dialogue: 0,0:00:18.35,0:00:21.52,Default,,0,0,0,,Мысалы...
Dialogue: 0,0:00:21.52,0:00:27.36,Default,,0,0,0,,Жылы футоннан құтылудың қиындығы қазір де, өткенде де бірдей>
Dialogue: 0,0:00:27.36,0:00:30.53,Default,,0,0,0,,📢Сәлем, Лиза!
Dialogue: 0,0:00:30.53,0:00:33.36,Default,,0,0,0,,📢Оянбасаңыз, түскі ас болады.
Dialogue: 0,0:00:33.36,0:00:37.20,Default,,0,0,0,,Бүгін демалыс күні. 📢Жоспарларыңыз бар, солай ма?
Dialogue: 0,0:00:37.20,0:00:39.53,Default,,0,0,0,,А, түсіндім.
Dialogue: 0,0:00:39.53,0:00:45.71,Default,,0,0,0,,Хмм…. 《Менің басым мен денемді оятыңыз》
Dialogue: 0,0:00:45.71,0:00:48.54,Default,,0,0,0,,(шайлау дыбысы)
Dialogue: 0,0:00:48.54,0:00:52.71,Default,,0,0,0,,《Сыртқа шығып киіміңді ауыстыр.
Dialogue: 0,0:00:52.71,0:00:54.92,Default,,0,0,0,,Бүгін байлайтын шығармын...》
Dialogue: 0,0:00:56.89,0:00:59.19,Default,,0,0,0,,《Бүгін байлап қояйық! 》
Dialogue: 0,0:02:36.18,0:02:39.89,Default,,0,0,0,,《Лиза: Менің демалыс күнім бір кесе кофеден басталады》
Dialogue: 0,0:02:42.52,0:02:44.86,Default,,0,0,0,,《Психикалық кеңістікті толықтырады》
Dialogue: 0,0:02:44.86,0:02:47.03,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз. Ах...
Dialogue: 0,0:02:47.03,0:02:50.53,Default,,0,0,0,,Уау.
Dialogue: 0,0:02:50.53,0:02:52.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:52.53,0:02:54.54,Default,,0,0,0,,<Лиза: Қант беру>
Dialogue: 0,0:02:54.54,0:02:57.21,Default,,0,0,0,,Уақытыңызды бөліңіз.
Dialogue: 0,0:02:57.21,0:02:59.98,Default,,0,0,0,,Ас үшін рахмет!
Dialogue: 0,0:02:59.98,0:03:02.81,Default,,0,0,0,,Ах! Хмм….
Dialogue: 0,0:03:02.81,0:03:05.15,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:03:05.15,0:03:08.65,Default,,0,0,0,,<Лиза: үшін қайта жеткізілді.
Dialogue: 0,0:03:08.65,0:03:12.49,Default,,0,0,0,,Жай босаңсуға болмайды.
Dialogue: 0,0:03:12.49,0:03:14.49,Default,,0,0,0,,Себебі…＞
Dialogue: 0,0:03:14.49,0:03:17.49,Default,,0,0,0,,📢Нілдің арнайы экономикалық аймағы Жаңа әлем –➡
Dialogue: 0,0:03:17.49,0:03:20.50,Default,,0,0,0,,Біз мүлдем жаңа өмір салтын ұсынамыз.
Dialogue: 0,0:03:20.50,0:03:23.50,Default,,0,0,0,,<Лиза: Өйткені! Өйткені! ＞
Dialogue: 0,0:03:23.50,0:03:26.84,Default,,0,0,0,,📢Лиза Ыстық судың температурасы дұрыс па?
Dialogue: 0,0:03:26.84,0:03:29.84,Default,,0,0,0,,Ах! Ах...
Dialogue: 0,0:03:29.84,0:03:33.18,Default,,0,0,0,,Өте ыстық болды ма?
Dialogue: 0,0:03:33.18,0:03:36.18,Default,,0,0,0,,📢Жаңа кілегей қоссаңыз, бетперде болады дейді.
Dialogue: 0,0:03:36.18,0:03:38.35,Default,,0,0,0,,Оны алдау деп атамаңыз.
Dialogue: 0,0:03:38.35,0:03:41.35,Default,,0,0,0,,📢Лиза, ашуланба.
Dialogue: 0,0:03:41.35,0:03:43.85,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:03:43.85,0:03:49.86,Default,,0,0,0,,<Лиза: Өйткені ертең 14 ақпан>
Dialogue: 0,0:03:49.86,0:03:55.20,Default,,0,0,0,,Өтінемін. Лоизаның шоколад ассортименті.
Dialogue: 0,0:03:55.20,0:03:58.53,Default,,0,0,0,,О, сәлем.
Dialogue: 0,0:03:58.53,0:04:01.64,Default,,0,0,0,,Бүгін ауруханаға келгендердің бәріне беремін!
Dialogue: 0,0:04:01.64,0:04:04.97,Default,,0,0,0,,Жоқ, мен оны Лиза-чаннан алғаныма сенбеймін➡
Dialogue: 0,0:04:04.97,0:04:07.31,Default,,0,0,0,,Ағай: Шаршадым.
Dialogue: 0,0:04:07.31,0:04:09.31,Default,,0,0,0,,Сенің сүйікті ісің бар ма?
Dialogue: 0,0:04:09.31,0:04:12.15,Default,,0,0,0,,Бүгін ауруханаға келгендердің бәріне беремін!
Dialogue: 0,0:04:12.15,0:04:15.48,Default,,0,0,0,,Уа... 《Қайталау》
Dialogue: 0,0:04:15.48,0:04:19.65,Default,,0,0,0,,Судо мырза!
Dialogue: 0,0:04:19.65,0:04:22.49,Default,,0,0,0,,Бүгін қандай күн екенін білесің бе?
Dialogue: 0,0:04:22.49,0:04:25.16,Default,,0,0,0,,📢Сұрақтарыңызға жауап беремін. Бүгін қасиетті...
Dialogue: 0,0:04:25.16,0:04:29.16,Default,,0,0,0,,Мен Джейден сұрамадым! 📢Кешірім сұраймын.
Dialogue: 0,0:04:29.16,0:04:31.67,Default,,0,0,0,,Иә, мен білемін.
Dialogue: 0,0:04:31.67,0:04:37.01,Default,,0,0,0,,Бұл шоколадты ілгерілету күні 20 ғасырдағы кондитерлік компаниялар бастаған күн емес пе?
Dialogue: 0,0:04:37.01,0:04:42.68,Default,,0,0,0,,Иә, иә, шынын айтайық, бұл Валентин күні.
Dialogue: 0,0:04:42.68,0:04:45.01,Default,,0,0,0,,Оны ала аламын ба? әрине.
Dialogue: 0,0:04:45.01,0:04:47.68,Default,,0,0,0,,Бүгін келгендердің бәріне беремін.
Dialogue: 0,0:04:47.68,0:04:50.85,Default,,0,0,0,,Цк... Айтпақшы, биыл➡
Dialogue: 0,0:04:50.85,0:04:54.02,Default,,0,0,0,,Сізге алғысымды білдіргім келеді...
Dialogue: 0,0:04:54.02,0:04:56.02,Default,,0,0,0,,Джан!
Dialogue: 0,0:04:56.02,0:05:01.03,Default,,0,0,0,,Сатып алған шоколадтарымнан бөлек, шоколадты торт жасадым.
Dialogue: 0,0:05:06.47,0:05:08.47,Default,,0,0,0,,Мұны да бердіңіз бе?
Dialogue: 0,0:05:08.47,0:05:10.64,Default,,0,0,0,,Ах, у... Ах...
Dialogue: 0,0:05:10.64,0:05:14.31,Default,,0,0,0,,Негізі науқастарға да таратсам ба деп ойладым➡
Dialogue: 0,0:05:14.31,0:05:19.82,Default,,0,0,0,,Мен тамақ гигиенасы мәселелерін де ойладым...
Dialogue: 0,0:05:19.82,0:05:25.82,Default,,0,0,0,,Жарайды... Мұғалім... Бұл тек мұғалімге арналған сыйлық...
Dialogue: 0,0:05:25.82,0:05:28.99,Default,,0,0,0,,《Мен тамақтанып жатырмын! 》 Иә?
Dialogue: 0,0:05:28.99,0:05:32.33,Default,,0,0,0,,Жоқ! Қант қатып қалды ма?
Dialogue: 0,0:05:32.33,0:05:37.53,Default,,0,0,0,,Кешіріңіз. Мм... тамақ ішуге өзіңізді мәжбүрлеудің қажеті жоқ...
Dialogue: 0,0:05:39.50,0:05:41.50,Default,,0,0,0,,Хмм….
Dialogue: 0,0:05:41.50,0:05:43.61,Default,,0,0,0,,Сәлем Лиза. иә?
Dialogue: 0,0:05:46.51,0:05:48.84,Default,,0,0,0,,Дәмді және жаман➡
Dialogue: 0,0:05:48.84,0:05:52.01,Default,,0,0,0,,Егер сіз роботқа бірдеңе жасауға рұқсат етсеңіз, қателеспейсіз.
Dialogue: 0,0:05:52.01,0:05:56.35,Default,,0,0,0,,Бірақ Лизаның көп еңбек еткен оқиғасы➡
Dialogue: 0,0:05:56.35,0:05:58.35,Default,,0,0,0,,Роботтар жасай алмайды.
Dialogue: 0,0:05:58.35,0:06:01.62,Default,,0,0,0,,Әр түрлі заттарды бірден жеу➡
Dialogue: 0,0:06:01.62,0:06:04.13,Default,,0,0,0,,Бұл жай ғана адам өмірі деп ойлаймын.
Dialogue: 0,0:06:04.13,0:06:06.96,Default,,0,0,0,,Торт үшін рахмет.
Dialogue: 0,0:06:06.96,0:06:10.63,Default,,0,0,0,,С... Мұғалім!
Dialogue: 0,0:06:10.63,0:06:15.14,Default,,0,0,0,,Сонымен... саған ұнады ма?
Dialogue: 0,0:06:17.14,0:06:19.14,Default,,0,0,0,,Дәмді және жаман➡
Dialogue: 0,0:06:19.14,0:06:22.31,Default,,0,0,0,,Егер сіз роботқа бірдеңе жасауға рұқсат етсеңіз, қателеспейсіз.
Dialogue: 0,0:06:22.31,0:06:24.81,Default,,0,0,0,,Гарн! 《Қайталаңыз! 》
Dialogue: 0,0:06:24.81,0:06:28.98,Default,,0,0,0,,Бұл ойында жеңіске жету және матчта жеңілу сияқты.
Dialogue: 0,0:06:28.98,0:06:31.99,Default,,0,0,0,,Мен бұл ұқсастықты түсінбеймін, бірақ...
Dialogue: 0,0:06:31.99,0:06:33.99,Default,,0,0,0,,Мен өзімді жоғалтқандай сезінемін.
Dialogue: 0,0:06:37.49,0:06:41.00,Default,,0,0,0,,Ха... Егер сіз тырыссаңыз, сіз жасай алатын керемет нәрселер ➡
Dialogue: 0,0:06:41.00,0:06:44.17,Default,,0,0,0,,Мен сізге көрсетуді жоспарлап едім.
Dialogue: 0,0:06:44.17,0:06:47.67,Default,,0,0,0,,Сезімдер өзара.
Dialogue: 0,0:06:47.67,0:06:52.51,Default,,0,0,0,,Әрине. мүмкін. Мүмкін.
Dialogue: 0,0:06:52.51,0:06:56.34,Default,,0,0,0,,Хехехе, Саба-чан, бүгінгі күн үшін рахмет.
Dialogue: 0,0:06:56.34,0:06:59.85,Default,,0,0,0,,Мен сізге күтпеген жерден хабарлассам да, сіз маған торт сатып алдыңыз.
Dialogue: 0,0:06:59.85,0:07:01.78,Default,,0,0,0,,Жарайды. Жарайды.
Dialogue: 0,0:07:01.78,0:07:05.29,Default,,0,0,0,,Айтпақшы, Саба-чан ше? Сіз біреуге шоколад бердіңіз бе?
Dialogue: 0,0:07:05.29,0:07:07.79,Default,,0,0,0,,Ах... иә.
Dialogue: 0,0:07:07.79,0:07:10.79,Default,,0,0,0,,Мен оны естігім келеді! Мен бұл оқиғаны естігім келеді!
Dialogue: 0,0:07:10.79,0:07:14.80,Default,,0,0,0,,А... Мен тым көп жедім.
Dialogue: 0,0:07:14.80,0:07:18.47,Default,,0,0,0,,Дәлірек айтсам, мен де соған сенемін деп ойлаймын.
Dialogue: 0,0:07:18.47,0:07:20.47,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:07:20.47,0:07:23.14,Default,,0,0,0,,<Лиза: Әулие Валентин күні.
Dialogue: 0,0:07:23.14,0:07:25.81,Default,,0,0,0,,Істері дұрыс болмай қалған кездер болды➡
Dialogue: 0,0:07:25.81,0:07:29.81,Default,,0,0,0,,Мен сол достарыммен сөйлесіп, көңілді болдым...
Dialogue: 0,0:07:29.81,0:07:32.11,Default,,0,0,0,,Ал, жарайды делік! ＞
Dialogue: 0,0:07:34.82,0:07:38.32,Default,,0,0,0,,Сіз бірдеңені қайтарып жатырсыз ба? Иә жақсы.
Dialogue: 0,0:07:38.32,0:07:42.16,Default,,0,0,0,,Шектеулі шығарылымдағы қолдан жасалған ірімшік торттары туралы не айтасыз?
Dialogue: 0,0:07:42.16,0:07:46.83,Default,,0,0,0,,Шеберлер әр бұйымды өз қолдарымен жасайды.
Dialogue: 0,0:07:46.83,0:07:49.13,Default,,0,0,0,,《Қолмен жасалған...》
Dialogue: 0,0:07:58.17,0:08:02.28,Default,,0,0,0,,《Менің ойымша, жоспарлау маңызды.
Dialogue: 0,0:08:02.28,0:08:05.11,Default,,0,0,0,,Уақыт жарысы процесі т.б.
Dialogue: 0,0:08:05.11,0:08:08.62,Default,,0,0,0,,Температураны реттеу маңызды болатын процестер➡
Dialogue: 0,0:08:08.62,0:08:13.96,Default,,0,0,0,,Әрқайсысын ұқсатып, қажетті дайындықтарды жасаңыз》
Dialogue: 0,0:08:13.96,0:08:15.96,Default,,0,0,0,,(таймер дыбысы)
Dialogue: 0,0:08:20.30,0:08:22.60,Default,,0,0,0,,Иә, процедура аяқталды.
Dialogue: 0,0:08:24.63,0:08:27.80,Default,,0,0,0,,безендіруді бастаңыз.
Dialogue: 0,0:08:27.80,0:08:29.97,Default,,0,0,0,,Иә, бұл өз кезегінде.
Dialogue: 0,0:08:29.97,0:08:33.14,Default,,0,0,0,,Уау, рахмет.
Dialogue: 0,0:08:33.14,0:08:36.14,Default,,0,0,0,,Мен оны маған бергендердің бәріне қайтарамын.
Dialogue: 0,0:08:36.14,0:08:38.15,Default,,0,0,0,,Хехехе.
Dialogue: 0,0:08:38.15,0:08:42.32,Default,,0,0,0,,Оны маған бергендердің бәріне қайтарып беремін!
Dialogue: 0,0:08:42.32,0:08:44.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:44.32,0:08:47.16,Default,,0,0,0,,Судо мырза!
Dialogue: 0,0:08:47.16,0:08:49.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:49.16,0:08:51.99,Default,,0,0,0,,Бүгін қандай күн екенін білесің бе?
Dialogue: 0,0:08:51.99,0:08:55.66,Default,,0,0,0,,Кондитерлік компанияның жарнамалық күні 2-бөлім➡
Dialogue: 0,0:08:55.66,0:08:59.33,Default,,0,0,0,,Бұл ақ күн. (Жарық) Эй, түсіндім.
Dialogue: 0,0:08:59.33,0:09:01.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:01.94,0:09:03.94,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:03.94,0:09:05.94,Default,,0,0,0,,Мен шай дайындаймын!
Dialogue: 0,0:09:08.78,0:09:12.28,Default,,0,0,0,,Мен де дәмін татсам болады ма? Біраз ғана.
Dialogue: 0,0:09:15.95,0:09:19.45,Default,,0,0,0,,Уау, дәмді.
Dialogue: 0,0:09:19.45,0:09:22.29,Default,,0,0,0,,Бұл өте дәмді, мұғалім.
Dialogue: 0,0:09:22.29,0:09:24.96,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:24.96,0:09:28.63,Default,,0,0,0,,Мұны қай дүкеннен сатып алдыңыз? иә?
Dialogue: 0,0:09:28.63,0:09:31.30,Default,,0,0,0,,Хэхе!
Dialogue: 0,0:09:31.30,0:09:33.80,Default,,0,0,0,,Бұл туралы.
Dialogue: 0,0:09:33.80,0:09:36.30,Default,,0,0,0,,Бұл туралы не деуге болады? Дүкеннің аты қалай?
Dialogue: 0,0:09:36.30,0:09:39.47,Default,,0,0,0,,Сіз ұмытып қалдыңыз. Есіңізде болсын!
Dialogue: 0,0:09:39.47,0:09:42.14,Default,,0,0,0,,Келесі жолы мен оны өзім сатып аламын.
Dialogue: 0,0:09:42.14,0:09:44.35,Default,,0,0,0,,<Лиза: Бірнеше күннен кейін>
Dialogue: 0,0:09:46.82,0:09:51.62,Default,,0,0,0,,<Лиза: Біздің ауруханаға күтпеген науқас келді>
Dialogue: 0,0:09:54.66,0:09:58.49,Default,,0,0,0,,Хэхехе…. Саба-чан! не болды?
Dialogue: 0,0:09:58.49,0:10:01.00,Default,,0,0,0,,Жоқ, аз ғана.
Dialogue: 0,0:10:01.00,0:10:03.00,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:10:03.00,0:10:08.00,Default,,0,0,0,,Хмм, мен өзімді қалай сезінетінімді білмеймін...
Dialogue: 0,0:10:08.00,0:10:11.01,Default,,0,0,0,,Менің ойымша, бұл сезім мәселесі.
Dialogue: 0,0:10:11.01,0:10:13.01,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:10:13.01,0:10:15.68,Default,,0,0,0,,Толық ақпаратты мұғалімнен сұраңыз...
Dialogue: 0,0:10:15.68,0:10:17.68,Default,,0,0,0,,Иә? не болды?
Dialogue: 0,0:10:17.68,0:10:22.85,Default,,0,0,0,,Әй, Судо мырза! Бұл қыз менің досым...
Dialogue: 0,0:10:22.85,0:10:25.35,Default,,0,0,0,,Сәлем! Сыбыс болды.
Dialogue: 0,0:10:25.35,0:10:32.03,Default,,0,0,0,,Міне, біз дос болмас бұрын клиентпіз. Өтінемін, артқа барыңыз.
Dialogue: 0,0:10:32.03,0:10:34.36,Default,,0,0,0,,Ах... Хмм...
Dialogue: 0,0:10:34.36,0:10:37.53,Default,,0,0,0,,Лиза жақсы. Ах! Уф... бірақ...
Dialogue: 0,0:10:37.53,0:10:40.34,Default,,0,0,0,,Алдымен мен сені жалғыз тыңдаймын.
Dialogue: 0,0:10:43.87,0:10:45.87,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:10:49.54,0:10:51.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:54.88,0:10:57.89,Default,,0,0,0,,Сіз романтикалық сезімдеріңізді тастағыңыз келеді...
Dialogue: 0,0:10:57.89,0:11:01.32,Default,,0,0,0,,Бұл... тұрақты ма?
Dialogue: 0,0:11:01.32,0:11:04.16,Default,,0,0,0,,Сонымен! Тізбекпен аздап ойнаңыз➡
Dialogue: 0,0:11:04.16,0:11:07.50,Default,,0,0,0,,Мен қатты толқып тұрмын, бұлай мүйізденуден өзіңізді тоқтата алмайсыз ба?
Dialogue: 0,0:11:07.50,0:11:10.16,Default,,0,0,0,,Сіз не істегіңіз келеді?
Dialogue: 0,0:11:10.16,0:11:12.33,Default,,0,0,0,,Өйткені бұл қиындық тудырады.
Dialogue: 0,0:11:12.33,0:11:15.50,Default,,0,0,0,,Мен өз сезімімді ұстай алмаймын.
Dialogue: 0,0:11:15.50,0:11:17.67,Default,,0,0,0,,Осындай нәрселерге еріну➡
Dialogue: 0,0:11:17.67,0:11:19.67,Default,,0,0,0,,Бұл ысырап емес пе?
Dialogue: 0,0:11:19.67,0:11:23.88,Default,,0,0,0,,Әсіресе мен гуманоид болғандықтан.
Dialogue: 0,0:11:27.35,0:11:30.18,Default,,0,0,0,,Гуманоидтарға махаббат керек емес пе?
Dialogue: 0,0:11:30.18,0:11:36.02,Default,,0,0,0,,Ғашық болып, ұрпақ әкелетін адамдардан артық қажет емес деп ойлаймын.
Dialogue: 0,0:11:36.02,0:11:39.69,Default,,0,0,0,,Бұл уақытша жындылық емес пе?
Dialogue: 0,0:11:39.69,0:11:43.87,Default,,0,0,0,,Сізде тұрақты психикалық күйзеліс бар ма?
Dialogue: 0,0:11:43.87,0:11:46.70,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:46.70,0:11:49.60,Default,,0,0,0,,Өмір бойы, анда-санда.
Dialogue: 0,0:11:52.04,0:11:54.04,Default,,0,0,0,,Сіз байыптысыз, солай емес пе?
Dialogue: 0,0:11:54.04,0:11:56.84,Default,,0,0,0,,Хмм... Мен байсалдымын.
Dialogue: 0,0:11:59.38,0:12:02.48,Default,,0,0,0,,Бастапқыда болған сезімдерді тастау - ➡
Dialogue: 0,0:12:02.48,0:12:07.16,Default,,0,0,0,,Жағдайға байланысты психикалық тепе-теңдікті жоғалтуға әкелуі мүмкін➡
Dialogue: 0,0:12:07.16,0:12:10.16,Default,,0,0,0,,Мен тек екі жауаппен ұсынысты қабылдай алмаймын.
Dialogue: 0,0:12:10.16,0:12:12.16,Default,,0,0,0,,Хмм….
Dialogue: 0,0:12:12.16,0:12:16.16,Default,,0,0,0,,Біріншіден, сұрақтар тізімін толтыра аласыз ба?
Dialogue: 0,0:12:16.16,0:12:18.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:21.00,0:12:23.00,Default,,0,0,0,,Саба-чан! Апыр-ай!
Dialogue: 0,0:12:23.00,0:12:25.17,Default,,0,0,0,,Хмм….
Dialogue: 0,0:12:25.17,0:12:28.18,Default,,0,0,0,,Маған бір күндік сапар ретінде мұны істей алмайтынымды айтты.
Dialogue: 0,0:12:28.18,0:12:31.85,Default,,0,0,0,,Қазірдің өзінде! Неге алдымен менімен ақылдаспадың?
Dialogue: 0,0:12:31.85,0:12:35.18,Default,,0,0,0,,Оқиғаны кейін айтып беремін!
Dialogue: 0,0:12:35.18,0:12:37.19,Default,,0,0,0,,Мен де Мари-чанға хабарласамын!
Dialogue: 0,0:12:37.19,0:12:39.19,Default,,0,0,0,,Не? Жауап алу?
Dialogue: 0,0:12:39.19,0:12:44.19,Default,,0,0,0,,<Лиза: Ол Леон Миёши менің досым.
Dialogue: 0,0:12:44.19,0:12:49.36,Default,,0,0,0,,Біз екі жыл бұрын волонтерлердің бірінде танысқан едік➡
Dialogue: 0,0:12:49.36,0:12:52.53,Default,,0,0,0,,Біз қазір достар ішіп жатырмыз.
Dialogue: 0,0:12:52.53,0:12:55.37,Default,,0,0,0,,Себебі мен үнемі бос емеспін➡
Dialogue: 0,0:12:55.37,0:12:57.87,Default,,0,0,0,,Менің атым Саба-чан>
Dialogue: 0,0:12:59.87,0:13:02.31,Default,,0,0,0,,Махаббат қиын ба?
Dialogue: 0,0:13:02.31,0:13:06.65,Default,,0,0,0,,Мен де кейде солай сезінемін, бірақ романтикалық сезімдерден бас тартуға келгенде...
Dialogue: 0,0:13:06.65,0:13:08.65,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:13:08.65,0:13:13.15,Default,,0,0,0,,Сүйіспеншілік қиын нәрселерді білдіреді, солай емес пе?
Dialogue: 0,0:13:13.15,0:13:15.99,Default,,0,0,0,,Егер бұл мұндай әурешілік болмаса➡
Dialogue: 0,0:13:15.99,0:13:19.99,Default,,0,0,0,,Мүмкін маған басқа адам қатты ұнайтын шығар➡
Dialogue: 0,0:13:19.99,0:13:24.33,Default,,0,0,0,,Мен түсінбеймін. Мари-чан күткендей, бұл терең.
Dialogue: 0,0:13:24.33,0:13:27.34,Default,,0,0,0,,Дұрыс, Саба-чан.
Dialogue: 0,0:13:27.34,0:13:31.01,Default,,0,0,0,,Сіз тыңдайсыз ба? Тыңдап жатырмын тыңдаймын
Dialogue: 0,0:13:31.01,0:13:34.34,Default,,0,0,0,,Ммм... Нақты не болды?➡
Dialogue: 0,0:13:34.34,0:13:37.68,Default,,0,0,0,,Сен айтпасаң, мен саған кеңес бере алмаймын.
Dialogue: 0,0:13:37.68,0:13:41.68,Default,,0,0,0,,Ерекше ештеңе жоқ. иә?
Dialogue: 0,0:13:41.68,0:13:45.35,Default,,0,0,0,,Аа, мен Ақ күнде ешнәрсе алған жоқпын➡
Dialogue: 0,0:13:45.35,0:13:48.19,Default,,0,0,0,,Солай ма? Бұл не?
Dialogue: 0,0:13:48.19,0:13:52.19,Default,,0,0,0,,Сіз маған ғашықтар күніне шоколад бердіңіз дедіңіз. Сонымен...
Dialogue: 0,0:13:52.19,0:13:54.86,Default,,0,0,0,,Демек, ештеңе жоқ.
Dialogue: 0,0:13:54.86,0:13:57.70,Default,,0,0,0,,Хмм….
Dialogue: 0,0:13:57.70,0:13:59.87,Default,,0,0,0,,Сонда кездескенше. иә!
Dialogue: 0,0:13:59.87,0:14:02.47,Default,,0,0,0,,Сонда кездескенше. сау бол.
Dialogue: 0,0:14:02.47,0:14:04.47,Default,,0,0,0,,Біз де такумыз ба?
Dialogue: 0,0:14:04.47,0:14:07.98,Default,,0,0,0,,Мен аздап жедім, сондықтан үйге серуендеп барғым келеді.
Dialogue: 0,0:14:07.98,0:14:11.31,Default,,0,0,0,,Иә. Сонда кездескенше!
Dialogue: 0,0:14:11.31,0:14:14.32,Default,,0,0,0,,Ах... Ха...
Dialogue: 0,0:14:18.15,0:14:20.49,Default,,0,0,0,,Саба-чан, су сасық.
Dialogue: 0,0:14:20.49,0:14:23.16,Default,,0,0,0,,Ол маған өзі туралы ештеңе айтпайды.
Dialogue: 0,0:14:23.16,0:14:25.16,Default,,0,0,0,,Дәл солай Лизаға да қатысты.
Dialogue: 0,0:14:25.16,0:14:27.33,Default,,0,0,0,,Ол Судо мырзаны ұнататынын айтады➡
Dialogue: 0,0:14:27.33,0:14:30.16,Default,,0,0,0,,Мен оны әлі анық естіген жоқпын.
Dialogue: 0,0:14:30.16,0:14:32.17,Default,,0,0,0,,Сосын айтсам➡
Dialogue: 0,0:14:32.17,0:14:36.34,Default,,0,0,0,,Саба-чан да өзінің шынайы сезімі туралы бірдеңе айтады! Ха!
Dialogue: 0,0:14:36.34,0:14:41.01,Default,,0,0,0,,Хабарландыру! Қазір маған ұнайтын адам...
Dialogue: 0,0:14:41.01,0:14:43.68,Default,,0,0,0,,Мектепке қабылдау сыйы ретінде маған берілген тау велосипеді
Dialogue: 0,0:14:43.68,0:14:48.18,Default,,0,0,0,,А... шынымен менің шынайы сезімдерімді білгің келе ме?
Dialogue: 0,0:14:48.18,0:14:51.69,Default,,0,0,0,,Иә? Әрине!
Dialogue: 0,0:14:51.69,0:14:53.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:53.86,0:14:56.86,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:14:56.86,0:14:59.03,Default,,0,0,0,,Хабарландыру!
Dialogue: 0,0:14:59.03,0:15:05.30,Default,,0,0,0,,Мен, Леон Миёши, қазір біреуге ғашықпын!
Dialogue: 0,0:15:05.30,0:15:07.47,Default,,0,0,0,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:15:07.47,0:15:09.80,Default,,0,0,0,,Сол адам...
Dialogue: 0,0:15:09.80,0:15:12.64,Default,,0,0,0,,Уф… уф….
Dialogue: 0,0:15:12.64,0:15:16.54,Default,,0,0,0,,Бұл менің алдымда!
Dialogue: 0,0:15:18.98,0:15:22.98,Default,,0,0,0,,Қайда? қайда? қайда! ? Бұл сенсің, сен.
Dialogue: 0,0:15:22.98,0:15:24.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:24.99,0:15:27.66,Default,,0,0,0,,Лиза мен➡
Dialogue: 0,0:15:27.66,0:15:31.49,Default,,0,0,0,,Бұл қыздарды ұнататын әйел гуманоид.
Dialogue: 0,0:15:31.49,0:15:34.80,Default,,0,0,0,,Сіз таң қалдыңыз ба? Ха….
Dialogue: 0,0:15:38.17,0:15:41.84,Default,,0,0,0,,Қарсы емес! Бұл туралы шынымен уайымдамаңыз.
Dialogue: 0,0:15:41.84,0:15:45.17,Default,,0,0,0,,Мен бұлай болатынын әу бастан білгенмін.
Dialogue: 0,0:15:45.17,0:15:50.51,Default,,0,0,0,,Маған ұнайтын қыздардың барлығы қарама-қарсы жыныстағы қыздарды ұнатады.
Dialogue: 0,0:15:50.51,0:15:53.31,Default,,0,0,0,,Сонымен мен үйге бара жатырмын.
Dialogue: 0,0:15:55.35,0:16:01.36,Default,,0,0,0,,А... білесің бе, біз әлі де дос боламыз, солай ма?
Dialogue: 0,0:16:04.29,0:16:08.13,Default,,0,0,0,,Дұрыс. мен солай болады деген сенімдемін.
Dialogue: 0,0:16:08.13,0:16:10.30,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:10.30,0:16:14.00,Default,,0,0,0,,Мен оны дәл қазір айта алмаймын.
Dialogue: 0,0:16:16.47,0:16:18.47,Default,,0,0,0,,Сондықтан мен оны дәлелдеймін.
Dialogue: 0,0:16:22.48,0:16:24.98,Default,,0,0,0,,((Мен нағыз мұғалімді ұнатамын.
Dialogue: 0,0:16:24.98,0:16:30.82,Default,,0,0,0,,Хмм... Айтпақшы, мен де Лиза екеумізге үлгі жасап бердім.
Dialogue: 0,0:16:30.82,0:16:33.82,Default,,0,0,0,,Иә! Не?
Dialogue: 0,0:16:33.82,0:16:38.33,Default,,0,0,0,,Айтпақшы, Саба-чан ше? Сіз біреуге шоколад бердіңіз бе?
Dialogue: 0,0:16:38.33,0:16:40.66,Default,,0,0,0,,Ах... иә.
Dialogue: 0,0:16:40.66,0:16:44.00,Default,,0,0,0,,Мен оны естігім келеді! Мен бұл оқиғаны естігім келеді!
Dialogue: 0,0:16:44.00,0:16:47.60,Default,,0,0,0,,Аа... тым көп жеп жатырмын))
Dialogue: 0,0:16:50.84,0:16:55.54,Default,,0,0,0,,Эй, Лиза, имплант еріткішін толтырдың ба?
Dialogue: 0,0:17:00.11,0:17:02.28,Default,,0,0,0,,Сәлем. Ах!
Dialogue: 0,0:17:02.28,0:17:05.95,Default,,0,0,0,,Кешіріңіз, бұл еріткіш.
Dialogue: 0,0:17:05.95,0:17:10.29,Default,,0,0,0,,Менің үйіме сенің досың не үшін келді деп ойлаймын. иә?
Dialogue: 0,0:17:10.29,0:17:14.30,Default,,0,0,0,,Танысыңыздың жұмыс орнына келмейсіз.
Dialogue: 0,0:17:14.30,0:17:17.97,Default,,0,0,0,,Мұғалімнің айтқаны ➡
Dialogue: 0,0:17:17.97,0:17:22.77,Default,,0,0,0,,Сіз маған сендіңіз деп ойлаймын. Солай ма?
Dialogue: 0,0:17:38.32,0:17:40.82,Default,,0,0,0,,Сұрақтар тізімінен ➡
Dialogue: 0,0:17:40.82,0:17:45.66,Default,,0,0,0,,Есептерді шешуге арналған алгоритмдік талдау аяқталды. иә.
Dialogue: 0,0:17:45.66,0:17:49.33,Default,,0,0,0,,Романтикалық сезімдерден бас тарту таңдауыңыз➡
Dialogue: 0,0:17:49.33,0:17:52.83,Default,,0,0,0,,Өзгерістер бар ма? иә.
Dialogue: 0,0:17:52.83,0:17:56.00,Default,,0,0,0,,Жыныстық құмарлықтың тұрақты түрде басылуы➡
Dialogue: 0,0:17:56.00,0:18:01.11,Default,,0,0,0,,Серіктестің болмауы мәселелерін шешуге арналған кибер емдеу әдістері бар.
Dialogue: 0,0:18:01.11,0:18:03.44,Default,,0,0,0,,Хмм….
Dialogue: 0,0:18:03.44,0:18:09.45,Default,,0,0,0,,Жағдайды сәл ұзағырақ бақылап, белгілі бір әдісті таңдайық.
Dialogue: 0,0:18:11.45,0:18:13.79,Default,,0,0,0,,Ах... (аяқ дыбысы)
Dialogue: 0,0:18:13.79,0:18:23.80,Default,,0,0,0,,♪～
Dialogue: 0,0:18:23.80,0:18:35.14,Default,,0,0,0,,♪～
Dialogue: 0,0:18:35.14,0:18:38.81,Default,,0,0,0,,📢Жадтағы барлық фотосуреттерді бірден жойыңыз.
Dialogue: 0,0:18:38.81,0:18:41.32,Default,,0,0,0,,📢Сіз сенімдісіз бе? Хмм...
Dialogue: 0,0:18:41.32,0:18:57.33,Default,,0,0,0,,♪～
Dialogue: 0,0:18:57.33,0:18:59.63,Default,,0,0,0,,Ах... (есіктің ашылған дыбысы)
Dialogue: 0,0:19:04.61,0:19:07.44,Default,,0,0,0,,📢Уақыт таяп қалды. аа.
Dialogue: 0,0:19:07.44,0:19:11.61,Default,,0,0,0,,📢Оның алдында, Суду, бір сәт қарсы боласың ба? иә?
Dialogue: 0,0:19:11.61,0:19:14.78,Default,,0,0,0,,📢 Бұл науқас пен Лизаның қарым-қатынасы туралы.
Dialogue: 0,0:19:14.78,0:19:17.79,Default,,0,0,0,,📢Науқас Лиза болса керек...
Dialogue: 0,0:19:17.79,0:19:20.59,Default,,0,0,0,,Джей Мен мұндай талдауды сұраған жоқпын.
Dialogue: 0,0:19:23.79,0:19:25.96,Default,,0,0,0,,-де? 📢Осылай қалдырыңыз➡
Dialogue: 0,0:19:25.96,0:19:28.96,Default,,0,0,0,,Науқас қалаған емді орындағаннан кейін➡
Dialogue: 0,0:19:28.96,0:19:31.97,Default,,0,0,0,,Нәтиже жақсы болмайды деп ойлаймын.
Dialogue: 0,0:19:31.97,0:19:36.14,Default,,0,0,0,,Бұл техникалық мәселе ме? Әлде басқа нәрсе ме?
Dialogue: 0,0:19:36.14,0:19:38.97,Default,,0,0,0,,📢Соңғы. (Жарық) Эй Джей➡
Dialogue: 0,0:19:38.97,0:19:42.64,Default,,0,0,0,,Бұл енді медициналық AI үшін тақырып емес.
Dialogue: 0,0:19:42.64,0:19:44.65,Default,,0,0,0,,📢Дұрыс.
Dialogue: 0,0:19:44.65,0:19:48.48,Default,,0,0,0,,📢Бұл менің мүмкіндігімнен тыс.
Dialogue: 0,0:19:48.48,0:19:50.48,Default,,0,0,0,,📢Бірақ Судо….
Dialogue: 0,0:19:54.99,0:19:58.33,Default,,0,0,0,,Ах... Дайындық аяқталды.
Dialogue: 0,0:19:58.33,0:20:01.16,Default,,0,0,0,,Пациенттер кез келген уақытта кіре алады.
Dialogue: 0,0:20:01.16,0:20:04.57,Default,,0,0,0,,Сіз онымен мүлдем сөйлескен жоқсыз.
Dialogue: 0,0:20:06.67,0:20:09.84,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:20:09.84,0:20:13.34,Default,,0,0,0,,Қандай дауыс айтарымды білмеймін.
Dialogue: 0,0:20:15.34,0:20:18.51,Default,,0,0,0,,Ол сені ұнататын сияқты.
Dialogue: 0,0:20:18.51,0:20:21.62,Default,,0,0,0,,Иә! Мұғаліміңізге айттыңыз ба? жоқ.
Dialogue: 0,0:20:24.85,0:20:26.85,Default,,0,0,0,,Бірақ бұл анық.
Dialogue: 0,0:20:26.85,0:20:29.52,Default,,0,0,0,,Оны Саба-чан➡ деп атаса керек
Dialogue: 0,0:20:29.52,0:20:33.19,Default,,0,0,0,,Менен сұрасаңыз, мүлдем жаңа емес.
Dialogue: 0,0:20:33.19,0:20:36.70,Default,,0,0,0,,Лизаның мені байқамағаны ауырады➡
Dialogue: 0,0:20:36.70,0:20:39.53,Default,,0,0,0,,Сіз біздің ауруханаға дейін келген шығарсыз.
Dialogue: 0,0:20:39.53,0:20:43.37,Default,,0,0,0,,Сондықтан мен сізді алаңдатып, соншалықты әйелдікке ие болғым келмейді.
Dialogue: 0,0:20:43.37,0:20:46.87,Default,,0,0,0,,Тоқтаңыз! Бұлай айтуға амал жоқ!
Dialogue: 0,0:20:46.87,0:20:49.88,Default,,0,0,0,,Мұғалім туралы Сағындым!
Dialogue: 0,0:20:49.88,0:20:54.38,Default,,0,0,0,,Осыны ескере отырып, оған да бірдеңе айтыңыз.
Dialogue: 0,0:20:54.38,0:20:56.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:56.38,0:21:00.65,Default,,0,0,0,,Ол ауырады, ауырады және қиын болады➡
Dialogue: 0,0:21:00.65,0:21:04.66,Default,,0,0,0,,Менің ойымша, қорқып, ештеңе айтпау босқа кетеді.
Dialogue: 0,0:21:04.66,0:21:06.66,Default,,0,0,0,,Сіз доссыз ба?
Dialogue: 0,0:21:09.66,0:21:11.67,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:21:11.67,0:21:14.00,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:21:14.00,0:21:16.00,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:21:18.67,0:21:21.38,Default,,0,0,0,,Саба-чан! Ах...
Dialogue: 0,0:21:23.34,0:21:28.35,Default,,0,0,0,,Бұл мен үшін қорқынышты нәрсе болуы мүмкін, бірақ➡
Dialogue: 0,0:21:28.35,0:21:32.52,Default,,0,0,0,,Маған Саба-чан да ұнайды.
Dialogue: 0,0:21:32.52,0:21:38.86,Default,,0,0,0,,Саба-чан ұнататын нәрседен басқаша, бірақ мен дәл солаймын...
Dialogue: 0,0:21:38.86,0:21:41.16,Default,,0,0,0,,Мен Саба-чанды жақсы көремін.
Dialogue: 0,0:21:44.20,0:21:47.87,Default,,0,0,0,,Мен бұрынғыдай болмасам, сізге ұнамай ма?
Dialogue: 0,0:21:47.87,0:21:52.87,Default,,0,0,0,,Бұл дұрыс емес. Өйткені Саба-чан - Саба-чан.
Dialogue: 0,0:21:52.87,0:21:56.04,Default,,0,0,0,,Бірақ маған Сабачан ұнайды➡
Dialogue: 0,0:21:56.04,0:21:59.35,Default,,0,0,0,,Мен оны дұрыс жеткізгім келді. Ах...
Dialogue: 0,0:22:02.82,0:22:07.66,Default,,0,0,0,,Махаббат - адамдардың көпшілігіне әсер ететін ауру.
Dialogue: 0,0:22:07.66,0:22:12.16,Default,,0,0,0,,Дәрігер ретінде мен мүмкіндігінше жай қалдырғым келетіні рас.
Dialogue: 0,0:22:12.16,0:22:15.33,Default,,0,0,0,,Сезімдерің өзгерді ме?
Dialogue: 0,0:22:15.33,0:22:18.33,Default,,0,0,0,,Хмм.
Dialogue: 0,0:22:18.33,0:22:20.84,Default,,0,0,0,,Хмм….
Dialogue: 0,0:22:20.84,0:22:24.54,Default,,0,0,0,,Мұғалім I….
Dialogue: 0,0:22:26.04,0:22:32.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
