Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Бұйрық! Бұйрық!
Dialogue: 0,0:00:07.98,0:00:09.07,Default,,0,0,0,,кесу
Dialogue: 0,0:00:09.15,0:00:10.44,Default,,0,0,0,,Неліктен? кім біледі!
Dialogue: 0,0:00:10.53,0:00:12.86,Default,,0,0,0,,Ол жерден шық! Мен бұл жігітті өлтіремін!
Dialogue: 0,0:00:14.28,0:00:15.16,Default,,0,0,0,,Такина!
Dialogue: 0,0:00:15.24,0:00:16.62,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:00:17.24,0:00:18.87,Default,,0,0,0,,Сіз Эриканы өлтіруді жоспарлап отырсыз ба?
Dialogue: 0,0:00:19.49,0:00:20.29,Default,,0,0,0,,Әй
Dialogue: 0,0:00:24.29,0:00:25.33,Default,,0,0,0,,Хмм…
Dialogue: 0,0:00:26.04,0:00:28.42,Default,,0,0,0,,Такина~ Мен дүкен ашамын!
Dialogue: 0,0:00:28.50,0:00:29.00,Default,,0,0,0,,Ах
Dialogue: 0,0:00:29.59,0:00:31.51,Default,,0,0,0,,Иә! Мен қазір барамын
Dialogue: 0,0:00:32.09,0:00:33.30,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:00:35.72,0:00:37.60,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:00:38.10,0:00:40.10,Default,,0,0,0,,♪~
Dialogue: 0,0:02:04.47,0:02:06.48,Default,,0,0,0,,~♪
Dialogue: 0,0:02:08.48,0:02:11.06,Default,,0,0,0,,Ал, Лабраба,
Dialogue: 0,0:02:11.15,0:02:12.23,Default,,0,0,0,,О, түсіндім. Демек, Иура – ағасы екен.
Dialogue: 0,0:02:12.32,0:02:12.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:13.02,0:02:15.65,Default,,0,0,0,,Ааа, мен мұны істедім
Dialogue: 0,0:02:15.74,0:02:16.65,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:16.74,0:02:19.41,Default,,0,0,0,,Hoora фотосуреті
Dialogue: 0,0:02:19.99,0:02:21.41,Default,,0,0,0,,Мен оны сізге де жібердім.
Dialogue: 0,0:02:21.49,0:02:22.83,Default,,0,0,0,,А, міне, осы.
Dialogue: 0,0:02:22.91,0:02:25.95,Default,,0,0,0,,Мен DA барлау бөліміне оны талдауды тапсырдым.
Dialogue: 0,0:02:26.04,0:02:27.25,Default,,0,0,0,,Жүзіңді білмесем де
Dialogue: 0,0:02:27.33,0:02:29.96,Default,,0,0,0,,Сіз өзіңіздің дене өлшеміңізге байланысты шамамен болжам жасай алуыңыз керек.
Dialogue: 0,0:02:32.17,0:02:32.92,Default,,0,0,0,,Не!
Dialogue: 0,0:02:33.00,0:02:34.38,Default,,0,0,0,,На… Нану~!
Dialogue: 0,0:02:34.46,0:02:38.01,Default,,0,0,0,,Бұл DA тек осы кескін сапасына ие екенін білдіре ме?
Dialogue: 0,0:02:38.51,0:02:41.59,Default,,0,0,0,,Мизуки Бұл DA-ны жеңуі мүмкін.
Dialogue: 0,0:02:41.68,0:02:43.10,Default,,0,0,0,,не болды? Мизуки
Dialogue: 0,0:02:43.60,0:02:45.06,Default,,0,0,0,,Бұл ештеңе емес!
Dialogue: 0,0:02:45.64,0:02:46.31,Default,,0,0,0,,Неге ашуланасың?
Dialogue: 0,0:02:46.39,0:02:48.43,Default,,0,0,0,,Әй, уақыт келді.
Dialogue: 0,0:02:49.10,0:02:50.48,Default,,0,0,0,,Куруми-чан, уақыт келді!
Dialogue: 0,0:02:50.56,0:02:52.10,Default,,0,0,0,,Бұл ойын! Бұл ойын!
Dialogue: 0,0:02:52.19,0:02:54.02,Default,,0,0,0,,Шашың байланған екен.
Dialogue: 0,0:02:54.11,0:02:57.74,Default,,0,0,0,,Сонымен, жабық үстел ойыны кеші басталды!
Dialogue: 0,0:02:57.82,0:02:59.70,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:02:59.78,0:03:02.37,Default,,0,0,0,,Мерзім ертең дедіңіз ғой, солай ма?
Dialogue: 0,0:03:02.45,0:03:04.99,Default,,0,0,0,,Оның бүгін маған еш қатысы жоқ.
Dialogue: 0,0:03:05.08,0:03:07.33,Default,,0,0,0,,Жарайды, жұмыс туралы сөйлесейік.
Dialogue: 0,0:03:07.41,0:03:09.66,Default,,0,0,0,,Негізі мен де жұмыстамын.
Dialogue: 0,0:03:09.75,0:03:12.04,Default,,0,0,0,,Детектив, сен ақымақсың.
Dialogue: 0,0:03:12.12,0:03:13.71,Default,,0,0,0,,Ерте бастайық.
Dialogue: 0,0:03:13.79,0:03:15.96,Default,,0,0,0,,Ал, тәртіпті шешейік~
Dialogue: 0,0:03:16.05,0:03:18.76,Default,,0,0,0,,Эй, Такина, бірге жасайық.
Dialogue: 0,0:03:18.84,0:03:20.97,Default,,0,0,0,,Кассаны жапқың келсе, мен де саған көмектесемін.
Dialogue: 0,0:03:21.05,0:03:22.59,Default,,0,0,0,,Қазір аяқталды
Dialogue: 0,0:03:22.68,0:03:23.34,Default,,0,0,0,,Жылдам
Dialogue: 0,0:03:23.43,0:03:25.35,Default,,0,0,0,,Нөлдік тіркеу қатесі Ауытқу жоқ
Dialogue: 0,0:03:25.43,0:03:27.18,Default,,0,0,0,,Сонымен, сізде бос уақыт бар, солай ма?
Dialogue: 0,0:03:27.26,0:03:29.98,Default,,0,0,0,,Такина-чан, мында, мында кел.
Dialogue: 0,0:03:30.06,0:03:30.98,Default,,0,0,0,,Сіз қалай ойлайсыз? Такина
Dialogue: 0,0:03:31.06,0:03:32.81,Default,,0,0,0,,Смақ!
Dialogue: 0,0:03:34.61,0:03:36.48,Default,,0,0,0,,Ағай, көп шығар
Dialogue: 0,0:03:36.57,0:03:38.73,Default,,0,0,0,,Ұят екен, қартайдың.
Dialogue: 0,0:03:38.82,0:03:41.49,Default,,0,0,0,,Дүкенде ойнау қызық.
Dialogue: 0,0:03:41.57,0:03:42.45,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:03:43.32,0:03:45.07,Default,,0,0,0,,Егер олар қиылысатын болса ше?
Dialogue: 0,0:03:46.53,0:03:48.79,Default,,0,0,0,,Егер мен мұны істесем, мен DA-ға орала аламын ба?
Dialogue: 0,0:03:49.95,0:03:50.54,Default,,0,0,0,,(Миканың күрсінуі)
Dialogue: 0,0:03:50.62,0:03:53.29,Default,,0,0,0,,Сәлем~ Такина
Dialogue: 0,0:03:53.87,0:03:54.88,Default,,0,0,0,,Оларға мұқият қарап тұр.
Dialogue: 0,0:03:54.96,0:03:56.88,Default,,0,0,0,,Бірге ойын ойнайық, жарай ма?
Dialogue: 0,0:03:57.50,0:03:58.71,Default,,0,0,0,,Мен үйге кетейін деп жатырмын
Dialogue: 0,0:03:58.80,0:04:00.21,Default,,0,0,0,,А, ертең ше?
Dialogue: 0,0:04:00.30,0:04:01.80,Default,,0,0,0,,Ертең әдеттегі мереке.
Dialogue: 0,0:04:02.47,0:04:03.55,Default,,0,0,0,,Мен киім ауыстырғалы жатырмын.
Dialogue: 0,0:04:04.34,0:04:07.72,Default,,0,0,0,,Дұрыс~ Ендеше біз ертең ойын кешіне жиналамыз.
Dialogue: 0,0:04:07.81,0:04:09.22,Default,,0,0,0,,Сензоку! (Чизоку) Иә?
Dialogue: 0,0:04:09.31,0:04:12.69,Default,,0,0,0,,Сіз медициналық тексеруден және дене дайындығы бойынша тесттен өттіңіз бе?
Dialogue: 0,0:04:12.77,0:04:16.73,Default,,0,0,0,,үшін? А, жоқ, мен әлі тауға сонша тереңдікке барғым келмейді.
Dialogue: 0,0:04:16.81,0:04:18.73,Default,,0,0,0,,Ертең соңғы күн.
Dialogue: 0,0:04:18.82,0:04:20.90,Default,,0,0,0,,Лицензияны жаңарту үшін қажет
Dialogue: 0,0:04:20.99,0:04:23.36,Default,,0,0,0,,Жұмысыңды сақтап қалғың келсе, бар.
Dialogue: 0,0:04:23.45,0:04:24.11,Default,,0,0,0,,Иә~
Dialogue: 0,0:04:24.20,0:04:27.70,Default,,0,0,0,,Айтыңызшы, сэр.
Dialogue: 0,0:04:27.78,0:04:31.50,Default,,0,0,0,,Ұстазыңыз бірдеңені талап етсе, сіз оны орындайсыз, солай ма? Кусуноки мырза
Dialogue: 0,0:04:32.20,0:04:33.16,Default,,0,0,0,,Сіз командирмен кездесесіз бе?
Dialogue: 0,0:04:33.25,0:04:34.96,Default,,0,0,0,,Ой, ақымақ! киім!
Dialogue: 0,0:04:35.04,0:04:35.71,Default,,0,0,0,,Хмм.
Dialogue: 0,0:04:35.79,0:04:37.59,Default,,0,0,0,,Хмм… Хмпф
Dialogue: 0,0:04:38.17,0:04:39.34,Default,,0,0,0,,Мені де алып кетіңізші.
Dialogue: 0,0:04:39.42,0:04:40.25,Default,,0,0,0,,Жылдам
Dialogue: 0,0:04:40.34,0:04:41.30,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:43.59,0:04:44.84,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:04:45.59,0:04:46.22,Default,,0,0,0,,Ммм
Dialogue: 0,0:04:46.89,0:04:48.05,Default,,0,0,0,,(Мың күрсіну)
Dialogue: 0,0:04:49.56,0:04:51.68,Default,,0,0,0,,Түсіндім, Такина.
Dialogue: 0,0:04:58.73,0:05:00.61,Default,,0,0,0,,Кусуноки мырзаға не айтасыз?
Dialogue: 0,0:05:00.69,0:05:02.40,Default,,0,0,0,,Мен бұл туралы қазір ойлап отырмын
Dialogue: 0,0:05:04.20,0:05:06.20,Default,,0,0,0,,Такина, сенде кәмпит бар ма? Бұл жақсы
Dialogue: 0,0:05:06.28,0:05:07.57,Default,,0,0,0,,Ухехехе
Dialogue: 0,0:05:08.49,0:05:10.53,Default,,0,0,0,,Біз медициналық тексеруден өткелі жатырмыз.
Dialogue: 0,0:05:10.62,0:05:12.45,Default,,0,0,0,,Бір ғана
Dialogue: 0,0:05:12.54,0:05:17.50,Default,,0,0,0,,Қантты тұтыну қандағы қантқа, бейтарап майға, бауыр функциясына және басқа да мәндерге әсер етеді.
Dialogue: 0,0:05:19.54,0:05:22.51,Default,,0,0,0,,Күрсін... Күрсін.
Dialogue: 0,0:05:29.30,0:05:33.52,Default,,0,0,0,,Біз сізді күттік, Нишикики мырза мен Инуэ мырза.
Dialogue: 0,0:05:41.98,0:05:42.82,Default,,0,0,0,,Мен оны айтпақшы емеспін… Аах!
Dialogue: 0,0:05:44.24,0:05:45.78,Default,,0,0,0,,Қақпа ашылады
Dialogue: 0,0:06:03.34,0:06:04.21,Default,,0,0,0,,Сәлем, сәлем
Dialogue: 0,0:06:04.80,0:06:08.43,Default,,0,0,0,,Нишикики мырзаның физикалық дайындығы өлшенеді, сондықтан ол көршілес медициналық ғимаратқа барады.
Dialogue: 0,0:06:08.51,0:06:09.26,Default,,0,0,0,,Инуэ мырза...
Dialogue: 0,0:06:09.34,0:06:11.47,Default,,0,0,0,,Мен командир Кусунокимен кездескім келеді.
Dialogue: 0,0:06:11.55,0:06:13.89,Default,,0,0,0,,Команда қазір жиналыста.
Dialogue: 0,0:06:13.97,0:06:15.68,Default,,0,0,0,,Сіз екі сағаттан кейін келесіз.
Dialogue: 0,0:06:15.77,0:06:16.64,Default,,0,0,0,,Такина
Dialogue: 0,0:06:16.73,0:06:18.81,Default,,0,0,0,,Қараңызшы, сіз одақтасты өлтіріп жатырсыз.
Dialogue: 0,0:06:18.89,0:06:21.48,Default,,0,0,0,,Сізді ДА-дан қуып жіберді, солай ма?
Dialogue: 0,0:06:21.56,0:06:23.77,Default,,0,0,0,,Жұптастырылған барлық балалар ауруханаға жіберіледі.
Dialogue: 0,0:06:23.86,0:06:24.65,Default,,0,0,0,,Осороши
Dialogue: 0,0:06:25.65,0:06:27.65,Default,,0,0,0,,Эбисудың хаос тудыратын сиқыршы екенін ойласаң...
Dialogue: 0,0:06:27.74,0:06:29.20,Default,,0,0,0,,Күткіңіз келе ме?
Dialogue: 0,0:06:29.28,0:06:31.28,Default,,0,0,0,,А... иә
Dialogue: 0,0:06:31.37,0:06:33.20,Default,,0,0,0,,Мен сіздің бұйрықтарды елемегеніңізді естідім.
Dialogue: 0,0:06:33.28,0:06:35.54,Default,,0,0,0,,Не? Неге олай істеп жатырсың?
Dialogue: 0,0:06:36.04,0:06:37.62,Default,,0,0,0,,Мен оқу орталығына барамын.
Dialogue: 0,0:06:37.71,0:06:39.12,Default,,0,0,0,,Әй, эй... Әй, кеттік!
Dialogue: 0,0:06:39.21,0:06:40.62,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:06:41.54,0:06:42.50,Default,,0,0,0,,Такина...
Dialogue: 0,0:06:44.13,0:06:45.71,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:06:54.64,0:06:55.35,Default,,0,0,0,,Бұл жасырын операциялар үшін мінсіз қабілет.
Dialogue: 0,0:06:55.97,0:06:56.72,Default,,0,0,0,,Сензоку!
Dialogue: 0,0:06:56.81,0:07:01.15,Default,,0,0,0,,Сенімді адам Фуки мырза бұл лицензияны жаңартудың соңғы күні екенін айтты.
Dialogue: 0,0:07:01.23,0:07:02.48,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:02.56,0:07:06.48,Default,,0,0,0,,Мен бос емес едім, сондықтан сенің шлюхаларыңмен араласайын деп жатырмын.
Dialogue: 0,0:07:08.07,0:07:08.65,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:09.49,0:07:10.95,Default,,0,0,0,,Сіздің мұғаліміңіз қалай?
Dialogue: 0,0:07:11.03,0:07:13.74,Default,,0,0,0,,Менде бәрі жақсы, анда-санда қонаққа кел.
Dialogue: 0,0:07:13.82,0:07:14.58,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:07:14.66,0:07:15.53,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:07:15.62,0:07:18.41,Default,,0,0,0,,«Сізге миссиядан тыс рұқсатсыз шығуға болмайды» солай ма?
Dialogue: 0,0:07:18.50,0:07:19.71,Default,,0,0,0,,Шағымданбаңыз
Dialogue: 0,0:07:19.79,0:07:21.42,Default,,0,0,0,,Кездескіңіз келетін адаммен кездесе алмайсыз ба?
Dialogue: 0,0:07:21.50,0:07:24.13,Default,,0,0,0,,Әй, бітті! Ол аяқтады!
Dialogue: 0,0:07:25.67,0:07:27.59,Default,,0,0,0,,Такинамен жақсы араласасыз ба?
Dialogue: 0,0:07:27.67,0:07:28.84,Default,,0,0,0,,Әрине
Dialogue: 0,0:07:28.92,0:07:31.34,Default,,0,0,0,,Мен сені ұрмаймын.
Dialogue: 0,0:07:31.43,0:07:34.26,Default,,0,0,0,,Цк, сені тәртіпке салуға болмайды.
Dialogue: 0,0:07:36.64,0:07:38.31,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:07:42.85,0:07:44.19,Default,,0,0,0,,(Дыбыс жүктелуде)
Dialogue: 0,0:07:45.48,0:07:47.32,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:07:47.40,0:07:48.82,Default,,0,0,0,,Мені мұнда неге әкелдің?
Dialogue: 0,0:07:48.90,0:07:49.99,Default,,0,0,0,,Хмм?
Dialogue: 0,0:07:50.07,0:07:52.11,Default,,0,0,0,,Сіз бәрібір қайтып оралғыңыз келеді, солай ма?
Dialogue: 0,0:07:52.20,0:07:55.07,Default,,0,0,0,,Дұрыс. Бұл жер неге сонша жақсы?
Dialogue: 0,0:07:55.16,0:07:56.87,Default,,0,0,0,,Сіз біртүрлі екенсіз
Dialogue: 0,0:07:56.95,0:08:00.62,Default,,0,0,0,,Біз жетімдерді ДА құтқарып, осында тәрбиеледік.
Dialogue: 0,0:08:01.12,0:08:03.21,Default,,0,0,0,,Ата-анаңа риза емессің бе?
Dialogue: 0,0:08:03.29,0:08:04.96,Default,,0,0,0,,Жоқ, бар.
Dialogue: 0,0:08:05.04,0:08:07.00,Default,,0,0,0,,Бірақ «ата-ананың бөлінуі» сияқты?
Dialogue: 0,0:08:07.09,0:08:10.13,Default,,0,0,0,,Ұстаз, өзіңізбен бірге алыңыз, мен ата-анамды тастамаймын.
Dialogue: 0,0:08:10.21,0:08:13.55,Default,,0,0,0,,Негізгі дүкен ерекше, әсіресе қоныс аударған топ үшін.
Dialogue: 0,0:08:13.63,0:08:16.93,Default,,0,0,0,,Менің айтайын дегенім, егер сіз мұны білсеңіз, Фукимен бірге жұмыс жасаңыз.
Dialogue: 0,0:08:17.01,0:08:19.10,Default,,0,0,0,,Мұны жоғарғы басшылық шешеді.
Dialogue: 0,0:08:19.68,0:08:21.81,Default,,0,0,0,,Олай айтпа.
Dialogue: 0,0:08:21.89,0:08:24.65,Default,,0,0,0,,Уф... ха ха ха
Dialogue: 0,0:08:24.73,0:08:26.31,Default,,0,0,0,,Ку (сензоку) oh~
Dialogue: 0,0:08:27.06,0:08:30.69,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:08:31.49,0:08:33.82,Default,,0,0,0,,(Фукидің ауыр тыныс алуы)
Dialogue: 0,0:08:33.90,0:08:37.07,Default,,0,0,0,,Сіз бұрынғыдай қаталсыз (Чизоку) Дұрыс.
Dialogue: 0,0:08:37.58,0:08:39.16,Default,,0,0,0,,Біраз уақыт болды, Чизоку.
Dialogue: 0,0:08:39.24,0:08:40.37,Default,,0,0,0,,Ha
Dialogue: 0,0:08:40.45,0:08:41.83,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:08:41.91,0:08:44.67,Default,,0,0,0,,Мия өз міндетін орындамаса да
Dialogue: 0,0:08:44.75,0:08:46.83,Default,,0,0,0,,Сіз лицензияның артықшылығын алғыңыз келеді.
Dialogue: 0,0:08:46.92,0:08:50.17,Default,,0,0,0,,Сіз де анда-санда ДА жұмысын жасайсыз, солай ма?
Dialogue: 0,0:08:50.25,0:08:52.42,Default,,0,0,0,,Сензоку Бұл командирдің алдында!
Dialogue: 0,0:08:52.51,0:08:55.47,Default,,0,0,0,,Такина... Неге мені қуып жібердің?
Dialogue: 0,0:08:55.55,0:08:57.72,Default,,0,0,0,,Бұл бұйрықты бұзу, солай ма?
Dialogue: 0,0:08:57.80,0:08:59.56,Default,,0,0,0,,Бірақ мен достарымды құтқардым!
Dialogue: 0,0:08:59.64,0:09:03.06,Default,,0,0,0,,Нәтижесінде 1000 қарудың қайда екені белгісіз.
Dialogue: 0,0:09:03.14,0:09:05.39,Default,,0,0,0,,Саудагерлерді өлтіруге болмайды
Dialogue: 0,0:09:05.48,0:09:06.98,Default,,0,0,0,,Сіз мұны көрдіңіз бе?
Dialogue: 0,0:09:07.06,0:09:10.52,Default,,0,0,0,,Транзакция уақыты қате болды. Бұл командалық бөлімнің кінәсі.
Dialogue: 0,0:09:10.61,0:09:13.07,Default,,0,0,0,,Кусуноки мырзаның да жауапкершілігі бар, солай ма?
Dialogue: 0,0:09:13.15,0:09:14.28,Default,,0,0,0,,Сәлем Сензоку!
Dialogue: 0,0:09:15.24,0:09:19.99,Default,,0,0,0,,Басқалардың емі туралы уайымдамай тұрып, көбірек жұмыс істегеніңізді қалаймын.
Dialogue: 0,0:09:20.49,0:09:23.25,Default,,0,0,0,,Мен сізге тек көңіл көтеру үшін лицензия бермеймін.
Dialogue: 0,0:09:23.33,0:09:25.25,Default,,0,0,0,,А, мен алдадым! Тоқта!
Dialogue: 0,0:09:25.33,0:09:29.21,Default,,0,0,0,,Жалпы айтқанда, тіпті жағдайды бағалай алмаған дала жетекшілеріне де.
Dialogue: 0,0:09:29.29,0:09:30.54,Default,,0,0,0,,Бұл жауапкершілік емес пе?
Dialogue: 0,0:09:30.63,0:09:32.50,Default,,0,0,0,,Цк, сенің таңдауың жоқ!
Dialogue: 0,0:09:32.59,0:09:34.09,Default,,0,0,0,,Байланыстың бұзылуына байланысты штабпен байланысу...
Dialogue: 0,0:09:34.17,0:09:35.26,Default,,0,0,0,,Фуки Ах...
Dialogue: 0,0:09:35.84,0:09:38.22,Default,,0,0,0,,Байланыс ақауы?
Dialogue: 0,0:09:38.30,0:09:42.06,Default,,0,0,0,,Радиата бақылайтын операция кезінде байланыс ақауы орын алды.
Dialogue: 0,0:09:42.14,0:09:43.81,Default,,0,0,0,,Бұл қалыпты емес!
Dialogue: 0,0:09:43.89,0:09:45.68,Default,,0,0,0,,Бұл жай ғана техникалық ақау.
Dialogue: 0,0:09:45.77,0:09:48.19,Default,,0,0,0,,Кішкене, Кусуноки мырза
Dialogue: 0,0:09:48.27,0:09:50.81,Default,,0,0,0,,Радиатордың жарылуы өте қауіпті!
Dialogue: 0,0:09:50.90,0:09:52.57,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды түсінбеймін.
Dialogue: 0,0:09:52.65,0:09:54.90,Default,,0,0,0,,Кусуноки мырза! Тоқта, Чизоку.
Dialogue: 0,0:09:54.99,0:09:57.53,Default,,0,0,0,,Бұйрықты тыңдамай, өз ісін істейтін Мия сияқты.
Dialogue: 0,0:09:57.61,0:09:59.62,Default,,0,0,0,,Пайдасы жоқ, бар болғаны.
Dialogue: 0,0:09:59.70,0:10:01.83,Default,,0,0,0,,Фуки~
Dialogue: 0,0:10:03.79,0:10:06.66,Default,,0,0,0,,Такинаны ДА-ға қайтарыңыз!
Dialogue: 0,0:10:06.75,0:10:09.12,Default,,0,0,0,,Менің мұрагерім қазірдің өзінде осында.
Dialogue: 0,0:10:09.21,0:10:10.83,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:16.42,0:10:19.01,Default,,0,0,0,,Уау, бұл ақылсыз.
Dialogue: 0,0:10:19.64,0:10:22.60,Default,,0,0,0,,Сәлем, Отоме Сакура
Dialogue: 0,0:10:39.24,0:10:40.99,Default,,0,0,0,,(Қатты ұстау дыбысы)
Dialogue: 0,0:10:41.53,0:10:44.24,Default,,0,0,0,,Бұйрықтарымды елемей, достарымды босаттым.
Dialogue: 0,0:10:44.33,0:10:45.87,Default,,0,0,0,,Бұл рас па? Ах...
Dialogue: 0,0:10:46.45,0:10:48.16,Default,,0,0,0,,Уф, уау, бұл маңызды~
Dialogue: 0,0:10:48.25,0:10:49.67,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,0:10:50.25,0:10:53.38,Default,,0,0,0,,«Дұшпаннан одақтасты атқан қызық» дегендей ғой?
Dialogue: 0,0:10:53.46,0:10:54.17,Default,,0,0,0,,Өтінемін, тоқтаңдар!
Dialogue: 0,0:10:54.25,0:10:57.17,Default,,0,0,0,,Ой~ Мені атпаңызшы, өтінемін?
Dialogue: 0,0:10:57.26,0:11:00.43,Default,,0,0,0,,А, сен біреуді өлтіргенде ғана күлесің бе?
Dialogue: 0,0:11:00.51,0:11:01.89,Default,,0,0,0,,Кім бұлай өтірік айтады...
Dialogue: 0,0:11:01.97,0:11:03.85,Default,,0,0,0,,Жоқ, сен маған ұнайсың
Dialogue: 0,0:11:03.93,0:11:06.60,Default,,0,0,0,,Ол кино өлтірушіге ұқсайды, өте керемет.
Dialogue: 0,0:11:06.68,0:11:10.35,Default,,0,0,0,,Ахахха Жарайды, уайымдама.
Dialogue: 0,0:11:10.44,0:11:14.06,Default,,0,0,0,,Мен өзімнің ізбасарым ретінде үлкендер қалдырған олқылықтарды толтырамын.
Dialogue: 0,0:11:14.15,0:11:15.11,Default,,0,0,0,,ізбасар?
Dialogue: 0,0:11:15.19,0:11:17.15,Default,,0,0,0,,Иә? Сіз естіген жоқсыз ба?
Dialogue: 0,0:11:17.23,0:11:19.99,Default,,0,0,0,,Мен бұдан былай Фуки-санның серіктесі боламын.
Dialogue: 0,0:11:20.61,0:11:22.74,Default,,0,0,0,,Енді сізге орын жоқ.
Dialogue: 0,0:11:22.82,0:11:24.32,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:11:24.41,0:11:25.70,Default,,0,0,0,,Тыныш, балақай.
Dialogue: 0,0:11:25.78,0:11:26.74,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:11:26.83,0:11:28.33,Default,,0,0,0,,Бұл Сензоку.
Dialogue: 0,0:11:28.41,0:11:30.71,Default,,0,0,0,,Фуки-сенпай! Әй, командирге.
Dialogue: 0,0:11:31.79,0:11:33.42,Default,,0,0,0,,О, мынау радио мұнарасы.
Dialogue: 0,0:11:33.50,0:11:34.88,Default,,0,0,0,,«Бұл» деп айтпаңыз
Dialogue: 0,0:11:34.96,0:11:36.59,Default,,0,0,0,,Жоқ, сен жай ғана ақымақсың (Чизоку) Хмм!
Dialogue: 0,0:11:36.67,0:11:38.09,Default,,0,0,0,,Уф (Чизоку) Ах...
Dialogue: 0,0:11:38.76,0:11:43.68,Default,,0,0,0,,Командир, мен қару саудасы туралы жаңа ақпарат беретін фотосуреттерді алдым және жібердім.
Dialogue: 0,0:11:43.76,0:11:46.72,Default,,0,0,0,,Мен осы нәтижемен DA-ға орала аламын ба?
Dialogue: 0,0:11:46.81,0:11:47.85,Default,,0,0,0,,(Изуку) Бұл қараша айының соңында еді
Dialogue: 0,0:11:47.93,0:11:49.64,Default,,0,0,0,,Жақсы нәтижеге қол жеткізсем, мен ДА боламын...
Dialogue: 0,0:11:49.73,0:11:51.64,Default,,0,0,0,,Бұлай айтқаным есімде жоқ.
Dialogue: 0,0:11:51.73,0:11:52.60,Default,,0,0,0,,Кусуноки мырза!
Dialogue: 0,0:11:53.35,0:11:54.56,Default,,0,0,0,,Бұл...
Dialogue: 0,0:11:54.65,0:11:57.44,Default,,0,0,0,,Сіз маған бас тартуымды айтып тұрсыз. Сіз әлі түсінбейсіз бе?
Dialogue: 0,0:11:57.52,0:11:58.03,Default,,0,0,0,,Эй!
Dialogue: 0,0:11:58.11,0:12:01.40,Default,,0,0,0,,О, бұл қорқынышты, радио мұнарасының кейіпкері күткендей.
Dialogue: 0,0:12:01.49,0:12:02.99,Default,,0,0,0,,Айтуынша, бұл әсерлі.
Dialogue: 0,0:12:03.07,0:12:05.28,Default,,0,0,0,,Сакура, қазір жаттығу уақыты. Барайық.
Dialogue: 0,0:12:05.37,0:12:07.78,Default,,0,0,0,,Мен көбірек сөйлескім келді.
Dialogue: 0,0:12:07.87,0:12:08.45,Default,,0,0,0,,Ha
Dialogue: 0,0:12:10.00,0:12:11.08,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:11.16,0:12:12.16,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:12.25,0:12:15.21,Default,,0,0,0,,Түсінбедің бе, себебі сені ұрып-соққан сол кезде?
Dialogue: 0,0:12:15.29,0:12:17.46,Default,,0,0,0,,Олай болса сөзбен айтып беремін
Dialogue: 0,0:12:17.54,0:12:20.30,Default,,0,0,0,,Сіз бұдан былай ДА-ға қажет емессіз.
Dialogue: 0,0:12:20.38,0:12:21.51,Default,,0,0,0,,Тоқта, Фуки!
Dialogue: 0,0:12:21.59,0:12:23.76,Default,,0,0,0,,Ха, сен әлі түсінбедің бе?
Dialogue: 0,0:12:23.84,0:12:26.89,Default,,0,0,0,,Олай болса мен сені өтірік шайқаста ұрып-соғып, түсіндіремін.
Dialogue: 0,0:12:26.97,0:12:29.01,Default,,0,0,0,,О~о~о~ Бұл жақсы.
Dialogue: 0,0:12:29.10,0:12:30.77,Default,,0,0,0,,Такина Жасайық!
Dialogue: 0,0:12:30.85,0:12:31.73,Default,,0,0,0,,Жібер!
Dialogue: 0,0:12:31.81,0:12:32.48,Default,,0,0,0,,Ах, кешіріңіз, tsk.
Dialogue: 0,0:12:32.56,0:12:34.77,Default,,0,0,0,,Иә? Сіз қорқасыз ба?
Dialogue: 0,0:12:34.85,0:12:37.31,Default,,0,0,0,,Жарайды, 2-ге қарсы ойын...
Dialogue: 0,0:12:37.40,0:12:38.02,Default,,0,0,0,,Сәлем Такина!
Dialogue: 0,0:12:38.11,0:12:41.44,Default,,0,0,0,,Ахахха! Мен қашып кеттім
Dialogue: 0,0:12:42.65,0:12:43.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:45.49,0:12:47.41,Default,,0,0,0,,Сен де қашасың ба?
Dialogue: 0,0:12:56.54,0:12:58.04,Default,,0,0,0,,Мен оны осында деп ойладым.
Dialogue: 0,0:12:58.54,0:13:01.88,Default,,0,0,0,,Мұнда бәрі мияны жақсы көреді.
Dialogue: 0,0:13:05.51,0:13:06.72,Default,,0,0,0,,Осы жатақханада тұру
Dialogue: 0,0:13:06.80,0:13:09.76,Default,,0,0,0,,Д.А. көтеріп алған бізді, бәрінің тамсануы
Dialogue: 0,0:13:10.26,0:13:12.60,Default,,0,0,0,,Мен осы форманы кигенімде де...
Dialogue: 0,0:13:13.10,0:13:14.89,Default,,0,0,0,,Сіз бақытты болдыңыз, солай емес пе?
Dialogue: 0,0:13:16.40,0:13:19.86,Default,,0,0,0,,Хехе, сонша таңданба.
Dialogue: 0,0:13:20.36,0:13:21.90,Default,,0,0,0,,Мен де солай істеймін.
Dialogue: 0,0:13:21.98,0:13:26.32,Default,,0,0,0,,Сонда Сендзоку-сан түсінер еді, солай ма? Бұл мақсат болды
Dialogue: 0,0:13:29.45,0:13:33.41,Default,,0,0,0,,Бұл менің қолымнан алынды! Бұл неге...
Dialogue: 0,0:13:38.04,0:13:42.09,Default,,0,0,0,,Қалада отынға мұқтаж адамдар көп.
Dialogue: 0,0:13:42.17,0:13:43.51,Default,,0,0,0,,Бұл жерде болмаса да...
Dialogue: 0,0:13:43.59,0:13:46.47,Default,,0,0,0,,Бұл жақсы, өйткені сен ДА-ға керексің!
Dialogue: 0,0:13:46.55,0:13:50.68,Default,,0,0,0,,Мен үшін! Менің орным...
Dialogue: 0,0:13:52.31,0:13:54.22,Default,,0,0,0,,Енді бұл жерде емес
Dialogue: 0,0:13:59.10,0:14:00.27,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:14:01.52,0:14:02.61,Default,,0,0,0,,Такина
Dialogue: 0,0:14:02.69,0:14:05.49,Default,,0,0,0,,Мен бәріне кінәлі екенін білемін.
Dialogue: 0,0:14:05.99,0:14:09.11,Default,,0,0,0,,Сол кезде Такина достарын құтқарғысы келді.
Dialogue: 0,0:14:09.20,0:14:12.70,Default,,0,0,0,,Бұл бұйрық емес, бұл сіздің шешіміңіз, солай ма?
Dialogue: 0,0:14:12.78,0:14:14.62,Default,,0,0,0,,Бұл ең маңыздысы
Dialogue: 0,0:14:14.70,0:14:18.46,Default,,0,0,0,,Оның үстіне... Такинаның емделуінің бұған еш қатысы жоқ.
Dialogue: 0,0:14:19.46,0:14:21.75,Default,,0,0,0,,Сол күні байланыста ақау болғаны рас па?
Dialogue: 0,0:14:22.25,0:14:25.63,Default,,0,0,0,,Иә, бұл бірнеше минутты алады, бірақ бұл техникалық ақау.
Dialogue: 0,0:14:25.71,0:14:26.84,Default,,0,0,0,,Бұл бұзу.
Dialogue: 0,0:14:26.92,0:14:28.30,Default,,0,0,0,,Радиата?
Dialogue: 0,0:14:28.38,0:14:29.22,Default,,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:14:29.30,0:14:32.51,Default,,0,0,0,,Бұл DA құпиялылығына жауап беретін ең күшті AI, солай ма?
Dialogue: 0,0:14:32.60,0:14:34.89,Default,,0,0,0,,Сізде барлық инфрақұрылымға басым құқықтар бар.
Dialogue: 0,0:14:34.97,0:14:36.98,Default,,0,0,0,,Байланыстың бұзылуы мүмкін емес.
Dialogue: 0,0:14:37.06,0:14:40.15,Default,,0,0,0,,Бұзушылық... Сонымен сауда уақыты
Dialogue: 0,0:14:40.23,0:14:43.15,Default,,0,0,0,,Бірақ мен бұл туралы хабарлай алмаймын.
Dialogue: 0,0:14:43.23,0:14:45.78,Default,,0,0,0,,«Мия қашуы» Такина дегенді білдіреді...
Dialogue: 0,0:14:45.86,0:14:46.99,Default,,0,0,0,,Иә... Қайда бара жатырсың?
Dialogue: 0,0:14:47.07,0:14:49.20,Default,,0,0,0,,Бұл ақылға қонымсыз. Командирмен сөйлесіңіз...
Dialogue: 0,0:14:49.28,0:14:50.03,Default,,0,0,0,,Эй, эй, эй!
Dialogue: 0,0:14:50.11,0:14:52.16,Default,,0,0,0,,Тек кесіп тастаңыз
Dialogue: 0,0:14:52.24,0:14:53.66,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:14:54.16,0:14:54.87,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:56.50,0:15:00.21,Default,,0,0,0,,Такина Енді алға жылжу уақыты келді
Dialogue: 0,0:15:01.38,0:15:03.92,Default,,0,0,0,,Жоғалту арқылы ұтуға болатын нәрселер бар.
Dialogue: 0,0:15:05.09,0:15:07.63,Default,,0,0,0,,Егер мен мұны істемеген болсам
Dialogue: 0,0:15:07.71,0:15:09.51,Default,,0,0,0,,Біз ешқашан кездескен емеспіз
Dialogue: 0,0:15:11.05,0:15:11.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:12.43,0:15:14.01,Default,,0,0,0,,Не? не? Бір-бірімізді құшақтап тұрсақ та
Dialogue: 0,0:15:14.60,0:15:16.85,Default,,0,0,0,,Жастар? Ахахха, бұл күлкілі~
Dialogue: 0,0:15:16.93,0:15:18.02,Default,,0,0,0,,Ммм.
Dialogue: 0,0:15:18.10,0:15:20.02,Default,,0,0,0,,Танысқаныма қуаныштымын!
Dialogue: 0,0:15:20.10,0:15:21.77,Default,,0,0,0,,Эй... сәл күте тұрыңыз.
Dialogue: 0,0:15:21.85,0:15:24.23,Default,,0,0,0,,Бақытты бақытты!
Dialogue: 0,0:15:26.19,0:15:30.36,Default,,0,0,0,,Біреудің үмітін ақтау үшін ғана мұңайу қызықсыз.
Dialogue: 0,0:15:30.45,0:15:31.53,Default,,0,0,0,,Қонатын жер бар
Dialogue: 0,0:15:32.03,0:15:34.28,Default,,0,0,0,,Дүкенде барлығымен бірге уақыт өткізгіңіз келе ме?
Dialogue: 0,0:15:34.78,0:15:37.20,Default,,0,0,0,,Сонда да бұл жер ұнаса, қайтып келуге болады.
Dialogue: 0,0:15:37.70,0:15:38.58,Default,,0,0,0,,Әлі де кеш емес
Dialogue: 0,0:15:38.66,0:15:42.04,Default,,0,0,0,,Бұл әлі орындалып жатқан жұмыс. Мүмкіндіктер әрқашан келеді.
Dialogue: 0,0:15:42.12,0:15:44.63,Default,,0,0,0,,Содан кейін не істегіңіз келетінін таңдаңыз.
Dialogue: 0,0:15:44.71,0:15:46.29,Default,,0,0,0,,Мен не істегім келеді...
Dialogue: 0,0:15:46.38,0:15:47.17,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:48.88,0:15:51.76,Default,,0,0,0,,Мен әрқашан өзім қалаған нәрсеге басымдық беремін
Dialogue: 0,0:15:51.84,0:15:54.76,Default,,0,0,0,,Хе, сондықтан мен көп сәтсіздікке ұшырадым.
Dialogue: 0,0:15:54.85,0:15:58.31,Default,,0,0,0,,Енді мен Такинаға сұмдық сөздер айтқан жігіттерді ұрып тастағым келеді.
Dialogue: 0,0:15:58.39,0:15:59.73,Default,,0,0,0,,Мен біраз уақытқа барамын.
Dialogue: 0,0:16:02.14,0:16:03.56,Default,,0,0,0,,(ішкі хабар тарату қоңырауы)
Dialogue: 0,0:16:03.65,0:16:06.61,Default,,0,0,0,,Жағдаят бойынша жаттығу 1400-де басталады
Dialogue: 0,0:16:07.11,0:16:08.86,Default,,0,0,0,,Мия гүлінің әрбір мүшесі
Dialogue: 0,0:16:08.94,0:16:11.03,Default,,0,0,0,,Өлтіру үйінің стендіне жиналыңыз.
Dialogue: 0,0:16:11.11,0:16:15.32,Default,,0,0,0,,Жағдайды қайталау жаттығуы 1400-де басталады
Dialogue: 0,0:16:15.41,0:16:17.12,Default,,0,0,0,,Мия гүлінің әрбір мүшесі...
Dialogue: 0,0:16:17.20,0:16:19.79,Default,,0,0,0,,Эрика Такина келе жатыр.
Dialogue: 0,0:16:19.87,0:16:20.79,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:16:20.87,0:16:24.62,Default,,0,0,0,,Не, мен Фукимен жекпе-жек өткіземіз деп естідім бе?
Dialogue: 0,0:16:25.13,0:16:28.04,Default,,0,0,0,,Мен сенің кекіңді аламын. Барып көрейік.
Dialogue: 0,0:16:28.13,0:16:29.34,Default,,0,0,0,,Жау емес
Dialogue: 0,0:16:29.84,0:16:32.42,Default,,0,0,0,,Не? Ол жігіттің оқынан өліп қала жаздадым...
Dialogue: 0,0:16:32.51,0:16:36.55,Default,,0,0,0,,Мен тірімін! Жау қолына түскен мен едім.
Dialogue: 0,0:16:37.05,0:16:38.35,Default,,0,0,0,,Такина жаман емес
Dialogue: 0,0:16:39.35,0:16:41.60,Default,,0,0,0,,Сіз саудагерлерді өлтірмеуіңіз керек еді.
Dialogue: 0,0:16:41.68,0:16:44.85,Default,,0,0,0,,Иә, бірақ... Иә, бірақ!
Dialogue: 0,0:16:44.94,0:16:46.61,Default,,0,0,0,,Әй, радиомұнара өтірік шайқас жасап жатыр ма?
Dialogue: 0,0:16:46.69,0:16:48.06,Default,,0,0,0,,Шынайы ма? Сіз Чизоку-санды көре аласыз ба?
Dialogue: 0,0:16:48.15,0:16:48.90,Default,,0,0,0,,Тез, тез~
Dialogue: 0,0:16:48.98,0:16:50.53,Default,,0,0,0,,Хибана! Ах...
Dialogue: 0,0:16:50.61,0:16:54.45,Default,,0,0,0,,Бармайсың ба? Бұрынғы серіктестер арасындағы кездесу қызықты!
Dialogue: 0,0:16:54.53,0:16:57.82,Default,,0,0,0,,Мүмкін оның қайтып оралуы қауіп төніп тұрған шығар
Dialogue: 0,0:16:57.91,0:16:59.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:03.04,0:17:05.67,Default,,0,0,0,,Иә? Бұл бәрі болды ма?
Dialogue: 0,0:17:05.75,0:17:07.50,Default,,0,0,0,,Біреу жетіспейтін сияқты~
Dialogue: 0,0:17:07.58,0:17:11.34,Default,,0,0,0,,Стратегия! Стратегия! Эйс өзінің төзімділігін сақтайды.
Dialogue: 0,0:17:11.42,0:17:14.34,Default,,0,0,0,,Ол миссиядан тыс соғыса алатын жігіт емес.
Dialogue: 0,0:17:14.93,0:17:16.59,Default,,0,0,0,,Адамдарға көзің жетпейді.
Dialogue: 0,0:17:16.68,0:17:18.47,Default,,0,0,0,,Сондықтан мен бірінші орындаймын.
Dialogue: 0,0:17:18.55,0:17:21.22,Default,,0,0,0,,Ха, сен солсың. Бұл форма жай безендіру ме?
Dialogue: 0,0:17:21.31,0:17:23.10,Default,,0,0,0,,Сіз тек резеңке атуға болады
Dialogue: 0,0:17:23.18,0:17:25.89,Default,,0,0,0,,Не? Эй, сен қайдасың? Эй!
Dialogue: 0,0:17:25.98,0:17:28.40,Default,,0,0,0,,А? Сіздің басыңыз резеңкеге айналды ма?
Dialogue: 0,0:17:28.48,0:17:31.44,Default,,0,0,0,,Мен өмір бойы радио мұнарасының етегінде шай қайнатып өтемін!
Dialogue: 0,0:17:31.53,0:17:32.61,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:32.69,0:17:34.53,Default,,0,0,0,,Балалар сендер жақсы достарсыңдар.
Dialogue: 0,0:17:35.15,0:17:36.53,Default,,0,0,0,,Бастайық.
Dialogue: 0,0:17:37.11,0:17:37.91,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:17:37.99,0:17:40.03,Default,,0,0,0,,Өтінемін, өтінемін.
Dialogue: 0,0:17:43.08,0:17:47.00,Default,,0,0,0,,Екі жақ шайқасқа нағыз шайқас сияқты жақындауы керек.
Dialogue: 0,0:17:47.62,0:17:48.46,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:17:49.17,0:17:49.67,Default,,0,0,0,,Кейде көңіл көтеру керек қой…
Dialogue: 0,0:17:49.75,0:17:51.17,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:17:55.92,0:17:57.01,Default,,0,0,0,,Әй
Dialogue: 0,0:17:59.55,0:18:00.51,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:00.60,0:18:01.56,Default,,0,0,0,,Ішек
Dialogue: 0,0:18:01.64,0:18:02.97,Default,,0,0,0,,О!
Dialogue: 0,0:18:03.97,0:18:05.89,Default,,0,0,0,,Мұны істеме Фуки
Dialogue: 0,0:18:07.06,0:18:08.31,Default,,0,0,0,,Жоспарланғандай
Dialogue: 0,0:18:10.36,0:18:11.31,Default,,0,0,0,,Міне!
Dialogue: 0,0:18:14.36,0:18:15.49,Default,,0,0,0,,келді
Dialogue: 0,0:18:15.57,0:18:19.20,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:19.28,0:18:20.07,Default,,0,0,0,,Уф
Dialogue: 0,0:18:20.16,0:18:21.53,Default,,0,0,0,,Оның қолдары өте жақсы.
Dialogue: 0,0:18:21.62,0:18:23.12,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:18:23.20,0:18:26.04,Default,,0,0,0,,Олай емес, егер мен қолдарымды осылай жақын созсам
Dialogue: 0,0:18:26.12,0:18:27.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:27.08,0:18:28.62,Default,,0,0,0,,Мен екі рет өлдім.
Dialogue: 0,0:18:28.71,0:18:29.71,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:29.79,0:18:30.54,Default,,0,0,0,,Уау
Dialogue: 0,0:18:30.63,0:18:32.29,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:18:32.88,0:18:34.80,Default,,0,0,0,,Бұл не? Бұл жігіттің аты жоқ
Dialogue: 0,0:18:34.88,0:18:36.26,Default,,0,0,0,,Сіз күтіп тұрсыз ба?
Dialogue: 0,0:18:36.34,0:18:38.22,Default,,0,0,0,,Ол сондай жігіт.
Dialogue: 0,0:18:40.43,0:18:43.51,Default,,0,0,0,,Такина Енді алға жылжу уақыты келді
Dialogue: 0,0:18:44.47,0:18:46.73,Default,,0,0,0,,Жоғалту арқылы ұтуға болатын нәрселер бар.
Dialogue: 0,0:18:47.93,0:18:52.23,Default,,0,0,0,,Біреудің үмітін ақтау үшін ғана мұңайу қызықсыз.
Dialogue: 0,0:18:52.31,0:18:53.06,Default,,0,0,0,,Қонатын жер бар
Dialogue: 0,0:18:53.82,0:18:56.11,Default,,0,0,0,,Дүкенде барлығымен бірге уақыт өткізгіңіз келе ме?
Dialogue: 0,0:18:56.61,0:18:59.03,Default,,0,0,0,,Сонда да бұл жер ұнаса, қайтып келуге болады.
Dialogue: 0,0:18:59.53,0:19:00.66,Default,,0,0,0,,Әлі де кеш емес
Dialogue: 0,0:19:00.74,0:19:04.58,Default,,0,0,0,,Бұл әлі орындалып жатқан жұмыс. Мүмкіндіктер әрқашан келеді.
Dialogue: 0,0:19:04.66,0:19:06.95,Default,,0,0,0,,Соқыр атсаң да, соқпайсың.
Dialogue: 0,0:19:07.04,0:19:08.91,Default,,0,0,0,,Мен ату шеберлігіме сенімдімін!
Dialogue: 0,0:19:09.00,0:19:10.46,Default,,0,0,0,,Сондықтан да одан да сорақы!
Dialogue: 0,0:19:10.54,0:19:12.21,Default,,0,0,0,,Мен бір нәрсені ұмытып қалдым~
Dialogue: 0,0:19:12.29,0:19:13.25,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:19:13.34,0:19:14.54,Default,,0,0,0,,Тоқта! Сакура!
Dialogue: 0,0:19:14.63,0:19:17.88,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:19:20.43,0:19:21.26,Default,,0,0,0,,(Журналдың таусылып бара жатқан дыбысы)
Dialogue: 0,0:19:21.34,0:19:23.60,Default,,0,0,0,,Уа, ау, ау... ау
Dialogue: 0,0:19:23.68,0:19:24.26,Default,,0,0,0,,Ui~
Dialogue: 0,0:19:25.06,0:19:25.85,Default,,0,0,0,,Уау
Dialogue: 0,0:19:26.35,0:19:28.22,Default,,0,0,0,,Құт
Dialogue: 0,0:19:28.31,0:19:30.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:31.02,0:19:31.73,Default,,0,0,0,,(Нанами) Болмайды. Мен саған бүгін таңертең неге екенін айттым ғой, иә?
Dialogue: 0,0:19:39.44,0:19:40.28,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:19:42.28,0:19:43.45,Default,,0,0,0,,Ішек
Dialogue: 0,0:19:44.07,0:19:45.62,Default,,0,0,0,,(Соққы дыбысы)
Dialogue: 0,0:19:46.70,0:19:47.62,Default,,0,0,0,,Абдул мырза осыған алаңдап, сенің артыңнан келді, және солай аяқталды
Dialogue: 0,0:19:47.70,0:19:52.17,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:19:52.87,0:19:57.46,Default,,0,0,0,,(Мия лепі)
Dialogue: 0,0:19:57.55,0:19:59.13,Default,,0,0,0,,О~
Dialogue: 0,0:20:04.72,0:20:05.80,Default,,0,0,0,,Жасайық
Dialogue: 0,0:20:06.93,0:20:08.43,Default,,0,0,0,,Бұл Сензоку ма?
Dialogue: 0,0:20:08.93,0:20:12.06,Default,,0,0,0,,Мен оның қозғалғанын бірінші рет көріп тұрмын. Бұл қандай сиқыр?
Dialogue: 0,0:20:12.14,0:20:13.85,Default,,0,0,0,,Үлкен түсінікпен
Dialogue: 0,0:20:13.94,0:20:17.57,Default,,0,0,0,,Қарсыласының атыс сызығын, атыс уақытын байқайтын данышпан.
Dialogue: 0,0:20:20.74,0:20:24.03,Default,,0,0,0,,Сензокуды дәл осы қашықтықтан ату қиын.
Dialogue: 0,0:20:24.61,0:20:26.91,Default,,0,0,0,,Бірақ одан басқа...
Dialogue: 0,0:20:27.66,0:20:30.45,Default,,0,0,0,,Хехе, ақымақ жігіт.
Dialogue: 0,0:20:33.75,0:20:37.17,Default,,0,0,0,,Таккина~ Үйге бара жатқан көлік осында!
Dialogue: 0,0:20:37.25,0:20:38.34,Default,,0,0,0,,Төтенше тоқтау! Жүгір!
Dialogue: 0,0:20:39.75,0:20:42.17,Default,,0,0,0,,Сіз жалған шайқастасыз.
Dialogue: 0,0:20:42.26,0:20:44.13,Default,,0,0,0,,Мен оны артынан атып тастауым керек еді.
Dialogue: 0,0:20:44.63,0:20:47.60,Default,,0,0,0,,Асығып кіріп, онымен ұру - ақымақтық.
Dialogue: 0,0:20:48.97,0:20:50.56,Default,,0,0,0,,Бұл Айко.
Dialogue: 0,0:20:50.64,0:20:51.60,Default,,0,0,0,,Ішек
Dialogue: 0,0:20:52.81,0:20:55.85,Default,,0,0,0,,Ақыр соңында, сен түкке тұрғысыз миясың.
Dialogue: 0,0:20:55.94,0:21:00.23,Default,,0,0,0,,Бұйрықтарды бұзып, озбырлық жасау. Қайтып келме.
Dialogue: 0,0:21:01.07,0:21:04.86,Default,,0,0,0,,Мен оны сонда қалдырамын, хехе, бірақ мен оны сонда қалдырмаймын~
Dialogue: 0,0:21:06.03,0:21:07.91,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:21:07.99,0:21:11.70,Default,,0,0,0,,Менің атуымның нашар болғаны сонша, тіпті үлкендерді де ұятқа қалдырдым.
Dialogue: 0,0:21:12.20,0:21:14.04,Default,,0,0,0,,Жалтару оңайырақ болды.
Dialogue: 0,0:21:14.12,0:21:15.96,Default,,0,0,0,,Түсіруіңіз дәл.
Dialogue: 0,0:21:16.04,0:21:18.54,Default,,0,0,0,,Иә! Ол оқтан жалтарады ма?
Dialogue: 0,0:21:18.63,0:21:20.75,Default,,0,0,0,,Мұндай жағдай тек мангада болады, солай ма?
Dialogue: 0,0:21:20.84,0:21:23.63,Default,,0,0,0,,Мені ренжітетін де осы.
Dialogue: 0,0:21:24.47,0:21:25.01,Default,,0,0,0,,Уау
Dialogue: 0,0:21:25.09,0:21:27.39,Default,,0,0,0,,Келесі жолы мен мүлде жеңілмеймін!
Dialogue: 0,0:21:27.47,0:21:30.35,Default,,0,0,0,,О, күте тұрыңыз ...
Dialogue: 0,0:21:31.56,0:21:33.56,Default,,0,0,0,,Такина, мен қайтып келдім. Жарайды ма?
Dialogue: 0,0:21:33.64,0:21:35.44,Default,,0,0,0,,Жеңіске жетсең, қайтасың
Dialogue: 0,0:21:35.52,0:21:37.10,Default,,0,0,0,,Бұл өтірік болды.
Dialogue: 0,0:21:37.19,0:21:39.65,Default,,0,0,0,,Мен не айтарымды білмеймін.
Dialogue: 0,0:21:40.32,0:21:41.15,Default,,0,0,0,,Хмм…
Dialogue: 0,0:21:41.65,0:21:42.36,Default,,0,0,0,,Әй, Такина!
Dialogue: 0,0:21:42.44,0:21:43.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:44.57,0:21:45.45,Default,,0,0,0,,Өтірік
Dialogue: 0,0:21:54.00,0:21:55.25,Default,,0,0,0,,Такинаса~
Dialogue: 0,0:21:56.29,0:21:57.37,Default,,0,0,0,,Оларға мұқият қарап тұр.
Dialogue: 0,0:21:57.96,0:21:59.71,Default,,0,0,0,,Сен маған оқ аттың.
Dialogue: 0,0:22:00.21,0:22:01.00,Default,,0,0,0,,Хмм
Dialogue: 0,0:22:02.67,0:22:04.63,Default,,0,0,0,,Мен сіз оны міндетті түрде айналып өтесіз деп ойладым.
Dialogue: 0,0:22:05.22,0:22:06.17,Default,,0,0,0,,О~
Dialogue: 0,0:22:08.68,0:22:12.10,Default,,0,0,0,,Чизоку - ессіз адам.
Dialogue: 0,0:22:12.97,0:22:15.39,Default,,0,0,0,,Бірақ бұл сергітетін болды.
Dialogue: 0,0:22:19.23,0:22:20.19,Default,,0,0,0,,Иә
Dialogue: 0,0:22:22.40,0:22:23.78,Default,,0,0,0,,(Смартфонды қабылдау дыбысы)
Dialogue: 0,0:22:24.36,0:22:25.15,Default,,0,0,0,,О
Dialogue: 0,0:22:25.90,0:22:28.11,Default,,0,0,0,,О, қараңдаршы!
Dialogue: 0,0:22:28.20,0:22:28.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:30.07,0:22:31.20,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:22:31.28,0:22:33.24,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:22:33.33,0:22:35.08,Default,,0,0,0,,О, Сензоку, келесің бе?
Dialogue: 0,0:22:35.16,0:22:36.62,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:22:37.21,0:22:39.54,Default,,0,0,0,,Хмм? Ха
Dialogue: 0,0:22:44.63,0:22:46.63,Default,,0,0,0,,♪~
Dialogue: 0,0:23:58.41,0:24:00.41,Default,,0,0,0,,~♪
Dialogue: 0,0:24:01.91,0:24:06.91,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
