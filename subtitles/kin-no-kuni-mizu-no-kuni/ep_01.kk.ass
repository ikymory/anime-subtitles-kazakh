Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:47.29,0:00:51.26,Default,,0,0,0,,Бір кездері
Dialogue: 0,0:00:51.38,0:00:55.34,Default,,0,0,0,,Бұл 1000 жылдан астам уақыт бұрын болған
Dialogue: 0,0:00:58.35,0:01:00.68,Default,,0,0,0,,Әлхамит пен Байқари
Dialogue: 0,0:01:00.81,0:01:05.06,Default,,0,0,0,,Өте нашар жағдайдағы көрші ел болды.
Dialogue: 0,0:01:05.39,0:01:11.36,Default,,0,0,0,,Сенің шөптерің күнде менің бақшама кірді.
Dialogue: 0,0:01:11.48,0:01:14.90,Default,,0,0,0,,Сіз және мына желдеткіш қатты дауыссыз.
Dialogue: 0,0:01:15.03,0:01:18.45,Default,,0,0,0,,Бұл қызықсыз болды, мен онымен қиын болдым.
Dialogue: 0,0:01:18.45,0:01:19.45,Default,,0,0,0,,Біз қызықсыз нәрселерден қиналдық (ит үреді)
Dialogue: 0,0:01:19.78,0:01:24.08,Default,,0,0,0,,Соңында, иттің нәжісін тазалау триггер болды.
Dialogue: 0,0:01:24.21,0:01:27.63,Default,,0,0,0,,Бұл соғысқа айналды
Dialogue: 0,0:01:29.00,0:01:34.80,Default,,0,0,0,,Екі ел көптен бері күресіп келеді.
Dialogue: 0,0:01:36.13,0:01:38.30,Default,,0,0,0,,Ақыры таусылғанда
Dialogue: 0,0:01:38.43,0:01:42.10,Default,,0,0,0,,Екі елдің ұзақтығы «белгілі бір ант» алмасты.
Dialogue: 0,0:01:42.22,0:01:46.60,Default,,0,0,0,,Ұзақ соғыс біткен сияқты.
Dialogue: 0,0:01:46.60,0:01:47.44,Default,,0,0,0,,Ұзақ соғыс біткен сияқты (мысық мияулау)
Dialogue: 0,0:01:47.73,0:01:50.65,Default,,0,0,0,,Бірақ бұл жолы мысық сидиді
Dialogue: 0,0:01:50.82,0:01:55.65,Default,,0,0,0,,Кірмесем ұрыс болды.
Dialogue: 0,0:01:55.78,0:01:58.57,Default,,0,0,0,,Қақтығыстар қайтадан басталады
Dialogue: 0,0:01:58.70,0:02:03.08,Default,,0,0,0,,Ал мен жиі ұрыса бастадым...
Dialogue: 0,0:02:05.00,0:02:10.84,Default,,0,0,0,,Ұзақ уақыт өткен соң, ақыры екі елдің шекарасы
Dialogue: 0,0:02:10.96,0:02:14.26,Default,,0,0,0,,Үлкен қабырға жасалды
Dialogue: 0,0:02:15.26,0:02:21.22,Default,,0,0,0,,Бұл екі елдің бір кездері берген «белгілі ант» болды.
Dialogue: 0,0:02:21.80,0:02:24.68,Default,,0,0,0,,Әлхамит – достықтың белгісі.
Dialogue: 0,0:02:24.81,0:02:30.35,Default,,0,0,0,,«Елдің ең сұлу қызын» Байқариға келін етіп жібер
Dialogue: 0,0:02:30.52,0:02:35.07,Default,,0,0,0,,Байкариді «елдегі ең ақылды жас» деп те атайды.
Dialogue: 0,0:02:35.19,0:02:39.53,Default,,0,0,0,,Оған үйленіп, әл-Хамитке жіберген кезде...
Dialogue: 0,0:02:42.66,0:02:44.24,Default,,0,0,0,,(Хане)
Dialogue: 0,0:02:44.37,0:02:45.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:03.55,0:03:04.72,Default,,0,0,0,,(Хане)
Dialogue: 0,0:03:04.89,0:03:05.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:12.23,0:03:13.19,Default,,0,0,0,,Ах
Dialogue: 0,0:03:40.22,0:03:43.09,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:03:50.60,0:03:54.98,Default,,0,0,0,,Ханшайым, ұят... Мұндай күннің келетініне сене алар емеспін.
Dialogue: 0,0:03:55.65,0:03:56.77,Default,,0,0,0,,Мен бұған көмектесе алмаймын.
Dialogue: 0,0:03:56.94,0:04:01.74,Default,,0,0,0,,Бірақ өсек-аяң болған жабайылар келеді деп ойласаң...
Dialogue: 0,0:04:01.99,0:04:05.78,Default,,0,0,0,,Хмм, бірақ мен сені кездестірмейінше білмеймін.
Dialogue: 0,0:04:05.95,0:04:10.54,Default,,0,0,0,,Оның үстіне айдаланың арғы жағындағы біреуге тұрмысқа шыққаннан артық деп ойлаймын.
Dialogue: 0,0:04:10.75,0:04:12.50,Default,,0,0,0,,Эй, сен білесің бе? Баая
Dialogue: 0,0:04:12.62,0:04:16.34,Default,,0,0,0,,Байқары суға бай, жерден ыстық су шығады.
Dialogue: 0,0:04:16.46,0:04:19.46,Default,,0,0,0,,Онда жартылай пісірілген жұмыртқа жасауға болады!
Dialogue: 0,0:04:19.59,0:04:21.51,Default,,0,0,0,,Бұл сөзсіз өтірік.
Dialogue: 0,0:04:22.13,0:04:26.01,Default,,0,0,0,,Патша сияқты сұмдық болса, дереу кесіп алайық!
Dialogue: 0,0:04:26.30,0:04:29.43,Default,,0,0,0,,Ханшайымның әжесі бар...
Dialogue: 0,0:04:31.68,0:04:35.65,Default,,0,0,0,,Ештеңе етпейді, бір кездері әкем мені қабылдамады.
Dialogue: 0,0:04:35.81,0:04:40.65,Default,,0,0,0,,Мен өзімнің әдемі әпкелерімнен ешқашан қызғанған емеспін.
Dialogue: 0,0:04:40.78,0:04:44.78,Default,,0,0,0,,Кім келсе де, біз әдетте жақсы тіл табыса аламыз.
Dialogue: 0,0:04:45.28,0:04:50.49,Default,,0,0,0,,Себебі ханшайым тым сабырлы және ешкімге қауіп төндірмейді.
Dialogue: 0,0:04:50.66,0:04:55.58,Default,,0,0,0,,Мынадай ханшайымды көру... патша қандай қоқыс екен!
Dialogue: 0,0:04:55.71,0:04:57.79,Default,,0,0,0,,Жарайды, егер солай істесең...
Dialogue: 0,0:04:58.88,0:05:00.80,Default,,0,0,0,,Жоқ, мырза—
Dialogue: 0,0:05:01.34,0:05:02.88,Default,,0,0,0,,Байқардан шыққан күйеу бала
Dialogue: 0,0:05:03.01,0:05:07.01,Default,,0,0,0,,Оны шалғайда тұратын, кәнизак болған кенже қызының орнына итеріп жібердің бе?
Dialogue: 0,0:05:07.18,0:05:11.27,Default,,0,0,0,,Ха, патша, ол бүгін келеді.
Dialogue: 0,0:05:11.39,0:05:12.85,Default,,0,0,0,,Кунуну
Dialogue: 0,0:05:13.14,0:05:16.15,Default,,0,0,0,,Бұл Раставан II алмасқан ант...
Dialogue: 0,0:05:17.06,0:05:20.23,Default,,0,0,0,,Менің ойымша, бұл жерден келін жоспар бойынша жіберілді.
Dialogue: 0,0:05:20.36,0:05:21.65,Default,,0,0,0,,Қазірдің өзінде
Dialogue: 0,0:05:35.75,0:05:38.58,Default,,0,0,0,,Сіз ант бердім дедіңіз ғой, солай ма? Сіз оны 500 жыл бұрын жасадыңыз!?
Dialogue: 0,0:05:38.71,0:05:40.17,Default,,0,0,0,,Бұл өте тітіркендіргіш!
Dialogue: 0,0:05:40.50,0:05:45.05,Default,,0,0,0,,Әлхамиттен әйелді біреу қабылдай ма?
Dialogue: 0,0:05:45.51,0:05:49.60,Default,,0,0,0,,Жоспарлағандай, шекара маңындағы ғалымға бер!
Dialogue: 0,0:05:49.72,0:05:51.14,Default,,0,0,0,,Иә
Dialogue: 0,0:05:52.47,0:05:53.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:53.39,0:05:55.31,Default,,0,0,0,,Бұл бастықтың бұйрығы!
Dialogue: 0,0:05:55.43,0:05:59.06,Default,,0,0,0,,Архамит елінен келін алуға жауапты боласыз деп шешілді!
Dialogue: 0,0:05:59.69,0:06:00.73,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:06:01.15,0:06:04.23,Default,,0,0,0,,Осы үшін рахмет, шенеуніктер!
Dialogue: 0,0:06:04.40,0:06:07.86,Default,,0,0,0,,Артында жұмыссыз инженер қалдырып, елдің сәтсіздіктері жалғасуда.
Dialogue: 0,0:06:07.99,0:06:09.70,Default,,0,0,0,,Менің әйеліме қамқор болады деп ойламаппын!
Dialogue: 0,0:06:09.82,0:06:12.20,Default,,0,0,0,,Жоқ! (Ресми В) Аузыңызға сақ болыңыз!
Dialogue: 0,0:06:12.33,0:06:16.33,Default,,0,0,0,,Менің әйелім жақында келді. Үйге барып, онымен танысыңыз!
Dialogue: 0,0:06:16.83,0:06:18.08,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:06:19.83,0:06:21.84,Default,,0,0,0,,Мен де біраз құттықтаулар алдым.
Dialogue: 0,0:06:21.96,0:06:22.96,Default,,0,0,0,,Бізге Токио ұнайды! (Фушигуро) Ә?
Dialogue: 0,0:06:24.38,0:06:25.80,Default,,0,0,0,,Таку
Dialogue: 0,0:06:25.92,0:06:30.84,Default,,0,0,0,,Әлхамит байы қазіргі Байқариға қалай үйленді?
Dialogue: 0,0:06:30.97,0:06:32.60,Default,,0,0,0,,Сіз таң қаласыз...
Dialogue: 0,0:06:32.81,0:06:34.93,Default,,0,0,0,,Жоқ, мен қиыншылыққа ұшырадым.
Dialogue: 0,0:06:35.06,0:06:36.77,Default,,0,0,0,,Әке, мен үйдемін.
Dialogue: 0,0:06:36.89,0:06:39.31,Default,,0,0,0,,Ах! Бұл қиын!
Dialogue: 0,0:06:39.44,0:06:44.36,Default,,0,0,0,,Хахахаха Таң қалмаңыз!? Бұрын бір шенеунік келіп, әйелі келгенін айтты.
Dialogue: 0,0:06:44.48,0:06:47.44,Default,,0,0,0,,Жарайды! Менің қорғаныс аясы өте кең.
Dialogue: 0,0:06:47.57,0:06:50.11,Default,,0,0,0,,Жарайды, сен менің ұлымсың.
Dialogue: 0,0:06:50.91,0:06:53.24,Default,,0,0,0,,Қорғаныс аясы кең болатыны сөзсіз.
Dialogue: 0,0:06:53.41,0:06:58.46,Default,,0,0,0,,Бірақ менің естуімше, Әлхамит әйелдерінің азу тістері бар және бүкіл денелері бұталы шаштары бар...
Dialogue: 0,0:06:58.58,0:07:01.04,Default,,0,0,0,,Хаха мүмкін емес...
Dialogue: 0,0:07:02.75,0:07:04.80,Default,,0,0,0,,Танысқаныма қуаныштымын~
Dialogue: 0,0:07:09.09,0:07:10.26,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:07:10.84,0:07:11.93,Default,,0,0,0,,Мысық па?
Dialogue: 0,0:07:12.05,0:07:13.35,Default,,0,0,0,,Мияу
Dialogue: 0,0:07:16.22,0:07:17.31,Default,,0,0,0,,Мен...
Dialogue: 0,0:07:17.47,0:07:18.64,Default,,0,0,0,,Ит пе?
Dialogue: 0,0:07:19.14,0:07:20.48,Default,,0,0,0,,
Dialogue: 0,0:07:21.98,0:07:24.06,Default,,0,0,0,,Бая! Ит! Ит!
Dialogue: 0,0:07:24.19,0:07:26.07,Default,,0,0,0,,Менің күйеу балам ит!
Dialogue: 0,0:07:27.44,0:07:28.53,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:29.11,0:07:29.78,Default,,0,0,0,,Он соққылы қарғыс техникасы: Тайл құлау, Тайл құлау!
Dialogue: 0,0:07:29.78,0:07:30.78,Default,,0,0,0,,Ах… «C» рейтингі
Dialogue: 0,0:07:31.11,0:07:34.58,Default,,0,0,0,,Байқали! Мені ақымақ қыл...
Dialogue: 0,0:07:34.78,0:07:36.62,Default,,0,0,0,,Қазір патшаға хабарлаңыз!!
Dialogue: 0,0:07:36.74,0:07:38.25,Default,,0,0,0,,А, сәл күте тұрыңыз!
Dialogue: 0,0:07:38.62,0:07:40.71,Default,,0,0,0,,Ханшайым! бұл да
Dialogue: 0,0:07:40.83,0:07:42.00,Default,,0,0,0,,Егер әкең білсе
Dialogue: 0,0:07:42.25,0:07:45.96,Default,,0,0,0,,Бұл тағы бір соғысқа әкелуі мүмкін.
Dialogue: 0,0:07:46.17,0:07:49.76,Default,,0,0,0,,Байқари бірдеңе дегенше үндеме.
Dialogue: 0,0:07:52.13,0:07:54.64,Default,,0,0,0,,Бейбітшілік барлық нәрседе жақсы.
Dialogue: 0,0:07:54.80,0:07:55.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:57.14,0:07:58.43,Default,,0,0,0,,Бейбітшілік…
Dialogue: 0,0:07:58.89,0:07:59.60,Default,,0,0,0,,Бір!
Dialogue: 0,0:07:59.93,0:08:02.27,Default,,0,0,0,,Бірақ ханшайым...
Dialogue: 0,0:08:02.60,0:08:03.73,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:08:04.73,0:08:06.48,Default,,0,0,0,,Танжиро мен Незуко Қандыперделерді жоюшылар корпусының мүшелері ретінде шайқаса алатынын,
Dialogue: 0,0:08:07.36,0:08:10.15,Default,,0,0,0,,«Лұқман» туралы не деуге болады?
Dialogue: 0,0:08:10.15,0:08:10.94,Default,,0,0,0,,«Лұқман» туралы не деуге болады? бір!
Dialogue: 0,0:08:11.70,0:08:12.74,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,0:08:12.95,0:08:14.53,Default,,0,0,0,,Иә, Лұқман?
Dialogue: 0,0:08:14.66,0:08:15.62,Default,,0,0,0,,Мен оның бетіндегі өңді көргім келеді
Dialogue: 0,0:08:16.66,0:08:18.87,Default,,0,0,0,,Жақсы есім, солай емес пе? бір!
Dialogue: 0,0:08:25.08,0:08:26.13,Default,,0,0,0,,Лұқман
Dialogue: 0,0:08:26.25,0:08:30.26,Default,,0,0,0,,Мен сенің тамағыңды сатып алғаннан кейін, мен сені өз орныма апарамын.
Dialogue: 0,0:08:30.38,0:08:31.59,Default,,0,0,0,,Бір!
Dialogue: 0,0:08:32.01,0:08:34.47,Default,,0,0,0,,Ол жерде өте әдемі.
Dialogue: 0,0:08:34.59,0:08:36.68,Default,,0,0,0,,Гүлдер қазір гүлдеп тұр.
Dialogue: 0,0:08:37.35,0:08:41.98,Default,,0,0,0,,♪ Түскі ас – шикі ветчина мен қуырылған тауық еті
Dialogue: 0,0:08:42.10,0:08:44.94,Default,,0,0,0,,Менің сүйікті қызыл шарапым да дәмді көрінеді.
Dialogue: 0,0:08:44.94,0:08:46.02,Default,,0,0,0,,Менің сүйікті қызыл шарапым да дәмді көрінеді (Лұқман жылап, ишара жасайды)
Dialogue: 0,0:08:46.15,0:08:49.07,Default,,0,0,0,,Сүйекті қысқа қабырғаларды ұмытпаңыз
Dialogue: 0,0:08:49.07,0:08:50.40,Default,,0,0,0,,Сүйекті қысқа қабырғаларды ұмытпа (Лұқман шырылдап, қимыл жасайды)
Dialogue: 0,0:08:55.53,0:08:56.37,Default,,0,0,0,,Бір?
Dialogue: 0,0:09:00.16,0:09:04.79,Default,,0,0,0,,Біз жақсы сатып алулар жасадық. Кеттік, Лұқман.
Dialogue: 0,0:09:05.54,0:09:07.42,Default,,0,0,0,,Бір (Сара) Хэхе...
Dialogue: 0,0:09:07.96,0:09:08.75,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:09:08.75,0:09:10.30,Default,,0,0,0,,Куун (Сара) А?
Dialogue: 0,0:09:12.97,0:09:13.67,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:14.13,0:09:16.72,Default,,0,0,0,,Не? (2-ер адам) Бұл патша астанасынан.
Dialogue: 0,0:09:20.51,0:09:21.56,Default,,0,0,0,,Бір?
Dialogue: 0,0:09:22.93,0:09:25.56,Default,,0,0,0,,Қайырлы күн Сара
Dialogue: 0,0:09:26.19,0:09:29.40,Default,,0,0,0,,Қайырлы күн, Леополдин апа
Dialogue: 0,0:09:29.52,0:09:30.94,Default,,0,0,0,,Неліктен бүгін?
Dialogue: 0,0:09:31.11,0:09:33.94,Default,,0,0,0,,Жоқ! Білсем де~
Dialogue: 0,0:09:34.07,0:09:35.70,Default,,0,0,0,,Мен Байқаридан келдім.
Dialogue: 0,0:09:35.82,0:09:38.32,Default,,0,0,0,,Мен «сеннің күйеуіңді» көруге келдім
Dialogue: 0,0:09:38.87,0:09:40.49,Default,,0,0,0,,Сіз қандай адамсыз?
Dialogue: 0,0:09:40.62,0:09:42.33,Default,,0,0,0,,Ах... Мм...
Dialogue: 0,0:09:44.25,0:09:48.08,Default,,0,0,0,,Жарайды... бұл жай ғана қауесет айтқандай.
Dialogue: 0,0:09:49.50,0:09:54.46,Default,,0,0,0,,Өте ақылды және ұқыпты...
Dialogue: 0,0:09:54.97,0:09:56.01,Default,,0,0,0,,Е...
Dialogue: 0,0:09:56.59,0:10:00.18,Default,,0,0,0,,Ол аздап ақымақ, бірақ сүйкімді.
Dialogue: 0,0:10:00.30,0:10:01.22,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:01.35,0:10:04.73,Default,,0,0,0,,Егер бұл рас болса, біз де сізбен кездескіміз келеді.
Dialogue: 0,0:10:05.14,0:10:08.73,Default,,0,0,0,,А, бірақ! Мен жаңа келдім, сондықтан бүгін әлі аз...
Dialogue: 0,0:10:08.85,0:10:10.06,Default,,0,0,0,,(Джунпей) Маған ұнамайтын адамдарды өлтіретін түйме болса да—
Dialogue: 0,0:10:10.19,0:10:11.86,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:10:12.19,0:10:16.74,Default,,0,0,0,,Әкең маған сыйлаған алтын сағат уақытты тоқтатты.
Dialogue: 0,0:10:16.86,0:10:19.57,Default,,0,0,0,,Алтын сағат...?
Dialogue: 0,0:10:19.70,0:10:25.29,Default,,0,0,0,,Байкарийчи, ақылды болсаң, түзете аласың ба?
Dialogue: 0,0:10:25.41,0:10:26.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:27.16,0:10:28.17,Default,,0,0,0,,Мен сені көремін деп үміттенемін
Dialogue: 0,0:10:28.29,0:10:30.38,Default,,0,0,0,,Айтыңызшы, мен оны асыға күтемін.
Dialogue: 0,0:10:30.50,0:10:31.34,Default,,0,0,0,,Әпке!
Dialogue: 0,0:10:34.21,0:10:35.76,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:10:42.39,0:10:45.10,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:10:46.64,0:10:47.77,Default,,0,0,0,,Бір!
Dialogue: 0,0:10:48.52,0:10:49.52,Default,,0,0,0,,Уфф!
Dialogue: 0,0:10:50.27,0:10:51.23,Default,,0,0,0,,Уфф!
Dialogue: 0,0:10:51.65,0:10:52.73,Default,,0,0,0,,Қалай?
Dialogue: 0,0:10:52.86,0:10:55.61,Default,,0,0,0,,Менің ерекше жерім ұнай ма?
Dialogue: 0,0:10:55.73,0:10:57.07,Default,,0,0,0,,Уфф!
Dialogue: 0,0:10:57.82,0:11:00.74,Default,,0,0,0,,Жақсы... жоқ...
Dialogue: 0,0:11:01.82,0:11:03.20,Default,,0,0,0,,Жаман болды.
Dialogue: 0,0:11:03.37,0:11:06.37,Default,,0,0,0,,Леополдин апаның өтінішінен бас тарта алмаймын.
Dialogue: 0,0:11:06.50,0:11:10.33,Default,,0,0,0,,Бірақ Лұқман Байқаридың күйеу баласы.
Dialogue: 0,0:11:10.71,0:11:11.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:11.79,0:11:12.75,Default,,0,0,0,,Бір!
Dialogue: 0,0:11:14.21,0:11:16.88,Default,,0,0,0,,Ал, дәл солай болады.
Dialogue: 0,0:11:17.01,0:11:20.68,Default,,0,0,0,,Бүгін алдау мен алдаудың жақсы жолын ойлап көрейік.
Dialogue: 0,0:11:22.01,0:11:23.26,Default,,0,0,0,,Лұқман!
Dialogue: 0,0:11:24.22,0:11:26.35,Default,,0,0,0,,Түскі ас ішейік!
Dialogue: 0,0:11:27.22,0:11:28.73,Default,,0,0,0,,Лұқман?
Dialogue: 0,0:11:30.89,0:11:32.56,Default,,0,0,0,,Қызық, қайда бардың...
Dialogue: 0,0:11:32.69,0:11:35.57,Default,,0,0,0,,Уф уф! (Сара) Не!? Лұқман!?
Dialogue: 0,0:11:36.86,0:11:40.86,Default,,0,0,0,,(Лұқманның үруі жалғасуда)
Dialogue: 0,0:11:41.99,0:11:42.70,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:44.03,0:11:46.83,Default,,0,0,0,,Жоқ, шекараның арғы жағына?
Dialogue: 0,0:11:47.87,0:11:51.21,Default,,0,0,0,,Байқары қорқынышты жер деп естідім...
Dialogue: 0,0:11:58.00,0:12:00.13,Default,,0,0,0,,О, мен сені мазалап жүрмін!!
Dialogue: 0,0:12:06.93,0:12:09.60,Default,,0,0,0,,Уау... әдемі
Dialogue: 0,0:12:11.31,0:12:15.48,Default,,0,0,0,,Лағыл құс Сапфир көбелек
Dialogue: 0,0:12:16.48,0:12:20.19,Default,,0,0,0,,Көбінесе құм мен тасты құрайтын Әлхамиттен мүлде бөлек.
Dialogue: 0,0:12:21.07,0:12:22.99,Default,,0,0,0,,Лұқман!
Dialogue: 0,0:12:23.78,0:12:27.74,Default,,0,0,0,,Қайда! Лұқман!
Dialogue: 0,0:12:29.12,0:12:30.83,Default,,0,0,0,,Болады! Болады! (Сара) А!?
Dialogue: 0,0:12:32.21,0:12:34.08,Default,,0,0,0,,Болады! (Сара) Лұқман!
Dialogue: 0,0:12:34.21,0:12:35.71,Default,,0,0,0,,Болады!
Dialogue: 0,0:12:35.83,0:12:37.59,Default,,0,0,0,,Лұқман! Болады!
Dialogue: 0,0:12:38.13,0:12:42.05,Default,,0,0,0,,Ах... Уф!
Dialogue: 0,0:12:42.17,0:12:44.43,Default,,0,0,0,,Хмм!
Dialogue: 0,0:12:44.55,0:12:47.05,Default,,0,0,0,,Мм! Кун
Dialogue: 0,0:12:47.22,0:12:51.52,Default,,0,0,0,,Хаа... Хаа... Не істеуім керек...
Dialogue: 0,0:12:52.23,0:12:55.31,Default,,0,0,0,,Сен мені қатты ұнатасың, солай ма?
Dialogue: 0,0:12:55.48,0:12:57.02,Default,,0,0,0,,Мияу
Dialogue: 0,0:12:58.82,0:13:00.03,Default,,0,0,0,,Ня! О?
Dialogue: 0,0:13:00.15,0:13:04.03,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:07.62,0:13:08.33,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:08.45,0:13:10.29,Default,,0,0,0,,Бұл Архамиттің қызы.
Dialogue: 0,0:13:10.41,0:13:11.54,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:11.75,0:13:13.96,Default,,0,0,0,,Сен мұндай жерде не істедің?
Dialogue: 0,0:13:14.08,0:13:16.29,Default,,0,0,0,,Ха! Байкаридікі?
Dialogue: 0,0:13:16.54,0:13:18.38,Default,,0,0,0,,Уау! Бізбен бірге қалыңыз!
Dialogue: 0,0:13:18.50,0:13:20.80,Default,,0,0,0,,Бұл қазірдің өзінде қатты ауырады.
Dialogue: 0,0:13:24.88,0:13:26.05,Default,,0,0,0,,Қайсысы...
Dialogue: 0,0:13:26.38,0:13:31.06,Default,,0,0,0,,Хаха~ Ит тау картопы қазған шұңқырға құлап кетті.
Dialogue: 0,0:13:31.52,0:13:33.85,Default,,0,0,0,,Мен сол себетті бір сәтке қарызға аламын.
Dialogue: 0,0:13:33.98,0:13:35.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:37.15,0:13:38.48,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:38.77,0:13:41.36,Default,,0,0,0,,Итті тамақтандыратын нәрсе бар ма?
Dialogue: 0,0:13:41.48,0:13:42.57,Default,,0,0,0,,Иә
Dialogue: 0,0:13:43.19,0:13:44.74,Default,,0,0,0,,Ня! Ой
Dialogue: 0,0:13:45.57,0:13:49.07,Default,,0,0,0,,Лұқманның түскі асқа арнайы сүйекті қысқа қабырғалары осында.
Dialogue: 0,0:13:49.24,0:13:53.33,Default,,0,0,0,,Боу! иә? Ит тамағы? Қалби!?
Dialogue: 0,0:13:53.45,0:13:55.62,Default,,0,0,0,,Архамиттің жас ханымы күткендей
Dialogue: 0,0:13:55.75,0:13:58.96,Default,,0,0,0,,Иттің асы да берекелі.
Dialogue: 0,0:13:59.08,0:14:00.67,Default,,0,0,0,,Лұқман!
Dialogue: 0,0:14:00.96,0:14:04.84,Default,,0,0,0,,Лұқман тағамы!
Dialogue: 0,0:14:10.18,0:14:12.22,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:14:12.35,0:14:14.85,Default,,0,0,0,,Хехехе, жақсы.
Dialogue: 0,0:14:16.23,0:14:19.52,Default,,0,0,0,,Сонда да итке сондай жақсы ет...
Dialogue: 0,0:14:20.36,0:14:24.28,Default,,0,0,0,,Ах! Абайлаңыз, Одончимегу! Ертеңнен бастап қиын болады!
Dialogue: 0,0:14:24.78,0:14:30.20,Default,,0,0,0,,Еш ойланбаңыз! Су құнды, сондықтан шарап - жалғыз нұсқа.
Dialogue: 0,0:14:30.32,0:14:31.74,Default,,0,0,0,,Жас келіншек (Сара) А?
Dialogue: 0,0:14:32.45,0:14:36.00,Default,,0,0,0,,Егер мен жаман адам болсам ше?
Dialogue: 0,0:14:37.58,0:14:42.21,Default,,0,0,0,,Әй, жаман адамдар мұндай сөздерді айтудан бас тартпайды.
Dialogue: 0,0:14:42.34,0:14:43.63,Default,,0,0,0,,Ой, кешір.
Dialogue: 0,0:14:43.75,0:14:47.22,Default,,0,0,0,,Ал «Одончимег» отбасына…
Dialogue: 0,0:14:47.63,0:14:53.39,Default,,0,0,0,,«Жұлдыз жарығы» деп атайтын жаман адам жоқ.
Dialogue: 0,0:14:57.77,0:14:59.35,Default,,0,0,0,,«Отбасы»?
Dialogue: 0,0:14:59.48,0:15:02.73,Default,,0,0,0,,Иә Лұқман да отбасы.
Dialogue: 0,0:15:03.77,0:15:06.48,Default,,0,0,0,,Егер солай болса.
Dialogue: 0,0:15:06.61,0:15:10.16,Default,,0,0,0,,Егер тағы бір қиналсаңыз, жас ханым, маған хабарлаңыз.
Dialogue: 0,0:15:11.16,0:15:13.03,Default,,0,0,0,,Ақаулық...
Dialogue: 0,0:15:13.95,0:15:14.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:17.04,0:15:20.58,Default,,0,0,0,,Леополдин Бұл сағат?
Dialogue: 0,0:15:20.71,0:15:24.79,Default,,0,0,0,,Байқаридың күйеу баласы ақылды болса, түзейді, солай ма?
Dialogue: 0,0:15:25.88,0:15:27.80,Default,,0,0,0,,Бұл тітіркендіргіш.
Dialogue: 0,0:15:29.42,0:15:32.26,Default,,0,0,0,,Мен ертеңгі түскі асты асыға күтемін.
Dialogue: 0,0:15:33.89,0:15:37.43,Default,,0,0,0,,
Dialogue: 0,0:15:39.39,0:15:41.10,Default,,0,0,0,,Қайтадан қош келдіңіз...
Dialogue: 0,0:15:41.56,0:15:45.07,Default,,0,0,0,,Баая, бұл Наланбаял.
Dialogue: 0,0:15:45.19,0:15:47.65,Default,,0,0,0,,Танысқаныма қуаныштымын, Наланбай...
Dialogue: 0,0:15:48.03,0:15:49.15,Default,,0,0,0,,Ханшайым!
Dialogue: 0,0:15:50.15,0:15:53.32,Default,,0,0,0,,Ха, ха, Байқаридан біреуді әкелдің!
Dialogue: 0,0:15:53.45,0:15:54.32,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:15:55.12,0:15:57.33,Default,,0,0,0,,Мен бүгін Леополдин апамен таныстым.
Dialogue: 0,0:15:58.62,0:16:00.25,Default,,0,0,0,,Леополдин ханымға!?
Dialogue: 0,0:16:01.29,0:16:03.38,Default,,0,0,0,,«Байқаричи, сен ақылды күйеу болсаң»
Dialogue: 0,0:16:03.50,0:16:05.67,Default,,0,0,0,,«Сағатымды жөндеңіз», - деді ол.
Dialogue: 0,0:16:05.84,0:16:06.84,Default,,0,0,0,,Е...
Dialogue: 0,0:16:06.96,0:16:10.51,Default,,0,0,0,,Лұқманға бұл мүмкін емес, солай ма? Сол үшін сұрадым
Dialogue: 0,0:16:10.63,0:16:11.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:12.01,0:16:14.64,Default,,0,0,0,,Менімен біраз сөйлесіп, оны маған беріңіз.
Dialogue: 0,0:16:14.76,0:16:17.51,Default,,0,0,0,,Апаларыңыздың көңілінен шығатынына сенімдімін.
Dialogue: 0,0:16:18.14,0:16:21.02,Default,,0,0,0,,Осы жерде сіздің көмегіңізді алайық.
Dialogue: 0,0:16:23.06,0:16:26.69,Default,,0,0,0,,Жаңа ғана ханшайым дедіңіз бе?
Dialogue: 0,0:16:26.98,0:16:30.03,Default,,0,0,0,,Бұрын жас ханым сізден сұраған алмастырғыш не болды?
Dialogue: 0,0:16:30.36,0:16:31.44,Default,,0,0,0,,
Dialogue: 0,0:16:32.20,0:16:33.70,Default,,0,0,0,,Мына жігіт...?
Dialogue: 0,0:16:34.49,0:16:35.95,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:16:36.45,0:16:38.41,Default,,0,0,0,,Менің елімнің құдзу басшысы да
Dialogue: 0,0:16:38.54,0:16:42.21,Default,,0,0,0,,Кішкентай итті күйеу бала етіп жібердің бе?
Dialogue: 0,0:16:42.83,0:16:47.54,Default,,0,0,0,,Егер бұл көпшілікке мәлім болса, онда міндетті түрде соғыс болады...
Dialogue: 0,0:16:50.34,0:16:52.55,Default,,0,0,0,,Егер бұл орын алса, бұл менің шығыным.
Dialogue: 0,0:16:52.67,0:16:55.97,Default,,0,0,0,,Көп уақыт сауда жолын Әлхамит жауып тастады.
Dialogue: 0,0:16:56.09,0:17:00.72,Default,,0,0,0,,Бізде қор жоқ, 50 жыл бұрынғы шайқастың жарасы жазылмаған...
Dialogue: 0,0:17:02.39,0:17:04.35,Default,,0,0,0,,Әлхамит ше...
Dialogue: 0,0:17:04.52,0:17:08.19,Default,,0,0,0,,Қазір сауданың дамуына байланысты халықтың шамадан тыс көбеюі
Dialogue: 0,0:17:08.52,0:17:12.82,Default,,0,0,0,,Соның салдарынан шөлді аймақ Альхамит су тапшылығына ұшырады.
Dialogue: 0,0:17:12.99,0:17:16.36,Default,,0,0,0,,Осылай жалғаса берсе, қирандылар 50 жылдан кейін жойылады деп естідім.
Dialogue: 0,0:17:18.37,0:17:21.75,Default,,0,0,0,,Әлхамит Байқаридың су ресурстарын нысанаға алады.
Dialogue: 0,0:17:21.87,0:17:26.96,Default,,0,0,0,,Байқари Әлхамиттің байлығын қатты қалағаны сонша, оның қолы тамағынан шығып кетеді.
Dialogue: 0,0:17:27.08,0:17:28.25,Default,,0,0,0,,Сол екеу ме?
Dialogue: 0,0:17:28.38,0:17:32.51,Default,,0,0,0,,Мен оқиғаны түсіндім! иә? иә?
Dialogue: 0,0:17:32.80,0:17:34.05,Default,,0,0,0,,О, бұл…
Dialogue: 0,0:17:34.63,0:17:40.05,Default,,0,0,0,,Дегенмен, сізден әл-Хамит стилінде ұқыпты киіну талап етіледі.
Dialogue: 0,0:17:40.18,0:17:41.35,Default,,0,0,0,,Эээх…
Dialogue: 0,0:17:42.18,0:17:46.44,Default,,0,0,0,,Баа-баая-сама, тоқтаңызшы...
Dialogue: 0,0:17:46.60,0:17:50.27,Default,,0,0,0,,Үндемесең, біртүрлі боласың.
Dialogue: 0,0:17:50.57,0:17:52.03,Default,,0,0,0,,Иә, иә!!
Dialogue: 0,0:17:55.53,0:17:57.78,Default,,0,0,0,,Бәрі жақсы болады деп үміттенемін...
Dialogue: 0,0:18:03.62,0:18:06.04,Default,,0,0,0,,(Әпкелер ойнайды)
Dialogue: 0,0:18:06.96,0:18:08.04,Default,,0,0,0,,Не болса да, енді ешкімді ешқашан тастап кетпеймін.
Dialogue: 0,0:18:08.33,0:18:09.75,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:18:11.63,0:18:12.80,Default,,0,0,0,,ұсталды
Dialogue: 0,0:18:27.64,0:18:28.69,Default,,0,0,0,,Бір!!
Dialogue: 0,0:18:28.81,0:18:29.90,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:30.36,0:18:32.52,Default,,0,0,0,,Эмма!
Dialogue: 0,0:18:32.94,0:18:34.73,Default,,0,0,0,,Қайырлы таң Лұқман
Dialogue: 0,0:18:38.95,0:18:43.62,Default,,0,0,0,,Әже, бұрынғы патшаның шаштаразынан күткендей.
Dialogue: 0,0:18:43.74,0:18:46.66,Default,,0,0,0,,Бұл менің жас кезім еді.
Dialogue: 0,0:18:46.79,0:18:49.62,Default,,0,0,0,,Жоқ, бұл өте керемет...
Dialogue: 0,0:18:49.75,0:18:51.42,Default,,0,0,0,,Әй, жас ханым.
Dialogue: 0,0:18:52.46,0:18:53.38,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:18:53.50,0:18:55.92,Default,,0,0,0,,Наланбаял мырза!? Ол басқа адам!
Dialogue: 0,0:18:57.80,0:19:00.68,Default,,0,0,0,,Мына жалған сақал сізді басқа адамдай сезінеді!
Dialogue: 0,0:19:01.30,0:19:03.51,Default,,0,0,0,,Тіпті ханшайымдармен бүгінгі шай дастарханында.
Dialogue: 0,0:19:03.64,0:19:07.43,Default,,0,0,0,,Не бар, не жоқ, ойдағыдай болып жатқан сияқты.
Dialogue: 0,0:19:08.02,0:19:09.19,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:19:09.35,0:19:13.19,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен еркектерді түсінбеймін...
Dialogue: 0,0:19:14.44,0:19:16.19,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:19:17.03,0:19:19.32,Default,,0,0,0,,Жарайды, Байқари - бұл мереке!!
Dialogue: 0,0:19:25.33,0:19:28.37,Default,,0,0,0,,Наланбаял мырза, өзіңізді қатты итермеңіз.
Dialogue: 0,0:19:28.50,0:19:29.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:29.66,0:19:34.50,Default,,0,0,0,,Әлхамит пен Байқари ежелден қарым-қатынасы нашар елдер.
Dialogue: 0,0:19:34.79,0:19:37.84,Default,,0,0,0,,Сізге жағымсыз нәрсе айтуы мүмкін.
Dialogue: 0,0:19:38.76,0:19:40.84,Default,,0,0,0,,Жарайды. (Сара) Е...
Dialogue: 0,0:19:41.26,0:19:45.18,Default,,0,0,0,,Қандай жағдай болмасын, тек әженің тағамының дәмін есте сақтаңыз.
Dialogue: 0,0:19:45.31,0:19:47.97,Default,,0,0,0,,Көбінесе маған бәрібір.
Dialogue: 0,0:19:49.14,0:19:52.15,Default,,0,0,0,,Одончимегу! Әженің дайындағаны дәмді.
Dialogue: 0,0:19:52.27,0:19:52.98,Default,,0,0,0,,Ня~
Dialogue: 0,0:19:55.69,0:19:57.23,Default,,0,0,0,,Д-Дұрыс, сен дұрыс айтасың.
Dialogue: 0,0:19:57.53,0:20:00.90,Default,,0,0,0,,Сонда мен де абдырап қалғанда,
Dialogue: 0,0:20:01.03,0:20:04.37,Default,,0,0,0,,Бұл әжейдің ерекше 16 түрлі шөп салмасы маған күркетауықты еске түсіреді...
Dialogue: 0,0:20:04.49,0:20:06.33,Default,,0,0,0,,Ханшайым! (Сара) А?
Dialogue: 0,0:20:06.45,0:20:09.41,Default,,0,0,0,,Қызықсыз сөйлеме!
Dialogue: 0,0:20:09.54,0:20:10.96,Default,,0,0,0,,Лукман кя?
Dialogue: 0,0:20:11.08,0:20:14.71,Default,,0,0,0,,Серуендеуге барайық! Уф уф!
Dialogue: 0,0:20:15.29,0:20:17.42,Default,,0,0,0,,Сіз ұялшақсыз ба?
Dialogue: 0,0:20:17.55,0:20:18.84,Default,,0,0,0,,Солай сияқты.
Dialogue: 0,0:20:18.96,0:20:20.67,Default,,0,0,0,,Хэхе (Сара) Хэхе...
Dialogue: 0,0:20:23.93,0:20:25.43,Default,,0,0,0,,Ня~
Dialogue: 0,0:20:25.55,0:20:26.72,Default,,0,0,0,,Бұл тек болжам ғана, айтпақшы.
Dialogue: 0,0:20:27.56,0:20:29.02,Default,,0,0,0,,Бұл қандай сорпа?
Dialogue: 0,0:20:29.14,0:20:33.10,Default,,0,0,0,,А, бұл жүгері мен тауық сорпасы.
Dialogue: 0,0:20:33.90,0:20:35.61,Default,,0,0,0,,Асқазанға оңай
Dialogue: 0,0:20:41.99,0:20:44.07,Default,,0,0,0,,Наланбаяр мырза...
Dialogue: 0,0:20:44.49,0:20:46.37,Default,,0,0,0,,Ол біртүрлі адам.
Dialogue: 0,0:20:59.46,0:21:03.38,Default,,0,0,0,,(Нарық қарбалас)
Dialogue: 0,0:21:08.60,0:21:11.39,Default,,0,0,0,,Менің патша астанасына келгеніме көп уақыт болды.
Dialogue: 0,0:21:12.73,0:21:15.85,Default,,0,0,0,,«Жылжымалы жол» және «ескеусіз көтерілуге болатын өзен»
Dialogue: 0,0:21:15.98,0:21:18.44,Default,,0,0,0,,Патша сарайына қай жолмен барасыз?
Dialogue: 0,0:21:18.90,0:21:21.11,Default,,0,0,0,,Не!? «Жылжымалы жол»?
Dialogue: 0,0:21:21.40,0:21:23.65,Default,,0,0,0,,Жол өздігінен алға жылжиды.
Dialogue: 0,0:21:24.03,0:21:26.53,Default,,0,0,0,,H-бұл қалай жұмыс істейді!?
Dialogue: 0,0:21:26.66,0:21:28.12,Default,,0,0,0,,Ал өзен!?
Dialogue: 0,0:21:28.24,0:21:29.91,Default,,0,0,0,,Қайық өзенмен көтеріліп барады.
Dialogue: 0,0:21:30.70,0:21:32.95,Default,,0,0,0,,Біздің бастығымыз ақымақ!
Dialogue: 0,0:21:33.08,0:21:35.67,Default,,0,0,0,,Неліктен осындай таңғажайып елмен төбелесуге тырысасыз!?
Dialogue: 0,0:21:35.79,0:21:38.67,Default,,0,0,0,,Әй, өткен айдан бері «Жол қозғалысы» бұзылды.
Dialogue: 0,0:21:39.04,0:21:41.42,Default,,0,0,0,,Не? Солай ма?
Dialogue: 0,0:21:41.96,0:21:44.55,Default,,0,0,0,,«Өзен» де қазір өзін жақсы сезінбейді.
Dialogue: 0,0:21:45.22,0:21:46.68,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:21:47.76,0:21:50.56,Default,,0,0,0,,Мынау не бала?! Тағы айт!
Dialogue: 0,0:21:51.14,0:21:54.85,Default,,0,0,0,,Қайта-қайта айтамын! Сіз өтірік ақымақ!!
Dialogue: 0,0:21:54.98,0:21:58.69,Default,,0,0,0,,Әй, Пилипаппа-сама - алаяқ!
Dialogue: 0,0:22:00.11,0:22:02.69,Default,,0,0,0,,Не? Ал сол ұлы адамдар ше?
Dialogue: 0,0:22:02.82,0:22:03.86,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:22:03.99,0:22:05.70,Default,,0,0,0,,Ол біртүрлі адам...
Dialogue: 0,0:22:05.82,0:22:07.32,Default,,0,0,0,,Не? Сіз білмейсіз бе?
Dialogue: 0,0:22:09.16,0:22:13.12,Default,,0,0,0,,Корольдің бақсысы Китуши - оңшыл министр Пилипаппа.
Dialogue: 0,0:22:13.24,0:22:17.71,Default,,0,0,0,,Патша әлгі жігітке соқыр сенетін сияқты...
Dialogue: 0,0:22:17.87,0:22:21.59,Default,,0,0,0,,Мен ханшайымдар ондай емес деп естідім?
Dialogue: 0,0:22:22.00,0:22:25.76,Default,,0,0,0,,Бүгін де Пирипаппа өте қызықты түрде жаңбыр сұрап дұға етеді.
Dialogue: 0,0:22:25.88,0:22:26.88,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:22:27.01,0:22:28.01,Default,,0,0,0,,Намаз т.б.
Dialogue: 0,0:22:28.13,0:22:31.05,Default,,0,0,0,,Дәл сол әлгі жалқау министр сияқты, оның да пайдасы жоқ!
Dialogue: 0,0:22:31.18,0:22:33.85,Default,,0,0,0,,Тіпті патша Пилипаппаны таниды.
Dialogue: 0,0:22:33.97,0:22:35.60,Default,,0,0,0,,Оны сол әшекейлермен араластырмаңыз!
Dialogue: 0,0:22:35.98,0:22:38.48,Default,,0,0,0,,Намаз жаңбыр жаудырмайды!
Dialogue: 0,0:22:38.60,0:22:41.69,Default,,0,0,0,,Жаңбыр теңіз суының булануынан болады деп әкем айтты.
Dialogue: 0,0:22:41.81,0:22:44.86,Default,,0,0,0,,Көтерілген су буы бұлтқа айналады және құлайды!
Dialogue: 0,0:22:45.36,0:22:46.49,Default,,0,0,0,,Бала!!
Dialogue: 0,0:22:47.24,0:22:48.99,Default,,0,0,0,,Біз оны тоқтатуымыз керек! Ах!?
Dialogue: 0,0:22:50.07,0:22:52.99,Default,,0,0,0,,Ондай арамзамен айналыспау керек!
Dialogue: 0,0:22:54.37,0:22:59.00,Default,,0,0,0,,Әй, сол баланың әкесі түрмеде отырған жоқ па?
Dialogue: 0,0:22:59.37,0:23:01.17,Default,,0,0,0,,Менде біраз қиындық болды.
Dialogue: 0,0:23:01.29,0:23:06.51,Default,,0,0,0,,Иә, жаза ретінде паркеттер жасалғанын естідім.
Dialogue: 0,0:23:06.63,0:23:09.26,Default,,0,0,0,,А... Айтпақшы, солшыл министр ше?
Dialogue: 0,0:23:09.38,0:23:11.09,Default,,0,0,0,,Сіз не туралы айтып отырсыз!?
Dialogue: 0,0:23:11.26,0:23:13.51,Default,,0,0,0,,Әдемі актер Саладин Ай жарығы!!
Dialogue: 0,0:23:14.01,0:23:15.68,Default,,0,0,0,,Құрметті Леополдин, менің сүйіктім!
Dialogue: 0,0:23:15.81,0:23:17.14,Default,,0,0,0,,Үйге қайт, шарлатан!!
Dialogue: 0,0:23:17.27,0:23:19.14,Default,,0,0,0,,Не?!
Dialogue: 0,0:23:20.39,0:23:23.90,Default,,0,0,0,,Түсіндім, тоқтайық.
Dialogue: 0,0:23:24.02,0:23:24.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:25.57,0:23:27.19,Default,,0,0,0,,Бұл жай ғана болжам.
Dialogue: 0,0:23:27.78,0:23:31.11,Default,,0,0,0,,Жалған дәрігерді патша ұсынып, дұрыс министр.
Dialogue: 0,0:23:31.57,0:23:35.70,Default,,0,0,0,,Ал бақсыларға сенбейтін реалист ханымдар
Dialogue: 0,0:23:35.83,0:23:38.37,Default,,0,0,0,,Әдемі актердің сүйікті Сол жақ министрі
Dialogue: 0,0:23:38.58,0:23:44.17,Default,,0,0,0,,Басқаша айтқанда, патша мен сіздің әпкелеріңіз қайшы келеді.
Dialogue: 0,0:23:44.50,0:23:45.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:46.09,0:23:50.80,Default,,0,0,0,,Егер солай болса, онда баланың әкесін қосқанда бәрі жазаланады.
Dialogue: 0,0:23:56.43,0:23:57.93,Default,,0,0,0,,Оны тез бітірейік, иә?
Dialogue: 0,0:23:58.06,0:24:01.64,Default,,0,0,0,,Сізде Ұлы дұға шебері Пирипаппа бар ма?
Dialogue: 0,0:24:01.77,0:24:02.94,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:24:03.31,0:24:07.65,Default,,0,0,0,,Жоқ, жоқ, жоқ, біз бейбіт әлемге айналдық.
Dialogue: 0,0:24:07.78,0:24:09.65,Default,,0,0,0,,Сенің жүзіңді көретініме сене алар емеспін
Dialogue: 0,0:24:09.78,0:24:12.11,Default,,0,0,0,,Мына Байқарының аяғы!
Dialogue: 0,0:24:12.24,0:24:13.03,Default,,0,0,0,,Хмм!
Dialogue: 0,0:24:13.16,0:24:14.03,Default,,0,0,0,,Байкари?
Dialogue: 0,0:24:14.16,0:24:16.45,Default,,0,0,0,,Байкари!? (Ер В) Байқари!?
Dialogue: 0,0:24:20.04,0:24:23.92,Default,,0,0,0,,Сәлем! Архамитке Байқаридан біреу не үшін келді!?
Dialogue: 0,0:24:25.84,0:24:28.25,Default,,0,0,0,,Күзетшілерді шақырыңыз! Күзетшілерді шақырыңыз!!
Dialogue: 0,0:24:29.21,0:24:32.47,Default,,0,0,0,,Күте тұрыңыз! Бұл адам...
Dialogue: 0,0:24:32.97,0:24:35.64,Default,,0,0,0,,Ал, қайшылықты ма, жоқ па.
Dialogue: 0,0:24:35.76,0:24:39.06,Default,,0,0,0,,«Мені сарай ханшайымдары шақырды»?
Dialogue: 0,0:24:39.18,0:24:41.14,Default,,0,0,0,,Бұл ең күшті индульгенция.
Dialogue: 0,0:24:41.27,0:24:42.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:44.48,0:24:45.90,Default,,0,0,0,,Сол адам – бәрінен әлсіз
Dialogue: 0,0:24:46.94,0:24:51.03,Default,,0,0,0,,Алдыңғы ант бойынша ол Архамит еліне үйленді.
Dialogue: 0,0:24:51.15,0:24:55.53,Default,,0,0,0,,«Байқар еліндегі ең ақылды жас» Наланбаяр мырза!!
Dialogue: 0,0:24:55.99,0:24:59.45,Default,,0,0,0,,Және патша оны әйелі етіп тағайындады.
Dialogue: 0,0:24:59.62,0:25:04.37,Default,,0,0,0,,93-ші ханшайым, Сара ханшайым осында!
Dialogue: 0,0:25:06.08,0:25:08.00,Default,,0,0,0,,Сізбен алғаш рет кездескеніме қуаныштымын
Dialogue: 0,0:25:08.13,0:25:13.01,Default,,0,0,0,,Бүгін мен сіздің бірінші ханшайымыңыз Леополдин апа болуды мақтан тұтамын.
Dialogue: 0,0:25:13.13,0:25:17.05,Default,,0,0,0,,Күйеуім екеуміз шақыру алып, патша астанасына келдік.
Dialogue: 0,0:25:17.18,0:25:19.85,Default,,0,0,0,,Леополдин!?
Dialogue: 0,0:25:20.47,0:25:23.56,Default,,0,0,0,,Байқардан келген күйеу балам неге...
Dialogue: 0,0:25:24.31,0:25:26.23,Default,,0,0,0,,Хмм?
Dialogue: 0,0:25:27.86,0:25:31.57,Default,,0,0,0,,Бұл шекарадан келген ханшайым болды ма?
Dialogue: 0,0:25:32.03,0:25:34.57,Default,,0,0,0,,Менің серігім кешірім сұрады.
Dialogue: 0,0:25:35.03,0:25:39.99,Default,,0,0,0,,Сонымен, сенің ісің не, Леополдин?
Dialogue: 0,0:25:40.12,0:25:42.08,Default,,0,0,0,,«Себебі маңызды нәрсе бұзылды».
Dialogue: 0,0:25:42.58,0:25:45.75,Default,,0,0,0,,Маған «оны түзетуді» сұрады
Dialogue: 0,0:25:46.08,0:25:48.08,Default,,0,0,0,,Маңызды нәрсе бар ма?
Dialogue: 0,0:25:48.29,0:25:51.75,Default,,0,0,0,,Қазір бұзылған шығар.
Dialogue: 0,0:25:52.00,0:25:54.88,Default,,0,0,0,,Менің ойымша, бұл «жылжымалы жол» дегенді білдіреді.
Dialogue: 0,0:25:55.01,0:25:55.93,Default,,0,0,0,,Иә!?
Dialogue: 0,0:25:56.09,0:25:59.10,Default,,0,0,0,,(Пилипаппаның күлкісі)
Dialogue: 0,0:25:59.35,0:26:02.35,Default,,0,0,0,,Леополдин ханым да жаман адам!
Dialogue: 0,0:26:02.47,0:26:06.19,Default,,0,0,0,,Патша бұл туралы ойлайтыны сөзсіз.
Dialogue: 0,0:26:06.31,0:26:09.94,Default,,0,0,0,,Бір ай өтсе де жөнделмейтін нәрсе хахахаха...
Dialogue: 0,0:26:10.06,0:26:11.86,Default,,0,0,0,,Бірден қабылдасаңыз, бұл таңғы ас.
Dialogue: 0,0:26:11.98,0:26:12.69,Default,,0,0,0,,А...
Dialogue: 0,0:26:13.36,0:26:15.61,Default,,0,0,0,,Мүмкін пайдалану мерзімі өтіп кеткен шығар.
Dialogue: 0,0:26:15.74,0:26:19.12,Default,,0,0,0,,Ішіндегі бөлшектер тозған, сынған.
Dialogue: 0,0:26:19.24,0:26:22.33,Default,,0,0,0,,Бірақ... Мен ақылдымын.
Dialogue: 0,0:26:23.24,0:26:26.96,Default,,0,0,0,,Бөлшектерді бөлшектеп жасау - жалықтырып, көп уақытты қажет етеді.
Dialogue: 0,0:26:29.25,0:26:30.21,Default,,0,0,0,,Ол дерлік сатылып кеткен екен.
Dialogue: 0,0:26:31.92,0:26:35.97,Default,,0,0,0,,Тығыз балмен жоғары дәлдікпен жұмыс істейтіндерге арналған
Dialogue: 0,0:26:36.09,0:26:38.59,Default,,0,0,0,,Маған көмектесулеріңізді қалаймын.
Dialogue: 0,0:26:40.43,0:26:42.60,Default,,0,0,0,,Ммм...
Dialogue: 0,0:26:43.85,0:26:45.52,Default,,0,0,0,,Құрметті Сара
Dialogue: 0,0:26:46.39,0:26:47.85,Default,,0,0,0,,Күткеніңізге рахмет
Dialogue: 0,0:26:48.06,0:26:51.73,Default,,0,0,0,,«Жылжымалы қорап» енді тек роялтиге арналған
Dialogue: 0,0:26:51.86,0:26:52.61,Default,,0,0,0,,Ммм...
Dialogue: 0,0:26:52.73,0:26:54.48,Default,,0,0,0,,Леополдин ханым сізді күтуде.
Dialogue: 0,0:26:54.94,0:26:57.19,Default,,0,0,0,,Патшайым сарайына барыңыз.
Dialogue: 0,0:26:57.32,0:27:00.61,Default,,0,0,0,,Бізді де король патша сарайына шақырды!
Dialogue: 0,0:27:00.74,0:27:03.33,Default,,0,0,0,,Сәлем айт, Ләйлә!
Dialogue: 0,0:27:03.45,0:27:07.75,Default,,0,0,0,,Кешіріңіз, кешігіп қалдым. Менің атым Лайлара.
Dialogue: 0,0:27:17.84,0:27:18.30,Default,,0,0,0,,(Ағып жатқан судың дыбысы)
Dialogue: 0,0:27:18.30,0:27:20.34,Default,,0,0,0,,Не? а? о?
Dialogue: 0,0:27:20.47,0:27:24.01,Default,,0,0,0,,Өтінемін, қалқып тұрған сезімге батып кетпеңіз.
Dialogue: 0,0:27:24.47,0:27:25.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:26.18,0:27:28.85,Default,,0,0,0,,Уау! Ах... ой
Dialogue: 0,0:27:28.98,0:27:30.23,Default,,0,0,0,,Қарап көріңіз
Dialogue: 0,0:27:30.35,0:27:31.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:40.40,0:27:41.86,Default,,0,0,0,,О...
Dialogue: 0,0:27:43.99,0:27:48.12,Default,,0,0,0,,Мен Әлхамитті тек құм мен тасты ел деп ойладым, бірақ...
Dialogue: 0,0:27:48.58,0:27:52.12,Default,,0,0,0,,Бұл... алтын жер.
Dialogue: 0,0:27:53.38,0:27:54.50,Default,,0,0,0,,Өте әдемі...
Dialogue: 0,0:27:55.09,0:27:56.13,Default,,0,0,0,,Хехе
Dialogue: 0,0:27:58.84,0:28:00.88,Default,,0,0,0,,Өтінемін, бұл артқы бөлме.
Dialogue: 0,0:28:08.52,0:28:10.98,Default,,0,0,0,,Ханым, жақсысыз ба?
Dialogue: 0,0:28:12.65,0:28:17.65,Default,,0,0,0,,Егер сіз қатты уайымдасаңыз, мені ұстай аласыз.
Dialogue: 0,0:28:20.24,0:28:22.49,Default,,0,0,0,,Рахмет
Dialogue: 0,0:28:29.16,0:28:32.79,Default,,0,0,0,,(Саз орындауы)
Dialogue: 0,0:28:43.38,0:28:45.93,Default,,0,0,0,,Наланбаяр мырза, жұпқа ұқсайсыз ба?
Dialogue: 0,0:28:46.05,0:28:48.97,Default,,0,0,0,,Мен... Жақсы емес пе, жас ханым?
Dialogue: 0,0:28:49.89,0:28:53.48,Default,,0,0,0,,Қош келдің, Сара мен Байқаридың күйеу баласы.
Dialogue: 0,0:28:54.56,0:28:56.48,Default,,0,0,0,,Мен сені күттім.
Dialogue: 0,0:28:57.73,0:29:01.15,Default,,0,0,0,,Бүгін сізбен бірге болу үлкен мәртебе.
Dialogue: 0,0:29:01.57,0:29:02.99,Default,,0,0,0,,Біз таныстырғымыз келеді
Dialogue: 0,0:29:03.57,0:29:06.53,Default,,0,0,0,,Бұл «Байқаридағы ең ақылды жас»
Dialogue: 0,0:29:06.66,0:29:09.62,Default,,0,0,0,,Бұл Наланбаяр мырза, менің күйеу балам.
Dialogue: 0,0:29:09.74,0:29:11.00,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:29:11.91,0:29:14.12,Default,,0,0,0,,Мен, мен сияқты байқарлы,
Dialogue: 0,0:29:14.25,0:29:17.42,Default,,0,0,0,,Мен осындай игі шараға қатысқанымды мақтан тұтамын.
Dialogue: 0,0:29:17.54,0:29:19.38,Default,,0,0,0,,Қолайсыздықтар үшін шын жүректен кешірім сұраймыз.
Dialogue: 0,0:29:20.21,0:29:23.38,Default,,0,0,0,,Бүгін мен тек әйелімді ұятқа қалдырмағым келеді.
Dialogue: 0,0:29:23.59,0:29:27.97,Default,,0,0,0,,Мен сенің қасымда тыныш күтуіңді қалаймын.
Dialogue: 0,0:29:28.55,0:29:31.31,Default,,0,0,0,,Ресми сәлемдесу жойылды.
Dialogue: 0,0:29:31.43,0:29:33.73,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:29:37.61,0:29:41.44,Default,,0,0,0,,Күйеу балаң Әлхамитке үйреніп қалды ма?
Dialogue: 0,0:29:41.86,0:29:43.40,Default,,0,0,0,,Кеше ғана келді...
Dialogue: 0,0:29:43.53,0:29:45.53,Default,,0,0,0,,Иә, саған рахмет (Сара) Иә?
Dialogue: 0,0:29:45.65,0:29:51.49,Default,,0,0,0,,Тамағы дәмді, қала әдемі, бәрінен де сұлу ханымдар!
Dialogue: 0,0:29:51.62,0:29:53.83,Default,,0,0,0,,Әй, аузың жақсы екен.
Dialogue: 0,0:29:53.95,0:29:55.04,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:29:55.16,0:29:57.33,Default,,0,0,0,,Сен мені мақтауға мәжбүрлемесең де
Dialogue: 0,0:29:58.08,0:30:02.17,Default,,0,0,0,,Сараны қатты уайымдадық.
Dialogue: 0,0:30:02.30,0:30:06.22,Default,,0,0,0,,1000 жылдан астам уақыт бойы көптеген соғыстар жүргізген ел.
Dialogue: 0,0:30:06.93,0:30:11.18,Default,,0,0,0,,Тіпті күйеу балаң да Архамитке келгісі келмеді, солай ма?
Dialogue: 0,0:30:11.31,0:30:14.68,Default,,0,0,0,,Қарсылық болған жоқ десем, өтірік айтқан болар едім.
Dialogue: 0,0:30:14.81,0:30:17.73,Default,,0,0,0,,Өйткені Байқарда жұмыс жоқ.
Dialogue: 0,0:30:18.94,0:30:22.65,Default,,0,0,0,,Мен инженер-құрылыс инженерімін.
Dialogue: 0,0:30:22.78,0:30:24.74,Default,,0,0,0,,Маған геологияны зерттеу де ұнайды.
Dialogue: 0,0:30:24.86,0:30:28.16,Default,,0,0,0,,Әлхамитке де қызық болдым...
Dialogue: 0,0:30:28.66,0:30:33.37,Default,,0,0,0,,Мен бүгін өзімді жаман сезінемін деп күтуге болады, сондықтан мен онымен жақсымын.
Dialogue: 0,0:30:33.83,0:30:36.16,Default,,0,0,0,,Бірақ жас ханым ше?
Dialogue: 0,0:30:36.29,0:30:37.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:37.50,0:30:41.54,Default,,0,0,0,,Ол әл-Хамит ішінде байкари күйеуін алған жалғыз адам.
Dialogue: 0,0:30:41.67,0:30:45.21,Default,,0,0,0,,Расында жас келіншек не айтса да үрейленеді.
Dialogue: 0,0:30:45.34,0:30:48.18,Default,,0,0,0,,Ашуланбауға дайын болу керек.
Dialogue: 0,0:30:48.30,0:30:53.06,Default,,0,0,0,,Жарайды, мен әрқашан сенің жаныңда боламын.
Dialogue: 0,0:30:53.18,0:30:56.56,Default,,0,0,0,,Ойлап қарасам, ашуланып қалдым...
Dialogue: 0,0:30:56.68,0:30:59.85,Default,,0,0,0,,Лұқман, мен саған сыртқа зейін дедім...
Dialogue: 0,0:31:00.56,0:31:01.31,Default,,0,0,0,,Кун
Dialogue: 0,0:31:01.44,0:31:04.32,Default,,0,0,0,,Әй, бұлай күйзелме.
Dialogue: 0,0:31:05.61,0:31:07.24,Default,,0,0,0,,Сара ше? (Сара) Иә!?
Dialogue: 0,0:31:07.86,0:31:09.57,Default,,0,0,0,,Сізге ұнамады ма?
Dialogue: 0,0:31:09.70,0:31:16.08,Default,,0,0,0,,«Сол» әке маған Байқаридың күйеу баласымен үйленгені туралы айтқанда.
Dialogue: 0,0:31:17.66,0:31:19.62,Default,,0,0,0,,Бұл аздап қорқынышты болды...
Dialogue: 0,0:31:20.29,0:31:22.04,Default,,0,0,0,,Бұл елден кету
Dialogue: 0,0:31:22.17,0:31:25.34,Default,,0,0,0,,Шөлден тыс жерде күйеуге шыққаннан гөрі
Dialogue: 0,0:31:25.46,0:31:27.26,Default,,0,0,0,,Бұл өте жақсы болды.
Dialogue: 0,0:31:29.51,0:31:30.76,Default,,0,0,0,,Леополдин
Dialogue: 0,0:31:30.88,0:31:32.47,Default,,0,0,0,,(Саладин құлағына бірдеңені сыбырлайды)
Dialogue: 0,0:31:32.60,0:31:35.01,Default,,0,0,0,,Ия, тек сенің әпкең ғана қу екен.
Dialogue: 0,0:31:36.31,0:31:39.60,Default,,0,0,0,,Мына жақтағы әдемі жігіт сенің әпкеңнің күйеуі ме?
Dialogue: 0,0:31:39.73,0:31:42.77,Default,,0,0,0,,Не? Жоқ, бұл қожайын шығар.
Dialogue: 0,0:31:42.90,0:31:46.94,Default,,0,0,0,,Аа, Айджи... бұл тым абыройлы деп ойламайсың ба!?
Dialogue: 0,0:31:47.48,0:31:52.28,Default,,0,0,0,,Сәлем «Қара шөл түнді жарықтандыратын ай сәулесі»
Dialogue: 0,0:31:52.41,0:31:56.08,Default,,0,0,0,,Альхамитоның үздік актері Ай сәулесі = Саладин.
Dialogue: 0,0:31:56.20,0:31:57.91,Default,,0,0,0,,Альхамито Ичи нені білдіреді?
Dialogue: 0,0:31:58.04,0:32:01.33,Default,,0,0,0,,Бұл сіздің әлемдегі ең жақсы екеніңізді білдіреді, Саладин.
Dialogue: 0,0:32:01.50,0:32:05.38,Default,,0,0,0,,Мен әлемдегі ең ұлы ханым Леополдинге сенемін.
Dialogue: 0,0:32:05.50,0:32:06.38,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:32:06.50,0:32:08.13,Default,,0,0,0,,Маған да айт, Саладин!
Dialogue: 0,0:32:08.26,0:32:09.55,Default,,0,0,0,,Мен, мен, мен де!
Dialogue: 0,0:32:10.42,0:32:11.30,Default,,0,0,0,,Ал егер?
Dialogue: 0,0:32:11.43,0:32:14.68,Default,,0,0,0,,Ол үш ханшайымның ханымы болуы керек.
Dialogue: 0,0:32:15.60,0:32:17.81,Default,,0,0,0,,Бұл солшыл министр ме?
Dialogue: 0,0:32:17.97,0:32:19.68,Default,,0,0,0,,Сіз тым жас емессіз бе?
Dialogue: 0,0:32:20.60,0:32:21.89,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:32:22.27,0:32:27.19,Default,,0,0,0,,Наланбаяр мырзаның сағатқа қарайтын уақыты келді деп ойладым.
Dialogue: 0,0:32:28.36,0:32:29.44,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:32:31.28,0:32:33.20,Default,,0,0,0,,Қазір ол шашыраңқы
Dialogue: 0,0:32:34.41,0:32:35.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:32:36.45,0:32:37.45,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:32:37.58,0:32:41.58,Default,,0,0,0,,Сағаттардың жөндеуге болатын және жөндеуге болатын бөліктері болады.
Dialogue: 0,0:32:41.71,0:32:45.46,Default,,0,0,0,,Бөлшектерге ерекше зақым жоқ...
Dialogue: 0,0:32:45.96,0:32:49.38,Default,,0,0,0,,Күштің негізгі серіппеден берілістерге қалай берілетініне назар аударыңыз
Dialogue: 0,0:32:49.51,0:32:51.51,Default,,0,0,0,,Егер жиналған болса...
Dialogue: 0,0:32:52.09,0:32:55.09,Default,,0,0,0,,Осындай заттармен сіз оларды бөліп, ішін тазалайсыз.
Dialogue: 0,0:32:55.22,0:32:56.85,Default,,0,0,0,,Бұл қиын емес.
Dialogue: 0,0:33:02.31,0:33:03.31,Default,,0,0,0,,Бітті
Dialogue: 0,0:33:03.81,0:33:04.94,Default,,0,0,0,,Бекітілді ме?
Dialogue: 0,0:33:05.90,0:33:09.65,Default,,0,0,0,,Жоқ, екі кішкентай беріліс жоқ.
Dialogue: 0,0:33:09.78,0:33:10.86,Default,,0,0,0,,Жақсы
Dialogue: 0,0:33:11.15,0:33:14.20,Default,,0,0,0,,Ол бір жерде жоғалған болуы мүмкін.
Dialogue: 0,0:33:15.16,0:33:16.70,Default,,0,0,0,,Күйеу бала иә
Dialogue: 0,0:33:17.24,0:33:19.37,Default,,0,0,0,,Байқаридың ханымы жоқ.
Dialogue: 0,0:33:19.49,0:33:22.08,Default,,0,0,0,,Бұл моногамия деп естимін.
Dialogue: 0,0:33:22.33,0:33:26.33,Default,,0,0,0,,Егер Саладин осы үш ханшайымның бірі болса,
Dialogue: 0,0:33:26.46,0:33:28.84,Default,,0,0,0,,Егер сіз тек бір адамға үйленсеңіз
Dialogue: 0,0:33:29.17,0:33:32.97,Default,,0,0,0,,Қалай және кімді таңдауым керек?
Dialogue: 0,0:33:33.76,0:33:36.97,Default,,0,0,0,,Байқардағы ең дана адам болсаң
Dialogue: 0,0:33:37.43,0:33:40.51,Default,,0,0,0,,Мен сіздердің ойларыңызды білгім келеді.
Dialogue: 0,0:33:42.64,0:33:45.89,Default,,0,0,0,,Әкем осылай деді
Dialogue: 0,0:33:46.02,0:33:48.73,Default,,0,0,0,,Бұл менің сөздерім емес.
Dialogue: 0,0:33:50.02,0:33:53.44,Default,,0,0,0,,«Үйлену және басқа біреумен отбасы құру дегенді білдіреді»
Dialogue: 0,0:33:53.57,0:33:55.57,Default,,0,0,0,,«Бұл арман емес»
Dialogue: 0,0:33:56.53,0:34:00.95,Default,,0,0,0,,«Біз төзе алатын нәрселер мен қайғылы нәрселер бізді толқындар сияқты шайып жатыр».
Dialogue: 0,0:34:01.83,0:34:06.71,Default,,0,0,0,,«Бастапқыда сезінген махаббатым мен сүйіспеншілігім уақыт өте келе біртіндеп жойылды».
Dialogue: 0,0:34:06.87,0:34:09.13,Default,,0,0,0,,«Басқа нәрсеге ауысу»
Dialogue: 0,0:34:10.17,0:34:15.42,Default,,0,0,0,,«Демек, сіз осы сәттің сұлулығынан, қуанышынан гөрі маңыздырақсыз».
Dialogue: 0,0:34:15.55,0:34:18.68,Default,,0,0,0,,«Ата-анам мен бауырларымнан жақсы немесе жақсы»
Dialogue: 0,0:34:19.22,0:34:23.56,Default,,0,0,0,,«Сізді бағалайтын адамды іздеңіз».
Dialogue: 0,0:34:25.81,0:34:29.90,Default,,0,0,0,,Басқаша айтқанда, шай уақытында қалған соңғы печенье.
Dialogue: 0,0:34:30.02,0:34:35.11,Default,,0,0,0,,Бұл жалғыз және үнсіз тамақтанатын адамдарды таңдауға болмайды дегенді білдіре ме?
Dialogue: 0,0:34:37.45,0:34:39.82,Default,,0,0,0,,Өтінемін, жас ханым.
Dialogue: 0,0:34:43.99,0:34:47.58,Default,,0,0,0,,Олай болса өзіңізді еркін сезініңіз
Dialogue: 0,0:34:47.79,0:34:51.13,Default,,0,0,0,,Хмм... Бұл қызық жауап.
Dialogue: 0,0:34:51.25,0:34:54.30,Default,,0,0,0,,Әпке, жаман әзілдерді доғарыңыз.
Dialogue: 0,0:34:54.42,0:34:56.13,Default,,0,0,0,,Саладин барлығына тиесілі.
Dialogue: 0,0:34:56.26,0:34:58.47,Default,,0,0,0,,Бұл жай ғана заңмен шешілді.
Dialogue: 0,0:34:58.93,0:35:01.93,Default,,0,0,0,,Бұл керемет! Наланбаял мырза
Dialogue: 0,0:35:02.05,0:35:04.18,Default,,0,0,0,,Жоқ, онша емес.
Dialogue: 0,0:35:04.60,0:35:05.85,Default,,0,0,0,,Патшаға
Dialogue: 0,0:35:05.97,0:35:09.44,Default,,0,0,0,,Маған жақсы үйлену ұсынысы үшін рахмет айтыңыз.
Dialogue: 0,0:35:09.77,0:35:13.44,Default,,0,0,0,,Нағыз «Байқаридың күйеу баласы» бүгін келе жатқан жоқ па?
Dialogue: 0,0:35:13.57,0:35:15.28,Default,,0,0,0,,Аа!!
Dialogue: 0,0:35:15.73,0:35:18.15,Default,,0,0,0,,Ал, сен не айтып тұрсың хахаха...
Dialogue: 0,0:35:18.45,0:35:22.45,Default,,0,0,0,,Мына жігіт... байқады ма...
Dialogue: 0,0:35:22.78,0:35:27.12,Default,,0,0,0,,Сіз актерлік шеберсіз, солай ма? Біздің театр ұжымына қосылғыңыз келе ме?
Dialogue: 0,0:35:27.25,0:35:29.25,Default,,0,0,0,,Тура екі айдан кейін жаңа спектакль болады...
Dialogue: 0,0:35:29.37,0:35:34.34,Default,,0,0,0,,Одан да өткен күні бір қауесетті естідім.
Dialogue: 0,0:35:35.46,0:35:41.09,Default,,0,0,0,,Әке... патша Байқариға «сұлу қызы» емес...
Dialogue: 0,0:35:42.26,0:35:45.10,Default,,0,0,0,,Ол «бір құлағы бар мысықты» жіберді
Dialogue: 0,0:35:45.22,0:35:45.97,Default,,0,0,0,,Мияу?
Dialogue: 0,0:35:46.97,0:35:48.98,Default,,0,0,0,,«Байқаридың күйеу баласы».
Dialogue: 0,0:35:49.43,0:35:52.60,Default,,0,0,0,,Сіз бірдеңе естідіңіз бе?
Dialogue: 0,0:35:52.98,0:35:58.99,Default,,0,0,0,,Енді... астананың әңгімесі ауылға дейін бармайды.
Dialogue: 0,0:35:59.11,0:36:02.49,Default,,0,0,0,,Байкари тек адамдарға қызық па?
Dialogue: 0,0:36:03.12,0:36:08.12,Default,,0,0,0,,Әлде қандай да бір себептермен Байқариды басып алғың келе ме?
Dialogue: 0,0:36:08.29,0:36:11.50,Default,,0,0,0,,Мына ханшайым не іздеп жүр?
Dialogue: 0,0:36:13.33,0:36:15.34,Default,,0,0,0,,Егер неке келісімі Кохогоға қарсы болса...
Dialogue: 0,0:36:16.46,0:36:18.13,Default,,0,0,0,,Не болады...
Dialogue: 0,0:36:19.05,0:36:22.59,Default,,0,0,0,,А... анау апа...
Dialogue: 0,0:36:23.34,0:36:27.06,Default,,0,0,0,,Күйеуіңізге «Байқари күйеу бала» ретінде қараудың уақыты келді.
Dialogue: 0,0:36:27.22,0:36:29.89,Default,,0,0,0,,Сіз мені атыммен атай аласыз ба?
Dialogue: 0,0:36:30.77,0:36:32.23,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:36:32.64,0:36:33.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:33.85,0:36:34.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:39.03,0:36:43.11,Default,,0,0,0,,Мұндай өсек-аяңды екі елдің арасын нашарлатқысы келетін адамдар таратады.
Dialogue: 0,0:36:43.24,0:36:45.74,Default,,0,0,0,,Бұл жай ғана өтірік екені анық.
Dialogue: 0,0:36:45.87,0:36:48.54,Default,,0,0,0,,Оның үстіне әкең қанша болса да,
Dialogue: 0,0:36:48.66,0:36:52.00,Default,,0,0,0,,Мен саған ешқашан мысық жібермес едім.
Dialogue: 0,0:36:55.21,0:36:57.42,Default,,0,0,0,,Сенімді болыңыз.
Dialogue: 0,0:36:58.00,0:37:03.26,Default,,0,0,0,,Байқап отырғаныңыздай, Байқари Архамитке мейірімді.
Dialogue: 0,0:37:05.72,0:37:08.51,Default,,0,0,0,,Иә, кешіріңіз.
Dialogue: 0,0:37:09.35,0:37:14.02,Default,,0,0,0,,Сара Наланбаяр, бүгін танысқаныма қуаныштымын.
Dialogue: 0,0:37:14.39,0:37:16.77,Default,,0,0,0,,Кез келген уақытта қайта келіңіз.
Dialogue: 0,0:37:16.94,0:37:18.65,Default,,0,0,0,,Жарайсың, Саладин.
Dialogue: 0,0:37:19.40,0:37:20.82,Default,,0,0,0,,Наланбаял мырза!
Dialogue: 0,0:37:20.94,0:37:23.78,Default,,0,0,0,,Келесі жолы солтүстік елдің үш ұлы трагедиясын жасайық!
Dialogue: 0,0:37:24.07,0:37:26.95,Default,,0,0,0,,А, ой... Мен актерлік өнерге қызығамын...
Dialogue: 0,0:37:27.07,0:37:27.78,Default,,0,0,0,,Әй!
Dialogue: 0,0:37:28.83,0:37:32.58,Default,,0,0,0,,Сол жақтағы министрмен ішуге бола ма?
Dialogue: 0,0:37:32.75,0:37:33.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:37:34.21,0:37:38.09,Default,,0,0,0,,Мен сізден бір сәт «жұмыс» туралы сұрағым келеді.
Dialogue: 0,0:37:48.26,0:37:50.10,Default,,0,0,0,,Ләйләла ана-
Dialogue: 0,0:37:50.56,0:37:53.35,Default,,0,0,0,,Мен міне аламын! тез!
Dialogue: 0,0:37:53.77,0:37:56.14,Default,,0,0,0,,Ал егер Леополдин болса
Dialogue: 0,0:37:56.27,0:37:58.65,Default,,0,0,0,,Қақпаларды ашыңыз!
Dialogue: 0,0:38:07.24,0:38:09.24,Default,,0,0,0,,Су айдауды бастаңыз!
Dialogue: 0,0:38:13.91,0:38:15.50,Default,,0,0,0,,Қараңызшы, анашым!
Dialogue: 0,0:38:15.79,0:38:19.29,Default,,0,0,0,,Мен Леополдиннің көрінісін осы жерден бірінші рет көріп тұрмын.
Dialogue: 0,0:38:19.92,0:38:24.09,Default,,0,0,0,,Бірақ бұл жақтан шөлді және тасты аймақты көруге болады, солай ма?
Dialogue: 0,0:38:24.21,0:38:26.17,Default,,0,0,0,,Жоқ, ана.
Dialogue: 0,0:38:26.88,0:38:31.89,Default,,0,0,0,,Елім мәңгілік алтын елім.
Dialogue: 0,0:38:37.52,0:38:41.44,Default,,0,0,0,,(Сара және басқалар сөйлейді)
Dialogue: 0,0:38:42.90,0:38:46.24,Default,,0,0,0,,Мен қорғауым керек...
Dialogue: 0,0:38:47.03,0:38:48.70,Default,,0,0,0,,Мияу~
Dialogue: 0,0:38:49.32,0:38:51.37,Default,,0,0,0,,Жарайды, Одончимег.
Dialogue: 0,0:38:51.74,0:38:54.70,Default,,0,0,0,,Наланбаяр мырза міндетті түрде қайтады.
Dialogue: 0,0:38:54.83,0:38:55.95,Default,,0,0,0,,Не болды, мырза Мокки!
Dialogue: 0,0:38:56.16,0:39:00.67,Default,,0,0,0,,Әлхамитте ол кісінің қайтатын басқа жері жоқ...
Dialogue: 0,0:39:00.79,0:39:02.96,Default,,0,0,0,,Ханшайым солай- (Сара) А?
Dialogue: 0,0:39:03.42,0:39:05.92,Default,,0,0,0,,Күріштің бұл мөлшері... (Сара) А...
Dialogue: 0,0:39:06.76,0:39:08.68,Default,,0,0,0,,Сонымен, сіз тамақ ішуге келесіз...
Dialogue: 0,0:39:08.80,0:39:11.72,Default,,0,0,0,,Мен мұны тым көп жасадым.
Dialogue: 0,0:39:11.85,0:39:15.06,Default,,0,0,0,,Наланбаял мырза мен көп жеймін...
Dialogue: 0,0:39:16.10,0:39:20.27,Default,,0,0,0,,Жарайды, Наланбаяр мырза да мұнда мәңгі болмайды.
Dialogue: 0,0:39:20.40,0:39:21.40,Default,,0,0,0,,Эх!
Dialogue: 0,0:39:22.19,0:39:25.69,Default,,0,0,0,,Жүр, ханшайым, жеп алайық.
Dialogue: 0,0:39:32.62,0:39:34.24,Default,,0,0,0,,Кез келген нәрсені жеңіз
Dialogue: 0,0:39:34.37,0:39:36.83,Default,,0,0,0,,Мен ханшайымнан көп қалталы ақша аламын.
Dialogue: 0,0:39:37.04,0:39:40.46,Default,,0,0,0,,Қалта ақшасы!? Осыған жарайсың ба...
Dialogue: 0,0:39:40.87,0:39:42.08,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:39:45.00,0:39:47.13,Default,,0,0,0,,Наланбаял мырза! Мені баурап алғаныңыз дұрыс
Dialogue: 0,0:39:47.26,0:39:48.76,Default,,0,0,0,,Нана Бұл не?
Dialogue: 0,0:39:48.97,0:39:50.76,Default,,0,0,0,,Мен үшін алаңдама
Dialogue: 0,0:39:50.88,0:39:52.76,Default,,0,0,0,,Жоқ, солай... болды!
Dialogue: 0,0:39:53.05,0:39:55.56,Default,,0,0,0,,Бұл таңқаларлық қатты.
Dialogue: 0,0:39:55.89,0:39:57.52,Default,,0,0,0,,Өтінемін, мені мазақ етпеңіз.
Dialogue: 0,0:40:00.98,0:40:04.56,Default,,0,0,0,,Менің елімде ерлердің тыныш болғаны жақсы деп саналады.
Dialogue: 0,0:40:05.23,0:40:07.36,Default,,0,0,0,,Ақша таппағандар серіктес ретінде қарастырылмайды.
Dialogue: 0,0:40:07.90,0:40:12.36,Default,,0,0,0,,Сосын Байқариға барсам, аузымды жымып күлемін.
Dialogue: 0,0:40:15.41,0:40:19.58,Default,,0,0,0,,Ай сәулесі мырза, сіз солтүстіктен келдіңіз бе?
Dialogue: 0,0:40:19.70,0:40:23.21,Default,,0,0,0,,Жоқ, әу бастан менің атыммен атаған сен ғана.
Dialogue: 0,0:40:23.33,0:40:25.92,Default,,0,0,0,,Әлхамит пен Байқариға қатысы жоқ
Dialogue: 0,0:40:26.04,0:40:29.67,Default,,0,0,0,,Мен сізді солтүстіктен деп ойладым, өйткені сіз театрмен айналысасыз.
Dialogue: 0,0:40:30.09,0:40:34.30,Default,,0,0,0,,Өзіңіз айтқандай, мен солтүстіктегі көшпелі тайпаданмын.
Dialogue: 0,0:40:34.43,0:40:36.60,Default,,0,0,0,,Мен бұл елге бес жыл бұрын келдім...
Dialogue: 0,0:40:36.72,0:40:39.81,Default,,0,0,0,,Көшпелілер қой-ешкі қуып өмір сүреді, солай ма?
Dialogue: 0,0:40:40.27,0:40:44.81,Default,,0,0,0,,Иә, мен негізінен малыммен ішкі жаққа көшіп келдім.
Dialogue: 0,0:40:45.86,0:40:47.77,Default,,0,0,0,,Кейде 10 қоймен
Dialogue: 0,0:40:47.90,0:40:51.15,Default,,0,0,0,,Маған бір жұдырық тұз берді.
Dialogue: 0,0:40:51.28,0:40:53.74,Default,,0,0,0,,Сол түні ет хош иістендірілді...
Dialogue: 0,0:40:54.41,0:40:56.07,Default,,0,0,0,,Бұл мереке болды...
Dialogue: 0,0:40:58.24,0:41:00.20,Default,,0,0,0,,Бұл жерде де ұқсас.
Dialogue: 0,0:41:01.08,0:41:02.91,Default,,0,0,0,,Өйткені осы сағатта шегірткелер пайда болады.
Dialogue: 0,0:41:03.04,0:41:05.83,Default,,0,0,0,,Күн сайын қуырылған шегіртке мен көкөністерді жеу.
Dialogue: 0,0:41:05.96,0:41:09.05,Default,,0,0,0,,Тау көгершінін ұстасам да, оны жейтін жер болмады.
Dialogue: 0,0:41:09.80,0:41:13.51,Default,,0,0,0,,Әкемнің көзі тірісінде.
Dialogue: 0,0:41:13.63,0:41:17.55,Default,,0,0,0,,Маған ертеңгі тамақ туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:41:20.02,0:41:23.31,Default,,0,0,0,,Наланбаяр мырза, сіз «Жылжымалы жолды» көрдіңіз бе?
Dialogue: 0,0:41:23.44,0:41:25.19,Default,,0,0,0,,А, мен бір көз алдым!
Dialogue: 0,0:41:25.31,0:41:28.02,Default,,0,0,0,,Бұл шамалы болжам, бірақ ішінде тісті дөңгелектер бар.
Dialogue: 0,0:41:28.15,0:41:32.44,Default,,0,0,0,,Су дөңгелегі арқылы жұмыс істейді! Сіз осындай үлкен нәрселерді жиі жасайтынсыз.
Dialogue: 0,0:41:32.82,0:41:34.70,Default,,0,0,0,,Олар неге бірге...
Dialogue: 0,0:41:34.82,0:41:36.70,Default,,0,0,0,,Енді сөзге келейік.
Dialogue: 0,0:41:36.82,0:41:37.53,Default,,0,0,0,,Әй!
Dialogue: 0,0:41:38.16,0:41:41.79,Default,,0,0,0,,Архамитте қанша су қалдым деп ойлаймын.
Dialogue: 0,0:41:41.91,0:41:43.04,Default,,0,0,0,,Иә!?
Dialogue: 0,0:41:43.16,0:41:45.29,Default,,0,0,0,,Сіз енді «жолды» да, «өзенді» де жылжыта алмайсыз, солай ма?
Dialogue: 0,0:41:46.58,0:41:48.25,Default,,0,0,0,,Неліктен олай ойлайсың?
Dialogue: 0,0:41:48.67,0:41:50.25,Default,,0,0,0,,«Мысық қалыңдық»
Dialogue: 0,0:41:52.17,0:41:57.01,Default,,0,0,0,,Міне, мен біздің ақымақ бастықтың Архамитпен неге соғысқысы келетінін түсіндім.
Dialogue: 0,0:41:57.14,0:41:59.93,Default,,0,0,0,,Егер коммерциялық бағыт бұғатталған болса,
Dialogue: 0,0:42:00.06,0:42:02.64,Default,,0,0,0,,Байқары байғұс ақыры өледі.
Dialogue: 0,0:42:03.14,0:42:08.23,Default,,0,0,0,,Бірақ байлыққа толы әл-Хамит неге біздің елмен шайқасады?
Dialogue: 0,0:42:08.69,0:42:12.11,Default,,0,0,0,,Байкариде не бар, бірақ әл-Хамитте жоқ...
Dialogue: 0,0:42:13.65,0:42:16.86,Default,,0,0,0,,Наланбаял мырза ойлағаннан да қурап қалды.
Dialogue: 0,0:42:16.99,0:42:18.41,Default,,0,0,0,,О... Эй, Саншита.
Dialogue: 0,0:42:18.53,0:42:20.45,Default,,0,0,0,,Уау, Ләйлә!
Dialogue: 0,0:42:20.83,0:42:22.41,Default,,0,0,0,,Мына балалар не туралы айтып жатыр?
Dialogue: 0,0:42:22.70,0:42:24.41,Default,,0,0,0,,Бұл елдің шындығы.
Dialogue: 0,0:42:24.54,0:42:25.66,Default,,0,0,0,,А...
Dialogue: 0,0:42:26.96,0:42:30.29,Default,,0,0,0,,Әлхамит қазір сирек кездесетін коммерциялық ел.
Dialogue: 0,0:42:30.71,0:42:33.42,Default,,0,0,0,,Сұлулықты сіз оған ақша төлесеңіз ғана сақтауға болады.
Dialogue: 0,0:42:33.88,0:42:37.68,Default,,0,0,0,,Үш күн болса да бір күнде саяхаттауға мүмкіндік беретін технология бар.
Dialogue: 0,0:42:38.34,0:42:41.89,Default,,0,0,0,,Дүние жүзінен адамдар бірдеңе іздеп келеді.
Dialogue: 0,0:42:42.51,0:42:45.77,Default,,0,0,0,,Бірақ адам көбейген сайын судың мөлшері азаяды.
Dialogue: 0,0:42:46.64,0:42:49.27,Default,,0,0,0,,Дәл қазір бұл елде қол жеткізе алмайтын ештеңе жоқ.
Dialogue: 0,0:42:49.40,0:42:54.11,Default,,0,0,0,,Тек еліңнің суы мен бір сырлы махаббаты.
Dialogue: 0,0:42:54.23,0:42:56.15,Default,,0,0,0,,Сізде жоқ нәрсені алып кетейін дейсіз бе?
Dialogue: 0,0:42:57.74,0:43:02.62,Default,,0,0,0,,Корольдік оңшыл министр Пилипаппа солай ойлайтын шығар.
Dialogue: 0,0:43:02.87,0:43:06.12,Default,,0,0,0,,Мен ұстап алып, Байқарға көшуге тырысамын.
Dialogue: 0,0:43:06.29,0:43:07.41,Default,,0,0,0,,Ханшайым ше?
Dialogue: 0,0:43:07.58,0:43:13.04,Default,,0,0,0,,Мен жай ғана актермін. Мен ханшайымның жүрегіне үңіле алмаймын.
Dialogue: 0,0:43:13.75,0:43:17.30,Default,,0,0,0,,Наланбаяр мырза, менің ойым осы.
Dialogue: 0,0:43:17.42,0:43:21.93,Default,,0,0,0,,Өлгендер өледі, Елім сияқты.
Dialogue: 0,0:43:22.22,0:43:25.27,Default,,0,0,0,,Жарайды, мен мұны ақырын жасаймын.
Dialogue: 0,0:43:25.39,0:43:29.06,Default,,0,0,0,,Су кеуіп қалса, енді күресуге ерік-жігерің жетпейді.
Dialogue: 0,0:43:31.02,0:43:32.56,Default,,0,0,0,,Ақылсыз ештеңе айтпа
Dialogue: 0,0:43:33.06,0:43:36.44,Default,,0,0,0,,Егер сіз бірдеңені, махаббатты немесе суды қаласаңыз, неге оны бір нәрсеге айналдырмасқа?
Dialogue: 0,0:43:37.11,0:43:39.65,Default,,0,0,0,,Сіз ше, солшыл министрдің күшімен?
Dialogue: 0,0:43:39.82,0:43:42.41,Default,,0,0,0,,Байқаридан Архамитке дейін су жолын тартамыз ба?
Dialogue: 0,0:43:42.53,0:43:44.87,Default,,0,0,0,,А, мен...?
Dialogue: 0,0:43:45.29,0:43:49.21,Default,,0,0,0,,Жоқ, күте тұрыңыз! Мен жай ғана әшекеймін
Dialogue: 0,0:43:49.50,0:43:52.00,Default,,0,0,0,,Сіз жай ғана министр емессіз!
Dialogue: 0,0:43:52.42,0:43:55.09,Default,,0,0,0,,Ханшайым сізге сол елдің идеалды министрін берді.
Dialogue: 0,0:43:55.21,0:43:56.92,Default,,0,0,0,,Қойылымыңызды аяқтағанымды қаламайсыз ба?
Dialogue: 0,0:43:59.97,0:44:04.26,Default,,0,0,0,,Мен де, ханшайым да саған сенеміз.
Dialogue: 0,0:44:07.14,0:44:09.18,Default,,0,0,0,,Кез келген жағдайда... дәл қазір ол жігіт...
Dialogue: 0,0:44:09.31,0:44:13.27,Default,,0,0,0,,Әлхамитке Байкаримен дипломатиялық қарым-қатынасты ашуды айттыңыз ба?
Dialogue: 0,0:44:13.40,0:44:15.65,Default,,0,0,0,,Біреуге айтсаң, өлтіремін.
Dialogue: 0,0:44:15.77,0:44:16.98,Default,,0,0,0,,Ооо…!!
Dialogue: 0,0:44:18.32,0:44:23.24,Default,,0,0,0,,Мен суды да, махаббатты да алатыныма сене алар емеспін, бірақ...
Dialogue: 0,0:44:28.12,0:44:32.17,Default,,0,0,0,,Сенің байсалды екеніңді анық аңғардым.
Dialogue: 0,0:44:33.67,0:44:37.38,Default,,0,0,0,,Одончимегу Ұйықтайтын уақыт болды.
Dialogue: 0,0:44:38.96,0:44:39.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:50.68,0:44:52.89,Default,,0,0,0,,(жалғыз дыбыс)
Dialogue: 0,0:44:56.44,0:44:57.86,Default,,0,0,0,,Жүр сені алып кетейік.
Dialogue: 0,0:44:58.23,0:44:59.32,Default,,0,0,0,,Мияу
Dialogue: 0,0:45:00.44,0:45:02.61,Default,,0,0,0,,Ол жақта патша астанасы жарқынырақ.
Dialogue: 0,0:45:02.74,0:45:05.24,Default,,0,0,0,,Егер қайтып келе жатсаңыз, ол сол жерден.
Dialogue: 0,0:45:05.87,0:45:09.37,Default,,0,0,0,,Бала кезімде маған тапсырыс беруші келген күн
Dialogue: 0,0:45:09.49,0:45:11.79,Default,,0,0,0,,Мен күте алмадым, сондықтан мен әрқашан осында күттім.
Dialogue: 0,0:45:11.91,0:45:12.75,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:45:12.87,0:45:15.00,Default,,0,0,0,,Қараңдаршы! Егер сіз өсек таратсаңыз
Dialogue: 0,0:45:24.18,0:45:25.76,Default,,0,0,0,,Мияу
Dialogue: 0,0:45:27.26,0:45:28.93,Default,,0,0,0,,Наранбаярсан
Dialogue: 0,0:45:29.06,0:45:32.31,Default,,0,0,0,,Е, қыздар, не істеп жатырсыңдар!?
Dialogue: 0,0:45:32.73,0:45:37.02,Default,,0,0,0,,Мен сіздің қайтуыңызды күттім, Наланбаяр мырза.
Dialogue: 0,0:45:37.69,0:45:40.73,Default,,0,0,0,,Уау! Ахх...
Dialogue: 0,0:45:40.86,0:45:44.28,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:45:44.78,0:45:47.37,Default,,0,0,0,,Сіз тым көп жедіңіз бе...
Dialogue: 0,0:45:50.24,0:45:52.50,Default,,0,0,0,,Ей, ауырып тұр!
Dialogue: 0,0:45:53.29,0:45:55.92,Default,,0,0,0,,Сіз біраз уақыттан бері сөйлесіп жатырсыз.
Dialogue: 0,0:45:56.04,0:45:58.50,Default,,0,0,0,,Кешіріңіз, мен кешігіп қалдым.
Dialogue: 0,0:45:59.46,0:46:02.63,Default,,0,0,0,,Эй, эй, балалар, ұйықтайтын уақыт болды.
Dialogue: 0,0:46:03.30,0:46:05.97,Default,,0,0,0,,Жас ханымды ұятқа қалдырмаңыз~
Dialogue: 0,0:46:06.09,0:46:07.80,Default,,0,0,0,,Ах... ой...
Dialogue: 0,0:46:07.93,0:46:10.01,Default,,0,0,0,,Мм... Мистер (Сара) А?
Dialogue: 0,0:46:10.39,0:46:12.56,Default,,0,0,0,,Кешіріңіз, бірақ
Dialogue: 0,0:46:12.68,0:46:17.40,Default,,0,0,0,,Менің жұмысым көп болатын сияқты...
Dialogue: 0,0:46:17.77,0:46:20.15,Default,,0,0,0,,Саған тағы біраз қамқорлық жасасам, қарсы болмайсың ба?
Dialogue: 0,0:46:20.48,0:46:21.65,Default,,0,0,0,,Қуа келе жатқандар кетті.
Dialogue: 0,0:46:22.28,0:46:25.11,Default,,0,0,0,,Жоқ, менің Байқаридың күйеу баласы ретіндегі рөлім аяқталды.
Dialogue: 0,0:46:25.24,0:46:27.07,Default,,0,0,0,,Менің ойымша, сіз үйге бара аласыз.
Dialogue: 0,0:46:27.20,0:46:30.20,Default,,0,0,0,,Ақыр аяғында, еліме қайтсам да шаруам жоқ.
Dialogue: 0,0:46:32.04,0:46:33.20,Default,,0,0,0,,Наланбаял мырза
Dialogue: 0,0:46:34.20,0:46:38.71,Default,,0,0,0,,Сіз қалағаныңызша қала аласыз.
Dialogue: 0,0:46:40.63,0:46:43.76,Default,,0,0,0,,Бүгін көп нәрсе болды...
Dialogue: 0,0:46:45.34,0:46:50.26,Default,,0,0,0,,Мен кейде қобалжысам да, көп жылдар бойы үлкен әпкелеріммен қиналып келемін.
Dialogue: 0,0:46:50.51,0:46:53.35,Default,,0,0,0,,Мен аздап жақындасып қалғандай сезінемін...
Dialogue: 0,0:46:57.48,0:46:59.15,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:47:00.31,0:47:02.15,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:47:03.02,0:47:04.15,Default,,0,0,0,,Осындай күн
Dialogue: 0,0:47:05.57,0:47:07.99,Default,,0,0,0,,Мәңгілікке созылса екен...
Dialogue: 0,0:47:14.99,0:47:17.41,Default,,0,0,0,,Олай болса, маған одончимегу беріңізші.
Dialogue: 0,0:47:17.66,0:47:20.42,Default,,0,0,0,,Мияу Мияу
Dialogue: 0,0:47:20.83,0:47:23.67,Default,,0,0,0,,Жұмысым бос болса, екі-үш күн үйге бара алмай қалуым мүмкін.
Dialogue: 0,0:47:23.80,0:47:25.38,Default,,0,0,0,,Лұқманмен ойнау
Dialogue: 0,0:47:25.51,0:47:27.76,Default,,0,0,0,,Наланбаял мырза Иә.
Dialogue: 0,0:47:28.05,0:47:29.63,Default,,0,0,0,,Мұны түскі асқа алыңыз
Dialogue: 0,0:47:29.76,0:47:33.26,Default,,0,0,0,,Ай сәулесі сізге қамқорлық жасайтын болса, алаңдаудың қажеті жоқ.
Dialogue: 0,0:47:33.39,0:47:36.64,Default,,0,0,0,,Егер сізге бірдеңе керек болса, маған хабарлаңыз.
Dialogue: 0,0:47:37.43,0:47:39.39,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:47:43.02,0:47:45.57,Default,,0,0,0,,Менің көргенім...
Dialogue: 0,0:47:46.03,0:47:49.95,Default,,0,0,0,,Парламент мүшелерінің жартысы ханшайым сияқты соғысқа қарсы.
Dialogue: 0,0:47:50.49,0:47:54.99,Default,,0,0,0,,Өздеріңіз білетіндей, соғысты бастаған патша жағының басшысы...
Dialogue: 0,0:47:58.20,0:47:59.37,Default,,0,0,0,,Бұл Пилипаппа.
Dialogue: 0,0:47:59.66,0:48:04.25,Default,,0,0,0,,Әлгі жігіттер Нуанда қыдырып жүр.
Dialogue: 0,0:48:04.71,0:48:07.42,Default,,0,0,0,,Одончимегу күріш.
Dialogue: 0,0:48:09.05,0:48:09.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:11.80,0:48:13.93,Default,,0,0,0,,Мен осында бір сәт бұрын болдым...
Dialogue: 0,0:48:14.39,0:48:18.60,Default,,0,0,0,,Одончимегу! Бұл қайда?
Dialogue: 0,0:48:20.14,0:48:23.40,Default,,0,0,0,,Бір, бір, бір!
Dialogue: 0,0:48:26.40,0:48:30.07,Default,,0,0,0,,Не? Амал жоқ... сыртта ма?
Dialogue: 0,0:48:32.41,0:48:34.53,Default,,0,0,0,,Ха ха ха Лұқман күт!
Dialogue: 0,0:48:36.87,0:48:38.04,Default,,0,0,0,,Бұл...
Dialogue: 0,0:48:41.25,0:48:42.54,Default,,0,0,0,,Байқари...
Dialogue: 0,0:48:45.17,0:48:48.42,Default,,0,0,0,,Енді ойлап қарасам, Наланбайдан
Dialogue: 0,0:48:48.76,0:48:52.68,Default,,0,0,0,,Тойға сыйлық әкел деп айтқан сияқты.
Dialogue: 0,0:48:53.22,0:48:57.56,Default,,0,0,0,,Байкари көсемі ретінде Архамито ең әдемі әйел...
Dialogue: 0,0:48:59.27,0:49:02.35,Default,,0,0,0,,Құлшылыққа баратын кез келді деп ойлаймын.
Dialogue: 0,0:49:02.69,0:49:05.36,Default,,0,0,0,,(түрме торларының ашылған дыбысы)
Dialogue: 0,0:49:05.52,0:49:06.56,Default,,0,0,0,,Қазір шық!
Dialogue: 0,0:49:07.69,0:49:08.48,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:49:13.28,0:49:16.82,Default,,0,0,0,,Иә? Бұл бір нәрсе өтетін арена болды ма?
Dialogue: 0,0:49:16.95,0:49:18.49,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:49:18.62,0:49:23.25,Default,,0,0,0,,Бұл сіз «қозғалыс жолды» жөндеймін деген желеумен босатқан тұтқындар.
Dialogue: 0,0:49:23.41,0:49:26.21,Default,,0,0,0,,Мен қатыгез қылмыскерлерді босатқаным есімде жоқ.
Dialogue: 0,0:49:26.33,0:49:30.63,Default,,0,0,0,,Жек көремін, бұлар еліміздің зиялы тап ғұламалары.
Dialogue: 0,0:49:30.96,0:49:33.34,Default,,0,0,0,,Әй, Мун-сан.
Dialogue: 0,0:49:33.47,0:49:37.30,Default,,0,0,0,,Мен сені ханшайымның ханымы деп ойладым.
Dialogue: 0,0:49:37.43,0:49:39.89,Default,,0,0,0,,Байқаримен дос болған кезде не болды?
Dialogue: 0,0:49:40.01,0:49:44.27,Default,,0,0,0,,Мен солшыл министр туралы айтып отырмын. Мен байкари әйелдеріне де қызығамын.
Dialogue: 0,0:49:44.39,0:49:45.52,Default,,0,0,0,,(Барлық ғалымдар күледі)
Dialogue: 0,0:49:45.65,0:49:46.65,Default,,0,0,0,,Айырмашылығы жоқ.
Dialogue: 0,0:49:47.94,0:49:49.52,Default,,0,0,0,,Мен оны жоққа шығармаймын.
Dialogue: 0,0:49:50.27,0:49:54.65,Default,,0,0,0,,Әй, бəрі, солшыл министрмен бұлай əңгімелесу жақсы емес.
Dialogue: 0,0:49:54.78,0:49:55.78,Default,,0,0,0,,Ооо...
Dialogue: 0,0:49:55.91,0:49:57.87,Default,,0,0,0,,Аузыңды жап, бейбақ.
Dialogue: 0,0:49:58.16,0:50:00.95,Default,,0,0,0,,Қочитора: Жау елден көмек алсаң жетеді.
Dialogue: 0,0:50:01.08,0:50:03.04,Default,,0,0,0,,Өзіңізді ренжітуге жол бермеңіз
Dialogue: 0,0:50:03.16,0:50:07.38,Default,,0,0,0,,Бірақ менің жеке басын ойлап келген әйелдер ашуланды.
Dialogue: 0,0:50:07.50,0:50:10.13,Default,,0,0,0,,Сіз! Ай сәулесі-самаға не айтып тұрсың?
Dialogue: 0,0:50:10.25,0:50:12.84,Default,,0,0,0,,Эй, тыныш бол! (Әйел 1) Дұрыстап кешірім сұраңыз!
Dialogue: 0,0:50:12.96,0:50:16.01,Default,,0,0,0,,Ай сәулесі-сама куә, сондықтан мен сені алып кетуге келдім!
Dialogue: 0,0:50:16.13,0:50:18.76,Default,,0,0,0,,Дәрменсіз күйеу!
Dialogue: 0,0:50:18.89,0:50:20.39,Default,,0,0,0,,Сізге қайтып келудің қажеті жоқ!
Dialogue: 0,0:50:20.51,0:50:21.47,Default,,0,0,0,,Оқиға
Dialogue: 0,0:50:23.35,0:50:26.14,Default,,0,0,0,,Мен сенің жүзіңді енді көрмеймін деп үміттенемін.
Dialogue: 0,0:50:33.65,0:50:36.07,Default,,0,0,0,,Ой, сен мұндай жерде не істеп жүрсің?
Dialogue: 0,0:50:36.20,0:50:40.78,Default,,0,0,0,,Әкелер, ақымақ болмаңдар. Ол да маған көмектесті.
Dialogue: 0,0:50:40.91,0:50:42.16,Default,,0,0,0,,(Джаухараның күрсінуі)
Dialogue: 0,0:50:42.29,0:50:43.54,Default,,0,0,0,,Тыңда, сен, кішкентай бүлікші.
Dialogue: 0,0:50:44.20,0:50:48.12,Default,,0,0,0,,Мұқият тыңдаңыз, Әлхамит пен Байқари әлі де жақсы қарым-қатынаста емес.
Dialogue: 0,0:50:48.37,0:50:53.42,Default,,0,0,0,,Осы кезде соғысқа қарсы тұрған ханшайымдар тобы Байқаримен байланысқа шықты.
Dialogue: 0,0:50:53.55,0:50:56.59,Default,,0,0,0,,Барлығымыз жиналып, иықтарыңды алайық.
Dialogue: 0,0:50:56.80,0:50:57.80,Default,,0,0,0,,Ха!
Dialogue: 0,0:50:58.05,0:51:03.26,Default,,0,0,0,,Патшалықтар менің қайырымды адамға не істейтінін білмеймін.
Dialogue: 0,0:51:03.39,0:51:07.85,Default,,0,0,0,,Уайымдамаңыз, бәріңіз, бұл маусымдық сәлемдесу.
Dialogue: 0,0:51:08.10,0:51:10.19,Default,,0,0,0,,Сіз шынымен де сондай ақылдысыз ба?
Dialogue: 0,0:51:11.02,0:51:12.06,Default,,0,0,0,,Әй, күйеу бала
Dialogue: 0,0:51:12.19,0:51:13.15,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:51:13.86,0:51:16.49,Default,,0,0,0,,Пилипаппаның қарамағындағылар сұраған кешегі оқиға
Dialogue: 0,0:51:16.61,0:51:17.32,Default,,0,0,0,,Е...
Dialogue: 0,0:51:17.45,0:51:19.91,Default,,0,0,0,,Сондықтан мен оның отбасын кепілге алдым.
Dialogue: 0,0:51:20.03,0:51:21.20,Default,,0,0,0,,Уф!
Dialogue: 0,0:51:21.49,0:51:23.95,Default,,0,0,0,,Түсіндім, Ләйлара-сан.
Dialogue: 0,0:51:24.08,0:51:26.75,Default,,0,0,0,,Егер сол бағынушының күдікті әрекеті болса, маған хабарлаңыз.
Dialogue: 0,0:51:26.87,0:51:27.87,Default,,0,0,0,,Түсінді
Dialogue: 0,0:51:28.00,0:51:31.08,Default,,0,0,0,,Дұрыс... бұл елдің орталығы.
Dialogue: 0,0:51:32.59,0:51:36.13,Default,,0,0,0,,Олай болса, кеттік. Сәулетші осында.
Dialogue: 0,0:51:36.26,0:51:37.80,Default,,0,0,0,,А... иә
Dialogue: 0,0:51:37.92,0:51:42.18,Default,,0,0,0,,«Жылжымалы жолды» да, алдыңғы патшаның кесенесін де ол жобалаған.
Dialogue: 0,0:51:42.30,0:51:43.60,Default,,0,0,0,,Рекорд сенімді.
Dialogue: 0,0:51:44.60,0:51:49.10,Default,,0,0,0,,Мен қатты қалтырап кетсем не істеуім керек?
Dialogue: 0,0:51:51.60,0:51:53.98,Default,,0,0,0,,Өтінемін, қазір жауапкершілікті сезінбеңіз.
Dialogue: 0,0:51:54.36,0:51:55.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:51:55.27,0:51:58.03,Default,,0,0,0,,Ел көш бастады.
Dialogue: 0,0:51:59.86,0:52:05.41,Default,,0,0,0,,Егер сіз жеткілікті түрде дайын болмасаңыз, жақын адамдарыңызды қорғай алмайсыз.
Dialogue: 0,0:52:07.79,0:52:11.25,Default,,0,0,0,,(Лұқман иіскеу)
Dialogue: 0,0:52:16.80,0:52:22.76,Default,,0,0,0,,Мен ұзақ жолдан өттім, бірақ мен әлі күнге дейін осы орманда мысықпын ...
Dialogue: 0,0:52:22.89,0:52:24.64,Default,,0,0,0,,Кун
Dialogue: 0,0:52:25.10,0:52:28.27,Default,,0,0,0,,Сіз шынымен Наланбаяр мырзаның үйін көздеп отырсыз ба?
Dialogue: 0,0:52:28.98,0:52:34.15,Default,,0,0,0,,Лұқман, абай бол, сен мына ормандағы шұңқырға құладың.
Dialogue: 0,0:52:34.52,0:52:39.53,Default,,0,0,0,,Наланбаяр мырза бүгін жоқ...
Dialogue: 0,0:52:42.45,0:52:43.45,Default,,0,0,0,,Ах
Dialogue: 0,0:52:46.95,0:52:48.16,Default,,0,0,0,,өзін-өзі өлтіру хатын? Ах, иә
Dialogue: 0,0:52:58.50,0:53:02.13,Default,,0,0,0,,Бұл... Наланбайдың туған жері
Dialogue: 0,0:53:09.06,0:53:10.43,Default,,0,0,0,,Кун
Dialogue: 0,0:53:32.75,0:53:33.75,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:53:33.87,0:53:34.54,Default,,0,0,0,,Иә!?
Dialogue: 0,0:53:34.67,0:53:36.54,Default,,0,0,0,,Уау, кішкентай ит
Dialogue: 0,0:53:37.08,0:53:40.42,Default,,0,0,0,,Уау~ Менің әпкемнің киімі үлпілдек, жылтыр~
Dialogue: 0,0:53:40.55,0:53:41.42,Default,,0,0,0,,Эмма мен басқалары – мен бұрын-соңды көрген де, сөйлескен де алғашқы адамдар еді.
Dialogue: 0,0:53:42.55,0:53:44.30,Default,,0,0,0,,(Исуми Миямура) Ишикава-кун, сенде абсурдтай көп зат бар, иә?
Dialogue: 0,0:53:44.43,0:53:45.55,Default,,0,0,0,,Сәлем! Сіз жігіттер!!
Dialogue: 0,0:53:45.68,0:53:46.89,Default,,0,0,0,,Уақыт жұмсауға тұрарлық еді>
Dialogue: 0,0:53:50.26,0:53:51.47,Default,,0,0,0,,Хмм.
Dialogue: 0,0:53:52.06,0:53:56.19,Default,,0,0,0,,Иә? Ол киімдер... сен Архамитодансың ба?
Dialogue: 0,0:53:56.31,0:53:57.27,Default,,0,0,0,,Эх!
Dialogue: 0,0:53:57.40,0:54:00.07,Default,,0,0,0,,Мен сізге сұрақ қоя аламын ба?
Dialogue: 0,0:54:00.40,0:54:04.20,Default,,0,0,0,,Мен Наланбаял мырзаның үйін іздеп жүрмін.
Dialogue: 0,0:54:04.82,0:54:06.49,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:54:06.61,0:54:09.66,Default,,0,0,0,,Наланбаяр менің інім...
Dialogue: 0,0:54:09.78,0:54:12.79,Default,,0,0,0,,Ах! Архамиттен келгеніңді естідім.
Dialogue: 0,0:54:12.95,0:54:14.21,Default,,0,0,0,,Сіз Наланбаярдың әйелісіз бе?
Dialogue: 0,0:54:14.58,0:54:15.83,Default,,0,0,0,,Е...
Dialogue: 0,0:54:16.37,0:54:21.25,Default,,0,0,0,,Наланбаяр мырза, сіз тұрмыстасыз ба?
Dialogue: 0,0:54:23.42,0:54:27.59,Default,,0,0,0,,А, адасып қалдың ба? Сіз бұл жерге әлі үйренбегенсіз бе?
Dialogue: 0,0:54:27.72,0:54:31.14,Default,,0,0,0,,Менің атым Вулин. Сен ше?
Dialogue: 0,0:54:31.60,0:54:33.14,Default,,0,0,0,,Менің атым Сара.
Dialogue: 0,0:54:33.27,0:54:35.60,Default,,0,0,0,,Сара, мына жақта, менің артымнан жүр.
Dialogue: 0,0:54:38.10,0:54:38.98,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:54:41.23,0:54:43.99,Default,,0,0,0,,Егер сіз оны түзетпесеңіз...
Dialogue: 0,0:54:45.11,0:54:47.49,Default,,0,0,0,,Мен әйел емеспін...
Dialogue: 0,0:54:50.57,0:54:51.83,Default,,0,0,0,,Бірақ
Dialogue: 0,0:54:54.00,0:54:56.41,Default,,0,0,0,,Тамағыма бірдеңе қадалып қалды
Dialogue: 0,0:54:58.33,0:55:00.71,Default,,0,0,0,,Мен сөздерді таба алмаймын...
Dialogue: 0,0:55:01.75,0:55:03.09,Default,,0,0,0,,Таку әке
Dialogue: 0,0:55:03.21,0:55:05.51,Default,,0,0,0,,Маған да өзіңізді таныстырыңыз.
Dialogue: 0,0:55:06.05,0:55:08.63,Default,,0,0,0,,Олай болса, кешкі ас дайындап жатырмыз.
Dialogue: 0,0:55:08.84,0:55:10.51,Default,,0,0,0,,(есік жабылады)
Dialogue: 0,0:55:14.72,0:55:16.64,Default,,0,0,0,,Авававава…
Dialogue: 0,0:55:18.10,0:55:19.48,Default,,0,0,0,,wan wan wan wan
Dialogue: 0,0:55:20.06,0:55:22.19,Default,,0,0,0,,Лұқман? Не...
Dialogue: 0,0:55:23.32,0:55:26.44,Default,,0,0,0,,Одончимегу! Үйде болдыңыз ғой.
Dialogue: 0,0:55:29.36,0:55:30.70,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:55:31.66,0:55:33.33,Default,,0,0,0,,Сіз бұл мысықты білесіз бе?
Dialogue: 0,0:55:34.41,0:55:36.50,Default,,0,0,0,,Бұл жерге не үшін келдің?
Dialogue: 0,0:55:37.08,0:55:40.17,Default,,0,0,0,,Сен Әлхамитсің бе, әлде жеңгеңнің қызысың ба?
Dialogue: 0,0:55:40.29,0:55:43.71,Default,,0,0,0,,Әй, кешеден бері Наланбаяр мырзамен талай рет сөйлестім.
Dialogue: 0,0:55:43.84,0:55:45.84,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:55:46.84,0:55:48.22,Default,,0,0,0,,Кешіктіргеніміз үшін кешіріңіз.
Dialogue: 0,0:55:48.34,0:55:53.01,Default,,0,0,0,,Менің атым Сара, Архамит патшалығының 93-ханшайымы.
Dialogue: 0,0:55:53.14,0:55:55.39,Default,,0,0,0,,Сәлем! Ханшайым!?
Dialogue: 0,0:55:56.06,0:55:56.68,Default,,0,0,0,,Менің ақымақ балам не болды?
Dialogue: 0,0:55:56.68,0:55:59.89,Default,,0,0,0,,Ей, ой, менің ақымақ балам не болды? (Сара) Жоқ, жоқ, мен патша әулетінің мүшесі болсам да, ең төменгі жағындамын...
Dialogue: 0,0:56:00.02,0:56:03.27,Default,,0,0,0,,Наланбаяр мырза Архамитке жұмысқа келді... Қолайсыздық үшін кешіріңіз... А, анау қыз Стрелец екен.
Dialogue: 0,0:56:03.40,0:56:05.90,Default,,0,0,0,,Егер мен ұшатын болсам, үйге жалғыз келе алмас едім...
Dialogue: 0,0:56:06.03,0:56:11.24,Default,,0,0,0,,Біздің жағдайымызға байланысты отбасы ешбір түсініктемесіз Әл Хамитке келді.
Dialogue: 0,0:56:11.53,0:56:14.03,Default,,0,0,0,,Мен бұл туралы хабарлай алғаныма қуаныштымын.
Dialogue: 0,0:56:14.62,0:56:18.08,Default,,0,0,0,,Бүгін мен бағып жүрген мысық қашып кетті.
Dialogue: 0,0:56:18.20,0:56:20.08,Default,,0,0,0,,Мен сені қудым.
Dialogue: 0,0:56:21.71,0:56:26.63,Default,,0,0,0,,Одончимег аман қалды, сондықтан мен біттім.
Dialogue: 0,0:56:28.51,0:56:31.68,Default,,0,0,0,,Болды... барып шай іш.
Dialogue: 0,0:56:31.80,0:56:32.22,Default,,0,0,0,,Сіз шаршаған болуыңыз керек.
Dialogue: 0,0:56:32.22,0:56:33.64,Default,,0,0,0,,Сіз шаршаған болуыңыз керек (шулы дыбыс)
Dialogue: 0,0:56:33.76,0:56:34.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:35.39,0:56:38.06,Default,,0,0,0,,Эй, сыртта шу.
Dialogue: 0,0:56:38.18,0:56:39.64,Default,,0,0,0,,Әке, бұл қиын!
Dialogue: 0,0:56:40.98,0:56:44.65,Default,,0,0,0,,Бастық Әлхамиттің әйелін көру үшін ауылға келді!
Dialogue: 0,0:56:56.91,0:57:02.29,Default,,0,0,0,,Әй, анау Наланбаял жігіт лас ауылда тұрады.
Dialogue: 0,0:57:02.41,0:57:03.92,Default,,0,0,0,,Сіз айтқандай
Dialogue: 0,0:57:04.04,0:57:07.29,Default,,0,0,0,,Мен тойлау үшін ет пен алкоголь әкелдім.
Dialogue: 0,0:57:07.67,0:57:10.88,Default,,0,0,0,,Иә! Сіз... әйелі?
Dialogue: 0,0:57:11.51,0:57:14.05,Default,,0,0,0,,Сара, кел! Авававауа...
Dialogue: 0,0:57:14.39,0:57:16.26,Default,,0,0,0,,(Исуми Миямура) Ишикава-кун, сенде абсурдтай көп зат бар, иә?
Dialogue: 0,0:57:17.05,0:57:21.89,Default,,0,0,0,,А-а... сенің әйелің қайсысы...
Dialogue: 0,0:57:22.56,0:57:28.61,Default,,0,0,0,,Е... жоқ... неге екені белгісіз, көпшіліктің алдына шыға алмаймын.
Dialogue: 0,0:57:29.73,0:57:33.99,Default,,0,0,0,,Ах! Әй, сен менің әйелім болып көріне аласың ба?
Dialogue: 0,0:57:34.11,0:57:35.82,Default,,0,0,0,,Мен сенен осылай сұраймын.
Dialogue: 0,0:57:37.03,0:57:40.58,Default,,0,0,0,,Мүлдем/қарсы/ұнамайды
Dialogue: 0,0:57:42.33,0:57:43.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:57:43.91,0:57:47.50,Default,,0,0,0,,Қарсы болмасаң, мен сенің күйеу балаң боламын...
Dialogue: 0,0:57:47.63,0:57:48.79,Default,,0,0,0,,Наланбаял мырзаға
Dialogue: 0,0:57:48.92,0:57:51.26,Default,,0,0,0,,Мен сенен осындай қиын нәрсені сұрадым.
Dialogue: 0,0:57:51.38,0:57:53.13,Default,,0,0,0,,Мен қазір не істеп жатырмын?
Dialogue: 0,0:57:53.26,0:57:57.43,Default,,0,0,0,,Ававауа... Жоқ, жоқ... Сен болмасаң да.
Dialogue: 0,0:57:57.55,0:58:02.47,Default,,0,0,0,,Альхамитоның ең сұлу әйелінің рөлін ойнауға ешкім қызықпайды деп ойлаймын.
Dialogue: 0,0:58:02.60,0:58:06.23,Default,,0,0,0,,Бірақ сен өзінше сүйкімдісің, сондықтан мен үлгеремін.
Dialogue: 0,0:58:06.35,0:58:09.98,Default,,0,0,0,,Ха, енді қабылдай аласың ба деп едім!
Dialogue: 0,0:58:10.15,0:58:13.86,Default,,0,0,0,,Теңдесі жоқ сұлудың рөлі емес пе? Бұл міндетті түрде шешілді!
Dialogue: 0,0:58:13.99,0:58:15.74,Default,,0,0,0,,Мен үшін бұл халықаралық мәселе!
Dialogue: 0,0:58:17.07,0:58:18.32,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:58:18.45,0:58:23.54,Default,,0,0,0,,Сізден жақсы тәрбие, жақсы мінез шығады.
Dialogue: 0,0:58:23.91,0:58:28.88,Default,,0,0,0,,Жарайды, мен сенің алдыңда жақсы емеспін.
Dialogue: 0,0:58:29.67,0:58:33.26,Default,,0,0,0,,Жағдайға байланысты біраз уақытқа жақсы.
Dialogue: 0,0:58:34.84,0:58:40.14,Default,,0,0,0,,Бұл кісі... шынымен де Наланбаяр мырзаның әкесі.
Dialogue: 0,0:58:41.18,0:58:43.27,Default,,0,0,0,,Сіз не істеп жатырсыз? Асығыңыз!
Dialogue: 0,0:58:43.52,0:58:46.31,Default,,0,0,0,,Көсемдер тым ұзақ тұрса, қиын!
Dialogue: 0,0:58:46.44,0:58:47.85,Default,,0,0,0,,А, мен қазір барамын.
Dialogue: 0,0:58:48.52,0:58:50.02,Default,,0,0,0,,Мен мұны сұрадым, Сара-сан.
Dialogue: 0,0:58:50.15,0:58:52.02,Default,,0,0,0,,Әй, жүрегіңді дайында!
Dialogue: 0,0:58:52.86,0:58:54.49,Default,,0,0,0,,Осы жерге келіңіз
Dialogue: 0,0:58:54.61,0:58:57.45,Default,,0,0,0,,Саған да апат болды, бірақ мықты бол.
Dialogue: 0,0:58:57.57,0:58:58.78,Default,,0,0,0,,А... иә
Dialogue: 0,0:58:59.03,0:59:02.53,Default,,0,0,0,,Үй жұмысын жасай алмайтын сияқтысың, бірақ жақсысың ба?
Dialogue: 0,0:59:03.70,0:59:05.00,Default,,0,0,0,,Сіз оны болжадыңыз.
Dialogue: 0,0:59:05.12,0:59:07.25,Default,,0,0,0,,Мама, қарным ашты (У-лин) Біраз күте тұрыңыз.
Dialogue: 0,0:59:07.41,0:59:09.75,Default,,0,0,0,,Сіздің сыртқы түріңіз маңызды емес.
Dialogue: 0,0:59:09.88,0:59:13.55,Default,,0,0,0,,ше? Маған жақсырақ түсінетіндей етіп айтыңыз, жарай ма?
Dialogue: 0,0:59:13.67,0:59:17.59,Default,,0,0,0,,Бұл үйде әкем Наланбаяр және менің отбасым (Лұқманға жарысатын балалар) бар 12 адам бар.
Dialogue: 0,0:59:17.72,0:59:18.93,Default,,0,0,0,,Сіздің ағаңыздың отбасында 18 адам бар...
Dialogue: 0,0:59:19.05,0:59:23.06,Default,,0,0,0,,Лұқман... Бұл жолы жұмыс істемеуі мүмкін.
Dialogue: 0,0:59:23.89,0:59:26.77,Default,,0,0,0,,Осы уақытта менің мүмкіндігімнен асып кетті
Dialogue: 0,0:59:26.89,0:59:29.52,Default,,0,0,0,,Сіз тыңдайсыз ба? (Сара) Иә, әрине.
Dialogue: 0,0:59:29.65,0:59:32.06,Default,,0,0,0,,Өтінемін, бұлай сөйлесуді тоқтата аласыз ба?
Dialogue: 0,0:59:32.40,0:59:33.52,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:59:33.73,0:59:35.03,Default,,0,0,0,,Иә... Иә!
Dialogue: 0,0:59:35.15,0:59:36.36,Default,,0,0,0,,«Иә» бір рет
Dialogue: 0,0:59:36.90,0:59:37.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:38.57,0:59:39.61,Default,,0,0,0,,Бастықтар ше?
Dialogue: 0,0:59:39.78,0:59:42.12,Default,,0,0,0,,Мен оларды мәжіліс залына апардым.
Dialogue: 0,0:59:42.24,0:59:44.45,Default,,0,0,0,,Чико-чан ше? (2-қыз) Ұйықтап жатыр.
Dialogue: 0,0:59:45.08,0:59:46.70,Default,,0,0,0,,Мен саған футонды кигіземін.
Dialogue: 0,0:59:53.34,0:59:55.75,Default,,0,0,0,,Сіз оны футон үшін қолданасыз ба?
Dialogue: 0,0:59:57.09,1:00:00.84,Default,,0,0,0,,Мен де анамның төс көрпесін жиі қарызға алатынмын.
Dialogue: 0,1:00:01.51,1:00:04.68,Default,,0,0,0,,Әй, бұл архамиттік әйелің бе?
Dialogue: 0,1:00:05.56,1:00:07.31,Default,,0,0,0,,Рахмет, әпке~
Dialogue: 0,1:00:07.43,1:00:09.14,Default,,0,0,0,,Барлығы футон жылы ма деп сұрайды.
Dialogue: 0,1:00:09.27,1:00:11.90,Default,,0,0,0,,Сіз не істеп жатырсыз? Мен кездесу орнына барамын!
Dialogue: 0,1:00:12.02,1:00:14.94,Default,,0,0,0,,Бұл өте жақсы!
Dialogue: 0,1:00:19.45,1:00:24.83,Default,,0,0,0,,Маған ұнамайды. Шаң басып қалған сияқты. Сондықтан ауылға келгім келмейді.
Dialogue: 0,1:00:25.45,1:00:28.08,Default,,0,0,0,,Сіз мені осы уақытқа дейін баруға мәжбүр еттіңіз.
Dialogue: 0,1:00:28.20,1:00:32.33,Default,,0,0,0,,Альхамитойчидің сұлу әйелі он адамдай жақсы болса, мен оны кешірмеймін.
Dialogue: 0,1:00:33.04,1:00:35.04,Default,,0,0,0,,Мен итпін, сондықтан оны саған жібердім.
Dialogue: 0,1:00:35.17,1:00:36.00,Default,,0,0,0,,Жоқ
Dialogue: 0,1:00:36.13,1:00:37.25,Default,,0,0,0,,Бастық келген сияқты.
Dialogue: 0,1:00:37.38,1:00:38.46,Default,,0,0,0,,өту
Dialogue: 0,1:00:38.92,1:00:40.72,Default,,0,0,0,,Альхамитойчидің әдемі әйелі
Dialogue: 0,1:00:42.13,1:00:43.22,Default,,0,0,0,,Әдемі әйел…
Dialogue: 0,1:00:46.56,1:00:49.48,Default,,0,0,0,,
Dialogue: 0,1:00:51.48,1:00:55.44,Default,,0,0,0,,Сәл күте тұрыңыз, Альхамитойчи.
Dialogue: 0,1:00:55.56,1:00:59.11,Default,,0,0,0,,Адонис, Нарцисс немесе Гиацинтос деңгейінде емес пе?
Dialogue: 0,1:00:59.32,1:01:01.49,Default,,0,0,0,,Бастық: Мұның бәрі ұл болғандықтан.
Dialogue: 0,1:01:01.61,1:01:03.53,Default,,0,0,0,,Е, бұл басқа әңгіме.
Dialogue: 0,1:01:03.66,1:01:05.45,Default,,0,0,0,,Мен мұны өте жақсы білемін.
Dialogue: 0,1:01:05.57,1:01:07.53,Default,,0,0,0,,Толық.
Dialogue: 0,1:01:07.66,1:01:08.99,Default,,0,0,0,,Эй, сен нені айтып тұрсың?
Dialogue: 0,1:01:09.12,1:01:10.95,Default,,0,0,0,,Біртүрлі емес пе?
Dialogue: 0,1:01:11.83,1:01:14.08,Default,,0,0,0,,Барлығының айтқысы келетіні
Dialogue: 0,1:01:14.21,1:01:16.46,Default,,0,0,0,,Мен мұны ауыр түсінемін ...
Dialogue: 0,1:01:18.46,1:01:19.67,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:01:20.84,1:01:24.51,Default,,0,0,0,,Бүгін мен үшін алыстан келгеніңіз үшін рахмет.
Dialogue: 0,1:01:24.64,1:01:26.80,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:01:27.18,1:01:32.39,Default,,0,0,0,,Байқари бастықпен кездесе алмағаныма өте қуаныштымын.
Dialogue: 0,1:01:32.56,1:01:37.69,Default,,0,0,0,,Менің атым Сара, мен Әлхамиттен жаңа ғана тұрмысқа шықтым.
Dialogue: 0,1:01:46.12,1:01:49.24,Default,,0,0,0,,Көп болды, бастық.
Dialogue: 0,1:01:50.37,1:01:53.58,Default,,0,0,0,,О? Мұнда бастықтан басқа кез келген адам
Dialogue: 0,1:01:53.71,1:01:56.67,Default,,0,0,0,,Бұл баланың сұлулығын байқамағаныңызға сене алар емеспін.
Dialogue: 0,1:01:56.79,1:01:58.84,Default,,0,0,0,,Бұл өте өкінішті.
Dialogue: 0,1:02:00.80,1:02:02.42,Default,,0,0,0,,Өйткені, бұл адам...
Dialogue: 0,1:02:02.67,1:02:07.64,Default,,0,0,0,,Ей, бұл мерекеге арналған сыйлық!! Маған бере алсаңыз, риза болар едім.
Dialogue: 0,1:02:08.72,1:02:11.89,Default,,0,0,0,,Ол Наланбаялдың әкесі.
Dialogue: 0,1:02:12.10,1:02:14.60,Default,,0,0,0,,Бұл қыз Әлхамитке келін болды ма?
Dialogue: 0,1:02:14.73,1:02:17.56,Default,,0,0,0,,Қызық, Альхамитоның сұлулығын оның терісінің қаттылығы анықтайды ма?
Dialogue: 0,1:02:17.69,1:02:18.90,Default,,0,0,0,,Мен толықтай келісемін.
Dialogue: 0,1:02:19.19,1:02:20.90,Default,,0,0,0,,Хмм.
Dialogue: 0,1:02:21.32,1:02:22.99,Default,,0,0,0,,Архамит патшасынан...
Dialogue: 0,1:02:23.11,1:02:25.78,Default,,0,0,0,,Байқариды мазақ етесің бе?
Dialogue: 0,1:02:25.90,1:02:30.08,Default,,0,0,0,,Мен 0,1 тонна тұратын осындай қызды жібергеніме сене алар емеспін...
Dialogue: 0,1:02:30.20,1:02:32.91,Default,,0,0,0,,Әй, бәрі тыңда!
Dialogue: 0,1:02:33.54,1:02:36.87,Default,,0,0,0,,Олай болса, біздің де ойымыз бар.
Dialogue: 0,1:02:37.00,1:02:39.04,Default,,0,0,0,,Көшбасшы
Dialogue: 0,1:02:39.25,1:02:44.63,Default,,0,0,0,,Ұлымның үйлену тойына сыйлық ретінде ішімдік пен ет әкелдің.
Dialogue: 0,1:02:44.76,1:02:47.30,Default,,0,0,0,,Ауылдағылардың бәрімен бірге алайық.
Dialogue: 0,1:02:47.59,1:02:50.39,Default,,0,0,0,,Осы ауылға менің әйелім болып келген Сара-санмен.
Dialogue: 0,1:02:50.51,1:02:53.06,Default,,0,0,0,,Басшының рухына рахмет!!
Dialogue: 0,1:02:53.18,1:02:57.06,Default,,0,0,0,,(Ауыл тұрғындарының қуанышы)
Dialogue: 0,1:02:58.52,1:03:01.11,Default,,0,0,0,,Жарайды, мен саған кешкі ас дайындап берейін.
Dialogue: 0,1:03:01.23,1:03:05.07,Default,,0,0,0,,Оны кейін қайтаруымды өтінсеңіз, қиналып қаласыз, бір сағаттан кейін жеп қойыңыз.
Dialogue: 0,1:03:05.36,1:03:08.16,Default,,0,0,0,,Рахмет, бастық! Сіз таңқаларлық жақсы жігітсіз.
Dialogue: 0,1:03:08.28,1:03:09.57,Default,,0,0,0,,Ет және алкоголь!
Dialogue: 0,1:03:10.12,1:03:12.33,Default,,0,0,0,,Бұл ыңғайсыз, Санчар.
Dialogue: 0,1:03:12.49,1:03:15.08,Default,,0,0,0,,Міне, мен бақыттымын...
Dialogue: 0,1:03:16.04,1:03:18.58,Default,,0,0,0,,Бастық, еңбектеріңізге рахмет.
Dialogue: 0,1:03:18.71,1:03:22.34,Default,,0,0,0,,Бастықтың өтініші орындалғанына ризамын және ризамын.
Dialogue: 0,1:03:22.46,1:03:23.30,Default,,0,0,0,,Хо!
Dialogue: 0,1:03:23.42,1:03:27.84,Default,,0,0,0,,Бұл шынымен де лас ауыл, ал ұлдардың сапасы да онша жақсы емес.
Dialogue: 0,1:03:30.01,1:03:34.18,Default,,0,0,0,,Сара-сан, қалғанын Сейя мен Коушиге қалдырамын.
Dialogue: 0,1:03:35.43,1:03:38.77,Default,,0,0,0,,Мұндай лас нәрсемен бірге жүргенің өте жаман болды.
Dialogue: 0,1:03:38.89,1:03:43.48,Default,,0,0,0,,Жоқ, жоқ... Көмектессем...
Dialogue: 0,1:03:44.15,1:03:46.49,Default,,0,0,0,,Мен де ет алдым.
Dialogue: 0,1:03:47.24,1:03:48.82,Default,,0,0,0,,Санчар
Dialogue: 0,1:03:49.45,1:03:50.24,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:52.49,1:03:56.37,Default,,0,0,0,,Бұл дәмді сусын. Мен оны қалағанымша іше аламын.
Dialogue: 0,1:03:57.16,1:04:00.12,Default,,0,0,0,,Әй, Әлхамиттің әйелі.
Dialogue: 0,1:04:01.33,1:04:05.88,Default,,0,0,0,,Әлхамитте су жоқ, оның орнына шарап ішеді.
Dialogue: 0,1:04:06.42,1:04:11.39,Default,,0,0,0,,Өтінемін, менімен ішу сайысын өткізейік.
Dialogue: 0,1:04:12.64,1:04:16.22,Default,,0,0,0,,Жеңіске жетсең, мен саған үш есе көп ет пен спирт беремін.
Dialogue: 0,1:04:16.35,1:04:18.02,Default,,0,0,0,,Үштік!! (2-ауыл тұрғыны) Бұл!?
Dialogue: 0,1:04:18.68,1:04:23.86,Default,,0,0,0,,Жеңіске жетсем, бұл балаларға қалағанымды жасауға рұқсат етемін.
Dialogue: 0,1:04:23.98,1:04:25.02,Default,,0,0,0,,Талап етілмеген елу миллиардты қайтарып алу үшін.
Dialogue: 0,1:04:25.19,1:04:27.86,Default,,0,0,0,,А... бұл... мен...
Dialogue: 0,1:04:27.99,1:04:30.57,Default,,0,0,0,,Сара-сан, оны қабылдаудың қажеті жоқ.
Dialogue: 0,1:04:30.74,1:04:33.16,Default,,0,0,0,,Бастық бұл елде әбден ішімдікке салынған.
Dialogue: 0,1:04:33.28,1:04:36.87,Default,,0,0,0,,Мынадай қаңырап бос жатқан ауыл үшін бұл жақсы ойын-сауық деп ойламайсыз ба?
Dialogue: 0,1:04:36.99,1:04:38.20,Default,,0,0,0,,Үш рет... Эй...
Dialogue: 0,1:04:38.33,1:04:41.42,Default,,0,0,0,,Ақымақ, Сейя өткен аптада үйлену тойын жаңадан өткізген жас жұбай.
Dialogue: 0,1:04:41.54,1:04:43.42,Default,,0,0,0,,Тіпті Император сарайында да Гякугёку шешілді.
Dialogue: 0,1:04:43.63,1:04:45.54,Default,,0,0,0,,Бас тартуыңызды өтінемін!
Dialogue: 0,1:04:45.79,1:04:48.80,Default,,0,0,0,,Хехехе... Қалай болады? Санчар...
Dialogue: 0,1:04:49.42,1:04:53.01,Default,,0,0,0,,Расында, сен әдемірек болсаң.
Dialogue: 0,1:04:53.14,1:04:55.89,Default,,0,0,0,,Мен сені үйге апарайын деп келдім.
Dialogue: 0,1:04:56.01,1:04:58.85,Default,,0,0,0,,Мен олай сезінбеймін.
Dialogue: 0,1:04:59.02,1:05:01.85,Default,,0,0,0,,А... а...
Dialogue: 0,1:05:04.56,1:05:07.27,Default,,0,0,0,,Айтпақшы, Наланбаяр не болды?
Dialogue: 0,1:05:07.40,1:05:12.11,Default,,0,0,0,,Ол шынымен де мұндай уақытта шықпайтын жай ғана адам.
Dialogue: 0,1:05:12.32,1:05:16.37,Default,,0,0,0,,Шенеунік болып кетсең де, 3 айдан кейін жұмыстан шығуға дәті жетпейді.
Dialogue: 0,1:05:16.49,1:05:20.25,Default,,0,0,0,,Қайда жүрсе де жарамсыз адам.
Dialogue: 0,1:05:21.96,1:05:23.29,Default,,0,0,0,,Тайпа... (Сара) Көсем
Dialogue: 0,1:05:23.42,1:05:26.75,Default,,0,0,0,,Ет пен алкогольді дайындап бере аласыз ба?
Dialogue: 0,1:05:31.59,1:05:35.34,Default,,0,0,0,,I Бұл елдің суының бәрі шарап болса да
Dialogue: 0,1:05:35.76,1:05:38.76,Default,,0,0,0,,Мен оны аяқтайтыныма сенімдімін!
Dialogue: 0,1:05:40.27,1:05:41.56,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:05:41.68,1:05:44.81,Default,,0,0,0,,Егер сызбаларыңыз болмаса, сәулетші сізбен кездеспейді...
Dialogue: 0,1:05:44.94,1:05:47.06,Default,,0,0,0,,Жоқ, бұл анық.
Dialogue: 0,1:05:47.19,1:05:50.90,Default,,0,0,0,,А, өтінемін, мені осы жерге апарыңыз. Жүгіру және оны алу оңай.
Dialogue: 0,1:05:52.36,1:05:54.20,Default,,0,0,0,,Сосын ертең таң атқаннан кейін
Dialogue: 0,1:05:54.32,1:05:55.86,Default,,0,0,0,,Мен вагонды осында түсіремін.
Dialogue: 0,1:05:55.99,1:05:57.57,Default,,0,0,0,,Рахмет
Dialogue: 0,1:05:57.70,1:06:00.41,Default,,0,0,0,,Ай сәулесі-сен, мен сені бос ұстағаным үшін кешір.
Dialogue: 0,1:06:11.55,1:06:13.67,Default,,0,0,0,,Байкари?
Dialogue: 0,1:06:13.80,1:06:18.93,Default,,0,0,0,,Арада бірнеше күн болса да айлар өтіп кеткендей...
Dialogue: 0,1:06:32.53,1:06:34.40,Default,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,1:06:36.91,1:06:41.16,Default,,0,0,0,,Кешіріңіз, мен шаршадым, ұйықтап қалдым...
Dialogue: 0,1:06:41.28,1:06:43.87,Default,,0,0,0,,Әпке, сіз көп ішкенсіз.
Dialogue: 0,1:06:44.00,1:06:45.91,Default,,0,0,0,,Бастық, құлап қалдыңыз.
Dialogue: 0,1:06:46.79,1:06:48.67,Default,,0,0,0,,Бүгін жақсылап демалыңыз.
Dialogue: 0,1:06:49.17,1:06:52.92,Default,,0,0,0,,Мен сенің етіңді аламын. Әлде төменге түскіңіз келе ме?
Dialogue: 0,1:06:53.84,1:06:55.67,Default,,0,0,0,,Барлығы төменде күтіп тұр.
Dialogue: 0,1:06:59.97,1:07:02.76,Default,,0,0,0,,Қазірдің өзінде қараңғы...
Dialogue: 0,1:07:05.98,1:07:10.56,Default,,0,0,0,,Әжем уайымдап отыр. Мен тезірек үйге баруым керек ...
Dialogue: 0,1:07:12.69,1:07:15.24,Default,,0,0,0,,Қош бол Одончимег...
Dialogue: 0,1:07:19.28,1:07:21.07,Default,,0,0,0,,Анашым, бұл тым көп.
Dialogue: 0,1:07:21.24,1:07:23.37,Default,,0,0,0,,Сара көп жейтін сияқты.
Dialogue: 0,1:07:23.49,1:07:28.17,Default,,0,0,0,,Вуллин мырза, тамағыңызды ала алмағаныңыз үшін кешіріңіз.
Dialogue: 0,1:07:33.55,1:07:37.22,Default,,0,0,0,,тым кеш... Қазір бәрі жақсы.
Dialogue: 0,1:07:38.51,1:07:43.60,Default,,0,0,0,,Мен... ешқашан өзімді әдемімін деп ойламаппын.
Dialogue: 0,1:07:43.72,1:07:47.43,Default,,0,0,0,,Осы уақытқа дейін... бұл ешқашан болған емес...
Dialogue: 0,1:07:58.24,1:08:02.53,Default,,0,0,0,,Бұл жай... Кешегі күн мәңгілікке жалғаса берсе екен.
Dialogue: 0,1:08:03.41,1:08:05.08,Default,,0,0,0,,Аз да болса қорғай алсам
Dialogue: 0,1:08:08.96,1:08:14.17,Default,,0,0,0,,Бұл жарақат алудан қорқатын уақыт емес еді.
Dialogue: 0,1:08:17.67,1:08:21.05,Default,,0,0,0,,Барлығы ...
Dialogue: 0,1:08:22.26,1:08:24.10,Default,,0,0,0,,О... жас ханым!?
Dialogue: 0,1:08:25.93,1:08:30.89,Default,,0,0,0,,Тек... бәрі осы.
Dialogue: 0,1:08:31.77,1:08:35.11,Default,,0,0,0,,Жас ханым, мұндай жерде жалғыз не істеп жүрсің!?
Dialogue: 0,1:08:35.65,1:08:39.86,Default,,0,0,0,,О, бұл не болды? Сіз әрқашан басыңызға киетін нәрсе ...
Dialogue: 0,1:08:40.45,1:08:43.24,Default,,0,0,0,,Ханым, жалқау болғаныңыз үшін желге ұшып кеттіңіз бе?
Dialogue: 0,1:08:43.62,1:08:46.74,Default,,0,0,0,,Бір жерге ағашқа іліп қойсаң, мен қазір барамын.
Dialogue: 0,1:08:47.12,1:08:50.00,Default,,0,0,0,,(Сараның жылағаны)
Dialogue: 0,1:08:51.25,1:08:57.13,Default,,0,0,0,,Кешіріңіз... Мен бүгін өзімді жаман сезініп тұрмын...
Dialogue: 0,1:09:13.98,1:09:18.57,Default,,0,0,0,,Менің ойымша, жас келіншек түк те ұсқынсыз емес.
Dialogue: 0,1:09:20.57,1:09:21.70,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:09:47.01,1:09:50.60,Default,,0,0,0,,Наланбаял мырза, сіз асығып кеткен шығарсыз.
Dialogue: 0,1:09:50.97,1:09:53.77,Default,,0,0,0,,Аа, солай, ертең таңға қарай.
Dialogue: 0,1:09:53.89,1:09:57.06,Default,,0,0,0,,Маған су жолының сызбасын алу керек болды.
Dialogue: 0,1:09:59.65,1:10:00.86,Default,,0,0,0,,Су жолы?
Dialogue: 0,1:10:04.49,1:10:09.87,Default,,0,0,0,,Жас ханым, Әлхамиттің суын ішкеніме 50 жыл болды.
Dialogue: 0,1:10:10.24,1:10:13.58,Default,,0,0,0,,Сондықтан оған тағы қанша онжылдық қажет болатынын білмеймін.
Dialogue: 0,1:10:13.71,1:10:16.58,Default,,0,0,0,,Байқаридан Архамитке дейін су жолы тартылды.
Dialogue: 0,1:10:17.63,1:10:19.75,Default,,0,0,0,,Жас ханым тірі кезінде
Dialogue: 0,1:10:20.09,1:10:23.47,Default,,0,0,0,,Әлхамитті судың қамы жоқ ел ет.
Dialogue: 0,1:10:27.14,1:10:31.68,Default,,0,0,0,,Негізінен, мен Архамиттің керек-жарақтары Байқариға кіруді жеңілдеткім келеді...
Dialogue: 0,1:10:31.81,1:10:34.43,Default,,0,0,0,,Қараңыз, жас ханым, қазір үйге қайтайық.
Dialogue: 0,1:10:34.56,1:10:36.77,Default,,0,0,0,,Мен сені сарайға апарамын.
Dialogue: 0,1:10:40.69,1:10:42.32,Default,,0,0,0,,Наланбаяр мырза
Dialogue: 0,1:10:42.44,1:10:43.28,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:43.74,1:10:47.78,Default,,0,0,0,,Мені жіберсең, ертеңгі таңға уақытында үлгере алмайсың ба?
Dialogue: 0,1:10:48.24,1:10:49.28,Default,,0,0,0,,Жоқ, солай.
Dialogue: 0,1:10:49.87,1:10:51.83,Default,,0,0,0,,Мен қызымды мұндай жерге қалдыра алмаймын.
Dialogue: 0,1:10:51.95,1:10:57.50,Default,,0,0,0,,Наланбаял мырза, басқа елде жұмыс істегенде ең бастысы сенім.
Dialogue: 0,1:10:57.62,1:10:59.08,Default,,0,0,0,,Әлі де!
Dialogue: 0,1:11:02.55,1:11:07.13,Default,,0,0,0,,Қазір үйде ішімдік пен ет көп.
Dialogue: 0,1:11:07.26,1:11:10.68,Default,,0,0,0,,Біраз демалып, ертеңгі күнге дайындал.
Dialogue: 0,1:11:12.26,1:11:13.68,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:14.77,1:11:19.27,Default,,0,0,0,,Әрқашан қиынырақ жолды таңдаңыз
Dialogue: 0,1:11:20.94,1:11:23.19,Default,,0,0,0,,Мен мұны кейінірек жасағаныма қуаныштымын.
Dialogue: 0,1:11:28.82,1:11:30.20,Default,,0,0,0,,Ал енді, Арнайы сынып… жарайды—
Dialogue: 0,1:11:36.96,1:11:43.55,Default,,0,0,0,,Мен бір күні шекаралық төбелерден су жолын көруді асыға күтемін.
Dialogue: 0,1:11:51.30,1:11:52.72,Default,,0,0,0,,(Күйме қатты дірілдейді)
Dialogue: 0,1:11:56.18,1:12:01.02,Default,,0,0,0,,О, мен не істеуім керек? Менде су жоқ...
Dialogue: 0,1:12:01.15,1:12:06.53,Default,,0,0,0,,Жас келіншекке... оның қиналып жатқанын көру жарамайды.
Dialogue: 0,1:12:07.74,1:12:08.49,Default,,0,0,0,,Ах!
Dialogue: 0,1:12:09.20,1:12:11.95,Default,,0,0,0,,Ха, бұл қайда!? Схемасы бар!!
Dialogue: 0,1:12:14.16,1:12:15.70,Default,,0,0,0,,Фу~
Dialogue: 0,1:12:16.58,1:12:21.54,Default,,0,0,0,,Жарайды. Таң алдындағы вагонға уақытында келемін...
Dialogue: 0,1:12:22.00,1:12:23.71,Default,,0,0,0,,Сонымен қатар сызбалар бар...
Dialogue: 0,1:12:25.17,1:12:30.47,Default,,0,0,0,,Мен бір күні су жолын көруді асыға күтемін.
Dialogue: 0,1:12:33.97,1:12:35.68,Default,,0,0,0,,Бұл...
Dialogue: 0,1:12:36.35,1:12:40.81,Default,,0,0,0,,Бұл менің жас ханымға берген уәдемді орындаудың алғашқы қадамы.
Dialogue: 0,1:12:52.20,1:12:54.70,Default,,0,0,0,,Амансың ба? сәулетші
Dialogue: 0,1:12:55.03,1:12:57.74,Default,,0,0,0,,Азиздің қолдары Альхамитодағы ең жақсы.
Dialogue: 0,1:12:57.87,1:13:02.62,Default,,0,0,0,,Сол жақтағы министр, қанша ақша жұмсауым керек?
Dialogue: 0,1:13:03.04,1:13:07.46,Default,,0,0,0,,Бұл Азиздің сүйікті қоғамдық жобасы. Қалағаныңызша айтыңызшы.
Dialogue: 0,1:13:08.13,1:13:10.38,Default,,0,0,0,,Сіз... Намул-кунсыз ба?
Dialogue: 0,1:13:11.01,1:13:12.18,Default,,0,0,0,,Бұл Наланбаяр.
Dialogue: 0,1:13:12.72,1:13:14.93,Default,,0,0,0,,Архитектура дегеніміз не?
Dialogue: 0,1:13:16.47,1:13:18.56,Default,,0,0,0,,Адамдар жиналатын жер
Dialogue: 0,1:13:20.56,1:13:23.31,Default,,0,0,0,,Иә, дәл солай.
Dialogue: 0,1:13:24.06,1:13:27.94,Default,,0,0,0,,Солшыл министр, бұл жоспарды парламенттен тезірек өткізуіңізді өтінемін.
Dialogue: 0,1:13:28.27,1:13:30.11,Default,,0,0,0,,Иә!? (Саладин) Түсінді.
Dialogue: 0,1:13:30.32,1:13:33.32,Default,,0,0,0,,Бұл екі ел арасындағы дипломатиялық қарым-қатынастардың ашылуына негізделген...
Dialogue: 0,1:13:33.45,1:13:37.58,Default,,0,0,0,,Қара, Налан-кун, дайындал, мен қазір көріністі көремін.
Dialogue: 0,1:13:38.08,1:13:41.75,Default,,0,0,0,,Сіз су жолының өміріңізде аяқталғанын көргіңіз келеді, солай ма?
Dialogue: 0,1:13:41.87,1:13:44.21,Default,,0,0,0,,Әрине! Мен оны көргім келеді!!
Dialogue: 0,1:13:44.79,1:13:46.92,Default,,0,0,0,,Наланбаял мырза?
Dialogue: 0,1:13:47.50,1:13:50.76,Default,,0,0,0,,Әрине дипломатиялық қатынас ашамыз.
Dialogue: 0,1:13:51.51,1:13:52.55,Default,,0,0,0,,Фу…
Dialogue: 0,1:13:52.67,1:13:56.05,Default,,0,0,0,,Ал, мен қазірден бастап ханшайымдар тобын жинаймын.
Dialogue: 0,1:13:56.18,1:13:57.80,Default,,0,0,0,,Кезектен тыс жиналыс болады.
Dialogue: 0,1:13:57.93,1:13:59.51,Default,,0,0,0,,Иә, мен оны сізге қалдырдым.
Dialogue: 0,1:14:01.02,1:14:04.02,Default,,0,0,0,,Екеуің де қастандық жасамайсыңдар деп үміттенемін.
Dialogue: 0,1:14:04.35,1:14:07.15,Default,,0,0,0,,Жағымсыз ештеңе айтпаңыз.
Dialogue: 0,1:14:07.27,1:14:11.53,Default,,0,0,0,,Солшыл министр, парламент оны қабылдағанша аман бол.
Dialogue: 0,1:14:13.24,1:14:14.28,Default,,0,0,0,,Соғысты бастаған фракция-
Dialogue: 0,1:14:15.57,1:14:20.83,Default,,0,0,0,,Ресурстары мол Байқариды басып алып, қоныс аудару ойға да келмейді.
Dialogue: 0,1:14:20.95,1:14:23.41,Default,,0,0,0,,Бұл мүлдем нонсенс.
Dialogue: 0,1:14:24.21,1:14:28.59,Default,,0,0,0,,Мен осы елдің сәулет өнері үшін қаншалықты еңбек еттім деп ойлайсың?
Dialogue: 0,1:14:29.21,1:14:36.34,Default,,0,0,0,,Мен келесі 1000 жылда өз сәулетімді адамдармен толтыруым керек.
Dialogue: 0,1:14:37.72,1:14:40.10,Default,,0,0,0,,(Солдаттың айқайы)
Dialogue: 0,1:14:43.18,1:14:45.85,Default,,0,0,0,,(азаматтық айқай)
Dialogue: 0,1:14:50.27,1:14:53.44,Default,,0,0,0,,Менің атым Раставан III
Dialogue: 0,1:14:53.82,1:14:58.45,Default,,0,0,0,,500 жыл бұрын Байкаримен дипломатиялық келіссөздер жүргізген жалғыз адам
Dialogue: 0,1:14:59.16,1:15:03.20,Default,,0,0,0,,Содан бастап бүгінгі күнге дейін бұл адам «Еңбеу патшаның патшасы» деген атпен белгілі.
Dialogue: 0,1:15:03.33,1:15:06.58,Default,,0,0,0,,Раставан II есімінің мұрагері
Dialogue: 0,1:15:08.17,1:15:12.75,Default,,0,0,0,,Алдыңғы патша әкем маған неге айтты?
Dialogue: 0,1:15:13.67,1:15:16.22,Default,,0,0,0,,«Растабан» атты…
Dialogue: 0,1:15:17.80,1:15:21.22,Default,,0,0,0,,Қалайсың, патша?
Dialogue: 0,1:15:22.01,1:15:26.18,Default,,0,0,0,,Аа, бұл менің бас ауруымды басатындықтан біртүрлі.
Dialogue: 0,1:15:26.31,1:15:29.23,Default,,0,0,0,,Миды тікелей уқалауға болмайды.
Dialogue: 0,1:15:29.69,1:15:32.15,Default,,0,0,0,,Ойланып қарасам, мен де сені кездестірдім.
Dialogue: 0,1:15:32.27,1:15:34.23,Default,,0,0,0,,Менің басым ауырды.
Dialogue: 0,1:15:34.36,1:15:37.24,Default,,0,0,0,,Иә, қала шетіндегі массаж салонында.
Dialogue: 0,1:15:37.36,1:15:41.87,Default,,0,0,0,,Мен патшаның сонда болатынын армандаған емеспін.
Dialogue: 0,1:15:43.16,1:15:46.50,Default,,0,0,0,,Мені алып кеткен Патшаға ризамын.
Dialogue: 0,1:15:46.62,1:15:50.25,Default,,0,0,0,,Өмір бойы өтсем де, Саған қайтара алмаймын.
Dialogue: 0,1:15:50.38,1:15:52.25,Default,,0,0,0,,асыра айту
Dialogue: 0,1:15:52.54,1:15:56.92,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Әкем қайтыс болғаннан кейін не болды?
Dialogue: 0,1:15:57.05,1:16:01.51,Default,,0,0,0,,Патша менің жалғыз тірегім.
Dialogue: 0,1:16:01.89,1:16:04.18,Default,,0,0,0,,... ненің негізі?
Dialogue: 0,1:16:04.72,1:16:06.72,Default,,0,0,0,,(Халықтың лебізі)
Dialogue: 0,1:16:10.98,1:16:12.44,Default,,0,0,0,,Иә? Ой...
Dialogue: 0,1:16:16.99,1:16:21.61,Default,,0,0,0,,Енді сіз әлі де мықты патша ретінде өз атыңызды қалдыра аласыз...
Dialogue: 0,1:16:21.74,1:16:27.12,Default,,0,0,0,,Мен өлгеннен кейін 100, 1000 жыл өтсе де жалқау деп аталудан қорқамын...
Dialogue: 0,1:16:27.83,1:16:32.25,Default,,0,0,0,,Мен өз атымды сәтсіз патша ретінде қалдырғым келмейді.
Dialogue: 0,1:16:34.59,1:16:39.42,Default,,0,0,0,,Ноу Пилипаппа Соңғы соғыс қателік болды ма?
Dialogue: 0,1:16:40.51,1:16:42.09,Default,,0,0,0,,Король
Dialogue: 0,1:16:44.05,1:16:48.98,Default,,0,0,0,,Билеуші алдымен өз халқының өмірін ойлауы керек.
Dialogue: 0,1:16:49.10,1:16:52.98,Default,,0,0,0,,Еліміздің суы болашақта таусылатынын ескере отырып.
Dialogue: 0,1:16:53.10,1:16:56.90,Default,,0,0,0,,Байқарды басып алу қате емес.
Dialogue: 0,1:16:57.11,1:17:00.78,Default,,0,0,0,,Бұл біздің әл-Хамит халқымыз үшін.
Dialogue: 0,1:17:02.53,1:17:06.83,Default,,0,0,0,,Кейде патша «Байқаридың күйеу баласы» болған.
Dialogue: 0,1:17:07.29,1:17:11.00,Default,,0,0,0,,Оның ханшайымдар фракциясына қатысы бар сияқты...
Dialogue: 0,1:17:11.12,1:17:11.96,Default,,0,0,0,,Не!
Dialogue: 0,1:17:12.08,1:17:17.21,Default,,0,0,0,,Ханшайым мен Байқари бірігіп, елімізді құлатуды жоспарлап отыр ма?
Dialogue: 0,1:17:17.38,1:17:19.17,Default,,0,0,0,,Мені кешіріңіз, Леополдин!
Dialogue: 0,1:17:19.30,1:17:20.97,Default,,0,0,0,,Мен патшамын!
Dialogue: 0,1:17:21.63,1:17:24.01,Default,,0,0,0,,Мен оны бұзбаймын, Ләйләла.
Dialogue: 0,1:17:24.26,1:17:27.97,Default,,0,0,0,,Ей, барымтаға алынған отбасылар не болмақ...
Dialogue: 0,1:17:28.43,1:17:33.52,Default,,0,0,0,,Дегенмен, патша сарайында да ханшайымдардың жанкүйерлері аз емес.
Dialogue: 0,1:17:33.64,1:17:36.02,Default,,0,0,0,,Өте тез
Dialogue: 0,1:17:36.15,1:17:39.07,Default,,0,0,0,,«Байқалидың күйеу баласын» өлтірейік.
Dialogue: 0,1:17:39.19,1:17:40.11,Default,,0,0,0,,Не?
Dialogue: 0,1:17:40.23,1:17:42.95,Default,,0,0,0,,Патша сарайында жазатайым оқиғалар жиі кездеседі.
Dialogue: 0,1:17:43.07,1:17:46.20,Default,,0,0,0,,Байкари кек қайтаруға көшсе де,
Dialogue: 0,1:17:46.32,1:17:50.20,Default,,0,0,0,,Соғысқа алдын ала дайындалу керек.
Dialogue: 0,1:17:50.33,1:17:51.29,Default,,0,0,0,,Ооо...
Dialogue: 0,1:17:51.41,1:17:54.50,Default,,0,0,0,,Халқымыз үшін күресу
Dialogue: 0,1:17:54.62,1:17:57.17,Default,,0,0,0,,Бұл жерде ештеңе жоқ
Dialogue: 0,1:17:57.29,1:17:58.92,Default,,0,0,0,,Уф...
Dialogue: 0,1:18:05.84,1:18:09.76,Default,,0,0,0,,Ханшайым, оятыңыз ханшайым!
Dialogue: 0,1:18:11.18,1:18:16.48,Default,,0,0,0,,Түс болды. Мен кеше түнде қатты уайымдадым.
Dialogue: 0,1:18:16.85,1:18:19.73,Default,,0,0,0,,Қайда болдың?
Dialogue: 0,1:18:27.32,1:18:32.75,Default,,0,0,0,,Наран-кун, маған сол атақты тауды түсіндіріп берші...
Dialogue: 0,1:18:32.91,1:18:35.92,Default,,0,0,0,,«Хемзиршигуи» екеніне сенімдісіз бе?
Dialogue: 0,1:18:38.17,1:18:41.09,Default,,0,0,0,,Иә? Не болды, Налан-кун?
Dialogue: 0,1:18:41.21,1:18:43.59,Default,,0,0,0,,Иә иә... жоқ...
Dialogue: 0,1:18:43.71,1:18:47.18,Default,,0,0,0,,Өйткені, бұл кісі... Қайдан қарасаң да, ол ғалымнан гөрі физикалық адам...
Dialogue: 0,1:18:47.30,1:18:48.72,Default,,0,0,0,,О? (Азиз) А
Dialogue: 0,1:18:48.85,1:18:53.56,Default,,0,0,0,,Айтпақшы, Жаухара-кун, су жолының қай жолы жақсы?
Dialogue: 0,1:18:53.89,1:18:58.98,Default,,0,0,0,,Ең алдымен, іргетас салуға қолайлы ең қиын қабаттарды таңдау.
Dialogue: 0,1:18:59.36,1:19:01.27,Default,,0,0,0,,Шөлде, тіпті қатты тас
Dialogue: 0,1:19:01.40,1:19:05.28,Default,,0,0,0,,Сізге 30 метр қазу керек, сондықтан одан аулақ болыңыз.
Dialogue: 0,1:19:05.40,1:19:10.45,Default,,0,0,0,,Біршама айналып өтсе де, құм тайыз болатын солтүстік жағы сенімдірек.
Dialogue: 0,1:19:10.99,1:19:13.87,Default,,0,0,0,,Иә, иә, құрылыс мерзімі қанша уақытқа созылады?
Dialogue: 0,1:19:14.25,1:19:15.75,Default,,0,0,0,,ең ерте 50 жыл
Dialogue: 0,1:19:16.00,1:19:18.29,Default,,0,0,0,,Иә! 50 жыл...
Dialogue: 0,1:19:18.42,1:19:21.38,Default,,0,0,0,,Бұл жай ғана. Бұл елде солай бола ма?
Dialogue: 0,1:19:26.38,1:19:28.38,Default,,0,0,0,,Жарайды, мен жеңілдеп қалдым.
Dialogue: 0,1:19:28.51,1:19:29.22,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,1:19:30.05,1:19:33.47,Default,,0,0,0,,Құрылыс технологиясы 10 жылдан кейін айтарлықтай дамиды.
Dialogue: 0,1:19:33.60,1:19:36.56,Default,,0,0,0,,Бұл 50 жылдан әлдеқайда жылдам!
Dialogue: 0,1:19:36.77,1:19:41.90,Default,,0,0,0,,Ең бастысы, «Хемжирсигви» - «шексіз» дегенді білдіретін тау.
Dialogue: 0,1:19:42.02,1:19:44.98,Default,,0,0,0,,Байқари тіпті «Су елі» деп аталады.
Dialogue: 0,1:19:45.11,1:19:48.32,Default,,0,0,0,,Сол таудан үздіксіз су атқылап тұрады.
Dialogue: 0,1:19:48.61,1:19:52.33,Default,,0,0,0,,Құрылыс басталғалы Әлхамит аман қалады.
Dialogue: 0,1:19:53.95,1:19:55.54,Default,,0,0,0,,Мен саған сенемін.
Dialogue: 0,1:20:08.09,1:20:11.55,Default,,0,0,0,,(Тергеу барысы)
Dialogue: 0,1:20:23.65,1:20:26.69,Default,,0,0,0,,Қызық, әпкелеріңіздің ақпараттық желісі қандай?
Dialogue: 0,1:20:26.82,1:20:29.11,Default,,0,0,0,,Байкари туралы естігіңіз келе ме?
Dialogue: 0,1:20:29.24,1:20:32.99,Default,,0,0,0,,Ха, мен Байкариге барамын деп ойламаппын...
Dialogue: 0,1:20:33.12,1:20:34.12,Default,,0,0,0,,Эренді тоқтату үшін. Көпшілік кісі өлтіру – қате.
Dialogue: 0,1:20:34.83,1:20:37.62,Default,,0,0,0,,Наланбаяр мырза да осы патша астанасында бір жерде.
Dialogue: 0,1:20:37.75,1:20:39.21,Default,,0,0,0,,Сіз барынша тырысып жатырсыз ба?
Dialogue: 0,1:20:39.83,1:20:42.00,Default,,0,0,0,,Үйге үш күн келмеді...
Dialogue: 0,1:20:42.12,1:20:45.42,Default,,0,0,0,,Сіз дұрыс тамақтана аласыз деп үміттенемін...
Dialogue: 0,1:20:46.96,1:20:50.51,Default,,0,0,0,,Сіз менің әйелім болып көріне аласыз ба?
Dialogue: 0,1:20:52.18,1:20:57.27,Default,,0,0,0,,Бірақ сіздің үйде әдемі әйеліңіз бар...
Dialogue: 0,1:20:58.06,1:21:02.81,Default,,0,0,0,,Бұл мені уайымдайтын нәрсе емес...
Dialogue: 0,1:21:03.35,1:21:06.69,Default,,0,0,0,,Наран-кун, кездесудің уақыты келді емес пе?
Dialogue: 0,1:21:07.36,1:21:08.44,Default,,0,0,0,,Наран-кун?
Dialogue: 0,1:21:08.73,1:21:09.94,Default,,0,0,0,,Иә? Күрсін
Dialogue: 0,1:21:10.19,1:21:14.74,Default,,0,0,0,,Сіз кір болып көрінесіз, сондықтан оны тазалаңыз.
Dialogue: 0,1:21:14.87,1:21:18.83,Default,,0,0,0,,Бүгін сіздердің оң және солшылдар министрі үш жақты кездесу.
Dialogue: 0,1:21:19.04,1:21:21.58,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,1:21:22.21,1:21:23.71,Default,,0,0,0,,Әзірше, Жаухара-кун
Dialogue: 0,1:21:23.83,1:21:26.13,Default,,0,0,0,,Менімен бірге бару керек.
Dialogue: 0,1:21:26.38,1:21:29.09,Default,,0,0,0,,Наран-кун, жалғыз қалмау керек.
Dialogue: 0,1:21:29.21,1:21:30.30,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:31.30,1:21:36.05,Default,,0,0,0,,Балалар, менің не айтқым келгенін түсінбейтін ақымақ емессіңдер.
Dialogue: 0,1:21:44.90,1:21:48.07,Default,,0,0,0,,Кешіріңіз, бұл Раставан II ме?
Dialogue: 0,1:21:48.36,1:21:50.03,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:50.15,1:21:52.11,Default,,0,0,0,,Ой, не болды?
Dialogue: 0,1:21:58.70,1:22:00.08,Default,,0,0,0,,Үйге тірі бара алсаң
Dialogue: 0,1:22:00.20,1:22:02.79,Default,,0,0,0,,Әлхамиттің шығу тегін түсіндіремін.
Dialogue: 0,1:22:02.91,1:22:07.00,Default,,0,0,0,,Аа, тарих өте егжей-тегжейлі, сондықтан мен орта кезеңді қалаймын.
Dialogue: 0,1:22:07.17,1:22:08.38,Default,,0,0,0,,Ортаңғы кезең қашан? (Аяқ дыбыстары)
Dialogue: 0,1:22:08.50,1:22:09.34,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:12.21,1:22:15.84,Default,,0,0,0,,Бұл Пилипаппа-саманың жеке күзетшісі.
Dialogue: 0,1:22:16.09,1:22:18.30,Default,,0,0,0,,Өз бетіңізше не істедіңіз?
Dialogue: 0,1:22:21.35,1:22:23.68,Default,,0,0,0,,О? Не? Сен не істеп жатырсың?
Dialogue: 0,1:22:24.23,1:22:25.65,Default,,0,0,0,,Балалар сендер қашып кетіңдер.
Dialogue: 0,1:22:25.77,1:22:28.81,Default,,0,0,0,,Дәлізде 20 қарулы солдат күтіп тұр!
Dialogue: 0,1:22:29.02,1:22:29.86,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:30.11,1:22:33.90,Default,,0,0,0,,Мұқият тыңда, бүгін патша жағы сөзсіз «Байқаридың күйеу баласы».
Dialogue: 0,1:22:34.03,1:22:35.57,Default,,0,0,0,,Мен сені "өлтіремін"!
Dialogue: 0,1:22:35.91,1:22:37.07,Default,,0,0,0,,Ха!
Dialogue: 0,1:22:37.78,1:22:40.49,Default,,0,0,0,,Маған мұны не үшін айтасың?
Dialogue: 0,1:22:40.70,1:22:42.50,Default,,0,0,0,,Сәлем, Баура! Сен не істеп жатырсың?
Dialogue: 0,1:22:42.62,1:22:44.33,Default,,0,0,0,,Егер сіз...
Dialogue: 0,1:22:45.21,1:22:46.50,Default,,0,0,0,,Сіз кездейсоқсыз ба?
Dialogue: 0,1:22:46.62,1:22:48.96,Default,,0,0,0,,Менің отбасымды Ләйләла кепілде ұстап отыр...
Dialogue: 0,1:22:49.09,1:22:50.67,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,1:22:51.46,1:22:55.59,Default,,0,0,0,,Менің дауысым дипломатиялық қарым-қатынастарды ашу және су жолдарын салу.
Dialogue: 0,1:22:55.72,1:22:59.93,Default,,0,0,0,,Осы жерде өлсең, енді ешқашан дипломатиялық қатынас болмайды.
Dialogue: 0,1:23:00.14,1:23:00.93,Default,,0,0,0,,Ах
Dialogue: 0,1:23:01.14,1:23:03.18,Default,,0,0,0,,Үшеумізді бірден шығарып салады!
Dialogue: 0,1:23:03.68,1:23:04.68,Default,,0,0,0,,Кек сақтама!
Dialogue: 0,1:23:11.02,1:23:12.53,Default,,0,0,0,,Уау!
Dialogue: 0,1:23:12.65,1:23:15.07,Default,,0,0,0,,Баламды тұншықтырып өлтіргеніңіз үшін рахмет.
Dialogue: 0,1:23:17.82,1:23:21.33,Default,,0,0,0,,Мен саусағымды сызыққа қоюым керек, сендер жүгіріңдер.
Dialogue: 0,1:23:21.99,1:23:24.66,Default,,0,0,0,,Мен Пилипаппа бейбақына жол беремін.
Dialogue: 0,1:23:24.79,1:23:26.21,Default,,0,0,0,,Жалғыз...
Dialogue: 0,1:23:26.33,1:23:28.92,Default,,0,0,0,,Ха, бар болғаны 20 қарулы солдат шығар.
Dialogue: 0,1:23:29.33,1:23:32.34,Default,,0,0,0,,Леопольдин ханшайымы орналасқан Королева сарайына барыңыз.
Dialogue: 0,1:23:32.46,1:23:35.17,Default,,0,0,0,,Онда тіпті патшаның экстерриториалдылығы бар.
Dialogue: 0,1:23:35.67,1:23:39.26,Default,,0,0,0,,Өлетін түрің жоқ, бірақ мен саған айтамын.
Dialogue: 0,1:23:39.47,1:23:40.51,Default,,0,0,0,,Өлме
Dialogue: 0,1:23:43.68,1:23:44.52,Default,,0,0,0,,Міне болды!
Dialogue: 0,1:23:46.02,1:23:47.02,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:23:47.14,1:23:48.02,Default,,0,0,0,,Мені жайбарақаттармен бірге қоспа
Dialogue: 0,1:23:48.19,1:23:53.23,Default,,0,0,0,,Байқаридың күйеу баласы сирек көрінеді.
Dialogue: 0,1:23:53.36,1:23:56.40,Default,,0,0,0,,Мен өте ұқыпты адаммын.
Dialogue: 0,1:23:57.19,1:24:00.28,Default,,0,0,0,,Қандай да бір апат болды ма?
Dialogue: 0,1:24:00.53,1:24:04.79,Default,,0,0,0,,Патша сарайының ішінде кез келген нәрсе болуы мүмкін.
Dialogue: 0,1:24:07.04,1:24:10.29,Default,,0,0,0,,Жоғарғы қабаттың жанында Королева сарайына апаратын жол бар!
Dialogue: 0,1:24:10.46,1:24:13.34,Default,,0,0,0,,Асығыңыз! Құлыптау алдында!
Dialogue: 0,1:24:14.13,1:24:15.67,Default,,0,0,0,,Иә? Баура иә!?
Dialogue: 0,1:24:15.80,1:24:18.30,Default,,0,0,0,,Бүгін Пилипаппамен кездесу болған жоқ па?
Dialogue: 0,1:24:18.42,1:24:21.09,Default,,0,0,0,,Жоқ, сізден сұрайын дегенім бар...
Dialogue: 0,1:24:21.22,1:24:22.93,Default,,0,0,0,,Еңбектеріңіз үшін рахмет!! (SS C) Иә? Бұл...
Dialogue: 0,1:24:23.05,1:24:24.10,Default,,0,0,0,,Сәлем сен!
Dialogue: 0,1:24:24.81,1:24:25.77,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,1:24:25.89,1:24:30.14,Default,,0,0,0,,Менің мұндай жерде отыруға уақытым жоқ.
Dialogue: 0,1:24:30.56,1:24:34.19,Default,,0,0,0,,Асықсақ та, су жолын салуға 50 жыл керек!
Dialogue: 0,1:24:34.32,1:24:35.02,Default,,0,0,0,,Ха!
Dialogue: 0,1:24:36.15,1:24:38.19,Default,,0,0,0,,Сәлем! Ол Байқардың күйеу баласы!
Dialogue: 0,1:24:38.74,1:24:39.86,Default,,0,0,0,,(Изуку) Кайри-чанның квиркі күшейіп келеді
Dialogue: 0,1:24:39.99,1:24:42.11,Default,,0,0,0,,Tsk! Мен тікелей кесіп аламын!
Dialogue: 0,1:24:42.78,1:24:44.62,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,1:24:45.95,1:24:47.54,Default,,0,0,0,,Ашиха
Dialogue: 0,1:24:47.66,1:24:52.37,Default,,0,0,0,,Мен бұл жолды таңдадым, тіпті қызымды қараңғыда қалдырдым...
Dialogue: 0,1:24:56.55,1:24:57.51,Default,,0,0,0,,Әлі жоқ...
Dialogue: 0,1:25:07.35,1:25:08.47,Default,,0,0,0,,Ләйлә-сан!?
Dialogue: 0,1:25:08.72,1:25:09.98,Default,,0,0,0,,Уау!!!
Dialogue: 0,1:25:10.35,1:25:12.27,Default,,0,0,0,,(қарулы сарбаздар жөтел)
Dialogue: 0,1:25:12.77,1:25:14.15,Default,,0,0,0,,Мен сені күттім, күйеу балам.
Dialogue: 0,1:25:14.27,1:25:16.48,Default,,0,0,0,,Сіз қастандық жасағысыз ба?
Dialogue: 0,1:25:16.61,1:25:18.19,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,1:25:19.74,1:25:22.40,Default,,0,0,0,,Кеттік! Патшайым сарайына
Dialogue: 0,1:25:25.78,1:25:27.49,Default,,0,0,0,,Баая... бұл...
Dialogue: 0,1:25:27.62,1:25:28.49,Default,,0,0,0,,Әпке
Dialogue: 0,1:25:28.62,1:25:31.37,Default,,0,0,0,,Патша сарайынан түтін шығып жатыр.
Dialogue: 0,1:25:32.87,1:25:34.63,Default,,0,0,0,,Басталған сияқты.
Dialogue: 0,1:25:38.55,1:25:41.26,Default,,0,0,0,,Мен патша сарайына барамын.
Dialogue: 0,1:25:41.38,1:25:45.14,Default,,0,0,0,,Қазір ойлап қарасам, патшаның бас ауруы жақсы емес көрінеді.
Dialogue: 0,1:25:45.26,1:25:46.80,Default,,0,0,0,,Патша-
Dialogue: 0,1:25:46.93,1:25:51.02,Default,,0,0,0,,Ол біздің қиялымыздан тыс қысымдарға төтеп береді.
Dialogue: 0,1:25:51.14,1:25:54.40,Default,,0,0,0,,Бұл туралы ештеңе істей алмаймыз.
Dialogue: 0,1:25:54.90,1:25:56.65,Default,,0,0,0,,Менен басқа
Dialogue: 0,1:25:56.94,1:26:00.15,Default,,0,0,0,,Сәлем! Байқаридың күйеу баласы әлі табылған жоқ!
Dialogue: 0,1:26:00.28,1:26:02.86,Default,,0,0,0,,Ха! Біреу көмектесіп жатқан сияқты!
Dialogue: 0,1:26:02.99,1:26:04.82,Default,,0,0,0,,Уф...
Dialogue: 0,1:26:04.95,1:26:08.66,Default,,0,0,0,,Жақсы! Патшайым сарайына өтетін жолды да жабыңыз!
Dialogue: 0,1:26:08.99,1:26:11.87,Default,,0,0,0,,Күйеу балаңызды тапқан бойда өлтіріңіз!
Dialogue: 0,1:26:12.00,1:26:16.04,Default,,0,0,0,,Айтпақшы, неге жасырын әскер жинап жатырсың?
Dialogue: 0,1:26:17.29,1:26:21.63,Default,,0,0,0,,Дәл қазір біз отандық экономика мен дипломатияға назар аударуымыз керек, солай емес пе?
Dialogue: 0,1:26:21.76,1:26:25.01,Default,,0,0,0,,Соғыс бастауды жоспарлап отырсыз ба?
Dialogue: 0,1:26:25.13,1:26:26.22,Default,,0,0,0,,Хаха
Dialogue: 0,1:26:26.34,1:26:30.68,Default,,0,0,0,,Неліктен сіз, солшылдар министрі, мұндай нәрсені тергейсіз?
Dialogue: 0,1:26:31.10,1:26:34.94,Default,,0,0,0,,Тіпті безендіру де жалақы ретінде қызмет ете алады.
Dialogue: 0,1:26:35.85,1:26:40.48,Default,,0,0,0,,Бұл мәселе кеңестің келесі кезекті отырысында талқылануы керек.
Dialogue: 0,1:26:42.99,1:26:46.24,Default,,0,0,0,,Ал... бәс тігуді қалайсыз ба?
Dialogue: 0,1:26:46.70,1:26:51.91,Default,,0,0,0,,Байқардан шыққан ақылды күйеу баласы патшаның бас ауруын емдей ала ма?
Dialogue: 0,1:26:52.54,1:26:56.08,Default,,0,0,0,,Егер мен оны түзете алмасам, солшыл министр қызметінен кетемін.
Dialogue: 0,1:26:56.21,1:26:59.17,Default,,0,0,0,,Егер оны емдеуге болатын болса, сіз Оң министрі қызметінен кетесіз.
Dialogue: 0,1:26:59.88,1:27:04.55,Default,,0,0,0,,Енді бұл ставка маған бір қарағанда жаман ставка болып көрінгенімен...
Dialogue: 0,1:27:05.22,1:27:08.97,Default,,0,0,0,,Сізде мінуге батылдық жоқ па?
Dialogue: 0,1:27:13.22,1:27:16.10,Default,,0,0,0,,Енді сіз айтып отырсыз... хахаха
Dialogue: 0,1:27:16.23,1:27:19.02,Default,,0,0,0,,Жарайды, мен сені апарып беремін.
Dialogue: 0,1:27:20.73,1:27:23.15,Default,,0,0,0,,Мен уақытымды сатып алдым.
Dialogue: 0,1:27:23.28,1:27:25.78,Default,,0,0,0,,Наланбаяр мырза аман болыңыз.
Dialogue: 0,1:27:26.86,1:27:29.41,Default,,0,0,0,,Эй, бұл хабаршы. Жоспарды өзгертіңіз.
Dialogue: 0,1:27:29.53,1:27:31.41,Default,,0,0,0,,Пилипаппа-сама, иә?
Dialogue: 0,1:27:32.24,1:27:36.21,Default,,0,0,0,,Байқаридан күйеу алған ханшайым туралы не білгілерің келеді?
Dialogue: 0,1:27:36.33,1:27:38.71,Default,,0,0,0,,Ол мұнда қашып кетті (2-солдат) Оның әріптесі бар сияқты.
Dialogue: 0,1:27:38.83,1:27:41.25,Default,,0,0,0,,Байқаридың күйеу баласын өлтір!
Dialogue: 0,1:27:42.46,1:27:45.67,Default,,0,0,0,,Бұл жақсы емес. Сарбаздар қызу жинала бастады.
Dialogue: 0,1:27:45.80,1:27:48.72,Default,,0,0,0,,Біз патшайым сарайына сырттан жақындаймыз.
Dialogue: 0,1:27:56.10,1:27:57.23,Default,,0,0,0,,
Dialogue: 0,1:28:02.23,1:28:05.23,Default,,0,0,0,,Бұл өте үлкен мәселе.
Dialogue: 0,1:28:06.19,1:28:08.61,Default,,0,0,0,,Эй, бұл Леополдин ханым!
Dialogue: 0,1:28:09.20,1:28:12.83,Default,,0,0,0,,Балалар мұнда не істеп жүрсіңдер?
Dialogue: 0,1:28:12.95,1:28:15.79,Default,,0,0,0,,Эй, бүгін... бұл...
Dialogue: 0,1:28:15.91,1:28:19.67,Default,,0,0,0,,Оң жақтағы министр маған төтенше жағдайға дайындық жүргізуді сұрады...
Dialogue: 0,1:28:20.21,1:28:24.13,Default,,0,0,0,,Мен патшамен сөйлесуге келдім, мен сол жерден өтіп жатырмын.
Dialogue: 0,1:28:24.63,1:28:26.17,Default,,0,0,0,,Қылышыңызды қынап алыңыз
Dialogue: 0,1:28:26.80,1:28:27.88,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,1:28:28.38,1:28:29.88,Default,,0,0,0,,(Хане)
Dialogue: 0,1:28:51.32,1:28:54.70,Default,,0,0,0,,Ләйләла мырза, сізде галлюцинация пайда болды ма?
Dialogue: 0,1:28:54.83,1:28:57.70,Default,,0,0,0,,Мен жаңа ғана жас келіншек көрдім.
Dialogue: 0,1:28:57.83,1:29:01.12,Default,,0,0,0,,Ханшайым әбігерді естіп, келді.
Dialogue: 0,1:29:01.58,1:29:04.38,Default,,0,0,0,,Не? Әй, мен жас ханымды ғана көрдім.
Dialogue: 0,1:29:04.50,1:29:05.88,Default,,0,0,0,,Идиот
Dialogue: 0,1:29:06.50,1:29:09.42,Default,,0,0,0,,Не істеу керек? Королева сарайына өту
Dialogue: 0,1:29:09.55,1:29:11.55,Default,,0,0,0,,Оны қарулы солдаттар жауып тастады... Иә?
Dialogue: 0,1:29:11.68,1:29:13.47,Default,,0,0,0,,Сіз бұл орынды енді пайдалана алмайсыз.
Dialogue: 0,1:29:14.18,1:29:16.56,Default,,0,0,0,,Патшайым сарайына басқа жол жоқ па?
Dialogue: 0,1:29:16.68,1:29:18.43,Default,,0,0,0,,Жоқ, бірақ-
Dialogue: 0,1:29:18.56,1:29:21.27,Default,,0,0,0,,Леополдин ханымның осында келуі осыны білдіреді
Dialogue: 0,1:29:21.39,1:29:24.19,Default,,0,0,0,,Ол патшаны жазалай алуы керек.
Dialogue: 0,1:29:24.31,1:29:25.48,Default,,0,0,0,,Бірақ бұған дейін...
Dialogue: 0,1:29:26.11,1:29:30.82,Default,,0,0,0,,Іс осылай жалғаса берсе, күйеу баламды солдаттар қоршап алып өлтіреді.
Dialogue: 0,1:29:36.20,1:29:37.33,Default,,0,0,0,,Не?
Dialogue: 0,1:29:37.83,1:29:38.74,Default,,0,0,0,,Сол ханшайым-
Dialogue: 0,1:29:38.87,1:29:42.79,Default,,0,0,0,,Ол Байқари бастықпен банкетте ішіп отырғанын айтты!?
Dialogue: 0,1:29:42.92,1:29:43.54,Default,,0,0,0,,Иә
Dialogue: 0,1:29:43.67,1:29:47.54,Default,,0,0,0,,Хмм, мен... анау шекаралық ханшайым!
Dialogue: 0,1:29:47.80,1:29:50.59,Default,,0,0,0,,Байкаримен сөйлестіңіз бе?
Dialogue: 0,1:29:51.51,1:29:54.09,Default,,0,0,0,,Байқаридың күйеу баласы әлі Патша сарайында болуы керек.
Dialogue: 0,1:29:54.22,1:29:57.30,Default,,0,0,0,,Оны тапқан бойда дереу өлтіріңіз. Жақсы.
Dialogue: 0,1:30:07.98,1:30:08.77,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:30:08.77,1:30:09.61,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:09.73,1:30:10.98,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:11.15,1:30:11.90,Default,,0,0,0,,(Сала тынысын басып)
Dialogue: 0,1:30:11.90,1:30:15.49,Default,,0,0,0,,Жас ханым!? Неге мұндасың!?
Dialogue: 0,1:30:18.08,1:30:20.70,Default,,0,0,0,,Мен қуаныштымын... сен амансың...
Dialogue: 0,1:30:21.75,1:30:26.21,Default,,0,0,0,,Құпия өткелге кіреберіс бар, оны тек біз патша мүшелері біледі.
Dialogue: 0,1:30:26.33,1:30:28.50,Default,,0,0,0,,Мен сізге соны айту үшін келдім.
Dialogue: 0,1:30:29.17,1:30:31.13,Default,,0,0,0,,Құпия үзінді!? Бірдеңе...
Dialogue: 0,1:30:31.26,1:30:35.09,Default,,0,0,0,,Тыңдаңыз! Бұл Пилипаппа-самадан тапсырыс!
Dialogue: 0,1:30:35.22,1:30:38.18,Default,,0,0,0,,Сара ханшайым Байкаримен жасырын сөйлесті деп күдіктенеді!
Dialogue: 0,1:30:38.30,1:30:39.51,Default,,0,0,0,,Мені ұстаңыз!
Dialogue: 0,1:30:39.72,1:30:42.89,Default,,0,0,0,,Қарсы болсаң, ең жаманы – өмір немесе өлім!
Dialogue: 0,1:30:43.02,1:30:43.77,Default,,0,0,0,,Ха!
Dialogue: 0,1:30:43.89,1:30:46.65,Default,,0,0,0,,А... не айтып тұрсың!?
Dialogue: 0,1:30:46.77,1:30:47.94,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,1:30:48.06,1:30:50.98,Default,,0,0,0,,Қалай болғанда да, жағдайдың мәні бар.
Dialogue: 0,1:30:54.24,1:30:56.78,Default,,0,0,0,,Tsk, өлшемі сәйкес емес.
Dialogue: 0,1:30:58.07,1:31:00.78,Default,,0,0,0,,Сосын мен, Сара-саманың киімі.
Dialogue: 0,1:31:00.91,1:31:01.70,Default,,0,0,0,,Иә?
Dialogue: 0,1:31:01.83,1:31:03.83,Default,,0,0,0,,Біз жемге айналамыз
Dialogue: 0,1:31:03.95,1:31:05.50,Default,,0,0,0,,Бірақ, Сара-сама.
Dialogue: 0,1:31:05.62,1:31:09.13,Default,,0,0,0,,Менің күйеу баламды жасырын өткелге апаруыңызды өтінемін.
Dialogue: 0,1:31:09.67,1:31:13.26,Default,,0,0,0,,Тыңдаңдар, балалар сендер аман қалуларың керек.
Dialogue: 0,1:31:21.10,1:31:21.85,Default,,0,0,0,,Міне болды!!
Dialogue: 0,1:31:21.97,1:31:23.47,Default,,0,0,0,,♪ Сіз оны естисіз, солай ма?
Dialogue: 0,1:31:23.47,1:31:25.02,Default,,0,0,0,,♪ Естуге болады, екі елдің болашағы.
Dialogue: 0,1:31:25.43,1:31:27.27,Default,,0,0,0,,Екеуіңе байланысты, жүрегің тез соғады.
Dialogue: 0,1:31:27.27,1:31:29.02,Default,,0,0,0,,Жүрек соғуы
Dialogue: 0,1:31:29.81,1:31:31.02,Default,,0,0,0,,Мен оны сұрадым! бірдей ырғақ
Dialogue: 0,1:31:31.02,1:31:31.57,Default,,0,0,0,,Бірдей ырғақ
Dialogue: 0,1:31:31.57,1:31:32.77,Default,,0,0,0,,Сол ырғақ, аман бол!
Dialogue: 0,1:31:33.11,1:31:35.90,Default,,0,0,0,,Ол резонанс тудырсын
Dialogue: 0,1:31:35.90,1:31:37.28,Default,,0,0,0,,Жаңғырсын (Сара Наланбаяр) Иә...
Dialogue: 0,1:31:37.70,1:31:45.04,Default,,0,0,0,,Жарақат алудан қорықпа
Dialogue: 0,1:31:45.16,1:31:45.95,Default,,0,0,0,,Жерді тепсең
Dialogue: 0,1:31:45.95,1:31:49.37,Default,,0,0,0,,Мен жерге тигенде (Наланбаялдың дауысы) Барлығы... аман болыңдар...
Dialogue: 0,1:31:49.54,1:31:52.71,Default,,0,0,0,,Ұшу кезінде
Dialogue: 0,1:31:52.84,1:31:56.67,Default,,0,0,0,,Жаңаға сену
Dialogue: 0,1:31:56.80,1:32:00.64,Default,,0,0,0,,Жолсыз жолмен саяхаттау
Dialogue: 0,1:32:00.76,1:32:05.81,Default,,0,0,0,,Ол жерге біз ғана жетеміз
Dialogue: 0,1:32:05.93,1:32:08.56,Default,,0,0,0,,Жаңа әлем
Dialogue: 0,1:32:08.73,1:32:13.07,Default,,0,0,0,,(Оны ешкім тартып ала алмайды)
Dialogue: 0,1:32:13.19,1:32:16.53,Default,,0,0,0,,Жүрегімде бір тілек
Dialogue: 0,1:32:16.65,1:32:20.95,Default,,0,0,0,,(жыртылмаған)
Dialogue: 0,1:32:21.07,1:32:24.83,Default,,0,0,0,,Армандарды байланыстыру
Dialogue: 0,1:32:25.04,1:32:32.50,Default,,0,0,0,,Жүрегімді тербеткен жел жақында келеді
Dialogue: 0,1:32:33.00,1:32:39.88,Default,,0,0,0,,Ойларыңызды біріктіріп, құйрықты желге айналыңыз
Dialogue: 0,1:32:40.43,1:32:44.01,Default,,0,0,0,,Жаңаға сену
Dialogue: 0,1:32:44.43,1:32:48.18,Default,,0,0,0,,Жолсыз жолмен жүру
Dialogue: 0,1:32:48.81,1:32:52.40,Default,,0,0,0,,Болашаққа жүгір
Dialogue: 0,1:32:52.52,1:32:55.44,Default,,0,0,0,,Жаңа әлемге жету
Dialogue: 0,1:32:55.61,1:32:56.94,Default,,0,0,0,,(Екі адам ауыр тыныс алуда)
Dialogue: 0,1:32:57.07,1:33:01.20,Default,,0,0,0,,Мұндағы баспалдақта басқа пішінді бір терезе болуы керек!
Dialogue: 0,1:33:01.45,1:33:02.86,Default,,0,0,0,,Түрлі пішінді терезелер!!
Dialogue: 0,1:33:02.99,1:33:04.70,Default,,0,0,0,,Жақын жерде құрылғы бар!
Dialogue: 0,1:33:04.83,1:33:06.45,Default,,0,0,0,,О, қайда!?
Dialogue: 0,1:33:10.04,1:33:10.96,Default,,0,0,0,,Міне!
Dialogue: 0,1:33:13.25,1:33:14.46,Default,,0,0,0,,Алаяқ
Dialogue: 0,1:33:20.51,1:33:23.39,Default,,0,0,0,,Наланбаяр мырза, бұл жерде олқылық бар!!
Dialogue: 0,1:33:26.35,1:33:27.51,Default,,0,0,0,,Хмм...
Dialogue: 0,1:33:28.97,1:33:30.14,Default,,0,0,0,,Хмм...
Dialogue: 0,1:33:30.35,1:33:32.14,Default,,0,0,0,,(жеңіл дыбыс)
Dialogue: 0,1:33:36.73,1:33:37.73,Default,,0,0,0,,Міне!
Dialogue: 0,1:33:38.48,1:33:40.61,Default,,0,0,0,,Хмм... уф...
Dialogue: 0,1:33:44.41,1:33:46.41,Default,,0,0,0,,ал үшінші және төртінші метакарпальды сүйектері мен саусақ сақина мен ортаңғы саусағымның проксимальды фалангаларында
Dialogue: 0,1:33:47.99,1:33:49.62,Default,,0,0,0,,Бас тартпаңыз!
Dialogue: 0,1:33:52.21,1:33:53.29,Default,,0,0,0,,Жас ханым?
Dialogue: 0,1:33:53.87,1:33:56.54,Default,,0,0,0,,Мен саған көмектесемін, келемін.
Dialogue: 0,1:33:56.67,1:33:57.67,Default,,0,0,0,,Иә
Dialogue: 0,1:33:57.88,1:33:59.00,Default,,0,0,0,,(Екі адамның ауыр дауысы)
Dialogue: 0,1:34:03.22,1:34:04.26,Default,,0,0,0,,Уау (Сара) Ахх
Dialogue: 0,1:34:18.40,1:34:20.82,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,1:34:47.14,1:34:49.01,Default,,0,0,0,,
Dialogue: 0,1:34:51.60,1:34:53.56,Default,,0,0,0,,Кеттік, жас ханым.
Dialogue: 0,1:34:53.98,1:34:57.69,Default,,0,0,0,,А... жоқ, мен...
Dialogue: 0,1:34:58.81,1:35:03.90,Default,,0,0,0,,Менімен бірге барсаң, өткел құлап кетуі мүмкін.
Dialogue: 0,1:35:06.91,1:35:08.32,Default,,0,0,0,,Наланбаял мырза
Dialogue: 0,1:35:10.41,1:35:11.49,Default,,0,0,0,,Барыңыз...
Dialogue: 0,1:35:15.75,1:35:16.75,Default,,0,0,0,,Наланбаяр мырза...
Dialogue: 0,1:35:18.58,1:35:20.09,Default,,0,0,0,,Барыңыз
Dialogue: 0,1:35:20.75,1:35:26.01,Default,,0,0,0,,Жас келіншек ру басшысымен ішімдік ішу жарысында!? Ол бәсекелестікке жатпайды...
Dialogue: 0,1:35:27.05,1:35:28.64,Default,,0,0,0,,Неліктен бұл?!
Dialogue: 0,1:35:28.76,1:35:33.56,Default,,0,0,0,,Себебі бастық сіз туралы жаман сөздер айтты.
Dialogue: 0,1:35:36.18,1:35:37.06,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,1:35:37.19,1:35:38.06,Default,,0,0,0,,Иә?
Dialogue: 0,1:35:41.90,1:35:45.94,Default,,0,0,0,,Қызыңызды енді ешқашан тастамаңыз.
Dialogue: 0,1:35:52.12,1:35:53.83,Default,,0,0,0,,Егер құлап қалсаңыз...
Dialogue: 0,1:35:55.33,1:35:56.96,Default,,0,0,0,,Ендеше бірге құлайық
Dialogue: 0,1:36:09.63,1:36:10.84,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:36:12.22,1:36:15.97,Default,,0,0,0,,Мен және жас ханым ешқашан құламаймыз.
Dialogue: 0,1:36:18.89,1:36:19.98,Default,,0,0,0,,Кеттік
Dialogue: 0,1:36:25.32,1:36:26.32,Default,,0,0,0,,Біз-
Dialogue: 0,1:36:28.99,1:36:32.45,Default,,0,0,0,,Егер сіз осы жерден өтсеңіз...
Dialogue: 0,1:36:35.99,1:36:38.41,Default,,0,0,0,,Король қазір қайда?
Dialogue: 0,1:36:38.54,1:36:39.71,Default,,0,0,0,,Күте тұрыңыз (Нарамбайал Сала) Иә?
Dialogue: 0,1:36:42.08,1:36:44.96,Default,,0,0,0,,Бұл жерден кету оңай деп ойладың ба?
Dialogue: 0,1:36:45.71,1:36:46.88,Default,,0,0,0,,Әке...
Dialogue: 0,1:36:47.42,1:36:49.97,Default,,0,0,0,,Әке? Яғни...
Dialogue: 0,1:36:50.55,1:36:52.09,Default,,0,0,0,,Раставан III?
Dialogue: 0,1:36:53.05,1:36:54.60,Default,,0,0,0,,Мені бұл атпен атама!
Dialogue: 0,1:36:55.01,1:36:56.06,Default,,0,0,0,,Уау!?
Dialogue: 0,1:36:57.60,1:37:01.44,Default,,0,0,0,,Уф... Раставан II сияқты...
Dialogue: 0,1:37:01.56,1:37:07.03,Default,,0,0,0,,Жүздеген жылдар бойы түкке тұрғысыз патша болып атымды қалдыра алмаймын...
Dialogue: 0,1:37:07.36,1:37:10.78,Default,,0,0,0,,Не? Раставан II-ге не болды?
Dialogue: 0,1:37:11.20,1:37:13.74,Default,,0,0,0,,Байқарға айтар сөзім жоқ!
Dialogue: 0,1:37:13.87,1:37:14.99,Default,,0,0,0,,Уау!!
Dialogue: 0,1:37:15.99,1:37:17.70,Default,,0,0,0,,Әке, сабыр етіңіз!
Dialogue: 0,1:37:18.20,1:37:20.12,Default,,0,0,0,,Наланбаял мырза, кеттік!
Dialogue: 0,1:37:20.62,1:37:22.75,Default,,0,0,0,,Сіз де...!
Dialogue: 0,1:37:25.88,1:37:27.30,Default,,0,0,0,,Сіз кетесіз бе?
Dialogue: 0,1:37:27.42,1:37:28.67,Default,,0,0,0,,Ха!
Dialogue: 0,1:37:29.38,1:37:30.63,Default,,0,0,0,,Әке...
Dialogue: 0,1:37:30.80,1:37:31.97,Default,,0,0,0,,Ах...
Dialogue: 0,1:37:34.93,1:37:37.76,Default,,0,0,0,,Ей, Байқаридың күйеу баласы.
Dialogue: 0,1:37:40.56,1:37:45.65,Default,,0,0,0,,Егер сіз шынымен Байкаридегі ең ақылды адам болсаңыз...
Dialogue: 0,1:37:46.73,1:37:50.65,Default,,0,0,0,,Түсіндің бе? Марқұм патша
Dialogue: 0,1:37:50.78,1:37:54.16,Default,,0,0,0,,Неліктен менің атымды «Растабан» деп қойдыңыз?
Dialogue: 0,1:37:56.83,1:37:58.45,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,1:37:59.95,1:38:01.16,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,1:38:02.75,1:38:07.42,Default,,0,0,0,,Раставан III... қызының әкесі...
Dialogue: 0,1:38:08.30,1:38:11.38,Default,,0,0,0,,Ал Архамит патшасы...
Dialogue: 0,1:38:11.80,1:38:16.22,Default,,0,0,0,,Осы жерде өлсең, енді ешқашан дипломатиялық қатынас болмайды.
Dialogue: 0,1:38:16.72,1:38:18.05,Default,,0,0,0,,Қазір-
Dialogue: 0,1:38:18.18,1:38:21.73,Default,,0,0,0,,Осы кісіні сілкіп тастап, Патшайым сарайына жетсек
Dialogue: 0,1:38:23.14,1:38:28.19,Default,,0,0,0,,Әлхамит пен Байқари Екі елдің бөлінуін болдырмауға болады...
Dialogue: 0,1:38:28.32,1:38:31.90,Default,,0,0,0,,Екі елдің болашағы екеуіңе байланысты.
Dialogue: 0,1:38:32.03,1:38:33.24,Default,,0,0,0,,Мен оны сұрадым!
Dialogue: 0,1:38:33.78,1:38:38.78,Default,,0,0,0,,Бүгін бізге тек қашу керек...
Dialogue: 0,1:38:39.78,1:38:41.79,Default,,0,0,0,,Бірақ содан кейін...
Dialogue: 0,1:38:43.16,1:38:46.83,Default,,0,0,0,,Тағы бір күні... Әлхамит пен Байқари...
Dialogue: 0,1:38:54.76,1:38:55.59,Default,,0,0,0,,(Наланбаяр ентігіп)
Dialogue: 0,1:38:57.93,1:39:01.85,Default,,0,0,0,,Әрқашан қиынырақ жолды таңдаңыз
Dialogue: 0,1:39:06.60,1:39:09.90,Default,,0,0,0,,Жас ханым... Мен...
Dialogue: 0,1:39:22.16,1:39:24.45,Default,,0,0,0,,Дұрыс, патша.
Dialogue: 0,1:39:25.29,1:39:28.29,Default,,0,0,0,,«Раставан» «айдаһар басы» дегенді білдіреді
Dialogue: 0,1:39:28.42,1:39:34.05,Default,,0,0,0,,Бұл елді дәу айдаһардай біріктіретін құдіреті барлар ғана
Dialogue: 0,1:39:34.26,1:39:36.47,Default,,0,0,0,,Атын бермегендіктен шығар.
Dialogue: 0,1:39:40.60,1:39:44.60,Default,,0,0,0,,1000 жыл бұрыннан келе жатқан жауластық.
Dialogue: 0,1:39:44.72,1:39:49.10,Default,,0,0,0,,Екінші ұрпақты өз елінде ақымақ деп атауға болады.
Dialogue: 0,1:39:49.23,1:39:51.86,Default,,0,0,0,,Тарихта жалғыз елім
Dialogue: 0,1:39:51.98,1:39:56.40,Default,,0,0,0,,Ол оқиғаны түсінетін Архамит патшасы ретінде жоғары бағаланады.
Dialogue: 0,1:39:57.36,1:40:02.08,Default,,0,0,0,,Шындығында, ол патшалық кезінде өте жақсы көрген сияқты.
Dialogue: 0,1:40:02.20,1:40:04.49,Default,,0,0,0,,Портрет жақсы жасалған.
Dialogue: 0,1:40:04.91,1:40:09.12,Default,,0,0,0,,Абырой мен толеранттылыққа толы ол идеалды монарх.
Dialogue: 0,1:40:09.25,1:40:13.17,Default,,0,0,0,,Егер оны шынымен менсініп, менсінбесе, олай бейнелемес еді.
Dialogue: 0,1:40:13.29,1:40:17.51,Default,,0,0,0,,Әрине, кейіннен жоғарыдан қайта сызылған болар еді.
Dialogue: 0,1:40:17.84,1:40:19.68,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,1:40:20.84,1:40:22.14,Default,,0,0,0,,Не болып жатыр өзі?
Dialogue: 0,1:40:22.26,1:40:25.77,Default,,0,0,0,,Раставан III II-ді «тіпті» алмады.
Dialogue: 0,1:40:26.27,1:40:28.77,Default,,0,0,0,,Неліктен Байкаримен дипломатиялық қатынас ашпасқа?
Dialogue: 0,1:40:28.89,1:40:30.19,Default,,0,0,0,,Уф...
Dialogue: 0,1:40:30.85,1:40:33.23,Default,,0,0,0,,Ха, нені бөлдің...
Dialogue: 0,1:40:33.36,1:40:36.69,Default,,0,0,0,,Жоқ жоқ, енді сіздің мүмкіндігіңіз!
Dialogue: 0,1:40:36.82,1:40:41.20,Default,,0,0,0,,Осыдан 50 жыл бұрынғы соғыстың кесірінен Байқаридың ұлттық күші қалпына келе қойған жоқ.
Dialogue: 0,1:40:41.41,1:40:45.87,Default,,0,0,0,,Олай болса, қазір Байқариға шабуыл жасау үшін жақсы уақыт болар еді.
Dialogue: 0,1:40:45.99,1:40:47.62,Default,,0,0,0,,Жоқ, керісінше.
Dialogue: 0,1:40:47.87,1:40:48.87,Default,,0,0,0,,Не?
Dialogue: 0,1:40:49.25,1:40:52.63,Default,,0,0,0,,Дипломатиялық қатынастарды ашып, инфрақұрылымды жақсарту
Dialogue: 0,1:40:52.75,1:40:57.01,Default,,0,0,0,,Байқаридан Әлхамитке дейін елді жайлаған су жолын саламыз.
Dialogue: 0,1:40:57.76,1:40:58.76,Default,,0,0,0,,Не!?
Dialogue: 0,1:40:59.34,1:41:01.34,Default,,0,0,0,,Су барша, Әлхамит
Dialogue: 0,1:41:01.47,1:41:05.72,Default,,0,0,0,,Халық 1000 жыл немесе ондаған мың жылдар бойы молшылықта өркендей алады.
Dialogue: 0,1:41:05.85,1:41:07.72,Default,,0,0,0,,Егер бұл шешілсе
Dialogue: 0,1:41:08.10,1:41:11.44,Default,,0,0,0,,Соғыс кезінде екі елдің де бірінші кезекте зардап шегуінің қажеті жоқ.
Dialogue: 0,1:41:11.56,1:41:13.40,Default,,0,0,0,,Оны еш жерден табу мүмкін емес!!
Dialogue: 0,1:41:14.23,1:41:18.78,Default,,0,0,0,,Бұл елдің әсем табиғатын қорғағысы келетіндер көп.
Dialogue: 0,1:41:18.90,1:41:20.40,Default,,0,0,0,,Патша біледі, солай ма?
Dialogue: 0,1:41:21.65,1:41:26.24,Default,,0,0,0,,Есіңізде түкке тұрғысыз патша ретінде қалғыңыз келмейтінін айттыңыз.
Dialogue: 0,1:41:26.53,1:41:29.00,Default,,0,0,0,,Тек қазір...
Dialogue: 0,1:41:29.12,1:41:33.00,Default,,0,0,0,,Байкаримен келіссөздер жүргізетін орынды орнату туралы не айтасыз?
Dialogue: 0,1:41:33.46,1:41:39.21,Default,,0,0,0,,Белгісіздердің арасынан осы елдің негізін салған Раставан I басшылығы.
Dialogue: 0,1:41:39.92,1:41:45.18,Default,,0,0,0,,II Раставан толеранттылығы үшін халқына ұнады.
Dialogue: 0,1:41:45.47,1:41:50.06,Default,,0,0,0,,Ал әл-Хамит тарихы осы екеуін біріктіреді.
Dialogue: 0,1:41:50.18,1:41:54.60,Default,,0,0,0,,Раставан III барлық уақыттағы ең үлкен ерлік жасады.
Dialogue: 0,1:41:54.73,1:41:56.31,Default,,0,0,0,,Жаңа атау қалдыру...
Dialogue: 0,1:41:56.86,1:42:02.20,Default,,0,0,0,,Елді байланыстыратын су арнасына әйеліңіздің немесе қызыңыздың есімін қойсаңыз болғаны.
Dialogue: 0,1:42:02.32,1:42:05.57,Default,,0,0,0,,«Отбасыға бағытталған» медальдар саны көбейе ме?
Dialogue: 0,1:42:09.66,1:42:10.75,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,1:42:11.20,1:42:16.50,Default,,0,0,0,,Әйелім мен қызым... енді олар маған ақымақ сияқты қарайды.
Dialogue: 0,1:42:16.71,1:42:18.25,Default,,0,0,0,,тым кеш...
Dialogue: 0,1:42:20.00,1:42:21.26,Default,,0,0,0,,Бұл...
Dialogue: 0,1:42:22.76,1:42:25.13,Default,,0,0,0,,Өтінемін, қайғылы сөздер айтпаңыз.
Dialogue: 0,1:42:26.18,1:42:30.85,Default,,0,0,0,,Әлхамиттің Байқариға әйелінің орнына мысық жібергенін естігенде.
Dialogue: 0,1:42:31.18,1:42:32.56,Default,,0,0,0,,Тек бір адам
Dialogue: 0,1:42:32.68,1:42:37.15,Default,,0,0,0,,Әкесі соншалықты ұятсыз емес деп бір қызы сенді.
Dialogue: 0,1:42:37.98,1:42:39.27,Default,,0,0,0,,Мен қазір осында болсам да!
Dialogue: 0,1:42:39.52,1:42:40.53,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:42:40.90,1:42:41.94,Default,,0,0,0,,Иә?
Dialogue: 0,1:42:43.19,1:42:44.78,Default,,0,0,0,,Бұл Одончимег.
Dialogue: 0,1:42:45.03,1:42:49.45,Default,,0,0,0,,Архамиттің сұлу әйелі Бұл Одончимег.
Dialogue: 0,1:42:49.58,1:42:51.16,Default,,0,0,0,,Әкеңнен естідің ғой, солай ма?
Dialogue: 0,1:42:53.08,1:42:55.58,Default,,0,0,0,,Әке, патша...
Dialogue: 0,1:42:55.71,1:43:01.38,Default,,0,0,0,,Байқариды «әдемі қыз» емес, бір құлағы қара мысық жібергенін айтты.
Dialogue: 0,1:43:01.59,1:43:05.26,Default,,0,0,0,,Белгілі бір себептермен көпшіліктің алдына шыға алмаймын.
Dialogue: 0,1:43:07.72,1:43:11.85,Default,,0,0,0,,Наланбаял мырза, сіз үйленбегенсіз бе?
Dialogue: 0,1:43:11.97,1:43:14.31,Default,,0,0,0,,А... дұрыс, бұл мысық.
Dialogue: 0,1:43:14.43,1:43:16.90,Default,,0,0,0,,Күткендей, мен мұны істей алмаймын...
Dialogue: 0,1:43:26.95,1:43:28.36,Default,,0,0,0,,Жақсы...
Dialogue: 0,1:43:30.87,1:43:33.66,Default,,0,0,0,,Сенің әкең патша...
Dialogue: 0,1:43:36.58,1:43:38.75,Default,,0,0,0,,Жақсы...
Dialogue: 0,1:43:40.38,1:43:41.67,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,1:43:50.76,1:43:52.14,Default,,0,0,0,,Жас ханым
Dialogue: 0,1:43:52.43,1:43:57.48,Default,,0,0,0,,Мен жай ғана ақымақпын, сондықтан өзіме не ыңғайлы болса, соны аламын!
Dialogue: 0,1:43:58.60,1:43:59.90,Default,,0,0,0,,Ол мені осы күйімде көрмесін деп, батыл болып көрінуге барынша тырысып жүрмін
Dialogue: 0,1:44:00.61,1:44:02.57,Default,,0,0,0,,Дегенмен, ол шын мәнінде аристократ. Өте сәнді киінген, иә?
Dialogue: 0,1:44:05.23,1:44:07.40,Default,,0,0,0,,Ой, бұл қай жер!?
Dialogue: 0,1:44:07.95,1:44:09.91,Default,,0,0,0,,Патша
Dialogue: 0,1:44:11.82,1:44:15.20,Default,,0,0,0,,Сіз осындасыз ба? өте өкінішті!
Dialogue: 0,1:44:15.37,1:44:18.87,Default,,0,0,0,,Байқаридың күйеу баласының қайда екені әлі белгісіз!
Dialogue: 0,1:44:19.00,1:44:22.38,Default,,0,0,0,,Олай болса мен қызыммен бірге боламын.
Dialogue: 0,1:44:22.54,1:44:23.38,Default,,0,0,0,,Иә?
Dialogue: 0,1:44:23.67,1:44:26.88,Default,,0,0,0,,Күйеуі мен әйелін сыйлап әкеліңіз.
Dialogue: 0,1:44:27.01,1:44:30.47,Default,,0,0,0,,Пилипаппа жиналыста ма? Мен де шығамын.
Dialogue: 0,1:44:30.64,1:44:31.84,Default,,0,0,0,,Түсінікті!
Dialogue: 0,1:44:31.97,1:44:44.65,Default,,0,0,0,,♪ Қанат алмасатын құстар сияқты
Dialogue: 0,1:44:44.77,1:44:55.74,Default,,0,0,0,,Қолды ақырын және қатты ұстаңыз
Dialogue: 0,1:44:55.87,1:45:07.92,Default,,0,0,0,,Жаяу
Dialogue: 0,1:45:23.77,1:45:25.44,Default,,0,0,0,,Басшы
Dialogue: 0,1:45:25.57,1:45:28.69,Default,,0,0,0,,Бұл күн де келді.
Dialogue: 0,1:45:29.44,1:45:31.20,Default,,0,0,0,,Біз жақында патша астанасына жетеміз.
Dialogue: 0,1:45:32.86,1:45:36.83,Default,,0,0,0,,Солай болса да, бұл тақыр жер көзге көрінетіндей созылып жатыр.
Dialogue: 0,1:45:36.99,1:45:41.21,Default,,0,0,0,,Бұл қандай сирек кездесетін коммерциялық ұлт? Бұл бір кесек торттан басқа ештеңе емес!
Dialogue: 0,1:45:41.62,1:45:43.88,Default,,0,0,0,,Аяқтарыңызға қарайық!!
Dialogue: 0,1:45:44.13,1:45:45.88,Default,,0,0,0,,Қандай кездесу!!
Dialogue: 0,1:45:46.04,1:45:50.21,Default,,0,0,0,,Көп сөйлесең, соғыс болады!!
Dialogue: 0,1:45:50.63,1:45:52.22,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,1:45:55.30,1:45:57.22,Default,,0,0,0,,Сонымен бірге ол фонды да бір уақытта салып жатыр!
Dialogue: 0,1:46:00.22,1:46:02.27,Default,,0,0,0,,Басшы (барлығы) Ах...
Dialogue: 0,1:46:02.56,1:46:05.90,Default,,0,0,0,,Танысқаныма қуаныштымын, танысқаныма қуаныштымын.
Dialogue: 0,1:46:06.36,1:46:10.78,Default,,0,0,0,,Патша сізді жоғарыда күтіп тұр. «Жылжымалы жәшікке» кіріңіз.
Dialogue: 0,1:46:12.24,1:46:14.11,Default,,0,0,0,,«Жылжымалы қорап»?
Dialogue: 0,1:46:19.16,1:46:23.04,Default,,0,0,0,,Бұл не!? Аспанға қалай көтерілді!?
Dialogue: 0,1:46:23.21,1:46:25.54,Default,,0,0,0,,Иә!? Ха!
Dialogue: 0,1:46:26.21,1:46:30.80,Default,,0,0,0,,Мүлдем! Ханшайымның шпион болғаны шектен шықты!!
Dialogue: 0,1:46:30.92,1:46:36.55,Default,,0,0,0,,Хмм... Бірақ сол оқиғадан кейін патшаның бас ауруы басылды...
Dialogue: 0,1:46:36.68,1:46:38.89,Default,,0,0,0,,Ал бұл басқа әңгіме!!
Dialogue: 0,1:46:39.31,1:46:42.77,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,1:46:43.06,1:46:44.56,Default,,0,0,0,,(Әже келісіп басын изеді)
Dialogue: 0,1:46:44.69,1:46:45.98,Default,,0,0,0,,
Dialogue: 0,1:46:48.56,1:46:50.48,Default,,0,0,0,,Мориё қаласы дейсіз бе? Хмм…
Dialogue: 0,1:46:50.61,1:46:52.44,Default,,0,0,0,,Бастық! (Барлығы) иә?
Dialogue: 0,1:46:52.78,1:46:54.45,Default,,0,0,0,,Біраз уақыт өтті!
Dialogue: 0,1:46:55.49,1:46:56.66,Default,,0,0,0,,Иә?
Dialogue: 0,1:46:56.78,1:46:58.20,Default,,0,0,0,,Нихихихихи…
Dialogue: 0,1:46:58.99,1:47:01.20,Default,,0,0,0,,Сіз кімсіз! Бұл өте таныс!
Dialogue: 0,1:47:02.87,1:47:06.62,Default,,0,0,0,,Сәлем! Бұл Наланбаяр! Санчардың ұлы!!
Dialogue: 0,1:47:07.00,1:47:07.92,Default,,0,0,0,,Ах...
Dialogue: 0,1:47:08.04,1:47:11.63,Default,,0,0,0,,Иә? сен неге мұндасың
Dialogue: 0,1:47:12.00,1:47:16.88,Default,,0,0,0,,Жоқ, мен патшаның күйеу баласымын, сондықтан мені арнайы шақырды.
Dialogue: 0,1:47:17.22,1:47:19.14,Default,,0,0,0,,Қызым? Күйеу бала?
Dialogue: 0,1:47:19.26,1:47:21.89,Default,,0,0,0,,Бұл алыс
Dialogue: 0,1:47:24.31,1:47:26.89,Default,,0,0,0,,Иә! Мына қыз!?
Dialogue: 0,1:47:28.98,1:47:33.32,Default,,0,0,0,,Әлхамит патша өзінің сүйікті ханшайымына қамқор болды.
Dialogue: 0,1:47:33.44,1:47:35.11,Default,,0,0,0,,Мен оны әйеліме бердім.
Dialogue: 0,1:47:36.53,1:47:38.99,Default,,0,0,0,,Бұл стильді емес пе? (Сара) Хехе...
Dialogue: 0,1:47:40.12,1:47:42.87,Default,,0,0,0,,Иә? Бастық? Сіз тыңдайсыз ба?
Dialogue: 0,1:47:42.99,1:47:44.75,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,1:47:46.00,1:47:47.00,Default,,0,0,0,,Ханшайым!?
Dialogue: 0,1:47:50.00,1:47:53.46,Default,,0,0,0,,Бас Байкари Одуни Орду
Dialogue: 0,1:47:53.59,1:47:56.92,Default,,0,0,0,,Мен толеранттылық патшасымын, Раставан III
Dialogue: 0,1:47:57.05,1:47:59.84,Default,,0,0,0,,Біздің елге күшік жіберу...
Dialogue: 0,1:47:59.97,1:48:02.93,Default,,0,0,0,,Иә!? (Растабан ІІІ) Сумен шайылғандықтан...
Dialogue: 0,1:48:05.77,1:48:11.73,Default,,0,0,0,,Бұдан былай еліміздің жақсы досы бол.
Dialogue: 0,1:48:21.12,1:48:26.91,Default,,0,0,0,,Әй, қайық қайық қайықсыз көтеріле алатын өзенде қайта жүзеді?
Dialogue: 0,1:48:27.37,1:48:30.00,Default,,0,0,0,,Мен сенімдімін... 50 жылдан кейін...
Dialogue: 0,1:48:30.75,1:48:32.42,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:48:33.50,1:48:36.42,Default,,0,0,0,,Мен сенімен ондаған жылдардан кейін де еріп барамын.
Dialogue: 0,1:48:36.55,1:48:37.92,Default,,0,0,0,,Леополдин
Dialogue: 0,1:48:38.93,1:48:41.64,Default,,0,0,0,,Енді нақты нәрсеге уақыт келді.
Dialogue: 0,1:48:41.97,1:48:42.97,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:48:43.10,1:48:45.43,Default,,0,0,0,,Талқылау Жақсы өтеді деп үміттенемін.
Dialogue: 0,1:48:46.10,1:48:49.44,Default,,0,0,0,,Алғашында көп нәрсені күтпеген дұрыс.
Dialogue: 0,1:48:49.56,1:48:50.81,Default,,0,0,0,,Махаббат та, махаббатсыз неке де
Dialogue: 0,1:48:52.06,1:48:54.32,Default,,0,0,0,,Тезірек үйге қайтайық?
Dialogue: 0,1:48:54.61,1:48:56.48,Default,,0,0,0,,Дұрыс айтасың баая.
Dialogue: 0,1:48:59.57,1:49:01.66,Default,,0,0,0,,Олай болса, алдымен мен үйге барайын.
Dialogue: 0,1:49:02.28,1:49:05.16,Default,,0,0,0,,Иә, мен кешкі асты осында ішемін.
Dialogue: 0,1:49:05.66,1:49:09.66,Default,,0,0,0,,Бүгін де бәріміз жұлдыздарға қарап күтеміз.
Dialogue: 0,1:49:13.79,1:49:15.00,Default,,0,0,0,,Хэхе…
Dialogue: 0,1:49:17.59,1:49:19.63,Default,,0,0,0,,Мен бірден қайтамын.
Dialogue: 0,1:49:22.84,1:49:24.18,Default,,0,0,0,,Осы аралдағы шайтандар…
Dialogue: 0,1:49:49.91,1:49:52.33,Default,,0,0,0,,Әке, қарныңыз ашты ма?
Dialogue: 0,1:49:52.79,1:49:55.84,Default,,0,0,0,,Жақында түскі ас әкелейін.
Dialogue: 0,1:49:56.13,1:49:57.75,Default,,0,0,0,,Сіз қалай ойлайсыз? Мен оны арзан ұстаймын
Dialogue: 0,1:49:57.88,1:49:58.84,Default,,0,0,0,,Олай болса.
Dialogue: 0,1:49:58.96,1:50:00.84,Default,,0,0,0,,Жарайды, кеттік, Сено.
Dialogue: 0,1:50:03.13,1:50:04.47,Default,,0,0,0,,Сәлем Сафра
Dialogue: 0,1:50:04.80,1:50:08.43,Default,,0,0,0,,Келесі жолы Улин апай мені ыстық бұлаққа апарады.
Dialogue: 0,1:50:08.56,1:50:09.47,Default,,0,0,0,,Қашан?
Dialogue: 0,1:50:09.68,1:50:11.02,Default,,0,0,0,,Мен қашан деп ойлаймын
Dialogue: 0,1:50:11.56,1:50:14.81,Default,,0,0,0,,Хмм хаха!
Dialogue: 0,1:50:14.94,1:50:17.15,Default,,0,0,0,,Енді, Құрылыс министрі Әзиз мырза.
Dialogue: 0,1:50:17.32,1:50:19.98,Default,,0,0,0,,Мен Байқаридың сәулет өнерін тамашалауға барамын.
Dialogue: 0,1:50:20.15,1:50:21.86,Default,,0,0,0,,Мүмкін сол алып кеткеннен кейін
Dialogue: 0,1:50:23.86,1:50:26.37,Default,,0,0,0,,Саладин-санның пьесасын қашан көруге болады?
Dialogue: 0,1:50:26.53,1:50:28.37,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:50:28.53,1:50:29.58,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:50:29.74,1:50:32.41,Default,,0,0,0,,Тіпті анаң билет қиын дейді.
Dialogue: 0,1:50:33.75,1:50:36.50,Default,,0,0,0,,Бірақ менің әжем қолдау тобында.
Dialogue: 0,1:50:36.67,1:50:37.84,Default,,0,0,0,,Мен бара аламын.
Dialogue: 0,1:50:38.13,1:50:39.17,Default,,0,0,0,,Кеттік
Dialogue: 0,1:50:40.34,1:50:43.34,Default,,0,0,0,,Мен әкеңіздің жұмыс орнына жақында келдім.
Dialogue: 0,1:50:43.47,1:50:47.60,Default,,0,0,0,,Шаштары қураған жапырақтардың түсіне ұқсас адам, оны жақсы деп ойламайсыз ба?
Dialogue: 0,1:50:47.72,1:50:50.10,Default,,0,0,0,,Не? Мен оны көрген жоқпын
Dialogue: 0,1:51:08.53,1:51:11.29,Default,,0,0,0,,Әй, анаң да осында!
Dialogue: 0,1:51:11.41,1:51:12.58,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:51:45.74,1:51:55.58,Default,,0,0,0,,♪ Ақшыл түс сияқты
Dialogue: 0,1:51:56.41,1:52:05.51,Default,,0,0,0,,Ағаштарды сүзіп өткен күн сәулелері
Dialogue: 0,1:52:07.22,1:52:11.68,Default,,0,0,0,,Көрінетін пейзаж
Dialogue: 0,1:52:12.30,1:52:24.11,Default,,0,0,0,,Толқу түс қосады
Dialogue: 0,1:52:26.99,1:52:36.33,Default,,0,0,0,,Ақырын қол созып, түртіңіз
Dialogue: 0,1:52:37.25,1:52:45.63,Default,,0,0,0,,Мақта сияқты сезіну
Dialogue: 0,1:52:46.26,1:53:05.15,Default,,0,0,0,,(мыл)
Dialogue: 0,1:53:05.27,1:53:11.74,Default,,0,0,0,,(аа ммм)
Dialogue: 0,1:53:13.45,1:53:18.70,Default,,0,0,0,,Жұмсақ ескерту
Dialogue: 0,1:53:19.21,1:53:27.46,Default,,0,0,0,,Кенет байқадым
Dialogue: 0,1:53:29.47,1:53:32.34,Default,,0,0,0,,тілек
Dialogue: 0,1:53:32.55,1:53:41.89,Default,,0,0,0,,Гүлдер, ағаштар, құстар
Dialogue: 0,1:53:42.69,1:53:50.65,Default,,0,0,0,,Жаңа әлем
Dialogue: 0,1:54:02.41,1:54:06.21,Default,,0,0,0,,Хора
Dialogue: 0,1:54:11.88,1:54:18.76,Default,,0,0,0,,Қазір басталады
Dialogue: 0,1:54:23.35,1:54:35.03,Default,,0,0,0,,Толық айдың тамшылары
Dialogue: 0,1:54:36.32,1:54:46.67,Default,,0,0,0,,Су бетіне ериді
Dialogue: 0,1:54:49.09,1:55:01.56,Default,,0,0,0,,Толқындар болып таралу
Dialogue: 0,1:55:01.97,1:55:10.98,Default,,0,0,0,,Қарым-қатынас
Dialogue: 0,1:55:17.62,1:55:29.08,Default,,0,0,0,,Менің осында болғаным біртүрлі.
Dialogue: 0,1:55:30.42,1:55:44.73,Default,,0,0,0,,Иә, сіздің көзіңізде
Dialogue: 0,1:55:45.27,1:56:02.66,Default,,0,0,0,,(мм)
Dialogue: 0,1:56:03.74,1:56:16.42,Default,,0,0,0,,Қауырсын алмасатын құстар сияқты
Dialogue: 0,1:56:16.72,1:56:27.23,Default,,0,0,0,,Қолды ақырын және қатты ұстаңыз
Dialogue: 0,1:56:27.81,1:56:38.99,Default,,0,0,0,,Жаяу
Dialogue: 0,1:56:40.49,1:56:46.49,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory