Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:24.19,0:00:28.07,Default,,0,0,0,,(саксофон орындауы)
Dialogue: 0,0:00:32.61,0:00:37.24,Default,,0,0,0,,(Өнімділік)
Dialogue: 0,0:00:37.74,0:00:40.20,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:00:40.29,0:00:41.12,Default,,0,0,0,,Мен…
Dialogue: 0,0:00:42.79,0:00:44.37,Default,,0,0,0,,Аха~
Dialogue: 0,0:00:47.13,0:00:48.42,Default,,0,0,0,,Фу…
Dialogue: 0,0:00:49.13,0:00:52.13,Default,,0,0,0,,Қар дыбысты сіңіреді, сондықтан сіз оны естімейсіз.
Dialogue: 0,0:00:55.55,0:00:59.10,Default,,0,0,0,,Бол... Ойыншы бол
Dialogue: 0,0:00:59.10,0:01:02.18,Default,,0,0,0,,Мен міндетті түрде боламын
Dialogue: 0,0:01:05.35,0:01:08.11,Default,,0,0,0,,Мен әлемдегі ең жақсы джаз ойыншысы боламын
Dialogue: 0,0:01:12.23,0:01:12.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:15.74,0:01:17.82,Default,,0,0,0,,Иә? Сіз де біреусіз бе?
Dialogue: 0,0:01:25.46,0:01:27.79,Default,,0,0,0,,Онда барсам достар болады ма?
Dialogue: 0,0:01:32.46,0:01:34.97,Default,,0,0,0,,Мен бара алатыныма сенімдімін.
Dialogue: 0,0:01:36.34,0:01:37.64,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:01:39.05,0:01:51.27,Default,,0,0,0,,(Ұзын тон)
Dialogue: 0,0:01:52.57,0:01:53.69,Default,,0,0,0,,Әй
Dialogue: 0,0:01:53.78,0:01:59.32,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:02:06.46,0:02:08.42,Default,,0,0,0,,Онда мен келемін.
Dialogue: 0,0:02:08.50,0:02:10.33,Default,,0,0,0,,О, Аяка міне
Dialogue: 0,0:02:10.42,0:02:11.67,Default,,0,0,0,,(Үкідің ұлуы)
Dialogue: 0,0:02:12.25,0:02:14.00,Default,,0,0,0,,Бұл Аякадан
Dialogue: 0,0:02:14.09,0:02:16.30,Default,,0,0,0,,О, онигири! рахмет
Dialogue: 0,0:02:17.47,0:02:18.76,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:02:19.09,0:02:21.72,Default,,0,0,0,,Менен. Онда бірдеңе же.
Dialogue: 0,0:02:22.35,0:02:25.43,Default,,0,0,0,,Маса-нии... Рахмет
Dialogue: 0,0:02:28.31,0:02:29.14,Default,,0,0,0,,Әуе түрмесі!
Dialogue: 0,0:02:29.73,0:02:31.98,Default,,0,0,0,,Бір аптадан кейін қайтып келді.
Dialogue: 0,0:02:32.73,0:02:34.61,Default,,0,0,0,,Ол келмейді (Масаюки) Иә?
Dialogue: 0,0:02:34.69,0:02:37.82,Default,,0,0,0,,Үлкен аға қайтып келмейді.
Dialogue: 0,0:02:56.34,0:02:57.46,Default,,0,0,0,,Фу…
Dialogue: 0,0:03:00.47,0:03:02.51,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:03:05.85,0:03:07.35,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:20.36,0:03:25.37,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:38.17,0:03:40.80,Default,,0,0,0,,Синдзюку 3-чоме қай жерде?
Dialogue: 0,0:03:41.59,0:03:43.34,Default,,0,0,0,,Ех! ұйықтау
Dialogue: 0,0:03:53.98,0:03:55.90,Default,,0,0,0,,Цк, сөмкеңізді қойыңыз.
Dialogue: 0,0:03:55.98,0:03:57.52,Default,,0,0,0,,О, кешіріңіз.
Dialogue: 0,0:03:57.61,0:03:59.53,Default,,0,0,0,,Ах... Кешіріңіз, кешіріңіз.
Dialogue: 0,0:04:10.00,0:04:12.67,Default,,0,0,0,,Хехе, мен бұл жерде істей алмаймын.
Dialogue: 0,0:04:18.63,0:04:19.88,Default,,0,0,0,,Бұл да мүмкін емес.
Dialogue: 0,0:04:21.30,0:04:22.68,Default,,0,0,0,,Ха! Ябе
Dialogue: 0,0:04:24.47,0:04:25.59,Default,,0,0,0,,Я...
Dialogue: 0,0:04:29.06,0:04:30.89,Default,,0,0,0,,Ондабе
Dialogue: 0,0:04:35.19,0:04:36.40,Default,,0,0,0,,Уау...
Dialogue: 0,0:04:38.15,0:04:40.32,Default,,0,0,0,,Неше адам бар?
Dialogue: 0,0:04:43.90,0:04:44.95,Default,,0,0,0,,Я...
Dialogue: 0,0:04:45.45,0:04:46.74,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:04:47.99,0:04:49.54,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:04:51.04,0:04:52.04,Default,,0,0,0,,Ах
Dialogue: 0,0:04:52.12,0:04:54.58,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:04:57.96,0:05:01.71,Default,,0,0,0,,~♪
Dialogue: 0,0:05:01.71,0:05:02.97,Default,,0,0,0,,~♪
Dialogue: 0,0:05:01.71,0:05:02.97,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:05:13.98,0:05:16.85,Default,,0,0,0,,Соңында, Токио
Dialogue: 0,0:05:18.36,0:05:22.07,Default,,0,0,0,,(саксофон орындауы)
Dialogue: 0,0:05:28.12,0:05:30.99,Default,,0,0,0,,
Dialogue: 0,0:05:32.45,0:05:34.00,Default,,0,0,0,,Иә... үлкен!
Dialogue: 0,0:05:34.08,0:05:35.37,Default,,0,0,0,,Йо Тамада
Dialogue: 0,0:05:35.46,0:05:37.33,Default,,0,0,0,,Тайзодан мекен-жайын сұраңыз.
Dialogue: 0,0:05:37.42,0:05:39.38,Default,,0,0,0,,Мектеп бітіру рәсімінен бері болды!
Dialogue: 0,0:05:39.46,0:05:40.67,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:05:41.00,0:05:42.21,Default,,0,0,0,,Хехехе
Dialogue: 0,0:05:42.71,0:05:44.09,Default,,0,0,0,,Мочи Джаз ойнау
Dialogue: 0,0:05:44.17,0:05:45.76,Default,,0,0,0,,Надабена
Dialogue: 0,0:05:45.84,0:05:48.09,Default,,0,0,0,,Сонда бұл жүк қандай?
Dialogue: 0,0:05:49.05,0:05:51.56,Default,,0,0,0,,Өтінемін, Тамада, маған 2-3 күн тұруға рұқсат етіңіз.
Dialogue: 0,0:05:51.64,0:05:52.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:52.81,0:05:55.52,Default,,0,0,0,,...Сіз әдетте келмес бұрын менімен хабарласасыз.
Dialogue: 0,0:05:55.60,0:05:57.35,Default,,0,0,0,,Бұл менің ыңғайлылығым.
Dialogue: 0,0:05:57.69,0:06:00.81,Default,,0,0,0,,Өйткені мен сізбен хабарлассам, сізден бас тартуы мүмкін, солай ма?
Dialogue: 0,0:06:01.15,0:06:03.53,Default,,0,0,0,,Ах...хехе
Dialogue: 0,0:06:04.99,0:06:05.78,Default,,0,0,0,,Енгізу
Dialogue: 0,0:06:06.78,0:06:08.11,Default,,0,0,0,,Рахмет Тамада
Dialogue: 0,0:06:08.20,0:06:09.24,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:06:12.49,0:06:16.04,Default,,0,0,0,,Woohohohoi, мен кәсіпқоймын ба?
Dialogue: 0,0:06:16.12,0:06:19.04,Default,,0,0,0,,Ақырында мен сол пешке үйреніп қалдым.
Dialogue: 0,0:06:20.67,0:06:22.13,Default,,0,0,0,,Итадаясу
Dialogue: 0,0:06:24.34,0:06:25.21,Default,,0,0,0,,Умеебе
Dialogue: 0,0:06:29.64,0:06:31.43,Default,,0,0,0,,Сіз қалай ойлайсыз? Керемет пе?
Dialogue: 0,0:06:31.51,0:06:33.14,Default,,0,0,0,,Хмм... дәмді.
Dialogue: 0,0:06:33.47,0:06:34.35,Default,,0,0,0,,Дабе!
Dialogue: 0,0:06:34.68,0:06:35.60,Default,,0,0,0,,Неке?
Dialogue: 0,0:06:35.97,0:06:36.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:36.89,0:06:38.73,Default,,0,0,0,,Неке болмаса ше?
Dialogue: 0,0:06:38.81,0:06:40.65,Default,,0,0,0,,Олар ғашық па?
Dialogue: 0,0:06:40.73,0:06:42.94,Default,,0,0,0,,Екі апта болды.
Dialogue: 0,0:06:43.02,0:06:45.53,Default,,0,0,0,,Тамада «Жан» тақтаға шықты.
Dialogue: 0,0:06:45.61,0:06:46.99,Default,,0,0,0,,Токиолық сияқты
Dialogue: 0,0:06:47.07,0:06:47.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:48.49,0:06:51.07,Default,,0,0,0,,Токиодан қалағаным – еркіндік
Dialogue: 0,0:06:51.16,0:06:52.45,Default,,0,0,0,,Ал әйел!
Dialogue: 0,0:06:52.53,0:06:55.16,Default,,0,0,0,,Ғажайып гүлдер қалашығының өмірі
Dialogue: 0,0:06:55.24,0:06:58.58,Default,,0,0,0,,Сол үшін мен өзім қалаған мектепке қабылдандым...
Dialogue: 0,0:06:58.66,0:06:59.50,Default,,0,0,0,,Ал дегенмен!
Dialogue: 0,0:06:59.58,0:07:03.50,Default,,0,0,0,,Бірақ күн сайын жаныңда жүргенім тітіркендіргіш...
Dialogue: 0,0:07:03.88,0:07:06.96,Default,,0,0,0,,Сендайдан неге кеттім...
Dialogue: 0,0:07:07.05,0:07:08.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:08.72,0:07:11.26,Default,,0,0,0,,Мен осы ай ішінде бөлме табамын.
Dialogue: 0,0:07:11.34,0:07:14.30,Default,,0,0,0,,Күдікті ғой,-дедім де тайып кеттім...
Dialogue: 0,0:07:14.68,0:07:16.93,Default,,0,0,0,,Күн сайын жалғыз жаттығу жасамаңыз.
Dialogue: 0,0:07:17.02,0:07:18.98,Default,,0,0,0,,Байыппен шешіңіз.
Dialogue: 0,0:07:19.06,0:07:21.19,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:07:21.27,0:07:24.82,Default,,0,0,0,,Жүр, жылы болғанша тамақтан.
Dialogue: 0,0:07:25.23,0:07:26.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:26.98,0:07:30.36,Default,,0,0,0,,Уау, 1K үшін 80 000 иен...
Dialogue: 0,0:07:30.45,0:07:32.70,Default,,0,0,0,,Сендайда үйде тұруға болады.
Dialogue: 0,0:07:32.78,0:07:35.08,Default,,0,0,0,,Өйткені, бұл интернеттегі нарықтық бағамен бірдей.
Dialogue: 0,0:07:36.49,0:07:38.29,Default,,0,0,0,,Уа, 25 000 иен?
Dialogue: 0,0:07:40.62,0:07:42.08,Default,,0,0,0,,Автотұрақ
Dialogue: 0,0:07:43.13,0:07:46.71,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:07:47.34,0:07:50.67,Default,,0,0,0,,Хмм... бұл неше килограмм?
Dialogue: 0,0:07:50.76,0:07:53.14,Default,,0,0,0,,Я... бұл джаз.
Dialogue: 0,0:07:53.47,0:07:55.97,Default,,0,0,0,,Керемет жұмыс! Мен тағы сұраймын
Dialogue: 0,0:07:56.05,0:07:57.06,Default,,0,0,0,,Міне!
Dialogue: 0,0:07:57.47,0:07:59.47,Default,,0,0,0,,Келді, келді, келді!
Dialogue: 0,0:08:02.02,0:08:03.52,Default,,0,0,0,,Гү…!! Уф!! Уф…!!
Dialogue: 0,0:08:03.60,0:08:05.40,Default,,0,0,0,,Тамада...
Dialogue: 0,0:08:05.48,0:08:07.19,Default,,0,0,0,,10 000 ше?
Dialogue: 0,0:08:07.27,0:08:09.99,Default,,0,0,0,,Олай болса ертең Токиода джаз.
Dialogue: 0,0:08:21.21,0:08:25.96,Default,,0,0,0,,(қатты қорылдау)
Dialogue: 0,0:08:26.04,0:08:27.25,Default,,0,0,0,,Шулы
Dialogue: 0,0:08:31.34,0:08:33.43,Default,,0,0,0,,Әй, үлкен!
Dialogue: 0,0:08:35.09,0:08:35.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:38.01,0:08:39.18,Default,,0,0,0,,Осылай жалғаса берсе, бұл тағдыр ғой, иә?
Dialogue: 0,0:08:39.26,0:08:42.02,Default,,0,0,0,,Мен сені бүгін кешіре аламын ба?
Dialogue: 0,0:08:42.10,0:08:43.44,Default,,0,0,0,,Джаз…
Dialogue: 0,0:09:09.04,0:09:10.67,Default,,0,0,0,,Мұнда не істеу керек?
Dialogue: 0,0:09:14.97,0:09:17.39,Default,,0,0,0,,(бейсбол таратылатын дыбыс)
Dialogue: 0,0:09:17.39,0:09:18.30,Default,,0,0,0,,(бейсбол таратылымының дыбысы)
Dialogue: 0,0:09:17.39,0:09:18.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:18.30,0:09:20.89,Default,,0,0,0,,(бейсбол тарату дыбысы)
Dialogue: 0,0:09:23.18,0:09:24.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:26.90,0:09:28.27,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:09:32.57,0:09:33.44,Default,,0,0,0,,Иә
Dialogue: 0,0:09:34.44,0:09:35.36,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:09:35.45,0:09:37.95,Default,,0,0,0,,Бұл бүгін...
Dialogue: 0,0:09:38.03,0:09:39.28,Default,,0,0,0,,Сусындар ше?
Dialogue: 0,0:09:39.37,0:09:41.58,Default,,0,0,0,,Жоқ... онда оолонг шайы.
Dialogue: 0,0:09:41.66,0:09:42.66,Default,,0,0,0,,Иә
Dialogue: 0,0:09:44.62,0:09:46.58,Default,,0,0,0,,(Изуку) Каири-чан (Каири) Дэку-сан
Dialogue: 0,0:09:47.12,0:09:48.00,Default,,0,0,0,,Иә
Dialogue: 0,0:09:48.08,0:09:49.67,Default,,0,0,0,,Сәлем
Dialogue: 0,0:09:52.46,0:09:54.55,Default,,0,0,0,,Бүгін өмір сүретін...
Dialogue: 0,0:09:55.13,0:09:56.63,Default,,0,0,0,,Бүгін емес.
Dialogue: 0,0:09:57.01,0:09:58.01,Default,,0,0,0,,Ештеңе.
Dialogue: 0,0:09:58.09,0:09:59.47,Default,,0,0,0,,А...
Dialogue: 0,0:10:02.76,0:10:04.06,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:10:04.52,0:10:05.39,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:05.48,0:10:07.02,Default,,0,0,0,,Сізге джаз ұнайды ма?
Dialogue: 0,0:10:07.48,0:10:08.44,Default,,0,0,0,,Иә
Dialogue: 0,0:10:08.94,0:10:10.48,Default,,0,0,0,,Маған джаз ұнайды
Dialogue: 0,0:10:13.86,0:10:15.65,Default,,0,0,0,,Жазбаны пайдалана аламын ба?
Dialogue: 0,0:10:16.07,0:10:16.78,Default,,0,0,0,,Иә
Dialogue: 0,0:10:17.28,0:10:19.87,Default,,0,0,0,,Мен соңғы уақытта тікелей эфирде ойнамаймын.
Dialogue: 0,0:10:19.95,0:10:20.62,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:10:21.16,0:10:22.83,Default,,0,0,0,,Сыртта жаңбыр жауып тұр ма?
Dialogue: 0,0:10:23.29,0:10:25.29,Default,,0,0,0,,Иә, бірте-бірте
Dialogue: 0,0:10:25.83,0:10:26.71,Default,,0,0,0,,Иә
Dialogue: 0,0:10:27.08,0:10:27.46,Default,,0,0,0,,(перделердің ашылған дыбысы)
Dialogue: 0,0:10:27.46,0:10:28.58,Default,,0,0,0,,(перделердің ашылған дыбысы)
Dialogue: 0,0:10:27.46,0:10:28.58,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:28.58,0:10:29.58,Default,,0,0,0,,(перделердің ашылған дыбысы)
Dialogue: 0,0:10:30.50,0:10:31.88,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:10:31.96,0:10:33.96,Default,,0,0,0,,Бұл жігіт джазға сенеді.
Dialogue: 0,0:10:45.43,0:10:46.81,Default,,0,0,0,,♪ «Төмен жалын»
Dialogue: 0,0:10:47.14,0:10:50.31,Default,,0,0,0,,Уау, өте әсерлі
Dialogue: 0,0:11:04.12,0:11:06.66,Default,,0,0,0,,Уау, бұл өте керемет!
Dialogue: 0,0:11:07.20,0:11:09.04,Default,,0,0,0,,Sony… Hehe
Dialogue: 0,0:11:09.12,0:11:10.62,Default,,0,0,0,,Түсіндің бе? (Үлкен) Иә?
Dialogue: 0,0:11:11.17,0:11:13.21,Default,,0,0,0,,Sony — Sony
Dialogue: 0,0:11:13.29,0:11:14.71,Default,,0,0,0,,Сонни Роллинз емес
Dialogue: 0,0:11:14.80,0:11:16.34,Default,,0,0,0,,Сонни Ститт, солай ма?
Dialogue: 0,0:11:17.01,0:11:18.51,Default,,0,0,0,,Бұл тамаша!
Dialogue: 0,0:11:18.59,0:11:20.88,Default,,0,0,0,,Бүгінгі ауа райы сияқты.
Dialogue: 0,0:11:21.26,0:11:22.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:25.14,0:11:27.52,Default,,0,0,0,,Бауырым, жанды орындауды тыңдағың келеді.
Dialogue: 0,0:11:27.60,0:11:28.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:28.73,0:11:31.73,Default,,0,0,0,,Go here, we're still working on it.
Dialogue: 0,0:11:31.81,0:11:33.98,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:36.40,0:11:39.36,Default,,0,0,0,,How did that kid know?
Dialogue: 0,0:11:40.07,0:11:42.28,Default,,0,0,0,,I chose the album based on the weather.
Dialogue: 0,0:11:42.91,0:11:48.83,Default,,0,0,0,,♪「Kawakita blues」
Dialogue: 0,0:11:59.63,0:12:00.84,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:08.60,0:12:10.48,Default,,0,0,0,,What the heck is that...
Dialogue: 0,0:12:23.03,0:12:24.70,Default,,0,0,0,,Is it a combination of guitar and piano?
Dialogue: 0,0:13:08.99,0:13:10.04,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:13:10.04,0:13:12.00,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:13:10.04,0:13:12.00,Default,,0,0,0,,Керемет!
Dialogue: 0,0:13:12.45,0:13:16.79,Default,,0,0,0,,Савабе-чан! Бұл өте жақсы болды
Dialogue: 0,0:13:17.33,0:13:18.71,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:18.79,0:13:21.05,Default,,0,0,0,,Жас болсаң да, өте шеберсің.
Dialogue: 0,0:13:21.13,0:13:24.76,Default,,0,0,0,,Ішімізге кенет кіріп кетсең де, одан жаман болмайды.
Dialogue: 0,0:13:25.22,0:13:26.72,Default,,0,0,0,,Бұл тым көп мақтау.
Dialogue: 0,0:13:26.80,0:13:28.35,Default,,0,0,0,,I was trying hard to keep up.
Dialogue: 0,0:13:28.43,0:13:31.06,Default,,0,0,0,,I often say it without using both hands.
Dialogue: 0,0:13:31.72,0:13:35.23,Default,,0,0,0,,Hey, seriously think about the tour.
Dialogue: 0,0:13:35.31,0:13:38.27,Default,,0,0,0,,Let's sell your name
Dialogue: 0,0:13:38.73,0:13:41.23,Default,,0,0,0,,Yes, let me think about it.
Dialogue: 0,0:13:42.07,0:13:43.11,Default,,0,0,0,,Ал...
Dialogue: 0,0:13:43.57,0:13:44.69,Default,,0,0,0,,Я...
Dialogue: 0,0:13:44.78,0:13:48.78,Default,,0,0,0,,There are some amazing people in Tokyo.
Dialogue: 0,0:13:51.12,0:13:52.91,Default,,0,0,0,,Үлкен?
Dialogue: 0,0:13:55.04,0:13:57.50,Default,,0,0,0,,Не? (Yukiyuki) Wow, it’s huge.
Dialogue: 0,0:13:57.58,0:13:59.92,Default,,0,0,0,,Иә? иә? Хмм!?
Dialogue: 0,0:14:00.25,0:14:03.13,Default,,0,0,0,,Эй... Жарайды... Кенет не істеп жатырсың?
Dialogue: 0,0:14:03.63,0:14:04.76,Default,,0,0,0,,Бұл соншалықты үлкен бе?
Dialogue: 0,0:14:04.84,0:14:06.63,Default,,0,0,0,,Альто? тенор?
Dialogue: 0,0:14:07.05,0:14:07.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:07.88,0:14:10.39,Default,,0,0,0,,Бас бармақтағы сегізаяқ саксофон, солай ма?
Dialogue: 0,0:14:10.80,0:14:11.85,Default,,0,0,0,,Ах~
Dialogue: 0,0:14:12.22,0:14:13.97,Default,,0,0,0,,Иә, осылай ма?
Dialogue: 0,0:14:14.06,0:14:15.48,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:14:15.56,0:14:16.81,Default,,0,0,0,,Әй, бұл!
Dialogue: 0,0:14:17.73,0:14:18.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:19.60,0:14:21.36,Default,,0,0,0,,Бір сәт сөйлесе аламыз ба?
Dialogue: 0,0:14:26.74,0:14:27.70,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:14:27.78,0:14:29.11,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:29.95,0:14:34.16,Default,,0,0,0,,Менің атым Дай Миямото, мен Сендайданмын, Мияги префектурасынанмын.
Dialogue: 0,0:14:34.24,0:14:35.41,Default,,0,0,0,,18
Dialogue: 0,0:14:35.50,0:14:37.50,Default,,0,0,0,,Әй, бұл атау үлкен сиқырға ұқсайды.
Dialogue: 0,0:14:37.58,0:14:39.42,Default,,0,0,0,,Жоқ... Кешіріңіз.
Dialogue: 0,0:14:39.50,0:14:41.92,Default,,0,0,0,,I Юкинори Савабе
Dialogue: 0,0:14:42.00,0:14:44.38,Default,,0,0,0,,...Сонымен қайсысы үлкенді ойнайды?
Dialogue: 0,0:14:44.46,0:14:45.38,Default,,0,0,0,,Тенор
Dialogue: 0,0:14:45.88,0:14:49.93,Default,,0,0,0,,Мен мектепті бітіріп, бірден осында келдім, ал толық емес жұмыс күні ойнаймын.
Dialogue: 0,0:14:51.51,0:14:52.76,Default,,0,0,0,,Юкиюки-сан ше?
Dialogue: 0,0:14:52.85,0:14:55.64,Default,,0,0,0,,Мен университетке мүлдем барған жоқпын.
Dialogue: 0,0:14:55.72,0:14:57.81,Default,,0,0,0,,Университет? Сол спектакльде?
Dialogue: 0,0:14:58.18,0:15:01.02,Default,,0,0,0,,Хохо Бұл пьеса ше?
Dialogue: 0,0:15:02.11,0:15:04.27,Default,,0,0,0,,Мен тек бір ән естідім.
Dialogue: 0,0:15:04.36,0:15:07.57,Default,,0,0,0,,Басс анықтығы Жылдамдық пен ырғақ дәлдігі
Dialogue: 0,0:15:08.32,0:15:10.11,Default,,0,0,0,,Сіз ешқашан естімеген әуен желісі
Dialogue: 0,0:15:10.86,0:15:13.16,Default,,0,0,0,,Қалай болғанда да, Игинари керемет болды
Dialogue: 0,0:15:14.87,0:15:16.41,Default,,0,0,0,,Қалғандары қалай болды?
Dialogue: 0,0:15:16.95,0:15:19.46,Default,,0,0,0,,Мен бұл туралы көп білмеймін.
Dialogue: 0,0:15:19.54,0:15:21.33,Default,,0,0,0,,Барлығы дәмді болды.
Dialogue: 0,0:15:21.42,0:15:23.29,Default,,0,0,0,,Әсіресе гитара ойнаушының қатысуы күшті...
Dialogue: 0,0:15:23.38,0:15:24.88,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:15:24.96,0:15:25.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:27.01,0:15:29.05,Default,,0,0,0,,Джаз қазір өліп жатыр
Dialogue: 0,0:15:29.13,0:15:30.84,Default,,0,0,0,,Ажал шетінде тентіреп жүрген
Dialogue: 0,0:15:31.47,0:15:34.51,Default,,0,0,0,,Сол деңгейдегі қарттардың шеберлігі бірдей.
Dialogue: 0,0:15:34.60,0:15:38.39,Default,,0,0,0,,Айналдым да, джаз сияқты жүзімді жасадым.
Dialogue: 0,0:15:38.48,0:15:40.77,Default,,0,0,0,,Джаз барған сайын өліп барады
Dialogue: 0,0:15:42.35,0:15:44.36,Default,,0,0,0,,Бірақ сол адамдар
Dialogue: 0,0:15:44.44,0:15:47.03,Default,,0,0,0,,Менің ойымша, ол джазды біріктірді.
Dialogue: 0,0:15:47.40,0:15:49.49,Default,,0,0,0,,Сонда ештеңе, мағынасы, дәмі
Dialogue: 0,0:15:49.57,0:15:50.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:50.82,0:15:52.70,Default,,0,0,0,,Джазды тыңдайтындар аз.
Dialogue: 0,0:15:52.78,0:15:55.95,Default,,0,0,0,,Сондықтан мен өз дауысыммен жеңіске жеткім келеді
Dialogue: 0,0:15:56.03,0:15:58.41,Default,,0,0,0,,Иә? жеңе ме?
Dialogue: 0,0:15:59.66,0:16:02.29,Default,,0,0,0,,Токиодағы музыканың алдыңғы қатарында болу
Dialogue: 0,0:16:02.71,0:16:05.46,Default,,0,0,0,,Сіздің мақсатыңыз бүгінгі джаздың шағын бөліктерін біріктіру ме?
Dialogue: 0,0:16:06.38,0:16:09.67,Default,,0,0,0,,Мен әлемдегі ең жақсы джаз ойыншысы боламын.
Dialogue: 0,0:16:10.63,0:16:12.18,Default,,0,0,0,,Әлемдегі ең жақсысы?
Dialogue: 0,0:16:12.26,0:16:13.34,Default,,0,0,0,,Иә
Dialogue: 0,0:16:13.43,0:16:16.01,Default,,0,0,0,,Дүниедегі ең жақсысы қандай?
Dialogue: 0,0:16:16.72,0:16:20.73,Default,,0,0,0,,Сезім... Мен барлық эмоциямды дыбыстармен жеткізе аламын.
Dialogue: 0,0:16:22.44,0:16:25.19,Default,,0,0,0,,Оңай айту оңай емес деп ойлаймын.
Dialogue: 0,0:16:25.73,0:16:27.40,Default,,0,0,0,,Өйткені бұл мені ашуландырады
Dialogue: 0,0:16:27.48,0:16:28.90,Default,,0,0,0,,Мен бұл оңай болсын дегенім жоқ.
Dialogue: 0,0:16:28.98,0:16:30.11,Default,,0,0,0,,Ha
Dialogue: 0,0:16:30.61,0:16:33.53,Default,,0,0,0,,Менімен бірге болғың келе ме?
Dialogue: 0,0:16:33.61,0:16:36.62,Default,,0,0,0,,Не? Топ құру топ құру дегенді білдіре ме?
Dialogue: 0,0:16:37.20,0:16:38.28,Default,,0,0,0,,Иә
Dialogue: 0,0:16:38.87,0:16:41.04,Default,,0,0,0,,Мен ешқашан дыбысты естіген емеспін
Dialogue: 0,0:16:41.54,0:16:43.21,Default,,0,0,0,,Тыңдаңыз
Dialogue: 0,0:16:43.29,0:16:44.58,Default,,0,0,0,,Сіз кейінірек жауап бере аласыз.
Dialogue: 0,0:16:44.96,0:16:46.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:52.26,0:16:53.22,Default,,0,0,0,,Иә
Dialogue: 0,0:16:54.26,0:16:55.97,Default,,0,0,0,,Егер сен жақсы болмасаң, мен оны салмаймын.
Dialogue: 0,0:16:56.39,0:16:57.85,Default,,0,0,0,,Жақсы шығар.
Dialogue: 0,0:16:58.30,0:17:00.60,Default,,0,0,0,,Шынымен де, бәрі талантта, солай емес пе?
Dialogue: 0,0:17:00.68,0:17:03.52,Default,,0,0,0,,Таланты жоқ адам қатты тырысса да...
Dialogue: 0,0:17:04.69,0:17:06.60,Default,,0,0,0,,Бұл жай ғана ысырап.
Dialogue: 0,0:17:07.02,0:17:08.77,Default,,0,0,0,,Егер сізде талант болса ше?
Dialogue: 0,0:17:09.32,0:17:12.11,Default,,0,0,0,,Бар күшіммен баспалдақ ретінде қолданамын.
Dialogue: 0,0:17:12.74,0:17:14.32,Default,,0,0,0,,Басқыш тас...
Dialogue: 0,0:17:15.07,0:17:18.83,Default,,0,0,0,,Джаз рок тобы сияқты мәңгі бірге қалатын нәрсе емес.
Dialogue: 0,0:17:18.91,0:17:21.79,Default,,0,0,0,,Атымызды көтеру үшін бір-бірімізді трамплин етіп алайық.
Dialogue: 0,0:17:22.37,0:17:24.50,Default,,0,0,0,,Біріктіру деген осы емес пе?
Dialogue: 0,0:17:24.58,0:17:25.62,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:25.71,0:17:27.50,Default,,0,0,0,,Сонымен қатар, сол құрметті тілді қолдануды доғарайық.
Dialogue: 0,0:17:27.58,0:17:28.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:28.46,0:17:30.46,Default,,0,0,0,,Менің де жасым 18-де, жасым бір.
Dialogue: 0,0:17:30.55,0:17:31.25,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,0:17:31.34,0:17:34.22,Default,,0,0,0,,Иә, мен сол қолдармен 18 жаста едім...
Dialogue: 0,0:17:41.68,0:17:43.10,Default,,0,0,0,,Екі қабылдау керек пе?
Dialogue: 0,0:17:43.56,0:17:44.93,Default,,0,0,0,,Түсіну қиын
Dialogue: 0,0:17:46.85,0:17:47.69,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:17:48.81,0:17:50.15,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:17:48.81,0:17:50.15,Default,,0,0,0,,Эй, Юкиюки, қош келдіңіз.
Dialogue: 0,0:17:50.15,0:17:51.23,Default,,0,0,0,,Эй, Юкиюки, қош келдіңіз.
Dialogue: 0,0:17:51.73,0:17:53.65,Default,,0,0,0,,Үлкен Бұл қандай дүкен?
Dialogue: 0,0:17:53.74,0:17:55.28,Default,,0,0,0,,Акиконың дүкені
Dialogue: 0,0:17:55.36,0:17:57.66,Default,,0,0,0,,Егер мен оған айтсам, ол маған бүгін пайдалануға рұқсат берер еді.
Dialogue: 0,0:17:58.03,0:17:59.45,Default,,0,0,0,,Сәлем
Dialogue: 0,0:17:59.53,0:18:01.20,Default,,0,0,0,,Сәлеметсіз бе, бұл Савабе.
Dialogue: 0,0:18:01.28,0:18:02.62,Default,,0,0,0,,… Барамыз ба?
Dialogue: 0,0:18:02.70,0:18:05.71,Default,,0,0,0,,Жоқ, сәл күте тұрыңыз, су ішейін.
Dialogue: 0,0:18:07.04,0:18:08.63,Default,,0,0,0,,Фу…
Dialogue: 0,0:18:08.96,0:18:11.63,Default,,0,0,0,,Айтпақшы, сен Дай ойнағаныңа неше жыл болды?
Dialogue: 0,0:18:12.05,0:18:13.51,Default,,0,0,0,,3 жылдан астам уақыт бұрын
Dialogue: 0,0:18:13.59,0:18:16.09,Default,,0,0,0,,Ал... 3 жыл? тек
Dialogue: 0,0:18:16.47,0:18:18.68,Default,,0,0,0,,Иә, дәл 3 жыл
Dialogue: 0,0:18:19.76,0:18:21.35,Default,,0,0,0,,Ха... күшік
Dialogue: 0,0:18:21.43,0:18:23.81,Default,,0,0,0,,Пухахахахаха...
Dialogue: 0,0:18:23.89,0:18:24.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:25.02,0:18:27.56,Default,,0,0,0,,Олай болса, Брабант орта мектебі немесе басқалары.
Dialogue: 0,0:18:27.89,0:18:30.15,Default,,0,0,0,,No Орта және орта мектеп баскетбол клубы
Dialogue: 0,0:18:30.23,0:18:33.48,Default,,0,0,0,,Мен өзен жағасында жалғыз ойнадым.
Dialogue: 0,0:18:33.98,0:18:36.32,Default,,0,0,0,,Мен де соңғы алты айда сабақ алдым.
Dialogue: 0,0:18:37.03,0:18:38.53,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:18:38.61,0:18:39.99,Default,,0,0,0,,Қар намазы қай жылы оқылды?
Dialogue: 0,0:18:40.82,0:18:42.33,Default,,0,0,0,,4 жыл? (Қар намазы) 4 жастан
Dialogue: 0,0:18:42.41,0:18:43.70,Default,,0,0,0,,Дохьяаа
Dialogue: 0,0:18:43.79,0:18:47.41,Default,,0,0,0,,...Сонымен 14 жыл болды ма? Жоқ, бұл таңқаларлық.
Dialogue: 0,0:18:48.08,0:18:48.96,Default,,0,0,0,,Я...
Dialogue: 0,0:18:49.04,0:18:51.42,Default,,0,0,0,,Ей, мен жақсы болмасам...
Dialogue: 0,0:18:51.50,0:18:53.04,Default,,0,0,0,,О, жақсы.
Dialogue: 0,0:18:54.38,0:18:57.22,Default,,0,0,0,,Жарайды, Акико-сан, мен фортепианоны қарызға аламын.
Dialogue: 0,0:18:57.30,0:18:58.26,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:18:58.34,0:19:00.01,Default,,0,0,0,,Жоқ, бұл қажет емес.
Dialogue: 0,0:19:00.80,0:19:01.72,Default,,0,0,0,,Жалғыз ойнау
Dialogue: 0,0:19:01.80,0:19:02.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:03.56,0:19:04.68,Default,,0,0,0,,Жалғыз үрсем де
Dialogue: 0,0:19:05.06,0:19:06.81,Default,,0,0,0,,Юкибори болса, түсінесің бе?
Dialogue: 0,0:19:07.23,0:19:10.27,Default,,0,0,0,,Бірігіп болғаннан кейін ғана бірге ойнай аласыз.
Dialogue: 0,0:19:11.98,0:19:12.94,Default,,0,0,0,,Иә
Dialogue: 0,0:19:18.61,0:19:19.65,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:19:19.99,0:19:24.99,Default,,0,0,0,,(саксофон орындауы)
Dialogue: 0,0:21:10.89,0:21:11.60,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:12.02,0:21:14.56,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:21:18.65,0:21:20.82,Default,,0,0,0,,Сіз қалай ойлайсыз? Менімен бірге болғың келе ме?
Dialogue: 0,0:21:22.32,0:21:23.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:23.70,0:21:24.82,Default,,0,0,0,,Қар дұғасы?
Dialogue: 0,0:21:25.41,0:21:26.78,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:21:26.86,0:21:28.57,Default,,0,0,0,,Бүгін үйге бар.
Dialogue: 0,0:21:28.66,0:21:30.08,Default,,0,0,0,,Иә? Бұл не?
Dialogue: 0,0:21:30.16,0:21:30.99,Default,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:21:31.08,0:21:33.37,Default,,0,0,0,,Мен сізге қайта хабарласамын, жарай ма?
Dialogue: 0,0:21:33.91,0:21:34.83,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:34.91,0:21:36.46,Default,,0,0,0,,Маған уақыт беріңіз
Dialogue: 0,0:21:37.08,0:21:37.83,Default,,0,0,0,,Я...
Dialogue: 0,0:21:38.33,0:21:40.34,Default,,0,0,0,,Рахмет, Акико-сан.
Dialogue: 0,0:21:40.42,0:21:41.09,Default,,0,0,0,,Иә
Dialogue: 0,0:21:41.17,0:21:42.80,Default,,0,0,0,,Юкиюки, маған хабарласыңыз.
Dialogue: 0,0:21:43.55,0:21:44.26,Default,,0,0,0,,О
Dialogue: 0,0:21:44.34,0:21:48.30,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:21:48.39,0:21:50.68,Default,,0,0,0,,Мен де бірінші рет естідім.
Dialogue: 0,0:21:50.76,0:21:52.77,Default,,0,0,0,,Бұл бала керемет.
Dialogue: 0,0:21:56.60,0:21:59.19,Default,,0,0,0,,Боқ... талант?
Dialogue: 0,0:21:59.73,0:22:01.02,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:22:01.11,0:22:02.94,Default,,0,0,0,,Бар болғаны 3 жыл...
Dialogue: 0,0:22:03.82,0:22:05.15,Default,,0,0,0,,Қанша
Dialogue: 0,0:22:05.86,0:22:08.87,Default,,0,0,0,,Ол қанша жерге жетті?
Dialogue: 0,0:22:09.45,0:22:13.24,Default,,0,0,0,,(Жоғары лауазымды шенеунік) Марқұм патшаның өсиетіне сәйкес, біз—
Dialogue: 0,0:22:18.46,0:22:19.63,Default,,0,0,0,,Иә...
Dialogue: 0,0:22:19.71,0:22:21.92,Default,,0,0,0,,Орта мектептің үшінші курсында оқып жүргенде.
Dialogue: 0,0:22:22.00,0:22:25.42,Default,,0,0,0,,Мен алты айға жуық саксофоннан сабақ бердім.
Dialogue: 0,0:22:30.55,0:22:33.72,Default,,0,0,0,,Бұған дейін мен өзімді қалай ойнауды үйреттім деп ойлаймын.
Dialogue: 0,0:22:33.81,0:22:36.06,Default,,0,0,0,,Жаман болғаны сонша, мені дір еткізді.
Dialogue: 0,0:22:36.93,0:22:39.27,Default,,0,0,0,,Бұл қорқынышсыз дыбыс болды.
Dialogue: 0,0:22:39.60,0:22:44.11,Default,,0,0,0,,До Ре Миді саксофонда 30 минуттан аз уақыт ішінде ойнауға болады.
Dialogue: 0,0:22:44.53,0:22:48.91,Default,,0,0,0,,Бірақ шынымен жақсы дыбыс шығару үшін көп уақыт қажет.
Dialogue: 0,0:22:49.45,0:22:51.78,Default,,0,0,0,,Процесс жалғыз.
Dialogue: 0,0:22:54.12,0:22:56.45,Default,,0,0,0,,Ешқандай ерекшелік жоқ.
Dialogue: 0,0:22:57.00,0:22:58.79,Default,,0,0,0,,Қыстың бір түні
Dialogue: 0,0:22:59.33,0:23:02.34,Default,,0,0,0,,Өзенге дейін салқындаған өте суық өзен арнасында.
Dialogue: 0,0:23:02.42,0:23:06.38,Default,,0,0,0,,Мен бірде сол жігіттің жалғыз ойнап жүргенін көрдім.
Dialogue: 0,0:23:06.80,0:23:08.26,Default,,0,0,0,,Мен солай ойладым
Dialogue: 0,0:23:08.88,0:23:11.30,Default,,0,0,0,,«Бұл жігіт қалыпты емес».
Dialogue: 0,0:23:11.39,0:23:13.60,Default,,0,0,0,,«Бұл жігітте бірдеңе дұрыс емес».
Dialogue: 0,0:23:14.26,0:23:17.52,Default,,0,0,0,,«Бұл жігіт өте керемет»
Dialogue: 0,0:23:20.06,0:23:24.73,Default,,0,0,0,,(саксофон мен фортепиано орындауы)
Dialogue: 0,0:23:25.32,0:23:26.40,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:23:26.48,0:23:27.90,Default,,0,0,0,,Не? Керемет болды ма?
Dialogue: 0,0:23:27.99,0:23:29.45,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:23:29.53,0:23:31.41,Default,,0,0,0,,Менің ойымша, бұл кодқа сәйкес емес.
Dialogue: 0,0:23:31.86,0:23:33.78,Default,,0,0,0,,Жоқ, менің екпініммен
Dialogue: 0,0:23:33.87,0:23:35.16,Default,,0,0,0,,Я...
Dialogue: 0,0:23:35.24,0:23:37.75,Default,,0,0,0,,Сондықтан мен жалғыз ойнадым.
Dialogue: 0,0:23:37.83,0:23:38.87,Default,,0,0,0,,Бірақ.
Dialogue: 0,0:23:38.96,0:23:41.12,Default,,0,0,0,,Оны сәйкестендірсеңіз жақсы емес пе?
Dialogue: 0,0:23:41.21,0:23:44.38,Default,,0,0,0,,Кадр сыртындағының бәрі шу.
Dialogue: 0,0:23:44.46,0:23:45.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:23:45.71,0:23:46.88,Default,,0,0,0,,Тек тыңдаңыз
Dialogue: 0,0:23:46.96,0:23:48.09,Default,,0,0,0,,Ватару!
Dialogue: 0,0:23:48.09,0:23:51.59,Default,,0,0,0,,Ватару!
Dialogue: 0,0:23:48.09,0:23:51.59,Default,,0,0,0,,Тыңдаңыздар, бұл біздің шеңберіміз.
Dialogue: 0,0:23:52.47,0:23:54.68,Default,,0,0,0,,Егер осы шеңберде...
Dialogue: 0,0:23:55.85,0:23:59.35,Default,,0,0,0,,Қаншалықты зорлық-зомбылыққа ұшырасам да, бұл жай шу емес
Dialogue: 0,0:23:59.43,0:24:01.94,Default,,0,0,0,,Ах... керемет
Dialogue: 0,0:24:02.27,0:24:04.94,Default,,0,0,0,,Ха... Мен тез арада ырғақ бөлімін әкелуім керек.
Dialogue: 0,0:24:05.02,0:24:05.94,Default,,0,0,0,,Сізге бұл шынымен керек пе?
Dialogue: 0,0:24:06.02,0:24:08.69,Default,,0,0,0,,Көрініп тұр, барабандар көлік.
Dialogue: 0,0:24:08.78,0:24:09.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:09.65,0:24:13.32,Default,,0,0,0,,Пойызға мінген біздердің сол жылдамдықпен жүруден басқа амалы жоқ.
Dialogue: 0,0:24:13.41,0:24:17.49,Default,,0,0,0,,Джаз барабаншысы кез келген көлікке айнала алады.
Dialogue: 0,0:24:17.58,0:24:20.08,Default,,0,0,0,,Сонда сенің абайсыз қылығың жақсы болады.
Dialogue: 0,0:24:20.16,0:24:21.37,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:24:22.21,0:24:22.87,Default,,0,0,0,,Хмм, эй, мен көбірек істеймін.
Dialogue: 0,0:24:22.87,0:24:25.04,Default,,0,0,0,,Хмм, эй, мен көбірек істеймін.
Dialogue: 0,0:24:22.87,0:24:25.04,Default,,0,0,0,,(цимбалдың соғу дыбысы)
Dialogue: 0,0:24:25.38,0:24:26.63,Default,,0,0,0,,О!
Dialogue: 0,0:24:28.38,0:24:31.01,Default,,0,0,0,,Сондықтан Кейнс кеңес бергендей
Dialogue: 0,0:24:31.09,0:24:34.93,Default,,0,0,0,,Мемлекеттік инвестицияның артуы және экономиканың уақытша қалпына келуі
Dialogue: 0,0:24:35.01,0:24:37.18,Default,,0,0,0,,Бірақ бұл жаңа келісім...
Dialogue: 0,0:24:37.26,0:24:38.51,Default,,0,0,0,,
Dialogue: 0,0:24:38.60,0:24:40.22,Default,,0,0,0,,Әй, бұр, айналдыр! (мүше) Тоқта, тоқта.
Dialogue: 0,0:24:40.31,0:24:41.68,Default,,0,0,0,,Сәлем! Бұл жерде бос
Dialogue: 0,0:24:43.44,0:24:46.52,Default,,0,0,0,,Ах~ Өте алыс ату
Dialogue: 0,0:24:46.61,0:24:48.11,Default,,0,0,0,,Біз қазірдің өзінде үзіліс жасай алмаймыз ба?
Dialogue: 0,0:24:48.19,0:24:50.03,Default,,0,0,0,,Әлі ерте.
Dialogue: 0,0:24:50.11,0:24:51.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:52.15,0:24:54.53,Default,,0,0,0,,Мен шаршадым. (Клуб мүшесі) Тезірек ішіп ал.
Dialogue: 0,0:24:54.61,0:24:56.66,Default,,0,0,0,,Сенпай, бұл бұрынғы түсірілім.
Dialogue: 0,0:24:56.74,0:25:00.79,Default,,0,0,0,,Аа, Тамада орта мектепте оқып жүргенде префектура бойынша 8 үздіктің қатарына кірді ме?
Dialogue: 0,0:25:00.87,0:25:02.83,Default,,0,0,0,,Не? (Аға) Оңай алайық.
Dialogue: 0,0:25:02.91,0:25:03.75,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:25:03.83,0:25:07.92,Default,,0,0,0,,Қоғамға шықпас бұрын тәні мен санасы сау болу
Dialogue: 0,0:25:08.00,0:25:10.21,Default,,0,0,0,,Бұл шеңбер.
Dialogue: 0,0:25:11.09,0:25:12.42,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:25:14.18,0:25:19.60,Default,,0,0,0,,(саксофон орындауы)
Dialogue: 0,0:25:20.14,0:25:20.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:21.02,0:25:22.06,Default,,0,0,0,,Иә
Dialogue: 0,0:25:23.94,0:25:26.60,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:25:26.69,0:25:28.81,Default,,0,0,0,,Сіз тамаша жұмыс істеп жатырсыз.
Dialogue: 0,0:25:28.90,0:25:29.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:30.11,0:25:34.20,Default,,0,0,0,,Тамада мырза бүгін кешке қызды клубтан бөлмесіне алып келуді жоспарлап отырған жоқ па?
Dialogue: 0,0:25:34.70,0:25:35.91,Default,,0,0,0,,Барка
Dialogue: 0,0:25:36.28,0:25:39.70,Default,,0,0,0,,Бұл ішу кешінен қалған тамақ, негізінен қуырылған тағам.
Dialogue: 0,0:25:39.78,0:25:40.83,Default,,0,0,0,,Ой
Dialogue: 0,0:25:40.91,0:25:43.62,Default,,0,0,0,,Қабілетті адам Тамада күткендей.
Dialogue: 0,0:25:46.04,0:25:48.83,Default,,0,0,0,,Мен клубтан шықтым.
Dialogue: 0,0:25:49.71,0:25:51.59,Default,,0,0,0,,А... бірдеңе болды ма?
Dialogue: 0,0:25:51.67,0:25:53.34,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:25:53.42,0:25:54.97,Default,,0,0,0,,Хмм…
Dialogue: 0,0:25:55.55,0:25:58.26,Default,,0,0,0,,Одан да маған ұнамайды.
Dialogue: 0,0:25:58.34,0:25:59.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:59.93,0:26:02.60,Default,,0,0,0,,Токиоға дейін келсем де.
Dialogue: 0,0:26:02.68,0:26:06.10,Default,,0,0,0,,Күн сайын осындай жерде жаттығу жасаңыз.
Dialogue: 0,0:26:06.19,0:26:06.98,Default,,0,0,0,,Себебі мен шештім
Dialogue: 0,0:26:07.35,0:26:08.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:09.56,0:26:12.02,Default,,0,0,0,,Әлемдегі ең үздік джаз ойыншысы болу
Dialogue: 0,0:26:13.07,0:26:14.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:15.03,0:26:18.28,Default,,0,0,0,,Дұрыс, Тамада, менің шағын өтінішім бар...
Dialogue: 0,0:26:18.78,0:26:19.45,Default,,0,0,0,,Пи
Dialogue: 0,0:26:22.08,0:26:23.24,Default,,0,0,0,,Хамф (Тамада) Иә?
Dialogue: 0,0:26:23.66,0:26:28.04,Default,,0,0,0,,♪ «Пачелбель каноны»
Dialogue: 0,0:27:11.13,0:27:12.13,Default,,0,0,0,,Иә
Dialogue: 0,0:27:19.80,0:27:23.18,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:27:23.26,0:27:25.10,Default,,0,0,0,,Бұл джаз
Dialogue: 0,0:27:25.18,0:27:26.60,Default,,0,0,0,,Рахмет Тамада
Dialogue: 0,0:27:26.68,0:27:28.52,Default,,0,0,0,,Оның ырғақ сезімі жақсы болды.
Dialogue: 0,0:27:29.23,0:27:30.60,Default,,0,0,0,,Бұл суреттен басқаша болды
Dialogue: 0,0:27:30.69,0:27:31.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:31.94,0:27:34.23,Default,,0,0,0,,Мен не айтарымды білмеймін.
Dialogue: 0,0:27:34.61,0:27:35.82,Default,,0,0,0,,Мен бұл қарқынды...
Dialogue: 0,0:27:36.23,0:27:37.36,Default,,0,0,0,,Хаха
Dialogue: 0,0:27:37.44,0:27:39.28,Default,,0,0,0,,Менің джазды ұнататын себебім де
Dialogue: 0,0:27:39.36,0:27:41.45,Default,,0,0,0,,Өйткені ол ыстық және қарқынды
Dialogue: 0,0:27:41.53,0:27:43.16,Default,,0,0,0,,Соло әсіресе жақсы.
Dialogue: 0,0:27:43.24,0:27:43.99,Default,,0,0,0,,Соло?
Dialogue: 0,0:27:44.33,0:27:46.29,Default,,0,0,0,,Импровизация бөлімі
Dialogue: 0,0:27:46.54,0:27:48.79,Default,,0,0,0,,Басыңызбен ойламаңыз
Dialogue: 0,0:27:48.87,0:27:50.41,Default,,0,0,0,,Бостандық?
Dialogue: 0,0:27:50.83,0:27:52.50,Default,,0,0,0,,Терең?
Dialogue: 0,0:27:53.08,0:27:53.96,Default,,0,0,0,,Қалай болғанда да
Dialogue: 0,0:27:54.54,0:27:57.67,Default,,0,0,0,,Бірінші дәрежелі ойыншылардың жеке әндері бар.
Dialogue: 0,0:28:00.34,0:28:01.72,Default,,0,0,0,,Джаз дегеніміз не?
Dialogue: 0,0:28:02.34,0:28:04.39,Default,,0,0,0,,Осыны Тамада айтса қуанар едім.
Dialogue: 0,0:28:04.47,0:28:05.93,Default,,0,0,0,,Иә? Шынымен бе?
Dialogue: 0,0:28:06.43,0:28:08.89,Default,,0,0,0,,Көптеген адамдар джаз туралы білмей ме?
Dialogue: 0,0:28:09.23,0:28:11.39,Default,,0,0,0,,Джаз Білмейтін Тамадаға жетсе
Dialogue: 0,0:28:12.06,0:28:13.85,Default,,0,0,0,,Басқа адамдарға жетуі керек
Dialogue: 0,0:28:14.90,0:28:15.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:28:21.11,0:28:22.45,Default,,0,0,0,,Әй, үлкен
Dialogue: 0,0:28:22.53,0:28:23.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:24.03,0:28:25.32,Default,,0,0,0,,Маған
Dialogue: 0,0:28:26.24,0:28:28.20,Default,,0,0,0,,Қызық, барабанда ойнай аламын ба?
Dialogue: 0,0:28:32.04,0:28:33.62,Default,,0,0,0,,О~
Dialogue: 0,0:28:33.96,0:28:36.21,Default,,0,0,0,,Барабан керемет!
Dialogue: 0,0:28:36.29,0:28:39.26,Default,,0,0,0,,Барабандар көп, бірақ қайсысы негізгі?
Dialogue: 0,0:28:39.34,0:28:40.34,Default,,0,0,0,,Біріншіден, барабан
Dialogue: 0,0:28:40.34,0:28:40.80,Default,,0,0,0,,Біріншіден, барабан
Dialogue: 0,0:28:40.34,0:28:40.80,Default,,0,0,0,,Я...
Dialogue: 0,0:28:40.80,0:28:40.88,Default,,0,0,0,,Я...
Dialogue: 0,0:28:40.88,0:28:41.84,Default,,0,0,0,,Я...
Dialogue: 0,0:28:40.88,0:28:41.84,Default,,0,0,0,,Шинигаминің көздерін алу үшін,
Dialogue: 0,0:28:41.92,0:28:43.01,Default,,0,0,0,,Дай Дай
Dialogue: 0,0:28:43.01,0:28:43.97,Default,,0,0,0,,Дай Дай
Dialogue: 0,0:28:43.01,0:28:43.97,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:43.97,0:28:44.47,Default,,0,0,0,,Уау!
Dialogue: 0,0:28:45.22,0:28:46.14,Default,,0,0,0,,Ой…
Dialogue: 0,0:28:46.22,0:28:47.01,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:28:47.43,0:28:50.31,Default,,0,0,0,,Менің үй иесім Тамада-кун Хэхехехе
Dialogue: 0,0:28:50.77,0:28:52.39,Default,,0,0,0,,Тамада-кун (Тамада) Иә?
Dialogue: 0,0:28:52.48,0:28:54.31,Default,,0,0,0,,Сіз Арт Блейкиді білесіз бе?
Dialogue: 0,0:28:54.40,0:28:56.31,Default,,0,0,0,,Не? Үдеткіш тежегіші?
Dialogue: 0,0:28:56.77,0:28:58.02,Default,,0,0,0,,А, бұл?
Dialogue: 0,0:28:58.44,0:28:59.40,Default,,0,0,0,,Уау
Dialogue: 0,0:28:59.48,0:29:03.45,Default,,0,0,0,,Ей, біз қазір маңызды кезеңдеміз.
Dialogue: 0,0:29:03.53,0:29:04.49,Default,,0,0,0,,О
Dialogue: 0,0:29:04.57,0:29:09.49,Default,,0,0,0,,Мен сіздің абайсыз мінезіңізді басқара алатын керемет барабаншы табу туралы айтып отырмын.
Dialogue: 0,0:29:09.99,0:29:12.83,Default,,0,0,0,,Мен саған ақымақ әкелсем не істеуім керек?
Dialogue: 0,0:29:12.91,0:29:15.58,Default,,0,0,0,,Кім ақымақ? бұл бейбақ
Dialogue: 0,0:29:15.67,0:29:16.38,Default,,0,0,0,,Я...
Dialogue: 0,0:29:16.46,0:29:17.88,Default,,0,0,0,,Тамада сені үйден қуып жіберсе
Dialogue: 0,0:29:17.96,0:29:19.96,Default,,0,0,0,,Сенің орныңа аунаудан басқа амалым жоқ.
Dialogue: 0,0:29:20.05,0:29:21.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:22.47,0:29:26.09,Default,,0,0,0,,Иә, иә, мына қалпаққа бас.
Dialogue: 0,0:29:27.30,0:29:28.72,Default,,0,0,0,,Бұл жабық
Dialogue: 0,0:29:28.80,0:29:30.76,Default,,0,0,0,,...осы ырғақпен
Dialogue: 0,0:29:31.14,0:29:32.60,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:29:32.68,0:29:33.77,Default,,0,0,0,,Бұл ұнайды ма?
Dialogue: 0,0:29:33.85,0:29:35.52,Default,,0,0,0,,Иә, әрқашан.
Dialogue: 0,0:29:35.60,0:29:37.06,Default,,0,0,0,,Ал, сәйкестендірейік.
Dialogue: 0,0:29:37.48,0:29:39.65,Default,,0,0,0,,Бірақ тек бүгін үшін.
Dialogue: 0,0:29:39.73,0:29:44.07,Default,,0,0,0,,(үш адамның орындауы)
Dialogue: 0,0:29:48.66,0:29:50.83,Default,,0,0,0,,Бірде-бір тер шықпаса да
Dialogue: 0,0:29:51.24,0:29:53.16,Default,,0,0,0,,Шүкір, зейініңді жинақтау керек.
Dialogue: 0,0:30:07.76,0:30:08.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:30:11.72,0:30:12.68,Default,,0,0,0,,Фу…
Dialogue: 0,0:30:12.77,0:30:14.39,Default,,0,0,0,,Міне, Тамада-кун.
Dialogue: 0,0:30:14.81,0:30:16.52,Default,,0,0,0,,Мен сенің оны қаншалықты жақсы басқара алатыныңды білгім келеді.
Dialogue: 0,0:30:17.02,0:30:20.36,Default,,0,0,0,,Мен Даймен жалғыз сөйлескім келеді, сондықтан оны бүгін алып кетіңізші.
Dialogue: 0,0:30:20.73,0:30:21.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:30:22.23,0:30:24.36,Default,,0,0,0,,Үлкен Ангатона
Dialogue: 0,0:30:26.28,0:30:27.53,Default,,0,0,0,,Әй, үлкен
Dialogue: 0,0:30:27.61,0:30:30.28,Default,,0,0,0,,Неліктен мұндай өнерпазды әкелдің?
Dialogue: 0,0:30:30.37,0:30:32.24,Default,,0,0,0,,Барлығы әуесқой.
Dialogue: 0,0:30:32.33,0:30:33.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:33.79,0:30:34.75,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:30:35.12,0:30:38.96,Default,,0,0,0,,Юкинори сіздің музыка ойнағыңыз келсе жоқ дей ме?
Dialogue: 0,0:30:42.50,0:30:43.88,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:30:43.96,0:30:46.38,Default,,0,0,0,,(шу)
Dialogue: 0,0:30:46.47,0:30:47.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:47.68,0:30:48.88,Default,,0,0,0,,(шу)
Dialogue: 0,0:30:48.97,0:30:50.30,Default,,0,0,0,,Тамада?
Dialogue: 0,0:30:56.10,0:30:56.98,Default,,0,0,0,,Уссу
Dialogue: 0,0:30:57.77,0:30:58.73,Default,,0,0,0,,Usu...
Dialogue: 0,0:30:58.81,0:31:00.56,Default,,0,0,0,,Бұл маңайға ыңғайсыздық туғызады, сондықтан оны жабыңыз.
Dialogue: 0,0:31:00.65,0:31:01.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:31:01.40,0:31:02.48,Default,,0,0,0,,(шелек тарсылдаған дыбыс)
Dialogue: 0,0:31:02.48,0:31:03.48,Default,,0,0,0,,(шелек тарсылдаған дыбыс)
Dialogue: 0,0:31:02.48,0:31:03.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:03.48,0:31:05.28,Default,,0,0,0,,(шелек тарсылдаған дыбыс)
Dialogue: 0,0:31:08.20,0:31:09.24,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:31:10.03,0:31:11.62,Default,,0,0,0,,Себебі мен мұны істегім келеді
Dialogue: 0,0:31:14.49,0:31:17.45,Default,,0,0,0,,Тамада-сан, ұстағыш шынымен жұмсақ.
Dialogue: 0,0:31:18.00,0:31:19.29,Default,,0,0,0,,Иә мырза
Dialogue: 0,0:31:20.17,0:31:21.58,Default,,0,0,0,,О, Ханон-чан
Dialogue: 0,0:31:21.67,0:31:24.34,Default,,0,0,0,,Кендрик Скотт сияқты жақсы.
Dialogue: 0,0:31:24.42,0:31:27.26,Default,,0,0,0,,Ханнон Маған Кит Мун ұнайды.
Dialogue: 0,0:31:28.88,0:31:32.14,Default,,0,0,0,,36 Сіздің ерлікті жақсартуға арналған несиелер
Dialogue: 0,0:31:32.55,0:31:34.72,Default,,0,0,0,,Мен енді қайтып бара алмаймын.
Dialogue: 0,0:31:36.18,0:31:39.39,Default,,0,0,0,,Мен де оны тартуды жоспарлап отырған жоқпын.
Dialogue: 0,0:31:40.77,0:31:42.52,Default,,0,0,0,,О, Савабе.
Dialogue: 0,0:31:42.86,0:31:43.94,Default,,0,0,0,,Көптен бері көрмедім!
Dialogue: 0,0:31:44.02,0:31:45.65,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:31:45.73,0:31:48.49,Default,,0,0,0,,Тікелей шоу келе жатыр. Келесіз бе?
Dialogue: 0,0:31:48.57,0:31:51.32,Default,,0,0,0,,Мен және Тоса Ямагучи трио ретінде
Dialogue: 0,0:31:51.41,0:31:53.24,Default,,0,0,0,,А... Мен барабаншы іздеп жүрмін.
Dialogue: 0,0:31:53.57,0:31:56.37,Default,,0,0,0,,Неліктен Ямагучи емес?
Dialogue: 0,0:31:56.45,0:31:58.75,Default,,0,0,0,,Міне, барабаншы.
Dialogue: 0,0:31:58.83,0:32:00.71,Default,,0,0,0,,Не, қабілетің жетіспейді дейсің бе?
Dialogue: 0,0:32:01.21,0:32:04.25,Default,,0,0,0,,Сіз осы жердегі университеттерде қандай керемет барабаншыларды білесіз?
Dialogue: 0,0:32:04.75,0:32:07.71,Default,,0,0,0,,Әй, дәлірек айтсақ, мен сияқты қолы күшті біреу.
Dialogue: 0,0:32:08.13,0:32:10.13,Default,,0,0,0,,А... а...
Dialogue: 0,0:32:12.30,0:32:14.39,Default,,0,0,0,,Я...
Dialogue: 0,0:32:15.60,0:32:18.18,Default,,0,0,0,,Келесі төрт күнде не болады?
Dialogue: 0,0:32:18.27,0:32:19.81,Default,,0,0,0,,Мен барабан сабағына қатыстым.
Dialogue: 0,0:32:19.89,0:32:21.73,Default,,0,0,0,,О, солай ма?
Dialogue: 0,0:32:22.56,0:32:26.02,Default,,0,0,0,,Бастауыш сынып оқушылары болды, бірақ мен ең нашар болдым.
Dialogue: 0,0:32:27.19,0:32:28.73,Default,,0,0,0,,Мен мұны екі адаммен жасаған кезде...
Dialogue: 0,0:32:29.44,0:32:31.45,Default,,0,0,0,,Джаз туралы бірдеңе жақсы естіледі.
Dialogue: 0,0:32:31.82,0:32:32.74,Default,,0,0,0,,Иә
Dialogue: 0,0:32:33.11,0:32:35.62,Default,,0,0,0,,Тамада: Мына жылдамдықпен жүре аласың ба?
Dialogue: 0,0:32:35.70,0:32:37.41,Default,,0,0,0,,Сосын әйтеуір
Dialogue: 0,0:32:42.21,0:32:44.50,Default,,0,0,0,,
Dialogue: 0,0:32:45.21,0:32:48.00,Default,,0,0,0,,Екінші жағынан, тарих жауыздар деп аталған, бірақ өз ізін қалдырған адамдарға да толы
Dialogue: 0,0:33:04.06,0:33:06.81,Default,,0,0,0,,Юки Инори Бұл жақсы, солай ма?
Dialogue: 0,0:33:06.90,0:33:08.02,Default,,0,0,0,,Оны біріктірейік
Dialogue: 0,0:33:08.11,0:33:09.57,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:33:09.90,0:33:14.74,Default,,0,0,0,,(үш адамның орындауы)
Dialogue: 0,0:33:20.54,0:33:22.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:33:22.66,0:33:24.79,Default,,0,0,0,,Сен өте мейірімдісің, Дай Чан.
Dialogue: 0,0:33:24.87,0:33:27.29,Default,,0,0,0,,Әлсізге бейімделе алмайды
Dialogue: 0,0:33:28.59,0:33:31.42,Default,,0,0,0,,Тамада, сен кереметсің.
Dialogue: 0,0:33:31.51,0:33:33.38,Default,,0,0,0,,Сонымен... сіз аздап істей аласыз ба?
Dialogue: 0,0:33:33.47,0:33:34.63,Default,,0,0,0,,Тамада-кун
Dialogue: 0,0:33:35.01,0:33:38.01,Default,,0,0,0,,Оларды ресми мүше ету мүмкін емес.
Dialogue: 0,0:33:38.68,0:33:40.14,Default,,0,0,0,,Қар дұғасы
Dialogue: 0,0:33:40.97,0:33:42.81,Default,,0,0,0,,Джаз ондай емес.
Dialogue: 0,0:33:42.89,0:33:45.19,Default,,0,0,0,,Техника қиын емес.
Dialogue: 0,0:33:45.73,0:33:47.86,Default,,0,0,0,,Мені жылжыту керек.
Dialogue: 0,0:33:48.40,0:33:50.94,Default,,0,0,0,,Біз әлі оқиғаның ортасындамыз.
Dialogue: 0,0:33:51.02,0:33:54.82,Default,,0,0,0,,Мен қазір мүше бола алмаймын, бірақ сіз өз қалауыңыз бойынша келіп жаттығу жасай аласыз.
Dialogue: 0,0:33:54.90,0:33:55.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:55.78,0:33:57.20,Default,,0,0,0,,Шынымен бе? қар намазы
Dialogue: 0,0:33:57.28,0:33:58.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:58.49,0:33:59.74,Default,,0,0,0,,Пи
Dialogue: 0,0:34:07.88,0:34:11.09,Default,,0,0,0,,А, ана? Иә, менде бәрі жақсы
Dialogue: 0,0:34:11.17,0:34:13.92,Default,,0,0,0,,Қазір жақсысың ба? Студенттер оралды ма?
Dialogue: 0,0:34:16.84,0:34:20.97,Default,,0,0,0,,Білесіз бе, барабан сегіз және он алты соққыдан кейін.
Dialogue: 0,0:34:21.05,0:34:22.89,Default,,0,0,0,,Сіз нені үйретесіз?
Dialogue: 0,0:34:23.89,0:34:26.06,Default,,0,0,0,,Бірақ~
Dialogue: 0,0:34:26.14,0:34:28.23,Default,,0,0,0,,А, толтыр, сонда?
Dialogue: 0,0:35:23.33,0:35:26.20,Default,,0,0,0,,Бұл күрделі және керемет емес пе?
Dialogue: 0,0:35:26.29,0:35:28.62,Default,,0,0,0,,Мен оны әлі де тазартуым керек.
Dialogue: 0,0:35:28.71,0:35:29.87,Default,,0,0,0,,Тікелей шоу жасайық
Dialogue: 0,0:35:29.96,0:35:30.75,Default,,0,0,0,,Не? (Юкиюки) Иә?
Dialogue: 0,0:35:30.83,0:35:33.09,Default,,0,0,0,,Мүмкін емес Мүлде мүмкін емес
Dialogue: 0,0:35:33.17,0:35:36.00,Default,,0,0,0,,Тамаданың да өткеніне 3 ай болды, сондықтан уақыт келді.
Dialogue: 0,0:35:36.09,0:35:39.59,Default,,0,0,0,,Тыңдаңыз, Тамада әлі ресми мүше емес.
Dialogue: 0,0:35:39.68,0:35:43.30,Default,,0,0,0,,Біріншіден, оны алғашқы үш айда ренжімей ойнай аласыз ба?
Dialogue: 0,0:35:43.39,0:35:45.22,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:35:45.31,0:35:47.10,Default,,0,0,0,,Уақытыңыз жоқ па?
Dialogue: 0,0:35:47.18,0:35:49.02,Default,,0,0,0,,Біз тобымызды әлі аяқтамағанымызға қарамастан.
Dialogue: 0,0:35:49.10,0:35:50.94,Default,,0,0,0,,Сіз кеткенде ештеңе болмайды
Dialogue: 0,0:35:51.02,0:35:53.19,Default,,0,0,0,,Ұялумен аяқтаңыз
Dialogue: 0,0:35:53.27,0:35:56.36,Default,,0,0,0,,Анонимді адамдарды тыңдауға кім келді?
Dialogue: 0,0:35:56.69,0:35:58.86,Default,,0,0,0,,Сіз тырыспайынша түсінбейсіз
Dialogue: 0,0:35:58.94,0:36:01.07,Default,,0,0,0,,Енді бізбен не болады?
Dialogue: 0,0:36:01.95,0:36:03.49,Default,,0,0,0,,Мен оны көргім келеді
Dialogue: 0,0:36:05.87,0:36:06.99,Default,,0,0,0,,Тек бір рет
Dialogue: 0,0:36:07.37,0:36:09.25,Default,,0,0,0,,Маған бір рет орындауға рұқсат етіңізші.
Dialogue: 0,0:36:09.33,0:36:11.50,Default,,0,0,0,,Біз де бизнеспен айналысамыз ғой.
Dialogue: 0,0:36:11.58,0:36:14.42,Default,,0,0,0,,Тұтынушы: Ең бастысы, сіз қанша жинай аласыз.
Dialogue: 0,0:36:14.75,0:36:17.09,Default,,0,0,0,,А... О, құдай-ау.
Dialogue: 0,0:36:17.17,0:36:19.05,Default,,0,0,0,,Екі университет студенті бар.
Dialogue: 0,0:36:19.13,0:36:20.63,Default,,0,0,0,,Шеңберлер әлдеқашан бар...
Dialogue: 0,0:36:20.72,0:36:23.39,Default,,0,0,0,,Шеңбердегі адамдар өліп қалды.
Dialogue: 0,0:36:23.72,0:36:27.60,Default,,0,0,0,,Біз де жас тұтынушылардың санын көбейткіміз келеді.
Dialogue: 0,0:36:28.60,0:36:30.56,Default,,0,0,0,,Бұл! Қай күн екені маңызды емес
Dialogue: 0,0:36:31.14,0:36:32.52,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:36:32.60,0:36:34.02,Default,,0,0,0,,Хмм...
Dialogue: 0,0:36:36.15,0:36:37.48,Default,,0,0,0,,Джаз ойнайық!
Dialogue: 0,0:36:38.32,0:36:40.65,Default,,0,0,0,,Джаз Мен мұны істеймін, өтінемін.
Dialogue: 0,0:36:41.28,0:36:42.86,Default,,0,0,0,,Көптеген джаз!
Dialogue: 0,0:36:42.95,0:36:45.12,Default,,0,0,0,,О, рахмет!
Dialogue: 0,0:36:46.12,0:36:47.66,Default,,0,0,0,,А... Мм (Мочизуки)?
Dialogue: 0,0:36:48.62,0:36:49.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:49.54,0:36:51.08,Default,,0,0,0,,Бұл біртүрлі сұрақ.
Dialogue: 0,0:36:51.16,0:36:54.79,Default,,0,0,0,,Сіздің келу ықтималдығы қандай?
Dialogue: 0,0:36:54.88,0:36:57.13,Default,,0,0,0,,Не? Бұл не... ертең?
Dialogue: 0,0:36:57.21,0:37:00.21,Default,,0,0,0,,А... жоқ... Мен джаз тыңдаған емеспін.
Dialogue: 0,0:37:00.30,0:37:02.93,Default,,0,0,0,,Хмм... 10 абз?
Dialogue: 0,0:37:03.43,0:37:04.84,Default,,0,0,0,,10 тармақ…
Dialogue: 0,0:37:04.93,0:37:05.89,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:37:06.18,0:37:07.51,Default,,0,0,0,,Не? (үлкен) біз
Dialogue: 0,0:37:07.60,0:37:09.31,Default,,0,0,0,,100% Жоқ...
Dialogue: 0,0:37:09.39,0:37:12.77,Default,,0,0,0,,120% орындаймыз, келіңіздер.
Dialogue: 0,0:37:13.69,0:37:15.02,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:37:15.35,0:37:17.27,Default,,0,0,0,,Бұрынғы ұшқыш, не?
Dialogue: 0,0:37:15.35,0:37:17.27,Default,,0,0,0,,Рахмет! Мен сені күтетін боламын
Dialogue: 0,0:37:17.27,0:37:17.36,Default,,0,0,0,,Рахмет! Мен сені күтетін боламын
Dialogue: 0,0:37:17.36,0:37:18.86,Default,,0,0,0,,Рахмет! Мен сені күтетін боламын
Dialogue: 0,0:37:17.36,0:37:18.86,Default,,0,0,0,,Бұл алып кету, солай ма?
Dialogue: 0,0:37:18.94,0:37:20.40,Default,,0,0,0,,бар…
Dialogue: 0,0:37:20.48,0:37:21.53,Default,,0,0,0,,Жарайды
Dialogue: 0,0:37:22.78,0:37:23.82,Default,,0,0,0,,Tsk
Dialogue: 0,0:37:28.03,0:37:29.91,Default,,0,0,0,,Сізде нөлдік талант жоқ.
Dialogue: 0,0:37:31.62,0:37:33.91,Default,,0,0,0,,Хмм, міне...
Dialogue: 0,0:37:35.08,0:37:37.08,Default,,0,0,0,,Жақсы, тегіс
Dialogue: 0,0:37:37.50,0:37:39.04,Default,,0,0,0,,Бізде парақшалар бар ма?
Dialogue: 0,0:37:39.67,0:37:41.42,Default,,0,0,0,,Мені сынға алды
Dialogue: 0,0:37:53.10,0:37:54.35,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:37:54.43,0:37:55.27,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:37:55.64,0:37:57.94,Default,,0,0,0,,Нашар толық емес жұмыс уақыты
Dialogue: 0,0:37:58.02,0:37:59.90,Default,,0,0,0,,...Сонымен, тұтынушылар бар ма?
Dialogue: 0,0:37:59.98,0:38:01.23,Default,,0,0,0,,Мм... (Юкиюки) А?
Dialogue: 0,0:38:03.53,0:38:05.61,Default,,0,0,0,,Үш тұрақты
Dialogue: 0,0:38:05.70,0:38:07.66,Default,,0,0,0,,Менеджер: Біз төртеуміз.
Dialogue: 0,0:38:08.16,0:38:09.20,Default,,0,0,0,,Хмм...
Dialogue: 0,0:38:10.62,0:38:15.00,Default,,0,0,0,,Не? Адамдардың анонимді түрде жиналуға бос уақыты жетпейді.
Dialogue: 0,0:38:15.08,0:38:16.67,Default,,0,0,0,,Сәлем Юкиюки
Dialogue: 0,0:38:17.37,0:38:19.58,Default,,0,0,0,,Біз қаншалықты салқынбыз (Юкимори)?
Dialogue: 0,0:38:20.59,0:38:22.13,Default,,0,0,0,,Сәлем Тамада
Dialogue: 0,0:38:22.21,0:38:24.55,Default,,0,0,0,,Біз қазір джаз ойнаймыз.
Dialogue: 0,0:38:25.55,0:38:29.26,Default,,0,0,0,,Біз өте салқынбыз, біз өлеміз
Dialogue: 0,0:38:29.64,0:38:30.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:31.43,0:38:32.43,Default,,0,0,0,,Иә
Dialogue: 0,0:38:33.06,0:38:34.18,Default,,0,0,0,,Ikube
Dialogue: 0,0:38:36.02,0:38:38.27,Default,,0,0,0,,О? жас сәби
Dialogue: 0,0:38:38.35,0:38:39.86,Default,,0,0,0,,Сіз кіреберісті көрмедіңіз бе?
Dialogue: 0,0:38:40.40,0:38:42.82,Default,,0,0,0,,Онда 18 жастағы джаз жазылған.
Dialogue: 0,0:38:43.19,0:38:44.32,Default,,0,0,0,,Сумен араласады
Dialogue: 0,0:38:44.40,0:38:45.61,Default,,0,0,0,,Сәлем
Dialogue: 0,0:38:53.66,0:38:54.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:38:55.20,0:38:56.46,Default,,0,0,0,,Су толқындары, олар кеткен жерге шабуыл жасаңдар
Dialogue: 0,0:39:00.17,0:39:03.84,Default,,0,0,0,,Осы кезеңді өмір бойы есте сақтайық.
Dialogue: 0,0:39:05.17,0:39:08.63,Default,,0,0,0,,Бір екі бір екі үш
Dialogue: 0,0:39:08.72,0:39:11.72,Default,,0,0,0,,♪ «БІРІНШІ ЕСКЕРТПЕ»
Dialogue: 0,0:39:37.70,0:39:42.29,Default,,0,0,0,,Барабан, кеттің бе? Сіз өз шегіңізге жеткен сияқтысыз.
Dialogue: 0,0:39:42.38,0:39:46.21,Default,,0,0,0,,Жоқ, бірақ бұл екеуі...
Dialogue: 0,0:39:46.80,0:39:51.22,Default,,0,0,0,,Саксофон мен фортепиано Бұл мені 18 жасқа толды...
Dialogue: 0,0:41:10.34,0:41:12.05,Default,,0,0,0,,Ах... Ха...
Dialogue: 0,0:42:02.89,0:42:04.23,Default,,0,0,0,,Қандай соло
Dialogue: 0,0:42:09.06,0:42:11.23,Default,,0,0,0,,Бұл джаз
Dialogue: 0,0:42:22.41,0:42:23.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:42:43.01,0:42:43.68,Default,,0,0,0,,(Батырма басылған дыбысы)
Dialogue: 0,0:42:46.98,0:42:48.02,Default,,0,0,0,,Тамада
Dialogue: 0,0:42:48.10,0:42:49.60,Default,,0,0,0,,Ах! Енді түсіндім, сонда
Dialogue: 0,0:42:50.31,0:42:51.73,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:42:54.94,0:42:55.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:42:55.82,0:42:56.95,Default,,0,0,0,,Тіпті егер
Dialogue: 0,0:42:57.03,0:42:59.91,Default,,0,0,0,,Алғашқы тікелей шоудың іске қосылуы сауда автоматы болды.
Dialogue: 0,0:42:59.99,0:43:02.66,Default,,0,0,0,,Үш тұтынушы үшін ақы төлеудің қажеті жоқ.
Dialogue: 0,0:43:02.74,0:43:05.70,Default,,0,0,0,,Сондықтан әдісіңіз дұрыс емес.
Dialogue: 0,0:43:06.25,0:43:09.04,Default,,0,0,0,,Бұл күндері парақшалар таратып жатыр... бұл Токио, солай ма?
Dialogue: 0,0:43:09.37,0:43:10.75,Default,,0,0,0,,Бірақ сіз
Dialogue: 0,0:43:10.83,0:43:11.75,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:43:12.34,0:43:14.50,Default,,0,0,0,,Менің барабандарым босқа
Dialogue: 0,0:43:14.84,0:43:16.80,Default,,0,0,0,,Екеумізді тарта бердім.
Dialogue: 0,0:43:16.88,0:43:18.22,Default,,0,0,0,,Сәлем Тамада
Dialogue: 0,0:43:18.80,0:43:21.26,Default,,0,0,0,,Мен бұл топтан шығуым керек.
Dialogue: 0,0:43:21.34,0:43:23.68,Default,,0,0,0,,135 рет (Тамада) Иә?
Dialogue: 0,0:43:24.35,0:43:28.02,Default,,0,0,0,,Үшінші ән бойынша сіз 135 қате жібердіңіз.
Dialogue: 0,0:43:28.10,0:43:29.89,Default,,0,0,0,,Қалғанын санамаймын.
Dialogue: 0,0:43:30.60,0:43:32.61,Default,,0,0,0,,таңдау шайқасында соңына дейін жеңіске жетті,
Dialogue: 0,0:43:34.02,0:43:36.57,Default,,0,0,0,,Мен ойлағандай жаман болған жоқ.
Dialogue: 0,0:43:37.78,0:43:38.53,Default,,0,0,0,,Е...
Dialogue: 0,0:43:38.86,0:43:40.24,Default,,0,0,0,,Бұл үлкен
Dialogue: 0,0:43:40.78,0:43:41.49,Default,,0,0,0,,Хмм...
Dialogue: 0,0:43:42.62,0:43:43.45,Default,,0,0,0,,О
Dialogue: 0,0:43:43.87,0:43:45.62,Default,,0,0,0,,Юта Отокоцу
Dialogue: 0,0:43:46.20,0:43:47.41,Default,,0,0,0,,Бұл жақсы тірі шоу болды.
Dialogue: 0,0:43:48.33,0:43:49.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:50.83,0:43:53.46,Default,,0,0,0,,А-а-а, мен келесі жарты күндік жұмысыма баруым керек.
Dialogue: 0,0:43:53.54,0:43:54.46,Default,,0,0,0,,О... Мен де.
Dialogue: 0,0:43:54.54,0:43:56.00,Default,,0,0,0,,Тамада кездескенше
Dialogue: 0,0:43:56.09,0:43:57.05,Default,,0,0,0,,О
Dialogue: 0,0:44:01.84,0:44:04.68,Default,,0,0,0,,Мен саған әлі ерте дедім.
Dialogue: 0,0:44:06.31,0:44:08.31,Default,,0,0,0,,Мен мұны үнемі істемей тұра алмаймын.
Dialogue: 0,0:44:08.73,0:44:09.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:09.89,0:44:11.48,Default,,0,0,0,,Тамада қолынан келгеннің бәрін жасайды деп үміттенемін.
Dialogue: 0,0:44:12.69,0:44:15.69,Default,,0,0,0,,Ол бетті бізге жасағаныңыз дұрыс па?
Dialogue: 0,0:44:17.53,0:44:19.11,Default,,0,0,0,,Ол күлді
Dialogue: 0,0:44:19.36,0:44:21.57,Default,,0,0,0,,Өтірік күлімсіреу, салқындаған.
Dialogue: 0,0:44:22.57,0:44:24.53,Default,,0,0,0,,Еңбек ету адамның өзі үшін.
Dialogue: 0,0:44:25.08,0:44:27.49,Default,,0,0,0,,Сіз өзіңіз үшін көп жұмыс істеуіңіз керек емес пе?
Dialogue: 0,0:44:28.50,0:44:30.37,Default,,0,0,0,,Тамада күлді.
Dialogue: 0,0:44:30.62,0:44:31.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:32.04,0:44:33.54,Default,,0,0,0,,Мен сенемін
Dialogue: 0,0:44:33.96,0:44:35.42,Default,,0,0,0,,Оған сәттілік
Dialogue: 0,0:44:35.88,0:44:36.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:44:37.46,0:44:39.38,Default,,0,0,0,,Керемет
Dialogue: 0,0:44:39.46,0:44:41.42,Default,,0,0,0,,Бір рет өлу
Dialogue: 0,0:44:57.52,0:44:58.61,Default,,0,0,0,,Фу…
Dialogue: 0,0:45:00.36,0:45:02.11,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:45:29.22,0:45:30.52,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:45:31.22,0:45:32.98,Default,,0,0,0,,Мұны істеуге мәжбүрлемеңіз
Dialogue: 0,0:45:33.64,0:45:35.44,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:45:36.69,0:45:38.02,Default,,0,0,0,,Buha!
Dialogue: 0,0:45:40.53,0:45:44.32,Default,,0,0,0,,Тікелей эфирдегі алғашқы шоуымды есіме түсірсем де, суық тер шықты.
Dialogue: 0,0:45:44.40,0:45:48.49,Default,,0,0,0,,Бұл Дайдың алғашқы кәсіби жанды орындауы болды.
Dialogue: 0,0:45:48.99,0:45:52.66,Default,,0,0,0,,Иә, ол сол жолы бар күшімен үрледі.
Dialogue: 0,0:45:53.33,0:45:55.71,Default,,0,0,0,,Мен міндетті түрде барымды беруге мәжбүр болдым.
Dialogue: 0,0:45:57.04,0:46:01.09,Default,,0,0,0,,Ол қолынан келгенін жасап жатқандықтан, Юкиёши екеуміз де соңынан ердік.
Dialogue: 0,0:46:02.01,0:46:05.05,Default,,0,0,0,,Бұл соңғы тікелей шоуға әкелді.
Dialogue: 0,0:46:06.51,0:46:07.51,Default,,0,0,0,,Иә
Dialogue: 0,0:46:07.80,0:46:11.26,Default,,0,0,0,,Сол бір жарым жыл ең жақсы уақыт болды.
Dialogue: 0,0:46:11.97,0:46:14.60,Default,,0,0,0,,Мен бұл туралы әлі күнге дейін кеңселерімде мақтанамын.
Dialogue: 0,0:46:14.89,0:46:19.69,Default,,0,0,0,,«Мен Дай Миямотомен ең жақсы өнер көрсеттім».
Dialogue: 0,0:46:21.52,0:46:23.65,Default,,0,0,0,,Хе хе хе хе хе хе
Dialogue: 0,0:46:24.32,0:46:25.28,Default,,0,0,0,,Джажан!
Dialogue: 0,0:46:26.11,0:46:27.24,Default,,0,0,0,,JASS
Dialogue: 0,0:46:27.70,0:46:29.07,Default,,0,0,0,,Иә? (Тамада) JASS?
Dialogue: 0,0:46:29.49,0:46:31.20,Default,,0,0,0,,Иә, JASS?
Dialogue: 0,0:46:53.97,0:46:56.10,Default,,0,0,0,,Бүгін мен қанша қателік жібердім?
Dialogue: 0,0:46:57.48,0:46:59.40,Default,,0,0,0,,Хмм (Тамада) 80?
Dialogue: 0,0:47:00.23,0:47:01.23,Default,,0,0,0,,Иә
Dialogue: 0,0:47:02.82,0:47:03.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:06.07,0:47:08.36,Default,,0,0,0,,Қайтадан сипау
Dialogue: 0,0:47:53.41,0:47:56.66,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:48:00.46,0:48:02.25,Default,,0,0,0,,Мм... Эй... Қайырлы кеш...
Dialogue: 0,0:48:02.33,0:48:04.13,Default,,0,0,0,,Қайырлы кеш, бұл JASS.
Dialogue: 0,0:48:04.21,0:48:10.47,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:48:10.55,0:48:12.05,Default,,0,0,0,,Бұл JASS!
Dialogue: 0,0:48:14.72,0:48:17.85,Default,,0,0,0,,Үлкен Бүгін қанша адам бар деп ойлайсыз?
Dialogue: 0,0:48:17.93,0:48:21.10,Default,,0,0,0,,Хмм...м...көп пе?
Dialogue: 0,0:48:21.77,0:48:22.98,Default,,0,0,0,,Я...
Dialogue: 0,0:48:23.06,0:48:24.31,Default,,0,0,0,,32 адам
Dialogue: 0,0:48:24.40,0:48:25.23,Default,,0,0,0,,Соншама?
Dialogue: 0,0:48:25.32,0:48:26.23,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:48:26.73,0:48:27.82,Default,,0,0,0,,Бұл таңқаларлық
Dialogue: 0,0:48:28.36,0:48:30.57,Default,,0,0,0,,Сонымен бұл не?
Dialogue: 0,0:48:30.65,0:48:31.74,Default,,0,0,0,,Уау
Dialogue: 0,0:48:31.82,0:48:32.74,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:48:32.82,0:48:34.62,Default,,0,0,0,,Иә, бүгінгі түнгі төлем.
Dialogue: 0,0:48:34.70,0:48:35.53,Default,,0,0,0,,Азассу
Dialogue: 0,0:48:36.74,0:48:37.49,Default,,0,0,0,,Ха…
Dialogue: 0,0:48:38.87,0:48:41.71,Default,,0,0,0,,Мен бірінші рет лайықты өтемақы алып отырмын.
Dialogue: 0,0:48:44.88,0:48:47.21,Default,,0,0,0,,Бүгін мен қанша қателік жібердім?
Dialogue: 0,0:48:48.30,0:48:50.51,Default,,0,0,0,,Ең үлкен сан 38 рет.
Dialogue: 0,0:48:50.59,0:48:52.93,Default,,0,0,0,,Кіші - екі есе.
Dialogue: 0,0:48:53.47,0:48:54.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:56.51,0:48:58.81,Default,,0,0,0,,Неліктен Дай джаз? (Үлкен) Иә?
Dialogue: 0,0:48:59.14,0:49:00.89,Default,,0,0,0,,Өйткені мен фортепиано сыныбында оқимын
Dialogue: 0,0:49:00.98,0:49:03.90,Default,,0,0,0,,Мен мұны есіме түскеннен бері істеп жүрмін.
Dialogue: 0,0:49:03.98,0:49:06.40,Default,,0,0,0,,Токио монахынан күткендей.
Dialogue: 0,0:49:06.48,0:49:08.27,Default,,0,0,0,,Иә? Бұл дұрыс.
Dialogue: 0,0:49:08.36,0:49:11.28,Default,,0,0,0,,Мен Жапониядағы ең керемет Нагано азаматымын.
Dialogue: 0,0:49:11.36,0:49:13.03,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:49:13.53,0:49:15.11,Default,,0,0,0,,Дайда олай емес.
Dialogue: 0,0:49:15.20,0:49:17.20,Default,,0,0,0,,Неліктен джаз?
Dialogue: 0,0:49:18.41,0:49:19.58,Default,,0,0,0,,Джаз – бұл...
Dialogue: 0,0:49:20.62,0:49:23.04,Default,,0,0,0,,Бұл өте ыстық және қарқынды
Dialogue: 0,0:49:23.54,0:49:24.92,Default,,0,0,0,,Фуфу
Dialogue: 0,0:49:25.00,0:49:26.79,Default,,0,0,0,,Басқа музыканың айырмашылығы бар ма?
Dialogue: 0,0:49:27.13,0:49:28.80,Default,,0,0,0,,Айтайын дегенім, жоқ.
Dialogue: 0,0:49:28.88,0:49:30.30,Default,,0,0,0,,Хмм...
Dialogue: 0,0:49:30.38,0:49:32.22,Default,,0,0,0,,Джаз музыкасы эмоционалды ма?
Dialogue: 0,0:49:32.55,0:49:33.63,Default,,0,0,0,,Сезім туралы?
Dialogue: 0,0:49:33.72,0:49:34.55,Default,,0,0,0,,О
Dialogue: 0,0:49:34.63,0:49:38.22,Default,,0,0,0,,Сол күні мен сол сәтті ойға алғанымды әуенге айналдыру
Dialogue: 0,0:49:38.93,0:49:40.18,Default,,0,0,0,,Әр күн әр түрлі
Dialogue: 0,0:49:41.22,0:49:43.27,Default,,0,0,0,,Сондықтан ешқандай шектеу болмауы керек.
Dialogue: 0,0:49:43.85,0:49:46.15,Default,,0,0,0,,Сіз бұрын айтқан соло туралы айтасыз ба?
Dialogue: 0,0:49:47.56,0:49:48.27,Default,,0,0,0,,Үлкен
Dialogue: 0,0:49:48.69,0:49:50.98,Default,,0,0,0,,Жақында үшеуміздің алдымызға мақсат қоюымыз керек емес пе?
Dialogue: 0,0:49:51.07,0:49:52.07,Default,,0,0,0,,Мақсат?
Dialogue: 0,0:49:52.15,0:49:53.95,Default,,0,0,0,,Не? Яғни, үш адам бар...
Dialogue: 0,0:49:54.03,0:49:55.49,Default,,0,0,0,,Сонымен, сіз Тамаданы ресми еткіңіз келе ме?
Dialogue: 0,0:49:57.78,0:49:59.45,Default,,0,0,0,,Тамада Сіз мұны естідіңіз бе?
Dialogue: 0,0:49:59.53,0:50:02.04,Default,,0,0,0,,Қараңызшы, күйіп қалды.
Dialogue: 0,0:50:04.04,0:50:06.29,Default,,0,0,0,,Тамада, сен
Dialogue: 0,0:50:07.13,0:50:08.13,Default,,0,0,0,,Не?
Dialogue: 0,0:50:09.21,0:50:12.34,Default,,0,0,0,,Сіз ет грильде өте жақсысыз.
Dialogue: 0,0:50:19.76,0:50:21.01,Default,,0,0,0,,Өйткені, ол осында.
Dialogue: 0,0:50:22.22,0:50:25.18,Default,,0,0,0,,Осы сахнада жасөспірім кезінде тұру
Dialogue: 0,0:50:25.27,0:50:27.48,Default,,0,0,0,,Не? Сонымен көк?
Dialogue: 0,0:50:28.06,0:50:30.27,Default,,0,0,0,,Жапонияның ең жақсы джаз клубы
Dialogue: 0,0:50:30.36,0:50:31.86,Default,,0,0,0,,Бұл Жапониядағы ең жақсы жер ме?
Dialogue: 0,0:50:32.86,0:50:35.53,Default,,0,0,0,,Тамада Бүгінгі музыкалық төлеміңіз қанша?
Dialogue: 0,0:50:35.61,0:50:36.70,Default,,0,0,0,,2000 иен
Dialogue: 0,0:50:36.78,0:50:38.70,Default,,0,0,0,,Сонымен Көк 10 000 болады
Dialogue: 0,0:50:38.78,0:50:40.37,Default,,0,0,0,,Иә, керемет
Dialogue: 0,0:50:40.45,0:50:43.37,Default,,0,0,0,,Сондықтан сыйымдылығы 250 адам.
Dialogue: 0,0:50:43.45,0:50:46.33,Default,,0,0,0,,Шынымен, мұнда жасөспірім бар ма?
Dialogue: 0,0:50:47.17,0:50:49.54,Default,,0,0,0,,Бар болғаны бір жыл қалды.
Dialogue: 0,0:50:49.63,0:50:50.88,Default,,0,0,0,,Мен барамын.
Dialogue: 0,0:50:50.96,0:50:51.88,Default,,0,0,0,,О
Dialogue: 0,0:50:52.30,0:50:53.38,Default,,0,0,0,,Дабе?
Dialogue: 0,0:50:56.92,0:50:59.05,Default,,0,0,0,,Мен екеуін де ұшырып жіберемін.
Dialogue: 0,0:51:00.80,0:51:01.51,Default,,0,0,0,,Иә
Dialogue: 0,0:51:02.22,0:51:04.43,Default,,0,0,0,,Егер қолыңыздан келсе, жасап көріңіз.
Dialogue: 0,0:51:11.36,0:51:14.11,Default,,0,0,0,,Балалар сендерді фестиваль қызықтырады ма?
Dialogue: 0,0:51:14.19,0:51:15.03,Default,,0,0,0,,Не болды?
Dialogue: 0,0:51:15.11,0:51:16.99,Default,,0,0,0,,Маған телефон қоңырауы келді.
Dialogue: 0,0:51:17.36,0:51:20.03,Default,,0,0,0,,Ол бізден фестивальге келгіміз келе ме деп сұрады.
Dialogue: 0,0:51:20.11,0:51:21.16,Default,,0,0,0,,Фестиваль?
Dialogue: 0,0:51:21.66,0:51:22.87,Default,,0,0,0,,Бұл қандай мереке?
Dialogue: 0,0:51:23.24,0:51:25.29,Default,,0,0,0,,Кацушика джаз фестивалі
Dialogue: 0,0:51:25.37,0:51:27.96,Default,,0,0,0,,Іс-шара бір айдан кейін өтеді.
Dialogue: 0,0:51:28.33,0:51:32.13,Default,,0,0,0,,Хмм... Қалашықты жандандыру үшін шағын көлемдегі джаз фестивалі ме?
Dialogue: 0,0:51:32.46,0:51:34.46,Default,,0,0,0,,Фестивальдің ерекшелігі - акт
Dialogue: 0,0:51:34.55,0:51:36.13,Default,,0,0,0,,Аманума деген пианист...
Dialogue: 0,0:51:36.21,0:51:37.76,Default,,0,0,0,,Өте танымал
Dialogue: 0,0:51:37.84,0:51:41.97,Default,,0,0,0,,Юкисей Аманума сыншы және бұқаралық ақпарат құралдарында жиі шығады.
Dialogue: 0,0:51:42.05,0:51:44.06,Default,,0,0,0,,А, бұл адам?
Dialogue: 0,0:51:44.39,0:51:45.47,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:51:46.06,0:51:47.93,Default,,0,0,0,,Шамасы, Тори бұл әрекет.
Dialogue: 0,0:51:48.27,0:51:51.77,Default,,0,0,0,,Оған дейін оны жандандыру керек сияқты.
Dialogue: 0,0:51:52.52,0:51:55.07,Default,,0,0,0,,Сонымен, өтетін орын үлкен бе?
Dialogue: 0,0:51:56.32,0:51:58.69,Default,,0,0,0,,Ойын ба деп ойлаймын
Dialogue: 0,0:51:58.78,0:51:59.65,Default,,0,0,0,,Бұл ойын ма?
Dialogue: 0,0:52:00.24,0:52:01.45,Default,,0,0,0,,Мерекелерге келгенде
Dialogue: 0,0:52:01.53,0:52:04.33,Default,,0,0,0,,Мұнда джаз индустриясының көптеген адамдары да болады.
Dialogue: 0,0:52:04.41,0:52:06.58,Default,,0,0,0,,Егер сізді пайдасыз топ деп атаса
Dialogue: 0,0:52:06.66,0:52:09.58,Default,,0,0,0,,Мені өмір бойы ешқайда шақырмайды.
Dialogue: 0,0:52:09.66,0:52:11.17,Default,,0,0,0,,Шие… Бұл Хассаикай ма еді?
Dialogue: 0,0:52:11.25,0:52:14.67,Default,,0,0,0,,Біздің музыкамызды көптеген адамдар тыңдай алады
Dialogue: 0,0:52:14.75,0:52:17.00,Default,,0,0,0,,Бұл тұтынушылардың санын көбейту мүмкіндігі
Dialogue: 0,0:52:17.09,0:52:17.84,Default,,0,0,0,,Иә
Dialogue: 0,0:52:17.92,0:52:20.76,Default,,0,0,0,,Қалай болғанда да, бұл ұзақ ату.
Dialogue: 0,0:52:24.01,0:52:26.22,Default,,0,0,0,,Бүгінгі уақытыңызды бөліп келгендеріңізге көп рахмет.
Dialogue: 0,0:52:26.68,0:52:29.73,Default,,0,0,0,,Осы жерден біз қоғамдық жиынға көшеміз.
Dialogue: 0,0:52:29.81,0:52:31.98,Default,,0,0,0,,Олай болса, барлық орындаушылар.
Dialogue: 0,0:52:32.06,0:52:32.85,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:52:33.35,0:52:34.69,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:52:38.53,0:52:40.03,Default,,0,0,0,,Мм... бұл жолы.
Dialogue: 0,0:52:40.36,0:52:42.86,Default,,0,0,0,,Біреу бізге кеңес берген сияқты.
Dialogue: 0,0:52:42.95,0:52:44.28,Default,,0,0,0,,Рахмет
Dialogue: 0,0:52:44.37,0:52:46.95,Default,,0,0,0,,Жоқ, бұл мен емес.
Dialogue: 0,0:52:47.03,0:52:47.95,Default,,0,0,0,,Сәлем
Dialogue: 0,0:52:48.37,0:52:49.75,Default,,0,0,0,,Көлденең дұрыс па?
Dialogue: 0,0:52:49.83,0:52:50.91,Default,,0,0,0,,Иә
Dialogue: 0,0:52:51.25,0:52:53.83,Default,,0,0,0,,Балалар, сендерге мен кеңес бердім.
Dialogue: 0,0:52:53.92,0:52:55.38,Default,,0,0,0,,Иә, рас па?
Dialogue: 0,0:52:55.75,0:52:57.13,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:52:57.21,0:52:59.21,Default,,0,0,0,,Бірақ біз қай жерде тікелей эфирде өнер көрсетеміз?
Dialogue: 0,0:52:59.55,0:53:02.05,Default,,0,0,0,,Жоқ, мен оны көрген де, естіген де емеспін.
Dialogue: 0,0:53:02.26,0:53:02.72,Default,,0,0,0,,Е...
Dialogue: 0,0:53:02.72,0:53:03.34,Default,,0,0,0,,Е...
Dialogue: 0,0:53:02.72,0:53:03.34,Default,,0,0,0,,Мен бір танысымнан жас, жігерлі адам бар ма деп сұрадым.
Dialogue: 0,0:53:03.34,0:53:06.26,Default,,0,0,0,,Мен бір танысымнан жас, жігерлі адам бар ма деп сұрадым.
Dialogue: 0,0:53:06.35,0:53:08.64,Default,,0,0,0,,Сіздің атыңыз шығады.
Dialogue: 0,0:53:08.72,0:53:11.81,Default,,0,0,0,,Осындай фестивальдер жастар арасында танымал.
Dialogue: 0,0:53:12.27,0:53:15.19,Default,,0,0,0,,Сәтсіздік қандай да бір түрде сүйкімді ме?
Dialogue: 0,0:53:15.27,0:53:17.15,Default,,0,0,0,,Сол жігіт… Көзіне латкі таққан Какужа ма?
Dialogue: 0,0:53:17.61,0:53:19.86,Default,,0,0,0,,...Сонымен кімнің музыкасы ойнап тұр?
Dialogue: 0,0:53:20.44,0:53:22.32,Default,,0,0,0,,Мен негізінен түпнұсқалармен жұмыс істеймін.
Dialogue: 0,0:53:22.40,0:53:25.41,Default,,0,0,0,,Режим жүйесі? Керемет түрі? Боп?
Dialogue: 0,0:53:25.49,0:53:27.58,Default,,0,0,0,,Жоқ, ондай байланыс жоқ.
Dialogue: 0,0:53:27.66,0:53:28.45,Default,,0,0,0,,Джаз
Dialogue: 0,0:53:28.95,0:53:30.41,Default,,0,0,0,,Бұл тым анық емес.
Dialogue: 0,0:53:30.75,0:53:31.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:31.75,0:53:34.29,Default,,0,0,0,,Біз де миымызды пайдаланамыз.
Dialogue: 0,0:53:34.37,0:53:37.46,Default,,0,0,0,,азайып бара жатқан джаз әуесқойларының қажеттіліктерін қанағаттандыру
Dialogue: 0,0:53:37.54,0:53:39.50,Default,,0,0,0,,Жай ғана джаз ойнау.
Dialogue: 0,0:53:39.59,0:53:42.34,Default,,0,0,0,,Мен ет тоқаш па, пицца ма деп айта алмайтын жасөспіріммін.
Dialogue: 0,0:53:43.22,0:53:45.51,Default,,0,0,0,,Сонда ол сатылмайды.
Dialogue: 0,0:53:46.30,0:53:47.30,Default,,0,0,0,,Сіз мұны істейсіз бе?
Dialogue: 0,0:53:47.39,0:53:48.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:49.22,0:53:51.52,Default,,0,0,0,,Біз мүмкіндігінше көп адамға көмектескіміз келеді
Dialogue: 0,0:53:51.85,0:53:54.94,Default,,0,0,0,,Біз адамдарға музыкамыз туралы хабарлау үшін өнер көрсетеміз.
Dialogue: 0,0:53:55.02,0:53:57.36,Default,,0,0,0,,Тыңдасаң түсінерсің деп ойлаймын.
Dialogue: 0,0:53:57.77,0:53:58.90,Default,,0,0,0,,Сонда не?
Dialogue: 0,0:53:58.98,0:54:01.19,Default,,0,0,0,,Егер адамдар біз туралы білсе, бізді тыңдауға келген адамдар да біледі
Dialogue: 0,0:54:01.28,0:54:03.53,Default,,0,0,0,,Мен сенің жанкүйерің болатыныма сенімдісің бе?
Dialogue: 0,0:54:03.61,0:54:04.53,Default,,0,0,0,,Иә!
Dialogue: 0,0:54:04.61,0:54:05.99,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:54:06.07,0:54:08.78,Default,,0,0,0,,Жақсы, ақымақ сезім.
Dialogue: 0,0:54:08.87,0:54:10.70,Default,,0,0,0,,Жасөспірімге ұқсайды
Dialogue: 0,0:54:11.29,0:54:12.62,Default,,0,0,0,,Аманума мырза
Dialogue: 0,0:54:13.08,0:54:14.16,Default,,0,0,0,,Хигучи расталды.
Dialogue: 0,0:54:14.66,0:54:18.13,Default,,0,0,0,,Аманума мырза, қойылымымызды тыңдаңыз.
Dialogue: 0,0:54:19.50,0:54:22.21,Default,,0,0,0,,Енді кешіріңіз, менде біраз жаттығу керек.
Dialogue: 0,0:54:27.34,0:54:30.81,Default,,0,0,0,,Иә? Аманума жиіркенішті.
Dialogue: 0,0:54:30.89,0:54:31.93,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:54:32.01,0:54:33.22,Default,,0,0,0,,Актінің жанкүйерлері
Dialogue: 0,0:54:33.31,0:54:35.10,Default,,0,0,0,,Ол сені бізге жанкүйер ететінін айтты.
Dialogue: 0,0:54:35.60,0:54:37.44,Default,,0,0,0,,Иә, сізге ұқсайды.
Dialogue: 0,0:54:37.77,0:54:41.44,Default,,0,0,0,,Ал, енді біз жеңуіміз керек.
Dialogue: 0,0:54:41.52,0:54:44.61,Default,,0,0,0,,Алдымен актінің дыбысын зерттеңіз.
Dialogue: 0,0:54:44.69,0:54:46.90,Default,,0,0,0,,Клиенттерге не ұнайтынын білгіңіз келе ме?
Dialogue: 0,0:54:46.99,0:54:48.24,Default,,0,0,0,,Оны лақтырып жіберейік
Dialogue: 0,0:54:48.32,0:54:49.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:49.70,0:54:52.99,Default,,0,0,0,,Егер біз мұнда екінші жағына бейімделсек, ол біз болмаймыз.
Dialogue: 0,0:54:53.08,0:54:55.12,Default,,0,0,0,,Сонда не істейміз?
Dialogue: 0,0:54:55.20,0:54:56.33,Default,,0,0,0,,Күшті болыңыз
Dialogue: 0,0:54:56.96,0:54:59.88,Default,,0,0,0,,Әрқайсымыз қатты дыбыс шығарайық
Dialogue: 0,0:55:00.67,0:55:03.09,Default,,0,0,0,,Бұл тым анық емес пе?
Dialogue: 0,0:55:03.17,0:55:05.09,Default,,0,0,0,,Арнайы күштірек болыңыз!
Dialogue: 0,0:55:14.31,0:55:15.77,Default,,0,0,0,,Әй, қар дұғасы
Dialogue: 0,0:55:16.31,0:55:17.44,Default,,0,0,0,,Үлкен сыртта
Dialogue: 0,0:55:17.52,0:55:19.19,Default,,0,0,0,,Ұялы телефоныңызды қалдырыңыз ба?
Dialogue: 0,0:55:19.27,0:55:20.35,Default,,0,0,0,,Мен жүгіруге бардым.
Dialogue: 0,0:55:20.44,0:55:21.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:21.48,0:55:23.15,Default,,0,0,0,,А... мен айтпадым ба?
Dialogue: 0,0:55:23.23,0:55:26.57,Default,,0,0,0,,Мен екі апта бойы күн сайын 3 сағат жүгіремін.
Dialogue: 0,0:55:26.65,0:55:29.53,Default,,0,0,0,,Жүрек-өкпе қызметін жақсартады дейді.
Dialogue: 0,0:55:29.61,0:55:30.82,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:55:31.24,0:55:34.20,Default,,0,0,0,,Оның дыбысы күшейе түседі.
Dialogue: 0,0:55:34.29,0:55:35.37,Default,,0,0,0,,...ал сіз?
Dialogue: 0,0:55:35.79,0:55:38.83,Default,,0,0,0,,Мен ондай ақсақ істермен айналыспаймын.
Dialogue: 0,0:55:39.42,0:55:42.79,Default,,0,0,0,,Үйде отырып, ақылды түрде істеп жатырмын.
Dialogue: 0,0:55:54.56,0:55:58.68,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:56:01.60,0:56:05.61,Default,,0,0,0,,Жаңа, ескі, жанр, Маған бәрібір.
Dialogue: 0,0:56:06.11,0:56:07.74,Default,,0,0,0,,Жақсы нәрсе жақсы
Dialogue: 0,0:56:13.20,0:56:15.16,Default,,0,0,0,,Уау Хиро
Dialogue: 0,0:56:15.53,0:56:19.12,Default,,0,0,0,,А, бұл біз бұрын-соңды басынан өткергеннен де үлкен.
Dialogue: 0,0:56:19.66,0:56:22.08,Default,,0,0,0,,Ябе, мен қобалжыдым.
Dialogue: 0,0:56:22.17,0:56:24.00,Default,,0,0,0,,Уайымдама, Тамада.
Dialogue: 0,0:56:24.09,0:56:27.38,Default,,0,0,0,,Мен орта мектепте оқып жүргенде үлкенірек жерде өнер көрсеттім.
Dialogue: 0,0:56:27.71,0:56:29.55,Default,,0,0,0,,Оны жұбату ретінде қабылдамаңыз.
Dialogue: 0,0:56:29.63,0:56:31.43,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:56:32.09,0:56:33.93,Default,,0,0,0,,Сіз көп жүгірдіңіз.
Dialogue: 0,0:56:34.01,0:56:35.85,Default,,0,0,0,,Оның жасы үлкен екенін білетінмін, бірақ бұл…
Dialogue: 0,0:56:36.31,0:56:39.39,Default,,0,0,0,,Бұл менің жалғыз аяқ киімім, хахаха...
Dialogue: 0,0:56:39.48,0:56:40.73,Default,,0,0,0,,Ах... (үлкен) Иә?
Dialogue: 0,0:56:41.06,0:56:42.60,Default,,0,0,0,,Миямото мырза
Dialogue: 0,0:56:42.69,0:56:43.56,Default,,0,0,0,,А, сәлем
Dialogue: 0,0:56:43.94,0:56:46.11,Default,,0,0,0,,Бүгін танысқаныма қуаныштымын.
Dialogue: 0,0:56:46.61,0:56:47.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:47.94,0:56:50.07,Default,,0,0,0,,Сахналық киімдеріңіз қандай?
Dialogue: 0,0:56:50.15,0:56:51.15,Default,,0,0,0,,Оны осылай қалдырыңыз
Dialogue: 0,0:56:51.61,0:56:53.95,Default,,0,0,0,,А... иә, жарайды.
Dialogue: 0,0:56:54.03,0:56:55.62,Default,,0,0,0,,Жас жігітке ұқсайды
Dialogue: 0,0:56:56.33,0:56:58.99,Default,,0,0,0,,Жарайсыңдар, балалар, не болса да жақсысыңдар.
Dialogue: 0,0:56:59.08,0:57:02.33,Default,,0,0,0,,Сондықтан біз Ториге келдік.
Dialogue: 0,0:57:02.92,0:57:05.29,Default,,0,0,0,,Эй, Миямото-кун, өткен күні...
Dialogue: 0,0:57:06.04,0:57:08.55,Default,,0,0,0,,Соңында осылай болды.
Dialogue: 0,0:57:08.63,0:57:10.51,Default,,0,0,0,,Тым қобалжымаңыз
Dialogue: 0,0:57:10.59,0:57:12.30,Default,,0,0,0,,Демалу
Dialogue: 0,0:57:12.59,0:57:14.80,Default,,0,0,0,,Біз оны қызықты ету үшін бар күшімізді саламыз
Dialogue: 0,0:57:14.89,0:57:16.89,Default,,0,0,0,,Сондықтан Аманума мырза және т.б
Dialogue: 0,0:57:20.31,0:57:22.02,Default,,0,0,0,,Мұнда Он екі Құбыжық Айдың тек Төменгі Айлары ғана жиналған
Dialogue: 0,0:57:27.06,0:57:32.90,Default,,0,0,0,,♪「Самба бесі」
Dialogue: 0,0:57:34.74,0:57:36.95,Default,,0,0,0,,150-ге жуық тұтынушы болды.
Dialogue: 0,0:57:37.99,0:57:40.41,Default,,0,0,0,,Заң күшіне енгенше көбірек болады.
Dialogue: 0,0:57:40.49,0:57:42.41,Default,,0,0,0,,Тамада концентраты (Тамада) Оу
Dialogue: 0,0:57:42.50,0:57:44.42,Default,,0,0,0,,Әділ толқу
Dialogue: 0,0:57:44.50,0:57:47.00,Default,,0,0,0,,Көрермендер актіні іздейді.
Dialogue: 0,0:57:48.42,0:57:50.67,Default,,0,0,0,,Мен басында қатты дыбысты қалаймын.
Dialogue: 0,0:57:51.42,0:57:53.63,Default,,0,0,0,,Не? Конфигурацияны өзгерткіңіз келе ме?
Dialogue: 0,0:57:54.09,0:57:55.84,Default,,0,0,0,,Ол одан да бәсекеге қабілетті болады.
Dialogue: 0,0:57:56.43,0:57:57.85,Default,,0,0,0,,Бұл жарыс емес
Dialogue: 0,0:57:58.47,0:58:00.56,Default,,0,0,0,,Бұл тұтынушыға қалай әсер етеді?
Dialogue: 0,0:58:00.93,0:58:02.06,Default,,0,0,0,,Мен бірінші барамын.
Dialogue: 0,0:58:03.89,0:58:07.40,Default,,0,0,0,,Олай болса, «N.E.W.» дегенді ауыстырайық. бірінші әнімен.
Dialogue: 0,0:58:07.94,0:58:08.69,Default,,0,0,0,,О
Dialogue: 0,0:58:08.77,0:58:11.15,Default,,0,0,0,,Тамада: Кіріспе сөзді үлкенімен сәйкестендірейік.
Dialogue: 0,0:58:11.23,0:58:12.65,Default,,0,0,0,,Олар жай ғана тірі қалуға тиіс емес.
Dialogue: 0,0:58:12.74,0:58:14.86,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:58:15.20,0:58:17.82,Default,,0,0,0,,Сәлеметсіз бе, бұл Domino Five!
Dialogue: 0,0:58:18.20,0:58:19.62,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:58:19.99,0:58:21.66,Default,,0,0,0,,Мен оның өтетініне сенімдімін
Dialogue: 0,0:58:27.21,0:58:28.46,Default,,0,0,0,,Аа, Кавакита мырза
Dialogue: 0,0:58:28.54,0:58:32.09,Default,,0,0,0,,Иә? Ah... 21 Музыка...
Dialogue: 0,0:58:32.17,0:58:33.34,Default,,0,0,0,,Бұл 50 ұлулар.
Dialogue: 0,0:58:33.42,0:58:36.05,Default,,0,0,0,,Бұл әдеттен тыс. Сіз актіні көруге келдіңіз бе?
Dialogue: 0,0:58:36.13,0:58:38.68,Default,,0,0,0,,Жоқ, мені жаңа ғана шақырды.
Dialogue: 0,0:58:38.76,0:58:39.51,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:58:40.30,0:58:40.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:43.72,0:58:48.10,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,0:59:00.53,0:59:01.49,Default,,0,0,0,,Не болды?
Dialogue: 0,0:59:01.58,0:59:03.45,Default,,0,0,0,,Сіз қобалжыдыңыз ба?
Dialogue: 0,0:59:05.70,0:59:07.08,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:59:10.21,0:59:13.25,Default,,0,0,0,,♪ «Н.Е.В.»
Dialogue: 0,1:03:01.52,1:03:02.23,Default,,0,0,0,,Эй!
Dialogue: 0,1:03:21.59,1:03:26.59,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,1:03:31.76,1:03:34.06,Default,,0,0,0,,Жақсы, мен оны аяқтадым.
Dialogue: 0,1:03:34.14,1:03:35.27,Default,,0,0,0,,Су! Су…
Dialogue: 0,1:03:35.35,1:03:36.39,Default,,0,0,0,,Фу…
Dialogue: 0,1:03:36.77,1:03:39.73,Default,,0,0,0,,Ең қызықты бөлім
Dialogue: 0,1:03:39.81,1:03:41.73,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:42.94,1:03:45.23,Default,,0,0,0,,Қолайсыздықтар үшін кешірім сұраймыз.
Dialogue: 0,1:03:45.32,1:03:47.69,Default,,0,0,0,,21 Менің атым Музыкадан Исағай.
Dialogue: 0,1:03:48.15,1:03:50.86,Default,,0,0,0,,Маған біраз уақыт бере аласыз ба?
Dialogue: 0,1:03:51.37,1:03:52.45,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:56.54,1:03:58.21,Default,,0,0,0,,Жарайсың (Тамада) Ах...
Dialogue: 0,1:03:58.29,1:03:59.79,Default,,0,0,0,,Жақсы
Dialogue: 0,1:03:59.87,1:04:03.17,Default,,0,0,0,,Клиенттер бізді есіне алғанына сенімдімін.
Dialogue: 0,1:04:03.25,1:04:05.17,Default,,0,0,0,,Бұл қызықты болды.
Dialogue: 0,1:04:05.25,1:04:07.34,Default,,0,0,0,,Тіпті рекордтық компанияның адамдары да.
Dialogue: 0,1:04:07.92,1:04:10.55,Default,,0,0,0,,Сіз мүмкіндіктерді зерттегіңіз келетінін айттыңыз.
Dialogue: 0,1:04:10.63,1:04:13.43,Default,,0,0,0,,Егер мұндай нәрселер пайда бола берсе, олар жоғалады.
Dialogue: 0,1:04:14.22,1:04:15.43,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,1:04:15.51,1:04:17.27,Default,,0,0,0,,Бұл өте алыс.
Dialogue: 0,1:04:17.35,1:04:20.23,Default,,0,0,0,,Альбомның шығарылымы айға саяхат болса ше?
Dialogue: 0,1:04:20.31,1:04:23.27,Default,,0,0,0,,Бұл әлі Атами...әлде Шинагава емес пе?
Dialogue: 0,1:04:23.61,1:04:24.73,Default,,0,0,0,,Тіпті егер
Dialogue: 0,1:04:25.11,1:04:29.28,Default,,0,0,0,,Бұл адам маған айға бару үшін келді.
Dialogue: 0,1:04:30.20,1:04:32.82,Default,,0,0,0,,Мен жақсаруым керек.
Dialogue: 0,1:04:32.91,1:04:37.12,Default,,0,0,0,,Аа, мен әлі өзім билет ала алмаймын.
Dialogue: 0,1:04:38.75,1:04:39.79,Default,,0,0,0,,Міне, Абдул мырза дәл осылай дейді
Dialogue: 0,1:04:40.21,1:04:43.42,Default,,0,0,0,,Тамада да, бірақ біз көп нәрсені істей аламыз.
Dialogue: 0,1:04:43.71,1:04:45.88,Default,,0,0,0,,Сіз одан да жақсы ойнай алуыңыз керек.
Dialogue: 0,1:04:46.42,1:04:47.84,Default,,0,0,0,,ше? мен?
Dialogue: 0,1:04:49.67,1:04:50.88,Default,,0,0,0,,Мен де бүгін ойладым.
Dialogue: 0,1:04:50.97,1:04:53.72,Default,,0,0,0,,Сіздің сололарыңыз әрқашан бірдей естіледі емес пе?
Dialogue: 0,1:04:56.43,1:04:57.31,Default,,0,0,0,,Олар ұқсас па?
Dialogue: 0,1:04:58.02,1:04:59.81,Default,,0,0,0,,Соло импровизацияланған.
Dialogue: 0,1:05:00.23,1:05:04.19,Default,,0,0,0,,Менің ойымша, егер әр уақытта әр түрлі болмаса, тұтынушылар жалықтырады.
Dialogue: 0,1:05:05.36,1:05:06.27,Default,,0,0,0,,Әзірше
Dialogue: 0,1:05:06.36,1:05:07.82,Default,,0,0,0,,Жоғары сапалы өнімділік
Dialogue: 0,1:05:07.82,1:05:08.86,Default,,0,0,0,,Бұл маңызды.
Dialogue: 0,1:05:09.28,1:05:11.36,Default,,0,0,0,,Егер сіз өзіңізді жақсы орындасаңыз, ешқандай проблема болмайды.
Dialogue: 0,1:05:11.99,1:05:14.03,Default,,0,0,0,,Жалғыз тәуекел Тамада.
Dialogue: 0,1:05:14.11,1:05:15.07,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:05:15.16,1:05:18.16,Default,,0,0,0,,Жеңіске жету жақсы орындаудан маңыздырақ.
Dialogue: 0,1:05:18.24,1:05:20.29,Default,,0,0,0,,Бүгінгі күннің мақсаты осы, солай ма?
Dialogue: 0,1:05:31.38,1:05:33.05,Default,,0,0,0,,Ата-анамның фортепиано сыныбында.
Dialogue: 0,1:05:33.43,1:05:34.30,Default,,0,0,0,,Иә?
Dialogue: 0,1:05:34.38,1:05:37.76,Default,,0,0,0,,Менен сәл жоғарыда бір студент қыз бар еді.
Dialogue: 0,1:05:38.26,1:05:41.48,Default,,0,0,0,,Ол әрқашан фортепианода қуана ойнайтын.
Dialogue: 0,1:05:43.52,1:05:45.27,Default,,0,0,0,,Балаға қара
Dialogue: 0,1:05:45.85,1:05:48.44,Default,,0,0,0,,Мен де пианинода ойнағым келді.
Dialogue: 0,1:05:52.53,1:05:54.24,Default,,0,0,0,,Бір күні бала
Dialogue: 0,1:05:54.86,1:05:56.45,Default,,0,0,0,,Мен түнде ата-анаммен қашып кеттім.
Dialogue: 0,1:05:58.03,1:06:01.16,Default,,0,0,0,,Соңғы рет үйіме сәлем беруге келдім.
Dialogue: 0,1:06:01.24,1:06:02.87,Default,,0,0,0,,Сонда анам...
Dialogue: 0,1:06:03.91,1:06:06.83,Default,,0,0,0,,Аои-чан, пианинода ойнауды жалғастырыңыз.
Dialogue: 0,1:06:09.13,1:06:09.80,Default,,0,0,0,,Иә
Dialogue: 0,1:06:11.76,1:06:13.67,Default,,0,0,0,,Жақында кездескенше, Юки-чан
Dialogue: 0,1:06:19.39,1:06:21.64,Default,,0,0,0,,Жалғастыруға ешқандай мүмкіндік жоқ.
Dialogue: 0,1:06:22.06,1:06:24.98,Default,,0,0,0,,Музыканы жалғастыру үшін жағдайлар бар.
Dialogue: 0,1:06:25.73,1:06:27.77,Default,,0,0,0,,Сондықтан біз жеңуіміз керек
Dialogue: 0,1:06:28.52,1:06:30.11,Default,,0,0,0,,Жалғастырыңыз
Dialogue: 0,1:06:30.73,1:06:31.78,Default,,0,0,0,,Иә?
Dialogue: 0,1:06:32.19,1:06:33.65,Default,,0,0,0,,Бұл жеңу немесе жеңілу туралы емес.
Dialogue: 0,1:06:34.03,1:06:36.86,Default,,0,0,0,,Баланың пианинода ойнай беретініне сенімдімін.
Dialogue: 0,1:06:48.83,1:06:50.75,Default,,0,0,0,,Өткен айда бізге тіпті Кацушика да келді.
Dialogue: 0,1:06:50.84,1:06:52.46,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:06:52.84,1:06:54.72,Default,,0,0,0,,Қалай болды? JASS бұл
Dialogue: 0,1:06:54.80,1:06:56.09,Default,,0,0,0,,Хехе
Dialogue: 0,1:06:56.17,1:06:58.09,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,1:06:58.18,1:07:00.55,Default,,0,0,0,,Сол тенор күшті болды
Dialogue: 0,1:07:00.64,1:07:03.56,Default,,0,0,0,,Савабе-кун да тартылып, күшейе түсті.
Dialogue: 0,1:07:03.64,1:07:04.73,Default,,0,0,0,,Рахмет
Dialogue: 0,1:07:04.81,1:07:06.52,Default,,0,0,0,,Иә... Сонымен?
Dialogue: 0,1:07:06.85,1:07:10.27,Default,,0,0,0,,Сен маған қандай батылдық көрсеттің?
Dialogue: 0,1:07:11.15,1:07:14.82,Default,,0,0,0,,Бізді Soblue-ден біреумен байланыстыра аласыз ба?
Dialogue: 0,1:07:15.19,1:07:16.15,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:16.70,1:07:20.12,Default,,0,0,0,,Бұл жер джазмендерге арналған Tokyo Dome.
Dialogue: 0,1:07:20.20,1:07:21.12,Default,,0,0,0,,Жоқ, мен әйеліммен ұрсысып қалдым.
Dialogue: 0,1:07:21.58,1:07:24.83,Default,,0,0,0,,Оның үстіне мен әлі жасөспірім кезімде тұрғым келеді.
Dialogue: 0,1:07:27.62,1:07:30.88,Default,,0,0,0,,Савабе-кун, бұл тым ақсақ.
Dialogue: 0,1:07:31.96,1:07:35.84,Default,,0,0,0,,Егер сіз маған бір баспалдақпен көтерілу үшін келген болсаңыз, мен түсінемін.
Dialogue: 0,1:07:35.92,1:07:40.18,Default,,0,0,0,,Бірақ сіз айтып отырған нәрсе 100 қадамды өткізіп жіберу.
Dialogue: 0,1:07:42.05,1:07:43.31,Default,,0,0,0,,Мен орта мектепте оқып жүрген кезімде...
Dialogue: 0,1:07:43.81,1:07:47.27,Default,,0,0,0,,Анам мені алғаш рет Собруға апарды.
Dialogue: 0,1:07:47.73,1:07:51.77,Default,,0,0,0,,Содан бері мен ол кезеңге тәнті болдым.
Dialogue: 0,1:07:52.23,1:07:56.57,Default,,0,0,0,,Футбол клубы мен баскетбол клубы ұлттық құрамаға ұмтылған кезде.
Dialogue: 0,1:07:57.36,1:08:00.20,Default,,0,0,0,,Мен әрқашан So Blue-ге ұмтылдым.
Dialogue: 0,1:08:00.95,1:08:03.49,Default,,0,0,0,,Менің ойымша, сіз ақымақ нәрсе айтып тұрсыз.
Dialogue: 0,1:08:04.53,1:08:05.79,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:08:06.50,1:08:08.25,Default,,0,0,0,,Маған музыка ұнайды...
Dialogue: 0,1:08:09.16,1:08:12.58,Default,,0,0,0,,Мен Со Blueді ешқашан сынаған емеспін.
Dialogue: 0,1:08:16.00,1:08:16.71,Default,,0,0,0,,Учияма
Dialogue: 0,1:08:17.67,1:08:19.26,Default,,0,0,0,,Бұл туралы не ойлайсыз?
Dialogue: 0,1:08:19.76,1:08:22.22,Default,,0,0,0,,Мен гитарист Кавакита-санға сүйенген сияқтымын.
Dialogue: 0,1:08:22.30,1:08:24.10,Default,,0,0,0,,Ол мекенжайды білетін сияқты.
Dialogue: 0,1:08:24.18,1:08:27.14,Default,,0,0,0,,Бұл қазірдің өзінде бесінші әріп, студенттен.
Dialogue: 0,1:08:27.22,1:08:29.10,Default,,0,0,0,,Сіз студентсіз бе?
Dialogue: 0,1:08:29.18,1:08:31.39,Default,,0,0,0,,Сіз шынымен сенімдісіз бе?
Dialogue: 0,1:08:31.48,1:08:32.69,Default,,0,0,0,,Сіз жай ғана ақымақсыз ба...
Dialogue: 0,1:08:33.15,1:08:36.57,Default,,0,0,0,,Бірақ Тайра мырза өзінің керемет жігіт екенін үнемі айтып отырады.
Dialogue: 0,1:08:36.65,1:08:38.99,Default,,0,0,0,,Бұл жағдай болуы мүмкін.
Dialogue: 0,1:08:39.99,1:08:40.82,Default,,0,0,0,,(Ұялы телефонның діріл дыбысы)
Dialogue: 0,1:08:40.82,1:08:42.07,Default,,0,0,0,,Ой, міне, келді.
Dialogue: 0,1:08:42.36,1:08:43.49,Default,,0,0,0,,Не болды? қар намазы
Dialogue: 0,1:08:43.57,1:08:45.91,Default,,0,0,0,,Бесінші хаттан кейін мен жауап алдым.
Dialogue: 0,1:08:46.28,1:08:48.04,Default,,0,0,0,,Ол келесі тікелей шоуды көруге келеді.
Dialogue: 0,1:08:48.41,1:08:49.33,Default,,0,0,0,,О...
Dialogue: 0,1:08:49.41,1:08:51.83,Default,,0,0,0,,Сіз соншалықты алысқа баратын қандай баласыз?
Dialogue: 0,1:08:51.92,1:08:53.08,Default,,0,0,0,,Эй, сәлем
Dialogue: 0,1:08:53.17,1:08:55.84,Default,,0,0,0,,Мен оның үлкен кеуделі әдемі екеніне сенімдімін.
Dialogue: 0,1:08:55.92,1:08:58.76,Default,,0,0,0,,Не? Саксофон салқынырақ.
Dialogue: 0,1:08:58.84,1:09:01.97,Default,,0,0,0,,Жарайды, мен де бүгін Макспен барамын.
Dialogue: 0,1:09:02.84,1:09:08.06,Default,,0,0,0,,♪ «БІЗ БОЛАМЫЗ»
Dialogue: 0,1:09:57.77,1:09:58.57,Default,,0,0,0,,Ал...
Dialogue: 0,1:09:59.19,1:10:00.65,Default,,0,0,0,,Бүгін де қызық болды.
Dialogue: 0,1:10:00.73,1:10:01.82,Default,,0,0,0,,Барабан сол жерде толтырылады
Dialogue: 0,1:10:01.90,1:10:03.11,Default,,0,0,0,,Менің ойымша, бұл жақсы өтті.
Dialogue: 0,1:10:03.19,1:10:03.82,Default,,0,0,0,,Дегенмен—
Dialogue: 0,1:10:03.82,1:10:04.20,Default,,0,0,0,,Дегенмен—
Dialogue: 0,1:10:03.82,1:10:04.20,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:10:04.20,1:10:04.28,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:10:04.28,1:10:05.11,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,1:10:04.28,1:10:05.11,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:05.49,1:10:07.07,Default,,0,0,0,,Кешіріңіз, мен бірінші барамын.
Dialogue: 0,1:10:09.66,1:10:11.08,Default,,0,0,0,,Әйел
Dialogue: 0,1:10:12.00,1:10:13.79,Default,,0,0,0,,Міне! (Әйел тұтынушы) Юкиюки-кун
Dialogue: 0,1:10:14.33,1:10:16.71,Default,,0,0,0,,А... қарсы болмасаңыз, қол қойыңыз.
Dialogue: 0,1:10:16.79,1:10:17.58,Default,,0,0,0,,...
Dialogue: 0,1:10:17.67,1:10:18.63,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:24.22,1:10:25.51,Default,,0,0,0,,Ах Миямото-кун
Dialogue: 0,1:10:26.01,1:10:27.39,Default,,0,0,0,,Мен қол қоя аламын ба?
Dialogue: 0,1:10:27.47,1:10:28.85,Default,,0,0,0,,Мен 100 пайыз дәлдікпен анықтай аламын
Dialogue: 0,1:10:29.26,1:10:30.93,Default,,0,0,0,,Рахмет
Dialogue: 0,1:10:33.10,1:10:34.02,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:34.48,1:10:35.85,Default,,0,0,0,,Жақсырақ болу
Dialogue: 0,1:10:35.94,1:10:36.94,Default,,0,0,0,,Иә?
Dialogue: 0,1:10:37.02,1:10:38.94,Default,,0,0,0,,Бірінші тікелей орындаудан бері 8 ай
Dialogue: 0,1:10:39.02,1:10:41.52,Default,,0,0,0,,Барабан соғуыңыз жақсарып келеді.
Dialogue: 0,1:10:42.15,1:10:46.95,Default,,0,0,0,,Мен сенің өсіп келе жатқан барабандарыңды тыңдау үшін келдім.
Dialogue: 0,1:10:50.95,1:10:52.45,Default,,0,0,0,,Қатты жақын қашықтықтағы шайқаста ол дерлік ешқандай осал тұс қалдырмайды—
Dialogue: 0,1:10:58.25,1:10:59.21,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,1:10:59.29,1:11:00.34,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,1:11:05.26,1:11:07.09,Default,,0,0,0,,Бұл Савабе.
Dialogue: 0,1:11:07.59,1:11:09.80,Default,,0,0,0,,Танысқаныма қуаныштымын, мен Тайрамын.
Dialogue: 0,1:11:10.10,1:11:10.80,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:11:11.26,1:11:12.81,Default,,0,0,0,,Рахмет
Dialogue: 0,1:11:14.35,1:11:15.73,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,1:11:15.81,1:11:16.98,Default,,0,0,0,,Сусындар ше?
Dialogue: 0,1:11:17.06,1:11:19.40,Default,,0,0,0,,Бәрі жақсы, маған қалдыр.
Dialogue: 0,1:11:19.48,1:11:21.15,Default,,0,0,0,,Қалай болды?
Dialogue: 0,1:11:21.73,1:11:23.65,Default,,0,0,0,,Біз қалай болдық?
Dialogue: 0,1:11:23.98,1:11:26.65,Default,,0,0,0,,Барабандар Ол бастаушы.
Dialogue: 0,1:11:27.15,1:11:30.57,Default,,0,0,0,,Соло жоқ, ең төменгі деңгейге жетіңіз
Dialogue: 0,1:11:30.66,1:11:33.33,Default,,0,0,0,,Бірақ ол қатты соққы берді.
Dialogue: 0,1:11:33.74,1:11:35.37,Default,,0,0,0,,Бұл жақсы ойын болды.
Dialogue: 0,1:11:35.70,1:11:38.21,Default,,0,0,0,,Солай ма? Тамада.
Dialogue: 0,1:11:38.29,1:11:38.96,Default,,0,0,0,,Тенор
Dialogue: 0,1:11:39.46,1:11:41.42,Default,,0,0,0,,Қызықты деп ойладым.
Dialogue: 0,1:11:41.50,1:11:44.42,Default,,0,0,0,,Бар күшімен алға ұмтылады, күші бар.
Dialogue: 0,1:11:44.50,1:11:45.67,Default,,0,0,0,,Бірегей дыбыс
Dialogue: 0,1:11:46.26,1:11:47.42,Default,,0,0,0,,Қызықты
Dialogue: 0,1:11:47.51,1:11:49.59,Default,,0,0,0,,Мен оның болашағына алаңдаймын.
Dialogue: 0,1:11:49.68,1:11:51.59,Default,,0,0,0,,Иә, ол талантты.
Dialogue: 0,1:11:53.14,1:11:53.81,Default,,0,0,0,,696-санды тұтқын – Мұнда не болып жатыр өзі?
Dialogue: 0,1:11:55.35,1:11:56.77,Default,,0,0,0,,Мүлде жоқ
Dialogue: 0,1:11:57.89,1:11:58.56,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:59.02,1:12:01.15,Default,,0,0,0,,Шағын әдіс-тәсілдерді жалғастыру
Dialogue: 0,1:12:01.23,1:12:02.98,Default,,0,0,0,,Жағымсыз пианино
Dialogue: 0,1:12:03.48,1:12:05.90,Default,,0,0,0,,Мүлдем қызық емес қойылым
Dialogue: 0,1:12:06.78,1:12:08.90,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,1:12:08.99,1:12:12.20,Default,,0,0,0,,Біз Жапониядағы ең жақсы клуб болғанымызды мақтан тұтамыз.
Dialogue: 0,1:12:12.28,1:12:14.28,Default,,0,0,0,,Сен мені мазақ етіп тұрсың ба?
Dialogue: 0,1:12:14.37,1:12:15.41,Default,,0,0,0,,Жоқ, мен...
Dialogue: 0,1:12:15.79,1:12:18.08,Default,,0,0,0,,Сіз қорқақсыз ба?
Dialogue: 0,1:12:18.16,1:12:20.33,Default,,0,0,0,,Өзіңізді барынша ашып көрсетіңіз
Dialogue: 0,1:12:20.42,1:12:22.13,Default,,0,0,0,,Менің ішкі ағзаларымды сыртқа айналдырғаны сонша,
Dialogue: 0,1:12:22.54,1:12:24.46,Default,,0,0,0,,Соло - бұл сіз өзіңізді ашатын жер.
Dialogue: 0,1:12:24.54,1:12:25.21,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:25.67,1:12:29.13,Default,,0,0,0,,Әуенді әзілдегенге дейін
Dialogue: 0,1:12:29.22,1:12:30.26,Default,,0,0,0,,Адамдарды мазақ етпе
Dialogue: 0,1:12:30.93,1:12:32.72,Default,,0,0,0,,Бұйрық берудің тәкаппар тәсілі
Dialogue: 0,1:12:33.26,1:12:36.97,Default,,0,0,0,,Мен бірінші рет кездесіп отырған адамға "Танысқаныма қуаныштымын" деп те айта алмаймын.
Dialogue: 0,1:12:37.06,1:12:41.27,Default,,0,0,0,,Кавакита мырзаға сенім артып, бізден ұсыныс сұраудың төмендігі.
Dialogue: 0,1:12:41.35,1:12:43.35,Default,,0,0,0,,Кішіпейілділіктің ізі де жоқ
Dialogue: 0,1:12:43.44,1:12:45.65,Default,,0,0,0,,Сіздің атмосфераңыз бен көзқарасыңыз
Dialogue: 0,1:12:48.94,1:12:49.86,Default,,0,0,0,,…Сонымен
Dialogue: 0,1:12:50.70,1:12:53.82,Default,,0,0,0,,Бұл жолы байланыс болмады.
Dialogue: 0,1:12:54.87,1:12:57.95,Default,,0,0,0,,Кешіріңіз, мен оның есебін де төледім.
Dialogue: 0,1:12:58.91,1:13:00.00,Default,,0,0,0,,Хмм...
Dialogue: 0,1:13:18.18,1:13:19.72,Default,,0,0,0,,Керемет
Dialogue: 0,1:13:20.18,1:13:21.89,Default,,0,0,0,,Сіз соншалықты көп айтасыз ба?
Dialogue: 0,1:13:22.48,1:13:25.02,Default,,0,0,0,,Маған соншалықты көп айта аласыз ба?
Dialogue: 0,1:13:28.36,1:13:31.82,Default,,0,0,0,,Өйткені, бұл дүкен керемет.
Dialogue: 0,1:13:37.16,1:13:38.37,Default,,0,0,0,,О...
Dialogue: 0,1:13:39.20,1:13:40.08,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,1:13:40.45,1:13:41.66,Default,,0,0,0,,Фортепиано.
Dialogue: 0,1:13:41.75,1:13:44.58,Default,,0,0,0,,Мен үйге бара жатырмын, сондықтан қалағаныңызша жасаңыз.
Dialogue: 0,1:13:45.00,1:13:46.58,Default,,0,0,0,,Ертең де әдеттегі мереке.
Dialogue: 0,1:13:47.34,1:13:48.92,Default,,0,0,0,,Мен оны мәңгі ойнай аламын ба?
Dialogue: 0,1:13:54.88,1:13:58.18,Default,,0,0,0,,Ішкі мүшелерді төңкеру...
Dialogue: 0,1:14:14.49,1:14:15.53,Default,,0,0,0,,О.
Dialogue: 0,1:14:20.03,1:14:22.41,Default,,0,0,0,,Сіз мұны екі күн бойы істедіңіз бе?
Dialogue: 0,1:14:22.83,1:14:23.91,Default,,0,0,0,,Иә
Dialogue: 0,1:14:24.50,1:14:25.83,Default,,0,0,0,,Дегенмен—
Dialogue: 0,1:14:26.54,1:14:27.63,Default,,0,0,0,,Мүлде жоқ
Dialogue: 0,1:14:30.38,1:14:33.05,Default,,0,0,0,,Мен оларға айтуым керек.
Dialogue: 0,1:14:37.22,1:14:39.51,Default,,0,0,0,,Толық күтпеген.
Dialogue: 0,1:14:39.80,1:14:40.89,Default,,0,0,0,,Не?
Dialogue: 0,1:14:40.97,1:14:44.10,Default,,0,0,0,,Мен әлдеқайда стильді бөлмені елестеттім.
Dialogue: 0,1:14:44.18,1:14:46.39,Default,,0,0,0,,Бұл менмін
Dialogue: 0,1:14:46.48,1:14:49.15,Default,,0,0,0,,...Сонымен не туралы әңгіме?
Dialogue: 0,1:14:50.65,1:14:51.52,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,1:14:52.11,1:14:55.07,Default,,0,0,0,,Бір күні So Blue тобының адамдары шоуды көруге келді.
Dialogue: 0,1:14:55.15,1:14:56.82,Default,,0,0,0,,Не?
Dialogue: 0,1:14:57.24,1:14:59.53,Default,,0,0,0,,Маған біреу келді.
Dialogue: 0,1:15:00.41,1:15:02.24,Default,,0,0,0,,Мен көрдім бе?
Dialogue: 0,1:15:02.79,1:15:05.75,Default,,0,0,0,,Мен Дай мен Тамададан жақсы әсер алдым.
Dialogue: 0,1:15:06.08,1:15:07.25,Default,,0,0,0,,Э-э… Зеницу-сан
Dialogue: 0,1:15:07.33,1:15:09.71,Default,,0,0,0,,Адамдар менің соломды ақымақ деп айтты
Dialogue: 0,1:15:09.79,1:15:12.80,Default,,0,0,0,,Иә? Құлағыңызда бірдеңе жоқ па?
Dialogue: 0,1:15:13.25,1:15:16.76,Default,,0,0,0,,Менің жеке әнім - бұл қолмен ойнау.
Dialogue: 0,1:15:17.93,1:15:21.76,Default,,0,0,0,,Мен соңғы үш күнде бірдеңе істеуге тырыстым, бірақ...
Dialogue: 0,1:15:21.85,1:15:22.72,Default,,0,0,0,,Бұл жақсы болмады.
Dialogue: 0,1:15:23.47,1:15:24.56,Default,,0,0,0,,Э-э… Зеницу-сан
Dialogue: 0,1:15:25.02,1:15:27.77,Default,,0,0,0,,Со көкке жол жабылды.
Dialogue: 0,1:15:28.10,1:15:28.94,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,1:15:29.56,1:15:30.90,Default,,0,0,0,,Қар дұғасы…
Dialogue: 0,1:15:31.44,1:15:35.53,Default,,0,0,0,,Сіздің ойыңызша, ол кісінің айтқаны дұрыс па?
Dialogue: 0,1:15:35.61,1:15:36.78,Default,,0,0,0,,О
Dialogue: 0,1:15:36.86,1:15:37.95,Default,,0,0,0,,Мен де дұрыс деп ойлаймын.
Dialogue: 0,1:15:38.03,1:15:38.82,Default,,0,0,0,,Иә?
Dialogue: 0,1:15:38.91,1:15:40.07,Default,,0,0,0,,Тамада (Тамада) Е...
Dialogue: 0,1:15:40.16,1:15:41.32,Default,,0,0,0,,Кумия Нурезо — біз сол жігітті артта қалдыра саламыз.
Dialogue: 0,1:15:41.41,1:15:44.29,Default,,0,0,0,,Енді ештеңе істей алмаймыз.
Dialogue: 0,1:15:44.37,1:15:46.54,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,1:15:46.62,1:15:48.54,Default,,0,0,0,,Юкиёри ойысқан емес пе?
Dialogue: 0,1:15:48.62,1:15:51.25,Default,,0,0,0,,Оны майыстырмаңыз, сыртқа шығармаңыз
Dialogue: 0,1:15:51.92,1:15:53.75,Default,,0,0,0,,Мен жеке ойнаған кезде
Dialogue: 0,1:15:53.84,1:15:56.76,Default,,0,0,0,,Мен нашар болсам да, мен әлемдегі ең жақсы адам сияқты ойнаймын.
Dialogue: 0,1:15:57.34,1:16:00.93,Default,,0,0,0,,Сізге ақымақ екеніңізді айтты және сіз оны мойындайсыз
Dialogue: 0,1:16:01.01,1:16:02.68,Default,,0,0,0,,Сөйлеме
Dialogue: 0,1:16:03.05,1:16:05.18,Default,,0,0,0,,Қорыққан адамға ештеңе істей алмайсың.
Dialogue: 0,1:16:05.56,1:16:06.56,Default,,0,0,0,,Мисэбе
Dialogue: 0,1:16:06.64,1:16:09.10,Default,,0,0,0,,Біздің қолымыздан келетін нәрсе болуы керек.
Dialogue: 0,1:16:09.19,1:16:10.77,Default,,0,0,0,,Бұл Юкибориге қатысты мәселе.
Dialogue: 0,1:16:11.27,1:16:13.61,Default,,0,0,0,,Біз дос емеспіз бе?
Dialogue: 0,1:16:14.23,1:16:17.53,Default,,0,0,0,,Джаз - бұл бір мүшемен мәңгі ойнайтын нәрсе емес.
Dialogue: 0,1:16:17.61,1:16:19.70,Default,,0,0,0,,Бір күні біз жұмыс істейтін адамдар өзгереді.
Dialogue: 0,1:16:20.15,1:16:21.61,Default,,0,0,0,,Егер бұл адамзаттың тіршілігін сақтап қалуға көмектессе, мен
Dialogue: 0,1:16:22.03,1:16:23.24,Default,,0,0,0,,Хмм...
Dialogue: 0,1:16:24.78,1:16:26.91,Default,,0,0,0,,Дай әлемдегі ең жақсы болғысы келеді
Dialogue: 0,1:16:27.58,1:16:29.46,Default,,0,0,0,,Юкари джазбен жеңгісі келеді
Dialogue: 0,1:16:29.54,1:16:30.83,Default,,0,0,0,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,1:16:31.67,1:16:32.75,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,1:16:33.50,1:16:36.96,Default,,0,0,0,,Мен мұны сендермен ғана жасағым келеді.
Dialogue: 0,1:16:38.09,1:16:41.59,Default,,0,0,0,,Достарың қиналса, сен оларға көмектесу керек.
Dialogue: 0,1:16:42.01,1:16:44.18,Default,,0,0,0,,Жақсы болсаң да, солоң жақсармайды.
Dialogue: 0,1:16:44.26,1:16:46.97,Default,,0,0,0,,Онда неге маған ауыр сөз айтпайсың!
Dialogue: 0,1:16:47.52,1:16:49.23,Default,,0,0,0,,Мен ең нашармын
Dialogue: 0,1:16:49.31,1:16:51.35,Default,,0,0,0,,Мен де өзімді жаманмын деп айта алмаймын.
Dialogue: 0,1:16:53.94,1:16:54.69,Default,,0,0,0,,Сәлем Тамада
Dialogue: 0,1:16:54.77,1:16:56.02,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:16:56.11,1:16:58.23,Default,,0,0,0,,Менімен қалжыңдап тұрсың ба?
Dialogue: 0,1:16:58.65,1:17:01.65,Default,,0,0,0,,Джазды сонша ретсіз ойнай алмайсыз ба?
Dialogue: 0,1:17:08.87,1:17:12.29,Default,,0,0,0,,Шундзи Бағаны қайталағаныңыз рас па?
Dialogue: 0,1:17:12.37,1:17:14.50,Default,,0,0,0,,А... жоқ... иә
Dialogue: 0,1:17:14.58,1:17:16.71,Default,,0,0,0,,Не болды?
Dialogue: 0,1:17:16.79,1:17:18.96,Default,,0,0,0,,Мама, бұл жерде біраз қиындық бар.
Dialogue: 0,1:17:19.05,1:17:21.55,Default,,0,0,0,,Мен бұған қатысым бар ма деп қорқамын.
Dialogue: 0,1:17:22.09,1:17:24.47,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,1:17:24.55,1:17:26.18,Default,,0,0,0,,Сонда неге?
Dialogue: 0,1:17:26.51,1:17:29.10,Default,,0,0,0,,Кешіріңіз, келесі жолы түсіндіремін.
Dialogue: 0,1:17:29.18,1:17:30.64,Default,,0,0,0,,Қазір мектеп.
Dialogue: 0,1:17:47.66,1:17:50.12,Default,,0,0,0,,Сіз тыртықпен жабылып қалдыңыз.
Dialogue: 0,1:17:53.29,1:17:56.17,Default,,0,0,0,,Бірақ ол жақсы дыбыс шығарады.
Dialogue: 0,1:17:56.75,1:17:57.75,Default,,0,0,0,,Хехе
Dialogue: 0,1:17:58.13,1:18:00.38,Default,,0,0,0,,Ошиге техникалық қызмет көрсету аяқталды
Dialogue: 0,1:18:04.26,1:18:07.39,Default,,0,0,0,,Иә, бұл қызыл шамның соңғы көлігі.
Dialogue: 0,1:18:07.68,1:18:08.89,Default,,0,0,0,,Қосымша күштер! Біз тез арада қорғаныс жасауымыз керек, әйтпесе қайтадан қоршауға алынамыз.
Dialogue: 0,1:18:10.64,1:18:12.89,Default,,0,0,0,,Эй Савабе, көлік өтіп кетсін.
Dialogue: 0,1:18:12.98,1:18:13.81,Default,,0,0,0,,Оны осындай ерекше жағдайға араластыру сәл қатал қадам сияқты.
Dialogue: 0,1:18:19.40,1:18:20.15,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:23.32,1:18:25.11,Default,,0,0,0,,Канеда тофу дүкені…
Dialogue: 0,1:18:33.00,1:18:34.00,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,1:18:40.25,1:18:41.67,Default,,0,0,0,,(шу)
Dialogue: 0,1:18:46.18,1:18:47.89,Default,,0,0,0,,Өйткені, бұл сол адам.
Dialogue: 0,1:19:02.61,1:19:03.69,Default,,0,0,0,,Ха…
Dialogue: 0,1:19:04.82,1:19:06.65,Default,,0,0,0,,Ух... Ататата...
Dialogue: 0,1:19:06.74,1:19:08.20,Default,,0,0,0,,Не?
Dialogue: 0,1:19:08.28,1:19:10.45,Default,,0,0,0,,Иә?Сіз...
Dialogue: 0,1:19:10.78,1:19:12.95,Default,,0,0,0,,Өткен күн үшін кешірім сұраймын.
Dialogue: 0,1:19:13.49,1:19:16.00,Default,,0,0,0,,Қарсы болмасаңыз, менен қабыл алыңыз.
Dialogue: 0,1:19:16.37,1:19:19.75,Default,,0,0,0,,О, мұны істеу үшін бар күшіңізді салғаныңыз үшін рахмет.
Dialogue: 0,1:19:19.83,1:19:22.34,Default,,0,0,0,,А... сен осы жерде тұрасың ба?
Dialogue: 0,1:19:22.42,1:19:23.67,Default,,0,0,0,,Кездейсоқ па?
Dialogue: 0,1:19:23.75,1:19:25.30,Default,,0,0,0,,Мен әрқашан кешірім сұрағым келді
Dialogue: 0,1:19:25.38,1:19:26.42,Default,,0,0,0,,Е...
Dialogue: 0,1:19:26.51,1:19:28.30,Default,,0,0,0,,Тікелей эфирге қайта келіңіз
Dialogue: 0,1:19:28.68,1:19:31.93,Default,,0,0,0,,Мен міндетті түрде жақсырақ өнер көрсетемін.
Dialogue: 0,1:19:36.10,1:19:37.27,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:19:37.35,1:19:39.52,Default,,0,0,0,,Біз сізге мүмкіндігінше тезірек хабарласамыз.
Dialogue: 0,1:19:41.06,1:19:42.36,Default,,0,0,0,,Бұл мүмкін емес сияқты ма?
Dialogue: 0,1:19:42.77,1:19:46.15,Default,,0,0,0,,А, олар менің орнына пианист тауып беруімді қалайды.
Dialogue: 0,1:19:46.24,1:19:49.41,Default,,0,0,0,,Болды... тікелей эфир ертең.
Dialogue: 0,1:19:49.49,1:19:51.91,Default,,0,0,0,,Сіз қазір Токиода Мита-кунсыз ба?
Dialogue: 0,1:19:52.41,1:19:55.24,Default,,0,0,0,,Егер есімде дұрыс болса, Вада-кун да Токиода.
Dialogue: 0,1:19:55.33,1:19:56.91,Default,,0,0,0,,Дегенмен, енді ғана не болды?
Dialogue: 0,1:19:57.00,1:19:59.21,Default,,0,0,0,,Бұл әділетті ме?
Dialogue: 0,1:19:59.29,1:20:00.33,Default,,0,0,0,,Иә?
Dialogue: 0,1:20:00.42,1:20:02.71,Default,,0,0,0,,Бірінші сынып осы сахнада тұра алады, бірақ
Dialogue: 0,1:20:02.79,1:20:04.67,Default,,0,0,0,,Алдарыңыздағы ойыншыға
Dialogue: 0,1:20:05.38,1:20:06.30,Default,,0,0,0,,Уф! Аах!
Dialogue: 0,1:20:06.30,1:20:08.09,Default,,0,0,0,,Бұл әділетті ме?
Dialogue: 0,1:20:08.17,1:20:09.01,Default,,0,0,0,,…тонна
Dialogue: 0,1:20:09.38,1:20:11.51,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,1:20:20.44,1:20:23.40,Default,,0,0,0,,Сіз JASS тенорысыз ба?
Dialogue: 0,1:20:23.73,1:20:24.73,Default,,0,0,0,,Иә
Dialogue: 0,1:20:24.82,1:20:27.36,Default,,0,0,0,,Мен сендерді бір рет тікелей эфирде көрдім.
Dialogue: 0,1:20:27.44,1:20:28.65,Default,,0,0,0,,Ой
Dialogue: 0,1:20:28.74,1:20:30.86,Default,,0,0,0,,Маған қоңырау шалғаныңызға рахмет.
Dialogue: 0,1:20:30.95,1:20:33.45,Default,,0,0,0,,Мен өзімді қандай да бір атақты адам сияқты сезінемін.
Dialogue: 0,1:20:33.78,1:20:36.20,Default,,0,0,0,,Біздің жанды орындауымыз қалай болды?
Dialogue: 0,1:20:36.29,1:20:37.45,Default,,0,0,0,,Бұл қызықты болды
Dialogue: 0,1:20:37.54,1:20:39.91,Default,,0,0,0,,Уау, мен өте қуаныштымын.
Dialogue: 0,1:20:40.25,1:20:43.42,Default,,0,0,0,,Иә... сендер қызық болдыңдар.
Dialogue: 0,1:20:44.25,1:20:47.00,Default,,0,0,0,,Күшті және қаһарлы...
Dialogue: 0,1:20:47.80,1:20:49.38,Default,,0,0,0,,Бұл пианистке не болды?
Dialogue: 0,1:20:49.80,1:20:52.09,Default,,0,0,0,,А... Юкиори?
Dialogue: 0,1:20:52.18,1:20:55.47,Default,,0,0,0,,Ол дәл қазір қабырғаға соғылып жатыр.
Dialogue: 0,1:20:55.72,1:20:58.22,Default,,0,0,0,,Бұл өте қымбат және қалың болып көрінеді.
Dialogue: 0,1:20:59.68,1:21:00.64,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:21:00.73,1:21:02.19,Default,,0,0,0,,Бірақ бәрібір.
Dialogue: 0,1:21:02.52,1:21:05.65,Default,,0,0,0,,Қарлы намазды міндетті түрде жеңемін
Dialogue: 0,1:21:05.73,1:21:07.78,Default,,0,0,0,,Бізде бәрі жақсы.
Dialogue: 0,1:21:09.78,1:21:10.82,Default,,0,0,0,,Спектакль жақында басталады
Dialogue: 0,1:21:10.82,1:21:11.74,Default,,0,0,0,,Спектакль жақында басталады
Dialogue: 0,1:21:10.82,1:21:11.74,Default,,0,0,0,,А, мен тезірек кетуім керек.
Dialogue: 0,1:21:11.74,1:21:12.49,Default,,0,0,0,,А, мен тезірек кетуім керек.
Dialogue: 0,1:21:12.82,1:21:13.95,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,1:21:14.45,1:21:15.62,Default,,0,0,0,,А, бұл
Dialogue: 0,1:21:16.83,1:21:20.37,Default,,0,0,0,,Біз бір күні осы дүкенде өнер көрсетеміз.
Dialogue: 0,1:21:20.45,1:21:22.75,Default,,0,0,0,,Онда бізге қонаққа келіңіз.
Dialogue: 0,1:21:23.08,1:21:24.42,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:21:27.50,1:21:31.05,Default,,0,0,0,,Тайра мырза, сіз кімсіз? бүгінгі жастар
Dialogue: 0,1:21:32.22,1:21:33.51,Default,,0,0,0,,Дұрыс...
Dialogue: 0,1:21:34.97,1:21:36.76,Default,,0,0,0,,Ертеңгі джаз
Dialogue: 0,1:21:39.85,1:21:42.44,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:21:45.02,1:21:46.27,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,1:21:46.36,1:21:47.69,Default,,0,0,0,,Тегіс
Dialogue: 0,1:21:47.77,1:21:49.28,Default,,0,0,0,,Бөлім...
Dialogue: 0,1:21:49.36,1:21:51.19,Default,,0,0,0,,Кенет байланыс үшін кешірім сұраймыз.
Dialogue: 0,1:21:55.28,1:21:56.37,Default,,0,0,0,,Ха…
Dialogue: 0,1:21:57.49,1:22:00.49,Default,,0,0,0,,Келесі күні біздің әпкеміз Cotton's дүкенінде.
Dialogue: 0,1:22:00.58,1:22:02.91,Default,,0,0,0,,Фред Силвер жанды дауыста өнер көрсетеді.
Dialogue: 0,1:22:03.00,1:22:06.46,Default,,0,0,0,,Пианист денсаулығына байланысты Жапонияға келе алмайды.
Dialogue: 0,1:22:06.79,1:22:09.71,Default,,0,0,0,,Мен шұғыл түрде алмастыратын пианист іздеймін...
Dialogue: 0,1:22:10.50,1:22:13.09,Default,,0,0,0,,Савабе мырза, келгіңіз келе ме?
Dialogue: 0,1:22:13.17,1:22:14.22,Default,,0,0,0,,Егер бас тартсаңыз, дереу жоқ деп айтыңыз.
Dialogue: 0,1:22:14.22,1:22:15.30,Default,,0,0,0,,Егер бас тартсаңыз, дереу жоқ деп айтыңыз.
Dialogue: 0,1:22:14.22,1:22:15.30,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,1:22:15.30,1:22:15.38,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,1:22:15.38,1:22:17.80,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,1:22:15.38,1:22:17.80,Default,,0,0,0,,Мен басқа пианист табуым керек.
Dialogue: 0,1:22:17.80,1:22:18.30,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,1:22:21.18,1:22:22.02,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:22:22.02,1:22:25.06,Default,,0,0,0,,Ха ха ха ха ха...
Dialogue: 0,1:22:22.02,1:22:25.06,Default,,0,0,0,,(саксофон орындауы)
Dialogue: 0,1:22:25.06,1:22:28.77,Default,,0,0,0,,(саксофон орындауы)
Dialogue: 0,1:23:05.02,1:23:06.73,Default,,0,0,0,,Онда ешкім жоқ болса да
Dialogue: 0,1:23:07.19,1:23:09.52,Default,,0,0,0,,Бұл жігіт керемет.
Dialogue: 0,1:23:09.61,1:23:10.31,Default,,0,0,0,,О
Dialogue: 0,1:23:10.40,1:23:14.94,Default,,0,0,0,,(саксофон орындауы)
Dialogue: 0,1:23:32.25,1:23:35.34,Default,,0,0,0,,Бұл джаз
Dialogue: 0,1:23:37.76,1:23:38.88,Default,,0,0,0,,Ха…
Dialogue: 0,1:23:39.39,1:23:40.22,Default,,0,0,0,,Тамада
Dialogue: 0,1:23:41.05,1:23:42.60,Default,,0,0,0,,Бөлек болған дұрыс
Dialogue: 0,1:23:43.35,1:23:46.35,Default,,0,0,0,,Өйткені, мен онымен бірге істеуім керек.
Dialogue: 0,1:23:47.02,1:23:48.23,Default,,0,0,0,,Нандабе
Dialogue: 0,1:23:48.56,1:23:49.98,Default,,0,0,0,,Фу…
Dialogue: 0,1:23:55.23,1:23:56.07,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:56.15,1:23:59.53,Default,,0,0,0,,О, Юкиюки Тамада! Хехе
Dialogue: 0,1:24:00.36,1:24:01.82,Default,,0,0,0,,Эй, әлгі жігіт.
Dialogue: 0,1:24:02.28,1:24:03.33,Default,,0,0,0,,Йодай
Dialogue: 0,1:24:03.41,1:24:04.54,Default,,0,0,0,,Уссу
Dialogue: 0,1:24:05.20,1:24:07.46,Default,,0,0,0,,Айтпақшы, маған кенет қоңырау шалғаныңыз не болды?
Dialogue: 0,1:24:08.41,1:24:11.71,Default,,0,0,0,,Маған жаңа ғана So Blue-ден біреу қоңырау шалды.
Dialogue: 0,1:24:12.04,1:24:14.42,Default,,0,0,0,,Мен ғана ауру демалысындамын...
Dialogue: 0,1:24:15.13,1:24:17.76,Default,,0,0,0,,Ол менен Коттонда пианинода ойнауымды өтінді.
Dialogue: 0,1:24:18.42,1:24:20.55,Default,,0,0,0,,Менің ойымша, бұл асығыс.
Dialogue: 0,1:24:21.59,1:24:22.76,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:24:23.51,1:24:24.97,Default,,0,0,0,,JASS-тен бір рет шыға аламын ба?
Dialogue: 0,1:24:25.81,1:24:27.06,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:28.52,1:24:29.89,Default,,0,0,0,,Жарайсың Юкиюки
Dialogue: 0,1:24:34.19,1:24:35.69,Default,,0,0,0,,Соқайық
Dialogue: 0,1:24:36.15,1:24:38.90,Default,,0,0,0,,Жарайсыңдар! Керемет қар дұғасы
Dialogue: 0,1:24:38.99,1:24:40.45,Default,,0,0,0,,Мен билетті қазір де ала аламын ба?
Dialogue: 0,1:24:43.16,1:24:46.54,Default,,0,0,0,,А, ана? Мен Шундзимін
Dialogue: 0,1:24:47.29,1:24:49.79,Default,,0,0,0,,Негізі мен барабанда ойнаймын.
Dialogue: 0,1:24:50.46,1:24:54.34,Default,,0,0,0,,Егер сіз мұны қазір жасамасаңыз, өміріңіздің соңына дейін өкінесіз.
Dialogue: 0,1:24:54.79,1:24:55.59,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:24:56.67,1:24:58.51,Default,,0,0,0,,Маған қазір істеуге рұқсат етіңізші.
Dialogue: 0,1:25:03.68,1:25:07.43,Default,,0,0,0,,Сен жақсысың ба, Юкиюки, мұндай жерде?
Dialogue: 0,1:25:07.52,1:25:09.06,Default,,0,0,0,,Сонымен қатар, бұл жолақ
Dialogue: 0,1:25:09.14,1:25:11.19,Default,,0,0,0,,Бұл өте танымал, солай емес пе?
Dialogue: 0,1:25:11.27,1:25:14.81,Default,,0,0,0,,Бізбен бірге келдің, жақсы болатынына сенімдімін.
Dialogue: 0,1:25:14.90,1:25:16.36,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:16.44,1:25:16.82,Default,,0,0,0,,Уа... ау
Dialogue: 0,1:25:16.82,1:25:18.19,Default,,0,0,0,,Уа... ау
Dialogue: 0,1:25:16.82,1:25:18.19,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,1:25:18.19,1:25:20.65,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,1:25:21.99,1:25:23.61,Default,,0,0,0,,Юкиюки шықты
Dialogue: 0,1:25:26.70,1:25:28.45,Default,,0,0,0,,Фред!
Dialogue: 0,1:25:36.63,1:25:41.01,Default,,0,0,0,,♪ «Маған сен»
Dialogue: 0,1:26:03.11,1:26:05.95,Default,,0,0,0,,Керемет саксофон
Dialogue: 0,1:26:06.03,1:26:07.74,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,1:26:08.24,1:26:10.66,Default,,0,0,0,,Тек Юкиюкиге назар аудару керек
Dialogue: 0,1:26:11.54,1:26:13.04,Default,,0,0,0,,Біз...
Dialogue: 0,1:26:13.12,1:26:15.67,Default,,0,0,0,,Ол тозақтың пианистімен жұмыс істеді.
Dialogue: 0,1:26:32.43,1:26:33.93,Default,,0,0,0,,Күтілгендей
Dialogue: 0,1:26:34.02,1:26:36.15,Default,,0,0,0,,Саксофон шынымен жақсы
Dialogue: 0,1:26:56.79,1:26:58.33,Default,,0,0,0,,Жақында Юкиборидің солосы шығады.
Dialogue: 0,1:26:58.42,1:26:59.08,Default,,0,0,0,,Иә?
Dialogue: 0,1:27:45.55,1:27:47.26,Default,,0,0,0,,Тағы бір айналым (Тамада) Иә?
Dialogue: 0,1:28:04.78,1:28:08.70,Default,,0,0,0,,Ішкі ағзаларыңды сыртқа айналдырамын!
Dialogue: 0,1:28:46.65,1:28:48.82,Default,,0,0,0,,Иә!
Dialogue: 0,1:28:48.90,1:28:54.95,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,1:28:57.66,1:28:59.04,Default,,0,0,0,,Уау...
Dialogue: 0,1:28:59.83,1:29:00.91,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,1:29:01.62,1:29:04.42,Default,,0,0,0,,Егер Юкибори осындай үлкен фотосуретте бейнеленген болса
Dialogue: 0,1:29:04.50,1:29:07.09,Default,,0,0,0,,Бұл менмін. Мен мұқабада боламын.
Dialogue: 0,1:29:07.80,1:29:09.80,Default,,0,0,0,,Иә? Сіз не айттыңыз?
Dialogue: 0,1:29:09.88,1:29:11.47,Default,,0,0,0,,Хахахахаха (Юкиюки) Акико-сан
Dialogue: 0,1:29:11.55,1:29:13.22,Default,,0,0,0,,Иә? (Юкиюки) Менің есебім бар.
Dialogue: 0,1:29:13.30,1:29:15.55,Default,,0,0,0,,О, не?
Dialogue: 0,1:29:15.64,1:29:17.47,Default,,0,0,0,,Бұл шамамен төрт айдан кейін.
Dialogue: 0,1:29:17.85,1:29:20.93,Default,,0,0,0,,Біз So Blue фильмінде боламыз деп шешілді.
Dialogue: 0,1:29:21.31,1:29:22.39,Default,,0,0,0,,Ха…
Dialogue: 0,1:29:22.69,1:29:24.31,Default,,0,0,0,,Иә, бұл жақсы болды.
Dialogue: 0,1:29:24.73,1:29:26.57,Default,,0,0,0,,ше? (Тамада) Не?
Dialogue: 0,1:29:26.65,1:29:28.53,Default,,0,0,0,,Кеше маған Тайра мырза қоңырау шалды.
Dialogue: 0,1:29:28.61,1:29:29.32,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,1:29:29.78,1:29:33.45,Default,,0,0,0,,Менің бұл дүкенде жаттығу жасап жүргеніме бір жыл болды.
Dialogue: 0,1:29:33.53,1:29:35.28,Default,,0,0,0,,Маған көбірек қамқорлық жасайтын адамға
Dialogue: 0,1:29:35.37,1:29:37.91,Default,,0,0,0,,Алдымен айтқан жөн.
Dialogue: 0,1:29:39.29,1:29:40.75,Default,,0,0,0,,Жарайды! (Тамада) Керемет!
Dialogue: 0,1:29:41.08,1:29:44.00,Default,,0,0,0,,Хахахахаха (үлкен) Шынайы ма? Шынайы ма?
Dialogue: 0,1:29:44.08,1:29:44.71,Default,,0,0,0,,Не істеймін… не істеймін!
Dialogue: 0,1:29:44.71,1:29:46.38,Default,,0,0,0,,Не істеймін… не істеймін!
Dialogue: 0,1:29:44.71,1:29:46.38,Default,,0,0,0,,Қарға деген бір тілек орындалды, солай ма?
Dialogue: 0,1:29:46.38,1:29:46.46,Default,,0,0,0,,Қарға деген бір тілек орындалды, солай ма?
Dialogue: 0,1:29:46.46,1:29:47.21,Default,,0,0,0,,Қарға деген бір тілек орындалды, солай ма?
Dialogue: 0,1:29:46.46,1:29:47.21,Default,,0,0,0,,...Бұл өте қатты!
Dialogue: 0,1:29:47.21,1:29:47.29,Default,,0,0,0,,...Бұл өте қатты!
Dialogue: 0,1:29:47.29,1:29:48.30,Default,,0,0,0,,...Ол өте шулы!
Dialogue: 0,1:29:47.29,1:29:48.30,Default,,0,0,0,,Құттықтаймыз балалар
Dialogue: 0,1:29:48.30,1:29:48.38,Default,,0,0,0,,Балалар сендерді құттықтаймын
Dialogue: 0,1:29:48.38,1:29:49.38,Default,,0,0,0,,Құттықтаймыз балалар
Dialogue: 0,1:29:48.38,1:29:49.38,Default,,0,0,0,,Жасөспірімдерде көк
Dialogue: 0,1:29:49.38,1:29:49.71,Default,,0,0,0,,Құттықтаймыз балалар
Dialogue: 0,1:29:49.38,1:29:49.71,Default,,0,0,0,,Ол қара түсті, себебі онда жаңа кальмар сиясы бар
Dialogue: 0,1:29:49.71,1:29:50.26,Default,,0,0,0,,Ол қара түсті, себебі онда жаңа кальмар сиясы бар
Dialogue: 0,1:29:50.26,1:29:51.63,Default,,0,0,0,,Тамада қатты күледі
Dialogue: 0,1:29:51.72,1:29:53.05,Default,,0,0,0,,Не дедің!
Dialogue: 0,1:29:51.72,1:29:53.05,Default,,0,0,0,,Эрен сияқты, бронясымен және Коллоссал Титанмен
Dialogue: 0,1:29:53.05,1:29:53.13,Default,,0,0,0,,Эрен сияқты, бронясымен және Коллоссал Титанмен
Dialogue: 0,1:29:53.13,1:29:54.34,Default,,0,0,0,,Эрен сияқты, бронясымен және Коллоссал Титанмен
Dialogue: 0,1:29:53.13,1:29:54.34,Default,,0,0,0,,Көңілді болыңыз!
Dialogue: 0,1:29:54.43,1:29:55.68,Default,,0,0,0,,JASS - ең жақсы!
Dialogue: 0,1:29:57.89,1:30:01.31,Default,,0,0,0,,Иә, мен қалағанымша жаттыға аламын.
Dialogue: 0,1:30:01.39,1:30:04.52,Default,,0,0,0,,Бізде ешқашан тікелей шоу болған емес.
Dialogue: 0,1:30:05.98,1:30:07.77,Default,,0,0,0,,Егер сіз тікелей шоу жасасаңыз
Dialogue: 0,1:30:08.40,1:30:11.15,Default,,0,0,0,,Мен ештеңе болмайды деп қорқамын
Dialogue: 0,1:30:11.86,1:30:14.66,Default,,0,0,0,,Бірақ мен SoBlue-де көрінемін деп шешілді...
Dialogue: 0,1:30:15.57,1:30:18.49,Default,,0,0,0,,Мен джазға сенемін деп ойладым, бірақ
Dialogue: 0,1:30:18.91,1:30:23.87,Default,,0,0,0,,Маған шынымен сенген сол балалар ма деп ойлаймын.
Dialogue: 0,1:30:28.46,1:30:30.38,Default,,0,0,0,,Бұл ертең ме?
Dialogue: 0,1:30:30.46,1:30:31.42,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,1:30:31.51,1:30:32.80,Default,,0,0,0,,Сосын мен толық емес жұмысқа барамын.
Dialogue: 0,1:30:33.13,1:30:34.30,Default,,0,0,0,,О
Dialogue: 0,1:30:35.30,1:30:37.22,Default,,0,0,0,,Тамада (Тамада) Иә?
Dialogue: 0,1:30:37.30,1:30:39.01,Default,,0,0,0,,Сіз жақсардыңыз.
Dialogue: 0,1:30:39.51,1:30:41.60,Default,,0,0,0,,Иә? Не... не болды?
Dialogue: 0,1:30:42.68,1:30:45.31,Default,,0,0,0,,Барабандар жақсарды.
Dialogue: 0,1:30:47.69,1:30:49.19,Default,,0,0,0,,Бұл бұрын не болды?
Dialogue: 0,1:30:49.27,1:30:50.07,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:50.15,1:30:52.44,Default,,0,0,0,,Ешқашан мақтамайтын Юкари мені мақтайды.
Dialogue: 0,1:30:52.53,1:30:53.74,Default,,0,0,0,,Бұл қалыпты жағдай емес пе?
Dialogue: 0,1:30:53.82,1:30:55.36,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,1:30:55.74,1:30:57.36,Default,,0,0,0,,Бұл менмін... (үлкен) Иә?
Dialogue: 0,1:30:57.82,1:31:00.58,Default,,0,0,0,,Мен әрқашан жеке өнер көрсетуді армандайтынмын.
Dialogue: 0,1:31:00.66,1:31:01.74,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:31:01.83,1:31:04.45,Default,,0,0,0,,Бірақ мен музыка жазғанды ​​да ұнатамын.
Dialogue: 0,1:31:05.00,1:31:08.08,Default,,0,0,0,,Маған да дыбыстарды ойлау, пысықтау, жасау ұнайды.
Dialogue: 0,1:31:08.17,1:31:10.42,Default,,0,0,0,,Сіз шығарған әндер жақсы.
Dialogue: 0,1:31:10.50,1:31:12.50,Default,,0,0,0,,Дарындылықты мойындау керек.
Dialogue: 0,1:31:12.59,1:31:13.71,Default,,0,0,0,,Мен және ұлым
Dialogue: 0,1:31:13.80,1:31:16.22,Default,,0,0,0,,Мен өз талантымнан қорқып, ұйықтай алмаймын.
Dialogue: 0,1:31:16.30,1:31:17.30,Default,,0,0,0,,Барка
Dialogue: 0,1:31:17.38,1:31:18.64,Default,,0,0,0,,Не дедің!
Dialogue: 0,1:31:20.05,1:31:22.56,Default,,0,0,0,,Бірақ сіз басқасыз.
Dialogue: 0,1:31:22.64,1:31:23.52,Default,,0,0,0,,Мен?
Dialogue: 0,1:31:23.85,1:31:25.81,Default,,0,0,0,,Сіз бұл туралы ойламауыңыз керек.
Dialogue: 0,1:31:25.89,1:31:28.10,Default,,0,0,0,,Дәл солай, бір күн болса да тоқтамай
Dialogue: 0,1:31:28.19,1:31:30.90,Default,,0,0,0,,Қанша рет болса да, он мың рет
Dialogue: 0,1:31:31.19,1:31:33.07,Default,,0,0,0,,Қонақтардың алдында өлме
Dialogue: 0,1:31:34.11,1:31:34.94,Default,,0,0,0,,Иә
Dialogue: 0,1:31:35.03,1:31:38.28,Default,,0,0,0,,Жарайды, сен бірінші кезекте ойланатындай ақылды емессің.
Dialogue: 0,1:31:38.36,1:31:39.03,Default,,0,0,0,,(Үкідің ұлуы)
Dialogue: 0,1:31:39.41,1:31:40.74,Default,,0,0,0,,Мен сені үрлеймін Юкиюки (Юкиюки) О!
Dialogue: 0,1:31:40.82,1:31:41.91,Default,,0,0,0,,Хахаха
Dialogue: 0,1:31:41.99,1:31:43.99,Default,,0,0,0,,Олай болса, мен толық емес жұмыс күнім.
Dialogue: 0,1:31:44.24,1:31:46.29,Default,,0,0,0,,...
Dialogue: 0,1:31:53.21,1:31:56.88,Default,,0,0,0,,Ақырында, ертең мен So Blue-де боламын.
Dialogue: 0,1:31:58.01,1:32:01.30,Default,,0,0,0,,Жарайды, менің ойымша, біз бірінші рет ваннада кездестік.
Dialogue: 0,1:32:03.06,1:32:06.02,Default,,0,0,0,,Мен Тамадаға сенбедім.
Dialogue: 0,1:32:08.81,1:32:11.06,Default,,0,0,0,,Осы уақытқа дейін үшеуміз болғандықтан келдік.
Dialogue: 0,1:32:11.48,1:32:15.40,Default,,0,0,0,,Үшеуміз болмасақ, ештеңе де болмас еді.
Dialogue: 0,1:32:17.19,1:32:22.87,Default,,0,0,0,,Мен олармен бірге болғаныма өте қуаныштымын.
Dialogue: 0,1:32:26.12,1:32:27.37,Default,,0,0,0,,(Кенет тежеу дыбысы)
Dialogue: 0,1:32:35.30,1:32:36.96,Default,,0,0,0,,А... (жұмысшы) Эй!
Dialogue: 0,1:32:37.05,1:32:38.80,Default,,0,0,0,,Сіз мені естисіз бе? (Жұмысшы) Савабе!
Dialogue: 0,1:32:38.88,1:32:40.34,Default,,0,0,0,,Савабе! (Жұмысшы) Оның есі бар!
Dialogue: 0,1:32:40.43,1:32:41.76,Default,,0,0,0,,Жедел жәрдем әлі жоқ!
Dialogue: 0,1:32:41.84,1:32:43.89,Default,,0,0,0,,Жүк көлігі қауіпсіз!
Dialogue: 0,1:32:43.97,1:32:46.93,Default,,0,0,0,,А... а... а...
Dialogue: 0,1:32:48.81,1:32:50.56,Default,,0,0,0,,Тұр, Качан (Бакуго), маған ерме!
Dialogue: 0,1:32:52.40,1:32:54.77,Default,,0,0,0,,У... а... (жұмысшы) Не? Сіз не айттыңыз?
Dialogue: 0,1:32:54.86,1:32:57.69,Default,,0,0,0,,Оң жақ… Қалта…
Dialogue: 0,1:32:57.78,1:32:59.19,Default,,0,0,0,,Смартфон…
Dialogue: 0,1:32:59.49,1:33:03.99,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,1:33:04.07,1:33:05.33,Default,,0,0,0,,Қар дұғасы?
Dialogue: 0,1:33:05.41,1:33:07.16,Default,,0,0,0,,Үлкен жаман…
Dialogue: 0,1:33:08.29,1:33:10.75,Default,,0,0,0,,Мен тікелей эфирге шыға алмаймын.
Dialogue: 0,1:33:13.92,1:33:15.67,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:33:17.25,1:33:18.63,Default,,0,0,0,,Үлкен!
Dialogue: 0,1:33:19.05,1:33:21.34,Default,,0,0,0,,Ха... Юкиюки ше?
Dialogue: 0,1:33:21.76,1:33:23.30,Default,,0,0,0,,Арқаға ота жасалып жатыр.
Dialogue: 0,1:33:23.39,1:33:25.80,Default,,0,0,0,,Иә? Сіз қандай жағдайдасыз?
Dialogue: 0,1:33:26.47,1:33:28.39,Default,,0,0,0,,Өмірді сақтап қалуға болатын сияқты.
Dialogue: 0,1:33:29.02,1:33:29.77,Default,,0,0,0,,Тек...
Dialogue: 0,1:33:30.23,1:33:31.64,Default,,0,0,0,,Не!
Dialogue: 0,1:33:32.85,1:33:34.23,Default,,0,0,0,,Менің оң қолым...
Dialogue: 0,1:33:34.94,1:33:36.48,Default,,0,0,0,,Бұл тәртіпсіздік болды
Dialogue: 0,1:33:36.86,1:33:38.07,Default,,0,0,0,,Ах...
Dialogue: 0,1:33:39.11,1:33:41.19,Default,,0,0,0,,Не... неге...
Dialogue: 0,1:33:42.24,1:33:44.36,Default,,0,0,0,,Неліктен бұл болып жатыр?
Dialogue: 0,1:33:45.74,1:33:48.79,Default,,0,0,0,,Рульде ұйықтап қалған шығар.
Dialogue: 0,1:33:49.49,1:33:52.41,Default,,0,0,0,,Менің анам қазір Наганодан келе жатыр.
Dialogue: 0,1:33:59.21,1:34:01.21,Default,,0,0,0,,Тамада Гобе
Dialogue: 0,1:34:04.80,1:34:05.93,Default,,0,0,0,,Қайда...
Dialogue: 0,1:34:07.01,1:34:08.18,Default,,0,0,0,,Go Be
Dialogue: 0,1:34:14.39,1:34:17.36,Default,,0,0,0,,Эй, Акико-сан енді жоқ.
Dialogue: 0,1:34:21.78,1:34:24.07,Default,,0,0,0,,Сіз жаттығуды жоспарлап отырсыз ба?
Dialogue: 0,1:34:24.15,1:34:25.24,Default,,0,0,0,,О
Dialogue: 0,1:34:25.32,1:34:28.33,Default,,0,0,0,,Бір нәрсеге айналғанша орындаңыз
Dialogue: 0,1:34:29.12,1:34:30.08,Default,,0,0,0,,Бірақ Юкибори...
Dialogue: 0,1:34:30.16,1:34:31.20,Default,,0,0,0,,(Иида) Турбо Герой Ингениумды білесің бе?
Dialogue: 0,1:34:31.54,1:34:33.62,Default,,0,0,0,,Мен тоқтай алмайтындай сезінемін
Dialogue: 0,1:34:36.83,1:34:37.63,Default,,0,0,0,,Тіпті бір күнге
Dialogue: 0,1:34:38.38,1:34:40.55,Default,,0,0,0,,Мен тоқтамауым керек сияқты
Dialogue: 0,1:34:46.26,1:34:48.01,Default,,0,0,0,,Тек сол жерде тұрып ұйықтап жат.
Dialogue: 0,1:34:48.89,1:34:50.97,Default,,0,0,0,,Миямото-кун, бірақ содан кейін...
Dialogue: 0,1:34:51.43,1:34:54.06,Default,,0,0,0,,Тұтынушылар қанағаттанбауы мүмкін
Dialogue: 0,1:34:54.68,1:34:56.85,Default,,0,0,0,,Бұл екі адам, бірақ маған рұқсат етіңізші.
Dialogue: 0,1:34:57.81,1:34:59.27,Default,,0,0,0,,Өтінемін
Dialogue: 0,1:35:02.69,1:35:05.49,Default,,0,0,0,,Барлығыңызды жинаңыз, бізде шұғыл жиналыс болады.
Dialogue: 0,1:35:05.57,1:35:06.66,Default,,0,0,0,,Иә!
Dialogue: 0,1:35:14.96,1:35:15.91,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,1:35:16.58,1:35:18.38,Default,,0,0,0,,Сіз ақыры ояндыңыз.
Dialogue: 0,1:35:20.59,1:35:22.59,Default,,0,0,0,,Оны емдеуге болады.
Dialogue: 0,1:35:23.17,1:35:26.30,Default,,0,0,0,,Мүмкін оны емдеуге болады.
Dialogue: 0,1:35:26.97,1:35:28.18,Default,,0,0,0,,Ах...
Dialogue: 0,1:35:28.97,1:35:31.22,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,1:35:46.32,1:35:49.82,Default,,0,0,0,,Учияма Мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,1:35:51.41,1:35:52.53,Default,,0,0,0,,Иә
Dialogue: 0,1:35:56.33,1:35:58.54,Default,,0,0,0,,Юкиюки-кун, не болды?
Dialogue: 0,1:35:58.62,1:35:59.42,Default,,0,0,0,,Иә?
Dialogue: 0,1:36:00.04,1:36:03.21,Default,,0,0,0,,Мен саксофон мен барабан дуэті туралы естіген емеспін.
Dialogue: 0,1:36:03.46,1:36:04.96,Default,,0,0,0,,Ол белгіленеді ме?
Dialogue: 0,1:36:22.81,1:36:23.90,Default,,0,0,0,,Фу…
Dialogue: 0,1:36:24.57,1:36:27.53,Default,,0,0,0,,Қайырлы кеш және SoBlue-ге қош келдіңіз
Dialogue: 0,1:36:28.36,1:36:33.95,Default,,0,0,0,,Осы бағдарламаға соңғы минуттағы негізгі өзгерістер Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,1:36:34.37,1:36:38.46,Default,,0,0,0,,Егер жанды орындаудан кейін көңіліңіз толмаса, бізге хабарлаңыз.
Dialogue: 0,1:36:38.87,1:36:41.42,Default,,0,0,0,,Бүгін өнер көрсетуі тиіс пианист
Dialogue: 0,1:36:42.08,1:36:44.79,Default,,0,0,0,,Мен кеше түнде жол апатына ұшырадым, жағдайым ауыр.
Dialogue: 0,1:36:44.88,1:36:45.63,Default,,0,0,0,,Ха…
Dialogue: 0,1:36:45.71,1:36:47.59,Default,,0,0,0,,Юки-чан...
Dialogue: 0,1:36:47.96,1:36:50.55,Default,,0,0,0,,Нәтиже Тек саксофон мен барабандар
Dialogue: 0,1:36:51.18,1:36:53.51,Default,,0,0,0,,Бұл бұрын-соңды болмаған спектакль болды.
Dialogue: 0,1:36:54.01,1:36:57.89,Default,,0,0,0,,Осы топтың келбеті шешілген күннен бастап, И
Dialogue: 0,1:36:58.35,1:37:01.06,Default,,0,0,0,,Бүгінге дейін оны асыға күттім.
Dialogue: 0,1:37:02.48,1:37:04.52,Default,,0,0,0,,Енді екі адам ғана
Dialogue: 0,1:37:04.98,1:37:06.48,Default,,0,0,0,,Тіпті осы сәтте
Dialogue: 0,1:37:10.70,1:37:11.61,Default,,0,0,0,,Таныстыру
Dialogue: 0,1:37:12.11,1:37:14.82,Default,,0,0,0,,Тенор-саксофон Дай Миямото
Dialogue: 0,1:37:15.49,1:37:16.41,Default,,0,0,0,,барабандар Шундзи Тамада
Dialogue: 0,1:37:16.41,1:37:17.79,Default,,0,0,0,,барабандар Шундзи Тамада
Dialogue: 0,1:37:16.41,1:37:17.79,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:37:17.79,1:37:18.16,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:37:18.16,1:37:19.37,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:37:18.16,1:37:19.37,Default,,0,0,0,,JASS
Dialogue: 0,1:37:19.37,1:37:19.91,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:37:19.91,1:37:20.83,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:37:19.91,1:37:20.83,Default,,0,0,0,,JASS!
Dialogue: 0,1:37:20.83,1:37:20.91,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:37:20.91,1:37:22.96,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:37:20.91,1:37:22.96,Default,,0,0,0,,Үлкен! (Ер тұтынушы) Тамада!
Dialogue: 0,1:37:23.63,1:37:24.88,Default,,0,0,0,,JASS!
Dialogue: 0,1:37:34.51,1:37:35.85,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,1:37:40.10,1:37:41.60,Default,,0,0,0,,
Dialogue: 0,1:37:42.06,1:37:45.81,Default,,0,0,0,,♪ «БІЗ БОЛАМЫЗ»
Dialogue: 0,1:42:49.20,1:42:51.29,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:42:51.29,1:42:55.16,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:42:51.29,1:42:55.16,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,1:43:02.05,1:43:03.30,Default,,0,0,0,,Рахмет
Dialogue: 0,1:43:03.84,1:43:05.88,Default,,0,0,0,,Енді келесі ән
Dialogue: 0,1:43:10.22,1:43:13.14,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,1:43:14.73,1:43:16.60,Default,,0,0,0,,Иә! (Әйел тұтынушы) Керемет!
Dialogue: 0,1:43:16.90,1:43:19.94,Default,,0,0,0,,JASS! (Ер тұтынушы) Миямото!
Dialogue: 0,1:43:22.78,1:43:25.07,Default,,0,0,0,,Қайырлы кеш, бұл JASS.
Dialogue: 0,1:43:25.82,1:43:29.57,Default,,0,0,0,,Кенеттен екеуміз болып қалғаным үшін кешіріңіз.
Dialogue: 0,1:43:29.66,1:43:31.08,Default,,0,0,0,,Тіпті екі адам жақсы болды!
Dialogue: 0,1:43:31.16,1:43:32.04,Default,,0,0,0,,Миямото!
Dialogue: 0,1:43:32.41,1:43:34.50,Default,,0,0,0,,барабандар Шундзи Тамада
Dialogue: 0,1:43:34.83,1:43:36.41,Default,,0,0,0,,Керемет!
Dialogue: 0,1:43:40.50,1:43:42.63,Default,,0,0,0,,Тенор Дай Миямото
Dialogue: 0,1:43:42.71,1:43:44.13,Default,,0,0,0,,Үлкен!
Dialogue: 0,1:43:46.01,1:43:48.59,Default,,0,0,0,,Ал біз бүгін орындаған ән
Dialogue: 0,1:43:49.55,1:43:53.10,Default,,0,0,0,,Бір пианисттің шығармасы
Dialogue: 0,1:43:54.14,1:43:56.31,Default,,0,0,0,,Фортепиано Юкиюки Савабе!
Dialogue: 0,1:43:56.39,1:43:58.35,Default,,0,0,0,,Қар дұғасы! (Ер тұтынушы) Керемет!
Dialogue: 0,1:43:58.44,1:43:59.81,Default,,0,0,0,,JASS - ең жақсы!
Dialogue: 0,1:44:00.98,1:44:04.15,Default,,0,0,0,,Бүгінгі күн үшін рахмет.
Dialogue: 0,1:44:04.23,1:44:06.03,Default,,0,0,0,,JASS! (Ер тұтынушы) Керемет!
Dialogue: 0,1:44:06.11,1:44:07.95,Default,,0,0,0,,Иә!
Dialogue: 0,1:44:13.58,1:44:14.91,Default,,0,0,0,,Хмм...
Dialogue: 0,1:44:22.92,1:44:24.09,Default,,0,0,0,,А...
Dialogue: 0,1:44:33.10,1:44:34.26,Default,,0,0,0,,Қар дұғасы…
Dialogue: 0,1:44:35.26,1:44:36.47,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,1:44:36.77,1:44:37.98,Default,,0,0,0,,Соңғы кездері түн-түні оқып жүргендіктен.
Dialogue: 0,1:44:38.35,1:44:42.19,Default,,0,0,0,,Ауруханалар сізді ауруханадан шығуға мәжбүрлей алады.
Dialogue: 0,1:44:43.31,1:44:44.69,Default,,0,0,0,,Ха…
Dialogue: 0,1:44:47.61,1:44:48.90,Default,,0,0,0,,Фу…
Dialogue: 0,1:44:49.99,1:44:53.03,Default,,0,0,0,,Юкиюки Мен оны аяқтадым.
Dialogue: 0,1:44:53.45,1:44:58.00,Default,,0,0,0,,Ха... Екі-ақ адаммен істегендерің үшін ақымақсыңдар.
Dialogue: 0,1:44:58.83,1:45:01.08,Default,,0,0,0,,Encore Мен де сонда боламын
Dialogue: 0,1:45:01.17,1:45:02.00,Default,,0,0,0,,Иә?
Dialogue: 0,1:45:02.08,1:45:04.84,Default,,0,0,0,,Сен... ақымақ, өле жаздадың.
Dialogue: 0,1:45:04.92,1:45:05.96,Default,,0,0,0,,Ал қолдар...
Dialogue: 0,1:45:06.96,1:45:08.80,Default,,0,0,0,,Менің сол қолым аман.
Dialogue: 0,1:45:09.59,1:45:10.93,Default,,0,0,0,,Барсам болады ма?
Dialogue: 0,1:45:11.26,1:45:12.47,Default,,0,0,0,,О
Dialogue: 0,1:45:13.64,1:45:15.64,Default,,0,0,0,,Керемет, білесіз бе.
Dialogue: 0,1:45:24.15,1:45:24.81,Default,,0,0,0,,Қазір...
Dialogue: 0,1:45:26.69,1:45:27.78,Default,,0,0,0,,Бұл соңғысы.
Dialogue: 0,1:45:28.90,1:45:29.82,Default,,0,0,0,,О
Dialogue: 0,1:45:30.15,1:45:31.53,Default,,0,0,0,,Соңы немен аяқталады?
Dialogue: 0,1:45:32.03,1:45:33.99,Default,,0,0,0,,JASS таратылды
Dialogue: 0,1:45:34.95,1:45:36.20,Default,,0,0,0,,Ах...
Dialogue: 0,1:45:45.54,1:45:48.55,Default,,0,0,0,,Бұл жігіт әлемдегі ең жақсы адам болады.
Dialogue: 0,1:45:50.76,1:45:53.18,Default,,0,0,0,,Тоқтамаңыз
Dialogue: 0,1:45:55.26,1:45:56.39,Default,,0,0,0,,О
Dialogue: 0,1:45:57.76,1:46:00.31,Default,,0,0,0,,Юкиюки Тамада
Dialogue: 0,1:46:01.52,1:46:03.52,Default,,0,0,0,,Біз керемет болдық.
Dialogue: 0,1:46:06.27,1:46:07.40,Default,,0,0,0,,А...
Dialogue: 0,1:46:07.94,1:46:09.44,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,1:46:09.53,1:46:12.36,Default,,0,0,0,,
Dialogue: 0,1:46:15.20,1:46:16.70,Default,,0,0,0,,Юки-чан
Dialogue: 0,1:46:53.28,1:46:54.32,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,1:46:55.70,1:46:57.24,Default,,0,0,0,,
Dialogue: 0,1:46:57.32,1:47:01.87,Default,,0,0,0,,♪ «БІРІНШІ ЕСКЕРТПЕ»
Dialogue: 0,1:53:36.14,1:53:38.56,Default,,0,0,0,,Баяғыда, жас кезімде
Dialogue: 0,1:53:38.93,1:53:41.89,Default,,0,0,0,,Достарыңыздың арасында тамаша джаз ойнаушы туралы сөйлесіңіз.
Dialogue: 0,1:53:44.10,1:53:47.02,Default,,0,0,0,,«КӨК ДЕП» деп аталды.
Dialogue: 0,1:53:47.61,1:53:50.57,Default,,0,0,0,,Температура тым жоғары, қызылдан өтіп жатыр.
Dialogue: 0,1:53:50.65,1:53:53.07,Default,,0,0,0,,Жарқыраған көк жұлдыз туралы.
Dialogue: 0,1:53:54.16,1:53:55.91,Default,,0,0,0,,Бұл тікелей шоу
Dialogue: 0,1:53:56.37,1:53:58.16,Default,,0,0,0,,Ол өте көк түсті.
Dialogue: 0,1:54:35.11,1:54:39.33,Default,,0,0,0,,Профессор Такаянаги
Dialogue: 0,1:54:41.58,1:54:46.58,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,1:58:09.04,1:58:14.04,Default,,0,0,0,,~♪
Dialogue: 0,1:58:16.08,1:58:21.09,Default,,0,0,0,,Ватару!
Dialogue: 0,1:58:35.19,1:58:36.23,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,1:58:38.32,1:58:40.36,Default,,0,0,0,,Эй, сен әуежайдасың ба?
Dialogue: 0,1:58:40.82,1:58:41.78,Default,,0,0,0,,О
Dialogue: 0,1:58:43.78,1:58:47.53,Default,,0,0,0,,Юкиюки маған сіздің фортепианоңыз ұнайды.
Dialogue: 0,1:58:47.95,1:58:49.12,Default,,0,0,0,,Ха…
Dialogue: 0,1:58:49.20,1:58:53.08,Default,,0,0,0,,Мүмкін мен сенің ең үлкен жанкүйерім шығармын.
Dialogue: 0,1:58:57.33,1:58:59.42,Default,,0,0,0,,Уф… Уф…
Dialogue: 0,1:58:59.50,1:59:00.80,Default,,0,0,0,,Тез сауығып кетіңіз
Dialogue: 0,1:59:01.21,1:59:03.42,Default,,0,0,0,,Танжиро~!
Dialogue: 0,1:59:04.01,1:59:06.43,Default,,0,0,0,,Түсінікті, Барса.
Dialogue: 0,1:59:07.59,1:59:09.76,Default,,0,0,0,,Мен келемін.
Dialogue: 0,1:59:11.60,1:59:13.14,Default,,0,0,0,,(Шырылдаған дыбыс)
Dialogue: 0,1:59:13.68,1:59:16.40,Default,,0,0,0,,Жүр!
Dialogue: 0,1:59:21.73,1:59:23.32,Default,,0,0,0,,Оши джаз Якка
Dialogue: 0,1:59:24.82,1:59:30.82,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory