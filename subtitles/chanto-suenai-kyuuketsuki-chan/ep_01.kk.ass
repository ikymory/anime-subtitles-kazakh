Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.00,0:00:12.01,Default,,0,0,0,,<Отори: Трансфер студенті Исикава-сан бұл вампир>
Dialogue: 0,0:00:14.68,0:00:17.35,Default,,0,0,0,,Мен... Исикава мырза.
Dialogue: 0,0:00:17.35,0:00:22.18,Default,,0,0,0,,Мм... мен оны тазалаған кезде оны орнына салып бере аласыз ба?
Dialogue: 0,0:00:22.18,0:00:25.19,Default,,0,0,0,,Бұл жақсы, бірақ бағасы сіздің қаныңыз болады.
Dialogue: 0,0:00:25.19,0:00:27.19,Default,,0,0,0,,Сәлем! ? (Шығу) Бұл қан.
Dialogue: 0,0:00:27.19,0:00:31.03,Default,,0,0,0,,Аа, мен соны айтып едім ғой.
Dialogue: 0,0:00:31.03,0:00:33.20,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:00:33.20,0:00:35.70,Default,,0,0,0,,Аа….
Dialogue: 0,0:00:35.70,0:00:39.53,Default,,0,0,0,,Исикава мырза, бұл тамаша.
Dialogue: 0,0:00:39.53,0:00:42.20,Default,,0,0,0,,Мені басып кетуі мүмкін.
Dialogue: 0,0:00:42.20,0:00:46.21,Default,,0,0,0,,<Жұмбақ атмосферамен және керемет қатысумен➨
Dialogue: 0,0:00:46.21,0:00:49.55,Default,,0,0,0,,Бүкіл сыныптың назарының орталығы.
Dialogue: 0,0:00:49.55,0:00:53.22,Default,,0,0,0,,Мафиоз ретінде мен оған қатыспаймын.
Dialogue: 0,0:00:53.22,0:00:56.42,Default,,0,0,0,,Мен солай ойладым...>
Dialogue: 0,0:01:06.16,0:01:13.57,Default,,0,0,0,,《Ана... мен ана боламын》
Dialogue: 0,0:02:57.04,0:02:59.37,Default,,0,0,0,,＜ Мұнда Кашинокидай➨
Dialogue: 0,0:02:59.37,0:03:02.31,Default,,0,0,0,,Онда әртүрлі адамдар тұрады.
Dialogue: 0,0:03:02.31,0:03:05.65,Default,,0,0,0,,Бұл біршама басқа әлемге айналды➨
Dialogue: 0,0:03:05.65,0:03:10.05,Default,,0,0,0,,Жер құдайының арқасында бәрі тыныш жүріп жатыр.
Dialogue: 0,0:03:20.33,0:03:22.50,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:03:22.50,0:03:24.50,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:03:24.50,0:03:28.00,Default,,0,0,0,,Қайырлы таң, Мисузу-чан. қайырлы таң!
Dialogue: 0,0:03:28.00,0:03:30.34,Default,,0,0,0,,Бұл жер құдайы.
Dialogue: 0,0:03:30.34,0:03:35.01,Default,,0,0,0,,Әй, Танаканың әжесі. Қауіпсіздік үшін дұға етіңіз!
Dialogue: 0,0:03:35.01,0:03:37.01,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:03:37.01,0:03:39.85,Default,,0,0,0,,Қайырлы таң. Иә?
Dialogue: 0,0:03:39.85,0:03:43.02,Default,,0,0,0,,Түрлі оқиғаларға араласып жүріп—
Dialogue: 0,0:03:43.02,0:03:46.32,Default,,0,0,0,,Әй, сен әдемісің.
Dialogue: 0,0:03:50.86,0:03:56.36,Default,,0,0,0,,<Юкай, елестер, басқалар Құбыжықтар мен роботтардың болуы табиғи нәрсе.
Dialogue: 0,0:03:56.36,0:04:01.97,Default,,0,0,0,,Сондықтан ол да сирек емес...>
Dialogue: 0,0:04:01.97,0:04:05.31,Default,,0,0,0,,Исикава мырза өте жақсы.
Dialogue: 0,0:04:05.31,0:04:10.65,Default,,0,0,0,,Ол оқуға жақсы, ал ол вампир!
Dialogue: 0,0:04:10.65,0:04:14.48,Default,,0,0,0,,Исикава мырза қанымды сорса, мен қарсы болмас едім.
Dialogue: 0,0:04:14.48,0:04:16.49,Default,,0,0,0,,Мен де!
Dialogue: 0,0:04:16.49,0:04:18.65,Default,,0,0,0,,Менің темекі шегетінімді әлі көрмедің бе?
Dialogue: 0,0:04:18.65,0:04:20.66,Default,,0,0,0,,А, сен сенімдісің бе?
Dialogue: 0,0:04:20.66,0:04:23.16,Default,,0,0,0,,Сіз бізге назар аударасыз ба?
Dialogue: 0,0:04:23.16,0:04:27.33,Default,,0,0,0,,Сен өте мінсізсің, сен де мейірімдісің!
Dialogue: 0,0:04:27.33,0:04:29.33,Default,,0,0,0,,Кенеттен кетпеңіз! Шығу!
Dialogue: 0,0:04:29.33,0:04:32.33,Default,,0,0,0,,Бірге сөйлесейік, Исикава мырза, төраға!
Dialogue: 0,0:04:32.33,0:04:34.54,Default,,0,0,0,,Төраға емес!
Dialogue: 0,0:04:40.84,0:04:42.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:42.84,0:04:44.85,Default,,0,0,0,,Исикава мырза!
Dialogue: 0,0:04:44.85,0:04:47.35,Default,,0,0,0,,Қайырлы таң! қайырлы таң!
Dialogue: 0,0:04:51.02,0:04:54.62,Default,,0,0,0,,Мен сәлем бердім! Тым керемет!
Dialogue: 0,0:04:59.69,0:05:01.63,Default,,0,0,0,,《Ғажайып》
Dialogue: 0,0:05:01.63,0:05:05.30,Default,,0,0,0,,<Исикава мырзаның біздің мектепке ауысқанына екі апта болды.
Dialogue: 0,0:05:05.30,0:05:08.97,Default,,0,0,0,,Оның танымалдылығында шек жоқ＞
Dialogue: 0,0:05:08.97,0:05:10.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:12.97,0:05:16.14,Default,,0,0,0,,《Жанымда отырудың өзі қобалжытады》
Dialogue: 0,0:05:16.14,0:05:18.81,Default,,0,0,0,,Мен... Исикава мырза.
Dialogue: 0,0:05:18.81,0:05:23.65,Default,,0,0,0,,Мм... мен оны тазалаған кезде оны орнына қоюыңызды өтінемін?
Dialogue: 0,0:05:23.65,0:05:27.16,Default,,0,0,0,,Бұл жақсы, бірақ бағасы сіздің қаныңыз болады.
Dialogue: 0,0:05:27.16,0:05:29.16,Default,,0,0,0,,Сәлем! ?
Dialogue: 0,0:05:29.16,0:05:31.16,Default,,0,0,0,,Әй, мен соны айтып едім ғой.
Dialogue: 0,0:05:31.16,0:05:33.16,Default,,0,0,0,,Иә! (Хашимото) Жақсысың ба?
Dialogue: 0,0:05:33.16,0:05:35.16,Default,,0,0,0,,Жақсы, жақсы.
Dialogue: 0,0:05:37.17,0:05:39.17,Default,,0,0,0,,《Тазалық міндеті?》
Dialogue: 0,0:05:42.50,0:05:44.61,Default,,0,0,0,,《Не! ? Мен де! ? 》
Dialogue: 0,0:05:47.34,0:05:49.68,Default,,0,0,0,,《О...
Dialogue: 0,0:05:49.68,0:05:52.18,Default,,0,0,0,,Уау….
Dialogue: 0,0:05:52.18,0:05:57.02,Default,,0,0,0,,Қобалжу. Екеуміз ғана кезекші боламыз деп ойладым.
Dialogue: 0,0:05:57.02,0:06:02.29,Default,,0,0,0,,Жоқ, жоқ, қазір тынышталайық. Кәдімгі сыныптас ретінде...》
Dialogue: 0,0:06:02.29,0:06:04.63,Default,,0,0,0,,Мен... Исикава мырза. Иә?
Dialogue: 0,0:06:04.63,0:06:08.03,Default,,0,0,0,,Ол сол жағында. Хатаки сұрасам да...
Dialogue: 0,0:06:10.30,0:06:12.30,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:06:12.30,0:06:14.30,Default,,0,0,0,,《Мен жеңіл сөйлей алдым》
Dialogue: 0,0:06:14.30,0:06:17.14,Default,,0,0,0,,Рахмет. Мен қымбат заттарды жасаймын.
Dialogue: 0,0:06:17.14,0:06:20.31,Default,,0,0,0,,Мәселе жоқ. иә?
Dialogue: 0,0:06:20.31,0:06:24.15,Default,,0,0,0,,《Ха! Мен түсінемін. Исикава мырза - вампир.
Dialogue: 0,0:06:24.15,0:06:27.32,Default,,0,0,0,,Мүмкін ұшатын шығар...》
Dialogue: 0,0:06:27.32,0:06:30.49,Default,,0,0,0,,Уншо Фуну!
Dialogue: 0,0:06:30.49,0:06:32.99,Default,,0,0,0,,Уншо! Хмф!
Dialogue: 0,0:06:32.99,0:06:34.99,Default,,0,0,0,,Бұл... Жақсысың ба?
Dialogue: 0,0:06:34.99,0:06:37.83,Default,,0,0,0,,Мен мұнымен жақсымын.
Dialogue: 0,0:06:37.83,0:06:40.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:40.66,0:06:43.67,Default,,0,0,0,,Уау! Исикава мырза!
Dialogue: 0,0:06:43.67,0:06:47.17,Default,,0,0,0,,Кешіріңіз. Өйткені мен өзімді соған мәжбүрледім.
Dialogue: 0,0:06:47.17,0:06:49.17,Default,,0,0,0,,Бол... Шын мәнінде емес.
Dialogue: 0,0:06:49.17,0:06:51.57,Default,,0,0,0,,Қалғанын мен жасаймын, сен демал.
Dialogue: 0,0:06:53.51,0:06:56.01,Default,,0,0,0,,Жарайды, мен сонда барып, шаңын сүртейін.
Dialogue: 0,0:06:56.01,0:06:58.01,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:00.62,0:07:04.79,Default,,0,0,0,,《Тез бітірейік》
Dialogue: 0,0:07:04.79,0:07:07.12,Default,,0,0,0,,Ахх!
Dialogue: 0,0:07:07.12,0:07:10.33,Default,,0,0,0,,Ха, мен таң қалдым.
Dialogue: 0,0:07:13.96,0:07:17.27,Default,,0,0,0,,Мен оның құлайды деп күткен жоқпын.
Dialogue: 0,0:07:19.63,0:07:24.47,Default,,0,0,0,,Мен... Исикава мырза?
Dialogue: 0,0:07:24.47,0:07:27.31,Default,,0,0,0,,Не? О!
Dialogue: 0,0:07:27.31,0:07:30.01,Default,,0,0,0,,Мен де солай істеуім керек пе?
Dialogue: 0,0:07:31.98,0:07:35.32,Default,,0,0,0,,Исикава мырза, сіз жаяу жүретін қоқыс машинасына айналдыңыз.
Dialogue: 0,0:07:35.32,0:07:38.15,Default,,0,0,0,,Шаңды сүрту жақсы емес пе?
Dialogue: 0,0:07:38.15,0:07:40.36,Default,,0,0,0,,Жақсы емес!
Dialogue: 0,0:07:42.32,0:07:46.33,Default,,0,0,0,,《Иә? Исикава мырза осындай ма?
Dialogue: 0,0:07:46.33,0:07:49.63,Default,,0,0,0,,Және көптеген тәттілер》
Dialogue: 0,0:07:52.33,0:07:56.34,Default,,0,0,0,,Сіздің қарныңыз аш болуы мүмкін бе?
Dialogue: 0,0:07:56.34,0:07:59.84,Default,,0,0,0,,Gik! Бұл шындық болуы мүмкін емес, иә?
Dialogue: 0,0:07:59.84,0:08:02.11,Default,,0,0,0,,Шынымен бе? Aren't you patient?
Dialogue: 0,0:08:02.11,0:08:05.45,Default,,0,0,0,,Come to think of it, I had tomato juice for lunch➨
Dialogue: 0,0:08:05.45,0:08:08.28,Default,,0,0,0,,Even before cleaning, I ate sweets in the classroom.
Dialogue: 0,0:08:08.28,0:08:11.79,Default,,0,0,0,,Бұл мен тәттілерді жақсы көретіндіктен!
Dialogue: 0,0:08:11.79,0:08:14.96,Default,,0,0,0,,Did you see that? кешіріңіз.
Dialogue: 0,0:08:14.96,0:08:18.29,Default,,0,0,0,,Бірақ вампирлер не жейді?
Dialogue: 0,0:08:18.29,0:08:20.80,Default,,0,0,0,,Әдетте бұл қан.
Dialogue: 0,0:08:22.80,0:08:25.63,Default,,0,0,0,,Ah, I knew it.
Dialogue: 0,0:08:25.63,0:08:28.30,Default,,0,0,0,,Мен бұл туралы ойламауға тырыстым.
Dialogue: 0,0:08:28.30,0:08:32.97,Default,,0,0,0,,Кешіріңіз... Кешіріңіз. But it's also not good to tolerate hunger too much.
Dialogue: 0,0:08:32.97,0:08:35.64,Default,,0,0,0,,Suck? Mine.
Dialogue: 0,0:08:35.64,0:08:37.65,Default,,0,0,0,,Не, бұл сізге керек емес пе?
Dialogue: 0,0:08:37.65,0:08:40.15,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:08:40.15,0:08:44.49,Default,,0,0,0,,-ге... Мен бұған жақсы емеспін.
Dialogue: 0,0:08:44.49,0:08:50.16,Default,,0,0,0,,Because I don't know how much force to apply or where the blood vessels are!
Dialogue: 0,0:08:50.16,0:08:53.33,Default,,0,0,0,,Бұл адамға байланысты. Мен түсінемін.
Dialogue: 0,0:08:53.33,0:08:56.83,Default,,0,0,0,,《Қан сору жақсы емес》
Dialogue: 0,0:08:56.83,0:08:59.67,Default,,0,0,0,,⸨Баға - сіздің қаныңыз⸩
Dialogue: 0,0:08:59.67,0:09:01.60,Default,,0,0,0,,Сонда бұл не?
Dialogue: 0,0:09:01.60,0:09:04.61,Default,,0,0,0,,Because that's the kind of character he is.
Dialogue: 0,0:09:04.61,0:09:06.61,Default,,0,0,0,,《Character! 》
Dialogue: 0,0:09:09.28,0:09:11.45,Default,,0,0,0,,Уф….
Dialogue: 0,0:09:11.45,0:09:13.95,Default,,0,0,0,,Mr. Ishikawa. Иә?
Dialogue: 0,0:09:15.95,0:09:19.62,Default,,0,0,0,,Менімен бірге жаттығуға қалай қарайсыз?
Dialogue: 0,0:09:19.62,0:09:22.12,Default,,0,0,0,,Re... practice?
Dialogue: 0,0:09:22.12,0:09:25.29,Default,,0,0,0,,Иә. Мен инъекцияға жақсымын➨
Dialogue: 0,0:09:25.29,0:09:28.60,Default,,0,0,0,,I think it's okay even if it hurts a little.
Dialogue: 0,0:09:30.80,0:09:33.80,Default,,0,0,0,,Иә! ? No no, that's it!
Dialogue: 0,0:09:33.80,0:09:35.80,Default,,0,0,0,,Не? Өйткені мен оған өте нашармын!
Dialogue: 0,0:09:35.80,0:09:38.31,Default,,0,0,0,,Бұл елестету мүмкін емес! ? мүмкін.
Dialogue: 0,0:09:38.31,0:09:41.81,Default,,0,0,0,,Бірақ егер , бәрі жақсы.
Dialogue: 0,0:09:41.81,0:09:45.31,Default,,0,0,0,,Your stomach will swell as you get better at sucking blood.
Dialogue: 0,0:09:45.31,0:09:47.32,Default,,0,0,0,,Бір оқпен екі құсты өлтіру, солай ма?
Dialogue: 0,0:09:47.32,0:09:49.32,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:51.32,0:09:53.99,Default,,0,0,0,,Ал... осынша айтсаң ба?
Dialogue: 0,0:09:53.99,0:09:55.99,Default,,0,0,0,,Өтінемін, өтінемін.
Dialogue: 0,0:10:04.83,0:10:06.84,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:10:12.17,0:10:15.08,Default,,0,0,0,,《Бұл... бұл...》
Dialogue: 0,0:10:19.85,0:10:23.65,Default,,0,0,0,,《Мен ана боламын...》
Dialogue: 0,0:10:29.69,0:10:31.69,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:33.70,0:10:35.70,Default,,0,0,0,,Кешіріңіз, мен тым көп темекі шектім.
Dialogue: 0,0:10:35.70,0:10:38.20,Default,,0,0,0,,Үлкен құс...
Dialogue: 0,0:10:40.70,0:10:43.87,Default,,0,0,0,,Өйткені ол өте дәмді болды.
Dialogue: 0,0:10:43.87,0:10:49.88,Default,,0,0,0,,Well, if you don't mind, let's practice...!
Dialogue: 0,0:10:49.88,0:10:53.68,Default,,0,0,0,,Уау! Үлкен құс! ?
Dialogue: 0,0:10:56.05,0:11:00.56,Default,,0,0,0,,Ауауа....
Dialogue: 0,0:11:07.66,0:11:09.66,Default,,0,0,0,,Ах.
Dialogue: 0,0:11:11.67,0:11:13.67,Default,,0,0,0,,《Бұл Исикава мырза.
Dialogue: 0,0:11:13.67,0:11:17.51,Default,,0,0,0,,Ух, мен инъекцияға жақсымын➨
Dialogue: 0,0:11:17.51,0:11:21.81,Default,,0,0,0,,Жаттығу жасаймын ба? Бұл аздап интрузивті болды.
Dialogue: 0,0:11:29.68,0:11:32.69,Default,,0,0,0,,《Кеше өтірік сияқты》
Dialogue: 0,0:11:34.69,0:11:37.69,Default,,0,0,0,,⸨Темекі шегетінім үшін кешіріңіз, Отори.
Dialogue: 0,0:11:37.69,0:11:40.70,Default,,0,0,0,,Суды көп ішіп, көп ұйықтаңыз.
Dialogue: 0,0:11:40.70,0:11:42.70,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:11:42.70,0:11:44.70,Default,,0,0,0,,《Қан тапсырғыңыз келе ме? 》
Dialogue: 0,0:11:44.70,0:11:47.37,Default,,0,0,0,,Асқазаныңыз жақсы ма, Исикава мырза?
Dialogue: 0,0:11:47.37,0:11:52.04,Default,,0,0,0,,Иә. Ах...
Dialogue: 0,0:11:52.04,0:11:55.04,Default,,0,0,0,,Бұл туралы ешкімге айтпа.
Dialogue: 0,0:11:55.04,0:11:59.71,Default,,0,0,0,,Мм, сіз қан соруға шебер емессіз бе? Апыр-ай! ?
Dialogue: 0,0:11:59.71,0:12:01.65,Default,,0,0,0,,Бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:12:01.65,0:12:04.15,Default,,0,0,0,,Вампирлер салқын болуы керек!
Dialogue: 0,0:12:04.15,0:12:08.66,Default,,0,0,0,,Сонымен... Тыныш.
Dialogue: 0,0:12:08.66,0:12:10.66,Default,,0,0,0,,Жоқ, солай ма?
Dialogue: 0,0:12:10.66,0:12:13.16,Default,,0,0,0,,《Маған солай айтты➨
Dialogue: 0,0:12:13.16,0:12:16.33,Default,,0,0,0,,Мен мұны айтсам да, олар маған сенбейтін шығар.
Dialogue: 0,0:12:16.33,0:12:18.33,Default,,0,0,0,,Өйткені ол...》
Dialogue: 0,0:12:20.67,0:12:23.34,Default,,0,0,0,,Керемет. (Барлығы) О!
Dialogue: 0,0:12:23.34,0:12:27.34,Default,,0,0,0,,《Жұмбақ әрі салқын, Әр адамның арманы.
Dialogue: 0,0:12:27.34,0:12:31.01,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:12:31.01,0:12:34.02,Default,,0,0,0,,Бұл ұнтақ тәрізді》
Dialogue: 0,0:12:36.68,0:12:39.19,Default,,0,0,0,,Исикава мырза.
Dialogue: 0,0:12:39.19,0:12:41.19,Default,,0,0,0,,Жеңдер лас.
Dialogue: 0,0:12:41.19,0:12:43.36,Default,,0,0,0,,Аю... Рахмет.
Dialogue: 0,0:12:43.36,0:12:45.69,Default,,0,0,0,,Сіз бірдеңе жеп жатырсыз ба?
Dialogue: 0,0:12:45.69,0:12:47.70,Default,,0,0,0,,(жөтел дауысы)
Dialogue: 0,0:12:47.70,0:12:50.03,Default,,0,0,0,,Амансың ба? тынышталыңыз.
Dialogue: 0,0:12:50.03,0:12:52.03,Default,,0,0,0,,дейін... Мәселе жоқ.
Dialogue: 0,0:12:52.03,0:12:54.04,Default,,0,0,0,,Ах.
Dialogue: 0,0:12:59.87,0:13:02.31,Default,,0,0,0,,Жоқ... ол жерде жоқ!
Dialogue: 0,0:13:02.31,0:13:04.31,Default,,0,0,0,,Исикава мырза.
Dialogue: 0,0:13:06.31,0:13:09.15,Default,,0,0,0,,Сіз әлі аштыңыз ба? Бұл небәрі екінші сағат.
Dialogue: 0,0:13:09.15,0:13:12.32,Default,,0,0,0,,Бүгін де таңғы ас ішкен жоқпын.
Dialogue: 0,0:13:12.32,0:13:15.82,Default,,0,0,0,,Бұл тәттілер ғана қалды.
Dialogue: 0,0:13:15.82,0:13:19.66,Default,,0,0,0,,Бірақ сіз тамақты тоқтата алмайсыз, солай ма?
Dialogue: 0,0:13:19.66,0:13:22.16,Default,,0,0,0,,Түскі асқа не істеу керек?
Dialogue: 0,0:13:22.16,0:13:27.00,Default,,0,0,0,,《Кәмпиттермен алдай алмайсың ба?》
Dialogue: 0,0:13:27.00,0:13:31.84,Default,,0,0,0,,Сонымен, оны шегіңіз келе ме? иә?
Dialogue: 0,0:13:31.84,0:13:35.51,Default,,0,0,0,,Не, енді! ? Өйткені➨
Dialogue: 0,0:13:35.51,0:13:38.51,Default,,0,0,0,,Алдай алмасаң, сорып алудан басқа амалың жоқ.
Dialogue: 0,0:13:38.51,0:13:41.35,Default,,0,0,0,,Неліктен мотивацияңыз көбірек! ?
Dialogue: 0,0:13:41.35,0:13:44.19,Default,,0,0,0,,Айтайын дегенім, анықталатыны анық.
Dialogue: 0,0:13:44.19,0:13:47.36,Default,,0,0,0,,Менің ойымша, ол жұмыс істейді, өйткені ол ашылмайды.
Dialogue: 0,0:13:47.36,0:13:53.03,Default,,0,0,0,,Енді басып шығарыңыз. иә? Баспаға келетін болсақ... Кешіріңіз.
Dialogue: 0,0:13:53.03,0:13:55.36,Default,,0,0,0,,Мен сізге алып беремін, өз бетіңізше оқыңыз.
Dialogue: 0,0:13:55.36,0:13:58.53,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:13:58.53,0:14:00.64,Default,,0,0,0,,Өздігінен оқу деп аталса да.
Dialogue: 0,0:14:00.64,0:14:03.81,Default,,0,0,0,,Онда мен саған үйретемін!
Dialogue: 0,0:14:03.81,0:14:08.48,Default,,0,0,0,,Сіз математиканы түсінбейсіз бе? (Хашимото) Орындарыңызға отырыңыз!
Dialogue: 0,0:14:08.48,0:14:10.48,Default,,0,0,0,,Енді.
Dialogue: 0,0:14:10.48,0:14:14.98,Default,,0,0,0,,Жоқ, жоқ, бірақ кеше менің қолым толды...
Dialogue: 0,0:14:14.98,0:14:16.98,Default,,0,0,0,,Сорылғаннан кейін солай ойладым➨
Dialogue: 0,0:14:16.98,0:14:19.65,Default,,0,0,0,,Мен оны біріншіден дұрыс шайнамадым➨
Dialogue: 0,0:14:19.65,0:14:23.16,Default,,0,0,0,,Қан сорғаның жаман емес пе?
Dialogue: 0,0:14:23.16,0:14:25.49,Default,,0,0,0,,Үйде не істейсің?
Dialogue: 0,0:14:25.49,0:14:28.33,Default,,0,0,0,,Негізі бұл көп емес...
Dialogue: 0,0:14:28.33,0:14:30.33,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:30.33,0:14:32.67,Default,,0,0,0,,Сондықтан...
Dialogue: 0,0:14:32.67,0:14:37.17,Default,,0,0,0,,Үлкен құс алғаш рет қанды дұрыс сора алдым.
Dialogue: 0,0:14:37.17,0:14:39.84,Default,,0,0,0,,Мен осы уақытқа дейін әртүрлі нәрселерді қолданып көрдім➨
Dialogue: 0,0:14:39.84,0:14:42.18,Default,,0,0,0,,Мен мұны ешқашан жақсы орындай алмадым.
Dialogue: 0,0:14:42.18,0:14:45.51,Default,,0,0,0,,Егер солай болса, мен оған шыдауым керек шығар.
Dialogue: 0,0:14:45.51,0:14:47.85,Default,,0,0,0,,Диета? Ұнайды.
Dialogue: 0,0:14:47.85,0:14:49.85,Default,,0,0,0,,Исикава мырза.
Dialogue: 0,0:14:49.85,0:14:52.85,Default,,0,0,0,,Бұл туралы алаңдамаңыз. Иә?
Dialogue: 0,0:14:52.85,0:14:57.69,Default,,0,0,0,,Мен Исикава мырзаның тәжірибесінде онымен бірге жүруді шештім.
Dialogue: 0,0:14:57.69,0:15:00.63,Default,,0,0,0,,Үлкен құс….
Dialogue: 0,0:15:00.63,0:15:03.13,Default,,0,0,0,,Мен бар күшімді саламын!
Dialogue: 0,0:15:03.13,0:15:05.13,Default,,0,0,0,,Бұл сіздің ниетіңіз, Исикава мырза.
Dialogue: 0,0:15:05.13,0:15:08.30,Default,,0,0,0,,Менен де толқып тұрсың ба?
Dialogue: 0,0:15:08.30,0:15:11.81,Default,,0,0,0,,Әзірше, профессор, сіз қайтып келгенше.
Dialogue: 0,0:15:11.81,0:15:13.81,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:15:15.81,0:15:17.81,Default,,0,0,0,,Итадакимашу!
Dialogue: 0,0:15:17.81,0:15:21.82,Default,,0,0,0,,Чомчому….
Dialogue: 0,0:15:24.99,0:15:28.66,Default,,0,0,0,,Отори: Мен бүгін жақсы жұмыс істегендей болдым.
Dialogue: 0,0:15:28.66,0:15:30.66,Default,,0,0,0,,Иә... бұл жақсы.
Dialogue: 0,0:15:30.66,0:15:32.66,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:15:32.66,0:15:36.00,Default,,0,0,0,,Иә? Не болды, Исикава мырза?
Dialogue: 0,0:15:36.00,0:15:38.83,Default,,0,0,0,,Не, сіз анемиясыз ба?
Dialogue: 0,0:15:38.83,0:15:43.50,Default,,0,0,0,,Менің таңдауым жоқ. Мен сені емханаға апарамын.
Dialogue: 0,0:15:43.50,0:15:45.51,Default,,0,0,0,,Не~! ? Мен қызғаншақпын!
Dialogue: 0,0:15:45.51,0:15:47.51,Default,,0,0,0,,Мен де анемиямын!
Dialogue: 0,0:15:49.51,0:15:52.35,Default,,0,0,0,,Уф, Отори, кешіріңіз.
Dialogue: 0,0:15:52.35,0:15:55.18,Default,,0,0,0,,Жоқ, қазірден бастап барымызды салайық.
Dialogue: 0,0:15:55.18,0:15:57.85,Default,,0,0,0,,Мен сені емханаға апарамын!
Dialogue: 0,0:15:57.85,0:16:00.15,Default,,0,0,0,,Иә! Сасасаса!
Dialogue: 0,0:16:08.30,0:16:11.30,Default,,0,0,0,,Иә, жарайды.
Dialogue: 0,0:16:11.30,0:16:17.51,Default,,0,0,0,,Әму Әму Хмм.
Dialogue: 0,0:16:21.14,0:16:25.35,Default,,0,0,0,,Ах. Хмм….
Dialogue: 0,0:16:29.98,0:16:32.32,Default,,0,0,0,,Бұл тұлып екен➨
Dialogue: 0,0:16:32.32,0:16:36.49,Default,,0,0,0,,Мен дұрыс дем алып жатқанымды білмеймін.
Dialogue: 0,0:16:36.49,0:16:38.49,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:44.83,0:16:46.83,Default,,0,0,0,,Е! ?
Dialogue: 0,0:16:46.83,0:16:50.34,Default,,0,0,0,,Мен бүгін Исикава мырзаны шақыра аламын деп ойладым.
Dialogue: 0,0:16:50.34,0:16:53.34,Default,,0,0,0,,Эйко Нан сатылып кетті.
Dialogue: 0,0:16:53.34,0:16:55.34,Default,,0,0,0,,Мектепке қабылдау сыйы ретінде маған берілген тау велосипеді
Dialogue: 0,0:17:09.12,0:17:13.63,Default,,0,0,0,,Ах, Исикава мырза.
Dialogue: 0,0:17:13.63,0:17:17.47,Default,,0,0,0,,Үлкен құс!
Dialogue: 0,0:17:17.47,0:17:20.30,Default,,0,0,0,,Исикава мырза еріп барады! ?
Dialogue: 0,0:17:20.30,0:17:23.30,Default,,0,0,0,,Жарайды! ? Күннің нұрымен.
Dialogue: 0,0:17:23.30,0:17:27.31,Default,,0,0,0,,Жоқ, жақсы. иә? Солай ма?
Dialogue: 0,0:17:27.31,0:17:31.48,Default,,0,0,0,,Бұл вампирлер туралы бәрі ойлайтыннан сәл өзгеше➨
Dialogue: 0,0:17:31.48,0:17:33.48,Default,,0,0,0,,Бұл кейіпкердің құлдырауы.
Dialogue: 0,0:17:33.48,0:17:36.15,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:17:36.15,0:17:38.65,Default,,0,0,0,,Сонымен крест пен сарымсақ ше?
Dialogue: 0,0:17:38.65,0:17:41.66,Default,,0,0,0,,Өте жақсы. Маған ұнайды.
Dialogue: 0,0:17:41.66,0:17:44.49,Default,,0,0,0,,Керемет.
Dialogue: 0,0:17:44.49,0:17:48.83,Default,,0,0,0,,⸨Вампирлер салқын болуы керек! ⸩
Dialogue: 0,0:17:48.83,0:17:54.50,Default,,0,0,0,,Исикава мырза вампир бейнесін бағалайтын сияқты.
Dialogue: 0,0:17:54.50,0:17:58.17,Default,,0,0,0,,Мен сен вампир болған соң ұша аласың ба деп ойладым➨
Dialogue: 0,0:17:58.17,0:18:00.11,Default,,0,0,0,,Бұл да...
Dialogue: 0,0:18:00.11,0:18:02.11,Default,,0,0,0,,Міне! Мен жай ғана аш болдым!
Dialogue: 0,0:18:04.78,0:18:08.45,Default,,0,0,0,,Сіз бәрібір жаттығуды қалайсыз ба?
Dialogue: 0,0:18:08.45,0:18:11.29,Default,,0,0,0,,Жоқ, жарайды, мен тоқтаймын!
Dialogue: 0,0:18:11.29,0:18:13.29,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:18:13.29,0:18:16.12,Default,,0,0,0,,Мен бұрын шырын іштім.
Dialogue: 0,0:18:16.12,0:18:18.79,Default,,0,0,0,,Жарайды, себебі сіздің ішіңіз иілгіш.
Dialogue: 0,0:18:18.79,0:18:21.80,Default,,0,0,0,,《Көп қараймын》
Dialogue: 0,0:18:21.80,0:18:25.97,Default,,0,0,0,,Түскі қорапты алып келген үлкен құс➨
Dialogue: 0,0:18:25.97,0:18:29.30,Default,,0,0,0,,Тез тамақ ішпесеңіз, түскі үзілісіңіз бітеді.
Dialogue: 0,0:18:29.30,0:18:33.31,Default,,0,0,0,,Иә. Негізі сыйлық болды.
Dialogue: 0,0:18:33.31,0:18:35.31,Default,,0,0,0,,Қазіргі?
Dialogue: 0,0:18:35.31,0:18:37.81,Default,,0,0,0,,Исикава мырза, сіз тәттілерді ұнатасыз, солай ма?
Dialogue: 0,0:18:37.81,0:18:41.32,Default,,0,0,0,,Иә. Атаның таңдауы!
Dialogue: 0,0:18:41.32,0:18:44.65,Default,,0,0,0,,Бірақ бұл өте сүйкімді! рақмет сізге!
Dialogue: 0,0:18:44.65,0:18:46.65,Default,,0,0,0,,Сондай-ақ толтыру бар.
Dialogue: 0,0:18:46.65,0:18:49.32,Default,,0,0,0,,Сен оны қорапқа салып әкелгеніңді жақсы көремін.
Dialogue: 0,0:18:49.32,0:18:54.33,Default,,0,0,0,,Мен оны аламын...
Dialogue: 0,0:18:54.33,0:18:57.16,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:18:57.16,0:18:59.33,Default,,0,0,0,,Исикава мырза?
Dialogue: 0,0:18:59.33,0:19:02.44,Default,,0,0,0,,Қай жерде тамақтану керек? ? иә?
Dialogue: 0,0:19:02.44,0:19:06.27,Default,,0,0,0,,Мен әрқашан өз басымнан бастаймын. Рақымсыз!
Dialogue: 0,0:19:06.27,0:19:09.11,Default,,0,0,0,,Мүмкін сіз мұндай нәрсеге жақсы емес шығарсыз?
Dialogue: 0,0:19:09.11,0:19:11.61,Default,,0,0,0,,О, олай емес.
Dialogue: 0,0:19:11.61,0:19:16.12,Default,,0,0,0,,Шындығында, мен оны жақсы көретінім соншалық, оның тәртіпсіз болып кеткеніне өкінемін➨
Dialogue: 0,0:19:16.12,0:19:19.62,Default,,0,0,0,,Жұмбақтар мені қобалжытады.
Dialogue: 0,0:19:19.62,0:19:22.96,Default,,0,0,0,,Бұл туралы уайымдаудың қажеті жоқ! Пуф!
Dialogue: 0,0:19:22.96,0:19:25.63,Default,,0,0,0,,Не? Үлкен құс?
Dialogue: 0,0:19:25.63,0:19:29.46,Default,,0,0,0,,Мен үлкен құс емеспін, мен тауықпын➨
Dialogue: 0,0:19:29.46,0:19:33.97,Default,,0,0,0,,Міне, бұл Көкқошан!
Dialogue: 0,0:19:33.97,0:19:35.97,Default,,0,0,0,,Коккочан! ?
Dialogue: 0,0:19:35.97,0:19:37.97,Default,,0,0,0,,Луна-чан мейірімді қыз.
Dialogue: 0,0:19:37.97,0:19:42.14,Default,,0,0,0,,Бірақ мүмкін➨
Dialogue: 0,0:19:42.14,0:19:44.98,Default,,0,0,0,,Сіз тістеп алудан қорықпайсыз ба?
Dialogue: 0,0:19:44.98,0:19:49.32,Default,,0,0,0,,Жарайды! Батыл болыңыз және оны қатты айтыңыз!
Dialogue: 0,0:19:49.32,0:19:51.82,Default,,0,0,0,,Көкқошанның да айтқаны.
Dialogue: 0,0:19:51.82,0:19:54.49,Default,,0,0,0,,Сәлем! Пух!
Dialogue: 0,0:19:54.49,0:19:58.16,Default,,0,0,0,,Ахахаха! Күте тұрыңыз, осы параметрді жалғастырыңыз! ?
Dialogue: 0,0:19:58.16,0:20:00.66,Default,,0,0,0,,Иә. Ах.
Dialogue: 0,0:20:00.66,0:20:03.66,Default,,0,0,0,,Иә! Пух! Ахахаха!
Dialogue: 0,0:20:03.66,0:20:06.67,Default,,0,0,0,,Мен сені үнемі бақылап отырамын!
Dialogue: 0,0:20:06.67,0:20:11.51,Default,,0,0,0,,Ей! О, бұл мені қатты күлдіреді.
Dialogue: 0,0:20:11.51,0:20:14.01,Default,,0,0,0,,Ахаха, жақсы.
Dialogue: 0,0:20:14.01,0:20:17.01,Default,,0,0,0,,Осы қарқынмен біз мұны істей аламыз деп ойлаймын.
Dialogue: 0,0:20:22.52,0:20:24.52,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:26.52,0:20:29.69,Default,,0,0,0,,Ендеше, қазірден бастап дұрыс шайнап бастасаңыз...
Dialogue: 0,0:20:29.69,0:20:35.03,Default,,0,0,0,,Сіз қанды жақсы сора аласыз ба? Міне бітті.
Dialogue: 0,0:20:35.03,0:20:39.37,Default,,0,0,0,,Сол үлкен құс. Иә?
Dialogue: 0,0:20:39.37,0:20:43.54,Default,,0,0,0,,Мм... жаттығу жасай аламын ба?
Dialogue: 0,0:20:43.54,0:20:45.87,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:45.87,0:20:49.08,Default,,0,0,0,,Ендеше неге сонша толқыдың?
Dialogue: 0,0:20:51.71,0:20:54.92,Default,,0,0,0,,Аа, ауырса айтыңызшы? Түсінді.
Dialogue: 0,0:20:56.88,0:21:00.15,Default,,0,0,0,,Күрсін... Жарайды.
Dialogue: 0,0:21:00.15,0:21:02.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:02.82,0:21:04.83,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:21:04.83,0:21:07.50,Default,,0,0,0,,Иә, солай, Исикава мырза.
Dialogue: 0,0:21:07.50,0:21:09.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:16.67,0:21:19.34,Default,,0,0,0,,Уау….
Dialogue: 0,0:21:19.34,0:21:22.84,Default,,0,0,0,,Үлкен құсқа рахмет!
Dialogue: 0,0:21:22.84,0:21:27.35,Default,,0,0,0,,Керемет Исикава мырза, құсқа ұқсайды.
Dialogue: 0,0:21:27.35,0:21:29.52,Default,,0,0,0,,Құсқа ұқсайды!
Dialogue: 0,0:21:29.52,0:21:33.69,Default,,0,0,0,,Құс! Ахахха!
Dialogue: 0,0:21:33.69,0:21:36.86,Default,,0,0,0,,Құстар - вампирлер!
Dialogue: 0,0:21:36.86,0:21:39.86,Default,,0,0,0,,Ахахха хахахаха!
Dialogue: 0,0:21:39.86,0:21:43.53,Default,,0,0,0,,Бар күшімізді сала берейік, Исикава мырза.
Dialogue: 0,0:21:43.53,0:21:47.03,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:47.03,0:21:50.70,Default,,0,0,0,,＜ Сол күні мен Исикава мырзаның жаттығу үстелінде болдым ➨
Dialogue: 0,0:21:50.70,0:21:54.11,Default,,0,0,0,,Мен ана болдым >
Dialogue: 0,0:23:27.00,0:23:31.17,Default,,0,0,0,,Исикава мырза қан сорғанда кішірейеді, солай ма?
Dialogue: 0,0:23:31.17,0:23:33.17,Default,,0,0,0,,⸨Иә! ⸩
Dialogue: 0,0:23:33.17,0:23:35.68,Default,,0,0,0,,Неліктен бұл? Ол вампир болғандықтан ба?
Dialogue: 0,0:23:35.68,0:23:39.08,Default,,0,0,0,,Иә? Кішкентай? иә?
Dialogue: 0,0:23:40.58,0:23:46.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory