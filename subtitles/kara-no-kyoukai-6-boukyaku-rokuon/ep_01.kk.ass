Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.55,0:00:07.55,CNsub,NTP,0,0,0,,КамиГами
Dialogue: 0,0:58:56.65,0:59:01.45,CNsub,NTP,0,0,0,,＠/···
Dialogue: 0,0:49:51.52,0:50:02.44,EDJ,NTP,0000,0000,0000,,Бала кезімде қалдырған армандарым есіме түсті.
Dialogue: 0,0:50:02.76,0:50:19.48,EDJ,NTP,0000,0000,0000,,Менің ертегім жас шөптей мұңның нәзік, тәтті әнін айтады.
Dialogue: 0,0:50:19.74,0:50:31.10,EDJ,NTP,0000,0000,0000,,Ештеңе бітпейтін мәңгілікті білдім.
Dialogue: 0,0:50:31.37,0:50:44.43,EDJ,NTP,0000,0000,0000,,Ешкім айтпайтын екі адамның әңгімесі
Dialogue: 0,0:50:45.11,0:50:56.03,EDJ,NTP,0000,0000,0000,,Бір сүйгенді артқа тастап, қайда бара жатырсың?
Dialogue: 0,0:50:56.46,0:51:13.00,EDJ,NTP,0000,0000,0000,,Жалғыз нұрды құшақтап, Қараңғыда орманда жоғалып кетемін
Dialogue: 0,0:51:13.47,0:51:24.48,EDJ,NTP,0000,0000,0000,,Алыста жүрген сағыныш жүздері
Dialogue: 0,0:51:24.76,0:51:42.18,EDJ,NTP,0000,0000,0000,,Шаңырағың алыс, Жетпейсің, Ертегің
Dialogue: 0,0:52:04.71,0:52:10.16,EDJ,NTP,0000,0000,0000,,Мен армандаған мәңгілік (жабық қалады)
Dialogue: 0,0:52:10.32,0:52:20.97,EDJ,NTP,0000,0000,0000,,Қате терең (жасырын қалады) және үйге қайтар жолда жоғалады
Dialogue: 0,0:52:21.18,0:52:35.25,EDJ,NTP,0000,0000,0000,,Мен сені енді көре алмаймын...Сау бол
Dialogue: 0,0:52:35.37,0:52:45.97,EDJ,NTP,0000,0000,0000,,Тұманды орман арқылы қайда бара жатырсың?
Dialogue: 0,0:52:46.50,0:52:57.37,EDJ,NTP,0000,0000,0000,,Бір ғана толқын, ертеңге қалдыр
Dialogue: 0,0:52:57.89,0:53:08.71,EDJ,NTP,0000,0000,0000,,Мен саған ғашық болсам, мәңгілік бітеді
Dialogue: 0,0:53:09.16,0:53:25.76,EDJ,NTP,0000,0000,0000,,Өмірдің қуанышы мен азабы нұрдан басталады
Dialogue: 0,0:49:51.52,0:50:02.44,EDC,NTP,0000,0000,0000,,Қысқа армандарды еске түсіру
Dialogue: 0,0:50:02.76,0:50:19.48,EDC,NTP,0000,0000,0000,,менің ертегім
Dialogue: 0,0:50:19.74,0:50:31.10,EDC,NTP,0000,0000,0000,,Түбінде мәңгілік мәңгілік
Dialogue: 0,0:50:31.37,0:50:44.43,EDC,NTP,0000,0000,0000,,Білімсіз екі адам туралы әңгіме
Dialogue: 0,0:50:45.11,0:50:56.03,EDC,NTP,0000,0000,0000,,Сіз қайда барасыз?
Dialogue: 0,0:50:56.46,0:51:13.00,EDC,NTP,0000,0000,0000,,Қараңғыда жарық шамы жоғалады.
Dialogue: 0,0:51:13.47,0:51:24.48,EDC,NTP,0000,0000,0000,,Рейджиннің өшпенді бейнесі баратын жерге сапарға шығар алдында.
Dialogue: 0,0:51:24.76,0:51:42.18,EDC,NTP,0000,0000,0000,,Сіздің ертегіңіз
Dialogue: 0,0:52:04.71,0:52:10.16,EDC,NTP,0000,0000,0000,,Түсінде бір нәрсені көру әрқашан тұрақты.
Dialogue: 0,0:52:10.32,0:52:20.97,EDC,NTP,0000,0000,0000,,Күнәнің тереңдігі
Dialogue: 0,0:52:21.18,0:52:35.25,EDC,NTP,0000,0000,0000,,……
Dialogue: 0,0:52:35.37,0:52:45.97,EDC,NTP,0000,0000,0000,,Орманнан қалай қашуға болады
Dialogue: 0,0:52:46.50,0:52:57.37,EDC,NTP,0000,0000,0000,,Бір қимыл, бір қол, ертеңге дейін және кейін
Dialogue: 0,0:52:57.89,0:53:08.71,EDC,NTP,0000,0000,0000,,Баршаңызды құттықтаймын.
Dialogue: 0,0:53:09.16,0:53:25.76,EDC,NTP,0000,0000,0000,,Өмір сүрудің қуанышы, қуанышы, азабы мен азабы бірден жарықта басталады
Dialogue: 0,0:02:31.66,0:02:33.86,JPsub,NTP,0000,0000,0000,,Мен балалық шағымды армандадым.
Dialogue: 0,0:02:36.70,0:02:38.22,JPsub,NTP,0000,0000,0000,,Мен әрқашан ұмытатынмын
Dialogue: 0,0:02:40.88,0:02:42.97,JPsub,NTP,0000,0000,0000,,Көпке дейін есіме түсіре алмадым
Dialogue: 0,0:02:46.36,0:02:49.97,JPsub,NTP,0000,0000,0000,,Алыстағы күнді армандау
Dialogue: 0,0:04:15.59,0:04:19.68,JPsub,NTP,0000,0000,0000,,Мен, Куроранж Сенка, 16 жасар сиқыршының шәкіртімін.
Dialogue: 0,0:04:20.58,0:04:22.56,JPsub,NTP,0000,0000,0000,,Микия Курогири аға ретінде бар
Dialogue: 0,0:04:22.97,0:04:24.98,JPsub,NTP,0000,0000,0000,,Тоуко Аосаки оның шебері болып табылады.
Dialogue: 0,0:04:25.42,0:04:28.10,JPsub,NTP,0000,0000,0000,,Екі ырым да махаббатта дұшпан.
Dialogue: 0,0:04:33.25,0:04:35.14,JPsub,NTP,0000,0000,0000,,Оны қиналған қыз деп атайды.
Dialogue: 0,0:04:36.57,0:04:38.94,JPsub,NTP,0000,0000,0000,,Аа, түсінбеушілік жоқ екенін ескеріңіз.
Dialogue: 0,0:04:39.35,0:04:43.60,JPsub,NTP,0000,0000,0000,,Мәселе оның туған ағасына романтикалық қызығушылық танытуында емес.
Dialogue: 0,0:04:44.21,0:04:50.03,JPsub,NTP,0000,0000,0000,,Мен Микия Курогири туралы шындап, шындап ойлайтыным сонша, бұл мен бе деп ойлаймын.
Dialogue: 0,0:04:51.71,0:04:53.33,JPsub,NTP,0000,0000,0000,,Ағасының асырап алуы
Dialogue: 0,0:04:54.85,0:04:57.38,JPsub,NTP,0000,0000,0000,,Интернатқа бару
Dialogue: 0,0:04:58.22,0:05:04.54,JPsub,NTP,0000,0000,0000,,Екеуміздің бөлек тұруымыз да Микияға мені өзінің қарындасы ретінде ұмыттыру үшін жасалған қадам.
Dialogue: 0,0:05:05.51,0:05:09.23,JPsub,NTP,0000,0000,0000,,Дәл қазір менде бір ғана мәселе бар.
Dialogue: 0,0:05:11.38,0:05:14.98,JPsub,NTP,0000,0000,0000,,Бүйірден көрініп, нысанаға алынған әйел
Dialogue: 0,0:05:15.66,0:05:21.95,JPsub,NTP,0000,0000,0000,,Ағай, та-да-и-маааааа
Dialogue: 0,0:05:25.53,0:05:26.61,JPsub,NTP,0000,0000,0000,,Қош келдіңіз Сенька
Dialogue: 0,0:05:29.41,0:05:30.05,JPsub,NTP,0000,0000,0000,,Йо
Dialogue: 0,0:05:31.03,0:05:33.50,JPsub,NTP,0000,0000,0000,,Түсіндім, жаңа гүлдерді бірінші рет көріп тұрсың.
Dialogue: 0,0:05:33.77,0:05:36.58,JPsub,NTP,0000,0000,0000,,Мен сені сыныптасым Рёшикимен таныстырғым келеді.
Dialogue: 0,0:05:36.64,0:05:39.86,JPsub,NTP,0000,0000,0000,,Сол әйел мен Микияны мүмкіндігінше тезірек ажыратыңыз.
Dialogue: 0,0:05:40.14,0:05:42.78,JPsub,NTP,0000,0000,0000,,Микияны қауіпті оқиғалардан аулақ ұстау
Dialogue: 0,0:05:44.86,0:05:49.48,JPsub,NTP,0000,0000,0000,,Осы мақсатта мен ақыл-оймен де, шеберлікпен де тең бәсекелес болуға тырысамын.
Dialogue: 0,0:05:50.13,0:05:52.48,JPsub,NTP,0000,0000,0000,,Мен тіпті сиқыршының шәкірті болдым.
Dialogue: 0,0:05:53.57,0:05:57.35,JPsub,NTP,0000,0000,0000,,Міне, осындай сау адамның әңгімесі
Dialogue: 0,0:05:58.06,0:05:59.78,JPsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:06:03.83,0:06:05.94,JPsub,NTP,0000,0000,0000,,Нені айтып тұрсың, Туко-сан?
Dialogue: 0,0:06:06.46,0:06:10.34,JPsub,NTP,0000,0000,0000,,Ой, аман-есен жеткен сияқтысың, құпия қаруың осында.
Dialogue: 0,0:06:10.78,0:06:12.91,JPsub,NTP,0000,0000,0000,,Сіздің құпия қаруыңыз қандай?
Dialogue: 0,0:06:13.62,0:06:15.69,JPsub,NTP,0000,0000,0000,,Менің сізге жазған өтінішім есіңізде ме?
Dialogue: 0,0:06:16.36,0:06:19.11,JPsub,NTP,0000,0000,0000,,Рейен қыздар академиясындағы перілерді бақылау
Dialogue: 0,0:06:19.27,0:06:23.17,JPsub,NTP,0000,0000,0000,,Оқушыларды алаңдататын сиқыршыларды анықтау және жою
Dialogue: 0,0:06:23.82,0:06:24.93,JPsub,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:06:25.10,0:06:30.08,JPsub,NTP,0000,0000,0000,,Олай болса, перілерді көре алмайтын Сенькаға көз керек.
Dialogue: 0,0:06:31.00,0:06:32.65,JPsub,NTP,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:06:38.23,0:06:43.83,JPsub,NTP,0000,0000,0000,,Бұл ханшайым Туко Аозаки сұраған Риоги рәсімі.
Dialogue: 0,0:06:46.91,0:06:50.08,JPsub,NTP,0000,0000,0000,,Тооко-санның ақымақтығы
Dialogue: 0,0:06:53.95,0:06:55.85,JPsub,NTP,0000,0000,0000,,Мен күйзелісті қазірдің өзінде сезінемін.
Dialogue: 0,0:06:57.15,0:06:58.47,JPsub,NTP,0000,0000,0000,,Ештеңе болмайды.
Dialogue: 0,0:06:59.69,0:07:03.07,JPsub,NTP,0000,0000,0000,,Шики Сеньканы сіңлісіндей ойлайды.
Dialogue: 0,0:07:03.97,0:07:05.72,JPsub,NTP,0000,0000,0000,,Ай, сен түсінбейсің.
Dialogue: 0,0:07:06.99,0:07:08.09,JPsub,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:07:08.97,0:07:10.33,JPsub,NTP,0000,0000,0000,,Барлығы
Dialogue: 0,0:07:18.30,0:07:20.30,JPsub,NTP,0000,0000,0000,,Мен бұл туралы біраз уақыт ойладым.
Dialogue: 0,0:07:21.00,0:07:23.54,JPsub,NTP,0000,0000,0000,,Менің ойымша, Туко шын мәнінде мылқау.
Dialogue: 0,0:07:24.43,0:07:28.94,JPsub,NTP,0000,0000,0000,,Дұрыс, сенің мектепке жасырын кіруге рұқсат бергеніме сене алар емеспін.
Dialogue: 0,0:07:29.63,0:07:31.60,JPsub,NTP,0000,0000,0000,,Менің ойымша, бұл ақылсыздық емес.
Dialogue: 0,0:07:32.99,0:07:37.20,JPsub,NTP,0000,0000,0000,,Бұл қорқынышты. Мен бұл жолы міндетті түрде құрбан боламын.
Dialogue: 0,0:07:37.53,0:07:40.88,JPsub,NTP,0000,0000,0000,,Жаңа жылдың басында, маған перілерді табуға көмектес.
Dialogue: 0,0:07:41.51,0:07:42.77,JPsub,NTP,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:07:43.52,0:07:49.66,JPsub,NTP,0000,0000,0000,,Өкінішке орай, менде сіз бен Туко-сан сияқты жын көзі жоқ.
Dialogue: 0,0:07:54.22,0:07:56.57,JPsub,NTP,0000,0000,0000,,Әй, бұл гүл ит пе?
Dialogue: 0,0:07:57.29,0:07:59.06,JPsub,NTP,0000,0000,0000,,Мен бөлмеге кірсем, ол артымнан ерді.
Dialogue: 0,0:07:59.63,0:08:00.63,JPsub,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:08:01.00,0:08:06.38,JPsub,NTP,0000,0000,0000,,Ол бала қазір отбасымен шетелде жүрген менің бөлме құрбым Сеоның иті.
Dialogue: 0,0:08:09.01,0:08:11.05,JPsub,NTP,0000,0000,0000,,Мен оны сіздің өтінішіңіз бойынша өңдеп жатырмын.
Dialogue: 0,0:08:11.54,0:08:15.20,JPsub,NTP,0000,0000,0000,,Мені сені емдеуді сұрайды, бірақ менің қожайыным сияқты тентек болу қиын.
Dialogue: 0,0:08:23.17,0:08:26.84,JPsub,NTP,0000,0000,0000,,Бұл мектеп қатаң мектеп болғанымен, үй жануарларына төзімді.
Dialogue: 0,0:08:30.82,0:08:32.69,JPsub,NTP,0000,0000,0000,,Толеранттылық бөлінбейді
Dialogue: 0,0:08:32.92,0:08:34.56,JPsub,NTP,0000,0000,0000,,Мені мұнда неге әкелдің?
Dialogue: 0,0:08:35.15,0:08:37.65,JPsub,NTP,0000,0000,0000,,Неге, мен мұны бұрын айттым.
Dialogue: 0,0:08:37.95,0:08:39.85,JPsub,NTP,0000,0000,0000,,Бөлмеңізге тез оралыңыз
Dialogue: 0,0:08:42.31,0:08:43.27,JPsub,NTP,0000,0000,0000,,Жылдамырақ
Dialogue: 0,0:08:56.91,0:08:58.40,JPsub,NTP,0000,0000,0000,,Өйткені бізде интернат бар.
Dialogue: 0,0:08:58.69,0:09:01.07,JPsub,NTP,0000,0000,0000,,Қысқы каникулда да оқушылар аз.
Dialogue: 0,0:09:01.33,0:09:03.31,JPsub,NTP,0000,0000,0000,,Ең көзге түсетін мінез-құлық
Dialogue: 0,0:09:06.87,0:09:08.33,JPsub,NTP,0000,0000,0000,,Бұл шіркеу.
Dialogue: 0,0:09:08.55,0:09:09.58,JPsub,NTP,0000,0000,0000,,Не көрдіңіз?
Dialogue: 0,0:09:10.21,0:09:11.53,JPsub,NTP,0000,0000,0000,,Сіз масса жасайсыз ба?
Dialogue: 0,0:09:13.75,0:09:16.76,JPsub,NTP,0000,0000,0000,,Көктегі Әкеміз арқылы
Dialogue: 0,0:09:17.06,0:09:18.49,JPsub,NTP,0000,0000,0000,,Қоңыраумен не істеуім керек?
Dialogue: 0,0:09:19.29,0:09:21.24,JPsub,NTP,0000,0000,0000,,Иә? Сіз келісесіз бе?
Dialogue: 0,0:09:27.00,0:09:31.94,JPsub,NTP,0000,0000,0000,,Әзірше мен 1-курстың 4-сыныбының сынып жетекшісімен сөйлесемін.
Dialogue: 0,0:09:32.74,0:09:34.00,JPsub,NTP,0000,0000,0000,,Бұл Хаяма ма?
Dialogue: 0,0:09:34.59,0:09:38.75,JPsub,NTP,0000,0000,0000,,Жоқ, профессор Хаяма қараша айында кенеттен қайтыс болды.
Dialogue: 0,0:09:39.14,0:09:42.31,JPsub,NTP,0000,0000,0000,,Қауіпті адамдармен кездесіп жүр деген қауесет тарады.
Dialogue: 0,0:09:42.87,0:09:45.54,JPsub,NTP,0000,0000,0000,,Ол Токио шығанағында батып кеткен болуы мүмкін.
Dialogue: 0,0:09:46.46,0:09:49.24,JPsub,NTP,0000,0000,0000,,Ол жігіт жақсы мұғалім бола алар еді.
Dialogue: 0,0:09:49.73,0:09:51.49,JPsub,NTP,0000,0000,0000,,Өйткені ол төрағаның інісі.
Dialogue: 0,0:09:53.64,0:09:56.20,JPsub,NTP,0000,0000,0000,,Сонымен, менің қазіргі сынып мұғалімім
Dialogue: 0,0:09:58.29,0:09:59.91,JPsub,NTP,0000,0000,0000,,Генгири мырза
Dialogue: 0,0:10:05.60,0:10:07.97,JPsub,NTP,0000,0000,0000,,Бұл Курогири Сенка, жылына бір топ.
Dialogue: 0,0:10:08.89,0:10:11.76,JPsub,NTP,0000,0000,0000,,Сен анадан естідің бе?
Dialogue: 0,0:10:13.54,0:10:14.04,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:10:20.98,0:10:23.88,JPsub,NTP,0000,0000,0000,,Естеліктерді ұрлайтын пері туралы қауесеттер
Dialogue: 0,0:10:25.41,0:10:29.77,JPsub,NTP,0000,0000,0000,,Иә, студенттерден бірнеше сауалдар алдық.
Dialogue: 0,0:10:30.42,0:10:33.16,JPsub,NTP,0000,0000,0000,,Сонымен мұғалімге не болды?
Dialogue: 0,0:10:34.35,0:10:39.26,JPsub,NTP,0000,0000,0000,,Перілер тек бұзақылықты жақсы көреді, сондықтан көп уайымдамаңыз.
Dialogue: 0,0:10:39.69,0:10:40.90,JPsub,NTP,0000,0000,0000,,Сенесің бе?
Dialogue: 0,0:10:42.05,0:10:42.65,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:10:44.02,0:10:47.82,JPsub,NTP,0000,0000,0000,,Ертегілер фольклоры Жапонияда сирек болса керек.
Dialogue: 0,0:10:48.51,0:10:50.35,JPsub,NTP,0000,0000,0000,,Бұл Еуропада танымал.
Dialogue: 0,0:10:52.27,0:10:55.43,JPsub,NTP,0000,0000,0000,,Сіз Уэльстен болдыңыз, солай ма?
Dialogue: 0,0:10:55.63,0:10:57.92,JPsub,NTP,0000,0000,0000,,Иә, менің елімде
Dialogue: 0,0:10:57.98,0:11:03.67,JPsub,NTP,0000,0000,0000,,Мысық пері, ит пері сияқты сүйкімді ертегілер өте көп.
Dialogue: 0,0:11:04.66,0:11:07.00,JPsub,NTP,0000,0000,0000,,Маған да ұнайды.
Dialogue: 0,0:11:14.84,0:11:19.83,JPsub,NTP,0000,0000,0000,,Сіз перілердің адамдарды өлтіретінін естідіңіз бе?
Dialogue: 0,0:11:23.30,0:11:27.39,JPsub,NTP,0000,0000,0000,,Сіз Каори Тачибана туралы айтып отырсыз ба?
Dialogue: 0,0:11:27.78,0:11:28.22,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:11:28.84,0:11:33.85,JPsub,NTP,0000,0000,0000,,4-сынып оқушылары оны өз-өзіне қол жұмсамады, бірақ пері шабуыл жасады деп есептейді...
Dialogue: 0,0:11:34.87,0:11:35.63,JPsub,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:11:39.45,0:11:42.84,JPsub,NTP,0000,0000,0000,,Эй, Хуанджи-кун, ол кез келді ме?
Dialogue: 0,0:11:43.76,0:11:45.20,JPsub,NTP,0000,0000,0000,,Иә, Сатсуки-сенсэй.
Dialogue: 0,0:11:45.72,0:11:48.48,JPsub,NTP,0000,0000,0000,,Белгіленген сағат өтіп кетті.
Dialogue: 0,0:11:49.99,0:11:54.12,JPsub,NTP,0000,0000,0000,,Студенттік кеңестің төрағасы Мисая Хуанджи, басқарма төрағасының қызы.
Dialogue: 0,0:11:49.47,0:11:53.92,JPsub,NTP,0000,0000,0000,,Уақыт мәңгі емес, сондықтан оны тиімді пайдалануымыз керек.
Dialogue: 0,0:11:54.73,0:11:56.59,JPsub,NTP,0000,0000,0000,,Хуанджи-кун қатал.
Dialogue: 0,0:11:57.48,0:12:00.40,JPsub,NTP,0000,0000,0000,,Мәңгілік те қиын
Dialogue: 0,0:12:06.10,0:12:10.74,JPsub,NTP,0000,0000,0000,,Мен Тачибана-кунды пері деп ойламаймын.
Dialogue: 0,0:12:13.14,0:12:15.21,JPsub,NTP,0000,0000,0000,,Курогири мырза, солай ма?
Dialogue: 0,0:12:15.47,0:12:16.89,JPsub,NTP,0000,0000,0000,,Иә, Сенпай
Dialogue: 0,0:12:17.69,0:12:20.91,JPsub,NTP,0000,0000,0000,,Сатсуки мырзаның сіздің ісіңізге еш қатысы жоқ.
Dialogue: 0,0:12:21.17,0:12:23.71,JPsub,NTP,0000,0000,0000,,Ешқандай қиындық тудырмаңыз.
Dialogue: 0,0:12:25.59,0:12:26.19,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:12:52.31,0:12:55.57,JPsub,NTP,0000,0000,0000,,Қатысқан 14-сынып оқушыларына тыйым салынады.
Dialogue: 0,0:12:55.76,0:12:57.97,JPsub,NTP,0000,0000,0000,,Оқиға туралы барлығы айту керек.
Dialogue: 0,0:12:58.23,0:13:00.11,JPsub,NTP,0000,0000,0000,,Біз басқасын кесіп өтуіміз керек пе?
Dialogue: 0,0:13:02.48,0:13:03.61,JPsub,NTP,0000,0000,0000,,Не болды, формула?
Dialogue: 0,0:13:08.94,0:13:13.34,JPsub,NTP,0000,0000,0000,,А-а, сен таң қалдың ба, өйткені Генгири-сенсэй Микияға ұқсайды.
Dialogue: 0,0:13:14.47,0:13:17.97,JPsub,NTP,0000,0000,0000,,А, сондықтан оның алдында ұялшақ болып көрінесің.
Dialogue: 0,0:13:18.07,0:13:22.60,JPsub,NTP,0000,0000,0000,,Не, бұл не? Бұл оны айтудың коннотативтік тәсілі.
Dialogue: 0,0:13:22.90,0:13:25.21,JPsub,NTP,0000,0000,0000,,Мен олай ойламаймын.
Dialogue: 0,0:13:25.94,0:13:30.23,JPsub,NTP,0000,0000,0000,,Қалай болғанда да, бұл адам Сацуки Генгири.
Dialogue: 0,0:13:30.59,0:13:34.28,JPsub,NTP,0000,0000,0000,,Қаншалықты ұқсас болса да, ол Микия Курогири емес.
Dialogue: 0,0:13:35.23,0:13:38.09,JPsub,NTP,0000,0000,0000,,Олардың ұқсастығын айтудың орнына,
Dialogue: 0,0:13:39.71,0:13:40.50,JPsub,NTP,0000,0000,0000,,штамп картаңды қатты үнемдеп жинап, дәл қолданар сәтте оның мерзімі өтіп кеткенін байқағандай жүз жаса,
Dialogue: 0,0:13:44.20,0:13:44.82,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:14:05.74,0:14:07.08,JPsub,NTP,0000,0000,0000,,Не болды, формула?
Dialogue: 0,0:14:07.77,0:14:08.56,JPsub,NTP,0000,0000,0000,,Жұмыс
Dialogue: 0,0:14:10.57,0:14:11.42,JPsub,NTP,0000,0000,0000,,Эй, формула
Dialogue: 0,0:14:11.90,0:14:13.25,JPsub,NTP,0000,0000,0000,,Өзімшіл ештеңе жасамаңыз
Dialogue: 0,0:14:13.64,0:14:14.93,JPsub,NTP,0000,0000,0000,,өрнек болса
Dialogue: 0,0:14:16.69,0:14:17.49,JPsub,NTP,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:14:40.32,0:14:41.53,JPsub,NTP,0000,0000,0000,,Сенка Курогири
Dialogue: 0,0:15:24.38,0:15:26.60,JPsub,NTP,0000,0000,0000,,Ей, балғын гүлдер, жел соғады
Dialogue: 0,0:15:27.13,0:15:29.26,JPsub,NTP,0000,0000,0000,,Ми, Микия
Dialogue: 0,0:15:35.11,0:15:38.18,JPsub,NTP,0000,0000,0000,,Соққы
Dialogue: 0,0:15:39.23,0:15:41.15,JPsub,NTP,0000,0000,0000,,(Жаңа атқарушы)
Dialogue: 0,0:15:41.40,0:15:43.81,JPsub,NTP,0000,0000,0000,,Кенет не істеп жатырсың, ақымақ?
Dialogue: 0,0:15:43.99,0:15:45.13,JPsub,NTP,0000,0000,0000,,Сіз ояусыз.
Dialogue: 0,0:15:47.89,0:15:50.69,JPsub,NTP,0000,0000,0000,,Сенька Сіз сағат неше екенін білесіз бе?
Dialogue: 0,0:15:51.71,0:15:54.37,JPsub,NTP,0000,0000,0000,,Бұл 14:00-ден кейін болды.
Dialogue: 0,0:16:02.05,0:16:04.36,JPsub,NTP,0000,0000,0000,,Өрнек, мен, мүмкін емес
Dialogue: 0,0:16:04.80,0:16:07.07,JPsub,NTP,0000,0000,0000,,Оны пері ұрлап кеткен.
Dialogue: 0,0:16:16.63,0:16:19.87,JPsub,NTP,0000,0000,0000,,Сиқыршының қайда екенін білмеймін, бірақ мен оны ақымақ қыламын.
Dialogue: 0,0:16:20.00,0:16:24.07,JPsub,NTP,0000,0000,0000,,Жылап кешірім сұрасаң да сені ешқашан кешірмейді.
Dialogue: 0,0:16:32.53,0:16:34.21,JPsub,NTP,0000,0000,0000,,Бұл да басқаша ма?
Dialogue: 0,0:16:36.34,0:16:36.87,JPsub,NTP,0000,0000,0000,,Не болды, апа?
Dialogue: 0,0:16:37.60,0:16:39.95,JPsub,NTP,0000,0000,0000,,Сенька өте батыл.
Dialogue: 0,0:16:40.77,0:16:43.41,JPsub,NTP,0000,0000,0000,,Төраға болсаң, бүгін бір жерде жаңа жылдық шырша.
Dialogue: 0,0:16:43.64,0:16:45.45,JPsub,NTP,0000,0000,0000,,Өйткені ол ертеңге дейін келмейтіні анық.
Dialogue: 0,0:16:46.56,0:16:49.87,JPsub,NTP,0000,0000,0000,,Иә? Бұл құлыптаулы жалғыз орын.
Dialogue: 0,0:16:52.84,0:16:53.61,JPsub,NTP,0000,0000,0000,,Формула?
Dialogue: 0,0:17:14.77,0:17:16.17,JPsub,NTP,0000,0000,0000,,Қандай әйел
Dialogue: 0,0:17:21.68,0:17:23.35,JPsub,NTP,0000,0000,0000,,Раббым рахмет
Dialogue: 0,0:17:38.68,0:17:39.39,JPsub,NTP,0000,0000,0000,,болды
Dialogue: 0,0:17:40.44,0:17:42.28,JPsub,NTP,0000,0000,0000,,Тачибана Каори оқиғасынан кейін бірден
Dialogue: 0,0:17:42.41,0:17:47.04,JPsub,NTP,0000,0000,0000,,1 курс 4-сынып студенттеріне қатысты жағдайларға қатысты ішкі құжаттар.
Dialogue: 0,0:17:49.28,0:17:55.43,JPsub,NTP,0000,0000,0000,,Каори Тачибананың мінез-құлқы екінші семестрдің басынан бері біртүрлі болды.
Dialogue: 0,0:17:56.17,0:17:58.68,JPsub,NTP,0000,0000,0000,,Кенет арықтап, өңім бозарып кетті.
Dialogue: 0,0:17:59.24,0:18:01.52,JPsub,NTP,0000,0000,0000,,Сіз үнемі бір нәрседен қорқатын сияқтысыз.
Dialogue: 0,0:18:01.75,0:18:03.67,JPsub,NTP,0000,0000,0000,,Оқиға болған күні сабақ үстінде.
Dialogue: 0,0:18:04.59,0:18:05.54,JPsub,NTP,0000,0000,0000,,Бұл мүмкін емес қой?
Dialogue: 0,0:18:07.04,0:18:11.00,JPsub,NTP,0000,0000,0000,,Перілер, перілер келеді
Dialogue: 0,0:18:14.50,0:18:17.37,JPsub,NTP,0000,0000,0000,,Тачибана күтіңіз, Тачибана
Dialogue: 0,0:18:18.78,0:18:22.27,JPsub,NTP,0000,0000,0000,,Сосын ескі мектеп ғимараты өртеніп кетті ғой?
Dialogue: 0,0:18:23.14,0:18:25.29,JPsub,NTP,0000,0000,0000,,Осындай айқын айғақ бар.
Dialogue: 0,0:18:25.46,0:18:27.21,JPsub,NTP,0000,0000,0000,,Қазір есімде жоқ
Dialogue: 0,0:18:27.83,0:18:30.55,JPsub,NTP,0000,0000,0000,,Мен Тачибана Каори оқиғасын өшіруге тырысамын.
Dialogue: 0,0:18:30.94,0:18:32.68,JPsub,NTP,0000,0000,0000,,Сиқыршы ертегі
Dialogue: 0,0:18:32.97,0:18:35.32,JPsub,NTP,0000,0000,0000,,Өйткені, Хаяма күдіктенеді
Dialogue: 0,0:18:36.15,0:18:38.06,JPsub,NTP,0000,0000,0000,,Сырт көзге бозарып көрінесіз.
Dialogue: 0,0:18:40.04,0:18:42.44,JPsub,NTP,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:18:44.05,0:18:45.57,JPsub,NTP,0000,0000,0000,,О, Туко-сан
Dialogue: 0,0:19:19.52,0:19:24.16,JPsub,NTP,0000,0000,0000,,Сонымен, мен бүгін кездестірген адамдардың арасында біртүрлі адам болды.
Dialogue: 0,0:19:28.05,0:19:28.81,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:19:29.63,0:19:30.72,JPsub,NTP,0000,0000,0000,,Әй, жаңа гүлдер
Dialogue: 0,0:19:31.86,0:19:35.91,JPsub,NTP,0000,0000,0000,,Перілер ұрлаған естеліктер қайтып оралмайды?
Dialogue: 0,0:19:36.37,0:19:37.88,JPsub,NTP,0000,0000,0000,,Міне солай.
Dialogue: 0,0:19:38.16,0:19:39.23,JPsub,NTP,0000,0000,0000,,Неге қазір?
Dialogue: 0,0:19:39.74,0:19:43.92,JPsub,NTP,0000,0000,0000,,Жоқ, адамдар естеліктерінің жойылғанын да білмейді.
Dialogue: 0,0:19:44.09,0:19:45.20,JPsub,NTP,0000,0000,0000,,Мен жақсы үлгімін.
Dialogue: 0,0:19:47.53,0:19:50.88,JPsub,NTP,0000,0000,0000,,Олай болса, ертегішінің мақсаты кісі өлтіру емес еді.
Dialogue: 0,0:19:51.70,0:19:54.64,JPsub,NTP,0000,0000,0000,,Менің ойымша, бұл дәл осылай болды.
Dialogue: 0,0:19:55.87,0:20:00.32,JPsub,NTP,0000,0000,0000,,Жалпы, перілерге сенбей өмір сүру де, өлтіру де оңай.
Dialogue: 0,0:20:01.84,0:20:03.00,JPsub,NTP,0000,0000,0000,,Ендеше, енді біз сол орта мектепті тексереміз және—
Dialogue: 0,0:20:03.39,0:20:06.60,JPsub,NTP,0000,0000,0000,,Түсіндім, сіздің естеліктеріңізді ұрлауыңыздың себебі бірінші орында.
Dialogue: 0,0:20:07.24,0:20:11.66,JPsub,NTP,0000,0000,0000,,Ұмытқыңыз келетін нәрселер мен жасырғыңыз келетін естеліктер бар.
Dialogue: 0,0:20:22.85,0:20:25.44,JPsub,NTP,0000,0000,0000,,Өрнек Жасырылған нәрсе болады.
Dialogue: 0,0:20:31.18,0:20:32.33,JPsub,NTP,0000,0000,0000,,Ақымақ болма
Dialogue: 0,0:20:33.16,0:20:36.36,JPsub,NTP,0000,0000,0000,,Мен бұрын дәмханада тозған пышақты сұрадым.
Dialogue: 0,0:20:36.92,0:20:40.32,JPsub,NTP,0000,0000,0000,,Бұл жай ғана пышақ, алаңдайтын ештеңе жоқ.
Dialogue: 0,0:20:40.41,0:20:44.13,JPsub,NTP,0000,0000,0000,,Жоқ, сіз кілттерді сызғышпен өлтіретін адамсыз.
Dialogue: 0,0:20:44.39,0:20:46.56,JPsub,NTP,0000,0000,0000,,Оларды сәндік мақсатта жинаймын.
Dialogue: 0,0:20:47.20,0:20:49.33,JPsub,NTP,0000,0000,0000,,Мен оны саған не болса да бермеймін.
Dialogue: 0,0:20:50.53,0:20:51.52,JPsub,NTP,0000,0000,0000,,Сіз бізге кедергі келтіріп жатырсыз.
Dialogue: 0,0:20:52.43,0:20:55.23,JPsub,NTP,0000,0000,0000,,Жарайды, мен күш қолданамын.
Dialogue: 0,0:20:57.14,0:20:58.89,JPsub,NTP,0000,0000,0000,,Мынаны маған беріңіз.
Dialogue: 0,0:21:01.54,0:21:04.19,JPsub,NTP,0000,0000,0000,,Осыны маған берсеңіз
Dialogue: 0,0:21:06.07,0:21:07.02,JPsub,NTP,0000,0000,0000,,Бұл қандай жаман иіс?
Dialogue: 0,0:21:08.83,0:21:10.43,JPsub,NTP,0000,0000,0000,,Бұл ақымақ күш
Dialogue: 0,0:21:11.78,0:21:13.16,JPsub,NTP,0000,0000,0000,,Гомен Асобаза
Dialogue: 0,0:21:13.32,0:21:16.85,JPsub,NTP,0000,0000,0000,,Бірақ бұл Микияны төмен түсіруге жеткілікті деп ойлаймын.
Dialogue: 0,0:21:17.00,0:21:22.29,JPsub,NTP,0000,0000,0000,,Не, не, не айтып тұрсың?
Dialogue: 0,0:21:22.35,0:21:26.36,JPsub,NTP,0000,0000,0000,,Менің басқа ниетім жоқ, дәл осылай ойладым.
Dialogue: 0,0:21:30.88,0:21:32.46,JPsub,NTP,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,0:21:33.05,0:21:34.62,JPsub,NTP,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:21:35.31,0:21:37.43,JPsub,NTP,0000,0000,0000,,Себебі мен білетін адам емес едім.
Dialogue: 0,0:21:37.63,0:21:41.93,JPsub,NTP,0000,0000,0000,,Кем дегенде, бұл сұраққа жауап беретін адам оны түсінбейді, сондықтан бұл дұрыс деп ойлаймын.
Dialogue: 0,0:21:42.32,0:21:45.58,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:21:50.69,0:21:52.37,JPsub,NTP,0000,0000,0000,,Неліктен бұл жақсы?
Dialogue: 0,0:21:53.61,0:21:56.28,JPsub,NTP,0000,0000,0000,,Балалар сендер аға мен апасыңдар, солай ма?
Dialogue: 0,0:21:59.96,0:22:04.80,JPsub,NTP,0000,0000,0000,,Мойындауым керек, маған ерекше нәрселер ұнайды.
Dialogue: 0,0:22:05.23,0:22:09.67,JPsub,NTP,0000,0000,0000,,Керісінше, мен тыйым салынған нәрселерді қызықтыратын сияқтымын.
Dialogue: 0,0:22:09.99,0:22:12.81,JPsub,NTP,0000,0000,0000,,Сондықтан мен жақсы көретін адам жақын туыс.
Dialogue: 0,0:22:12.87,0:22:14.98,JPsub,NTP,0000,0000,0000,,Мен өзімді бақыттымын деп ойлаймын.
Dialogue: 0,0:22:17.12,0:22:17.76,JPsub,NTP,0000,0000,0000,,Бұл азғын
Dialogue: 0,0:22:20.07,0:22:21.63,JPsub,NTP,0000,0000,0000,,Не, нормадан ауытқу?
Dialogue: 0,0:22:27.45,0:22:31.54,JPsub,NTP,0000,0000,0000,,Сұрақ, мен Микияны қашан ұната бастадым?
Dialogue: 0,0:22:31.74,0:22:33.92,JPsub,NTP,0000,0000,0000,,Ол кездегі естеліктеріңіз жоқ.
Dialogue: 0,0:22:35.89,0:22:39.31,JPsub,NTP,0000,0000,0000,,Өрнек Ояну Қазірдің өзінде оян.
Dialogue: 0,0:22:39.58,0:22:43.66,JPsub,NTP,0000,0000,0000,,Бүгін іс-шарада ескі мектеп ғимаратындағы өртті көремін деп айттыңыз.
Dialogue: 0,0:22:44.15,0:22:46.17,JPsub,NTP,0000,0000,0000,,О, оян, ақымақ
Dialogue: 0,0:22:48.22,0:22:49.54,JPsub,NTP,0000,0000,0000,,Мәңгі ұйқы
Dialogue: 0,0:22:59.95,0:23:01.83,JPsub,NTP,0000,0000,0000,,Курогири мырза, қала аласыз ба?
Dialogue: 0,0:23:02.22,0:23:03.98,JPsub,NTP,0000,0000,0000,,Сені ағаң шақырып жатыр.
Dialogue: 0,0:23:05.06,0:23:05.95,JPsub,NTP,0000,0000,0000,,Аға
Dialogue: 0,0:23:20.26,0:23:24.12,JPsub,NTP,0000,0000,0000,,Енді жиналып, тергеуді бастайық.
Dialogue: 0,0:23:31.44,0:23:37.91,JPsub,NTP,0000,0000,0000,,Өткен қараша айында Каори Тачибана сыныптан ертегі келе жатыр деп айқайлап жүгіріп шықты.
Dialogue: 0,0:23:38.34,0:23:40.67,JPsub,NTP,0000,0000,0000,,Мен осы ескі мектеп ғимаратына жүгірдім.
Dialogue: 0,0:23:41.25,0:23:45.94,JPsub,NTP,0000,0000,0000,,Және ол өз өмірін аяқтау үшін осы жерді өртеп жіберді.
Dialogue: 0,0:23:47.22,0:23:51.31,JPsub,NTP,0000,0000,0000,,Арбауыз ертегі оқушыларды осы оқиға туралы естеліктерінен айыруда.
Dialogue: 0,0:23:52.80,0:23:55.48,JPsub,NTP,0000,0000,0000,,Сиқыршының мақсаты қандай?
Dialogue: 0,0:24:07.91,0:24:09.43,JPsub,NTP,0000,0000,0000,,Қайырлы таң, Курогири мырза
Dialogue: 0,0:24:10.42,0:24:12.63,JPsub,NTP,0000,0000,0000,,Қайырлы таң, Хуанджи-сенпай.
Dialogue: 0,0:24:12.99,0:24:15.12,JPsub,NTP,0000,0000,0000,,Біз әдеттен тыс жерде кездесеміз.
Dialogue: 0,0:24:16.14,0:24:19.44,JPsub,NTP,0000,0000,0000,,Таң намазына бізбен қосылғыңыз келе ме?
Dialogue: 0,0:24:22.24,0:24:25.35,JPsub,NTP,0000,0000,0000,,Иә, қарсы болмасаңыз.
Dialogue: 0,0:24:33.71,0:24:35.17,JPsub,NTP,0000,0000,0000,,Рахмет, Курогири мырза
Dialogue: 0,0:24:36.68,0:24:40.42,JPsub,NTP,0000,0000,0000,,Осылай бірге дұға еткенімізге біраз болды.
Dialogue: 0,0:24:41.31,0:24:42.86,JPsub,NTP,0000,0000,0000,,Бұл оқиға болмағанда
Dialogue: 0,0:24:43.32,0:24:45.57,JPsub,NTP,0000,0000,0000,,Ол бала әлі сенің жаныңда болар еді.
Dialogue: 0,0:24:47.25,0:24:48.76,JPsub,NTP,0000,0000,0000,,Сіз Каори Тачибанасыз ба?
Dialogue: 0,0:24:49.21,0:24:54.60,JPsub,NTP,0000,0000,0000,,Иә, Каори мен үшін қарындасымдай болды.
Dialogue: 0,0:24:55.05,0:24:59.15,JPsub,NTP,0000,0000,0000,,Ол өз ісіне онша көнбейтін, үнемі жеңіліске ұшыраған рөлдерді ойнайтын бала еді.
Dialogue: 0,0:24:59.90,0:25:02.81,JPsub,NTP,0000,0000,0000,,Ол басқаларға қарағанда мейірімді, иманды бала еді.
Dialogue: 0,0:25:04.62,0:25:05.31,JPsub,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,0:25:16.11,0:25:19.55,JPsub,NTP,0000,0000,0000,,Мен оның ұятының барлық іздерін өшіргім келеді
Dialogue: 0,0:25:21.43,0:25:22.81,JPsub,NTP,0000,0000,0000,,Бұл сенсің, солай ма?
Dialogue: 0,0:25:24.56,0:25:25.74,JPsub,NTP,0000,0000,0000,,Каори үшін
Dialogue: 0,0:25:27.18,0:25:29.49,JPsub,NTP,0000,0000,0000,,Мен сиқырды үйрендім
Dialogue: 0,0:25:34.52,0:25:36.42,JPsub,NTP,0000,0000,0000,,Қолыңызды алыңыз, Курогири мырза.
Dialogue: 0,0:25:36.85,0:25:39.19,JPsub,NTP,0000,0000,0000,,Мен сенімен ұрысқым келмейді
Dialogue: 0,0:25:39.57,0:25:41.81,JPsub,NTP,0000,0000,0000,,Оны бірінші рет орнатқан менің ағам болса керек.
Dialogue: 0,0:25:43.53,0:25:46.00,JPsub,NTP,0000,0000,0000,,Иә, соның арқасында түсіндім.
Dialogue: 0,0:25:46.39,0:25:51.96,JPsub,NTP,0000,0000,0000,,Неге екені есіңізде болмаса да, ағаңызды шынымен жақсы көресіз.
Dialogue: 0,0:25:55.62,0:25:57.64,JPsub,NTP,0000,0000,0000,,Өте жақсы
Dialogue: 0,0:25:59.03,0:26:00.80,JPsub,NTP,0000,0000,0000,,Сен бәрін білесің бе?
Dialogue: 0,0:26:06.19,0:26:07.59,JPsub,NTP,0000,0000,0000,,Сонда мен мойындаймын.
Dialogue: 0,0:26:08.15,0:26:12.80,JPsub,NTP,0000,0000,0000,,Микияға ғашық болған шешуші сәт есімде жоқ.
Dialogue: 0,0:26:13.59,0:26:15.34,JPsub,NTP,0000,0000,0000,,Түсінген кезде маған ұнады
Dialogue: 0,0:26:17.75,0:26:21.59,JPsub,NTP,0000,0000,0000,,Егер сіз сол естеліктерді шығарып алсаңыз.
Dialogue: 0,0:26:21.92,0:26:23.48,JPsub,NTP,0000,0000,0000,,Мен оны сағындым деп айта аламын.
Dialogue: 0,0:26:28.04,0:26:29.25,JPsub,NTP,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:26:29.82,0:26:33.41,JPsub,NTP,0000,0000,0000,,Перілер тек естеліктерді алып кетеді.
Dialogue: 0,0:26:33.78,0:26:38.49,JPsub,NTP,0000,0000,0000,,Жоғалған естеліктерді немесе ұмытуды ешкім жинай алмайды.
Dialogue: 0,0:26:40.24,0:26:41.36,JPsub,NTP,0000,0000,0000,,Және Курогири мырза
Dialogue: 0,0:26:41.96,0:26:43.45,JPsub,NTP,0000,0000,0000,,Мен оны сағындым дедім.
Dialogue: 0,0:26:44.18,0:26:48.83,JPsub,NTP,0000,0000,0000,,Менің естеліктерді алып тастау арқылы іс аяқтағым келмейді.
Dialogue: 0,0:26:49.57,0:26:50.36,JPsub,NTP,0000,0000,0000,,Аға
Dialogue: 0,0:26:50.85,0:26:53.20,JPsub,NTP,0000,0000,0000,,Бұл адамдарды соттау керек.
Dialogue: 0,0:27:01.79,0:27:03.83,JPsub,NTP,0000,0000,0000,,Каори қуып қалады
Dialogue: 0,0:27:04.42,0:27:07.39,JPsub,NTP,0000,0000,0000,,Ешкім Каориге бұлай көмектесуге тырыспады.
Dialogue: 0,0:27:07.88,0:27:09.29,JPsub,NTP,0000,0000,0000,,Ештеңе істемеді
Dialogue: 0,0:27:09.82,0:27:11.56,JPsub,NTP,0000,0000,0000,,өзі күнә
Dialogue: 0,0:27:13.97,0:27:16.02,JPsub,NTP,0000,0000,0000,,Не болды, Сенпай?
Dialogue: 0,0:27:20.31,0:27:23.63,JPsub,NTP,0000,0000,0000,,Сен Каориді өз-өзіне қол жұмсауға апардың.
Dialogue: 0,0:27:23.89,0:27:27.76,JPsub,NTP,0000,0000,0000,,Тоқта, енді маған жақындама.
Dialogue: 0,0:27:36.49,0:27:37.54,JPsub,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:27:38.08,0:27:39.73,JPsub,NTP,0000,0000,0000,,Курогири мырза, сіз білесіз.
Dialogue: 0,0:27:40.99,0:27:44.73,JPsub,NTP,0000,0000,0000,,Танысты жасау үшін оған негіз болатын нәрсе керек.
Dialogue: 0,0:27:45.06,0:27:46.29,JPsub,NTP,0000,0000,0000,,Бұл оқыс оқиға болды.
Dialogue: 0,0:27:59.66,0:28:01.16,JPsub,NTP,0000,0000,0000,,Сонда Хаяма?
Dialogue: 0,0:28:07.73,0:28:09.71,JPsub,NTP,0000,0000,0000,,Жақсы ұйықтаңыз, Курогири мырза.
Dialogue: 0,0:28:10.28,0:28:14.89,JPsub,NTP,0000,0000,0000,,Бос ұйқыңда, Мен жоқтауыңды қайталаймын.
Dialogue: 0,0:28:18.58,0:28:25.05,JPsub,NTP,0000,0000,0000,,Курогири мырза Курогири мырза Сенка мырза Курогири мырза
Dialogue: 0,0:28:26.37,0:28:28.18,JPsub,NTP,0000,0000,0000,,, аға.
Dialogue: 0,0:28:28.53,0:28:29.19,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:28:29.60,0:28:32.58,JPsub,NTP,0000,0000,0000,,Генгири-сенсэй, кешіріңіз.
Dialogue: 0,0:28:33.13,0:28:35.07,JPsub,NTP,0000,0000,0000,,Менің түсім онша жақсы болмаса да,
Dialogue: 0,0:28:35.40,0:28:36.52,JPsub,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:28:38.21,0:28:39.10,JPsub,NTP,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:28:41.62,0:28:43.64,JPsub,NTP,0000,0000,0000,,Бұл есімде.
Dialogue: 0,0:28:43.90,0:28:44.99,JPsub,NTP,0000,0000,0000,,Бірақ неге?
Dialogue: 0,0:28:54.03,0:28:57.43,JPsub,NTP,0000,0000,0000,,Е, 4-сынып оқушылары кетті.
Dialogue: 0,0:28:57.76,0:28:59.74,JPsub,NTP,0000,0000,0000,,Бұл да жасырын масса ма?
Dialogue: 0,0:29:00.27,0:29:01.68,JPsub,NTP,0000,0000,0000,,Неліктен бұлай?
Dialogue: 0,0:29:02.96,0:29:03.79,JPsub,NTP,0000,0000,0000,,Мүмкін емес...
Dialogue: 0,0:29:05.15,0:29:09.61,JPsub,NTP,0000,0000,0000,,Гыңгири-сенсэй, Хуанджи-сенпайдың қайда екенін көрдің бе?
Dialogue: 0,0:29:10.33,0:29:13.89,JPsub,NTP,0000,0000,0000,,Жоқ, оны Курогири-саннан басқа ешкім көрмеген.
Dialogue: 0,0:29:15.61,0:29:18.90,JPsub,NTP,0000,0000,0000,,Егер сендіру сәтсіз болса, кенеттен күш қолдануға тура келеді.
Dialogue: 0,0:29:19.06,0:29:20.39,JPsub,NTP,0000,0000,0000,,Күш қолдану
Dialogue: 0,0:29:20.55,0:29:25.23,JPsub,NTP,0000,0000,0000,,Иә, Мисая Хуанджи Каори Тачибананың жадын өшірмекші.
Dialogue: 0,0:29:25.43,0:29:27.46,JPsub,NTP,0000,0000,0000,,Бірінші курстың 4-сыныптағы әрбір оқушыға.
Dialogue: 0,0:29:30.46,0:29:32.43,JPsub,NTP,0000,0000,0000,,Өрнек Бөлек іздейік
Dialogue: 0,0:29:32.72,0:29:35.03,JPsub,NTP,0000,0000,0000,,Мектепті тағы бір рет зерттеңіз.
Dialogue: 0,0:29:35.36,0:29:38.18,JPsub,NTP,0000,0000,0000,,Мен орманды іздеймін, ойым бар ма?
Dialogue: 0,0:29:38.77,0:29:42.40,JPsub,NTP,0000,0000,0000,,Эй, ол жақта ештеңе жоқ.
Dialogue: 0,0:00:00.00,0:00:00.00,JPsub,NTP,0000,0000,0000,,-------------------------------------------------
Dialogue: 0,0:30:02.72,0:30:05.17,JPsub,NTP,0000,0000,0000,,Жоқ Сақ болыңыз
Dialogue: 0,0:30:05.44,0:30:07.29,JPsub,NTP,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:30:41.28,0:30:42.27,JPsub,NTP,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:31:18.34,0:31:20.33,JPsub,NTP,0000,0000,0000,,Қайда жоғалып кетті?
Dialogue: 0,0:31:21.73,0:31:24.92,JPsub,NTP,0000,0000,0000,,Ол міндетті түрде осы мектепте болуы керек.
Dialogue: 0,0:31:26.73,0:31:28.37,JPsub,NTP,0000,0000,0000,,Және сол сынып
Dialogue: 0,0:31:39.48,0:31:40.51,JPsub,NTP,0000,0000,0000,,Микия
Dialogue: 0,0:31:42.58,0:31:43.91,JPsub,NTP,0000,0000,0000,,Егер бұл Микия болса
Dialogue: 0,0:31:44.77,0:31:46.39,JPsub,NTP,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:31:47.42,0:31:49.07,JPsub,NTP,0000,0000,0000,,Егер бұл Микия болса
Dialogue: 0,0:32:10.61,0:32:12.30,JPsub,NTP,0000,0000,0000,,Неге жыламайсың?
Dialogue: 0,0:32:13.68,0:32:15.13,JPsub,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:32:21.24,0:32:23.77,JPsub,NTP,0000,0000,0000,,Әй, сен неге жыламадың?
Dialogue: 0,0:32:40.76,0:32:44.66,JPsub,NTP,0000,0000,0000,,Сіз шаршаған кезде не істейсіз?
Dialogue: 0,0:32:44.73,0:32:46.43,JPsub,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:32:49.75,0:32:52.40,JPsub,NTP,0000,0000,0000,,табылған нәрсені білдіру
Dialogue: 0,0:32:53.52,0:32:55.60,JPsub,NTP,0000,0000,0000,,Жоқ, одан гөрі жаңа гүлдер.
Dialogue: 0,0:32:55.79,0:32:56.50,JPsub,NTP,0000,0000,0000,,Бұл оңай-ақ өзгертіле қоймайды.
Dialogue: 0,0:32:58.48,0:33:00.34,JPsub,NTP,0000,0000,0000,,Бұл сіздің ағаңыздан.
Dialogue: 0,0:33:06.06,0:33:08.24,JPsub,NTP,0000,0000,0000,,Хидео Хаяма туралы мәлімет
Dialogue: 0,0:33:09.20,0:33:10.81,JPsub,NTP,0000,0000,0000,,Өтініш рәсімнен басталады.
Dialogue: 0,0:33:11.40,0:33:13.81,JPsub,NTP,0000,0000,0000,,Егер мен баяндама жасайтын болсам, Сенька дұрыс адам болар еді.
Dialogue: 0,0:33:14.65,0:33:18.38,JPsub,NTP,0000,0000,0000,,Аа, Шики сенен мұны сұрады ма?
Dialogue: 0,0:33:18.65,0:33:22.22,JPsub,NTP,0000,0000,0000,,Рәсімде Сенька Хаямаға алаңдайтыны айтылды.
Dialogue: 0,0:33:22.68,0:33:25.66,JPsub,NTP,0000,0000,0000,,Иә, бірақ мен неге білгім келетінін айтпадым.
Dialogue: 0,0:33:25.79,0:33:30.38,JPsub,NTP,0000,0000,0000,,Мен ағамның бұл қауіпті оқиғаға араласқанын қаламаймын.
Dialogue: 0,0:33:30.52,0:33:34.76,JPsub,NTP,0000,0000,0000,,Ағаңыздың қауіпсіздігіне алаңдап, рәсімді өткізбегеніңізге сенімдімін.
Dialogue: 0,0:33:36.60,0:33:37.70,JPsub,NTP,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:33:38.32,0:33:41.68,JPsub,NTP,0000,0000,0000,,Рәсім туралы алаңдаушылық қазір Сенькаға бағытталған.
Dialogue: 0,0:33:47.22,0:33:49.37,JPsub,NTP,0000,0000,0000,,Сонымен не болды?
Dialogue: 0,0:33:49.60,0:33:52.91,JPsub,NTP,0000,0000,0000,,Иә, алдымен салтанатты сұрау туралы сөйлесейік.
Dialogue: 0,0:33:53.30,0:33:55.15,JPsub,NTP,0000,0000,0000,,Сондай-ақ, Туко-санның хабарламасы.
Dialogue: 0,0:33:56.67,0:33:57.90,JPsub,NTP,0000,0000,0000,,Тооко-саннан
Dialogue: 0,0:34:09.70,0:34:11.90,JPsub,NTP,0000,0000,0000,,Маған айтқандай келді.
Dialogue: 0,0:34:12.21,0:34:14.05,JPsub,NTP,0000,0000,0000,,Иә, еңбектеріңіз үшін рахмет.
Dialogue: 0,0:34:15.16,0:34:17.27,JPsub,NTP,0000,0000,0000,,Сіз оларға көмектеспейтініңізге сенімдісіз бе?
Dialogue: 0,0:34:17.80,0:34:21.76,JPsub,NTP,0000,0000,0000,,Сатсуки Генгири – Годовард деп аталатын қауіпті сиқыршы.
Dialogue: 0,0:34:22.55,0:34:24.57,JPsub,NTP,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,0:34:25.32,0:34:28.10,JPsub,NTP,0000,0000,0000,,Ол адамдардың қабылдауын сөзбен басқарады, бірақ
Dialogue: 0,0:34:28.33,0:34:30.69,JPsub,NTP,0000,0000,0000,,Менде басқа шабуыл құралы жоқ.
Dialogue: 0,0:34:31.44,0:34:33.03,JPsub,NTP,0000,0000,0000,,Біз сізге қарсы шаралар туралы да айтып береміз.
Dialogue: 0,0:34:33.29,0:34:36.22,JPsub,NTP,0000,0000,0000,,Менің шәкіртім болсаң, мен бірдеңе істеймін.
Dialogue: 0,0:34:37.28,0:34:39.45,JPsub,NTP,0000,0000,0000,,Енді, одан гөрі, ас, ас.
Dialogue: 0,0:35:00.11,0:35:01.04,JPsub,NTP,0000,0000,0000,,Курогири мырза
Dialogue: 0,0:35:01.66,0:35:04.07,JPsub,NTP,0000,0000,0000,,Қайырлы кеш, Генгири мырза
Dialogue: 0,0:35:06.02,0:35:07.34,JPsub,NTP,0000,0000,0000,,Онда ештеңе жоқ
Dialogue: 0,0:35:07.40,0:35:09.09,JPsub,NTP,0000,0000,0000,,Мен асығыспын, кешіріңізші.
Dialogue: 0,0:36:13.52,0:36:15.86,JPsub,NTP,0000,0000,0000,,Дәл сол өзін-өзі өртеп жіберсе де
Dialogue: 0,0:36:15.99,0:36:19.16,JPsub,NTP,0000,0000,0000,,Сенпай, бұл сыныптағылардың бәрі тым көп істеп жатқан жоқ па?
Dialogue: 0,0:36:20.75,0:36:23.72,JPsub,NTP,0000,0000,0000,,Бұл лайықты марапат емес, Курогири мырза.
Dialogue: 0,0:36:24.28,0:36:26.42,JPsub,NTP,0000,0000,0000,,Мұның бәрі бүгін түнде аяқталады.
Dialogue: 0,0:36:29.79,0:36:32.83,JPsub,NTP,0000,0000,0000,,Нағыз ұйымдастырушының араласуы жоқ.
Dialogue: 0,0:36:37.68,0:36:40.97,JPsub,NTP,0000,0000,0000,,Сіз заттарды өте айналмалы түрде жасайсыз.
Dialogue: 0,0:36:41.53,0:36:42.45,JPsub,NTP,0000,0000,0000,,Мақсаты не?
Dialogue: 0,0:36:42.71,0:36:46.89,JPsub,NTP,0000,0000,0000,,Енді мен біреудің тілегін орындадым.
Dialogue: 0,0:36:47.53,0:36:51.10,JPsub,NTP,0000,0000,0000,,Бұл оқиға тек олардың тілектеріне негізделген.
Dialogue: 0,0:36:51.76,0:36:54.30,JPsub,NTP,0000,0000,0000,,Менің жеке мақсатым жоқ.
Dialogue: 0,0:36:55.25,0:36:56.64,JPsub,NTP,0000,0000,0000,,Бұл да байланыс.
Dialogue: 0,0:36:57.23,0:36:59.17,JPsub,NTP,0000,0000,0000,,Мен бұл елге келдім
Dialogue: 0,0:36:59.30,0:37:01.55,JPsub,NTP,0000,0000,0000,,Себебі Арая Сорен мені сұрады.
Dialogue: 0,0:37:02.14,0:37:06.23,JPsub,NTP,0000,0000,0000,,Маған екі жыл бұрынғы ұмытып кеткен естеліктеріңізді қайтаруыңызды қалаймын.
Dialogue: 0,0:37:06.99,0:37:10.86,JPsub,NTP,0000,0000,0000,,Жоқ, сіз де жоғалған естеліктеріңізді іздеп жүрсіз.
Dialogue: 0,0:37:11.68,0:37:15.41,JPsub,NTP,0000,0000,0000,,Сөзде жасырылған жүрегіңді көремін.
Dialogue: 0,0:37:16.79,0:37:19.14,JPsub,NTP,0000,0000,0000,,Менің рөлім осы
Dialogue: 0,0:37:20.36,0:37:21.77,JPsub,NTP,0000,0000,0000,,Хуандзи-кун туралы
Dialogue: 0,0:37:22.49,0:37:27.91,JPsub,NTP,0000,0000,0000,,Егер мен адам болсам, бұл уақытты өлтірудің бір жолы дер едім.
Dialogue: 0,0:37:28.96,0:37:31.23,JPsub,NTP,0000,0000,0000,,Көңіл көтеру өмір сүруге жақсы
Dialogue: 0,0:37:31.85,0:37:35.66,JPsub,NTP,0000,0000,0000,,Жай өмір сүру машина сияқты.
Dialogue: 0,0:37:36.04,0:37:38.02,JPsub,NTP,0000,0000,0000,,Сіз де сиқыршысыз ба?
Dialogue: 0,0:37:39.33,0:37:42.73,JPsub,NTP,0000,0000,0000,,Иә, мен сөзді басқара алатын сиқыршымын.
Dialogue: 0,0:37:43.22,0:37:45.42,JPsub,NTP,0000,0000,0000,,Ол Годовард деп аталады.
Dialogue: 0,0:37:48.60,0:37:50.60,JPsub,NTP,0000,0000,0000,,Отпен ойнауды доғарайық
Dialogue: 0,0:37:52.41,0:37:53.52,JPsub,NTP,0000,0000,0000,,Хуандзи Сенпай
Dialogue: 0,0:37:55.03,0:37:57.67,JPsub,NTP,0000,0000,0000,,Күрогири мырза, қалжыңдауды доғарыңыз.
Dialogue: 0,0:37:58.46,0:38:00.56,JPsub,NTP,0000,0000,0000,,Енді бұл әзіл
Dialogue: 0,0:38:02.18,0:38:04.81,JPsub,NTP,0000,0000,0000,,Адамдар қазірдің өзінде өлді.
Dialogue: 0,0:38:05.60,0:38:07.75,JPsub,NTP,0000,0000,0000,,Иә, Хаяма қайтыс болды.
Dialogue: 0,0:38:08.47,0:38:11.11,JPsub,NTP,0000,0000,0000,,Бірақ оны өлтірген сен емессің.
Dialogue: 0,0:38:11.57,0:38:16.15,JPsub,NTP,0000,0000,0000,,Хаяманы өлтірген Хаяманың өзі.
Dialogue: 0,0:38:19.15,0:38:22.10,JPsub,NTP,0000,0000,0000,,Мұны маған үйреткен пері еді.
Dialogue: 0,0:38:22.65,0:38:25.43,JPsub,NTP,0000,0000,0000,,Сіз Каори үшін сиқырды үйрендіңіз.
Dialogue: 0,0:38:25.86,0:38:28.27,JPsub,NTP,0000,0000,0000,,Хаяманы ертегі материалы ретінде пайдалану керек еді
Dialogue: 0,0:38:28.72,0:38:33.36,JPsub,NTP,0000,0000,0000,,Бірақ неліктен оларда болуы мүмкін емес перілердің галлюцинациялары болды?
Dialogue: 0,0:38:33.72,0:38:34.65,JPsub,NTP,0000,0000,0000,,Галлюцинация
Dialogue: 0,0:38:35.12,0:38:37.94,JPsub,NTP,0000,0000,0000,,Ол кенеттен арықтап, тұрақсыз болып қалды.
Dialogue: 0,0:38:38.04,0:38:39.01,JPsub,NTP,0000,0000,0000,,Галлюцинацияны көру
Dialogue: 0,0:38:40.14,0:38:45.45,JPsub,NTP,0000,0000,0000,,Сондықтан ол нашақорлықтың бас тарту белгілеріне өте жақсы сәйкес келеді.
Dialogue: 0,0:38:45.90,0:38:50.33,JPsub,NTP,0000,0000,0000,,Есірткіге тәуелді болғаны үшін өзін кешіре алмай, Каори өз-өзіне қол жұмсауға әрекеттенеді.
Dialogue: 0,0:38:50.66,0:38:53.66,JPsub,NTP,0000,0000,0000,,Хаяма ағамен пікірталастың ортасында болды.
Dialogue: 0,0:38:53.76,0:38:56.24,JPsub,NTP,0000,0000,0000,,Улану салдарынан инфаркт болған
Dialogue: 0,0:38:56.67,0:38:59.93,JPsub,NTP,0000,0000,0000,,Басқаша айтқанда, Хидео Хаяманың өз бетімен өлетінін қоспағанда.
Dialogue: 0,0:39:00.03,0:39:03.01,JPsub,NTP,0000,0000,0000,,Ешкім өлмеді, ешкім өлмеді.
Dialogue: 0,0:39:04.10,0:39:09.30,JPsub,NTP,0000,0000,0000,,Тек азап шеккен Каори Тачибананы құтқара алмағандар болды.
Dialogue: 0,0:39:10.21,0:39:13.75,JPsub,NTP,0000,0000,0000,,Қолайсыздықтан бірінші болып бет бұрған адам болды
Dialogue: 0,0:39:17.35,0:39:22.26,JPsub,NTP,0000,0000,0000,,Сондықтан мені бәрінен бұрын тонап кетті, сондықтан ол бөлігін ұмытып қалдым.
Dialogue: 0,0:39:22.46,0:39:25.10,JPsub,NTP,0000,0000,0000,,Оны өзіңіз де байқаған боларсыз.
Dialogue: 0,0:39:25.66,0:39:27.10,JPsub,NTP,0000,0000,0000,,Сіздің кек алуыңыз
Dialogue: 0,0:39:29.67,0:39:33.49,JPsub,NTP,0000,0000,0000,,Бұл сіз қалаған ыңғайлы қиял.
Dialogue: 0,0:39:44.71,0:39:47.58,JPsub,NTP,0000,0000,0000,,Ең жақсысы, ең жақсысы
Dialogue: 0,0:39:48.10,0:39:49.19,JPsub,NTP,0000,0000,0000,,Курогири мырза
Dialogue: 0,0:40:11.56,0:40:12.45,JPsub,NTP,0000,0000,0000,,Азолто
Dialogue: 0,0:40:25.34,0:40:27.65,JPsub,NTP,0000,0000,0000,,Қиял сенікі, Куротоу-сан.
Dialogue: 0,0:40:28.43,0:40:32.19,JPsub,NTP,0000,0000,0000,,4-сынып оқушыларынан білу үшін ертегіні пайдаландым.
Dialogue: 0,0:40:32.72,0:40:34.83,JPsub,NTP,0000,0000,0000,,Бұл даусыз факт
Dialogue: 0,0:40:37.54,0:40:38.60,JPsub,NTP,0000,0000,0000,,Солай ма?
Dialogue: 0,0:40:39.60,0:40:44.22,JPsub,NTP,0000,0000,0000,,Бірақ мен оны Каори мен Хаяманың аузынан ести алмадым.
Dialogue: 0,0:40:46.42,0:40:52.05,JPsub,NTP,0000,0000,0000,,Сіз үшін шындық оқиғадан кейін туған студенттердің өсек-аяңынан басқа ештеңе емес.
Dialogue: 0,0:40:53.04,0:40:54.93,JPsub,NTP,0000,0000,0000,,Сіз барлық іздестірушілерсіз
Dialogue: 0,0:40:55.49,0:40:58.45,JPsub,NTP,0000,0000,0000,,Кек пен сиқыр мотиві
Dialogue: 0,0:41:00.72,0:41:04.79,JPsub,NTP,0000,0000,0000,,Ал саған билік берген
Dialogue: 0,0:41:21.62,0:41:23.76,JPsub,NTP,0000,0000,0000,,[Одан тыс] «көруді жоғалту»
Dialogue: 0,0:41:26.74,0:41:27.43,JPsub,NTP,0000,0000,0000,,Матака?
Dialogue: 0,0:41:31.00,0:41:34.82,JPsub,NTP,0000,0000,0000,,Бұл қорқынышты. Бір-бірін өлтіру туралы айтудың қажеті жоқ.
Dialogue: 0,0:41:35.71,0:41:38.52,JPsub,NTP,0000,0000,0000,,Бірақ менің тілегім маған қайтады
Dialogue: 0,0:41:39.18,0:41:42.01,JPsub,NTP,0000,0000,0000,,Еске түскен сәт, ұғынған сәт
Dialogue: 0,0:41:42.07,0:41:43.74,JPsub,NTP,0000,0000,0000,,Үй иесін жейтін ұмытуың да солай.
Dialogue: 0,0:41:44.53,0:41:46.71,JPsub,NTP,0000,0000,0000,,Сіздің ұмытуыңыз үшін көп нәрсе.
Dialogue: 0,0:41:50.00,0:41:51.91,JPsub,NTP,0000,0000,0000,,[Міне,' 'мұнда', 'Мен көрмеймін.'
Dialogue: 0,0:41:59.29,0:42:01.46,JPsub,NTP,0000,0000,0000,,Жоқтауды ойнау
Dialogue: 0,0:42:02.01,0:42:07.79,JPsub,NTP,0000,0000,0000,,Ол дыбысты ұмытып қалсаңыз да, сіздің жадыңыз сізде жазылғаны сөзсіз.
Dialogue: 0,0:42:20.96,0:42:22.12,JPsub,NTP,0000,0000,0000,,Сіз не туралы ақымақсыз?
Dialogue: 0,0:42:35.71,0:42:36.48,JPsub,NTP,0000,0000,0000,,Аға
Dialogue: 0,0:42:49.58,0:42:50.71,JPsub,NTP,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:42:53.29,0:42:54.21,JPsub,NTP,0000,0000,0000,,Кедергі
Dialogue: 0,0:43:20.16,0:43:28.13,JPsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:43:41.12,0:43:42.74,JPsub,NTP,0000,0000,0000,,Ұсталу аяқталды.
Dialogue: 0,0:44:12.79,0:44:13.57,JPsub,NTP,0000,0000,0000,,Жаңа гүлдер
Dialogue: 0,0:44:14.91,0:44:15.84,JPsub,NTP,0000,0000,0000,,баяу
Dialogue: 0,0:44:16.26,0:44:17.58,JPsub,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:44:21.06,0:44:22.32,JPsub,NTP,0000,0000,0000,,Бітті ме?
Dialogue: 0,0:44:25.33,0:44:26.45,JPsub,NTP,0000,0000,0000,,Өте жақсы
Dialogue: 0,0:44:42.56,0:44:43.35,JPsub,NTP,0000,0000,0000,,Ерте
Dialogue: 0,0:44:44.66,0:44:46.64,JPsub,NTP,0000,0000,0000,,Менің жағдайым жақсы, Акира.
Dialogue: 0,0:44:52.38,0:44:52.84,JPsub,NTP,0000,0000,0000,,Келіңіздер
Dialogue: 0,0:44:57.24,0:44:59.69,JPsub,NTP,0000,0000,0000,,Еңбегіңіз үшін рахмет, Сенка-чан
Dialogue: 0,0:45:09.64,0:45:12.68,JPsub,NTP,0000,0000,0000,,Иә, іс сәтті шешілген сияқты.
Dialogue: 0,0:45:13.89,0:45:18.25,JPsub,NTP,0000,0000,0000,,Одан да мен формуланы таба алмаймын.
Dialogue: 0,0:45:22.28,0:45:25.26,JPsub,NTP,0000,0000,0000,,Ол да жомарт, солай емес пе?
Dialogue: 0,0:45:25.62,0:45:28.34,JPsub,NTP,0000,0000,0000,,Сіз бұл жолы көп жұмыс істедіңіз, сондықтан бұл сіздің сыйлығыңыз.
Dialogue: 0,0:45:28.42,0:45:29.34,JPsub,NTP,0000,0000,0000,,Тооко-сан
Dialogue: 0,0:45:31.20,0:45:33.51,JPsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:45:34.29,0:45:38.18,JPsub,NTP,0000,0000,0000,,Мөр деп белгіленген сиқыршы бұл жолы бекер болған сияқты.
Dialogue: 0,0:45:38.58,0:45:39.43,JPsub,NTP,0000,0000,0000,,Тооко-сан
Dialogue: 0,0:45:39.92,0:45:42.27,JPsub,NTP,0000,0000,0000,,Сенькаға оның жақсы жұмыс істегенін айт.
Dialogue: 0,0:45:42.64,0:45:44.95,JPsub,NTP,0000,0000,0000,,А, иә, мен сізге міндетті түрде айтамын.
Dialogue: 0,0:45:58.91,0:46:00.11,JPsub,NTP,0000,0000,0000,,Бауырым, формуласы
Dialogue: 0,0:46:00.68,0:46:02.50,JPsub,NTP,0000,0000,0000,,Менің ойымша, сіз бірінші үйге бардыңыз.
Dialogue: 0,0:46:03.38,0:46:04.56,JPsub,NTP,0000,0000,0000,,Сізге не керек еді?
Dialogue: 0,0:46:06.00,0:46:06.78,JPsub,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:46:09.71,0:46:11.18,JPsub,NTP,0000,0000,0000,,Мен одан да көп естідім.
Dialogue: 0,0:46:11.31,0:46:13.62,JPsub,NTP,0000,0000,0000,,Тачибана-сан есін жиды.
Dialogue: 0,0:46:15.33,0:46:17.54,JPsub,NTP,0000,0000,0000,,Иә, айғақтар бойынша
Dialogue: 0,0:46:17.87,0:46:20.28,JPsub,NTP,0000,0000,0000,,Қазан Хаяманың талмасынан құлаған кезде
Dialogue: 0,0:46:20.71,0:46:22.95,JPsub,NTP,0000,0000,0000,,Өкінішке орай, ол сонда болды.
Dialogue: 0,0:46:23.81,0:46:28.73,JPsub,NTP,0000,0000,0000,,Ал оны үнсіз қалдыру үшін Хаямаға есірткі берген.
Dialogue: 0,0:46:30.44,0:46:32.03,JPsub,NTP,0000,0000,0000,,Ол да құрбан болды.
Dialogue: 0,0:46:33.14,0:46:34.57,JPsub,NTP,0000,0000,0000,,Бұл қайғылы естелік.
Dialogue: 0,0:46:35.85,0:46:37.40,JPsub,NTP,0000,0000,0000,,Ұмытып кетсем ғой
Dialogue: 0,0:46:59.83,0:47:01.18,JPsub,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:47:02.11,0:47:03.47,JPsub,NTP,0000,0000,0000,,Жаңа гүлдер мен автобустар
Dialogue: 0,0:47:04.65,0:47:06.42,JPsub,NTP,0000,0000,0000,,Барлығы дүрбелеңде.
Dialogue: 0,0:47:10.39,0:47:13.28,JPsub,NTP,0000,0000,0000,,Бауырым, қарным ашты.
Dialogue: 0,0:47:13.73,0:47:17.27,JPsub,NTP,0000,0000,0000,,Бұл жерде тамақтанатын орын бар ма?
Dialogue: 0,0:47:18.03,0:47:20.41,JPsub,NTP,0000,0000,0000,,Төбенің түбінде дәмхана бар.
Dialogue: 0,0:47:20.73,0:47:21.59,JPsub,NTP,0000,0000,0000,,Ол алыс
Dialogue: 0,0:47:22.18,0:47:25.55,JPsub,NTP,0000,0000,0000,,Бұл мені тастап, бір күні менімен бірге жүргенің үшін жазасың.
Dialogue: 0,0:47:26.73,0:47:28.70,JPsub,NTP,0000,0000,0000,,Сіз мұны айтқанда
Dialogue: 0,0:47:28.97,0:47:31.09,JPsub,NTP,0000,0000,0000,,Олай болса шағымданба.
Dialogue: 0,0:48:03.93,0:48:05.97,JPsub,NTP,0000,0000,0000,,Мен балалық шағымды армандадым.
Dialogue: 0,0:48:07.81,0:48:12.50,JPsub,NTP,0000,0000,0000,,Ағам екеуміз білетін маңызды адам дүниеден өтті.
Dialogue: 0,0:48:14.61,0:48:16.53,JPsub,NTP,0000,0000,0000,,Ол өте қайғылы көрінді.
Dialogue: 0,0:48:17.81,0:48:21.24,JPsub,NTP,0000,0000,0000,,Ол ешқашан көз жасын төкпеген
Dialogue: 0,0:48:26.71,0:48:28.20,JPsub,NTP,0000,0000,0000,,Неге жыламайсың?
Dialogue: 0,0:48:29.07,0:48:31.17,JPsub,NTP,0000,0000,0000,,Иә, неге деп ойлаймын.
Dialogue: 0,0:48:32.09,0:48:34.42,JPsub,NTP,0000,0000,0000,,Ұлдар жыламауы керек
Dialogue: 0,0:48:36.66,0:48:38.88,JPsub,NTP,0000,0000,0000,,Әй, сен неге жыламадың?
Dialogue: 0,0:48:39.50,0:48:41.38,JPsub,NTP,0000,0000,0000,,Жылағым келсе де жыламаймын.
Dialogue: 0,0:48:42.20,0:48:44.68,JPsub,NTP,0000,0000,0000,,Өйткені бұл ерекше нәрсе.
Dialogue: 0,0:48:47.38,0:48:49.86,JPsub,NTP,0000,0000,0000,,Сол күш маған қатты әсер етті.
Dialogue: 0,0:48:51.58,0:48:55.47,JPsub,NTP,0000,0000,0000,,Бұл қаншалықты қалыпты және адамдарға басқалардан артық зиян тигізбейді?
Dialogue: 0,0:48:55.73,0:48:57.52,JPsub,NTP,0000,0000,0000,,Бір-бірімізді кез келген адаммен түсінсек те
Dialogue: 0,0:48:57.67,0:48:59.51,JPsub,NTP,0000,0000,0000,,Ешкім байқамайды
Dialogue: 0,0:48:59.83,0:49:01.27,JPsub,NTP,0000,0000,0000,,Бос жалғыздық
Dialogue: 0,0:49:04.70,0:49:10.06,JPsub,NTP,0000,0000,0000,,Осы кезде Микия Курогири мен үшін маңызды адамға айналды.
Dialogue: 0,0:49:11.14,0:49:14.75,JPsub,NTP,0000,0000,0000,,Менің ойымша, бұл мен ешқашан жоғалтпауым керек нәрсеге айналды.
Dialogue: 0,0:49:23.09,0:49:26.95,JPsub,NTP,0000,0000,0000,,Жұлдызды аспан астында аға мен апа жұлдыздарға қарады.
Dialogue: 0,0:49:28.06,0:49:31.17,JPsub,NTP,0000,0000,0000,,Бұл мен үшін ерекше көрініс
Dialogue: 0,0:49:32.65,0:49:37.60,JPsub,NTP,0000,0000,0000,,Мәңгі есімде қалмайтын алыс күннің арманы еді.
Dialogue: 0,0:55:15.97,0:55:17.51,JPsub,NTP,0000,0000,0000,,Мен әлсіз адамдарды жек көремін
Dialogue: 0,0:55:51.15,0:55:53.76,JPsub,NTP,0000,0000,0000,,Мәйітті жасыру әдісі ретінде
Dialogue: 0,0:55:54.02,0:55:56.19,JPsub,NTP,0000,0000,0000,,Сіз тамақтануды таңдадыңыз ба?
Dialogue: 0,0:55:57.87,0:56:00.03,JPsub,NTP,0000,0000,0000,,Неге соңына дейін ішпейсің?
Dialogue: 0,0:56:00.39,0:56:03.53,JPsub,NTP,0000,0000,0000,,Адамгершілік сізге байланысты ма?
Dialogue: 0,0:56:08.38,0:56:11.30,JPsub,NTP,0000,0000,0000,,Олай болса, неге айттыңыз?
Dialogue: 0,0:56:13.14,0:56:17.07,JPsub,NTP,0000,0000,0000,,Мен мұны табиғи нәрсе деп ойладым.
Dialogue: 0,0:56:17.53,0:56:18.52,JPsub,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:56:18.97,0:56:21.91,JPsub,NTP,0000,0000,0000,,Бұл сіздің ерекше екеніңізді білдіреді.
Dialogue: 0,0:56:23.92,0:56:25.77,JPsub,NTP,0000,0000,0000,,Мен ерекшемін
Dialogue: 0,0:56:26.30,0:56:27.09,JPsub,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:56:27.81,0:56:31.06,JPsub,NTP,0000,0000,0000,,Сіз ақылға қонымды емессіз
Dialogue: 0,0:56:32.15,0:56:34.51,JPsub,NTP,0000,0000,0000,,Бұл мен сынамын дегенді білдіре ме?
Dialogue: 0,0:56:35.47,0:56:38.87,JPsub,NTP,0000,0000,0000,,Содан кейін оны толығымен жою керек.
Dialogue: 0,0:57:10.22,0:57:13.26,JPsub,NTP,0000,0000,0000,,Бір сағат? Өте жақсы.
Dialogue: 0,0:57:13.99,0:57:16.27,JPsub,NTP,0000,0000,0000,,Бірақ бұл да шектеу.
Dialogue: 0,0:57:16.70,0:57:20.70,JPsub,NTP,0000,0000,0000,,Өзінің шыққан тегін білу жеткілікті.
Dialogue: 0,0:57:21.30,0:57:25.20,JPsub,NTP,0000,0000,0000,,Түпнұсқалар оянбайынша қалыптаспайды.
Dialogue: 0,0:57:26.09,0:57:30.22,JPsub,NTP,0000,0000,0000,,Еш нәрсеге бағынбайтын трансцендент ретіндегі қабілет
Dialogue: 0,0:57:30.68,0:57:33.94,JPsub,NTP,0000,0000,0000,,Мамандық ерекше өмір ретінде
Dialogue: 0,0:57:34.90,0:57:36.22,JPsub,NTP,0000,0000,0000,,Қаламайсың ба?
Dialogue: 0,0:57:40.52,0:57:41.94,JPsub,NTP,0000,0000,0000,,Келісілді
Dialogue: 0,0:57:42.38,0:57:43.80,JPsub,NTP,0000,0000,0000,,Сіз біріншісіз
Dialogue: 0,0:57:47.16,0:57:48.55,JPsub,NTP,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:57:51.49,0:57:55.61,JPsub,NTP,0000,0000,0000,,Сиқыршы Сорен Арая
Dialogue: 0,0:57:56.85,0:57:58.01,JPsub,NTP,0000,0000,0000,,Сіздің атыңыз
Dialogue: 0,0:58:03.45,0:58:04.68,JPsub,NTP,0000,0000,0000,,Дәмді
Dialogue: 0,0:58:05.13,0:58:09.49,JPsub,NTP,0000,0000,0000,,Бір әріпті ауыстырсаң, арыстан болар едің.
Dialogue: 0,0:58:19.29,0:58:22.33,JPsub,NTP,0000,0000,0000,,Сіз осында және күліп тұрғаныңыз үшін
Dialogue: 0,0:58:22.85,0:58:24.01,JPsub,NTP,0000,0000,0000,,Мен бақытты болдым
Dialogue: 0,0:58:25.52,0:58:26.76,JPsub,NTP,0000,0000,0000,,Өзіңізді қауіпсіз сезініңіз
Dialogue: 0,0:58:27.36,0:58:28.35,JPsub,NTP,0000,0000,0000,,Мен уайымдасам да, сен осындасың
Dialogue: 0,0:58:30.58,0:58:33.28,JPsub,NTP,0000,0000,0000,,Сізбен бірге серуендеу
Dialogue: 0,0:58:33.74,0:58:34.80,JPsub,NTP,0000,0000,0000,,Мен бақытты болдым
Dialogue: 0,0:58:36.25,0:58:37.34,JPsub,NTP,0000,0000,0000,,Менімен бірге бол
Dialogue: 0,0:58:38.10,0:58:39.56,JPsub,NTP,0000,0000,0000,,Біз бірге болмасақ та
Dialogue: 0,0:58:40.71,0:58:41.97,JPsub,NTP,0000,0000,0000,,Бұл шынымен де
Dialogue: 0,0:58:42.63,0:58:43.77,JPsub,NTP,0000,0000,0000,,арманшыл
Dialogue: 0,0:58:44.20,0:58:45.41,JPsub,NTP,0000,0000,0000,,Күндердің қалдықтары
Dialogue: 0,0:02:31.66,0:02:33.86,CNsub,NTP,0000,0000,0000,,Арман орындалған кезде
Dialogue: 0,0:02:36.70,0:02:38.22,CNsub,NTP,0000,0000,0000,,Тікелей немқұрайлылық
Dialogue: 0,0:02:40.88,0:02:42.97,CNsub,NTP,0000,0000,0000,,Бірден еске түсіру
Dialogue: 0,0:02:46.36,0:02:49.97,CNsub,NTP,0000,0000,0000,,Өмірден өтуді армандау
Dialogue: 0,0:04:15.59,0:04:19.68,CNsub,NTP,0000,0000,0000,,Мен қара тунг гүлмін, мен 16 жаста сиқыршымын.
Dialogue: 0,0:04:20.58,0:04:22.56,CNsub,NTP,0000,0000,0000,,Юкари Какия
Dialogue: 0,0:04:22.97,0:04:24.98,CNsub,NTP,0000,0000,0000,,Тоуко Айзаки
Dialogue: 0,0:04:25.42,0:04:28.10,CNsub,NTP,0000,0000,0000,,Жалпы өндірістік ақпарат
Dialogue: 0,0:04:33.25,0:04:35.14,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:04:36.57,0:04:38.94,CNsub,NTP,0000,0000,0000,,Жиналыс пен талап түсіндірменің себебі неде?
Dialogue: 0,0:04:39.35,0:04:43.60,CNsub,NTP,0000,0000,0000,,Бұл менің махаббатымның суреті мен махаббатымның хикаясы.
Dialogue: 0,0:04:44.21,0:04:50.03,CNsub,NTP,0000,0000,0000,,Мен шынайы жерді білемін, өз қаламмен байланысымды сезінемін, мен негізсіз жерді жақсы көремін.
Dialogue: 0,0:04:51.71,0:04:53.33,CNsub,NTP,0000,0000,0000,,Чен ағайдың қызы
Dialogue: 0,0:04:54.85,0:04:57.38,CNsub,NTP,0000,0000,0000,,Интернат болу – ресми мектеп.
Dialogue: 0,0:04:58.22,0:05:04.54,CNsub,NTP,0000,0000,0000,,Менің әпкемнің әпкесінің аты да менің әпкемдікі.
Dialogue: 0,0:05:05.51,0:05:09.23,CNsub,NTP,0000,0000,0000,,Алайда алдымда бір от бар.
Dialogue: 0,0:05:11.38,0:05:14.98,CNsub,NTP,0000,0000,0000,,Бұл менің алдымда дұрыс іс.
Dialogue: 0,0:05:15.66,0:05:21.95,CNsub,NTP,0000,0000,0000,,Гоге Мен тағы келдім
Dialogue: 0,0:05:25.53,0:05:26.61,CNsub,NTP,0000,0000,0000,,Фука патшаның қарсы алуы
Dialogue: 0,0:05:29.41,0:05:30.05,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:31.03,0:05:33.50,CNsub,NTP,0000,0000,0000,,Бұл гүлді бірінші рет көру.
Dialogue: 0,0:05:33.77,0:05:36.58,CNsub,NTP,0000,0000,0000,,Бір топқа қатысу
Dialogue: 0,0:05:36.64,0:05:39.86,CNsub,NTP,0000,0000,0000,,Егер сіз мұны оқығыңыз келсе, мынаны оқыңыз:
Dialogue: 0,0:05:40.14,0:05:42.78,CNsub,NTP,0000,0000,0000,,Қашықтықтан бөлінудің қауіпті оқиғалары
Dialogue: 0,0:05:44.86,0:05:49.48,CNsub,NTP,0000,0000,0000,,Бұл ақыл-ой технологиясының шебері.
Dialogue: 0,0:05:50.13,0:05:52.48,CNsub,NTP,0000,0000,0000,,Мен сиқыршының шәкіртімін.
Dialogue: 0,0:05:53.57,0:05:57.35,CNsub,NTP,0000,0000,0000,,Менің ерлігім туралы әңгіме
Dialogue: 0,0:05:58.06,0:05:59.78,CNsub,NTP,0000,0000,0000,,Бастапқыда бұл түпнұсқа оқиға...
Dialogue: 0,0:06:03.83,0:06:05.94,CNsub,NTP,0000,0000,0000,,Мен бұл оқиғаны қатты жек көремін.
Dialogue: 0,0:06:06.46,0:06:10.34,CNsub,NTP,0000,0000,0000,,Құпия қаруды қауіпсіз жеткізу.
Dialogue: 0,0:06:10.78,0:06:12.91,CNsub,NTP,0000,0000,0000,,Бұл құпия қару
Dialogue: 0,0:06:13.62,0:06:15.69,CNsub,NTP,0000,0000,0000,,Жеке комиссияңызды жазып алыңыз
Dialogue: 0,0:06:16.36,0:06:19.11,CNsub,NTP,0000,0000,0000,,Ауылдағы пері
Dialogue: 0,0:06:19.27,0:06:23.17,CNsub,NTP,0000,0000,0000,,Мазасыз сиқырлы қызметкерлерді мектепке кіргізбеу
Dialogue: 0,0:06:23.82,0:06:24.93,CNsub,NTP,0000,0000,0000,,Ауырды! Өте қатты ауырды! Тоқта, тоқта! Қол тигізбе!
Dialogue: 0,0:06:25.10,0:06:30.08,CNsub,NTP,0000,0000,0000,,Бұл жағдайда пері гүлінің келе жатқанын көре алмайсың.
Dialogue: 0,0:06:31.00,0:06:32.65,CNsub,NTP,0000,0000,0000,,Бұл...осы бөлім...
Dialogue: 0,0:06:38.23,0:06:43.83,CNsub,NTP,0000,0000,0000,,Ересек Тоуко Косаки командасының бұрыннан бар стиліне сәйкестігі
Dialogue: 0,0:06:46.91,0:06:50.08,CNsub,NTP,0000,0000,0000,,Қызғылт сары қыз шын ойын~
Dialogue: 0,0:06:53.95,0:06:55.85,CNsub,NTP,0000,0000,0000,,Кездесуді бастайтын жел мен толқындар
Dialogue: 0,0:06:57.15,0:06:58.47,CNsub,NTP,0000,0000,0000,,Бұл не? Бұл кілт пе?
Dialogue: 0,0:06:59.69,0:07:03.07,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:07:03.97,0:07:05.72,CNsub,NTP,0000,0000,0000,,Сіз түсініксізсіз
Dialogue: 0,0:07:06.99,0:07:08.09,CNsub,NTP,0000,0000,0000,,Сіздің ойыңыз қандай?
Dialogue: 0,0:07:08.97,0:07:10.33,CNsub,NTP,0000,0000,0000,,Барлық меншік
Dialogue: 0,0:07:18.30,0:07:20.30,CNsub,NTP,0000,0000,0000,,Мен сонда болғанға дейін не ойладым
Dialogue: 0,0:07:21.00,0:07:23.54,CNsub,NTP,0000,0000,0000,,Қызғылт сары сөмкеде ақау бар ма?
Dialogue: 0,0:07:24.43,0:07:28.94,CNsub,NTP,0000,0000,0000,,Кімге ұнамайды? Сен менің мектебіме келдің
Dialogue: 0,0:07:29.63,0:07:31.60,CNsub,NTP,0000,0000,0000,,Расымен де, мұның ақылды әрекет екенін көре алатын заңға бағынатын адамдар жоқ.
Dialogue: 0,0:07:32.99,0:07:37.20,CNsub,NTP,0000,0000,0000,,Шындық мынада, келесі кездесуге күмән жоқ.
Dialogue: 0,0:07:37.53,0:07:40.88,CNsub,NTP,0000,0000,0000,,Жаңа жылдық жұмысқа орналасу талаптары бос емес сауалнама Fairy
Dialogue: 0,0:07:41.51,0:07:42.77,CNsub,NTP,0000,0000,0000,,Операцияны басқаратын шебер агент: Твайлайт
Dialogue: 0,0:07:43.52,0:07:49.66,CNsub,NTP,0000,0000,0000,,Бұл шебер емес, мен сенің бейнең емеспін.
Dialogue: 0,0:07:54.22,0:07:56.57,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:07:57.29,0:07:59.06,CNsub,NTP,0000,0000,0000,,Кеңсе бөлмесі аяқталды.
Dialogue: 0,0:07:59.63,0:08:00.63,CNsub,NTP,0000,0000,0000,,Дұрыс емес
Dialogue: 0,0:08:01.00,0:08:06.38,CNsub,NTP,0000,0000,0000,,Шетелге саяхаттап жүрген жапондық отбасы мүшесі Муротомо Мидзуоның иті
Dialogue: 0,0:08:09.01,0:08:11.05,CNsub,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,0:08:11.54,0:08:15.20,CNsub,NTP,0000,0000,0000,,Дегенмен, отбасы қожайынға ұқсас.
Dialogue: 0,0:08:23.17,0:08:26.84,CNsub,NTP,0000,0000,0000,,Бұл заң мектебі, бірақ оның сыртқы түрі ұқсас.
Dialogue: 0,0:08:30.82,0:08:32.69,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:08:32.92,0:08:34.56,CNsub,NTP,0000,0000,0000,,Қайда келдің?
Dialogue: 0,0:08:35.15,0:08:37.65,CNsub,NTP,0000,0000,0000,,Талантың жоқ болса, оқы.
Dialogue: 0,0:08:37.95,0:08:39.85,CNsub,NTP,0000,0000,0000,,Ләззат алу нүктесіне бару
Dialogue: 0,0:08:42.31,0:08:43.27,CNsub,NTP,0000,0000,0000,,Жақсы пікір!
Dialogue: 0,0:08:56.91,0:08:58.40,CNsub,NTP,0000,0000,0000,,Мен мектеп-интернат оқушысымын.
Dialogue: 0,0:08:58.69,0:09:01.07,CNsub,NTP,0000,0000,0000,,Қысқы кезеңде оқушылар аз.
Dialogue: 0,0:09:01.33,0:09:03.31,CNsub,NTP,0000,0000,0000,,Қажетсіз назар аудару...
Dialogue: 0,0:09:06.87,0:09:08.33,CNsub,NTP,0000,0000,0000,,Нақанның Көрейрей залы
Dialogue: 0,0:09:08.55,0:09:09.58,CNsub,NTP,0000,0000,0000,,Қараңыз
Dialogue: 0,0:09:10.21,0:09:11.53,CNsub,NTP,0000,0000,0000,,Жиналыс тізімі
Dialogue: 0,0:09:13.75,0:09:16.76,CNsub,NTP,0000,0000,0000,,«Әкемнің жұмаққа шақыруы...» түрлері
Dialogue: 0,0:09:17.06,0:09:18.49,CNsub,NTP,0000,0000,0000,,Маған қоңырау шалғанда...
Dialogue: 0,0:09:19.29,0:09:21.24,CNsub,NTP,0000,0000,0000,,Иә? Бұл ''Шинхожотен''.
Dialogue: 0,0:09:21.50,0:09:22.86,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:09:27.00,0:09:31.94,CNsub,NTP,0000,0000,0000,,14
Dialogue: 0,0:09:32.74,0:09:34.00,CNsub,NTP,0000,0000,0000,,Канояманың үйіне айқайлаңыз
Dialogue: 0,0:09:34.59,0:09:38.75,CNsub,NTP,0000,0000,0000,,Жоқ, Канояма Роши қараша айында кенеттен белгісіз болып қалды.
Dialogue: 0,0:09:39.14,0:09:42.31,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:09:42.87,0:09:45.54,CNsub,NTP,0000,0000,0000,,Токио шығанағындағы мұхит түбіндегі анықталмаған ағымдағы жағдай
Dialogue: 0,0:09:46.46,0:09:49.24,CNsub,NTP,0000,0000,0000,,Наса отбасының оқытушылар құрамы
Dialogue: 0,0:09:49.73,0:09:51.49,CNsub,NTP,0000,0000,0000,,Бұл директордың інісі болғандықтан.
Dialogue: 0,0:09:53.64,0:09:56.20,CNsub,NTP,0000,0000,0000,,Қазіргі топ басшысы кім?
Dialogue: 0,0:09:58.29,0:09:59.91,CNsub,NTP,0000,0000,0000,,Зегенженрожи
Dialogue: 0,0:10:05.60,0:10:07.97,CNsub,NTP,0000,0000,0000,,Мен 1 курс және 1 топтағы қара тунг гүлімін.
Dialogue: 0,0:10:08.89,0:10:11.76,CNsub,NTP,0000,0000,0000,,Ширандо мектебінің ұзақтығы дұрыс па?
Dialogue: 0,0:10:13.54,0:10:14.04,CNsub,NTP,0000,0000,0000,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:10:20.98,0:10:23.88,CNsub,NTP,0000,0000,0000,,Ертегі туралы естелік?
Dialogue: 0,0:10:25.41,0:10:29.77,CNsub,NTP,0000,0000,0000,,Иә, мен студенттік кабинетке келдім.
Dialogue: 0,0:10:30.42,0:10:33.16,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:10:34.35,0:10:39.26,CNsub,NTP,0000,0000,0000,,Перінің өнеріне көңілім толмайды.
Dialogue: 0,0:10:39.69,0:10:40.90,CNsub,NTP,0000,0000,0000,,Энсошину
Dialogue: 0,0:10:42.05,0:10:42.65,CNsub,NTP,0000,0000,0000,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:10:44.02,0:10:47.82,CNsub,NTP,0000,0000,0000,,Жапониядағы пері оқиғасы шағын.
Dialogue: 0,0:10:48.51,0:10:50.35,CNsub,NTP,0000,0000,0000,,Дегенмен, Еуропа әмбебап.
Dialogue: 0,0:10:52.27,0:10:55.43,CNsub,NTP,0000,0000,0000,,Қарт қожайын ауқатты елде дүниеге келген.
Dialogue: 0,0:10:55.63,0:10:57.92,CNsub,NTP,0000,0000,0000,,Меншіл ұлт
Dialogue: 0,0:10:57.98,0:11:03.67,CNsub,NTP,0000,0000,0000,,Мысық, ит, құбыжық туралы сүйкімді ертегі.
Dialogue: 0,0:11:04.66,0:11:07.00,CNsub,NTP,0000,0000,0000,,Жеңілгеніме қуаныштымын.
Dialogue: 0,0:11:14.84,0:11:19.83,CNsub,NTP,0000,0000,0000,,«Ертегі өлтіруші» Бұл оқиға рас па, жоқ па.
Dialogue: 0,0:11:23.30,0:11:27.39,CNsub,NTP,0000,0000,0000,,Тачибанаға қатысты қандай жағдайлар бар?
Dialogue: 0,0:11:27.78,0:11:28.22,CNsub,NTP,0000,0000,0000,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:11:28.84,0:11:33.85,CNsub,NTP,0000,0000,0000,,«Мен өзімді өлтірген жоқпын, бірақ перінің ықпалында болдым» 4-топ...
Dialogue: 0,0:11:34.87,0:11:35.63,CNsub,NTP,0000,0000,0000,,Бұл сіздің барлық жүктеріңіз бе?
Dialogue: 0,0:11:39.45,0:11:42.84,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:43.76,0:11:45.20,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:45.72,0:11:48.48,CNsub,NTP,0000,0000,0000,,Жұмыс мерзімінен бұрын аяқталды
Dialogue: 0,0:11:49.99,0:11:54.12,CNsub,NTP,0000,0000,0000,,Студенттік кеңестің президенті Yellow Road Миса Ягакушу директордың өкілі.
Dialogue: 0,0:11:49.47,0:11:53.92,CNsub,NTP,0000,0000,0000,,Уақыт шектелмейді.
Dialogue: 0,0:11:54.73,0:11:56.59,CNsub,NTP,0000,0000,0000,,Сары жол Доғаку Шин ең жоғары баға
Dialogue: 0,0:11:57.48,0:12:00.40,CNsub,NTP,0000,0000,0000,,Сондай-ақ «Шектеусіз» Шығыс және Батыс аймағында қол жетімді.
Dialogue: 0,0:12:06.10,0:12:10.74,CNsub,NTP,0000,0000,0000,,Тачибана догаку оқиғасы
Dialogue: 0,0:12:13.14,0:12:15.21,CNsub,NTP,0000,0000,0000,,Сіз қара түнг оқушысысыз.
Dialogue: 0,0:12:15.47,0:12:16.89,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:12:17.69,0:12:20.91,CNsub,NTP,0000,0000,0000,,Жағдайға қатысты ешқандай мән-жайлар жоқ.
Dialogue: 0,0:12:21.17,0:12:23.71,CNsub,NTP,0000,0000,0000,,Оны оқудың қажеті жоқ.
Dialogue: 0,0:12:25.59,0:12:26.19,CNsub,NTP,0000,0000,0000,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:12:52.31,0:12:55.57,CNsub,NTP,0000,0000,0000,,1-курс, 4-сынып, сол студент қатысуға рұқсат етілмейді.
Dialogue: 0,0:12:55.76,0:12:57.97,CNsub,NTP,0000,0000,0000,,Жалға берушінің жеке жағдай туралы айтуды қаламауы
Dialogue: 0,0:12:58.23,0:13:00.11,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:13:02.48,0:13:03.61,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:13:08.94,0:13:13.34,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:13:14.47,0:13:17.97,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:13:18.07,0:13:22.60,CNsub,NTP,0000,0000,0000,,Сіз... сөйледіңіз.
Dialogue: 0,0:13:22.90,0:13:25.21,CNsub,NTP,0000,0000,0000,,Ойлар мен мағыналар
Dialogue: 0,0:13:25.94,0:13:30.23,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:13:30.59,0:13:34.28,CNsub,NTP,0000,0000,0000,,Сыртқы түрі белгісіз мүсін Басқа астаналар - қара пауловния ханья
Dialogue: 0,0:13:35.23,0:13:38.09,CNsub,NTP,0000,0000,0000,,Баланың бейнесі бірдей емес...
Dialogue: 0,0:13:39.71,0:13:40.50,CNsub,NTP,0000,0000,0000,,Құлау…
Dialogue: 0,0:13:44.20,0:13:44.82,CNsub,NTP,0000,0000,0000,,Формула?
Dialogue: 0,0:14:05.74,0:14:07.08,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:07.77,0:14:08.56,CNsub,NTP,0000,0000,0000,,Жұмыс аяқталды
Dialogue: 0,0:14:10.57,0:14:11.42,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:11.90,0:14:13.25,CNsub,NTP,0000,0000,0000,,Қажетсіз қозғалыс
Dialogue: 0,0:14:13.64,0:14:14.93,CNsub,NTP,0000,0000,0000,,Менің сөздерім...
Dialogue: 0,0:14:16.69,0:14:17.49,CNsub,NTP,0000,0000,0000,,Барлығыңды өлтіреміз
Dialogue: 0,0:14:40.32,0:14:41.53,CNsub,NTP,0000,0000,0000,,Қара тунг Фухуа Догаку
Dialogue: 0,0:14:41.81,0:14:42.38,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:15:24.38,0:15:26.60,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:15:27.13,0:15:29.26,CNsub,NTP,0000,0000,0000,,Хан…Каня
Dialogue: 0,0:15:34.28,0:15:34.89,CNsub,NTP,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:15:35.11,0:15:38.18,CNsub,NTP,0000,0000,0000,,Бұл тура жұдырық
Dialogue: 0,0:15:39.23,0:15:41.15,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:15:41.40,0:15:43.81,CNsub,NTP,0000,0000,0000,,Кенет кеуіп қалды.
Dialogue: 0,0:15:43.99,0:15:45.13,CNsub,NTP,0000,0000,0000,,Оян
Dialogue: 0,0:15:45.37,0:15:46.29,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:15:47.89,0:15:50.69,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:15:51.71,0:15:54.37,CNsub,NTP,0000,0000,0000,,Төменгі сол және оң нүктелер
Dialogue: 0,0:16:02.05,0:16:04.36,CNsub,NTP,0000,0000,0000,,Өрнекті Мен аяқтамадым...
Dialogue: 0,0:16:04.80,0:16:07.07,CNsub,NTP,0000,0000,0000,,Пері қашып кетті
Dialogue: 0,0:16:16.63,0:16:19.87,CNsub,NTP,0000,0000,0000,,Сен ауылда сиқыршысың.
Dialogue: 0,0:16:20.00,0:16:24.07,CNsub,NTP,0000,0000,0000,,Баратын жеріме жеткенде, есептеуді аяқтадым!
Dialogue: 0,0:16:32.53,0:16:34.21,CNsub,NTP,0000,0000,0000,,Бұл олай емес...
Dialogue: 0,0:16:36.34,0:16:36.87,CNsub,NTP,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:16:37.60,0:16:39.95,CNsub,NTP,0000,0000,0000,,Казуя өте батыл.
Dialogue: 0,0:16:40.77,0:16:43.41,CNsub,NTP,0000,0000,0000,,Директорлар кеңесінің директоры Иматен Ширанзай Ниори Жаңа жылдық кешті ашу
Dialogue: 0,0:16:43.64,0:16:45.45,CNsub,NTP,0000,0000,0000,,Мейтен жоқ Мэй, алдыңғы кездесу жоқ
Dialogue: 0,0:16:46.56,0:16:49.87,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:16:52.84,0:16:53.61,CNsub,NTP,0000,0000,0000,,Формула?
Dialogue: 0,0:16:55.16,0:16:55.81,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:17:14.77,0:17:16.17,CNsub,NTP,0000,0000,0000,,Бұл әйел есімі.
Dialogue: 0,0:17:21.68,0:17:23.35,CNsub,NTP,0000,0000,0000,,Магистрдің алғысы
Dialogue: 0,0:17:38.68,0:17:39.39,CNsub,NTP,0000,0000,0000,,Қабылданды
Dialogue: 0,0:17:40.44,0:17:42.28,CNsub,NTP,0000,0000,0000,,Тачибана болған оқиғадан кейін
Dialogue: 0,0:17:42.41,0:17:47.04,CNsub,NTP,0000,0000,0000,,4-ші топтың 1-курстағы оқыс оқиғадан алған ішкі материалдары
Dialogue: 0,0:17:49.28,0:17:55.43,CNsub,NTP,0000,0000,0000,,Тачибана мектебінің екінші семестрінің екінші жартысының басы
Dialogue: 0,0:17:56.17,0:17:58.68,CNsub,NTP,0000,0000,0000,,Кенет өзгерді.
Dialogue: 0,0:17:59.24,0:18:01.52,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:18:01.75,0:18:03.67,CNsub,NTP,0000,0000,0000,,Оқиғаны тексеру…
Dialogue: 0,0:18:04.59,0:18:05.54,CNsub,NTP,0000,0000,0000,,Ақымақ
Dialogue: 0,0:18:07.04,0:18:11.00,CNsub,NTP,0000,0000,0000,,Пері...Фея келді
Dialogue: 0,0:18:14.50,0:18:17.37,CNsub,NTP,0000,0000,0000,,Тачибана және т.б. Тачибана
Dialogue: 0,0:18:18.78,0:18:22.27,CNsub,NTP,0000,0000,0000,,Мен сонда болған соң ескі мектеп ғимаратына келдім...
Dialogue: 0,0:18:23.14,0:18:25.29,CNsub,NTP,0000,0000,0000,,Түсінікті мәлімдеме
Dialogue: 0,0:18:25.46,0:18:27.21,CNsub,NTP,0000,0000,0000,,Мен сенімен қазір кездескім келмейді...
Dialogue: 0,0:18:27.83,0:18:30.55,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:18:30.94,0:18:32.68,CNsub,NTP,0000,0000,0000,,Сиқыршы Насуан ертегі
Dialogue: 0,0:18:32.97,0:18:35.32,CNsub,NTP,0000,0000,0000,,Мт.
Dialogue: 0,0:18:36.15,0:18:38.06,CNsub,NTP,0000,0000,0000,,Аспандағы туылу
Dialogue: 0,0:18:40.04,0:18:42.44,CNsub,NTP,0000,0000,0000,,Иә? Бұл...
Dialogue: 0,0:18:44.05,0:18:45.57,CNsub,NTP,0000,0000,0000,,Оранж ханым
Dialogue: 0,0:19:19.52,0:19:24.16,CNsub,NTP,0000,0000,0000,,Нана
Dialogue: 0,0:19:28.05,0:19:28.81,CNsub,NTP,0000,0000,0000,,... міне, осы
Dialogue: 0,0:19:29.63,0:19:30.72,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:19:31.86,0:19:35.91,CNsub,NTP,0000,0000,0000,,Перидің қашқаны туралы естелік қайта оралмады.
Dialogue: 0,0:19:36.37,0:19:37.88,CNsub,NTP,0000,0000,0000,,Жауабы: аты жоғалған.
Dialogue: 0,0:19:38.16,0:19:39.23,CNsub,NTP,0000,0000,0000,,Қазір осылай болды.
Dialogue: 0,0:19:39.74,0:19:43.92,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:19:44.09,0:19:45.20,CNsub,NTP,0000,0000,0000,,Мен жақсы үлгімін.
Dialogue: 0,0:19:47.53,0:19:50.88,CNsub,NTP,0000,0000,0000,,Пері хабаршысының мақсаты – генералдың өлімі.
Dialogue: 0,0:19:51.70,0:19:54.64,CNsub,NTP,0000,0000,0000,,Бұл жай ғана нәтиже.
Dialogue: 0,0:19:55.87,0:20:00.32,CNsub,NTP,0000,0000,0000,,Дегенмен, маңызды шешім - өмір мен өлім есептелмейді, бірақ пері де қарапайым оқиға.
Dialogue: 0,0:20:01.84,0:20:03.00,CNsub,NTP,0000,0000,0000,,39-шы эпизод: Ұйықтап жатқан құл
Dialogue: 0,0:20:03.39,0:20:06.60,CNsub,NTP,0000,0000,0000,,Бұл бастапқы жадтың түпнұсқа көшірмесі...
Dialogue: 0,0:20:07.24,0:20:11.66,CNsub,NTP,0000,0000,0000,,Мен бұл туралы ойлаған адамның естелігін еске түсіргім келетін жағдайлар.
Dialogue: 0,0:20:22.85,0:20:25.44,CNsub,NTP,0000,0000,0000,,Өрнек
Dialogue: 0,0:20:29.56,0:20:30.31,CNsub,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:20:31.18,0:20:32.33,CNsub,NTP,0000,0000,0000,,Қажет емес жабдықтар
Dialogue: 0,0:20:33.16,0:20:36.36,CNsub,NTP,0000,0000,0000,,Мен мейрамхана ұстаған мейрамханада айқайладым.
Dialogue: 0,0:20:36.92,0:20:40.32,CNsub,NTP,0000,0000,0000,,Қылыш жеу керек емес.
Dialogue: 0,0:20:40.41,0:20:44.13,CNsub,NTP,0000,0000,0000,,Тәртіпсіздік.
Dialogue: 0,0:20:44.39,0:20:46.56,CNsub,NTP,0000,0000,0000,,Мен жинауға келдім
Dialogue: 0,0:20:47.20,0:20:49.33,CNsub,NTP,0000,0000,0000,,Сіздің қолыңыздан келетін нәрседе шек жоқ.
Dialogue: 0,0:20:50.53,0:20:51.52,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:20:52.43,0:20:55.23,CNsub,NTP,0000,0000,0000,,Мен күш күшін түсінетінімді түсіндім.
Dialogue: 0,0:20:57.14,0:20:58.89,CNsub,NTP,0000,0000,0000,,Маған не болды?
Dialogue: 0,0:21:01.54,0:21:04.19,CNsub,NTP,0000,0000,0000,,Маған хабарлаңыз...
Dialogue: 0,0:21:06.07,0:21:07.02,CNsub,NTP,0000,0000,0000,,келді
Dialogue: 0,0:21:08.83,0:21:10.43,CNsub,NTP,0000,0000,0000,,Сіз мықты әйелсіз
Dialogue: 0,0:21:11.78,0:21:13.16,CNsub,NTP,0000,0000,0000,,Тұрақсыз
Dialogue: 0,0:21:13.32,0:21:16.85,CNsub,NTP,0000,0000,0000,,Мен сізге ешқандай қолдау көрсете алмадым.
Dialogue: 0,0:21:17.00,0:21:22.29,CNsub,NTP,0000,0000,0000,,Сіз…сіз…сіз осындасыз
Dialogue: 0,0:21:22.35,0:21:26.36,CNsub,NTP,0000,0000,0000,,Өлмеу;
Dialogue: 0,0:21:30.88,0:21:32.46,CNsub,NTP,0000,0000,0000,,Бұл анық па?
Dialogue: 0,0:21:33.05,0:21:34.62,CNsub,NTP,0000,0000,0000,,Мен кінәсізмін
Dialogue: 0,0:21:35.31,0:21:37.43,CNsub,NTP,0000,0000,0000,,Адамдардың мен емес екені көрініп тұр.
Dialogue: 0,0:21:37.63,0:21:41.93,CNsub,NTP,0000,0000,0000,,Мүдделі тараптарға өте аз көңіл бөлу керек.
Dialogue: 0,0:21:42.32,0:21:45.58,CNsub,NTP,0000,0000,0000,,Бұл жауап...
Dialogue: 0,0:21:50.69,0:21:52.37,CNsub,NTP,0000,0000,0000,,Ләззат алу үшін
Dialogue: 0,0:21:53.61,0:21:56.28,CNsub,NTP,0000,0000,0000,,Сендер аға мен әпкесіңдер.
Dialogue: 0,0:21:59.96,0:22:04.80,CNsub,NTP,0000,0000,0000,,Ақ фонда аударма, арнайы шығыс және батыс
Dialogue: 0,0:22:05.23,0:22:09.67,CNsub,NTP,0000,0000,0000,,Қарсы көрсеткіштер мен тартымдылық туралы айтпау
Dialogue: 0,0:22:09.99,0:22:12.81,CNsub,NTP,0000,0000,0000,,Демек, бақытты адам көрші туралы әңгіме.
Dialogue: 0,0:22:12.87,0:22:14.98,CNsub,NTP,0000,0000,0000,,Естілмеу – бір бақыт.
Dialogue: 0,0:22:17.12,0:22:17.76,CNsub,NTP,0000,0000,0000,,Сіздің жеке өзгерісіңіз
Dialogue: 0,0:22:17.97,0:22:18.68,CNsub,NTP,0000,0000,0000,,Тесілмеген, бірақ бірдеңе бар…
Dialogue: 0,0:22:20.07,0:22:21.63,CNsub,NTP,0000,0000,0000,,Сіз басқа адамсыз
Dialogue: 0,0:22:27.45,0:22:31.54,CNsub,NTP,0000,0000,0000,,Мәселе мынада, мен жағдайға ризамын.
Dialogue: 0,0:22:31.74,0:22:33.92,CNsub,NTP,0000,0000,0000,,Уақыттың мүлде өшіп қалған естеліктері
Dialogue: 0,0:22:35.89,0:22:39.31,CNsub,NTP,0000,0000,0000,,Өрнек Кайкирай Кайжокирай
Dialogue: 0,0:22:39.58,0:22:43.66,CNsub,NTP,0000,0000,0000,,Ескі мектеп ғимаратындағы өрт тезірек жойылуы керек.
Dialogue: 0,0:22:44.15,0:22:46.17,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:22:48.22,0:22:49.54,CNsub,NTP,0000,0000,0000,,Сіз ұйықтап жатқанда
Dialogue: 0,0:22:59.95,0:23:01.83,CNsub,NTP,0000,0000,0000,,Black Tung мектебі Сіз осындасыз
Dialogue: 0,0:23:02.22,0:23:03.98,CNsub,NTP,0000,0000,0000,,Сізге телефон қоңырауы түсті ме?
Dialogue: 0,0:23:05.06,0:23:05.95,CNsub,NTP,0000,0000,0000,,Гор?
Dialogue: 0,0:23:20.26,0:23:24.12,CNsub,NTP,0000,0000,0000,,Нана Жушин Спирттің бастапқы сессиясы
Dialogue: 0,0:23:31.44,0:23:37.91,CNsub,NTP,0000,0000,0000,,Өткен қарашада сыныпқа Тачибана Касеидің «Фея келді» деген үлкен айқайы келді.
Dialogue: 0,0:23:38.34,0:23:40.67,CNsub,NTP,0000,0000,0000,,Бұл ескі мектеп ғимараты
Dialogue: 0,0:23:41.25,0:23:45.94,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:23:47.22,0:23:51.31,CNsub,NTP,0000,0000,0000,,Оқушыны пері тұтқындаған кездегі оқиғадан естелік
Dialogue: 0,0:23:52.80,0:23:55.48,CNsub,NTP,0000,0000,0000,,Сиқыршының мақсаты бір екені сөзсіз.
Dialogue: 0,0:24:07.91,0:24:09.43,CNsub,NTP,0000,0000,0000,,Куротоу Дугаку Йошиёши Хаяками
Dialogue: 0,0:24:10.42,0:24:12.63,CNsub,NTP,0000,0000,0000,,Йоши Хаяками Манабу Хуанджи
Dialogue: 0,0:24:12.99,0:24:15.12,CNsub,NTP,0000,0000,0000,,Күтпеген жергілікті артықшылықтар байқалды
Dialogue: 0,0:24:16.14,0:24:19.44,CNsub,NTP,0000,0000,0000,,Таңертең ерте тұрып, қалай жүру керек
Dialogue: 0,0:24:22.24,0:24:25.35,CNsub,NTP,0000,0000,0000,,Сіз араласуға болмайды деп айта аласыз ба?
Dialogue: 0,0:24:33.71,0:24:35.17,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:24:36.68,0:24:40.42,CNsub,NTP,0000,0000,0000,,Йошихисаның өліміне арналған жеке дұға туралы хабарландыру
Dialogue: 0,0:24:41.31,0:24:42.86,CNsub,NTP,0000,0000,0000,,Қайтыс болған адаммен болған оқиға туралы әңгімені қажет етеді.
Dialogue: 0,0:24:43.32,0:24:45.57,CNsub,NTP,0000,0000,0000,,Қазіргі уақытта сіз расталды және сіз осындасыз.
Dialogue: 0,0:24:47.25,0:24:48.76,CNsub,NTP,0000,0000,0000,,Бұл Тачибана Каори
Dialogue: 0,0:24:49.21,0:24:54.60,CNsub,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:24:55.05,0:24:59.15,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:24:59.90,0:25:02.81,CNsub,NTP,0000,0000,0000,,Хитоманның жалынды сенімі жұмсақ бала.
Dialogue: 0,0:25:04.62,0:25:05.31,CNsub,NTP,0000,0000,0000,,Әрине
Dialogue: 0,0:25:16.11,0:25:19.55,CNsub,NTP,0000,0000,0000,,Гасо Шояның қорлау іздерін өшіру
Dialogue: 0,0:25:21.43,0:25:22.81,CNsub,NTP,0000,0000,0000,,Бұл сенсің
Dialogue: 0,0:25:24.56,0:25:25.74,CNsub,NTP,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:25:27.18,0:25:29.49,CNsub,NTP,0000,0000,0000,,Мен сиқырды басқарамын
Dialogue: 0,0:25:34.52,0:25:36.42,CNsub,NTP,0000,0000,0000,,Қара тунг мектебін қалай оқуға болады
Dialogue: 0,0:25:36.85,0:25:39.19,CNsub,NTP,0000,0000,0000,,Мен сенің не үшін күресіп жатқаныңды білмеймін
Dialogue: 0,0:25:39.57,0:25:41.81,CNsub,NTP,0000,0000,0000,,Дегенмен, алдымен жүргізушіден үйреніңіз.
Dialogue: 0,0:25:43.53,0:25:46.00,CNsub,NTP,0000,0000,0000,,Менің талантты екенім көрініп тұр.
Dialogue: 0,0:25:46.39,0:25:51.96,CNsub,NTP,0000,0000,0000,,Еске түсіре алмауымның себебі, мен сені қатты жақсы көремін.
Dialogue: 0,0:25:52.62,0:25:54.08,CNsub,NTP,0000,0000,0000,,Қ… не?
Dialogue: 0,0:25:55.62,0:25:57.64,CNsub,NTP,0000,0000,0000,,Өте жақсы
Dialogue: 0,0:25:59.03,0:26:00.80,CNsub,NTP,0000,0000,0000,,Барлығы түсінікті
Dialogue: 0,0:26:06.19,0:26:07.59,CNsub,NTP,0000,0000,0000,,Аппақ болғаныма көп болды
Dialogue: 0,0:26:08.15,0:26:12.80,CNsub,NTP,0000,0000,0000,,Уақыт пен уақытты лезде анықтау туралы естеліктер
Dialogue: 0,0:26:13.59,0:26:15.34,CNsub,NTP,0000,0000,0000,,Көрсем қуанып қалдым т.б.
Dialogue: 0,0:26:17.75,0:26:21.59,CNsub,NTP,0000,0000,0000,,Сонымен жолдан қалай шықтыңыз? Жартылай есте сақтау туралы әңгіме
Dialogue: 0,0:26:21.92,0:26:23.48,CNsub,NTP,0000,0000,0000,,Сіз оны нұсқаулық ретінде пайдалана аласыз.
Dialogue: 0,0:26:28.04,0:26:29.25,CNsub,NTP,0000,0000,0000,,Бұлай емес.
Dialogue: 0,0:26:29.82,0:26:33.41,CNsub,NTP,0000,0000,0000,,Перінің қашу қабілетінің болуы туралы естеліктер
Dialogue: 0,0:26:33.78,0:26:38.49,CNsub,NTP,0000,0000,0000,,Жоғалған естеліктер, ұмытылған естеліктер, Елордаға ешкім жеткен жоқ.
Dialogue: 0,0:26:40.24,0:26:41.36,CNsub,NTP,0000,0000,0000,,Куротоу Догаку
Dialogue: 0,0:26:41.96,0:26:43.45,CNsub,NTP,0000,0000,0000,,Сіз мені тыңдауыңыз керек
Dialogue: 0,0:26:44.18,0:26:48.83,CNsub,NTP,0000,0000,0000,,Алайда мен бұлай жасауды жоспарлаған жоқпын.
Dialogue: 0,0:26:49.57,0:26:50.36,CNsub,NTP,0000,0000,0000,,Гакуджи?
Dialogue: 0,0:26:50.85,0:26:53.20,CNsub,NTP,0000,0000,0000,,Сіз біреудің атын алған кезде
Dialogue: 0,0:27:01.79,0:27:03.83,CNsub,NTP,0000,0000,0000,,Қосылған томның ерекшеліктері…
Dialogue: 0,0:27:04.42,0:27:07.39,CNsub,NTP,0000,0000,0000,,Неше адам жауапты?
Dialogue: 0,0:27:07.88,0:27:09.29,CNsub,NTP,0000,0000,0000,,Капитал жабылған кезде
Dialogue: 0,0:27:09.82,0:27:11.56,CNsub,NTP,0000,0000,0000,,Бұған мен кінәлімін.
Dialogue: 0,0:27:13.97,0:27:16.02,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:27:20.31,0:27:23.63,CNsub,NTP,0000,0000,0000,,Бұл сенсің, өзіңді өлтіру сенің таңдауың
Dialogue: 0,0:27:23.89,0:27:27.76,CNsub,NTP,0000,0000,0000,,қажетсіз, қажетсіз
Dialogue: 0,0:27:36.49,0:27:37.54,CNsub,NTP,0000,0000,0000,,Бұл...
Dialogue: 0,0:27:38.08,0:27:39.73,CNsub,NTP,0000,0000,0000,,Қара тунг мектебі
Dialogue: 0,0:27:40.99,0:27:44.73,CNsub,NTP,0000,0000,0000,,Таныс жасау – сұраныс материалы
Dialogue: 0,0:27:45.06,0:27:46.29,CNsub,NTP,0000,0000,0000,,Назаджи апаты
Dialogue: 0,0:27:59.66,0:28:01.16,CNsub,NTP,0000,0000,0000,,Бұл сонымен қатар Канояма және басқалардың әңгімесі...
Dialogue: 0,0:28:07.73,0:28:09.71,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:28:10.28,0:28:14.89,CNsub,NTP,0000,0000,0000,,Бос күйде жүргенде, Ұйқыда жаттым.
Dialogue: 0,0:28:18.58,0:28:25.05,CNsub,NTP,0000,0000,0000,,Қара Тунг мектебі Қара Тунг мектебі Қара Тонг мектебі Қара Тонг мектебі Қара Тонг мектебі
Dialogue: 0,0:28:26.37,0:28:28.18,CNsub,NTP,0000,0000,0000,,Барыңыз… Барыңыз
Dialogue: 0,0:28:28.53,0:28:29.19,CNsub,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:28:29.60,0:28:32.58,CNsub,NTP,0000,0000,0000,,Генерал... Гэнженрожи, кешіріңіз.
Dialogue: 0,0:28:33.13,0:28:35.07,CNsub,NTP,0000,0000,0000,,Қолайсыз түс
Dialogue: 0,0:28:35.40,0:28:36.52,CNsub,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:28:38.21,0:28:39.10,CNsub,NTP,0000,0000,0000,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:28:41.62,0:28:43.64,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:28:43.90,0:28:44.99,CNsub,NTP,0000,0000,0000,,Дегенмен, бұл жағдай.
Dialogue: 0,0:28:54.03,0:28:57.43,CNsub,NTP,0000,0000,0000,,4
Dialogue: 0,0:28:57.76,0:28:59.74,CNsub,NTP,0000,0000,0000,,Жиналыс – құпия хабарлама.
Dialogue: 0,0:29:00.27,0:29:01.68,CNsub,NTP,0000,0000,0000,,Мүмкін...
Dialogue: 0,0:29:02.96,0:29:03.79,CNsub,NTP,0000,0000,0000,,Тар жол…
Dialogue: 0,0:29:05.15,0:29:09.61,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:29:10.33,0:29:13.89,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:29:15.61,0:29:18.90,CNsub,NTP,0000,0000,0000,,Бірден форманы тәркілеуге кепілдік беріледі
Dialogue: 0,0:29:19.06,0:29:20.39,CNsub,NTP,0000,0000,0000,,Әскери күш?
Dialogue: 0,0:29:20.55,0:29:25.23,CNsub,NTP,0000,0000,0000,,Хуанджи Миса мен Ю Тачибананың барлық естеліктері жойылды.
Dialogue: 0,0:29:25.43,0:29:27.46,CNsub,NTP,0000,0000,0000,,Бірінші курс 4 сынып оқушылары
Dialogue: 0,0:29:30.46,0:29:32.43,CNsub,NTP,0000,0000,0000,,Өрнек
Dialogue: 0,0:29:32.72,0:29:35.03,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:29:35.36,0:29:38.18,CNsub,NTP,0000,0000,0000,,Мен орман жолынан алшақпын.
Dialogue: 0,0:29:38.77,0:29:42.40,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:00:00.00,0:00:00.00,CNsub,NTP,0000,0000,0000,,-------------------------------------------------
Dialogue: 0,0:30:02.72,0:30:05.17,CNsub,NTP,0000,0000,0000,,Өзіңізге мән бермеңіз
Dialogue: 0,0:30:05.44,0:30:07.29,CNsub,NTP,0000,0000,0000,,Бұл Нага Шушоның сәтсіздігі.
Dialogue: 0,0:30:28.26,0:30:28.73,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:30:41.28,0:30:42.27,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:31:18.34,0:31:20.33,CNsub,NTP,0000,0000,0000,,Толығымен жоғалып кетті.
Dialogue: 0,0:31:21.73,0:31:24.92,CNsub,NTP,0000,0000,0000,,Минминг мектебі
Dialogue: 0,0:31:26.73,0:31:28.37,CNsub,NTP,0000,0000,0000,,Сынып... арасындағы
Dialogue: 0,0:31:39.48,0:31:40.51,CNsub,NTP,0000,0000,0000,,Кения…
Dialogue: 0,0:31:42.58,0:31:43.91,CNsub,NTP,0000,0000,0000,,Нәтижесінде Ганя оқиғасы
Dialogue: 0,0:31:44.77,0:31:46.39,CNsub,NTP,0000,0000,0000,,Достармен кездесу
Dialogue: 0,0:31:47.42,0:31:49.07,CNsub,NTP,0000,0000,0000,,Каня оқиғасы...
Dialogue: 0,0:32:10.61,0:32:12.30,CNsub,NTP,0000,0000,0000,,Жылама
Dialogue: 0,0:32:13.68,0:32:15.13,CNsub,NTP,0000,0000,0000,,Бұл сіз қалаған нәрсе.
Dialogue: 0,0:32:21.24,0:32:23.77,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:32:40.76,0:32:44.66,CNsub,NTP,0000,0000,0000,,Қандай шындық?
Dialogue: 0,0:32:44.73,0:32:46.43,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:32:49.75,0:32:52.40,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:32:53.52,0:32:55.60,CNsub,NTP,0000,0000,0000,,Жоғалған және бұрын оқылмаған
Dialogue: 0,0:32:55.79,0:32:56.50,CNsub,NTP,0000,0000,0000,,Телефон
Dialogue: 0,0:32:57.51,0:32:58.01,CNsub,NTP,0000,0000,0000,,Қамшы?
Dialogue: 0,0:32:58.48,0:33:00.34,CNsub,NTP,0000,0000,0000,,Бұл сіздің істегіңіз келетін нәрсе
Dialogue: 0,0:33:06.06,0:33:08.24,CNsub,NTP,0000,0000,0000,,Хидео Канояма туралы мәлімет?
Dialogue: 0,0:33:09.20,0:33:10.81,CNsub,NTP,0000,0000,0000,,Мен оны осылай тыңдаймын.
Dialogue: 0,0:33:11.40,0:33:13.81,CNsub,NTP,0000,0000,0000,,Дегенмен, есеп беру кездесуін салыстыру
Dialogue: 0,0:33:14.65,0:33:18.38,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:33:18.65,0:33:22.22,CNsub,NTP,0000,0000,0000,,Салтанат: «Кухана мен Дотсай Канояма»
Dialogue: 0,0:33:22.68,0:33:25.66,CNsub,NTP,0000,0000,0000,,Менің ойлағанымның мәні осы.
Dialogue: 0,0:33:25.79,0:33:30.38,CNsub,NTP,0000,0000,0000,,Мен бұл туралы ойласам, көптеген қауіпті нәрселер болуы мүмкін.
Dialogue: 0,0:33:30.52,0:33:34.76,CNsub,NTP,0000,0000,0000,,Жеке қауіпсіздікке қатысты сертификаттау
Dialogue: 0,0:33:36.60,0:33:37.70,CNsub,NTP,0000,0000,0000,,Ная - өлі құқықтық мәселе
Dialogue: 0,0:33:38.32,0:33:41.68,CNsub,NTP,0000,0000,0000,,Қазіргі көңіл күйінің себебі - гүлдену.
Dialogue: 0,0:33:47.22,0:33:49.37,CNsub,NTP,0000,0000,0000,,Сіз ол жерге қашан келдіңіз?
Dialogue: 0,0:33:49.60,0:33:52.91,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:33:53.30,0:33:55.15,CNsub,NTP,0000,0000,0000,,Ханымның ауызша сөзі.
Dialogue: 0,0:33:56.67,0:33:57.90,CNsub,NTP,0000,0000,0000,,Кішкентай апаның ауызша хабары?
Dialogue: 0,0:34:09.70,0:34:11.90,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:34:12.21,0:34:14.05,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:34:15.16,0:34:17.27,CNsub,NTP,0000,0000,0000,,Нағыз өлместік
Dialogue: 0,0:34:17.80,0:34:21.76,CNsub,NTP,0000,0000,0000,,Сатсуки Генрей — «Құдайдың кітабы» атты ең қауіпті сиқыршы.
Dialogue: 0,0:34:22.55,0:34:24.57,CNsub,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:34:25.32,0:34:28.10,CNsub,NTP,0000,0000,0000,,Менеджердің басқа тараптар қолданатын тілді білуі
Dialogue: 0,0:34:28.33,0:34:30.69,CNsub,NTP,0000,0000,0000,,Дегенмен, басқа да күшті шабуыл әдістері бар
Dialogue: 0,0:34:31.44,0:34:33.03,CNsub,NTP,0000,0000,0000,,Жоспардың дұрыс немесе дұрыс еместігін маған хабарлаңыз.
Dialogue: 0,0:34:33.29,0:34:36.22,CNsub,NTP,0000,0000,0000,,Шәкірт болғаным рас.
Dialogue: 0,0:34:37.28,0:34:39.45,CNsub,NTP,0000,0000,0000,,Алдымен не айтарымды білмеймін.
Dialogue: 0,0:35:00.11,0:35:01.04,CNsub,NTP,0000,0000,0000,,Куротоу Догаку
Dialogue: 0,0:35:01.66,0:35:04.07,CNsub,NTP,0000,0000,0000,,Генчжо ескі шебері Акигамияши
Dialogue: 0,0:35:06.02,0:35:07.34,CNsub,NTP,0000,0000,0000,,Капитал жоқ…
Dialogue: 0,0:35:07.40,0:35:09.09,CNsub,NTP,0000,0000,0000,,Менің уақытым аяқталды
Dialogue: 0,0:36:13.52,0:36:15.86,CNsub,NTP,0000,0000,0000,,Есептеу қажет: Тачибана мүсіні өздігінен жанады.
Dialogue: 0,0:36:15.99,0:36:19.16,CNsub,NTP,0000,0000,0000,,Дегенмен, бүкіл топтың иесі оны ала алмайды.
Dialogue: 0,0:36:20.75,0:36:23.72,CNsub,NTP,0000,0000,0000,,Бұл оны алудың жолы емес.
Dialogue: 0,0:36:24.28,0:36:26.42,CNsub,NTP,0000,0000,0000,,Осы кешті қорытындылау туралы мәліметтер
Dialogue: 0,0:36:29.79,0:36:32.83,CNsub,NTP,0000,0000,0000,,Сегунаттан кейінгі шынайы қара қолдар жойылды.
Dialogue: 0,0:36:37.68,0:36:40.97,CNsub,NTP,0000,0000,0000,,Ол жерге жеткенде не болды?
Dialogue: 0,0:36:41.53,0:36:42.45,CNsub,NTP,0000,0000,0000,,Мүлдем мақсатсыз
Dialogue: 0,0:36:42.71,0:36:46.89,CNsub,NTP,0000,0000,0000,,Шираничи Мен жаңа ғана басқа адамның тілегін орындадым.
Dialogue: 0,0:36:47.53,0:36:51.10,CNsub,NTP,0000,0000,0000,,Келесі оқиға сіз қалағандай емес.
Dialogue: 0,0:36:51.76,0:36:54.30,CNsub,NTP,0000,0000,0000,,Менің өлімімнің мақсаты қандай?
Dialogue: 0,0:36:55.25,0:36:56.64,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:36:57.23,0:36:59.17,CNsub,NTP,0000,0000,0000,,Мен бұл елден қайдан келдім
Dialogue: 0,0:36:59.30,0:37:01.55,CNsub,NTP,0000,0000,0000,,Бұл Арая сектасының кесірінен.
Dialogue: 0,0:37:02.14,0:37:06.23,CNsub,NTP,0000,0000,0000,,2000 жыл бұрынғы естеліктер
Dialogue: 0,0:37:06.99,0:37:10.86,CNsub,NTP,0000,0000,0000,,Ол жерде болмаған естеліктер
Dialogue: 0,0:37:11.68,0:37:15.41,CNsub,NTP,0000,0000,0000,,Әңгімелесуде сізді көру мүмкіндігімнің шынайылығы
Dialogue: 0,0:37:16.79,0:37:19.14,CNsub,NTP,0000,0000,0000,,Менің миссиям тек орындалды.
Dialogue: 0,0:37:20.36,0:37:21.77,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:37:22.49,0:37:27.91,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:37:28.96,0:37:31.23,CNsub,NTP,0000,0000,0000,,Адам өмірінде ол – сұраныс.
Dialogue: 0,0:37:31.85,0:37:35.66,CNsub,NTP,0000,0000,0000,,Құрал-жабдық пайдаланылмағандықтан, құрал-жабдықтар пайдаланылмады.
Dialogue: 0,0:37:36.04,0:37:38.02,CNsub,NTP,0000,0000,0000,,Сіз сиқыршысыз
Dialogue: 0,0:37:39.33,0:37:42.73,CNsub,NTP,0000,0000,0000,,Мен сөздерді қолдан жасайтын сиқыршымын.
Dialogue: 0,0:37:43.22,0:37:45.42,CNsub,NTP,0000,0000,0000,,Тақырыбы: «Құдайдың кітабы»
Dialogue: 0,0:37:48.60,0:37:50.60,CNsub,NTP,0000,0000,0000,,Ойыншық отты ойыны осында тоқтайды.
Dialogue: 0,0:37:52.41,0:37:53.52,CNsub,NTP,0000,0000,0000,,Манабу Хуандзи
Dialogue: 0,0:37:55.03,0:37:57.67,CNsub,NTP,0000,0000,0000,,Бөлек ойын. Куротоу Дугаку
Dialogue: 0,0:37:58.46,0:38:00.56,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:38:02.18,0:38:04.81,CNsub,NTP,0000,0000,0000,,Адам қайтыс болған кезде
Dialogue: 0,0:38:05.60,0:38:07.75,CNsub,NTP,0000,0000,0000,,Канояманың өлімі
Dialogue: 0,0:38:08.47,0:38:11.11,CNsub,NTP,0000,0000,0000,,Алайда басқа адамдардың өлуіне рұқсат етілмейді.
Dialogue: 0,0:38:11.57,0:38:16.15,CNsub,NTP,0000,0000,0000,,Тауда өлген адам басқа мен.
Dialogue: 0,0:38:19.15,0:38:22.10,CNsub,NTP,0000,0000,0000,,Бұл менің ертегім.
Dialogue: 0,0:38:22.65,0:38:25.43,CNsub,NTP,0000,0000,0000,,Сіз ғылымның сиқырын түсіне аласыз.
Dialogue: 0,0:38:25.86,0:38:28.27,CNsub,NTP,0000,0000,0000,,Бұл Канояма жасаған ертегі материалы.
Dialogue: 0,0:38:28.72,0:38:33.36,CNsub,NTP,0000,0000,0000,,Иә, экзистенциалды пері елесін басқалардың көруі мүмкін емес.
Dialogue: 0,0:38:33.72,0:38:34.65,CNsub,NTP,0000,0000,0000,,Иллюзия?
Dialogue: 0,0:38:35.12,0:38:37.94,CNsub,NTP,0000,0000,0000,,Вьетнам мен Вьетнам арасындағы жағдайдың кенет өзгеруі
Dialogue: 0,0:38:38.04,0:38:39.01,CNsub,NTP,0000,0000,0000,,Иллюзияны көру
Dialogue: 0,0:38:40.14,0:38:45.45,CNsub,NTP,0000,0000,0000,,Бұл қарапайым симптом.
Dialogue: 0,0:38:45.90,0:38:50.33,CNsub,NTP,0000,0000,0000,,Алайда оның себебі заң жоқ.
Dialogue: 0,0:38:50.66,0:38:53.66,CNsub,NTP,0000,0000,0000,,Канояма әңгіме ортасында жапондық зерттеудің себебі
Dialogue: 0,0:38:53.76,0:38:56.24,CNsub,NTP,0000,0000,0000,,Улы аурудың себебі
Dialogue: 0,0:38:56.67,0:38:59.93,CNsub,NTP,0000,0000,0000,,Сондай-ақ Хидео Канояманың өзін-өзі жоюшы екендігі айтылды.
Dialogue: 0,0:39:00.03,0:39:03.01,CNsub,NTP,0000,0000,0000,,Қанша адам қайтыс болды? Қанша адам өлді?
Dialogue: 0,0:39:04.10,0:39:09.30,CNsub,NTP,0000,0000,0000,,Бұл енді қолынан келмейтін адамдар жоқ.
Dialogue: 0,0:39:10.21,0:39:13.75,CNsub,NTP,0000,0000,0000,,Алайда, бұл жағдайда өз еркімен шындық сіз ойлағандай емес...
Dialogue: 0,0:39:17.35,0:39:22.26,CNsub,NTP,0000,0000,0000,,Демек, бұл ұмытылып кеткен басқа адамның ішінара естелігі ғана.
Dialogue: 0,0:39:22.46,0:39:25.10,CNsub,NTP,0000,0000,0000,,Сіз өзіңіздің тәжірибеңізді де көре аласыз
Dialogue: 0,0:39:25.66,0:39:27.10,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:39:29.67,0:39:33.49,CNsub,NTP,0000,0000,0000,,Бұл сіз қалағандай емес.
Dialogue: 0,0:39:44.71,0:39:47.58,CNsub,NTP,0000,0000,0000,,Жақсы нәтиже алыңыз Жақсы нәтиже алыңыз
Dialogue: 0,0:39:48.10,0:39:49.19,CNsub,NTP,0000,0000,0000,,Куротоу Догаку
Dialogue: 0,0:40:11.56,0:40:12.45,CNsub,NTP,0000,0000,0000,,Азолто
Dialogue: 0,0:40:25.34,0:40:27.65,CNsub,NTP,0000,0000,0000,,Талантты екенсің, қара тунг туралы ойлайсың.
Dialogue: 0,0:40:28.43,0:40:32.19,CNsub,NTP,0000,0000,0000,,Оқушылар менің ертегім туралы не айтады, төртінші топ
Dialogue: 0,0:40:32.72,0:40:34.83,CNsub,NTP,0000,0000,0000,,Ешқандай жасырын факті жоқ.
Dialogue: 0,0:40:37.54,0:40:38.60,CNsub,NTP,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:40:39.60,0:40:44.22,CNsub,NTP,0000,0000,0000,,Алайда Но сынағы Жапон тауына келді.
Dialogue: 0,0:40:46.42,0:40:52.05,CNsub,NTP,0000,0000,0000,,Сіздің артыңыздағы шындық
Dialogue: 0,0:40:53.04,0:40:54.93,CNsub,NTP,0000,0000,0000,,Барлық астана – өз елің.
Dialogue: 0,0:40:55.49,0:40:58.45,CNsub,NTP,0000,0000,0000,,Қарсыластың қозғалатын машинасы
Dialogue: 0,0:41:00.72,0:41:04.79,CNsub,NTP,0000,0000,0000,,Дегенмен, сіз сауатты адам болуыңыз керек...
Dialogue: 0,0:41:21.62,0:41:23.76,CNsub,NTP,0000,0000,0000,,Сіз мені көрмейсіз
Dialogue: 0,0:41:26.74,0:41:27.43,CNsub,NTP,0000,0000,0000,,Қайта кездескенше
Dialogue: 0,0:41:31.00,0:41:34.82,CNsub,NTP,0000,0000,0000,,Қандай шындық?
Dialogue: 0,0:41:35.71,0:41:38.52,CNsub,NTP,0000,0000,0000,,Несеп ұстамау
Dialogue: 0,0:41:39.18,0:41:42.01,CNsub,NTP,0000,0000,0000,,Еске түсіру сәті, бақылау сәті
Dialogue: 0,0:41:42.07,0:41:43.74,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:41:44.53,0:41:46.71,CNsub,NTP,0000,0000,0000,,Сіздің ұмытшақтығыңыз да осы санатқа жатады.
Dialogue: 0,0:41:50.00,0:41:51.91,CNsub,NTP,0000,0000,0000,,Қайдасың?
Dialogue: 0,0:41:59.29,0:42:01.46,CNsub,NTP,0000,0000,0000,,Тыныстың қатты босап шығуы
Dialogue: 0,0:42:02.01,0:42:07.79,CNsub,NTP,0000,0000,0000,,Бір нәрсені есіңе түсірсең, оны ұмытасың.
Dialogue: 0,0:42:20.96,0:42:22.12,CNsub,NTP,0000,0000,0000,,Сіз осындасыз
Dialogue: 0,0:42:35.71,0:42:36.48,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:42:49.58,0:42:50.71,CNsub,NTP,0000,0000,0000,,Шындық
Dialogue: 0,0:42:53.29,0:42:54.21,CNsub,NTP,0000,0000,0000,,Шарттар
Dialogue: 0,0:43:20.16,0:43:28.13,CNsub,NTP,0000,0000,0000,,Тағы бір шағын көрініс——
Dialogue: 0,0:43:41.12,0:43:42.74,CNsub,NTP,0000,0000,0000,,Толығымен жойылды және аяқталды
Dialogue: 0,0:44:12.79,0:44:13.57,CNsub,NTP,0000,0000,0000,,Фука
Dialogue: 0,0:44:14.91,0:44:15.84,CNsub,NTP,0000,0000,0000,,Ах-ли
Dialogue: 0,0:44:16.26,0:44:17.58,CNsub,NTP,0000,0000,0000,,Сіз қаладасыз.
Dialogue: 0,0:44:21.06,0:44:22.32,CNsub,NTP,0000,0000,0000,,Қорытынды
Dialogue: 0,0:44:25.33,0:44:26.45,CNsub,NTP,0000,0000,0000,,Жетілу
Dialogue: 0,0:44:42.56,0:44:43.35,CNsub,NTP,0000,0000,0000,,Ерте
Dialogue: 0,0:44:44.66,0:44:46.64,CNsub,NTP,0000,0000,0000,,Сяоцзин
Dialogue: 0,0:44:52.38,0:44:52.84,CNsub,NTP,0000,0000,0000,,Әкесі: Ллойд Форджер, психиатр
Dialogue: 0,0:44:57.24,0:44:59.69,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:45:09.64,0:45:12.68,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:45:13.89,0:45:18.25,CNsub,NTP,0000,0000,0000,,Қайтадан сөйлеу
Dialogue: 0,0:45:18.77,0:45:19.37,CNsub,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:45:22.28,0:45:25.26,CNsub,NTP,0000,0000,0000,,Ная Юйя өте тәжірибелі адам.
Dialogue: 0,0:45:25.62,0:45:28.34,CNsub,NTP,0000,0000,0000,,Бұл жұмыс күш салуға тұрарлық.
Dialogue: 0,0:45:28.42,0:45:29.34,CNsub,NTP,0000,0000,0000,,Әпке?
Dialogue: 0,0:45:31.20,0:45:33.51,CNsub,NTP,0000,0000,0000,,Құдай сөзі·Бірінші мамыр
Dialogue: 0,0:45:34.29,0:45:38.18,CNsub,NTP,0000,0000,0000,,Белгіленген мөрленген сиқыршы келесі жақсы бейне болып табылады.
Dialogue: 0,0:45:38.58,0:45:39.43,CNsub,NTP,0000,0000,0000,,Кішкентай апельсин аруы?
Dialogue: 0,0:45:39.92,0:45:42.27,CNsub,NTP,0000,0000,0000,,Мен туралы шағымданатын сөйлем: «Мен жақсы келісім алдым».
Dialogue: 0,0:45:42.64,0:45:44.95,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:45:58.91,0:46:00.11,CNsub,NTP,0000,0000,0000,,Геге Шикику
Dialogue: 0,0:46:00.68,0:46:02.50,CNsub,NTP,0000,0000,0000,,Соңғы рет шығуға да болады.
Dialogue: 0,0:46:03.38,0:46:04.56,CNsub,NTP,0000,0000,0000,,Сіз бұл туралы естідіңіз.
Dialogue: 0,0:46:06.00,0:46:06.78,CNsub,NTP,0000,0000,0000,,Мұндайды есту өте сирек
Dialogue: 0,0:46:09.71,0:46:11.18,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:46:11.31,0:46:13.62,CNsub,NTP,0000,0000,0000,,Тачибана догаку шолуды білдіреді
Dialogue: 0,0:46:15.33,0:46:17.54,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:46:17.87,0:46:20.28,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:46:20.71,0:46:22.95,CNsub,NTP,0000,0000,0000,,Ережесіз шабуыл
Dialogue: 0,0:46:23.81,0:46:28.73,CNsub,NTP,0000,0000,0000,,Пломбаны жапқаннан кейін
Dialogue: 0,0:46:30.44,0:46:32.03,CNsub,NTP,0000,0000,0000,,Эйя - құрбан
Dialogue: 0,0:46:33.14,0:46:34.57,CNsub,NTP,0000,0000,0000,,Нағыз қайғылы естеліктер
Dialogue: 0,0:46:35.85,0:46:37.40,CNsub,NTP,0000,0000,0000,,Номемороридің әңгімесі жақсы.
Dialogue: 0,0:46:47.03,0:46:47.81,CNsub,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:46:59.83,0:47:01.18,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:47:02.11,0:47:03.47,CNsub,NTP,0000,0000,0000,,Фука қоғамдық көлігі…
Dialogue: 0,0:47:04.65,0:47:06.42,CNsub,NTP,0000,0000,0000,,Салқын және суық
Dialogue: 0,0:47:10.39,0:47:13.28,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:47:13.73,0:47:17.27,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:47:18.03,0:47:20.41,CNsub,NTP,0000,0000,0000,,Падо-са-мён Уджя Холл
Dialogue: 0,0:47:20.73,0:47:21.59,CNsub,NTP,0000,0000,0000,,Алыс қашықтық
Dialogue: 0,0:47:22.18,0:47:25.55,CNsub,NTP,0000,0000,0000,,Бұл жапондық стильдегі бірінші кіреберіс.
Dialogue: 0,0:47:26.73,0:47:28.70,CNsub,NTP,0000,0000,0000,,Сіз өз өтінішіңізден бас тарттыңыз...
Dialogue: 0,0:47:28.97,0:47:31.09,CNsub,NTP,0000,0000,0000,,Назар аударудың қажеті жоқ
Dialogue: 0,0:48:03.93,0:48:05.97,CNsub,NTP,0000,0000,0000,,Мен аз уақытты армандадым
Dialogue: 0,0:48:07.81,0:48:12.50,CNsub,NTP,0000,0000,0000,,Өте маңызды адам өмірден өтті.
Dialogue: 0,0:48:14.61,0:48:16.53,CNsub,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз
Dialogue: 0,0:48:17.81,0:48:21.24,CNsub,NTP,0000,0000,0000,,Дегенмен, басқа бастапқы капиталдар жоғалады.
Dialogue: 0,0:48:26.71,0:48:28.20,CNsub,NTP,0000,0000,0000,,Жылама
Dialogue: 0,0:48:29.07,0:48:31.17,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:48:32.09,0:48:34.42,CNsub,NTP,0000,0000,0000,,Ер адам бала көтере алмай жылау
Dialogue: 0,0:48:36.66,0:48:38.88,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:48:39.50,0:48:41.38,CNsub,NTP,0000,0000,0000,,Жылай да, жылай да алмайды
Dialogue: 0,0:48:42.20,0:48:44.68,CNsub,NTP,0000,0000,0000,,Осыған байланысты жылау ерекше мәселе.
Dialogue: 0,0:48:47.38,0:48:49.86,CNsub,NTP,0000,0000,0000,,Менің жүрегім елжіреп кетті.
Dialogue: 0,0:48:51.58,0:48:55.47,CNsub,NTP,0000,0000,0000,,Қарапайым адамдармен салыстырғанда, басқаларды кездестірмейтін басқалармен салыстырғанда
Dialogue: 0,0:48:55.73,0:48:57.52,CNsub,NTP,0000,0000,0000,,Меймей және кім жұмыс істей алатынын өзара түсіну
Dialogue: 0,0:48:57.67,0:48:59.51,CNsub,NTP,0000,0000,0000,,Кім астананы және басқаларды бақыламауы керек?
Dialogue: 0,0:48:59.83,0:49:01.27,CNsub,NTP,0000,0000,0000,,Бостық пен жалғыздықты сезіну
Dialogue: 0,0:49:04.70,0:49:10.06,CNsub,NTP,0000,0000,0000,,Осы сәтте мен маңызды адам болып келген жерге келдім.
Dialogue: 0,0:49:11.14,0:49:14.75,CNsub,NTP,0000,0000,0000,,Мен де таптырмас адаммын.
Dialogue: 0,0:49:23.09,0:49:26.95,CNsub,NTP,0000,0000,0000,,Жұлдызды аспан астында ағалар да, апалар да жарық жұлдыздарға қарайды
Dialogue: 0,0:49:28.06,0:49:31.17,CNsub,NTP,0000,0000,0000,,Бұл менің есімде қалған көрініс.
Dialogue: 0,0:49:32.65,0:49:37.60,CNsub,NTP,0000,0000,0000,,Содан бері ешқашан мүмкін болмаған алыс өлім туралы арман
Dialogue: 0,0:55:15.97,0:55:17.51,CNsub,NTP,0000,0000,0000,,Мен әлсізмін
Dialogue: 0,0:55:51.15,0:55:53.76,CNsub,NTP,0000,0000,0000,,Өндірістің физикалық әдісі
Dialogue: 0,0:55:54.02,0:55:56.19,CNsub,NTP,0000,0000,0000,,Таңдалған опция
Dialogue: 0,0:55:57.87,0:56:00.03,CNsub,NTP,0000,0000,0000,,Ештеңені жеме
Dialogue: 0,0:56:00.39,0:56:03.53,CNsub,NTP,0000,0000,0000,,Адам құқықтарын жүргізуді аяқтау
Dialogue: 0,0:56:08.38,0:56:11.30,CNsub,NTP,0000,0000,0000,,Насаның оқиғасы қандай?
Dialogue: 0,0:56:13.14,0:56:17.07,CNsub,NTP,0000,0000,0000,,Осыған байланысты бұл табиғи нәрсе
Dialogue: 0,0:56:17.53,0:56:18.52,CNsub,NTP,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:56:18.97,0:56:21.91,CNsub,NTP,0000,0000,0000,,Бұл басқа әңгіме.
Dialogue: 0,0:56:23.92,0:56:25.77,CNsub,NTP,0000,0000,0000,,Мен ерекшемін бе?
Dialogue: 0,0:56:26.30,0:56:27.09,CNsub,NTP,0000,0000,0000,,Ауырды! Өте қатты ауырды! Тоқта, тоқта! Қол тигізбе!
Dialogue: 0,0:56:27.81,0:56:31.06,CNsub,NTP,0000,0000,0000,,Сіздің аты-жөніңіз болмаса
Dialogue: 0,0:56:32.15,0:56:34.51,CNsub,NTP,0000,0000,0000,,Оны да айта кеткен жөн.
Dialogue: 0,0:56:35.47,0:56:38.87,CNsub,NTP,0000,0000,0000,,Әдеттегідей бұл толығымен жойылады.
Dialogue: 0,0:57:10.22,0:57:13.26,CNsub,NTP,0000,0000,0000,,Бір сағаттық үздік нәтиже
Dialogue: 0,0:57:13.99,0:57:16.27,CNsub,NTP,0000,0000,0000,,Таканая шектеулі
Dialogue: 0,0:57:16.70,0:57:20.70,CNsub,NTP,0000,0000,0000,,Өздігінен бастауға қарап, мәнін көріңіз.
Dialogue: 0,0:57:21.30,0:57:25.20,CNsub,NTP,0000,0000,0000,,Тексерілмеген бастаулар
Dialogue: 0,0:57:26.09,0:57:30.22,CNsub,NTP,0000,0000,0000,,Жұмыстан асып түсу қабілеті
Dialogue: 0,0:57:30.68,0:57:33.94,CNsub,NTP,0000,0000,0000,,Еңбектен бөлек өмірлік сипаттар
Dialogue: 0,0:57:34.90,0:57:36.22,CNsub,NTP,0000,0000,0000,,Ойлар
Dialogue: 0,0:57:40.52,0:57:41.94,CNsub,NTP,0000,0000,0000,,Қабылдау келісімі
Dialogue: 0,0:57:42.38,0:57:43.80,CNsub,NTP,0000,0000,0000,,Сіз бірінші адамсыз
Dialogue: 0,0:57:47.16,0:57:48.55,CNsub,NTP,0000,0000,0000,,Бұл... Денемдегі барлық күш-қуат бірден кетіп қалды
Dialogue: 0,0:57:51.49,0:57:55.61,CNsub,NTP,0000,0000,0000,,Сиқыршы Соен Арая
Dialogue: 0,0:57:56.85,0:57:58.01,CNsub,NTP,0000,0000,0000,,Сіздің тегіңіз кім?
Dialogue: 0,0:58:03.45,0:58:04.68,CNsub,NTP,0000,0000,0000,,Нағыз өкініш
Dialogue: 0,0:58:05.13,0:58:09.49,CNsub,NTP,0000,0000,0000,,Жай кейіпкер
Dialogue: 0,0:58:19.29,0:58:22.33,CNsub,NTP,0000,0000,0000,,Сізбен бірге күліп жүріңіз
Dialogue: 0,0:58:22.85,0:58:24.01,CNsub,NTP,0000,0000,0000,,Мен бақыттымын
Dialogue: 0,0:58:25.52,0:58:26.76,CNsub,NTP,0000,0000,0000,,Сіз сенімді бола аласыз
Dialogue: 0,0:58:27.36,0:58:28.35,CNsub,NTP,0000,0000,0000,,Минминг Зенан Джи мазасыздану
Dialogue: 0,0:58:30.58,0:58:33.28,CNsub,NTP,0000,0000,0000,,Жай ғана төте жол
Dialogue: 0,0:58:33.74,0:58:34.80,CNsub,NTP,0000,0000,0000,,Мен ойымды ашуға дайынмын
Dialogue: 0,0:58:36.25,0:58:37.34,CNsub,NTP,0000,0000,0000,,Ноджо Зайикики
Dialogue: 0,0:58:38.10,0:58:39.56,CNsub,NTP,0000,0000,0000,,Мингмингтің жоқтығы Ичиго
Dialogue: 0,0:58:40.71,0:58:41.97,CNsub,NTP,0000,0000,0000,,Нама принципі
Dialogue: 0,0:58:42.63,0:58:43.77,CNsub,NTP,0000,0000,0000,,Түс көрудің жалпы жағдайы
Dialogue: 0,0:58:44.20,0:58:45.41,CNsub,NTP,0000,0000,0000,,Никконың іздері
Dialogue: 0,0:59:02.95,0:59:08.95,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory