Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.05,0:00:14.09,Default,,0,0,0,,Бұл оғаш рух деген не?
Dialogue: 0,0:00:19.03,0:00:23.02,Default,,0,0,0,,Мен қамал ішінен сансыз бұрмаланған рухтарды сезінемін.
Dialogue: 0,0:00:38.05,0:00:39.09,Default,,0,0,0,,Пульсациялау
Dialogue: 0,0:00:40.08,0:00:42.06,Default,,0,0,0,,Бұл жынның шынайы табиғаты ма?
Dialogue: 0,0:00:48.07,0:00:50.05,Default,,0,0,0,,Менің айналамда жындар көп
Dialogue: 0,0:00:50.05,0:00:52.02,Default,,0,0,0,,Жынның жақындағанын да байқамайсың ба?
Dialogue: 0,0:00:54.05,0:00:55.09,Default,,0,0,0,,Бұл қиын трюк.
Dialogue: 0,0:01:35.02,0:01:36.05,Default,,0,0,0,,Қаш
Dialogue: 0,0:01:36.05,0:01:38.02,Default,,0,0,0,,Қашпа
Dialogue: 0,0:02:47.08,0:02:48.05,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:02:50.08,0:02:53.02,Default,,0,0,0,,Бұл үлкен жын
Dialogue: 0,0:02:59.04,0:03:00.06,Default,,0,0,0,,Наре
Dialogue: 0,0:03:00.06,0:03:02.08,Default,,0,0,0,,Не болды? Мүмкін емес.
Dialogue: 0,0:03:02.08,0:03:05.03,Default,,0,0,0,,Бұл еркек емес шығар.
Dialogue: 0,0:03:05.05,0:03:09.05,Default,,0,0,0,,Ер болсаң, құнсыз, қызықсыз.
Dialogue: 0,0:03:10.04,0:03:11.07,Default,,0,0,0,,Маа, жоқ.
Dialogue: 0,0:03:11.07,0:03:13.06,Default,,0,0,0,,Тек қабығын алып тастасаңыз, түсінесіз.
Dialogue: 0,0:03:14.07,0:03:15.08,Default,,0,0,0,,Бұл
Dialogue: 0,0:03:15.08,0:03:19.06,Default,,0,0,0,,Ол жол тар, мен қозғала алмаймын.
Dialogue: 0,0:03:22.05,0:03:24.05,Default,,0,0,0,,...
Dialogue: 0,0:03:24.06,0:03:27.00,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:03:27.00,0:03:29.02,Default,,0,0,0,,Сіз осындасыз.
Dialogue: 0,0:03:34.05,0:03:37.02,Default,,0,0,0,,Себебі мен қозғала алмаймын
Dialogue: 0,0:03:39.06,0:03:41.08,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:03:49.00,0:03:52.01,Default,,0,0,0,,Қылыш семсерін тастаса, не істер еді?
Dialogue: 0,0:03:52.01,0:03:52.51,Default,,0,0,0,,Бұл
Dialogue: 0,0:03:55.06,0:03:57.05,Default,,0,0,0,,Бұл қақпан, Барса.
Dialogue: 0,0:03:57.08,0:03:58.07,Default,,0,0,0,,Бұл да
Dialogue: 0,0:04:04.06,0:04:06.06,Default,,0,0,0,,Мен мұны көп жасаймын.
Dialogue: 0,0:04:06.06,0:04:08.04,Default,,0,0,0,,Даффқа ештеңе берме
Dialogue: 0,0:04:08.04,0:04:11.01,Default,,0,0,0,,Мені өзіңізбен бірге алып келгеніңізді қалаймын.
Dialogue: 0,0:04:11.07,0:04:12.05,Default,,0,0,0,,Сіздің
Dialogue: 0,0:04:13.06,0:04:15.08,Default,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:04:15.08,0:04:17.00,Default,,0,0,0,,Құпия
Dialogue: 0,0:04:17.05,0:04:20.07,Default,,0,0,0,,Оянып, дос болған кезде айтамын.
Dialogue: 0,0:04:20.07,0:04:22.00,Default,,0,0,0,,Ой, осы белдікті киіп тұрғанда мұны істей алмаймын.
Dialogue: 0,0:04:22.05,0:04:25.03,Default,,0,0,0,,Құбыжық деген кім?
Dialogue: 0,0:04:27.04,0:04:29.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:04:29.04,0:04:32.08,Default,,0,0,0,,Өйткені қарапайым адамның көзқарасымен қарасаңыз,
Dialogue: 0,0:04:32.08,0:04:33.08,Default,,0,0,0,,Құбыжық емес
Dialogue: 0,0:04:35.02,0:04:37.07,Default,,0,0,0,,Оянған адамдар және жартылай адам және жартылай жындар
Dialogue: 0,0:04:37.07,0:04:40.01,Default,,0,0,0,,Шындығында, мұның көп айырмашылығы жоқ.
Dialogue: 0,0:04:40.01,0:04:43.03,Default,,0,0,0,,Бұл жай ғана сіздің санаңыздың қайда екендігі туралы мәселе.
Dialogue: 0,0:04:44.00,0:04:46.05,Default,,0,0,0,,Бірақ екеуі де адам емес.
Dialogue: 0,0:04:46.08,0:04:48.03,Default,,0,0,0,,Бұл шындық
Dialogue: 0,0:04:53.00,0:04:55.00,Default,,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:04:55.05,0:04:58.01,Default,,0,0,0,,Мүмкін мен де сол құбыжық шығармын.
Dialogue: 0,0:04:58.07,0:05:02.00,Default,,0,0,0,,Бірақ мен адам болып туылғаннан бері,
Dialogue: 0,0:05:02.04,0:05:03.08,Default,,0,0,0,,Адам болып өмір сүру
Dialogue: 0,0:05:03.08,0:05:05.04,Default,,0,0,0,,Мен адам болып өлгім келеді
Dialogue: 0,0:05:06.00,0:05:08.02,Default,,0,0,0,,Бұл менің шындығым
Dialogue: 0,0:05:09.00,0:05:12.02,Default,,0,0,0,,Маған сен сияқты адамдар ұнайды.
Dialogue: 0,0:05:12.05,0:05:16.06,Default,,0,0,0,,Өйткені, мен сенімен дос болғым келді.
Dialogue: 0,0:05:20.05,0:05:21.08,Default,,0,0,0,,te te te
Dialogue: 0,0:05:21.08,0:05:26.03,Default,,0,0,0,,Жаңа ғана қолданғаным өте тиімді болды.
Dialogue: 0,0:05:26.08,0:05:27.05,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:05:28.03,0:05:30.09,Default,,0,0,0,,Жылдам семсердің тиюі
Dialogue: 0,0:05:30.09,0:05:32.05,Default,,0,0,0,,Мен сені кешірмеймін
Dialogue: 0,0:05:38.04,0:05:39.09,Default,,0,0,0,,Жапон көздері
Dialogue: 0,0:05:46.05,0:05:47.06,Default,,0,0,0,,Сүйектер
Dialogue: 0,0:05:49.08,0:05:51.09,Default,,0,0,0,,Кесілген нәрсені жабыстырудан гөрі
Dialogue: 0,0:05:51.09,0:05:55.09,Default,,0,0,0,,Мазмұны жарылған болса, оны емдеу қиынырақ болар еді.
Dialogue: 0,0:06:00.04,0:06:03.07,Default,,0,0,0,,Олай болса, қабығын аршып алайық.
Dialogue: 0,0:06:03.08,0:06:07.03,Default,,0,0,0,,Бұл еркек пе? Әйел бе?
Dialogue: 0,0:06:08.00,0:06:09.06,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:06:11.02,0:06:15.02,Default,,0,0,0,,Мен бақытты болдым, өйткені мен оны тез таптым.
Dialogue: 0,0:06:16.05,0:06:21.06,Default,,0,0,0,,Бұл жағдайда не істеуім керек?
Dialogue: 0,0:06:23.02,0:06:27.06,Default,,0,0,0,,Осылай келген соң құр қол кете алмаймын.
Dialogue: 0,0:06:27.06,0:06:29.03,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:29.03,0:06:32.02,Default,,0,0,0,,Қылышымды да суырмасам, өлемін.
Dialogue: 0,0:06:35.04,0:06:36.03,Default,,0,0,0,,Бұл белгі
Dialogue: 0,0:06:37.00,0:06:39.03,Default,,0,0,0,,№3 Калатея
Dialogue: 0,0:06:40.01,0:06:41.01,Default,,0,0,0,,Неге мұнда?
Dialogue: 0,0:06:41.06,0:06:43.03,Default,,0,0,0,,Менің артымнан келдің бе?
Dialogue: 0,0:06:44.07,0:06:45.06,Default,,0,0,0,,О.
Dialogue: 0,0:06:46.04,0:06:50.01,Default,,0,0,0,,Бұл жолы өте күшті адам келді.
Dialogue: 0,0:06:51.05,0:06:53.05,Default,,0,0,0,,Өйткені ойнайтын адамдар көп
Dialogue: 0,0:06:53.05,0:06:55.08,Default,,0,0,0,,Менің ойымша, мен бұл жігітті қазірдің өзінде талқандауым керек.
Dialogue: 0,0:07:02.09,0:07:03.06,Default,,0,0,0,,Бұл
Dialogue: 0,0:07:07.02,0:07:09.01,Default,,0,0,0,,Ол көрінгеннен жеңіл
Dialogue: 0,0:07:09.01,0:07:10.07,Default,,0,0,0,,Тамақты көбірек жеңіз
Dialogue: 0,0:07:12.01,0:07:14.05,Default,,0,0,0,,Бұл маған керек.
Dialogue: 0,0:07:14.08,0:07:17.01,Default,,0,0,0,,Кешіріңіз, кешіріңіз.
Dialogue: 0,0:07:18.01,0:07:19.03,Default,,0,0,0,,Жеңіл қабылдамаңыз
Dialogue: 0,0:07:19.03,0:07:20.00,Default,,0,0,0,,Жігіт
Dialogue: 0,0:07:25.07,0:07:27.06,Default,,0,0,0,,Бұл алғашқы «Глория».
Dialogue: 0,0:07:27.06,0:07:30.00,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:07:30.07,0:07:32.08,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:07:35.04,0:07:36.04,Default,,0,0,0,,Не?
Dialogue: 0,0:07:36.04,0:07:38.02,Default,,0,0,0,,Неліктен жұмыс істемеді?
Dialogue: 0,0:07:40.05,0:07:43.01,Default,,0,0,0,,Шабуылдар автоматты түрде ауытқиды
Dialogue: 0,0:07:43.01,0:07:44.05,Default,,0,0,0,,Соған қарамастан, бұл түтін неге осынша көп?
Dialogue: 0,0:07:50.03,0:07:51.06,Default,,0,0,0,,Ой
Dialogue: 0,0:07:51.07,0:07:54.09,Default,,0,0,0,,Қолдауға болатын басы бар сияқты.
Dialogue: 0,0:07:55.03,0:07:56.05,Default,,0,0,0,,Сәлем
Dialogue: 0,0:07:56.05,0:07:58.01,Default,,0,0,0,,Мені мазақ ет
Dialogue: 0,0:07:58.01,0:08:00.00,Default,,0,0,0,,Ол енді тегін емес.
Dialogue: 0,0:08:00.05,0:08:02.00,Default,,0,0,0,,Э? Қайда?
Dialogue: 0,0:08:02.00,0:08:03.04,Default,,0,0,0,,Жалаңаш
Dialogue: 0,0:08:03.04,0:08:04.08,Default,,0,0,0,,Аяқ-қолды тартыңыз
Dialogue: 0,0:08:04.08,0:08:07.00,Default,,0,0,0,,Ішін жұлып алған соң мазақ ету
Dialogue: 0,0:08:07.00,0:08:08.04,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:08:09.01,0:08:12.02,Default,,0,0,0,,Мұнда аяғыңызды емдеуге болады.
Dialogue: 0,0:08:13.09,0:08:19.09,Default,,0,0,0,,Бірақ мен сенен де көп бейбақтармен күресуді жоспарладым.
Dialogue: 0,0:08:21.01,0:08:22.05,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:08:22.05,0:08:24.09,Default,,0,0,0,,Оның қаттылығы соншалық, оған қылыш тимейді.
Dialogue: 0,0:08:24.09,0:08:26.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:26.00,0:08:27.03,Default,,0,0,0,,Бұл емес
Dialogue: 0,0:08:28.06,0:08:31.01,Default,,0,0,0,,Төмендегі екіншісі туралы.
Dialogue: 0,0:08:31.08,0:08:34.05,Default,,0,0,0,,Өлемін деп ойладың ба?
Dialogue: 0,0:08:36.01,0:08:39.05,Default,,0,0,0,,Ол өзінің жындарын сұмдық және шебер жасырады, бірақ
Dialogue: 0,0:08:39.08,0:08:41.04,Default,,0,0,0,,Толқын ұзындықтарын сәйкестендірсек
Dialogue: 0,0:08:41.04,0:08:43.07,Default,,0,0,0,,Сіз оны да таба білуіңіз керек.
Dialogue: 0,0:08:45.04,0:08:47.06,Default,,0,0,0,,Егер шабуыл соқпаса
Dialogue: 0,0:08:47.06,0:08:49.07,Default,,0,0,0,,Тек соғылғанына көз жеткізіңіз.
Dialogue: 0,0:08:50.01,0:08:54.03,Default,,0,0,0,,Ішіңді жұлып, мені мазақ етпедің бе?
Dialogue: 0,0:08:54.03,0:08:56.07,Default,,0,0,0,,А, сіз нені айтып тұрсыз?
Dialogue: 0,0:08:58.05,0:08:59.04,Default,,0,0,0,,Галатея
Dialogue: 0,0:08:59.04,0:09:03.03,Default,,0,0,0,,Уақытың болған соң, ақымақ.
Dialogue: 0,0:09:06.03,0:09:07.00,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:08.08,0:09:12.06,Default,,0,0,0,,Мен сіздің миыңызды белсенді зат алмасуына қызғанамын.
Dialogue: 0,0:09:20.02,0:09:21.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:09:21.06,0:09:25.04,Default,,0,0,0,,Қалыпты шабуылмен тіпті сыртқы теріге де өте алмайсыз ба?
Dialogue: 0,0:09:26.07,0:09:27.06,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:09:35.02,0:09:39.05,Default,,0,0,0,,Сырт тері қатты делінсе де, орнына байланысты айырмашылықтары бар сияқты.
Dialogue: 0,0:09:44.03,0:09:45.07,Default,,0,0,0,,Сәлем
Dialogue: 0,0:09:49.07,0:09:50.08,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:51.03,0:09:55.07,Default,,0,0,0,,Аяқ-қолыммен бірінші болып күрескен сияқтымын.
Dialogue: 0,0:09:59.09,0:10:02.04,Default,,0,0,0,,Бұл 3 санының дәрежесі
Dialogue: 0,0:10:03.01,0:10:06.08,Default,,0,0,0,,Бұл басқа адам өз еркіне сай әрекет ету сияқты.
Dialogue: 0,0:10:09.03,0:10:13.01,Default,,0,0,0,,Сен, сен, сен, сен.
Dialogue: 0,0:10:13.01,0:10:15.02,Default,,0,0,0,,Жылама, шіркін
Dialogue: 0,0:10:15.02,0:10:17.07,Default,,0,0,0,,Сенің шіркін түрленеді.
Dialogue: 0,0:10:18.08,0:10:20.02,Default,,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:10:21.04,0:10:23.09,Default,,0,0,0,,Ол жігіт шынымен ақымақ екен.
Dialogue: 0,0:10:25.01,0:10:28.01,Default,,0,0,0,,Сіз ерте шықтыңыз.
Dialogue: 0,0:10:33.05,0:10:35.01,Default,,0,0,0,,Кішкене дуф
Dialogue: 0,0:10:35.01,0:10:37.00,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:10:37.00,0:10:39.01,Default,,0,0,0,,Сондықтан қанша уақыт өтсе де
Dialogue: 0,0:10:39.01,0:10:42.02,Default,,0,0,0,,Сен де менің адамым деп мақтана алмайсың.
Dialogue: 0,0:10:42.02,0:10:45.09,Default,,0,0,0,,Өйткені бұл жігіт мүлде соққыға ұшырамайды.
Dialogue: 0,0:10:45.09,0:10:46.09,Default,,0,0,0,,Сонымен
Dialogue: 0,0:10:46.09,0:10:49.00,Default,,0,0,0,,Бұлай болмауы мүмкін емес.
Dialogue: 0,0:10:49.00,0:10:50.04,Default,,0,0,0,,Сен ақымақ емессің бе?
Dialogue: 0,0:10:50.04,0:10:52.01,Default,,0,0,0,,(Фушигиро) Неге мұнда жүрсің, Зэн'ин-сенпай?
Dialogue: 0,0:10:52.01,0:10:53.06,Default,,0,0,0,,Сондықтан мен
Dialogue: 0,0:10:55.03,0:10:59.03,Default,,0,0,0,,Ал, мен сізге қалай анық соққы беру керектігін көрсетемін.
Dialogue: 0,0:10:59.03,0:11:01.03,Default,,0,0,0,,Келесі жолы дұрыс болжаңыз.
Dialogue: 0,0:11:01.03,0:11:02.06,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:11:03.01,0:11:05.09,Default,,0,0,0,,Бар күш-қуатыңызды арнаңыз.
Dialogue: 0,0:11:08.01,0:11:09.09,Default,,0,0,0,,Кенже
Dialogue: 0,0:11:09.09,0:11:12.08,Default,,0,0,0,,Мен біраз уақыттан бері қолымнан келгеннің бәрін істеп жүрмін.
Dialogue: 0,0:11:12.08,0:11:15.01,Default,,0,0,0,,Бұл да мүлде дұрыс емес.
Dialogue: 0,0:11:15.01,0:11:17.01,Default,,0,0,0,,Тек мұны жасамаңыз.
Dialogue: 0,0:11:17.01,0:11:18.04,Default,,0,0,0,,Сізге айтайын
Dialogue: 0,0:11:18.04,0:11:20.07,Default,,0,0,0,,Осы жолы жеңілсем, сенімен айырылысып кетем.
Dialogue: 0,0:11:20.07,0:11:23.02,Default,,0,0,0,,Міне солай
Dialogue: 0,0:11:24.08,0:11:26.04,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:11:29.04,0:11:31.03,Default,,0,0,0,,Темено
Dialogue: 0,0:11:31.03,0:11:33.08,Default,,0,0,0,,Бұл Теменің кінәсі.
Dialogue: 0,0:11:33.08,0:11:34.09,Default,,0,0,0,,Кусога
Dialogue: 0,0:11:36.09,0:11:39.09,Default,,0,0,0,,Жарайды, мен оны бұл жолы алған жоқпын.
Dialogue: 0,0:11:47.02,0:11:48.05,Default,,0,0,0,,Галатея
Dialogue: 0,0:11:48.05,0:11:51.06,Default,,0,0,0,,Иә, бұл жақсы, Дафф.
Dialogue: 0,0:11:51.06,0:11:53.03,Default,,0,0,0,,Егер сіз мұны басынан бастап жасасаңыз
Dialogue: 0,0:11:53.03,0:11:55.06,Default,,0,0,0,,Мен бір қолымды жоғалттым.
Dialogue: 0,0:11:55.06,0:11:56.04,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:11:56.08,0:11:57.08,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:11:57.09,0:12:00.01,Default,,0,0,0,,Мен ештеңе істеген жоқпын.
Dialogue: 0,0:12:00.06,0:12:04.01,Default,,0,0,0,,Ол басқа адамның жындарын басқара алады.
Dialogue: 0,0:12:05.02,0:12:06.00,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:12:07.05,0:12:09.03,Default,,0,0,0,,Хонның ойнау деңгейі
Dialogue: 0,0:12:10.01,0:12:13.02,Default,,0,0,0,,Мінез-құлықтың өзін тоқтату мүмкін емес.
Dialogue: 0,0:12:13.02,0:12:17.03,Default,,0,0,0,,Сонымен Даффтың ашулы шабуылы
Dialogue: 0,0:12:17.03,0:12:20.00,Default,,0,0,0,,Ол ештеңе істей алмайды.
Dialogue: 0,0:12:25.02,0:12:26.07,Default,,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі, аулақ болыңыз
Dialogue: 0,0:12:28.07,0:12:30.07,Default,,0,0,0,,Мен түсіндім, алдым
Dialogue: 0,0:12:30.07,0:12:33.01,Default,,0,0,0,,Енді қайда көздеуім керек?
Dialogue: 0,0:12:34.06,0:12:36.06,Default,,0,0,0,,Бұл ойын.
Dialogue: 0,0:12:40.00,0:12:41.03,Default,,0,0,0,,О сен
Dialogue: 0,0:12:41.03,0:12:45.03,Default,,0,0,0,,Екі аяқты сауықтыру үшін сиқырлы күш жіберсе жақсы болар еді.
Dialogue: 0,0:12:45.03,0:12:47.04,Default,,0,0,0,,Бұл шектен тыс.
Dialogue: 0,0:12:49.01,0:12:51.01,Default,,0,0,0,,Келесі - кенеттен бас
Dialogue: 0,0:12:54.09,0:12:55.07,Default,,0,0,0,,Бұл
Dialogue: 0,0:13:00.08,0:13:01.06,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:13:04.06,0:13:05.08,Default,,0,0,0,,Артыңа шегін!
Dialogue: 0,0:13:05.08,0:13:06.07,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:13:06.07,0:13:07.07,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:13:08.00,0:13:09.00,Default,,0,0,0,,Артыңа шегін!
Dialogue: 0,0:13:09.07,0:13:11.00,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:13:11.00,0:13:11.50,Default,,0,0,0,,Дафф күтіңіз
Dialogue: 0,0:13:16.04,0:13:18.05,Default,,0,0,0,,Артыңа шегін!
Dialogue: 0,0:13:24.09,0:13:26.05,Default,,0,0,0,,Жақында
Dialogue: 0,0:13:27.09,0:13:29.08,Default,,0,0,0,,Жоқ, жоқ, артық емес
Dialogue: 0,0:13:45.02,0:13:46.03,Default,,0,0,0,,И-иә… рас. Менің ағамдай… деп ойлаймын
Dialogue: 0,0:13:47.07,0:13:49.03,Default,,0,0,0,,Оны шынымен қайтаруға бола ма?
Dialogue: 0,0:13:50.00,0:13:52.04,Default,,0,0,0,,Енді сіз Галатеясыз.
Dialogue: 0,0:13:52.08,0:13:55.02,Default,,0,0,0,,Мен оны жаңа ғана осы жағына тарттым.
Dialogue: 0,0:13:55.07,0:13:57.04,Default,,0,0,0,,Ұйымдар назар аударады
Dialogue: 0,0:13:57.04,0:13:59.06,Default,,0,0,0,,Айналаңа көз салсаң болғаны.
Dialogue: 0,0:14:00.02,0:14:01.09,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:14:05.00,0:14:07.01,Default,,0,0,0,,Не?
Dialogue: 0,0:14:07.01,0:14:09.06,Default,,0,0,0,,Мен сені оянады деп ойладым.
Dialogue: 0,0:14:10.05,0:14:13.02,Default,,0,0,0,,Елестерді басқара алатын үздік нөмір болыңыз
Dialogue: 0,0:14:13.02,0:14:16.03,Default,,0,0,0,,Өз шегінен асып кетсе де қайтып орала алатын жұмбақ жауынгер.
Dialogue: 0,0:14:16.08,0:14:18.01,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:14:18.07,0:14:22.09,Default,,0,0,0,,Екеуіңе менің тобыма қосылуға рұқсат етемін.
Dialogue: 0,0:14:24.03,0:14:28.04,Default,,0,0,0,,Бұл үлкен, зұлым рух деген не?
Dialogue: 0,0:14:29.00,0:14:32.04,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:14:34.03,0:14:37.00,Default,,0,0,0,,Жауынгерлеріміздің ұзақ тарихында
Dialogue: 0,0:14:37.08,0:14:42.04,Default,,0,0,0,,№1 оятудың ең нашар үш жағдайы бар.
Dialogue: 0,0:14:43.01,0:14:45.01,Default,,0,0,0,,Адамзат дәуіріндегі жалғыз
Dialogue: 0,0:14:45.01,0:14:47.02,Default,,0,0,0,,Әйелдер жасындағы екі адам
Dialogue: 0,0:14:48.07,0:14:51.00,Default,,0,0,0,,Олар үш күшті деп аталады
Dialogue: 0,0:14:51.00,0:14:54.04,Default,,0,0,0,,Оянғандардың қожасы болды.
Dialogue: 0,0:14:54.04,0:14:55.08,Default,,0,0,0,,Жан-жақтан шашылған
Dialogue: 0,0:14:56.04,0:14:59.04,Default,,0,0,0,,Солтүстікке, батысқа және оңтүстікке қарай
Dialogue: 0,0:15:00.00,0:15:02.05,Default,,0,0,0,,Өйткені біз екеуіміз де күшті білдік
Dialogue: 0,0:15:02.05,0:15:04.05,Default,,0,0,0,,Бұл қажетсіз жанжалдан аулақ болды.
Dialogue: 0,0:15:06.06,0:15:07.09,Default,,0,0,0,,бастап олар
Dialogue: 0,0:15:07.09,0:15:10.01,Default,,0,0,0,,Ашық көрініссіз
Dialogue: 0,0:15:10.01,0:15:13.01,Default,,0,0,0,,Сондай-ақ Абиссалды деп аталады
Dialogue: 0,0:15:13.01,0:15:14.06,Default,,0,0,0,,Бірінші абиссаль
Dialogue: 0,0:15:16.01,0:15:17.02,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:15:17.07,0:15:21.00,Default,,0,0,0,,Батыстың Абиссалды Бір Рифул
Dialogue: 0,0:15:21.08,0:15:24.01,Default,,0,0,0,,Батыс мылтық
Dialogue: 0,0:15:24.07,0:15:28.01,Default,,0,0,0,,Ұйымның жауынгер әйелі, бірінші нөмірлі.
Dialogue: 0,0:15:28.07,0:15:31.09,Default,,0,0,0,,Ол сол кездегі ең кенжесі болып, нүктені меңгерген.
Dialogue: 0,0:15:31.09,0:15:34.05,Default,,0,0,0,,Сол билікті босатқан жауынгер
Dialogue: 0,0:15:35.00,0:15:38.00,Default,,0,0,0,,Сен әлі жассың, бірақ көп нәрсені білесің.
Dialogue: 0,0:15:38.03,0:15:40.05,Default,,0,0,0,,Бірақ сіз аздап қателесесіз.
Dialogue: 0,0:15:41.01,0:15:45.02,Default,,0,0,0,,Біз жанжалдан аулақ болғымыз келген сияқты емес.
Dialogue: 0,0:15:45.05,0:15:49.05,Default,,0,0,0,,Тек біз кездейсоқ жеткен орындар бір-біріне сәйкес келмеді.
Dialogue: 0,0:15:51.05,0:15:54.02,Default,,0,0,0,,Неліктен ол жақында қозғала бастады?
Dialogue: 0,0:15:54.05,0:15:56.00,Default,,0,0,0,,Сіз жалғыз емессіз
Dialogue: 0,0:15:56.00,0:15:58.01,Default,,0,0,0,,Сондай-ақ екеуі бар, біреуі солтүстікте, екіншісі оңтүстікте.
Dialogue: 0,0:15:59.02,0:16:03.07,Default,,0,0,0,,Олардың әрқайсысы әр жерден оянған адамдарды өз қатарына тарта бастады.
Dialogue: 0,0:16:04.05,0:16:08.03,Default,,0,0,0,,Балалар, сендер не істемексіңдер?
Dialogue: 0,0:16:08.03,0:16:12.00,Default,,0,0,0,,Менімен солтүстіктен бір адам төбелесті.
Dialogue: 0,0:16:12.07,0:16:18.08,Default,,0,0,0,,Әйтеуір сол әйелді алғаннан кейін солтүстіктің жігіті еріп кетті.
Dialogue: 0,0:16:18.08,0:16:20.00,Default,,0,0,0,,Сол әйел
Dialogue: 0,0:16:20.07,0:16:24.09,Default,,0,0,0,,Солтүстік елде өз қалауынша шапқылап жүрген оянған адам.
Dialogue: 0,0:16:25.02,0:16:27.00,Default,,0,0,0,,Бір мүйізді әйел
Dialogue: 0,0:16:27.00,0:16:27.50,Default,,0,0,0,,Прискила
Dialogue: 0,0:16:28.06,0:16:29.03,Default,,0,0,0,,Маа
Dialogue: 0,0:16:29.03,0:16:30.08,Default,,0,0,0,,Менің де бос уақытым бар.
Dialogue: 0,0:16:30.08,0:16:32.07,Default,,0,0,0,,Мен бұл жекпе-жекті сатып алуды шештім.
Dialogue: 0,0:16:33.09,0:16:37.01,Default,,0,0,0,,Енді мен әртүрлі бөлшектерді жинап жатырмын.
Dialogue: 0,0:16:37.06,0:16:39.08,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:16:40.02,0:16:41.01,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:16:42.05,0:16:43.05,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:16:43.05,0:16:45.06,Default,,0,0,0,,Даусыңыз өте кішкентай, мен оны естімеймін.
Dialogue: 0,0:16:47.06,0:16:50.02,Default,,0,0,0,,Солтүстіктің атын айт.
Dialogue: 0,0:16:50.02,0:16:53.05,Default,,0,0,0,,Мен ол әйелді өлтіремін.
Dialogue: 0,0:16:53.05,0:16:56.01,Default,,0,0,0,,О, мен ол қызды білемін.
Dialogue: 0,0:16:56.03,0:16:58.02,Default,,0,0,0,,Көп сөйлеме
Dialogue: 0,0:16:58.06,0:17:02.07,Default,,0,0,0,,Маған солтүстіктен келген адамның аты-жөнін, қайда екенін айтсаңыз болғаны.
Dialogue: 0,0:17:03.03,0:17:05.05,Default,,0,0,0,,Сіз өте сөйлейтінсіз.
Dialogue: 0,0:17:05.08,0:17:07.02,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:08.00,0:17:12.07,Default,,0,0,0,,Маған бір соққы болса да, мен сізге хабарлаймын.
Dialogue: 0,0:17:17.02,0:17:19.07,Default,,0,0,0,,Кешіріңіз, бұл ұят болды.
Dialogue: 0,0:17:22.05,0:17:23.03,Default,,0,0,0,,Жоғарыда
Dialogue: 0,0:17:29.01,0:17:31.07,Default,,0,0,0,,Бұл сұмдық
Dialogue: 0,0:17:34.03,0:17:36.01,Default,,0,0,0,,Сәлем Қара, қара!
Dialogue: 0,0:17:36.01,0:17:38.05,Default,,0,0,0,,Бұл ауыратын уақыт емес.
Dialogue: 0,0:17:41.00,0:17:44.01,Default,,0,0,0,,Алданба, ақымақ.
Dialogue: 0,0:17:45.04,0:17:47.07,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:47.07,0:17:50.03,Default,,0,0,0,,шектен соқыр түрде асып кетудің орнына
Dialogue: 0,0:17:50.03,0:17:55.08,Default,,0,0,0,,Ашық ниетпен кесіп өткенде күшіңіз бен жылдамдығыңыз арта түсетін сияқты.
Dialogue: 0,0:18:08.09,0:18:12.03,Default,,0,0,0,,Енді мен сіздің сұрағыңызға жауап берейін.
Dialogue: 0,0:18:12.09,0:18:17.00,Default,,0,0,0,,Әй, мен әлі қиылған жоқпын.
Dialogue: 0,0:18:17.00,0:18:19.01,Default,,0,0,0,,Егер сіз сонша өлгіңіз келсе
Dialogue: 0,0:18:19.01,0:18:20.08,Default,,0,0,0,,Мен сенің қалағаныңды істеймін
Dialogue: 0,0:18:23.07,0:18:26.05,Default,,0,0,0,,Ол көп көңіл бөлуді қажет ететін проблемалық бала.
Dialogue: 0,0:18:35.05,0:18:38.08,Default,,0,0,0,,Бұл сәл көбірек болды
Dialogue: 0,0:18:38.08,0:18:39.06,Default,,0,0,0,,Өте жаман
Dialogue: 0,0:18:43.08,0:18:45.02,Default,,0,0,0,,Мен не істеймін?
Dialogue: 0,0:18:45.07,0:18:48.01,Default,,0,0,0,,Біз оларға қосыла жаздадық.
Dialogue: 0,0:18:48.07,0:18:53.01,Default,,0,0,0,,Бұл жай ғана олардың ойы, мысалы, жеңіл арандатушылықты пайдаланып, ояту.
Dialogue: 0,0:18:56.09,0:18:58.09,Default,,0,0,0,,Мен бұл үлкен нәрсені өлтіремін.
Dialogue: 0,0:18:59.07,0:19:02.05,Default,,0,0,0,,Тұңғиық жұртында соғысуға ерік-жігері болмаса
Dialogue: 0,0:19:02.05,0:19:04.06,Default,,0,0,0,,Бізде әлі де мүмкіндік бар
Dialogue: 0,0:19:05.03,0:19:08.09,Default,,0,0,0,,Ол үшін бір адамның күші өте қажет.
Dialogue: 0,0:19:09.05,0:19:10.05,Default,,0,0,0,,Басқа адам
Dialogue: 0,0:19:10.09,0:19:14.06,Default,,0,0,0,,Күшті денесіне қылыш қадалған адам.
Dialogue: 0,0:19:15.05,0:19:17.05,Default,,0,0,0,,Төмендегі 9 саны
Dialogue: 0,0:19:17.05,0:19:19.06,Default,,0,0,0,,Мен Жанның күшін қалаймын
Dialogue: 0,0:19:19.06,0:19:22.01,Default,,0,0,0,,9 саны ген
Dialogue: 0,0:19:22.01,0:19:25.03,Default,,0,0,0,,Бірақ ол өте тұрақсыз күйде.
Dialogue: 0,0:19:25.08,0:19:28.00,Default,,0,0,0,,Ол кез келген уақытта оянуы мүмкін.
Dialogue: 0,0:19:28.07,0:19:33.05,Default,,0,0,0,,Ол физикалық жағынан да, рухани жағынан да көп зардап шексе керек.
Dialogue: 0,0:19:33.09,0:19:38.06,Default,,0,0,0,,Оның жеке басын ескере отырып, ол оятудан гөрі өлімді таңдар еді.
Dialogue: 0,0:19:39.01,0:19:42.01,Default,,0,0,0,,Бұған жағдай мүмкіндік бермесе керек.
Dialogue: 0,0:19:43.04,0:19:45.02,Default,,0,0,0,,Мен мұнымен айналысамын.
Dialogue: 0,0:19:45.06,0:19:47.09,Default,,0,0,0,,Жанды құтқаруға бару керек.
Dialogue: 0,0:19:48.07,0:19:51.06,Default,,0,0,0,,Ал егер тым кеш болса
Dialogue: 0,0:19:52.02,0:19:54.08,Default,,0,0,0,,Сіз Джиннің өмірін аяқтайсыз.
Dialogue: 0,0:19:55.06,0:19:56.02,Default,,0,0,0,,Уууууууу!!
Dialogue: 0,0:19:56.02,0:19:57.04,Default,,0,0,0,,Менің уақытым жоқ
Dialogue: 0,0:19:59.00,0:20:00.09,Default,,0,0,0,,Қашып кеткіңіз келе ме?
Dialogue: 0,0:20:01.09,0:20:03.00,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:20:05.01,0:20:05.51,Default,,0,0,0,,Сәлем
Dialogue: 0,0:20:06.04,0:20:09.01,Default,,0,0,0,,Қал, қал, бұрынғыдан ұзағырақ қал.
Dialogue: 0,0:20:26.00,0:20:26.50,Default,,0,0,0,,Ген
Dialogue: 0,0:20:34.05,0:20:36.01,Default,,0,0,0,,Тема
Dialogue: 0,0:20:36.03,0:20:38.09,Default,,0,0,0,,Бұл менің сұлулық сезіміме қайшы келеді.
Dialogue: 0,0:20:38.09,0:20:41.03,Default,,0,0,0,,Мен мұны істегім келмейді.
Dialogue: 0,0:20:46.01,0:20:53.06,Default,,0,0,0,,Сиқырлы қуатты босатқанда күштің арту қарқыны 47 адам арасында ең жоғары екені айтылады.
Dialogue: 0,0:20:54.02,0:20:59.03,Default,,0,0,0,,Кешіріңіз, бірақ мен бұл ұсқынсыз фигураны біраз уақытқа қалдыруым керек.
Dialogue: 0,0:20:59.03,0:21:02.08,Default,,0,0,0,,Эй, сен қалжыңдап тұрсың.
Dialogue: 0,0:21:02.08,0:21:04.06,Default,,0,0,0,,Мен сені енді кешірмеймін
Dialogue: 0,0:21:05.01,0:21:06.09,Default,,0,0,0,,Э? Қайда?
Dialogue: 0,0:21:07.03,0:21:09.06,Default,,0,0,0,,Э? Қайда?
Dialogue: 0,0:21:12.01,0:21:14.07,Default,,0,0,0,,Мұның бәрі уақытты сатып алу туралы.
Dialogue: 0,0:21:23.01,0:21:24.01,Default,,0,0,0,,Сен шынымен де тамаша ФБР агенті болдың.
Dialogue: 0,0:21:26.07,0:21:29.00,Default,,0,0,0,,Мені өлтір
Dialogue: 0,0:22:39.09,0:22:41.08,Default,,0,0,0,,Шектеуге жақындау
Dialogue: 0,0:22:41.08,0:22:43.03,Default,,0,0,0,,Шектен асып кету
Dialogue: 0,0:22:43.04,0:22:46.00,Default,,0,0,0,,Сырттан келген жаулар
Dialogue: 0,0:22:47.50,0:22:52.50,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
