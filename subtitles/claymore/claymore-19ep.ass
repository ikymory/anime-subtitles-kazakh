Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.53,0:00:02.51,Default - Copy,Rubel,0,0,0,,Клэр
Dialogue: 0,0:00:02.51,0:00:05.62,Default - Copy,Rubel,0,0,0,,Мен сендерге тапсырма беруге келдім.
Dialogue: 0,0:00:06.00,0:00:08.80,Default - Copy,Rubel,0,0,0,,Солтүстікте бірнеше оянған адамдар пайда болды
Dialogue: 0,0:00:09.17,0:00:13.64,Default - Copy,Rubel,0,0,0,,7 және одан төмен сандар бірнеше жауынгердің өмірін қиды.
Dialogue: 0,0:00:14.11,0:00:17.83,Default - Copy,Rubel,0,0,0,,Сіздің келесі миссияңыз - оянған адамдарды жою.
Dialogue: 0,0:00:18.93,0:00:20.70,Default - Copy,Rubel,0,0,0,,О, және
Dialogue: 0,0:00:21.58,0:00:24.02,Default - Copy,Rubel,0,0,0,,Сіз бірге болған бала
Dialogue: 0,0:00:24.02,0:00:26.51,Default - Copy,Rubel,0,0,0,,Олар солтүстікке қарай бет алған сияқты.
Dialogue: 0,0:00:29.65,0:00:34.36,Default - Copy,Miria,0,0,0,,Осы бес адам, соның ішінде мен де, әрқайсысы капитан болады.
Dialogue: 0,0:00:35.06,0:00:37.96,Default - Copy,Miria,0,0,0,,Барлығы 24 адам жиналды.
Dialogue: 0,0:00:37.96,0:00:41.20,Default - Copy,Miria,0,0,0,,Содан кейін бес команда құрыңыз.
Dialogue: 0,0:00:41.77,0:00:44.24,Default - Copy,Miria,0,0,0,,Әр командаға 45 адам
Dialogue: 0,0:00:44.24,0:00:48.36,Default - Copy,Miria,0,0,0,,Басқаша айтқанда, ол кәдімгі Оянған аңшылықпен бірдей құрылымға ие.
Dialogue: 0,0:00:49.07,0:00:53.83,Default - Copy,Clare,0,0,0,,Бұл стратегияның табысты болу ықтималдығы қандай?
Dialogue: 0,0:00:54.81,0:00:58.35,Default - Copy,Miria,0,0,0,,Бұл стратегияда табысқа жету ықтималдығы нөлге тең.
Dialogue: 0,0:01:02.79,0:01:04.46,Default - Copy,A.B.1,0,0,0,,Қайырлы кеш
Dialogue: 0,0:01:04.46,0:01:06.59,Default - Copy,A.B.1,0,0,0,,Пиета қаласының тұрғындары
Dialogue: 0,0:01:06.59,0:01:08.46,Default - Copy,A.B.2,0,0,0,,Мен мұны істеймін.
Dialogue: 0,0:01:08.46,0:01:10.48,Default - Copy,A.B.2,0,0,0,,Бұл өте қызық болып барады.
Dialogue: 0,0:01:10.60,0:01:12.30,Default - Copy,A.B.2,0,0,0,,Өйткені бұл
Dialogue: 0,0:01:12.30,0:01:13.53,Default - Copy,A.B.2,0,0,0,,Өйткені бұл
Dialogue: 0,0:01:13.53,0:01:15.60,Default - Copy,A.B.2,0,0,0,,Сіз құбыжық болуды тоқтата алмайсыз.
Dialogue: 0,0:01:26.75,0:01:28.48,Default - Copy,Undine,0,0,0,,Мен келе жатырмын
Dialogue: 0,0:01:31.95,0:01:33.49,Default - Copy,Undine,0,0,0,,Балалар сендер артқа тұрыңдар.
Dialogue: 0,0:01:40.08,0:01:42.37,Default - Copy,Undine,0,0,0,,Дәл қазір болған оқиғадан жалтармағандар жолға түсті.
Dialogue: 0,0:01:42.37,0:01:43.27,Default - Copy,Undine,0,0,0,,Төмен түсіңіз
Dialogue: 0,0:02:44.84,0:02:48.08,Default - Copy,Undine,0,0,0,,2 командадағы 10 адамнан 6 адам қалды
Dialogue: 0,0:02:48.08,0:02:49.85,Default - Copy,Undine,0,0,0,,Сен жоғалдың ба, Флора?
Dialogue: 0,0:02:49.85,0:02:51.42,Default - Copy,Flora,0,0,0,,Жоқ, Ундин мырза.
Dialogue: 0,0:02:51.42,0:02:52.68,Default - Copy,Flora,0,0,0,,Осымен жүрейік.
Dialogue: 0,0:03:06.26,0:03:07.40,Default - Copy,Undine,0,0,0,,«Біз оның әйелі мен балаларын қауіпсіз жерге жеткіздік»
Dialogue: 0,0:03:07.97,0:03:09.13,Default - Copy,Deneve,0,0,0,,Күте тұрыңыз, капитан.
Dialogue: 0,0:03:09.13,0:03:10.37,Default - Copy,Flora,0,0,0,,Ундин мырза
Dialogue: 0,0:03:10.37,0:03:12.07,Default - Copy,Flora,0,0,0,,Жоқ, өзіңнен озып кетпе.
Dialogue: 0,0:03:14.34,0:03:16.64,Default - Copy,A.B.1,0,0,0,,Өйткені қарапайым ақымақ деген осы.
Dialogue: 0,0:03:21.68,0:03:24.65,Default - Copy,A.B.1,0,0,0,,Тамағыңызды өзіңіз кесіңіз
Dialogue: 0,0:03:31.09,0:03:32.16,Default - Copy,Clare,0,0,0,,Болдырмау
Dialogue: 0,0:03:36.33,0:03:38.83,Default - Copy,Undine,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:03:39.93,0:03:42.90,Default - Copy,Undine,0,0,0,,Бір ғана мақсат – бетіңді жаралау болса.
Dialogue: 0,0:03:42.90,0:03:45.70,Default - Copy,Undine,0,0,0,,Бұл өте тұзды әдіс, досым.
Dialogue: 0,0:03:45.70,0:03:46.71,Default - Copy,A.B.1,0,0,0,,Кира — бұл жолы тым ыңғайлы болып кетті — мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:03:46.71,0:03:48.77,Default - Copy,A.B.1,0,0,0,,Ұзын қылышты күшпен өзгертті
Dialogue: 0,0:03:49.34,0:03:51.19,Default - Copy,Undine,0,0,0,,Өл, бұлыңғыр
Dialogue: 0,0:03:56.72,0:03:59.75,Default - Copy,A.B.1,0,0,0,,Біраз тыныш отыр, бұлшық ет тентек.
Dialogue: 0,0:03:59.75,0:04:02.75,Default - Copy,Clare,0,0,0,,Ол сиқырлы күштерді басқара ма?
Dialogue: 0,0:04:14.65,0:04:16.03,Default - Copy,Undine,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:04:16.03,0:04:18.47,Default - Copy,Undine,0,0,0,,Кім тыныш?
Dialogue: 0,0:04:18.87,0:04:20.34,Default - Copy,A.B.1,0,0,0,,Бұл жігіт
Dialogue: 0,0:04:32.22,0:04:33.69,Default - Copy,Flora,0,0,0,,Барлығымен шабуыл жасаңыз
Dialogue: 0,0:04:33.69,0:04:34.22,Default - Copy,Deneve,0,0,0,,Қ-Қандай?
Dialogue: 0,0:04:35.19,0:04:36.12,Default - Copy,Deneve,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:04:36.49,0:04:38.06,Default - Copy,Deneve,0,0,0,,Әлі де оның сиқырында.
Dialogue: 0,0:04:41.66,0:04:43.56,Default - Copy,Undine,0,0,0,,Бұл
Dialogue: 0,0:04:43.56,0:04:44.80,Default - Copy,Flora,0,0,0,,Ундин мырза
Dialogue: 0,0:04:44.80,0:04:47.03,Default - Copy,Undine,0,0,0,,Мұнда келме
Dialogue: 0,0:04:47.37,0:04:48.83,Default - Copy,Undine,0,0,0,,Мұндай адам
Dialogue: 0,0:04:48.83,0:04:50.40,Default - Copy,Undine,0,0,0,,Мен ғана осындаймын
Dialogue: 0,0:05:10.29,0:05:12.17,Default - Copy,Jeane,0,0,0,,Жаралылар төмен түссін
Dialogue: 0,0:05:22.80,0:05:24.30,Default - Copy,Undine,0,0,0,,Шит Гесу.
Dialogue: 0,0:05:25.64,0:05:29.24,Default - Copy,A.B.1,0,0,0,,Мен қашанға дейін осылай мықты бола аламын?
Dialogue: 0,0:05:31.04,0:05:31.91,Default - Copy,Flora,0,0,0,,Ундин мырза
Dialogue: 0,0:05:38.38,0:05:40.15,Default - Copy,Undine,0,0,0,,Менің ойымша, бұл келе жатыр.
Dialogue: 0,0:05:40.15,0:05:41.49,Default - Copy,Undine,0,0,0,,Сіз кепілдік залал аласыз.
Dialogue: 0,0:05:42.72,0:05:44.16,Default - Copy,A.B.1,0,0,0,,Ақымақ
Dialogue: 0,0:05:44.16,0:05:46.56,Default - Copy,A.B.1,0,0,0,,Сіз өзіңіз қатысуға келдіңіз бе?
Dialogue: 0,0:05:52.26,0:05:53.77,Default - Copy,A.B.1,0,0,0,,Бұл жігіт
Dialogue: 0,0:05:53.77,0:05:55.47,Default - Copy,Deneve,0,0,0,,Кешіріңіз, мен сізді ұрып жіберемін.
Dialogue: 0,0:05:58.60,0:05:59.68,Default - Copy,Flora,0,0,0,,Ундин мырза
Dialogue: 0,0:06:00.44,0:06:02.64,Default - Copy,Flora,0,0,0,,Денев мырза, Клэр мырза
Dialogue: 0,0:06:17.69,0:06:18.49,Default - Copy,Jeane,0,0,0,,8
Dialogue: 0,0:06:19.76,0:06:20.49,Default - Copy,Jeane,0,0,0,,9
Dialogue: 0,0:06:21.86,0:06:22.59,Default - Copy,Jeane,0,0,0,,Он
Dialogue: 0,0:06:24.23,0:06:25.60,Default - Copy,Helen,0,0,0,,Ген әлі жоқ
Dialogue: 0,0:06:26.40,0:06:27.40,Default - Copy,Jeane,0,0,0,,Он екі
Dialogue: 0,0:06:28.50,0:06:29.71,Default - Copy,Jeane,0,0,0,,Он үш
Dialogue: 0,0:06:35.37,0:06:37.48,Default - Copy,A.B.1,0,0,0,,Ау
Dialogue: 0,0:06:37.48,0:06:38.38,Default - Copy,A.B.1,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:06:38.71,0:06:41.05,Default - Copy,A.B.1,0,0,0,,Сабыр етіңіз
Dialogue: 0,0:06:42.55,0:06:44.42,Default - Copy,A.B.1,0,0,0,,О... дұрыс.
Dialogue: 0,0:06:44.42,0:06:46.55,Default - Copy,A.B.1,0,0,0,,Сіз тым алданып бара жатырсыз.
Dialogue: 0,0:06:55.46,0:06:56.63,Default - Copy,Jeane,0,0,0,,Он жеті
Dialogue: 0,0:06:57.73,0:06:59.20,Default - Copy,Jeane,0,0,0,,Он сегізінші
Dialogue: 0,0:07:04.44,0:07:06.54,Default - Copy,A.B.1,0,0,0,,Енді
Dialogue: 0,0:07:06.54,0:07:09.67,Default - Copy,A.B.1,0,0,0,,Мұны қалай істеуім керек?
Dialogue: 0,0:07:15.85,0:07:18.25,Default - Copy,A.B.1,0,0,0,,Эй, жақсы ма?
Dialogue: 0,0:07:18.75,0:07:21.65,Default - Copy,A.B.1,0,0,0,,Сиқырлы күшті босату жақсы, бірақ
Dialogue: 0,0:07:22.05,0:07:26.66,Default - Copy,A.B.1,0,0,0,,Осылай қалсаң, шегінен асып, оянып кетесің.
Dialogue: 0,0:07:31.83,0:07:34.27,Default - Copy,Flora,0,0,0,,Денев мырза, Клэр мырза
Dialogue: 0,0:07:48.05,0:07:50.05,Default - Copy,A.B.1,0,0,0,,Хмф, сіз ояусыз ба?
Dialogue: 0,0:07:53.22,0:07:54.69,Default - Copy,Jeane,0,0,0,,жиырма
Dialogue: 0,0:07:57.29,0:07:59.26,Default - Copy,A.B.3,0,0,0,,Балалар сендер әлсізсіңдер.
Dialogue: 0,0:07:59.96,0:08:04.10,Default - Copy,A.B.3,0,0,0,,10 адам болды, олар мені мүлде ренжіте алмады.
Dialogue: 0,0:08:07.00,0:08:10.60,Default - Copy,A.B.3,0,0,0,,Жоқ, мен тым күшті шығармын.
Dialogue: 0,0:08:19.48,0:08:21.21,Default - Copy,A.B.3,0,0,0,,Қандай күш-жігер жұмсау!
Dialogue: 0,0:08:26.12,0:08:28.65,Default - Copy,Jeane,0,0,0,,21
Dialogue: 0,0:08:32.16,0:08:33.89,Default - Copy,A.B.3,0,0,0,,Мүлдем шайнамайды
Dialogue: 0,0:08:38.83,0:08:40.63,Default - Copy,Jeane,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:08:44.54,0:08:46.14,Default - Copy,Helen,0,0,0,,Мүлде жоқ.
Dialogue: 0,0:08:47.77,0:08:48.77,Default - Copy,A.B.3,0,0,0,,Балалар
Dialogue: 0,0:09:06.66,0:09:07.96,Default - Copy,Cynthia,0,0,0,,Вероника
Dialogue: 0,0:09:07.96,0:09:10.26,Default - Copy,Cynthia,0,0,0,,Бұл біздің рөліміз.
Dialogue: 0,0:09:10.83,0:09:13.70,Default - Copy,Cynthia,0,0,0,,Өзіңізді ортаға салып, басқа адамның назарын аударыңыз
Dialogue: 0,0:09:13.70,0:09:15.93,Default - Copy,Cynthia,0,0,0,,Менің денем жарақаттармен жабылған.
Dialogue: 0,0:09:15.93,0:09:18.30,Default - Copy,Veronica,0,0,0,,О, Синтия
Dialogue: 0,0:09:18.30,0:09:21.34,Default - Copy,Veronica,0,0,0,,Оған көмектесу мүмкін емес, өйткені екеуміз де қорғаныс типіміз.
Dialogue: 0,0:09:21.67,0:09:23.71,Default - Copy,Veronica,0,0,0,,Бірақ мен сені аяқтаймын.
Dialogue: 0,0:09:24.51,0:09:26.56,Default - Copy,Cynthia,0,0,0,,Ішімдік азаяды
Dialogue: 0,0:09:27.05,0:09:28.81,Default - Copy,A.B.3,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:09:54.87,0:09:57.74,Default - Copy,A.B.1,0,0,0,,Ояусың ба, ақымақ?
Dialogue: 0,0:10:03.86,0:10:05.28,Default - Copy,A.B.1,0,0,0,,Ақымақ
Dialogue: 0,0:10:05.28,0:10:08.02,Default - Copy,A.B.1,0,0,0,,Балалар сендер оянуларың керек еді.
Dialogue: 0,0:10:08.02,0:10:09.05,Default - Copy,A.B.1,0,0,0,,Неліктен?
Dialogue: 0,0:10:44.82,0:10:46.19,Default - Copy,Flora,0,0,0,,Сол екеуі
Dialogue: 0,0:10:46.19,0:10:47.76,Default - Copy,A.B.1,0,0,0,,Кира — бұл жолы тым ыңғайлы болып кетті — мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:10:47.76,0:10:49.79,Default - Copy,A.B.1,0,0,0,,шектен асып кеткен болуы керек
Dialogue: 0,0:10:50.26,0:10:52.43,Default - Copy,Deneve,0,0,0,,Сіз қателесесіз бе?
Dialogue: 0,0:10:52.43,0:10:54.03,Default - Copy,Deneve,0,0,0,,Бұл менің қиялым ғана
Dialogue: 0,0:10:54.03,0:10:57.70,Default - Copy,Clare,0,0,0,,Олай болса, мәселені шешейік.
Dialogue: 0,0:11:06.95,0:11:10.05,Default - Copy,A.B.1,0,0,0,,Тоқтау.
Dialogue: 0,0:11:14.05,0:11:15.05,Default - Copy,Clare,0,0,0,,Денев
Dialogue: 0,0:11:15.49,0:11:16.62,Default - Copy,A.B.1,0,0,0,,О... дұрыс.
Dialogue: 0,0:11:16.62,0:11:18.16,Default - Copy,A.B.1,0,0,0,,Сіз тым алданып бара жатырсыз.
Dialogue: 0,0:11:20.39,0:11:22.53,Default - Copy,Deneve,0,0,0,,Мені тоқтатқыңыз келсе
Dialogue: 0,0:11:22.53,0:11:24.40,Default - Copy,Deneve,0,0,0,,Басты көздеуім керек еді.
Dialogue: 0,0:11:30.24,0:11:31.07,Default - Copy,Deneve,0,0,0,,қатты
Dialogue: 0,0:11:31.44,0:11:33.14,Default - Copy,Deneve,0,0,0,,Бір соққыда орындау мүмкін емес пе?
Dialogue: 0,0:11:40.15,0:11:43.62,Default - Copy,Undine,0,0,0,,Пышақтың бұдан әрі алға жылжымауы зақымданудан ба?
Dialogue: 0,0:11:44.05,0:11:46.62,Default - Copy,Undine,0,0,0,,Әлде оны бастау дәрменсіз бе?
Dialogue: 0,0:11:46.62,0:11:51.69,Default - Copy,Deneve,0,0,0,,Хмф, мен бұлшық еттерімен мақтанатын адам емеспін.
Dialogue: 0,0:11:51.69,0:11:53.12,Default - Copy,Deneve,0,0,0,,Мен техникалық маманмын.
Dialogue: 0,0:11:57.36,0:11:59.83,Default - Copy,A.B.1,0,0,0,,Пайдасыз
Dialogue: 0,0:12:10.31,0:12:11.61,Default - Copy,clay1,0,0,0,,Мен мұны істедім
Dialogue: 0,0:12:12.81,0:12:15.45,Default - Copy,A.B.1,0,0,0,,...
Dialogue: 0,0:12:16.31,0:12:18.18,Default - Copy,Deneve,0,0,0,,Бұл жаман. Құтылып кету.
Dialogue: 0,0:12:18.18,0:12:20.45,Default - Copy,Deneve,0,0,0,,Ол әлі де сиқырлы қуатты манипуляцияны қолдана алады.
Dialogue: 0,0:12:26.96,0:12:31.70,Default - Copy,A.B.1,0,0,0,,Кем дегенде екі кішкентай шабақ жер асты әлемінен кәдесыйлармен саяхаттап жүр.
Dialogue: 0,0:12:41.67,0:12:44.71,Default - Copy,A.B.1,0,0,0,,Бір-бірінің бастарын кесу
Dialogue: 0,0:13:12.67,0:13:14.17,Default - Copy,Undine,0,0,0,,Екеуің жақсысыңдар ма?
Dialogue: 0,0:13:14.71,0:13:17.84,Default - Copy,Deneve,0,0,0,,Уайымдама, бұл қауіпті жер еді.
Dialogue: 0,0:13:20.68,0:13:23.68,Default - Copy,Undine,0,0,0,,Сондықтан кішкентай шабақтар қиындыққа ұшырайды.
Dialogue: 0,0:13:23.68,0:13:24.52,Default - Copy,Undine,0,0,0,,Ақымақ
Dialogue: 0,0:13:28.39,0:13:30.59,Default - Copy,Helen,0,0,0,,Ой, мұның да бітті ме?
Dialogue: 0,0:13:31.89,0:13:34.29,Default - Copy,Helen,0,0,0,,Біз тезірек аяқтадық.
Dialogue: 0,0:13:34.29,0:13:35.86,Default - Copy,Helen,0,0,0,,Мен сені маған көмектесемін деп ойладым.
Dialogue: 0,0:13:36.29,0:13:38.43,Default - Copy,Helen,0,0,0,,Бұл қажет емес сияқты.
Dialogue: 0,0:13:38.86,0:13:42.43,Default - Copy,Deneve,0,0,0,,Екеуміз де аман қалмаған сияқтымыз.
Dialogue: 0,0:13:50.08,0:13:51.01,Default - Copy,Clare,0,0,0,,Милия
Dialogue: 0,0:13:51.41,0:13:55.11,Default - Copy,Clare,0,0,0,,Соңында Мирия бір ғана командамен күреседі.
Dialogue: 0,0:13:55.88,0:13:57.95,Default - Copy,Deneve,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:13:58.65,0:14:01.12,Default - Copy,Deneve,0,0,0,,Кімге алаңдайсыз?
Dialogue: 0,0:14:08.13,0:14:10.80,Default - Copy,A.B.2,0,0,0,,Бұл жігіт
Dialogue: 0,0:14:12.06,0:14:13.57,Default - Copy,A.B.2,0,0,0,,Толық шегіну.
Dialogue: 0,0:14:17.37,0:14:19.77,Default - Copy,Helen,0,0,0,,Керемет
Dialogue: 0,0:14:19.77,0:14:22.02,Default - Copy,Helen,0,0,0,,Милия-ни-сан, сен амансың ба?
Dialogue: 0,0:14:24.21,0:14:28.31,Default - Copy,Deneve,0,0,0,,Сіз әртүрлі тәжірибелер арқылы күшейіп кеткен сияқтысыз.
Dialogue: 0,0:14:28.31,0:14:30.88,Default - Copy,Deneve,0,0,0,,Милия одан әрі қарай жүреді
Dialogue: 0,0:14:32.02,0:14:34.25,Default - Copy,Deneve,0,0,0,,Милияның жағдайы
Dialogue: 0,0:14:34.69,0:14:38.19,Default - Copy,Deneve,0,0,0,,Бұл біз ойлағаннан әлдеқайда ауыр.
Dialogue: 0,0:14:44.53,0:14:46.33,Default - Copy,Miria,0,0,0,,Сіз екеуін де орындаған сияқтысыз.
Dialogue: 0,0:14:46.83,0:14:48.70,Default - Copy,Miria,0,0,0,,Әзірше қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:14:49.30,0:14:52.00,Default - Copy,Miria,0,0,0,,Бұл сол қолынан айырылған Юма.
Dialogue: 0,0:14:52.67,0:14:55.44,Default - Copy,Miria,0,0,0,,Бұл қорғаныс түрі болғандықтан, оны қайта қалпына келтіруге болады.
Dialogue: 0,0:14:55.44,0:14:57.31,Default - Copy,Miria,0,0,0,,Мен біраз уақытқа дейін күресе алмаймын.
Dialogue: 0,0:14:58.08,0:15:02.28,Default - Copy,Miria,0,0,0,,Әр командада төбелесе алмайтын біреу болса, бізге хабарлаңыз.
Dialogue: 0,0:15:03.08,0:15:06.48,Default - Copy,Miria,0,0,0,,Тиісінше қайта ұйымдастыруды қарастырыңыз.
Dialogue: 0,0:15:06.48,0:15:07.97,Default - Copy,Undine,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:15:09.39,0:15:13.66,Default - Copy,Undine,0,0,0,,Сізге біз тек пешкалармыз.
Dialogue: 0,0:15:14.26,0:15:18.03,Default - Copy,Undine,0,0,0,,Бұл ұйым бастапқыда ақылға қонымсыз болған жоқ па?
Dialogue: 0,0:15:19.06,0:15:22.23,Default - Copy,Undine,0,0,0,,Бұрын оянған адаммен соғыспаған адам.
Dialogue: 0,0:15:22.23,0:15:24.77,Default - Copy,Undine,0,0,0,,Кенет сол сақинада тұру
Dialogue: 0,0:15:25.37,0:15:29.14,Default - Copy,Undine,0,0,0,,Күткендей ол қозғала алмай, аяғы байланған.
Dialogue: 0,0:15:29.91,0:15:32.24,Default - Copy,Undine,0,0,0,,Ақырында көп қан бекер төгілді.
Dialogue: 0,0:15:32.74,0:15:37.53,Default - Copy,Undine,0,0,0,,Оны пайдалана алмағандарға әу бастан қолдау көрсетілсе жақсы емес пе еді?
Dialogue: 0,0:15:38.75,0:15:43.32,Default - Copy,Undine,0,0,0,,Жауабыңызға қарай, мен сізге еретін ойым жоқ.
Dialogue: 0,0:15:49.16,0:15:52.46,Default - Copy,Flora,0,0,0,,Қайтыс болғандардың санын кім біледі?
Dialogue: 0,0:15:53.43,0:15:56.23,Default - Copy,clay2,0,0,0,,Кейбір адамдар жарақат алды, бірақ ешкім өлген жоқ.
Dialogue: 0,0:15:56.23,0:15:58.00,Default - Copy,clay2,0,0,0,,Барлығы аман қалады
Dialogue: 0,0:15:58.67,0:16:04.81,Default - Copy,Flora,0,0,0,,Басқаша айтқанда, әркім Оянған адамдарға қарсы күресте біраз тәжірибе алды.
Dialogue: 0,0:16:09.38,0:16:15.02,Default - Copy,Flora,0,0,0,,Мирия-санның шын ниеті - барлығына Оянғандармен күресуде тәжірибе жинақтау.
Dialogue: 0,0:16:15.42,0:16:17.59,Default - Copy,Flora,0,0,0,,Басқаша айтқанда, әскери күштің деңгейін көтеру
Dialogue: 0,0:16:18.39,0:16:19.57,Default - Copy,Flora,0,0,0,,Жоқ?
Dialogue: 0,0:16:23.93,0:16:27.80,Default - Copy,Undine,0,0,0,,Қалай болғанда да, бұл көптеген адамдар өлуі мүмкін шайқас болды.
Dialogue: 0,0:16:28.17,0:16:31.07,Default - Copy,Undine,0,0,0,,Бұл оның күшті әдіс болғанын өзгертпейді.
Dialogue: 0,0:16:37.58,0:16:39.71,Default - Copy,Miria,0,0,0,,Барлығына қиын болды.
Dialogue: 0,0:16:40.15,0:16:44.25,Default - Copy,Miria,0,0,0,,Келесі шайқасқа дайындалу үшін біраз демалыңыз.
Dialogue: 0,0:16:52.29,0:16:53.26,Default - Copy,Clare,0,0,0,,Жақсы ма?
Dialogue: 0,0:16:53.86,0:16:55.73,Default - Copy,Clare,0,0,0,,Сіз байқаған боларсыз.
Dialogue: 0,0:16:56.33,0:17:00.10,Default - Copy,Clare,0,0,0,,Қазіргі күшпен біз жойыламыз.
Dialogue: 0,0:17:00.87,0:17:03.80,Default - Copy,Miria,0,0,0,,Біз үшін құтылудың жолы жоқ.
Dialogue: 0,0:17:04.20,0:17:06.47,Default - Copy,Miria,0,0,0,,Қанша талпынсаң да, бұл арғы лагерь.
Dialogue: 0,0:17:06.84,0:17:09.34,Default - Copy,Miria,0,0,0,,Күшті болыңыз
Dialogue: 0,0:17:09.34,0:17:12.24,Default - Copy,Miria,0,0,0,,Бар күшіңізбен аман қалуға жол ашыңыз
Dialogue: 0,0:17:12.74,0:17:16.92,Default - Copy,Miria,0,0,0,,Бұл бізде аз мүмкіндік.
Dialogue: 0,0:17:18.42,0:17:20.25,Default - Copy,Clare,0,0,0,,Мүмкіндік?
Dialogue: 0,0:17:36.70,0:17:37.64,Default - Copy,Clare,0,0,0,,Раки
Dialogue: 0,0:17:38.60,0:17:39.54,Default - Copy,Clare,0,0,0,,Ол тесілді ме?
Dialogue: 0,0:18:05.13,0:18:06.26,Default - Copy,Raki,0,0,0,,Жақсы
Dialogue: 0,0:18:07.27,0:18:08.68,Default - Copy,Raki,0,0,0,,Клэр емес
Dialogue: 0,0:18:18.64,0:18:20.39,Default - Copy,Raki,0,0,0,,Қалада ешкім жоқ
Dialogue: 0,0:18:21.85,0:18:24.48,Default - Copy,Raki,0,0,0,,Олардың барлығы өлтірілді ме?
Dialogue: 0,0:18:25.95,0:18:27.02,Default - Copy,Raki,0,0,0,,Құбыжық
Dialogue: 0,0:19:07.83,0:19:09.09,Default - Copy,Raki,0,0,0,,Жарайды
Dialogue: 0,0:19:09.09,0:19:10.10,Default - Copy,Raki,0,0,0,,Жарақаттар жоқ
Dialogue: 0,0:19:23.41,0:19:25.58,Default - Copy,Raki,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:19:32.38,0:19:33.96,Default - Copy,Raki,0,0,0,,Кішкене ғана
Dialogue: 0,0:19:33.82,0:19:35.32,Default - Copy,Raki,0,0,0,,Аз ғана
Dialogue: 0,0:19:36.39,0:19:37.32,Default - Copy,Easley,0,0,0,,Эй
Dialogue: 0,0:19:40.26,0:19:42.13,Default - Copy,Easley,0,0,0,,Сіз сонда болдыңыз ба?
Dialogue: 0,0:19:42.83,0:19:43.73,Default - Copy,Easley,0,0,0,,Не болды?
Dialogue: 0,0:19:45.96,0:19:48.60,Default - Copy,Priscilla,0,0,0,,Бұл баланың иісі жақсы
Dialogue: 0,0:19:49.07,0:19:53.48,Default - Copy,Easley,0,0,0,,Ей, сізді қызықтыру әдеттен тыс.
Dialogue: 0,0:19:54.71,0:19:57.34,Default - Copy,Easley,0,0,0,,Сіз осы жақтансыз ба?
Dialogue: 0,0:19:57.34,0:20:01.11,Default - Copy,Raki,0,0,0,,Мен әрқашан оңтүстікте тұрдым
Dialogue: 0,0:20:01.51,0:20:04.12,Default - Copy,Raki,0,0,0,,Мұнда біреуді іздеп келді
Dialogue: 0,0:20:04.12,0:20:07.90,Default - Copy,Raki,0,0,0,,Мына жерде сондай біреуді көрген деген қауесет естідім.
Dialogue: 0,0:20:08.79,0:20:10.26,Default - Copy,Easley,0,0,0,,Мен көремін.
Dialogue: 0,0:20:10.26,0:20:11.89,Default - Copy,Easley,0,0,0,,Сен оңтүстіктен келдің бе?
Dialogue: 0,0:20:12.32,0:20:15.83,Default - Copy,Easley,0,0,0,,Мүмкін сен оңтүстіктің жылы иісін сезген шығарсың.
Dialogue: 0,0:20:16.76,0:20:20.13,Default - Copy,Easley,0,0,0,,Мен сені оңтүстікке тез апарғым келеді.
Dialogue: 0,0:20:20.93,0:20:25.64,Default - Copy,Raki,0,0,0,,Мм, бұл қалаға да құбыжықтар шабуыл жасаған шығар?
Dialogue: 0,0:20:27.27,0:20:28.94,Default - Copy,Easley,0,0,0,,Сіз сенімді бола аласыз.
Dialogue: 0,0:20:29.31,0:20:31.88,Default - Copy,Easley,0,0,0,,Ол енді бұл жерде жоқ сияқты.
Dialogue: 0,0:20:36.55,0:20:38.78,Default - Copy,Easley,0,0,0,,Сыртта күн суық.
Dialogue: 0,0:20:39.25,0:20:40.49,Default - Copy,Easley,0,0,0,,Жақында қайтайық
Dialogue: 0,0:20:41.05,0:20:42.12,Default - Copy,Easley,0,0,0,,Сіз де келесіз деп үміттенемін.
Dialogue: 0,0:20:42.12,0:20:42.95,Default - Copy,Raki,0,0,0,,Иә?
Dialogue: 0,0:20:43.42,0:20:46.93,Default - Copy,Easley,0,0,0,,Баланың адамдарға мұнша үйір болуы жиі емес.
Dialogue: 0,0:20:47.43,0:20:49.76,Default - Copy,Easley,0,0,0,,Маған біраз уақыт серіктес болайын.
Dialogue: 0,0:20:51.92,0:20:53.60,Default - Copy,Raki,0,0,0,,А, жақсы
Dialogue: 0,0:20:59.50,0:21:01.04,Default - Copy,Easley,0,0,0,,Келесі кезекте біз
Dialogue: 0,0:21:02.24,0:21:03.54,Default - Copy,Easley,0,0,0,,Прискила
Dialogue: 0,0:22:40.40,0:22:42.30,Default - Copy,,0,0,0,,Батпайтын күн
Dialogue: 0,0:22:42.30,0:22:43.84,Default - Copy,,0,0,0,,Батып бара жатқан үміт
Dialogue: 0,0:22:43.94,0:22:46.54,Default - Copy,,0,0,0,,Алыстағы таң
Dialogue: 0,0:22:48.04,0:22:54.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory