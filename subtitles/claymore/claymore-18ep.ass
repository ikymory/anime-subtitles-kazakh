Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.55,0:00:05.42,Default - Copy,Eva,0,0,0,,Төмен түсіңіз
Dialogue: 0,0:00:05.85,0:00:07.55,Default - Copy,Eva,0,0,0,,Төмен түсу Төмен түсу
Dialogue: 0,0:00:07.55,0:00:08.49,Default - Copy,clay2,0,0,0,,Хауа
Dialogue: 0,0:00:08.49,0:00:09.99,Default - Copy,clay2,0,0,0,,Кейт жеңілді
Dialogue: 0,0:00:11.79,0:00:13.02,Default - Copy,Eva,0,0,0,,Люсия
Dialogue: 0,0:00:16.86,0:00:19.03,Default - Copy,Eva,0,0,0,,Не?
Dialogue: 0,0:00:20.90,0:00:22.57,Default - Copy,Eva,0,0,0,,Ақыры қылмыскер автобустан секіріп түсіп, көлік астында қалыпты.
Dialogue: 0,0:00:24.54,0:00:28.57,Default - Copy,Eva,0,0,0,,Не болып жатыр?
Dialogue: 0,0:01:44.05,0:01:46.12,Default - Copy,Clare,0,0,0,,Қашанға дейін менің соңымнан жүрмек ойың бар?
Dialogue: 0,0:01:48.39,0:01:51.49,Default - Copy,Jeane,0,0,0,,Мен саған сол жақсылығымды қайтармайынша.
Dialogue: 0,0:01:51.49,0:01:53.83,Default - Copy,Jeane,0,0,0,,Сенің жаныңнан кететін ойым жоқ.
Dialogue: 0,0:01:55.93,0:01:57.33,Default - Copy,Jeane,0,0,0,,Ал мен оны дәл осы жерде ғана ұшырып жіберсем!
Dialogue: 0,0:01:57.33,0:02:00.13,Default - Copy,Jeane,0,0,0,,Бұл өмір сенікі.
Dialogue: 0,0:02:03.94,0:02:07.17,Default - Copy,Clare,0,0,0,,Мен де осындай жәрдемақы алдым.
Dialogue: 0,0:02:15.28,0:02:16.92,Default - Copy,Jeane,0,0,0,,Бұл керемет.
Dialogue: 0,0:02:18.32,0:02:20.92,Default - Copy,Clare,0,0,0,,Мен бұл дағдыны сенен алдым.
Dialogue: 0,0:02:21.45,0:02:22.42,Default - Copy,Jeane,0,0,0,,Менен
Dialogue: 0,0:02:22.82,0:02:27.89,Default - Copy,Clare,0,0,0,,Осы уақытқа дейін мен жоғары жылдамдықты қылышты басқаруға болады деп ешқашан ойлаған емеспін.
Dialogue: 0,0:02:28.33,0:02:31.90,Default - Copy,Clare,0,0,0,,Бірақ мен сені сол жертөледе көргенде
Dialogue: 0,0:02:31.90,0:02:34.27,Default - Copy,Clare,0,0,0,,Менің барлық ойым өзгерді
Dialogue: 0,0:02:35.83,0:02:38.17,Default - Copy,Clare,0,0,0,,Денеңді оятсаң да
Dialogue: 0,0:02:38.54,0:02:40.64,Default - Copy,Clare,0,0,0,,Адамның еркі қалады дейді
Dialogue: 0,0:02:40.64,0:02:43.78,Default - Copy,Clare,0,0,0,,Сіз біздің санамыз бойынша мүмкін емес нәрсені жасадыңыз.
Dialogue: 0,0:02:45.28,0:02:46.75,Default - Copy,Clare,0,0,0,,Бұл таң қалдырды.
Dialogue: 0,0:02:47.45,0:02:50.78,Default - Copy,Clare,0,0,0,,Адамның ерік-жігерінің күші үлкен күшке айналады.
Dialogue: 0,0:02:52.22,0:02:54.65,Default - Copy,Clare,0,0,0,,Сондықтан мен оны байқап көрейін деп ойладым.
Dialogue: 0,0:02:55.52,0:02:57.32,Default - Copy,Clare,0,0,0,,Елес энергияға әрекет ету
Dialogue: 0,0:02:57.32,0:03:00.86,Default - Copy,Clare,0,0,0,,Күшті ерік күшімен басқарылатын жоғары жылдамдықты қылыш.
Dialogue: 0,0:03:02.36,0:03:04.23,Default - Copy,Jeane,0,0,0,,Бұл ма?
Dialogue: 0,0:03:06.07,0:03:09.23,Default - Copy,Clare,0,0,0,,Осыны жасағаным сіздің арқаңызда.
Dialogue: 0,0:03:10.77,0:03:12.67,Default - Copy,Rubel,0,0,0,,Бұл бетті жасамаңыз
Dialogue: 0,0:03:13.01,0:03:14.81,Default - Copy,Rubel,0,0,0,,Егер ол жоғалып кетсе, мен оны іздеймін.
Dialogue: 0,0:03:14.81,0:03:16.21,Default - Copy,Rubel,0,0,0,,Әрине
Dialogue: 0,0:03:16.21,0:03:17.38,Default - Copy,Clare,0,0,0,,Лувр
Dialogue: 0,0:03:21.35,0:03:22.21,Default - Copy,Jeane,0,0,0,,Ақымақ
Dialogue: 0,0:03:22.65,0:03:23.92,Default - Copy,Jeane,0,0,0,,Қатысу сияқты
Dialogue: 0,0:03:27.29,0:03:28.69,Default - Copy,Clare,0,0,0,,№ 5
Dialogue: 0,0:03:29.15,0:03:29.92,Default - Copy,Clare,0,0,0,,Рафаэла
Dialogue: 0,0:03:29.92,0:03:31.29,Default - Copy,Rubel,0,0,0,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:03:31.29,0:03:32.83,Default - Copy,Rubel,0,0,0,,Сіз таң қалған болуыңыз керек.
Dialogue: 0,0:03:33.33,0:03:36.43,Default - Copy,Rubel,0,0,0,,Бұл жігіт жындарды өшіруге шебер.
Dialogue: 0,0:03:37.50,0:03:40.17,Default - Copy,Rubel,0,0,0,,Жасырын операциялар үшін өте қолайлы.
Dialogue: 0,0:03:40.77,0:03:42.13,Default - Copy,Rubel,0,0,0,,Тоқта.
Dialogue: 0,0:03:42.57,0:03:45.50,Default - Copy,Rubel,0,0,0,,Бұл жігітті екі адам да жеңе алмайды.
Dialogue: 0,0:03:46.07,0:03:48.27,Default - Copy,Rubel,0,0,0,,Бұл аздап ерекше.
Dialogue: 0,0:03:48.81,0:03:49.98,Default - Copy,Jeane,0,0,0,,Галатея
Dialogue: 0,0:03:50.44,0:03:52.01,Default - Copy,Jeane,0,0,0,,Галатеяға не болды?
Dialogue: 0,0:03:52.95,0:03:55.38,Default - Copy,Rubel,0,0,0,,Бастапқы міндеттерінен бас тарту
Dialogue: 0,0:03:55.38,0:03:58.75,Default - Copy,Rubel,0,0,0,,Ол тіпті осындай өтірік айтатын.
Dialogue: 0,0:03:59.79,0:04:01.79,Default - Copy,Rubel,0,0,0,,Есепті алғаннан кейін бірден
Dialogue: 0,0:04:01.79,0:04:03.76,Default - Copy,Rubel,0,0,0,,Мен оның басын бірден кесіп тастадым.
Dialogue: 0,0:04:06.36,0:04:08.59,Default - Copy,Rubel,0,0,0,,Мен мұны айтқым келеді
Dialogue: 0,0:04:08.59,0:04:11.70,Default - Copy,Rubel,0,0,0,,Бұл өте пайдалы жігіт.
Dialogue: 0,0:04:12.20,0:04:14.80,Default - Copy,Rubel,0,0,0,,Мен сенің өміріңді аядым.
Dialogue: 0,0:04:15.40,0:04:18.87,Default - Copy,Rubel,0,0,0,,Қиын миссиялар біраз уақытқа жалғасады.
Dialogue: 0,0:04:22.37,0:04:23.64,Default - Copy,Rubel,0,0,0,,Клэр
Dialogue: 0,0:04:23.64,0:04:26.55,Default - Copy,Rubel,0,0,0,,Мен сендерге тапсырма беруге келдім.
Dialogue: 0,0:04:26.95,0:04:28.71,Default - Copy,Clare,0,0,0,,Егер бұл миссия болса
Dialogue: 0,0:04:29.11,0:04:31.95,Default - Copy,Rubel,0,0,0,,Солтүстікте бірнеше оянған адамдар пайда болды
Dialogue: 0,0:04:32.25,0:04:36.56,Default - Copy,Rubel,0,0,0,,7 және одан төмен сандар бірнеше жауынгердің өмірін қиды.
Dialogue: 0,0:04:37.26,0:04:41.23,Default - Copy,Rubel,0,0,0,,Сіздің ендігі міндетіңіз - бұл оятуды жою.
Dialogue: 0,0:04:42.93,0:04:45.46,Default - Copy,Rubel,0,0,0,,Ұйым белгілі бір адамдарды да дайындайды.
Dialogue: 0,0:04:46.13,0:04:48.63,Default - Copy,Rubel,0,0,0,,Демек, сен солардың бірісің.
Dialogue: 0,0:04:49.64,0:04:55.17,Default - Copy,Rubel,0,0,0,,Осы тапсырманы орындасаңыз, сізге ерекше кешірім жасалуы мүмкін сияқты.
Dialogue: 0,0:04:55.61,0:04:58.98,Default - Copy,Rubel,0,0,0,,Қашып жүрген сендерге жақсы мүмкіндік.
Dialogue: 0,0:04:59.68,0:05:02.55,Default - Copy,Rubel,0,0,0,,Маа, қорытынды жасауға асықпа.
Dialogue: 0,0:05:03.18,0:05:10.86,Default - Copy,Rubel,0,0,0,,Егер қаласақ, біз сізді кез келген уақытта тауып, өлтіретінімізді білуіңіз керек.
Dialogue: 0,0:05:11.99,0:05:13.66,Default - Copy,Rubel,0,0,0,,Ах, және
Dialogue: 0,0:05:14.46,0:05:16.66,Default - Copy,Rubel,0,0,0,,Сіз бірге болған бала
Dialogue: 0,0:05:17.03,0:05:19.46,Default - Copy,Rubel,0,0,0,,Олар солтүстікке қарай бет алған сияқты.
Dialogue: 0,0:05:22.94,0:05:25.54,Default - Copy,Rubel,0,0,0,,Мүмкін мен сені әлі іздеп жүрген шығармын
Dialogue: 0,0:05:25.90,0:05:27.11,Default - Copy,Clare,0,0,0,,Рахи
Dialogue: 0,0:05:28.21,0:05:33.01,Default - Copy,Rubel,0,0,0,,Баланы қайта көргің келсе
Dialogue: 0,0:05:33.51,0:05:39.99,Default - Copy,Rubel,0,0,0,,Бақытымызға орай, солтүстік аймақ осы мақсат үшін өте қолайлы аймақ болып табылады.
Dialogue: 0,0:05:41.32,0:05:42.55,Default - Copy,Clare,0,0,0,,Лувр
Dialogue: 0,0:05:56.60,0:05:57.80,Default - Copy,man1,0,0,0,,Ой
Dialogue: 0,0:05:59.14,0:06:00.47,Default - Copy,man2,0,0,0,,Бұл не?
Dialogue: 0,0:06:01.04,0:06:04.41,Default - Copy,man3,0,0,0,,Неден басталады?
Dialogue: 0,0:06:05.88,0:06:08.01,Default - Copy,Jeane,0,0,0,,Солтүстік Құрлық Альфонс
Dialogue: 0,0:06:08.75,0:06:10.78,Default - Copy,Jeane,0,0,0,,Пьета, бастаулар қаласы?
Dialogue: 0,0:06:11.72,0:06:14.95,Default - Copy,Clare,0,0,0,,Мен саған енді артымнан ерудің қажеті жоқ дедім.
Dialogue: 0,0:06:17.46,0:06:20.49,Default - Copy,Clare,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:06:21.96,0:06:25.33,Default - Copy,Helen,0,0,0,,Сен тірісің бе?
Dialogue: 0,0:06:25.33,0:06:26.20,Default - Copy,Clare,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:06:26.77,0:06:28.70,Default - Copy,Helen,0,0,0,,Біраз уақыт болды, Клэр.
Dialogue: 0,0:06:29.20,0:06:30.00,Default - Copy,Clare,0,0,0,,Хелен
Dialogue: 0,0:06:36.34,0:06:39.01,Default - Copy,Deneve,0,0,0,,Ұзақ уақыттан кейін ескі доспен кездескеннен сәлем.
Dialogue: 0,0:06:39.54,0:06:41.35,Default - Copy,Deneve,0,0,0,,Кедергі жасамаңыз
Dialogue: 0,0:06:41.88,0:06:42.61,Default - Copy,Clare,0,0,0,,Денев
Dialogue: 0,0:06:45.85,0:06:48.09,Default - Copy,Jeane,0,0,0,,Бұл сәлемдесу сынды емес.
Dialogue: 0,0:06:48.55,0:06:51.29,Default - Copy,Jeane,0,0,0,,Тіпті ескі таныстарыңызға да құрмет көрсетіңіз.
Dialogue: 0,0:06:51.76,0:06:53.53,Default - Copy,Helen,0,0,0,,Бұл не, Клэр?
Dialogue: 0,0:06:53.53,0:06:56.13,Default - Copy,Helen,0,0,0,,Сіз тағы да қыңыр болып көрінетін адаммен бірігіп жатырсыз.
Dialogue: 0,0:06:56.86,0:06:58.73,Default - Copy,Helen,0,0,0,,Эй, сенің номерің қанша?
Dialogue: 0,0:06:59.06,0:07:00.90,Default - Copy,Helen,0,0,0,,Айтайын дегенім, мен 22 жастамын.
Dialogue: 0,0:07:00.90,0:07:03.17,Default - Copy,Helen,0,0,0,,Бұл жігіт 15 жаста.
Dialogue: 0,0:07:03.17,0:07:07.17,Default - Copy,Jeane,0,0,0,,Менің атым Джин, менің нөмірім 9.
Dialogue: 0,0:07:07.17,0:07:08.41,Default - Copy,Helen,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:07:08.41,0:07:10.48,Default - Copy,Helen,0,0,0,,Сан бір ғана цифр емес пе?
Dialogue: 0,0:07:11.04,0:07:13.41,Default - Copy,Helen,0,0,0,,Клэр 47 саны.
Dialogue: 0,0:07:14.05,0:07:16.58,Default - Copy,Jeane,0,0,0,,Менің өмірімді Клэр сақтап қалды.
Dialogue: 0,0:07:17.05,0:07:20.42,Default - Copy,Jeane,0,0,0,,Оның сандарға қатысы бар ма?
Dialogue: 0,0:07:22.62,0:07:27.16,Default - Copy,Deneve,0,0,0,,Бір таңбалы сан әркімде болмайтын сияқты.
Dialogue: 0,0:07:29.39,0:07:31.00,Default - Copy,Deneve,0,0,0,,Менің атым Денев
Dialogue: 0,0:07:31.33,0:07:32.60,Default - Copy,Deneve,0,0,0,,Бұрын болған оқиға үшін кешіріңіз.
Dialogue: 0,0:07:32.96,0:07:37.04,Default - Copy,Deneve,0,0,0,,Бірақ маған сеніңіз, Хелен ешқандай зиян келтірмеді.
Dialogue: 0,0:07:37.67,0:07:40.21,Default - Copy,Jeane,0,0,0,,Жоқ, мен де үнсіз қалдым.
Dialogue: 0,0:07:41.01,0:07:44.28,Default - Copy,Jeane,0,0,0,,Бұл менің қасымда соғысып жатқан жолдастарыма айтатын сөздерім емес еді.
Dialogue: 0,0:07:44.28,0:07:47.55,Default - Copy,Helen,0,0,0,,Жоқ, кешіріңіз, Джин.
Dialogue: 0,0:07:48.05,0:07:50.35,Default - Copy,Flora,0,0,0,,Барлығың жиналыңдар.
Dialogue: 0,0:07:51.92,0:07:55.39,Default - Copy,Flora,0,0,0,,Мен енді стратегияның контурын түсіндіремін.
Dialogue: 0,0:07:55.92,0:07:57.56,Default - Copy,Flora,0,0,0,,Менің атым Флора
Dialogue: 0,0:07:58.06,0:08:00.29,Default - Copy,Flora,0,0,0,,Ұйым нөмірі 8
Dialogue: 0,0:08:01.69,0:08:03.80,Default - Copy,Helen,0,0,0,,Бұл 8 саны ма?
Dialogue: 0,0:08:04.50,0:08:08.00,Default - Copy,Helen,0,0,0,,Иә, егер бір таңбалы сандары бар екі немесе одан да көп адам болса.
Dialogue: 0,0:08:08.00,0:08:10.77,Default - Copy,Helen,0,0,0,,Көшбасшысың, себебі сен жассың.
Dialogue: 0,0:08:10.77,0:08:15.01,Default - Copy,Flora,0,0,0,,Жоқ, менен кіші адамдар бар.
Dialogue: 0,0:08:16.31,0:08:18.28,Default - Copy,Flora,0,0,0,,Ол көшбасшы
Dialogue: 0,0:08:26.75,0:08:27.65,Default - Copy,Clare,0,0,0,,Милия
Dialogue: 0,0:08:42.33,0:08:45.04,Default - Copy,Carla,0,0,0,,Бұл 6 саны
Dialogue: 0,0:08:45.50,0:08:47.27,Default - Copy,Claudia,0,0,0,,Мирия фантом
Dialogue: 0,0:08:48.87,0:08:52.68,Default - Copy,Miria,0,0,0,,Әркім өз саласынан аянбай еңбек етті.
Dialogue: 0,0:08:53.01,0:08:56.52,Default - Copy,Miria,0,0,0,,Менің атым Мирия, менің нөмірім 6.
Dialogue: 0,0:08:57.12,0:08:59.92,Default - Copy,Miria,0,0,0,,Бұл жолғы миссия - осы солтүстік елде, Альфонста топырлап жүрген бірнеше Оянғандарды жою.
Dialogue: 0,0:09:02.15,0:09:08.73,Default - Copy,Miria,0,0,0,,Бұл жолғы миссия солтүстіктегі Альфонста толып жатқан көптеген Оянған адамдарды жою.
Dialogue: 0,0:09:09.06,0:09:10.70,Default - Copy,Miria,0,0,0,,Сондықтан бұл адам саны
Dialogue: 0,0:09:12.60,0:09:13.70,Default - Copy,Claudia,0,0,0,,Ақымақ
Dialogue: 0,0:09:14.00,0:09:15.87,Default - Copy,Claudia,0,0,0,,Бірнеше оятқыш болса
Dialogue: 0,0:09:16.20,0:09:19.97,Default - Copy,Carla,0,0,0,,Оның үстіне оянғандардың бірігіп топ құруы мүмкін емес.
Dialogue: 0,0:09:19.97,0:09:21.81,Default - Copy,Miria,0,0,0,,Бірақ бұл рас
Dialogue: 0,0:09:24.71,0:09:26.85,Default - Copy,Claudia,0,0,0,,Бірнеше оятқыштар
Dialogue: 0,0:09:27.41,0:09:31.75,Default - Copy,Undine,0,0,0,,Қорықсаң қашасың, қыздар.
Dialogue: 0,0:09:32.75,0:09:37.22,Default - Copy,Undine,0,0,0,,Біздің міндетіміз жындармен және оянған адамдармен күресіп, оларды жеңу.
Dialogue: 0,0:09:37.69,0:09:40.86,Default - Copy,Undine,0,0,0,,Егер сіз басқа адамға қарап, қорқып көрінсеңіз, бұл жақсы емес.
Dialogue: 0,0:09:41.23,0:09:42.93,Default - Copy,Undine,0,0,0,,Енді тоқтамаңыз
Dialogue: 0,0:09:44.80,0:09:46.30,Default - Copy,Helen,0,0,0,,Бұл не?
Dialogue: 0,0:09:46.60,0:09:48.70,Default - Copy,Helen,0,0,0,,Сіз өте иісшілсіз.
Dialogue: 0,0:09:48.70,0:09:51.40,Default - Copy,Helen,0,0,0,,Жапония да үлкен қылышты арқасына көтереді.
Dialogue: 0,0:09:51.40,0:09:54.54,Default - Copy,Deneve,0,0,0,,11 саны. Болдырмау
Dialogue: 0,0:09:54.84,0:09:57.51,Default - Copy,Deneve,0,0,0,,Ол жауынгердің күші бар дейді.
Dialogue: 0,0:09:57.51,0:09:58.88,Default - Copy,Deneve,0,0,0,,Сол қос қолдар.
Dialogue: 0,0:10:00.35,0:10:03.01,Default - Copy,Deneve,0,0,0,,Менен сұрасаңыз
Dialogue: 0,0:10:03.01,0:10:07.25,Default - Copy,Deneve,0,0,0,,Төбелестен басқа ешнәрсеге қажет емес бұлшық еттерді көрсетіп жатқан кезде.
Dialogue: 0,0:10:07.85,0:10:10.09,Default - Copy,Deneve,0,0,0,,Мен өзімді шынымен кішкентай адам сияқты сезінемін.
Dialogue: 0,0:10:10.09,0:10:11.89,Default - Copy,Helen,0,0,0,,Мен осылай айтамын.
Dialogue: 0,0:10:12.59,0:10:13.39,Default - Copy,Undine,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:10:13.83,0:10:15.33,Default - Copy,Undine,0,0,0,,Бұл не?
Dialogue: 0,0:10:15.73,0:10:18.50,Default - Copy,Undine,0,0,0,,Сіз кіммен сөйлесесіз?
Dialogue: 0,0:10:18.50,0:10:19.73,Default - Copy,Deneve,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:10:20.23,0:10:23.40,Default - Copy,Deneve,0,0,0,,Сіз мені естімеу үшін сөйлеп тұрмын деп ойладым.
Dialogue: 0,0:10:23.77,0:10:25.74,Default - Copy,Deneve,0,0,0,,Дауысы қатты шыққан сияқты
Dialogue: 0,0:10:27.11,0:10:29.74,Default - Copy,Undine,0,0,0,,Қызық емес пе?
Dialogue: 0,0:10:29.74,0:10:32.31,Default - Copy,Helen,0,0,0,,Әй, Денев, тоқтат.
Dialogue: 0,0:10:44.02,0:10:45.89,Default - Copy,Flora,0,0,0,,Барлығың тыныш болыңдар.
Dialogue: 0,0:10:45.89,0:10:48.13,Default - Copy,Flora,0,0,0,,Әңгіме әлі біткен жоқ
Dialogue: 0,0:10:48.63,0:10:50.93,Default - Copy,Flora,0,0,0,,Әлі де шу шығарғың келсе
Dialogue: 0,0:10:52.20,0:10:54.93,Default - Copy,Flora,0,0,0,,Мен сенің серігің боламын.
Dialogue: 0,0:11:01.91,0:11:03.48,Default - Copy,Jeane,0,0,0,,Жел флорасы
Dialogue: 0,0:11:03.84,0:11:05.51,Default - Copy,Jeane,0,0,0,,Ұйым нөмірі 8
Dialogue: 0,0:11:05.84,0:11:09.75,Default - Copy,Jeane,0,0,0,,Қылышты суырып, оны кесіп, қайтадан қынап алудың жалғыз әрекеті
Dialogue: 0,0:11:09.75,0:11:12.75,Default - Copy,Jeane,0,0,0,,Басқалардан жылдам және жақсы жауынгер
Dialogue: 0,0:11:13.59,0:11:14.99,Default - Copy,Flora,0,0,0,,Джин мырза
Dialogue: 0,0:11:14.99,0:11:17.32,Default - Copy,Flora,0,0,0,,Сіз де бір таңбалы сансыз.
Dialogue: 0,0:11:17.32,0:11:18.59,Default - Copy,Flora,0,0,0,,Мен сен демалыс үйін сатып аламыз дедің деп анық естідім.
Dialogue: 0,0:11:21.96,0:11:25.63,Default - Copy,Miria,0,0,0,,және 11 саны Undine
Dialogue: 0,0:11:26.46,0:11:28.37,Default - Copy,Miria,0,0,0,,13 саны Вероника
Dialogue: 0,0:11:28.37,0:11:29.40,Default - Copy,Miria,0,0,0,,Алға шық.
Dialogue: 0,0:11:31.27,0:11:36.21,Default - Copy,Miria,0,0,0,,Мені қосқанда, бұл бес адамның әрқайсысы капитан болады.
Dialogue: 0,0:11:36.98,0:11:39.88,Default - Copy,Miria,0,0,0,,Барлығы 24 адам жиналды.
Dialogue: 0,0:11:39.88,0:11:42.71,Default - Copy,Miria,0,0,0,,Ендеше бес команда құрыңдар.
Dialogue: 0,0:11:43.25,0:11:45.88,Default - Copy,Miria,0,0,0,,Бір командадағы адам саны 45 адам.
Dialogue: 0,0:11:45.88,0:11:50.02,Default - Copy,Miria,0,0,0,,Басқаша айтқанда, ол қалыпты ояту аңшылығы сияқты құрылымға ие.
Dialogue: 0,0:11:50.02,0:11:52.56,Default - Copy,Undine,0,0,0,,Мен көремін.
Dialogue: 0,0:11:53.09,0:11:56.23,Default - Copy,Miria,0,0,0,,Бұл стратегия ретінде ерекше ештеңе жоқ.
Dialogue: 0,0:11:56.56,0:11:59.33,Default - Copy,Miria,0,0,0,,Бір команда бір оянған адамға қарсы
Dialogue: 0,0:11:59.76,0:12:00.97,Default - Copy,Miria,0,0,0,,Бұл негіз
Dialogue: 0,0:12:02.20,0:12:03.64,Default - Copy,Miria,0,0,0,,Ертең орындалады
Dialogue: 0,0:12:05.27,0:12:07.01,Default - Copy,Miria,0,0,0,,Содан кейін командаларды бөліңіз.
Dialogue: 0,0:12:07.31,0:12:08.81,Default - Copy,Miria,0,0,0,,Қарсылықтар қабылданбады
Dialogue: 0,0:12:09.74,0:12:11.68,Default - Copy,Miria,0,0,0,,Сан 14 Синтия
Dialogue: 0,0:12:12.78,0:12:13.68,Default - Copy,Cynthia,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:12:13.68,0:12:14.68,Default - Copy,Miria,0,0,0,,Вероника командасы
Dialogue: 0,0:12:15.41,0:12:19.12,Default - Copy,Miria,0,0,0,,№ 15 Денев Ундине командасы
Dialogue: 0,0:12:19.68,0:12:23.42,Default - Copy,Miria,0,0,0,,№ 17 Элиза Джин командасы
Dialogue: 0,0:12:23.89,0:12:26.93,Default - Copy,Miria,0,0,0,,№ 18 Лилия Флора командасы
Dialogue: 0,0:12:27.53,0:12:30.76,Default - Copy,Miria,0,0,0,,№20 Queenie Milia командасы
Dialogue: 0,0:12:31.13,0:12:34.93,Default - Copy,Miria,0,0,0,,№ 22 Хелен Вероника командасы
Dialogue: 0,0:12:34.96,0:12:37.86,Default - Copy,Helen,0,0,0,,Бұл не? Бұл Мирия командасы емес пе?
Dialogue: 0,0:12:35.30,0:12:39.10,Default - Copy,Miria,0,0,0,,№ 24 Zelda Undine командасы
Dialogue: 0,0:12:39.67,0:12:43.21,Default - Copy,Miria,0,0,0,,№ 27 Emelia Gene Team
Dialogue: 0,0:12:59.72,0:13:02.83,Default - Copy,Helen,0,0,0,,Мен оны кие алмас едім.
Dialogue: 0,0:13:02.83,0:13:03.90,Default - Copy,Clare,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:13:04.40,0:13:07.77,Default - Copy,Clare,0,0,0,,Қайда бара жатқаның ешкімді қызықтырмайды.
Dialogue: 0,0:13:08.80,0:13:10.70,Default - Copy,Helen,0,0,0,,Барлығы жиналып қалды.
Dialogue: 0,0:13:14.51,0:13:16.88,Default - Copy,Helen,0,0,0,,Тағы бір соңғы келу.
Dialogue: 0,0:13:18.21,0:13:19.24,Default - Copy,Clare,0,0,0,,Милия
Dialogue: 0,0:13:20.21,0:13:21.78,Default - Copy,Miria,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:13:28.99,0:13:30.56,Default - Copy,Helen,0,0,0,,Бұл кездесуді еске алу.
Dialogue: 0,0:13:39.76,0:13:42.27,Default - Copy,Miria,0,0,0,,Барлығы жақсы өмір сүрді.
Dialogue: 0,0:13:42.93,0:13:44.27,Default - Copy,Miria,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:13:47.91,0:13:49.74,Default - Copy,Helen,0,0,0,,Онда кім бар?
Dialogue: 0,0:13:54.01,0:13:54.98,Default - Copy,Deneve,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:13:54.98,0:13:56.11,Default - Copy,Helen,0,0,0,,Клэр
Dialogue: 0,0:13:56.11,0:13:57.85,Default - Copy,Helen,0,0,0,,Міне солай болды.
Dialogue: 0,0:13:57.85,0:13:59.65,Default - Copy,Clare,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:14:00.15,0:14:02.39,Default - Copy,Clare,0,0,0,,Ген бізбен бірдей позицияда.
Dialogue: 0,0:14:04.42,0:14:08.83,Default - Copy,Jeane,0,0,0,,Мен ескі достардың кездесуіне кедергі келтіргім келмеді.
Dialogue: 0,0:14:08.83,0:14:12.33,Default - Copy,Jeane,0,0,0,,Мен де туыс емес сияқтымын.
Dialogue: 0,0:14:16.20,0:14:19.40,Default - Copy,Miria,0,0,0,,Дене оянған күйден оралу?
Dialogue: 0,0:14:20.07,0:14:23.14,Default - Copy,Miria,0,0,0,,Ерекше психикалық күштің арқасында болуы мүмкін
Dialogue: 0,0:14:23.14,0:14:24.54,Default - Copy,Miria,0,0,0,,Мен сене алар емеспін
Dialogue: 0,0:14:25.28,0:14:28.65,Default - Copy,Miria,0,0,0,,Клэр Мен мұны алғаш кездескен кезде байқадым.
Dialogue: 0,0:14:28.65,0:14:30.82,Default - Copy,Miria,0,0,0,,Бұл оң қол да басқа.
Dialogue: 0,0:14:31.38,0:14:35.02,Default - Copy,Miria,0,0,0,,Мен оны айтарлықтай күшке ие біреудің оң қолы ретінде көрдім.
Dialogue: 0,0:14:36.02,0:14:37.12,Default - Copy,Miria,0,0,0,,Кімнің?
Dialogue: 0,0:14:37.12,0:14:39.22,Default - Copy,Helen,0,0,0,,Оң қол
Dialogue: 0,0:14:39.66,0:14:41.46,Default - Copy,Clare,0,0,0,,Кешіріңіз, бірақ мен олай айта алмаймын.
Dialogue: 0,0:14:42.16,0:14:46.30,Default - Copy,Miria,0,0,0,,Жағдайыңыз жақсармай тұрған сияқты.
Dialogue: 0,0:14:46.30,0:14:48.50,Default - Copy,Clare,0,0,0,,Бұл тек мен емес
Dialogue: 0,0:14:49.30,0:14:53.51,Default - Copy,Clare,0,0,0,,Осы жолы жиналған барлық 24 адам туралы да солай айтуға болады.
Dialogue: 0,0:14:55.64,0:15:00.75,Default - Copy,Clare,0,0,0,,Бұл стратегияның сәтті болу ықтималдығы қандай?
Dialogue: 0,0:15:03.45,0:15:06.99,Default - Copy,Miria,0,0,0,,Бұл стратегияда табысқа жету ықтималдығы нөлге тең.
Dialogue: 0,0:15:07.52,0:15:08.09,Default - Copy,Helen,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:15:09.59,0:15:11.69,Default - Copy,Miria,0,0,0,,Тек бірнеше оянған адамдар болса
Dialogue: 0,0:15:11.69,0:15:14.69,Default - Copy,Miria,0,0,0,,Табыстың ықтималдығы нөлге тең емес
Dialogue: 0,0:15:14.69,0:15:18.73,Default - Copy,Miria,0,0,0,,Бірақ олардың артында біреу күтіп тұр.
Dialogue: 0,0:15:19.10,0:15:21.43,Default - Copy,Miria,0,0,0,,Барлық әрекеттер бекер
Dialogue: 0,0:15:21.43,0:15:23.94,Default - Copy,Helen,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:15:24.70,0:15:27.67,Default - Copy,Clare,0,0,0,,Солтүстік жерді билеуші күміс патша
Dialogue: 0,0:15:28.11,0:15:30.81,Default - Copy,Clare,0,0,0,,Тұңғиықтағы Исли
Dialogue: 0,0:15:31.58,0:15:33.31,Default - Copy,Helen,0,0,0,,Бірінші абиссаль
Dialogue: 0,0:15:34.08,0:15:35.41,Default - Copy,Deneve,0,0,0,,Эйсли
Dialogue: 0,0:15:36.05,0:15:37.02,Default - Copy,Miria,0,0,0,,Иә.
Dialogue: 0,0:15:37.52,0:15:46.72,Default - Copy,Miria,0,0,0,,Бұл операцияның мәні солтүстіктегі барлық Оянғандарды және оларды сахнаның артында басқаратын Абиссалды Ислиді бағындыру болып табылады.
Dialogue: 0,0:15:47.29,0:15:48.09,Default - Copy,Helen,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:15:49.13,0:15:51.33,Default - Copy,Helen,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:15:51.33,0:15:53.80,Default - Copy,Helen,0,0,0,,Ұйым не ойлады?
Dialogue: 0,0:15:54.50,0:15:55.27,Default - Copy,Deneve,0,0,0,,Хелен
Dialogue: 0,0:16:00.81,0:16:05.34,Default - Copy,Miria,0,0,0,,Ұйымның мақсаты қарсы шараларды әзірлеу үшін уақытты ұту болуы мүмкін.
Dialogue: 0,0:16:06.04,0:16:07.18,Default - Copy,Miria,0,0,0,,Басқаша айтқанда
Dialogue: 0,0:16:07.68,0:16:09.28,Default - Copy,Miria,0,0,0,,Жай ғана лақтырылатын бөлік
Dialogue: 0,0:16:13.72,0:16:16.82,Default - Copy,A.B.1,0,0,0,,Бұл Пиета қаласы ма?
Dialogue: 0,0:16:16.82,0:16:19.42,Default - Copy,A.B.1,0,0,0,,Бірақ біз бірге жиналдық.
Dialogue: 0,0:16:19.42,0:16:20.56,Default - Copy,A.B.1,0,0,0,,Неше адам бар?
Dialogue: 0,0:16:20.93,0:16:22.16,Default - Copy,A.B.2,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:16:24.00,0:16:25.53,Default - Copy,A.B.2,0,0,0,,24 адам.
Dialogue: 0,0:16:27.23,0:16:30.03,Default - Copy,A.B.1,0,0,0,,Қанша адам болса да, бәріміз бірдейміз.
Dialogue: 0,0:16:30.50,0:16:32.00,Default - Copy,A.B.3,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:16:32.00,0:16:33.37,Default - Copy,A.B.2,0,0,0,,Не істеуім керек?
Dialogue: 0,0:16:33.37,0:16:35.91,Default - Copy,A.B.2,0,0,0,,Біздің рөліміз алдыңғы шептегі барлау болады.
Dialogue: 0,0:16:36.94,0:16:40.85,Default - Copy,A.B.1,0,0,0,,Менің алдымда сүйкімді жасөспірімдер жиналып қалды.
Dialogue: 0,0:16:41.18,0:16:43.65,Default - Copy,A.B.1,0,0,0,,Сіз араласпауыңыз керек.
Dialogue: 0,0:16:43.65,0:16:45.68,Default - Copy,A.B.1,0,0,0,,Кем дегенде сәлемдесу
Dialogue: 0,0:16:47.65,0:16:50.05,Default - Copy,Miria,0,0,0,,Мен оны жоғалттым, бірінші қадам жасалды.
Dialogue: 0,0:16:58.23,0:16:59.60,Default - Copy,villager,0,0,0,,Бұл не?
Dialogue: 0,0:17:00.33,0:17:02.20,Default - Copy,A.B.1,0,0,0,,Содан кейін бірінші барыңыз.
Dialogue: 0,0:17:04.24,0:17:06.80,Default - Copy,A.B.2,0,0,0,,А, мен кеттім.
Dialogue: 0,0:17:06.80,0:17:09.34,Default - Copy,A.B.3,0,0,0,,Оған мүлдем көмектесу мүмкін емес.
Dialogue: 0,0:17:14.28,0:17:15.88,Default - Copy,A.B.1,0,0,0,,Қайырлы кеш
Dialogue: 0,0:17:15.88,0:17:17.95,Default - Copy,A.B.1,0,0,0,,Пиета қаласының тұрғындары
Dialogue: 0,0:17:21.55,0:17:23.99,Default - Copy,A.B.1,0,0,0,,Ал қош бол
Dialogue: 0,0:17:25.09,0:17:26.02,Default - Copy,villager,0,0,0,,Канжу Нагаре
Dialogue: 0,0:17:37.50,0:17:39.70,Default - Copy,A.B.1,0,0,0,,Ол өте жақсы қозғалады.
Dialogue: 0,0:17:41.21,0:17:43.27,Default - Copy,Miria,0,0,0,,Барлық мүшелер жиналыңдар.
Dialogue: 0,0:17:47.01,0:17:50.08,Default - Copy,A.B.1,0,0,0,,Бұл керемет.
Dialogue: 0,0:17:50.38,0:17:54.52,Default - Copy,A.B.1,0,0,0,,Осыншама қыздың ортасында жүрген сирек.
Dialogue: 0,0:17:55.02,0:17:58.36,Default - Copy,Miria,0,0,0,,Алдағы жауды біздің Милия командасы басқарады.
Dialogue: 0,0:17:58.69,0:18:00.66,Default - Copy,Miria,0,0,0,,Флора командасы оң жақ төбеде
Dialogue: 0,0:18:00.66,0:18:04.06,Default - Copy,Miria,0,0,0,,Ген тобына сол жақтағы тас бағананың үстіндегі адам шабуыл жасады.
Dialogue: 0,0:18:04.50,0:18:07.07,Default - Copy,Miria,0,0,0,,Undine Veronica командасы күту режимінде
Dialogue: 0,0:18:07.07,0:18:09.70,Default - Copy,Miria,0,0,0,,Жағдайға байланысты әлсіз топқа барыңыз.
Dialogue: 0,0:18:10.27,0:18:11.30,Default - Copy,A.B.2,0,0,0,,Иә, иә
Dialogue: 0,0:18:11.74,0:18:15.17,Default - Copy,A.B.2,0,0,0,,Мен кенеттен шабуылға ұшырадым деп ойладым.
Dialogue: 0,0:18:15.17,0:18:17.28,Default - Copy,A.B.2,0,0,0,,Сіз таңқаларлық сабырлы болдыңыз.
Dialogue: 0,0:18:17.28,0:18:21.01,Default - Copy,A.B.2,0,0,0,,Мен абыржуды пайдаланып, дәмді нәрсе әкелуді жоспарладым.
Dialogue: 0,0:18:21.01,0:18:22.81,Default - Copy,A.B.2,0,0,0,,Әлдеқашан тозған
Dialogue: 0,0:18:22.81,0:18:26.58,Default - Copy,A.B.3,0,0,0,,Менің ойымша, ол бірнеше рет көп ретсіздікті басынан өткерді.
Dialogue: 0,0:18:26.95,0:18:28.29,Default - Copy,A.B.3,0,0,0,,Ол жақсы көшбасшы.
Dialogue: 0,0:18:28.75,0:18:29.52,Default - Copy,A.B.3,0,0,0,,Бірақ
Dialogue: 0,0:18:32.89,0:18:39.30,Default - Copy,A.B.3,0,0,0,,Оянушыларға бәрі бірдей үйренбегенін ұмытасың.
Dialogue: 0,0:18:39.30,0:18:40.30,Default - Copy,Miria,0,0,0,,Кеттік
Dialogue: 0,0:18:47.17,0:18:48.41,Default - Copy,A.B.1,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:18:49.24,0:18:50.68,Default - Copy,A.B.1,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:18:50.68,0:18:52.64,Default - Copy,A.B.1,0,0,0,,Кішкене қозғалыс
Dialogue: 0,0:18:55.11,0:18:55.68,Default - Copy,Clare,0,0,0,,Ол тез.
Dialogue: 0,0:18:56.95,0:19:02.25,Default - Copy,Flora,0,0,0,,39 47 саны менің командама пайдалы емес шығар.
Dialogue: 0,0:19:05.39,0:19:08.56,Default - Copy,Flora,0,0,0,,Оянған денеге айналмас бұрын ойынды шешіңіз
Dialogue: 0,0:19:11.06,0:19:12.06,Default - Copy,Clare,0,0,0,,Яғни
Dialogue: 0,0:19:13.00,0:19:14.87,Default - Copy,Flora,0,0,0,,Қылыш траекториясы майысқан
Dialogue: 0,0:19:20.44,0:19:22.21,Default - Copy,Clare,0,0,0,,Бұл жігіт жындарды басқарады.
Dialogue: 0,0:19:22.21,0:19:25.04,Default - Copy,Clare,0,0,0,,Денеңізді басқа адамның сиқырлы энергиясымен үйлестіре отырып, манипуляциялаңыз.
Dialogue: 0,0:19:26.41,0:19:27.55,Default - Copy,clay,0,0,0,,Дене
Dialogue: 0,0:19:31.85,0:19:34.09,Default - Copy,Flora,0,0,0,,Дененің қозғалуы
Dialogue: 0,0:19:37.06,0:19:39.02,Default - Copy,clay,0,0,0,,Өтінемін, қашыңыз
Dialogue: 0,0:19:39.79,0:19:42.89,Default - Copy,clay,0,0,0,,Мен денемнің айтқанын тыңдамаймын
Dialogue: 0,0:19:46.40,0:19:48.87,Default - Copy,clay,0,0,0,,Тез қашыңыз
Dialogue: 0,0:19:54.11,0:19:56.21,Default - Copy,Clare,0,0,0,,Айриннен сұраңыз
Dialogue: 0,0:20:02.88,0:20:04.42,Default - Copy,A.B.2,0,0,0,,Не?
Dialogue: 0,0:20:04.42,0:20:06.55,Default - Copy,A.B.2,0,0,0,,Оның оң қолы ерекше.
Dialogue: 0,0:20:13.59,0:20:15.49,Default - Copy,A.B.2,0,0,0,,Мен мұны істеймін.
Dialogue: 0,0:20:15.49,0:20:17.60,Default - Copy,A.B.2,0,0,0,,Бұл өте қызық болып барады.
Dialogue: 0,0:20:17.60,0:20:19.30,Default - Copy,A.B.2,0,0,0,,Өйткені бұл
Dialogue: 0,0:20:19.30,0:20:20.47,Default - Copy,A.B.2,0,0,0,,Өйткені бұл
Dialogue: 0,0:20:20.47,0:20:22.60,Default - Copy,A.B.2,0,0,0,,Сіз құбыжық болуды тоқтата алмайсыз.
Dialogue: 0,0:20:27.94,0:20:31.34,Default - Copy,A.B.2,0,0,0,,Бәрің де бөлініп кетті.
Dialogue: 0,0:20:35.15,0:20:37.78,Default - Copy,A.B.3,0,0,0,,Ей, сен басшы болмайсың.
Dialogue: 0,0:20:38.32,0:20:41.79,Default - Copy,A.B.3,0,0,0,,Сіз оны пайдалана алмайтыныңызды басынан бастап білуіңіз керек еді.
Dialogue: 0,0:20:42.29,0:20:45.36,Default - Copy,A.B.3,0,0,0,,Мен оны қимаймын, соңына дейін қорғауға тырысамын
Dialogue: 0,0:20:45.36,0:20:47.46,Default - Copy,A.B.3,0,0,0,,Нашар үйлестіру
Dialogue: 0,0:20:47.46,0:20:49.33,Default - Copy,A.B.3,0,0,0,,Нәтиже – бұл
Dialogue: 0,0:20:49.66,0:20:52.76,Default - Copy,A.B.3,0,0,0,,О дүниеде достарыңнан кешірім сұрама.
Dialogue: 0,0:20:57.14,0:21:00.97,Default - Copy,Helen,0,0,0,,Сіздің ұрысыңыз оны қару ретінде пайдаланып жатқан сияқты.
Dialogue: 0,0:21:00.97,0:21:02.17,Default - Copy,Helen,0,0,0,,Мен көмекке келдім.
Dialogue: 0,0:21:02.54,0:21:03.64,Default - Copy,Jeane,0,0,0,,Хелен
Dialogue: 0,0:21:10.18,0:21:11.02,Default - Copy,Clare,0,0,0,,Денев
Dialogue: 0,0:21:11.42,0:21:13.18,Default - Copy,Deneve,0,0,0,,Қаһарлы жауға ұқсайды.
Dialogue: 0,0:21:13.18,0:21:14.39,Default - Copy,Deneve,0,0,0,,Көмекке келді
Dialogue: 0,0:21:14.39,0:21:16.19,Default - Copy,Deneve,0,0,0,,Өздеріңізді бекітіңіздер
Dialogue: 0,0:21:16.59,0:21:18.36,Default - Copy,Deneve,0,0,0,,Барлығын бірден аяқтаймын.
Dialogue: 0,0:21:22.86,0:21:24.10,Default - Copy,Undine,0,0,0,,Мен келе жатырмын
Dialogue: 0,0:22:40.40,0:22:42.30,Default - Copy,,0,0,0,,Ақ жер
Dialogue: 0,0:22:42.30,0:22:43.84,Default - Copy,,0,0,0,,Ақ түн
Dialogue: 0,0:22:43.94,0:22:46.54,Default - Copy,,0,0,0,,Қошмар ашылды
