Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:31.05,0:00:33.04,Default,,0,0,0,,(Ханами) Кісі өлтіру ниетіне тежегіш салатын адам —
Dialogue: 0,0:00:33.07,0:00:35.03,Default,,0,0,0,,Аман қалу
Dialogue: 0,0:00:36.00,0:00:36.50,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:00:42.07,0:00:46.09,Default,,0,0,0,,Сіз үш жындыны оңай жеңдіңіз бе?
Dialogue: 0,0:00:46.09,0:00:47.08,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:00:48.06,0:00:50.01,Default,,0,0,0,,Бұл үлкен мәселе емес
Dialogue: 0,0:00:50.06,0:00:52.01,Default,,0,0,0,,Қандай ерекше жеңіс.
Dialogue: 0,0:00:52.05,0:00:55.01,Default,,0,0,0,,Соңғы кездері мен бақылаусыз әрекет етпеймін.
Dialogue: 0,0:00:55.04,0:00:57.09,Default,,0,0,0,,Адал немесе шыншыл болып кеткен сияқты.
Dialogue: 0,0:00:58.08,0:01:00.04,Default,,0,0,0,,Не болды?
Dialogue: 0,0:01:01.04,0:01:07.04,Default,,0,0,0,,Өткен күні аң аулау кезінде мен өз қабілеттерімді жек көретінімді білдім.
Dialogue: 0,0:01:09.07,0:01:12.01,Default,,0,0,0,,Мұны қайталай бергенім үшін кешіріңіз, бірақ бұл жұмыс.
Dialogue: 0,0:01:12.09,0:01:14.08,Default,,0,0,0,,Орналасқан жері Гонар, солтүстіктегі қала.
Dialogue: 0,0:01:15.02,0:01:17.05,Default,,0,0,0,,Оянғандар сонда аң аулады ма?
Dialogue: 0,0:01:18.00,0:01:19.01,Default,,0,0,0,,Оянды
Dialogue: 0,0:01:19.05,0:01:21.09,Default,,0,0,0,,Өкінішке орай, бұл Присцилла емес.
Dialogue: 0,0:01:21.09,0:01:23.09,Default,,0,0,0,,Бұл бұрынғыдай бір таңбалы сан.
Dialogue: 0,0:01:24.01,0:01:27.09,Default,,0,0,0,,Бір күнгі оянған адамнан әлдеқайда күшті.
Dialogue: 0,0:01:28.03,0:01:31.07,Default,,0,0,0,,Өлгің келмесе, абай бол.
Dialogue: 0,0:01:33.04,0:01:35.00,Default,,0,0,0,,Мен өлмеймін
Dialogue: 0,0:01:35.07,0:01:36.08,Default,,0,0,0,,Ешқашан
Dialogue: 0,0:01:46.06,0:01:48.03,Default,,0,0,0,,Бұл сенімді сөз.
Dialogue: 0,0:01:50.00,0:01:51.04,Default,,0,0,0,,Мен сенің үмітіңді артамын
Dialogue: 0,0:03:03.01,0:03:06.00,Default,,0,0,0,,Біз Гонар қаласына ертең жететін сияқтымыз.
Dialogue: 0,0:03:11.00,0:03:13.04,Default,,0,0,0,,Раки, осы жерде күте аласыз.
Dialogue: 0,0:03:19.00,0:03:20.03,Default,,0,0,0,,Мен де сенімен бірге барамын.
Dialogue: 0,0:03:21.01,0:03:22.04,Default,,0,0,0,,Бұл қауіпті қылыш.
Dialogue: 0,0:03:22.04,0:03:23.07,Default,,0,0,0,,Алмаңыз
Dialogue: 0,0:03:23.07,0:03:25.00,Default,,0,0,0,,Бірақ Клэр, И
Dialogue: 0,0:03:25.00,0:03:27.03,Default,,0,0,0,,Менің қайтуымды осында күтіңіз.
Dialogue: 0,0:03:27.09,0:03:28.05,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:04:18.00,0:04:19.08,Default,,0,0,0,,Серіктердің белгілері
Dialogue: 0,0:04:21.05,0:04:22.06,Default,,0,0,0,,Не?
Dialogue: 0,0:04:23.04,0:04:27.08,Default,,0,0,0,,Бұл сезім менің денемдегі әрбір жасуша сияқты ескерту жібереді.
Dialogue: 0,0:04:43.09,0:04:46.08,Default,,0,0,0,,Иә.
Dialogue: 0,0:04:48.05,0:04:51.07,Default,,0,0,0,,Мен достарымды бірге деп ойладым.
Dialogue: 0,0:04:53.05,0:04:55.02,Default,,0,0,0,,Олардың барлығы бізде жоқ.
Dialogue: 0,0:04:55.02,0:04:57.02,Default,,0,0,0,,Сен және мен
Dialogue: 0,0:04:59.04,0:05:01.09,Default,,0,0,0,,Екеуің Оянғандарды аулайсыңдар ма?
Dialogue: 0,0:05:02.03,0:05:03.04,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:05:03.09,0:05:07.00,Default,,0,0,0,,Бірақ шын мәнінде мен өзіммен жақсы болдым.
Dialogue: 0,0:05:07.04,0:05:09.07,Default,,0,0,0,,Сіз бонус сияқтысыз
Dialogue: 0,0:05:10.05,0:05:11.08,Default,,0,0,0,,Бір таңбалы сан
Dialogue: 0,0:05:12.03,0:05:14.00,Default,,0,0,0,,Үздік бестіктің бірі?
Dialogue: 0,0:05:14.09,0:05:16.00,Default,,0,0,0,,Белгі
Dialogue: 0,0:05:16.07,0:05:18.05,Default,,0,0,0,,Елтаңбаға қарап білуге болады
Dialogue: 0,0:05:23.09,0:05:28.05,Default,,0,0,0,,Сіз оянған адамның иісін аласыз.
Dialogue: 0,0:05:29.04,0:05:31.00,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:05:31.00,0:05:32.07,Default,,0,0,0,,Кішкене иіскеп көрейін
Dialogue: 0,0:05:33.03,0:05:35.05,Default,,0,0,0,,Маған бұл иіс ұнайды.
Dialogue: 0,0:05:36.05,0:05:38.04,Default,,0,0,0,,Сіз қозғала алмайсыз, солай ма?
Dialogue: 0,0:05:38.08,0:05:40.04,Default,,0,0,0,,Бұл Миками растағанының белгісі
Dialogue: 0,0:05:43.03,0:05:47.08,Default,,0,0,0,,Сондықтан сіз қозғалу мағынасыз деп отырсыз.
Dialogue: 0,0:05:56.00,0:05:57.05,Default,,0,0,0,,Біртүрлі дәм
Dialogue: 0,0:05:58.08,0:06:04.00,Default,,0,0,0,,Әй, бірақ бұл дәм әйтеуір есімде.
Dialogue: 0,0:06:04.09,0:06:07.05,Default,,0,0,0,,Сіз шынымен де біздің бірімізсіз бе?
Dialogue: 0,0:06:08.02,0:06:10.02,Default,,0,0,0,,Клэрді жібер
Dialogue: 0,0:06:13.09,0:06:15.02,Default,,0,0,0,,Раки
Dialogue: 0,0:06:15.02,0:06:17.01,Default,,0,0,0,,Егер мен Клэрмен ары қарай аралассам
Dialogue: 0,0:06:17.09,0:06:19.01,Default,,0,0,0,,Мен сені кешірмеймін
Dialogue: 0,0:06:21.05,0:06:23.02,Default,,0,0,0,,Ол бала ше?
Dialogue: 0,0:06:24.02,0:06:26.06,Default,,0,0,0,,Сіздің досыңыз
Dialogue: 0,0:06:28.01,0:06:30.09,Default,,0,0,0,,Менің ойымша, бұл әдемі емес.
Dialogue: 0,0:06:32.05,0:06:35.07,Default,,0,0,0,,Тек дене жарылғанда немесе жарылғанда
Dialogue: 0,0:06:36.00,0:06:39.02,Default,,0,0,0,,Айналаны бояйтын қызғылт қызыл түс
Dialogue: 0,0:06:41.03,0:06:45.01,Default,,0,0,0,,Әдемі гүлдей берейік, балақай.
Dialogue: 0,0:06:47.07,0:06:48.09,Default,,0,0,0,,(Норияки) Уф. (Жан) Мм…
Dialogue: 0,0:06:51.04,0:06:53.06,Default,,0,0,0,,№4 Офелия
Dialogue: 0,0:06:54.08,0:06:58.09,Default,,0,0,0,,Белгіні көргенде жүзіңіз өзгерді.
Dialogue: 0,0:06:59.06,0:07:01.05,Default,,0,0,0,,Сіз мені танисыз ба?
Dialogue: 0,0:07:02.04,0:07:03.09,Default,,0,0,0,,Оны қайдан естідің?
Dialogue: 0,0:07:05.09,0:07:07.04,Default,,0,0,0,,Мені қызықтырады.
Dialogue: 0,0:07:07.08,0:07:10.01,Default,,0,0,0,,Бірақ бұған дейін
Dialogue: 0,0:07:17.09,0:07:21.02,Default,,0,0,0,,О, таң қаларлықтай алыс.
Dialogue: 0,0:07:24.05,0:07:25.07,Default,,0,0,0,,Еліктеудің қандай түрі?
Dialogue: 0,0:07:26.02,0:07:30.01,Default,,0,0,0,,Заң бойынша біреуді өлтірсек, өзіміз өлетін боламыз.
Dialogue: 0,0:07:30.05,0:07:33.00,Default,,0,0,0,,Өлгің келе ме?
Dialogue: 0,0:07:33.04,0:07:35.06,Default,,0,0,0,,Балалар сендер ақымақсыңдар.
Dialogue: 0,0:07:35.06,0:07:37.05,Default,,0,0,0,,Бұл өз-өзіне есеп беру емес.
Dialogue: 0,0:07:38.01,0:07:41.07,Default,,0,0,0,,Өз басыңызды кесіп жатқанда, қалайша есеп беруге батылыңыз бар?
Dialogue: 0,0:07:41.07,0:07:43.00,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:07:43.03,0:07:46.01,Default,,0,0,0,,Тіпті біреу қарап тұрса да
Dialogue: 0,0:07:46.01,0:07:48.08,Default,,0,0,0,,Немесе олардан құтылыңыз.
Dialogue: 0,0:07:52.09,0:07:54.03,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:07:54.03,0:07:55.08,Default,,0,0,0,,Ойын ойнайық
Dialogue: 0,0:08:08.03,0:08:11.05,Default,,0,0,0,,Жарайды, мен ережелерді түсіндіремін.
Dialogue: 0,0:08:11.05,0:08:14.00,Default,,0,0,0,,Мен қазір ол қызбен ұрысамын.
Dialogue: 0,0:08:14.07,0:08:16.03,Default,,0,0,0,,Әрине мен байсалды емеспін.
Dialogue: 0,0:08:16.08,0:08:19.09,Default,,0,0,0,,Сол баланың қабілетіне сәйкес келетін күшпен.
Dialogue: 0,0:08:19.09,0:08:25.09,Default,,0,0,0,,Бірақ мен минут сайын күш пен жылдамдықты бір сатыға арттырамын.
Dialogue: 0,0:08:27.05,0:08:28.05,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:28.05,0:08:32.02,Default,,0,0,0,,Менің басым он минуттан кейін ұшып кетуі мүмкін деп ойлаймын.
Dialogue: 0,0:08:32.05,0:08:36.01,Default,,0,0,0,,Оған дейін аяғыңызды біріктіріп, көмектесіңіз.
Dialogue: 0,0:08:36.07,0:08:40.00,Default,,0,0,0,,Ұзақ болса да ол бала өледі.
Dialogue: 0,0:08:40.00,0:08:43.09,Default,,0,0,0,,Біртүрлі жолмен тез жабысып қалсаңыз, көмектеспейді.
Dialogue: 0,0:08:43.09,0:08:46.00,Default,,0,0,0,,Қызық емес пе?
Dialogue: 0,0:08:46.07,0:08:47.06,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:08:48.07,0:08:49.07,Default,,0,0,0,,Олай болса
Dialogue: 0,0:08:51.00,0:08:51.50,Default,,0,0,0,,Жақсы
Dialogue: 0,0:08:53.06,0:08:54.06,Default,,0,0,0,,Бастау
Dialogue: 0,0:09:19.01,0:09:20.07,Default,,0,0,0,,Сиқырлы күшіңізді босатыңыз
Dialogue: 0,0:09:20.07,0:09:23.04,Default,,0,0,0,,Жөндеу мен регенерацияны қайталау арқылы жасай алуыңыз керек.
Dialogue: 0,0:09:27.08,0:09:28.09,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:09:28.09,0:09:30.04,Default,,0,0,0,,Сіз ойлағаннан да көп нәрсені жасайсыз.
Dialogue: 0,0:09:30.04,0:09:31.07,Default,,0,0,0,,Маған біраз әсер қалдырды.
Dialogue: 0,0:09:35.02,0:09:37.03,Default,,0,0,0,,Сәл ертерек
Dialogue: 0,0:09:37.03,0:09:39.06,Default,,0,0,0,,Бір деңгей жоғары
Dialogue: 0,0:09:43.05,0:09:46.05,Default,,0,0,0,,Қылышты дұрыс ұстау керек.
Dialogue: 0,0:09:46.05,0:09:48.01,Default,,0,0,0,,Бұл екі жүзді қылыш.
Dialogue: 0,0:09:49.00,0:09:50.01,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:09:53.03,0:09:55.01,Default,,0,0,0,,О, жоқ, солай.
Dialogue: 0,0:09:56.04,0:10:00.03,Default,,0,0,0,,Айттым ғой, тым тез, шала істеме.
Dialogue: 0,0:10:00.09,0:10:02.04,Default,,0,0,0,,Тіпті бір-біріне жабыспайды.
Dialogue: 0,0:10:05.04,0:10:08.01,Default,,0,0,0,,Егер жара уақыт өте келе жабылса
Dialogue: 0,0:10:08.04,0:10:11.03,Default,,0,0,0,,Сіз оларды қайтадан біріктіре алмайсыз.
Dialogue: 0,0:10:12.09,0:10:13.09,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:10:13.09,0:10:15.00,Default,,0,0,0,,Егер солай істесем…
Dialogue: 0,0:10:17.03,0:10:19.06,Default,,0,0,0,,Ол өте адал және жақсы қыз.
Dialogue: 0,0:10:19.06,0:10:22.03,Default,,0,0,0,,Бұл мен күткен реакция болды.
Dialogue: 0,0:10:22.03,0:10:23.04,Default,,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:10:24.08,0:10:26.03,Default,,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:10:26.09,0:10:28.05,Default,,0,0,0,,Тенген мырза… Мен үшін уайымдамаңыз; сіз қазір кетуіңіз керек.
Dialogue: 0,0:10:28.05,0:10:29.09,Default,,0,0,0,,Көңілді бала
Dialogue: 0,0:10:30.05,0:10:32.03,Default,,0,0,0,,Әй, қара!
Dialogue: 0,0:10:32.03,0:10:35.05,Default,,0,0,0,,Бұл бала сіздің зейініңізді бұзбау үшін.
Dialogue: 0,0:10:35.05,0:10:38.05,Default,,0,0,0,,Қанша кесіп алсам да, ыңылдамаймын.
Dialogue: 0,0:10:39.00,0:10:41.09,Default,,0,0,0,,Қанды, көз жасымен
Dialogue: 0,0:10:41.09,0:10:43.09,Default,,0,0,0,,Аузыңды жап, балам.
Dialogue: 0,0:10:45.09,0:10:47.04,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:10:49.07,0:10:51.05,Default,,0,0,0,,Бейқам болмаңыз
Dialogue: 0,0:10:51.09,0:10:56.04,Default,,0,0,0,,Мен сенің тырнақтай шабуылдарыңды тырнап та алмаймын.
Dialogue: 0,0:10:59.04,0:11:00.09,Default,,0,0,0,,Мен шыдай алмаймын.
Dialogue: 0,0:11:01.07,0:11:03.01,Default,,0,0,0,,Взвод
Dialogue: 0,0:11:03.01,0:11:04.07,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:11:04.07,0:11:05.04,Default,,0,0,0,,Сендер
Dialogue: 0,0:11:06.06,0:11:08.04,Default,,0,0,0,,Қайсысын өлтіруім керек?
Dialogue: 0,0:11:09.00,0:11:13.01,Default,,0,0,0,,Қайсысының жылағанын көру қызықтырақ?
Dialogue: 0,0:11:15.09,0:11:17.09,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:11:19.01,0:11:20.08,Default,,0,0,0,,Неге ешкім қабырғаға өрмелеп шығуға тырыспайды? Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:11:22.00,0:11:23.02,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:11:23.02,0:11:26.00,Default,,0,0,0,,Ааа, естідің бе?
Dialogue: 0,0:11:26.00,0:11:29.04,Default,,0,0,0,,Менімен тағы біраз ойнай аласыз ба деп ойладым.
Dialogue: 0,0:11:29.09,0:11:31.03,Default,,0,0,0,,Екі балшық
Dialogue: 0,0:11:32.00,0:11:34.03,Default,,0,0,0,,Бір адам баласы
Dialogue: 0,0:11:34.03,0:11:36.06,Default,,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:11:37.03,0:11:41.03,Default,,0,0,0,,Әлгі бала біраздан бері дәмді иіскеп тұр.
Dialogue: 0,0:11:41.03,0:11:43.00,Default,,0,0,0,,Төзгісіз, солай емес пе?
Dialogue: 0,0:11:52.07,0:11:53.08,Default,,0,0,0,,Оянды
Dialogue: 0,0:11:59.03,0:12:00.03,Default,,0,0,0,,О, құдай!
Dialogue: 0,0:12:00.03,0:12:02.06,Default,,0,0,0,,Өте салмақты және күшті көрінеді.
Dialogue: 0,0:12:05.08,0:12:09.04,Default,,0,0,0,,Әзірше маған ол баладан басқа ештеңе керек емес.
Dialogue: 0,0:12:10.00,0:12:13.01,Default,,0,0,0,,Әлде кедергі деймін бе?
Dialogue: 0,0:12:29.02,0:12:30.01,Default,,0,0,0,,О.
Dialogue: 0,0:12:31.02,0:12:34.01,Default,,0,0,0,,Мен баладан басқаның бәрін кесіп тастадым деп ойладым.
Dialogue: 0,0:12:34.08,0:12:36.06,Default,,0,0,0,,Екеуміз де қауіпсізміз.
Dialogue: 0,0:12:39.01,0:12:42.01,Default,,0,0,0,,Балалар сендер өте мықтысыңдар.
Dialogue: 0,0:12:47.00,0:12:48.02,Default,,0,0,0,,Толық емес
Dialogue: 0,0:12:48.05,0:12:49.05,Default,,0,0,0,,Клэр
Dialogue: 0,0:12:51.05,0:12:53.03,Default,,0,0,0,,Мына баланы маған қалдырыңыз
Dialogue: 0,0:12:53.03,0:12:55.09,Default,,0,0,0,,Сіз аяқтарыңызды тез біріктіресіз.
Dialogue: 0,0:12:55.09,0:12:58.00,Default,,0,0,0,,Енді біз әр секунд үшін күресуіміз керек.
Dialogue: 0,0:12:58.00,0:13:00.02,Default,,0,0,0,,Сол оянған адамның құдіретін көрдің.
Dialogue: 0,0:13:00.02,0:13:02.03,Default,,0,0,0,,Бөлінетін кезіміз емес пе?
Dialogue: 0,0:13:02.03,0:13:03.01,Default,,0,0,0,,Тез
Dialogue: 0,0:13:04.08,0:13:06.03,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:14.06,0:13:15.02,Default,,0,0,0,,Ла
Dialogue: 0,0:13:18.02,0:13:19.02,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:13:19.05,0:13:21.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:21.00,0:13:23.02,Default,,0,0,0,,Қолым сәл сырғып кетті.
Dialogue: 0,0:13:23.06,0:13:24.05,Default,,0,0,0,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:13:24.05,0:13:25.09,Default,,0,0,0,,Мені жіберші, бейбақ.
Dialogue: 0,0:13:25.09,0:13:26.07,Default,,0,0,0,,Кира мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:13:26.07,0:13:28.02,Default,,0,0,0,,Құбыжықты босатыңыз
Dialogue: 0,0:13:28.02,0:13:33.02,Default,,0,0,0,,Сендей дәрменсіз адам менің қолымды жұлып тастай алмайды.
Dialogue: 0,0:13:33.02,0:13:36.05,Default,,0,0,0,,Әсіресе, әбден күшті болып көрінетін Оянған адамға қарсы.
Dialogue: 0,0:13:36.09,0:13:40.02,Default,,0,0,0,,Мен бұл баланы көтеріп тұрып күресуді жалғастыра алмаймын.
Dialogue: 0,0:13:43.04,0:13:46.05,Default,,0,0,0,,Сізді тастап кеткен сияқтысыз.
Dialogue: 0,0:13:54.03,0:13:56.03,Default,,0,0,0,,Мен осындай жердемін
Dialogue: 0,0:13:56.03,0:13:57.08,Default,,0,0,0,,Бұл пайдасыз.
Dialogue: 0,0:13:57.08,0:14:01.03,Default,,0,0,0,,Егер сіз өзіңіздің сиқырлы күшіңізді барынша босатсаңыз да,
Dialogue: 0,0:14:01.03,0:14:04.02,Default,,0,0,0,,Бұл менің қазіргі күшіме де жақын емес.
Dialogue: 0,0:14:06.02,0:14:10.01,Default,,0,0,0,,Жеу оңай деп ойламаңыз.
Dialogue: 0,0:14:10.01,0:14:12.04,Default,,0,0,0,,Бұл өлуге жаман уақыт.
Dialogue: 0,0:14:12.08,0:14:14.04,Default,,0,0,0,,Сол баладан бас тарт.
Dialogue: 0,0:14:15.02,0:14:17.06,Default,,0,0,0,,Сіз қанша сиқырлы күш жіберсеңіз де,
Dialogue: 0,0:14:17.06,0:14:21.09,Default,,0,0,0,,Өйткені, сіздің қабілетіңіз бір адамның өмірін де құтқара алмайды.
Dialogue: 0,0:14:23.09,0:14:25.06,Default,,0,0,0,,Мен күштірек боламын
Dialogue: 0,0:14:26.02,0:14:27.06,Default,,0,0,0,,Тірі қалу
Dialogue: 0,0:14:28.05,0:14:29.04,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:14:30.01,0:14:31.06,Default,,0,0,0,,Мен қорғағым келеді
Dialogue: 0,0:14:44.01,0:14:47.00,Default,,0,0,0,,Мен ештеңе істей алмаймын
Dialogue: 0,0:14:49.01,0:14:50.00,Default,,0,0,0,,Раки
Dialogue: 0,0:14:57.03,0:14:59.00,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:14:59.00,0:15:02.07,Default,,0,0,0,,Теме балаға көмектесу үшін оянған адам болса, не істейді?
Dialogue: 0,0:15:02.07,0:15:05.03,Default,,0,0,0,,Мені мүлде құтқара алмайсың, ақымақ.
Dialogue: 0,0:15:09.03,0:15:10.07,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:10.07,0:15:14.02,Default,,0,0,0,,Ей, сіз қазір шегінен асып кеткен болуыңыз керек.
Dialogue: 0,0:15:14.02,0:15:15.07,Default,,0,0,0,,Шарлатан болма
Dialogue: 0,0:15:16.04,0:15:18.05,Default,,0,0,0,,Екі аяғы да бекітілген сияқты.
Dialogue: 0,0:15:18.09,0:15:23.00,Default,,0,0,0,,Сіз шегінен асып кеткеннен кейін, сіз ештеңеге қарамастан қайта алмайсыз.
Dialogue: 0,0:15:24.06,0:15:25.02,Default,,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:15:25.09,0:15:26.09,Default,,0,0,0,,Ол басқа суреттерде де бар емес пе?
Dialogue: 0,0:15:28.05,0:15:30.02,Default,,0,0,0,,Сіз ояусыз, солай емес пе?
Dialogue: 0,0:15:31.02,0:15:32.08,Default,,0,0,0,,Бұл күлкілі
Dialogue: 0,0:15:32.08,0:15:35.06,Default,,0,0,0,,Бұл өте күлкілі
Dialogue: 0,0:15:35.06,0:15:39.09,Default,,0,0,0,,Бір күнде екі Оянған жаратылысты жұлып алғаныма сене алар емеспін.
Dialogue: 0,0:15:41.03,0:15:43.07,Default,,0,0,0,,Раки мені құшақтап алды
Dialogue: 0,0:15:44.09,0:15:47.04,Default,,0,0,0,,Қашу үшін бар күшіңізді жұмсаңыз
Dialogue: 0,0:15:47.09,0:15:50.06,Default,,0,0,0,,Сені лақтырып алмас үшін мені ұста
Dialogue: 0,0:15:51.04,0:15:52.06,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:15:56.02,0:15:57.08,Default,,0,0,0,,Қаттырақ ұстаңыз
Dialogue: 0,0:15:59.02,0:16:02.01,Default,,0,0,0,,Өтінемін, сізді сілкіп тастауға рұқсат етпеңіз.
Dialogue: 0,0:16:04.08,0:16:08.04,Default,,0,0,0,,О, сіз қашып кете аламын деп ойлайсыз ба?
Dialogue: 0,0:16:16.04,0:16:18.06,Default,,0,0,0,,Сол баланы артта қалдыру
Dialogue: 0,0:16:18.06,0:16:22.00,Default,,0,0,0,,Мен сенің қадіріңді білмей, сені кәдеге жаратамын.
Dialogue: 0,0:16:23.04,0:16:25.02,Default,,0,0,0,,Надандық
Dialogue: 0,0:16:25.06,0:16:28.00,Default,,0,0,0,,Сіз қызықты нәрсе айттыңыз.
Dialogue: 0,0:16:28.05,0:16:30.07,Default,,0,0,0,,Сен мені екіге бөлесің
Dialogue: 0,0:16:31.05,0:16:34.00,Default,,0,0,0,,Кім жыртылады?
Dialogue: 0,0:16:37.05,0:16:38.08,Default,,0,0,0,,Құбыжық атмосферасы
Dialogue: 0,0:16:39.09,0:16:42.02,Default,,0,0,0,,Алаңдамаңыз.
Dialogue: 0,0:16:52.07,0:16:54.02,Default,,0,0,0,,Мүмкіндігінше алыс
Dialogue: 0,0:16:57.01,0:16:58.04,Default,,0,0,0,,Бір қадам алға
Dialogue: 0,0:17:08.05,0:17:09.06,Default,,0,0,0,,Бұл Миками растағанының белгісі
Dialogue: 0,0:17:10.02,0:17:13.04,Default,,0,0,0,,Сіз ештеңе білмеген сияқтысыз.
Dialogue: 0,0:17:14.02,0:17:14.52,Default,,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,0:17:15.03,0:17:16.08,Default,,0,0,0,,Өміріміз үшін жалбарынайық
Dialogue: 0,0:17:17.06,0:17:21.03,Default,,0,0,0,,Сіз менен күтпеген жерден бірдеңе сұрауыңыз мүмкін.
Dialogue: 0,0:17:21.09,0:17:24.03,Default,,0,0,0,,Көп сөйлеме
Dialogue: 0,0:17:24.03,0:17:26.09,Default,,0,0,0,,Менің аузым ауырып тұр
Dialogue: 0,0:17:30.03,0:17:31.05,Default,,0,0,0,,Минерва біз үшін осындай қауіпсіз орын дайындап қойған еді
Dialogue: 0,0:17:32.03,0:17:34.07,Default,,0,0,0,,Мен дөрекі адамдарды ұнатпаймын.
Dialogue: 0,0:17:44.01,0:17:45.02,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:17:45.02,0:17:46.07,Default,,0,0,0,,Сол балалар
Dialogue: 0,0:17:47.04,0:17:50.09,Default,,0,0,0,,Мама, бұл өте алыс.
Dialogue: 0,0:17:51.03,0:17:53.02,Default,,0,0,0,,Әлсіз және баяу
Dialogue: 0,0:17:53.02,0:17:54.07,Default,,0,0,0,,Мен тіпті қарай алмаймын.
Dialogue: 0,0:17:59.08,0:18:02.00,Default,,0,0,0,,1 4 0 0
Dialogue: 0,0:18:07.05,0:18:11.02,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:18:11.08,0:18:14.02,Default,,0,0,0,,Мойын
Dialogue: 0,0:18:14.06,0:18:17.09,Default,,0,0,0,,Мойыңды сындырып алсаң, өлесің.
Dialogue: 0,0:18:22.00,0:18:25.09,Default,,0,0,0,,Егер сіз оны шынымен өлтіргіңіз келсе, оның басын алуыңыз керек еді.
Dialogue: 0,0:18:26.09,0:18:30.06,Default,,0,0,0,,Құбыжық сен емессің.
Dialogue: 0,0:18:43.08,0:18:44.05,Default,,0,0,0,,Клэр
Dialogue: 0,0:18:49.07,0:18:52.04,Default,,0,0,0,,Ол қазірдің өзінде шешілді.
Dialogue: 0,0:18:53.02,0:18:54.01,Default,,0,0,0,,Клэр
Dialogue: 0,0:18:55.05,0:18:57.04,Default,,0,0,0,,Осы жерден біз екі топқа бөлінеміз.
Dialogue: 0,0:18:58.06,0:18:59.08,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:19:00.02,0:19:02.05,Default,,0,0,0,,Ол маған қарай келе жатыр.
Dialogue: 0,0:19:03.05,0:19:04.05,Default,,0,0,0,,Ол шалбар есікті де жауып үлгере алмайды.
Dialogue: 0,0:19:06.04,0:19:07.02,Default,,0,0,0,,Раки
Dialogue: 0,0:19:07.02,0:19:07.52,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:19:09.02,0:19:11.04,Default,,0,0,0,,Мен Клэрмен біргемін
Dialogue: 0,0:19:11.07,0:19:13.01,Default,,0,0,0,,Мені тыңда
Dialogue: 0,0:19:13.06,0:19:16.02,Default,,0,0,0,,Ол менің сиқырлы қуатымды сезіп, артымнан ереді.
Dialogue: 0,0:19:16.02,0:19:17.01,Default,,0,0,0,,Сонымен
Dialogue: 0,0:19:17.05,0:19:18.04,Default,,0,0,0,,Жоқ
Dialogue: 0,0:19:18.09,0:19:20.01,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:19:20.07,0:19:22.07,Default,,0,0,0,,Мен Клэрге көмектескім келеді.
Dialogue: 0,0:19:29.00,0:19:31.03,Default,,0,0,0,,Мен оның пайдасы жоқ екенін білемін.
Dialogue: 0,0:19:32.01,0:19:35.02,Default,,0,0,0,,Бірақ мен әлі де Клэрдің қасында болғым келеді.
Dialogue: 0,0:19:35.02,0:19:36.05,Default,,0,0,0,,Мен өлсем де бәрібір
Dialogue: 0,0:19:36.05,0:19:38.02,Default,,0,0,0,,Мен сенімен мәңгі бірге болғым келеді, Клэр.
Dialogue: 0,0:20:02.09,0:20:05.00,Default,,0,0,0,,Өлсем жарайды деме
Dialogue: 0,0:20:06.00,0:20:07.01,Default,,0,0,0,,Клэр
Dialogue: 0,0:20:08.00,0:20:09.01,Default,,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:20:09.06,0:20:10.09,Default,,0,0,0,,Мен өлмеймін
Dialogue: 0,0:20:11.05,0:20:14.00,Default,,0,0,0,,Мен міндетті түрде өмір сүремін және сенімен қайта қауышамын.
Dialogue: 0,0:20:15.03,0:20:17.02,Default,,0,0,0,,Сондықтан Рақи да өлмейді.
Dialogue: 0,0:20:17.09,0:20:19.04,Default,,0,0,0,,Мен оны міндетті түрде табамын.
Dialogue: 0,0:20:20.01,0:20:21.08,Default,,0,0,0,,Оған дейін аман қаласыз.
Dialogue: 0,0:20:23.03,0:20:24.03,Default,,0,0,0,,Клэр
Dialogue: 0,0:20:24.09,0:20:25.09,Default,,0,0,0,,Бұл уәде.
Dialogue: 0,0:20:28.02,0:20:29.01,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:20:29.05,0:20:31.05,Default,,0,0,0,,Клэр мен уәде беремін
Dialogue: 0,0:20:32.03,0:20:33.07,Default,,0,0,0,,Күшті болыңыз және аман болыңыз
Dialogue: 0,0:20:35.00,0:20:37.04,Default,,0,0,0,,Бір күні мен
Dialogue: 0,0:20:39.01,0:20:42.05,Default,,0,0,0,,Мен бір күні Клэрді міндетті түрде қорғаймын
Dialogue: 0,0:20:43.06,0:20:44.05,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:20:52.07,0:20:54.02,Default,,0,0,0,,Лабонаның Құдайы
Dialogue: 0,0:20:54.08,0:20:56.06,Default,,0,0,0,,Менің тілегімді тыңдаңыз
Dialogue: 0,0:20:58.00,0:21:00.02,Default,,0,0,0,,Біраз күш пен мейірімділік
Dialogue: 0,0:21:01.03,0:21:03.04,Default,,0,0,0,,Оны сол балаға бер.
Dialogue: 0,0:21:04.08,0:21:08.02,Default,,0,0,0,,Менімен қайта кездескенше
Dialogue: 0,0:21:15.06,0:21:19.08,Default,,0,0,0,,Мойнымдағы қаттылық жақсы өтті.
Dialogue: 0,0:21:22.08,0:21:26.08,Default,,0,0,0,,Басқа оянған жануарды іздеуге кірісеміз бе?
Dialogue: 0,0:22:40.04,0:22:42.03,Default,,0,0,0,,Жүрегімді толқындар мазалайды
Dialogue: 0,0:22:42.03,0:22:43.08,Default,,0,0,0,,Ертең толқындар шашылады
Dialogue: 0,0:22:43.09,0:22:46.05,Default,,0,0,0,,Өткендегі жауынгер
Dialogue: 0,0:22:47.55,0:22:52.55,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
