Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:31.50,0:00:33.41,Default - Copy,Raki,0,0,0,,(Ханами) Кісі өлтіру ниетіне тежегіш салатын адам —
Dialogue: 0,0:00:33.75,0:00:35.38,Default - Copy,Raki,0,0,0,,Аман қалу
Dialogue: 0,0:00:36.01,0:00:36.88,Default - Copy,Raki,0,0,0,,Содан кейін
Dialogue: 0,0:00:42.72,0:00:46.92,Default - Copy,Rubel,0,0,0,,Сіз үш жындыны оңай жеңдіңіз бе?
Dialogue: 0,0:00:46.92,0:00:47.89,Default - Copy,Rubel,0,0,0,,Өте жақсы
Dialogue: 0,0:00:48.69,0:00:50.16,Default - Copy,Clare,0,0,0,,Бұл үлкен мәселе емес
Dialogue: 0,0:00:50.66,0:00:52.16,Default - Copy,Rubel,0,0,0,,Қандай ерекше жеңіс.
Dialogue: 0,0:00:52.50,0:00:55.17,Default - Copy,Rubel,0,0,0,,Соңғы кездері мен бақылаусыз әрекет етпеймін.
Dialogue: 0,0:00:55.47,0:00:57.90,Default - Copy,Rubel,0,0,0,,Адал немесе шыншыл болып кеткен сияқты.
Dialogue: 0,0:00:58.84,0:01:00.41,Default - Copy,Rubel,0,0,0,,Не болды?
Dialogue: 0,0:01:01.47,0:01:07.41,Default - Copy,Clare,0,0,0,,Өткен күні аң аулау кезінде мен өз қабілеттерімді жек көретінімді білдім.
Dialogue: 0,0:01:09.75,0:01:12.15,Default - Copy,Rubel,0,0,0,,Мұны қайталай бергенім үшін кешіріңіз, бірақ бұл жұмыс.
Dialogue: 0,0:01:12.92,0:01:14.85,Default - Copy,Rubel,0,0,0,,Орналасқан жері Гонар, солтүстіктегі қала.
Dialogue: 0,0:01:15.25,0:01:17.52,Default - Copy,Rubel,0,0,0,,Оянғандар сонда аң аулады ма?
Dialogue: 0,0:01:18.09,0:01:19.19,Default - Copy,Clare,0,0,0,,Оянды
Dialogue: 0,0:01:19.59,0:01:21.93,Default - Copy,Rubel,0,0,0,,Өкінішке орай, бұл Присцилла емес.
Dialogue: 0,0:01:21.93,0:01:23.93,Default - Copy,Rubel,0,0,0,,Бұл бұрынғыдай бір таңбалы сан.
Dialogue: 0,0:01:24.16,0:01:27.90,Default - Copy,Rubel,0,0,0,,Бір күнгі оянған адамнан әлдеқайда күшті.
Dialogue: 0,0:01:28.37,0:01:31.70,Default - Copy,Rubel,0,0,0,,Өлгің келмесе, абай бол.
Dialogue: 0,0:01:33.47,0:01:35.04,Default - Copy,Clare,0,0,0,,Мен өлмеймін
Dialogue: 0,0:01:35.71,0:01:36.81,Default - Copy,Clare,0,0,0,,Ешқашан
Dialogue: 0,0:01:46.62,0:01:48.35,Default - Copy,Rubel,0,0,0,,Бұл сенімді сөз.
Dialogue: 0,0:01:50.05,0:01:51.42,Default - Copy,Rubel,0,0,0,,Мен сенің үмітіңді артамын
Dialogue: 0,0:03:03.11,0:03:06.05,Default - Copy,Raki,0,0,0,,Біз Гонар қаласына ертең жететін сияқтымыз.
Dialogue: 0,0:03:11.02,0:03:13.42,Default - Copy,Clare,0,0,0,,Раки, осы жерде күте аласыз.
Dialogue: 0,0:03:19.00,0:03:20.33,Default - Copy,Raki,0,0,0,,Мен де сенімен бірге барамын.
Dialogue: 0,0:03:21.17,0:03:22.43,Default - Copy,Clare,0,0,0,,Бұл қауіпті қылыш.
Dialogue: 0,0:03:22.43,0:03:23.70,Default - Copy,Clare,0,0,0,,Алмаңыз
Dialogue: 0,0:03:23.70,0:03:25.00,Default - Copy,Raki,0,0,0,,Бірақ Клэр, И
Dialogue: 0,0:03:25.00,0:03:27.31,Default - Copy,Clare,0,0,0,,Менің қайтуымды осында күтіңіз.
Dialogue: 0,0:03:27.91,0:03:28.54,Default - Copy,Clare,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:04:18.09,0:04:19.82,Default - Copy,Clare,0,0,0,,Серіктердің белгілері
Dialogue: 0,0:04:21.59,0:04:22.63,Default - Copy,Clare,0,0,0,,Не?
Dialogue: 0,0:04:23.46,0:04:27.80,Default - Copy,Clare,0,0,0,,Бұл сезім менің денемдегі әрбір жасуша сияқты ескерту жібереді.
Dialogue: 0,0:04:43.95,0:04:46.85,Default - Copy,Ophelia,0,0,0,,Иә.
Dialogue: 0,0:04:48.52,0:04:51.76,Default - Copy,Clare,0,0,0,,Мен достарымды бірге деп ойладым.
Dialogue: 0,0:04:53.56,0:04:55.29,Default - Copy,Ophelia,0,0,0,,Олардың барлығы бізде жоқ.
Dialogue: 0,0:04:55.29,0:04:57.20,Default - Copy,Ophelia,0,0,0,,Сен және мен
Dialogue: 0,0:04:59.46,0:05:01.93,Default - Copy,Clare,0,0,0,,Екеуің Оянғандарды аулайсыңдар ма?
Dialogue: 0,0:05:02.37,0:05:03.47,Default - Copy,Ophelia,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:05:03.94,0:05:07.04,Default - Copy,Ophelia,0,0,0,,Бірақ шын мәнінде мен өзіммен жақсы болдым.
Dialogue: 0,0:05:07.44,0:05:09.71,Default - Copy,Ophelia,0,0,0,,Сіз бонус сияқтысыз
Dialogue: 0,0:05:10.58,0:05:11.88,Default - Copy,Clare,0,0,0,,Бір таңбалы сан
Dialogue: 0,0:05:12.34,0:05:14.05,Default - Copy,Clare,0,0,0,,Үздік бестіктің бірі?
Dialogue: 0,0:05:14.98,0:05:16.01,Default - Copy,Clare,0,0,0,,Белгі
Dialogue: 0,0:05:16.75,0:05:18.55,Default - Copy,Clare,0,0,0,,Елтаңбаға қарап білуге болады
Dialogue: 0,0:05:23.96,0:05:28.53,Default - Copy,Ophelia,0,0,0,,Сіз оянған адамның иісін аласыз.
Dialogue: 0,0:05:29.46,0:05:31.00,Default - Copy,Ophelia,0,0,0,,Жарайды.
Dialogue: 0,0:05:31.00,0:05:32.76,Default - Copy,Ophelia,0,0,0,,Кішкене иіскеп көрейін
Dialogue: 0,0:05:33.30,0:05:35.57,Default - Copy,Ophelia,0,0,0,,Маған бұл иіс ұнайды.
Dialogue: 0,0:05:36.53,0:05:38.44,Default - Copy,Ophelia,0,0,0,,Сіз қозғала алмайсыз, солай ма?
Dialogue: 0,0:05:38.87,0:05:40.47,Default - Copy,Ophelia,0,0,0,,Бұл Миками растағанының белгісі
Dialogue: 0,0:05:43.37,0:05:47.85,Default - Copy,Ophelia,0,0,0,,Сондықтан сіз қозғалу мағынасыз деп отырсыз.
Dialogue: 0,0:05:56.05,0:05:57.56,Default - Copy,Ophelia,0,0,0,,Біртүрлі дәм
Dialogue: 0,0:05:58.86,0:06:04.03,Default - Copy,Ophelia,0,0,0,,Әй, бірақ бұл дәм әйтеуір есімде.
Dialogue: 0,0:06:04.90,0:06:07.53,Default - Copy,Ophelia,0,0,0,,Сіз шынымен де біздің бірімізсіз бе?
Dialogue: 0,0:06:08.21,0:06:10.20,Default - Copy,Raki,0,0,0,,Клэрді жібер
Dialogue: 0,0:06:13.94,0:06:15.21,Default - Copy,Clare,0,0,0,,Раки
Dialogue: 0,0:06:15.21,0:06:17.18,Default - Copy,Raki,0,0,0,,Егер мен Клэрмен ары қарай аралассам
Dialogue: 0,0:06:17.94,0:06:19.18,Default - Copy,Raki,0,0,0,,Мен сені кешірмеймін
Dialogue: 0,0:06:21.55,0:06:23.25,Default - Copy,Ophelia,0,0,0,,Ол бала ше?
Dialogue: 0,0:06:24.28,0:06:26.62,Default - Copy,Ophelia,0,0,0,,Сіздің досыңыз
Dialogue: 0,0:06:28.12,0:06:30.96,Default - Copy,Ophelia,0,0,0,,Менің ойымша, бұл әдемі емес.
Dialogue: 0,0:06:32.56,0:06:35.73,Default - Copy,Ophelia,0,0,0,,Тек дене жарылғанда немесе жарылғанда
Dialogue: 0,0:06:36.09,0:06:39.26,Default - Copy,Ophelia,0,0,0,,Айналаны бояйтын қызғылт қызыл түс
Dialogue: 0,0:06:41.33,0:06:45.14,Default - Copy,Ophelia,0,0,0,,Әдемі гүлдей берейік, балақай.
Dialogue: 0,0:06:47.71,0:06:48.90,Default - Copy,Clare,0,0,0,,(Норияки) Уф. (Жан) Мм…
Dialogue: 0,0:06:51.41,0:06:53.64,Default - Copy,Clare,0,0,0,,№4 Офелия
Dialogue: 0,0:06:54.88,0:06:58.98,Default - Copy,Ophelia,0,0,0,,Белгіні көргенде жүзіңіз өзгерді.
Dialogue: 0,0:06:59.65,0:07:01.59,Default - Copy,Ophelia,0,0,0,,Сіз мені танисыз ба?
Dialogue: 0,0:07:02.49,0:07:03.99,Default - Copy,Ophelia,0,0,0,,Оны қайдан естідің?
Dialogue: 0,0:07:05.96,0:07:07.43,Default - Copy,Ophelia,0,0,0,,Мені қызықтырады.
Dialogue: 0,0:07:07.86,0:07:10.13,Default - Copy,Ophelia,0,0,0,,Бірақ бұған дейін
Dialogue: 0,0:07:17.90,0:07:21.24,Default - Copy,Ophelia,0,0,0,,О, таң қаларлықтай алыс.
Dialogue: 0,0:07:24.54,0:07:25.74,Default - Copy,Clare,0,0,0,,Еліктеудің қандай түрі?
Dialogue: 0,0:07:26.24,0:07:30.15,Default - Copy,Clare,0,0,0,,Заң бойынша біреуді өлтірсек, өзіміз өлетін боламыз.
Dialogue: 0,0:07:30.55,0:07:33.08,Default - Copy,Clare,0,0,0,,Өлгің келе ме?
Dialogue: 0,0:07:33.48,0:07:35.69,Default - Copy,Ophelia,0,0,0,,Балалар сендер ақымақсыңдар.
Dialogue: 0,0:07:35.69,0:07:37.59,Default - Copy,Ophelia,0,0,0,,Бұл өз-өзіне есеп беру емес.
Dialogue: 0,0:07:38.19,0:07:41.73,Default - Copy,Ophelia,0,0,0,,Өз басыңызды кесіп жатқанда, қалайша есеп беруге батылыңыз бар?
Dialogue: 0,0:07:41.73,0:07:43.09,Default - Copy,Clare,0,0,0,,Келесі шайқас!
Dialogue: 0,0:07:43.36,0:07:46.13,Default - Copy,Ophelia,0,0,0,,Тіпті біреу қарап тұрса да
Dialogue: 0,0:07:46.13,0:07:48.87,Default - Copy,Ophelia,0,0,0,,Немесе олардан құтылыңыз.
Dialogue: 0,0:07:52.90,0:07:54.31,Default - Copy,Ophelia,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:07:54.31,0:07:55.87,Default - Copy,Ophelia,0,0,0,,Ойын ойнайық
Dialogue: 0,0:08:08.39,0:08:11.56,Default - Copy,Ophelia,0,0,0,,Жарайды, мен ережелерді түсіндіремін.
Dialogue: 0,0:08:11.56,0:08:14.03,Default - Copy,Ophelia,0,0,0,,Мен қазір ол қызбен ұрысамын.
Dialogue: 0,0:08:14.73,0:08:16.39,Default - Copy,Ophelia,0,0,0,,Әрине мен байсалды емеспін.
Dialogue: 0,0:08:16.89,0:08:19.90,Default - Copy,Ophelia,0,0,0,,Сол баланың қабілетіне сәйкес келетін күшпен.
Dialogue: 0,0:08:19.90,0:08:25.97,Default - Copy,Ophelia,0,0,0,,Бірақ мен минут сайын күш пен жылдамдықты бір сатыға арттырамын.
Dialogue: 0,0:08:27.51,0:08:28.57,Default - Copy,Ophelia,0,0,0,,Иә.
Dialogue: 0,0:08:28.57,0:08:32.21,Default - Copy,Ophelia,0,0,0,,Менің басым он минуттан кейін ұшып кетуі мүмкін деп ойлаймын.
Dialogue: 0,0:08:32.58,0:08:36.15,Default - Copy,Ophelia,0,0,0,,Оған дейін аяғыңызды біріктіріп, көмектесіңіз.
Dialogue: 0,0:08:36.75,0:08:40.05,Default - Copy,Ophelia,0,0,0,,Ұзақ болса да ол бала өледі.
Dialogue: 0,0:08:40.05,0:08:43.96,Default - Copy,Ophelia,0,0,0,,Біртүрлі жолмен тез жабысып қалсаңыз, көмектеспейді.
Dialogue: 0,0:08:43.96,0:08:46.06,Default - Copy,Ophelia,0,0,0,,Қызық емес пе?
Dialogue: 0,0:08:46.76,0:08:47.66,Default - Copy,Clare,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:08:48.79,0:08:49.73,Default - Copy,Ophelia,0,0,0,,Олай болса
Dialogue: 0,0:08:51.03,0:08:51.96,Default - Copy,Ophelia,0,0,0,,Жақсы
Dialogue: 0,0:08:53.67,0:08:54.63,Default - Copy,Ophelia,0,0,0,,Бастау
Dialogue: 0,0:09:19.16,0:09:20.73,Default - Copy,Clare,0,0,0,,Сиқырлы күшіңізді босатыңыз
Dialogue: 0,0:09:20.73,0:09:23.43,Default - Copy,Clare,0,0,0,,Жөндеу мен регенерацияны қайталау арқылы жасай алуыңыз керек.
Dialogue: 0,0:09:27.80,0:09:28.90,Default - Copy,Ophelia,0,0,0,,О, құдай!
Dialogue: 0,0:09:28.90,0:09:30.40,Default - Copy,Ophelia,0,0,0,,Сіз ойлағаннан да көп нәрсені жасайсыз.
Dialogue: 0,0:09:30.40,0:09:31.77,Default - Copy,Ophelia,0,0,0,,Маған біраз әсер қалдырды.
Dialogue: 0,0:09:35.27,0:09:37.34,Default - Copy,Ophelia,0,0,0,,Сәл ертерек
Dialogue: 0,0:09:37.34,0:09:39.68,Default - Copy,Ophelia,0,0,0,,Бір деңгей жоғары
Dialogue: 0,0:09:43.58,0:09:46.58,Default - Copy,Ophelia,0,0,0,,Қылышты дұрыс ұстау керек.
Dialogue: 0,0:09:46.58,0:09:48.12,Default - Copy,Ophelia,0,0,0,,Бұл екі жүзді қылыш.
Dialogue: 0,0:09:49.09,0:09:50.12,Default - Copy,Clare,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:09:53.32,0:09:55.13,Default - Copy,Ophelia,0,0,0,,О, жоқ, солай.
Dialogue: 0,0:09:56.49,0:10:00.33,Default - Copy,Ophelia,0,0,0,,Айттым ғой, тым тез, шала істеме.
Dialogue: 0,0:10:00.90,0:10:02.47,Default - Copy,Ophelia,0,0,0,,Тіпті бір-біріне жабыспайды.
Dialogue: 0,0:10:05.44,0:10:08.11,Default - Copy,Ophelia,0,0,0,,Егер жара уақыт өте келе жабылса
Dialogue: 0,0:10:08.47,0:10:11.34,Default - Copy,Ophelia,0,0,0,,Сіз оларды қайтадан біріктіре алмайсыз.
Dialogue: 0,0:10:12.91,0:10:13.95,Default - Copy,Clare,0,0,0,,Тынышталыңыз
Dialogue: 0,0:10:13.95,0:10:15.05,Default - Copy,Clare,0,0,0,,Егер солай істесем…
Dialogue: 0,0:10:17.32,0:10:19.65,Default - Copy,Ophelia,0,0,0,,Ол өте адал және жақсы қыз.
Dialogue: 0,0:10:19.65,0:10:22.35,Default - Copy,Ophelia,0,0,0,,Бұл мен күткен реакция болды.
Dialogue: 0,0:10:22.35,0:10:23.45,Default - Copy,Ophelia,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:10:24.82,0:10:25.36,Default - Copy,Ophelia,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:10:25.89,0:10:26.36,Default - Copy,Ophelia,0,0,0,,Уф… Таңертеңгісін-ақ шаршап біттім.
Dialogue: 0,0:10:26.99,0:10:28.53,Default - Copy,Ophelia,0,0,0,,Тенген мырза… Мен үшін уайымдамаңыз; сіз қазір кетуіңіз керек.
Dialogue: 0,0:10:28.53,0:10:29.99,Default - Copy,Ophelia,0,0,0,,Көңілді бала
Dialogue: 0,0:10:30.50,0:10:32.30,Default - Copy,Ophelia,0,0,0,,Әй, қара!
Dialogue: 0,0:10:32.30,0:10:35.50,Default - Copy,Ophelia,0,0,0,,Бұл бала сіздің зейініңізді бұзбау үшін.
Dialogue: 0,0:10:35.50,0:10:38.50,Default - Copy,Ophelia,0,0,0,,Қанша кесіп алсам да, ыңылдамаймын.
Dialogue: 0,0:10:39.00,0:10:41.91,Default - Copy,Ophelia,0,0,0,,Қанды, көз жасымен
Dialogue: 0,0:10:41.91,0:10:43.91,Default - Copy,Ophelia,0,0,0,,Аузыңды жап, балам.
Dialogue: 0,0:10:45.91,0:10:47.41,Default - Copy,Raki,0,0,0,,Үндетпе
Dialogue: 0,0:10:49.75,0:10:51.58,Default - Copy,Raki,0,0,0,,Бейқам болмаңыз
Dialogue: 0,0:10:51.92,0:10:56.42,Default - Copy,Raki,0,0,0,,Мен сенің тырнақтай шабуылдарыңды тырнап та алмаймын.
Dialogue: 0,0:10:59.46,0:11:00.93,Default - Copy,Ophelia,0,0,0,,Мен шыдай алмаймын.
Dialogue: 0,0:11:01.73,0:11:03.16,Default - Copy,Ophelia,0,0,0,,Взвод
Dialogue: 0,0:11:03.16,0:11:04.70,Default - Copy,Ophelia,0,0,0,,Өте жақсы
Dialogue: 0,0:11:04.70,0:11:05.43,Default - Copy,Ophelia,0,0,0,,Сендер
Dialogue: 0,0:11:06.66,0:11:08.43,Default - Copy,Ophelia,0,0,0,,Қайсысын өлтіруім керек?
Dialogue: 0,0:11:09.07,0:11:13.14,Default - Copy,Ophelia,0,0,0,,Қайсысының жылағанын көру қызықтырақ?
Dialogue: 0,0:11:15.91,0:11:17.94,Default - Copy,A.O.,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:11:19.14,0:11:19.84,Default - Copy,Raki,0,0,0,,Неге ешкім қабырғаға өрмелеп шығуға тырыспайды?
Dialogue: 0,0:11:19.84,0:11:20.81,Default - Copy,Raki,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:11:22.05,0:11:23.28,Default - Copy,A.O.,0,0,0,,Неліктен?
Dialogue: 0,0:11:23.28,0:11:26.02,Default - Copy,Ophelia,0,0,0,,Ааа, естідің бе?
Dialogue: 0,0:11:26.02,0:11:29.45,Default - Copy,Ophelia,0,0,0,,Менімен тағы біраз ойнай аласыз ба деп ойладым.
Dialogue: 0,0:11:29.99,0:11:31.36,Default - Copy,A.O.,0,0,0,,Екі балшық
Dialogue: 0,0:11:32.02,0:11:34.36,Default - Copy,A.O.,0,0,0,,Бір адам баласы
Dialogue: 0,0:11:34.36,0:11:36.69,Default - Copy,A.O.,0,0,0,,Мен шынымен түсінбеймін.
Dialogue: 0,0:11:37.30,0:11:41.33,Default - Copy,A.O.,0,0,0,,Әлгі бала біраздан бері дәмді иіскеп тұр.
Dialogue: 0,0:11:41.33,0:11:43.03,Default - Copy,A.O.,0,0,0,,Төзгісіз, солай емес пе?
Dialogue: 0,0:11:52.71,0:11:53.88,Default - Copy,Clare,0,0,0,,Оянды
Dialogue: 0,0:11:59.32,0:12:00.32,Default - Copy,Ophelia,0,0,0,,О, құдай!
Dialogue: 0,0:12:00.32,0:12:02.65,Default - Copy,Ophelia,0,0,0,,Өте салмақты және күшті көрінеді.
Dialogue: 0,0:12:05.82,0:12:09.46,Default - Copy,A.O.,0,0,0,,Әзірше маған ол баладан басқа ештеңе керек емес.
Dialogue: 0,0:12:10.09,0:12:13.16,Default - Copy,A.O.,0,0,0,,Әлде кедергі деймін бе?
Dialogue: 0,0:12:29.25,0:12:30.18,Default - Copy,A.O.,0,0,0,,О.
Dialogue: 0,0:12:31.22,0:12:34.19,Default - Copy,A.O.,0,0,0,,Мен баладан басқаның бәрін кесіп тастадым деп ойладым.
Dialogue: 0,0:12:34.89,0:12:36.62,Default - Copy,A.O.,0,0,0,,Екеуміз де қауіпсізміз.
Dialogue: 0,0:12:39.19,0:12:42.19,Default - Copy,A.O.,0,0,0,,Балалар сендер өте мықтысыңдар.
Dialogue: 0,0:12:47.00,0:12:48.20,Default - Copy,Clare,0,0,0,,Толық емес
Dialogue: 0,0:12:48.53,0:12:49.53,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:12:51.57,0:12:53.30,Default - Copy,Ophelia,0,0,0,,Мына баланы маған қалдырыңыз
Dialogue: 0,0:12:53.30,0:12:55.91,Default - Copy,Ophelia,0,0,0,,Сіз аяқтарыңызды тез біріктіресіз.
Dialogue: 0,0:12:55.91,0:12:58.08,Default - Copy,Ophelia,0,0,0,,Енді біз әр секунд үшін күресуіміз керек.
Dialogue: 0,0:12:58.08,0:13:00.21,Default - Copy,Ophelia,0,0,0,,Сол оянған адамның құдіретін көрдің.
Dialogue: 0,0:13:00.21,0:13:02.35,Default - Copy,Ophelia,0,0,0,,Бөлінетін кезіміз емес пе?
Dialogue: 0,0:13:02.35,0:13:03.11,Default - Copy,Ophelia,0,0,0,,Тез
Dialogue: 0,0:13:04.82,0:13:06.38,Default - Copy,Ophelia,0,0,0,,Бұл не?
Dialogue: 0,0:13:14.63,0:13:15.29,Default - Copy,Clare,0,0,0,,Ла
Dialogue: 0,0:13:18.20,0:13:19.20,Default - Copy,Clare,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:13:19.53,0:13:21.07,Default - Copy,Ophelia,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:21.07,0:13:23.20,Default - Copy,Ophelia,0,0,0,,Қолым сәл сырғып кетті.
Dialogue: 0,0:13:23.67,0:13:24.57,Default - Copy,Raki,0,0,0,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:13:24.57,0:13:25.97,Default - Copy,Raki,0,0,0,,Мені жіберші, бейбақ.
Dialogue: 0,0:13:25.97,0:13:26.74,Default - Copy,Raki,0,0,0,,Кира мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:13:26.74,0:13:28.21,Default - Copy,Raki,0,0,0,,Құбыжықты босатыңыз
Dialogue: 0,0:13:28.21,0:13:33.21,Default - Copy,Ophelia,0,0,0,,Сендей дәрменсіз адам менің қолымды жұлып тастай алмайды.
Dialogue: 0,0:13:33.21,0:13:36.51,Default - Copy,Ophelia,0,0,0,,Әсіресе, әбден күшті болып көрінетін Оянған адамға қарсы.
Dialogue: 0,0:13:36.98,0:13:40.28,Default - Copy,Ophelia,0,0,0,,Мен бұл баланы көтеріп тұрып күресуді жалғастыра алмаймын.
Dialogue: 0,0:13:43.49,0:13:46.52,Default - Copy,A.O.,0,0,0,,Сізді тастап кеткен сияқтысыз.
Dialogue: 0,0:13:54.30,0:13:56.33,Default - Copy,Raki,0,0,0,,Мен осындай жердемін
Dialogue: 0,0:13:56.33,0:13:57.84,Default - Copy,Ophelia,0,0,0,,Бұл пайдасыз.
Dialogue: 0,0:13:57.84,0:14:01.34,Default - Copy,Ophelia,0,0,0,,Егер сіз өзіңіздің сиқырлы күшіңізді барынша босатсаңыз да,
Dialogue: 0,0:14:01.34,0:14:04.24,Default - Copy,Ophelia,0,0,0,,Бұл менің қазіргі күшіме де жақын емес.
Dialogue: 0,0:14:06.24,0:14:10.15,Default - Copy,Raki,0,0,0,,Жеу оңай деп ойламаңыз.
Dialogue: 0,0:14:10.15,0:14:12.48,Default - Copy,Ophelia,0,0,0,,Бұл өлуге жаман уақыт.
Dialogue: 0,0:14:12.82,0:14:14.49,Default - Copy,Ophelia,0,0,0,,Сол баладан бас тарт.
Dialogue: 0,0:14:15.25,0:14:17.62,Default - Copy,Ophelia,0,0,0,,Сіз қанша сиқырлы күш жіберсеңіз де,
Dialogue: 0,0:14:17.62,0:14:21.99,Default - Copy,Ophelia,0,0,0,,Өйткені, сіздің қабілетіңіз бір адамның өмірін де құтқара алмайды.
Dialogue: 0,0:14:23.90,0:14:25.63,Default - Copy,Raki,0,0,0,,Мен күштірек боламын
Dialogue: 0,0:14:26.20,0:14:27.63,Default - Copy,Raki,0,0,0,,Тірі қалу
Dialogue: 0,0:14:28.53,0:14:29.47,Default - Copy,Raki,0,0,0,,Содан кейін
Dialogue: 0,0:14:30.17,0:14:31.60,Default - Copy,Raki,0,0,0,,Мен қорғағым келеді
Dialogue: 0,0:14:44.12,0:14:47.05,Default - Copy,Raki,0,0,0,,Мен ештеңе істей алмаймын
Dialogue: 0,0:14:49.12,0:14:50.09,Default - Copy,Clare,0,0,0,,Раки
Dialogue: 0,0:14:57.33,0:14:59.00,Default - Copy,Ophelia,0,0,0,,Мен мұны істедім
Dialogue: 0,0:14:59.00,0:15:02.70,Default - Copy,Ophelia,0,0,0,,Теме балаға көмектесу үшін оянған адам болса, не істейді?
Dialogue: 0,0:15:02.70,0:15:05.30,Default - Copy,Ophelia,0,0,0,,Мені мүлде құтқара алмайсың, ақымақ.
Dialogue: 0,0:15:09.37,0:15:10.74,Default - Copy,Ophelia,0,0,0,,Бұл не?
Dialogue: 0,0:15:10.74,0:15:14.25,Default - Copy,Ophelia,0,0,0,,Ей, сіз қазір шегінен асып кеткен болуыңыз керек.
Dialogue: 0,0:15:14.25,0:15:15.75,Default - Copy,Ophelia,0,0,0,,Шарлатан болма
Dialogue: 0,0:15:16.45,0:15:18.58,Default - Copy,Ophelia,0,0,0,,Екі аяғы да бекітілген сияқты.
Dialogue: 0,0:15:18.98,0:15:23.09,Default - Copy,Ophelia,0,0,0,,Сіз шегінен асып кеткеннен кейін, сіз ештеңеге қарамастан қайта алмайсыз.
Dialogue: 0,0:15:24.66,0:15:25.26,Default - Copy,Ophelia,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:15:25.92,0:15:26.96,Default - Copy,Ophelia,0,0,0,,Ол басқа суреттерде де бар емес пе?
Dialogue: 0,0:15:28.53,0:15:30.26,Default - Copy,Ophelia,0,0,0,,Сіз ояусыз, солай емес пе?
Dialogue: 0,0:15:31.23,0:15:32.83,Default - Copy,Ophelia,0,0,0,,Бұл күлкілі
Dialogue: 0,0:15:32.83,0:15:35.67,Default - Copy,Ophelia,0,0,0,,Бұл өте күлкілі
Dialogue: 0,0:15:35.67,0:15:39.97,Default - Copy,Ophelia,0,0,0,,Бір күнде екі Оянған жаратылысты жұлып алғаныма сене алар емеспін.
Dialogue: 0,0:15:41.37,0:15:43.71,Default - Copy,Clare,0,0,0,,Раки мені құшақтап алды
Dialogue: 0,0:15:44.94,0:15:47.41,Default - Copy,Clare,0,0,0,,Қашу үшін бар күшіңізді жұмсаңыз
Dialogue: 0,0:15:47.95,0:15:50.65,Default - Copy,Clare,0,0,0,,Сені лақтырып алмас үшін мені ұста
Dialogue: 0,0:15:51.45,0:15:52.65,Default - Copy,Clare,0,0,0,,Мен жеңдім
Dialogue: 0,0:15:56.29,0:15:57.86,Default - Copy,Clare,0,0,0,,Қаттырақ ұстаңыз
Dialogue: 0,0:15:59.22,0:16:02.16,Default - Copy,Clare,0,0,0,,Өтінемін, сізді сілкіп тастауға рұқсат етпеңіз.
Dialogue: 0,0:16:04.83,0:16:08.40,Default - Copy,Ophelia,0,0,0,,О, сіз қашып кете аламын деп ойлайсыз ба?
Dialogue: 0,0:16:16.41,0:16:18.68,Default - Copy,A.O.,0,0,0,,Сол баланы артта қалдыру
Dialogue: 0,0:16:18.68,0:16:22.08,Default - Copy,A.O.,0,0,0,,Мен сенің қадіріңді білмей, сені кәдеге жаратамын.
Dialogue: 0,0:16:23.41,0:16:25.22,Default - Copy,Ophelia,0,0,0,,Надандық
Dialogue: 0,0:16:25.62,0:16:28.02,Default - Copy,A.O.,0,0,0,,Сіз қызықты нәрсе айттыңыз.
Dialogue: 0,0:16:28.55,0:16:30.79,Default - Copy,A.O.,0,0,0,,Сен мені екіге бөлесің
Dialogue: 0,0:16:31.52,0:16:34.03,Default - Copy,A.O.,0,0,0,,Кім жыртылады?
Dialogue: 0,0:16:37.53,0:16:38.86,Default - Copy,Ophelia,0,0,0,,Құбыжық атмосферасы
Dialogue: 0,0:16:39.96,0:16:42.23,Default - Copy,Ophelia,0,0,0,,Алаңдамаңыз.
Dialogue: 0,0:16:52.71,0:16:54.25,Default - Copy,Clare,0,0,0,,Мүмкіндігінше алыс
Dialogue: 0,0:16:57.12,0:16:58.42,Default - Copy,Clare,0,0,0,,Бір қадам алға
Dialogue: 0,0:17:08.53,0:17:09.69,Default - Copy,A.O.,0,0,0,,Бұл Миками растағанының белгісі
Dialogue: 0,0:17:10.23,0:17:13.43,Default - Copy,A.O.,0,0,0,,Сіз ештеңе білмеген сияқтысыз.
Dialogue: 0,0:17:14.20,0:17:14.93,Default - Copy,A.O.,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,0:17:15.30,0:17:16.83,Default - Copy,A.O.,0,0,0,,Өміріміз үшін жалбарынайық
Dialogue: 0,0:17:17.64,0:17:21.37,Default - Copy,A.O.,0,0,0,,Сіз менен күтпеген жерден бірдеңе сұрауыңыз мүмкін.
Dialogue: 0,0:17:21.97,0:17:24.38,Default - Copy,Ophelia,0,0,0,,Көп сөйлеме
Dialogue: 0,0:17:24.38,0:17:26.98,Default - Copy,Ophelia,0,0,0,,Менің аузым ауырып тұр
Dialogue: 0,0:17:30.31,0:17:31.52,Default - Copy,A.O.,0,0,0,,Минерва біз үшін осындай қауіпсіз орын дайындап қойған еді
Dialogue: 0,0:17:32.32,0:17:34.75,Default - Copy,A.O.,0,0,0,,Мен дөрекі адамдарды ұнатпаймын.
Dialogue: 0,0:17:44.19,0:17:45.26,Default - Copy,A.O.,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:17:45.26,0:17:46.70,Default - Copy,A.O.,0,0,0,,Сол балалар
Dialogue: 0,0:17:47.47,0:17:50.94,Default - Copy,A.O.,0,0,0,,Мама, бұл өте алыс.
Dialogue: 0,0:17:51.37,0:17:53.20,Default - Copy,A.O.,0,0,0,,Әлсіз және баяу
Dialogue: 0,0:17:53.20,0:17:54.71,Default - Copy,A.O.,0,0,0,,Мен тіпті қарай алмаймын.
Dialogue: 0,0:17:59.84,0:18:02.05,Default - Copy,A.O.,0,0,0,,1 4 0 0
Dialogue: 0,0:18:07.59,0:18:11.22,Default - Copy,A.O.,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:18:11.89,0:18:14.23,Default - Copy,A.O.,0,0,0,,Мойын
Dialogue: 0,0:18:14.66,0:18:17.90,Default - Copy,Ophelia,0,0,0,,Мойыңды сындырып алсаң, өлесің.
Dialogue: 0,0:18:22.03,0:18:25.97,Default - Copy,Ophelia,0,0,0,,Егер сіз оны шынымен өлтіргіңіз келсе, оның басын алуыңыз керек еді.
Dialogue: 0,0:18:26.94,0:18:30.61,Default - Copy,A.O.,0,0,0,,Құбыжық сен емессің.
Dialogue: 0,0:18:43.86,0:18:44.59,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:18:49.73,0:18:52.40,Default - Copy,Clare,0,0,0,,Ол қазірдің өзінде шешілді.
Dialogue: 0,0:18:53.20,0:18:54.13,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:18:55.57,0:18:57.47,Default - Copy,Clare,0,0,0,,Осы жерден біз екі топқа бөлінеміз.
Dialogue: 0,0:18:58.60,0:18:59.80,Default - Copy,Clare,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:19:00.27,0:19:02.57,Default - Copy,Clare,0,0,0,,Ол маған қарай келе жатыр.
Dialogue: 0,0:19:03.54,0:19:04.51,Default - Copy,Clare,0,0,0,,Ол шалбар есікті де жауып үлгере алмайды.
Dialogue: 0,0:19:06.44,0:19:07.21,Default - Copy,Clare,0,0,0,,Раки
Dialogue: 0,0:19:07.21,0:19:07.91,Default - Copy,Raki,0,0,0,,Маған ұнамайды
Dialogue: 0,0:19:09.28,0:19:11.45,Default - Copy,Raki,0,0,0,,Мен Клэрмен біргемін
Dialogue: 0,0:19:11.78,0:19:13.18,Default - Copy,Clare,0,0,0,,Мені тыңда
Dialogue: 0,0:19:13.62,0:19:16.29,Default - Copy,Clare,0,0,0,,Ол менің сиқырлы қуатымды сезіп, артымнан ереді.
Dialogue: 0,0:19:16.29,0:19:17.18,Default - Copy,Clare,0,0,0,,Сонымен
Dialogue: 0,0:19:17.52,0:19:18.42,Default - Copy,Raki,0,0,0,,Жоқ
Dialogue: 0,0:19:18.92,0:19:20.19,Default - Copy,Raki,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:19:20.73,0:19:22.76,Default - Copy,Raki,0,0,0,,Мен Клэрге көмектескім келеді.
Dialogue: 0,0:19:29.00,0:19:31.37,Default - Copy,Raki,0,0,0,,Мен оның пайдасы жоқ екенін білемін.
Dialogue: 0,0:19:32.10,0:19:35.27,Default - Copy,Raki,0,0,0,,Бірақ мен әлі де Клэрдің қасында болғым келеді.
Dialogue: 0,0:19:35.27,0:19:36.51,Default - Copy,Raki,0,0,0,,Мен өлсем де бәрібір
Dialogue: 0,0:19:36.51,0:19:38.21,Default - Copy,Raki,0,0,0,,Мен сенімен мәңгі бірге болғым келеді, Клэр.
Dialogue: 0,0:20:02.95,0:20:05.04,Default - Copy,Clare,0,0,0,,Өлсем жарайды деме
Dialogue: 0,0:20:06.00,0:20:07.17,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:20:08.01,0:20:09.14,Default - Copy,Clare,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:20:09.67,0:20:10.98,Default - Copy,Clare,0,0,0,,Мен өлмеймін
Dialogue: 0,0:20:11.58,0:20:14.01,Default - Copy,Clare,0,0,0,,Мен міндетті түрде өмір сүремін және сенімен қайта қауышамын.
Dialogue: 0,0:20:15.38,0:20:17.22,Default - Copy,Clare,0,0,0,,Сондықтан Рақи да өлмейді.
Dialogue: 0,0:20:17.95,0:20:19.45,Default - Copy,Clare,0,0,0,,Мен оны міндетті түрде табамын.
Dialogue: 0,0:20:20.15,0:20:21.85,Default - Copy,Clare,0,0,0,,Оған дейін аман қаласыз.
Dialogue: 0,0:20:23.39,0:20:24.36,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:20:24.96,0:20:25.99,Default - Copy,Clare,0,0,0,,Бұл уәде.
Dialogue: 0,0:20:28.26,0:20:29.19,Default - Copy,Raki,0,0,0,,Мен түсінемін.
Dialogue: 0,0:20:29.53,0:20:31.56,Default - Copy,Raki,0,0,0,,Клэр мен уәде беремін
Dialogue: 0,0:20:32.35,0:20:33.73,Default - Copy,Raki,0,0,0,,Күшті болыңыз және аман болыңыз
Dialogue: 0,0:20:35.07,0:20:37.47,Default - Copy,Raki,0,0,0,,Бір күні мен
Dialogue: 0,0:20:39.17,0:20:42.51,Default - Copy,Raki,0,0,0,,Мен бір күні Клэрді міндетті түрде қорғаймын
Dialogue: 0,0:20:43.68,0:20:44.51,Default - Copy,Raki,0,0,0,,Міндетті түрде.
Dialogue: 0,0:20:52.78,0:20:54.25,Default - Copy,Clare,0,0,0,,Лабонаның Құдайы
Dialogue: 0,0:20:54.82,0:20:56.65,Default - Copy,Clare,0,0,0,,Менің тілегімді тыңдаңыз
Dialogue: 0,0:20:58.09,0:21:00.26,Default - Copy,Clare,0,0,0,,Біраз күш пен мейірімділік
Dialogue: 0,0:21:01.33,0:21:03.46,Default - Copy,Clare,0,0,0,,Оны сол балаға бер.
Dialogue: 0,0:21:04.83,0:21:08.20,Default - Copy,Clare,0,0,0,,Менімен қайта кездескенше
Dialogue: 0,0:21:15.67,0:21:19.88,Default - Copy,Ophelia,0,0,0,,Мойнымдағы қаттылық жақсы өтті.
Dialogue: 0,0:21:22.88,0:21:26.88,Default - Copy,Ophelia,0,0,0,,Басқа оянған жануарды іздеуге кірісеміз бе?
Dialogue: 0,0:22:40.40,0:22:42.30,Default - Copy,,0,0,0,,Жүрегімді толқындар мазалайды
Dialogue: 0,0:22:42.30,0:22:43.84,Default - Copy,,0,0,0,,Ертең толқындар шашылады
Dialogue: 0,0:22:43.94,0:22:46.54,Default - Copy,,0,0,0,,Өткендегі жауынгер
Dialogue: 0,0:22:48.04,0:22:54.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory