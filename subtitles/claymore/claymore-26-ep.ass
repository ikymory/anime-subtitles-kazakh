Dialogue: 0,0:02:55.05,0:02:56.07,Default,,0,0,0,,Жын
Dialogue: 0,0:02:58.00,0:03:01.00,Default,,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:03:01.07,0:03:02.08,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:03:02.08,0:03:04.00,Default,,0,0,0,,Ана
Dialogue: 0,0:03:04.05,0:03:05.09,Default,,0,0,0,,Менің ағам
Dialogue: 0,0:03:06.08,0:03:08.03,Default,,0,0,0,,Менің әпкем
Dialogue: 0,0:03:12.07,0:03:17.08,Default,,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:03:18.06,0:03:19.05,Default,,0,0,0,,Прискила
Dialogue: 0,0:03:21.04,0:03:23.03,Default,,0,0,0,,Міне солай
Dialogue: 0,0:03:24.00,0:03:25.03,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:03:25.07,0:03:27.05,Default,,0,0,0,,Жын сияқты нәрсе
Dialogue: 0,0:03:27.09,0:03:30.08,Default,,0,0,0,,Жындар және т.б.
Dialogue: 0,0:03:33.01,0:03:34.00,Default,,0,0,0,,Клэр
Dialogue: 0,0:03:44.09,0:03:46.02,Default,,0,0,0,,Жын – бұл
Dialogue: 0,0:03:46.05,0:03:48.02,Default,,0,0,0,,Мұны сенің мойныңа артып отырғаныма өкінемін, бірақ қорғаныс үшін саған сенемін.
Dialogue: 0,0:03:51.02,0:03:52.04,Default,,0,0,0,,өлтіру
Dialogue: 0,0:03:54.07,0:03:55.06,Default,,0,0,0,,өлтіру
Dialogue: 0,0:04:05.01,0:04:06.05,Default,,0,0,0,,өлтіру
Dialogue: 0,0:04:36.00,0:04:37.08,Default,,0,0,0,,Бұл
Dialogue: 0,0:04:47.09,0:04:48.08,Default,,0,0,0,,Клэр
Dialogue: 0,0:05:01.02,0:05:02.07,Default,,0,0,0,,Не?
Dialogue: 0,0:05:06.05,0:05:08.09,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:11.01,0:05:12.01,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:05:12.04,0:05:14.07,Default,,0,0,0,,Оны біз сияқты ешкім тоқтата алмайды.
Dialogue: 0,0:05:20.07,0:05:21.08,Default,,0,0,0,,Клэр
Dialogue: 0,0:05:22.06,0:05:23.08,Default,,0,0,0,,Прискила
Dialogue: 0,0:05:24.08,0:05:28.01,Default,,0,0,0,,Неліктен, не үшін күресуіміз керек?
Dialogue: 0,0:05:28.09,0:05:30.02,Default,,0,0,0,,Оларды мына жерге ыстық шоколадпен қойып кетейін, жарай ма?
Dialogue: 0,0:05:30.04,0:05:31.07,Default,,0,0,0,,Клэр
Dialogue: 0,0:05:31.07,0:05:32.07,Default,,0,0,0,,Прискила
Dialogue: 0,0:05:33.02,0:05:35.04,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:06:15.04,0:06:16.06,Default,,0,0,0,,Көңіл қалдырады.
Dialogue: 0,0:06:19.00,0:06:20.01,Default,,0,0,0,,Клэр
Dialogue: 0,0:06:31.06,0:06:35.00,Default,,0,0,0,,Сіз Тереза ​​емессіз, солай ма?
Dialogue: 0,0:06:35.09,0:06:38.00,Default,,0,0,0,,Бірақ олардың иісі ұқсас.
Dialogue: 0,0:06:39.03,0:06:40.02,Default,,0,0,0,,Сонымен
Dialogue: 0,0:06:41.02,0:06:42.04,Default,,0,0,0,,Өлген
Dialogue: 0,0:06:45.00,0:06:47.06,Default,,0,0,0,,Қанатсыз болу ыңғайсыз.
Dialogue: 0,0:06:59.06,0:07:02.06,Default,,0,0,0,,Мен сені өлтіремін
Dialogue: 0,0:07:09.02,0:07:10.03,Default,,0,0,0,,Тереза
Dialogue: 0,0:08:26.02,0:08:29.04,Default,,0,0,0,,Сіз Терезасыз
Dialogue: 0,0:08:33.02,0:08:33.52,Default,,0,0,0,,Клэр
Dialogue: 0,0:08:35.02,0:08:35.52,Default,,0,0,0,,Клэр
Dialogue: 0,0:08:37.09,0:08:38.09,Default,,0,0,0,,Клэр
Dialogue: 0,0:08:40.05,0:08:41.05,Default,,0,0,0,,Клэр
Dialogue: 0,0:08:43.04,0:08:44.00,Default,,0,0,0,,Клэр
Dialogue: 0,0:08:45.04,0:08:46.09,Default,,0,0,0,,Клэр
Dialogue: 0,0:08:48.03,0:08:50.02,Default,,0,0,0,,Клэр, №.
Dialogue: 0,0:08:53.08,0:08:54.08,Default,,0,0,0,,Клэр
Dialogue: 0,0:08:56.04,0:08:59.03,Default,,0,0,0,,Өтінемін, тоқтатыңызшы.
Dialogue: 0,0:09:00.01,0:09:03.03,Default,,0,0,0,,Бұл шайқас тым қорқынышты
Dialogue: 0,0:09:03.07,0:09:04.08,Default,,0,0,0,,Йосе
Dialogue: 0,0:09:04.08,0:09:06.01,Default,,0,0,0,,Клэр қазір
Dialogue: 0,0:09:07.08,0:09:08.06,Default,,0,0,0,,Клэр
Dialogue: 0,0:09:09.01,0:09:12.09,Default,,0,0,0,,Прискила Клэр үшін маңызды адамды өлтірген болуы мүмкін
Dialogue: 0,0:09:13.03,0:09:14.05,Default,,0,0,0,,Бірақ
Dialogue: 0,0:09:14.05,0:09:17.09,Default,,0,0,0,,Прискиланың отбасын да жындар өлтірді.
Dialogue: 0,0:09:18.04,0:09:19.07,Default,,0,0,0,,Присцилла ғана емес
Dialogue: 0,0:09:20.02,0:09:23.06,Default,,0,0,0,,Жындардың кесірінен бәрі бір нәрседен айырылды.
Dialogue: 0,0:09:24.01,0:09:28.08,Default,,0,0,0,,Ал қалған адамдар қайтадан бір-бірін өлтіріп жатыр.
Dialogue: 0,0:09:29.04,0:09:31.08,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:09:33.05,0:09:36.07,Default,,0,0,0,,Клэр Құбыжыққа айналма.
Dialogue: 0,0:09:37.05,0:09:39.02,Default,,0,0,0,,Егер сіз Прискиланы өлтірсеңіз
Dialogue: 0,0:09:39.02,0:09:41.00,Default,,0,0,0,,Клэр де жынға ұқсайды.
Dialogue: 0,0:09:41.09,0:09:42.06,Default,,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:09:45.07,0:09:46.07,Default,,0,0,0,,өлтіру
Dialogue: 0,0:09:47.06,0:09:48.09,Default,,0,0,0,,Тереза
Dialogue: 0,0:09:49.03,0:09:52.00,Default,,0,0,0,,Тереза
Dialogue: 0,0:09:52.06,0:09:56.02,Default,,0,0,0,,Сіз
Dialogue: 0,0:09:57.08,0:09:59.00,Default,,0,0,0,,Өлтірілді
Dialogue: 0,0:09:59.00,0:10:01.02,Default,,0,0,0,,Клэр Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:10:02.00,0:10:02.50,Default,,0,0,0,,Раки
Dialogue: 0,0:10:04.02,0:10:05.00,Default,,0,0,0,,Клэр
Dialogue: 0,0:10:05.05,0:10:06.06,Default,,0,0,0,,Барма
Dialogue: 0,0:10:07.03,0:10:08.08,Default,,0,0,0,,Барма.
Dialogue: 0,0:10:08.08,0:10:09.06,Default,,0,0,0,,Клэр
Dialogue: 0,0:10:20.00,0:10:20.50,Default,,0,0,0,,тоқтатылды
Dialogue: 0,0:10:21.04,0:10:22.03,Default,,0,0,0,,Клэр
Dialogue: 0,0:10:23.01,0:10:24.01,Default,,0,0,0,,Сәлем Клэр
Dialogue: 0,0:10:24.06,0:10:26.02,Default,,0,0,0,,Мен уәде берер едім
Dialogue: 0,0:10:26.02,0:10:28.08,Default,,0,0,0,,Біз міндетті түрде өмір сүреміз және қайтадан кездесеміз.
Dialogue: 0,0:10:30.00,0:10:32.03,Default,,0,0,0,,Өйткені Клэр маған өлмеу керектігін айтты.
Dialogue: 0,0:10:32.03,0:10:35.03,Default,,0,0,0,,Мен жолымды әрі қарай жалғастырдым
Dialogue: 0,0:10:35.08,0:10:38.07,Default,,0,0,0,,Бір күні мен қайтадан Клэрмен бірге боламын
Dialogue: 0,0:10:39.08,0:10:42.00,Default,,0,0,0,,Мен қайтадан аспаз болғым келеді
Dialogue: 0,0:10:43.07,0:10:45.06,Default,,0,0,0,,Клэр Мен
Dialogue: 0,0:10:46.00,0:10:47.01,Default,,0,0,0,,Маған Клэр ұнайды
Dialogue: 0,0:10:48.03,0:10:49.05,Default,,0,0,0,,Барма
Dialogue: 0,0:10:49.08,0:10:51.06,Default,,0,0,0,,Жынға айналма
Dialogue: 0,0:10:53.03,0:10:54.01,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:10:54.07,0:10:56.09,Default,,0,0,0,,Мен сені бұл жолы міндетті түрде қорғаймын.
Dialogue: 0,0:10:57.08,0:11:01.00,Default,,0,0,0,,Адам болып соңына дейін аман бол
Dialogue: 0,0:11:02.06,0:11:04.03,Default,,0,0,0,,Адам болып өмір сүр
Dialogue: 0,0:11:06.08,0:11:09.00,Default,,0,0,0,,Раки
Dialogue: 0,0:11:11.01,0:11:12.00,Default,,0,0,0,,Клэр
Dialogue: 0,0:11:14.00,0:11:15.00,Default,,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:11:15.09,0:11:17.07,Default,,0,0,0,,Қаш
Dialogue: 0,0:11:19.01,0:11:21.09,Default,,0,0,0,,Енді I
Dialogue: 0,0:11:24.02,0:11:25.07,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:11:25.07,0:11:26.04,Default,,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:11:41.08,0:11:42.06,Default,,0,0,0,,Джин мырза
Dialogue: 0,0:11:45.09,0:11:48.00,Default,,0,0,0,,Джи Ген
Dialogue: 0,0:11:49.06,0:11:51.07,Default,,0,0,0,,Сіз бұл жолы қашып кетпедіңіз.
Dialogue: 0,0:11:52.05,0:11:53.06,Default,,0,0,0,,Жарайсың.
Dialogue: 0,0:11:56.05,0:11:57.05,Default,,0,0,0,,Ген
Dialogue: 0,0:11:57.09,0:11:59.09,Default,,0,0,0,,Неліктен бұл ұнайды?
Dialogue: 0,0:12:00.07,0:12:04.06,Default,,0,0,0,,Бұл уақыттың керісінше, Клэр.
Dialogue: 0,0:12:06.09,0:12:13.07,Default,,0,0,0,,Сол кезде мені оятып, қайтадан адамға айналдырдың.
Dialogue: 0,0:12:14.05,0:12:15.06,Default,,0,0,0,,Артыңа шегін!
Dialogue: 0,0:12:16.07,0:12:21.05,Default,,0,0,0,,Сол кездегі айтқан сөзім мен жақсылығымды қайтаруға келдім.
Dialogue: 0,0:12:23.02,0:12:24.01,Default,,0,0,0,,Артыңа шегін!
Dialogue: 0,0:12:24.07,0:12:26.03,Default,,0,0,0,,Сіз мұны істей аласыз
Dialogue: 0,0:12:27.04,0:12:29.01,Default,,0,0,0,,Сол кездегідей
Dialogue: 0,0:12:29.04,0:12:31.04,Default,,0,0,0,,Жындарды реттеңіз
Dialogue: 0,0:12:32.06,0:12:37.00,Default,,0,0,0,,Олай жасасаң, жындарыңды қайтарамын.
Dialogue: 0,0:12:39.01,0:12:40.09,Default,,0,0,0,,Бір рет жасалды.
Dialogue: 0,0:12:41.05,0:12:43.02,Default,,0,0,0,,Мен мұны міндетті түрде қайталай аламын
Dialogue: 0,0:12:43.02,0:12:44.07,Default,,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:12:45.02,0:12:47.03,Default,,0,0,0,,Егер сіз мұны жасасаңыз, сіз
Dialogue: 0,0:12:48.00,0:12:49.00,Default,,0,0,0,,Босатыңыз
Dialogue: 0,0:12:49.04,0:12:50.06,Default,,0,0,0,,Жараларды емдеу
Dialogue: 0,0:12:51.02,0:12:52.02,Default,,0,0,0,,Әлі уақытында
Dialogue: 0,0:12:52.06,0:12:54.00,Default,,0,0,0,,Клэр
Dialogue: 0,0:12:54.04,0:12:57.00,Default,,0,0,0,,Бұл қазірдің өзінде өлімге әкелетін жарақат.
Dialogue: 0,0:12:58.01,0:12:59.03,Default,,0,0,0,,Түсінесің бе?
Dialogue: 0,0:13:00.04,0:13:02.02,Default,,0,0,0,,Кем дегенде соңында
Dialogue: 0,0:13:02.08,0:13:07.01,Default,,0,0,0,,Қалған өмірімді сен үшін өткізуге рұқсат ет.
Dialogue: 0,0:13:07.01,0:13:09.02,Default,,0,0,0,,Ген
Dialogue: 0,0:13:09.06,0:13:11.01,Default,,0,0,0,,Кеттік, Клэр.
Dialogue: 0,0:13:11.01,0:13:12.04,Default,,0,0,0,,Көңіл-күйлеріңізді сәйкестендіріңіз
Dialogue: 0,0:13:18.08,0:13:20.07,Default,,0,0,0,,Ген, тоқтат.
Dialogue: 0,0:13:21.02,0:13:23.03,Default,,0,0,0,,Мұны істеудің қажеті жоқ
Dialogue: 0,0:13:24.00,0:13:25.08,Default,,0,0,0,,Сіз маған ешқандай жақсылық қарызсыз.
Dialogue: 0,0:13:26.05,0:13:29.03,Default,,0,0,0,,Сіздің өміріңіз сіздікі.
Dialogue: 0,0:13:29.03,0:13:30.08,Default,,0,0,0,,Клэр, концентрат.
Dialogue: 0,0:13:31.02,0:13:32.03,Default,,0,0,0,,Йосе
Dialogue: 0,0:13:32.03,0:13:33.04,Default,,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:13:33.04,0:13:34.05,Default,,0,0,0,,Клэр
Dialogue: 0,0:13:35.03,0:13:36.02,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:13:37.02,0:13:41.02,Default,,0,0,0,,Мен адам болып қайта оралсам да, менің өмірімнен еш пайда жоқ.
Dialogue: 0,0:13:42.00,0:13:44.03,Default,,0,0,0,,Присцилланы жеңе алмасаңыз
Dialogue: 0,0:13:44.03,0:13:45.07,Default,,0,0,0,,Біз өлерміз
Dialogue: 0,0:13:45.07,0:13:46.07,Default,,0,0,0,,Клэр
Dialogue: 0,0:13:48.03,0:13:51.04,Default,,0,0,0,,Өмірдің мәнін кейінірек таба аласыз.
Dialogue: 0,0:13:52.02,0:13:53.03,Default,,0,0,0,,Тек ұмытпа
Dialogue: 0,0:13:53.07,0:13:57.00,Default,,0,0,0,,Сенің өмір сүргеніңді қалайтын адамдар бар.
Dialogue: 0,0:13:57.06,0:14:01.00,Default,,0,0,0,,Сізге деген сезімі бар адамдар бар.
Dialogue: 0,0:14:07.07,0:14:10.05,Default,,0,0,0,,Ал мен солардың бірімін.
Dialogue: 0,0:14:11.00,0:14:12.03,Default,,0,0,0,,Ген
Dialogue: 0,0:14:14.08,0:14:16.06,Default,,0,0,0,,Тікелей Клэр
Dialogue: 0,0:14:18.03,0:14:20.03,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:14:21.04,0:14:23.08,Default,,0,0,0,,Ген
Dialogue: 0,0:14:55.03,0:14:58.06,Default,,0,0,0,,Джин, сен неге?
Dialogue: 0,0:15:06.00,0:15:08.06,Default,,0,0,0,,Ген гені
Dialogue: 0,0:15:20.01,0:15:22.06,Default,,0,0,0,,Бұл өте қызықты көрініс болды.
Dialogue: 0,0:15:23.07,0:15:24.06,Default,,0,0,0,,Сіз
Dialogue: 0,0:15:25.01,0:15:26.09,Default,,0,0,0,,Солтүстік Исли?
Dialogue: 0,0:15:29.03,0:15:31.01,Default,,0,0,0,,Тұрақсыз бала
Dialogue: 0,0:15:31.01,0:15:33.04,Default,,0,0,0,,Мен әлі жібергім келмейді.
Dialogue: 0,0:15:33.08,0:15:35.03,Default,,0,0,0,,Мен оны қайтарып аламын.
Dialogue: 0,0:15:40.04,0:15:44.03,Default,,0,0,0,,Мен күткендей, бұл балалардың шайқасынан қанықпын.
Dialogue: 0,0:15:45.00,0:15:48.08,Default,,0,0,0,,Бұдан артық істеу этикаға жатпайды.
Dialogue: 0,0:15:49.05,0:15:51.03,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:15:53.07,0:15:55.08,Default,,0,0,0,,Әзірше осы.
Dialogue: 0,0:15:56.08,0:15:59.07,Default,,0,0,0,,Рақы Кездесетін кезіміз болады.
Dialogue: 0,0:15:59.07,0:16:02.02,Default,,0,0,0,,Қылыш шеберлігін шыңдау
Dialogue: 0,0:16:05.07,0:16:10.01,Default,,0,0,0,,Бұл басым жындық қуат дегеніміз не?
Dialogue: 0,0:16:10.07,0:16:12.05,Default,,0,0,0,,Солтүстік Исли?
Dialogue: 0,0:16:13.01,0:16:15.05,Default,,0,0,0,,Шүкір, бәрі құбыжықтар туралы.
Dialogue: 0,0:16:16.01,0:16:18.04,Default,,0,0,0,,Аа, бұл солай.
Dialogue: 0,0:16:18.09,0:16:20.02,Default,,0,0,0,,Бұл тозақ.
Dialogue: 0,0:16:37.01,0:16:38.01,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:39.07,0:16:44.00,Default,,0,0,0,,Присцилладан басқа солтүстіктен Исли де келді.
Dialogue: 0,0:16:44.07,0:16:47.03,Default,,0,0,0,,Қосымша түсініктеме қажет емес.
Dialogue: 0,0:16:47.08,0:16:49.00,Default,,0,0,0,,Дегенмен, қанша рет шайқассақ та, сен меннен әлсізсің.
Dialogue: 0,0:16:50.06,0:16:52.00,Default,,0,0,0,,Мен ешбір елес энергияны сезбеймін.
Dialogue: 0,0:16:52.05,0:16:54.05,Default,,0,0,0,,Менің айта алатыным осы ғана
Dialogue: 0,0:16:55.02,0:16:57.09,Default,,0,0,0,,Егер сізді қызықтыратын болсаңыз, оны тексеріп көріңіз.
Dialogue: 0,0:16:58.04,0:16:59.03,Default,,0,0,0,,That's right.
Dialogue: 0,0:17:00.01,0:17:01.01,Default,,0,0,0,,Мұны істейік
Dialogue: 0,0:17:03.03,0:17:04.09,Default,,0,0,0,,Мен мұны айтқым келеді
Dialogue: 0,0:17:05.05,0:17:07.00,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:17:07.05,0:17:10.05,Default,,0,0,0,,Біз де осы соғыстың зардаптарын жоюымыз керек.
Dialogue: 0,0:17:14.05,0:17:17.05,Default,,0,0,0,,Тірі қалуыңызды көрсетіңіз, Клэр.
Dialogue: 0,0:17:26.06,0:17:28.07,Default,,0,0,0,,Клэр, жақсысың ба?
Dialogue: 0,0:17:29.02,0:17:32.02,Default,,0,0,0,,Жанынан айырылғандай көрінді.
Dialogue: 0,0:17:34.02,0:17:36.03,Default,,0,0,0,,Сіз жүре бастайсыз ба, тоқтайсыз ба
Dialogue: 0,0:17:36.03,0:17:38.01,Default,,0,0,0,,Оны Клэр шешеді.
Dialogue: 0,0:17:38.07,0:17:41.03,Default,,0,0,0,,Бұл бізге араласу емес.
Dialogue: 0,0:17:41.03,0:17:42.03,Default,,0,0,0,,О
Dialogue: 0,0:17:42.03,0:17:43.05,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:17:44.07,0:17:46.00,Default,,0,0,0,,Осы жерден бөлінейік
Dialogue: 0,0:17:47.05,0:17:48.07,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:17:48.07,0:17:51.01,Default,,0,0,0,,Не, енді не істеуіміз керек?
Dialogue: 0,0:17:52.09,0:17:55.09,Default,,0,0,0,,Жерлеу шайқасы әлі аяқталған жоқ.
Dialogue: 0,0:17:55.09,0:17:57.02,Default,,0,0,0,,Ұйымнан шығу
Dialogue: 0,0:17:57.02,0:17:59.00,Default,,0,0,0,,Сол мақсат үшін күш жинаңыз
Dialogue: 0,0:17:59.06,0:18:01.08,Default,,0,0,0,,Мен де осындай жолмен жүрмін.
Dialogue: 0,0:18:01.08,0:18:05.03,Default,,0,0,0,,Ұйым туралы әлі толық білмеймін.
Dialogue: 0,0:18:05.08,0:18:08.07,Default,,0,0,0,,Әзірше көпшілікпен араласып, мүмкіндікті пайдаланыңыз.
Dialogue: 0,0:18:09.07,0:18:10.09,Default,,0,0,0,,Бұл қарапайым.
Dialogue: 0,0:18:11.04,0:18:13.06,Default,,0,0,0,,Хелен, сен не істейсің?
Dialogue: 0,0:18:13.09,0:18:17.08,Default,,0,0,0,,Осы оқиғадан кейін ұйымға қайтып келгім келмейді.
Dialogue: 0,0:18:18.01,0:18:19.06,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:18:20.03,0:18:22.04,Default,,0,0,0,,Онда менімен келесің бе?
Dialogue: 0,0:18:22.04,0:18:26.06,Default,,0,0,0,,Жалғыз қылыш шеберлігін шыңдау қиын.
Dialogue: 0,0:18:26.06,0:18:28.03,Default,,0,0,0,,Сіз мұны қарсыласыңызға қарсы жасай аласыз.
Dialogue: 0,0:18:31.01,0:18:33.01,Default,,0,0,0,,Бұл тағы бір қоштасу.
Dialogue: 0,0:18:36.04,0:18:37.09,Default,,0,0,0,,Бір күні емес
Dialogue: 0,0:18:38.06,0:18:39.08,Default,,0,0,0,,Сөзсіз кездесейік
Dialogue: 0,0:18:40.01,0:18:40.51,Default,,0,0,0,,О
Dialogue: 0,0:18:41.09,0:18:43.01,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:18:46.00,0:18:47.01,Default,,0,0,0,,Ол жігіт те
Dialogue: 0,0:18:57.03,0:18:58.03,Default,,0,0,0,,Ұмытпаңыз
Dialogue: 0,0:18:59.03,0:19:02.03,Default,,0,0,0,,Сенің өмір сүргеніңді қалайтын адамдар бар екенін есте сақта.
Dialogue: 0,0:19:04.00,0:19:07.00,Default,,0,0,0,,Сізге деген сезімі бар адамдар бар.
Dialogue: 0,0:19:09.02,0:19:11.02,Default,,0,0,0,,Тікелей Клэр
Dialogue: 0,0:19:20.02,0:19:21.02,Default,,0,0,0,,Клэр
Dialogue: 0,0:19:21.08,0:19:24.04,Default,,0,0,0,,Кешіріңіз, мен оны бірден таба алмадым.
Dialogue: 0,0:19:25.04,0:19:26.08,Default,,0,0,0,,Сіздің қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:19:26.08,0:19:27.09,Default,,0,0,0,,Бұл қиын болған болуы керек
Dialogue: 0,0:19:30.04,0:19:33.02,Default,,0,0,0,,Ұйымға қайта оралу ойым жоқ.
Dialogue: 0,0:19:34.06,0:19:38.02,Default,,0,0,0,,Бұдан былай бұл сапар сенікінен де қиынырақ болады.
Dialogue: 0,0:19:39.00,0:19:40.04,Default,,0,0,0,,Сіз менің артымнан келесіз бе?
Dialogue: 0,0:19:43.05,0:19:44.07,Default,,0,0,0,,Клэр
Dialogue: 0,0:19:46.02,0:19:50.05,Default,,0,0,0,,Мен Клэрмен мәңгі бірге болдым.
Dialogue: 0,0:19:50.09,0:19:52.01,Default,,0,0,0,,Клэр
Dialogue: 0,0:19:55.01,0:19:56.00,Default,,0,0,0,,Раки
Dialogue: 0,0:20:41.00,0:20:41.50,Default,,0,0,0,,Тереза
Dialogue: 0,0:20:42.08,0:20:44.01,Default,,0,0,0,,Мен тірімін
Dialogue: 0,0:20:45.05,0:20:48.00,Default,,0,0,0,,«Бұл жақсы» дейсіз бе?
Dialogue: 0,0:21:08.02,0:21:11.08,Default,,0,0,0,,Басқалар арасында адам сияқты өмір сүр
Dialogue: 0,0:21:12.06,0:21:13.04,Default,,0,0,0,,Клэр
Dialogue: 0,0:21:14.54,0:21:19.54,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
