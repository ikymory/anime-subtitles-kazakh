Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.60,0:00:10.87,Default - Copy,Limt,0,0,0,,Мен 47 нөмірімен байланыса алмаймын.
Dialogue: 0,0:00:11.74,0:00:13.77,Default - Copy,Limt,0,0,0,,Период қанша уақытқа созылады?
Dialogue: 0,0:00:14.71,0:00:19.28,Default - Copy,Rubel,0,0,0,,Гонар қаласында оянғандар түпкілікті бағындырылғаннан кейін үш айдан кейін
Dialogue: 0,0:00:20.38,0:00:23.15,Default - Copy,Limt,0,0,0,,Бұл 4 саны бар миссия.
Dialogue: 0,0:00:23.82,0:00:27.42,Default - Copy,Limt,0,0,0,,Ол өлді деп есептелсе де
Dialogue: 0,0:00:27.42,0:00:29.72,Default - Copy,Rubel,0,0,0,,Мәйіт табылмады
Dialogue: 0,0:00:30.79,0:00:37.03,Default - Copy,Limt,0,0,0,,№4 Офелияның мәйіті оянған адам ретінде табылды.
Dialogue: 0,0:00:37.03,0:00:40.47,Default - Copy,Limt,0,0,0,,№47 оны өлтіру мүмкіндігі
Dialogue: 0,0:00:41.10,0:00:43.47,Default - Copy,Rubel,0,0,0,,Күш айырмашылығын қарастыру
Dialogue: 0,0:00:43.47,0:00:45.22,Default - Copy,Rubel,0,0,0,,Нөлге жақын болуы мүмкін.
Dialogue: 0,0:00:46.34,0:00:48.14,Default - Copy,Limt,0,0,0,,Бастапқыда,
Dialogue: 0,0:00:49.07,0:00:56.97,Default - Copy,Limt,0,0,0,,Бірақ 47 саны Терезаның еті мен қанына енген ерекше тұлға болса керек.
Dialogue: 0,0:00:57.45,0:01:01.99,Default - Copy,Rubel,0,0,0,,Талантты жарылқаған жартылай адам, жартылай жынның қанын мұра ету арқылы.
Dialogue: 0,0:01:01.99,0:01:05.31,Default - Copy,Rubel,0,0,0,,Бұл күштің табандылығын өлшеу әрекеті болды.
Dialogue: 0,0:01:06.16,0:01:10.08,Default - Copy,Rubel,0,0,0,,Соңында бұл елес деген қорытындыға келу керек еді.
Dialogue: 0,0:01:11.06,0:01:13.56,Default - Copy,Limt,0,0,0,,Тек санға қарап
Dialogue: 0,0:01:14.17,0:01:19.27,Default - Copy,Limt,0,0,0,,Дегенмен, 47 санына қатысты әлі де белгісіздік элементі бар.
Dialogue: 0,0:01:20.41,0:01:24.60,Default - Copy,Limt,0,0,0,,Қалай болғанда да, мен сенің тірісің бе, өлісің бе білмей жалғыз қалдыра алмаймын.
Dialogue: 0,0:01:25.24,0:01:29.60,Default - Copy,Limt,0,0,0,,Егер ол тірі болса, біз оны таба алатынымызға сенімдімін.
Dialogue: 0,0:01:30.62,0:01:31.60,Default - Copy,Limt,0,0,0,,Эрмита
Dialogue: 0,0:01:32.65,0:01:33.28,Default - Copy,Ermita,0,0,0,,Иә
Dialogue: 0,0:01:34.49,0:01:37.26,Default - Copy,Limt,0,0,0,,Оны осы тапсырманы орындауға тапсырыңыз.
Dialogue: 0,0:01:37.26,0:01:39.39,Default - Copy,Limt,0,0,0,,Негізгі басымдық.
Dialogue: 0,0:01:39.39,0:01:41.61,Default - Copy,Limt,0,0,0,,Басқаларын кейінге қалдыруға болады.
Dialogue: 0,0:01:41.96,0:01:43.59,Default - Copy,Ermita,0,0,0,,Түсінікті
Dialogue: 0,0:01:47.50,0:01:49.17,Default - Copy,Rubel,0,0,0,,Эрмита туралы айту
Dialogue: 0,0:01:49.17,0:01:51.10,Default - Copy,Rubel,0,0,0,,Бұл әйелдің кезегі ме?
Dialogue: 0,0:01:52.07,0:01:53.67,Default - Copy,Rubel,0,0,0,,Бұл шарасыз жағдай.
Dialogue: 0,0:01:54.04,0:01:57.78,Default - Copy,Rubel,0,0,0,,Мен не істеуім керек? 47 нөмірі Клэр
Dialogue: 0,0:03:19.63,0:03:20.47,Default - Copy,Clare,0,0,0,,Кешіріңіз
Dialogue: 0,0:03:22.83,0:03:24.27,Default - Copy,Clare,0,0,0,,Інімді іздеп жүрмін
Dialogue: 0,0:03:25.10,0:03:28.61,Default - Copy,Clare,0,0,0,,Сіз осы жерде қылыш көтеріп жүрген баланы көрдіңіз бе?
Dialogue: 0,0:03:29.41,0:03:30.48,Default - Copy,man,0,0,0,,Келіңіздер
Dialogue: 0,0:03:31.18,0:03:32.48,Default - Copy,woman,0,0,0,,Мен оны көрген жоқпын.
Dialogue: 0,0:03:33.11,0:03:33.91,Default - Copy,Clare,0,0,0,,Мен көремін.
Dialogue: 0,0:03:35.21,0:03:38.25,Default - Copy,man,0,0,0,,Неге алда Ханель қаласына бармайсың?
Dialogue: 0,0:03:39.08,0:03:41.32,Default - Copy,man,0,0,0,,Өйткені бұл қалада адамдар көп келеді, кетеді.
Dialogue: 0,0:03:41.32,0:03:43.09,Default - Copy,man,0,0,0,,Оны біреу көрген болуы мүмкін.
Dialogue: 0,0:03:43.09,0:03:44.12,Default - Copy,Clare,0,0,0,,Рахмет
Dialogue: 0,0:03:44.52,0:03:45.49,Default - Copy,Clare,0,0,0,,Кеттік
Dialogue: 0,0:03:47.59,0:03:49.86,Default - Copy,man,0,0,0,,Табасың деп үміттенемін, аға.
Dialogue: 0,0:03:51.36,0:03:53.33,Default - Copy,woman,0,0,0,,Сәл дөрекі емес.
Dialogue: 0,0:03:53.33,0:03:55.13,Default - Copy,woman,0,0,0,,Ол адам әйел болуы керек.
Dialogue: 0,0:03:55.13,0:03:56.07,Default - Copy,man,0,0,0,,Иә…♡
Dialogue: 0,0:03:56.07,0:03:58.40,Default - Copy,man,0,0,0,,Арқасында сондай үлкен қылыш алып жүр.
Dialogue: 0,0:03:58.40,0:03:59.87,Default - Copy,man,0,0,0,,Оның даусы да бәсең болған шығар.
Dialogue: 0,0:04:00.24,0:04:01.47,Default - Copy,man,0,0,0,,Бұл ер адам
Dialogue: 0,0:04:03.71,0:04:06.71,Default - Copy,Clare,0,0,0,,Даусымды сәл қоюлау керек пе?
Dialogue: 0,0:04:07.25,0:04:08.71,Default - Copy,Clare,0,0,0,,Дауыс байламдарын созыңыз
Dialogue: 0,0:04:26.03,0:04:29.23,Default - Copy,Clare,0,0,0,,Кешіріңіз, мен ағамды іздеп жүрмін.
Dialogue: 0,0:04:42.95,0:04:45.55,Default - Copy,innkeep,0,0,0,,Әй, ағаңды ізде
Dialogue: 0,0:04:46.25,0:04:48.02,Default - Copy,Clare,0,0,0,,Саяхат кезінде ажырасу
Dialogue: 0,0:04:49.65,0:04:51.49,Default - Copy,innkeep,0,0,0,,Бұл проблема болар еді.
Dialogue: 0,0:04:52.22,0:04:54.76,Default - Copy,innkeep,0,0,0,,Бұл қала үлкен.
Dialogue: 0,0:04:54.76,0:04:56.76,Default - Copy,innkeep,0,0,0,,Оны ертең қайта іздеп көруге болады.
Dialogue: 0,0:04:57.23,0:04:57.73,Default - Copy,Clare,0,0,0,,О
Dialogue: 0,0:05:05.87,0:05:06.50,Default - Copy,Clare,0,0,0,,Раки
Dialogue: 0,0:05:13.28,0:05:13.91,Default - Copy,Clare,0,0,0,,Өтінемін
Dialogue: 0,0:05:15.88,0:05:17.48,Default - Copy,innkeep,0,0,0,,Бұл кешкі ас.
Dialogue: 0,0:05:17.48,0:05:18.35,Default - Copy,Clare,0,0,0,,Рахмет
Dialogue: 0,0:05:21.59,0:05:23.49,Default - Copy,innkeep,0,0,0,,Сіз шынымен сүйкімдісіз, солай емес пе?
Dialogue: 0,0:05:25.49,0:05:26.99,Default - Copy,innkeep,0,0,0,,Ол менің інім.
Dialogue: 0,0:05:27.39,0:05:28.64,Default - Copy,innkeep,0,0,0,,Қазіргі заманда
Dialogue: 0,0:05:28.64,0:05:33.03,Default - Copy,innkeep,0,0,0,,Ата-анаң мен бауырларың жоғалып кеткенде ештеңе істей алмаймын деп ойлау қалыпты жағдай болса да.
Dialogue: 0,0:05:33.70,0:05:36.67,Default - Copy,innkeep,0,0,0,,Қаладан қалаға іздеу қиын
Dialogue: 0,0:05:39.74,0:05:41.31,Default - Copy,Clare,0,0,0,,Маған да біртүрлі.
Dialogue: 0,0:05:42.87,0:05:43.64,Default - Copy,Clare,0,0,0,,Жоқ.
Dialogue: 0,0:05:45.34,0:05:47.38,Default - Copy,innkeep,0,0,0,,Олай болса асықпаңыз.
Dialogue: 0,0:05:49.31,0:05:50.45,Default - Copy,innkeep,0,0,0,,Иә
Dialogue: 0,0:05:50.45,0:05:52.05,Default - Copy,innkeep,0,0,0,,Мен сізге хабарлаймын.
Dialogue: 0,0:05:53.25,0:05:57.06,Default - Copy,innkeep,0,0,0,,Клейморлар тобы қазір осы қалада тұрады.
Dialogue: 0,0:05:58.32,0:06:05.06,Default - Copy,innkeep,0,0,0,,Осы жерден сәл алыс жатқан Закоро тауында өте күшті жын бар дейді.
Dialogue: 0,0:06:05.06,0:06:07.33,Default - Copy,innkeep,0,0,0,,4 адам жиналды.
Dialogue: 0,0:06:07.87,0:06:08.77,Default - Copy,Clare,0,0,0,,Төрт адамға дейін
Dialogue: 0,0:06:09.73,0:06:10.74,Default - Copy,Clare,0,0,0,,Оянған адам?
Dialogue: 0,0:06:11.34,0:06:13.17,Default - Copy,innkeep,0,0,0,,Сондықтан
Dialogue: 0,0:06:13.17,0:06:14.54,Default - Copy,innkeep,0,0,0,,Абайлаңыз, солай ма?
Dialogue: 0,0:06:14.54,0:06:16.11,Default - Copy,Clare,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:06:19.48,0:06:21.85,Default - Copy,Clare,0,0,0,,Мен мұндай жерде бір-бірімізді кездестіреміз деп ойламаппын.
Dialogue: 0,0:06:26.05,0:06:29.02,Default - Copy,Clare,0,0,0,,Жындарды басатын дәрі – жақсы және жаман.
Dialogue: 0,0:06:30.42,0:06:32.12,Default - Copy,Clare,0,0,0,,Басқа адам байқамайды
Dialogue: 0,0:06:32.59,0:06:35.70,Default - Copy,Clare,0,0,0,,Мен білмей достарым тұрған қалаға кірдім.
Dialogue: 0,0:06:37.20,0:06:40.80,Default - Copy,Clare,0,0,0,,Бірақ мен сені енді ұйымға қайтаруға рұқсат ете алмаймын.
Dialogue: 0,0:06:54.41,0:06:55.31,Default - Copy,Clare,0,0,0,,(Қыңқыл) Бірақ қазір менде қорқыныштың бір ұшқыны да жоқ
Dialogue: 0,0:06:55.88,0:07:00.12,Default - Copy,Clare,0,0,0,,Егер сіз Оянғандарды іздеп жатсаңыз, онда бір таңбалы саны бар кем дегенде бір адам болуы керек.
Dialogue: 0,0:07:00.62,0:07:01.39,Default - Copy,Clare,0,0,0,,Қайсысы?
Dialogue: 0,0:07:05.06,0:07:06.46,Default - Copy,warrior,0,0,0,,Джин, не болды?
Dialogue: 0,0:07:07.89,0:07:09.36,Default - Copy,Jeane,0,0,0,,Эй, не болды, Армин? Өзіңді қолыңнан ал, иә? Эй!
Dialogue: 0,0:07:09.96,0:07:11.03,Default - Copy,Jeane,0,0,0,,Мүмкін бұл менің қиялым шығар
Dialogue: 0,0:07:15.77,0:07:16.83,Default - Copy,Clare,0,0,0,,Күмән жоқ
Dialogue: 0,0:07:17.20,0:07:17.97,Default - Copy,Clare,0,0,0,,Бұл ол
Dialogue: 0,0:07:28.18,0:07:29.55,Default - Copy,innkeep,0,0,0,,Қайырлы таң
Dialogue: 0,0:07:29.55,0:07:30.52,Default - Copy,innkeep,0,0,0,,Бұл жылдам.
Dialogue: 0,0:07:30.52,0:07:33.65,Default - Copy,Clare,0,0,0,,Таңертең бірінші кезекте адамдардың жиналуын күтіңіз.
Dialogue: 0,0:07:34.32,0:07:36.49,Default - Copy,Clare,0,0,0,,Менің ағамды біреу көрген шығар.
Dialogue: 0,0:07:37.49,0:07:38.72,Default - Copy,innkeep,0,0,0,,Мен көремін.
Dialogue: 0,0:07:38.72,0:07:41.86,Default - Copy,innkeep,0,0,0,,О, кеше айтқан Клеймор жігіттері.
Dialogue: 0,0:07:41.86,0:07:44.20,Default - Copy,innkeep,0,0,0,,Түн ашылмай тұрып кетіп қалды.
Dialogue: 0,0:07:45.03,0:07:46.70,Default - Copy,innkeep,0,0,0,,Енді сіз сенімді бола аласыз.
Dialogue: 0,0:07:47.17,0:07:49.27,Default - Copy,innkeep,0,0,0,,Біреу жағындамын десең де
Dialogue: 0,0:07:49.27,0:07:51.37,Default - Copy,innkeep,0,0,0,,Өйткені ол жартылай жын.
Dialogue: 0,0:07:58.71,0:08:00.38,Default - Copy,Clare,0,0,0,,Егер сіз оянған адам болсаңыз
Dialogue: 0,0:08:00.38,0:08:02.68,Default - Copy,Clare,0,0,0,,Қанша жылдам болса да, бір күн керек.
Dialogue: 0,0:08:03.28,0:08:05.45,Default - Copy,Clare,0,0,0,,Бетпе-бет кездеспеу пайдалы.
Dialogue: 0,0:08:48.53,0:08:51.43,Default - Copy,man,0,0,0,,Арқасында қылыш көтерген бала
Dialogue: 0,0:08:51.43,0:08:53.13,Default - Copy,man,0,0,0,,Мен білмеймін.
Dialogue: 0,0:08:53.13,0:08:53.77,Default - Copy,Clare,0,0,0,,Сәлем
Dialogue: 0,0:08:55.50,0:08:56.70,Default - Copy,Clare,0,0,0,,Нөлдік ақпарат?
Dialogue: 0,0:08:57.60,0:08:59.94,Default - Copy,Clare,0,0,0,,Раки, сен қайдасың?
Dialogue: 0,0:09:03.88,0:09:05.61,Default - Copy,kid1,0,0,0,,Қараңызшы, ағайын.
Dialogue: 0,0:09:05.61,0:09:07.11,Default - Copy,kid1,0,0,0,,Бұл Тереза ​​мен Клэр.
Dialogue: 0,0:09:07.81,0:09:10.95,Default - Copy,kid1,0,0,0,,Бұл екі адам Тереза ​​мен Клэр.
Dialogue: 0,0:09:12.55,0:09:13.95,Default - Copy,Clare,0,0,0,,Тереза мен Клэр
Dialogue: 0,0:09:24.16,0:09:29.00,Default - Copy,Teresa,0,0,0,,Сұлу, таза, махаббатқа толы егіз құдайлардың есімдері.
Dialogue: 0,0:09:31.00,0:09:34.44,Default - Copy,Teresa,0,0,0,,Солай өсер деген үмітпен бұл есім қойылса керек.
Dialogue: 0,0:09:36.84,0:09:37.58,Default - Copy,kid1,0,0,0,,Эй
Dialogue: 0,0:09:37.58,0:09:38.88,Default - Copy,kid1,0,0,0,,Бұл Клэр
Dialogue: 0,0:09:38.88,0:09:40.35,Default - Copy,kid1,0,0,0,,Бұл Тереза
Dialogue: 0,0:09:40.35,0:09:43.72,Default - Copy,kid2,0,0,0,,Мен мұны саған үйреткен шығармын.
Dialogue: 0,0:09:43.72,0:09:44.85,Default - Copy,kid1,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:09:44.85,0:09:49.95,Default - Copy,kid2,0,0,0,,Сөйтсе де, күні кеше бейтаныс ағаға тәкаппарлап түсіндіріп жаттың.
Dialogue: 0,0:09:49.95,0:09:51.66,Default - Copy,kid1,0,0,0,,Мен бастық емеспін.
Dialogue: 0,0:09:51.66,0:09:55.83,Default - Copy,kid1,0,0,0,,Себебі ол кісі менен Клэр кім екенін сұрады.
Dialogue: 0,0:09:55.83,0:09:57.23,Default - Copy,kid2,0,0,0,,Мен солай ойлаймын.
Dialogue: 0,0:09:57.23,0:09:58.63,Default - Copy,kid1,0,0,0,,Ой…
Dialogue: 0,0:09:58.63,0:09:59.83,Default - Copy,kid2,0,0,0,,Бұл өтірік
Dialogue: 0,0:10:00.03,0:10:01.37,Default - Copy,Clare,0,0,0,,Бір минут күте тұр, қыз.
Dialogue: 0,0:10:02.47,0:10:06.34,Default - Copy,Clare,0,0,0,,Сол аға туралы толығырақ айтып бере аласыз ба?
Dialogue: 0,0:10:07.57,0:10:09.51,Default - Copy,kid1,0,0,0,,Мен танымайтын ағайын.
Dialogue: 0,0:10:09.51,0:10:11.21,Default - Copy,kid2,0,0,0,,Бұл басқа нәрсе шығар.
Dialogue: 0,0:10:11.61,0:10:12.98,Default - Copy,Clare,0,0,0,,Ол қандай адам болды?
Dialogue: 0,0:10:13.41,0:10:14.69,Default - Copy,Clare,0,0,0,,Сен арқаңда қылыш ұстадың ба?
Dialogue: 0,0:10:16.71,0:10:18.86,Default - Copy,kid1,0,0,0,,Артында ұзын бірдеңені көтеріп жүрді.
Dialogue: 0,0:10:19.48,0:10:20.85,Default - Copy,Clare,0,0,0,,Мен сенің атыңды естідім.
Dialogue: 0,0:10:20.85,0:10:25.09,Default - Copy,kid1,0,0,0,,Жоқ, тозығы жеткен, сызатпен жабылған, сондықтан аздап қорқынышты болды.
Dialogue: 0,0:10:25.09,0:10:27.13,Default - Copy,kid2,0,0,0,,Көп сөйлесең де
Dialogue: 0,0:10:27.13,0:10:31.60,Default - Copy,kid1,0,0,0,,Сол үшін ол ағайынды Клэр мүсіні туралы естіді.
Dialogue: 0,0:10:32.06,0:10:35.80,Default - Copy,kid1,0,0,0,,Мен оған Клэр туралы айтқанда, ол шынымен бақытты көрінді.
Dialogue: 0,0:10:35.80,0:10:37.84,Default - Copy,kid1,0,0,0,,Себебі мен қатты тыңдадым.
Dialogue: 0,0:10:37.84,0:10:40.17,Default - Copy,kid1,0,0,0,,Сондықтан мен енді қорықпаймын
Dialogue: 0,0:10:41.47,0:10:42.34,Default - Copy,Clare,0,0,0,,Сонымен
Dialogue: 0,0:10:43.37,0:10:44.98,Default - Copy,Clare,0,0,0,,Сонда ол қайда?
Dialogue: 0,0:10:45.61,0:10:46.94,Default - Copy,kid1,0,0,0,,Көргенім, нато мен үшін емес екен
Dialogue: 0,0:10:46.94,0:10:49.15,Default - Copy,kid2,0,0,0,,Бұл он күн бұрын болды.
Dialogue: 0,0:10:49.15,0:10:50.68,Default - Copy,kid2,0,0,0,,Себебі мен сені енді көрмеймін
Dialogue: 0,0:10:50.68,0:10:52.35,Default - Copy,kid2,0,0,0,,Менің ойымша, ол кетіп қалды.
Dialogue: 0,0:10:52.95,0:10:53.79,Default - Copy,Clare,0,0,0,,Мен көремін.
Dialogue: 0,0:10:54.29,0:10:54.99,Default - Copy,Clare,0,0,0,,Рахмет
Dialogue: 0,0:10:57.36,0:11:00.86,Default - Copy,kid1,0,0,0,,Әй, сен ол ағаны танитын шығарсың?
Dialogue: 0,0:11:01.33,0:11:03.96,Default - Copy,Clare,0,0,0,,О мен үшін
Dialogue: 0,0:11:04.70,0:11:06.53,Default - Copy,Raki,0,0,0,,Мен Клэрге көмектескім келеді
Dialogue: 0,0:11:07.43,0:11:10.07,Default - Copy,Raki,0,0,0,,Мен мұның пайдасы жоқ екенін білемін.
Dialogue: 0,0:11:10.07,0:11:12.80,Default - Copy,Raki,0,0,0,,Бірақ мен әлі де Клэрдің қасында болғым келеді.
Dialogue: 0,0:11:13.30,0:11:14.17,Default - Copy,Raki,0,0,0,,Мен өлсем де бәрібір
Dialogue: 0,0:11:14.67,0:11:17.31,Default - Copy,Raki,0,0,0,,Мен сенімен мәңгі бірге болғым келеді, Клэр.
Dialogue: 0,0:11:18.94,0:11:20.31,Default - Copy,Clare,0,0,0,,Мен үшін
Dialogue: 0,0:11:45.94,0:11:46.84,Default - Copy,Raki,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:11:47.17,0:11:48.75,Default - Copy,Raki,0,0,0,,Қандай жағдайда болмасын аман қалу
Dialogue: 0,0:11:49.17,0:11:51.48,Default - Copy,Raki,0,0,0,,Тірі және тағы бір рет
Dialogue: 0,0:11:52.48,0:11:53.41,Default - Copy,Raki,0,0,0,,Клэрмен
Dialogue: 0,0:12:07.56,0:12:08.99,Default - Copy,man,0,0,0,,Не?
Dialogue: 0,0:12:14.77,0:12:16.00,Default - Copy,man,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:12:26.11,0:12:27.01,Default - Copy,clay,0,0,0,,Мен ондай адамды білмеймін.
Dialogue: 0,0:12:29.11,0:12:30.05,Default - Copy,clay,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:12:33.32,0:12:34.12,Default - Copy,clay,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:12:35.02,0:12:36.19,Default - Copy,clay,0,0,0,,Достар
Dialogue: 0,0:12:45.30,0:12:46.16,Default - Copy,Clare,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:12:46.63,0:12:47.30,Default - Copy,Clare,0,0,0,,Эй
Dialogue: 0,0:12:49.43,0:12:50.67,Default - Copy,clay,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:12:50.67,0:12:53.47,Default - Copy,clay,0,0,0,,Ұйымға хабарласыңыз
Dialogue: 0,0:12:55.24,0:12:56.11,Default - Copy,clay,0,0,0,,Тым күшті
Dialogue: 0,0:12:56.54,0:12:57.31,Default - Copy,clay,0,0,0,,Анна
Dialogue: 0,0:12:57.78,0:12:58.71,Default - Copy,Clare,0,0,0,,Оянған адам?
Dialogue: 0,0:12:59.51,0:13:01.05,Default - Copy,Clare,0,0,0,,Оған оянған адам шабуыл жасады ма?
Dialogue: 0,0:13:01.85,0:13:04.08,Default - Copy,clay,0,0,0,,Сіз доссыз ба?
Dialogue: 0,0:13:06.58,0:13:09.96,Default - Copy,clay,0,0,0,,Барлығына көмектесуіңізді өтінемін.
Dialogue: 0,0:13:10.32,0:13:13.52,Default - Copy,clay,0,0,0,,Барлығы әлі тірі
Dialogue: 0,0:13:14.69,0:13:17.10,Default - Copy,clay,0,0,0,,Оларда бірдеңе дұрыс емес.
Dialogue: 0,0:13:17.83,0:13:19.23,Default - Copy,clay,0,0,0,,Бір нәрсені жоспарлау
Dialogue: 0,0:13:20.40,0:13:22.60,Default - Copy,clay,0,0,0,,Барлығынан сұраңыз
Dialogue: 0,0:13:25.17,0:13:26.30,Default - Copy,Clare,0,0,0,,Эй
Dialogue: 0,0:13:54.90,0:13:56.53,Default - Copy,Clare,0,0,0,,Кешіріңіз, мен өлі денені сұраймын.
Dialogue: 0,0:13:57.54,0:13:58.84,Default - Copy,Clare,0,0,0,,Мүмкін болса, қорықпай
Dialogue: 0,0:13:59.57,0:14:01.51,Default - Copy,Clare,0,0,0,,Мен адам болып жерленгім келеді.
Dialogue: 0,0:14:01.51,0:14:03.64,Default - Copy,man,0,0,0,,Сәлем бауырым
Dialogue: 0,0:14:04.58,0:14:06.24,Default - Copy,man,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:14:06.94,0:14:08.88,Default - Copy,man,0,0,0,,Мен тауға барамын
Dialogue: 0,0:14:37.01,0:14:37.74,Default - Copy,Clare,0,0,0,,Раки
Dialogue: 0,0:14:40.51,0:14:43.15,Default - Copy,Clare,0,0,0,,Ұйым нөмірі 47 Клэр
Dialogue: 0,0:14:44.05,0:14:47.19,Default - Copy,Clare,0,0,0,,Закороға Оянғандарды жеңуге көмектесу.
Dialogue: 0,0:14:55.49,0:14:56.33,Default - Copy,Riful,0,0,0,,Жарайды
Dialogue: 0,0:14:56.33,0:14:59.30,Default - Copy,Riful,0,0,0,,Олай болса тағы бір жолды қосамыз.
Dialogue: 0,0:15:09.47,0:15:11.18,Default - Copy,Duff,0,0,0,,6-кітап
Dialogue: 0,0:15:17.25,0:15:18.75,Default - Copy,Riful,0,0,0,,Ағамның ойы қандай—
Dialogue: 0,0:15:18.75,0:15:21.99,Default - Copy,Riful,0,0,0,,Оянатын уақыт жеткен сияқты.
Dialogue: 0,0:15:46.14,0:15:47.88,Default - Copy,Riful,0,0,0,,Сен қыңырсың.
Dialogue: 0,0:15:47.88,0:15:50.98,Default - Copy,Riful,0,0,0,,Тез оянбасаң, сол баладай боласың.
Dialogue: 0,0:15:50.98,0:15:53.55,Default - Copy,Riful,0,0,0,,Тесіктерге толып өлесің.
Dialogue: 0,0:15:53.55,0:15:54.92,Default - Copy,Riful,0,0,0,,Жақсы ма?
Dialogue: 0,0:15:55.35,0:15:57.09,Default - Copy,Jeane,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:16:09.07,0:16:10.30,Default - Copy,Jeane,0,0,0,,Оларды мына жерге ыстық шоколадпен қойып кетейін, жарай ма?
Dialogue: 0,0:16:10.77,0:16:12.41,Default - Copy,Jeane,0,0,0,,Ұста, Катя.
Dialogue: 0,0:16:12.47,0:16:14.04,Default - Copy,Riful,0,0,0,,Ақырында
Dialogue: 0,0:16:14.04,0:16:15.04,Default - Copy,Riful,0,0,0,,Осындай нәрсе
Dialogue: 0,0:16:15.44,0:16:17.61,Default - Copy,Riful,0,0,0,,Оянсаң жеңіл болады.
Dialogue: 0,0:16:20.61,0:16:22.01,Default - Copy,Jeane,0,0,0,,Содан кейін айналаңдағы 'болашақ оқиғаларды' болжа
Dialogue: 0,0:16:22.01,0:16:23.61,Default - Copy,Jeane,0,0,0,,Құбыжық болғың келе ме?
Dialogue: 0,0:16:25.95,0:16:27.72,Default - Copy,Duff,0,0,0,,Құбыжық кім болса да
Dialogue: 0,0:16:27.72,0:16:29.12,Default - Copy,Duff,0,0,0,,Ақымақ болма
Dialogue: 0,0:16:29.62,0:16:32.69,Default - Copy,Duff,0,0,0,,Бізді мазақ еткендер бірінші өлтіріледі.
Dialogue: 0,0:16:35.56,0:16:36.86,Default - Copy,Riful,0,0,0,,Біраз
Dialogue: 0,0:16:36.86,0:16:38.53,Default - Copy,Riful,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:16:38.96,0:16:41.33,Default - Copy,Riful,0,0,0,,Санды ерікті түрде көбейтпе
Dialogue: 0,0:16:41.33,0:16:42.90,Default - Copy,Duff,0,0,0,,Бірақ бұл жігіт
Dialogue: 0,0:16:51.21,0:16:52.14,Default - Copy,Riful,0,0,0,,Мен мұны істедім
Dialogue: 0,0:16:57.88,0:16:58.98,Default - Copy,Jeane,0,0,0,,Катя
Dialogue: 0,0:17:03.55,0:17:04.96,Default - Copy,Riful,0,0,0,,Дафф дайындаңыз
Dialogue: 0,0:17:30.25,0:17:30.98,Default - Copy,Jeane,0,0,0,,Не?
Dialogue: 0,0:17:31.52,0:17:32.35,Default - Copy,Jeane,0,0,0,,Не
Dialogue: 0,0:17:56.77,0:17:58.38,Default - Copy,Riful,0,0,0,,Қандай дуф
Dialogue: 0,0:18:04.12,0:18:05.58,Default - Copy,Duff,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:18:05.58,0:18:07.29,Default - Copy,Duff,0,0,0,,Мүлдем күшті емес
Dialogue: 0,0:18:11.52,0:18:12.42,Default - Copy,Riful,0,0,0,,Мен көремін.
Dialogue: 0,0:18:12.99,0:18:16.69,Default - Copy,Riful,0,0,0,,Бұл 30-шы жылдардағы оянған адамдарда болуы мүмкін.
Dialogue: 0,0:18:18.13,0:18:19.76,Default - Copy,Riful,0,0,0,,Жақсы, ұсақтаңыз.
Dialogue: 0,0:18:31.55,0:18:35.01,Default - Copy,Jeane,0,0,0,,Тоқта!
Dialogue: 0,0:18:45.06,0:18:46.22,Default - Copy,Jeane,0,0,0,,Катя
Dialogue: 0,0:18:46.79,0:18:51.24,Default - Copy,Riful,0,0,0,,Өйткені, ол бір таңбалы сан болуы керек.
Dialogue: 0,0:18:51.24,0:18:55.73,Default - Copy,Riful,0,0,0,,Тезірек оян, 9 саны Ген.
Dialogue: 0,0:18:56.87,0:18:58.64,Default - Copy,Jeane,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:19:08.65,0:19:10.65,Default - Copy,man,0,0,0,,Эй, сәл күте тұрыңыз.
Dialogue: 0,0:19:11.82,0:19:13.25,Default - Copy,man,0,0,0,,Сіз жалғызсыз ба?
Dialogue: 0,0:19:13.85,0:19:17.09,Default - Copy,man,0,0,0,,Бұдан былай тауға шықпаған дұрыс.
Dialogue: 0,0:19:17.62,0:19:19.82,Default - Copy,man,0,0,0,,Бұл құбыжық туралы.
Dialogue: 0,0:19:19.82,0:19:23.29,Default - Copy,man,0,0,0,,Таудың арғы бетіне өткіңіз келсе, айналма жолмен жүру керек.
Dialogue: 0,0:19:24.13,0:19:28.07,Default - Copy,Clare,0,0,0,,Олар топ болып қозғалғанды ​​ұнатпауы керек.
Dialogue: 0,0:19:36.71,0:19:39.74,Default - Copy,man,0,0,0,,Сіз балшықсыз ба?
Dialogue: 0,0:19:42.41,0:19:43.25,Default - Copy,man,0,0,0,,Бұл қажет болды
Dialogue: 0,0:19:46.18,0:19:49.09,Default - Copy,man,0,0,0,,Егер сіз бір уақытта аяқ пен денеге шабуыл жасасаңыз
Dialogue: 0,0:19:49.09,0:19:51.79,Default - Copy,man,0,0,0,,Балалар сендер биік ұшасыңдар.
Dialogue: 0,0:20:08.07,0:20:10.74,Default - Copy,Clare,0,0,0,,Сіз біздің қимыл-қозғалысымызбен біртүрлі таныс сияқтысыз.
Dialogue: 0,0:20:11.34,0:20:14.65,Default - Copy,Clare,0,0,0,,Балалар сендерге тән емес басқарылатын қозғалыстар.
Dialogue: 0,0:20:15.11,0:20:16.71,Default - Copy,Clare,0,0,0,,Сіз не жоспарлап отырсыз?
Dialogue: 0,0:20:18.18,0:20:21.42,Default - Copy,Yoma,0,0,0,,Білетінің сонша, оны да жек көресің.
Dialogue: 0,0:20:28.29,0:20:29.59,Default - Copy,Duff,0,0,0,,Біреу келді
Dialogue: 0,0:20:29.96,0:20:31.90,Default - Copy,Riful,0,0,0,,Бұл рас.
Dialogue: 0,0:20:31.90,0:20:34.93,Default - Copy,Riful,0,0,0,,Көмек шақыру үшін қашып кеткен бала үшін бұл жылдам.
Dialogue: 0,0:20:35.87,0:20:38.70,Default - Copy,Riful,0,0,0,,Менің айтайын дегенім, бұл өте кішкентай құбыжық.
Dialogue: 0,0:20:43.60,0:20:45.28,Default - Copy,Riful,0,0,0,,Сан аз сияқты
Dialogue: 0,0:20:45.98,0:20:49.18,Default - Copy,Riful,0,0,0,,Оянсам да бұдан көп нәрсе күте алмаймын.
Dialogue: 0,0:21:00.06,0:21:01.59,Default - Copy,Riful,0,0,0,,Мен оны Даффқа беремін.
Dialogue: 0,0:21:02.09,0:21:03.56,Default - Copy,Riful,0,0,0,,Сіз өзіңізге ұнайтын нәрсені жасай аласыз.
Dialogue: 0,0:21:03.93,0:21:05.56,Default - Copy,Duff,0,0,0,,Иә, шынымен.
Dialogue: 0,0:22:40.76,0:22:42.26,Default - Copy,Clare,0,0,0,,Адам болып туылған
Dialogue: 0,0:22:42.26,0:22:43.53,Default - Copy,Clare,0,0,0,,Адам болып өл
Dialogue: 0,0:22:44.50,0:22:45.60,Default - Copy,Clare,0,0,0,,Мен шындықпын
Dialogue: 0,0:22:47.10,0:22:53.10,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory