Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Клэр
Dialogue: 0,0:00:06.00,0:00:08.08,Default,,0,0,0,,Солтүстікте бірнеше оянған адамдар пайда болды
Dialogue: 0,0:00:09.01,0:00:13.06,Default,,0,0,0,,7 және одан төмен сандар бірнеше жауынгердің өмірін қиды.
Dialogue: 0,0:00:14.01,0:00:17.08,Default,,0,0,0,,Сіздің келесі миссияңыз - оянған адамдарды жою.
Dialogue: 0,0:00:18.09,0:00:20.07,Default,,0,0,0,,О, және
Dialogue: 0,0:00:21.05,0:00:24.00,Default,,0,0,0,,Сіз бірге болған бала
Dialogue: 0,0:00:24.00,0:00:26.05,Default,,0,0,0,,Олар солтүстікке қарай бет алған сияқты.
Dialogue: 0,0:00:29.06,0:00:34.03,Default,,0,0,0,,Осы бес адам, соның ішінде мен де, әрқайсысы капитан болады.
Dialogue: 0,0:00:35.00,0:00:37.09,Default,,0,0,0,,Барлығы 24 адам жиналды.
Dialogue: 0,0:00:37.09,0:00:41.02,Default,,0,0,0,,Содан кейін бес команда құрыңыз.
Dialogue: 0,0:00:41.07,0:00:44.02,Default,,0,0,0,,Әр командаға 45 адам
Dialogue: 0,0:00:44.02,0:00:48.03,Default,,0,0,0,,Басқаша айтқанда, ол кәдімгі Оянған аңшылықпен бірдей құрылымға ие.
Dialogue: 0,0:00:49.00,0:00:53.08,Default,,0,0,0,,Бұл стратегияның табысты болу ықтималдығы қандай?
Dialogue: 0,0:00:54.08,0:00:58.03,Default,,0,0,0,,Бұл стратегияда табысқа жету ықтималдығы нөлге тең.
Dialogue: 0,0:01:02.07,0:01:04.04,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:01:04.04,0:01:06.05,Default,,0,0,0,,Пиета қаласының тұрғындары
Dialogue: 0,0:01:06.05,0:01:08.04,Default,,0,0,0,,Мен мұны істеймін.
Dialogue: 0,0:01:08.04,0:01:10.04,Default,,0,0,0,,Бұл өте қызық болып барады.
Dialogue: 0,0:01:10.06,0:01:13.05,Default,,0,0,0,,Өйткені бұл
Dialogue: 0,0:01:13.05,0:01:15.06,Default,,0,0,0,,Сіз құбыжық болуды тоқтата алмайсыз.
Dialogue: 0,0:01:26.07,0:01:28.04,Default,,0,0,0,,Мен келе жатырмын
Dialogue: 0,0:01:31.09,0:01:33.04,Default,,0,0,0,,Балалар сендер артқа тұрыңдар.
Dialogue: 0,0:01:40.00,0:01:42.03,Default,,0,0,0,,Дәл қазір болған оқиғадан жалтармағандар жолға түсті.
Dialogue: 0,0:01:42.03,0:01:43.02,Default,,0,0,0,,Төмен түсіңіз
Dialogue: 0,0:02:44.08,0:02:48.00,Default,,0,0,0,,2 командадағы 10 адамнан 6 адам қалды
Dialogue: 0,0:02:48.00,0:02:49.08,Default,,0,0,0,,Сен жоғалдың ба, Флора?
Dialogue: 0,0:02:49.08,0:02:51.04,Default,,0,0,0,,Жоқ, Ундин мырза.
Dialogue: 0,0:02:51.04,0:02:52.06,Default,,0,0,0,,Осымен жүрейік.
Dialogue: 0,0:03:06.02,0:03:07.04,Default,,0,0,0,,«Біз оның әйелі мен балаларын қауіпсіз жерге жеткіздік»
Dialogue: 0,0:03:07.09,0:03:09.01,Default,,0,0,0,,Күте тұрыңыз, капитан.
Dialogue: 0,0:03:09.01,0:03:10.03,Default,,0,0,0,,Ундин мырза
Dialogue: 0,0:03:10.03,0:03:12.00,Default,,0,0,0,,Жоқ, өзіңнен озып кетпе.
Dialogue: 0,0:03:14.03,0:03:16.06,Default,,0,0,0,,Өйткені қарапайым ақымақ деген осы.
Dialogue: 0,0:03:21.06,0:03:24.06,Default,,0,0,0,,Тамағыңызды өзіңіз кесіңіз
Dialogue: 0,0:03:31.00,0:03:32.01,Default,,0,0,0,,Болдырмау
Dialogue: 0,0:03:36.03,0:03:38.08,Default,,0,0,0,,Эй, сен не істеп жатырсың?
Dialogue: 0,0:03:39.09,0:03:42.09,Default,,0,0,0,,Бір ғана мақсат – бетіңді жаралау болса.
Dialogue: 0,0:03:42.09,0:03:45.07,Default,,0,0,0,,Бұл өте тұзды әдіс, досым.
Dialogue: 0,0:03:45.07,0:03:46.07,Default,,0,0,0,,Кира — бұл жолы тым ыңғайлы болып кетті — мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:03:46.07,0:03:48.07,Default,,0,0,0,,Ұзын қылышты күшпен өзгертті
Dialogue: 0,0:03:49.03,0:03:51.01,Default,,0,0,0,,Өл, бұлыңғыр
Dialogue: 0,0:03:56.07,0:03:59.07,Default,,0,0,0,,Біраз тыныш отыр, бұлшық ет тентек.
Dialogue: 0,0:03:59.07,0:04:02.07,Default,,0,0,0,,Ол сиқырлы күштерді басқара ма?
Dialogue: 0,0:04:14.06,0:04:16.00,Default,,0,0,0,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:04:16.00,0:04:18.04,Default,,0,0,0,,Кім тыныш?
Dialogue: 0,0:04:18.08,0:04:20.03,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,0:04:32.02,0:04:33.06,Default,,0,0,0,,Барлығымен шабуыл жасаңыз
Dialogue: 0,0:04:33.06,0:04:34.02,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:04:35.01,0:04:36.01,Default,,0,0,0,,Қозғалмаңыз
Dialogue: 0,0:04:36.04,0:04:38.00,Default,,0,0,0,,Әлі де оның сиқырында.
Dialogue: 0,0:04:41.06,0:04:43.05,Default,,0,0,0,,Бұл
Dialogue: 0,0:04:43.05,0:04:44.08,Default,,0,0,0,,Ундин мырза
Dialogue: 0,0:04:44.08,0:04:47.00,Default,,0,0,0,,Мұнда келме
Dialogue: 0,0:04:47.03,0:04:48.08,Default,,0,0,0,,Мұндай адам
Dialogue: 0,0:04:48.08,0:04:50.04,Default,,0,0,0,,Мен ғана осындаймын
Dialogue: 0,0:05:10.02,0:05:12.01,Default,,0,0,0,,Жаралылар төмен түссін
Dialogue: 0,0:05:22.08,0:05:24.03,Default,,0,0,0,,Шит Гесу.
Dialogue: 0,0:05:25.06,0:05:29.02,Default,,0,0,0,,Мен қашанға дейін осылай мықты бола аламын?
Dialogue: 0,0:05:31.00,0:05:31.50,Default,,0,0,0,,Ундин мырза
Dialogue: 0,0:05:38.03,0:05:40.01,Default,,0,0,0,,Менің ойымша, бұл келе жатыр.
Dialogue: 0,0:05:40.01,0:05:41.04,Default,,0,0,0,,Сіз кепілдік залал аласыз.
Dialogue: 0,0:05:42.07,0:05:44.01,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:05:44.01,0:05:46.05,Default,,0,0,0,,Сіз өзіңіз қатысуға келдіңіз бе?
Dialogue: 0,0:05:52.02,0:05:53.07,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,0:05:53.07,0:05:55.04,Default,,0,0,0,,Кешіріңіз, мен сізді ұрып жіберемін.
Dialogue: 0,0:05:58.06,0:05:59.06,Default,,0,0,0,,Ундин мырза
Dialogue: 0,0:06:00.04,0:06:02.06,Default,,0,0,0,,Денев мырза, Клэр мырза
Dialogue: 0,0:06:17.06,0:06:18.04,Default,,0,0,0,,8
Dialogue: 0,0:06:19.07,0:06:20.04,Default,,0,0,0,,9
Dialogue: 0,0:06:21.08,0:06:22.05,Default,,0,0,0,,Он
Dialogue: 0,0:06:24.02,0:06:25.06,Default,,0,0,0,,Ген әлі жоқ
Dialogue: 0,0:06:26.04,0:06:27.04,Default,,0,0,0,,Он екі
Dialogue: 0,0:06:28.05,0:06:29.07,Default,,0,0,0,,Он үш
Dialogue: 0,0:06:35.03,0:06:37.04,Default,,0,0,0,,Ау
Dialogue: 0,0:06:37.04,0:06:38.03,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:06:38.07,0:06:41.00,Default,,0,0,0,,Сабыр етіңіз
Dialogue: 0,0:06:42.05,0:06:44.04,Default,,0,0,0,,О... дұрыс.
Dialogue: 0,0:06:44.04,0:06:46.05,Default,,0,0,0,,Сіз тым алданып бара жатырсыз.
Dialogue: 0,0:06:55.04,0:06:56.06,Default,,0,0,0,,Он жеті
Dialogue: 0,0:06:57.07,0:06:59.02,Default,,0,0,0,,Он сегізінші
Dialogue: 0,0:07:04.04,0:07:06.05,Default,,0,0,0,,Енді
Dialogue: 0,0:07:06.05,0:07:09.06,Default,,0,0,0,,Мұны қалай істеуім керек?
Dialogue: 0,0:07:15.08,0:07:18.02,Default,,0,0,0,,Эй, жақсы ма?
Dialogue: 0,0:07:18.07,0:07:21.06,Default,,0,0,0,,Сиқырлы күшті босату жақсы, бірақ
Dialogue: 0,0:07:22.00,0:07:26.06,Default,,0,0,0,,Осылай қалсаң, шегінен асып, оянып кетесің.
Dialogue: 0,0:07:31.08,0:07:34.02,Default,,0,0,0,,Денев мырза, Клэр мырза
Dialogue: 0,0:07:48.00,0:07:50.00,Default,,0,0,0,,Хмф, сіз ояусыз ба?
Dialogue: 0,0:07:53.02,0:07:54.06,Default,,0,0,0,,жиырма
Dialogue: 0,0:07:57.02,0:07:59.02,Default,,0,0,0,,Балалар сендер әлсізсіңдер.
Dialogue: 0,0:07:59.09,0:08:04.01,Default,,0,0,0,,10 адам болды, олар мені мүлде ренжіте алмады.
Dialogue: 0,0:08:07.00,0:08:10.06,Default,,0,0,0,,Жоқ, мен тым күшті шығармын.
Dialogue: 0,0:08:19.04,0:08:21.02,Default,,0,0,0,,Қандай күш-жігер жұмсау!
Dialogue: 0,0:08:26.01,0:08:28.06,Default,,0,0,0,,21
Dialogue: 0,0:08:32.01,0:08:33.08,Default,,0,0,0,,Мүлдем шайнамайды
Dialogue: 0,0:08:38.08,0:08:40.06,Default,,0,0,0,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:08:44.05,0:08:46.01,Default,,0,0,0,,Мүлде жоқ.
Dialogue: 0,0:08:47.07,0:08:48.07,Default,,0,0,0,,Балалар
Dialogue: 0,0:09:06.06,0:09:07.09,Default,,0,0,0,,Вероника
Dialogue: 0,0:09:07.09,0:09:10.02,Default,,0,0,0,,Бұл біздің рөліміз.
Dialogue: 0,0:09:10.08,0:09:13.07,Default,,0,0,0,,Өзіңізді ортаға салып, басқа адамның назарын аударыңыз
Dialogue: 0,0:09:13.07,0:09:15.09,Default,,0,0,0,,Менің денем жарақаттармен жабылған.
Dialogue: 0,0:09:15.09,0:09:18.03,Default,,0,0,0,,О, Синтия
Dialogue: 0,0:09:18.03,0:09:21.03,Default,,0,0,0,,Оған көмектесу мүмкін емес, өйткені екеуміз де қорғаныс типіміз.
Dialogue: 0,0:09:21.06,0:09:23.07,Default,,0,0,0,,Бірақ мен сені аяқтаймын.
Dialogue: 0,0:09:24.05,0:09:26.05,Default,,0,0,0,,Ішімдік азаяды
Dialogue: 0,0:09:27.00,0:09:28.08,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:09:54.08,0:09:57.07,Default,,0,0,0,,Ояусың ба, ақымақ?
Dialogue: 0,0:10:03.08,0:10:05.02,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:10:05.02,0:10:08.00,Default,,0,0,0,,Балалар сендер оянуларың керек еді.
Dialogue: 0,0:10:08.00,0:10:09.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:44.08,0:10:46.01,Default,,0,0,0,,Сол екеуі
Dialogue: 0,0:10:46.01,0:10:47.07,Default,,0,0,0,,Кира — бұл жолы тым ыңғайлы болып кетті — мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:10:47.07,0:10:49.07,Default,,0,0,0,,шектен асып кеткен болуы керек
Dialogue: 0,0:10:50.02,0:10:52.04,Default,,0,0,0,,Сіз қателесесіз бе?
Dialogue: 0,0:10:52.04,0:10:54.00,Default,,0,0,0,,Бұл менің қиялым ғана
Dialogue: 0,0:10:54.00,0:10:57.07,Default,,0,0,0,,Олай болса, мәселені шешейік.
Dialogue: 0,0:11:06.09,0:11:10.00,Default,,0,0,0,,Тоқтау.
Dialogue: 0,0:11:14.00,0:11:15.00,Default,,0,0,0,,Денев
Dialogue: 0,0:11:15.04,0:11:16.06,Default,,0,0,0,,О... дұрыс.
Dialogue: 0,0:11:16.06,0:11:18.01,Default,,0,0,0,,Сіз тым алданып бара жатырсыз.
Dialogue: 0,0:11:20.03,0:11:22.05,Default,,0,0,0,,Мені тоқтатқыңыз келсе
Dialogue: 0,0:11:22.05,0:11:24.04,Default,,0,0,0,,Басты көздеуім керек еді.
Dialogue: 0,0:11:30.02,0:11:31.00,Default,,0,0,0,,қатты
Dialogue: 0,0:11:31.04,0:11:33.01,Default,,0,0,0,,Бір соққыда орындау мүмкін емес пе?
Dialogue: 0,0:11:40.01,0:11:43.06,Default,,0,0,0,,Пышақтың бұдан әрі алға жылжымауы зақымданудан ба?
Dialogue: 0,0:11:44.00,0:11:46.06,Default,,0,0,0,,Әлде оны бастау дәрменсіз бе?
Dialogue: 0,0:11:46.06,0:11:51.06,Default,,0,0,0,,Хмф, мен бұлшық еттерімен мақтанатын адам емеспін.
Dialogue: 0,0:11:51.06,0:11:53.01,Default,,0,0,0,,Мен техникалық маманмын.
Dialogue: 0,0:11:57.03,0:11:59.08,Default,,0,0,0,,Пайдасыз
Dialogue: 0,0:12:10.03,0:12:11.06,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:12:12.08,0:12:15.04,Default,,0,0,0,,...
Dialogue: 0,0:12:16.03,0:12:18.01,Default,,0,0,0,,Бұл жаман. Құтылып кету.
Dialogue: 0,0:12:18.01,0:12:20.04,Default,,0,0,0,,Ол әлі де сиқырлы қуатты манипуляцияны қолдана алады.
Dialogue: 0,0:12:26.09,0:12:31.07,Default,,0,0,0,,Кем дегенде екі кішкентай шабақ жер асты әлемінен кәдесыйлармен саяхаттап жүр.
Dialogue: 0,0:12:41.06,0:12:44.07,Default,,0,0,0,,Бір-бірінің бастарын кесу
Dialogue: 0,0:13:12.06,0:13:14.01,Default,,0,0,0,,Екеуің жақсысыңдар ма?
Dialogue: 0,0:13:14.07,0:13:17.08,Default,,0,0,0,,Уайымдама, бұл қауіпті жер еді.
Dialogue: 0,0:13:20.06,0:13:23.06,Default,,0,0,0,,Сондықтан кішкентай шабақтар қиындыққа ұшырайды.
Dialogue: 0,0:13:23.06,0:13:24.05,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:13:28.03,0:13:30.05,Default,,0,0,0,,Ой, мұның да бітті ме?
Dialogue: 0,0:13:31.08,0:13:34.02,Default,,0,0,0,,Біз тезірек аяқтадық.
Dialogue: 0,0:13:34.02,0:13:35.08,Default,,0,0,0,,Мен сені маған көмектесемін деп ойладым.
Dialogue: 0,0:13:36.02,0:13:38.04,Default,,0,0,0,,Бұл қажет емес сияқты.
Dialogue: 0,0:13:38.08,0:13:42.04,Default,,0,0,0,,Екеуміз де аман қалмаған сияқтымыз.
Dialogue: 0,0:13:50.00,0:13:51.00,Default,,0,0,0,,Милия
Dialogue: 0,0:13:51.04,0:13:55.01,Default,,0,0,0,,Соңында Мирия бір ғана командамен күреседі.
Dialogue: 0,0:13:55.08,0:13:57.09,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:13:58.06,0:14:01.01,Default,,0,0,0,,Кімге алаңдайсыз?
Dialogue: 0,0:14:08.01,0:14:10.08,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,0:14:12.00,0:14:13.05,Default,,0,0,0,,Толық шегіну.
Dialogue: 0,0:14:17.03,0:14:19.07,Default,,0,0,0,,Керемет
Dialogue: 0,0:14:19.07,0:14:22.00,Default,,0,0,0,,Милия-ни-сан, сен амансың ба?
Dialogue: 0,0:14:24.02,0:14:28.03,Default,,0,0,0,,Сіз әртүрлі тәжірибелер арқылы күшейіп кеткен сияқтысыз.
Dialogue: 0,0:14:28.03,0:14:30.08,Default,,0,0,0,,Милия одан әрі қарай жүреді
Dialogue: 0,0:14:32.00,0:14:34.02,Default,,0,0,0,,Милияның жағдайы
Dialogue: 0,0:14:34.06,0:14:38.01,Default,,0,0,0,,Бұл біз ойлағаннан әлдеқайда ауыр.
Dialogue: 0,0:14:44.05,0:14:46.03,Default,,0,0,0,,Сіз екеуін де орындаған сияқтысыз.
Dialogue: 0,0:14:46.08,0:14:48.07,Default,,0,0,0,,Әзірше қауіпсіз болғаныңызға қуаныштымын.
Dialogue: 0,0:14:49.03,0:14:52.00,Default,,0,0,0,,Бұл сол қолынан айырылған Юма.
Dialogue: 0,0:14:52.06,0:14:55.04,Default,,0,0,0,,Бұл қорғаныс түрі болғандықтан, оны қайта қалпына келтіруге болады.
Dialogue: 0,0:14:55.04,0:14:57.03,Default,,0,0,0,,Мен біраз уақытқа дейін күресе алмаймын.
Dialogue: 0,0:14:58.00,0:15:02.02,Default,,0,0,0,,Әр командада төбелесе алмайтын біреу болса, бізге хабарлаңыз.
Dialogue: 0,0:15:03.00,0:15:06.04,Default,,0,0,0,,Тиісінше қайта ұйымдастыруды қарастырыңыз.
Dialogue: 0,0:15:06.04,0:15:07.09,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:15:09.03,0:15:13.06,Default,,0,0,0,,Сізге біз тек пешкалармыз.
Dialogue: 0,0:15:14.02,0:15:18.00,Default,,0,0,0,,Бұл ұйым бастапқыда ақылға қонымсыз болған жоқ па?
Dialogue: 0,0:15:19.00,0:15:22.02,Default,,0,0,0,,Бұрын оянған адаммен соғыспаған адам.
Dialogue: 0,0:15:22.02,0:15:24.07,Default,,0,0,0,,Кенет сол сақинада тұру
Dialogue: 0,0:15:25.03,0:15:29.01,Default,,0,0,0,,Күткендей ол қозғала алмай, аяғы байланған.
Dialogue: 0,0:15:29.09,0:15:32.02,Default,,0,0,0,,Ақырында көп қан бекер төгілді.
Dialogue: 0,0:15:32.07,0:15:37.05,Default,,0,0,0,,Оны пайдалана алмағандарға әу бастан қолдау көрсетілсе жақсы емес пе еді?
Dialogue: 0,0:15:38.07,0:15:43.03,Default,,0,0,0,,Жауабыңызға қарай, мен сізге еретін ойым жоқ.
Dialogue: 0,0:15:49.01,0:15:52.04,Default,,0,0,0,,Қайтыс болғандардың санын кім біледі?
Dialogue: 0,0:15:53.04,0:15:56.02,Default,,0,0,0,,Кейбір адамдар жарақат алды, бірақ ешкім өлген жоқ.
Dialogue: 0,0:15:56.02,0:15:58.00,Default,,0,0,0,,Барлығы аман қалады
Dialogue: 0,0:15:58.06,0:16:04.08,Default,,0,0,0,,Басқаша айтқанда, әркім Оянған адамдарға қарсы күресте біраз тәжірибе алды.
Dialogue: 0,0:16:09.03,0:16:15.00,Default,,0,0,0,,Мирия-санның шын ниеті - барлығына Оянғандармен күресуде тәжірибе жинақтау.
Dialogue: 0,0:16:15.04,0:16:17.05,Default,,0,0,0,,Басқаша айтқанда, әскери күштің деңгейін көтеру
Dialogue: 0,0:16:18.03,0:16:19.05,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:16:23.09,0:16:27.08,Default,,0,0,0,,Қалай болғанда да, бұл көптеген адамдар өлуі мүмкін шайқас болды.
Dialogue: 0,0:16:28.01,0:16:31.00,Default,,0,0,0,,Бұл оның күшті әдіс болғанын өзгертпейді.
Dialogue: 0,0:16:37.05,0:16:39.07,Default,,0,0,0,,Барлығына қиын болды.
Dialogue: 0,0:16:40.01,0:16:44.02,Default,,0,0,0,,Келесі шайқасқа дайындалу үшін біраз демалыңыз.
Dialogue: 0,0:16:52.02,0:16:53.02,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:16:53.08,0:16:55.07,Default,,0,0,0,,Сіз байқаған боларсыз.
Dialogue: 0,0:16:56.03,0:17:00.01,Default,,0,0,0,,Қазіргі күшпен біз жойыламыз.
Dialogue: 0,0:17:00.08,0:17:03.08,Default,,0,0,0,,Біз үшін құтылудың жолы жоқ.
Dialogue: 0,0:17:04.02,0:17:06.04,Default,,0,0,0,,Қанша талпынсаң да, бұл арғы лагерь.
Dialogue: 0,0:17:06.08,0:17:09.03,Default,,0,0,0,,Күшті болыңыз
Dialogue: 0,0:17:09.03,0:17:12.02,Default,,0,0,0,,Бар күшіңізбен аман қалуға жол ашыңыз
Dialogue: 0,0:17:12.07,0:17:16.09,Default,,0,0,0,,Бұл бізде аз мүмкіндік.
Dialogue: 0,0:17:18.04,0:17:20.02,Default,,0,0,0,,Мүмкіндік?
Dialogue: 0,0:17:36.07,0:17:37.06,Default,,0,0,0,,Раки
Dialogue: 0,0:17:38.06,0:17:39.05,Default,,0,0,0,,Ол тесілді ме?
Dialogue: 0,0:18:05.01,0:18:06.02,Default,,0,0,0,,Жақсы
Dialogue: 0,0:18:07.02,0:18:08.06,Default,,0,0,0,,Клэр емес
Dialogue: 0,0:18:18.06,0:18:20.03,Default,,0,0,0,,Қалада ешкім жоқ
Dialogue: 0,0:18:21.08,0:18:24.04,Default,,0,0,0,,Олардың барлығы өлтірілді ме?
Dialogue: 0,0:18:25.09,0:18:27.00,Default,,0,0,0,,Құбыжық
Dialogue: 0,0:19:07.08,0:19:09.00,Default,,0,0,0,,Жарайды
Dialogue: 0,0:19:09.00,0:19:10.01,Default,,0,0,0,,Жарақаттар жоқ
Dialogue: 0,0:19:23.04,0:19:25.05,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:19:32.03,0:19:33.09,Default,,0,0,0,,Кішкене ғана
Dialogue: 0,0:19:33.08,0:19:35.03,Default,,0,0,0,,Аз ғана
Dialogue: 0,0:19:36.03,0:19:37.03,Default,,0,0,0,,Эй
Dialogue: 0,0:19:40.02,0:19:42.01,Default,,0,0,0,,Сіз сонда болдыңыз ба?
Dialogue: 0,0:19:42.08,0:19:43.07,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:45.09,0:19:48.06,Default,,0,0,0,,Бұл баланың иісі жақсы
Dialogue: 0,0:19:49.00,0:19:53.04,Default,,0,0,0,,Ей, сізді қызықтыру әдеттен тыс.
Dialogue: 0,0:19:54.07,0:19:57.03,Default,,0,0,0,,Сіз осы жақтансыз ба?
Dialogue: 0,0:19:57.03,0:20:01.01,Default,,0,0,0,,Мен әрқашан оңтүстікте тұрдым
Dialogue: 0,0:20:01.05,0:20:04.01,Default,,0,0,0,,Мұнда біреуді іздеп келді
Dialogue: 0,0:20:04.01,0:20:07.09,Default,,0,0,0,,Мына жерде сондай біреуді көрген деген қауесет естідім.
Dialogue: 0,0:20:08.07,0:20:10.02,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:10.02,0:20:11.08,Default,,0,0,0,,Сен оңтүстіктен келдің бе?
Dialogue: 0,0:20:12.03,0:20:15.08,Default,,0,0,0,,Мүмкін сен оңтүстіктің жылы иісін сезген шығарсың.
Dialogue: 0,0:20:16.07,0:20:20.01,Default,,0,0,0,,Мен сені оңтүстікке тез апарғым келеді.
Dialogue: 0,0:20:20.09,0:20:25.06,Default,,0,0,0,,Мм, бұл қалаға да құбыжықтар шабуыл жасаған шығар?
Dialogue: 0,0:20:27.02,0:20:28.09,Default,,0,0,0,,Сіз сенімді бола аласыз.
Dialogue: 0,0:20:29.03,0:20:31.08,Default,,0,0,0,,Ол енді бұл жерде жоқ сияқты.
Dialogue: 0,0:20:36.05,0:20:38.07,Default,,0,0,0,,Сыртта күн суық.
Dialogue: 0,0:20:39.02,0:20:40.04,Default,,0,0,0,,Жақында қайтайық
Dialogue: 0,0:20:41.00,0:20:42.01,Default,,0,0,0,,Сіз де келесіз деп үміттенемін.
Dialogue: 0,0:20:42.01,0:20:42.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:43.04,0:20:46.09,Default,,0,0,0,,Баланың адамдарға мұнша үйір болуы жиі емес.
Dialogue: 0,0:20:47.04,0:20:49.07,Default,,0,0,0,,Маған біраз уақыт серіктес болайын.
Dialogue: 0,0:20:51.09,0:20:53.06,Default,,0,0,0,,А, жақсы
Dialogue: 0,0:20:59.05,0:21:01.00,Default,,0,0,0,,Келесі кезекте біз
Dialogue: 0,0:21:02.02,0:21:03.05,Default,,0,0,0,,Прискила
Dialogue: 0,0:22:40.04,0:22:42.03,Default,,0,0,0,,Батпайтын күн
Dialogue: 0,0:22:42.03,0:22:43.08,Default,,0,0,0,,Батып бара жатқан үміт
Dialogue: 0,0:22:43.09,0:22:46.05,Default,,0,0,0,,Алыстағы таң
Dialogue: 0,0:22:47.55,0:22:52.55,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
