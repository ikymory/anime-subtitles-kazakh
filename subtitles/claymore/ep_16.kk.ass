Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.51,0:00:14.95,Default - Copy,Clare,0,0,0,,Бұл оғаш рух деген не?
Dialogue: 0,0:00:19.32,0:00:23.26,Default - Copy,Clare,0,0,0,,Мен қамал ішінен сансыз бұрмаланған рухтарды сезінемін.
Dialogue: 0,0:00:38.54,0:00:39.94,Default - Copy,Clare,0,0,0,,Пульсациялау
Dialogue: 0,0:00:40.88,0:00:42.64,Default - Copy,Clare,0,0,0,,Бұл жынның шынайы табиғаты ма?
Dialogue: 0,0:00:48.78,0:00:50.52,Default - Copy,Clare,0,0,0,,Менің айналамда жындар көп
Dialogue: 0,0:00:50.52,0:00:52.29,Default - Copy,Clare,0,0,0,,Жынның жақындағанын да байқамайсың ба?
Dialogue: 0,0:00:54.56,0:00:55.92,Default - Copy,Clare,0,0,0,,Бұл қиын трюк.
Dialogue: 0,0:01:35.27,0:01:36.54,Default - Copy,Duff,0,0,0,,Қаш
Dialogue: 0,0:01:36.54,0:01:38.24,Default - Copy,Duff,0,0,0,,Қашпа
Dialogue: 0,0:02:47.89,0:02:48.53,Default - Copy,Clare,0,0,0,,Бұл не?
Dialogue: 0,0:02:50.83,0:02:53.27,Default - Copy,Clare,0,0,0,,Бұл үлкен жын
Dialogue: 0,0:02:59.47,0:03:00.67,Default - Copy,Duff,0,0,0,,Наре
Dialogue: 0,0:03:00.67,0:03:02.87,Default - Copy,Duff,0,0,0,,Не болды? Мүмкін емес.
Dialogue: 0,0:03:02.87,0:03:05.31,Default - Copy,Duff,0,0,0,,Бұл еркек емес шығар.
Dialogue: 0,0:03:05.54,0:03:09.55,Default - Copy,Duff,0,0,0,,Ер болсаң, құнсыз, қызықсыз.
Dialogue: 0,0:03:10.45,0:03:11.72,Default - Copy,Duff,0,0,0,,Маа, жоқ.
Dialogue: 0,0:03:11.72,0:03:13.66,Default - Copy,Duff,0,0,0,,Тек қабығын алып тастасаңыз, түсінесіз.
Dialogue: 0,0:03:14.76,0:03:15.89,Default - Copy,Duff,0,0,0,,Бұл
Dialogue: 0,0:03:15.89,0:03:19.69,Default - Copy,Duff,0,0,0,,Ол жол тар, мен қозғала алмаймын.
Dialogue: 0,0:03:22.50,0:03:24.50,Default - Copy,Duff,0,0,0,,...
Dialogue: 0,0:03:24.63,0:03:27.00,Default - Copy,Duff,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:03:27.00,0:03:29.24,Default - Copy,Duff,0,0,0,,Сіз осындасыз.
Dialogue: 0,0:03:34.58,0:03:37.28,Default - Copy,Duff,0,0,0,,Себебі мен қозғала алмаймын
Dialogue: 0,0:03:39.68,0:03:41.85,Default - Copy,Duff,0,0,0,,Жарайды.
Dialogue: 0,0:03:49.09,0:03:52.16,Default - Copy,Duff,0,0,0,,Қылыш семсерін тастаса, не істер еді?
Dialogue: 0,0:03:52.16,0:03:52.69,Default - Copy,Duff,0,0,0,,Бұл
Dialogue: 0,0:03:55.66,0:03:57.50,Default - Copy,Duff,0,0,0,,Бұл қақпан, Барса.
Dialogue: 0,0:03:57.83,0:03:58.77,Default - Copy,Clare,0,0,0,,Бұл да
Dialogue: 0,0:04:04.68,0:04:06.61,Default - Copy,Riful,0,0,0,,Мен мұны көп жасаймын.
Dialogue: 0,0:04:06.61,0:04:08.44,Default - Copy,Riful,0,0,0,,Даффқа ештеңе берме
Dialogue: 0,0:04:08.44,0:04:11.18,Default - Copy,Riful,0,0,0,,Мені өзіңізбен бірге алып келгеніңізді қалаймын.
Dialogue: 0,0:04:11.72,0:04:12.58,Default - Copy,Jeane,0,0,0,,Сіздің
Dialogue: 0,0:04:13.69,0:04:15.82,Default - Copy,Jeane,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:04:15.82,0:04:17.02,Default - Copy,Riful,0,0,0,,Құпия
Dialogue: 0,0:04:17.52,0:04:20.72,Default - Copy,Riful,0,0,0,,Оянып, дос болған кезде айтамын.
Dialogue: 0,0:04:20.72,0:04:22.06,Default - Copy,Jeane,0,0,0,,Ой, осы белдікті киіп тұрғанда мұны істей алмаймын.
Dialogue: 0,0:04:22.59,0:04:25.36,Default - Copy,Jeane,0,0,0,,Құбыжық деген кім?
Dialogue: 0,0:04:27.47,0:04:29.07,Default - Copy,Jeane,0,0,0,,Не болды?
Dialogue: 0,0:04:29.40,0:04:32.80,Default - Copy,Riful,0,0,0,,Өйткені қарапайым адамның көзқарасымен қарасаңыз,
Dialogue: 0,0:04:32.80,0:04:33.81,Default - Copy,Riful,0,0,0,,Құбыжық емес
Dialogue: 0,0:04:35.27,0:04:37.74,Default - Copy,Riful,0,0,0,,Оянған адамдар және жартылай адам және жартылай жындар
Dialogue: 0,0:04:37.74,0:04:40.14,Default - Copy,Riful,0,0,0,,Шындығында, мұның көп айырмашылығы жоқ.
Dialogue: 0,0:04:40.14,0:04:43.38,Default - Copy,Riful,0,0,0,,Бұл жай ғана сіздің санаңыздың қайда екендігі туралы мәселе.
Dialogue: 0,0:04:44.08,0:04:46.55,Default - Copy,Riful,0,0,0,,Бірақ екеуі де адам емес.
Dialogue: 0,0:04:46.85,0:04:48.35,Default - Copy,Riful,0,0,0,,Бұл шындық
Dialogue: 0,0:04:53.09,0:04:55.06,Default - Copy,Jeane,0,0,0,,Дұрыс айтасыз.
Dialogue: 0,0:04:55.59,0:04:58.19,Default - Copy,Jeane,0,0,0,,Мүмкін мен де сол құбыжық шығармын.
Dialogue: 0,0:04:58.79,0:05:02.00,Default - Copy,Jeane,0,0,0,,Бірақ мен адам болып туылғаннан бері,
Dialogue: 0,0:05:02.40,0:05:03.87,Default - Copy,Jeane,0,0,0,,Адам болып өмір сүру
Dialogue: 0,0:05:03.87,0:05:05.40,Default - Copy,Jeane,0,0,0,,Мен адам болып өлгім келеді
Dialogue: 0,0:05:06.03,0:05:08.24,Default - Copy,Jeane,0,0,0,,Бұл менің шындығым
Dialogue: 0,0:05:09.01,0:05:12.21,Default - Copy,Riful,0,0,0,,Маған сен сияқты адамдар ұнайды.
Dialogue: 0,0:05:12.51,0:05:16.61,Default - Copy,Riful,0,0,0,,Өйткені, мен сенімен дос болғым келді.
Dialogue: 0,0:05:20.55,0:05:21.85,Default - Copy,Duff,0,0,0,,te te te
Dialogue: 0,0:05:21.85,0:05:26.39,Default - Copy,Duff,0,0,0,,Жаңа ғана қолданғаным өте тиімді болды.
Dialogue: 0,0:05:26.82,0:05:27.59,Default - Copy,Clare,0,0,0,,Ақымақ
Dialogue: 0,0:05:28.36,0:05:30.93,Default - Copy,Clare,0,0,0,,Жылдам семсердің тиюі
Dialogue: 0,0:05:30.93,0:05:32.53,Default - Copy,Duff,0,0,0,,Мен сені кешірмеймін
Dialogue: 0,0:05:38.43,0:05:39.94,Default - Copy,Duff,0,0,0,,Жапон көздері
Dialogue: 0,0:05:46.54,0:05:47.61,Default - Copy,Clare,0,0,0,,Сүйектер
Dialogue: 0,0:05:49.85,0:05:51.95,Default - Copy,Duff,0,0,0,,Кесілген нәрсені жабыстырудан гөрі
Dialogue: 0,0:05:51.95,0:05:55.95,Default - Copy,Duff,0,0,0,,Мазмұны жарылған болса, оны емдеу қиынырақ болар еді.
Dialogue: 0,0:06:00.46,0:06:03.70,Default - Copy,Duff,0,0,0,,Олай болса, қабығын аршып алайық.
Dialogue: 0,0:06:03.89,0:06:07.30,Default - Copy,Duff,0,0,0,,Бұл еркек пе? Әйел бе?
Dialogue: 0,0:06:08.03,0:06:09.63,Default - Copy,Galatea,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:06:11.20,0:06:15.24,Default - Copy,Galatea,0,0,0,,Мен бақытты болдым, өйткені мен оны тез таптым.
Dialogue: 0,0:06:16.57,0:06:21.61,Default - Copy,Galatea,0,0,0,,Бұл жағдайда не істеуім керек?
Dialogue: 0,0:06:23.28,0:06:27.62,Default - Copy,Galatea,0,0,0,,Осылай келген соң құр қол кете алмаймын.
Dialogue: 0,0:06:27.62,0:06:29.35,Default - Copy,Duff,0,0,0,,Бұл не?
Dialogue: 0,0:06:29.35,0:06:32.22,Default - Copy,Duff,0,0,0,,Қылышымды да суырмасам, өлемін.
Dialogue: 0,0:06:35.49,0:06:36.36,Default - Copy,Clare,0,0,0,,Бұл белгі
Dialogue: 0,0:06:37.06,0:06:39.36,Default - Copy,Clare,0,0,0,,№3 Калатея
Dialogue: 0,0:06:40.13,0:06:41.16,Default - Copy,Clare,0,0,0,,Неге мұнда?
Dialogue: 0,0:06:41.67,0:06:43.37,Default - Copy,Clare,0,0,0,,Менің артымнан келдің бе?
Dialogue: 0,0:06:44.77,0:06:45.60,Default - Copy,Riful,0,0,0,,О.
Dialogue: 0,0:06:46.47,0:06:50.11,Default - Copy,Riful,0,0,0,,Бұл жолы өте күшті адам келді.
Dialogue: 0,0:06:51.58,0:06:53.58,Default - Copy,Duff,0,0,0,,Өйткені ойнайтын адамдар көп
Dialogue: 0,0:06:53.58,0:06:55.81,Default - Copy,Duff,0,0,0,,Менің ойымша, мен бұл жігітті қазірдің өзінде талқандауым керек.
Dialogue: 0,0:07:02.95,0:07:03.69,Default - Copy,Duff,0,0,0,,Бұл
Dialogue: 0,0:07:07.23,0:07:09.19,Default - Copy,Galatea,0,0,0,,Ол көрінгеннен жеңіл
Dialogue: 0,0:07:09.19,0:07:10.76,Default - Copy,Galatea,0,0,0,,Тамақты көбірек жеңіз
Dialogue: 0,0:07:12.16,0:07:14.50,Default - Copy,Galatea,0,0,0,,Бұл маған керек.
Dialogue: 0,0:07:14.83,0:07:17.10,Default - Copy,Galatea,0,0,0,,Кешіріңіз, кешіріңіз.
Dialogue: 0,0:07:18.17,0:07:19.33,Default - Copy,Clare,0,0,0,,Жеңіл қабылдамаңыз
Dialogue: 0,0:07:19.33,0:07:20.04,Default - Copy,Clare,0,0,0,,Жігіт
Dialogue: 0,0:07:25.71,0:07:27.65,Default - Copy,Duff,0,0,0,,Бұл алғашқы «Глория».
Dialogue: 0,0:07:27.65,0:07:30.01,Default - Copy,Duff,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:07:30.75,0:07:32.85,Default - Copy,Duff,0,0,0,,Кешіріңіз.
Dialogue: 0,0:07:35.42,0:07:36.45,Default - Copy,Duff,0,0,0,,Не?
Dialogue: 0,0:07:36.45,0:07:38.24,Default - Copy,Duff,0,0,0,,Неліктен жұмыс істемеді?
Dialogue: 0,0:07:40.59,0:07:43.12,Default - Copy,Clare,0,0,0,,Шабуылдар автоматты түрде ауытқиды
Dialogue: 0,0:07:43.12,0:07:44.59,Default - Copy,Clare,0,0,0,,Соған қарамастан, бұл түтін неге осынша көп?
Dialogue: 0,0:07:50.34,0:07:51.67,Default - Copy,Galatea,0,0,0,,Ой
Dialogue: 0,0:07:51.73,0:07:54.94,Default - Copy,Galatea,0,0,0,,Қолдауға болатын басы бар сияқты.
Dialogue: 0,0:07:55.37,0:07:56.51,Default - Copy,Duff,0,0,0,,Сәлем
Dialogue: 0,0:07:56.51,0:07:58.17,Default - Copy,Duff,0,0,0,,Мені мазақ ет
Dialogue: 0,0:07:58.17,0:08:00.08,Default - Copy,Duff,0,0,0,,Ол енді тегін емес.
Dialogue: 0,0:08:00.51,0:08:02.08,Default - Copy,Duff,0,0,0,,Э? Қайда?
Dialogue: 0,0:08:02.08,0:08:03.41,Default - Copy,Duff,0,0,0,,Жалаңаш
Dialogue: 0,0:08:03.41,0:08:04.88,Default - Copy,Duff,0,0,0,,Аяқ-қолды тартыңыз
Dialogue: 0,0:08:04.88,0:08:07.02,Default - Copy,Duff,0,0,0,,Ішін жұлып алған соң мазақ ету
Dialogue: 0,0:08:07.02,0:08:08.42,Default - Copy,Duff,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,0:08:09.15,0:08:12.22,Default - Copy,Galatea,0,0,0,,Мұнда аяғыңызды емдеуге болады.
Dialogue: 0,0:08:13.96,0:08:19.93,Default - Copy,Galatea,0,0,0,,Бірақ мен сенен де көп бейбақтармен күресуді жоспарладым.
Dialogue: 0,0:08:21.13,0:08:22.53,Default - Copy,Clare,0,0,0,,Абайлаңыз
Dialogue: 0,0:08:22.53,0:08:24.90,Default - Copy,Clare,0,0,0,,Оның қаттылығы соншалық, оған қылыш тимейді.
Dialogue: 0,0:08:24.90,0:08:26.07,Default - Copy,Galatea,0,0,0,,Жоқ
Dialogue: 0,0:08:26.07,0:08:27.37,Default - Copy,Galatea,0,0,0,,Бұл емес
Dialogue: 0,0:08:28.67,0:08:31.17,Default - Copy,Galatea,0,0,0,,Төмендегі екіншісі туралы.
Dialogue: 0,0:08:31.84,0:08:34.55,Default - Copy,Galatea,0,0,0,,Өлемін деп ойладың ба?
Dialogue: 0,0:08:36.18,0:08:39.51,Default - Copy,Galatea,0,0,0,,Ол өзінің жындарын сұмдық және шебер жасырады, бірақ
Dialogue: 0,0:08:39.82,0:08:41.48,Default - Copy,Galatea,0,0,0,,Толқын ұзындықтарын сәйкестендірсек
Dialogue: 0,0:08:41.48,0:08:43.79,Default - Copy,Galatea,0,0,0,,Сіз оны да таба білуіңіз керек.
Dialogue: 0,0:08:45.49,0:08:47.69,Default - Copy,Duff,0,0,0,,Егер шабуыл соқпаса
Dialogue: 0,0:08:47.69,0:08:49.79,Default - Copy,Duff,0,0,0,,Тек соғылғанына көз жеткізіңіз.
Dialogue: 0,0:08:50.13,0:08:54.30,Default - Copy,Galatea,0,0,0,,Ішіңді жұлып, мені мазақ етпедің бе?
Dialogue: 0,0:08:54.30,0:08:56.70,Default - Copy,Duff,0,0,0,,А, сіз нені айтып тұрсыз?
Dialogue: 0,0:08:58.50,0:08:59.44,Default - Copy,Clare,0,0,0,,Галатея
Dialogue: 0,0:08:59.44,0:09:03.34,Default - Copy,Duff,0,0,0,,Уақытың болған соң, ақымақ.
Dialogue: 0,0:09:06.31,0:09:07.08,Default - Copy,Duff,0,0,0,,Бұл
Dialogue: 0,0:09:08.81,0:09:12.65,Default - Copy,Galatea,0,0,0,,Мен сіздің миыңызды белсенді зат алмасуына қызғанамын.
Dialogue: 0,0:09:20.23,0:09:21.62,Default - Copy,Galatea,0,0,0,,Мен көремін.
Dialogue: 0,0:09:21.62,0:09:25.43,Default - Copy,Galatea,0,0,0,,Қалыпты шабуылмен тіпті сыртқы теріге де өте алмайсыз ба?
Dialogue: 0,0:09:26.73,0:09:27.63,Default - Copy,Duff,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:09:35.24,0:09:39.57,Default - Copy,Galatea,0,0,0,,Сырт тері қатты делінсе де, орнына байланысты айырмашылықтары бар сияқты.
Dialogue: 0,0:09:44.35,0:09:45.71,Default - Copy,Duff,0,0,0,,Сәлем
Dialogue: 0,0:09:49.72,0:09:50.82,Default - Copy,Duff,0,0,0,,Неліктен?
Dialogue: 0,0:09:51.32,0:09:55.79,Default - Copy,Galatea,0,0,0,,Аяқ-қолыммен бірінші болып күрескен сияқтымын.
Dialogue: 0,0:09:59.93,0:10:02.40,Default - Copy,Clare,0,0,0,,Бұл 3 санының дәрежесі
Dialogue: 0,0:10:03.10,0:10:06.84,Default - Copy,Clare,0,0,0,,Бұл басқа адам өз еркіне сай әрекет ету сияқты.
Dialogue: 0,0:10:09.34,0:10:13.14,Default - Copy,Duff,0,0,0,,Сен, сен, сен, сен.
Dialogue: 0,0:10:13.14,0:10:15.21,Default - Copy,Galatea,0,0,0,,Жылама, шіркін
Dialogue: 0,0:10:15.21,0:10:17.75,Default - Copy,Galatea,0,0,0,,Сенің шіркін түрленеді.
Dialogue: 0,0:10:18.81,0:10:20.22,Default - Copy,Riful,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:10:21.42,0:10:23.96,Default - Copy,Riful,0,0,0,,Ол жігіт шынымен ақымақ екен.
Dialogue: 0,0:10:25.15,0:10:28.12,Default - Copy,Galatea,0,0,0,,Сіз ерте шықтыңыз.
Dialogue: 0,0:10:33.56,0:10:35.13,Default - Copy,Riful,0,0,0,,Кішкене дуф
Dialogue: 0,0:10:35.13,0:10:37.00,Default - Copy,Riful,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:10:37.00,0:10:39.17,Default - Copy,Riful,0,0,0,,Сондықтан қанша уақыт өтсе де
Dialogue: 0,0:10:39.17,0:10:42.27,Default - Copy,Riful,0,0,0,,Сен де менің адамым деп мақтана алмайсың.
Dialogue: 0,0:10:42.27,0:10:45.94,Default - Copy,Duff,0,0,0,,Өйткені бұл жігіт мүлде соққыға ұшырамайды.
Dialogue: 0,0:10:45.94,0:10:46.94,Default - Copy,Duff,0,0,0,,Сонымен
Dialogue: 0,0:10:46.94,0:10:49.01,Default - Copy,Riful,0,0,0,,Бұлай болмауы мүмкін емес.
Dialogue: 0,0:10:49.01,0:10:50.45,Default - Copy,Riful,0,0,0,,Сен ақымақ емессің бе?
Dialogue: 0,0:10:50.45,0:10:52.15,Default - Copy,Duff,0,0,0,,(Фушигиро) Неге мұнда жүрсің, Зэн'ин-сенпай?
Dialogue: 0,0:10:52.15,0:10:53.62,Default - Copy,Duff,0,0,0,,Сондықтан мен
Dialogue: 0,0:10:55.35,0:10:59.32,Default - Copy,Riful,0,0,0,,Ал, мен сізге қалай анық соққы беру керектігін көрсетемін.
Dialogue: 0,0:10:59.32,0:11:01.36,Default - Copy,Riful,0,0,0,,Келесі жолы дұрыс болжаңыз.
Dialogue: 0,0:11:01.36,0:11:02.66,Default - Copy,Duff,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:11:03.12,0:11:05.96,Default - Copy,Riful,0,0,0,,Бар күш-қуатыңызды арнаңыз.
Dialogue: 0,0:11:08.16,0:11:09.97,Default - Copy,Duff,0,0,0,,Кенже
Dialogue: 0,0:11:09.97,0:11:12.83,Default - Copy,Duff,0,0,0,,Мен біраз уақыттан бері қолымнан келгеннің бәрін істеп жүрмін.
Dialogue: 0,0:11:12.83,0:11:15.17,Default - Copy,Duff,0,0,0,,Бұл да мүлде дұрыс емес.
Dialogue: 0,0:11:15.17,0:11:17.14,Default - Copy,Riful,0,0,0,,Тек мұны жасамаңыз.
Dialogue: 0,0:11:17.14,0:11:18.41,Default - Copy,Riful,0,0,0,,Сізге айтайын
Dialogue: 0,0:11:18.41,0:11:20.75,Default - Copy,Riful,0,0,0,,Осы жолы жеңілсем, сенімен айырылысып кетем.
Dialogue: 0,0:11:20.75,0:11:23.28,Default - Copy,Duff,0,0,0,,Міне солай
Dialogue: 0,0:11:24.85,0:11:26.48,Default - Copy,Duff,0,0,0,,Келесі шайқас!
Dialogue: 0,0:11:29.45,0:11:31.35,Default - Copy,Duff,0,0,0,,Темено
Dialogue: 0,0:11:31.35,0:11:33.82,Default - Copy,Duff,0,0,0,,Бұл Теменің кінәсі.
Dialogue: 0,0:11:33.82,0:11:34.96,Default - Copy,Duff,0,0,0,,Кусога
Dialogue: 0,0:11:36.96,0:11:39.96,Default - Copy,Duff,0,0,0,,Жарайды, мен оны бұл жолы алған жоқпын.
Dialogue: 0,0:11:47.27,0:11:48.57,Default - Copy,Clare,0,0,0,,Галатея
Dialogue: 0,0:11:48.57,0:11:51.61,Default - Copy,Riful,0,0,0,,Иә, бұл жақсы, Дафф.
Dialogue: 0,0:11:51.61,0:11:53.38,Default - Copy,Riful,0,0,0,,Егер сіз мұны басынан бастап жасасаңыз
Dialogue: 0,0:11:53.38,0:11:55.61,Default - Copy,Riful,0,0,0,,Мен бір қолымды жоғалттым.
Dialogue: 0,0:11:55.61,0:11:56.41,Default - Copy,Clare,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:11:56.81,0:11:57.85,Default - Copy,Clare,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:11:57.91,0:12:00.15,Default - Copy,Riful,0,0,0,,Мен ештеңе істеген жоқпын.
Dialogue: 0,0:12:00.65,0:12:04.19,Default - Copy,Riful,0,0,0,,Ол басқа адамның жындарын басқара алады.
Dialogue: 0,0:12:05.29,0:12:06.02,Default - Copy,Riful,0,0,0,,Дегенмен
Dialogue: 0,0:12:07.59,0:12:09.39,Default - Copy,Riful,0,0,0,,Хонның ойнау деңгейі
Dialogue: 0,0:12:10.19,0:12:13.26,Default - Copy,Riful,0,0,0,,Мінез-құлықтың өзін тоқтату мүмкін емес.
Dialogue: 0,0:12:13.26,0:12:17.33,Default - Copy,Riful,0,0,0,,Сонымен Даффтың ашулы шабуылы
Dialogue: 0,0:12:17.33,0:12:20.04,Default - Copy,Riful,0,0,0,,Ол ештеңе істей алмайды.
Dialogue: 0,0:12:25.24,0:12:25.94,Default - Copy,Clare,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:12:25.94,0:12:26.78,Default - Copy,Clare,0,0,0,,аулақ болыңыз
Dialogue: 0,0:12:28.71,0:12:30.78,Default - Copy,Duff,0,0,0,,Мен түсіндім, алдым
Dialogue: 0,0:12:30.78,0:12:33.11,Default - Copy,Duff,0,0,0,,Енді қайда көздеуім керек?
Dialogue: 0,0:12:34.68,0:12:36.62,Default - Copy,Riful,0,0,0,,Бұл ойын.
Dialogue: 0,0:12:40.06,0:12:41.39,Default - Copy,Riful,0,0,0,,О сен
Dialogue: 0,0:12:41.39,0:12:45.36,Default - Copy,Riful,0,0,0,,Екі аяқты сауықтыру үшін сиқырлы күш жіберсе жақсы болар еді.
Dialogue: 0,0:12:45.36,0:12:47.46,Default - Copy,Riful,0,0,0,,Бұл шектен тыс.
Dialogue: 0,0:12:49.10,0:12:51.17,Default - Copy,Duff,0,0,0,,Келесі - кенеттен бас
Dialogue: 0,0:12:54.90,0:12:55.74,Default - Copy,Duff,0,0,0,,Бұл
Dialogue: 0,0:13:00.84,0:13:01.68,Default - Copy,Galatea,0,0,0,,Алып тасташы, өтінемін...?
Dialogue: 0,0:13:04.68,0:13:05.85,Default - Copy,Clare,0,0,0,,Артыңа шегін!
Dialogue: 0,0:13:05.85,0:13:06.78,Default - Copy,Clare,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:13:06.78,0:13:07.72,Default - Copy,Clare,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:13:08.08,0:13:09.02,Default - Copy,Clare,0,0,0,,Артыңа шегін!
Dialogue: 0,0:13:09.78,0:13:11.09,Default - Copy,Duff,0,0,0,,Ақымақ
Dialogue: 0,0:13:11.09,0:13:11.85,Default - Copy,Riful,0,0,0,,Дафф күтіңіз
Dialogue: 0,0:13:16.49,0:13:17.76,Default - Copy,Clare,0,0,0,,Артыңа шегін!
Dialogue: 0,0:13:17.76,0:13:18.56,Default - Copy,Clare,0,0,0,,Артыңа шегін!
Dialogue: 0,0:13:24.97,0:13:26.50,Default - Copy,Riful,0,0,0,,Жақында
Dialogue: 0,0:13:27.90,0:13:29.80,Default - Copy,Clare,0,0,0,,Жоқ, жоқ, артық емес
Dialogue: 0,0:13:45.25,0:13:46.35,Default - Copy,Galatea,0,0,0,,И-иә… рас. Менің ағамдай… деп ойлаймын
Dialogue: 0,0:13:47.76,0:13:49.39,Default - Copy,Galatea,0,0,0,,Оны шынымен қайтаруға бола ма?
Dialogue: 0,0:13:50.09,0:13:52.49,Default - Copy,Clare,0,0,0,,Енді сіз Галатеясыз.
Dialogue: 0,0:13:52.83,0:13:55.23,Default - Copy,Galatea,0,0,0,,Мен оны жаңа ғана осы жағына тарттым.
Dialogue: 0,0:13:55.73,0:13:57.47,Default - Copy,Galatea,0,0,0,,Ұйымдар назар аударады
Dialogue: 0,0:13:57.47,0:13:59.60,Default - Copy,Galatea,0,0,0,,Айналаңа көз салсаң болғаны.
Dialogue: 0,0:14:00.27,0:14:01.97,Default - Copy,Galatea,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:14:05.04,0:14:07.18,Default - Copy,Riful,0,0,0,,Не?
Dialogue: 0,0:14:07.18,0:14:09.64,Default - Copy,Riful,0,0,0,,Мен сені оянады деп ойладым.
Dialogue: 0,0:14:10.51,0:14:13.28,Default - Copy,Riful,0,0,0,,Елестерді басқара алатын үздік нөмір болыңыз
Dialogue: 0,0:14:13.28,0:14:16.38,Default - Copy,Riful,0,0,0,,Өз шегінен асып кетсе де қайтып орала алатын жұмбақ жауынгер.
Dialogue: 0,0:14:16.82,0:14:18.19,Default - Copy,Riful,0,0,0,,Маған ұнайды
Dialogue: 0,0:14:18.79,0:14:22.92,Default - Copy,Riful,0,0,0,,Екеуіңе менің тобыма қосылуға рұқсат етемін.
Dialogue: 0,0:14:24.39,0:14:28.40,Default - Copy,Clare,0,0,0,,Бұл үлкен, зұлым рух деген не?
Dialogue: 0,0:14:29.03,0:14:32.40,Default - Copy,Clare,0,0,0,,Ол кім?
Dialogue: 0,0:14:34.34,0:14:37.01,Default - Copy,Galatea,0,0,0,,Жауынгерлеріміздің ұзақ тарихында
Dialogue: 0,0:14:37.87,0:14:42.48,Default - Copy,Galatea,0,0,0,,№1 оятудың ең нашар үш жағдайы бар.
Dialogue: 0,0:14:43.18,0:14:45.15,Default - Copy,Galatea,0,0,0,,Адамзат дәуіріндегі жалғыз
Dialogue: 0,0:14:45.15,0:14:47.28,Default - Copy,Galatea,0,0,0,,Әйелдер жасындағы екі адам
Dialogue: 0,0:14:48.75,0:14:51.09,Default - Copy,Galatea,0,0,0,,Олар үш күшті деп аталады
Dialogue: 0,0:14:51.09,0:14:54.42,Default - Copy,Galatea,0,0,0,,Оянғандардың қожасы болды.
Dialogue: 0,0:14:54.42,0:14:55.89,Default - Copy,Galatea,0,0,0,,Жан-жақтан шашылған
Dialogue: 0,0:14:56.42,0:14:59.43,Default - Copy,Galatea,0,0,0,,Солтүстікке, батысқа және оңтүстікке қарай
Dialogue: 0,0:15:00.00,0:15:02.50,Default - Copy,Galatea,0,0,0,,Өйткені біз екеуіміз де күшті білдік
Dialogue: 0,0:15:02.50,0:15:04.53,Default - Copy,Galatea,0,0,0,,Бұл қажетсіз жанжалдан аулақ болды.
Dialogue: 0,0:15:06.60,0:15:07.90,Default - Copy,Galatea,0,0,0,,бастап олар
Dialogue: 0,0:15:07.90,0:15:10.11,Default - Copy,Galatea,0,0,0,,Ашық көрініссіз
Dialogue: 0,0:15:10.11,0:15:13.11,Default - Copy,Galatea,0,0,0,,Сондай-ақ Абиссалды деп аталады
Dialogue: 0,0:15:13.11,0:15:14.61,Default - Copy,Clare,0,0,0,,Бірінші абиссаль
Dialogue: 0,0:15:16.11,0:15:17.25,Default - Copy,Galatea,0,0,0,,Менің ойымша.
Dialogue: 0,0:15:17.71,0:15:21.08,Default - Copy,Galatea,0,0,0,,Батыстың Абиссалды Бір Рифул
Dialogue: 0,0:15:21.88,0:15:24.15,Default - Copy,Clare,0,0,0,,Батыс мылтық
Dialogue: 0,0:15:24.72,0:15:28.16,Default - Copy,Galatea,0,0,0,,Ұйымның жауынгер әйелі, бірінші нөмірлі.
Dialogue: 0,0:15:28.76,0:15:31.93,Default - Copy,Galatea,0,0,0,,Ол сол кездегі ең кенжесі болып, нүктені меңгерген.
Dialogue: 0,0:15:31.93,0:15:34.50,Default - Copy,Galatea,0,0,0,,Сол билікті босатқан жауынгер
Dialogue: 0,0:15:35.03,0:15:38.00,Default - Copy,Riful,0,0,0,,Сен әлі жассың, бірақ көп нәрсені білесің.
Dialogue: 0,0:15:38.37,0:15:40.50,Default - Copy,Riful,0,0,0,,Бірақ сіз аздап қателесесіз.
Dialogue: 0,0:15:41.17,0:15:45.21,Default - Copy,Riful,0,0,0,,Біз жанжалдан аулақ болғымыз келген сияқты емес.
Dialogue: 0,0:15:45.57,0:15:49.51,Default - Copy,Riful,0,0,0,,Тек біз кездейсоқ жеткен орындар бір-біріне сәйкес келмеді.
Dialogue: 0,0:15:51.58,0:15:54.22,Default - Copy,Galatea,0,0,0,,Неліктен ол жақында қозғала бастады?
Dialogue: 0,0:15:54.58,0:15:56.08,Default - Copy,Galatea,0,0,0,,Сіз жалғыз емессіз
Dialogue: 0,0:15:56.08,0:15:58.15,Default - Copy,Galatea,0,0,0,,Сондай-ақ екеуі бар, біреуі солтүстікте, екіншісі оңтүстікте.
Dialogue: 0,0:15:59.22,0:16:03.73,Default - Copy,Galatea,0,0,0,,Олардың әрқайсысы әр жерден оянған адамдарды өз қатарына тарта бастады.
Dialogue: 0,0:16:04.59,0:16:08.33,Default - Copy,Galatea,0,0,0,,Балалар, сендер не істемексіңдер?
Dialogue: 0,0:16:08.33,0:16:12.07,Default - Copy,Riful,0,0,0,,Менімен солтүстіктен бір адам төбелесті.
Dialogue: 0,0:16:12.77,0:16:18.81,Default - Copy,Riful,0,0,0,,Әйтеуір сол әйелді алғаннан кейін солтүстіктің жігіті еріп кетті.
Dialogue: 0,0:16:18.81,0:16:20.08,Default - Copy,Clare,0,0,0,,Сол әйел
Dialogue: 0,0:16:20.71,0:16:24.91,Default - Copy,Riful,0,0,0,,Солтүстік елде өз қалауынша шапқылап жүрген оянған адам.
Dialogue: 0,0:16:25.25,0:16:27.08,Default - Copy,Riful,0,0,0,,Бір мүйізді әйел
Dialogue: 0,0:16:27.08,0:16:27.95,Default - Copy,Clare,0,0,0,,Прискила
Dialogue: 0,0:16:28.68,0:16:29.38,Default - Copy,Riful,0,0,0,,Маа
Dialogue: 0,0:16:29.38,0:16:30.82,Default - Copy,Riful,0,0,0,,Менің де бос уақытым бар.
Dialogue: 0,0:16:30.82,0:16:32.79,Default - Copy,Riful,0,0,0,,Мен бұл жекпе-жекті сатып алуды шештім.
Dialogue: 0,0:16:33.92,0:16:37.16,Default - Copy,Riful,0,0,0,,Енді мен әртүрлі бөлшектерді жинап жатырмын.
Dialogue: 0,0:16:37.66,0:16:39.83,Default - Copy,Clare,0,0,0,,Бұл қайда?
Dialogue: 0,0:16:40.26,0:16:41.16,Default - Copy,Clare,0,0,0,,Қайдасың?
Dialogue: 0,0:16:42.50,0:16:43.50,Default - Copy,Riful,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:16:43.50,0:16:45.67,Default - Copy,Riful,0,0,0,,Даусыңыз өте кішкентай, мен оны естімеймін.
Dialogue: 0,0:16:47.67,0:16:50.24,Default - Copy,Clare,0,0,0,,Солтүстіктің атын айт.
Dialogue: 0,0:16:50.24,0:16:53.54,Default - Copy,Clare,0,0,0,,Мен ол әйелді өлтіремін.
Dialogue: 0,0:16:53.54,0:16:56.11,Default - Copy,Riful,0,0,0,,О, мен ол қызды білемін.
Dialogue: 0,0:16:56.38,0:16:58.25,Default - Copy,Clare,0,0,0,,Көп сөйлеме
Dialogue: 0,0:16:58.65,0:17:02.75,Default - Copy,Clare,0,0,0,,Маған солтүстіктен келген адамның аты-жөнін, қайда екенін айтсаңыз болғаны.
Dialogue: 0,0:17:03.39,0:17:05.52,Default - Copy,Riful,0,0,0,,Сіз өте сөйлейтінсіз.
Dialogue: 0,0:17:05.89,0:17:07.26,Default - Copy,Riful,0,0,0,,Иә.
Dialogue: 0,0:17:08.02,0:17:12.76,Default - Copy,Riful,0,0,0,,Маған бір соққы болса да, мен сізге хабарлаймын.
Dialogue: 0,0:17:17.20,0:17:19.70,Default - Copy,Riful,0,0,0,,Кешіріңіз, бұл ұят болды.
Dialogue: 0,0:17:22.50,0:17:23.31,Default - Copy,Riful,0,0,0,,Жоғарыда
Dialogue: 0,0:17:29.14,0:17:31.75,Default - Copy,Duff,0,0,0,,Бұл сұмдық
Dialogue: 0,0:17:34.32,0:17:34.85,Default - Copy,Duff,0,0,0,,Сәлем
Dialogue: 0,0:17:34.85,0:17:36.18,Default - Copy,Riful,0,0,0,,Қара, қара!
Dialogue: 0,0:17:36.18,0:17:38.55,Default - Copy,Riful,0,0,0,,Бұл ауыратын уақыт емес.
Dialogue: 0,0:17:41.03,0:17:44.13,Default - Copy,Duff,0,0,0,,Алданба, ақымақ.
Dialogue: 0,0:17:45.49,0:17:47.73,Default - Copy,Riful,0,0,0,,Мен көремін.
Dialogue: 0,0:17:47.73,0:17:50.33,Default - Copy,Riful,0,0,0,,шектен соқыр түрде асып кетудің орнына
Dialogue: 0,0:17:50.33,0:17:55.80,Default - Copy,Riful,0,0,0,,Ашық ниетпен кесіп өткенде күшіңіз бен жылдамдығыңыз арта түсетін сияқты.
Dialogue: 0,0:18:08.98,0:18:12.39,Default - Copy,Clare,0,0,0,,Енді мен сіздің сұрағыңызға жауап берейін.
Dialogue: 0,0:18:12.99,0:18:17.03,Default - Copy,Riful,0,0,0,,Әй, мен әлі қиылған жоқпын.
Dialogue: 0,0:18:17.03,0:18:19.16,Default - Copy,Clare,0,0,0,,Егер сіз сонша өлгіңіз келсе
Dialogue: 0,0:18:19.16,0:18:20.83,Default - Copy,Clare,0,0,0,,Мен сенің қалағаныңды істеймін
Dialogue: 0,0:18:23.70,0:18:26.50,Default - Copy,Galatea,0,0,0,,Ол көп көңіл бөлуді қажет ететін проблемалық бала.
Dialogue: 0,0:18:35.54,0:18:38.88,Default - Copy,Riful,0,0,0,,Бұл сәл көбірек болды
Dialogue: 0,0:18:38.88,0:18:39.65,Default - Copy,Riful,0,0,0,,Өте жаман
Dialogue: 0,0:18:43.85,0:18:45.25,Default - Copy,Clare,0,0,0,,Мен не істеймін?
Dialogue: 0,0:18:45.79,0:18:48.19,Default - Copy,Galatea,0,0,0,,Біз оларға қосыла жаздадық.
Dialogue: 0,0:18:48.79,0:18:53.16,Default - Copy,Galatea,0,0,0,,Бұл жай ғана олардың ойы, мысалы, жеңіл арандатушылықты пайдаланып, ояту.
Dialogue: 0,0:18:56.93,0:18:58.90,Default - Copy,Galatea,0,0,0,,Мен бұл үлкен нәрсені өлтіремін.
Dialogue: 0,0:18:59.70,0:19:02.54,Default - Copy,Galatea,0,0,0,,Тұңғиық жұртында соғысуға ерік-жігері болмаса
Dialogue: 0,0:19:02.54,0:19:04.67,Default - Copy,Galatea,0,0,0,,Бізде әлі де мүмкіндік бар
Dialogue: 0,0:19:05.37,0:19:08.94,Default - Copy,Galatea,0,0,0,,Ол үшін бір адамның күші өте қажет.
Dialogue: 0,0:19:09.54,0:19:10.58,Default - Copy,Clare,0,0,0,,Басқа адам
Dialogue: 0,0:19:10.95,0:19:14.68,Default - Copy,Galatea,0,0,0,,Күшті денесіне қылыш қадалған адам.
Dialogue: 0,0:19:15.55,0:19:17.52,Default - Copy,Galatea,0,0,0,,Төмендегі 9 саны
Dialogue: 0,0:19:17.52,0:19:19.66,Default - Copy,Galatea,0,0,0,,Мен Жанның күшін қалаймын
Dialogue: 0,0:19:19.66,0:19:22.19,Default - Copy,Clare,0,0,0,,9 саны ген
Dialogue: 0,0:19:22.19,0:19:25.39,Default - Copy,Galatea,0,0,0,,Бірақ ол өте тұрақсыз күйде.
Dialogue: 0,0:19:25.83,0:19:28.00,Default - Copy,Galatea,0,0,0,,Ол кез келген уақытта оянуы мүмкін.
Dialogue: 0,0:19:28.73,0:19:33.50,Default - Copy,Galatea,0,0,0,,Ол физикалық жағынан да, рухани жағынан да көп зардап шексе керек.
Dialogue: 0,0:19:33.94,0:19:38.64,Default - Copy,Galatea,0,0,0,,Оның жеке басын ескере отырып, ол оятудан гөрі өлімді таңдар еді.
Dialogue: 0,0:19:39.14,0:19:42.14,Default - Copy,Galatea,0,0,0,,Бұған жағдай мүмкіндік бермесе керек.
Dialogue: 0,0:19:43.48,0:19:45.28,Default - Copy,Galatea,0,0,0,,Мен мұнымен айналысамын.
Dialogue: 0,0:19:45.68,0:19:47.92,Default - Copy,Galatea,0,0,0,,Жанды құтқаруға бару керек.
Dialogue: 0,0:19:48.72,0:19:51.65,Default - Copy,Galatea,0,0,0,,Ал егер тым кеш болса
Dialogue: 0,0:19:52.22,0:19:54.86,Default - Copy,Galatea,0,0,0,,Сіз Джиннің өмірін аяқтайсыз.
Dialogue: 0,0:19:55.66,0:19:56.29,Default - Copy,Galatea,0,0,0,,Уууууууу!!
Dialogue: 0,0:19:56.29,0:19:57.43,Default - Copy,Galatea,0,0,0,,Менің уақытым жоқ
Dialogue: 0,0:19:59.06,0:20:00.90,Default - Copy,Duff,0,0,0,,Қашып кеткіңіз келе ме?
Dialogue: 0,0:20:01.93,0:20:03.00,Default - Copy,Duff,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:20:05.17,0:20:05.90,Default - Copy,Duff,0,0,0,,Сәлем
Dialogue: 0,0:20:06.43,0:20:09.17,Default - Copy,Duff,0,0,0,,Қал, қал, бұрынғыдан ұзағырақ қал.
Dialogue: 0,0:20:26.02,0:20:26.72,Default - Copy,Clare,0,0,0,,Ген
Dialogue: 0,0:20:34.56,0:20:36.13,Default - Copy,Duff,0,0,0,,Тема
Dialogue: 0,0:20:36.36,0:20:38.90,Default - Copy,Galatea,0,0,0,,Бұл менің сұлулық сезіміме қайшы келеді.
Dialogue: 0,0:20:38.90,0:20:41.30,Default - Copy,Galatea,0,0,0,,Мен мұны істегім келмейді.
Dialogue: 0,0:20:46.14,0:20:53.62,Default - Copy,Galatea,0,0,0,,Сиқырлы қуатты босатқанда күштің арту қарқыны 47 адам арасында ең жоғары екені айтылады.
Dialogue: 0,0:20:54.25,0:20:59.35,Default - Copy,Galatea,0,0,0,,Кешіріңіз, бірақ мен бұл ұсқынсыз фигураны біраз уақытқа қалдыруым керек.
Dialogue: 0,0:20:59.35,0:21:02.83,Default - Copy,Duff,0,0,0,,Эй, сен қалжыңдап тұрсың.
Dialogue: 0,0:21:02.83,0:21:04.63,Default - Copy,Duff,0,0,0,,Мен сені енді кешірмеймін
Dialogue: 0,0:21:05.13,0:21:06.90,Default - Copy,Duff,0,0,0,,Э? Қайда?
Dialogue: 0,0:21:07.36,0:21:09.60,Default - Copy,Duff,0,0,0,,Э? Қайда?
Dialogue: 0,0:21:12.10,0:21:14.70,Default - Copy,Riful,0,0,0,,Мұның бәрі уақытты сатып алу туралы.
Dialogue: 0,0:21:23.11,0:21:24.15,Default - Copy,Clare,0,0,0,,Сен шынымен де тамаша ФБР агенті болдың.
Dialogue: 0,0:21:26.72,0:21:29.02,Default - Copy,Jeane,0,0,0,,Мені өлтір
Dialogue: 0,0:22:39.90,0:22:41.80,Default - Copy,,0,0,0,,Шектеуге жақындау
Dialogue: 0,0:22:41.80,0:22:43.34,Default - Copy,,0,0,0,,Шектен асып кету
Dialogue: 0,0:22:43.44,0:22:46.04,Default - Copy,,0,0,0,,Сырттан келген жаулар
Dialogue: 0,0:22:47.54,0:22:53.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory