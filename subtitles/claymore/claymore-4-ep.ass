Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.25,0:00:04.40,Default - Copy,Clare,0,0,0,,Басқа адамның тәбеті қалыпты емес сияқты.
Dialogue: 0,0:00:04.40,0:00:05.68,Default - Copy,Vincent,0,0,0,,Тәбеті бұзылған адам
Dialogue: 0,0:00:05.68,0:00:07.65,Default - Copy,Clare,0,0,0,,Балалар, сендер менімен тең емессіңдер.
Dialogue: 0,0:00:09.99,0:00:10.78,Default - Copy,Clare,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:00:10.78,0:00:11.42,Default - Copy,Clare,0,0,0,,Олар – аң, ал біз – аңшылар!
Dialogue: 0,0:00:31.81,0:00:32.74,Default - Copy,bg,0,0,0,,Не?
Dialogue: 0,0:00:32.74,0:00:33.80,Default - Copy,bg,0,0,0,,Не шу?
Dialogue: 0,0:00:35.64,0:00:36.18,Default - Copy,Sid,0,0,0,,Қ-Қандай?
Dialogue: 0,0:00:39.92,0:00:40.58,Default - Copy,Sid,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:00:44.16,0:00:45.66,Default - Copy,Sid,0,0,0,,Өлген жоқсың ба?
Dialogue: 0,0:00:48.52,0:00:51.80,Default - Copy,Galk,0,0,0,,Жоқ, жүрегім әрең соғып тұр.
Dialogue: 0,0:00:52.73,0:00:55.09,Default - Copy,Sid,0,0,0,,Эй, не болды, Гарк?
Dialogue: 0,0:00:55.39,0:00:57.06,Default - Copy,Sid,0,0,0,,Оны жай қалдырыңыз.
Dialogue: 0,0:00:57.06,0:00:57.97,Default - Copy,Sid,0,0,0,,Мұндай құбыжық
Dialogue: 0,0:00:59.18,0:01:00.66,Default - Copy,Galk,0,0,0,,Өмір сақталды
Dialogue: 0,0:01:01.26,0:01:02.48,Default - Copy,Galk,0,0,0,,Қарыздарды өтеу
Dialogue: 0,0:01:02.81,0:01:05.11,Default - Copy,Galk,0,0,0,,Жартылай жын болсаң да
Dialogue: 0,0:02:17.07,0:02:17.96,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:02:18.86,0:02:19.66,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:02:20.99,0:02:22.86,Default - Copy,Raki,0,0,0,,Эй, Клэр жақсы.
Dialogue: 0,0:02:23.54,0:02:25.77,Default - Copy,Vincent,0,0,0,,Менің жартылай адам, жартылай жын денем үшін
Dialogue: 0,0:02:25.77,0:02:28.11,Default - Copy,Vincent,0,0,0,,Мен бұл туралы не істерімді білмеймін.
Dialogue: 0,0:02:29.10,0:02:29.90,Default - Copy,Raki,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:02:30.57,0:02:32.24,Default - Copy,Raki,0,0,0,,Содан кейін Клэр
Dialogue: 0,0:02:32.24,0:02:33.35,Default - Copy,Sid,0,0,0,,Мен өлемін
Dialogue: 0,0:02:34.25,0:02:38.01,Default - Copy,Sid,0,0,0,,Бұл жай ғана бір-бірін өлтірген жын мен жартылай адам және жартылай жын болды.
Dialogue: 0,0:02:38.38,0:02:40.86,Default - Copy,Sid,0,0,0,,Бізге шу шығару емес.
Dialogue: 0,0:02:42.96,0:02:43.83,Default - Copy,Sid,0,0,0,,Сәлем
Dialogue: 0,0:02:43.83,0:02:47.99,Default - Copy,Raki,0,0,0,,Клэр әрқашан шайқаста өз өмірін құрбан етуге дайын болды.
Dialogue: 0,0:02:47.99,0:02:49.37,Default - Copy,Raki,0,0,0,,Біз адамдар үшін
Dialogue: 0,0:02:50.19,0:02:52.26,Default - Copy,Raki,0,0,0,,Клэр мені көтеріп алды.
Dialogue: 0,0:02:52.94,0:02:55.55,Default - Copy,Raki,0,0,0,,Сол кезде қандай бақытты едім
Dialogue: 0,0:02:56.35,0:03:00.68,Default - Copy,Raki,0,0,0,,Клэр қарапайым адамдарға қарағанда әлдеқайда мейірімді және жүрегі әдемірек.
Dialogue: 0,0:03:04.13,0:03:05.69,Default - Copy,Sid,0,0,0,,Мен байсалдымын
Dialogue: 0,0:03:06.48,0:03:08.39,Default - Copy,Sid,0,0,0,,Мен өз миссияма қайта ораламын.
Dialogue: 0,0:03:11.23,0:03:12.27,Default - Copy,Vincent,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:13.93,0:03:14.90,Default - Copy,Raki,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:03:14.90,0:03:15.78,Default - Copy,Raki,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:03:16.25,0:03:17.11,Default - Copy,Galk,0,0,0,,Жылама
Dialogue: 0,0:03:18.06,0:03:19.61,Default - Copy,Galk,0,0,0,,Әлі біткен жоқ
Dialogue: 0,0:03:20.59,0:03:22.62,Default - Copy,Galk,0,0,0,,Иманды жүрек қуатқа айналады
Dialogue: 0,0:03:23.38,0:03:26.29,Default - Copy,Galk,0,0,0,,Сөзсіз, аз болса да.
Dialogue: 0,0:03:27.93,0:03:29.14,Default - Copy,Galk,0,0,0,,Мен сенемін
Dialogue: 0,0:03:29.80,0:03:31.54,Default - Copy,Galk,0,0,0,,Ол құтқарылады.
Dialogue: 0,0:03:57.94,0:04:00.44,Default - Copy,Vincent,0,0,0,,А, сен ояусың ба?
Dialogue: 0,0:04:00.85,0:04:02.35,Default - Copy,Clare,0,0,0,,Кешіріңіз, діни қызметкер.
Dialogue: 0,0:04:02.81,0:04:04.18,Default - Copy,Clare,0,0,0,,Сіз оны шешкен сияқтысыз
Dialogue: 0,0:04:04.83,0:04:06.66,Default - Copy,Vincent,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:04:07.19,0:04:08.79,Default - Copy,Clare,0,0,0,,Содан бері неше күн өтті?
Dialogue: 0,0:04:09.16,0:04:10.92,Default - Copy,Vincent,0,0,0,,Иә, екі күн болады.
Dialogue: 0,0:04:11.67,0:04:17.71,Default - Copy,Vincent,0,0,0,,Осы уақытта Раки-сан жаныңда тұрып, сенің оянуыңды сұрап жатты.
Dialogue: 0,0:04:24.15,0:04:25.57,Default - Copy,Clare,0,0,0,,Кешіріңіз, бірақ діни қызметкер
Dialogue: 0,0:04:25.57,0:04:26.43,Default - Copy,Clare,0,0,0,,Менің бір өтінішім бар
Dialogue: 0,0:04:30.97,0:04:31.97,Default - Copy,priestA,0,0,0,,епископ Винсент
Dialogue: 0,0:04:32.67,0:04:34.67,Default - Copy,priestA,0,0,0,,Түнде не болып жатыр?
Dialogue: 0,0:04:36.22,0:04:38.94,Default - Copy,Vincent,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:04:38.94,0:04:41.95,Default - Copy,Vincent,0,0,0,,Осы нұсқауларды біраз уақытқа орындағаныңызды қалаймын.
Dialogue: 0,0:04:41.95,0:04:43.76,Default - Copy,priestA,0,0,0,,епископ Винсент
Dialogue: 0,0:04:43.76,0:04:46.17,Default - Copy,priestB,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:04:47.88,0:04:49.42,Default - Copy,Vincent,0,0,0,,Бұл жынның өзгеруі.
Dialogue: 0,0:04:50.05,0:04:52.45,Default - Copy,priestB,0,0,0,,Сіз өзгересіз
Dialogue: 0,0:04:52.45,0:04:55.45,Default - Copy,priestB,0,0,0,,Мен оны біздің ішімізде жасырады деп ешқашан ойламаппын.
Dialogue: 0,0:04:55.45,0:04:59.20,Default - Copy,Vincent,0,0,0,,Өкінішке орай, осы уақытқа дейінгі жағдайға қарап,
Dialogue: 0,0:04:59.20,0:05:01.08,Default - Copy,Vincent,0,0,0,,Мен солай ойлауым керек.
Dialogue: 0,0:05:06.03,0:05:07.21,Default - Copy,priestA,0,0,0,,Күміс көздер
Dialogue: 0,0:05:07.74,0:05:09.27,Default - Copy,priestA,0,0,0,,Күміс көзді бақсы?
Dialogue: 0,0:05:09.27,0:05:10.27,Default - Copy,priestB,0,0,0,,Винсент
Dialogue: 0,0:05:10.27,0:05:13.21,Default - Copy,priestB,0,0,0,,Бұл жынды сен басқардың ба?
Dialogue: 0,0:05:14.14,0:05:16.51,Default - Copy,Vincent,0,0,0,,Менің мұны істеуден басқа амалым қалмады.
Dialogue: 0,0:05:17.71,0:05:21.28,Default - Copy,Kamuri,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:05:21.28,0:05:22.72,Default - Copy,priestA,0,0,0,,епископ Камри
Dialogue: 0,0:05:22.72,0:05:24.12,Default - Copy,priestB,0,0,0,,Винсент
Dialogue: 0,0:05:24.12,0:05:25.45,Default - Copy,priestB,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:05:25.45,0:05:28.59,Default - Copy,priestB,0,0,0,,Тіпті архиепископ жынға айнала ма?
Dialogue: 0,0:05:28.59,0:05:29.72,Default - Copy,priestB,0,0,0,,Мені кешіріңіз.
Dialogue: 0,0:05:29.72,0:05:31.60,Default - Copy,priestB,0,0,0,,Бұл үшін мені кешіріңіз.
Dialogue: 0,0:05:33.71,0:05:34.60,Default - Copy,priestB,0,0,0,,Винсент
Dialogue: 0,0:05:35.76,0:05:38.10,Default - Copy,Vincent,0,0,0,,Бізге көмектесіңізші.
Dialogue: 0,0:05:49.74,0:05:51.22,Default - Copy,Sid,0,0,0,,Маған ұнамайды
Dialogue: 0,0:05:51.58,0:05:53.73,Default - Copy,Sid,0,0,0,,Қандай жартылай адам, жартылай жын.
Dialogue: 0,0:05:54.12,0:05:56.22,Default - Copy,Galk,0,0,0,,Епископ Винсенттің бұйрықтары.
Dialogue: 0,0:05:56.22,0:05:57.79,Default - Copy,Sid,0,0,0,,Мен білемін.
Dialogue: 0,0:05:57.79,0:05:58.63,Default - Copy,Clare,0,0,0,,Жарайды
Dialogue: 0,0:05:58.63,0:05:59.21,Default - Copy,Clare,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:05:59.79,0:06:02.17,Default - Copy,Sid,0,0,0,,Айтпақшы, сен мұны шынымен жасайсың ба?
Dialogue: 0,0:06:03.34,0:06:05.18,Default - Copy,Sid,0,0,0,,Бұл әйелдің айтқаны.
Dialogue: 0,0:06:05.96,0:06:07.70,Default - Copy,Galk,0,0,0,,Егер сіз жын тапсаңыз
Dialogue: 0,0:06:07.70,0:06:13.97,Default - Copy,Galk,0,0,0,,Ол әйел сені құшақтап, қозғалыстарыңды бөгейді, сондықтан оны найзамен тесу керек.
Dialogue: 0,0:06:15.11,0:06:16.44,Default - Copy,Galk,0,0,0,,Ол байсалды шығар.
Dialogue: 0,0:06:17.49,0:06:19.82,Default - Copy,Galk,0,0,0,,Менің ойымша, бұл дене толық сауыққан жоқ.
Dialogue: 0,0:06:20.24,0:06:23.42,Default - Copy,Galk,0,0,0,,Бұл ең сенімді әдіс.
Dialogue: 0,0:06:23.42,0:06:25.03,Default - Copy,Sid,0,0,0,,Маған ұнамайды
Dialogue: 0,0:06:25.62,0:06:30.26,Default - Copy,Galk,0,0,0,,Біз адамдардың өмірін сақтау үшін өз өміріңізді құрбан етіңіз.
Dialogue: 0,0:06:30.72,0:06:32.71,Default - Copy,Galk,0,0,0,,Бала осылай деді ме?
Dialogue: 0,0:06:33.08,0:06:34.80,Default - Copy,Sid,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:06:34.80,0:06:35.66,Default - Copy,Galk,0,0,0,,Бұл не?
Dialogue: 0,0:06:35.66,0:06:38.26,Default - Copy,Sid,0,0,0,,Бұл қала біздің қаламыз.
Dialogue: 0,0:06:38.26,0:06:38.81,Default - Copy,Sid,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:06:39.54,0:06:40.81,Default - Copy,Clare,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:06:40.81,0:06:41.90,Default - Copy,priest,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:06:43.65,0:06:44.56,Default - Copy,Clare,0,0,0,,Күлкілі
Dialogue: 0,0:06:45.18,0:06:46.87,Default - Copy,Clare,0,0,0,,Жындардың белгісі жоқ
Dialogue: 0,0:06:47.53,0:06:50.21,Default - Copy,Clare,0,0,0,,Олардың бәрінің де оң жақ көздері бар, олар жаншылған болуы керек еді.
Dialogue: 0,0:06:51.78,0:06:53.31,Default - Copy,Clare,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:06:58.76,0:07:00.18,Default - Copy,Raki,0,0,0,,Ол жерде жоқ.
Dialogue: 0,0:07:01.71,0:07:04.07,Default - Copy,Raki,0,0,0,,Мен мұндай жерде күтуге тура келгеніме сене алар емеспін.
Dialogue: 0,0:07:04.07,0:07:06.88,Default - Copy,Raki,0,0,0,,Мен бұл шомылдыру рәсімінен өтуге жақсы емеспін.
Dialogue: 0,0:07:08.61,0:07:11.52,Default - Copy,Raki,0,0,0,,Бұл не?
Dialogue: 0,0:07:13.37,0:07:14.19,Default - Copy,Clare,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:07:17.01,0:07:18.65,Default - Copy,Clare,0,0,0,,Тек екі адам қалды
Dialogue: 0,0:07:28.73,0:07:29.63,Default - Copy,Clare,0,0,0,,Жоқ
Dialogue: 0,0:07:30.02,0:07:31.75,Default - Copy,Clare,0,0,0,,Ол да жын емес.
Dialogue: 0,0:07:33.57,0:07:35.80,Default - Copy,Kamuri,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:07:36.86,0:07:37.49,Default - Copy,Clare,0,0,0,,Иә
Dialogue: 0,0:07:39.14,0:07:40.09,Default - Copy,Galk,0,0,0,,Мен осы маңдағы бірнеше ғибадатханаларды аралап келемін.
Dialogue: 0,0:07:43.12,0:07:43.95,Default - Copy,Vincent,0,0,0,,Не
Dialogue: 0,0:07:44.60,0:07:46.63,Default - Copy,Clare,0,0,0,,Кешіріңіз, епископ Винсент.
Dialogue: 0,0:07:47.21,0:07:48.97,Default - Copy,Clare,0,0,0,,Сіз де ерекшелік емессіз.
Dialogue: 0,0:07:49.72,0:07:50.97,Default - Copy,Vincent,0,0,0,,Ол сондай адам.
Dialogue: 0,0:07:51.84,0:07:53.50,Default - Copy,Clare,0,0,0,,Маған зерттеуге рұқсат етіңіз.
Dialogue: 0,0:08:02.34,0:08:03.23,Default - Copy,Clare,0,0,0,,Жоқ
Dialogue: 0,0:08:03.90,0:08:05.55,Default - Copy,Clare,0,0,0,,Ол да жын емес.
Dialogue: 0,0:08:11.04,0:08:12.19,Default - Copy,Clare,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:08:12.67,0:08:14.66,Default - Copy,Clare,0,0,0,,Ол соборда болуы керек.
Dialogue: 0,0:08:15.24,0:08:16.84,Default - Copy,Clare,0,0,0,,Неліктен оны табу мүмкін емес?
Dialogue: 0,0:08:17.56,0:08:19.46,Default - Copy,Clare,0,0,0,,Маған бірдеңе жетіспеді ме?
Dialogue: 0,0:08:20.03,0:08:21.06,Default - Copy,Clare,0,0,0,,Ойлан
Dialogue: 0,0:08:21.56,0:08:22.79,Default - Copy,Clare,0,0,0,,Ойлан
Dialogue: 0,0:08:22.79,0:08:27.39,Default - Copy,Clare,0,0,0,,Денесін жасыра алғанша, оған бәрібір.
Dialogue: 0,0:08:27.94,0:08:29.81,Default - Copy,Clare,0,0,0,,Ер әйел
Dialogue: 0,0:08:29.81,0:08:33.52,Default - Copy,Clare,0,0,0,,Бала ма, қария ма
Dialogue: 0,0:08:35.46,0:08:37.60,Default - Copy,Clare,0,0,0,,Тіпті адам өлген болса да
Dialogue: 0,0:08:39.19,0:08:41.55,Default - Copy,Raki,0,0,0,,Оның дәмі өте нашар.
Dialogue: 0,0:08:43.67,0:08:46.06,Default - Copy,Raki,0,0,0,,Солай болса да әлі біткен жоқ, юма-чан.
Dialogue: 0,0:08:50.65,0:08:51.70,Default - Copy,Clare,0,0,0,,Раки
Dialogue: 0,0:08:56.25,0:08:58.44,Default - Copy,Raki,0,0,0,,Жақсысың ба, Клэр?
Dialogue: 0,0:09:13.23,0:09:14.44,Default - Copy,Raki,0,0,0,,Бұл
Dialogue: 0,0:09:21.14,0:09:22.18,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:09:23.02,0:09:24.91,Default - Copy,Clare,0,0,0,,Амансың ба? Сіз жарақат алдыңыз ба?
Dialogue: 0,0:09:24.91,0:09:26.55,Default - Copy,Raki,0,0,0,,Иә, жақсы.
Dialogue: 0,0:09:29.22,0:09:31.56,Default - Copy,Clare,0,0,0,,Жынның қимылын тоқтатамын
Dialogue: 0,0:09:31.56,0:09:33.92,Default - Copy,Clare,0,0,0,,Сіз кіреберіске қарай бет алуыңыз керек, жарай ма?
Dialogue: 0,0:09:33.92,0:09:34.59,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:09:37.79,0:09:38.66,Default - Copy,Clare,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:09:42.03,0:09:42.76,Default - Copy,Clare,0,0,0,,Раки
Dialogue: 0,0:09:49.44,0:09:50.74,Default - Copy,Sid,0,0,0,,Жүгір, балақай.
Dialogue: 0,0:09:58.98,0:09:59.99,Default - Copy,Galk,0,0,0,,Неге ешкім қабырғаға өрмелеп шығуға тырыспайды?
Dialogue: 0,0:09:59.99,0:10:01.32,Default - Copy,Galk,0,0,0,,Маған көмек керек емес
Dialogue: 0,0:10:05.49,0:10:06.79,Default - Copy,Sid,0,0,0,,Осымен
Dialogue: 0,0:10:07.14,0:10:09.22,Default - Copy,Sid,0,0,0,,Барлығын өз бетіңізше қорғауға тырыспаңыз.
Dialogue: 0,0:10:09.94,0:10:13.23,Default - Copy,Sid,0,0,0,,Мен жарақат алсам, қорғай алатын жалғыз адам – осы бала.
Dialogue: 0,0:10:13.86,0:10:16.09,Default - Copy,Sid,0,0,0,,Бұл қала біздің қаламыз.
Dialogue: 0,0:10:16.09,0:10:18.73,Default - Copy,Sid,0,0,0,,Мен өз өмірімді қатерге тігуге дайынмын.
Dialogue: 0,0:10:19.36,0:10:22.24,Default - Copy,Galk,0,0,0,,Бала үшін және өзің үшін күресу керек.
Dialogue: 0,0:10:22.92,0:10:25.47,Default - Copy,Galk,0,0,0,,Біз өз қаламыз үшін күресеміз
Dialogue: 0,0:10:25.92,0:10:29.48,Default - Copy,Galk,0,0,0,,Өйткені, мен осы киелі қаланы қорғап жүрген жауынгермін.
Dialogue: 0,0:10:31.48,0:10:32.65,Default - Copy,Galk,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:10:47.69,0:10:48.93,Default - Copy,Clare,0,0,0,,Ол келмеді ме?
Dialogue: 0,0:11:07.56,0:11:08.41,Default - Copy,Galk,0,0,0,,18-ші эпизод: Венецияға!
Dialogue: 0,0:11:08.41,0:11:09.76,Default - Copy,Galk,0,0,0,,Сіз бұл туралы ештеңе істей алмайсыз.
Dialogue: 0,0:11:10.12,0:11:11.08,Default - Copy,Raki,0,0,0,,Ол сөзсіз осында—
Dialogue: 0,0:11:11.08,0:11:12.25,Default - Copy,Raki,0,0,0,,Ууух!
Dialogue: 0,0:11:13.48,0:11:14.99,Default - Copy,Raki,0,0,0,,Мұны Клэрге беріңіз
Dialogue: 0,0:11:15.93,0:11:17.23,Default - Copy,Galk,0,0,0,,Бұл не?
Dialogue: 0,0:11:18.35,0:11:19.73,Default - Copy,Raki,0,0,0,,Мен жай ғана соған қосылып жүрдім.
Dialogue: 0,0:11:26.23,0:11:29.17,Default - Copy,Galk,0,0,0,,Әйелді қабылдау
Dialogue: 0,0:11:49.45,0:11:51.49,Default - Copy,Yoma,0,0,0,,Клеймор
Dialogue: 0,0:11:58.49,0:11:59.12,Default - Copy,Clare,0,0,0,,Келіңіздер!
Dialogue: 0,0:11:59.55,0:12:01.38,Default - Copy,Clare,0,0,0,,Жындарды аулауды бастайық па?
Dialogue: 0,0:12:15.82,0:12:17.42,Default - Copy,Yoma,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:12:30.22,0:12:31.97,Default - Copy,Yoma,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:12:34.53,0:12:36.38,Default - Copy,Galk,0,0,0,,Аспанда не болып жатыр?
Dialogue: 0,0:12:37.09,0:12:42.14,Default - Copy,Galk,0,0,0,,Бұл Клеймордың үлкен қылыш ұстаған шынайы түрі ме?
Dialogue: 0,0:12:42.14,0:12:42.91,Default - Copy,Raki,0,0,0,,Жоқ
Dialogue: 0,0:12:44.28,0:12:45.16,Default - Copy,Raki,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:12:45.91,0:12:46.49,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:12:47.32,0:12:50.90,Default - Copy,Raki,0,0,0,,Дәл қазір мен қозғалу мүмкіндігімнен тыс күресіп жатырмын.
Dialogue: 0,0:12:56.22,0:12:57.79,Default - Copy,Yoma,0,0,0,,Не болды?
Dialogue: 0,0:12:57.79,0:12:59.73,Default - Copy,Yoma,0,0,0,,Сіз бозарған сияқтысыз.
Dialogue: 0,0:13:00.44,0:13:02.25,Default - Copy,Yoma,0,0,0,,Мен көремін.
Dialogue: 0,0:13:02.25,0:13:05.00,Default - Copy,Yoma,0,0,0,,Артықшылыққа ие болып көрінген кезде
Dialogue: 0,0:13:05.00,0:13:08.34,Default - Copy,Yoma,0,0,0,,Сонымен, сіз бәрін бірден аяқтағыңыз келді ме?
Dialogue: 0,0:13:08.64,0:13:12.24,Default - Copy,Yoma,0,0,0,,Мен ұзақ соғысты қаламаймын.
Dialogue: 0,0:13:12.61,0:13:14.27,Default - Copy,Yoma,0,0,0,,Бұл сәтсіздік болды.
Dialogue: 0,0:13:14.27,0:13:20.98,Default - Copy,Yoma,0,0,0,,Менің ойымша, ол қолымен емес, бірінші соққымен басын алып тастағысы келді.
Dialogue: 0,0:13:23.52,0:13:25.50,Default - Copy,Yoma,0,0,0,,Қараңдар, мен дұрыс түсіндім.
Dialogue: 0,0:13:25.50,0:13:27.52,Default - Copy,Yoma,0,0,0,,Бұл ойдан бас тартатын уақыт емес.
Dialogue: 0,0:13:28.39,0:13:29.52,Default - Copy,Yoma,0,0,0,,Ой
Dialogue: 0,0:13:34.26,0:13:37.20,Default - Copy,Yoma,0,0,0,,Сіз қалай ойлайсыз? Көрініс жақсы ма?
Dialogue: 0,0:13:37.20,0:13:40.77,Default - Copy,Yoma,0,0,0,,Бірақ мен биіктікте жақсы емес сияқтымын.
Dialogue: 0,0:13:43.22,0:13:45.59,Default - Copy,Yoma,0,0,0,,Көп дүрбелеңге түспеңіз
Dialogue: 0,0:13:45.59,0:13:48.49,Default - Copy,Yoma,0,0,0,,Мен сені бірден түсіріп жіберемін.
Dialogue: 0,0:13:49.14,0:13:50.38,Default - Copy,Yoma,0,0,0,,Өл
Dialogue: 0,0:13:54.57,0:13:55.62,Default - Copy,Sid,0,0,0,,Гарк
Dialogue: 0,0:14:03.53,0:14:05.14,Default - Copy,Galk,0,0,0,,Жақсысың ба, әйел?
Dialogue: 0,0:14:05.14,0:14:06.16,Default - Copy,Galk,0,0,0,,Сіз тұра аласыз ба?
Dialogue: 0,0:14:08.23,0:14:11.36,Default - Copy,Galk,0,0,0,,Әйел Бұл біздің ең жақсымыз.
Dialogue: 0,0:14:11.74,0:14:14.90,Default - Copy,Galk,0,0,0,,Сіз айтқандай, біз тіпті бір-бірімізбен жарыса алмаймыз.
Dialogue: 0,0:14:15.95,0:14:19.64,Default - Copy,Galk,0,0,0,,Егер бұл біздің өміріміз болса, оларды қалай пайдаланатыныңыз бізге маңызды емес.
Dialogue: 0,0:14:20.01,0:14:23.17,Default - Copy,Galk,0,0,0,,Өтінемін, оны жеңіңіз.
Dialogue: 0,0:14:25.98,0:14:26.98,Default - Copy,Sid,0,0,0,,Тамақтану
Dialogue: 0,0:14:41.83,0:14:44.73,Default - Copy,Yoma,0,0,0,,Сіз ерекше шабуылмен бірдеңе істей аламын деп ойладыңыз ба?
Dialogue: 0,0:14:45.12,0:14:47.23,Default - Copy,Yoma,0,0,0,,Ақымақ жігіт
Dialogue: 0,0:14:48.90,0:14:50.00,Default - Copy,Galk,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:14:50.06,0:14:51.83,Default - Copy,Galk,0,0,0,,Уууууууу!!
Dialogue: 0,0:15:00.77,0:15:03.99,Default - Copy,Galk,0,0,0,,Өкінішке орай, олар ақымақ болды.
Dialogue: 0,0:15:03.99,0:15:05.22,Default - Copy,Yoma,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:15:17.76,0:15:18.62,Default - Copy,Clare,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:15:18.62,0:15:19.50,Default - Copy,Clare,0,0,0,,Өздігінен
Dialogue: 0,0:15:19.50,0:15:21.23,Default - Copy,Yoma,0,0,0,,Мен оны сағындым.
Dialogue: 0,0:15:21.23,0:15:23.70,Default - Copy,Yoma,0,0,0,,Қылышыңды оңға, солға тартсаң да
Dialogue: 0,0:15:23.70,0:15:26.01,Default - Copy,Yoma,0,0,0,,Ол сіздің маңызды нүктелеріңізге жетпейді.
Dialogue: 0,0:15:26.50,0:15:27.64,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:15:34.89,0:15:36.72,Default - Copy,Clare,0,0,0,,Өмірлік нүкте бас болып табылады ма?
Dialogue: 0,0:15:53.27,0:15:54.44,Default - Copy,Raki,0,0,0,,Яй Клэр
Dialogue: 0,0:15:55.44,0:15:58.17,Default - Copy,Sid,0,0,0,,Мұны істеген әйел
Dialogue: 0,0:15:59.31,0:16:00.99,Default - Copy,Galk,0,0,0,,Клеймор?
Dialogue: 0,0:16:01.45,0:16:02.91,Default - Copy,Galk,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:16:11.94,0:16:12.77,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:16:12.77,0:16:13.94,Default - Copy,Raki,0,0,0,,Жарайды
Dialogue: 0,0:16:13.94,0:16:15.07,Default - Copy,Raki,0,0,0,,Мықты болыңыз
Dialogue: 0,0:16:15.07,0:16:16.72,Default - Copy,Raki,0,0,0,,Клэр Даиджо
Dialogue: 0,0:16:21.37,0:16:22.23,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:16:25.32,0:16:26.23,Default - Copy,Clare,0,0,0,,Қолымнан келгеннің бәрін жасадым
Dialogue: 0,0:16:26.62,0:16:27.69,Default - Copy,Clare,0,0,0,,Қайту мүмкін емес
Dialogue: 0,0:16:40.01,0:16:41.30,Default - Copy,Raki,0,0,0,,Клэр, не болды?
Dialogue: 0,0:16:45.78,0:16:46.90,Default - Copy,Raki,0,0,0,,Бұл не?
Dialogue: 0,0:16:46.90,0:16:48.43,Default - Copy,Raki,0,0,0,,Нені көшіріп жатырсың, Клэр?
Dialogue: 0,0:16:48.76,0:16:52.56,Default - Copy,Clare,0,0,0,,Зақым келтіру кезінде тым көп сиқырлы күш қолданылды
Dialogue: 0,0:16:53.37,0:16:57.38,Default - Copy,Clare,0,0,0,,Мен бұл бейітті жалғыз тоқтата алмаймын деп ойлаймын.
Dialogue: 0,0:17:00.87,0:17:04.71,Default - Copy,Clare,0,0,0,,Демек, біз адам ретінде саналы болсақ,
Dialogue: 0,0:17:04.71,0:17:06.67,Default - Copy,Clare,0,0,0,,Өз өмірін аяқтау
Dialogue: 0,0:17:07.11,0:17:08.67,Default - Copy,Raki,0,0,0,,Сіз не туралы айтып тұрсыз?
Dialogue: 0,0:17:08.67,0:17:09.41,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:17:11.91,0:17:13.15,Default - Copy,Clare,0,0,0,,Қоштасу
Dialogue: 0,0:17:13.53,0:17:14.38,Default - Copy,Raki,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:17:16.56,0:17:17.26,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:17:17.26,0:17:18.12,Default - Copy,Clare,0,0,0,,Жақынбаңыз
Dialogue: 0,0:17:19.52,0:17:21.86,Default - Copy,Clare,0,0,0,,Гарк сұрайды
Dialogue: 0,0:17:25.38,0:17:26.37,Default - Copy,Clare,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:17:26.80,0:17:28.10,Default - Copy,Clare,0,0,0,,Тез сұраңыз
Dialogue: 0,0:17:31.78,0:17:32.69,Default - Copy,Raki,0,0,0,,Бұл не?
Dialogue: 0,0:17:33.01,0:17:33.84,Default - Copy,Raki,0,0,0,,Бұл қандай ақша?
Dialogue: 0,0:17:34.90,0:17:36.18,Default - Copy,Clare,0,0,0,,Раки нашар
Dialogue: 0,0:17:36.94,0:17:39.09,Default - Copy,Clare,0,0,0,,Мен енді қайтып бара алмаймын.
Dialogue: 0,0:17:39.09,0:17:40.01,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:17:41.12,0:17:44.74,Default - Copy,Clare,0,0,0,,Сиқырлы күшті қолдануды жалғастыра отырып, біз
Dialogue: 0,0:17:44.74,0:17:46.64,Default - Copy,Clare,0,0,0,,Жынға жақындау
Dialogue: 0,0:17:47.42,0:17:48.08,Default - Copy,Clare,0,0,0,,Бірақ
Dialogue: 0,0:17:48.70,0:17:50.29,Default - Copy,Clare,0,0,0,,Бұл бірте-бірте емес
Dialogue: 0,0:17:50.78,0:17:53.79,Default - Copy,Clare,0,0,0,,Бір күні сіз кенеттен шегіңізге жетуіңіз мүмкін.
Dialogue: 0,0:17:56.43,0:17:57.33,Default - Copy,Raki,0,0,0,,Шынында, сол сырғаң өте батыл екен.
Dialogue: 0,0:17:58.10,0:18:02.33,Default - Copy,Clare,0,0,0,,Жынға айналған денемді әрең ұстап тұрмын.
Dialogue: 0,0:18:03.78,0:18:05.65,Default - Copy,Clare,0,0,0,,Қош бол, Раки
Dialogue: 0,0:18:08.91,0:18:10.16,Default - Copy,Clare,0,0,0,,Қандай еліктеу?
Dialogue: 0,0:18:10.16,0:18:10.84,Default - Copy,Clare,0,0,0,,Өлгің келе ме?
Dialogue: 0,0:18:12.93,0:18:14.01,Default - Copy,Clare,0,0,0,,Рақидан сұра
Dialogue: 0,0:18:14.66,0:18:15.94,Default - Copy,Clare,0,0,0,,Мені жіберіңізші
Dialogue: 0,0:18:15.94,0:18:16.84,Default - Copy,Clare,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:18:17.51,0:18:18.31,Default - Copy,Clare,0,0,0,,бетін таныған адамның атын жазсаң, сол адам өліп қалады деген дәптер екенін айтты
Dialogue: 0,0:18:18.85,0:18:20.62,Default - Copy,Clare,0,0,0,,Адамдардың надандығынан қорқамын.
Dialogue: 0,0:18:21.19,0:18:21.95,Default - Copy,Clare,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:18:23.64,0:18:27.96,Default - Copy,Raki,0,0,0,,Мен Клэрмен бірге саяхаттағаныма қуаныштымын.
Dialogue: 0,0:18:29.65,0:18:31.56,Default - Copy,Raki,0,0,0,,Ата-анасы мен бауырлары өлтірілді
Dialogue: 0,0:18:31.56,0:18:33.14,Default - Copy,Raki,0,0,0,,Ауыл тастап кеткен
Dialogue: 0,0:18:33.86,0:18:37.97,Default - Copy,Raki,0,0,0,,Менің барлық жақындарым бірге кетті.
Dialogue: 0,0:18:39.04,0:18:40.72,Default - Copy,Raki,0,0,0,,Сондықтан мен бақытты болдым
Dialogue: 0,0:18:41.29,0:18:44.32,Default - Copy,Raki,0,0,0,,Мен Клэрмен бірге саяхаттауға мүмкіндігім болған кезде
Dialogue: 0,0:18:44.32,0:18:47.48,Default - Copy,Raki,0,0,0,,Ең бастысы, бірге болатын адамның болуы
Dialogue: 0,0:18:48.62,0:18:52.33,Default - Copy,Raki,0,0,0,,Клэр өзіне мейірімді емес екенін айтты.
Dialogue: 0,0:18:52.75,0:18:57.49,Default - Copy,Raki,0,0,0,,Ол маған басқа адамдарға қарағанда әлдеқайда мейірімді болды.
Dialogue: 0,0:18:57.86,0:18:59.69,Default - Copy,Raki,0,0,0,,Сондықтан
Dialogue: 0,0:19:00.00,0:19:01.83,Default - Copy,Raki,0,0,0,,Басқа ешкім жоқ
Dialogue: 0,0:19:02.39,0:19:04.63,Default - Copy,Raki,0,0,0,,Мен мәңгілікке Клэрдің қасында болғым келеді.
Dialogue: 0,0:19:06.11,0:19:09.23,Default - Copy,Raki,0,0,0,,Клэр өлсе, мен онымен бірге барамын.
Dialogue: 0,0:19:44.60,0:19:47.47,Default - Copy,Clare,0,0,0,,Аруақтардың моласы тоқтады.
Dialogue: 0,0:19:49.13,0:19:50.01,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:19:54.80,0:19:55.73,Default - Copy,Galk,0,0,0,,Таку
Dialogue: 0,0:19:55.73,0:19:57.34,Default - Copy,Galk,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:19:59.23,0:20:01.74,Default - Copy,Sid,0,0,0,,Ол жынға айналған жоқ.
Dialogue: 0,0:20:02.32,0:20:04.49,Default - Copy,Sid,0,0,0,,Мұның бәрі бар.
Dialogue: 0,0:20:05.31,0:20:07.07,Default - Copy,Galk,0,0,0,,Мен ақыры құтқарылдым.
Dialogue: 0,0:20:07.66,0:20:09.06,Default - Copy,Galk,0,0,0,,Сол балаға
Dialogue: 0,0:20:12.99,0:20:13.96,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:20:14.51,0:20:15.65,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:20:21.01,0:20:23.37,Default - Copy,Clare,0,0,0,,Барлық көмектеріңіз үшін рахмет, діни қызметкер.
Dialogue: 0,0:20:23.37,0:20:25.06,Default - Copy,Vincent,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:20:25.06,0:20:28.31,Default - Copy,Vincent,0,0,0,,Бізге көмектескен.
Dialogue: 0,0:20:28.31,0:20:30.11,Default - Copy,Clare,0,0,0,,Өйткені бұл миссия.
Dialogue: 0,0:20:31.26,0:20:35.14,Default - Copy,Vincent,0,0,0,,Сонымен қатар, Раки-санды осында ұстау туралы.
Dialogue: 0,0:20:35.14,0:20:38.35,Default - Copy,Vincent,0,0,0,,Епископ бұған мейірімділікпен келісті.
Dialogue: 0,0:20:38.35,0:20:39.12,Default - Copy,Raki,0,0,0,,Иә
Dialogue: 0,0:20:39.82,0:20:40.86,Default - Copy,Raki,0,0,0,,Клэр
Dialogue: 0,0:20:43.11,0:20:45.36,Default - Copy,Clare,0,0,0,,Менімен келесің бе? Раки
Dialogue: 0,0:20:46.36,0:20:47.23,Default - Copy,Raki,0,0,0,,Иә
Dialogue: 0,0:20:47.23,0:20:48.56,Default - Copy,Sid,0,0,0,,Аты...
Dialogue: 0,0:20:51.18,0:20:52.73,Default - Copy,Galk,0,0,0,,Мұны өзіңізбен бірге алыңыз.
Dialogue: 0,0:20:59.34,0:21:00.16,Default - Copy,Galk,0,0,0,,Әйел
Dialogue: 0,0:21:00.60,0:21:01.71,Default - Copy,Galk,0,0,0,,Өлме
Dialogue: 0,0:21:04.21,0:21:05.71,Default - Copy,Clare,0,0,0,,Рақиға барайық
Dialogue: 0,0:21:05.71,0:21:06.95,Default - Copy,Raki,0,0,0,,Иә
Dialogue: 0,0:21:07.86,0:21:08.72,Default - Copy,Sid,0,0,0,,Аты...
Dialogue: 0,0:21:09.38,0:21:10.74,Default - Copy,Sid,0,0,0,,Мықты бол
Dialogue: 0,0:21:11.07,0:21:14.96,Default - Copy,Sid,0,0,0,,Маған Клэрді қолдауға жеткілікті күшті екеніңізді көрсетіңіз.
Dialogue: 0,0:21:14.96,0:21:16.20,Default - Copy,Raki,0,0,0,,О
Dialogue: 0,0:21:16.20,0:21:18.06,Default - Copy,Raki,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:22:40.65,0:22:43.00,Default - Copy,,0,0,0,,Үмітсіздік пен айқайлау
Dialogue: 0,0:22:43.00,0:22:45.61,Default - Copy,,0,0,0,,Жаңа қан теңізінде
Dialogue: 0,0:22:45.74,0:22:50.01,Default - Copy,,0,0,0,,Күлімсіреу пайда болады
Dialogue: 0,0:22:51.51,0:22:57.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory