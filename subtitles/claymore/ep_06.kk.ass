Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Клэр ше?
Dialogue: 0,0:00:06.09,0:00:11.04,Default,,0,0,0,,Сұлу, таза, махаббатқа толы егіз құдайлардың аты.
Dialogue: 0,0:00:12.04,0:00:16.02,Default,,0,0,0,,Қайтыс болған ата-анаңның сезімдері сенің атыңда мәңгі сақталады.
Dialogue: 0,0:00:17.02,0:00:18.01,Default,,0,0,0,,Олай болса кеттік.
Dialogue: 0,0:01:35.02,0:01:36.02,Default,,0,0,0,,Сәлем Клэр
Dialogue: 0,0:01:36.07,0:01:37.06,Default,,0,0,0,,Келіңіз және көріңіз
Dialogue: 0,0:01:42.01,0:01:43.07,Default,,0,0,0,,Бұл Рокуто қаласы.
Dialogue: 0,0:01:44.02,0:01:46.00,Default,,0,0,0,,Мен ертең кешке келемін.
Dialogue: 0,0:01:46.07,0:01:48.07,Default,,0,0,0,,Бұл менің сенімен қоштасуым.
Dialogue: 0,0:01:50.04,0:01:51.08,Default,,0,0,0,,Бұл бетті жасамаңыз
Dialogue: 0,0:01:52.03,0:01:55.02,Default,,0,0,0,,Сіз менімен әлдеқайда бақытты боласыз.
Dialogue: 0,0:01:58.02,0:01:59.06,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:02:00.00,0:02:04.00,Default,,0,0,0,,Мен сені қалаға жеткенің үшін бірден қуып жібермеймін.
Dialogue: 0,0:02:04.06,0:02:06.05,Default,,0,0,0,,Мен қамқор болатын адам табамын.
Dialogue: 0,0:02:07.01,0:02:08.01,Default,,0,0,0,,(Ино Хацусе) Қош келдіңіздер, Элькия патшасы, Лорд Сора, Лорд Широ.
Dialogue: 0,0:02:19.03,0:02:21.04,Default,,0,0,0,,Ұйықтаймын деп жылап алдың ба?
Dialogue: 0,0:02:22.05,0:02:24.00,Default,,0,0,0,,Қызықты жігіт
Dialogue: 0,0:02:24.05,0:02:29.00,Default,,0,0,0,,Менен осылай бөлініп кеткеніңе ұзақ жыладың.
Dialogue: 0,0:02:30.04,0:02:34.02,Default,,0,0,0,,Мен Рокуто қаласында қандай адам болсам да.
Dialogue: 0,0:02:34.09,0:02:37.01,Default,,0,0,0,,Бұл менімен болғаннан әлдеқайда жақсы.
Dialogue: 0,0:02:38.00,0:02:42.00,Default,,0,0,0,,Ең болмаса адам болып өмір сүре аласың.
Dialogue: 0,0:02:44.03,0:02:45.02,Default,,0,0,0,,♪ Ка-та-на
Dialogue: 0,0:02:57.06,0:02:58.05,Default,,0,0,0,,Жарайды, екеу болсын.
Dialogue: 0,0:02:58.05,0:03:00.00,Default,,0,0,0,,Бұл бір нәрсе үшін бе?
Dialogue: 0,0:03:01.07,0:03:05.00,Default,,0,0,0,,Э? Қайда?
Dialogue: 0,0:03:05.03,0:03:06.07,Default,,0,0,0,,Мен бұны шатастырып жатырмын
Dialogue: 0,0:03:07.03,0:03:09.03,Default,,0,0,0,,Мен сенің артымнан келе жатқаныңды білдім.
Dialogue: 0,0:03:10.00,0:03:12.07,Default,,0,0,0,,Өзіңізге дұрыс күтім жасап, қамқорлық жасасаңыз,
Dialogue: 0,0:03:12.07,0:03:16.01,Default,,0,0,0,,Бактериялар жара арқылы енген жоқ.
Dialogue: 0,0:03:18.06,0:03:22.07,Default,,0,0,0,,Кек алу үшін менің өмірімді алмақ болсаң, олай етпе.
Dialogue: 0,0:03:23.03,0:03:28.06,Default,,0,0,0,,Ережелер қаншалықты қатал болса да, егер сіздің өміріңізге қауіп төнсе, сіз табиғи түрде күресесіз.
Dialogue: 0,0:03:30.02,0:03:32.02,Default,,0,0,0,,Мен мұны білемін
Dialogue: 0,0:03:32.07,0:03:34.06,Default,,0,0,0,,Өмірді мақсат етпе
Dialogue: 0,0:03:35.01,0:03:36.03,Default,,0,0,0,,Өмір
Dialogue: 0,0:03:36.03,0:03:37.03,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:03:38.04,0:03:40.03,Default,,0,0,0,,Мен оны шатастырып аламын.
Dialogue: 0,0:03:40.03,0:03:43.02,Default,,0,0,0,,Өзіңіздің мақтанышыңыз бен құрметіңізді мұқият сақтаңыз.
Dialogue: 0,0:03:44.00,0:03:45.03,Default,,0,0,0,,Такада мырза, жағдайыңыз қалай?
Dialogue: 0,0:03:45.08,0:03:46.09,Default,,0,0,0,,Менің денем
Dialogue: 0,0:03:46.09,0:03:48.09,Default,,0,0,0,,Қарсысыз ба?
Dialogue: 0,0:03:48.09,0:03:51.09,Default,,0,0,0,,Мен сені ұятқа қалдыруым керек.
Dialogue: 0,0:03:52.03,0:03:56.06,Default,,0,0,0,,Мен мұңайғаным сонша, енді шыдай алмаймын.
Dialogue: 0,0:03:58.01,0:03:59.05,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:04:00.05,0:04:02.02,Default,,0,0,0,,Міне, сондықтан да адамдар
Dialogue: 0,0:04:03.09,0:04:08.02,Default,,0,0,0,,Біз кім үшін күресеміз?
Dialogue: 0,0:04:09.00,0:04:12.01,Default,,0,0,0,,Маған ол жүзі басынан ұнамады.
Dialogue: 0,0:04:12.01,0:04:15.05,Default,,0,0,0,,Сол кісіге менсінбей қараған түрі есімде.
Dialogue: 0,0:04:16.03,0:04:21.00,Default,,0,0,0,,Мен сіздің қуыршақтай бетіңізді ренжітіп, бұрмалаймын.
Dialogue: 0,0:04:29.00,0:04:30.05,Default,,0,0,0,,Бұл бала
Dialogue: 0,0:04:30.05,0:04:32.03,Default,,0,0,0,,Әзіл!
Dialogue: 0,0:04:34.06,0:04:36.07,Default,,0,0,0,,Менімен араласпа, қарғыс атқыр бала.
Dialogue: 0,0:04:36.07,0:04:37.08,Default,,0,0,0,,Ақымақ болма.
Dialogue: 0,0:04:39.01,0:04:40.09,Default,,0,0,0,,Мен сені өлтірейін бе?
Dialogue: 0,0:04:46.07,0:04:48.09,Default,,0,0,0,,Менің қанжарымды не істейсің?
Dialogue: 0,0:04:50.00,0:04:53.07,Default,,0,0,0,,Мені өлтірсең, олар сенің басыңды нысанаға алатын шығар.
Dialogue: 0,0:04:53.07,0:04:56.00,Default,,0,0,0,,Бұл темір заң, солай ма?
Dialogue: 0,0:04:56.00,0:04:57.08,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:04:57.08,0:05:00.06,Default,,0,0,0,,Сіз дұрыс түсінбеген сияқтысыз, сондықтан айтайын.
Dialogue: 0,0:05:01.03,0:05:03.02,Default,,0,0,0,,Ереже жай ғана ереже
Dialogue: 0,0:05:03.02,0:05:06.01,Default,,0,0,0,,Қорғау немесе қорғамау әр адамның өз еркінде.
Dialogue: 0,0:05:06.01,0:05:07.08,Default,,0,0,0,,Өсиеттерді орында
Dialogue: 0,0:05:08.02,0:05:11.01,Default,,0,0,0,,Ережені бұзып, достарың өлтіру
Dialogue: 0,0:05:12.02,0:05:14.02,Default,,0,0,0,,Бұл біздің еркіндігіміз
Dialogue: 0,0:05:17.07,0:05:18.04,Default,,0,0,0,,«Бұрын ол жетімдер үйін басқарған».
Dialogue: 0,0:05:18.09,0:05:21.04,Default,,0,0,0,,Мен сені өлтіруімді қаламасаң.
Dialogue: 0,0:05:26.06,0:05:27.09,Default,,0,0,0,,Бұл менің кінәм.
Dialogue: 0,0:05:31.06,0:05:33.04,Default,,0,0,0,,Сен тұра аласың ба, Клэр?
Dialogue: 0,0:05:40.00,0:05:41.03,Default,,0,0,0,,Ой
Dialogue: 0,0:05:45.08,0:05:46.08,Default,,0,0,0,,Клэр
Dialogue: 0,0:05:47.09,0:05:52.07,Default,,0,0,0,,Көп нәрсе
Dialogue: 0,0:05:54.02,0:05:56.06,Default,,0,0,0,,Сіз сөйлей аласыз ба?
Dialogue: 0,0:05:57.08,0:06:00.06,Default,,0,0,0,,Бұл әрқашан ауыр болды.
Dialogue: 0,0:06:02.08,0:06:05.06,Default,,0,0,0,,Түсіндім, сіз бұл туралы айтып отырсыз ба?
Dialogue: 0,0:06:06.01,0:06:07.03,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:06:07.07,0:06:10.02,Default,,0,0,0,,Бұл қорқынышты көрінеді, бірақ ол ауырмайды.
Dialogue: 0,0:06:10.06,0:06:12.01,Default,,0,0,0,,Бұл жай ғана осылай көрінеді.
Dialogue: 0,0:06:12.01,0:06:16.09,Default,,0,0,0,,Содан бері Терезаның көзі үнемі ауырады.
Dialogue: 0,0:06:17.03,0:06:21.01,Default,,0,0,0,,Ауырды, ауырды, шыдамайтындай көрінді.
Dialogue: 0,0:06:22.04,0:06:25.05,Default,,0,0,0,,Оның көзі менімен бірдей еді.
Dialogue: 0,0:06:26.01,0:06:30.08,Default,,0,0,0,,Жан азапты, жалғыздықты, шыдай алмайтындай көріндің.
Dialogue: 0,0:06:31.03,0:06:33.04,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:06:36.04,0:06:40.04,Default,,0,0,0,,Құшақтаған мен болдым.
Dialogue: 0,0:06:41.02,0:06:43.06,Default,,0,0,0,,Қымбат бір нәрсені жын алып кетті
Dialogue: 0,0:06:43.06,0:06:45.05,Default,,0,0,0,,Сенетін адамдарыңның сатқындығы
Dialogue: 0,0:06:45.05,0:06:46.06,Default,,0,0,0,,Тастанды
Dialogue: 0,0:06:48.00,0:06:51.09,Default,,0,0,0,,Әр жерге өмір сүру мүмкіндігінен айырылғандар келді
Dialogue: 0,0:06:52.05,0:06:57.04,Default,,0,0,0,,Бір жағдайда бірге күтудің жан азабы
Dialogue: 0,0:06:58.00,0:07:01.08,Default,,0,0,0,,Сол кезде менің кішкентай денем қорқыныштан дірілдеп тұратын.
Dialogue: 0,0:07:02.02,0:07:07.02,Default,,0,0,0,,Сіз өзіңіз сияқты ренжіген адамды бар күшіңізбен құшақтап тұрмын дейсіз бе?
Dialogue: 0,0:07:08.03,0:07:15.01,Default,,0,0,0,,Міне, мен өзіме де осыны қаладым.
Dialogue: 0,0:07:19.03,0:07:22.09,Default,,0,0,0,,Денесі менің жарты өлшемімде болатын кішкентай қыз
Dialogue: 0,0:07:24.00,0:07:25.08,Default,,0,0,0,,Тіпті күміс көздерден
Dialogue: 0,0:07:26.06,0:07:28.05,Default,,0,0,0,,Көз жасын шығара білу
Dialogue: 0,0:07:29.02,0:07:31.02,Default,,0,0,0,,Мені үйретті
Dialogue: 0,0:07:40.07,0:07:42.03,Default,,0,0,0,,О, саған жарасады, солай емес пе?
Dialogue: 0,0:07:42.09,0:07:44.00,Default,,0,0,0,,Мұны істейік
Dialogue: 0,0:07:46.00,0:07:47.03,Default,,0,0,0,,Бірақ бұл
Dialogue: 0,0:07:47.03,0:07:49.07,Default,,0,0,0,,Уайымдама, бізде ақша бар
Dialogue: 0,0:07:50.04,0:07:52.07,Default,,0,0,0,,Мен Roku-ны өз бетімше қолдана алар едім.
Dialogue: 0,0:07:53.02,0:07:56.07,Default,,0,0,0,,Ендеше, онымен барайық.
Dialogue: 0,0:08:06.00,0:08:07.06,Default,,0,0,0,,Керемет
Dialogue: 0,0:08:07.09,0:08:09.07,Default,,0,0,0,,Бір ғана соққымен
Dialogue: 0,0:08:09.07,0:08:11.08,Default,,0,0,0,,А, бұл саз балшық па?
Dialogue: 0,0:08:13.01,0:08:14.06,Default,,0,0,0,,Рахмет
Dialogue: 0,0:08:14.06,0:08:18.08,Default,,0,0,0,,Мен сенен жынды тез жояды деп ойламаппын.
Dialogue: 0,0:08:18.08,0:08:19.09,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:08:20.02,0:08:21.03,Default,,0,0,0,,Бұл жай ғана миссия.
Dialogue: 0,0:08:21.03,0:08:26.03,Default,,0,0,0,,Өйткені, мұндай таулармен қоршалған қалада қашып құтылудың жолы жоқ.
Dialogue: 0,0:08:26.03,0:08:30.03,Default,,0,0,0,,О, бұл уәде етілген сый.
Dialogue: 0,0:08:31.01,0:08:34.01,Default,,0,0,0,,Оны кейінірек алуға қара киінген адам келеді.
Dialogue: 0,0:08:35.01,0:08:37.01,Default,,0,0,0,,Оған беріңіз.
Dialogue: 0,0:08:37.09,0:08:39.00,Default,,0,0,0,,Ах ха
Dialogue: 0,0:08:39.03,0:08:40.01,Default,,0,0,0,,Тереза
Dialogue: 0,0:08:42.07,0:08:43.09,Default,,0,0,0,,Менің бір өтінішім бар.
Dialogue: 0,0:08:46.09,0:08:50.09,Default,,0,0,0,,Мына жігітті осы қалада қалдыра аласыз ба?
Dialogue: 0,0:08:52.03,0:08:54.04,Default,,0,0,0,,Кешіріңіз, бірақ бала
Dialogue: 0,0:08:55.00,0:08:57.02,Default,,0,0,0,,Бұл менің сапарымда көтеріп алған балам.
Dialogue: 0,0:08:57.09,0:09:00.02,Default,,0,0,0,,Менің қасымда болғаның үшін сен жын емессің.
Dialogue: 0,0:09:00.07,0:09:03.07,Default,,0,0,0,,Мен ата-анамнан айырылдым, басқа туыстарым жоқ.
Dialogue: 0,0:09:04.04,0:09:07.04,Default,,0,0,0,,Бала алғысы келетіндер де болса, риза болар едім.
Dialogue: 0,0:09:09.00,0:09:12.01,Default,,0,0,0,,Өйткені ол бастапқыда тауда, балалары аз қала.
Dialogue: 0,0:09:12.01,0:09:15.01,Default,,0,0,0,,Оны қалайтындар бар деп ойлаймын.
Dialogue: 0,0:09:15.01,0:09:16.08,Default,,0,0,0,,Бұл ыңғайлы.
Dialogue: 0,0:09:17.04,0:09:18.01,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:09:25.02,0:09:26.01,Default,,0,0,0,,Клэр
Dialogue: 0,0:09:26.06,0:09:27.01,Default,,0,0,0,,Қажет емес
Dialogue: 0,0:09:28.04,0:09:30.01,Default,,0,0,0,,Бұл бізге керек емес.
Dialogue: 0,0:09:31.04,0:09:33.01,Default,,0,0,0,,Әдемі киім
Dialogue: 0,0:09:33.01,0:09:34.06,Default,,0,0,0,,Әдемі аяқ киім де
Dialogue: 0,0:09:34.06,0:09:36.01,Default,,0,0,0,,Маған ештеңе керек емес
Dialogue: 0,0:09:36.04,0:09:38.04,Default,,0,0,0,,Ендеше мен сенімен бірге болуға рұқсат етемін
Dialogue: 0,0:09:39.00,0:09:42.01,Default,,0,0,0,,Мен Терезамен мәңгі бірге болғым келеді.
Dialogue: 0,0:09:42.07,0:09:44.08,Default,,0,0,0,,Өйткені маған басқа ештеңе керек емес
Dialogue: 0,0:09:46.06,0:09:47.07,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:09:47.07,0:09:49.04,Default,,0,0,0,,Терезаны өтінемін
Dialogue: 0,0:09:49.04,0:09:50.02,Default,,0,0,0,,Мен
Dialogue: 0,0:09:52.06,0:09:53.04,Default,,0,0,0,,Клэр
Dialogue: 0,0:09:54.00,0:09:57.03,Default,,0,0,0,,Көріп отырғаныңыздай, менің жұмысым жындарды өлтіру.
Dialogue: 0,0:09:57.08,0:10:01.01,Default,,0,0,0,,Басқа істеуге ештеңе жоқ, бар болу үшін ешқандай себеп жоқ.
Dialogue: 0,0:10:02.01,0:10:02.51,Default,,0,0,0,,Бірақ
Dialogue: 0,0:10:03.04,0:10:07.08,Default,,0,0,0,,Ақырында, мен сені жұмысқа қосып, қауіп төндіремін.
Dialogue: 0,0:10:08.06,0:10:12.07,Default,,0,0,0,,Өйткені, сіз бен біз әртүрлі әлемде өмір сүреміз.
Dialogue: 0,0:10:16.05,0:10:18.06,Default,,0,0,0,,Басқалар арасында адам сияқты өмір сүр
Dialogue: 0,0:10:20.04,0:10:21.07,Default,,0,0,0,,Танысқаныма қуаныштымын
Dialogue: 0,0:10:22.01,0:10:24.00,Default,,0,0,0,,Мен сені ұмытпаймын
Dialogue: 0,0:10:26.01,0:10:27.03,Default,,0,0,0,,Тереза
Dialogue: 0,0:10:27.03,0:10:29.04,Default,,0,0,0,,I I
Dialogue: 0,0:10:30.07,0:10:34.01,Default,,0,0,0,,Клэр сияқты бақытты бол
Dialogue: 0,0:10:39.08,0:10:41.03,Default,,0,0,0,,Қара, қара!
Dialogue: 0,0:10:41.03,0:10:45.07,Default,,0,0,0,,Қыздар көпшілік алдында жалаңаш жүрмеуі керек.
Dialogue: 0,0:10:45.07,0:10:47.08,Default,,0,0,0,,Қараңдаршы, мына киімдер сүйкімді емес пе?
Dialogue: 0,0:10:53.04,0:10:55.05,Default,,0,0,0,,Олай болса, өтінемін
Dialogue: 0,0:10:56.00,0:10:57.02,Default,,0,0,0,,Мақсаттының екінші ұлы
Dialogue: 0,0:10:57.06,0:11:00.05,Default,,0,0,0,,Мен бұл баланың бақытсыздыққа ұшырауына ешқашан жол бермеймін.
Dialogue: 0,0:11:06.09,0:11:08.00,Default,,0,0,0,,Клэр
Dialogue: 0,0:11:08.09,0:11:11.02,Default,,0,0,0,,Басқалар арасында тұлға ретінде өмір сүріңіз
Dialogue: 0,0:11:12.03,0:11:16.07,Default,,0,0,0,,Мен қалаған дүние бар, мен саған ешқашан бере алмаймын.
Dialogue: 0,0:11:17.04,0:11:22.07,Default,,0,0,0,,Онда адам болып өмір сүр, адам болып өмір сүр, адам болып өл.
Dialogue: 0,0:11:24.00,0:11:29.03,Default,,0,0,0,,Адам үшін ең бақыттысы да осы болса керек.
Dialogue: 0,0:11:31.07,0:11:33.07,Default,,0,0,0,,Қоштасу Клэр
Dialogue: 0,0:11:55.07,0:11:56.08,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:12:03.04,0:12:04.04,Default,,0,0,0,,Бұл абайсызда болды.
Dialogue: 0,0:12:04.08,0:12:07.09,Default,,0,0,0,,Таудың тереңінде ұрыны кездестіру біртүрлі деп ойладым.
Dialogue: 0,0:12:08.05,0:12:10.09,Default,,0,0,0,,Олар әу бастан артымызда болды.
Dialogue: 0,0:12:12.00,0:12:14.03,Default,,0,0,0,,Таудың тереңінде, Ешкім бармайды
Dialogue: 0,0:12:14.03,0:12:16.03,Default,,0,0,0,,Қашып құтыла алмайтын қала
Dialogue: 0,0:12:16.03,0:12:19.07,Default,,0,0,0,,Алайда мен қалада жын бар екенін білдім.
Dialogue: 0,0:12:19.07,0:12:20.09,Default,,0,0,0,,Мен оған көмектесе алмадым
Dialogue: 0,0:12:21.08,0:12:25.00,Default,,0,0,0,,Осылайша, жындар - бұл қаланың тосқауылдары.
Dialogue: 0,0:12:25.02,0:12:27.03,Default,,0,0,0,,Мен оны жойдым
Dialogue: 0,0:12:35.06,0:12:37.02,Default,,0,0,0,,Жоқ, жасама!
Dialogue: 0,0:12:46.05,0:12:47.03,Default,,0,0,0,,Клэр
Dialogue: 0,0:12:48.02,0:12:49.02,Default,,0,0,0,,Клэр
Dialogue: 0,0:12:49.04,0:12:50.08,Default,,0,0,0,,Ер адамды өлтіріңіз
Dialogue: 0,0:12:50.08,0:12:52.04,Default,,0,0,0,,Әйелді ұрлау
Dialogue: 0,0:12:52.04,0:12:55.00,Default,,0,0,0,,Барлығын алып кетіңіз
Dialogue: 0,0:12:56.01,0:13:00.02,Default,,0,0,0,,Күміс көзді бақсының арқасында мен алаңсыз жұмыс істей аламын.
Dialogue: 0,0:13:00.07,0:13:04.04,Default,,0,0,0,,Біз үшін ол бақсыдан гөрі әулие.
Dialogue: 0,0:13:12.07,0:13:15.06,Default,,0,0,0,,Оған сол қашықтықтан қалай жетуге болады?
Dialogue: 0,0:13:16.07,0:13:21.09,Default,,0,0,0,,Менің сұңқар қылышым жеңілмейді.
Dialogue: 0,0:13:31.09,0:13:33.09,Default,,0,0,0,,Табылды
Dialogue: 0,0:13:37.04,0:13:39.00,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:13:40.08,0:13:42.02,Default,,0,0,0,,Оя
Dialogue: 0,0:13:42.02,0:13:47.02,Default,,0,0,0,,Сізді осындай жерде кездестіргенім қандай кездейсоқтық.
Dialogue: 0,0:13:48.00,0:13:51.04,Default,,0,0,0,,Бұл қалада енді жындар болмауы керек.
Dialogue: 0,0:13:51.08,0:13:57.09,Default,,0,0,0,,Бұл қалада қанша адамды өлтірсек те, қанша тонасақ та,
Dialogue: 0,0:13:57.09,0:14:00.04,Default,,0,0,0,,Бұл жай ғана адамдар арасындағы оқиға.
Dialogue: 0,0:14:00.08,0:14:03.04,Default,,0,0,0,,Оның сендерге еш қатысы болмауы керек.
Dialogue: 0,0:14:03.08,0:14:07.09,Default,,0,0,0,,Әлде бізді тоқтату үшін бір минуттан астам уақыт келді ме?
Dialogue: 0,0:14:08.04,0:14:11.02,Default,,0,0,0,,Өзгелерді өлтіре алмайтын денемен
Dialogue: 0,0:14:15.06,0:14:16.05,Default,,0,0,0,,Клэр
Dialogue: 0,0:14:19.00,0:14:20.00,Default,,0,0,0,,Йо
Dialogue: 0,0:14:20.00,0:14:21.03,Default,,0,0,0,,Бұл сен кімсің?
Dialogue: 0,0:14:21.09,0:14:24.01,Default,,0,0,0,,Сіз бір нәрсені ұмыттыңыз ба?
Dialogue: 0,0:14:25.03,0:14:29.03,Default,,0,0,0,,Уайымдама, мен бұл жігітке қамқор боламын.
Dialogue: 0,0:14:29.03,0:14:33.06,Default,,0,0,0,,Уайымдама, мен саған көп қамқорлық жасаймын.
Dialogue: 0,0:14:36.00,0:14:39.03,Default,,0,0,0,,Оның жылап тұрғанын көру сүйкімді болды.
Dialogue: 0,0:14:39.07,0:14:43.00,Default,,0,0,0,,Тереза ​​Тереза ​​дегеніміз не?
Dialogue: 0,0:14:54.07,0:14:55.02,Default,,0,0,0,,Бұл
Dialogue: 0,0:14:58.08,0:14:59.07,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:00.01,0:15:03.04,Default,,0,0,0,,Ей, мынау менің қалған асыл қолым.
Dialogue: 0,0:15:04.04,0:15:05.07,Default,,0,0,0,,Оны қайтарыңыз
Dialogue: 0,0:15:11.03,0:15:13.01,Default,,0,0,0,,Дайын болыңдар, балалар.
Dialogue: 0,0:15:16.00,0:15:19.05,Default,,0,0,0,,Жыннан да жаман деп өзіңді қарға.
Dialogue: 0,0:15:20.01,0:15:24.05,Default,,0,0,0,,Мен бәріңді өлтіремін.
Dialogue: 0,0:15:29.06,0:15:31.04,Default,,0,0,0,,Мен мұны жасадым
Dialogue: 0,0:15:31.07,0:15:35.04,Default,,0,0,0,,Клэймор ақыры біреуді өлтірді
Dialogue: 0,0:15:36.08,0:15:38.05,Default,,0,0,0,,Егер сіз бәрін өлтірсеңіз
Dialogue: 0,0:15:38.05,0:15:40.00,Default,,0,0,0,,Мені төмендетпе
Dialogue: 0,0:15:40.00,0:15:45.04,Default,,0,0,0,,Мен жын бар қалаға қол тигізе алмадым, бірақ оның нақты кім екенін білмедім.
Dialogue: 0,0:15:46.06,0:15:51.08,Default,,0,0,0,,Кімге қарсы күресіп жатқаныңызды көріп тұрсаңыз, ол жын ба, саз ба, бәрібір.
Dialogue: 0,0:15:51.08,0:15:54.02,Default,,0,0,0,,Мен сені ұрамын.
Dialogue: 0,0:16:03.06,0:16:05.06,Default,,0,0,0,,Жасайық
Dialogue: 0,0:16:05.09,0:16:10.08,Default,,0,0,0,,Менің алғашқы соққымнан бірінші болып жалтардың.
Dialogue: 0,0:16:19.06,0:16:21.08,Default,,0,0,0,,Оны қалай көресіз?
Dialogue: 0,0:16:22.02,0:16:25.01,Default,,0,0,0,,Сұңқар қылыштың шынайы табиғаты осы.
Dialogue: 0,0:16:25.01,0:16:30.08,Default,,0,0,0,,Қамшы тәрізді толқындар, қысқа қашықтықтан ұзақ қашықтыққа шабуыл жасауға мүмкіндік береді.
Dialogue: 0,0:16:31.02,0:16:33.08,Default,,0,0,0,,Адамның көзімен ұстау мүмкін емес
Dialogue: 0,0:16:34.03,0:16:37.01,Default,,0,0,0,,Менің қылышымды ешкім айналып өте алмайды
Dialogue: 0,0:16:37.01,0:16:40.01,Default,,0,0,0,,Бір уақытта маған тиісе де алмайсың.
Dialogue: 0,0:16:40.05,0:16:41.08,Default,,0,0,0,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:16:41.08,0:16:44.01,Default,,0,0,0,,Бұл менің қалтамда да жоқ.
Dialogue: 0,0:16:48.06,0:16:50.09,Default,,0,0,0,,О, бұл
Dialogue: 0,0:16:55.05,0:16:57.06,Default,,0,0,0,,Қуат басы
Dialogue: 0,0:17:07.06,0:17:10.02,Default,,0,0,0,,Джо. . . Бұл әзіл емес
Dialogue: 0,0:17:10.02,0:17:14.04,Default,,0,0,0,,Мұндай құбыжықпен күресу әу бастан дұрыс емес еді.
Dialogue: 0,0:17:14.09,0:17:16.00,Default,,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:17:16.00,0:17:17.03,Default,,0,0,0,,Бұл құбыжық.
Dialogue: 0,0:17:17.03,0:17:18.02,Default,,0,0,0,,жүрегі жұмсақ жандар әлі де басқаларға көмектеседі ғой, иә?
Dialogue: 0,0:17:18.02,0:17:19.00,Default,,0,0,0,,Гунта-сан
Dialogue: 0,0:17:34.07,0:17:36.08,Default,,0,0,0,,Сіз ояусыз ба, Клэр?
Dialogue: 0,0:17:38.05,0:17:39.06,Default,,0,0,0,,Тереза
Dialogue: 0,0:17:47.00,0:17:49.04,Default,,0,0,0,,Сіз мұны ақырында орындадыңыз ба?
Dialogue: 0,0:17:51.00,0:17:53.09,Default,,0,0,0,,Мен бір күні осылай болатынын сезіндім.
Dialogue: 0,0:17:54.04,0:17:56.08,Default,,0,0,0,,Ережеде ерекшеліктер жоқ.
Dialogue: 0,0:17:57.09,0:18:02.07,Default,,0,0,0,,Кез келген адам немесе кез келген себеппен
Dialogue: 0,0:18:03.03,0:18:07.03,Default,,0,0,0,,Бұл ұят, жымиып Тереза.
Dialogue: 0,0:18:23.02,0:18:26.07,Default,,0,0,0,,Бұл болғаны үшін кешірім сұраймын, Тереза.
Dialogue: 0,0:18:27.04,0:18:29.07,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:18:29.07,0:18:32.04,Default,,0,0,0,,Тереза Тереза
Dialogue: 0,0:18:32.04,0:18:34.01,Default,,0,0,0,,Шынымды айтсам, бұл таң қалдырды.
Dialogue: 0,0:18:35.04,0:18:37.07,Default,,0,0,0,,Мен бұлай болады деп ешқашан ойламадым.
Dialogue: 0,0:18:38.03,0:18:41.00,Default,,0,0,0,,Мен әрқашан сабырлы бола алатыныма сенімді болдым.
Dialogue: 0,0:18:42.00,0:18:43.04,Default,,0,0,0,,Мені ұмыт
Dialogue: 0,0:18:44.07,0:18:47.04,Default,,0,0,0,,Мен білмей тұрып, бәрі бітті.
Dialogue: 0,0:18:47.08,0:18:51.00,Default,,0,0,0,,Тереза
Dialogue: 0,0:18:51.09,0:18:54.04,Default,,0,0,0,,Сізден соңғы бір нәрсе сұрасам болады ма?
Dialogue: 0,0:18:55.01,0:18:58.08,Default,,0,0,0,,Клэр, баламен не істеуді жоспарлап отырсың?
Dialogue: 0,0:18:59.02,0:19:01.00,Default,,0,0,0,,Білудің қажеті жоқ
Dialogue: 0,0:19:01.04,0:19:04.06,Default,,0,0,0,,Бұл енді сізді алаңдатпайды.
Dialogue: 0,0:19:05.04,0:19:06.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:07.00,0:19:08.01,Default,,0,0,0,,That's right.
Dialogue: 0,0:19:08.01,0:19:09.03,Default,,0,0,0,,Тереза
Dialogue: 0,0:19:09.03,0:19:10.05,Default,,0,0,0,,Мынаны ал, «Aerosmith»!
Dialogue: 0,0:19:10.05,0:19:11.08,Default,,0,0,0,,Менің өлгім келмейді
Dialogue: 0,0:19:12.01,0:19:13.05,Default,,0,0,0,,Тереза
Dialogue: 0,0:19:15.02,0:19:16.09,Default,,0,0,0,,Тереза
Dialogue: 0,0:19:17.04,0:19:18.05,Default,,0,0,0,,Тереза
Dialogue: 0,0:19:18.05,0:19:20.09,Default,,0,0,0,,Қоштасу Клэр
Dialogue: 0,0:19:20.09,0:19:23.01,Default,,0,0,0,,Тереза
Dialogue: 0,0:19:51.09,0:19:53.04,Default,,0,0,0,,Жара терең емес
Dialogue: 0,0:19:54.03,0:19:57.06,Default,,0,0,0,,Егер сіз сиқырлы күш шығару арқылы жараны түзете алсаңыз.
Dialogue: 0,0:19:57.06,0:19:59.01,Default,,0,0,0,,Өте пайдалы
Dialogue: 0,0:20:00.03,0:20:00.53,Default,,0,0,0,,Нашар
Dialogue: 0,0:20:01.08,0:20:03.08,Default,,0,0,0,,Өйткені, мен әлі өле алмаймын.
Dialogue: 0,0:20:06.01,0:20:06.51,Default,,0,0,0,,Тереза
Dialogue: 0,0:20:08.03,0:20:09.05,Default,,0,0,0,,Тереза
Dialogue: 0,0:20:11.03,0:20:15.00,Default,,0,0,0,,Тереза
Dialogue: 0,0:20:15.07,0:20:16.08,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:20:17.02,0:20:18.08,Default,,0,0,0,,Ол көп жылайды.
Dialogue: 0,0:20:19.05,0:20:22.00,Default,,0,0,0,,Сіз нені айтып тұрсыз, Тереза?
Dialogue: 0,0:20:22.08,0:20:25.01,Default,,0,0,0,,Мұның астарында терең мағына жоқ.
Dialogue: 0,0:20:25.01,0:20:28.05,Default,,0,0,0,,Бұл өте қарапайым және түсінуге оңай себеп.
Dialogue: 0,0:20:30.02,0:20:32.05,Default,,0,0,0,,Өмірдің мәнін таптым
Dialogue: 0,0:20:33.01,0:20:36.06,Default,,0,0,0,,Бұдан былай мен бұл жігіт үшін өмір сүруге тырысамын.
Dialogue: 0,0:20:45.04,0:20:47.05,Default,,0,0,0,,Сіз өкінесіз
Dialogue: 0,0:20:48.00,0:20:49.04,Default,,0,0,0,,Мен алмаймын.
Dialogue: 0,0:20:54.00,0:20:55.06,Default,,0,0,0,,Амал жоқ
Dialogue: 0,0:21:06.06,0:21:08.07,Default,,0,0,0,,Бұл мәселеге айналды.
Dialogue: 0,0:21:09.04,0:21:14.04,Default,,0,0,0,,Ұйымда ең мықты деп айтылатын күлімсіреген Терезаның сатқындығы қандай?
Dialogue: 0,0:21:16.00,0:21:18.06,Default,,0,0,0,,Бұл ерекше ештеңе емес.
Dialogue: 0,0:21:20.01,0:21:24.00,Default,,0,0,0,,2-ден 5-ке дейінгі сандарды шақыру.
Dialogue: 0,0:21:24.09,0:21:27.05,Default,,0,0,0,,Терезаны бағындыруға жіберу
Dialogue: 0,0:22:40.04,0:22:42.03,Default,,0,0,0,,Сатқындықтың себебі
Dialogue: 0,0:22:42.03,0:22:43.09,Default,,0,0,0,,Сатқындықтың бағасы
Dialogue: 0,0:22:43.09,0:22:47.00,Default,,0,0,0,,Ажырамайтын өсиет
Dialogue: 0,0:22:48.50,0:22:53.50,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
