Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Кеттік
Dialogue: 0,0:00:12.06,0:00:13.05,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:00:14.06,0:00:16.05,Default,,0,0,0,,Мына жігіттерге
Dialogue: 0,0:00:17.00,0:00:19.08,Default,,0,0,0,,Шит соусы
Dialogue: 0,0:00:24.00,0:00:26.05,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:00:38.01,0:00:39.02,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:00:39.09,0:00:41.07,Default,,0,0,0,,Оның бүкіл денесінде жарақаттар бар.
Dialogue: 0,0:02:08.09,0:02:10.07,Default,,0,0,0,,Оянған адам қайтыс болды
Dialogue: 0,0:02:10.07,0:02:12.01,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:02:12.05,0:02:13.04,Default,,0,0,0,,Иә
Dialogue: 0,0:02:15.06,0:02:17.03,Default,,0,0,0,,Сіз қанағаттанбаған сияқтысыз.
Dialogue: 0,0:02:17.03,0:02:18.07,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:02:19.01,0:02:20.07,Default,,0,0,0,,Бұл таң қалдырады
Dialogue: 0,0:02:21.03,0:02:23.09,Default,,0,0,0,,Сол оянған адам ерекше.
Dialogue: 0,0:02:24.04,0:02:27.03,Default,,0,0,0,,Мен оның бұлай тез ыдырайтынын күтпедім.
Dialogue: 0,0:02:27.07,0:02:30.01,Default,,0,0,0,,Бұл миссияның аяқталғанын білдіреді.
Dialogue: 0,0:02:30.08,0:02:33.01,Default,,0,0,0,,Олардың барлығы тірі ме?
Dialogue: 0,0:02:39.00,0:02:40.02,Default,,0,0,0,,Үш адам.
Dialogue: 0,0:02:41.01,0:02:45.00,Default,,0,0,0,,Егер басқа адам әлі тірі болса, ол өте әлсіз.
Dialogue: 0,0:02:45.00,0:02:48.04,Default,,0,0,0,,Жалғыз аман қалсаң ғажап болар еді.
Dialogue: 0,0:02:48.07,0:02:51.00,Default,,0,0,0,,Толығырақ қарастырайық.
Dialogue: 0,0:02:51.05,0:02:56.00,Default,,0,0,0,,Оянған аңшының серіктерінің өмірі мен өлімі соншалықты маңызды ма?
Dialogue: 0,0:02:56.06,0:02:59.05,Default,,0,0,0,,Ата-ананың баласына қамқор болғаны сияқты.
Dialogue: 0,0:03:00.04,0:03:01.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:09.02,0:03:10.00,Default,,0,0,0,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:03:11.07,0:03:13.00,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:03:13.06,0:03:16.02,Default,,0,0,0,,Қолымды қалпына келтіру үшін бар күшімді жұмсадым.
Dialogue: 0,0:03:16.06,0:03:18.09,Default,,0,0,0,,Іштің регенерациясы жақсы жүрмейді
Dialogue: 0,0:03:20.00,0:03:22.03,Default,,0,0,0,,Қалғаны адамның ерік-жігеріне байланысты.
Dialogue: 0,0:03:24.04,0:03:26.02,Default,,0,0,0,,Сізде қиындықтар бар ма?
Dialogue: 0,0:03:26.09,0:03:28.08,Default,,0,0,0,,Ең көп жеген болуы керек.
Dialogue: 0,0:03:28.08,0:03:33.00,Default,,0,0,0,,Бірақ барлық маңызды бөліктерден аулақ болды.
Dialogue: 0,0:03:34.02,0:03:37.07,Default,,0,0,0,,Бұлардың барлығы уақыт берілсе тез жазылатын жаралар.
Dialogue: 0,0:03:38.02,0:03:39.02,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:03:42.05,0:03:44.06,Default,,0,0,0,,Мұндай жағдай сол жағдайда болды.
Dialogue: 0,0:03:48.08,0:03:51.03,Default,,0,0,0,,Менің сізден сұрайын дегенім бар.
Dialogue: 0,0:03:51.03,0:03:52.05,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:55.00,0:04:00.00,Default,,0,0,0,,Араларыңызда оятуға тырысқандар
Dialogue: 0,0:04:03.05,0:04:05.09,Default,,0,0,0,,Бұл біз үшін маңызды
Dialogue: 0,0:04:06.04,0:04:09.01,Default,,0,0,0,,Мүмкін болса, шынайы жауап беруіңізді қалаймын.
Dialogue: 0,0:04:11.00,0:04:12.03,Default,,0,0,0,,Мен
Dialogue: 0,0:04:14.03,0:04:18.05,Default,,0,0,0,,Өйткені мен жараланған денеммен сиқырлы күшімді негізсіз босатып жібердім.
Dialogue: 0,0:04:18.05,0:04:20.03,Default,,0,0,0,,Шектерді қате бағалады
Dialogue: 0,0:04:24.03,0:04:26.03,Default,,0,0,0,,Ояну жай ғана ауырсыну емес
Dialogue: 0,0:04:26.03,0:04:28.04,Default,,0,0,0,,Ол көңіл күйде болса керек.
Dialogue: 0,0:04:28.09,0:04:31.07,Default,,0,0,0,,Көптеген жауынгерлер оған қарсы тұра алмайды.
Dialogue: 0,0:04:31.07,0:04:35.05,Default,,0,0,0,,Әй, қайтып оралғаным ғажап.
Dialogue: 0,0:04:37.03,0:04:38.06,Default,,0,0,0,,Менде де бар.
Dialogue: 0,0:04:39.07,0:04:42.00,Default,,0,0,0,,Көңіл-күйім түсіп, шектен шығып кеттім.
Dialogue: 0,0:04:42.04,0:04:43.09,Default,,0,0,0,,Ер адамдармен бірдей
Dialogue: 0,0:04:44.03,0:04:46.07,Default,,0,0,0,,Мен бұл құштарлыққа қарсы тұра алмадым.
Dialogue: 0,0:04:46.07,0:04:48.07,Default,,0,0,0,,Бірақ мен қайтып келдім
Dialogue: 0,0:04:48.07,0:04:51.01,Default,,0,0,0,,Қандай да бір жолмен өзіңізді қайтарыңыз
Dialogue: 0,0:04:52.00,0:04:53.08,Default,,0,0,0,,Денев те болуы керек.
Dialogue: 0,0:04:54.06,0:04:58.05,Default,,0,0,0,,Оның жағдайында ол өз шегін білгісі келген сияқты.
Dialogue: 0,0:04:59.02,0:05:01.03,Default,,0,0,0,,Денев қартайды ма?
Dialogue: 0,0:05:01.03,0:05:03.05,Default,,0,0,0,,Ах, бұл синхронды.
Dialogue: 0,0:05:05.00,0:05:06.02,Default,,0,0,0,,Мен сізден сұрайын
Dialogue: 0,0:05:06.05,0:05:11.07,Default,,0,0,0,,Екеуіңізде клиенттермен немесе қарапайым адамдармен қиындықтар болды ма?
Dialogue: 0,0:05:13.05,0:05:16.09,Default,,0,0,0,,Маа, менде осындай мінез бар.
Dialogue: 0,0:05:16.09,0:05:18.02,Default,,0,0,0,,Кейде
Dialogue: 0,0:05:19.05,0:05:20.03,Default,,0,0,0,,Денев
Dialogue: 0,0:05:21.02,0:05:24.09,Default,,0,0,0,,Бұл жігіт өзіне және басқаларға қатысты перфекционист.
Dialogue: 0,0:05:24.09,0:05:27.04,Default,,0,0,0,,Қарапайым адамдарға қарағанда дос сияқты
Dialogue: 0,0:05:27.09,0:05:28.09,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:29.04,0:05:31.09,Default,,0,0,0,,Ал екіншісі нұсқауларды орындамады
Dialogue: 0,0:05:31.09,0:05:34.06,Default,,0,0,0,,Бұл бақылаудан шығатын ең төменгі сан ба?
Dialogue: 0,0:05:35.05,0:05:39.00,Default,,0,0,0,,Олардың барлығы оянған проблемалы балалар.
Dialogue: 0,0:05:40.04,0:05:42.00,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:05:42.04,0:05:45.02,Default,,0,0,0,,Кездейсоқ проблемалық балалар жинағы
Dialogue: 0,0:05:45.02,0:05:47.01,Default,,0,0,0,,Кездейсоқ ақпарат қатесі
Dialogue: 0,0:05:47.01,0:05:51.00,Default,,0,0,0,,Мен кездейсоқ оянған адаммен төбелесіп қалдым.
Dialogue: 0,0:05:52.00,0:05:53.07,Default,,0,0,0,,Әрине, дәмді болмауы мүмкін емес — рецептіні дәлме-дәл орындадым. Бұл дәл бір тәжірибе сияқты.
Dialogue: 0,0:05:53.07,0:05:56.00,Default,,0,0,0,,Бұл ұйым сияқты
Dialogue: 0,0:05:56.00,0:05:57.08,Default,,0,0,0,,Бұл жай ғана гипотеза.
Dialogue: 0,0:05:58.02,0:06:00.03,Default,,0,0,0,,Мирия, сен ше?
Dialogue: 0,0:06:00.08,0:06:03.06,Default,,0,0,0,,Оянғанды ​​былай қойғанда, ол проблемалық балаға ұқсамайды.
Dialogue: 0,0:06:05.00,0:06:08.08,Default,,0,0,0,,Ол шартқа менен артық ешкім сәйкес келмейді.
Dialogue: 0,0:06:14.08,0:06:17.06,Default,,0,0,0,,Мен де оятуды орнаттым.
Dialogue: 0,0:06:18.01,0:06:19.06,Default,,0,0,0,,Сіз
Dialogue: 0,0:06:20.02,0:06:22.08,Default,,0,0,0,,Оянғандарды үшінші рет аулайтын кез келді.
Dialogue: 0,0:06:23.06,0:06:27.04,Default,,0,0,0,,Шайқас біткеннен кейін мен оның ескі досым екенін түсіндім.
Dialogue: 0,0:06:48.07,0:06:50.07,Default,,0,0,0,,Хилда болмайды
Dialogue: 0,0:06:56.05,0:06:59.00,Default,,0,0,0,,Ол сіздің әріптесіңіз болғанына сенімдімін.
Dialogue: 0,0:06:59.04,0:07:02.05,Default,,0,0,0,,Ұйымнан ештеңе естіген жоқсыз ба?
Dialogue: 0,0:07:08.01,0:07:09.00,Default,,0,0,0,,Бұл сенсің ғой, иә?
Dialogue: 0,0:07:10.09,0:07:11.08,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:07:12.04,0:07:14.04,Default,,0,0,0,,Неге менің атымды атамадың?
Dialogue: 0,0:07:15.00,0:07:18.06,Default,,0,0,0,,Неге, неге маған сен екеніңді айтпадың?
Dialogue: 0,0:07:18.05,0:07:19.06,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:07:19.06,0:07:21.00,Default,,0,0,0,,Неліктен Хилда?
Dialogue: 0,0:07:21.05,0:07:22.06,Default,,0,0,0,,Хилда
Dialogue: 0,0:07:26.01,0:07:27.04,Default,,0,0,0,,Көп ойланбаңыз
Dialogue: 0,0:07:27.09,0:07:30.03,Default,,0,0,0,,Оның адам санасы болған жоқ.
Dialogue: 0,0:07:30.09,0:07:32.07,Default,,0,0,0,,Бұл құбыжық.
Dialogue: 0,0:07:51.01,0:07:53.01,Default,,0,0,0,,Жаман рухтар ұшады
Dialogue: 0,0:07:53.01,0:07:54.02,Default,,0,0,0,,Милия
Dialogue: 0,0:07:55.01,0:07:56.03,Default,,0,0,0,,Елес Мирияның қалай оянғаны қызық.
Dialogue: 0,0:07:56.03,0:07:59.08,Default,,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:07:59.08,0:08:00.05,Default,,0,0,0,,Егер бұл командалық күрес болса
Dialogue: 0,0:08:01.03,0:08:05.08,Default,,0,0,0,,Оның саны 1 немесе одан жоғары деп айтылады.
Dialogue: 0,0:08:05.08,0:08:07.09,Default,,0,0,0,,Мен міндетті түрде төбелескім келеді.
Dialogue: 0,0:08:08.03,0:08:09.06,Default,,0,0,0,,Не
Dialogue: 0,0:08:15.06,0:08:17.04,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:08:17.09,0:08:20.06,Default,,0,0,0,,Тез оян!
Dialogue: 0,0:08:32.09,0:08:36.02,Default,,0,0,0,,. . Ол кезде мен оянудың қажеті жоқ еді.
Dialogue: 0,0:08:37.01,0:08:39.09,Default,,0,0,0,,Мен өз шегімнен асып кеткенімді білдім, бірақ
Dialogue: 0,0:08:39.09,0:08:41.04,Default,,0,0,0,,Қатты басылған
Dialogue: 0,0:08:42.01,0:08:45.09,Default,,0,0,0,,Мүмкін оның арандатуын пайдаланбауға ерік-жігері болған шығар.
Dialogue: 0,0:08:46.04,0:08:47.04,Default,,0,0,0,,Үлкен ағам сені қорғап қалар еді,
Dialogue: 0,0:08:49.01,0:08:50.08,Default,,0,0,0,,Жоқ, мен бұл туралы айтып отырмын.
Dialogue: 0,0:08:51.07,0:08:56.06,Default,,0,0,0,,Әйтеуір, сол сәтте ұйымнан кек алуға бел байладым.
Dialogue: 0,0:08:58.02,0:08:59.09,Default,,0,0,0,,Осындай денемен
Dialogue: 0,0:09:00.03,0:09:03.07,Default,,0,0,0,,Соңында, кейбір ұйымдар оны бір рет қолданылатын сияқты кәдеге жаратады.
Dialogue: 0,0:09:03.07,0:09:05.01,Default,,0,0,0,,Кешіре алмадым
Dialogue: 0,0:09:05.01,0:09:08.00,Default,,0,0,0,,Бірақ кек алу туралы не деуге болады?
Dialogue: 0,0:09:08.08,0:09:12.02,Default,,0,0,0,,Ұйымға мойынсұнғыш болып көріну
Dialogue: 0,0:09:12.02,0:09:14.02,Default,,0,0,0,,Мен әртүрлі нәрселерді зерттеймін.
Dialogue: 0,0:09:14.05,0:09:16.04,Default,,0,0,0,,Сіз бірдеңе білдіңіз бе?
Dialogue: 0,0:09:17.03,0:09:19.03,Default,,0,0,0,,Әлі жоқ
Dialogue: 0,0:09:19.03,0:09:21.08,Default,,0,0,0,,Ұйым үшін шулы болуы мүмкін.
Dialogue: 0,0:09:22.05,0:09:26.07,Default,,0,0,0,,Бұл оның жазаға тартылғанын білдіре ме?
Dialogue: 0,0:09:27.07,0:09:29.04,Default,,0,0,0,,Жоғарыда айтқанымдай
Dialogue: 0,0:09:29.04,0:09:31.08,Default,,0,0,0,,Бұл жай ғана гипотеза.
Dialogue: 0,0:09:37.05,0:09:39.01,Default,,0,0,0,,Сол бетті таққандықтан бәрін жеп қойды.
Dialogue: 0,0:09:39.06,0:09:44.05,Default,,0,0,0,,Бізді ояту арқылы біз бірдеңені өзгерттік пе?
Dialogue: 0,0:09:46.03,0:09:48.03,Default,,0,0,0,,Мұны сұрау нені білдіреді?
Dialogue: 0,0:09:48.07,0:09:50.06,Default,,0,0,0,,Сіз бірдеңені сезіп тұрған шығарсыз.
Dialogue: 0,0:09:52.05,0:09:55.02,Default,,0,0,0,,Оянуға дейін және кейін
Dialogue: 0,0:09:55.02,0:09:58.01,Default,,0,0,0,,Жындық табиғаты басқаша екені анық.
Dialogue: 0,0:09:58.09,0:10:01.08,Default,,0,0,0,,Бұрынғыдан айырмашылығы анық емес шекті нүкте
Dialogue: 0,0:10:01.08,0:10:06.08,Default,,0,0,0,,Анда-санда пайда болатын күшті аштық сезімі, солай емес пе?
Dialogue: 0,0:10:09.02,0:10:11.01,Default,,0,0,0,,Бізде бар
Dialogue: 0,0:10:12.01,0:10:14.00,Default,,0,0,0,,Мен ояумын.
Dialogue: 0,0:10:15.09,0:10:17.00,Default,,0,0,0,,Біз
Dialogue: 0,0:10:17.07,0:10:19.00,Default,,0,0,0,,Оянды
Dialogue: 0,0:10:27.00,0:10:28.03,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:28.03,0:10:30.01,Default,,0,0,0,,Рух бұзылады
Dialogue: 0,0:10:30.01,0:10:34.05,Default,,0,0,0,,Ол мені қатты мистикалық рухпен ренжітетін бірдеңе айтқан сияқты.
Dialogue: 0,0:10:34.09,0:10:39.02,Default,,0,0,0,,Орташа жұмбақ адам жоғары эмоциямен наразылық білдіреді.
Dialogue: 0,0:10:39.02,0:10:42.00,Default,,0,0,0,,Кішкентай құбыжықтар салыстырмалы түрде тыныш.
Dialogue: 0,0:10:42.04,0:10:43.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:44.07,0:10:46.08,Default,,0,0,0,,Мен қатты ренжідім.
Dialogue: 0,0:10:47.05,0:10:49.05,Default,,0,0,0,,Оны көрсетпеу
Dialogue: 0,0:10:49.09,0:10:51.05,Default,,0,0,0,,Өткенде не болды?
Dialogue: 0,0:10:51.05,0:10:54.02,Default,,0,0,0,,Жүрегіңізді сыртқы әлемге жауып жатырсыз ба?
Dialogue: 0,0:10:55.08,0:10:57.09,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,0:10:58.03,0:11:01.08,Default,,0,0,0,,Сіз соншалықты алыс жерден айта аласыз ба?
Dialogue: 0,0:11:03.09,0:11:05.04,Default,,0,0,0,,Бұл әзіл емес.
Dialogue: 0,0:11:05.04,0:11:07.04,Default,,0,0,0,,Ондай құбыжықпен өмір сүрме.
Dialogue: 0,0:11:07.09,0:11:10.03,Default,,0,0,0,,Мен ол құбыжық болған жоқпын.
Dialogue: 0,0:11:10.03,0:11:12.05,Default,,0,0,0,,Адамдар кетпейді деп ойлаймын.
Dialogue: 0,0:11:12.08,0:11:15.03,Default,,0,0,0,,Мен ешқашан оянбаймын
Dialogue: 0,0:11:15.03,0:11:17.02,Default,,0,0,0,,Бұл жаман сөз болды.
Dialogue: 0,0:11:17.05,0:11:20.05,Default,,0,0,0,,Ояну толық ояну емес.
Dialogue: 0,0:11:21.00,0:11:23.03,Default,,0,0,0,,Бұл жартылай ояу күй сияқты.
Dialogue: 0,0:11:23.03,0:11:25.05,Default,,0,0,0,,Жартылай ояу
Dialogue: 0,0:11:25.09,0:11:28.05,Default,,0,0,0,,Әдетте мен бірден оянатынмын.
Dialogue: 0,0:11:28.05,0:11:30.06,Default,,0,0,0,,Орта жолда тоқтатылған күй
Dialogue: 0,0:11:31.00,0:11:34.05,Default,,0,0,0,,Немесе оянуды баяу жалғастыру күйі.
Dialogue: 0,0:11:34.05,0:11:36.08,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:11:37.01,0:11:39.03,Default,,0,0,0,,Қолдың созылуы және жиырылуы
Dialogue: 0,0:11:39.03,0:11:42.01,Default,,0,0,0,,Мен оны шайқаста еш қиындықсыз пайдалана алдым.
Dialogue: 0,0:11:42.01,0:11:44.08,Default,,0,0,0,,Оянғаннан кейін емес пе?
Dialogue: 0,0:11:46.03,0:11:49.00,Default,,0,0,0,,Деневтің регенерация қабілетіне де қатысты.
Dialogue: 0,0:11:49.00,0:11:51.02,Default,,0,0,0,,Егер шын болса, бұл тек шекті.
Dialogue: 0,0:11:51.02,0:11:53.01,Default,,0,0,0,,Бұл қайта-қайта жасай алатын нәрсе емес.
Dialogue: 0,0:11:54.02,0:11:57.03,Default,,0,0,0,,Шектен асқаннан кейін бастапқы күйге оралу мүмкін емес.
Dialogue: 0,0:11:57.09,0:11:59.08,Default,,0,0,0,,Шындығында бұл мүмкін емес.
Dialogue: 0,0:12:02.02,0:12:03.03,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:04.02,0:12:06.08,Default,,0,0,0,,Мұның бәрі менің есімде.
Dialogue: 0,0:12:07.05,0:12:08.05,Default,,0,0,0,,Денев
Dialogue: 0,0:12:08.05,0:12:12.05,Default,,0,0,0,,Иә. . Сонда мен жартылай ояу күйде екенімді түсіндім.
Dialogue: 0,0:12:13.01,0:12:15.05,Default,,0,0,0,,Бұдан кейін бізге не болады?
Dialogue: 0,0:12:16.00,0:12:20.06,Default,,0,0,0,,Саусағыңызды аузыңызға алып, оның толық оянғанын күтесіз бе?
Dialogue: 0,0:12:23.05,0:12:26.09,Default,,0,0,0,,Кешіріңіз, мен одан артық ештеңе білмеймін.
Dialogue: 0,0:12:27.04,0:12:28.09,Default,,0,0,0,,Мен айта аламын
Dialogue: 0,0:12:28.09,0:12:34.05,Default,,0,0,0,,Біз қандай жағдайда оянатынымызды білмейміз. Бұл қауіпті жағдай екенін ғана айта аламыз.
Dialogue: 0,0:12:38.09,0:12:40.03,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:40.03,0:12:41.07,Default,,0,0,0,,Өтіп бара жатыр, өтіп бара жатыр
Dialogue: 0,0:12:41.07,0:12:42.06,Default,,0,0,0,,Бұл эксперимент.
Dialogue: 0,0:12:47.09,0:12:49.00,Default,,0,0,0,,Денев
Dialogue: 0,0:12:51.09,0:12:53.02,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:12:53.02,0:12:54.05,Default,,0,0,0,,Тоқта, Денев.
Dialogue: 0,0:12:54.09,0:12:56.08,Default,,0,0,0,,Жарайды, үніңді жап, қарап тұр.
Dialogue: 0,0:12:57.09,0:13:01.09,Default,,0,0,0,,Егер сіз шекті сақтай отырып, регенерацияны жалғастырсаңыз да, сіз тек өлесіз.
Dialogue: 0,0:13:02.00,0:13:05.04,Default,,0,0,0,,Олай болса сиқырлы күштеріңізді барынша пайдаланыңыз
Dialogue: 0,0:13:05.04,0:13:07.01,Default,,0,0,0,,Лезде ойнаңыз
Dialogue: 0,0:13:09.00,0:13:10.02,Default,,0,0,0,,Бұл ақылға қонымсыз
Dialogue: 0,0:13:10.01,0:13:12.00,Default,,0,0,0,,Егер сіздің денеңіз өз шегінен асып кетсе
Dialogue: 0,0:13:12.00,0:13:14.03,Default,,0,0,0,,Егер Мирия дұрыс айтса
Dialogue: 0,0:13:14.03,0:13:17.05,Default,,0,0,0,,Біз шектен асып кеттік.
Dialogue: 0,0:13:17.05,0:13:20.00,Default,,0,0,0,,Бұл жағдайда, сиқырлы күшті бірден қолдансаңыз да,
Dialogue: 0,0:13:20.00,0:13:23.00,Default,,0,0,0,,Оянбай қайту мүмкіндігі болуы керек.
Dialogue: 0,0:13:23.08,0:13:28.06,Default,,0,0,0,,Бірақ толық ояу болсаңыз
Dialogue: 0,0:13:28.09,0:13:31.08,Default,,0,0,0,,Мені өлтіруден тартынба
Dialogue: 0,0:13:32.03,0:13:33.02,Default,,0,0,0,,Не
Dialogue: 0,0:13:34.09,0:13:36.01,Default,,0,0,0,,Денев
Dialogue: 0,0:13:38.09,0:13:40.05,Default,,0,0,0,,Хелен Клэр
Dialogue: 0,0:13:41.04,0:13:43.02,Default,,0,0,0,,Синхронизацияның артықшылықтары
Dialogue: 0,0:13:43.07,0:13:45.04,Default,,0,0,0,,Мен сені қиналмай өлуге рұқсат етемін.
Dialogue: 0,0:13:45.09,0:13:46.09,Default,,0,0,0,,Осы уақытқа дейін Миста өте еркін өмір сүрді
Dialogue: 0,0:13:47.04,0:13:49.02,Default,,0,0,0,,Ешқандай қателік жібермеймін.
Dialogue: 0,0:14:11.07,0:14:13.03,Default,,0,0,0,,Жалғыз оянған
Dialogue: 0,0:14:13.09,0:14:14.07,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:14:15.03,0:14:18.03,Default,,0,0,0,,Мен өз еркіммен оянғандай сезінемін.
Dialogue: 0,0:14:18.03,0:14:19.06,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:14:20.02,0:14:23.09,Default,,0,0,0,,Менің ойымша, сіз шайқастағы зақымға байланысты шекті дұрыс бағалағансыз.
Dialogue: 0,0:14:23.09,0:14:25.07,Default,,0,0,0,,Бұл өкінішті.
Dialogue: 0,0:14:26.07,0:14:27.09,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:14:27.09,0:14:30.07,Default,,0,0,0,,Оны өз балаңдай ойламайсың ба?
Dialogue: 0,0:14:31.06,0:14:35.02,Default,,0,0,0,,Менің баламды құбыжық еткенім есімде жоқ.
Dialogue: 0,0:14:46.02,0:14:49.00,Default,,0,0,0,,Сіз қайтып келген сияқтысыз.
Dialogue: 0,0:14:49.04,0:14:50.03,Default,,0,0,0,,Денев
Dialogue: 0,0:14:57.04,0:14:58.05,Default,,0,0,0,,Мүлдем
Dialogue: 0,0:14:58.05,0:14:59.09,Default,,0,0,0,,абайсызда әрекет ету
Dialogue: 0,0:14:59.09,0:15:00.08,Default,,0,0,0,,Іші
Dialogue: 0,0:15:00.08,0:15:02.00,Default,,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:15:02.09,0:15:06.03,Default,,0,0,0,,Әй, әйтеуір бұғатталып қалды.
Dialogue: 0,0:15:07.02,0:15:09.05,Default,,0,0,0,,Келесі жолы қайтуыңызға кепілдік жоқ.
Dialogue: 0,0:15:09.05,0:15:11.08,Default,,0,0,0,,Адам санасын сақтағың келсе
Dialogue: 0,0:15:11.08,0:15:14.02,Default,,0,0,0,,Тым абай болмаңыз.
Dialogue: 0,0:15:14.02,0:15:15.08,Default,,0,0,0,,Түсінгенше көрсетемін
Dialogue: 0,0:15:16.02,0:15:19.04,Default,,0,0,0,,Менің де бұлай қайта жіппен жүргім келмейді.
Dialogue: 0,0:15:25.03,0:15:26.01,Default,,0,0,0,,Не болды?
Dialogue: 0,0:15:26.09,0:15:28.09,Default,,0,0,0,,Мені біреу бақылап тұрғандай сезіндім.
Dialogue: 0,0:15:29.09,0:15:31.07,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:15:31.07,0:15:33.09,Default,,0,0,0,,Мен де айналаны зерттедім.
Dialogue: 0,0:15:33.09,0:15:36.09,Default,,0,0,0,,Менің серіктерімнен бір тау болса да белгі жоқ.
Dialogue: 0,0:15:37.04,0:15:39.04,Default,,0,0,0,,Егер сіз осы нүктеден тыс болсаңыз да
Dialogue: 0,0:15:39.04,0:15:42.09,Default,,0,0,0,,Біздің бар екенімізді әрең байқау сізге байланысты.
Dialogue: 0,0:15:45.00,0:15:46.09,Default,,0,0,0,,Бұл менің қиялым ғана ма?
Dialogue: 0,0:15:50.02,0:15:53.02,Default,,0,0,0,,Осы қашықтықта мені біреу байқайды ма?
Dialogue: 0,0:15:56.05,0:15:59.00,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:15:59.05,0:16:02.09,Default,,0,0,0,,Оянғандай көрінген адамның жындық қуаты тұрақтанды.
Dialogue: 0,0:16:03.05,0:16:05.07,Default,,0,0,0,,Ей, не болып жатыр?
Dialogue: 0,0:16:05.07,0:16:07.06,Default,,0,0,0,,Әлі бірдеңе болды ма?
Dialogue: 0,0:16:07.06,0:16:11.01,Default,,0,0,0,,Жоқ, ояну менің тарапымнан түсінбеушілік сияқты.
Dialogue: 0,0:16:11.05,0:16:13.00,Default,,0,0,0,,Төртеуі де қауіпсіз.
Dialogue: 0,0:16:13.04,0:16:15.00,Default,,0,0,0,,Түсінбеу
Dialogue: 0,0:16:15.00,0:16:17.02,Default,,0,0,0,,Бұл сіз үшін әдеттен тыс.
Dialogue: 0,0:16:17.05,0:16:21.09,Default,,0,0,0,,Мен тіпті бұл қашықтықтан нақты ақпарат ала алмаймын.
Dialogue: 0,0:16:22.05,0:16:26.07,Default,,0,0,0,,Баласын алыстан бақылайтын ата-ана қалыпты болды.
Dialogue: 0,0:16:27.08,0:16:28.09,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:16:28.09,0:16:31.04,Default,,0,0,0,,Төрт жынды есіңе түсір
Dialogue: 0,0:16:31.04,0:16:35.06,Default,,0,0,0,,Бір күні біздің жолдарымыз қиылысуы мүмкін.
Dialogue: 0,0:16:36.05,0:16:37.08,Default,,0,0,0,,Ата-ана ата-ана
Dialogue: 0,0:16:37.08,0:16:39.09,Default,,0,0,0,,Қабан әке дейсіз бе?
Dialogue: 0,0:16:41.09,0:16:44.00,Default,,0,0,0,,Біз осында тараймыз.
Dialogue: 0,0:16:44.00,0:16:45.09,Default,,0,0,0,,Тиісті тапсырмаларға оралыңыз.
Dialogue: 0,0:16:46.04,0:16:49.02,Default,,0,0,0,,Біз берілген тапсырманы орындадық.
Dialogue: 0,0:16:49.06,0:16:51.05,Default,,0,0,0,,Басқа ештеңе болған жоқ
Dialogue: 0,0:16:52.00,0:16:53.00,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:16:53.05,0:16:58.02,Default,,0,0,0,,Біз ұйымның сұрақтарымыз барын білгенін қаламаймыз.
Dialogue: 0,0:16:58.02,0:17:03.04,Default,,0,0,0,,Дұрыс. Бұдан былай ұйымға күдіктенбейтін дәрежеде мойынсұныңыз.
Dialogue: 0,0:17:03.04,0:17:06.00,Default,,0,0,0,,Проблемалық бала бейнесінен арылыңыз
Dialogue: 0,0:17:06.04,0:17:08.02,Default,,0,0,0,,Қандай азап
Dialogue: 0,0:17:08.02,0:17:11.04,Default,,0,0,0,,Әр нәрседе сақ болу қажеттілігі
Dialogue: 0,0:17:11.09,0:17:14.09,Default,,0,0,0,,Егер сіз мұны істесеңіз, біраз уақытқа жетуге болады.
Dialogue: 0,0:17:15.03,0:17:16.09,Default,,0,0,0,,Біраз уақытқа
Dialogue: 0,0:17:17.07,0:17:19.00,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:17:19.06,0:17:23.02,Default,,0,0,0,,Ояну арқылы қабілеттерің артты.
Dialogue: 0,0:17:23.06,0:17:27.01,Default,,0,0,0,,Әрбір сан бір таңбалы санға эквивалент деп айтуға болады.
Dialogue: 0,0:17:27.09,0:17:29.00,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:29.06,0:17:30.09,Default,,0,0,0,,Мен оны шынымен сезіне алмаймын.
Dialogue: 0,0:17:31.02,0:17:33.01,Default,,0,0,0,,Мен кепілдік беремін
Dialogue: 0,0:17:33.01,0:17:35.06,Default,,0,0,0,,Достарыммен төбелесу керек болса да
Dialogue: 0,0:17:35.06,0:17:37.09,Default,,0,0,0,,Мен соншалықты артта қалмауым керек еді.
Dialogue: 0,0:17:38.05,0:17:41.06,Default,,0,0,0,,Алайда 5 және одан жоғары сандар әртүрлі.
Dialogue: 0,0:17:42.02,0:17:46.03,Default,,0,0,0,,Егер сіз бұл жігіттерді кездестірсеңіз, алдымен төбелесу мүмкіндігін тастаңыз.
Dialogue: 0,0:17:47.00,0:17:49.01,Default,,0,0,0,,5-тен көп емес
Dialogue: 0,0:17:49.01,0:17:51.06,Default,,0,0,0,,Бұл Мириядан жақсы екенін білдіреді.
Dialogue: 0,0:17:51.06,0:17:53.03,Default,,0,0,0,,Ең жақсы емес
Dialogue: 0,0:17:53.07,0:17:59.09,Default,,0,0,0,,Шынымды айтсам, 5 саны мен 6 санының арасында үлкен қабырға бар деп ойлағаныңызды қалаймын.
Dialogue: 0,0:18:00.03,0:18:01.05,Default,,0,0,0,,Бұл рас па?
Dialogue: 0,0:18:13.09,0:18:15.07,Default,,0,0,0,,Бұл ең үздік бес адамның белгісі.
Dialogue: 0,0:18:16.01,0:18:17.05,Default,,0,0,0,,Есте сақта
Dialogue: 0,0:18:18.04,0:18:19.06,Default,,0,0,0,,Оң жақтан
Dialogue: 0,0:18:19.06,0:18:21.07,Default,,0,0,0,,№1 Алисия
Dialogue: 0,0:18:22.03,0:18:24.00,Default,,0,0,0,,№2 Бет
Dialogue: 0,0:18:24.07,0:18:27.00,Default,,0,0,0,,№3 Галатея
Dialogue: 0,0:18:27.08,0:18:29.02,Default,,0,0,0,,№ 4
Dialogue: 0,0:18:31.06,0:18:34.00,Default,,0,0,0,,Санға не болды?
Dialogue: 0,0:18:35.00,0:18:38.07,Default,,0,0,0,,Ол достарының немесе басқа адамдардың өмірін ойламайды.
Dialogue: 0,0:18:39.03,0:18:43.00,Default,,0,0,0,,Әсіресе оянған адамдарды аң аулауға құмар.
Dialogue: 0,0:18:43.00,0:18:44.01,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:44.06,0:18:47.05,Default,,0,0,0,,Олай болса біз алыс болуымыз керек.
Dialogue: 0,0:18:47.08,0:18:48.03,Default,,0,0,0,,А
Dialogue: 0,0:18:48.07,0:18:51.01,Default,,0,0,0,,Табиғи емес болса да, жанасудан аулақ болыңыз.
Dialogue: 0,0:18:51.07,0:18:55.07,Default,,0,0,0,,Ұрысқанды, қан төгуді бәрінен де жақсы көретін әйел.
Dialogue: 0,0:18:55.07,0:18:56.08,Default,,0,0,0,,Офелия
Dialogue: 0,0:18:57.03,0:18:58.07,Default,,0,0,0,,Бұл белгі
Dialogue: 0,0:19:01.04,0:19:04.02,Default,,0,0,0,,және 5 саны Лафира
Dialogue: 0,0:19:12.06,0:19:14.09,Default,,0,0,0,,Енді не істейсіз?
Dialogue: 0,0:19:15.02,0:19:18.05,Default,,0,0,0,,Ұйымды зерттеуді жалғастырамын.
Dialogue: 0,0:19:19.01,0:19:23.00,Default,,0,0,0,,Әсіресе оятуға қатысты, егер мен бірдеңе білсем, мен сізге бірден хабарлаймын.
Dialogue: 0,0:19:23.06,0:19:25.07,Default,,0,0,0,,Сіз мұны жалғыз жасауды жоспарлап отырсыз ба?
Dialogue: 0,0:19:26.02,0:19:29.03,Default,,0,0,0,,Бізге бірігу қауіптірек.
Dialogue: 0,0:19:29.03,0:19:35.00,Default,,0,0,0,,Ал бұл ұйымның бізден құтылуға тырысатыны жай ғана гипотеза.
Dialogue: 0,0:19:35.05,0:19:37.07,Default,,0,0,0,,Ешқандай дәлел жоқ
Dialogue: 0,0:19:37.07,0:19:40.05,Default,,0,0,0,,Достарыңызбен орынсыз қарсыласудың қажеті жоқ.
Dialogue: 0,0:19:41.00,0:19:42.06,Default,,0,0,0,,Бірақ сақтықты төмендетпеңіз
Dialogue: 0,0:19:42.06,0:19:45.07,Default,,0,0,0,,Барлығына айтарым, сақтықты түсірмеңдер.
Dialogue: 0,0:20:04.06,0:20:06.02,Default,,0,0,0,,Тағы да бәрі
Dialogue: 0,0:20:06.06,0:20:08.00,Default,,0,0,0,,Тірі кездесейік
Dialogue: 0,0:20:17.04,0:20:20.08,Default,,0,0,0,,Бір күні жолымыз қиылысатын шығар?
Dialogue: 0,0:20:22.00,0:20:26.04,Default,,0,0,0,,Маған жету үшін қанша адам аман қалады?
Dialogue: 0,0:20:27.03,0:20:30.02,Default,,0,0,0,,Бұл шынында да тікенді жол.
Dialogue: 0,0:20:43.09,0:20:45.09,Default,,0,0,0,,Бала, берілме
Dialogue: 0,0:20:45.09,0:20:49.04,Default,,0,0,0,,Сол тауға кіріп, қайтып келген балшық емделмейді.
Dialogue: 0,0:20:49.08,0:20:50.09,Default,,0,0,0,,Мен қайтамын
Dialogue: 0,0:20:51.04,0:20:53.02,Default,,0,0,0,,Клэр уәдесінде тұр
Dialogue: 0,0:20:56.09,0:20:57.09,Default,,0,0,0,,Қайтып кел
Dialogue: 0,0:21:08.09,0:21:10.00,Default,,0,0,0,,Клэр
Dialogue: 0,0:21:16.04,0:21:17.09,Default,,0,0,0,,Клэр
Dialogue: 0,0:21:19.03,0:21:20.03,Default,,0,0,0,,Аман бол
Dialogue: 0,0:21:20.07,0:21:21.09,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:21:22.02,0:21:23.02,Default,,0,0,0,,Клэр
Dialogue: 0,0:22:40.04,0:22:42.03,Default,,0,0,0,,Қанды жол
Dialogue: 0,0:22:42.03,0:22:43.08,Default,,0,0,0,,Қанды жауынгер
Dialogue: 0,0:22:43.09,0:22:46.05,Default,,0,0,0,,Уәде етілген уақыт
Dialogue: 0,0:22:47.55,0:22:52.55,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
