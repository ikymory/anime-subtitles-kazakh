Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Бұл стратегияның сәтті болу ықтималдығы қандай?
Dialogue: 0,0:00:07.00,0:00:11.00,Default,,0,0,0,,Бұл стратегияның сәтті болу ықтималдығы нөлге тең.
Dialogue: 0,0:00:11.04,0:00:15.03,Default,,0,0,0,,Оянған Прискиланы аман алып, басын кесіп тастаңыз
Dialogue: 0,0:00:17.06,0:00:21.05,Default,,0,0,0,,Бұл шайқастан бірге аман өтейік.
Dialogue: 0,0:00:22.08,0:00:24.05,Default,,0,0,0,,Мұнда біздің достарымыз бар.
Dialogue: 0,0:00:25.00,0:00:28.02,Default,,0,0,0,,Егер сіз мұны жалғыз жасай алмасаңыз, біз сізді қолдаймыз.
Dialogue: 0,0:00:28.06,0:00:34.02,Default,,0,0,0,,Сондықтан өзіңізді көп уайымдамаңыз, капитан Ундин.
Dialogue: 0,0:00:34.06,0:00:38.06,Default,,0,0,0,,Бір рет тұңғиықтан бірдеңені кездестірсеңіз, түсінесіз.
Dialogue: 0,0:00:39.04,0:00:41.02,Default,,0,0,0,,Бұлай емес
Dialogue: 0,0:00:41.02,0:00:45.07,Default,,0,0,0,,Сол тұңғиықтағы нәрсе, егер Солтүстік Исли байыпты болса.
Dialogue: 0,0:00:46.08,0:00:47.08,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:02:12.08,0:02:14.09,Default,,0,0,0,,Енді оңтүстікке барыңыз
Dialogue: 0,0:02:15.06,0:02:17.03,Default,,0,0,0,,Пиетаға барыңыз
Dialogue: 0,0:02:18.06,0:02:23.02,Default,,0,0,0,,Біз жеткенше бәрі бітуі керек.
Dialogue: 0,0:02:38.07,0:02:41.08,Default,,0,0,0,,Сіз Пьетадасыз ба? Клэр
Dialogue: 0,0:03:12.03,0:03:15.05,Default,,0,0,0,,Олар өткен жолғы жігіттерден мүлде басқаша.
Dialogue: 0,0:03:15.07,0:03:16.07,Default,,0,0,0,,О
Dialogue: 0,0:03:17.00,0:03:18.04,Default,,0,0,0,,Ертегі сапасы
Dialogue: 0,0:03:18.05,0:03:19.06,Default,,0,0,0,,Көлемі де
Dialogue: 0,0:03:19.08,0:03:21.00,Default,,0,0,0,,Сан
Dialogue: 0,0:03:21.00,0:03:22.05,Default,,0,0,0,,Барлығы
Dialogue: 0,0:03:47.00,0:03:48.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:03:48.06,0:03:52.07,Default,,0,0,0,,Сол үшеуі қайтып келмейді ме?
Dialogue: 0,0:03:57.00,0:04:01.04,Default,,0,0,0,,Бұл үшеуі барлауға жарамсыз еді.
Dialogue: 0,0:04:01.04,0:04:04.09,Default,,0,0,0,,Мен оның басынан бастап бақылаудан шығып жатқанын көрдім.
Dialogue: 0,0:04:05.03,0:04:07.07,Default,,0,0,0,,Маған қалдырсаңыз
Dialogue: 0,0:04:07.07,0:04:08.09,Default,,0,0,0,,It's okay.
Dialogue: 0,0:04:08.09,0:04:10.09,Default,,0,0,0,,Қайтып келмесең де
Dialogue: 0,0:04:11.09,0:04:16.07,Default,,0,0,0,,Әу бастан жоғалтып алсам да қиналмайтын адамды жібердім.
Dialogue: 0,0:04:17.06,0:04:24.07,Default,,0,0,0,,Мен Пиета қаласының сол үш Оянғанды ​​жеңуге күші бар екенін білемін.
Dialogue: 0,0:04:25.00,0:04:26.06,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:04:28.09,0:04:32.00,Default,,0,0,0,,Мен саған оны маған қалдыр десем де,
Dialogue: 0,0:04:32.01,0:04:37.09,Default,,0,0,0,,Менің үйімде от жағылса, сен бірінші болып бақылаудан шығасың.
Dialogue: 0,0:04:39.01,0:04:41.02,Default,,0,0,0,,Күміс көзді арыстан патша
Dialogue: 0,0:04:43.06,0:04:46.06,Default,,0,0,0,,Мүмкін болса, аты
Dialogue: 0,0:04:47.02,0:04:48.03,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:04:48.03,0:04:50.02,Default,,0,0,0,,Бұл көп уақыт бұрын.
Dialogue: 0,0:04:51.04,0:04:56.04,Default,,0,0,0,,Қалай болғанда да, егер Пиета сонша күшке ие болса,
Dialogue: 0,0:04:56.04,0:04:59.05,Default,,0,0,0,,Біз оны сәйкесінше шешуіміз керек.
Dialogue: 0,0:05:01.04,0:05:02.06,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:05:03.05,0:05:06.00,Default,,0,0,0,,Оянғандарды жина
Dialogue: 0,0:05:06.07,0:05:09.01,Default,,0,0,0,,Оңтүстікке баратын жолды бекітіңіз
Dialogue: 0,0:05:09.01,0:05:10.00,Default,,0,0,0,,Га
Dialogue: 0,0:05:27.03,0:05:34.06,Default,,0,0,0,,Солтүстік армия, барлығы 27, Альфонс бастаған қала Пиетаны жойды.
Dialogue: 0,0:05:35.01,0:05:39.09,Default,,0,0,0,,Бұл өмір жоқ қала болар.
Dialogue: 0,0:05:40.02,0:05:42.07,Default,,0,0,0,,Менің Эйсли есімімен
Dialogue: 0,0:05:43.02,0:05:47.01,Default,,0,0,0,,Тіпті бір жәндіктің өмірін құрту
Dialogue: 0,0:06:01.05,0:06:03.03,Default,,0,0,0,,Тұрғындарды эвакуациялау
Dialogue: 0,0:06:03.03,0:06:05.04,Default,,0,0,0,,Қазірдің өзінде аяқталды
Dialogue: 0,0:06:05.08,0:06:07.07,Default,,0,0,0,,Зардап шеккен адамның жағдайы қандай?
Dialogue: 0,0:06:07.07,0:06:11.01,Default,,0,0,0,,Юманың сол қолы мінсіз болмаса да,
Dialogue: 0,0:06:11.01,0:06:13.08,Default,,0,0,0,,Юки шайқаста проблема болмайды.
Dialogue: 0,0:06:14.02,0:06:15.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:17.04,0:06:20.08,Default,,0,0,0,,Қанша адам аман қалады?
Dialogue: 0,0:06:22.00,0:06:24.06,Default,,0,0,0,,Жоқ, не болса да
Dialogue: 0,0:06:47.03,0:06:48.08,Default,,0,0,0,,Аман бол
Dialogue: 0,0:07:25.07,0:07:26.06,Default,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:07:33.00,0:07:34.03,Default,,0,0,0,,Памела
Dialogue: 0,0:07:36.05,0:07:38.03,Default,,0,0,0,,Дәлдік
Dialogue: 0,0:07:40.09,0:07:41.09,Default,,0,0,0,,Сабырымен шашып тастар еді.
Dialogue: 0,0:07:59.02,0:08:01.05,Default,,0,0,0,,Әрқашан аман бол
Dialogue: 0,0:08:02.01,0:08:04.08,Default,,0,0,0,,Міндетті түрде өмір сүріңіз
Dialogue: 0,0:08:21.01,0:08:22.02,Default,,0,0,0,,Эйсли
Dialogue: 0,0:08:26.05,0:08:27.06,Default,,0,0,0,,алыс
Dialogue: 0,0:08:27.06,0:08:31.00,Default,,0,0,0,,Өмір бірінен соң бірі жоғалады
Dialogue: 0,0:08:31.09,0:08:34.05,Default,,0,0,0,,Бұл сүйкімді.
Dialogue: 0,0:08:42.04,0:08:43.08,Default,,0,0,0,,Келесі кезекте біз
Dialogue: 0,0:08:44.03,0:08:46.05,Default,,0,0,0,,Пиета әлі алыс
Dialogue: 0,0:08:54.02,0:08:55.00,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:09:03.02,0:09:04.00,Default,,0,0,0,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:09:10.08,0:09:12.06,Default,,0,0,0,,Бұл туралы ма?
Dialogue: 0,0:09:12.06,0:09:15.08,Default,,0,0,0,,Оянған адамның да күші көп емес.
Dialogue: 0,0:09:16.03,0:09:19.03,Default,,0,0,0,,Қозаке
Dialogue: 0,0:09:20.01,0:09:21.02,Default,,0,0,0,,Енді Денев
Dialogue: 0,0:09:41.07,0:09:42.05,Default,,0,0,0,,Он бір
Dialogue: 0,0:09:50.03,0:09:51.04,Default,,0,0,0,,Қараңызшы, бұл осылай.
Dialogue: 0,0:10:18.09,0:10:21.03,Default,,0,0,0,,Сіз қанша қашып кетесіз?
Dialogue: 0,0:10:40.07,0:10:42.08,Default,,0,0,0,,Сен қайда жасырдың?
Dialogue: 0,0:11:22.05,0:11:25.00,Default,,0,0,0,,Бұл тым көп уақыт алып жатыр.
Dialogue: 0,0:11:25.04,0:11:27.02,Default,,0,0,0,,Біздің шығынымыз үшеу
Dialogue: 0,0:11:27.02,0:11:28.06,Default,,0,0,0,,Мына жақта бес па?
Dialogue: 0,0:11:29.04,0:11:31.01,Default,,0,0,0,,Мен сене алар емеспін
Dialogue: 0,0:11:31.03,0:11:33.02,Default,,0,0,0,,Әскери күштердің айырмашылығын қарастыру
Dialogue: 0,0:11:33.02,0:11:35.03,Default,,0,0,0,,Соғыс жағдайы ғажайып болды деуге болады.
Dialogue: 0,0:11:38.08,0:11:39.06,Default,,0,0,0,,отбасы құру
Dialogue: 0,0:11:40.03,0:11:41.01,Default,,0,0,0,,Буггарати мен басқалары шынында да осы пойызға мініпті
Dialogue: 0,0:11:41.08,0:11:42.06,Default,,0,0,0,,Үш
Dialogue: 0,0:11:43.03,0:11:44.01,Default,,0,0,0,,Төрт
Dialogue: 0,0:11:44.09,0:11:45.06,Default,,0,0,0,,Бес
Dialogue: 0,0:11:46.08,0:11:49.04,Default,,0,0,0,,Бес мықты адам
Dialogue: 0,0:11:49.07,0:11:54.03,Default,,0,0,0,,Бұл бес адам жеке мүшелерді шайқасқа апара ма?
Dialogue: 0,0:12:15.00,0:12:16.00,Default,,0,0,0,,Эйсли
Dialogue: 0,0:12:16.04,0:12:17.08,Default,,0,0,0,,Прискила жоқ
Dialogue: 0,0:12:19.08,0:12:20.09,Default,,0,0,0,,Бұл
Dialogue: 0,0:12:23.07,0:12:24.08,Default,,0,0,0,,Прискила
Dialogue: 0,0:12:25.09,0:12:27.02,Default,,0,0,0,,Прискила
Dialogue: 0,0:12:31.06,0:12:33.09,Default,,0,0,0,,Прискила
Dialogue: 0,0:12:37.06,0:12:39.07,Default,,0,0,0,,Канжу Нагаре
Dialogue: 0,0:12:42.03,0:12:43.06,Default,,0,0,0,,Канжу Нагаре
Dialogue: 0,0:12:44.06,0:12:45.08,Default,,0,0,0,,Прискила
Dialogue: 0,0:12:51.03,0:12:52.03,Default,,0,0,0,,Яғни
Dialogue: 0,0:13:31.01,0:13:32.04,Default,,0,0,0,,Прискила
Dialogue: 0,0:13:32.09,0:13:34.01,Default,,0,0,0,,Жақсы
Dialogue: 0,0:13:34.01,0:13:35.05,Default,,0,0,0,,уайымдады
Dialogue: 0,0:13:40.06,0:13:43.05,Default,,0,0,0,,А, міне, солай!
Dialogue: 0,0:13:59.02,0:14:00.02,Default,,0,0,0,,Прискила
Dialogue: 0,0:14:10.05,0:14:12.06,Default,,0,0,0,,Кешіріңіз, Мирия-сан.
Dialogue: 0,0:14:19.00,0:14:20.07,Default,,0,0,0,,Тым көп
Dialogue: 0,0:14:21.03,0:14:22.05,Default,,0,0,0,,Хаа… Хаа… Хаа…
Dialogue: 0,0:14:33.05,0:14:35.07,Default,,0,0,0,,А, қайда бардың?
Dialogue: 0,0:14:36.06,0:14:38.00,Default,,0,0,0,,Не болды?
Dialogue: 0,0:14:40.03,0:14:41.03,Default,,0,0,0,,Не?
Dialogue: 0,0:14:43.01,0:14:44.06,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:47.03,0:14:49.03,Default,,0,0,0,,Не болды, Клэр?
Dialogue: 0,0:14:50.05,0:14:51.05,Default,,0,0,0,,бірдеңе
Dialogue: 0,0:14:52.03,0:14:55.04,Default,,0,0,0,,Бір қорқынышты нәрсе келе жатыр.
Dialogue: 0,0:15:10.09,0:15:12.07,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:15:12.07,0:15:15.06,Default,,0,0,0,,Бұл шарасыз жағдайда
Dialogue: 0,0:15:15.08,0:15:19.07,Default,,0,0,0,,Қандай да бір жолмен аман қалудың жолын табуға тырысу
Dialogue: 0,0:15:20.05,0:15:26.03,Default,,0,0,0,,Бірақ біз бұдан былай әскери күшімізді жоғалта алмаймыз.
Dialogue: 0,0:15:37.01,0:15:38.00,Default,,0,0,0,,Кира — бұл жолы тым ыңғайлы болып кетті — мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:15:41.03,0:15:44.02,Default,,0,0,0,,Бұл Ригардо
Dialogue: 0,0:15:45.00,0:15:46.09,Default,,0,0,0,,Күміс көзді арыстан патша
Dialogue: 0,0:15:47.03,0:15:48.06,Default,,0,0,0,,Ригалдо
Dialogue: 0,0:15:50.05,0:15:52.08,Default,,0,0,0,,Неліктен мұнда?
Dialogue: 0,0:15:56.03,0:15:57.09,Default,,0,0,0,,Ең алдымен, бір адам
Dialogue: 0,0:16:02.09,0:16:05.01,Default,,0,0,0,,Пероника
Dialogue: 0,0:16:06.04,0:16:07.09,Default,,0,0,0,,Артыңызда, капитан.
Dialogue: 0,0:16:11.08,0:16:12.09,Default,,0,0,0,,Хо
Dialogue: 0,0:16:16.01,0:16:17.09,Default,,0,0,0,,Ол үлкен мәселе.
Dialogue: 0,0:16:18.04,0:16:19.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:16:21.05,0:16:22.07,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,0:16:23.08,0:16:25.04,Default,,0,0,0,,Екінші тұлға
Dialogue: 0,0:16:27.05,0:16:28.08,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:16:30.01,0:16:31.03,Default,,0,0,0,,Болдырмау
Dialogue: 0,0:16:45.09,0:16:47.03,Default,,0,0,0,,Жын
Dialogue: 0,0:16:54.03,0:16:55.02,Default,,0,0,0,,Жын
Dialogue: 0,0:17:37.01,0:17:38.03,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:17:38.06,0:17:39.06,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:17:40.02,0:17:41.06,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:17:42.05,0:17:44.06,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:17:45.04,0:17:48.00,Default,,0,0,0,,Бұл не, әке?
Dialogue: 0,0:17:48.02,0:17:49.04,Default,,0,0,0,,Ана деген не?
Dialogue: 0,0:18:20.03,0:18:22.03,Default,,0,0,0,,Мистер Исли
Dialogue: 0,0:18:23.02,0:18:25.02,Default,,0,0,0,,Присцилла осында болды ма?
Dialogue: 0,0:18:26.05,0:18:29.02,Default,,0,0,0,,Сіз әлі де өз қалауыңыз бойынша қозғаласыз.
Dialogue: 0,0:18:33.08,0:18:36.07,Default,,0,0,0,,Мистер Исли, сіз білесіз бе?
Dialogue: 0,0:18:37.00,0:18:38.08,Default,,0,0,0,,Прискила - жын
Dialogue: 0,0:18:40.03,0:18:41.08,Default,,0,0,0,,Жын емес
Dialogue: 0,0:18:41.09,0:18:43.03,Default,,0,0,0,,Оянған адам.
Dialogue: 0,0:18:44.02,0:18:46.01,Default,,0,0,0,,Адам қандай болды
Dialogue: 0,0:18:51.03,0:18:53.01,Default,,0,0,0,,Жоқ, Присцилла.
Dialogue: 0,0:18:53.01,0:18:55.03,Default,,0,0,0,,Сіз мұны істей алмайсыз.
Dialogue: 0,0:18:55.06,0:18:56.08,Default,,0,0,0,,Прискила
Dialogue: 0,0:19:00.01,0:19:01.04,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:19:01.07,0:19:03.05,Default,,0,0,0,,Бұлай жасамаңыз.
Dialogue: 0,0:19:05.05,0:19:07.05,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:19:08.05,0:19:11.02,Default,,0,0,0,,Прискила, мұны доғар.
Dialogue: 0,0:19:13.09,0:19:15.06,Default,,0,0,0,,Жылама, Присцилла
Dialogue: 0,0:19:15.07,0:19:18.02,Default,,0,0,0,,Тоқта, Присцилла.
Dialogue: 0,0:19:18.02,0:19:19.06,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:19:19.09,0:19:22.03,Default,,0,0,0,,Тоқта, тоқта
Dialogue: 0,0:19:24.01,0:19:26.09,Default,,0,0,0,,Тоқта, Присцилла
Dialogue: 0,0:19:29.01,0:19:31.02,Default,,0,0,0,,Ген Неге ешкім қабырғаға өрмелеп шығуға тырыспайды?
Dialogue: 0,0:19:31.04,0:19:32.08,Default,,0,0,0,,Флораны қорғау
Dialogue: 0,0:19:37.08,0:19:40.07,Default,,0,0,0,,Бұл жігіт жасақ басшысын жойғысы келеді.
Dialogue: 0,0:19:50.02,0:19:51.04,Default,,0,0,0,,Он тоғыз
Dialogue: 0,0:20:00.01,0:20:01.03,Default,,0,0,0,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:20:04.00,0:20:05.03,Default,,0,0,0,,21
Dialogue: 0,0:20:16.08,0:20:18.08,Default,,0,0,0,,Қ–… Сен, порноман!
Dialogue: 0,0:20:28.05,0:20:30.08,Default,,0,0,0,,Ген
Dialogue: 0,0:20:45.03,0:20:48.03,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:22:40.04,0:22:42.03,Default,,0,0,0,,Жарықтың шашырауы
Dialogue: 0,0:22:42.03,0:22:43.08,Default,,0,0,0,,Жарық жоғалады
Dialogue: 0,0:22:43.09,0:22:46.05,Default,,0,0,0,,Шыдамсыздықтың артуы
Dialogue: 0,0:22:47.55,0:22:52.55,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
