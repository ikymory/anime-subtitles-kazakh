Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.68,0:00:05.12,Default - Copy,Clare,0,0,0,,Бұл стратегияның сәтті болу ықтималдығы қандай?
Dialogue: 0,0:00:07.02,0:00:11.02,Default - Copy,Miria,0,0,0,,Бұл стратегияның сәтті болу ықтималдығы нөлге тең.
Dialogue: 0,0:00:11.46,0:00:15.39,Default - Copy,Clare,0,0,0,,Оянған Прискиланы аман алып, басын кесіп тастаңыз
Dialogue: 0,0:00:17.60,0:00:21.57,Default - Copy,Flora,0,0,0,,Бұл шайқастан бірге аман өтейік.
Dialogue: 0,0:00:22.83,0:00:24.57,Default - Copy,Deneve,0,0,0,,Мұнда біздің достарымыз бар.
Dialogue: 0,0:00:25.04,0:00:28.27,Default - Copy,Deneve,0,0,0,,Егер сіз мұны жалғыз жасай алмасаңыз, біз сізді қолдаймыз.
Dialogue: 0,0:00:28.67,0:00:34.25,Default - Copy,Deneve,0,0,0,,Сондықтан өзіңізді көп уайымдамаңыз, капитан Ундин.
Dialogue: 0,0:00:34.65,0:00:38.68,Default - Copy,Miria,0,0,0,,Бір рет тұңғиықтан бірдеңені кездестірсеңіз, түсінесіз.
Dialogue: 0,0:00:39.48,0:00:41.25,Default - Copy,Miria,0,0,0,,Бұлай емес
Dialogue: 0,0:00:41.25,0:00:45.79,Default - Copy,Miria,0,0,0,,Сол тұңғиықтағы нәрсе, егер Солтүстік Исли байыпты болса.
Dialogue: 0,0:00:46.86,0:00:47.81,Default - Copy,Clare,0,0,0,,Келіңіздер
Dialogue: 0,0:02:12.88,0:02:14.95,Default - Copy,Easley,0,0,0,,Енді оңтүстікке барыңыз
Dialogue: 0,0:02:15.61,0:02:17.32,Default - Copy,Easley,0,0,0,,Пиетаға барыңыз
Dialogue: 0,0:02:18.68,0:02:23.22,Default - Copy,Easley,0,0,0,,Біз жеткенше бәрі бітуі керек.
Dialogue: 0,0:02:38.77,0:02:41.84,Default - Copy,Raki,0,0,0,,Сіз Пьетадасыз ба? Клэр
Dialogue: 0,0:03:12.30,0:03:15.54,Default - Copy,Miria,0,0,0,,Олар өткен жолғы жігіттерден мүлде басқаша.
Dialogue: 0,0:03:15.77,0:03:16.71,Default - Copy,Clare,0,0,0,,О
Dialogue: 0,0:03:17.04,0:03:18.48,Default - Copy,Clare,0,0,0,,Ертегі сапасы
Dialogue: 0,0:03:18.58,0:03:19.65,Default - Copy,Clare,0,0,0,,Көлемі де
Dialogue: 0,0:03:19.88,0:03:21.08,Default - Copy,Clare,0,0,0,,Сан
Dialogue: 0,0:03:21.08,0:03:22.58,Default - Copy,Clare,0,0,0,,Барлығы
Dialogue: 0,0:03:47.01,0:03:48.67,Default - Copy,Easley,0,0,0,,Мен көремін.
Dialogue: 0,0:03:48.67,0:03:52.78,Default - Copy,Easley,0,0,0,,Сол үшеуі қайтып келмейді ме?
Dialogue: 0,0:03:57.08,0:04:01.42,Default - Copy,Rigardo,0,0,0,,Бұл үшеуі барлауға жарамсыз еді.
Dialogue: 0,0:04:01.42,0:04:04.92,Default - Copy,Rigardo,0,0,0,,Мен оның басынан бастап бақылаудан шығып жатқанын көрдім.
Dialogue: 0,0:04:05.32,0:04:07.73,Default - Copy,Rigardo,0,0,0,,Маған қалдырсаңыз
Dialogue: 0,0:04:07.73,0:04:08.96,Default - Copy,Easley,0,0,0,,It's okay.
Dialogue: 0,0:04:08.96,0:04:10.93,Default - Copy,Easley,0,0,0,,Қайтып келмесең де
Dialogue: 0,0:04:11.90,0:04:16.74,Default - Copy,Easley,0,0,0,,Әу бастан жоғалтып алсам да қиналмайтын адамды жібердім.
Dialogue: 0,0:04:17.64,0:04:24.74,Default - Copy,Easley,0,0,0,,Мен Пиета қаласының сол үш Оянғанды ​​жеңуге күші бар екенін білемін.
Dialogue: 0,0:04:25.04,0:04:26.65,Default - Copy,Easley,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:04:28.98,0:04:32.08,Default - Copy,Easley,0,0,0,,Мен саған оны маған қалдыр десем де,
Dialogue: 0,0:04:32.18,0:04:37.99,Default - Copy,Easley,0,0,0,,Менің үйімде от жағылса, сен бірінші болып бақылаудан шығасың.
Dialogue: 0,0:04:39.12,0:04:41.23,Default - Copy,Easley,0,0,0,,Күміс көзді арыстан патша
Dialogue: 0,0:04:43.63,0:04:46.60,Default - Copy,Rigardo,0,0,0,,Мүмкін болса, аты
Dialogue: 0,0:04:47.23,0:04:48.33,Default - Copy,Easley,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:04:48.33,0:04:50.27,Default - Copy,Easley,0,0,0,,Бұл көп уақыт бұрын.
Dialogue: 0,0:04:51.44,0:04:56.41,Default - Copy,Easley,0,0,0,,Қалай болғанда да, егер Пиета сонша күшке ие болса,
Dialogue: 0,0:04:56.44,0:04:59.58,Default - Copy,Easley,0,0,0,,Біз оны сәйкесінше шешуіміз керек.
Dialogue: 0,0:05:01.45,0:05:02.68,Default - Copy,Easley,0,0,0,,Уақыт келді
Dialogue: 0,0:05:03.52,0:05:06.02,Default - Copy,Easley,0,0,0,,Оянғандарды жина
Dialogue: 0,0:05:06.72,0:05:09.19,Default - Copy,Easley,0,0,0,,Оңтүстікке баратын жолды бекітіңіз
Dialogue: 0,0:05:09.19,0:05:10.02,Default - Copy,Rigardo,0,0,0,,Га
Dialogue: 0,0:05:27.31,0:05:34.65,Default - Copy,Easley,0,0,0,,Солтүстік армия, барлығы 27, Альфонс бастаған қала Пиетаны жойды.
Dialogue: 0,0:05:35.18,0:05:39.99,Default - Copy,Rigardo,0,0,0,,Бұл өмір жоқ қала болар.
Dialogue: 0,0:05:40.29,0:05:42.72,Default - Copy,Easley,0,0,0,,Менің Эйсли есімімен
Dialogue: 0,0:05:43.22,0:05:47.19,Default - Copy,Rigardo,0,0,0,,Тіпті бір жәндіктің өмірін құрту
Dialogue: 0,0:06:01.57,0:06:03.38,Default - Copy,Miria,0,0,0,,Тұрғындарды эвакуациялау
Dialogue: 0,0:06:03.38,0:06:05.48,Default - Copy,Flora,0,0,0,,Қазірдің өзінде аяқталды
Dialogue: 0,0:06:05.81,0:06:07.78,Default - Copy,Miria,0,0,0,,Зардап шеккен адамның жағдайы қандай?
Dialogue: 0,0:06:07.78,0:06:11.18,Default - Copy,Flora,0,0,0,,Юманың сол қолы мінсіз болмаса да,
Dialogue: 0,0:06:11.18,0:06:13.85,Default - Copy,Flora,0,0,0,,Юки шайқаста проблема болмайды.
Dialogue: 0,0:06:14.25,0:06:15.55,Default - Copy,Miria,0,0,0,,Мен көремін.
Dialogue: 0,0:06:17.42,0:06:20.83,Default - Copy,Miria,0,0,0,,Қанша адам аман қалады?
Dialogue: 0,0:06:22.06,0:06:24.63,Default - Copy,Miria,0,0,0,,Жоқ, не болса да
Dialogue: 0,0:06:47.32,0:06:48.82,Default - Copy,Miria,0,0,0,,Аман бол
Dialogue: 0,0:07:25.72,0:07:26.66,Default - Copy,Helen,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:07:33.03,0:07:34.37,Default - Copy,Veronica,0,0,0,,Памела
Dialogue: 0,0:07:36.54,0:07:38.37,Default - Copy,Undine,0,0,0,,Дәлдік
Dialogue: 0,0:07:40.94,0:07:41.97,Default - Copy,Undine,0,0,0,,Сабырымен шашып тастар еді.
Dialogue: 0,0:07:59.26,0:08:01.59,Default - Copy,Clare,0,0,0,,Әрқашан аман бол
Dialogue: 0,0:08:02.13,0:08:04.86,Default - Copy,Clare,0,0,0,,Міндетті түрде өмір сүріңіз
Dialogue: 0,0:08:21.15,0:08:22.25,Default - Copy,Raki,0,0,0,,Эйсли
Dialogue: 0,0:08:26.55,0:08:27.65,Default - Copy,Easley,0,0,0,,алыс
Dialogue: 0,0:08:27.65,0:08:31.02,Default - Copy,Easley,0,0,0,,Өмір бірінен соң бірі жоғалады
Dialogue: 0,0:08:31.92,0:08:34.53,Default - Copy,Easley,0,0,0,,Бұл сүйкімді.
Dialogue: 0,0:08:42.40,0:08:43.80,Default - Copy,Easley,0,0,0,,Келесі кезекте біз
Dialogue: 0,0:08:44.37,0:08:46.54,Default - Copy,Easley,0,0,0,,Пиета әлі алыс
Dialogue: 0,0:08:54.25,0:08:55.01,Default - Copy,Deneve,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:09:03.26,0:09:04.09,Default - Copy,Deneve,0,0,0,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:09:10.80,0:09:12.66,Default - Copy,Undine,0,0,0,,Бұл туралы ма?
Dialogue: 0,0:09:12.66,0:09:15.80,Default - Copy,Undine,0,0,0,,Оянған адамның да күші көп емес.
Dialogue: 0,0:09:16.37,0:09:19.37,Default - Copy,A.B.,0,0,0,,Қозаке
Dialogue: 0,0:09:20.14,0:09:21.21,Default - Copy,Undine,0,0,0,,Енді Денев
Dialogue: 0,0:09:41.73,0:09:42.56,Default - Copy,Jeane,0,0,0,,Он бір
Dialogue: 0,0:09:50.37,0:09:51.47,Default - Copy,Helen,0,0,0,,Қараңызшы, бұл осылай.
Dialogue: 0,0:10:18.96,0:10:21.33,Default - Copy,A.B.,0,0,0,,Сіз қанша қашып кетесіз?
Dialogue: 0,0:10:40.79,0:10:42.89,Default - Copy,A.B.,0,0,0,,Сен қайда жасырдың?
Dialogue: 0,0:11:22.59,0:11:25.06,Default - Copy,Rigardo,0,0,0,,Бұл тым көп уақыт алып жатыр.
Dialogue: 0,0:11:25.43,0:11:27.27,Default - Copy,Rigardo,0,0,0,,Біздің шығынымыз үшеу
Dialogue: 0,0:11:27.27,0:11:28.60,Default - Copy,Rigardo,0,0,0,,Мына жақта бес па?
Dialogue: 0,0:11:29.40,0:11:31.10,Default - Copy,Rigardo,0,0,0,,Мен сене алар емеспін
Dialogue: 0,0:11:31.37,0:11:33.27,Default - Copy,Rigardo,0,0,0,,Әскери күштердің айырмашылығын қарастыру
Dialogue: 0,0:11:33.27,0:11:35.37,Default - Copy,Rigardo,0,0,0,,Соғыс жағдайы ғажайып болды деуге болады.
Dialogue: 0,0:11:38.81,0:11:39.68,Default - Copy,Rigardo,0,0,0,,отбасы құру
Dialogue: 0,0:11:40.35,0:11:41.18,Default - Copy,Rigardo,0,0,0,,Буггарати мен басқалары шынында да осы пойызға мініпті
Dialogue: 0,0:11:41.88,0:11:42.68,Default - Copy,Rigardo,0,0,0,,Үш
Dialogue: 0,0:11:43.38,0:11:44.18,Default - Copy,Rigardo,0,0,0,,Төрт
Dialogue: 0,0:11:44.92,0:11:45.62,Default - Copy,Rigardo,0,0,0,,Бес
Dialogue: 0,0:11:46.85,0:11:49.42,Default - Copy,Rigardo,0,0,0,,Бес мықты адам
Dialogue: 0,0:11:49.79,0:11:54.36,Default - Copy,Rigardo,0,0,0,,Бұл бес адам жеке мүшелерді шайқасқа апара ма?
Dialogue: 0,0:12:15.01,0:12:16.08,Default - Copy,Raki,0,0,0,,Эйсли
Dialogue: 0,0:12:16.41,0:12:17.85,Default - Copy,Raki,0,0,0,,Прискила жоқ
Dialogue: 0,0:12:19.88,0:12:20.92,Default - Copy,Raki,0,0,0,,Бұл
Dialogue: 0,0:12:23.76,0:12:24.89,Default - Copy,Raki,0,0,0,,Прискила
Dialogue: 0,0:12:25.99,0:12:27.23,Default - Copy,Raki,0,0,0,,Прискила
Dialogue: 0,0:12:31.63,0:12:32.80,Default - Copy,Raki,0,0,0,,Прискила
Dialogue: 0,0:12:32.80,0:12:33.97,Default - Copy,Raki,0,0,0,,Прискила
Dialogue: 0,0:12:37.64,0:12:39.74,Default - Copy,woman,0,0,0,,Канжу Нагаре
Dialogue: 0,0:12:42.34,0:12:43.61,Default - Copy,Raki,0,0,0,,Канжу Нагаре
Dialogue: 0,0:12:44.64,0:12:45.81,Default - Copy,Raki,0,0,0,,Прискила
Dialogue: 0,0:12:51.35,0:12:52.32,Default - Copy,Raki,0,0,0,,Яғни
Dialogue: 0,0:13:31.19,0:13:32.46,Default - Copy,Raki,0,0,0,,Прискила
Dialogue: 0,0:13:32.99,0:13:34.16,Default - Copy,Raki,0,0,0,,Жақсы
Dialogue: 0,0:13:34.16,0:13:35.59,Default - Copy,Raki,0,0,0,,уайымдады
Dialogue: 0,0:13:40.63,0:13:43.57,Default - Copy,Raki,0,0,0,,А, міне, солай!
Dialogue: 0,0:13:59.22,0:14:00.25,Default - Copy,Raki,0,0,0,,Прискила
Dialogue: 0,0:14:10.50,0:14:12.60,Default - Copy,clay,0,0,0,,Кешіріңіз, Мирия-сан.
Dialogue: 0,0:14:19.00,0:14:20.71,Default - Copy,Miria,0,0,0,,Тым көп
Dialogue: 0,0:14:21.31,0:14:22.57,Default - Copy,Miria,0,0,0,,Хаа… Хаа… Хаа…
Dialogue: 0,0:14:33.52,0:14:35.72,Default - Copy,Helen,0,0,0,,А, қайда бардың?
Dialogue: 0,0:14:36.62,0:14:38.06,Default - Copy,etc,0,0,0,,Не болды?
Dialogue: 0,0:14:40.36,0:14:41.39,Default - Copy,Miria,0,0,0,,Не?
Dialogue: 0,0:14:43.13,0:14:44.63,Default - Copy,Undine,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:47.37,0:14:49.30,Default - Copy,Helen,0,0,0,,Не болды, Клэр?
Dialogue: 0,0:14:50.50,0:14:51.50,Default - Copy,Clare,0,0,0,,бірдеңе
Dialogue: 0,0:14:52.30,0:14:55.47,Default - Copy,Clare,0,0,0,,Бір қорқынышты нәрсе келе жатыр.
Dialogue: 0,0:15:10.92,0:15:12.79,Default - Copy,Rigardo,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:15:12.79,0:15:15.69,Default - Copy,Rigardo,0,0,0,,Бұл шарасыз жағдайда
Dialogue: 0,0:15:15.89,0:15:19.73,Default - Copy,Rigardo,0,0,0,,Қандай да бір жолмен аман қалудың жолын табуға тырысу
Dialogue: 0,0:15:20.53,0:15:26.34,Default - Copy,Rigardo,0,0,0,,Бірақ біз бұдан былай әскери күшімізді жоғалта алмаймыз.
Dialogue: 0,0:15:37.12,0:15:38.05,Default - Copy,Miria,0,0,0,,Кира — бұл жолы тым ыңғайлы болып кетті — мен Жапон тергеу басқармасы арасындағы сөйлесулерге қарағанда,
Dialogue: 0,0:15:41.35,0:15:44.22,Default - Copy,Miria,0,0,0,,Бұл Ригардо
Dialogue: 0,0:15:45.09,0:15:46.99,Default - Copy,Miria,0,0,0,,Күміс көзді арыстан патша
Dialogue: 0,0:15:47.33,0:15:48.63,Default - Copy,Miria,0,0,0,,Ригалдо
Dialogue: 0,0:15:50.56,0:15:52.80,Default - Copy,Miria,0,0,0,,Неліктен мұнда?
Dialogue: 0,0:15:56.37,0:15:57.94,Default - Copy,Rigardo,0,0,0,,Ең алдымен, бір адам
Dialogue: 0,0:16:02.94,0:16:05.14,Default - Copy,Helen,0,0,0,,Пероника
Dialogue: 0,0:16:06.48,0:16:07.98,Default - Copy,Deneve,0,0,0,,Артыңызда, капитан.
Dialogue: 0,0:16:11.82,0:16:12.98,Default - Copy,Rigardo,0,0,0,,Хо
Dialogue: 0,0:16:16.12,0:16:17.99,Default - Copy,Rigardo,0,0,0,,Ол үлкен мәселе.
