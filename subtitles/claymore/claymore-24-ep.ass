Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.75,0:00:05.32,Default - Copy,Rigardo,0,0,0,,Сол қыранды аз уақыттың ішінде өзіңдікі қылдың ба?
Dialogue: 0,0:00:06.34,0:00:07.75,Default - Copy,Rigardo,0,0,0,,Керемет
Dialogue: 0,0:00:14.66,0:00:15.63,Default - Copy,Easley,0,0,0,,Ригалдо
Dialogue: 0,0:00:16.16,0:00:17.33,Default - Copy,Easley,0,0,0,,(Әйелдің айғайы)
Dialogue: 0,0:02:03.87,0:02:06.11,Default - Copy,Helen,0,0,0,,жасадыңыз
Dialogue: 0,0:02:07.47,0:02:08.54,Default - Copy,Deneve,0,0,0,,Сол жігіт
Dialogue: 0,0:02:10.21,0:02:11.31,Default - Copy,Miria,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:02:15.35,0:02:18.08,Default - Copy,Helen,0,0,0,,Жарайсың Денев Милия
Dialogue: 0,0:02:18.08,0:02:19.84,Default - Copy,Helen,0,0,0,,Клэр мұны жасады
Dialogue: 0,0:02:20.59,0:02:24.16,Default - Copy,Deneve,0,0,0,,Мені әрқашан таң қалдырады
Dialogue: 0,0:02:25.42,0:02:27.58,Default - Copy,Helen,0,0,0,,Әпке, қазір бәрі жақсы.
Dialogue: 0,0:02:27.99,0:02:30.40,Default - Copy,Helen,0,0,0,,Сіз ұйықтап жатқанда емес.
Dialogue: 0,0:02:33.16,0:02:34.63,Default - Copy,Helen,0,0,0,,Бәріңе
Dialogue: 0,0:02:34.63,0:02:37.02,Default - Copy,Helen,0,0,0,,Клэр арыстан жігітті жеңді.
Dialogue: 0,0:02:37.60,0:02:38.74,Default - Copy,all,0,0,0,,Хоша
Dialogue: 0,0:02:38.74,0:02:40.27,Default - Copy,all,0,0,0,,Сіз мұны жасадыңыз.
Dialogue: 0,0:02:44.94,0:02:45.71,Default - Copy,Miria,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:03:01.13,0:03:04.46,Default - Copy,Easley,0,0,0,,Сол күміс көзді арыстан патшаны жеңу
Dialogue: 0,0:03:05.14,0:03:06.87,Default - Copy,Easley,0,0,0,,Бұл өте керемет.
Dialogue: 0,0:03:11.00,0:03:12.00,Default - Copy,Easley,0,0,0,,Прискила
Dialogue: 0,0:03:12.97,0:03:14.07,Default - Copy,Easley,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:27.45,0:03:30.12,Default - Copy,Easley,0,0,0,,Ол мүлде мазасыз бала.
Dialogue: 0,0:03:39.83,0:03:41.33,Default - Copy,Helen,0,0,0,,Клэр, жеткілікті.
Dialogue: 0,0:03:41.33,0:03:42.48,Default - Copy,Helen,0,0,0,,Ұстаңыз
Dialogue: 0,0:03:47.61,0:03:48.61,Default - Copy,Clare,0,0,0,,Мүмкін емес
Dialogue: 0,0:03:49.01,0:03:51.61,Default - Copy,Clare,0,0,0,,Маған жақындама
Dialogue: 0,0:03:52.84,0:03:58.23,Default - Copy,Clare,0,0,0,,Бұл дене енді менің санамда емес.
Dialogue: 0,0:03:58.88,0:03:59.73,Default - Copy,Helen,0,0,0,,Клэр
Dialogue: 0,0:04:00.69,0:04:01.55,Default - Copy,Clare,0,0,0,,Хелен
Dialogue: 0,0:04:02.75,0:04:04.97,Default - Copy,Clare,0,0,0,,Менің бір өтінішім бар
Dialogue: 0,0:04:07.29,0:04:10.83,Default - Copy,Clare,0,0,0,,Менің басымды кес
Dialogue: 0,0:04:12.96,0:04:18.40,Default - Copy,Clare,0,0,0,,Дененің оянуы оны тоқтатуға болмайтын дәрежеге жетті.
Dialogue: 0,0:04:18.87,0:04:21.82,Default - Copy,Clare,0,0,0,,Мен енді қайтып бара алмаймын.
Dialogue: 0,0:04:22.24,0:04:25.69,Default - Copy,Helen,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:04:26.04,0:04:30.42,Default - Copy,Clare,0,0,0,,Соңғы күшіммен қылыштың қозғалуын тоқтатамын.
Dialogue: 0,0:04:31.15,0:04:35.19,Default - Copy,Clare,0,0,0,,Осы арада менің басымды кесіп алсаңыз екен деймін.
Dialogue: 0,0:04:36.85,0:04:38.67,Default - Copy,Jeane,0,0,0,,Клэр
Dialogue: 0,0:04:39.19,0:04:40.43,Default - Copy,Clare,0,0,0,,Кешіріңіз
Dialogue: 0,0:04:41.43,0:04:43.39,Default - Copy,Clare,0,0,0,,Біреуді ұнамсыз рөлге айналдыру
Dialogue: 0,0:04:43.39,0:04:44.76,Default - Copy,Helen,0,0,0,,Бұл алғашқы «Глория».
Dialogue: 0,0:04:44.76,0:04:48.42,Default - Copy,Helen,0,0,0,,Оның толық оянатыны әлі шешілген жоқ деп ойлаймын.
Dialogue: 0,0:04:49.13,0:04:50.47,Default - Copy,Clare,0,0,0,,Хеленнен сұраңыз
Dialogue: 0,0:04:51.14,0:04:53.02,Default - Copy,Clare,0,0,0,,бірақ мұнда қатты шу, иә?
Dialogue: 0,0:04:53.02,0:04:54.17,Default - Copy,Helen,0,0,0,,Мүмкін емес
Dialogue: 0,0:04:54.17,0:04:56.97,Default - Copy,Helen,0,0,0,,Өздігінен бас тартпа.
Dialogue: 0,0:04:57.54,0:05:03.31,Default - Copy,Clare,0,0,0,,Артқа қайта алмайтыныңды өзің ғана білесің.
Dialogue: 0,0:05:10.32,0:05:11.26,Default - Copy,Helen,0,0,0,,Клэр
Dialogue: 0,0:06:26.30,0:06:27.70,Default - Copy,Priscilla,0,0,0,,Үлкен аға
Dialogue: 0,0:06:59.60,0:07:00.15,Default - Copy,Priscilla,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:07:06.54,0:07:08.21,Default - Copy,Irene,0,0,0,,Көңілсіз болмаңыз
Dialogue: 0,0:07:08.21,0:07:12.33,Default - Copy,Irene,0,0,0,,Артыңнан ермегенімізде басың түсіп қалар еді.
Dialogue: 0,0:07:12.81,0:07:14.95,Default - Copy,Irene,0,0,0,,Сізде бар күшпен
Dialogue: 0,0:07:14.95,0:07:17.58,Default - Copy,Irene,0,0,0,,Терезаны өлтіру туралы ойланыңыз.
Dialogue: 0,0:07:25.69,0:07:26.66,Default - Copy,Prisicilla,0,0,0,,Тереза
Dialogue: 0,0:07:28.56,0:07:30.80,Default - Copy,Prisicilla,0,0,0,,Мен кіммін?
Dialogue: 0,0:07:42.11,0:07:43.31,Default - Copy,Teresa,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:07:48.95,0:07:52.25,Default - Copy,Priscilla,0,0,0,,Ол сондай мейірімді әке еді.
Dialogue: 0,0:07:53.18,0:07:55.95,Default - Copy,Priscilla,0,0,0,,Әкемді жақсы көрсем де
Dialogue: 0,0:07:56.39,0:07:58.09,Default - Copy,Priscilla,0,0,0,,Мен оны жедім.
Dialogue: 0,0:07:59.32,0:08:02.06,Default - Copy,Priscilla,0,0,0,,Менің алдымда
Dialogue: 0,0:08:02.06,0:08:06.96,Default - Copy,Priscilla,0,0,0,,Барлығының ішкі мүшелерін жедім.
Dialogue: 0,0:08:08.07,0:08:11.00,Default - Copy,Priscilla,0,0,0,,Сондықтан мен оны өлтірдім.
Dialogue: 0,0:08:11.00,0:08:13.71,Default - Copy,Priscilla,0,0,0,,Әпкемді жеп жатқанда
Dialogue: 0,0:08:13.71,0:08:18.61,Default - Copy,Priscilla,0,0,0,,Мен әкемнің басын кесіп алдым
Dialogue: 0,0:08:20.35,0:08:21.95,Default - Copy,Priscilla,0,0,0,,Қайтару жоқ
Dialogue: 0,0:08:22.78,0:08:24.62,Default - Copy,Priscilla,0,0,0,,Бұл мүмкін емес қой?
Dialogue: 0,0:08:25.38,0:08:27.20,Default - Copy,Priscilla,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:08:27.49,0:08:34.39,Default - Copy,Teresa,0,0,0,,Менің қолымнан келетіні – жынға айналмай тұрып, басыңды кесіп тастау.
Dialogue: 0,0:08:37.86,0:08:40.37,Default - Copy,Priscilla,0,0,0,,Жоқ, бұл мен емес.
Dialogue: 0,0:08:41.03,0:08:42.20,Default - Copy,Priscilla,0,0,0,,Мен емес
Dialogue: 0,0:08:47.87,0:08:49.31,Default - Copy,Priscilla,0,0,0,,Не?
Dialogue: 0,0:08:49.91,0:08:53.81,Default - Copy,Priscilla,0,0,0,,Ешқашан ештеңені ұстап тұрудың қажеті болмады.
Dialogue: 0,0:08:54.75,0:08:59.98,Default - Copy,Priscilla,0,0,0,,Оның соншалықты жақсы болғанына сене алар емеспін
Dialogue: 0,0:09:06.36,0:09:10.29,Default - Copy,Priscilla,0,0,0,,Мен сенің әпкеңді қалаймын
Dialogue: 0,0:09:10.29,0:09:12.10,Default - Copy,Priscilla,0,0,0,,Папаның жауы
Dialogue: 0,0:09:30.01,0:09:32.32,Default - Copy,Priscilla,0,0,0,,Біз оқиға орнына бірінші жетеміз.
Dialogue: 0,0:09:45.10,0:09:46.20,Default - Copy,Priscilla,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:09:48.07,0:09:49.37,Default - Copy,Priscilla,0,0,0,,Біз ойлағаннан ертерек кездесе аламыз.
Dialogue: 0,0:09:50.60,0:09:52.37,Default - Copy,Priscilla,0,0,0,,Оның арқасында
Dialogue: 0,0:10:01.21,0:10:02.33,Default - Copy,Helen,0,0,0,,Клэр
Dialogue: 0,0:10:02.78,0:10:04.52,Default - Copy,Clare,0,0,0,,Хеленнен сұраңыз
Dialogue: 0,0:10:06.68,0:10:10.59,Default - Copy,Clare,0,0,0,,Өтінемін, адамдық сана-сезім бұзылмай өлуге рұқсат етіңіз.
Dialogue: 0,0:10:16.73,0:10:17.60,Default - Copy,Clare,0,0,0,,Раки
Dialogue: 0,0:10:18.13,0:10:20.18,Default - Copy,Clare,0,0,0,,Уәдесінде тұрмады
Dialogue: 0,0:10:21.20,0:10:24.44,Default - Copy,Clare,0,0,0,,Мен сені қайта көргім келді
Dialogue: 0,0:10:34.65,0:10:36.08,Default - Copy,Jeane,0,0,0,,Клэр
Dialogue: 0,0:10:42.29,0:10:43.66,Default - Copy,Helen,0,0,0,,Қарғыс атсын
Dialogue: 0,0:10:43.66,0:10:45.82,Default - Copy,Helen,0,0,0,,Сізге осылай еліктеп көрейін
Dialogue: 0,0:10:46.96,0:10:47.76,Default - Copy,Helen,0,0,0,,Сәлем
Dialogue: 0,0:10:48.36,0:10:50.53,Default - Copy,Helen,0,0,0,,Мен сені ешқашан кешірмеймін
Dialogue: 0,0:10:51.20,0:10:54.43,Default - Copy,Clare,0,0,0,,Кешіріңіз, Хелен
Dialogue: 0,0:10:58.10,0:11:00.17,Default - Copy,Jeane,0,0,0,,Жоқ, Хелен.
Dialogue: 0,0:11:00.67,0:11:01.91,Default - Copy,Helen,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:11:11.22,0:11:12.42,Default - Copy,Deneve,0,0,0,,Не?
Dialogue: 0,0:11:16.45,0:11:18.64,Default - Copy,Clare,0,0,0,,Сен шынымен де тамаша ФБР агенті болдың.
Dialogue: 0,0:11:37.58,0:11:38.44,Default - Copy,Clare,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:39.28,0:11:42.71,Default - Copy,Priscilla,0,0,0,,Қалай тірісің?
Dialogue: 0,0:11:44.32,0:11:48.97,Default - Copy,Priscilla,0,0,0,,Мен оны сол кезде өлтіруім керек еді.
Dialogue: 0,0:11:50.09,0:11:51.72,Default - Copy,Priscilla,0,0,0,,(Жануарлар дүкенінің қызметкері) Хмм… Таныс өсірушімнен сұрайын ба?
Dialogue: 0,0:11:52.12,0:11:54.39,Default - Copy,Priscilla,0,0,0,,Ұйымға қарсы шыққанына қарамастан
Dialogue: 0,0:11:55.43,0:11:58.76,Default - Copy,Priscilla,0,0,0,,Сен мені осылай сезіндірсең де
Dialogue: 0,0:12:05.94,0:12:07.24,Default - Copy,Clare,0,0,0,,Күмән жоқ
Dialogue: 0,0:12:07.91,0:12:09.22,Default - Copy,Clare,0,0,0,,Біз ойлағаннан ертерек кездесе аламыз.
Dialogue: 0,0:12:09.54,0:12:12.84,Default - Copy,Priscilla,0,0,0,,Сондықтан мен сені тағы да өлтіремін.
Dialogue: 0,0:12:12.84,0:12:14.45,Default - Copy,Priscilla,0,0,0,,Сол кездегідей
Dialogue: 0,0:12:20.32,0:12:21.65,Default - Copy,Clare,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:12:22.25,0:12:23.69,Default - Copy,Clare,0,0,0,,Тек сен
Dialogue: 0,0:12:24.22,0:12:27.46,Default - Copy,Clare,0,0,0,,Кеше… Ах…
Dialogue: 0,0:12:41.47,0:12:42.52,Default - Copy,Helen,0,0,0,,Клэр
Dialogue: 0,0:13:03.06,0:13:04.50,Default - Copy,Rubel,0,0,0,,Өтінемін, Ятоны құтқарыңдар!
Dialogue: 0,0:13:06.60,0:13:08.23,Default - Copy,Galatea,0,0,0,,Неге сен?
Dialogue: 0,0:13:10.03,0:13:11.74,Default - Copy,Rubel,0,0,0,,Бұл жағдай
Dialogue: 0,0:13:12.14,0:13:14.07,Default - Copy,Rubel,0,0,0,,Бізде жұмыс күші жетіспейді.
Dialogue: 0,0:13:14.91,0:13:16.91,Default - Copy,Rubel,0,0,0,,Бағыну отряды деп те аталады.
Dialogue: 0,0:13:17.38,0:13:19.28,Default - Copy,Rubel,0,0,0,,Солтүстікке қарай жүріңіз
Dialogue: 0,0:13:20.35,0:13:24.58,Default - Copy,Rubel,0,0,0,,Сіздің жұмысыңыз барлау ғана.
Dialogue: 0,0:13:26.18,0:13:29.72,Default - Copy,Rubel,0,0,0,,Басқа кез келген нәрсе ұйымға опасыздық болып саналады.
Dialogue: 0,0:13:30.96,0:13:32.89,Default - Copy,Galatea,0,0,0,,Сіз оянған сияқтысыз.
Dialogue: 0,0:13:33.73,0:13:36.41,Default - Copy,Galatea,0,0,0,,Менің ойымша, біреу біледі.
Dialogue: 0,0:13:37.53,0:13:42.43,Default - Copy,Rubel,0,0,0,,Мұны тек сіз түсіне аласыз.
Dialogue: 0,0:13:49.44,0:13:52.24,Default - Copy,Easley,0,0,0,,Прискила сіздің де есіңізде ме?
Dialogue: 0,0:13:53.65,0:13:57.18,Default - Copy,Easley,0,0,0,,Бүгінде көп нәрсе болып жатыр.
Dialogue: 0,0:13:59.02,0:14:00.45,Default - Copy,Easley,0,0,0,,«Шағып алған» деген сөзді әдемі айтыпсың, иә?
Dialogue: 0,0:14:01.09,0:14:02.24,Default - Copy,Easley,0,0,0,,(Присцилла Барриэлл) Бұл мен естіген ең жалықтырарлық, мағынасыз әңгіме.
Dialogue: 0,0:14:15.23,0:14:17.00,Default - Copy,Easley,0,0,0,,Мұны істеудің қажеті жоқ.
Dialogue: 0,0:14:17.67,0:14:20.71,Default - Copy,Easley,0,0,0,,Мен қазірдің өзінде көңілді болдым.
Dialogue: 0,0:14:22.41,0:14:24.44,Default - Copy,Easley,0,0,0,,Рұқсатсыз өлмейсің.
Dialogue: 0,0:14:24.94,0:14:27.91,Default - Copy,Easley,0,0,0,,Маған тағы біраз қарап көрейін.
Dialogue: 0,0:14:33.58,0:14:37.29,Default - Copy,Miria,0,0,0,,Синтия мен Табита жарақат алған серіктерімен бірге сеніп тапсырылды.
Dialogue: 0,0:14:37.92,0:14:38.86,Default - Copy,Helen,0,0,0,,Клэр
Dialogue: 0,0:14:40.09,0:14:42.43,Default - Copy,Miria,0,0,0,,Менің жын іздеуден басқа амалым жоқ шығар.
Dialogue: 0,0:14:43.09,0:14:47.37,Default - Copy,Miria,0,0,0,,Бұл қиын тапсырма, бірақ басқа амал жоқ.
Dialogue: 0,0:14:49.47,0:14:51.87,Default - Copy,Helen,0,0,0,,Сіз Клэрді қуып жете аламын деп ойлайсыз ба?
Dialogue: 0,0:14:53.71,0:14:56.26,Default - Copy,Miria,0,0,0,,Қиын десем ше?
Dialogue: 0,0:14:56.41,0:14:57.61,Default - Copy,Helen,0,0,0,,Мені жалғыз қалдырмаңыз
Dialogue: 0,0:14:57.61,0:14:59.91,Default - Copy,Helen,0,0,0,,Клэрді кез келген жағдайда табыңыз
Dialogue: 0,0:15:04.02,0:15:07.49,Default - Copy,Miria,0,0,0,,Ол да солай ойласа керек.
Dialogue: 0,0:15:13.73,0:15:18.43,Default - Copy,Deneve,0,0,0,,Қабір маркеріне досымның бір қылышы жетеді.
Dialogue: 0,0:15:20.23,0:15:21.63,Default - Copy,Deneve,0,0,0,,Капитан Ундин
Dialogue: 0,0:15:24.20,0:15:27.14,Default - Copy,Deneve,0,0,0,,Кешіріңіз, бірақ мен сізді аламын.
Dialogue: 0,0:15:33.08,0:15:34.41,Default - Copy,Helen,0,0,0,,Бұл сіздікі ме?
Dialogue: 0,0:15:47.36,0:15:48.78,Default - Copy,Miria,0,0,0,,Хелен, кеттік.
Dialogue: 0,0:15:51.60,0:15:53.46,Default - Copy,Helen,0,0,0,,Ол енді келмейді.
Dialogue: 0,0:16:06.54,0:16:08.78,Default - Copy,Helen,0,0,0,,Осыған сенімдісіз бе?
Dialogue: 0,0:16:09.21,0:16:10.05,Default - Copy,Miria,0,0,0,,О
Dialogue: 0,0:16:10.52,0:16:11.62,Default - Copy,Miria,0,0,0,,Мүмкін
Dialogue: 0,0:16:12.15,0:16:12.98,Default - Copy,Helen,0,0,0,,Өзіңді тым биік ұстама
Dialogue: 0,0:16:14.09,0:16:15.05,Default - Copy,Helen,0,0,0,,Клэр
Dialogue: 0,0:16:16.05,0:16:18.26,Default - Copy,Miria,0,0,0,,Елес үзік-үзік.
Dialogue: 0,0:16:18.76,0:16:20.36,Default - Copy,Miria,0,0,0,,Қарлы боранның салдарынан ба?
Dialogue: 0,0:16:20.36,0:16:22.39,Default - Copy,Miria,0,0,0,,Немесе қазірдің өзінде
Dialogue: 0,0:16:24.26,0:16:25.20,Default - Copy,Deneve,0,0,0,,Яғни
Dialogue: 0,0:16:27.03,0:16:30.00,Default - Copy,Miria,0,0,0,,№3 Галатея
Dialogue: 0,0:16:32.44,0:16:37.11,Default - Copy,Galatea,0,0,0,,Менің ойымша, сендер ондай қулық жасай алмайсыңдар.
Dialogue: 0,0:16:37.74,0:16:39.54,Default - Copy,Deneve,0,0,0,,Біздің барлаушы?
Dialogue: 0,0:16:40.41,0:16:41.91,Default - Copy,Galatea,0,0,0,,Егер солай болса
Dialogue: 0,0:16:43.75,0:16:48.25,Default - Copy,Helen,0,0,0,,Кешіріңіз, бірақ мен Клэрді табу үшін қолдан келгеннің бәрін жасаймын.
Dialogue: 0,0:16:51.89,0:16:52.96,Default - Copy,Galatea,0,0,0,,Хо
Dialogue: 0,0:16:53.26,0:16:56.63,Default - Copy,Galatea,0,0,0,,Сіз осында өлуді жоспарлап отырған сияқтысыз.
Dialogue: 0,0:17:06.07,0:17:08.27,Default - Copy,Galatea,0,0,0,,Уақытты тиімді пайдаланыңыз
Dialogue: 0,0:17:14.65,0:17:17.48,Default - Copy,Galatea,0,0,0,,Ол оңай жеңілетін қарсылас емес.
Dialogue: 0,0:17:20.39,0:17:21.62,Default - Copy,Miria,0,0,0,,Галатея
Dialogue: 0,0:17:25.62,0:17:27.06,Default - Copy,Helen,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:17:27.93,0:17:32.26,Default - Copy,Galatea,0,0,0,,Мен ғана басқа адамды Йокимен өлшей аламын.
Dialogue: 0,0:17:32.86,0:17:34.63,Default - Copy,Galatea,0,0,0,,Жоқ, Мирия
Dialogue: 0,0:17:35.13,0:17:38.17,Default - Copy,Miria,0,0,0,,Клэр оны жеңе ала ма?
Dialogue: 0,0:17:38.49,0:17:40.10,Default - Copy,Galatea,0,0,0,,Саана
Dialogue: 0,0:17:40.10,0:17:42.87,Default - Copy,Galatea,0,0,0,,Бірақ бұл өте қиын.
Dialogue: 0,0:17:42.87,0:17:43.94,Default - Copy,Helen,0,0,0,,Екінші тарап
Dialogue: 0,0:17:43.94,0:17:45.71,Default - Copy,Helen,0,0,0,,Екінші тарап кім?
Dialogue: 0,0:17:47.25,0:17:48.88,Default - Copy,Galatea,0,0,0,,Менің атым Присцилла
Dialogue: 0,0:17:50.11,0:17:56.50,Default - Copy,Galatea,0,0,0,,Ол бір кездері ең күшті деп аталып кеткен №1 `` Күлімсіреу Терезасын '' өлтірген әйел.
Dialogue: 0,0:17:57.69,0:17:58.72,Default - Copy,Miria,0,0,0,,Келесі шайқас!
Dialogue: 0,0:17:59.52,0:18:00.46,Default - Copy,Galatea,0,0,0,,Тездетіңіз
Dialogue: 0,0:18:00.83,0:18:02.73,Default - Copy,Galatea,0,0,0,,Мені құтқарғың келсе.
Dialogue: 0,0:18:04.96,0:18:07.97,Default - Copy,Miria,0,0,0,,Галатея Кешіріңіз.
Dialogue: 0,0:18:08.40,0:18:09.30,Default - Copy,Miria,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:18:17.24,0:18:19.44,Default - Copy,Jeane,0,0,0,,Егер сізде керемет естеліктер болмаса
Dialogue: 0,0:18:19.44,0:18:21.21,Default - Copy,Jeane,0,0,0,,Басынан бастап жылама
Dialogue: 0,0:18:22.55,0:18:25.32,Default - Copy,Jeane,0,0,0,,Асықпасақ, Клэр өледі.
Dialogue: 0,0:18:26.18,0:18:27.99,Default - Copy,Jeane,0,0,0,,Бұл сөзсіз дұрыс
Dialogue: 0,0:18:29.82,0:18:31.72,Default - Copy,Raki,0,0,0,,Өйткені, И
Dialogue: 0,0:18:32.49,0:18:33.96,Default - Copy,Raki,0,0,0,,Бұл менің аузым ғана болды.
Dialogue: 0,0:18:36.06,0:18:37.96,Default - Copy,Raki,0,0,0,,Маған талай рет көмектессең де.
Dialogue: 0,0:18:39.00,0:18:41.07,Default - Copy,Raki,0,0,0,,Сен маған талай рет жақсы қарадың.
Dialogue: 0,0:18:41.67,0:18:43.63,Default - Copy,Raki,0,0,0,,Мен ештеңе істей алмадым
Dialogue: 0,0:18:45.17,0:18:46.44,Default - Copy,Raki,0,0,0,,Мен қорқып кеттім
Dialogue: 0,0:18:47.67,0:18:50.17,Default - Copy,Raki,0,0,0,,Мен тек өз өмірімді ойладым
Dialogue: 0,0:18:51.84,0:18:53.34,Default - Copy,Raki,0,0,0,,Менің өлгім келмеді
Dialogue: 0,0:18:55.28,0:18:56.71,Default - Copy,Raki,0,0,0,,Мен ең нашармын
Dialogue: 0,0:18:59.32,0:19:00.62,Default - Copy,Jeane,0,0,0,,Бұған не болды?
Dialogue: 0,0:19:03.79,0:19:05.32,Default - Copy,Jeane,0,0,0,,Мен барамын
Dialogue: 0,0:19:05.32,0:19:07.78,Default - Copy,Jeane,0,0,0,,Не болса да
Dialogue: 0,0:19:09.93,0:19:10.78,Default - Copy,Raki,0,0,0,,Неліктен?
Dialogue: 0,0:19:12.43,0:19:15.33,Default - Copy,Jeane,0,0,0,,Себебі мен Клэрге көмектескім келеді.
Dialogue: 0,0:19:36.15,0:19:39.26,Default - Copy,Raki,0,0,0,,I am I am
Dialogue: 0,0:19:46.43,0:19:47.40,Default - Copy,Raki,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:20:18.26,0:20:19.30,Default - Copy,Helen,0,0,0,,Клэр
Dialogue: 0,0:20:20.00,0:20:23.50,Default - Copy,Helen,0,0,0,,Біз жеткенше өлмеңдер.
Dialogue: 0,0:21:03.27,0:21:07.09,Default - Copy,Easley,0,0,0,,Маған қарап көрейін, Присцилла.
Dialogue: 0,0:21:10.01,0:21:11.32,Default - Copy,Clare,0,0,0,,Яғни… өз санаңды біреудің санасымен алмастыру—
Dialogue: 0,0:21:13.02,0:21:14.62,Default - Copy,Clare,0,0,0,,Тек сен
Dialogue: 0,0:21:15.89,0:21:19.72,Default - Copy,Clare,0,0,0,,Ешқашан кешірме
Dialogue: 0,0:21:24.16,0:21:28.17,Default - Copy,Clare,0,0,0,,Прискила
Dialogue: 0,0:22:40.40,0:22:42.30,Default - Copy,,0,0,0,,Өткенмен өмір сүру
Dialogue: 0,0:22:42.30,0:22:43.84,Default - Copy,,0,0,0,,Өткенде өлу
Dialogue: 0,0:22:43.94,0:22:46.54,Default - Copy,,0,0,0,,Талғампаз күлкі
Dialogue: 0,0:22:48.04,0:22:54.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory