Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:07.06,Default,,0,0,0,,Басқа адамның тәбеті қалыпты емес сияқты. Балалар, сендер менімен тең емессіңдер.
Dialogue: 0,0:00:09.09,0:00:10.07,Default,,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:00:10.07,0:00:11.04,Default,,0,0,0,,Олар – аң, ал біз – аңшылар!
Dialogue: 0,0:00:31.08,0:00:32.07,Default,,0,0,0,,Не?
Dialogue: 0,0:00:32.07,0:00:33.08,Default,,0,0,0,,Не шу?
Dialogue: 0,0:00:35.06,0:00:36.01,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:00:39.09,0:00:40.05,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:00:44.01,0:00:45.06,Default,,0,0,0,,Өлген жоқсың ба?
Dialogue: 0,0:00:48.05,0:00:51.08,Default,,0,0,0,,Жоқ, жүрегім әрең соғып тұр.
Dialogue: 0,0:00:52.07,0:00:55.00,Default,,0,0,0,,Эй, не болды, Гарк?
Dialogue: 0,0:00:55.03,0:00:57.00,Default,,0,0,0,,Оны жай қалдырыңыз.
Dialogue: 0,0:00:57.00,0:00:57.50,Default,,0,0,0,,Мұндай құбыжық
Dialogue: 0,0:00:59.01,0:01:00.06,Default,,0,0,0,,Өмір сақталды
Dialogue: 0,0:01:01.02,0:01:02.04,Default,,0,0,0,,Қарыздарды өтеу
Dialogue: 0,0:01:02.08,0:01:05.01,Default,,0,0,0,,Жартылай жын болсаң да
Dialogue: 0,0:02:17.00,0:02:17.50,Default,,0,0,0,,Клэр
Dialogue: 0,0:02:18.08,0:02:19.06,Default,,0,0,0,,Клэр
Dialogue: 0,0:02:20.09,0:02:22.08,Default,,0,0,0,,Эй, Клэр жақсы.
Dialogue: 0,0:02:23.05,0:02:25.07,Default,,0,0,0,,Менің жартылай адам, жартылай жын денем үшін
Dialogue: 0,0:02:25.07,0:02:28.01,Default,,0,0,0,,Мен бұл туралы не істерімді білмеймін.
Dialogue: 0,0:02:29.01,0:02:29.51,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:02:30.05,0:02:32.02,Default,,0,0,0,,Содан кейін Клэр
Dialogue: 0,0:02:32.02,0:02:33.03,Default,,0,0,0,,Мен өлемін
Dialogue: 0,0:02:34.02,0:02:38.00,Default,,0,0,0,,Бұл жай ғана бір-бірін өлтірген жын мен жартылай адам және жартылай жын болды.
Dialogue: 0,0:02:38.03,0:02:40.08,Default,,0,0,0,,Бізге шу шығару емес.
Dialogue: 0,0:02:42.09,0:02:43.08,Default,,0,0,0,,Сәлем
Dialogue: 0,0:02:43.08,0:02:47.09,Default,,0,0,0,,Клэр әрқашан шайқаста өз өмірін құрбан етуге дайын болды.
Dialogue: 0,0:02:47.09,0:02:49.03,Default,,0,0,0,,Біз адамдар үшін
Dialogue: 0,0:02:50.01,0:02:52.02,Default,,0,0,0,,Клэр мені көтеріп алды.
Dialogue: 0,0:02:52.09,0:02:55.05,Default,,0,0,0,,Сол кезде қандай бақытты едім
Dialogue: 0,0:02:56.03,0:03:00.06,Default,,0,0,0,,Клэр қарапайым адамдарға қарағанда әлдеқайда мейірімді және жүрегі әдемірек.
Dialogue: 0,0:03:04.01,0:03:05.06,Default,,0,0,0,,Мен байсалдымын
Dialogue: 0,0:03:06.04,0:03:08.03,Default,,0,0,0,,Мен өз миссияма қайта ораламын.
Dialogue: 0,0:03:11.02,0:03:12.02,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:03:13.09,0:03:15.07,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:03:16.02,0:03:17.01,Default,,0,0,0,,Жылама
Dialogue: 0,0:03:18.00,0:03:19.06,Default,,0,0,0,,Әлі біткен жоқ
Dialogue: 0,0:03:20.05,0:03:22.06,Default,,0,0,0,,Иманды жүрек қуатқа айналады
Dialogue: 0,0:03:23.03,0:03:26.02,Default,,0,0,0,,Сөзсіз, аз болса да.
Dialogue: 0,0:03:27.09,0:03:29.01,Default,,0,0,0,,Мен сенемін
Dialogue: 0,0:03:29.08,0:03:31.05,Default,,0,0,0,,Ол құтқарылады.
Dialogue: 0,0:03:57.09,0:04:00.04,Default,,0,0,0,,А, сен ояусың ба?
Dialogue: 0,0:04:00.08,0:04:02.03,Default,,0,0,0,,Кешіріңіз, діни қызметкер.
Dialogue: 0,0:04:02.08,0:04:04.01,Default,,0,0,0,,Сіз оны шешкен сияқтысыз
Dialogue: 0,0:04:04.08,0:04:06.06,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:04:07.01,0:04:08.07,Default,,0,0,0,,Содан бері неше күн өтті?
Dialogue: 0,0:04:09.01,0:04:10.09,Default,,0,0,0,,Иә, екі күн болады.
Dialogue: 0,0:04:11.06,0:04:17.07,Default,,0,0,0,,Осы уақытта Раки-сан жаныңда тұрып, сенің оянуыңды сұрап жатты.
Dialogue: 0,0:04:24.01,0:04:25.05,Default,,0,0,0,,Кешіріңіз, бірақ діни қызметкер
Dialogue: 0,0:04:25.05,0:04:26.04,Default,,0,0,0,,Менің бір өтінішім бар
Dialogue: 0,0:04:30.09,0:04:31.09,Default,,0,0,0,,епископ Винсент
Dialogue: 0,0:04:32.06,0:04:34.06,Default,,0,0,0,,Түнде не болып жатыр?
Dialogue: 0,0:04:36.02,0:04:38.09,Default,,0,0,0,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:04:38.09,0:04:41.09,Default,,0,0,0,,Осы нұсқауларды біраз уақытқа орындағаныңызды қалаймын.
Dialogue: 0,0:04:41.09,0:04:43.07,Default,,0,0,0,,епископ Винсент
Dialogue: 0,0:04:43.07,0:04:46.01,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:04:47.08,0:04:49.04,Default,,0,0,0,,Бұл жынның өзгеруі.
Dialogue: 0,0:04:50.00,0:04:52.04,Default,,0,0,0,,Сіз өзгересіз
Dialogue: 0,0:04:52.04,0:04:55.04,Default,,0,0,0,,Мен оны біздің ішімізде жасырады деп ешқашан ойламаппын.
Dialogue: 0,0:04:55.04,0:04:59.02,Default,,0,0,0,,Өкінішке орай, осы уақытқа дейінгі жағдайға қарап,
Dialogue: 0,0:04:59.02,0:05:01.00,Default,,0,0,0,,Мен солай ойлауым керек.
Dialogue: 0,0:05:06.00,0:05:07.02,Default,,0,0,0,,Күміс көздер
Dialogue: 0,0:05:07.07,0:05:09.02,Default,,0,0,0,,Күміс көзді бақсы?
Dialogue: 0,0:05:09.02,0:05:10.02,Default,,0,0,0,,Винсент
Dialogue: 0,0:05:10.02,0:05:13.02,Default,,0,0,0,,Бұл жынды сен басқардың ба?
Dialogue: 0,0:05:14.01,0:05:16.05,Default,,0,0,0,,Менің мұны істеуден басқа амалым қалмады.
Dialogue: 0,0:05:17.07,0:05:21.02,Default,,0,0,0,,Бұл не нәрсе?
Dialogue: 0,0:05:21.02,0:05:22.07,Default,,0,0,0,,епископ Камри
Dialogue: 0,0:05:22.07,0:05:24.01,Default,,0,0,0,,Винсент
Dialogue: 0,0:05:24.01,0:05:25.04,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:05:25.04,0:05:28.05,Default,,0,0,0,,Тіпті архиепископ жынға айнала ма?
Dialogue: 0,0:05:28.05,0:05:29.07,Default,,0,0,0,,Мені кешіріңіз.
Dialogue: 0,0:05:29.07,0:05:31.06,Default,,0,0,0,,Бұл үшін мені кешіріңіз.
Dialogue: 0,0:05:33.07,0:05:34.06,Default,,0,0,0,,Винсент
Dialogue: 0,0:05:35.07,0:05:38.01,Default,,0,0,0,,Бізге көмектесіңізші.
Dialogue: 0,0:05:49.07,0:05:51.02,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:05:51.05,0:05:53.07,Default,,0,0,0,,Қандай жартылай адам, жартылай жын.
Dialogue: 0,0:05:54.01,0:05:56.02,Default,,0,0,0,,Епископ Винсенттің бұйрықтары.
Dialogue: 0,0:05:56.02,0:05:57.07,Default,,0,0,0,,Мен білемін.
Dialogue: 0,0:05:57.07,0:05:58.06,Default,,0,0,0,,Жарайды
Dialogue: 0,0:05:58.06,0:05:59.02,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:05:59.07,0:06:02.01,Default,,0,0,0,,Айтпақшы, сен мұны шынымен жасайсың ба?
Dialogue: 0,0:06:03.03,0:06:05.01,Default,,0,0,0,,Бұл әйелдің айтқаны.
Dialogue: 0,0:06:05.09,0:06:07.07,Default,,0,0,0,,Егер сіз жын тапсаңыз
Dialogue: 0,0:06:07.07,0:06:13.09,Default,,0,0,0,,Ол әйел сені құшақтап, қозғалыстарыңды бөгейді, сондықтан оны найзамен тесу керек.
Dialogue: 0,0:06:15.01,0:06:16.04,Default,,0,0,0,,Ол байсалды шығар.
Dialogue: 0,0:06:17.04,0:06:19.08,Default,,0,0,0,,Менің ойымша, бұл дене толық сауыққан жоқ.
Dialogue: 0,0:06:20.02,0:06:23.04,Default,,0,0,0,,Бұл ең сенімді әдіс.
Dialogue: 0,0:06:23.04,0:06:25.00,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:06:25.06,0:06:30.02,Default,,0,0,0,,Біз адамдардың өмірін сақтау үшін өз өміріңізді құрбан етіңіз.
Dialogue: 0,0:06:30.07,0:06:32.07,Default,,0,0,0,,Бала осылай деді ме?
Dialogue: 0,0:06:33.00,0:06:34.08,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:06:34.08,0:06:35.06,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:06:35.06,0:06:38.02,Default,,0,0,0,,Бұл қала біздің қаламыз.
Dialogue: 0,0:06:38.02,0:06:38.52,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:06:39.05,0:06:40.08,Default,,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:06:40.08,0:06:41.09,Default,,0,0,0,,Егер шынымен үйленген жұп екендеріңді айтсаңдар, дәлелдеңдер.
Dialogue: 0,0:06:43.06,0:06:44.05,Default,,0,0,0,,Күлкілі
Dialogue: 0,0:06:45.01,0:06:46.08,Default,,0,0,0,,Жындардың белгісі жоқ
Dialogue: 0,0:06:47.05,0:06:50.02,Default,,0,0,0,,Олардың бәрінің де оң жақ көздері бар, олар жаншылған болуы керек еді.
Dialogue: 0,0:06:51.07,0:06:53.03,Default,,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:06:58.07,0:07:00.01,Default,,0,0,0,,Ол жерде жоқ.
Dialogue: 0,0:07:01.07,0:07:04.00,Default,,0,0,0,,Мен мұндай жерде күтуге тура келгеніме сене алар емеспін.
Dialogue: 0,0:07:04.00,0:07:06.08,Default,,0,0,0,,Мен бұл шомылдыру рәсімінен өтуге жақсы емеспін.
Dialogue: 0,0:07:08.06,0:07:11.05,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:13.03,0:07:14.01,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:07:17.00,0:07:18.06,Default,,0,0,0,,Тек екі адам қалды
Dialogue: 0,0:07:28.07,0:07:29.06,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:30.00,0:07:31.07,Default,,0,0,0,,Ол да жын емес.
Dialogue: 0,0:07:33.05,0:07:35.08,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:07:36.08,0:07:37.04,Default,,0,0,0,,Иә
Dialogue: 0,0:07:39.01,0:07:40.00,Default,,0,0,0,,Мен осы маңдағы бірнеше ғибадатханаларды аралап келемін.
Dialogue: 0,0:07:43.01,0:07:43.51,Default,,0,0,0,,Не
Dialogue: 0,0:07:44.06,0:07:46.06,Default,,0,0,0,,Кешіріңіз, епископ Винсент.
Dialogue: 0,0:07:47.02,0:07:48.09,Default,,0,0,0,,Сіз де ерекшелік емессіз.
Dialogue: 0,0:07:49.07,0:07:50.09,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:07:51.08,0:07:53.05,Default,,0,0,0,,Маған зерттеуге рұқсат етіңіз.
Dialogue: 0,0:08:02.03,0:08:03.02,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:03.09,0:08:05.05,Default,,0,0,0,,Ол да жын емес.
Dialogue: 0,0:08:11.00,0:08:12.01,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:08:12.06,0:08:14.06,Default,,0,0,0,,Ол соборда болуы керек.
Dialogue: 0,0:08:15.02,0:08:16.08,Default,,0,0,0,,Неліктен оны табу мүмкін емес?
Dialogue: 0,0:08:17.05,0:08:19.04,Default,,0,0,0,,Маған бірдеңе жетіспеді ме?
Dialogue: 0,0:08:20.00,0:08:22.07,Default,,0,0,0,,Ойлан
Dialogue: 0,0:08:22.07,0:08:27.03,Default,,0,0,0,,Денесін жасыра алғанша, оған бәрібір.
Dialogue: 0,0:08:27.09,0:08:29.08,Default,,0,0,0,,Ер әйел
Dialogue: 0,0:08:29.08,0:08:33.05,Default,,0,0,0,,Бала ма, қария ма
Dialogue: 0,0:08:35.04,0:08:37.06,Default,,0,0,0,,Тіпті адам өлген болса да
Dialogue: 0,0:08:39.01,0:08:41.05,Default,,0,0,0,,Оның дәмі өте нашар.
Dialogue: 0,0:08:43.06,0:08:46.00,Default,,0,0,0,,Солай болса да әлі біткен жоқ, юма-чан.
Dialogue: 0,0:08:50.06,0:08:51.07,Default,,0,0,0,,Раки
Dialogue: 0,0:08:56.02,0:08:58.04,Default,,0,0,0,,Жақсысың ба, Клэр?
Dialogue: 0,0:09:13.02,0:09:14.04,Default,,0,0,0,,Бұл
Dialogue: 0,0:09:21.01,0:09:22.01,Default,,0,0,0,,Клэр
Dialogue: 0,0:09:23.00,0:09:24.09,Default,,0,0,0,,Амансың ба? Сіз жарақат алдыңыз ба?
Dialogue: 0,0:09:24.09,0:09:26.05,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:09:29.02,0:09:31.05,Default,,0,0,0,,Жынның қимылын тоқтатамын
Dialogue: 0,0:09:31.05,0:09:33.09,Default,,0,0,0,,Сіз кіреберіске қарай бет алуыңыз керек, жарай ма?
Dialogue: 0,0:09:33.09,0:09:34.05,Default,,0,0,0,,Клэр
Dialogue: 0,0:09:37.07,0:09:38.06,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:09:42.00,0:09:42.50,Default,,0,0,0,,Раки
Dialogue: 0,0:09:49.04,0:09:50.07,Default,,0,0,0,,Жүгір, балақай.
Dialogue: 0,0:09:58.09,0:09:59.09,Default,,0,0,0,,Неге ешкім қабырғаға өрмелеп шығуға тырыспайды?
Dialogue: 0,0:09:59.09,0:10:01.03,Default,,0,0,0,,Маған көмек керек емес
Dialogue: 0,0:10:05.04,0:10:06.07,Default,,0,0,0,,Осымен
Dialogue: 0,0:10:07.01,0:10:09.02,Default,,0,0,0,,Барлығын өз бетіңізше қорғауға тырыспаңыз.
Dialogue: 0,0:10:09.09,0:10:13.02,Default,,0,0,0,,Мен жарақат алсам, қорғай алатын жалғыз адам – осы бала.
Dialogue: 0,0:10:13.08,0:10:16.00,Default,,0,0,0,,Бұл қала біздің қаламыз.
Dialogue: 0,0:10:16.00,0:10:18.07,Default,,0,0,0,,Мен өз өмірімді қатерге тігуге дайынмын.
Dialogue: 0,0:10:19.03,0:10:22.02,Default,,0,0,0,,Бала үшін және өзің үшін күресу керек.
Dialogue: 0,0:10:22.09,0:10:25.04,Default,,0,0,0,,Біз өз қаламыз үшін күресеміз
Dialogue: 0,0:10:25.09,0:10:29.04,Default,,0,0,0,,Өйткені, мен осы киелі қаланы қорғап жүрген жауынгермін.
Dialogue: 0,0:10:31.04,0:10:32.06,Default,,0,0,0,,(Изуку) U.A. орта мектебі, 1-курс A және B сыныптары—
Dialogue: 0,0:10:47.06,0:10:48.09,Default,,0,0,0,,Ол келмеді ме?
Dialogue: 0,0:11:07.05,0:11:08.04,Default,,0,0,0,,18-ші эпизод: Венецияға!
Dialogue: 0,0:11:08.04,0:11:09.07,Default,,0,0,0,,Сіз бұл туралы ештеңе істей алмайсыз.
Dialogue: 0,0:11:10.01,0:11:11.00,Default,,0,0,0,,Ол сөзсіз осында—
Dialogue: 0,0:11:11.00,0:11:12.02,Default,,0,0,0,,Ууух!
Dialogue: 0,0:11:13.04,0:11:14.09,Default,,0,0,0,,Мұны Клэрге беріңіз
Dialogue: 0,0:11:15.09,0:11:17.02,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:18.03,0:11:19.07,Default,,0,0,0,,Мен жай ғана соған қосылып жүрдім.
Dialogue: 0,0:11:26.02,0:11:29.01,Default,,0,0,0,,Әйелді қабылдау
Dialogue: 0,0:11:49.04,0:11:51.04,Default,,0,0,0,,Клеймор
Dialogue: 0,0:11:58.04,0:11:59.01,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:11:59.05,0:12:01.03,Default,,0,0,0,,Жындарды аулауды бастайық па?
Dialogue: 0,0:12:15.08,0:12:17.04,Default,,0,0,0,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:12:30.02,0:12:31.09,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:12:34.05,0:12:36.03,Default,,0,0,0,,Аспанда не болып жатыр?
Dialogue: 0,0:12:37.00,0:12:42.01,Default,,0,0,0,,Бұл Клеймордың үлкен қылыш ұстаған шынайы түрі ме?
Dialogue: 0,0:12:42.01,0:12:42.51,Default,,0,0,0,,Жоқ
Dialogue: 0,0:12:44.02,0:12:45.01,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:12:45.09,0:12:46.04,Default,,0,0,0,,Клэр
Dialogue: 0,0:12:47.03,0:12:50.09,Default,,0,0,0,,Дәл қазір мен қозғалу мүмкіндігімнен тыс күресіп жатырмын.
Dialogue: 0,0:12:56.02,0:12:57.07,Default,,0,0,0,,Не болды?
Dialogue: 0,0:12:57.07,0:12:59.07,Default,,0,0,0,,Сіз бозарған сияқтысыз.
Dialogue: 0,0:13:00.04,0:13:02.02,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:02.02,0:13:05.00,Default,,0,0,0,,Артықшылыққа ие болып көрінген кезде
Dialogue: 0,0:13:05.00,0:13:08.03,Default,,0,0,0,,Сонымен, сіз бәрін бірден аяқтағыңыз келді ме?
Dialogue: 0,0:13:08.06,0:13:12.02,Default,,0,0,0,,Мен ұзақ соғысты қаламаймын.
Dialogue: 0,0:13:12.06,0:13:14.02,Default,,0,0,0,,Бұл сәтсіздік болды.
Dialogue: 0,0:13:14.02,0:13:20.09,Default,,0,0,0,,Менің ойымша, ол қолымен емес, бірінші соққымен басын алып тастағысы келді.
Dialogue: 0,0:13:23.05,0:13:25.05,Default,,0,0,0,,Қараңдар, мен дұрыс түсіндім.
Dialogue: 0,0:13:25.05,0:13:27.05,Default,,0,0,0,,Бұл ойдан бас тартатын уақыт емес.
Dialogue: 0,0:13:28.03,0:13:29.05,Default,,0,0,0,,Ой
Dialogue: 0,0:13:34.02,0:13:37.02,Default,,0,0,0,,Сіз қалай ойлайсыз? Көрініс жақсы ма?
Dialogue: 0,0:13:37.02,0:13:40.07,Default,,0,0,0,,Бірақ мен биіктікте жақсы емес сияқтымын.
Dialogue: 0,0:13:43.02,0:13:45.05,Default,,0,0,0,,Көп дүрбелеңге түспеңіз
Dialogue: 0,0:13:45.05,0:13:48.04,Default,,0,0,0,,Мен сені бірден түсіріп жіберемін.
Dialogue: 0,0:13:49.01,0:13:50.03,Default,,0,0,0,,Өл
Dialogue: 0,0:13:54.05,0:13:55.06,Default,,0,0,0,,Гарк
Dialogue: 0,0:14:03.05,0:14:05.01,Default,,0,0,0,,Жақсысың ба, әйел?
Dialogue: 0,0:14:05.01,0:14:06.01,Default,,0,0,0,,Сіз тұра аласыз ба?
Dialogue: 0,0:14:08.02,0:14:11.03,Default,,0,0,0,,Әйел Бұл біздің ең жақсымыз.
Dialogue: 0,0:14:11.07,0:14:14.09,Default,,0,0,0,,Сіз айтқандай, біз тіпті бір-бірімізбен жарыса алмаймыз.
Dialogue: 0,0:14:15.09,0:14:19.06,Default,,0,0,0,,Егер бұл біздің өміріміз болса, оларды қалай пайдаланатыныңыз бізге маңызды емес.
Dialogue: 0,0:14:20.00,0:14:23.01,Default,,0,0,0,,Өтінемін, оны жеңіңіз.
Dialogue: 0,0:14:25.09,0:14:26.09,Default,,0,0,0,,Тамақтану
Dialogue: 0,0:14:41.08,0:14:44.07,Default,,0,0,0,,Сіз ерекше шабуылмен бірдеңе істей аламын деп ойладыңыз ба?
Dialogue: 0,0:14:45.01,0:14:47.02,Default,,0,0,0,,Ақымақ жігіт
Dialogue: 0,0:14:48.09,0:14:50.00,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:14:50.00,0:14:51.08,Default,,0,0,0,,Уууууууу!!
Dialogue: 0,0:15:00.07,0:15:03.09,Default,,0,0,0,,Өкінішке орай, олар ақымақ болды.
Dialogue: 0,0:15:03.09,0:15:05.02,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,0:15:17.07,0:15:18.06,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:15:18.06,0:15:19.05,Default,,0,0,0,,Өздігінен
Dialogue: 0,0:15:19.05,0:15:21.02,Default,,0,0,0,,Мен оны сағындым.
Dialogue: 0,0:15:21.02,0:15:23.07,Default,,0,0,0,,Қылышыңды оңға, солға тартсаң да
Dialogue: 0,0:15:23.07,0:15:26.00,Default,,0,0,0,,Ол сіздің маңызды нүктелеріңізге жетпейді.
Dialogue: 0,0:15:26.05,0:15:27.06,Default,,0,0,0,,Клэр
Dialogue: 0,0:15:34.08,0:15:36.07,Default,,0,0,0,,Өмірлік нүкте бас болып табылады ма?
Dialogue: 0,0:15:53.02,0:15:54.04,Default,,0,0,0,,Яй Клэр
Dialogue: 0,0:15:55.04,0:15:58.01,Default,,0,0,0,,Мұны істеген әйел
Dialogue: 0,0:15:59.03,0:16:00.09,Default,,0,0,0,,Клеймор?
Dialogue: 0,0:16:01.04,0:16:02.09,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,0:16:11.09,0:16:12.07,Default,,0,0,0,,Клэр
Dialogue: 0,0:16:12.07,0:16:13.09,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:13.09,0:16:15.00,Default,,0,0,0,,Мықты болыңыз
Dialogue: 0,0:16:15.00,0:16:16.07,Default,,0,0,0,,Клэр Даиджо
Dialogue: 0,0:16:21.03,0:16:22.02,Default,,0,0,0,,Клэр
Dialogue: 0,0:16:25.03,0:16:26.02,Default,,0,0,0,,Қолымнан келгеннің бәрін жасадым
Dialogue: 0,0:16:26.06,0:16:27.06,Default,,0,0,0,,Қайту мүмкін емес
Dialogue: 0,0:16:40.00,0:16:41.03,Default,,0,0,0,,Клэр, не болды?
Dialogue: 0,0:16:45.07,0:16:46.09,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:46.09,0:16:48.04,Default,,0,0,0,,Нені көшіріп жатырсың, Клэр?
Dialogue: 0,0:16:48.07,0:16:52.05,Default,,0,0,0,,Зақым келтіру кезінде тым көп сиқырлы күш қолданылды
Dialogue: 0,0:16:53.03,0:16:57.03,Default,,0,0,0,,Мен бұл бейітті жалғыз тоқтата алмаймын деп ойлаймын.
Dialogue: 0,0:17:00.08,0:17:04.07,Default,,0,0,0,,Демек, біз адам ретінде саналы болсақ,
Dialogue: 0,0:17:04.07,0:17:06.06,Default,,0,0,0,,Өз өмірін аяқтау
Dialogue: 0,0:17:07.01,0:17:08.06,Default,,0,0,0,,Сіз не туралы айтып тұрсыз?
Dialogue: 0,0:17:08.06,0:17:09.04,Default,,0,0,0,,Клэр
Dialogue: 0,0:17:11.09,0:17:13.01,Default,,0,0,0,,Қоштасу
Dialogue: 0,0:17:13.05,0:17:14.03,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:17:16.05,0:17:17.02,Default,,0,0,0,,Клэр
Dialogue: 0,0:17:17.02,0:17:18.01,Default,,0,0,0,,Жақынбаңыз
Dialogue: 0,0:17:19.05,0:17:21.08,Default,,0,0,0,,Гарк сұрайды
Dialogue: 0,0:17:25.03,0:17:26.03,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:17:26.08,0:17:28.01,Default,,0,0,0,,Тез сұраңыз
Dialogue: 0,0:17:31.07,0:17:32.06,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:33.00,0:17:33.50,Default,,0,0,0,,Бұл қандай ақша?
Dialogue: 0,0:17:34.09,0:17:36.01,Default,,0,0,0,,Раки нашар
Dialogue: 0,0:17:36.09,0:17:39.00,Default,,0,0,0,,Мен енді қайтып бара алмаймын.
Dialogue: 0,0:17:39.00,0:17:40.00,Default,,0,0,0,,Клэр
Dialogue: 0,0:17:41.01,0:17:44.07,Default,,0,0,0,,Сиқырлы күшті қолдануды жалғастыра отырып, біз
Dialogue: 0,0:17:44.07,0:17:46.06,Default,,0,0,0,,Жынға жақындау
Dialogue: 0,0:17:47.04,0:17:48.00,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:48.07,0:17:50.02,Default,,0,0,0,,Бұл бірте-бірте емес
Dialogue: 0,0:17:50.07,0:17:53.07,Default,,0,0,0,,Бір күні сіз кенеттен шегіңізге жетуіңіз мүмкін.
Dialogue: 0,0:17:56.04,0:17:57.03,Default,,0,0,0,,Шынында, сол сырғаң өте батыл екен.
Dialogue: 0,0:17:58.01,0:18:02.03,Default,,0,0,0,,Жынға айналған денемді әрең ұстап тұрмын.
Dialogue: 0,0:18:03.07,0:18:05.06,Default,,0,0,0,,Қош бол, Раки
Dialogue: 0,0:18:08.09,0:18:10.01,Default,,0,0,0,,Қандай еліктеу?
Dialogue: 0,0:18:10.01,0:18:10.51,Default,,0,0,0,,Өлгің келе ме?
Dialogue: 0,0:18:12.09,0:18:14.00,Default,,0,0,0,,Рақидан сұра
Dialogue: 0,0:18:14.06,0:18:15.09,Default,,0,0,0,,Мені жіберіңізші
Dialogue: 0,0:18:15.09,0:18:16.08,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:18:17.05,0:18:18.03,Default,,0,0,0,,бетін таныған адамның атын жазсаң, сол адам өліп қалады деген дәптер екенін айтты
Dialogue: 0,0:18:18.08,0:18:20.06,Default,,0,0,0,,Адамдардың надандығынан қорқамын.
Dialogue: 0,0:18:21.01,0:18:21.51,Default,,0,0,0,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:18:23.06,0:18:27.09,Default,,0,0,0,,Мен Клэрмен бірге саяхаттағаныма қуаныштымын.
Dialogue: 0,0:18:29.06,0:18:31.05,Default,,0,0,0,,Ата-анасы мен бауырлары өлтірілді
Dialogue: 0,0:18:31.05,0:18:33.01,Default,,0,0,0,,Ауыл тастап кеткен
Dialogue: 0,0:18:33.08,0:18:37.09,Default,,0,0,0,,Менің барлық жақындарым бірге кетті.
Dialogue: 0,0:18:39.00,0:18:40.07,Default,,0,0,0,,Сондықтан мен бақытты болдым
Dialogue: 0,0:18:41.02,0:18:44.03,Default,,0,0,0,,Мен Клэрмен бірге саяхаттауға мүмкіндігім болған кезде
Dialogue: 0,0:18:44.03,0:18:47.04,Default,,0,0,0,,Ең бастысы, бірге болатын адамның болуы
Dialogue: 0,0:18:48.06,0:18:52.03,Default,,0,0,0,,Клэр өзіне мейірімді емес екенін айтты.
Dialogue: 0,0:18:52.07,0:18:57.04,Default,,0,0,0,,Ол маған басқа адамдарға қарағанда әлдеқайда мейірімді болды.
Dialogue: 0,0:18:57.08,0:18:59.06,Default,,0,0,0,,Сондықтан
Dialogue: 0,0:19:00.00,0:19:01.08,Default,,0,0,0,,Басқа ешкім жоқ
Dialogue: 0,0:19:02.03,0:19:04.06,Default,,0,0,0,,Мен мәңгілікке Клэрдің қасында болғым келеді.
Dialogue: 0,0:19:06.01,0:19:09.02,Default,,0,0,0,,Клэр өлсе, мен онымен бірге барамын.
Dialogue: 0,0:19:44.06,0:19:47.04,Default,,0,0,0,,Аруақтардың моласы тоқтады.
Dialogue: 0,0:19:49.01,0:19:50.00,Default,,0,0,0,,Клэр
Dialogue: 0,0:19:54.08,0:19:55.07,Default,,0,0,0,,Таку
Dialogue: 0,0:19:55.07,0:19:57.03,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,0:19:59.02,0:20:01.07,Default,,0,0,0,,Ол жынға айналған жоқ.
Dialogue: 0,0:20:02.03,0:20:04.04,Default,,0,0,0,,Мұның бәрі бар.
Dialogue: 0,0:20:05.03,0:20:07.00,Default,,0,0,0,,Мен ақыры құтқарылдым.
Dialogue: 0,0:20:07.06,0:20:09.00,Default,,0,0,0,,Сол балаға
Dialogue: 0,0:20:12.09,0:20:13.09,Default,,0,0,0,,Клэр
Dialogue: 0,0:20:14.05,0:20:15.06,Default,,0,0,0,,Клэр
Dialogue: 0,0:20:21.00,0:20:23.03,Default,,0,0,0,,Барлық көмектеріңіз үшін рахмет, діни қызметкер.
Dialogue: 0,0:20:23.03,0:20:25.00,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:20:25.00,0:20:28.03,Default,,0,0,0,,Бізге көмектескен.
Dialogue: 0,0:20:28.03,0:20:30.01,Default,,0,0,0,,Өйткені бұл миссия.
Dialogue: 0,0:20:31.02,0:20:35.01,Default,,0,0,0,,Сонымен қатар, Раки-санды осында ұстау туралы.
Dialogue: 0,0:20:35.01,0:20:38.03,Default,,0,0,0,,Епископ бұған мейірімділікпен келісті.
Dialogue: 0,0:20:38.03,0:20:39.01,Default,,0,0,0,,Иә
Dialogue: 0,0:20:39.08,0:20:40.08,Default,,0,0,0,,Клэр
Dialogue: 0,0:20:43.01,0:20:45.03,Default,,0,0,0,,Менімен келесің бе? Раки
Dialogue: 0,0:20:46.03,0:20:47.02,Default,,0,0,0,,Иә
Dialogue: 0,0:20:47.02,0:20:48.05,Default,,0,0,0,,Аты...
Dialogue: 0,0:20:51.01,0:20:52.07,Default,,0,0,0,,Мұны өзіңізбен бірге алыңыз.
Dialogue: 0,0:20:59.03,0:21:00.01,Default,,0,0,0,,Әйел
Dialogue: 0,0:21:00.06,0:21:01.07,Default,,0,0,0,,Өлме
Dialogue: 0,0:21:04.02,0:21:05.07,Default,,0,0,0,,Рақиға барайық
Dialogue: 0,0:21:05.07,0:21:06.09,Default,,0,0,0,,Иә
Dialogue: 0,0:21:07.08,0:21:08.07,Default,,0,0,0,,Аты...
Dialogue: 0,0:21:09.03,0:21:10.07,Default,,0,0,0,,Мықты бол
Dialogue: 0,0:21:11.00,0:21:14.09,Default,,0,0,0,,Маған Клэрді қолдауға жеткілікті күшті екеніңізді көрсетіңіз.
Dialogue: 0,0:21:14.09,0:21:16.02,Default,,0,0,0,,О
Dialogue: 0,0:21:16.02,0:21:18.00,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:22:40.06,0:22:43.00,Default,,0,0,0,,Үмітсіздік пен айқайлау
