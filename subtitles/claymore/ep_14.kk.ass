Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:15.80,0:00:17.67,Default - Copy,Irene,0,0,0,,Ол өзінің шегіне жақындады ма?
Dialogue: 0,0:00:21.08,0:00:23.14,Default - Copy,Irene,0,0,0,,Бүгінгі күннің бәрі осы.
Dialogue: 0,0:00:23.81,0:00:25.38,Default - Copy,Irene,0,0,0,,Суға шомылуға болады.
Dialogue: 0,0:00:25.81,0:00:27.68,Default - Copy,Clare,0,0,0,,Жоқ, бәрібір.
Dialogue: 0,0:00:27.68,0:00:29.42,Default - Copy,Clare,0,0,0,,Қайыр сұрай беріңіз
Dialogue: 0,0:00:30.99,0:00:32.15,Default - Copy,Irene,0,0,0,,Оны асыра пайдаланбаңыз
Dialogue: 0,0:00:33.02,0:00:36.89,Default - Copy,Irene,0,0,0,,Алынған жаралар әлі толық жазылмаған болуы керек.
Dialogue: 0,0:00:37.76,0:00:38.63,Default - Copy,Irene,0,0,0,,Асықпаңыз
Dialogue: 0,0:00:39.19,0:00:43.40,Default - Copy,Irene,0,0,0,,Жаттығудың жартысы, ал демалыстың жартысы жаттығу деп есептеңіз.
Dialogue: 0,0:00:49.44,0:00:53.68,Default - Copy,Irene,0,0,0,,Мен жоғары жылдамдықтағы қылыштың шегін өз бетімше ұстай алдым.
Dialogue: 0,0:00:55.64,0:00:56.71,Default - Copy,Irene,0,0,0,,Дегенмен
Dialogue: 0,0:02:14.02,0:02:16.59,Default - Copy,Clare,0,0,0,,Жан-жағы таулармен қоршалған алап па?
Dialogue: 0,0:02:17.76,0:02:18.72,Default - Copy,Clare,0,0,0,,Мен көремін.
Dialogue: 0,0:02:19.12,0:02:21.06,Default - Copy,Clare,0,0,0,,Бұл шегінуге жақсы орын
Dialogue: 0,0:02:32.60,0:02:33.44,Default - Copy,Irene,0,0,0,,О
Dialogue: 0,0:02:34.24,0:02:36.34,Default - Copy,Irene,0,0,0,,Көлемі онша өзгеше емес сияқты.
Dialogue: 0,0:02:37.74,0:02:40.45,Default - Copy,Clare,0,0,0,,Бұл сол кезден бе?
Dialogue: 0,0:02:42.31,0:02:43.18,Default - Copy,Irene,0,0,0,,Иә.
Dialogue: 0,0:02:51.02,0:02:52.86,Default - Copy,Irene,0,0,0,,Сол жеңі жоқ болса да
Dialogue: 0,0:02:52.86,0:02:55.33,Default - Copy,Irene,0,0,0,,Сіздікінен жақсырақ.
Dialogue: 0,0:02:55.69,0:02:56.93,Default - Copy,Irene,0,0,0,,Мен оны саған беремін.
Dialogue: 0,0:02:56.93,0:02:57.76,Default - Copy,Irene,0,0,0,,Отырыңыз
Dialogue: 0,0:03:01.40,0:03:02.07,Default - Copy,Irene,0,0,0,,Тамақтану
Dialogue: 0,0:03:04.47,0:03:05.94,Default - Copy,Irene,0,0,0,,Тіпті қаламасаңыз да
Dialogue: 0,0:03:05.94,0:03:08.15,Default - Copy,Irene,0,0,0,,Оны денеңізге күштеп салу керек.
Dialogue: 0,0:03:22.92,0:03:23.90,Default - Copy,Clare,0,0,0,,Өзгеріс жоқ.
Dialogue: 0,0:03:24.76,0:03:26.72,Default - Copy,Clare,0,0,0,,Бәрі сол кездегідей қалады.
Dialogue: 0,0:03:27.53,0:03:29.36,Default - Copy,Irene,0,0,0,,Менің ойымша, сіз білесіз.
Dialogue: 0,0:03:29.36,0:03:33.06,Default - Copy,Irene,0,0,0,,Біз, жартылай адам, жартылай жын, өсеміз, бірақ қартаймаймыз.
Dialogue: 0,0:03:33.72,0:03:38.04,Default - Copy,Irene,0,0,0,,Ол шайқаста өлгенше немесе жынға айналғанша осы қалпында қалады.
Dialogue: 0,0:03:39.34,0:03:41.34,Default - Copy,Irene,0,0,0,,Тереза тірі болса
Dialogue: 0,0:03:41.71,0:03:44.31,Default - Copy,Irene,0,0,0,,Сол кездегідей болса керек.
Dialogue: 0,0:03:49.85,0:03:54.19,Default - Copy,Irene,0,0,0,,Терезаның өлгеніне өзің кінәлі деп ойлайтын шығарсың.
Dialogue: 0,0:03:55.65,0:03:57.80,Default - Copy,Irene,0,0,0,,Бұл бір мағынада қате емес, бірақ
Dialogue: 0,0:03:58.66,0:04:02.06,Default - Copy,Irene,0,0,0,,Тереза сізді кездестірді және саяхаттады.
Dialogue: 0,0:04:02.06,0:04:04.30,Default - Copy,Irene,0,0,0,,Жауынгер ретінде күшіңді жоғалт
Dialogue: 0,0:04:04.30,0:04:06.73,Default - Copy,Irene,0,0,0,,Нәтижесінде оны Присцилла өлтірді.
Dialogue: 0,0:04:06.73,0:04:08.07,Default - Copy,Irene,0,0,0,,Бұл факт
Dialogue: 0,0:04:10.07,0:04:10.94,Default - Copy,Irene,0,0,0,,Бірақ
Dialogue: 0,0:04:11.40,0:04:13.30,Default - Copy,Irene,0,0,0,,Менің ойымша, Тереза ​​бақытты болды.
Dialogue: 0,0:04:14.84,0:04:16.94,Default - Copy,Irene,0,0,0,,Сізбен бірге өткізген уақыт
Dialogue: 0,0:04:17.58,0:04:20.25,Default - Copy,Irene,0,0,0,,Қаншалықты қысқа болса да
Dialogue: 0,0:04:24.28,0:04:25.62,Default - Copy,Irene,0,0,0,,Тереза жалғыз қалды
Dialogue: 0,0:04:26.62,0:04:28.95,Default - Copy,Irene,0,0,0,,тым күшті және асыл
Dialogue: 0,0:04:28.95,0:04:32.14,Default - Copy,Irene,0,0,0,,Сондықтан Терезаның айналасындағы адамдар оны құрметтейтін.
Dialogue: 0,0:04:32.14,0:04:33.63,Default - Copy,Irene,0,0,0,,Және қорқады
Dialogue: 0,0:04:35.19,0:04:37.10,Default - Copy,Irene,0,0,0,,Иә, сен оны жақсы көресің.
Dialogue: 0,0:04:37.86,0:04:39.83,Default - Copy,Irene,0,0,0,,Ол да оны қабылдады.
Dialogue: 0,0:04:42.40,0:04:46.00,Default - Copy,Irene,0,0,0,,Тереза үшін сізбен уақыт өткізу - бұл
Dialogue: 0,0:04:46.44,0:04:48.41,Default - Copy,Irene,0,0,0,,Бейбіт және орындалған
Dialogue: 0,0:04:48.81,0:04:52.28,Default - Copy,Irene,0,0,0,,Бәрінен бұрын, бұл өте қарқынды және адамға ұқсас уақыт болса керек.
Dialogue: 0,0:04:56.78,0:04:58.52,Default - Copy,Irene,0,0,0,,Мен бақытты болдым.
Dialogue: 0,0:05:43.23,0:05:44.13,Default - Copy,Irene,0,0,0,,Жарайды
Dialogue: 0,0:05:44.63,0:05:47.50,Default - Copy,Irene,0,0,0,,Мен енді өз шектеулерімді түсіне аламын.
Dialogue: 0,0:05:48.13,0:05:50.00,Default - Copy,Irene,0,0,0,,Бұл сезімді ұмытпа
Dialogue: 0,0:05:51.40,0:05:52.57,Default - Copy,Clare,0,0,0,,Ол сондай адам.
Dialogue: 0,0:05:53.00,0:05:55.14,Default - Copy,Clare,0,0,0,,Мен Айриннің жылдам семсерімін
Dialogue: 0,0:05:55.14,0:05:56.77,Default - Copy,Clare,0,0,0,,Сіз қаншалықты жақынсыз?
Dialogue: 0,0:05:57.81,0:06:01.75,Default - Copy,Irene,0,0,0,,Жылдам семсер үшін күшті ақыл күші қажет
Dialogue: 0,0:06:02.31,0:06:05.88,Default - Copy,Irene,0,0,0,,Ең бастысы - әрқашан сабырлы болу.
Dialogue: 0,0:06:06.72,0:06:08.75,Default - Copy,Irene,0,0,0,,Бұл сізге сәйкес болуы мүмкін деп ойладым.
Dialogue: 0,0:06:09.49,0:06:10.46,Default - Copy,Irene,0,0,0,,Қате
Dialogue: 0,0:06:10.86,0:06:15.16,Default - Copy,Irene,0,0,0,,Жүрегіңде ылғи бір жалын бар
Dialogue: 0,0:06:16.19,0:06:18.63,Default - Copy,Irene,0,0,0,,Жылдам қылыш мұндай адамдарға жарамайды.
Dialogue: 0,0:06:19.13,0:06:24.24,Default - Copy,Irene,0,0,0,,Себебі, оны шығара бастаған бойда рухыңды бір қолдың тылсым энергиясы тартып алады.
Dialogue: 0,0:06:25.24,0:06:28.74,Default - Copy,Irene,0,0,0,,Факт: Сіздің жоғары жылдамдықтағы қылышыңыз бір минутқа шыдамайды.
Dialogue: 0,0:06:29.91,0:06:33.95,Default - Copy,Irene,0,0,0,,Күш пен жылдамдық ең жақсы жағдайда менің оннан аз.
Dialogue: 0,0:06:34.65,0:06:37.72,Default - Copy,Irene,0,0,0,,Басқаша айтқанда, бұл пайдасыз.
Dialogue: 0,0:06:38.62,0:06:41.99,Default - Copy,Irene,0,0,0,,Маа Дегенмен, сіз жақсы орындадыңыз.
Dialogue: 0,0:06:42.49,0:06:44.06,Default - Copy,Irene,0,0,0,,Мен саған мақтау айтамын.
Dialogue: 0,0:06:46.06,0:06:46.62,Default - Copy,Irene,0,0,0,,Тұру
Dialogue: 0,0:07:00.51,0:07:02.04,Default - Copy,Clare,0,0,0,,Не
Dialogue: 0,0:07:02.04,0:07:04.68,Default - Copy,Irene,0,0,0,,Жара жабылып қойған.
Dialogue: 0,0:07:05.48,0:07:09.18,Default - Copy,Irene,0,0,0,,Кешіріңіз, бірақ мен кесілген бетті қайтадан жасауға тура келді.
Dialogue: 0,0:07:14.55,0:07:16.25,Default - Copy,Clare,0,0,0,,Айрин сен
Dialogue: 0,0:07:17.09,0:07:18.09,Default - Copy,Irene,0,0,0,,Қоштасу
Dialogue: 0,0:07:18.52,0:07:19.49,Default - Copy,Irene,0,0,0,,Оны өзіңізбен бірге алыңыз.
Dialogue: 0,0:07:19.66,0:07:21.66,Default - Copy,Clare,0,0,0,,Егер ол белгілі бір дәрежеде бар күшін салмайтын болса—
Dialogue: 0,0:07:21.66,0:07:22.69,Default - Copy,Clare,0,0,0,,Бұл ақылға қонымсыз
Dialogue: 0,0:07:22.69,0:07:24.03,Default - Copy,Clare,0,0,0,,Жылдам қосылыңыз
Dialogue: 0,0:07:24.03,0:07:25.10,Default - Copy,Clare,0,0,0,,тым кеш болады
Dialogue: 0,0:07:26.20,0:07:29.07,Default - Copy,Irene,0,0,0,,Содан кейін жоғары жылдамдықты қылышты қолдануға болады.
Dialogue: 0,0:07:29.77,0:07:32.14,Default - Copy,Irene,0,0,0,,Бұл сізге қазір керек.
Dialogue: 0,0:07:32.60,0:07:33.94,Default - Copy,Clare,0,0,0,,Бірақ Айрин
Dialogue: 0,0:07:34.81,0:07:37.38,Default - Copy,Irene,0,0,0,,Мен үшін шайқастан алыс
Dialogue: 0,0:07:37.38,0:07:39.18,Default - Copy,Irene,0,0,0,,Бұл пайдасыз нәрсе
Dialogue: 0,0:07:39.91,0:07:42.68,Default - Copy,Irene,0,0,0,,Бұл маған бұрыннан қажет болмай қалған нәрсе.
Dialogue: 0,0:07:42.68,0:07:43.68,Default - Copy,Clare,0,0,0,,Дегенмен
Dialogue: 0,0:07:44.25,0:07:45.12,Default - Copy,Irene,0,0,0,,Қабылдау
Dialogue: 0,0:07:45.65,0:07:47.19,Default - Copy,Irene,0,0,0,,Сіздің өмір сүруіңіз үшін
Dialogue: 0,0:07:47.82,0:07:50.36,Default - Copy,Irene,0,0,0,,Бұл Терезаның тірі болғанының дәлелі.
Dialogue: 0,0:08:29.53,0:08:30.83,Default - Copy,Clare,0,0,0,,Барлығы орындалған кезде
Dialogue: 0,0:08:30.83,0:08:31.94,Default - Copy,Clare,0,0,0,,Қайтып кел
Dialogue: 0,0:08:32.53,0:08:35.30,Default - Copy,Clare,0,0,0,,Сондықтан аман қалуыңызды өтінемін.
Dialogue: 0,0:08:35.73,0:08:37.67,Default - Copy,Irene,0,0,0,,Үмітсіз күтемін
Dialogue: 0,0:08:38.20,0:08:41.81,Default - Copy,Irene,0,0,0,,Уайымдама, мен оңай өлмеймін.
Dialogue: 0,0:08:50.75,0:08:52.28,Default - Copy,Irene,0,0,0,,Тікелей Клэр
Dialogue: 0,0:08:54.95,0:08:57.29,Default - Copy,Rafaela,0,0,0,,Басқа адам бар сияқты болды.
Dialogue: 0,0:08:57.89,0:08:59.39,Default - Copy,Rafaela,0,0,0,,Ол кетті ме?
Dialogue: 0,0:08:59.39,0:09:00.22,Default - Copy,Irene,0,0,0,,Ах
Dialogue: 0,0:09:00.66,0:09:02.63,Default - Copy,Irene,0,0,0,,Мен біраз уақыт бұрын кетіп қалдым.
Dialogue: 0,0:09:03.70,0:09:05.46,Default - Copy,Rafaela,0,0,0,,Маа, маған бәрібір.
Dialogue: 0,0:09:05.46,0:09:08.17,Default - Copy,Rafaela,0,0,0,,Сіз мен іздеген адамсыз
Dialogue: 0,0:09:09.90,0:09:14.54,Default - Copy,Rafaela,0,0,0,,Мен оны таба алмадым, өйткені мен көптен бері жындарды толығымен өшірдім.
Dialogue: 0,0:09:15.44,0:09:18.11,Default - Copy,Rafaela,0,0,0,,Жылдам семсерді қолдану қателік болды.
Dialogue: 0,0:09:18.88,0:09:23.92,Default - Copy,Rafaela,0,0,0,,Сізге рахмет, менің жын-шайтандық энергиям қазір кәдімгі жауынгер сияқты ағып жатыр.
Dialogue: 0,0:09:24.68,0:09:27.42,Default - Copy,Irene,0,0,0,,Сіздің атыңызды сұрауым керек пе?
Dialogue: 0,0:09:28.25,0:09:29.25,Default - Copy,Rafaela,0,0,0,,Рафаэла
Dialogue: 0,0:09:29.79,0:09:31.42,Default - Copy,Rafaela,0,0,0,,Ұйымның № 5
Dialogue: 0,0:09:34.16,0:09:35.77,Default - Copy,Irene,0,0,0,,Бұл жараға не болды?
Dialogue: 0,0:09:36.33,0:09:39.43,Default - Copy,Irene,0,0,0,,Бұл оның жартылай адам, жартылай жын болғанға дейін алған жарақаты ма?
Dialogue: 0,0:09:39.43,0:09:44.11,Default - Copy,Rafaela,0,0,0,,Қазір өліп жатқан адамға мұны үйретуге негіз бар ма?
Dialogue: 0,0:09:44.90,0:09:46.67,Default - Copy,Rafaela,0,0,0,,Дефектор Айрин
Dialogue: 0,0:09:46.67,0:09:49.14,Default - Copy,Rafaela,0,0,0,,Сіздің өміріңіз ұйымға байланысты.
Dialogue: 0,0:09:50.14,0:09:52.98,Default - Copy,Rafaela,0,0,0,,Мен оның бір ғана қолы бар деп естідім, бірақ оның екеуі де жоқ сияқты.
Dialogue: 0,0:09:53.54,0:09:56.89,Default - Copy,Rafaela,0,0,0,,Өте жаман, бақытсыздық.
Dialogue: 0,0:09:57.25,0:10:01.69,Default - Copy,Irene,0,0,0,,Жоқ, екі қолым болса, қолымнан бірдеңе келер еді.
Dialogue: 0,0:10:02.15,0:10:06.62,Default - Copy,Irene,0,0,0,,Неліктен сен соншалықты күштісің және 5-ші нөмірде қаласың?
Dialogue: 0,0:10:07.59,0:10:10.96,Default - Copy,Rafaela,0,0,0,,Кешіріңіз, бірақ бұған да жауап беруге негіз жоқ.
Dialogue: 0,0:10:17.87,0:10:18.60,Default - Copy,Clare,0,0,0,,Айрин
Dialogue: 0,0:10:20.24,0:10:22.54,Default - Copy,Clare,0,0,0,,Менің оң қолыма бірдеңе дұрыс емес.
Dialogue: 0,0:10:27.81,0:10:28.58,Default - Copy,Clare,0,0,0,,Не?
Dialogue: 0,0:10:31.75,0:10:35.52,Default - Copy,Clare,0,0,0,,Бір қорқынышты нәрсе келе жатыр
Dialogue: 0,0:10:40.93,0:10:43.00,Default - Copy,Ophelia,0,0,0,,Иә.
Dialogue: 0,0:10:43.53,0:10:44.93,Default - Copy,Ophelia,0,0,0,,Қандай сәйкестік.
Dialogue: 0,0:10:44.93,0:10:47.23,Default - Copy,Ophelia,0,0,0,,Біздің мұндай жерде кездесетінімізге сене алар емеспін.
Dialogue: 0,0:10:47.80,0:10:51.17,Default - Copy,Ophelia,0,0,0,,Әй, мына оң қол не болды?
Dialogue: 0,0:10:51.17,0:10:53.67,Default - Copy,Ophelia,0,0,0,,Мен оны кесіп тастауым керек еді.
Dialogue: 0,0:10:53.67,0:10:54.84,Default - Copy,Clare,0,0,0,,Офелия
Dialogue: 0,0:10:55.27,0:10:56.67,Default - Copy,Ophelia,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:10:56.67,0:11:01.18,Default - Copy,Ophelia,0,0,0,,Мен сізді көптен бері көрмедім, сондықтан ұмытып кеттім.
Dialogue: 0,0:11:01.58,0:11:02.88,Default - Copy,Ophelia,0,0,0,,Ауырды
Dialogue: 0,0:11:03.41,0:11:06.25,Default - Copy,Ophelia,0,0,0,,Сіз өте қорқынышты адамсыз.
Dialogue: 0,0:11:06.42,0:11:08.65,Default - Copy,Clare,0,0,0,,немесе Оянған
Dialogue: 0,0:11:08.79,0:11:09.55,Default - Copy,Ophelia,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:11:09.55,0:11:10.66,Default - Copy,Ophelia,0,0,0,,Не?
Dialogue: 0,0:11:10.66,0:11:13.16,Default - Copy,Ophelia,0,0,0,,Қайдасың, Оян?
Dialogue: 0,0:11:14.53,0:11:16.89,Default - Copy,Ophelia,0,0,0,,Не? Сіз жоқсыз.
Dialogue: 0,0:11:16.89,0:11:18.90,Default - Copy,Ophelia,0,0,0,,Мұндай бейқам сөздерді айтпа
Dialogue: 0,0:11:19.93,0:11:23.67,Default - Copy,Ophelia,0,0,0,,Әй, менің басқа жейтін ештеңем жоқ.
Dialogue: 0,0:11:23.67,0:11:26.17,Default - Copy,Ophelia,0,0,0,,Мен өзімді үнемі аш жүргендей сезінемін.
Dialogue: 0,0:11:26.17,0:11:28.04,Default - Copy,Ophelia,0,0,0,,Мүмкін болса, ет алғым келеді.
Dialogue: 0,0:11:28.57,0:11:30.61,Default - Copy,Ophelia,0,0,0,,Жұмсақ және жанды
Dialogue: 0,0:11:31.08,0:11:34.78,Default - Copy,Ophelia,0,0,0,,Иә, бұл ішкі ағзалар жүйесі деп ойлаймын.
Dialogue: 0,0:11:34.78,0:11:38.25,Default - Copy,Ophelia,0,0,0,,Хмм, жоқ, бұл адам емес.
Dialogue: 0,0:11:38.25,0:11:40.02,Default - Copy,Ophelia,0,0,0,,Мен оянған адам емеспін.
Dialogue: 0,0:11:40.52,0:11:45.02,Default - Copy,Ophelia,0,0,0,,Бірақ адамдарға қаншалықты жақын болсаң, соғұрлым дәмді болатынын сеземін.
Dialogue: 0,0:11:46.26,0:11:47.26,Default - Copy,Ophelia,0,0,0,,Сіз
Dialogue: 0,0:11:47.76,0:11:50.93,Default - Copy,Ophelia,0,0,0,,Егер бірдеңе болса, бұл адам емес.
Dialogue: 0,0:11:54.43,0:11:55.90,Default - Copy,Ophelia,0,0,0,,О сен
Dialogue: 0,0:11:55.90,0:11:58.44,Default - Copy,Ophelia,0,0,0,,Күш пен жылдамдық аздап жоғарылады
Dialogue: 0,0:12:01.04,0:12:02.37,Default - Copy,Ophelia,0,0,0,,Не?
Dialogue: 0,0:12:02.37,0:12:05.24,Default - Copy,Ophelia,0,0,0,,Кейбір ішкі мүшелерді жеген дұрыс емес пе?
Dialogue: 0,0:12:08.85,0:12:14.52,Default - Copy,Ophelia,0,0,0,,Өйткені, сіздің күшіңіз бен жылдамдығыңыз бұрынғымен салыстырғанда теңдессіз өсті.
Dialogue: 0,0:12:15.02,0:12:16.75,Default - Copy,Ophelia,0,0,0,,Қызық, не болды?
Dialogue: 0,0:12:17.16,0:12:19.59,Default - Copy,Ophelia,0,0,0,,Маа, маған бәрібір.
Dialogue: 0,0:12:26.50,0:12:27.63,Default - Copy,Ophelia,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:12:27.63,0:12:29.17,Default - Copy,Ophelia,0,0,0,,Бұл өте дәмді емес.
Dialogue: 0,0:12:38.01,0:12:39.91,Default - Copy,Ophelia,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:12:39.91,0:12:42.68,Default - Copy,Ophelia,0,0,0,,Ішкі мүшелер болмаса дәмді емес шығар.
Dialogue: 0,0:12:43.25,0:12:44.42,Default - Copy,Ophelia,0,0,0,,Кешіріңіз
Dialogue: 0,0:12:44.42,0:12:47.09,Default - Copy,Ophelia,0,0,0,,Мен бұл сен болмағаныңды қалаймын.
Dialogue: 0,0:12:47.09,0:12:49.52,Default - Copy,Ophelia,0,0,0,,Менің қарным ашты, қолымнан ештеңе келмейді.
Dialogue: 0,0:12:50.52,0:12:54.36,Default - Copy,Ophelia,0,0,0,,Негізі мен оның тірі кезінде ішкі мүшелерін алып тастағым келеді.
Dialogue: 0,0:12:54.36,0:12:56.69,Default - Copy,Ophelia,0,0,0,,Мен сені бірінші өлтіремін, сосын жеймін.
Dialogue: 0,0:13:15.55,0:13:18.85,Default - Copy,Ophelia,0,0,0,,Клеймор атты жауынгер суға батып кетті.
Dialogue: 0,0:13:18.85,0:13:21.19,Default - Copy,Ophelia,0,0,0,,Бұл қайғылы оқиға, солай емес пе?
Dialogue: 0,0:13:21.19,0:13:22.82,Default - Copy,Ophelia,0,0,0,,Тіпті әзіл-оспақ
Dialogue: 0,0:13:24.12,0:13:27.33,Default - Copy,Ophelia,0,0,0,,Бұл не? Бұл не?
Dialogue: 0,0:13:27.69,0:13:28.79,Default - Copy,Ophelia,0,0,0,,Не?
Dialogue: 0,0:13:28.79,0:13:29.93,Default - Copy,Ophelia,0,0,0,,1 4 0 0
Dialogue: 0,0:13:30.73,0:13:32.20,Default - Copy,Ophelia,0,0,0,,Бұл кім?
Dialogue: 0,0:13:38.47,0:13:39.80,Default - Copy,Ophelia,0,0,0,,Тоқта!
Dialogue: 0,0:13:39.80,0:13:40.61,Default - Copy,Ophelia,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:13:40.97,0:13:42.34,Default - Copy,Ophelia,0,0,0,,Мен қалжыңдамаймын.
Dialogue: 0,0:13:42.77,0:13:43.54,Default - Copy,Ophelia,0,0,0,,I
Dialogue: 0,0:13:44.44,0:13:46.48,Default - Copy,Ophelia,0,0,0,,Мен ояумын дейсіз бе?
Dialogue: 0,0:13:47.65,0:13:51.68,Default - Copy,Ophelia,0,0,0,,Жооооо
Dialogue: 0,0:13:51.68,0:13:54.09,Default - Copy,Ophelia,0,0,0,,Неліктен? Неге мен?
Dialogue: 0,0:13:54.09,0:13:57.46,Default - Copy,Ophelia,0,0,0,,Ағамды жау еткім келді.
Dialogue: 0,0:13:57.59,0:14:02.73,Default - Copy,Ophelia,0,0,0,,Бірақ мен неге сол құбыжық болуым керек?
Dialogue: 0,0:14:02.73,0:14:06.73,Default - Copy,Ophelia,0,0,0,,Мұның бәрі сол бір мүйізді құбыжықтың кесірінен.
Dialogue: 0,0:14:21.95,0:14:23.48,Default - Copy,Ophelia,0,0,0,,1 4 0 0
Dialogue: 0,0:14:23.88,0:14:25.72,Default - Copy,Ophelia,0,0,0,,Оң қолымнан айырылдым.
Dialogue: 0,0:14:26.38,0:14:27.69,Default - Copy,Ophelia,0,0,0,,Сіз мұны істедіңіз
Dialogue: 0,0:14:28.19,0:14:29.15,Default - Copy,Ophelia,0,0,0,,Не?
Dialogue: 0,0:14:29.15,0:14:30.96,Default - Copy,Ophelia,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:14:31.59,0:14:34.23,Default - Copy,Ophelia,0,0,0,,Көбінесе сіз кінәлісіз.
Dialogue: 0,0:14:34.23,0:14:37.47,Default - Copy,Ophelia,0,0,0,,Сенсіз мұның ешқайсысы болмас еді.
Dialogue: 0,0:14:37.93,0:14:40.23,Default - Copy,Ophelia,0,0,0,,Бәріне сен кінәлісің.
Dialogue: 0,0:14:40.23,0:14:43.17,Default - Copy,Ophelia,0,0,0,,Сен болмасаң, ағам да өлмес еді.
Dialogue: 0,0:14:43.17,0:14:45.97,Default - Copy,Ophelia,0,0,0,,Мен де ешқашан мұндай болған емеспін.
Dialogue: 0,0:14:55.21,0:14:57.22,Default - Copy,Ophelia,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:14:57.75,0:15:01.05,Default - Copy,Clare,0,0,0,,Ұйым нөмірі 47 Клэр
Dialogue: 0,0:15:01.72,0:15:03.89,Default - Copy,Clare,0,0,0,,Терезаның еті мен қанын мұра етті
Dialogue: 0,0:15:03.89,0:15:05.76,Default - Copy,Clare,0,0,0,,Айриннің оң қолымен
Dialogue: 0,0:15:06.66,0:15:10.70,Default - Copy,Clare,0,0,0,,Жалғыз мүйізді құбыжық Прискиланың басын аулайды.
Dialogue: 0,0:15:12.10,0:15:16.24,Default - Copy,Clare,0,0,0,,Кешіріңіз, жаныңызды өзіммен бірге алып кетемін.
Dialogue: 0,0:15:26.14,0:15:27.88,Default - Copy,Ophelia,0,0,0,,Ку шитга
Dialogue: 0,0:15:43.53,0:15:45.23,Default - Copy,Clare,0,0,0,,Сыну нүктесін назардан тыс қалдырған
Dialogue: 0,0:15:45.73,0:15:49.80,Default - Copy,Clare,0,0,0,,Жоқ, Айриннің қолы оған әлі толық үйренген жоқ.
Dialogue: 0,0:15:51.44,0:15:52.37,Default - Copy,Ophelia,0,0,0,,Мен көремін.
Dialogue: 0,0:15:52.84,0:15:55.41,Default - Copy,Ophelia,0,0,0,,Бұл несие.
Dialogue: 0,0:15:55.41,0:15:58.34,Default - Copy,Ophelia,0,0,0,,Мен мұны бұрын бір жерден көрдім деп ойладым.
Dialogue: 0,0:15:58.34,0:15:59.58,Default - Copy,Ophelia,0,0,0,,Бұл ол.
Dialogue: 0,0:15:59.58,0:16:02.89,Default - Copy,Ophelia,0,0,0,,Әлгі қарғыс атқан әйел, Айриннің оң қолы.
Dialogue: 0,0:16:03.31,0:16:06.88,Default - Copy,Ophelia,0,0,0,,Демек, сіз қысқа мерзімде соншалықты мықты бола алдыңыз ба?
Dialogue: 0,0:16:08.12,0:16:11.46,Default - Copy,Ophelia,0,0,0,,Бір қолдың сиқырлы күшін толық босату
Dialogue: 0,0:16:11.46,0:16:17.73,Default - Copy,Ophelia,0,0,0,,Бар болғаны сол бір қолды басқару және қолыңыздағы қылыш туралы ешқашан айтпау керек.
Dialogue: 0,0:16:17.73,0:16:19.10,Default - Copy,Ophelia,0,0,0,,сияқты нәрсе
Dialogue: 0,0:16:19.76,0:16:21.97,Default - Copy,Ophelia,0,0,0,,Әрең, сен.
Dialogue: 0,0:16:22.47,0:16:25.07,Default - Copy,Ophelia,0,0,0,,Менің пропорционалды емес оң қолымның арқасында
Dialogue: 0,0:16:25.07,0:16:27.07,Default - Copy,Ophelia,0,0,0,,Менің бүкіл денем дірілдеп тұр.
Dialogue: 0,0:16:48.56,0:16:53.70,Default - Copy,Ophelia,0,0,0,,Мен адам ретінде барымды құйрығымның ұшына шоғырландырдым.
Dialogue: 0,0:16:53.70,0:16:56.63,Default - Copy,Ophelia,0,0,0,,Демек, бұл менің әлсіз жерім.
Dialogue: 0,0:16:57.77,0:17:00.14,Default - Copy,Ophelia,0,0,0,,Саа Ойын ойнайық
Dialogue: 0,0:17:00.61,0:17:04.44,Default - Copy,Ophelia,0,0,0,,Осы жерге жету үшін мен туралы барлығын кесіп тастасаң
Dialogue: 0,0:17:04.44,0:17:05.68,Default - Copy,Ophelia,0,0,0,,Сіз жеңдіңіз
Dialogue: 0,0:17:06.38,0:17:08.88,Default - Copy,Ophelia,0,0,0,,Керісінше, жарты жолда энергиям таусылды.
Dialogue: 0,0:17:08.88,0:17:10.72,Default - Copy,Ophelia,0,0,0,,Оянғанда
Dialogue: 0,0:17:10.72,0:17:12.12,Default - Copy,Ophelia,0,0,0,,Менің жеңісім
Dialogue: 0,0:17:12.12,0:17:16.69,Default - Copy,Ophelia,0,0,0,,Сіз бір мүйізді құбыжықпен күресуге жарамсыз едіңіз.
Dialogue: 0,0:17:16.99,0:17:17.82,Default - Copy,Ophelia,0,0,0,,Ұзақ жұмыс күнінен кейін бір шыныаяқ сакэ ішуден артық ештеңе жоқ!
Dialogue: 0,0:17:17.82,0:17:18.99,Default - Copy,Ophelia,0,0,0,,Қызық көрінеді, солай ма?
Dialogue: 0,0:17:21.99,0:17:26.96,Default - Copy,Ophelia,0,0,0,,Жеңілсем, мойынсұнып өз еркімді саған тапсырамын.
Dialogue: 0,0:17:36.01,0:17:37.44,Default - Copy,Ophelia,0,0,0,,Сен ақымақсың.
Dialogue: 0,0:17:37.44,0:17:39.74,Default - Copy,Ophelia,0,0,0,,Менің айтқанымды елемеу
Dialogue: 0,0:17:39.74,0:17:41.72,Default - Copy,Ophelia,0,0,0,,Мен осында тікелей көздейтінімді қалаймын.
Dialogue: 0,0:17:42.45,0:17:44.58,Default - Copy,Ophelia,0,0,0,,Сен неге сонша үмітсізсің?
Dialogue: 0,0:17:45.25,0:17:47.02,Default - Copy,Ophelia,0,0,0,,Өзін-өзі бұзушы
Dialogue: 0,0:17:47.02,0:17:51.02,Default - Copy,Ophelia,0,0,0,,Артында қалғандар қалай сезінетінін ойламаңыз.
Dialogue: 0,0:17:51.76,0:17:52.32,Default - Copy,Ophelia,0,0,0,,Бұл
Dialogue: 0,0:17:53.29,0:17:55.49,Default - Copy,Ophelia,0,0,0,,Бұл кім туралы?
Dialogue: 0,0:17:58.06,0:17:59.70,Default - Copy,bro,0,0,0,,Енді тез қаш.
Dialogue: 0,0:18:00.26,0:18:01.74,Default - Copy,bro,0,0,0,,Мен оны тартамын
Dialogue: 0,0:18:04.70,0:18:07.41,Default - Copy,bro,0,0,0,,Қазір қашу керек.
Dialogue: 0,0:18:07.41,0:18:09.41,Default - Copy,Ophelia,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:18:09.91,0:18:11.11,Default - Copy,Ophelia,0,0,0,,Үлкен аға
Dialogue: 0,0:18:11.11,0:18:14.25,Default - Copy,Ophelia,0,0,0,,Сіз мені қорғау үшін оған қарай бет алдыңыз ба?
Dialogue: 0,0:18:22.45,0:18:25.22,Default - Copy,Ophelia,0,0,0,,Қолымнан келмесе де, жалғыз тұрамын
Dialogue: 0,0:18:25.62,0:18:27.66,Default - Copy,Ophelia,0,0,0,,Өздігінен өледі
Dialogue: 0,0:18:30.86,0:18:32.70,Default - Copy,Ophelia,0,0,0,,Мен оны қатты жек көремін.
Dialogue: 0,0:18:39.57,0:18:40.47,Default - Copy,Ophelia,0,0,0,,Бұл, сөзсіз, қоңырау шалған жігіт сияқты. Ол «Юхамон» қолданушысы да, жау да емес.
Dialogue: 0,0:18:40.47,0:18:41.91,Default - Copy,Ophelia,0,0,0,,Енді бітті
Dialogue: 0,0:18:41.91,0:18:43.71,Default - Copy,Ophelia,0,0,0,,Бұл бәрінен бұрын.
Dialogue: 0,0:18:43.88,0:18:45.74,Default - Copy,Clare,0,0,0,,Құтты болсын
Dialogue: 0,0:18:45.74,0:18:48.72,Default - Copy,Clare,0,0,0,,Қозғалу, қозғалу, қозғалу
Dialogue: 0,0:18:51.05,0:18:52.05,Default - Copy,Clare,0,0,0,,Жылжыту
Dialogue: 0,0:18:58.76,0:19:00.53,Default - Copy,Clare,0,0,0,,Менің қолым кетіп қалды
Dialogue: 0,0:19:04.53,0:19:06.83,Default - Copy,Ophelia,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:19:06.83,0:19:09.07,Default - Copy,Ophelia,0,0,0,,Өз бетімен өлсең
Dialogue: 0,0:19:09.07,0:19:11.54,Default - Copy,Ophelia,0,0,0,,Артында қалғандар не істеу керек?
Dialogue: 0,0:19:23.65,0:19:26.38,Default - Copy,Ophelia,0,0,0,,Не? Мен мұны істей алмаймын.
Dialogue: 0,0:19:28.99,0:19:31.19,Default - Copy,Ophelia,0,0,0,,Неліктен мен?
Dialogue: 0,0:19:51.88,0:19:52.88,Default - Copy,Ophelia,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:19:53.34,0:19:54.85,Default - Copy,Ophelia,0,0,0,,Сіз жеңдіңіз
Dialogue: 0,0:19:55.41,0:19:58.48,Default - Copy,Ophelia,0,0,0,,Уәде еткендей мен бәрін саған сеніп тапсырамын.
Dialogue: 0,0:19:59.08,0:20:02.39,Default - Copy,Ophelia,0,0,0,,Мен бұл туралы ештеңе істей алмадым.
Dialogue: 0,0:20:02.99,0:20:04.59,Default - Copy,Ophelia,0,0,0,,Бұл мүлдем жиіркенішті.
Dialogue: 0,0:20:05.12,0:20:09.86,Default - Copy,Ophelia,0,0,0,,Маған сен сияқты өмірін қатерге тіккендер ұнамайды.
Dialogue: 0,0:20:11.40,0:20:13.67,Default - Copy,Ophelia,0,0,0,,Саа, аяқта.
Dialogue: 0,0:20:14.20,0:20:16.33,Default - Copy,Ophelia,0,0,0,,Асықпасаң, қайта жанданады.
Dialogue: 0,0:20:17.27,0:20:18.58,Default - Copy,Clare,0,0,0,,Офелия
Dialogue: 0,0:20:24.28,0:20:26.48,Default - Copy,Ophelia,0,0,0,,Менің орнымда төбелесесің.
Dialogue: 0,0:20:26.88,0:20:28.75,Default - Copy,Ophelia,0,0,0,,Егер жеңілсең, мен оны қабылдамаймын.
Dialogue: 0,0:20:36.89,0:20:38.86,Default - Copy,Ophelia,0,0,0,,A. Түсінемін.
Dialogue: 0,0:20:39.19,0:20:41.36,Default - Copy,Ophelia,0,0,0,,Үлкен ағаның соңғы күлкісі
Dialogue: 0,0:20:42.56,0:20:47.73,Default - Copy,Ophelia,0,0,0,,Ағам мені қорғай алатынын растап жымиды.
Dialogue: 0,0:20:48.87,0:20:49.97,Default - Copy,Ophelia,0,0,0,,Неліктен?
Dialogue: 0,0:20:50.61,0:20:54.28,Default - Copy,Ophelia,0,0,0,,Мен мұны қалай ұмыта бердім деп ойлаймын.
Dialogue: 0,0:20:55.81,0:20:58.28,Default - Copy,Ophelia,0,0,0,,Кешіріңіз, аға.
Dialogue: 0,0:21:06.52,0:21:11.09,Default - Copy,Ophelia,0,0,0,,Сол жерде тағы бірге ойнайық, ағайын.
Dialogue: 0,0:22:40.40,0:22:42.30,Default - Copy,,0,0,0,,Қаңғыбас ойлар
Dialogue: 0,0:22:42.30,0:22:43.84,Default - Copy,,0,0,0,,Қаңғыбас жауынгер
Dialogue: 0,0:22:43.94,0:22:46.54,Default - Copy,,0,0,0,,Қауіптердің пайда болуы
Dialogue: 0,0:22:48.04,0:22:54.04,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory