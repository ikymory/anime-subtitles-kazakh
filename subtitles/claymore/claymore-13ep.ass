Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:39.05,0:01:40.08,Default,,0,0,0,,Кеш болды
Dialogue: 0,0:01:41.05,0:01:44.00,Default,,0,0,0,,Сіз тым кеш қалдыңыз.
Dialogue: 0,0:01:44.09,0:01:48.02,Default,,0,0,0,,Қалдық өте көп.
Dialogue: 0,0:01:48.02,0:01:50.08,Default,,0,0,0,,Сіздің қалай күресетініңіз де солай.
Dialogue: 0,0:01:50.08,0:01:53.05,Default,,0,0,0,,Оның біршама күші бар.
Dialogue: 0,0:01:53.05,0:01:56.01,Default,,0,0,0,,тиімдірек пайдалану керек
Dialogue: 0,0:02:01.07,0:02:03.02,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:03.05,0:02:06.08,Default,,0,0,0,,Өте күшті қарсыласпен күрескеннен кейін
Dialogue: 0,0:02:06.08,0:02:08.08,Default,,0,0,0,,Мен қатты толқып тұрмын
Dialogue: 0,0:02:11.07,0:02:13.01,Default,,0,0,0,,Оянғандар
Dialogue: 0,0:02:13.06,0:02:16.09,Default,,0,0,0,,Мен олардың әрқайсысын жұлып аламын.
Dialogue: 0,0:02:24.08,0:02:26.06,Default,,0,0,0,,Сіз неге еліктейсіз?
Dialogue: 0,0:02:27.02,0:02:29.03,Default,,0,0,0,,Жындарыңызды өзіңіз басу
Dialogue: 0,0:02:29.07,0:02:31.06,Default,,0,0,0,,Сіз бас тарттыңыз
Dialogue: 0,0:02:35.09,0:02:38.06,Default,,0,0,0,,Сіз қызықсыз
Dialogue: 0,0:02:55.01,0:02:57.01,Default,,0,0,0,,Бұл не? Бұл не?
Dialogue: 0,0:02:57.05,0:03:00.05,Default,,0,0,0,,Мүмкін мен жындардың қимылын болжап отырған шығармын.
Dialogue: 0,0:03:01.01,0:03:02.08,Default,,0,0,0,,Сіз мұны жасамайсыз
Dialogue: 0,0:03:02.08,0:03:04.05,Default,,0,0,0,,Айтыңызшы.
Dialogue: 0,0:03:04.05,0:03:07.03,Default,,0,0,0,,Бұрын қызықсыз деп айтқаным үшін кешіріңіз.
Dialogue: 0,0:03:16.02,0:03:19.08,Default,,0,0,0,,О, өте жақсы сезіледі.
Dialogue: 0,0:03:20.04,0:03:24.00,Default,,0,0,0,,Мен мұны істеудің уақыты келді деп ойладым.
Dialogue: 0,0:03:24.08,0:03:28.00,Default,,0,0,0,,Дәл қазір бұл қандай оғаш сезім?
Dialogue: 0,0:03:30.08,0:03:32.04,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:03:32.04,0:03:34.09,Default,,0,0,0,,Бірінші атылғанда өлме.
Dialogue: 0,0:03:38.02,0:03:39.01,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:03:39.01,0:03:40.03,Default,,0,0,0,,Аяқтан оң иыққа дейін
Dialogue: 0,0:03:48.03,0:03:49.08,Default,,0,0,0,,Жоғарғы қатардан сол иыққа
Dialogue: 0,0:03:54.02,0:03:55.02,Default,,0,0,0,,Әлде маған, осы жігіттерге және Зерттеу корпусы ұйымына сенесің бе?
Dialogue: 0,0:03:55.02,0:03:56.08,Default,,0,0,0,,Мен қылыштың траекториясын оқыдым.
Dialogue: 0,0:03:56.08,0:03:58.03,Default,,0,0,0,,Неліктен оның алдын алуға болмайды?
Dialogue: 0,0:04:03.03,0:04:04.03,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:04:04.09,0:04:07.04,Default,,0,0,0,,Қылыш жылан сияқты
Dialogue: 0,0:04:10.08,0:04:12.04,Default,,0,0,0,,Бұл ұят болды.
Dialogue: 0,0:04:14.05,0:04:19.09,Default,,0,0,0,,Егер мен сіздің қарсыласыңыз болмасам, сіз өте жақсы жерде болар едіңіз деп ойлаймын.
Dialogue: 0,0:04:22.00,0:04:23.04,Default,,0,0,0,,Мен кіммін?
Dialogue: 0,0:04:24.00,0:04:27.05,Default,,0,0,0,,Оның басқалар сияқты лақап аты жоқ.
Dialogue: 0,0:04:27.08,0:04:29.06,Default,,0,0,0,,Мирия фантом
Dialogue: 0,0:04:29.06,0:04:31.05,Default,,0,0,0,,Флора жел кескіш
Dialogue: 0,0:04:31.05,0:04:32.07,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:04:33.03,0:04:36.01,Default,,0,0,0,,Сондықтан ерекше қимылдарды жасау үшін көп жұмыс жасадым.
Dialogue: 0,0:04:36.01,0:04:37.08,Default,,0,0,0,,Мен оған ат қойдым.
Dialogue: 0,0:04:42.08,0:04:45.03,Default,,0,0,0,,Бұл толқынды қылыш деп аталады.
Dialogue: 0,0:04:46.03,0:04:47.03,Default,,0,0,0,,Қылыш
Dialogue: 0,0:04:47.08,0:04:49.04,Default,,0,0,0,,Жоқ, бұл иллюзия.
Dialogue: 0,0:04:49.08,0:04:51.09,Default,,0,0,0,,Мүмкін емес қол қозғалысымен
Dialogue: 0,0:04:51.09,0:04:54.02,Default,,0,0,0,,Жылан тәрізді қозғалысты жасау
Dialogue: 0,0:04:55.00,0:04:56.08,Default,,0,0,0,,Өте жақсы.
Dialogue: 0,0:04:57.03,0:05:02.00,Default,,0,0,0,,Менің ойымша, Ripples of Ophelia тамаша емес.
Dialogue: 0,0:05:04.02,0:05:07.05,Default,,0,0,0,,Бірақ ол кеңейіп жатқан жоқ.
Dialogue: 0,0:05:08.00,0:05:12.05,Default,,0,0,0,,Мұны көрген адамдардың көпшілігі өледі.
Dialogue: 0,0:05:14.07,0:05:15.05,Default,,0,0,0,,Қолымнан келгеннің бәрін жасадым
Dialogue: 0,0:05:16.03,0:05:19.02,Default,,0,0,0,,Бұл менің алдыма қарайтын әдіс емес.
Dialogue: 0,0:05:23.06,0:05:26.08,Default,,0,0,0,,О, сіз әлі де мотивациясыз.
Dialogue: 0,0:05:27.01,0:05:29.08,Default,,0,0,0,,Сізде жеңу мүмкіндігі бар ма деп ойлаймын.
Dialogue: 0,0:05:32.02,0:05:33.04,Default,,0,0,0,,Жеңіске жету мүмкіндігі бар ма?
Dialogue: 0,0:05:34.01,0:05:37.02,Default,,0,0,0,,Мұндай нәрсе басынан бері бола алмайды.
Dialogue: 0,0:05:40.04,0:05:41.02,Default,,0,0,0,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:05:41.02,0:05:43.01,Default,,0,0,0,,Фронтальды шабуыл
Dialogue: 0,0:05:47.06,0:05:49.06,Default,,0,0,0,,Қандай көңілсіздік.
Dialogue: 0,0:05:59.04,0:06:01.01,Default,,0,0,0,,Бұл шынымен қызықсыз
Dialogue: 0,0:06:01.01,0:06:02.02,Default,,0,0,0,,Өлген
Dialogue: 0,0:06:21.09,0:06:24.01,Default,,0,0,0,,Пердені жабуда қателессеңіз
Dialogue: 0,0:06:24.04,0:06:26.01,Default,,0,0,0,,Бұл жай ғана шіркін
Dialogue: 0,0:06:48.04,0:06:49.04,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:06:49.04,0:06:51.02,Default,,0,0,0,,Кесілген жер тым терең болды ма?
Dialogue: 0,0:06:52.03,0:06:56.04,Default,,0,0,0,,Жоқ, бірақ одан таязырақ болса, кесу сезімі жеткіліксіз болады.
Dialogue: 0,0:06:57.06,0:06:59.05,Default,,0,0,0,,Тірі болған жақсы ма?
Dialogue: 0,0:07:02.08,0:07:04.03,Default,,0,0,0,,Демалуға уақыт жоқ
Dialogue: 0,0:07:04.07,0:07:05.09,Default,,0,0,0,,Тез қарулану
Dialogue: 0,0:07:05.09,0:07:07.07,Default,,0,0,0,,​​Сіз мұны жасайсыз.
Dialogue: 0,0:07:10.08,0:07:13.05,Default,,0,0,0,,Мен алданып қала жаздадым.
Dialogue: 0,0:07:14.05,0:07:17.06,Default,,0,0,0,,Әсіресе оң қолды кесіп алған жақсы.
Dialogue: 0,0:07:18.02,0:07:21.01,Default,,0,0,0,,Орнындалғандай көрінетін нәрсе.
Dialogue: 0,0:07:21.08,0:07:25.05,Default,,0,0,0,,Бұл орынды таңдау осыны ескере отырып жасалды.
Dialogue: 0,0:07:26.03,0:07:31.02,Default,,0,0,0,,Мен сенің алақаныңда әу бастан билеп келемін.
Dialogue: 0,0:07:32.01,0:07:36.01,Default,,0,0,0,,Бірақ содан кейін сол оң қолымнан бас тартуым керек еді.
Dialogue: 0,0:07:37.02,0:07:41.07,Default,,0,0,0,,Менің назарымды аударғаны – аяғына дейін оң қолым үшін уайымдадым.
Dialogue: 0,0:07:43.03,0:07:44.07,Default,,0,0,0,,Иә, білемін.
Dialogue: 0,0:07:44.07,0:07:48.05,Default,,0,0,0,,Біз сияқты шабуылға шебер жауынгерлердің де түрлері бар.
Dialogue: 0,0:07:48.05,0:07:51.00,Default,,0,0,0,,Қорғанысы тамаша түрі бар.
Dialogue: 0,0:07:51.04,0:07:53.05,Default,,0,0,0,,Сіз агрессивті типсіз
Dialogue: 0,0:07:54.01,0:07:58.01,Default,,0,0,0,,Шабуылшылар өз денелерін қалпына келтіруге шебер емес, солай ма?
Dialogue: 0,0:07:58.01,0:08:01.02,Default,,0,0,0,,Кесілген денелерді қосу мүмкін болғанымен
Dialogue: 0,0:08:01.02,0:08:04.00,Default,,0,0,0,,Жоғалғанды қайта қалпына келтіру мүмкін емес.
Dialogue: 0,0:08:05.00,0:08:07.02,Default,,0,0,0,,Жарты адам, жартылай жын болған кезде
Dialogue: 0,0:08:07.02,0:08:11.00,Default,,0,0,0,,Сіз аман қалу үшін өзіңізді қорғау туралы ойладыңыз ба?
Dialogue: 0,0:08:11.04,0:08:14.09,Default,,0,0,0,,Сіз басқа адамды өлтіру туралы ойладыңыз ба?
Dialogue: 0,0:08:14.09,0:08:17.01,Default,,0,0,0,,Бұл жолдың бұрылысы.
Dialogue: 0,0:08:23.03,0:08:27.02,Default,,0,0,0,,арқылы не айтқым келеді
Dialogue: 0,0:08:27.05,0:08:31.07,Default,,0,0,0,,Менің ойымша, мен сол оң қолдың бекітілуін күтіп отырмын.
Dialogue: 0,0:08:39.01,0:08:40.05,Default,,0,0,0,,Өте жаман
Dialogue: 0,0:08:40.05,0:08:43.06,Default,,0,0,0,,Оның басым қолын кесіп алуы қате болды.
Dialogue: 0,0:09:08.07,0:09:10.04,Default,,0,0,0,,Күресудің қажеті жоқ
Dialogue: 0,0:09:10.04,0:09:13.00,Default,,0,0,0,,Тіпті сіз оны әрең білмейсіз.
Dialogue: 0,0:09:23.03,0:09:26.01,Default,,0,0,0,,Иә. . Сіз сонша тырысып жатқаныңызға сене алар емеспін
Dialogue: 0,0:09:26.01,0:09:28.04,Default,,0,0,0,,Сол балаға уәде бер
Dialogue: 0,0:09:28.04,0:09:32.05,Default,,0,0,0,,Немесе сізде кек алу керек шығар.
Dialogue: 0,0:09:41.06,0:09:42.04,Default,,0,0,0,,Иә
Dialogue: 0,0:09:42.04,0:09:44.04,Default,,0,0,0,,Енді мен қылышты да ұстай алмаймын.
Dialogue: 0,0:09:48.03,0:09:50.04,Default,,0,0,0,,Өйткені қорғайтын нәрсе бар
Dialogue: 0,0:09:51.00,0:09:55.00,Default,,0,0,0,,Сіз өмір сүре аласыз, өйткені сізде өлмеуге себеп бар.
Dialogue: 0,0:09:55.04,0:09:57.02,Default,,0,0,0,,Бұл әлсіздердің ақымақ адасуы.
Dialogue: 0,0:09:59.09,0:10:01.05,Default,,0,0,0,,Бұл өте қызық болды.
Dialogue: 0,0:10:08.09,0:10:12.02,Default,,0,0,0,,Мені сағыныш сезімі шақырып, осында келдім.
Dialogue: 0,0:10:13.00,0:10:14.08,Default,,0,0,0,,Екі беті де белгісіз.
Dialogue: 0,0:10:17.03,0:10:19.01,Default,,0,0,0,,Не?
Dialogue: 0,0:10:19.01,0:10:21.01,Default,,0,0,0,,Мен ешқандай елес энергияны сезбеймін.
Dialogue: 0,0:10:21.05,0:10:26.06,Default,,0,0,0,,Мені ең қатты ренжітетіні – көңілді жүргенімде, мені бөгетпейді.
Dialogue: 0,0:10:28.01,0:10:29.00,Default,,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:10:29.00,0:10:30.05,Default,,0,0,0,,Бұл қауіпті
Dialogue: 0,0:10:30.05,0:10:31.06,Default,,0,0,0,,Мен оны қажетсіз өлуіне жол бермеймін!
Dialogue: 0,0:10:33.03,0:10:34.03,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:34.03,0:10:35.04,Default,,0,0,0,,Шығатын жол жоқ сияқты
Dialogue: 0,0:10:41.07,0:10:44.01,Default,,0,0,0,,Эй, сен не істедің?
Dialogue: 0,0:10:44.08,0:10:48.08,Default,,0,0,0,,Қазіргі жауынгерлер тіпті қарапайым адамдарға қылышты бере ме?
Dialogue: 0,0:10:56.01,0:10:57.02,Default,,0,0,0,,Не?
Dialogue: 0,0:10:57.02,0:10:58.06,Default,,0,0,0,,Титан туралы сөйлесіп отырдық, иә?
Dialogue: 0,0:11:02.01,0:11:03.01,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:11:03.01,0:11:03.51,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:11:06.08,0:11:08.07,Default,,0,0,0,,Бұл біртүрлі қылыш.
Dialogue: 0,0:11:09.03,0:11:12.01,Default,,0,0,0,,Оның белгілі бір саны бар шығар.
Dialogue: 0,0:11:14.00,0:11:16.08,Default,,0,0,0,,Бірақ Бұл қылыштың алдында мағынасыз
Dialogue: 0,0:11:20.01,0:11:22.02,Default,,0,0,0,,Қ-қандай?
Dialogue: 0,0:11:22.02,0:11:23.06,Default,,0,0,0,,Бұл көзге көрінбейтін қылыш
Dialogue: 0,0:11:30.01,0:11:31.00,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:11:31.06,0:11:32.07,Default,,0,0,0,,Ол тірі болды ма?
Dialogue: 0,0:11:35.06,0:11:37.06,Default,,0,0,0,,Терезаның бағынышты тобының бірі
Dialogue: 0,0:11:38.01,0:11:39.05,Default,,0,0,0,,Бұрынғы №2
Dialogue: 0,0:11:40.09,0:11:43.02,Default,,0,0,0,,Жылдам қылыш Ирин
Dialogue: 0,0:11:50.08,0:11:52.08,Default,,0,0,0,,Өйткені қорғайтын нәрсе бар
Dialogue: 0,0:11:53.02,0:11:56.06,Default,,0,0,0,,Сіз өмір сүре аласыз, өйткені сізде өлмеуге себеп бар.
Dialogue: 0,0:11:57.00,0:11:59.03,Default,,0,0,0,,Бұл әлсіздердің ақымақ адасуы.
Dialogue: 0,0:12:09.01,0:12:10.02,Default,,0,0,0,,Бұл
Dialogue: 0,0:12:24.05,0:12:25.05,Default,,0,0,0,,Сол қол
Dialogue: 0,0:12:28.05,0:12:32.08,Default,,0,0,0,,Сол қолымды байлағаннан кейін ес-түссіз қалдым.
Dialogue: 0,0:12:33.05,0:12:37.04,Default,,0,0,0,,Бүлінгеніне қарамастан жақсы жасалған.
Dialogue: 0,0:12:38.00,0:12:38.50,Default,,0,0,0,,Айрин
Dialogue: 0,0:12:40.09,0:12:42.06,Default,,0,0,0,,Бұл қай жерде?
Dialogue: 0,0:12:42.06,0:12:43.09,Default,,0,0,0,,Содан бері неше күн өтті?
Dialogue: 0,0:12:44.04,0:12:45.06,Default,,0,0,0,,Неге сен?
Dialogue: 0,0:12:47.00,0:12:49.02,Default,,0,0,0,,Тек аузыңызға салыңыз.
Dialogue: 0,0:12:49.07,0:12:53.06,Default,,0,0,0,,Бір апта бойы ішіп-жемей қоятын кез келді.
Dialogue: 0,0:12:54.00,0:12:55.01,Default,,0,0,0,,Бір апта бойы
Dialogue: 0,0:12:57.02,0:12:58.07,Default,,0,0,0,,Менің қылышым қайда?
Dialogue: 0,0:12:59.01,0:13:01.01,Default,,0,0,0,,Эй Егер тезірек оралмасақ
Dialogue: 0,0:13:02.08,0:13:04.08,Default,,0,0,0,,Өмір соншалықты қажет болмаса
Dialogue: 0,0:13:04.08,0:13:07.09,Default,,0,0,0,,Мен оны дәл осы жерден кесіп аламын.
Dialogue: 0,0:13:08.03,0:13:12.01,Default,,0,0,0,,Тыңдашы, сені қуған әйел әлі тірі.
Dialogue: 0,0:13:12.08,0:13:14.09,Default,,0,0,0,,Мен саған қарағанда көбірек зиян келтірдім.
Dialogue: 0,0:13:15.03,0:13:16.05,Default,,0,0,0,,Өлмеген
Dialogue: 0,0:13:18.04,0:13:19.03,Default,,0,0,0,,Кейде көңіл көтеру керек қой…
Dialogue: 0,0:13:19.08,0:13:24.07,Default,,0,0,0,,Сіз басым қолыңыздан айырылдыңыз, енді бір қолыңызбен күресуден басқа амалыңыз жоқ.
Dialogue: 0,0:13:25.04,0:13:28.04,Default,,0,0,0,,Дәл қазір бір кішкентай шабақтарды жеңе алмау керек.
Dialogue: 0,0:13:34.05,0:13:37.01,Default,,0,0,0,,Менің ойымша, сіз өзіңізді аздап түсіндіре аласыз.
Dialogue: 0,0:13:39.03,0:13:40.04,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:13:46.01,0:13:48.05,Default,,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:14:22.00,0:14:23.06,Default,,0,0,0,,Сол қыз
Dialogue: 0,0:14:39.08,0:14:41.05,Default,,0,0,0,,Тамағыңызды бітірдіңіз бе?
Dialogue: 0,0:14:41.08,0:14:42.06,Default,,0,0,0,,Ах
Dialogue: 0,0:14:43.00,0:14:47.03,Default,,0,0,0,,Мен тістеп алған сәтте-ақ қарнымның ашқанын түсіндім.
Dialogue: 0,0:14:47.09,0:14:48.08,Default,,0,0,0,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,0:14:49.08,0:14:51.08,Default,,0,0,0,,Сіз менің атымды білдіңіз
Dialogue: 0,0:14:51.08,0:14:52.09,Default,,0,0,0,,Сіз зерттедіңіз бе?
Dialogue: 0,0:14:53.05,0:14:54.05,Default,,0,0,0,,At that time
Dialogue: 0,0:14:55.03,0:14:57.08,Default,,0,0,0,,Терезаға қатысты барлығы
Dialogue: 0,0:14:58.02,0:15:00.08,Default,,0,0,0,,Әрине, Прискила туралы да.
Dialogue: 0,0:15:01.01,0:15:01.51,Default,,0,0,0,,Ах
Dialogue: 0,0:15:04.03,0:15:07.07,Default,,0,0,0,,Присцилла, ол сол кезде 2-ші нөмір болуы керек еді
Dialogue: 0,0:15:10.08,0:15:12.07,Default,,0,0,0,,Алайда ол миссия кезінде оянды.
Dialogue: 0,0:15:13.05,0:15:16.04,Default,,0,0,0,,Терезаны және оның бағынышты тобын өлтіріп, жоғалып кетті.
Dialogue: 0,0:15:19.04,0:15:21.08,Default,,0,0,0,,Мен сені тірі деп ойламадым.
Dialogue: 0,0:15:22.08,0:15:24.06,Default,,0,0,0,,Мен де таң қалдым.
Dialogue: 0,0:15:25.04,0:15:28.07,Default,,0,0,0,,Мен ол кездегі бала жауынгер болып шығады деп ойламаппын.
Dialogue: 0,0:15:30.07,0:15:34.00,Default,,0,0,0,,Тереза ​​сіздің ішіңізде ме?
Dialogue: 0,0:15:37.00,0:15:39.03,Default,,0,0,0,,Өмірді алу бақыты болса
Dialogue: 0,0:15:39.03,0:15:43.01,Default,,0,0,0,,Бәрін ұмытып, адам болып өмір сүрсем ғой.
Dialogue: 0,0:15:43.07,0:15:45.09,Default,,0,0,0,,Прискиланың басын алуды жоспарлап отырсыз ба?
Dialogue: 0,0:15:46.04,0:15:47.08,Default,,0,0,0,,Thank you for your help
Dialogue: 0,0:15:48.04,0:15:50.00,Default,,0,0,0,,Менің қылышым қайда?
Dialogue: 0,0:15:50.05,0:15:51.06,Default,,0,0,0,,Тоқта.
Dialogue: 0,0:15:52.00,0:15:54.02,Default,,0,0,0,,Прискиланың күші басым
Dialogue: 0,0:15:54.08,0:15:58.09,Default,,0,0,0,,Қазіргі жауынгерлердің ешқайсысы оны тоқтата алмайды.
Dialogue: 0,0:15:59.07,0:16:02.06,Default,,0,0,0,,Әсіресе сіз Терезаның еті мен қанын алғаннан бері.
Dialogue: 0,0:16:02.06,0:16:04.05,Default,,0,0,0,,Жарты адам, жартылай жын да емес
Dialogue: 0,0:16:04.05,0:16:05.05,Default,,0,0,0,,Тоқсан
Dialogue: 0,0:16:06.01,0:16:08.04,Default,,0,0,0,,Бәрінен де төмен
Dialogue: 0,0:16:09.05,0:16:11.03,Default,,0,0,0,,Маған қылышымды бер
Dialogue: 0,0:16:12.06,0:16:13.04,Default,,0,0,0,,Алмастар! Мұнда алмастар көмілген.
Dialogue: 0,0:16:15.06,0:16:20.04,Default,,0,0,0,,Қылышыма бір рет тигенде сол қолымнан айырылдым.
Dialogue: 0,0:16:20.08,0:16:26.09,Default,,0,0,0,,Қанша тырысқанымызбен, олардан жеңу мүмкін емес екенін сол кезде түсіндім.
Dialogue: 0,0:16:29.05,0:16:32.01,Default,,0,0,0,,Ал мен өзімді өліп қалдым
Dialogue: 0,0:16:32.05,0:16:35.00,Default,,0,0,0,,Ұйымның иісі жоқ жерді таңдаңыз.
Dialogue: 0,0:16:35.04,0:16:37.09,Default,,0,0,0,,Мен жындарымды басып өмір сүрдім.
Dialogue: 0,0:16:40.00,0:16:42.02,Default,,0,0,0,,Көп жылдар бойы басылған жындық қуат
Dialogue: 0,0:16:42.02,0:16:44.07,Default,,0,0,0,,Менің достарым да енді байқамайды
Dialogue: 0,0:16:45.03,0:16:46.09,Default,,0,0,0,,Сіз ұрысты тоқтаттыңыз ба?
Dialogue: 0,0:16:47.06,0:16:48.09,Default,,0,0,0,,Оның бір ғана қолы болса да
Dialogue: 0,0:16:49.02,0:16:51.00,Default,,0,0,0,,Мен осылай қылышты қолдансам да.
Dialogue: 0,0:16:52.05,0:16:54.07,Default,,0,0,0,,Мен қорқамын.
Dialogue: 0,0:16:55.08,0:16:58.06,Default,,0,0,0,,Сол кездегі қорқыныш санамда қалып қойды, жібермейді.
Dialogue: 0,0:16:59.04,0:17:01.00,Default,,0,0,0,,Сіз де көрген боларсыз.
Dialogue: 0,0:17:14.04,0:17:15.05,Default,,0,0,0,,Саған үйрететін кез келді
Dialogue: 0,0:17:16.02,0:17:17.01,Default,,0,0,0,,Ол сондай адам.
Dialogue: 0,0:17:21.04,0:17:22.01,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:17:23.07,0:17:25.03,Default,,0,0,0,,Неге сонша?
Dialogue: 0,0:17:26.08,0:17:28.02,Default,,0,0,0,,Мен үшін
Dialogue: 0,0:17:29.02,0:17:31.00,Default,,0,0,0,,Тереза бәрі болды
Dialogue: 0,0:17:32.09,0:17:35.04,Default,,0,0,0,,Бір кезде жоғалған өмір мен сөздер
Dialogue: 0,0:17:36.00,0:17:37.05,Default,,0,0,0,,Тіпті өмір сүрудің қуанышы
Dialogue: 0,0:17:38.01,0:17:39.09,Default,,0,0,0,,Тереза оны қайтарып алды
Dialogue: 0,0:17:41.02,0:17:44.08,Default,,0,0,0,,Тереза маған бәрін берді
Dialogue: 0,0:17:45.04,0:17:49.08,Default,,0,0,0,,Сондықтан алға ұмтылудан басқа амалым қалмады.
Dialogue: 0,0:17:51.08,0:17:53.05,Default,,0,0,0,,Сол кез туралы
Dialogue: 0,0:17:53.05,0:17:58.02,Default,,0,0,0,,Бәрін ұмытып, адам болып өмір сүруге күшім жетпеді.
Dialogue: 0,0:18:02.03,0:18:03.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:04.04,0:18:05.08,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:18:10.01,0:18:12.06,Default,,0,0,0,,Мен де дәл сол кезде көрдім.
Dialogue: 0,0:18:12.06,0:18:15.00,Default,,0,0,0,,Алға немесе артқа жылжу ма?
Dialogue: 0,0:18:16.00,0:18:21.09,Default,,0,0,0,,Бұл сіздің жекпе-жекке жарамдылығыңыз немесе жоқтығыңыздың бетбұрыс нүктесі болса керек.
Dialogue: 0,0:18:33.08,0:18:36.08,Default,,0,0,0,,Мен сенің атыңды әлі естіген жоқпын.
Dialogue: 0,0:18:37.09,0:18:39.00,Default,,0,0,0,,Бұл Клэр.
Dialogue: 0,0:18:43.01,0:18:44.05,Default,,0,0,0,,Жарайды, Клэр.
Dialogue: 0,0:18:46.09,0:18:49.06,Default,,0,0,0,,Мен саған жылдам семсерді үйретемін.
Dialogue: 0,0:18:58.00,0:18:58.50,Default,,0,0,0,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:18:59.05,0:19:00.06,Default,,0,0,0,,Ауырды
Dialogue: 0,0:19:01.06,0:19:05.07,Default,,0,0,0,,Ауырды, ағайын.
Dialogue: 0,0:19:09.03,0:19:12.04,Default,,0,0,0,,Маған көмектесші, ағайын.
Dialogue: 0,0:19:13.02,0:19:17.00,Default,,0,0,0,,Сен мені әрқашан қорғадың.
Dialogue: 0,0:19:18.03,0:19:19.04,Default,,0,0,0,,Шыгандшинаға баратын жолды іздеуге аттанған Зерттеу корпусы,
Dialogue: 0,0:19:19.09,0:19:23.03,Default,,0,0,0,,Сен неге оңай өлесің?
Dialogue: 0,0:19:24.01,0:19:27.05,Default,,0,0,0,,Сіз мені қорғауыңыз керек еді, солай ма?
Dialogue: 0,0:19:30.04,0:19:32.01,Default,,0,0,0,,Әлгі қарғыс атқан әйел
Dialogue: 0,0:19:32.07,0:19:34.04,Default,,0,0,0,,Бұл тегін емес.
Dialogue: 0,0:19:34.09,0:19:36.05,Default,,0,0,0,,Бұл менің ағам.
Dialogue: 0,0:19:36.05,0:19:37.07,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:19:38.02,0:19:40.01,Default,,0,0,0,,Осындай бір мүйізді құбыжықтың жеуі
Dialogue: 0,0:19:40.01,0:19:43.00,Default,,0,0,0,,Мен ыңғайлы көрінетін ешкімді білмеймін.
Dialogue: 0,0:19:43.00,0:19:45.01,Default,,0,0,0,,Ақымақ болма, бейбақ.
Dialogue: 0,0:19:45.01,0:19:51.03,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:20:06.06,0:20:07.05,Default,,0,0,0,,Осымен
Dialogue: 0,0:20:07.05,0:20:08.04,Default,,0,0,0,,Оларды мына жерге ыстық шоколадпен қойып кетейін, жарай ма?
Dialogue: 0,0:20:14.00,0:20:15.08,Default,,0,0,0,,Жылдам семсердің шын мәні неде?
Dialogue: 0,0:20:15.08,0:20:18.04,Default,,0,0,0,,Бір ғана қолдың сиқырлы күшін толық босату
Dialogue: 0,0:20:18.09,0:20:22.04,Default,,0,0,0,,Басқаша айтқанда, бір қолы ғана ояу сияқты.
Dialogue: 0,0:20:23.03,0:20:27.01,Default,,0,0,0,,Ол үшін күшті ерік күші қажет.
Dialogue: 0,0:20:27.07,0:20:31.05,Default,,0,0,0,,Бұл оның бір қолын ұстайтын күшті психикалық күш.
Dialogue: 0,0:20:32.02,0:20:36.04,Default,,0,0,0,,Сонда сіз өңіңізді мүлде өзгертпей осылай жасадыңыз ба?
Dialogue: 0,0:20:37.01,0:20:38.00,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:20:38.04,0:20:39.05,Default,,0,0,0,,Мен бас тартуым керек пе?
Dialogue: 0,0:20:41.06,0:20:42.08,Default,,0,0,0,,Мен қалжыңдамаймын.
Dialogue: 0,0:20:44.01,0:20:46.09,Default,,0,0,0,,Бұл мен үшін өте қолайлы.
Dialogue: 0,0:20:47.09,0:20:49.01,Default,,0,0,0,,Жарайды, келіңіз.
Dialogue: 0,0:20:49.01,0:20:53.09,Default,,0,0,0,,Бір қолдың толық сиқырлы күшінің шегін өзіңіздікіне айналдырыңыз.
Dialogue: 0,0:21:01.03,0:21:02.06,Default,,0,0,0,,Бірдеңе
Dialogue: 0,0:21:03.07,0:21:06.02,Default,,0,0,0,,Мен өзімді жақсы сезінемін.
Dialogue: 0,0:21:07.06,0:21:10.06,Default,,0,0,0,,Денемдегі кешегі ауырсыну өтірік сияқты
Dialogue: 0,0:21:11.07,0:21:13.00,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:21:13.07,0:21:15.02,Default,,0,0,0,,Мен мұнда жүктеме болғым келмейді.
Dialogue: 0,0:21:16.05,0:21:18.08,Default,,0,0,0,,Бірақ менің қарным аздап ашты.
Dialogue: 0,0:21:19.03,0:21:20.03,Default,,0,0,0,,Мм.
Dialogue: 0,0:21:20.08,0:21:23.04,Default,,0,0,0,,Мен қатты аштық сезінемін.
Dialogue: 0,0:21:23.08,0:21:24.09,Default,,0,0,0,,Қызық екен
Dialogue: 0,0:21:26.01,0:21:27.00,Default,,0,0,0,,Дұшпан тұзақты тарылтып жатыр.
Dialogue: 0,0:21:27.07,0:21:29.02,Default,,0,0,0,,Мен ішкі ағзаларды жегім келеді
Dialogue: 0,0:22:40.04,0:22:42.03,Default,,0,0,0,,Өмір сүруді растау
Dialogue: 0,0:22:42.03,0:22:43.08,Default,,0,0,0,,Тірі екендігін дәлелдеу
Dialogue: 0,0:22:43.09,0:22:46.05,Default,,0,0,0,,Бар екендігін дәлелдеу
Dialogue: 0,0:22:47.55,0:22:52.55,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
