Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:37.47,0:00:38.68,1080,,0000,0000,0000,,Шығу тегі
Dialogue: 0,0:00:40.35,0:00:43.10,1080,,0000,0000,0000,,Әлем – жансыз жаратушы
Dialogue: 0,0:00:43.10,0:00:45.04,1080,,0000,0000,0000,,Демиургпен
Dialogue: 0,0:00:45.04,0:00:48.60,1080,,0000,0000,0000,,Идеялар дүниенің шынайы формасы болып табылады
Dialogue: 0,0:00:51.66,0:00:56.42,1080,,0000,0000,0000,,Тек бейберекет,пішінсіз жан болды.
Dialogue: 0,0:01:02.31,0:01:07.80,1080,,0000,0000,0000,,Демиург оны жасайтын болмысты білмейді.
Dialogue: 0,0:01:09.06,0:01:11.21,1080,,0000,0000,0000,,Жанды білмеу
Dialogue: 0,0:01:16.10,0:01:18.26,1080,,0000,0000,0000,,Идеяларды білмеу
Dialogue: 0,0:01:21.58,0:01:24.13,1080,,0000,0000,0000,,Сол арқылы жасалған дүние
Dialogue: 0,0:01:24.13,0:01:27.34,1080,,0000,0000,0000,,Шынайы дүниенің көлеңкесі ғана
Dialogue: 0,0:02:46.64,0:02:51.93,1080,,0000,0000,0000,,Біз өткен күні Кавасаки өнеркәсіптік аймағында орын алған ауқымды электр қуатының үзілуін зерттеп жатырмыз.
Dialogue: 0,0:02:51.93,0:02:54.10,1080,,0000,0000,0000,,Себеп әлі белгісіз...
Dialogue: 0,0:03:01.54,0:03:05.16,1080,,0000,0000,0000,,Үлкен аға Үлкен аға
Dialogue: 0,0:03:06.53,0:03:08.12,1080,,0000,0000,0000,,Үлкен аға
Dialogue: 0,0:03:13.68,0:03:15.47,1080,,0000,0000,0000,,Үлкен аға
Dialogue: 0,0:03:16.78,0:03:19.77,1080,,0000,0000,0000,,Ояныңыз.
Dialogue: 0,0:03:19.77,0:03:21.60,1080,,0000,0000,0000,,Үлкен аға
Dialogue: 0,0:03:23.78,0:03:26.57,1080,,0000,0000,0000,,Егер асықпасаң,таңғы жаттығуға кешігіп қаласың.
Dialogue: 0,0:03:26.57,0:03:28.42,1080,,0000,0000,0000,,Шынайы ма?
Dialogue: 0,0:03:42.71,0:03:44.48,1080,,0000,0000,0000,,О,дұрыс. Сенде де Хиёри-чаннан сұрағың келетін нәрсе бар емес пе?
Dialogue: 0,0:03:44.48,0:03:46.40,1080,,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:05:48.05,0:05:49.95,1080,,0000,0000,0000,,Әрі қарай жүрейік
Dialogue: 0,0:05:49.95,0:05:52.11,1080,,0000,0000,0000,,Сенде бәрі жақсы.
Dialogue: 0,0:05:52.11,0:05:54.73,1080,,0000,0000,0000,,Жарайды,үзіліс жасаңыз.
Dialogue: 0,0:06:06.94,0:06:09.00,1080,,0000,0000,0000,,Сол Хикари
Dialogue: 0,0:06:09.44,0:06:11.90,1080,,0000,0000,0000,,Аға бір нәрсені ұмытып қалды
Dialogue: 0,0:06:11.90,0:06:13.84,1080,,0000,0000,0000,,Өте өкінішті,рахмет
Dialogue: 0,0:06:13.84,0:06:16.44,1080,,0000,0000,0000,,Дүкеннен алған балмұздақ үшін рахмет.
Dialogue: 0,0:06:16.44,0:06:18.86,1080,,0000,0000,0000,,Құлпынай шоколады бомбасы
Dialogue: 0,0:06:18.86,0:06:22.16,1080,,0000,0000,0000,,Маусымдық гипертропикалық эспрессо
Dialogue: 0,0:06:22.16,0:06:24.53,1080,,0000,0000,0000,,Иә,түсінемін.
Dialogue: 0,0:06:24.53,0:06:25.88,1080,,0000,0000,0000,,Тайчи
Dialogue: 0,0:06:26.46,0:06:28.02,1080,,0000,0000,0000,,Келесі Келесіге барайық
Dialogue: 0,0:06:28.02,0:06:30.61,1080,,0000,0000,0000,,Мен жай ғана демалуыңызды өтіндім.
Dialogue: 0,0:06:30.61,0:06:33.30,1080,,0000,0000,0000,,Бізде демалуға уақыт болмайды.
Dialogue: 0,0:06:33.30,0:06:36.54,1080,,0000,0000,0000,,Әрқашан прогресс бар,Хикару-сан.
Dialogue: 0,0:06:37.64,0:06:39.68,1080,,0000,0000,0000,,Иә
Dialogue: 0,0:06:39.68,0:06:41.80,1080,,0000,0000,0000,,Сіздің тәжірибеңізге сәттілік
Dialogue: 0,0:07:01.41,0:07:03.58,1080,,0000,0000,0000,,Осы жексенбі?
Dialogue: 0,0:07:06.59,0:07:08.26,1080,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:07:09.39,0:07:10.64,1080,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:07:19.38,0:07:21.21,1080,,0000,0000,0000,,Қайырлы таң Ягами
Dialogue: 0,0:07:21.21,0:07:23.53,1080,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:07:23.53,0:07:25.97,1080,,0000,0000,0000,,Сіз оны қайтадан әкелген жоқсыз.
Dialogue: 0,0:07:27.73,0:07:29.02,1080,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:07:29.02,0:07:31.39,1080,,0000,0000,0000,,Жалғыз сен қалдың.
Dialogue: 0,0:07:31.39,0:07:33.06,1080,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:07:33.44,0:07:36.26,1080,,0000,0000,0000,,Түскі үзілісте мұғалімге келіңіз.
Dialogue: 0,0:07:36.95,0:07:38.13,1080,,0000,0000,0000,,Жауап:
Dialogue: 0,0:07:38.13,0:07:40.64,1080,,0000,0000,0000,,Осындай кеш келу—
Dialogue: 0,0:07:43.51,0:07:44.87,1080,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:07:44.87,0:07:46.62,1080,,0000,0000,0000,,Мансап туралы өтініш хат
Dialogue: 0,0:07:46.62,0:07:49.44,1080,,0000,0000,0000,,Е,мен оны әлі шығарған жоқпын.
Dialogue: 0,0:07:51.82,0:07:54.97,1080,,0000,0000,0000,,Содан кейін өтініш хатыңызды жылдам жіберіңіз.
Dialogue: 0,0:08:21.05,0:08:23.47,1080,,0000,0000,0000,,Live Сіз де келесіз
Dialogue: 0,0:08:23.47,0:08:25.42,1080,,0000,0000,0000,,Жасөспірім қасқырлар?
Dialogue: 0,0:08:25.42,0:08:27.58,1080,,0000,0000,0000,,Таратылды және аты өзгерді
Dialogue: 0,0:08:27.58,0:08:28.40,1080,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:08:28.40,0:08:30.12,1080,,0000,0000,0000,,Күннің пышағы
Dialogue: 0,0:08:36.13,0:08:38.66,1080,,0000,0000,0000,,Ерітудің қандай да бір түрі болды ма?
Dialogue: 0,0:08:38.66,0:08:40.89,1080,,0000,0000,0000,,Музыкалық ерекшелігі
Dialogue: 0,0:08:40.89,0:08:44.35,1080,,0000,0000,0000,,Музыкалық?
Dialogue: 0,0:08:45.10,0:08:49.35,1080,,0000,0000,0000,,Арнайы сорпа ыдысыңызда құссаңыз не істейсіз?
Dialogue: 0,0:08:50.73,0:08:52.82,1080,,0000,0000,0000,,жексенбі?
Dialogue: 0,0:08:52.82,0:08:54.82,1080,,0000,0000,0000,,Мен,бұл футбол матчы.
Dialogue: 0,0:08:54.82,0:08:57.40,1080,,0000,0000,0000,,көремін.
Dialogue: 0,0:08:59.14,0:09:00.45,1080,,0000,0000,0000,,Мұны қабылдаңыз
Dialogue: 0,0:09:05.25,0:09:06.39,1080,,0000,0000,0000,,Тоқта
Dialogue: 0,0:09:06.39,0:09:08.33,1080,,0000,0000,0000,,Бұл қызмет. Бұл қызмет.
Dialogue: 0,0:09:08.33,0:09:09.88,1080,,0000,0000,0000,,Тоқта
Dialogue: 0,0:09:11.50,0:09:14.10,1080,,0000,0000,0000,,Ақылсыз ештеңе жасама.
Dialogue: 0,0:09:14.10,0:09:17.06,1080,,0000,0000,0000,,Бұрыштың дұрыс мөлшері бар.
Dialogue: 0,0:09:17.06,0:09:18.56,1080,,0000,0000,0000,,Мен раменге ерекше көңіл бөлемін...
Dialogue: 0,0:09:18.56,0:09:20.26,1080,,0000,0000,0000,,Knife Of Ramen фильмінен күткендей
Dialogue: 0,0:09:20.26,0:09:21.58,1080,,0000,0000,0000,,Ендеше,ертең кездескенше.
Dialogue: 0,0:09:26.80,0:09:29.26,1080,,0000,0000,0000,,Ендеше не істеуіміз керек,Ягами?
Dialogue: 0,0:09:29.64,0:09:31.11,1080,,0000,0000,0000,,Менің ойымша,бұл осындай нәрсе.
Dialogue: 0,0:09:31.11,0:09:33.45,1080,,0000,0000,0000,,Болашақта...
Dialogue: 0,0:09:35.43,0:09:36.90,1080,,0000,0000,0000,,Бөлек
Dialogue: 0,0:09:39.41,0:09:41.38,1080,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:09:41.38,0:09:43.26,1080,,0000,0000,0000,,Мен мұны жеуге бола ма?
Dialogue: 0,0:09:43.26,0:09:45.57,1080,,0000,0000,0000,,Сіз жеп қойған болуыңыз керек.
Dialogue: 0,0:09:45.57,0:09:47.06,1080,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:09:47.62,0:09:49.67,1080,,0000,0000,0000,,Itadadakimasu
Dialogue: 0,0:09:49.67,0:09:52.60,1080,,0000,0000,0000,,Енді не істегіңіз келеді?
Dialogue: 0,0:09:52.60,0:09:54.68,1080,,0000,0000,0000,,Бір нәрсе бар шығар.
Dialogue: 0,0:09:54.68,0:09:56.85,1080,,0000,0000,0000,,Мен шынымен түсінбеймін.
Dialogue: 0,0:09:56.85,0:09:59.40,1080,,0000,0000,0000,,Күшпен болса да айтайық.
Dialogue: 0,0:10:01.20,0:10:04.04,1080,,0000,0000,0000,,Ал,мен достарыммен танысқым келеді.
Dialogue: 0,0:10:07.14,0:10:09.91,1080,,0000,0000,0000,,Бұл алыс,жету қиын жер.
Dialogue: 0,0:10:10.96,0:10:13.63,1080,,0000,0000,0000,,Мен ол жерге жиі баратынмын.
Dialogue: 0,0:10:17.52,0:10:19.81,1080,,0000,0000,0000,,Міне,солай.
Dialogue: 0,0:10:19.81,0:10:23.20,1080,,0000,0000,0000,,Олай болса,неге алдымен тілді оқымасқа?
Dialogue: 0,0:10:23.20,0:10:25.10,1080,,0000,0000,0000,,Көптеген мектептер бар.
Dialogue: 0,0:10:25.10,0:10:28.55,1080,,0000,0000,0000,,Университетке түскеннен кейін немен айналысқыңыз келетінін іздеңіз
Dialogue: 0,0:10:32.58,0:10:35.16,1080,,0000,0000,0000,,Армандар үлкен
Dialogue: 0,0:11:28.03,0:11:29.71,1080,,0000,0000,0000,,Коуширо
Dialogue: 0,0:11:33.72,0:11:35.28,1080,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:11:35.28,0:11:38.90,1080,,0000,0000,0000,,Өкінішке орай,бұл күн менің ата-анамның үйлену тойы болды.
Dialogue: 0,0:11:38.90,0:11:41.09,1080,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:11:41.09,0:11:42.49,1080,,0000,0000,0000,,Ямато мырза және т.б
Dialogue: 0,0:11:42.49,0:11:44.20,1080,,0000,0000,0000,,Сол күні жанды қойылым болады.
Dialogue: 0,0:11:44.20,0:11:47.58,1080,,0000,0000,0000,,Джо да түсу емтихандарына оқуы керек,сондықтан оны шақыру қиын.
Dialogue: 0,0:11:47.58,0:11:50.89,1080,,0000,0000,0000,,Мен Хикару мен Такеруді де көруге шақырамын,бірақ білмеймін.
Dialogue: 0,0:11:50.89,0:11:53.92,1080,,0000,0000,0000,,Соңғы кезде жиналу қиын болды.
Dialogue: 0,0:11:53.92,0:11:55.45,1080,,0000,0000,0000,,Жарайды,проблема жоқ.
Dialogue: 0,0:11:56.46,0:12:00.18,1080,,0000,0000,0000,,Осыны ойлап,сені шақырдым.
Dialogue: 0,0:12:00.18,0:12:02.40,1080,,0000,0000,0000,,Иә.
Dialogue: 0,0:12:02.40,0:12:05.43,1080,,0000,0000,0000,,Мимиге электрондық пошта жіберіп көргіңіз келе ме? Тек жағдайда
Dialogue: 0,0:12:05.43,0:12:07.87,1080,,0000,0000,0000,,Мүмкін Америка
Dialogue: 0,0:12:07.87,0:12:10.43,1080,,0000,0000,0000,,Мүмкін емес Мүмкін емес Мен бұл мүмкін емес екеніне сенімдімін.
Dialogue: 0,0:12:10.43,0:12:14.54,1080,,0000,0000,0000,,Бірақ егер бұл Мими-сан болса,ол оңай келуі мүмкін.
Dialogue: 0,0:12:15.21,0:12:18.32,1080,,0000,0000,0000,,Мен оның не істеп жатқанына таң қаламын
Dialogue: 0,0:12:18.32,0:12:21.40,1080,,0000,0000,0000,,Жауап тез келді
Dialogue: 0,0:12:21.40,0:12:24.66,1080,,0000,0000,0000,,Сәлем Шақыру Сізге көп рахмет
Dialogue: 0,0:12:24.66,0:12:28.59,1080,,0000,0000,0000,,Мен сізге рейстің ақысын төлеймін,сондықтан оған қамқорлық жасаңыз. Мими
Dialogue: 0,0:12:29.24,0:12:31.16,1080,,0000,0000,0000,,Куру дегеніміз не?
Dialogue: 0,0:12:31.16,0:12:35.99,1080,,0000,0000,0000,,Тайчи мырза,менде осы демалыс күндері Нью-Йорк Токиоға бару билетім бар.
Dialogue: 0,0:12:35.99,0:12:38.96,1080,,0000,0000,0000,,Тұрақты баға – 1 080 000 иен.
Dialogue: 0,0:12:38.96,0:12:42.96,1080,,0000,0000,0000,,Жақында әр авиакомпаниядан арнайы жанармайға қосымша ақылар шығарылды.
Dialogue: 0,0:12:42.96,0:12:46.04,1080,,0000,0000,0000,,Жанармайға қосымша ақы деп аталатындардың енгізілуіне байланысты
Dialogue: 0,0:12:46.04,0:12:48.26,1080,,0000,0000,0000,,Бұған алымдар қосылады
Dialogue: 0,0:12:48.73,0:12:51.78,1080,,0000,0000,0000,,Мұнда әр компанияның алымдарының салыстырмалы кестесі берілген.
Dialogue: 0,0:12:52.18,0:12:55.18,1080,,0000,0000,0000,,Бірақ бұл Мими-сан туралы.
Dialogue: 0,0:12:55.18,0:12:58.07,1080,,0000,0000,0000,,Мүмкін мен де бизнес-класты қарастыруым керек шығар.
Dialogue: 0,0:12:58.07,0:12:59.47,1080,,0000,0000,0000,,(Присцилла Барриэлл) Бұл мен естіген ең жалықтырарлық,мағынасыз әңгіме.
Dialogue: 0,0:13:00.67,0:13:03.24,1080,,0000,0000,0000,,Кешіріңіз,менің жексенбіге жоспарым бар.
Dialogue: 0,0:13:03.24,0:13:05.50,1080,,0000,0000,0000,,Мен түсінемін,бұл жақсы емес.
Dialogue: 0,0:13:05.50,0:13:07.92,1080,,0000,0000,0000,,Мен достарыммен ағамның концертіне барамын.
Dialogue: 0,0:13:07.92,0:13:10.24,1080,,0000,0000,0000,,Менің досым қыз
Dialogue: 0,0:13:15.70,0:13:19.06,1080,,0000,0000,0000,,Такеру-кун танымал.
Dialogue: 0,0:13:19.06,0:13:21.88,1080,,0000,0000,0000,,Бұл дұрыс емес,біз жай ғана доспыз.
Dialogue: 0,0:13:24.10,0:13:25.26,1080,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:13:25.26,0:13:27.32,1080,,0000,0000,0000,,Бөлек
Dialogue: 0,0:13:27.32,0:13:28.93,1080,,0000,0000,0000,,Не?
Dialogue: 0,0:13:28.93,0:13:31.49,1080,,0000,0000,0000,,Хикари-чан пісірілген мочи
Dialogue: 0,0:13:31.95,0:13:33.59,1080,,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:13:34.85,0:13:37.33,1080,,0000,0000,0000,,Ешкім мені қолдауға келмесе ше?
Dialogue: 0,0:13:37.33,0:13:39.40,1080,,0000,0000,0000,,Үлкен аға көңіл күйі түсіп кететін сияқты.
Dialogue: 0,0:13:39.40,0:13:42.90,1080,,0000,0000,0000,,Концертке барлығының келуін қатты қалаған сияқтысыз.
Dialogue: 0,0:13:42.90,0:13:44.00,1080,,0000,0000,0000,,Юкине-кун,бұл адамды танисың ба?
Dialogue: 0,0:13:44.00,0:13:45.95,1080,,0000,0000,0000,,Мен айтпаймын.
Dialogue: 0,0:13:45.95,0:13:47.63,1080,,0000,0000,0000,,Ах~ Ол тірі!
Dialogue: 0,0:13:47.63,0:13:50.44,1080,,0000,0000,0000,,Үлкен ағамыз туралы екеуміз де қиналып жатырмыз.
Dialogue: 0,0:13:52.27,0:13:53.80,1080,,0000,0000,0000,,Мені қайта шақырыңыз
Dialogue: 0,0:13:53.80,0:13:55.75,1080,,0000,0000,0000,,Қош бол
Dialogue: 0,0:14:23.35,0:14:28.35,1080,,0000,0000,0000,,Мектеп тестінің нәтижесі белгілі болды,сондықтан орындарды ауыстырамыз.
Dialogue: 0,0:14:28.35,0:14:31.71,1080,,0000,0000,0000,,Бағаларыңыздың реті бойынша алдыңғы жағынан отырыңыз.
Dialogue: 0,0:14:35.53,0:14:39.55,1080,,0000,0000,0000,,Менің сыныбымда төртінші қатардағы бағалар D.
Dialogue: 0,0:14:39.55,0:14:43.53,1080,,0000,0000,0000,,Артқы орындарда отырған оқушылар,қазірден бастап көбірек тырысыңдар.
Dialogue: 0,0:14:45.31,0:14:47.17,1080,,0000,0000,0000,,Төртінші баған...
Dialogue: 0,0:15:08.73,0:15:11.86,1080,,0000,0000,0000,,Иә,куәгерлер шыға бастады.
Dialogue: 0,0:15:11.86,0:15:13.37,1080,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:15:13.37,0:15:15.40,1080,,0000,0000,0000,,Әзірге ешқандай зиян келтірілген жоқ.
Dialogue: 0,0:15:15.40,0:15:17.48,1080,,0000,0000,0000,,Мүмкін бұл уақыт мәселесі шығар
Dialogue: 0,0:15:17.98,0:15:19.24,1080,,0000,0000,0000,,Сен Құбыжықтарды жоюшылар корпусының мүшесі емессің бе?
Dialogue: 0,0:15:20.77,0:15:22.77,1080,,0000,0000,0000,,Рю...шима...күте тұрыңыз...
Dialogue: 0,0:15:35.51,0:15:39.17,1080,,0000,0000,0000,,Соңғы кездері Канто аймағында электр қуатының ауқымды үзілуі жиі орын алуда.
Dialogue: 0,0:15:39.17,0:15:41.50,1080,,0000,0000,0000,,Мен сізді қолдауға келе алмағаным үшін кешіріңіз.
Dialogue: 0,0:15:41.50,0:15:44.57,1080,,0000,0000,0000,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:15:44.57,0:15:47.42,1080,,0000,0000,0000,,Менің ойымша,бұл сіздің туған күніңіз.
Dialogue: 0,0:15:50.28,0:15:55.08,1080,,0000,0000,0000,,Себебі орын алу уақыты мен орны жиі болатын радиокедергілердің жиілігімен сәйкес келеді.
Dialogue: 0,0:15:55.08,0:15:57.97,1080,,0000,0000,0000,,Сондай-ақ өзара қарым-қатынас болуы мүмкін екендігі атап өтілді.
Dialogue: 0,0:15:57.97,0:15:59.46,1080,,0000,0000,0000,,Үлкен аға
Dialogue: 0,0:15:59.46,0:16:01.24,1080,,0000,0000,0000,,Жарайды ма бәрібір.
Dialogue: 0,0:16:01.24,0:16:02.91,1080,,0000,0000,0000,,Оған көмектесу мүмкін емес
Dialogue: 0,0:16:02.91,0:16:05.24,1080,,0000,0000,0000,,Барлығы бос емес.
Dialogue: 0,0:16:05.42,0:16:07.65,1080,,0000,0000,0000,,Маған бәрібір.
Dialogue: 0,0:16:07.65,0:16:08.86,1080,,0000,0000,0000,,Мұны жасамаңыз.
Dialogue: 0,0:16:08.86,0:16:10.13,1080,,0000,0000,0000,,Орындау
Dialogue: 0,0:16:10.13,0:16:12.33,1080,,0000,0000,0000,,Шығу
Dialogue: 0,0:16:12.33,0:16:14.80,1080,,0000,0000,0000,,Дәлірек айтсақ,сәл ойыс.
Dialogue: 0,0:16:14.80,0:16:17.53,1080,,0000,0000,0000,,«Мен депрессияға түсемін» деген сияқты.
Dialogue: 0,0:16:18.24,0:16:19.91,1080,,0000,0000,0000,,Гочисусама
Dialogue: 0,0:16:20.17,0:16:21.60,1080,,0000,0000,0000,,Ол мойнын қорғап қалды
Dialogue: 0,0:16:21.60,0:16:23.08,1080,,0000,0000,0000,,Сіз білесіз...
Dialogue: 0,0:16:23.08,0:16:26.42,1080,,0000,0000,0000,,Жарқыраудың керемет сезімін сезініңіз.
Dialogue: 0,0:16:26.42,0:16:27.86,1080,,0000,0000,0000,,Не?
Dialogue: 0,0:16:28.31,0:16:31.46,1080,,0000,0000,0000,,Иә, иә,бәрі жақсы.
Dialogue: 0,0:16:31.46,0:16:33.91,1080,,0000,0000,0000,,Матчта сәттілік
Dialogue: 0,0:17:18.71,0:17:22.24,1080,,0000,0000,0000,,Кешіріңіз,мен бірден кетемін.
Dialogue: 0,0:17:30.24,0:17:33.44,1080,,0000,0000,0000,,Айтайын дегенім, Тайчи,тез айт.
Dialogue: 0,0:17:33.44,0:17:36.49,1080,,0000,0000,0000,,Білсем,ертерек дайындалар едім.
Dialogue: 0,0:17:36.49,0:17:40.93,1080,,0000,0000,0000,,Ойын сағат 2-де басталады,тез қозғалдық делік...
Dialogue: 0,0:17:40.93,0:17:44.16,1080,,0000,0000,0000,,Тікелей эфирге жету үшін 30 минут қажет.
Dialogue: 0,0:17:44.49,0:17:46.34,1080,,0000,0000,0000,,А... қазірдің өзінде
Dialogue: 0,0:17:46.73,0:17:48.33,1080,,0000,0000,0000,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса,ықтималдығы аз болса да
Dialogue: 0,0:17:48.33,0:17:51.06,1080,,0000,0000,0000,,Матчты көргеннен кейін бірден қозғалсаңыз...
Dialogue: 0,0:17:51.06,0:17:54.81,1080,,0000,0000,0000,,Енді ойлап отырсам,Ямато тобы қандай нөмірде шығады екен деп ойлаймын.
Dialogue: 0,0:17:54.81,0:17:58.55,1080,,0000,0000,0000,,Егер бұл бірінші рет болса, асығыс болса да,сіз ешқашан уақытында үлгере алмайсыз.
Dialogue: 0,0:17:58.55,0:18:00.74,1080,,0000,0000,0000,,Керісінше,тікелей эфирден кейінгі матч?
Dialogue: 0,0:18:01.18,0:18:05.73,1080,,0000,0000,0000,,Сіз не істеп жатырсыз? Мықты бол,мен.
Dialogue: 0,0:18:06.69,0:18:11.12,1080,,0000,0000,0000,,Дұрысы,мен неге сонша уайымдауым керек?
Dialogue: 0,0:18:11.12,0:18:15.41,1080,,0000,0000,0000,,Жетер,екеуміз де бармаймыз.
Dialogue: 0,0:18:17.45,0:18:19.83,1080,,0000,0000,0000,,Артық уақыт жоқ
Dialogue: 0,0:18:23.15,0:18:25.84,1080,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:18:28.62,0:18:30.48,1080,,0000,0000,0000,,Жақсы нәрсе болатын сияқты...
Dialogue: 0,0:18:30.95,0:18:33.65,1080,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:18:35.14,0:18:36.88,1080,,0000,0000,0000,,Ұялы телефон
Dialogue: 0,0:18:50.97,0:18:52.56,1080,,0000,0000,0000,,Бір сәт кешіріңіз.
Dialogue: 0,0:18:53.58,0:18:55.86,1080,,0000,0000,0000,,Мен босмын
Dialogue: 0,0:18:55.86,0:18:57.24,1080,,0000,0000,0000,,Сора мырза
Dialogue: 0,0:18:57.24,0:18:59.95,1080,,0000,0000,0000,,Кешіріңіз,мен сізге дәл қазір қоңырау шалғаныма қуаныштымын.
Dialogue: 0,0:18:59.95,0:19:04.00,1080,,0000,0000,0000,,Не болды? Шұғыл нәрсе бар ма?
Dialogue: 0,0:19:04.00,0:19:06.92,1080,,0000,0000,0000,,Дұрыс,шын мәнінде бірінші.
Dialogue: 0,0:19:06.92,0:19:10.63,1080,,0000,0000,0000,,Иә, иә,түсіндім.
Dialogue: 0,0:19:11.19,0:19:12.77,1080,,0000,0000,0000,,сорпа пиязы
Dialogue: 0,0:19:13.86,0:19:17.41,1080,,0000,0000,0000,,Бұл телефон қоңырауында күлкілі нәрсе бар ма?
Dialogue: 0,0:19:17.41,0:19:19.26,1080,,0000,0000,0000,,Мен ағылшын тіліне ұқсайтын нәрсені естимін.
Dialogue: 0,0:19:19.26,0:19:23.24,1080,,0000,0000,0000,,Бұл айқас болуы мүмкін. Бұрын да болған.
Dialogue: 0,0:19:23.24,0:19:27.12,1080,,0000,0000,0000,,Алдымен байланыс және цифрлық құрылғылар әсер етті.
Dialogue: 0,0:19:27.45,0:19:32.10,1080,,0000,0000,0000,,Canard à l'orangeIl y a du thé Oolong
Dialogue: 0,0:19:34.99,0:19:37.38,1080,,0000,0000,0000,,Мен жақсылық көргім келмейді
Dialogue: 0,0:19:37.38,0:19:40.91,1080,,0000,0000,0000,,Мен түсінбеймін. Мен сізге қайта қоңырау шаламын.
Dialogue: 0,0:19:40.91,0:19:43.13,1080,,0000,0000,0000,,Бұл Сора мырза.
Dialogue: 0,0:19:43.13,0:19:44.27,1080,,0000,0000,0000,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:19:59.42,0:20:02.39,1080,,0000,0000,0000,,Билеттер өте жақсы сатылуда.
Dialogue: 0,0:20:02.39,0:20:05.76,1080,,0000,0000,0000,,Барлығы сіздің жаңа тобыңызды асыға күтетін сияқты.
Dialogue: 0,0:20:06.09,0:20:08.45,1080,,0000,0000,0000,,Аты кім?
Dialogue: 0,0:20:08.45,0:20:10.84,1080,,0000,0000,0000,,Жасөспірім қасқырлар емес
Dialogue: 0,0:20:10.84,0:20:12.44,1080,,0000,0000,0000,,Күннің пышағы
Dialogue: 0,0:20:15.00,0:20:15.88,1080,,0000,0000,0000,,Бұл
Dialogue: 0,0:20:18.11,0:20:19.81,1080,,0000,0000,0000,,Ағамның ойы қандай—
Dialogue: 0,0:20:32.82,0:20:34.53,1080,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:20:50.81,0:20:54.26,1080,,0000,0000,0000,,Мен саған тек Хикару-чанды әкел дедім.
Dialogue: 0,0:20:54.26,0:20:55.77,1080,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:20:55.77,0:20:57.56,1080,,0000,0000,0000,,Өйткені менің бұған қатысым бар.
Dialogue: 0,0:20:59.53,0:21:01.09,1080,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:21:12.68,0:21:14.24,1080,,0000,0000,0000,,Сәлем Тайчи
Dialogue: 0,0:21:14.75,0:21:15.89,1080,,0000,0000,0000,,Бұл
Dialogue: 0,0:21:16.39,0:21:18.69,1080,,0000,0000,0000,,Сәлем,сәлем
Dialogue: 0,0:21:18.69,0:21:21.18,1080,,0000,0000,0000,,Неліктен қосыла алмаймын?
Dialogue: 0,0:21:21.18,0:21:24.05,1080,,0000,0000,0000,,Мама,бірдеңе өзгерді.
Dialogue: 0,0:21:30.12,0:21:32.28,1080,,0000,0000,0000,,Бұл не болып жатыр?
Dialogue: 0,0:21:41.45,0:21:43.45,1080,,0000,0000,0000,,Неліктен Кувагамон?
Dialogue: 0,0:21:46.47,0:21:49.85,1080,,0000,0000,0000,,Осы айдың соңына дейін ғана,сондықтан мен оны асыға күтемін.
Dialogue: 0,0:21:49.85,0:21:52.50,1080,,0000,0000,0000,,Жаңа ғана біз ерекше жаңалық алдық.
Dialogue: 0,0:21:52.50,0:21:56.25,1080,,0000,0000,0000,,Токиодағы Одайбаның үстіндегі аспанда белгісіз тіршілік иесі пайда болды
Dialogue: 0,0:21:56.83,0:22:01.07,1080,,0000,0000,0000,,Сондай-ақ Одайбаның айналасында ауқымды радио кедергілер орын алуда.
Dialogue: 0,0:22:01.07,0:22:05.52,1080,,0000,0000,0000,,Бағдаршамның дұрыс жұмыс істемеуіне және маршрут ақауларына байланысты қозғалыстың бұзылуы орын алуда.
Dialogue: 0,0:22:05.52,0:22:07.28,1080,,0000,0000,0000,,Мен бұған сене алмадым...
Dialogue: 0,0:22:07.71,0:22:09.05,1080,,0000,0000,0000,,Қалай болғанда да,бұл қаһармандарды өлтіру миссиясын соңына дейін жеткізетін мен боламын.
Dialogue: 0,0:22:11.82,0:22:14.82,1080,,0000,0000,0000,,Сәлем, эй,бүгін тікелей эфир.
Dialogue: 0,0:22:14.82,0:22:16.59,1080,,0000,0000,0000,,Ол жойылатын сияқты.
Dialogue: 0,0:22:17.53,0:22:21.09,1080,,0000,0000,0000,,Кешіріңіз. Кейінірек кездесеміз.
Dialogue: 0,0:22:21.09,0:22:22.99,1080,,0000,0000,0000,,Подруги?
Dialogue: 0,0:22:22.99,0:22:26.02,1080,,0000,0000,0000,,Егер бәрі жақсы болса,уайымдамаңыз
Dialogue: 0,0:22:26.02,0:22:28.12,1080,,0000,0000,0000,,Мен сені бәрінен де жақсы көремін,ағайын.
Dialogue: 0,0:22:28.12,0:22:30.65,1080,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:22:33.30,0:22:35.72,1080,,0000,0000,0000,,Тайчи қосыла алмайды
Dialogue: 0,0:22:35.72,0:22:37.41,1080,,0000,0000,0000,,Бұл ойын кезінде емес.
Dialogue: 0,0:22:37.41,0:22:38.89,1080,,0000,0000,0000,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:22:39.96,0:22:42.38,1080,,0000,0000,0000,,Білесіз бе,бұл бүгінгі тікелей эфир...
Dialogue: 0,0:23:16.81,0:23:19.99,1080,,0000,0000,0000,,Кешіріңіз,маған тағы бір оолонг шай беріңізші.
Dialogue: 0,0:23:27.81,0:23:29.83,1080,,0000,0000,0000,,Неге?
Dialogue: 0,0:23:30.28,0:23:31.68,1080,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:23:49.03,0:23:51.08,1080,,0000,0000,0000,,Бұл енді жақсы емес
Dialogue: 0,0:24:16.89,0:24:17.88,1080,,0000,0000,0000,,болды
Dialogue: 0,0:25:03.08,0:25:04.20,1080,,0000,0000,0000,,На
Dialogue: 0,0:25:49.42,0:25:50.99,1080,,0000,0000,0000,,Бір айдан кейін
Dialogue: 0,0:27:18.01,0:27:19.32,1080,,0000,0000,0000,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:27:23.78,0:27:25.23,1080,,0000,0000,0000,,Мен жалғызбын
Dialogue: 0,0:27:25.23,0:27:27.01,1080,,0000,0000,0000,,Бірақ мен ештеңе істей алмаймын.
Dialogue: 0,0:27:58.26,0:28:00.25,1080,,0000,0000,0000,,Тайчи
Dialogue: 0,0:28:01.28,0:28:04.93,1080,,0000,0000,0000,,Агумон Біраз уақыт өтті.
Dialogue: 0,0:28:04.93,0:28:07.73,1080,,0000,0000,0000,,Тайчи үлкен болды.
Dialogue: 0,0:28:07.73,0:28:10.31,1080,,0000,0000,0000,,Сіз кішірейіп бара жатырсыз.
Dialogue: 0,0:28:11.92,0:28:13.80,1080,,0000,0000,0000,,Тіпті олай емес.
Dialogue: 0,0:28:16.62,0:28:17.68,1080,,0000,0000,0000,,Агумон
Dialogue: 0,0:28:17.68,0:28:19.60,1080,,0000,0000,0000,,Мен ол жігіттің ашуын тоқтатамын.
Dialogue: 0,0:28:19.60,0:28:20.92,1080,,0000,0000,0000,,Түсіндім
Dialogue: 0,0:28:33.66,0:28:37.10,1080,,0000,0000,0000,,Агумон эволюциясы
Dialogue: 0,0:28:58.12,0:28:59.75,1080,,0000,0000,0000,,Греймон
Dialogue: 0,0:29:11.56,0:29:15.74,1080,,0000,0000,0000,,Тайчи Мен онымен соңғы кездескеннен де күштірек.
Dialogue: 0,0:29:15.74,0:29:16.96,1080,,0000,0000,0000,,Ұф… сен,кішкентай сорлы.
Dialogue: 0,0:29:16.96,0:29:18.30,1080,,0000,0000,0000,,Бәрібір тоқтаңыз
Dialogue: 0,0:29:18.30,0:29:20.19,1080,,0000,0000,0000,,Өтінемін,Греймон.
Dialogue: 0,0:29:37.96,0:29:39.42,1080,,0000,0000,0000,,Жоғалып кетті ме?
Dialogue: 0,0:30:13.20,0:30:15.20,1080,,0000,0000,0000,,Греймон
Dialogue: 0,0:30:17.60,0:30:19.44,1080,,0000,0000,0000,,Кираны қолдайтындардың бар екеніне таңғалмаймын.
Dialogue: 0,0:30:22.45,0:30:23.25,1080,,0000,0000,0000,,Хикари
Dialogue: 0,0:30:23.25,0:30:24.93,1080,,0000,0000,0000,,Үлкен аға,бұл қиын.
Dialogue: 0,0:30:24.93,0:30:28.45,1080,,0000,0000,0000,,Жаңалықтарда Дигимонның Ханеда әуежайында пайда болғаны айтылады.
Dialogue: 0,0:30:28.45,0:30:30.04,1080,,0000,0000,0000,,Ханеда?
Dialogue: 0,0:30:30.83,0:30:33.84,1080,,0000,0000,0000,,Ханедаға қалай жетуге болады?
Dialogue: 0,0:30:36.34,0:30:38.53,1080,,0000,0000,0000,,Дұрыс, Хикари,сен де...
Dialogue: 0,0:30:42.52,0:30:43.50,1080,,0000,0000,0000,,Дұрыс,қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:30:43.50,0:30:45.47,1080,,0000,0000,0000,,А, жоқ,бұл ештеңе емес.
Dialogue: 0,0:30:45.47,0:30:47.23,1080,,0000,0000,0000,,Көмегің үшін рахмет.
Dialogue: 0,0:30:47.23,0:30:48.93,1080,,0000,0000,0000,,Е,аға...
Dialogue: 0,0:30:49.67,0:30:51.04,1080,,0000,0000,0000,,Ягами
Dialogue: 0,0:30:53.87,0:30:55.69,1080,,0000,0000,0000,,Нишижима мырза
Dialogue: 0,0:30:55.69,0:30:56.91,1080,,0000,0000,0000,,Атпен жүру
Dialogue: 0,0:31:02.38,0:31:04.13,1080,,0000,0000,0000,,Бұл Хикари Ягами.
Dialogue: 0,0:31:42.05,0:31:44.00,1080,,0000,0000,0000,,Мұғалім деген не...
Dialogue: 0,0:32:19.72,0:32:22.60,1080,,0000,0000,0000,,А, рахмет,мұғалім.
Dialogue: 0,0:32:27.14,0:32:29.91,1080,,0000,0000,0000,,Код 01 Эскорт аяқталды
Dialogue: 0,0:32:32.30,0:32:35.26,1080,,0000,0000,0000,,Мен сендерге жалындым,таңдаулы балалар.
Dialogue: 0,0:32:36.91,0:32:38.28,1080,,0000,0000,0000,,Греймон
Dialogue: 0,0:33:03.70,0:33:04.82,1080,,0000,0000,0000,,Греймон
Dialogue: 0,0:33:04.82,0:33:06.17,1080,,0000,0000,0000,,Тайчи
Dialogue: 0,0:33:26.45,0:33:27.91,1080,,0000,0000,0000,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:33:28.98,0:33:30.76,1080,,0000,0000,0000,,Менің ойымша,бұл мағынасы жоқ.
Dialogue: 0,0:33:30.76,0:33:32.36,1080,,0000,0000,0000,,Біз де солай.
Dialogue: 0,0:33:32.36,0:33:34.51,1080,,0000,0000,0000,,кенеттен әкелді
Dialogue: 0,0:33:34.51,0:33:36.57,1080,,0000,0000,0000,,Біз де жаңа ғана келдік.
Dialogue: 0,0:33:36.57,0:33:37.93,1080,,0000,0000,0000,,Патамон және басқалары да?
Dialogue: 0,0:33:37.93,0:33:39.94,1080,,0000,0000,0000,,Мен мұны білмей тұрып,осында болдым.
Dialogue: 0,0:33:39.94,0:33:42.34,1080,,0000,0000,0000,,Үлкен аға,бәрібір.
Dialogue: 0,0:33:42.34,0:33:44.52,1080,,0000,0000,0000,,Біз де ынтымақтасайық
Dialogue: 0,0:33:44.52,0:33:47.09,1080,,0000,0000,0000,,Алдымен ол туралы бірдеңе істеуіміз керек.
Dialogue: 0,0:33:47.09,0:33:49.75,1080,,0000,0000,0000,,Жарайды,кеттік.
Dialogue: 0,0:33:49.75,0:33:53.37,1080,,0000,0000,0000,,Сәл күте тұрыңыз, эй,Мими.
Dialogue: 0,0:33:53.37,0:33:55.17,1080,,0000,0000,0000,,Ұзындығы жоқ.
Dialogue: 0,0:33:56.92,0:34:00.51,1080,,0000,0000,0000,,Неліктен Тайчи-сан енді көрінбейді?
Dialogue: 0,0:34:01.10,0:34:03.93,1080,,0000,0000,0000,,Қайтып келуге қиналсам да
Dialogue: 0,0:34:06.21,0:34:07.55,1080,,0000,0000,0000,,Ханеда?
Dialogue: 0,0:34:14.36,0:34:16.53,1080,,0000,0000,0000,,Өйткені,бұл жерде қосылмайды.
Dialogue: 0,0:34:17.25,0:34:20.28,1080,,0000,0000,0000,,Мими,сен қайдасың?
Dialogue: 0,0:34:21.61,0:34:22.82,1080,,0000,0000,0000,,Греймон
Dialogue: 0,0:34:29.47,0:34:31.93,1080,,0000,0000,0000,,Бұл өтірік болуы керек. Олардың үшеуі бар.
Dialogue: 0,0:34:37.47,0:34:38.21,1080,,0000,0000,0000,,Агумон
Dialogue: 0,0:34:38.21,0:34:39.36,1080,,0000,0000,0000,,Тайчи
Dialogue: 0,0:34:39.36,0:34:41.57,1080,,0000,0000,0000,,Шит Габумон
Dialogue: 0,0:34:54.74,0:34:57.48,1080,,0000,0000,0000,,Габумон эволюциясы
Dialogue: 0,0:35:17.90,0:35:19.57,1080,,0000,0000,0000,,Гарурумон
Dialogue: 0,0:35:22.34,0:35:24.82,1080,,0000,0000,0000,,Агумон,жақсысың ба?
Dialogue: 0,0:35:36.81,0:35:38.63,1080,,0000,0000,0000,,нашар дисперсті
Dialogue: 0,0:35:38.63,0:35:40.48,1080,,0000,0000,0000,,Біз де қоштасайық.
Dialogue: 0,0:35:42.18,0:35:45.11,1080,,0000,0000,0000,,Бұл өте жақын қоңырау болды.
Dialogue: 0,0:35:53.27,0:35:55.56,1080,,0000,0000,0000,,Жоқ,мен қашып кете аламын.
Dialogue: 0,0:35:55.56,0:35:57.51,1080,,0000,0000,0000,,Биомон,кеттік.
Dialogue: 0,0:36:09.85,0:36:12.48,1080,,0000,0000,0000,,Биомон эволюциясы
Dialogue: 0,0:36:33.72,0:36:35.53,1080,,0000,0000,0000,,Бердрамон
Dialogue: 0,0:36:40.38,0:36:41.27,1080,,0000,0000,0000,,Жақсы
Dialogue: 0,0:36:41.27,0:36:42.67,1080,,0000,0000,0000,,Біз де барайық
Dialogue: 0,0:36:42.67,0:36:44.48,1080,,0000,0000,0000,,Менің кезегім.
Dialogue: 0,0:36:56.56,0:36:59.11,1080,,0000,0000,0000,,Тентомон эволюциясы
Dialogue: 0,0:37:20.14,0:37:22.06,1080,,0000,0000,0000,,Кабутеримон
Dialogue: 0,0:37:32.58,0:37:33.74,1080,,0000,0000,0000,,«Біз оның әйелі мен балаларын қауіпсіз жерге жеткіздік»
Dialogue: 0,0:37:33.74,0:37:34.96,1080,,0000,0000,0000,,Мен осы жерден тоқтауым керек.
Dialogue: 0,0:37:34.96,0:37:36.30,1080,,0000,0000,0000,,Жарайсың Такеру
Dialogue: 0,0:37:36.30,0:37:37.88,1080,,0000,0000,0000,,Оны маған қалдырыңыз Хикари
Dialogue: 0,0:37:50.98,0:37:53.60,1080,,0000,0000,0000,,Бадамон эволюциясы
Dialogue: 0,0:38:15.61,0:38:16.97,1080,,0000,0000,0000,,Анжемон
Dialogue: 0,0:38:32.98,0:38:35.45,1080,,0000,0000,0000,,Мими,тез кел.
Dialogue: 0,0:38:35.45,0:38:37.45,1080,,0000,0000,0000,,Жалғыз дами алмайды
Dialogue: 0,0:38:37.45,0:38:39.85,1080,,0000,0000,0000,,Мен Джоны алып кетейін.
Dialogue: 0,0:38:39.85,0:38:44.72,1080,,0000,0000,0000,,Қазіргі уақытта Ханеда әуежайында жолаушылар мен экипажды эвакуациялау басталды.
Dialogue: 0,0:38:44.72,0:38:46.66,1080,,0000,0000,0000,,Өйткені,бұл...
Dialogue: 0,0:38:48.96,0:38:51.47,1080,,0000,0000,0000,,Ум,мен оны көрмеймін.
Dialogue: 0,0:38:51.47,0:38:55.53,1080,,0000,0000,0000,,Ханеда жаңалықтары Мұны көрудің қажеті жоқ.
Dialogue: 0,0:38:55.90,0:38:57.73,1080,,0000,0000,0000,,Мен қазір кетемін.
Dialogue: 0,0:38:59.29,0:39:03.62,1080,,0000,0000,0000,,Қош келдіңіз,Мими Тачикава
Dialogue: 0,0:39:41.65,0:39:44.11,1080,,0000,0000,0000,,О,мен жасадым.
Dialogue: 0,0:39:44.11,0:39:46.03,1080,,0000,0000,0000,,Нене,бәрі сонда.
Dialogue: 0,0:39:46.03,0:39:49.57,1080,,0000,0000,0000,,Неше адам бар? Барлық пальмондар да сонда ма?
Dialogue: 0,0:39:50.52,0:39:53.35,1080,,0000,0000,0000,,Өйткені мен барлығына кәдесыйлар таратуым керек.
Dialogue: 0,0:39:53.90,0:39:55.63,1080,,0000,0000,0000,,Бұл дұрыс болды
Dialogue: 0,0:39:55.63,0:39:59.24,1080,,0000,0000,0000,,Пальмонға және басқаларға қалай беремін деп уайымдадым.
Dialogue: 0,0:40:18.96,0:40:20.33,1080,,0000,0000,0000,,Жоғалып кетті ме?
Dialogue: 0,0:40:20.33,0:40:21.91,1080,,0000,0000,0000,,Қалған соң
Dialogue: 0,0:40:49.32,0:40:50.97,1080,,0000,0000,0000,,Гарурумон оянады
Dialogue: 0,0:41:06.81,0:41:08.67,1080,,0000,0000,0000,,Автоматты бақылаудың кемшілігі – ол әрқашан менің бұйрықтарымды дәл орындай бермейді
Dialogue: 0,0:41:08.67,0:41:10.02,1080,,0000,0000,0000,,Тұр,мен өзі қандай ұлтпын? Хехехе
Dialogue: 0,0:41:19.70,0:41:21.44,1080,,0000,0000,0000,,Енді бітті
Dialogue: 0,0:41:22.01,0:41:24.14,1080,,0000,0000,0000,,Мен оны жеңе алғаныма қуаныштымын.
Dialogue: 0,0:41:24.14,0:41:26.33,1080,,0000,0000,0000,,Иә,бірақ...
Dialogue: 0,0:41:29.30,0:41:31.71,1080,,0000,0000,0000,,Зақым да келтірілген.
Dialogue: 0,0:41:55.70,0:41:58.12,1080,,0000,0000,0000,,Бұл адамдар кімдер?
Dialogue: 0,0:41:58.12,0:42:02.09,1080,,0000,0000,0000,,Бізді осында әкелген адам және кейінгі өңдеу тым шебер болды.
Dialogue: 0,0:42:02.09,0:42:04.50,1080,,0000,0000,0000,,Мен олардан сұрасам да,олар ештеңеге жауап бермеді.
Dialogue: 0,0:42:04.50,0:42:09.45,1080,,0000,0000,0000,,Тым көп нәрсе кенеттен болып жатыр,мен оларды енді түсіне алмаймын.
Dialogue: 0,0:42:09.45,0:42:12.34,1080,,0000,0000,0000,,Ақпараттың жоқтығы.
Dialogue: 0,0:42:12.34,0:42:16.45,1080,,0000,0000,0000,,Ойлап қарасам,мені осында әкелген Нишижима-сенсэй болды.
Dialogue: 0,0:42:16.45,0:42:18.81,1080,,0000,0000,0000,,Менің мектебімде ме?
Dialogue: 0,0:42:18.81,0:42:20.48,1080,,0000,0000,0000,,Ол туысқан адам болды ма?
Dialogue: 0,0:42:21.10,0:42:24.48,1080,,0000,0000,0000,,Сонда біз одан көп нәрсені үйренуіміз мүмкін.
Dialogue: 0,0:42:31.16,0:42:33.41,1080,,0000,0000,0000,,Пальмон
Dialogue: 0,0:42:33.41,0:42:35.25,1080,,0000,0000,0000,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:42:35.25,0:42:36.82,1080,,0000,0000,0000,,Мими
Dialogue: 0,0:42:37.74,0:42:40.66,1080,,0000,0000,0000,,Көп болды,қуанып қалдым
Dialogue: 0,0:42:40.66,0:42:42.19,1080,,0000,0000,0000,,Мими-сан Мими-чан
Dialogue: 0,0:42:42.19,0:42:44.14,1080,,0000,0000,0000,,Біраз уақыт болды
Dialogue: 0,0:42:44.14,0:42:45.97,1080,,0000,0000,0000,,Қайтып келдің бе?
Dialogue: 0,0:42:45.97,0:42:48.68,1080,,0000,0000,0000,,Мүмкін осы шайқас үшін?
Dialogue: 0,0:42:48.68,0:42:51.53,1080,,0000,0000,0000,,Жоқ Жоқ Шынымен емес.
Dialogue: 0,0:42:51.53,0:42:54.60,1080,,0000,0000,0000,,Мен бастапқыда қайтып оралуды жоспарлағанмын.
Dialogue: 0,0:42:55.01,0:42:58.07,1080,,0000,0000,0000,,Мен Тайчи-санда сіріңке бар деп жаңа ғана естідім.
Dialogue: 0,0:42:58.07,0:43:01.61,1080,,0000,0000,0000,,Иә,бұл кәдесый.
Dialogue: 0,0:43:01.61,0:43:04.19,1080,,0000,0000,0000,,Бұл менің соңғы уақытта құмар болған сағыздар.
Dialogue: 0,0:43:04.19,0:43:07.86,1080,,0000,0000,0000,,Мимидің ұсынысы улы және тәуелді.
Dialogue: 0,0:43:07.86,0:43:09.44,1080,,0000,0000,0000,,Өтінемін,Агумон.
Dialogue: 0,0:43:09.44,0:43:12.20,1080,,0000,0000,0000,,Егер сіз мұны жесеңіз,өзіңізді жақсы сезінесіз.
Dialogue: 0,0:43:15.35,0:43:16.66,1080,,0000,0000,0000,,Дәмді
Dialogue: 0,0:43:16.66,0:43:18.24,1080,,0000,0000,0000,,Жақсы,жақсы
Dialogue: 0,0:43:18.24,0:43:19.72,1080,,0000,0000,0000,,Алғыс айту
Dialogue: 0,0:43:19.72,0:43:21.34,1080,,0000,0000,0000,,Ет же
Dialogue: 0,0:43:21.34,0:43:22.56,1080,,0000,0000,0000,,Өйткені олар өте көп
Dialogue: 0,0:43:22.56,0:43:24.36,1080,,0000,0000,0000,,жеу
Dialogue: 0,0:43:24.36,0:43:26.96,1080,,0000,0000,0000,,Мен де жеймін
Dialogue: 0,0:43:28.06,0:43:30.80,1080,,0000,0000,0000,,Бізде барлығына арналған бар,сондықтан оларды үйге апарыңыз.
Dialogue: 0,0:43:30.80,0:43:32.21,1080,,0000,0000,0000,,Рахмет
Dialogue: 0,0:43:32.21,0:43:35.20,1080,,0000,0000,0000,,Бірақ үйге қалай жетеміз?
Dialogue: 0,0:43:35.86,0:43:38.82,1080,,0000,0000,0000,,Мені жіберген адамнан сұрайық
Dialogue: 0,0:43:44.76,0:43:47.56,1080,,0000,0000,0000,,Ол кім?
Dialogue: 0,0:43:47.56,0:43:49.24,1080,,0000,0000,0000,,Аздап қорқынышты сезіну
Dialogue: 0,0:43:49.24,0:43:52.44,1080,,0000,0000,0000,,Бірақ үйге аман-есен жеткеніңізге қуаныштымын.
Dialogue: 0,0:43:52.44,0:43:55.12,1080,,0000,0000,0000,,Бұл Джо-сенпай мен Гомамон.
Dialogue: 0,0:43:55.12,0:43:57.60,1080,,0000,0000,0000,,Мен мұны түсінбеймін.
Dialogue: 0,0:43:57.60,0:44:00.32,1080,,0000,0000,0000,,Менің келуім мүмкін болмаған жағдайлар болды.
Dialogue: 0,0:44:00.32,0:44:03.06,1080,,0000,0000,0000,,Дұрыс,сен тест тапсырушысың.
Dialogue: 0,0:44:03.06,0:44:05.36,1080,,0000,0000,0000,,Сіз тест тапсырушысыз ба?
Dialogue: 0,0:44:08.38,0:44:10.60,1080,,0000,0000,0000,,Не болды,Коуширо-кун?
Dialogue: 0,0:44:10.60,0:44:12.64,1080,,0000,0000,0000,,Иебетсу
Dialogue: 0,0:44:13.02,0:44:16.78,1080,,0000,0000,0000,,Аа, мен сүйкімді болып бара жатырмын,ал сен қобалжыдың ба?
Dialogue: 0,0:44:16.78,0:44:19.14,1080,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:44:19.14,0:44:21.74,1080,,0000,0000,0000,,Өтірік өтірік
Dialogue: 0,0:44:22.51,0:44:26.00,1080,,0000,0000,0000,,Сіз Тайчидің футбол ойынына оралдыңыз,солай ма?
Dialogue: 0,0:44:26.00,0:44:29.24,1080,,0000,0000,0000,,Бұл дұрыс Әуе билеті
Dialogue: 0,0:44:29.80,0:44:31.56,1080,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:44:31.56,0:44:37.00,1080,,0000,0000,0000,,Әкемнің жұмысына байланысты біраз уақыт Жапонияда тұруға тура келді.
Dialogue: 0,0:44:37.00,0:44:39.30,1080,,0000,0000,0000,,Барлығына тағы да рахмет.
Dialogue: 0,0:45:08.86,0:45:10.50,1080,,0000,0000,0000,,Гомамон
Dialogue: 0,0:45:12.91,0:45:14.51,1080,,0000,0000,0000,,Бұл жерде
Dialogue: 0,0:45:24.18,0:45:27.34,1080,,0000,0000,0000,,Кеше пайда болған белгісіз тіршілік формасы
Dialogue: 0,0:45:27.34,0:45:30.98,1080,,0000,0000,0000,,Одайба аймағы мен Ханеда әуежайына айтарлықтай зиян келтірілді.
Dialogue: 0,0:45:31.30,0:45:34.66,1080,,0000,0000,0000,,Керемет түрде ауыр жарақаттар расталмады
Dialogue: 0,0:45:34.66,0:45:39.88,1080,,0000,0000,0000,,Ханеда әуежайындағы барлық рейстерді тоқтатуға негізделген тасымалдауға әсері ауыр болды.
Dialogue: 0,0:45:39.88,0:45:42.74,1080,,0000,0000,0000,,Шұғыл әрекет қажет
Dialogue: 0,0:45:43.23,0:45:46.51,1080,,0000,0000,0000,,Бұл тіршілік формасы бұрын бірнеше рет пайда болған.
Dialogue: 0,0:45:46.51,0:45:49.44,1080,,0000,0000,0000,,Зақым келтірген сайын
Dialogue: 0,0:45:50.04,0:45:55.18,1080,,0000,0000,0000,,Бұл жолы бірден бірнешеу пайда болды,зиян одан да көп болды.
Dialogue: 0,0:45:55.18,0:45:59.35,1080,,0000,0000,0000,,Қауіп-қатер мен деструктивті күш тағы да қалыптасты.
Dialogue: 0,0:45:59.35,0:46:01.53,1080,,0000,0000,0000,,Бұл қала тұрғындарының реакциясы.
Dialogue: 0,0:46:01.53,0:46:05.26,1080,,0000,0000,0000,,Қайта шыға ма деп уайымдаймын.
Dialogue: 0,0:46:08.28,0:46:13.24,1080,,0000,0000,0000,,Енді тіпті Агумонға да,басқаларына да Кувагамон сияқты қарайды.
Dialogue: 0,0:46:14.72,0:46:18.42,1080,,0000,0000,0000,,Біз Кувагаомонға қарсы соғыстық.
Dialogue: 0,0:46:18.42,0:46:22.70,1080,,0000,0000,0000,,Мен баламның қорқып,қайта шықпағанын қаламаймын.
Dialogue: 0,0:46:23.40,0:46:26.22,1080,,0000,0000,0000,,Үкімет бүгін таңертең үкіметтің кезектен тыс отырысын өткізеді.
Dialogue: 0,0:46:26.22,0:46:31.02,1080,,0000,0000,0000,,Біз болашақ жауаптарды талқылау үшін полиция және өзін-өзі қорғау күштерімен жұмыс істейміз.
Dialogue: 0,0:46:31.02,0:46:36.58,1080,,0000,0000,0000,,О,Агу-чан мен Теру-чанның қорқынышты ештеңесі жоқ.
Dialogue: 0,0:46:36.58,0:46:37.84,1080,,0000,0000,0000,,Қорықпаңыздар,біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:46:37.84,0:46:40.00,1080,,0000,0000,0000,,Барлығы түсінбейді,солай ма?
Dialogue: 0,0:46:40.00,0:46:41.51,1080,,0000,0000,0000,,Қорықпаңыздар,біз екі зерттеу кемесімен келе жатырмыз."
Dialogue: 0,0:46:41.02,0:46:42.84,1080,,0000,0000,0000,,Келесі ауа райы
Dialogue: 0,0:46:42.84,0:46:46.02,1080,,0000,0000,0000,,Жаңбырлы маусым жақында аяқталады деп күтілуде.
Dialogue: 0,0:46:51.52,0:46:53.08,1080,,0000,0000,0000,,Ямато
Dialogue: 0,0:46:53.52,0:46:56.12,1080,,0000,0000,0000,,Жаңалықты көрдіңіз бе?
Dialogue: 0,0:47:01.22,0:47:04.38,1080,,0000,0000,0000,,Шамасы,Танака-кунның әкесі Ханеда болған.
Dialogue: 0,0:47:04.38,0:47:06.02,1080,,0000,0000,0000,,Өтірік айту
Dialogue: 0,0:47:06.02,0:47:08.24,1080,,0000,0000,0000,,Ол жарақат алып,ауруханаға жатқызылды.
Dialogue: 0,0:47:08.24,0:47:09.84,1080,,0000,0000,0000,,Тайчи,кеттік
Dialogue: 0,0:47:19.10,0:47:21.68,1080,,0000,0000,0000,,Нишижима мырза бұл жерде жоқ.
Dialogue: 0,0:47:21.68,0:47:23.96,1080,,0000,0000,0000,,Менің сізден сұрайын дегенім көп.
Dialogue: 0,0:47:23.96,0:47:26.02,1080,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:47:26.72,0:47:27.78,1080,,0000,0000,0000,,Мими-сан
Dialogue: 0,0:47:27.78,0:47:29.42,1080,,0000,0000,0000,,Сен мұнда не үшін келдің?
Dialogue: 0,0:47:29.42,0:47:32.45,1080,,0000,0000,0000,,Мен мұны айтпадым ба?
Dialogue: 0,0:47:32.45,0:47:35.79,1080,,0000,0000,0000,,Мен бүгіннен бастап мұнда бірінші курс студентімін.
Dialogue: 0,0:47:35.79,0:47:38.53,1080,,0000,0000,0000,,Ол Коуширо-кунмен бір сыныпта оқиды.
Dialogue: 0,0:47:46.08,0:47:47.49,1080,,0000,0000,0000,,Достар?
Dialogue: 0,0:47:47.49,0:47:50.50,1080,,0000,0000,0000,,Иә, иә,ол да ауысатын студент.
Dialogue: 0,0:47:50.50,0:47:53.08,1080,,0000,0000,0000,,Мен екінші курс студенті болғандықтан,мен де Сораның сыныбындамын.
Dialogue: 0,0:47:53.08,0:47:55.38,1080,,0000,0000,0000,,Алдымен саусақтарыңды найза пішініне келтір.
Dialogue: 0,0:47:56.99,0:48:00.97,1080,,0000,0000,0000,,Коуширо-кун,мені сыныпқа апара аласыз ба?
Dialogue: 0,0:48:01.36,0:48:03.12,1080,,0000,0000,0000,,Иә,әрине
Dialogue: 0,0:48:03.12,0:48:04.66,1080,,0000,0000,0000,,Олай болса,Мими Чан
Dialogue: 0,0:48:04.66,0:48:05.88,1080,,0000,0000,0000,,Біз бұны Ятоға да қолдана аламыз—
Dialogue: 0,0:48:07.50,0:48:09.85,1080,,0000,0000,0000,,Енді ойлап қарасам,ұят болды.
Dialogue: 0,0:48:09.85,0:48:12.64,1080,,0000,0000,0000,,Тайчи матчы мен Яматоның тікелей шоуы кейінге қалдырылды
Dialogue: 0,0:48:12.64,0:48:15.04,1080,,0000,0000,0000,,Сіз тынышталғаннан кейін.
Dialogue: 0,0:48:15.04,0:48:16.70,1080,,0000,0000,0000,,Мүмкін,эй.
Dialogue: 0,0:48:20.94,0:48:23.80,1080,,0000,0000,0000,,Сондай-ақ... Мешин Мочизуки
Dialogue: 0,0:48:24.68,0:48:27.46,1080,,0000,0000,0000,,Мен Тотториден ауыстым.
Dialogue: 0,0:48:27.46,0:48:30.48,1080,,0000,0000,0000,,Шынайы кімдігі: барлаушы
Dialogue: 0,0:48:42.02,0:48:44.70,1080,,0000,0000,0000,,Олай болса сабақты бастайық.
Dialogue: 0,0:48:45.82,0:48:50.76,1080,,0000,0000,0000,,Өйткені,бұл анықталмаған тіршілік формалары қандай?
Dialogue: 0,0:48:50.76,0:48:54.89,1080,,0000,0000,0000,,Білмеймін, екі құбыжық шығып,жабайы кеткен шығар.
Dialogue: 0,0:48:54.89,0:48:56.84,1080,,0000,0000,0000,,Бұл шынымен тітіркендіргіш.
Dialogue: 0,0:48:56.84,0:48:59.38,1080,,0000,0000,0000,,Олардың барлығы жақын арада өледі деп үміттенемін.
Dialogue: 0,0:48:59.38,0:49:01.06,1080,,0000,0000,0000,,Тоқта
Dialogue: 0,0:49:01.06,0:49:02.74,1080,,0000,0000,0000,,Тайчи
Dialogue: 0,0:49:03.52,0:49:06.30,1080,,0000,0000,0000,,Нашар Бұл ештеңе емес.
Dialogue: 0,0:49:08.28,0:49:11.46,1080,,0000,0000,0000,,Айналсақ та,қолымыздан ештеңе келмейді.
Dialogue: 0,0:49:11.46,0:49:12.88,1080,,0000,0000,0000,,Қорқып қалмаңдар
Dialogue: 0,0:49:12.88,0:49:14.54,1080,,0000,0000,0000,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,0:49:18.20,0:49:21.22,1080,,0000,0000,0000,,Атап айтқанда,ештеңе жоқ
Dialogue: 0,0:49:21.22,0:49:22.70,1080,,0000,0000,0000,,Бүгінгі таңғы жаңалықтар туралы
Dialogue: 0,0:49:23.13,0:49:24.37,1080,,0000,0000,0000,,Дұрыс?
Dialogue: 0,0:49:27.28,0:49:29.78,1080,,0000,0000,0000,,Бұдан кейін жиналмаймыз.
Dialogue: 0,0:49:42.34,0:49:44.77,1080,,0000,0000,0000,,Мен келдім,Жо-сенпай.
Dialogue: 0,0:49:44.77,0:49:46.92,1080,,0000,0000,0000,,Кешіріңіз,кешігіп қалдым
Dialogue: 0,0:49:47.28,0:49:49.18,1080,,0000,0000,0000,,Көптен бері көрмеген
Dialogue: 0,0:49:49.80,0:49:53.68,1080,,0000,0000,0000,,Бұл кәдесый. Сізді көргеніме қуаныштымын.
Dialogue: 0,0:49:53.68,0:49:56.50,1080,,0000,0000,0000,,Әдеттегідей,Мими-кун.
Dialogue: 0,0:49:56.50,0:50:00.14,1080,,0000,0000,0000,,Кешіріңіз, мен түсу емтиханына оқуым керек еді,бірақ келуіңізді сұрауым керек еді.
Dialogue: 0,0:50:00.14,0:50:04.50,1080,,0000,0000,0000,,Жоқ, жарайды,мен де сөйлескім келді.
Dialogue: 0,0:50:06.12,0:50:09.43,1080,,0000,0000,0000,,Алдымен қазіргі жағдайды ұйымдастырайық.
Dialogue: 0,0:50:09.43,0:50:12.94,1080,,0000,0000,0000,,Біз жақында болған алты оқиғаны қорытындылаймыз.
Dialogue: 0,0:50:12.94,0:50:16.56,1080,,0000,0000,0000,,1 Жақында,кем дегенде өткен жылы
Dialogue: 0,0:50:16.56,0:50:19.98,1080,,0000,0000,0000,,Сандық әлемге апаратын қақпа жарамсыз болып қалды.
Dialogue: 0,0:50:19.98,0:50:24.14,1080,,0000,0000,0000,,Менің ойымша,Digivice қандай да бір себептермен дұрыс жұмыс істемеді.
Dialogue: 0,0:50:24.14,0:50:25.68,1080,,0000,0000,0000,,Бұл екінші.
Dialogue: 0,0:50:25.68,0:50:30.40,1080,,0000,0000,0000,,3 Жергілікті радио кедергілер негізінен Одайбада болады
Dialogue: 0,0:50:30.40,0:50:33.52,1080,,0000,0000,0000,,Осыдан кейін бірден электр қуатының түсініксіз үзілуі орын алды.
Dialogue: 0,0:50:33.92,0:50:34.93,1080,,0000,0000,0000,,Төртіншіден
Dialogue: 0,0:50:34.93,0:50:36.68,1080,,0000,0000,0000,,Радио кедергілерге байланысты
Dialogue: 0,0:50:36.68,0:50:39.89,1080,,0000,0000,0000,,Сымсыз желіде маңызды ақаулық орын алса.
Dialogue: 0,0:50:39.89,0:50:46.07,1080,,0000,0000,0000,,Ұялы телефондар, сымсыз телефондар,теледидарлық хабарлар және т.б. қабылдау ақаулары болды.
Dialogue: 0,0:50:46.07,0:50:49.96,1080,,0000,0000,0000,,5. Түсініксіз кеңістіктік бұрмалану орын алады.
Dialogue: 0,0:50:49.96,0:50:53.92,1080,,0000,0000,0000,,Ол сандық әлемге қақпадан өзгеше түрде қосылған.
Dialogue: 0,0:50:53.92,0:50:56.68,1080,,0000,0000,0000,,Дигимон бұл дүниеге арғы жақтан келді.
Dialogue: 0,0:50:56.68,0:50:58.46,1080,,0000,0000,0000,,Кешегі Кувагамон да
Dialogue: 0,0:50:58.46,0:51:01.63,1080,,0000,0000,0000,,6 Бұрмалау арқылы шыққан Дигимон
Dialogue: 0,0:51:01.63,0:51:04.26,1080,,0000,0000,0000,,Бұл біз бұрын көрген нәрселерден өзгеше.
Dialogue: 0,0:51:04.26,0:51:06.98,1080,,0000,0000,0000,,Түсініксіз мутация орын алды
Dialogue: 0,0:51:06.98,0:51:08.46,1080,,0000,0000,0000,,Бұл оқиғалар
Dialogue: 0,0:51:08.46,0:51:12.23,1080,,0000,0000,0000,,Мұның бәрі бұрмалау әсерінен болған шығар.
Dialogue: 0,0:51:12.23,0:51:13.81,1080,,0000,0000,0000,,Бұрмалау
Dialogue: 0,0:51:13.81,0:51:18.30,1080,,0000,0000,0000,,1 және 2 себептері олар пайда болған уақытта белгісіз болды.
Dialogue: 0,0:51:18.30,0:51:21.51,1080,,0000,0000,0000,,Енді, әрине,дәл сол себеп
Dialogue: 0,0:51:21.51,0:51:23.60,1080,,0000,0000,0000,,Радио кедергілердің үшінші себебі
Dialogue: 0,0:51:23.60,0:51:27.75,1080,,0000,0000,0000,,Бұл тексеру оның негізінен бұрмалау екенін көрсетті.
Dialogue: 0,0:51:27.75,0:51:29.55,1080,,0000,0000,0000,,Бұрмалаудың себебі
Dialogue: 0,0:51:29.55,0:51:33.36,1080,,0000,0000,0000,,Бұл сандық әлем мен біздің әлем қосылған кезде пайда болды.
Dialogue: 0,0:51:33.36,0:51:39.00,1080,,0000,0000,0000,,Атап айтқанда,«Цифрлық әлем» тарапы бұл желіге күштеп араласып жатқан сияқты.
Dialogue: 0,0:51:35.06,0:51:38.08,1080,,0000,0000,0000,,Онии-чан,мен мұғаліммен сөйлестім.
Dialogue: 0,0:51:38.08,0:51:40.98,1080,,0000,0000,0000,,Жоқ, Нишижима мырза,мен мұны істеген жоқпын.
Dialogue: 0,0:51:39.42,0:51:42.60,1080,,0000,0000,0000,,Нәтижесінде радиокедергілер мен электр қуаты үзілуде.
Dialogue: 0,0:51:40.98,0:51:43.24,1080,,0000,0000,0000,,Жаңалықты барлығы көрді.
Dialogue: 0,0:51:43.24,0:51:48.34,1080,,0000,0000,0000,,Нақты айта алмасақ та,электр қуатының үзілуіне Digimon себеп болуы мүмкін.
Dialogue: 0,0:51:46.36,0:51:49.14,1080,,0000,0000,0000,,Бұл қорқынышты,солай емес пе?
Dialogue: 0,0:51:48.38,0:51:52.64,1080,,0000,0000,0000,,Олай болса,электр қуатының үзілу себебі...
Dialogue: 0,0:51:49.14,0:51:51.42,1080,,0000,0000,0000,,Тіпті Патамон және басқалары аянышты.
Dialogue: 0,0:51:51.42,0:51:55.00,1080,,0000,0000,0000,,Әкеме айтып,БАҚ өкілдеріне наразылық білдіруді ойлап отырмын.
Dialogue: 0,0:51:52.64,0:51:55.00,1080,,0000,0000,0000,,Бірақ егер солай болса...
Dialogue: 0,0:51:55.00,0:51:57.37,1080,,0000,0000,0000,,Бұқаралық ақпарат құралдары арандатушы өрнектерді көбірек қолдануы керек.
Dialogue: 0,0:51:57.37,0:51:59.94,1080,,0000,0000,0000,,Тек жұртшылықтың назарын аударуға тырысу.
Dialogue: 0,0:51:59.94,0:52:02.88,1080,,0000,0000,0000,,Бірақ кейбір фактілер де бар.
Dialogue: 0,0:52:03.64,0:52:05.01,1080,,0000,0000,0000,,Әрине
Dialogue: 0,0:52:05.01,0:52:06.82,1080,,0000,0000,0000,,Әуежай және Одайба қаласы
Dialogue: 0,0:52:06.82,0:52:09.81,1080,,0000,0000,0000,,Кувагамон шығып,бәрі бүлінді.
Dialogue: 0,0:52:11.51,0:52:12.89,1080,,0000,0000,0000,,Мен де
Dialogue: 0,0:52:12.89,0:52:14.46,1080,,0000,0000,0000,,Мен мұны көргенде...
Dialogue: 0,0:52:14.46,0:52:16.51,1080,,0000,0000,0000,,Агумон мен басқалары төбелеспесе
Dialogue: 0,0:52:16.51,0:52:19.00,1080,,0000,0000,0000,,Бұдан да жаман болуы мүмкін еді.
Dialogue: 0,0:52:19.00,0:52:20.42,1080,,0000,0000,0000,,Иә.
Dialogue: 0,0:52:21.08,0:52:24.53,1080,,0000,0000,0000,,Габумон мен бізді сынау қисынсыз болар еді.
Dialogue: 0,0:52:24.53,0:52:26.17,1080,,0000,0000,0000,,Мен түсінбеймін.
Dialogue: 0,0:52:28.16,0:52:31.84,1080,,0000,0000,0000,,Бұл не, Тайчи,не айтқың келеді?
Dialogue: 0,0:52:33.80,0:52:36.14,1080,,0000,0000,0000,,Сіз жоғалмайсыз
Dialogue: 0,0:52:36.14,0:52:37.67,1080,,0000,0000,0000,,Коуширо айтқандай
Dialogue: 0,0:52:37.67,0:52:40.74,1080,,0000,0000,0000,,Менің көз алдымда сұмдық бірдеңе бола бастады.
Dialogue: 0,0:52:40.74,0:52:43.61,1080,,0000,0000,0000,,Тек біз жасай алатын нәрселер бар.
Dialogue: 0,0:52:43.61,0:52:44.59,1080,,0000,0000,0000,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:52:44.59,0:52:46.20,1080,,0000,0000,0000,,Бірақ не?
Dialogue: 0,0:52:46.20,0:52:48.25,1080,,0000,0000,0000,,Тайчи ұмытты ма?
Dialogue: 0,0:52:48.25,0:52:50.11,1080,,0000,0000,0000,,Цифрлық әлемдегі заттар
Dialogue: 0,0:52:50.11,0:52:52.78,1080,,0000,0000,0000,,Әлемді құтқару үшін Габумонмен және басқалармен күресу
Dialogue: 0,0:52:52.78,0:52:54.47,1080,,0000,0000,0000,,Мен ұмытуға мүмкіндік жоқ
Dialogue: 0,0:52:58.64,0:53:00.30,1080,,0000,0000,0000,,Егер...
Dialogue: 0,0:53:03.30,0:53:04.40,1080,,0000,0000,0000,,Тайчи
Dialogue: 0,0:53:04.40,0:53:07.06,1080,,0000,0000,0000,,Ямато,сабыр ет.
Dialogue: 0,0:53:07.92,0:53:12.48,1080,,0000,0000,0000,,Тайчи,сен сондайсың.
Dialogue: 0,0:53:12.48,0:53:14.22,1080,,0000,0000,0000,,Қандай жағымсыз иіс! Тамағымның арты ұстап,ауырып барады.
Dialogue: 0,0:53:14.88,0:53:18.14,1080,,0000,0000,0000,,Бірге жиналып,әңгімелесудің пайдасы жоқ сияқты.
Dialogue: 0,0:53:19.52,0:53:21.63,1080,,0000,0000,0000,,Сәлем Ямато
Dialogue: 0,0:53:26.04,0:53:27.26,1080,,0000,0000,0000,,Тайчи
Dialogue: 0,0:53:27.80,0:53:30.40,1080,,0000,0000,0000,,Өкінішті,мен де үйге барамын.
Dialogue: 0,0:53:33.42,0:53:37.82,1080,,0000,0000,0000,,Ештеңе етпейді,кейін ағаңның артынан барамын.
Dialogue: 0,0:53:38.43,0:53:39.48,1080,,0000,0000,0000,,Мен де
Dialogue: 0,0:53:39.48,0:53:41.94,1080,,0000,0000,0000,,Олай болса,біз де тараймыз.
Dialogue: 0,0:53:41.94,0:53:46.46,1080,,0000,0000,0000,,Менің қарным ашты. Біреу айналма жолмен жүре ме?
Dialogue: 0,0:53:46.46,0:53:48.44,1080,,0000,0000,0000,,Себебі менде оқитын нәрсе бар.
Dialogue: 0,0:53:48.44,0:53:50.94,1080,,0000,0000,0000,,Сізге анда-санда дем алу керек.
Dialogue: 0,0:53:50.94,0:53:55.10,1080,,0000,0000,0000,,Бұл жұмыс істемейді,мен онымен кездесуге де уақытым жоқ.
Dialogue: 0,0:53:55.10,0:53:56.48,1080,,0000,0000,0000,,Ол?
Dialogue: 0,0:53:56.48,0:53:59.06,1080,,0000,0000,0000,,Джо-сенпай,сенің қызың бар ма?
Dialogue: 0,0:53:59.06,0:54:00.96,1080,,0000,0000,0000,,Мүмкін емес Мүмкін емес
Dialogue: 0,0:54:00.96,0:54:02.98,1080,,0000,0000,0000,,Қарсылас адам
Dialogue: 0,0:54:02.98,0:54:05.14,1080,,0000,0000,0000,,Такеру-кун,бұл сұмдық.
Dialogue: 0,0:54:05.14,0:54:06.87,1080,,0000,0000,0000,,Мен сенбеймін.
Dialogue: 0,0:54:06.87,0:54:09.36,1080,,0000,0000,0000,,Мен әлі үлкенмін.
Dialogue: 0,0:54:09.36,0:54:12.78,1080,,0000,0000,0000,,Сондықтан бірінші болып бақытты табуға құқығың бар.
Dialogue: 0,0:54:12.78,0:54:15.60,1080,,0000,0000,0000,,Бәріміз сенейік
Dialogue: 0,0:54:15.60,0:54:17.39,1080,,0000,0000,0000,,Сену
Dialogue: 0,0:54:17.39,0:54:20.46,1080,,0000,0000,0000,,Сіз бұған сенбейтін едіңіз.
Dialogue: 0,0:54:23.09,0:54:25.32,1080,,0000,0000,0000,,Мими осында.
Dialogue: 0,0:54:25.32,0:54:26.32,1080,,0000,0000,0000,,Пальмон
Dialogue: 0,0:54:26.32,0:54:28.72,1080,,0000,0000,0000,,Сондай-ақ Биомон мен Тайлмон бар.
Dialogue: 0,0:54:28.72,0:54:29.92,1080,,0000,0000,0000,,Қараңыз
Dialogue: 0,0:54:31.46,0:54:32.84,1080,,0000,0000,0000,,Биомон Тайлмон
Dialogue: 0,0:54:37.81,0:54:40.68,1080,,0000,0000,0000,,Сіз ерекше доссыз.
Dialogue: 0,0:54:46.68,0:54:49.42,1080,,0000,0000,0000,,Сабыр етіңіз
Dialogue: 0,0:54:49.42,0:54:52.06,1080,,0000,0000,0000,,Itadadakimasu
Dialogue: 0,0:54:54.92,0:54:56.74,1080,,0000,0000,0000,,Дәмді
Dialogue: 0,0:54:56.74,0:55:00.68,1080,,0000,0000,0000,,Үйге келгенде жеу керек болды. Бұл таңқаларлық болды.
Dialogue: 0,0:55:00.68,0:55:02.14,1080,,0000,0000,0000,,Дұрыс па?
Dialogue: 0,0:55:02.14,0:55:05.42,1080,,0000,0000,0000,,Мен бұл сорпа сорпасына және оның сәл балқитын құрылымына тоймаймын.
Dialogue: 0,0:55:05.42,0:55:07.36,1080,,0000,0000,0000,,Шынайы ақиқат
Dialogue: 0,0:55:08.40,0:55:11.08,1080,,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:55:11.08,0:55:13.08,1080,,0000,0000,0000,,Тайчи мен Ямато туралы
Dialogue: 0,0:55:13.08,0:55:15.38,1080,,0000,0000,0000,,Жарайды,жай қалдырыңыз.
Dialogue: 0,0:55:15.38,0:55:16.34,1080,,0000,0000,0000,,Бірақ
Dialogue: 0,0:55:16.34,0:55:17.82,1080,,0000,0000,0000,,Мен әлі де қызықпын
Dialogue: 0,0:55:18.24,0:55:21.36,1080,,0000,0000,0000,,Екеуі де өте сымбатты жігіттерге айналды.
Dialogue: 0,0:55:21.36,0:55:23.35,1080,,0000,0000,0000,,Не істеп жатырсыз,Сора мырза?
Dialogue: 0,0:55:29.30,0:55:31.46,1080,,0000,0000,0000,,Икемен дегеніміз не?
Dialogue: 0,0:55:31.46,0:55:33.46,1080,,0000,0000,0000,,Мен шынымен түсінбеймін
Dialogue: 0,0:55:33.46,0:55:38.20,1080,,0000,0000,0000,,Джаса,саған пийоның қандай түрі ұнайды?
Dialogue: 0,0:55:38.20,0:55:39.85,1080,,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,0:55:40.50,0:55:43.06,1080,,0000,0000,0000,,Өйткені қалың кеспеден жұқа кеспе жақсы.
Dialogue: 0,0:55:43.06,0:55:46.06,1080,,0000,0000,0000,,Сора бұйра кеспе ұнататынын айтады.
Dialogue: 0,0:55:46.06,0:55:47.46,1080,,0000,0000,0000,,Мочизуки мырза
Dialogue: 0,0:55:49.14,0:55:51.26,1080,,0000,0000,0000,,Ауыстырыңыз
Dialogue: 0,0:55:51.26,0:55:53.54,1080,,0000,0000,0000,,Кочимо өтінемін
Dialogue: 0,0:55:53.54,0:55:56.36,1080,,0000,0000,0000,,Иә, иә,сәл күте тұрыңыз.
Dialogue: 0,0:55:58.08,0:56:00.04,1080,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:56:13.42,0:56:15.06,1080,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:56:15.06,0:56:16.50,1080,,0000,0000,0000,,Осымен
Dialogue: 0,0:56:17.42,0:56:21.61,1080,,0000,0000,0000,,Мен Нишижима мырза келе ме, жоқ па,соны тексеріп көрейін деп ойладым.
Dialogue: 0,0:56:27.06,0:56:29.20,1080,,0000,0000,0000,,Тәуелсіздік...Ұзақ
Dialogue: 0,0:56:29.20,0:56:32.97,1080,,0000,0000,0000,,Ақпаратты өңдеу жөніндегі ұлттық агенттік,тәуелсіз әкімшілік агенттік
Dialogue: 0,0:56:32.97,0:56:36.15,1080,,0000,0000,0000,,Ақпараттық-коммуникациялық стратегия департаменті Ақпаратты басқару кеңсесі
Dialogue: 0,0:56:36.15,0:56:39.63,1080,,0000,0000,0000,,Екінші дәрежелі басқару офицері Дайго Нишижима
Dialogue: 0,0:56:41.22,0:56:42.86,1080,,0000,0000,0000,,Сіз мұғалім емессіз бе?
Dialogue: 0,0:56:42.86,0:56:45.18,1080,,0000,0000,0000,,Менің негізгі жұмысым – визитка жасау.
Dialogue: 0,0:56:45.64,0:56:49.62,1080,,0000,0000,0000,,Соңғы уақытта цифрлық әлем мен біздің әлем арасында бұрмалану орын алды.
Dialogue: 0,0:56:49.62,0:56:53.01,1080,,0000,0000,0000,,Сандық құбыжық қақпадан басқа маршрут арқылы пайда болады.
Dialogue: 0,0:56:54.91,0:56:57.44,1080,,0000,0000,0000,,Осы уақытқа дейін бұл мәселені өзіміз шештік.
Dialogue: 0,0:56:57.44,0:57:00.14,1080,,0000,0000,0000,,Өте күшті өнімдер шыға бастады.
Dialogue: 0,0:57:00.14,0:57:02.65,1080,,0000,0000,0000,,Сондықтан мен сізден қолдау сұрадым.
Dialogue: 0,0:57:02.65,0:57:05.37,1080,,0000,0000,0000,,Біз оларды жұқтырған дигимон деп атаймыз.
Dialogue: 0,0:57:05.37,0:57:07.12,1080,,0000,0000,0000,,Дигимон жұқтырды ма?
Dialogue: 0,0:57:07.51,0:57:10.40,1080,,0000,0000,0000,,Бір нәрсе қатты әсер еткен сандық құбыжық
Dialogue: 0,0:57:10.40,0:57:14.27,1080,,0000,0000,0000,,Сіз бақылауды жоғалтасыз және өзіңізді бақылаудан шығып бара жатқандай сезінесіз.
Dialogue: 0,0:57:14.71,0:57:17.33,1080,,0000,0000,0000,,Сондықтан олар оны жұқтырған дигимон деп атайды.
Dialogue: 0,0:57:17.33,0:57:18.22,1080,,0000,0000,0000,,Себебі
Dialogue: 0,0:57:18.22,0:57:20.73,1080,,0000,0000,0000,,Өкінішке орай,біз әлі түсінбейміз.
Dialogue: 0,0:57:20.73,0:57:24.68,1080,,0000,0000,0000,,Осы жұқтырған Digimon-ды қалай қалпына келтіруге болады?
Dialogue: 0,0:57:24.68,0:57:26.35,1080,,0000,0000,0000,,Қызық екен.
Dialogue: 0,0:57:26.35,0:57:29.84,1080,,0000,0000,0000,,Мүмкін болуы мүмкін,бірақ қалай екенін әлі білмейміз.
Dialogue: 0,0:57:29.84,0:57:31.95,1080,,0000,0000,0000,,Мен түсінбейтін нәрселер өте көп.
Dialogue: 0,0:57:31.95,0:57:36.86,1080,,0000,0000,0000,,Дәл қазір,бұл әлемде бұдан да көп зиянның алдын алу үшін.
Dialogue: 0,0:57:36.86,0:57:39.46,1080,,0000,0000,0000,,Бұл оларды тез арада кері қайтарудан басқа амалымыз жоқ дегенді білдіреді.
Dialogue: 0,0:57:39.46,0:57:43.65,1080,,0000,0000,0000,,Бірақ неге мұғалімдер мұның бәрін біледі?
Dialogue: 0,0:57:44.04,0:57:46.18,1080,,0000,0000,0000,,Сіз тіпті біз туралы білесіз.
Dialogue: 0,0:57:46.58,0:57:48.89,1080,,0000,0000,0000,,Хикаригаока мен Одайба оқиғаларынан кейін
Dialogue: 0,0:57:48.89,0:57:51.62,1080,,0000,0000,0000,,Дигимон туралы білетіндердің саны артуда
Dialogue: 0,0:57:51.95,0:57:55.43,1080,,0000,0000,0000,,Бізбен өзін Геннай деп атайтын адам хабарласты.
Dialogue: 0,0:57:55.43,0:57:59.27,1080,,0000,0000,0000,,Сандық құбыжықтар бойынша жүйелі зерттеулер жүргізу
Dialogue: 0,0:58:00.31,0:58:02.26,1080,,0000,0000,0000,,Мен Геннай мырзаны білемін.
Dialogue: 0,0:58:02.26,0:58:04.94,1080,,0000,0000,0000,,Мен тек басқа жақтан ақпарат алып жатырмын.
Dialogue: 0,0:58:04.94,0:58:07.90,1080,,0000,0000,0000,,Ол сізді жақсы білетін адам сияқты.
Dialogue: 0,0:58:08.22,0:58:10.70,1080,,0000,0000,0000,,Өткенде көрсеткен көмегіңіз үшін рахмет.
Dialogue: 0,0:58:11.51,0:58:15.20,1080,,0000,0000,0000,,Қалай болғанда да,келесі күшті жұқтырған Digimon пайда болса
Dialogue: 0,0:58:15.20,0:58:18.90,1080,,0000,0000,0000,,Біз сіздің ынтымақтастықты қайта сұрауымыз мүмкін.
Dialogue: 0,0:58:18.90,0:58:20.52,1080,,0000,0000,0000,,Сізге көп рахмет.
Dialogue: 0,0:58:21.29,0:58:22.61,1080,,0000,0000,0000,,Мен білемін
Dialogue: 0,0:58:29.62,0:58:34.82,1080,,0000,0000,0000,,Қазіргі уақытта басқа елдерден цифрлық құбыжықтарға қатысты ақпаратты ашуға сұраныстар көбейіп келеді.
Dialogue: 0,0:58:34.82,0:58:37.15,1080,,0000,0000,0000,,Ақпарат әлі жеткіліксіз
Dialogue: 0,0:58:37.15,0:58:40.86,1080,,0000,0000,0000,,Геннай деген ақпарат беруші не болып жатыр?
Dialogue: 0,0:58:40.86,0:58:44.01,1080,,0000,0000,0000,,Біз бұл жерден сізбен байланыса алмаймыз.
Dialogue: 0,0:58:44.01,0:58:47.41,1080,,0000,0000,0000,,Кез келген жағдайда жіберуге болатын материалдарды мүмкіндігінше тезірек құрастырыңыз.
Dialogue: 0,0:58:47.41,0:58:48.87,1080,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:58:51.95,0:58:52.88,1080,,0000,0000,0000,,Иә
Dialogue: 0,0:58:52.88,0:58:55.57,1080,,0000,0000,0000,,Мен балаларға мысал туралы айттым.
Dialogue: 0,0:58:55.57,0:58:56.78,1080,,0000,0000,0000,,Оны алып кетуге келген анасымен бірге —
Dialogue: 0,0:58:59.77,0:59:04.02,1080,,0000,0000,0000,,Эй, Коуширо-сан,сен мұнда киім алуға келмедің бе?
Dialogue: 0,0:59:04.02,0:59:08.04,1080,,0000,0000,0000,,Дүкенге барудың қажеті болмаса да,интернет-дүкен - тамаша мүмкіндік.
Dialogue: 0,0:59:08.04,0:59:09.62,1080,,0000,0000,0000,,Пошта тапсырысы?
Dialogue: 0,0:59:09.62,0:59:11.66,1080,,0000,0000,0000,,Бұл ұят оқиға.
Dialogue: 0,0:59:11.66,0:59:14.93,1080,,0000,0000,0000,,Осы уақытқа дейін анам маған бәрін сатып алған.
Dialogue: 0,0:59:14.93,0:59:19.24,1080,,0000,0000,0000,,Бірақ мен жоғары сынып оқушысы болғандықтан,мен бірінші рет өз таңдауымды жасап көрейін деп ойладым.
Dialogue: 0,0:59:19.24,0:59:20.77,1080,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:59:20.77,0:59:25.71,1080,,0000,0000,0000,,Дегенмен,дүкен қызметкерімен қарым-қатынас маған тым көп болды.
Dialogue: 0,0:59:25.71,0:59:26.66,1080,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:59:26.66,0:59:29.30,1080,,0000,0000,0000,,Мен оны интернеттен де оңай сатып аламын.
Dialogue: 0,0:59:29.30,0:59:33.02,1080,,0000,0000,0000,,Мен кенеттен сәнге айналғым келмейді.
Dialogue: 0,0:59:33.02,0:59:35.90,1080,,0000,0000,0000,,Мұның астарында терең мағына жоқ.
Dialogue: 0,0:59:36.86,0:59:39.23,1080,,0000,0000,0000,,Мими?
Dialogue: 0,0:59:46.64,0:59:51.28,1080,,0000,0000,0000,,Мен сондай-ақ денемді дәл бейнелейтін киіну бағдарламалық құралын әзірледім.
Dialogue: 0,0:59:51.28,0:59:54.95,1080,,0000,0000,0000,,Мұнда киім өлшемі мен түсін енгізіңіз
Dialogue: 0,0:59:54.95,0:59:56.03,1080,,0000,0000,0000,,Қараңыз
Dialogue: 0,0:59:58.53,1:00:03.64,1080,,0000,0000,0000,,Коуширо-ханның сәнді киім іздейтін күні келетініне сене алар емеспін.
Dialogue: 0,1:00:03.64,1:00:06.16,1080,,0000,0000,0000,,Тентомон,жылама
Dialogue: 0,1:00:14.00,1:00:15.65,1080,,0000,0000,0000,,Тайчи
Dialogue: 0,1:00:18.35,1:00:20.16,1080,,0000,0000,0000,,Жоқ,бірақ Йор-чан менің байқамай тұрғанымда үйленіп кеткеніне сенбеймін.
Dialogue: 0,1:00:23.93,1:00:25.36,1080,,0000,0000,0000,,Тайчи
Dialogue: 0,1:00:42.70,1:00:45.14,1080,,0000,0000,0000,,Не болды,Ямато?
Dialogue: 0,1:00:46.60,1:00:48.21,1080,,0000,0000,0000,,Тайчидің бірі
Dialogue: 0,1:00:50.88,1:00:54.12,1080,,0000,0000,0000,,Барлығы өзгере ме?
Dialogue: 0,1:00:57.17,1:00:58.54,1080,,0000,0000,0000,,Ямато
Dialogue: 0,1:01:02.86,1:01:04.92,1080,,0000,0000,0000,,Yamato өзгермейді.
Dialogue: 0,1:01:06.88,1:01:09.61,1080,,0000,0000,0000,,Оның ашуланғаны таңқаларлық емес.
Dialogue: 0,1:01:12.28,1:01:14.61,1080,,0000,0000,0000,,Мүмкін мен қателескен шығармын?
Dialogue: 0,1:01:16.77,1:01:18.21,1080,,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,1:01:20.00,1:01:22.34,1080,,0000,0000,0000,,Мен білмеймін
Dialogue: 0,1:01:35.15,1:01:36.54,1080,,0000,0000,0000,,Бұл қорқынышты
Dialogue: 0,1:01:38.48,1:01:41.36,1080,,0000,0000,0000,,Көп нәрсені байқамай сындырдым.
Dialogue: 0,1:01:42.35,1:01:44.16,1080,,0000,0000,0000,,Тек ғимараттар емес
Dialogue: 0,1:01:45.11,1:01:49.65,1080,,0000,0000,0000,,Сіз тіпті біреуді өлтіруіңіз мүмкін.
Dialogue: 0,1:01:52.62,1:01:56.56,1080,,0000,0000,0000,,Маған қызық,сіз қазір не туралы айтып отырсыз...
Dialogue: 0,1:01:57.73,1:01:59.50,1080,,0000,0000,0000,,Тайчи
Dialogue: 0,1:02:11.64,1:02:14.98,1080,,0000,0000,0000,,Әй, аға,сен Агумонды алып келдің.
Dialogue: 0,1:02:15.46,1:02:18.67,1080,,0000,0000,0000,,Тэйлмон және басқалары үйде.
Dialogue: 0,1:02:20.93,1:02:23.06,1080,,0000,0000,0000,,Яматоның бір жұмысы бар.
Dialogue: 0,1:02:23.06,1:02:25.80,1080,,0000,0000,0000,,Жо-сенпайдың да келе алмайтыны туралы хабар алдым.
Dialogue: 0,1:02:25.80,1:02:27.37,1080,,0000,0000,0000,,Бұл қауесет
Dialogue: 0,1:02:27.37,1:02:29.82,1080,,0000,0000,0000,,Иә,бұл мен мақтан тұтатын кеңсе.
Dialogue: 0,1:02:29.82,1:02:32.12,1080,,0000,0000,0000,,Бұл өте жақсы бөлме.
Dialogue: 0,1:02:35.08,1:02:36.93,1080,,0000,0000,0000,,Иә,мырза.
Dialogue: 0,1:02:36.93,1:02:38.36,1080,,0000,0000,0000,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,1:02:41.48,1:02:44.80,1080,,0000,0000,0000,,Сәлеметсіз бе,бұл керемет пәтер.
Dialogue: 0,1:02:44.80,1:02:46.60,1080,,0000,0000,0000,,Бұл Коушироның кеңсесі.
Dialogue: 0,1:02:46.60,1:02:49.04,1080,,0000,0000,0000,,Ах.
Dialogue: 0,1:02:49.04,1:02:51.11,1080,,0000,0000,0000,,Біз де бірінші рет кірдік.
Dialogue: 0,1:02:51.11,1:02:54.46,1080,,0000,0000,0000,,Мен Америкадағы бір танысым бастаған компанияға көмектесіп жатырмын.
Dialogue: 0,1:02:54.46,1:02:56.58,1080,,0000,0000,0000,,Күтілгендей керемет
Dialogue: 0,1:02:57.68,1:03:01.07,1080,,0000,0000,0000,,Мұғалімнен естігеніміз осы ғана.
Dialogue: 0,1:03:01.07,1:03:03.77,1080,,0000,0000,0000,,Жұқтырған дигимон...?
Dialogue: 0,1:03:03.77,1:03:07.51,1080,,0000,0000,0000,,Оның қайтадан көрінуі тітіркендіргіш.
Dialogue: 0,1:03:07.51,1:03:10.98,1080,,0000,0000,0000,,Биомон мен басқалардың осында келуі шынымен көмектесті.
Dialogue: 0,1:03:10.98,1:03:15.30,1080,,0000,0000,0000,,Коуширо-хан,мұны бәріне көрсетсек қалай болады?
Dialogue: 0,1:03:16.24,1:03:17.66,1080,,0000,0000,0000,,Бұл болды
Dialogue: 0,1:03:18.08,1:03:20.52,1080,,0000,0000,0000,,Иә, иә,бір сәт кешіріңіз.
Dialogue: 0,1:03:24.00,1:03:26.54,1080,,0000,0000,0000,,Гекора жиынтығы
Dialogue: 0,1:03:27.03,1:03:28.00,1080,,0000,0000,0000,,Агумон
Dialogue: 0,1:03:28.00,1:03:28.82,1080,,0000,0000,0000,,Биомон
Dialogue: 0,1:03:28.82,1:03:31.23,1080,,0000,0000,0000,,Жарайды,ана жақта.
Dialogue: 0,1:03:35.40,1:03:39.31,1080,,0000,0000,0000,,Мен осы серверде виртуалды компьютер кеңістігін жасадым.
Dialogue: 0,1:03:39.31,1:03:43.78,1080,,0000,0000,0000,,Мен Дигимонға төтенше жағдайда қашатын орын керек деп ойладым.
Dialogue: 0,1:03:46.95,1:03:48.85,1080,,0000,0000,0000,,Biyomon электрондық поштасы.
Dialogue: 0,1:03:48.85,1:03:51.92,1080,,0000,0000,0000,,Ал,мұнымен не істеуіміз керек?
Dialogue: 0,1:03:54.04,1:03:56.67,1080,,0000,0000,0000,,Менің ағам да Агумоннан келеді.
Dialogue: 0,1:03:56.67,1:04:00.51,1080,,0000,0000,0000,,Сөйлесулерді электрондық пошта арқылы немесе монитор арқылы жасауға болады.
Dialogue: 0,1:04:00.51,1:04:02.96,1080,,0000,0000,0000,,Ыңғайлылық
Dialogue: 0,1:04:03.46,1:04:05.23,1080,,0000,0000,0000,,Сіз шыға аласыз ба?
Dialogue: 0,1:04:08.44,1:04:09.55,1080,,0000,0000,0000,,Үй ойынынан біраз жалығып кеттім ғой,иә?
Dialogue: 0,1:04:09.55,1:04:10.99,1080,,0000,0000,0000,,Жақсы
Dialogue: 0,1:04:10.99,1:04:13.06,1080,,0000,0000,0000,,Ұялы телефон арқылы қоңырау шалуға болады.
Dialogue: 0,1:04:13.06,1:04:15.70,1080,,0000,0000,0000,,Ұялы телефонда өңдеу жылдамдығы жеткіліксіз
Dialogue: 0,1:04:15.70,1:04:20.75,1080,,0000,0000,0000,,Егер мен оны компьютерімде көрсетсем,ол желіге қосылған үлкен монитор арқылы көрсетіледі.
Dialogue: 0,1:04:20.75,1:04:23.53,1080,,0000,0000,0000,,Сіз бұл виртуалды киберкеңістікке қайта-қайта бара аласыз.
Dialogue: 0,1:04:23.53,1:04:26.24,1080,,0000,0000,0000,,Онда сіз маған кез келген уақытта қоңырау шала аласыз.
Dialogue: 0,1:04:26.24,1:04:31.21,1080,,0000,0000,0000,,Иә,мен әдетте өз бөлмемде немесе сервердің киберкеңістігінде боламын.
Dialogue: 0,1:04:31.21,1:04:33.96,1080,,0000,0000,0000,,Жоқ,бұл менің кінәм.
Dialogue: 0,1:04:34.03,1:04:36.11,1080,,0000,0000,0000,,Маған тезірек үйге бару керек.
Dialogue: 0,1:04:36.67,1:04:40.22,1080,,0000,0000,0000,,Не,Тайчи екеуің сөзге келдіңдер ме?
Dialogue: 0,1:04:40.22,1:04:43.80,1080,,0000,0000,0000,,Бүгін келмегендіктен,мен сені әлі ұйықтап жатырсың деп ойладым.
Dialogue: 0,1:04:44.47,1:04:46.23,1080,,0000,0000,0000,,Айналаңда ұйықтама
Dialogue: 0,1:04:46.23,1:04:49.36,1080,,0000,0000,0000,,Ол сенбі күні бәріміз қайта жиналамыз деді.
Dialogue: 0,1:04:49.36,1:04:52.51,1080,,0000,0000,0000,,Келесі жолы дұрыс келіңіз.
Dialogue: 0,1:05:07.96,1:05:10.03,1080,,0000,0000,0000,,Коширо-сан,түні бойы ұйықтамайсың ба?
Dialogue: 0,1:05:10.03,1:05:11.87,1080,,0000,0000,0000,,Дұрыс ұйықтау керек
Dialogue: 0,1:05:11.87,1:05:14.15,1080,,0000,0000,0000,,Мен үш сағаттай ұйықтадым.
Dialogue: 0,1:05:14.47,1:05:16.70,1080,,0000,0000,0000,,Соңында аяқталды
Dialogue: 0,1:05:16.70,1:05:19.68,1080,,0000,0000,0000,,Киіп көріңіз,Тайчи-сан.
Dialogue: 0,1:05:23.56,1:05:28.02,1080,,0000,0000,0000,,Бұл теориялық тұрғыдан бұрмалануды анықтауға мүмкіндік беруі керек.
Dialogue: 0,1:05:30.27,1:05:36.10,1080,,0000,0000,0000,,Эй, Тайчи,біз Коуширо бізге арнап жасаған сервер бөлмесіне қайта барамыз.
Dialogue: 0,1:05:36.10,1:05:38.90,1080,,0000,0000,0000,,Коушироның компьютерінен кіруге болады,солай ма?
Dialogue: 0,1:05:38.90,1:05:42.91,1080,,0000,0000,0000,,Интернетке қосылған мониторыңыз болса,оны сол жерден орындауға болады.
Dialogue: 0,1:05:45.03,1:05:47.14,1080,,0000,0000,0000,,Бұл жерде жақсы көрінеді.
Dialogue: 0,1:05:47.14,1:05:49.26,1080,,0000,0000,0000,,Бірдеңе болса,маған қоңырау шалыңыз.
Dialogue: 0,1:05:52.72,1:05:55.36,1080,,0000,0000,0000,,Сонымен не істейміз?
Dialogue: 0,1:05:55.36,1:05:58.28,1080,,0000,0000,0000,,Тергеу нәтижесінде бұл бұрмалау болып табылады
Dialogue: 0,1:05:58.28,1:06:01.60,1080,,0000,0000,0000,,Деректер шоғырланған жерде орын алатын сияқты.
Dialogue: 0,1:06:01.96,1:06:06.20,1080,,0000,0000,0000,,Бұл механизм осы көзілдірік арқылы деректер ағынын көруге мүмкіндік береді.
Dialogue: 0,1:06:08.25,1:06:11.13,1080,,0000,0000,0000,,Түс деректер түрі мен күшін көрсетеді
Dialogue: 0,1:06:11.58,1:06:15.17,1080,,0000,0000,0000,,Мысалы,мен өз серверіме осылай қосылсам
Dialogue: 0,1:06:16.18,1:06:19.06,1080,,0000,0000,0000,,Рас,жарық күшейе түсті.
Dialogue: 0,1:06:19.61,1:06:21.28,1080,,0000,0000,0000,,Қай жерде қызыл күшті болады
Dialogue: 0,1:06:21.28,1:06:24.80,1080,,0000,0000,0000,,Бұл осы бұрмалауға қатысты болып көрінетін деректер жинағы.
Dialogue: 0,1:06:25.47,1:06:30.62,1080,,0000,0000,0000,,Вирус жұқтырған Digimon үлкен бұрмаланулары бар жерлерден шығуы мүмкін.
Dialogue: 0,1:06:30.62,1:06:32.98,1080,,0000,0000,0000,,Бұл дұрыс
Dialogue: 0,1:06:32.98,1:06:36.34,1080,,0000,0000,0000,,Сондықтан осы аймақтағы бұрмалануды тексеріңіз.
Dialogue: 0,1:06:36.34,1:06:40.29,1080,,0000,0000,0000,,Қауіпті жерлердің бар-жоғын алдын ала тексеріңіз.
Dialogue: 0,1:06:40.29,1:06:41.40,1080,,0000,0000,0000,,Бұл
Dialogue: 0,1:06:44.16,1:06:45.60,1080,,0000,0000,0000,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,1:06:47.07,1:06:48.44,1080,,0000,0000,0000,,Не болды?
Dialogue: 0,1:06:51.30,1:06:57.72,1080,,0000,0000,0000,,Мм, мен бірдеңе іздеп едім,адасып қалдым.
Dialogue: 0,1:06:57.72,1:06:59.38,1080,,0000,0000,0000,,Мен саған айналаны көрсетейін бе?
Dialogue: 0,1:06:59.38,1:07:00.95,1080,,0000,0000,0000,,Кешігіп қалғаным үшін кешірім сұраймын.
Dialogue: 0,1:07:01.27,1:07:05.92,1080,,0000,0000,0000,,Жарайды, жарайды,біз бірдеңе іздеп жатырмыз.
Dialogue: 0,1:07:05.92,1:07:07.28,1080,,0000,0000,0000,,Оған не болды?
Dialogue: 0,1:07:08.05,1:07:11.00,1080,,0000,0000,0000,,Жүр,тез кел.
Dialogue: 0,1:07:11.47,1:07:15.51,1080,,0000,0000,0000,,Айтпақшы,Мочизуки-сан не іздеп жүр?
Dialogue: 0,1:07:15.87,1:07:19.57,1080,,0000,0000,0000,,Сол мысық...
Dialogue: 0,1:07:20.52,1:07:22.13,1080,,0000,0000,0000,,Немесе дұрысырақ?
Dialogue: 0,1:07:30.81,1:07:33.71,1080,,0000,0000,0000,,Тайчи-сан,мұнда не болып жатыр?
Dialogue: 0,1:07:39.03,1:07:40.82,1080,,0000,0000,0000,,Оларды түгелдей қырғындап тастауымыз керек!
Dialogue: 0,1:07:48.07,1:07:50.64,1080,,0000,0000,0000,,Осы уақытқа дейін іздеп жүрсіз бе?
Dialogue: 0,1:07:50.64,1:07:53.98,1080,,0000,0000,0000,,Кешіріңіз,қарным ашты.
Dialogue: 0,1:07:53.98,1:07:56.32,1080,,0000,0000,0000,,Төртінші қатардың артындағы орындардағы адамдар
Dialogue: 0,1:07:56.32,1:07:58.77,1080,,0000,0000,0000,,Егер сіз көп тырыспасаңыз,сіз сәтсіздікке ұшырайсыз.
Dialogue: 0,1:08:00.32,1:08:02.48,1080,,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,1:08:15.43,1:08:17.64,1080,,0000,0000,0000,,Осы суретте олар мінсіз жұп сияқты көрінеді,иә?
Dialogue: 0,1:08:18.32,1:08:21.12,1080,,0000,0000,0000,,Одан кейін өзім іздеймін.
Dialogue: 0,1:08:21.12,1:08:22.81,1080,,0000,0000,0000,,Бұл өте жақсы
Dialogue: 0,1:08:22.81,1:08:25.26,1080,,0000,0000,0000,,Иә,көп рахмет.
Dialogue: 0,1:08:29.90,1:08:31.41,1080,,0000,0000,0000,,Сәлем,Коуширо
Dialogue: 0,1:08:31.41,1:08:32.95,1080,,0000,0000,0000,,Не болды?
Dialogue: 0,1:08:33.47,1:08:37.34,1080,,0000,0000,0000,,Мына көзілдірік,мен алысты көре алмаймын.
Dialogue: 0,1:08:37.34,1:08:40.41,1080,,0000,0000,0000,,Бір уақытта көбірек іздеудің жолы бар ма?
Dialogue: 0,1:08:40.41,1:08:42.63,1080,,0000,0000,0000,,Неліктен жоғарырақ жерге бармасқа?
Dialogue: 0,1:08:42.63,1:08:45.17,1080,,0000,0000,0000,,Бұл жерде қандай биік жерлер бар?
Dialogue: 0,1:08:45.90,1:08:47.55,1080,,0000,0000,0000,,Мына жерде.
Dialogue: 0,1:08:50.94,1:08:52.27,1080,,0000,0000,0000,,Қараңыз
Dialogue: 0,1:08:52.27,1:08:53.46,1080,,0000,0000,0000,,Ямато
Dialogue: 0,1:08:54.34,1:08:55.95,1080,,0000,0000,0000,,Оны баспаңыз
Dialogue: 0,1:08:55.95,1:08:58.41,1080,,0000,0000,0000,,Бұл өте адал емес.
Dialogue: 0,1:08:58.41,1:09:00.84,1080,,0000,0000,0000,,Мен Агумонның орнына барамын.
Dialogue: 0,1:09:04.85,1:09:06.16,1080,,0000,0000,0000,,Неліктен айналмалы дөңгелек?
Dialogue: 0,1:09:06.16,1:09:08.84,1080,,0000,0000,0000,,Толық ақпаратты Тайчиден сұраңыз.
Dialogue: 0,1:09:10.61,1:09:12.08,1080,,0000,0000,0000,,Эй,иә
Dialogue: 0,1:09:11.75,1:09:13.20,1080,,0000,0000,0000,,Шынайы ма?
Dialogue: 0,1:09:13.20,1:09:18.81,1080,,0000,0000,0000,,Қараңдаршы, Тайчи-сан мен Ямато-сан,екеуміз ғана болған сияқтымыз.
Dialogue: 0,1:09:18.81,1:09:21.12,1080,,0000,0000,0000,,Татуласамыз деп үміттенемін.
Dialogue: 0,1:09:21.12,1:09:23.45,1080,,0000,0000,0000,,Сіз ұрысып жатырсыз ба?
Dialogue: 0,1:09:23.45,1:09:27.10,1080,,0000,0000,0000,,Дәлірек айтсақ,баяғы күндегісі дірілдеп тұр.
Dialogue: 0,1:09:27.10,1:09:29.20,1080,,0000,0000,0000,,Мүмкін бір-біріне
Dialogue: 0,1:09:29.58,1:09:32.18,1080,,0000,0000,0000,,Менің ес-түсім толық.
Dialogue: 0,1:09:32.18,1:09:34.86,1080,,0000,0000,0000,,Doing Doing
Dialogue: 0,1:09:39.45,1:09:40.53,1080,,0000,0000,0000,,Қара…
Dialogue: 0,1:09:42.74,1:09:44.13,1080,,0000,0000,0000,,Осы уақыт ішінде
Dialogue: 0,1:09:45.81,1:09:47.95,1080,,0000,0000,0000,,Мен де өзімді жаман сезіндім.
Dialogue: 0,1:09:48.32,1:09:50.77,1080,,0000,0000,0000,,Бірақ сіз де жақсырақ болуыңыз керек.
Dialogue: 0,1:09:52.12,1:09:55.64,1080,,0000,0000,0000,,Вирус жұқтырған Digimon болашақта қайта пайда болуы мүмкін.
Dialogue: 0,1:09:57.78,1:10:01.01,1080,,0000,0000,0000,,Сізді не уайымдады? Бұл сен сияқты емес.
Dialogue: 0,1:10:01.01,1:10:03.08,1080,,0000,0000,0000,,Ескі болсаң жақсы болар еді...
Dialogue: 0,1:10:03.45,1:10:04.75,1080,,0000,0000,0000,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,1:10:06.05,1:10:07.93,1080,,0000,0000,0000,,Бұрынғыдан басқаша.
Dialogue: 0,1:10:13.32,1:10:15.84,1080,,0000,0000,0000,,Мен бұрынғыдан көп нәрсені көре аламын.
Dialogue: 0,1:10:16.63,1:10:18.13,1080,,0000,0000,0000,,түсініксіз болады
Dialogue: 0,1:10:19.47,1:10:22.84,1080,,0000,0000,0000,,Біздің істеп жатқан ісіміз жақсы ма?
Dialogue: 0,1:10:23.87,1:10:25.11,1080,,0000,0000,0000,,Әлде…
Dialogue: 0,1:10:26.36,1:10:28.24,1080,,0000,0000,0000,,Жаман ба?
Dialogue: 0,1:10:37.96,1:10:40.88,1080,,0000,0000,0000,,Мен мұны істеуден басқа амалымыз жоқ екенін де білемін.
Dialogue: 0,1:10:41.50,1:10:44.11,1080,,0000,0000,0000,,Бірақ бұл оңай емес.
Dialogue: 0,1:10:48.03,1:10:50.33,1080,,0000,0000,0000,,Бұл жай ғана қашып бара жатқан шығар.
Dialogue: 0,1:10:54.96,1:10:58.25,1080,,0000,0000,0000,,Қызық,Тайчи мен Ямато не туралы айтып жатыр?
Dialogue: 0,1:10:58.25,1:11:00.13,1080,,0000,0000,0000,,Маған қызық.
Dialogue: 0,1:11:05.36,1:11:07.54,1080,,0000,0000,0000,,Не үшін келдің?
Dialogue: 0,1:11:07.90,1:11:10.28,1080,,0000,0000,0000,,Иә,ұмытып қалдым.
Dialogue: 0,1:11:12.65,1:11:14.02,1080,,0000,0000,0000,,Дегенмен, сол бір қадам біз, адамзат үшін,үлкен ілгерілеу болар еді.
Dialogue: 0,1:11:19.83,1:11:21.71,1080,,0000,0000,0000,,Мен бұрмалауды көрдім.
Dialogue: 0,1:11:22.76,1:11:25.40,1080,,0000,0000,0000,,Біз барлық келушілерді хабардар еткіміз келеді.
Dialogue: 0,1:11:25.40,1:11:29.33,1080,,0000,0000,0000,,Қазіргі уақытта Одайбада жергілікті қалыпты емес ауа-райы орын алуда.
Dialogue: 0,1:11:29.33,1:11:34.26,1080,,0000,0000,0000,,Ауыр апат ықтималдығына байланысты эвакуация туралы ескерту жарияланды.
Dialogue: 0,1:11:34.74,1:11:39.46,1080,,0000,0000,0000,,Ғимарат ішіндегі тұтынушылар әрекет ету кезінде қауіпсіз болуы керек.
Dialogue: 0,1:11:39.94,1:11:42.62,1080,,0000,0000,0000,,Төтенше жағдайда дереу эвакуациялаңыз
Dialogue: 0,1:11:52.10,1:11:53.77,1080,,0000,0000,0000,,Бұл не?
Dialogue: 0,1:11:55.87,1:11:57.98,1080,,0000,0000,0000,,Балаларға не болды?
Dialogue: 0,1:11:57.98,1:12:00.06,1080,,0000,0000,0000,,Әлі байланыс жоқ
Dialogue: 0,1:12:09.25,1:12:11.80,1080,,0000,0000,0000,,Мэй-чан Мэй-чан
Dialogue: 0,1:12:52.12,1:12:54.10,1080,,0000,0000,0000,,Бұл тест
Dialogue: 0,1:12:54.10,1:12:55.91,1080,,0000,0000,0000,,Мен мұндайды ешқашан көрген емеспін.
Dialogue: 0,1:12:58.12,1:13:00.72,1080,,0000,0000,0000,,Альфамон болды.
Dialogue: 0,1:13:00.72,1:13:01.74,1080,,0000,0000,0000,,Альфамон?
Dialogue: 0,1:13:01.74,1:13:05.52,1080,,0000,0000,0000,,Өкінішке орай,деректерде басқа ақпарат жоқ.
Dialogue: 0,1:13:05.52,1:13:06.85,1080,,0000,0000,0000,,Бірдеңе істеу керек
Dialogue: 0,1:13:06.85,1:13:09.72,1080,,0000,0000,0000,,Коуширо-кун,Пальмонды және басқаларды шақыр.
Dialogue: 0,1:13:09.72,1:13:11.02,1080,,0000,0000,0000,,Түсінікті
Dialogue: 0,1:13:11.50,1:13:14.40,1080,,0000,0000,0000,,Мына бала бар.
Dialogue: 0,1:13:14.76,1:13:16.08,1080,,0000,0000,0000,,Мэй-чан
Dialogue: 0,1:13:17.70,1:13:19.42,1080,,0000,0000,0000,,Мэй-чан
Dialogue: 0,1:13:24.94,1:13:26.11,1080,,0000,0000,0000,,Мешин
Dialogue: 0,1:13:26.81,1:13:28.11,1080,,0000,0000,0000,,Мэй Чан
Dialogue: 0,1:13:31.03,1:13:32.90,1080,,0000,0000,0000,,Мешин жақсы болды.
Dialogue: 0,1:13:32.90,1:13:35.73,1080,,0000,0000,0000,,Жарайды,жарайды.
Dialogue: 0,1:14:03.32,1:14:04.71,1080,,0000,0000,0000,,Не?
Dialogue: 0,1:14:10.32,1:14:12.28,1080,,0000,0000,0000,,Не істеп жатырсың,Тайчи?
Dialogue: 0,1:14:40.32,1:14:41.82,1080,,0000,0000,0000,,Сендердің міндетің не,көпшілік?
Dialogue: 0,1:14:42.61,1:14:43.93,1080,,0000,0000,0000,,Ямато
Dialogue: 0,1:14:46.34,1:14:47.73,1080,,0000,0000,0000,,Габумон
Dialogue: 0,1:14:50.27,1:14:51.90,1080,,0000,0000,0000,,Біз бірдеңе істейміз
Dialogue: 0,1:14:51.90,1:14:53.64,1080,,0000,0000,0000,,Габумонға барайық
Dialogue: 0,1:15:03.97,1:15:05.15,1080,,0000,0000,0000,,Бердрамон
Dialogue: 0,1:15:04.22,1:15:05.58,1080,,0000,0000,0000,,Кабутеримон
Dialogue: 0,1:15:20.65,1:15:23.37,1080,,0000,0000,0000,,Тайчи Бұл Омегамон.
Dialogue: 0,1:15:30.23,1:15:31.92,1080,,0000,0000,0000,,Пальмон,сенің кезегің.
Dialogue: 0,1:15:31.92,1:15:32.91,1080,,0000,0000,0000,,Жарайды
Dialogue: 0,1:15:45.54,1:15:48.56,1080,,0000,0000,0000,,Пальмон эволюциясы
Dialogue: 0,1:16:09.63,1:16:11.28,1080,,0000,0000,0000,,Тогемон
Dialogue: 0,1:16:12.52,1:16:14.06,1080,,0000,0000,0000,,Біз де
Dialogue: 0,1:16:14.06,1:16:16.72,1080,,0000,0000,0000,,Тыңылдаған соққы
Dialogue: 0,1:16:36.51,1:16:37.98,1080,,0000,0000,0000,,Тайчи
Dialogue: 0,1:16:38.51,1:16:40.12,1080,,0000,0000,0000,,Моги мырзадан Цукидің қозғалысын бақылап отыруды сұраңызшы.
Dialogue: 0,1:16:41.77,1:16:43.06,1080,,0000,0000,0000,,Мэй-чан
Dialogue: 0,1:16:43.98,1:16:47.26,1080,,0000,0000,0000,,Мей-чан оны саған ешқашан бермейді
Dialogue: 0,1:17:03.09,1:17:04.94,1080,,0000,0000,0000,,Соғысуы керек
Dialogue: 0,1:17:15.34,1:17:16.92,1080,,0000,0000,0000,,Тайчи
Dialogue: 0,1:17:25.97,1:17:28.04,1080,,0000,0000,0000,,Ештеңе жасамасаңыз
Dialogue: 0,1:17:32.11,1:17:34.43,1080,,0000,0000,0000,,Ештеңе жасамасаңыз
Dialogue: 0,1:17:34.43,1:17:37.24,1080,,0000,0000,0000,,Ақырында, сіз жай ғана қашып бара жатырсыз,солай ма?
Dialogue: 0,1:17:43.14,1:17:46.24,1080,,0000,0000,0000,,Бұлай жалғаса берсе,бәрібір бәрі бұзылады.
Dialogue: 0,1:17:47.09,1:17:50.08,1080,,0000,0000,0000,,Қала ғана емес,барлығы да.
Dialogue: 0,1:17:52.48,1:17:54.92,1080,,0000,0000,0000,,Біз ғана қалдық
Dialogue: 0,1:18:43.49,1:18:45.66,1080,,0000,0000,0000,,Агумонға барайық
Dialogue: 0,1:18:45.66,1:18:47.74,1080,,0000,0000,0000,,Оны Тайчиге қалдырыңыз
Dialogue: 0,1:19:57.71,1:19:58.70,1080,,0000,0000,0000,,Омегамон
Dialogue: 0,1:19:58.70,1:20:00.12,1080,,0000,0000,0000,,Сіз мұны жасадыңыз.
Dialogue: 0,1:22:18.18,1:22:19.77,1080,,0000,0000,0000,,Сіз қашып кеттіңіз бе?
Dialogue: 0,1:22:20.96,1:22:22.04,1080,,0000,0000,0000,,Тайчи
Dialogue: 0,1:22:22.04,1:22:23.37,1080,,0000,0000,0000,,Ямато мырза
Dialogue: 0,1:22:35.04,1:22:37.41,1080,,0000,0000,0000,,Мочизуки мырза не іздеді?
Dialogue: 0,1:22:37.41,1:22:39.86,1080,,0000,0000,0000,,Иә,бұл бала.
Dialogue: 0,1:22:39.86,1:22:41.85,1080,,0000,0000,0000,,Сіздің есіміңіз Мэй Чан ба?
Dialogue: 0,1:22:41.85,1:22:44.78,1080,,0000,0000,0000,,Оның шын аты – Мейкомон.
Dialogue: 0,1:22:44.78,1:22:46.30,1080,,0000,0000,0000,,Мейкомон
Dialogue: 0,1:22:51.38,1:22:54.06,1080,,0000,0000,0000,,Бұл менің серіктесім Дигимон.
Dialogue: 0,1:22:57.68,1:23:00.87,1080,,0000,0000,0000,,Бұл сіздің де таңдаулы бала екеніңізді білдіреді.
Dialogue: 0,1:23:00.87,1:23:03.10,1080,,0000,0000,0000,,Иә,әр жағдайда
Dialogue: 0,1:23:03.70,1:23:04.98,1080,,0000,0000,0000,,Мен бақыттымын
Dialogue: 0,1:23:04.98,1:23:07.33,1080,,0000,0000,0000,,Кешіріңіз,айта алмадым.
Dialogue: 0,1:23:07.33,1:23:09.04,1080,,0000,0000,0000,,Сіздің достарыңыз көбірек.
Dialogue: 0,1:23:10.23,1:23:11.36,1080,,0000,0000,0000,,Мен бақыттымын
Dialogue: 0,1:23:11.36,1:23:16.78,1080,,0000,0000,0000,,Мэй-чан, сенің аман-есен болғаныңа қуаныштымын,себебі бәрі саған көмектесті.
Dialogue: 0,1:23:18.46,1:23:19.77,1080,,0000,0000,0000,,Біртіндеп
Dialogue: 0,1:23:19.77,1:23:21.08,1080,,0000,0000,0000,,Біртіндеп
Dialogue: 0,1:23:21.87,1:23:23.20,1080,,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,1:23:25.12,1:23:28.40,1080,,0000,0000,0000,,Рахмет дегенді білдіреді.
Dialogue: 0,1:27:48.86,1:27:50.35,1080,,0000,0000,0000,,Сіз оны жарып жібердіңіз бе?
Dialogue: 0,1:27:55.31,1:27:58.53,1080,,0000,0000,0000,,Мен қашпағанымды мойындаймын.
Dialogue: 0,0:00:43.10,0:00:45.46,,,0000,0000,0000,,Демиург: Грек тілінен аударғанда «қолөнерші/қолөнерші» дегенді білдіреді. Платон физикалық дүниенің бар екенін түсіндіру үшін мифтік әңгіме жазды. Бұл сөз бен ұғым гностицизмде қолданылды, ал Демиург деген атау материалдық дүниені жаратушы,яғни «жаратушы» дегенді білдіру үшін қолданылды.
Dialogue: 0,0:00:45.46,0:00:48.12,,,0000,0000,0000,,Идея: «Көргені, білгені, пішіннің мәні». Платон философиясында уақыт пен кеңістіктен асып түсетін физикалық емес, абсолютті, мәңгілік шындық. Ол сезімдік дүниедегі жеке тұлғаның прототипі деп,таза ұтымды ой арқылы тануға болады.
Dialogue: 0,0:01:00.66,0:01:05.64,,,0000,0000,0000,,Бұл субтитр Yuu✾Гүл тілі және Ханамару субтитр тобы✾Бірлескен өндіріс
Dialogue: 0,0:01:00.66,0:01:05.64,,,0000,0000,0000,,\h： ： ♂（BD） \h：   \h\h\h\h ♂ \h： ♂ \h： ♂
