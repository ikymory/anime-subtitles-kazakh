Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.20,0:00:04.24,Default,,0,0,0,,Адамдар бір нәрсені үнемі тұтынбай өмір сүре алмайды. →
Dialogue: 0,0:00:04.24,0:00:07.27,Default,,0,0,0,,Мұндай күнәһар тіршілік екенін біле отырып→
Dialogue: 0,0:00:07.27,0:00:10.30,Default,,0,0,0,,Егер аман қалу керек болса→
Dialogue: 0,0:00:10.30,0:00:12.32,Default,,0,0,0,,Кем дегенде біреу үшін. →
Dialogue: 0,0:00:12.32,0:00:15.35,Default,,0,0,0,,Бұл табиғи ойлау тәсілі емес пе?
Dialogue: 0,0:00:15.35,0:00:20.40,Default,,0,0,0,,Дұрыс. Бірақ оны іс жүзінде қолдану →
Dialogue: 0,0:00:20.40,0:00:23.43,Default,,0,0,0,,Бұл оңай болмайды деп ойлаймын.
Dialogue: 0,0:00:23.43,0:00:27.47,Default,,0,0,0,,Әр адамның басқаларға деген сезімі бар, солай ма? →
Dialogue: 0,0:00:27.47,0:00:29.49,Default,,0,0,0,,Біраз бұрын тренд сияқты→
Dialogue: 0,0:00:29.49,0:00:33.53,Default,,0,0,0,,Жалғасатын анонимді қайырымдылық тізбегі болған жоқ па?
Dialogue: 0,0:00:33.53,0:00:37.57,Default,,0,0,0,,Қайырымдылық жасау кейде оған жоғарыдан қарау сияқты болып көрінеді →
Dialogue: 0,0:00:37.57,0:00:40.60,Default,,0,0,0,,Мен өз сезімімді ашық айта алмаймын. 《Исао Нобуноза, 29 жаста》→
Dialogue: 0,0:00:40.60,0:00:44.64,Default,,0,0,0,,《Ұрыс тарихын 57 шайқас, 56 жеңіс және 1 жеңіліспен есептеңіз》→
Dialogue: 0,0:00:44.64,0:00:48.68,Default,,0,0,0,,《Ағымдағы жеке активтер 9,87 млрд иен》→
Dialogue: 0,0:00:48.68,0:00:51.71,Default,,0,0,0,,《Мәміле келесі бейсенбіге жоспарланған》→
Dialogue: 0,0:00:51.71,0:00:55.75,Default,,0,0,0,,《Қарсылас Кимимаро Йога》
Dialogue: 0,0:00:55.75,0:00:57.10,Default,,0,0,0,,Сіз өзіңіздің болашағыңызға инвестиция жасайсыз. →
Dialogue: 0,0:00:57.10,0:01:01.10,Default,,0,0,0,,Менің ойымша, бұл туралы осылай ойлану керек.
Dialogue: 0,0:01:03.16,0:01:06.19,Default,,0,0,0,,《Хехе. Сол баламен》
Dialogue: 0,0:01:06.19,0:01:16.19,Default,,0,0,0,,Сен
Dialogue: 0,0:02:48.11,0:02:51.14,Default,,0,0,0,,Хаа!
Dialogue: 0,0:02:51.14,0:02:53.16,Default,,0,0,0,,Шиншу Дәмді іздеңіз!
Dialogue: 0,0:02:53.16,0:02:55.16,Default,,0,0,0,,ＯＫ！
Dialogue: 0,0:03:01.24,0:03:04.24,Default,,0,0,0,,Қазір! (Машу) Эй!
Dialogue: 0,0:03:10.33,0:03:12.35,Default,,0,0,0,,Мен Әсетті жеңе алдым.
Dialogue: 0,0:03:12.35,0:03:14.37,Default,,0,0,0,,Ақыр соңында, мен ас табуым керек. Бұл дұрыс.
Dialogue: 0,0:03:14.37,0:03:16.39,Default,,0,0,0,,Пайдасыз нәрсе!
Dialogue: 0,0:03:16.39,0:03:19.42,Default,,0,0,0,,Міне болды! ! (Бару) Ах.... О, жоқ...
Dialogue: 0,0:03:19.42,0:03:21.44,Default,,0,0,0,,「ＤＩＲＥＣＴ」！
Dialogue: 0,0:03:21.44,0:03:23.46,Default,,0,0,0,,Түсіндім! Өзіңізге ұнайтын нәрсені жасаңыз!
Dialogue: 0,0:03:23.46,0:03:25.14,Default,,0,0,0,,Сіз тек пайдаланатын нәрсені аласыз.
Dialogue: 0,0:03:25.14,0:03:27.50,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:27.50,0:03:29.52,Default,,0,0,0,,「ＣＬＯＳＩＮＧ」！ 「ＹＯＵ ＨＡＶＥ ＧＡＩＮ」！
Dialogue: 0,0:03:29.52,0:03:31.52,Default,,0,0,0,,Сіз мұны істедіңіз. аа.
Dialogue: 0,0:03:34.57,0:03:36.57,Default,,0,0,0,,Не?
Dialogue: 0,0:03:40.80,0:03:45.01,Default,,0,0,0,,Мен оны шығару үшін істеп жатырмын.
Dialogue: 0,0:03:45.01,0:03:47.01,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:03:49.05,0:03:51.07,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:03:51.07,0:03:53.09,Default,,0,0,0,,Бірақ бүгін көңіліңіз толқып тұр ма?
Dialogue: 0,0:03:53.09,0:03:57.09,Default,,0,0,0,,Мен мұны жағымсыз шайқас деп ойладым.
Dialogue: 0,0:04:02.18,0:04:04.18,Default,,0,0,0,,Жарайды, солай.
Dialogue: 0,0:04:06.22,0:04:10.26,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:04:10.26,0:04:13.29,Default,,0,0,0,,Мен мұндай нәрселерді кейде ұмытып қаламын.
Dialogue: 0,0:04:13.29,0:04:15.31,Default,,0,0,0,,Егер бүгінгі аю актив болса→
Dialogue: 0,0:04:15.31,0:04:17.33,Default,,0,0,0,,Менің ойымша, бұл басқаша.
Dialogue: 0,0:04:17.33,0:04:19.35,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:04:19.35,0:04:21.37,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:04:21.37,0:04:24.37,Default,,0,0,0,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:04:37.53,0:04:40.53,Default,,0,0,0,,Ah, ah….
Dialogue: 0,0:04:42.92,0:04:45.95,Default,,0,0,0,,Уау! не? иә?
Dialogue: 0,0:04:45.95,0:04:47.97,Default,,0,0,0,,Мен оларға қарайтын адамдар туралы.
Dialogue: 0,0:04:47.97,0:04:51.00,Default,,0,0,0,,Ары қарай қарамаңыз.
Dialogue: 0,0:04:51.00,0:04:56.05,Default,,0,0,0,,Сіз активтердің кірістіліктің болашағын бейнелейтінін айттыңыз.
Dialogue: 0,0:04:56.05,0:04:58.07,Default,,0,0,0,,Йога-кун, бұл сен бе? тістері?
Dialogue: 0,0:04:58.07,0:05:01.10,Default,,0,0,0,,Сіздің активтеріңіз?
Dialogue: 0,0:05:01.10,0:05:03.12,Default,,0,0,0,,кесе кеспе дәмді ме? Иә.
Dialogue: 0,0:05:03.12,0:05:05.14,Default,,0,0,0,,Иә? Бұл сүйкімді.
Dialogue: 0,0:05:05.14,0:05:08.17,Default,,0,0,0,,Қисық бұрыштары өте сүйкімді.
Dialogue: 0,0:05:08.17,0:05:10.19,Default,,0,0,0,,Бұл. аа.
Dialogue: 0,0:05:10.19,0:05:13.22,Default,,0,0,0,,Нобуноза. Мен сізбен келесі келісімде сәйкес боламын. →
Dialogue: 0,0:05:13.22,0:05:16.25,Default,,0,0,0,,Олар күшті дейді. Міне бітті.
Dialogue: 0,0:05:16.25,0:05:20.29,Default,,0,0,0,,Ей, ренжіме, мені тыңдасаң болғаны.
Dialogue: 0,0:05:20.29,0:05:23.32,Default,,0,0,0,,Мәміле жасаудың жолы бар екенін білесіз.
Dialogue: 0,0:05:23.32,0:05:27.36,Default,,0,0,0,,Бұл банкке белгілі бір соманы аударуға болады деп естідім...
Dialogue: 0,0:05:27.36,0:05:29.38,Default,,0,0,0,,Мен соманы білмеймін.
Dialogue: 0,0:05:29.38,0:05:31.40,Default,,0,0,0,,Меншікті активтердің жартысы. сондықтан! ?
Dialogue: 0,0:05:31.40,0:05:35.44,Default,,0,0,0,,Мен бұл жауапкершілікті өз мойныма аламын ба?
Dialogue: 0,0:05:35.44,0:05:37.46,Default,,0,0,0,,Бұл нені білдіреді? Сондықтан →
Dialogue: 0,0:05:37.46,0:05:39.48,Default,,0,0,0,,Неліктен мәміле жасамайсың?
Dialogue: 0,0:05:39.48,0:05:42.86,Default,,0,0,0,,Эй, сәл күте тұрыңыз! Олай болса, оны өзіңіз өткізіңіз.
Dialogue: 0,0:05:42.86,0:05:45.89,Default,,0,0,0,,Менің активтерімнің жартысы өте тығыз. →
Dialogue: 0,0:05:45.89,0:05:50.89,Default,,0,0,0,,Бірақ сіздің активтеріңіз болса, төлеу мүмкін емес сома емес.
Dialogue: 0,0:05:52.96,0:05:54.98,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:05:54.98,0:05:58.01,Default,,0,0,0,,Мен жай ғана тынышталып, сөйлескім келеді.
Dialogue: 0,0:05:58.01,0:06:01.04,Default,,0,0,0,,Сіз бұрын не айттыңыз: Сіз тіпті менің активтерімді қарадыңыз ба?
Dialogue: 0,0:06:01.04,0:06:05.08,Default,,0,0,0,,Сіз жалғыз емессіз. Әр жолы басқа адам → зерттейді
Dialogue: 0,0:06:05.08,0:06:08.11,Default,,0,0,0,,Мен әрқашан рұқсат сұраймын.
Dialogue: 0,0:06:08.11,0:06:10.13,Default,,0,0,0,,Мен оны ешқашан ешкім қабылдаған емеспін.
Dialogue: 0,0:06:10.13,0:06:12.15,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:12.15,0:06:15.18,Default,,0,0,0,,Мәміле қаншалықты теңдестірілген болса да, →
Dialogue: 0,0:06:15.18,0:06:17.20,Default,,0,0,0,,Шындыққа әсер ету мүмкін емес.
Dialogue: 0,0:06:17.20,0:06:20.23,Default,,0,0,0,,Олай болса, мұны істемеген дұрыс деп ойламайсың ба? →
Dialogue: 0,0:06:20.23,0:06:22.25,Default,,0,0,0,,Маған бірден жауап беруімді сұрамаңыз. →
Dialogue: 0,0:06:22.25,0:06:24.27,Default,,0,0,0,,Қаласаңыз, маған хабарласыңыз. →
Dialogue: 0,0:06:24.27,0:06:26.27,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:06:29.32,0:06:31.34,Default,,0,0,0,,Жаман сезінеді. Жақсы сезінеді.
Dialogue: 0,0:06:31.34,0:06:33.36,Default,,0,0,0,,Бірақ ол жігіт. не болды?
Dialogue: 0,0:06:33.36,0:06:37.40,Default,,0,0,0,,Жоқ, мен оны бір жерден көргендей болдым...
Dialogue: 0,0:06:37.40,0:06:39.42,Default,,0,0,0,,Ах! !
Dialogue: 0,0:06:39.42,0:06:42.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:43.80,0:06:47.84,Default,,0,0,0,,《Оның NPO корпорациясының өкілі ретіндегі қызметі назар аудартады→
Dialogue: 0,0:06:47.84,0:06:52.89,Default,,0,0,0,,Дамушы елдерге вакцина донорлығынан бастап кең ауқымды бастамалар》
Dialogue: 0,0:06:52.89,0:06:55.92,Default,,0,0,0,,《Қатты тақырыптың суретінен ерекшеленетін жеңіл позиция→
Dialogue: 0,0:06:55.92,0:06:58.95,Default,,0,0,0,,Аналық инстинктіңізді қытықтайтын сымбатты жігіт →
Dialogue: 0,0:06:58.95,0:07:02.99,Default,,0,0,0,,Кейбір адамдар оны ерікті ханзада деп атайды.
Dialogue: 0,0:07:02.99,0:07:05.99,Default,,0,0,0,,Бұл өте нашар сезінеді.
Dialogue: 0,0:07:10.06,0:07:13.09,Default,,0,0,0,,Йога-кун? Йога: Кимимаро-кун, солай ма?
Dialogue: 0,0:07:13.09,0:07:15.11,Default,,0,0,0,,Иә? Тезірек атқа мін! →
Dialogue: 0,0:07:15.11,0:07:17.79,Default,,0,0,0,,Сіздің апаңыз. иә?
Dialogue: 0,0:07:17.79,0:07:19.15,Default,,0,0,0,,Ішінде толығырақ. тез!
Dialogue: 0,0:07:19.15,0:07:21.17,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:07:21.17,0:07:23.19,Default,,0,0,0,,Мм... (Құлыптау дыбысы)
Dialogue: 0,0:07:23.19,0:07:26.22,Default,,0,0,0,,Сәлем! «Кача» дегеніміз не? ? «Кача»! ?
Dialogue: 0,0:07:26.22,0:07:28.24,Default,,0,0,0,,Кешіріңіз. Мен сені алдадым.
Dialogue: 0,0:07:28.24,0:07:30.26,Default,,0,0,0,,Әй... Мен сияқты төменгі сыныпты алып қашсаң да→
Dialogue: 0,0:07:30.26,0:07:32.28,Default,,0,0,0,,Бұл жақсы нәрсе емес.
Dialogue: 0,0:07:32.28,0:07:34.30,Default,,0,0,0,,Әңгіме біте салысымен мен үйге қайтамын. →
Dialogue: 0,0:07:34.30,0:07:36.32,Default,,0,0,0,,Барғыңыз келетін жер болса, маған хабарлаңыз.
Dialogue: 0,0:07:36.32,0:07:39.35,Default,,0,0,0,,Қаржы аймағында мүмкін емес.
Dialogue: 0,0:07:39.35,0:07:42.71,Default,,0,0,0,,Сіз ше? Мен де тағамдардың бірі болдым.
Dialogue: 0,0:07:42.71,0:07:44.73,Default,,0,0,0,,Мен қаржы аймағын зерттеп жатырмын.
Dialogue: 0,0:07:44.73,0:07:48.77,Default,,0,0,0,,Менен сұрасаң да, мен де естігім келеді.
Dialogue: 0,0:07:48.77,0:07:52.77,Default,,0,0,0,,Бұл жақсы. Мен жай ғана сөйлескім келеді.
Dialogue: 0,0:07:53.83,0:07:56.86,Default,,0,0,0,,Соичиро Микуни сізді қызықтырды→
Dialogue: 0,0:07:56.86,0:08:00.90,Default,,0,0,0,,Шынымды айтсам, мен оны қалай түсіндіруге болатынын білмеймін.
Dialogue: 0,0:08:00.90,0:08:04.94,Default,,0,0,0,,Қаржы ауданында екі түрлі адамдар бар. →
Dialogue: 0,0:08:04.94,0:08:07.97,Default,,0,0,0,,Жұтылғандар мен жұтпайтындар.
Dialogue: 0,0:08:07.97,0:08:09.99,Default,,0,0,0,,Сізді әлі жұтып қойған жоқсыз. →
Dialogue: 0,0:08:09.99,0:08:14.03,Default,,0,0,0,,Менің де ниетім осы. Және де Микуни.
Dialogue: 0,0:08:14.03,0:08:16.05,Default,,0,0,0,,Мен соншама терең бойлап кетсем де→
Dialogue: 0,0:08:16.05,0:08:20.09,Default,,0,0,0,,Керісінше, мен оны қалай белсенді қолдана аламын деп ойлаймын. →
Dialogue: 0,0:08:20.09,0:08:23.12,Default,,0,0,0,,Бірақ бұл қауіпті құмар ойын. Бәс тігу?
Dialogue: 0,0:08:23.12,0:08:27.16,Default,,0,0,0,,Ағымдағы экономиканы тұрақтандыру мақсатында → деді
Dialogue: 0,0:08:27.16,0:08:31.20,Default,,0,0,0,,Сіз болашақты жеу дұрыс деп ойлауыңыз керек.
Dialogue: 0,0:08:31.20,0:08:35.24,Default,,0,0,0,,Мен білмеймін, ол саналы түрде қаншалықты алысқа барады.
Dialogue: 0,0:08:35.24,0:08:39.28,Default,,0,0,0,,Осындай ақыл-ойы мен стратегиясы бар адам →
Dialogue: 0,0:08:39.28,0:08:42.64,Default,,0,0,0,,Сіз мұны байқамағаныңызға сене алар емеспін.
Dialogue: 0,0:08:42.64,0:08:44.66,Default,,0,0,0,,Сіздің айтып отырғаныңыздың мағынасы жоқ.
Dialogue: 0,0:08:44.66,0:08:48.70,Default,,0,0,0,,Қысқасы, қаржы ауданы жойылмаса қауіпті.
Dialogue: 0,0:08:48.70,0:08:53.75,Default,,0,0,0,,Бұл елдің немесе одан да үлкен болашағы. →
Dialogue: 0,0:08:53.75,0:08:57.79,Default,,0,0,0,,Мен сіздің ынтымақтастықты қалаймын.
Dialogue: 0,0:08:57.79,0:09:00.83,Default,,0,0,0,,Ынтымақтастық? Шынымен де қаржылық ауданды жою мүмкін емес пе?
Dialogue: 0,0:09:00.83,0:09:03.86,Default,,0,0,0,,Сол қаланы құрайтын жүйелер мен топтар →
Dialogue: 0,0:09:03.86,0:09:05.88,Default,,0,0,0,,Немесе, бір-бірлеп жаншып алсаң.
Dialogue: 0,0:09:05.88,0:09:07.90,Default,,0,0,0,,Міне.
Dialogue: 0,0:09:07.90,0:09:11.94,Default,,0,0,0,,Иә, Жұлдыздық гильдия сияқты. Күте тұрыңыз!
Dialogue: 0,0:09:11.94,0:09:14.97,Default,,0,0,0,,Гильдия мәмілелердің әсерін барынша азайтады, солай ма?
Dialogue: 0,0:09:14.97,0:09:16.99,Default,,0,0,0,,Жақында Basho Pharmaceutical компаниясының банкроттық жанжалы.
Dialogue: 0,0:09:16.99,0:09:20.02,Default,,0,0,0,,Әрине, ауқатты адамдар арасындағы мәжбүрлі мәмілелерге байланысты→
Dialogue: 0,0:09:20.02,0:09:22.04,Default,,0,0,0,,Келтірілген қарызды өндіріп алу →
Dialogue: 0,0:09:22.04,0:09:25.74,Default,,0,0,0,,Банкроттық салдарынан болған шығындардың алдын алу.
Dialogue: 0,0:09:25.74,0:09:28.10,Default,,0,0,0,,Ол адам болашақты құртуға тырысады...
Dialogue: 0,0:09:28.10,0:09:31.13,Default,,0,0,0,,Алайда бұл уақытша шара ғана. →
Dialogue: 0,0:09:31.13,0:09:34.16,Default,,0,0,0,,Микуни 10 000 адамды құтқарды, бірақ→
Dialogue: 0,0:09:34.16,0:09:37.19,Default,,0,0,0,,Осы мақсатқа орасан зор Мидас ақшасы салынды→
Dialogue: 0,0:09:37.19,0:09:40.22,Default,,0,0,0,,Нәтижесінде болашақтың қаншасы алынады→
Dialogue: 0,0:09:40.22,0:09:42.58,Default,,0,0,0,,Ешкім білмейді.
Dialogue: 0,0:09:42.58,0:09:45.61,Default,,0,0,0,,Мен қазірден бастап түсінбейтін нәрселер көп.
Dialogue: 0,0:09:45.61,0:09:48.61,Default,,0,0,0,,Сонда сіз ше? Апыр-ай!
Dialogue: 0,0:09:50.66,0:09:53.69,Default,,0,0,0,,Эй...
Dialogue: 0,0:09:53.69,0:09:56.72,Default,,0,0,0,,Өзіңіз туралы не ойлайсыз? О... мен?
Dialogue: 0,0:09:56.72,0:09:58.74,Default,,0,0,0,,Мен бұл гильдияға енді ғана қосылдым.
Dialogue: 0,0:09:58.74,0:10:01.77,Default,,0,0,0,,Олай болса... бірінші кезекте мұны маған айтқаныңыз дұрыс па?
Dialogue: 0,0:10:01.77,0:10:03.79,Default,,0,0,0,,Мен мұны жақсы деп ойладым. хе! ?
Dialogue: 0,0:10:03.79,0:10:05.47,Default,,0,0,0,,Сіз әлі →
Dialogue: 0,0:10:05.47,0:10:07.47,Default,,0,0,0,,Ақшадан басқа нәрселерді ойлайтын көздері бар.
Dialogue: 0,0:10:15.29,0:10:18.32,Default,,0,0,0,,Мұқият ойлан. Сіз кез келген уақытта жауап бере аласыз.
Dialogue: 0,0:10:18.32,0:10:21.35,Default,,0,0,0,,Бұл тағы да үй тапсырмасы ма? үй жұмысы?
Dialogue: 0,0:10:21.35,0:10:24.38,Default,,0,0,0,,Дәл осындай жағдай менің келесі серіктесіммен де болды.
Dialogue: 0,0:10:24.38,0:10:26.40,Default,,0,0,0,,Исао Нобуноза. иә?
Dialogue: 0,0:10:26.40,0:10:29.43,Default,,0,0,0,,Ол да Микунидің құрметтейтін адамы. →
Dialogue: 0,0:10:29.43,0:10:33.47,Default,,0,0,0,,Мені де Старлинг гильдиясына қосылуға шақырды, бірақ мен бас тарттым.
Dialogue: 0,0:10:33.47,0:10:36.50,Default,,0,0,0,,Білесің бе, мен қанша ойласам да, екеуміз бірдейміз.
Dialogue: 0,0:10:36.50,0:10:42.50,Default,,0,0,0,,Мен кімге сенемін, сіз немесе кенеттен пайда болған Микуни мырза?
Dialogue: 0,0:10:44.58,0:10:46.60,Default,,0,0,0,,Не? не? Мен сені бақылап жүрмін.
Dialogue: 0,0:10:46.60,0:10:48.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:51.65,0:10:53.65,Default,,0,0,0,,Жүгір! !
Dialogue: 0,0:11:03.77,0:11:05.79,Default,,0,0,0,,Сіз тағы да осындай нәрсені пайдаланасыз ба?
Dialogue: 0,0:11:05.79,0:11:06.81,Default,,0,0,0,,Мен үйреніп қалған шығармын.
Dialogue: 0,0:11:06.81,0:11:09.84,Default,,0,0,0,,Ал, осы көлікті пайдаланатындар→
Dialogue: 0,0:11:09.84,0:11:13.20,Default,,0,0,0,,Өйткені бізде қиындықтар жиі кездеседі.
Dialogue: 0,0:11:13.20,0:11:15.22,Default,,0,0,0,,Ақаулық.
Dialogue: 0,0:11:15.22,0:11:17.24,Default,,0,0,0,,Әй... Мен де.
Dialogue: 0,0:11:17.24,0:11:19.26,Default,,0,0,0,,Ах... →
Dialogue: 0,0:11:19.26,0:11:21.28,Default,,0,0,0,,Көлік туралы не істеуім керек?
Dialogue: 0,0:11:21.28,0:11:23.30,Default,,0,0,0,,Әр адамның қазіргі көңіл-күйін ескере отырып→
Dialogue: 0,0:11:23.30,0:11:27.34,Default,,0,0,0,,Біреу ертеңгі күнді ойла деген кезде→
Dialogue: 0,0:11:27.34,0:11:30.37,Default,,0,0,0,,Сіз мені ақымақ деп ойлауыңыз мүмкін. →
Dialogue: 0,0:11:30.37,0:11:33.40,Default,,0,0,0,,Бірақ мені қызықтыратыны – қазіргі уақытта қалай өмір сүру→
Dialogue: 0,0:11:33.40,0:11:36.43,Default,,0,0,0,,Бұл туралы ойлаудың өзі сізге қуат бермейді.
Dialogue: 0,0:11:36.43,0:11:38.43,Default,,0,0,0,,Сіз бұлай сезінбейсіз бе?
Dialogue: 0,0:11:41.48,0:11:43.50,Default,,0,0,0,,《Норинозадан да сұрау керек.》
Dialogue: 0,0:11:43.50,0:11:45.52,Default,,0,0,0,,《Не? 》 《Ол сондай-ақ қаржылық ауданмен де қарым-қатынаста →
Dialogue: 0,0:11:45.52,0:11:49.52,Default,,0,0,0,,Мен жағдай қалай болуы керек деп ойлайтындардың бірімін.
Dialogue: 0,0:11:49.91,0:11:53.60,Default,,0,0,0,,Сіз жол бойы келдіңіз. Сен ашсың ба?
Dialogue: 0,0:11:53.60,0:11:55.62,Default,,0,0,0,,Әлі жоқ.
Dialogue: 0,0:11:55.62,0:11:58.65,Default,,0,0,0,,Мен жай ғана әңгіме тыңдағым келді. (Нобуназа) Жарайды. →
Dialogue: 0,0:11:58.65,0:12:00.67,Default,,0,0,0,,Мен кеңсеге қайтып бара жатырмын, бітті.
Dialogue: 0,0:12:00.67,0:12:02.69,Default,,0,0,0,,Әрине, қазір→
Dialogue: 0,0:12:02.69,0:12:04.71,Default,,0,0,0,,Экономиканың жақсы жүріп жатқаны айтылады.
Dialogue: 0,0:12:04.71,0:12:07.74,Default,,0,0,0,,Дегенмен, нақты жағдай біз бұрын көргендей. →
Dialogue: 0,0:12:07.74,0:12:09.76,Default,,0,0,0,,Экономикалық диспропорция кеңейе береді. →
Dialogue: 0,0:12:09.76,0:12:12.12,Default,,0,0,0,,Бұл елге сол дүниеден алтынның көп мөлшері ағып жатыр →
Dialogue: 0,0:12:12.12,0:12:14.14,Default,,0,0,0,,Тепе-теңдікті жоғалту.
Dialogue: 0,0:12:14.14,0:12:17.17,Default,,0,0,0,,Старлинг гильдиясының себебі ме?
Dialogue: 0,0:12:17.17,0:12:19.19,Default,,0,0,0,,Мәмілені ішкі бақылау →
Dialogue: 0,0:12:19.19,0:12:22.22,Default,,0,0,0,,Шындыққа әсерін барынша азайтыңыз. →
Dialogue: 0,0:12:22.22,0:12:23.91,Default,,0,0,0,,Бірақ олар қозғалған сайын →
Dialogue: 0,0:12:23.91,0:12:27.27,Default,,0,0,0,,Әлем барған сайын тұйықталып бара жатқандай сезінемін.
Dialogue: 0,0:12:27.27,0:12:30.30,Default,,0,0,0,,Егер қалғаны мүмкіншіліктері жоғалған болашақ болса→
Dialogue: 0,0:12:30.30,0:12:32.32,Default,,0,0,0,,Қазіргі уақытта ешқандай мағына жоқ.
Dialogue: 0,0:12:32.32,0:12:36.36,Default,,0,0,0,,Сіз бұл қаланың болашақ кепілі ретінде құрылғанын естідіңіз бе?
Dialogue: 0,0:12:36.36,0:12:39.36,Default,,0,0,0,,Мен мұның әсерін өз көзіммен көрдім.
Dialogue: 0,0:12:41.41,0:12:44.44,Default,,0,0,0,,Иә, мен де.
Dialogue: 0,0:12:44.44,0:12:47.47,Default,,0,0,0,,Мен бір нәрсені көргім келеді. →
Dialogue: 0,0:12:47.47,0:12:49.49,Default,,0,0,0,,Вакциналарды жеткізетін елдер. →
Dialogue: 0,0:12:49.49,0:12:52.52,Default,,0,0,0,,Бұл балалардың бізге жыл сайын жіберетін суреттері. →
Dialogue: 0,0:12:52.52,0:12:55.55,Default,,0,0,0,,Өйткені менің қайтаратын ештеңем жоқ.
Dialogue: 0,0:12:55.55,0:12:58.58,Default,,0,0,0,,күрсіну. (Нобуноза) Суреттің тақырыбы бір. →
Dialogue: 0,0:12:58.58,0:13:01.61,Default,,0,0,0,,Оның не екенін білесің бе? иә? Ол құлап жатқан жоқ па?
Dialogue: 0,0:13:01.61,0:13:03.63,Default,,0,0,0,,Қала немесе адам.
Dialogue: 0,0:13:03.63,0:13:08.68,Default,,0,0,0,,Бұл болашақ сияқты. Кедей елім қалай дамыды. →
Dialogue: 0,0:13:08.68,0:13:10.70,Default,,0,0,0,,Болашақта кім болғың келеді.
Dialogue: 0,0:13:10.70,0:13:12.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:13:12.06,0:13:14.08,Default,,0,0,0,,Мен бір рет мәміледе жеңілдім. →
Dialogue: 0,0:13:14.08,0:13:17.11,Default,,0,0,0,,Бұл соншалықты үлкен шығын емес еді→
Dialogue: 0,0:13:17.11,0:13:21.15,Default,,0,0,0,,Шығын - бұл шығын. Содан кейін мен оны қайтып келгеннен кейін түсіндім. →
Dialogue: 0,0:13:21.15,0:13:23.17,Default,,0,0,0,,Мұнда берілген кейбір суреттер→
Dialogue: 0,0:13:23.17,0:13:26.20,Default,,0,0,0,,Басқа суретке ауыстырылғанымен.
Dialogue: 0,0:13:26.20,0:13:28.22,Default,,0,0,0,,Міне. (Нобуноза) Ол жоғалып кетті. →
Dialogue: 0,0:13:28.22,0:13:31.22,Default,,0,0,0,,Мен елестеткен болашақпен бірге.
Dialogue: 0,0:13:35.29,0:13:37.31,Default,,0,0,0,,《Егер сіз мәміле жасасаңыз, оны жасауыңыз керек→
Dialogue: 0,0:13:37.31,0:13:41.35,Default,,0,0,0,,Біреуіне қатысты мүмкіндіктердің бірі жоғалады》→
Dialogue: 0,0:13:41.35,0:13:43.37,Default,,0,0,0,,《Егер оны болдырмау мүмкін болса, бұл жақсы》→
Dialogue: 0,0:13:43.37,0:13:46.40,Default,,0,0,0,,《Бірақ мұны істеу керек болғанда→
Dialogue: 0,0:13:46.40,0:13:49.43,Default,,0,0,0,,Сіз жасай алатын жалғыз нәрсе - → мүмкіндіктерінің бірін жою
Dialogue: 0,0:13:49.43,0:13:53.47,Default,,0,0,0,,Басқа мүмкіндіктермен өтеу. болды》
Dialogue: 0,0:13:53.47,0:13:55.49,Default,,0,0,0,,Кешіріңіз. Кешіріңіз. Ол ұзарып барады.
Dialogue: 0,0:13:55.49,0:13:57.51,Default,,0,0,0,,Сіз тағы да сақтандыру туралы айтып отырсыз ба?
Dialogue: 0,0:13:57.51,0:14:00.54,Default,,0,0,0,,Шулы. Келісімшарттан бас тартамын десең.
Dialogue: 0,0:14:00.54,0:14:03.57,Default,,0,0,0,,Келісімшартты бұзған дұрыс па?
Dialogue: 0,0:14:03.57,0:14:06.60,Default,,0,0,0,,Бұл ұзақ мерзімді перспективада шығын болуы мүмкін. →
Dialogue: 0,0:14:06.60,0:14:08.62,Default,,0,0,0,,Мен оны жас кезімнен ойнаймын. →
Dialogue: 0,0:14:08.62,0:14:11.65,Default,,0,0,0,,Бірақ соңғы кездері қиын болды→
Dialogue: 0,0:14:11.65,0:14:14.01,Default,,0,0,0,,Шынымды айтсам, мен дереу ақша алғым келеді. →
Dialogue: 0,0:14:14.01,0:14:18.05,Default,,0,0,0,,Кәрілік туралы әлі де уайымдайтыныма қуаныштымын. →
Dialogue: 0,0:14:18.05,0:14:23.10,Default,,0,0,0,,Осы жасымда да мен бүгін мен ертеңді ғана ойлаймын.
Dialogue: 0,0:14:23.10,0:14:25.12,Default,,0,0,0,,Бұл аянышты.
Dialogue: 0,0:14:25.12,0:14:27.14,Default,,0,0,0,,Бұл жақсы емес пе? Бұл оңай.
Dialogue: 0,0:14:27.14,0:14:29.16,Default,,0,0,0,,Өйткені сіз басынан бастап шешім қабылдап қойғансыз, солай ма?
Dialogue: 0,0:14:29.16,0:14:31.18,Default,,0,0,0,,Қалай болғанда да, сізге қараңыз ...
Dialogue: 0,0:14:31.18,0:14:35.22,Default,,0,0,0,,Сіздің көңіл-күйіңіз қандай? Мен төбелесуді тоқтатсам да, маған ештеңе ұнамайды.
Dialogue: 0,0:14:35.22,0:14:38.25,Default,,0,0,0,,Бірақ бұл адам мен ойлағандай емес пе?
Dialogue: 0,0:14:38.25,0:14:40.25,Default,,0,0,0,,Жақсы сезінеді.
Dialogue: 0,0:14:43.30,0:14:45.32,Default,,0,0,0,,Сіз маған ешқашан олай қарамайсыз, солай ма? →
Dialogue: 0,0:14:45.32,0:14:48.35,Default,,0,0,0,,Мені көремін деп келмедің бе?
Dialogue: 0,0:14:48.35,0:14:50.03,Default,,0,0,0,,Міне.
Dialogue: 0,0:14:50.03,0:14:54.41,Default,,0,0,0,,Мен сенімен кездескім келетін сияқты. Мен сенімен кездескім келмейді деп ойлаймын. →
Dialogue: 0,0:14:54.41,0:14:57.44,Default,,0,0,0,,Мәміледен бір күн бұрын кездесу болғаны жақсы.
Dialogue: 0,0:14:57.44,0:14:59.12,Default,,0,0,0,,Де... Дата деген осындай.
Dialogue: 0,0:14:59.12,0:15:01.48,Default,,0,0,0,,Біз кездесуге келдік.
Dialogue: 0,0:15:01.48,0:15:03.48,Default,,0,0,0,,Иә? Күн дегеніміз не?
Dialogue: 0,0:15:03.85,0:15:06.53,Default,,0,0,0,,Мен бұл мәміле туралы айтып отырмын.
Dialogue: 0,0:15:06.53,0:15:09.56,Default,,0,0,0,,Сіз билет сұрадыңыз ба? →
Dialogue: 0,0:15:09.56,0:15:12.93,Default,,0,0,0,,Өйткені бұл әрқашан болады. Сонымен, сіз не істемексіз?
Dialogue: 0,0:15:12.93,0:15:14.95,Default,,0,0,0,,Мен абдырап қалдым.
Dialogue: 0,0:15:14.95,0:15:17.98,Default,,0,0,0,,Нобуноза бірде менен де солай істеуімді өтінді. →
Dialogue: 0,0:15:17.98,0:15:22.02,Default,,0,0,0,,Дегенмен, оның менің активтерімді иемденуіне ешқандай мүмкіндік жоқ.
Dialogue: 0,0:15:22.02,0:15:25.05,Default,,0,0,0,,Бұл адам кімнен жеңілді?
Dialogue: 0,0:15:25.05,0:15:29.09,Default,,0,0,0,,Ол кісінің ойлары мен қызық деп ойладым. →
Dialogue: 0,0:15:29.09,0:15:31.11,Default,,0,0,0,,Бағыт ретінде емес. →
Dialogue: 0,0:15:31.11,0:15:34.14,Default,,0,0,0,,Бірақ бұл оның шегі! шектеу?
Dialogue: 0,0:15:34.14,0:15:38.18,Default,,0,0,0,,Біз оны болашақ деп атасақ та, ол шын мәнінде қазіргінің жалғасы.
Dialogue: 0,0:15:38.18,0:15:41.21,Default,,0,0,0,,Қазіргі жоғалса, болашақ болмайды.
Dialogue: 0,0:15:41.21,0:15:45.25,Default,,0,0,0,,Бірақ егер қалғаны мүмкіншіліктері жоғалған болашақ болса.
Dialogue: 0,0:15:45.25,0:15:48.28,Default,,0,0,0,,Менің ойымша, бұл «Қазіргі уақытта мағынасы жоқ». →
Dialogue: 0,0:15:48.28,0:15:50.30,Default,,0,0,0,,Маған да айтылды.
Dialogue: 0,0:15:50.30,0:15:53.33,Default,,0,0,0,,Бірақ бұл күштінің логикасы. →
Dialogue: 0,0:15:53.33,0:15:55.35,Default,,0,0,0,,Бұл алысты көре алатын адамның қисыны. →
Dialogue: 0,0:15:55.35,0:15:57.37,Default,,0,0,0,,Нағыз әлсіздер →
Dialogue: 0,0:15:57.37,0:16:02.37,Default,,0,0,0,,Әр күнді шын жүректен өткізу.
Dialogue: 0,0:16:06.46,0:16:08.48,Default,,0,0,0,,Нобуноза, бәлкім, →
Dialogue: 0,0:16:08.48,0:16:11.68,Default,,0,0,0,,Ол өз өмірін көп қолайсыздықсыз өткізген болуы керек.
Dialogue: 0,0:16:11.68,0:16:13.87,Default,,0,0,0,,Ол адам алтынның қанының иісін сезбейді.
Dialogue: 0,0:16:13.87,0:16:15.89,Default,,0,0,0,,Қан? (Соичиро) Қашан және қайда қолдану керек →
Dialogue: 0,0:16:15.89,0:16:19.93,Default,,0,0,0,,Оны таңдаған кезде ақшаның айналасында қан да ағып жатыр.
Dialogue: 0,0:16:19.93,0:16:21.95,Default,,0,0,0,,Түсіну керек. →
Dialogue: 0,0:16:21.95,0:16:24.98,Default,,0,0,0,,Ертеңгі мәміле сізге ұнайтындай болуы керек. →
Dialogue: 0,0:16:24.98,0:16:29.02,Default,,0,0,0,,Бірақ бұл қалада болғанша қаша беру мүмкін емес. →
Dialogue: 0,0:16:29.02,0:16:33.06,Default,,0,0,0,,Жеңіс үшін күрес. Бұл дүниеде сіз мұны істей аласыз →
Dialogue: 0,0:16:33.06,0:16:36.06,Default,,0,0,0,,Менің ойымша, бұл өте адал өмір сүру тәсілі.
Dialogue: 0,0:16:39.12,0:16:41.14,Default,,0,0,0,,Уайымдайтын ештеңе жоқ.
Dialogue: 0,0:16:41.14,0:16:44.14,Default,,0,0,0,,Эй, тыңдап тұрсың ба?
Dialogue: 0,0:16:46.19,0:16:49.22,Default,,0,0,0,,Иіс жоқ. (Соичиро) Иә?
Dialogue: 0,0:16:49.22,0:16:52.25,Default,,0,0,0,,Қанның иісін білмеймін. →
Dialogue: 0,0:16:52.25,0:16:55.28,Default,,0,0,0,,Оның иісі жоқ.
Dialogue: 0,0:16:55.28,0:16:59.28,Default,,0,0,0,,Мен көремін. (Q) Бірақ оның дәмі басқаша.
Dialogue: 0,0:17:04.37,0:17:08.41,Default,,0,0,0,,Сіз бұл әңгімені қабылдайсыз деп ойладым.
Dialogue: 0,0:17:08.41,0:17:11.11,Default,,0,0,0,,Бұл менің ниетім еді, бірақ...
Dialogue: 0,0:17:11.11,0:17:12.80,Default,,0,0,0,,Бірақ не?
Dialogue: 0,0:17:12.80,0:17:14.82,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:17:14.82,0:17:16.84,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:16.84,0:17:18.86,Default,,0,0,0,,《Егер қалғанның бәрі жоғалған мүмкіндіктері бар болашақ болса...》→
Dialogue: 0,0:17:18.86,0:17:21.54,Default,,0,0,0,,《Қазіргі уақытта ешқандай мән жоқ.》
Dialogue: 0,0:17:21.54,0:17:22.22,Default,,0,0,0,,《Сіз әлі жоқсыз→
Dialogue: 0,0:17:22.22,0:17:24.92,Default,,0,0,0,,Ақшадан басқа нәрселерді ойлайтын көздері бар.
Dialogue: 0,0:17:24.92,0:17:28.96,Default,,0,0,0,,《Ұрыста жеңіңіз. Бұл дүниеде сіз мұны істей аласыз →
Dialogue: 0,0:17:28.96,0:17:31.96,Default,,0,0,0,,Менің ойымша, бұл өте адал өмір сүру тәсілі.
Dialogue: 0,0:17:34.01,0:17:38.05,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін, бірақ егер сіз шешсеңіз, мұны істеу керек.
Dialogue: 0,0:17:38.05,0:17:40.73,Default,,0,0,0,,「ＯＰＥＮ ＤＥＡＬ」！
Dialogue: 0,0:17:40.73,0:17:41.73,Default,,0,0,0,,Кума!
Dialogue: 0,0:17:43.10,0:17:45.10,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:17:46.46,0:17:48.15,Default,,0,0,0,,Карума!
Dialogue: 0,0:17:48.15,0:17:50.15,Default,,0,0,0,,「ＡＮＧＥＬ」！
Dialogue: 0,0:17:52.19,0:17:55.22,Default,,0,0,0,,(Оқушы) Қайырлы таң. (Оқушы) Қайырлы таң. Ой, күйіп кеткен екен!
Dialogue: 0,0:17:55.22,0:17:57.91,Default,,0,0,0,,Қарғыс атсын... Ах.
Dialogue: 0,0:17:57.91,0:18:00.27,Default,,0,0,0,,Қарғыс атсын... Нағыз қызыл қоңыр!
Dialogue: 0,0:18:00.27,0:18:05.32,Default,,0,0,0,,Күшті... Ол адам керемет күшті.
Dialogue: 0,0:18:05.32,0:18:07.00,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:18:07.00,0:18:08.00,Default,,0,0,0,,「ＡＮＧＥＬ」！
Dialogue: 0,0:18:11.38,0:18:13.73,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:18:13.73,0:18:19.79,Default,,0,0,0,,Ugggggg. Апыр-ай! !
Dialogue: 0,0:18:19.79,0:18:21.82,Default,,0,0,0,,Ах…. Уф...
Dialogue: 0,0:18:21.82,0:18:23.82,Default,,0,0,0,,Ал... Шиншу!
Dialogue: 0,0:18:25.86,0:18:28.89,Default,,0,0,0,,Шиншу.
Dialogue: 0,0:18:28.89,0:18:30.91,Default,,0,0,0,,「ＡＮＧＥＬ」！
Dialogue: 0,0:18:30.91,0:18:32.93,Default,,0,0,0,,Шиншу!
Dialogue: 0,0:18:32.93,0:18:36.93,Default,,0,0,0,,Уау! Кя!
Dialogue: 0,0:18:38.99,0:18:41.01,Default,,0,0,0,,Шиншу! ?
Dialogue: 0,0:18:41.01,0:18:45.05,Default,,0,0,0,,Уау! Уау... Уау! !
Dialogue: 0,0:18:45.05,0:18:47.07,Default,,0,0,0,,Эй, Шиншу, Шиншу….
Dialogue: 0,0:18:47.07,0:18:49.07,Default,,0,0,0,,Шиншу! !
Dialogue: 0,0:18:51.11,0:18:54.14,Default,,0,0,0,,Жарайды. Жақында сауығып кетеді.
Dialogue: 0,0:18:54.14,0:18:56.16,Default,,0,0,0,,Шиншу.
Dialogue: 0,0:18:56.16,0:19:00.20,Default,,0,0,0,,Менің ойымша, бізде бас қосудан басқа амал жоқ.
Dialogue: 0,0:19:00.20,0:19:04.24,Default,,0,0,0,,Фляция... соңғы соққы болуы мүмкін.
Dialogue: 0,0:19:04.24,0:19:08.28,Default,,0,0,0,,Шиншу! Бұл қисынсыз.
Dialogue: 0,0:19:08.28,0:19:13.66,Default,,0,0,0,,Хехе. Мен сенің сезіміңді білемін.
Dialogue: 0,0:19:13.66,0:19:19.66,Default,,0,0,0,,Сіз жеңгіңіз келмейді, солай ма? Жарайды, мен де солай сезінемін.
Dialogue: 0,0:19:21.74,0:19:23.76,Default,,0,0,0,,Жоқ, Шиншу. иә?
Dialogue: 0,0:19:23.76,0:19:26.80,Default,,0,0,0,,Жеңгім келмейді, бірақ жеңілгім де келмейді.
Dialogue: 0,0:19:26.80,0:19:28.82,Default,,0,0,0,,Болашақтан көп→
Dialogue: 0,0:19:28.82,0:19:32.82,Default,,0,0,0,,Мен өзіме жақын нәрсені жоғалтып алудан қорқамын.
Dialogue: 0,0:19:37.91,0:19:39.91,Default,,0,0,0,,Кеттік, Шиншу.
Dialogue: 0,0:19:41.95,0:19:44.98,Default,,0,0,0,,「ＡＮＧＥＬ」！
Dialogue: 0,0:19:44.98,0:19:48.98,Default,,0,0,0,,Уау! !
Dialogue: 0,0:19:54.07,0:19:56.09,Default,,0,0,0,,Уф….
Dialogue: 0,0:19:56.09,0:19:58.11,Default,,0,0,0,,Ах. Сәлем.
Dialogue: 0,0:19:58.11,0:20:01.14,Default,,0,0,0,,Мм, мен жаңа ғана кеңсеге бардым.
Dialogue: 0,0:20:01.14,0:20:06.19,Default,,0,0,0,,А, мен одан құтылайын деп шештім. Сондай-ақ қызметкерлер аздаған элиталық қызметкерлермен қайта іске қосылады.
Dialogue: 0,0:20:06.19,0:20:09.19,Default,,0,0,0,,Бұл... әсер етеді ме?
Dialogue: 0,0:20:12.59,0:20:14.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:14.27,0:20:16.29,Default,,0,0,0,,Біз сонда барамыз ба?
Dialogue: 0,0:20:16.29,0:20:18.31,Default,,0,0,0,,Мен ол жерде меццо-фляция болады деп ешқашан күтпедім→
Dialogue: 0,0:20:18.31,0:20:20.33,Default,,0,0,0,,Ол мені екі рет атып тастады.
Dialogue: 0,0:20:20.33,0:20:23.36,Default,,0,0,0,,Кешіріңіз. (Нобуноза) Кешірім сұраудың қажеті жоқ. →
Dialogue: 0,0:20:23.36,0:20:26.39,Default,,0,0,0,,Үмітсіз болған себебіміз бірдей болғандықтан.
Dialogue: 0,0:20:26.39,0:20:28.41,Default,,0,0,0,,Бірақ қалай жеңуге болады.
Dialogue: 0,0:20:28.41,0:20:30.43,Default,,0,0,0,,Мен де, егер сол шайқас жалғаса берсе→
Dialogue: 0,0:20:30.43,0:20:33.46,Default,,0,0,0,,Мен міндетті түрде бақылауды жоғалттым. →
Dialogue: 0,0:20:33.46,0:20:38.51,Default,,0,0,0,,Бұл мағынада сіздің шешіміңіз толығымен орынды болды.
Dialogue: 0,0:20:38.51,0:20:41.54,Default,,0,0,0,,Мүмкін мен сізді аздап бағаламаған шығармын.
Dialogue: 0,0:20:41.54,0:20:44.57,Default,,0,0,0,,Өйткені мен өзіме ұқсас нәрсені сезіндім.
Dialogue: 0,0:20:44.57,0:20:48.61,Default,,0,0,0,,Менің ойымша, сіз сол қала арқылы күресе алатын адамсыз.
Dialogue: 0,0:20:48.61,0:20:51.61,Default,,0,0,0,,Сол жерде сурет жапсырылған.
Dialogue: 0,0:20:53.66,0:20:55.68,Default,,0,0,0,,Оны естігіңіз келе ме?
Dialogue: 0,0:20:55.68,0:20:57.68,Default,,0,0,0,,Жоқ (Нобуназа) Йога-кун!
Dialogue: 0,0:20:59.72,0:21:03.76,Default,,0,0,0,,Дәл қазір біз жақын жердегі нысанға осындай заттарды жіберіп жатырмыз. →
Dialogue: 0,0:21:03.76,0:21:05.78,Default,,0,0,0,,Бұдан былай бізде қайырымдылық пен қайырымдылыққа сенуден басқа амал қалмайды→
Dialogue: 0,0:21:05.78,0:21:07.81,Default,,0,0,0,,Мен ауқымды көмек көрсете алмасам да.
Dialogue: 0,0:21:07.81,0:21:12.19,Default,,0,0,0,,Бірақ бұл ақшаға сенгеннен әлдеқайда жақсы. →
Dialogue: 0,0:21:12.19,0:21:16.23,Default,,0,0,0,,Оны өзіңіздің сүйкімді активіңізге беріңіз. →
Dialogue: 0,0:21:16.23,0:21:18.23,Default,,0,0,0,,Бұл менің сыйлығым.
Dialogue: 0,0:21:25.32,0:21:35.32,Default,,0,0,0,,Сен
Dialogue: 0,0:25:12.25,0:25:16.29,Default,,0,0,0,,Жел сөйлеп тұр. Бұл дәмді! Тым дәмді!
Dialogue: 0,0:25:16.29,0:25:19.32,Default,,0,0,0,,《Ең алдымен оны ұйымдастыру керек》
Dialogue: 0,0:25:19.32,0:25:22.32,Default,,0,0,0,,《Менма неге мұнда?》
Dialogue: 0,0:25:25.38,0:25:29.42,Default,,0,0,0,,Сіз Буддалыққа жете алмайсыз, өйткені бұл дүниеде өкінішіңіз бар... →
Dialogue: 0,0:25:29.42,0:25:31.42,Default,,0,0,0,,Бұл ақылға қонымды.
Dialogue: 0,0:25:34.47,0:25:38.51,Default,,0,0,0,,《Мен түсінбеймін. Өйткені →
Dialogue: 0,0:25:40.01,0:25:46.01,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory