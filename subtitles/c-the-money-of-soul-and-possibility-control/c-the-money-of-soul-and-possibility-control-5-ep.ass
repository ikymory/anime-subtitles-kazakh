Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:44.89,0:01:46.89,Default,,0,0,0,,Гильдия бейбақ! →
Dialogue: 0,0:01:46.89,0:01:48.89,Default,,0,0,0,,Неліктен соқпайды? ? Кюри!
Dialogue: 0,0:01:48.89,0:01:51.90,Default,,0,0,0,,«Микрофляция»! (Кюри) Иә. →
Dialogue: 0,0:01:51.90,0:01:53.90,Default,,0,0,0,,Ха!
Dialogue: 0,0:01:53.90,0:01:56.90,Default,,0,0,0,,（）
Dialogue: 0,0:01:56.90,0:01:58.90,Default,,0,0,0,,Хой хой.
Dialogue: 0,0:01:58.90,0:02:00.91,Default,,0,0,0,,(Дыбыс картасы)
Dialogue: 0,0:02:00.91,0:02:04.91,Default,,0,0,0,,Тағы да жанармай шығыны нашар. Барлығын бірден шешуім керек пе? →
Dialogue: 0,0:02:04.91,0:02:06.91,Default,,0,0,0,,Mezzo INSIDER ON!
Dialogue: 0,0:02:06.91,0:02:08.91,Default,,0,0,0,,«INSIDER»! (Хорий) Ууууууу!
Dialogue: 0,0:02:10.92,0:02:12.92,Default,,0,0,0,,Куин!
Dialogue: 0,0:02:12.92,0:02:14.52,Default,,0,0,0,,«Микрофляция»!
Dialogue: 0,0:02:16.15,0:02:17.92,Default,,0,0,0,,Yahoo! →
Dialogue: 0,0:02:17.92,0:02:19.59,Default,,0,0,0,,Мазасыздық. (Кюри) Ах!
Dialogue: 0,0:02:19.59,0:02:21.26,Default,,0,0,0,,Бейбақ! «тікелей»!
Dialogue: 0,0:02:21.26,0:02:22.93,Default,,0,0,0,,Сіздің иықтарыңыз жақсы ма? →
Dialogue: 0,0:02:22.93,0:02:24.93,Default,,0,0,0,,Уф... бұл өте ауырады.
Dialogue: 0,0:02:24.93,0:02:26.93,Default,,0,0,0,,Уф... уф!
Dialogue: 0,0:02:26.93,0:02:30.94,Default,,0,0,0,,「ＣＬＯＳＩＮＧ」！ 「ＹＯＵ ＨＡＶＥ ＧＡＩＮ」！
Dialogue: 0,0:02:30.94,0:02:32.94,Default,,0,0,0,,Иә! Жоспарлағандай.
Dialogue: 0,0:02:34.94,0:02:37.94,Default,,0,0,0,,Иә! Мен сені пышақтай аламын ба?
Dialogue: 0,0:02:37.94,0:02:39.94,Default,,0,0,0,,«Бриаржан жылқысы»!
Dialogue: 0,0:02:42.88,0:02:45.88,Default,,0,0,0,,Бұл керемет өсу қарқыны. Қоңырау!
Dialogue: 0,0:02:45.88,0:02:47.89,Default,,0,0,0,,«Мезофляция»!
Dialogue: 0,0:02:47.89,0:02:51.56,Default,,0,0,0,,Иә. Хмм!
Dialogue: 0,0:02:51.56,0:02:53.23,Default,,0,0,0,,「ＤＥＡＤ ＭＡＮ’Ｓ ＴＲＩＧＧＥＲ」！
Dialogue: 0,0:02:53.23,0:02:55.89,Default,,0,0,0,,Уф... 21% меццо.
Dialogue: 0,0:02:55.89,0:02:58.89,Default,,0,0,0,,Иә. (Ер) Бриар!
Dialogue: 0,0:03:00.90,0:03:02.90,Default,,0,0,0,,Иә! Уф.
Dialogue: 0,0:03:04.90,0:03:06.90,Default,,0,0,0,,(Ер Бриардың айқайы)
Dialogue: 0,0:03:10.91,0:03:14.91,Default,,0,0,0,,「ＣＬＯＳＩＮＧ」！ 「ＹＯＵ ＨＡＶＥ ＧＡＩＮ」！
Dialogue: 0,0:03:14.91,0:03:16.92,Default,,0,0,0,,Шындыққа әсер етуді азайту үшін →
Dialogue: 0,0:03:16.92,0:03:20.92,Default,,0,0,0,,Кішкене есеппен ұтыңыз. Мәмілені бақылау. →
Dialogue: 0,0:03:20.92,0:03:23.92,Default,,0,0,0,,Ол үшін ең маңыздысы – өлшей білу.
Dialogue: 0,0:03:23.92,0:03:25.92,Default,,0,0,0,,Сіз басқа тарап туралы ақпарат жинағыңыз келе ме?
Dialogue: 0,0:03:25.92,0:03:28.93,Default,,0,0,0,,Барлығы осылай жасайды. →
Dialogue: 0,0:03:28.93,0:03:33.93,Default,,0,0,0,,Ең бастысы - өз күшіңізді толық және қатесіз түсіну.
Dialogue: 0,0:03:33.93,0:03:35.93,Default,,0,0,0,,Содан кейін өзіңізді өлшем ретінде қолданыңыз→
Dialogue: 0,0:03:35.93,0:03:37.94,Default,,0,0,0,,Сіз қарсыласыңызды дәл өлшей аласыз.
Dialogue: 0,0:03:37.94,0:03:39.94,Default,,0,0,0,,Менің күшім...
Dialogue: 0,0:03:39.94,0:03:45.88,Default,,0,0,0,,Активтер Білім IQ Атлетикалық қабілет Барлығы. →
Dialogue: 0,0:03:45.88,0:03:47.88,Default,,0,0,0,,Заттардың алуан түрлілігін неғұрлым дәл түсінетін болсаңыз →
Dialogue: 0,0:03:47.88,0:03:50.88,Default,,0,0,0,,Қарсыласыңызды бірнеше бұрыштан өлшей аласыз.
Dialogue: 0,0:03:50.88,0:03:52.88,Default,,0,0,0,,Активтер де?
Dialogue: 0,0:03:52.88,0:03:54.89,Default,,0,0,0,,Әрине. Мәміледе→
Dialogue: 0,0:03:54.89,0:03:57.89,Default,,0,0,0,,Активтер - сіздің ең маңызды күшіңіз.
Dialogue: 0,0:03:57.89,0:03:59.89,Default,,0,0,0,,Ең алдымен, маған активтер туралы толығырақ айтып берсеңіз...
Dialogue: 0,0:03:59.89,0:04:01.89,Default,,0,0,0,,Хмм! Ах...
Dialogue: 0,0:04:01.89,0:04:04.90,Default,,0,0,0,,Менен тікелей сұрау керек емес пе?
Dialogue: 0,0:04:04.90,0:04:06.90,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:11.90,0:04:13.91,Default,,0,0,0,,Тағы да осында?
Dialogue: 0,0:04:13.91,0:04:15.91,Default,,0,0,0,,Қарсыластың шабуылдары салғырт.
Dialogue: 0,0:04:15.91,0:04:18.91,Default,,0,0,0,,Сондықтан біз қарсы жақтың қозғалысын түсіну үшін тұрақты шайқасты қолданамыз.
Dialogue: 0,0:04:18.91,0:04:21.91,Default,,0,0,0,,Ол гильдия ма? Бұл сондай әурешілік.
Dialogue: 0,0:04:21.91,0:04:24.92,Default,,0,0,0,,Менің ойымша, сіз мұны жасамасаңыз да жеңе аласыз.
Dialogue: 0,0:04:24.92,0:04:27.92,Default,,0,0,0,,Өтінемін. Мен мәмілені басқарғым келеді.
Dialogue: 0,0:04:27.92,0:04:31.92,Default,,0,0,0,,Бұл шынымен басқаша. Активтер Entre компаниясының жеке активтері болып табылады.
Dialogue: 0,0:04:31.92,0:04:34.93,Default,,0,0,0,,Мен сіздің нұсқауларыңызсыз бір микро шығара алмаймын.
Dialogue: 0,0:04:34.93,0:04:37.93,Default,,0,0,0,,Мен білемін, бірақ көңіл-күй мәселесі бар, солай ма?
Dialogue: 0,0:04:37.93,0:04:39.93,Default,,0,0,0,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:04:41.87,0:04:43.87,Default,,0,0,0,,「ＯＰＥＮ ＤＥＡＬ」！
Dialogue: 0,0:04:45.87,0:04:49.87,Default,,0,0,0,,Бүгінгі гильдия мүшелік жарнасын салу уақыты келді.
Dialogue: 0,0:04:57.88,0:04:59.48,Default,,0,0,0,,Хун.
Dialogue: 0,0:05:04.89,0:05:07.89,Default,,0,0,0,,Құдайға шүкір.
Dialogue: 0,0:05:07.89,0:05:11.90,Default,,0,0,0,,Барбаросса! «ҰЛЫ ҚАБЫРҒА»!
Dialogue: 0,0:05:11.90,0:05:13.90,Default,,0,0,0,,Микрофляция!
Dialogue: 0,0:05:13.90,0:05:15.90,Default,,0,0,0,,«Микро»! Апыр-ай!
Dialogue: 0,0:05:15.90,0:05:19.90,Default,,0,0,0,,Кимимаро! О, жоқ!
Dialogue: 0,0:05:21.91,0:05:23.91,Default,,0,0,0,,Бірақ жылдамдық жағынан біз теңбіз.
Dialogue: 0,0:05:23.91,0:05:25.91,Default,,0,0,0,,Шиншу, өтінемін! Апыр-ай!
Dialogue: 0,0:05:25.91,0:05:27.51,Default,,0,0,0,,Кимимаро!
Dialogue: 0,0:05:31.92,0:05:33.92,Default,,0,0,0,,Қабырғаның өзі фляционды ма?
Dialogue: 0,0:05:33.92,0:05:35.92,Default,,0,0,0,,Иә. иә?
Dialogue: 0,0:05:35.92,0:05:38.92,Default,,0,0,0,,Гааааа!
Dialogue: 0,0:05:38.92,0:05:41.86,Default,,0,0,0,,Мен оны ұрламақ болдым... Кимимаро!
Dialogue: 0,0:05:41.86,0:05:44.86,Default,,0,0,0,,«Микрофляция»!
Dialogue: 0,0:05:44.86,0:05:47.86,Default,,0,0,0,,Барбаросса Қалғанын саған қалдырамын.
Dialogue: 0,0:05:49.87,0:05:52.87,Default,,0,0,0,,«тікелей»! бұл!
Dialogue: 0,0:05:55.87,0:05:57.54,Default,,0,0,0,,Шиншу!
Dialogue: 0,0:05:57.54,0:05:59.21,Default,,0,0,0,,Қазір! аа.
Dialogue: 0,0:05:59.21,0:06:01.88,Default,,0,0,0,,「ＤＩＲＥＣＴ」！
Dialogue: 0,0:06:01.88,0:06:03.88,Default,,0,0,0,,Ха ха…. (Таказава) Қарғыс атсын!
Dialogue: 0,0:06:03.88,0:06:05.88,Default,,0,0,0,,Шиншу! «Микрофляция»!
Dialogue: 0,0:06:05.88,0:06:07.88,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:11.89,0:06:14.89,Default,,0,0,0,,«тікелей»! Барбаросса, оны тез қорға! →
Dialogue: 0,0:06:14.89,0:06:16.89,Default,,0,0,0,,Осы жерде толық уақытты ұстаңыз.
Dialogue: 0,0:06:18.90,0:06:20.90,Default,,0,0,0,,2,4 миллион артық?
Dialogue: 0,0:06:20.90,0:06:23.90,Default,,0,0,0,,Шиншу Күзетші сұраңыз. «тікелей»!
Dialogue: 0,0:06:23.90,0:06:25.90,Default,,0,0,0,,Жарайды! Фляция.
Dialogue: 0,0:06:25.90,0:06:28.90,Default,,0,0,0,,Жоқ, тек күзетші. иә?
Dialogue: 0,0:06:31.91,0:06:33.91,Default,,0,0,0,,Күрсін! Міне, бәйбіше келді!
Dialogue: 0,0:06:33.91,0:06:36.92,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:06:36.92,0:06:38.58,Default,,0,0,0,,「ＤＩＲＥＣＴ」！ 「ＤＩＲＥＣＴ」！
Dialogue: 0,0:06:38.58,0:06:40.25,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:40.25,0:06:44.86,Default,,0,0,0,,Арх! Сол жақта болса... ақымақтық.
Dialogue: 0,0:06:44.86,0:06:46.52,Default,,0,0,0,,《Жарайды! Әрең дегенде жеңді》
Dialogue: 0,0:06:46.52,0:06:48.19,Default,,0,0,0,,Мен ойлағандай болды.
Dialogue: 0,0:06:48.19,0:06:49.86,Default,,0,0,0,,《Жаман, тым көп ұту》
Dialogue: 0,0:06:49.86,0:06:51.86,Default,,0,0,0,,Түс, Шиншу! Ха! ?
Dialogue: 0,0:06:51.86,0:06:53.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:55.87,0:06:57.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:57.54,0:06:59.77,Default,,0,0,0,,「ＣＬＯＳＩＮＧ」！
Dialogue: 0,0:06:59.77,0:07:01.77,Default,,0,0,0,,「ＹＯＵ ＬＯＳＴ」！
Dialogue: 0,0:07:01.77,0:07:04.07,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:07:07.78,0:07:11.78,Default,,0,0,0,,Сонымен не істегенімді қалайсың?
Dialogue: 0,0:07:11.78,0:07:15.79,Default,,0,0,0,,Вице-президенттен келесі жылы республикалық бюджеттің қысқаруына жол бермеу сұралады.
Dialogue: 0,0:07:15.79,0:07:18.79,Default,,0,0,0,,Экономикалық ынталандыру шаралары әлі де қажет пе? →
Dialogue: 0,0:07:18.79,0:07:23.80,Default,,0,0,0,,Бұл рас, бірақ мен елдің бұдан былай қарыздар үйілгенін қаламаймын.
Dialogue: 0,0:07:23.80,0:07:26.80,Default,,0,0,0,,Біз мемлекеттік облигацияларды сатып алуды қолдауды жалғастырамыз.
Dialogue: 0,0:07:26.80,0:07:30.80,Default,,0,0,0,,Елдегі дефициттің кеңеюін өзіңіз қолдайсыз ба? →
Dialogue: 0,0:07:30.80,0:07:33.80,Default,,0,0,0,,Өтірік естімегендіктен қорқынышты.
Dialogue: 0,0:07:35.81,0:07:37.81,Default,,0,0,0,,Сіз кімсіз? Вице-президент.
Dialogue: 0,0:07:37.81,0:07:39.81,Default,,0,0,0,,Сіз мұны естіген жоқсыз ба? →
Dialogue: 0,0:07:39.81,0:07:42.75,Default,,0,0,0,,Ел тапшылығын өзі көтеретін адам. →
Dialogue: 0,0:07:42.75,0:07:46.75,Default,,0,0,0,,Негізі ол кісісіз бұл елдің экономикасын ұстап тұру мүмкін емес деп ойлаймын.
Dialogue: 0,0:07:46.75,0:07:50.76,Default,,0,0,0,,Әзіл. Қандай пайдасы бар?
Dialogue: 0,0:07:50.76,0:07:52.76,Default,,0,0,0,,Адамдар құтқарылады.
Dialogue: 0,0:07:52.76,0:07:54.76,Default,,0,0,0,,Осындай нәрсе үшін →
Dialogue: 0,0:07:54.76,0:07:57.76,Default,,0,0,0,,Сіз ұлттық облигацияларға қомақты ақша жұмсап жатырсыз дейсіз бе?
Dialogue: 0,0:07:57.76,0:08:01.77,Default,,0,0,0,,Бұл ақымақ па? Халыққа көмектесу үшін.
Dialogue: 0,0:08:01.77,0:08:03.77,Default,,0,0,0,,О, жоқ...
Dialogue: 0,0:08:05.77,0:08:07.77,Default,,0,0,0,,Бұл енді адамдар туралы емес.
Dialogue: 0,0:08:07.77,0:08:09.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:09.54,0:08:11.21,Default,,0,0,0,,Ақыры жеңіліп қалсақ не болады→
Dialogue: 0,0:08:11.21,0:08:12.88,Default,,0,0,0,,Бұл сіздің басыңызда болады.
Dialogue: 0,0:08:12.88,0:08:14.88,Default,,0,0,0,,Бірақ оның жақындығы сонша, бұл маңызды емес.
Dialogue: 0,0:08:14.88,0:08:18.88,Default,,0,0,0,,Кейбір адамдар аз ғана айырмашылықпен ұтылып, үйлері өртеніп кетті.
Dialogue: 0,0:08:18.88,0:08:20.55,Default,,0,0,0,,Иә! ? Неліктен?
Dialogue: 0,0:08:20.55,0:08:22.79,Default,,0,0,0,,Келіңіздер. Біріншіден, ол мәміледе → қамтамасыз етіледі
Dialogue: 0,0:08:22.79,0:08:27.79,Default,,0,0,0,,Болашақтың өзі бұлыңғыр.
Dialogue: 0,0:08:31.80,0:08:33.80,Default,,0,0,0,,Ол жанбайды.
Dialogue: 0,0:08:33.80,0:08:35.80,Default,,0,0,0,,（）
Dialogue: 0,0:08:35.80,0:08:37.80,Default,,0,0,0,,（）
Dialogue: 0,0:08:37.80,0:08:39.80,Default,,0,0,0,,Апай, амансыз ба? жақсы ма?
Dialogue: 0,0:08:39.80,0:08:44.51,Default,,0,0,0,,...
Dialogue: 0,0:08:44.51,0:08:46.18,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:08:46.18,0:08:48.85,Default,,0,0,0,,１→
Dialogue: 0,0:08:48.85,0:08:50.85,Default,,0,0,0,,Әй, сәлемдесу жарайды. →
Dialogue: 0,0:08:50.85,0:08:53.85,Default,,0,0,0,,Егер оны асыра айтса, шынымен ұят болар еді.
Dialogue: 0,0:08:53.85,0:08:55.85,Default,,0,0,0,,Бұл мен науқас болғанымнан ба!? Мен ондай емеспін! Мен қозғалған жоқпын!
Dialogue: 0,0:08:55.85,0:08:57.86,Default,,0,0,0,,Өзін жақсы сезінбейтін тағы бір нәрсе бар ма?
Dialogue: 0,0:08:57.86,0:09:00.86,Default,,0,0,0,,Мені алаңдатқан нәрсе. ·не болды? →
Dialogue: 0,0:09:00.86,0:09:03.86,Default,,0,0,0,,Мен ауруханаға түсейін деп жатырмын, сондықтан не айтарымды білмеймін.→
Dialogue: 0,0:09:03.86,0:09:05.86,Default,,0,0,0,,Менің денсаулығым жасыма сай.
Dialogue: 0,0:09:05.86,0:09:07.53,Default,,0,0,0,,Иә….
Dialogue: 0,0:09:07.53,0:09:09.77,Default,,0,0,0,,Осындай нәрселерді тастайтын адамдар бар.
Dialogue: 0,0:09:09.77,0:09:11.77,Default,,0,0,0,,Осының жартысына жуығына қатысса →
Dialogue: 0,0:09:11.77,0:09:13.77,Default,,0,0,0,,өтуі керек емес пе еді? (Оқушы) Бірдеңе →
Dialogue: 0,0:09:13.77,0:09:15.77,Default,,0,0,0,,Сіз мұны істеген жоқсыз ба? (Оқушы) Мүмкін.
Dialogue: 0,0:09:15.77,0:09:17.78,Default,,0,0,0,,Сіз мұнда келдіңіз бе?
Dialogue: 0,0:09:17.78,0:09:20.78,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:09:20.78,0:09:22.78,Default,,0,0,0,,Ханахи! ?
Dialogue: 0,0:09:22.78,0:09:24.78,Default,,0,0,0,,Кимимаро, сен неге үрейленіп тұрсың?
Dialogue: 0,0:09:24.78,0:09:26.79,Default,,0,0,0,,Ханахи →
Dialogue: 0,0:09:26.79,0:09:29.79,Default,,0,0,0,,Жақында қайғылы оқиға болды ма? (Ханахи) Иә?
Dialogue: 0,0:09:29.79,0:09:31.79,Default,,0,0,0,,Жарақат, ауру, қиындық және т.б.
Dialogue: 0,0:09:31.79,0:09:35.79,Default,,0,0,0,,Мүлде жоқ. Не айтқың келеді? Болжам? →
Dialogue: 0,0:09:35.79,0:09:37.80,Default,,0,0,0,,Жақсы нәрселер болды. иә?
Dialogue: 0,0:09:37.80,0:09:40.80,Default,,0,0,0,,Менің оқу орныма педагогикалық тәжірибеден өтуге берген өтінішім мақұлданды. →
Dialogue: 0,0:09:40.80,0:09:44.74,Default,,0,0,0,,Менің естеліктерім көп, мүмкін болса, мен оны өзімнің альма-матерімде орындағым келеді.
Dialogue: 0,0:09:44.74,0:09:46.74,Default,,0,0,0,,Бірақ биыл өтініштер көп болған сияқты→
Dialogue: 0,0:09:46.74,0:09:49.74,Default,,0,0,0,,Мен жай ғана таң қалдым. →
Dialogue: 0,0:09:49.74,0:09:53.75,Default,,0,0,0,,Иә, мен жаттығуыма жаңа костюм сатып алдым.
Dialogue: 0,0:09:53.75,0:09:55.75,Default,,0,0,0,,Мен оны келесі жолы киемін.
Dialogue: 0,0:09:55.75,0:10:00.75,Default,,0,0,0,,Ханахиге әсері бар ма? Ха...
Dialogue: 0,0:10:00.75,0:10:03.75,Default,,0,0,0,,Маған не болды?
Dialogue: 0,0:10:06.76,0:10:08.76,Default,,0,0,0,,Осы аптада аман-есен оралуыңызбен құттықтаймыз.
Dialogue: 0,0:10:08.76,0:10:11.76,Default,,0,0,0,,Сізді де құттықтаймын.
Dialogue: 0,0:10:11.76,0:10:14.77,Default,,0,0,0,,Сондай-ақ туу мен қалған ресурстар азаяды →
Dialogue: 0,0:10:14.77,0:10:18.77,Default,,0,0,0,,Өз-өзіне қол жұмсау және қылмыс деңгейі жоғарыда қайта жазылды.
Dialogue: 0,0:10:18.77,0:10:20.77,Default,,0,0,0,,Мен өзімді нашар сезінемін. →
Dialogue: 0,0:10:20.77,0:10:22.77,Default,,0,0,0,,Біз білмей тұрып, қазіргі өзгерді.
Dialogue: 0,0:10:22.77,0:10:24.78,Default,,0,0,0,,Сіз сонда көшуді жоспарлап отырсыз ба?
Dialogue: 0,0:10:24.78,0:10:28.78,Default,,0,0,0,,Әлі де ештеңе жоқ. Біз халықаралық ұйым емеспіз. →
Dialogue: 0,0:10:28.78,0:10:33.79,Default,,0,0,0,,Дегенмен, сіз таратқан ақпарат сенімді деп есептеймін. →
Dialogue: 0,0:10:33.79,0:10:36.79,Default,,0,0,0,,Бұл қаржы ауданы туралы менде бар ақпарат. →
Dialogue: 0,0:10:36.79,0:10:38.79,Default,,0,0,0,,Онда үлкен ештеңе жоқ, дегенмен→
Dialogue: 0,0:10:38.79,0:10:41.73,Default,,0,0,0,,Оны жалғыз қалдырсаң, ояту қиын. →
Dialogue: 0,0:10:41.73,0:10:43.73,Default,,0,0,0,,Сонда кездескенше.
Dialogue: 0,0:10:48.73,0:10:52.74,Default,,0,0,0,,А, мен сіздің жарақатыңыз қалай болды деп ойладым.
Dialogue: 0,0:10:52.74,0:10:56.74,Default,,0,0,0,,Түсіндім, қалпына келтіру жылдам болды.
Dialogue: 0,0:10:56.74,0:10:58.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:58.74,0:11:00.75,Default,,0,0,0,,Сіз толығымен жеңдіңіз!
Dialogue: 0,0:11:00.75,0:11:02.75,Default,,0,0,0,,(Самурай) Батырлар мықты. Батырлар жалғыз…
Dialogue: 0,0:11:06.75,0:11:08.75,Default,,0,0,0,,Емделсе де, ауырады!
Dialogue: 0,0:11:08.75,0:11:10.76,Default,,0,0,0,,Күрделі шайқас параметрлерін алдын ала түсіндіріңіз!
Dialogue: 0,0:11:10.76,0:11:13.76,Default,,0,0,0,,Дәлірек айтқанда, сіз бұл туралы алдын ала ойлаған жоқсыз, солай ма?
Dialogue: 0,0:11:13.76,0:11:15.76,Default,,0,0,0,,Активтердің Entrée айтқандарын орындаудан басқа амалы жоқ...
Dialogue: 0,0:11:15.76,0:11:17.76,Default,,0,0,0,,（）
Dialogue: 0,0:11:17.76,0:11:21.77,Default,,0,0,0,,А, мен кесе кеспе жасап жатырмын.
Dialogue: 0,0:11:21.77,0:11:25.77,Default,,0,0,0,,О, солай емес пе? Ол тамақ.
Dialogue: 0,0:11:25.77,0:11:28.77,Default,,0,0,0,,Не? Ол тамақ.
Dialogue: 0,0:11:28.77,0:11:31.77,Default,,0,0,0,,Актив жемейді?
Dialogue: 0,0:11:34.78,0:11:36.55,Default,,0,0,0,,Осыған ұқсас нәрсе.
Dialogue: 0,0:11:36.55,0:11:38.78,Default,,0,0,0,,（） …
Dialogue: 0,0:11:38.78,0:11:40.79,Default,,0,0,0,,Неге олай істейсің?
Dialogue: 0,0:11:40.79,0:11:43.79,Default,,0,0,0,,→
Dialogue: 0,0:11:43.79,0:11:45.79,Default,,0,0,0,,Бұл жақсы. жақсы?
Dialogue: 0,0:11:45.79,0:11:48.79,Default,,0,0,0,,О, мм... Мен өзімді жақсы сезінемін.
Dialogue: 0,0:11:48.79,0:11:51.80,Default,,0,0,0,,Менің ойымша, көңілді және бақыт сияқты нәрселер бір-біріне жақын.
Dialogue: 0,0:11:51.80,0:11:54.80,Default,,0,0,0,,～ （）
Dialogue: 0,0:11:54.80,0:11:56.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:58.80,0:12:01.80,Default,,0,0,0,,Ах, а. Эй, эй.
Dialogue: 0,0:12:05.81,0:12:08.81,Default,,0,0,0,,Хмм.
Dialogue: 0,0:12:08.81,0:12:10.82,Default,,0,0,0,,Өйткені, мен бас тарттым.
Dialogue: 0,0:12:10.82,0:12:13.82,Default,,0,0,0,,...
Dialogue: 0,0:12:16.82,0:12:18.82,Default,,0,0,0,,Уф, уф…
Dialogue: 0,0:12:26.90,0:12:29.91,Default,,0,0,0,,Мен кеше Микунимен бірге жұмыс істеген Кикучи.
Dialogue: 0,0:12:29.91,0:12:32.91,Default,,0,0,0,,Екінші адам - ​​Ясуши Хиджирисава, ол да өте бай.
Dialogue: 0,0:12:32.91,0:12:35.91,Default,,0,0,0,,Сондықтан біз бір-бірімізбен шынымен ұрысып жатырмыз.
Dialogue: 0,0:12:35.91,0:12:40.92,Default,,0,0,0,,Қайсысы құласа да, шынайы дүние қатты зақымдалады. →
Dialogue: 0,0:12:40.92,0:12:44.92,Default,,0,0,0,,Кикучи... Микуни мырза оны езбей сол жерге тастап кетсе де.
Dialogue: 0,0:12:44.92,0:12:46.92,Default,,0,0,0,,Лезде өлтіру, басым жеңіс, бәрі мүмкін→
Dialogue: 0,0:12:46.92,0:12:48.93,Default,,0,0,0,,Бұл бастапқы мәміле. →
Dialogue: 0,0:12:48.93,0:12:51.93,Default,,0,0,0,,Біз Гильдия мырзаны тез арада қаржы аймағын бақылауға алуымыз керек.
Dialogue: 0,0:12:51.93,0:12:54.93,Default,,0,0,0,,Неліктен оны көндіре алмадың?
Dialogue: 0,0:12:54.93,0:12:56.93,Default,,0,0,0,,Ал, басқа адам бай →
Dialogue: 0,0:12:56.93,0:12:58.94,Default,,0,0,0,,Орта жолда суым таусылды.
Dialogue: 0,0:12:58.94,0:13:00.94,Default,,0,0,0,,Ақшаны дайында.
Dialogue: 0,0:13:00.94,0:13:02.94,Default,,0,0,0,,Тәуекелді мәмілелерді мүмкіндігінше шектеуді жалғастырыңыз.
Dialogue: 0,0:13:02.94,0:13:04.94,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:13:06.94,0:13:08.95,Default,,0,0,0,,「ＯＰＥＮ ＤＥＡＬ」！
Dialogue: 0,0:13:08.95,0:13:11.95,Default,,0,0,0,,Вурст! «PACKMAN ҚОРҒАНЫСЫ»!
Dialogue: 0,0:13:15.95,0:13:18.96,Default,,0,0,0,,Хэхехе...
Dialogue: 0,0:13:18.96,0:13:22.98,Default,,0,0,0,,Идиот бір нәрсені есіне алады! Porte Mezzo!
Dialogue: 0,0:13:22.98,0:13:24.98,Default,,0,0,0,,「ＧＡＴＥ ＫＥＥＰＥＲ」！
Dialogue: 0,0:13:27.90,0:13:29.90,Default,,0,0,0,,Бұл меццо! ?
Dialogue: 0,0:13:31.90,0:13:34.90,Default,,0,0,0,,Уау! Арх!
Dialogue: 0,0:13:34.90,0:13:36.91,Default,,0,0,0,,(Кикучидің айқайы)
Dialogue: 0,0:13:36.91,0:13:39.91,Default,,0,0,0,,Мен бәрін аламын. Кикучи!
Dialogue: 0,0:13:39.91,0:13:43.58,Default,,0,0,0,,Біз оны бұлай қалдыра алмаймыз!
Dialogue: 0,0:13:43.58,0:13:45.25,Default,,0,0,0,,Уф! ?
Dialogue: 0,0:13:45.25,0:13:47.92,Default,,0,0,0,,Жоқ! «тікелей»!
Dialogue: 0,0:13:47.92,0:13:52.92,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:13:52.92,0:14:04.93,Default,,0,0,0,,Сен
Dialogue: 0,0:14:04.93,0:14:07.94,Default,,0,0,0,,Негізгі фармацевтикалық компания Basho Pharmaceutical осы қаржы жылындағы нәтижелері →
Dialogue: 0,0:14:07.94,0:14:10.94,Default,,0,0,0,,Біз айтарлықтай тапшылыққа ұшыраймыз деп күтілуде. →
Dialogue: 0,0:14:10.94,0:14:14.94,Default,,0,0,0,,Қазіргі президент Йосиюки Кикучидің ақша жымқырды деген айыптауларына қосымша→
Dialogue: 0,0:14:14.94,0:14:18.95,Default,,0,0,0,,Жаңа препараттарды енгізуде алаяқтық мәселесі де көтеріліп, сенімді қайтару мүмкін болмады→
Dialogue: 0,0:14:18.95,0:14:22.97,Default,,0,0,0,,Сатылым күрт төмендеген сияқты.
Dialogue: 0,0:14:22.97,0:14:27.89,Default,,0,0,0,,Бір мәмілемен көп нәрсе қайта жазылды...
Dialogue: 0,0:14:27.89,0:14:30.89,Default,,0,0,0,,Basho Pharmaceutical банкротқа ұшыраса не болады?
Dialogue: 0,0:14:30.89,0:14:32.90,Default,,0,0,0,,Дұрыс. Тізбекті банкроттыққа байланысты және т.б.→
Dialogue: 0,0:14:32.90,0:14:36.90,Default,,0,0,0,,100 миллиард иен көлемінде экономикалық шығын болуы мүмкін. →
Dialogue: 0,0:14:36.90,0:14:42.91,Default,,0,0,0,,Әзірленіп жатқан өнімдердің, жабдықтардың және препараттардың ысырап болу ықтималдығы жоғары.
Dialogue: 0,0:14:42.91,0:14:45.88,Default,,0,0,0,,Бұл да үлкен шығын. →
Dialogue: 0,0:14:45.88,0:14:48.91,Default,,0,0,0,,Осылай айтсам, түсіну оңайырақ болар. →
Dialogue: 0,0:14:48.91,0:14:53.92,Default,,0,0,0,,Basho Pharmaceutical банкротқа ұшырауына байланысты 10 000-ға жуық адам көшеде қалды→
Dialogue: 0,0:14:53.92,0:14:55.92,Default,,0,0,0,,Сіз табысты болашағыңызды жоғалтасыз. →
Dialogue: 0,0:14:55.92,0:14:58.92,Default,,0,0,0,,Basho Pharmaceutical компаниясының банкроттығы қандай →
Dialogue: 0,0:14:58.92,0:15:01.92,Default,,0,0,0,,Бұл 10 000 адамның болашағын құртатын құбылыс.
Dialogue: 0,0:15:01.92,0:15:03.93,Default,,0,0,0,,10 000 адам….
Dialogue: 0,0:15:03.93,0:15:05.93,Default,,0,0,0,,Сіз ғашық болып қалған сияқтысыз.
Dialogue: 0,0:15:05.93,0:15:08.93,Default,,0,0,0,,Әйелі қалай?
Dialogue: 0,0:15:10.93,0:15:13.94,Default,,0,0,0,,Әй, әйелім кетіп қалды. иә?
Dialogue: 0,0:15:13.94,0:15:15.94,Default,,0,0,0,,Шынымды айтсам→
Dialogue: 0,0:15:15.94,0:15:18.94,Default,,0,0,0,,Әйелім және балаларыммен күнделікті өмірімнің қаншалықты шынайы болды?→
Dialogue: 0,0:15:18.94,0:15:23.94,Default,,0,0,0,,Бұл менің қиялым ғана ма? Мен айырмашылықты айта алмаймын.
Dialogue: 0,0:15:27.88,0:15:29.89,Default,,0,0,0,,Жоқ. Неліктен?
Dialogue: 0,0:15:29.89,0:15:32.89,Default,,0,0,0,,Сіз бұлай қозғала алмайсыз. Не?
Dialogue: 0,0:15:32.89,0:15:36.89,Default,,0,0,0,,Ол да саған соны айтты. Өзіңізді дәл өлшеңіз.
Dialogue: 0,0:15:36.89,0:15:39.90,Default,,0,0,0,,Қайта жазылған.
Dialogue: 0,0:15:39.90,0:15:42.90,Default,,0,0,0,,Мәмілелерді бақылау сияқты кеңейтілген нәрсені жасағыңыз келсе→
Dialogue: 0,0:15:42.90,0:15:44.90,Default,,0,0,0,,Алдын ала сонша дайындық жасамасаңыз→
Dialogue: 0,0:15:44.90,0:15:46.90,Default,,0,0,0,,Менде ол жоқ.
Dialogue: 0,0:15:46.90,0:15:48.91,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:15:48.91,0:15:50.91,Default,,0,0,0,,Азықтандыру активтері→
Dialogue: 0,0:15:50.91,0:15:52.91,Default,,0,0,0,,Сіз әдеттен тыс нәрсе істеп жатырсыз. иә?
Dialogue: 0,0:15:52.91,0:15:54.91,Default,,0,0,0,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:15:54.91,0:15:56.91,Default,,0,0,0,,Бұл жаман болмайды.
Dialogue: 0,0:15:56.91,0:15:58.92,Default,,0,0,0,,Не? Мені мазақ ету үшін келдің бе?
Dialogue: 0,0:15:58.92,0:16:00.92,Default,,0,0,0,,Мүмкін емес. →
Dialogue: 0,0:16:00.92,0:16:03.92,Default,,0,0,0,,Менде жақсы ақпарат бар, бірақ мен оны сатып алуды ойлап жүрмін.
Dialogue: 0,0:16:03.92,0:16:06.92,Default,,0,0,0,,Бұл Basho Pharmaceutical компаниясына қатысты.
Dialogue: 0,0:16:06.92,0:16:08.93,Default,,0,0,0,,Сіз уайымдадыңыз, солай ма?
Dialogue: 0,0:16:08.93,0:16:11.93,Default,,0,0,0,,Сіз қайдан білесіз? (Такетазаки) Мен ақпарат берушімін. →
Dialogue: 0,0:16:11.93,0:16:14.93,Default,,0,0,0,,1 миллион ше? 1 миллион! ?
Dialogue: 0,0:16:14.93,0:16:18.94,Default,,0,0,0,,100 – бұл менің ақпараттық төлемімнің ең төменгі сомасы.
Dialogue: 0,0:16:18.94,0:16:22.94,Default,,0,0,0,,Ағымдағы активтеріңізбен бұл үлкен сома емес, солай ма?
Dialogue: 0,0:16:26.88,0:16:29.88,Default,,0,0,0,,Уххххх...
Dialogue: 0,0:16:29.88,0:16:32.88,Default,,0,0,0,,Жақында ол әлемде де жаңалықтарда болады деп ойлаймын→
Dialogue: 0,0:16:32.88,0:16:35.89,Default,,0,0,0,,FE Pharma, 5 жастағы фармацевтикалық компания →
Dialogue: 0,0:16:35.89,0:16:38.89,Default,,0,0,0,,Біз Basho Pharmaceutical компаниясын барлық қарыздарымен сатып алдық.
Dialogue: 0,0:16:38.89,0:16:40.56,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:16:40.56,0:16:43.79,Default,,0,0,0,,Ал FE Pharma шетелмен еншілес → деп айтылады
Dialogue: 0,0:16:43.79,0:16:47.80,Default,,0,0,0,,Оның нақты менеджері - Соичиро Микуни. →
Dialogue: 0,0:16:47.80,0:16:49.80,Default,,0,0,0,,Бұл өткен күндегі мәміле шығар →
Dialogue: 0,0:16:49.80,0:16:52.80,Default,,0,0,0,,Нақты әлемге келтірілген зиян ең аз болады. →
Dialogue: 0,0:16:52.80,0:16:56.80,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл сіз естігіңіз келген ақпарат болды.
Dialogue: 0,0:16:58.81,0:17:01.81,Default,,0,0,0,,Иә? Мен үшін бе?
Dialogue: 0,0:17:01.81,0:17:03.81,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:03.81,0:17:05.82,Default,,0,0,0,,Хм... Такетазаки де жасамаңыз.
Dialogue: 0,0:17:05.82,0:17:08.82,Default,,0,0,0,,Шынында да, FE Pharma менің компаниям.
Dialogue: 0,0:17:08.82,0:17:10.82,Default,,0,0,0,,Исуругиден мәміле нәтижесі туралы есеп алғаннан кейін→
Dialogue: 0,0:17:10.82,0:17:12.82,Default,,0,0,0,,Бірден бақылауға көшті.
Dialogue: 0,0:17:12.82,0:17:14.82,Default,,0,0,0,,Нақты әлемге әсерін бақылау үшін?
Dialogue: 0,0:17:14.82,0:17:16.83,Default,,0,0,0,,Иә. →
Dialogue: 0,0:17:16.83,0:17:19.83,Default,,0,0,0,,Мен Starling гильдиясында жинаған Мидас ақшасын пайдаландым→
Dialogue: 0,0:17:19.83,0:17:21.83,Default,,0,0,0,,Мәмілелердің әсері басылады.
Dialogue: 0,0:17:21.83,0:17:25.77,Default,,0,0,0,,Ақырында, Starling Guild қаржылық ауданды басқарады. →
Dialogue: 0,0:17:25.77,0:17:28.77,Default,,0,0,0,,Бұл мәмілелердің әсерін бақылауды жеңілдетеді.
Dialogue: 0,0:17:28.77,0:17:30.77,Default,,0,0,0,,Неліктен бұлай ұзаққа барасың?
Dialogue: 0,0:17:30.77,0:17:33.78,Default,,0,0,0,,Сіз мұны мен үшін жасай аласыз ба? иә?
Dialogue: 0,0:17:33.78,0:17:35.78,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Ха.
Dialogue: 0,0:17:38.78,0:17:40.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:40.78,0:17:42.79,Default,,0,0,0,,Бұл қала туралы не ойлайсың? иә?
Dialogue: 0,0:17:42.79,0:17:44.79,Default,,0,0,0,,Бұл қаржы ауданы туралы. Сіз қалай ойлайсыз?
Dialogue: 0,0:17:44.79,0:17:49.79,Default,,0,0,0,,Ой, ой... Меніңше, бұл бір ғажап.
Dialogue: 0,0:17:49.79,0:17:52.80,Default,,0,0,0,,Бұл дұрыс жауап. Мен де солай болдым. →
Dialogue: 0,0:17:52.80,0:17:54.80,Default,,0,0,0,,Олай болса, оның несі керемет?
Dialogue: 0,0:17:54.80,0:17:58.80,Default,,0,0,0,,Әй...не деймін, мұндай дүние→
Dialogue: 0,0:17:58.80,0:18:01.80,Default,,0,0,0,,Бұлай таралып жатқаны ғажап...
Dialogue: 0,0:18:01.80,0:18:05.81,Default,,0,0,0,,Өз сөзіммен айтсам, бұл шындықтан басқа →
Dialogue: 0,0:18:05.81,0:18:08.81,Default,,0,0,0,,Бұл мұндай шындықтың бар екенін білдіреді. →
Dialogue: 0,0:18:08.81,0:18:10.81,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:18:10.81,0:18:12.82,Default,,0,0,0,,Бұл қорқынышты болды.
Dialogue: 0,0:18:12.82,0:18:14.82,Default,,0,0,0,,Біз қолданатын банкноттарда →
Dialogue: 0,0:18:14.82,0:18:17.82,Default,,0,0,0,,Мидас ақшасының араласуы қорқынышты болды. →
Dialogue: 0,0:18:17.82,0:18:19.82,Default,,0,0,0,,Орындалмайтын нәрсе бар ма? →
Dialogue: 0,0:18:19.82,0:18:22.83,Default,,0,0,0,,Мидас ақшасы анық зұлымдық. →
Dialogue: 0,0:18:22.83,0:18:24.76,Default,,0,0,0,,Бірақ бір күні мен мұны түсіндім. →
Dialogue: 0,0:18:24.76,0:18:29.77,Default,,0,0,0,,Қаржы аймағы мен Мидас ақшасы - бұл керемет шындық. →
Dialogue: 0,0:18:29.77,0:18:32.77,Default,,0,0,0,,Бұл шындықты жоққа шығаруға болмайтындай→
Dialogue: 0,0:18:32.77,0:18:35.77,Default,,0,0,0,,Қаржы ауданын да құлатуға болмайды. →
Dialogue: 0,0:18:35.77,0:18:37.77,Default,,0,0,0,,Ақиқаттан банкноттардың айналыстағы жүйесі →
Dialogue: 0,0:18:37.77,0:18:39.78,Default,,0,0,0,,Өшпейді →
Dialogue: 0,0:18:39.78,0:18:43.78,Default,,0,0,0,,Мидас ақшасының ағынын тоқтату мүмкін емес. →
Dialogue: 0,0:18:43.78,0:18:45.85,Default,,0,0,0,,Олай болса, олардың бірге өмір сүруден басқа амалы жоқ. →
Dialogue: 0,0:18:45.85,0:18:47.78,Default,,0,0,0,,Старлинг Гильдиясы бойынша→
Dialogue: 0,0:18:47.78,0:18:51.79,Default,,0,0,0,,Мәміленің нақты әлемге әсерін азайтыңыз. →
Dialogue: 0,0:18:51.79,0:18:55.79,Default,,0,0,0,,Мидас ақшасын жапондық мемлекеттік облигацияларды сатып алуға және елдің күйреуін болдырмауға жұмсаңыз. →
Dialogue: 0,0:18:55.79,0:18:59.80,Default,,0,0,0,,Әрқайсысы пайда табуы үшін нақты әлем мен қаржылық аймақ арасындағы тепе-теңдік →
Dialogue: 0,0:18:59.80,0:19:01.80,Default,,0,0,0,,Оны басқарудан басқа амалыңыз жоқ.
Dialogue: 0,0:19:01.80,0:19:03.80,Default,,0,0,0,,Оның зұлымдық екенін білсең де?
Dialogue: 0,0:19:03.80,0:19:05.80,Default,,0,0,0,,Әлем қазірдің өзінде Мидас ақшасына негізделген →
Dialogue: 0,0:19:05.80,0:19:08.80,Default,,0,0,0,,Ол жылжыды. Егер сіз ағынды тоқтатсаңыз, ол құлап кетеді. →
Dialogue: 0,0:19:08.80,0:19:11.81,Default,,0,0,0,,Көп адамдар бақытсыз болады. →
Dialogue: 0,0:19:11.81,0:19:13.81,Default,,0,0,0,,Әлі де жақсы ма? а….
Dialogue: 0,0:19:13.81,0:19:16.81,Default,,0,0,0,,Ашаршылыққа ұшыраған адамдардан таза дүние жақсырақ еді→
Dialogue: 0,0:19:16.81,0:19:19.82,Default,,0,0,0,,Мен лас тыныштықты таңдаймын. →
Dialogue: 0,0:19:19.82,0:19:21.82,Default,,0,0,0,,Қолым кір болса да→
Dialogue: 0,0:19:21.82,0:19:24.75,Default,,0,0,0,,Осы дүние қазіргі күйінде сақталса, мен қалар едім.
Dialogue: 0,0:19:24.75,0:19:28.76,Default,,0,0,0,,Бірақ мен әлі күнге дейін қара ақшаға үйренген жоқпын.
Dialogue: 0,0:19:28.76,0:19:31.76,Default,,0,0,0,,Біз онсыз бұл дүниеде өмір сүре алмауымыз мүмкін →
Dialogue: 0,0:19:31.76,0:19:34.76,Default,,0,0,0,,Менің ойымша, мен оны әлі де көп қабылдай алмаймын ...
Dialogue: 0,0:19:34.76,0:19:37.77,Default,,0,0,0,,Бір күні түсінерсің. Сізге де сенімдімін.
Dialogue: 0,0:19:37.77,0:19:41.77,Default,,0,0,0,,Солай деп ойлаймын... (Соичиро) О, мен сенімдімін.
Dialogue: 0,0:19:41.77,0:19:44.77,Default,,0,0,0,,Сізден бірдеңе сұрасам болады ма? (Соичиро) О, не?
Dialogue: 0,0:19:44.77,0:19:47.78,Default,,0,0,0,,Неліктен Кимимаро йогасына көңіл бөлесіз? →
Dialogue: 0,0:19:47.78,0:19:49.78,Default,,0,0,0,,Мен ерекше зерделі емеспін. →
Dialogue: 0,0:19:49.78,0:19:51.78,Default,,0,0,0,,Ақша туралы сөйлесуге сезімтал емес. →
Dialogue: 0,0:19:51.78,0:19:55.79,Default,,0,0,0,,Университетте экономиканы оқымаған деп ойлаймын.
Dialogue: 0,0:19:55.79,0:19:58.79,Default,,0,0,0,,Ақшаға құмар адамға ақша аударуға болмайды. →
Dialogue: 0,0:19:58.79,0:20:00.79,Default,,0,0,0,,Сондықтан. →
Dialogue: 0,0:20:00.79,0:20:03.79,Default,,0,0,0,,Әзірше оны менің хоббиім деп есептейсіз деп ойлаймын. →
Dialogue: 0,0:20:03.79,0:20:06.79,Default,,0,0,0,,Шағым? (Синдо) Жоқ...
Dialogue: 0,0:20:10.80,0:20:12.80,Default,,0,0,0,,Ｑ。→
Dialogue: 0,0:20:12.80,0:20:15.80,Default,,0,0,0,,Ол Әсетке кесе кеспе жегізген сияқты.
Dialogue: 0,0:20:17.57,0:20:19.81,Default,,0,0,0,,- (Суичиро) Егер сізді қызықтырса, келесі жолы жеуге рұқсат етемін.
Dialogue: 0,0:20:19.81,0:20:21.81,Default,,0,0,0,,Маған керек емес.
Dialogue: 0,0:20:59.78,0:21:03.79,Default,,0,0,0,,Кимимаро Кеса Йога гильдияда ресми түрде тіркелді.
Dialogue: 0,0:21:03.79,0:21:07.79,Default,,0,0,0,,Оның қабілетімен гильдиядан тыс қызығушылық танытқан адаммен баланстық мәміле бар →
Dialogue: 0,0:21:07.79,0:21:10.79,Default,,0,0,0,,Сәл ерте емес пе?
Dialogue: 0,0:21:12.80,0:21:15.80,Default,,0,0,0,,Егер сіз мұны көп істей алмасаңыз, өзіңізді құртыңыз. →
Dialogue: 0,0:21:15.80,0:21:18.80,Default,,0,0,0,,Бұл әлі нақты әлемге көп әсер етпейтін шығар.
Dialogue: 0,0:21:18.80,0:21:22.81,Default,,0,0,0,,Уау, өрескел!
Dialogue: 0,0:21:22.81,0:21:24.74,Default,,0,0,0,,Хи хи хи хи!
Dialogue: 0,0:21:24.74,0:21:27.74,Default,,0,0,0,,Ихе хи хи.
Dialogue: 0,0:21:27.74,0:21:30.75,Default,,0,0,0,,「ＯＰＥＮ ＤＥＡＬ」！
Dialogue: 0,0:21:30.75,0:21:40.75,Default,,0,0,0,,Сен
Dialogue: 0,0:25:17.91,0:25:27.91,Default,,0,0,0,,Сен
Dialogue: 0,0:25:29.41,0:25:35.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory