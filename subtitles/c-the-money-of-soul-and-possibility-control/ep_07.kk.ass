Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:36.15,0:01:38.15,Default,,0,0,0,,Соичиро Бұл не?
Dialogue: 0,0:01:41.15,0:01:43.16,Default,,0,0,0,,Алтын.
Dialogue: 0,0:01:43.16,0:01:47.16,Default,,0,0,0,,Қайта тыңдаңыз. Бұл не?
Dialogue: 0,0:01:47.16,0:01:49.16,Default,,0,0,0,,Аа...
Dialogue: 0,0:01:51.16,0:01:53.17,Default,,0,0,0,,Ақша. әке.
Dialogue: 0,0:01:53.17,0:01:56.17,Default,,0,0,0,,Менің әкем емес. Мені төраға деп атаңыз.
Dialogue: 0,0:01:56.17,0:01:59.17,Default,,0,0,0,,Кешіріңіз, төраға.
Dialogue: 0,0:01:59.17,0:02:02.17,Default,,0,0,0,,Кешіріңіз. →
Dialogue: 0,0:02:02.17,0:02:05.18,Default,,0,0,0,,Сөздеріңізге абай болыңыз. →
Dialogue: 0,0:02:05.18,0:02:10.18,Default,,0,0,0,,Бизнесте сіз өз табаныңызды таба аласыз.
Dialogue: 0,0:02:10.18,0:02:14.19,Default,,0,0,0,,Иә…. (Масафуми) Бұл ақша. әлбетте. →
Dialogue: 0,0:02:14.19,0:02:21.19,Default,,0,0,0,,Бірақ... осылай байласаң, алтын алтын болудан қалады. →
Dialogue: 0,0:02:21.19,0:02:25.20,Default,,0,0,0,,Түсіндің бе? Ол күш. →
Dialogue: 0,0:02:25.20,0:02:30.20,Default,,0,0,0,,Бұл дүниені қозғайтын жалғыз, теңдесі жоқ күш.
Dialogue: 0,0:02:42.15,0:02:47.15,Default,,0,0,0,,《Университетті бітірген соң бірден әкемнің хатшысы болдым》
Dialogue: 0,0:02:49.16,0:02:52.16,Default,,0,0,0,,Тек қарау керек. →
Dialogue: 0,0:02:52.16,0:02:57.16,Default,,0,0,0,,Менің не істеп жатқанымды қараңыз, ойланыңыз және үйреніңіз. →
Dialogue: 0,0:02:57.16,0:03:00.17,Default,,0,0,0,,Әр жолы кеңес сұрауға тырыспаңыз.
Dialogue: 0,0:03:00.17,0:03:02.17,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:03:02.17,0:03:04.17,Default,,0,0,0,,《Сіз колледжде оқып жүргенде қандай топта ойнадыңыз?→
Dialogue: 0,0:03:04.17,0:03:07.17,Default,,0,0,0,,Келісімшартқа қол қою алдында банкроттық》→
Dialogue: 0,0:03:07.17,0:03:10.18,Default,,0,0,0,,《Мен музыкаға деген құштарлығымды жоғалттым→
Dialogue: 0,0:03:10.18,0:03:14.18,Default,,0,0,0,,Әкемнің айтқанын жартылай орындадым》
Dialogue: 0,0:03:16.18,0:03:20.18,Default,,0,0,0,,《Әкемнің не істейтіні негізінен желіге байланысты.》
Dialogue: 0,0:03:22.19,0:03:24.19,Default,,0,0,0,,《Артқы және алдыңғы жағында алтынды пайдаланыңыз →
Dialogue: 0,0:03:24.19,0:03:30.20,Default,,0,0,0,,Ақшамен байланған күшті байланыстар жасаңыз》→
Dialogue: 0,0:03:30.20,0:03:33.20,Default,,0,0,0,,《Біреуі құласа, екіншісі құлайды》→
Dialogue: 0,0:03:33.20,0:03:37.14,Default,,0,0,0,,《Дағдарыс келгенде екі жақ бір-біріне көмектеседі》→
Dialogue: 0,0:03:37.14,0:03:40.14,Default,,0,0,0,,《Бұл қуат》→
Dialogue: 0,0:03:40.14,0:03:43.14,Default,,0,0,0,,《Бұл менің әкем жасаған жүйе емес》→
Dialogue: 0,0:03:43.14,0:03:47.14,Default,,0,0,0,,《Менің әкем бұрыннан бар нәрсеге кірді》
Dialogue: 0,0:03:49.15,0:03:51.15,Default,,0,0,0,,Сіз қалай ойлайсыз? Жұмыс істейтін адамдарға келсек.
Dialogue: 0,0:03:51.15,0:03:53.15,Default,,0,0,0,,Иә? Мен бірдеңе істеп жатырмын.
Dialogue: 0,0:03:53.15,0:03:57.16,Default,,0,0,0,,Уфуфу Секретарь болу саған жараспайды, аға.
Dialogue: 0,0:03:57.16,0:03:59.16,Default,,0,0,0,,(Теренс) Жарыста алданып жеңілген адам кінәлі.
Dialogue: 0,0:04:01.16,0:04:04.16,Default,,0,0,0,,Музыка... бас тартасыз ба?
Dialogue: 0,0:04:06.17,0:04:09.17,Default,,0,0,0,,Сіз кеңсе қызметкері немесе музыкант болсаңыз да→
Dialogue: 0,0:04:09.17,0:04:12.17,Default,,0,0,0,,Бұл сараңдық деп ойласаң, мен сенімен біргемін.
Dialogue: 0,0:04:12.17,0:04:16.18,Default,,0,0,0,,Мен оны жек көрмедім. Менің ағамның әні.
Dialogue: 0,0:04:16.18,0:04:20.18,Default,,0,0,0,,Мен осылай жалғасады деп ойладым.
Dialogue: 0,0:04:20.18,0:04:22.18,Default,,0,0,0,,Жарайды... →
Dialogue: 0,0:04:22.18,0:04:29.19,Default,,0,0,0,,Аз ғана адам арманмен өмір сүре алады. Мен басқаша болдым. →
Dialogue: 0,0:04:29.19,0:04:33.19,Default,,0,0,0,,Мен бұл сұмдық шындықпен өмір сүремін.
Dialogue: 0,0:04:39.13,0:04:41.13,Default,,0,0,0,,Иә….
Dialogue: 0,0:04:41.13,0:04:45.14,Default,,0,0,0,,《Әкем маған бәрін күштеп салуға тырысты》→
Dialogue: 0,0:04:45.14,0:04:47.14,Default,,0,0,0,,《Кілт – тұқым қуалаушылық》→
Dialogue: 0,0:04:47.14,0:04:51.14,Default,,0,0,0,,《Компаниядағы атмосфера суық болды, бірақ маған бәрібір》
Dialogue: 0,0:04:51.14,0:05:05.16,Default,,0,0,0,,Сен
Dialogue: 0,0:05:05.16,0:05:07.16,Default,,0,0,0,,Ол тұрақты болуы керек! ?
Dialogue: 0,0:05:07.16,0:05:10.16,Default,,0,0,0,,Бұл оның тұрақсыз болып қалғанын білдіреді.
Dialogue: 0,0:05:10.16,0:05:12.16,Default,,0,0,0,,Бұлай бейқам болма!
Dialogue: 0,0:05:12.16,0:05:15.16,Default,,0,0,0,,Жаныңа тыныштық сыйлағанымды қалайсың ба?
Dialogue: 0,0:05:17.17,0:05:21.17,Default,,0,0,0,,《Отандық ауруханаларда әпкемді құтқару мүмкін емес→
Dialogue: 0,0:05:21.17,0:05:23.18,Default,,0,0,0,,Американдық медициналық мекемелерге→
Dialogue: 0,0:05:23.18,0:05:26.18,Default,,0,0,0,,Жіберу керек деп айтылды》→
Dialogue: 0,0:05:26.18,0:05:31.18,Default,,0,0,0,,《Мен барлық күрделі процедураларды жібермей өттім.》
Dialogue: 0,0:05:35.20,0:05:37.12,Default,,0,0,0,,《Бұл уақыт》
Dialogue: 0,0:05:37.12,0:05:39.12,Default,,0,0,0,,Таңертеңнен бері сатылып жатыр!
Dialogue: 0,0:05:39.12,0:05:42.13,Default,,0,0,0,,Бизнес серіктестеріме не айтуым керек? (Орындаушы) Бұлай жалғаса берсе банкрот боламыз!
Dialogue: 0,0:05:42.13,0:05:44.13,Default,,0,0,0,,Төраға!
Dialogue: 0,0:05:44.13,0:05:46.13,Default,,0,0,0,,《Компания бас тартты》
Dialogue: 0,0:05:46.13,0:05:50.14,Default,,0,0,0,,《Желіде жанжал болды》→
Dialogue: 0,0:05:50.14,0:05:52.14,Default,,0,0,0,,《Әкем құрған желіден басқа желі→
Dialogue: 0,0:05:52.14,0:05:54.14,Default,,0,0,0,,Бұл кедергіден болған сияқты》
Dialogue: 0,0:05:58.14,0:06:02.15,Default,,0,0,0,,Неліктен жоюға болатын нәрсені тастамасқа?
Dialogue: 0,0:06:02.15,0:06:04.15,Default,,0,0,0,,Үйіңнен, жеріңнен айырылған адамсың→
Dialogue: 0,0:06:04.15,0:06:07.15,Default,,0,0,0,,Сіз бизнеспен айналысуға қызығасыз ба? (Соичиро) Бұл...
Dialogue: 0,0:06:07.15,0:06:10.16,Default,,0,0,0,,Ең бастысы – сенім. →
Dialogue: 0,0:06:10.16,0:06:14.16,Default,,0,0,0,,Қандай өсек тараса да, сабыр сақтау керек. →
Dialogue: 0,0:06:14.16,0:06:19.16,Default,,0,0,0,,Дүрбелеңге түспеңіз. Ренжімеңіз. Ештеңе болмағандай кейіп танытыңыз. →
Dialogue: 0,0:06:19.16,0:06:23.17,Default,,0,0,0,,Неғұрлым немқұрайлы әрекет етсең, соғұрлым болашағыңнан айырыласың.
Dialogue: 0,0:06:23.17,0:06:25.17,Default,,0,0,0,,Иә….
Dialogue: 0,0:06:27.17,0:06:29.17,Default,,0,0,0,,Такаконың Америка Құрама Штаттарына сапары тоқтатылды.
Dialogue: 0,0:06:29.17,0:06:31.18,Default,,0,0,0,,Не? ?
Dialogue: 0,0:06:31.18,0:06:33.18,Default,,0,0,0,,Бізде қазір ондай сән-салтанат жоқ.
Dialogue: 0,0:06:33.18,0:06:38.12,Default,,0,0,0,,Такако... Такаконың өлгені дұрыс дейсіз бе? ?
Dialogue: 0,0:06:38.12,0:06:41.12,Default,,0,0,0,,Құтқарылатыныңызға кепілдік жоқ.
Dialogue: 0,0:06:41.12,0:06:44.12,Default,,0,0,0,,Мүмкіндік болса, оған бәс тігу керек емес пе?
Dialogue: 0,0:06:44.12,0:06:48.13,Default,,0,0,0,,Мен білуім керек еді. Басынан бастап.
Dialogue: 0,0:06:48.13,0:06:51.13,Default,,0,0,0,,Мен бұған ешқашан сенбедім!
Dialogue: 0,0:06:51.13,0:06:55.13,Default,,0,0,0,,Такако қайтыс болса да, компанияның сенімділігі төмендемейді.
Dialogue: 0,0:06:55.13,0:06:57.14,Default,,0,0,0,,Ата-аналар! !
Dialogue: 0,0:06:57.14,0:07:01.14,Default,,0,0,0,,Мен сенің ата-анаң болмай тұрып, мен қоғам қайраткерімін...
Dialogue: 0,0:07:01.14,0:07:05.14,Default,,0,0,0,,Отбасыңыздың алдында қорғауыңыз керек нәрселер бар.
Dialogue: 0,0:07:09.15,0:07:12.15,Default,,0,0,0,,Жақында түсінесіз.
Dialogue: 0,0:07:12.15,0:07:14.15,Default,,0,0,0,,Мен мұндай логиканы түсінгім де келмейді! →
Dialogue: 0,0:07:14.15,0:07:17.16,Default,,0,0,0,,Төлемеймін десең →
Dialogue: 0,0:07:17.16,0:07:20.16,Default,,0,0,0,,Мен өз ақшамды өзім жасаймын!
Dialogue: 0,0:07:20.16,0:07:22.16,Default,,0,0,0,,《Түсінбедім》→
Dialogue: 0,0:07:22.16,0:07:24.16,Default,,0,0,0,,《Қызымның ісі→
Dialogue: 0,0:07:24.16,0:07:27.17,Default,,0,0,0,,Артықшылық беру деген жоқ》→
Dialogue: 0,0:07:27.17,0:07:29.17,Default,,0,0,0,,《Бұл жақсы болуы мүмкін емес》
Dialogue: 0,0:07:32.17,0:07:36.11,Default,,0,0,0,,Төраға мені сыртқа шығармауды тапсырды.
Dialogue: 0,0:07:36.11,0:07:40.11,Default,,0,0,0,,Мені сынауға негіз жоқ! Жолдан кет! ! →
Dialogue: 0,0:07:40.11,0:07:42.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:42.11,0:07:45.11,Default,,0,0,0,,Мені кешіріңіз. (Соичиро) Ах...
Dialogue: 0,0:07:47.12,0:07:51.12,Default,,0,0,0,,《Мен бірнеше күн үйқамақта болдым》→
Dialogue: 0,0:07:51.12,0:07:54.13,Default,,0,0,0,,《Мен ақша табуға тырыссам, сенімім жоғалатын сияқты.》→
Dialogue: 0,0:07:54.13,0:07:59.13,Default,,0,0,0,,《Егер мұндай сенім болса, мен жақсы болар еді деп ойладым. →
Dialogue: 0,0:07:59.13,0:08:03.14,Default,,0,0,0,,Ол кезде мен қауқарсыз едім.
Dialogue: 0,0:08:03.14,0:08:05.14,Default,,0,0,0,,（）
Dialogue: 0,0:08:08.14,0:08:10.14,Default,,0,0,0,,Мен сені ауруханаға апарамын.
Dialogue: 0,0:08:24.16,0:08:27.16,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:08:27.16,0:08:29.16,Default,,0,0,0,,Такако….
Dialogue: 0,0:08:32.16,0:08:35.18,Default,,0,0,0,,Ах... →
Dialogue: 0,0:08:35.18,0:08:39.18,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:08:41.11,0:08:45.11,Default,,0,0,0,,Көп болды... (Соичиро) А.
Dialogue: 0,0:08:45.11,0:08:51.12,Default,,0,0,0,,Мен сені енді ешқашан көрмеймін деп ойладым... (Суичиро) Кешіріңіз.
Dialogue: 0,0:08:51.12,0:08:57.12,Default,,0,0,0,,Өйткені бұл штатта мүмкін емес... Америкаға сапар тоқтатылды. →
Dialogue: 0,0:08:57.12,0:09:00.13,Default,,0,0,0,,Бірақ мен аздап жеңілдеп қалдым.
Dialogue: 0,0:09:00.13,0:09:04.13,Default,,0,0,0,,Жапония... Өйткені мен кеткім келмеді.
Dialogue: 0,0:09:04.13,0:09:06.13,Default,,0,0,0,,Неге! ?
Dialogue: 0,0:09:06.13,0:09:09.13,Default,,0,0,0,,Аға... Бүгін не болады→
Dialogue: 0,0:09:09.13,0:09:14.14,Default,,0,0,0,,Ертең келетінін кәдімгідей қабылдайсың.
Dialogue: 0,0:09:14.14,0:09:18.14,Default,,0,0,0,,Келесі аптада... келесі аптада.
Dialogue: 0,0:09:18.14,0:09:22.15,Default,,0,0,0,,Келесі айда... келесі айда. →
Dialogue: 0,0:09:22.15,0:09:25.15,Default,,0,0,0,,Осы жылдан кейін... келесі жылы.
Dialogue: 0,0:09:28.15,0:09:31.16,Default,,0,0,0,,Менде ондай жоқ...
Dialogue: 0,0:09:31.16,0:09:37.10,Default,,0,0,0,,Бүгін ұйықтасам... ертең оянбауым мүмкін.
Dialogue: 0,0:09:37.10,0:09:42.10,Default,,0,0,0,,Қазір немесе ешқашан... Бұл сәт бәрі.
Dialogue: 0,0:09:44.10,0:09:47.11,Default,,0,0,0,,Өзіңізді шетелге мәжбүрлеудің орнына →
Dialogue: 0,0:09:47.11,0:09:50.11,Default,,0,0,0,,Бұл жерде осылай жасаған дұрыс.
Dialogue: 0,0:09:50.11,0:09:56.11,Default,,0,0,0,,Ағам түсінбеуі мүмкін, бірақ...
Dialogue: 0,0:09:56.11,0:09:59.12,Default,,0,0,0,,Такако….
Dialogue: 0,0:09:59.12,0:10:03.12,Default,,0,0,0,,Бүгінгі күн мәңгілік болса екен...
Dialogue: 0,0:10:03.12,0:10:07.13,Default,,0,0,0,,Әр күн өзгеріссіз қалады...→
Dialogue: 0,0:10:07.13,0:10:12.13,Default,,0,0,0,,Мен бұл мәңгілікке созылса екен...
Dialogue: 0,0:10:12.13,0:10:15.13,Default,,0,0,0,,《Такако сол түні есін жоғалтты》→
Dialogue: 0,0:10:15.13,0:10:18.13,Default,,0,0,0,,《Мен бүгінге дейін оянған жоқпын》
Dialogue: 0,0:10:25.14,0:10:28.14,Default,,0,0,0,,《Мен ойымды жауып, өзімді жұмысқа арнадым》
Dialogue: 0,0:10:35.17,0:10:39.17,Default,,0,0,0,,《Әкеммен қарым-қатынасым тек бизнеске айналды》
Dialogue: 0,0:10:43.10,0:10:46.10,Default,,0,0,0,,《Ол сол кезде болған. Ол адам пайда болды ...
Dialogue: 0,0:10:57.11,0:11:00.11,Default,,0,0,0,,Қайырлы кеш. →
Dialogue: 0,0:11:00.11,0:11:01.71,Default,,0,0,0,,Хехе.
Dialogue: 0,0:11:03.35,0:11:04.95,Default,,0,0,0,,《Мен одан сұрадым》
Dialogue: 0,0:11:07.12,0:11:11.12,Default,,0,0,0,,《Сен маған керек кезде неге келмедің?》
Dialogue: 0,0:11:13.13,0:11:17.13,Default,,0,0,0,,「ＣＬＯＳＩＮＧ」！ 「ＹＯＵ ＨＡＶＥ ＧＡＩＮ」！
Dialogue: 0,0:11:17.13,0:11:20.13,Default,,0,0,0,,《Тезірек келсең болды→
Dialogue: 0,0:11:20.13,0:11:22.13,Default,,0,0,0,,Немесе...》
Dialogue: 0,0:11:22.13,0:11:26.14,Default,,0,0,0,,Мен мұны түсінбеймін.
Dialogue: 0,0:11:26.14,0:11:30.14,Default,,0,0,0,,《Бұл қаланың еркі жоқ сияқты.》→
Dialogue: 0,0:11:30.14,0:11:32.14,Default,,0,0,0,,《Олар онымен ойнап жүр》→
Dialogue: 0,0:11:32.14,0:11:35.15,Default,,0,0,0,,《Адамдар тағдыры》→
Dialogue: 0,0:11:35.15,0:11:39.15,Default,,0,0,0,,《Олар бізді биіктен қарап мазақ етеді.》
Dialogue: 0,0:11:41.15,0:11:44.16,Default,,0,0,0,,《Ондай жағдайда мен де онымен ойнаймын》→
Dialogue: 0,0:11:44.16,0:11:46.16,Default,,0,0,0,,《Осы қаламен ойнау→
Dialogue: 0,0:11:46.16,0:11:49.16,Default,,0,0,0,,Оны шындықты қорғау үшін қолданайық》→
Dialogue: 0,0:11:49.16,0:11:51.16,Default,,0,0,0,,《Жеңілсең де, ұтсаң да келемеж болады →
Dialogue: 0,0:11:51.16,0:11:54.16,Default,,0,0,0,,Біз өз логикамызды ұстанатын болсақ.
Dialogue: 0,0:11:56.17,0:11:58.17,Default,,0,0,0,,Жоқ! ? (С) Не болды?
Dialogue: 0,0:11:58.17,0:12:01.17,Default,,0,0,0,,Жоқ, ештеңе. →
Dialogue: 0,0:12:01.17,0:12:04.17,Default,,0,0,0,,Оның бізге қатысы жоқ.
Dialogue: 0,0:12:10.35,0:12:12.12,Default,,0,0,0,,Кимимаро! (Кимаро) Хмм...
Dialogue: 0,0:12:12.12,0:12:15.13,Default,,0,0,0,,Кимимаро~! (Кимаро) Иә? Апыр-ай!
Dialogue: 0,0:12:15.13,0:12:19.13,Default,,0,0,0,,《Менің тағамым біртүрлі》
Dialogue: 0,0:12:19.13,0:12:22.13,Default,,0,0,0,,《Алғаш кездескеннен бері...》
Dialogue: 0,0:12:22.13,0:12:25.13,Default,,0,0,0,,《Мен оны сағынғандай болдым》
Dialogue: 0,0:12:27.14,0:12:30.14,Default,,0,0,0,,《Мәмілеге келгенде→
Dialogue: 0,0:12:30.14,0:12:32.14,Default,,0,0,0,,Бұл шынымен жоқ...》
Dialogue: 0,0:12:37.15,0:12:40.15,Default,,0,0,0,,《Шамасы, айналадағы жағдай мен менің сезімім...
Dialogue: 0,0:12:40.15,0:12:45.16,Default,,0,0,0,,Алыста жүрсең ештеңе істей алмайтын сияқтысың.
Dialogue: 0,0:12:45.16,0:12:47.16,Default,,0,0,0,,《Бұрышқа бұрылғанда→
Dialogue: 0,0:12:47.16,0:12:51.16,Default,,0,0,0,,Ол атмосфераны оқымай-ақ өз сезімдерін таңдайтын сияқты》
Dialogue: 0,0:12:58.17,0:13:00.17,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:00.17,0:13:02.17,Default,,0,0,0,,「ＡＮＧＥＬ」！
Dialogue: 0,0:13:04.17,0:13:06.18,Default,,0,0,0,,Болашақтан да, бәрінен де артық →
Dialogue: 0,0:13:06.18,0:13:11.11,Default,,0,0,0,,Мен өзіме жақын нәрсені жоғалтып алудан қорқамын.
Dialogue: 0,0:13:11.11,0:13:13.11,Default,,0,0,0,,《Кеттік, Шиншу》
Dialogue: 0,0:13:17.12,0:13:21.12,Default,,0,0,0,,《Сонымен біз жеңдік→
Dialogue: 0,0:13:21.12,0:13:24.13,Default,,0,0,0,,Жеңілгенге қара...→
Dialogue: 0,0:13:24.13,0:13:26.13,Default,,0,0,0,,Мен тағы да уайымдадым》
Dialogue: 0,0:13:28.13,0:13:31.13,Default,,0,0,0,,Мен не істеуім керек? Өйткені...
Dialogue: 0,0:13:33.14,0:13:35.14,Default,,0,0,0,,Ал, біз төбелесеміз.
Dialogue: 0,0:13:39.14,0:13:42.15,Default,,0,0,0,,Түсіну үшін біраз уақыт кетті.
Dialogue: 0,0:13:42.15,0:13:45.15,Default,,0,0,0,,Хмм.
Dialogue: 0,0:13:45.15,0:13:50.15,Default,,0,0,0,,《Шешім ал, сосын тартын, ойлан, сосын шешім қабылда》
Dialogue: 0,0:13:52.16,0:13:56.16,Default,,0,0,0,,《Бұл қалада мұндай адам жоқ》
Dialogue: 0,0:13:59.16,0:14:03.16,Default,,0,0,0,,《Активтер бастапқы активтер болып табылады》
Dialogue: 0,0:14:05.17,0:14:08.17,Default,,0,0,0,,《Әр адамның қарым-қатынасы құрғақ》
Dialogue: 0,0:14:10.11,0:14:13.11,Default,,0,0,0,,《Бірақ бұл адам басқаша》
Dialogue: 0,0:14:13.11,0:14:16.11,Default,,0,0,0,,《Мен адамға ұқсағандықтан ба? 》
Dialogue: 0,0:14:18.11,0:14:21.11,Default,,0,0,0,,《Олай емес сияқты...》
Dialogue: 0,0:14:24.12,0:14:28.12,Default,,0,0,0,,Сен менің болашағымсың, солай ма?
Dialogue: 0,0:14:28.12,0:14:31.13,Default,,0,0,0,,Сонда менің болашағым қандай?
Dialogue: 0,0:14:31.13,0:14:32.80,Default,,0,0,0,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:14:32.80,0:14:40.04,Default,,0,0,0,,《Актив Entre жоғалған болашағының іске асуы деп айтылады.》
Dialogue: 0,0:14:40.04,0:14:43.04,Default,,0,0,0,,《Бұл теория, бірақ ол қалай жұмыс істейді?→
Dialogue: 0,0:14:43.04,0:14:46.04,Default,,0,0,0,,Мен де түсінбеймін》
Dialogue: 0,0:14:48.04,0:14:50.05,Default,,0,0,0,,《Бұл адамға не болу керек→
Dialogue: 0,0:14:50.05,0:14:53.05,Default,,0,0,0,,Болашақ мен боламын, солай ма? 》
Dialogue: 0,0:14:59.06,0:15:03.06,Default,,0,0,0,,《Активті болашақта не күтіп тұрғаны маңызды емес》
Dialogue: 0,0:15:03.06,0:15:06.06,Default,,0,0,0,,《Себебі мен Дильде күресу үшін туғанмын→
Dialogue: 0,0:15:06.06,0:15:08.00,Default,,0,0,0,,Бұл қазір немесе ешқашан.
Dialogue: 0,0:15:08.00,0:15:12.00,Default,,0,0,0,,《Мен бұл жақсы деп ойладым...→
Dialogue: 0,0:15:12.00,0:15:14.00,Default,,0,0,0,,Өйткені бұл адам көңіл бөледі→
Dialogue: 0,0:15:14.00,0:15:16.00,Default,,0,0,0,,Мен де осыған қатты алаңдаймын.
Dialogue: 0,0:15:17.77,0:15:19.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:21.01,0:15:23.01,Default,,0,0,0,,Өйткені мен шынымен түсінбеймін.
Dialogue: 0,0:15:23.01,0:15:24.78,Default,,0,0,0,,Болашақ маңызды болса да →
Dialogue: 0,0:15:24.78,0:15:27.02,Default,,0,0,0,,Микуни мырза айтқандай, бұл әлі де маңызды →
Dialogue: 0,0:15:27.02,0:15:30.02,Default,,0,0,0,,Саған бәрібір? солай.
Dialogue: 0,0:15:30.02,0:15:33.02,Default,,0,0,0,,Ақыр соңында, мүмкін сіз бір жерде өмір сүрген шығарсыз, солай емес пе?
Dialogue: 0,0:15:33.02,0:15:36.03,Default,,0,0,0,,Мен бақыттымын.
Dialogue: 0,0:15:36.03,0:15:38.03,Default,,0,0,0,,Мен жалықпаймын, өйткені қасымда біртүрлі адамдар бар.
Dialogue: 0,0:15:38.03,0:15:40.03,Default,,0,0,0,,көремін.
Dialogue: 0,0:15:40.03,0:15:42.03,Default,,0,0,0,,《Бұл рас, бірақ...》
Dialogue: 0,0:15:42.03,0:15:44.03,Default,,0,0,0,,《Егер сіз мұны әдеттегідей жасай алсаңыз→
Dialogue: 0,0:15:44.03,0:15:46.04,Default,,0,0,0,,Менің ойымша, бұл жақсы.》
Dialogue: 0,0:15:46.04,0:15:48.04,Default,,0,0,0,,Мен оны жегім келеді.
Dialogue: 0,0:15:50.04,0:15:52.04,Default,,0,0,0,,Сізде соншалықты тәбет пайда болды ма?
Dialogue: 0,0:15:52.04,0:15:54.04,Default,,0,0,0,,Бұл кесе кеспе сияқты болса, сіз қалағаныңызша ала аласыз.
Dialogue: 0,0:15:54.04,0:15:56.04,Default,,0,0,0,,Эй!
Dialogue: 0,0:15:58.05,0:16:03.05,Default,,0,0,0,,《Адам күнделікті дұрыс тамақтануы керек→
Dialogue: 0,0:16:03.05,0:16:05.06,Default,,0,0,0,,Ол өмір сүре алмайтын сияқты》
Dialogue: 0,0:16:05.06,0:16:07.06,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:16:08.99,0:16:10.99,Default,,0,0,0,,Ах.
Dialogue: 0,0:16:10.99,0:16:13.00,Default,,0,0,0,,Сіз...? →
Dialogue: 0,0:16:13.00,0:16:16.00,Default,,0,0,0,,Осыдан кейін сіз әлі ақша тауып жатқан сияқтысыз. Онша емес.
Dialogue: 0,0:16:16.00,0:16:18.00,Default,,0,0,0,,Мен де Жұлдыздық гильдияға қосылдым.
Dialogue: 0,0:16:18.00,0:16:21.00,Default,,0,0,0,,Гильдияға?
Dialogue: 0,0:16:21.00,0:16:24.01,Default,,0,0,0,,Мен мұндай нәрсеге жақсы емеспін.
Dialogue: 0,0:16:24.01,0:16:26.01,Default,,0,0,0,,Мен өзімді жалғыз сезінемін.
Dialogue: 0,0:16:26.01,0:16:28.01,Default,,0,0,0,,Мен бір нәрсені түсіндім.
Dialogue: 0,0:16:28.01,0:16:31.01,Default,,0,0,0,,Білсең, неге қосылдың?
Dialogue: 0,0:16:31.01,0:16:34.02,Default,,0,0,0,,Жоқ, мен кіргеннен кейін білдім-ау...
Dialogue: 0,0:16:34.02,0:16:38.02,Default,,0,0,0,,Бақытты адамдар бар.
Dialogue: 0,0:16:38.02,0:16:41.02,Default,,0,0,0,,Мүмкін сіз.
Dialogue: 0,0:16:41.02,0:16:44.46,Default,,0,0,0,,Жоқ... Сізден бірдеңе сұрасам болады ма?
Dialogue: 0,0:16:44.46,0:16:46.13,Default,,0,0,0,,Ах.
Dialogue: 0,0:16:46.13,0:16:51.13,Default,,0,0,0,,Активтер - бұл кірістердің болашағы, солай ма?
Dialogue: 0,0:16:51.13,0:16:53.14,Default,,0,0,0,,Сонда бұл құбыжық → болады
Dialogue: 0,0:16:53.14,0:16:56.14,Default,,0,0,0,,Сіздің ойыңызша, қандай болашақ қалыптасып жатыр?
Dialogue: 0,0:16:56.14,0:17:00.14,Default,,0,0,0,,Мен білмеймін. Неліктен Гигтің пішіні осындай?
Dialogue: 0,0:17:00.14,0:17:03.15,Default,,0,0,0,,Білгім келмейтіні емес, бірақ...→
Dialogue: 0,0:17:03.15,0:17:06.15,Default,,0,0,0,,Мен білмеймін. солай ма...
Dialogue: 0,0:17:06.15,0:17:09.09,Default,,0,0,0,,《Мен шынымен де қызықпын.》
Dialogue: 0,0:17:09.09,0:17:13.09,Default,,0,0,0,,《Бірақ мен менмін. Бұл жақсы, дегенмен.
Dialogue: 0,0:17:15.09,0:17:17.09,Default,,0,0,0,,Мына жерден тамақтан. →
Dialogue: 0,0:17:17.09,0:17:20.10,Default,,0,0,0,,Олай болса, мәміле сәл күштірек болмай ма? →
Dialogue: 0,0:17:20.10,0:17:22.10,Default,,0,0,0,,Достарың көп жеп жатыр.
Dialogue: 0,0:17:22.10,0:17:24.10,Default,,0,0,0,,Оларды тамақтандыру жеткілікті емес пе?
Dialogue: 0,0:17:24.10,0:17:27.10,Default,,0,0,0,,Күнделікті істеу керек тағы да көп~→
Dialogue: 0,0:17:27.10,0:17:29.11,Default,,0,0,0,,Біз оларға адам сияқты қарауымыз керек.
Dialogue: 0,0:17:29.11,0:17:34.11,Default,,0,0,0,,Түсіндім, мен көбірек еркелетуім керек.
Dialogue: 0,0:17:34.11,0:17:36.11,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:17:38.11,0:17:42.12,Default,,0,0,0,,《Түсінбеген жерлерім әлі де көп》
Dialogue: 0,0:17:42.12,0:17:44.12,Default,,0,0,0,,Не? Әсіресе.
Dialogue: 0,0:17:44.12,0:17:47.12,Default,,0,0,0,,Қарама. Иә….
Dialogue: 0,0:17:47.12,0:17:50.13,Default,,0,0,0,,《Бірақ мен білетін бір нәрсе бар》
Dialogue: 0,0:17:50.13,0:17:53.13,Default,,0,0,0,,《Бұл мен бұл адаммен бірге болуға қарсы емеспін.》
Dialogue: 0,0:17:53.13,0:17:56.13,Default,,0,0,0,,《Мені тітіркендіретін жайттар көп болса да→
Dialogue: 0,0:17:56.13,0:17:58.13,Default,,0,0,0,,Мен біртүрлі жеңілдеп қалдым》
Dialogue: 0,0:17:58.13,0:18:00.14,Default,,0,0,0,,Бұл менмін! иә?
Dialogue: 0,0:18:00.14,0:18:03.14,Default,,0,0,0,,Мен қателескім келмейді.
Dialogue: 0,0:18:03.14,0:18:06.14,Default,,0,0,0,,Оңды таңдайсың ба, сол жақты ма?→
Dialogue: 0,0:18:06.14,0:18:08.08,Default,,0,0,0,,Мен қателесіп, біреуге қиындық туғыздым →
Dialogue: 0,0:18:08.08,0:18:11.08,Default,,0,0,0,,Мен сенің көңіліңді қалдырғым келмейді.
Dialogue: 0,0:18:11.08,0:18:13.08,Default,,0,0,0,,Жоқ, бұл дұрыс емес...
Dialogue: 0,0:18:13.08,0:18:17.09,Default,,0,0,0,,Бұл менмін... Мен зардап шеккім келмейді.
Dialogue: 0,0:18:17.09,0:18:19.09,Default,,0,0,0,,Мен жасырынмын.
Dialogue: 0,0:18:19.09,0:18:22.09,Default,,0,0,0,,《Сондықтан мен әрекет ете алмаймын》
Dialogue: 0,0:18:22.09,0:18:27.10,Default,,0,0,0,,《Мен ойланып отырмын, бұл жақсы ма?》
Dialogue: 0,0:18:27.10,0:18:30.10,Default,,0,0,0,,Уа. Ха ха ха ха….
Dialogue: 0,0:18:30.10,0:18:32.10,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:18:34.10,0:18:36.11,Default,,0,0,0,,Ауырды. →
Dialogue: 0,0:18:36.11,0:18:38.11,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:18:38.11,0:18:40.11,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:18:40.11,0:18:43.11,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:18:43.11,0:18:46.12,Default,,0,0,0,,Неге кейін барып мені ұрдың?
Dialogue: 0,0:18:46.12,0:18:50.12,Default,,0,0,0,,Сондықтан мен қателескім келмейді.
Dialogue: 0,0:18:50.12,0:18:52.12,Default,,0,0,0,,Мен бұл көрініске қатты ашуландым.→
Dialogue: 0,0:18:52.12,0:18:55.12,Default,,0,0,0,,Осыған ашулану дұрыс па, білмеймін.
Dialogue: 0,0:18:55.12,0:18:59.13,Default,,0,0,0,,Бірақ мен сенімен сөйлескенде ашуланатын сияқты болдым.
Dialogue: 0,0:18:59.13,0:19:03.13,Default,,0,0,0,,Мен ашуланғаным дұрыс деп ойладым. Хмм.
Dialogue: 0,0:19:03.13,0:19:06.14,Default,,0,0,0,,Түсінбеуіңіз мүмкін, бірақ→
Dialogue: 0,0:19:06.14,0:19:10.07,Default,,0,0,0,,Бұндай нәрсе мені мазалайды, себебі бұл дұрыс емес.
Dialogue: 0,0:19:10.07,0:19:12.08,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:19:12.08,0:19:16.08,Default,,0,0,0,,《Микуни-сан және Сато есімді адам бұл адамнан үлкен үміт күтеді→
Dialogue: 0,0:19:16.08,0:19:18.08,Default,,0,0,0,,Осындай жерлер бар болғандықтан ба деп ойлаймын》
Dialogue: 0,0:19:20.08,0:19:22.09,Default,,0,0,0,,…
Dialogue: 0,0:19:22.09,0:19:24.09,Default,,0,0,0,,... (музыка)
Dialogue: 0,0:19:24.09,0:19:27.76,Default,,0,0,0,,… ３…
Dialogue: 0,0:19:27.76,0:19:29.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:29.43,0:19:33.10,Default,,0,0,0,,... (музыка)
Dialogue: 0,0:19:33.10,0:19:35.10,Default,,0,0,0,,Бұл сүйісу.
Dialogue: 0,0:19:37.10,0:19:42.10,Default,,0,0,0,,Сіз жақсы көретін адамдар еріндерін біріктіреді.
Dialogue: 0,0:19:46.11,0:19:48.11,Default,,0,0,0,,Мен оны көргім келеді! Ха! ?
Dialogue: 0,0:19:48.11,0:19:50.11,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:19:50.11,0:19:53.12,Default,,0,0,0,,Сіз мұны өзіңізге ұнайтын адаммен ғана жасауыңыз керек.
Dialogue: 0,0:19:53.12,0:19:56.12,Default,,0,0,0,,Мұндай нәрсе. Солай ма?
Dialogue: 0,0:19:56.12,0:20:01.12,Default,,0,0,0,,Сіз ойлағаннан шамамен 30 есе артық сезінуіңіз керек.
Dialogue: 0,0:20:01.12,0:20:05.13,Default,,0,0,0,,Дұрыс. Сонымен, бұл қалай сезінеді?
Dialogue: 0,0:20:05.13,0:20:07.15,Default,,0,0,0,,Ал, мен...
Dialogue: 0,0:20:07.15,0:20:11.07,Default,,0,0,0,,Себебі мен ештеңе істеген жоқпын...
Dialogue: 0,0:20:11.07,0:20:15.07,Default,,0,0,0,,Мен оның қандай сезімде екенін білмеймін.
Dialogue: 0,0:20:15.07,0:20:17.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:17.07,0:20:23.08,Default,,0,0,0,,Мен сені сенен 30 есе артық жақсы көрсем, сен мұны істей аласың, солай ма?
Dialogue: 0,0:20:23.08,0:20:27.08,Default,,0,0,0,,Онда ешқандай проблема жоқ.
Dialogue: 0,0:20:27.08,0:20:29.09,Default,,0,0,0,,Жарайды, мен мұны ақырында істеймін.
Dialogue: 0,0:20:29.09,0:20:33.09,Default,,0,0,0,,Өтінемін, солай істеңіз.
Dialogue: 0,0:20:33.09,0:20:39.10,Default,,0,0,0,,《Мен әлі де білмейтін нәрселер көп》
Dialogue: 0,0:20:39.10,0:20:41.10,Default,,0,0,0,,《Бірақ ақырында бұл жігіт те→
Dialogue: 0,0:20:41.10,0:20:44.10,Default,,0,0,0,,Көп нәрсені түсінесіз бе деп ойлаймын》
Dialogue: 0,0:20:44.10,0:20:47.10,Default,,0,0,0,,《Болашақта не болады...》
Dialogue: 0,0:20:47.10,0:20:50.10,Default,,0,0,0,,《Мен тым терең ойлап отырмын ба? 》
Dialogue: 0,0:20:54.11,0:20:56.11,Default,,0,0,0,,Иә? Эй…. (Итанеда) Иә?
Dialogue: 0,0:20:56.11,0:21:01.12,Default,,0,0,0,,Мына жерде бес зәулім ғимарат жоқ па? Менде қазір үшеуі ғана...
Dialogue: 0,0:21:01.12,0:21:05.12,Default,,0,0,0,,Енді... Мен мұндай нәрселер туралы көп білмеймін.
Dialogue: 0,0:21:05.12,0:21:11.06,Default,,0,0,0,,Бірдеңе... бұл мен келгенге дейінгіден сәл басқаша көрінеді.
Dialogue: 0,0:21:11.06,0:21:13.06,Default,,0,0,0,,Бұл сіздің қиялыңыз ғана ма?
Dialogue: 0,0:21:13.06,0:21:17.07,Default,,0,0,0,,Жарайды, бұл жай ғана менің қиялым деп ойлаған дұрыс→
Dialogue: 0,0:21:17.07,0:21:20.07,Default,,0,0,0,,Бұл оңай болуы мүмкін.
Dialogue: 0,0:21:22.07,0:21:23.67,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:21:25.31,0:21:35.31,Default,,0,0,0,,Сен
Dialogue: 0,0:25:12.17,0:25:14.17,Default,,0,0,0,,Өйткені, ол ашулы болды. →
Dialogue: 0,0:25:14.17,0:25:16.17,Default,,0,0,0,,Мен өзімді таз деп ойладым!
Dialogue: 0,0:25:16.17,0:25:18.17,Default,,0,0,0,,Мен үйден қашамын дегенде →
Dialogue: 0,0:25:19.67,0:25:25.67,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory