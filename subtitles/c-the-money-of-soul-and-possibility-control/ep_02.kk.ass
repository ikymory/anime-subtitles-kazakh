Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.43,0:00:10.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:10.44,0:00:12.44,Default,,0,0,0,,Міне! ?
Dialogue: 0,0:00:15.44,0:00:18.44,Default,,0,0,0,,Біз келдік.
Dialogue: 0,0:00:18.44,0:00:20.45,Default,,0,0,0,,қараңыз.
Dialogue: 0,0:00:20.45,0:00:24.45,Default,,0,0,0,,Бұл қаржы ауданының орталығы Мидас Банк алаңы.
Dialogue: 0,0:00:31.46,0:00:33.46,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:00:33.46,0:00:35.46,Default,,0,0,0,,Активтер. Бұл жеке актив. →
Dialogue: 0,0:00:35.46,0:00:38.46,Default,,0,0,0,,Мәмілелер кезінде кірістерге көмектеседі.
Dialogue: 0,0:00:38.46,0:00:41.46,Default,,0,0,0,,Мәміле? (Масакаги) Жоғарыдан қараңыз.
Dialogue: 0,0:00:44.47,0:00:47.47,Default,,0,0,0,,Қарсылас деректерін өңдеу және →
Dialogue: 0,0:00:47.47,0:00:49.48,Default,,0,0,0,,Иеліктегі акциялар саны. сәйкес?
Dialogue: 0,0:00:49.48,0:00:51.48,Default,,0,0,0,,Аптасына бір рет кіріспе→
Dialogue: 0,0:00:51.48,0:00:54.48,Default,,0,0,0,,Сіз әрқашан мәміле деп аталатын транзакцияға қатысуыңыз керек.
Dialogue: 0,0:00:54.48,0:00:56.48,Default,,0,0,0,,Бұл сіздің құқығыңыз бен міндетіңіз. →
Dialogue: 0,0:00:56.48,0:00:58.48,Default,,0,0,0,,Әзірге барайық.
Dialogue: 0,0:01:00.49,0:01:05.42,Default,,0,0,0,,Жаңа ойыншы? Мен оны бұлай ұстай алмаймын.
Dialogue: 0,0:01:05.42,0:01:07.42,Default,,0,0,0,,Оның тіпті жәндіктер де өлтіре алмайтын түрі бар.
Dialogue: 0,0:01:09.43,0:01:12.43,Default,,0,0,0,,Бәс тігеміз бе?
Dialogue: 0,0:01:12.43,0:01:22.43,Default,,0,0,0,,Сен
Dialogue: 0,0:02:49.45,0:02:51.45,Default,,0,0,0,,Басқа адам сол жерде. иә?
Dialogue: 0,0:02:51.45,0:02:54.46,Default,,0,0,0,,Бұл не? (Масакаги) Әзірге →
Dialogue: 0,0:02:54.46,0:02:56.46,Default,,0,0,0,,Карточканың алдыңғы жағын сызыңыз.
Dialogue: 0,0:03:09.47,0:03:12.47,Default,,0,0,0,,Аты-жөні. иә? Ааа.
Dialogue: 0,0:03:12.47,0:03:15.48,Default,,0,0,0,,М... Макото Шиншу?
Dialogue: 0,0:03:15.48,0:03:18.48,Default,,0,0,0,,Шиншу? Жарайды.
Dialogue: 0,0:03:18.48,0:03:21.48,Default,,0,0,0,,Мен де сен сияқты жаңадан келген адаммын, маған қамқор бол.
Dialogue: 0,0:03:21.48,0:03:25.49,Default,,0,0,0,,Не? Бұл менің байлығым ба? Сол жақта.
Dialogue: 0,0:03:25.49,0:03:28.49,Default,,0,0,0,,Басқа жақпен салыстырғанда үлкен айырмашылық бар.
Dialogue: 0,0:03:28.49,0:03:31.49,Default,,0,0,0,,Активтер кірістердің болашағын бейнелейді. →
Dialogue: 0,0:03:31.49,0:03:33.50,Default,,0,0,0,,Бұл мағынада әділетсіздік емес. →
Dialogue: 0,0:03:33.50,0:03:36.50,Default,,0,0,0,,Ой... Қалғандарына сәттілік. Жарайды онда.
Dialogue: 0,0:03:36.50,0:03:38.50,Default,,0,0,0,,Мен үшін ол жай ғана қарапайым қыз сияқты көрінеді.
Dialogue: 0,0:03:38.50,0:03:40.50,Default,,0,0,0,,Менің болашағым. Бұл ма?
Dialogue: 0,0:03:40.50,0:03:43.51,Default,,0,0,0,,Уау! Ой! Сен не істеп жатырсың?
Dialogue: 0,0:03:43.51,0:03:45.51,Default,,0,0,0,,Сіз соншалықты ақымақ болуды қоя аласыз ба?
Dialogue: 0,0:03:45.51,0:03:48.44,Default,,0,0,0,,Бұл нақты шоу. «АШЫҚ МӘМІЛЕ»!
Dialogue: 0,0:03:48.44,0:03:51.45,Default,,0,0,0,,「ＯＰＥＮ ＤＥＡＬ」！
Dialogue: 0,0:03:51.45,0:03:53.45,Default,,0,0,0,,«Микро»
Dialogue: 0,0:03:55.45,0:03:57.45,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:57.45,0:04:00.45,Default,,0,0,0,,Ауырды... «ТІКЕЛЕЙ»!
Dialogue: 0,0:04:02.46,0:04:04.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:04.46,0:04:09.47,Default,,0,0,0,,Шиншу! (Саке ролл) Чит Гиг!
Dialogue: 0,0:04:09.47,0:04:12.47,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:12.47,0:04:14.47,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:04:14.47,0:04:18.47,Default,,0,0,0,,Тым болмаса өзіңізді қорғамасаңыз, банкротқа ұшырайсыз.
Dialogue: 0,0:04:18.47,0:04:20.48,Default,,0,0,0,,Банкроттық?
Dialogue: 0,0:04:20.48,0:04:22.48,Default,,0,0,0,,Бұл не? сіздің ақшаңыз.
Dialogue: 0,0:04:26.48,0:04:31.49,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:04:31.49,0:04:33.49,Default,,0,0,0,,Кешіктірмеңіз!
Dialogue: 0,0:04:33.49,0:04:35.49,Default,,0,0,0,,Бетіңді көрсетпе, бұл қауіпті!
Dialogue: 0,0:04:35.49,0:04:38.49,Default,,0,0,0,,Менің істеген ісім екі рет сәтсіздікке ұшырайды деп ойлау.
Dialogue: 0,0:04:38.49,0:04:40.49,Default,,0,0,0,,Кел, Гиг!
Dialogue: 0,0:04:43.50,0:04:46.50,Default,,0,0,0,,Микро 300 000! «Микро»
Dialogue: 0,0:04:49.44,0:04:51.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:56.45,0:04:58.45,Default,,0,0,0,,Сіз жарақат алдыңыз ба? Жарайды ма?
Dialogue: 0,0:04:58.45,0:05:00.45,Default,,0,0,0,,Бұл міндетті түрде ауырады!
Dialogue: 0,0:05:00.45,0:05:03.45,Default,,0,0,0,,Сіз жағдайды мүлде түсінбейсіз.
Dialogue: 0,0:05:16.47,0:05:20.47,Default,,0,0,0,,Ардагердің басына қиналып жатыр. Хехе.
Dialogue: 0,0:05:20.47,0:05:24.47,Default,,0,0,0,,Бұл қауіпті. Оны тоқтатайық. Маған маңызды емес.
Dialogue: 0,0:05:24.47,0:05:26.48,Default,,0,0,0,,Уф... бұл ауырады.
Dialogue: 0,0:05:26.48,0:05:29.48,Default,,0,0,0,,Соқса, бітті!
Dialogue: 0,0:05:29.48,0:05:32.48,Default,,0,0,0,,Барамын ба деп. Gieg Micro 900 000!
Dialogue: 0,0:05:32.48,0:05:34.48,Default,,0,0,0,,«Микро»!
Dialogue: 0,0:05:36.49,0:05:39.49,Default,,0,0,0,,Егер сіз жұмыстан кеткіңіз келетінін айтсаңыз, басқа адам түсінетініне сенімдімін.
Dialogue: 0,0:05:39.49,0:05:42.49,Default,,0,0,0,,Бұл жұмыс істеуге мүмкіндік жоқ.
Dialogue: 0,0:05:42.49,0:05:44.49,Default,,0,0,0,,Иә! Апыр-ай!
Dialogue: 0,0:05:44.49,0:05:46.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:46.50,0:05:48.50,Default,,0,0,0,,Шиншу?
Dialogue: 0,0:05:50.43,0:05:53.44,Default,,0,0,0,,Уф, уф…
Dialogue: 0,0:05:53.44,0:05:57.44,Default,,0,0,0,,Менің қолым... Ей, Шиншу! Келме.
Dialogue: 0,0:05:59.44,0:06:02.44,Default,,0,0,0,,Мен үшін уайымдама, тез тығыласың.
Dialogue: 0,0:06:02.44,0:06:05.45,Default,,0,0,0,,Бірақ... Жарайды, асығыңыз!
Dialogue: 0,0:06:05.45,0:06:09.45,Default,,0,0,0,,Олардың аурасы ұқсас қой, иә? Олар әпкелер ме?
Dialogue: 0,0:06:09.45,0:06:12.45,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:06:16.46,0:06:18.46,Default,,0,0,0,,Жоғалту. Сіз мұны әлі де жасайсыз ба?
Dialogue: 0,0:06:18.46,0:06:22.46,Default,,0,0,0,,Қарғыс атсын. Сіз ақымақ активтер. →
Dialogue: 0,0:06:22.46,0:06:27.47,Default,,0,0,0,,Гиг 3 миллион микрон. «Микро»
Dialogue: 0,0:06:27.47,0:06:29.47,Default,,0,0,0,,Ардагерлердің қалтасы көтере алады.
Dialogue: 0,0:06:29.47,0:06:32.47,Default,,0,0,0,,Такетазаки? Бұл қызықсыз мәміле.
Dialogue: 0,0:06:32.47,0:06:36.48,Default,,0,0,0,,Бірақ ақпарат беруші ретінде бұл мен жіберіп алмайтын мәміле.
Dialogue: 0,0:06:36.48,0:06:38.48,Default,,0,0,0,,Иә. (Такетазаки) Толық әуесқой болсаңыз да →
Dialogue: 0,0:06:38.48,0:06:40.48,Default,,0,0,0,,Тірі қалуы мүмкін.
Dialogue: 0,0:06:40.48,0:06:43.49,Default,,0,0,0,,Мен бұл қандай адам деп ойладым.
Dialogue: 0,0:06:43.49,0:06:46.49,Default,,0,0,0,,Сізге нәрселер ұнайды. (Такетазаки) Солай ма?
Dialogue: 0,0:06:46.49,0:06:48.42,Default,,0,0,0,,Мені бәрінен де жақсы түсінетін сен сияқтымын.
Dialogue: 0,0:06:48.42,0:06:50.42,Default,,0,0,0,,Микуни мырза. (Соичиро) Иә.
Dialogue: 0,0:06:52.43,0:06:54.43,Default,,0,0,0,,Уф... Ауырды ма?
Dialogue: 0,0:06:54.43,0:06:57.43,Default,,0,0,0,,Иә, менде бәрі жақсы. Шынымен бе?
Dialogue: 0,0:06:57.43,0:07:02.44,Default,,0,0,0,,Иә. Ол ақырында емделеді. Кешіріңіз, бәріне менің кінәм...
Dialogue: 0,0:07:02.44,0:07:06.44,Default,,0,0,0,,Хехехе... Әдетте, тағамдар үшін бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:07:06.44,0:07:09.45,Default,,0,0,0,,Біреу ренжіп қалса, уайымдау қалыпты жағдай!
Dialogue: 0,0:07:09.45,0:07:12.45,Default,,0,0,0,,Сен де, бұрынғы жігіт те біртүрлі екенсің.
Dialogue: 0,0:07:12.45,0:07:14.45,Default,,0,0,0,,Егер сізге шабуыл жасалса, сіз ақша жоғалтасыз.
Dialogue: 0,0:07:14.45,0:07:17.45,Default,,0,0,0,,Егер сіз шығынға ұшырасаңыз және шабуыл жасасаңыз, сіз пайда аласыз.
Dialogue: 0,0:07:17.45,0:07:19.46,Default,,0,0,0,,Қарапайым ережелер.
Dialogue: 0,0:07:19.46,0:07:22.46,Default,,0,0,0,,Қауіпті сезінудің жоқтығы, көріп тұрмын.
Dialogue: 0,0:07:24.46,0:07:30.47,Default,,0,0,0,,Мен оны толық түсінбеймін, бірақ қалай күресу керектігін айтыңызшы.
Dialogue: 0,0:07:30.47,0:07:32.47,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:34.47,0:07:36.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:39.48,0:07:43.48,Default,,0,0,0,,Уф! Уф… аа….
Dialogue: 0,0:07:43.48,0:07:47.50,Default,,0,0,0,,Шиншу! Жақында сауығып кетеді...
Dialogue: 0,0:07:47.50,0:07:49.42,Default,,0,0,0,,（）
Dialogue: 0,0:07:49.42,0:07:51.42,Default,,0,0,0,,Гиг Аяқтаңыз! →
Dialogue: 0,0:07:51.42,0:07:53.42,Default,,0,0,0,,Микро 5 млн.
Dialogue: 0,0:07:53.42,0:07:55.42,Default,,0,0,0,,«Микро»!
Dialogue: 0,0:08:02.43,0:08:05.43,Default,,0,0,0,,Kimimaro Invest! Картаны кесіңіз!
Dialogue: 0,0:08:05.43,0:08:07.44,Default,,0,0,0,,Уф… Ой, жоқ!
Dialogue: 0,0:08:07.44,0:08:09.44,Default,,0,0,0,,Мезофляция 10 миллион! Келесі!
Dialogue: 0,0:08:09.44,0:08:11.44,Default,,0,0,0,,«Мезофляция»!
Dialogue: 0,0:08:11.44,0:08:14.44,Default,,0,0,0,,Мезофляция 10 миллион!
Dialogue: 0,0:08:14.44,0:08:16.45,Default,,0,0,0,,「ＳＣＯＲＣＨＥＤ ＥＡＲＴＨ」！
Dialogue: 0,0:08:16.45,0:08:36.47,Default,,0,0,0,,Сен
Dialogue: 0,0:08:36.47,0:08:39.47,Default,,0,0,0,,ＳＣＯＲＣＨＥＤ ＥＡＲＴＨ！
Dialogue: 0,0:08:39.47,0:08:57.42,Default,,0,0,0,,Сен
Dialogue: 0,0:08:57.42,0:09:00.42,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:03.43,0:09:06.43,Default,,0,0,0,,Мезофляция керемет!
Dialogue: 0,0:09:09.43,0:09:11.43,Default,,0,0,0,,Керемет!
Dialogue: 0,0:09:11.43,0:09:14.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:14.44,0:09:18.44,Default,,0,0,0,,Маған не істедің.
Dialogue: 0,0:09:18.44,0:09:21.44,Default,,0,0,0,,「ＣＬＯＳＩＮＧ」
Dialogue: 0,0:09:21.44,0:09:23.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:23.45,0:09:25.45,Default,,0,0,0,,«Сізде пайда бар» Иә?
Dialogue: 0,0:09:25.45,0:09:27.45,Default,,0,0,0,,Жеңісіңіз құтты болсын.
Dialogue: 0,0:09:27.45,0:09:29.45,Default,,0,0,0,,Шиншу ше?
Dialogue: 0,0:09:29.45,0:09:32.45,Default,,0,0,0,,Сіз жеңдіңіз. Ерен еңбегіңіз үшін рахмет.
Dialogue: 0,0:09:32.45,0:09:35.46,Default,,0,0,0,,Жоқ, мен Шиншуға не болғанын сұрадым!
Dialogue: 0,0:09:35.46,0:09:37.46,Default,,0,0,0,,Сіз активтерді айтасыз ба?
Dialogue: 0,0:09:37.46,0:09:39.46,Default,,0,0,0,,Дұрыс, бұл Шиншу!
Dialogue: 0,0:09:39.46,0:09:41.46,Default,,0,0,0,,Сіз қауіпсізсіз.
Dialogue: 0,0:09:43.47,0:09:46.47,Default,,0,0,0,,көремін. Амансың ба?
Dialogue: 0,0:09:46.47,0:09:48.40,Default,,0,0,0,,Жақсы….
Dialogue: 0,0:09:48.40,0:09:50.41,Default,,0,0,0,,Жақында тағы кездесеміз. →
Dialogue: 0,0:09:50.41,0:09:52.41,Default,,0,0,0,,Енді келесі мәмілеге кандидатураңызға қатысты...
Dialogue: 0,0:09:52.41,0:09:54.41,Default,,0,0,0,,Әй... (Масақағи) Әй, ой, ой.
Dialogue: 0,0:09:54.41,0:09:56.41,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:09:56.41,0:09:58.41,Default,,0,0,0,,Йога мырза? →
Dialogue: 0,0:09:58.41,0:10:01.42,Default,,0,0,0,,О ла ла ла ла. Сіз қатты шаршаған болуыңыз керек. →
Dialogue: 0,0:10:01.42,0:10:04.42,Default,,0,0,0,,Менің таңдауым жоқ. Бұл жолы сізге ерекше бір нәрсе жіберуге рұқсат етіңіз.
Dialogue: 0,0:10:04.42,0:10:09.42,Default,,0,0,0,,Ол жаңадан келген жас жігіт. (Еркек) Мен активтерге ие болдым.
Dialogue: 0,0:10:09.42,0:10:11.43,Default,,0,0,0,,Саған жақсы, Микуни-сан.
Dialogue: 0,0:10:11.43,0:10:13.43,Default,,0,0,0,,Не?
Dialogue: 0,0:10:13.43,0:10:16.43,Default,,0,0,0,,Сіз ол баланы жақтадыңыз, солай ма?
Dialogue: 0,0:10:16.43,0:10:19.43,Default,,0,0,0,,Сіз бір нәрсені дұрыс түсінбей жатқан сияқтысыз.
Dialogue: 0,0:10:19.43,0:10:21.44,Default,,0,0,0,,Қанша уақыт болды деп ойлаймын. →
Dialogue: 0,0:10:21.44,0:10:24.44,Default,,0,0,0,,Кенеттен мәміле жасауға мәжбүр болған адам жеңді.
Dialogue: 0,0:10:26.44,0:10:30.45,Default,,0,0,0,,Сіз жеңдіңіз. Q.
Dialogue: 0,0:10:30.45,0:10:33.45,Default,,0,0,0,,Мен сол адамның жеңіске жету мүмкіндігі туралы ойлаймын→
Dialogue: 0,0:10:33.45,0:10:35.45,Default,,0,0,0,,Мен оны лақтыра алмадым.
Dialogue: 0,0:10:37.45,0:10:39.45,Default,,0,0,0,,Менің жадымда→
Dialogue: 0,0:10:39.45,0:10:43.46,Default,,0,0,0,,Ештеңені білмей мәмілеге қатысып, ұтқандар →
Dialogue: 0,0:10:43.46,0:10:45.46,Default,,0,0,0,,Сізден бері. →
Dialogue: 0,0:10:45.46,0:10:49.46,Default,,0,0,0,,Сіз де сол кезде маған көмектесуге тырыстыңыз.
Dialogue: 0,0:10:52.40,0:10:54.40,Default,,0,0,0,,Сол жігіт →
Dialogue: 0,0:10:54.40,0:10:58.41,Default,,0,0,0,,Мен сияқты боламын дейсің бе? Q.
Dialogue: 0,0:10:58.41,0:11:01.41,Default,,0,0,0,,Оны болжау мүмкін емес.
Dialogue: 0,0:11:05.41,0:11:07.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:07.42,0:11:09.42,Default,,0,0,0,,Үш патшалық.
Dialogue: 0,0:11:11.42,0:11:14.42,Default,,0,0,0,,Мен оның Дильді көру үшін келгеніне сене алар емеспін.
Dialogue: 0,0:11:14.42,0:11:17.43,Default,,0,0,0,,Сәлем? (Итанеда) Фуфуфуфу…. →
Dialogue: 0,0:11:17.43,0:11:20.43,Default,,0,0,0,,Сендер, үндемеңдер!➡
Dialogue: 0,0:11:26.44,0:11:28.44,Default,,0,0,0,,Құдайға шүкір.
Dialogue: 0,0:11:28.44,0:11:31.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:31.45,0:11:33.45,Default,,0,0,0,,Фу.
Dialogue: 0,0:11:34.45,0:11:38.45,Default,,0,0,0,,Бұл арман емес. Апыр-ай!
Dialogue: 0,0:11:38.45,0:11:41.45,Default,,0,0,0,,Бұл сіздің бірінші рет болғаныңыз үшін үлкен жетістік емес пе?
Dialogue: 0,0:11:41.45,0:11:43.46,Default,,0,0,0,,Біріншіден, жеңістің кейінгі нұрынан ләззат алыңыз.
Dialogue: 0,0:11:43.46,0:11:46.46,Default,,0,0,0,,Қалжыңдамаңыз. Кім ләззат ала алады!
Dialogue: 0,0:11:46.46,0:11:49.46,Default,,0,0,0,,Маған осы дүниедегі уақытыңды бер →
Dialogue: 0,0:11:49.46,0:11:53.47,Default,,0,0,0,,Бұл тек саяхат уақытына арналған. Күнделікті өмірде ешқандай проблема жоқ.
Dialogue: 0,0:11:53.47,0:11:56.47,Default,,0,0,0,,Мен сені бір аптадан кейін алып кетуге қайтамын.
Dialogue: 0,0:11:56.47,0:11:58.47,Default,,0,0,0,,Сіз тағы да өлейін деп жатырсыз ба?
Dialogue: 0,0:11:58.47,0:12:00.47,Default,,0,0,0,,Бұл менің шешімім емес еді.
Dialogue: 0,0:12:00.47,0:12:02.48,Default,,0,0,0,,Сонда кім? Ол шешілді.
Dialogue: 0,0:12:02.48,0:12:06.48,Default,,0,0,0,,Ал, мен не істеуім керек? Сіз әдеттегідей жалғастыра аласыз.
Dialogue: 0,0:12:06.48,0:12:08.48,Default,,0,0,0,,Ақшаңызды өзіңіз қалағандай пайдаланыңыз.
Dialogue: 0,0:12:08.48,0:12:10.48,Default,,0,0,0,,Бұл басқа сөздердің қажетсіз екенін білдірмейді, бірақ→
Dialogue: 0,0:12:10.48,0:12:14.49,Default,,0,0,0,,Көпшілік сенбейді, сондықтан үндемеу қауіпсіз деп ойлаймын.
Dialogue: 0,0:12:14.49,0:12:17.49,Default,,0,0,0,,Олай болса.
Dialogue: 0,0:12:17.49,0:12:19.49,Default,,0,0,0,,А, иә, Мидас картасы арқылы→
Dialogue: 0,0:12:19.49,0:12:22.50,Default,,0,0,0,,Сіз сондай-ақ активтермен сөйлесе аласыз, сондықтан қажет болса, еркін сөйлесіңіз.
Dialogue: 0,0:12:22.50,0:12:24.50,Default,,0,0,0,,Әңгімелесу?
Dialogue: 0,0:12:27.43,0:12:29.44,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,0:12:29.44,0:12:32.44,Default,,0,0,0,,Бұл біртүрлі. Сіз сөйлемейсіз.
Dialogue: 0,0:12:35.44,0:12:38.45,Default,,0,0,0,,Сіз өте жақсы жұмыс істеп жатырсыз.
Dialogue: 0,0:12:38.45,0:12:40.45,Default,,0,0,0,,Шынайы.
Dialogue: 0,0:12:40.45,0:12:43.45,Default,,0,0,0,,...
Dialogue: 0,0:12:43.45,0:12:45.52,Default,,0,0,0,,Мен жай ғана активпін.
Dialogue: 0,0:12:45.52,0:12:48.46,Default,,0,0,0,,...
Dialogue: 0,0:12:48.46,0:12:51.46,Default,,0,0,0,,…
Dialogue: 0,0:12:51.46,0:12:56.46,Default,,0,0,0,,...
Dialogue: 0,0:12:56.46,0:13:00.47,Default,,0,0,0,,Жарайды, егер саған бірдеңе керек болса, маған хабарлас. «Моши-моши» дегеннің қажеті жоқ.
Dialogue: 0,0:13:00.47,0:13:02.47,Default,,0,0,0,,...
Dialogue: 0,0:13:02.47,0:13:05.47,Default,,0,0,0,,Ха... Неге екені белгісіз, қобалжыдым.
Dialogue: 0,0:13:05.47,0:13:07.47,Default,,0,0,0,,Бұл байланысты. Апыр-ай!
Dialogue: 0,0:13:07.47,0:13:09.48,Default,,0,0,0,,Сіз әлі де сондасыз ба? ? Мен сонда болдым.
Dialogue: 0,0:13:09.48,0:13:12.48,Default,,0,0,0,,Мен оны тоқтата алмаймын.
Dialogue: 0,0:13:12.48,0:13:15.48,Default,,0,0,0,,Егер сіз банкротқа ұшырасаңыз, сізді қаржылық ауданнан қуып жібереді.
Dialogue: 0,0:13:15.48,0:13:18.49,Default,,0,0,0,,Нәтижесінде бұл дүниеде қатал болады→
Dialogue: 0,0:13:18.49,0:13:20.49,Default,,0,0,0,,Жақсы, біз сенімді мәмілелер жасай аламыз деп үміттенемін→
Dialogue: 0,0:13:20.49,0:13:22.49,Default,,0,0,0,,Ұсынылады. Және... иә?
Dialogue: 0,0:13:22.49,0:13:25.49,Default,,0,0,0,,Әлем басқаша көрінеді.
Dialogue: 0,0:13:27.43,0:13:29.43,Default,,0,0,0,,Бір күні.
Dialogue: 0,0:13:29.43,0:13:33.43,Default,,0,0,0,,（）
Dialogue: 0,0:13:35.44,0:13:38.44,Default,,0,0,0,,«Оны алуды ұмытпау үшін абай болыңыз.» иә?
Dialogue: 0,0:13:38.44,0:13:40.44,Default,,0,0,0,,«Біздің қызметті пайдаланғаныңыз үшін рахмет».
Dialogue: 0,0:13:44.44,0:13:49.44,Default,,0,0,0,,Жүз… 33,5 миллион иен! ?
Dialogue: 0,0:13:58.46,0:14:00.46,Default,,0,0,0,,О! Сіз бүгін әдемі көрінесіз.
Dialogue: 0,0:14:00.46,0:14:02.46,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:14:02.46,0:14:05.47,Default,,0,0,0,,Сабақ кезінде сабақ оқымау әдеттен тыс жағдай емес пе?
Dialogue: 0,0:14:05.47,0:14:08.47,Default,,0,0,0,,Бөлек. Мен аздап шаршадым.
Dialogue: 0,0:14:08.47,0:14:11.47,Default,,0,0,0,,Менің банктік картама немесе бір нәрсеге қараңыз.
Dialogue: 0,0:14:11.47,0:14:13.47,Default,,0,0,0,,Ах! Дұрыс, Ханахи. иә?
Dialogue: 0,0:14:13.47,0:14:16.48,Default,,0,0,0,,Егер сізде 10 миллион болса, оны не үшін пайдаланар едіңіз?
Dialogue: 0,0:14:16.48,0:14:18.48,Default,,0,0,0,,Үнемдеу. Менің ойымша, бұл дұрыс.
Dialogue: 0,0:14:18.48,0:14:21.48,Default,,0,0,0,,Біз не болатынын білмейтін заманда өмір сүріп жатырмыз. →
Dialogue: 0,0:14:21.48,0:14:25.42,Default,,0,0,0,,Төтенше жағдайларға ақша жинауым керек.
Dialogue: 0,0:14:25.42,0:14:28.42,Default,,0,0,0,,2 жас 3 айлық нәрестені тұншықтырғаны үшін айыпталған→
Dialogue: 0,0:14:28.42,0:14:31.42,Default,,0,0,0,,Сайтама префектурасының полициясы... (Ханаби) Тағы да?
Dialogue: 0,0:14:31.42,0:14:34.43,Default,,0,0,0,,Шынымен, мен не болатынын білмеймін.
Dialogue: 0,0:14:34.43,0:14:37.43,Default,,0,0,0,,Peyton компаниясының төрағасы Далластан.
Dialogue: 0,0:14:37.43,0:14:41.43,Default,,0,0,0,,Бұл 29 жаста. Бұл қызықты.
Dialogue: 0,0:14:41.43,0:14:44.44,Default,,0,0,0,,Төраға ретінде, Фокс МакКламана→
Dialogue: 0,0:14:44.44,0:14:47.44,Default,,0,0,0,,Олардан құтылуға тырысатын сияқты.
Dialogue: 0,0:14:47.44,0:14:51.44,Default,,0,0,0,,Сіз өзіңіздің бәсекелес компанияңызды ұятқа қалдыру үшін мені пайдаланғыңыз келе ме?
Dialogue: 0,0:14:51.44,0:14:53.45,Default,,0,0,0,,Айтпақшы, қоғамдық жұмыстар жобасына қатысты →
Dialogue: 0,0:14:53.45,0:14:56.45,Default,,0,0,0,,Жергілікті жерде күшті оппозиция бар, қазіргі үкімет те құлықсыз.
Dialogue: 0,0:14:56.45,0:14:59.45,Default,,0,0,0,,Бұл ұзақ мерзімді перспективада заттарды көре алмайтын қарапайым адамдар.
Dialogue: 0,0:14:59.45,0:15:01.45,Default,,0,0,0,,Мемлекеттік сектор жақсы болмаса, жеке сектор жақсы. →
Dialogue: 0,0:15:01.45,0:15:03.46,Default,,0,0,0,,Тек ақшаны жұмсаңыз.
Dialogue: 0,0:15:03.46,0:15:05.46,Default,,0,0,0,,Алайда жеке тұтынудың өсімі байқалмады...
Dialogue: 0,0:15:05.46,0:15:09.46,Default,,0,0,0,,Біз ғана емес, барлық жерде.
Dialogue: 0,0:15:09.46,0:15:12.47,Default,,0,0,0,,Оның үстіне бұл тек Жапонияда ғана емес, әлемдік үрдіс.
Dialogue: 0,0:15:12.47,0:15:15.47,Default,,0,0,0,,Ол қол жетпейтін жерде болмауы керек.
Dialogue: 0,0:15:15.47,0:15:20.47,Default,,0,0,0,,Жеке тұтыну туралы алаңдамаңыз. Қолымнан келгенше жинақтайын. →
Dialogue: 0,0:15:20.47,0:15:24.41,Default,,0,0,0,,Бір күні толқын өзгереді. Ол уақыт ақыры келеді. →
Dialogue: 0,0:15:24.41,0:15:29.42,Default,,0,0,0,,Иә. Бұл анық. →
Dialogue: 0,0:15:29.42,0:15:32.42,Default,,0,0,0,,Міне. (Еркек) Кешіріңіз.
Dialogue: 0,0:15:32.42,0:15:35.42,Default,,0,0,0,,Сіз оны қарап шықтыңыз ба? (Ихаги) Иә. →
Dialogue: 0,0:15:35.42,0:15:40.43,Default,,0,0,0,,Кимимаро Йога 19 жаста. Мен Хэйсэй экономика университетінің екінші курс студентімін. →
Dialogue: 0,0:15:40.43,0:15:42.43,Default,,0,0,0,,Сіздің үйдегі жағдай күрделі сияқты→
Dialogue: 0,0:15:42.43,0:15:44.43,Default,,0,0,0,,Оған ұқсас ештеңе жоқ.
Dialogue: 0,0:15:44.43,0:15:48.43,Default,,0,0,0,,Жақсы немесе жаман жақтары жоқ...
Dialogue: 0,0:15:51.44,0:15:53.44,Default,,0,0,0,,Сенің үрейленетін кез келді.
Dialogue: 0,0:15:56.44,0:15:59.45,Default,,0,0,0,,Қош келдіңіз. (Орта мектеп оқушысы) Бұл.
Dialogue: 0,0:15:59.45,0:16:01.45,Default,,0,0,0,,Бұл не? иә?
Dialogue: 0,0:16:01.45,0:16:03.45,Default,,0,0,0,,Бұл қате, солай ма?
Dialogue: 0,0:16:03.45,0:16:06.45,Default,,0,0,0,,Иә? Бұл танымал ойыншық па?
Dialogue: 0,0:16:06.45,0:16:09.46,Default,,0,0,0,,Бұл небәрі 1000 иен. хе! ?
Dialogue: 0,0:16:09.46,0:16:11.46,Default,,0,0,0,,Бұл дұрыс 1000 иен!
Dialogue: 0,0:16:11.46,0:16:14.46,Default,,0,0,0,,Мені мазақ етпе.
Dialogue: 0,0:16:14.46,0:16:17.46,Default,,0,0,0,,Кешіріңіз! Бұл адам біртүрлі!
Dialogue: 0,0:16:19.47,0:16:22.47,Default,,0,0,0,,Бұл 238 иен. Өзгеріс 762 иен болады. →
Dialogue: 0,0:16:22.47,0:16:25.41,Default,,0,0,0,,Сізге сөмке керек пе? (Жоғары сынып оқушысы) Оны сол күйінде қалдырыңыз.
Dialogue: 0,0:16:25.41,0:16:27.41,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:16:27.41,0:16:29.41,Default,,0,0,0,,Эй, сен әлі жартылай ұйықтап жатырсың ба?
Dialogue: 0,0:16:29.41,0:16:32.41,Default,,0,0,0,,Эй, сәл күте тұрыңыз! Ол неге ұқсайды?
Dialogue: 0,0:16:32.41,0:16:35.42,Default,,0,0,0,,А? Жарайды!
Dialogue: 0,0:16:35.42,0:16:39.42,Default,,0,0,0,,Мың иен. Сонымен бұл не?
Dialogue: 0,0:16:39.42,0:16:43.42,Default,,0,0,0,,Небәрі 1000 иен болса да! 《Е! 》
Dialogue: 0,0:16:43.42,0:16:47.43,Default,,0,0,0,,Нашар Біраз дәретхана. иә?
Dialogue: 0,0:16:47.43,0:16:50.43,Default,,0,0,0,,Шиншу Не болып жатыр! ?
Dialogue: 0,0:16:52.43,0:16:57.44,Default,,0,0,0,,Оңай айтпа. Бұл жиіркенішті, солай емес пе?
Dialogue: 0,0:16:57.44,0:16:59.44,Default,,0,0,0,,Бірақ бұл біртүрлі.
Dialogue: 0,0:17:01.44,0:17:05.45,Default,,0,0,0,,Бұл оның қаржылық ауданнан қалыпты әлемге ағып жатқанын білдіре ме?
Dialogue: 0,0:17:05.45,0:17:07.45,Default,,0,0,0,,Оны пайдаланғанда не болады?
Dialogue: 0,0:17:16.46,0:17:19.46,Default,,0,0,0,,Сәлем! Апыр-ай! Не?
Dialogue: 0,0:17:19.46,0:17:22.46,Default,,0,0,0,,Мәміле жасағыңыз келмесе, оны ертерек жасаңыз.
Dialogue: 0,0:17:22.46,0:17:24.40,Default,,0,0,0,,Ұрысқысы келмейтін адам болса да, шегі бар →
Dialogue: 0,0:17:24.40,0:17:27.40,Default,,0,0,0,,Сонымен қатар, бұл да көп энергияны жұмсайды.
Dialogue: 0,0:17:27.40,0:17:30.40,Default,,0,0,0,,Уау! Ол аурады. кешіріңіз.
Dialogue: 0,0:17:32.41,0:17:34.41,Default,,0,0,0,,Ах.
Dialogue: 0,0:17:34.41,0:17:46.42,Default,,0,0,0,,Сен
Dialogue: 0,0:17:46.42,0:17:48.42,Default,,0,0,0,,Олай болса.
Dialogue: 0,0:17:52.43,0:17:54.43,Default,,0,0,0,,Хаа…. (Шимада) Не болды?
Dialogue: 0,0:17:54.43,0:17:56.43,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,0:17:56.43,0:17:59.43,Default,,0,0,0,,Қош келдіңіз. (Еркек) Иә, сөмкесіз.
Dialogue: 0,0:17:59.43,0:18:02.43,Default,,0,0,0,,Иә, мен 10 000 иенді сақтаймын.
Dialogue: 0,0:18:05.44,0:18:07.44,Default,,0,0,0,,Бұл 9803 иеннің қайтарымы. (Ер) Не?→
Dialogue: 0,0:18:07.44,0:18:10.44,Default,,0,0,0,,Ішінде 5000 иендік ақша жоқ па? Маған берші.
Dialogue: 0,0:18:10.44,0:18:13.45,Default,,0,0,0,,Жоқ, бұл. Неліктен олардың барлығы 1000 иендік купюралар?
Dialogue: 0,0:18:13.45,0:18:17.45,Default,,0,0,0,,Әмияныңыз қалың болуы керек! Бұл аздап лас.
Dialogue: 0,0:18:17.45,0:18:20.45,Default,,0,0,0,,Бұл әдемі алтын емес пе? Маған берші.
Dialogue: 0,0:18:20.45,0:18:22.46,Default,,0,0,0,,Тұтынушы, сабыр етіңіз. (Ер) Әй? Шулы қария!
Dialogue: 0,0:18:22.46,0:18:25.39,Default,,0,0,0,,Уау! Сен не істеп жатырсың?
Dialogue: 0,0:18:25.39,0:18:28.39,Default,,0,0,0,,Сөйлесуіңде не бар? Менеджер, шығарыңыз! Менеджер! →
Dialogue: 0,0:18:28.39,0:18:32.40,Default,,0,0,0,,Бұл ақша жақсы! Маған мына белгіні беріңіз!
Dialogue: 0,0:18:32.40,0:18:36.40,Default,,0,0,0,,Бұл туралы не деуге болады? (Ер) Әй?
Dialogue: 0,0:18:36.40,0:18:39.41,Default,,0,0,0,,Мен саған мына ақшаны беремін, кет деп айтамын.
Dialogue: 0,0:18:39.41,0:18:41.41,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:46.41,0:18:48.41,Default,,0,0,0,,Бұл мағынасы бар ма?
Dialogue: 0,0:18:48.41,0:18:51.42,Default,,0,0,0,,Хаха. Өкінбе.
Dialogue: 0,0:18:51.42,0:18:55.42,Default,,0,0,0,,Бетіңді көрмесем арзан.
Dialogue: 0,0:18:58.42,0:19:02.43,Default,,0,0,0,,Кешіріңіз. Бұл үшін рахмет.
Dialogue: 0,0:19:02.43,0:19:06.43,Default,,0,0,0,,Мынаны маған беріңізші? Бұл күндері менің бос уақытым аз.
Dialogue: 0,0:19:06.43,0:19:13.44,Default,,0,0,0,,Сонымен. Хахаха...!
Dialogue: 0,0:19:13.44,0:19:18.44,Default,,0,0,0,,Жоқ, кешіріңіз, бұл жаман болды. Мен оны аламын рақмет сізге.
Dialogue: 0,0:19:21.45,0:19:24.38,Default,,0,0,0,,Толық емес жұмыс күні? Кеш қалу қиын.
Dialogue: 0,0:19:24.38,0:19:27.39,Default,,0,0,0,,Бірақ мен оған үйреніп қалдым.
Dialogue: 0,0:19:27.39,0:19:32.39,Default,,0,0,0,,Қара алтынға үйренбегенсің бе? Ах! Сен кімсің?
Dialogue: 0,0:19:32.39,0:19:36.40,Default,,0,0,0,,Мен сіздің келісіміңізді көрдім. Ардагерге қарсы жақсы шықтың.
Dialogue: 0,0:19:36.40,0:19:39.40,Default,,0,0,0,,Сіз солардың бірісіз бе?
Dialogue: 0,0:19:39.40,0:19:42.40,Default,,0,0,0,,Қаржылық ауданнан оралғандар үшін→
Dialogue: 0,0:19:42.40,0:19:45.47,Default,,0,0,0,,Қара алтынды ажырата білу.
Dialogue: 0,0:19:45.47,0:19:49.41,Default,,0,0,0,,Мидас ақшасы. Бұл банкноттарды Midas Bank шығарады.
Dialogue: 0,0:19:49.41,0:19:52.41,Default,,0,0,0,,Мидас ақшасы? Уайымдама.
Dialogue: 0,0:19:52.41,0:19:57.42,Default,,0,0,0,,Оны пайдалансаңыз, ештеңе болмайды.
Dialogue: 0,0:19:57.42,0:20:01.42,Default,,0,0,0,,Бірақ ол болашақты кепілге қойғанын айтты.
Dialogue: 0,0:20:01.42,0:20:03.42,Default,,0,0,0,,Ақшамен қамтамасыз етілетін болашақ та бар.
Dialogue: 0,0:20:03.42,0:20:07.43,Default,,0,0,0,,Мен осылай істеймін. Сен не істеп жатырсың?
Dialogue: 0,0:20:07.43,0:20:10.43,Default,,0,0,0,,Айтар болсам, ол ақша жұмсайтын адам.
Dialogue: 0,0:20:10.43,0:20:16.44,Default,,0,0,0,,Негізінен көп ақша жұмсайды. Егер бәрі жақсы болса, сіз де жасай аласыз.
Dialogue: 0,0:20:16.44,0:20:19.44,Default,,0,0,0,,Иә. Маған көп ақша керек емес.
Dialogue: 0,0:20:19.44,0:20:21.44,Default,,0,0,0,,Қалыпты табыс тауып, қалыпты отбасын құра алсаңыз→
Dialogue: 0,0:20:21.44,0:20:25.38,Default,,0,0,0,,Жақсы! Қалыпты жақсы ма?
Dialogue: 0,0:20:25.38,0:20:28.38,Default,,0,0,0,,Қарапайым адамдардың қарапайымды ұстанғанында не айып?
Dialogue: 0,0:20:28.38,0:20:30.38,Default,,0,0,0,,Төбелестен қашу.
Dialogue: 0,0:20:30.38,0:20:34.39,Default,,0,0,0,,Бұл қалыпты нәрселерге ерекше көңіл бөлетін адамдардың сөзі. Сіз де солайсыз ба?
Dialogue: 0,0:20:34.39,0:20:36.39,Default,,0,0,0,,Сен не білесің?
Dialogue: 0,0:20:36.39,0:20:39.39,Default,,0,0,0,,Сіз жеңілгенді жек көрмейсіз бе?
Dialogue: 0,0:20:39.39,0:20:43.40,Default,,0,0,0,,Әкең сияқты. О... не?
Dialogue: 0,0:20:43.40,0:20:48.40,Default,,0,0,0,,Осыған ашулансаңыз, ата-анаңыздан қашып кеткіңіз келетін сияқты.
Dialogue: 0,0:20:48.40,0:20:50.40,Default,,0,0,0,,Сіз менің әкемді білесіз бе?
Dialogue: 0,0:20:52.41,0:20:55.41,Default,,0,0,0,,Қашпа. Өз мүмкіндіктеріңізге қараңыз.
Dialogue: 0,0:20:55.41,0:20:59.41,Default,,0,0,0,,Әр адамның дүниеге келуінің мәні бар.
Dialogue: 0,0:20:59.41,0:21:01.41,Default,,0,0,0,,Мейрам мырза.
Dialogue: 0,0:21:04.42,0:21:06.42,Default,,0,0,0,,Қалыпты болу дұрыс па?
Dialogue: 0,0:21:06.42,0:21:08.42,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:21:10.42,0:21:13.43,Default,,0,0,0,,Менің атым Соичиро Микуни.
Dialogue: 0,0:21:13.43,0:21:18.43,Default,,0,0,0,,Егер сіз қаласаңыз, мен сізге көмектесе аламын. →
Dialogue: 0,0:21:18.43,0:21:21.43,Default,,0,0,0,,Мен сені сол қалада күтемін.
Dialogue: 0,0:21:28.44,0:21:30.44,Default,,0,0,0,,Hmph.
Dialogue: 0,0:21:30.44,0:21:40.44,Default,,0,0,0,,Сен
Dialogue: 0,0:21:41.94,0:21:47.94,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory