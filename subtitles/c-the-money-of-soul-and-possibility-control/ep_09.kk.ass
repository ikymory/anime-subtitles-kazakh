Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:03:54.55,0:03:56.55,Default,,0,0,0,,Біз сізді күттік.
Dialogue: 0,0:03:58.55,0:04:00.22,Default,,0,0,0,,Мен мұны пайдаланғым келеді.
Dialogue: 0,0:04:00.22,0:04:03.52,Default,,0,0,0,,О... қараңғылық.
Dialogue: 0,0:04:06.46,0:04:09.46,Default,,0,0,0,,Бірақ бұл жақсы. →
Dialogue: 0,0:04:09.46,0:04:13.47,Default,,0,0,0,,Біріншіден, мен саған болашағыңның 20 жылын беремін.
Dialogue: 0,0:04:13.47,0:04:15.47,Default,,0,0,0,,Маған бәрібір. (Масакаги) Оны айналдырғаннан кейін →
Dialogue: 0,0:04:15.47,0:04:18.47,Default,,0,0,0,,Маған не болатынын хабарлай аласыз ба?
Dialogue: 0,0:04:18.47,0:04:21.48,Default,,0,0,0,,Асығыңыз. Мен мұны істеп жатқанда →
Dialogue: 0,0:04:21.48,0:04:23.48,Default,,0,0,0,,Тізбек кеңеюде.
Dialogue: 0,0:04:35.49,0:04:37.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:00.21,0:05:03.45,Default,,0,0,0,,«Сингапур» →
Dialogue: 0,0:05:03.45,0:05:05.45,Default,,0,0,0,,Ол жоғалып кетті ме?
Dialogue: 0,0:05:20.47,0:05:25.47,Default,,0,0,0,,Гонконг тек құтылды ма? →
Dialogue: 0,0:05:25.47,0:05:27.47,Default,,0,0,0,,Келесі...
Dialogue: 0,0:05:27.47,0:05:31.48,Default,,0,0,0,,Жапонияның тікелей соққыдан аман қалуы екіталай.
Dialogue: 0,0:05:31.48,0:05:33.48,Default,,0,0,0,,Қосымша кірістер кестеге сай ма?
Dialogue: 0,0:05:33.48,0:05:35.48,Default,,0,0,0,,Иә, бәрі жақсы жүріп жатыр.
Dialogue: 0,0:05:35.48,0:05:39.49,Default,,0,0,0,,Қаражат көзі ешқашан белгісіз болады.
Dialogue: 0,0:05:39.49,0:05:43.49,Default,,0,0,0,,Кішкентай тізбек әлі екі-үш рет келетін сияқты.
Dialogue: 0,0:06:00.44,0:06:04.44,Default,,0,0,0,,Шанхай аздап алынды ма? Келесі...
Dialogue: 0,0:06:06.45,0:06:11.45,Default,,0,0,0,,Бұл сирек. Мұндай көрініс...
Dialogue: 0,0:06:11.45,0:06:13.22,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:13.22,0:06:15.46,Default,,0,0,0,,Егер одан әрі тізбек болмаса, ірі банктермен→
Dialogue: 0,0:06:15.46,0:06:18.46,Default,,0,0,0,,Отандық топ-компаниялардың 80% дейін→
Dialogue: 0,0:06:18.46,0:06:20.46,Default,,0,0,0,,Біз жеткілікті қаражат жинай алдық.
Dialogue: 0,0:06:20.46,0:06:22.46,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:22.46,0:06:25.47,Default,,0,0,0,,Балалар сендер де жақсы жұмыс жасадыңдар. (Синдо) Жоқ. →
Dialogue: 0,0:06:25.47,0:06:27.47,Default,,0,0,0,,Бірақ соңғы итеруде→
Dialogue: 0,0:06:27.47,0:06:31.47,Default,,0,0,0,,Осыншама көп ақшаның бірден жиналуы таң қалдырды.
Dialogue: 0,0:06:31.47,0:06:35.48,Default,,0,0,0,,Онсыз біз болашақта қорғаныс шайқасында жеңе алмаймыз.
Dialogue: 0,0:06:35.48,0:06:38.48,Default,,0,0,0,,Жер бетінде қалай?
Dialogue: 0,0:06:38.48,0:06:43.48,Default,,0,0,0,,Сізге қажет кез келген соманы алыңыз. →
Dialogue: 0,0:06:43.48,0:06:46.48,Default,,0,0,0,,Қалағаныңызша көп көшірме басып шығаруға болады.
Dialogue: 0,0:06:58.43,0:07:18.45,Default,,0,0,0,,Сен
Dialogue: 0,0:07:18.45,0:07:24.46,Default,,0,0,0,,Сен
Dialogue: 0,0:07:24.46,0:07:29.46,Default,,0,0,0,,(Айналмалы басудың жүрек соғу дыбысы)
Dialogue: 0,0:07:31.46,0:07:35.47,Default,,0,0,0,,(Айналмалы баспасөз айқайлайды)
Dialogue: 0,0:07:35.47,0:07:39.47,Default,,0,0,0,,Осы жерді басыңыз. Ұнады ма? →
Dialogue: 0,0:07:39.47,0:07:42.48,Default,,0,0,0,,Бұл Midas Bank айналмалы пресі.
Dialogue: 0,0:07:42.48,0:07:44.48,Default,,0,0,0,,Жақын жерде тексеріңіз.
Dialogue: 0,0:07:47.48,0:07:49.48,Default,,0,0,0,,Қолды алға.
Dialogue: 0,0:07:52.49,0:07:56.86,Default,,0,0,0,,Оны маңдайыңыздан ұстаңыз.
Dialogue: 0,0:07:56.86,0:07:59.53,Default,,0,0,0,,Уф! бұл! ?
Dialogue: 0,0:07:59.53,0:08:01.53,Default,,0,0,0,,Сіз оны көрген сияқтысыз. →
Dialogue: 0,0:08:01.53,0:08:05.53,Default,,0,0,0,,Болашақ Midas Money эмиссиясының орнына жоғалады.
Dialogue: 0,0:08:05.53,0:08:09.53,Default,,0,0,0,,(Айналмалы басу айқайы)
Dialogue: 0,0:08:11.54,0:08:17.54,Default,,0,0,0,,(Масакагидің күлкісі)
Dialogue: 0,0:08:19.55,0:08:22.55,Default,,0,0,0,,Ой! не?
Dialogue: 0,0:08:24.55,0:08:26.55,Default,,0,0,0,,Ауырды.
Dialogue: 0,0:08:29.56,0:08:32.56,Default,,0,0,0,,(Айналмалы баспасөз айқайлайды)
Dialogue: 0,0:08:32.56,0:08:35.56,Default,,0,0,0,,Ал, хехе... →
Dialogue: 0,0:08:35.56,0:08:38.57,Default,,0,0,0,,Мен оны әдеттегі шотыңызға аударамын!
Dialogue: 0,0:08:38.57,0:08:51.57,Default,,0,0,0,,(Масакагидің күлкісі)
Dialogue: 0,0:08:53.58,0:08:56.52,Default,,0,0,0,,Қызықсыз нәрселерді тыңдамаңыз. Мен оны қорғай аламын.
Dialogue: 0,0:08:56.52,0:08:59.52,Default,,0,0,0,,Сондықтан біз жұмыс істеп жатырмыз.
Dialogue: 0,0:09:07.53,0:09:10.53,Default,,0,0,0,,Бұл өте ақымақ...
Dialogue: 0,0:09:12.53,0:09:14.53,Default,,0,0,0,,Келдің бе?
Dialogue: 0,0:09:14.53,0:09:16.54,Default,,0,0,0,,Токио нарығы күнделікті ең төменгі деңгейде. →
Dialogue: 0,0:09:16.54,0:09:19.54,Default,,0,0,0,,Баға диапазонының лимитінің кеңейтілген қарызы алынды →
Dialogue: 0,0:09:19.54,0:09:22.54,Default,,0,0,0,,Таңертеңгі сауда бұл шектен асып кетті→
Dialogue: 0,0:09:22.54,0:09:25.55,Default,,0,0,0,,Құлдырау жалғасуда. (Қызметкерлер) А... аа....
Dialogue: 0,0:09:25.55,0:09:28.55,Default,,0,0,0,,Сатып алыңыз! Сатып ал, сатып ал, сатып ал! →
Dialogue: 0,0:09:28.55,0:09:30.55,Default,,0,0,0,,Қаражаттың шексіз мөлшері бар! →
Dialogue: 0,0:09:30.55,0:09:33.55,Default,,0,0,0,,Жапония! Мүмкіндігінше көп компаниялар→
Dialogue: 0,0:09:33.55,0:09:35.56,Default,,0,0,0,,Сатып алыңыз және қолдаңыз!
Dialogue: 0,0:09:35.56,0:09:37.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:39.56,0:09:41.16,Default,,0,0,0,,О!
Dialogue: 0,0:09:42.80,0:09:44.56,Default,,0,0,0,,Бұл жеткілікті. Мен мұны сатып алдым!
Dialogue: 0,0:09:44.56,0:09:46.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:47.80,0:09:49.57,Default,,0,0,0,,О!
Dialogue: 0,0:09:49.57,0:09:52.57,Default,,0,0,0,,Сақтықты төмендетпеңіз! (Ер) Иә!
Dialogue: 0,0:09:52.57,0:09:56.51,Default,,0,0,0,,Сіз оны қорғай аласыз ба?
Dialogue: 0,0:09:56.51,0:09:58.51,Default,,0,0,0,,Әрине!
Dialogue: 0,0:10:00.51,0:10:03.51,Default,,0,0,0,,Ол шыдай ма? Дәл осылай...
Dialogue: 0,0:10:10.52,0:10:12.53,Default,,0,0,0,,Үш патшалық. →
Dialogue: 0,0:10:12.53,0:10:15.53,Default,,0,0,0,,Сіз кесіп өтуге болмайтын сызық бар ...
Dialogue: 0,0:10:29.54,0:10:31.54,Default,,0,0,0,,Ол жоғалып кетті ме?
Dialogue: 0,0:10:31.54,0:10:35.55,Default,,0,0,0,,Шырылдау….
Dialogue: 0,0:10:35.55,0:10:39.55,Default,,0,0,0,,Ол тоқтады. Құттықтаймыз!
Dialogue: 0,0:10:39.55,0:10:44.55,Default,,0,0,0,,Мен сені қорғадым. Қазір.
Dialogue: 0,0:10:46.56,0:10:51.56,Default,,0,0,0,,Айтпақшы, төлем көрсетілген күн мен уақытта бір реттік сомаға төленеді. →
Dialogue: 0,0:10:51.56,0:10:55.56,Default,,0,0,0,,Жақсы, солай ма?
Dialogue: 0,0:11:00.51,0:11:02.18,Default,,0,0,0,,Төлем?
Dialogue: 0,0:11:02.18,0:11:04.84,Default,,0,0,0,,Әрине. Осы уақыттың орнына.
Dialogue: 0,0:11:04.84,0:11:06.44,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:25.54,0:11:29.54,Default,,0,0,0,,Сонымен, Жапонияны осындай «С» құбылысы жасады ма?
Dialogue: 0,0:11:29.54,0:11:32.54,Default,,0,0,0,,No Тізбекті тоқтату нәтижесі.
Dialogue: 0,0:11:32.54,0:11:34.55,Default,,0,0,0,,Нақты ЖІӨ екі есеге жуық қысқарды.
Dialogue: 0,0:11:34.55,0:11:38.55,Default,,0,0,0,,Сандар 1980 жылдардың басындағы деңгейге дейін төмендеді.
Dialogue: 0,0:11:38.55,0:11:40.55,Default,,0,0,0,,Сонша...
Dialogue: 0,0:11:40.55,0:11:44.56,Default,,0,0,0,,Микуни, бәлкім, мұның бәрі маңызды деп күліп тұрған шығар.
Dialogue: 0,0:11:44.56,0:11:48.56,Default,,0,0,0,,Не? Ол адам не істеді?
Dialogue: 0,0:11:48.56,0:11:50.56,Default,,0,0,0,,Сіз оны елестете аласыз, солай ма?
Dialogue: 0,0:11:50.56,0:11:54.57,Default,,0,0,0,,Ол Мидастың көп ақшасын салды.
Dialogue: 0,0:11:54.57,0:11:58.57,Default,,0,0,0,,Нәтиже Ағымдағы жағдай әзірше реттелді...
Dialogue: 0,0:11:58.57,0:12:01.57,Default,,0,0,0,,Бірнеше жыл... мүмкін 10 жылдан астам →
Dialogue: 0,0:12:01.57,0:12:04.58,Default,,0,0,0,,Осы елдің болашағына айырбас.
Dialogue: 0,0:12:04.58,0:12:08.58,Default,,0,0,0,,Бірақ сол себепті «С» тоқтады, солай ма?
Dialogue: 0,0:12:08.58,0:12:10.58,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:12:10.58,0:12:15.59,Default,,0,0,0,,Бірақ бұдан былай Микуни жасаған әрекеттің нәтижесінде не болады →
Dialogue: 0,0:12:15.59,0:12:17.59,Default,,0,0,0,,Ешкім білмейді.
Dialogue: 0,0:12:19.59,0:12:21.61,Default,,0,0,0,,Шиншу туралы Такетазаки ше?
Dialogue: 0,0:12:21.61,0:12:25.53,Default,,0,0,0,,Мен оны бұрыннан танығандай әрекет етті.
Dialogue: 0,0:12:25.53,0:12:28.53,Default,,0,0,0,,Бұрын? Мен бұдан артық ештеңе естіген жоқпын. →
Dialogue: 0,0:12:28.53,0:12:32.53,Default,,0,0,0,,Тікелей естісең жақсы болар еді деп ойладым.
Dialogue: 0,0:12:35.54,0:12:37.54,Default,,0,0,0,,Иә? аа.
Dialogue: 0,0:12:37.54,0:12:39.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:39.54,0:12:41.55,Default,,0,0,0,,Сіздің әкеңіз де қаржы ауданында екенін естідім.
Dialogue: 0,0:12:41.55,0:12:46.55,Default,,0,0,0,,А, иә. Шамасы, банкротқа ұшырап, жер аударылған.
Dialogue: 0,0:12:46.55,0:12:48.55,Default,,0,0,0,,Бұл да Такетазакиден бе?
Dialogue: 0,0:12:48.55,0:12:50.56,Default,,0,0,0,,Ах…. Мен... →
Dialogue: 0,0:12:50.56,0:12:54.56,Default,,0,0,0,,Бұған қатысы бар екені түсінікті нюанс болды.
Dialogue: 0,0:12:54.56,0:12:57.56,Default,,0,0,0,,Қайсысы жақсы, соя соусы немесе карри?
Dialogue: 0,0:12:57.56,0:13:00.57,Default,,0,0,0,,Карри. иә?
Dialogue: 0,0:13:00.57,0:13:03.57,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:13:03.57,0:13:05.57,Default,,0,0,0,,Мен оны келесі жолы саған әкелемін.
Dialogue: 0,0:13:07.57,0:13:09.57,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:13:09.57,0:13:11.58,Default,,0,0,0,,Йоганың активтері?
Dialogue: 0,0:13:11.58,0:13:14.58,Default,,0,0,0,,Оны көргіңіз келе ме? Сіз не көргіңіз келеді?
Dialogue: 0,0:13:14.58,0:13:17.58,Default,,0,0,0,,Фотосурет - менің хоббиім.
Dialogue: 0,0:13:17.58,0:13:19.58,Default,,0,0,0,,Га. Мен көремін! Маған көрсетіңізші!
Dialogue: 0,0:13:19.58,0:13:23.52,Default,,0,0,0,,Сәлем! Хехе….
Dialogue: 0,0:13:23.52,0:13:26.52,Default,,0,0,0,,Ах…. О, жоқ.
Dialogue: 0,0:13:28.53,0:13:30.53,Default,,0,0,0,,Міне.
Dialogue: 0,0:13:30.53,0:13:33.53,Default,,0,0,0,,Бұл... Менмін!
Dialogue: 0,0:13:33.53,0:13:37.54,Default,,0,0,0,,Жоқ, дәл солай болды, бірақ оның шашы қара, аты басқа.
Dialogue: 0,0:13:37.54,0:13:41.54,Default,,0,0,0,,Мен сенімдімін... Муа. Муа.
Dialogue: 0,0:13:41.54,0:13:43.54,Default,,0,0,0,,Бұл күшті болды. Бұл да ұқсас.
Dialogue: 0,0:13:43.54,0:13:45.54,Default,,0,0,0,,Қазір не істеп жатырсың?
Dialogue: 0,0:13:45.54,0:13:47.55,Default,,0,0,0,,Менің ойымша, ол жоғалып кетті. →
Dialogue: 0,0:13:47.55,0:13:50.55,Default,,0,0,0,,Әкемді оқудан шығарған кезде.
Dialogue: 0,0:13:50.55,0:13:54.55,Default,,0,0,0,,Олардың бір-біріне дәл ұқсауы бір нәрсені білдіреді, солай емес пе?
Dialogue: 0,0:13:54.55,0:13:56.55,Default,,0,0,0,,Мен солай деп ойлаймын.
Dialogue: 0,0:13:56.55,0:14:01.56,Default,,0,0,0,,Бұл сіздің болашағыңыз әкеңіздікіндей болады дегенді білдіре ме?
Dialogue: 0,0:14:01.56,0:14:03.56,Default,,0,0,0,,Ах... қалайсыз?
Dialogue: 0,0:14:03.56,0:14:06.56,Default,,0,0,0,,Е, жоқ, шынымен де...
Dialogue: 0,0:14:06.56,0:14:08.57,Default,,0,0,0,,Енді мен сізге осыны да ұсынамын.
Dialogue: 0,0:14:08.57,0:14:10.57,Default,,0,0,0,,Ах…. Ах.
Dialogue: 0,0:14:10.57,0:14:12.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:12.24,0:14:13.91,Default,,0,0,0,,Әр жолы.
Dialogue: 0,0:14:13.91,0:14:16.57,Default,,0,0,0,,Орындалатын армандар Орындалмайтын армандар. →
Dialogue: 0,0:14:16.57,0:14:19.58,Default,,0,0,0,,Орындалмайтынын біле тұра армандаған арманың. →
Dialogue: 0,0:14:19.58,0:14:23.51,Default,,0,0,0,,Қалай болғанда да, біздің болашағымыз бар, сондықтан бізге оны қабылдауға рұқсат етілген. →
Dialogue: 0,0:14:23.51,0:14:26.52,Default,,0,0,0,,Болашақ жоғалады, барар жері жоқ өмір→
Dialogue: 0,0:14:26.52,0:14:29.52,Default,,0,0,0,,Сол сияқты, барар жері жоқ арманға айналады→
Dialogue: 0,0:14:29.52,0:14:32.52,Default,,0,0,0,,Біздің алдымызда пайда бол. Бұл...
Dialogue: 0,0:14:32.52,0:14:34.53,Default,,0,0,0,,Актив?
Dialogue: 0,0:14:34.53,0:14:36.53,Default,,0,0,0,,Бұл шала ой болуы мүмкін, бірақ→
Dialogue: 0,0:14:36.53,0:14:39.53,Default,,0,0,0,,Тек сіздің әкеңіз және сіздің активтеріңіз→
Dialogue: 0,0:14:39.53,0:14:42.53,Default,,0,0,0,,Дәл соған ұқсайды деп естіп, қызық деп ойладым. →
Dialogue: 0,0:14:42.53,0:14:47.54,Default,,0,0,0,,Актив ата-ана мен бала арасындағы байланыстың символы сияқты.
Dialogue: 0,0:14:47.54,0:14:49.54,Default,,0,0,0,,Ата-ана мен бала байланысы?
Dialogue: 0,0:14:49.54,0:14:53.54,Default,,0,0,0,,Өйткені әкең екеуің бір нәрсені қалағансыңдар...
Dialogue: 0,0:14:53.54,0:14:56.55,Default,,0,0,0,,Бұл менің қиялым ғана...
Dialogue: 0,0:14:56.55,0:14:59.55,Default,,0,0,0,,Әкең тым болмаса сені жақсы көретін→
Dialogue: 0,0:14:59.55,0:15:01.55,Default,,0,0,0,,Мен оны дәлелдей аламын деп ойлаймын.
Dialogue: 0,0:15:01.55,0:15:03.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:03.55,0:15:07.56,Default,,0,0,0,,Егер сіз банкротқа ұшырасаңыз, бұл сізге және сіздің отбасыңызға әсер етеді.
Dialogue: 0,0:15:07.56,0:15:10.56,Default,,0,0,0,,Соңғы мәміле жасамас бұрын мұны болдырмауға тырысу →
Dialogue: 0,0:15:10.56,0:15:13.56,Default,,0,0,0,,Ол қаржы ауданынан қашуға тырысқан болуы керек.
Dialogue: 0,0:15:13.56,0:15:15.56,Default,,0,0,0,,Бірақ мен қашып құтыла алмаймын...
Dialogue: 0,0:15:17.57,0:15:19.57,Default,,0,0,0,,Бірақ қазір сіз осындасыз.
Dialogue: 0,0:15:19.57,0:15:21.57,Default,,0,0,0,,Сіз осындасыз, солай емес пе?
Dialogue: 0,0:15:23.51,0:15:26.51,Default,,0,0,0,,Бұл ең жақсы дәлел деп ойламайсыз ба? →
Dialogue: 0,0:15:26.51,0:15:28.51,Default,,0,0,0,,Әкесі қиналады. →
Dialogue: 0,0:15:28.51,0:15:32.51,Default,,0,0,0,,Мұның қаншалықты қиын екенін енді түсіндіңіз бе?
Dialogue: 0,0:15:35.52,0:15:39.52,Default,,0,0,0,,Мен нені қорғай аламын?
Dialogue: 0,0:15:39.52,0:15:41.53,Default,,0,0,0,,Айналаңызға мұқият қараңыз.
Dialogue: 0,0:15:41.53,0:15:44.53,Default,,0,0,0,,Ұнамаса да, қорғау керек нәрселер бар→
Dialogue: 0,0:15:44.53,0:15:47.53,Default,,0,0,0,,Сіз оны көресіз.
Dialogue: 0,0:15:47.53,0:15:49.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:15:52.54,0:15:54.54,Default,,0,0,0,,《Гержу сұрау》→
Dialogue: 0,0:15:54.54,0:15:57.54,Default,,0,0,0,,《Бүгінгі жастардың иісін есте сақта》
Dialogue: 0,0:16:00.21,0:16:04.45,Default,,0,0,0,,（）
Dialogue: 0,0:16:04.45,0:16:06.45,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:16:06.45,0:16:08.45,Default,,0,0,0,,Жол бойы келгеніңе мен кінәлімін.
Dialogue: 0,0:16:08.45,0:16:12.45,Default,,0,0,0,,Ханахи әлі? Йога-кун.
Dialogue: 0,0:16:14.46,0:16:16.46,Default,,0,0,0,,Мен сізді естимін...
Dialogue: 0,0:16:23.40,0:16:27.41,Default,,0,0,0,,Не? Не... Мен сирек үзіліс жасадым →
Dialogue: 0,0:16:27.41,0:16:29.41,Default,,0,0,0,,Өйткені ол телефонға жауап бермеді.
Dialogue: 0,0:16:29.41,0:16:32.41,Default,,0,0,0,,Кешіріңіз. Мен төсекте жатып, суық тиген сияқты болдым.
Dialogue: 0,0:16:32.41,0:16:34.41,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:34.41,0:16:36.41,Default,,0,0,0,,Басқа ештеңе болмады ма?
Dialogue: 0,0:16:36.41,0:16:39.42,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:16:39.42,0:16:41.19,Default,,0,0,0,,Жоқ….
Dialogue: 0,0:16:41.19,0:16:43.19,Default,,0,0,0,,Не өзгерді? Иә.
Dialogue: 0,0:16:43.19,0:16:48.43,Default,,0,0,0,,Ал, оны алмастыратын ештеңе жоқ.Күн сайын.
Dialogue: 0,0:16:48.43,0:16:51.43,Default,,0,0,0,,Бірдеңе болды ма? А, бұл дұрыс емес...
Dialogue: 0,0:16:51.43,0:16:54.43,Default,,0,0,0,,Не? Бұл біртүрлі.
Dialogue: 0,0:16:54.43,0:16:58.43,Default,,0,0,0,,А, дұрыс. Қоқысты шығаруды да сұраймын.
Dialogue: 0,0:17:00.44,0:17:07.44,Default,,0,0,0,,(Масакагидің күлкісі)
Dialogue: 0,0:17:11.45,0:17:13.22,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:17:13.22,0:17:15.52,Default,,0,0,0,,（）
Dialogue: 0,0:17:22.39,0:17:25.39,Default,,0,0,0,,Қазір не...? Ха!
Dialogue: 0,0:17:30.40,0:17:32.70,Default,,0,0,0,,Ой... бұл не...?
Dialogue: 0,0:17:35.41,0:17:37.41,Default,,0,0,0,,Бұл біртүрлі...
Dialogue: 0,0:17:39.18,0:17:40.85,Default,,0,0,0,,Шимада мырза! аа….
Dialogue: 0,0:17:40.85,0:17:43.51,Default,,0,0,0,,Аа, қонақ келмей жатыр. →
Dialogue: 0,0:17:43.51,0:17:46.52,Default,,0,0,0,,Осындай дүкендер жабылса екен.
Dialogue: 0,0:17:46.52,0:17:48.82,Default,,0,0,0,,Иә? Йога!
Dialogue: 0,0:17:50.52,0:17:53.52,Default,,0,0,0,,Ха...
Dialogue: 0,0:17:57.53,0:18:00.53,Default,,0,0,0,,Кешіріңіз. Ал Ханахи-сан ше?
Dialogue: 0,0:18:00.53,0:18:02.53,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:18:02.53,0:18:05.54,Default,,0,0,0,,Не? Бұл йога. Кимимаро йогасы.
Dialogue: 0,0:18:05.54,0:18:07.54,Default,,0,0,0,,Ханахи ше?
Dialogue: 0,0:18:07.54,0:18:09.54,Default,,0,0,0,,Ханахи деген жас келіншек бар, солай ма?
Dialogue: 0,0:18:11.54,0:18:13.54,Default,,0,0,0,,Жақсы….
Dialogue: 0,0:18:13.54,0:18:15.55,Default,,0,0,0,,Маған қоңырау шала аласыз ба?
Dialogue: 0,0:18:15.55,0:18:19.55,Default,,0,0,0,,Иә... Ханахи. Бұл біртүрлі атау болса да →
Dialogue: 0,0:18:19.55,0:18:23.49,Default,,0,0,0,,Есте сақтау оңай, солай емес пе? Бүгіннен бастап көңілді өтіңіз...
Dialogue: 0,0:18:23.49,0:18:25.49,Default,,0,0,0,,《Микунидің істегеніне байланысты →
Dialogue: 0,0:18:25.49,0:18:29.49,Default,,0,0,0,,Бұдан былай не болатынын ешкім білмейді.
Dialogue: 0,0:18:29.49,0:18:33.49,Default,,0,0,0,,《Болды ма? Бұл шынымен де
Dialogue: 0,0:18:38.50,0:18:40.50,Default,,0,0,0,,《Бұл төлем бе...》→
Dialogue: 0,0:18:40.50,0:18:45.51,Default,,0,0,0,,《Бұл мен қорғаған шындық》
Dialogue: 0,0:18:45.51,0:18:48.51,Default,,0,0,0,,Егер менің қолымнан келетін нәрсе болса, мен не қажет болса, соны істеймін.
Dialogue: 0,0:18:48.51,0:18:50.51,Default,,0,0,0,,Егер қазір болып жатқан нәрсе сол адамның істеп жатқаны болса →
Dialogue: 0,0:18:50.51,0:18:52.18,Default,,0,0,0,,«С»-дан да жаман!
Dialogue: 0,0:18:52.18,0:18:54.42,Default,,0,0,0,,Мен бұл сөздерді күттім.
Dialogue: 0,0:18:54.42,0:18:57.42,Default,,0,0,0,,Мен біраз уақыттан бері заңсыз құралдарды қолданып жүрмін→
Dialogue: 0,0:18:57.42,0:18:59.42,Default,,0,0,0,,Немаваши орындалуда.
Dialogue: 0,0:18:59.42,0:19:03.43,Default,,0,0,0,,Осы уақытқа дейін жоғалған адамдардың орнын толтыру мүмкін болмаса да →
Dialogue: 0,0:19:03.43,0:19:05.43,Default,,0,0,0,,Орнынан айырылғалы тұрған өмірлер →
Dialogue: 0,0:19:05.43,0:19:07.43,Default,,0,0,0,,Оны сақтау мүмкін болуы мүмкін.
Dialogue: 0,0:19:07.43,0:19:10.43,Default,,0,0,0,,Болашақты бірге қайтарайық!
Dialogue: 0,0:19:10.43,0:19:12.20,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:12.20,0:19:13.87,Default,,0,0,0,,Болашақ?
Dialogue: 0,0:19:13.87,0:19:17.54,Default,,0,0,0,,Иә, болашақты қайтарып алайық! Сіз өз болашағыңызды қайтара аласыз!
Dialogue: 0,0:19:17.54,0:19:19.54,Default,,0,0,0,,Сонда не болады?
Dialogue: 0,0:19:19.54,0:19:23.48,Default,,0,0,0,,Мүмкін кәдімгі қыз сияқты...
Dialogue: 0,0:19:23.48,0:19:25.15,Default,,0,0,0,,Әдетте?
Dialogue: 0,0:19:25.15,0:19:27.38,Default,,0,0,0,,Мүмкін, менің қызым сияқты→
Dialogue: 0,0:19:27.38,0:19:30.39,Default,,0,0,0,,Сіз нені айтасыз...мүмкін бақытты бола алмайсыз.
Dialogue: 0,0:19:30.39,0:19:34.39,Default,,0,0,0,,Сіздің қызыңыз бақытты болар ма еді?
Dialogue: 0,0:19:34.39,0:19:37.39,Default,,0,0,0,,Мен оны жақсы күтемін, сондықтан бұл орын алса, мен міндетті түрде...
Dialogue: 0,0:19:37.39,0:19:40.39,Default,,0,0,0,,Қызыңыз ретінде? иә?
Dialogue: 0,0:19:42.40,0:19:44.40,Default,,0,0,0,,Мүлдем.
Dialogue: 0,0:19:47.40,0:19:51.41,Default,,0,0,0,,Жақсы, қазір сол күйінде қалдыр... сурет?
Dialogue: 0,0:19:51.41,0:19:54.41,Default,,0,0,0,,Неліктен қазіргідей жақсы емес? Мен бұл жақсы емес екеніне сенімдімін.
Dialogue: 0,0:19:54.41,0:19:57.41,Default,,0,0,0,,Өйткені біз бірге бола алмаймыз, солай ма?
Dialogue: 0,0:19:57.41,0:19:59.42,Default,,0,0,0,,Жоқ, болашақта тағы да...
Dialogue: 0,0:19:59.42,0:20:01.42,Default,,0,0,0,,Қазір бірге жүргенімізден басқа!
Dialogue: 0,0:20:01.42,0:20:03.42,Default,,0,0,0,,Шиншу….
Dialogue: 0,0:20:03.42,0:20:05.42,Default,,0,0,0,,Эй, Шиншу.
Dialogue: 0,0:20:05.42,0:20:07.42,Default,,0,0,0,,Эй, солай істе. иә?
Dialogue: 0,0:20:07.42,0:20:10.43,Default,,0,0,0,,Сонымен... поцелу.
Dialogue: 0,0:20:10.43,0:20:12.43,Default,,0,0,0,,Иә! а…. Сонымен...
Dialogue: 0,0:20:12.43,0:20:15.43,Default,,0,0,0,,Мен сені 30 есе артық жақсы көремін! Себебі Кимимаро →
Dialogue: 0,0:20:15.43,0:20:18.44,Default,,0,0,0,,Сіз мен туралы аз ғана ойлайсыз!
Dialogue: 0,0:20:18.44,0:20:20.44,Default,,0,0,0,,Болды... Сосын істе!
Dialogue: 0,0:20:20.44,0:20:22.37,Default,,0,0,0,,Ууууууу…. аа….
Dialogue: 0,0:20:22.37,0:20:27.38,Default,,0,0,0,,Ууууууу….
Dialogue: 0,0:20:27.38,0:20:29.38,Default,,0,0,0,,Жақсы. Уф.
Dialogue: 0,0:20:29.38,0:20:32.38,Default,,0,0,0,,Уф….
Dialogue: 0,0:20:32.38,0:20:45.40,Default,,0,0,0,,Сен
Dialogue: 0,0:20:45.40,0:20:47.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:49.17,0:20:51.40,Default,,0,0,0,,Бұл дұрыс емес. Мен оны басқа күні көрдім ...
Dialogue: 0,0:20:51.40,0:20:54.41,Default,,0,0,0,,Ерекше адамды сүйу.
Dialogue: 0,0:20:54.41,0:20:56.41,Default,,0,0,0,,Сіздің сүйікті поцелуіңіз қандай?
Dialogue: 0,0:20:58.41,0:21:00.41,Default,,0,0,0,,Ха...
Dialogue: 0,0:21:00.41,0:21:03.41,Default,,0,0,0,,Өткен аптада туылған нәрестелер саны →
Dialogue: 0,0:21:03.41,0:21:06.42,Default,,0,0,0,,Барлық префектуралардағы 3 адам ғана қосылды →
Dialogue: 0,0:21:06.42,0:21:09.42,Default,,0,0,0,,Бүгінгі бала туу деңгейінің төмендеуіне қарсы іс-қимыл жөніндегі министрдің алаңдатарлық деректері →
Dialogue: 0,0:21:09.42,0:21:11.42,Default,,0,0,0,,Хабарланды. →
Dialogue: 0,0:21:11.42,0:21:14.43,Default,,0,0,0,,Туудың төмендеуінің бұрынғы тенденциясымен салыстыруға келмейтін төтенше өзгерістер→
Dialogue: 0,0:21:14.43,0:21:17.43,Default,,0,0,0,,Бұл үздіксіз бола ма→
Dialogue: 0,0:21:17.43,0:21:20.43,Default,,0,0,0,,Мен тенденцияны мұқият бағалағым келеді...
Dialogue: 0,0:21:22.43,0:21:25.44,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:21:25.44,0:21:35.44,Default,,0,0,0,,Сен
Dialogue: 0,0:25:12.56,0:25:22.56,Default,,0,0,0,,Сен
Dialogue: 0,0:25:24.06,0:25:30.06,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory