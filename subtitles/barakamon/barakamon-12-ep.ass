Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:04.39,0:01:06.69,OP-JP,,0000,0000,0000,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:01:07.45,0:01:09.94,OP-JP,,0000,0000,0000,,«Басқалардан ерекшелену» арқылы өзіңізді ерекшелендіріңіз
Dialogue: 0,0:01:10.18,0:01:12.42,OP-JP,,0000,0000,0000,,Дүкен журналының бұрышы
Dialogue: 0,0:01:12.92,0:01:15.81,OP-JP,,0000,0000,0000,,Мұқабаға кездейсоқ жазылған.
Dialogue: 0,0:01:15.87,0:01:18.15,OP-JP,,0000,0000,0000,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:01:18.62,0:01:21.17,OP-JP,,0000,0000,0000,,Кішкентай кезімде түк көрмедім.
Dialogue: 0,0:01:21.66,0:01:24.13,OP-JP,,0000,0000,0000,,Ұнамаса, ашулан.
Dialogue: 0,0:01:24.16,0:01:27.05,OP-JP,,0000,0000,0000,,Сізге ұнайтын нәрсені айтыңыз
Dialogue: 0,0:01:27.13,0:01:30.22,OP-JP,,0000,0000,0000,,Біз өзгереміз
Dialogue: 0,0:01:30.22,0:01:33.09,OP-JP,,0000,0000,0000,,Нені қорғағыңыз келетін өзгерістер
Dialogue: 0,0:01:33.09,0:01:35.84,OP-JP,,0000,0000,0000,,Түсінбеген қазынадан
Dialogue: 0,0:01:35.91,0:01:38.58,OP-JP,,0000,0000,0000,,Түсіну керек
Dialogue: 0,0:01:38.58,0:01:44.11,OP-JP,,0000,0000,0000,,Өскен сайын өкінесің.
Dialogue: 0,0:01:44.12,0:01:46.73,OP-JP,,0000,0000,0000,,Бірақ бәрібір.
Dialogue: 0,0:01:47.13,0:01:51.06,OP-JP,,0000,0000,0000,,Сіз бір нәрсе көре аласыз
Dialogue: 0,0:01:52.72,0:01:58.15,OP-JP,,0000,0000,0000,,Сондықтан мен өзіммін, ал сен өзіңсің.
Dialogue: 0,0:01:58.15,0:02:04.14,OP-JP,,0000,0000,0000,,Менің ойымша, бұл басынан бастап іздейтін нәрсе емес.
Dialogue: 0,0:02:04.14,0:02:09.41,OP-JP,,0000,0000,0000,,Мен сен емеспін, сен де мен емессің
Dialogue: 0,0:02:09.42,0:02:12.28,OP-JP,,0000,0000,0000,,Бір-бірінен өту, қол ұстасу
Dialogue: 0,0:02:12.33,0:02:16.89,OP-JP,,0000,0000,0000,,Махаббаттың туатын жері.
Dialogue: 0,0:02:18.06,0:02:20.79,OP-JP,,0000,0000,0000,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:02:20.85,0:02:26.91,OP-JP,,0000,0000,0000,,Мен оны өзгерте алмаймын, себебі бұл маңызды.
Dialogue: 0,0:02:27.31,0:02:30.66,OP-JP,,0000,0000,0000,,Өзгеретін өмір дұрыс
Dialogue: 0,0:21:11.31,0:21:13.76,ED-JP,,0000,0000,0000,,Сіз кішкентай қолыңызды создыңыз
Dialogue: 0,0:21:13.89,0:21:19.65,ED-JP,,0000,0000,0000,,Саған ұқсап күлгенім табиғи болды
Dialogue: 0,0:21:22.23,0:21:24.82,ED-JP,,0000,0000,0000,,Оның мағынасы болмауы мүмкін
Dialogue: 0,0:21:25.05,0:21:30.59,ED-JP,,0000,0000,0000,,бірақ бұл мен істей алмайтын нәрсе
Dialogue: 0,0:21:32.92,0:21:36.66,ED-JP,,0000,0000,0000,,Сен ойланбастан қолыма тидің
Dialogue: 0,0:21:36.66,0:21:40.45,ED-JP,,0000,0000,0000,,бірақ бұл мен үшін жақсы болды
Dialogue: 0,0:21:43.38,0:21:48.77,ED-JP,,0000,0000,0000,,Біз сенген барлық уақытта
Dialogue: 0,0:21:48.89,0:21:54.25,ED-JP,,0000,0000,0000,,дүние біздің қолымызда болды
Dialogue: 0,0:21:54.44,0:21:57.15,ED-JP,,0000,0000,0000,,Біз қателестік
Dialogue: 0,0:21:57.15,0:22:05.22,ED-JP,,0000,0000,0000,,мүмкін бұл сен менің қолымды ұстап тұрғандықтан емес шығар
Dialogue: 0,0:22:05.22,0:22:10.84,ED-JP,,0000,0000,0000,,Әр сәтте
Dialogue: 0,0:22:10.95,0:22:16.38,ED-JP,,0000,0000,0000,,Барлық жерде
Dialogue: 0,0:22:16.48,0:22:21.71,ED-JP,,0000,0000,0000,,Мен сене аламын, сене аламын
Dialogue: 0,0:22:22.04,0:22:26.89,ED-JP,,0000,0000,0000,,Мен сенің жылы қолыңды ұстағанда
Dialogue: 0,0:22:26.95,0:22:34.26,ED-JP,,0000,0000,0000,,сіздің жылы қолыңыз
Dialogue: 0,0:02:32.44,0:02:37.44,LOGO,,0000,0000,0000,,Бұл субтитр көзі өндіруші, жеткізуші, алмасу студенті шығарған және коммерциялық пайдалануға тыйым салынған субтитр ұйымы (kamigami.org) болып табылады.
Dialogue: 0,0:02:37.44,0:02:42.44,LOGO,,0000,0000,0000,,Жапония: Маруко Аудармасы: Dongpo & Ariake no Tsuki Түпнұсқа: Сяобай және Люцифер Уақыты: Сон әулеті Кейінірек: Наксия
Dialogue: 0,0:00:03.26,0:00:07.08,JP,,0000,0000,0000,,Баршаңызға, мен мұғалімнің тезірек оралғанын қалаймын.
Dialogue: 0,0:00:07.62,0:00:09.17,JP,,0000,0000,0000,,Yes
Dialogue: 0,0:00:09.62,0:00:13.08,JP,,0000,0000,0000,,Олай болса, кез келген уақытта оралуға болады.
Dialogue: 0,0:00:13.58,0:00:17.16,JP,,0000,0000,0000,,Бөлмеңізді жинаңыз.
Dialogue: 0,0:00:17.16,0:00:18.54,JP,,0000,0000,0000,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:00:18.61,0:00:21.54,JP,,0000,0000,0000,,Мива-чан көп тәртіпсіздікті жасады.
Dialogue: 0,0:00:21.63,0:00:23.65,JP,,0000,0000,0000,,Алданбаңдар, балалар.
Dialogue: 0,0:00:23.72,0:00:27.45,JP,,0000,0000,0000,,Кел, кел, ұстазың үшін жұмыс.
Dialogue: 0,0:00:27.45,0:00:28.92,JP,,0000,0000,0000,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:00:34.20,0:00:36.78,JP,,0000,0000,0000,,Ұстаз, қашан келесіз?
Dialogue: 0,0:00:36.78,0:00:38.26,JP,,0000,0000,0000,,Бір күні
Dialogue: 0,0:00:44.52,0:00:48.96,JP,,0000,0000,0000,,Мұғалім, тезірек оралыңыз.
Dialogue: 0,0:00:58.08,0:00:58.89,JP,,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:02:32.33,0:02:36.10,JP,,0000,0000,0000,,Анашым, бұл не?
Dialogue: 0,0:02:36.39,0:02:41.52,JP,,0000,0000,0000,,Көріп тұрғаныңыздай, мен сізді аралға жібермеу үшін үнсіз қарсылық білдіріп жатырмын.
Dialogue: 0,0:02:41.52,0:02:42.68,JP,,0000,0000,0000,,Тыныш болыңыз
Dialogue: 0,0:02:43.23,0:02:46.87,JP,,0000,0000,0000,,Мен өз жұмысымды кітап көрмесіне қоя алдым, сондықтан аралға қайтып оралуды ойлап жүрмін.
Dialogue: 0,0:02:47.82,0:02:49.51,JP,,0000,0000,0000,,Үйге барасыз ба? !
Dialogue: 0,0:02:49.51,0:02:52.88,JP,,0000,0000,0000,,Сіздің үйіңіз осында, арал алыс.
Dialogue: 0,0:02:52.88,0:02:54.31,JP,,0000,0000,0000,,Бұл заңсыз нәрсе
Dialogue: 0,0:02:54.93,0:02:56.02,JP,,0000,0000,0000,,Анашым тоқтаңыз
Dialogue: 0,0:02:56.02,0:02:57.07,JP,,0000,0000,0000,,Мен тоқтамаймын
Dialogue: 0,0:02:57.38,0:03:00.06,JP,,0000,0000,0000,,Жоқ дегенше тоқтамайтын соққылар
Dialogue: 0,0:03:00.29,0:03:01.62,JP,,0000,0000,0000,,Әзірше сөйлесейік.
Dialogue: 0,0:03:01.61,0:03:03.77,JP-up,,0000,0000,0000,,Бұл соққы жай ғана ауырады
Dialogue: 0,0:03:04.37,0:03:06.11,JP,,0000,0000,0000,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:03:06.54,0:03:07.85,JP,,0000,0000,0000,,Кавафуджи-кун келе жатыр.
Dialogue: 0,0:03:08.99,0:03:09.94,JP,,0000,0000,0000,,Кавафуджи-кун
Dialogue: 0,0:03:10.07,0:03:11.92,JP,,0000,0000,0000,,Кавафуджи жақсы жерде
Dialogue: 0,0:03:12.06,0:03:15.97,JP,,0000,0000,0000,,Мен жұмысымды сатуға сәтті тапсырғанымды хабарлау үшін келдім.
Dialogue: 0,0:03:16.47,0:03:17.57,JP,,0000,0000,0000,,Кешіріңіз, мазаладым.
Dialogue: 0,0:03:17.94,0:03:19.72,JP,,0000,0000,0000,,Бұл кедергі бола алмайды.
Dialogue: 0,0:03:20.16,0:03:21.76,JP,,0000,0000,0000,,Тамақ ішуге шығамыз ба?
Dialogue: 0,0:03:22.17,0:03:23.48,JP,,0000,0000,0000,,Киёши-сан, мен қашып кеткім келеді.
Dialogue: 0,0:03:23.89,0:03:27.74,JP,,0000,0000,0000,,Біз заттарды сол күйінде қалдыра алмаймыз. Барлығымыз ойланып көрейік.
Dialogue: 0,0:03:28.02,0:03:30.16,JP,,0000,0000,0000,,Кавафуджи-кун, маған сендіруге көмектесіңізші.
Dialogue: 0,0:03:33.55,0:03:35.66,JP,,0000,0000,0000,,Мен бұған әу бастан қарсы болдым.
Dialogue: 0,0:03:36.40,0:03:39.92,JP,,0000,0000,0000,,Ол кезде әңгімені өз бетімше жалғастырудан басқа амалым қалмады.
Dialogue: 0,0:03:40.66,0:03:45.77,JP,,0000,0000,0000,,Мен оны мұқият тыңдағанымда, ол нашарлап, тіпті ауруханаға түскенін айтты.
Dialogue: 0,0:03:46.15,0:03:48.99,JP,,0000,0000,0000,,Мен осында болған кезде мысыққа аллергиям туралы абай болдым.
Dialogue: 0,0:03:49.11,0:03:50.27,JP,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:03:50.74,0:03:53.45,JP,,0000,0000,0000,,Мен сені тоқтатсам да барам дейсің.
Dialogue: 0,0:03:53.72,0:03:56.27,JP,,0000,0000,0000,,Онда мен сіздің пікіріңізді тыңдамаймын.
Dialogue: 0,0:03:56.63,0:03:59.44,JP,,0000,0000,0000,,Мен сені үйқамаққа алсам да тоқтатамын.
Dialogue: 0,0:04:00.21,0:04:02.21,JP,,0000,0000,0000,,Сенің анаң керемет
Dialogue: 0,0:04:02.89,0:04:04.98,JP,,0000,0000,0000,,Соңында мәжбүрледің бе?
Dialogue: 0,0:04:05.50,0:04:09.04,JP,,0000,0000,0000,,Жарайды, апаңның айтқаны дұрыс. бас тарт.
Dialogue: 0,0:04:09.25,0:04:12.14,JP,,0000,0000,0000,,Сіз мен жақта емессіз
Dialogue: 0,0:04:14.28,0:04:16.69,JP,,0000,0000,0000,,Енді мен Токиода да жаза алатынымды білдім
Dialogue: 0,0:04:17.04,0:04:19.89,JP,,0000,0000,0000,,Мен аралда демалғаннан гөрі көп жұмыс істегенді ұнатамын.
Dialogue: 0,0:04:21.29,0:04:22.95,JP,,0000,0000,0000,,Бұл жүйе ме?
Dialogue: 0,0:04:24.48,0:04:29.85,JP,,0000,0000,0000,,Шалғайдағы арал дегенде оны электр жарығы жоқ ауыл елестететіні рас.
Dialogue: 0,0:04:30.47,0:04:35.68,JP,,0000,0000,0000,,Бірақ сіз материктен алыс болғандықтан, сіз әлі де қажет нәрсенің бәрін ала аласыз.
Dialogue: 0,0:04:36.10,0:04:39.59,JP,,0000,0000,0000,,Мен сияқты үйде отыруға бейім адам үшін аман қалуым жеткілікті.
Dialogue: 0,0:04:41.96,0:04:46.06,JP,,0000,0000,0000,,Менің бұл жерде достарым көп емес, сондықтан жаза алатын болсам, жақсы.
Dialogue: 0,0:04:46.46,0:04:49.43,JP,,0000,0000,0000,,Мен оның не екенін білмеймін, бірақ тыңдап отырып мұңаямын.
Dialogue: 0,0:04:49.55,0:04:52.70,JP,,0000,0000,0000,,Сіз мені тек жер деп ойлайсыз.
Dialogue: 0,0:04:55.45,0:04:58.73,JP,,0000,0000,0000,,Сіз бейтаныс адамдармен араласасыз, солай ма?
Dialogue: 0,0:05:00.41,0:05:02.48,JP,,0000,0000,0000,,Оның көзқарасы мен тілі қатал болды.
Dialogue: 0,0:05:02.88,0:05:05.20,JP,,0000,0000,0000,,Мұндай жағдай бұрын болмаған.
Dialogue: 0,0:05:05.32,0:05:07.54,JP,,0000,0000,0000,,Мен соншалықты жаман болдым ба?
Dialogue: 0,0:05:08.56,0:05:11.48,JP,,0000,0000,0000,,Күрделі болды, дәлірек айтсақ, біртүрлі болды.
Dialogue: 0,0:05:11.77,0:05:15.74,JP,,0000,0000,0000,,Қызыл түске аралассаң, қызыл түске боясың. Сіз танысқыңыз келетін адамды таңдауыңыз керек.
Dialogue: 0,0:05:16.32,0:05:18.54,JP,,0000,0000,0000,,Егер ол қызыл түспен қиылыса, қызыл болады.
Dialogue: 0,0:05:23.52,0:05:24.89,JP,,0000,0000,0000,,Жоқ, жоқ, жоқ, жоқ
Dialogue: 0,0:05:24.89,0:05:26.02,JP,,0000,0000,0000,,Жоқ Иә
Dialogue: 0,0:05:26.20,0:05:28.21,JP,,0000,0000,0000,,Қайтып келгеннен бері біртүрлі болдыңыз.
Dialogue: 0,0:05:28.51,0:05:33.64,JP,,0000,0000,0000,,Ол тұздалған қиярды көп жейді, комоно, канусано сияқты оғаш сөздерді айтады.
Dialogue: 0,0:05:33.64,0:05:36.70,JP,,0000,0000,0000,,Мен бұлай айтқан жоқпын, маған әсер еткен жоқ.
Dialogue: 0,0:05:36.85,0:05:38.20,JP,,0000,0000,0000,,Мен түсіндім деп ойлаймын.
Dialogue: 0,0:05:38.37,0:05:41.39,JP,,0000,0000,0000,,Киёши сонша шулы адам емес еді.
Dialogue: 0,0:05:45.23,0:05:47.72,JP,,0000,0000,0000,,Егер сіз өзіңіздің жеріңізге немесе мінезіңізге алаңдасаңыз
Dialogue: 0,0:05:47.92,0:05:50.39,JP,,0000,0000,0000,,Менің ойымша, бұл жерде ештеңе жоқ.
Dialogue: 0,0:05:50.81,0:05:52.99,JP,,0000,0000,0000,,Менің әкем де осы жүйені пайдаланады.
Dialogue: 0,0:05:53.93,0:05:57.96,JP,,0000,0000,0000,,Мен де Киёшумен құрдас кезімде аралда тұрдым.
Dialogue: 0,0:05:58.37,0:05:59.80,JP,,0000,0000,0000,,Экологиялық проблемалар жоқ
Dialogue: 0,0:06:00.00,0:06:01.95,JP,,0000,0000,0000,,Е, менің әкем де аралда.
Dialogue: 0,0:06:02.51,0:06:06.50,JP,,0000,0000,0000,,Өзім бармасам, сені баруға мәжбүрлемес едім.
Dialogue: 0,0:06:07.06,0:06:09.37,JP,,0000,0000,0000,,Сіз Юдзиро Кидоға қарызсыз, солай ма?
Dialogue: 0,0:06:09.53,0:06:10.42,JP,,0000,0000,0000,,Кидо
Dialogue: 0,0:06:11.99,0:06:12.68,JP,,0000,0000,0000,,Әкім
Dialogue: 0,0:06:13.01,0:06:17.23,JP,,0000,0000,0000,,Иә, ескі альбомда фото болғанына сенімдімін.
Dialogue: 0,0:06:17.23,0:06:20.72,JP,,0000,0000,0000,,Не, сіз өзіңізге тиімді нәрсені көрсете алмайсыз ба?
Dialogue: 0,0:06:21.26,0:06:23.30,JP,,0000,0000,0000,,Тек еске түсіру
Dialogue: 0,0:06:30.52,0:06:32.77,JP,,0000,0000,0000,,Осындай ескі фотоны тапқаныма сене алар емеспін.
Dialogue: 0,0:06:33.25,0:06:36.06,JP,,0000,0000,0000,,Сеймей мырза, сіз Хандаға тура ұқсайсыз.
Dialogue: 0,0:06:36.06,0:06:38.19,JP,,0000,0000,0000,,Оның көзі мына жігіттікіндей жаман емес.
Dialogue: 0,0:06:38.64,0:06:41.72,JP,,0000,0000,0000,,Бұл менің аралда болған кездегі фото.
Dialogue: 0,0:06:43.21,0:06:45.18,JP,,0000,0000,0000,,Уау, әкім!
Dialogue: 0,0:06:45.43,0:06:47.36,JP,,0000,0000,0000,,Шамамен 35 жыл бұрын
Dialogue: 0,0:06:47.36,0:06:49.82,JP,,0000,0000,0000,,Кидо мен Хисани балық аулауға кетті.
Dialogue: 0,0:06:50.11,0:06:51.19,JP,,0000,0000,0000,,Тарих
Dialogue: 0,0:06:51.26,0:06:53.11,JP,,0000,0000,0000,,Нусано шықты
Dialogue: 0,0:06:53.31,0:06:55.57,JP,,0000,0000,0000,,Біз де балық ұстар едік.
Dialogue: 0,0:06:55.57,0:06:57.37,JP,,0000,0000,0000,,Менің ойымша, сіз оны ұстадым деп айта аласыз.
Dialogue: 0,0:06:58.44,0:06:59.82,JP,,0000,0000,0000,,Бұл Киносита Шотен
Dialogue: 0,0:07:00.82,0:07:02.11,JP,,0000,0000,0000,,Мен бұл атау екеніне сенімдімін.
Dialogue: 0,0:07:02.95,0:07:07.89,JP,,0000,0000,0000,,Бұл дүкен менеджері. Ол жас. Ол әдемі.
Dialogue: 0,0:07:08.76,0:07:10.06,JP,,0000,0000,0000,,Бұл өзен әлі де бар
Dialogue: 0,0:07:10.06,0:07:12.39,JP,,0000,0000,0000,,Мен мұнда бір рет жарақат алдым.
Dialogue: 0,0:07:12.52,0:07:14.43,JP,,0000,0000,0000,,Менде де тыртық бар.
Dialogue: 0,0:07:14.44,0:07:15.80,JP,,0000,0000,0000,,Жетеді
Dialogue: 0,0:07:15.93,0:07:18.46,JP,,0000,0000,0000,,Әр адам әрқашан аралға барады.
Dialogue: 0,0:07:18.76,0:07:21.27,JP,,0000,0000,0000,,Менің сезімімді ешкім түсінбейді
Dialogue: 0,0:07:21.58,0:07:23.81,JP,,0000,0000,0000,,Мен қатты уайымдап тұрмын
Dialogue: 0,0:07:23.81,0:07:26.06,JP,,0000,0000,0000,,Да-чан да тым жауапсыз.
Dialogue: 0,0:07:26.27,0:07:30.07,JP,,0000,0000,0000,,Асыл ұлым жойылу жолында болса да.
Dialogue: 0,0:07:30.31,0:07:31.33,JP,,0000,0000,0000,,Да-чан
Dialogue: 0,0:07:31.33,0:07:32.61,JP,,0000,0000,0000,,Тынышталыңыз
Dialogue: 0,0:07:32.86,0:07:36.89,JP,,0000,0000,0000,,Бөлек болу балаңыздың өсуіне көмектессе, бұл ең жақсысы, солай емес пе?
Dialogue: 0,0:07:37.09,0:07:39.84,JP,,0000,0000,0000,,Әкем мен жақта емес
Dialogue: 0,0:07:41.01,0:07:43.39,JP,,0000,0000,0000,,Денем әлсіреп, жиі ауыратынмын.
Dialogue: 0,0:07:43.39,0:07:46.12,JP,,0000,0000,0000,,Өзіңді бағып-қаққан анаңды қалай тастап кете аласың?
Dialogue: 0,0:07:46.54,0:07:48.41,JP,,0000,0000,0000,,Бейбіт, таудай
Dialogue: 0,0:07:48.41,0:07:50.53,JP,,0000,0000,0000,,Сенің анаң қиын.
Dialogue: 0,0:07:50.53,0:07:53.80,JP,,0000,0000,0000,,Анаңды осылай менсінбейсің
Dialogue: 0,0:07:53.80,0:07:54.90,JP,,0000,0000,0000,,Менен сұрады
Dialogue: 0,0:07:55.49,0:07:58.09,JP,,0000,0000,0000,,Әке-шешеге немқұрайлылық, Жел сияқты
Dialogue: 0,0:07:58.59,0:08:01.25,JP,,0000,0000,0000,,Өйткені сен ештеңе білмейсің
Dialogue: 0,0:08:01.25,0:08:03.26,JP,,0000,0000,0000,,Әй, апа, ауырды, ауырады.
Dialogue: 0,0:08:02.94,0:08:04.59,JP-up,,0000,0000,0000,,Кешіріңіз, Кавафуджи-кун
Dialogue: 0,0:08:05.88,0:08:08.78,JP,,0000,0000,0000,,Мен бұл қарқынмен біраз уақыт орала алмаймын деп ойлаймын.
Dialogue: 0,0:08:09.02,0:08:09.79,JP,,0000,0000,0000,,Киёшу
Dialogue: 0,0:08:11.37,0:08:15.92,JP,,0000,0000,0000,,Мен саған аралға бар дедім, бірақ бұдан былай бұл сенің еркіндігің.
Dialogue: 0,0:08:16.52,0:08:20.59,JP,,0000,0000,0000,,Қалаған таңбаларды жаза алсаңыз, тартыңыз.
Dialogue: 0,0:08:21.80,0:08:23.73,JP,,0000,0000,0000,,Әрі қарай не болатынын өзіңіз шешесіз.
Dialogue: 0,0:08:26.01,0:08:32.42,JP,,0000,0000,0000,,Мен Киёши-санның зұлымдық немесе әдепсіз әрекеттер жасамауын сұраймын.
Dialogue: 0,0:08:35.81,0:08:39.23,JP,,0000,0000,0000,,Мен `` Shoten '' сөзін жаза алдым және бағытты көріп тұрғандай болдым.
Dialogue: 0,0:08:39.76,0:08:42.15,JP,,0000,0000,0000,,Менің ойымша, аралға қайта оралудың қажеті жоқ.
Dialogue: 0,0:08:42.50,0:08:47.25,JP,,0000,0000,0000,,Егер сіз қай жерде болсаңыз да, тығылып жатсаңыз, Токиода болу ыңғайлырақ деп ойлаймын.
Dialogue: 0,0:08:50.10,0:08:53.19,JP,,0000,0000,0000,,Қалай қарасаң да, Токио жақсырақ.
Dialogue: 0,0:08:53.68,0:08:55.83,JP,,0000,0000,0000,,Неге уайымдап тұрсың?
Dialogue: 0,0:08:57.32,0:08:58.10,JP,,0000,0000,0000,,Киёши-сан
Dialogue: 0,0:09:00.15,0:09:02.06,JP,,0000,0000,0000,,Сіздің пакетіңіз келді.
Dialogue: 0,0:09:02.51,0:09:04.74,JP,,0000,0000,0000,,Бұл аралдағы адамдардан шыққан сияқты.
Dialogue: 0,0:09:06.44,0:09:09.32,JP,,0000,0000,0000,,Бұл жүк, мен енді ешқашан келмеймін деген сөз.
Dialogue: 0,0:09:09.79,0:09:12.09,JP,,0000,0000,0000,,Жоқ, олар мұны жасамас еді.
Dialogue: 0,0:09:12.38,0:09:14.02,JP,,0000,0000,0000,,Кітап көрмесінде бұрышта тұрғанда
Dialogue: 0,0:09:14.45,0:09:17.38,JP,,0000,0000,0000,,Мен сізге қажетті құжаттарды жіберуіңізді сұрадым.
Dialogue: 0,0:09:18.89,0:09:20.06,JP,,0000,0000,0000,,Бұл іс жарыққа шыққанына төрт айдан асты.
Dialogue: 0,0:09:20.83,0:09:24.46,JP,,0000,0000,0000,,Олар бәрін сол жерге қойды.
Dialogue: 0,0:09:24.73,0:09:27.99,JP,,0000,0000,0000,,Бұл қорлау. Менің баламды қорлап жатыр.
Dialogue: 0,0:09:28.22,0:09:29.89,JP,,0000,0000,0000,,Бұл олай емес.
Dialogue: 0,0:09:31.41,0:09:32.32,JP,,0000,0000,0000,,Бұл орын алады.
Dialogue: 0,0:09:33.06,0:09:35.22,JP,,0000,0000,0000,,Наруто деген кім?
Dialogue: 0,0:09:35.22,0:09:36.35,JP,,0000,0000,0000,,Бұл бала.
Dialogue: 0,0:09:38.53,0:09:39.40,JP,,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:09:42.02,0:09:44.03,JP,,0000,0000,0000,,Сіз маған осындай нәрсені жібердіңіз.
Dialogue: 0,0:09:44.51,0:09:45.95,JP,,0000,0000,0000,,Киёши мырза, яғни
Dialogue: 0,0:09:46.64,0:09:49.00,JP,,0000,0000,0000,,Аралда сабақ берген адамдардың каллиграфиясы
Dialogue: 0,0:09:51.41,0:09:53.53,JP,,0000,0000,0000,,Мен бастағаныма көп уақыт болды, бірақ мен жақсы жүрмін.
Dialogue: 0,0:09:55.02,0:09:59.84,JP,,0000,0000,0000,,Тапсырманың нәтижесі осыншама тез шығатын болса, мен оны келер алдында дұрыстап көруім керек еді.
Dialogue: 0,0:10:01.35,0:10:05.84,JP,,0000,0000,0000,,Нәтижелерді бірге қабылдап, қуанып, жігерленуіміз керек еді.
Dialogue: 0,0:10:07.31,0:10:08.21,JP,,0000,0000,0000,,Киёши-сан
Dialogue: 0,0:10:17.20,0:10:19.19,JP,,0000,0000,0000,,Қалағаныңды істе.
Dialogue: 0,0:10:19.19,0:10:21.32,JP,,0000,0000,0000,,Анашым, тағы да күңіреніп тұрсыз ба?
Dialogue: 0,0:10:21.32,0:10:22.94,JP,,0000,0000,0000,,Мен ренжіп тұрған жоқпын.
Dialogue: 0,0:10:24.07,0:10:28.11,JP,,0000,0000,0000,,Егер сізге қажет болса, қайтып кетуден басқа амалыңыз жоқ.
Dialogue: 0,0:10:29.40,0:10:30.41,JP,,0000,0000,0000,,Ә? (Кения) Сен➡
Dialogue: 0,0:10:30.87,0:10:34.49,JP,,0000,0000,0000,,Келесі жолы мен үйге дұрыстап хабарласамын.
Dialogue: 0,0:10:37.28,0:10:40.34,JP,,0000,0000,0000,,Бұл менің бара алатынымды білдіре ме?
Dialogue: 0,0:10:41.36,0:10:42.88,JP,,0000,0000,0000,,Солай көрінеді.
Dialogue: 0,0:10:47.91,0:10:49.30,JP,,0000,0000,0000,,Жақсы болды ма?
Dialogue: 0,0:10:49.91,0:10:54.77,JP,,0000,0000,0000,,Иә, бұл бала адамдарға бірдеңе жасағысы келеді.
Dialogue: 0,0:10:55.23,0:10:58.00,JP,,0000,0000,0000,,Бұдан артық болса, мен үшін өзімшілдік болады.
Dialogue: 0,0:10:58.73,0:11:01.48,JP,,0000,0000,0000,,Бұл тек каллиграфия ғана өскен жоқ.
Dialogue: 0,0:11:04.06,0:11:05.99,JP,,0000,0000,0000,,Бұл арал жақсы жер.
Dialogue: 0,0:11:06.56,0:11:08.91,JP,,0000,0000,0000,,Суық түскенше бір рет баруым керек пе?
Dialogue: 0,0:11:10.18,0:11:10.66,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:11:20.84,0:11:24.92,JP,,0000,0000,0000,,Жаңа ғана ауыл телефоншысы Ақкиден біраз мәлімет алдым.
Dialogue: 0,0:11:25.55,0:11:28.82,JP,,0000,0000,0000,,Мұғалім бүгін кешке ұшақпен қайтып келеді.
Dialogue: 0,0:11:30.82,0:11:35.11,JP,,0000,0000,0000,,Ендеше бүгін үйді жинап алайық.
Dialogue: 0,0:11:37.23,0:11:39.69,JP,,0000,0000,0000,,Осылай жалғастыра берсең, мұғалім саған қатты ашуланады.
Dialogue: 0,0:11:39.75,0:11:40.64,JP,,0000,0000,0000,,Барымызды салайық
Dialogue: 0,0:11:43.10,0:11:44.24,JP,,0000,0000,0000,,Ауыр
Dialogue: 0,0:11:44.55,0:11:47.11,JP,,0000,0000,0000,,Кенет мен аралдан кетіп бара жатырмын деп ойладым.
Dialogue: 0,0:11:47.42,0:11:50.01,JP,,0000,0000,0000,,Қайтып келгенімде кенет болды, ұстаз.
Dialogue: 0,0:11:50.36,0:11:53.22,JP,,0000,0000,0000,,Әй, неге дұрыстап тазаламайсың?
Dialogue: 0,0:12:13.02,0:12:16.25,JP,,0000,0000,0000,,Уақытты босқа кетіру!
Dialogue: 0,0:12:18.16,0:12:18.77,JP,,0000,0000,0000,,Хиро-нии
Dialogue: 0,0:12:18.93,0:12:19.76,JP,,0000,0000,0000,,Юкине, сонда ісіңді бітірген соң дүкенге қара.
Dialogue: 0,0:12:20.37,0:12:21.45,JP,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:12:21.45,0:12:22.53,JP,,0000,0000,0000,,Менен ештеңе сұрама
Dialogue: 0,0:12:22.96,0:12:26.14,JP,,0000,0000,0000,,Сабырлы болу қызық екенін өз көзіммен білдім.
Dialogue: 0,0:12:26.37,0:12:28.56,JP,,0000,0000,0000,,Мені одан артық ренжітпе.
Dialogue: 0,0:12:28.87,0:12:31.40,JP,,0000,0000,0000,,Өйткені, мұны өзім жасау жеткіліксіз болды.
Dialogue: 0,0:12:32.12,0:12:33.96,JP,,0000,0000,0000,,Бұл толығымен жинақы.
Dialogue: 0,0:12:34.23,0:12:34.91,JP,,0000,0000,0000,,Дегенмен
Dialogue: 0,0:12:34.91,0:12:36.16,JP,,0000,0000,0000,,Бұл Перо емес.
Dialogue: 0,0:12:36.54,0:12:38.26,JP,,0000,0000,0000,,Хиро-ни не үшін келді?
Dialogue: 0,0:12:38.55,0:12:40.00,JP,,0000,0000,0000,,Бұл жерден салқындап барады.
Dialogue: 0,0:12:40.33,0:12:43.05,JP,,0000,0000,0000,,Мен мұғалімді тереземен жабдықтауды ойладым.
Dialogue: 0,0:12:43.44,0:12:46.29,JP,,0000,0000,0000,,Айтпасаң, терезе болған жоқ.
Dialogue: 0,0:12:46.42,0:12:48.47,JP,,0000,0000,0000,,Тайфуннан сынған шыны крекерлер және т.б.
Dialogue: 0,0:12:48.58,0:12:50.77,JP,,0000,0000,0000,,Оны шешіп, қоймаға салыңыз.
Dialogue: 0,0:12:51.13,0:12:53.09,JP,,0000,0000,0000,,Енді мен сізді бақылауға рұқсат етіңіз.
Dialogue: 0,0:12:53.40,0:12:54.72,JP,,0000,0000,0000,,Дұрыс тазалаңыз
Dialogue: 0,0:12:56.22,0:12:58.55,JP,,0000,0000,0000,,Тезірек, мұғалім келеді.
Dialogue: 0,0:12:59.50,0:13:00.61,JP,,0000,0000,0000,,Қоқыстарды бөлектеңіз
Dialogue: 0,0:13:00.94,0:13:02.22,JP,,0000,0000,0000,,Кента сыпырғышпен жуады
Dialogue: 0,0:13:03.13,0:13:04.32,JP,,0000,0000,0000,,Өздігінен сүртілетін тазалау
Dialogue: 0,0:13:05.11,0:13:07.31,JP,,0000,0000,0000,,Сен әлдеқайда әдемі болып кеттің, Хиро-ни.
Dialogue: 0,0:13:07.31,0:13:10.13,JP,,0000,0000,0000,,Қоқыс қалдырмаңыз.
Dialogue: 0,0:13:10.52,0:13:12.99,JP,,0000,0000,0000,,Енді икемділік жоқ.
Dialogue: 0,0:13:13.18,0:13:15.06,JP,,0000,0000,0000,,Бәрі де ұстаз үшін
Dialogue: 0,0:13:15.30,0:13:17.25,JP,,0000,0000,0000,,Мұғалімге арналған Мұғалімге арналған
Dialogue: 0,0:13:17.93,0:13:19.12,JP,,0000,0000,0000,,Мұғалімдерге арналған
Dialogue: 0,0:13:19.24,0:13:20.57,JP,,0000,0000,0000,,Мұғалімдерге арналған
Dialogue: 0,0:13:20.95,0:13:22.13,JP,,0000,0000,0000,,Мұғалімдерге арналған
Dialogue: 0,0:13:22.40,0:13:23.75,JP,,0000,0000,0000,,Мұғалімдерге арналған
Dialogue: 0,0:13:24.05,0:13:25.68,JP,,0000,0000,0000,,Мұғалімге арналған
Dialogue: 0,0:13:28.37,0:13:29.26,JP,,0000,0000,0000,,Тазалау
Dialogue: 0,0:13:29.60,0:13:30.57,JP,,0000,0000,0000,,Аяқталды
Dialogue: 0,0:13:31.07,0:13:33.12,JP,,0000,0000,0000,,Ол кеңейді
Dialogue: 0,0:13:33.29,0:13:36.10,JP,,0000,0000,0000,,Енді сіз қайтадан тәртіпсіздік жасай аласыз.
Dialogue: 0,0:13:36.57,0:13:39.11,JP,,0000,0000,0000,,Мен мұны істеймін деп ойламаймын.
Dialogue: 0,0:13:39.11,0:13:41.39,JP,,0000,0000,0000,,Енді мұғалімнің үйге келуін күту ғана қалды.
Dialogue: 0,0:13:41.76,0:13:43.39,JP,,0000,0000,0000,,Мен оны асыға күтемін.
Dialogue: 0,0:13:43.39,0:13:44.40,JP,,0000,0000,0000,,Нарумо
Dialogue: 0,0:13:44.40,0:13:47.10,JP,,0000,0000,0000,,Үйге барайық, тәттілер әкелейік.
Dialogue: 0,0:13:47.55,0:13:49.28,JP,,0000,0000,0000,,Хиро-ни тамақ жасады.
Dialogue: 0,0:13:49.28,0:13:51.51,JP,,0000,0000,0000,,Сіз шынымен тағы да тәртіпсіздік жасайсыз ба?
Dialogue: 0,0:13:59.38,0:14:00.42,JP,,0000,0000,0000,,Келу
Dialogue: 0,0:14:05.61,0:14:07.87,JP,,0000,0000,0000,,Мені алып кетуге қала басшысы келуі керек.
Dialogue: 0,0:14:11.35,0:14:13.51,JP,,0000,0000,0000,,Жаяу жүрсек, жақында кездесеміз.
Dialogue: 0,0:14:19.58,0:14:22.33,JP,,0000,0000,0000,,Сейфүне-күннің қолжазбасының уақыты жақындап қалды.
Dialogue: 0,0:14:22.82,0:14:23.31,JP,,0000,0000,0000,,Иә
Dialogue: 0,0:14:23.59,0:14:26.08,JP,,0000,0000,0000,,Мен оны әлі көрмедім, сондықтан оны асыға күтемін.
Dialogue: 0,0:14:26.96,0:14:29.25,JP,,0000,0000,0000,,Канзаки-кунның жазуы да тамаша болды.
Dialogue: 0,0:14:29.80,0:14:32.74,JP,,0000,0000,0000,,Бұл жолы да екі жастың төбелесі болатын сияқты.
Dialogue: 0,0:14:33.27,0:14:35.79,JP,,0000,0000,0000,,Менің ұлым үшін бірден нәтиже емес.
Dialogue: 0,0:14:35.96,0:14:39.02,JP,,0000,0000,0000,,Мен оны алғаннан кейін не болатынын көргім келеді.
Dialogue: 0,0:14:40.04,0:14:44.36,JP,,0000,0000,0000,,Менің ойымша, Киёшу болашаққа қарап, соған сәйкес әрекет етеді.
Dialogue: 0,0:14:44.87,0:14:46.67,JP,,0000,0000,0000,,Мен азапты көрдім.
Dialogue: 0,0:14:47.13,0:14:50.03,JP,,0000,0000,0000,,Импульсивті мінез-құлық та жойылады.
Dialogue: 0,0:14:51.42,0:14:54.99,JP,,0000,0000,0000,,Импульсивті мінез-құлық жойылады...?
Dialogue: 0,0:14:56.05,0:14:57.48,JP,,0000,0000,0000,,Мен солай деп үміттенемін.
Dialogue: 0,0:15:00.73,0:15:03.43,JP,,0000,0000,0000,,Қала әкімі әлі келді ме?
Dialogue: 0,0:15:04.40,0:15:05.19,JP,,0000,0000,0000,,Сауда автоматы
Dialogue: 0,0:15:12.16,0:15:13.60,JP,,0000,0000,0000,,Жылдам әмиян
Dialogue: 0,0:15:15.17,0:15:16.53,JP,,0000,0000,0000,,Ақша
Dialogue: 0,0:15:17.93,0:15:20.25,JP,,0000,0000,0000,,Ақша Ақша шай шай
Dialogue: 0,0:15:26.05,0:15:28.81,JP,,0000,0000,0000,,Қысқы киімді ауыстыруға әлі ерте.
Dialogue: 0,0:15:33.25,0:15:34.18,JP,,0000,0000,0000,,Яғни
Dialogue: 0,0:15:36.27,0:15:38.96,JP,,0000,0000,0000,,Мұғалім, мен не істеуім керек?
Dialogue: 0,0:15:39.29,0:15:41.27,JP,,0000,0000,0000,,Сен мені алып кетуге келдің бе?
Dialogue: 0,0:15:41.95,0:15:43.98,JP,,0000,0000,0000,,Жоқ, мен көлік жүргіздім.
Dialogue: 0,0:15:44.29,0:15:45.77,JP,,0000,0000,0000,,Сіз не істеп жатырсыз, әкім?
Dialogue: 0,0:15:46.67,0:15:49.81,JP,,0000,0000,0000,,Мұғалім, мен мінсем бе?
Dialogue: 0,0:15:58.23,0:16:02.42,JP,,0000,0000,0000,,Ойлап қарасам, алғаш келгенімде осылай болған.
Dialogue: 0,0:16:02.81,0:16:04.03,JP,,0000,0000,0000,,Уақыт келді
Dialogue: 0,0:16:12.93,0:16:15.48,JP,,0000,0000,0000,,Бүгін ауа-райы жақсы, сондықтан әдемі.
Dialogue: 0,0:16:17.40,0:16:20.07,JP,,0000,0000,0000,,Қалыпты болу қандай?
Dialogue: 0,0:16:20.98,0:16:27.34,JP,,0000,0000,0000,,Қалыпты... немесе қалыпты - ең жақсысы.
Dialogue: 0,0:16:33.19,0:16:35.25,JP,,0000,0000,0000,,Иә, бұл Киношита Шотен.
Dialogue: 0,0:16:37.05,0:16:37.79,JP,,0000,0000,0000,,Кавафуджи мырза
Dialogue: 0,0:16:38.08,0:16:40.85,JP,,0000,0000,0000,,Менің ойымша, мұғалім үйге келді.
Dialogue: 0,0:16:41.02,0:16:42.49,JP,,0000,0000,0000,,Сізді қала басшысы алып кетеді.
Dialogue: 0,0:16:41.51,0:16:43.99,JP-up,,0000,0000,0000,,Мұғалім, менің ойымша, бұл жерде бәрі жақсы.
Dialogue: 0,0:16:44.78,0:16:45.43,JP,,0000,0000,0000,,Естімейді
Dialogue: 0,0:16:45.77,0:16:47.84,JP-up,,0000,0000,0000,,Бұл жерде бәрі жақсы ма?
Dialogue: 0,0:16:46.60,0:16:50.06,JP,,0000,0000,0000,,Сәл күте тұрыңыз, сэр.
Dialogue: 0,0:16:57.99,0:17:01.13,JP,,0000,0000,0000,,Мұғалім сыртқы есікті ашқан сәті Пан-ччи-яккен
Dialogue: 0,0:17:01.36,0:17:02.99,JP,,0000,0000,0000,,Наруха Такле Якен
Dialogue: 0,0:17:02.99,0:17:04.32,JP,,0000,0000,0000,,Жарайды, орындаңыз.
Dialogue: 0,0:17:07.00,0:17:07.96,JP,,0000,0000,0000,,Ол қазірдің өзінде осында
Dialogue: 0,0:17:08.97,0:17:10.58,JP,,0000,0000,0000,,Бірдеңе дұрыс емес пе?
Dialogue: 0,0:17:10.58,0:17:12.10,JP,,0000,0000,0000,,Бір нәрсе дегеніміз не?
Dialogue: 0,0:17:12.10,0:17:12.92,JP,,0000,0000,0000,,Мұғалім бұл
Dialogue: 0,0:17:13.64,0:17:16.48,JP,,0000,0000,0000,,Маған Кавафуджи мырза қоңырау шалды, ол дүкенде.
Dialogue: 0,0:17:16.48,0:17:18.64,JP,,0000,0000,0000,,Кітап көрмесінің қорытындысы шыққан сияқты.
Dialogue: 0,0:17:19.13,0:17:20.62,JP,,0000,0000,0000,,Бұл жылдам.
Dialogue: 0,0:17:20.89,0:17:21.88,JP,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:17:21.88,0:17:25.35,JP,,0000,0000,0000,,Иә, егер мен екінші орын алсам, көңілім түсіп кетер еді.
Dialogue: 0,0:17:25.51,0:17:28.27,JP,,0000,0000,0000,,Жоқ, мұғалім де ересек адам.
Dialogue: 0,0:17:28.60,0:17:30.78,JP,,0000,0000,0000,,Атмосфераны нашарлататын сөздерді айтпа.
Dialogue: 0,0:17:30.78,0:17:31.84,JP,,0000,0000,0000,,Тәтті Хиро-нии
Dialogue: 0,0:17:32.15,0:17:34.20,JP,,0000,0000,0000,,Мұғалімнің бала мінезін сынама
Dialogue: 0,0:17:34.72,0:17:37.25,JP,,0000,0000,0000,,Екінші орынның көңілсіздігін елемеңіз.
Dialogue: 0,0:17:37.62,0:17:39.73,JP,,0000,0000,0000,,Барлығы, мұғалім қайтып келді.
Dialogue: 0,0:17:40.22,0:17:41.94,JP,,0000,0000,0000,,Бұл менмін, Крекер.
Dialogue: 0,0:17:41.94,0:17:43.27,JP,,0000,0000,0000,,Сізде бұрын болды, солай ма?
Dialogue: 0,0:17:43.47,0:17:45.10,JP,,0000,0000,0000,,Бұл менікі емес.
Dialogue: 0,0:17:45.61,0:17:46.56,JP,,0000,0000,0000,,Сізде
Dialogue: 0,0:17:49.35,0:17:50.35,JP,,0000,0000,0000,,болды
Dialogue: 0,0:17:50.75,0:17:51.45,JP,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:18:03.81,0:18:05.43,JP,,0000,0000,0000,,Ахахахахахха.
Dialogue: 0,0:18:05.43,0:18:06.56,JP,,0000,0000,0000,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:18:06.82,0:18:08.52,JP,,0000,0000,0000,,Мұғалім, жарайды.
Dialogue: 0,0:18:08.52,0:18:11.50,JP,,0000,0000,0000,,Маған осылай қарағаныңызға біраз болды ма?
Dialogue: 0,0:18:11.96,0:18:12.87,JP,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:18:13.23,0:18:15.50,JP,,0000,0000,0000,,Қолдарыңызда жабысқақ нәрсе бар.
Dialogue: 0,0:18:16.34,0:18:17.44,JP,,0000,0000,0000,,Менің көңіл-күйім жақсы
Dialogue: 0,0:18:17.55,0:18:18.96,JP,,0000,0000,0000,,Осылай болса жақсы.
Dialogue: 0,0:18:19.82,0:18:20.78,JP,,0000,0000,0000,,Сәлем, мұғалім
Dialogue: 0,0:18:21.15,0:18:22.92,JP,,0000,0000,0000,,Каллиграфия сайысы қалай өтті?
Dialogue: 0,0:18:23.92,0:18:24.98,JP,,0000,0000,0000,,Ең көп алынған
Dialogue: 0,0:18:26.37,0:18:27.12,JP,,0000,0000,0000,,Болу
Dialogue: 0,0:18:27.29,0:18:29.45,JP,,0000,0000,0000,,Менен мұны сұрасаң, жоқ деп жауап берер едің.
Dialogue: 0,0:18:29.45,0:18:31.23,JP,,0000,0000,0000,,Бұл сезімтал мәселе
Dialogue: 0,0:18:31.36,0:18:32.19,JP,,0000,0000,0000,,деді
Dialogue: 0,0:18:32.33,0:18:34.40,JP,,0000,0000,0000,,Мұғалім, енді уайымдамаңыз.
Dialogue: 0,0:18:35.08,0:18:38.94,JP,,0000,0000,0000,,Балалар, сендерді кітап көрмесінің нәтижесі алаңдатты ма?
Dialogue: 0,0:18:39.74,0:18:41.21,JP,,0000,0000,0000,,Жақсы нәтиже.
Dialogue: 0,0:18:42.33,0:18:43.23,JP,,0000,0000,0000,,Жарайды
Dialogue: 0,0:18:45.30,0:18:46.17,JP,,0000,0000,0000,,Мен мұны істедім
Dialogue: 0,0:18:46.17,0:18:47.60,JP,,0000,0000,0000,,Жақсы
Dialogue: 0,0:18:52.61,0:18:56.99,JP,,0000,0000,0000,,Ал, көңіл көтеріңдер, бұл жолы үлкендер керемет болды.
Dialogue: 0,0:18:57.46,0:18:59.65,JP,,0000,0000,0000,,Олардың екеуі де ауқымнан тыс.
Dialogue: 0,0:18:59.65,0:19:02.24,JP,,0000,0000,0000,,Жастардың үлкен жүзіңізге қарағанын қаламаған шығарсыз.
Dialogue: 0,0:19:02.67,0:19:05.94,JP,,0000,0000,0000,,Бұл болжанған нәтиже деп айтуға болады.
Dialogue: 0,0:19:06.08,0:19:07.63,JP,,0000,0000,0000,,Келдің бе, Кавафуджи-кун?
Dialogue: 0,0:19:09.18,0:19:09.87,JP,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:19:10.21,0:19:12.44,JP,,0000,0000,0000,,Нәтижелер туралы Киёсюге хабарладыңыз, солай ма?
Dialogue: 0,0:19:13.79,0:19:15.45,JP,,0000,0000,0000,,Ол қызығушылық танытқан сияқты.
Dialogue: 0,0:19:16.34,0:19:19.82,JP,,0000,0000,0000,,Бұл оның көңілін қалдыратын нәтиже болды деп ойлайсыз ба?
Dialogue: 0,0:19:20.07,0:19:22.27,JP,,0000,0000,0000,,Енді ше?
Dialogue: 0,0:19:22.80,0:19:26.46,JP,,0000,0000,0000,,Бұл өз қолжазбасын жазудағы алғашқы қадам ғана.
Dialogue: 0,0:19:26.98,0:19:28.64,JP,,0000,0000,0000,,Мен енді не болатынын асыға күтемін.
Dialogue: 0,0:19:31.05,0:19:32.71,JP,,0000,0000,0000,,Сәлеметсіз бе
Dialogue: 0,0:19:33.04,0:19:35.22,JP,,0000,0000,0000,,Содан кейін мұғалім Доғанжыба деп жазды.
Dialogue: 0,0:19:35.72,0:19:36.85,JP,,0000,0000,0000,,Мен бұл туралы қызықтымын.
Dialogue: 0,0:19:37.13,0:19:38.78,JP,,0000,0000,0000,,Бұл үлкен тақырып емес.
Dialogue: 0,0:19:39.07,0:19:41.17,JP,,0000,0000,0000,,Маған мүмкіндігінше тезірек айтып беріңізші.
Dialogue: 0,0:19:41.17,0:19:42.22,JP,,0000,0000,0000,,Жақсы нәтиже.
Dialogue: 0,0:19:43.81,0:19:46.43,JP,,0000,0000,0000,,Маған соншалықты көп айтқаныңызға қуаныштымын.
Dialogue: 0,0:19:46.47,0:19:47.34,JP,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:47.80,0:19:52.60,JP,,0000,0000,0000,,Егер мен айту керек болсам, дәл қазір бұл менің ең қымбат нәрсем.
Dialogue: 0,0:19:52.75,0:19:54.53,JP,,0000,0000,0000,,Не маңызды?
Dialogue: 0,0:19:56.16,0:19:57.16,JP,,0000,0000,0000,,Хиро-ни...
Dialogue: 0,0:19:56.54,0:19:58.16,JP-up,,0000,0000,0000,,Мен жазған каллиграфия.
Dialogue: 0,0:19:58.16,0:19:58.81,JP,,0000,0000,0000,,Жоқ
Dialogue: 0,0:19:59.88,0:20:03.05,JP,,0000,0000,0000,,Балалар сендер таяз екенсіңдер. Адамдар тамақтан жаралған.
Dialogue: 0,0:20:03.05,0:20:04.39,JP,,0000,0000,0000,,Тамаққа қатысы жоқ
Dialogue: 0,0:20:04.75,0:20:06.47,JP,,0000,0000,0000,,Сонда бұл қоян шығар.
Dialogue: 0,0:20:07.54,0:20:08.67,JP,,0000,0000,0000,,Хина не деді?
Dialogue: 0,0:20:08.67,0:20:10.56,JP,,0000,0000,0000,,Әй, қоңыз деп ойладым.
Dialogue: 0,0:20:10.61,0:20:11.79,JP,,0000,0000,0000,,Эй манты
Dialogue: 0,0:20:12.04,0:20:13.17,JP,,0000,0000,0000,,Олай болса, шаян
Dialogue: 0,0:20:13.45,0:20:15.75,JP,,0000,0000,0000,,Бәрің, мұғалімді мазаламаңдар.
Dialogue: 0,0:20:16.06,0:20:18.07,JP,,0000,0000,0000,,Аккидің тағы бір жақсы өркеші бар
Dialogue: 0,0:20:18.38,0:20:19.51,JP,,0000,0000,0000,,Хе-хе-хе…
Dialogue: 0,0:20:19.90,0:20:21.48,JP,,0000,0000,0000,,Кішкене салқын, Аккиха.
Dialogue: 0,0:20:23.82,0:20:28.32,JP,,0000,0000,0000,,Мұғалім, әртүрлі нәрселер бар.
Dialogue: 0,0:20:29.07,0:20:31.21,JP,,0000,0000,0000,,Барлығымен көңілді болыңыз
Dialogue: 0,0:20:38.68,0:20:41.40,JP,,0000,0000,0000,,Ештеңені ойламай көңілді жүргендеріңді көргенде
Dialogue: 0,0:20:42.05,0:20:43.84,JP,,0000,0000,0000,,Мен қатты әсер алдым.
Dialogue: 0,0:20:44.22,0:20:45.13,JP,,0000,0000,0000,,Әсер ету
Dialogue: 0,0:20:50.30,0:20:52.80,JP,,0000,0000,0000,,Бұл уақыт маңызды
Dialogue: 0,0:20:53.22,0:20:54.00,JP,,0000,0000,0000,,Түсінесіз бе?
Dialogue: 0,0:20:56.31,0:20:57.73,JP,,0000,0000,0000,,Мен түсінбеймін
Dialogue: 0,0:21:04.07,0:21:09.95,JP,,0000,0000,0000,,Мен қайтып келгеніме қуаныштымын.
