Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:05.33,0:01:07.63,OP-JP,,0,0,0,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:01:08.39,0:01:10.88,OP-JP,,0,0,0,,«Басқалардан ерекшелену» арқылы өзіңізді ерекшелендіріңіз
Dialogue: 0,0:01:11.12,0:01:13.36,OP-JP,,0,0,0,,Дүкен журналының бұрышы
Dialogue: 0,0:01:13.86,0:01:16.75,OP-JP,,0,0,0,,Мұқабаға кездейсоқ жазылған.
Dialogue: 0,0:01:16.81,0:01:19.09,OP-JP,,0,0,0,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:01:19.56,0:01:22.11,OP-JP,,0,0,0,,Кішкентай кезімде түк көрмедім.
Dialogue: 0,0:01:22.60,0:01:25.07,OP-JP,,0,0,0,,Ұнамаса, ашулан.
Dialogue: 0,0:01:25.10,0:01:27.99,OP-JP,,0,0,0,,Сізге ұнайтын нәрсені айтыңыз
Dialogue: 0,0:01:28.07,0:01:31.16,OP-JP,,0,0,0,,Біз өзгереміз
Dialogue: 0,0:01:31.16,0:01:34.03,OP-JP,,0,0,0,,Нені қорғағыңыз келетін өзгерістер
Dialogue: 0,0:01:34.03,0:01:36.78,OP-JP,,0,0,0,,Түсінбеген қазынадан
Dialogue: 0,0:01:36.85,0:01:39.52,OP-JP,,0,0,0,,Түсіну керек
Dialogue: 0,0:01:39.52,0:01:45.05,OP-JP,,0,0,0,,Өскен сайын өкінесің.
Dialogue: 0,0:01:45.06,0:01:47.67,OP-JP,,0,0,0,,Бірақ бәрібір.
Dialogue: 0,0:01:48.07,0:01:52.00,OP-JP,,0,0,0,,Сіз бір нәрсе көре аласыз
Dialogue: 0,0:01:53.66,0:01:59.09,OP-JP,,0,0,0,,Сондықтан мен өзіммін, ал сен өзіңсің.
Dialogue: 0,0:01:59.09,0:02:05.08,OP-JP,,0,0,0,,Менің ойымша, бұл басынан бастап іздейтін нәрсе емес.
Dialogue: 0,0:02:05.08,0:02:10.35,OP-JP,,0,0,0,,Мен сен емеспін, сен де мен емессің
Dialogue: 0,0:02:10.36,0:02:13.22,OP-JP,,0,0,0,,Бір-бірінен өту, қол ұстасу
Dialogue: 0,0:02:13.27,0:02:17.83,OP-JP,,0,0,0,,Махаббаттың туатын жері.
Dialogue: 0,0:02:19.00,0:02:21.73,OP-JP,,0,0,0,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:02:21.79,0:02:27.85,OP-JP,,0,0,0,,Мен оны өзгерте алмаймын, себебі бұл маңызды.
Dialogue: 0,0:02:28.25,0:02:31.60,OP-JP,,0,0,0,,Өзгеретін өмір дұрыс
Dialogue: 0,0:20:25.12,0:20:27.57,ED-JP,,0,0,0,,Сіз кішкентай қолыңызды создыңыз
Dialogue: 0,0:20:27.70,0:20:33.46,ED-JP,,0,0,0,,Саған ұқсап күлу табиғи болды
Dialogue: 0,0:20:36.04,0:20:38.63,ED-JP,,0,0,0,,Оның мағынасы болмауы мүмкін
Dialogue: 0,0:20:38.86,0:20:44.40,ED-JP,,0,0,0,,бірақ бұл мен істей алмайтын нәрсе
Dialogue: 0,0:20:46.73,0:20:50.47,ED-JP,,0,0,0,,Сен ойланбастан қолыма тидің
Dialogue: 0,0:20:50.47,0:20:54.26,ED-JP,,0,0,0,,бірақ бұл мен үшін жақсы болды
Dialogue: 0,0:20:57.19,0:21:02.58,ED-JP,,0,0,0,,Біз сенген барлық уақытта
Dialogue: 0,0:21:02.70,0:21:08.06,ED-JP,,0,0,0,,дүние біздің қолымызда болды
Dialogue: 0,0:21:08.25,0:21:10.96,ED-JP,,0,0,0,,Біз қателестік
Dialogue: 0,0:21:10.96,0:21:19.03,ED-JP,,0,0,0,,мүмкін бұл сен менің қолымды ұстап тұрғандықтан емес шығар
Dialogue: 0,0:21:19.03,0:21:24.65,ED-JP,,0,0,0,,Әр сәтте
Dialogue: 0,0:21:24.76,0:21:30.19,ED-JP,,0,0,0,,Барлық жерде
Dialogue: 0,0:21:30.29,0:21:35.52,ED-JP,,0,0,0,,Мен сене аламын, сене аламын
Dialogue: 0,0:21:35.85,0:21:40.70,ED-JP,,0,0,0,,Жылы алақаныңды ұстағанда
Dialogue: 0,0:21:40.76,0:21:48.07,ED-JP,,0,0,0,,сіздің жылы қолыңыз
Dialogue: 0,0:02:37.01,0:02:42.01,LOGO,,0,0,0,,Бұл субтитр көзі өндіруші, жеткізуші, алмасу студенті шығарған және коммерциялық пайдалануға тыйым салынған субтитр ұйымы (kamigami.org) болып табылады.
Dialogue: 0,0:02:42.01,0:02:47.01,LOGO,,0,0,0,,: :& :&lucifer : :
Dialogue: 0,0:00:03.59,0:00:09.49,JP,,0,0,0,,Жастардың рөлі - сәтсіздіктерден қорықпай, жаңа көкжиектерді ашу.
Dialogue: 0,0:00:09.86,0:00:11.71,JP,,0,0,0,,Жаңа шекара?
Dialogue: 0,0:00:16.89,0:00:17.55,JP,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:00:22.35,0:00:23.43,JP,,0,0,0,,Мұғалім
Dialogue: 0,0:00:25.62,0:00:26.86,JP,,0,0,0,,Нанбаши Йотто
Dialogue: 0,0:00:32.21,0:00:33.30,JP,,0,0,0,,Naru's birthday
Dialogue: 0,0:00:34.19,0:00:36.76,JP,,0,0,0,,Нарудан сұрасаң, таң қалмайды.
Dialogue: 0,0:00:37.06,0:00:41.72,JP,,0,0,0,,Мен бәріміз той жасаймыз деп ойладым, мұғалім ересек адам болғандықтан, мен оған 1000 иен беремін.
Dialogue: 0,0:00:42.04,0:00:44.10,JP,,0,0,0,,Балаңыздың туған күніне ақы төлейсіз бе?
Dialogue: 0,0:00:44.24,0:00:45.97,JP,,0,0,0,,Мүшелік жарна емес, торт жарнасы
Dialogue: 0,0:00:46.23,0:00:48.45,JP,,0,0,0,,Қалталы ақшаға зал сатып ала алмаймыз.
Dialogue: 0,0:00:49.12,0:00:54.06,JP,,0,0,0,,Кешке Хиро-ни тамақ әкеледі, мұғалім де сыйлық дайындайды.
Dialogue: 0,0:00:54.20,0:00:55.13,JP,,0,0,0,,Қазіргі
Dialogue: 0,0:00:55.22,0:00:57.09,JP,,0,0,0,,торт торты
Dialogue: 0,0:00:55.58,0:00:57.52,JP,,0,0,0,,Бүгін жазуым керек.
Dialogue: 0,0:00:58.98,0:01:01.25,JP,,0,0,0,,Ал, бүгін қалайсың?
Dialogue: 0,0:00:00.00,0:00:00.00,JP,,0,0,0,,Аудармасы: Ненбутсу биі
Dialogue: 0,0:02:37.88,0:02:40.24,JP,,0,0,0,,Сыйлық - тұлып қонжық.
Dialogue: 0,0:02:41.24,0:02:42.60,JP,,0,0,0,,Бұл соққыға арналған қап.
Dialogue: 0,0:02:43.07,0:02:43.87,JP,,0,0,0,,It's a ribbon.
Dialogue: 0,0:02:44.30,0:02:47.19,JP,,0,0,0,,Yaho, беліңізге киюге өте ыңғайлы.
Dialogue: 0,0:02:47.40,0:02:49.08,JP,,0,0,0,,Қараңдаршы, бұл айна.
Dialogue: 0,0:02:50.18,0:02:52.39,JP,,0,0,0,,Laser beam
Dialogue: 0,0:02:51.45,0:02:52.41,JP,,0,0,0,,dazzling
Dialogue: 0,0:02:54.22,0:02:55.93,JP,,0,0,0,,Ештеңе дұрыс емес.
Dialogue: 0,0:02:56.50,0:02:58.46,JP,,0,0,0,,Қызық, оны не бақытты етеді?
Dialogue: 0,0:03:01.32,0:03:02.72,JP,,0,0,0,,Цикада шулы
Dialogue: 0,0:03:07.22,0:03:10.36,JP,,0,0,0,,Okay, I did it. Мен цикада ұстадым.
Dialogue: 0,0:03:11.72,0:03:13.19,JP,,0,0,0,,Кента, маған бір сәт болады ма?
Dialogue: 0,0:03:14.12,0:03:15.88,JP,,0,0,0,,Мұғалім, бірдеңе үшін бе?
Dialogue: 0,0:03:16.03,0:03:18.43,JP,,0,0,0,,Жоқ, менің сенен бір жақсылығым бар.
Dialogue: 0,0:03:19.67,0:03:21.54,JP,,0,0,0,,Бұл менің ойыма келетін жалғыз сыйлық.
Dialogue: 0,0:03:22.14,0:03:23.68,JP,,0,0,0,,Give me a beetle
Dialogue: 0,0:03:23.20,0:03:23.68,JP,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:03:24.97,0:03:26.69,JP,,0,0,0,,One, only one.
Dialogue: 0,0:03:26.69,0:03:28.83,JP,,0,0,0,,Мен саған 10 иен төлеймін, бұл балаға көп ақша.
Dialogue: 0,0:03:28.90,0:03:30.37,JP,,0,0,0,,Шицуко Казо мырза
Dialogue: 0,0:03:30.64,0:03:32.50,JP,,0,0,0,,Сізге сыйлық беретін кез келді.
Dialogue: 0,0:03:32.83,0:03:34.65,JP,,0,0,0,,Қоңыздар қауіпті
Dialogue: 0,0:03:34.87,0:03:36.45,JP,,0,0,0,,Бірдей болса жеткілікті.
Dialogue: 0,0:03:36.65,0:03:37.32,JP,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:03:37.56,0:03:41.57,JP,,0,0,0,,Ақырында 100 қоңыз алып, қоңыздар төсегін жасады.
Dialogue: 0,0:03:41.57,0:03:42.96,JP,,0,0,0,,Бұл жазалау ойыны.
Dialogue: 0,0:03:43.37,0:03:46.42,JP,,0,0,0,,Сонымен қатар, мен сыйлықтардың бірдей болғанын ұнатпаймын.
Dialogue: 0,0:03:46.75,0:03:48.11,JP,,0,0,0,,Well, that's
Dialogue: 0,0:03:48.76,0:03:50.40,JP,,0,0,0,,Ичиро мен Джиро не істейді?
Dialogue: 0,0:03:50.70,0:03:52.28,JP,,0,0,0,,Оған сәйкес атау бермеңіз
Dialogue: 0,0:03:52.42,0:03:54.00,JP,,0,0,0,,Қарттар тәттілерді таратады
Dialogue: 0,0:03:54.39,0:03:56.00,JP,,0,0,0,,Барлығы бұл туралы ойлайды.
Dialogue: 0,0:03:56.27,0:03:58.06,JP,,0,0,0,,Мұғалімдер де мұқият ойлануы керек.
Dialogue: 0,0:04:00.63,0:04:01.81,JP,,0,0,0,,Кувагата жасайық
Dialogue: 0,0:04:02.97,0:04:06.71,JP,,0,0,0,,Егер сіз сонша қоңыздарды ұстай алсаңыз, онда кувагата оңайырақ болар еді.
Dialogue: 0,0:04:07.02,0:04:07.73,JP,,0,0,0,,Маған торыңды қарызға бер
Dialogue: 0,0:04:08.60,0:04:10.81,JP,,0,0,0,,Мұғалім, жәндіктерге қарсы құралды жалау керек.
Dialogue: 0,0:04:11.21,0:04:13.69,JP,,0,0,0,,Егер сіз қателерді ұстағыңыз келсе, сіз жай ғана өміріңізді бұзасыз.
Dialogue: 0,0:04:13.90,0:04:17.27,JP,,0,0,0,,Қарапайым тілмен айтқанда, оны табу қиын.
Dialogue: 0,0:04:17.40,0:04:19.82,JP,,0,0,0,,Себебі сіз балаларсыз.
Dialogue: 0,0:04:20.43,0:04:24.32,JP,,0,0,0,,Бойыңыз үлкен болса, биіктен көріне аласыз, сондықтан оңай.
Dialogue: 0,0:04:24.46,0:04:27.01,JP,,0,0,0,,Ұстаз, сіз үнемі тітіркеніп кетесіз.
Dialogue: 0,0:04:28.05,0:04:29.18,JP,,0,0,0,,Дереу табу
Dialogue: 0,0:04:32.89,0:04:34.30,JP,,0,0,0,,Әйел заты
Dialogue: 0,0:04:34.57,0:04:37.12,JP,,0,0,0,,Эй, мен таптым.
Dialogue: 0,0:04:37.18,0:04:40.67,JP,,0,0,0,,Бұл біраз жұмыс. Сіз оны ұстағанша уақыт мәселесі.
Dialogue: 0,0:04:40.75,0:04:41.49,JP,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:04:42.28,0:04:46.16,JP,,0,0,0,,Бір қоңызды ұстай алмасаңыз, пәледен еріп кетесіз.
Dialogue: 0,0:04:48.16,0:04:49.22,JP,,0,0,0,,Көңілі қалды
Dialogue: 0,0:04:49.53,0:04:51.71,JP,,0,0,0,,Қарсы емеспін, бірақ ренжіме.
Dialogue: 0,0:04:52.02,0:04:54.12,JP,,0,0,0,,Кента Бұл да осында.
Dialogue: 0,0:04:54.63,0:04:55.56,JP,,0,0,0,,Түсіндім
Dialogue: 0,0:04:55.56,0:04:57.37,JP,,0,0,0,,Ер адам да жеңілмейді
Dialogue: 0,0:04:58.78,0:04:59.30,JP,,0,0,0,,Жарайды
Dialogue: 0,0:04:59.80,0:05:03.85,JP,,0,0,0,,Ия, мен қоңыз ұстадым. Бұл не?
Dialogue: 0,0:05:03.98,0:05:06.18,JP,,0,0,0,,Канабун Дешида
Dialogue: 0,0:05:06.82,0:05:08.44,JP,,0,0,0,,Мұғалім ештеңені ұстай алмайды.
Dialogue: 0,0:05:07.37,0:05:09.25,JP,,0,0,0,,Сол жаққа барайық.
Dialogue: 0,0:05:10.57,0:05:13.31,JP,,0,0,0,,Қарғыс атқыр балалар, жеңіліске шыдай аласың ба?
Dialogue: 0,0:05:14.49,0:05:15.57,JP,,0,0,0,,Окувагата
Dialogue: 0,0:05:16.03,0:05:17.43,JP,,0,0,0,,Бұл сәл қымбат па?
Dialogue: 0,0:05:17.86,0:05:22.17,JP,,0,0,0,,Жарайды, жақсырақ қалыптастыру.
Dialogue: 0,0:05:25.53,0:05:27.40,JP,,0,0,0,,Сәл кейінірек
Dialogue: 0,0:05:28.64,0:05:29.30,JP,,0,0,0,,Хе-хе, рақмет
Dialogue: 0,0:05:29.59,0:05:31.71,JP,,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:05:33.67,0:05:34.95,JP,,0,0,0,,Itatata...
Dialogue: 0,0:05:35.11,0:05:35.81,JP,,0,0,0,,Кента
Dialogue: 0,0:05:36.18,0:05:38.13,JP,,0,0,0,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:05:39.86,0:05:42.22,JP,,0,0,0,,Мұғалім, үйге қайттың, солай емес пе?
Dialogue: 0,0:05:42.26,0:05:43.99,JP,,0,0,0,,Ең алдымен рахмет.
Dialogue: 0,0:05:44.31,0:05:45.89,JP,,0,0,0,,Бір балық ауламай үйге бара аласың ба?
Dialogue: 0,0:05:46.78,0:05:48.69,JP,,0,0,0,,Егер сізде бұл болса, сіз жындарды жеңе аласыз.
Dialogue: 0,0:05:49.31,0:05:51.66,JP,,0,0,0,,Сіз қанша биікте болсаңыз да, жәндіктерді ұстай аласыз.
Dialogue: 0,0:05:52.64,0:05:54.36,JP,,0,0,0,,Жарайды, сыйлығыңды ал.
Dialogue: 0,0:05:57.64,0:05:58.50,JP,,0,0,0,,Мұғалім
Dialogue: 0,0:05:59.25,0:06:00.86,JP,,0,0,0,,Маған бір сәтке торыңызды қарызға беріңізші.
Dialogue: 0,0:06:01.10,0:06:03.56,JP,,0,0,0,,Сіз мұнда қателерді ұстау үшін келдіңіз бе?
Dialogue: 0,0:06:03.67,0:06:05.54,JP,,0,0,0,,Ақымақ сені тістеп алуы мүмкін.
Dialogue: 0,0:06:05.55,0:06:07.09,JP,,0,0,0,,Мүмкін сізде біртүрлі ауру бар шығар.
Dialogue: 0,0:06:07.09,0:06:08.85,JP,,0,0,0,,Мен тістемесем ауырғым келмейді.
Dialogue: 0,0:06:09.07,0:06:10.33,JP,,0,0,0,,Кувагатадан кешірім сұраңыз
Dialogue: 0,0:06:10.33,0:06:13.08,JP,,0,0,0,,Жақыннан қарасаңыз, мен ойлағаннан да жиіркенішті.
Dialogue: 0,0:06:13.34,0:06:14.96,JP,,0,0,0,,Неге сонша жылтыр?
Dialogue: 0,0:06:15.22,0:06:16.50,JP,,0,0,0,,Тарақан деген жоқ.
Dialogue: 0,0:06:16.57,0:06:18.83,JP,,0,0,0,,Бұл мүлдем басқа, ақымақ.
Dialogue: 0,0:06:18.92,0:06:20.08,JP,,0,0,0,,Тек торды жылдамырақ жасаңыз
Dialogue: 0,0:06:20.19,0:06:20.83,JP,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:06:28.12,0:06:29.75,JP,,0,0,0,,Мен бірдеңе ауырғандай сезінемін.
Dialogue: 0,0:06:29.93,0:06:32.32,JP,,0,0,0,,Менің ойымша, мен бұл жігіттің қателерін ұстаймын.
Dialogue: 0,0:06:32.32,0:06:33.03,JP,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:06:34.01,0:06:36.14,JP,,0,0,0,,Керемет, Кентаға қара
Dialogue: 0,0:06:36.34,0:06:38.27,JP,,0,0,0,,Геркулес қоңызы
Dialogue: 0,0:06:38.52,0:06:39.85,JP,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:06:40.06,0:06:44.08,JP,,0,0,0,,Сақтаған болсам, қашып кетуіне жол берер едім, әйтпесе оның аман қалуы мүмкін емес еді.
Dialogue: 0,0:06:44.17,0:06:46.49,JP,,0,0,0,,Не, соншалықты ғажап па?
Dialogue: 0,0:06:46.49,0:06:47.55,JP,,0,0,0,,Керемет
Dialogue: 0,0:06:47.76,0:06:50.28,JP,,0,0,0,,Мен мұны теледидардан 20 000 иенге жасадым.
Dialogue: 0,0:06:50.49,0:06:51.69,JP,,0,0,0,,Жәндіктер үшін 20 000 иен
Dialogue: 0,0:06:52.26,0:06:53.84,JP,,0,0,0,,Мұғалім, баспалдақты маған беріңіз.
Dialogue: 0,0:06:54.81,0:06:56.38,JP,,0,0,0,,Оны түсіру үшін бірге жұмыс жасайық
Dialogue: 0,0:06:56.51,0:06:59.05,JP,,0,0,0,,Үлкен іс жасасаң, бақытты боласың.
Dialogue: 0,0:06:59.05,0:07:00.08,JP,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:00.45,0:07:02.08,JP,,0,0,0,,20 000 братқа сыйлық үшін
Dialogue: 0,0:07:04.87,0:07:07.67,JP,,0,0,0,,Абайлап, абайлап, Кента
Dialogue: 0,0:07:08.20,0:07:08.59,JP,,0,0,0,,Иә
Dialogue: 0,0:07:09.55,0:07:12.06,JP,,0,0,0,,Сізбен байланысу мүмкін емес
Dialogue: 0,0:07:12.50,0:07:13.28,JP,,0,0,0,,Мұғалім
Dialogue: 0,0:07:13.30,0:07:14.46,JP,,0,0,0,,Мен, жоқ, бұл мүмкін емес.
Dialogue: 0,0:07:14.46,0:07:17.48,JP,,0,0,0,,Мұғалім: Баспалдақ тірегі
Dialogue: 0,0:07:17.48,0:07:20.32,JP,,0,0,0,,Мұғалім қолынан келгеннің бәрін жасағанын айтты.
Dialogue: 0,0:07:20.32,0:07:22.89,JP,,0,0,0,,Бірге үлкен сыйлық берейік
Dialogue: 0,0:07:22.97,0:07:25.64,JP,,0,0,0,,Мұғалім, өтінемін
Dialogue: 0,0:07:27.66,0:07:28.98,JP,,0,0,0,,Мұғалімнің жекпе-жегі
Dialogue: 0,0:07:29.18,0:07:29.80,JP,,0,0,0,,Ұрыс
Dialogue: 0,0:07:29.80,0:07:30.87,JP,,0,0,0,,Гибаре мырза
Dialogue: 0,0:07:31.47,0:07:32.79,JP,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 0,0:07:33.04,0:07:34.75,JP,,0,0,0,,Шулы, тез ұстаңыз.
Dialogue: 0,0:07:36.48,0:07:37.17,JP,,0,0,0,,Мен ұсталдым.
Dialogue: 0,0:07:37.30,0:07:39.46,JP,,0,0,0,,Ура!
Dialogue: 0,0:07:39.80,0:07:42.64,JP,,0,0,0,,Геркулес Геркулес
Dialogue: 0,0:07:39.48,0:07:41.60,JP,,0,0,0,,Ей, эй, жіберме.
Dialogue: 0,0:07:47.05,0:07:49.66,JP,,0,0,0,,Неліктен бір күнде екі рет құлайсың?
Dialogue: 0,0:07:49.95,0:07:52.38,JP,,0,0,0,,Бұл онсыз да талант, ебедейсіз
Dialogue: 0,0:07:52.73,0:07:54.49,JP,,0,0,0,,Мен саған енді ешқашан сенбеймін
Dialogue: 0,0:07:55.16,0:07:56.49,JP,,0,0,0,,Содан кейін Геркулес
Dialogue: 0,0:07:57.32,0:08:00.47,JP,,0,0,0,,Мен оның қашып кетуіне жол бермеу керек деп, қатты ұстадым.
Dialogue: 0,0:08:05.51,0:08:07.56,JP,,0,0,0,,Бұл мені таң қалдырмайды.
Dialogue: 0,0:08:08.20,0:08:09.04,JP,,0,0,0,,Дәл осы
Dialogue: 0,0:08:09.40,0:08:09.85,JP,,0,0,0,,Өлім
Dialogue: 0,0:08:09.98,0:08:11.10,JP,,0,0,0,,Бұлай болмауы керек.
Dialogue: 0,0:08:17.36,0:08:19.17,JP,,0,0,0,,Ол жаншып жатыр
Dialogue: 0,0:08:19.17,0:08:20.23,JP,,0,0,0,,Бұл өтірік
Dialogue: 0,0:08:20.23,0:08:22.41,JP,,0,0,0,,Геркулестің жаншылуы мүмкін емес.
Dialogue: 0,0:08:22.41,0:08:23.40,JP,,0,0,0,,Ақымақ ақымақ ақымақ
Dialogue: 0,0:08:23.67,0:08:24.89,JP,,0,0,0,,Өл және оның ақысын төле.
Dialogue: 0,0:08:25.20,0:08:26.09,JP,,0,0,0,,Көп айтыңыз
Dialogue: 0,0:08:27.13,0:08:28.82,JP,,0,0,0,,Бір жәндік үшін сонша
Dialogue: 0,0:08:30.54,0:08:33.48,JP,,0,0,0,,Мен бұл туралы ойладым
Dialogue: 0,0:08:35.12,0:08:36.73,JP,,0,0,0,,Енді жылама
Dialogue: 0,0:08:38.43,0:08:40.10,JP,,0,0,0,,Жоқ, бұл өте нашар болды.
Dialogue: 0,0:08:40.53,0:08:41.53,JP,,0,0,0,,Жетеді ме?
Dialogue: 0,0:08:50.96,0:08:52.06,JP,,0,0,0,,Иә мырза
Dialogue: 0,0:08:53.04,0:08:54.70,JP,,0,0,0,,Мен саған ұстаған бейбақтардың бірін беремін.
Dialogue: 0,0:08:55.01,0:08:55.55,JP,,0,0,0,,Жақсы ма?
Dialogue: 0,0:08:56.74,0:08:58.66,JP,,0,0,0,,Наруға қиын болды
Dialogue: 0,0:08:59.66,0:09:02.98,JP,,0,0,0,,Мұғалім сияқты шындап ойнайтын ересек адам ойнай бастайды.
Dialogue: 0,0:09:03.80,0:09:06.83,JP,,0,0,0,,Мен осы жазды көңілді өткіземін.
Dialogue: 0,0:09:07.19,0:09:07.96,JP,,0,0,0,,Онмо
Dialogue: 0,0:09:07.96,0:09:08.60,JP,,0,0,0,,Онмо
Dialogue: 0,0:09:08.78,0:09:09.79,JP,,0,0,0,,Балалар
Dialogue: 0,0:09:12.77,0:09:14.16,JP,,0,0,0,,Оны арқаңыздан ұстаңыз.
Dialogue: 0,0:09:14.85,0:09:15.43,JP,,0,0,0,,...
Dialogue: 0,0:09:15.58,0:09:16.09,JP,,0,0,0,,Иә
Dialogue: 0,0:09:16.15,0:09:18.27,JP,,0,0,0,,Ия, түсіндім.
Dialogue: 0,0:09:18.48,0:09:21.04,JP,,0,0,0,,Балалар, енді біз сендерге бір қадам жақындадық.
Dialogue: 0,0:09:21.37,0:09:23.65,JP,,0,0,0,,Мен сендермен ойнамаймын.
Dialogue: 0,0:09:23.80,0:09:25.13,JP,,0,0,0,,Мен жеңілгім келмейді
Dialogue: 0,0:09:25.46,0:09:28.31,JP,,0,0,0,,Мен байыпты боламын, сондықтан дайын болыңыз.
Dialogue: 0,0:09:33.46,0:09:35.92,JP,,0,0,0,,Нанбаши Йот? Идиот.
Dialogue: 0,0:09:41.20,0:09:44.35,JP,,0,0,0,,Менің үйім кештерге арналған.
Dialogue: 0,0:09:45.03,0:09:46.59,JP,,0,0,0,,Мұғалім, сіз баяусыз.
Dialogue: 0,0:09:46.67,0:09:48.80,JP,,0,0,0,,Балалар сендер үйге қалай кірдіңдер?
Dialogue: 0,0:09:49.33,0:09:50.34,JP,,0,0,0,,Амакана
Dialogue: 0,0:09:50.75,0:09:53.71,JP,,0,0,0,,Қызық, Көкобаны өз базамызға айналдырғанымызға қанша жыл болды?
Dialogue: 0,0:09:54.06,0:09:56.71,JP,,0,0,0,,Менде басқа бөтелке бар, мен оны қайтарамын.
Dialogue: 0,0:09:57.58,0:09:58.03,JP,,0,0,0,,Мүмкін емес
Dialogue: 0,0:09:58.71,0:09:59.58,JP,,0,0,0,,Көшірме кілт
Dialogue: 0,0:10:00.65,0:10:05.92,JP,,0,0,0,,Мен аппараттық дүкенде велосипед кілттерінің көшірмелерін жасадым, олар таңқаларлық арзан болды. Мен олардың бесеуін жасадым.
Dialogue: 0,0:10:06.26,0:10:07.56,JP,,0,0,0,,Менде де бар.
Dialogue: 0,0:10:08.35,0:10:10.02,JP,,0,0,0,,Мен бүгін ғана құлыпты аштым.
Dialogue: 0,0:10:10.40,0:10:11.69,JP,,0,0,0,,Хиро, сен де?
Dialogue: 0,0:10:12.08,0:10:15.56,JP,,0,0,0,,Ал, егер бесеу болса, екіншісін кім таңдайды?
Dialogue: 0,0:10:16.27,0:10:17.20,JP,,0,0,0,,Жоғалған
Dialogue: 0,0:10:19.20,0:10:21.16,JP,,0,0,0,,Таудың ар жағындағы тауда ойнаған кезімізде шығар.
Dialogue: 0,0:10:21.41,0:10:23.50,JP,,0,0,0,,Мұғалім мен саған сыйлық дайындап қойдым.
Dialogue: 0,0:10:23.94,0:10:25.50,JP,,0,0,0,,Иә, сыйлық.
Dialogue: 0,0:10:26.85,0:10:28.72,JP,,0,0,0,,Мен көпіршікті орама алып келдім.
Dialogue: 0,0:10:29.05,0:10:31.35,JP,,0,0,0,,Мен тауыстың қауырсынын алдым.
Dialogue: 0,0:10:32.01,0:10:34.57,JP,,0,0,0,,Балалар сендер Нару но Цубоны түсінесіңдер.
Dialogue: 0,0:10:35.04,0:10:37.97,JP,,0,0,0,,Мива-чан, бұл көпіршікті орама ма, жоқ па деп ойладым.
Dialogue: 0,0:10:38.42,0:10:39.60,JP,,0,0,0,,Бірақ бұл қауырсындар?
Dialogue: 0,0:10:39.60,0:10:40.36,JP,,0,0,0,,Алдымен саусақтарыңды найза пішініне келтір.
Dialogue: 0,0:10:42.04,0:10:43.12,JP,,0,0,0,,Нару келді
Dialogue: 0,0:10:43.12,0:10:45.12,JP,,0,0,0,,Жоқ, бәрі дайындал.
Dialogue: 0,0:10:49.33,0:10:51.21,JP,,0,0,0,,Бұл менің туған күнімді бірінші рет өткізуім.
Dialogue: 0,0:10:51.50,0:10:54.09,JP,,0,0,0,,Мұғалім болмаса, мен мұны көп істей алмас едім.
Dialogue: 0,0:10:55.17,0:10:55.58,JP,,0,0,0,,Қол жұдырық
Dialogue: 0,0:10:56.05,0:10:57.76,JP,,0,0,0,,Мен мұны бұдан былай жыл сайын жасаймын.
Dialogue: 0,0:10:58.95,0:11:00.42,JP,,0,0,0,,Мен не істедім?
Dialogue: 0,0:11:01.12,0:11:03.11,JP,,0,0,0,,Нару кірсе, бұл крекер.
Dialogue: 0,0:11:05.32,0:11:05.85,JP,,0,0,0,,Жер
Dialogue: 0,0:11:12.82,0:11:15.06,JP,,0,0,0,,Нару Құттықтаймыз
Dialogue: 0,0:11:15.59,0:11:17.21,JP,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:11:17.59,0:11:19.21,JP,,0,0,0,,Түсіндім, сенің туған күнің.
Dialogue: 0,0:11:19.74,0:11:21.78,JP,,0,0,0,,Алдымен мұғалімнің сыйлығы
Dialogue: 0,0:11:21.94,0:11:23.46,JP,,0,0,0,,Жоқ, мен кейінірек келемін.
Dialogue: 0,0:11:23.78,0:11:25.50,JP,,0,0,0,,Ақылсыз ештеңе айтпа
Dialogue: 0,0:11:24.91,0:11:26.40,JP,,0,0,0,,Әй, тоқта!
Dialogue: 0,0:11:27.02,0:11:28.11,JP,,0,0,0,,Бұл қандай жаман иіс?
Dialogue: 0,0:11:29.62,0:11:30.85,JP,,0,0,0,,Мұғалімнен иә
Dialogue: 0,0:11:38.88,0:11:41.29,JP,,0,0,0,,Бұл не? Бастауыш сынып оқушыларының аналар күні
Dialogue: 0,0:11:41.40,0:11:43.45,JP,,0,0,0,,Ал бір бөлік тым кішкентай.
Dialogue: 0,0:11:43.45,0:11:44.74,JP,,0,0,0,,Балалар
Dialogue: 0,0:11:45.81,0:11:47.74,JP,,0,0,0,,Нару, ашулануға болмайды.
Dialogue: 0,0:11:52.39,0:11:55.00,JP,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:11:55.00,0:11:57.05,JP,,0,0,0,,Осылай риза болсаң, қорқынышты болар еді.
Dialogue: 0,0:11:57.18,0:11:58.65,JP,,0,0,0,,Сізге жақсы Нару
Dialogue: 0,0:12:05.71,0:12:08.15,JP,,0,0,0,,Біз қашан, кім отырғызғаны белгісіз күнбағыс
Dialogue: 0,0:12:08.70,0:12:10.66,JP,,0,0,0,,Мен өте мұқият суарамын
Dialogue: 0,0:12:11.78,0:12:14.48,JP,,0,0,0,,Мен оны бәрібір жалғыз қалдырсам, ол өздігінен өседі деп ойлаймын.
Dialogue: 0,0:12:16.07,0:12:19.04,JP,,0,0,0,,Ол жерге қайтадан көтерілу қауіпті болар еді.
Dialogue: 0,0:12:19.47,0:12:21.11,JP,,0,0,0,,Атасы бейітіне барады
Dialogue: 0,0:12:21.52,0:12:23.19,JP,,0,0,0,,Сенсэй мені осында әкелді.
Dialogue: 0,0:12:23.61,0:12:24.47,JP,,0,0,0,,Бейітті зиярат ету
Dialogue: 0,0:12:24.96,0:12:25.38,JP,,0,0,0,,Иә
Dialogue: 0,0:12:29.23,0:12:32.00,JP,,0,0,0,,Мұғалім мұнда, міне
Dialogue: 0,0:12:31.21,0:12:33.67,JP,,0,0,0,,Түсіндім, қазірдің өзінде Обон уақыты.
Dialogue: 0,0:12:33.90,0:12:37.80,JP,,0,0,0,,Мұғалім Көшібай ұстаз
Dialogue: 0,0:12:37.90,0:12:39.52,JP,,0,0,0,,Келгеніңізге рахмет.
Dialogue: 0,0:12:39.70,0:12:42.57,JP,,0,0,0,,Маған, басқа біреуге, көрге барғаным дұрыс па?
Dialogue: 0,0:12:42.66,0:12:44.96,JP,,0,0,0,,Әй, далаға барайық.
Dialogue: 0,0:12:45.31,0:12:48.40,JP,,0,0,0,,Қабір отын сөндіре алсаңыз, мен риза болар едім.
Dialogue: 0,0:12:50.41,0:12:52.78,JP,,0,0,0,,Петардалар Қандай жаза!
Dialogue: 0,0:12:54.04,0:12:55.92,JP,,0,0,0,,Бұл жерде қалыпты жағдай.
Dialogue: 0,0:12:56.22,0:12:56.92,JP,,0,0,0,,Кеден
Dialogue: 0,0:12:57.56,0:12:58.99,JP,,0,0,0,,Ал, қалғанын мен саған қалдырамын.
Dialogue: 0,0:12:59.33,0:13:00.60,JP,,0,0,0,,Кеттік
Dialogue: 0,0:13:01.20,0:13:02.31,JP,,0,0,0,,Сіз әлі кетесіз бе?
Dialogue: 0,0:13:02.44,0:13:05.71,JP,,0,0,0,,Нару енді үйреніп келе жатыр. Нарудың айтқанын істе.
Dialogue: 0,0:13:06.34,0:13:07.91,JP,,0,0,0,,Кел, дала, дала
Dialogue: 0,0:13:08.19,0:13:09.20,JP,,0,0,0,,Айналдыру
Dialogue: 0,0:13:10.71,0:13:13.68,JP,,0,0,0,,Мен ешқашан бейітке барған емеспін.
Dialogue: 0,0:13:14.38,0:13:16.24,JP,,0,0,0,,Мен кім ұйықтап жатқанын білмеймін
Dialogue: 0,0:13:16.61,0:13:18.98,JP,,0,0,0,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:13:20.19,0:13:22.14,JP,,0,0,0,,Мұғалім, ең алдымен тролль жасау керек.
Dialogue: 0,0:13:22.42,0:13:23.21,JP,,0,0,0,,Торо стенді
Dialogue: 0,0:13:23.39,0:13:24.04,JP,,0,0,0,,Қараңыз.
Dialogue: 0,0:13:24.79,0:13:25.61,JP,,0,0,0,,Шам?
Dialogue: 0,0:13:25.76,0:13:26.17,JP,,0,0,0,,Торо
Dialogue: 0,0:13:26.89,0:13:28.81,JP,,0,0,0,,Жарайды, әр үй безендірілген.
Dialogue: 0,0:13:29.69,0:13:32.87,JP,,0,0,0,,Өрт сөнгенше қабірді тастап кетсең жақсы емес.
Dialogue: 0,0:13:32.94,0:13:35.00,JP,,0,0,0,,Бұл екі сағат бойы жанатын шам.
Dialogue: 0,0:13:35.56,0:13:37.37,JP,,0,0,0,,Сіз осында ұзақ жүрсіз бе?
Dialogue: 0,0:13:38.06,0:13:39.52,JP,,0,0,0,,Бос уақытым болса, мынау бар.
Dialogue: 0,0:13:39.87,0:13:41.00,JP,,0,0,0,,Сен де солай істейсің бе?
Dialogue: 0,0:13:41.72,0:13:43.80,JP,,0,0,0,,Келуге рұқсат етемін.
Dialogue: 0,0:13:44.42,0:13:45.27,JP,,0,0,0,,Ясуба
Dialogue: 0,0:13:45.99,0:13:48.19,JP,,0,0,0,,Маған хош иісті таяқшаларды жағуға рұқсат етіңіз
Dialogue: 0,0:13:48.88,0:13:52.16,JP,,0,0,0,,Наруно-ба-чан екеуміз дос болдық.
Dialogue: 0,0:13:57.64,0:14:02.11,JP,,0,0,0,,Мен бұл жылы қалай болса да аман қалдым.
Dialogue: 0,0:14:02.79,0:14:04.11,JP,,0,0,0,,Бірдеңе ауыр.
Dialogue: 0,0:14:04.69,0:14:05.74,JP,,0,0,0,,Иә Оккин
Dialogue: 0,0:14:06.10,0:14:09.06,JP,,0,0,0,,Мұғалімге де оны шешу қиын емес пе?
Dialogue: 0,0:14:09.17,0:14:11.11,JP,,0,0,0,,Жоқ, мен сияқты басқа біреу болды.
Dialogue: 0,0:14:11.58,0:14:13.77,JP,,0,0,0,,Нару әже мазасыз, солай емес пе?
Dialogue: 0,0:14:14.23,0:14:18.84,JP,,0,0,0,,Түн ортасында шыраққа қара
Dialogue: 0,0:14:19.03,0:14:21.25,JP,,0,0,0,,От жоғары-төмен дірілдеп тұр.
Dialogue: 0,0:14:21.67,0:14:22.57,JP,,0,0,0,,Бұл рас
Dialogue: 0,0:14:22.95,0:14:25.86,JP,,0,0,0,,Әженің күлдіргі сөздері
Dialogue: 0,0:14:26.17,0:14:27.86,JP,,0,0,0,,Өзіңізге сенімді болыңыз
Dialogue: 0,0:14:31.16,0:14:34.16,JP,,0,0,0,,Қабір иесі риза болса, бар күшімді саламын.
Dialogue: 0,0:14:34.34,0:14:35.00,JP,,0,0,0,,Ой
Dialogue: 0,0:14:36.91,0:14:37.54,JP,,0,0,0,,Сізде оттық бар ма?
Dialogue: 0,0:14:37.89,0:14:38.73,JP,,0,0,0,,Сәйкес келсе
Dialogue: 0,0:14:40.22,0:14:41.13,JP,,0,0,0,,Тағы да отшашу?
Dialogue: 0,0:14:42.24,0:14:43.11,JP,,0,0,0,,Парашют?
Dialogue: 0,0:14:43.33,0:14:44.08,JP,,0,0,0,,Парашют
Dialogue: 0,0:14:44.59,0:14:46.88,JP,,0,0,0,,Әй, мына жерге құлап жатыр.
Dialogue: 0,0:14:52.53,0:14:55.30,JP,,0,0,0,,Мен жасадым! Әуе аулау.
Dialogue: 0,0:14:55.58,0:14:58.34,JP,,0,0,0,,Мива Чан күткендей, ол басқаларды мазалауды ойламайды.
Dialogue: 0,0:14:58.36,0:14:59.37,JP,,0,0,0,,Қашқын
Dialogue: 0,0:14:59.61,0:15:01.90,JP,,0,0,0,,Жоқ, менің ойымша, юкатамен жүгіру қиын.
Dialogue: 0,0:15:02.06,0:15:03.25,JP,,0,0,0,,Мұны Нарумо жасады ма?
Dialogue: 0,0:15:03.48,0:15:06.29,JP,,0,0,0,,Кешіріңіз, мен парашютпен соңғы рет қолдандым.
Dialogue: 0,0:15:06.49,0:15:07.36,JP,,0,0,0,,Бұл басқа.
Dialogue: 0,0:15:10.41,0:15:12.97,JP,,0,0,0,,Әй, мұғалім, жауап беріңізші.
Dialogue: 0,0:15:13.27,0:15:15.55,JP,,0,0,0,,Оны елемеуге болмайды. Бұл бұзушылық.
Dialogue: 0,0:15:18.29,0:15:19.65,JP,,0,0,0,,Анықтама?
Dialogue: 0,0:15:20.30,0:15:22.80,JP,,0,0,0,,Түсіндім, мен саған көмектесемін.
Dialogue: 0,0:15:22.80,0:15:24.37,JP,,0,0,0,,Маған қарауды доғар, мен қарғысқа ұшыраған сияқтымын
Dialogue: 0,0:15:26.28,0:15:28.40,JP,,0,0,0,,Қаладағы Обоннан басқаша ғой.
Dialogue: 0,0:15:28.66,0:15:32.03,JP,,0,0,0,,Мүлдем емес.Мен бірінші кезекте кешке келмеймін.
Dialogue: 0,0:15:32.40,0:15:33.77,JP,,0,0,0,,Шикі күрішті ұсынбаңыз
Dialogue: 0,0:15:34.24,0:15:35.99,JP,,0,0,0,,Отшашу жоқ немесе юката киюге болмайды
Dialogue: 0,0:15:36.22,0:15:36.98,JP,,0,0,0,,Шамдарды бір қатарға қоюға болмайды
Dialogue: 0,0:15:37.65,0:15:38.28,JP,,0,0,0,,Сенто
Dialogue: 0,0:15:39.11,0:15:41.55,JP,,0,0,0,,Құлпытастағы әріптердің де алтын болуы қызық емес пе?
Dialogue: 0,0:15:41.66,0:15:43.66,JP,,0,0,0,,Өтірік Елдің бәрі алтын.
Dialogue: 0,0:15:43.98,0:15:46.77,JP,,0,0,0,,Мен де бейіттерге сирек барамын.
Dialogue: 0,0:15:47.40,0:15:50.02,JP,,0,0,0,,Мен әдет-ғұрып туралы көп айта алмаймын.
Dialogue: 0,0:15:50.38,0:15:53.83,JP,,0,0,0,,Айтпақшы, бейіт басына тек Обон кезінде ғана келеді.
Dialogue: 0,0:15:54.24,0:15:57.02,JP,,0,0,0,,Олар осында отшашуды көргісі келгендіктен келген сияқты.
Dialogue: 0,0:15:57.58,0:15:59.15,JP,,0,0,0,,Мен сізді кейінірек көруге келдім.
Dialogue: 0,0:15:59.49,0:15:59.99,JP,,0,0,0,,Onde
Dialogue: 0,0:16:00.44,0:16:06.39,JP,,0,0,0,,Кешіріңіз, мен сізді қабірдің алдынан өткізуге рұқсат ете аламын ба?
Dialogue: 0,0:16:06.80,0:16:07.54,JP,,0,0,0,,Жат
Dialogue: 0,0:16:07.80,0:16:09.59,JP,,0,0,0,,Бірінші Bon фестивалінің қабірінде билеу
Dialogue: 0,0:16:09.94,0:16:11.10,JP,,0,0,0,,Бірдеңе қорқынышты.
Dialogue: 0,0:16:27.75,0:16:30.90,JP,,0,0,0,,Жапон тіліне аударғанда бұл нені білдіреді?
Dialogue: 0,0:16:31.25,0:16:33.53,JP,,0,0,0,,Шетел тілі емес
Dialogue: 0,0:16:44.67,0:16:46.21,JP,,0,0,0,,Не? Неліктен тоқтайды?
Dialogue: 0,0:16:47.14,0:16:48.76,JP,,0,0,0,,Ал сен маған қарамайсың ба?
Dialogue: 0,0:16:49.58,0:16:50.57,JP,,0,0,0,,Мен оны бәрібір көріп тұрмын
Dialogue: 0,0:16:50.72,0:16:52.42,JP,,0,0,0,,Мен бірдеңені дұрыс істемедім бе?
Dialogue: 0,0:16:55.69,0:16:57.23,JP,,0,0,0,,Бұл қандай бет?
Dialogue: 0,0:16:57.76,0:16:58.88,JP,,0,0,0,,Мұғалім тым қорқады
Dialogue: 0,0:16:58.91,0:17:01.68,JP,,0,0,0,,Хиро, сіз де корпустың мүшесі болдыңыз ба?
Dialogue: 0,0:17:02.06,0:17:04.19,JP,,0,0,0,,Бізде жұмыс күші жетіспейді, сондықтан маған көмек керек.
Dialogue: 0,0:17:04.33,0:17:07.12,JP,,0,0,0,,Хиро-сенпай, тез көшейік.
Dialogue: 0,0:17:07.47,0:17:09.41,JP,,0,0,0,,Менің аяғым ауырып, өлемін
Dialogue: 0,0:17:09.60,0:17:11.54,JP,,0,0,0,,Гибареге бару үшін үш үй
Dialogue: 0,0:17:12.40,0:17:14.47,JP,,0,0,0,,Ал, сенсе, әлі билеме.
Dialogue: 0,0:17:14.92,0:17:16.47,JP,,0,0,0,,Иә, бар күшіңізді салыңыз.
Dialogue: 0,0:17:21.39,0:17:22.63,JP,,0,0,0,,Менің артымнан ерме
Dialogue: 0,0:17:22.78,0:17:23.97,JP,,0,0,0,,Неге жасырып жатырсың?
Dialogue: 0,0:17:24.28,0:17:25.97,JP,,0,0,0,,Мен сенің қалай билейтініңді көргім келеді
Dialogue: 0,0:17:27.38,0:17:29.99,JP,,0,0,0,,Мұғалім бірте-бірте сізге үйреніп бара жатыр емес пе?
Dialogue: 0,0:17:30.38,0:17:32.20,JP,,0,0,0,,Толығымен Нарудың қамқоршы алақаны
Dialogue: 0,0:17:33.31,0:17:35.55,JP,,0,0,0,,Мен бұл туралы көп ойламауға тырыстым.
Dialogue: 0,0:17:35.98,0:17:40.33,JP,,0,0,0,,Сенсэй аралға ұлы каллиграфты ұрып-соғу үшін келді, солай ма?
Dialogue: 0,0:17:40.96,0:17:42.69,JP,,0,0,0,,Егер жаза кешірілсе
Dialogue: 0,0:17:43.04,0:17:43.60,JP,,0,0,0,,Тама
Dialogue: 0,0:17:46.25,0:17:48.11,JP,,0,0,0,,Жазғы демалыстағы үй тапсырмасы аяқталды
Dialogue: 0,0:17:48.80,0:17:50.32,JP,,0,0,0,,Жақсы, белгілі бір дәрежеде
Dialogue: 0,0:17:50.46,0:17:51.70,JP,,0,0,0,,Маған суретке түсуге рұқсат етпе
Dialogue: 0,0:17:51.73,0:17:52.49,JP,,0,0,0,,Мива-чан
Dialogue: 0,0:17:56.30,0:17:58.90,JP,,0,0,0,,Кеш болды, мұғалім.
Dialogue: 0,0:17:59.04,0:18:00.74,JP,,0,0,0,,Отшашулар Отшашу
Dialogue: 0,0:18:04.00,0:18:04.76,JP,,0,0,0,,Түтін
Dialogue: 0,0:18:05.08,0:18:06.21,JP,,0,0,0,,Сәлем, сэр.
Dialogue: 0,0:18:07.28,0:18:09.09,JP,,0,0,0,,Мен хош иісті зат түте аламын ба?
Dialogue: 0,0:18:09.27,0:18:09.92,JP,,0,0,0,,Әкім
Dialogue: 0,0:18:10.24,0:18:13.26,JP,,0,0,0,,Мені Нару әжем тірі кезінде қамқорлыққа алды.
Dialogue: 0,0:18:15.51,0:18:16.42,JP,,0,0,0,,Киношита Шотен
Dialogue: 0,0:18:16.54,0:18:18.62,JP,,0,0,0,,Хош иісті таяқша
Dialogue: 0,0:18:19.01,0:18:20.00,JP,,0,0,0,,Өтінемін, өтінемін.
Dialogue: 0,0:18:22.17,0:18:23.85,JP,,0,0,0,,Мива осында
Dialogue: 0,0:18:23.91,0:18:26.88,JP,,0,0,0,,Рұқсатсыз бейіттерді босатып ойнаудың не керегі бар?
Dialogue: 0,0:18:27.23,0:18:27.98,JP,,0,0,0,,Әке
Dialogue: 0,0:18:28.44,0:18:30.86,JP,,0,0,0,,Мұғалім мені осында келуге мәжбүр етті.
Dialogue: 0,0:18:30.92,0:18:32.15,JP,,0,0,0,,Идиот, маған ұнамайды.
Dialogue: 0,0:18:32.44,0:18:34.15,JP,,0,0,0,,Әпке, не істеп жатырсыз?
Dialogue: 0,0:18:34.60,0:18:36.32,JP,,0,0,0,,Анам мені іздеді.
Dialogue: 0,0:18:36.55,0:18:39.00,JP,,0,0,0,,Аки Мен бұл мәселені жақсы түсінемін.
Dialogue: 0,0:18:39.06,0:18:42.59,JP,,0,0,0,,Анам Нару әжеден хош иісті заттарды әкелуін өтінді.
Dialogue: 0,0:18:43.17,0:18:44.75,JP,,0,0,0,,Биыл да хош иісті заттарды жағуға болады.
Dialogue: 0,0:18:44.91,0:18:46.14,JP,,0,0,0,,(Серо) Тіпті бастауыш сынып оқушысы кенеттен «Қорықпа!» деп айқайлады.
Dialogue: 0,0:18:49.21,0:18:51.85,JP,,0,0,0,,Нару-но-ба-сан – танымал адам.
Dialogue: 0,0:18:52.34,0:18:55.68,JP,,0,0,0,,Иә, жыл сайын біреу келеді.
Dialogue: 0,0:18:56.24,0:18:57.85,JP,,0,0,0,,Өйткені атам бос емес
Dialogue: 0,0:18:58.02,0:19:00.96,JP,,0,0,0,,Осы уақытқа дейін Нару жалғыз өзі от жағумен болды.
Dialogue: 0,0:19:03.35,0:19:06.02,JP,,0,0,0,,Ойлап қарасам, мен Нарудың ата-анасын бұрын көрмегенмін.
Dialogue: 0,0:19:06.85,0:19:08.20,JP,,0,0,0,,Мұғалім тінтуірінің отшашуы
Dialogue: 0,0:19:09.15,0:19:09.67,JP,,0,0,0,,Мұнда
Dialogue: 0,0:19:11.29,0:19:13.60,JP,,0,0,0,,Бүгін әдеттегіден көбірек көңілді болдыңыз ба?
Dialogue: 0,0:19:13.60,0:19:14.91,JP,,0,0,0,,Ақымақ болма, әлгі жігіт.
Dialogue: 0,0:19:15.89,0:19:19.18,JP,,0,0,0,,Атам қайтып келгенше мен үнемі жалықтым.
Dialogue: 0,0:19:19.47,0:19:21.18,JP,,0,0,0,,Мен бүгін үйге қайтып бара жатқандай сезінемін.
Dialogue: 0,0:19:21.22,0:19:22.42,JP,,0,0,0,,Қабірде бол
Dialogue: 0,0:19:22.98,0:19:24.21,JP,,0,0,0,,Бұл олай емес.
Dialogue: 0,0:19:24.66,0:19:26.53,JP,,0,0,0,,Оқытушы үлкен адам болуы керек.
Dialogue: 0,0:19:28.90,0:19:30.73,JP,,0,0,0,,Нарумо мұны жасайды
Dialogue: 0,0:19:31.98,0:19:34.44,JP,,0,0,0,,Мен үнемі біреумен жүргендіктен байқамадым.
Dialogue: 0,0:19:35.68,0:19:37.96,JP,,0,0,0,,Мен өзімді көпшілік сияқты жалғыз сезінемін.
Dialogue: 0,0:19:39.60,0:19:42.90,JP,,0,0,0,,Мен оны бәрібір жалғыз қалдырсам, ол өздігінен өседі деп ойлаймын.
Dialogue: 0,0:19:45.33,0:19:48.13,JP,,0,0,0,,Қолым бос болғанша мен саған қамқор боламын.
Dialogue: 0,0:19:53.67,0:19:55.09,JP,,0,0,0,,Өрт сөнді
Dialogue: 0,0:19:55.64,0:19:58.84,JP,,0,0,0,,Үйге баратын уақыт болды ма? Бүгін ерте.
Dialogue: 0,0:20:00.33,0:20:01.55,JP,,0,0,0,,Енді үйге қайтайық
Dialogue: 0,0:20:01.88,0:20:04.24,JP,,0,0,0,,Өйткені қарт әлі оралған жоқ.
Dialogue: 0,0:20:06.34,0:20:06.99,JP,,0,0,0,,Кеңейтім
Dialogue: 0,0:20:08.13,0:20:10.23,JP,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:20:08.92,0:20:10.73,JP,,0,0,0,,Мұғалім мейірімді
Dialogue: 0,0:20:10.86,0:20:11.45,JP,,0,0,0,,Шулы
Dialogue: 0,0:20:11.60,0:20:14.43,JP,,0,0,0,,Әже, Нару әлі жақын.
Dialogue: 0,0:20:14.82,0:20:16.30,JP,,0,0,0,,Сіз соншалықты бақыттысыз ба?
Dialogue: 0,0:20:17.11,0:20:18.61,JP,,0,0,0,,Мұғалім, қара, қара.
Dialogue: 0,0:20:19.45,0:20:21.02,JP,,0,0,0,,Әже де сәл күледі
Dialogue: 0,0:21:55.37,0:21:56.53,JP,,0,0,0,,Сәлем, сэр.
Dialogue: 0,0:21:56.96,0:21:59.81,JP,,0,0,0,,Пети-сан, кешкі асқа балық аулауға келдің бе?
Dialogue: 0,0:22:01.04,0:22:02.89,JP,,0,0,0,,Иттер шаян жемейді
Dialogue: 0,0:22:04.50,0:22:06.47,JP,,0,0,0,,Данбода балық аулаған фигура
Dialogue: 0,0:22:06.58,0:22:08.11,JP,,0,0,0,,Меніңше, бұл ұқсай бастады
Dialogue: 0,0:22:08.46,0:22:10.28,JP,,0,0,0,,Әлі жоқ
Dialogue: 0,0:22:10.40,0:22:13.32,JP,,0,0,0,,Ауылдағылар да мұғалімді ұнататын сияқты.
Dialogue: 0,0:22:13.97,0:22:15.80,JP,,0,0,0,,Мен осында мәңгі қалсам ше?
Dialogue: 0,0:22:15.99,0:22:18.02,JP,,0,0,0,,Әрине, сіз мұны істей алмайсыз.
Dialogue: 0,0:22:19.59,0:22:20.43,JP,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:22:20.87,0:22:23.77,JP,,0,0,0,,Жарайды, мені қабылдайтын жер болса
Dialogue: 0,0:22:24.35,0:22:26.27,JP,,0,0,0,,Сіз жан тыныштығымен ойланбайтын нәрселерді жасай аласыз.
Dialogue: 0,0:22:28.27,0:22:29.08,JP,,0,0,0,,Petit-san
Dialogue: 0,0:22:30.16,0:22:31.74,JP,,0,0,0,,Үлкен каллиграф болған кезде не болады?
Dialogue: 0,0:22:32.00,0:22:33.78,JP,,0,0,0,,Маған омар сыйлаңыз.
Dialogue: 0,0:22:35.31,0:22:37.11,JP,,0,0,0,,Ақыр соңында, сен оны жейсің, солай ма?
Dialogue: 0,0:22:37.64,0:22:39.59,JP,,0,0,0,,Дүкен менеджеріне айтпаңыз.
Dialogue: 0,0:22:41.59,0:22:43.04,JP,,0,0,0,,Мен түс көрдім.
Dialogue: 0,0:22:43.79,0:22:45.45,JP,,0,0,0,,Бұл арман болды, бірақ мен бақытты болдым.
Dialogue: 0,0:22:47.76,0:22:49.01,JP,,0,0,0,,Пети - әйел.
Dialogue: 0,0:22:49.01,0:22:49.40,JP,,0,0,0,,Иә?
Dialogue: 0,0:22:50.90,0:22:56.90,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
