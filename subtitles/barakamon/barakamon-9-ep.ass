Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.05,0:00:11.08,Default,,0,0,0,,Екі аптадан кейін
Dialogue: 0,0:00:12.07,0:00:15.07,Default,,0,0,0,,Неғұрлым асықсаң, соғұрлым қолжазбаның жақсылығы азаяды.
Dialogue: 0,0:00:17.00,0:00:22.02,Default,,0,0,0,,Аралға келген соң жазғым келетін кездер болады.
Dialogue: 0,0:00:23.00,0:00:25.08,Default,,0,0,0,,Бірдеңе шығып, қолым дірілдеп кетті.
Dialogue: 0,0:00:27.01,0:00:30.03,Default,,0,0,0,,Қолдарыңыз дірілдеп тұрғанын сезсеңіз
Dialogue: 0,0:00:33.07,0:00:35.07,Default,,0,0,0,,Ваннаға түсу көңіл-күйді өзгерте ме?
Dialogue: 0,0:00:40.03,0:00:42.08,Default,,0,0,0,,Ол шертпейді.
Dialogue: 0,0:00:50.09,0:00:52.00,Default,,0,0,0,,Жанбайды
Dialogue: 0,0:00:52.03,0:00:53.05,Default,,0,0,0,,Бұлай болмауы керек.
Dialogue: 0,0:00:55.01,0:00:57.05,Default,,0,0,0,,Неліктен бұл өтірік?
Dialogue: 0,0:01:06.03,0:01:08.06,Default,,0,0,0,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:01:09.03,0:01:11.08,Default,,0,0,0,,«Басқалардан ерекшелену» арқылы өзіңізді ерекшелендіріңіз
Dialogue: 0,0:01:12.01,0:01:14.03,Default,,0,0,0,,Дүкен журналының бұрышы
Dialogue: 0,0:01:14.08,0:01:17.07,Default,,0,0,0,,Мұқабаға кездейсоқ жазылған.
Dialogue: 0,0:01:17.08,0:01:20.00,Default,,0,0,0,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:01:20.05,0:01:23.01,Default,,0,0,0,,Бала кезімде мән бермедім.
Dialogue: 0,0:01:23.06,0:01:26.00,Default,,0,0,0,,Ұнамаса, ашулан.
Dialogue: 0,0:01:26.01,0:01:28.09,Default,,0,0,0,,Сізге ұнайтын нәрсені айтыңыз
Dialogue: 0,0:01:29.00,0:01:32.01,Default,,0,0,0,,Біз өзгереміз
Dialogue: 0,0:01:32.01,0:01:35.00,Default,,0,0,0,,Біз нені қорғағымыз келетін өзгерістер
Dialogue: 0,0:01:35.00,0:01:37.07,Default,,0,0,0,,Түсінбеген қазынадан
Dialogue: 0,0:01:37.08,0:01:40.05,Default,,0,0,0,,Түсіну керек
Dialogue: 0,0:01:40.05,0:01:46.00,Default,,0,0,0,,Өскен сайын өкінесің.
Dialogue: 0,0:01:46.00,0:01:48.06,Default,,0,0,0,,Бірақ бәрібір.
Dialogue: 0,0:01:49.00,0:01:53.00,Default,,0,0,0,,Сіз бір нәрсе көре аласыз
Dialogue: 0,0:01:54.06,0:02:00.00,Default,,0,0,0,,Сондықтан мен өзім сияқтымын, ал сен өзің сияқтысың
Dialogue: 0,0:02:00.00,0:02:06.00,Default,,0,0,0,,Менің ойымша, бұл басынан бастап іздейтін нәрсе емес.
Dialogue: 0,0:02:06.00,0:02:11.03,Default,,0,0,0,,Мен сен емеспін, сен мен емессің
Dialogue: 0,0:02:11.03,0:02:14.02,Default,,0,0,0,,Бір-бірінен өту, қол ұстасу
Dialogue: 0,0:02:14.02,0:02:18.08,Default,,0,0,0,,Махаббаттың туатын жері.
Dialogue: 0,0:02:20.00,0:02:22.07,Default,,0,0,0,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:02:22.07,0:02:28.08,Default,,0,0,0,,Мен оны өзгерте алмаймын, себебі бұл маңызды
Dialogue: 0,0:02:29.02,0:02:32.06,Default,,0,0,0,,Өзгеретін өмір дұрыс
Dialogue: 0,0:02:40.05,0:02:41.08,Default,,0,0,0,,Ол сынған.
Dialogue: 0,0:02:41.09,0:02:44.06,Default,,0,0,0,,Жөндеуге келуге қанша уақыт кетеді?
Dialogue: 0,0:02:45.01,0:02:48.01,Default,,0,0,0,,Иә, шамамен бір аптадан кейін.
Dialogue: 0,0:02:48.01,0:02:49.00,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:02:49.07,0:02:52.09,Default,,0,0,0,,Дұрыс, дәл осы уақытта мен кірісемін.
Dialogue: 0,0:02:55.02,0:02:57.02,Default,,0,0,0,,Ваннаға арналған шайнек
Dialogue: 0,0:02:57.08,0:03:00.07,Default,,0,0,0,,Бұл жерде ағаш жағатын болсаңыз, ваннаны қайнатуға болады.
Dialogue: 0,0:03:01.00,0:03:02.08,Default,,0,0,0,,Мен мұны пайдалана аламын ба?
Dialogue: 0,0:03:03.00,0:03:06.05,Default,,0,0,0,,Жарайды. Бізде ағаш жағатын ванна да бар, бұл өте жақсы.
Dialogue: 0,0:03:07.08,0:03:11.06,Default,,0,0,0,,Жоқ, бірақ, бірақ, отын ше? Менде ол жоқ.
Dialogue: 0,0:03:11.09,0:03:15.05,Default,,0,0,0,,Менің үйімнің алдында тау бар, сондықтан бәрі болады.
Dialogue: 0,0:03:20.02,0:03:22.09,Default,,0,0,0,,Тек құрғақ бұтақтар күйеді.
Dialogue: 0,0:03:24.07,0:03:27.06,Default,,0,0,0,,Жоқ, мотивация қосқышы әлдеқашан қосылған.
Dialogue: 0,0:03:27.08,0:03:29.07,Default,,0,0,0,,Мазалайды деп айта алмаймын.
Dialogue: 0,0:03:29.07,0:03:30.09,Default,,0,0,0,,Мына жерде де біреуі бар.
Dialogue: 0,0:03:33.03,0:03:35.04,Default,,0,0,0,,Бұл бір апта бойы жалғаса ма?
Dialogue: 0,0:03:38.03,0:03:39.01,Default,,0,0,0,,Бұл жиіркенішті
Dialogue: 0,0:03:41.04,0:03:42.00,Default,,0,0,0,,Сен
Dialogue: 0,0:03:43.00,0:03:44.05,Default,,0,0,0,,Кешіріңіз, әкім.
Dialogue: 0,0:03:46.06,0:03:48.05,Default,,0,0,0,,Бұл тармақтар үшін жеткілікті.
Dialogue: 0,0:03:49.04,0:03:52.05,Default,,0,0,0,,Мұғалім оған тамақ дайындайтын әйел табады деп үміттенемін.
Dialogue: 0,0:03:53.00,0:03:56.03,Default,,0,0,0,,Әйелім газды су жылытқышы бар ваннаны қалайды.
Dialogue: 0,0:03:57.03,0:04:02.00,Default,,0,0,0,,Мұғалім де 23 жаста, тұрмысқа шығуды ойлайтын қызы жоқ.
Dialogue: 0,0:04:02.03,0:04:04.01,Default,,0,0,0,,Жоқ, ондай нәрсе жоқ.
Dialogue: 0,0:04:04.03,0:04:05.02,Default,,0,0,0,,Қазірше сау бол,
Dialogue: 0,0:04:05.09,0:04:07.08,Default,,0,0,0,,Мен үнемі хат жазатынмын.
Dialogue: 0,0:04:08.00,0:04:09.02,Default,,0,0,0,,Оны қалай айтасыз?
Dialogue: 0,0:04:09.08,0:04:12.02,Default,,0,0,0,,Мен жалғыз өлетін адаммын.
Dialogue: 0,0:04:14.05,0:04:16.02,Default,,0,0,0,,Бұл адамды жоққа шығармаңыз.
Dialogue: 0,0:04:17.02,0:04:18.09,Default,,0,0,0,,Олай болса, бәрі жақсы деп ойлаймын.
Dialogue: 0,0:04:20.07,0:04:22.00,Default,,0,0,0,,Мива-чан
Dialogue: 0,0:04:21.02,0:04:26.02,Default,,0,0,0,,Жапония: Маруко Аудармасы: Топо және Ариаке но Цуки Түпнұсқа: Кодзиро және Люцифер Уақыты: Бұрмалау Кейінірек: Нака
Dialogue: 0,0:04:23.01,0:04:26.04,Default,,0,0,0,,Бұл түтін мұғалімнің үйі емес.
Dialogue: 0,0:04:26.06,0:04:27.07,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:04:27.08,0:04:29.01,Default,,0,0,0,,Мүмкін алау
Dialogue: 0,0:04:29.02,0:04:31.05,Default,,0,0,0,,Соганкото Сенсей га Сукка
Dialogue: 0,0:04:33.09,0:04:34.09,Default,,0,0,0,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,0:04:35.02,0:04:37.04,Default,,0,0,0,,Бұл өрт.
Dialogue: 0,0:04:37.07,0:04:38.04,Default,,0,0,0,,It's a bath.
Dialogue: 0,0:04:38.05,0:04:42.00,Default,,0,0,0,,Не? You're an alarmist, sir.
Dialogue: 0,0:04:42.03,0:04:45.04,Default,,0,0,0,,Бірақ шомылу қауіпсіз.
Dialogue: 0,0:04:45.06,0:04:47.03,Default,,0,0,0,,Can you do this?
Dialogue: 0,0:04:47.05,0:04:47.55,Default,,0,0,0,,Иә
Dialogue: 0,0:04:48.06,0:04:50.01,Default,,0,0,0,,Дәл әже кіріп келе жатқанда
Dialogue: 0,0:04:50.02,0:04:51.08,Default,,0,0,0,,Әрқашан отты бақылаңыз
Dialogue: 0,0:04:52.03,0:04:54.08,Default,,0,0,0,,Менің ойымша, бұл шынымен де жақсы.
Dialogue: 0,0:04:55.02,0:04:57.00,Default,,0,0,0,,Маған қалдыр, үйреніп ал.
Dialogue: 0,0:04:58.09,0:05:00.04,Default,,0,0,0,,Дайындық қиын, бірақ
Dialogue: 0,0:05:00.06,0:05:03.05,Default,,0,0,0,,Ыстық бұлақ алғандай, толқыдым.
Dialogue: 0,0:05:05.02,0:05:05.52,Default,,0,0,0,,Олардың мен адамзаттың күш арасындағы алшақтық аса үлкен еді,
Dialogue: 0,0:05:06.09,0:05:08.03,Default,,0,0,0,,Мұғалім, күн ыстық болды.
Dialogue: 0,0:05:08.04,0:05:10.01,Default,,0,0,0,,Тұр... мен қайдамын?
Dialogue: 0,0:05:11.07,0:05:13.02,Default,,0,0,0,,Жақсы
Dialogue: 0,0:05:15.00,0:05:16.01,Default,,0,0,0,,Come back to life
Dialogue: 0,0:05:17.05,0:05:21.08,Default,,0,0,0,,Сүйегіңе сіңіп кетпесін. Қала басшысының бұған неге құмар болатынын түсінемін.
Dialogue: 0,0:05:22.01,0:05:23.07,Default,,0,0,0,,Оны қайнату үшін көп күш жұмсалды.
Dialogue: 0,0:05:24.08,0:05:26.02,Default,,0,0,0,,Мұғалім, қиын екен.
Dialogue: 0,0:05:26.04,0:05:27.01,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:32.00,0:05:34.09,Default,,0,0,0,,Жарайды, бұл балалар мұнда не үшін?
Dialogue: 0,0:05:35.09,0:05:37.04,Default,,0,0,0,,Мен өрт туралы ойладым.
Dialogue: 0,0:05:37.08,0:05:40.05,Default,,0,0,0,,Балаңызға отты қарауға және демалатын ванна қабылдауға мүмкіндік беріңіз.
Dialogue: 0,0:05:40.05,0:05:42.02,Default,,0,0,0,,Жалаңашты жаза ретінде көру
Dialogue: 0,0:05:42.02,0:05:43.01,Default,,0,0,0,,Мен логиканы түсінбеймін.
Dialogue: 0,0:05:43.04,0:05:46.03,Default,,0,0,0,,Менің ойымша, оны шынымен жас қыз көрген.
Dialogue: 0,0:05:46.07,0:05:49.00,Default,,0,0,0,,Адамдарды эксгибиционист деп атамаңыз.
Dialogue: 0,0:05:49.01,0:05:50.03,Default,,0,0,0,,Бұл өрт емес, тез үйге қайт.
Dialogue: 0,0:05:51.08,0:05:53.09,Default,,0,0,0,,Рин бұрынғыдай зұлым ба?
Dialogue: 0,0:05:55.09,0:05:57.00,Default,,0,0,0,,The camera is
Dialogue: 0,0:05:57.01,0:05:59.04,Default,,0,0,0,,Мен оны мангаға материал ретінде пайдалануды ойладым.
Dialogue: 0,0:05:59.08,0:06:03.03,Default,,0,0,0,,Материалдар Манга қаншалықты көп болса да, толық жалаңаштау жақсы емес.
Dialogue: 0,0:06:03.07,0:06:04.09,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:06:05.00,0:06:06.08,Default,,0,0,0,,Алдымен мозаика қоссаңыз
Dialogue: 0,0:06:07.02,0:06:08.09,Default,,0,0,0,,I can't relax
Dialogue: 0,0:06:09.05,0:06:11.05,Default,,0,0,0,,Өйткені, күндіз шомылу жақсы емес.
Dialogue: 0,0:06:12.00,0:06:16.05,Default,,0,0,0,,Әзірше олар жалықтырып, үйге кеткенше күтемін.
Dialogue: 0,0:06:16.09,0:06:19.00,Default,,0,0,0,,Ыстық, боке
Dialogue: 0,0:06:19.01,0:06:20.02,Default,,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:06:21.04,0:06:22.06,Default,,0,0,0,,Мұғалім, күн ыстық болды.
Dialogue: 0,0:06:23.00,0:06:25.03,Default,,0,0,0,,Менің ойымша, бұл шешілді. Look at this red color.
Dialogue: 0,0:06:25.03,0:06:26.01,Default,,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:06:26.01,0:06:27.09,Default,,0,0,0,,Жоқ, сіз қашпайсыз.
Dialogue: 0,0:06:32.04,0:06:34.06,Default,,0,0,0,,Әйтеуір, көңіл-күйіңізді сергітіңіз
Dialogue: 0,0:06:35.02,0:06:36.06,Default,,0,0,0,,I'll write it.
Dialogue: 0,0:06:38.01,0:06:40.03,Default,,0,0,0,,Хиро, сен не істеп жатырсың?
Dialogue: 0,0:06:40.08,0:06:43.09,Default,,0,0,0,,Анам бүгін үйде емес, мен түскі ас әзірлеймін.
Dialogue: 0,0:06:44.06,0:06:46.01,Default,,0,0,0,,Неге менің үйімде?
Dialogue: 0,0:06:47.09,0:06:49.04,Default,,0,0,0,,Алдымен қиярды кесіңіз
Dialogue: 0,0:06:50.01,0:06:53.00,Default,,0,0,0,,Мисо мен қантты көздің мөлшері бойынша қосыңыз.
Dialogue: 0,0:06:53.06,0:06:55.00,Default,,0,0,0,,Бұрынғы қиярды қосыңыз.
Dialogue: 0,0:06:55.01,0:06:56.00,Default,,0,0,0,,Шамамен араластырыңыз
Dialogue: 0,0:06:56.07,0:06:59.06,Default,,0,0,0,,Осы қарапайым қадамдар арқылы мизо пісірілген қиярды аяқтаңыз
Dialogue: 0,0:07:01.00,0:07:03.00,Default,,0,0,0,,Мен мұны да жасай алатын сияқтымын.
Dialogue: 0,0:07:03.08,0:07:05.03,Default,,0,0,0,,Алдымен қиярды кесіңіз
Dialogue: 0,0:07:05.07,0:07:07.04,Default,,0,0,0,,Мисо мен қантты қосып, араластырыңыз.
Dialogue: 0,0:07:08.01,0:07:10.06,Default,,0,0,0,,Аяқталды Мұғалім, мен мысалға қарап отырдым.
Dialogue: 0,0:07:11.00,0:07:12.02,Default,,0,0,0,,Не? Дәл солай, солай ма?
Dialogue: 0,0:07:12.02,0:07:13.00,Default,,0,0,0,,Бір жерде
Dialogue: 0,0:07:14.00,0:07:15.07,Default,,0,0,0,,Жесең де солай.
Dialogue: 0,0:07:15.09,0:07:19.03,Default,,0,0,0,,Менің ойымша, ерлердің тағамы нашар көрінеді, бірақ дәмі жақсы.
Dialogue: 0,0:07:19.04,0:07:22.05,Default,,0,0,0,,Жоқ, бұл сөзсіз дәмсіз.
Dialogue: 0,0:07:23.03,0:07:24.07,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:07:27.01,0:07:29.02,Default,,0,0,0,,Ой, бұл қаншалықты жақсы?
Dialogue: 0,0:07:29.04,0:07:31.01,Default,,0,0,0,,Мұғалімдікі нашар.
Dialogue: 0,0:07:31.03,0:07:33.07,Default,,0,0,0,,Неліктен тек қиярдың дәмі бар?
Dialogue: 0,0:07:35.06,0:07:37.01,Default,,0,0,0,,Бұл өте жаман.
Dialogue: 0,0:07:37.03,0:07:40.00,Default,,0,0,0,,Күте тұрыңыз, сіз жаңа ғана дәмді дедіңіз.
Dialogue: 0,0:07:40.02,0:07:43.04,Default,,0,0,0,,Мен мұны жақсы деп ешқашан айтқан емеспін. Оның дәмі тек мисо сияқты.
Dialogue: 0,0:07:43.04,0:07:45.08,Default,,0,0,0,,Сен неге сонша қыңырсың? Бұл өте танымал емес.
Dialogue: 0,0:07:46.05,0:07:48.08,Default,,0,0,0,,Бұл өте танымал емес дегенді қалай түсінесіз?
Dialogue: 0,0:07:48.08,0:07:52.05,Default,,0,0,0,,Саусақтарыңызды көрсетпеңіз. Егер сіз үлкен болсаңыз, қартайыңыз және жеңілісіңізді мойындаңыз.
Dialogue: 0,0:07:56.07,0:07:58.00,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:08:00.03,0:08:01.02,Default,,0,0,0,,Хина не болды?
Dialogue: 0,0:08:01.04,0:08:02.07,Default,,0,0,0,,Колизейдің кіреберісі ғой?
Dialogue: 0,0:08:04.00,0:08:06.04,Default,,0,0,0,,Айқайласаң да түсінбейсің. Мықты болыңыз.
Dialogue: 0,0:08:06.04,0:08:07.06,Default,,0,0,0,,Асыққан мұғалім
Dialogue: 0,0:08:08.01,0:08:10.00,Default,,0,0,0,,Хина, мынаны ішіп, тыныштал.
Dialogue: 0,0:08:11.00,0:08:14.05,Default,,0,0,0,,Сіз өте асығыс жүгіресіз. Апаттық жағдай Тез айт.
Dialogue: 0,0:08:15.00,0:08:17.06,Default,,0,0,0,,Шұғыл болғаны сонша, асығыспын.
Dialogue: 0,0:08:17.07,0:08:19.01,Default,,0,0,0,,Себебі сен қызықсың.
Dialogue: 0,0:08:19.01,0:08:21.06,Default,,0,0,0,,Мұндай орындар онша танымал емес.
Dialogue: 0,0:08:23.05,0:08:25.03,Default,,0,0,0,,Жарайды, Хина, сабыр ет.
Dialogue: 0,0:08:25.03,0:08:26.09,Default,,0,0,0,,Мен мұқият тыңдаймын.
Dialogue: 0,0:08:27.00,0:08:32.09,Default,,0,0,0,,Нару, Наруды көрші ауылдың жоғары сынып оқушылары қорлап жатыр.
Dialogue: 0,0:08:36.09,0:08:37.09,Default,,0,0,0,,Міне осылай
Dialogue: 0,0:08:39.00,0:08:40.04,Default,,0,0,0,,Нару жақсысың ба?
Dialogue: 0,0:08:41.05,0:08:43.08,Default,,0,0,0,,Тоқта
Dialogue: 0,0:08:46.00,0:08:49.02,Default,,0,0,0,,Не, өте қызық сияқты.
Dialogue: 0,0:08:49.04,0:08:50.06,Default,,0,0,0,,Болу
Dialogue: 0,0:08:50.07,0:08:52.07,Default,,0,0,0,,Хина маған көмектес
Dialogue: 0,0:08:53.03,0:08:55.03,Default,,0,0,0,,Сіздің қорқақ екеніңіз сонша, өзіңізбен бірге үлкен адамды алып келу керек.
Dialogue: 0,0:08:55.09,0:08:57.04,Default,,0,0,0,,Сіз қандай баласыз?
Dialogue: 0,0:08:57.07,0:08:59.06,Default,,0,0,0,,Бұл олардың ойын алаңы.
Dialogue: 0,0:09:00.00,0:09:01.06,Default,,0,0,0,,Сен жынды түлкі
Dialogue: 0,0:09:01.09,0:09:03.05,Default,,0,0,0,,Біз жай ғана жұмыс істедік
Dialogue: 0,0:09:04.01,0:09:05.02,Default,,0,0,0,,Түлкі жігіт
Dialogue: 0,0:09:05.04,0:09:07.06,Default,,0,0,0,,Ол Рокуносаки-годан шыққан бала.
Dialogue: 0,0:09:07.09,0:09:10.06,Default,,0,0,0,,Біздің ұрпақтан бастап көрші ауылмен жақсы араласпаймыз.
Dialogue: 0,0:09:11.01,0:09:15.06,Default,,0,0,0,,Мұғалім, оларды жайына қалдырыңыз! Қыздар бірінші болып ойнады.
Dialogue: 0,0:09:16.01,0:09:17.02,Default,,0,0,0,,О
Dialogue: 0,0:09:17.08,0:09:19.06,Default,,0,0,0,,Әй, көрші ауылдың балалары.
Dialogue: 0,0:09:20.06,0:09:23.03,Default,,0,0,0,,Біреумен алғаш кездескенде түлкіні қалай атайсың?
Dialogue: 0,0:09:23.09,0:09:24.08,Default,,0,0,0,,Түлкі қайда?
Dialogue: 0,0:09:24.08,0:09:28.00,Default,,0,0,0,,Менің көзім нашар деп кейде айтатыны рас, бірақ кейде.
Dialogue: 0,0:09:28.05,0:09:31.02,Default,,0,0,0,,Мұғалім, бұл жеке реніш.
Dialogue: 0,0:09:31.05,0:09:34.01,Default,,0,0,0,,Шулы бұршақ өскіндері кетеді
Dialogue: 0,0:09:35.06,0:09:38.09,Default,,0,0,0,,Ауырады. Мен бұл не деп ойлаймын. Менің жүрегім ауырады.
Dialogue: 0,0:09:39.05,0:09:41.01,Default,,0,0,0,,Бұл бала керемет.
Dialogue: 0,0:09:41.05,0:09:45.00,Default,,0,0,0,,Бірінші рет кездессек те мұғалімнің жаман адам екенін айта аламын.
Dialogue: 0,0:09:45.00,0:09:45.50,Default,,0,0,0,,На
Dialogue: 0,0:09:46.00,0:09:49.02,Default,,0,0,0,,Бұндай бәйбішелерге қатты ештеңе айта алмайсың.
Dialogue: 0,0:09:49.07,0:09:50.06,Default,,0,0,0,,Келесі шайқас!
Dialogue: 0,0:09:50.07,0:09:51.05,Default,,0,0,0,,Сары шаш
Dialogue: 0,0:09:51.06,0:09:52.05,Default,,0,0,0,,Аққұба
Dialogue: 0,0:09:52.07,0:09:54.02,Default,,0,0,0,,Сіз мені бір нәрсемен қорқытқыңыз келе ме?
Dialogue: 0,0:09:54.08,0:09:58.03,Default,,0,0,0,,Сіз жоғары сынып оқушысысыз, оны әлсіз балаларға бермеңіз.
Dialogue: 0,0:09:58.06,0:09:59.09,Default,,0,0,0,,...
Dialogue: 0,0:10:01.02,0:10:02.08,Default,,0,0,0,,Олай десеңіз,
Dialogue: 0,0:10:04.02,0:10:05.07,Default,,0,0,0,,Догеза
Dialogue: 0,0:10:08.00,0:10:09.08,Default,,0,0,0,,Тоқта, Хиро тыныштандыр.
Dialogue: 0,0:10:09.09,0:10:12.08,Default,,0,0,0,,Мені жіберші, мен саған дүниенің қаталдығын көрсетемін.
Dialogue: 0,0:10:12.08,0:10:13.09,Default,,0,0,0,,Инновассогакоре
Dialogue: 0,0:10:14.01,0:10:15.00,Default,,0,0,0,,Құдай-ай, оны тауып алуға тура келеді
Dialogue: 0,0:10:15.05,0:10:18.04,Default,,0,0,0,,Балаңды шынымен ұрсаң, көп пәлеге қаласың.
Dialogue: 0,0:10:16.04,0:10:17.06,Default,,0,0,0,,Үлкендердің зорлық-зомбылығы
Dialogue: 0,0:10:19.00,0:10:23.04,Default,,0,0,0,,Янки үйге барады Мұғалім, Нару екеуміз осында доджбол ойнағымыз келді.
Dialogue: 0,0:10:23.06,0:10:26.00,Default,,0,0,0,,О, мен бұл қарқынмен кері шегіне алмаймын.
Dialogue: 0,0:10:26.08,0:10:28.06,Default,,0,0,0,,Тіпті балалар да маған арқа сүйейді.
Dialogue: 0,0:10:28.07,0:10:31.00,Default,,0,0,0,,Енді өз қадіріңді көрсететін кез келді.
Dialogue: 0,0:10:31.06,0:10:32.08,Default,,0,0,0,,Сәлем балалар
Dialogue: 0,0:10:32.09,0:10:34.02,Default,,0,0,0,,Каккачи Уайт Сомен
Dialogue: 0,0:10:34.08,0:10:36.07,Default,,0,0,0,,Ақ Сомен
Dialogue: 0,0:10:37.08,0:10:40.04,Default,,0,0,0,,Біз ересекпіз, сондықтан зорлық-зомбылық қолданбаймыз.
Dialogue: 0,0:10:41.00,0:10:43.08,Default,,0,0,0,,Бірақ егер сіз осында бұдан әрі қалсаңыз
Dialogue: 0,0:10:44.00,0:10:46.02,Default,,0,0,0,,Мен телефон соғуым керек.
Dialogue: 0,0:10:46.03,0:10:48.00,Default,,0,0,0,,Телефонды бір жерге қойғыңыз келе ме?
Dialogue: 0,0:10:49.03,0:10:50.01,Default,,0,0,0,,Полиция
Dialogue: 0,0:10:50.05,0:10:52.05,Default,,0,0,0,,Полиция неге шықты?
Dialogue: 0,0:10:53.01,0:10:56.03,Default,,0,0,0,,Мен сізге анонимді телефон соғып, баланы қорлап жатқаныңызды айтамын.
Dialogue: 0,0:10:57.01,0:10:58.08,Default,,0,0,0,,Сізге нұсқау берілсе, ұят болар еді.
Dialogue: 0,0:10:58.09,0:11:00.02,Default,,0,0,0,,Ата-ана да қиындыққа тап болады.
Dialogue: 0,0:11:00.02,0:11:01.03,Default,,0,0,0,,Бұл өмірдің құлдырауы
Dialogue: 0,0:11:02.00,0:11:04.06,Default,,0,0,0,,Көрдіңіз бе? Бұл ересектерге арналған стратегия.
Dialogue: 0,0:11:05.02,0:11:07.03,Default,,0,0,0,,Уау, бұл өте танымал.
Dialogue: 0,0:11:07.06,0:11:10.02,Default,,0,0,0,,Қарғыс атсын, бұл лас және қорқынышты.
Dialogue: 0,0:11:10.02,0:11:11.01,Default,,0,0,0,,Жылау
Dialogue: 0,0:11:17.07,0:11:20.06,Default,,0,0,0,,Сіз менің ұялы телефоныма соңғы соққы жасадыңыз.
Dialogue: 0,0:11:20.09,0:11:23.05,Default,,0,0,0,,Тек оған тезек тұрып қалды.
Dialogue: 0,0:11:24.01,0:11:25.02,Default,,0,0,0,,Ақымақ бала
Dialogue: 0,0:11:25.02,0:11:26.06,Default,,0,0,0,,Тіпті телефон ретінде жұмысын тоқтатса да
Dialogue: 0,0:11:26.06,0:11:28.09,Default,,0,0,0,,Мен көптен бері сағат ретінде пайдаланып жүрген серіктесіммен осылай болды.
Dialogue: 0,0:11:29.05,0:11:31.03,Default,,0,0,0,,Телефон ретінде пайдалануға болмайды
Dialogue: 0,0:11:31.04,0:11:33.02,Default,,0,0,0,,Сен баланы алдадың.
Dialogue: 0,0:11:33.03,0:11:36.02,Default,,0,0,0,,Менің ұялы телефонымды балағаттап, ашуландың ба?
Dialogue: 0,0:11:40.07,0:11:42.01,Default,,0,0,0,,Хиро, сен күлдің.
Dialogue: 0,0:11:42.01,0:11:44.00,Default,,0,0,0,,Жоқ, күле алмайсың.
Dialogue: 0,0:11:47.07,0:11:49.01,Default,,0,0,0,,Бір нәрсе
Dialogue: 0,0:11:49.02,0:11:50.09,Default,,0,0,0,,Бейсбол ойнайық
Dialogue: 0,0:11:51.05,0:11:52.02,Default,,0,0,0,,Чо Сенсэй
Dialogue: 0,0:11:52.03,0:11:54.00,Default,,0,0,0,,Олар бізді елемейді.
Dialogue: 0,0:11:55.07,0:11:56.09,Default,,0,0,0,,Қайта-қайта айтпа
Dialogue: 0,0:11:57.02,0:11:59.04,Default,,0,0,0,,Ауылыңыздың ойын алаңына барыңыз.
Dialogue: 0,0:11:59.05,0:12:02.06,Default,,0,0,0,,Шу, біздің ойын алаңында орта сынып оқушылары отыр.
Dialogue: 0,0:12:03.01,0:12:06.00,Default,,0,0,0,,Күшті әйел мен көзілдірік киген әйел төбелесіп жатыр
Dialogue: 0,0:12:06.07,0:12:08.00,Default,,0,0,0,,Бұл олар.
Dialogue: 0,0:12:08.04,0:12:09.07,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:12:10.00,0:12:11.01,Default,,0,0,0,,Бұл жерден кет
Dialogue: 0,0:12:11.04,0:12:14.01,Default,,0,0,0,,Нару Эй, бұл енді тым көп.
Dialogue: 0,0:12:14.06,0:12:17.00,Default,,0,0,0,,Кім зорлықшы?
Dialogue: 0,0:12:17.02,0:12:20.07,Default,,0,0,0,,Сені осы ауылда үлкен кісі ұрып-соққан. Ата-анаңа айтпа.
Dialogue: 0,0:12:20.09,0:12:24.01,Default,,0,0,0,,Үлкен кісі баланы ұрса, солай болады.
Dialogue: 0,0:12:24.02,0:12:27.03,Default,,0,0,0,,Балалар, балаларды қорлағаны үшін қамауға алындыңдар.
Dialogue: 0,0:12:27.09,0:12:29.07,Default,,0,0,0,,Олай десеңіз, орынсыз.
Dialogue: 0,0:12:30.01,0:12:33.07,Default,,0,0,0,,Үлкендер балаларды ұрмауы керек.
Dialogue: 0,0:12:34.01,0:12:37.02,Default,,0,0,0,,Түсіндім, олар мұнда бейсбол ойнайды.
Dialogue: 0,0:12:38.00,0:12:38.50,Default,,0,0,0,,Жасайық
Dialogue: 0,0:12:40.00,0:12:42.01,Default,,0,0,0,,Басынан бір жерде
Dialogue: 0,0:12:42.07,0:12:44.01,Default,,0,0,0,,Олар олар.
Dialogue: 0,0:12:44.08,0:12:46.08,Default,,0,0,0,,Доджбол ойнаймыз ба?
Dialogue: 0,0:12:47.00,0:12:47.50,Default,,0,0,0,,That's right.
Dialogue: 0,0:12:49.00,0:12:50.05,Default,,0,0,0,,Біз осында береміз.
Dialogue: 0,0:12:51.02,0:12:53.02,Default,,0,0,0,,Бейсболды қалағаныңызша ойнаңыз.
Dialogue: 0,0:12:53.04,0:12:55.04,Default,,0,0,0,,Біз өзімізбен ойнаймыз.
Dialogue: 0,0:12:55.09,0:12:57.08,Default,,0,0,0,,Мұғалім екеуміз даладамыз.
Dialogue: 0,0:12:57.09,0:12:59.03,Default,,0,0,0,,Балалар сендер қашып кетіңдер.
Dialogue: 0,0:13:00.01,0:13:02.03,Default,,0,0,0,,Эй, күте тұр, біз келдік.
Dialogue: 0,0:13:02.06,0:13:03.01,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:13:03.02,0:13:03.52,Default,,0,0,0,,Мен жылығым келеді
Dialogue: 0,0:13:05.01,0:13:07.07,Default,,0,0,0,,Мұғалім күткендей, ол балаларға байыпты қарайды.
Dialogue: 0,0:13:08.03,0:13:11.00,Default,,0,0,0,,Егер ол жұмыс істемесе, бәрі жақсы.
Dialogue: 0,0:13:13.05,0:13:15.01,Default,,0,0,0,,Енді келесі кім?
Dialogue: 0,0:13:16.03,0:13:17.09,Default,,0,0,0,,Ол кері соққы жасады
Dialogue: 0,0:13:18.01,0:13:19.06,Default,,0,0,0,,Мықты болыңыз, ұстаз.
Dialogue: 0,0:13:19.08,0:13:21.02,Default,,0,0,0,,Доп алынса, бітті.
Dialogue: 0,0:13:21.07,0:13:23.04,Default,,0,0,0,,Ересек болсаң да шіркін.
Dialogue: 0,0:13:23.05,0:13:24.06,Default,,0,0,0,,Мен байсалдымын.
Dialogue: 0,0:13:25.01,0:13:26.04,Default,,0,0,0,,Мен ересек болсам да
Dialogue: 0,0:13:26.05,0:13:27.05,Default,,0,0,0,,емес
Dialogue: 0,0:13:28.05,0:13:30.06,Default,,0,0,0,,Өйткені сіз ересексіз
Dialogue: 0,0:13:33.01,0:13:34.00,Default,,0,0,0,,Тұтылу
Dialogue: 0,0:13:34.07,0:13:36.02,Default,,0,0,0,,Мұғалім осылай
Dialogue: 0,0:13:36.04,0:13:38.03,Default,,0,0,0,,Ыстық болса да жақсы орында
Dialogue: 0,0:13:38.08,0:13:40.03,Default,,0,0,0,,Ақкиида
Dialogue: 0,0:13:40.04,0:13:42.01,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:13:42.01,0:13:44.02,Default,,0,0,0,,Өткен күні ойнаған ойыным тұрып қалды.
Dialogue: 0,0:13:44.06,0:13:46.04,Default,,0,0,0,,Балалар, әлі ұтқан жоқсыңдар.
Dialogue: 0,0:13:46.07,0:13:48.01,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:13:48.03,0:13:49.09,Default,,0,0,0,,Біз Аккимен ойнаймыз
Dialogue: 0,0:13:51.02,0:13:53.04,Default,,0,0,0,,Бір минут күтіңіз, бұл оңай.
Dialogue: 0,0:13:53.08,0:13:56.06,Default,,0,0,0,,Кешіріңіз, мен ойнап көңілді болдым.
Dialogue: 0,0:13:56.08,0:13:58.02,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:13:58.08,0:13:59.06,Default,,0,0,0,,Осы үшін оны мектептен шығарып жіберсе жақсы болар еді.
Dialogue: 0,0:14:00.01,0:14:01.02,Default,,0,0,0,,Қайта кездескенше
Dialogue: 0,0:14:05.03,0:14:08.03,Default,,0,0,0,,Акки өте жетілген.
Dialogue: 0,0:14:08.07,0:14:09.04,Default,,0,0,0,,О
Dialogue: 0,0:14:14.04,0:14:15.07,Default,,0,0,0,,Менің артымнан ермеңіз
Dialogue: 0,0:14:16.02,0:14:18.04,Default,,0,0,0,,Мен үйге кетейін деп жатырмын
Dialogue: 0,0:14:19.01,0:14:21.03,Default,,0,0,0,,Көбірек ойнайық
Dialogue: 0,0:14:20.02,0:14:21.03,Default,,0,0,0,,Тартпаңыз
Dialogue: 0,0:14:21.08,0:14:24.02,Default,,0,0,0,,Тарзан жасайық! Тарзан
Dialogue: 0,0:14:24.05,0:14:24.55,Default,,0,0,0,,Тарзан
Dialogue: 0,0:14:25.03,0:14:27.02,Default,,0,0,0,,Мен бұл жерден немен айналысқаныма таң қалдым.
Dialogue: 0,0:14:27.02,0:14:28.07,Default,,0,0,0,,Париж қызықты
Dialogue: 0,0:14:32.07,0:14:35.08,Default,,0,0,0,,Мен көмектесе алмаймын, аз ғана.
Dialogue: 0,0:14:35.09,0:14:38.03,Default,,0,0,0,,Уау міне, міне
Dialogue: 0,0:14:39.05,0:14:44.05,Default,,0,0,0,,Ей, мен мұндай шынайы тарзанды бірінші рет көріп тұрмын.
Dialogue: 0,0:14:45.04,0:14:46.03,Default,,0,0,0,,Бұл оңай ма?
Dialogue: 0,0:14:46.03,0:14:47.04,Default,,0,0,0,,Бұл оңай емес.
Dialogue: 0,0:14:47.05,0:14:49.01,Default,,0,0,0,,Бұл табиғи шырмауық.
Dialogue: 0,0:14:49.05,0:14:51.01,Default,,0,0,0,,Нару сізге мысал көрсетеді
Dialogue: 0,0:14:51.02,0:14:52.04,Default,,0,0,0,,Бұл қауіпті, сондықтан оны тоқтатыңыз.
Dialogue: 0,0:15:00.04,0:15:02.02,Default,,0,0,0,,Мен өзімді өте кішкентай сезінемін
Dialogue: 0,0:15:02.07,0:15:05.06,Default,,0,0,0,,Мен не істеуім керек? Бұл мүлдем қызық емес сияқты.
Dialogue: 0,0:15:06.07,0:15:08.08,Default,,0,0,0,,Иә, енді сіздің кезегіңіз.
Dialogue: 0,0:15:08.09,0:15:09.08,Default,,0,0,0,,Оны жасауға бола ма?
Dialogue: 0,0:15:09.08,0:15:11.06,Default,,0,0,0,,Неліктен қызық?
Dialogue: 0,0:15:11.06,0:15:13.03,Default,,0,0,0,,Ересек болсаң да, шіркін
Dialogue: 0,0:15:13.04,0:15:16.09,Default,,0,0,0,,Ересек болған соң айта аласың ба?
Dialogue: 0,0:15:17.03,0:15:18.07,Default,,0,0,0,,Мүлде мүмкін емес.
Dialogue: 0,0:15:18.08,0:15:21.02,Default,,0,0,0,,Мұндай жүзім ересек адамның салмағын көтере ала ма?
Dialogue: 0,0:15:21.08,0:15:25.02,Default,,0,0,0,,Егер бәрің бірігіп орындасаңдар, әңгіме басқаша болар еді.
Dialogue: 0,0:15:27.09,0:15:29.09,Default,,0,0,0,,Бұл менің кінәм болды.
Dialogue: 0,0:15:30.01,0:15:31.04,Default,,0,0,0,,Жарайды, мұғалім де жасайды.
Dialogue: 0,0:15:31.05,0:15:32.05,Default,,0,0,0,,Түсінемін, түсінемін
Dialogue: 0,0:15:32.08,0:15:35.07,Default,,0,0,0,,Өтінемін, менің алдымда қауіпті ештеңе жасамаңыз.
Dialogue: 0,0:15:35.08,0:15:36.05,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:15:36.06,0:15:38.04,Default,,0,0,0,,Бұл өте қызықты.
Dialogue: 0,0:15:38.07,0:15:40.07,Default,,0,0,0,,Менің ойымша, сіз маған оның қаншалықты қызықты екенін көрсеткіңіз келеді.
Dialogue: 0,0:15:40.08,0:15:42.03,Default,,0,0,0,,Мүлдем бақытты емес
Dialogue: 0,0:15:43.02,0:15:44.03,Default,,0,0,0,,Егер мұндай нәрсе болса
Dialogue: 0,0:15:44.03,0:15:46.01,Default,,0,0,0,,Бір күні бұл жігіттер зардап шегеді.
Dialogue: 0,0:15:46.05,0:15:47.06,Default,,0,0,0,,Мен балаларға ренжідім.
Dialogue: 0,0:15:47.07,0:15:49.07,Default,,0,0,0,,Қауіпті ойын құралдарын алып тастау керек
Dialogue: 0,0:15:50.01,0:15:51.01,Default,,0,0,0,,Мотивация
Dialogue: 0,0:15:51.05,0:15:53.09,Default,,0,0,0,,Ұшып тұрғандай кейіп танытып, оны жұлып ал
Dialogue: 0,0:15:57.01,0:16:01.04,Default,,0,0,0,,Жоқ, мұғалім, жыртылып кетсе мен ойнай алмаймын.
Dialogue: 0,0:16:05.02,0:16:06.07,Default,,0,0,0,,Тоқта
Dialogue: 0,0:16:25.00,0:16:27.00,Default,,0,0,0,,Балалар сендер ауырып қалдыңдар ма?
Dialogue: 0,0:16:27.01,0:16:28.00,Default,,0,0,0,,Иә, бәрібір
Dialogue: 0,0:16:28.01,0:16:29.08,Default,,0,0,0,,Мен қорықтым
Dialogue: 0,0:16:30.05,0:16:32.08,Default,,0,0,0,,Өлемін деп ойладым Өлемін деп
Dialogue: 0,0:16:32.09,0:16:34.01,Default,,0,0,0,,Мұғалім, қан
Dialogue: 0,0:16:34.01,0:16:35.01,Default,,0,0,0,,Жарайды
Dialogue: 0,0:16:35.02,0:16:37.02,Default,,0,0,0,,Жарайды, мен жай ғана сипап қойдым.
Dialogue: 0,0:16:37.03,0:16:38.06,Default,,0,0,0,,Қиын болса, шығыршық
Dialogue: 0,0:16:38.09,0:16:40.01,Default,,0,0,0,,Шөпті іздеңіз
Dialogue: 0,0:16:39.00,0:16:40.01,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:16:40.01,0:16:41.02,Default,,0,0,0,,Бұл ауыр жарақат емес.
Dialogue: 0,0:16:41.02,0:16:42.02,Default,,0,0,0,,Шұңқыр
Dialogue: 0,0:16:43.06,0:16:45.06,Default,,0,0,0,,Бұл емдік шөп қанды тоқтатады.
Dialogue: 0,0:16:45.07,0:16:49.05,Default,,0,0,0,,Тырнақ болса да, соны қойсаң, микроб таратады.
Dialogue: 0,0:16:50.04,0:16:52.03,Default,,0,0,0,,Бұл үйге барар жолдағы төте жол.
Dialogue: 0,0:16:52.04,0:16:55.04,Default,,0,0,0,,Бүгін тағы бір бедеу күнім болды.
Dialogue: 0,0:16:56.03,0:17:00.02,Default,,0,0,0,,Күнделікті балалармен ойнаудан ерекше ештеңе жоқ.
Dialogue: 0,0:17:00.07,0:17:04.03,Default,,0,0,0,,Жасампаздық құштарлық пайда болған сәтті күту дұрыс па?
Dialogue: 0,0:17:05.01,0:17:07.00,Default,,0,0,0,,Уақыт барған сайын жақындап келеді
Dialogue: 0,0:17:07.04,0:17:08.03,Default,,0,0,0,,Дондон
Dialogue: 0,0:17:19.06,0:17:21.02,Default,,0,0,0,,келді келді
Dialogue: 0,0:17:21.04,0:17:22.09,Default,,0,0,0,,Кітаптардың құдайы түсті.
Dialogue: 0,0:17:23.06,0:17:26.09,Default,,0,0,0,,Жазғыңыз келетін нәрсені қалай оңай табуға болады?
Dialogue: 0,0:17:27.05,0:17:28.09,Default,,0,0,0,,Мен ертерек үйге барып жазуым керек.
Dialogue: 0,0:17:29.00,0:17:30.05,Default,,0,0,0,,Енді жазуға болады
Dialogue: 0,0:17:34.09,0:17:36.04,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:36.07,0:17:38.04,Default,,0,0,0,,Мұғалім сенімен бірге жүреді.
Dialogue: 0,0:17:39.00,0:17:41.02,Default,,0,0,0,,Сіз басқа маршруттан рұқсатсыз оралдыңыз.
Dialogue: 0,0:17:41.04,0:17:42.07,Default,,0,0,0,,енді ешқашан келмеуі мүмкін.
Dialogue: 0,0:17:42.09,0:17:45.03,Default,,0,0,0,,Иә, мұғалім әрқашан солай.
Dialogue: 0,0:17:45.06,0:17:46.03,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:46.03,0:17:47.00,Default,,0,0,0,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,0:17:51.05,0:17:53.02,Default,,0,0,0,,Мұғалім кері қайтуы керек.
Dialogue: 0,0:17:53.05,0:17:55.09,Default,,0,0,0,,Біз келгенде ешкім болмады.
Dialogue: 0,0:17:56.04,0:17:58.02,Default,,0,0,0,,Таудан қайтар жолда
Dialogue: 0,0:17:58.03,0:17:59.07,Default,,0,0,0,,Мұғалім, мен кеттім.
Dialogue: 0,0:17:59.09,0:18:01.03,Default,,0,0,0,,Ол кетті
Dialogue: 0,0:18:01.07,0:18:03.02,Default,,0,0,0,,Міне.
Dialogue: 0,0:18:03.04,0:18:05.04,Default,,0,0,0,,Тауда тұратын Панбенің тұзағына түскен
Dialogue: 0,0:18:05.05,0:18:07.03,Default,,0,0,0,,Мені толық жеуге болады.
Dialogue: 0,0:18:10.00,0:18:13.06,Default,,0,0,0,,Құбыжықтар болмаса да, қайтып келмеді деп уайымдаймын.
Dialogue: 0,0:18:14.00,0:18:15.08,Default,,0,0,0,,Тауда адасып кетсем де
Dialogue: 0,0:18:15.08,0:18:17.06,Default,,0,0,0,,Бұл ағаштар теңізі емес.
Dialogue: 0,0:18:18.05,0:18:19.01,Default,,0,0,0,,Жарайды
Dialogue: 0,0:18:23.01,0:18:26.00,Default,,0,0,0,,Бұл қоян ма? Сіз мені шошыттыңыз.
Dialogue: 0,0:18:28.01,0:18:30.06,Default,,0,0,0,,Мен жақсы қолжазба жазамын деп ойласам да.
Dialogue: 0,0:18:31.06,0:18:34.09,Default,,0,0,0,,Осыдан біраз бұрын балаларыммен шуылдап ойнаған кезім
Dialogue: 0,0:18:35.01,0:18:37.01,Default,,0,0,0,,Өзін өте алыс сезінеді
Dialogue: 0,0:18:39.04,0:18:41.05,Default,,0,0,0,,Мен қатты үрейленіп тұрмын
Dialogue: 0,0:18:41.06,0:18:44.00,Default,,0,0,0,,Менің миым естеліктерді құрастыра бастады.
Dialogue: 0,0:18:44.04,0:18:46.04,Default,,0,0,0,,Қарапайым ақыл Қарапайым ақыл
Dialogue: 0,0:18:46.06,0:18:48.06,Default,,0,0,0,,Егер сіз сәл жоғары көтерілсеңіз, бастапқы жолға қайта ораласыз.
Dialogue: 0,0:18:50.08,0:18:54.07,Default,,0,0,0,,Киёшу қолыңнан келгеннің бәрін жаса Кийошу
Dialogue: 0,0:18:55.03,0:18:56.01,Default,,0,0,0,,Жарайды
Dialogue: 0,0:19:02.03,0:19:04.02,Default,,0,0,0,,Бұл өтірік.
Dialogue: 0,0:19:06.01,0:19:07.08,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:19:08.03,0:19:11.04,Default,,0,0,0,,Қарғыс атқыр, сенің маған көмектесуге келетін кезің болды.
Dialogue: 0,0:19:11.05,0:19:12.09,Default,,0,0,0,,Олар не істеп жатыр?
Dialogue: 0,0:19:13.00,0:19:14.09,Default,,0,0,0,,Сондай белгісіз тауда адасу.
Dialogue: 0,0:19:15.00,0:19:17.00,Default,,0,0,0,,Бұл жалғыздықтың биігі емес пе?
Dialogue: 0,0:19:17.09,0:19:18.05,Default,,0,0,0,,Өл
Dialogue: 0,0:19:19.02,0:19:21.05,Default,,0,0,0,,Шын мәнінде жалғыз өліңіз
Dialogue: 0,0:19:22.07,0:19:24.04,Default,,0,0,0,,Біреу маған көмектесуін өтінемін
Dialogue: 0,0:19:24.04,0:19:26.02,Default,,0,0,0,,Кез келген адам жақсы.
Dialogue: 0,0:19:28.06,0:19:29.02,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:32.08,0:19:34.06,Default,,0,0,0,,Не, жай ғана кілт пе?
Dialogue: 0,0:19:39.05,0:19:41.00,Default,,0,0,0,,Бұл менің кілтім.
Dialogue: 0,0:19:42.02,0:19:44.02,Default,,0,0,0,,Мен қайталанатын кілтімді жоғалтып алдым
Dialogue: 0,0:19:44.03,0:19:46.02,Default,,0,0,0,,Таудың ар жағындағы тауда ойнаған кезде шығар.
Dialogue: 0,0:19:46.06,0:19:47.07,Default,,0,0,0,,Сол жігіт
Dialogue: 0,0:19:51.05,0:19:55.06,Default,,0,0,0,,Ақымақ, мен неге арғы тауда асығамын?
Dialogue: 0,0:19:55.08,0:19:58.05,Default,,0,0,0,,Сіздің үйіңіздің жанында адасып жүргендер бар ма?
Dialogue: 0,0:20:03.06,0:20:04.06,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:05.09,0:20:09.01,Default,,0,0,0,,Ой, бұл кеңістік пе?
Dialogue: 0,0:20:10.04,0:20:11.01,Default,,0,0,0,,Аққан жұлдыз
Dialogue: 0,0:20:12.02,0:20:15.03,Default,,0,0,0,,Монша түзеледі деп үміттенемін*3
Dialogue: 0,0:20:16.03,0:20:17.09,Default,,0,0,0,,Жоқ, бірдеңе дұрыс емес.
Dialogue: 0,0:20:18.05,0:20:20.08,Default,,0,0,0,,Жақында үйге барып жазамын деп үміттенемін.
Dialogue: 0,0:20:23.00,0:20:25.05,Default,,0,0,0,,Қараңдаршы, мен құладым.
Dialogue: 0,0:20:25.07,0:20:28.03,Default,,0,0,0,,Мен қалыпты жолды да іздемеймін.
Dialogue: 0,0:20:28.04,0:20:31.08,Default,,0,0,0,,Мұғалім, аман-есен болғаныңызға қуаныштымын.
Dialogue: 0,0:20:32.08,0:20:35.00,Default,,0,0,0,,Тым кеш!
Dialogue: 0,0:20:35.06,0:20:37.00,Default,,0,0,0,,Мұғалім, жылама
Dialogue: 0,0:20:37.03,0:20:38.05,Default,,0,0,0,,Сіз жылап жатырсыз.
Dialogue: 0,0:20:46.06,0:20:48.03,Default,,0,0,0,,Жақсы, міне келдік!
Dialogue: 0,0:20:48.01,0:20:50.02,Default,,0,0,0,,Мұғалімге арналған алғашқы көмек қобдишасы
Dialogue: 0,0:20:50.04,0:20:51.09,Default,,0,0,0,,Кел, кел, кел
Dialogue: 0,0:20:52.00,0:20:53.07,Default,,0,0,0,,Сіз жұмыстасыз.
Dialogue: 0,0:21:02.06,0:21:05.05,Default,,0,0,0,,Өйткені, шабыт маңызды.
Dialogue: 0,0:21:08.09,0:21:11.04,Default,,0,0,0,,Сіз кішкентай қолды создыңыз
Dialogue: 0,0:21:11.05,0:21:17.03,Default,,0,0,0,,Саған ұқсап күлу табиғи болды
Dialogue: 0,0:21:19.09,0:21:22.05,Default,,0,0,0,,Оның мағынасы болмауы мүмкін
Dialogue: 0,0:21:22.07,0:21:28.02,Default,,0,0,0,,бірақ бұл мен істей алмайтын нәрсе
Dialogue: 0,0:21:30.06,0:21:34.03,Default,,0,0,0,,Ойланбай қолыма тидің
Dialogue: 0,0:21:34.03,0:21:38.01,Default,,0,0,0,,бірақ бұл мен үшін жақсы болды
Dialogue: 0,0:21:41.00,0:21:46.04,Default,,0,0,0,,Біз сенген барлық уақытта
Dialogue: 0,0:21:46.05,0:21:51.09,Default,,0,0,0,,дүние біздің қолымызда болды
Dialogue: 0,0:21:52.01,0:21:54.08,Default,,0,0,0,,Біз қателестік
Dialogue: 0,0:21:54.08,0:22:02.09,Default,,0,0,0,,, мүмкін, сен менің қолымды ұстап тұрғандықтан емес шығар
Dialogue: 0,0:22:02.09,0:22:08.05,Default,,0,0,0,,Әр сәтте
Dialogue: 0,0:22:08.06,0:22:14.00,Default,,0,0,0,,Барлық жерде
Dialogue: 0,0:22:14.01,0:22:19.03,Default,,0,0,0,,Мен сене аламын, сене аламын
Dialogue: 0,0:22:19.07,0:22:24.05,Default,,0,0,0,,Жылы алақаныңды ұстағанда
Dialogue: 0,0:22:24.06,0:22:31.09,Default,,0,0,0,,сіздің жылы қолыңыз
Dialogue: 0,0:22:42.07,0:22:43.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:22:44.02,0:22:45.05,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:22:46.07,0:22:47.05,Default,,0,0,0,,Үйге қайтайық.
Dialogue: 0,0:22:48.55,0:22:53.55,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
