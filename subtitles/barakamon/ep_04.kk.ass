Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:38.41,0:01:40.71,OP-JP,,0,0,0,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:01:41.47,0:01:43.96,OP-JP,,0,0,0,,«Басқалардан ерекшелену» арқылы өзіңізді ерекшелендіріңіз
Dialogue: 0,0:01:44.20,0:01:46.44,OP-JP,,0,0,0,,Дүкен журналының бұрышы
Dialogue: 0,0:01:46.94,0:01:49.83,OP-JP,,0,0,0,,Мұқабаға кездейсоқ жазылған.
Dialogue: 0,0:01:49.89,0:01:52.17,OP-JP,,0,0,0,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:01:52.64,0:01:55.19,OP-JP,,0,0,0,,Кішкентай кезімде түк көрмедім.
Dialogue: 0,0:01:55.68,0:01:58.15,OP-JP,,0,0,0,,Ұнамаса, ашулан.
Dialogue: 0,0:01:58.18,0:02:01.07,OP-JP,,0,0,0,,Сізге ұнайтын нәрсені айтыңыз
Dialogue: 0,0:02:01.15,0:02:04.24,OP-JP,,0,0,0,,Біз өзгереміз
Dialogue: 0,0:02:04.24,0:02:07.11,OP-JP,,0,0,0,,Нені қорғағыңыз келетін өзгерістер
Dialogue: 0,0:02:07.11,0:02:09.86,OP-JP,,0,0,0,,Түсінбеген қазынадан
Dialogue: 0,0:02:09.93,0:02:12.60,OP-JP,,0,0,0,,Түсіну керек
Dialogue: 0,0:02:12.60,0:02:18.13,OP-JP,,0,0,0,,Өскен сайын өкінесің.
Dialogue: 0,0:02:18.14,0:02:20.75,OP-JP,,0,0,0,,Бірақ бәрібір.
Dialogue: 0,0:02:21.15,0:02:25.08,OP-JP,,0,0,0,,Сіз бір нәрсе көре аласыз
Dialogue: 0,0:02:26.74,0:02:32.17,OP-JP,,0,0,0,,Сондықтан мен өзіммін, ал сен өзіңсің.
Dialogue: 0,0:02:32.17,0:02:38.16,OP-JP,,0,0,0,,Менің ойымша, бұл басынан бастап іздейтін нәрсе емес.
Dialogue: 0,0:02:38.16,0:02:43.43,OP-JP,,0,0,0,,Мен сен емеспін, сен де мен емессің
Dialogue: 0,0:02:43.44,0:02:46.30,OP-JP,,0,0,0,,Бір-бірінен өту, қол ұстасу
Dialogue: 0,0:02:46.35,0:02:50.91,OP-JP,,0,0,0,,Махаббаттың туатын жері.
Dialogue: 0,0:02:52.08,0:02:54.81,OP-JP,,0,0,0,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:02:54.87,0:03:00.93,OP-JP,,0,0,0,,Мен оны өзгерте алмаймын, себебі бұл маңызды.
Dialogue: 0,0:03:01.33,0:03:04.68,OP-JP,,0,0,0,,Өзгеретін өмір дұрыс
Dialogue: 0,0:20:46.10,0:20:48.55,ED-JP,,0,0,0,,Сіз кішкентай қолыңызды создыңыз
Dialogue: 0,0:20:48.68,0:20:50.44,ED-JP,,0,0,0,,Күлімсіреп саған
Dialogue: 0,0:20:50.51,0:20:54.44,ED-JP,,0,0,0,,Бұл өте табиғи болды
Dialogue: 0,0:20:57.02,0:20:59.61,ED-JP,,0,0,0,,Оның мағынасы болмауы мүмкін
Dialogue: 0,0:20:59.84,0:21:05.38,ED-JP,,0,0,0,,Бірақ бұл менің қолымнан келмейді
Dialogue: 0,0:21:07.71,0:21:11.45,ED-JP,,0,0,0,,Сен ойланбастан қолыма тидің
Dialogue: 0,0:21:11.45,0:21:15.24,ED-JP,,0,0,0,,Бұл мен үшін жақсы болды
Dialogue: 0,0:21:18.17,0:21:23.56,ED-JP,,0,0,0,,Біз сенген барлық уақытта
Dialogue: 0,0:21:23.68,0:21:31.81,ED-JP,,0,0,0,,Қолымыздағы сөздерді саламыз
Dialogue: 0,0:21:31.94,0:21:40.01,ED-JP,,0,0,0,,Мүмкін бұл сен менің қолымды ұстап тұрғандықтан емес шығар
Dialogue: 0,0:21:40.20,0:21:51.13,ED-JP,,0,0,0,,Әр сәт, барлық жерде
Dialogue: 0,0:21:51.27,0:21:56.50,ED-JP,,0,0,0,,Мен сеземін, сеземін
Dialogue: 0,0:21:56.83,0:22:01.68,ED-JP,,0,0,0,,Мен сені жамандықтан ұстап тұрғанда
Dialogue: 0,0:22:01.74,0:22:09.05,ED-JP,,0,0,0,,Сіз үйренесіз
Dialogue: 0,0:03:09.96,0:03:14.96,LOGO,,0,0,0,,Бұл субтитр көзі өндіруші, жеткізуші, алмасу студенті жасаған және коммерциялық пайдалануға тыйым салынған субтитр ұйымы (kamigami.org) болып табылады.
Dialogue: 0,0:03:14.96,0:03:19.96,LOGO,,0,0,0,,: :& :&lucifer : :
Dialogue: 0,0:00:06.16,0:00:09.25,JP,,0,0,0,,Тек жоғарғы жағына қарау жақсы емес.
Dialogue: 0,0:00:10.48,0:00:14.94,JP,,0,0,0,,Сәл күтіңіз, егер ол жерге құлап кетсе, оны алыңыз.
Dialogue: 0,0:00:15.93,0:00:17.51,JP,,0,0,0,,Төменгі жаққа қарау жақсы емес
Dialogue: 0,0:00:18.38,0:00:20.34,JP,,0,0,0,,Өз қарқыныңызбен
Dialogue: 0,0:00:21.22,0:00:24.35,JP,,0,0,0,,Еңбегіңді аямай, каллиграфияға тиянақты еңбек етсең,
Dialogue: 0,0:00:24.72,0:00:26.90,JP,,0,0,0,,Мүмкін бір күні өз кітабыңды тауып аларсың.
Dialogue: 0,0:00:28.95,0:00:32.15,JP,,0,0,0,,Бірақ бұл қандай фильм?
Dialogue: 0,0:00:33.49,0:00:35.47,JP,,0,0,0,,Жалғасын шығару үшін танымал болды ма?
Dialogue: 0,0:00:36.63,0:00:37.31,JP,,0,0,0,,Жарайды
Dialogue: 0,0:00:53.77,0:00:59.51,JP,,0,0,0,,Бұл бұзылған.
Dialogue: 0,0:01:00.90,0:01:05.51,JP,,0,0,0,,Мен не істеуім керек? Аралда менің компьютерімді жөндейтін орын жоқ сияқты.
Dialogue: 0,0:01:05.85,0:01:07.35,JP,,0,0,0,,Кавафуджи
Dialogue: 0,0:01:18.76,0:01:19.38,JP,,0,0,0,,Ақымақ
Dialogue: 0,0:01:21.20,0:01:23.49,JP,,0,0,0,,Мен оны бір рет теңізге түсіргеннен кейін көңілім көтерілмеді.
Dialogue: 0,0:01:23.79,0:01:25.49,JP,,0,0,0,,Ақыры бұзылды ма?
Dialogue: 0,0:01:25.79,0:01:28.71,JP,,0,0,0,,Компьютер жоқ Ұялы телефон жоқ Тұрмыстық техника жоқ
Dialogue: 0,0:01:29.61,0:01:34.30,JP,,0,0,0,,Осындай жерде сізбен қалай байланысуға болады?
Dialogue: 0,0:00:00.00,0:00:00.00,JP,,0,0,0,,Аударма: Арал әкелері
Dialogue: 0,0:03:12.54,0:03:14.99,JP,,0,0,0,,Менің аралға келгеніме бір айға жуықтап қалды.
Dialogue: 0,0:03:16.20,0:03:20.29,JP,,0,0,0,,Баяу өмір салтына қарамастан, мұнда күнделікті өмір таң қалдырады.
Dialogue: 0,0:03:22.91,0:03:26.75,JP,,0,0,0,,Осы арада менің жүрегімді емдейтін жер бар.
Dialogue: 0,0:03:35.54,0:03:39.41,JP,,0,0,0,,Иә, бұл мысықтарды жақсы көретіндердің жұмағы еді.
Dialogue: 0,0:03:40.80,0:03:44.89,JP,,0,0,0,,Сүйкімді, мен оны ұстағым келеді
Dialogue: 0,0:03:45.23,0:03:47.30,JP,,0,0,0,,Бірақ бұл жеке меншік.
Dialogue: 0,0:03:48.06,0:03:50.12,JP,,0,0,0,,Мұнда көбірек келіңіз
Dialogue: 0,0:03:53.08,0:03:55.08,JP,,0,0,0,,Чи чи бұл ұры мысық
Dialogue: 0,0:03:55.40,0:03:57.08,JP,,0,0,0,,Тоңазытқышты қайта пайдаланыңыз.
Dialogue: 0,0:03:57.39,0:04:00.09,JP,,0,0,0,,Енді ашуланба
Dialogue: 0,0:04:00.17,0:04:03.29,JP,,0,0,0,,Кешкі асқа сашими жесе, кім ашуланады?
Dialogue: 0,0:04:04.86,0:04:06.53,JP,,0,0,0,,Мұғалім, сізге не керек?
Dialogue: 0,0:04:09.25,0:04:11.56,JP,,0,0,0,,А, менің ойымша, мұғалім де мысықтарды жақсы көреді.
Dialogue: 0,0:04:12.12,0:04:13.99,JP,,0,0,0,,Қашан келіп қарауым керек?
Dialogue: 0,0:04:14.70,0:04:15.41,JP,,0,0,0,,Жарайды ма?
Dialogue: 0,0:04:16.17,0:04:18.98,JP,,0,0,0,,Мен білмей тұрып, барлық қаңғыбастар сонда тұратын.
Dialogue: 0,0:04:19.55,0:04:21.88,JP,,0,0,0,,Олай болса, өзіңізді еркін ұстаңыз
Dialogue: 0,0:04:22.08,0:04:24.16,JP,,0,0,0,,Кел, мысық
Dialogue: 0,0:04:26.59,0:04:30.28,JP,,0,0,0,,Сен адасқансың. Адамдарға байланбаңыз.
Dialogue: 0,0:04:30.42,0:04:34.56,JP,,0,0,0,,Алдымен айтыңызшы, бұл қозғалыспен не істеуім керек?
Dialogue: 0,0:04:35.03,0:04:36.56,JP,,0,0,0,,Осыны жеуге рұқсат етсеңіз
Dialogue: 0,0:04:37.55,0:04:40.83,JP,,0,0,0,,Түскі астан қалған қайнаған күріш, кел, ақ.
Dialogue: 0,0:04:43.04,0:04:44.12,JP,,0,0,0,,Көп адам келді
Dialogue: 0,0:04:44.47,0:04:45.81,JP,,0,0,0,,Енді сол сашими кетті
Dialogue: 0,0:04:46.16,0:04:48.81,JP,,0,0,0,,Түскі астан қалған тамақ, жиенімнің кешкі асы.
Dialogue: 0,0:04:50.07,0:04:51.29,JP,,0,0,0,,Көп адам келді
Dialogue: 0,0:04:52.98,0:04:55.14,JP,,0,0,0,,Сіз оны ақ деп атайсыз ба?
Dialogue: 0,0:04:55.38,0:04:58.65,JP,,0,0,0,,Маған қоңырау шалыңыз, бұл адасқан.
Dialogue: 0,0:04:59.38,0:05:02.52,JP,,0,0,0,,Дүние жүзінде мұндай затты үй мысығы деп атайды.
Dialogue: 0,0:05:03.85,0:05:05.17,JP,,0,0,0,,Мына жақта қырғауыл мысық
Dialogue: 0,0:05:06.79,0:05:07.95,JP,,0,0,0,,Қара кел
Dialogue: 0,0:05:08.71,0:05:09.56,JP,,0,0,0,,Бұл қырғауыл емес
Dialogue: 0,0:05:10.42,0:05:14.98,JP,,0,0,0,,Қаралары адамдармен ең тату, ал қалғандары ұялшақ.
Dialogue: 0,0:05:15.57,0:05:17.07,JP,,0,0,0,,Раджикомонның бұл түрі
Dialogue: 0,0:05:24.04,0:05:25.72,JP,,0,0,0,,Мен де мұғалімді құшақтаймын деп ойлаймын.
Dialogue: 0,0:05:26.05,0:05:27.92,JP,,0,0,0,,Иә, жақсы ма?
Dialogue: 0,0:05:27.97,0:05:29.92,JP,,0,0,0,,Мені ұстаңыз, өтінемін, сізді ұстауға рұқсат етіңіз
Dialogue: 0,0:05:30.02,0:05:30.53,JP,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:05:34.50,0:05:36.75,JP,,0,0,0,,Иә, ал, жиенімнің қолы ұстамайды.
Dialogue: 0,0:05:36.92,0:05:38.31,JP,,0,0,0,,Соны айтсаң да
Dialogue: 0,0:05:38.63,0:05:39.96,JP,,0,0,0,,Сүңгіп, оны ұстаңыз.
Dialogue: 0,0:05:40.35,0:05:42.10,JP,,0,0,0,,Оны екі қолыңызбен қатайтыңыз
Dialogue: 0,0:05:42.57,0:05:43.26,JP,,0,0,0,,Жарайды
Dialogue: 0,0:05:45.10,0:05:46.68,JP,,0,0,0,,Тұттым сені!
Dialogue: 0,0:05:48.15,0:05:51.74,JP,,0,0,0,,Бұл жерде ештеңе жоқ. Ол қаңғыбас болса да сүйкімді котенка.
Dialogue: 0,0:05:56.10,0:05:58.62,JP,,0,0,0,,Оны қатайтайық, Чуутару.
Dialogue: 0,0:05:58.75,0:06:00.31,JP,,0,0,0,,Нене Шиянакаё
Dialogue: 0,0:06:00.70,0:06:03.30,JP,,0,0,0,,Ұстаз, менің мойнымнан ұрдың.
Dialogue: 0,0:06:04.92,0:06:06.45,JP,,0,0,0,,Бұл не, қышиды ма?
Dialogue: 0,0:06:08.48,0:06:09.28,JP,,0,0,0,,Менің де көзім қышиды
Dialogue: 0,0:06:09.94,0:06:13.13,JP,,0,0,0,,Мұғалім: Сіздің мысыққа аллергияңыз бар шығар?
Dialogue: 0,0:06:13.71,0:06:14.90,JP,,0,0,0,,Мысықтың аллергиясы
Dialogue: 0,0:06:16.90,0:06:18.00,JP,,0,0,0,,Мысық
Dialogue: 0,0:06:18.04,0:06:18.99,JP,,0,0,0,,Жоқ, Киёши
Dialogue: 0,0:06:19.65,0:06:21.63,JP,,0,0,0,,Жануарларға қажетсіз жақындамаңыз
Dialogue: 0,0:06:22.55,0:06:23.92,JP,,0,0,0,,Оның қышығанын қаламайсыз.
Dialogue: 0,0:06:24.79,0:06:28.14,JP,,0,0,0,,Ауырып қалсаң да әкеңнің орнын баса алмайды.
Dialogue: 0,0:06:31.53,0:06:33.74,JP,,0,0,0,,Мен мысық ұстай аламын ба?
Dialogue: 0,0:06:34.65,0:06:37.24,JP,,0,0,0,,Сіз оны шынымен ұстамайынша білмейсіз.
Dialogue: 0,0:06:41.10,0:06:42.31,JP,,0,0,0,,Мені кешіріңіз.
Dialogue: 0,0:06:42.91,0:06:44.18,JP,,0,0,0,,Менеджер, қоңырау шалыңыз
Dialogue: 0,0:06:45.15,0:06:46.54,JP,,0,0,0,,Мұғалім
Dialogue: 0,0:06:46.80,0:06:49.22,JP,,0,0,0,,Мен Нанбашиге келдім Мен бірдеңе сатып алуға келдім
Dialogue: 0,0:06:49.39,0:06:51.31,JP,,0,0,0,,Балалар, сендер барлық жердесіңдер.
Dialogue: 0,0:06:52.15,0:06:55.00,JP,,0,0,0,,Ұстаз, менің мойныма дөңес болды.
Dialogue: 0,0:06:55.43,0:06:57.21,JP,,0,0,0,,Оны айтпа
Dialogue: 0,0:06:57.87,0:06:58.60,JP,,0,0,0,,Дүкен менеджері
Dialogue: 0,0:06:58.97,0:07:00.45,JP,,0,0,0,,Мен қарттардың кешіне бара жатырмын.
Dialogue: 0,0:07:01.46,0:07:03.49,JP,,0,0,0,,Егер сізде сатып алу керек болса, асықпаңыз.
Dialogue: 0,0:07:05.08,0:07:06.88,JP,,0,0,0,,Жоқ, мен телефонды қарызға алғым келді.
Dialogue: 0,0:07:07.65,0:07:09.58,JP,,0,0,0,,Мұғалім көп нәрсені білген
Dialogue: 0,0:07:10.02,0:07:10.70,JP,,0,0,0,,Акки
Dialogue: 0,0:07:10.94,0:07:12.35,JP,,0,0,0,,Иә, Акки
Dialogue: 0,0:07:12.85,0:07:13.68,JP,,0,0,0,,Бұл Акки.
Dialogue: 0,0:07:14.02,0:07:15.49,JP,,0,0,0,,Акки керемет
Dialogue: 0,0:07:15.76,0:07:18.94,JP,,0,0,0,,Сіз Мастер Такахаши сияқты ойындарда шынымен жақсысыз ба?
Dialogue: 0,0:07:19.94,0:07:21.43,JP,,0,0,0,,Такахаши деген кім?
Dialogue: 0,0:07:22.95,0:07:25.39,JP,,0,0,0,,Мастер Такахаши белгісіз
Dialogue: 0,0:07:25.45,0:07:27.68,JP,,0,0,0,,Не? Ол сондай атақты ма?
Dialogue: 0,0:07:28.18,0:07:29.38,JP,,0,0,0,,Киоген орындаушысы немесе бір нәрсе ме?
Dialogue: 0,0:07:30.03,0:07:33.02,JP,,0,0,0,,Мен ойын сарапшысымын. Бұл телефон қоңырауы.
Dialogue: 0,0:07:34.83,0:07:36.04,JP,,0,0,0,,Акки?
Dialogue: 0,0:07:37.59,0:07:39.88,JP,,0,0,0,,Маған бұл не деген қызық. Мен оны бір жерден көргендей сезінемін.
Dialogue: 0,0:07:42.40,0:07:43.46,JP,,0,0,0,,Таманың інісі?
Dialogue: 0,0:07:43.78,0:07:45.46,JP,,0,0,0,,Иә, бұл рас.
Dialogue: 0,0:07:45.60,0:07:48.41,JP,,0,0,0,,Уау, олар өте ұқсас. Олар клондар ма?
Dialogue: 0,0:07:48.55,0:07:50.46,JP,,0,0,0,,Тоқтаңыз. Олар бір-біріне ұқсамайды.
Dialogue: 0,0:07:50.51,0:07:53.13,JP,,0,0,0,,Жоқ, олар бір-біріне ұқсайды.Тұқым қуалаушылық ғажап.
Dialogue: 0,0:07:53.62,0:07:55.77,JP,,0,0,0,,Маған тез қоңырау шалыңыз.
Dialogue: 0,0:07:56.22,0:07:57.90,JP,,0,0,0,,Мен нені қатты жек көремін
Dialogue: 0,0:07:57.63,0:07:58.15,JP,,0,0,0,,Иә
Dialogue: 0,0:07:59.19,0:08:00.15,JP,,0,0,0,,Уау, қара
Dialogue: 0,0:08:00.48,0:08:01.92,JP,,0,0,0,,Бұл қара телефон.
Dialogue: 0,0:08:02.68,0:08:05.35,JP,,0,0,0,,Бұл не? Мен оны тек теледидардан көрдім.
Dialogue: 0,0:08:05.84,0:08:08.84,JP,,0,0,0,,Ұялы телефондарда камералар бар және сенсорлық панельдер арқылы басқарылатын заманда.
Dialogue: 0,0:08:08.87,0:08:09.80,JP,,0,0,0,,Қандай нәрсе
Dialogue: 0,0:08:11.85,0:08:13.19,JP,,0,0,0,,шошып кетті
Dialogue: 0,0:08:14.73,0:08:18.10,JP,,0,0,0,,Мен ойын ойнап жатырмын, сондықтан оны өз қалауыңыз бойынша пайдалана аласыз.
Dialogue: 0,0:08:19.56,0:08:20.24,JP,,0,0,0,,О
Dialogue: 0,0:08:21.73,0:08:25.15,JP,,0,0,0,,Мен маңызды қоңырау шалғалы жатырмын, сондықтан үндемеңіз.
Dialogue: 0,0:08:26.24,0:08:28.51,JP,,0,0,0,,Ум, нөл
Dialogue: 0,0:08:32.03,0:08:34.66,JP,,0,0,0,,Бұл не? Мен оны басқан кезде жауап жоқ.
Dialogue: 0,0:08:35.20,0:08:36.51,JP,,0,0,0,,Сынған жоқ па?
Dialogue: 0,0:08:37.14,0:08:40.57,JP,,0,0,0,,Жарайды, бассаң да жұмыс істемейді. Оны айналдыру керек.
Dialogue: 0,0:08:40.91,0:08:42.07,JP,,0,0,0,,Мені сүюге тиіс еді! Мені сүюге тиіс!
Dialogue: 0,0:08:42.52,0:08:44.70,JP,,0,0,0,,Бұл қара телефон қиын және бұрылу қиын.
Dialogue: 0,0:08:44.99,0:08:46.46,JP,,0,0,0,,Телефонда оны кінәлады.
Dialogue: 0,0:08:46.78,0:08:47.59,JP,,0,0,0,,Міне.
Dialogue: 0,0:08:49.04,0:08:50.10,JP,,0,0,0,,Қараңызшы, бұрылды.
Dialogue: 0,0:08:50.19,0:08:51.49,JP,,0,0,0,,Ол айналады.
Dialogue: 0,0:08:54.86,0:08:56.13,JP,,0,0,0,,Саусағыңызды көтере аласыз ба?
Dialogue: 0,0:08:56.16,0:08:57.72,JP,,0,0,0,,Мен мұны көп білемін.
Dialogue: 0,0:08:58.06,0:09:00.95,JP,,0,0,0,,Телефонды оған дейін алмасаңыз, қосыла алмайсыз.
Dialogue: 0,0:09:03.25,0:09:07.12,JP,,0,0,0,,Маған нөміріңізді беріңіз, мен оны теремін.
Dialogue: 0,0:09:07.18,0:09:09.33,JP,,0,0,0,,Жанашыр болсаң ақша бер.
Dialogue: 0,0:09:13.63,0:09:14.69,JP,,0,0,0,,(Курокири) Шигараки, күткен нәтижеңді алдың ба?
Dialogue: 0,0:09:14.52,0:09:16.56,JP,,0,0,0,,Тыныш бол, мен саған телефон соғамын.
Dialogue: 0,0:09:19.31,0:09:19.77,JP,,0,0,0,,Кавафуджи
Dialogue: 0,0:09:20.15,0:09:22.90,JP,,0,0,0,,Ол жақта жанды. Мақсаты не?
Dialogue: 0,0:09:23.58,0:09:27.37,JP,,0,0,0,,Менің компьютерім істен шықты, сондықтан мен жаңа жинақ алуды шештім.
Dialogue: 0,0:09:28.47,0:09:30.23,JP,,0,0,0,,Мен онсыз жұмыс істей алмаймын.
Dialogue: 0,0:09:31.15,0:09:32.76,JP,,0,0,0,,That's right Handa
Dialogue: 0,0:09:33.23,0:09:36.04,JP,,0,0,0,,Жұмыстан біраз уақыт алу керек деп ойлаймын.
Dialogue: 0,0:09:36.84,0:09:37.77,JP,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:09:37.91,0:09:40.76,JP,,0,0,0,,Мейкайн көрмесінің күзде өтетін мерзімі бар.
Dialogue: 0,0:09:41.46,0:09:43.32,JP,,0,0,0,,Бұл жұмыс істейтін уақыт емес.
Dialogue: 0,0:09:44.26,0:09:46.56,JP,,0,0,0,,Мен саған дос ретінде қамқорлық жасаймын деп ойладым.
Dialogue: 0,0:09:48.31,0:09:48.97,JP,,0,0,0,,Date
Dialogue: 0,0:09:49.18,0:09:50.44,JP,,0,0,0,,10 қыркүйек
Dialogue: 0,0:09:50.79,0:09:54.29,JP,,0,0,0,,Жақсы, егер ұнамаса, бұл жолы өткізіп жіберуге болады.
Dialogue: 0,0:09:54.94,0:09:56.20,JP,,0,0,0,,Егер сіз бұл туралы жайбарақат ойласаңыз ...
Dialogue: 0,0:09:56.30,0:09:58.04,JP,,0,0,0,,Мен айтайын деп отырған жазба материалдарын жинаңыз.
Dialogue: 0,0:10:00.05,0:10:03.04,JP,,0,0,0,,Бұл жолы бас жүлдені күтуге болады деп ойлаймын.
Dialogue: 0,0:10:04.12,0:10:04.93,JP,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:10:05.37,0:10:07.42,JP,,0,0,0,,Қазір әлі қараңғы болса да
Dialogue: 0,0:10:07.73,0:10:10.25,JP,,0,0,0,,Бір күні мен міндетті түрде жарық табамын
Dialogue: 0,0:10:10.70,0:10:11.41,JP,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:10:18.10,0:10:20.41,JP,,0,0,0,,Бір минут телефонмен сөйлесу қанша тұрады?
Dialogue: 0,0:10:21.94,0:10:23.65,JP,,0,0,0,,Қазір әлі қараңғы болса да
Dialogue: 0,0:10:24.18,0:10:26.04,JP,,0,0,0,,Сіз әрқашан жарық табасыз
Dialogue: 0,0:10:28.21,0:10:30.39,JP,,0,0,0,,Мен сондай қорқынышты сөздер айттым
Dialogue: 0,0:10:30.72,0:10:34.36,JP,,0,0,0,,Мен орта мектепте оқып жүргенімде сол қолымда бірдеңе болды.
Dialogue: 0,0:10:35.23,0:10:37.07,JP,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:10:37.92,0:10:40.58,JP,,0,0,0,,Біз 5 минуттай сөйлескендіктен, мен 50 иен төлей аламын ба?
Dialogue: 0,0:10:41.06,0:10:43.17,JP,,0,0,0,,Телефон төлемдері 10 иенді құрайтын біркелкі тариф болып табылады.
Dialogue: 0,0:10:43.59,0:10:45.67,JP,,0,0,0,,Eh, is that okay?
Dialogue: 0,0:10:46.26,0:10:48.38,JP,,0,0,0,,Әже тегін дейді.
Dialogue: 0,0:10:48.79,0:10:50.58,JP,,0,0,0,,Барлығы он иен қалдырады.
Dialogue: 0,0:10:51.51,0:10:52.88,JP,,0,0,0,,Okay, ten yen.
Dialogue: 0,0:10:54.77,0:10:56.49,JP,,0,0,0,,Иә, бұл 40 иен.
Dialogue: 0,0:10:57.20,0:10:57.66,JP,,0,0,0,,Болу
Dialogue: 0,0:10:57.96,0:10:58.64,JP,,0,0,0,,Иә
Dialogue: 0,0:10:59.28,0:11:00.00,JP,,0,0,0,,Хинамо
Dialogue: 0,0:11:02.83,0:11:03.99,JP,,0,0,0,,Кешіріңіз, кешіріңіз.
Dialogue: 0,0:11:04.09,0:11:05.39,JP,,0,0,0,,Look, Akkimo
Dialogue: 0,0:11:06.52,0:11:07.72,JP,,0,0,0,,Рахмет
Dialogue: 0,0:11:09.12,0:11:12.21,JP,,0,0,0,,Қараңдаршы, шар пайда болды.
Dialogue: 0,0:11:12.28,0:11:14.49,JP,,0,0,0,,Әй, қолыңа ұстама, лас екен.
Dialogue: 0,0:11:15.67,0:11:18.16,JP,,0,0,0,,Хина, сен не істеп жатырсың?
Dialogue: 0,0:11:21.44,0:11:25.44,JP,,0,0,0,,Сіз каллиграф болғандықтан, сіз ресми түрде әрекет етесіз деп ойладым.
Dialogue: 0,0:11:25.73,0:11:28.23,JP,,0,0,0,,Сіз оларды шынымен кездестірмейінше түсіне алмайсыз.
Dialogue: 0,0:11:28.68,0:11:30.67,JP,,0,0,0,,Әркім айтқандай, ол біртүрлі адам.
Dialogue: 0,0:11:31.91,0:11:32.85,JP,,0,0,0,,Strange person
Dialogue: 0,0:11:33.85,0:11:35.67,JP,,0,0,0,,Келесі жолы шыға аламын ба?
Dialogue: 0,0:11:35.83,0:11:38.94,JP,,0,0,0,,Бұл барлық ағайындылар үйді басып алуға келеді дегенді білдіре ме?
Dialogue: 0,0:11:38.96,0:11:39.87,JP,,0,0,0,,Қош бол
Dialogue: 0,0:11:39.87,0:11:40.73,JP,,0,0,0,,Сіз жауап бересіз.
Dialogue: 0,0:11:46.18,0:11:48.49,JP,,0,0,0,,Білем, бұл жақсы емес.
Dialogue: 0,0:11:51.33,0:11:52.68,JP,,0,0,0,,Ештеңе жазбаңыз
Dialogue: 0,0:11:56.13,0:11:58.78,JP,,0,0,0,,Мүмкін бұл жұмысты тоқтатып, кітап көрмесіне шоғырланғандықтан шығар.
Dialogue: 0,0:11:59.19,0:12:01.79,JP,,0,0,0,,Бір ғана каллиграфияға артылған жүк үлкен сияқты.
Dialogue: 0,0:12:02.56,0:12:05.55,JP,,0,0,0,,Ойымды өзгертпесем, әйтеуір жазып бітірсем, мерзімі өтіп кетеді.
Dialogue: 0,0:12:07.35,0:12:09.44,JP,,0,0,0,,Бұл Намба Шоттока
Dialogue: 0,0:12:09.69,0:12:11.96,JP,,0,0,0,,Оны қайтару үшін қиындықты шешіңіз
Dialogue: 0,0:12:12.75,0:12:14.66,JP,,0,0,0,,Кешіріңіз, мен ойладым.
Dialogue: 0,0:12:14.99,0:12:16.76,JP,,0,0,0,,Ойлар
Dialogue: 0,0:12:17.69,0:12:20.93,JP,,0,0,0,,Осы себепті сізді кешіреді деп ойлайсыз ба?
Dialogue: 0,0:12:21.33,0:12:22.93,JP,,0,0,0,,Коньой Икача
Dialogue: 0,0:12:23.09,0:12:24.17,JP,,0,0,0,,Якуза
Dialogue: 0,0:12:26.30,0:12:28.24,JP,,0,0,0,,Жарайды, мен оны көре алмаймын.
Dialogue: 0,0:12:28.68,0:12:30.10,JP,,0,0,0,,Мен жақында көшіп келдім...
Dialogue: 0,0:12:31.26,0:12:32.73,JP,,0,0,0,,Каллиграфия пәнінің мұғалімі?
Dialogue: 0,0:12:32.93,0:12:34.55,JP,,0,0,0,,Э? Иә.
Dialogue: 0,0:12:34.76,0:12:38.72,JP,,0,0,0,,Бұл бейтаныс адамдарды тыңдайтын біртүрлі жер ме?
Dialogue: 0,0:12:39.06,0:12:39.81,JP,,0,0,0,,Strange person
Dialogue: 0,0:12:41.39,0:12:45.25,JP,,0,0,0,,Мұғалімнен бір сәт сұрамаңыз, тоқтаңыз.
Dialogue: 0,0:12:47.60,0:12:49.14,JP,,0,0,0,,Әй, қайда бара жатырсың?
Dialogue: 0,0:12:49.14,0:12:51.14,JP,,0,0,0,,Йокакен Йокакен
Dialogue: 0,0:12:51.98,0:12:53.25,JP,,0,0,0,,Мен велосипедімді ұмытып қалдым.
Dialogue: 0,0:12:53.33,0:12:56.43,JP,,0,0,0,,Уау, мені күйзеліске түскен қарт ұстады.
Dialogue: 0,0:12:58.12,0:13:01.43,JP,,0,0,0,,Сізге көп рахмет, профессор.
Dialogue: 0,0:13:01.76,0:13:03.51,JP,,0,0,0,,`` Пан'' деп жазыңыз.
Dialogue: 0,0:13:04.87,0:13:07.50,JP,,0,0,0,,Әкемнің араласуы бір сәт болды.
Dialogue: 0,0:13:08.00,0:13:12.08,JP,,0,0,0,,Мен сіздермен мұғалім туралы сөйлескен кезде мен сізден кеменің атын жазуыңызды өтіндім.
Dialogue: 0,0:13:12.51,0:13:13.91,JP,,0,0,0,,Сіздің ата-анаңыз?
Dialogue: 0,0:13:14.44,0:13:16.45,JP,,0,0,0,,Бәрінен бірден бас тарттым.
Dialogue: 0,0:13:18.10,0:13:19.86,JP,,0,0,0,,Көңілді болыңыз
Dialogue: 0,0:13:20.52,0:13:22.61,JP,,0,0,0,,Сәтсіздікке жол бермейтін атмосфера бар.
Dialogue: 0,0:13:23.19,0:13:25.35,JP,,0,0,0,,Әкем ашуланса, оны қорқытпа.
Dialogue: 0,0:13:26.06,0:13:26.92,JP,,0,0,0,,Кеме атауы
Dialogue: 0,0:13:27.09,0:13:28.61,JP,,0,0,0,,Мивамару әдет-ғұрып бойынша?
Dialogue: 0,0:13:29.00,0:13:31.65,JP,,0,0,0,,Әкем алкоголь дүкенінен хобби ретінде сатып алған қайық.
Dialogue: 0,0:13:31.88,0:13:33.70,JP,,0,0,0,,Менің атым Касанчи
Dialogue: 0,0:13:36.70,0:13:37.86,JP,,0,0,0,,Қандай керемет сезім.
Dialogue: 0,0:13:38.58,0:13:41.65,JP,,0,0,0,,Анамның атымды қойғанына қуаныштымын.
Dialogue: 0,0:13:42.36,0:13:44.06,JP,,0,0,0,,Юигадокусон-чан
Dialogue: 0,0:13:44.91,0:13:47.12,JP,,0,0,0,,Меніңше, бұл ағамның құдай екенін білдіреді.
Dialogue: 0,0:13:48.21,0:13:48.89,JP,,0,0,0,,Өте қиын болды… Өтінемін, мені жалғыз қалдыр.
Dialogue: 0,0:13:48.89,0:13:50.08,JP,,0,0,0,,Ата-ана мен бала.
Dialogue: 0,0:13:52.14,0:13:55.24,JP,,0,0,0,,Бес канжи таңбасы? Бұл өте көп.
Dialogue: 0,0:13:55.88,0:13:58.60,JP,,0,0,0,,Корпус қисық болғандықтан тепе-теңдікті сақтау қиын.
Dialogue: 0,0:13:59.55,0:14:01.41,JP,,0,0,0,,Қолданылатын құралдар да әдеттегіден өзгеше.
Dialogue: 0,0:14:02.17,0:14:04.67,JP,,0,0,0,,Қарттың қысымын алып тастасаң да,
Dialogue: 0,0:14:04.94,0:14:06.63,JP,,0,0,0,,Сәтсіздік мүлдем мүмкін емес
Dialogue: 0,0:14:08.07,0:14:08.97,JP,,0,0,0,,Бояу немесе
Dialogue: 0,0:14:16.53,0:14:18.40,JP,,0,0,0,,Бояу қолдарым еріп барады.
Dialogue: 0,0:14:19.72,0:14:21.46,JP,,0,0,0,,Жуу
Dialogue: 0,0:14:23.81,0:14:27.22,JP,,0,0,0,,Маған нобай керек, үйге барып жазып берейін.
Dialogue: 0,0:14:28.47,0:14:31.47,JP,,0,0,0,,Алдымен қағазға жазылған әріптерді қиып алу.
Dialogue: 0,0:14:32.29,0:14:34.11,JP,,0,0,0,,Оны бояу
Dialogue: 0,0:14:34.14,0:14:35.76,JP,,0,0,0,,Күтіңіз, күтіңіз, ұстаз.
Dialogue: 0,0:14:35.98,0:14:38.15,JP,,0,0,0,,Бұл кемедегі металл қаңылтыр цехынан еш айырмашылығы жоқ.
Dialogue: 0,0:14:38.46,0:14:40.84,JP,,0,0,0,,Өзіңіздің түпнұсқа кемеңізді қалайсыз ба?
Dialogue: 0,0:14:41.18,0:14:44.48,JP,,0,0,0,,Айтсаңыз да, бұл әрқашан қолданбайтын құрал.
Dialogue: 0,0:14:44.84,0:14:46.80,JP,,0,0,0,,Қағаздан басқа нәрсеге жазу
Dialogue: 0,0:14:47.28,0:14:49.68,JP,,0,0,0,,Дұрыс қайық алғыңыз келсе, кәсіпқой жалдаңыз.
Dialogue: 0,0:14:50.48,0:14:51.36,JP,,0,0,0,,Сонымен не?
Dialogue: 0,0:14:51.57,0:14:55.59,JP,,0,0,0,,Жаппай шығарылған, ұсқынсыз кемеге отыруым мүмкін емес.
Dialogue: 0,0:14:55.70,0:14:56.82,JP,,0,0,0,,Оны жібермеуім керек еді....
Dialogue: 0,0:14:57.04,0:14:59.27,JP,,0,0,0,,Мен сәтсіздікке ұшырасам, ұят болар еді.
Dialogue: 0,0:14:59.40,0:15:01.27,JP,,0,0,0,,Менің ойымша, мұғалім сәтсіздікке ұшырайды.
Dialogue: 0,0:15:01.74,0:15:05.22,JP,,0,0,0,,Жоқ, мен сәтсіздікке ұшырамаймын, бірақ бәрібір.
Dialogue: 0,0:15:05.61,0:15:09.23,JP,,0,0,0,,Миллионнан бір болса, алаңдаудың қажеті жоқ. Тек жазып алыңыз.
Dialogue: 0,0:15:09.56,0:15:10.92,JP,,0,0,0,,Ертең таңертең иесінің қалтасына тығып қояйын деп едім.
Dialogue: 0,0:15:11.35,0:15:13.73,JP,,0,0,0,,Кәсіби жұмыстан бас тартуға бола ма?
Dialogue: 0,0:15:14.44,0:15:16.26,JP,,0,0,0,,Бұл дұрыс емес нәрсеге байланысты.
Dialogue: 0,0:15:16.85,0:15:20.05,JP,,0,0,0,,Мен жай ғана мәтіндік процессорға терген шатастырылған әріптерді жапсырдым да, жолға шықтым.
Dialogue: 0,0:15:20.37,0:15:22.32,JP,,0,0,0,,Мен Наруниден жазғанын қалаймын.
Dialogue: 0,0:15:22.36,0:15:23.29,JP,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:15:23.36,0:15:25.17,JP,,0,0,0,,Иә, бәрі осы.
Dialogue: 0,0:15:25.41,0:15:28.80,JP,,0,0,0,,Жай ғана кеме, құтқару кемесі, не керек?
Dialogue: 0,0:15:29.91,0:15:32.14,JP,,0,0,0,,Әкемнің ішімдік әкелетін уақыты келді.
Dialogue: 0,0:15:32.37,0:15:33.77,JP,,0,0,0,,Мұғалім маған дұрыс жазуды тапсырды.
Dialogue: 0,0:15:33.77,0:15:35.03,JP,,0,0,0,,Мен не айтуым керек?
Dialogue: 0,0:15:35.20,0:15:36.14,JP,,0,0,0,,Тиісті
Dialogue: 0,0:15:36.35,0:15:37.59,JP,,0,0,0,,Әдеттегідей
Dialogue: 0,0:15:37.84,0:15:40.63,JP,,0,0,0,,Ура, ішімдік сататын дүкен - ішімдік сататын дүкеннің жұмысы.
Dialogue: 0,0:15:42.40,0:15:44.48,JP,,0,0,0,,Әдеттегідей не?
Dialogue: 0,0:15:45.61,0:15:46.88,JP,,0,0,0,,Әлгі якуза қарт
Dialogue: 0,0:15:47.09,0:15:48.76,JP,,0,0,0,,Толығымен итерілген
Dialogue: 0,0:15:49.69,0:15:53.31,JP,,0,0,0,,Бірақ мен біреу олай десе, кері шегінетін адам емеспін.
Dialogue: 0,0:15:53.68,0:15:55.66,JP,,0,0,0,,Жылап тұрып алғыс айт.
Dialogue: 0,0:15:57.96,0:16:00.80,JP,,0,0,0,,Осыны айтып, мен әлі де бұл қылқаламға үйренуім керек.
Dialogue: 0,0:16:01.23,0:16:02.69,JP,,0,0,0,,Мұғалім
Dialogue: 0,0:16:02.75,0:16:05.31,JP,,0,0,0,,Бояу жақсы кетпейді.
Dialogue: 0,0:16:05.31,0:16:07.17,JP,,0,0,0,,Қолдарым еріп барады
Dialogue: 0,0:16:07.17,0:16:09.46,JP,,0,0,0,,Жоқ, қолдарың ерімейді, уайымдама.
Dialogue: 0,0:16:10.07,0:16:12.86,JP,,0,0,0,,Оның орнына жазуға болатын нәрсе бар ма?
Dialogue: 0,0:16:13.06,0:16:16.38,JP,,0,0,0,,Мұғалім, мұнда көптеген тақталар бар.
Dialogue: 0,0:16:18.20,0:16:20.17,JP,,0,0,0,,Егер бұл сізге қажет болса, үлгіні жазып көруге болады.
Dialogue: 0,0:16:20.74,0:16:21.61,JP,,0,0,0,,Бәрі жақсы, Буккирати
Dialogue: 0,0:16:24.46,0:16:25.97,JP,,0,0,0,,Олардың есімдері қалай аталады?
Dialogue: 0,0:16:30.88,0:16:32.25,JP,,0,0,0,,Сіз таңқаларлықтай жаза аласыз.
Dialogue: 0,0:16:32.56,0:16:33.66,JP,,0,0,0,,Наруды да жаздыңыз ба?
Dialogue: 0,0:16:33.81,0:16:35.05,JP,,0,0,0,,Бұл жұмыс
Dialogue: 0,0:16:35.59,0:16:36.29,JP,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:16:41.35,0:16:42.97,JP,,0,0,0,,Мен бұл қылқаламға көп үйреніп қалдым.
Dialogue: 0,0:16:43.96,0:16:46.67,JP,,0,0,0,,Бірақ жүрегімнің үні шықпайды.
Dialogue: 0,0:16:47.24,0:16:49.34,JP,,0,0,0,,Мен шынымен жақсы қолжазба жаза алатындай сезінемін.
Dialogue: 0,0:16:54.37,0:16:54.80,JP,,0,0,0,,Кеттік
Dialogue: 0,0:16:57.67,0:17:01.38,JP,,0,0,0,,Ойланып қарасам, корпустың домалақтығын не істерімді ойламаппын.
Dialogue: 0,0:17:01.90,0:17:04.72,JP,,0,0,0,,Бұл қорқынышты. Осылай жалғастыра берсек, сәтсіздікке ұшыраймыз.
Dialogue: 0,0:17:07.37,0:17:08.48,JP,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,0:17:08.86,0:17:12.20,JP,,0,0,0,,Бірақ менің мойным ауырады. Жақсы болды, бірақ менің мойным ауырады.
Dialogue: 0,0:17:12.66,0:17:14.34,JP,,0,0,0,,Мен корпусты тексеруді ұмытып кетіппін.
Dialogue: 0,0:17:14.82,0:17:16.69,JP,,0,0,0,,Мен сәтсіздікке ұшырадым, қарғыс.
Dialogue: 0,0:17:17.31,0:17:19.21,JP,,0,0,0,,Жарайды, бұл жақсы.
Dialogue: 0,0:17:21.39,0:17:22.00,JP,,0,0,0,,Оны итермеңіз
Dialogue: 0,0:17:22.37,0:17:23.41,JP,,0,0,0,,Ештеңе
Dialogue: 0,0:17:24.88,0:17:26.83,JP,,0,0,0,,Неге?
Dialogue: 0,0:17:26.85,0:17:28.69,JP,,0,0,0,,Қаншама айғақтар жазсам да.
Dialogue: 0,0:17:29.09,0:17:32.85,JP,,0,0,0,,Қылқалам туралы бірдеңе айтпас бұрын, ақ корпусқа жазудан қорқамын.
Dialogue: 0,0:17:33.26,0:17:35.40,JP,,0,0,0,,Мен сәтсіздікке ұшырамаймын ба?
Dialogue: 0,0:17:37.24,0:17:38.29,JP,,0,0,0,,Қауіпті Қауіпті
Dialogue: 0,0:17:38.44,0:17:39.70,JP,,0,0,0,,Жарайды, сэр.
Dialogue: 0,0:17:40.31,0:17:42.17,JP,,0,0,0,,Тез жүр, Мива, кел!
Dialogue: 0,0:17:42.40,0:17:45.14,JP,,0,0,0,,Бұл өте қатты және алаңдатады, сондықтан кетіңіз.
Dialogue: 0,0:17:45.37,0:17:48.08,JP,,0,0,0,,Ей, енді оны қаламаймын, қорқамын...
Dialogue: 0,0:17:49.58,0:17:50.32,JP,,0,0,0,,Ичита
Dialogue: 0,0:17:52.07,0:17:53.99,JP,,0,0,0,,Тыныштан, тыныштан.
Dialogue: 0,0:17:54.13,0:17:55.94,JP,,0,0,0,,Әрқашан қысым болған.
Dialogue: 0,0:17:56.59,0:17:58.66,JP,,0,0,0,,Жақсы қолжазбаны дамыту үшін біраз уақыт қажет болды, бірақ
Dialogue: 0,0:17:58.90,0:18:00.66,JP,,0,0,0,,Шешетін уақыт келді.
Dialogue: 0,0:18:02.66,0:18:03.59,JP,,0,0,0,,Сол кездегідей
Dialogue: 0,0:18:11.10,0:18:12.46,JP,,0,0,0,,Бірінші болыңыз
Dialogue: 0,0:18:14.68,0:18:16.29,JP,,0,0,0,,Жарайды, мен де істеймін.
Dialogue: 0,0:18:16.33,0:18:17.27,JP,,0,0,0,,Онмо Онмо
Dialogue: 0,0:18:19.55,0:18:20.22,JP,,0,0,0,,Ол адамзат үшін баға жетпес мүмкіндік
Dialogue: 0,0:18:20.24,0:18:21.97,JP,,0,0,0,,Брацтар Братс Брацтар
Dialogue: 0,0:18:22.35,0:18:25.56,JP,,0,0,0,,Маған не істеп жатырсың, оны лас етіп?
Dialogue: 0,0:18:25.69,0:18:27.95,JP,,0,0,0,,Өйткені мұғалім енді ұнатпайтынын айтты.
Dialogue: 0,0:18:28.05,0:18:30.14,JP,,0,0,0,,Бұл сіздің айтқыңыз келгені емес, солай ма?
Dialogue: 0,0:18:30.92,0:18:32.73,JP,,0,0,0,,Әзірге қол ізін өшіруім керек.
Dialogue: 0,0:18:36.33,0:18:38.62,JP,,0,0,0,,Уау, шашыранды
Dialogue: 0,0:18:38.84,0:18:40.47,JP,,0,0,0,,Мен де күте тұрыңыз.
Dialogue: 0,0:18:40.85,0:18:43.84,JP,,0,0,0,,Егер сіз тым қатал болмасаңыз, сіз есепшотты алдай алмайсыз.
Dialogue: 0,0:18:44.12,0:18:46.02,JP,,0,0,0,,Ыдыста сия бар.
Dialogue: 0,0:18:47.14,0:18:49.25,JP,,0,0,0,,Хина киімін ластайды, сондықтан одан аулақ жүр.
Dialogue: 0,0:18:50.42,0:18:53.13,JP,,0,0,0,,Кента қағазы бар сияны тамшылап тұрған жерге басып тұруы керек.
Dialogue: 0,0:18:53.23,0:18:53.84,JP,,0,0,0,,...
Dialogue: 0,0:18:55.99,0:18:57.06,JP,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:18:57.80,0:18:59.55,JP,,0,0,0,,Мен дәл қазір қатты қорықтым
Dialogue: 0,0:18:59.95,0:19:01.55,JP,,0,0,0,,Қысым толығымен жойылды.
Dialogue: 0,0:19:01.83,0:19:03.23,JP,,0,0,0,,Қылқаламның штрихы жеңіл.
Dialogue: 0,0:19:04.81,0:19:08.42,JP,,0,0,0,,Кішкентай ғана қолдың ізі бар, бар болғаны.
Dialogue: 0,0:19:09.75,0:19:11.30,JP,,0,0,0,,Тезірек, бояуымыз жетпейді.
Dialogue: 0,0:19:12.68,0:19:14.81,JP,,0,0,0,,Бұл өте қызықты ма, жоқ па, соған байланысты.
Dialogue: 0,0:19:14.99,0:19:16.35,JP,,0,0,0,,Әрқашан солай
Dialogue: 0,0:19:17.01,0:19:20.88,JP,,0,0,0,,Қала бастығы күлді де, жұмыстың жақындап қалғанын айтты.
Dialogue: 0,0:19:21.32,0:19:23.00,JP,,0,0,0,,Мен мұны істегенімді қалаймын.
Dialogue: 0,0:19:25.15,0:19:27.56,JP,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:19:27.83,0:19:29.12,JP,,0,0,0,,Жоқ, осыншама
Dialogue: 0,0:19:29.65,0:19:32.17,JP,,0,0,0,,Дәлірек айтқанда, бұл сіз бұрын алғаныңыз.
Dialogue: 0,0:19:32.61,0:19:34.26,JP,,0,0,0,,Сіз оны қалай жейсіз?
Dialogue: 0,0:19:34.50,0:19:37.01,JP,,0,0,0,,Жоқ, сен жақсы жұмыс істедің.
Dialogue: 0,0:19:37.17,0:19:39.73,JP,,0,0,0,,Су тасқыны келгенде, мен Кяны шақырамын. Бұл сондай сұмдық.
Dialogue: 0,0:19:39.95,0:19:42.37,JP,,0,0,0,,Мен сенен мұндай бақытты болады деп күтпеп едім.
Dialogue: 0,0:19:42.92,0:19:44.97,JP,,0,0,0,,Мұғалімнен сұрағаныма қуаныштымын.
Dialogue: 0,0:19:45.84,0:19:48.40,JP,,0,0,0,,Сіз ойлағаннан да иісі көп кеме
Dialogue: 0,0:19:49.88,0:19:50.79,JP,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:19:51.35,0:19:52.63,JP,,0,0,0,,Сол жерде болатын қол
Dialogue: 0,0:19:54.18,0:19:56.40,JP,,0,0,0,,Кемеде жазу қиын.
Dialogue: 0,0:19:56.91,0:19:58.28,JP,,0,0,0,,Бұл жақсы тәжірибе болды.
Dialogue: 0,0:19:59.28,0:20:03.22,JP,,0,0,0,,Мен ақ қағазды бояуды ойлау оңай екенін де білдім.
Dialogue: 0,0:20:03.95,0:20:07.91,JP,,0,0,0,,Маған сеніп тапсырғаныңызға көп рахмет.
Dialogue: 0,0:20:08.16,0:20:09.91,JP,,0,0,0,,Оокинге қош келдіңіз
Dialogue: 0,0:20:10.41,0:20:12.03,JP,,0,0,0,,Одан басқа
Dialogue: 0,0:20:12.43,0:20:15.86,JP,,0,0,0,,Жиенімнің үстінен арыз-шағымға толы былық.
Dialogue: 0,0:20:16.68,0:20:17.58,JP,,0,0,0,,Кенет не болды?
Dialogue: 0,0:20:20.50,0:20:21.42,JP,,0,0,0,,Жоқ, солай.
Dialogue: 0,0:20:21.68,0:20:22.78,JP,,0,0,0,,Дөңмай мұғалім
Dialogue: 0,0:20:23.72,0:20:27.14,JP,,0,0,0,,Сонымен қатар өзеннен өткенде қолданылатын тақтайша
Dialogue: 0,0:20:27.58,0:20:29.67,JP,,0,0,0,,Біртүрлі нәрсе бар ма?
Dialogue: 0,0:20:29.91,0:20:32.99,JP,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:20:33.06,0:20:34.89,JP,,0,0,0,,Қашып кеткен ересек адам
Dialogue: 0,0:20:34.92,0:20:36.72,JP,,0,0,0,,Оның үстіне Мено - очичоруши.
Dialogue: 0,0:20:36.99,0:20:38.91,JP,,0,0,0,,Мұғалім Меноха
Dialogue: 0,0:20:38.91,0:20:39.74,JP,,0,0,0,,Меноха
Dialogue: 0,0:20:39.74,0:20:41.00,JP,,0,0,0,,Меноха
Dialogue: 0,0:20:41.04,0:20:43.75,JP,,0,0,0,,Мұғалім
Dialogue: 0,0:22:16.54,0:22:17.87,JP,,0,0,0,,Қоқыс бар.
Dialogue: 0,0:22:18.36,0:22:21.39,JP,,0,0,0,,Иә, балық аулауға келген жігіт оны тастағысы келді.
Dialogue: 0,0:22:21.66,0:22:22.71,JP,,0,0,0,,Абайлаңыз
Dialogue: 0,0:22:23.59,0:22:26.05,JP,,0,0,0,,Әдемі сөз тіркесі бар белгіні қоюға қалай болады?
Dialogue: 0,0:22:26.95,0:22:29.99,JP,,0,0,0,,Сен лақтырған қоқыс үшін жер бітеді.
Dialogue: 0,0:22:30.32,0:22:32.85,JP,,0,0,0,,Масштабтың үлкендігі сонша, ол шынайы емес.
Dialogue: 0,0:22:33.40,0:22:35.20,JP,,0,0,0,,Қоқысыңызды тастамаңыз.
Dialogue: 0,0:22:35.33,0:22:36.95,JP,,0,0,0,,Басқа адамның мінезін пайдалану
Dialogue: 0,0:22:37.59,0:22:38.85,JP,,0,0,0,,Лақтырсаң өлесің.
Dialogue: 0,0:22:38.88,0:22:40.00,JP,,0,0,0,,Аяқтаудың төмен деңгейі
Dialogue: 0,0:22:40.38,0:22:42.35,JP,,0,0,0,,Онда сіз бұл туралы ойлануыңыз керек.
Dialogue: 0,0:22:43.92,0:22:46.71,JP,,0,0,0,,Қоқысты лақтырғанда, басқалар көрмейтін заттар жұқтырады.
Dialogue: 0,0:22:47.26,0:22:48.35,JP,,0,0,0,,Бұл лас әзіл ба?
Dialogue: 0,0:22:49.85,0:22:55.85,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
