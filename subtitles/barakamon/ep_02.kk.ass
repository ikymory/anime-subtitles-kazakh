Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:08.01,Default,,0,0,0,,Аудармасы: шулы 3 3 3 Байыпты және аздап оқы
Dialogue: 0,0:00:09.05,0:00:10.08,Default,,0,0,0,,Ешкім түсінбейді
Dialogue: 0,0:00:12.00,0:00:13.07,Default,,0,0,0,,Мен биыл емтихан тапсыруым керек.
Dialogue: 0,0:00:13.09,0:00:15.04,Default,,0,0,0,,Кішкене тырысыңыз
Dialogue: 0,0:00:15.09,0:00:17.09,Default,,0,0,0,,Тағы біраз жүгіріңіз
Dialogue: 0,0:00:18.05,0:00:21.03,Default,,0,0,0,,Әнді қаттырақ айтыңыз
Dialogue: 0,0:00:23.04,0:00:25.01,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:00:25.02,0:00:27.02,Default,,0,0,0,,Көңіліңді көтер, Хироси
Dialogue: 0,0:00:27.02,0:00:29.05,Default,,0,0,0,,Ой, рұқсатсыз кірме.
Dialogue: 0,0:00:29.07,0:00:31.07,Default,,0,0,0,,3 те жақсы.
Dialogue: 0,0:00:31.09,0:00:34.05,Default,,0,0,0,,Тіпті менің әкем де 3 жаста болған.
Dialogue: 0,0:00:34.05,0:00:38.00,Default,,0,0,0,,Дұрыс, сіз ортанақтылыққа бет алдыңыз.
Dialogue: 0,0:00:38.00,0:00:40.06,Default,,0,0,0,,Қарапайым болса да, даралық.
Dialogue: 0,0:00:43.00,0:00:44.08,Default,,0,0,0,,Егер сізде бір іс болса, кетіңіз.
Dialogue: 0,0:00:46.00,0:00:48.03,Default,,0,0,0,,Менің бір ісім бар, осында барғым келеді.
Dialogue: 0,0:00:48.05,0:00:52.03,Default,,0,0,0,,Иә, мұғалімге шампон әкеліңіз.
Dialogue: 0,0:00:57.01,0:01:00.06,Default,,0,0,0,,Білесің бе, бұл туралы аздап ойлану керек шығар.
Dialogue: 0,0:01:01.01,0:01:03.09,Default,,0,0,0,,Бейтаныс адамдарға тамақ пісірудің де қажеті жоқ.
Dialogue: 0,0:01:04.06,0:01:07.04,Default,,0,0,0,,Өз тамағыңды жаса, мен айтамын.
Dialogue: 0,0:01:10.05,0:01:12.05,Default,,0,0,0,,Сіз ештеңе түсінбейсіз
Dialogue: 0,0:01:13.03,0:01:17.04,Default,,0,0,0,,Анамның өмірдегі мақсаты қанша, ұстаздарына қамқорлық жасау.
Dialogue: 0,0:01:17.06,0:01:19.06,Default,,0,0,0,,Менің қарауымда жоқ ұлыммен
Dialogue: 0,0:01:19.07,0:01:23.04,Default,,0,0,0,,Шаршаған күйеу, не жесе де дәмді болады деп.
Dialogue: 0,0:01:23.07,0:01:25.03,Default,,0,0,0,,Бәсекесіз өмірде
Dialogue: 0,0:01:25.04,0:01:30.09,Default,,0,0,0,,Ұстазымның болуы ғана анамның аналық, әйелдік қасиетін айшықтай түсті.
Dialogue: 0,0:01:38.03,0:01:40.06,Default,,0,0,0,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:01:41.03,0:01:43.08,Default,,0,0,0,,«Басқалардан ерекшелену» арқылы өзіңізді ерекшелендіріңіз
Dialogue: 0,0:01:44.01,0:01:46.03,Default,,0,0,0,,Дүкен журналының бұрышы
Dialogue: 0,0:01:46.08,0:01:49.07,Default,,0,0,0,,Мұқабаға кездейсоқ жазылған.
Dialogue: 0,0:01:49.08,0:01:52.00,Default,,0,0,0,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:01:52.05,0:01:55.01,Default,,0,0,0,,Кішкентай кезімде түк көрмедім.
Dialogue: 0,0:01:55.05,0:01:58.00,Default,,0,0,0,,Ұнамаса, ашулан.
Dialogue: 0,0:01:58.00,0:02:00.09,Default,,0,0,0,,Сізге ұнайтын нәрсені айтыңыз
Dialogue: 0,0:02:01.00,0:02:04.01,Default,,0,0,0,,Біз өзгереміз
Dialogue: 0,0:02:04.01,0:02:07.00,Default,,0,0,0,,Нені қорғағыңыз келетін өзгерістер
Dialogue: 0,0:02:07.00,0:02:09.07,Default,,0,0,0,,Түсінбеген қазынадан
Dialogue: 0,0:02:09.08,0:02:12.05,Default,,0,0,0,,Түсіну керек
Dialogue: 0,0:02:12.05,0:02:18.00,Default,,0,0,0,,Өскен сайын өкінесің.
Dialogue: 0,0:02:18.00,0:02:20.06,Default,,0,0,0,,Бірақ бәрібір.
Dialogue: 0,0:02:21.00,0:02:24.09,Default,,0,0,0,,Сіз бір нәрсе көре аласыз
Dialogue: 0,0:02:26.06,0:02:32.00,Default,,0,0,0,,Сондықтан мен өзіммін, ал сен өзіңсің.
Dialogue: 0,0:02:32.00,0:02:38.00,Default,,0,0,0,,Менің ойымша, бұл басынан бастап іздейтін нәрсе емес.
Dialogue: 0,0:02:38.00,0:02:43.03,Default,,0,0,0,,Мен сен емеспін, сен де мен емессің
Dialogue: 0,0:02:43.03,0:02:46.02,Default,,0,0,0,,Бір-бірінен өту, қол ұстасу
Dialogue: 0,0:02:46.02,0:02:50.08,Default,,0,0,0,,Махаббаттың туатын жері.
Dialogue: 0,0:02:51.09,0:02:54.07,Default,,0,0,0,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:02:54.07,0:03:00.08,Default,,0,0,0,,Мен оны өзгерте алмаймын, себебі бұл маңызды.
Dialogue: 0,0:03:01.02,0:03:04.05,Default,,0,0,0,,Өзгеретін өмір дұрыс
Dialogue: 0,0:03:10.09,0:03:12.05,Default,,0,0,0,,Менің бұл аралға келгеніме бір апта болды.
Dialogue: 0,0:03:13.08,0:03:16.01,Default,,0,0,0,,Мен әлі күнге дейін көңілімнен шыққан кейіпкерлерді жаза алмай жүрмін.
Dialogue: 0,0:03:14.09,0:03:19.09,Default,,0,0,0,,: :& :&lucifer : :
Dialogue: 0,0:03:17.05,0:03:19.02,Default,,0,0,0,,Бұл өте жылдам жазылған кітап болды.
Dialogue: 0,0:03:20.02,0:03:21.09,Default,,0,0,0,,Өз қолым деп айта алмаймын.
Dialogue: 0,0:03:24.01,0:03:26.06,Default,,0,0,0,,Мен мұнда кітапқа ену үшін келдім.
Dialogue: 0,0:03:27.07,0:03:29.07,Default,,0,0,0,,Сол қарияға қайта қарау
Dialogue: 0,0:03:30.08,0:03:31.06,Default,,0,0,0,,Шоғырлану
Dialogue: 0,0:03:34.05,0:03:35.09,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:03:38.00,0:03:40.06,Default,,0,0,0,,Бұл тағы сенсің, неге күнде келесің?
Dialogue: 0,0:03:41.00,0:03:43.07,Default,,0,0,0,,Наруха – мұғалімнің жиі келетін жары Жәкең
Dialogue: 0,0:03:44.04,0:03:46.06,Default,,0,0,0,,Бұл қай жерде есіңізде қалды?
Dialogue: 0,0:03:46.07,0:03:47.06,Default,,0,0,0,,Сәлем
Dialogue: 0,0:03:48.04,0:03:49.07,Default,,0,0,0,,Мива-ни мен Тама
Dialogue: 0,0:03:50.00,0:03:51.09,Default,,0,0,0,,Мұқаба
Dialogue: 0,0:03:52.00,0:03:54.08,Default,,0,0,0,,Мен стильді джинбей киген адамды бірінші рет көрдім
Dialogue: 0,0:03:54.09,0:03:57.02,Default,,0,0,0,,Менің базаға келгеніме біраз болды.
Dialogue: 0,0:03:57.03,0:03:59.01,Default,,0,0,0,,Өздігінен жоғары көтерілме.
Dialogue: 0,0:03:59.02,0:04:01.05,Default,,0,0,0,,A, жазба жойылды.
Dialogue: 0,0:04:01.05,0:04:02.08,Default,,0,0,0,,CD жоқ
Dialogue: 0,0:04:03.05,0:04:06.03,Default,,0,0,0,,Эй, балалар, кенеттен неге келдіңдер?
Dialogue: 0,0:04:06.05,0:04:08.03,Default,,0,0,0,,Менің ойымша, бұл кенеттен келді.
Dialogue: 0,0:04:08.05,0:04:10.03,Default,,0,0,0,,Біздің база – якитокенба
Dialogue: 0,0:04:10.04,0:04:11.09,Default,,0,0,0,,Бұдан біздің багажымыз
Dialogue: 0,0:04:12.01,0:04:13.07,Default,,0,0,0,,Мен оны лақтырмаймын деп ойлаймын.
Dialogue: 0,0:04:13.09,0:04:17.07,Default,,0,0,0,,Мен келген кезде сол жерде болған жүк сол картон қорапқа салынған.
Dialogue: 0,0:04:18.07,0:04:20.01,Default,,0,0,0,,Жақсы
Dialogue: 0,0:04:21.01,0:04:23.01,Default,,0,0,0,,Олар маңызды адамдар.
Dialogue: 0,0:04:23.05,0:04:27.06,Default,,0,0,0,,Көрдіңіз бе, бұл енді сіздің базаңыз емес.
Dialogue: 0,0:04:29.02,0:04:31.02,Default,,0,0,0,,Әй, сен не киіп жатырсың?
Dialogue: 0,0:04:31.06,0:04:33.05,Default,,0,0,0,,Мен бұл жерден кетемін деп ойламаймын.
Dialogue: 0,0:04:33.05,0:04:36.01,Default,,0,0,0,,Кет, мұнда бір тұрғын бар.
Dialogue: 0,0:04:36.03,0:04:38.01,Default,,0,0,0,,Ауыр сөздер айту
Dialogue: 0,0:04:38.04,0:04:41.02,Default,,0,0,0,,Мен жас қызбен араласқаныма өте қуаныштымын.
Dialogue: 0,0:04:41.05,0:04:43.05,Default,,0,0,0,,Жаңылыстыратын мәлімдемелерді қолданбаңыз.
Dialogue: 0,0:04:44.05,0:04:46.02,Default,,0,0,0,,Енді сендерсіңдер, балалар.
Dialogue: 0,0:04:47.04,0:04:50.03,Default,,0,0,0,,Мұндай балаға мұндай жағымсыз сөздерді үйретуге қалай дәтің бар?
Dialogue: 0,0:04:50.06,0:04:53.03,Default,,0,0,0,,Бұл әйел Кабукичо ханшайымы.
Dialogue: 0,0:04:53.08,0:04:56.04,Default,,0,0,0,,Ауа райы бұзылса, жастық ісім ашамын.
Dialogue: 0,0:04:56.09,0:04:59.03,Default,,0,0,0,,Кон мисо сорпасы - ауыр сорпа.
Dialogue: 0,0:05:00.03,0:05:02.01,Default,,0,0,0,,Бұдан былай сақ болыңыз
Dialogue: 0,0:05:02.06,0:05:04.07,Default,,0,0,0,,Маған тіл тигізетін сөз айтсаң да
Dialogue: 0,0:05:04.07,0:05:05.04,Default,,0,0,0,,Эй
Dialogue: 0,0:05:06.00,0:05:08.04,Default,,0,0,0,,Әңгімемізді тыңдасаң, оянайық.
Dialogue: 0,0:05:08.07,0:05:10.08,Default,,0,0,0,,Иә, мен сізге айта аламын.
Dialogue: 0,0:05:11.02,0:05:12.08,Default,,0,0,0,,Мұғалімдер де сақ болуы керек.
Dialogue: 0,0:05:13.03,0:05:17.02,Default,,0,0,0,,Қазіргі кездегі балалар сөзді айтқанда минах сияқты.
Dialogue: 0,0:05:17.09,0:05:20.09,Default,,0,0,0,,Сонымен балалар, сіз қолданып жүрген сөздер...
Dialogue: 0,0:05:21.01,0:05:22.00,Default,,0,0,0,,СМ
Dialogue: 0,0:05:23.04,0:05:24.02,Default,,0,0,0,,Наруды күтіңіз
Dialogue: 0,0:05:25.02,0:05:26.07,Default,,0,0,0,,Мен мұны жұмыс үшін жаздым.
Dialogue: 0,0:05:27.01,0:05:29.02,Default,,0,0,0,,Қысқасы, SM клубы сияқты.
Dialogue: 0,0:05:29.04,0:05:30.07,Default,,0,0,0,,Жоқ
Dialogue: 0,0:05:31.02,0:05:36.02,Default,,0,0,0,,SM SM SM
Dialogue: 0,0:05:37.06,0:05:39.08,Default,,0,0,0,,Бұл мейрамхана белгісі.
Dialogue: 0,0:05:39.09,0:05:41.05,Default,,0,0,0,,Тама Намба Шутто
Dialogue: 0,0:05:42.05,0:05:45.01,Default,,0,0,0,,Эй, сен неге құралдарды рұқсатсыз пайдаланасың?
Dialogue: 0,0:05:45.07,0:05:47.09,Default,,0,0,0,,Орындалды.
Dialogue: 0,0:05:48.06,0:05:51.00,Default,,0,0,0,,Жағымды сөздерді көбірек жаз
Dialogue: 0,0:05:51.01,0:05:52.09,Default,,0,0,0,,Тама Сен жақсысың ба?
Dialogue: 0,0:05:53.00,0:05:56.01,Default,,0,0,0,,Рас, егер сіз манга суретшісі болсаңыз, сіз жасай алатын бірнеше нәрсе бар.
Dialogue: 0,0:05:56.02,0:05:58.06,Default,,0,0,0,,Манга әртістері туралы сөйлеме
Dialogue: 0,0:05:58.08,0:06:00.07,Default,,0,0,0,,Мұғалім де жақсы болуы мүмкін
Dialogue: 0,0:06:00.08,0:06:05.02,Default,,0,0,0,,Жарайды, каллиграф болу таңқаларлық оңай шығар.
Dialogue: 0,0:06:06.08,0:06:08.06,Default,,0,0,0,,Жаламаңдар, братандар
Dialogue: 0,0:06:10.00,0:06:12.00,Default,,0,0,0,,Қараңызшы, бұл нақты нәрсе.
Dialogue: 0,0:06:13.02,0:06:15.08,Default,,0,0,0,,Керемет, мен оның не екенін түсінбеймін.
Dialogue: 0,0:06:15.09,0:06:18.02,Default,,0,0,0,,Негізі мен ештеңе түсінбеймін.
Dialogue: 0,0:06:18.05,0:06:20.08,Default,,0,0,0,,Каллиграфия жазғы демалыстағы үй тапсырмасының бір бөлігі болды, солай ма?
Dialogue: 0,0:06:21.00,0:06:22.07,Default,,0,0,0,,Мұғалімнен қарап шығуын сұрайық.
Dialogue: 0,0:06:22.09,0:06:27.00,Default,,0,0,0,,Керемет идея Ұстаздан үйренсеңіз, бас жүлдені жеңіп алу тек арман емес.
Dialogue: 0,0:06:27.01,0:06:29.05,Default,,0,0,0,,Сонымен, рахмет, мұғалім.
Dialogue: 0,0:06:30.02,0:06:31.06,Default,,0,0,0,,Аа, оны маған қалдырыңыз.
Dialogue: 0,0:06:32.01,0:06:33.09,Default,,0,0,0,,Жарайды, ертең тағы келемін.
Dialogue: 0,0:06:33.06,0:06:35.01,Default,,0,0,0,,Қош бол
Dialogue: 0,0:06:38.06,0:06:42.02,Default,,0,0,0,,Мен не істеп жатырмын?
Dialogue: 0,0:06:42.07,0:06:47.04,Default,,0,0,0,,Ал ол сезімдер ақыр аяғында ананың әйел ретіндегі орындауына айналады.
Dialogue: 0,0:06:47.05,0:06:50.00,Default,,0,0,0,,А, мен енді түсіндім. Барайық.
Dialogue: 0,0:06:53.02,0:06:54.04,Default,,0,0,0,,Concentration
Dialogue: 0,0:06:57.04,0:06:58.08,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:06:59.06,0:07:01.01,Default,,0,0,0,,Бұл жолы Хина да келді.
Dialogue: 0,0:07:02.01,0:07:05.07,Default,,0,0,0,,Білесіз бе, менің қазір ойнауға уақытым жоқ.
Dialogue: 0,0:07:06.00,0:07:07.03,Default,,0,0,0,,Go away and play.
Dialogue: 0,0:07:17.02,0:07:19.01,Default,,0,0,0,,Ал екінші рет—
Dialogue: 0,0:07:20.00,0:07:21.08,Default,,0,0,0,,Егер сіз оны елемейтін болсаңыз, ол жақында оралады.
Dialogue: 0,0:07:22.05,0:07:23.01,Default,,0,0,0,,Mosquito
Dialogue: 0,0:07:26.06,0:07:27.05,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:07:37.08,0:07:39.07,Default,,0,0,0,,Эй, күте тұрыңыз.
Dialogue: 0,0:07:40.02,0:07:42.00,Default,,0,0,0,,Жоғалған заттар
Dialogue: 0,0:07:43.05,0:07:46.00,Default,,0,0,0,,Wow, that's fun.
Dialogue: 0,0:07:46.00,0:07:46.50,Default,,0,0,0,,SМ
Dialogue: 0,0:07:47.08,0:07:49.02,Default,,0,0,0,,Жоқ
Dialogue: 0,0:07:50.02,0:07:51.09,Default,,0,0,0,,Балалар, енді келмейсіңдер.
Dialogue: 0,0:07:58.07,0:08:00.04,Default,,0,0,0,,Жоқ, менің басым айналып барады.
Dialogue: 0,0:08:01.07,0:08:05.08,Default,,0,0,0,,Қартайғанда қолым бар жігітке түсті.
Dialogue: 0,0:08:06.07,0:08:09.03,Default,,0,0,0,,Каллиграфтар мұрны жоқ адамдар болуы керек.
Dialogue: 0,0:08:09.09,0:08:12.09,Default,,0,0,0,,Мен баламды да қарай алмаймын.
Dialogue: 0,0:08:18.01,0:08:20.04,Default,,0,0,0,,Эй, сен осында болуың керек. Шығу.
Dialogue: 0,0:08:28.00,0:08:30.01,Default,,0,0,0,,Әй, мен сені шақырған кезде шықшы.
Dialogue: 0,0:08:38.03,0:08:40.02,Default,,0,0,0,,I'm here again
Dialogue: 0,0:08:41.07,0:08:44.08,Default,,0,0,0,,Хироши, мұғаліміңді не істеп жатырсың?
Dialogue: 0,0:08:45.01,0:08:46.06,Default,,0,0,0,,Ештеңе жасамаңыз
Dialogue: 0,0:08:47.09,0:08:49.07,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:08:49.07,0:08:51.02,Default,,0,0,0,,Чемпионды қабылдаңыз.
Dialogue: 0,0:08:51.03,0:08:56.07,Default,,0,0,0,,Жарайды, барлығыңыз, менімен энергияңызды бөлісіңіздер.
Dialogue: 0,0:08:55.08,0:08:57.08,Default,,0,0,0,,Шампонки, сіз алға жылжып жатырсыз.
Dialogue: 0,0:09:05.02,0:09:07.06,Default,,0,0,0,,Жақсы болды, қорытындылаймыз.
Dialogue: 0,0:09:07.09,0:09:10.04,Default,,0,0,0,,Әй, бұл жақсы емес сияқты.
Dialogue: 0,0:09:10.09,0:09:14.00,Default,,0,0,0,,Әйтеуір, бұл жігіт неге өліп жатыр?
Dialogue: 0,0:09:14.05,0:09:16.05,Default,,0,0,0,,Осы кезде мен әрқашан күйзеліске ұшыраймын.
Dialogue: 0,0:09:17.00,0:09:19.06,Default,,0,0,0,,Каллиграфия байқауына қатысу үшін жазуға болатын таңбалар ғана
Dialogue: 0,0:09:20.00,0:09:21.02,Default,,0,0,0,,Сол себепті түні бойы ұйықтамай қалдың ба?
Dialogue: 0,0:09:21.07,0:09:24.00,Default,,0,0,0,,Тест алдында мен де солай сезінемін.
Dialogue: 0,0:09:25.04,0:09:28.01,Default,,0,0,0,,Ал, мына дарынды жігіт екеуміз
Dialogue: 0,0:09:28.05,0:09:30.05,Default,,0,0,0,,Бірдей түнгілердің мағынасы әртүрлі ме?
Dialogue: 0,0:09:31.01,0:09:33.03,Default,,0,0,0,,Хироши Сіздің талантыңыз қандай?
Dialogue: 0,0:09:33.07,0:09:35.06,Default,,0,0,0,,Біраз күш жұмсай алатын адаммен
Dialogue: 0,0:09:36.02,0:09:39.02,Default,,0,0,0,,Қанша талпынсаң да, қолынан келмейтіндер бар.
Dialogue: 0,0:09:40.04,0:09:42.05,Default,,0,0,0,,Хироши қолынан келгеннің бәрін жасаса да, барлығы 3
Dialogue: 0,0:09:43.05,0:09:45.03,Default,,0,0,0,,Мұны кімнен естідің?
Dialogue: 0,0:09:47.08,0:09:49.09,Default,,0,0,0,,Нару да көп жұмыс істегісі келеді
Dialogue: 0,0:09:50.02,0:09:51.07,Default,,0,0,0,,Оны кімнен естідің?
Dialogue: 0,0:09:52.05,0:09:55.00,Default,,0,0,0,,Иә, оны ешкім жеңе алмайды.
Dialogue: 0,0:09:55.05,0:09:57.06,Default,,0,0,0,,Әй, мені тыңда.
Dialogue: 0,0:09:59.04,0:10:01.05,Default,,0,0,0,,Бұл бөлмеде жасырылған.
Dialogue: 0,0:10:01.08,0:10:04.09,Default,,0,0,0,,Ей, менің бөлмемді рұқсатсыз ақтарып жатырмын...
Dialogue: 0,0:10:09.01,0:10:10.09,Default,,0,0,0,,Бұл қандай бөлме?
Dialogue: 0,0:10:11.06,0:10:13.06,Default,,0,0,0,,Мен оның сол қорапта екеніне сенімдімін.
Dialogue: 0,0:10:13.08,0:10:14.06,Default,,0,0,0,,Күтіңіз
Dialogue: 0,0:10:17.03,0:10:20.06,Default,,0,0,0,,Ұстаз, көп жазсам да
Dialogue: 0,0:10:20.07,0:10:22.03,Default,,0,0,0,,Егер сіз хат жазуда жақсы болмасаңыз,
Dialogue: 0,0:10:23.00,0:10:24.07,Default,,0,0,0,,Мұғалімде талант жоқ.
Dialogue: 0,0:10:25.05,0:10:27.06,Default,,0,0,0,,Көп жазсам да, көп жазғым келеді.
Dialogue: 0,0:10:29.03,0:10:31.06,Default,,0,0,0,,Наруха Сенсей туралы көп ойлайды.
Dialogue: 0,0:10:32.00,0:10:33.07,Default,,0,0,0,,Талант Мен шынымен түсінбеймін.
Dialogue: 0,0:10:34.06,0:10:37.01,Default,,0,0,0,,Сіз көп нәрсені зерттеп қойғансыз.
Dialogue: 0,0:10:37.06,0:10:38.05,Default,,0,0,0,,Шашыңызды боядыңыз ба?
Dialogue: 0,0:10:38.08,0:10:41.06,Default,,0,0,0,,Аа, бүгіннен бастап мен осы стильмен жүремін.
Dialogue: 0,0:10:41.09,0:10:44.00,Default,,0,0,0,,Сіз жарымжан адамсыз.
Dialogue: 0,0:10:46.04,0:10:51.06,Default,,0,0,0,,Мен жарымжан жігітпін, сондықтан мен 3-темін деп ойлаймын.
Dialogue: 0,0:10:52.07,0:10:53.06,Default,,0,0,0,,Хироси
Dialogue: 0,0:10:54.05,0:10:58.01,Default,,0,0,0,,Нару, мұғалім бәрінен де талантты.
Dialogue: 0,0:10:58.07,0:11:00.09,Default,,0,0,0,,Хироси нені түсінуі керек?
Dialogue: 0,0:11:01.05,0:11:04.02,Default,,0,0,0,,Жоқ, мен шынымен түсінбеймін.
Dialogue: 0,0:11:04.07,0:11:06.04,Default,,0,0,0,,Ештеңе жасамаңыз
Dialogue: 0,0:11:08.02,0:11:11.07,Default,,0,0,0,,Ең жақсы дарын – еңбектене білу.
Dialogue: 0,0:11:13.00,0:11:15.04,Default,,0,0,0,,Ах, Хироши, жылама.
Dialogue: 0,0:11:16.05,0:11:17.07,Default,,0,0,0,,Жылама
Dialogue: 0,0:11:18.00,0:11:21.03,Default,,0,0,0,,Бұл өтірік. Мен міндетті түрде жылаймын. Мен ересекпін.
Dialogue: 0,0:11:21.06,0:11:23.01,Default,,0,0,0,,Шулы, маған қарама
Dialogue: 0,0:11:27.02,0:11:28.01,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:30.01,0:11:32.06,Default,,0,0,0,,Ян Цикада қабығы
Dialogue: 0,0:11:33.03,0:11:34.07,Default,,0,0,0,,дегеніміз не?
Dialogue: 0,0:11:35.03,0:11:36.06,Default,,0,0,0,,Нарудың таланты
Dialogue: 0,0:11:38.07,0:11:41.04,Default,,0,0,0,,Осыны жинап алсаң, ешкімді жеңе алмайсың.
Dialogue: 0,0:11:41.07,0:11:43.00,Default,,0,0,0,,Бұл талант.
Dialogue: 0,0:11:44.05,0:11:48.04,Default,,0,0,0,,Жарайды, егер сіз басқалар сияқты қиын болсаңыз
Dialogue: 0,0:11:48.09,0:11:50.03,Default,,0,0,0,,Мүмкін бұл талант шығар
Dialogue: 0,0:11:52.09,0:11:54.07,Default,,0,0,0,,A. Гочо мырза және бұл
Dialogue: 0,0:11:55.04,0:11:57.02,Default,,0,0,0,,Сізге әрқашан қамқорлық жасағаным үшін кешіріңіз.
Dialogue: 0,0:11:57.08,0:12:02.00,Default,,0,0,0,,Мм, бұл соңғы сыйлық.
Dialogue: 0,0:12:02.07,0:12:05.03,Default,,0,0,0,,Анам да айтпайды, бірақ ауыртпалық деп ойлаймын.
Dialogue: 0,0:12:07.03,0:12:08.08,Default,,0,0,0,,Бұл ауыртпалық болды ма?
Dialogue: 0,0:12:09.07,0:12:14.01,Default,,0,0,0,,Сондай-ақ, мен бүгіннен бастап қабылдау емтиханына шындап кірісуді ойлап жүрмін.
Dialogue: 0,0:12:14.06,0:12:19.08,Default,,0,0,0,,Мен бүгіннен бастап сізден үлгі алып, көп күш саламын деп ойлаймын.
Dialogue: 0,0:12:20.02,0:12:24.06,Default,,0,0,0,,Әйелім жасаған ет пен картоп маған ұнады, бірақ қолымнан келмейді.
Dialogue: 0,0:12:27.00,0:12:29.04,Default,,0,0,0,,Сіз мені тыңдадыңыз.
Dialogue: 0,0:12:31.03,0:12:34.05,Default,,0,0,0,,Ал, мен кешкі асқа ет пен картоп жасап, саған әкелемін.
Dialogue: 0,0:12:35.01,0:12:37.00,Default,,0,0,0,,Жоқ, бұл менің айтқым келгені емес.
Dialogue: 0,0:12:37.02,0:12:39.09,Default,,0,0,0,,Кешіріңіз, бұл чемпион соңғысы.
Dialogue: 0,0:12:40.04,0:12:40.54,Default,,0,0,0,,А, дұрыс. Мен қалаған DVD бүгін шықты.
Dialogue: 0,0:12:45.00,0:12:46.07,Default,,0,0,0,,Ертеңнен бастап өзіңізге тамақ дайындайсыз ба?
Dialogue: 0,0:12:47.05,0:12:49.06,Default,,0,0,0,,Мұғалім тамақ әзірлейді.
Dialogue: 0,0:12:50.06,0:12:51.08,Default,,0,0,0,,Карри жасауым керек пе?
Dialogue: 0,0:12:55.04,0:12:58.04,Default,,0,0,0,,Мұғалім, мен де бүгін қонаққа келдім.
Dialogue: 0,0:13:00.03,0:13:04.03,Default,,0,0,0,,Мұғалімді құтқару...жедел жәрдем
Dialogue: 0,0:13:11.03,0:13:14.09,Default,,0,0,0,,Ыстық соғу Ұйқының болмауы Тәбеттің төмендеуі
Dialogue: 0,0:13:15.06,0:13:17.00,Default,,0,0,0,,Бір түнде ауруханаға жатқызылды.
Dialogue: 0,0:13:18.04,0:13:22.07,Default,,0,0,0,,Дәрігер, егер өзіңізді нашар сезінсеңіз, айтыңыз.
Dialogue: 0,0:13:22.07,0:13:23.06,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:24.01,0:13:25.05,Default,,0,0,0,,Менде ұйқысыздық бар сияқты.
Dialogue: 0,0:13:26.00,0:13:28.03,Default,,0,0,0,,Мұғалім, сау болыңыз.
Dialogue: 0,0:13:28.05,0:13:31.02,Default,,0,0,0,,Иә, мен тамшылатып жатырмын, сондықтан бәрі жақсы.
Dialogue: 0,0:13:33.01,0:13:34.05,Default,,0,0,0,,Қайсысы көбірек ауырады, инъекция немесе
Dialogue: 0,0:13:35.02,0:13:37.08,Default,,0,0,0,,Иә, қайсысы деп ойлаймын.
Dialogue: 0,0:13:38.04,0:13:39.03,Default,,0,0,0,,Я Сенсей
Dialogue: 0,0:13:39.08,0:13:42.06,Default,,0,0,0,,Біз ауруханаға жатуға қажетті тағамды алу үшін үйге бара жатырмыз.
Dialogue: 0,0:13:43.01,0:13:44.05,Default,,0,0,0,,Иә
Dialogue: 0,0:13:44.09,0:13:47.07,Default,,0,0,0,,Қандай да бір сұрақтарыңыз болса, Ику-чанға айтуға болады.
Dialogue: 0,0:13:48.01,0:13:51.03,Default,,0,0,0,,Бұл медбике жас, бірақ ол тұрмыстағы әйел.
Dialogue: 0,0:13:51.07,0:13:53.02,Default,,0,0,0,,Қолыңды қойсаң жақсы емес.
Dialogue: 0,0:13:53.08,0:13:55.00,Default,,0,0,0,,Мен оны босатуға мүмкіндік жоқ.
Dialogue: 0,0:13:57.02,0:13:57.52,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:13:58.03,0:14:02.04,Default,,0,0,0,,Мен инъекцияның IV тамшыдан гөрі ауыратынын білдім.
Dialogue: 0,0:14:07.07,0:14:09.00,Default,,0,0,0,,Мен қателік жібердім
Dialogue: 0,0:14:10.02,0:14:11.07,Default,,0,0,0,,Сіз қобалжыған шығарсыз.
Dialogue: 0,0:14:13.02,0:14:14.07,Default,,0,0,0,,Үйге ертерек барып жазуым керек.
Dialogue: 0,0:14:17.04,0:14:20.04,Default,,0,0,0,,Неге әлі осындасың?
Dialogue: 0,0:14:23.08,0:14:25.07,Default,,0,0,0,,Шағын көлікті қойып, ертегіні тыңдаңыз.
Dialogue: 0,0:14:26.02,0:14:27.08,Default,,0,0,0,,А, міне, осында.
Dialogue: 0,0:14:28.07,0:14:31.00,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:14:31.04,0:14:32.05,Default,,0,0,0,,Мұғалім, жарайды.
Dialogue: 0,0:14:32.07,0:14:34.00,Default,,0,0,0,,Мен саған қонаққа келдім.
Dialogue: 0,0:14:34.06,0:14:37.00,Default,,0,0,0,,Балалар, осы жолмен келдіңдер ме?
Dialogue: 0,0:14:38.07,0:14:40.02,Default,,0,0,0,,Бүгін мектептің бірінші күні.
Dialogue: 0,0:14:40.07,0:14:42.04,Default,,0,0,0,,Біздің орта мектептің жанында
Dialogue: 0,0:14:42.08,0:14:45.01,Default,,0,0,0,,Мен көремін. Мектепке барғаннан кейін?
Dialogue: 0,0:14:45.02,0:14:46.08,Default,,0,0,0,,Әлі де
Dialogue: 0,0:14:48.07,0:14:51.02,Default,,0,0,0,,Дәрігер, менің көктамыр тамшысы таусылады деп ойлаймын.
Dialogue: 0,0:14:51.04,0:14:56.00,Default,,0,0,0,,Бірдеңе бітіп қалса, келіп ауыстырмай ма?
Dialogue: 0,0:14:56.02,0:14:58.06,Default,,0,0,0,,Мұндай жоғары технологияның болуы мүмкін емес.
Dialogue: 0,0:14:58.07,0:15:00.04,Default,,0,0,0,,Нару медбикесінің қоңырауы
Dialogue: 0,0:15:00.05,0:15:03.05,Default,,0,0,0,,Баклажан Баклажан жоқ.
Dialogue: 0,0:15:03.07,0:15:09.00,Default,,0,0,0,,Баклажан Баклажан Баклажан
Dialogue: 0,0:15:04.06,0:15:09.01,Default,,0,0,0,,Мен Ику-ни-чанға тез қоңырау шалмасам, мұғалім оның қолынан шыққан ауадан өледі.
Dialogue: 0,0:15:10.02,0:15:12.00,Default,,0,0,0,,Баклажан жоқ
Dialogue: 0,0:15:11.08,0:15:13.05,Default,,0,0,0,,Неліктен ол менің төсегімнің жанында?
Dialogue: 0,0:15:13.05,0:15:16.06,Default,,0,0,0,,Жастық сату Жастық сату
Dialogue: 0,0:15:16.08,0:15:18.07,Default,,0,0,0,,Ой, мұғалім есінен танып қалды.
Dialogue: 0,0:15:18.08,0:15:20.05,Default,,0,0,0,,Психикалық жағы күйген
Dialogue: 0,0:15:22.03,0:15:26.08,Default,,0,0,0,,Асығыс болсам да, соңғы кездері аздап тынысым тарылып жүр.
Dialogue: 0,0:15:27.04,0:15:29.04,Default,,0,0,0,,Дұрыс, мен білмедім.
Dialogue: 0,0:15:29.06,0:15:31.01,Default,,0,0,0,,Маған үзіліс беріңізші.
Dialogue: 0,0:15:31.07,0:15:33.06,Default,,0,0,0,,Ол қазірдің өзінде ауырып қалды.
Dialogue: 0,0:15:34.09,0:15:37.07,Default,,0,0,0,,Дәрігер, қызуым аздап көтеріліп тұр.
Dialogue: 0,0:15:38.02,0:15:40.01,Default,,0,0,0,,Қызуды суыту үшін суппозиторий ішейін бе?
Dialogue: 0,0:15:40.05,0:15:41.03,Default,,0,0,0,,Суппозиторийлер
Dialogue: 0,0:15:41.06,0:15:43.01,Default,,0,0,0,,Неліктен жауап беріп жатырсыз?
Dialogue: 0,0:15:43.06,0:15:46.08,Default,,0,0,0,,Жоқ, мен мұндай ұят ойыннан үзілді-кесілді бас тартамын.
Dialogue: 0,0:15:47.00,0:15:50.02,Default,,0,0,0,,Ұят ойыны – медициналық процедура.
Dialogue: 0,0:15:51.06,0:15:54.04,Default,,0,0,0,,Бастауыш сыныпта оқып жүргенімде осындай жағдай болды.
Dialogue: 0,0:15:54.09,0:15:58.02,Default,,0,0,0,,Ұялғаным сонша, бір рет құстым.
Dialogue: 0,0:15:59.04,0:16:01.06,Default,,0,0,0,,Сіздің жарақатыңызды мойындаудың қажеті жоқ.
Dialogue: 0,0:16:02.06,0:16:04.05,Default,,0,0,0,,Әзірше күтейік, көрейік.
Dialogue: 0,0:16:05.00,0:16:08.03,Default,,0,0,0,,Балалар, сендер өздеріңді тым көп күштей алмайсыңдар.
Dialogue: 0,0:16:08.08,0:16:09.08,Default,,0,0,0,,Иә
Dialogue: 0,0:16:10.09,0:16:12.05,Default,,0,0,0,,Наруха бұл
Dialogue: 0,0:16:13.09,0:16:16.04,Default,,0,0,0,,Нанбасётто Согантокоде
Dialogue: 0,0:16:16.07,0:16:19.04,Default,,0,0,0,,Сыртқа шық, киімдерің лас болады.
Dialogue: 0,0:16:19.06,0:16:23.00,Default,,0,0,0,,Жоқ, мен оны бұл жолы дұрыс баса аламын.
Dialogue: 0,0:16:23.04,0:16:26.07,Default,,0,0,0,,Мұғалімге бірдеңе болса, баклажан түймесін басыңыз.
Dialogue: 0,0:16:27.01,0:16:29.01,Default,,0,0,0,,Қараңызшы, ішілік тамшы да толы.
Dialogue: 0,0:16:29.03,0:16:31.05,Default,,0,0,0,,Біраз уақыттан кейін ештеңе болмайды.
Dialogue: 0,0:16:31.06,0:16:34.03,Default,,0,0,0,,Бірақ елестер бар.
Dialogue: 0,0:16:34.05,0:16:35.07,Default,,0,0,0,,Елес
Dialogue: 0,0:16:36.03,0:16:37.08,Default,,0,0,0,,Атам маған жақындады
Dialogue: 0,0:16:38.02,0:16:40.05,Default,,0,0,0,,Ауруханада елес бар.
Dialogue: 0,0:16:40.08,0:16:43.08,Default,,0,0,0,,Құбыжықтан да қорқынышты ма? Мен оның не екенін білмеймін.
Dialogue: 0,0:16:44.05,0:16:47.00,Default,,0,0,0,,Негізі мен қорқамын.
Dialogue: 0,0:16:48.03,0:16:50.08,Default,,0,0,0,,Сіз Йокакенді бір рет болса да көрдіңіз бе?
Dialogue: 0,0:16:51.04,0:16:53.05,Default,,0,0,0,,Бұл сөзсіз қарттың ойдан шығарған әңгімесі.
Dialogue: 0,0:16:55.06,0:16:56.09,Default,,0,0,0,,Нанбасётто
Dialogue: 0,0:16:57.03,0:17:00.07,Default,,0,0,0,,Мен ештеңе естіген жоқпын. Мен елестерге сенбеймін.
Dialogue: 0,0:17:00.09,0:17:04.02,Default,,0,0,0,,Осындай қорқынышты оқиғаны естігеннен кейін түнде ұйықтай алмасаңыз, не істер едіңіз?
Dialogue: 0,0:17:04.03,0:17:06.08,Default,,0,0,0,,Бұл аурухана ескі, сондықтан өте қорқынышты.
Dialogue: 0,0:17:07.03,0:17:09.02,Default,,0,0,0,,Маған суппозиторий берсең
Dialogue: 0,0:17:12.08,0:17:13.09,Default,,0,0,0,,Неге қорқасың?
Dialogue: 0,0:17:14.02,0:17:16.06,Default,,0,0,0,,Уус, мен саған сұрағаныңды әкелдім.
Dialogue: 0,0:17:20.06,0:17:21.08,Default,,0,0,0,,Каллиграфия құралдары
Dialogue: 0,0:17:22.01,0:17:22.51,Default,,0,0,0,,Қабылданбады
Dialogue: 0,0:17:23.02,0:17:26.02,Default,,0,0,0,,Мен мұны неге күттім?
Dialogue: 0,0:17:26.03,0:17:29.08,Default,,0,0,0,,Сіз шамадан тыс жұмыстан құлап қалған болуыңыз керек. Біраз демалыңыз.
Dialogue: 0,0:17:30.00,0:17:32.04,Default,,0,0,0,,Мен жұмыс кезінде өзімді еркін сезінемін.
Dialogue: 0,0:17:33.08,0:17:36.03,Default,,0,0,0,,Менің көзім жабайы.
Dialogue: 0,0:17:37.05,0:17:39.04,Default,,0,0,0,,Ендеше, үйге кететін уақытымыз болды.
Dialogue: 0,0:17:40.00,0:17:40.50,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:17:41.01,0:17:42.02,Default,,0,0,0,,Қош бол
Dialogue: 0,0:17:48.01,0:17:48.51,Default,,0,0,0,,Қайтару?
Dialogue: 0,0:17:51.04,0:17:52.07,Default,,0,0,0,,Сәлем
Dialogue: 0,0:17:54.09,0:17:56.00,Default,,0,0,0,,Сәлем
Dialogue: 0,0:17:56.03,0:17:57.09,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:17:58.02,0:17:59.01,Default,,0,0,0,,Аз ғана
Dialogue: 0,0:17:59.09,0:18:02.05,Default,,0,0,0,,О, мен көрші бөлмедемін.
Dialogue: 0,0:18:02.08,0:18:05.04,Default,,0,0,0,,Қазір ғана жанды болды.
Dialogue: 0,0:18:05.07,0:18:07.07,Default,,0,0,0,,Кешіріңіз, тым қатты болды ма?
Dialogue: 0,0:18:08.01,0:18:10.00,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:18:11.00,0:18:13.06,Default,,0,0,0,,Саған не болды?
Dialogue: 0,0:18:14.01,0:18:17.06,Default,,0,0,0,,Жаман емес, жай ғана жаздың салқыны.
Dialogue: 0,0:18:18.05,0:18:24.09,Default,,0,0,0,,Бұл жай ғана. Барлығы сен үшін уайымдағанына сенімдімін.
Dialogue: 0,0:18:26.01,0:18:30.06,Default,,0,0,0,,Олар сіздің қауіпсіз екеніңізді естігенде қуанады.
Dialogue: 0,0:18:32.04,0:18:35.06,Default,,0,0,0,,Қайырлы таң, сау болыңыз.
Dialogue: 0,0:18:55.04,0:18:57.08,Default,,0,0,0,,Ханда мырза, сіз не істеп жатырсыз?
Dialogue: 0,0:18:58.02,0:19:01.06,Default,,0,0,0,,Қала басшысына каллиграфия құралдарын әкелуін қалайтыныңызды айтыңыз.
Dialogue: 0,0:19:01.09,0:19:03.07,Default,,0,0,0,,Сіздің қызбаңыз әлі басылған жоқ.
Dialogue: 0,0:19:03.07,0:19:07.00,Default,,0,0,0,,Дәл қазір болуы керек, бұл ой маған келген сәт.
Dialogue: 0,0:19:07.03,0:19:10.05,Default,,0,0,0,,Мен оны қазір жаза аламын. Өтінемін, жазайыншы.
Dialogue: 0,0:19:10.06,0:19:12.09,Default,,0,0,0,,Жүр, мен оны қазір жазуым керек.
Dialogue: 0,0:19:12.09,0:19:14.01,Default,,0,0,0,,Тоқтаңыз, сэр.
Dialogue: 0,0:19:13.05,0:19:15.03,Default,,0,0,0,,Бір сәт – кітаптың өмірі.
Dialogue: 0,0:19:15.08,0:19:18.09,Default,,0,0,0,,Жоқ, сэр, менің күйеуім бар.
Dialogue: 0,0:19:21.06,0:19:23.03,Default,,0,0,0,,Кешіріңіз, апай.
Dialogue: 0,0:19:23.06,0:19:25.08,Default,,0,0,0,,Мен сізге айтамын.
Dialogue: 0,0:19:26.04,0:19:28.08,Default,,0,0,0,,Меніңше, аздап көңілім көтеріліп, қызуым көтерілді.
Dialogue: 0,0:19:29.04,0:19:30.09,Default,,0,0,0,,Суппозиторийді алып, төсекке жатқызу.
Dialogue: 0,0:19:37.07,0:19:40.06,Default,,0,0,0,,Мұғалім, өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:19:40.09,0:19:42.08,Default,,0,0,0,,Аа, көріп тұрғаныңыздай.
Dialogue: 0,0:19:43.00,0:19:45.03,Default,,0,0,0,,О, жақсы, жақсы
Dialogue: 0,0:19:45.06,0:19:48.02,Default,,0,0,0,,Сіздің бетіңіз шынымен жақсырақ көрінеді.
Dialogue: 0,0:19:48.05,0:19:49.09,Default,,0,0,0,,Мұның бәрі суппозиторийлердің арқасында.
Dialogue: 0,0:19:51.05,0:19:54.02,Default,,0,0,0,,Дәрі сізге берілді, сондықтан оны дұрыс қабылдаңыз.
Dialogue: 0,0:19:54.07,0:19:55.06,Default,,0,0,0,,Бұл қашықтық қандай?
Dialogue: 0,0:19:56.09,0:19:59.01,Default,,0,0,0,,Күйеуіме деген махаббатымды сынама
Dialogue: 0,0:19:59.05,0:20:00.06,Default,,0,0,0,,Сонда не?
Dialogue: 0,0:20:01.08,0:20:04.03,Default,,0,0,0,,Енді мен ертерек үйге барып жазамын.
Dialogue: 0,0:20:04.08,0:20:06.06,Default,,0,0,0,,О, сен сондай мотивацияландың.
Dialogue: 0,0:20:07.03,0:20:11.01,Default,,0,0,0,,Кеше көрші бөлмедегі қария маған жақсы сөз айтты.
Dialogue: 0,0:20:13.01,0:20:14.04,Default,,0,0,0,,Осы бөлмедегі қарт
Dialogue: 0,0:20:18.03,0:20:20.09,Default,,0,0,0,,Мына бөлмедегі қария
Dialogue: 0,0:20:21.06,0:20:25.06,Default,,0,0,0,,Ата, кеше ауруханаға түскен жалғыз мұғалім.
Dialogue: 0,0:20:26.04,0:20:29.02,Default,,0,0,0,,Пациенттердің көпшілігі жаңадан салынған ғимараттарда емделеді.
Dialogue: 0,0:20:31.06,0:20:34.05,Default,,0,0,0,,Мұғалім, сіз елес көрдіңіз бе?
Dialogue: 0,0:20:37.09,0:20:40.02,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:20:42.01,0:20:44.05,Default,,0,0,0,,Сіз кішкентай қолыңызды создыңыз
Dialogue: 0,0:20:44.07,0:20:46.04,Default,,0,0,0,,Күлімсіреп саған
Dialogue: 0,0:20:46.05,0:20:50.04,Default,,0,0,0,,Бұл өте табиғи болды
Dialogue: 0,0:20:53.00,0:20:55.06,Default,,0,0,0,,Оның мағынасы болмауы мүмкін
Dialogue: 0,0:20:55.08,0:21:01.04,Default,,0,0,0,,Бірақ бұл менің қолымнан келмейді
Dialogue: 0,0:21:03.07,0:21:07.04,Default,,0,0,0,,Сен ойланбастан қолыма тидің
Dialogue: 0,0:21:07.04,0:21:11.02,Default,,0,0,0,,Бұл мен үшін жақсы болды
Dialogue: 0,0:21:14.02,0:21:19.05,Default,,0,0,0,,Біз сенген барлық уақытта
Dialogue: 0,0:21:19.07,0:21:27.08,Default,,0,0,0,,Қолымыздағы сөздерді саламыз
Dialogue: 0,0:21:27.09,0:21:36.00,Default,,0,0,0,,Мүмкін бұл сен менің қолымды ұстап тұрғандықтан емес шығар
Dialogue: 0,0:21:36.02,0:21:47.01,Default,,0,0,0,,Әр сәт, барлық жерде
Dialogue: 0,0:21:47.03,0:21:52.05,Default,,0,0,0,,Мен сеземін, сеземін
Dialogue: 0,0:21:52.08,0:21:57.07,Default,,0,0,0,,Мен сені жамандықтан ұстап тұрғанда
Dialogue: 0,0:21:57.07,0:22:05.00,Default,,0,0,0,,Сіз үйренесіз
Dialogue: 0,0:22:12.04,0:22:15.08,Default,,0,0,0,,Кешіріңіз, мен ет пен картоп әкелдім.
Dialogue: 0,0:22:18.07,0:22:20.02,Default,,0,0,0,,Сіздің жарақатыңызға не болды?
Dialogue: 0,0:22:21.04,0:22:24.01,Default,,0,0,0,,Жоқ, бұл ештеңе емес. Бұл ештеңе емес.
Dialogue: 0,0:22:24.02,0:22:29.08,Default,,0,0,0,,Мұғалім Сіз кескен қанды пиязды мен не істеймін?
Dialogue: 0,0:22:30.08,0:22:33.07,Default,,0,0,0,,Бұл қан емес, дәмдеуіш сияқты, Табаско сияқты
Dialogue: 0,0:22:33.07,0:22:35.05,Default,,0,0,0,,Мына қызыл нәрсе мынау.
Dialogue: 0,0:22:36.06,0:22:41.01,Default,,0,0,0,,Мама, мен сіздің не айтқыңыз келгенін түсіндім деп ойлаймын.
Dialogue: 0,0:22:42.03,0:22:44.09,Default,,0,0,0,,Мен оны ертеңнен бастап жіберуді жалғастырамын.
Dialogue: 0,0:22:45.02,0:22:46.03,Default,,0,0,0,,Иә, жарай ма?
Dialogue: 0,0:22:46.08,0:22:48.05,Default,,0,0,0,,Жарайсың, мұғалім.
Dialogue: 0,0:22:49.55,0:22:54.55,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
