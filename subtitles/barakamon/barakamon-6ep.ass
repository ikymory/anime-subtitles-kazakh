Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Аударма: Токиодан келген жігіттер
Dialogue: 0,0:00:11.03,0:00:13.00,Default,,0,0,0,,Осы жерде болуы керек.
Dialogue: 0,0:00:13.05,0:00:15.08,Default,,0,0,0,,Бүгін дұрыстап іздеңіз.
Dialogue: 0,0:00:16.02,0:00:18.08,Default,,0,0,0,,Мен енді лагерьлерде болғанды ​​ұнатпаймын.
Dialogue: 0,0:00:19.01,0:00:20.00,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:00:20.09,0:00:21.07,Default,,0,0,0,,Бұл іс жарыққа шыққанына төрт айдан асты.
Dialogue: 0,0:00:22.03,0:00:24.08,Default,,0,0,0,,Қабық дүкеніне қош келдіңіз.
Dialogue: 0,0:00:27.08,0:00:29.02,Default,,0,0,0,,Әже
Dialogue: 0,0:00:31.01,0:00:31.51,Default,,0,0,0,,мен өліп қалар едім.
Dialogue: 0,0:00:32.08,0:00:34.02,Default,,0,0,0,,Уф—
Dialogue: 0,0:00:34.07,0:00:37.01,Default,,0,0,0,,Бұл қандай бәсекелестік?
Dialogue: 0,0:00:37.01,0:00:40.03,Default,,0,0,0,,Мен өзімді дүкенші етіп көрсетіп жатқан шығармын. Сіз не сатасыз?
Dialogue: 0,0:00:40.07,0:00:41.06,Default,,0,0,0,,Теңіз қабығы
Dialogue: 0,0:00:42.07,0:00:44.01,Default,,0,0,0,,Біреуін ағаңа да бер.
Dialogue: 0,0:00:44.05,0:00:45.05,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:00:46.03,0:00:47.09,Default,,0,0,0,,Балалар сендерге ұнады ма?
Dialogue: 0,0:00:48.01,0:00:49.01,Default,,0,0,0,,Айқын
Dialogue: 0,0:00:49.01,0:00:50.02,Default,,0,0,0,,Ол жиіркенішті.
Dialogue: 0,0:00:50.03,0:00:51.09,Default,,0,0,0,,Сізге Кавафуджи-сан ұнай ма?
Dialogue: 0,0:00:53.09,0:00:56.07,Default,,0,0,0,,Мен саған тағы он жылдан кейін ғашық болатын сияқтымын.
Dialogue: 0,0:00:56.07,0:00:59.00,Default,,0,0,0,,Маған балалар ұнамайды, маған әйелдер ұнайды.
Dialogue: 0,0:00:59.02,0:01:01.06,Default,,0,0,0,,Сонымен қатар, маған жетілген әйелдер ұнайды.
Dialogue: 0,0:01:03.06,0:01:04.06,Default,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 0,0:01:05.03,0:01:08.02,Default,,0,0,0,,Сіз не істеп жатырсыз? Сіз менің көзілдірікті сындырмақшысыз ба? Жоқ, онда әлдеқашан бірдеңе бар. Ол лас.
Dialogue: 0,0:01:10.02,0:01:12.06,Default,,0,0,0,,Осылайша тіс тазалағышпен алып жейсің.
Dialogue: 0,0:01:12.07,0:01:14.02,Default,,0,0,0,,Жоқ, жақсы сезінеді, жақсы сезінеді
Dialogue: 0,0:01:15.01,0:01:19.09,Default,,0,0,0,,Жас ханым, бұл жерде Киёшу Ханда деген ешкім тұрмайды.
Dialogue: 0,0:01:20.01,0:01:22.04,Default,,0,0,0,,Дәнекерлеу? Киёшу?
Dialogue: 0,0:01:23.06,0:01:24.07,Default,,0,0,0,,Мен онда тұрмаймын
Dialogue: 0,0:01:24.08,0:01:25.07,Default,,0,0,0,,Өтірік
Dialogue: 0,0:01:26.00,0:01:29.01,Default,,0,0,0,,Бірақ осындай сәнді есімді ұстаз бар.
Dialogue: 0,0:01:29.05,0:01:30.04,Default,,0,0,0,,Мұғалім?
Dialogue: 0,0:01:30.08,0:01:32.01,Default,,0,0,0,,Мен каллиграфия пәнінің мұғалімімін.
Dialogue: 0,0:01:32.06,0:01:35.06,Default,,0,0,0,,Міне. Мен Ханда мырзаның үйін білемін.
Dialogue: 0,0:01:36.02,0:01:38.02,Default,,0,0,0,,Егер сіз маған теңіз раковинасын сатып алсаңыз, мен сізге хабарлаймын.
Dialogue: 0,0:01:38.04,0:01:39.09,Default,,0,0,0,,Сіз өте мұқиятсыз.
Dialogue: 0,0:01:40.04,0:01:41.08,Default,,0,0,0,,Олай болса маған сат.
Dialogue: 0,0:01:43.01,0:01:45.04,Default,,0,0,0,,Осыны таңдасаңыз, талғамыңыз жоғары.
Dialogue: 0,0:01:46.00,0:01:50.08,Default,,0,0,0,,Бірақ мұны тек IT президенттері мен ірі лигалар сияқты бай адамдарға сатуға болады.
Dialogue: 0,0:01:51.09,0:01:55.01,Default,,0,0,0,,Онда картамен төлеу дұрыс емес пе?
Dialogue: 0,0:01:55.03,0:01:56.09,Default,,0,0,0,,Ka картасы
Dialogue: 0,0:01:57.00,0:01:58.07,Default,,0,0,0,,Маған қанша қалайтыныңызды айтыңыз
Dialogue: 0,0:01:59.01,0:02:01.07,Default,,0,0,0,,Маған бағыт-бағдар берулеріңізді сұраймын, мен секіремін.
Dialogue: 0,0:02:02.02,0:02:05.06,Default,,0,0,0,,Хья хя, оны миллион иенге ал, ұры.
Dialogue: 0,0:02:05.07,0:02:08.04,Default,,0,0,0,,Мен бір тиын жоғалтпасам да, мені ұрыдай көрме.
Dialogue: 0,0:02:09.04,0:02:13.05,Default,,0,0,0,,Мен Хаменді көрдім. Бұл карта ма?
Dialogue: 0,0:02:13.07,0:02:14.02,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:02:16.05,0:02:18.07,Default,,0,0,0,,Жарайды, қыз, маған бағыт-бағдар бер.
Dialogue: 0,0:02:18.09,0:02:21.02,Default,,0,0,0,,Тоқта, мен әжеге көрсетемін.
Dialogue: 0,0:02:22.00,0:02:23.06,Default,,0,0,0,,Тоқта, күт, бұл бірінші келеді.
Dialogue: 0,0:02:23.06,0:02:25.06,Default,,0,0,0,,Тоқта, оны жібер
Dialogue: 0,0:02:25.06,0:02:26.05,Default,,0,0,0,,Жылдам нұсқаулық
Dialogue: 0,0:02:28.05,0:02:30.02,Default,,0,0,0,,Менің әкем қандай?
Dialogue: 0,0:02:30.03,0:02:31.06,Default,,0,0,0,,Не?
Dialogue: 0,0:02:31.07,0:02:32.09,Default,,0,0,0,,Доғаншы директорының орынбасары
Dialogue: 0,0:02:33.02,0:02:34.01,Default,,0,0,0,,Күдікті адам
Dialogue: 0,0:02:34.03,0:02:35.06,Default,,0,0,0,,Мен сіздің балаңызды ұрлап алғым келеді.
Dialogue: 0,0:02:35.08,0:02:37.00,Default,,0,0,0,,Tattoo bashichozo
Dialogue: 0,0:02:37.00,0:02:39.01,Default,,0,0,0,,Жоқ, олай емес. Өрт сөндірушілерді шақыру
Dialogue: 0,0:02:39.01,0:02:42.08,Default,,0,0,0,,Бізде туған жер жиналысы болып жатыр, аздап сөйлесейік.
Dialogue: 0,0:02:43.08,0:02:44.03,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:02:45.05,0:02:47.06,Default,,0,0,0,,Біраз Кавафуджи мырза
Dialogue: 0,0:02:51.04,0:02:53.07,Default,,0,0,0,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:02:54.05,0:02:56.09,Default,,0,0,0,,«Басқалардан ерекшелену» арқылы өзіңізді ерекшелендіріңіз
Dialogue: 0,0:02:57.02,0:02:59.04,Default,,0,0,0,,Дүкен журналының бұрышы
Dialogue: 0,0:02:59.09,0:03:02.08,Default,,0,0,0,,Мұқабаға кездейсоқ жазылған.
Dialogue: 0,0:03:02.09,0:03:05.02,Default,,0,0,0,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:03:05.06,0:03:08.02,Default,,0,0,0,,Кішкентай кезімде түк көрмедім.
Dialogue: 0,0:03:08.07,0:03:11.01,Default,,0,0,0,,Ұнамаса, ашулан.
Dialogue: 0,0:03:11.02,0:03:14.01,Default,,0,0,0,,Сізге ұнайтын нәрсені айтыңыз
Dialogue: 0,0:03:14.01,0:03:17.02,Default,,0,0,0,,Біз өзгереміз
Dialogue: 0,0:03:17.02,0:03:20.01,Default,,0,0,0,,Нені қорғағыңыз келетін өзгерістер
Dialogue: 0,0:03:20.01,0:03:22.08,Default,,0,0,0,,Түсінбеген қазынадан
Dialogue: 0,0:03:22.09,0:03:25.06,Default,,0,0,0,,Түсіну керек
Dialogue: 0,0:03:25.06,0:03:31.01,Default,,0,0,0,,Өскен сайын өкінесің.
Dialogue: 0,0:03:31.01,0:03:33.07,Default,,0,0,0,,Бірақ бәрібір.
Dialogue: 0,0:03:34.01,0:03:38.01,Default,,0,0,0,,Сіз бір нәрсе көре аласыз
Dialogue: 0,0:03:39.07,0:03:45.02,Default,,0,0,0,,Сондықтан мен өзіммін, ал сен өзіңсің.
Dialogue: 0,0:03:45.02,0:03:51.01,Default,,0,0,0,,Менің ойымша, бұл басынан бастап іздейтін нәрсе емес.
Dialogue: 0,0:03:51.01,0:03:56.04,Default,,0,0,0,,Мен сен емеспін, сен де мен емессің
Dialogue: 0,0:03:56.04,0:03:59.03,Default,,0,0,0,,Бір-бірінен өту, қол ұстасу
Dialogue: 0,0:03:59.03,0:04:03.09,Default,,0,0,0,,Махаббаттың туатын жері.
Dialogue: 0,0:04:05.01,0:04:07.08,Default,,0,0,0,,Өзің болу деген нені білдіреді?
Dialogue: 0,0:04:07.09,0:04:13.09,Default,,0,0,0,,Мен оны өзгерте алмаймын, себебі бұл маңызды.
Dialogue: 0,0:04:14.03,0:04:17.07,Default,,0,0,0,,Өзгеретін өмір дұрыс
Dialogue: 0,0:04:25.01,0:04:29.01,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:04:27.09,0:04:32.09,Default,,0,0,0,,: :& :&lucifer : :
Dialogue: 0,0:04:29.02,0:04:32.01,Default,,0,0,0,,Неге бәрің үйде кешкі ас ішіп отырсыңдар?
Dialogue: 0,0:04:32.05,0:04:36.04,Default,,0,0,0,,Оядзи мен анасы да туған қаладағы кездесуге мәдениет үйіне барды.
Dialogue: 0,0:04:36.08,0:04:37.08,Default,,0,0,0,,Ата да
Dialogue: 0,0:04:37.08,0:04:40.00,Default,,0,0,0,,Жалғыз тамақтанғаннан жақсы.
Dialogue: 0,0:04:40.02,0:04:40.52,Default,,0,0,0,,Эй
Dialogue: 0,0:04:42.02,0:04:44.00,Default,,0,0,0,,Мен жалғыз тамақтанғанды ұнатамын
Dialogue: 0,0:04:45.00,0:04:48.00,Default,,0,0,0,,Мұғалім, аралға келгелі бері семіріп кетіпсіз.
Dialogue: 0,0:04:48.01,0:04:49.00,Default,,0,0,0,,Ах.
Dialogue: 0,0:04:49.02,0:04:49.52,Default,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,0:04:51.04,0:04:54.06,Default,,0,0,0,,Ауылдың бос ауасы мені бұзады.
Dialogue: 0,0:04:55.01,0:04:57.01,Default,,0,0,0,,Ер адамның семіз болғаны дұрыс па?
Dialogue: 0,0:04:57.06,0:04:59.09,Default,,0,0,0,,Мен бұл туралы біраздан бері ойланып жүрмін.
Dialogue: 0,0:05:00.02,0:05:02.00,Default,,0,0,0,,Бұл граффити туралы бірдеңе
Dialogue: 0,0:05:03.02,0:05:05.03,Default,,0,0,0,,Мен жаңа ғана дудл жігітпен таныстым
Dialogue: 0,0:05:05.07,0:05:07.08,Default,,0,0,0,,Катаги емес шығар.
Dialogue: 0,0:05:08.01,0:05:11.02,Default,,0,0,0,,Граффити немесе татуировка?
Dialogue: 0,0:05:11.08,0:05:15.03,Default,,0,0,0,,Гүлдер, иттер және дөңгелек нәрсе
Dialogue: 0,0:05:15.07,0:05:16.07,Default,,0,0,0,,Маған мәрмәр шоколад керек
Dialogue: 0,0:05:17.00,0:05:20.01,Default,,0,0,0,,Сол жігіттің татуировкасы сұңқардың суреті емес пе еді?
Dialogue: 0,0:05:21.06,0:05:24.03,Default,,0,0,0,,Мен мұның қаншалықты беймаза екенін түсінбеймін.
Dialogue: 0,0:05:24.06,0:05:27.03,Default,,0,0,0,,Шындығында, мен кешеден бері бірнеше хат алдым.
Dialogue: 0,0:05:29.02,0:05:30.05,Default,,0,0,0,,Мен сені менің досым деп ойлаймын
Dialogue: 0,0:05:31.02,0:05:32.07,Default,,0,0,0,,Өйткені мен теңізге талай рет құладым.
Dialogue: 0,0:05:32.07,0:05:34.07,Default,,0,0,0,,Кілт ақымақ, мен жауап бере алмаймын.
Dialogue: 0,0:05:35.06,0:05:39.04,Default,,0,0,0,,Мен мұғалімнің ұялы телефонынан гөрі досы бар екеніне таң қалдым.
Dialogue: 0,0:05:39.04,0:05:40.02,Default,,0,0,0,,Мен сені талқандаймын
Dialogue: 0,0:05:40.05,0:05:42.00,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:05:42.06,0:05:43.05,Default,,0,0,0,,Не болды, Мива?
Dialogue: 0,0:05:43.06,0:05:47.00,Default,,0,0,0,,Сәлеметсіңдер ме, екеуің.
Dialogue: 0,0:05:48.06,0:05:51.04,Default,,0,0,0,,Эй, сен осы жерден кіруің керек.
Dialogue: 0,0:05:51.05,0:05:52.08,Default,,0,0,0,,Бұл кіреберіс.
Dialogue: 0,0:05:52.08,0:05:56.03,Default,,0,0,0,,Жоқ, оларды алдыңғы есіктен кіргізген дұрыс.
Dialogue: 0,0:05:56.06,0:05:57.04,Default,,0,0,0,,Сіз тұтынушысыз ба?
Dialogue: 0,0:05:58.01,0:06:00.02,Default,,0,0,0,,Ұстазымның достары маған құда түсуде.
Dialogue: 0,0:06:03.05,0:06:05.00,Default,,0,0,0,,River…Wisteria
Dialogue: 0,0:06:06.00,0:06:08.04,Default,,0,0,0,,Бұл жігіт неге сонша жауыз?
Dialogue: 0,0:06:09.01,0:06:14.02,Default,,0,0,0,,Күн ортасында ауылдан бала алып қашпақ болдым, ауыл жиналысында уағыз айтты.
Dialogue: 0,0:06:14.03,0:06:15.03,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:15.06,0:06:18.00,Default,,0,0,0,,Адамдар жиналса, ішу тойына айналады.
Dialogue: 0,0:06:18.04,0:06:20.06,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:06:19.05,0:06:20.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:21.06,0:06:22.06,Default,,0,0,0,,Дәнекер
Dialogue: 0,0:06:23.08,0:06:27.09,Default,,0,0,0,,Мен қаншалықты уайымдадым деп ойлайсыз?
Dialogue: 0,0:06:28.06,0:06:32.00,Default,,0,0,0,,Қала қызы, ауылда осылай өмір сүресің бе?
Dialogue: 0,0:06:33.02,0:06:34.03,Default,,0,0,0,,Бұл жолы жылайсың ба?
Dialogue: 0,0:06:34.06,0:06:36.08,Default,,0,0,0,,Мен уайымдап, уайымдап жүрмін
Dialogue: 0,0:06:36.04,0:06:39.04,Default,,0,0,0,,Кавафуджи мен туралы көп нәрсе
Dialogue: 0,0:06:39.08,0:06:41.04,Default,,0,0,0,,Менің досым Ханда
Dialogue: 0,0:06:41.05,0:06:43.00,Default,,0,0,0,,Менің досым Кавафуджи
Dialogue: 0,0:06:43.01,0:06:46.00,Default,,0,0,0,,Менің досым мәңгі
Dialogue: 0,0:06:46.01,0:06:47.02,Default,,0,0,0,,Кавафуджи
Dialogue: 0,0:06:47.05,0:06:48.09,Default,,0,0,0,,Дәнекер
Dialogue: 0,0:06:50.00,0:06:50.50,Default,,0,0,0,,Оян!
Dialogue: 0,0:06:52.04,0:06:55.00,Default,,0,0,0,,Алдыңғы: Сіз телефон қоңырауын елемедіңіз.
Dialogue: 0,0:06:55.00,0:06:56.07,Default,,0,0,0,,Жалған немесе жалған дос?
Dialogue: 0,0:06:56.07,0:06:59.01,Default,,0,0,0,,Кешіріңіз, телефоным бұзылған.
Dialogue: 0,0:06:59.01,0:07:02.03,Default,,0,0,0,,Ақымақ болма, маған хабарласу үшін сол тұтқаны пайдаланыңыз.
Dialogue: 0,0:07:02.03,0:07:04.07,Default,,0,0,0,,Жоқ, мен сіз сонда жете аласыз деп ойладым.
Dialogue: 0,0:07:04.08,0:07:07.03,Default,,0,0,0,,Ауылда тұрудың қолайсыздығы үшін кешірім сұраймын.
Dialogue: 0,0:07:11.05,0:07:13.04,Default,,0,0,0,,Не құсып жатырсың?
Dialogue: 0,0:07:15.03,0:07:17.05,Default,,0,0,0,,Токиодан келу қиын болған шығар.
Dialogue: 0,0:07:17.06,0:07:20.02,Default,,0,0,0,,Бұл шамамен үш сағаттық ұшу трансфері.
Dialogue: 0,0:07:20.07,0:07:24.02,Default,,0,0,0,,Бұл таңқаларлық. Мен ұшақты қалай басқару керектігін түсінбеймін.
Dialogue: 0,0:07:24.02,0:07:26.00,Default,,0,0,0,,Мен ешқашан мінген емеспін.
Dialogue: 0,0:07:26.02,0:07:28.02,Default,,0,0,0,,Балалар, Токиода ешқашан болған жоқсыңдар ма?
Dialogue: 0,0:07:28.04,0:07:29.08,Default,,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә? Нагасакиге дейін
Dialogue: 0,0:07:29.09,0:07:30.08,Default,,0,0,0,,Хёгоға дейін
Dialogue: 0,0:07:31.02,0:07:32.08,Default,,0,0,0,,Шынайы ма? Мен сене алар емеспін.
Dialogue: 0,0:07:33.05,0:07:35.03,Default,,0,0,0,,Мұғалім, бұл зат жоқ.
Dialogue: 0,0:07:35.05,0:07:36.02,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,0:07:36.03,0:07:39.09,Default,,0,0,0,,Барып алыңыз. Ақсақалдарыңды аузыңа алмақсың ба?
Dialogue: 0,0:07:39.09,0:07:42.03,Default,,0,0,0,,Тез жүр, үйіңді ойлама.
Dialogue: 0,0:07:42.08,0:07:44.06,Default,,0,0,0,,Барлығы жақсы дос, солай емес пе?
Dialogue: 0,0:07:43.09,0:07:45.03,Default,,0,0,0,,Бұл күндері кіші мектеп оқушылары
Dialogue: 0,0:07:45.04,0:07:48.00,Default,,0,0,0,,Мен сені менің мұғалімімнің досы деп ойламаймын.
Dialogue: 0,0:07:48.06,0:07:50.06,Default,,0,0,0,,Мен сол жерде бір мас жігіт туралы айтып едім.
Dialogue: 0,0:07:51.00,0:07:54.06,Default,,0,0,0,,Мен Ханда мырзамен танысқым келді, осылай болды.
Dialogue: 0,0:07:55.03,0:07:57.02,Default,,0,0,0,,Бұл Косуке Канзаки, каллиграф.
Dialogue: 0,0:07:57.02,0:08:02.00,Default,,0,0,0,,Сізге карта керек пе? Мен бұл жолды Ханда мырзаға сүйсінгендіктен бастадым.
Dialogue: 0,0:08:01.05,0:08:03.05,Default,,0,0,0,,Мен жас көріндім, бірақ
Dialogue: 0,0:08:03.06,0:08:06.05,Default,,0,0,0,,Мен 18 жастамын. Адамдар мені орта мектеп оқушысы деп қателеседі.
Dialogue: 0,0:08:07.03,0:08:11.02,Default,,0,0,0,,18 жастағы каллиграф Бұл туралы бір жерден естігенмін.
Dialogue: 0,0:08:11.08,0:08:15.08,Default,,0,0,0,,Күні кеше мен Ханда мырзамен бірге кітап көрмесіне қатысу үшін батылдық жинадым.
Dialogue: 0,0:08:16.02,0:08:18.03,Default,,0,0,0,,Ол Токио Кашо көрмесі деп аталады.
Dialogue: 0,0:08:19.06,0:08:22.02,Default,,0,0,0,,Мен болсам, атмосфераны оқи алмас едім.
Dialogue: 0,0:08:22.06,0:08:26.02,Default,,0,0,0,,Мен сүйсінген адамға қарамастан бас жүлдені жеңіп алдым.
Dialogue: 0,0:08:26.09,0:08:31.04,Default,,0,0,0,,Мен бұлттардың үстінде деп ойлаған Ханда мырза кенет маған жақындай түсті.
Dialogue: 0,0:08:31.08,0:08:35.00,Default,,0,0,0,,Міне, менің ойымша, Ханда мырза сол кезде бұрыштарды кесіп тастады.
Dialogue: 0,0:08:35.04,0:08:38.04,Default,,0,0,0,,Мен күріш торттарын алған кезде
Dialogue: 0,0:08:39.04,0:08:40.08,Default,,0,0,0,,Кітап көрмесі екінші орын
Dialogue: 0,0:08:41.01,0:08:44.00,Default,,0,0,0,,Соган Яка емес пе? Мұғаліммен кездескенімде таң қалдым.
Dialogue: 0,0:08:44.03,0:08:46.06,Default,,0,0,0,,Көңілсіз көрінсең, мені көруге келдің.
Dialogue: 0,0:08:47.00,0:08:49.06,Default,,0,0,0,,Егер мұғалім бұл тұлғаны білсе,
Dialogue: 0,0:08:50.03,0:08:52.01,Default,,0,0,0,,Бұл жеткілікті ме?
Dialogue: 0,0:08:52.09,0:08:54.00,Default,,0,0,0,,Ханда мырзаға да визитка
Dialogue: 0,0:08:53.03,0:08:54.05,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:08:54.05,0:08:55.07,Default,,0,0,0,,Не, жоқ?
Dialogue: 0,0:08:56.05,0:08:58.01,Default,,0,0,0,,Сіз үнемі осылай жейсіз.
Dialogue: 0,0:08:58.04,0:08:59.04,Default,,0,0,0,,Жоқ, бұл санға қатысты.
Dialogue: 0,0:08:59.06,0:09:01.07,Default,,0,0,0,,Бұл тым көп, сізге қаншалықты ұнады?
Dialogue: 0,0:09:03.02,0:09:05.03,Default,,0,0,0,,Ханда мырза қызық адам емес пе?
Dialogue: 0,0:09:07.00,0:09:09.03,Default,,0,0,0,,Білгенімде, мен осындай түрлі-түсті жігіттен жеңіліп қалдым
Dialogue: 0,0:09:09.06,0:09:11.08,Default,,0,0,0,,Мақтаншақ ұстаз туралы әңгіме
Dialogue: 0,0:09:12.06,0:09:14.06,Default,,0,0,0,,Мен тіпті өз-өзіме қол жұмсадым.
Dialogue: 0,0:09:14.09,0:09:16.08,Default,,0,0,0,,Ханда мырзаның жақында өткен кітап көрмесі
Dialogue: 0,0:09:17.07,0:09:19.06,Default,,0,0,0,,Әй, уақыт таяп қалды.
Dialogue: 0,0:09:19.06,0:09:21.06,Default,,0,0,0,,Дұрыс, үйге кететін уақыт келді.
Dialogue: 0,0:09:21.06,0:09:23.00,Default,,0,0,0,,Қонақ үйде біраз уақыт болыңыз.
Dialogue: 0,0:09:23.00,0:09:25.08,Default,,0,0,0,,Біз кеше лагерьде түнедік.
Dialogue: 0,0:09:25.08,0:09:28.04,Default,,0,0,0,,Олай болса, кемпинг ауылына қайту керек.
Dialogue: 0,0:09:28.05,0:09:29.07,Default,,0,0,0,,Түнде жүру қауіпті.
Dialogue: 0,0:09:30.01,0:09:32.03,Default,,0,0,0,,Кавафуджи де ұйықтап жатыр, сондықтан түнде қалуыңызды өтінемін.
Dialogue: 0,0:09:33.00,0:09:34.02,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:09:34.04,0:09:38.03,Default,,0,0,0,,Жақсы. Лагерьде көптеген жәндіктер болды, мен оны ұнатпадым.
Dialogue: 0,0:09:35.00,0:09:38.00,Default,,0,0,0,,Үйге бару керек.
Dialogue: 0,0:09:38.03,0:09:39.09,Default,,0,0,0,,Менің айтқым келетін нәрселер бар.
Dialogue: 0,0:09:40.01,0:09:41.02,Default,,0,0,0,,Доғандар
Dialogue: 0,0:09:41.03,0:09:43.02,Default,,0,0,0,,Ол түнейтін сияқты.
Dialogue: 0,0:09:43.02,0:09:45.07,Default,,0,0,0,,Егер бұл орын алса, түнде қалып, оны тоқтатудан басқа амалымыз жоқ.
Dialogue: 0,0:09:45.07,0:09:47.09,Default,,0,0,0,,Ертең менде мансап бойынша кеңес бар.
Dialogue: 0,0:09:47.05,0:09:48.00,Default,,0,0,0,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,0:09:48.03,0:09:51.03,Default,,0,0,0,,Өйткені мұғалімнің достары Нарудың достары.
Dialogue: 0,0:09:51.08,0:09:53.02,Default,,0,0,0,,Достық белгісі
Dialogue: 0,0:09:54.01,0:09:55.00,Default,,0,0,0,,Қызық, бұл не?
Dialogue: 0,0:09:58.04,0:10:00.00,Default,,0,0,0,,Лас соққы добы
Dialogue: 0,0:10:03.04,0:10:05.03,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:04.06,0:10:06.03,Default,,0,0,0,,Нанбасёттоккатчи
Dialogue: 0,0:10:05.03,0:10:08.05,Default,,0,0,0,,Нарудың қымбат иісі
Dialogue: 0,0:10:06.05,0:10:08.01,Default,,0,0,0,,Біртүрлі заттарды сақтамаңыз
Dialogue: 0,0:10:08.05,0:10:09.05,Default,,0,0,0,,Есеп бер.
Dialogue: 0,0:10:09.05,0:10:10.08,Default,,0,0,0,,Қап, шық.
Dialogue: 0,0:10:11.00,0:10:12.07,Default,,0,0,0,,Мені ынталандырсаң, бекер ұстаз
Dialogue: 0,0:10:15.07,0:10:16.03,Default,,0,0,0,,Сасық
Dialogue: 0,0:10:16.04,0:10:18.05,Default,,0,0,0,,Мен саған айттым ғой, Хиро-ни.
Dialogue: 0,0:10:25.04,0:10:28.03,Default,,0,0,0,,Егер сіз мұны қолдансаңыз, оны ешқандай иіс шығармай ұстауға болады.
Dialogue: 0,0:10:28.06,0:10:30.09,Default,,0,0,0,,Балалар, сендер кейбір нәзік трюктарды білесіңдер, солай ма?
Dialogue: 0,0:10:31.02,0:10:34.01,Default,,0,0,0,,Тек өте пайдалы бол, мені біртүрлі деме.
Dialogue: 0,0:10:34.03,0:10:36.01,Default,,0,0,0,,Енді жоқ, мен үйге барғым келеді
Dialogue: 0,0:10:37.01,0:10:39.02,Default,,0,0,0,,Мен бәрібір бүгін үйге баруым керек сияқты.
Dialogue: 0,0:10:39.04,0:10:42.00,Default,,0,0,0,,Иісі басқа жәндіктерді өзіне тартады.
Dialogue: 0,0:10:43.08,0:10:45.06,Default,,0,0,0,,Жарайды, ертең қайтамын.
Dialogue: 0,0:10:46.07,0:10:47.06,Default,,0,0,0,,Мен күтемін
Dialogue: 0,0:10:50.02,0:10:50.52,Default,,0,0,0,,Ханда мырза
Dialogue: 0,0:10:52.04,0:10:55.05,Default,,0,0,0,,Мен де сізді мұғалім деп атай аламын ба?
Dialogue: 0,0:10:56.07,0:10:58.05,Default,,0,0,0,,Ой, қалағаныңды істе.
Dialogue: 0,0:11:03.01,0:11:04.08,Default,,0,0,0,,Бір оқиға өтті.
Dialogue: 0,0:11:06.03,0:11:08.01,Default,,0,0,0,,Бұл Косуке Канзаки ме?
Dialogue: 0,0:11:08.09,0:11:11.02,Default,,0,0,0,,Ол каллиграфиямен мүлде айналысатын сияқты емес.
Dialogue: 0,0:11:12.04,0:11:14.04,Default,,0,0,0,,Сонда да менмендік бар.
Dialogue: 0,0:11:14.08,0:11:18.00,Default,,0,0,0,,Біраз күте тұрыңыз, сіз ол туралы білесіз бе?
Dialogue: 0,0:11:18.03,0:11:21.02,Default,,0,0,0,,Мен оны танымаймын, бірақ мен Кавафуджиден электрондық хат алдым.
Dialogue: 0,0:11:21.09,0:11:27.01,Default,,0,0,0,,Кітап көрмесінде бас жүлдені жеңіп алған Косуке Канзаки баланы өзімен бірге алып кетеді.
Dialogue: 0,0:11:27.02,0:11:30.02,Default,,0,0,0,,Оның біраз әдеті бар, соны есте сақтаңыз.
Dialogue: 0,0:11:30.09,0:11:31.03,Default,,0,0,0,,На
Dialogue: 0,0:11:31.07,0:11:32.07,Default,,0,0,0,,Болма
Dialogue: 0,0:11:32.08,0:11:35.03,Default,,0,0,0,,Бізге қаншалықты мән беретінін ойлап тұрсыз ба?
Dialogue: 0,0:11:36.02,0:11:40.04,Default,,0,0,0,,Солай ма? Маған бәрібір сияқты емес.
Dialogue: 0,0:11:40.09,0:11:42.06,Default,,0,0,0,,Мен қызғаншақпын
Dialogue: 0,0:11:43.04,0:11:44.08,Default,,0,0,0,,Бұл бұрынғыға қарағанда оңайырақ.
Dialogue: 0,0:11:45.03,0:11:46.04,Default,,0,0,0,,Мұғалім
Dialogue: 0,0:11:46.08,0:11:49.02,Default,,0,0,0,,Енді, қалған сасық жәндіктерді түсіріп алайық.
Dialogue: 0,0:11:53.09,0:11:54.08,Default,,0,0,0,,Жоғалған
Dialogue: 0,0:11:56.08,0:11:59.00,Default,,0,0,0,,Бүгін сізді тағы мазалағаным үшін кешіріңіз.
Dialogue: 0,0:11:59.05,0:12:00.04,Default,,0,0,0,,Шай ішкіңіз келе ме?
Dialogue: 0,0:12:01.01,0:12:02.02,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:12:02.03,0:12:03.09,Default,,0,0,0,,Кавафуджи бүгін келмейді ме?
Dialogue: 0,0:12:04.04,0:12:06.09,Default,,0,0,0,,Менің қарным ашқандықтан, тұра алмаймын.
Dialogue: 0,0:12:08.03,0:12:10.06,Default,,0,0,0,,Ол сондай.
Dialogue: 0,0:12:11.00,0:12:13.06,Default,,0,0,0,,Уақыт бәріне жаман деп айтасыз ба?
Dialogue: 0,0:12:14.05,0:12:16.06,Default,,0,0,0,,Шай өте ыстық болса да
Dialogue: 0,0:12:15.02,0:12:17.04,Default,,0,0,0,,Өйткені, шай қара бұршақ шай.
Dialogue: 0,0:12:18.01,0:12:20.05,Default,,0,0,0,,Сіз Кавафуджи мырзадан мен туралы естідіңіз бе?
Dialogue: 0,0:12:21.09,0:12:24.03,Default,,0,0,0,,Бас жүлдені жеңіп алғаннан кейін өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:12:24.08,0:12:26.03,Default,,0,0,0,,Бұл айту қорқынышты нәрсе сияқты.
Dialogue: 0,0:12:27.04,0:12:29.05,Default,,0,0,0,,Мен Ханда мырзаны құрметтеймін.
Dialogue: 0,0:12:30.00,0:12:32.00,Default,,0,0,0,,Менің коллекциямды қарап шығыңыз
Dialogue: 0,0:12:33.01,0:12:36.02,Default,,0,0,0,,Мен мұғалім болған кітаптарды барынша жинадым.
Dialogue: 0,0:12:36.07,0:12:39.02,Default,,0,0,0,,Әкесі ұлы каллиграф болған данышпан каллиграф.
Dialogue: 0,0:12:39.07,0:12:40.08,Default,,0,0,0,,Қай кітапты қарасаң да
Dialogue: 0,0:12:40.09,0:12:44.02,Default,,0,0,0,,Мұғалімнің жазуы негізге адал, әдемі болғаны үшін мадақталады.
Dialogue: 0,0:12:44.08,0:12:46.02,Default,,0,0,0,,Бұл гравюрдың мысқыл жүзі
Dialogue: 0,0:12:46.08,0:12:49.00,Default,,0,0,0,,Сенім болмаса, олай көріне алмайсың.
Dialogue: 0,0:12:49.07,0:12:51.04,Default,,0,0,0,,Бұл қара костюм.
Dialogue: 0,0:12:53.05,0:12:55.01,Default,,0,0,0,,Сіз сияны елестетесіз бе?
Dialogue: 0,0:12:55.03,0:12:58.02,Default,,0,0,0,,Бұл не? Бұл өте ұят.
Dialogue: 0,0:12:58.04,0:13:01.04,Default,,0,0,0,,Түсінесің, сен менің кумирімсің.
Dialogue: 0,0:13:02.00,0:13:05.02,Default,,0,0,0,,Айтпақшы, бұл пікір маған ұнады.
Dialogue: 0,0:13:06.07,0:13:10.08,Default,,0,0,0,,Таза ауамен тыныстап, қағаз бен қылқаламмен сөйлескенде
Dialogue: 0,0:13:11.03,0:13:13.09,Default,,0,0,0,,Олар маған басын изеп жауап береді.
Dialogue: 0,0:13:12.07,0:13:15.05,Default,,0,0,0,,Дауыстап оқуды тоқтатыңыз.
Dialogue: 0,0:13:14.08,0:13:20.00,Default,,0,0,0,,Мен үшін каллиграфия да өзімді катарсиске шақыру әрекеті.
Dialogue: 0,0:13:20.01,0:13:21.07,Default,,0,0,0,,Карута Сушиччи бірдеңе
Dialogue: 0,0:13:22.00,0:13:22.50,Default,,0,0,0,,Шулы
Dialogue: 0,0:13:24.03,0:13:25.07,Default,,0,0,0,,Үндемей жұбатпа
Dialogue: 0,0:13:25.09,0:13:27.06,Default,,0,0,0,,Бұл одан да жақсы.
Dialogue: 0,0:13:28.04,0:13:31.03,Default,,0,0,0,,Экспозицияны тоқтату Сіз мұны осылай жасайсыз
Dialogue: 0,0:13:31.03,0:13:32.03,Default,,0,0,0,,Ой...
Dialogue: 0,0:13:32.03,0:13:33.03,Default,,0,0,0,,Қайсысы нашар?
Dialogue: 0,0:13:33.07,0:13:35.05,Default,,0,0,0,,Менің ойымша, сіз мұнда маған күлу үшін келдіңіз.
Dialogue: 0,0:13:35.07,0:13:39.03,Default,,0,0,0,,Жоқ, бұл дұрыс емес. Ұстаздың атақты жолдарын тірідей тыңдағым келді.
Dialogue: 0,0:13:39.07,0:13:41.05,Default,,0,0,0,,Мен тіпті дауыс жазғыш алып келдім.
Dialogue: 0,0:13:41.05,0:13:42.05,Default,,0,0,0,,Қандай мания
Dialogue: 0,0:13:43.07,0:13:47.05,Default,,0,0,0,,Менің Hanasho көрмесіне қойылған себебім, мен мырзамен кездескім келді.
Dialogue: 0,0:13:47.07,0:13:49.03,Default,,0,0,0,,Ауылда осылай не істеп жүрсің?
Dialogue: 0,0:13:50.03,0:13:54.07,Default,,0,0,0,,Мұғалімнің кітап көрмесіне қойған каллиграфиясы Аралға келгеннен кейін жазған каллиграфиясы, солай ма?
Dialogue: 0,0:13:56.01,0:13:58.09,Default,,0,0,0,,Мұғалім, Токиоға бірге қайтайық.
Dialogue: 0,0:14:01.08,0:14:03.02,Default,,0,0,0,,Бас ауруы
Dialogue: 0,0:14:06.07,0:14:08.02,Default,,0,0,0,,Балалар сендер кімсіңдер?
Dialogue: 0,0:14:08.03,0:14:12.02,Default,,0,0,0,,Сәлеметсіз бе, мен кеше Канзаки-кунды көруге келдім.
Dialogue: 0,0:14:12.04,0:14:13.02,Default,,0,0,0,,Оранто
Dialogue: 0,0:14:13.09,0:14:16.00,Default,,0,0,0,,Ол Хандаға барар еді.
Dialogue: 0,0:14:16.03,0:14:17.04,Default,,0,0,0,,Не?
Dialogue: 0,0:14:17.08,0:14:21.09,Default,,0,0,0,,Не, сен мұнда Хандаға қажетсіз сөз айтпа деп келдің бе?
Dialogue: 0,0:14:23.01,0:14:24.09,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:14:25.01,0:14:26.08,Default,,0,0,0,,Бұл азап болса керек.
Dialogue: 0,0:14:27.05,0:14:29.09,Default,,0,0,0,,Үлкендерге қамқорлық жасау да оңай емес.
Dialogue: 0,0:14:30.03,0:14:32.05,Default,,0,0,0,,Мен қиыншылыққа ұшыратқым келмейді.
Dialogue: 0,0:14:32.08,0:14:35.07,Default,,0,0,0,,Ештеңе айтпа. Мен оның қалай сезінетінін білемін.
Dialogue: 0,0:14:36.00,0:14:38.05,Default,,0,0,0,,Өзінің сыртқы түріне қарама-қайшы, ол көп жұмысты алады.
Dialogue: 0,0:14:38.09,0:14:41.05,Default,,0,0,0,,Сахна артында сізді біреу қолдамаса, бұл жақсы емес.
Dialogue: 0,0:14:43.03,0:14:46.05,Default,,0,0,0,,Ханда екеуміз орта мектептен бері доспыз.
Dialogue: 0,0:14:46.09,0:14:49.03,Default,,0,0,0,,Мен әрқашан адамдармен араласуда нашар болдым.
Dialogue: 0,0:14:47.06,0:14:49.06,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:14:49.06,0:14:52.02,Default,,0,0,0,,Аузымды ашсам, тек мақтаншақ сөздер айтамын.
Dialogue: 0,0:14:52.09,0:14:55.06,Default,,0,0,0,,Мен оңай күйзеліске түсіп, қабырға саламын.
Dialogue: 0,0:14:55.01,0:14:55.51,Default,,0,0,0,,Тосқауыл?
Dialogue: 0,0:14:56.05,0:14:59.06,Default,,0,0,0,,Соңында ол тіпті музей директорына қолын да көтерді.
Dialogue: 0,0:15:00.02,0:15:02.04,Default,,0,0,0,,Бөксені сүрту қиынға соғады.
Dialogue: 0,0:15:02.09,0:15:05.02,Default,,0,0,0,,Оны елестету оңай.
Dialogue: 0,0:15:05.04,0:15:09.03,Default,,0,0,0,,Өйткені ауыл адамдар арасындағы қарым-қатынас маңызды болатын бейне болды.
Dialogue: 0,0:15:09.08,0:15:12.09,Default,,0,0,0,,Жақын арада зейнеткерлікке шығып, үйге келеді деп ойладым.
Dialogue: 0,0:15:13.07,0:15:16.05,Default,,0,0,0,,Мұнда тұру өте қызық болуы керек.
Dialogue: 0,0:15:17.07,0:15:20.01,Default,,0,0,0,,Сіз маған тағы біраз уақыт қамқорлық жасай аласыз ба?
Dialogue: 0,0:15:20.05,0:15:23.00,Default,,0,0,0,,Мұғалім туралы көп білмесеңіз,
Dialogue: 0,0:15:23.01,0:15:25.00,Default,,0,0,0,,Канзаки-кунды мұнда не үшін әкелдің?
Dialogue: 0,0:15:25.03,0:15:29.01,Default,,0,0,0,,Мұғалім бас жүлдеден сол жігіттен айырылып, Парижге түсіп кетті.
Dialogue: 0,0:15:29.09,0:15:31.00,Default,,0,0,0,,Басым тағы ауырды.
Dialogue: 0,0:15:31.00,0:15:32.01,Default,,0,0,0,,Алдау
Dialogue: 0,0:15:34.04,0:15:36.00,Default,,0,0,0,,Мен өнер дилерімін.
Dialogue: 0,0:15:36.07,0:15:39.02,Default,,0,0,0,,Ханда дос болғанша алтын тырна.
Dialogue: 0,0:15:39.06,0:15:40.04,Default,,0,0,0,,Алтын тырна
Dialogue: 0,0:15:40.09,0:15:43.01,Default,,0,0,0,,Жақсы шығарма жазбасаң, бәлеге қаласың.
Dialogue: 0,0:15:44.02,0:15:47.03,Default,,0,0,0,,Ол осы аралға келгеннен бері бірдеңе тауып жатыр.
Dialogue: 0,0:15:47.08,0:15:50.03,Default,,0,0,0,,Менің ойымша, сіз абдырап қалдыңыз және оның не екенін білмейсіз.
Dialogue: 0,0:15:51.02,0:15:54.07,Default,,0,0,0,,Адамдардың өсуі үшін оларға бәсекелестер керек.
Dialogue: 0,0:15:56.03,0:16:00.00,Default,,0,0,0,,Жарайды, мен қарным ашты, сондықтан бүгін ұйықтаймын.
Dialogue: 0,0:16:00.07,0:16:02.08,Default,,0,0,0,,Хандаға ертең болатыныңды айт.
Dialogue: 0,0:16:03.08,0:16:06.05,Default,,0,0,0,,Мұғалімнің досы күткендей.
Dialogue: 0,0:16:07.01,0:16:10.08,Default,,0,0,0,,Балағын аңғарға қағып бара жатқан арыстан сияқты.
Dialogue: 0,0:16:11.01,0:16:14.01,Default,,0,0,0,,Бұған дейін каллиграфия жеңу мен жеңіліске жатады ма?
Dialogue: 0,0:16:14.04,0:16:15.08,Default,,0,0,0,,Бұл жекпе-жек өнері емес.
Dialogue: 0,0:16:16.00,0:16:19.09,Default,,0,0,0,,Токиоға оралып, бұрынғыдай каллиграфияны шындап үйреніңіз.
Dialogue: 0,0:16:20.02,0:16:21.03,Default,,0,0,0,,Оның мойны… кесіліп қалған жоқ па?
Dialogue: 0,0:16:21.08,0:16:24.09,Default,,0,0,0,,Мен бұл аралға каллиграфиялық дағдыларымды жетілдіру үшін келдім.
Dialogue: 0,0:16:25.05,0:16:27.00,Default,,0,0,0,,Мен нәтиже шықпайынша үйге бара алмаймын.
Dialogue: 0,0:16:27.02,0:16:30.06,Default,,0,0,0,,Нәтиже Мұғалімнің айтқан нәтижесі қандай?
Dialogue: 0,0:16:34.04,0:16:37.04,Default,,0,0,0,,Мен каллиграфияны бастауыш сыныптан бастап үйрендім.
Dialogue: 0,0:16:37.09,0:16:41.08,Default,,0,0,0,,Әр күн қызықсыз тәжірибе болды және мен бір күні тастаймын деп ойладым.
Dialogue: 0,0:16:42.06,0:16:47.02,Default,,0,0,0,,Сол кезде мен сенің кітабыңды өзім еріксіз бақылаған кітап көрмесінен көрдім.
Dialogue: 0,0:16:49.06,0:16:51.05,Default,,0,0,0,,Қандай әдемі қолжазба!
Dialogue: 0,0:16:54.03,0:16:58.03,Default,,0,0,0,,Дегенмен, қазір сіз нәтиже беріп қана қоймай, одан да нашарлайсыз.
Dialogue: 0,0:16:58.04,0:16:59.00,Default,,0,0,0,,Нашар
Dialogue: 0,0:16:59.07,0:17:00.09,Default,,0,0,0,,Сіз байқамадыңыз ба?
Dialogue: 0,0:17:01.01,0:17:04.01,Default,,0,0,0,,Қазіргі мұғалімнің қолжазбасы артық даралықты көрсетеді.
Dialogue: 0,0:17:04.04,0:17:06.09,Default,,0,0,0,,Жай екпінмен жазу мұғалімге мүлдем ұқсамайды.
Dialogue: 0,0:17:07.02,0:17:07.52,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:08.02,0:17:10.01,Default,,0,0,0,,Дәлел - сенің менен жеңілдің.
Dialogue: 0,0:17:10.06,0:17:12.06,Default,,0,0,0,,Мен сенің көңілің қалды деп ойладым.
Dialogue: 0,0:17:12.08,0:17:14.09,Default,,0,0,0,,Мен азып бара жатқанымды да сезбеймін.
Dialogue: 0,0:17:15.00,0:17:17.01,Default,,0,0,0,,Бұл орта сізді құртып жатыр.
Dialogue: 0,0:17:17.01,0:17:18.03,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:17:18.03,0:17:19.06,Default,,0,0,0,,Токиоға қайтайық.
Dialogue: 0,0:17:19.06,0:17:20.06,Default,,0,0,0,,Кенже
Dialogue: 0,0:17:20.06,0:17:23.02,Default,,0,0,0,,Мұның бәрі адамдар танитын кейіпкерлерді жазу туралы.
Dialogue: 0,0:17:23.03,0:17:25.00,Default,,0,0,0,,Сен мұны айтпадың ба?
Dialogue: 0,0:17:25.04,0:17:27.03,Default,,0,0,0,,Бұл өте қызықсыз жазу.
Dialogue: 0,0:17:28.00,0:17:31.07,Default,,0,0,0,,Жас болсаң да, шартты түрде жазасың.
Dialogue: 0,0:17:31.07,0:17:33.04,Default,,0,0,0,,Үлгі кейіпкер сияқты.
Dialogue: 0,0:17:33.04,0:17:37.05,Default,,0,0,0,,Сіз қарапайымдылық қабырғасын жеңуге тырыстыңыз ба?
Dialogue: 0,0:17:37.00,0:17:39.09,Default,,0,0,0,,Уайымдамай жазғаным қызық болды ма?
Dialogue: 0,0:17:38.02,0:17:39.06,Default,,0,0,0,,Үйге қайтайық, мұғалім.
Dialogue: 0,0:17:39.09,0:17:41.08,Default,,0,0,0,,Бұндай жерде болғанның пайдасы жоқ.
Dialogue: 0,0:17:40.03,0:17:42.05,Default,,0,0,0,,Ол кімнен танылады?
Dialogue: 0,0:17:42.01,0:17:43.05,Default,,0,0,0,,Мұғалім мұғалім
Dialogue: 0,0:17:44.02,0:17:48.01,Default,,0,0,0,,Шулы. Не болып жатыр?
Dialogue: 0,0:17:48.04,0:17:50.09,Default,,0,0,0,,Мен жүлде алсам да, бұл мені жалықтырды деп айтты.
Dialogue: 0,0:17:51.00,0:17:53.00,Default,,0,0,0,,Жақсы жазсам да, жүлде алмадым.
Dialogue: 0,0:17:53.06,0:18:00.02,Default,,0,0,0,,Мен енді білмеймін. Мен дұрыс жауаптың қандай екенін білмеймін.
Dialogue: 0,0:18:04.09,0:18:06.01,Default,,0,0,0,,Қағаздан жасалған ұшақ
Dialogue: 0,0:18:07.01,0:18:10.02,Default,,0,0,0,,Бұл менің жинағым. Мұны кім жасады?
Dialogue: 0,0:18:14.04,0:18:15.06,Default,,0,0,0,,Жоқ, тек кедергі келтіресің.
Dialogue: 0,0:18:15.08,0:18:18.00,Default,,0,0,0,,Нарудың ұшағы жақсы ұшады.
Dialogue: 0,0:18:18.02,0:18:19.07,Default,,0,0,0,,Жел соқса, мен ұша аламын
Dialogue: 0,0:18:20.04,0:18:23.08,Default,,0,0,0,,Мұғалім, ұшайық
Dialogue: 0,0:18:27.05,0:18:29.04,Default,,0,0,0,,Алаяқтар
Dialogue: 0,0:18:29.05,0:18:31.08,Default,,0,0,0,,Мұғалім бірдеңе айтты.
Dialogue: 0,0:18:32.07,0:18:34.00,Default,,0,0,0,,Жалғастырыңыз.
Dialogue: 0,0:18:35.07,0:18:37.06,Default,,0,0,0,,Менің әдемі жазуым туралы не айтасың?
Dialogue: 0,0:18:38.04,0:18:41.04,Default,,0,0,0,,Әкемнің айтқанындай жазғаным жақсы жазылған қолжазба.
Dialogue: 0,0:18:42.04,0:18:43.08,Default,,0,0,0,,Мен ашулануға қарсы емеспін.
Dialogue: 0,0:18:43.09,0:18:48.06,Default,,0,0,0,,Мен тек Киёшу Ханда жаза алатын кейіпкерлерді жазғым келеді.
Dialogue: 0,0:18:50.02,0:18:51.07,Default,,0,0,0,,Мен дұрыс жауаптың қандай екенін білмеймін.
Dialogue: 0,0:18:52.06,0:18:54.02,Default,,0,0,0,,Сенің сөздерің мені тітіркендіреді
Dialogue: 0,0:18:54.02,0:18:56.04,Default,,0,0,0,,Токиоға оралғанда бірдеңе өзгереді.
Dialogue: 0,0:18:57.08,0:19:01.02,Default,,0,0,0,,Мен мұнда өзгерткім келеді.
Dialogue: 0,0:19:05.03,0:19:07.07,Default,,0,0,0,,Балалар сендерге қауіп төніп тұр, түсіңдер.
Dialogue: 0,0:19:08.00,0:19:08.50,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:10.06,0:19:12.08,Default,,0,0,0,,Барыңыз да, біраз күтіңіз.
Dialogue: 0,0:19:14.03,0:19:16.07,Default,,0,0,0,,Желге мініп, сені қуып жетемін.
Dialogue: 0,0:19:18.02,0:19:21.02,Default,,0,0,0,,Мұғалім, жаңа айтқан жолды қайталаңыз.
Dialogue: 0,0:19:22.06,0:19:25.06,Default,,0,0,0,,Мен күткеннен де жақсы болып шықты.
Dialogue: 0,0:19:26.00,0:19:27.04,Default,,0,0,0,,Нару, әкімге қоңырау шалыңыз.
Dialogue: 0,0:19:27.08,0:19:29.07,Default,,0,0,0,,Хина, сен мұз ал.
Dialogue: 0,0:19:34.01,0:19:38.06,Default,,0,0,0,,Өкінішке орай, ол әлі де өсуі керек.
Dialogue: 0,0:19:39.08,0:19:42.00,Default,,0,0,0,,Мен де бар күшімді салуым керек
Dialogue: 0,0:19:46.05,0:19:48.05,Default,,0,0,0,,Бұл жігіт неге үйде?
Dialogue: 0,0:19:48.08,0:19:49.09,Default,,0,0,0,,Көп нәрсе болды.
Dialogue: 0,0:19:50.03,0:19:53.09,Default,,0,0,0,,Жас кезде кешкі асты жасау оңай.
Dialogue: 0,0:19:54.02,0:19:56.02,Default,,0,0,0,,Бұл кемпірдің бояуы емес.
Dialogue: 0,0:19:56.03,0:19:59.06,Default,,0,0,0,,Мен ұрамын, соғамын, шпательмен ұрамын.
Dialogue: 0,0:20:00.06,0:20:01.09,Default,,0,0,0,,Иә, сэр.
Dialogue: 0,0:20:02.02,0:20:05.07,Default,,0,0,0,,Дәл қазір Нару бүкіл ауылға шағын журналдар таратып берді.
Dialogue: 0,0:20:06.05,0:20:09.05,Default,,0,0,0,,Сенсей, бұл әйгілі біреу болса керек.
Dialogue: 0,0:20:10.06,0:20:10.56,Default,,0,0,0,,Умм
Dialogue: 0,0:20:13.04,0:20:14.08,Default,,0,0,0,,Осы жерге қол қойыңыз, мен оны аламын.
Dialogue: 0,0:20:15.04,0:20:17.07,Default,,0,0,0,,Сенің ата-анаңның маған өкпесі бар ма?
Dialogue: 0,0:20:18.02,0:20:19.06,Default,,0,0,0,,Бірдеңе дұрыс емес.
Dialogue: 0,0:20:19.08,0:20:23.04,Default,,0,0,0,,Ең алдымен белгілер бар ма?
Dialogue: 0,0:20:24.09,0:20:28.03,Default,,0,0,0,,Мм, олар ертерек ауылға таратып жатқан еді.
Dialogue: 0,0:20:28.07,0:20:30.03,Default,,0,0,0,,Мұғалім, мен көрдім.
Dialogue: 0,0:20:31.04,0:20:32.00,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:20:32.03,0:20:36.05,Default,,0,0,0,,Токиодағы кітап дүкенінен алынған кітап - үлкен мәселе.
Dialogue: 0,0:20:33.09,0:20:35.03,Default,,0,0,0,,Қол қою қажет
Dialogue: 0,0:20:35.03,0:20:37.06,Default,,0,0,0,,Футболкадағы түрлі-түсті қағаз және басқа материалдар
Dialogue: 0,0:20:37.02,0:20:39.05,Default,,0,0,0,,Жай ғана Сенсей деп атауға болады.
Dialogue: 0,0:20:39.08,0:20:43.03,Default,,0,0,0,,Мен үшін каллиграфия – талғампаз ауаның тынысы.
Dialogue: 0,0:20:43.06,0:20:45.04,Default,,0,0,0,,Катарсиске шақыру...
Dialogue: 0,0:20:44.00,0:20:44.50,Default,,0,0,0,,Тоқта
Dialogue: 0,0:20:46.02,0:20:48.09,Default,,0,0,0,,Токиоға қайту
Dialogue: 0,0:20:50.01,0:20:52.05,Default,,0,0,0,,Сіз кішкентай қолыңызды создыңыз
Dialogue: 0,0:20:52.06,0:20:58.04,Default,,0,0,0,,Саған ұқсап күлу табиғи болды
Dialogue: 0,0:21:01.00,0:21:03.06,Default,,0,0,0,,Оның мағынасы болмауы мүмкін
Dialogue: 0,0:21:03.08,0:21:09.03,Default,,0,0,0,,бірақ бұл мен істей алмайтын нәрсе
Dialogue: 0,0:21:11.07,0:21:15.04,Default,,0,0,0,,Сен ойланбастан қолыма тидің
Dialogue: 0,0:21:15.04,0:21:19.02,Default,,0,0,0,,бірақ бұл мен үшін жақсы болды
Dialogue: 0,0:21:22.01,0:21:27.05,Default,,0,0,0,,Біз сенген барлық уақытта
Dialogue: 0,0:21:27.06,0:21:33.00,Default,,0,0,0,,дүние біздің қолымызда болды
Dialogue: 0,0:21:33.02,0:21:35.09,Default,,0,0,0,,Біз қателестік
Dialogue: 0,0:21:35.09,0:21:44.00,Default,,0,0,0,,мүмкін бұл сен менің қолымды ұстап тұрғандықтан емес шығар
Dialogue: 0,0:21:44.00,0:21:49.06,Default,,0,0,0,,Әр сәтте
Dialogue: 0,0:21:49.07,0:21:55.01,Default,,0,0,0,,Барлық жерде
Dialogue: 0,0:21:55.02,0:22:00.05,Default,,0,0,0,,Мен сене аламын, сене аламын
Dialogue: 0,0:22:00.08,0:22:05.06,Default,,0,0,0,,Жылы алақаныңды ұстағанда
Dialogue: 0,0:22:05.07,0:22:13.00,Default,,0,0,0,,сіздің жылы қолыңыз
Dialogue: 0,0:22:20.06,0:22:21.08,Default,,0,0,0,,Лас поке добы
Dialogue: 0,0:22:22.08,0:22:23.07,Default,,0,0,0,,Қайырлы кеш
Dialogue: 0,0:22:24.08,0:22:26.01,Default,,0,0,0,,Біртүрлі заттарды сақтамаңыз
Dialogue: 0,0:22:26.02,0:22:27.00,Default,,0,0,0,,Мен сонда бардым
Dialogue: 0,0:22:27.00,0:22:30.07,Default,,0,0,0,,Есеп бер. Жоқ, көмектесіңізші, мен Токиоға қайтамын.
Dialogue: 0,0:22:31.00,0:22:32.09,Default,,0,0,0,,Хироси Хироши
Dialogue: 0,0:22:32.09,0:22:36.05,Default,,0,0,0,,Бұл қауіпті, бұл қауіпті, қазірдің өзінде
Dialogue: 0,0:22:36.05,0:22:38.01,Default,,0,0,0,,Мұғалім, мен сізді жібере аламын ба?
Dialogue: 0,0:22:41.09,0:22:46.05,Default,,0,0,0,,Жауынгерлік жеке құрамды көбейту
Dialogue: 0,0:22:47.55,0:22:52.55,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
