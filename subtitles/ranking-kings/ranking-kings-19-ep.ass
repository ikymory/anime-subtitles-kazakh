Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.34,0:00:10.55,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:00:16.35,0:00:18.48,Default,,0,0,0,,О, қандай ақымақтық...
Dialogue: 0,0:00:19.81,0:00:22.15,Default,,0,0,0,,Hehehe Bodge…
Dialogue: 0,0:00:24.90,0:00:25.73,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:26.23,0:00:28.65,Default,,0,0,0,,А... Жарайды.
Dialogue: 0,0:00:29.61,0:00:30.15,Default,,0,0,0,,Ga!
Dialogue: 0,0:00:33.49,0:00:35.49,Default,,0,0,0,,♪~
Dialogue: 0,0:01:58.20,0:02:00.20,Default,,0,0,0,,~♪
Dialogue: 0,0:02:09.21,0:02:12.88,Default,,0,0,0,,Біз Хоумаға барлығын жоғалттық.
Dialogue: 0,0:02:13.38,0:02:15.63,Default,,0,0,0,,Бұл ел бай болды
Dialogue: 0,0:02:15.72,0:02:18.43,Default,,0,0,0,,Хоума басып алынды!
Dialogue: 0,0:02:19.18,0:02:20.56,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,0:02:23.31,0:02:25.52,Default,,0,0,0,,Бір қарағанда бай көрінеді, бірақ солай емес пе?
Dialogue: 0,0:02:32.61,0:02:34.32,Default,,0,0,0,,Сіз қалай ойлайсыз? Эй
Dialogue: 0,0:02:34.40,0:02:35.36,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:02:39.99,0:02:41.99,Default,,0,0,0,,L өліпті
Dialogue: 0,0:02:42.49,0:02:45.21,Default,,0,0,0,,Енді біз осындамыз, бәрі жақсы.
Dialogue: 0,0:02:45.29,0:02:46.71,Default,,0,0,0,,О...
Dialogue: 0,0:02:46.79,0:02:48.04,Default,,0,0,0,,Елге қайту?
Dialogue: 0,0:02:50.17,0:02:52.00,Default,,0,0,0,,Гьякуза жалғыз қалғандықтан ба?
Dialogue: 0,0:02:52.67,0:02:55.47,Default,,0,0,0,,Жарайды, мен оны құл еткім келеді, бірақ...
Dialogue: 0,0:02:57.43,0:03:00.18,Default,,0,0,0,,Болашақта аударатын адам қалмайды.
Dialogue: 0,0:03:00.85,0:03:02.39,Default,,0,0,0,,Қашқан Хоума халқы кім болды?
Dialogue: 0,0:03:02.47,0:03:06.64,Default,,0,0,0,,Жақсы, оларды жайына қалдырыңыз, олар қазір бітті.
Dialogue: 0,0:03:06.73,0:03:09.10,Default,,0,0,0,,Сондай-ақ құдайлар.
Dialogue: 0,0:03:09.19,0:03:13.36,Default,,0,0,0,,Адамдарды басқарудың жаңа жолдарын табудың уақыты келді.
Dialogue: 0,0:03:14.82,0:03:16.28,Default,,0,0,0,,Хоуманың қарсылығы
Dialogue: 0,0:03:16.36,0:03:19.07,Default,,0,0,0,,Мен құдайлар мен адамдардың санасын сәл өзгерттім.
Dialogue: 0,0:03:20.20,0:03:22.78,Default,,0,0,0,,Өйткені, біз де монолитті емеспіз.
Dialogue: 0,0:03:23.79,0:03:27.08,Default,,0,0,0,,Адамзаттың нұры артып, даналығы артады.
Dialogue: 0,0:03:28.12,0:03:30.54,Default,,0,0,0,,Ежелгі күш тез жоғалады.
Dialogue: 0,0:03:31.04,0:03:33.80,Default,,0,0,0,,Енді біздің уақыт емес
Dialogue: 0,0:03:36.05,0:03:39.38,Default,,0,0,0,,Ал Хоума... оларға не болды?
Dialogue: 0,0:03:41.72,0:03:44.81,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:03:48.43,0:03:49.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:54.69,0:03:56.44,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:57.94,0:03:58.90,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:02.66,0:04:03.78,Default,,0,0,0,,Ха!
Dialogue: 0,0:04:04.70,0:04:06.16,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:06.87,0:04:10.62,Default,,0,0,0,,Бұл сіздің әділдігіңіз бе?
Dialogue: 0,0:04:11.58,0:04:13.46,Default,,0,0,0,,Хмм!
Dialogue: 0,0:04:13.54,0:04:15.75,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:04:15.84,0:04:17.76,Default,,0,0,0,,Хихи!
Dialogue: 0,0:04:17.84,0:04:19.22,Default,,0,0,0,,(жаншылған дыбыс)
Dialogue: 0,0:04:20.18,0:04:24.18,Default,,0,0,0,,Біз де бақытты болғымыз келеді
Dialogue: 0,0:04:24.26,0:04:26.89,Default,,0,0,0,,Өтінемін, тек мына бала...
Dialogue: 0,0:04:26.97,0:04:28.85,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:04:28.93,0:04:31.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:31.90,0:04:34.31,Default,,0,0,0,,Угаааааааааааааа!
Dialogue: 0,0:04:34.40,0:04:36.23,Default,,0,0,0,,(ұсақтау дыбысы)
Dialogue: 0,0:04:44.53,0:04:46.12,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:04:46.20,0:04:49.16,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:04:58.25,0:05:02.01,Default,,0,0,0,,Бұл адамның қолынан келетін нәрсе ме?
Dialogue: 0,0:05:02.09,0:05:03.13,Default,,0,0,0,,(сөмкені салу дыбысы)
Dialogue: 0,0:05:03.97,0:05:05.60,Default,,0,0,0,,Мені осымен емдеңіз.
Dialogue: 0,0:05:06.35,0:05:07.76,Default,,0,0,0,,Ана...
Dialogue: 0,0:05:10.39,0:05:13.81,Default,,0,0,0,,Мен Миланхомен тұруды шештім.
Dialogue: 0,0:05:14.94,0:05:18.23,Default,,0,0,0,,Мен оның жымиғанын қалаймын
Dialogue: 0,0:05:20.32,0:05:24.20,Default,,0,0,0,,Бұл қорқынышты оқиға оны өзгертті.
Dialogue: 0,0:05:24.91,0:05:26.49,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:05:27.78,0:05:31.79,Default,,0,0,0,,Сатып кетті, ренжітті, сауықтырған кезде оны қинады.
Dialogue: 0,0:05:32.79,0:05:35.25,Default,,0,0,0,,Мен өзгердім.
Dialogue: 0,0:05:36.00,0:05:37.00,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:05:40.55,0:05:44.34,Default,,0,0,0,,Бастық мырза Мен бастық мырзаға барамын.
Dialogue: 0,0:05:45.05,0:05:48.55,Default,,0,0,0,,Дұрыс, сіз Боджды Десперге айналдырдыңыз...
Dialogue: 0,0:05:49.89,0:05:52.06,Default,,0,0,0,,Ал сол бала күшейе түсті.
Dialogue: 0,0:05:52.73,0:05:55.77,Default,,0,0,0,,Бұл тұлпар жеңілмейтін қарсылас па?
Dialogue: 0,0:05:56.52,0:05:57.23,Default,,0,0,0,,Иә
Dialogue: 0,0:05:57.81,0:05:59.19,Default,,0,0,0,,Айна туралы
Dialogue: 0,0:05:59.86,0:06:02.82,Default,,0,0,0,,Жағдайға байланысты қиып алу
Dialogue: 0,0:06:11.24,0:06:13.37,Default,,0,0,0,,Уф... уф
Dialogue: 0,0:06:16.79,0:06:18.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:18.17,0:06:20.09,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:06:20.63,0:06:22.26,Default,,0,0,0,,Керемет
Dialogue: 0,0:06:25.30,0:06:26.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:27.51,0:06:29.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:49.57,0:06:53.45,Default,,0,0,0,,Гррр... Гррр...
Dialogue: 0,0:07:01.71,0:07:04.30,Default,,0,0,0,,Хахахаха... аа
Dialogue: 0,0:07:05.55,0:07:06.09,Default,,0,0,0,,Ha
Dialogue: 0,0:07:12.10,0:07:14.22,Default,,0,0,0,,Күте тұрыңыз, сіз не істемексіз?
Dialogue: 0,0:07:19.69,0:07:20.77,Default,,0,0,0,,Ах
Dialogue: 0,0:07:37.33,0:07:38.66,Default,,0,0,0,,Менің атым Ая Цуидзи
Dialogue: 0,0:07:52.68,0:07:56.02,Default,,0,0,0,,Анашым, анашым!
Dialogue: 0,0:07:56.10,0:07:59.35,Default,,0,0,0,,Сәлем анашым! Хи хи хи
Dialogue: 0,0:07:59.44,0:08:00.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:00.77,0:08:01.81,Default,,0,0,0,,Кагечан
Dialogue: 0,0:08:04.69,0:08:07.32,Default,,0,0,0,,Каге-чан Каге-чан!
Dialogue: 0,0:08:08.15,0:08:10.49,Default,,0,0,0,,Каге-кунның анасы қайтыс болды?
Dialogue: 0,0:08:10.99,0:08:14.53,Default,,0,0,0,,Ха... Бұл өмір мен өлімнің шекарасындағы дүние ме?
Dialogue: 0,0:08:15.37,0:08:16.99,Default,,0,0,0,,Мен өлдім бе?
Dialogue: 0,0:08:17.50,0:08:19.66,Default,,0,0,0,,Ақшаны үнемдеу үшін көп жұмыс жасасаңыз да?
Dialogue: 0,0:08:19.75,0:08:21.08,Default,,0,0,0,,Оны пайдаланбайсыз ба?
Dialogue: 0,0:08:21.58,0:08:23.79,Default,,0,0,0,,Мен оны жек көремін!
Dialogue: 0,0:08:23.88,0:08:27.92,Default,,0,0,0,,Мен көп ақша жинадым!
Dialogue: 0,0:08:28.51,0:08:30.76,Default,,0,0,0,,Тез кел, Каге-чан.
Dialogue: 0,0:08:30.84,0:08:31.76,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:37.72,0:08:40.31,Default,,0,0,0,,Хе хехе хехе
Dialogue: 0,0:08:42.85,0:08:45.86,Default,,0,0,0,,Жоқ! Кетіп кетсең, тірі қайтып келе алмайсың.
Dialogue: 0,0:08:45.94,0:08:46.48,Default,,0,0,0,,Ах
Dialogue: 0,0:08:46.57,0:08:48.11,Default,,0,0,0,,Каге-кун, жоқ!
Dialogue: 0,0:08:48.19,0:08:50.03,Default,,0,0,0,,А, аа!
Dialogue: 0,0:08:51.28,0:08:52.70,Default,,0,0,0,,Сіз естіген жоқсыз ба?
Dialogue: 0,0:08:53.24,0:08:54.20,Default,,0,0,0,,Иә
Dialogue: 0,0:08:55.12,0:08:55.99,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:59.33,0:09:03.50,Default,,0,0,0,,Біз бұл дүниеде жоқпыз.
Dialogue: 0,0:09:03.58,0:09:06.75,Default,,0,0,0,,Олай болса, біреудің ойында...
Dialogue: 0,0:09:13.55,0:09:15.64,Default,,0,0,0,,Миранджоның ойлары?
Dialogue: 0,0:09:15.72,0:09:17.51,Default,,0,0,0,,Ах! (Үмітсіздік) білдіреді
Dialogue: 0,0:09:17.60,0:09:19.18,Default,,0,0,0,,Мен өлген жоқпын
Dialogue: 0,0:09:19.27,0:09:21.60,Default,,0,0,0,,Әдемі өлмейді ғой.
Dialogue: 0,0:09:22.10,0:09:24.44,Default,,0,0,0,,Бұлай айтатын уақыт емес!
Dialogue: 0,0:09:24.52,0:09:26.06,Default,,0,0,0,,♬~
Dialogue: 0,0:09:26.15,0:09:28.15,Default,,0,0,0,,Анашым!
Dialogue: 0,0:09:28.98,0:09:30.69,Default,,0,0,0,,Кагечан!
Dialogue: 0,0:09:31.19,0:09:33.95,Default,,0,0,0,,Жоқ! Жоқ, Каге-кун!
Dialogue: 0,0:09:34.03,0:09:35.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:35.99,0:09:37.70,Default,,0,0,0,,Ана
Dialogue: 0,0:09:40.54,0:09:41.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:46.50,0:09:50.63,Default,,0,0,0,,Егер сіз кесіп өтсеңіз, мұнда ешқашан оралмайсыз.
Dialogue: 0,0:09:50.71,0:09:51.67,Default,,0,0,0,,Миланхо!
Dialogue: 0,0:09:51.76,0:09:52.59,Default,,0,0,0,,Иано
Dialogue: 0,0:09:53.26,0:09:54.80,Default,,0,0,0,,Бұл сен бе?
Dialogue: 0,0:09:55.38,0:09:57.51,Default,,0,0,0,,Бұл дүниеде өкінетін кезің бар ма?
Dialogue: 0,0:09:57.60,0:10:00.14,Default,,0,0,0,,Бұл дүние? Тренингсіз бе?
Dialogue: 0,0:10:00.64,0:10:01.93,Default,,0,0,0,,Каге-чан!
Dialogue: 0,0:10:02.81,0:10:05.44,Default,,0,0,0,,Кел, Каге-чан.
Dialogue: 0,0:10:06.10,0:10:07.40,Default,,0,0,0,,Анашым...
Dialogue: 0,0:10:08.90,0:10:11.90,Default,,0,0,0,,Ах... Бодж!
Dialogue: 0,0:10:11.98,0:10:13.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:13.95,0:10:15.32,Default,,0,0,0,,Бодж…
Dialogue: 0,0:10:16.57,0:10:18.74,Default,,0,0,0,,Bodge Bodge Bodge…
Dialogue: 0,0:10:19.87,0:10:24.50,Default,,0,0,0,,Bodge Bodge Bodge!
Dialogue: 0,0:10:30.75,0:10:33.09,Default,,0,0,0,,Каге-чан, мұнда тез кел.
Dialogue: 0,0:10:33.59,0:10:36.93,Default,,0,0,0,,Сіздің өміріңіз аяқталды! Кәне!
Dialogue: 0,0:10:39.01,0:10:43.14,Default,,0,0,0,,Ана... Мен Боджаға көмектескім келеді.
Dialogue: 0,0:10:43.22,0:10:44.02,Default,,0,0,0,,Ха…
Dialogue: 0,0:10:47.35,0:10:50.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:54.99,0:10:55.95,Default,,0,0,0,,Ана
Dialogue: 0,0:10:58.11,0:11:00.74,Default,,0,0,0,,Бұл туралы не деуге болады? Қалыңыз қалай?
Dialogue: 0,0:11:03.24,0:11:05.12,Default,,0,0,0,,Иә, бұл қызық.
Dialogue: 0,0:11:05.20,0:11:09.42,Default,,0,0,0,,Менде шағым жоқ, бәрі риза.
Dialogue: 0,0:11:10.13,0:11:11.21,Default,,0,0,0,,Жақсы
Dialogue: 0,0:11:12.55,0:11:15.92,Default,,0,0,0,,Анашым, менің аяқталмаған ісім бар.
Dialogue: 0,0:11:16.51,0:11:17.88,Default,,0,0,0,,қайтып кел
Dialogue: 0,0:11:21.64,0:11:22.56,Default,,0,0,0,,Иә
Dialogue: 0,0:11:23.64,0:11:27.39,Default,,0,0,0,,Дұрыс орында... дұрыс істе!
Dialogue: 0,0:11:28.06,0:11:31.02,Default,,0,0,0,,Иә! Мен мұнда кейінірек оралатыныма сенімдімін
Dialogue: 0,0:11:31.52,0:11:34.73,Default,,0,0,0,,Бірақ мен қартайдым, сондықтан анам байқамауы мүмкін.
Dialogue: 0,0:11:34.82,0:11:39.20,Default,,0,0,0,,Иә, иә, иә... Мен күтемін.
Dialogue: 0,0:11:41.03,0:11:41.82,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:47.75,0:11:51.17,Default,,0,0,0,,Каге-чан, маған бетіңді жақсырақ көрсетші.
Dialogue: 0,0:11:51.67,0:11:52.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:57.01,0:12:00.26,Default,,0,0,0,,Сәттілік Кадже-чан
Dialogue: 0,0:12:01.01,0:12:01.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:11.48,0:12:12.31,Default,,0,0,0,,Хмф!
Dialogue: 0,0:12:14.23,0:12:16.03,Default,,0,0,0,,Сіз қайтып келгенде
Dialogue: 0,0:12:16.11,0:12:17.49,Default,,0,0,0,,Сізді ешкім құтқара алмайды.
Dialogue: 0,0:12:17.57,0:12:18.49,Default,,0,0,0,,Хмф!
Dialogue: 0,0:12:18.57,0:12:21.32,Default,,0,0,0,,Сіз Миланхосыз ба? дауысы бірдей
Dialogue: 0,0:12:21.82,0:12:23.45,Default,,0,0,0,,Маған неге көмектесіп жатырсың?
Dialogue: 0,0:12:25.49,0:12:28.70,Default,,0,0,0,,Мен шынымен түсінбеймін, бірақ мен сізге рахмет айтамын.
Dialogue: 0,0:12:29.21,0:12:33.21,Default,,0,0,0,,Мм... Сіз мұны орнатқаныңызға қарамастан, сізге алғыс айту біртүрлі ме?
Dialogue: 0,0:12:33.79,0:12:34.59,Default,,0,0,0,,Хун
Dialogue: 0,0:12:34.67,0:12:36.88,Default,,0,0,0,,Жоқ рахмет.
Dialogue: 0,0:12:36.96,0:12:38.21,Default,,0,0,0,,Ах
Dialogue: 0,0:12:38.92,0:12:41.88,Default,,0,0,0,,Бодж~ Қазір кеттік~!
Dialogue: 0,0:12:58.53,0:12:59.19,Default,,0,0,0,,Ha
Dialogue: 0,0:13:07.54,0:13:08.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:13.62,0:13:14.17,Default,,0,0,0,,Эй!
Dialogue: 0,0:13:23.63,0:13:24.55,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:24.64,0:13:27.51,Default,,0,0,0,,Иә, иә, бұл жақсы болды.
Dialogue: 0,0:13:29.68,0:13:30.22,Default,,0,0,0,,Иә
Dialogue: 0,0:13:30.31,0:13:32.60,Default,,0,0,0,,Ол дәл қазір қозғалды.
Dialogue: 0,0:13:34.48,0:13:35.69,Default,,0,0,0,,қатты алданып қалады
Dialogue: 0,0:13:36.52,0:13:38.94,Default,,0,0,0,,Мен құтқарылғаныма сенімдімін.
Dialogue: 0,0:13:39.94,0:13:40.90,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:40.99,0:13:43.24,Default,,0,0,0,,Күте тұрыңыз, кетпеңіз!
Dialogue: 0,0:13:43.32,0:13:45.24,Default,,0,0,0,,Мені жалғыз қалдырмаңыз!
Dialogue: 0,0:13:47.53,0:13:50.41,Default,,0,0,0,,Жарайды, жақын арада...
Dialogue: 0,0:13:51.41,0:13:52.46,Default,,0,0,0,,Жақында?
Dialogue: 0,0:13:53.29,0:13:55.04,Default,,0,0,0,,Жақында не болады?
Dialogue: 0,0:13:58.84,0:13:59.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:18.06,0:14:19.23,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:14:19.32,0:14:22.19,Default,,0,0,0,,Лорд Хиллингтің қуаты таусылды.
Dialogue: 0,0:14:22.78,0:14:23.82,Default,,0,0,0,,Көмек бере алмаймын
Dialogue: 0,0:14:30.83,0:14:32.41,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:14:35.41,0:14:36.37,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:54.18,0:14:54.93,Default,,0,0,0,,Аһ!
Dialogue: 0,0:14:56.52,0:14:58.31,Default,,0,0,0,,(Қан жұтып жатқан дыбыс)
Dialogue: 0,0:15:01.15,0:15:04.03,Default,,0,0,0,,Ах, ха...
Dialogue: 0,0:15:10.78,0:15:11.78,Default,,0,0,0,,Біреу...
Dialogue: 0,0:15:19.92,0:15:22.17,Default,,0,0,0,,Не істеп жатырсың, бейбақ?
Dialogue: 0,0:15:22.25,0:15:23.67,Default,,0,0,0,,Мистер Бевин...
Dialogue: 0,0:15:24.21,0:15:24.96,Default,,0,0,0,,Мицумата
Dialogue: 0,0:15:25.05,0:15:27.93,Default,,0,0,0,,Ха ха ха... Не!
Dialogue: 0,0:15:31.97,0:15:33.47,Default,,0,0,0,,Бұл жігіт өлмейтін.
Dialogue: 0,0:15:33.56,0:15:34.60,Default,,0,0,0,,Өлмейтіндік?
Dialogue: 0,0:15:34.68,0:15:38.35,Default,,0,0,0,,Сондықтан оған қарсы тұру және оны ұстау мүмкін емес етуден басқа амалымыз жоқ.
Dialogue: 0,0:15:39.10,0:15:40.35,Default,,0,0,0,,Қызықты
Dialogue: 0,0:15:40.44,0:15:42.31,Default,,0,0,0,,Жапония мен Батыстың қарапайым ақыл-кеуілі мүлде жарамайды.
Dialogue: 0,0:15:42.40,0:15:43.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:46.82,0:15:48.20,Default,,0,0,0,,Құрметті Миланхо!
Dialogue: 0,0:15:48.78,0:15:50.61,Default,,0,0,0,,Жоқ... қайда?
Dialogue: 0,0:15:50.70,0:15:54.37,Default,,0,0,0,,Құрметті Домас! Бодж мырзаның қаны тоқтамайды
Dialogue: 0,0:15:54.45,0:15:57.08,Default,,0,0,0,,Осы қарқынмен...Асығыңыз, Хиллинг мырза!
Dialogue: 0,0:15:57.16,0:16:00.46,Default,,0,0,0,,Мистер Хиллингте билік қазірдің өзінде бар...
Dialogue: 0,0:16:00.54,0:16:02.92,Default,,0,0,0,,Міне...
Dialogue: 0,0:16:03.00,0:16:05.05,Default,,0,0,0,,Жоқ, басқасы бар.
Dialogue: 0,0:16:05.13,0:16:08.88,Default,,0,0,0,,Иә, сізді емдей алатын басқа адам бар.
Dialogue: 0,0:16:08.97,0:16:10.76,Default,,0,0,0,,Кофе жасау, яғни
Dialogue: 0,0:16:10.84,0:16:12.76,Default,,0,0,0,,Бұл біздің күш-жігерімізге байланысты.
Dialogue: 0,0:16:16.81,0:16:18.18,Default,,0,0,0,,Маған орындауға рұқсат етіңіз
Dialogue: 0,0:16:18.93,0:16:21.15,Default,,0,0,0,,Домус Сақтанбаңыз.
Dialogue: 0,0:16:21.98,0:16:23.11,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:16:24.02,0:16:27.57,Default,,0,0,0,,Бодж мырза, сіз қорқынышты күшті болдыңыз.
Dialogue: 0,0:16:28.49,0:16:30.82,Default,,0,0,0,,Мен сенімен бәсекелесе алмаймын
Dialogue: 0,0:16:34.03,0:16:36.54,Default,,0,0,0,,Бұл жігіт Бодж мырзаны жеңді.
Dialogue: 0,0:16:37.08,0:16:40.83,Default,,0,0,0,,Алайда, өлмес қарсыласқа қарсы Бодждың ине қылыш...
Dialogue: 0,0:16:40.91,0:16:43.29,Default,,0,0,0,,Үйлесімділік ең нашар болған шығар.
Dialogue: 0,0:16:44.75,0:16:48.51,Default,,0,0,0,,Сол жіңішке қылыш менің қылышымды ұстай ала ма?
Dialogue: 0,0:16:49.80,0:16:50.51,Default,,0,0,0,,Геге?
Dialogue: 0,0:16:51.68,0:16:52.59,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:16:54.47,0:16:55.30,Default,,0,0,0,,Уф
Dialogue: 0,0:17:00.06,0:17:02.56,Default,,0,0,0,,Тастап шабуыл жасай білу күшті.
Dialogue: 0,0:17:02.65,0:17:04.69,Default,,0,0,0,,Онда мен қылышты сындырамын!
Dialogue: 0,0:17:08.57,0:17:10.24,Default,,0,0,0,,Гррр…
Dialogue: 0,0:17:13.99,0:17:15.49,Default,,0,0,0,,Содан кейін кезекте тұрғандарды жақсылап ұрып, ақшаларын тартып алады
Dialogue: 0,0:17:15.99,0:17:18.87,Default,,0,0,0,,Бірақ мен қылышпен жақсырақпын...
Dialogue: 0,0:17:19.62,0:17:20.54,Default,,0,0,0,,Эй!
Dialogue: 0,0:17:23.92,0:17:25.04,Default,,0,0,0,,О!
Dialogue: 0,0:17:25.13,0:17:26.00,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:17:26.84,0:17:27.38,Default,,0,0,0,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:17:27.46,0:17:28.59,Default,,0,0,0,,О...
Dialogue: 0,0:17:29.92,0:17:32.63,Default,,0,0,0,,Бұл карта сәл ақымақтай көрінбей ме?
Dialogue: 0,0:17:33.43,0:17:34.34,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:34.93,0:17:36.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:51.90,0:17:53.78,Default,,0,0,0,,Бевин Бұл не?
Dialogue: 0,0:17:53.86,0:17:55.28,Default,,0,0,0,,Рух және жасандылық
Dialogue: 0,0:17:55.36,0:17:58.41,Default,,0,0,0,,Бөтен заттарды лақтырып, қарсыластың қимылын тоқтататын әдіс.
Dialogue: 0,0:17:58.49,0:18:02.50,Default,,0,0,0,,Ал өлмейтін қанның кесірінен семсер де сынбайды.
Dialogue: 0,0:18:02.58,0:18:04.50,Default,,0,0,0,,Сіз Бевинді танисыз ба?
Dialogue: 0,0:18:04.58,0:18:06.04,Default,,0,0,0,,Бәрі жақсы. Ең болмағанда бұл жабайы аңдардың аумағы емес.
Dialogue: 0,0:18:06.13,0:18:08.42,Default,,0,0,0,,Көру – сену
Dialogue: 0,0:18:08.50,0:18:11.21,Default,,0,0,0,,Артымдағы екі адамға көрсеткім келді.
Dialogue: 0,0:18:11.30,0:18:14.63,Default,,0,0,0,,Ху~ Ал, жасайық.
Dialogue: 0,0:18:14.72,0:18:15.34,Default,,0,0,0,,О!
Dialogue: 0,0:18:20.64,0:18:22.85,Default,,0,0,0,,Хмф! Ха!
Dialogue: 0,0:18:23.98,0:18:25.14,Default,,0,0,0,,Эй!
Dialogue: 0,0:18:26.56,0:18:27.48,Default,,0,0,0,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:18:30.11,0:18:32.23,Default,,0,0,0,,Гегегеге…
Dialogue: 0,0:18:32.74,0:18:33.61,Default,,0,0,0,,Йокояри!
Dialogue: 0,0:18:34.65,0:18:36.16,Default,,0,0,0,,Геге... Гах!
Dialogue: 0,0:18:36.24,0:18:38.28,Default,,0,0,0,,Хмф, сен бірдеңе істедің бе?
Dialogue: 0,0:18:43.79,0:18:46.25,Default,,0,0,0,,Әлі де соғу қиын.
Dialogue: 0,0:18:46.33,0:18:48.33,Default,,0,0,0,,Мен пышақтарға қарсы өте әлсізмін.
Dialogue: 0,0:18:48.42,0:18:49.54,Default,,0,0,0,,Не?
Dialogue: 0,0:18:49.63,0:18:51.67,Default,,0,0,0,,Қарсылық жасамаңыз!
Dialogue: 0,0:18:51.75,0:18:54.26,Default,,0,0,0,,Құнды заттың бәрін аламын!
Dialogue: 0,0:18:54.34,0:18:56.97,Default,,0,0,0,,Fufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufufu
Dialogue: 0,0:18:57.55,0:18:59.18,Default,,0,0,0,,Бұл аяқталды.
Dialogue: 0,0:18:59.26,0:19:00.97,Default,,0,0,0,,Аспандағы төрт патша күткендей
Dialogue: 0,0:19:01.51,0:19:04.14,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:19:07.44,0:19:08.10,Default,,0,0,0,,Ішек
Dialogue: 0,0:19:08.19,0:19:09.48,Default,,0,0,0,,Тәңір
Dialogue: 0,0:19:09.56,0:19:12.36,Default,,0,0,0,,Енді осы жерден не істеуіміз керек?
Dialogue: 0,0:19:12.44,0:19:16.49,Default,,0,0,0,,(Оукеннің ыңырануы)
Dialogue: 0,0:19:16.99,0:19:20.28,Default,,0,0,0,,Асықпай, жаудың ырғағын оқы.
Dialogue: 0,0:19:20.37,0:19:22.28,Default,,0,0,0,,Ағынмен жүріңіз
Dialogue: 0,0:19:23.45,0:19:25.33,Default,,0,0,0,,Енді жау ағып жатыр
Dialogue: 0,0:19:28.46,0:19:29.96,Default,,0,0,0,,Әлі жоқ
Dialogue: 0,0:19:32.54,0:19:34.38,Default,,0,0,0,,Тренинг сізді сатпайды
Dialogue: 0,0:19:34.88,0:19:38.51,Default,,0,0,0,,Оның шынайы мәні сіз шымшу кезінде көрсетіледі.
Dialogue: 0,0:19:40.09,0:19:44.81,Default,,0,0,0,,Дағдарыс - ең үлкен мүмкіндік, Оукен.
Dialogue: 0,0:19:45.31,0:19:47.23,Default,,0,0,0,,Ааааа…
Dialogue: 0,0:19:49.19,0:19:50.15,Default,,0,0,0,,О!
Dialogue: 0,0:20:00.49,0:20:03.03,Default,,0,0,0,,Сіз оятуға болады
Dialogue: 0,0:20:04.03,0:20:06.54,Default,,0,0,0,,Бұл сезім.
Dialogue: 0,0:20:07.29,0:20:09.37,Default,,0,0,0,,Қылыш жер асты патшасы
Dialogue: 0,0:20:19.47,0:20:22.18,Default,,0,0,0,,Бұл бір түрлі маскүнемдік.
Dialogue: 0,0:20:24.10,0:20:24.85,Default,,0,0,0,,Уф
Dialogue: 0,0:20:25.93,0:20:26.43,Default,,0,0,0,,Тек бір сәттек ойыңмен одан көшіп кету...
Dialogue: 0,0:20:26.52,0:20:27.47,Default,,0,0,0,,Не?
Dialogue: 0,0:20:29.31,0:20:30.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:30.44,0:20:31.06,Default,,0,0,0,,Тек бір сәттек ойыңмен одан көшіп кету...
Dialogue: 0,0:20:31.14,0:20:32.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:32.23,0:20:34.31,Default,,0,0,0,,Осы жолмен! (Домас) Эй!
Dialogue: 0,0:20:34.40,0:20:35.36,Default,,0,0,0,,Гах (2 адам) Ух...
Dialogue: 0,0:20:36.23,0:20:38.15,Default,,0,0,0,,Гах... (Друши) Гах...
Dialogue: 0,0:20:40.95,0:20:41.99,Default,,0,0,0,,Бұл… түс.
Dialogue: 0,0:20:49.58,0:20:51.46,Default,,0,0,0,,Өте қиын болды… Өтінемін, мені жалғыз қалдыр.
Dialogue: 0,0:20:53.50,0:20:55.00,Default,,0,0,0,,Хмм... иә?
Dialogue: 0,0:20:57.67,0:20:59.21,Default,,0,0,0,,Біз төрт аспан патшамыз
Dialogue: 0,0:20:59.30,0:21:03.01,Default,,0,0,0,,Ха! о дұрыс
Dialogue: 0,0:21:07.18,0:21:08.52,Default,,0,0,0,,Біз...
Dialogue: 0,0:21:09.02,0:21:10.98,Default,,0,0,0,,Соңғы бекініс!
Dialogue: 0,0:21:20.40,0:21:22.40,Default,,0,0,0,,♪~
Dialogue: 0,0:22:47.74,0:22:49.74,Default,,0,0,0,,~♪
Dialogue: 0,0:22:51.24,0:22:56.24,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
