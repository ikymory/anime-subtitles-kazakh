Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.55,0:00:07.55,CNsub,NTP,0,0,0,,КамиГами
Dialogue: 0,1:53:46.65,1:53:51.65,CNsub,NTP,0,0,0,,＠/···
Dialogue: 0,1:46:06.86,1:46:13.37,EDJ,NTP,0000,0000,0000,,Сізбен кездесу
Dialogue: 0,1:46:13.56,1:46:17.87,EDJ,NTP,0000,0000,0000,,Орындалмайтын арманым бар еді
Dialogue: 0,1:46:18.77,1:46:30.82,EDJ,NTP,0000,0000,0000,,Бұл бір секундта өтетін мәңгілік
Dialogue: 0,1:46:31.14,1:46:42.92,EDJ,NTP,0000,0000,0000,,Мен қоңырау шалып жатырмын, сені қорғағым келеді
Dialogue: 0,1:46:43.21,1:46:55.74,EDJ,NTP,0000,0000,0000,,Мен сені құшақтап жатқанда тіпті созылған саусақтарым дірілдеп тұрды.
Dialogue: 0,1:46:55.89,1:47:00.56,EDJ,NTP,0000,0000,0000,,Біздің қолымыздан келетіні – тірі қалу.
Dialogue: 0,1:47:00.70,1:47:07.60,EDJ,NTP,0000,0000,0000,,Күшім таусылғанша, дәрменсіз айқайлай берем, болды.
Dialogue: 0,1:47:07.65,1:47:10.32,EDJ,NTP,0000,0000,0000,,Ол сізбен бірге келе ме? Мен оған жете аламын ба?
Dialogue: 0,1:47:10.42,1:47:16.90,EDJ,NTP,0000,0000,0000,,Үмітсіздіктің тәттілігін жойып, дәл қазір жүгіруді бастаңыз
Dialogue: 0,1:47:17.06,1:47:19.40,EDJ,NTP,0000,0000,0000,,Спиральдың соңына дейін
Dialogue: 0,1:47:19.46,1:47:30.96,EDJ,NTP,0000,0000,0000,,Шақырамын Әнім алыста
Dialogue: 0,1:47:31.18,1:47:41.47,EDJ,NTP,0000,0000,0000,,Жаның аспанға бұрылса
Dialogue: 0,1:47:41.66,1:47:49.89,EDJ,NTP,0000,0000,0000,,Сіз жалғыз емессіз...
Dialogue: 0,1:47:52.58,1:48:00.40,EDJ,NTP,0000,0000,0000,,Жалаңаш ақиқат тіпті бұл шиеленіскен жүректе
Dialogue: 0,1:48:00.72,1:48:07.02,EDJ,NTP,0000,0000,0000,,Оның бітеліп қалғаны сонша, толып кетті.
Dialogue: 0,1:48:07.08,1:48:14.19,EDJ,NTP,0000,0000,0000,,Жарық жылдамдығымен өшетін кешегі күнге қол бұлғау
Dialogue: 0,1:48:14.26,1:48:18.70,EDJ,NTP,0000,0000,0000,,Барлық жерде жарық шөл
Dialogue: 0,1:48:18.76,1:48:30.66,EDJ,NTP,0000,0000,0000,,Енді біз уақытты теуіп, жүгіріп келеміз.
Dialogue: 0,1:48:30.80,1:48:42.25,EDJ,NTP,0000,0000,0000,,Жыртылған жалауды желге қарсы желбірету
Dialogue: 0,1:48:42.77,1:48:55.14,EDJ,NTP,0000,0000,0000,,Сенсіз жолда мен өзім үшін
Dialogue: 0,1:48:55.43,1:49:01.57,EDJ,NTP,0000,0000,0000,,Мен барамын...
Dialogue: 0,1:49:02.80,1:49:07.89,EDJ,NTP,0000,0000,0000,,Спиральдың соңына дейін...
Dialogue: 0,1:49:07.94,1:49:13.33,EDJ,NTP,0000,0000,0000,,Мен сені көргім келеді
Dialogue: 0,1:49:13.61,1:49:19.33,EDJ,NTP,0000,0000,0000,,Мен сені сағындым
Dialogue: 0,1:49:19.55,1:49:25.32,EDJ,NTP,0000,0000,0000,,Мен сені көргім келеді
Dialogue: 0,1:49:25.51,1:49:31.09,EDJ,NTP,0000,0000,0000,,Мен сені жақсы көремін
Dialogue: 0,1:49:31.27,1:49:42.98,EDJ,NTP,0000,0000,0000,,Мен шақырып жатырмын. Менің осында болғанымның дәлелі
Dialogue: 0,1:49:43.19,1:49:54.94,EDJ,NTP,0000,0000,0000,,Әлі де көзіңде екеніне сенімдімін
Dialogue: 0,1:49:55.16,1:50:07.05,EDJ,NTP,0000,0000,0000,,Мен жабылатын спиральға қарсы шақырамын
Dialogue: 0,1:50:07.20,1:50:19.06,EDJ,NTP,0000,0000,0000,,Біз жылаймыз, айқайлаймыз және жоқ боламыз
Dialogue: 0,1:50:19.26,1:50:27.35,EDJ,NTP,0000,0000,0000,,Мен тірімін.
Dialogue: 0,1:50:31.23,1:50:39.15,EDJ,NTP,0000,0000,0000,,Мен осындамын...
Dialogue: 0,1:46:06.86,1:46:13.37,EDC,NTP,0000,0000,0000,,Сізді салыстыру
Dialogue: 0,1:46:13.56,1:46:17.87,EDC,NTP,0000,0000,0000,,Қол жетпес арман
Dialogue: 0,1:46:18.77,1:46:30.82,EDC,NTP,0000,0000,0000,,Соңғы бақылау лездік, трансценденттік және мәңгілік.
Dialogue: 0,1:46:31.14,1:46:42.92,EDC,NTP,0000,0000,0000,,Мен сені шақырсам, мен сені мәңгілікке қорғаймын.
Dialogue: 0,1:46:43.21,1:46:55.74,EDC,NTP,0000,0000,0000,,Көк түсте қолды да ұстауға болады
Dialogue: 0,1:46:55.89,1:47:00.56,EDC,NTP,0000,0000,0000,,Менің күш-қуатымды сарқылу және менің әлемдегі жалғыз аман қалуым.
Dialogue: 0,1:47:00.70,1:47:07.60,EDC,NTP,0000,0000,0000,,Дегенмен, мен бар күш-қуатымды, күш-қуатымды сарп еттім, мұнымен тоқтап қалу ойымда жоқ.
Dialogue: 0,1:47:07.65,1:47:10.32,EDC,NTP,0000,0000,0000,,Маған хабарласа аласыз ба? Менің қоңырауым?
Dialogue: 0,1:47:10.42,1:47:16.90,EDC,NTP,0000,0000,0000,,Жедел серпіліс, таусылудың түпкі үміті
Dialogue: 0,1:47:17.06,1:47:19.40,EDC,NTP,0000,0000,0000,,Тікелей келу спиральды (әлемдік) сарқылу
Dialogue: 0,1:47:19.46,1:47:30.96,EDC,NTP,0000,0000,0000,,Әнім, Нахару бағытында әнім
Dialogue: 0,1:47:31.18,1:47:41.47,EDC,NTP,0000,0000,0000,,Аспанға қараған кезде
Dialogue: 0,1:47:41.66,1:47:49.89,EDC,NTP,0000,0000,0000,,Сіз генерал жалғызсыз...
Dialogue: 0,1:47:52.58,1:48:00.40,EDC,NTP,0000,0000,0000,,Ашылатын ақиқат – басқа адамның санасы.
Dialogue: 0,1:48:00.72,1:48:07.02,EDC,NTP,0000,0000,0000,,Ол да толы
Dialogue: 0,1:48:07.08,1:48:14.19,EDC,NTP,0000,0000,0000,,Жарық жылдамдығының суреті өтеді.
Dialogue: 0,1:48:14.26,1:48:18.70,EDC,NTP,0000,0000,0000,,Фуканенри шөлі
Dialogue: 0,1:48:18.76,1:48:30.66,EDC,NTP,0000,0000,0000,,Мен қазір қалай жұмыс істеймін?
Dialogue: 0,1:48:30.80,1:48:42.25,EDC,NTP,0000,0000,0000,,Жел мен жойылудың туы
Dialogue: 0,1:48:42.77,1:48:55.14,EDC,NTP,0000,0000,0000,,Алдыңғы жолды басқара алмасаңыз, өзіңіз болыңыз.
Dialogue: 0,1:48:55.43,1:49:01.57,EDC,NTP,0000,0000,0000,,Бастапқы прогресс...
Dialogue: 0,1:49:02.80,1:49:07.89,EDC,NTP,0000,0000,0000,,Тікелей келу спиральды (әлемдік) сарқылу...
Dialogue: 0,1:49:07.94,1:49:13.33,EDC,NTP,0000,0000,0000,,Сіздің сыртқы көрінісіңізден алған әсеріңіз
Dialogue: 0,1:49:13.61,1:49:19.33,EDC,NTP,0000,0000,0000,,Жоғалған махаббаттың келуі
Dialogue: 0,1:49:19.55,1:49:25.32,EDC,NTP,0000,0000,0000,,Сіздің сыртқы көрінісіңізден алған әсеріңіз
Dialogue: 0,1:49:25.51,1:49:31.09,EDC,NTP,0000,0000,0000,,Сізді кигенді жақсы көремін
Dialogue: 0,1:49:31.27,1:49:42.98,EDC,NTP,0000,0000,0000,,Мен оны өз болмысым деп атаймын.
Dialogue: 0,1:49:43.19,1:49:54.94,EDC,NTP,0000,0000,0000,,Қазіргі уақытта сіз өз көзіңізде екеніңізді растайсыз.
Dialogue: 0,1:49:55.16,1:50:07.05,EDC,NTP,0000,0000,0000,,Мен оны феодалдың спиральды қақтығысы деймін
Dialogue: 0,1:50:07.20,1:50:19.06,EDC,NTP,0000,0000,0000,,Менің ең соңғы тілегім - генералдың дереу өлуі.
Dialogue: 0,1:50:19.26,1:50:27.35,EDC,NTP,0000,0000,0000,,Соңғы аман қалу
Dialogue: 0,1:50:31.23,1:50:39.15,EDC,NTP,0000,0000,0000,,Қайда тұру керек...
Dialogue: 0,0:01:51.63,0:01:53.27,JPsub,NTP,0000,0000,0000,,Томое өлді
Dialogue: 0,0:03:34.83,0:03:37.02,JPsub,NTP,0000,0000,0000,,Бұл бір нәрсе
Dialogue: 0,0:03:51.23,0:03:56.80,JPsub,NTP,0000,0000,0000,,Бұл мүлдем оғаш оқиға болды. Мәйіт болған жоқ.
Dialogue: 0,0:03:57.47,0:04:02.45,JPsub,NTP,0000,0000,0000,,Қайталанған ессіз ұры полиция қорабына Киоген спектаклімен түседі ме?
Dialogue: 0,0:04:03.00,0:04:06.00,JPsub,NTP,0000,0000,0000,,Мен де солай ойладым, сондықтан мен де қарадым.
Dialogue: 0,0:04:06.46,0:04:12.14,JPsub,NTP,0000,0000,0000,,Келіңіздер, сіздің айтқаныңыз Киоген үшін анық болды.
Dialogue: 0,0:04:12.68,0:04:16.08,JPsub,NTP,0000,0000,0000,,Мен көршілерден жағдайды сұрадым, бірақ ештеңе болмады.
Dialogue: 0,0:04:16.60,0:04:18.98,JPsub,NTP,0000,0000,0000,,Бұл кез келген күн сияқты болды.
Dialogue: 0,0:04:20.07,0:04:23.66,JPsub,NTP,0000,0000,0000,,Сондықтан бұл біртүрлі әңгіме.
Dialogue: 0,0:04:24.08,0:04:25.94,JPsub,NTP,0000,0000,0000,,Неліктен бос ұялар бұлай жасайды?
Dialogue: 0,0:04:26.91,0:04:33.47,JPsub,NTP,0000,0000,0000,,Жарайды, әркім жақын жердегі пәтерді бұзу сияқты қалыпты өмір сүреді.
Dialogue: 0,0:04:33.82,0:04:36.46,JPsub,NTP,0000,0000,0000,,Ол кейде құлыпсыз бөлмеде ұйықтайтын көрінеді.
Dialogue: 0,0:04:37.33,0:04:40.02,JPsub,NTP,0000,0000,0000,,Кейбір тұрғындар есіктерін құлыптамайды.
Dialogue: 0,0:04:40.97,0:04:46.02,JPsub,NTP,0000,0000,0000,,Кәдімгі қулық аздап қарызға ақша алу сияқты.
Dialogue: 0,0:04:47.27,0:04:49.95,JPsub,NTP,0000,0000,0000,,Бұл оқиға не туралы?
Dialogue: 0,0:04:50.36,0:04:53.80,JPsub,NTP,0000,0000,0000,,Жоқ, бұл жай ғана қызығушылық.
Dialogue: 0,0:04:54.36,0:04:55.36,JPsub,NTP,0000,0000,0000,,Тағы бір нәрсе
Dialogue: 0,0:04:55.85,0:04:58.77,JPsub,NTP,0000,0000,0000,,Өлгендердің мәйіттері тек ерлі-зайыптылардың денесі болды, солай емес пе?
Dialogue: 0,0:04:59.32,0:05:02.04,JPsub,NTP,0000,0000,0000,,Құжаттар бойынша бір ұл болуы керек.
Dialogue: 0,0:05:03.27,0:05:05.18,JPsub,NTP,0000,0000,0000,,Иә, түсінемін.
Dialogue: 0,0:05:05.65,0:05:08.12,JPsub,NTP,0000,0000,0000,,О, жоқ, уақытыңызды алғаным үшін кешіріңіз.
Dialogue: 0,0:05:08.48,0:05:11.11,JPsub,NTP,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:05:13.90,0:05:15.07,JPsub,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:05:18.98,0:05:19.87,JPsub,NTP,0000,0000,0000,,Сіз не қарап тұрсыз?
Dialogue: 0,0:05:21.16,0:05:23.30,JPsub,NTP,0000,0000,0000,,Аа, кішкене бос ұя туралы есеп.
Dialogue: 0,0:05:24.37,0:05:27.13,JPsub,NTP,0000,0000,0000,,Жауаптылық болмаса да, сізге нәрселер ұнайды.
Dialogue: 0,0:05:27.69,0:05:28.72,JPsub,NTP,0000,0000,0000,,Бұл қандай оқиға?
Dialogue: 0,0:05:29.17,0:05:29.92,JPsub,NTP,0000,0000,0000,,Мацуда! Бұл бала ойыны емес
Dialogue: 0,0:05:30.03,0:05:32.41,JPsub,NTP,0000,0000,0000,,Ей, екінші Будда пайда болды.
Dialogue: 0,0:05:32.84,0:05:34.41,JPsub,NTP,0000,0000,0000,,Сіз мысалды жегіңіз келе ме?
Dialogue: 0,0:05:34.73,0:05:36.11,JPsub,NTP,0000,0000,0000,,О, асығыңыз!
Dialogue: 0,0:05:36.45,0:05:39.48,JPsub,NTP,0000,0000,0000,,Қараңыз, жұмыс жасаңыз, жұмыс жасаңыз, хоббиіңізді қалдырыңыз.
Dialogue: 0,0:05:39.68,0:05:40.74,JPsub,NTP,0000,0000,0000,,Мен білемін.
Dialogue: 0,0:05:42.46,0:05:44.78,JPsub,NTP,0000,0000,0000,,Бұл Каджо Томое ма?
Dialogue: 0,0:05:45.35,0:05:46.09,JPsub,NTP,0000,0000,0000,,Дайсуке
Dialogue: 0,0:05:46.30,0:05:47.15,JPsub,NTP,0000,0000,0000,,Кеттік
Dialogue: 0,0:06:35.61,0:06:36.55,JPsub,NTP,0000,0000,0000,,Осы жерде күтіңіз.
Dialogue: 0,0:06:37.09,0:06:38.68,JPsub,NTP,0000,0000,0000,,Сіз бұрынғыдай тез қашып бара жатырсыз.
Dialogue: 0,0:06:39.50,0:06:40.15,JPsub,NTP,0000,0000,0000,,Менен аулақ жүр!
Dialogue: 0,0:06:40.30,0:06:44.49,JPsub,NTP,0000,0000,0000,,Жоқ, егер сен мектепті тастасаң, басқа біреу боласың. Ха, Томое-чан.
Dialogue: 0,0:06:54.71,0:06:55.14,JPsub,NTP,0000,0000,0000,,Ақымақ
Dialogue: 0,0:06:55.24,0:06:56.29,JPsub,NTP,0000,0000,0000,,Не істеп жатырсың, ақымақ?
Dialogue: 0,0:06:57.17,0:06:57.79,JPsub,NTP,0000,0000,0000,,Осы жерде күтіңіз.
Dialogue: 0,0:06:57.94,0:07:00.29,JPsub,NTP,0000,0000,0000,,Кожо мұны өлтіреді
Dialogue: 0,0:07:18.61,0:07:19.90,JPsub,NTP,0000,0000,0000,,Кажо
Dialogue: 0,0:07:32.34,0:07:33.78,JPsub,NTP,0000,0000,0000,,Бұл да сені өлтірмейді.
Dialogue: 0,0:07:38.14,0:07:41.20,JPsub,NTP,0000,0000,0000,,Бұл сәл артық емес пе, Томое-чан?
Dialogue: 0,0:07:42.84,0:07:45.32,JPsub,NTP,0000,0000,0000,,Бізді ойламайсың ба?
Dialogue: 0,0:07:45.67,0:07:48.54,JPsub,NTP,0000,0000,0000,,Жаңа ғана қарызға ақша бергіңіз келетінін айтқан жоқсыз ба?
Dialogue: 0,0:07:49.29,0:07:50.81,JPsub,NTP,0000,0000,0000,,Мен мұны Хидекомен жасаймын.
Dialogue: 0,0:07:51.39,0:07:55.84,JPsub,NTP,0000,0000,0000,,Әй, сен мені көшеде ұйықтап жатқанымнан ояттың.
Dialogue: 0,0:07:56.79,0:07:59.37,JPsub,NTP,0000,0000,0000,,Біреуді ұрып, қашып кету аздық етеді.
Dialogue: 0,0:08:06.35,0:08:08.02,JPsub,NTP,0000,0000,0000,,Кісі өлтіру...
Dialogue: 0,0:08:19.23,0:08:21.43,JPsub,NTP,0000,0000,0000,,Эй, мұнда кел.
Dialogue: 0,0:08:28.58,0:08:30.33,JPsub,NTP,0000,0000,0000,,Мұнда келе жатқан баклажан ғой, солай емес пе?
Dialogue: 0,0:08:30.81,0:08:32.78,JPsub,NTP,0000,0000,0000,,Сіз естімейсіз.
Dialogue: 0,0:08:59.33,0:09:01.34,JPsub,NTP,0000,0000,0000,,Ишиатама тас басы
Dialogue: 0,0:09:04.60,0:09:05.76,JPsub,NTP,0000,0000,0000,,Менің ойымша, бұл сіздікі.
Dialogue: 0,0:09:10.62,0:09:11.26,JPsub,NTP,0000,0000,0000,,Ол мойнын қорғап қалды
Dialogue: 0,0:09:12.43,0:09:14.55,JPsub,NTP,0000,0000,0000,,Бір минут күте тұрыңыз, досым.
Dialogue: 0,0:09:15.22,0:09:17.89,JPsub,NTP,0000,0000,0000,,Не? Менің жоғалтатын басқа ештеңем жоқ.
Dialogue: 0,0:09:19.63,0:09:21.81,JPsub,NTP,0000,0000,0000,,Уайымдама, бәрі өлген жоқ.
Dialogue: 0,0:09:22.34,0:09:24.39,JPsub,NTP,0000,0000,0000,,Әлде мен көмекке шақыруым керек пе?
Dialogue: 0,0:09:25.56,0:09:26.12,JPsub,NTP,0000,0000,0000,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:09:26.38,0:09:26.97,JPsub,NTP,0000,0000,0000,,Бұл сенсің ғой, иә?
Dialogue: 0,0:09:27.93,0:09:32.55,JPsub,NTP,0000,0000,0000,,Қалай болғанда да, мені көрінбейтін жерге апара аласыз ба?
Dialogue: 0,0:09:33.09,0:09:34.50,JPsub,NTP,0000,0000,0000,,Бұл жасырын ба?
Dialogue: 0,0:09:34.78,0:09:35.76,JPsub,NTP,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:09:36.23,0:09:38.93,JPsub,NTP,0000,0000,0000,,Бұл қалада көзге көрінбейтін жер жоқ.
Dialogue: 0,0:09:39.40,0:09:42.29,JPsub,NTP,0000,0000,0000,,Басқа адамдар көре алмайтын жалғыз жер - сіздің үйіңіз.
Dialogue: 0,0:09:43.19,0:09:45.25,JPsub,NTP,0000,0000,0000,,Мен мұны істей алмайтындықтан айтып отырмын.
Dialogue: 0,0:09:45.70,0:09:48.98,JPsub,NTP,0000,0000,0000,,Әлде үйіңде тығылып жүрсің бе, ақымақ?
Dialogue: 0,0:09:49.29,0:09:49.91,JPsub,NTP,0000,0000,0000,,Мен оны… есептей алмаймын.
Dialogue: 0,0:09:51.47,0:09:52.79,JPsub,NTP,0000,0000,0000,,Бұл оңай.
Dialogue: 0,0:10:30.23,0:10:33.51,JPsub,NTP,0000,0000,0000,,Мен біреуді өлтірдім
Dialogue: 0,0:10:44.37,0:10:46.02,JPsub,NTP,0000,0000,0000,,Томое өлді
Dialogue: 0,0:11:22.16,0:11:22.76,JPsub,NTP,0000,0000,0000,,На
Dialogue: 0,0:11:23.86,0:11:25.53,JPsub,NTP,0000,0000,0000,,Мен оны олай көрмеймін.
Dialogue: 0,0:11:25.85,0:11:27.45,JPsub,NTP,0000,0000,0000,,О, бұл рас.
Dialogue: 0,0:11:27.85,0:11:29.43,JPsub,NTP,0000,0000,0000,,Мен оны жаңа ғана өлтірдім.
Dialogue: 0,0:11:29.71,0:11:32.71,JPsub,NTP,0000,0000,0000,,Мен асхана пышағымен шатастырып алдым.
Dialogue: 0,0:11:33.30,0:11:36.61,JPsub,NTP,0000,0000,0000,,Түн түскенде, Мен кенеттен атақты боламын
Dialogue: 0,0:11:37.57,0:11:39.48,JPsub,NTP,0000,0000,0000,,Сол үшін солай киініп жүрсің бе?
Dialogue: 0,0:11:40.29,0:11:43.10,JPsub,NTP,0000,0000,0000,,Мен осындай нәрсе шынымен танымал деп ойладым.
Dialogue: 0,0:11:44.47,0:11:46.55,JPsub,NTP,0000,0000,0000,,Әй, бұл қайтару қаны.
Dialogue: 0,0:11:49.35,0:11:51.65,JPsub,NTP,0000,0000,0000,,Сіз қорықпайсыз ба?
Dialogue: 0,0:11:52.00,0:11:52.69,JPsub,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:11:54.22,0:11:57.56,JPsub,NTP,0000,0000,0000,,Мен шынымен де кісі өлтірушімін
Dialogue: 0,0:11:57.71,0:11:58.50,JPsub,NTP,0000,0000,0000,,Бөлек
Dialogue: 0,0:12:00.44,0:12:01.84,JPsub,NTP,0000,0000,0000,,Мен де солаймын.
Dialogue: 0,0:12:02.57,0:12:03.44,JPsub,NTP,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:12:03.88,0:12:05.52,JPsub,NTP,0000,0000,0000,,Жарайды, менімен бірге жүр.
Dialogue: 0,0:12:05.95,0:12:07.17,JPsub,NTP,0000,0000,0000,,Оой
Dialogue: 0,0:12:32.00,0:12:33.96,JPsub,NTP,0000,0000,0000,,Неге тағы да айттыңыз?
Dialogue: 0,0:12:34.45,0:12:35.39,JPsub,NTP,0000,0000,0000,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,0:12:40.50,0:12:42.31,JPsub,NTP,0000,0000,0000,,Сіз оны әлі тапмадыңыз ба?
Dialogue: 0,0:13:11.11,0:13:11.89,JPsub,NTP,0000,0000,0000,,перне
Dialogue: 0,0:13:26.46,0:13:28.18,JPsub,NTP,0000,0000,0000,,Томое өлді
Dialogue: 0,0:13:31.52,0:13:33.62,JPsub,NTP,0000,0000,0000,,Не, сен де бүгін келдің бе?
Dialogue: 0,0:13:35.17,0:13:38.41,JPsub,NTP,0000,0000,0000,,Мен тамақ ішейін бе? Мен суық тамақты ұнатпаймын.
Dialogue: 0,0:13:38.93,0:13:41.38,JPsub,NTP,0000,0000,0000,,Маған неге көмектестің?
Dialogue: 0,0:13:47.52,0:13:49.27,JPsub,NTP,0000,0000,0000,,Жатар жерің жоқ па?
Dialogue: 0,0:13:49.92,0:13:51.57,JPsub,NTP,0000,0000,0000,,Сіз бұл орынды біраз уақыт пайдалана аласыз.
Dialogue: 0,0:13:52.16,0:13:54.58,JPsub,NTP,0000,0000,0000,,Микия бәрібір біраз уақытқа келмейді.
Dialogue: 0,0:13:54.92,0:13:58.13,JPsub,NTP,0000,0000,0000,,Сіз байсалдысыз ба? Мүмкін сіз қауіпті адам шығарсыз?
Dialogue: 0,0:13:59.60,0:14:01.17,JPsub,NTP,0000,0000,0000,,Біртүрлі жігіт екенсің, жігіт.
Dialogue: 0,0:14:01.70,0:14:04.50,JPsub,NTP,0000,0000,0000,,Сіз қауіпті деп айттыңыз ба? Бұл жақсы өрнек.
Dialogue: 0,0:14:04.92,0:14:06.83,JPsub,NTP,0000,0000,0000,,Бірақ сен де кісі өлтірушісің ғой?
Dialogue: 0,0:14:07.33,0:14:08.73,JPsub,NTP,0000,0000,0000,,Онда маңызды емес, солай ма?
Dialogue: 0,0:14:09.15,0:14:11.87,JPsub,NTP,0000,0000,0000,,Көрдің бе, мен еркекпін, сен әйелсің.
Dialogue: 0,0:14:12.22,0:14:14.46,JPsub,NTP,0000,0000,0000,,Менің қалуыма рұқсат дегеніңіз осы.
Dialogue: 0,0:14:14.98,0:14:19.92,JPsub,NTP,0000,0000,0000,,Е, әйел алғың келсе, басқа жерде қалуың керек емес пе?
Dialogue: 0,0:14:20.29,0:14:21.37,JPsub,NTP,0000,0000,0000,,Кенже
Dialogue: 0,0:14:23.31,0:14:25.86,JPsub,NTP,0000,0000,0000,,Мен мұны өз төсегімді жасаймын. Бұл жақсы.
Dialogue: 0,0:14:26.27,0:14:28.84,JPsub,NTP,0000,0000,0000,,Әй, бөгет болса, кедергі.
Dialogue: 0,0:14:31.21,0:14:31.95,JPsub,NTP,0000,0000,0000,,Иә, бұл
Dialogue: 0,0:14:35.16,0:14:39.44,JPsub,NTP,0000,0000,0000,,Сіз маған кеше түнде кілттеріңіздің жоқ екенін айттыңыз.
Dialogue: 0,0:14:40.26,0:14:41.70,JPsub,NTP,0000,0000,0000,,Мен жаңасын сатып алдым.
Dialogue: 0,0:14:42.02,0:14:42.83,JPsub,NTP,0000,0000,0000,,тіпті Эден кампусында да — қайдағы қырағы көздердің қашан қарап тұрғанын білмейсің.
Dialogue: 0,0:14:43.23,0:14:47.43,JPsub,NTP,0000,0000,0000,,Мен жылжымалы компанияда жұмыс істедім, жасырын кіріп, бірдеңе ұрлап кеттім.
Dialogue: 0,0:14:47.69,0:14:49.39,JPsub,NTP,0000,0000,0000,,Мен мұны қажет емес деп айттым.
Dialogue: 0,0:14:50.54,0:14:54.75,JPsub,NTP,0000,0000,0000,,Кілті жоқ үй мүлдем үй емес.
Dialogue: 0,0:15:02.11,0:15:03.60,JPsub,NTP,0000,0000,0000,,Эй, сенің атың кім?
Dialogue: 0,0:15:04.12,0:15:05.62,JPsub,NTP,0000,0000,0000,,Екі рәсім
Dialogue: 0,0:15:07.37,0:15:08.95,JPsub,NTP,0000,0000,0000,,Бұл Томое Уджо
Dialogue: 0,0:17:09.08,0:17:12.57,JPsub,NTP,0000,0000,0000,,Бұл 16 қазандағы кешкі жаңалықтар.
Dialogue: 0,0:17:24.41,0:17:26.37,JPsub,NTP,0000,0000,0000,,Томое өлді
Dialogue: 0,0:17:32.26,0:17:33.09,JPsub,NTP,0000,0000,0000,,Ақымақ
Dialogue: 0,0:17:40.18,0:17:42.46,JPsub,NTP,0000,0000,0000,,Рёги, қайтып келдің бе?
Dialogue: 0,0:17:46.67,0:17:48.13,JPsub,NTP,0000,0000,0000,,Тіпті сен емес.
Dialogue: 0,0:17:56.16,0:17:58.14,JPsub,NTP,0000,0000,0000,,Мен біреуді өлтірмек болдым.
Dialogue: 0,0:18:00.07,0:18:02.57,JPsub,NTP,0000,0000,0000,,Бірақ мен басқа адамды таба алмадым.
Dialogue: 0,0:18:03.23,0:18:06.71,JPsub,NTP,0000,0000,0000,,Мен дәл қазір сен деп ойладым, бірақ бұл жақсы емес.
Dialogue: 0,0:18:06.96,0:18:07.78,JPsub,NTP,0000,0000,0000,,Горизонталды су дөңгелегі!
Dialogue: 0,0:18:08.88,0:18:10.99,JPsub,NTP,0000,0000,0000,,Толық жеңілдім деп ойладым.
Dialogue: 0,0:18:11.59,0:18:16.20,JPsub,NTP,0000,0000,0000,,Мен өзімді тірі сезінгім келеді, бір күні мен адамдарды себепсіз өлтіремін.
Dialogue: 0,0:18:16.60,0:18:19.36,JPsub,NTP,0000,0000,0000,,Не болды? Рёги, мықты бол.
Dialogue: 0,0:18:19.52,0:18:23.50,JPsub,NTP,0000,0000,0000,,Мен күштімін. Менде бұл сезімдер тіпті жазда да болды.
Dialogue: 0,0:18:23.87,0:18:24.86,JPsub,NTP,0000,0000,0000,,Тіпті сол кезде
Dialogue: 0,0:18:27.73,0:18:30.64,JPsub,NTP,0000,0000,0000,,Эй, Рёги, сенің достарың бар ма?
Dialogue: 0,0:18:33.00,0:18:33.79,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:18:34.12,0:18:35.22,JPsub,NTP,0000,0000,0000,,Сіз сондасыз ба?
Dialogue: 0,0:18:35.74,0:18:38.75,JPsub,NTP,0000,0000,0000,,Егер бұл сіз болсаңыз, онда сөйлесетін уақыт келді.
Dialogue: 0,0:18:39.23,0:18:42.03,JPsub,NTP,0000,0000,0000,,Онымен кездесіп, барлық қиыншылықтарыңызды оған күштеңіз.
Dialogue: 0,0:18:42.43,0:18:43.52,JPsub,NTP,0000,0000,0000,,Бұл оңайырақ болады.
Dialogue: 0,0:18:43.71,0:18:46.14,JPsub,NTP,0000,0000,0000,,Ол қазір кетті. Ол алысқа кетті.
Dialogue: 0,0:18:48.97,0:18:50.43,JPsub,NTP,0000,0000,0000,,Көбінесе ол өз бетімен жүреді.
Dialogue: 0,0:18:50.90,0:18:56.28,JPsub,NTP,0000,0000,0000,,Мен оны ұната ма деп үйіме келеді деп ойладым, бірақ ол маған тек телефон нөмірін берсе болды.
Dialogue: 0,0:18:56.69,0:18:59.26,JPsub,NTP,0000,0000,0000,,Жазда да бір ай төсекте жатушы едім.
Dialogue: 0,0:18:59.72,0:19:03.36,JPsub,NTP,0000,0000,0000,,Неліктен мен мұндай нәрсеге ашулануым керек?
Dialogue: 0,0:19:07.55,0:19:09.25,JPsub,NTP,0000,0000,0000,,Бұл менің қолымнан келмейді дегенді білдіре ме?
Dialogue: 0,0:19:09.95,0:19:10.95,JPsub,NTP,0000,0000,0000,,Не айтты?
Dialogue: 0,0:19:11.31,0:19:12.34,JPsub,NTP,0000,0000,0000,,Бұл ештеңе емес.
Dialogue: 0,0:19:12.93,0:19:15.76,JPsub,NTP,0000,0000,0000,,Әй, ол досым мектептегі таныс па?
Dialogue: 0,0:19:16.12,0:19:18.37,JPsub,NTP,0000,0000,0000,,Әй, ақын сияқты.
Dialogue: 0,0:19:18.87,0:19:21.48,JPsub,NTP,0000,0000,0000,,Түнде серуендеудің себебі осы ма?
Dialogue: 0,0:19:22.02,0:19:23.79,JPsub,NTP,0000,0000,0000,,Жоқ, мен
Dialogue: 0,0:19:27.04,0:19:30.93,JPsub,NTP,0000,0000,0000,,Бірақ мен адамдарды өлтіргенді ұнатамын.
Dialogue: 0,0:19:31.18,0:19:31.84,JPsub,NTP,0000,0000,0000,,Иә…♡
Dialogue: 0,0:19:32.35,0:19:33.68,JPsub,NTP,0000,0000,0000,,Сіз ондай емессіз.
Dialogue: 0,0:19:49.59,0:19:53.18,JPsub,NTP,0000,0000,0000,,Бұл 18 қазан күні кешкі жаңалық болды.
Dialogue: 0,0:19:54.10,0:19:56.50,JPsub,NTP,0000,0000,0000,,Мүмкін ол әлі табылмаған шығар?
Dialogue: 0,0:20:01.31,0:20:02.07,JPsub,NTP,0000,0000,0000,,Рёги
Dialogue: 0,0:20:06.28,0:20:07.93,JPsub,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:20:31.61,0:20:32.80,JPsub,NTP,0000,0000,0000,,Ол қосылды ма?
Dialogue: 0,0:20:34.66,0:20:36.80,JPsub,NTP,0000,0000,0000,,Жоқ, иә.
Dialogue: 0,0:20:37.08,0:20:38.11,JPsub,NTP,0000,0000,0000,,Есіңде жоқ па?
Dialogue: 0,0:20:38.45,0:20:40.52,JPsub,NTP,0000,0000,0000,,Менің мұндай жағымды таныстарым жоқ.
Dialogue: 0,0:20:41.03,0:20:43.43,JPsub,NTP,0000,0000,0000,,Толық. Ертең оны тастаңыз.
Dialogue: 0,0:20:43.72,0:20:47.38,JPsub,NTP,0000,0000,0000,,Ей, менің уайымдағаным мүлде жоқ.
Dialogue: 0,0:20:47.96,0:20:50.74,JPsub,NTP,0000,0000,0000,,Неліктен Йоджо мен үшін алаңдайды?
Dialogue: 0,0:20:51.62,0:20:56.70,JPsub,NTP,0000,0000,0000,,Неге, мен саған қауіп төнгеніңді қаламаймын.
Dialogue: 0,0:20:57.56,0:20:58.75,JPsub,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:20:59.68,0:21:05.63,JPsub,NTP,0000,0000,0000,,О, мен... мен саған ғашықпын.
Dialogue: 0,0:21:05.86,0:21:06.57,JPsub,NTP,0000,0000,0000,,Ақымақ.
Dialogue: 0,0:21:12.22,0:21:14.88,JPsub,NTP,0000,0000,0000,,Наоджоның маған ғашық болуы мүмкін бе?
Dialogue: 0,0:21:19.74,0:21:23.38,JPsub,NTP,0000,0000,0000,,Мына қызыл пальто киген адам сізді гипноздады ма?
Dialogue: 0,0:21:23.61,0:21:26.29,JPsub,NTP,0000,0000,0000,,Жоқ, жоқ, мен байсалдымын.
Dialogue: 0,0:21:27.10,0:21:30.25,JPsub,NTP,0000,0000,0000,,Мен сені көргенде адамдардың алғаш рет әдемі болғаны есіме түсті.
Dialogue: 0,0:21:30.67,0:21:32.79,JPsub,NTP,0000,0000,0000,,Мен өзімді жақын адаммен кездестірдім деп ойладым.
Dialogue: 0,0:21:33.47,0:21:38.15,JPsub,NTP,0000,0000,0000,,Сен нағызсың, мен сен үшін бәрін істеймін
Dialogue: 0,0:21:41.46,0:21:42.14,JPsub,NTP,0000,0000,0000,,Егер
Dialogue: 0,0:21:44.56,0:21:46.29,JPsub,NTP,0000,0000,0000,,Мен үшін өл
Dialogue: 0,0:21:47.20,0:21:47.89,JPsub,NTP,0000,0000,0000,,Өлген
Dialogue: 0,0:21:52.73,0:21:55.73,JPsub,NTP,0000,0000,0000,,Жақсы, мен сен үшін өлемін.
Dialogue: 0,0:21:56.47,0:21:57.59,JPsub,NTP,0000,0000,0000,,Мен бәрібір
Dialogue: 0,0:21:59.69,0:22:00.81,JPsub,NTP,0000,0000,0000,,Паррицид
Dialogue: 0,0:22:02.08,0:22:06.73,JPsub,NTP,0000,0000,0000,,Арманда, күнде қайтала
Dialogue: 0,0:22:07.35,0:22:08.23,JPsub,NTP,0000,0000,0000,,Мен қорықтым
Dialogue: 0,0:22:09.17,0:22:10.40,JPsub,NTP,0000,0000,0000,,Мен өлтірілді және арман
Dialogue: 0,0:22:10.96,0:22:13.04,JPsub,NTP,0000,0000,0000,,Әкем мен шешемнің айтысып жатқанын естідім.
Dialogue: 0,0:22:13.26,0:22:15.94,JPsub,NTP,0000,0000,0000,,Жылжымалы есік ашылады, ана сонда тұр.
Dialogue: 0,0:22:17.56,0:22:19.91,JPsub,NTP,0000,0000,0000,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:22:30.16,0:22:34.61,JPsub,NTP,0000,0000,0000,,Жаман ата болдым, ең жаман күндерім
Dialogue: 0,0:22:35.91,0:22:40.95,JPsub,NTP,0000,0000,0000,,Сол арманның ақиқатқа айналатыны өте бір әңгіме еді
Dialogue: 0,0:22:41.68,0:22:45.94,JPsub,NTP,0000,0000,0000,,Сол түні мен жылжымалы есікті ашқанда, мен анамды рефлексивті түрде пышақтап жібердім.
Dialogue: 0,0:22:46.82,0:22:47.55,JPsub,NTP,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:22:48.14,0:22:50.49,JPsub,NTP,0000,0000,0000,,Адам ағзалары жылы.
Dialogue: 0,0:22:51.85,0:22:53.26,JPsub,NTP,0000,0000,0000,,Сонда сен оны өлтірдің бе?
Dialogue: 0,0:22:54.07,0:22:57.98,JPsub,NTP,0000,0000,0000,,Өте жаман, ақыры азапты таңдадың.
Dialogue: 0,0:22:58.59,0:23:05.87,JPsub,NTP,0000,0000,0000,,Біз алғаш кездескен кезде болашағыңнан айырылып, бос қалдың. Қазіргідей өлгің келді ме?
Dialogue: 0,0:23:06.30,0:23:07.67,JPsub,NTP,0000,0000,0000,,Жаман болсаң, өлім жазасы.
Dialogue: 0,0:23:08.27,0:23:11.39,JPsub,NTP,0000,0000,0000,,Сен үшін өлгенім әлдеқайда қымбат болар еді.
Dialogue: 0,0:23:12.32,0:23:15.60,JPsub,NTP,0000,0000,0000,,Жоқ, сенің өмірің маған керек емес.
Dialogue: 0,0:23:17.40,0:23:18.38,JPsub,NTP,0000,0000,0000,,Сәлем, Каджу
Dialogue: 0,0:23:19.20,0:23:20.80,JPsub,NTP,0000,0000,0000,,Сіздің үйіңіз қайда?
Dialogue: 0,0:23:21.40,0:23:22.64,JPsub,NTP,0000,0000,0000,,Тыңдағаннан кейін не істеу керек
Dialogue: 0,0:23:23.06,0:23:25.70,JPsub,NTP,0000,0000,0000,,Бұл кейбір тұрғын үй кешенінің 405 бөлмесі.
Dialogue: 0,0:23:25.91,0:23:26.92,JPsub,NTP,0000,0000,0000,,Қайырлы таң, Камилла.
Dialogue: 0,0:23:27.77,0:23:30.26,JPsub,NTP,0000,0000,0000,,Бұл сіз қайтып барғыңыз келетін үй туралы.
Dialogue: 0,0:23:30.87,0:23:32.25,JPsub,NTP,0000,0000,0000,,Білмесеңіз жақсы
Dialogue: 0,0:23:33.37,0:23:37.64,JPsub,NTP,0000,0000,0000,,Каджу, сіз күнделікті жұмысыңызды орындауыңыз керек еді.
Dialogue: 0,0:23:38.93,0:23:39.80,JPsub,NTP,0000,0000,0000,,Осы үшін оны мектептен шығарып жіберсе жақсы болар еді.
Dialogue: 0,0:23:40.02,0:23:41.44,JPsub,NTP,0000,0000,0000,,Қаласаңыз, оны қайтадан пайдаланыңыз
Dialogue: 0,0:23:51.69,0:23:55.33,JPsub,NTP,0000,0000,0000,,Мен енді бұл жерде тұра алмаймын.
Dialogue: 0,0:00:01.00,0:00:01.00,JPsub,NTP,0000,0000,0000,,==========================p2=========================
Dialogue: 0,0:24:09.39,0:24:12.68,JPsub,NTP,0000,0000,0000,,9 қарашадағы кешкі жаңалықтарды хабарлау
Dialogue: 0,0:24:15.91,0:24:17.59,JPsub,NTP,0000,0000,0000,,Тағы бір апта?
Dialogue: 0,0:24:46.77,0:24:48.80,JPsub,NTP,0000,0000,0000,,Көп уақыт болды, Каджу.
Dialogue: 0,0:24:49.16,0:24:51.67,JPsub,NTP,0000,0000,0000,,Сіз шамдарсыз буксирлеуді ұнатасыз ба?
Dialogue: 0,0:24:53.07,0:24:55.45,JPsub,NTP,0000,0000,0000,,Мен Риогимін
Dialogue: 0,0:24:55.57,0:24:58.67,JPsub,NTP,0000,0000,0000,,Күте тұрыңыз, мен оны жинаймын.
Dialogue: 0,0:25:04.86,0:25:07.19,JPsub,NTP,0000,0000,0000,,Жақсы, менің ойымша, бізде сөйлесетін нәрсе бар.
Dialogue: 0,0:25:11.79,0:25:15.79,JPsub,NTP,0000,0000,0000,,Мен жынды болдым ба? Мен оны өлтіруім керек еді.
Dialogue: 0,0:25:15.89,0:25:18.77,JPsub,NTP,0000,0000,0000,,Сенің анаң тірі еді ғой.
Dialogue: 0,0:25:19.27,0:25:22.25,JPsub,NTP,0000,0000,0000,,Жаңалыққа келгенде осылай ойлау қалыпты жағдай.
Dialogue: 0,0:25:22.42,0:25:25.49,JPsub,NTP,0000,0000,0000,,Бұл рас па? Мен оны өлтірдім.
Dialogue: 0,0:25:25.88,0:25:27.55,JPsub,NTP,0000,0000,0000,,Айырмашылығы ол тірі.
Dialogue: 0,0:25:27.90,0:25:29.90,JPsub,NTP,0000,0000,0000,,Неге оны тексермейсің?
Dialogue: 0,0:25:30.15,0:25:30.76,JPsub,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:25:31.14,0:25:34.65,JPsub,NTP,0000,0000,0000,,Бұл сіз айтып отырған көпқабатты үйдің 405 бөлмесі.
Dialogue: 0,0:25:35.21,0:25:36.71,JPsub,NTP,0000,0000,0000,,Сізге бұл көбірек ұнайды.
Dialogue: 0,0:25:37.21,0:25:38.53,JPsub,NTP,0000,0000,0000,,Мен де сенімен бірге келемін.
Dialogue: 0,0:25:48.14,0:25:48.93,JPsub,NTP,0000,0000,0000,,Міне, осы жерде.
Dialogue: 0,0:25:51.11,0:25:52.36,JPsub,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:25:58.59,0:26:00.74,JPsub,NTP,0000,0000,0000,,Эй, сен шынымен барасың ба?
Dialogue: 0,0:26:01.19,0:26:03.10,JPsub,NTP,0000,0000,0000,,Бармайынша білмейсің
Dialogue: 0,0:26:27.37,0:26:28.63,JPsub,NTP,0000,0000,0000,,Бұрылған
Dialogue: 0,0:26:38.46,0:26:39.83,JPsub,NTP,0000,0000,0000,,Бөлме соңында.
Dialogue: 0,0:26:45.35,0:26:48.20,JPsub,NTP,0000,0000,0000,,Менің бөлмеме келгеніңізге біраз болды.
Dialogue: 0,0:26:48.98,0:26:50.33,JPsub,NTP,0000,0000,0000,,Сегіз күн немесе одан да көп.
Dialogue: 0,0:26:50.91,0:26:52.47,JPsub,NTP,0000,0000,0000,,The timing is too good
Dialogue: 0,0:26:52.95,0:26:53.77,JPsub,NTP,0000,0000,0000,,Тым қолайлы
Dialogue: 0,0:26:56.27,0:26:57.09,JPsub,NTP,0000,0000,0000,,Маған кілтті беріңіз
Dialogue: 0,0:26:57.47,0:26:58.53,JPsub,NTP,0000,0000,0000,,Қоңырау соғуыңызды өтінемін
Dialogue: 0,0:26:59.47,0:27:02.91,JPsub,NTP,0000,0000,0000,,Шықпасаң, не болды? Тек үйге бар.
Dialogue: 0,0:27:03.34,0:27:05.52,JPsub,NTP,0000,0000,0000,,Қоңырау жақсы. Ішке кірейік.
Dialogue: 0,0:27:06.18,0:27:07.84,JPsub,NTP,0000,0000,0000,,Сіз байланыстарды түсінбейсіз
Dialogue: 0,0:27:34.13,0:27:36.37,JPsub,NTP,0000,0000,0000,,Эй, Томое әлі оралмады ма?
Dialogue: 0,0:27:36.91,0:27:40.34,JPsub,NTP,0000,0000,0000,,Сағат сегіз болып қалды. Жұмысты бітіргеніме бір сағат болды.
Dialogue: 0,0:27:40.59,0:27:41.75,JPsub,NTP,0000,0000,0000,,Бүгін жалақы күні.
Dialogue: 0,0:27:42.03,0:27:44.17,JPsub,NTP,0000,0000,0000,,Менің ойымша, сіз үйіңізге ақша салып үйіңізге барасыз.
Dialogue: 0,0:27:44.53,0:27:46.59,JPsub,NTP,0000,0000,0000,,Ол қайда қыдырып жүр?
Dialogue: 0,0:27:47.53,0:27:50.10,JPsub,NTP,0000,0000,0000,,Ал, сіз қалай ойлайсыз?
Dialogue: 0,0:27:50.31,0:27:53.77,JPsub,NTP,0000,0000,0000,,Егер баланың несие берушіге қайтаратын ақшасы болса, оны ата-анасына беретін бала.
Dialogue: 0,0:27:54.02,0:27:57.65,JPsub,NTP,0000,0000,0000,,Маған бір тиын да бермейсің, өйткені мені бүлдірдің.
Dialogue: 0,0:27:58.09,0:28:00.76,JPsub,NTP,0000,0000,0000,,Ол кіммен өмір сүре аламын деп есептейді?
Dialogue: 0,0:28:01.11,0:28:03.40,JPsub,NTP,0000,0000,0000,,Ал, сен қалай ойлайсың?
Dialogue: 0,0:28:03.92,0:28:05.16,JPsub,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:28:07.10,0:28:08.08,JPsub,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:28:08.58,0:28:12.40,JPsub,NTP,0000,0000,0000,,Сіз қосқышты баспағандықтан, тұтынушылар келіп жатқан жоқ.
Dialogue: 0,0:28:24.26,0:28:27.40,JPsub,NTP,0000,0000,0000,,Томое, кеш болды емес пе? Мында кел.
Dialogue: 0,0:28:28.45,0:28:30.07,JPsub,NTP,0000,0000,0000,,Эй, мені Томо деп ата.
Dialogue: 0,0:28:30.37,0:28:31.58,JPsub,NTP,0000,0000,0000,,Маған қоңырау шалсаңыз
Dialogue: 0,0:28:32.66,0:28:33.37,JPsub,NTP,0000,0000,0000,,Мен шаршадым.
Dialogue: 0,0:28:33.46,0:28:35.80,JPsub,NTP,0000,0000,0000,,Бірақ бұл арман ма?
Dialogue: 0,0:28:36.16,0:28:37.04,JPsub,NTP,0000,0000,0000,,Бұл шындық.
Dialogue: 0,0:28:37.99,0:28:39.15,JPsub,NTP,0000,0000,0000,,Сіз көтеріліске шығасыз ба?
Dialogue: 0,0:28:39.35,0:28:42.67,JPsub,NTP,0000,0000,0000,,Жетеді. Апатқа бірінші себепкер болған сіз бе?
Dialogue: 0,0:28:43.00,0:28:44.33,JPsub,NTP,0000,0000,0000,,Менің кінәм бар ма?
Dialogue: 0,0:28:44.51,0:28:46.53,JPsub,NTP,0000,0000,0000,,Сізде біртүрлі мақтаныш болуы керек.
Dialogue: 0,0:28:47.01,0:28:49.38,JPsub,NTP,0000,0000,0000,,Тіпті менің үйім де өсек-аяңнан бір жерден екінші жерге көшіп кетті.
Dialogue: 0,0:28:49.76,0:28:50.85,JPsub,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:28:51.26,0:28:55.16,JPsub,NTP,0000,0000,0000,,Менің қанша күш салғанымды білесің бе?
Dialogue: 0,0:28:55.41,0:28:57.35,JPsub,NTP,0000,0000,0000,,Томое, өйткені сіз жұмыс істемейсіз
Dialogue: 0,0:28:57.84,0:28:59.46,JPsub,NTP,0000,0000,0000,,Оған ақша да сала алмайсың.
Dialogue: 0,0:29:02.68,0:29:05.35,JPsub,NTP,0000,0000,0000,,Ол бала оқу ақысын өзі төлемеген.
Dialogue: 0,0:29:05.91,0:29:08.44,JPsub,NTP,0000,0000,0000,,Сонда да мен мектепке баруды қойдым.
Dialogue: 0,0:29:09.54,0:29:10.98,JPsub,NTP,0000,0000,0000,,Тоқта деп айтпа.
Dialogue: 0,0:29:11.32,0:29:13.43,JPsub,NTP,0000,0000,0000,,Менің ойымша, сіз оны тоқтаттыңыз.
Dialogue: 0,0:29:38.63,0:29:39.80,JPsub,NTP,0000,0000,0000,,Сіз әлі тамақ жедіңіз бе?
Dialogue: 0,0:30:16.30,0:30:20.39,JPsub,NTP,0000,0000,0000,,Тоқта, тоқта, тоқта
Dialogue: 0,0:30:21.72,0:30:22.92,JPsub,NTP,0000,0000,0000,,Үндемей, қарап тұр.
Dialogue: 0,0:30:24.16,0:30:26.70,JPsub,NTP,0000,0000,0000,,Томое өлді
Dialogue: 0,0:30:44.53,0:30:46.92,JPsub,NTP,0000,0000,0000,,Кеттік. Бұл жерде енді пайда жоқ.
Dialogue: 0,0:30:48.01,0:30:50.36,JPsub,NTP,0000,0000,0000,,Әй, сен не істейсің?
Dialogue: 0,0:30:50.77,0:30:53.87,JPsub,NTP,0000,0000,0000,,О, мен, мен өлдім.
Dialogue: 0,0:30:54.22,0:30:55.97,JPsub,NTP,0000,0000,0000,,Мен таңертең тұрамын
Dialogue: 0,0:30:57.58,0:30:59.51,JPsub,NTP,0000,0000,0000,,Бір тамшы қан төгілмеді.
Dialogue: 0,0:31:00.74,0:31:03.08,JPsub,NTP,0000,0000,0000,,Таңда туып, түнде өлетін «дөңгелегі».
Dialogue: 0,0:31:03.41,0:31:04.74,JPsub,NTP,0000,0000,0000,,Алдағы адам Каджу емес.
Dialogue: 0,0:31:05.18,0:31:06.81,JPsub,NTP,0000,0000,0000,,Сен қазір тірісің ғой, солай ма?
Dialogue: 0,0:31:07.15,0:31:08.41,JPsub,NTP,0000,0000,0000,,W-неге?
Dialogue: 0,0:31:08.92,0:31:10.99,JPsub,NTP,0000,0000,0000,,Мен білмеймін. Енді, келесі.
Dialogue: 0,0:31:11.35,0:31:12.02,JPsub,NTP,0000,0000,0000,,Келесі
Dialogue: 0,0:31:12.94,0:31:14.53,JPsub,NTP,0000,0000,0000,,Тағы қайда барамыз?
Dialogue: 0,0:31:15.15,0:31:17.09,JPsub,NTP,0000,0000,0000,,Бұл сіздің шынайы үйіңіз.
Dialogue: 0,0:31:17.64,0:31:20.17,JPsub,NTP,0000,0000,0000,,Біртүрлі деп ойлағаным болмашы нәрсе еді.
Dialogue: 0,0:31:20.74,0:31:22.90,JPsub,NTP,0000,0000,0000,,Сіз 405-бөлме айттыңыз.
Dialogue: 0,0:31:23.51,0:31:26.77,JPsub,NTP,0000,0000,0000,,Бірақ Микия сенің атыңды айтты.
Dialogue: 0,0:31:27.34,0:31:30.92,JPsub,NTP,0000,0000,0000,,Әлгі әдіскер жігіт бұйрықты себепсіз өзгертпейді.
Dialogue: 0,0:31:31.48,0:31:38.74,JPsub,NTP,0000,0000,0000,,Егер солай болса, Наджу отбасының төртінші қабаттағы соңғы бөлмеде, 410-бөлмеде болмауы біртүрлі болар еді.
Dialogue: 0,0:31:39.69,0:31:42.94,JPsub,NTP,0000,0000,0000,,Мен түсінбеймін. Мен басқа бөлмеде тұрамын.
Dialogue: 0,0:31:43.30,0:31:50.21,JPsub,NTP,0000,0000,0000,,Каджу Сіз лифтпен жүрсеңіз, ол сіздің бөлмеңізге апарады деп ойлауға дағдыланғансыз, солай ма?
Dialogue: 0,0:31:50.60,0:31:51.83,JPsub,NTP,0000,0000,0000,,О, ой
Dialogue: 0,0:31:52.59,0:31:55.39,JPsub,NTP,0000,0000,0000,,Тақтайшаны ауыстырып, шығуды іліп қойдым.
Dialogue: 0,0:31:56.14,0:31:59.42,JPsub,NTP,0000,0000,0000,,Бұл лифт қозғала бастағанда, бұл бастама болды.
Dialogue: 0,0:32:00.12,0:32:02.28,JPsub,NTP,0000,0000,0000,,Барлығы керісінше
Dialogue: 0,0:32:02.89,0:32:05.80,JPsub,NTP,0000,0000,0000,,Бұл қатты және бұл үлкен блеф.
Dialogue: 0,0:32:06.30,0:32:09.52,JPsub,NTP,0000,0000,0000,,Мен оны борттағы адамдар байқамауы үшін жарты айналымға айналдырамын.
Dialogue: 0,0:32:10.48,0:32:13.09,JPsub,NTP,0000,0000,0000,,Мұндағы баспалдақтар спираль тәрізді.
Dialogue: 0,0:32:13.48,0:32:14.75,JPsub,NTP,0000,0000,0000,,Міне.
Dialogue: 0,0:32:15.13,0:32:18.28,JPsub,NTP,0000,0000,0000,,Баспалдақтар лифтке сәйкес келетіндей етіп ауыстырылған болуы керек.
Dialogue: 0,0:32:18.76,0:32:19.64,JPsub,NTP,0000,0000,0000,,Олай болса.
Dialogue: 0,0:32:20.02,0:32:22.85,JPsub,NTP,0000,0000,0000,,Шығудың кері бұрылғанын байқамай өмір сүріп жатырсың ба?
Dialogue: 0,0:32:23.37,0:32:24.50,JPsub,NTP,0000,0000,0000,,Бірақ бұл өтірік
Dialogue: 0,0:32:24.91,0:32:27.36,JPsub,NTP,0000,0000,0000,,Әдетте сіз байқайсыз және
Dialogue: 0,0:32:27.71,0:32:29.25,JPsub,NTP,0000,0000,0000,,Бұл жер қалыпты емес.
Dialogue: 0,0:32:29.69,0:32:33.64,JPsub,NTP,0000,0000,0000,,Айнала сол төртбұрышты көпқабатты үйлерге толы, табиғаты да онша ерекшеленбейді.
Dialogue: 0,0:32:34.24,0:32:35.81,JPsub,NTP,0000,0000,0000,,Іші қабырғамен бөлінген.
Dialogue: 0,0:32:36.27,0:32:40.49,JPsub,NTP,0000,0000,0000,,Кейбір жерлерде ендірілген күдікті өрнектер бар, бұл санаға салмақ түсіреді.
Dialogue: 0,0:32:41.02,0:32:42.28,JPsub,NTP,0000,0000,0000,,Бұл кедергі.
Dialogue: 0,0:32:42.82,0:32:45.97,JPsub,NTP,0000,0000,0000,,Кішкентай ауытқулар болмағандықтан, сіз ешқандай негізгі ауытқуларды байқамайсыз.
Dialogue: 0,0:32:46.58,0:32:49.64,JPsub,NTP,0000,0000,0000,,Сонда бұл шынымен менің үйім бе?
Dialogue: 0,0:32:49.87,0:32:54.18,JPsub,NTP,0000,0000,0000,,Дәлірек айтсам, мен көшіп келгеннен кейін лифт жұмыс істей бастағанша бір ай тұрған үй.
Dialogue: 0,0:32:54.48,0:32:55.84,JPsub,NTP,0000,0000,0000,,Осыдан кейін келесі бөлмеге өтіңіз
Dialogue: 0,0:32:56.20,0:32:57.38,JPsub,NTP,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:32:57.83,0:33:00.86,JPsub,NTP,0000,0000,0000,,Бірақ неге, қандай мақсатта және кім?
Dialogue: 0,0:33:01.33,0:33:03.64,JPsub,NTP,0000,0000,0000,,Ал сен мұны қайдан білесің?
Dialogue: 0,0:33:04.00,0:33:07.24,JPsub,NTP,0000,0000,0000,,Жүр, бірақ бұл жерді жобалаған жігіт біледі.
Dialogue: 0,0:33:07.86,0:33:09.01,JPsub,NTP,0000,0000,0000,,Оны аш, Йодзо.
Dialogue: 0,0:33:09.38,0:33:11.04,JPsub,NTP,0000,0000,0000,,Бұл менің алты айдағы бірінші үйім.
Dialogue: 0,0:33:14.10,0:33:15.69,JPsub,NTP,0000,0000,0000,,Бұл электр тогы ма?
Dialogue: 0,0:33:32.00,0:33:35.19,JPsub,NTP,0000,0000,0000,,Каджу Каджо Шындыққа қараңыз
Dialogue: 0,0:33:36.17,0:33:37.94,JPsub,NTP,0000,0000,0000,,Қайтыс болғанына жарты жыл болды.
Dialogue: 0,0:33:38.96,0:33:41.34,JPsub,NTP,0000,0000,0000,,Мұқият қара, шынымен солайсың!
Dialogue: 0,0:33:44.07,0:33:45.83,JPsub,NTP,0000,0000,0000,,Додж
Dialogue: 0,0:33:48.14,0:33:48.81,JPsub,NTP,0000,0000,0000,,На
Dialogue: 0,0:33:51.34,0:33:53.19,JPsub,NTP,0000,0000,0000,,Рёги сен
Dialogue: 0,0:33:53.48,0:33:57.33,JPsub,NTP,0000,0000,0000,,Бұл адамдар адам емес, олар жәй ғана өлгісі келетін қуыршақтар.
Dialogue: 0,0:33:57.72,0:33:58.82,JPsub,NTP,0000,0000,0000,,Оларды осылай тазартып отыруды жалғастыр.
Dialogue: 0,0:33:59.23,0:33:59.83,JPsub,NTP,0000,0000,0000,,Кеттік
Dialogue: 0,0:34:01.54,0:34:02.12,JPsub,NTP,0000,0000,0000,,Әй
Dialogue: 0,0:34:02.72,0:34:04.01,JPsub,NTP,0000,0000,0000,,Не болып жатыр?
Dialogue: 0,0:34:09.50,0:34:10.84,JPsub,NTP,0000,0000,0000,,Тыныш, сен
Dialogue: 0,0:35:24.83,0:35:26.39,JPsub,NTP,0000,0000,0000,,Керемет!
Dialogue: 0,0:35:28.32,0:35:29.74,JPsub,NTP,0000,0000,0000,,Рёги Мэй
Dialogue: 0,0:35:33.28,0:35:34.14,JPsub,NTP,0000,0000,0000,,Қай уақытта?
Dialogue: 0,0:35:36.87,0:35:39.59,JPsub,NTP,0000,0000,0000,,Мен бұл жігітті көре алмаймын.
Dialogue: 0,0:35:44.95,0:35:47.04,JPsub,NTP,0000,0000,0000,,Мен білемін, қымбаттым.
Dialogue: 0,0:35:47.32,0:35:52.11,JPsub,NTP,0000,0000,0000,,Сол мырза, соңғы екі жылда бірінші рет осылай кездесіп тұрмыз.
Dialogue: 0,0:35:52.53,0:35:54.84,JPsub,NTP,0000,0000,0000,,Мен қарсыласымды өлтіре аламын ба?
Dialogue: 0,0:35:56.48,0:35:57.63,JPsub,NTP,0000,0000,0000,,Сіз
Dialogue: 0,0:35:58.20,0:36:03.07,JPsub,NTP,0000,0000,0000,,Сиқыршы Сорен Арая, рәсімді өлтіруші.
Dialogue: 0,0:36:03.47,0:36:09.16,JPsub,NTP,0000,0000,0000,,Бұл ирониялық. Бастапқыда бұл кейінірек аяқталуы керек еді.
Dialogue: 0,0:36:10.27,0:36:13.63,JPsub,NTP,0000,0000,0000,,Бұл пәтер сіз үшін нені білдіреді?
Dialogue: 0,0:36:14.28,0:36:16.49,JPsub,NTP,0000,0000,0000,,Бұл қарапайым тәжірибе
Dialogue: 0,0:36:17.83,0:36:20.96,JPsub,NTP,0000,0000,0000,,Сонда бұл қайталау да сіздің хоббиіңіз бе?
Dialogue: 0,0:36:21.54,0:36:22.47,JPsub,NTP,0000,0000,0000,,Repetition
Dialogue: 0,0:36:22.98,0:36:29.82,JPsub,NTP,0000,0000,0000,,Уджо: Бұл көпқабатты үй тұрғындарының соңғы күнін қайта-қайта қайталап жатқан шығар.
Dialogue: 0,0:36:30.48,0:36:31.78,JPsub,NTP,0000,0000,0000,,Өлетін күн
Dialogue: 0,0:36:32.58,0:36:35.68,JPsub,NTP,0000,0000,0000,,Айттым ғой, түнде өледі, таңертең қайта қалпына келеді.
Dialogue: 0,0:36:36.14,0:36:38.61,JPsub,NTP,0000,0000,0000,,Бұл мәйітхана, күнделікті өмір бар.
Dialogue: 0,0:36:39.39,0:36:41.50,JPsub,NTP,0000,0000,0000,,Мен сенің қандай сиқыр қолданатыныңды білмеймін.
Dialogue: 0,0:36:42.22,0:36:46.13,JPsub,NTP,0000,0000,0000,,Мен бір күнде бітетін дүние жасадым.
Dialogue: 0,0:36:46.63,0:36:50.51,JPsub,NTP,0000,0000,0000,,Адамдар шынымен басқаша өле ала ма?
Dialogue: 0,0:36:50.87,0:36:56.56,JPsub,NTP,0000,0000,0000,,Мыңдаған рет қайталасаңыз, спираль бұрмаланады.
Dialogue: 0,0:36:57.08,0:37:00.52,JPsub,NTP,0000,0000,0000,,Бірақ әзірге нәтиже бірдей
Dialogue: 0,0:37:00.86,0:37:05.47,JPsub,NTP,0000,0000,0000,,Мен көремін. Қайта-қайта өліп жатқан Наджо ғана емес.
Dialogue: 0,0:37:06.00,0:37:07.76,JPsub,NTP,0000,0000,0000,,Мұның өзі эксперимент емес.
Dialogue: 0,0:37:08.40,0:37:11.48,JPsub,NTP,0000,0000,0000,,Бастапқыда жойылғандар
Dialogue: 0,0:37:12.13,0:37:15.90,JPsub,NTP,0000,0000,0000,,Барлығын өлтіріп, бір айда өлді
Dialogue: 0,0:37:16.54,0:37:19.31,JPsub,NTP,0000,0000,0000,,Бұл сіз салған көпқабатты үйдің кінәсі.
Dialogue: 0,0:37:20.00,0:37:21.52,JPsub,NTP,0000,0000,0000,,Сіз мені артқа итеріп жібердіңіз
Dialogue: 0,0:37:22.14,0:37:24.71,JPsub,NTP,0000,0000,0000,,Сондықтан мен тұрғындарды қуыршақтарға ауыстырдым.
Dialogue: 0,0:37:25.34,0:37:27.89,JPsub,NTP,0000,0000,0000,,Қуыршақ тасымалданды
Dialogue: 0,0:37:28.62,0:37:30.79,JPsub,NTP,0000,0000,0000,,Ал, онда мен
Dialogue: 0,0:37:31.19,0:37:33.60,JPsub,NTP,0000,0000,0000,,Мені неге өлтірдің?
Dialogue: 0,0:37:34.33,0:37:38.87,JPsub,NTP,0000,0000,0000,,Кири Мияджо да, Фуджино Асагами де тиімді болмады.
Dialogue: 0,0:37:39.29,0:37:40.04,JPsub,NTP,0000,0000,0000,,Біз Титанның басым көпшілігін қала шетіндегі бір бұрышқа айдауға қол жеткізсек те,
Dialogue: 0,0:37:40.46,0:37:45.96,JPsub,NTP,0000,0000,0000,,Өлімге жақын болғанымен, ол өлімді, сен өмірді таңдадың.
Dialogue: 0,0:37:46.48,0:37:52.60,JPsub,NTP,0000,0000,0000,,Бір-бірінің өмірін қиған кезде, ол кісі өлтіргенді ұнататын, ал сен бір-біріңді өлтіруді құрметтедің.
Dialogue: 0,0:37:53.41,0:38:01.80,JPsub,NTP,0000,0000,0000,,Олар жерлес болса да, екі ырымға да қайшы келетін қанішер екенін түсінсе керек.
Dialogue: 0,0:38:02.50,0:38:07.21,JPsub,NTP,0000,0000,0000,,Бұл екеуі менің саған арнап дайындаған нығметтерім.
Dialogue: 0,0:38:07.53,0:38:08.39,JPsub,NTP,0000,0000,0000,,Сіз
Dialogue: 0,0:38:08.69,0:38:13.02,JPsub,NTP,0000,0000,0000,,Томое жай ғана табылған зат болды. Бұл мені көп қиындықтан құтқарды.
Dialogue: 0,0:38:15.09,0:38:21.76,JPsub,NTP,0000,0000,0000,,Екі ырым Ештеңе - сенің бейберекет екпін, бастау
Dialogue: 0,0:38:22.41,0:38:28.21,JPsub,NTP,0000,0000,0000,,Сол қараңғылыққа қарап, есіміңді есте сақта
Dialogue: 0,0:38:28.43,0:38:29.33,JPsub,NTP,0000,0000,0000,,Кінәлі
Dialogue: 0,0:38:33.03,0:38:35.37,JPsub,NTP,0000,0000,0000,,Фуки Конго жыланы
Dialogue: 0,0:38:43.26,0:38:46.95,JPsub,NTP,0000,0000,0000,,Ол денені Сорен Арая қабылдады.
Dialogue: 0,0:38:50.90,0:38:51.73,JPsub,NTP,0000,0000,0000,,Дайтен
Dialogue: 0,0:38:54.19,0:38:59.23,JPsub,NTP,0000,0000,0000,,Осы сол қолға жетілмеген Будданың күлі салынған.
Dialogue: 0,0:38:59.64,0:39:04.74,JPsub,NTP,0000,0000,0000,,Тікелей өлімнің жаман көзі де оңай өлетін бөліктерді көре алмайды.
Dialogue: 0,0:39:06.56,0:39:09.56,JPsub,NTP,0000,0000,0000,,Иә, маған бет керек емес.
Dialogue: 0,0:39:17.95,0:39:19.17,JPsub,NTP,0000,0000,0000,,Қажетсіз көздер
Dialogue: 0,0:39:19.68,0:39:22.36,JPsub,NTP,0000,0000,0000,,Өйткені, ең алдымен оларды ұсақтау керек.
Dialogue: 0,0:39:24.17,0:39:27.68,JPsub,NTP,0000,0000,0000,,Жоқ, сіз қазір шешуіңіз керек еді.
Dialogue: 0,0:39:28.14,0:39:28.81,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:39:29.12,0:39:31.47,JPsub,NTP,0000,0000,0000,,Кедергі – бұл жай ғана шекара.
Dialogue: 0,0:39:31.91,0:39:34.76,JPsub,NTP,0000,0000,0000,,Сонда мен қия алмайтын ештеңе жоқ.
Dialogue: 0,0:39:38.62,0:39:41.19,JPsub,NTP,0000,0000,0000,,Бірақ тағы екеуі қалды.
Dialogue: 0,0:39:41.76,0:39:42.66,JPsub,NTP,0000,0000,0000,,Ол да баяу
Dialogue: 0,0:39:55.92,0:39:57.99,JPsub,NTP,0000,0000,0000,,Өлетін жаман уақыт.
Dialogue: 0,0:39:58.39,0:40:01.89,JPsub,NTP,0000,0000,0000,,Олай болса өлілер арасында адасайық, Шики.
Dialogue: 0,0:40:02.65,0:40:03.24,JPsub,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:40:26.41,0:40:29.52,JPsub,NTP,0000,0000,0000,,Менің шығу тегім – «тыныштық»
Dialogue: 0,0:40:31.65,0:40:38.96,JPsub,NTP,0000,0000,0000,,Менің екі жүз жылдан астам өмірімді не өлтіреді?
Dialogue: 0,0:40:42.04,0:40:44.54,JPsub,NTP,0000,0000,0000,,Чикушо Чикушо
Dialogue: 0,0:40:44.95,0:40:47.48,JPsub,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:41:32.17,0:41:32.82,JPsub,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:41:33.25,0:41:35.49,JPsub,NTP,0000,0000,0000,,Формула, кілт және т.б.
Dialogue: 0,0:00:01.00,0:00:01.00,JPsub,NTP,0000,0000,0000,,=========================p3==========================
Dialogue: 0,0:41:47.30,0:41:50.10,JPsub,NTP,0000,0000,0000,,Оның аты – Микия Курогири.
Dialogue: 0,0:41:51.44,0:41:54.12,JPsub,NTP,0000,0000,0000,,Бұл лицензия қандай біліктілікке жатады?
Dialogue: 0,0:41:54.40,0:41:56.57,JPsub,NTP,0000,0000,0000,,Біліктілік дәлелдемеге дейін төмендетілді
Dialogue: 0,0:41:56.71,0:41:58.07,JPsub,NTP,0000,0000,0000,,Бұл келісім-шартпен бірдей.
Dialogue: 0,0:41:58.27,0:41:59.51,JPsub,NTP,0000,0000,0000,,Соңына дейін баруға тура келеді, білесің бе.
Dialogue: 0,0:41:59.82,0:42:02.70,JPsub,NTP,0000,0000,0000,,Ауылда бір ай оқып үйренгенім.
Dialogue: 0,0:42:03.08,0:42:05.70,JPsub,NTP,0000,0000,0000,,Мен Киойкушаға ешқашан барған емеспін.
Dialogue: 0,0:42:05.93,0:42:07.04,JPsub,NTP,0000,0000,0000,,Сіз ашық айтасыз ба?
Dialogue: 0,0:42:07.63,0:42:08.19,JPsub,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,0:42:08.48,0:42:10.91,JPsub,NTP,0000,0000,0000,,Мен директордың автомектепке бара жатқанын көремін.
Dialogue: 0,0:42:11.11,0:42:12.63,JPsub,NTP,0000,0000,0000,,Бұл дөрекі.
Dialogue: 0,0:42:13.07,0:42:15.87,JPsub,NTP,0000,0000,0000,,Мен ол кезде әлі студент едім.
Dialogue: 0,0:42:16.57,0:42:17.67,JPsub,NTP,0000,0000,0000,,О, түсіндім.
Dialogue: 0,0:42:17.91,0:42:19.60,JPsub,NTP,0000,0000,0000,,Тооко-санның да жасөспірім кезі болған.
Dialogue: 0,0:42:19.78,0:42:20.27,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:42:23.12,0:42:25.13,JPsub,NTP,0000,0000,0000,,Бұл ескі таныстар.
Dialogue: 0,0:42:25.76,0:42:27.86,JPsub,NTP,0000,0000,0000,,Мен енді беттерді есіме түсіре алмаймын.
Dialogue: 0,0:42:28.41,0:42:30.32,JPsub,NTP,0000,0000,0000,,Мен оны альбомнан шығардым.
Dialogue: 0,0:42:31.06,0:42:32.57,JPsub,NTP,0000,0000,0000,,Лондонда академия бар.
Dialogue: 0,0:42:34.53,0:42:35.55,JPsub,NTP,0000,0000,0000,,Ер адам
Dialogue: 0,0:42:36.10,0:42:38.00,JPsub,NTP,0000,0000,0000,,Ол бастапқыда Таймицу монахы болған сияқты.
Dialogue: 0,0:42:38.70,0:42:40.40,JPsub,NTP,0000,0000,0000,,Оның қабілеттері саңылауларға толы болды, бірақ
Dialogue: 0,0:42:40.58,0:42:43.23,JPsub,NTP,0000,0000,0000,,Өзінің күші бәрінен де асып түсті.
Dialogue: 0,0:42:43.84,0:42:46.61,JPsub,NTP,0000,0000,0000,,Маған әлгі ебедейсіз жігіт ұнады.
Dialogue: 0,0:42:47.47,0:42:48.73,JPsub,NTP,0000,0000,0000,,Мен қуыршақпын
Dialogue: 0,0:42:49.11,0:42:50.76,JPsub,NTP,0000,0000,0000,,Ол жанның көріпкелі.
Dialogue: 0,0:42:51.22,0:42:54.01,JPsub,NTP,0000,0000,0000,,Адамның түпнұсқасына жету туралы
Dialogue: 0,0:42:54.74,0:42:56.08,JPsub,NTP,0000,0000,0000,,Мен бас тарттым, бірақ
Dialogue: 0,0:42:56.24,0:42:57.66,JPsub,NTP,0000,0000,0000,,Ол мұны істей береді, солай ма?
Dialogue: 0,0:42:58.59,0:43:00.18,JPsub,NTP,0000,0000,0000,,Адамның «шығу тегіне» қарайтындар
Dialogue: 0,0:43:00.30,0:43:02.54,JPsub,NTP,0000,0000,0000,,Әңгіме – оны қожайынынан шығарып жіберген.
Dialogue: 0,0:43:03.12,0:43:04.19,JPsub,NTP,0000,0000,0000,,Тыңда, Куротори
Dialogue: 0,0:43:04.72,0:43:05.95,JPsub,NTP,0000,0000,0000,,Э? Мен сені естімеймін!
Dialogue: 0,0:43:06.04,0:43:07.49,JPsub,NTP,0000,0000,0000,,Ол кісіден аулақ жүр.
Dialogue: 0,0:43:18.78,0:43:20.19,JPsub,NTP,0000,0000,0000,,Сәлем Аозаки
Dialogue: 0,0:43:20.54,0:43:21.76,JPsub,NTP,0000,0000,0000,,Біраз уақыт өтті.
Dialogue: 0,0:43:22.16,0:43:23.82,JPsub,NTP,0000,0000,0000,,Өзіңізді қалай сезінесіз?
Dialogue: 0,0:43:24.33,0:43:26.19,JPsub,NTP,0000,0000,0000,,Корнелиус Альба
Dialogue: 0,0:43:26.60,0:43:31.54,JPsub,NTP,0000,0000,0000,,Спонхайм аббаттығының келесі аббаты осындай жерде қандай мақсатпен жұмыс істейді?
Dialogue: 0,0:43:32.23,0:43:34.62,JPsub,NTP,0000,0000,0000,,Егер сіз мұнда бос сөз айту үшін келген болсаңыз, кетіңіз.
Dialogue: 0,0:43:35.18,0:43:39.11,JPsub,NTP,0000,0000,0000,,Менің әлеміме рұқсатсыз кірдің.
Dialogue: 0,0:43:39.57,0:43:42.93,JPsub,NTP,0000,0000,0000,,Оның қасында серігі бар сияқты көрінді, сондықтан сәлемдесуді қойдым.
Dialogue: 0,0:43:44.61,0:43:47.12,JPsub,NTP,0000,0000,0000,,Бұл пәтер сіздің шеберханаңыз болды ма?
Dialogue: 0,0:43:47.56,0:43:50.42,JPsub,NTP,0000,0000,0000,,Олай болса, біз қабылдауымызды өзгертуіміз керек.
Dialogue: 0,0:43:51.54,0:43:54.06,JPsub,NTP,0000,0000,0000,,Мені арзан бағаламауыңызды өтінемін.
Dialogue: 0,0:43:54.65,0:43:56.83,JPsub,NTP,0000,0000,0000,,Қуыршақтардың денелерін дайында.
Dialogue: 0,0:43:57.14,0:44:00.97,JPsub,NTP,0000,0000,0000,,Менің шеберлігім – мидың кемігін ғана тірі қалдыру.
Dialogue: 0,0:44:01.57,0:44:08.57,JPsub,NTP,0000,0000,0000,,Бұл пәтер сиқырлы эксперименттердің сыртқа ағып кетуіне жол бермеу үшін орнатылған ең басты кедергі болып табылады.
Dialogue: 0,0:44:09.15,0:44:14.75,JPsub,NTP,0000,0000,0000,,Менің білуімше, мұндай нәрсемен бір ғана адам айналысады деп ойладым.
Dialogue: 0,0:44:15.18,0:44:15.97,JPsub,NTP,0000,0000,0000,,Тооко-сан
Dialogue: 0,0:44:16.39,0:44:17.58,JPsub,NTP,0000,0000,0000,,Сіз қай уақытта келдіңіз?
Dialogue: 0,0:44:18.07,0:44:18.84,JPsub,NTP,0000,0000,0000,,Сакиса
Dialogue: 0,0:44:19.75,0:44:21.40,JPsub,NTP,0000,0000,0000,,Көркем көрме жақсы қабылданған сияқты.
Dialogue: 0,0:44:21.94,0:44:23.29,JPsub,NTP,0000,0000,0000,,Сізде тұтынушылар тізімі бар ма?
Dialogue: 0,0:44:23.65,0:44:24.14,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:44:25.13,0:44:25.90,JPsub,NTP,0000,0000,0000,,Жаңа гүлдер
Dialogue: 0,0:44:26.42,0:44:28.79,JPsub,NTP,0000,0000,0000,,Мен саған сиқырды көпшіліктің алдында қолданба деп айттым.
Dialogue: 0,0:44:29.52,0:44:30.31,JPsub,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:44:30.87,0:44:33.53,JPsub,NTP,0000,0000,0000,,Басқалар білсе, жаман емес пе?
Dialogue: 0,0:44:33.93,0:44:34.46,JPsub,NTP,0000,0000,0000,,О
Dialogue: 0,0:44:34.70,0:44:36.04,JPsub,NTP,0000,0000,0000,,Сиқырдың өткірлігі төмендейді
Dialogue: 0,0:44:36.46,0:44:39.58,JPsub,NTP,0000,0000,0000,,Сиқыршылар өз зерттеулерінің нәтижесін ешкімге көрсетпейді.
Dialogue: 0,0:44:39.95,0:44:42.95,JPsub,NTP,0000,0000,0000,,Бұл тек өзіңіз үшін оқу мақсаты ма?
Dialogue: 0,0:44:43.58,0:44:45.37,JPsub,NTP,0000,0000,0000,,Бұл нөлмен бірдей емес пе?
Dialogue: 0,0:44:45.68,0:44:46.42,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:44:46.83,0:44:47.91,JPsub,NTP,0000,0000,0000,,Мақсат бар
Dialogue: 0,0:44:48.38,0:44:51.12,JPsub,NTP,0000,0000,0000,,Сиқыршылардың түпкі мақсаты қандай?
Dialogue: 0,0:44:51.56,0:44:52.93,JPsub,NTP,0000,0000,0000,,Құйынды көз
Dialogue: 0,0:44:53.56,0:44:57.49,JPsub,NTP,0000,0000,0000,,Акашикалық жазбалар деп те аталатын барлық құбылыстардың қайнар көзі
Dialogue: 0,0:44:57.88,0:45:01.24,JPsub,NTP,0000,0000,0000,,Әр нәрсенің себебі, ақиқатқа жету.
Dialogue: 0,0:45:01.69,0:45:08.01,JPsub,NTP,0000,0000,0000,,Бір теория бойынша бұл дүниенің өткені, бүгіні және болашағы сонда жазылған.
Dialogue: 0,0:45:08.19,0:45:10.19,JPsub,NTP,0000,0000,0000,,Мен мұндай нәрселерге қызықпаймын.
Dialogue: 0,0:45:10.50,0:45:14.93,JPsub,NTP,0000,0000,0000,,Бар-жоғын білмейтін нәрсенің соңынан еру – бос сөз.
Dialogue: 0,0:45:15.60,0:45:17.44,JPsub,NTP,0000,0000,0000,,Бұл күлкі емес
Dialogue: 0,0:45:17.78,0:45:19.66,JPsub,NTP,0000,0000,0000,,Тіпті егер
Dialogue: 0,0:45:19.96,0:45:22.11,JPsub,NTP,0000,0000,0000,,Сіз бұл дүниеде кімге қол жеткізе аласыз?
Dialogue: 0,0:45:22.77,0:45:24.76,JPsub,NTP,0000,0000,0000,,Келген адамдар бар
Dialogue: 0,0:45:25.20,0:45:27.99,JPsub,NTP,0000,0000,0000,,Мен оны кездестіргендіктен оның шынайы болмысын түсіндім.
Dialogue: 0,0:45:28.35,0:45:28.91,JPsub,NTP,0000,0000,0000,,Бірақ
Dialogue: 0,0:45:29.52,0:45:32.32,JPsub,NTP,0000,0000,0000,,Арғы жаққа кеткендер қайтып оралған жоқ.
Dialogue: 0,0:45:33.03,0:45:37.41,JPsub,NTP,0000,0000,0000,,Бұрын ол жерге жете алатын сиқыршылардың бәрі жоғалып кеткен.
Dialogue: 0,0:45:37.92,0:45:38.81,JPsub,NTP,0000,0000,0000,,Кез келген жағдайда
Dialogue: 0,0:45:39.23,0:45:43.23,JPsub,NTP,0000,0000,0000,,Шексіз мақсат, мәңгілік сыйсыз топ
Dialogue: 0,0:45:43.73,0:45:46.15,JPsub,NTP,0000,0000,0000,,Әлем мұны сиқыршы деп атайды
Dialogue: 0,0:45:46.40,0:45:48.90,JPsub,NTP,0000,0000,0000,,Шики еркек пе, әлде әйел ме?
Dialogue: 0,0:45:49.30,0:45:49.85,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:45:54.85,0:45:55.65,JPsub,NTP,0000,0000,0000,,Жаңа гүлдер
Dialogue: 0,0:45:56.19,0:45:57.07,JPsub,NTP,0000,0000,0000,,Енді ше?
Dialogue: 0,0:45:57.52,0:45:58.34,JPsub,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:45:58.76,0:46:01.97,JPsub,NTP,0000,0000,0000,,Өрнегі мен ағасы анық болмағандықтан болар.
Dialogue: 0,0:46:02.36,0:46:04.64,JPsub,NTP,0000,0000,0000,,Шики әйел ретінде кездесе ме?
Dialogue: 0,0:46:05.33,0:46:06.76,JPsub,NTP,0000,0000,0000,,Ер адам ретінде?
Dialogue: 0,0:46:07.40,0:46:09.74,JPsub,NTP,0000,0000,0000,,Бұл дөрекі болжау деп аталады.
Dialogue: 0,0:46:10.25,0:46:12.07,JPsub,NTP,0000,0000,0000,,Бұл туралы айтатын нәрсе емес.
Dialogue: 0,0:46:12.69,0:46:13.47,JPsub,NTP,0000,0000,0000,,Юкине-кун, барсың ба?
Dialogue: 0,0:46:13.99,0:46:16.56,JPsub,NTP,0000,0000,0000,,Менің сезімім екі жаққа да өзгермейді деп ойлаймын.
Dialogue: 0,0:46:17.02,0:46:19.54,JPsub,NTP,0000,0000,0000,,Рәсім ерлерге де, әйелдерге де ұнайды.
Dialogue: 0,0:46:21.97,0:46:24.96,JPsub,NTP,0000,0000,0000,,Иә, мүмкін.
Dialogue: 0,0:46:25.93,0:46:27.07,JPsub,NTP,0000,0000,0000,,Қандай лас
Dialogue: 0,0:46:30.05,0:46:30.73,JPsub,NTP,0000,0000,0000,,Тооко-сан
Dialogue: 0,0:46:31.28,0:46:32.34,JPsub,NTP,0000,0000,0000,,Оны тоқтатыңыз.
Dialogue: 0,0:46:32.66,0:46:34.10,JPsub,NTP,0000,0000,0000,,Адам, сен ең жақсысың.
Dialogue: 0,0:46:35.68,0:46:36.98,JPsub,NTP,0000,0000,0000,,Міне, Куротори
Dialogue: 0,0:46:37.35,0:46:37.84,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:46:39.01,0:46:42.21,JPsub,NTP,0000,0000,0000,,Шикидің еркек екеніне шынымен мән бересің бе?
Dialogue: 0,0:46:42.68,0:46:46.43,JPsub,NTP,0000,0000,0000,,Жарайды, сараңдық десең, мен қызды жақсы көремін.
Dialogue: 0,0:46:46.81,0:46:47.56,JPsub,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:46:47.84,0:46:49.56,JPsub,NTP,0000,0000,0000,,Сонда ешқандай проблема жоқ, солай ма?
Dialogue: 0,0:46:49.87,0:46:51.71,JPsub,NTP,0000,0000,0000,,А, мәселе жоқ.
Dialogue: 0,0:46:52.01,0:46:54.75,JPsub,NTP,0000,0000,0000,,А, Шики сөзсіз әйел.
Dialogue: 0,0:46:55.07,0:46:56.45,JPsub,NTP,0000,0000,0000,,Сіздің үніңіз қандай болды?
Dialogue: 0,0:46:56.90,0:47:01.29,JPsub,NTP,0000,0000,0000,,Бұл қайтыс болған адамға бейсаналық түрде жасалған өтемақы әрекеті болды.
Dialogue: 0,0:47:01.65,0:47:04.52,JPsub,NTP,0000,0000,0000,,Ең болмағанда есіңізде болар деп үміттенемін.
Dialogue: 0,0:47:05.84,0:47:06.42,JPsub,NTP,0000,0000,0000,,Мүлдем
Dialogue: 0,0:47:06.54,0:47:07.69,JPsub,NTP,0000,0000,0000,,Сүйкімді емес пе?
Dialogue: 0,0:47:08.60,0:47:09.28,JPsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,0:47:09.73,0:47:11.38,JPsub,NTP,0000,0000,0000,,Тайдзитудың не екенін білесің бе?
Dialogue: 0,0:47:12.41,0:47:13.26,JPsub,NTP,0000,0000,0000,,Тайджи диаграммасы
Dialogue: 0,0:47:14.00,0:47:18.41,JPsub,NTP,0000,0000,0000,,Ақ пен қараның тоғысқан жарты айы инь мен янды білдіреді.
Dialogue: 0,0:47:18.71,0:47:19.64,JPsub,NTP,0000,0000,0000,,Жарық пен қараңғылық
Dialogue: 0,0:47:20.05,0:47:21.02,JPsub,NTP,0000,0000,0000,,Оң және теріс
Dialogue: 0,0:47:21.40,0:47:22.63,JPsub,NTP,0000,0000,0000,,Ер мен әйел
Dialogue: 0,0:47:23.21,0:47:29.10,JPsub,NTP,0000,0000,0000,,Екеуіндегі кішкентай саңылау қарама-қайшылықтар мен өзара қақтығыстар спираль болып табылады.
Dialogue: 0,0:47:29.52,0:47:32.38,JPsub,NTP,0000,0000,0000,,Бұл Онмиодода «Рёги» деп аталады.
Dialogue: 0,0:47:33.44,0:47:34.56,JPsub,NTP,0000,0000,0000,,Кез келген адам
Dialogue: 0,0:47:34.81,0:47:37.26,JPsub,NTP,0000,0000,0000,,Бұл гетеросексуалдық артықшылықтарға ие нәрсе.
Dialogue: 0,0:47:38.65,0:47:41.42,JPsub,NTP,0000,0000,0000,,Бір бастаудан екіге бөліну күйі
Dialogue: 0,0:47:42.16,0:47:45.26,JPsub,NTP,0000,0000,0000,,Огава сарайы Тайдзитудың бейнесінен басқа ештеңе емес
Dialogue: 0,0:47:46.16,0:47:46.93,JPsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,0:47:47.32,0:47:49.58,JPsub,NTP,0000,0000,0000,,Чимихамадағы Огава сарайы туралы білесіз бе?
Dialogue: 0,0:47:49.91,0:47:52.94,JPsub,NTP,0000,0000,0000,,Бұл қалпына келтірілген аумақта салынған кондоминиум аумағы ма?
Dialogue: 0,0:47:53.37,0:47:53.84,JPsub,NTP,0000,0000,0000,,О
Dialogue: 0,0:47:54.29,0:47:56.79,JPsub,NTP,0000,0000,0000,,Бұл бір кездері сәулет өнерімен айналысқан пәтер.
Dialogue: 0,0:47:57.36,0:48:00.93,JPsub,NTP,0000,0000,0000,,Мен жақыннан білетін детективтен біртүрлі әңгіме естідім.
Dialogue: 0,0:48:01.39,0:48:02.04,JPsub,NTP,0000,0000,0000,,Басқаша айтқанда
Dialogue: 0,0:48:02.36,0:48:04.73,JPsub,NTP,0000,0000,0000,,Сонда сіз маған мұны қарап шығуды айтып тұрсыз ба?
Dialogue: 0,0:48:05.27,0:48:06.04,JPsub,NTP,0000,0000,0000,,Директор
Dialogue: 0,0:48:06.77,0:48:07.35,JPsub,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:48:07.49,0:48:08.87,JPsub,NTP,0000,0000,0000,,Сайтқа бірге барайық.
Dialogue: 0,0:48:09.39,0:48:13.56,JPsub,NTP,0000,0000,0000,,Тұрғындардың тізімін жасап, мүмкіндігінше олардың бұрын қай жерде тұрғанын біліңіз.
Dialogue: 0,0:48:14.29,0:48:15.81,JPsub,NTP,0000,0000,0000,,Өйткені бұл ақша әкелмейтін жұмыс.
Dialogue: 0,0:48:16.04,0:48:16.80,JPsub,NTP,0000,0000,0000,,Баяу қабылдаған дұрыс.
Dialogue: 0,0:48:17.34,0:48:17.86,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:48:18.80,0:48:20.27,JPsub,NTP,0000,0000,0000,,Міне, Куротори
Dialogue: 0,0:48:20.48,0:48:21.09,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:48:21.73,0:48:24.81,JPsub,NTP,0000,0000,0000,,Шикидің еркек екеніне шынымен мән бересің бе?
Dialogue: 0,0:48:31.07,0:48:31.92,JPsub,NTP,0000,0000,0000,,Не?
Dialogue: 0,0:48:32.27,0:48:34.50,JPsub,NTP,0000,0000,0000,,Бұл жер асты тұрағы емес пе?
Dialogue: 0,0:48:35.08,0:48:35.57,JPsub,NTP,0000,0000,0000,,Кеттік
Dialogue: 0,0:48:39.26,0:48:39.79,JPsub,NTP,0000,0000,0000,,Сәлем
Dialogue: 0,0:48:40.19,0:48:40.98,JPsub,NTP,0000,0000,0000,,Good morning ceremony
Dialogue: 0,0:48:41.57,0:48:42.46,JPsub,NTP,0000,0000,0000,,Біз ешкімге бұл мағынасыз өлім болды деп айтуға мүмкіндік бермейміз
Dialogue: 0,0:48:42.86,0:48:44.70,JPsub,NTP,0000,0000,0000,,Біраз уақыт күн ашық болады деп естідім.
Dialogue: 0,0:48:46.34,0:48:46.94,JPsub,NTP,0000,0000,0000,,Микия
Dialogue: 0,0:48:47.26,0:48:48.51,JPsub,NTP,0000,0000,0000,,Мұны кім жасады?
Dialogue: 0,0:48:51.21,0:48:52.00,JPsub,NTP,0000,0000,0000,,Ах, Акитака-сан.
Dialogue: 0,0:48:52.77,0:48:55.02,JPsub,NTP,0000,0000,0000,,Формула Сіз кеше түнде болған жоқсыз, солай ма?
Dialogue: 0,0:48:55.51,0:48:57.31,JPsub,NTP,0000,0000,0000,,Үйге келе жатқанымда, мен Акитака-санды кездестірдім.
Dialogue: 0,0:48:57.71,0:48:59.04,JPsub,NTP,0000,0000,0000,,Мен оны сол кезде ұстадым.
Dialogue: 0,0:48:59.46,0:49:01.85,JPsub,NTP,0000,0000,0000,,Канесада ше?
Dialogue: 0,0:49:02.35,0:49:04.54,JPsub,NTP,0000,0000,0000,,Сол мақсат үшін 9 таңба қосыңыз
Dialogue: 0,0:49:04.83,0:49:05.99,JPsub,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:49:06.36,0:49:07.13,JPsub,NTP,0000,0000,0000,,Көрдіңіз бе?
Dialogue: 0,0:49:07.57,0:49:09.65,JPsub,NTP,0000,0000,0000,,Бұл сіз жиі көрмейтін нәрсе.
Dialogue: 0,0:49:09.98,0:49:10.54,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:49:10.94,0:49:12.01,JPsub,NTP,0000,0000,0000,,Бұл ескі қылыш.
Dialogue: 0,0:49:12.50,0:49:13.59,JPsub,NTP,0000,0000,0000,,Оны бұл жерден шығармаңыз
Dialogue: 0,0:49:14.06,0:49:15.67,JPsub,NTP,0000,0000,0000,,Барлық тосқауыл бұзылды.
Dialogue: 0,0:49:16.26,0:49:16.85,JPsub,NTP,0000,0000,0000,,Бізге асығыс керек.
Dialogue: 0,0:49:17.12,0:49:17.92,JPsub,NTP,0000,0000,0000,,Мен түсінемін.
Dialogue: 0,0:49:18.47,0:49:19.35,JPsub,NTP,0000,0000,0000,,, Курогири
Dialogue: 0,0:49:19.93,0:49:21.24,JPsub,NTP,0000,0000,0000,,Бүгін кешігіп қалған сияқтысыз.
Dialogue: 0,0:49:21.65,0:49:22.38,JPsub,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:49:22.81,0:49:23.56,JPsub,NTP,0000,0000,0000,,Шын мәнінде
Dialogue: 0,0:49:24.72,0:49:29.51,JPsub,NTP,0000,0000,0000,,Огава сарайы Чимихамадағы ең сәнді ғимараттардың бірі.
Dialogue: 0,0:49:30.28,0:49:31.70,JPsub,NTP,0000,0000,0000,,Қарап көрсеңіз түсінесіз.
Dialogue: 0,0:49:32.16,0:49:37.14,JPsub,NTP,0000,0000,0000,,Бұл көпқабатты үй бір-біріне жақын салынған жарты ай тәрізді он қабатты үй.
Dialogue: 0,0:49:37.65,0:49:38.79,JPsub,NTP,0000,0000,0000,,Ол өзгертілді.
Dialogue: 0,0:49:39.29,0:49:43.60,JPsub,NTP,0000,0000,0000,,Ол компанияның жатақханасы болуы керек еді, бірақ бірінші және екінші қабаттар демалыс орны ретінде пайдаланылды.
Dialogue: 0,0:49:44.02,0:49:45.78,JPsub,NTP,0000,0000,0000,,Қазіргі уақытта қолданылмайды
Dialogue: 0,0:49:46.49,0:49:48.63,JPsub,NTP,0000,0000,0000,,Бір қабатта шығыс пен батыста барлығы 10 бөлме бар.
Dialogue: 0,0:49:49.07,0:49:51.62,JPsub,NTP,0000,0000,0000,,Автотұрақ сайтта және жер астында да бар
Dialogue: 0,0:49:52.17,0:49:53.53,JPsub,NTP,0000,0000,0000,,Иесі көлікті жолда жалға алады.
Dialogue: 0,0:49:53.88,0:49:55.08,JPsub,NTP,0000,0000,0000,,Жалпы қолдануға ауысу
Dialogue: 0,0:49:55.50,0:49:57.37,JPsub,NTP,0000,0000,0000,,Тұрғындар осы жылдан бастап көшіп кете алады.
Dialogue: 0,0:49:58.18,0:50:01.10,JPsub,NTP,0000,0000,0000,,Шамасы, лифт мамыр айына дейін пайдаланылмаған.
Dialogue: 0,0:50:06.80,0:50:07.45,JPsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,0:50:07.76,0:50:09.04,JPsub,NTP,0000,0000,0000,,Бұл менің қиялым ғана
Dialogue: 0,0:50:09.71,0:50:10.60,JPsub,NTP,0000,0000,0000,,Кеттік
Dialogue: 0,0:50:11.33,0:50:14.43,JPsub,NTP,0000,0000,0000,,Екі ғимаратты тек орталық фойе байланыстырады.
Dialogue: 0,0:50:14.89,0:50:18.54,JPsub,NTP,0000,0000,0000,,Шығыс және батыс ғимараттарға екінші қабаттан бастап тікелей кіру мүмкін емес.
Dialogue: 0,0:50:19.29,0:50:21.62,JPsub,NTP,0000,0000,0000,,Сіз міндетті түрде вестибюльден өтуіңіз керек.
Dialogue: 0,0:50:22.93,0:50:24.54,JPsub,NTP,0000,0000,0000,,Бұл жиіркенішті ғимарат.
Dialogue: 0,0:50:24.74,0:50:25.49,JPsub,NTP,0000,0000,0000,,Дұшпан тұзақты тарылтып жатыр.
Dialogue: 0,0:50:25.79,0:50:28.95,JPsub,NTP,0000,0000,0000,,Адам баласы азғантай қулықпен психикалық ауруға ұшырауы мүмкін.
Dialogue: 0,0:50:29.37,0:50:31.92,JPsub,NTP,0000,0000,0000,,Қабырғалардың түсі, баспалдақтардың орналасуы және т.б.
Dialogue: 0,0:50:32.53,0:50:34.41,JPsub,NTP,0000,0000,0000,,Күнделікті пайдаланатын тұрғын болса
Dialogue: 0,0:50:34.77,0:50:36.22,JPsub,NTP,0000,0000,0000,,Ол одан да нашарлайды.
Dialogue: 0,0:50:37.52,0:50:42.54,JPsub,NTP,0000,0000,0000,,Сіз лифттен шыққанда 406-дан 410-ға дейінгі бөлмелер алдыңызда болады.
Dialogue: 0,0:50:43.49,0:50:44.29,JPsub,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:50:44.90,0:50:46.52,JPsub,NTP,0000,0000,0000,,Маған қатты ұнады. Өте әдемі орын.
Dialogue: 0,0:50:48.11,0:50:50.60,JPsub,NTP,0000,0000,0000,,401-405
Dialogue: 0,0:50:51.08,0:50:52.53,JPsub,NTP,0000,0000,0000,,Схемадағы қателік шығар
Dialogue: 0,0:50:53.19,0:50:55.04,JPsub,NTP,0000,0000,0000,,Батыс қанатқа қалай жетуге болады?
Dialogue: 0,0:50:56.11,0:50:58.02,JPsub,NTP,0000,0000,0000,,Лифттің артқы жағына өтіңіз.
Dialogue: 0,0:50:58.90,0:51:00.07,JPsub,NTP,0000,0000,0000,,Бұл біртүрлі құрылыс, солай емес пе?
Dialogue: 0,0:51:00.71,0:51:02.62,JPsub,NTP,0000,0000,0000,,Сыртынан қосылсам екен.
Dialogue: 0,0:51:03.51,0:51:04.13,JPsub,NTP,0000,0000,0000,,Ал Шинигами өзі түсіріп алған дәптерді алған адамға
Dialogue: 0,0:51:04.37,0:51:06.37,JPsub,NTP,0000,0000,0000,,Төртінші қабатта қандай шаруаңыз бар?
Dialogue: 0,0:51:06.93,0:51:09.19,JPsub,NTP,0000,0000,0000,,Сіз қайтыс болған отбасы мүшесінің бөлмесіне барасыз ба?
Dialogue: 0,0:51:09.62,0:51:10.16,JPsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:51:10.67,0:51:11.89,JPsub,NTP,0000,0000,0000,,Бұл әңгіме қайда?
Dialogue: 0,0:51:12.54,0:51:14.88,JPsub,NTP,0000,0000,0000,,Сондықтан бұл мен жақын жүрген детективтен.
Dialogue: 0,0:51:15.31,0:51:16.12,JPsub,NTP,0000,0000,0000,,Сіз де
Dialogue: 0,0:51:16.83,0:51:17.97,JPsub,NTP,0000,0000,0000,,Барып, тексеріп алыңыз.
Dialogue: 0,0:51:18.48,0:51:20.76,JPsub,NTP,0000,0000,0000,,Мен лифтті жалғыз пайдаланғым келеді.
Dialogue: 0,0:51:21.94,0:51:23.28,JPsub,NTP,0000,0000,0000,,Жоғарыда кездесейік.
Dialogue: 0,0:51:23.78,0:51:25.42,JPsub,NTP,0000,0000,0000,,Жоғары көтерілу үшін баспалдақты пайдаланыңыз.
Dialogue: 0,0:51:26.10,0:51:27.61,JPsub,NTP,0000,0000,0000,,Көзіңізді жұмып алғаныңыз жөн.
Dialogue: 0,0:51:28.74,0:51:29.44,JPsub,NTP,0000,0000,0000,,Осы үшін оны мектептен шығарып жіберсе жақсы болар еді.
Dialogue: 0,0:51:33.00,0:51:35.57,JPsub,NTP,0000,0000,0000,,Шығыс ғимарат 1-бөлмеден 5-бөлмеге дейін
Dialogue: 0,0:51:36.00,0:51:38.51,JPsub,NTP,0000,0000,0000,,Батыс ғимараты 6 бөлмеден 10 бөлмеге дейін
Dialogue: 0,0:51:39.04,0:51:46.82,JPsub,NTP,0000,0000,0000,,Үшінші қабаттағы тұрғындар: Сонода, Бос бөлме, Ватанабе, Бос Ицуки, Такемото, Бос бөлме, Каймон, Бос бөлме, Тунджи.
Dialogue: 0,0:51:47.13,0:51:56.12,JPsub,NTP,0000,0000,0000,,Төртінші қабаттағы тұрғындар: Соку, Соку, Сасая, Мочизуки Шинтани Соку, Соку, Цужиномия, Уэйама, Уджо
Dialogue: 0,0:51:56.23,0:51:56.68,JPsub,NTP,0000,0000,0000,,Туко
Dialogue: 0,0:51:56.95,0:51:58.30,JPsub,NTP,0000,0000,0000,,Ағымдағы тізім
Dialogue: 0,0:52:01.55,0:52:02.32,JPsub,NTP,0000,0000,0000,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:52:03.04,0:52:05.32,JPsub,NTP,0000,0000,0000,,Осындай ерекше атау.
Dialogue: 0,0:52:05.83,0:52:06.75,JPsub,NTP,0000,0000,0000,,Алдымен үйге барыңыз
Dialogue: 0,0:52:07.25,0:52:07.74,JPsub,NTP,0000,0000,0000,,Туко
Dialogue: 0,0:52:07.99,0:52:09.36,JPsub,NTP,0000,0000,0000,,Аяқ ретінде қолдануға болатын нәрсе бар ма?
Dialogue: 0,0:52:09.86,0:52:11.72,JPsub,NTP,0000,0000,0000,,Менде 200 велосипед қалды.
Dialogue: 0,0:52:12.32,0:52:12.86,JPsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:52:13.40,0:52:15.45,JPsub,NTP,0000,0000,0000,,Харлиді шығармаңыз.
Dialogue: 0,0:52:15.98,0:52:17.89,JPsub,NTP,0000,0000,0000,,Мен бүйірдегі арбаны әлі шешкен жоқпын.
Dialogue: 0,0:52:18.34,0:52:18.90,JPsub,NTP,0000,0000,0000,,О
Dialogue: 0,0:52:19.37,0:52:19.91,JPsub,NTP,0000,0000,0000,,Микия
Dialogue: 0,0:52:20.20,0:52:21.25,JPsub,NTP,0000,0000,0000,,Мен қылышты аламын.
Dialogue: 0,0:52:21.58,0:52:22.15,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:52:23.62,0:52:24.60,JPsub,NTP,0000,0000,0000,,Бұл не, Микия?
Dialogue: 0,0:52:25.09,0:52:26.89,JPsub,NTP,0000,0000,0000,,Эй, не болды, Армин? Өзіңді қолыңнан ал, иә? Эй!
Dialogue: 0,0:52:27.01,0:52:27.74,JPsub,NTP,0000,0000,0000,,Мен түнде барамын
Dialogue: 0,0:52:27.89,0:52:28.62,JPsub,NTP,0000,0000,0000,,Сондай-ақ сол кезде
Dialogue: 0,0:52:28.99,0:52:30.15,JPsub,NTP,0000,0000,0000,,Қандай қызық жігіт.
Dialogue: 0,0:52:30.52,0:52:32.04,JPsub,NTP,0000,0000,0000,,Мен сол уақытта боламын.
Dialogue: 0,0:52:32.36,0:52:33.01,JPsub,NTP,0000,0000,0000,,Осы үшін оны мектептен шығарып жіберсе жақсы болар еді.
Dialogue: 0,0:52:43.45,0:52:44.21,JPsub,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:52:44.54,0:52:47.00,JPsub,NTP,0000,0000,0000,,Формула, кілт т.б.
Dialogue: 0,0:52:48.84,0:52:49.44,JPsub,NTP,0000,0000,0000,,О
Dialogue: 0,0:52:49.63,0:52:50.42,JPsub,NTP,0000,0000,0000,,Акитака мырза
Dialogue: 0,0:52:52.25,0:52:53.11,JPsub,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:52:53.46,0:52:57.09,JPsub,NTP,0000,0000,0000,,Курогири есімді бала үшін оның алаңдаған түрі түсінікті.
Dialogue: 0,0:52:57.39,0:52:59.34,JPsub,NTP,0000,0000,0000,,Шекара!
Dialogue: 0,0:52:59.73,0:53:01.82,JPsub,NTP,0000,0000,0000,,Менің ойымша, бұл махаббат мәселесі емес.
Dialogue: 0,0:53:02.81,0:53:03.52,JPsub,NTP,0000,0000,0000,,Бұл кілт.
Dialogue: 0,0:53:03.97,0:53:07.28,JPsub,NTP,0000,0000,0000,,Менің ойымша, сіз ұйықтамаған кезде сіздің бөлмеңіз құлыптаулы.
Dialogue: 0,0:53:07.71,0:53:08.75,JPsub,NTP,0000,0000,0000,,Саған бәрібір емес пе?
Dialogue: 0,0:53:09.33,0:53:10.94,JPsub,NTP,0000,0000,0000,,Бұл өте қауіпсіз.
Dialogue: 0,0:53:11.44,0:53:13.39,JPsub,NTP,0000,0000,0000,,Мен қыз болғандықтан күштімін
Dialogue: 0,0:53:13.62,0:53:14.98,JPsub,NTP,0000,0000,0000,,Ол қыз болғандықтан.
Dialogue: 0,0:53:15.43,0:53:19.34,JPsub,NTP,0000,0000,0000,,Сіз кеткен бір айда біз кездесіп қалуымыз мүмкін.
Dialogue: 0,0:53:21.00,0:53:24.88,JPsub,NTP,0000,0000,0000,,Акитака-санның айтуынша, олай болмаған сияқты.
Dialogue: 0,0:53:25.29,0:53:28.63,JPsub,NTP,0000,0000,0000,,Әдеттен тыс, мен кірді өзім жуатын сияқтымын.
Dialogue: 0,0:53:29.17,0:53:32.20,JPsub,NTP,0000,0000,0000,,Күтпеген жерден олардың арасында жаңа адам пайда болды.
Dialogue: 0,0:53:33.94,0:53:35.81,JPsub,NTP,0000,0000,0000,,Сіз шынымен баяусыз.
Dialogue: 0,0:53:36.17,0:53:36.98,JPsub,NTP,0000,0000,0000,,«Осы баланың Қвиркі болмаса да—»
Dialogue: 0,0:53:37.25,0:53:38.44,JPsub,NTP,0000,0000,0000,,Бұл бір түнге ме?
Dialogue: 0,0:53:39.04,0:53:41.02,JPsub,NTP,0000,0000,0000,,Неге байыпты детектив болуға тырыспасқа?
Dialogue: 0,0:53:41.30,0:53:42.43,JPsub,NTP,0000,0000,0000,,Мен оны шынымен бағалаймын.
Dialogue: 0,0:53:42.73,0:53:43.82,JPsub,NTP,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:53:44.48,0:53:47.96,JPsub,NTP,0000,0000,0000,,50 үй шаруашылығының 30-ын ғана зерттеуге болатын.
Dialogue: 0,0:53:53.25,0:53:55.05,JPsub,NTP,0000,0000,0000,,Міне, осы
Dialogue: 0,0:53:55.93,0:54:00.62,JPsub,NTP,0000,0000,0000,,Иә, бұл Наоджо, бірақ сен кімсің?
Dialogue: 0,0:54:01.54,0:54:03.54,JPsub,NTP,0000,0000,0000,,Жоқ, мен қателік жібердім.
Dialogue: 0,0:54:03.81,0:54:04.37,JPsub,NTP,0000,0000,0000,,болып табылады
Dialogue: 0,0:54:12.14,0:54:14.44,JPsub,NTP,0000,0000,0000,,Мен бұдан былай күте алмаймын.
Dialogue: 0,0:54:30.33,0:54:32.21,JPsub,NTP,0000,0000,0000,,Сен осындасың, төмен түс.
Dialogue: 0,0:54:36.06,0:54:37.77,JPsub,NTP,0000,0000,0000,,Курогири, төмен қара.
Dialogue: 0,0:54:38.20,0:54:39.46,JPsub,NTP,0000,0000,0000,,Кішкентай викторина
Dialogue: 0,0:54:40.95,0:54:42.37,JPsub,NTP,0000,0000,0000,,Бар болғаны төмен қарау керек.
Dialogue: 0,0:54:45.61,0:54:46.68,JPsub,NTP,0000,0000,0000,,Енді мәселе мынада.
Dialogue: 0,0:54:47.11,0:54:48.62,JPsub,NTP,0000,0000,0000,,Бұл қай қабат?
Dialogue: 0,0:54:50.78,0:54:53.32,JPsub,NTP,0000,0000,0000,,Бұл әлі бесінші қабатта.
Dialogue: 0,0:54:55.18,0:54:58.48,JPsub,NTP,0000,0000,0000,,Мен көремін. Сонда бұрын 6-қабат болды ма?
Dialogue: 0,0:54:58.90,0:55:03.08,JPsub,NTP,0000,0000,0000,,Дұрыс жауап: Мен бірінші қабатқа көтерілдім деп ойладым, бірақ екінші қабатқа көтерілдім.
Dialogue: 0,0:55:03.45,0:55:04.72,JPsub,NTP,0000,0000,0000,,Бұл күрделі құрылым.
Dialogue: 0,0:55:05.44,0:55:08.33,JPsub,NTP,0000,0000,0000,,Айтпақшы, пәтерлер біртүрлі ғой, солай емес пе?
Dialogue: 0,0:55:08.71,0:55:13.03,JPsub,NTP,0000,0000,0000,,Еден неғұрлым жоғары болса, лифт ішіндегі сезімді түсіну қиынырақ.
Dialogue: 0,0:55:13.91,0:55:17.02,JPsub,NTP,0000,0000,0000,,Егер сіз қосқышты өзгертсеңіз және әр қабаттағы сандарды ауыстырсаңыз.
Dialogue: 0,0:55:17.38,0:55:20.69,JPsub,NTP,0000,0000,0000,,Мен оның 4-қабатта немесе 5-қабатта екенін анық білмеймін.
Dialogue: 0,0:55:21.63,0:55:27.62,JPsub,NTP,0000,0000,0000,,Сіздің қай қабатта тұратыныңызды тексерудің жалғыз жолы - фойедегі шағын әріптер.
Dialogue: 0,0:55:28.25,0:55:28.85,JPsub,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:55:29.06,0:55:33.79,JPsub,NTP,0000,0000,0000,,Бөлме Күнделікті үйреншікті өмір әдеттен тыс болуы мүмкін.
Dialogue: 0,0:55:37.63,0:55:40.00,JPsub,NTP,0000,0000,0000,,Бір сәт шығыс ғимараттың фойесіне барайық.
Dialogue: 0,0:55:42.45,0:55:45.33,JPsub,NTP,0000,0000,0000,,Екі ғимараттың бірінші қабатында вестибюль бар.
Dialogue: 0,0:55:45.86,0:55:47.66,JPsub,NTP,0000,0000,0000,,Оның атриум құрылымы бар...
Dialogue: 0,0:55:48.56,0:55:52.89,JPsub,NTP,0000,0000,0000,,Шығыс ғимаратының фойесінің жобасын жасаған Токо-сан емес пе?
Dialogue: 0,0:55:54.07,0:55:55.25,JPsub,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:55:55.63,0:55:57.06,JPsub,NTP,0000,0000,0000,,Ал, көзіңді жұм.
Dialogue: 0,0:55:57.42,0:55:58.99,JPsub,NTP,0000,0000,0000,,Егер сіз оны орнатқыңыз келсе, ол осында.
Dialogue: 0,0:55:59.33,0:56:01.59,JPsub,NTP,0000,0000,0000,,Айтпақшы, байқамадың ба?
Dialogue: 0,0:56:02.02,0:56:03.45,JPsub,NTP,0000,0000,0000,,Баспалдақпен көтерілу арқылы шығар.
Dialogue: 0,0:56:04.42,0:56:06.40,JPsub,NTP,0000,0000,0000,,Бұл бағана емес, жай ғана баспалдақ.
Dialogue: 0,0:56:07.04,0:56:08.25,JPsub,NTP,0000,0000,0000,,Қабырғаға сызылған
Dialogue: 0,0:56:09.02,0:56:11.87,JPsub,NTP,0000,0000,0000,,Бірақ баспалдақты жылжыту - бұл ақымақтық.
Dialogue: 0,0:56:12.33,0:56:14.92,JPsub,NTP,0000,0000,0000,,Бұл зымыран қарындаш, ақыр соңында.
Dialogue: 0,0:56:15.88,0:56:17.35,JPsub,NTP,0000,0000,0000,,Зымыран қарындаш дегеніміз не?
Dialogue: 0,0:56:17.63,0:56:18.23,JPsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:56:19.63,0:56:21.68,JPsub,NTP,0000,0000,0000,,Сен білмейсің бе, Зымыран қарындаш?
Dialogue: 0,0:56:21.93,0:56:23.51,JPsub,NTP,0000,0000,0000,,Мен білмеймін, Зымыран қарындаш.
Dialogue: 0,0:56:24.23,0:56:25.99,JPsub,NTP,0000,0000,0000,,Менің ойымша, ол қазір сатылмайды.
Dialogue: 0,0:56:26.80,0:56:28.99,JPsub,NTP,0000,0000,0000,,Токоротен суретте
Dialogue: 0,0:56:30.51,0:56:32.59,JPsub,NTP,0000,0000,0000,,Сіз оны төменнен итеріп жібердім дейсіз бе?
Dialogue: 0,0:56:33.12,0:56:34.04,JPsub,NTP,0000,0000,0000,,Поршеньде бірдеңе дұрыс емес.
Dialogue: 0,0:56:34.41,0:56:37.24,JPsub,NTP,0000,0000,0000,,Спиральдың шығуын ауыстыру үшін шығар.
Dialogue: 0,0:56:37.77,0:56:40.34,JPsub,NTP,0000,0000,0000,,Сонда солтүстік пен оңтүстік кері болады.
Dialogue: 0,0:56:41.15,0:56:43.02,JPsub,NTP,0000,0000,0000,,Кім және қандай мақсатта?
Dialogue: 0,0:56:46.25,0:56:47.80,JPsub,NTP,0000,0000,0000,,Енді үйге қайт.
Dialogue: 0,0:56:49.16,0:56:52.86,JPsub,NTP,0000,0000,0000,,Ракеталық қарындаш туралы шынымен білмейсіз бе?
Dialogue: 0,0:56:53.17,0:56:55.34,JPsub,NTP,0000,0000,0000,,Студент кезімде танымал болды.
Dialogue: 0,0:57:12.63,0:57:14.80,JPsub,NTP,0000,0000,0000,,Мен түнде қайтамын дедім.
Dialogue: 0,0:57:29.73,0:57:31.38,JPsub,NTP,0000,0000,0000,,Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:57:31.54,0:57:32.67,JPsub,NTP,0000,0000,0000,,Бұл баяу
Dialogue: 0,0:57:33.06,0:57:35.21,JPsub,NTP,0000,0000,0000,,9 қарашадағы кешкі жаңалықтарды хабарлау
Dialogue: 0,0:57:35.27,0:57:35.85,JPsub,NTP,0000,0000,0000,,Кеттік
Dialogue: 0,0:57:36.45,0:57:40.54,JPsub,NTP,0000,0000,0000,,Бұл кеше болды, бірақ содан бері қараймын.
Dialogue: 0,0:57:42.19,0:57:46.46,JPsub,NTP,0000,0000,0000,,Сіз 50 үй шаруашылығының 30-ын ғана зерттей алғаныңызға өкіндіңіз.
Dialogue: 0,0:57:47.06,0:57:49.12,JPsub,NTP,0000,0000,0000,,Осымен тергеу аяқталды.
Dialogue: 0,0:57:49.75,0:57:52.42,JPsub,NTP,0000,0000,0000,,Қалған 20 отбасы жалған отбасылар.
Dialogue: 0,0:57:53.23,0:57:59.02,JPsub,NTP,0000,0000,0000,,Олар көп жыл бұрын қайтыс болған адамдардың отбасылық тізілімдерін қайта пайдаланып, оларды қолдан жасаған.
Dialogue: 0,0:58:00.59,0:58:03.74,JPsub,NTP,0000,0000,0000,,Шығыс ғимаратының тұрғындары ғана ойдан шығарылған.
Dialogue: 0,0:58:04.40,0:58:05.68,JPsub,NTP,0000,0000,0000,,Бұл нені білдіреді?
Dialogue: 0,0:58:06.38,0:58:07.86,JPsub,NTP,0000,0000,0000,,Эй, тыңдап тұрсың ба?
Dialogue: 0,0:58:08.26,0:58:09.69,JPsub,NTP,0000,0000,0000,,Иә, одан да көп.
Dialogue: 0,0:58:09.92,0:58:12.82,JPsub,NTP,0000,0000,0000,,Әзірге бұрыла алмайтыныңызға қуаныштысыз ба?
Dialogue: 0,0:58:18.04,0:58:21.00,JPsub,NTP,0000,0000,0000,,Әй, мен бұл туралы тым көп ойладым.
Dialogue: 0,0:58:26.27,0:58:27.18,JPsub,NTP,0000,0000,0000,,Демек, Өлім періштесі тек алма жей ме?
Dialogue: 0,0:58:27.88,0:58:30.98,JPsub,NTP,0000,0000,0000,,Куротоу алыңыз.
Dialogue: 0,0:58:32.55,0:58:34.16,JPsub,NTP,0000,0000,0000,,Ішінде бір тұтынушы бар.
Dialogue: 0,0:58:34.83,0:58:36.38,JPsub,NTP,0000,0000,0000,,Оған мән бермеңіз және дауысыңызды көтермеңіз
Dialogue: 0,0:58:37.10,0:58:40.19,JPsub,NTP,0000,0000,0000,,Сонда тұтынушы сізді байқамай кетіп қалады.
Dialogue: 0,0:58:48.92,0:58:52.61,JPsub,NTP,0000,0000,0000,,Аозаки Мен Тайджиге қамқор болдым.
Dialogue: 0,0:58:53.80,0:58:55.95,JPsub,NTP,0000,0000,0000,,Тайджиді Тайджиге қостыңыз ба?
Dialogue: 0,0:58:56.88,0:58:58.56,JPsub,NTP,0000,0000,0000,,Бірақ тежеу ​​әсері болады.
Dialogue: 0,0:58:59.08,0:59:03.14,JPsub,NTP,0000,0000,0000,,Біз адамдар мен жұлдыздардың біртұтас еркі
Dialogue: 0,0:59:03.79,0:59:07.57,JPsub,NTP,0000,0000,0000,,Біздің әлемді жалғастыруға деген ұмтылыс жақындады.
Dialogue: 0,0:59:07.89,0:59:10.37,JPsub,NTP,0000,0000,0000,,Әртүрлі пішінде көрінетін заттар
Dialogue: 0,0:59:10.97,0:59:13.39,JPsub,NTP,0000,0000,0000,,Бұл тежеу деп аталатын есептегіш.
Dialogue: 0,0:59:14.97,0:59:18.27,JPsub,NTP,0000,0000,0000,,Заманның сүйіктісі болып көрінетін қаһарман солардың бірі.
Dialogue: 0,0:59:18.89,0:59:22.77,JPsub,NTP,0000,0000,0000,,Бұрын сиқыршылар талай рет тамырға жақындауға тырысқан.
Dialogue: 0,0:59:23.13,0:59:25.33,JPsub,NTP,0000,0000,0000,,Барлығын тежеу күші аяусыз өлтірді
Dialogue: 0,0:59:25.64,0:59:26.91,JPsub,NTP,0000,0000,0000,,Тоқтау
Dialogue: 0,0:59:27.39,0:59:29.41,JPsub,NTP,0000,0000,0000,,Бұл жағымсыздық жұмыс істемейді.
Dialogue: 0,0:59:29.89,0:59:32.21,JPsub,NTP,0000,0000,0000,,Бұл жолы жол құрудың орнына
Dialogue: 0,0:59:32.47,0:59:35.44,JPsub,NTP,0000,0000,0000,,Ашық жолды ұстаныңыз.
Dialogue: 0,0:59:35.71,0:59:36.89,JPsub,NTP,0000,0000,0000,,Тура көретін жын көзі?
Dialogue: 0,0:59:37.55,0:59:41.79,JPsub,NTP,0000,0000,0000,,Арая екі рәсімді де басып алу үшін қайтыс болды.
Dialogue: 0,0:59:44.95,0:59:48.55,JPsub,NTP,0000,0000,0000,,Формула, формула дегенді қалай түсінесіңдер?
Dialogue: 0,0:59:49.46,0:59:51.00,JPsub,NTP,0000,0000,0000,,Кешегі бала
Dialogue: 0,0:59:51.36,0:59:53.77,JPsub,NTP,0000,0000,0000,,Сіздің шәкіртіңіз бар екені анық, Аозаки.
Dialogue: 0,0:59:54.19,0:59:55.79,JPsub,NTP,0000,0000,0000,,Ләззат көбейген сияқты
Dialogue: 0,0:59:56.58,0:59:59.31,JPsub,NTP,0000,0000,0000,,Басқа деп айту бекер ме?
Dialogue: 0,0:59:59.79,1:00:01.38,JPsub,NTP,0000,0000,0000,,Студент болғанда білмейсің.
Dialogue: 0,1:00:01.93,1:00:04.01,JPsub,NTP,0000,0000,0000,,Екеуміз де академиядан бөлек тұрдық.
Dialogue: 0,1:00:04.62,1:00:07.13,JPsub,NTP,0000,0000,0000,,Мұны соғыс жариялау деп қабылдауға бола ма?
Dialogue: 0,1:00:08.20,1:00:10.65,JPsub,NTP,0000,0000,0000,,Осы жылдардың бәріне нүкте қояйық.
Dialogue: 0,1:00:11.11,1:00:13.01,JPsub,NTP,0000,0000,0000,,Мен сізді тағы да көруге асығамын.
Dialogue: 0,1:00:13.82,1:00:15.13,JPsub,NTP,0000,0000,0000,,Жақында кездескенше
Dialogue: 0,1:00:23.72,1:00:26.83,JPsub,NTP,0000,0000,0000,,Менің Жаһаннамға қош келдіңіз
Dialogue: 0,1:00:27.43,1:00:31.07,JPsub,NTP,0000,0000,0000,,Қош келдіңіз, Ең жоғарғы қуыршақ
Dialogue: 0,1:00:31.67,1:00:33.39,JPsub,NTP,0000,0000,0000,,Құттықтаймыз Альба
Dialogue: 0,1:00:33.66,1:00:35.76,JPsub,NTP,0000,0000,0000,,Иә, әрқашан солай.
Dialogue: 0,1:00:36.19,1:00:39.20,JPsub,NTP,0000,0000,0000,,Мені осылай төмендетесің
Dialogue: 0,1:00:39.92,1:00:43.30,JPsub,NTP,0000,0000,0000,,Бұл жерде сіз іздеп жатқан ешбір құндылық жоқ.
Dialogue: 0,1:00:43.88,1:00:45.71,JPsub,NTP,0000,0000,0000,,Енді не айтқыңыз келеді?
Dialogue: 0,1:00:46.17,1:00:50.16,JPsub,NTP,0000,0000,0000,,Әй, әңгіме Шикиді ұрлап, тұтқынға алды.
Dialogue: 0,1:00:50.56,1:00:51.17,JPsub,NTP,0000,0000,0000,,Докони
Dialogue: 0,1:00:51.64,1:00:52.86,JPsub,NTP,0000,0000,0000,,батыс ғимараттың 10-қабаты
Dialogue: 0,1:00:53.45,1:00:55.97,JPsub,NTP,0000,0000,0000,,Өрнек болымсыз, өйткені ол әйел.
Dialogue: 0,1:00:56.42,1:00:57.50,JPsub,NTP,0000,0000,0000,,Бұл нені білдіреді?
Dialogue: 0,1:00:57.79,1:01:01.19,JPsub,NTP,0000,0000,0000,,Екі жыл бұрын болған апатқа байланысты рәсім тікелей өлімнің жаман көзін оятты.
Dialogue: 0,1:01:01.57,1:01:06.05,JPsub,NTP,0000,0000,0000,,Сонымен қатар мен зұлым көзде бейнеленген өлім сызығының не екенін түсіндім.
Dialogue: 0,1:01:06.91,1:01:08.75,JPsub,NTP,0000,0000,0000,,Аозаки
Dialogue: 0,1:01:09.35,1:01:11.19,JPsub,NTP,0000,0000,0000,,Жарайды, Араяны сыртқа шығарыңыз.
Dialogue: 0,1:01:11.58,1:01:14.23,JPsub,NTP,0000,0000,0000,,Өлім сызығы қандай? Объектілердің бұзылуы
Dialogue: 0,1:01:14.53,1:01:18.22,JPsub,NTP,0000,0000,0000,,Оны көру – заттың шындығын білу.
Dialogue: 0,1:01:18.61,1:01:19.58,JPsub,NTP,0000,0000,0000,,Яғни,
Dialogue: 0,1:01:20.06,1:01:22.07,JPsub,NTP,0000,0000,0000,,Құйынның көзі?
Dialogue: 0,1:01:22.57,1:01:23.20,JPsub,NTP,0000,0000,0000,,Иә.
Dialogue: 0,1:01:23.68,1:01:27.68,JPsub,NTP,0000,0000,0000,,Шикидің денесі зұлым көз арқылы құйынды көзге қосылған.
Dialogue: 0,1:01:28.27,1:01:31.70,JPsub,NTP,0000,0000,0000,,Олардың мақсаты – Алғашқы құйын екені сөзсіз.
Dialogue: 0,1:01:32.24,1:01:33.78,JPsub,NTP,0000,0000,0000,,Альба басқаша көрінеді.
Dialogue: 0,1:01:34.12,1:01:34.76,JPsub,NTP,0000,0000,0000,,Олар
Dialogue: 0,1:01:35.00,1:01:39.79,JPsub,NTP,0000,0000,0000,,Мен сені өлтіре аламын деп осы уақытқа дейін келдім.
Dialogue: 0,1:01:40.16,1:01:41.65,JPsub,NTP,0000,0000,0000,,Аозаки
Dialogue: 0,1:01:44.39,1:01:46.22,JPsub,NTP,0000,0000,0000,,Тооко-сан, бұл ма?
Dialogue: 0,1:01:46.96,1:01:48.41,JPsub,NTP,0000,0000,0000,,Қандай себеп пен салдар!
Dialogue: 0,1:01:49.07,1:01:51.72,JPsub,NTP,0000,0000,0000,,Мен қазір осындай нәрсеге араласып жатқаныма сене алар емеспін.
Dialogue: 0,1:01:52.20,1:01:57.26,JPsub,NTP,0000,0000,0000,,Жоқ, мен салтанатты рәсімге қатысуға шешім қабылдағанда осылай болады деп күткен едім.
Dialogue: 0,1:01:58.12,1:02:02.62,JPsub,NTP,0000,0000,0000,,Мен оны сенімен бірге сақтаймын. Бұл Тайвань шебері жасаған дәмі нашар темекі.
Dialogue: 0,1:02:03.17,1:02:04.26,JPsub,NTP,0000,0000,0000,,Мұның бәрі бар
Dialogue: 0,1:02:07.71,1:02:08.65,JPsub,NTP,0000,0000,0000,,Ескерту: жапон тілінде «емтиханға өтініш беру» мен «өлім» сөздері бірдей айтылады
Dialogue: 0,1:02:09.97,1:02:12.29,JPsub,NTP,0000,0000,0000,,Барлық заттар көзде жазылған
Dialogue: 0,1:02:13.00,1:02:16.88,JPsub,NTP,0000,0000,0000,,Мүмкін Шики Тайджиде түс көріп жатқан шығар.
Dialogue: 0,1:02:17.35,1:02:19.40,JPsub,NTP,0000,0000,0000,,Бұл дүние тарихының арманы
Dialogue: 0,1:02:19.89,1:02:22.51,JPsub,NTP,0000,0000,0000,,Осы сәттің жазбасы
Dialogue: 0,1:02:22.90,1:02:24.62,JPsub,NTP,0000,0000,0000,,Сізге уайымдаудың қажеті жоқ.
Dialogue: 0,1:02:25.07,1:02:28.98,JPsub,NTP,0000,0000,0000,,Сиқыршылар шәкірттеріне, туыстарына мейірімді.
Dialogue: 0,1:02:30.67,1:02:32.54,JPsub,NTP,0000,0000,0000,,Мен бүгін кешке Шикиді үйге әкелемін.
Dialogue: 0,1:02:32.99,1:02:33.70,JPsub,NTP,0000,0000,0000,,Күтіңіз.
Dialogue: 0,1:02:44.00,1:02:46.39,JPsub,NTP,0000,0000,0000,,Мен бұдан былай күте алмаймын.
Dialogue: 0,1:03:14.65,1:03:16.32,JPsub,NTP,0000,0000,0000,,Бұл не, сен?
Dialogue: 0,1:03:48.07,1:03:50.57,JPsub,NTP,0000,0000,0000,,Мен ешкімді құтқара алмаймын
Dialogue: 0,1:03:52.15,1:03:53.28,JPsub,NTP,0000,0000,0000,,Егер мені құтқара алмасаң
Dialogue: 0,1:03:54.12,1:03:57.00,JPsub,NTP,0000,0000,0000,,Ең болмағанда өлімді анық жазыңыз.
Dialogue: 0,1:04:00.51,1:04:03.45,JPsub,NTP,0000,0000,0000,,Өлімді жинау
Dialogue: 0,1:04:07.94,1:04:09.84,JPsub,NTP,0000,0000,0000,,Арман, иә?
Dialogue: 0,1:04:11.15,1:04:13.00,JPsub,NTP,0000,0000,0000,,Бұл мен арманмын ба?
Dialogue: 0,1:04:15.20,1:04:15.95,JPsub,NTP,0000,0000,0000,,Арая
Dialogue: 0,1:04:16.11,1:04:19.79,JPsub,NTP,0000,0000,0000,,Сорен және Корнелиус Альба
Dialogue: 0,1:04:19.96,1:04:20.63,JPsub,NTP,0000,0000,0000,,Бір жері ауырады
Dialogue: 0,1:04:21.33,1:04:22.56,JPsub,NTP,0000,0000,0000,,Бір жері ауырады
Dialogue: 0,1:04:23.18,1:04:23.98,JPsub,NTP,0000,0000,0000,,Өтінемін, менен сөйлеспеңіз.
Dialogue: 0,1:04:24.68,1:04:25.23,JPsub,NTP,0000,0000,0000,,Қалай болғанда да
Dialogue: 0,1:04:25.73,1:04:26.62,JPsub,NTP,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,1:04:27.02,1:04:29.59,JPsub,NTP,0000,0000,0000,,Сөз жоқ, біз бір нәрсеге іліккенбіз.
Dialogue: 0,1:04:30.14,1:04:31.33,JPsub,NTP,0000,0000,0000,,Бұл таңғаларлық оқиға.
Dialogue: 0,1:04:32.02,1:04:34.03,JPsub,NTP,0000,0000,0000,,Сонымен, сіз не істейсіз?
Dialogue: 0,1:04:34.70,1:04:36.35,JPsub,NTP,0000,0000,0000,,Мен Рёгиге қарыздармын.
Dialogue: 0,1:04:37.28,1:04:38.72,JPsub,NTP,0000,0000,0000,,Мен сізге көмектесе алмаймын деп ойлаймын.
Dialogue: 0,1:04:39.64,1:04:40.62,JPsub,NTP,0000,0000,0000,,Қайырлы таң, Камилла.
Dialogue: 0,1:04:41.18,1:04:42.12,JPsub,NTP,0000,0000,0000,,Ата-анаң.
Dialogue: 0,1:04:42.89,1:04:44.81,JPsub,NTP,0000,0000,0000,,405 және 410 бөлмелер
Dialogue: 0,1:04:45.51,1:04:47.34,JPsub,NTP,0000,0000,0000,,Қайсысы шынайы деп ойлайсың?
Dialogue: 0,1:04:47.75,1:04:49.67,JPsub,NTP,0000,0000,0000,,Бұл қазір маңызды емес.
Dialogue: 0,1:04:50.09,1:04:51.00,JPsub,NTP,0000,0000,0000,,Қатысты
Dialogue: 0,1:04:51.57,1:04:55.67,JPsub,NTP,0000,0000,0000,,Шамасы, көп пәтерлі үйдің психозға қолайлы құрылымы бар.
Dialogue: 0,1:04:56.23,1:04:56.77,JPsub,NTP,0000,0000,0000,,Егер
Dialogue: 0,1:04:57.29,1:04:58.89,JPsub,NTP,0000,0000,0000,,Жаратушы жауапты
Dialogue: 0,1:04:59.58,1:05:02.77,JPsub,NTP,0000,0000,0000,,Сіз ата-анаңызды өлтіремін деп армандаудан қорқып өлтірдім дедіңіз.
Dialogue: 0,1:05:03.32,1:05:05.49,JPsub,NTP,0000,0000,0000,,Бірақ бұл сіздің ниетіңіз болды ма?
Dialogue: 0,1:05:06.19,1:05:07.51,JPsub,NTP,0000,0000,0000,,Сен оны шынымен өлтірдің бе?
Dialogue: 0,1:05:07.93,1:05:10.47,JPsub,NTP,0000,0000,0000,,Біріншіден, ата-анасы қайтыс болған жоқ па?
Dialogue: 0,1:05:11.64,1:05:12.56,JPsub,NTP,0000,0000,0000,,Мен сені өлтірдім
Dialogue: 0,1:05:13.39,1:05:16.52,JPsub,NTP,0000,0000,0000,,Қазірдің өзінде анамның жұмысын істегенде алатын сезім
Dialogue: 0,1:05:17.09,1:05:17.96,JPsub,NTP,0000,0000,0000,,Әкесі
Dialogue: 0,1:05:18.36,1:05:20.91,JPsub,NTP,0000,0000,0000,,Сен өлтірген жалғыз адам анаң шығар.
Dialogue: 0,1:05:21.18,1:05:21.92,JPsub,NTP,0000,0000,0000,,Тәртіп маңызды
Dialogue: 0,1:05:22.45,1:05:23.50,JPsub,NTP,0000,0000,0000,,Өйткені мен өлі денені көрдім.
Dialogue: 0,1:05:23.68,1:05:24.26,JPsub,NTP,0000,0000,0000,,Бұл қате.
Dialogue: 0,1:05:28.83,1:05:30.51,JPsub,NTP,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,1:05:31.13,1:05:32.85,JPsub,NTP,0000,0000,0000,,Мен жай ғана Рёгиге көмектесіп жатырмын.
Dialogue: 0,1:05:33.61,1:05:34.78,JPsub,NTP,0000,0000,0000,,Өрнек маңызды болғанымен
Dialogue: 0,1:05:35.26,1:05:37.55,JPsub,NTP,0000,0000,0000,,Сіз де өз өміріңізді бағалауыңыз керек.
Dialogue: 0,1:05:37.92,1:05:41.40,JPsub,NTP,0000,0000,0000,,Шулы, менің сезімімді түсінесің бе?
Dialogue: 0,1:05:41.97,1:05:45.32,JPsub,NTP,0000,0000,0000,,Шикиге көмектесіп өлгің келмей ме?
Dialogue: 0,1:05:46.29,1:05:47.79,JPsub,NTP,0000,0000,0000,,Менде ештеңе жоқ
Dialogue: 0,1:05:48.34,1:05:49.97,JPsub,NTP,0000,0000,0000,,Мені ешкім қорғамайды, бірақ
Dialogue: 0,1:05:50.34,1:05:51.76,JPsub,NTP,0000,0000,0000,,Мені ешкім қорғай алмады
Dialogue: 0,1:05:52.12,1:05:57.68,JPsub,NTP,0000,0000,0000,,Ең болмаса, ол үшін жан тапсырамын деген антымды орындау ғана қалды.
Dialogue: 0,1:06:02.61,1:06:04.12,JPsub,NTP,0000,0000,0000,,Сіз түсінбейсіз
Dialogue: 0,1:06:06.88,1:06:07.57,JPsub,NTP,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,1:06:08.06,1:06:09.11,JPsub,NTP,0000,0000,0000,,Формулаға көмектесейік
Dialogue: 0,1:06:10.50,1:06:12.12,JPsub,NTP,0000,0000,0000,,Бірақ оған дейін тоқтайтын жер бар.
Dialogue: 0,1:06:12.61,1:06:13.45,JPsub,NTP,0000,0000,0000,,Мен сені менімен бірге шығуды өтінемін.
Dialogue: 0,1:06:13.98,1:06:14.74,JPsub,NTP,0000,0000,0000,,Каджо Томое
Dialogue: 0,1:06:15.44,1:06:16.55,JPsub,NTP,0000,0000,0000,,О, сен
Dialogue: 0,1:06:17.01,1:06:18.20,JPsub,NTP,0000,0000,0000,,Неліктен менің атым?
Dialogue: 0,1:06:37.87,1:06:40.59,JPsub,NTP,0000,0000,0000,,Сондықтан мен саған басынан бастап Араяны әкел дедім.
Dialogue: 0,1:06:41.76,1:06:42.62,JPsub,NTP,0000,0000,0000,,Ван Сянь
Dialogue: 0,1:06:54.29,1:06:55.71,JPsub,NTP,0000,0000,0000,,​​Сіз осындасыз ба?
Dialogue: 0,1:06:56.26,1:06:57.32,JPsub,NTP,0000,0000,0000,,Біраз уақыт өтті
Dialogue: 0,1:06:57.62,1:06:58.35,JPsub,NTP,0000,0000,0000,,Аосаки
Dialogue: 0,1:06:58.83,1:07:02.00,JPsub,NTP,0000,0000,0000,,Иә, екеуміз де бір-бірімізді көргіміз келмеді.
Dialogue: 0,1:07:02.46,1:07:05.08,JPsub,NTP,0000,0000,0000,,Альба тым көп еліктеген сияқты.
Dialogue: 0,1:07:06.27,1:07:11.16,JPsub,NTP,0000,0000,0000,,Саған деген құмарлығын жоя алмайтын сияқты.
Dialogue: 0,1:07:11.79,1:07:12.44,JPsub,NTP,0000,0000,0000,,Сонымен
Dialogue: 0,1:07:12.79,1:07:15.09,JPsub,NTP,0000,0000,0000,,Бұл пәтер тамырды ашады ма?
Dialogue: 0,1:07:15.52,1:07:20.02,JPsub,NTP,0000,0000,0000,,Мұнда жиналғандардың бәрі басқа өлімге тап болды.
Dialogue: 0,1:07:20.21,1:07:21.71,JPsub,NTP,0000,0000,0000,,Бұл әлемнің микрокосмасы.
Dialogue: 0,1:07:22.25,1:07:28.07,JPsub,NTP,0000,0000,0000,,Бір күнде біткен дүниені қайталаудың соңында тамырға бір есік бар деп ойладым.
Dialogue: 0,1:07:28.62,1:07:30.77,JPsub,NTP,0000,0000,0000,,Бірақ есік табылмады
Dialogue: 0,1:07:31.38,1:07:33.46,JPsub,NTP,0000,0000,0000,,Сонымен өрнекке назар аудару керек пе?
Dialogue: 0,1:07:34.18,1:07:35.07,JPsub,NTP,0000,0000,0000,,Иә.
Dialogue: 0,1:07:35.59,1:07:37.87,JPsub,NTP,0000,0000,0000,,Тежеу құралы ретінде байқалмау үшін
Dialogue: 0,1:07:38.45,1:07:46.50,JPsub,NTP,0000,0000,0000,,Кири Миджо мен Фуджино Асагамиді қолдану арқылы мен дененің шығу тегімен байланысты екенін көрсете алдым.
Dialogue: 0,1:07:46.68,1:07:48.82,JPsub,NTP,0000,0000,0000,,Бірақ оны қалай ашуға болады?
Dialogue: 0,1:07:49.24,1:07:51.77,JPsub,NTP,0000,0000,0000,,Мен ол денені аламын.
Dialogue: 0,1:07:54.02,1:07:58.64,JPsub,NTP,0000,0000,0000,,Сіздің миыңызды Шикидің денесіне көшіру ниетіңіз жоқ деп ойлаймын.
Dialogue: 0,1:08:00.62,1:08:02.42,JPsub,NTP,0000,0000,0000,,Қандай жағымсыз дәм.
Dialogue: 0,1:08:02.82,1:08:04.49,JPsub,NTP,0000,0000,0000,,Оны неге сонша ашу керек?
Dialogue: 0,1:08:05.00,1:08:06.14,JPsub,NTP,0000,0000,0000,,Ештеңе болмауы мүмкін
Dialogue: 0,1:08:06.65,1:08:08.48,JPsub,NTP,0000,0000,0000,,Дүние жойылуы мүмкін
Dialogue: 0,1:08:09.33,1:08:12.70,JPsub,NTP,0000,0000,0000,,Себебін әлдеқашан ұмытқанмын.
Dialogue: 0,1:08:13.62,1:08:15.73,JPsub,NTP,0000,0000,0000,,Сіздің тілегіңіз бірнеше қадамда орындалады
Dialogue: 0,1:08:16.23,1:08:20.05,JPsub,NTP,0000,0000,0000,,Осының бәрін тосқауыл деп санайды.
Dialogue: 0,1:08:21.12,1:08:23.02,JPsub,NTP,0000,0000,0000,,Бұл күресуден басқа амалымыз жоқ дегенді білдіре ме?
Dialogue: 0,1:08:28.82,1:08:31.54,JPsub,NTP,0000,0000,0000,,Алая Не қалайсыз?
Dialogue: 0,1:08:32.76,1:08:34.66,JPsub,NTP,0000,0000,0000,,Нағыз даналық
Dialogue: 0,1:08:36.04,1:08:38.65,JPsub,NTP,0000,0000,0000,,Алая қайда сұрау керек
Dialogue: 0,1:08:39.44,1:08:42.10,JPsub,NTP,0000,0000,0000,,Тек өз ішінде
Dialogue: 0,1:08:42.75,1:08:43.38,JPsub,NTP,0000,0000,0000,,Уууууууу!!
Dialogue: 0,1:09:00.82,1:09:01.40,JPsub,NTP,0000,0000,0000,,Ақымақ
Dialogue: 0,1:09:01.95,1:09:03.01,JPsub,NTP,0000,0000,0000,,Нешеу болды?
Dialogue: 0,1:09:05.57,1:09:07.01,JPsub,NTP,0000,0000,0000,,Пешкалар жоғалып кетті
Dialogue: 0,1:09:08.10,1:09:11.89,JPsub,NTP,0000,0000,0000,,Қуыршақ жыртылғанда қуыршақ жеңіледі.
Dialogue: 0,1:09:12.90,1:09:15.26,JPsub,NTP,0000,0000,0000,,Студент кезіңде айтқан сөздерің.
Dialogue: 0,1:09:16.75,1:09:18.84,JPsub,NTP,0000,0000,0000,,Мен әлі теориямды өзгерткен жоқпын.
Dialogue: 0,1:09:19.39,1:09:21.32,JPsub,NTP,0000,0000,0000,,Бірақ бұл үлкен мәселе
Dialogue: 0,1:09:21.90,1:09:24.18,JPsub,NTP,0000,0000,0000,,Бұл жер сіздің денеңіздің ішінде.
Dialogue: 0,1:09:24.69,1:09:27.05,JPsub,NTP,0000,0000,0000,,Бос орынды қалауыңызша ұсақтаңыз
Dialogue: 0,1:09:27.89,1:09:32.40,JPsub,NTP,0000,0000,0000,,Мен күшті сиқырға батып кеттім бе?
Dialogue: 0,1:09:33.26,1:09:34.69,JPsub,NTP,0000,0000,0000,,Мен дәл осылай жасауға дайынмын.
Dialogue: 0,1:09:35.07,1:09:36.61,JPsub,NTP,0000,0000,0000,,Мен неге формуламен бұрышта қалдым?
Dialogue: 0,1:09:36.97,1:09:39.48,JPsub,NTP,0000,0000,0000,,Байсалды болсаң, жаншып кетесің.
Dialogue: 0,1:09:40.68,1:09:42.94,JPsub,NTP,0000,0000,0000,,Мен бос емес деп үміттенемін.
Dialogue: 0,1:09:43.67,1:09:44.24,JPsub,NTP,0000,0000,0000,,Алая
Dialogue: 0,1:09:44.73,1:09:47.08,JPsub,NTP,0000,0000,0000,,Адамдарды қорқытатын үш жағдай бар.
Dialogue: 0,1:09:47.29,1:09:48.05,JPsub,NTP,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,1:09:48.66,1:09:52.08,JPsub,NTP,0000,0000,0000,,Бір нәрсе, құбыжықтар сөйлемеуі керек.
Dialogue: 0,1:09:52.41,1:09:55.99,JPsub,NTP,0000,0000,0000,,Екінші, құбыжық белгісіз болуы керек.
Dialogue: 0,1:09:56.40,1:10:00.75,JPsub,NTP,0000,0000,0000,,Үш, құбыжықтар өлмейтін болса, мағынасыз.
Dialogue: 0,1:10:05.76,1:10:08.63,JPsub,NTP,0000,0000,0000,,Оны өлтіргің келсе, бір соққымен тамырын кес.
Dialogue: 0,1:10:08.92,1:10:10.70,JPsub,NTP,0000,0000,0000,,Сіз алдау шабуылын осылай жасайсыз.
Dialogue: 0,1:10:26.06,1:10:27.97,JPsub,NTP,0000,0000,0000,,Мені өлтіретін болсаң, бір соққы?
Dialogue: 0,1:10:28.23,1:10:28.98,JPsub,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,1:10:29.21,1:10:30.99,JPsub,NTP,0000,0000,0000,,Бұл жақсы сабақ болды.
Dialogue: 0,1:10:33.73,1:10:34.36,JPsub,NTP,0000,0000,0000,,Яғни
Dialogue: 0,1:10:34.88,1:10:35.84,JPsub,NTP,0000,0000,0000,,Қуыршақ?
Dialogue: 0,1:10:36.58,1:10:39.67,JPsub,NTP,0000,0000,0000,,Әрине, сіз нағыз мәмілесіз.
Dialogue: 0,1:10:40.55,1:10:42.35,JPsub,NTP,0000,0000,0000,,Бұл жүректің жауыздығы
Dialogue: 0,1:10:42.53,1:10:43.71,JPsub,NTP,0000,0000,0000,,Қателер жоқ
Dialogue: 0,1:10:45.68,1:10:46.43,JPsub,NTP,0000,0000,0000,,Ах, қандай қиындық.
Dialogue: 0,1:10:47.00,1:10:50.13,JPsub,NTP,0000,0000,0000,,Мен сізді дұрыс бағаладым.
Dialogue: 0,1:10:50.50,1:10:53.40,JPsub,NTP,0000,0000,0000,,Түбірге жету үшін бірге жарысқанбыз.
Dialogue: 0,1:10:53.66,1:10:56.39,JPsub,NTP,0000,0000,0000,,Шынымды айтсам, жақсы деп ойладым.
Dialogue: 0,1:10:57.25,1:10:59.24,JPsub,NTP,0000,0000,0000,,Сіз құлап қалдыңыз
Dialogue: 0,1:11:00.47,1:11:02.35,JPsub,NTP,0000,0000,0000,,Бұл, әрине, болуы мүмкін.
Dialogue: 0,1:11:03.47,1:11:08.15,JPsub,NTP,0000,0000,0000,,Бірақ дәл қазір мені де мына өмір алаңдатты.
Dialogue: 0,1:11:08.99,1:11:12.77,JPsub,NTP,0000,0000,0000,,Көптеген ғажайыптар мен кездейсоқтықтармен жинақталған
Dialogue: 0,1:11:13.48,1:11:16.13,JPsub,NTP,0000,0000,0000,,Күнделікті өмір демеңіз, бұл спираль.
Dialogue: 0,1:11:16.69,1:11:17.40,JPsub,NTP,0000,0000,0000,,Сонымен
Dialogue: 0,1:11:17.88,1:11:22.18,JPsub,NTP,0000,0000,0000,,Қолымнан келсе қорғағым келді.
Dialogue: 0,1:11:23.86,1:11:24.59,JPsub,NTP,0000,0000,0000,,Арая
Dialogue: 0,1:11:25.54,1:11:27.82,JPsub,NTP,0000,0000,0000,,Сізге не керек?
Dialogue: 0,1:11:29.01,1:11:31.20,JPsub,NTP,0000,0000,0000,,Мен ештеңе қаламаймын
Dialogue: 0,1:11:32.74,1:11:33.83,JPsub,NTP,0000,0000,0000,,Бұл аянышты.
Dialogue: 0,1:11:54.00,1:11:54.88,JPsub,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,1:11:55.24,1:11:57.41,JPsub,NTP,0000,0000,0000,,Бұл сиқырлы фонарь құбыжық па еді?
Dialogue: 0,1:12:03.31,1:12:05.18,JPsub,NTP,0000,0000,0000,,Арман, иә?
Dialogue: 0,1:12:06.68,1:12:08.45,JPsub,NTP,0000,0000,0000,,Бұл мен арманмын ба?
Dialogue: 0,1:12:12.31,1:12:12.93,JPsub,NTP,0000,0000,0000,,Алая
Dialogue: 0,1:12:13.64,1:12:15.00,JPsub,NTP,0000,0000,0000,,Уәделер әртүрлі.
Dialogue: 0,1:12:15.40,1:12:18.02,JPsub,NTP,0000,0000,0000,,Сіз маған Аозакиді өлтіруге рұқсат етіңіз дедіңіз.
Dialogue: 0,1:12:18.79,1:12:20.34,JPsub,NTP,0000,0000,0000,,Сіз сәтсіздікке ұшырадыңыз
Dialogue: 0,1:12:21.06,1:12:23.97,JPsub,NTP,0000,0000,0000,,Оны менің өлтіргенім анық.
Dialogue: 0,1:12:24.44,1:12:25.67,JPsub,NTP,0000,0000,0000,,Өлтірілді
Dialogue: 0,1:12:26.17,1:12:27.58,JPsub,NTP,0000,0000,0000,,Мені күлдірме
Dialogue: 0,1:12:27.90,1:12:29.45,JPsub,NTP,0000,0000,0000,,Ол әлі тірі
Dialogue: 0,1:12:29.88,1:12:31.27,JPsub,NTP,0000,0000,0000,,Тырнақтарыңызға қиянат жасамаңыз
Dialogue: 0,1:12:31.67,1:12:32.76,JPsub,NTP,0000,0000,0000,,Өлтіру керек
Dialogue: 0,1:12:33.24,1:12:36.55,JPsub,NTP,0000,0000,0000,,Аозаки – ұрғашы түлкі, оны тіпті «қызыл түсті» деп те айтқан.
Dialogue: 0,1:12:37.08,1:12:37.83,JPsub,NTP,0000,0000,0000,,Таваке
Dialogue: 0,1:12:38.35,1:12:41.81,JPsub,NTP,0000,0000,0000,,Сіз айтпау керек нәрсені айттыңыз, Корнелиус.
Dialogue: 0,1:12:42.16,1:12:42.79,JPsub,NTP,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,1:12:45.36,1:12:46.21,JPsub,NTP,0000,0000,0000,,Оны өзіңізбен бірге алыңыз.
Dialogue: 0,1:12:47.26,1:12:49.64,JPsub,NTP,0000,0000,0000,,Маған қалай қарайтыныңызға шағымым жоқ.
Dialogue: 0,1:12:54.75,1:12:56.45,JPsub,NTP,0000,0000,0000,,Мен оны әрине қабылдадым.
Dialogue: 0,1:12:56.89,1:12:58.90,JPsub,NTP,0000,0000,0000,,Бұл енді менікі.
Dialogue: 0,1:12:59.69,1:13:01.79,JPsub,NTP,0000,0000,0000,,Оны қалай шешетініңіз маңызды емес.
Dialogue: 0,1:13:02.34,1:13:03.66,JPsub,NTP,0000,0000,0000,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,1:13:07.40,1:13:10.64,JPsub,NTP,0000,0000,0000,,Қай жолға түссең де, тағдырың шешіледі.
Dialogue: 0,1:13:18.09,1:13:21.03,JPsub,NTP,0000,0000,0000,,Неліктен бұл жерде?
Dialogue: 0,1:13:22.90,1:13:24.59,JPsub,NTP,0000,0000,0000,,Огава сарайын тергеу кезінде
Dialogue: 0,1:13:25.27,1:13:27.03,JPsub,NTP,0000,0000,0000,,Біз өткен мекенжайларды да іздедік.
Dialogue: 0,1:13:28.05,1:13:29.75,JPsub,NTP,0000,0000,0000,,Сіз көп қозғалдыңыз.
Dialogue: 0,1:13:30.42,1:13:32.28,JPsub,NTP,0000,0000,0000,,Мен сегіз жасқа дейін осында тұрдым.
Dialogue: 0,1:13:32.96,1:13:35.67,JPsub,NTP,0000,0000,0000,,Демек, туып-өскен жерің осы.
Dialogue: 0,1:13:36.44,1:13:40.80,JPsub,NTP,0000,0000,0000,,Менің нағыз үйім
Dialogue: 0,1:14:02.95,1:14:03.68,JPsub,NTP,0000,0000,0000,,Tomoe
Dialogue: 0,1:14:04.77,1:14:05.58,JPsub,NTP,0000,0000,0000,,Tomoe
Dialogue: 0,1:14:07.10,1:14:07.81,JPsub,NTP,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,1:14:08.43,1:14:09.72,JPsub,NTP,0000,0000,0000,,Мен сізге маңызды нәрселерді қалдырамын.
Dialogue: 0,1:14:09.93,1:14:10.93,JPsub,NTP,0000,0000,0000,,Мұнда келіңіз
Dialogue: 0,1:14:12.91,1:14:13.93,JPsub,NTP,0000,0000,0000,,Әке
Dialogue: 0,1:14:17.94,1:14:18.60,JPsub,NTP,0000,0000,0000,,Әкем
Dialogue: 0,1:14:19.05,1:14:19.80,JPsub,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,1:14:20.10,1:14:21.01,JPsub,NTP,0000,0000,0000,,Бұл үйдің кілті.
Dialogue: 0,1:14:21.44,1:14:22.45,JPsub,NTP,0000,0000,0000,,Оны жоғалтып алмаңыз
Dialogue: 0,1:14:22.91,1:14:24.45,JPsub,NTP,0000,0000,0000,,Томое да ұл бала
Dialogue: 0,1:14:24.90,1:14:26.69,JPsub,NTP,0000,0000,0000,,Анаңды осылай қорғайсың.
Dialogue: 0,1:14:27.12,1:14:28.28,JPsub,NTP,0000,0000,0000,,Оны кілтпен қорғаңыз
Dialogue: 0,1:14:28.63,1:14:29.34,JPsub,NTP,0000,0000,0000,,Иә.
Dialogue: 0,1:14:29.74,1:14:33.45,JPsub,NTP,0000,0000,0000,,Кілт сенде болғанша, әкең мен шешең жоқ болса да, жақсы боласың.
Dialogue: 0,1:14:33.94,1:14:35.49,JPsub,NTP,0000,0000,0000,,Отбасыңызды қорғаңыз
Dialogue: 0,1:14:36.09,1:14:39.20,JPsub,NTP,0000,0000,0000,,Кілт - отбасылық дәлел
Dialogue: 0,1:14:40.45,1:14:40.87,JPsub,NTP,0000,0000,0000,,Иә, түсінемін.
Dialogue: 0,1:14:41.98,1:14:42.81,JPsub,NTP,0000,0000,0000,,Қадірлейтін мақсат
Dialogue: 0,1:14:43.29,1:14:44.72,JPsub,NTP,0000,0000,0000,,Мен сенің үйіңді қорғаймын.
Dialogue: 0,1:14:45.54,1:14:48.89,JPsub,NTP,0000,0000,0000,,Түсіндім, Томое керемет.
Dialogue: 0,1:14:51.75,1:14:54.28,JPsub,NTP,0000,0000,0000,,Маған бүгін жұмыстан шығатынымды айтты.
Dialogue: 0,1:14:54.90,1:14:55.66,JPsub,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,1:14:56.08,1:14:58.33,JPsub,NTP,0000,0000,0000,,Бұл жолы бәрі жақсы болатын сияқты
Dialogue: 0,1:14:58.77,1:15:00.78,JPsub,NTP,0000,0000,0000,,Мен көлікке отыра алмаймын.
Dialogue: 0,1:15:01.15,1:15:01.83,JPsub,NTP,0000,0000,0000,,Ақымақ
Dialogue: 0,1:15:02.59,1:15:04.51,JPsub,NTP,0000,0000,0000,,Конвенция арқылы ғана күшін жоюға болмайды
Dialogue: 0,1:15:05.19,1:15:07.20,JPsub,NTP,0000,0000,0000,,Өйткені, мен де жұмыс істеймін.
Dialogue: 0,1:15:07.46,1:15:07.96,JPsub,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,1:15:08.37,1:15:09.22,JPsub,NTP,0000,0000,0000,,Бірдеңе жасаңыз
Dialogue: 0,1:15:09.75,1:15:13.07,JPsub,NTP,0000,0000,0000,,Мен сізге де, Томоеға да қиындық тудырмаймын.
Dialogue: 0,1:15:14.82,1:15:15.79,JPsub,NTP,0000,0000,0000,,Не керек, Крюгер мырза?
Dialogue: 0,1:15:16.82,1:15:17.50,JPsub,NTP,0000,0000,0000,,Иә?
Dialogue: 0,1:15:17.66,1:15:18.51,JPsub,NTP,0000,0000,0000,,Жол-көлік оқиғасы
Dialogue: 0,1:15:19.01,1:15:21.46,JPsub,NTP,0000,0000,0000,,Бірақ менің күйеуімнің лицензиясы бар.
Dialogue: 0,1:15:21.80,1:15:23.84,JPsub,NTP,0000,0000,0000,,Сонымен, басқа адам
Dialogue: 0,1:15:25.13,1:15:27.70,JPsub,NTP,0000,0000,0000,,Қандай жағдай болмасын міне алмасаң жақсы емес.
Dialogue: 0,1:15:30.30,1:15:34.36,JPsub,NTP,0000,0000,0000,,Білесің бе, менің отбасым өтемақы төлейді.
Dialogue: 0,1:15:35.74,1:15:36.86,JPsub,NTP,0000,0000,0000,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,1:15:37.81,1:15:39.13,JPsub,NTP,0000,0000,0000,,Қайтадан бастаңыз
Dialogue: 0,1:15:41.37,1:15:42.89,JPsub,NTP,0000,0000,0000,,Шығыңыз, қанішер.
Dialogue: 0,1:15:46.54,1:15:47.25,JPsub,NTP,0000,0000,0000,,Ақымақ
Dialogue: 0,1:15:47.72,1:15:49.37,JPsub,NTP,0000,0000,0000,,Бұл жігіт мұнда не үшін?
Dialogue: 0,1:15:50.39,1:15:52.52,JPsub,NTP,0000,0000,0000,,Бетіңіз қай жерде жарылып қалды?
Dialogue: 0,1:15:53.06,1:15:54.62,JPsub,NTP,0000,0000,0000,,Мен де осында көшуім керек.
Dialogue: 0,1:15:55.32,1:15:57.17,JPsub,NTP,0000,0000,0000,,Қайда барсаң да, біз бірдейміз
Dialogue: 0,1:15:57.66,1:15:59.47,JPsub,NTP,0000,0000,0000,,Қанішер жоғалып кетсе екен.
Dialogue: 0,1:16:00.77,1:16:02.16,JPsub,NTP,0000,0000,0000,,Томо бүгін
Dialogue: 0,1:16:02.73,1:16:04.39,JPsub,NTP,0000,0000,0000,,Мен жеңіл атлетика клубын тастадым.
Dialogue: 0,1:16:05.10,1:16:07.69,JPsub,NTP,0000,0000,0000,,Ол бала үйге үнемі жарасы ауырып келеді.
Dialogue: 0,1:16:08.06,1:16:10.15,JPsub,NTP,0000,0000,0000,,Сізді қорлаған болуы керек.
Dialogue: 0,1:16:10.56,1:16:11.99,JPsub,NTP,0000,0000,0000,,Ол жігітте ештеңе жоқ.
Dialogue: 0,1:16:12.35,1:16:13.35,JPsub,NTP,0000,0000,0000,,Бұл менің кінәм
Dialogue: 0,1:16:13.97,1:16:15.66,JPsub,NTP,0000,0000,0000,,Толық емес жұмыс күні арқылы ақша табады.
Dialogue: 0,1:16:16.45,1:16:17.81,JPsub,NTP,0000,0000,0000,,Тіпті жүгіру де жылдам
Dialogue: 0,1:16:18.34,1:16:21.57,JPsub,NTP,0000,0000,0000,,Мен сияқты Томе тұрақты.
Dialogue: 0,1:16:21.86,1:16:23.88,JPsub,NTP,0000,0000,0000,,Бірақ неге?
Dialogue: 0,1:16:24.55,1:16:26.63,JPsub,NTP,0000,0000,0000,,Қалыпты өмірден үміттенуге де болмайды
Dialogue: 0,1:16:28.51,1:16:29.34,JPsub,NTP,0000,0000,0000,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,1:16:51.44,1:16:52.19,JPsub,NTP,0000,0000,0000,,Сен оны тым асыра бағалап жатырсың.
Dialogue: 0,1:16:52.77,1:16:55.30,JPsub,NTP,0000,0000,0000,,Мен сондай ақымақпын
Dialogue: 0,1:16:56.54,1:16:57.75,JPsub,NTP,0000,0000,0000,,Бұл менің кінәм
Dialogue: 0,1:16:58.89,1:17:00.46,JPsub,NTP,0000,0000,0000,,Барлығы қиналып жатты
Dialogue: 0,1:17:01.12,1:17:03.55,JPsub,NTP,0000,0000,0000,,Өзіңізге қамқорлық жасау үшін бар күшіңізді салыңыз
Dialogue: 0,1:17:04.78,1:17:09.27,JPsub,NTP,0000,0000,0000,,Ауырса да, мен оларға және олардың отбасына көмектесе алмадым.
Dialogue: 0,1:17:10.18,1:17:14.02,JPsub,NTP,0000,0000,0000,,Бір рет болса да айнала алмадым.
Dialogue: 0,1:17:17.45,1:17:19.02,JPsub,NTP,0000,0000,0000,,Сіздің үйіңіз қайда?
Dialogue: 0,1:17:20.33,1:17:22.73,JPsub,NTP,0000,0000,0000,,Бұл туралы не айтасыз, Рёги?
Dialogue: 0,1:17:26.78,1:17:29.43,JPsub,NTP,0000,0000,0000,,Менде де болды.
Dialogue: 0,1:17:31.02,1:17:31.83,JPsub,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:17:32.31,1:17:34.23,JPsub,NTP,0000,0000,0000,,Мен сенің бақытсыздықыңды білемін
Dialogue: 0,1:17:34.47,1:17:35.38,JPsub,NTP,0000,0000,0000,,Ештеңе айта алмаймын
Dialogue: 0,1:17:35.77,1:17:39.07,JPsub,NTP,0000,0000,0000,,Бірақ сізде ештеңе қалмады десеңіз
Dialogue: 0,1:17:39.95,1:17:46.33,JPsub,NTP,0000,0000,0000,,Қазір сіз үшін ең маңыздысы - өзіңіз және сізде болуы керек болатын күнделікті өмір.
Dialogue: 0,1:17:50.14,1:17:51.81,JPsub,NTP,0000,0000,0000,,Менің атым Рёги, менің атым Аната.
Dialogue: 0,1:17:52.34,1:17:53.71,JPsub,NTP,0000,0000,0000,,Біртүрлі нәрселерге толы.
Dialogue: 0,1:17:54.66,1:17:55.56,JPsub,NTP,0000,0000,0000,,Мен оны… есептей алмаймын.
Dialogue: 0,1:17:55.97,1:17:57.58,JPsub,NTP,0000,0000,0000,,Мен өзім үшін күресемін
Dialogue: 0,1:17:59.51,1:18:02.34,JPsub,NTP,0000,0000,0000,,Мен әрқашан осылай істедім
Dialogue: 0,1:18:05.21,1:18:08.09,JPsub,NTP,0000,0000,0000,,Иә, сіз бұған жауап бересіз деп ойладым.
Dialogue: 0,1:18:12.53,1:18:14.23,JPsub,NTP,0000,0000,0000,,Салтанатты рәсім батыс ғимараттың 10-қабатында өтеді.
Dialogue: 0,1:18:14.76,1:18:17.15,JPsub,NTP,0000,0000,0000,,Алдыңғы жақтан барып, азғырамын.
Dialogue: 0,1:18:17.56,1:18:19.49,JPsub,NTP,0000,0000,0000,,Осы уақытта сіз көмектесе аласыз.
Dialogue: 0,1:18:20.66,1:18:23.07,JPsub,NTP,0000,0000,0000,,Ағынды суды пәтердің жанындағы құдық арқылы өткізіңіз.
Dialogue: 0,1:18:23.44,1:18:24.95,JPsub,NTP,0000,0000,0000,,Сіз жерасты автотұрағына жасырын кіруіңіз керек.
Dialogue: 0,1:18:25.89,1:18:29.49,JPsub,NTP,0000,0000,0000,,Мүмкін бұл олардың шеберханасы шығар.
Dialogue: 0,1:18:29.98,1:18:31.67,JPsub,NTP,0000,0000,0000,,Сіз детективсіз бе?
Dialogue: 0,1:18:32.35,1:18:33.95,JPsub,NTP,0000,0000,0000,,Құралдар дайын
Dialogue: 0,1:18:34.85,1:18:36.43,JPsub,NTP,0000,0000,0000,,Сен маған сол қылышты бер.
Dialogue: 0,1:19:02.47,1:19:03.75,JPsub,NTP,0000,0000,0000,,Басталу уақыты 10:30.
Dialogue: 0,1:19:04.18,1:19:05.21,JPsub,NTP,0000,0000,0000,,Рахмет.
Dialogue: 0,1:19:05.72,1:19:06.22,JPsub,NTP,0000,0000,0000,,Дұрыс.
Dialogue: 0,1:19:06.90,1:19:08.85,JPsub,NTP,0000,0000,0000,,Мен сенің атыңды әлі естіген жоқпын.
Dialogue: 0,1:19:09.48,1:19:10.54,JPsub,NTP,0000,0000,0000,,Микия Курогири
Dialogue: 0,1:19:12.28,1:19:12.97,JPsub,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,1:19:13.73,1:19:17.29,JPsub,NTP,0000,0000,0000,,Сіздің фамилияңыз шынымен де әлдебір ақындықіне ұқсайды.
Dialogue: 0,1:19:18.92,1:19:19.52,JPsub,NTP,0000,0000,0000,,Мен бұларды басып шығарамын!
Dialogue: 0,1:19:22.11,1:19:22.74,JPsub,NTP,0000,0000,0000,,Осы орманнан өтсек, біз сенің қасыңда боламыз.
Dialogue: 0,1:19:23.21,1:19:24.34,JPsub,NTP,0000,0000,0000,,Жарайды, ал.
Dialogue: 0,1:19:24.89,1:19:27.73,JPsub,NTP,0000,0000,0000,,Бұдан былай сен мені қорғауың керек.
Dialogue: 0,1:19:28.35,1:19:30.77,JPsub,NTP,0000,0000,0000,,Бұл біткен соң, кездеспегеніміз жақсы.
Dialogue: 0,1:19:31.41,1:19:32.51,JPsub,NTP,0000,0000,0000,,Іздеудің қажеті жоқ
Dialogue: 0,1:19:33.53,1:19:37.22,JPsub,NTP,0000,0000,0000,,Біреудің кінәсінен өлсем, ояну қиын болар еді.
Dialogue: 0,1:19:39.42,1:19:40.91,JPsub,NTP,0000,0000,0000,,Оған мен керек емеспін
Dialogue: 0,1:19:41.67,1:19:43.40,JPsub,NTP,0000,0000,0000,,Мен және ол сияқты адамдарға.
Dialogue: 0,1:19:43.97,1:19:45.57,JPsub,NTP,0000,0000,0000,,Бұл сізге өзіңіз сияқты жарасады.
Dialogue: 0,1:19:46.88,1:19:47.55,JPsub,NTP,0000,0000,0000,,Осы үшін оны мектептен шығарып жіберсе жақсы болар еді.
Dialogue: 0,1:19:49.00,1:19:49.79,JPsub,NTP,0000,0000,0000,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,1:19:54.39,1:19:54.99,JPsub,NTP,0000,0000,0000,,Мисс Бекки қамалда тұрады
Dialogue: 0,1:19:55.65,1:19:57.75,JPsub,NTP,0000,0000,0000,,Бәрі біткен соң, бәрін басынан баста.
Dialogue: 0,1:20:16.79,1:20:17.52,JPsub,NTP,0000,0000,0000,,Сәлем
Dialogue: 0,1:20:17.70,1:20:18.85,JPsub,NTP,0000,0000,0000,,Бұл дұрыс болды.
Dialogue: 0,1:20:19.21,1:20:21.23,JPsub,NTP,0000,0000,0000,,Мен қазір баруды ойладым.
Dialogue: 0,1:20:30.89,1:20:32.11,JPsub,NTP,0000,0000,0000,,Будың дыбысы
Dialogue: 0,1:20:37.01,1:20:39.97,JPsub,NTP,0000,0000,0000,,Мен қайтып келдім
Dialogue: 0,1:20:45.48,1:20:46.64,JPsub,NTP,0000,0000,0000,,Жақсы жұмыс.
Dialogue: 0,1:20:47.06,1:20:48.70,JPsub,NTP,0000,0000,0000,,Маған да ұнайды
Dialogue: 0,1:20:49.27,1:20:51.42,JPsub,NTP,0000,0000,0000,,Бұл бас әлі тірі.
Dialogue: 0,1:20:55.29,1:20:57.12,JPsub,NTP,0000,0000,0000,,Қарашы, мен әлі де жылай аламын.
Dialogue: 0,1:20:57.54,1:20:59.12,JPsub,NTP,0000,0000,0000,,Мен тіпті дауыстарды да естимін
Dialogue: 0,1:21:01.41,1:21:02.12,JPsub,NTP,0000,0000,0000,,Аозаки
Dialogue: 0,1:21:02.50,1:21:03.33,JPsub,NTP,0000,0000,0000,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,1:21:03.60,1:21:07.33,JPsub,NTP,0000,0000,0000,,Енді мен сіздің үй жануарыңызды өлтіремін
Dialogue: 0,1:21:07.52,1:21:08.70,JPsub,NTP,0000,0000,0000,,Мен қиындыққа тап болдым.
Dialogue: 0,1:21:08.97,1:21:10.36,JPsub,NTP,0000,0000,0000,,Бұл көңілсіз.
Dialogue: 0,1:21:11.02,1:21:15.28,JPsub,NTP,0000,0000,0000,,Өйткені сіз енді қолыңызды немесе аяғыңызды сыртқа шығара алмайсыз.
Dialogue: 0,1:21:53.52,1:21:54.27,JPsub,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,1:21:54.87,1:21:56.24,JPsub,NTP,0000,0000,0000,,Міне, солай.
Dialogue: 0,1:22:00.34,1:22:02.55,JPsub,NTP,0000,0000,0000,,Бұл бөлмеге қосылды ма?
Dialogue: 0,1:22:28.65,1:22:31.91,JPsub,NTP,0000,0000,0000,,Қорқынышты ештеңе жасама, сен.
Dialogue: 0,1:22:32.95,1:22:35.37,JPsub,NTP,0000,0000,0000,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,1:22:37.56,1:22:38.29,JPsub,NTP,0000,0000,0000,,болуы керек
Dialogue: 0,1:22:38.97,1:22:41.58,JPsub,NTP,0000,0000,0000,,Ол бір жерде болуы керек.
Dialogue: 0,1:23:10.75,1:23:14.22,JPsub,NTP,0000,0000,0000,,Біреуді пышақтау қауіпті.
Dialogue: 0,1:23:14.43,1:23:15.29,JPsub,NTP,0000,0000,0000,,Бұл қауіпті
Dialogue: 0,1:23:15.51,1:23:16.13,JPsub,NTP,0000,0000,0000,,Бұл қауіпті
Dialogue: 0,1:23:16.44,1:23:17.30,JPsub,NTP,0000,0000,0000,,Бұл қауіпті
Dialogue: 0,1:23:17.51,1:23:18.28,JPsub,NTP,0000,0000,0000,,Бұл қауіпті.
Dialogue: 0,1:23:18.53,1:23:19.29,JPsub,NTP,0000,0000,0000,,Бұл қауіпті.
Dialogue: 0,1:23:19.73,1:23:20.50,JPsub,NTP,0000,0000,0000,,Иә.
Dialogue: 0,1:23:20.82,1:23:21.96,JPsub,NTP,0000,0000,0000,,Әрқашан солай
Dialogue: 0,1:23:22.26,1:23:25.95,JPsub,NTP,0000,0000,0000,,Академияға келгенде бар құрмет жалғыз маған бұйырды.
Dialogue: 0,1:23:26.34,1:23:28.31,JPsub,NTP,0000,0000,0000,,Бірақ сіздің көзқарасыңыз
Dialogue: 0,1:23:28.42,1:23:30.09,JPsub,NTP,0000,0000,0000,,Жоғарыдағы адамдар алданып қалды.
Dialogue: 0,1:23:30.38,1:23:32.87,JPsub,NTP,0000,0000,0000,,Мені төмен санағанға дейінгі менмендік
Dialogue: 0,1:23:33.15,1:23:36.10,JPsub,NTP,0000,0000,0000,,Мен оларға өзімнің төмен екенімді түсіндірдім.
Dialogue: 0,1:23:36.32,1:23:38.00,JPsub,NTP,0000,0000,0000,,Аозаки
Dialogue: 0,1:23:44.78,1:23:46.34,JPsub,NTP,0000,0000,0000,,Ауырды
Dialogue: 0,1:23:46.85,1:23:49.02,JPsub,NTP,0000,0000,0000,,Бұл қаншалықты ауыр болды?
Dialogue: 0,1:23:49.36,1:23:51.67,JPsub,NTP,0000,0000,0000,,Ауыртқаны сонша, көзіме жас келді.
Dialogue: 0,1:23:52.60,1:23:53.34,JPsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:23:53.86,1:23:58.80,JPsub,NTP,0000,0000,0000,,Аозаки мұғалім ретінде онша жақсы емес сияқты.
Dialogue: 0,1:23:58.98,1:23:59.87,JPsub,NTP,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,1:24:00.43,1:24:01.63,JPsub,NTP,0000,0000,0000,,Аозаки шыбыны
Dialogue: 0,1:24:02.01,1:24:07.54,JPsub,NTP,0000,0000,0000,,Академия берген ең жоғары үш түсті атақтардың ішінде маған қызыл түс берілді.
Dialogue: 0,1:24:07.97,1:24:10.50,JPsub,NTP,0000,0000,0000,,Аты айтып тұрғандай көк түсті алғым келді.
Dialogue: 0,1:24:10.70,1:24:11.72,JPsub,NTP,0000,0000,0000,,Бұл жалпы түс.
Dialogue: 0,1:24:12.14,1:24:13.22,JPsub,NTP,0000,0000,0000,,Дұрыс.
Dialogue: 0,1:24:13.69,1:24:16.52,JPsub,NTP,0000,0000,0000,,Менің әпкем Уни өз отбасын мұрагер ету құқығынан айырылды.
Dialogue: 0,1:24:16.80,1:24:19.01,JPsub,NTP,0000,0000,0000,,Мен академияға кек алу үшін түстім.
Dialogue: 0,1:24:19.27,1:24:21.24,JPsub,NTP,0000,0000,0000,,Өйткені біз кемшілікке толы адамбыз.
Dialogue: 0,1:24:43.72,1:24:44.65,JPsub,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,1:24:45.66,1:24:50.04,JPsub,NTP,0000,0000,0000,,Жалған екенімді білсем де
Dialogue: 0,1:24:50.95,1:24:53.58,JPsub,NTP,0000,0000,0000,,Бұл шынымен де жалған нәрсе болды.
Dialogue: 0,1:24:56.11,1:24:58.31,JPsub,NTP,0000,0000,0000,,Мен фейк болғандықтан ештеңе істей алмаймын
Dialogue: 0,1:24:59.01,1:25:00.60,JPsub,NTP,0000,0000,0000,,Арая оны өткізіп алды.
Dialogue: 0,1:25:05.45,1:25:07.73,JPsub,NTP,0000,0000,0000,,Жалған қуыршақтың пайда болуы
Dialogue: 0,1:25:09.16,1:25:13.05,JPsub,NTP,0000,0000,0000,,Ақырында ыдырайтын шығар деп, денемді жалғыз қалдырдым.
Dialogue: 0,1:25:14.05,1:25:15.76,JPsub,NTP,0000,0000,0000,,Неге қайтып келдің?
Dialogue: 0,1:25:17.63,1:25:18.59,JPsub,NTP,0000,0000,0000,,Сіз
Dialogue: 0,1:25:19.25,1:25:19.86,JPsub,NTP,0000,0000,0000,,Сіз
Dialogue: 0,1:25:19.94,1:25:23.81,JPsub,NTP,0000,0000,0000,,«Сен өлген болуың керек» деген сөздерді доғар.
Dialogue: 0,1:25:23.94,1:25:24.56,JPsub,NTP,0000,0000,0000,,Корнелий
Dialogue: 0,1:25:24.63,1:25:26.36,JPsub,NTP,0000,0000,0000,,Сіз өлген болуыңыз керек.
Dialogue: 0,1:25:28.05,1:25:29.29,JPsub,NTP,0000,0000,0000,,Сен мұнда не үшін келдің?
Dialogue: 0,1:25:29.87,1:25:32.62,JPsub,NTP,0000,0000,0000,,Мен асығыспын деп ойладым, бірақ уақытында үлгермедім.
Dialogue: 0,1:25:33.13,1:25:34.22,JPsub,NTP,0000,0000,0000,,Дөңгелек…
Dialogue: 0,1:25:34.53,1:25:36.39,JPsub,NTP,0000,0000,0000,,Мен Тоуко Аозакиді ауыстырып жатырмын.
Dialogue: 0,1:25:36.53,1:25:37.18,JPsub,NTP,0000,0000,0000,,Ауыстыру
Dialogue: 0,1:25:37.48,1:25:38.59,JPsub,NTP,0000,0000,0000,,Кисама, қуыршақ?
Dialogue: 0,1:25:38.89,1:25:42.12,JPsub,NTP,0000,0000,0000,,Жоқ, сіз нақтысыз.
Dialogue: 0,1:25:42.41,1:25:46.72,JPsub,NTP,0000,0000,0000,,Жоқ, мен сені өлтірдім.
Dialogue: 0,1:25:47.30,1:25:49.14,JPsub,NTP,0000,0000,0000,,Бірақ бұл қайшылық
Dialogue: 0,1:25:49.69,1:25:50.64,JPsub,NTP,0000,0000,0000,,Бұл нені білдіреді?
Dialogue: 0,1:25:51.46,1:25:52.77,JPsub,NTP,0000,0000,0000,,Сәлем Корнелиус
Dialogue: 0,1:25:53.59,1:25:58.13,JPsub,NTP,0000,0000,0000,,Бірнеше жыл бұрын мен дәл өзім сияқты қуыршақ жасадым.
Dialogue: 0,1:25:58.76,1:26:00.80,JPsub,NTP,0000,0000,0000,,Менен артық емес, менен кем емес
Dialogue: 0,1:26:01.21,1:26:03.84,JPsub,NTP,0000,0000,0000,,Бұл дәл осындай өнімділіктегі қуыршақ.
Dialogue: 0,1:26:04.33,1:26:05.87,JPsub,NTP,0000,0000,0000,,Соны көріп ойландым
Dialogue: 0,1:26:06.24,1:26:09.81,JPsub,NTP,0000,0000,0000,,Осы менде болса, қазір кім екенімді қажет етпес едім.
Dialogue: 0,1:26:11.12,1:26:12.15,JPsub,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,1:26:12.72,1:26:15.82,JPsub,NTP,0000,0000,0000,,Сіз екі рәсімді де сақтау үшін оралдыңыз ба?
Dialogue: 0,1:26:16.46,1:26:17.75,JPsub,NTP,0000,0000,0000,,ақымақ
Dialogue: 0,1:26:18.24,1:26:21.41,JPsub,NTP,0000,0000,0000,,Бұл сезімдердің барлығы құрастырылған.
Dialogue: 0,1:26:21.86,1:26:23.46,JPsub,NTP,0000,0000,0000,,Мен неге түсінбеймін
Dialogue: 0,1:26:24.19,1:26:25.95,JPsub,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,1:26:26.47,1:26:29.47,JPsub,NTP,0000,0000,0000,,Сіз бұл спиральдан шықтыңыз.
Dialogue: 0,1:26:30.08,1:26:31.43,JPsub,NTP,0000,0000,0000,,Бірақ есіңізде болсын
Dialogue: 0,1:26:32.25,1:26:34.43,JPsub,NTP,0000,0000,0000,,Сіз қашан ояндыңыз?
Dialogue: 0,1:26:34.91,1:26:37.57,JPsub,NTP,0000,0000,0000,,Неліктен екі рәсім де сізді қызықтырды?
Dialogue: 0,1:26:38.21,1:26:42.96,JPsub,NTP,0000,0000,0000,,Неліктен бейтаныс адамнан көмек сұрадың?
Dialogue: 0,1:26:44.10,1:26:46.26,JPsub,NTP,0000,0000,0000,,Жоқ, мен
Dialogue: 0,1:26:46.69,1:26:49.99,JPsub,NTP,0000,0000,0000,,Сіз туралы ештеңе шынайы емес.
Dialogue: 0,1:26:50.50,1:26:55.27,JPsub,NTP,0000,0000,0000,,Қашып кеткен саған қосқан бір ғана дерек бар.
Dialogue: 0,1:26:56.16,1:27:01.60,JPsub,NTP,0000,0000,0000,,Бұл екі ырымға қызығамын деген бейсаналық сырғыма.
Dialogue: 0,1:27:01.84,1:27:03.93,JPsub,NTP,0000,0000,0000,,Фусакерна
Dialogue: 0,1:27:04.25,1:27:06.51,JPsub,NTP,0000,0000,0000,,Тіпті бұл дұрыс деп есептесек те.
Dialogue: 0,1:27:06.93,1:27:08.00,JPsub,NTP,0000,0000,0000,,Мүмкін болса
Dialogue: 0,1:27:08.25,1:27:10.94,JPsub,NTP,0000,0000,0000,,Біз жоғары деңгейге ұмтылуымыз керек.
Dialogue: 0,1:27:11.24,1:27:13.51,JPsub,NTP,0000,0000,0000,,Сол себепті, егер бұл бірдей қуыршақ болса
Dialogue: 0,1:27:13.58,1:27:17.08,JPsub,NTP,0000,0000,0000,,Менсіз де келесі кезеңге өте аласыз.
Dialogue: 0,1:27:17.43,1:27:19.94,JPsub,NTP,0000,0000,0000,,Қараңыз, нәтиже ештеңені өзгертпейді.
Dialogue: 0,1:27:20.56,1:27:21.45,JPsub,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,1:27:21.78,1:27:23.30,JPsub,NTP,0000,0000,0000,,Арая нені жіберіп тұрды
Dialogue: 0,1:27:23.48,1:27:26.24,JPsub,NTP,0000,0000,0000,,Мен тірі болғанша, келесі сені қоспаймын.
Dialogue: 0,1:27:26.69,1:27:30.06,JPsub,NTP,0000,0000,0000,,Бұл бұрын ауырды, Корнелий.
Dialogue: 0,1:27:30.35,1:27:32.44,JPsub,NTP,0000,0000,0000,,Мен бұрыннан танитын сені
Dialogue: 0,1:27:33.39,1:27:34.29,JPsub,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,1:27:35.82,1:27:37.31,JPsub,NTP,0000,0000,0000,,Сіз шыныменсіз бе?
Dialogue: 0,1:27:38.70,1:27:44.04,JPsub,NTP,0000,0000,0000,,Маған бұл сұрақпен не айтқың келеді?
Dialogue: 0,1:27:52.29,1:27:57.26,JPsub,NTP,0000,0000,0000,,Мен фейк екенімді білемін.
Dialogue: 0,1:27:57.94,1:28:00.95,JPsub,NTP,0000,0000,0000,,Бірақ, менің өткенім жоқ.
Dialogue: 0,1:28:01.43,1:28:02.75,JPsub,NTP,0000,0000,0000,,Менің сезімдерім күшті
Dialogue: 0,1:28:03.24,1:28:05.12,JPsub,NTP,0000,0000,0000,,Маған Рёги ұнады
Dialogue: 0,1:28:05.51,1:28:06.82,JPsub,NTP,0000,0000,0000,,Жалған болса да
Dialogue: 0,1:28:07.26,1:28:09.44,JPsub,NTP,0000,0000,0000,,Бұл жүрек шынайы
Dialogue: 0,1:28:10.67,1:28:13.04,JPsub,NTP,0000,0000,0000,,Мен онымен уақытты қызықты өткіздім.
Dialogue: 0,1:28:13.78,1:28:16.74,JPsub,NTP,0000,0000,0000,,Маған сол мүмкіндікті берген сен болдым десең
Dialogue: 0,1:28:17.25,1:28:18.89,JPsub,NTP,0000,0000,0000,,Мен саған алғысымды білдіремін.
Dialogue: 0,1:28:20.54,1:28:23.41,JPsub,NTP,0000,0000,0000,,Мен жасандымын ба, Арая?
Dialogue: 0,1:28:24.29,1:28:26.58,JPsub,NTP,0000,0000,0000,,Айтудың қажеті жоқ
Dialogue: 0,1:28:27.41,1:28:31.47,JPsub,NTP,0000,0000,0000,,Келсең кел. Мен ешқайда бармаймын.
Dialogue: 0,1:28:33.10,1:28:38.03,JPsub,NTP,0000,0000,0000,,Мен сені өлтіремін, Арая.
Dialogue: 0,1:28:38.47,1:28:43.54,JPsub,NTP,0000,0000,0000,,Шынымды айтсам, сенің жеккөрушілігің біз академияда жүргеннен бері соншалықты жаман болған жоқ.
Dialogue: 0,1:28:43.89,1:28:47.47,JPsub,NTP,0000,0000,0000,,Бұл менің, Туко Аозакидің бар екендігімнің дәлелі.
Dialogue: 0,1:29:00.00,1:29:02.37,JPsub,NTP,0000,0000,0000,,Бұл спираль
Dialogue: 0,1:29:03.47,1:29:05.64,JPsub,NTP,0000,0000,0000,,Қарама-қайшылық болғанын қалаймын.
Dialogue: 0,1:29:07.80,1:29:11.06,JPsub,NTP,0000,0000,0000,,Бірақ сен мені сол атпен атадың
Dialogue: 0,1:29:26.08,1:29:29.01,JPsub,NTP,0000,0000,0000,,Бұл маған қазір жеткілікті.
Dialogue: 0,1:29:38.67,1:29:40.25,JPsub,NTP,0000,0000,0000,,Бұл ескі ереже.
Dialogue: 0,1:29:40.69,1:29:43.20,JPsub,NTP,0000,0000,0000,,Мен «тыртық және қызыл» деп атадым
Dialogue: 0,1:29:43.41,1:29:45.26,JPsub,NTP,0000,0000,0000,,Ерекшеліксіз өлтіру
Dialogue: 0,1:29:56.01,1:29:58.82,JPsub,NTP,0000,0000,0000,,Мен сені сен үшін өлтірмеймін.
Dialogue: 0,1:29:59.42,1:30:02.51,JPsub,NTP,0000,0000,0000,,Мен сені өзім үшін өлтіремін
Dialogue: 0,1:30:07.53,1:30:14.18,JPsub,NTP,0000,0000,0000,,Менің отбасым соншалықты жаман емес еді.
Dialogue: 0,1:30:17.03,1:30:25.05,JPsub,NTP,0000,0000,0000,,Мен осылай өлетіндей күнәкар емес едім.
Dialogue: 0,1:30:29.89,1:30:30.77,JPsub,NTP,0000,0000,0000,,Таваке
Dialogue: 0,1:30:34.10,1:30:36.01,JPsub,NTP,0000,0000,0000,,Сіз ештеңе істей алмайсыз
Dialogue: 0,1:30:36.73,1:30:37.56,JPsub,NTP,0000,0000,0000,,Өйткені
Dialogue: 0,1:30:38.18,1:30:41.21,JPsub,NTP,0000,0000,0000,,Сіздің шығу тегіңіз «құнсыз» болғандықтан
Dialogue: 0,1:30:45.77,1:30:48.87,JPsub,NTP,0000,0000,0000,,Мен осында болдым.
Dialogue: 0,1:31:06.94,1:31:09.34,JPsub,NTP,0000,0000,0000,,Сынған, Альба
Dialogue: 0,1:31:21.40,1:31:23.12,JPsub,NTP,0000,0000,0000,,Бұл болды ма?
Dialogue: 0,1:31:23.39,1:31:26.13,JPsub,NTP,0000,0000,0000,,Araya Peeping - жағымсыз дәм.
Dialogue: 0,1:31:26.67,1:31:28.19,JPsub,NTP,0000,0000,0000,,Оның азаймаған аузы
Dialogue: 0,1:31:28.45,1:31:30.58,JPsub,NTP,0000,0000,0000,,Расында да сен нағыз адамсың.
Dialogue: 0,1:31:30.89,1:31:33.06,JPsub,NTP,0000,0000,0000,,Олай болса тағы ұрысамыз ба?
Dialogue: 0,1:31:33.43,1:31:34.30,JPsub,NTP,0000,0000,0000,,№
Dialogue: 0,1:31:34.69,1:31:37.46,JPsub,NTP,0000,0000,0000,,Бұл пәтерде жеңіске жету мүмкіндігі жоқ.
Dialogue: 0,1:31:37.81,1:31:38.66,JPsub,NTP,0000,0000,0000,,Жақсы ма?
Dialogue: 0,1:31:39.02,1:31:43.47,JPsub,NTP,0000,0000,0000,,Егер бұл жасырынған құбыжық болса, немесе сен мені жеңе аласың.
Dialogue: 0,1:31:43.62,1:31:46.72,JPsub,NTP,0000,0000,0000,,Мен өлтірілгенде жеңілдім.
Dialogue: 0,1:31:47.14,1:31:48.94,JPsub,NTP,0000,0000,0000,,Егер оны тоқтататын нәрсе болса
Dialogue: 0,1:31:49.13,1:31:50.64,JPsub,NTP,0000,0000,0000,,Бұл мен емес шығар
Dialogue: 0,1:31:51.00,1:31:54.70,JPsub,NTP,0000,0000,0000,,Сіз осы кезеңдегі тосқауылдарды күтесіз бе?
Dialogue: 0,1:31:55.02,1:31:57.44,JPsub,NTP,0000,0000,0000,,Бірақ бұл жұмыс істемейді
Dialogue: 0,1:31:58.44,1:32:00.62,JPsub,NTP,0000,0000,0000,,Кедергі сол үшін.
Dialogue: 0,1:32:01.48,1:32:02.32,JPsub,NTP,0000,0000,0000,,Тосқауыл
Dialogue: 0,1:32:04.16,1:32:05.12,JPsub,NTP,0000,0000,0000,,Сәлем Арая
Dialogue: 0,1:32:05.50,1:32:07.46,JPsub,NTP,0000,0000,0000,,Бұл пәтердің бастапқы мақсаты
Dialogue: 0,1:32:07.95,1:32:11.27,JPsub,NTP,0000,0000,0000,,Бұл Тайджиді біріктіру үшін Тайджидің көрінісі.
Dialogue: 0,1:32:11.83,1:32:12.72,JPsub,NTP,0000,0000,0000,,Шынында да
Dialogue: 0,1:32:13.31,1:32:17.67,JPsub,NTP,0000,0000,0000,,Сыртқы дүниеден екі ырымға да толық тосқауыл қою үшін
Dialogue: 0,1:32:18.03,1:32:20.11,JPsub,NTP,0000,0000,0000,,Бұл басқа әлемді жасады
Dialogue: 0,1:32:28.87,1:32:32.73,JPsub,NTP,0000,0000,0000,,Арая, сен қатты қателестің.
Dialogue: 0,1:32:34.16,1:32:36.99,JPsub,NTP,0000,0000,0000,,Қателер жоқ
Dialogue: 0,1:32:37.55,1:32:40.38,JPsub,NTP,0000,0000,0000,,О, сіз қателескен жоқсыз.
Dialogue: 0,1:32:41.45,1:32:43.54,JPsub,NTP,0000,0000,0000,,Сізге, сиқыршы,
Dialogue: 0,1:32:44.70,1:32:48.14,JPsub,NTP,0000,0000,0000,,Формула кеңістіктегі үзіліс деп аталатын тосқауылға лақтырылды.
Dialogue: 0,1:32:48.73,1:32:50.59,JPsub,NTP,0000,0000,0000,,Бұл өте жақсы
Dialogue: 0,1:32:51.26,1:32:55.25,JPsub,NTP,0000,0000,0000,,Бірақ бұл оған қатысты емес.
Dialogue: 0,1:32:56.12,1:32:59.22,JPsub,NTP,0000,0000,0000,,Біз парасаттылыққа қауіп төндіреміз
Dialogue: 0,1:32:59.71,1:33:03.41,JPsub,NTP,0000,0000,0000,,Шики – жындыларға қарсы өлім құдайы.
Dialogue: 0,1:33:03.90,1:33:06.45,JPsub,NTP,0000,0000,0000,,Сіз мұны бастан өткерген болуыңыз керек.
Dialogue: 0,1:33:08.26,1:33:09.17,JPsub,NTP,0000,0000,0000,,Сорен Арая
Dialogue: 0,1:33:10.15,1:33:11.90,JPsub,NTP,0000,0000,0000,,Өрнекті шектегіңіз келсе
Dialogue: 0,1:33:12.61,1:33:15.65,JPsub,NTP,0000,0000,0000,,Мен оны бетон қорапқа салуым керек еді.
Dialogue: 0,1:33:16.48,1:33:21.31,JPsub,NTP,0000,0000,0000,,Кеңістікті жабатын кедергілерді оңай бұзады.
Dialogue: 0,1:33:43.22,1:33:45.74,JPsub,NTP,0000,0000,0000,,Каджу Әйелдер жоқ па?
Dialogue: 0,1:33:46.06,1:33:49.11,JPsub,NTP,0000,0000,0000,,Егер әйел бар болса, ол осындай жерде тұра алар еді.
Dialogue: 0,1:33:49.54,1:33:51.60,JPsub,NTP,0000,0000,0000,,Әй, сен біреуді ұстап тұрған сияқтысың.
Dialogue: 0,1:33:51.94,1:33:55.45,JPsub,NTP,0000,0000,0000,,Сезімсіз дауыспен мақтаса да риза емеспін.
Dialogue: 0,1:33:58.52,1:33:59.50,JPsub,NTP,0000,0000,0000,,А, түсіндім, Токо.
Dialogue: 0,1:34:00.66,1:34:01.76,JPsub,NTP,0000,0000,0000,,Біраз уақытқа шығып тұрмын
Dialogue: 0,1:34:02.15,1:34:02.74,JPsub,NTP,0000,0000,0000,,О
Dialogue: 0,1:34:07.75,1:34:08.57,JPsub,NTP,0000,0000,0000,,Менде 200 велосипед қалды.
Dialogue: 0,1:34:09.01,1:34:09.61,JPsub,NTP,0000,0000,0000,,Микия
Dialogue: 0,1:34:09.75,1:34:10.54,JPsub,NTP,0000,0000,0000,,Мен қылышты аламын.
Dialogue: 0,1:34:10.74,1:34:11.42,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,1:34:14.67,1:34:16.17,JPsub,NTP,0000,0000,0000,,Бұл не, Микия?
Dialogue: 0,1:34:17.33,1:34:19.29,JPsub,NTP,0000,0000,0000,,Эй, не болды, Армин? Өзіңді қолыңнан ал, иә? Эй!
Dialogue: 0,1:34:21.50,1:34:22.39,JPsub,NTP,0000,0000,0000,,Алдымен үйге барыңыз
Dialogue: 0,1:34:22.90,1:34:23.62,JPsub,NTP,0000,0000,0000,,Туко
Dialogue: 0,1:34:23.76,1:34:25.06,JPsub,NTP,0000,0000,0000,,Аяқ ретінде қолдануға болатын нәрсе бар ма?
Dialogue: 0,1:34:25.88,1:34:27.81,JPsub,NTP,0000,0000,0000,,Менде 200 велосипед қалды.
Dialogue: 0,1:34:28.29,1:34:28.76,JPsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:34:29.09,1:34:31.10,JPsub,NTP,0000,0000,0000,,Харлиді шығармаңыз.
Dialogue: 0,1:34:31.68,1:34:33.81,JPsub,NTP,0000,0000,0000,,Мен бүйірдегі арбаны әлі шешкен жоқпын.
Dialogue: 0,1:34:34.58,1:34:37.19,JPsub,NTP,0000,0000,0000,,Мен жынды болдым ба?
Dialogue: 0,1:34:39.70,1:34:41.68,JPsub,NTP,0000,0000,0000,,Формула, кілт және т.б.
Dialogue: 0,1:34:43.14,1:34:43.71,JPsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,1:34:44.06,1:34:46.37,JPsub,NTP,0000,0000,0000,,Чимихамадағы Огава сарайы туралы білесіз бе?
Dialogue: 0,1:34:46.95,1:34:50.41,JPsub,NTP,0000,0000,0000,,Жүр, бірақ бұл жерді жобалаған жігіт біледі.
Dialogue: 0,1:34:52.12,1:34:52.69,JPsub,NTP,0000,0000,0000,,Микия
Dialogue: 0,1:34:52.92,1:34:53.87,JPsub,NTP,0000,0000,0000,,Мен қылышты аламын.
Dialogue: 0,1:34:54.39,1:34:54.86,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,1:34:55.55,1:34:57.11,JPsub,NTP,0000,0000,0000,,Мен оны жинаймын.
Dialogue: 0,1:34:58.71,1:35:01.81,JPsub,NTP,0000,0000,0000,,Ол қазір кетті. Ол алысқа кетті.
Dialogue: 0,1:35:03.84,1:35:05.29,JPsub,NTP,0000,0000,0000,,Көбінесе ол өздігінен жүреді.
Dialogue: 0,1:35:05.49,1:35:06.48,JPsub,NTP,0000,0000,0000,,Соңына дейін баруға тура келеді, білесің бе.
Dialogue: 0,1:35:06.84,1:35:09.63,JPsub,NTP,0000,0000,0000,,Ауылда бір ай оқып үйренгенім.
Dialogue: 0,1:35:31.90,1:35:33.31,JPsub,NTP,0000,0000,0000,,Бұл Араяның жүрегін ауыртады
Dialogue: 0,1:35:33.61,1:35:35.40,JPsub,NTP,0000,0000,0000,,Бұл ғимарат сіздің денеңіздің ішінде
Dialogue: 0,1:35:35.68,1:35:37.23,JPsub,NTP,0000,0000,0000,,Дәл осы жерде кесілген.
Dialogue: 0,1:35:40.36,1:35:41.69,JPsub,NTP,0000,0000,0000,,Ба, кана
Dialogue: 0,1:35:56.61,1:35:57.27,JPsub,NTP,0000,0000,0000,,Түсініксіз
Dialogue: 0,1:35:57.76,1:36:00.18,JPsub,NTP,0000,0000,0000,,Бұл дене не үшін қозғалады?
Dialogue: 0,1:36:01.01,1:36:03.22,JPsub,NTP,0000,0000,0000,,Неліктен сол жарамен ояндың?
Dialogue: 0,1:36:03.77,1:36:07.77,JPsub,NTP,0000,0000,0000,,Неліктен ол тағы бірнеше минут комада болмады?
Dialogue: 0,1:36:08.27,1:36:09.42,JPsub,NTP,0000,0000,0000,,Екі рәсім
Dialogue: 0,1:36:13.84,1:36:16.58,JPsub,NTP,0000,0000,0000,,Каджо, Томое?
Dialogue: 0,1:36:17.43,1:36:19.83,JPsub,NTP,0000,0000,0000,,Маған ешкімнің көмегі керек емес
Dialogue: 0,1:36:20.49,1:36:22.35,JPsub,NTP,0000,0000,0000,,Мен өз бетіммен ояндым
Dialogue: 0,1:36:23.65,1:36:26.16,JPsub,NTP,0000,0000,0000,,Мұнда келудің мәні жоқ еді.
Dialogue: 0,1:36:27.38,1:36:30.57,JPsub,NTP,0000,0000,0000,,Бірақ сені жойған Наджо болды.
Dialogue: 0,1:36:35.63,1:36:36.76,JPsub,NTP,0000,0000,0000,,Неге деп ойлаймын
Dialogue: 0,1:36:38.41,1:36:42.54,JPsub,NTP,0000,0000,0000,,Мен сенімен бір-бірімізді өлтіретінімізді білемін, бірақ мен күле алмаймын.
Dialogue: 0,1:36:44.14,1:36:45.68,JPsub,NTP,0000,0000,0000,,Мұнда бүкіл күн оқумен өткізудің қажеті жоқ қой?
Dialogue: 0,1:36:46.23,1:36:48.29,JPsub,NTP,0000,0000,0000,,Мен сені өлтіргім келмейді
Dialogue: 0,1:36:48.91,1:36:53.12,JPsub,NTP,0000,0000,0000,,Мен сіздің "болғаныңызға" шыдай алмаймын.
Dialogue: 0,1:37:04.12,1:37:04.80,JPsub,NTP,0000,0000,0000,,Басу
Dialogue: 0,1:37:33.67,1:37:34.51,JPsub,NTP,0000,0000,0000,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,1:37:35.33,1:37:36.19,JPsub,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,1:37:37.02,1:37:38.07,JPsub,NTP,0000,0000,0000,,Автоұсыныс
Dialogue: 0,1:37:39.08,1:37:42.19,JPsub,NTP,0000,0000,0000,,Сіз қаруды иелену арқылы өзіңізді өзгертесіз бе?
Dialogue: 0,1:37:42.73,1:37:43.82,JPsub,NTP,0000,0000,0000,,Мені алдап кетті.
Dialogue: 0,1:37:44.20,1:37:46.08,JPsub,NTP,0000,0000,0000,,Фуджино Асагамимен болған кісі өлтіру
Dialogue: 0,1:37:46.51,1:37:48.85,JPsub,NTP,0000,0000,0000,,Бұл сіздің байыпты емес екеніңізді білдіре ме?
Dialogue: 0,1:37:49.49,1:37:52.09,JPsub,NTP,0000,0000,0000,,Ақыры біз кездестік, Рёги.
Dialogue: 0,1:38:20.67,1:38:21.38,JPsub,NTP,0000,0000,0000,,Басу
Dialogue: 0,1:38:28.13,1:38:29.05,JPsub,NTP,0000,0000,0000,,Таваке
Dialogue: 0,1:38:33.57,1:38:35.19,JPsub,NTP,0000,0000,0000,,Бұл әлі де тоқтамайды ма?
Dialogue: 0,1:38:44.57,1:38:47.21,JPsub,NTP,0000,0000,0000,,Бірақ мен сенің қашуыңа ешқашан жол бермеймін.
Dialogue: 0,1:38:56.60,1:38:57.71,JPsub,NTP,0000,0000,0000,,Оны қалай тоқтатуға болады
Dialogue: 0,1:38:58.22,1:39:00.65,JPsub,NTP,0000,0000,0000,,Бұл ғимарат бұзылмайды ма?
Dialogue: 0,1:39:07.91,1:39:09.43,JPsub,NTP,0000,0000,0000,,Бұл жігіт аздап қауіпті
Dialogue: 0,1:39:42.32,1:39:43.62,JPsub,NTP,0000,0000,0000,,Рёги
Dialogue: 0,1:39:45.40,1:39:46.24,JPsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,1:40:25.34,1:40:29.52,JPsub,NTP,0000,0000,0000,,Егер ол солай істесе, өз жасында қыз болар еді.
Dialogue: 0,1:40:31.53,1:40:34.25,JPsub,NTP,0000,0000,0000,,Сіздің тосқауыл Шикиді құтқарды ма?
Dialogue: 0,1:40:35.09,1:40:36.91,JPsub,NTP,0000,0000,0000,,Бұл жолы да сәтсіз аяқталды.
Dialogue: 0,1:40:39.15,1:40:41.62,JPsub,NTP,0000,0000,0000,,Неліктен өзіңізді қатты итермелейсіз?
Dialogue: 0,1:40:43.57,1:40:48.15,JPsub,NTP,0000,0000,0000,,Олай болса, құйынның көзін не үшін іздейсің?
Dialogue: 0,1:40:49.96,1:40:52.72,JPsub,NTP,0000,0000,0000,,Адамдарды құтқару мүмкін емес
Dialogue: 0,1:40:54.14,1:40:55.91,JPsub,NTP,0000,0000,0000,,Бұл көп уақыт бұрын болды.
Dialogue: 0,1:40:57.13,1:40:59.86,JPsub,NTP,0000,0000,0000,,Барлық адамдарды құтқару мүмкін емес
Dialogue: 0,1:41:00.56,1:41:01.22,JPsub,NTP,0000,0000,0000,,алып ағаштар орманға жүгіріп кірді
Dialogue: 0,1:41:01.83,1:41:05.46,JPsub,NTP,0000,0000,0000,,Құтқарылмаған адамдарды құтқару үшін не қажет?
Dialogue: 0,1:41:06.31,1:41:07.41,JPsub,NTP,0000,0000,0000,,Жауап жоқ
Dialogue: 0,1:41:08.31,1:41:10.38,JPsub,NTP,0000,0000,0000,,Бірақ түбірді ашыңыз
Dialogue: 0,1:41:10.74,1:41:12.57,JPsub,NTP,0000,0000,0000,,Егер мен дүниені аяқтасам
Dialogue: 0,1:41:13.76,1:41:16.02,JPsub,NTP,0000,0000,0000,,Ақырзаманға дейін өлімді жаз
Dialogue: 0,1:41:16.33,1:41:17.22,JPsub,NTP,0000,0000,0000,,Көру және есту
Dialogue: 0,1:41:17.97,1:41:20.10,JPsub,NTP,0000,0000,0000,,Сауап алғандар, құтқарылғандар
Dialogue: 0,1:41:20.36,1:41:22.83,JPsub,NTP,0000,0000,0000,,Егер мен бәрін нөлден бастап қайта қарастыра алсам,
Dialogue: 0,1:41:23.76,1:41:27.35,JPsub,NTP,0000,0000,0000,,Мағынасыз өлгендер де мағынаға ие болады.
Dialogue: 0,1:41:28.32,1:41:32.16,JPsub,NTP,0000,0000,0000,,Сізді не қуантқанын айта аласыз.
Dialogue: 0,1:41:33.06,1:41:35.48,JPsub,NTP,0000,0000,0000,,Сен кімсің?
Dialogue: 0,1:41:36.75,1:41:39.04,JPsub,NTP,0000,0000,0000,,Мен ешкім емеспін
Dialogue: 0,1:41:39.67,1:41:41.74,JPsub,NTP,0000,0000,0000,,Мен жай ғана қорытынды алғым келеді.
Dialogue: 0,1:41:42.55,1:41:44.95,JPsub,NTP,0000,0000,0000,,Мынау ұсқынсыз, лас
Dialogue: 0,1:41:45.24,1:41:47.28,JPsub,NTP,0000,0000,0000,,Төмен және надан адамдар
Dialogue: 0,1:41:47.97,1:41:49.88,JPsub,NTP,0000,0000,0000,,Олар өлгеннен кейін
Dialogue: 0,1:41:50.19,1:41:52.44,JPsub,NTP,0000,0000,0000,,Тарихта қалғаны осы болса
Dialogue: 0,1:41:52.98,1:41:56.11,JPsub,NTP,0000,0000,0000,,Бұл шіркін адамның құндылығы
Dialogue: 0,1:41:56.57,1:41:58.66,JPsub,NTP,0000,0000,0000,,Мен өзімді қауіпсіз сезінемін.
Dialogue: 0,1:41:59.16,1:42:04.53,JPsub,NTP,0000,0000,0000,,Сіз өзіңіз үшін барлық лас адамдарды өшіргіңіз келеді.
Dialogue: 0,1:42:05.42,1:42:09.97,JPsub,NTP,0000,0000,0000,,Бірақ мен бір қадам қалғанда, тағы да мені тоқтатты.
Dialogue: 0,1:42:10.48,1:42:14.99,JPsub,NTP,0000,0000,0000,,Адамдардың өлу жолы қандай жаман.
Dialogue: 0,1:42:15.28,1:42:19.44,JPsub,NTP,0000,0000,0000,,Томое Уджоның бұл спиральдан шығуы күтпеген жағдай болды.
Dialogue: 0,1:42:19.68,1:42:24.34,JPsub,NTP,0000,0000,0000,,Олар өркениетті тосқауыл қойды десе де, тежеу ​​әсері байқалмауы үшін.
Dialogue: 0,1:42:24.73,1:42:27.33,JPsub,NTP,0000,0000,0000,,Бұл кезде ол тесіктерге толы болды.
Dialogue: 0,1:42:28.17,1:42:31.83,JPsub,NTP,0000,0000,0000,,Жалғыз отбасыңның, Томенің махаббатынан айырылдың.
Dialogue: 0,1:42:34.97,1:42:37.38,JPsub,NTP,0000,0000,0000,,Маған жақсы нәрсе айтайын.
Dialogue: 0,1:42:38.21,1:42:42.15,JPsub,NTP,0000,0000,0000,,Психолог анықтаған ұжымдық бейсаналық деп аталатын нәрсе бар.
Dialogue: 0,1:42:42.98,1:42:47.42,JPsub,NTP,0000,0000,0000,,Адамның барлық санасы бір көлге бітеді деген ой
Dialogue: 0,1:42:48.02,1:42:50.45,JPsub,NTP,0000,0000,0000,,Осы дүниедегі барлық қауымдардың қоймасы
Dialogue: 0,1:42:51.20,1:42:54.99,JPsub,NTP,0000,0000,0000,,Бұл да. Буддизм оны Алая санасы деп атады.
Dialogue: 0,1:42:55.66,1:42:57.18,JPsub,NTP,0000,0000,0000,,Na, ni
Dialogue: 0,1:42:57.70,1:43:00.79,JPsub,NTP,0000,0000,0000,,Дүние қандай зұлым қайшылық.
Dialogue: 0,1:43:01.38,1:43:05.00,JPsub,NTP,0000,0000,0000,,Сіз жек көретін нәрсеңізбен бірдей атпен туғансыз.
Dialogue: 0,1:43:08.89,1:43:12.51,JPsub,NTP,0000,0000,0000,,Бұл дене өз шегіне жетті.
Dialogue: 0,1:43:13.75,1:43:15.40,JPsub,NTP,0000,0000,0000,,Қайтадан нөлден бастау керек пе?
Dialogue: 0,1:43:17.23,1:43:21.40,JPsub,NTP,0000,0000,0000,,Қосалқы денелер жасалмаған.
Dialogue: 0,1:43:29.25,1:43:31.82,JPsub,NTP,0000,0000,0000,,Алая, саған не керек?
Dialogue: 0,1:43:32.40,1:43:34.27,JPsub,NTP,0000,0000,0000,,Нағыз даналық
Dialogue: 0,1:43:34.75,1:43:36.97,JPsub,NTP,0000,0000,0000,,Алая, сен қайдан сұрайсың?
Dialogue: 0,1:43:37.55,1:43:40.63,JPsub,NTP,0000,0000,0000,,Тек өз ішінде
Dialogue: 0,1:43:41.18,1:43:43.91,JPsub,NTP,0000,0000,0000,,Арая, сен қайда көздеп тұрсың?
Dialogue: 0,1:43:44.79,1:43:46.01,JPsub,NTP,0000,0000,0000,,Мен не білдім
Dialogue: 0,1:43:46.35,1:43:53.17,JPsub,NTP,0000,0000,0000,,Осы қайшылықты дүние спиральының соңы
Dialogue: 0,1:44:04.98,1:44:05.78,JPsub,NTP,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,1:45:58.88,1:46:01.55,JPsub,NTP,0000,0000,0000,,Мынау несі, анау безбүйрек нәрсе?
Dialogue: 0,1:51:09.06,1:51:10.35,JPsub,NTP,0000,0000,0000,,Мазалағаным үшін кешіріңіз, бірақ
Dialogue: 0,1:51:11.46,1:51:13.07,JPsub,NTP,0000,0000,0000,,Не болып жатыр?
Dialogue: 0,1:51:15.13,1:51:17.08,JPsub,NTP,0000,0000,0000,,Мен саған бермеймін, сен жамансың.
Dialogue: 0,1:51:17.58,1:51:19.43,JPsub,NTP,0000,0000,0000,,Бұл шекара бұзушы не?
Dialogue: 0,1:51:19.85,1:51:22.81,JPsub,NTP,0000,0000,0000,,Сіз осылай жауап сұрайсыз ба?
Dialogue: 0,1:51:23.36,1:51:24.30,JPsub,NTP,0000,0000,0000,,Бұл жақсы болды.
Dialogue: 0,1:51:28.64,1:51:29.30,JPsub,NTP,0000,0000,0000,,Осымен
Dialogue: 0,1:51:30.04,1:51:30.74,JPsub,NTP,0000,0000,0000,,Не?
Dialogue: 0,1:51:32.19,1:51:33.08,JPsub,NTP,0000,0000,0000,,Сол пәтер
Dialogue: 0,1:51:33.84,1:51:35.32,JPsub,NTP,0000,0000,0000,,Мен мұны Токо-саннан естідім.
Dialogue: 0,1:51:36.39,1:51:38.31,JPsub,NTP,0000,0000,0000,,Бүгін бұзу басталады.
Dialogue: 0,1:51:40.24,1:51:44.49,JPsub,NTP,0000,0000,0000,,Тоуко-сан мәйіттерге қамқорлық жасап, алдын ала тазалап қойған сияқты.
Dialogue: 0,1:51:50.90,1:51:53.32,JPsub,NTP,0000,0000,0000,,Бәрі бітті.
Dialogue: 0,1:51:56.72,1:51:58.25,JPsub,NTP,0000,0000,0000,,Сәлем, Куротоу
Dialogue: 0,1:52:00.93,1:52:01.64,JPsub,NTP,0000,0000,0000,,Key
Dialogue: 0,1:52:05.27,1:52:08.52,JPsub,NTP,0000,0000,0000,,Сенің бөлмеңнің кілті менде жоқ.
Dialogue: 0,1:52:09.55,1:52:12.58,JPsub,NTP,0000,0000,0000,,Әділетсіздік, мұндай нәрсе.
Dialogue: 0,1:52:35.93,1:52:37.70,JPsub,NTP,0000,0000,0000,,Менің сізге жазған өтінішім есіңізде ме?
Dialogue: 0,1:52:38.30,1:52:43.28,JPsub,NTP,0000,0000,0000,,Рейен қыздар орта мектебінің ішіндегі перілерді манипуляциялау, студенттерді алаңдату.
Dialogue: 0,1:52:43.53,1:52:45.32,JPsub,NTP,0000,0000,0000,,Сиқыршыларды анықтау және жою
Dialogue: 0,1:52:46.47,1:52:47.14,JPsub,NTP,0000,0000,0000,,Иә.
Dialogue: 0,1:52:47.63,1:52:50.62,JPsub,NTP,0000,0000,0000,,Перілерді көре алмайтын Сенька үшін
Dialogue: 0,1:52:51.03,1:52:52.40,JPsub,NTP,0000,0000,0000,,Сізге көз керек
Dialogue: 0,1:52:55.47,1:52:59.55,JPsub,NTP,0000,0000,0000,,Бұл қорқынышты. Мен бұл жолы міндетті түрде құрбан боламын.
Dialogue: 0,1:53:03.43,1:53:05.83,JPsub,NTP,0000,0000,0000,,Мен күйзелісті қазірдің өзінде сезінемін.
Dialogue: 0,1:53:06.98,1:53:09.74,JPsub,NTP,0000,0000,0000,,Ұқсас болудан гөрі,
Dialogue: 0,1:53:09.86,1:53:10.37,JPsub,NTP,0000,0000,0000,,штамп картаңды қатты үнемдеп жинап, дәл қолданар сәтте оның мерзімі өтіп кеткенін байқағандай жүз жаса,
Dialogue: 0,1:53:10.49,1:53:12.25,JPsub,NTP,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,1:53:12.59,1:53:14.58,JPsub,NTP,0000,0000,0000,,Сиқыршының мақсаты қандай?
Dialogue: 0,1:53:14.80,1:53:17.37,JPsub,NTP,0000,0000,0000,,Жылап қателессең мен сені ешқашан кешірмеймін.
Dialogue: 0,1:53:17.63,1:53:19.33,JPsub,NTP,0000,0000,0000,,Мен қай сиқыршы екенін білмеймін.
Dialogue: 0,1:53:19.58,1:53:20.71,JPsub,NTP,0000,0000,0000,,Мен сені кішкентай бала етемін
Dialogue: 0,1:53:22.06,1:53:22.91,JPsub,NTP,0000,0000,0000,,Жұмыс
Dialogue: 0,1:53:25.51,1:53:29.90,JPsub,NTP,0000,0000,0000,,Мойындауым керек, маған ерекше нәрселер ұнайды.
Dialogue: 0,0:01:51.63,0:01:53.27,CNsub,NTP,0000,0000,0000,,Томое өлімі
Dialogue: 0,0:03:34.83,0:03:37.02,CNsub,NTP,0000,0000,0000,,Ертегіні тыңдау
Dialogue: 0,0:03:51.23,0:03:56.80,CNsub,NTP,0000,0000,0000,,Бұл оқиға біртүрлі, өмір сүрудің соңғы түбегейлі жоғалуы
Dialogue: 0,0:03:57.47,0:04:02.45,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:04:03.00,0:04:06.00,CNsub,NTP,0000,0000,0000,,Мен осылай ойладым.
Dialogue: 0,0:04:06.46,0:04:12.14,CNsub,NTP,0000,0000,0000,,Өзге тілдің сөзі де сөз, сыр
Dialogue: 0,0:04:12.68,0:04:16.08,CNsub,NTP,0000,0000,0000,,Қорғаныш қақпағын қалдырыңыз
Dialogue: 0,0:04:16.60,0:04:18.98,CNsub,NTP,0000,0000,0000,,Сөздің мағынасы қандай?
Dialogue: 0,0:04:20.07,0:04:23.66,CNsub,NTP,0000,0000,0000,,Бұл оғаш жағдайда
Dialogue: 0,0:04:24.08,0:04:25.94,CNsub,NTP,0000,0000,0000,,Бос камерадағы қылмыс
Dialogue: 0,0:04:26.91,0:04:33.47,CNsub,NTP,0000,0000,0000,,Басқа негіздер тегін
Dialogue: 0,0:04:33.82,0:04:36.46,CNsub,NTP,0000,0000,0000,,Дүкенге кірген кезде сіз Яко Яконы көре аласыз.
Dialogue: 0,0:04:37.33,0:04:40.02,CNsub,NTP,0000,0000,0000,,Фукамику резиденциясы үлкен және адам.
Dialogue: 0,0:04:40.97,0:04:46.02,CNsub,NTP,0000,0000,0000,,Бұл ұрлаудың және жеткізу үшін төлеудің жиі қолданылатын әдісі.
Dialogue: 0,0:04:47.27,0:04:49.95,CNsub,NTP,0000,0000,0000,,Менің оқиғам: Бір оқиға болды…
Dialogue: 0,0:04:50.36,0:04:53.80,CNsub,NTP,0000,0000,0000,,Тек қана қызығушылық емес.
Dialogue: 0,0:04:54.36,0:04:55.36,CNsub,NTP,0000,0000,0000,,Соңғы сұрақ
Dialogue: 0,0:04:55.85,0:04:58.77,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:04:59.32,0:05:02.04,CNsub,NTP,0000,0000,0000,,Алайда, егер сізде бір бала болса
Dialogue: 0,0:05:03.27,0:05:05.18,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:05.65,0:05:08.12,CNsub,NTP,0000,0000,0000,,Ләззат алмасаң, қолайсыз ниет.
Dialogue: 0,0:05:08.48,0:05:11.11,CNsub,NTP,0000,0000,0000,,Нана шабуылы аяқталды
Dialogue: 0,0:05:13.90,0:05:15.07,CNsub,NTP,0000,0000,0000,,34-тарау: Үнсіз ойнатылған реквием, Бірінші бөлім
Dialogue: 0,0:05:18.98,0:05:19.87,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:21.16,0:05:23.30,CNsub,NTP,0000,0000,0000,,Аспан камерасы туралы қылмыстық есеп
Dialogue: 0,0:05:24.37,0:05:27.13,CNsub,NTP,0000,0000,0000,,Шынайы махаббат оқиғалары
Dialogue: 0,0:05:27.69,0:05:28.72,CNsub,NTP,0000,0000,0000,,Бұл жағдай
Dialogue: 0,0:05:29.17,0:05:29.92,CNsub,NTP,0000,0000,0000,,Аударма: Xianyu Tiyan, Dabu Lu; Қарталар дизайны: Xiao Wu, Gen, Cuonan, AB; Тексеру: Qianyu Wuying
Dialogue: 0,0:05:30.03,0:05:32.41,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:32.84,0:05:34.41,CNsub,NTP,0000,0000,0000,,Бұл алдыңғы мейрамхананың жағдайы.
Dialogue: 0,0:05:34.73,0:05:36.11,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:36.45,0:05:39.48,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:39.68,0:05:40.74,CNsub,NTP,0000,0000,0000,,Менде не бар
Dialogue: 0,0:05:42.46,0:05:44.78,CNsub,NTP,0000,0000,0000,,Коджобато
Dialogue: 0,0:05:45.35,0:05:46.09,CNsub,NTP,0000,0000,0000,,Үлкен масштаб
Dialogue: 0,0:05:46.30,0:05:47.15,CNsub,NTP,0000,0000,0000,,Жылқының келуі
Dialogue: 0,0:06:35.61,0:06:36.55,CNsub,NTP,0000,0000,0000,,Кансуми
Dialogue: 0,0:06:37.09,0:06:38.68,CNsub,NTP,0000,0000,0000,,Тұрсаң бір ғанибет.
Dialogue: 0,0:06:39.50,0:06:40.15,CNsub,NTP,0000,0000,0000,,Ашу
Dialogue: 0,0:06:40.30,0:06:44.49,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:06:54.71,0:06:55.14,CNsub,NTP,0000,0000,0000,,Бұл елдің контрбарлау қызметін талқандау оңай емес.
Dialogue: 0,0:06:55.24,0:06:56.29,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:06:57.17,0:06:57.79,CNsub,NTP,0000,0000,0000,,Кансуми
Dialogue: 0,0:06:57.94,0:07:00.29,CNsub,NTP,0000,0000,0000,,Лаози Зай Лингоу
Dialogue: 0,0:07:18.61,0:07:19.90,CNsub,NTP,0000,0000,0000,,Кажо
Dialogue: 0,0:07:32.34,0:07:33.78,CNsub,NTP,0000,0000,0000,,Бұл өлімсіз.
Dialogue: 0,0:07:38.14,0:07:41.20,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:07:42.84,0:07:45.32,CNsub,NTP,0000,0000,0000,,Мен сізге кедергі келтіргім келмейді.
Dialogue: 0,0:07:45.67,0:07:48.54,CNsub,NTP,0000,0000,0000,,Сіздің несие нүктеңізге қарай
Dialogue: 0,0:07:49.29,0:07:50.81,CNsub,NTP,0000,0000,0000,,Сіздің жауапты екеніңіз рас
Dialogue: 0,0:07:51.39,0:07:55.84,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:07:56.79,0:07:59.37,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:08:06.35,0:08:08.02,CNsub,NTP,0000,0000,0000,,Өлтірдім...Мен...
Dialogue: 0,0:08:19.23,0:08:21.43,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:08:28.58,0:08:30.33,CNsub,NTP,0000,0000,0000,,Осы жерден айқайлаңыз
Dialogue: 0,0:08:30.81,0:08:32.78,CNsub,NTP,0000,0000,0000,,Құлағыңыз жоғалды.
Dialogue: 0,0:08:59.33,0:09:01.34,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:09:04.60,0:09:05.76,CNsub,NTP,0000,0000,0000,,Бұл сіздің екінші
Dialogue: 0,0:09:10.62,0:09:11.26,CNsub,NTP,0000,0000,0000,,Не болып жатыр? «Реквием» кенеттен осы жаққа шабуыл жасап келеді
Dialogue: 0,0:09:12.43,0:09:14.55,CNsub,NTP,0000,0000,0000,,Сіз…
Dialogue: 0,0:09:15.22,0:09:17.89,CNsub,NTP,0000,0000,0000,,Мен шығыс пен батысқа жеткенде
Dialogue: 0,0:09:19.63,0:09:21.81,CNsub,NTP,0000,0000,0000,,Ойланбау
Dialogue: 0,0:09:22.34,0:09:24.39,CNsub,NTP,0000,0000,0000,,Сіз айғайлаумен айналысасыз ба?
Dialogue: 0,0:09:25.56,0:09:26.12,CNsub,NTP,0000,0000,0000,,3-бөлім: Түрмедегі бандиттермен кездесу
Dialogue: 0,0:09:26.38,0:09:26.97,CNsub,NTP,0000,0000,0000,,Жылдамдық
Dialogue: 0,0:09:27.93,0:09:32.55,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:09:33.09,0:09:34.50,CNsub,NTP,0000,0000,0000,,Қайдан келдің?
Dialogue: 0,0:09:34.78,0:09:35.76,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:09:36.23,0:09:38.93,CNsub,NTP,0000,0000,0000,,Чжучэн қалалық ауылы
Dialogue: 0,0:09:39.40,0:09:42.29,CNsub,NTP,0000,0000,0000,,Жеке күтімді қажет етпейді.
Dialogue: 0,0:09:43.19,0:09:45.25,CNsub,NTP,0000,0000,0000,,Егер сіз табысты болғыңыз келмесе
Dialogue: 0,0:09:45.70,0:09:48.98,CNsub,NTP,0000,0000,0000,,Үйіңізге барғыңыз келсе
Dialogue: 0,0:09:49.29,0:09:49.91,CNsub,NTP,0000,0000,0000,,Сәттілік
Dialogue: 0,0:09:51.47,0:09:52.79,CNsub,NTP,0000,0000,0000,,Шындық дегеніміз не?
Dialogue: 0,0:10:30.23,0:10:33.51,CNsub,NTP,0000,0000,0000,,Мен өлдім
Dialogue: 0,0:10:44.37,0:10:46.02,CNsub,NTP,0000,0000,0000,,Томое өлімі
Dialogue: 0,0:11:22.16,0:11:22.76,CNsub,NTP,0000,0000,0000,,Тесілмеген, бірақ бірдеңе бар…
Dialogue: 0,0:11:23.86,0:11:25.53,CNsub,NTP,0000,0000,0000,,Мен оны көре алмаймын.
Dialogue: 0,0:11:25.85,0:11:27.45,CNsub,NTP,0000,0000,0000,,Бұл рас...бұл рас
Dialogue: 0,0:11:27.85,0:11:29.43,CNsub,NTP,0000,0000,0000,,Өлтіруші
Dialogue: 0,0:11:29.71,0:11:32.71,CNsub,NTP,0000,0000,0000,,Йонату Зайшусури Ранпо
Dialogue: 0,0:11:33.30,0:11:36.61,CNsub,NTP,0000,0000,0000,,Рио Теничи
Dialogue: 0,0:11:37.57,0:11:39.48,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:11:40.29,0:11:43.10,CNsub,NTP,0000,0000,0000,,Соңғы танымал әдістер
Dialogue: 0,0:11:44.47,0:11:46.55,CNsub,NTP,0000,0000,0000,,Бұл қанның соңы.
Dialogue: 0,0:11:49.35,0:11:51.65,CNsub,NTP,0000,0000,0000,,Сізге зиян тигізбейді.
Dialogue: 0,0:11:52.00,0:11:52.69,CNsub,NTP,0000,0000,0000,,Қарақұрым қоңырау белгісі мұнараның шыңынан алыстап барады. Мен оны сеземін.
Dialogue: 0,0:11:54.22,0:11:57.56,CNsub,NTP,0000,0000,0000,,Мен өлтірушімін.
Dialogue: 0,0:11:57.71,0:11:58.50,CNsub,NTP,0000,0000,0000,,Бұл туралы не деуге болады?
Dialogue: 0,0:12:00.44,0:12:01.84,CNsub,NTP,0000,0000,0000,,Казуя Гая
Dialogue: 0,0:12:02.57,0:12:03.44,CNsub,NTP,0000,0000,0000,,Ичито?
Dialogue: 0,0:12:03.88,0:12:05.52,CNsub,NTP,0000,0000,0000,,Жақсы жаңалық
Dialogue: 0,0:12:05.95,0:12:07.17,CNsub,NTP,0000,0000,0000,,……
Dialogue: 0,0:12:32.00,0:12:33.96,CNsub,NTP,0000,0000,0000,,Мен клиентіммен шағын сөйлесемін.
Dialogue: 0,0:12:34.45,0:12:35.39,CNsub,NTP,0000,0000,0000,,Оны оқып берейін.
Dialogue: 0,0:12:40.50,0:12:42.31,CNsub,NTP,0000,0000,0000,,Жоғалған көрініс
Dialogue: 0,0:13:11.11,0:13:11.89,CNsub,NTP,0000,0000,0000,,Қасық
Dialogue: 0,0:13:26.46,0:13:28.18,CNsub,NTP,0000,0000,0000,,Томое өлімі
Dialogue: 0,0:13:31.52,0:13:33.62,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:13:35.17,0:13:38.41,CNsub,NTP,0000,0000,0000,,Мен шығыста ішкенді ұнатпаймын
Dialogue: 0,0:13:38.93,0:13:41.38,CNsub,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:13:47.52,0:13:49.27,CNsub,NTP,0000,0000,0000,,Қай жерде ұйықтап қалдың?
Dialogue: 0,0:13:49.92,0:13:51.57,CNsub,NTP,0000,0000,0000,,Мен осында жұмыс істегеніме қуаныштымын.
Dialogue: 0,0:13:52.16,0:13:54.58,CNsub,NTP,0000,0000,0000,,Түзетуге қарсы
Dialogue: 0,0:13:54.92,0:13:58.13,CNsub,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз. Сіз қауіпті адамсыз.
Dialogue: 0,0:13:59.60,0:14:01.17,CNsub,NTP,0000,0000,0000,,Сіз құбыжықсыз
Dialogue: 0,0:14:01.70,0:14:04.50,CNsub,NTP,0000,0000,0000,,Маған қауіп төніп тұрғанын айту
Dialogue: 0,0:14:04.92,0:14:06.83,CNsub,NTP,0000,0000,0000,,Тадая - өлтіруші.
Dialogue: 0,0:14:07.33,0:14:08.73,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:09.15,0:14:11.87,CNsub,NTP,0000,0000,0000,,Мен еркекпін, бірақ мен әйелмін.
Dialogue: 0,0:14:12.22,0:14:14.46,CNsub,NTP,0000,0000,0000,,Мен осында тұруға келгендегі ниетім осы.
Dialogue: 0,0:14:14.98,0:14:19.92,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:20.29,0:14:21.37,CNsub,NTP,0000,0000,0000,,Сондықтан...
Dialogue: 0,0:14:23.31,0:14:25.86,CNsub,NTP,0000,0000,0000,,Мен осында ұйықтай аламын.
Dialogue: 0,0:14:26.27,0:14:28.84,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:31.21,0:14:31.95,CNsub,NTP,0000,0000,0000,,Растау
Dialogue: 0,0:14:35.16,0:14:39.44,CNsub,NTP,0000,0000,0000,,Кеше түнде не айттыңыз?
Dialogue: 0,0:14:40.26,0:14:41.70,CNsub,NTP,0000,0000,0000,,Мен жаңа құлыптың тұтқасын ауыстырдым.
Dialogue: 0,0:14:42.02,0:14:42.83,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:14:43.23,0:14:47.43,CNsub,NTP,0000,0000,0000,,Кәсіпорын орналасқан кәсіпорынның жұмысы
Dialogue: 0,0:14:47.69,0:14:49.39,CNsub,NTP,0000,0000,0000,,Маған сізбен сөйлесу талап етілмейді.
Dialogue: 0,0:14:50.54,0:14:54.75,CNsub,NTP,0000,0000,0000,,Өлгендердің үйі... үйдің аты
Dialogue: 0,0:15:02.11,0:15:03.60,CNsub,NTP,0000,0000,0000,,Сіздің тегіңіз кім?
Dialogue: 0,0:15:04.12,0:15:05.62,CNsub,NTP,0000,0000,0000,,Екі түрі
Dialogue: 0,0:15:07.37,0:15:08.95,CNsub,NTP,0000,0000,0000,,Каджо Томое
Dialogue: 0,0:17:09.08,0:17:12.57,CNsub,NTP,0000,0000,0000,,Бұл 16 қазандағы жаңа жаңалық.
Dialogue: 0,0:17:24.41,0:17:26.37,CNsub,NTP,0000,0000,0000,,Томое өлімі
Dialogue: 0,0:17:32.26,0:17:33.09,CNsub,NTP,0000,0000,0000,,Бұл елдің контрбарлау қызметін талқандау оңай емес.
Dialogue: 0,0:17:40.18,0:17:42.46,CNsub,NTP,0000,0000,0000,,Екі рет
Dialogue: 0,0:17:46.67,0:17:48.13,CNsub,NTP,0000,0000,0000,,Тәртіпсіздік
Dialogue: 0,0:17:56.16,0:17:58.14,CNsub,NTP,0000,0000,0000,,Мен өлдім
Dialogue: 0,0:18:00.07,0:18:02.57,CNsub,NTP,0000,0000,0000,,Алайда олай емес.
Dialogue: 0,0:18:03.23,0:18:06.71,CNsub,NTP,0000,0000,0000,,Сіздің талантыңыздың арқасында сіз мұны істей аласыз.
Dialogue: 0,0:18:06.96,0:18:07.78,CNsub,NTP,0000,0000,0000,,Өлім нені білдіреді?
Dialogue: 0,0:18:08.88,0:18:10.99,CNsub,NTP,0000,0000,0000,,Мен қазір өлдім.
Dialogue: 0,0:18:11.59,0:18:16.20,CNsub,NTP,0000,0000,0000,,Менің ойым мен табысымның шындығы және жақын арада кездеспей қайтыс болған адамның өлімі.
Dialogue: 0,0:18:16.60,0:18:19.36,CNsub,NTP,0000,0000,0000,,Сіз өз жұмысыңызға ризасыз.
Dialogue: 0,0:18:19.52,0:18:23.50,CNsub,NTP,0000,0000,0000,,Жаз мезгілінен не білдім және оның қалай болғаны
Dialogue: 0,0:18:23.87,0:18:24.86,CNsub,NTP,0000,0000,0000,,Маркиз Натоя…
Dialogue: 0,0:18:27.73,0:18:30.64,CNsub,NTP,0000,0000,0000,,Сен менің досымсың
Dialogue: 0,0:18:33.00,0:18:33.79,CNsub,NTP,0000,0000,0000,,Неке куәлігі: Ллойд Фогель, Джоэл Фогель
Dialogue: 0,0:18:34.12,0:18:35.22,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:18:35.74,0:18:38.75,CNsub,NTP,0000,0000,0000,,Сіз доссыз ба? Жағдайлар жақсы өтті.
36-бөлім
Dialogue: 0,0:18:39.23,0:18:42.03,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:18:42.43,0:18:43.52,CNsub,NTP,0000,0000,0000,,Мацухиро Нохкан
Dialogue: 0,0:18:43.71,0:18:46.14,CNsub,NTP,0000,0000,0000,,Қазіргі уақытта алыс аймақтан басқа ешкім кеткен жоқ.
Dialogue: 0,0:18:48.97,0:18:50.43,CNsub,NTP,0000,0000,0000,,Кітапты қайталап оқу.
Dialogue: 0,0:18:50.90,0:18:56.28,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:18:56.69,0:18:59.26,CNsub,NTP,0000,0000,0000,,Жазда бір ай төсек болмайды
Dialogue: 0,0:18:59.72,0:19:03.36,CNsub,NTP,0000,0000,0000,,Мені қаламасаң, мұнда отыра алмайсың.
Dialogue: 0,0:19:07.55,0:19:09.25,CNsub,NTP,0000,0000,0000,,Мен әрекет етпедім.
Dialogue: 0,0:19:09.95,0:19:10.95,CNsub,NTP,0000,0000,0000,,Сіз оны оқи аласыз
Dialogue: 0,0:19:11.31,0:19:12.34,CNsub,NTP,0000,0000,0000,,…өлім
Dialogue: 0,0:19:12.93,0:19:15.76,CNsub,NTP,0000,0000,0000,,Менің досым жетілген орта мектеп оқушысы.
Dialogue: 0,0:19:16.12,0:19:18.37,CNsub,NTP,0000,0000,0000,,Бұл есімді жазған адамның тегі.
Dialogue: 0,0:19:18.87,0:19:21.48,CNsub,NTP,0000,0000,0000,,Түнгі жол басқа адамдарға байланысты
Dialogue: 0,0:19:22.02,0:19:23.79,CNsub,NTP,0000,0000,0000,,I…
Dialogue: 0,0:19:27.04,0:19:30.93,CNsub,NTP,0000,0000,0000,,...Өкінішке орай, мен бақытты адаммын.
Dialogue: 0,0:19:31.18,0:19:31.84,CNsub,NTP,0000,0000,0000,,Шабдалы жұмыртқасы
Dialogue: 0,0:19:32.35,0:19:33.68,CNsub,NTP,0000,0000,0000,,Сіз дарынды емессіз.
Dialogue: 0,0:19:49.59,0:19:53.18,CNsub,NTP,0000,0000,0000,,Бұл 18 қазандағы соңғы жаңалықтар.
Dialogue: 0,0:19:54.10,0:19:56.50,CNsub,NTP,0000,0000,0000,,Жолда адасып қалды
Dialogue: 0,0:20:01.31,0:20:02.07,CNsub,NTP,0000,0000,0000,,Екі?
Dialogue: 0,0:20:06.28,0:20:07.93,CNsub,NTP,0000,0000,0000,,Нана деген кім?
Dialogue: 0,0:20:31.61,0:20:32.80,CNsub,NTP,0000,0000,0000,,Мен жоғалып кеттім бе?
Dialogue: 0,0:20:34.66,0:20:36.80,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:20:37.08,0:20:38.11,CNsub,NTP,0000,0000,0000,,Толығымен әсерлі әсер
Dialogue: 0,0:20:38.45,0:20:40.52,CNsub,NTP,0000,0000,0000,,Өмірімде өлген досым
Dialogue: 0,0:20:41.03,0:20:43.43,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:20:43.72,0:20:47.38,CNsub,NTP,0000,0000,0000,,Менде саған деген қамқорлық сезімі бар
Dialogue: 0,0:20:47.96,0:20:50.74,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:20:51.62,0:20:56.70,CNsub,NTP,0000,0000,0000,,Бұл сізді кездестіру қаупіне байланысты...
Dialogue: 0,0:20:57.56,0:20:58.75,CNsub,NTP,0000,0000,0000,,Түсіндіру қайда?
Dialogue: 0,0:20:59.68,0:21:05.63,CNsub,NTP,0000,0000,0000,,Мен...мен бақыттымын!
Dialogue: 0,0:21:05.86,0:21:06.57,CNsub,NTP,0000,0000,0000,,Асқабақ!
Dialogue: 0,0:21:12.22,0:21:14.88,CNsub,NTP,0000,0000,0000,,Ләззат алудан мүмкін ләззат
Dialogue: 0,0:21:19.74,0:21:23.38,CNsub,NTP,0000,0000,0000,,Егер сіз үлкен тесілген шұлық киген адам орындайтын гипноз бағдарламасын білмесеңіз,
Dialogue: 0,0:21:23.61,0:21:26.29,CNsub,NTP,0000,0000,0000,,Жоқ... жоқ, мен рас бола алмаймын.
Dialogue: 0,0:21:27.10,0:21:30.25,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:21:30.67,0:21:32.79,CNsub,NTP,0000,0000,0000,,Ойымның соңында мен өзіме ұқсас адамды көрдім.
Dialogue: 0,0:21:33.47,0:21:38.15,CNsub,NTP,0000,0000,0000,,Сіз шынымен шынайысыз.
Dialogue: 0,0:21:41.46,0:21:42.14,CNsub,NTP,0000,0000,0000,,Нана...
Dialogue: 0,0:21:44.56,0:21:46.29,CNsub,NTP,0000,0000,0000,,Мен өле аламын
Dialogue: 0,0:21:47.20,0:21:47.89,CNsub,NTP,0000,0000,0000,,Өлім
Dialogue: 0,0:21:52.73,0:21:55.73,CNsub,NTP,0000,0000,0000,,Мен өле аламын ба?
Dialogue: 0,0:21:56.47,0:21:57.59,CNsub,NTP,0000,0000,0000,,Анти-Сейго…
Dialogue: 0,0:21:59.69,0:22:00.81,CNsub,NTP,0000,0000,0000,,Ата-анасы өлтірілді ме?
Dialogue: 0,0:22:02.08,0:22:06.73,CNsub,NTP,0000,0000,0000,,Менің арманым әр кезде әртүрлі
Dialogue: 0,0:22:07.35,0:22:08.23,CNsub,NTP,0000,0000,0000,,Ақиқат - бұл май.
Dialogue: 0,0:22:09.17,0:22:10.40,CNsub,NTP,0000,0000,0000,,Бұл менің өлтірілсем деген арманым.
Dialogue: 0,0:22:10.96,0:22:13.04,CNsub,NTP,0000,0000,0000,,Конфликтке ұқсас дауыс
Dialogue: 0,0:22:13.26,0:22:15.94,CNsub,NTP,0000,0000,0000,,Ана бекетінің ашылуы
Dialogue: 0,0:22:17.56,0:22:19.91,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:22:30.16,0:22:34.61,CNsub,NTP,0000,0000,0000,,Бір-бірінен ерекшеленетін ата-аналар
Dialogue: 0,0:22:35.91,0:22:40.95,CNsub,NTP,0000,0000,0000,,Арманның ақиқаты мәңгілік
Dialogue: 0,0:22:41.68,0:22:45.94,CNsub,NTP,0000,0000,0000,,Менің анам түнде қайда?
Dialogue: 0,0:22:46.82,0:22:47.55,CNsub,NTP,0000,0000,0000,,Сіз Чи Доу
Dialogue: 0,0:22:48.14,0:22:50.49,CNsub,NTP,0000,0000,0000,,Адамның табиғаты жылы.
Dialogue: 0,0:22:51.85,0:22:53.26,CNsub,NTP,0000,0000,0000,,Бұл жағдайда өлім аяқталды және т.б
Dialogue: 0,0:22:54.07,0:22:57.98,CNsub,NTP,0000,0000,0000,,Соңғы рет таңдағаныңыз ауыр болды.
Dialogue: 0,0:22:58.59,0:23:05.87,CNsub,NTP,0000,0000,0000,,Мен сені алғаш көргенімде, болашақта жоқ болып кеттің.
Dialogue: 0,0:23:06.30,0:23:07.67,CNsub,NTP,0000,0000,0000,,Өлім жазасына кесілгендерге өлім жазасы
Dialogue: 0,0:23:08.27,0:23:11.39,CNsub,NTP,0000,0000,0000,,Өлсең, жалғастыра аласың.
Dialogue: 0,0:23:12.32,0:23:15.60,CNsub,NTP,0000,0000,0000,,Менің өмірім қажет емес.
Dialogue: 0,0:23:17.40,0:23:18.38,CNsub,NTP,0000,0000,0000,,Менің сөздерім
Dialogue: 0,0:23:19.20,0:23:20.80,CNsub,NTP,0000,0000,0000,,Сіз қайда тұрасыз?
Dialogue: 0,0:23:21.40,0:23:22.64,CNsub,NTP,0000,0000,0000,,Чидо Рёмата Ноей
Dialogue: 0,0:23:23.06,0:23:25.70,CNsub,NTP,0000,0000,0000,,405-кабинет
Dialogue: 0,0:23:25.91,0:23:26.92,CNsub,NTP,0000,0000,0000,,Бұл олай емес.
Dialogue: 0,0:23:27.77,0:23:30.26,CNsub,NTP,0000,0000,0000,,Бұл адам туралы не ойлайсыз?
Dialogue: 0,0:23:30.87,0:23:32.25,CNsub,NTP,0000,0000,0000,,Белгісіздік
Dialogue: 0,0:23:33.37,0:23:37.64,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:23:38.93,0:23:39.80,CNsub,NTP,0000,0000,0000,,Қайта қаралды
Dialogue: 0,0:23:40.02,0:23:41.44,CNsub,NTP,0000,0000,0000,,Тиісті сөйлесу мәліметтерін пайдалану жолы
Dialogue: 0,0:23:51.69,0:23:55.33,CNsub,NTP,0000,0000,0000,,Айтсаңыз, айта аласыз.
Dialogue: 0,0:00:01.00,0:00:01.00,CNsub,NTP,0000,0000,0000,,========================p2=========================
Dialogue: 0,0:24:09.39,0:24:12.68,CNsub,NTP,0000,0000,0000,,9 қарашада жарияланған, кешкі жаңалықтар
Dialogue: 0,0:24:15.91,0:24:17.59,CNsub,NTP,0000,0000,0000,,Бір жұлдызды кезеңнің аяқталуы
Dialogue: 0,0:24:46.77,0:24:48.80,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:24:49.16,0:24:51.67,CNsub,NTP,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:24:53.07,0:24:55.45,CNsub,NTP,0000,0000,0000,,Мен де…
Dialogue: 0,0:24:55.57,0:24:58.67,CNsub,NTP,0000,0000,0000,,Препараттардың шығу тегі
Dialogue: 0,0:25:04.86,0:25:07.19,CNsub,NTP,0000,0000,0000,,Жақсы оқу.
Dialogue: 0,0:25:11.79,0:25:15.79,CNsub,NTP,0000,0000,0000,,Бұл менің ауытқуым.
Dialogue: 0,0:25:15.89,0:25:18.77,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:25:19.27,0:25:22.25,CNsub,NTP,0000,0000,0000,,Жалпы қалалық ақпарат
Dialogue: 0,0:25:22.42,0:25:25.49,CNsub,NTP,0000,0000,0000,,Менің өлуім мүмкін.
Dialogue: 0,0:25:25.88,0:25:27.55,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:25:27.90,0:25:29.90,CNsub,NTP,0000,0000,0000,,Сақтамау
Dialogue: 0,0:25:30.15,0:25:30.76,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:25:31.14,0:25:34.65,CNsub,NTP,0000,0000,0000,,Сіз туралы белгілі бір оқиғаның 405 бөлмесі
Dialogue: 0,0:25:35.21,0:25:36.71,CNsub,NTP,0000,0000,0000,,Бұл сіз білуіңіз керек талант.
Dialogue: 0,0:25:37.21,0:25:38.53,CNsub,NTP,0000,0000,0000,,Гаякай кетуге қосылды
Dialogue: 0,0:25:48.14,0:25:48.93,CNsub,NTP,0000,0000,0000,,Қайда бару керек
Dialogue: 0,0:25:51.11,0:25:52.36,CNsub,NTP,0000,0000,0000,,Бұл әңгіме
Dialogue: 0,0:25:58.59,0:26:00.74,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:26:01.19,0:26:03.10,CNsub,NTP,0000,0000,0000,,Өлмейтін сөз немесе өлім заңының тазалығы
Dialogue: 0,0:26:27.37,0:26:28.63,CNsub,NTP,0000,0000,0000,,Кіреберіске келу…
Dialogue: 0,0:26:38.46,0:26:39.83,CNsub,NTP,0000,0000,0000,,Кабинетте жұмыс істеу
Dialogue: 0,0:26:45.35,0:26:48.20,CNsub,NTP,0000,0000,0000,,Аспаннан жоғары қашықтық
Dialogue: 0,0:26:48.98,0:26:50.33,CNsub,NTP,0000,0000,0000,,8 Аспанның оң және сол жағы
Dialogue: 0,0:26:50.91,0:26:52.47,CNsub,NTP,0000,0000,0000,,Уақыттылық
Dialogue: 0,0:26:52.95,0:26:53.77,CNsub,NTP,0000,0000,0000,,Ята Такуми аяқталды
Dialogue: 0,0:26:56.27,0:26:57.09,CNsub,NTP,0000,0000,0000,,Қасық
Dialogue: 0,0:26:57.47,0:26:58.53,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:26:59.47,0:27:02.91,CNsub,NTP,0000,0000,0000,,Нәтиже ашық болмаса, ол аяқталады.
Dialogue: 0,0:27:03.34,0:27:05.52,CNsub,NTP,0000,0000,0000,,Тікелей жылжыту қажет емес
Dialogue: 0,0:27:06.18,0:27:07.84,CNsub,NTP,0000,0000,0000,,Белгісіз механизмді күтпеген жерден пайдалану
Dialogue: 0,0:27:34.13,0:27:36.37,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:27:36.91,0:27:40.34,CNsub,NTP,0000,0000,0000,,Сабақта 8 ұпай, Токио тобында 1 сағат бітірді
Dialogue: 0,0:27:40.59,0:27:41.75,CNsub,NTP,0000,0000,0000,,Енді аспан – отын күні.
Dialogue: 0,0:27:42.03,0:27:44.17,CNsub,NTP,0000,0000,0000,,Кездесу соңғы рет өткізілді
Dialogue: 0,0:27:44.53,0:27:46.59,CNsub,NTP,0000,0000,0000,,Накая ойыннан шықты.
Dialogue: 0,0:27:47.53,0:27:50.10,CNsub,NTP,0000,0000,0000,,Шираниду
Dialogue: 0,0:27:50.31,0:27:53.77,CNsub,NTP,0000,0000,0000,,Егер сіз үлкен адаммен сөйлессеңіз, сіз жоғары пайданы сатып ала аласыз.
Dialogue: 0,0:27:54.02,0:27:57.65,CNsub,NTP,0000,0000,0000,,Егер сіз балаға қосылсаңыз, сіз оны жасай алмайсыз.
Dialogue: 0,0:27:58.09,0:28:00.76,CNsub,NTP,0000,0000,0000,,Біреудің қиялы біреудің таланты мен өмірінің жемісі.
Dialogue: 0,0:28:01.11,0:28:03.40,CNsub,NTP,0000,0000,0000,,Шираниду
Dialogue: 0,0:28:03.92,0:28:05.16,CNsub,NTP,0000,0000,0000,,Бұл ләззат алудың жолы.
Dialogue: 0,0:28:07.10,0:28:08.08,CNsub,NTP,0000,0000,0000,,Бұл жексұрын нәрсе
Dialogue: 0,0:28:08.58,0:28:12.40,CNsub,NTP,0000,0000,0000,,Бұл қайтыс болған адамның жағдайы.
Dialogue: 0,0:28:24.26,0:28:27.40,CNsub,NTP,0000,0000,0000,,Томое Сіз осы уақытқа дейін келдіңіз
Dialogue: 0,0:28:28.45,0:28:30.07,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:28:30.37,0:28:31.58,CNsub,NTP,0000,0000,0000,,Сіз өзіңізге айқайлайсыз
Dialogue: 0,0:28:32.66,0:28:33.37,CNsub,NTP,0000,0000,0000,,Мен біттім
Dialogue: 0,0:28:33.46,0:28:35.80,CNsub,NTP,0000,0000,0000,,Бұл арман
Dialogue: 0,0:28:36.16,0:28:37.04,CNsub,NTP,0000,0000,0000,,Бұл шындық
Dialogue: 0,0:28:37.99,0:28:39.15,CNsub,NTP,0000,0000,0000,,Ойдың қарсылығы
Dialogue: 0,0:28:39.35,0:28:42.67,CNsub,NTP,0000,0000,0000,,Мен жазатайым оқиғаға тап болдым.
Dialogue: 0,0:28:43.00,0:28:44.33,CNsub,NTP,0000,0000,0000,,Жарақат?
Dialogue: 0,0:28:44.51,0:28:46.53,CNsub,NTP,0000,0000,0000,,Себебі, сізде өзіңізді құрметтейді
Dialogue: 0,0:28:47.01,0:28:49.38,CNsub,NTP,0000,0000,0000,,Әр кезде өсек-аяң
Dialogue: 0,0:28:49.76,0:28:50.85,CNsub,NTP,0000,0000,0000,,Жарайды, бұл тек менің жеке пікірім ғана.
Dialogue: 0,0:28:51.26,0:28:55.16,CNsub,NTP,0000,0000,0000,,Жолдан шығу үшін біраз күш жұмсалды.
Dialogue: 0,0:28:55.41,0:28:57.35,CNsub,NTP,0000,0000,0000,,Бұл сіз жақсы жұмыс істемейтіндіктен...
Dialogue: 0,0:28:57.84,0:28:59.46,CNsub,NTP,0000,0000,0000,,Ауылда да жоғалған
Dialogue: 0,0:29:02.68,0:29:05.35,CNsub,NTP,0000,0000,0000,,Оқу ақысы басқа өздігінен қосылады.
Dialogue: 0,0:29:05.91,0:29:08.44,CNsub,NTP,0000,0000,0000,,Мүмкін немесе қабылданбаған…
Dialogue: 0,0:29:09.54,0:29:10.98,CNsub,NTP,0000,0000,0000,,Басқа самурайларды зерттеу
Dialogue: 0,0:29:11.32,0:29:13.43,CNsub,NTP,0000,0000,0000,,Сіз жұмыс істемейсіз бе?
Dialogue: 0,0:29:38.63,0:29:39.80,CNsub,NTP,0000,0000,0000,,Тамақ ішу
Dialogue: 0,0:30:16.30,0:30:20.39,CNsub,NTP,0000,0000,0000,,Сумит
Dialogue: 0,0:30:21.72,0:30:22.92,CNsub,NTP,0000,0000,0000,,Жабық және жабық тұмсық
Dialogue: 0,0:30:24.16,0:30:26.70,CNsub,NTP,0000,0000,0000,,Томое өлімі…
Dialogue: 0,0:30:44.53,0:30:46.92,CNsub,NTP,0000,0000,0000,,Ең соңғы істегенім жүгіру болды.
Dialogue: 0,0:30:48.01,0:30:50.36,CNsub,NTP,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:30:50.77,0:30:53.87,CNsub,NTP,0000,0000,0000,,Мен...Мен өлдім.
Dialogue: 0,0:30:54.22,0:30:55.97,CNsub,NTP,0000,0000,0000,,Ояну кезеңінде ерте келген
Dialogue: 0,0:30:57.58,0:30:59.51,CNsub,NTP,0000,0000,0000,,Бір тамшы қан
Dialogue: 0,0:31:00.74,0:31:03.08,CNsub,NTP,0000,0000,0000,,Ясато Хаяками өлімінің ротациясы
Dialogue: 0,0:31:03.41,0:31:04.74,CNsub,NTP,0000,0000,0000,,Дарындылық жоқ
Dialogue: 0,0:31:05.18,0:31:06.81,CNsub,NTP,0000,0000,0000,,Бұл қазіргі уақытта өміршең емес.
Dialogue: 0,0:31:07.15,0:31:08.41,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:31:08.92,0:31:10.99,CNsub,NTP,0000,0000,0000,,Шираничи аймақты тастап кетті
Dialogue: 0,0:31:11.35,0:31:12.02,CNsub,NTP,0000,0000,0000,,Төменгі бөлік?
Dialogue: 0,0:31:12.94,0:31:14.53,CNsub,NTP,0000,0000,0000,,Жергілікті талап болса
Dialogue: 0,0:31:15.15,0:31:17.09,CNsub,NTP,0000,0000,0000,,Сіздің нақты тұрғылықты жеріңіз
Dialogue: 0,0:31:17.64,0:31:20.17,CNsub,NTP,0000,0000,0000,,Қандай оғаш нәрселерді көріп тұрмын
Dialogue: 0,0:31:20.74,0:31:22.90,CNsub,NTP,0000,0000,0000,,Сіз 405-бөлме туралы айтып отырсыз
Dialogue: 0,0:31:23.51,0:31:26.77,CNsub,NTP,0000,0000,0000,,Дегенмен, сіздің тегіңіз ең соңғысы.
Dialogue: 0,0:31:27.34,0:31:30.92,CNsub,NTP,0000,0000,0000,,Тар үйде тұрғылықты жерін жоғалтуға байланысты орын ауыстыру тәртібі
Dialogue: 0,0:31:31.48,0:31:38.74,CNsub,NTP,0000,0000,0000,,Бұл оқиғаның оқиғасы: Йоджо отбасы болмаған 4-ші бөлмедегі соңғы сәт — 410-бөлменің оқиғасы біртүрлі оқиғадан басталады.
Dialogue: 0,0:31:39.69,0:31:42.94,CNsub,NTP,0000,0000,0000,,Басқа аймақта тұрғың келе ме?
Dialogue: 0,0:31:43.30,0:31:50.21,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:31:50.60,0:31:51.83,CNsub,NTP,0000,0000,0000,,Буккиарати тым сабырлы болып тұр.
Dialogue: 0,0:31:52.59,0:31:55.39,CNsub,NTP,0000,0000,0000,,Нақты ауыстыру аяқталды және шығу аяқталды.
Dialogue: 0,0:31:56.14,0:31:59.42,CNsub,NTP,0000,0000,0000,,Электрлік баспалдақ жұмыс істей бастағанда
Dialogue: 0,0:32:00.12,0:32:02.28,CNsub,NTP,0000,0000,0000,,Барлығы кері механизмдер
Dialogue: 0,0:32:02.89,0:32:05.80,CNsub,NTP,0000,0000,0000,,Үлкен жарылыс.
Dialogue: 0,0:32:06.30,0:32:09.52,CNsub,NTP,0000,0000,0000,,Егер сіз отырған адамды оқымасаңыз, бұл жарты айналым.
Dialogue: 0,0:32:10.48,0:32:13.09,CNsub,NTP,0000,0000,0000,,Бұл бұрандалы баспалдақ.
Dialogue: 0,0:32:13.48,0:32:14.75,CNsub,NTP,0000,0000,0000,,Бұл...бұл...
Dialogue: 0,0:32:15.13,0:32:18.28,CNsub,NTP,0000,0000,0000,,Бекіту - біріктірілген электр баспалдақтары белсенді емес.
Dialogue: 0,0:32:18.76,0:32:19.64,CNsub,NTP,0000,0000,0000,,Кіріспе…
Dialogue: 0,0:32:20.02,0:32:22.85,CNsub,NTP,0000,0000,0000,,Шығуға келгенде абай болмаңыз.
Dialogue: 0,0:32:23.37,0:32:24.50,CNsub,NTP,0000,0000,0000,,Тайшо Тангрё
Dialogue: 0,0:32:24.91,0:32:27.36,CNsub,NTP,0000,0000,0000,,Жалпы қалалық сақтық шараларын сақтау керек және...
Dialogue: 0,0:32:27.71,0:32:29.25,CNsub,NTP,0000,0000,0000,,Жалпы ақпарат
Dialogue: 0,0:32:29.69,0:32:33.64,CNsub,NTP,0000,0000,0000,,Барлығы бірдей шаршы шаршы кешен, бірақ декорация мен айналаның арасында үлкен айырмашылық бар.
Dialogue: 0,0:32:34.24,0:32:35.81,CNsub,NTP,0000,0000,0000,,Ауыл аумағын бөлу
Dialogue: 0,0:32:36.27,0:32:40.49,CNsub,NTP,0000,0000,0000,,Жұмбақ гүл жіптерінің әрқайсысы ақыл-ойдың пайда болуына жауап береді.
Dialogue: 0,0:32:41.02,0:32:42.28,CNsub,NTP,0000,0000,0000,,Дүние дегеніміз не?
Dialogue: 0,0:32:42.82,0:32:45.97,CNsub,NTP,0000,0000,0000,,Себепсіз микроскопиялық ауытқу, себебіне байланысты анықталмайтын үлкен ауытқу.
Dialogue: 0,0:32:46.58,0:32:49.64,CNsub,NTP,0000,0000,0000,,Бұл менің шынайы үйім.
Dialogue: 0,0:32:49.87,0:32:54.18,CNsub,NTP,0000,0000,0000,,Растаудан кейін сіз электр баспалдағын ашпас бұрын бір айға көшетін боласыз.
Dialogue: 0,0:32:54.48,0:32:55.84,CNsub,NTP,0000,0000,0000,,Осыдан кейін Токиодағы фронт-офис
Dialogue: 0,0:32:56.20,0:32:57.38,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:32:57.83,0:33:00.86,CNsub,NTP,0000,0000,0000,,Дегенмен, шығарылымның мақсаты - кімнің кім екенін ...
Dialogue: 0,0:33:01.33,0:33:03.64,CNsub,NTP,0000,0000,0000,,Бұдан басқа
Dialogue: 0,0:33:04.00,0:33:07.24,CNsub,NTP,0000,0000,0000,,Бұл білімді жұртшылық.
Dialogue: 0,0:33:07.86,0:33:09.01,CNsub,NTP,0000,0000,0000,,Есікті ашу үшін қажет
Dialogue: 0,0:33:09.38,0:33:11.04,CNsub,NTP,0000,0000,0000,,Жарты жылдық көрінбейтін өз үйі
Dialogue: 0,0:33:14.10,0:33:15.69,CNsub,NTP,0000,0000,0000,,Жарық осында
Dialogue: 0,0:33:32.00,0:33:35.19,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:33:36.17,0:33:37.94,CNsub,NTP,0000,0000,0000,,Жарты жылдан кейін қайтыс болды
Dialogue: 0,0:33:38.96,0:33:41.34,CNsub,NTP,0000,0000,0000,,Төмендегі мәліметтерді қараңыз…
Dialogue: 0,0:33:44.07,0:33:45.83,CNsub,NTP,0000,0000,0000,,Каджо Кайяку ашық
Dialogue: 0,0:33:48.14,0:33:48.81,CNsub,NTP,0000,0000,0000,,Тесілмеген, бірақ бірдеңе бар…
Dialogue: 0,0:33:51.34,0:33:53.19,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:33:53.48,0:33:57.33,CNsub,NTP,0000,0000,0000,,Бұл жай ғана бір нәрсеге мән бермейтін адам.
Dialogue: 0,0:33:57.72,0:33:58.82,CNsub,NTP,0000,0000,0000,,Ойлар энциклопедиясы
Dialogue: 0,0:33:59.23,0:33:59.83,CNsub,NTP,0000,0000,0000,,Жүгіру аяқталды
Dialogue: 0,0:34:01.54,0:34:02.12,CNsub,NTP,0000,0000,0000,,Әрине, мен ашуланамын — мен сонша…
Dialogue: 0,0:34:02.72,0:34:04.01,CNsub,NTP,0000,0000,0000,,Дәл осы дәлелдер бар болғандықтан
Dialogue: 0,0:34:09.50,0:34:10.84,CNsub,NTP,0000,0000,0000,,Сізді қарсы алады
Dialogue: 0,0:35:24.83,0:35:26.39,CNsub,NTP,0000,0000,0000,,Жақсы ... жақсы зиян
Dialogue: 0,0:35:28.32,0:35:29.74,CNsub,NTP,0000,0000,0000,,Екі алдыңғы
Dialogue: 0,0:35:33.28,0:35:34.14,CNsub,NTP,0000,0000,0000,,Бүгін таңертең іші онша үлкен емес еді, ал қазір…
Dialogue: 0,0:35:36.87,0:35:39.59,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:35:44.95,0:35:47.04,CNsub,NTP,0000,0000,0000,,Мен сені түсінемін
Dialogue: 0,0:35:47.32,0:35:52.11,CNsub,NTP,0000,0000,0000,,Дұрыс, қашықтықты бағындырғаныңызға екі жыл болды.
Dialogue: 0,0:35:52.53,0:35:54.84,CNsub,NTP,0000,0000,0000,,Мені өлтірме
Dialogue: 0,0:35:56.48,0:35:57.63,CNsub,NTP,0000,0000,0000,,Ол осылайша жанды шығарып алады ма?
Dialogue: 0,0:35:58.20,0:36:03.07,CNsub,NTP,0000,0000,0000,,Сиқыршы Соен Арая, қастандық типті адам
Dialogue: 0,0:36:03.47,0:36:09.16,CNsub,NTP,0000,0000,0000,,Шынайы мағына
Dialogue: 0,0:36:10.27,0:36:13.63,CNsub,NTP,0000,0000,0000,,Сіздің қалағаныңыз осы... Жоспарларыңыз қандай?
Dialogue: 0,0:36:14.28,0:36:16.49,CNsub,NTP,0000,0000,0000,,Бұл жеке сот талқылауы.
Dialogue: 0,0:36:17.83,0:36:20.96,CNsub,NTP,0000,0000,0000,,Бұл сіздің қызығушылығыңыз.
Dialogue: 0,0:36:21.54,0:36:22.47,CNsub,NTP,0000,0000,0000,,Теріске шығару?
Dialogue: 0,0:36:22.98,0:36:29.82,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:36:30.48,0:36:31.78,CNsub,NTP,0000,0000,0000,,Өлімге әкелетін бір аспан
Dialogue: 0,0:36:32.58,0:36:35.68,CNsub,NTP,0000,0000,0000,,Менің оқиғам: Түнде өмірден өтіп, ерте тудым.
Dialogue: 0,0:36:36.14,0:36:38.61,CNsub,NTP,0000,0000,0000,,Бұл күнделікті өмірдің өрісі.
Dialogue: 0,0:36:39.39,0:36:41.50,CNsub,NTP,0000,0000,0000,,Сиқыр үшін белгісіз жол қолданылады.
Dialogue: 0,0:36:42.22,0:36:46.13,CNsub,NTP,0000,0000,0000,,Мен аспанға жетуге міндетті дүние жасадым.
Dialogue: 0,0:36:46.63,0:36:50.51,CNsub,NTP,0000,0000,0000,,Адамның қабілетсіздігінің түпкілікті өлімі
Dialogue: 0,0:36:50.87,0:36:56.56,CNsub,NTP,0000,0000,0000,,Мың еселенген оқиғаның өлімі.
Dialogue: 0,0:36:57.08,0:37:00.52,CNsub,NTP,0000,0000,0000,,Алайда нәтиже бұрынғыдай.
Dialogue: 0,0:37:00.86,0:37:05.47,CNsub,NTP,0000,0000,0000,,Түпнұсқа әңгіменің бастауы осы.
Dialogue: 0,0:37:06.00,0:37:07.76,CNsub,NTP,0000,0000,0000,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:37:08.40,0:37:11.48,CNsub,NTP,0000,0000,0000,,Бастапқыда ыдыраған Шығыс пен Батыс еді.
Dialogue: 0,0:37:12.13,0:37:15.90,CNsub,NTP,0000,0000,0000,,Келесі бір айдағы үй иелерін өзара өлтіру Өлім
Dialogue: 0,0:37:16.54,0:37:19.31,CNsub,NTP,0000,0000,0000,,Қоғамдық меншікті осылай орнатасыз.
Dialogue: 0,0:37:20.00,0:37:21.52,CNsub,NTP,0000,0000,0000,,Бұл сіз істегіңіз келетін нәрсе
Dialogue: 0,0:37:22.14,0:37:24.71,CNsub,NTP,0000,0000,0000,,Адам бейнесі адам бейнесімен ауыстырылды.
Dialogue: 0,0:37:25.34,0:37:27.89,CNsub,NTP,0000,0000,0000,,Адам фигурасын ауыстыру…
Dialogue: 0,0:37:28.62,0:37:30.79,CNsub,NTP,0000,0000,0000,,На… Нага бұл…
Dialogue: 0,0:37:31.19,0:37:33.60,CNsub,NTP,0000,0000,0000,,Егер мені өлтіргің келсе
Dialogue: 0,0:37:34.33,0:37:38.87,CNsub,NTP,0000,0000,0000,,Мияджо Сенгоку мен Асагами Фуджиното әсері
Dialogue: 0,0:37:39.29,0:37:40.04,CNsub,NTP,0000,0000,0000,,Мен саған мүмкіндік беремін. Таңдауға екі жол бар.
Dialogue: 0,0:37:40.46,0:37:45.96,CNsub,NTP,0000,0000,0000,,Ажал жақындағанда, өлімді таңдайсың, өмірді таңдайсың.
Dialogue: 0,0:37:46.48,0:37:52.60,CNsub,NTP,0000,0000,0000,,Бір-біріңді өлтірсеңдер, өлімнен рахат алыңдар, өлімді ойлаңдар.
Dialogue: 0,0:37:53.41,0:38:01.80,CNsub,NTP,0000,0000,0000,,Жолдас болсаң, жолдассың, бірақ сен де өзара кісі өлтірушінің құралысың.
Dialogue: 0,0:38:02.50,0:38:07.21,CNsub,NTP,0000,0000,0000,,Екі адам дұрыс құрбандықтар.
Dialogue: 0,0:38:07.53,0:38:08.39,CNsub,NTP,0000,0000,0000,,Сіз…
Dialogue: 0,0:38:08.69,0:38:13.02,CNsub,NTP,0000,0000,0000,,Бұл күтпеген сатып алу.
Dialogue: 0,0:38:15.09,0:38:21.76,CNsub,NTP,0000,0000,0000,,Хаостың екі түрлі формасы, шығу тегі
Dialogue: 0,0:38:22.41,0:38:28.21,CNsub,NTP,0000,0000,0000,,Фамилияңызға қараңыз
Dialogue: 0,0:38:28.43,0:38:29.33,CNsub,NTP,0000,0000,0000,,Сіз кінәлісіз!
Dialogue: 0,0:38:33.03,0:38:35.37,CNsub,NTP,0000,0000,0000,,`` Көңілді '' '' Кинджу '' '' Хебишо ''
Dialogue: 0,0:38:43.26,0:38:46.95,CNsub,NTP,0000,0000,0000,,Сіздің денеңізді Арая Сорей түсірді.
Dialogue: 0,0:38:50.90,0:38:51.73,CNsub,NTP,0000,0000,0000,,«Дайтен»,
Dialogue: 0,0:38:54.19,0:38:59.23,CNsub,NTP,0000,0000,0000,,Балалық
Dialogue: 0,0:38:59.64,0:39:04.74,CNsub,NTP,0000,0000,0000,,Дереу өлімнің сиқырлы көзін дереу қолдану.
Dialogue: 0,0:39:06.56,0:39:09.56,CNsub,NTP,0000,0000,0000,,Бұл қажет емес.
Dialogue: 0,0:39:17.95,0:39:19.17,CNsub,NTP,0000,0000,0000,,Пил сүйегі
Dialogue: 0,0:39:19.68,0:39:22.36,CNsub,NTP,0000,0000,0000,,Ең алдымен онымен ойнау керек.
Dialogue: 0,0:39:24.17,0:39:27.68,CNsub,NTP,0000,0000,0000,,Бір реттік
Dialogue: 0,0:39:28.14,0:39:28.81,CNsub,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:39:29.12,0:39:31.47,CNsub,NTP,0000,0000,0000,,Шекара да тек шекара емес.
Dialogue: 0,0:39:31.91,0:39:34.76,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:39:38.62,0:39:41.19,CNsub,NTP,0000,0000,0000,,Алайда, төменде 2 дана
Dialogue: 0,0:39:41.76,0:39:42.66,CNsub,NTP,0000,0000,0000,,Ная Тайшо Рё
Dialogue: 0,0:39:55.92,0:39:57.99,CNsub,NTP,0000,0000,0000,,Шынайы сынғыштық
Dialogue: 0,0:39:58.39,0:40:01.89,CNsub,NTP,0000,0000,0000,,Аспан асты елінің жолында адасқан
Dialogue: 0,0:40:02.65,0:40:03.24,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:40:26.41,0:40:29.52,CNsub,NTP,0000,0000,0000,,Менің бастауым – тыныштық
Dialogue: 0,0:40:31.65,0:40:38.96,CNsub,NTP,0000,0000,0000,,200 жыл өмір сүріп, бір айда өлуге болады.
Dialogue: 0,0:40:42.04,0:40:44.54,CNsub,NTP,0000,0000,0000,,Мүмкін Мүмкін
Dialogue: 0,0:40:44.95,0:40:47.48,CNsub,NTP,0000,0000,0000,,Мен мұны істегенді ұнатамын.
Dialogue: 0,0:41:32.17,0:41:32.82,CNsub,NTP,0000,0000,0000,,Осы жағдайды ескерсек, алдымен мейрамханаға кіріп алсақ па?
Dialogue: 0,0:41:33.25,0:41:35.49,CNsub,NTP,0000,0000,0000,,Салтанатты шара... Кездесу қақпасы
Dialogue: 0,0:00:01.00,0:00:01.00,CNsub,NTP,0000,0000,0000,,=========================p3==========================
Dialogue: 0,0:41:47.30,0:41:50.10,CNsub,NTP,0000,0000,0000,,Аты-жөні: Каня Курогири
Dialogue: 0,0:41:51.44,0:41:54.12,CNsub,NTP,0000,0000,0000,,Бұл осы санаттың өкілі.
Dialogue: 0,0:41:54.40,0:41:56.57,CNsub,NTP,0000,0000,0000,,Тестілеудің соңында сіз біліктілікті растай аласыз.
Dialogue: 0,0:41:56.71,0:41:58.07,CNsub,NTP,0000,0000,0000,,Пайдалануға болмайтын келісімшарт кітабы
Dialogue: 0,0:41:58.27,0:41:59.51,CNsub,NTP,0000,0000,0000,,Сәттілік
Dialogue: 0,0:41:59.82,0:42:02.70,CNsub,NTP,0000,0000,0000,,Мен гүлдерді бір айда ауыстыра аламын ба?
Dialogue: 0,0:42:03.08,0:42:05.70,CNsub,NTP,0000,0000,0000,,Мен өмірден өттім.
Dialogue: 0,0:42:05.93,0:42:07.04,CNsub,NTP,0000,0000,0000,,Тікелей тексеру
Dialogue: 0,0:42:07.63,0:42:08.19,CNsub,NTP,0000,0000,0000,,Рұқсатсыз
Dialogue: 0,0:42:08.48,0:42:10.91,CNsub,NTP,0000,0000,0000,,Зерттеу тобының ұзақ тарихы...
Dialogue: 0,0:42:11.11,0:42:12.63,CNsub,NTP,0000,0000,0000,,Сіздің шынайы жүзіңіз
Dialogue: 0,0:42:13.07,0:42:15.87,CNsub,NTP,0000,0000,0000,,Ол кезде мен студент едім.
Dialogue: 0,0:42:16.57,0:42:17.67,CNsub,NTP,0000,0000,0000,,Бұл түпнұсқаның шығу тегі.
Dialogue: 0,0:42:17.91,0:42:19.60,CNsub,NTP,0000,0000,0000,,Тококо Коджия мен Иудакайдың уақыты...
Dialogue: 0,0:42:19.78,0:42:20.27,CNsub,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:42:23.12,0:42:25.13,CNsub,NTP,0000,0000,0000,,Бұрын танылған адам
Dialogue: 0,0:42:25.76,0:42:27.86,CNsub,NTP,0000,0000,0000,,Осыған байланысты ой пайда болмады.
Dialogue: 0,0:42:28.41,0:42:30.32,CNsub,NTP,0000,0000,0000,,Сондықтан мен сәйкес ақпаратты шығара алдым.
Dialogue: 0,0:42:31.06,0:42:32.57,CNsub,NTP,0000,0000,0000,,Ацунари академиясы
Dialogue: 0,0:42:34.53,0:42:35.55,CNsub,NTP,0000,0000,0000,,Жалаңаш адам
Dialogue: 0,0:42:36.10,0:42:38.00,CNsub,NTP,0000,0000,0000,,Бастапқыда жақсы бейне, құпия монах.
Dialogue: 0,0:42:38.70,0:42:40.40,CNsub,NTP,0000,0000,0000,,Толық қуаттылықтың көптігі
Dialogue: 0,0:42:40.58,0:42:43.23,CNsub,NTP,0000,0000,0000,,Дегенмен, қызметте тағы қанша адам бар?
Dialogue: 0,0:42:43.84,0:42:46.61,CNsub,NTP,0000,0000,0000,,Мен абдырап қалдым, бірақ бұл менің жеке үйім.
Dialogue: 0,0:42:47.47,0:42:48.73,CNsub,NTP,0000,0000,0000,,Мен адаммын.
Dialogue: 0,0:42:49.11,0:42:50.76,CNsub,NTP,0000,0000,0000,,Адам – өткінші жан.
Dialogue: 0,0:42:51.22,0:42:54.01,CNsub,NTP,0000,0000,0000,,Бастапқы шекара
Dialogue: 0,0:42:54.74,0:42:56.08,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:42:56.24,0:42:57.66,CNsub,NTP,0000,0000,0000,,Тапсырысыңызды алмаған болсаңыз
Dialogue: 0,0:42:58.59,0:43:00.18,CNsub,NTP,0000,0000,0000,,Тұлға
Dialogue: 0,0:43:00.30,0:43:02.54,CNsub,NTP,0000,0000,0000,,Жиналыс қызметкерлерінен шығару
Dialogue: 0,0:43:03.12,0:43:04.19,CNsub,NTP,0000,0000,0000,,Қара тунг
Dialogue: 0,0:43:04.72,0:43:05.95,CNsub,NTP,0000,0000,0000,,Рұқсат етілмеген өмірлік жағдайлар
Dialogue: 0,0:43:06.04,0:43:07.49,CNsub,NTP,0000,0000,0000,,Капитал қажет емес адам
Dialogue: 0,0:43:18.78,0:43:20.19,CNsub,NTP,0000,0000,0000,,Косаки Косаки
Dialogue: 0,0:43:20.54,0:43:21.76,CNsub,NTP,0000,0000,0000,,Йошихиса көрінбеді
Dialogue: 0,0:43:22.16,0:43:23.82,CNsub,NTP,0000,0000,0000,,Соңғы уақытта сіздің денеңіз қалай болды?
Dialogue: 0,0:43:24.33,0:43:26.19,CNsub,NTP,0000,0000,0000,,·
Dialogue: 0,0:43:26.60,0:43:31.54,CNsub,NTP,0000,0000,0000,,Сіз Шумото Кай монастырында қанша уақыт болдыңыз?
Dialogue: 0,0:43:32.23,0:43:34.62,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:43:35.18,0:43:39.11,CNsub,NTP,0000,0000,0000,,Менің әлеміме қадам басудың қажеті жоқ.
Dialogue: 0,0:43:39.57,0:43:42.93,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:43:44.61,0:43:47.12,CNsub,NTP,0000,0000,0000,,Нагоя Коджихараның шеберханасы
Dialogue: 0,0:43:47.56,0:43:50.42,CNsub,NTP,0000,0000,0000,,Мақаланы оқығанда өз пікірімді өзгерткенімді біліп, төмендегі мақаланы оқыдым.
Dialogue: 0,0:43:51.54,0:43:54.06,CNsub,NTP,0000,0000,0000,,Сіз оны көре аласыз.
Dialogue: 0,0:43:54.65,0:43:56.83,CNsub,NTP,0000,0000,0000,,Қарыз алушының денесі
Dialogue: 0,0:43:57.14,0:44:00.97,CNsub,NTP,0000,0000,0000,,Қанша аман қалу мүмкін болса, бұл менің техникам.
Dialogue: 0,0:44:01.57,0:44:08.57,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:44:09.15,0:44:14.75,CNsub,NTP,0000,0000,0000,,Нақты жағдайды ескере отырып, мені білетін бір ғана адам бар.
Dialogue: 0,0:44:15.18,0:44:15.97,CNsub,NTP,0000,0000,0000,,Апельсин апа
Dialogue: 0,0:44:16.39,0:44:17.58,CNsub,NTP,0000,0000,0000,,Қайтып келгенде
Dialogue: 0,0:44:18.07,0:44:18.84,CNsub,NTP,0000,0000,0000,,Бір кездері
Dialogue: 0,0:44:19.75,0:44:21.40,CNsub,NTP,0000,0000,0000,,Көркем көрмені қабылдау актісі
Dialogue: 0,0:44:21.94,0:44:23.29,CNsub,NTP,0000,0000,0000,,Қызығушылықтарыңызға рахмет.
Dialogue: 0,0:44:23.65,0:44:24.14,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:44:25.13,0:44:25.90,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:44:26.42,0:44:28.79,CNsub,NTP,0000,0000,0000,,Маған басқа адамдардың көзінше сиқыр қолдануға рұқсат етілмейді.
Dialogue: 0,0:44:29.52,0:44:30.31,CNsub,NTP,0000,0000,0000,,Кешір мені.
Dialogue: 0,0:44:30.87,0:44:33.53,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:44:33.93,0:44:34.46,CNsub,NTP,0000,0000,0000,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:44:34.70,0:44:36.04,CNsub,NTP,0000,0000,0000,,Тазалықтың сиқырлы төмендеуі
Dialogue: 0,0:44:36.46,0:44:39.58,CNsub,NTP,0000,0000,0000,,Сиқыршы өзінің зерттеу нәтижелеріне жауапты емес.
Dialogue: 0,0:44:39.95,0:44:42.95,CNsub,NTP,0000,0000,0000,,Мақсат тек өзін-өзі тану
Dialogue: 0,0:44:43.58,0:44:45.37,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:44:45.68,0:44:46.42,CNsub,NTP,0000,0000,0000,,Формула…
Dialogue: 0,0:44:46.83,0:44:47.91,CNsub,NTP,0000,0000,0000,,Мақсат – объективті
Dialogue: 0,0:44:48.38,0:44:51.12,CNsub,NTP,0000,0000,0000,,Сиқыршының соңғы мақсаты...
Dialogue: 0,0:44:51.56,0:44:52.93,CNsub,NTP,0000,0000,0000,,…түбір көзге жету
Dialogue: 0,0:44:53.56,0:44:57.49,CNsub,NTP,0000,0000,0000,,Акашику жазбасының барлық көріністерінің шығу тегі
Dialogue: 0,0:44:57.88,0:45:01.24,CNsub,NTP,0000,0000,0000,,Ол да барлық ақиқаттың себебі.
Dialogue: 0,0:45:01.69,0:45:08.01,CNsub,NTP,0000,0000,0000,,Дүние жүзінің тарихын қорытындылау үшін бір сөз тіркесін қолданыңыз.
Dialogue: 0,0:45:08.19,0:45:10.19,CNsub,NTP,0000,0000,0000,,Мені шығыс пен батыс қызықтырады
Dialogue: 0,0:45:10.50,0:45:14.93,CNsub,NTP,0000,0000,0000,,Іздеуде Шығыс пен Батыста мағынасы жоқ
Dialogue: 0,0:45:15.60,0:45:17.44,CNsub,NTP,0000,0000,0000,,Жариялаған:
Dialogue: 0,0:45:17.78,0:45:19.66,CNsub,NTP,0000,0000,0000,,Маңызды шынайы болмыс
Dialogue: 0,0:45:19.96,0:45:22.11,CNsub,NTP,0000,0000,0000,,Бұл дүниеде кімге жете алады
Dialogue: 0,0:45:22.77,0:45:24.76,CNsub,NTP,0000,0000,0000,,Адамның келуі
Dialogue: 0,0:45:25.20,0:45:27.99,CNsub,NTP,0000,0000,0000,,Шығыс пен Батыстың шынайы бет-бейнесі айқын
Dialogue: 0,0:45:28.35,0:45:28.91,CNsub,NTP,0000,0000,0000,,Бұл рөл де біраз қиын екен…
Dialogue: 0,0:45:29.52,0:45:32.32,CNsub,NTP,0000,0000,0000,,Орнын тастап кеткен адам қайтадан қайтыс болды.
Dialogue: 0,0:45:33.03,0:45:37.41,CNsub,NTP,0000,0000,0000,,Бұрын шекаралық сиқыршылардың қаласы түгелдей жоғалып кеткен.
Dialogue: 0,0:45:37.92,0:45:38.81,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:45:39.23,0:45:43.23,CNsub,NTP,0000,0000,0000,,«Таусылмас мақсат» «Бақытсыз топ»
Dialogue: 0,0:45:43.73,0:45:46.15,CNsub,NTP,0000,0000,0000,,Әлемдік атауы `` Сиқыршы ''
Dialogue: 0,0:45:46.40,0:45:48.90,CNsub,NTP,0000,0000,0000,,Түпкілікті қорытынды: ер адам әйел ме?
Dialogue: 0,0:45:49.30,0:45:49.85,CNsub,NTP,0000,0000,0000,,Формула!
Dialogue: 0,0:45:54.85,0:45:55.65,CNsub,NTP,0000,0000,0000,,Фука
Dialogue: 0,0:45:56.19,0:45:57.07,CNsub,NTP,0000,0000,0000,,Бұл сыйлық па?
Dialogue: 0,0:45:57.52,0:45:58.34,CNsub,NTP,0000,0000,0000,,Ах-ли
Dialogue: 0,0:45:58.76,0:46:01.97,CNsub,NTP,0000,0000,0000,,Қаланың жоғалғаны анық.
Dialogue: 0,0:46:02.36,0:46:04.64,CNsub,NTP,0000,0000,0000,,Зерттеу нәтижесі: әрбір әйел бір-бірімен жүріп, араласады.
Dialogue: 0,0:46:05.33,0:46:06.76,CNsub,NTP,0000,0000,0000,,Бұл адамның еңбегі.
Dialogue: 0,0:46:07.40,0:46:09.74,CNsub,NTP,0000,0000,0000,,Сіз өте мейірімдісіз
Dialogue: 0,0:46:10.25,0:46:12.07,CNsub,NTP,0000,0000,0000,,Негізгі деңгейге жету керек.
Dialogue: 0,0:46:12.69,0:46:13.47,CNsub,NTP,0000,0000,0000,,Және...
Dialogue: 0,0:46:13.99,0:46:16.56,CNsub,NTP,0000,0000,0000,,Мен не істерімді білмеймін.
Dialogue: 0,0:46:17.02,0:46:19.54,CNsub,NTP,0000,0000,0000,,Сіз ер адамсыз ба, әлде әйелсіз бе?
Dialogue: 0,0:46:21.97,0:46:24.96,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:46:25.93,0:46:27.07,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:46:30.05,0:46:30.73,CNsub,NTP,0000,0000,0000,,Апельсин апа
Dialogue: 0,0:46:31.28,0:46:32.34,CNsub,NTP,0000,0000,0000,,Сіз және сіздің серіктесіңіз
Dialogue: 0,0:46:32.66,0:46:34.10,CNsub,NTP,0000,0000,0000,,Дұрыс айтасыз.
Dialogue: 0,0:46:35.68,0:46:36.98,CNsub,NTP,0000,0000,0000,,Қайтадан сөйлесу Қара Тунг
Dialogue: 0,0:46:37.35,0:46:37.84,CNsub,NTP,0000,0000,0000,,Э-э, Ллойд мырза, жатын бөлмелерге келсек…
Dialogue: 0,0:46:39.01,0:46:42.21,CNsub,NTP,0000,0000,0000,,Ер адамның ойлау тәсілі
Dialogue: 0,0:46:42.68,0:46:46.43,CNsub,NTP,0000,0000,0000,,Әйел сөздері табиғи түрде әйелдерге қарағанда жақсырақ
Dialogue: 0,0:46:46.81,0:46:47.56,CNsub,NTP,0000,0000,0000,,Атау
Dialogue: 0,0:46:47.84,0:46:49.56,CNsub,NTP,0000,0000,0000,,Насаның әңгімесі проблема емес.
Dialogue: 0,0:46:49.87,0:46:51.71,CNsub,NTP,0000,0000,0000,,Не? Өлім мәселесі
Dialogue: 0,0:46:52.01,0:46:54.75,CNsub,NTP,0000,0000,0000,,Бұл әйел есімі екені даусыз.
Dialogue: 0,0:46:55.07,0:46:56.45,CNsub,NTP,0000,0000,0000,,Әңгімелесу тілі…
18-бөлім
Dialogue: 0,0:46:56.90,0:47:01.29,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:47:01.65,0:47:04.52,CNsub,NTP,0000,0000,0000,,Сіз алғыңыз келетін ақпараттың ең аз мөлшері
Dialogue: 0,0:47:05.84,0:47:06.42,CNsub,NTP,0000,0000,0000,,Барлығыңды өлтіреміз
Dialogue: 0,0:47:06.54,0:47:07.69,CNsub,NTP,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:47:08.60,0:47:09.28,CNsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,0:47:09.73,0:47:11.38,CNsub,NTP,0000,0000,0000,,Сіз бейнені оқыдыңыз ба?
Dialogue: 0,0:47:12.41,0:47:13.26,CNsub,NTP,0000,0000,0000,,Тайшо суреті
Dialogue: 0,0:47:14.00,0:47:18.41,CNsub,NTP,0000,0000,0000,,Ақ пен қара екі жарым ай қосылып бастапқы ниет – саусақ
Dialogue: 0,0:47:18.71,0:47:19.64,CNsub,NTP,0000,0000,0000,,Жарық пен қараңғылық
Dialogue: 0,0:47:20.05,0:47:21.02,CNsub,NTP,0000,0000,0000,,Оң және теріс
Dialogue: 0,0:47:21.40,0:47:22.63,CNsub,NTP,0000,0000,0000,,Ер мен әйел
Dialogue: 0,0:47:23.21,0:47:29.10,CNsub,NTP,0000,0000,0000,,Бірнеше нүктелері бар кішкентай тесік қарама-қайшы және қарама-қайшы спираль болып табылады.
Dialogue: 0,0:47:29.52,0:47:32.38,CNsub,NTP,0000,0000,0000,,«Екі» атты жұмыс Яньянға барар жолда
Dialogue: 0,0:47:33.44,0:47:34.56,CNsub,NTP,0000,0000,0000,,Фуканжуниман
Dialogue: 0,0:47:34.81,0:47:37.26,CNsub,NTP,0000,0000,0000,,Белгілі бір дәрежедегі әртүрлі ойлар
Dialogue: 0,0:47:38.65,0:47:41.42,CNsub,NTP,0000,0000,0000,,Бір түбір компонент және екі жеке шарт
Dialogue: 0,0:47:42.16,0:47:45.26,CNsub,NTP,0000,0000,0000,,Когава Огаваның келбеті тарихи тұлға
Dialogue: 0,0:47:46.16,0:47:46.93,CNsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,0:47:47.32,0:47:49.58,CNsub,NTP,0000,0000,0000,,Ағынның жолын білесің бе?
Dialogue: 0,0:47:49.91,0:47:52.94,CNsub,NTP,0000,0000,0000,,Сіз аймақтағы қоғамдық жердесіз бе?
Dialogue: 0,0:47:53.37,0:47:53.84,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:47:54.29,0:47:56.79,CNsub,NTP,0000,0000,0000,,Бұрын мен де қоғамдық жұмыстардың құрылысына қатысқанмын.
Dialogue: 0,0:47:57.36,0:48:00.93,CNsub,NTP,0000,0000,0000,,Полицейлер полицияға келгенде сәл оғаш жағдай орын алды
Dialogue: 0,0:48:01.39,0:48:02.04,CNsub,NTP,0000,0000,0000,,Түсіндірме қандай?
Dialogue: 0,0:48:02.36,0:48:04.73,CNsub,NTP,0000,0000,0000,,Мен бұл жерден кетемін.
Dialogue: 0,0:48:05.27,0:48:06.04,CNsub,NTP,0000,0000,0000,,Ұзақ мерзімді ниет
Dialogue: 0,0:48:06.77,0:48:07.35,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:48:07.49,0:48:08.87,CNsub,NTP,0000,0000,0000,,Ағымдағы жағдай және жеке кету
Dialogue: 0,0:48:09.39,0:48:13.56,CNsub,NTP,0000,0000,0000,,Сіз кетуге болатын жердің бірінші тұрғынының аты-жөні және бұрын қалада тұрған басқа жерлер.
Dialogue: 0,0:48:14.29,0:48:15.81,CNsub,NTP,0000,0000,0000,,Бұл жұмыс тегін.
Dialogue: 0,0:48:16.04,0:48:16.80,CNsub,NTP,0000,0000,0000,,Осыған байланысты жұмыс істеу қиынға соғады
Dialogue: 0,0:48:17.34,0:48:17.86,CNsub,NTP,0000,0000,0000,,Рио Чидо
Dialogue: 0,0:48:18.80,0:48:20.27,CNsub,NTP,0000,0000,0000,,Мұнда ...қара пауловния бар
Dialogue: 0,0:48:20.48,0:48:21.09,CNsub,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:48:21.73,0:48:24.81,CNsub,NTP,0000,0000,0000,,Сенің ер адам екенің рас па?
Dialogue: 0,0:48:31.07,0:48:31.92,CNsub,NTP,0000,0000,0000,,Қашып кетуге тіпті ойлама. Осы жолы мен сенің басыңды шағып тастаймын
Dialogue: 0,0:48:32.27,0:48:34.50,CNsub,NTP,0000,0000,0000,,Жер асты автотұрағы
Dialogue: 0,0:48:35.08,0:48:35.57,CNsub,NTP,0000,0000,0000,,Өздігінен жүру
Dialogue: 0,0:48:39.26,0:48:39.79,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:48:40.19,0:48:40.98,CNsub,NTP,0000,0000,0000,,Йоши Хаяками стилі
Dialogue: 0,0:48:41.57,0:48:42.46,CNsub,NTP,0000,0000,0000,,Аспанның шынайы махаббаты
Dialogue: 0,0:48:42.86,0:48:44.70,CNsub,NTP,0000,0000,0000,,Орнату жиналысы
Dialogue: 0,0:48:46.34,0:48:46.94,CNsub,NTP,0000,0000,0000,,Кения
Dialogue: 0,0:48:47.26,0:48:48.51,CNsub,NTP,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:48:51.21,0:48:52.00,CNsub,NTP,0000,0000,0000,,Акитака мырза
Dialogue: 0,0:48:52.77,0:48:55.02,CNsub,NTP,0000,0000,0000,,Сіз кеше түнде болмадыңыз.
Dialogue: 0,0:48:55.51,0:48:57.31,CNsub,NTP,0000,0000,0000,,Мен кеткенде Акитака мырзаның оң көзқарасын көрдім.
Dialogue: 0,0:48:57.71,0:48:59.04,CNsub,NTP,0000,0000,0000,,Жұмысқа орналасу кезінде ауыстырылатын
Dialogue: 0,0:48:59.46,0:49:01.85,CNsub,NTP,0000,0000,0000,,Басқа сөздер – «Канесада»…
Dialogue: 0,0:49:02.35,0:49:04.54,CNsub,NTP,0000,0000,0000,,Канесей? Тоғыз таңба ойып жазылған ба?
Dialogue: 0,0:49:04.83,0:49:05.99,CNsub,NTP,0000,0000,0000,,Назецу жоқ ва өрнек
Dialogue: 0,0:49:06.36,0:49:07.13,CNsub,NTP,0000,0000,0000,,Күтім қажет емес пе?
Dialogue: 0,0:49:07.57,0:49:09.65,CNsub,NTP,0000,0000,0000,,Бұл қарапайым адамдар көруге жақсы жер.
Dialogue: 0,0:49:09.98,0:49:10.54,CNsub,NTP,0000,0000,0000,,Формула
Dialogue: 0,0:49:10.94,0:49:12.01,CNsub,NTP,0000,0000,0000,,На — ескі қылыш
Dialogue: 0,0:49:12.50,0:49:13.59,CNsub,NTP,0000,0000,0000,,Басқа орындар
Dialogue: 0,0:49:14.06,0:49:15.67,CNsub,NTP,0000,0000,0000,,Бірлестік бөлек ашылады.
Dialogue: 0,0:49:16.26,0:49:16.85,CNsub,NTP,0000,0000,0000,,Бізге асығыс керек.
Dialogue: 0,0:49:17.12,0:49:17.92,CNsub,NTP,0000,0000,0000,,Бастықты құлатып, осылайша оның зор... есірткі табысын өз пайдасына иелену үшін..........
Dialogue: 0,0:49:18.47,0:49:19.35,CNsub,NTP,0000,0000,0000,,Мен қара пауловния деймін
Dialogue: 0,0:49:19.93,0:49:21.24,CNsub,NTP,0000,0000,0000,,Енді сізде аспанның жақсы бейнесі бар.
Dialogue: 0,0:49:21.65,0:49:22.38,CNsub,NTP,0000,0000,0000,,Кешір мені.
Dialogue: 0,0:49:22.81,0:49:23.56,CNsub,NTP,0000,0000,0000,,Мұның себебі…
Dialogue: 0,0:49:24.72,0:49:29.51,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:49:30.28,0:49:31.70,CNsub,NTP,0000,0000,0000,,Арнайы түсіру жоспары
Dialogue: 0,0:49:32.16,0:49:37.14,CNsub,NTP,0000,0000,0000,,Бұл ғимарат бір-бірін жоққа шығаратын жарты ай тәрізді он қабатты құрылым.
Dialogue: 0,0:49:37.65,0:49:38.79,CNsub,NTP,0000,0000,0000,,Біртүрлі жұмбақ
Dialogue: 0,0:49:39.29,0:49:43.60,CNsub,NTP,0000,0000,0000,,Бұл бастапқыда бюджетті қажет ететін қызметкерлер кварталы болды, сондықтан бірінші қабат пен екінші қабат салынды.
Dialogue: 0,0:49:44.02,0:49:45.78,CNsub,NTP,0000,0000,0000,,Қазіргі уақытта тоқтатылған және пайдалануда
Dialogue: 0,0:49:46.49,0:49:48.63,CNsub,NTP,0000,0000,0000,,Шығыс пен Батыс жағалауының әрбір бөлігі он сағаттан кейін басталады.
Dialogue: 0,0:49:49.07,0:49:51.62,CNsub,NTP,0000,0000,0000,,Жер асты ғимаратында орналасқан автотұрақ
Dialogue: 0,0:49:52.17,0:49:53.53,CNsub,NTP,0000,0000,0000,,Құрылыс кезінде қайта қаралған ескі тақта
Dialogue: 0,0:49:53.88,0:49:55.08,CNsub,NTP,0000,0000,0000,,Жалпы тұрғын үй ғимараты
Dialogue: 0,0:49:55.50,0:49:57.37,CNsub,NTP,0000,0000,0000,,Резидент тұрғындары биыл жұмысқа кіріседі.
Dialogue: 0,0:49:58.18,0:50:01.10,CNsub,NTP,0000,0000,0000,,Мамыр айында электр баспалдағын пайдалана алмау
Dialogue: 0,0:50:06.80,0:50:07.45,CNsub,NTP,0000,0000,0000,,Қара пауловния
Dialogue: 0,0:50:07.76,0:50:09.04,CNsub,NTP,0000,0000,0000,,Na – сіздің көзқарасыңыз
Dialogue: 0,0:50:09.71,0:50:10.60,CNsub,NTP,0000,0000,0000,,Өздігінен жүру
Dialogue: 0,0:50:11.33,0:50:14.43,CNsub,NTP,0000,0000,0000,,Біріктірілген ғимараттары бар орталық ғимарат
Dialogue: 0,0:50:14.89,0:50:18.54,CNsub,NTP,0000,0000,0000,,Шығыстан Батысқа екі ғимараттың ашылуына тікелей жол
Dialogue: 0,0:50:19.29,0:50:21.62,CNsub,NTP,0000,0000,0000,,Қажетті ақпарат
Dialogue: 0,0:50:22.93,0:50:24.54,CNsub,NTP,0000,0000,0000,,Шындық – басқаларға бағынбайтын адамның құрылысы.
Dialogue: 0,0:50:24.74,0:50:25.49,CNsub,NTP,0000,0000,0000,,Реніш сезімі...
Dialogue: 0,0:50:25.79,0:50:28.95,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:50:29.37,0:50:31.92,CNsub,NTP,0000,0000,0000,,Хиджо қабырғасында жапон мұнара баспалдақтарының орналасуы
Dialogue: 0,0:50:32.53,0:50:34.41,CNsub,NTP,0000,0000,0000,,Елордада әр уақытта қолданылуы керек.
Dialogue: 0,0:50:34.77,0:50:36.22,CNsub,NTP,0000,0000,0000,,Сатып алуға тапсырысты растау
Dialogue: 0,0:50:37.52,0:50:42.54,CNsub,NTP,0000,0000,0000,,Электрлік баспалдақ біткеннен кейін бес сағаттан кейін 406-дан 410-ға дейін болды.
Dialogue: 0,0:50:43.49,0:50:44.29,CNsub,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:50:44.90,0:50:46.52,CNsub,NTP,0000,0000,0000,,Қызығушылығы
Dialogue: 0,0:50:48.11,0:50:50.60,CNsub,NTP,0000,0000,0000,,Кездесу 401-ден 405-ке дейін
Dialogue: 0,0:50:51.08,0:50:52.53,CNsub,NTP,0000,0000,0000,,Жол – жобалық қате.
Dialogue: 0,0:50:53.19,0:50:55.04,CNsub,NTP,0000,0000,0000,,Нишики Йорей кетіп бара жатыр ма?
Dialogue: 0,0:50:56.11,0:50:58.02,CNsub,NTP,0000,0000,0000,,Электр баспалдағына түскеннен кейін кете аласыз ба?
Dialogue: 0,0:50:58.90,0:51:00.07,CNsub,NTP,0000,0000,0000,,Шынымен де біртүрлі ғимарат
Dialogue: 0,0:51:00.71,0:51:02.62,CNsub,NTP,0000,0000,0000,,Сыртқы әлеммен қалай байланысуға болатыны туралы әңгіме.
Dialogue: 0,0:51:03.51,0:51:04.13,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:51:04.37,0:51:06.37,CNsub,NTP,0000,0000,0000,,Сізде төрт әңгіме болды ма?
Dialogue: 0,0:51:06.93,0:51:09.19,CNsub,NTP,0000,0000,0000,,Бұл отбасы бірінші рет қайтыс болды ма?
Dialogue: 0,0:51:09.62,0:51:10.16,CNsub,NTP,0000,0000,0000,,Орынның ұзындығы
Dialogue: 0,0:51:10.67,0:51:11.89,CNsub,NTP,0000,0000,0000,,Сіз мұнда ағылшын тіліндесіз.
Dialogue: 0,0:51:12.54,0:51:14.88,CNsub,NTP,0000,0000,0000,,Демек, мұны біз ғана білетін полиция қызметкерлеріміз.
Dialogue: 0,0:51:15.31,0:51:16.12,CNsub,NTP,0000,0000,0000,,Сіз ше?
Dialogue: 0,0:51:16.83,0:51:17.97,CNsub,NTP,0000,0000,0000,,Растау аяқталды
Dialogue: 0,0:51:18.48,0:51:20.76,CNsub,NTP,0000,0000,0000,,Менің ойымша, бір адам бір төмен электр сатысы
Dialogue: 0,0:51:21.94,0:51:23.28,CNsub,NTP,0000,0000,0000,,Мен жоғарғы қабатпен кездесуге келдім.
Dialogue: 0,0:51:23.78,0:51:25.42,CNsub,NTP,0000,0000,0000,,Сіз мұнара баспалдағынан шықтыңыз.
Dialogue: 0,0:51:26.10,0:51:27.61,CNsub,NTP,0000,0000,0000,,Көзіңізді жұмып ұстаған кезде
Dialogue: 0,0:51:28.74,0:51:29.44,CNsub,NTP,0000,0000,0000,,15-ші эпизод: Батырлық өлім – Екінші бөлім
Dialogue: 0,0:51:33.00,0:51:35.57,CNsub,NTP,0000,0000,0000,,Тоғай 1-бөлмеден 5-бөлмеге дейін
Dialogue: 0,0:51:36.00,0:51:38.51,CNsub,NTP,0000,0000,0000,,Нишиноки 6-бөлмеден 10-бөлмеге дейін.
Dialogue: 0,0:51:39.04,0:51:46.82,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:51:47.13,0:51:56.12,CNsub,NTP,0000,0000,0000,,Төрт шатырлы тұрғын үйлер Кубо Сасая Мочизуки Шинтани Кубо Сокубо Цужиномия Уэйама Кожо
Dialogue: 0,0:51:56.23,0:51:56.68,CNsub,NTP,0000,0000,0000,,Апельсин
Dialogue: 0,0:51:56.95,0:51:58.30,CNsub,NTP,0000,0000,0000,,Бұл компанияның атауы.
Dialogue: 0,0:52:01.55,0:52:02.32,CNsub,NTP,0000,0000,0000,,Тортты да жей алмай ма?
Dialogue: 0,0:52:03.04,0:52:05.32,CNsub,NTP,0000,0000,0000,,Бұл сирек кездесетін және әдеттен тыс фамилия.
Dialogue: 0,0:52:05.83,0:52:06.75,CNsub,NTP,0000,0000,0000,,Мен бірінші кеттім.
Dialogue: 0,0:52:07.25,0:52:07.74,CNsub,NTP,0000,0000,0000,,Апельсин
Dialogue: 0,0:52:07.99,0:52:09.36,CNsub,NTP,0000,0000,0000,,Сізде көлік құралы бар ма?
Dialogue: 0,0:52:09.86,0:52:11.72,CNsub,NTP,0000,0000,0000,,200CC көлік апаттары көп.
Dialogue: 0,0:52:12.32,0:52:12.86,CNsub,NTP,0000,0000,0000,,Растау
Dialogue: 0,0:52:13.40,0:52:15.45,CNsub,NTP,0000,0000,0000,,Найзағайдың тағы бір бөлігін жазып алыңыз
Dialogue: 0,0:52:15.98,0:52:17.89,CNsub,NTP,0000,0000,0000,,Шығару құбырын ішінара ауыстыру
Dialogue: 0,0:52:18.34,0:52:18.90,CNsub,NTP,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:52:19.37,0:52:19.91,CNsub,NTP,0000,0000,0000,,Кения
Dialogue: 0,0:52:20.20,0:52:21.25,CNsub,NTP,0000,0000,0000,,Қылыш қолға түсті
Dialogue: 0,0:52:21.58,0:52:22.15,CNsub,NTP,0000,0000,0000,,Формула!
Dialogue: 0,0:52:23.62,0:52:24.60,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:52:25.09,0:52:26.89,CNsub,NTP,0000,0000,0000,,Өлім... өлім
Dialogue: 0,0:52:27.01,0:52:27.74,CNsub,NTP,0000,0000,0000,,Кеше түнде мен кештен шықтым.
Dialogue: 0,0:52:27.89,0:52:28.62,CNsub,NTP,0000,0000,0000,,Мен келгенде қайта оқыңыз
Dialogue: 0,0:52:28.99,0:52:30.15,CNsub,NTP,0000,0000,0000,,Шындық – жат үй
Dialogue: 0,0:52:30.52,0:52:32.04,CNsub,NTP,0000,0000,0000,,Берілген уақыт ішінде сөйлесу
Dialogue: 0,0:52:32.36,0:52:33.01,CNsub,NTP,0000,0000,0000,,15-ші эпизод: Батырлық өлім – Екінші бөлім
Dialogue: 0,0:52:43.45,0:52:44.21,CNsub,NTP,0000,0000,0000,,Осы жағдайды ескерсек, алдымен мейрамханаға кіріп алсақ па?
Dialogue: 0,0:52:44.54,0:52:47.00,CNsub,NTP,0000,0000,0000,,Салтанатты шара... Кездесу қақпасы
Dialogue: 0,0:52:48.84,0:52:49.44,CNsub,NTP,0000,0000,0000,,Ол өлген
Dialogue: 0,0:52:49.63,0:52:50.42,CNsub,NTP,0000,0000,0000,,Акитака мырза
Dialogue: 0,0:52:52.25,0:52:53.11,CNsub,NTP,0000,0000,0000,,Менің алдын ала сезімім айқын көрсетті, мен жеңетінімді
Dialogue: 0,0:52:53.46,0:52:57.09,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:52:57.39,0:52:59.34,CNsub,NTP,0000,0000,0000,,Өлім... өлім
Dialogue: 0,0:52:59.73,0:53:01.82,CNsub,NTP,0000,0000,0000,,Кездеспеу-махаббат.
Dialogue: 0,0:53:02.81,0:53:03.52,CNsub,NTP,0000,0000,0000,,Бұл түсініктеме.
Dialogue: 0,0:53:03.97,0:53:07.28,CNsub,NTP,0000,0000,0000,,Үй иесі ұйықтап жатқаннан басқа бөлменің есігін ашқаннан кейін.
Dialogue: 0,0:53:07.71,0:53:08.75,CNsub,NTP,0000,0000,0000,,Сіз жоқсыз ба?
Dialogue: 0,0:53:09.33,0:53:10.94,CNsub,NTP,0000,0000,0000,,Мен есінен танып қалдым.
Dialogue: 0,0:53:11.44,0:53:13.39,CNsub,NTP,0000,0000,0000,,Жұмысты күшейту.
Dialogue: 0,0:53:13.62,0:53:14.98,CNsub,NTP,0000,0000,0000,,Егер сіз қыз бала болсаңыз,
Dialogue: 0,0:53:15.43,0:53:19.34,CNsub,NTP,0000,0000,0000,,Келмегеніме көп болды, жаңа жақсы адаммен емделдім.
Dialogue: 0,0:53:21.00,0:53:24.88,CNsub,NTP,0000,0000,0000,,Аки Така Сенсейдің сөйлеген сөзі, оның сәтсіздікке ұшыраған жағдайларына ұқсас.
Dialogue: 0,0:53:25.29,0:53:28.63,CNsub,NTP,0000,0000,0000,,Өздігінен тазаланатын киімдер
Dialogue: 0,0:53:29.17,0:53:32.20,CNsub,NTP,0000,0000,0000,,Жағымсыз беті бар жаңа келбетті адам
Dialogue: 0,0:53:32.69,0:53:33.40,CNsub,NTP,0000,0000,0000,,Мен саған мүмкіндік беремін. Таңдауға екі жол бар.
Dialogue: 0,0:53:33.94,0:53:35.81,CNsub,NTP,0000,0000,0000,,Мен туралы не ойлайсың?
Dialogue: 0,0:53:36.17,0:53:36.98,CNsub,NTP,0000,0000,0000,,Қателік
Dialogue: 0,0:53:37.25,0:53:38.44,CNsub,NTP,0000,0000,0000,,Осы уақытқа дейін бір түндік жаттығу
Dialogue: 0,0:53:39.04,0:53:41.02,CNsub,NTP,0000,0000,0000,,Ақшаңызды жоғалтқаныңызға сенімдісіз бе?
Dialogue: 0,0:53:41.30,0:53:42.43,CNsub,NTP,0000,0000,0000,,Тұрақты жиналыс
Dialogue: 0,0:53:42.73,0:53:43.82,CNsub,NTP,0000,0000,0000,,Тәртіпсіздік
Dialogue: 0,0:00:01.40,0:00:01.40,CNsub,NTP,0000,0000,0000,,==========================p3-2=========================
Dialogue: 0,0:53:44.48,0:53:47.96,CNsub,NTP,0000,0000,0000,,Жаңа ғана 50-ші нүктенің 30-шы нүктесіне келді.
Dialogue: 0,0:53:53.25,0:53:55.05,CNsub,NTP,0000,0000,0000,,Мен...
Dialogue: 0,0:53:55.93,0:54:00.62,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:54:01.54,0:54:03.54,CNsub,NTP,0000,0000,0000,,Мен мұнда емеспін.
Dialogue: 0,0:54:03.81,0:54:04.37,CNsub,NTP,0000,0000,0000,,Қамшы?
Dialogue: 0,0:54:12.14,0:54:14.44,CNsub,NTP,0000,0000,0000,,Еңбекке жарамсыздықты тоқтату және т.б.
Dialogue: 0,0:54:30.33,0:54:32.21,CNsub,NTP,0000,0000,0000,,Келген соң кетіп қалдым.
Dialogue: 0,0:54:36.06,0:54:37.77,CNsub,NTP,0000,0000,0000,,Қара пауловния бақылау алаңы
Dialogue: 0,0:54:38.20,0:54:39.46,CNsub,NTP,0000,0000,0000,,Кішкентай жұмбақ
Dialogue: 0,0:54:40.95,0:54:42.37,CNsub,NTP,0000,0000,0000,,Мейірбике ретінде жұмысқа қабылдануы мүмкін.
Dialogue: 0,0:54:45.61,0:54:46.68,CNsub,NTP,0000,0000,0000,,Түсінгеніңізге рахмет.
Dialogue: 0,0:54:47.11,0:54:48.62,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:54:50.78,0:54:53.32,CNsub,NTP,0000,0000,0000,,5
Dialogue: 0,0:54:55.18,0:54:58.48,CNsub,NTP,0000,0000,0000,,Бұл 6-шы эпизод.
Dialogue: 0,0:54:58.90,0:55:03.08,CNsub,NTP,0000,0000,0000,,Дұрыс жауап
Dialogue: 0,0:55:03.45,0:55:04.72,CNsub,NTP,0000,0000,0000,,Ақиқат – адамның құрылысы.
Dialogue: 0,0:55:05.44,0:55:08.33,CNsub,NTP,0000,0000,0000,,Оқиға Шығыс пен Батысқа созылады.
Dialogue: 0,0:55:08.71,0:55:13.03,CNsub,NTP,0000,0000,0000,,Ғимараттың жоғарғы деңгейінің биіктігінен асуы
Dialogue: 0,0:55:13.91,0:55:17.02,CNsub,NTP,0000,0000,0000,,Ашылатын бөлімде шағын қозғалыстар бар.
Dialogue: 0,0:55:17.38,0:55:20.69,CNsub,NTP,0000,0000,0000,,Заңды қабылдау 4-деңгей, 5-деңгей аяқталды.
Dialogue: 0,0:55:21.63,0:55:27.62,CNsub,NTP,0000,0000,0000,,Сізде жеке тұру әдісі бар екенін растаңыз.
Dialogue: 0,0:55:28.25,0:55:28.85,CNsub,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:55:29.06,0:55:33.79,CNsub,NTP,0000,0000,0000,,Кеңсе кеңістігі Ауданды өзгерту үшін тұрғынның күнделікті кездесуі жеткілікті.
Dialogue: 0,0:55:37.63,0:55:40.00,CNsub,NTP,0000,0000,0000,,Өткен жыл
Dialogue: 0,0:55:42.45,0:55:45.33,CNsub,NTP,0000,0000,0000,,Бұл бір қабат болатын үлкен орын.
Dialogue: 0,0:55:45.86,0:55:47.66,CNsub,NTP,0000,0000,0000,,Бұл тіректері жоқ төрт периодты құрылым...
Dialogue: 0,0:55:48.56,0:55:52.89,CNsub,NTP,0000,0000,0000,,Мен шығыстағы үлкен шошқаны жобалағанымды айтамын.
Dialogue: 0,0:55:54.07,0:55:55.25,CNsub,NTP,0000,0000,0000,,Ол қайда?
Dialogue: 0,0:55:55.63,0:55:57.06,CNsub,NTP,0000,0000,0000,,Рушин Рушин
Dialogue: 0,0:55:57.42,0:55:58.99,CNsub,NTP,0000,0000,0000,,Қол мен аяқтың қозғалуы туралы қай жерде айту керек
Dialogue: 0,0:55:59.33,0:56:01.59,CNsub,NTP,0000,0000,0000,,Менімен сөйлескенде
Dialogue: 0,0:56:02.02,0:56:03.45,CNsub,NTP,0000,0000,0000,,Мұнара сатысының қозғалысы аяқталды
Dialogue: 0,0:56:04.42,0:56:06.40,CNsub,NTP,0000,0000,0000,,Икурэ Хаширако Тадаарироу Хашира
Dialogue: 0,0:56:07.04,0:56:08.25,CNsub,NTP,0000,0000,0000,,Қабырғадағы сызаттар
Dialogue: 0,0:56:09.02,0:56:11.87,CNsub,NTP,0000,0000,0000,,Жылжымалы мұнара баспалдағын жылжытуға болады...
Dialogue: 0,0:56:12.33,0:56:14.92,CNsub,NTP,0000,0000,0000,,Бұл өрт
Dialogue: 0,0:56:15.88,0:56:17.35,CNsub,NTP,0000,0000,0000,,От жалыны бірдей
Dialogue: 0,0:56:17.63,0:56:18.23,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:56:19.63,0:56:21.68,CNsub,NTP,0000,0000,0000,,…Сен ше?
Dialogue: 0,0:56:21.93,0:56:23.51,CNsub,NTP,0000,0000,0000,,Мен өрт туралы ештеңе білмеймін.
Dialogue: 0,0:56:24.23,0:56:25.99,CNsub,NTP,0000,0000,0000,,...Қазір қолжетімді емес
Dialogue: 0,0:56:26.80,0:56:28.99,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:56:30.51,0:56:32.59,CNsub,NTP,0000,0000,0000,,Сіз мұны төменгі жағындағы қорапты қалдырған кезде айтасыз.
Dialogue: 0,0:56:33.12,0:56:34.04,CNsub,NTP,0000,0000,0000,,Қолдану мақсаты
Dialogue: 0,0:56:34.41,0:56:37.24,CNsub,NTP,0000,0000,0000,,Шығу - спираль тәрізді шығу.
Dialogue: 0,0:56:37.77,0:56:40.34,CNsub,NTP,0000,0000,0000,,Солтүстік пен Оңтүстіктің Ичирайы
Dialogue: 0,0:56:41.15,0:56:43.02,CNsub,NTP,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:56:46.25,0:56:47.80,CNsub,NTP,0000,0000,0000,,Мен сені басшының қызының қайда жасырынып жатқанын айтуға мәжбүрлеймін.
Dialogue: 0,0:56:49.16,0:56:52.86,CNsub,NTP,0000,0000,0000,,Оттың нақты белгісіз жолы
Dialogue: 0,0:56:53.17,0:56:55.34,CNsub,NTP,0000,0000,0000,,Студенттік кезімде танымал болған...
Dialogue: 0,0:57:12.63,0:57:14.80,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:57:29.73,0:57:31.38,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:57:31.54,0:57:32.67,CNsub,NTP,0000,0000,0000,,Менмендік
Dialogue: 0,0:57:33.06,0:57:35.21,CNsub,NTP,0000,0000,0000,,9 қарашада, кешкі жаңалықтарда жарияланған
Dialogue: 0,0:57:35.27,0:57:35.85,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:57:36.45,0:57:40.54,CNsub,NTP,0000,0000,0000,,Өткенде болған оқиға
Dialogue: 0,0:57:42.19,0:57:46.46,CNsub,NTP,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:57:47.06,0:57:49.12,CNsub,NTP,0000,0000,0000,,Расталмаған тіркеу аяқталды.
Dialogue: 0,0:57:49.75,0:57:52.42,CNsub,NTP,0000,0000,0000,,Қысымдағы 20 сауыт жалған адамдар.
Dialogue: 0,0:57:53.23,0:57:59.02,CNsub,NTP,0000,0000,0000,,Оны қайта пайдалану мүмкін емес, бірақ бұл бірнеше жыл бұрын қайтыс болған адамды тіркеудің жалғандығы.
Dialogue: 0,0:58:00.59,0:58:03.74,CNsub,NTP,0000,0000,0000,,All fabricated residents are from the East.
Dialogue: 0,0:58:04.40,0:58:05.68,CNsub,NTP,0000,0000,0000,,Бұл әңгіменің оқиғасы
Dialogue: 0,0:58:06.38,0:58:07.86,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:58:08.26,0:58:09.69,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:58:09.92,0:58:12.82,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:58:18.04,0:58:21.00,CNsub,NTP,0000,0000,0000,,Шын мағына күтпеген жерден келді
Dialogue: 0,0:58:26.27,0:58:27.18,CNsub,NTP,0000,0000,0000,,Әрине, бөлек.
Dialogue: 0,0:58:27.88,0:58:30.98,CNsub,NTP,0000,0000,0000,,Black paulownia
Dialogue: 0,0:58:32.55,0:58:34.16,CNsub,NTP,0000,0000,0000,,Юичи Сатомен Қонақ
Dialogue: 0,0:58:34.83,0:58:36.38,CNsub,NTP,0000,0000,0000,,No other words
Dialogue: 0,0:58:37.10,0:58:40.19,CNsub,NTP,0000,0000,0000,,Қонақтар болмаса, тікелей кетіңіз.
Dialogue: 0,0:58:48.92,0:58:52.61,CNsub,NTP,0000,0000,0000,,Юга Косаки Тайко сақталды
Dialogue: 0,0:58:53.80,0:58:55.95,CNsub,NTP,0000,0000,0000,,Шоута босатуды шығарды
Dialogue: 0,0:58:56.88,0:58:58.56,CNsub,NTP,0000,0000,0000,,Абайсызда тежеу әсері
Dialogue: 0,0:58:59.08,0:59:03.14,CNsub,NTP,0000,0000,0000,,Біз адам болғандықтан, жұлдызды сфераның өзіндік ерекше мәні бар.
Dialogue: 0,0:59:03.79,0:59:07.57,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:59:07.89,0:59:10.37,CNsub,NTP,0000,0000,0000,,Various types of chemical production in the East and West
Dialogue: 0,0:59:10.97,0:59:13.39,CNsub,NTP,0000,0000,0000,,Бұл белгіленген тежеу реакциясы күші.
Dialogue: 0,0:59:14.97,0:59:18.27,CNsub,NTP,0000,0000,0000,,There are many different types of heroes that appeared during their time of creation.
Dialogue: 0,0:59:18.89,0:59:22.77,CNsub,NTP,0000,0000,0000,,The origin of the infinite number of second thoughts approaching the master of past magic
Dialogue: 0,0:59:23.13,0:59:25.33,CNsub,NTP,0000,0000,0000,,Толық тосқауыл қалды
Dialogue: 0,0:59:25.64,0:59:26.91,CNsub,NTP,0000,0000,0000,,Deterrence
Dialogue: 0,0:59:27.39,0:59:29.41,CNsub,NTP,0000,0000,0000,,Шығыс пен Батыс бір-бірінен ерекшеленеді.
Dialogue: 0,0:59:29.89,0:59:32.21,CNsub,NTP,0000,0000,0000,,Келесі ашылуы тиіс жолдар
Dialogue: 0,0:59:32.47,0:59:35.44,CNsub,NTP,0000,0000,0000,,Демек, бұл түпнұсқа мәтін бойынша экзистенциалды саяхат.
Dialogue: 0,0:59:35.71,0:59:36.89,CNsub,NTP,0000,0000,0000,,Тікелей өлімнің жын көзі
Dialogue: 0,0:59:37.55,0:59:41.79,CNsub,NTP,0000,0000,0000,,Өмірдің басқа түрінен құтылғанда
Dialogue: 0,0:59:44.95,0:59:48.55,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,0:59:49.46,0:59:51.00,CNsub,NTP,0000,0000,0000,,Кешегі бала
Dialogue: 0,0:59:51.36,0:59:53.77,CNsub,NTP,0000,0000,0000,,Сіз шәкірттердің шәкірті емессіз.
Dialogue: 0,0:59:54.19,0:59:55.79,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,0:59:56.58,0:59:59.31,CNsub,NTP,0000,0000,0000,,Мен мұны айтқым келмейді...
Dialogue: 0,0:59:59.79,1:00:01.38,CNsub,NTP,0000,0000,0000,,Маған да студент болу керек.
Dialogue: 0,1:00:01.93,1:00:04.01,CNsub,NTP,0000,0000,0000,,However, I am currently a student at the university.
Dialogue: 0,1:00:04.62,1:00:07.13,CNsub,NTP,0000,0000,0000,,Сіз оны қарап шығып, жариялай аласыз.
Dialogue: 0,1:00:08.20,1:00:10.65,CNsub,NTP,0000,0000,0000,,Кескіндеменің көп жылдық тарихы
Dialogue: 0,1:00:11.11,1:00:13.01,CNsub,NTP,0000,0000,0000,,Мен сені жақын арада көремін деп үміттенемін
Dialogue: 0,1:00:13.82,1:00:15.13,CNsub,NTP,0000,0000,0000,,See below
Dialogue: 0,1:00:23.72,1:00:26.83,CNsub,NTP,0000,0000,0000,,Gehenna
Dialogue: 0,1:00:27.43,1:00:31.07,CNsub,NTP,0000,0000,0000,,I'm here to welcome you, a first-rate messenger.
Dialogue: 0,1:00:31.67,1:00:33.39,CNsub,NTP,0000,0000,0000,,Құттықтаймыз Ама Ба
Dialogue: 0,1:00:33.66,1:00:35.76,CNsub,NTP,0000,0000,0000,,This is the way to do it.
Dialogue: 0,1:00:36.19,1:00:39.20,CNsub,NTP,0000,0000,0000,,Дұрыс айтасың, мен саған қамқор боламын!
Dialogue: 0,1:00:39.92,1:00:43.30,CNsub,NTP,0000,0000,0000,,Егер сіз аймақта болмасаңыз, төмендегі ақпаратты оқыңыз.
Dialogue: 0,1:00:43.88,1:00:45.71,CNsub,NTP,0000,0000,0000,,Данышпан – әңгіме
Dialogue: 0,1:00:46.17,1:00:50.16,CNsub,NTP,0000,0000,0000,,Рәсімге тыйым салынғаны айтылады.
Dialogue: 0,1:00:50.56,1:00:51.17,CNsub,NTP,0000,0000,0000,,Being there
Dialogue: 0,1:00:51.64,1:00:52.86,CNsub,NTP,0000,0000,0000,,Нишикидің 10-шы ғимараты
Dialogue: 0,1:00:53.45,1:00:55.97,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:00:56.42,1:00:57.50,CNsub,NTP,0000,0000,0000,,Сатып алуға дайындық
Dialogue: 0,1:00:57.79,1:01:01.19,CNsub,NTP,0000,0000,0000,,2 жыл бұрын болған апаттан өлімнің жын көзі оянды.
Dialogue: 0,1:01:01.57,1:01:06.05,CNsub,NTP,0000,0000,0000,,Сонымен қатар мен жаман көздің өлім сызығын көре алатынын түсіндім.
Dialogue: 0,1:01:06.91,1:01:08.75,CNsub,NTP,0000,0000,0000,,Kosaki...!
Dialogue: 0,1:01:09.35,1:01:11.19,CNsub,NTP,0000,0000,0000,,Good luck.
Dialogue: 0,1:01:11.58,1:01:14.23,CNsub,NTP,0000,0000,0000,,Өлім сызығы - физикалық жойылу.
Dialogue: 0,1:01:14.53,1:01:18.22,CNsub,NTP,0000,0000,0000,,Физикалық шындық туралы не білетініңізді қараңыз
Dialogue: 0,1:01:18.61,1:01:19.58,CNsub,NTP,0000,0000,0000,,It's also true...
Dialogue: 0,1:01:20.06,1:01:22.07,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,1:01:22.57,1:01:23.20,CNsub,NTP,0000,0000,0000,,Дұрыс және бұрыс
Dialogue: 0,1:01:23.68,1:01:27.68,CNsub,NTP,0000,0000,0000,,Салтанатты дене байланысы, жын көзі және алғашқы танк байланысы
Dialogue: 0,1:01:28.27,1:01:31.70,CNsub,NTP,0000,0000,0000,,Басқа мақсаттарды растау бастапқы резервуар болып табылады.
Dialogue: 0,1:01:32.24,1:01:33.78,CNsub,NTP,0000,0000,0000,,Бұл тұрарлық емес.
Dialogue: 0,1:01:34.12,1:01:34.76,CNsub,NTP,0000,0000,0000,,Others?
Dialogue: 0,1:01:35.00,1:01:39.79,CNsub,NTP,0000,0000,0000,,Өлгенім үшін, Содан бері келдім.
Dialogue: 0,1:01:40.16,1:01:41.65,CNsub,NTP,0000,0000,0000,,Kosaki!
Dialogue: 0,1:01:44.39,1:01:46.22,CNsub,NTP,0000,0000,0000,,Қызғылт сары қыз, міне, осында.
Dialogue: 0,1:01:46.96,1:01:48.41,CNsub,NTP,0000,0000,0000,,Бұл есеп себеп-салдар.
Dialogue: 0,1:01:49.07,1:01:51.72,CNsub,NTP,0000,0000,0000,,Шығыс пен Батыстың қазіргі жағдайы қандай?
Dialogue: 0,1:01:52.20,1:01:57.26,CNsub,NTP,0000,0000,0000,,Not provided
Dialogue: 0,1:01:58.12,1:02:02.62,CNsub,NTP,0000,0000,0000,,Storage in Taiwan
Dialogue: 0,1:02:03.17,1:02:04.26,CNsub,NTP,0000,0000,0000,,Тадабуна орамы
Dialogue: 0,1:02:07.71,1:02:08.65,CNsub,NTP,0000,0000,0000,,Dream
Dialogue: 0,1:02:09.97,1:02:12.29,CNsub,NTP,0000,0000,0000,,Шығыс пен батысқа тиесілі ауыл жазбасы
Dialogue: 0,1:02:13.00,1:02:16.88,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:02:17.35,1:02:19.40,CNsub,NTP,0000,0000,0000,,Бұл дүниежүзілік тарихи арман
Dialogue: 0,1:02:19.89,1:02:22.51,CNsub,NTP,0000,0000,0000,,Өзімнің жан-жақты ағымдағы бір сәттік жазба
Dialogue: 0,1:02:22.90,1:02:24.62,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:02:25.07,1:02:28.98,CNsub,NTP,0000,0000,0000,,Сиқырлы шебер бір отбасының мүшесі.
Dialogue: 0,1:02:30.67,1:02:32.54,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:02:32.99,1:02:33.70,CNsub,NTP,0000,0000,0000,,Келу
Dialogue: 0,1:02:44.00,1:02:46.39,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,1:03:14.65,1:03:16.32,CNsub,NTP,0000,0000,0000,,Бұл... Денемдегі барлық күш-қуат бірден кетіп қалды
Dialogue: 0,0:00:01.00,0:00:01.00,CNsub,NTP,0000,0000,0000,,==========================p4========================
Dialogue: 0,1:03:48.07,1:03:50.57,CNsub,NTP,0000,0000,0000,,How many people did I save?
Dialogue: 0,1:03:52.15,1:03:53.28,CNsub,NTP,0000,0000,0000,,Existing and impossible story
Dialogue: 0,1:03:54.12,1:03:57.00,CNsub,NTP,0000,0000,0000,,Мен мүмкіндігінше тезірек өлім туралы жазбаны жаздым.
Dialogue: 0,1:04:00.51,1:04:03.45,CNsub,NTP,0000,0000,0000,,Mortal…collection
Dialogue: 0,1:04:07.94,1:04:09.84,CNsub,NTP,0000,0000,0000,,…
Dialogue: 0,1:04:11.15,1:04:13.00,CNsub,NTP,0000,0000,0000,,Мен сенімен кездесуді жалғастырамын, армандаймын.
Dialogue: 0,1:04:15.20,1:04:15.95,CNsub,NTP,0000,0000,0000,,Araya!
Dialogue: 0,1:04:16.11,1:04:19.79,CNsub,NTP,0000,0000,0000,,·…
Dialogue: 0,1:04:19.96,1:04:20.63,CNsub,NTP,0000,0000,0000,,Керіскерлер тобы
Dialogue: 0,1:04:21.33,1:04:22.56,CNsub,NTP,0000,0000,0000,,Do you want to feel better?
Dialogue: 0,1:04:23.18,1:04:23.98,CNsub,NTP,0000,0000,0000,,Мұндайды есту өте сирек
Dialogue: 0,1:04:24.68,1:04:25.23,CNsub,NTP,0000,0000,0000,,Тоюки
Dialogue: 0,1:04:25.73,1:04:26.62,CNsub,NTP,0000,0000,0000,,Disregarding the situation
Dialogue: 0,1:04:27.02,1:04:29.59,CNsub,NTP,0000,0000,0000,,In the same case
Dialogue: 0,1:04:30.14,1:04:31.33,CNsub,NTP,0000,0000,0000,,Sorry for the inconvenience
Dialogue: 0,1:04:32.02,1:04:34.03,CNsub,NTP,0000,0000,0000,,...
Dialogue: 0,1:04:34.70,1:04:36.35,CNsub,NTP,0000,0000,0000,,I lack both humanity
Dialogue: 0,1:04:37.28,1:04:38.72,CNsub,NTP,0000,0000,0000,,Of course it is necessary to remove it.
