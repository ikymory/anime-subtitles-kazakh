Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.09,0:00:10.26,Default,,0,0,0,,(Риканың ауыр тыныс алуы)
Dialogue: 0,0:00:12.84,0:00:14.09,Default,,0,0,0,,Ха... ха
Dialogue: 0,0:00:24.85,0:00:26.10,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:00:28.19,0:00:29.86,Default,,0,0,0,,Кімге... Мияу~
Dialogue: 0,0:00:31.11,0:00:32.44,Default,,0,0,0,,Уф
Dialogue: 0,0:00:38.07,0:00:40.08,Default,,0,0,0,,♪～
Dialogue: 0,0:02:05.66,0:02:07.91,Default,,0,0,0,,～♪
Dialogue: 0,0:02:12.71,0:02:16.05,Default,,0,0,0,,Ах, өте жақсы сезіледі
Dialogue: 0,0:02:16.13,0:02:18.05,Default,,0,0,0,,А, солай.
Dialogue: 0,0:02:18.13,0:02:20.26,Default,,0,0,0,,Бұл аздап терең, сондықтан абай болыңыз.
Dialogue: 0,0:02:20.34,0:02:21.85,Default,,0,0,0,,Не? Ия...
Dialogue: 0,0:02:22.93,0:02:24.22,Default,,0,0,0,,Пуха
Dialogue: 0,0:02:25.35,0:02:26.22,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:02:26.31,0:02:27.27,Default,,0,0,0,,Иә
Dialogue: 0,0:02:27.35,0:02:28.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:29.77,0:02:33.31,Default,,0,0,0,,Қайда қарап тұрсыз? Адамдар қиыншылықта!
Dialogue: 0,0:02:33.40,0:02:34.90,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:02:34.98,0:02:37.32,Default,,0,0,0,,Тоғашы-күн онсыз да тентек!
Dialogue: 0,0:02:37.40,0:02:39.70,Default,,0,0,0,,Ахаха, тоқтат!
Dialogue: 0,0:02:39.78,0:02:42.32,Default,,0,0,0,,Тогаши-кунның жынысы!
Dialogue: 0,0:02:42.41,0:02:44.08,Default,,0,0,0,,Абаба... тоқтат!
Dialogue: 0,0:02:44.16,0:02:45.54,Default,,0,0,0,,Секс~!
Dialogue: 0,0:02:45.62,0:02:47.70,Default,,0,0,0,,Уау! Тоқта!
Dialogue: 0,0:02:47.79,0:02:51.83,Default,,0,0,0,,Хмм... аа~ тоқтатшы~
Dialogue: 0,0:02:52.38,0:02:53.67,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:56.25,0:02:58.17,Default,,0,0,0,,Ақырында оралдыңыз ба?
Dialogue: 0,0:02:58.72,0:03:00.55,Default,,0,0,0,,Мынау сенің қолыңда не бар?
Dialogue: 0,0:03:00.63,0:03:03.18,Default,,0,0,0,,Гейрихвассер!
Dialogue: 0,0:03:03.64,0:03:05.18,Default,,0,0,0,,(Су дыбысы әлсірейді)
Dialogue: 0,0:03:06.06,0:03:09.14,Default,,0,0,0,,Сиқырлы камераның ішіндегі қысымның жоғарылауы
Dialogue: 0,0:03:09.23,0:03:13.15,Default,,0,0,0,,Энергияны зарядтау 120%
Dialogue: 0,0:03:13.23,0:03:17.15,Default,,0,0,0,,- (Юта) Сен кінәлісің! -(Rikka) Woouuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuu...
Dialogue: 0,0:03:17.23,0:03:18.74,Default,,0,0,0,,Сіздің безендіруіңізге не болды?
Dialogue: 0,0:03:19.19,0:03:20.57,Default,,0,0,0,,Декорация?
Dialogue: 0,0:03:21.24,0:03:22.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:22.74,0:03:26.87,Default,,0,0,0,,Әй, ұрыс болды, сол кезде...
Dialogue: 0,0:03:26.95,0:03:30.12,Default,,0,0,0,,А... жоқ, бұл туралы әлі білмегенім дұрыс...
Dialogue: 0,0:03:30.21,0:03:32.29,Default,,0,0,0,,Чуунибио қиын.
Dialogue: 0,0:03:32.37,0:03:33.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:33.63,0:03:36.50,Default,,0,0,0,,А... не!? Мысық!?
Dialogue: 0,0:03:36.59,0:03:37.75,Default,,0,0,0,,Мияу~
Dialogue: 0,0:03:39.26,0:03:40.80,Default,,0,0,0,,Кимера?
Dialogue: 0,0:03:40.88,0:03:44.68,Default,,0,0,0,,Бұл грек мифологиясынан алынған құбыжық немесе ойын.
Dialogue: 0,0:03:44.76,0:03:49.56,Default,,0,0,0,,Иә, мен оны кеше түнде көрінбейтін шекара сызығын зерттеу кезінде кездестірдім.
Dialogue: 0,0:03:51.89,0:03:53.19,Default,,0,0,0,,Оны алыңыз
Dialogue: 0,0:03:53.81,0:03:55.23,Default,,0,0,0,,Сіз оны сақтауды жоспарлап отырсыз ба?
Dialogue: 0,0:03:55.31,0:03:58.07,Default,,0,0,0,,Хмм, оны таныс ретінде қолданыңыз.
Dialogue: 0,0:03:58.61,0:04:00.99,Default,,0,0,0,,Қараңғылық әлемінен шыққан Кимераға
Dialogue: 0,0:04:01.07,0:04:04.57,Default,,0,0,0,,Көрінбейтін шекараларды табатын күш болуы керек.
Dialogue: 0,0:04:04.66,0:04:07.70,Default,,0,0,0,,- (Рикка) Бірақ бір мәселе бар - (Юта) Не?
Dialogue: 0,0:04:07.78,0:04:10.54,Default,,0,0,0,,Көрінбейтін шекараны басқару бюросының діни қызметкері
Dialogue: 0,0:04:10.62,0:04:14.79,Default,,0,0,0,,Кимераның сиқырлы күші шамадан тыс иммундық жауап тудырады
Dialogue: 0,0:04:14.87,0:04:17.79,Default,,0,0,0,,Сіздің әпкеңіздің мысықтарға аллергиясы бар ма?
Dialogue: 0,0:04:18.29,0:04:22.55,Default,,0,0,0,,Сондықтан мен жерлесім Қараңғы жалын шеберінен көмек сұрадым...
Dialogue: 0,0:04:22.63,0:04:23.80,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:04:25.26,0:04:28.30,Default,,0,0,0,,Орта мектептің басталғанына бір аптадай уақыт болды.
Dialogue: 0,0:04:28.39,0:04:30.60,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:04:30.68,0:04:33.52,Default,,0,0,0,,Ей, қараңғы жалын шебері
Dialogue: 0,0:04:33.98,0:04:35.81,Default,,0,0,0,,Қараңғы жалын шебері
Dialogue: 0,0:04:36.44,0:04:37.56,Default,,0,0,0,,Шулы!
Dialogue: 0,0:04:38.36,0:04:40.82,Default,,0,0,0,,Орта мектеп өмірімен таныс
Dialogue: 0,0:04:40.90,0:04:43.99,Default,,0,0,0,,Мен бұл нағыз chuunibyou ауруымен күресуге үйрендім.
Dialogue: 0,0:04:44.70,0:04:46.45,Default,,0,0,0,,Юта~
Dialogue: 0,0:04:46.53,0:04:47.37,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:04:47.82,0:04:50.87,Default,,0,0,0,,Кузуха да, Юмеха да жануарларды жақсы көреді.
Dialogue: 0,0:04:50.95,0:04:53.91,Default,,0,0,0,,Анам мені кешірер деп ойлаймын.
Dialogue: 0,0:04:54.00,0:04:56.12,Default,,0,0,0,,Мен сені тыңдайтын адаммын
Dialogue: 0,0:04:56.83,0:04:59.34,Default,,0,0,0,,Юта - бұл ...
Dialogue: 0,0:05:00.04,0:05:02.55,Default,,0,0,0,,Ютаның әкесі ше?
Dialogue: 0,0:05:02.63,0:05:04.76,Default,,0,0,0,,Джакартада жалғыз
Dialogue: 0,0:05:04.84,0:05:06.63,Default,,0,0,0,,Ал, бері қарай! Жарыл енді!
Dialogue: 0,0:05:06.72,0:05:07.64,Default,,0,0,0,,Өткенім ашылмауы үшін әлі де сақ болуым керек.
Dialogue: 0,0:05:07.64,0:05:09.60,Default,,0,0,0,,Өткенімді ашпау үшін әлі де сақ болуым керек.
Dialogue: 0,0:05:07.64,0:05:09.60,Default,,0,0,0,,Джакартаны білесіз бе?
Dialogue: 0,0:05:09.60,0:05:09.68,Default,,0,0,0,,Өткенімді ашпау үшін әлі де сақ болуым керек.
Dialogue: 0,0:05:09.68,0:05:10.51,Default,,0,0,0,,Өткенім ашылмауы үшін әлі де сақ болуым керек.
Dialogue: 0,0:05:09.68,0:05:10.51,Default,,0,0,0,,Бұл картоп сөзінің шығу тегі.
Dialogue: 0,0:05:10.51,0:05:11.14,Default,,0,0,0,,Бұл картоп сөзінің шығу тегі.
Dialogue: 0,0:05:11.22,0:05:14.18,Default,,0,0,0,,Кем дегенде, мен сыныпқа оқиғасыз араласып жатырмын.
Dialogue: 0,0:05:14.18,0:05:15.35,Default,,0,0,0,,Кем дегенде, мен сыныпқа оқиғасыз араласып жатырмын.
Dialogue: 0,0:05:14.18,0:05:15.35,Default,,0,0,0,,Кітапханашы
Dialogue: 0,0:05:15.35,0:05:15.77,Default,,0,0,0,,Кітапханашы
Dialogue: 0,0:05:15.85,0:05:18.27,Default,,0,0,0,,Мен Хираката мырзадан сұрауды жөн көрдім.
Dialogue: 0,0:05:18.86,0:05:21.52,Default,,0,0,0,,Өйткені оны ең ойнақы Исшики ұсынған.
Dialogue: 0,0:05:21.61,0:05:24.44,Default,,0,0,0,,Комитет төрағасы болу қателік болды.
Dialogue: 0,0:05:24.53,0:05:27.41,Default,,0,0,0,,Ақырында, бәрі жақсы...
Dialogue: 0,0:05:27.99,0:05:29.78,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:05:30.41,0:05:35.29,Default,,0,0,0,,Иә, еңбектеріңіз үшін рахмет. Сонымен, үй бөлмесі аяқталды.
Dialogue: 0,0:05:35.37,0:05:38.37,Default,,0,0,0,,Еңбегіңізге рахмет, төраға.
Dialogue: 0,0:05:38.46,0:05:39.75,Default,,0,0,0,,Қай ауыз сөйлейді
Dialogue: 0,0:05:39.83,0:05:43.46,Default,,0,0,0,,Одан бөлек, кімге дауыс беретініңді шештің бе?
Dialogue: 0,0:05:43.55,0:05:45.13,Default,,0,0,0,,Мен жалпы ... есебін жүргізгім келеді.
Dialogue: 0,0:05:45.21,0:05:46.05,Default,,0,0,0,,Дауыс беру керек пе?
Dialogue: 0,0:05:46.84,0:05:49.59,Default,,0,0,0,,Бұл Кавайко-чан чемпионаты, мен саған айттым.
Dialogue: 0,0:05:49.68,0:05:52.97,Default,,0,0,0,,Сыныптағы бірінші қызды ұлдар дауыс беру арқылы анықтайды.
Dialogue: 0,0:05:53.06,0:05:54.52,Default,,0,0,0,,Кім?
Dialogue: 0,0:05:55.27,0:05:59.52,Default,,0,0,0,,Жарайсың ба? Солай істеп ұсталсаң қыздың ашуы шығады.
Dialogue: 0,0:05:59.60,0:06:00.94,Default,,0,0,0,,Анықталған жоқ
Dialogue: 0,0:06:01.02,0:06:04.40,Default,,0,0,0,,Осындай кездерде адамдар арасындағы байланыс тастан да күшті болады.
Dialogue: 0,0:06:04.48,0:06:05.36,Default,,0,0,0,,Тоғаши-кун
Dialogue: 0,0:06:05.44,0:06:07.28,Default,,0,0,0,,О, а... иә! Ах...
Dialogue: 0,0:06:07.36,0:06:09.57,Default,,0,0,0,,Ғылыми кабинет Түскі үзіліс жасауға бола ма?
Dialogue: 0,0:06:10.57,0:06:14.12,Default,,0,0,0,,Жаратылыстану пәнінің мұғалімі мұны істеуді сұрады, солай ма? Жабдықты тексеру
Dialogue: 0,0:06:15.41,0:06:19.92,Default,,0,0,0,,7… 8… 9… 10… 12 дана
Dialogue: 0,0:06:20.00,0:06:21.92,Default,,0,0,0,,12t
Dialogue: 0,0:06:22.00,0:06:25.09,Default,,0,0,0,,Иә, бұл қадамның соңы.
Dialogue: 0,0:06:26.59,0:06:29.72,Default,,0,0,0,,Бұл иіс... Азиялықтар ма әлде Педаль Сасун ба?
Dialogue: 0,0:06:29.80,0:06:31.80,Default,,0,0,0,,Сіз әлі де сынып өкілі болуға үйрендіңіз бе?
Dialogue: 0,0:06:31.89,0:06:35.43,Default,,0,0,0,,Не? Иә, мен әлі де сенімді емеспін...
Dialogue: 0,0:06:36.27,0:06:38.94,Default,,0,0,0,,Егер бірдеңе байқасаңыз, маған хабарлаңыз.
Dialogue: 0,0:06:39.02,0:06:42.65,Default,,0,0,0,,Мен көп нәрсені ұмытуға бейіммін.
Dialogue: 0,0:06:42.73,0:06:45.86,Default,,0,0,0,,Мен солай ойлаймын, бірақ мен оны мүлде көрмеймін.
Dialogue: 0,0:06:45.94,0:06:49.82,Default,,0,0,0,,Мен олай болып көрінбес үшін, өзімді берік етіп көрсетуге тырысамын.
Dialogue: 0,0:06:50.28,0:06:51.95,Default,,0,0,0,,Мен төрағамын.
Dialogue: 0,0:06:53.78,0:06:58.00,Default,,0,0,0,,Ал... Түсіндім, сен сабырлы сияқтысың.
Dialogue: 0,0:06:58.54,0:07:00.79,Default,,0,0,0,,Сіз талай рет төраға болдыңыз, солай емес пе?
Dialogue: 0,0:07:00.87,0:07:04.88,Default,,0,0,0,,Хмм, жақсы, бірақ бұл ұсынылды.
Dialogue: 0,0:07:04.96,0:07:06.96,Default,,0,0,0,,Тоғашы-күн де ​​көп емес пе?
Dialogue: 0,0:07:07.05,0:07:09.88,Default,,0,0,0,,Мен? Жоқ, жоқ
Dialogue: 0,0:07:09.97,0:07:13.22,Default,,0,0,0,,Менің ойымша, бұл бір рет бастауыш мектепте оқып жүргенімде болды.
Dialogue: 0,0:07:13.30,0:07:15.97,Default,,0,0,0,,Бірдеңе болса, ол азырақ байқалды.
Dialogue: 0,0:07:16.06,0:07:19.10,Default,,0,0,0,,Шынымен бе? Менің ойымша, олар өте ұқсас
Dialogue: 0,0:07:19.18,0:07:21.52,Default,,0,0,0,,Мен сені алғаш көргенде...
Dialogue: 0,0:07:21.60,0:07:24.44,Default,,0,0,0,,Қараңызшы, біз кіру салтанаты күні вокзалда кездестік.
Dialogue: 0,0:07:26.15,0:07:26.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:34.57,0:07:35.95,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:07:36.03,0:07:38.62,Default,,0,0,0,,Неліктен? Бұл анық емес
Dialogue: 0,0:07:38.70,0:07:40.08,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:07:40.16,0:07:43.08,Default,,0,0,0,,Себебі мен әлі өз сыныбымды немесе есімімді білмедім.
Dialogue: 0,0:07:43.17,0:07:46.75,Default,,0,0,0,,Иә, мен сыныпқа келіп, Тоғаши-кунды көргенде,
Dialogue: 0,0:07:46.84,0:07:48.38,Default,,0,0,0,,«Ой, бұл адам»…
Dialogue: 0,0:07:48.46,0:07:50.76,Default,,0,0,0,,Сонымен... иә... хаха...
Dialogue: 0,0:07:50.84,0:07:54.68,Default,,0,0,0,,Сабыр ет, мен... әлі үрейленетін уақыт емес.
Dialogue: 0,0:07:55.68,0:07:59.35,Default,,0,0,0,,Бірақ, кем дегенде, бұл сіздің бұл туралы ренжімейтініңізді білдіреді.
Dialogue: 0,0:08:01.39,0:08:02.35,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:08:02.85,0:08:05.94,Default,,0,0,0,,Келе ме? Менің артқы кеңеюім
Dialogue: 0,0:08:06.02,0:08:07.77,Default,,0,0,0,,Ал, қалғаны ертең.
Dialogue: 0,0:08:07.86,0:08:09.57,Default,,0,0,0,,Мен сізді шақыруым керек пе?
Dialogue: 0,0:08:09.65,0:08:10.94,Default,,0,0,0,,Менімен бірге үйге барғың келе ме?
Dialogue: 0,0:08:11.03,0:08:13.70,Default,,0,0,0,,Жоқ, күте тұрыңыз, бұл модельдеу.
Dialogue: 0,0:08:14.32,0:08:15.74,Default,,0,0,0,,Реакцияны болжау!
Dialogue: 0,0:08:17.28,0:08:19.04,Default,,0,0,0,,Менімен бірге үйге барғың келе ме?
Dialogue: 0,0:08:20.04,0:08:20.87,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:20.95,0:08:23.96,Default,,0,0,0,,Арх! Мүмкін емес!
Dialogue: 0,0:08:24.04,0:08:25.88,Default,,0,0,0,,Не... Не болды, Тоғашы-күн!
Dialogue: 0,0:08:26.38,0:08:29.55,Default,,0,0,0,,Жоқ... жоқ, бұл ештеңе емес. Менің айтып отырғаным осы...
Dialogue: 0,0:08:29.63,0:08:30.50,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:30.59,0:08:33.13,Default,,0,0,0,,- (Нибутани) Тогаши-кун! -(Юта) Нана Нана Не деген!?
Dialogue: 0,0:08:35.38,0:08:37.14,Default,,0,0,0,,Ахх— бұл мені қатты қорқытты
Dialogue: 0,0:08:37.22,0:08:40.31,Default,,0,0,0,,Бұл сенсің! Бұл қайтадан сенсің!
Dialogue: 0,0:08:40.39,0:08:42.52,Default,,0,0,0,,Ютаның көзі... басы айналып...
Dialogue: 0,0:08:42.60,0:08:43.64,Default,,0,0,0,,Которию мырза...?
Dialogue: 0,0:08:43.73,0:08:47.86,Default,,0,0,0,,- (Рикка) Балалар, мұнда неге келдіңдер? -(Нибутани) Мұғалімнің қалауы бойынша
Dialogue: 0,0:08:47.94,0:08:50.52,Default,,0,0,0,,Аа, мына жігіттің айтқанын елемеуге болады.
Dialogue: 0,0:08:50.61,0:08:53.99,Default,,0,0,0,,Ммм, осы мектепте осындай есірткі бар ма?
Dialogue: 0,0:08:54.07,0:08:57.49,Default,,0,0,0,,Басқару бюросының қызметі осы уақытқа дейін тарай ма?
Dialogue: 0,0:08:57.57,0:09:00.66,Default,,0,0,0,,- (Рикка) Уф... - (Юта) Болды, ақ халатыңды шеш.
Dialogue: 0,0:09:00.74,0:09:01.95,Default,,0,0,0,,Бұл сен емессің.
Dialogue: 0,0:09:02.04,0:09:02.87,Default,,0,0,0,,Оны шешіңіз бе?
Dialogue: 0,0:09:02.95,0:09:04.91,Default,,0,0,0,,О, қазір шешіп таста.
Dialogue: 0,0:09:05.41,0:09:07.63,Default,,0,0,0,,Оны қазір шешкенімді қалайсың ба?
Dialogue: 0,0:09:07.71,0:09:09.46,Default,,0,0,0,,Сіз мұны әдейі істеп жатырсыз ба?
Dialogue: 0,0:09:09.54,0:09:11.38,Default,,0,0,0,,Рұқсатсыз дәріге қол сұғуға болмайды.
Dialogue: 0,0:09:11.46,0:09:15.13,Default,,0,0,0,,Өкінішке орай, Кимера нақты әлемде аман қалу үшін,
Dialogue: 0,0:09:15.22,0:09:16.88,Default,,0,0,0,,Сиқырлы күш жеткіліксіз
Dialogue: 0,0:09:16.97,0:09:20.39,Default,,0,0,0,,Жасанды түрде жасалуы және қамтамасыз етілуі қажет
Dialogue: 0,0:09:20.47,0:09:23.81,Default,,0,0,0,,- (Нибутани) Кимера? -(Юта) Ой, ол үшін уайымдама.
Dialogue: 0,0:09:23.89,0:09:27.10,Default,,0,0,0,,Маңдайында осындай ою бар сұр мысық.
Dialogue: 0,0:09:27.56,0:09:30.27,Default,,0,0,0,,Которию-сан оны кеше алғанын айтты.
Dialogue: 0,0:09:30.90,0:09:32.90,Default,,0,0,0,,Коториюмен емес, Риккамен...
Dialogue: 0,0:09:33.61,0:09:37.03,Default,,0,0,0,,Сұр мысық? Ойланып көрейікші
Dialogue: 0,0:09:37.11,0:09:38.57,Default,,0,0,0,,- (Юта) Әй? -(Рикка) А?
Dialogue: 0,0:09:39.91,0:09:42.03,Default,,0,0,0,,Не? Бұл шынымен жаман ба?
Dialogue: 0,0:09:42.12,0:09:44.29,Default,,0,0,0,,Бұл басқаша болуы мүмкін.
Dialogue: 0,0:09:44.37,0:09:47.29,Default,,0,0,0,,Мұнда жазылған сипаттамалар негізінен сәйкес келеді.
Dialogue: 0,0:09:47.37,0:09:51.09,Default,,0,0,0,,Көлемі шамамен осы, ал бөксесі мынадай...
Dialogue: 0,0:09:51.17,0:09:54.21,Default,,0,0,0,,- (Рикка) Менің арқамда қанаттар бар... - (Юта) Олардың қанаттары жоқ.
Dialogue: 0,0:09:54.30,0:09:55.30,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,0:09:55.76,0:09:59.26,Default,,0,0,0,,Менің мысығым да солай болғанына сенімдімін.
Dialogue: 0,0:09:59.34,0:10:01.68,Default,,0,0,0,,- (Рикка) Цубаса? -(Юта) Жарайды, үндеме.
Dialogue: 0,0:10:01.76,0:10:02.93,Default,,0,0,0,,Уау
Dialogue: 0,0:10:03.01,0:10:04.81,Default,,0,0,0,,Қашаннан бері жоғалып кеттіңіз?
Dialogue: 0,0:10:05.27,0:10:08.56,Default,,0,0,0,,Хмм, шамамен бір апта бұрын?
Dialogue: 0,0:10:08.64,0:10:09.90,Default,,0,0,0,,Сен оны көруге келесің бе?
Dialogue: 0,0:10:09.98,0:10:12.15,Default,,0,0,0,,-Жарайды ма? -(Юта) Иә.
Dialogue: 0,0:10:13.02,0:10:16.07,Default,,0,0,0,,Ым, бұл Гогацу ма... Сенпай?
Dialogue: 0,0:10:16.15,0:10:19.11,Default,,0,0,0,,Ах, сондықтан ол «Цююри» деп айтылады
Dialogue: 0,0:10:19.20,0:10:22.33,Default,,0,0,0,,Бұл 7 мамырдағы Кумин. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:10:22.41,0:10:25.70,Default,,0,0,0,,А... м, бұл Юта Тогаши.
Dialogue: 0,0:10:25.79,0:10:26.62,Default,,0,0,0,,Хмм
Dialogue: 0,0:10:26.70,0:10:27.62,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:10:32.17,0:10:35.76,Default,,0,0,0,,Менің үйім екінші қабатта, ал Коториюдің үйі оның үстінде.
Dialogue: 0,0:10:35.84,0:10:37.97,Default,,0,0,0,,- (Рикка) Рикка және... - (Юта) Шулы
Dialogue: 0,0:10:38.05,0:10:42.09,Default,,0,0,0,,Біз жақсы доспыз, солай ма? Балалық шақтағы достар?
Dialogue: 0,0:10:42.18,0:10:45.43,Default,,0,0,0,,А, жоқ... Которию-сан кеше ғана осында көшіп келді.
Dialogue: 0,0:10:45.51,0:10:46.77,Default,,0,0,0,,- (Рикка) Тыныш! -(Юта) А?
Dialogue: 0,0:10:47.52,0:10:49.85,Default,,0,0,0,,- (Рикка) Ммм... -Аа...
Dialogue: 0,0:10:52.52,0:10:54.44,Default,,0,0,0,,Сиқырлы кодты шығару
Dialogue: 0,0:10:54.52,0:10:55.73,Default,,0,0,0,,Иә...
Dialogue: 0,0:10:55.82,0:10:57.78,Default,,0,0,0,,Жарайды, тез ашыңыз.
Dialogue: 0,0:10:57.86,0:10:59.36,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:11:03.53,0:11:05.79,Default,,0,0,0,,Ашық... Ақыры ашылды!
Dialogue: 0,0:11:05.87,0:11:07.45,Default,,0,0,0,,Қандай қиын жігіт.
Dialogue: 0,0:11:07.54,0:11:08.95,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:11:09.87,0:11:12.88,Default,,0,0,0,,Бөлмеңізде әдеттен тыс нәрсе бар-жоғын зерттеңіз.
Dialogue: 0,0:11:14.09,0:11:16.96,Default,,0,0,0,,Кенеттен кіріп кеткеніме менің кінәм болды.
Dialogue: 0,0:11:17.05,0:11:18.46,Default,,0,0,0,,Өйткені ол қыз
Dialogue: 0,0:11:19.05,0:11:22.47,Default,,0,0,0,,- (Рикка) Сіз кіре аласыз. - (Юта/Кумин) Мен сізді мазалаймын.
Dialogue: 0,0:11:22.55,0:11:24.72,Default,,0,0,0,,-Ой, ғажап -(Юта) Ой!
Dialogue: 0,0:11:25.72,0:11:27.68,Default,,0,0,0,,Егер біз Диоға бет алсақ, әпкемнің жауымен кездесуіміз анық.
Dialogue: 0,0:11:29.06,0:11:31.73,Default,,0,0,0,,Darkside сайтына қош келдіңіз
Dialogue: 0,0:11:31.81,0:11:34.48,Default,,0,0,0,,Хаотикалық хаосқа қош келдіңіз
Dialogue: 0,0:11:34.56,0:11:36.94,Default,,0,0,0,,Себебі оның мағынасы көп.
Dialogue: 0,0:11:37.02,0:11:38.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:38.69,0:11:41.40,Default,,0,0,0,,Менің ойымша, саған сүйкімді тұлыптар ұнайды.
Dialogue: 0,0:11:41.49,0:11:43.57,Default,,0,0,0,,Сол адам солтүстікті қорғайтын Генбу.
Dialogue: 0,0:11:44.20,0:11:45.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:45.62,0:11:50.25,Default,,0,0,0,,Маузер әскери! Сізде таңқаларлық жақсы хобби бар!
Dialogue: 0,0:11:50.87,0:11:53.58,Default,,0,0,0,,Жындарды жоя алатын қасиетті мылтық
Dialogue: 0,0:11:53.67,0:11:56.13,Default,,0,0,0,,Ой, солай сезіледі.
Dialogue: 0,0:11:56.21,0:11:57.59,Default,,0,0,0,,Мен оны көре аламын ба?
Dialogue: 0,0:11:57.67,0:11:59.67,Default,,0,0,0,,- (Рикка) Жақсы - (Юта) Хехе
Dialogue: 0,0:12:00.42,0:12:02.72,Default,,0,0,0,,Бұл өте керемет, Маузер!
Dialogue: 0,0:12:02.80,0:12:05.51,Default,,0,0,0,,Гагагагагага... Гакюн!
Dialogue: 0,0:12:05.59,0:12:06.89,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:07.76,0:12:10.14,Default,,0,0,0,,А, мылтық.
Dialogue: 0,0:12:10.22,0:12:12.69,Default,,0,0,0,,Шынайы нәрсе - 100 жылдан астам бұрын жасалған таңғажайып мылтық.
Dialogue: 0,0:12:12.77,0:12:16.52,Default,,0,0,0,,А, жоқ... бұл M712 деп аталатын түрі.
Dialogue: 0,0:12:16.61,0:12:19.40,Default,,0,0,0,,Тогаши-кун, саған ондай нәрсе ұнайды.
Dialogue: 0,0:12:19.48,0:12:20.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:20.19,0:12:21.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:20.19,0:12:21.03,Default,,0,0,0,,Айтпақшы, бұл бөлмедегі барлық заттар
Dialogue: 0,0:12:21.03,0:12:23.03,Default,,0,0,0,,Айтпақшы, бұл бөлмедегі барлық заттар
Dialogue: 0,0:12:23.11,0:12:26.24,Default,,0,0,0,,Астрологиялық ережелерге сәйкес орналастырылған
Dialogue: 0,0:12:26.32,0:12:30.29,Default,,0,0,0,,Қозғалуға қатаң тыйым салынады, сондықтан оны тазалаудың қажеті жоқ.
Dialogue: 0,0:12:34.92,0:12:35.92,Default,,0,0,0,,Өрт!
Dialogue: 0,0:12:36.50,0:12:38.59,Default,,0,0,0,,Сонымен мысықтар ше?
Dialogue: 0,0:12:38.67,0:12:42.38,Default,,0,0,0,,Көпшілікке көрінбейтін шаралар қабылданды.
Dialogue: 0,0:12:42.47,0:12:44.43,Default,,0,0,0,,Сен менің ағамсың, сондықтан құрметті тілмен айт.
Dialogue: 0,0:12:44.51,0:12:46.80,Default,,0,0,0,,А, жарайды, жарайды.
Dialogue: 0,0:12:46.89,0:12:49.14,Default,,0,0,0,,Уау! о?
Dialogue: 0,0:12:49.22,0:12:52.35,Default,,0,0,0,,О, сен бөлмеге араласып кеттің.
Dialogue: 0,0:12:52.43,0:12:54.10,Default,,0,0,0,,Сіз мұны көре аласыз ба?
Dialogue: 0,0:12:54.19,0:12:56.15,Default,,0,0,0,,Істі қиындатпаңыз
Dialogue: 0,0:12:56.94,0:12:58.15,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:12:58.23,0:13:03.24,Default,,0,0,0,,Мм, өкінішке орай, сіз басқа адам сияқтысыз. Сіздің сақалыңыздың пішіні әртүрлі.
Dialogue: 0,0:13:03.32,0:13:04.65,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:04.74,0:13:05.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:06.95,0:13:08.45,Default,,0,0,0,,Бұл кімнің мысығы?
Dialogue: 0,0:13:08.53,0:13:09.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:10.03,0:13:11.41,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:13.83,0:13:14.96,Default,,0,0,0,,Кімнің...
Dialogue: 0,0:13:23.80,0:13:25.30,Default,,0,0,0,,Бұл кімнің мысығы?
Dialogue: 0,0:13:27.84,0:13:30.01,Default,,0,0,0,,Герметикалық қалқа жабық!
Dialogue: 0,0:13:30.68,0:13:32.68,Default,,0,0,0,,Радиациядан қорғайтын қабырғаға су айдау!
Dialogue: 0,0:13:33.31,0:13:34.39,Default,,0,0,0,,Барлық мүшелер қашып кетеді!
Dialogue: 0,0:13:34.48,0:13:35.56,Default,,0,0,0,,Не!? (Кимераның жылағаны)
Dialogue: 0,0:13:37.23,0:13:39.10,Default,,0,0,0,,Дөңгелек…
Dialogue: 0,0:13:39.19,0:13:40.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:42.57,0:13:44.15,Default,,0,0,0,,(Төменгі терезенің ашылған дыбысы)
Dialogue: 0,0:13:44.24,0:13:47.03,Default,,0,0,0,,(шу)
Dialogue: 0,0:13:47.66,0:13:48.66,Default,,0,0,0,,Менің бөлмем!?
Dialogue: 0,0:13:48.74,0:13:50.03,Default,,0,0,0,,(Химераның айқайы)
Dialogue: 0,0:13:50.12,0:13:52.03,Default,,0,0,0,,Хахахахаха…
Dialogue: 0,0:13:52.12,0:13:53.08,Default,,0,0,0,,- (Юта) О! -Ах!
Dialogue: 0,0:13:53.87,0:13:55.79,Default,,0,0,0,,Сен біреудің бөлмесінде не істеп жүрсің?
Dialogue: 0,0:13:55.87,0:13:56.83,Default,,0,0,0,,Жақында аяқталады
Dialogue: 0,0:13:56.91,0:13:59.12,Default,,0,0,0,,А, дуэль шығар!?
Dialogue: 0,0:13:59.21,0:14:00.75,Default,,0,0,0,,Көңіліңізді көтермеңіз
Dialogue: 0,0:14:00.84,0:14:04.21,Default,,0,0,0,,Бір күні еңсеру керек қабырға
Dialogue: 0,0:14:07.38,0:14:09.93,Default,,0,0,0,,Шварцшильд толық дроссель!
Dialogue: 0,0:14:10.97,0:14:12.64,Default,,0,0,0,,Хааааааааааа!
Dialogue: 0,0:14:19.90,0:14:23.32,Default,,0,0,0,,О, ой, ой!
Dialogue: 0,0:14:24.69,0:14:25.82,Default,,0,0,0,,(Тақтаның сынған дыбысы)
Dialogue: 0,0:14:25.90,0:14:29.32,Default,,0,0,0,,А-а-а...
Dialogue: 0,0:14:29.41,0:14:31.41,Default,,0,0,0,,Avalon Smart…
Dialogue: 0,0:14:31.49,0:14:32.99,Default,,0,0,0,,Уф
Dialogue: 0,0:14:33.08,0:14:35.95,Default,,0,0,0,,А... а... а
Dialogue: 0,0:14:39.04,0:14:41.25,Default,,0,0,0,,-(Тока) Бұл Юта Тогаши. -(Юта) Аа...
Dialogue: 0,0:14:42.17,0:14:45.75,Default,,0,0,0,,Мен Тока Коториюмын, бұл жігіттің әпкесі.
Dialogue: 0,0:14:46.67,0:14:48.13,Default,,0,0,0,,Менің бір оқиғам бар.
Dialogue: 0,0:14:50.05,0:14:52.60,Default,,0,0,0,,Мен бұл Джау Шинген ме, әлде не екенін білмеймін.
Dialogue: 0,0:14:52.68,0:14:55.06,Default,,0,0,0,,Орта мектептен бері мүлде өзгерген жоқ.
Dialogue: 0,0:14:55.14,0:14:56.77,Default,,0,0,0,,Онда адамдар бар. Екеуі.
Dialogue: 0,0:14:57.31,0:15:00.02,Default,,0,0,0,,Ал менің мысықтарға аллергиям бар.
Dialogue: 0,0:15:00.10,0:15:02.40,Default,,0,0,0,,Мен бірдеңе айтсам, бірден көтеріп аламын.
Dialogue: 0,0:15:02.48,0:15:04.19,Default,,0,0,0,,Қатты қолайсыздық
Dialogue: 0,0:15:04.27,0:15:05.98,Default,,0,0,0,,Кешіріңіз, бірақ сізден бір нәрсе сұрасам болады ма?
Dialogue: 0,0:15:06.07,0:15:06.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:06.98,0:15:11.57,Default,,0,0,0,,Бұл мысық. Маған тимеңіз. Бұл туралы бірдеңе істегеніңізді қалаймын.
Dialogue: 0,0:15:11.66,0:15:13.49,Default,,0,0,0,,Мен оны тастасам да, біреуге берсем де
Dialogue: 0,0:15:13.57,0:15:14.91,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:15:14.99,0:15:17.16,Default,,0,0,0,,Мен оны мұнда қоя алмаймын. Міне бітті.
Dialogue: 0,0:15:17.24,0:15:20.91,Default,,0,0,0,,Ал, бірақ мен...?
Dialogue: 0,0:15:21.00,0:15:22.42,Default,,0,0,0,,Сізге бұл ұнамайды ма?
Dialogue: 0,0:15:22.50,0:15:24.00,Default,,0,0,0,,Маған ұнамайды...
Dialogue: 0,0:15:25.00,0:15:26.55,Default,,0,0,0,,Олай болса, сұраңыз.
Dialogue: 0,0:15:27.46,0:15:28.55,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:15:28.63,0:15:32.05,Default,,0,0,0,,Бұл дыбыс жазу құрылғысы екі жыл бұрын орнатылған.
Dialogue: 0,0:15:32.13,0:15:34.55,Default,,0,0,0,,Бұл тұрғын үй кешенінің балконында жазылған.
Dialogue: 0,0:15:34.64,0:15:35.64,Default,,0,0,0,,(қосылған қосқыштың дыбысы)
Dialogue: 0,0:15:35.72,0:15:40.39,Default,,0,0,0,,Хехехе... Хахахаха!
Dialogue: 0,0:15:40.48,0:15:43.73,Default,,0,0,0,,Бұл пьеса да, арман да емес!
Dialogue: 0,0:15:43.81,0:15:46.57,Default,,0,0,0,,Бұл дүние 2012 жылы Майя пайғамбарлықтары бойынша...
Dialogue: 0,0:15:47.07,0:15:48.07,Default,,0,0,0,,Хм/сағ
Dialogue: 0,0:15:47.07,0:15:48.07,Default,,0,0,0,,Қараңғылық әлеміне тартылу
Dialogue: 0,0:15:48.07,0:15:48.15,Default,,0,0,0,,Сіз қараңғылық әлеміне сүйрейсіз.
Dialogue: 0,0:15:48.15,0:15:50.03,Default,,0,0,0,,Қараңғылық әлеміне тартылу
Dialogue: 0,0:15:48.15,0:15:50.03,Default,,0,0,0,,Тогаши-кун, не болды?
Dialogue: 0,0:15:50.11,0:15:51.28,Default,,0,0,0,,Үлкен аға, не болды?
Dialogue: 0,0:15:51.36,0:15:51.82,Default,,0,0,0,,Менің ағам емес!
Dialogue: 0,0:15:51.82,0:15:53.03,Default,,0,0,0,,Менің ағам емес!
Dialogue: 0,0:15:51.82,0:15:53.03,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:15:53.11,0:15:55.53,Default,,0,0,0,,Менің атым Қараңғы жалын шебері
Dialogue: 0,0:15:55.62,0:15:57.28,Default,,0,0,0,,(Дыбыс деңгейін арттыру)
Dialogue: 0,0:15:55.62,0:15:57.28,Default,,0,0,0,,Қараңғы отты қолданушы ретінде
Dialogue: 0,0:15:57.37,0:15:59.95,Default,,0,0,0,,Ах! Бұл Тогаши-кунның дауысы ма?
Dialogue: 0,0:15:57.37,0:15:59.95,Default,,0,0,0,,Бұл дүниені өртейтін нәрсе
Dialogue: 0,0:16:00.04,0:16:02.41,Default,,0,0,0,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:16:00.04,0:16:02.41,Default,,0,0,0,,Ой... Уау! Өтінемін тоқта!
Dialogue: 0,0:16:02.41,0:16:03.87,Default,,0,0,0,,Ой... Уау! Өтінемін тоқта!
Dialogue: 0,0:16:03.96,0:16:06.25,Default,,0,0,0,,Тоқта, тоқта! Мен оны естігім келмейді!
Dialogue: 0,0:16:03.96,0:16:06.25,Default,,0,0,0,,Бүгін жел шулы.
Dialogue: 0,0:16:06.34,0:16:07.71,Default,,0,0,0,,Біз есімізді жоғалтқан болармыз, иә?
Dialogue: 0,0:16:06.34,0:16:07.71,Default,,0,0,0,,Мен мұны естігім келмейді!
Dialogue: 0,0:16:07.71,0:16:07.80,Default,,0,0,0,,Мен мұны естігім келмейді!
Dialogue: 0,0:16:07.80,0:16:08.42,Default,,0,0,0,,Мен мұны естігім келмейді!
Dialogue: 0,0:16:07.80,0:16:08.42,Default,,0,0,0,,Жел соқпайды.
Dialogue: 0,0:16:08.42,0:16:08.50,Default,,0,0,0,,Жел соқпайды.
Dialogue: 0,0:16:08.50,0:16:09.63,Default,,0,0,0,,Жел соқпайды.
Dialogue: 0,0:16:08.50,0:16:09.63,Default,,0,0,0,,(Дыбыс деңгейін арттыру)
Dialogue: 0,0:16:09.63,0:16:09.71,Default,,0,0,0,,(Дыбыс деңгейін арттыру)
Dialogue: 0,0:16:09.71,0:16:10.88,Default,,0,0,0,,(Дыбыс деңгейін арттыру)
Dialogue: 0,0:16:09.71,0:16:10.88,Default,,0,0,0,,Толып... Қуат толып...
Dialogue: 0,0:16:10.88,0:16:11.67,Default,,0,0,0,,Толып жатыр... Қуат толып...
Dialogue: 0,0:16:11.76,0:16:14.30,Default,,0,0,0,,Уау!!
Dialogue: 0,0:16:14.30,0:16:15.55,Default,,0,0,0,,Уау!!
Dialogue: 0,0:16:14.30,0:16:15.55,Default,,0,0,0,,Ондай қатты дыбыс шығарма
Dialogue: 0,0:16:15.55,0:16:16.18,Default,,0,0,0,,Ондай қатты дыбыс шығармаңыз
Dialogue: 0,0:16:16.18,0:16:17.05,Default,,0,0,0,,Ондай қатты дыбыс шығармаңыз
Dialogue: 0,0:16:16.18,0:16:17.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:17.14,0:16:18.14,Default,,0,0,0,,Барлығы күліп жатыр
Dialogue: 0,0:16:18.22,0:16:19.39,Default,,0,0,0,,Хмм, ақымақ адамдар
Dialogue: 0,0:16:19.39,0:16:19.97,Default,,0,0,0,,Хмм, ақымақ адамдар.
Dialogue: 0,0:16:19.39,0:16:19.97,Default,,0,0,0,,Менің хоббиім - күлкілі видео сайттарда жариялау.
Dialogue: 0,0:16:19.97,0:16:20.06,Default,,0,0,0,,Менің хоббиім - күлкілі видео сайттарда жариялау.
Dialogue: 0,0:16:20.06,0:16:22.02,Default,,0,0,0,,Менің хоббиім күлкілі видео сайттарда жариялау.
Dialogue: 0,0:16:20.06,0:16:22.02,Default,,0,0,0,,Оларды жай ғана күлдіріңіз...
Dialogue: 0,0:16:22.02,0:16:23.81,Default,,0,0,0,,Менің хоббиім күлкілі видео сайттарда жариялау.
Dialogue: 0,0:16:24.56,0:16:25.85,Default,,0,0,0,,Кимоноым шаңмен кірленді.
Dialogue: 0,0:16:26.52,0:16:27.36,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:27.44,0:16:29.27,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:16:29.36,0:16:30.57,Default,,0,0,0,,Ах
Dialogue: 0,0:16:31.11,0:16:32.57,Default,,0,0,0,,Сіз қашып кеттіңіз бе?
Dialogue: 0,0:16:34.91,0:16:37.20,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:16:43.25,0:16:45.17,Default,,0,0,0,,Ха ха ха ха...
Dialogue: 0,0:16:45.25,0:16:49.17,Default,,0,0,0,,Әке, ана, өтінемін, кешірімсіз болғаным үшін!
Dialogue: 0,0:16:49.25,0:16:53.26,Default,,0,0,0,,Тоғашы-күн, менімен бірге ақырзаманға қашайық.
Dialogue: 0,0:16:53.34,0:16:54.68,Default,,0,0,0,,Мен байсалдымын.
Dialogue: 0,0:16:54.76,0:16:57.43,Default,,0,0,0,,Дүниенің ақыры осында!
Dialogue: 0,0:16:57.51,0:17:00.72,Default,,0,0,0,,Өйткені жер дөңгелек!
Dialogue: 0,0:17:00.81,0:17:03.64,Default,,0,0,0,,Сен не істеп жүрсің! Тука-сан ашуланды.
Dialogue: 0,0:17:03.73,0:17:07.90,Default,,0,0,0,,Тез қашыңыз, ол басқару бюросының бірінші дәрежелі діни қызметкері.
Dialogue: 0,0:17:08.44,0:17:10.27,Default,,0,0,0,,Бұл күш керемет
Dialogue: 0,0:17:17.70,0:17:19.53,Default,,0,0,0,,Ха~хахаха~!
Dialogue: 0,0:17:19.62,0:17:24.25,Default,,0,0,0,,Сол жаңа қанның барлығын шынжырлы құрбандық ретінде ұсын!
Dialogue: 0,0:17:24.33,0:17:25.87,Default,,0,0,0,,Қанды түрме!
Dialogue: 0,0:17:26.46,0:17:27.46,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:17:27.54,0:17:28.46,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:17:28.92,0:17:32.34,Default,,0,0,0,,Лездік қозғалысты басқаратын қорқынышты қабілет
Dialogue: 0,0:17:32.42,0:17:35.13,Default,,0,0,0,,Мүмкін сіз жай ғана ақымақ болған шығарсыз?
Dialogue: 0,0:17:35.22,0:17:36.63,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:17:37.13,0:17:38.14,Default,,0,0,0,,Ол қазірдің өзінде бар!
Dialogue: 0,0:17:38.22,0:17:41.10,Default,,0,0,0,,Бұл қорқынышты фильм сияқты қызықты.
Dialogue: 0,0:17:41.18,0:17:42.64,Default,,0,0,0,,- (Рикка) Хмм... - (Юта) Бұл қызық емес!
Dialogue: 0,0:17:45.31,0:17:47.98,Default,,0,0,0,,А, енді бірдеңе жарқырайды!
Dialogue: 0,0:17:48.06,0:17:49.02,Default,,0,0,0,,Эй!
Dialogue: 0,0:17:49.10,0:17:50.90,Default,,0,0,0,,Ах! 7 мамыр!
Dialogue: 0,0:17:50.98,0:17:52.44,Default,,0,0,0,,Фуя~
Dialogue: 0,0:17:52.98,0:17:54.03,Default,,0,0,0,,Юта! Асығыңыз!
Dialogue: 0,0:17:54.11,0:17:55.78,Default,,0,0,0,,Ах! Ха ха...
Dialogue: 0,0:18:01.95,0:18:02.79,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:18:02.87,0:18:06.62,Default,,0,0,0,,Не айтайын, өміріме қауіп төніп тұрғандай сезінемін.
Dialogue: 0,0:18:06.71,0:18:11.04,Default,,0,0,0,,Өкінішке орай, менде діни қызметкерді жеңуге мүмкіндік жоқ.
Dialogue: 0,0:18:11.63,0:18:14.67,Default,,0,0,0,,Бірақ сайып келгенде, біз қарсыласты жеңуіміз керек.
Dialogue: 0,0:18:16.17,0:18:18.18,Default,,0,0,0,,- (Рикка) Мынаны ал да, жүре бер - А?
Dialogue: 0,0:18:18.26,0:18:21.43,Default,,0,0,0,,Осы шайқас біткен соң, бірге өмір сүрейік.
Dialogue: 0,0:18:21.51,0:18:23.56,Default,,0,0,0,,Өлім жалауын қоймаңыз!
Dialogue: 0,0:18:23.64,0:18:27.06,Default,,0,0,0,,Юта тез қаш, мен сені осы жерден тоқтатамын.
Dialogue: 0,0:18:27.14,0:18:28.69,Default,,0,0,0,,Ендеше сен бірінші бар!
Dialogue: 0,0:18:28.77,0:18:29.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:30.65,0:18:34.32,Default,,0,0,0,,Мен көрінбейтін шекараны табуым керек...
Dialogue: 0,0:18:34.40,0:18:35.57,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:18:37.69,0:18:39.03,Default,,0,0,0,,Құс ойыны...
Dialogue: 0,0:18:40.36,0:18:42.20,Default,,0,0,0,,Мені Рикка деп атаңыз
Dialogue: 0,0:18:42.28,0:18:44.95,Default,,0,0,0,,- (Юта) Жоқ, Кимерага... - (Рикка) Уау, уау!
Dialogue: 0,0:18:46.20,0:18:47.20,Default,,0,0,0,,Онда?
Dialogue: 0,0:18:47.29,0:18:48.66,Default,,0,0,0,,Мен тартамын
Dialogue: 0,0:18:48.75,0:18:50.54,Default,,0,0,0,,- (Рикка) Юта - Кимера! -(Юта) Иә?
Dialogue: 0,0:18:52.58,0:18:53.67,Default,,0,0,0,,Шық!
Dialogue: 0,0:18:53.75,0:18:56.88,Default,,0,0,0,,Schwarzzechs Prototype Mk II (Марк Екі)!
Dialogue: 0,0:18:57.97,0:18:58.88,Default,,0,0,0,,Жарып жіберіңіз, бұл шын!
Dialogue: 0,0:18:58.97,0:19:00.51,Default,,0,0,0,,Өрт синапсы!
Dialogue: 0,0:19:00.59,0:19:04.35,Default,,0,0,0,,Бұл әлемді қуу!
Dialogue: 0,0:19:10.77,0:19:14.69,Default,,0,0,0,,Қан келісімі бойынша мен сізді шақырамын.
Dialogue: 0,0:19:20.70,0:19:22.74,Default,,0,0,0,,Königinde Anacht
Dialogue: 0,0:19:37.80,0:19:40.26,Default,,0,0,0,,Қараңғы заттың жалындауы!
Dialogue: 0,0:19:53.48,0:19:54.31,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:55.81,0:19:56.98,Default,,0,0,0,,Кішкентай құс ойыны...!
Dialogue: 0,0:19:58.57,0:20:00.65,Default,,0,0,0,,- (Юта) Бір ғажабы... итеріп жатырсың ба? -(Рикка) Ха ха ха!
Dialogue: 0,0:20:01.11,0:20:02.95,Default,,0,0,0,,Нергал жарылысы!
Dialogue: 0,0:20:08.58,0:20:10.33,Default,,0,0,0,,Сәттілік Kotoriyu!
Dialogue: 0,0:20:10.41,0:20:13.58,Default,,0,0,0,,Мылтық... Шылдыр!
Dialogue: 0,0:20:24.09,0:20:25.80,Default,,0,0,0,,Қалағаныңды істе!
Dialogue: 0,0:20:25.89,0:20:27.18,Default,,0,0,0,,Уау! (металл дыбыс)
Dialogue: 0,0:20:30.97,0:20:32.02,Default,,0,0,0,,Реми мұнда әрдайым мен үшін терезені ашады, білесің бе.
Dialogue: 0,0:20:32.10,0:20:34.27,Default,,0,0,0,,Алдануыңызды барынша азайтыңыз
Dialogue: 0,0:20:36.61,0:20:38.27,Default,,0,0,0,,Ешбір жағдайда мысықтарды кіргізбеңіз
Dialogue: 0,0:20:38.36,0:20:40.73,Default,,0,0,0,,Мен бұл жолы кешірім сұраймын.
Dialogue: 0,0:20:40.82,0:20:42.53,Default,,0,0,0,,- (Кумин/Рикка) Ух... - (Юта) Мен келдім...
Dialogue: 0,0:20:45.07,0:20:46.32,Default,,0,0,0,,Оны қойыңыз
Dialogue: 0,0:20:48.28,0:20:49.12,Default,,0,0,0,,А…?
Dialogue: 0,0:20:51.66,0:20:52.83,Default,,0,0,0,,Күлкілі
Dialogue: 0,0:20:53.33,0:20:56.33,Default,,0,0,0,,Гунтинкл толығымен шешілуі керек еді...
Dialogue: 0,0:20:56.42,0:20:57.58,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:20:57.67,0:20:59.84,Default,,0,0,0,,Сіздің ойыңызда емес
Dialogue: 0,0:21:04.97,0:21:07.84,Default,,0,0,0,,Ху~ Әлі де шағып тұр.
Dialogue: 0,0:21:07.93,0:21:09.35,Default,,0,0,0,,Хмм... аа
Dialogue: 0,0:21:10.93,0:21:13.23,Default,,0,0,0,,Қараңғы заттың жалыны!
Dialogue: 0,0:21:18.40,0:21:20.52,Default,,0,0,0,,Жекпе-жек ойыны
Dialogue: 0,0:21:24.99,0:21:26.95,Default,,0,0,0,,Мылтық үлгісі жақсы.
Dialogue: 0,0:21:27.03,0:21:28.74,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:29.99,0:21:31.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:31.41,0:21:32.24,Default,,0,0,0,,​​О?
Dialogue: 0,0:21:35.66,0:21:39.46,Default,,0,0,0,,Өкінішке орай, біз оны бұрынғы үйіне қайтара алмаймыз.
Dialogue: 0,0:21:39.54,0:21:41.88,Default,,0,0,0,,Мен де бұдан былай ауырғым келмейді.
Dialogue: 0,0:21:41.96,0:21:43.26,Default,,0,0,0,,(Химераның айқайы)
Dialogue: 0,0:21:43.96,0:21:45.09,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:46.59,0:21:49.22,Default,,0,0,0,,Анашым, мен мысық ұстағым келеді.
Dialogue: 0,0:21:49.30,0:21:51.64,Default,,0,0,0,,Иә? Кенеттен емес
Dialogue: 0,0:21:51.72,0:21:52.81,Default,,0,0,0,,(Химераның айқайы)
Dialogue: 0,0:21:52.89,0:21:56.60,Default,,0,0,0,,Ааа, мысық екен, сүйкімді
Dialogue: 0,0:21:58.06,0:21:59.81,Default,,0,0,0,,Күмін-сенпайдың мысығы
Dialogue: 0,0:21:59.90,0:22:02.40,Default,,0,0,0,,Сәлден соң аман-есен табылған сияқты.
