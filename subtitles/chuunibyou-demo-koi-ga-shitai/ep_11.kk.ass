Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:03.00,0:00:05.17,Default,,0,0,0,,Сізде көп жүк жоқ.
Dialogue: 0,0:00:05.79,0:00:08.09,Default,,0,0,0,,Өмір сүруге келгенде, көп нәрсе
Dialogue: 0,0:00:08.17,0:00:11.01,Default,,0,0,0,,Оны сол жерден сатып алу арзанырақ.
Dialogue: 0,0:00:11.59,0:00:13.59,Default,,0,0,0,,Бұл өте жаман. Өтінемін маған көмектесіңіз.
Dialogue: 0,0:00:13.68,0:00:14.59,Default,,0,0,0,,Жоқ
Dialogue: 0,0:00:15.80,0:00:17.22,Default,,0,0,0,,Менің атым – Қараңғы жалын...
Dialogue: 0,0:00:17.30,0:00:18.56,Default,,0,0,0,,Иә
Dialogue: 0,0:00:19.06,0:00:20.43,Default,,0,0,0,,Хмм... Ммм (операция дыбысы)
Dialogue: 0,0:00:20.52,0:00:22.48,Default,,0,0,0,,- (Тока) Қарашы - (Юта) А-а-а-а...
Dialogue: 0,0:00:22.56,0:00:23.69,Default,,0,0,0,,Саған берейік
Dialogue: 0,0:00:23.77,0:00:25.15,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:25.23,0:00:28.02,Default,,0,0,0,,Сондай-ақ, мен дұрыс айтпағандықтан, айтамын.
Dialogue: 0,0:00:28.11,0:00:29.11,Default,,0,0,0,,Ах
Dialogue: 0,0:00:29.69,0:00:30.86,Default,,0,0,0,,Мен ризамын.
Dialogue: 0,0:00:31.32,0:00:35.11,Default,,0,0,0,,Осы жолға жан тыныштығымен аттанғаным сіздің арқаңызда.
Dialogue: 0,0:00:35.95,0:00:36.95,Default,,0,0,0,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,0:00:37.91,0:00:38.91,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:41.45,0:00:42.45,Default,,0,0,0,,Жоқ
Dialogue: 0,0:00:42.54,0:00:43.54,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:00:47.83,0:00:48.88,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:00:48.96,0:00:51.05,Default,,0,0,0,,Анашым, ол жақында үйге келеді деп ойлаймын.
Dialogue: 0,0:00:51.13,0:00:52.76,Default,,0,0,0,,Жоқ, мен ұшаққа кешігіп қаламын.
Dialogue: 0,0:00:53.38,0:00:55.09,Default,,0,0,0,,Сәлемдесуіңізді өтінемін
Dialogue: 0,0:00:55.18,0:00:56.01,Default,,0,0,0,,Иә
Dialogue: 0,0:00:57.76,0:01:00.60,Default,,0,0,0,,(Рикканың жылағаны)
Dialogue: 0,0:01:00.68,0:01:02.27,Default,,0,0,0,,О, бұл естелік екен. Өте рахмет
Dialogue: 0,0:01:08.61,0:01:09.90,Default,,0,0,0,,(Юмеханың айқайы)
Dialogue: 0,0:01:09.98,0:01:11.40,Default,,0,0,0,,Міне, Юмеха
Dialogue: 0,0:01:11.48,0:01:12.53,Default,,0,0,0,,Қош бол
Dialogue: 0,0:01:13.11,0:01:14.03,Default,,0,0,0,,Қош бол
Dialogue: 0,0:01:14.57,0:01:16.49,Default,,0,0,0,,Маған балаларыңды көруге рұқсат етпе
Dialogue: 0,0:01:16.57,0:01:18.49,Default,,0,0,0,,- (Кузуха/Юта) Не? - (Кудзуха) Тоқта, Юмеха?
Dialogue: 0,0:01:18.57,0:01:20.12,Default,,0,0,0,,Мен саған үйреттім
Dialogue: 0,0:01:20.58,0:01:22.20,Default,,0,0,0,,Аа, дұрыс.
Dialogue: 0,0:01:23.66,0:01:26.00,Default,,0,0,0,,- (Тока) Олай болса - (Кузуха/Юта) Иә.
Dialogue: 0,0:01:26.79,0:01:27.83,Default,,0,0,0,,Электрондық пошта
Dialogue: 0,0:01:32.63,0:01:36.47,Default,,0,0,0,,Рикканың көзге арналған патч тағуды қойғанына үш апта өтті.
Dialogue: 0,0:01:41.55,0:01:45.98,Default,,0,0,0,,Рикка оны қабылдауға тырысты.
Dialogue: 0,0:01:47.10,0:01:49.10,Default,,0,0,0,,♪～
Dialogue: 0,0:03:14.65,0:03:16.94,Default,,0,0,0,,～♪
Dialogue: 0,0:03:18.19,0:03:20.57,Default,,0,0,0,,Иә, тағы Чинджаороз?
Dialogue: 0,0:03:20.65,0:03:22.03,Default,,0,0,0,,Шағымсыз тамақтаныңыз
Dialogue: 0,0:03:22.11,0:03:23.74,Default,,0,0,0,,Чиньяолоза
Dialogue: 0,0:03:24.70,0:03:26.99,Default,,0,0,0,,Кузуха: Юмеха киімін ауыстырсын.
Dialogue: 0,0:03:27.08,0:03:27.99,Default,,0,0,0,,Мұнда кел
Dialogue: 0,0:03:28.08,0:03:29.75,Default,,0,0,0,,Чиньяолоза
Dialogue: 0,0:03:31.08,0:03:33.33,Default,,0,0,0,,Әй, үлкен аға, Которию-сан осында.
Dialogue: 0,0:03:33.42,0:03:34.71,Default,,0,0,0,,Рикка (аяқ дыбысы)
Dialogue: 0,0:03:34.79,0:03:36.71,Default,,0,0,0,,Иә
Dialogue: 0,0:03:37.75,0:03:40.72,Default,,0,0,0,,Ой... Қайырлы таң
Dialogue: 0,0:03:40.80,0:03:43.89,Default,,0,0,0,,Қайырлы таң, мен сені қазір аға деп атаймын.
Dialogue: 0,0:03:43.97,0:03:45.47,Default,,0,0,0,,- (Рикка) Әй, бұл! - (Кузуха) Иә?
Dialogue: 0,0:03:45.55,0:03:49.02,Default,,0,0,0,,Юта-кун, өтінемін.
Dialogue: 0,0:03:50.73,0:03:51.68,Default,,0,0,0,,Иә
Dialogue: 0,0:03:52.31,0:03:55.81,Default,,0,0,0,,Білесіз бе, әңгіменің ағымы бар, солай ма?
Dialogue: 0,0:03:55.90,0:03:58.32,Default,,0,0,0,,Егер басқа адам сіздің не айтқыңыз келетінін білсе
Dialogue: 0,0:03:58.40,0:04:00.28,Default,,0,0,0,,Арнайы жауап берудің қажеті жоқ.
Dialogue: 0,0:04:00.36,0:04:01.82,Default,,0,0,0,,Бірақ мағынасыз болса да
Dialogue: 0,0:04:01.90,0:04:04.45,Default,,0,0,0,,Нибутани дұрыс жауап берген дұрыс екенін айтты.
Dialogue: 0,0:04:04.53,0:04:07.20,Default,,0,0,0,,Жоқ, бұл рас.
Dialogue: 0,0:04:07.28,0:04:08.87,Default,,0,0,0,,Қиын
Dialogue: 0,0:04:08.95,0:04:10.87,Default,,0,0,0,,Мен көптен бері chuunibyou ауруымен ауырдым.
Dialogue: 0,0:04:11.41,0:04:13.08,Default,,0,0,0,,Міне осылай болады.
Dialogue: 0,0:04:13.54,0:04:15.88,Default,,0,0,0,,- (Рикка) Ах - (Юта) Бұл уақыт не?
Dialogue: 0,0:04:15.96,0:04:18.09,Default,,0,0,0,,Маған да сөзімді өзгерту бұйырды.
Dialogue: 0,0:04:18.17,0:04:19.46,Default,,0,0,0,,Маған күшіңді бересің бе?
Dialogue: 0,0:04:19.55,0:04:21.63,Default,,0,0,0,,Дұрыс, Юта-кун.
Dialogue: 0,0:04:23.26,0:04:24.72,Default,,0,0,0,,Сізге қажет нәрсе бар ма?
Dialogue: 0,0:04:24.80,0:04:25.72,Default,,0,0,0,,Қызметші?
Dialogue: 0,0:04:25.80,0:04:28.60,Default,,0,0,0,,- (Рикка) Саған бірдеңе керек пе? -(Юта) Жас келіншек пе?
Dialogue: 0,0:04:30.72,0:04:31.72,Default,,0,0,0,,Бірдеңе?
Dialogue: 0,0:04:32.52,0:04:33.48,Default,,0,0,0,,(Сатушы) Жарайды, онда мен сата алатын зат та осы ғана болар.
Dialogue: 0,0:04:33.56,0:04:34.64,Default,,0,0,0,,Не?
Dialogue: 0,0:04:36.19,0:04:38.40,Default,,0,0,0,,Ақыр соңында, бұл ең қолайлы болып көрінеді.
Dialogue: 0,0:04:38.98,0:04:41.53,Default,,0,0,0,,Маған бұл жақсы емес деп айтты, өйткені мен оны итеріп жібергендей болдым.
Dialogue: 0,0:04:41.61,0:04:43.82,Default,,0,0,0,,Бұл дұрыс болуы мүмкін, бірақ
Dialogue: 0,0:04:46.61,0:04:48.57,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:04:48.66,0:04:52.00,Default,,0,0,0,,Шу шығарғың келсе, ұятқа қалма. Мен ұят боламын.
Dialogue: 0,0:04:52.87,0:04:54.12,Default,,0,0,0,,Өлімді күту
Dialogue: 0,0:04:55.08,0:04:55.92,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:04:56.00,0:04:57.42,Default,,0,0,0,,Бұл «қайырлы таң» емес!
Dialogue: 0,0:04:57.50,0:04:58.79,Default,,0,0,0,,Бүгін бүгін.
Dialogue: 0,0:04:58.88,0:05:02.13,Default,,0,0,0,,Өлім қожайынның жүрегін тоздырған жынды босатады!
Dialogue: 0,0:05:03.55,0:05:06.80,Default,,0,0,0,,Санае-чан, бұрын айтқанымдай, мен қазірдің өзінде...
Dialogue: 0,0:05:06.88,0:05:10.72,Default,,0,0,0,,Мені Санае-чан деп атама! Ику өлімі
Dialogue: 0,0:05:11.39,0:05:14.10,Default,,0,0,0,,- (Юта) Ах! -(Декомори) Ммммммм.
Dialogue: 0,0:05:14.18,0:05:16.31,Default,,0,0,0,,- (Юта) Эй! Уау! -(Dekomori) Hmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmmm!
Dialogue: 0,0:05:16.39,0:05:17.98,Default,,0,0,0,,Өлемін деп ойлаған өлім
Dialogue: 0,0:05:18.06,0:05:19.19,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:05:19.27,0:05:21.65,Default,,0,0,0,,Кешіріңіз, Өлім... Жоқ, Өлім!
Dialogue: 0,0:05:23.07,0:05:23.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:23.99,0:05:26.90,Default,,0,0,0,,Жарылсын, шын, жарылсын, синапс
Dialogue: 0,0:05:27.36,0:05:29.82,Default,,0,0,0,,Бұл әлемді қуу!
Dialogue: 0,0:05:31.66,0:05:32.49,Default,,0,0,0,,Ол кішкентайынан бері Бүкіл Құдірет-ты еліктеп,
Dialogue: 0,0:05:32.58,0:05:33.62,Default,,0,0,0,,Мен...
Dialogue: 0,0:05:33.70,0:05:36.58,Default,,0,0,0,,Оян!
Dialogue: 0,0:05:37.08,0:05:38.17,Default,,0,0,0,,Мен бітірдім.
Dialogue: 0,0:05:46.34,0:05:49.55,Default,,0,0,0,,Ұстаз Ух... Ұстаз
Dialogue: 0,0:05:49.64,0:05:52.01,Default,,0,0,0,,А, сен білесің бе, сен де...
Dialogue: 0,0:05:52.10,0:05:55.18,Default,,0,0,0,,Шулы өлім Декомори берілмейді!
Dialogue: 0,0:05:55.27,0:05:58.98,Default,,0,0,0,,Шеберді басқаратын құбыжықты жоюды ұмытпаңыз.
Dialogue: 0,0:05:59.06,0:06:01.27,Default,,0,0,0,,Өлім сені құтқарады!
Dialogue: 0,0:06:07.20,0:06:08.24,Default,,0,0,0,,Рикка
Dialogue: 0,0:06:09.36,0:06:10.70,Default,,0,0,0,,Не?
Dialogue: 0,0:06:10.78,0:06:12.20,Default,,0,0,0,,Сіз...
Dialogue: 0,0:06:14.08,0:06:15.58,Default,,0,0,0,,Жақсы ма?
Dialogue: 0,0:06:16.75,0:06:20.17,Default,,0,0,0,,- (Юта) Жоқ, бұл ештеңе емес - (Рикка) Иә.
Dialogue: 0,0:06:21.58,0:06:25.05,Default,,0,0,0,,Мен бұлай айтуды жауапсыздық деп санадым.
Dialogue: 0,0:06:30.51,0:06:31.47,Default,,0,0,0,,Ал, әзірге.
Dialogue: 0,0:06:30.51,0:06:31.47,Default,,0,0,0,,- (Юта) Скаут? -(Исшики) Кез келген нәрсе
Dialogue: 0,0:06:31.47,0:06:31.55,Default,,0,0,0,,- (Юта) Скаут? -(Исшики) Кез келген нәрсе
Dialogue: 0,0:06:31.55,0:06:31.76,Default,,0,0,0,,- (Юта) Барлаушы? -(Исшики) Кез келген нәрсе
Dialogue: 0,0:06:31.55,0:06:31.76,Default,,0,0,0,,Көруге келсеңіз де
Dialogue: 0,0:06:31.76,0:06:31.84,Default,,0,0,0,,Көруге келсеңіз де
Dialogue: 0,0:06:31.84,0:06:32.72,Default,,0,0,0,,Көруге келсеңіз де
Dialogue: 0,0:06:31.84,0:06:32.72,Default,,0,0,0,,Олардың мектептегі фестивальдегі өнері көпшіліктің көңілінен шықты.
Dialogue: 0,0:06:32.72,0:06:32.80,Default,,0,0,0,,Олардың мектептегі фестивальдегі өнері көпшіліктің көңілінен шықты.
Dialogue: 0,0:06:32.80,0:06:34.68,Default,,0,0,0,,Олардың мектептегі фестивальдегі өнері көпшіліктің көңілінен шықты.
Dialogue: 0,0:06:32.80,0:06:34.68,Default,,0,0,0,,Жарайды, аздап.
Dialogue: 0,0:06:34.76,0:06:37.18,Default,,0,0,0,,А, Декоморимен жасаған жігіт?
Dialogue: 0,0:06:37.27,0:06:38.68,Default,,0,0,0,,Мұндай ақылсыз спектакль
Dialogue: 0,0:06:38.77,0:06:39.10,Default,,0,0,0,,Шамасы, қолынан келетін адамды іздеп жүрсе керек.
Dialogue: 0,0:06:39.10,0:06:40.39,Default,,0,0,0,,Қолынан келетін адамды іздеп жүрген көрінеді.
Dialogue: 0,0:06:39.10,0:06:40.39,Default,,0,0,0,,Бұл адам ашылуда
Dialogue: 0,0:06:40.39,0:06:40.48,Default,,0,0,0,,Қолынан келетін адамды іздеп жүрген көрінеді.
Dialogue: 0,0:06:40.48,0:06:41.31,Default,,0,0,0,,Қолынан келетін адамды іздеп жүрген көрінеді.
Dialogue: 0,0:06:40.48,0:06:41.31,Default,,0,0,0,,Айқай!
Dialogue: 0,0:06:41.40,0:06:43.19,Default,,0,0,0,,Дәл барлығы, барлығы бірге
Dialogue: 0,0:06:41.40,0:06:43.19,Default,,0,0,0,,Бұл адамның бұған еш қатысы жоқ.
Dialogue: 0,0:06:43.27,0:06:45.86,Default,,0,0,0,,Бұл мектеп фестивалі сәтті өтті.
Dialogue: 0,0:06:45.94,0:06:48.28,Default,,0,0,0,,Нәтижелер? Менде басқа ештеңе жоқ
Dialogue: 0,0:06:48.36,0:06:50.36,Default,,0,0,0,,Иә? «Ештеңе»?
Dialogue: 0,0:06:50.45,0:06:53.20,Default,,0,0,0,,Мектеп мерекесінде Котори-санға айтқан Тогаши-кун ба?
Dialogue: 0,0:06:53.28,0:06:54.95,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:06:55.03,0:06:56.45,Default,,0,0,0,,Осыдан кейін олар күнде мектепке баратын болды, солай ма?
Dialogue: 0,0:06:56.45,0:06:57.54,Default,,0,0,0,,Осыдан кейін олар күнде мектепке баратын болды, солай ма?
Dialogue: 0,0:06:56.45,0:06:57.54,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:06:57.54,0:06:57.62,Default,,0,0,0,,Осыдан кейін олар күнде мектепке баратын сияқты, любви-дови, солай ма?
Dialogue: 0,0:06:57.62,0:06:58.54,Default,,0,0,0,,Осыдан кейін олар күнде мектепке баратын сияқты, любви-дови, солай ма?
Dialogue: 0,0:06:57.62,0:06:58.54,Default,,0,0,0,,Алып саламандра тәрізді
Dialogue: 0,0:06:58.54,0:06:58.62,Default,,0,0,0,,Алып саламандра тәрізді
Dialogue: 0,0:06:58.62,0:06:58.87,Default,,0,0,0,,Алып саламандра тәрізді
Dialogue: 0,0:06:58.62,0:06:58.87,Default,,0,0,0,,Жоқ, жақсы
Dialogue: 0,0:06:58.87,0:06:58.96,Default,,0,0,0,,Жоқ, жақсы
Dialogue: 0,0:06:58.96,0:06:59.91,Default,,0,0,0,,Жоқ, жақсы
Dialogue: 0,0:06:58.96,0:06:59.91,Default,,0,0,0,,Бұл сүйкімді ме?
Dialogue: 0,0:07:00.00,0:07:04.50,Default,,0,0,0,,А, онымен салыстырғанда, менің бос әткеншектеріме қалай қарайсың?
Dialogue: 0,0:07:04.59,0:07:07.71,Default,,0,0,0,,Күмин-сенпай, сен ұйықтап қалдың ғой? Бұл әлі жақсы емес деп шешілді ...
Dialogue: 0,0:07:07.80,0:07:10.22,Default,,0,0,0,,Әрине! Мен берілмеймін!
Dialogue: 0,0:07:10.30,0:07:11.13,Default,,0,0,0,,Ах аа... а
Dialogue: 0,0:07:11.22,0:07:12.34,Default,,0,0,0,,Мен берілмеймін!
Dialogue: 0,0:07:12.43,0:07:14.22,Default,,0,0,0,,Енді нақты орналасқан жеріне қара.
Dialogue: 0,0:07:16.93,0:07:17.77,Default,,0,0,0,,Ум...
Dialogue: 0,0:07:17.85,0:07:19.93,Default,,0,0,0,,- (Райден) Которию-сан? -(Миябе) Не болды?
Dialogue: 0,0:07:21.81,0:07:24.44,Default,,0,0,0,,Өтінемін, менің досым бол
Dialogue: 0,0:07:24.52,0:07:25.94,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:07:26.02,0:07:27.36,Default,,0,0,0,,Не?
Dialogue: 0,0:07:28.69,0:07:29.86,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:07:29.94,0:07:31.74,Default,,0,0,0,,Хехехе
Dialogue: 0,0:07:31.82,0:07:32.74,Default,,0,0,0,,Қуанышпен
Dialogue: 0,0:07:32.82,0:07:36.24,Default,,0,0,0,,О~ (қол шапалақтау)
Dialogue: 0,0:07:36.33,0:07:39.04,Default,,0,0,0,,Бұл мойындау сахнасындай болып, мен қатты толқыдым.
Dialogue: 0,0:07:39.12,0:07:39.95,Default,,0,0,0,,Мен де
Dialogue: 0,0:07:40.04,0:07:41.62,Default,,0,0,0,,(Хокецу/Рейден/Миябенің күлкісі)
Dialogue: 0,0:07:48.09,0:07:49.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:49.09,0:07:52.22,Default,,0,0,0,,Түс болды. Бұл кітапханашының жұмысы, солай ма?
Dialogue: 0,0:07:52.30,0:07:54.64,Default,,0,0,0,,- (Юта) Жарайды, бәрі осы ма? -(Нибутани) Иә.
Dialogue: 0,0:07:54.72,0:07:56.97,Default,,0,0,0,,Мұғалім де өте қарапайым.
Dialogue: 0,0:07:57.05,0:08:00.77,Default,,0,0,0,,Сынып өкіліне бәрін істеуге рұқсат беру дұрыс болмас еді...
Dialogue: 0,0:08:02.35,0:08:05.15,Default,,0,0,0,,Айтпақшы, сізді драмалық үйірме барды ма?
Dialogue: 0,0:08:05.23,0:08:08.19,Default,,0,0,0,,- (Нибутани) Иә, жарайды - (Юта) Біз не істейміз?
Dialogue: 0,0:08:08.69,0:08:11.61,Default,,0,0,0,,Олай емес~ Неліктен бұл туралы алаңдайсыз?
Dialogue: 0,0:08:11.69,0:08:12.78,Default,,0,0,0,,Бөлек
Dialogue: 0,0:08:14.36,0:08:15.62,Default,,0,0,0,,Тоғаши-кун
Dialogue: 0,0:08:16.62,0:08:17.99,Default,,0,0,0,,Сізде өкініш бар ма?
Dialogue: 0,0:08:18.08,0:08:19.04,Default,,0,0,0,,Не?
Dialogue: 0,0:08:19.12,0:08:21.66,Default,,0,0,0,,- (Нибутани) Которию-сан туралы - (Юта) Неге?
Dialogue: 0,0:08:21.75,0:08:23.29,Default,,0,0,0,,Кез келген нәрсе
Dialogue: 0,0:08:23.75,0:08:25.50,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:08:25.58,0:08:29.63,Default,,0,0,0,,Оның Чуунибюден кеткеніне рахмет, мен енді Тока-сан үшін уайымдаудың қажеті жоқ.
Dialogue: 0,0:08:29.71,0:08:33.01,Default,,0,0,0,,Анаңның жағдайы жақсы, оның еш жамандығы жоқ.
Dialogue: 0,0:08:35.13,0:08:36.51,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:37.30,0:08:38.47,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:40.72,0:08:41.72,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:44.23,0:08:45.98,Default,,0,0,0,,Сіз де Коториюді көрдіңіз бе?
Dialogue: 0,0:08:46.06,0:08:48.06,Default,,0,0,0,,- (Рикка) Иә - (Рейден) Бұл қызық~
Dialogue: 0,0:08:48.15,0:08:50.94,Default,,0,0,0,,- (Рикка) Иә, маған қатты ұнайды - (Миябе) ~ Бұл таңқаларлық~
Dialogue: 0,0:08:51.03,0:08:52.99,Default,,0,0,0,,Олай болса, келесіде бірге тікелей эфирге барайық.
Dialogue: 0,0:08:53.07,0:08:55.07,Default,,0,0,0,,Әй, жақсы, жақсы
Dialogue: 0,0:08:59.45,0:09:01.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:01.12,0:09:02.75,Default,,0,0,0,,Жел соғады
Dialogue: 0,0:09:04.00,0:09:08.42,Default,,0,0,0,,Дөңес қамқоршы өлімді оңды-солды тербетеді
Dialogue: 0,0:09:09.09,0:09:13.05,Default,,0,0,0,,Ұстаздың ойы Ху... Ұстаз
Dialogue: 0,0:09:13.13,0:09:13.97,Default,,0,0,0,,Ui~
Dialogue: 0,0:09:14.05,0:09:16.76,Default,,0,0,0,,Не болды, орта мектеп оқушысы, көңіл күйің түсіп кетті ме?
Dialogue: 0,0:09:16.84,0:09:18.59,Default,,0,0,0,,Менімен сөйлеспе, қарапайым адам
Dialogue: 0,0:09:18.68,0:09:21.72,Default,,0,0,0,,Мені қарапайым адам деме. Айтайын дегенім, сіз де қарапайым адамсыз.
Dialogue: 0,0:09:21.81,0:09:25.23,Default,,0,0,0,,Декомори - өлімнің басқа түрі. Өлім, Mjolnir балғасын қолданушы!
Dialogue: 0,0:09:25.31,0:09:28.23,Default,,0,0,0,,Әй, сен сондай жігерлі болсаң, бәрі жақсы болады.
Dialogue: 0,0:09:28.31,0:09:30.94,Default,,0,0,0,,Хмм... Не істеп жатырсың, Өлім?
Dialogue: 0,0:09:31.02,0:09:32.36,Default,,0,0,0,,Сіз оны көрмейсіз бе?
Dialogue: 0,0:09:32.44,0:09:33.69,Default,,0,0,0,,Бұл махаббат хаты!
Dialogue: 0,0:09:33.78,0:09:36.20,Default,,0,0,0,,Сіз әлі бас тартқан жоқсыз ба?
Dialogue: 0,0:09:36.90,0:09:39.12,Default,,0,0,0,,- (Нибутани) Не істеп жатырсың? -(Исшики) Негізі емес...
Dialogue: 0,0:09:39.87,0:09:40.70,Default,,0,0,0,,О!
Dialogue: 0,0:09:40.78,0:09:43.04,Default,,0,0,0,,Ұстаз! Мен күткен өлім!
Dialogue: 0,0:09:43.12,0:09:45.25,Default,,0,0,0,,Деко... Санае-чан
Dialogue: 0,0:09:45.33,0:09:48.92,Default,,0,0,0,,Мен бүгін керемет жаңалық аштым, сондықтан оны көрсетуге келдім!
Dialogue: 0,0:09:49.00,0:09:51.92,Default,,0,0,0,,Мына сиқырлы тастарды қараңыз.
Dialogue: 0,0:09:52.00,0:09:52.92,Default,,0,0,0,,О...
Dialogue: 0,0:09:55.88,0:09:58.84,Default,,0,0,0,,Қай шаршыны таңдауым керек? Қайсысы жақсы?
Dialogue: 0,0:09:58.93,0:10:00.68,Default,,0,0,0,,Уау...
Dialogue: 0,0:10:02.22,0:10:05.02,Default,,0,0,0,,Бірінші дәрежелі сиқырлы күші бар тастар, Өлім!
Dialogue: 0,0:10:05.10,0:10:06.02,Default,,0,0,0,,Декомори…
Dialogue: 0,0:10:06.10,0:10:08.19,Default,,0,0,0,,Әй, сәл күте тұрыңыз, Өлім.
Dialogue: 0,0:10:08.85,0:10:11.36,Default,,0,0,0,,Бұл сізді одан да әдемі етеді
Dialogue: 0,0:10:11.44,0:10:12.44,Default,,0,0,0,,(дыбысты ауыстыру)
Dialogue: 0,0:10:14.32,0:10:16.07,Default,,0,0,0,,О...
Dialogue: 0,0:10:18.49,0:10:19.61,Default,,0,0,0,,Ол кішкентайынан бері Бүкіл Құдірет-ты еліктеп,
Dialogue: 0,0:10:22.87,0:10:24.45,Default,,0,0,0,,- (Рикка) Декомори - (Декомори) Иә!
Dialogue: 0,0:10:25.37,0:10:27.37,Default,,0,0,0,,Бүгін менің айтуым керек маңызды нәрсе бар.
Dialogue: 0,0:10:27.46,0:10:31.17,Default,,0,0,0,,Иә! Мүмкін жаңа басқару станциясы бар шығар...
Dialogue: 0,0:10:31.25,0:10:32.08,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:32.88,0:10:35.80,Default,,0,0,0,,Бұл бірлестік... жоқ
Dialogue: 0,0:10:37.09,0:10:38.34,Default,,0,0,0,,Бұл бөлім...
Dialogue: 0,0:10:40.18,0:10:42.47,Default,,0,0,0,,Бүгінгі күні таратылады
Dialogue: 0,0:10:45.39,0:10:46.22,Default,,0,0,0,,Хе-хе. Ей, ойын ойнайық.
Dialogue: 0,0:10:46.31,0:10:48.81,Default,,0,0,0,,Әркім өз қалауын жасауға ерікті.
Dialogue: 0,0:10:48.89,0:10:50.39,Default,,0,0,0,,Мен мұны істеуге тырысамын деп ойлаймын.
Dialogue: 0,0:10:50.85,0:10:52.15,Default,,0,0,0,,Декомори да...
Dialogue: 0,0:10:52.23,0:10:54.61,Default,,0,0,0,,Саған не болды, Өлім? Ұстаз!
Dialogue: 0,0:10:54.69,0:10:56.98,Default,,0,0,0,,Бұл қоғам көрінбейтін шекараны ашады.
Dialogue: 0,0:10:57.07,0:10:59.61,Default,,0,0,0,,Өлім, бәлкім, о дүниеге бару үшін керек еді!
Dialogue: 0,0:10:59.70,0:11:01.07,Default,,0,0,0,,Ол кішкентайынан бері Бүкіл Құдірет-ты еліктеп,
Dialogue: 0,0:11:01.70,0:11:03.49,Default,,0,0,0,,Ол кішкентайынан бері Бүкіл Құдірет-ты еліктеп,
Dialogue: 0,0:11:03.57,0:11:04.83,Default,,0,0,0,,- (Нибутани) Ху - (дөңес Мамору) Ұстаз
Dialogue: 0,0:11:04.91,0:11:07.16,Default,,0,0,0,,Иә, иә, сондықтан
Dialogue: 0,0:11:07.24,0:11:09.46,Default,,0,0,0,,Сіз де маған Мабиногионды беріңізші.
Dialogue: 0,0:11:07.24,0:11:09.46,Default,,0,0,0,,Сіз не істеп жатырсыз? Өлімді жібер! Өлімді жібер!
Dialogue: 0,0:11:09.46,0:11:09.54,Default,,0,0,0,,Сіз не істеп жатырсыз? Өлімді жібер! Өлімді жібер!
Dialogue: 0,0:11:09.54,0:11:11.29,Default,,0,0,0,,Сіз не істеп жатырсыз? Өлімді жібер! Өлімді жібер!
Dialogue: 0,0:11:09.54,0:11:11.29,Default,,0,0,0,,Орта мектепке оралу. Мында кел.
Dialogue: 0,0:11:11.29,0:11:11.37,Default,,0,0,0,,Орта мектепке оралу. Мында кел.
Dialogue: 0,0:11:11.37,0:11:13.08,Default,,0,0,0,,Орта мектепке оралу. Мында кел.
Dialogue: 0,0:11:11.37,0:11:13.08,Default,,0,0,0,,Жібер! иә!
Dialogue: 0,0:11:13.17,0:11:15.63,Default,,0,0,0,,Хмм, жібер, Өлім!
Dialogue: 0,0:11:15.71,0:11:16.96,Default,,0,0,0,,(Декоморидің қатты жылауы)
Dialogue: 0,0:11:16.96,0:11:18.71,Default,,0,0,0,,(Декоморидің қатты жылауы)
Dialogue: 0,0:11:16.96,0:11:18.71,Default,,0,0,0,,- (Юта) Ах... - (Нибутани) Соған ұқсас нәрсе.
Dialogue: 0,0:11:19.30,0:11:21.18,Default,,0,0,0,,Сіз өзімшіл емессіз бе?
Dialogue: 0,0:11:21.26,0:11:22.13,Default,,0,0,0,,- (Нибутани) Тогаши-кун да - (Юта) А?
Dialogue: 0,0:11:22.22,0:11:23.80,Default,,0,0,0,,Которию-сан да
Dialogue: 0,0:11:23.89,0:11:26.43,Default,,0,0,0,,Өлімді жіберіңдер~ Уау~
Dialogue: 0,0:11:26.51,0:11:27.93,Default,,0,0,0,,Ашуланба!
Dialogue: 0,0:11:28.02,0:11:31.44,Default,,0,0,0,,(Декоморидің қатты жылауы)
Dialogue: 0,0:11:31.52,0:11:34.90,Default,,0,0,0,,Жібер! Өлімді жібер!
Dialogue: 0,0:11:44.82,0:11:45.74,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:11:46.24,0:11:48.99,Default,,0,0,0,,Фу-фу-фу... Уф!
Dialogue: 0,0:11:49.08,0:11:50.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:51.29,0:11:52.79,Default,,0,0,0,,Жарайды, жарайды
Dialogue: 0,0:11:58.50,0:12:02.38,Default,,0,0,0,,Қажетсіз ештеңе жасамаңыз...
Dialogue: 0,0:12:02.47,0:12:06.39,Default,,0,0,0,,(Декоморидің жылаған дауысы)
Dialogue: 0,0:12:14.98,0:12:18.44,Default,,0,0,0,,Күрсіну... Бұл өте керемет шара болды.
Dialogue: 0,0:12:19.15,0:12:21.57,Default,,0,0,0,,- (Рикка) Уақытымыз аз - (Юта) А?
Dialogue: 0,0:12:21.65,0:12:23.53,Default,,0,0,0,,Анам бүгін қайтып келеді
Dialogue: 0,0:12:23.61,0:12:25.41,Default,,0,0,0,,Мен бәрін шешемін деп уәде бердім.
Dialogue: 0,0:12:25.49,0:12:26.32,Default,,0,0,0,,Иә!?
Dialogue: 0,0:12:27.20,0:12:29.58,Default,,0,0,0,,Егер мен оны қалдырсам, оның тағы да уайымдайтынына сенімдімін.
Dialogue: 0,0:12:30.29,0:12:32.46,Default,,0,0,0,,Мен сізді тым алаңдатқым келмейді.
Dialogue: 0,0:12:32.54,0:12:36.08,Default,,0,0,0,,Дұрыс, қайсысын тазалауым керек?
Dialogue: 0,0:12:36.17,0:12:38.38,Default,,0,0,0,,Әзірге бәрі еденде
Dialogue: 0,0:12:38.46,0:12:39.30,Default,,0,0,0,,Иә.
Dialogue: 0,0:12:39.38,0:12:42.59,Default,,0,0,0,,(жүктің қозғалатын дыбысы)
Dialogue: 0,0:12:45.93,0:12:46.93,Default,,0,0,0,,О!
Dialogue: 0,0:12:47.01,0:12:50.26,Default,,0,0,0,,Сізде осыншама көп болды ма? Хаха
Dialogue: 0,0:12:58.86,0:12:59.86,Default,,0,0,0,,Қалай болғанда да, Рейнэр,
Dialogue: 0,0:13:00.86,0:13:01.98,Default,,0,0,0,,Бұл…
Dialogue: 0,0:13:14.08,0:13:15.92,Default,,0,0,0,,Не, сен оны да шешіп алайын ба?
Dialogue: 0,0:13:16.00,0:13:16.83,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:13:17.37,0:13:18.33,Default,,0,0,0,,Неге...
Dialogue: 0,0:13:20.96,0:13:22.38,Default,,0,0,0,,Қойылған нәрселер
Dialogue: 0,0:13:22.46,0:13:24.84,Default,,0,0,0,,Мен жоқ нәрсенің айырмашылығын білмеймін.
Dialogue: 0,0:13:24.92,0:13:25.88,Default,,0,0,0,,Ха...
Dialogue: 0,0:13:30.47,0:13:33.02,Default,,0,0,0,,Дұрыс, мен оны алып тастауым керек пе?
Dialogue: 0,0:13:33.10,0:13:35.94,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:13:48.36,0:13:51.87,Default,,0,0,0,,Жарайды ма? Мен шынымен осылай тазарттым ...
Dialogue: 0,0:13:51.95,0:13:54.08,Default,,0,0,0,,Бұл сізге жан тыныштығын береді деп ойлаймын.
Dialogue: 0,0:13:57.54,0:13:59.04,Default,,0,0,0,,- (Рикка) Юта - (Юта) Иә?
Dialogue: 0,0:13:59.12,0:14:00.21,Default,,0,0,0,,Сіздің қарныңыз ашты ма?
Dialogue: 0,0:14:00.29,0:14:01.50,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:14:01.59,0:14:03.88,Default,,0,0,0,,Анашым, сіз кешігіп жатырсыз, солай емес пе? Келесің бе?
Dialogue: 0,0:14:03.96,0:14:06.67,Default,,0,0,0,,- (Рикка) Көшеге шыға алмайсың ба? -(Юта) Негізі қарсы емеспін...
Dialogue: 0,0:14:20.56,0:14:22.69,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:14:22.77,0:14:25.73,Default,,0,0,0,,Иә, бұл жақсы. Юта, ұстап тұр.
Dialogue: 0,0:14:27.03,0:14:27.86,Default,,0,0,0,,О~
Dialogue: 0,0:14:27.95,0:14:29.45,Default,,0,0,0,,Сізге бұл ұнайды
Dialogue: 0,0:14:29.53,0:14:31.07,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:14:31.95,0:14:33.41,Default,,0,0,0,,Мұның несі керемет?
Dialogue: 0,0:14:33.49,0:14:35.20,Default,,0,0,0,,- (Юта) Қараңыз - (Рикка) Иә.
Dialogue: 0,0:14:41.79,0:14:42.84,Default,,0,0,0,,Бұл әдемі.
Dialogue: 0,0:14:46.34,0:14:48.80,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:14:48.88,0:14:52.22,Default,,0,0,0,,Мынау көлік, фарадан түскен жарық
Dialogue: 0,0:14:53.22,0:14:54.85,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:14:54.93,0:14:56.72,Default,,0,0,0,,- (Рикка) Юта - (Юта) Бұл не?
Dialogue: 0,0:14:58.60,0:14:59.73,Default,,0,0,0,,Ана...
Dialogue: 0,0:15:00.77,0:15:03.61,Default,,0,0,0,,Ол менімен бірге қабір басына барғысы келетінін айтты.
Dialogue: 0,0:15:04.15,0:15:05.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:08.61,0:15:09.57,Default,,0,0,0,,Әкемнің зиратында
Dialogue: 0,0:15:09.65,0:15:10.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:11.36,0:15:12.32,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:15:12.41,0:15:14.70,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:15:16.41,0:15:21.42,Default,,0,0,0,,(Пойыздың жүгіру дыбысы)
Dialogue: 0,0:15:43.94,0:15:46.44,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:15:46.52,0:15:49.07,Default,,0,0,0,,Мен барсам, анам қуанады деп ойлаймын.
Dialogue: 0,0:15:49.15,0:15:51.32,Default,,0,0,0,,Егер солай болса, бұл жақсы емес пе?
Dialogue: 0,0:15:51.40,0:15:52.28,Default,,0,0,0,,Иә
Dialogue: 0,0:15:52.36,0:15:55.66,Default,,0,0,0,,Егер Рикка мұны істегісі келсе, онда мен...
Dialogue: 0,0:16:02.08,0:16:03.46,Default,,0,0,0,,Кішкентай саусақ
Dialogue: 0,0:16:10.01,0:16:11.30,Default,,0,0,0,,Рахмет
Dialogue: 0,0:16:13.84,0:16:14.80,Default,,0,0,0,,Алдымен үйге барыңыз
Dialogue: 0,0:16:14.89,0:16:17.26,Default,,0,0,0,,Не... Эй, Рикка!
Dialogue: 0,0:16:31.07,0:16:33.03,Default,,0,0,0,,Сәлем Рикка-чан
Dialogue: 0,0:16:33.11,0:16:35.53,Default,,0,0,0,,Кумин... Сенпай
Dialogue: 0,0:16:36.03,0:16:36.91,Default,,0,0,0,,Додомен
Dialogue: 0,0:16:36.99,0:16:38.91,Default,,0,0,0,,Аа~ Мен аздап ауырдым~
Dialogue: 0,0:16:38.99,0:16:41.29,Default,,0,0,0,,А, қабылдама!
Dialogue: 0,0:16:42.20,0:16:43.33,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:59.89,0:17:01.22,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:03.68,0:17:05.02,Default,,0,0,0,,И-иә… рас. Менің ағамдай… деп ойлаймын
Dialogue: 0,0:17:09.36,0:17:10.61,Default,,0,0,0,,Мен сонда ғана бардым.
Dialogue: 0,0:17:10.69,0:17:11.53,Default,,0,0,0,,Орындыққа отырыңыз.
Dialogue: 0,0:17:11.61,0:17:12.44,Default,,0,0,0,,Иә
Dialogue: 0,0:17:12.53,0:17:15.40,Default,,0,0,0,,(Сауда автоматының дыбысы)
Dialogue: 0,0:17:19.45,0:17:21.66,Default,,0,0,0,,- (Юта) Иә - (Рикка) Рахмет
Dialogue: 0,0:17:21.74,0:17:25.37,Default,,0,0,0,,Соңғы кездері «рахмет» деп жиі айтатын болдым.
Dialogue: 0,0:17:26.25,0:17:27.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:31.88,0:17:33.09,Default,,0,0,0,,Сен сияқты біреуге уақытымды босқа жұмсауға уақытым жоқ.
Dialogue: 0,0:17:34.97,0:17:37.51,Default,,0,0,0,,Мен қайтамын...
Dialogue: 0,0:17:37.59,0:17:40.97,Default,,0,0,0,,Қабірді зиярат еткен соң, осында қайтасың.
Dialogue: 0,0:17:44.98,0:17:46.94,Default,,0,0,0,,Иә, мектеп те бар.
Dialogue: 0,0:17:47.02,0:17:48.60,Default,,0,0,0,,Бұл дұрыс. Бұл дұрыс.
Dialogue: 0,0:17:48.69,0:17:49.52,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:17:49.61,0:17:51.11,Default,,0,0,0,,- (Декомори) Өлім күтеді! -(Юта) А?
Dialogue: 0,0:17:51.19,0:17:53.57,Default,,0,0,0,,Мен айттым ғой! Мен бас тартуым керек
Dialogue: 0,0:17:53.65,0:17:54.49,Default,,0,0,0,,Декомори
Dialogue: 0,0:17:54.57,0:17:56.74,Default,,0,0,0,,Қожайынның қызметшісінен де артық
Dialogue: 0,0:17:56.82,0:17:58.99,Default,,0,0,0,,Қараңғы дүниенің соңына түссем де
Dialogue: 0,0:17:59.07,0:18:01.66,Default,,0,0,0,,Қожайынмен бірге өлім!
Dialogue: 0,0:18:01.74,0:18:04.37,Default,,0,0,0,,Жарылсын, шын, жарылсын, синапс
Dialogue: 0,0:18:04.45,0:18:07.00,Default,,0,0,0,,Бұл әлемді қуу!
Dialogue: 0,0:18:17.47,0:18:19.64,Default,,0,0,0,,Ахх!
Dialogue: 0,0:18:23.85,0:18:26.73,Default,,0,0,0,,Destiny Mjolnir Impulse!
Dialogue: 0,0:18:26.81,0:18:28.48,Default,,0,0,0,,Ахх!
Dialogue: 0,0:18:33.23,0:18:37.78,Default,,0,0,0,,Ха ха ха... Ажал өлім!
Dialogue: 0,0:18:43.66,0:18:45.66,Default,,0,0,0,,- (Рикка) Декомори... - (Декомори) Маған тиіспе!
Dialogue: 0,0:18:50.79,0:18:51.83,Default,,0,0,0,,Рикка
Dialogue: 0,0:18:52.92,0:18:54.25,Default,,0,0,0,,(поезд есігінің ашылған дыбысы)
Dialogue: 0,0:18:54.34,0:18:55.17,Default,,0,0,0,,Иә
Dialogue: 0,0:19:00.63,0:19:02.55,Default,,0,0,0,,- (Юта) Рикка - (Рикка) Ах...
Dialogue: 0,0:19:02.64,0:19:03.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:05.39,0:19:06.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:08.52,0:19:09.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:12.27,0:19:14.77,Default,,0,0,0,,(дирижер ысқырығы дыбысы)
Dialogue: 0,0:19:32.17,0:19:34.59,Default,,0,0,0,,Неге маған айтпайсың?
Dialogue: 0,0:19:35.38,0:19:37.67,Default,,0,0,0,,«Барма» деп неге айтпайсың?
Dialogue: 0,0:19:37.75,0:19:40.22,Default,,0,0,0,,Ұстаз оған айтқаныңызды қалайды!
Dialogue: 0,0:19:40.30,0:19:43.26,Default,,0,0,0,,«Мен көрінбейтін шекара сызығын іздеймін»
Dialogue: 0,0:19:43.34,0:19:45.55,Default,,0,0,0,,«Сондықтан барма»
Dialogue: 0,0:19:46.14,0:19:47.35,Default,,0,0,0,,Бірақ ол...
Dialogue: 0,0:19:47.43,0:19:49.73,Default,,0,0,0,,Шебер Қараңғы жалын шебері болды.
Dialogue: 0,0:19:49.81,0:19:52.56,Default,,0,0,0,,Зұлым патша Шинганды қорғағанын айтқан Өлім!
Dialogue: 0,0:19:52.64,0:19:54.90,Default,,0,0,0,,Сен менің жан тірегім едің, Өлім.
Dialogue: 0,0:19:54.98,0:19:58.53,Default,,0,0,0,,Қараңғы жалын шебері көзге көрінбейтін шекара бар деп айтқан кезде.
Dialogue: 0,0:19:58.61,0:20:00.57,Default,,0,0,0,,Декомори деп аталатын өлім
Dialogue: 0,0:20:00.65,0:20:04.53,Default,,0,0,0,,Мен онымен ғашығым болу үшін келісім-шартқа отырғанда мені өлім де шақырды.
Dialogue: 0,0:20:04.62,0:20:08.04,Default,,0,0,0,,Жылап Өлім Ұстаз ажал жылап жатты!
Dialogue: 0,0:20:08.12,0:20:11.25,Default,,0,0,0,,Сол қожа, ең күшті шебер!
Dialogue: 0,0:20:11.75,0:20:13.58,Default,,0,0,0,,Мен саған сендім!
Dialogue: 0,0:20:13.67,0:20:17.42,Default,,0,0,0,,Неліктен «Джау Шинган ең күшті» деп айта алмайсың?
Dialogue: 0,0:20:17.50,0:20:20.34,Default,,0,0,0,,«Қараңғылық отында құшақ ал» деп айта алмаймын!
Dialogue: 0,0:20:20.42,0:20:22.38,Default,,0,0,0,,мәңгілік
Dialogue: 0,0:20:22.47,0:20:25.64,Default,,0,0,0,,Ұстаз мұны көптен күтті.
Dialogue: 0,0:20:25.72,0:20:27.39,Default,,0,0,0,,Неге өлім! Неге Өлім!?
Dialogue: 0,0:20:27.47,0:20:30.14,Default,,0,0,0,,Айтшы, сен не істейсің?
Dialogue: 0,0:20:30.22,0:20:31.06,Default,,0,0,0,,На
Dialogue: 0,0:20:31.14,0:20:34.14,Default,,0,0,0,,Оны қуанту арқылы қалағаныңды айт!
Dialogue: 0,0:20:34.23,0:20:35.06,Default,,0,0,0,,Солай ма...
Dialogue: 0,0:20:35.15,0:20:37.06,Default,,0,0,0,,Көрінбейтін шекара жоқ.
Dialogue: 0,0:20:38.98,0:20:41.90,Default,,0,0,0,,Әкесі қабірде жатыр.
Dialogue: 0,0:20:41.99,0:20:43.90,Default,,0,0,0,,Мен бұл туралы ештеңе істей алмаймын.
Dialogue: 0,0:20:44.61,0:20:46.28,Default,,0,0,0,,Қанша тілесе де...
Dialogue: 0,0:20:46.37,0:20:47.28,Default,,0,0,0,,Шулы өлім
Dialogue: 0,0:20:47.37,0:20:49.70,Default,,0,0,0,,- (Юта) Қанша баптасам да - (Мамору Деко) Шулы өлім!
Dialogue: 0,0:20:49.79,0:20:52.29,Default,,0,0,0,,Менде қанша күш бар деп сенсем де...
Dialogue: 0,0:20:52.37,0:20:53.58,Default,,0,0,0,,Иә! Ах!
Dialogue: 0,0:20:53.66,0:20:55.46,Default,,0,0,0,,жоқ нәрсе жоқ!
Dialogue: 0,0:20:55.54,0:20:56.75,Default,,0,0,0,,Шулы өлім!
Dialogue: 0,0:20:56.83,0:20:59.92,Default,,0,0,0,,Сіздің шабуылыңыз сәтті болды ма?
Dialogue: 0,0:21:00.00,0:21:01.46,Default,,0,0,0,,Шулы өлім
Dialogue: 0,0:21:01.55,0:21:04.93,Default,,0,0,0,,Адамдарға емес, құбыжықтарға әсер ететін өлім
Dialogue: 0,0:21:05.01,0:21:07.34,Default,,0,0,0,,Қару шынымен де пайда болды ма?
Dialogue: 0,0:21:07.43,0:21:08.35,Default,,0,0,0,,Солай ма...
Dialogue: 0,0:21:08.43,0:21:11.60,Default,,0,0,0,,Қанша ойласам да, қанша сенсем де ол жерде жоқ.
Dialogue: 0,0:21:12.31,0:21:13.68,Default,,0,0,0,,Ондай нәрсе жоқ!
Dialogue: 0,0:21:18.23,0:21:21.02,Default,,0,0,0,,Хи хи... Солай ма...
Dialogue: 0,0:21:21.48,0:21:24.40,Default,,0,0,0,,Ықылық... Солай ма...
Dialogue: 0,0:21:24.49,0:21:27.28,Default,,0,0,0,,Мен білемін, Өлім.
Dialogue: 0,0:21:30.78,0:21:33.66,Default,,0,0,0,,Мен білемін, өлім!
Dialogue: 0,0:21:41.55,0:21:42.88,Default,,0,0,0,,Қайырлы таң, Йор.
Dialogue: 0,0:21:44.55,0:21:49.01,Default,,0,0,0,,Менің айтқым келгені бұл емес еді...
Dialogue: 0,0:22:06.45,0:22:08.45,Default,,0,0,0,,♪～
Dialogue: 0,0:23:32.86,0:23:35.91,Default,,0,0,0,,～♪
Dialogue: 0,0:23:37.41,0:23:43.41,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory