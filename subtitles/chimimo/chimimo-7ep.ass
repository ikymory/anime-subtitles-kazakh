Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.14,0:00:04.14,Default,,0,0,0,,Келесі кездескенше!
Dialogue: 0,0:00:09.08,0:00:11.75,Default,,0,0,0,,<Онигами отбасының үш әпкесі тұратын үйде.
Dialogue: 0,0:00:11.75,0:00:15.42,Default,,0,0,0,,Тозақ мырза 12 Чимимомен келді.
Dialogue: 0,0:00:15.42,0:00:17.42,Default,,0,0,0,,Олар әлі білмейді
Dialogue: 0,0:00:17.42,0:00:19.76,Default,,0,0,0,,Олардың шынайы мақсаты
Dialogue: 0,0:00:19.76,0:00:23.09,Default,,0,0,0,,Мақсат адам әлемін тозаққа айналдыру болды>
Dialogue: 0,0:00:23.09,0:00:43.11,Default,,0,0,0,,Сен
Dialogue: 0,0:00:43.11,0:01:03.13,Default,,0,0,0,,Сен
Dialogue: 0,0:01:03.13,0:01:23.09,Default,,0,0,0,,Сен
Dialogue: 0,0:01:23.09,0:01:25.42,Default,,0,0,0,,Сен
Dialogue: 0,0:01:25.42,0:01:29.09,Default,,0,0,0,,Сен
Dialogue: 0,0:01:29.09,0:01:49.11,Default,,0,0,0,,Сен
Dialogue: 0,0:01:49.11,0:01:52.12,Default,,0,0,0,,Сен
Dialogue: 0,0:05:04.07,0:05:07.67,Default,,0,0,0,,«Мамырдың туған тасы - изумруд тозағы»
Dialogue: 0,0:05:12.08,0:05:15.09,Default,,0,0,0,,Уау~ Шибүкен шынымен сүйкімді
Dialogue: 0,0:05:15.09,0:05:18.42,Default,,0,0,0,,Ал мына қарт Шибүкен Ояджиден түсініктеме береді.
Dialogue: 0,0:05:18.42,0:05:20.42,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:05:20.42,0:05:22.76,Default,,0,0,0,,Понскаграмнан күткендей, жазылушылар саны 1 млн.
Dialogue: 0,0:05:22.76,0:05:24.76,Default,,0,0,0,,Әсер етуші
Dialogue: 0,0:05:24.76,0:05:27.10,Default,,0,0,0,,Ал, мен...
Dialogue: 0,0:05:27.10,0:05:31.10,Default,,0,0,0,,Хаа... Изумрул қазір 5039?
Dialogue: 0,0:05:31.10,0:05:34.44,Default,,0,0,0,,Понска грамматикасының кіші орта мектебінің оқушысы болу деген осы ма?
Dialogue: 0,0:05:34.44,0:05:38.11,Default,,0,0,0,,Мен Чимимоны жариялай бастағаннан бері жазылушылар саны өте көбейді.
Dialogue: 0,0:05:38.11,0:05:40.11,Default,,0,0,0,,Әлі жоқ.
Dialogue: 0,0:05:40.11,0:05:43.11,Default,,0,0,0,,Мен де жақында әсер етуші деп аталғым келеді.
Dialogue: 0,0:05:43.11,0:05:45.11,Default,,0,0,0,,Жарайды, мен бар күшімді саламын!
Dialogue: 0,0:05:46.45,0:05:49.12,Default,,0,0,0,,Хмм.
Dialogue: 0,0:05:49.12,0:05:52.46,Default,,0,0,0,,Қараңызшы, бұл жер еуропалық тастарға ұқсамай ма?
Dialogue: 0,0:05:52.46,0:05:54.46,Default,,0,0,0,,Чими? Эй
Dialogue: 0,0:05:54.46,0:05:57.13,Default,,0,0,0,,Бір сәт сонда тұрыңыз.
Dialogue: 0,0:05:57.13,0:05:59.40,Default,,0,0,0,,Чими
Dialogue: 0,0:05:59.40,0:06:01.40,Default,,0,0,0,,Хмм?
Dialogue: 0,0:06:01.40,0:06:04.10,Default,,0,0,0,,Иә, бұл (ысырма дыбысы)
Dialogue: 0,0:06:06.40,0:06:08.41,Default,,0,0,0,,<«Римдегі қонақүйдің алдында
Dialogue: 0,0:06:08.41,0:06:12.74,Default,,0,0,0,,Хигечимимо ескі тастардың тарихын еске түсіреді»>
Dialogue: 0,0:06:12.74,0:06:15.41,Default,,0,0,0,,Хехе, артық шығар?
Dialogue: 0,0:06:15.41,0:06:17.41,Default,,0,0,0,,Бірақ Эмераның сүйкімділігі сол
Dialogue: 0,0:06:17.41,0:06:21.08,Default,,0,0,0,,Сүйкімді кішкентай суреттер және тамаша өмір салты.
Dialogue: 0,0:06:21.08,0:06:23.75,Default,,0,0,0,,О, бірден «ұнады»!
Dialogue: 0,0:06:23.75,0:06:26.76,Default,,0,0,0,,(Хабарландыру дыбысы)
Dialogue: 0,0:06:26.76,0:06:29.76,Default,,0,0,0,,Керемет таңқаларлық! Көп лайк!
Dialogue: 0,0:06:29.76,0:06:33.76,Default,,0,0,0,,Иә! Эмирал қазір бүкіл әлем бойынша саяхатқа шығады.
Dialogue: 0,0:06:35.43,0:06:39.43,Default,,0,0,0,,(ｴﾒﾗﾙ)
Dialogue: 0,0:06:50.11,0:06:52.78,Default,,0,0,0,,(Хабарландыру дыбысы)
Dialogue: 0,0:06:52.78,0:06:57.18,Default,,0,0,0,,О! Шетелге саяхат жады шығарылымы Бұл танымал Ол танымал
Dialogue: 0,0:06:59.06,0:07:02.36,Default,,0,0,0,,Хмм... мм?
Dialogue: 0,0:07:03.73,0:07:08.06,Default,,0,0,0,,Иә! Бірден 100 000 жазылушы!
Dialogue: 0,0:07:08.06,0:07:10.06,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:07:14.74,0:07:17.41,Default,,0,0,0,,Мей, мен таңертең көп жеймін.
Dialogue: 0,0:07:17.41,0:07:20.08,Default,,0,0,0,,Жақсы нәрсе болды ма? бөлек
Dialogue: 0,0:07:20.08,0:07:22.08,Default,,0,0,0,,<Мен айта алмаймын
Dialogue: 0,0:07:22.08,0:07:24.75,Default,,0,0,0,,Менің ойымша, SNS зұлымдық ұясы.
Dialogue: 0,0:07:24.75,0:07:28.42,Default,,0,0,0,,Егер олар сіздің Ponskagram қолданбасын пайдаланып жатқаныңызды білсе, Wi-Fi өшіріледі.
Dialogue: 0,0:07:28.42,0:07:30.42,Default,,0,0,0,,Бірақ мен қазірдің өзінде
Dialogue: 0,0:07:30.42,0:07:32.42,Default,,0,0,0,,Әсер етуші изумруд>
Dialogue: 0,0:07:34.76,0:07:37.43,Default,,0,0,0,,Енді біз бүгін қай елге баруымыз керек? (Үлкен) Чими?
Dialogue: 0,0:07:37.43,0:07:40.10,Default,,0,0,0,,Оңтүстік арал? Африка шөлі?
Dialogue: 0,0:07:40.10,0:07:42.10,Default,,0,0,0,,Чими? Арктикалық шеңбердегі Аврора?
Dialogue: 0,0:07:42.10,0:07:44.10,Default,,0,0,0,,(ｼﾌﾞｹﾝ)
Dialogue: 0,0:07:44.10,0:07:46.44,Default,,0,0,0,,Бір! Ва-ва-ва-ва-уан-ва-ва-ва-ва-ва-ва-ва-ва-ва-ва-ва-ва-ва-ва-ва-ва-ва-уан!
Dialogue: 0,0:07:46.44,0:07:48.77,Default,,0,0,0,,Чими~! Мұрт!
Dialogue: 0,0:07:48.77,0:07:52.11,Default,,0,0,0,,Чими Чими~ (Шибүкен) Біреуі бір
Dialogue: 0,0:07:52.11,0:07:54.44,Default,,0,0,0,,Не, мына ит...
Dialogue: 0,0:07:54.44,0:07:56.45,Default,,0,0,0,,Уау! Ван ван
Dialogue: 0,0:07:56.45,0:07:58.72,Default,,0,0,0,,Шибүкен! Ах...
Dialogue: 0,0:07:58.72,0:08:00.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:00.72,0:08:02.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:05.39,0:08:07.39,Default,,0,0,0,,Не? Бұл не?
Dialogue: 0,0:08:07.39,0:08:09.73,Default,,0,0,0,,Көздерің жарқырап тұр ма?
Dialogue: 0,0:08:09.73,0:08:12.06,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:08:12.06,0:08:15.73,Default,,0,0,0,,Біртүрлі бетті итімді мазалағаным үшін кешірім сұраймын.
Dialogue: 0,0:08:15.73,0:08:17.73,Default,,0,0,0,,Біраздан соң—
Dialogue: 0,0:08:18.74,0:08:22.07,Default,,0,0,0,,Не? Сонда біз дос емеспіз бе?
Dialogue: 0,0:08:22.07,0:08:24.41,Default,,0,0,0,,Басқа екенін білмейтін бала
Dialogue: 0,0:08:24.41,0:08:27.41,Default,,0,0,0,,Бірақ арғы жағы да менің жиеніме қарап тұрды.
Dialogue: 0,0:08:27.41,0:08:29.75,Default,,0,0,0,,Бұл бастауыш сыныптағы бала ма?
Dialogue: 0,0:08:29.75,0:08:32.42,Default,,0,0,0,,Атын есіне түсіре алмай, терең ойға шомды.
Dialogue: 0,0:08:32.42,0:08:35.42,Default,,0,0,0,,Бұл қандай есім?
Dialogue: 0,0:08:35.42,0:08:37.42,Default,,0,0,0,,Тамақ бергеніңіз үшін рахмет (Хазуки/Муцуми) Иә?
Dialogue: 0,0:08:38.76,0:08:42.43,Default,,0,0,0,,Иә? Сонда сізде әлі біраз қалды ма?
Dialogue: 0,0:08:42.43,0:08:44.43,Default,,0,0,0,,Жетеді
Dialogue: 0,0:08:47.43,0:08:50.73,Default,,0,0,0,,Мен тамақ қалдырдым. Біртүрлі емес пе?
Dialogue: 0,0:08:52.77,0:08:55.44,Default,,0,0,0,,Осы маңда Шибүкен тұрған.
Dialogue: 0,0:08:55.44,0:08:57.44,Default,,0,0,0,,Мына бала Шибүкен Ояджи ма?
Dialogue: 0,0:08:57.44,0:09:00.04,Default,,0,0,0,,Ол да мен сияқты еді...
Dialogue: 0,0:09:00.04,0:09:02.04,Default,,0,0,0,,Егер ол ондаған күн бойы осылай көңілді жүретін болса, онда Киса қалыпты емес болар еді.
Dialogue: 0,0:09:03.71,0:09:06.38,Default,,0,0,0,,Шибүкен Қайта келер ме екен?
Dialogue: 0,0:09:06.38,0:09:08.72,Default,,0,0,0,,Мен таңғалғаным сонша, ештеңе айта алмай қалдым.
Dialogue: 0,0:09:08.72,0:09:10.72,Default,,0,0,0,,Мен саған суретке түсуге рұқсат берсем ғой.
Dialogue: 0,0:09:10.72,0:09:12.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:12.72,0:09:15.73,Default,,0,0,0,,Келеді Келмейді
Dialogue: 0,0:09:15.73,0:09:18.73,Default,,0,0,0,,Келе жатыр... келмей жатыр
Dialogue: 0,0:09:18.73,0:09:21.06,Default,,0,0,0,,Келеді Келмейді
Dialogue: 0,0:09:21.06,0:09:23.40,Default,,0,0,0,,бұл... Гүлді болжау! Менің жиенім?
Dialogue: 0,0:09:23.40,0:09:25.74,Default,,0,0,0,,(ｼﾌﾞｹﾝ)
Dialogue: 0,0:09:25.74,0:09:27.74,Default,,0,0,0,,Вава ван ван ван чими!
Dialogue: 0,0:09:27.74,0:09:29.74,Default,,0,0,0,,Вах-ва-ва-ва-уан-ван! Ваван
Dialogue: 0,0:09:29.74,0:09:32.14,Default,,0,0,0,,Әй, Шибүкен! Ах...
Dialogue: 0,0:09:37.41,0:09:39.75,Default,,0,0,0,,Ха... Не қарап тұрсың...
Dialogue: 0,0:09:39.75,0:09:43.42,Default,,0,0,0,,Тынш! Бала тағы да осында. Ол жиенімен қыдырғысы келеді.
Dialogue: 0,0:09:43.42,0:09:46.42,Default,,0,0,0,,Иә! Бұл шынымен... кездесу ме?
Dialogue: 0,0:09:46.42,0:09:48.76,Default,,0,0,0,,Мэй, мен бұрын гүл көріп едім.
Dialogue: 0,0:09:48.76,0:09:50.76,Default,,0,0,0,,Иә! Шынайы ма?
Dialogue: 0,0:09:50.76,0:09:53.10,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:53.10,0:09:55.10,Default,,0,0,0,,... алғашқы махаббат па?
Dialogue: 0,0:09:55.10,0:09:57.10,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:10:03.37,0:10:06.71,Default,,0,0,0,,<Не деп тұрсың, менімен қыдырғың келе ме?
Dialogue: 0,0:10:06.71,0:10:08.71,Default,,0,0,0,,Бірақ Шибүкен сүйкімді
Dialogue: 0,0:10:08.71,0:10:11.05,Default,,0,0,0,,Ах~ Шибүкен Фотоға түскім келеді>
Dialogue: 0,0:10:11.05,0:10:14.05,Default,,0,0,0,,Мм... бұл аты кім?
Dialogue: 0,0:10:14.05,0:10:16.72,Default,,0,0,0,,Мен, Фумиоссу, сол сурет...
Dialogue: 0,0:10:16.72,0:10:19.39,Default,,0,0,0,,Бс... Сіз орта мектеп оқушысысыз ба? Ішінде қайдасың?
Dialogue: 0,0:10:19.39,0:10:22.39,Default,,0,0,0,,Мен Сенпо университетінің бірінші курс студентімін.
Dialogue: 0,0:10:22.39,0:10:25.06,Default,,0,0,0,,Бұл Эмера-сан емес пе?
Dialogue: 0,0:10:25.06,0:10:27.40,Default,,0,0,0,,Иә! Сен білесің бе? изумруд
Dialogue: 0,0:10:27.40,0:10:30.73,Default,,0,0,0,,Өйткені, солай! Мен Понска ойнаймын
Dialogue: 0,0:10:30.73,0:10:33.07,Default,,0,0,0,,Бұл Шибукен Ояджи ғой!
Dialogue: 0,0:10:33.07,0:10:36.41,Default,,0,0,0,,Мен екенімді білгеніме өте қуаныштымын!
Dialogue: 0,0:10:39.08,0:10:41.08,Default,,0,0,0,,Мен Чимиді кеше де көрдім.
Dialogue: 0,0:10:41.08,0:10:43.08,Default,,0,0,0,,Тіпті Изумралдың өзі көзіме түсті.
Dialogue: 0,0:10:43.08,0:10:45.08,Default,,0,0,0,,Мен әрқашан жанкүйер болдым...
Dialogue: 0,0:10:45.08,0:10:47.42,Default,,0,0,0,,Бірақ жақында мен шетелге бардым.
Dialogue: 0,0:10:47.42,0:10:50.09,Default,,0,0,0,,Бұлт үстіндегі адамға көбірек ұқсайды...
Dialogue: 0,0:10:50.09,0:10:52.09,Default,,0,0,0,,Қараңызшы, бұл Париж, солай ма?
Dialogue: 0,0:10:54.09,0:10:56.09,Default,,0,0,0,,Үлкен каньон, солай ма?
Dialogue: 0,0:10:58.09,0:11:00.03,Default,,0,0,0,,Акапулько?
Dialogue: 0,0:11:00.03,0:11:02.03,Default,,0,0,0,,<Сор Хазуненің жартылай мас сырасы
Dialogue: 0,0:11:02.03,0:11:05.37,Default,,0,0,0,,Мына бала Эмераға әбден алданып қалды>
Dialogue: 0,0:11:05.37,0:11:07.37,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:11:07.37,0:11:09.37,Default,,0,0,0,,«Эмерал Андо Шибукен Ояджи»
Dialogue: 0,0:11:09.37,0:11:11.37,Default,,0,0,0,,Бірлесіп жұмыс істеуге рұқсат етіңіз! Ынтымақтастық?
Dialogue: 0,0:11:11.37,0:11:13.71,Default,,0,0,0,,Уф... Ақыры айттым.
Dialogue: 0,0:11:13.71,0:11:15.71,Default,,0,0,0,,Мен қобалжыдым, терлей бастадым.
Dialogue: 0,0:11:15.71,0:11:17.71,Default,,0,0,0,,Жоқ, мен шаршадым. Мен шаршадым.
Dialogue: 0,0:11:17.71,0:11:19.72,Default,,0,0,0,,Менің де зейнетке ерте шыққым келеді.
Dialogue: 0,0:11:19.72,0:11:22.72,Default,,0,0,0,,Мен Изумруль сияқты әлемді аралағым келеді.
Dialogue: 0,0:11:22.72,0:11:24.72,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:11:24.72,0:11:26.72,Default,,0,0,0,,<Зейнетке шығу?
Dialogue: 0,0:11:26.72,0:11:29.73,Default,,0,0,0,,Бұл бала орта мектептің бірінші курсында болса да, кәрі адам сияқты...
Dialogue: 0,0:11:29.73,0:11:32.40,Default,,0,0,0,,1 миллион ізбасарлар сіздің шынайы түріңізді көрсетеді?
Dialogue: 0,0:11:32.40,0:11:36.73,Default,,0,0,0,,Керісінше, мен бәрібір толқудамын және әсер етушімін>
Dialogue: 0,0:11:36.73,0:11:38.73,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:42.07,0:11:44.07,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:11:44.07,0:11:46.07,Default,,0,0,0,,Бірінші күннің сәтсіздігі?
Dialogue: 0,0:11:47.74,0:11:51.75,Default,,0,0,0,,Мэй? Мен өзімнен ұяламын
Dialogue: 0,0:11:51.75,0:11:54.75,Default,,0,0,0,,Мен сені жеңе алмаймын, деңгейі тым басқа.
Dialogue: 0,0:11:54.75,0:11:57.42,Default,,0,0,0,,Міне, нағыз нәрсе...
Dialogue: 0,0:11:57.42,0:11:59.36,Default,,0,0,0,,Деңгей айырмашылығы?
Dialogue: 0,0:11:59.36,0:12:01.36,Default,,0,0,0,,Басқа адам бай ма?
Dialogue: 0,0:12:01.36,0:12:04.69,Default,,0,0,0,,Деңгей айырмашылығы? Менің ойымша, оған көмектесу мүмкін емес.
Dialogue: 0,0:12:04.69,0:12:08.09,Default,,0,0,0,,Дұрыс, шын жиенімді көрсетуден басқа амалым жоқ.
Dialogue: 0,0:12:09.03,0:12:11.03,Default,,0,0,0,,Нағыз... жиен?
Dialogue: 0,0:12:11.03,0:12:14.04,Default,,0,0,0,,Жарайды, эфирге қойсаңыз да, бірден танылады.
Dialogue: 0,0:12:14.04,0:12:17.71,Default,,0,0,0,,Жарайды, Мэй өзі сияқты сүйкімді.
Dialogue: 0,0:12:17.71,0:12:21.71,Default,,0,0,0,,Көремін... тіпті Чими де сүйкімді.
Dialogue: 0,0:12:21.71,0:12:24.38,Default,,0,0,0,,Иә, өзіңізге сенімді болыңыз
Dialogue: 0,0:12:24.38,0:12:26.72,Default,,0,0,0,,Адал бол, мені ұр!
Dialogue: 0,0:12:26.72,0:12:29.72,Default,,0,0,0,,Шынымды айтсам, мені ұрды...
Dialogue: 0,0:12:29.72,0:12:31.72,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:12:31.72,0:12:33.72,Default,,0,0,0,,Ертең міндетті түрде бар күшімді саламын
Dialogue: 0,0:12:33.72,0:12:35.73,Default,,0,0,0,,Маған электрондық хат жіберіңіз! иә?
Dialogue: 0,0:12:35.73,0:12:37.73,Default,,0,0,0,,Ештеңе емес, тіпті ертең болмаса да...
Dialogue: 0,0:12:37.73,0:12:40.13,Default,,0,0,0,,Бұл тиген кезде бұзылатын түрі.
Dialogue: 0,0:12:42.73,0:12:44.73,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:46.07,0:12:48.74,Default,,0,0,0,,Изумрул келді! Чими!
Dialogue: 0,0:12:48.74,0:12:50.74,Default,,0,0,0,,Иә
Dialogue: 0,0:12:52.41,0:12:54.41,Default,,0,0,0,,Ынтымақтасайық!
Dialogue: 0,0:12:54.41,0:12:57.08,Default,,0,0,0,,Чими~! (ысырма дыбысы)
Dialogue: 0,0:12:57.08,0:12:59.75,Default,,0,0,0,,Ван Ван Ван Ван (ысырма дыбысы)
Dialogue: 0,0:12:59.75,0:13:02.42,Default,,0,0,0,,Чими~ (ысырма дыбысы)
Dialogue: 0,0:13:02.42,0:13:04.42,Default,,0,0,0,,Уау! Чими~!
Dialogue: 0,0:13:04.42,0:13:06.42,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:13:06.42,0:13:12.76,Default,,0,0,0,,Сен
Dialogue: 0,0:13:12.76,0:13:15.77,Default,,0,0,0,,Ах, бұл концентрация сызығы үшін бұл қолданба.
Dialogue: 0,0:13:15.77,0:13:19.44,Default,,0,0,0,,Белгілеу Не істеуім керек? Өтінемін, өзара болыңыз
Dialogue: 0,0:13:19.44,0:13:22.44,Default,,0,0,0,,Бүгінгі жаңартулар мынау және мынау
Dialogue: 0,0:13:22.44,0:13:24.44,Default,,0,0,0,,Онда мен осындамын.
Dialogue: 0,0:13:24.44,0:13:26.44,Default,,0,0,0,,Енді жоғары!
Dialogue: 0,0:13:26.44,0:13:28.44,Default,,0,0,0,,Жоғары
Dialogue: 0,0:13:32.12,0:13:34.12,Default,,0,0,0,,Еңбегің үшін рахмет.Еңбегің үшін рахмет
Dialogue: 0,0:13:34.12,0:13:36.45,Default,,0,0,0,,Бұл қызық болды! Эй~
Dialogue: 0,0:13:36.45,0:13:41.12,Default,,0,0,0,,Эмерал-сан, сен тағы да шетелдесің бе? Келесі жолы қайда барасыз?
Dialogue: 0,0:13:41.12,0:13:44.79,Default,,0,0,0,,А-а... Біраз уақыт кетпейтін шығармын.
Dialogue: 0,0:13:44.79,0:13:48.80,Default,,0,0,0,,Байқадым, дүниені шарлап ұшатын Изумруд-сан да жақсы.
Dialogue: 0,0:13:48.80,0:13:51.13,Default,,0,0,0,,Изумруль маңындағы кейіпкерге қайта келу.
Dialogue: 0,0:13:51.13,0:13:53.80,Default,,0,0,0,,Мен шынымен бақыттымын! Эх...
Dialogue: 0,0:13:53.80,0:13:55.80,Default,,0,0,0,,Олай болса... онда мынау.
Dialogue: 0,0:13:56.81,0:13:59.08,Default,,0,0,0,,Уау Чими
Dialogue: 0,0:13:59.08,0:14:01.68,Default,,0,0,0,,Эмераль-сан сондай керемет
Dialogue: 0,0:14:03.41,0:14:05.42,Default,,0,0,0,,Мэй, кешігіп қалдың.
Dialogue: 0,0:14:05.42,0:14:07.42,Default,,0,0,0,,Аяушылық кешіне дайындық.
Dialogue: 0,0:14:07.42,0:14:10.75,Default,,0,0,0,,Иә Мэйдің сүйікті карри еті мен картопы
Dialogue: 0,0:14:10.75,0:14:14.42,Default,,0,0,0,,Бұл консервіленген шабдалы мен зефир бар... және сіздің сүйікті тағамыңыз қандай?
Dialogue: 0,0:14:14.42,0:14:17.09,Default,,0,0,0,,А, мен қайтып келдім!
Dialogue: 0,0:14:17.09,0:14:19.76,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:14:19.76,0:14:23.10,Default,,0,0,0,,Хаа... бітті~
Dialogue: 0,0:14:23.10,0:14:26.10,Default,,0,0,0,,Көрдім, көремін, бәрі бітті.
Dialogue: 0,0:14:26.10,0:14:28.44,Default,,0,0,0,,Жарайды, сен әлі жассың.
Dialogue: 0,0:14:28.44,0:14:31.14,Default,,0,0,0,,Не? иә? иә?
Dialogue: 0,0:14:35.11,0:14:39.12,Default,,0,0,0,,<«Чимимо-тачи өзенде Шибүкен мырзамен ойнап жүр.
Dialogue: 0,0:14:39.12,0:14:41.12,Default,,0,0,0,,Таноши! ”>
Dialogue: 0,0:14:42.79,0:14:45.46,Default,,0,0,0,,<«Өзендегі Изумрал-санмен кездесу»
Dialogue: 0,0:14:45.46,0:14:47.79,Default,,0,0,0,,Шибүкен таң қалды! ”>
Dialogue: 0,0:14:47.79,0:14:51.13,Default,,0,0,0,,(Хабарландыру дыбысы)
Dialogue: 0,0:14:51.13,0:14:54.13,Default,,0,0,0,,Хехе, біз қайтадан бірлесіп жұмыс істей аламыз!
Dialogue: 0,0:17:31.09,0:17:34.39,Default,,0,0,0,,«Тозақтағы таккарун»
Dialogue: 0,0:17:35.42,0:17:38.76,Default,,0,0,0,,Чимичими Чимичими
Dialogue: 0,0:17:38.76,0:17:43.43,Default,,0,0,0,,Ах~ Балалар, сендер өте мұқиятсыңдар, тіпті тұрмыстық техниканың артындағы шаң да.
Dialogue: 0,0:17:43.43,0:17:46.44,Default,,0,0,0,,Май дақтарын жуғыш затпен сүртіңіз.
Dialogue: 0,0:17:46.44,0:17:48.44,Default,,0,0,0,,Чи-ми Чи-ми
Dialogue: 0,0:17:48.44,0:17:50.77,Default,,0,0,0,,Чимими чими…
Dialogue: 0,0:17:50.77,0:17:52.78,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:52.78,0:17:55.11,Default,,0,0,0,,Чими~
Dialogue: 0,0:17:55.11,0:17:57.11,Default,,0,0,0,,(Зеницу) Незуко-чан, Танжиро~ (Танжиро) Тоқтат! Зенцу!
Dialogue: 0,0:17:57.11,0:17:59.12,Default,,0,0,0,,《Тозақ! 》
Dialogue: 0,0:17:59.12,0:18:01.12,Default,,0,0,0,,Мен қатты ашуланамын.
Dialogue: 0,0:18:01.12,0:18:03.45,Default,,0,0,0,,Олар лентинсіз өмір сүре алмайды.
Dialogue: 0,0:18:03.45,0:18:05.45,Default,,0,0,0,,Чими~
Dialogue: 0,0:18:05.45,0:18:09.46,Default,,0,0,0,,Ааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:18:09.46,0:18:12.80,Default,,0,0,0,,Менің бұл қаладан біраз уақытқа кетуден басқа амалым жоқ.
Dialogue: 0,0:18:12.80,0:18:14.80,Default,,0,0,0,,Шаң суығанша
Dialogue: 0,0:18:14.80,0:18:16.80,Default,,0,0,0,,Чими (Мистер Тозақ) Кеттік
Dialogue: 0,0:18:16.80,0:18:18.80,Default,,0,0,0,,～
Dialogue: 0,0:18:20.74,0:18:23.41,Default,,0,0,0,,Иә? Тозақ, қайда бара жатырсың?
Dialogue: 0,0:18:23.41,0:18:25.41,Default,,0,0,0,,Ах, жоқ, яғни…
Dialogue: 0,0:18:25.41,0:18:27.41,Default,,0,0,0,,Иә? (Ақсақал) Джими?
Dialogue: 0,0:18:27.41,0:18:29.75,Default,,0,0,0,,Не! Ал Чими-Морёу ше?
Dialogue: 0,0:18:29.75,0:18:32.42,Default,,0,0,0,,Иә? Бұл да Тозақ мырзаның аты емес пе?
Dialogue: 0,0:18:32.42,0:18:35.08,Default,,0,0,0,,Ол алдыңғы есіктің сыртында еді, мен оны осында әкелдім.
Dialogue: 0,0:18:35.08,0:18:37.09,Default,,0,0,0,,Дими~
Dialogue: 0,0:18:37.09,0:18:41.09,Default,,0,0,0,,Ха! Бұл аңызға айналған алдамшы чимма-мор сіз болуы мүмкін бе?
Dialogue: 0,0:18:41.09,0:18:43.43,Default,,0,0,0,,Енді сыртқа шықпасаң, кет.
Dialogue: 0,0:18:43.43,0:18:45.43,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:18:45.43,0:18:47.76,Default,,0,0,0,,♪ Фуфуфуфуфуфу~
Dialogue: 0,0:18:47.76,0:18:50.10,Default,,0,0,0,,♪ Буға пісірілген үлпілдек нан~
Dialogue: 0,0:18:50.10,0:18:53.44,Default,,0,0,0,,Фуфуфу ♪ Фуфуфуфуфуфуфуфу~
Dialogue: 0,0:18:53.44,0:18:55.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:57.11,0:18:59.11,Default,,0,0,0,,Бұл не болды...
Dialogue: 0,0:18:59.11,0:19:01.11,Default,,0,0,0,,Тозақ! Уф...
Dialogue: 0,0:19:01.11,0:19:03.78,Default,,0,0,0,,Мен 5 секундта үлпілдек буға пісірілген нан сатып алдым.
Dialogue: 0,0:19:03.78,0:19:06.45,Default,,0,0,0,,Лентин жасай алмаймын дегеніңіз не?
Dialogue: 0,0:19:06.45,0:19:08.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:08.45,0:19:10.45,Default,,0,0,0,,Джими?
Dialogue: 0,0:19:10.45,0:19:17.45,Default,,0,0,0,,Сен
Dialogue: 0,0:19:22.06,0:19:24.07,Default,,0,0,0,,Не?
Dialogue: 0,0:19:24.07,0:19:26.07,Default,,0,0,0,,Буға пісірілген нан сүйкімді
Dialogue: 0,0:19:26.07,0:19:28.40,Default,,0,0,0,,Суық болса да жаман көрінбейді
Dialogue: 0,0:19:28.40,0:19:31.41,Default,,0,0,0,,♪ Фуфуфуфуфуфуфу (ысырма дыбысы)
Dialogue: 0,0:19:31.41,0:19:33.74,Default,,0,0,0,,Қарт адамға ұқсайды
Dialogue: 0,0:19:33.74,0:19:36.14,Default,,0,0,0,,Мына бала ақсақал ғой, хехе
Dialogue: 0,0:19:37.75,0:19:40.75,Default,,0,0,0,,♪ Хмф, үлпілдек~
Dialogue: 0,0:19:40.75,0:19:43.09,Default,,0,0,0,,Ашуланбау
Dialogue: 0,0:19:43.09,0:19:47.42,Default,,0,0,0,,Адамдарға қамқор бол! Мен ашуымды сүртейін
Dialogue: 0,0:19:47.42,0:19:49.43,Default,,0,0,0,,Дими~
Dialogue: 0,0:19:49.43,0:19:51.76,Default,,0,0,0,,Аңыз ақиқат болды
Dialogue: 0,0:19:51.76,0:19:53.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:53.76,0:19:56.77,Default,,0,0,0,,Бұл не... Тозақ мырза!
Dialogue: 0,0:19:56.77,0:19:58.77,Default,,0,0,0,,Хмм... Ах!
Dialogue: 0,0:19:58.77,0:20:01.10,Default,,0,0,0,,Иә? Бұл такояки!
Dialogue: 0,0:20:01.10,0:20:03.77,Default,,0,0,0,,Иә, көп тағамдардың ішінде.
Dialogue: 0,0:20:03.77,0:20:07.44,Default,,0,0,0,,Күлдірмей, үрлемесең, мағынасыз. Сонда да!
Dialogue: 0,0:20:07.44,0:20:10.45,Default,,0,0,0,,Мен... Мен емес едім. Мынау... мына жігіт бұзды.
Dialogue: 0,0:20:10.45,0:20:14.12,Default,,0,0,0,,Не? Бұл Чими деген не? Сіз мені өлтіргіңіз келе ме?
Dialogue: 0,0:20:14.12,0:20:16.45,Default,,0,0,0,,Джими иә?
Dialogue: 0,0:20:16.45,0:20:21.45,Default,,0,0,0,,Сен
Dialogue: 0,0:20:25.06,0:20:27.06,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:20:27.06,0:20:29.73,Default,,0,0,0,,Хаф хафф хафф хаф
Dialogue: 0,0:20:29.73,0:20:33.74,Default,,0,0,0,,Күн суық болса да, сіз әдейі үріп жейтін такояки ең жақсысы!
Dialogue: 0,0:20:33.74,0:20:37.41,Default,,0,0,0,,Суық сыра мен салқын такояки - ең жақсысы!
Dialogue: 0,0:20:37.41,0:20:39.74,Default,,0,0,0,,Бұл ең жақсы емес.
Dialogue: 0,0:20:39.74,0:20:42.75,Default,,0,0,0,,Бірақ аңыздың күші зор.
Dialogue: 0,0:20:42.75,0:20:45.08,Default,,0,0,0,,Мені кешіріңіз!
Dialogue: 0,0:20:45.08,0:20:47.75,Default,,0,0,0,,Мынау шірік билікке қудалау менеджері!
Dialogue: 0,0:20:47.75,0:20:49.75,Default,,0,0,0,,Өтірікші ит
Dialogue: 0,0:20:50.75,0:20:54.09,Default,,0,0,0,,Уф... Ах, мен қарным ашты!
Dialogue: 0,0:20:54.09,0:20:56.09,Default,,0,0,0,,Менің ештеңе жеуге уақытым болмады.
Dialogue: 0,0:20:56.09,0:20:58.09,Default,,0,0,0,,Білмеймін.
Dialogue: 0,0:21:01.43,0:21:04.43,Default,,0,0,0,,Кя~! Бұл... бұзылды!
Dialogue: 0,0:21:04.43,0:21:07.77,Default,,0,0,0,,Қалдық Мен үйге оларды жылытып жеуді армандап келдім!
Dialogue: 0,0:21:07.77,0:21:10.11,Default,,0,0,0,,Бұл мүмкін бе... Тозақ мырза!
Dialogue: 0,0:21:10.11,0:21:12.11,Default,,0,0,0,,Сәлем! Чими…
Dialogue: 0,0:21:12.11,0:21:14.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:14.11,0:21:16.11,Default,,0,0,0,,Джими иә?
Dialogue: 0,0:21:21.38,0:21:23.39,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:21:23.39,0:21:27.39,Default,,0,0,0,,Асқазанға түскенде суық та, ыстық та гарнирлер де бірдей.
Dialogue: 0,0:21:29.06,0:21:31.39,Default,,0,0,0,,Енді жақсырақ микротолқынды пешті жасайтын уақыт.
Dialogue: 0,0:21:31.39,0:21:33.73,Default,,0,0,0,,Жаңасын сатып алайық. Иә.
Dialogue: 0,0:21:33.73,0:21:36.73,Default,,0,0,0,,Хафф Хафф Хафф Хафф Хафф~
Dialogue: 0,0:21:36.73,0:21:39.40,Default,,0,0,0,,Біз құтқарылдық.
Dialogue: 0,0:21:39.40,0:21:43.07,Default,,0,0,0,,Мен аты аңызға айналған Чими Морёумен кездескенім үшін бақыттымын!
Dialogue: 0,0:21:43.07,0:21:46.41,Default,,0,0,0,,Мм... Мен мәңгілік қаламын.
Dialogue: 0,0:21:46.41,0:21:48.41,Default,,0,0,0,,Димими Ми~ми
Dialogue: 0,0:21:49.41,0:21:51.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:51.41,0:21:53.42,Default,,0,0,0,,Не... не?!
Dialogue: 0,0:21:53.42,0:21:56.75,Default,,0,0,0,,Муцумидің жемпірі қатты кішірейіп кетті!
Dialogue: 0,0:21:56.75,0:21:58.75,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:21:58.75,0:22:01.45,Default,,0,0,0,,Өтінемін (Ақсақал) Джимими
Dialogue: 0,0:22:03.09,0:22:05.09,Default,,0,0,0,,～
Dialogue: 0,0:22:07.76,0:22:09.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:09.77,0:22:11.77,Default,,0,0,0,,Уфуфу, жарайды.
Dialogue: 0,0:22:11.77,0:22:14.10,Default,,0,0,0,,Кішірейсе, кішірек сақтауға болатын заттар
Dialogue: 0,0:22:14.10,0:22:16.10,Default,,0,0,0,,Жоқ, жоқ, кешіріңіз.
Dialogue: 0,0:22:17.11,0:22:20.04,Default,,0,0,0,,Ах... бұл... бұл мока емес.
Dialogue: 0,0:22:20.04,0:22:23.05,Default,,0,0,0,,Менің жиенімнің ерекше консервіленген шабдалы дәмі.
Dialogue: 0,0:22:23.05,0:22:26.72,Default,,0,0,0,,«Моча» «Момокан» Шатастырушы!
Dialogue: 0,0:22:26.72,0:22:30.39,Default,,0,0,0,,Тозақ! Неге менің балмұздағымды жейсің?
Dialogue: 0,0:22:30.39,0:22:32.39,Default,,0,0,0,,Өлшемдері
Dialogue: 0,0:22:32.39,0:22:35.06,Default,,0,0,0,,Жарайды, тамақ ішсең семіресің.
Dialogue: 0,0:22:35.06,0:22:37.73,Default,,0,0,0,,Маған тамақ жинап бердің.
Dialogue: 0,0:22:37.73,0:22:40.13,Default,,0,0,0,,Жоқ, кешіріңіз.
Dialogue: 0,0:22:41.40,0:22:44.07,Default,,0,0,0,,Ах! Хазуки 72 банка сыра ішкен.
Dialogue: 0,0:22:44.07,0:22:46.07,Default,,0,0,0,,Мен алған арнайы саптыаяқ...
Dialogue: 0,0:22:46.07,0:22:48.07,Default,,0,0,0,,...
Dialogue: 0,0:22:48.07,0:22:50.07,Default,,0,0,0,,Тозақ!
Dialogue: 0,0:22:50.07,0:22:52.07,Default,,0,0,0,,Өлшемдері
Dialogue: 0,0:22:53.74,0:22:56.41,Default,,0,0,0,,Сәттілік! Кез келген кружка
Dialogue: 0,0:22:56.41,0:22:59.08,Default,,0,0,0,,Бір күні ол құлап, топыраққа айналады, солай ма?
Dialogue: 0,0:22:59.08,0:23:01.08,Default,,0,0,0,,Бұл сәл жылдамырақ.
Dialogue: 0,0:23:01.08,0:23:03.09,Default,,0,0,0,,Жүр, ішейік!
Dialogue: 0,0:23:03.09,0:23:05.09,Default,,0,0,0,,Жоқ, жоқ, кешіріңіз.
Dialogue: 0,0:23:05.09,0:23:07.09,Default,,0,0,0,,Пуха~!
Dialogue: 0,0:23:07.09,0:23:09.76,Default,,0,0,0,,А, мен мүлдем ашуланбаймын.
Dialogue: 0,0:23:09.76,0:23:13.43,Default,,0,0,0,,Мен қатты кешірім сұрадым, өкінбеймін.
Dialogue: 0,0:23:13.43,0:23:15.73,Default,,0,0,0,,Бұл сергітеді! Хахахаха
Dialogue: 0,0:23:17.10,0:23:19.70,Default,,0,0,0,,Қоқыс таситын көлік өтіп жатыр
Dialogue: 0,0:23:19.70,0:23:22.70,Default,,0,0,0,,Ах! Бүгін қоқыс шығару кезегі маған келді!
Dialogue: 0,0:23:24.37,0:23:26.38,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:23:26.38,0:23:29.38,Default,,0,0,0,,Алсаң да, шығармасаң да қоқыс бәрібір шіріп кетеді.
Dialogue: 0,0:23:29.38,0:23:32.38,Default,,0,0,0,,Хаха...Тапсырманы орындамадым.
Dialogue: 0,0:23:32.38,0:23:34.38,Default,,0,0,0,,Менің сабаққа барғым келмейді.
Dialogue: 0,0:23:34.38,0:23:36.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:36.72,0:23:38.72,Default,,0,0,0,,Бұл өте маңызды емес.
Dialogue: 0,0:23:38.72,0:23:40.72,Default,,0,0,0,,Қалай болғанда да өмір сынақтарға толы.
Dialogue: 0,0:23:40.72,0:23:42.73,Default,,0,0,0,,Ішейік!
Dialogue: 0,0:23:42.73,0:23:45.39,Default,,0,0,0,,Барма! Кеш! Кеш! (Мэй/Муцуми) Иә?
Dialogue: 0,0:23:45.39,0:23:48.06,Default,,0,0,0,,Өлшемдері
Dialogue: 0,0:23:48.06,0:23:52.07,Default,,0,0,0,,Сонымен... мен бармасам да, қоғам жұмыс істей береді.
Dialogue: 0,0:23:52.07,0:23:54.07,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:23:55.07,0:23:58.07,Default,,0,0,0,,(Мэйдің күлуі)
Dialogue: 0,0:23:58.07,0:24:00.74,Default,,0,0,0,,Барлығы, мектеп пен жұмысқа не болды?
Dialogue: 0,0:24:00.74,0:24:02.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:03.75,0:24:05.75,Default,,0,0,0,,Дими~ (Тозақ-сан)...
Dialogue: 0,0:24:06.75,0:24:08.75,Default,,0,0,0,,(Косей) Сен балалармен тез тіл табысасың ғой, иә?
Dialogue: 0,0:24:08.75,0:24:11.42,Default,,0,0,0,,Маңызды емес, бәрі жақсы.
Dialogue: 0,0:24:11.42,0:24:14.09,Default,,0,0,0,,Тым көп Таккаан...
Dialogue: 0,0:24:14.09,0:24:16.43,Default,,0,0,0,,()
Dialogue: 0,0:24:16.43,0:24:19.36,Default,,0,0,0,,Біз оны тегін алып кетеміз.
Dialogue: 0,0:24:19.36,0:24:23.37,Default,,0,0,0,,...
Dialogue: 0,0:24:23.37,0:24:25.37,Default,,0,0,0,,Бізден кез келген нәрсені сұрай аласыз.
Dialogue: 0,0:24:25.37,0:24:29.04,Default,,0,0,0,,О, тегін жинау! Мына микротолқынды пешті шығарайық.
Dialogue: 0,0:24:29.04,0:24:32.37,Default,,0,0,0,,Уншо Уншо... Иә
Dialogue: 0,0:24:32.37,0:24:35.38,Default,,0,0,0,,Ах, ол бұзылған, сондықтан 15 000 иен тұрады.
Dialogue: 0,0:24:35.38,0:24:37.38,Default,,0,0,0,,Мен жай ғана тегін дедім...
Dialogue: 0,0:24:37.38,0:24:40.38,Default,,0,0,0,,Еш нәрсе тегін болмайды.
Dialogue: 0,0:24:40.38,0:24:43.39,Default,,0,0,0,,Көлікті тоқтату үшін ғана ақша қажет.
Dialogue: 0,0:24:43.39,0:24:46.06,Default,,0,0,0,,А, бар болғаны 3 минут, 3000 иен қосылды!
Dialogue: 0,0:24:46.06,0:24:49.73,Default,,0,0,0,,(Мистер Тозақ)
Dialogue: 0,0:24:49.73,0:24:52.06,Default,,0,0,0,,Жарайды, бұл сондай алаяқтық сияқты.
Dialogue: 0,0:24:52.06,0:24:54.06,Default,,0,0,0,,Барлығына, бұл қиын, иә?
Dialogue: 0,0:24:54.06,0:24:56.07,Default,,0,0,0,,Иә, мүмкіндігінше
Dialogue: 0,0:24:56.07,0:24:59.74,Default,,0,0,0,,Менің де қалталы ақшам бар. Сізге тағы біраз беруім керек пе?
Dialogue: 0,0:24:59.74,0:25:01.74,Default,,0,0,0,,Иә, жақсы ма? (Б жеткізуші) Сіз байсыз ба?
Dialogue: 0,0:25:01.74,0:25:03.74,Default,,0,0,0,,Өтінемін, өтінемін.
Dialogue: 0,0:25:03.74,0:25:07.41,Default,,0,0,0,,Ақша әлемді айналдырады (бәрі күледі)
Dialogue: 0,0:25:07.41,0:25:10.75,Default,,0,0,0,,Бұл не? Төлемеңіз!
Dialogue: 0,0:25:10.75,0:25:13.08,Default,,0,0,0,,Ууууууу~!
Dialogue: 0,0:25:13.08,0:25:15.42,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:15.42,0:25:18.42,Default,,0,0,0,,Сәлем! (А сатушы) Уау!
Dialogue: 0,0:25:18.42,0:25:20.42,Default,,0,0,0,,А, мен кеттім.
Dialogue: 0,0:25:20.42,0:25:22.42,Default,,0,0,0,,Әй, қой, маңызды емес.
Dialogue: 0,0:25:23.43,0:25:25.76,Default,,0,0,0,,Осы балам болса, тыныш өмір сүре аламын.
Dialogue: 0,0:25:25.76,0:25:27.76,Default,,0,0,0,,Мен сенің мәңгі қалуыңды қалаймын.
Dialogue: 0,0:25:27.76,0:25:29.77,Default,,0,0,0,,Ашуланбау оңай~
Dialogue: 0,0:25:29.77,0:25:31.77,Default,,0,0,0,,Мен Таққанға құмармын.
Dialogue: 0,0:25:31.77,0:25:33.77,Default,,0,0,0,,() ()…
Dialogue: 0,0:25:35.10,0:25:37.40,Default,,0,0,0,,А-а... Әй, маңайдағы жігіт!
Dialogue: 0,0:25:40.44,0:25:42.78,Default,,0,0,0,,Мен оны қайтарамын! иә!
Dialogue: 0,0:25:42.78,0:25:44.78,Default,,0,0,0,,()～
Dialogue: 0,0:25:44.78,0:25:46.78,Default,,0,0,0,,Жарайды ма? Шыны ше?
Dialogue: 0,0:25:46.78,0:25:48.78,Default,,0,0,0,,Балалар жақсы.
Dialogue: 0,0:25:48.78,0:25:51.48,Default,,0,0,0,,Жоқ, менің ойымша, бұл қорқынышты. Жарайды.
Dialogue: 0,0:25:52.45,0:25:55.12,Default,,0,0,0,,Әй, бұл ұры ғой, расында.
Dialogue: 0,0:25:55.12,0:25:57.46,Default,,0,0,0,,Фурошики сүйкімді Мен оны жалғыз қалдыра аламын ба?
Dialogue: 0,0:25:57.46,0:25:59.46,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:00.46,0:26:02.80,Default,,0,0,0,,Уау, жүк көлігі келе жатыр! Ухуху
Dialogue: 0,0:26:02.80,0:26:05.47,Default,,0,0,0,,Ерекше таңқаларлық
Dialogue: 0,0:26:05.47,0:26:08.80,Default,,0,0,0,,Қай жерде күлу керек? Үй бұзылады!
Dialogue: 0,0:26:08.80,0:26:10.81,Default,,0,0,0,,Мен не істеуім керек...
Dialogue: 0,0:26:10.81,0:26:14.14,Default,,0,0,0,,Өйткені 100 жылдан кейін мен бұл дүниеде енді болмаймын.
Dialogue: 0,0:26:14.14,0:26:16.81,Default,,0,0,0,,Тіпті үй шіріп кетеді.
Dialogue: 0,0:26:16.81,0:26:19.75,Default,,0,0,0,,1000 жылдан кейін бұл ғарыш шаңы болуы мүмкін.
Dialogue: 0,0:26:19.75,0:26:23.45,Default,,0,0,0,,Сонымен... қазір жасауға болатын ең оңай нәрсе - ең жақсысы!
Dialogue: 0,0:26:25.09,0:26:27.76,Default,,0,0,0,,Сіз...
Dialogue: 0,0:26:27.76,0:26:31.09,Default,,0,0,0,,Бұл өмірде болуы керек емес!
Dialogue: 0,0:26:31.09,0:26:33.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:33.10,0:26:37.43,Default,,0,0,0,,Қараңдар! Сіз кешіретін және кешірмейтін нәрселер бар!
Dialogue: 0,0:26:37.43,0:26:40.44,Default,,0,0,0,,Иә! ау... ау!
Dialogue: 0,0:26:40.44,0:26:42.74,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:26:44.11,0:26:46.44,Default,,0,0,0,,Егер мен қорғағым келетін нәрсе аяқ киіміммен басып кетсе ше?
Dialogue: 0,0:26:46.44,0:26:49.14,Default,,0,0,0,,Сіз шынымен ашуланатын боласыз!
Dialogue: 0,0:26:50.11,0:26:52.41,Default,,0,0,0,,Бұл тозақ.
Dialogue: 0,0:26:53.45,0:26:56.12,Default,,0,0,0,,Балалар, тозақ шұңқырларын ашыңдар!
Dialogue: 0,0:26:56.12,0:26:58.12,Default,,0,0,0,,Чими!
Dialogue: 0,0:26:58.12,0:27:00.46,Default,,0,0,0,,Чими Чими Чими
Dialogue: 0,0:27:00.46,0:27:02.46,Default,,0,0,0,,Чими Чими Чими
Dialogue: 0,0:27:02.46,0:27:08.13,Default,,0,0,0,,Сен
Dialogue: 0,0:27:08.13,0:27:10.80,Default,,0,0,0,,Чими Мурью қаншалықты сирек екенін білмеймін.
Dialogue: 0,0:27:10.80,0:27:13.47,Default,,0,0,0,,Қазір алыңыз!
Dialogue: 0,0:27:13.47,0:27:16.17,Default,,0,0,0,,Дими~
Dialogue: 0,0:27:18.74,0:27:22.74,Default,,0,0,0,,Қош бол, аты аңызға айналған қаңғыбас бала
Dialogue: 0,0:27:25.08,0:27:27.08,Default,,0,0,0,,Бітті...
Dialogue: 0,0:27:27.08,0:27:29.08,Default,,0,0,0,,()…
Dialogue: 0,0:27:29.08,0:27:31.75,Default,,0,0,0,,Бұл нақты нені білдіреді?
Dialogue: 0,0:27:31.75,0:27:33.75,Default,,0,0,0,,Уф...
Dialogue: 0,0:27:34.76,0:27:36.76,Default,,0,0,0,,Менің балмұздағым қайда?
Dialogue: 0,0:27:36.76,0:27:38.76,Default,,0,0,0,,Маған сыраны қайтып беріңізші! Ақшамен!
Dialogue: 0,0:27:38.76,0:27:41.10,Default,,0,0,0,,Менің жемпірімді не істейсің?
Dialogue: 0,0:27:41.10,0:27:43.77,Default,,0,0,0,,Жақсы, қайт.
Dialogue: 0,0:27:43.77,0:27:47.10,Default,,0,0,0,,Неге күлесің? Дұрыстап ойланыңыз!
Dialogue: 0,0:27:47.10,0:27:49.10,Default,,0,0,0,,Иә Чими
Dialogue: 0,0:27:49.10,0:27:52.40,Default,,0,0,0,,(ашулы жиендердің дауыстары)
Dialogue: 0,0:27:53.44,0:28:13.46,Default,,0,0,0,,Сен
Dialogue: 0,0:28:13.46,0:28:33.42,Default,,0,0,0,,Сен
Dialogue: 0,0:28:33.42,0:28:53.44,Default,,0,0,0,,Сен
Dialogue: 0,0:28:53.44,0:29:13.46,Default,,0,0,0,,Сен
Dialogue: 0,0:29:13.46,0:29:22.76,Default,,0,0,0,,Сен
Dialogue: 0,0:29:23.73,0:29:25.73,Default,,0,0,0,,<Жоқ, сіз мысық ұстай алмайсыз.
Dialogue: 0,0:29:25.73,0:29:28.74,Default,,0,0,0,,Чими Учиханың қолында 12 жануар бар.
Dialogue: 0,0:29:28.74,0:29:32.41,Default,,0,0,0,,Егер сіз оны сақтасаңыз, сіз Тозақ мырзадан оны қалдыруын сұрауыңыз керек.
Dialogue: 0,0:29:32.41,0:29:35.08,Default,,0,0,0,,Келесі жолы: «Некочан тозағы»
Dialogue: 0,0:29:35.08,0:29:37.08,Default,,0,0,0,,Бұл екі кітап «Джигоку но Чимимомин»>
Dialogue: 0,0:29:38.58,0:29:44.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory