Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.14,0:00:03.14,Default,,0,0,0,,Келесі кездескенше!
Dialogue: 0,0:00:09.08,0:00:11.75,Default,,0,0,0,,<Онигами отбасының үш әпкесі тұратын үйде.
Dialogue: 0,0:00:11.75,0:00:15.42,Default,,0,0,0,,Тозақ мырза 12 Чимимомен келді.
Dialogue: 0,0:00:15.42,0:00:17.43,Default,,0,0,0,,Олар әлі білмейді
Dialogue: 0,0:00:17.43,0:00:19.76,Default,,0,0,0,,Олардың шынайы мақсаты
Dialogue: 0,0:00:19.76,0:00:23.10,Default,,0,0,0,,Мақсат адам әлемін тозаққа айналдыру болды>
Dialogue: 0,0:00:23.10,0:00:43.12,Default,,0,0,0,,Сен
Dialogue: 0,0:00:43.12,0:01:03.14,Default,,0,0,0,,Сен
Dialogue: 0,0:01:03.14,0:01:23.09,Default,,0,0,0,,Сен
Dialogue: 0,0:01:23.09,0:01:25.43,Default,,0,0,0,,Сен
Dialogue: 0,0:01:25.43,0:01:29.10,Default,,0,0,0,,Сен
Dialogue: 0,0:01:29.10,0:01:49.12,Default,,0,0,0,,Сен
Dialogue: 0,0:01:49.12,0:01:52.12,Default,,0,0,0,,Сен
Dialogue: 0,0:05:04.11,0:05:06.11,Default,,0,0,0,,«Некочан тозағы»
Dialogue: 0,0:05:08.12,0:05:10.78,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:05:10.78,0:05:12.79,Default,,0,0,0,,Ми~ Ми~
Dialogue: 0,0:05:12.79,0:05:15.19,Default,,0,0,0,,Ми~ Ми~
Dialogue: 0,0:05:17.79,0:05:19.79,Default,,0,0,0,,Чими~!
Dialogue: 0,0:05:19.79,0:05:22.46,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:05:22.46,0:05:24.47,Default,,0,0,0,,Чими
Dialogue: 0,0:05:24.47,0:05:26.47,Default,,0,0,0,,Чими? (Котенка) Ми~
Dialogue: 0,0:05:26.47,0:05:28.47,Default,,0,0,0,,Чими~
Dialogue: 0,0:05:28.47,0:05:30.47,Default,,0,0,0,,Чими (котенка) Ми~
Dialogue: 0,0:05:30.47,0:05:32.81,Default,,0,0,0,,Ми~ (котенка) Ми~
Dialogue: 0,0:05:32.81,0:05:34.81,Default,,0,0,0,,Чими~!
Dialogue: 0,0:05:34.81,0:05:37.14,Default,,0,0,0,,Чими~! Чими~!
Dialogue: 0,0:05:37.14,0:05:39.15,Default,,0,0,0,,Чими~!
Dialogue: 0,0:05:39.15,0:05:41.48,Default,,0,0,0,,Ми~ Ми~ Ми~
Dialogue: 0,0:05:41.48,0:05:43.48,Default,,0,0,0,,Чими?
Dialogue: 0,0:05:43.48,0:05:45.82,Default,,0,0,0,,...
Dialogue: 0,0:05:45.82,0:05:48.49,Default,,0,0,0,,Чими! (Кигами Муцуми) Ол да Чими емес пе?
Dialogue: 0,0:05:48.49,0:05:50.82,Default,,0,0,0,,Чимимо тек "чими" дейді
Dialogue: 0,0:05:50.82,0:05:54.83,Default,,0,0,0,,Аа~ Қызық, қаңғыбас мысық ішке кірді ме?
Dialogue: 0,0:05:54.83,0:05:56.83,Default,,0,0,0,,Қане, сақтайық.
Dialogue: 0,0:05:56.83,0:06:01.44,Default,,0,0,0,,Жоқ, 12 Чимимо бар. Үйіміз толып жатыр.
Dialogue: 0,0:06:01.44,0:06:03.77,Default,,0,0,0,,Азық-түлік те тұрады.
Dialogue: 0,0:06:03.77,0:06:07.78,Default,,0,0,0,,Әлде тозақ мырзаның шығуын сұраудан басқа амалымыз жоқ па?
Dialogue: 0,0:06:07.78,0:06:11.11,Default,,0,0,0,,Иә? Чи… чи…
Dialogue: 0,0:06:11.11,0:06:14.11,Default,,0,0,0,,Мысық? Жоқ, бұл чимимодаши
Dialogue: 0,0:06:14.11,0:06:16.45,Default,,0,0,0,,Сіз не ойнап жатырсыз?
Dialogue: 0,0:06:16.45,0:06:18.45,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:06:19.45,0:06:21.79,Default,,0,0,0,,Чими~
Dialogue: 0,0:06:21.79,0:06:23.79,Default,,0,0,0,,Жай... чими~!
Dialogue: 0,0:06:25.79,0:06:27.80,Default,,0,0,0,,Ми~
Dialogue: 0,0:06:27.80,0:06:31.50,Default,,0,0,0,,Бұл қауіпті! Бұл қауіпті! Мен қоқыс шығаруды ұмытып кетіппін!
Dialogue: 0,0:06:32.47,0:06:34.80,Default,,0,0,0,,Хаха хаа... Чими~
Dialogue: 0,0:06:34.80,0:06:36.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:36.80,0:06:38.81,Default,,0,0,0,,Хмм?
Dialogue: 0,0:06:38.81,0:06:40.81,Default,,0,0,0,,Чими…
Dialogue: 0,0:06:40.81,0:06:42.81,Default,,0,0,0,,Ойнайтын болсаң, қоқысты сұраймын.
Dialogue: 0,0:06:42.81,0:06:45.15,Default,,0,0,0,,Ми~ (Мистер Тозақ) «Ми~»?
Dialogue: 0,0:06:45.15,0:06:48.15,Default,,0,0,0,,Чими... Ми~ Чими~! Ми~!
Dialogue: 0,0:06:48.15,0:06:51.49,Default,,0,0,0,,Шулы! Мен алдым, алдым
Dialogue: 0,0:06:51.49,0:06:55.16,Default,,0,0,0,,Мен барамын! Бұл көзқарас жойылды!
Dialogue: 0,0:06:55.16,0:06:57.49,Default,,0,0,0,,Чими~
Dialogue: 0,0:06:57.49,0:07:00.09,Default,,0,0,0,,Чими Чими
Dialogue: 0,0:07:00.09,0:07:02.10,Default,,0,0,0,,Ми~ Ми~
Dialogue: 0,0:07:02.10,0:07:05.10,Default,,0,0,0,,Чими~ Чими!
Dialogue: 0,0:07:05.10,0:07:10.44,Default,,0,0,0,,Чими~!
Dialogue: 0,0:07:10.44,0:07:12.77,Default,,0,0,0,,Чими! Чими (котенка) Ми~
Dialogue: 0,0:07:12.77,0:07:14.78,Default,,0,0,0,,Чимимими!
Dialogue: 0,0:07:14.78,0:07:16.78,Default,,0,0,0,,Ми~
Dialogue: 0,0:07:16.78,0:07:20.11,Default,,0,0,0,,Чими~ Чи~ми Чими Чими
Dialogue: 0,0:07:20.11,0:07:22.12,Default,,0,0,0,,Ми~ Ми~
Dialogue: 0,0:07:22.12,0:07:24.45,Default,,0,0,0,,Чими (Цубаса) Мимими~
Dialogue: 0,0:07:24.45,0:07:28.45,Default,,0,0,0,,Сәлем! Біреу маған бақшаны тазалауға көмектесіңізші!
Dialogue: 0,0:07:31.12,0:07:35.80,Default,,0,0,0,,Олардың біртүрлі әрекет етуінің себебі бір нәрсеге көңілі толмауы.
Dialogue: 0,0:07:35.80,0:07:37.80,Default,,0,0,0,,Чими ми~!
Dialogue: 0,0:07:39.80,0:07:42.20,Default,,0,0,0,,Чими (котенка) Ми~
Dialogue: 0,0:07:43.14,0:07:45.47,Default,,0,0,0,,Чими~ Чими!
Dialogue: 0,0:07:45.47,0:07:47.81,Default,,0,0,0,,Мен сенің сонда екеніңді білемін.
Dialogue: 0,0:07:47.81,0:07:49.81,Default,,0,0,0,,Чими~ Чими~
Dialogue: 0,0:07:49.81,0:07:53.15,Default,,0,0,0,,Балалар, айтарларың бар, солай ма?
Dialogue: 0,0:07:53.15,0:07:57.82,Default,,0,0,0,,Бір-бірімізбен ашық сөйлесейік, жарай ма?
Dialogue: 0,0:07:57.82,0:07:59.75,Default,,0,0,0,,Сіздің жұмысыңыз қиын ба?
Dialogue: 0,0:07:59.75,0:08:02.09,Default,,0,0,0,,Әлде бұл жеке дау ма?
Dialogue: 0,0:08:02.09,0:08:05.09,Default,,0,0,0,,Мен филиалда жұмыс істеу қиын екенін түсінемін.
Dialogue: 0,0:08:05.09,0:08:07.09,Default,,0,0,0,,Жарайды, мен де солаймын.
Dialogue: 0,0:08:07.09,0:08:09.10,Default,,0,0,0,,Чими чими~!
Dialogue: 0,0:08:09.10,0:08:12.77,Default,,0,0,0,,Ағаның телефон қоңырауын алғанда қандай сезім болатынын ойлаңыз.
Dialogue: 0,0:08:12.77,0:08:14.77,Default,,0,0,0,,Тозақ!
Dialogue: 0,0:08:14.77,0:08:17.17,Default,,0,0,0,,Сәлем? А...?
Dialogue: 0,0:08:20.44,0:08:23.44,Default,,0,0,0,,Ми~ Ми~ Ми~
Dialogue: 0,0:08:23.44,0:08:25.44,Default,,0,0,0,,Чимими~!
Dialogue: 0,0:08:27.11,0:08:31.12,Default,,0,0,0,,Чими! Чими чичи... чими
Dialogue: 0,0:08:31.12,0:08:33.12,Default,,0,0,0,,Міне! иә?
Dialogue: 0,0:08:33.12,0:08:36.12,Default,,0,0,0,,(Химимотачидің ұйықтап жатқан тынысы)
Dialogue: 0,0:08:36.12,0:08:39.79,Default,,0,0,0,,Ұйқы... Түсіндім, көп жұмыс істеп жатырсың ба?
Dialogue: 0,0:08:39.79,0:08:42.80,Default,,0,0,0,,Иә, иә, дұрыс.
Dialogue: 0,0:08:42.80,0:08:44.80,Default,,0,0,0,,Ой, мен де ұйықтаймын.
Dialogue: 0,0:08:45.80,0:08:47.80,Default,,0,0,0,,Чими... (котенка) Ми~
Dialogue: 0,0:08:47.80,0:08:50.14,Default,,0,0,0,,Чимими Чимими
Dialogue: 0,0:08:54.47,0:08:57.14,Default,,0,0,0,,Ми~ Ми~ Чи~ми Чи~ми
Dialogue: 0,0:08:57.14,0:08:59.14,Default,,0,0,0,,Ми~
Dialogue: 0,0:09:00.75,0:09:03.45,Default,,0,0,0,,Чими~ Чими Чими!
Dialogue: 0,0:09:07.75,0:09:11.43,Default,,0,0,0,,Чими... Чими! (Котенка) Ми!
Dialogue: 0,0:09:11.43,0:09:13.73,Default,,0,0,0,,Чими
Dialogue: 0,0:09:16.43,0:09:18.73,Default,,0,0,0,,～
Dialogue: 0,0:09:19.77,0:09:24.44,Default,,0,0,0,,Чимимотачи Қарныңыз ашты ма? Кім тауық етін жейді?
Dialogue: 0,0:09:24.44,0:09:27.44,Default,,0,0,0,,Чими Чими Чими Чими
Dialogue: 0,0:09:27.44,0:09:30.44,Default,,0,0,0,,Чими Чими Чими Чими
Dialogue: 0,0:09:30.44,0:09:33.45,Default,,0,0,0,,Чими Чими Чими Чими
Dialogue: 0,0:09:33.45,0:09:35.78,Default,,0,0,0,,Ми~ Е, «Ми~»?
Dialogue: 0,0:09:35.78,0:09:37.78,Default,,0,0,0,,Чими~! Чими! Уау
Dialogue: 0,0:09:37.78,0:09:41.18,Default,,0,0,0,,～ ～
Dialogue: 0,0:09:43.12,0:09:46.13,Default,,0,0,0,,Қараңдар, қағаз, қағаз бар.
Dialogue: 0,0:09:46.13,0:09:48.13,Default,,0,0,0,,Еденде... чими
Dialogue: 0,0:09:48.13,0:09:50.80,Default,,0,0,0,,Иә! Кім осындай...
Dialogue: 0,0:09:50.80,0:09:53.80,Default,,0,0,0,,Чи... чими чими чими!
Dialogue: 0,0:09:53.80,0:09:55.80,Default,,0,0,0,,А... Чимимо?
Dialogue: 0,0:09:55.80,0:09:58.41,Default,,0,0,0,,～  ()
Dialogue: 0,0:09:58.41,0:10:01.41,Default,,0,0,0,,Не жоғалып кетті... Өте үлкен атқа скумбрия
Dialogue: 0,0:10:01.41,0:10:03.41,Default,,0,0,0,,Менен көзіңді алсаңшы!
Dialogue: 0,0:10:03.41,0:10:06.08,Default,,0,0,0,,Шынайы ма? ұры? Амал жоқ...
Dialogue: 0,0:10:06.08,0:10:09.42,Default,,0,0,0,,Чими~! Чими Чими
Dialogue: 0,0:10:09.42,0:10:12.09,Default,,0,0,0,,Ааа~ Мен жақсы ұйықтадым... Не болды?
Dialogue: 0,0:10:12.09,0:10:14.09,Default,,0,0,0,,Чими~ (Мистер Тозақ) Иә?
Dialogue: 0,0:10:14.09,0:10:16.76,Default,,0,0,0,,Тозақ, сен бұл өтірікті жедің бе?
Dialogue: 0,0:10:16.76,0:10:18.76,Default,,0,0,0,,Иә? Жалғыз ба?
Dialogue: 0,0:10:18.76,0:10:20.76,Default,,0,0,0,,Тек раунд? Барлығы үшін бе? Эх...
Dialogue: 0,0:10:20.76,0:10:22.76,Default,,0,0,0,,Жын! Ха!
Dialogue: 0,0:10:22.76,0:10:26.43,Default,,0,0,0,,Хаха~ (Тозақ) Иә? иә?
Dialogue: 0,0:10:26.43,0:10:30.44,Default,,0,0,0,,Сіздің отбасыңыздың тағамдары туралы не ойлайсыз?
Dialogue: 0,0:10:30.44,0:10:33.14,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:34.78,0:10:36.78,Default,,0,0,0,,(Гүлдердің шайнау дыбысы)
Dialogue: 0,0:10:36.78,0:10:39.45,Default,,0,0,0,,Уф...не болып жатыр?
Dialogue: 0,0:10:39.45,0:10:42.78,Default,,0,0,0,,Кенет ашулану соншалықты орынсыз.
Dialogue: 0,0:10:42.78,0:10:44.78,Default,,0,0,0,,(шайнаған гүлдердің дыбысы)
Dialogue: 0,0:10:45.79,0:10:47.79,Default,,0,0,0,,Ми~
Dialogue: 0,0:10:47.79,0:10:49.79,Default,,0,0,0,,Иә? мысық?
Dialogue: 0,0:10:52.13,0:10:57.13,Default,,0,0,0,,Хаха... Балалар, сендер мына жігітті жасырдыңдар ма?
Dialogue: 0,0:10:57.13,0:11:00.40,Default,,0,0,0,,Чими! Чимичими чимикими!
Dialogue: 0,0:11:00.40,0:11:02.40,Default,,0,0,0,,Мен білдім
Dialogue: 0,0:11:02.40,0:11:04.40,Default,,0,0,0,,Чими~ (котенка) Ми~
Dialogue: 0,0:11:04.40,0:11:07.07,Default,,0,0,0,,Мысықты көтеру дегенді қалай түсінесіңдер?
Dialogue: 0,0:11:07.07,0:11:09.08,Default,,0,0,0,,Чимими~ Чими
Dialogue: 0,0:11:09.08,0:11:11.75,Default,,0,0,0,,Аш қарға мені қорқытты ма?
Dialogue: 0,0:11:11.75,0:11:13.75,Default,,0,0,0,,...Сонымен сіз оны сақтағыңыз келе ме?
Dialogue: 0,0:11:13.75,0:11:16.75,Default,,0,0,0,,Қызық, анау апа не дер еді...
Dialogue: 0,0:11:16.75,0:11:18.75,Default,,0,0,0,,《Уау! 》
Dialogue: 0,0:11:18.75,0:11:20.75,Default,,0,0,0,,Чими чимими…
Dialogue: 0,0:11:20.75,0:11:23.76,Default,,0,0,0,,《Жоқ, 12 Чимимо бар.
Dialogue: 0,0:11:23.76,0:11:25.76,Default,,0,0,0,,Біздің үй толы》
Dialogue: 0,0:11:25.76,0:11:28.43,Default,,0,0,0,,《Әлде тозақ мырзаның шығуын сұраудан басқа амалымыз жоқ па? 》
Dialogue: 0,0:11:28.43,0:11:31.10,Default,,0,0,0,,Гарн! Неге мен?
Dialogue: 0,0:11:31.10,0:11:33.10,Default,,0,0,0,,Мен сенің шыққаныңды қаламаймын!
Dialogue: 0,0:11:33.10,0:11:36.44,Default,,0,0,0,,Дәл қазір мысықты бір жерге лақтырыңыз.
Dialogue: 0,0:11:36.44,0:11:39.14,Default,,0,0,0,,Ми~ (Мистер Тозақ) Ух...
Dialogue: 0,0:11:41.44,0:11:43.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:44.44,0:11:48.78,Default,,0,0,0,,Ах! Ой… ой… ой…
Dialogue: 0,0:11:48.78,0:11:51.79,Default,,0,0,0,,Они өте сүйкімді!
Dialogue: 0,0:11:51.79,0:11:54.45,Default,,0,0,0,,Сүйкімді мияу~
Dialogue: 0,0:11:54.45,0:11:57.46,Default,,0,0,0,,Ах! Бірақ бұл үшеуі білсе, тозақ болар еді...
Dialogue: 0,0:11:57.46,0:11:59.73,Default,,0,0,0,,А, шынымен мысық бар!
Dialogue: 0,0:11:59.73,0:12:01.73,Default,,0,0,0,,Сүйкімді О, тәңірім
Dialogue: 0,0:12:01.73,0:12:04.06,Default,,0,0,0,,Уау! Чими~!
Dialogue: 0,0:12:04.06,0:12:07.07,Default,,0,0,0,,Ах, а... а!
Dialogue: 0,0:12:07.07,0:12:09.07,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:12:09.07,0:12:11.07,Default,,0,0,0,,Сен қайда бардың? Іздеу!
Dialogue: 0,0:12:11.07,0:12:13.37,Default,,0,0,0,,Чими! Ах...
Dialogue: 0,0:12:14.41,0:12:18.11,Default,,0,0,0,,Мм... Тағы да қарғаның қолына түссем, қиналып қаламын.
Dialogue: 0,0:12:19.08,0:12:21.38,Default,,0,0,0,,Чими Чими
Dialogue: 0,0:12:23.42,0:12:25.42,Default,,0,0,0,,Чими~!
Dialogue: 0,0:12:26.75,0:12:29.45,Default,,0,0,0,,Уууу... Чими
Dialogue: 0,0:12:33.09,0:12:35.43,Default,,0,0,0,,()
Dialogue: 0,0:12:35.43,0:12:37.43,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:12:37.43,0:12:39.43,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:12:39.43,0:12:42.10,Default,,0,0,0,,Сәлем! Шуш!
Dialogue: 0,0:12:42.10,0:12:44.70,Default,,0,0,0,,Иә? Уф...
Dialogue: 0,0:12:48.44,0:12:51.78,Default,,0,0,0,,Хаа... қайда бардың?
Dialogue: 0,0:12:51.78,0:12:53.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:54.78,0:12:59.12,Default,,0,0,0,,Кешіріңіз, мұнда мысық бар...
Dialogue: 0,0:12:59.12,0:13:01.12,Default,,0,0,0,,Чими! Әй, мысық!
Dialogue: 0,0:13:01.12,0:13:04.46,Default,,0,0,0,,Ми~ (Тозақ-сан) Балалар, не істеп жатырсыңдар?
Dialogue: 0,0:13:04.46,0:13:06.79,Default,,0,0,0,,Эй, сен осындасың ба?
Dialogue: 0,0:13:06.79,0:13:08.80,Default,,0,0,0,,Ми~
Dialogue: 0,0:13:08.80,0:13:11.13,Default,,0,0,0,,Мама саған қамқор болады.
Dialogue: 0,0:13:11.13,0:13:13.47,Default,,0,0,0,,Маған да көп күріш беріңіз~
Dialogue: 0,0:13:13.47,0:13:15.80,Default,,0,0,0,,Мысық... жақсы болды ма?
Dialogue: 0,0:13:15.80,0:13:19.14,Default,,0,0,0,,Чими Чими~
Dialogue: 0,0:13:19.14,0:13:21.14,Default,,0,0,0,,Чимичими (котенка) Ми~
Dialogue: 0,0:13:21.14,0:13:24.48,Default,,0,0,0,,Мысық Сенің мұнда өз бетімен кезіп жүргеніңді естідім.
Dialogue: 0,0:13:24.48,0:13:28.48,Default,,0,0,0,,Біз келгенше ол анасына байланып қалған.
Dialogue: 0,0:13:28.48,0:13:31.48,Default,,0,0,0,,Менің балам болайық (котенка) Ми~
Dialogue: 0,0:13:31.48,0:13:35.16,Default,,0,0,0,,Түсінемін, оны осында сақтау жақсы идея болуы мүмкін.
Dialogue: 0,0:13:35.16,0:13:37.82,Default,,0,0,0,,Егер ол осында болса, мен сені кез келген уақытта көремін.
Dialogue: 0,0:13:37.82,0:13:40.49,Default,,0,0,0,,Чими~ (Теамама) Кимета!
Dialogue: 0,0:13:40.49,0:13:42.50,Default,,0,0,0,,Сен бүгіннен бастап Джулисің.
Dialogue: 0,0:13:42.50,0:13:44.83,Default,,0,0,0,,Джули? (Мама көңілді) Менен аудармасын сұрамаңыз!
Dialogue: 0,0:13:44.83,0:13:47.83,Default,,0,0,0,,Бұл туралы айту тым ұзақ (Тозақ мырза) А, онда...
Dialogue: 0,0:13:47.83,0:13:50.84,Default,,0,0,0,,Себебі менің бұрынғы жігітім қарыз.
Dialogue: 0,0:13:50.84,0:13:54.17,Default,,0,0,0,,Мен Аргентинаға қашқанда не болды?
Dialogue: 0,0:13:54.17,0:13:57.51,Default,,0,0,0,,Мен таулардың тереңінде Юлийге тап болдым...
Dialogue: 0,0:13:57.51,0:13:59.45,Default,,0,0,0,,Бұл Джули болатын.
Dialogue: 0,0:13:59.45,0:14:02.12,Default,,0,0,0,,Уф... Жарайды, таңға дейін курс.
Dialogue: 0,0:14:02.12,0:14:04.12,Default,,0,0,0,,Ми~ Чими~
Dialogue: 0,0:16:37.10,0:16:39.40,Default,,0,0,0,,«Тозақ жоқ Чимимомин»
Dialogue: 0,0:16:45.45,0:16:49.45,Default,,0,0,0,,～
Dialogue: 0,0:16:49.45,0:16:53.45,Default,,0,0,0,,Хмм... мм... қазір сағат неше?
Dialogue: 0,0:16:53.45,0:16:57.12,Default,,0,0,0,,Ита-тата... Мен тым көп іштім.
Dialogue: 0,0:16:57.12,0:17:01.46,Default,,0,0,0,,...
Dialogue: 0,0:17:01.46,0:17:05.47,Default,,0,0,0,,Менің есімде жоқ және сұрағым да келмейді...
Dialogue: 0,0:17:05.47,0:17:08.77,Default,,0,0,0,,Чими~ Чими~
Dialogue: 0,0:17:09.80,0:17:13.81,Default,,0,0,0,,Не? Бұл не... жақсы...
Dialogue: 0,0:17:13.81,0:17:17.48,Default,,0,0,0,,～
Dialogue: 0,0:17:17.48,0:17:20.08,Default,,0,0,0,,Ах~
Dialogue: 0,0:17:20.08,0:17:23.75,Default,,0,0,0,,Тозақ, Хазуки дүкеніне барыңыз.
Dialogue: 0,0:17:23.75,0:17:26.15,Default,,0,0,0,,Не, мен?
Dialogue: 0,0:17:29.76,0:17:33.09,Default,,0,0,0,,Эй, Хазуки, саған аздап бере аласың ба?
Dialogue: 0,0:17:33.09,0:17:35.76,Default,,0,0,0,,Менің әмиян бар.
Dialogue: 0,0:17:35.76,0:17:39.77,Default,,0,0,0,,Жүгіңіз болмаса, оларды неге алып кетесіз?
Dialogue: 0,0:17:39.77,0:17:41.77,Default,,0,0,0,,А, бұл Чими де?
Dialogue: 0,0:17:41.77,0:17:43.77,Default,,0,0,0,,Асқазанға жақсы сияқты.
Dialogue: 0,0:17:43.77,0:17:46.11,Default,,0,0,0,,Бас ауруым жазылды.
Dialogue: 0,0:17:46.11,0:17:48.11,Default,,0,0,0,,Мен «Хан Харири» деп аталатын базарға (сук) шағын сауда орны басқарамын
Dialogue: 0,0:17:48.11,0:17:50.78,Default,,0,0,0,,Бұл сіздің иықтарыңызды босаңсытады және сіздің беліңіз үшін де жақсы болуы мүмкін.
Dialogue: 0,0:17:50.78,0:17:52.78,Default,,0,0,0,,Сіз оны көлікке бергіңіз келе ме?
Dialogue: 0,0:17:52.78,0:17:55.11,Default,,0,0,0,,Жоқ, жоқ, одан ауыр болуы мүмкін емес.
Dialogue: 0,0:17:55.11,0:17:57.12,Default,,0,0,0,,Сендер-ай, шіркін!
Dialogue: 0,0:17:57.12,0:17:59.45,Default,,0,0,0,,Не? Бұл қатты иықтар үшін жұмыс істей ме?
Dialogue: 0,0:17:59.45,0:18:01.45,Default,,0,0,0,,Ах, «Аспанның» анасы
Dialogue: 0,0:18:01.45,0:18:04.12,Default,,0,0,0,,Маған аздап қарыз беріңізші.
Dialogue: 0,0:18:04.12,0:18:07.13,Default,,0,0,0,,Чи-ми Чи-ми
Dialogue: 0,0:18:07.13,0:18:09.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:09.46,0:18:11.80,Default,,0,0,0,,О, жақсы!
Dialogue: 0,0:18:11.80,0:18:13.80,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:18:13.80,0:18:17.14,Default,,0,0,0,,Сонымен, сіз тәтті анасыз ба? Сіз мұнда не істеп жүрсіз?
Dialogue: 0,0:18:17.14,0:18:20.74,Default,,0,0,0,,Бұл кезек, менің кезегімді алу қиын.
Dialogue: 0,0:18:20.74,0:18:23.41,Default,,0,0,0,,Массаж?
Dialogue: 0,0:18:23.41,0:18:26.08,Default,,0,0,0,,5000 иен? 15 минутта?
Dialogue: 0,0:18:26.08,0:18:29.75,Default,,0,0,0,,Бұл адамдардың әлсіз тұстарын пайдаланатын бизнес, солай емес пе?
Dialogue: 0,0:18:29.75,0:18:32.09,Default,,0,0,0,,Магниттік суперқорытпа жабыны дегеніміз не?
Dialogue: 0,0:18:32.09,0:18:35.09,Default,,0,0,0,,Соңғы уақытта ол өте тиімді ретінде беделге ие болды.
Dialogue: 0,0:18:35.09,0:18:38.42,Default,,0,0,0,,Ах~ Бірақ бұл бала осында болса, маған керек емес шығар~
Dialogue: 0,0:18:38.42,0:18:40.43,Default,,0,0,0,,Ах~ Жақсы...
Dialogue: 0,0:18:40.43,0:18:43.76,Default,,0,0,0,,Келесі жолы мені дүкенге әкелсең, мен саған алкогольді тегін беремін.
Dialogue: 0,0:18:43.76,0:18:45.77,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:18:45.77,0:18:48.47,Default,,0,0,0,,Хэхе... бұл жұмыс істейді.
Dialogue: 0,0:18:51.44,0:18:54.77,Default,,0,0,0,,Емдеу сәті 15 минут небәрі 500 иен!
Dialogue: 0,0:18:54.77,0:18:56.78,Default,,0,0,0,,Сізге қалай ұнайды?
Dialogue: 0,0:18:56.78,0:19:00.78,Default,,0,0,0,,15 минут бар болғаны 500 иен! Ол арзандап барады!
Dialogue: 0,0:19:00.78,0:19:03.45,Default,,0,0,0,,Өтінемін (Мистер Тозақ) Мұнда келіңіз.
Dialogue: 0,0:19:03.45,0:19:05.79,Default,,0,0,0,,Екеуіңізге де ақпарат!
Dialogue: 0,0:19:05.79,0:19:07.79,Default,,0,0,0,,Чими~
Dialogue: 0,0:19:07.79,0:19:11.46,Default,,0,0,0,,Ах! Ах... Чими~ Чими~
Dialogue: 0,0:19:11.46,0:19:13.79,Default,,0,0,0,,Ах... жақсы...
Dialogue: 0,0:19:13.79,0:19:18.40,Default,,0,0,0,,Иә, әркім өз тапсырмалары мен есептеріне алаңдайды.
Dialogue: 0,0:19:18.40,0:19:20.40,Default,,0,0,0,,Майдо~!
Dialogue: 0,0:19:20.40,0:19:22.74,Default,,0,0,0,,Уау~ (А оқушы) Өте жақсы сезіледі~
Dialogue: 0,0:19:22.74,0:19:24.74,Default,,0,0,0,,«Бастап көріп, не боларын көрейік» дегендей. Хмм…
Dialogue: 0,0:19:26.07,0:19:29.41,Default,,0,0,0,,Эй Хазуки, мен 500 иен монеталарын көбірек жинап жатырмын!
Dialogue: 0,0:19:29.41,0:19:32.75,Default,,0,0,0,,Біз баймыз! Хехехе
Dialogue: 0,0:19:32.75,0:19:36.42,Default,,0,0,0,,Егер сіз бір тиынмен емдесеңіз, бұл тегін ~
Dialogue: 0,0:19:36.42,0:19:38.75,Default,,0,0,0,,Бізде қазірдің өзінде тұрақты адамдар бола бастады!
Dialogue: 0,0:19:38.75,0:19:41.42,Default,,0,0,0,,Омочи-сенсэй, өтінемін.
Dialogue: 0,0:19:41.42,0:19:44.76,Default,,0,0,0,,Иә! Танысқаныма қуаныштымын, Омочи мырза!
Dialogue: 0,0:19:44.76,0:19:46.76,Default,,0,0,0,,Чими! Чими
Dialogue: 0,0:19:46.76,0:19:50.10,Default,,0,0,0,,Ух... аа... аа~ Чими Чими~ Чими
Dialogue: 0,0:19:50.10,0:19:53.10,Default,,0,0,0,,Сіз өзіңіздің сүйікті химимоңызды ұсына аласыз!
Dialogue: 0,0:19:53.10,0:19:56.10,Default,,0,0,0,,Ерінбей еңбек еткендерге мол сый!
Dialogue: 0,0:19:56.10,0:19:58.10,Default,,0,0,0,,Иә
Dialogue: 0,0:19:59.77,0:20:05.11,Default,,0,0,0,,Хехе, бәрі бақытты! Бұл шынымен де ұтысқа түсетін бизнес!
Dialogue: 0,0:20:05.11,0:20:07.45,Default,,0,0,0,,Ах~ Мочи-сенсэй өте жақсы~
Dialogue: 0,0:20:07.45,0:20:09.78,Default,,0,0,0,,Бізге қайта келіңіз!
Dialogue: 0,0:20:09.78,0:20:13.45,Default,,0,0,0,,()  …
Dialogue: 0,0:20:13.45,0:20:15.46,Default,,0,0,0,,Хехехе
Dialogue: 0,0:20:15.46,0:20:18.39,Default,,0,0,0,,Ах! 1 миллион иен өнер ағасы!
Dialogue: 0,0:20:18.39,0:20:20.73,Default,,0,0,0,,Чими~ Чими~
Dialogue: 0,0:20:20.73,0:20:23.73,Default,,0,0,0,,О! Көптен бері көрмеген
Dialogue: 0,0:20:23.73,0:20:27.73,Default,,0,0,0,,Қалайсың? Әдеттегідей сүйкімді
Dialogue: 0,0:20:27.73,0:20:31.07,Default,,0,0,0,,Жарайды, жарайды хахахаха Чими~
Dialogue: 0,0:20:31.07,0:20:33.07,Default,,0,0,0,,Бірақ университетке не үшін бару керек?
Dialogue: 0,0:20:33.07,0:20:37.08,Default,,0,0,0,,Осы залда өз коллекциямыздан көрме ұйымдастырамыз.
Dialogue: 0,0:20:37.08,0:20:39.08,Default,,0,0,0,,Жоқ, өнер мектебі жақсы.
Dialogue: 0,0:20:39.08,0:20:42.08,Default,,0,0,0,,Өнер жастық зұлматтан шығады!
Dialogue: 0,0:20:42.08,0:20:45.08,Default,,0,0,0,,Мен көремін... түсінемін. Хахаха…
Dialogue: 0,0:20:45.08,0:20:48.76,Default,,0,0,0,,Сонымен… сіздің жаңа жұмысыңыз қатысу өнері ме?
Dialogue: 0,0:20:48.76,0:20:51.42,Default,,0,0,0,,Не? Мен осында отыруым керек пе?
Dialogue: 0,0:20:51.42,0:20:53.76,Default,,0,0,0,,Жоқ, бұл өнер емес...
Dialogue: 0,0:20:53.76,0:20:57.43,Default,,0,0,0,,Қызмет ақысы: 15 минут 500 иен (алдын ала төленген)
Dialogue: 0,0:20:57.43,0:20:59.43,Default,,0,0,0,,Не? Эй!
Dialogue: 0,0:20:59.43,0:21:01.43,Default,,0,0,0,,10 000 иен!
Dialogue: 0,0:21:01.43,0:21:03.44,Default,,0,0,0,,Сезімталдығыңызға байланысты
Dialogue: 0,0:21:03.44,0:21:05.77,Default,,0,0,0,,Маған қалағаныңызша қызмет етіңіз.
Dialogue: 0,0:21:05.77,0:21:07.77,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:07.77,0:21:10.11,Default,,0,0,0,,Чимимотачи қызметі!
Dialogue: 0,0:21:10.11,0:21:12.11,Default,,0,0,0,,Чими~!
Dialogue: 0,0:21:12.11,0:21:14.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:14.78,0:21:19.05,Default,,0,0,0,,Чими~ (бай) Ах... жақсы...
Dialogue: 0,0:21:19.05,0:21:21.39,Default,,0,0,0,,Ұзартуды сұраңыз
Dialogue: 0,0:21:21.39,0:21:23.39,Default,,0,0,0,,Майдо бар~! (Shareots) Чими
Dialogue: 0,0:21:23.39,0:21:27.06,Default,,0,0,0,,Чими чими мими чими мими (бай)... Хмм...
Dialogue: 0,0:21:27.06,0:21:30.40,Default,,0,0,0,,Бұл келе жатыр. Келіп жатыр...
Dialogue: 0,0:21:30.40,0:21:33.07,Default,,0,0,0,,Чими~
Dialogue: 0,0:21:33.07,0:21:38.07,Default,,0,0,0,,Чимимими Чимимими (бай) Ах... тыныштандырады~
Dialogue: 0,0:21:38.07,0:21:40.07,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:21:41.41,0:21:46.41,Default,,0,0,0,,Уау, бұл керемет болды. Мен қайта ораламын. Хахахаха
Dialogue: 0,0:21:46.41,0:21:48.75,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:21:48.75,0:21:50.75,Default,,0,0,0,,Қайта келіңіз!
Dialogue: 0,0:21:50.75,0:21:53.09,Default,,0,0,0,,Yahoo! Мен пайда таптым!
Dialogue: 0,0:21:53.09,0:21:55.09,Default,,0,0,0,,(ДжоДжо) Мен ең жоғарғысынан ең төменгісіне дейін әрбір картаны атай аламын
Dialogue: 0,0:21:55.09,0:21:57.09,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:22:00.09,0:22:04.76,Default,,0,0,0,,Пхуха~! Жүр, қолыңнан келгенше жей бер, бұл менің рахатым.
Dialogue: 0,0:22:04.76,0:22:06.76,Default,,0,0,0,,(Аттың айғайы)
Dialogue: 0,0:22:08.43,0:22:10.44,Default,,0,0,0,,О, жақсы ет!
Dialogue: 0,0:22:10.44,0:22:13.44,Default,,0,0,0,,Сіз сонша ақша таптыңыз ба? Қандай толық емес жұмыс күні?
Dialogue: 0,0:22:13.44,0:22:17.11,Default,,0,0,0,,Емдік өнер Бұл не? Күдікті
Dialogue: 0,0:22:17.11,0:22:19.41,Default,,0,0,0,,Тозақ та солай емес пе?
Dialogue: 0,0:22:21.05,0:22:24.05,Default,,0,0,0,,Мен адам әлемінде бірінші рет осыншама ақша тауып отырмын.
Dialogue: 0,0:22:24.05,0:22:27.05,Default,,0,0,0,,Бағалану және ақша алу керемет!
Dialogue: 0,0:22:27.05,0:22:29.72,Default,,0,0,0,,Сәлем? Балалар чими мими чими~!
Dialogue: 0,0:22:29.72,0:22:32.39,Default,,0,0,0,,Хмм, сосын қалта ақшасы.
Dialogue: 0,0:22:32.39,0:22:34.39,Default,,0,0,0,,Жарайсың ба?
Dialogue: 0,0:22:34.39,0:22:36.73,Default,,0,0,0,,Иә, мен жасадым!
Dialogue: 0,0:22:36.73,0:22:40.07,Default,,0,0,0,,Барлығын жеңіңіз! Ахахха!
Dialogue: 0,0:22:40.07,0:22:42.74,Default,,0,0,0,,Ахахха ахахха!
Dialogue: 0,0:22:42.74,0:22:44.74,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:22:46.41,0:22:48.41,Default,,0,0,0,,Хаа…
Dialogue: 0,0:22:48.41,0:22:52.08,Default,,0,0,0,,Олай болса, бүгін қолымыздан келгенді жасайық, барлығымыз! (Мистер Тозақ) О!
Dialogue: 0,0:22:52.08,0:22:54.08,Default,,0,0,0,,Хаа…
Dialogue: 0,0:22:54.08,0:22:56.75,Default,,0,0,0,,Әй, профессор! Қош келдіңіз!
Dialogue: 0,0:22:56.75,0:22:59.09,Default,,0,0,0,,Қызмет ақысы 15 минут 500 иен
Dialogue: 0,0:22:59.09,0:23:01.42,Default,,0,0,0,,Сізде неше минут бар?
Dialogue: 0,0:23:01.42,0:23:06.09,Default,,0,0,0,,Хаа... Кишин-кун, сен бүгін таңертең сабақта болмадың.
Dialogue: 0,0:23:06.09,0:23:10.43,Default,,0,0,0,,Иә! Әй, эй... басым ауырып тұр.
Dialogue: 0,0:23:10.43,0:23:12.77,Default,,0,0,0,,Сіздің бөлімшеңіз қауіпті емес пе?
Dialogue: 0,0:23:12.77,0:23:15.77,Default,,0,0,0,,Иә! А... бірақ бұл өнер.
Dialogue: 0,0:23:15.77,0:23:17.77,Default,,0,0,0,,Қатысушы емшілік өнері
Dialogue: 0,0:23:17.77,0:23:22.04,Default,,0,0,0,,Емдеу... Ха...
Dialogue: 0,0:23:22.04,0:23:25.71,Default,,0,0,0,,Өтінемін... мына жерге отырыңыз.
Dialogue: 0,0:23:25.71,0:23:27.71,Default,,0,0,0,,Эй, алдын ала төле.
Dialogue: 0,0:23:27.71,0:23:30.05,Default,,0,0,0,,Сіздің таңдауыңыз жоқ, Бірлік Бұл қауіпті!
Dialogue: 0,0:23:30.05,0:23:34.05,Default,,0,0,0,,Чимитти Чимитти Чимитти Чимитти
Dialogue: 0,0:23:34.05,0:23:38.06,Default,,0,0,0,,Хаа... Жұмыс істейді... Чими чимимими
Dialogue: 0,0:23:38.06,0:23:40.73,Default,,0,0,0,,Сіз қалай ойлайсыз? емдік өнер
Dialogue: 0,0:23:40.73,0:23:43.06,Default,,0,0,0,,Менде несие алуға бола ма? Ах...
Dialogue: 0,0:23:43.06,0:23:45.73,Default,,0,0,0,,Хаа... Келесі Сол бала
Dialogue: 0,0:23:45.73,0:23:47.73,Default,,0,0,0,,Иә? тістері?
Dialogue: 0,0:23:49.40,0:23:51.70,Default,,0,0,0,,Сәлем! Апыр-ай! Чими~!
Dialogue: 0,0:23:53.74,0:23:57.41,Default,,0,0,0,,Иә? иә? өлді! Ол қайтадан осында болды.
Dialogue: 0,0:23:57.41,0:23:59.41,Default,,0,0,0,,Чимими~!
Dialogue: 0,0:23:59.41,0:24:01.41,Default,,0,0,0,,<Ол не үшін келді?
Dialogue: 0,0:24:01.41,0:24:04.08,Default,,0,0,0,,Адам әлемін тозаққа айналдыру жоспары ілгері баспайды.
Dialogue: 0,0:24:04.08,0:24:08.09,Default,,0,0,0,,Егер сенің бұлай істеп жатқаныңды білсек, тозақта боласыңдар! >
Dialogue: 0,0:24:08.09,0:24:10.42,Default,,0,0,0,,Иә, профессор, өтінемін!
Dialogue: 0,0:24:10.42,0:24:12.76,Default,,0,0,0,,А, бұл жақсы емес! Мен сәуле жіберемін!
Dialogue: 0,0:24:12.76,0:24:14.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:14.76,0:24:16.76,Default,,0,0,0,,Сен мұнда не үшін келдің? Эх...
Dialogue: 0,0:24:18.10,0:24:22.70,Default,,0,0,0,,Ах! Жоқ, бұл адам әлемін тозаққа айналдыру жоспарының бір бөлігі.
Dialogue: 0,0:24:22.70,0:24:26.71,Default,,0,0,0,,Адамдарды сауықтырамыз деген атпен Чими-Морёуға ие болыңыз.
Dialogue: 0,0:24:26.71,0:24:30.71,Default,,0,0,0,,Мен саған тозақ азабын таттырамын...
Dialogue: 0,0:24:30.71,0:24:34.71,Default,,0,0,0,,Сіз не істеп жатырсыз, Тозақ мырза, профессорға дұрыс қызмет көрсетіңізші?
Dialogue: 0,0:24:34.71,0:24:37.38,Default,,0,0,0,,Жарайды... Жарайды, барлық мүшелер жіберілді!
Dialogue: 0,0:24:37.38,0:24:39.39,Default,,0,0,0,,Чими! Чими!
Dialogue: 0,0:24:39.39,0:24:41.72,Default,,0,0,0,,Мұқият орындаңыз!
Dialogue: 0,0:24:41.72,0:24:45.06,Default,,0,0,0,,Чими Чими Чими
Dialogue: 0,0:24:45.06,0:24:48.73,Default,,0,0,0,,Ах... жұмыс істейді~ Ах...
Dialogue: 0,0:24:48.73,0:24:50.73,Default,,0,0,0,,О...
Dialogue: 0,0:24:50.73,0:24:54.07,Default,,0,0,0,,Сол азаптың көрінісін қараңыз.
Dialogue: 0,0:24:54.07,0:24:56.07,Default,,0,0,0,,Қарқындырақ! көбірек!
Dialogue: 0,0:24:56.07,0:24:59.07,Default,,0,0,0,,Чими чими чими! (Профессор күрсініп) А-а-а-а...
Dialogue: 0,0:25:00.07,0:25:03.08,Default,,0,0,0,,Ах... у... ха...
Dialogue: 0,0:25:03.08,0:25:07.41,Default,,0,0,0,,Хахахаха Сіз қалай ойлайсыз? Көбірек айқайлаңыз!
Dialogue: 0,0:25:07.41,0:25:10.11,Default,,0,0,0,,Иә? Мистер өлді, иә? Эх...
Dialogue: 0,0:25:11.75,0:25:15.42,Default,,0,0,0,,Чи-ми! Чими Чими (Профессор күрсініп) Ахххх...
Dialogue: 0,0:25:15.42,0:25:17.76,Default,,0,0,0,,Қатты жақын қашықтықтағы шайқаста ол дерлік ешқандай осал тұс қалдырмайды—
Dialogue: 0,0:25:17.76,0:25:19.76,Default,,0,0,0,,Ши... қыңыр жігіт.
Dialogue: 0,0:25:19.76,0:25:22.09,Default,,0,0,0,,Егер бұлай болса, аспаннан жасаңыз!
Dialogue: 0,0:25:22.09,0:25:24.43,Default,,0,0,0,,Чими Чими Чими
Dialogue: 0,0:25:24.43,0:25:27.43,Default,,0,0,0,,Чимими! Чимимими (Профессор күрсініп) А... аа...
Dialogue: 0,0:25:27.43,0:25:29.73,Default,,0,0,0,,А... күте тұрыңыз... бұл тым көп емес пе?
Dialogue: 0,0:25:31.77,0:25:34.44,Default,,0,0,0,,Маған тозақтың сұмдығын айт!
Dialogue: 0,0:25:34.44,0:25:38.11,Default,,0,0,0,,Чими чими чими чими! (Профессор күрсініп) Хааааааааааааааааааааааа
Dialogue: 0,0:25:38.11,0:25:40.11,Default,,0,0,0,,Тозаққа кет!
Dialogue: 0,0:25:40.11,0:25:42.11,Default,,0,0,0,,Чими! (соққы дыбысы)
Dialogue: 0,0:25:42.11,0:25:45.12,Default,,0,0,0,,Чими? Чимими…
Dialogue: 0,0:25:45.12,0:25:47.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:47.12,0:25:49.79,Default,,0,0,0,,Сіз қалай ойлайсыз? Осы жолы келдің бе?
Dialogue: 0,0:25:49.79,0:25:54.46,Default,,0,0,0,,А... жақсы болды, арқам өсті...
Dialogue: 0,0:25:54.46,0:25:57.46,Default,,0,0,0,,Ия... бұл жақсы... у...
Dialogue: 0,0:25:58.80,0:26:01.80,Default,,0,0,0,,Ух... чими чими чими
Dialogue: 0,0:26:01.80,0:26:03.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:03.80,0:26:06.47,Default,,0,0,0,,Уау, профессор! Бұл шынымен жақсы болды ма?
Dialogue: 0,0:26:06.47,0:26:08.47,Default,,0,0,0,,Емдік өнер
Dialogue: 0,0:26:09.81,0:26:13.15,Default,,0,0,0,,Уау...! Бұл орын алса...
Dialogue: 0,0:26:13.15,0:26:15.15,Default,,0,0,0,,Ха... онда үйге қайтайық.
Dialogue: 0,0:26:15.15,0:26:17.15,Default,,0,0,0,,Менің қашып кетуіме рұқсат бересің бе?
Dialogue: 0,0:26:17.15,0:26:22.09,Default,,0,0,0,,Сендей қыңыр адам осылай жасайды!
Dialogue: 0,0:26:22.09,0:26:24.76,Default,,0,0,0,,Ахаха... Тозақ мырза, бұл тым көп!
Dialogue: 0,0:26:24.76,0:26:28.76,Default,,0,0,0,,Бейбақ, бейбақ, тозаққа кет!
Dialogue: 0,0:26:28.76,0:26:30.76,Default,,0,0,0,,Қабыл ал! (Профессор күрсініп) А-а!
Dialogue: 0,0:26:30.76,0:26:32.77,Default,,0,0,0,,Ах! (Мистер Тозақ) Ах!
Dialogue: 0,0:26:32.77,0:26:34.77,Default,,0,0,0,,Уау! Чими!
Dialogue: 0,0:26:37.10,0:26:41.44,Default,,0,0,0,,Уау... Профессор! Профессор!
Dialogue: 0,0:26:41.44,0:26:43.44,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:26:43.44,0:26:45.44,Default,,0,0,0,,А... А, ол тірі еді.
Dialogue: 0,0:26:45.44,0:26:49.45,Default,,0,0,0,,Профессор: Бұл қалай болды? емдік өнер
Dialogue: 0,0:26:49.45,0:26:51.45,Default,,0,0,0,,Хаа…
Dialogue: 0,0:26:52.79,0:26:55.79,Default,,0,0,0,,0 ұпай Га!
Dialogue: 0,0:26:55.79,0:26:57.79,Default,,0,0,0,,Иә...
Dialogue: 0,0:26:57.79,0:27:01.46,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:27:01.46,0:27:04.76,Default,,0,0,0,,Хаа... Кешіріңіз. Кешіріңіз.
Dialogue: 0,0:27:05.80,0:27:07.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:11.47,0:27:13.81,Default,,0,0,0,,Эй, мен қайтып келдім! Мен қайтып келдім!
Dialogue: 0,0:27:13.81,0:27:17.14,Default,,0,0,0,,Чими~! (Мистер Тозақ) Рахмет, сіз маған көмектестіңіз!
Dialogue: 0,0:27:17.14,0:27:21.41,Default,,0,0,0,,Бұл маған көмектеспейді... Бірліктер Не істеуім керек?
Dialogue: 0,0:27:21.41,0:27:24.42,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:27:24.42,0:27:27.12,Default,,0,0,0,,Дегенмен, Ол Майт—
Dialogue: 0,0:27:30.76,0:27:34.76,Default,,0,0,0,,Ммм, түсіндім.
Dialogue: 0,0:27:34.76,0:27:39.43,Default,,0,0,0,,Сіз адам әлемінде осындай жылы нәрселермен ойнайсыз ба?
Dialogue: 0,0:27:39.43,0:27:42.10,Default,,0,0,0,,Менің сағым
Dialogue: 0,0:27:42.10,0:27:45.44,Default,,0,0,0,,Расетсугюки патша Джаббервок VIII-ге тозақ
Dialogue: 0,0:27:45.44,0:27:47.77,Default,,0,0,0,,Маған жол көрсет
Dialogue: 0,0:27:47.77,0:27:52.47,Default,,0,0,0,,Ойнау уақыты... аяқталды.
Dialogue: 0,0:27:53.45,0:28:13.47,Default,,0,0,0,,Сен
Dialogue: 0,0:28:13.47,0:28:33.42,Default,,0,0,0,,Сен
Dialogue: 0,0:28:33.42,0:28:53.44,Default,,0,0,0,,Сен
Dialogue: 0,0:28:53.44,0:29:13.46,Default,,0,0,0,,Сен
Dialogue: 0,0:29:13.46,0:29:22.46,Default,,0,0,0,,Сен
Dialogue: 0,0:29:23.40,0:29:25.40,Default,,0,0,0,,<Барлығы берген лотерея билеттерімен
Dialogue: 0,0:29:25.40,0:29:27.41,Default,,0,0,0,,Мен күтпеген жерден 100 000 иен ұтып алдым!
Dialogue: 0,0:29:27.41,0:29:29.41,Default,,0,0,0,,Оны қалай бөлеміз?
Dialogue: 0,0:29:29.41,0:29:31.74,Default,,0,0,0,,Балалар шешсін!
Dialogue: 0,0:29:31.74,0:29:34.41,Default,,0,0,0,,Келесі жолы: «100 000 иен тозақ»
Dialogue: 0,0:29:34.41,0:29:37.08,Default,,0,0,0,,『Шабуыл! Тозақ Сенпай'' екі кітап>
Dialogue: 0,0:29:38.58,0:29:44.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory