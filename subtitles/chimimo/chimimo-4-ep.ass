Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.02,0:00:04.02,Default,,0,0,0,,Келесі кездескенше!
Dialogue: 0,0:00:08.99,0:00:11.66,Default,,0,0,0,,<Онигами отбасының үш әпкесі тұратын үйде.
Dialogue: 0,0:00:11.66,0:00:15.33,Default,,0,0,0,,Тозақ мырза 12 Чимимомен келді.
Dialogue: 0,0:00:15.33,0:00:17.33,Default,,0,0,0,,Олар әлі білмейді
Dialogue: 0,0:00:17.33,0:00:19.67,Default,,0,0,0,,Олардың шынайы мақсаты
Dialogue: 0,0:00:19.67,0:00:23.01,Default,,0,0,0,,Мақсат адам әлемін тозаққа айналдыру болды>
Dialogue: 0,0:00:23.01,0:00:43.03,Default,,0,0,0,,Сен
Dialogue: 0,0:00:43.03,0:01:03.05,Default,,0,0,0,,Сен
Dialogue: 0,0:01:03.05,0:01:23.00,Default,,0,0,0,,Сен
Dialogue: 0,0:01:23.00,0:01:25.34,Default,,0,0,0,,Сен
Dialogue: 0,0:01:25.34,0:01:29.01,Default,,0,0,0,,Сен
Dialogue: 0,0:01:29.01,0:01:49.03,Default,,0,0,0,,Сен
Dialogue: 0,0:01:49.03,0:01:52.03,Default,,0,0,0,,Сен
Dialogue: 0,0:05:03.99,0:05:05.99,Default,,0,0,0,,«Тозақтағы әпке шайқасы»
Dialogue: 0,0:05:07.99,0:05:11.59,Default,,0,0,0,,()
Dialogue: 0,0:05:12.66,0:05:16.67,Default,,0,0,0,,Иә! Бұл тозақтық адам әлемінің филиалы.
Dialogue: 0,0:05:16.67,0:05:19.67,Default,,0,0,0,,Әй, тозақ-сенпай! Ерен еңбегіңіз үшін рахмет!
Dialogue: 0,0:05:19.67,0:05:24.34,Default,,0,0,0,,А, жоқ, мен адам әлемін толық тозаққа айналдырған жоқпын...
Dialogue: 0,0:05:24.34,0:05:26.34,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:05:26.34,0:05:29.35,Default,,0,0,0,,Иә! Маған бірнеше кеңестер бере аласыз ба?
Dialogue: 0,0:05:29.35,0:05:31.35,Default,,0,0,0,,Біз сізді тыңдаймыз!
Dialogue: 0,0:05:31.35,0:05:33.68,Default,,0,0,0,,О... сәл күте тұрыңыз.
Dialogue: 0,0:05:33.68,0:05:39.36,Default,,0,0,0,,Иә «Адамдар болмашы нәрселер үшін күреседі» Иә «Адамдар болмашы нәрселер үшін күреседі»
Dialogue: 0,0:05:39.36,0:05:41.69,Default,,0,0,0,,«Онда итеріңіз» Мен көремін.
Dialogue: 0,0:05:41.69,0:05:45.70,Default,,0,0,0,,«Адамдар қақтығысы, итеріп, тозаққа айналу»…
Dialogue: 0,0:05:45.70,0:05:49.37,Default,,0,0,0,,Рахмет, профессор! Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:05:49.37,0:05:51.37,Default,,0,0,0,,Иә, онда!
Dialogue: 0,0:05:52.37,0:05:57.37,Default,,0,0,0,,Хаа... «Адамдар қақтығысы, итермелеу және тозақ»...
Dialogue: 0,0:05:57.37,0:06:00.37,Default,,0,0,0,,Солай болмай ма?
Dialogue: 0,0:06:01.31,0:06:03.98,Default,,0,0,0,,Сіз оларды кигенсіз, солай ма?
Dialogue: 0,0:06:03.98,0:06:06.65,Default,,0,0,0,,Сен менің кроссовкамды кидің, солай ма?
Dialogue: 0,0:06:06.65,0:06:09.99,Default,,0,0,0,,Иә? Мүмкін... иә
Dialogue: 0,0:06:09.99,0:06:11.99,Default,,0,0,0,,Бұл жаңа.
Dialogue: 0,0:06:11.99,0:06:14.99,Default,,0,0,0,,Бұл ақ джинсы, бірақ ол мүлдем таза болды.
Dialogue: 0,0:06:14.99,0:06:17.99,Default,,0,0,0,,Иә? Солай ма? кана?
Dialogue: 0,0:06:17.99,0:06:20.00,Default,,0,0,0,,Оларды не үшін киесің?
Dialogue: 0,0:06:20.00,0:06:22.67,Default,,0,0,0,,Кіре берісте болғандықтан... мүмкін бе?
Dialogue: 0,0:06:22.67,0:06:25.34,Default,,0,0,0,,Хмм... мм!
Dialogue: 0,0:06:25.34,0:06:27.67,Default,,0,0,0,,Уау! (Мистер Тозақ) Ах!
Dialogue: 0,0:06:27.67,0:06:31.34,Default,,0,0,0,,Не? Мен таңертең ғана артқа бардым.
Dialogue: 0,0:06:31.34,0:06:34.34,Default,,0,0,0,,Сәлем! Кроссовкалар шынымен әдемі
Dialogue: 0,0:06:34.34,0:06:36.35,Default,,0,0,0,,Оны сыртта бірінші рет киіп тұрмын.
Dialogue: 0,0:06:36.35,0:06:39.02,Default,,0,0,0,,Қалтамдағы ақшаны жинап, ақыры сатып алдым да, жіпке салдым.
Dialogue: 0,0:06:39.02,0:06:43.02,Default,,0,0,0,,Кіреберісті тазала, сонда қалдыр да, қарашы, жылтыр!
Dialogue: 0,0:06:43.02,0:06:45.02,Default,,0,0,0,,Сондықтан жол дымқыл емес
Dialogue: 0,0:06:45.02,0:06:47.36,Default,,0,0,0,,Мен оны тек таза жерлерде жүретін күні түсіремін дедім.
Dialogue: 0,0:06:47.36,0:06:49.36,Default,,0,0,0,,Оны тағы 10 күн қараңыз...
Dialogue: 0,0:06:49.36,0:06:51.70,Default,,0,0,0,,Бұл баға жетпес бірінші рет
Dialogue: 0,0:06:51.70,0:06:54.70,Default,,0,0,0,,Хазуне мені түбіріммен жұлып тастады!
Dialogue: 0,0:06:54.70,0:06:58.30,Default,,0,0,0,,Мұны қалай айту керек! Бұл жағдайды менен сұрамаңыз.
Dialogue: 0,0:06:58.30,0:07:02.31,Default,,0,0,0,,Онюдың қадірін түсінбейтін адамдар тозаққа барсын!
Dialogue: 0,0:07:02.31,0:07:04.64,Default,,0,0,0,,Тозаққа барасың сонда!
Dialogue: 0,0:07:04.64,0:07:07.31,Default,,0,0,0,,Уау! Сен тозаққа баратын адамсың!
Dialogue: 0,0:07:07.31,0:07:10.31,Default,,0,0,0,,Уф... бәрібір аяқ киім тез кірленеді!
Dialogue: 0,0:07:10.31,0:07:12.98,Default,,0,0,0,,Сондықтан жаңалығыңыз ерекше!
Dialogue: 0,0:07:12.98,0:07:15.99,Default,,0,0,0,,«Арнайы»? Ересек адам сияқты әрекет етпеңіз!
Dialogue: 0,0:07:15.99,0:07:17.99,Default,,0,0,0,,Мынау... мынау... мынау!
Dialogue: 0,0:07:17.99,0:07:19.99,Default,,0,0,0,,Менің ағам айтқандай.
Dialogue: 0,0:07:19.99,0:07:23.66,Default,,0,0,0,,Адамдар өз бетімен соғысса, тозаққа түседі.
Dialogue: 0,0:07:23.66,0:07:27.00,Default,,0,0,0,,Сонымен... менің чими-мурё жігіттерім осыған түсіп жатыр!
Dialogue: 0,0:07:27.00,0:07:29.00,Default,,0,0,0,,Чими чими!
Dialogue: 0,0:07:29.00,0:07:31.00,Default,,0,0,0,,Чими! Чи-ми-!
Dialogue: 0,0:07:31.00,0:07:34.00,Default,,0,0,0,,Бөтеннің аяқ киімін еш қиындықсыз кию үшін қандай жүйке қажет?
Dialogue: 0,0:07:34.00,0:07:36.01,Default,,0,0,0,,Өйткені мен асығыс едім.
Dialogue: 0,0:07:36.01,0:07:38.34,Default,,0,0,0,,Мен аяқ киім киген кезде оның кімдікі екенін ойламаймын.Қалыпты жағдайда.
Dialogue: 0,0:07:38.34,0:07:40.34,Default,,0,0,0,,Ойлан! Ха!
Dialogue: 0,0:07:41.68,0:07:44.01,Default,,0,0,0,,Чими! Чими мими…
Dialogue: 0,0:07:44.01,0:07:46.02,Default,,0,0,0,,Чими! Чими~!
Dialogue: 0,0:07:46.02,0:07:49.35,Default,,0,0,0,,Арх! Ой... аа!
Dialogue: 0,0:07:49.35,0:07:51.69,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:07:51.69,0:07:53.69,Default,,0,0,0,,Ах! Чими!
Dialogue: 0,0:07:53.69,0:07:56.03,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:07:56.03,0:07:58.03,Default,,0,0,0,,Арх! Уф! Уф...
Dialogue: 0,0:07:58.03,0:07:59.96,Default,,0,0,0,,'Жоқ—ол қайта қосылып жатыр ма? Бөлініп кеткен бөліктері…'
Dialogue: 0,0:07:59.96,0:08:02.63,Default,,0,0,0,,Осы уақытта мен сізге айтамын, мен әдетте қатты ашуланамын.
Dialogue: 0,0:08:02.63,0:08:05.30,Default,,0,0,0,,Бұл жерде де киімдеріңді бүкте.
Dialogue: 0,0:08:05.30,0:08:07.64,Default,,0,0,0,,Қуыстарды емдеңіз! Кешіктірме!
Dialogue: 0,0:08:07.64,0:08:10.64,Default,,0,0,0,,Қолданбаларды азайтыңыз! Салмақты жоғалтқыңыз келгенде тым көп қант қосу!
Dialogue: 0,0:08:10.64,0:08:12.64,Default,,0,0,0,,Менің мектепте достарым көп емес!
Dialogue: 0,0:08:12.64,0:08:14.98,Default,,0,0,0,,Не! Не болды!
Dialogue: 0,0:08:14.98,0:08:17.31,Default,,0,0,0,,Ах! Ух... (Цубаса) Чи... Чими!
Dialogue: 0,0:08:17.31,0:08:20.65,Default,,0,0,0,,Чими~! (Мэй Хазуки) Уау!
Dialogue: 0,0:08:20.65,0:08:23.65,Default,,0,0,0,,Жоқ... Төбелес жақсы, бірақ үй бұзылады!
Dialogue: 0,0:08:23.65,0:08:27.32,Default,,0,0,0,,Тоқта, күт... Кең жерге барайық. Мына жолмен, былай!
Dialogue: 0,0:08:27.32,0:08:29.32,Default,,0,0,0,,Чими Чими Чими Чими
Dialogue: 0,0:08:37.33,0:08:39.34,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:39.34,0:08:42.01,Default,,0,0,0,,Екеуіңіз де Чими Морёны пайдаланып, барынша күресесіз.
Dialogue: 0,0:08:42.01,0:08:46.01,Default,,0,0,0,,Хехехе адам қақтығыс түрткі
Dialogue: 0,0:08:46.01,0:08:48.34,Default,,0,0,0,,Тозаққа айналу – үлкен жетістік.
Dialogue: 0,0:08:48.34,0:08:51.35,Default,,0,0,0,,♪ Хазуне, мен шындап тозаққа барамын!
Dialogue: 0,0:08:51.35,0:08:56.02,Default,,0,0,0,,♪ Мен тым көп ішемін, еденде ұйықтаймын және келесі күні таңертең аузымнан жағымсыз иіс шығады.
Dialogue: 0,0:08:56.02,0:08:58.29,Default,,0,0,0,,♪ Менің жиенім тозаққа барады!
Dialogue: 0,0:08:58.29,0:09:00.62,Default,,0,0,0,,♪ Мысықтарың менің басымды айналдырады
Dialogue: 0,0:09:00.62,0:09:02.96,Default,,0,0,0,,♪ Торттағы целлофанды жалама, YO!
Dialogue: 0,0:09:02.96,0:09:06.63,Default,,0,0,0,,♪ (Трубаны зарядтау) (Барабан дыбысы)
Dialogue: 0,0:09:06.63,0:09:08.63,Default,,0,0,0,,(Сирена қосылады)
Dialogue: 0,0:09:08.63,0:09:11.63,Default,,0,0,0,,Чими! Чими~!
Dialogue: 0,0:09:11.63,0:09:13.97,Default,,0,0,0,,Чими Чими Чими Чими
Dialogue: 0,0:09:13.97,0:09:15.97,Default,,0,0,0,,Чимичими чимичими!
Dialogue: 0,0:09:16.97,0:09:19.31,Default,,0,0,0,,Ми~!
Dialogue: 0,0:09:19.31,0:09:22.65,Default,,0,0,0,,Чи-ми! Чи-ми! Чи-ми!
Dialogue: 0,0:09:22.65,0:09:27.98,Default,,0,0,0,,Сіз білесіз бе? Мэй өзінің бастауыш мектебінің директорына қатты ғашық болды.
Dialogue: 0,0:09:27.98,0:09:29.99,Default,,0,0,0,,Шулы! Хазун
Dialogue: 0,0:09:29.99,0:09:33.99,Default,,0,0,0,,Интернетте бұрыннан салған таза махаббат мангасын таратуым керек пе?
Dialogue: 0,0:09:33.99,0:09:37.33,Default,,0,0,0,,Керемет! Бұл тозаққа ұқсай бастады
Dialogue: 0,0:09:37.33,0:09:41.00,Default,,0,0,0,,Аға, ағама жіберу үшін суретке түсейік (ысырма дыбысы)
Dialogue: 0,0:09:41.00,0:09:43.67,Default,,0,0,0,,Чи-ми! Чи-ми!
Dialogue: 0,0:09:43.67,0:09:46.34,Default,,0,0,0,,Чи-ми! Чи-ми!
Dialogue: 0,0:09:46.34,0:09:50.04,Default,,0,0,0,,Чимимими…
Dialogue: 0,0:09:51.01,0:09:53.34,Default,,0,0,0,,Қараңдар! Чими!
Dialogue: 0,0:09:53.34,0:09:55.35,Default,,0,0,0,,Цк... Мен жеңбеймін.
Dialogue: 0,0:09:55.35,0:09:57.35,Default,,0,0,0,,Next Go!
Dialogue: 0,0:09:57.35,0:10:00.62,Default,,0,0,0,,Чими чими... чими~!
Dialogue: 0,0:10:00.62,0:10:02.62,Default,,0,0,0,,Ей, біз біріктірдік!
Dialogue: 0,0:10:02.62,0:10:06.29,Default,,0,0,0,,Чими~! Чими чими!
Dialogue: 0,0:10:06.29,0:10:08.96,Default,,0,0,0,,Чими! Чими мими…
Dialogue: 0,0:10:08.96,0:10:11.63,Default,,0,0,0,,Жасай бер! Оны құрт!
Dialogue: 0,0:10:11.63,0:10:14.96,Default,,0,0,0,,Чимими…
Dialogue: 0,0:10:14.96,0:10:16.97,Default,,0,0,0,,Чими~!
Dialogue: 0,0:10:16.97,0:10:19.30,Default,,0,0,0,,Ах... тағы бір ұтыс.
Dialogue: 0,0:10:19.30,0:10:22.31,Default,,0,0,0,,Қарғыс атқыр... Тек тозаққа кет!
Dialogue: 0,0:10:22.31,0:10:25.31,Default,,0,0,0,,Сен тозаққа баруың керек!
Dialogue: 0,0:10:25.31,0:10:27.31,Default,,0,0,0,,Бұл қызықты бола бастады
Dialogue: 0,0:10:27.31,0:10:29.98,Default,,0,0,0,,Жақсы, көп жаса! иә?
Dialogue: 0,0:10:29.98,0:10:32.32,Default,,0,0,0,,Чими~!
Dialogue: 0,0:10:32.32,0:10:35.32,Default,,0,0,0,,Чими! (Мистер Тозақ) Бұл жаман.
Dialogue: 0,0:10:35.32,0:10:37.32,Default,,0,0,0,,Чими Чими Чими Чими
Dialogue: 0,0:10:37.32,0:10:40.99,Default,,0,0,0,,Чими чими чими чими чими чими чими чими чими
Dialogue: 0,0:10:40.99,0:10:43.33,Default,,0,0,0,,Таныс болып көрінетін қозғалыс
Dialogue: 0,0:10:43.33,0:10:45.33,Default,,0,0,0,,Сіз не істеп жатырсыз? Бұл
Dialogue: 0,0:10:45.33,0:10:50.00,Default,,0,0,0,,Шақыру... Күшті соғыс Достарыңды тозақтан шақыру
Dialogue: 0,0:10:50.00,0:10:52.00,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:10:52.00,0:10:54.30,Default,,0,0,0,,Чими Чими Чими Чими
Dialogue: 0,0:10:56.34,0:10:59.34,Default,,0,0,0,,Уф... жоқ, мен оны қазір тоқтата алмаймын.
Dialogue: 0,0:11:00.94,0:11:02.95,Default,,0,0,0,,Чими~
Dialogue: 0,0:11:02.95,0:11:06.28,Default,,0,0,0,,Бұл шықты! Мен Чимиді де танымаймын! Бұл...
Dialogue: 0,0:11:06.28,0:11:09.95,Default,,0,0,0,,Тануки можа тікенді
Dialogue: 0,0:11:09.95,0:11:13.62,Default,,0,0,0,,Жұлдыз Буу Пурупуру
Dialogue: 0,0:11:13.62,0:11:17.29,Default,,0,0,0,,Нарвал Пацун Шичисан
Dialogue: 0,0:11:17.29,0:11:19.30,Default,,0,0,0,,Тактильді махаббат
Dialogue: 0,0:11:19.30,0:11:21.63,Default,,0,0,0,,Уау, мен олардың бәрін атадым!
Dialogue: 0,0:11:21.63,0:11:23.97,Default,,0,0,0,,Чимичими Чимичими Чимичими Чимичими
Dialogue: 0,0:11:23.97,0:11:25.97,Default,,0,0,0,,Уау... Қуып жете алмаймын!
Dialogue: 0,0:11:25.97,0:11:28.57,Default,,0,0,0,,Чимичими Чимичими Чимичими!
Dialogue: 0,0:11:29.64,0:11:31.98,Default,,0,0,0,,Чими чими~!
Dialogue: 0,0:11:31.98,0:11:34.31,Default,,0,0,0,,Чими~!
Dialogue: 0,0:11:34.31,0:11:37.31,Default,,0,0,0,,Роботпен... Мен құбыжыққа айналдым
Dialogue: 0,0:11:37.31,0:11:39.98,Default,,0,0,0,,Чими~! Чими чими!
Dialogue: 0,0:11:39.98,0:11:41.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:41.99,0:11:43.99,Default,,0,0,0,,Чими~! Чими!
Dialogue: 0,0:11:43.99,0:11:45.99,Default,,0,0,0,,Чими... Чими~!
Dialogue: 0,0:11:45.99,0:11:48.66,Default,,0,0,0,,Чими! Ми... (Мей/Хазуки) Уау!
Dialogue: 0,0:11:48.66,0:11:51.36,Default,,0,0,0,,Чими ми~!
Dialogue: 0,0:11:52.33,0:11:54.33,Default,,0,0,0,,Эй!
Dialogue: 0,0:11:57.00,0:12:00.27,Default,,0,0,0,,Ууууу... (Тозақ) Мен бұл көріністі білемін.
Dialogue: 0,0:12:00.27,0:12:02.94,Default,,0,0,0,,Тозақ жаттығуы кезінде видеодан көргенім осы.
Dialogue: 0,0:12:02.94,0:12:05.27,Default,,0,0,0,,Дүниеде жеті-сегіз күн от болады.
Dialogue: 0,0:12:05.27,0:12:07.28,Default,,0,0,0,,Мен сізге қонаққа барғалы жатырмын.
Dialogue: 0,0:12:07.28,0:12:09.58,Default,,0,0,0,,Чими~!
Dialogue: 0,0:12:10.61,0:12:12.95,Default,,0,0,0,,Чими~!
Dialogue: 0,0:12:12.95,0:12:17.29,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:12:17.29,0:12:19.29,Default,,0,0,0,,Чими~ Чими!
Dialogue: 0,0:12:19.29,0:12:21.62,Default,,0,0,0,,Уау... Шынымды айтсам, бұл!
Dialogue: 0,0:12:21.62,0:12:23.63,Default,,0,0,0,,О, жоқ... дүние бітті
Dialogue: 0,0:12:23.63,0:12:26.63,Default,,0,0,0,,(２)…
Dialogue: 0,0:12:26.63,0:12:29.63,Default,,0,0,0,,(ｽﾋﾟｰｶｰ:)
Dialogue: 0,0:12:29.63,0:12:32.30,Default,,0,0,0,,Қоқыс таситын көлік өтіп бара жатыр».
Dialogue: 0,0:12:32.30,0:12:35.97,Default,,0,0,0,,Чими~ Чи… Чи…
Dialogue: 0,0:12:35.97,0:12:38.98,Default,,0,0,0,,«Қоқыс таситын көлік өтіп жатыр».
Dialogue: 0,0:12:38.98,0:12:40.98,Default,,0,0,0,,Ах! иә?
Dialogue: 0,0:12:40.98,0:12:44.65,Default,,0,0,0,,Бүгін таңертең мен қоқыс шығару үшін кезекшілікте болдым.
Dialogue: 0,0:12:44.65,0:12:48.32,Default,,0,0,0,,《Аа, уже... Мэй, мен тағы ұмытып кетіппін》
Dialogue: 0,0:12:48.32,0:12:50.32,Default,,0,0,0,,() 《》 《》
Dialogue: 0,0:12:50.32,0:12:53.66,Default,,0,0,0,,《  》 《》
Dialogue: 0,0:12:53.66,0:12:57.06,Default,,0,0,0,,《Аа, күте тұрыңыз~! 》
Dialogue: 0,0:12:57.99,0:13:00.66,Default,,0,0,0,,Сонымен... Мен қоқыс таситын машинаны қуып келемін.
Dialogue: 0,0:13:00.66,0:13:03.00,Default,,0,0,0,,Сен менің кроссовкамды кидің.
Dialogue: 0,0:13:03.00,0:13:05.00,Default,,0,0,0,,Сіз түсіндіңіз бе?
Dialogue: 0,0:13:05.00,0:13:08.30,Default,,0,0,0,,Бірақ жаңалығыңызды бұзғаным үшін кешіріңіз.
Dialogue: 0,0:13:10.67,0:13:13.34,Default,,0,0,0,,Рахмет (2 адам) Хэхе
Dialogue: 0,0:13:13.34,0:13:17.04,Default,,0,0,0,,Енді тоқтайық.
Dialogue: 0,0:13:18.01,0:13:20.02,Default,,0,0,0,,Чимимо!
Dialogue: 0,0:13:20.02,0:13:22.62,Default,,0,0,0,,Тауықтың бұлғынын же!
Dialogue: 0,0:13:23.69,0:13:27.02,Default,,0,0,0,,Чимичимичими…
Dialogue: 0,0:13:27.02,0:13:29.62,Default,,0,0,0,,Хоора, бірге тамақтанайық
Dialogue: 0,0:13:31.03,0:13:34.36,Default,,0,0,0,,Чимичими Чимичими Чимичими
Dialogue: 0,0:13:34.36,0:13:37.70,Default,,0,0,0,,Әйтеуір, төбелестен де дәмді ғой, солай емес пе?
Dialogue: 0,0:13:37.70,0:13:41.04,Default,,0,0,0,,Иә, бәріміз қазір үйге қайтайық.
Dialogue: 0,0:13:41.04,0:13:44.04,Default,,0,0,0,,Чимичимичими… чими~
Dialogue: 0,0:13:46.71,0:13:49.41,Default,,0,0,0,,Біз де үйге қайтайық. Иә.
Dialogue: 0,0:13:54.72,0:13:59.42,Default,,0,0,0,,Енді ұрысуға болмайды... Уф...
Dialogue: 0,0:14:03.99,0:14:07.33,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:14:07.33,0:14:11.00,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:14:11.00,0:14:13.67,Default,,0,0,0,,Мынау... бұл екеуі төбелеспекші.
Dialogue: 0,0:14:13.67,0:14:16.01,Default,,0,0,0,,Әңгімелеу! ең нашар!
Dialogue: 0,0:14:16.01,0:14:19.01,Default,,0,0,0,,Барлығыңыз отырыңыздар!
Dialogue: 0,0:14:20.34,0:14:23.68,Default,,0,0,0,,Кешіріңіз (Мистер Тозақ) Мен оны тоқтаттым.
Dialogue: 0,0:14:23.68,0:14:25.68,Default,,0,0,0,,Бөлме неліктен бейберекет болды?
Dialogue: 0,0:14:25.68,0:14:29.69,Default,,0,0,0,,Біз күресуіміз керек! Бір-бірімізден кешірім сұрасақ жақсы емес пе?
Dialogue: 0,0:14:29.69,0:14:34.02,Default,,0,0,0,,Рас болды... Ұрыс-керістің кесірінен мен тура тозаққа түстім.
Dialogue: 0,0:14:34.02,0:14:36.36,Default,,0,0,0,,Онда! Мұқият тыңдаңыз! (Мистер Тозақ) Эй!
Dialogue: 0,0:14:36.36,0:14:38.36,Default,,0,0,0,,Жалпы айтқанда, Тозақ мырза да Тозақ мырза.
Dialogue: 0,0:14:38.36,0:14:40.66,Default,,0,0,0,,Мен оны қаттырақ ұстауым керек... (Мэй/Хазуки) Хехе
Dialogue: 0,0:17:13.98,0:17:16.98,Default,,0,0,0,,«Өнер тозаққа айналады!»
Dialogue: 0,0:17:17.99,0:17:19.92,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:19.92,0:17:22.26,Default,,0,0,0,,Талантым таусылды
Dialogue: 0,0:17:22.26,0:17:24.26,Default,,0,0,0,,Сіз тағы да ішіп түні бойы отырдыңыз ба?
Dialogue: 0,0:17:24.26,0:17:26.93,Default,,0,0,0,,Мен басқа тапсырма орындадым.
Dialogue: 0,0:17:26.93,0:17:29.60,Default,,0,0,0,,Бірақ жоқ... мүлде!
Dialogue: 0,0:17:29.60,0:17:31.60,Default,,0,0,0,,Оны лақтырыңыз
Dialogue: 0,0:17:31.60,0:17:33.94,Default,,0,0,0,,Бұл соңғы мерзім, солай ма? Неге оны бәрібір жібермейсіз?
Dialogue: 0,0:17:33.94,0:17:38.61,Default,,0,0,0,,Ол жиіркенішті профессор болғандықтан, ол маған 20 ұпай сияқты ұпай беріп отырады.
Dialogue: 0,0:17:38.61,0:17:40.61,Default,,0,0,0,,Бұл өнер болса да!
Dialogue: 0,0:17:40.61,0:17:43.95,Default,,0,0,0,,Тапсырмаларды беру маңызды, бағалау екінші орында.
Dialogue: 0,0:17:43.95,0:17:46.62,Default,,0,0,0,,Иә, мен әлі студентпін.
Dialogue: 0,0:17:46.62,0:17:49.29,Default,,0,0,0,,Студент кезімде көктеп шықты!
Dialogue: 0,0:17:49.29,0:17:51.95,Default,,0,0,0,,Өлгеннен кейін баға беруге кеш
Dialogue: 0,0:17:51.95,0:17:53.96,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:53.96,0:17:59.30,Default,,0,0,0,,Менің ұйқым жеңіл, өйткені адам әлемін тозаққа айналдыру жоспары орындалмай жатыр.
Dialogue: 0,0:17:59.30,0:18:01.30,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:06.30,0:18:08.64,Default,,0,0,0,,Қызыл нан немесе көк нан?
Dialogue: 0,0:18:08.64,0:18:13.31,Default,,0,0,0,,Тыныш ұйықтама, менің қаншалықты уайымдағанымды да білмейсің.
Dialogue: 0,0:18:13.31,0:18:17.31,Default,,0,0,0,,Әй, оян! Қазірдің өзінде таң болды!
Dialogue: 0,0:18:17.31,0:18:19.25,Default,,0,0,0,,()
Dialogue: 0,0:18:19.25,0:18:21.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:22.92,0:18:25.92,Default,,0,0,0,,Ол сынды... Чими Мурью...
Dialogue: 0,0:18:26.92,0:18:29.59,Default,,0,0,0,,()
Dialogue: 0,0:18:29.59,0:18:36.27,Default,,0,0,0,,(Ұйқыда)
Dialogue: 0,0:18:36.27,0:18:39.60,Default,,0,0,0,,Ендеше менің қалпына келу қабілетім…
Dialogue: 0,0:18:39.60,0:18:42.27,Default,,0,0,0,,Хаха... Бұл Хазуки емес пе?
Dialogue: 0,0:18:42.27,0:18:44.94,Default,,0,0,0,,Қалай болғанда да, бұл үй тапсырмасын орындаудың тағы бір өнері немесе бір нәрсе.
Dialogue: 0,0:18:44.94,0:18:47.28,Default,,0,0,0,,Бұл жігіттерден үлгі алған шығар.
Dialogue: 0,0:18:47.28,0:18:49.61,Default,,0,0,0,,Неліктен оны бәрібір босатпайды?
Dialogue: 0,0:18:49.61,0:18:51.61,Default,,0,0,0,,О, бұл қауіпті!
Dialogue: 0,0:18:52.95,0:18:54.95,Default,,0,0,0,,Чими?
Dialogue: 0,0:18:54.95,0:18:57.62,Default,,0,0,0,,Әлі оянба! Оянсам да, ұйықтап жатқандай кейіп танытамын
Dialogue: 0,0:18:57.62,0:19:00.96,Default,,0,0,0,,Бұл сенің бүгінгі жұмысың. Тамаша!
Dialogue: 0,0:19:00.96,0:19:05.29,Default,,0,0,0,,Дұрыс, егер сіз оны бермесеңіз, несиеден айырыласыз.
Dialogue: 0,0:19:05.29,0:19:07.29,Default,,0,0,0,,Мен әкелемін.
Dialogue: 0,0:19:08.96,0:19:10.97,Default,,0,0,0,,Әртүрлі… жарайды.
Dialogue: 0,0:19:10.97,0:19:12.97,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:19:12.97,0:19:15.30,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:19:15.30,0:19:18.60,Default,,0,0,0,,А... Сіз ұсталмай қалдыңыз ба?
Dialogue: 0,0:19:21.24,0:19:25.25,Default,,0,0,0,,Хаа... Енді мен тапсырманың бағасын жариялаймын.
Dialogue: 0,0:19:25.25,0:19:27.58,Default,,0,0,0,,Бұл жолы да қорқынышты хаха...
Dialogue: 0,0:19:27.58,0:19:29.59,Default,,0,0,0,,Танаши-кун 15 ұпай
Dialogue: 0,0:19:29.59,0:19:31.92,Default,,0,0,0,,Ханакоганей 32 ұпай
Dialogue: 0,0:19:31.92,0:19:35.26,Default,,0,0,0,,Кодайра-кун 27 ұпай Га...
Dialogue: 0,0:19:35.26,0:19:38.26,Default,,0,0,0,,Кумегава 2 ұпай
Dialogue: 0,0:19:38.26,0:19:40.26,Default,,0,0,0,,Не... Ах!
Dialogue: 0,0:19:40.26,0:19:42.56,Default,,0,0,0,,Эй, Изуна.
Dialogue: 0,0:19:43.60,0:19:46.27,Default,,0,0,0,,Бұл жақсы нәрсе болды ма?
Dialogue: 0,0:19:46.27,0:19:49.94,Default,,0,0,0,,Мен бұл үшін құрметке ие болғанымды қалаймын.
Dialogue: 0,0:19:49.94,0:19:52.27,Default,,0,0,0,,()…
Dialogue: 0,0:19:52.27,0:19:54.28,Default,,0,0,0,,Боу! Ах...
Dialogue: 0,0:19:54.28,0:19:56.61,Default,,0,0,0,,Сыныпқа не болды?
Dialogue: 0,0:19:56.61,0:19:59.62,Default,,0,0,0,,Эй... Профессор! Кешіріңіз
Dialogue: 0,0:19:59.62,0:20:02.95,Default,,0,0,0,,Мен тапсырма бердім, бірақ басым ауырады.
Dialogue: 0,0:20:02.95,0:20:05.96,Default,,0,0,0,,Жоқ... ха... бұл...
Dialogue: 0,0:20:05.96,0:20:08.96,Default,,0,0,0,,Бұл сіздің жұмысыңыз, 100 ұпай.
Dialogue: 0,0:20:08.96,0:20:12.29,Default,,0,0,0,,Иә? Толық ұпай? Мен сене алар емеспін
Dialogue: 0,0:20:12.29,0:20:16.30,Default,,0,0,0,,Хаа... Міне, бүгін көрме басталады.
Dialogue: 0,0:20:16.30,0:20:19.30,Default,,0,0,0,,Сіз оны шығардыңыз ба?
Dialogue: 0,0:20:23.57,0:20:25.57,Default,,0,0,0,,Ммм
Dialogue: 0,0:20:25.57,0:20:28.58,Default,,0,0,0,,Міне болды! Жоқ, жоқ...
Dialogue: 0,0:20:28.58,0:20:31.91,Default,,0,0,0,,()  …
Dialogue: 0,0:20:31.91,0:20:34.25,Default,,0,0,0,,Менің жұмысым маған көрсетілді.
Dialogue: 0,0:20:34.25,0:20:37.25,Default,,0,0,0,,Керемет! ДДСҰ?
Dialogue: 0,0:20:37.25,0:20:41.26,Default,,0,0,0,,Кешіріңіз, мен бұлмын.
Dialogue: 0,0:20:41.26,0:20:43.26,Default,,0,0,0,,«Өнер жинаушы»
Dialogue: 0,0:20:43.26,0:20:47.93,Default,,0,0,0,,Мен сіздің шығармаларыңыздан өмірді сезінемін! Бұл жаңа және жаңа!
Dialogue: 0,0:20:47.93,0:20:52.94,Default,,0,0,0,,Жалғыздықтың қараңғылығынан бірдеңе атқылап тұрғандай!
Dialogue: 0,0:20:52.94,0:20:56.61,Default,,0,0,0,,Күлсін... Енді аукцион басталады.
Dialogue: 0,0:20:56.61,0:21:00.94,Default,,0,0,0,,Жас талантты бағалау керек Аукцион?
Dialogue: 0,0:21:00.94,0:21:04.24,Default,,0,0,0,,Менің жасағанымды біреу сатып ала ма?
Dialogue: 0,0:21:10.95,0:21:15.95,Default,,0,0,0,,Міне болды! Бірақ әйтеуір мен күткеннен де жақсы шықты.
Dialogue: 0,0:21:17.63,0:21:19.56,Default,,0,0,0,,(балғаның соғу дыбысы)
Dialogue: 0,0:21:19.56,0:21:22.23,Default,,0,0,0,,Оқушылардың шығармашылық аукционы басталады
Dialogue: 0,0:21:22.23,0:21:26.24,Default,,0,0,0,,Хазуки Кишиннің «Ұйқы» шығармасынан бастайық.
Dialogue: 0,0:21:26.24,0:21:28.24,Default,,0,0,0,,(балғаның соғу дыбысы)
Dialogue: 0,0:21:28.24,0:21:30.24,Default,,0,0,0,,3000 иеннен
Dialogue: 0,0:21:30.24,0:21:33.91,Default,,0,0,0,,3000 иен 3000 иен 3000 иен 3000 иен Бұл кім?
Dialogue: 0,0:21:33.91,0:21:35.91,Default,,0,0,0,,1 миллион иен!
Dialogue: 0,0:21:35.91,0:21:38.91,Default,,0,0,0,,Иә! иә!
Dialogue: 0,0:21:40.92,0:21:42.92,Default,,0,0,0,,Бонсуа~
Dialogue: 0,0:21:42.92,0:21:44.92,Default,,0,0,0,,Мен тамақтанып қойдым
Dialogue: 0,0:21:45.92,0:21:48.26,Default,,0,0,0,,Иә? не? Сол сөмке
Dialogue: 0,0:21:48.26,0:21:52.26,Default,,0,0,0,,А... Мен әрқашан Луврға баруды армандайтынмын.
Dialogue: 0,0:21:52.26,0:21:54.26,Default,,0,0,0,,Silvpre?
Dialogue: 0,0:21:54.26,0:21:58.27,Default,,0,0,0,,Сіз нені айтасыз? о қымбаттым! Париждегі Лувр мұражайында ма?
Dialogue: 0,0:21:58.27,0:22:00.60,Default,,0,0,0,,Керемет емес пе! Бірақ ақша ше?
Dialogue: 0,0:22:00.60,0:22:05.00,Default,,0,0,0,,Тағайындалған жұмыс 1 миллион иенге сатылды!
Dialogue: 0,0:22:06.28,0:22:08.61,Default,,0,0,0,,1 миллион! Бұл керемет емес пе!
Dialogue: 0,0:22:08.61,0:22:11.28,Default,,0,0,0,,Фуфуфуфуфу (Тозақ-сан)<Хазукиме
Dialogue: 0,0:22:11.28,0:22:14.95,Default,,0,0,0,,Сіз мұны өз жұмысыңыз деп сатып жібердіңіз бе?>
Dialogue: 0,0:22:14.95,0:22:19.22,Default,,0,0,0,,♪ Хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе хе
Dialogue: 0,0:22:19.22,0:22:21.22,Default,,0,0,0,,Бұл~!
Dialogue: 0,0:22:22.56,0:22:25.23,Default,,0,0,0,,Бұл... таныс сияқты.
Dialogue: 0,0:22:25.23,0:22:27.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:27.23,0:22:33.57,Default,,0,0,0,,Сен
Dialogue: 0,0:22:33.57,0:22:35.57,Default,,0,0,0,,Бұл…
Dialogue: 0,0:22:35.57,0:22:37.57,Default,,0,0,0,,《Бөлмені тазалаңыз~》
Dialogue: 0,0:22:37.57,0:22:39.58,Default,,0,0,0,,《Осында》
Dialogue: 0,0:22:39.58,0:22:41.58,Default,,0,0,0,,Э? Менің бетім…
Dialogue: 0,0:22:41.58,0:22:44.58,Default,,0,0,0,,Мен бұздым... (Мистер Тозақ) Кешіріңіз.
Dialogue: 0,0:22:44.58,0:22:49.25,Default,,0,0,0,,Сонда... оның орнына нағыз көк нан мен қызыл нан болды ма?
Dialogue: 0,0:22:49.25,0:22:52.59,Default,,0,0,0,,Сонда аукционда сатылған өнер емес пе еді?
Dialogue: 0,0:22:52.59,0:22:54.59,Default,,0,0,0,,Бұл жалған! Ах...
Dialogue: 0,0:22:56.93,0:23:00.26,Default,,0,0,0,,Маған ұнамайды! Мен оны ұнатпаймын! Мен саған миллион иенді қайтармаймын.
Dialogue: 0,0:23:00.26,0:23:02.93,Default,,0,0,0,,Мен оны қолдандым! Мен Луврға барамын!
Dialogue: 0,0:23:02.93,0:23:07.60,Default,,0,0,0,,Жалғыз жолда жастық шақ, талант гүлдейді!
Dialogue: 0,0:23:07.60,0:23:10.94,Default,,0,0,0,,А... бірақ осы қарқынмен қызыл нан мен көк нан болады...
Dialogue: 0,0:23:10.94,0:23:12.94,Default,,0,0,0,,Бұл туралы айтатын болсақ, бұл сіздің кінәңіз емес!
Dialogue: 0,0:23:12.94,0:23:14.94,Default,,0,0,0,,Себебі мен білмеймін.
Dialogue: 0,0:23:14.94,0:23:18.24,Default,,0,0,0,,Аш болсаң қайтып келмейсің бе?
Dialogue: 0,0:23:19.55,0:23:21.55,Default,,0,0,0,,Алайда, біз оның қозғалысын тоқтата аламыз.
Dialogue: 0,0:23:21.55,0:23:26.56,Default,,0,0,0,,Мен сүйетін өнермен қоршалған бұл уақытты ештеңе алмастыра алмайды.
Dialogue: 0,0:23:26.56,0:23:31.23,Default,,0,0,0,,Өнер үшін жалғыздықты таңдағаным қандай керемет?
Dialogue: 0,0:23:31.23,0:23:33.23,Default,,0,0,0,,О, жақсы...
Dialogue: 0,0:23:33.23,0:23:36.93,Default,,0,0,0,,Жалғыздықтың қараңғылығынан өнер күтпеген жерден шығады!
Dialogue: 0,0:23:37.90,0:23:39.90,Default,,0,0,0,,Ммм
Dialogue: 0,0:23:39.90,0:23:42.57,Default,,0,0,0,,Чими? Чими~! (Бай адам) Әй!
Dialogue: 0,0:23:42.57,0:23:44.57,Default,,0,0,0,,Чими?
Dialogue: 0,0:23:44.57,0:23:47.24,Default,,0,0,0,,Ах... Хмм...
Dialogue: 0,0:23:47.24,0:23:49.94,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:23:50.91,0:23:54.25,Default,,0,0,0,,Қызыл нан Көк нан…
Dialogue: 0,0:23:54.25,0:23:56.25,Default,,0,0,0,,Мен енді күте алмаймын!
Dialogue: 0,0:23:59.25,0:24:04.93,Default,,0,0,0,,Сен
Dialogue: 0,0:24:04.93,0:24:07.53,Default,,0,0,0,,Чими (Тозақ-сан) иә? Бұл үлкен болды!
Dialogue: 0,0:24:09.26,0:24:11.27,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:24:11.27,0:24:13.60,Default,,0,0,0,,Керемет үй
Dialogue: 0,0:24:13.60,0:24:15.60,Default,,0,0,0,,(Кіру қоңырауы)
Dialogue: 0,0:24:15.60,0:24:17.61,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:24:17.61,0:24:22.21,Default,,0,0,0,,«Кешіріңіз, бірақ сіз мені мазаладыңыз ба?»
Dialogue: 0,0:24:22.21,0:24:24.91,Default,,0,0,0,,Мен уақытындамын (Тозақ) «Ех...»
Dialogue: 0,0:24:29.22,0:24:31.55,Default,,0,0,0,,Чимич чимич чимичими
Dialogue: 0,0:24:31.55,0:24:34.22,Default,,0,0,0,,Чимичими Чимичими Чимичими
Dialogue: 0,0:24:34.22,0:24:36.23,Default,,0,0,0,,Чи~
Dialogue: 0,0:24:36.23,0:24:38.56,Default,,0,0,0,,Жақсы! Ха! Ми!
Dialogue: 0,0:24:38.56,0:24:45.90,Default,,0,0,0,,Сен
Dialogue: 0,0:24:45.90,0:24:47.90,Default,,0,0,0,,Сауте
Dialogue: 0,0:24:49.24,0:24:52.24,Default,,0,0,0,,Иә? Чими? Чи-ми
Dialogue: 0,0:24:52.24,0:24:54.58,Default,,0,0,0,,Ммм~ Ми~
Dialogue: 0,0:24:54.58,0:24:57.58,Default,,0,0,0,,Не? Ол сақталады ма?
Dialogue: 0,0:24:57.58,0:24:59.92,Default,,0,0,0,,Мен жақсы көрінетін нәрсені жеймін.
Dialogue: 0,0:24:59.92,0:25:01.92,Default,,0,0,0,,Ми~! (Мистер Тозақ) А...
Dialogue: 0,0:25:01.92,0:25:03.92,Default,,0,0,0,,Ах! Әй, балалар!
Dialogue: 0,0:25:03.92,0:25:06.26,Default,,0,0,0,,О! Чими~
Dialogue: 0,0:25:06.26,0:25:08.59,Default,,0,0,0,,Олардың барлығы сенің достарың ба?
Dialogue: 0,0:25:08.59,0:25:10.59,Default,,0,0,0,,Чими~!
Dialogue: 0,0:25:12.59,0:25:15.29,Default,,0,0,0,,Жүр, тамақ ішейік
Dialogue: 0,0:25:16.60,0:25:18.60,Default,,0,0,0,,Хехехе
Dialogue: 0,0:25:19.94,0:25:22.24,Default,,0,0,0,,А... а...
Dialogue: 0,0:25:26.61,0:25:30.61,Default,,0,0,0,,(Хазукидің ызылдағаны)
Dialogue: 0,0:25:32.28,0:25:41.96,Default,,0,0,0,,Сен
Dialogue: 0,0:25:41.96,0:25:44.96,Default,,0,0,0,,Чими Чими Чими
Dialogue: 0,0:25:44.96,0:25:47.30,Default,,0,0,0,,Чими~ Чими
Dialogue: 0,0:25:47.30,0:25:49.97,Default,,0,0,0,,Чими (бай) иә иә
Dialogue: 0,0:25:49.97,0:25:53.30,Default,,0,0,0,,Олар осындай жерде болғанды жөн көреді.
Dialogue: 0,0:25:53.30,0:25:56.31,Default,,0,0,0,,Мен сонда әлдеқайда бақыттымын.
Dialogue: 0,0:25:56.31,0:25:59.31,Default,,0,0,0,,Ал... бұл сөзсіз.
Dialogue: 0,0:26:01.64,0:26:05.04,Default,,0,0,0,,Жоқ, жоқ! Ондай нәрсе бар ма?
Dialogue: 0,0:26:06.98,0:26:10.98,Default,,0,0,0,,Уф! Угаааааааааааааааа!
Dialogue: 0,0:26:12.65,0:26:14.66,Default,,0,0,0,,Ха ха ха... Иә?
Dialogue: 0,0:26:14.66,0:26:18.06,Default,,0,0,0,,Чими Миу Рьюді қайтарыңыз! Тозақ мырза?
Dialogue: 0,0:26:19.60,0:26:22.60,Default,,0,0,0,,Иә
Dialogue: 0,0:26:23.60,0:26:27.27,Default,,0,0,0,,Мырза, тағы бір өнер туындысы келді.
Dialogue: 0,0:26:27.27,0:26:30.61,Default,,0,0,0,,Уууу! Чими Морёны қайтарыңыз!
Dialogue: 0,0:26:30.61,0:26:33.61,Default,,0,0,0,,Күте тұрыңыз! Ха ха ха ха...
Dialogue: 0,0:26:33.61,0:26:37.28,Default,,0,0,0,,Эй, сен жаңасың ба?
Dialogue: 0,0:26:37.28,0:26:39.62,Default,,0,0,0,,Жоқ... Кешіріңіз.
Dialogue: 0,0:26:39.62,0:26:42.95,Default,,0,0,0,,Мен баламды өнер туындысы деп қателесіп сатып жібердім.
Dialogue: 0,0:26:42.95,0:26:46.62,Default,,0,0,0,,Бұл затты қайтарыңыз...
Dialogue: 0,0:26:46.62,0:26:49.96,Default,,0,0,0,,А... сен оны пайдаланбадың ба?
Dialogue: 0,0:26:49.96,0:26:51.96,Default,,0,0,0,,Сіз ақшаны қайтардыңыз ба?
Dialogue: 0,0:26:51.96,0:26:54.63,Default,,0,0,0,,Ойлап қарасам, армандарымды орындайтын нәрсе
Dialogue: 0,0:26:54.63,0:26:56.63,Default,,0,0,0,,Ақша емес
Dialogue: 0,0:26:56.63,0:27:00.64,Default,,0,0,0,,Отбасы ақшадан маңыздырақ.
Dialogue: 0,0:27:00.64,0:27:03.04,Default,,0,0,0,,бұл… хазуки…
Dialogue: 0,0:27:04.97,0:27:09.65,Default,,0,0,0,,Жарайды, егер солай десең, мен мұны саған қайтарамын.
Dialogue: 0,0:27:09.65,0:27:12.65,Default,,0,0,0,,Ол балалар кетіп қалды.
Dialogue: 0,0:27:12.65,0:27:14.65,Default,,0,0,0,,Кәдесый әкеліңіз
Dialogue: 0,0:27:14.65,0:27:17.65,Default,,0,0,0,,Иә! А... біз бір-бірімізді сағындық па?
Dialogue: 0,0:27:17.65,0:27:22.26,Default,,0,0,0,,Балалар, менің сүйікті наго мүсінімді әкелдіңдер ме?
Dialogue: 0,0:27:22.26,0:27:24.26,Default,,0,0,0,,Чими~!
Dialogue: 0,0:27:24.26,0:27:26.60,Default,,0,0,0,,Хазуки кешіріңіз
Dialogue: 0,0:27:26.60,0:27:29.60,Default,,0,0,0,,Отбасыңды бағалайтын жақсы жігітсің.
Dialogue: 0,0:27:29.60,0:27:32.60,Default,,0,0,0,,Күте тұрыңыз, мен мұны жалға алып жатырмын, иә?
Dialogue: 0,0:27:32.60,0:27:36.27,Default,,0,0,0,,Тозақ мырза менің 1 миллион иенімді қайтарады.
Dialogue: 0,0:27:36.27,0:27:38.27,Default,,0,0,0,,Аукционда.
Dialogue: 0,0:27:39.27,0:27:42.27,Default,,0,0,0,,Уф...
Dialogue: 0,0:27:43.28,0:27:45.28,Default,,0,0,0,,Хаа…
Dialogue: 0,0:27:45.28,0:27:47.28,Default,,0,0,0,,0 ұпай
Dialogue: 0,0:27:47.28,0:27:52.28,Default,,0,0,0,,Уф... тозақ!
Dialogue: 0,0:27:53.29,0:28:13.31,Default,,0,0,0,,Сен
Dialogue: 0,0:28:13.31,0:28:33.26,Default,,0,0,0,,Сен
Dialogue: 0,0:28:33.26,0:28:53.28,Default,,0,0,0,,Сен
Dialogue: 0,0:28:53.28,0:29:13.30,Default,,0,0,0,,Сен
Dialogue: 0,0:29:13.30,0:29:22.60,Default,,0,0,0,,Сен
Dialogue: 0,0:29:23.58,0:29:25.91,Default,,0,0,0,,<Туған күнін де білмейді.
Dialogue: 0,0:29:25.91,0:29:27.92,Default,,0,0,0,,Бейшара Тозақ мырза
Dialogue: 0,0:29:27.92,0:29:32.25,Default,,0,0,0,,Иә! Тосын туған күн кешін өткізейік>
Dialogue: 0,0:29:32.25,0:29:34.92,Default,,0,0,0,,<Келесі жолы: «Тозақ жоспары»
Dialogue: 0,0:29:34.92,0:29:36.93,Default,,0,0,0,,``Өлі тозақ'' >
Dialogue: 0,0:29:38.43,0:29:44.43,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory