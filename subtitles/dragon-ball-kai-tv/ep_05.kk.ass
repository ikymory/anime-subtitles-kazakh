Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.34,0:00:09.38,Default,,0000,0000,0000,,<Бір жылдан кейін келетін сайяндарға дайындал→
Dialogue: 0,0:00:09.38,0:00:13.42,Default,,0000,0000,0000,,Гоку Кай патшаның планетасын көздей бастады. →
Dialogue: 0,0:00:13.42,0:00:17.46,Default,,0000,0000,0000,,Осы кезде Пикколо Гоханды алып кетеді →
Dialogue: 0,0:00:17.46,0:00:21.50,Default,,0000,0000,0000,,Қатты дайындықтан басқа. →
Dialogue: 0,0:00:21.50,0:00:25.54,Default,,0000,0000,0000,,Crybaby Gohan керемет күшке ие→
Dialogue: 0,0:00:25.54,0:00:28.54,Default,,0000,0000,0000,,Ол ұйықтап қалды＞
Dialogue: 0,0:00:31.60,0:00:36.65,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:36.65,0:00:56.85,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:00:56.85,0:01:16.39,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:16.39,0:01:36.59,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:36.59,0:01:53.59,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:18.54,0:04:21.57,Default,,0000,0000,0000,,Ух... хе.
Dialogue: 0,0:04:21.57,0:04:23.59,Default,,0000,0000,0000,,Уу-у...
Dialogue: 0,0:04:23.59,0:04:28.64,Default,,0000,0000,0000,,Ууууууууууууууууу.
Dialogue: 0,0:04:28.64,0:04:30.64,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:04:34.70,0:04:39.75,Default,,0000,0000,0000,,Тынш, жаттығу үшін не істеуім керек?
Dialogue: 0,0:04:39.75,0:04:43.79,Default,,0000,0000,0000,,Біріншіден, ештеңе айтудың қажеті жоқ. Тірі.
Dialogue: 0,0:04:43.79,0:04:47.83,Default,,0000,0000,0000,,Ә!? Тірі?
Dialogue: 0,0:04:47.83,0:04:51.87,Default,,0000,0000,0000,,Егер алты айдан кейін аман қалсаңыз →
Dialogue: 0,0:04:51.87,0:04:53.87,Default,,0000,0000,0000,,Мен саған күресуді үйретемін.
Dialogue: 0,0:04:56.92,0:05:01.97,Default,,0000,0000,0000,,Маған ұнамайды. Мен жалғыздықтан өлемін.
Dialogue: 0,0:05:01.97,0:05:04.00,Default,,0000,0000,0000,,Хехехе мен жалғыздықты сезінбеймін. →
Dialogue: 0,0:05:04.00,0:05:08.37,Default,,0000,0000,0000,,Бұл жерде қанішер аңдар көп.
Dialogue: 0,0:05:08.37,0:05:13.42,Default,,0000,0000,0000,,Уф, мұны доғар.
Dialogue: 0,0:05:13.42,0:05:15.44,Default,,0000,0000,0000,,Уау! Мені артта қалдырмаңыз!
Dialogue: 0,0:05:15.44,0:05:20.49,Default,,0000,0000,0000,,Дәл қазір тоқмейілсуге уақыт жоқ!
Dialogue: 0,0:05:20.49,0:05:22.51,Default,,0000,0000,0000,,Өйткені мен...
Dialogue: 0,0:05:22.51,0:05:27.56,Default,,0000,0000,0000,,6 айдан аман өтіп, алдымен қаттылықты үйреніңіз. →
Dialogue: 0,0:05:27.56,0:05:30.59,Default,,0000,0000,0000,,Физикалық жағынан да, психикалық жағынан да.
Dialogue: 0,0:05:30.59,0:05:33.62,Default,,0000,0000,0000,,Бұл жер тағдырының кілті→
Dialogue: 0,0:05:33.62,0:05:36.65,Default,,0000,0000,0000,,Сіз жауапты екеніңізді ұмытпаңыз!
Dialogue: 0,0:05:36.65,0:05:39.68,Default,,0000,0000,0000,,Өз күшіңізге сеніңіз. →
Dialogue: 0,0:05:39.68,0:05:43.72,Default,,0000,0000,0000,,Бұл күшті қалай тиімді шығару керектігін өзіңіз үйреніңіз.
Dialogue: 0,0:05:43.72,0:05:46.75,Default,,0000,0000,0000,,Өйткені мен... Онда кездескенше.
Dialogue: 0,0:05:46.75,0:05:50.79,Default,,0000,0000,0000,,Күте тұрыңыз! тамақ қайда?
Dialogue: 0,0:05:50.79,0:05:52.81,Default,,0000,0000,0000,,Ванна ше? Төсек ше?
Dialogue: 0,0:05:52.81,0:05:57.86,Default,,0000,0000,0000,,Сіз осындай нәрсе бар деп ойлайсыз ба? Кішкентай бала. →
Dialogue: 0,0:05:57.86,0:06:00.89,Default,,0000,0000,0000,,Егер сіз оны жек көрсеңіз, өз тағдырыңызды жек көруіңіз керек. →
Dialogue: 0,0:06:00.89,0:06:02.89,Default,,0000,0000,0000,,Мен сияқты.
Dialogue: 0,0:06:04.93,0:06:06.93,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:06:08.30,0:06:10.32,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:06:10.32,0:06:15.32,Default,,0000,0000,0000,,Қорқынышты~ Мені артымда қалдырмаңыз~!
Dialogue: 0,0:06:24.46,0:06:28.50,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:06:28.50,0:06:33.50,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:06:35.57,0:06:39.61,Default,,0000,0000,0000,,Құдай-ау, бұл біраз оғаш. Не болды?
Dialogue: 0,0:06:39.61,0:06:42.64,Default,,0000,0000,0000,,Хмм…. →
Dialogue: 0,0:06:42.64,0:06:46.68,Default,,0000,0000,0000,,Пикколо бұрынғысынан ерекшеленетін сияқты. →
Dialogue: 0,0:06:46.68,0:06:48.70,Default,,0000,0000,0000,,Бұл сөзсіз зұлым →
Dialogue: 0,0:06:48.70,0:06:53.75,Default,,0000,0000,0000,,Өткеннің қулығы мен өрескелдігі жойылып бара жатқандай сезінемін.
Dialogue: 0,0:06:53.75,0:06:55.77,Default,,0000,0000,0000,,Попо да солай ойлайды.
Dialogue: 0,0:06:55.77,0:06:59.81,Default,,0000,0000,0000,,Бұрынғы ұлы жын патша болса, Сон Гокудың ұлы күшті болмас еді.
Dialogue: 0,0:06:59.81,0:07:03.85,Default,,0000,0000,0000,,Мен Пикколоның біртүрлі екенін анық байқадым →
Dialogue: 0,0:07:03.85,0:07:06.22,Default,,0000,0000,0000,,Сол жігіт Пикколо өлтірген Радицке телефон соқты→
Dialogue: 0,0:07:06.22,0:07:11.27,Default,,0000,0000,0000,,Сон Гоку ағасының жаны о дүниеге кеткен.
Dialogue: 0,0:07:11.27,0:07:23.39,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:23.39,0:07:27.43,Default,,0000,0000,0000,,Осы уақытқа дейін жындар өлтіргендердің жаны → болатын
Dialogue: 0,0:07:27.43,0:07:33.49,Default,,0000,0000,0000,,Буддалыққа жете алмаған ол азаптан аспанда қалқып жүре берген болуы керек. →
Dialogue: 0,0:07:33.49,0:07:37.53,Default,,0000,0000,0000,,Сонда да Радиц басқа әлемде болды→
Dialogue: 0,0:07:37.53,0:07:41.57,Default,,0000,0000,0000,,Оның ескі Пикколодан өзгеше екені анық.
Dialogue: 0,0:07:41.57,0:07:45.61,Default,,0000,0000,0000,,Сіз Пикколоның жүрегі жақсы деп айттыңыз ба?
Dialogue: 0,0:07:45.61,0:07:48.64,Default,,0000,0000,0000,,Мүмкін сіз байқаған боларсыз.
Dialogue: 0,0:07:48.64,0:07:51.67,Default,,0000,0000,0000,,Менің өмірім, яғни Пикколоның да өмірі→
Dialogue: 0,0:07:51.67,0:07:55.71,Default,,0000,0000,0000,,Бар болғаны бір жыл қалды.
Dialogue: 0,0:07:55.71,0:07:58.74,Default,,0000,0000,0000,,Бір жыл қалды...
Dialogue: 0,0:07:58.74,0:08:02.78,Default,,0000,0000,0000,,Бір жылдан кейін келетін сайандар →
Dialogue: 0,0:08:02.78,0:08:05.97,Default,,0000,0000,0000,,Бұл Пикколо өлтірілетіндіктен бе? →
Dialogue: 0,0:08:05.97,0:08:10.19,Default,,0000,0000,0000,,Әлде менің өмірім сол уақытта бітетіндіктен бе→
Dialogue: 0,0:08:10.19,0:08:12.21,Default,,0000,0000,0000,,Мен білмеймін. →
Dialogue: 0,0:08:12.21,0:08:15.24,Default,,0000,0000,0000,,Менің өлімім - Пикколоның өлімі→
Dialogue: 0,0:08:15.24,0:08:20.29,Default,,0000,0000,0000,,Пикколоның өлімі де менің өлімім. →
Dialogue: 0,0:08:20.29,0:08:23.32,Default,,0000,0000,0000,,Нухахахаха. Құдай болса да→
Dialogue: 0,0:08:23.32,0:08:28.37,Default,,0000,0000,0000,,Мен қашан өлетінімді білгенді ұнатпаймын.
Dialogue: 0,0:08:28.37,0:08:31.40,Default,,0000,0000,0000,,Оны ол да сезіп тұрған болуы керек.
Dialogue: 0,0:08:31.40,0:08:34.43,Default,,0000,0000,0000,,Менің ойымша, ол бірдеңе қалдырғысы келді.
Dialogue: 0,0:08:34.43,0:08:37.46,Default,,0000,0000,0000,,Сон Гокудың ұлы болса да.
Dialogue: 0,0:08:37.46,0:08:40.49,Default,,0000,0000,0000,,Айдаһар шарларын да пайдалануға болады...
Dialogue: 0,0:08:40.49,0:08:45.54,Default,,0000,0000,0000,,Хмм... тағы бір рет соңғысы болар.
Dialogue: 0,0:08:45.54,0:08:48.57,Default,,0000,0000,0000,,Гохан сондай мықты жігіт еді→
Dialogue: 0,0:08:48.57,0:08:51.60,Default,,0000,0000,0000,,О, мен мұны мүлде білмедім.
Dialogue: 0,0:08:51.60,0:08:54.63,Default,,0000,0000,0000,,Оланың баласы ғой хахахаха.
Dialogue: 0,0:08:54.63,0:08:56.63,Default,,0000,0000,0000,,О?
Dialogue: 0,0:08:59.68,0:09:04.73,Default,,0000,0000,0000,,Түсіндім! Сізге мүлдем жол жүрудің қажеті жоқ.
Dialogue: 0,0:09:04.73,0:09:06.73,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:09:09.11,0:09:11.11,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:09:14.16,0:09:17.19,Default,,0000,0000,0000,,Хехе, осымен, тез арада сонда боласыз.
Dialogue: 0,0:09:17.19,0:09:19.21,Default,,0000,0000,0000,,Уау!? Апыр-ай?
Dialogue: 0,0:09:19.21,0:09:22.24,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:22.24,0:09:24.24,Default,,0000,0000,0000,,Ауырды...
Dialogue: 0,0:09:29.31,0:09:31.33,Default,,0000,0000,0000,,Иә? Апыр-ай!
Dialogue: 0,0:09:31.33,0:09:35.37,Default,,0000,0000,0000,,Ува Ува Кук.
Dialogue: 0,0:09:35.37,0:09:38.40,Default,,0000,0000,0000,,Ілмек.
Dialogue: 0,0:09:38.40,0:09:40.40,Default,,0000,0000,0000,,Урья~!
Dialogue: 0,0:09:43.45,0:09:45.47,Default,,0000,0000,0000,,О...
Dialogue: 0,0:09:45.47,0:09:50.52,Default,,0000,0000,0000,,Әй, қауіпті, қауіпті, бұлт астындағы тозақ еді.
Dialogue: 0,0:09:50.52,0:09:52.54,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:09:52.54,0:09:55.54,Default,,0000,0000,0000,,А... иә?
Dialogue: 0,0:09:58.60,0:10:00.60,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:10:02.64,0:10:05.84,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:10:05.84,0:10:07.02,Default,,0000,0000,0000,,Ува Ува Ува!
Dialogue: 0,0:10:07.02,0:10:10.05,Default,,0000,0000,0000,,Уау Уау.
Dialogue: 0,0:10:10.05,0:10:12.07,Default,,0000,0000,0000,,Уау~ Маған көмектес!
Dialogue: 0,0:10:12.07,0:10:17.12,Default,,0000,0000,0000,,Біреу көмектесіңізші! Апыр-ай!
Dialogue: 0,0:10:17.12,0:10:19.14,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:10:19.14,0:10:21.14,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:10:32.27,0:10:35.30,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:10:35.30,0:10:37.30,Default,,0000,0000,0000,,Иә? Иә?
Dialogue: 0,0:10:40.35,0:10:42.35,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:10:47.42,0:10:49.44,Default,,0000,0000,0000,,Ааааа….
Dialogue: 0,0:10:49.44,0:10:52.47,Default,,0000,0000,0000,,Фуэн.
Dialogue: 0,0:10:52.47,0:10:55.50,Default,,0000,0000,0000,,Уф, мен түсе алмаймын.
Dialogue: 0,0:10:55.50,0:10:57.50,Default,,0000,0000,0000,,Бұл қорқынышты.
Dialogue: 0,0:11:00.55,0:11:02.57,Default,,0000,0000,0000,,Қарғыс атсын.
Dialogue: 0,0:11:02.57,0:11:06.95,Default,,0000,0000,0000,,Сол гид: ``Егер мен өлсем, мен аш болмаймын''-деген.
Dialogue: 0,0:11:06.95,0:11:09.98,Default,,0000,0000,0000,,Ол төмендеді!
Dialogue: 0,0:11:09.98,0:11:12.98,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:11:14.03,0:11:16.05,Default,,0000,0000,0000,,Не? Айта алмадың ба?
Dialogue: 0,0:11:16.05,0:11:19.08,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:11:19.08,0:11:21.10,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:11:21.10,0:11:24.13,Default,,0000,0000,0000,,Мүмкін емес пе? Ештеңе емес пе? Күрсіну….
Dialogue: 0,0:11:24.13,0:11:29.18,Default,,0000,0000,0000,,Менің қолымнан ештеңе келмейді...себебі мен шын мәнінде еріксіз емеспін.
Dialogue: 0,0:11:29.18,0:11:33.22,Default,,0000,0000,0000,,Жарайды, солай айтсам да, Чи-Чидің түрін көргенде→
Dialogue: 0,0:11:33.22,0:11:36.25,Default,,0000,0000,0000,,Гоку өлді деп айта алмайсың.
Dialogue: 0,0:11:36.25,0:11:40.29,Default,,0000,0000,0000,,Таңқаларлық емес. Бірақ осылай қала берсе...
Dialogue: 0,0:11:40.29,0:11:45.34,Default,,0000,0000,0000,,Бәлкім, хат жазып, түсіндірсең, түсінетін шығар.
Dialogue: 0,0:11:45.34,0:11:48.37,Default,,0000,0000,0000,,А, иә, бұл жақсы.
Dialogue: 0,0:11:48.37,0:11:52.41,Default,,0000,0000,0000,,Айтпақшы, Криллин, Dragon Ball ше?
Dialogue: 0,0:11:52.41,0:11:54.43,Default,,0000,0000,0000,,Немереңнің басынан өтті ғой, солай ма? екі.
Dialogue: 0,0:11:54.43,0:11:57.46,Default,,0000,0000,0000,,Ах! А, мен ұмытып қалдым.
Dialogue: 0,0:11:57.46,0:11:59.46,Default,,0000,0000,0000,,Пайдасыз.
Dialogue: 0,0:12:03.52,0:12:08.90,Default,,0000,0000,0000,,Сәлем у...
Dialogue: 0,0:12:08.90,0:12:12.94,Default,,0000,0000,0000,,Қорқынышты ~ Суық ~.
Dialogue: 0,0:12:12.94,0:12:16.94,Default,,0000,0000,0000,,Сіз қарт адамсыз. Сен өлесің.
Dialogue: 0,0:12:19.01,0:12:23.05,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:12:23.05,0:12:28.10,Default,,0000,0000,0000,,А, алма. Алма құлап бара жатты. Бақытты.
Dialogue: 0,0:12:28.10,0:12:31.13,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:31.13,0:12:33.13,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:36.18,0:12:38.18,Default,,0000,0000,0000,,Жарайсың ба?
Dialogue: 0,0:12:43.25,0:12:49.31,Default,,0000,0000,0000,,Уф... бұл қышқыл, дәмі нашар.
Dialogue: 0,0:12:49.31,0:12:52.34,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:52.34,0:12:57.39,Default,,0000,0000,0000,,Мен қытай мангасын жегім келеді. Мен Шумайды жегім келеді.
Dialogue: 0,0:12:57.39,0:13:00.39,Default,,0000,0000,0000,,Қарғыс атқыр бала, өзіңді күтпе.
Dialogue: 0,0:13:02.44,0:13:05.64,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:05.64,0:13:07.64,Default,,0000,0000,0000,,Ха...
Dialogue: 0,0:13:09.84,0:13:11.86,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:13:11.86,0:13:16.91,Default,,0000,0000,0000,,Қорқынышты, қорқынышты, қорқынышты….
Dialogue: 0,0:13:16.91,0:13:21.96,Default,,0000,0000,0000,,《Тыңда, мен саған қол ұшын бере алатын жалғыз жолым. →
Dialogue: 0,0:13:21.96,0:13:25.00,Default,,0000,0000,0000,,Осыдан кейін өмір сүре алмасаңыз, онда...
Dialogue: 0,0:13:25.00,0:13:29.04,Default,,0000,0000,0000,,Ол сондай бала еді.》
Dialogue: 0,0:13:29.04,0:13:37.04,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:14:53.55,0:14:55.57,Default,,0000,0000,0000,,Хакушон! Иә?
Dialogue: 0,0:14:55.57,0:14:58.57,Default,,0000,0000,0000,,Уау, өте жарқын!
Dialogue: 0,0:15:00.62,0:15:02.64,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:02.64,0:15:04.64,Default,,0000,0000,0000,,Хуа~.
Dialogue: 0,0:15:06.68,0:15:09.71,Default,,0000,0000,0000,,Иә? Иә?
Dialogue: 0,0:15:09.71,0:15:12.74,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:15:12.74,0:15:16.78,Default,,0000,0000,0000,,Уф, мен түсе алмаймын. Менің қарыным ашты.
Dialogue: 0,0:15:16.78,0:15:20.82,Default,,0000,0000,0000,,Уау, бұл қорқынышты.
Dialogue: 0,0:15:20.82,0:15:24.82,Default,,0000,0000,0000,,Аш болсаң, сол жерге түсіп, тамақ ізде.
Dialogue: 0,0:15:27.89,0:15:31.93,Default,,0000,0000,0000,,Мен түнде үйде бол деп айтатынмын.
Dialogue: 0,0:15:31.93,0:15:34.96,Default,,0000,0000,0000,,Гоку да біраз уақыттан кейін алғаш рет Каме Хаусқа барды →
Dialogue: 0,0:15:34.96,0:15:39.01,Default,,0000,0000,0000,,Сағынышпен сөйлескеніміз сонша, уақытты жоғалтып алдық.
Dialogue: 0,0:15:39.01,0:15:43.22,Default,,0000,0000,0000,,Гоку үшін бұл жақсы болса да, Гоханның мектепі бар.
Dialogue: 0,0:15:43.22,0:15:46.41,Default,,0000,0000,0000,,Мен бір күн бойы жалқау болып, сабақты жіберіп алдым...
Dialogue: 0,0:15:46.41,0:15:48.43,Default,,0000,0000,0000,,Менің әкем тәтті!
Dialogue: 0,0:15:48.43,0:15:52.47,Default,,0000,0000,0000,,Болашақ дүниеде кім оқи алады, сол жеңеді!
Dialogue: 0,0:15:52.47,0:15:55.47,Default,,0000,0000,0000,,Даа~! Эй, уау!
Dialogue: 0,0:15:58.53,0:16:01.56,Default,,0000,0000,0000,,Хмм... Бұл ше?
Dialogue: 0,0:16:01.56,0:16:04.59,Default,,0000,0000,0000,,Сәлем! Бұл аяқталды.
Dialogue: 0,0:16:04.59,0:16:06.61,Default,,0000,0000,0000,,
Dialogue: 0,0:16:06.61,0:16:08.63,Default,,0000,0000,0000,,Ммм... Куу~.
Dialogue: 0,0:16:08.63,0:16:10.65,Default,,0000,0000,0000,,(мылтық дыбысы)
Dialogue: 0,0:16:10.65,0:16:16.71,Default,,0000,0000,0000,,Мұндай кезде сіз жай ғана демалып, ұйықтай аласыз.
Dialogue: 0,0:16:16.71,0:16:21.76,Default,,0000,0000,0000,,Тасбақа мырза, тұрыңыз.
Dialogue: 0,0:16:21.76,0:16:24.79,Default,,0000,0000,0000,,Ka? Тасбақа қария?
Dialogue: 0,0:16:24.79,0:16:28.79,Default,,0000,0000,0000,,Түсінікті болу үшін дисплейдегі мәтінді өзгерттім.
Dialogue: 0,0:16:30.85,0:16:33.88,Default,,0000,0000,0000,,Жақсы, 139.
Dialogue: 0,0:16:33.88,0:16:37.92,Default,,0000,0000,0000,,139? Мен онша жас емеспін.
Dialogue: 0,0:16:37.92,0:16:40.95,Default,,0000,0000,0000,,Бұл Мутен Роши шеберінің күшін көрсететін сан.
Dialogue: 0,0:16:40.95,0:16:45.33,Default,,0000,0000,0000,,Күшті көрсететін сан? Апыр-ай! Бұл керемет машина.
Dialogue: 0,0:16:45.33,0:16:47.35,Default,,0000,0000,0000,,Сіз мұны білесіз бе?
Dialogue: 0,0:16:47.35,0:16:50.38,Default,,0000,0000,0000,,Бұлма мырза. Мен неше жастамын?
Dialogue: 0,0:16:50.38,0:16:55.43,Default,,0000,0000,0000,,Аа... Эххе.
Dialogue: 0,0:16:55.43,0:16:57.45,Default,,0000,0000,0000,,Керемет! Бұл 206.
Dialogue: 0,0:16:57.45,0:17:01.49,Default,,0000,0000,0000,,Уау~ Сіз Мутен Роши шеберінен шынымен де асып түстіңіз.
Dialogue: 0,0:17:01.49,0:17:05.53,Default,,0000,0000,0000,,Әй, бұл ақаулық емес пе?
Dialogue: 0,0:17:05.53,0:17:07.55,Default,,0000,0000,0000,,Мақтанғаным емес, қолым...
Dialogue: 0,0:17:07.55,0:17:09.57,Default,,0000,0000,0000,,（）～
Dialogue: 0,0:17:09.57,0:17:11.59,Default,,0000,0000,0000,,Эй!
Dialogue: 0,0:17:11.59,0:17:14.62,Default,,0000,0000,0000,,Бұл кім? Бұл оны шақырудың біртүрлі тәсілі.
Dialogue: 0,0:17:14.62,0:17:16.64,Default,,0000,0000,0000,,Бұл менмін. Ах.
Dialogue: 0,0:17:16.64,0:17:20.68,Default,,0000,0000,0000,,Армадилло Карин-саманың орнында болғанына сенімдімін.
Dialogue: 0,0:17:20.68,0:17:24.72,Default,,0000,0000,0000,,Бұл Яджироб, ақымақ! Мен әдейі қателік жасадым. →
Dialogue: 0,0:17:24.72,0:17:28.76,Default,,0000,0000,0000,,Жарайды, Қарин маған келіп хабар жеткізуімді өтінді.
Dialogue: 0,0:17:28.76,0:17:31.79,Default,,0000,0000,0000,,Иә? Карин-самадан хабар?
Dialogue: 0,0:17:31.79,0:17:34.82,Default,,0000,0000,0000,,Мен барлық жағдайларды білемін.
Dialogue: 0,0:17:34.82,0:17:38.86,Default,,0000,0000,0000,,Сонымен, сіз, Ямча, Тенка және Гёза?→
Dialogue: 0,0:17:38.86,0:17:40.88,Default,,0000,0000,0000,,Мен саған бірден кел дедім.
Dialogue: 0,0:17:40.88,0:17:44.26,Default,,0000,0000,0000,,Не, бәріміз Карин мұнарасына барамыз ба? (Кәме-сеннин) Неге?
Dialogue: 0,0:17:44.26,0:17:47.29,Default,,0000,0000,0000,,Құдай саған тәлім береді.
Dialogue: 0,0:17:47.29,0:17:50.32,Default,,0000,0000,0000,,Мен де солаймын. Расында ма?
Dialogue: 0,0:17:50.32,0:17:55.37,Default,,0000,0000,0000,,Ах. Мен не істерімді білмеймін, мен күштімін. Мен өзімді инопланетяндық немесе басқа нәрсе деп ойламаймын.
Dialogue: 0,0:17:55.37,0:17:59.41,Default,,0000,0000,0000,,Мен ұрысқым келмейтінін айттым, бірақ бұлай істеуге мәжбүр болдым.
Dialogue: 0,0:17:59.41,0:18:01.43,Default,,0000,0000,0000,,Аа, кешіріңіз.
Dialogue: 0,0:18:01.43,0:18:04.46,Default,,0000,0000,0000,,Жарайды, мен барлығын тауып алып, дереу кетемін.
Dialogue: 0,0:18:04.46,0:18:08.50,Default,,0000,0000,0000,,Олай болса, мен сізге айтқаныма көз жеткізіңіз. →
Dialogue: 0,0:18:08.50,0:18:11.53,Default,,0000,0000,0000,,О, мен ұмытып қалдым. →
Dialogue: 0,0:18:11.53,0:18:15.57,Default,,0000,0000,0000,,Гокудың жігіті оны жау келгенше тірі қалдыруға болмайды дейді →
Dialogue: 0,0:18:15.57,0:18:18.60,Default,,0000,0000,0000,,Мен айттым ғой. Не? Неліктен?
Dialogue: 0,0:18:18.60,0:18:22.64,Default,,0000,0000,0000,,Ол жігіт о дүниеде жаттығады. Толығырақ →
Dialogue: 0,0:18:22.64,0:18:25.67,Default,,0000,0000,0000,,Жақында сәуегей кәрі қаңбақ келетін сияқты →
Dialogue: 0,0:18:25.67,0:18:27.69,Default,,0000,0000,0000,,Менен сұрасаңыз, сәл күте тұрыңыз.
Dialogue: 0,0:18:27.69,0:18:29.71,Default,,0000,0000,0000,,Иә? Ах...
Dialogue: 0,0:18:29.71,0:18:31.71,Default,,0000,0000,0000,,Не? Қашан?
Dialogue: 0,0:18:33.75,0:18:38.80,Default,,0000,0000,0000,,Әй, о дүниеде жаттығу... (Кәме-сеннің) Не?
Dialogue: 0,0:18:38.80,0:18:41.83,Default,,0000,0000,0000,,Сіз өте әдемісіз. Хмм…
Dialogue: 0,0:18:41.83,0:18:45.83,Default,,0000,0000,0000,,Ол қайтадан артқа бұрылды. иә? Ах.
Dialogue: 0,0:18:47.22,0:18:52.27,Default,,0000,0000,0000,,Ух-хо-хо-хо, Мутен Роши-сама.
Dialogue: 0,0:18:52.27,0:18:55.30,Default,,0000,0000,0000,,Уа! Чичи мен Гюмау!
Dialogue: 0,0:18:55.30,0:18:59.34,Default,,0000,0000,0000,,Уау. (3 адам) Ахх...
Dialogue: 0,0:18:59.34,0:19:03.38,Default,,0000,0000,0000,,Мастер Мутен Роши, біз не істеуіміз керек?
Dialogue: 0,0:19:03.38,0:19:08.43,Default,,0000,0000,0000,,Мен әлі хат жазған жоқпын.
Dialogue: 0,0:19:08.43,0:19:13.48,Default,,0000,0000,0000,,Мастер Мутен Роши, біраз уақыт болды. →
Dialogue: 0,0:19:13.48,0:19:18.53,Default,,0000,0000,0000,,Қалайсың? (Каме Эрмит) А... Иә, жақсы.
Dialogue: 0,0:19:18.53,0:19:24.59,Default,,0000,0000,0000,,Оранчиден Гоку мен Гохан осында болуы керек. Бұл қайда?
Dialogue: 0,0:19:24.59,0:19:28.63,Default,,0000,0000,0000,,А, у... шынымен... (Чичи/Ушимау) Иә?
Dialogue: 0,0:19:28.63,0:19:31.66,Default,,0000,0000,0000,,Бұрыш, бұрыш, бұрыш.
Dialogue: 0,0:19:31.66,0:19:36.71,Default,,0000,0000,0000,,Ә!? Пикколоны Демон Кинг алып кетті ме?
Dialogue: 0,0:19:36.71,0:19:39.74,Default,,0000,0000,0000,,Гокуға не болды?
Dialogue: 0,0:19:39.74,0:19:41.76,Default,,0000,0000,0000,,Тш, ол қайтыс болды...
Dialogue: 0,0:19:41.76,0:19:44.12,Default,,0000,0000,0000,,Ә!?
Dialogue: 0,0:19:44.12,0:19:47.15,Default,,0000,0000,0000,,Ааа….
Dialogue: 0,0:19:47.15,0:19:50.15,Default,,0000,0000,0000,,Чичи! Мен оны дұрыс жасаймын.
Dialogue: 0,0:20:08.36,0:20:10.38,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:10.38,0:20:14.38,Default,,0000,0000,0000,,Бұл қалай болды деп ойлаймын.
Dialogue: 0,0:20:16.44,0:20:19.47,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:20:19.47,0:20:23.51,Default,,0000,0000,0000,,Неліктен сонша жарық? Иә?
Dialogue: 0,0:20:23.51,0:20:29.57,Default,,0000,0000,0000,,Әй, ай. Уау~ Бұл тамаша шеңбер.
Dialogue: 0,0:20:29.57,0:20:33.57,Default,,0000,0000,0000,,Толық айды бірінші рет көріп тұрмын...
Dialogue: 0,0:20:37.65,0:20:39.67,Default,,0000,0000,0000,,(жүрек соғысы)
Dialogue: 0,0:20:39.67,0:20:42.70,Default,,0000,0000,0000,,Иә? Не?
Dialogue: 0,0:20:42.70,0:21:02.23,Default,,0000,0000,0000,,(жүрек соғысы)
Dialogue: 0,0:21:02.23,0:21:04.25,Default,,0000,0000,0000,,(жүрек соғысы)
Dialogue: 0,0:21:04.25,0:21:06.25,Default,,0000,0000,0000,,Гуо….
Dialogue: 0,0:21:10.31,0:21:12.33,Default,,0000,0000,0000,,Гуо~!
Dialogue: 0,0:21:12.33,0:21:22.43,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:21:22.43,0:21:25.43,Default,,0000,0000,0000,,О!
Dialogue: 0,0:21:28.49,0:21:30.49,Default,,0000,0000,0000,,(Дарио) Дио, мына жаққа кел. Жөтел, жөтел!
Dialogue: 0,0:21:32.53,0:21:34.53,Default,,0000,0000,0000,,Гаа~!
Dialogue: 0,0:21:41.62,0:21:43.62,Default,,0000,0000,0000,,Гуо~!
Dialogue: 0,0:21:46.01,0:21:48.01,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:21:52.07,0:21:54.07,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:22:01.16,0:22:06.21,Default,,0000,0000,0000,,Осы қарқынмен сайяндар келгенге дейін Жер жойылады. →
Dialogue: 0,0:22:06.21,0:22:08.23,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:22:08.23,0:22:11.23,Default,,0000,0000,0000,,Сіз нені айтасыз? Ха!
Dialogue: 0,0:22:13.28,0:22:17.32,Default,,0000,0000,0000,,《Алданба! Міне, ай мінсіз шеңбер сызады →
Dialogue: 0,0:22:17.32,0:22:20.35,Default,,0000,0000,0000,,Сайяндар ретінде біз өзіміздің шынайы әлеуетімізді көрсететін уақыт жетті емес пе?
Dialogue: 0,0:22:20.35,0:22:22.37,Default,,0000,0000,0000,,
Dialogue: 0,0:22:22.37,0:22:26.41,Default,,0000,0000,0000,,Түсіндім! Бұл толық ай. →
Dialogue: 0,0:22:26.41,0:22:31.41,Default,,0000,0000,0000,,Фуууууу... жоғал!
Dialogue: 0,0:22:36.51,0:22:39.54,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:22:39.54,0:22:45.93,Default,,0000,0000,0000,,Гррррр….
Dialogue: 0,0:22:45.93,0:22:48.93,Default,,0000,0000,0000,,Гао~!
Dialogue: 0,0:22:51.99,0:22:55.99,Default,,0000,0000,0000,,Гаа~.
Dialogue: 0,0:23:02.10,0:23:07.10,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:23:09.17,0:23:14.22,Default,,0000,0000,0000,,Мен ешқашан өзгереді деп ойламадым. Саян қаны? →
Dialogue: 0,0:23:14.22,0:23:19.27,Default,,0000,0000,0000,,Мен Сон Гоку күшінің сырын ашқандай болдым.
Dialogue: 0,0:23:19.27,0:23:24.32,Default,,0000,0000,0000,,Айды жару дұрыс болған сияқты. →
Dialogue: 0,0:23:24.32,0:23:29.37,Default,,0000,0000,0000,,Сайяндар осындай құбыжық болып кетсе екен→
Dialogue: 0,0:23:29.37,0:23:32.40,Default,,0000,0000,0000,,Бұл қорқынышты. →
Dialogue: 0,0:23:32.40,0:23:35.43,Default,,0000,0000,0000,,Құйрығы туралы бірдеңе айтты→
Dialogue: 0,0:23:35.43,0:23:39.47,Default,,0000,0000,0000,,Трансформация үшін сізге толық ай мен құйрық керек сияқты.
Dialogue: 0,0:23:39.47,0:23:41.49,Default,,0000,0000,0000,,Құйрығыңды шешейін бе?
Dialogue: 0,0:23:41.49,0:23:44.85,Default,,0000,0000,0000,,Егер жағдай осылай жалғаса берсе, алаңдаудың қажеті жоқ→
Dialogue: 0,0:23:44.85,0:23:48.85,Default,,0000,0000,0000,,Сайяндардың құйрықтарында әлсіз жер бар сияқты.
Dialogue: 0,0:23:50.91,0:23:52.93,Default,,0000,0000,0000,,Жарайды. →
Dialogue: 0,0:23:52.93,0:23:55.96,Default,,0000,0000,0000,,Тым болмаса киім-кешек пен қылышпен қамтамасыз етемін.
Dialogue: 0,0:23:55.96,0:23:58.96,Default,,0000,0000,0000,,Мен оны сіздің әкеңіздікіндей етіп жасаймын.
Dialogue: 0,0:24:03.04,0:24:09.10,Default,,0000,0000,0000,,Хехехе. Әріптер сәл өзгеше болса да. →
Dialogue: 0,0:24:09.10,0:24:13.14,Default,,0000,0000,0000,,Мен өзімді жаттықтыруым керек. Қазір барайық. →
Dialogue: 0,0:24:13.14,0:24:17.18,Default,,0000,0000,0000,,Осы жерде алты ай аман-есен жүре алсаңыз →
Dialogue: 0,0:24:17.18,0:24:21.22,Default,,0000,0000,0000,,Пикколо-сама, оны тозақта арнайы дайындықтан өткізейік.
Dialogue: 0,0:24:21.22,0:24:25.26,Default,,0000,0000,0000,,Мен өлгенім жақсы болар еді деп ойлаймын. →
Dialogue: 0,0:24:25.26,0:24:28.29,Default,,0000,0000,0000,,Дайын болыңыз.
Dialogue: 0,0:24:28.29,0:24:32.29,Default,,0000,0000,0000,,Ал мен сені жақсы жынға айналдырамын.
Dialogue: 0,0:24:34.35,0:24:37.38,Default,,0000,0000,0000,,<Сайяндарды жеңу. →
Dialogue: 0,0:24:37.38,0:24:43.38,Default,,0000,0000,0000,,Әке мен балаға салынған ауыр сынақтар жалғасуда>
Dialogue: 0,0:24:46.47,0:24:51.52,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:51.52,0:25:11.72,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:11.72,0:25:31.92,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:31.92,0:25:44.92,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:48.43,0:25:52.47,Default,,0000,0000,0000,,Сәлем, Гоку. Алақай! Мен жыланның құйрығын көрдім.
Dialogue: 0,0:25:52.47,0:25:55.50,Default,,0000,0000,0000,,Жылан екенін ескерсек, ауыр екен.
Dialogue: 0,0:25:55.50,0:25:57.52,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:25:57.52,0:26:01.56,Default,,0000,0000,0000,,Сен көкте не істеп жүрсің? Уау, бұл тамаша.
Dialogue: 0,0:26:01.56,0:26:05.60,Default,,0000,0000,0000,,Ә!? Кез келген жағдайда, сіз Кай патшасыз ба?
Dialogue: 0,0:26:05.60,0:26:07.60,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»
Dialogue: 0,0:26:10.65,0:26:13.65,Default,,0000,0000,0000,,Әке, мен күшейдім.
Dialogue: 0,0:26:15.15,0:26:21.15,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory