Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.50,0:00:14.55,Default,,0000,0000,0000,,<Пиколо мен Гоку ақыры Радицті жеңді→
Dialogue: 0,0:00:14.55,0:00:18.59,Default,,0000,0000,0000,,Жер дағдарысы енді ғана басталды>
Dialogue: 0,0:00:18.59,0:00:20.61,Default,,0000,0000,0000,,<Қалған криллиндерге→
Dialogue: 0,0:00:20.61,0:00:24.65,Default,,0000,0000,0000,,Гокудың құрбандығы ауыр болды>
Dialogue: 0,0:00:24.65,0:00:28.65,Default,,0000,0000,0000,,Гоку~!!
Dialogue: 0,0:00:31.72,0:00:36.77,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:36.77,0:00:56.97,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:00:56.97,0:01:16.50,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:16.50,0:01:36.70,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:36.70,0:01:53.70,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:20.67,0:04:22.69,Default,,0000,0000,0000,,《Қазір туралы Гоку Сатачи→
Dialogue: 0,0:04:22.69,0:04:26.73,Default,,0000,0000,0000,,Олар тасбақа үйінде көңіл көтеру керек. →
Dialogue: 0,0:04:26.73,0:04:30.77,Default,,0000,0000,0000,,Гохан жақсы бейімделіп жатыр ма? →
Dialogue: 0,0:04:30.77,0:04:34.81,Default,,0000,0000,0000,,Бірақ бәрібір. →
Dialogue: 0,0:04:34.81,0:04:38.85,Default,,0000,0000,0000,,Әдепті бала.
Dialogue: 0,0:04:38.85,0:04:40.87,Default,,0000,0000,0000,,Менің де кетуім керек еді.
Dialogue: 0,0:04:40.87,0:04:42.89,Default,,0000,0000,0000,,（）
Dialogue: 0,0:04:42.89,0:04:46.93,Default,,0000,0000,0000,,- (Гюмаоу) Гохан-чан!
Dialogue: 0,0:04:46.93,0:04:48.95,Default,,0000,0000,0000,,Ах. Эй әке!
Dialogue: 0,0:04:48.95,0:04:53.00,Default,,0000,0000,0000,,Хахаха. Чичи, Гохан қайда?
Dialogue: 0,0:04:53.00,0:04:56.03,Default,,0000,0000,0000,,Сәлем, Гохан Чан. →
Dialogue: 0,0:04:56.03,0:05:00.07,Default,,0000,0000,0000,,Мен көптеген кәдесыйлар әкелдім.
Dialogue: 0,0:05:00.07,0:05:02.07,Default,,0000,0000,0000,,Ахаха, әке.
Dialogue: 0,0:05:04.11,0:05:09.49,Default,,0000,0000,0000,,Гоку Гоку~! →
Dialogue: 0,0:05:09.49,0:05:12.52,Default,,0000,0000,0000,,Гоку! (Каме Эрмит) Гоку!
Dialogue: 0,0:05:12.52,0:05:14.54,Default,,0000,0000,0000,,Сәлем Гоку!
Dialogue: 0,0:05:14.54,0:05:18.58,Default,,0000,0000,0000,,Немерем, сенің өлгеніңді қаламаймын!
Dialogue: 0,0:05:18.58,0:05:22.58,Default,,0000,0000,0000,,Гоку Гоку….
Dialogue: 0,0:05:27.67,0:05:30.70,Default,,0000,0000,0000,,Ах! (Каме Эрмит) жоғалып кетті.
Dialogue: 0,0:05:30.70,0:05:33.73,Default,,0000,0000,0000,,Иә, бұл Құдайдың ісі.
Dialogue: 0,0:05:33.73,0:05:35.75,Default,,0000,0000,0000,,Иә!?
Dialogue: 0,0:05:35.75,0:05:38.78,Default,,0000,0000,0000,,Тек ол осындай нәрсені жасай алады. →
Dialogue: 0,0:05:38.78,0:05:42.82,Default,,0000,0000,0000,,Әлгі бейбақ тағы да бос сөз ойлап отыр.
Dialogue: 0,0:05:42.82,0:05:44.84,Default,,0000,0000,0000,,Сіз не істеуді жоспарлап отырсыз?
Dialogue: 0,0:05:44.84,0:05:48.84,Default,,0000,0000,0000,,Хмм... Бірақ егер бұл Құдай болса, сіз сенімді бола аласыз.
Dialogue: 0,0:05:52.92,0:05:56.96,Default,,0000,0000,0000,,Қалай болғанда да, қалған 6 шарды тез жинап ал→
Dialogue: 0,0:05:56.96,0:05:58.98,Default,,0000,0000,0000,,Біз Гокуды өмірге қайтаруымыз керек.
Dialogue: 0,0:05:58.98,0:06:01.01,Default,,0000,0000,0000,,Қазірдің өзінде! Осындай қиын кезеңде →
Dialogue: 0,0:06:01.01,0:06:04.04,Default,,0000,0000,0000,,Қызық, Ямча кеткенде қайда кетті!
Dialogue: 0,0:06:04.04,0:06:07.41,Default,,0000,0000,0000,,Сен оны қуып жібердің, солай ма?
Dialogue: 0,0:06:07.41,0:06:10.44,Default,,0000,0000,0000,,Бірақ, сол немеренің ағасы →
Dialogue: 0,0:06:10.44,0:06:13.47,Default,,0000,0000,0000,,Менің қайда екенімді соншалықты оңай қайдан білдің?
Dialogue: 0,0:06:13.47,0:06:15.49,Default,,0000,0000,0000,,Бетіне киіп жүр→
Dialogue: 0,0:06:15.49,0:06:17.51,Default,,0000,0000,0000,,Бұл біртүрлі машина. иә?
Dialogue: 0,0:06:17.51,0:06:21.51,Default,,0000,0000,0000,,Қарсыластың күші мен орнын білуге ​​болатын сияқты.
Dialogue: 0,0:06:25.59,0:06:27.61,Default,,0000,0000,0000,,Криллин! Ха, иә! →
Dialogue: 0,0:06:27.61,0:06:29.61,Default,,0000,0000,0000,,Иә Иә Иә.
Dialogue: 0,0:06:34.68,0:06:37.71,Default,,0000,0000,0000,,Міне. Криллин, бір секундқа алыңыз.
Dialogue: 0,0:06:37.71,0:06:40.74,Default,,0000,0000,0000,,Иә!? А... иә.
Dialogue: 0,0:06:40.74,0:06:43.74,Default,,0000,0000,0000,,Ол өмірге қайта оралмайды деп ойлаймын.
Dialogue: 0,0:06:45.79,0:06:47.81,Default,,0000,0000,0000,,Йотто.
Dialogue: 0,0:06:47.81,0:06:50.84,Default,,0000,0000,0000,,Хмм….
Dialogue: 0,0:06:50.84,0:06:52.84,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:06:55.89,0:06:57.91,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:06:57.91,0:07:01.91,Default,,0000,0000,0000,,Міне, осылай шықты...
Dialogue: 0,0:07:03.97,0:07:05.15,Default,,0000,0000,0000,,Бұл таңғажайып механизм!
Dialogue: 0,0:07:05.15,0:07:08.35,Default,,0000,0000,0000,,Бұл біраз тәртіпсіз, бірақ жақсы болады деп ойлаймын.
Dialogue: 0,0:07:08.35,0:07:11.38,Default,,0000,0000,0000,,Бұл керемет, Бұлма-сан.
Dialogue: 0,0:07:11.38,0:07:14.41,Default,,0000,0000,0000,,Осыны үйге апарып, зерттеп, өзгертіңіз.→
Dialogue: 0,0:07:14.41,0:07:16.43,Default,,0000,0000,0000,,Ямча мен Теншинхан және басқалары→
Dialogue: 0,0:07:16.43,0:07:19.46,Default,,0000,0000,0000,,Мүмкін сіз оны таба аласыз.
Dialogue: 0,0:07:19.46,0:07:21.48,Default,,0000,0000,0000,,Қалай болғанда да, әзірге →
Dialogue: 0,0:07:21.48,0:07:23.50,Default,,0000,0000,0000,,Тасбақа үйіне қайтайық?
Dialogue: 0,0:07:23.50,0:07:25.52,Default,,0000,0000,0000,,Бұл жерде біз ештеңе істей алмаймыз.
Dialogue: 0,0:07:25.52,0:07:30.57,Default,,0000,0000,0000,,Содан кейін мен бірден Айдаһар шарларын іздеймін.
Dialogue: 0,0:07:30.57,0:07:33.60,Default,,0000,0000,0000,,Пикколо, сен не істеуді жоспарлап отырсың...?
Dialogue: 0,0:07:33.60,0:07:35.62,Default,,0000,0000,0000,,Ә!?
Dialogue: 0,0:07:35.62,0:07:37.64,Default,,0000,0000,0000,,Жақсы!?
Dialogue: 0,0:07:37.64,0:07:40.67,Default,,0000,0000,0000,,Нунунуну….
Dialogue: 0,0:07:40.67,0:07:44.71,Default,,0000,0000,0000,,Уау…. Апыр-ай….
Dialogue: 0,0:07:44.71,0:07:48.75,Default,,0000,0000,0000,,Нуа~! Эй!
Dialogue: 0,0:07:48.75,0:07:52.79,Default,,0000,0000,0000,,А...
Dialogue: 0,0:07:52.79,0:07:57.84,Default,,0000,0000,0000,,Сәлем…. Ол кесірткенің құйрығына ұқсайды.
Dialogue: 0,0:07:57.84,0:08:00.87,Default,,0000,0000,0000,,Балалар, Айдаһар шарларын іздеңдер.
Dialogue: 0,0:08:00.87,0:08:04.91,Default,,0000,0000,0000,,Тіршілікті қайта тірілтетін құдайдың құдіреті жоқ.
Dialogue: 0,0:08:04.91,0:08:09.29,Default,,0000,0000,0000,,Дегенмен, мен Гокудың ұлына жауапты боламын.
Dialogue: 0,0:08:09.29,0:08:13.33,Default,,0000,0000,0000,,Сіз не істемексіз? Гохан деген бала →
Dialogue: 0,0:08:13.33,0:08:16.36,Default,,0000,0000,0000,,Сіздің жаттығуларыңызға байланысты сіз күшті күшке айналуыңыз керек. →
Dialogue: 0,0:08:16.36,0:08:21.41,Default,,0000,0000,0000,,Бір жылдан кейін келетін екі Сайянға қарсы тұру →
Dialogue: 0,0:08:21.41,0:08:23.41,Default,,0000,0000,0000,,Бұл күш сонда.
Dialogue: 0,0:08:25.45,0:08:28.48,Default,,0000,0000,0000,,Ол үшін өзімді жаттықтырудан басқа амалым жоқ.
Dialogue: 0,0:08:28.48,0:08:31.51,Default,,0000,0000,0000,,Сіз осылай дедіңіз...
Dialogue: 0,0:08:31.51,0:08:35.55,Default,,0000,0000,0000,,Кішкене нашар болды ма деп ойлаймын.
Dialogue: 0,0:08:35.55,0:08:38.58,Default,,0000,0000,0000,,Мм. Мен алдымен Гоку мен оның анасы Чичиден сұрауым керек...
Dialogue: 0,0:08:38.58,0:08:42.62,Default,,0000,0000,0000,,Менің бұған уақытым жоқ! (3 адам) Иә!?
Dialogue: 0,0:08:42.62,0:08:48.68,Default,,0000,0000,0000,,Сылдырды суырып алсаң, оны алу үшін бәріңді өлтіремін!
Dialogue: 0,0:08:48.68,0:08:51.71,Default,,0000,0000,0000,,Хун.
Dialogue: 0,0:08:51.71,0:08:54.74,Default,,0000,0000,0000,,О...
Dialogue: 0,0:08:54.74,0:08:57.74,Default,,0000,0000,0000,,Ах….
Dialogue: 0,0:08:59.79,0:09:04.84,Default,,0000,0000,0000,,Бір жылдан кейін мына баламен сенің үйіңе барамын. →
Dialogue: 0,0:09:04.84,0:09:09.84,Default,,0000,0000,0000,,Ұлы: Гоку өмірге оралғанда, мен оған оны асыға күтуін айтамын.
Dialogue: 0,0:09:11.24,0:09:13.24,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:09:16.29,0:09:18.31,Default,,0000,0000,0000,,Мен білмеймін. Мен білмеймін!
Dialogue: 0,0:09:18.31,0:09:22.31,Default,,0000,0000,0000,,Ол өледі. Сәті түскен күнде де қылмыскер болады.
Dialogue: 0,0:09:24.37,0:09:27.40,Default,,0000,0000,0000,,...Сондықтан мен жаттығым келеді →
Dialogue: 0,0:09:27.40,0:09:30.43,Default,,0000,0000,0000,,Мен мұнда етпен келдім. →
Dialogue: 0,0:09:30.43,0:09:32.45,Default,,0000,0000,0000,,Өтінемін, патша Энма→
Dialogue: 0,0:09:32.45,0:09:37.50,Default,,0000,0000,0000,,Маған Кай патшаға баруға рұқсат етіңіз.
Dialogue: 0,0:09:37.50,0:09:39.52,Default,,0000,0000,0000,,Хмм…. →
Dialogue: 0,0:09:39.52,0:09:44.57,Default,,0000,0000,0000,,Сон Гоку? Сіздің жетістіктеріңіз керемет екені рас.
Dialogue: 0,0:09:44.57,0:09:49.62,Default,,0000,0000,0000,,Аспанға бара алатындар үлкен тәуекелге жылан жолынан өтеді→
Dialogue: 0,0:09:49.62,0:09:52.65,Default,,0000,0000,0000,,Сіз Кай патшаны көресіз бе?
Dialogue: 0,0:09:52.65,0:09:54.67,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:09:54.67,0:09:57.70,Default,,0000,0000,0000,,Әй, бәріміз өлген соң осында келеміз бе?
Dialogue: 0,0:09:57.70,0:09:59.72,Default,,0000,0000,0000,,Иә. Шетелдіктер де?
Dialogue: 0,0:09:59.72,0:10:01.74,Default,,0000,0000,0000,,Хмм. Барлық өлгендер →
Dialogue: 0,0:10:01.74,0:10:05.95,Default,,0000,0000,0000,,Осы кезде жұмаққа немесе тозаққа барасың ба деген үкім шығарылады.
Dialogue: 0,0:10:05.95,0:10:07.14,Default,,0000,0000,0000,,Эй, сәл бұрын →
Dialogue: 0,0:10:07.14,0:10:10.17,Default,,0000,0000,0000,,Радиц келді ме? Иә?
Dialogue: 0,0:10:10.17,0:10:13.20,Default,,0000,0000,0000,,Келіңіздер! — Келдің бе?
Dialogue: 0,0:10:13.20,0:10:18.25,Default,,0000,0000,0000,,А, сен келгеніңе сенімдімін. Ол сенің ағаң еді.
Dialogue: 0,0:10:18.25,0:10:21.28,Default,,0000,0000,0000,,Әрине, ол тозаққа барады.
Dialogue: 0,0:10:21.28,0:10:23.30,Default,,0000,0000,0000,,Ашуланбадың ба?
Dialogue: 0,0:10:23.30,0:10:26.33,Default,,0000,0000,0000,,жабайы болды жабайы болды. Мен жабайы болдым →
Dialogue: 0,0:10:26.33,0:10:29.36,Default,,0000,0000,0000,,Мен оны түсірдім.
Dialogue: 0,0:10:29.36,0:10:33.40,Default,,0000,0000,0000,,Ей, сен мықтысың. Сондай керемет жігіт...
Dialogue: 0,0:10:33.40,0:10:35.42,Default,,0000,0000,0000,,Иә? Хехе.
Dialogue: 0,0:10:35.42,0:10:38.45,Default,,0000,0000,0000,,Әй, бәлкім, мені осы қарт кісі үйретсе керек.
Dialogue: 0,0:10:38.45,0:10:42.49,Default,,0000,0000,0000,,Ши~! Даусыңыз қатты. Лорд Энмаға осындай ауыз ...
Dialogue: 0,0:10:42.49,0:10:44.51,Default,,0000,0000,0000,,Өйткені...
Dialogue: 0,0:10:44.51,0:10:47.54,Default,,0000,0000,0000,,Аузыңды жап, Кай патша күштірек.
Dialogue: 0,0:10:47.54,0:10:51.58,Default,,0000,0000,0000,,Мм... Мен сені естідім, Жердің Құдайы.
Dialogue: 0,0:10:51.58,0:10:53.60,Default,,0000,0000,0000,,Гику!
Dialogue: 0,0:10:53.60,0:10:57.64,Default,,0000,0000,0000,,Өлсең, сені тозаққа жіберетін шығармын.
Dialogue: 0,0:10:57.64,0:11:00.67,Default,,0000,0000,0000,,О, өтінемін, мені кешіріңіз. Құлағыңызға жетеді деп ойламадым...
Dialogue: 0,0:11:00.67,0:11:05.67,Default,,0000,0000,0000,,Тозақтан күткендей! Не деген хаха.
Dialogue: 0,0:11:07.07,0:11:11.11,Default,,0000,0000,0000,,Сізде тоқырау сезімі жоқ.
Dialogue: 0,0:11:11.11,0:11:14.14,Default,,0000,0000,0000,,Жоқ... хахахаха.
Dialogue: 0,0:11:14.14,0:11:19.19,Default,,0000,0000,0000,,Жарайды. Сонша барғың келсе Кай патшаға бару керек.
Dialogue: 0,0:11:19.19,0:11:22.22,Default,,0000,0000,0000,,Иә!? А, рахмет!
Dialogue: 0,0:11:22.22,0:11:26.26,Default,,0000,0000,0000,,Мен гид шақырамын. Онда шығыңыз және күтіңіз.
Dialogue: 0,0:11:26.26,0:11:29.29,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:11:29.29,0:11:31.31,Default,,0000,0000,0000,,Уф… Тағы бір шаршататын күн болды.
Dialogue: 0,0:11:31.31,0:11:35.35,Default,,0000,0000,0000,,Жыланның жолымен құласаң да, мен білмеймін.
Dialogue: 0,0:11:35.35,0:11:38.38,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:38.38,0:11:43.43,Default,,0000,0000,0000,,Олай болса, бар күшіңізді салыңыз. Өйткені биылғы жыл шешуші фактор болып табылады.
Dialogue: 0,0:11:43.43,0:11:46.46,Default,,0000,0000,0000,,Аа, мен не айтып тұрғаныңызды түсінбеймін.→
Dialogue: 0,0:11:46.46,0:11:49.49,Default,,0000,0000,0000,,Қалай болғанда да, Ола, мен Кай патша деген адамды кездестіремін.
Dialogue: 0,0:11:49.49,0:11:51.51,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:11:51.51,0:11:55.55,Default,,0000,0000,0000,,Рахмет. Попо мырзаға да сәлем айтыңыз.
Dialogue: 0,0:11:55.55,0:11:59.59,Default,,0000,0000,0000,,Хе, эй!
Dialogue: 0,0:11:59.59,0:12:03.63,Default,,0000,0000,0000,,《Мм... Әйтеуір, менің жерім →
Dialogue: 0,0:12:03.63,0:12:06.99,Default,,0000,0000,0000,,Кейбір керемет адамдар назарымды аударды. →
Dialogue: 0,0:12:06.99,0:12:11.04,Default,,0000,0000,0000,,Күтілгендей, бұл жолы қауіпті болуы мүмкін.
Dialogue: 0,0:12:11.04,0:12:14.07,Default,,0000,0000,0000,,Шенронның сені өлтіруін қаласаң да →
Dialogue: 0,0:12:14.07,0:12:17.10,Default,,0000,0000,0000,,Сайянның керемет күшін жеңе алмайсың. →
Dialogue: 0,0:12:17.10,0:12:21.14,Default,,0000,0000,0000,,Сон Гокуды Кай патша дайындаған болса да→
Dialogue: 0,0:12:21.14,0:12:24.17,Default,,0000,0000,0000,,Ол қаншаға созылуы мүмкін? →
Dialogue: 0,0:12:24.17,0:12:26.19,Default,,0000,0000,0000,,Жалғыз құтқарушы - Гокудың ұлы. →
Dialogue: 0,0:12:26.19,0:12:31.24,Default,,0000,0000,0000,,Пикколо ұлы Гоханды қалай тәрбиелейді? →
Dialogue: 0,0:12:31.24,0:12:33.26,Default,,0000,0000,0000,,Бірақ осындай шектеулі уақыт ішінде...
Dialogue: 0,0:12:33.26,0:12:35.28,Default,,0000,0000,0000,,Шулы! (Құдай) Ха!
Dialogue: 0,0:12:35.28,0:12:37.30,Default,,0000,0000,0000,,Бұл ыңғайсыздық! Тезірек үйге қайтқыңыз келе ме?
Dialogue: 0,0:12:37.30,0:12:40.33,Default,,0000,0000,0000,,Күрсіну…. →
Dialogue: 0,0:12:40.33,0:12:44.33,Default,,0000,0000,0000,,Кешіріңіз, кешіріңіз... Кешіріңіз, кешіріңіз!
Dialogue: 0,0:12:47.40,0:12:51.44,Default,,0000,0000,0000,,Күткеніңізге рахмет. Енді бұдан былай мен →
Dialogue: 0,0:12:51.44,0:12:55.48,Default,,0000,0000,0000,,Мен сені жыланның басына апарамын. →
Dialogue: 0,0:12:55.48,0:12:57.50,Default,,0000,0000,0000,,Жыланның жолы орамды. →
Dialogue: 0,0:12:57.50,0:13:00.53,Default,,0000,0000,0000,,Қалайсың?
Dialogue: 0,0:13:00.53,0:13:03.56,Default,,0000,0000,0000,,Иә? О, жоқ, ол қайтыс болды →
Dialogue: 0,0:13:03.56,0:13:06.93,Default,,0000,0000,0000,,Менің ойымша, ол өте жақсы емес.
Dialogue: 0,0:13:06.93,0:13:09.96,Default,,0000,0000,0000,,Әй, Кай патша қандай адам?
Dialogue: 0,0:13:09.96,0:13:12.99,Default,,0000,0000,0000,,Иә, Кай патша – бүкіл ғаламның құдайы→
Dialogue: 0,0:13:12.99,0:13:15.02,Default,,0000,0000,0000,,Ол – биікте тұрған адам.
Dialogue: 0,0:13:15.02,0:13:20.02,Default,,0000,0000,0000,,Ху~ Мен күшті болатынына сенімдімін.
Dialogue: 0,0:14:38.51,0:14:40.53,Default,,0000,0000,0000,,күрсіну.
Dialogue: 0,0:14:40.53,0:14:45.58,Default,,0000,0000,0000,,Өйткені Чи-Чи туралы үндемей отыра алмайсың.
Dialogue: 0,0:14:45.58,0:14:49.62,Default,,0000,0000,0000,,Криллин, келіңіз, жағдайды түсіндіріңіз.
Dialogue: 0,0:14:49.62,0:14:53.66,Default,,0000,0000,0000,,Ех! Мен бе?
Dialogue: 0,0:14:53.66,0:14:57.66,Default,,0000,0000,0000,,Мен оның өлтірілетініне сенімдімін, өйткені ол тәрбиеші ана сияқты көрінеді.
Dialogue: 0,0:14:59.72,0:15:03.76,Default,,0000,0000,0000,,
Dialogue: 0,0:15:03.76,0:15:05.78,Default,,0000,0000,0000,,Иә, келдік. Иә?
Dialogue: 0,0:15:05.78,0:15:08.81,Default,,0000,0000,0000,,Жақсы соққы Доккойдың атуы.
Dialogue: 0,0:15:08.81,0:15:10.81,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:13.86,0:15:16.89,Default,,0000,0000,0000,,Сәлем~! Бұл жылан жолы ма?
Dialogue: 0,0:15:16.89,0:15:20.93,Default,,0000,0000,0000,,Иә. Ха... Жарайды.
Dialogue: 0,0:15:20.93,0:15:23.96,Default,,0000,0000,0000,,Енді не істеуіміз керек?
Dialogue: 0,0:15:23.96,0:15:27.00,Default,,0000,0000,0000,,Осы жыланның арасынан өтіп кете бер. →
Dialogue: 0,0:15:27.00,0:15:30.20,Default,,0000,0000,0000,,Кай патшаның орнына апарады.
Dialogue: 0,0:15:30.20,0:15:33.39,Default,,0000,0000,0000,,Бұл ұзақ сияқты.
Dialogue: 0,0:15:33.39,0:15:37.43,Default,,0000,0000,0000,,Иә. Аңыз бойынша ол шамамен 1 млн км.
Dialogue: 0,0:15:37.43,0:15:42.48,Default,,0000,0000,0000,,1 миллион км!? Каа~ Оған біреу жетті ме?
Dialogue: 0,0:15:42.48,0:15:45.51,Default,,0000,0000,0000,,Әрине, соңғы 100 миллион жыл ішінде→
Dialogue: 0,0:15:45.51,0:15:48.54,Default,,0000,0000,0000,,Король Энма Менің ойымша, бір адам болды Иә.
Dialogue: 0,0:15:48.54,0:15:54.60,Default,,0000,0000,0000,,Әлгі қария ма? Ал, келген адам болса →
Dialogue: 0,0:15:54.60,0:15:56.62,Default,,0000,0000,0000,,Бәлкім, менің де ісім жақсы болатын шығар.
Dialogue: 0,0:15:56.62,0:15:58.64,Default,,0000,0000,0000,,Әй, ешқашан бұлтқа түспе→
Dialogue: 0,0:15:58.64,0:16:00.66,Default,,0000,0000,0000,,Сақ болыңыз.
Dialogue: 0,0:16:00.66,0:16:04.70,Default,,0000,0000,0000,,Өйткені, бұл бұлт астындағы тозақ, енді қайтып оралуға болмайды.
Dialogue: 0,0:16:04.70,0:16:06.72,Default,,0000,0000,0000,,А, бұл дұрыс.
Dialogue: 0,0:16:06.72,0:16:10.76,Default,,0000,0000,0000,,Тексеріңіз, ол жоғалды. Мен түскі асымды әкелуім керек еді.
Dialogue: 0,0:16:10.76,0:16:15.81,Default,,0000,0000,0000,,Жарайды, тұтынушы. Сіз әлдеқашан өлдіңіз →
Dialogue: 0,0:16:15.81,0:16:17.83,Default,,0000,0000,0000,,Сен аштан өлесің деп ойламаймын.
Dialogue: 0,0:16:17.83,0:16:19.85,Default,,0000,0000,0000,,А, түсіндім.
Dialogue: 0,0:16:19.85,0:16:21.87,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:16:21.87,0:16:24.90,Default,,0000,0000,0000,,А, дұрыс! Сізден сұрайын дегенім бар.
Dialogue: 0,0:16:24.90,0:16:28.94,Default,,0000,0000,0000,,Иә. Сіз көріпкел Бабаны білесіз бе?
Dialogue: 0,0:16:28.94,0:16:31.31,Default,,0000,0000,0000,,Иә, мен анда-санда келемін.
Dialogue: 0,0:16:31.31,0:16:34.34,Default,,0000,0000,0000,,Мен құтқарылдым. Келесі жолы келсе →
Dialogue: 0,0:16:34.34,0:16:37.37,Default,,0000,0000,0000,,Ола туралы, өтінемін, мені бір жыл өмірге қайтармашы →
Dialogue: 0,0:16:37.37,0:16:41.41,Default,,0000,0000,0000,,Мастер Рошиге айт, айтсын.
Dialogue: 0,0:16:41.41,0:16:48.48,Default,,0000,0000,0000,,Мен ақылдымын. Ал, «Бір жыл...» Мастер Рошиге.
Dialogue: 0,0:16:48.48,0:16:51.51,Default,,0000,0000,0000,,Олай болса, кеттік.
Dialogue: 0,0:16:51.51,0:16:53.53,Default,,0000,0000,0000,,Ащы бұрыш. Пеп пеп.
Dialogue: 0,0:16:53.53,0:16:56.56,Default,,0000,0000,0000,,Басқаша айтқанда, жыланнан құлаудың қажеті жоқ, солай ма?
Dialogue: 0,0:16:56.56,0:16:58.58,Default,,0000,0000,0000,,Иә. Өтінемін...
Dialogue: 0,0:16:58.58,0:17:00.60,Default,,0000,0000,0000,,Би техникасы!
Dialogue: 0,0:17:00.60,0:17:02.60,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:17:08.68,0:17:14.74,Default,,0000,0000,0000,,Ах, Сон Гоку өлтірілді.
Dialogue: 0,0:17:14.74,0:17:16.76,Default,,0000,0000,0000,,Жоғалтқаныңызға өкінеміз.
Dialogue: 0,0:17:16.76,0:17:21.81,Default,,0000,0000,0000,,Хмм, менің ойымша, бұл тым қатты таң қалдырады.
Dialogue: 0,0:17:21.81,0:17:26.86,Default,,0000,0000,0000,,Иә, мен сені аяймын, бірақ Гоку ақыры қайтыс болды →
Dialogue: 0,0:17:26.86,0:17:29.89,Default,,0000,0000,0000,,Тованың ұйқысында. Ууууууууу….
Dialogue: 0,0:17:29.89,0:17:32.25,Default,,0000,0000,0000,,Бірақ ол өмірге қайта оралады.
Dialogue: 0,0:17:32.25,0:17:34.27,Default,,0000,0000,0000,,Аа, дұрыс, жарқын болайық.
Dialogue: 0,0:17:34.27,0:17:37.30,Default,,0000,0000,0000,,Иә, Гоку қайтыс болды→
Dialogue: 0,0:17:37.30,0:17:40.33,Default,,0000,0000,0000,,Уайымдама, тезірек қайта тірілесің. Хахахаха. →
Dialogue: 0,0:17:40.33,0:17:42.35,Default,,0000,0000,0000,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:17:42.35,0:17:47.40,Default,,0000,0000,0000,,Аха, криллин!? Әй... Сәлем.
Dialogue: 0,0:17:47.40,0:17:50.43,Default,,0000,0000,0000,,Сен мұнда не бүлдіріп жатырсың?
Dialogue: 0,0:17:50.43,0:17:54.47,Default,,0000,0000,0000,,Әй, болды... Міне... Бұл жолы, у...
Dialogue: 0,0:17:54.47,0:17:58.51,Default,,0000,0000,0000,,Иә? (Ушимау) Эй! Біраз уақыт өтті.
Dialogue: 0,0:17:58.51,0:18:02.55,Default,,0000,0000,0000,,Сәлем. Қалдарыңыз қалай?
Dialogue: 0,0:18:02.55,0:18:05.58,Default,,0000,0000,0000,,Сіз Гоку Сатачимен бірге емессіз бе?
Dialogue: 0,0:18:05.58,0:18:10.63,Default,,0000,0000,0000,,Жоқ, шынымен Гоку өлді...
Dialogue: 0,0:18:10.63,0:18:14.67,Default,,0000,0000,0000,,Не? Өлді... өлді...
Dialogue: 0,0:18:14.67,0:18:17.70,Default,,0000,0000,0000,,Ан!? Не!?
Dialogue: 0,0:18:17.70,0:18:22.75,Default,,0000,0000,0000,,Шин... Мен саған уайымдама дедім. Хахахаха.
Dialogue: 0,0:18:22.75,0:18:26.79,Default,,0000,0000,0000,,Не, бәрібір кеш бола ма?
Dialogue: 0,0:18:26.79,0:18:30.00,Default,,0000,0000,0000,,Иә, шын мәнінде, Гоку ешқашан оралмайды!
Dialogue: 0,0:18:30.00,0:18:32.18,Default,,0000,0000,0000,,Сіз үйге бармаймын дейсіз бе?
Dialogue: 0,0:18:32.18,0:18:34.20,Default,,0000,0000,0000,,Жоқ, мен жақында қайтамын...
Dialogue: 0,0:18:34.20,0:18:38.24,Default,,0000,0000,0000,,Не айтып тұрғаныңызды түсінбеймін!
Dialogue: 0,0:18:38.24,0:18:40.26,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:18:40.26,0:18:45.31,Default,,0000,0000,0000,,Жарайды, сөйлесетін ештеңе жоқ, үйге қайтайық. Қараңдар, қараңдар.
Dialogue: 0,0:18:45.31,0:18:47.31,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:18:56.42,0:19:02.48,Default,,0000,0000,0000,,Оян, Гоку ұлы.
Dialogue: 0,0:19:02.48,0:19:04.48,Default,,0000,0000,0000,,Цк.
Dialogue: 0,0:19:11.57,0:19:14.60,Default,,0000,0000,0000,,Буха! Гехо Гехо! Уау...
Dialogue: 0,0:19:14.60,0:19:16.62,Default,,0000,0000,0000,,Менің бір оқиғам бар. Судан шығыңыз.
Dialogue: 0,0:19:16.62,0:19:19.65,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:19.65,0:19:22.68,Default,,0000,0000,0000,,Сәлем! Ол кім?
Dialogue: 0,0:19:22.68,0:19:24.70,Default,,0000,0000,0000,,Әке!?
Dialogue: 0,0:19:24.70,0:19:27.73,Default,,0000,0000,0000,,Әке, қайдасыз!
Dialogue: 0,0:19:27.73,0:19:31.11,Default,,0000,0000,0000,,Әке! Әке!
Dialogue: 0,0:19:31.11,0:19:35.15,Default,,0000,0000,0000,,Уау! Әке, мен қорқамын!
Dialogue: 0,0:19:35.15,0:19:39.19,Default,,0000,0000,0000,,Цк, сен некенің баласы.
Dialogue: 0,0:19:39.19,0:19:43.23,Default,,0000,0000,0000,,Мені өзіңе қамқор болуға мәжбүрлеме! Апыр-ай! Апыр-ай! Апыр-ай!
Dialogue: 0,0:19:43.23,0:19:48.28,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:19:48.28,0:19:52.32,Default,,0000,0000,0000,,Айқайламаңыз! Тыныш бол, әйтпесе мойыныңды сындырамын!
Dialogue: 0,0:19:52.32,0:19:57.37,Default,,0000,0000,0000,,Хи хи... Мені мұқият тыңда.
Dialogue: 0,0:19:57.37,0:20:01.41,Default,,0000,0000,0000,,Біріншіден, сенің әкең қайтыс болды.
Dialogue: 0,0:20:01.41,0:20:04.44,Default,,0000,0000,0000,,Иә!? Аздап есіңе түсірген шығарсың.
Dialogue: 0,0:20:04.44,0:20:09.44,Default,,0000,0000,0000,,Мен ол кісіні жеңу үшін өзімді құрбан еттім.
Dialogue: 0,0:20:13.53,0:20:17.57,Default,,0000,0000,0000,,《Пиколо, тездетіп мына амалды орында! 》
Dialogue: 0,0:20:17.57,0:20:21.61,Default,,0000,0000,0000,,《Хаа~! 》
Dialogue: 0,0:20:21.61,0:20:24.64,Default,,0000,0000,0000,,《Уау! 》
Dialogue: 0,0:20:24.64,0:20:27.67,Default,,0000,0000,0000,,《Орындаңыз~! 》
Dialogue: 0,0:20:27.67,0:20:31.04,Default,,0000,0000,0000,,《Же бер! Жынның жеңіл өлтіретін мылтығы! 》
Dialogue: 0,0:20:31.04,0:20:33.06,Default,,0000,0000,0000,,《Көкек...》
Dialogue: 0,0:20:33.06,0:20:35.06,Default,,0000,0000,0000,,《Уау! 》
Dialogue: 0,0:20:39.12,0:20:42.15,Default,,0000,0000,0000,,《Аа! 》
Dialogue: 0,0:20:42.15,0:20:44.15,Default,,0000,0000,0000,,《Уау! 》
Dialogue: 0,0:20:46.19,0:20:48.21,Default,,0000,0000,0000,,Әй, әкем...
Dialogue: 0,0:20:48.21,0:20:52.25,Default,,0000,0000,0000,,Ой, жылама. Бұл сіздің мойыныңызды шынымен сындырады!
Dialogue: 0,0:20:52.25,0:20:55.28,Default,,0000,0000,0000,,Ықылық....
Dialogue: 0,0:20:55.28,0:20:57.30,Default,,0000,0000,0000,,Хун.
Dialogue: 0,0:20:57.30,0:21:01.34,Default,,0000,0000,0000,,Сіз әкеңізден Айдаһар туралы сұрадыңыз ба?
Dialogue: 0,0:21:01.34,0:21:05.38,Default,,0000,0000,0000,,Гоку достары оларды жинап, өмірге қайтара алуы керек. →
Dialogue: 0,0:21:05.38,0:21:08.41,Default,,0000,0000,0000,,Бірақ мәселе бұл емес. →
Dialogue: 0,0:21:08.41,0:21:11.44,Default,,0000,0000,0000,,Мен сені ұрлаған адамнан құтылдым, бірақ →
Dialogue: 0,0:21:11.44,0:21:14.47,Default,,0000,0000,0000,,Бір жылдан кейін одан да қорқынышты досы→
Dialogue: 0,0:21:14.47,0:21:16.49,Default,,0000,0000,0000,,Келе жатқан сияқты.
Dialogue: 0,0:21:16.49,0:21:19.52,Default,,0000,0000,0000,,Егер бұл орын алса, Сон Гоку өмірге оралғанда →
Dialogue: 0,0:21:19.52,0:21:22.55,Default,,0000,0000,0000,,Тек мен және ол болса, жеңу мүмкіндігі жоқ.
Dialogue: 0,0:21:22.55,0:21:25.58,Default,,0000,0000,0000,,Маған сенің көмегің керек.
Dialogue: 0,0:21:25.58,0:21:28.61,Default,,0000,0000,0000,,Жаттығу арқылы тактиканы үйреніңіз және осы жерді қорғаңыз!
Dialogue: 0,0:21:28.61,0:21:30.79,Default,,0000,0000,0000,,Не, мен!?
Dialogue: 0,0:21:30.79,0:21:34.00,Default,,0000,0000,0000,,Бұл...Мен мүлде төбелесе алмаймын.
Dialogue: 0,0:21:34.00,0:21:37.03,Default,,0000,0000,0000,,Өзім байқамаған сияқтымын→
Dialogue: 0,0:21:37.03,0:21:40.06,Default,,0000,0000,0000,,Сіздің жасырын күшіңіз айтарлықтай.
Dialogue: 0,0:21:40.06,0:21:43.09,Default,,0000,0000,0000,,Сондықтан бұл күшті жаттығу арқылы шығарыңыз →
Dialogue: 0,0:21:43.09,0:21:45.11,Default,,0000,0000,0000,,Оны тиімді ету.
Dialogue: 0,0:21:45.11,0:21:48.14,Default,,0000,0000,0000,,Бұл өтірік. Менде ондай күш жоқ.
Dialogue: 0,0:21:48.14,0:21:51.17,Default,,0000,0000,0000,,Хмф! Дәлелдерді көргіңіз келе ме?
Dialogue: 0,0:21:51.17,0:21:54.20,Default,,0000,0000,0000,,Не? Ой, не істеп жатырсың!?
Dialogue: 0,0:21:54.20,0:21:58.24,Default,,0000,0000,0000,,Уау~ Ауырды! Ол аурады! Тоқта, ол ауырады!
Dialogue: 0,0:21:58.24,0:22:03.29,Default,,0000,0000,0000,,Ува, тоқтат! Ол аурады! Ол аурады! Ол аурады!
Dialogue: 0,0:22:03.29,0:22:05.31,Default,,0000,0000,0000,,Ажырасудың жоспары болуы керек емес пе деп ойламайсың ба?
Dialogue: 0,0:22:05.31,0:22:07.33,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:22:07.33,0:22:10.36,Default,,0000,0000,0000,,《Енді маған жасырын күшіңді көрсет》
Dialogue: 0,0:22:10.36,0:22:12.38,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:22:12.38,0:22:15.41,Default,,0000,0000,0000,,Coo.
Dialogue: 0,0:22:15.41,0:22:17.41,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:22:20.46,0:22:23.49,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:22:23.49,0:22:25.49,Default,,0000,0000,0000,,Гува.
Dialogue: 0,0:22:27.53,0:22:29.53,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:22:34.93,0:22:36.93,Default,,0000,0000,0000,,Әй, бұл!
Dialogue: 0,0:22:43.02,0:22:48.07,Default,,0000,0000,0000,,《Ой, таң қалдым... Бұл жігіт мен күткеннен де асып түсті》
Dialogue: 0,0:22:48.07,0:22:51.07,Default,,0000,0000,0000,,Ах….
Dialogue: 0,0:22:54.13,0:22:56.15,Default,,0000,0000,0000,,《Менде аралас сезім бар. →
Dialogue: 0,0:22:56.15,0:23:00.19,Default,,0000,0000,0000,,Мен болашақта менің ең қорқынышты жауыма айналатын нәрсемен бетпе-бет келемін→
Dialogue: 0,0:23:00.19,0:23:02.21,Default,,0000,0000,0000,,Өсуге тырысу》
Dialogue: 0,0:23:02.21,0:23:06.25,Default,,0000,0000,0000,,Эй, мен мұны істедім бе?
Dialogue: 0,0:23:06.25,0:23:09.28,Default,,0000,0000,0000,,Иә. Сіз бір нәрсені түсінген сияқтысыз.
Dialogue: 0,0:23:09.28,0:23:13.32,Default,,0000,0000,0000,,Сіз мұны эмоцияларыңыз шынымен жоғары болғанда ғана жасайсыз→
Dialogue: 0,0:23:13.32,0:23:15.34,Default,,0000,0000,0000,,Өзіңіздің бастапқы жасырын күшіңізді көрсетіңіз.
Dialogue: 0,0:23:15.34,0:23:18.37,Default,,0000,0000,0000,,Бірақ бұл бір сәтке ғана.
Dialogue: 0,0:23:18.37,0:23:20.39,Default,,0000,0000,0000,,Сонда сіз жеңе алмайсыз. →
Dialogue: 0,0:23:20.39,0:23:24.43,Default,,0000,0000,0000,,Мен саған қалай соғысу керектігін үйретемін және сені ең күшті жауынгер етемін. →
Dialogue: 0,0:23:24.43,0:23:26.45,Default,,0000,0000,0000,,Менікі де емес—
Dialogue: 0,0:23:26.45,0:23:30.66,Default,,0000,0000,0000,,Бірақ мен жекпе-жек шебері болғым келмейді.
Dialogue: 0,0:23:30.66,0:23:33.86,Default,,0000,0000,0000,,Мен үлкен ғұлама болғым келеді.
Dialogue: 0,0:23:33.86,0:23:35.88,Default,,0000,0000,0000,,Хун. Болғаны жақсы.
Dialogue: 0,0:23:35.88,0:23:40.93,Default,,0000,0000,0000,,Алайда бір жылдан кейін келетін екі Сайянды жеңгеннен кейін ғана.
Dialogue: 0,0:23:40.93,0:23:43.96,Default,,0000,0000,0000,,Олар жердегілерді жоюға ниетті.
Dialogue: 0,0:23:43.96,0:23:45.98,Default,,0000,0000,0000,,Егер бұл орын алса, болашақ болмайды.
Dialogue: 0,0:23:45.98,0:23:48.01,Default,,0000,0000,0000,,Себебі мен қорқамын.
Dialogue: 0,0:23:48.01,0:23:51.04,Default,,0000,0000,0000,,Сылдырды қалдырмаңыз! Дәл қазір өлтіргің келе ме!?
Dialogue: 0,0:23:51.04,0:23:55.08,Default,,0000,0000,0000,,Сәлем! Менің уақытым жоқ, сондықтан бірден бастайық.
Dialogue: 0,0:23:55.08,0:23:57.10,Default,,0000,0000,0000,,Курткаңызды тез шешіңіз!
Dialogue: 0,0:23:57.10,0:24:00.13,Default,,0000,0000,0000,,Гусун….
Dialogue: 0,0:24:00.13,0:24:06.19,Default,,0000,0000,0000,,Әкем тірілетін болса, маған айтсын.
Dialogue: 0,0:24:06.19,0:24:10.23,Default,,0000,0000,0000,,Хмф, бұл ұят. Оның мықты екені сөзсіз→
Dialogue: 0,0:24:10.23,0:24:13.26,Default,,0000,0000,0000,,Маған мүлде шебер болуға жарамайды.
Dialogue: 0,0:24:13.26,0:24:16.29,Default,,0000,0000,0000,,Адамдарға мүлдем қатал емес.
Dialogue: 0,0:24:16.29,0:24:19.32,Default,,0000,0000,0000,,Саған қарасам, қаншалықты бұзылғаныңды анық көремін.
Dialogue: 0,0:24:19.32,0:24:22.35,Default,,0000,0000,0000,,Хекшун! иә?
Dialogue: 0,0:24:22.35,0:24:26.39,Default,,0000,0000,0000,,Иә? Уау... уау.
Dialogue: 0,0:24:26.39,0:24:28.41,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:24:28.41,0:24:33.46,Default,,0000,0000,0000,,Ол кетті~ Мен тым көп физикалық күш жұмсадым және енді ұша алмаймын.
Dialogue: 0,0:24:33.46,0:24:36.49,Default,,0000,0000,0000,,<Баламның мұңын ешқашан білмеймін→
Dialogue: 0,0:24:36.49,0:24:43.49,Default,,0000,0000,0000,,Гоку Кай патшаны табу үшін ұзақ сапарға шықты.
Dialogue: 0,0:24:46.59,0:24:51.64,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:51.64,0:25:11.84,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:11.84,0:25:31.37,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:31.37,0:25:44.37,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:48.54,0:25:51.57,Default,,0000,0000,0000,,Сәлем, Гоку. Гохан, бұл күндері не болып жатыр деп ойлаймын.
Dialogue: 0,0:25:51.57,0:25:54.60,Default,,0000,0000,0000,,Мен сені сағындым, әке.
Dialogue: 0,0:25:54.60,0:25:58.64,Default,,0000,0000,0000,,Иә? Бұл толық ай. Мен оны бірінші рет көрдім.
Dialogue: 0,0:25:58.64,0:26:02.68,Default,,0000,0000,0000,,Не?! Сон Гокудың ұлы өсіп келеді. →
Dialogue: 0,0:26:02.68,0:26:04.70,Default,,0000,0000,0000,,Сайяндардың шын күші осы ма?
Dialogue: 0,0:26:04.70,0:26:06.72,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»
Dialogue: 0,0:26:06.72,0:26:09.75,Default,,0000,0000,0000,,«Шөл далада аман қалу: айлы түн Гоханды оятады».
Dialogue: 0,0:26:09.75,0:26:13.75,Default,,0000,0000,0000,,Мен үлкен ғұлама бола аламын ба деп ойлаймын.
Dialogue: 0,0:26:15.25,0:26:21.25,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory