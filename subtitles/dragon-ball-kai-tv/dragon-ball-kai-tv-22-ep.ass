Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.74,0:00:14.76,Default,,0000,0000,0000,,<Фризаның бандасымен күрес→
Dialogue: 0,0:00:14.76,0:00:19.81,Default,,0000,0000,0000,,Намекиялық жас жауынгерлердің күресі. →
Dialogue: 0,0:00:19.81,0:00:24.86,Default,,0000,0000,0000,,Ойы ұшқыр ауыл ақсақалы банданың барлаушысын жояды. →
Dialogue: 0,0:00:24.86,0:00:29.91,Default,,0000,0000,0000,,Алайда бұл жаңа дағдарысқа әкелді>
Dialogue: 0,0:00:29.91,0:00:33.95,Default,,0000,0000,0000,,Уау~ Олардың бәрін өлтіріңіз~!
Dialogue: 0,0:00:33.95,0:00:35.95,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:00:37.99,0:00:42.04,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:42.04,0:01:02.24,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:02.24,0:01:22.77,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:22.77,0:01:42.97,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:42.97,0:01:59.97,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:21.56,0:04:24.59,Default,,0000,0000,0000,,Уу~ Дея~! (Жауынгерлер) А...
Dialogue: 0,0:04:24.59,0:04:26.61,Default,,0000,0000,0000,,Ах! Ах!
Dialogue: 0,0:04:26.61,0:04:30.65,Default,,0000,0000,0000,,Ақсақал! (Фриза) Додориа мырза, күте тұрыңыз. →
Dialogue: 0,0:04:30.65,0:04:33.68,Default,,0000,0000,0000,,Алдымен үш жасты өлтіріңіз.
Dialogue: 0,0:04:33.68,0:04:37.68,Default,,0000,0000,0000,,Гуу... Тәтті~!
Dialogue: 0,0:04:39.74,0:04:42.77,Default,,0000,0000,0000,,Ууууу….
Dialogue: 0,0:04:42.77,0:04:45.80,Default,,0000,0000,0000,,Хехехехехе. →
Dialogue: 0,0:04:45.80,0:04:48.83,Default,,0000,0000,0000,,Үшеуіміз 10 секундта тазалауымыз керек.
Dialogue: 0,0:04:48.83,0:04:52.87,Default,,0000,0000,0000,,Ақымақ нәрсе жасаңыз. Үшеумізге тең келем деп ойлайсың ба!?
Dialogue: 0,0:04:52.87,0:04:55.90,Default,,0000,0000,0000,,Иә? Мен оны жүзеге асыра аламын деп ойлайсыз ба?
Dialogue: 0,0:04:55.90,0:04:57.92,Default,,0000,0000,0000,,Бұл күлкілі әзіл.
Dialogue: 0,0:04:57.92,0:05:00.95,Default,,0000,0000,0000,,Қарғыс атсын... не!?
Dialogue: 0,0:05:00.95,0:05:02.95,Default,,0000,0000,0000,,Гуо!
Dialogue: 0,0:05:04.99,0:05:06.01,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:05:06.01,0:05:09.04,Default,,0000,0000,0000,,Тея! (Жауынгер) Уау!
Dialogue: 0,0:05:09.04,0:05:12.40,Default,,0000,0000,0000,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:05:12.40,0:05:14.42,Default,,0000,0000,0000,,Уау! Ха!
Dialogue: 0,0:05:14.42,0:05:16.42,Default,,0000,0000,0000,,Тея!
Dialogue: 0,0:05:19.47,0:05:21.49,Default,,0000,0000,0000,,Дрия!
Dialogue: 0,0:05:21.49,0:05:24.52,Default,,0000,0000,0000,,О!?
Dialogue: 0,0:05:24.52,0:05:26.54,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:05:26.54,0:05:28.56,Default,,0000,0000,0000,,Сагири тауының шыңында ауа тіпті де жұқа еді!
Dialogue: 0,0:05:28.56,0:05:31.59,Default,,0000,0000,0000,,Гухахаха. (Жауынгер) Не!?
Dialogue: 0,0:05:31.59,0:05:34.62,Default,,0000,0000,0000,,Жоқ. Сіз оны мұндай шабуылдармен жеңе алмайсыз.
Dialogue: 0,0:05:34.62,0:05:38.66,Default,,0000,0000,0000,,Guhahaha… Uuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuuu!
Dialogue: 0,0:05:38.66,0:05:41.69,Default,,0000,0000,0000,,Гува! Ааа...
Dialogue: 0,0:05:41.69,0:05:43.69,Default,,0000,0000,0000,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:05:48.76,0:05:51.79,Default,,0000,0000,0000,,Эхехе.
Dialogue: 0,0:05:51.79,0:05:54.82,Default,,0000,0000,0000,,Хо хо хо. Енді оған қарсы шығуға болады →
Dialogue: 0,0:05:54.82,0:05:56.84,Default,,0000,0000,0000,,Қашуға тырысқаннан пайда жоқ →
Dialogue: 0,0:05:56.84,0:05:59.87,Default,,0000,0000,0000,,Сіз түсінесіз. →
Dialogue: 0,0:05:59.87,0:06:01.89,Default,,0000,0000,0000,,Түсіңіз.
Dialogue: 0,0:06:01.89,0:06:04.92,Default,,0000,0000,0000,,Куу….
Dialogue: 0,0:06:04.92,0:06:09.97,Default,,0000,0000,0000,,Сіз адал болдыңыз. Жарайды.
Dialogue: 0,0:06:09.97,0:06:13.34,Default,,0000,0000,0000,,Сіз қымбат скаутеріңізді сындырдыңыз.
Dialogue: 0,0:06:13.34,0:06:17.38,Default,,0000,0000,0000,,Кешірім ретінде маған Айдаһар шарын бере аласыз ба?
Dialogue: 0,0:06:17.38,0:06:19.40,Default,,0000,0000,0000,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:06:19.40,0:06:23.44,Default,,0000,0000,0000,,Ууууу…. Сөзсіз.
Dialogue: 0,0:06:23.44,0:06:28.49,Default,,0000,0000,0000,,Бірақ маған уәде бер. Балаларға ешқашан тиіспеңіз.
Dialogue: 0,0:06:28.49,0:06:31.52,Default,,0000,0000,0000,,Мм. (Ақсақал) Кууууууу...
Dialogue: 0,0:06:31.52,0:06:34.55,Default,,0000,0000,0000,,Басынан солай істегендері жақсы болар еді.
Dialogue: 0,0:06:34.55,0:06:37.58,Default,,0000,0000,0000,,Гууууу... Олар!
Dialogue: 0,0:06:37.58,0:06:42.63,Default,,0000,0000,0000,,Эй, эй, Гохан, мені біртүрлі сезінбе. →
Dialogue: 0,0:06:42.63,0:06:45.66,Default,,0000,0000,0000,,Шынымен емес, бірақ ол маған сәйкес емес.
Dialogue: 0,0:06:45.66,0:06:47.66,Default,,0000,0000,0000,,Куу~!
Dialogue: 0,0:06:51.72,0:06:54.75,Default,,0000,0000,0000,,Енді мынаны алып, тез кет.
Dialogue: 0,0:06:54.75,0:06:56.75,Default,,0000,0000,0000,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:06:58.79,0:07:01.82,Default,,0000,0000,0000,,Сондай-ақ, тағы екі Dragon Ball орны бар →
Dialogue: 0,0:07:01.82,0:07:04.85,Default,,0000,0000,0000,,Маған айтып бере аласыз ба?
Dialogue: 0,0:07:04.85,0:07:06.87,Default,,0000,0000,0000,,Өзіңізді мазақ етпеңіз. Біз намекиялықтар →
Dialogue: 0,0:07:06.87,0:07:12.26,Default,,0000,0000,0000,,Достарыңды сатқың келсе мен өлмеймін!
Dialogue: 0,0:07:12.26,0:07:16.30,Default,,0000,0000,0000,,Енді мен саған уәде беремін, тезірек кет.
Dialogue: 0,0:07:16.30,0:07:19.33,Default,,0000,0000,0000,,Эй, сен де?
Dialogue: 0,0:07:19.33,0:07:24.38,Default,,0000,0000,0000,,Бұл планетада ешкім ешқашан достары туралы айтпайды.
Dialogue: 0,0:07:24.38,0:07:27.41,Default,,0000,0000,0000,,Өйткені, сіз және сіздің балаңыз→
Dialogue: 0,0:07:27.41,0:07:30.44,Default,,0000,0000,0000,,Маған өлуге рұқсат етіңіз. (Ақсақал) Не!?
Dialogue: 0,0:07:30.44,0:07:32.46,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:07:32.46,0:07:34.48,Default,,0000,0000,0000,,Гваа!
Dialogue: 0,0:07:34.48,0:07:37.51,Default,,0000,0000,0000,,Ах…. (Ақсақал) Уәде басқа.
Dialogue: 0,0:07:37.51,0:07:40.54,Default,,0000,0000,0000,,«Егер сен маған Айдаһар допты берсең, мен басқа ештеңе істемеймін».
Dialogue: 0,0:07:40.54,0:07:43.57,Default,,0000,0000,0000,,Бірақ сізде 7 Айдаһар шары болмаса →
Dialogue: 0,0:07:43.57,0:07:45.59,Default,,0000,0000,0000,,Оның мағынасы жоқ, солай ма? →
Dialogue: 0,0:07:45.59,0:07:47.61,Default,,0000,0000,0000,,Сіз біздің барлаушымызсыз →
Dialogue: 0,0:07:47.61,0:07:49.63,Default,,0000,0000,0000,,Себебі мен бұздым →
Dialogue: 0,0:07:49.63,0:07:53.67,Default,,0000,0000,0000,,Мен қалған екеуінің орнын білуім керек.
Dialogue: 0,0:07:53.67,0:07:57.71,Default,,0000,0000,0000,,Ол: ''Мен өлсем де, достарым туралы ештеңе айта алмаймын'' деген болуы керек.
Dialogue: 0,0:07:57.71,0:08:00.74,Default,,0000,0000,0000,,Хехехе. Сіз шынымен өлгіңіз келе ме?
Dialogue: 0,0:08:00.74,0:08:04.78,Default,,0000,0000,0000,,Содан кейін өз қалауыңыз бойынша жасаңыз. (Ақсақал) Не!?
Dialogue: 0,0:08:04.78,0:08:07.81,Default,,0000,0000,0000,,Үшеуін де өлтір.
Dialogue: 0,0:08:07.81,0:08:10.84,Default,,0000,0000,0000,,Хаа…. Ол лас.
Dialogue: 0,0:08:10.84,0:08:13.21,Default,,0000,0000,0000,,Балалар жүгіріңдер! Жүгіріп кету.
Dialogue: 0,0:08:13.21,0:08:16.24,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:08:16.24,0:08:19.27,Default,,0000,0000,0000,,Намекеліктердің мақтанышын көрсет!
Dialogue: 0,0:08:19.27,0:08:22.30,Default,,0000,0000,0000,,Дея! Ха!
Dialogue: 0,0:08:22.30,0:08:24.32,Default,,0000,0000,0000,,Уау! (Ақсақал) Ах!
Dialogue: 0,0:08:24.32,0:08:28.36,Default,,0000,0000,0000,,Ах! Ааааа...
Dialogue: 0,0:08:28.36,0:08:30.38,Default,,0000,0000,0000,,Какарго….
Dialogue: 0,0:08:30.38,0:08:32.40,Default,,0000,0000,0000,,Уггугугу….
Dialogue: 0,0:08:32.40,0:08:36.44,Default,,0000,0000,0000,,Ұста, Гохан. Жігіт~!
Dialogue: 0,0:08:36.44,0:08:40.48,Default,,0000,0000,0000,,Ұстаңыз! Біздің қолымыздан ештеңе келмейді.
Dialogue: 0,0:08:40.48,0:08:45.53,Default,,0000,0000,0000,,Жүк... Жүк! Жүк!
Dialogue: 0,0:08:45.53,0:08:48.56,Default,,0000,0000,0000,,Дехехе.
Dialogue: 0,0:08:48.56,0:08:50.56,Default,,0000,0000,0000,,Урья!
Dialogue: 0,0:08:54.62,0:08:56.62,Default,,0000,0000,0000,,Тея!
Dialogue: 0,0:09:03.71,0:09:05.73,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:09:05.73,0:09:07.75,Default,,0000,0000,0000,,Кух…. Жақсы…
Dialogue: 0,0:09:07.75,0:09:09.77,Default,,0000,0000,0000,,Е...
Dialogue: 0,0:09:09.77,0:09:12.13,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:09:12.13,0:09:14.15,Default,,0000,0000,0000,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:09:14.15,0:09:18.19,Default,,0000,0000,0000,,Фухахаха мен мақтанышымды көрсетуге де үлгермедім.
Dialogue: 0,0:09:18.19,0:09:21.22,Default,,0000,0000,0000,,Ааааааааааааааааааа!
Dialogue: 0,0:09:21.22,0:09:23.24,Default,,0000,0000,0000,,Дехе….
Dialogue: 0,0:09:23.24,0:09:26.27,Default,,0000,0000,0000,,Жігіт~!
Dialogue: 0,0:09:26.27,0:09:28.29,Default,,0000,0000,0000,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:09:28.29,0:09:33.34,Default,,0000,0000,0000,,Хахаха... Ахахаха!
Dialogue: 0,0:09:33.34,0:09:36.37,Default,,0000,0000,0000,,Баланы бұлай басу қызық емес.
Dialogue: 0,0:09:36.37,0:09:38.39,Default,,0000,0000,0000,,Гү!
Dialogue: 0,0:09:38.39,0:09:41.42,Default,,0000,0000,0000,,Жарайды, өл!
Dialogue: 0,0:09:41.42,0:09:45.42,Default,,0000,0000,0000,,Уау! Тоқта.
Dialogue: 0,0:09:47.48,0:09:50.51,Default,,0000,0000,0000,,Не? Сіз доссыз ба?
Dialogue: 0,0:09:50.51,0:09:52.53,Default,,0000,0000,0000,,Ол қайда?
Dialogue: 0,0:09:52.53,0:09:54.55,Default,,0000,0000,0000,,Толя!
Dialogue: 0,0:09:54.55,0:09:56.57,Default,,0000,0000,0000,,Хе...
Dialogue: 0,0:09:56.57,0:09:58.59,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:09:58.59,0:10:00.61,Default,,0000,0000,0000,,Хехе, сен білесің бе?
Dialogue: 0,0:10:00.61,0:10:02.61,Default,,0000,0000,0000,,Уф гуу….
Dialogue: 0,0:10:04.65,0:10:07.68,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:10:07.68,0:10:09.70,Default,,0000,0000,0000,,Әлгі ақымақ.
Dialogue: 0,0:10:09.70,0:10:13.07,Default,,0000,0000,0000,,Мен саған қамқор боламын!
Dialogue: 0,0:10:13.07,0:10:16.10,Default,,0000,0000,0000,,Не!? Дея!
Dialogue: 0,0:10:16.10,0:10:18.12,Default,,0000,0000,0000,,Уф... Криллин мырза.
Dialogue: 0,0:10:18.12,0:10:20.14,Default,,0000,0000,0000,,Ааа…. Бака бака яру!
Dialogue: 0,0:10:20.14,0:10:23.17,Default,,0000,0000,0000,,Ни, қаш, тез! иә?
Dialogue: 0,0:10:23.17,0:10:27.21,Default,,0000,0000,0000,,Асығыңыз! иә.
Dialogue: 0,0:10:27.21,0:10:30.24,Default,,0000,0000,0000,,Ух... tsk tsk шоуы.
Dialogue: 0,0:10:30.24,0:10:34.28,Default,,0000,0000,0000,,Мен сені қуамын~ Додориа-сан, мені ұста.
Dialogue: 0,0:10:34.28,0:10:37.31,Default,,0000,0000,0000,,Гохан, мүмкіндігінше ұш. Егер сіз ұсталсаңыз, бұл ақыры.
Dialogue: 0,0:10:37.31,0:10:40.34,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:10:40.34,0:10:42.36,Default,,0000,0000,0000,,Дея~!
Dialogue: 0,0:10:42.36,0:10:46.36,Default,,0000,0000,0000,,Ақымақ, қашып құтыла аламын деп ойлайсың ба!?
Dialogue: 0,0:10:51.45,0:10:55.45,Default,,0000,0000,0000,,Жоқ, ол жылдамырақ. Мен жетемін!
Dialogue: 0,0:10:58.52,0:11:00.54,Default,,0000,0000,0000,,Ах! Таа~!
Dialogue: 0,0:11:00.54,0:11:02.54,Default,,0000,0000,0000,,Гохан!
Dialogue: 0,0:11:04.58,0:11:07.58,Default,,0000,0000,0000,,Таа~! Таа~! Таа~!
Dialogue: 0,0:11:09.63,0:11:12.99,Default,,0000,0000,0000,,Уау! Аа….
Dialogue: 0,0:11:12.99,0:11:15.02,Default,,0000,0000,0000,,Жоқ! Ах~!
Dialogue: 0,0:11:15.02,0:11:17.04,Default,,0000,0000,0000,,Қарғыс атсын.
Dialogue: 0,0:11:17.04,0:11:20.07,Default,,0000,0000,0000,,А... Мен уақытында үлгере алмаймын.
Dialogue: 0,0:11:20.07,0:11:22.09,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:11:22.09,0:11:28.15,Default,,0000,0000,0000,,Фу... Гохан, тез қаш! Ол келе жатыр!! Ах!
Dialogue: 0,0:11:28.15,0:11:31.18,Default,,0000,0000,0000,,Хаа~! Апыр-ай!
Dialogue: 0,0:11:31.18,0:11:33.20,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:11:33.20,0:11:37.24,Default,,0000,0000,0000,,Қарғыс атсын, олар сәл епті екен.
Dialogue: 0,0:11:37.24,0:11:41.28,Default,,0000,0000,0000,,Ах, Криллин-сан, төмен түсіп, ұрысайық.
Dialogue: 0,0:11:41.28,0:11:44.31,Default,,0000,0000,0000,,Жоқ. Ол сіз күресетін адам емес.
Dialogue: 0,0:11:44.31,0:11:49.36,Default,,0000,0000,0000,,Барынша ұшыңыз.
Dialogue: 0,0:11:49.36,0:11:51.38,Default,,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,0:11:51.38,0:11:54.41,Default,,0000,0000,0000,,Гохан, енді маған қарама. Көзіңді жаб.
Dialogue: 0,0:11:54.41,0:11:58.45,Default,,0000,0000,0000,,Менің бір ойым бар. Түсіндіңіз бе? иә.
Dialogue: 0,0:11:58.45,0:12:02.49,Default,,0000,0000,0000,,Иә? Мынаны да же.
Dialogue: 0,0:12:02.49,0:12:04.51,Default,,0000,0000,0000,,Күн жұдырығы!
Dialogue: 0,0:12:04.51,0:12:07.54,Default,,0000,0000,0000,,Уау! →
Dialogue: 0,0:12:07.54,0:12:12.93,Default,,0000,0000,0000,,Әй, көздер! Менің көзім! Көздер... Уау!
Dialogue: 0,0:12:12.93,0:12:15.96,Default,,0000,0000,0000,,Иә! Жақсы өтті.
Dialogue: 0,0:12:15.96,0:12:18.99,Default,,0000,0000,0000,,Гохан, қазір жасырын.
Dialogue: 0,0:12:18.99,0:12:20.99,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:13:37.78,0:13:40.81,Default,,0000,0000,0000,,Чикушо қайда кетті?
Dialogue: 0,0:13:40.81,0:13:42.81,Default,,0000,0000,0000,,Қарғыс атсын.
Dialogue: 0,0:13:50.91,0:13:53.94,Default,,0000,0000,0000,,Жарайды, сені ешқашан таппайсың.
Dialogue: 0,0:13:53.94,0:13:55.96,Default,,0000,0000,0000,,Анау қарт барлаушы деп атаған →
Dialogue: 0,0:13:55.96,0:13:58.99,Default,,0000,0000,0000,,Сіз оны бұзу арқылы маған шынымен көмектестіңіз.
Dialogue: 0,0:13:58.99,0:14:00.01,Default,,0000,0000,0000,,Егер бұл бар болса, тіпті сол кішкентай жігіттің ойы да → болар еді
Dialogue: 0,0:14:00.01,0:14:02.01,Default,,0000,0000,0000,,Олар оны табады.
Dialogue: 0,0:14:05.06,0:14:09.10,Default,,0000,0000,0000,,Боқ~ осындай егжей-тегжейлі адамдарды таба аласыз ба! →
Dialogue: 0,0:14:09.10,0:14:12.10,Default,,0000,0000,0000,,Менің басым осында!!
Dialogue: 0,0:14:14.15,0:14:18.15,Default,,0000,0000,0000,,Жақсы, мен бас тарттым және үйге барамын. Иә?
Dialogue: 0,0:14:23.24,0:14:25.26,Default,,0000,0000,0000,,Иә! Мен оны ұшырып жіберемін.
Dialogue: 0,0:14:25.26,0:14:27.28,Default,,0000,0000,0000,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:14:27.28,0:14:29.46,Default,,0000,0000,0000,,Дея~! Ах!
Dialogue: 0,0:14:29.46,0:14:32.66,Default,,0000,0000,0000,,Мен саған мені көріп тұрсың ба деп сұрап тұрмын, Джотаро
Dialogue: 0,0:14:32.66,0:14:34.66,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:14:38.72,0:14:40.72,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:14:48.82,0:14:53.87,Default,,0000,0000,0000,,Қараңыз. Бұл сіздің қарапайым болғаныңыздың себебі болып табылады.
Dialogue: 0,0:14:53.87,0:14:57.91,Default,,0000,0000,0000,,Хахаха... Ахахаха!
Dialogue: 0,0:14:57.91,0:15:00.94,Default,,0000,0000,0000,,Фриеза-сама оны өзіммен бірге алып кел деді, бірақ→
Dialogue: 0,0:15:00.94,0:15:02.96,Default,,0000,0000,0000,,Жарайды, оның қашып кетуіне жол бергеннен гөрі жақсы.
Dialogue: 0,0:15:02.96,0:15:06.00,Default,,0000,0000,0000,,Бірақ бұл балалар ақыры өздерінің кім екенін білмеді. →
Dialogue: 0,0:15:06.00,0:15:09.03,Default,,0000,0000,0000,,Бұл қарапайым адам емес еді.
Dialogue: 0,0:15:09.03,0:15:12.03,Default,,0000,0000,0000,,Енді бұл маңызды емес.
Dialogue: 0,0:15:15.09,0:15:19.13,Default,,0000,0000,0000,,Мен құтқарылдым. аа.
Dialogue: 0,0:15:19.13,0:15:23.17,Default,,0000,0000,0000,,Әзірге Бұлма-санның орнына қайтайық.
Dialogue: 0,0:15:23.17,0:15:26.20,Default,,0000,0000,0000,,Сіз ұша аласыз ба?
Dialogue: 0,0:15:26.20,0:15:28.20,Default,,0000,0000,0000,,А, иә.
Dialogue: 0,0:15:32.59,0:15:35.62,Default,,0000,0000,0000,,Көмегің үшін көп рахмет.
Dialogue: 0,0:15:35.62,0:15:38.65,Default,,0000,0000,0000,,Маған алғыс айтқыңыз келсе, мына Гоханға айтыңыз.
Dialogue: 0,0:15:38.65,0:15:41.68,Default,,0000,0000,0000,,Қиындыққа тап болдым, көмектескім келмеді.
Dialogue: 0,0:15:41.68,0:15:45.72,Default,,0000,0000,0000,,Бірақ егер Криллин-сан маған көмектеспесе →
Dialogue: 0,0:15:45.72,0:15:47.74,Default,,0000,0000,0000,,Екеуі де өлді.
Dialogue: 0,0:15:47.74,0:15:52.79,Default,,0000,0000,0000,,Эхехехе... Жарайды, бәрібір бізбен бірге жүр.
Dialogue: 0,0:15:52.79,0:15:55.82,Default,,0000,0000,0000,,Ол ерекше күдікті сияқты емес.
Dialogue: 0,0:15:55.82,0:15:57.84,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:15:57.84,0:16:01.88,Default,,0000,0000,0000,,Аха. Хехехе….
Dialogue: 0,0:16:01.88,0:16:03.88,Default,,0000,0000,0000,,Ах... Иә!
Dialogue: 0,0:16:05.92,0:16:08.95,Default,,0000,0000,0000,,Айдаһар добы бұрын болған, бірақ →
Dialogue: 0,0:16:08.95,0:16:10.97,Default,,0000,0000,0000,,Біртүрлі адамдар көбірек жинап жатыр →
Dialogue: 0,0:16:10.97,0:16:12.99,Default,,0000,0000,0000,,Егер бәрі осылай қабылданса →
Dialogue: 0,0:16:12.99,0:16:15.02,Default,,0000,0000,0000,,Мен сияқты әлсіз ханым не үшін?
Dialogue: 0,0:16:15.02,0:16:17.04,Default,,0000,0000,0000,,Сіз бұл планетаға тәуекел етсеңіз де келдіңіз бе?→
Dialogue: 0,0:16:17.04,0:16:20.07,Default,,0000,0000,0000,,Сіз түсінбейсіз, солай ма? →
Dialogue: 0,0:16:20.07,0:16:23.10,Default,,0000,0000,0000,,Сіз жай тыңдап тұрсыз ба? Әке.
Dialogue: 0,0:16:23.10,0:16:25.12,Default,,0000,0000,0000,,Аа, мен сізді дұрыс естимін. →
Dialogue: 0,0:16:25.12,0:16:27.14,Default,,0000,0000,0000,,Сонымен не болды?
Dialogue: 0,0:16:27.14,0:16:31.52,Default,,0000,0000,0000,,Қалай болғанда да, бәрі ең нашар.
Dialogue: 0,0:16:31.52,0:16:34.55,Default,,0000,0000,0000,,Ғарыш кемесі бұзылды, мен үйге қайта алмаймын.
Dialogue: 0,0:16:34.55,0:16:39.60,Default,,0000,0000,0000,,Қайтып келе жатырмын... Менің ойымша, бұл жаман.
Dialogue: 0,0:16:39.60,0:16:43.64,Default,,0000,0000,0000,,Гоку жаңа ғана сол жаққа бет алған болса да.
Dialogue: 0,0:16:43.64,0:16:48.69,Default,,0000,0000,0000,,Е, немерем!? Немересі Намекке келе жатыр ма?
Dialogue: 0,0:16:48.69,0:16:50.71,Default,,0000,0000,0000,,Шынында да шынымен бе?
Dialogue: 0,0:16:50.71,0:16:52.73,Default,,0000,0000,0000,,Аа, дұрыс. →
Dialogue: 0,0:16:52.73,0:16:56.77,Default,,0000,0000,0000,,Жоспар бойынша ол шамамен 6 күнде келуі керек.
Dialogue: 0,0:16:56.77,0:16:58.79,Default,,0000,0000,0000,,Ухуху...
Dialogue: 0,0:16:58.79,0:17:01.79,Default,,0000,0000,0000,,Иә! (Бұлманың әкесі) Әй, Бұлма.
Dialogue: 0,0:17:03.84,0:17:05.86,Default,,0000,0000,0000,,Бірақ скаутерсіз→
Dialogue: 0,0:17:05.86,0:17:09.90,Default,,0000,0000,0000,,Қалған екі Айдаһар шарын іздеу қиын болар еді.
Dialogue: 0,0:17:09.90,0:17:12.93,Default,,0000,0000,0000,,Бұл өте үлкен жұлдыз емес.
Dialogue: 0,0:17:12.93,0:17:14.93,Default,,0000,0000,0000,,Dowa~!
Dialogue: 0,0:17:24.05,0:17:28.09,Default,,0000,0000,0000,,Бухаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа аааааааааааааааааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:17:28.09,0:17:30.44,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:17:30.44,0:17:34.48,Default,,0000,0000,0000,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:17:34.48,0:17:36.50,Default,,0000,0000,0000,,Вегета бол, сен.
Dialogue: 0,0:17:36.50,0:17:41.55,Default,,0000,0000,0000,,Мен сені соңғы рет көрмегелі көп уақыт өтті, Додориа-сан.
Dialogue: 0,0:17:41.55,0:17:45.59,Default,,0000,0000,0000,,Мені таң қалдырған Вегета болды!
Dialogue: 0,0:17:45.59,0:17:47.61,Default,,0000,0000,0000,,Сіз және Зарбон→
Dialogue: 0,0:17:47.61,0:17:50.64,Default,,0000,0000,0000,,Ол үнемі Фриэзамен араласады. →
Dialogue: 0,0:17:50.64,0:17:52.66,Default,,0000,0000,0000,,Мен жалғыз қалуды күттім.
Dialogue: 0,0:17:52.66,0:17:57.71,Default,,0000,0000,0000,,Егер Фриеза болмаса, бәлкім, қандай да бір жолмен шешілетін еді.
Dialogue: 0,0:17:57.71,0:18:02.76,Default,,0000,0000,0000,,Не!? Саян тәрізді адам өте сыпайы болуы мүмкін!
Dialogue: 0,0:18:02.76,0:18:04.76,Default,,0000,0000,0000,,Көріп тұрғаныңыздай, осы қызыл шамы бар ауданда➡
Dialogue: 0,0:18:07.81,0:18:10.84,Default,,0000,0000,0000,,Вегета әлгі скаутерді сабырмен алып →
Dialogue: 0,0:18:10.84,0:18:12.86,Default,,0000,0000,0000,,Оны маған бер, ол жоғалады.
Dialogue: 0,0:18:12.86,0:18:16.90,Default,,0000,0000,0000,,Олай жасасаң, мен бұл жерді сағынып қаламын.
Dialogue: 0,0:18:16.90,0:18:20.94,Default,,0000,0000,0000,,Көрдім, дыбыс кенет тоқтап қалды, сондықтан мен...
Dialogue: 0,0:18:20.94,0:18:23.97,Default,,0000,0000,0000,,Балалар, барлаушыларыңды жоғалтып алған сияқтысыңдар.
Dialogue: 0,0:18:23.97,0:18:26.00,Default,,0000,0000,0000,,Ууууу…. (Вегета) Хахахаха!
Dialogue: 0,0:18:26.00,0:18:30.37,Default,,0000,0000,0000,,Бұл жақсы. Енді саған жақындасам да айта алмайсың.
Dialogue: 0,0:18:30.37,0:18:32.37,Default,,0000,0000,0000,,Уау... не?!
Dialogue: 0,0:18:34.41,0:18:37.44,Default,,0000,0000,0000,,Скаутерді алу үшін Фриз планетасына бару үшін →
Dialogue: 0,0:18:37.44,0:18:40.47,Default,,0000,0000,0000,,Бірнеше күн қажет.
Dialogue: 0,0:18:40.47,0:18:42.47,Default,,0000,0000,0000,,Осыны қалайсыз ба?
Dialogue: 0,0:18:44.51,0:18:46.53,Default,,0000,0000,0000,,А... маған бергің келді ме?
Dialogue: 0,0:18:46.53,0:18:50.57,Default,,0000,0000,0000,,Эхехе. Қазірге дейін мен қорқынышты аяқтадым.
Dialogue: 0,0:18:50.57,0:18:52.59,Default,,0000,0000,0000,,Егер сіздің де жолыңыз болса →
Dialogue: 0,0:18:52.59,0:18:57.64,Default,,0000,0000,0000,,Мүмкін сенің өмірің аман қалар.
Dialogue: 0,0:18:57.64,0:18:59.64,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:19:03.70,0:19:07.74,Default,,0000,0000,0000,,Ахх... →
Dialogue: 0,0:19:07.74,0:19:10.77,Default,,0000,0000,0000,,Не істеп жатырсың, Вегета?
Dialogue: 0,0:19:10.77,0:19:15.82,Default,,0000,0000,0000,,Хмф! Оны неге құрттың?
Dialogue: 0,0:19:15.82,0:19:18.85,Default,,0000,0000,0000,,Өйткені ол маған енді керек емес.
Dialogue: 0,0:19:18.85,0:19:21.88,Default,,0000,0000,0000,,Не!? Сізде де ол жігіт болмаса→
Dialogue: 0,0:19:21.88,0:19:25.92,Default,,0000,0000,0000,,Біз тіпті Фриеза-сама немесе Намекиандардың қайда екенін де білмейміз.
Dialogue: 0,0:19:25.92,0:19:29.13,Default,,0000,0000,0000,,Бұл өкінішті болды. Бұл мен жердегілерге қарсы күресіп жатырмын →
Dialogue: 0,0:19:29.13,0:19:31.31,Default,,0000,0000,0000,,Олар барлаушы болмаса да→
Dialogue: 0,0:19:31.31,0:19:35.31,Default,,0000,0000,0000,,Қарсыласымның күші мен орнын біле алатынымды білдім.
Dialogue: 0,0:19:37.37,0:19:39.39,Default,,0000,0000,0000,,Ал мен сияқты жер бетінде болған сайандар →
Dialogue: 0,0:19:39.39,0:19:43.43,Default,,0000,0000,0000,,Оның ерекше шеберлігі бар еді. →
Dialogue: 0,0:19:43.43,0:19:46.46,Default,,0000,0000,0000,,Сонда менің де қолымнан келуі керек.
Dialogue: 0,0:19:46.46,0:19:49.49,Default,,0000,0000,0000,,Уу-у...
Dialogue: 0,0:19:49.49,0:19:52.52,Default,,0000,0000,0000,,Мұны еске түсіргеннен кейін оңай болады.
Dialogue: 0,0:19:52.52,0:19:54.54,Default,,0000,0000,0000,,Көбіне сіз жігіттер және Фриэза ұнайды→
Dialogue: 0,0:19:54.54,0:19:59.59,Default,,0000,0000,0000,,Егер сіз тек күшке назар аударсаңыз, бұл мүмкін емес.
Dialogue: 0,0:19:59.59,0:20:03.63,Default,,0000,0000,0000,,Бірақ менде осы уақытқа дейін солай болды.
Dialogue: 0,0:20:03.63,0:20:05.65,Default,,0000,0000,0000,,Түсіндім. Мен қуған кішкентайлар →
Dialogue: 0,0:20:05.65,0:20:08.68,Default,,0000,0000,0000,,Ол жерлік. (Вегета) Сіз жерліксіз бе?
Dialogue: 0,0:20:08.68,0:20:12.72,Default,,0000,0000,0000,,Жердегілермен күш біріктірдің.
Dialogue: 0,0:20:12.72,0:20:14.74,Default,,0000,0000,0000,,Неге жартылай ұйықтап жатырсың?
Dialogue: 0,0:20:14.74,0:20:17.77,Default,,0000,0000,0000,,Жер тұрғындарының мұндай жерге келуі мүмкін емес.
Dialogue: 0,0:20:17.77,0:20:22.82,Default,,0000,0000,0000,,Ондай адамдар болса, мен бірінші болып қамқорлық жасаймын.
Dialogue: 0,0:20:22.82,0:20:24.84,Default,,0000,0000,0000,,Бұл маңызды емес!
Dialogue: 0,0:20:24.84,0:20:27.87,Default,,0000,0000,0000,,Қалай болғанда да, сіз осы жерден жоғалып кетуіңіз керек.
Dialogue: 0,0:20:27.87,0:20:30.24,Default,,0000,0000,0000,,Өлтіргіңіз келмесе!
Dialogue: 0,0:20:30.24,0:20:34.28,Default,,0000,0000,0000,,Ей, сағынып қалуыма рұқсат бергеніңе ризамын.
Dialogue: 0,0:20:34.28,0:20:38.32,Default,,0000,0000,0000,,Сіз неден қорқасыз? Неге маған ертерек қоңырау шалмадың?
Dialogue: 0,0:20:38.32,0:20:42.36,Default,,0000,0000,0000,,Уф…. (Вегета) Мен білемін. →
Dialogue: 0,0:20:42.36,0:20:44.38,Default,,0000,0000,0000,,Куи екеуміздің төбелесімде→
Dialogue: 0,0:20:44.38,0:20:48.42,Default,,0000,0000,0000,,Мен бұрынғыдан әлдеқайда күшті екенімді білдім→
Dialogue: 0,0:20:48.42,0:20:51.45,Default,,0000,0000,0000,,Мен қорқамын. Уау...
Dialogue: 0,0:20:51.45,0:20:54.48,Default,,0000,0000,0000,,Хахаха... Скаутерден көрген шығармын →
Dialogue: 0,0:20:54.48,0:20:56.50,Default,,0000,0000,0000,,Менің жауынгерлік күшім.
Dialogue: 0,0:20:56.50,0:21:01.55,Default,,0000,0000,0000,,Ах, бұл сандар қате. Скаутер дұрыс жұмыс істемейді.
Dialogue: 0,0:21:01.55,0:21:04.55,Default,,0000,0000,0000,,Мені төмендетпе!
Dialogue: 0,0:21:06.60,0:21:10.64,Default,,0000,0000,0000,,Дея! Ха! Ха! Ха! Дея!
Dialogue: 0,0:21:10.64,0:21:12.66,Default,,0000,0000,0000,,Ах~!
Dialogue: 0,0:21:12.66,0:21:14.68,Default,,0000,0000,0000,,О?
Dialogue: 0,0:21:14.68,0:21:16.70,Default,,0000,0000,0000,,Мені бағаламаған сен едің.
Dialogue: 0,0:21:16.70,0:21:19.73,Default,,0000,0000,0000,,Мұндай әдіс маған жұмыс істей алмайды.
Dialogue: 0,0:21:19.73,0:21:21.75,Default,,0000,0000,0000,,Уау…. →
Dialogue: 0,0:21:21.75,0:21:23.77,Default,,0000,0000,0000,,Уф… Вау….
Dialogue: 0,0:21:23.77,0:21:25.79,Default,,0000,0000,0000,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:21:25.79,0:21:29.99,Default,,0000,0000,0000,,Біз Сайяндар соғысқан сайын күшейеміз.
Dialogue: 0,0:21:29.99,0:21:31.18,Default,,0000,0000,0000,,Ах~!!→
Dialogue: 0,0:21:31.18,0:21:33.20,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:21:33.20,0:21:38.25,Default,,0000,0000,0000,,Қарсыласым күшті болған сайын мен де күшейемін.
Dialogue: 0,0:21:38.25,0:21:43.30,Default,,0000,0000,0000,,Сондықтан мен Жерде өлейін деп тұрсам да, мен әлдеқайда күшті болдым.
Dialogue: 0,0:21:43.30,0:21:46.33,Default,,0000,0000,0000,,Бұл Сайян жауынгерлерінің нәсілі. →
Dialogue: 0,0:21:46.33,0:21:51.38,Default,,0000,0000,0000,,Менің мақтаншақ күшім тым жалқау ма? Иә!?→
Dialogue: 0,0:21:51.38,0:21:54.41,Default,,0000,0000,0000,,Уф! Ааа...
Dialogue: 0,0:21:54.41,0:21:56.43,Default,,0000,0000,0000,,Күте тұрыңыз, Вегета.
Dialogue: 0,0:21:56.43,0:22:00.47,Default,,0000,0000,0000,,Сен мені жіберсең, мен саған бір сыр айтамын. →
Dialogue: 0,0:22:00.47,0:22:03.50,Default,,0000,0000,0000,,Мен сіздің планетаңыз туралы айтып отырмын, Вегета планетасы.
Dialogue: 0,0:22:03.50,0:22:06.53,Default,,0000,0000,0000,,Не!? Вегета планетасы?
Dialogue: 0,0:22:06.53,0:22:09.56,Default,,0000,0000,0000,,Вегета планетасының құпиясы неде?
Dialogue: 0,0:22:09.56,0:22:13.60,Default,,0000,0000,0000,,Жібер! Егер мені жіберсең, мен сенімен сөйлесемін.
Dialogue: 0,0:22:13.60,0:22:15.60,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:22:17.64,0:22:21.68,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:22:21.68,0:22:26.73,Default,,0000,0000,0000,,Тш, сен сөйлей сала мені өлтіруді ойламайсың ғой, солай ма?
Dialogue: 0,0:22:26.73,0:22:29.42,Default,,0000,0000,0000,,Маған айтпасаң, мен сені дәл қазір өлтіремін! Тез айт!!
Dialogue: 0,0:22:29.42,0:22:32.12,Default,,0000,0000,0000,,Сіз Сайян планетасы Вегета бұл →
Dialogue: 0,0:22:32.12,0:22:35.15,Default,,0000,0000,0000,,Фриза-сама айтқандай →
Dialogue: 0,0:22:35.15,0:22:39.19,Default,,0000,0000,0000,,Ол үлкен метеоритпен соқтығысқандықтан жоғалып кетпеді.
Dialogue: 0,0:22:39.19,0:22:41.21,Default,,0000,0000,0000,,(Дарио) Дио, мына жаққа кел. Жөтел, жөтел!
Dialogue: 0,0:22:41.21,0:22:43.23,Default,,0000,0000,0000,,Әр Сайянның күші →
Dialogue: 0,0:22:43.23,0:22:46.26,Default,,0000,0000,0000,,Ол Фриеза-самадай жақсы болмаса да→
Dialogue: 0,0:22:46.26,0:22:49.29,Default,,0000,0000,0000,,Көп сайяндар біріге бастаса→
Dialogue: 0,0:22:49.29,0:22:52.32,Default,,0000,0000,0000,,Бұл өте тәртіпсіз болып қалады. Ха…. →
Dialogue: 0,0:22:52.32,0:22:56.36,Default,,0000,0000,0000,,Ал сіз сияқты саяндар санаулы ғана→
Dialogue: 0,0:22:56.36,0:23:01.41,Default,,0000,0000,0000,,Көрнекті жауынгерлер туып, көбейе бастады. →
Dialogue: 0,0:23:01.41,0:23:03.43,Default,,0000,0000,0000,,Біртүрлі күшке ие бола бастасаңыз →
Dialogue: 0,0:23:03.43,0:23:06.46,Default,,0000,0000,0000,,Олар бұйрыққа мәңгі бағынатын адамдар емес →
Dialogue: 0,0:23:06.46,0:23:08.48,Default,,0000,0000,0000,,сол кездегі Фриза-сама→
Dialogue: 0,0:23:08.48,0:23:12.52,Default,,0000,0000,0000,,Ол шара қолдану қажет деп есептеді.
Dialogue: 0,0:23:12.52,0:23:15.55,Default,,0000,0000,0000,,Ал Фризаның өзі →
Dialogue: 0,0:23:15.55,0:23:20.60,Default,,0000,0000,0000,,Ол бүкіл Сайяндармен бірге Вегета планетасын жойды. →
Dialogue: 0,0:23:20.60,0:23:24.64,Default,,0000,0000,0000,,Бірақ Вегета Фриеза-самаға риза болуы керек. →
Dialogue: 0,0:23:24.64,0:23:27.67,Default,,0000,0000,0000,,Сіз Вегета планетасының ханзадасы болдыңыз. Сіздің данышпан дағдыларыңыз → болды
Dialogue: 0,0:23:27.67,0:23:29.69,Default,,0000,0000,0000,,Оны қолдануға болатын сияқты →
Dialogue: 0,0:23:29.69,0:23:31.71,Default,,0000,0000,0000,,Мен сіз планетада болмаған уақытты әдейі таңдаймын →
Dialogue: 0,0:23:31.71,0:23:34.74,Default,,0000,0000,0000,,Фриза-сама нысанаға алынды. →
Dialogue: 0,0:23:34.74,0:23:36.76,Default,,0000,0000,0000,,Хахахаха! Күтілгендей →
Dialogue: 0,0:23:36.76,0:23:39.79,Default,,0000,0000,0000,,Сіз қатты шок болған сияқтысыз. Маған бұл ұнайды →
Dialogue: 0,0:23:39.79,0:23:42.82,Default,,0000,0000,0000,,Маған Фриза-самаға оралуға рұқсат етіңіз.
Dialogue: 0,0:23:42.82,0:23:46.86,Default,,0000,0000,0000,,Мені қате түсінбе, Додория. Ууууу….
Dialogue: 0,0:23:46.86,0:23:49.89,Default,,0000,0000,0000,,Мен жұлдыздар туралы, достарым, ата-анам, т.б.→
Dialogue: 0,0:23:49.89,0:23:51.91,Default,,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,0:23:51.91,0:23:54.94,Default,,0000,0000,0000,,Бірақ мен мұны бала кезімнен білмедім→
Dialogue: 0,0:23:54.94,0:23:57.97,Default,,0000,0000,0000,,Мен сізге ұнағандай қолданылды →
Dialogue: 0,0:23:57.97,0:23:59.99,Default,,0000,0000,0000,,Бұл мені ашуландырады!
Dialogue: 0,0:23:59.99,0:24:01.01,Default,,0000,0000,0000,,Фриэза-сама~!
Dialogue: 0,0:24:01.01,0:24:05.05,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:24:05.05,0:24:07.07,Default,,0000,0000,0000,,Таа~!
Dialogue: 0,0:24:07.07,0:24:09.07,Default,,0000,0000,0000,,Ах~!
Dialogue: 0,0:24:17.17,0:24:21.17,Default,,0000,0000,0000,,Фриэза Сайяндардың түпсіз әлеуетінен қорқады.
Dialogue: 0,0:24:23.23,0:24:25.25,Default,,0000,0000,0000,,Жылдам алға →
Dialogue: 0,0:24:25.25,0:24:29.25,Default,,0000,0000,0000,,Біз бұл 20 есе ауырлық күшін жеңуіміз керек.
Dialogue: 0,0:24:31.64,0:24:33.66,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:24:33.66,0:24:36.69,Default,,0000,0000,0000,,бастайық.
Dialogue: 0,0:24:36.69,0:24:38.71,Default,,0000,0000,0000,,<Генки Гоку жігерлі. →
Dialogue: 0,0:24:38.71,0:24:42.75,Default,,0000,0000,0000,,Вегетаның күші артып келеді. →
Dialogue: 0,0:24:42.75,0:24:47.75,Default,,0000,0000,0000,,Екеуінің тағы да соқтығысатын уақыты жақындап қалды>
Dialogue: 0,0:24:52.85,0:24:57.90,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:57.90,0:25:17.10,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:17.10,0:25:37.64,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:37.64,0:25:50.64,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:54.81,0:25:56.83,Default,,0000,0000,0000,,Сәлем, Гоку.
Dialogue: 0,0:25:56.83,0:25:59.86,Default,,0000,0000,0000,,Біздің келуімізге бес жарым күн қалды. Мен күшейемін.
Dialogue: 0,0:25:59.86,0:26:01.88,Default,,0000,0000,0000,,Вегета да осы планетада... Ең сорақысы!
Dialogue: 0,0:26:01.88,0:26:03.90,Default,,0000,0000,0000,,Мен Айдаһар шарларын көздеп отырмын.
Dialogue: 0,0:26:03.90,0:26:06.93,Default,,0000,0000,0000,,5 Фризаның және 2 қалды. Ах!
Dialogue: 0,0:26:06.93,0:26:09.96,Default,,0000,0000,0000,,Вегета киі. Олар басқа ауылға шабуыл жасайды.
Dialogue: 0,0:26:09.96,0:26:12.96,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»
Dialogue: 0,0:26:15.02,0:26:19.02,Default,,0000,0000,0000,,Әке, мен де осы жерден достар таптым.
Dialogue: 0,0:26:20.52,0:26:26.52,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory