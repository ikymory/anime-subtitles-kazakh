Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.41,0:00:14.48,Default,,0000,0000,0000,,<Ямча Мәдениет адамын жеңген сияқты болды. →
Dialogue: 0,0:00:14.48,0:00:16.48,Default,,0000,0000,0000,,Бірақ...＞
Dialogue: 0,0:00:19.53,0:00:23.57,Default,,0000,0000,0000,,Әй, бұл лас. Мына шүберекті тазалаңыз.
Dialogue: 0,0:00:23.57,0:00:28.57,Default,,0000,0000,0000,,<Криллиннің ашуы ақыры жарылды>
Dialogue: 0,0:00:31.65,0:00:36.70,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:36.70,0:00:56.90,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:00:56.90,0:01:16.43,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:16.43,0:01:36.63,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:36.63,0:01:53.63,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:15.55,0:04:19.59,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:04:19.59,0:04:21.61,Default,,0000,0000,0000,,А... Иә?
Dialogue: 0,0:04:21.61,0:04:25.65,Default,,0000,0000,0000,,Мен сендерге тренингімнің нәтижесін көрсетемін. →
Dialogue: 0,0:04:25.65,0:04:29.69,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:04:29.69,0:04:32.72,Default,,0000,0000,0000,,Барыңыз. (Өсіруші адам) Ува Ува Ува!
Dialogue: 0,0:04:32.72,0:04:36.76,Default,,0000,0000,0000,,Ууу... Яа! Таа~!
Dialogue: 0,0:04:36.76,0:04:40.80,Default,,0000,0000,0000,,Не? Бұл баяу доп.
Dialogue: 0,0:04:40.80,0:04:43.83,Default,,0000,0000,0000,,Оля~! (Культиваторлар) Яаааааааааа!
Dialogue: 0,0:04:43.83,0:04:45.83,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:04:47.87,0:04:50.90,Default,,0000,0000,0000,,Ха~!
Dialogue: 0,0:04:50.90,0:04:53.93,Default,,0000,0000,0000,,Ги~!
Dialogue: 0,0:04:53.93,0:04:55.93,Default,,0000,0000,0000,,Хе хи!
Dialogue: 0,0:04:57.97,0:05:03.03,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:05:03.03,0:05:07.40,Default,,0000,0000,0000,,Мен мұны істедім. (Сон Гохан) Уау! Бұл керемет.
Dialogue: 0,0:05:07.40,0:05:09.42,Default,,0000,0000,0000,,Криллин, жақсысың ба?
Dialogue: 0,0:05:09.42,0:05:13.46,Default,,0000,0000,0000,,Ах. Бірақ мен біреуін жіберіп алдым.
Dialogue: 0,0:05:13.46,0:05:15.48,Default,,0000,0000,0000,,Иә~! Ах!
Dialogue: 0,0:05:15.48,0:05:17.50,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:05:17.50,0:05:21.54,Default,,0000,0000,0000,,Гах! Гах...
Dialogue: 0,0:05:21.54,0:05:24.57,Default,,0000,0000,0000,,Бля саған. Торя~!
Dialogue: 0,0:05:24.57,0:05:26.59,Default,,0000,0000,0000,,Иә~!
Dialogue: 0,0:05:26.59,0:05:28.61,Default,,0000,0000,0000,,Гуа~!
Dialogue: 0,0:05:28.61,0:05:32.65,Default,,0000,0000,0000,,Аа... Ги~!
Dialogue: 0,0:05:32.65,0:05:34.65,Default,,0000,0000,0000,,Ах….
Dialogue: 0,0:05:36.69,0:05:38.71,Default,,0000,0000,0000,,《Пикколого күткендей. →
Dialogue: 0,0:05:38.71,0:05:43.76,Default,,0000,0000,0000,,Күндердің күнінде тағы да жау болып қалатынымызды ойласам, селт етем.
Dialogue: 0,0:05:43.76,0:05:46.79,Default,,0000,0000,0000,,Рахмет, Пикколо-сан.
Dialogue: 0,0:05:46.79,0:05:49.82,Default,,0000,0000,0000,,Мені қате түсінбеңіз. Сіз маған көмектесесіз бе?
Dialogue: 0,0:05:49.82,0:05:52.85,Default,,0000,0000,0000,,Басталып жатқан ұлы шайқас үшін→
Dialogue: 0,0:05:52.85,0:05:55.88,Default,,0000,0000,0000,,Жаңа ғана жылыну.
Dialogue: 0,0:05:55.88,0:05:58.91,Default,,0000,0000,0000,,Кукукукукуку. →
Dialogue: 0,0:05:58.91,0:06:03.96,Default,,0000,0000,0000,,Осылай шайқас болғанын қалаймын. Хехехе.
Dialogue: 0,0:06:03.96,0:06:06.33,Default,,0000,0000,0000,,Ах! (Тяньшин күріш/гёза) Ах!
Dialogue: 0,0:06:06.33,0:06:09.36,Default,,0000,0000,0000,,Хехехе. Хехехе.
Dialogue: 0,0:06:09.36,0:06:12.39,Default,,0000,0000,0000,,Енді өзіңіз қалаған нәрсені жасайтын кез келді →
Dialogue: 0,0:06:12.39,0:06:14.41,Default,,0000,0000,0000,,Ойынды аяқтаймыз ба?
Dialogue: 0,0:06:14.41,0:06:20.47,Default,,0000,0000,0000,,Хехехехе. Ақырында нақты нәрсеге уақыт келді.
Dialogue: 0,0:06:20.47,0:06:24.51,Default,,0000,0000,0000,,《Жаман, ақымақ. Мен жауап бермей тұрған сияқтымын.
Dialogue: 0,0:06:24.51,0:06:27.54,Default,,0000,0000,0000,,Уа, мен толық қуатты пайдаландым.
Dialogue: 0,0:06:27.54,0:06:31.58,Default,,0000,0000,0000,,Хехехе. (Вегета) Фуфуфуфуфу.
Dialogue: 0,0:06:31.58,0:06:33.58,Default,,0000,0000,0000,,Бұл Сайян ба...?
Dialogue: 0,0:06:40.67,0:06:42.69,Default,,0000,0000,0000,,Маған орындауға рұқсат етіңіз. →
Dialogue: 0,0:06:42.69,0:06:45.72,Default,,0000,0000,0000,,Бір сәтте барлық бес адамды тазалаңыз.
Dialogue: 0,0:06:45.72,0:06:47.74,Default,,0000,0000,0000,,Өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:06:47.74,0:06:52.79,Default,,0000,0000,0000,,Бірақ сол Намекянды өлтірме. →
Dialogue: 0,0:06:52.79,0:06:57.84,Default,,0000,0000,0000,,Мен сенен Айдаһар шарлары туралы кейінірек сұрауым керек.
Dialogue: 0,0:06:57.84,0:07:01.88,Default,,0000,0000,0000,,Ендеше, маған көңіл көтеруге рұқсат етіңіз.
Dialogue: 0,0:07:01.88,0:07:04.91,Default,,0000,0000,0000,,Бірінші →
Dialogue: 0,0:07:04.91,0:07:07.27,Default,,0000,0000,0000,,Бұл сізден! Уау!
Dialogue: 0,0:07:07.27,0:07:10.30,Default,,0000,0000,0000,,Маған қалдырыңыз! Апыр-ай!
Dialogue: 0,0:07:10.30,0:07:12.30,Default,,0000,0000,0000,,Даа~!
Dialogue: 0,0:07:19.39,0:07:22.42,Default,,0000,0000,0000,,Оля! Апыр-ай!
Dialogue: 0,0:07:22.42,0:07:25.45,Default,,0000,0000,0000,,Пикколо мырза! Ах...
Dialogue: 0,0:07:25.45,0:07:29.49,Default,,0000,0000,0000,,Хэхехе. Бұл сізді аздап қызықтырады деп ойлаймын.
Dialogue: 0,0:07:29.49,0:07:31.51,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:07:31.51,0:07:36.56,Default,,0000,0000,0000,,Хаа~.
Dialogue: 0,0:07:36.56,0:07:39.56,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:07:42.62,0:07:48.62,Default,,0000,0000,0000,,Хаа~.
Dialogue: 0,0:07:52.72,0:07:55.75,Default,,0000,0000,0000,,Жер дірілдеп тұр.
Dialogue: 0,0:07:55.75,0:08:00.75,Default,,0000,0000,0000,,Уу~ Жоқ, бұл жақсы емес, Тен мырза!
Dialogue: 0,0:08:02.82,0:08:05.02,Default,,0000,0000,0000,,Менің керемет күшім жұмыс істемейді!
Dialogue: 0,0:08:05.02,0:08:07.20,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:08:07.20,0:08:10.23,Default,,0000,0000,0000,,Кууууу~.
Dialogue: 0,0:08:10.23,0:08:15.28,Default,,0000,0000,0000,,《Сіз нені айтып тұрсыз? Ей, осы уақытқа дейін! 》
Dialogue: 0,0:08:15.28,0:08:17.28,Default,,0000,0000,0000,,Уу... таа~!
Dialogue: 0,0:08:21.34,0:08:24.34,Default,,0000,0000,0000,,《Асығыңыз! Барлығыңыз күтіңіздер》
Dialogue: 0,0:08:33.46,0:08:36.49,Default,,0000,0000,0000,,Гва~.
Dialogue: 0,0:08:36.49,0:08:39.49,Default,,0000,0000,0000,,(Найзағай)
Dialogue: 0,0:08:41.54,0:08:46.59,Default,,0000,0000,0000,,Нуа~!
Dialogue: 0,0:08:46.59,0:08:52.65,Default,,0000,0000,0000,,Уау... Жарайды. Nu~!
Dialogue: 0,0:08:52.65,0:08:55.68,Default,,0000,0000,0000,,Иә? (Тяньцзинь күріші) Гёза Абайлаңыз.
Dialogue: 0,0:08:55.68,0:08:58.71,Default,,0000,0000,0000,,Хаа~! (Гйоза) Уау!
Dialogue: 0,0:08:58.71,0:09:00.73,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:09:00.73,0:09:06.12,Default,,0000,0000,0000,,Хи хи хи хи. Ммм~.
Dialogue: 0,0:09:06.12,0:09:10.16,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:09:10.16,0:09:13.19,Default,,0000,0000,0000,,Қарғыс атсын.
Dialogue: 0,0:09:13.19,0:09:15.21,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:09:15.21,0:09:18.24,Default,,0000,0000,0000,,Да~! Апыр-ай!
Dialogue: 0,0:09:18.24,0:09:20.26,Default,,0000,0000,0000,,Ах…. Апыр-ай!
Dialogue: 0,0:09:20.26,0:09:24.30,Default,,0000,0000,0000,,Тяньцзинь күріш! Апыр-ай!
Dialogue: 0,0:09:24.30,0:09:26.32,Default,,0000,0000,0000,,Жолдан кет!
Dialogue: 0,0:09:26.32,0:09:29.35,Default,,0000,0000,0000,,Иә! (Тяньшин тамағы) Уау!
Dialogue: 0,0:09:29.35,0:09:31.37,Default,,0000,0000,0000,,Аспан!
Dialogue: 0,0:09:31.37,0:09:33.39,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:33.39,0:09:38.44,Default,,0000,0000,0000,,Хухахаха.
Dialogue: 0,0:09:38.44,0:09:40.46,Default,,0000,0000,0000,,Хун, олар нәзік.
Dialogue: 0,0:09:40.46,0:09:43.49,Default,,0000,0000,0000,,Аяқтаңыз!
Dialogue: 0,0:09:43.49,0:09:45.51,Default,,0000,0000,0000,,Цк.
Dialogue: 0,0:09:45.51,0:09:49.55,Default,,0000,0000,0000,,Қарғыс атсын!
Dialogue: 0,0:09:49.55,0:09:52.58,Default,,0000,0000,0000,,Ах~!
Dialogue: 0,0:09:52.58,0:09:54.58,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:09:56.62,0:09:58.64,Default,,0000,0000,0000,,Теншинхан!
Dialogue: 0,0:09:58.64,0:10:05.88,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:10:05.88,0:10:08.08,Default,,0000,0000,0000,,Чикушо ~ Теншин тағамы!
Dialogue: 0,0:10:08.08,0:10:10.10,Default,,0000,0000,0000,,Күте тұрыңыз! Ол енді жақсы емес. Мені жалғыз қалдыр!
Dialogue: 0,0:10:10.10,0:10:13.13,Default,,0000,0000,0000,,Шулы! Иә?
Dialogue: 0,0:10:13.13,0:10:16.13,Default,,0000,0000,0000,,Бұл ыңғайсыздық!
Dialogue: 0,0:10:18.18,0:10:20.20,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:10:20.20,0:10:23.20,Default,,0000,0000,0000,,Уф! Ууууу….
Dialogue: 0,0:10:31.31,0:10:36.36,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:10:36.36,0:10:42.42,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:10:42.42,0:10:45.45,Default,,0000,0000,0000,,Тесіктің түбі көрінбейді... Сене алар емеспін. →
Dialogue: 0,0:10:45.45,0:10:47.47,Default,,0000,0000,0000,,Бұл керемет энергия толқыны.
Dialogue: 0,0:10:47.47,0:10:50.50,Default,,0000,0000,0000,,Қарғыс атсын.
Dialogue: 0,0:10:50.50,0:10:54.54,Default,,0000,0000,0000,,Наппа артыңа қара.
Dialogue: 0,0:10:54.54,0:10:57.57,Default,,0000,0000,0000,,Иә! Иә!?
Dialogue: 0,0:10:57.57,0:10:59.59,Default,,0000,0000,0000,,Гёза!
Dialogue: 0,0:10:59.59,0:11:01.61,Default,,0000,0000,0000,,Уу~ Сен бейбақ!
Dialogue: 0,0:11:01.61,0:11:05.31,Default,,0000,0000,0000,,Қарғыс атсын... Мм!
Dialogue: 0,0:11:05.31,0:11:09.02,Default,,0000,0000,0000,,Ах... Уф! Уау! →
Dialogue: 0,0:11:09.02,0:11:11.04,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:11:11.04,0:11:14.07,Default,,0000,0000,0000,,Джоза, кет!
Dialogue: 0,0:11:14.07,0:11:17.10,Default,,0000,0000,0000,,Уф! Апыр-ай!
Dialogue: 0,0:11:17.10,0:11:21.14,Default,,0000,0000,0000,,Джоза, болды, кет!
Dialogue: 0,0:11:21.14,0:11:24.17,Default,,0000,0000,0000,,《Тэцу Тен-сан...》 (Теншинхан) Ах!
Dialogue: 0,0:11:24.17,0:11:28.21,Default,,0000,0000,0000,,《Аа, рахмет》
Dialogue: 0,0:11:28.21,0:11:33.26,Default,,0000,0000,0000,,Не айтып тұрсың, гёза? →
Dialogue: 0,0:11:33.26,0:11:37.30,Default,,0000,0000,0000,,Қаш. Тез қаш!
Dialogue: 0,0:11:37.30,0:11:40.33,Default,,0000,0000,0000,,Хехе...хех.
Dialogue: 0,0:11:40.33,0:11:46.39,Default,,0000,0000,0000,,《Мен сенімен бірге болғаным қызықты болды. →
Dialogue: 0,0:11:46.39,0:11:48.41,Default,,0000,0000,0000,,Му~! 》
Dialogue: 0,0:11:48.41,0:11:54.47,Default,,0000,0000,0000,,Джоза, сен не ойлап тұрсың?
Dialogue: 0,0:11:54.47,0:11:57.50,Default,,0000,0000,0000,,《Му~! 》
Dialogue: 0,0:11:57.50,0:12:00.53,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:12:00.53,0:12:06.92,Default,,0000,0000,0000,,《Қош болыңыз, Аспан мырза. Өтінемін, өлме! 》
Dialogue: 0,0:12:06.92,0:12:10.92,Default,,0000,0000,0000,,Тоқта! Gyoza!!
Dialogue: 0,0:12:13.99,0:12:18.99,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:12:22.08,0:12:25.08,Default,,0000,0000,0000,,《Хахахаха》
Dialogue: 0,0:12:27.13,0:12:31.13,Default,,0000,0000,0000,,《Он-сан! 》
Dialogue: 0,0:12:35.21,0:12:37.23,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:12:37.23,0:12:45.31,Default,,0000,0000,0000,,Гёза! Coo!
Dialogue: 0,0:12:45.31,0:12:49.35,Default,,0000,0000,0000,,Өзін-өзі жою және сауда жасау түбегейлі іс болар еді.
Dialogue: 0,0:12:49.35,0:12:52.35,Default,,0000,0000,0000,,Бұл кішкентай жігітке жақсы жұмыс.
Dialogue: 0,0:12:58.44,0:13:03.49,Default,,0000,0000,0000,,Кукукукуку…. →
Dialogue: 0,0:13:03.49,0:13:09.89,Default,,0000,0000,0000,,Сендер, үндемеңдер!➡
Dialogue: 0,0:13:09.89,0:13:12.92,Default,,0000,0000,0000,,Ақымақ нәрсе жасаңыз.
Dialogue: 0,0:13:12.92,0:13:18.98,Default,,0000,0000,0000,,Мен-сенбеймін сенің мұның жақсы екеніне...Н-жасырын! →
Dialogue: 0,0:13:18.98,0:13:23.03,Default,,0000,0000,0000,,Мен ол үшін өмірімді қатерге тігіп қойдым.
Dialogue: 0,0:13:23.03,0:13:29.09,Default,,0000,0000,0000,,Қарғыс атсын... Айдаһар доптары Джозаны тағы да тірілтті.
Dialogue: 0,0:13:29.09,0:13:32.12,Default,,0000,0000,0000,,Сіз ешқашан өмірге қайта орала алмайсыз!
Dialogue: 0,0:13:32.12,0:13:37.17,Default,,0000,0000,0000,,Қарғыс атсын! Мүлдем кешір мені!
Dialogue: 0,0:13:37.17,0:13:40.20,Default,,0000,0000,0000,,Хехехехе.
Dialogue: 0,0:13:40.20,0:13:45.25,Default,,0000,0000,0000,,Біздің қаншалықты қорқынышты екенімізді әлі түсінбеген сияқтысыз. →
Dialogue: 0,0:13:45.25,0:13:49.25,Default,,0000,0000,0000,,Сізде бар нәрсе - өлім!
Dialogue: 0,0:15:03.36,0:15:08.41,Default,,0000,0000,0000,,Хахахаха.
Dialogue: 0,0:15:08.41,0:15:11.44,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:15:11.44,0:15:14.47,Default,,0000,0000,0000,,Мен мүлде жауап берген жоқпын.
Dialogue: 0,0:15:14.47,0:15:18.51,Default,,0000,0000,0000,,Бұл мені гиоза туралы ойланбайды.
Dialogue: 0,0:15:18.51,0:15:23.56,Default,,0000,0000,0000,,Хахахаха.
Dialogue: 0,0:15:23.56,0:15:25.58,Default,,0000,0000,0000,,Гёза!
Dialogue: 0,0:15:25.58,0:15:30.63,Default,,0000,0000,0000,,Хахаха жақын арада о дүниеде кездесемін. Рақмет сізге.
Dialogue: 0,0:15:30.63,0:15:33.66,Default,,0000,0000,0000,,Хахаха!
Dialogue: 0,0:15:33.66,0:15:37.70,Default,,0000,0000,0000,,Қарғыс атсын... Иә, мен сені кешіре алмаймын.
Dialogue: 0,0:15:37.70,0:15:41.74,Default,,0000,0000,0000,,Мен сені ешқашан кешірмеймін! →
Dialogue: 0,0:15:41.74,0:15:44.77,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:15:44.77,0:15:57.06,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:15:57.06,0:15:59.25,Default,,0000,0000,0000,,Гуо!
Dialogue: 0,0:15:59.25,0:16:06.32,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:16:06.32,0:16:10.36,Default,,0000,0000,0000,,Осы қарқынмен Теншинхан да жеңіледі.
Dialogue: 0,0:16:10.36,0:16:13.39,Default,,0000,0000,0000,,Біз бірдеңе істеуіміз керек!
Dialogue: 0,0:16:13.39,0:16:15.41,Default,,0000,0000,0000,,Тоқта!
Dialogue: 0,0:16:15.41,0:16:19.45,Default,,0000,0000,0000,,Ол шабуылға көшеді. Бір сәтте ол дайын. →
Dialogue: 0,0:16:19.45,0:16:22.48,Default,,0000,0000,0000,,Сол сәтті мақсат етіңіз.
Dialogue: 0,0:16:22.48,0:16:24.50,Default,,0000,0000,0000,,Жақсы, Гохан.
Dialogue: 0,0:16:24.50,0:16:26.52,Default,,0000,0000,0000,,Ах... Ай.
Dialogue: 0,0:16:26.52,0:16:31.57,Default,,0000,0000,0000,,Бұл жақсы стратегия. Сізге сәттілік тілеймін.
Dialogue: 0,0:16:31.57,0:16:36.62,Default,,0000,0000,0000,,Қарау дұрыс па? Мүмкіндігіңізден айырыласыз.
Dialogue: 0,0:16:36.62,0:16:38.64,Default,,0000,0000,0000,,Иә, бұл жеткілікті.
Dialogue: 0,0:16:38.64,0:16:41.67,Default,,0000,0000,0000,,Бірақ осылайша сен ақымақ бола аласың →
Dialogue: 0,0:16:41.67,0:16:44.70,Default,,0000,0000,0000,,Сон Гоку келгенше.
Dialogue: 0,0:16:44.70,0:16:49.75,Default,,0000,0000,0000,,Бұл кім? Ол жағына қойылған ба?
Dialogue: 0,0:16:49.75,0:16:52.78,Default,,0000,0000,0000,,Хехехехе асыға күтіңіздер.
Dialogue: 0,0:16:52.78,0:16:54.78,Default,,0000,0000,0000,,Ха~!
Dialogue: 0,0:17:01.20,0:17:07.20,Default,,0000,0000,0000,,Дәл солай сияқты. Жақында мен сізге жеңілдетемін.
Dialogue: 0,0:17:12.31,0:17:16.35,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:17:16.35,0:17:19.38,Default,,0000,0000,0000,,Блять!
Dialogue: 0,0:17:19.38,0:17:21.40,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:17:21.40,0:17:24.43,Default,,0000,0000,0000,,Енді, тараңдар! Криллин! Гохан!
Dialogue: 0,0:17:24.43,0:17:27.46,Default,,0000,0000,0000,,О! Ах...
Dialogue: 0,0:17:27.46,0:17:31.50,Default,,0000,0000,0000,,Бітір, өл! (Тяньшин асы) Ух...
Dialogue: 0,0:17:31.50,0:17:34.53,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:17:34.53,0:17:37.56,Default,,0000,0000,0000,,Не!? Ха!
Dialogue: 0,0:17:37.56,0:17:39.58,Default,,0000,0000,0000,,Хаа~! Гуха!
Dialogue: 0,0:17:39.58,0:17:41.60,Default,,0000,0000,0000,,Гохан, қазір ат!
Dialogue: 0,0:17:41.60,0:17:45.64,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:17:45.64,0:17:47.66,Default,,0000,0000,0000,,Гохан!
Dialogue: 0,0:17:47.66,0:17:50.69,Default,,0000,0000,0000,,Дайын бол!
Dialogue: 0,0:17:50.69,0:17:53.72,Default,,0000,0000,0000,,Бұл қорқынышты.
Dialogue: 0,0:17:53.72,0:17:56.72,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:18:00.13,0:18:02.15,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:18:02.15,0:18:04.17,Default,,0000,0000,0000,,Иә! Апыр-ай!
Dialogue: 0,0:18:04.17,0:18:08.21,Default,,0000,0000,0000,,Қарғыс атқыр бала! Жоқ!
Dialogue: 0,0:18:08.21,0:18:11.21,Default,,0000,0000,0000,,Ха~! Хаа~!
Dialogue: 0,0:18:18.31,0:18:23.36,Default,,0000,0000,0000,,Жойылған! Уақыт өте баяу болды.
Dialogue: 0,0:18:23.36,0:18:28.41,Default,,0000,0000,0000,,Менің өмірімді одан да қысқарттың. →
Dialogue: 0,0:18:28.41,0:18:34.47,Default,,0000,0000,0000,,Жарайды, мен оларды өлтіру ретін өзгертуді шештім.
Dialogue: 0,0:18:34.47,0:18:36.49,Default,,0000,0000,0000,,Өзіңізді дайындаңыз!
Dialogue: 0,0:18:36.49,0:18:42.55,Default,,0000,0000,0000,,Кешіріңіз, Пикколоның ағасы.
Dialogue: 0,0:18:42.55,0:18:45.58,Default,,0000,0000,0000,,Не болды, Құдай?
Dialogue: 0,0:18:45.58,0:18:50.63,Default,,0000,0000,0000,,Хм, менің өмір сүру уақытым нөмірленген сияқты. →
Dialogue: 0,0:18:50.63,0:18:54.67,Default,,0000,0000,0000,,Өлім... ажал жақындап қалды.
Dialogue: 0,0:18:54.67,0:18:58.04,Default,,0000,0000,0000,,Яғни...
Dialogue: 0,0:18:58.04,0:19:00.06,Default,,0000,0000,0000,,Пикколо өлтірілді. Ха!
Dialogue: 0,0:19:00.06,0:19:03.09,Default,,0000,0000,0000,,Және бәрі де.
Dialogue: 0,0:19:03.09,0:19:05.11,Default,,0000,0000,0000,,Гоку?
Dialogue: 0,0:19:05.11,0:19:09.15,Default,,0000,0000,0000,,Хмм, мен әлі қатысуды сезе алмаймын.
Dialogue: 0,0:19:09.15,0:19:11.15,Default,,0000,0000,0000,,Гоку, асығыңыз!
Dialogue: 0,0:19:13.19,0:19:16.22,Default,,0000,0000,0000,,Chat gyoza….
Dialogue: 0,0:19:16.22,0:19:18.24,Default,,0000,0000,0000,,Кух…. →
Dialogue: 0,0:19:18.24,0:19:22.28,Default,,0000,0000,0000,,Бірге соғыссақ та... →
Dialogue: 0,0:19:22.28,0:19:25.31,Default,,0000,0000,0000,,Мен өмірге қайта келе алмаймын.
Dialogue: 0,0:19:25.31,0:19:29.35,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:19:29.35,0:19:33.39,Default,,0000,0000,0000,,《Тен-сан, кешіріңіз.》
Dialogue: 0,0:19:33.39,0:19:35.41,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:19:35.41,0:19:40.46,Default,,0000,0000,0000,,Жақсы... gyoza!
Dialogue: 0,0:19:40.46,0:19:45.51,Default,,0000,0000,0000,,Хе-хэ-хэ, мені ренжіткен ақымақтар.
Dialogue: 0,0:19:45.51,0:19:47.53,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:19:47.53,0:19:50.56,Default,,0000,0000,0000,,Енді қайсысымен бірінші ойнауым керек? →
Dialogue: 0,0:19:50.56,0:19:53.59,Default,,0000,0000,0000,,Тек сол Намекиялықтар →
Dialogue: 0,0:19:53.59,0:19:56.62,Default,,0000,0000,0000,,Мен сені жәндіктің тынысындай тірі қалдырамын.
Dialogue: 0,0:19:56.62,0:20:00.62,Default,,0000,0000,0000,,Менен Dragon Ball туралы көбірек сұраңыз.
Dialogue: 0,0:20:02.01,0:20:07.06,Default,,0000,0000,0000,,Гиоза Мен жауды өлтіремін. Ал мен де барамын. →
Dialogue: 0,0:20:07.06,0:20:10.09,Default,,0000,0000,0000,,Мен сені жалғыз сезінуге жол бермеймін.
Dialogue: 0,0:20:10.09,0:20:15.14,Default,,0000,0000,0000,,Бұл... бұл менің соңғы... →
Dialogue: 0,0:20:15.14,0:20:18.17,Default,,0000,0000,0000,,Ах~!
Dialogue: 0,0:20:18.17,0:20:23.17,Default,,0000,0000,0000,,Бұл цигон зеңбірегі!
Dialogue: 0,0:20:27.26,0:20:30.29,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:20:30.29,0:20:32.29,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:20:34.33,0:20:37.36,Default,,0000,0000,0000,,О.
Dialogue: 0,0:20:37.36,0:20:39.36,Default,,0000,0000,0000,,О, сен істедің!
Dialogue: 0,0:20:45.44,0:20:49.44,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:20:56.55,0:21:01.93,Default,,0000,0000,0000,,Ху~ Сен мені қорқытып тұрсың.
Dialogue: 0,0:21:01.93,0:21:04.96,Default,,0000,0000,0000,,Мен оны мүлдем түсінбеймін.
Dialogue: 0,0:21:04.96,0:21:07.99,Default,,0000,0000,0000,,Құбыжық, сен өлмейтінсің бе!?
Dialogue: 0,0:21:07.99,0:21:09.01,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:21:09.01,0:21:12.01,Default,,0000,0000,0000,,Хмм, өкінішті.
Dialogue: 0,0:21:18.10,0:21:23.15,Default,,0000,0000,0000,,Ах, а...
Dialogue: 0,0:21:23.15,0:21:25.17,Default,,0000,0000,0000,,Хехе, ақымақ.
Dialogue: 0,0:21:25.17,0:21:30.22,Default,,0000,0000,0000,,Тыныш болып, ұйықтауым керек еді, бірақ бар күш-қуатымды жұмсап, өмірімді босқа өткіздім.
Dialogue: 0,0:21:30.22,0:21:34.26,Default,,0000,0000,0000,,Дұрыс, тіпті Теншинхан да...
Dialogue: 0,0:21:34.26,0:21:41.33,Default,,0000,0000,0000,,Хиди: Бұл сұмдық, бәрі бірінен соң бірі өліп жатыр.
Dialogue: 0,0:21:41.33,0:21:45.37,Default,,0000,0000,0000,,Гоку~! Өтінемін тез кел! →
Dialogue: 0,0:21:45.37,0:21:48.40,Default,,0000,0000,0000,,Гоку~!
Dialogue: 0,0:21:48.40,0:21:52.44,Default,,0000,0000,0000,,《Асығыңыз... Асығыңыз! 》
Dialogue: 0,0:21:52.44,0:21:57.66,Default,,0000,0000,0000,,Гоку? Дәл қазір не болды...
Dialogue: 0,0:21:57.66,0:22:00.86,Default,,0000,0000,0000,,Иә? Күте тұрыңыз.
Dialogue: 0,0:22:00.86,0:22:04.90,Default,,0000,0000,0000,,Хахахаха. Тағы бір адам тазаланды. →
Dialogue: 0,0:22:04.90,0:22:07.93,Default,,0000,0000,0000,,Енді сіздің кезегіңіз.
Dialogue: 0,0:22:07.93,0:22:09.95,Default,,0000,0000,0000,,Жерге түсіп, ұрысайық. →
Dialogue: 0,0:22:09.95,0:22:13.99,Default,,0000,0000,0000,,Ол әуедегі ұрыста әлдеқайда жоғары.
Dialogue: 0,0:22:13.99,0:22:17.03,Default,,0000,0000,0000,,Хахахаха. Бұл кез келген жағдайда бірдей нәрсе. →
Dialogue: 0,0:22:17.03,0:22:20.03,Default,,0000,0000,0000,,Ағаке Ағаке.
Dialogue: 0,0:22:22.08,0:22:25.11,Default,,0000,0000,0000,,Кеттік! Уау, осында!
Dialogue: 0,0:22:25.11,0:22:27.13,Default,,0000,0000,0000,,Әке!
Dialogue: 0,0:22:27.13,0:22:30.13,Default,,0000,0000,0000,,Наппа күтіңіз!
Dialogue: 0,0:22:33.19,0:22:36.22,Default,,0000,0000,0000,,Не? Неге маған мұны істеуге рұқсат бермейсің?
Dialogue: 0,0:22:36.22,0:22:40.26,Default,,0000,0000,0000,,Дүрбелеңге салынбаңыз. Мен олардан бір нәрсе сұрағым келеді. →
Dialogue: 0,0:22:40.26,0:22:44.30,Default,,0000,0000,0000,,Сон Гоку дегенде Какарот дейсіз бе?
Dialogue: 0,0:22:44.30,0:22:46.32,Default,,0000,0000,0000,,Иә. Сонымен не!
Dialogue: 0,0:22:46.32,0:22:49.35,Default,,0000,0000,0000,,Хахахаха!
Dialogue: 0,0:22:49.35,0:22:52.38,Default,,0000,0000,0000,,Менің арқа сүйейтін адамым – Какарот. →
Dialogue: 0,0:22:52.38,0:22:54.40,Default,,0000,0000,0000,,Тіпті Радиц шыдай алмады→
Dialogue: 0,0:22:54.40,0:22:57.09,Default,,0000,0000,0000,,Ол келсе не пайда?
Dialogue: 0,0:22:57.09,0:22:59.78,Default,,0000,0000,0000,,Өткен жолғыдан өзгеше. →
Dialogue: 0,0:22:59.78,0:23:02.81,Default,,0000,0000,0000,,Ол барған сайын күшейіп келеді!
Dialogue: 0,0:23:02.81,0:23:05.84,Default,,0000,0000,0000,,Балалар, Сон Гокуды бағаламаңдар.
Dialogue: 0,0:23:05.84,0:23:08.87,Default,,0000,0000,0000,,Нухахахаха.
Dialogue: 0,0:23:08.87,0:23:11.90,Default,,0000,0000,0000,,Сіз бұл үшін мүлдем келмейсіз.
Dialogue: 0,0:23:11.90,0:23:14.93,Default,,0000,0000,0000,,Сіз қорқып қашып кетпедіңіз бе?
Dialogue: 0,0:23:14.93,0:23:18.97,Default,,0000,0000,0000,,Келіңіздер! Әкем міндетті түрде келеді!
Dialogue: 0,0:23:18.97,0:23:21.00,Default,,0000,0000,0000,,Біз сендерге қамқор боламыз, балалар!
Dialogue: 0,0:23:21.00,0:23:25.04,Default,,0000,0000,0000,,Бұл үлкен сенім. Фуфуфу қызық.
Dialogue: 0,0:23:25.04,0:23:27.06,Default,,0000,0000,0000,,Мен ол келгенше күтемін.
Dialogue: 0,0:23:27.06,0:23:31.10,Default,,0000,0000,0000,,Сіз қалжыңдап тұрсыз ба? Мына жігіттерден тез арылайық.
Dialogue: 0,0:23:31.10,0:23:36.15,Default,,0000,0000,0000,,Алайда ол тек 3 сағатқа ғана. Мен бұдан былай күтпеймін.
Dialogue: 0,0:23:36.15,0:23:40.19,Default,,0000,0000,0000,,Бұл күлкілі, мен қазір ойнаймын! Хаа~!
Dialogue: 0,0:23:40.19,0:23:45.24,Default,,0000,0000,0000,,Наппа! Менің айтқанымды естімей тұрсың ба?
Dialogue: 0,0:23:45.24,0:23:49.28,Default,,0000,0000,0000,,Кешіріңіз. Мен жай ғана көңілімнен шықты.
Dialogue: 0,0:23:49.28,0:23:51.30,Default,,0000,0000,0000,,Осымен.
Dialogue: 0,0:23:51.30,0:23:54.30,Default,,0000,0000,0000,,Менің ғұмырым сәл ұзарды. Шүкір етіңіз.
Dialogue: 0,0:24:03.75,0:24:08.80,Default,,0000,0000,0000,,Хмм, бұл мүмкін емес. Бұл менің алғашқы нақты шайқасым.
Dialogue: 0,0:24:08.80,0:24:12.84,Default,,0000,0000,0000,,Хун. Сізден үлкен үміт күту мен үшін аянышты. →
Dialogue: 0,0:24:12.84,0:24:14.84,Default,,0000,0000,0000,,Қорқақтар жоғалады.
Dialogue: 0,0:24:16.88,0:24:20.92,Default,,0000,0000,0000,,《Олай болса да, әлгі үлкен жігіт қазір менен қорқады. →
Dialogue: 0,0:24:20.92,0:24:22.94,Default,,0000,0000,0000,,Вегета деген кішкентай жігіт →
Dialogue: 0,0:24:22.94,0:24:26.98,Default,,0000,0000,0000,,Сіз бұл одан да керемет күш деп айтасыз ба? 》
Dialogue: 0,0:24:26.98,0:24:30.02,Default,,0000,0000,0000,,Қышпаңыз. Мен бұдан былай күте алмаймын.
Dialogue: 0,0:24:30.02,0:24:33.05,Default,,0000,0000,0000,,Ал, күте тұрыңыз. Үш сағат қалды.
Dialogue: 0,0:24:33.05,0:24:37.09,Default,,0000,0000,0000,,Үш сағат күтсең, тозақтық шоу көресің.
Dialogue: 0,0:24:37.09,0:24:43.09,Default,,0000,0000,0000,,<Ұрыс қайта басталғанша 3 сағатқа уақытында жетеміз бе!? Гоку>
Dialogue: 0,0:24:46.18,0:24:51.23,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:51.23,0:25:11.43,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:11.43,0:25:31.63,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:31.63,0:25:43.63,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:48.80,0:25:52.84,Default,,0000,0000,0000,,Сәлем, Гоку. Жарайды, біз жылан жолының соңына жеттік.
Dialogue: 0,0:25:52.84,0:25:54.86,Default,,0000,0000,0000,,Біз жақындап қалдық.
Dialogue: 0,0:25:54.86,0:25:56.88,Default,,0000,0000,0000,,Бірақ бұл қазірдің өзінде шегінде. →
Dialogue: 0,0:25:56.88,0:25:59.24,Default,,0000,0000,0000,,Гоку келгенше шыдаудан басқа амалымыз жоқ.
Dialogue: 0,0:25:59.24,0:26:03.28,Default,,0000,0000,0000,,Әй, мен әкемнің рухын сеземін. Ол ақыры келді.
Dialogue: 0,0:26:03.28,0:26:06.28,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»
Dialogue: 0,0:26:10.35,0:26:13.35,Default,,0000,0000,0000,,Пиппи Пикколо-сан, неге?
Dialogue: 0,0:26:14.85,0:26:20.85,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory