Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.85,0:00:14.87,Default,,0000,0000,0000,,<Жаңа Айдаһар допты іздеу→
Dialogue: 0,0:00:14.87,0:00:19.92,Default,,0000,0000,0000,,Гохан мен оның достары Намек планетасына келеді. →
Dialogue: 0,0:00:19.92,0:00:26.92,Default,,0000,0000,0000,,Дегенмен, сонымен бірге Вегета да Namek планетасына оралды
Dialogue: 0,0:00:28.01,0:00:34.01,Default,,0000,0000,0000,,<Одан да күшті жау күтіп тұрды.>
Dialogue: 0,0:00:37.10,0:00:42.15,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:42.15,0:01:02.35,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:02.35,0:01:22.88,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:22.88,0:01:42.08,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:42.08,0:01:59.08,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:26.72,0:04:29.75,Default,,0000,0000,0000,,Енді үшеуі ғана қалды. →
Dialogue: 0,0:04:29.75,0:04:32.78,Default,,0000,0000,0000,,Хехехехе….
Dialogue: 0,0:04:32.78,0:04:34.80,Default,,0000,0000,0000,,Хи хи хи.
Dialogue: 0,0:04:34.80,0:04:37.83,Default,,0000,0000,0000,,Өзіңді күт, Додориа-сан.
Dialogue: 0,0:04:37.83,0:04:41.87,Default,,0000,0000,0000,,Вегета да оларды нысанаға алған сияқты.
Dialogue: 0,0:04:41.87,0:04:44.90,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:44.90,0:04:47.93,Default,,0000,0000,0000,,Фриза-сама дәл қазір→
Dialogue: 0,0:04:47.93,0:04:50.96,Default,,0000,0000,0000,,Куи Вегетаның артынан келді.
Dialogue: 0,0:04:50.96,0:04:55.01,Default,,0000,0000,0000,,Сонда біраз бұрын пайда болған екі ұлы державаның реакциялары → болады
Dialogue: 0,0:04:55.01,0:04:59.05,Default,,0000,0000,0000,,Ол кенет жоғалып кетті.
Dialogue: 0,0:04:59.05,0:05:02.08,Default,,0000,0000,0000,,Біз реакция болған жерді → іздейміз
Dialogue: 0,0:05:02.08,0:05:05.11,Default,,0000,0000,0000,,Біз жақын арада шынайы тұлғаны анықтай алуымыз керек.
Dialogue: 0,0:05:05.11,0:05:11.34,Default,,0000,0000,0000,,Мәселе маған қарсы шыққан Вегетамен не істеуде.
Dialogue: 0,0:05:11.34,0:05:13.52,Default,,0000,0000,0000,,Олай болса, уайымдамаңыз. →
Dialogue: 0,0:05:13.52,0:05:17.56,Default,,0000,0000,0000,,Куи Вегетаға күтім жасау үшін тікелей баруы керек. →
Dialogue: 0,0:05:17.56,0:05:20.59,Default,,0000,0000,0000,,Басында бұл екеуі бір-бірін жек көретін→
Dialogue: 0,0:05:20.59,0:05:22.61,Default,,0000,0000,0000,,Олардың қабілеттері дерлік тең болуы керек →
Dialogue: 0,0:05:22.61,0:05:26.61,Default,,0000,0000,0000,,Қалай болғанда да, Вегета онымен тегін құтыла алмайды.
Dialogue: 0,0:05:28.67,0:05:31.70,Default,,0000,0000,0000,,Вегета Оның қашып кетуіне жол берме. →
Dialogue: 0,0:05:31.70,0:05:34.73,Default,,0000,0000,0000,,Хе хе хе хе хе.
Dialogue: 0,0:05:34.73,0:05:38.77,Default,,0000,0000,0000,,Мен оны Вегета деп таптым, бұл Фриеза-саманың бұйрығы.
Dialogue: 0,0:05:38.77,0:05:40.79,Default,,0000,0000,0000,,Сіз мені естисіз бе, Вегета?
Dialogue: 0,0:05:40.79,0:05:43.82,Default,,0000,0000,0000,,Енді мен сені ашық түрде өлтіре аламын.
Dialogue: 0,0:05:43.82,0:05:47.86,Default,,0000,0000,0000,,Күлдірме мені, шіркін. Мен сені өлтіре аламын деп ойлайсың ба?
Dialogue: 0,0:05:47.86,0:05:50.89,Default,,0000,0000,0000,,Мен сені күтемін, тез кел.
Dialogue: 0,0:05:50.89,0:05:53.92,Default,,0000,0000,0000,,Хахахаха! Көздеріңіз саңылаусыз ба? →
Dialogue: 0,0:05:53.92,0:05:55.94,Default,,0000,0000,0000,,Скутерге мұқият қараңыз. →
Dialogue: 0,0:05:55.94,0:06:00.99,Default,,0000,0000,0000,,Менің жауынгерлік күшім сенен жоғары екені анық.
Dialogue: 0,0:06:00.99,0:06:02.99,Default,,0000,0000,0000,,Хун.
Dialogue: 0,0:06:04.03,0:06:07.06,Default,,0000,0000,0000,,Қалай болғанда да, мен мұны істей алмаймын.
Dialogue: 0,0:06:07.06,0:06:11.06,Default,,0000,0000,0000,,Балалар мен сендерге Айдаһар шарларын қалдырдым.
Dialogue: 0,0:06:13.45,0:06:17.49,Default,,0000,0000,0000,,Жарайды, мен Жерге қайтамын, сондықтан бар күшіңді сал.
Dialogue: 0,0:06:17.49,0:06:19.51,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:19.51,0:06:23.51,Default,,0000,0000,0000,,Криллин мырза, біреу келе жатыр! Ээ~!?
Dialogue: 0,0:06:27.59,0:06:30.62,Default,,0000,0000,0000,,Реакция осы жерде тоқтаған болуы керек.
Dialogue: 0,0:06:30.62,0:06:32.64,Default,,0000,0000,0000,,Намекиан болса керек.
Dialogue: 0,0:06:32.64,0:06:37.69,Default,,0000,0000,0000,,Сіз кімсіз? Намектен шығар.
Dialogue: 0,0:06:37.69,0:06:39.71,Default,,0000,0000,0000,,Ә!? Е!?
Dialogue: 0,0:06:39.71,0:06:41.73,Default,,0000,0000,0000,,Мен Намекиан емеспін.
Dialogue: 0,0:06:41.73,0:06:43.75,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:43.75,0:06:46.78,Default,,0000,0000,0000,,Не? Иә.
Dialogue: 0,0:06:46.78,0:06:50.82,Default,,0000,0000,0000,,Ол Намекиан емес. Сен кімсің?
Dialogue: 0,0:06:50.82,0:06:53.85,Default,,0000,0000,0000,,Хэ-хэ-хэ-оған бәрібір.
Dialogue: 0,0:06:53.85,0:06:58.90,Default,,0000,0000,0000,,Қалай болғанда да, бұйрық бұл планетадағы барлық адамдарды өлтіру.
Dialogue: 0,0:06:58.90,0:07:01.93,Default,,0000,0000,0000,,Хехехехе.
Dialogue: 0,0:07:01.93,0:07:03.95,Default,,0000,0000,0000,,Мына көрініске қараңыз.
Dialogue: 0,0:07:03.95,0:07:05.97,Default,,0000,0000,0000,,Сайяндардың кигеніне ұқсайды.
Dialogue: 0,0:07:05.97,0:07:07.99,Default,,0000,0000,0000,,Бірақ ол Сайян емес.
Dialogue: 0,0:07:07.99,0:07:09.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:07:09.01,0:07:11.20,Default,,0000,0000,0000,,Мен бұл нені білдіретінін білмеймін.→
Dialogue: 0,0:07:11.20,0:07:13.39,Default,,0000,0000,0000,,Менде жағымсыз сезім бар.
Dialogue: 0,0:07:13.39,0:07:17.43,Default,,0000,0000,0000,,Иә, дұрыс.Қалай қарасаң да, дос болғың келмейтін сияқты.
Dialogue: 0,0:07:17.43,0:07:22.48,Default,,0000,0000,0000,,Гохан Өзіңіздің қатысуыңызды өлтіре отырып, энергияңызды үнемдеңіз.
Dialogue: 0,0:07:22.48,0:07:25.51,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:07:25.51,0:07:28.54,Default,,0000,0000,0000,,Ха~хахахаха Мына жігіттерді көрдіңіз бе?
Dialogue: 0,0:07:28.54,0:07:33.59,Default,,0000,0000,0000,,Сіздің жауынгерлік күшіңіздің барлығы дерлік қоқыс. Сіз жай туристсіз бе?
Dialogue: 0,0:07:33.59,0:07:35.61,Default,,0000,0000,0000,,Хехе, қашсаң қызық кетеді. →
Dialogue: 0,0:07:35.61,0:07:37.63,Default,,0000,0000,0000,,Әзірше сол ғарыш кемесін орындаңыз.
Dialogue: 0,0:07:37.63,0:07:40.66,Default,,0000,0000,0000,,Мен музыка колледжінде Саки Аримамен бір курс болғанмын, сондықтан→
Dialogue: 0,0:07:40.66,0:07:42.66,Default,,0000,0000,0000,,Уау!? Эй!
Dialogue: 0,0:07:44.70,0:07:47.73,Default,,0000,0000,0000,,Жоқ! Ғарыш кемесі!
Dialogue: 0,0:07:47.73,0:07:49.75,Default,,0000,0000,0000,,Сәтсіздік.
Dialogue: 0,0:07:49.75,0:07:51.77,Default,,0000,0000,0000,,Мен мұндай уақытта мұндай жерге келемін деп ойламадым.
Dialogue: 0,0:07:51.77,0:07:54.80,Default,,0000,0000,0000,,Гохан Энергияңызды босатыңыз.
Dialogue: 0,0:07:54.80,0:07:57.83,Default,,0000,0000,0000,,Бұл жігіттер соншалықты үлкен мәміле емес. Иә.
Dialogue: 0,0:07:57.83,0:07:59.85,Default,,0000,0000,0000,,Эй, сен мұны естідің бе?
Dialogue: 0,0:07:59.85,0:08:02.88,Default,,0000,0000,0000,,Біз соншалықты үлкен мәміле емеспіз дегенде, бізді айтасыз ба?
Dialogue: 0,0:08:02.88,0:08:04.90,Default,,0000,0000,0000,,О? →
Dialogue: 0,0:08:04.90,0:08:06.92,Default,,0000,0000,0000,,Хахахаха!
Dialogue: 0,0:08:06.92,0:08:08.94,Default,,0000,0000,0000,,Хехехехе.
Dialogue: 0,0:08:08.94,0:08:10.96,Default,,0000,0000,0000,,Ха~хахахаха... Иә?
Dialogue: 0,0:08:10.96,0:08:13.32,Default,,0000,0000,0000,,Не? Бұл жауынгерлік күштің құндылығы қандай?
Dialogue: 0,0:08:13.32,0:08:15.32,Default,,0000,0000,0000,,Жасайық! иә!
Dialogue: 0,0:08:17.36,0:08:20.36,Default,,0000,0000,0000,,Тааа! Апыр-ай! Дария!
Dialogue: 0,0:08:23.42,0:08:25.44,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:08:25.44,0:08:28.47,Default,,0000,0000,0000,,Хаха.
Dialogue: 0,0:08:28.47,0:08:31.50,Default,,0000,0000,0000,,Сәлем! Керемет жақсы. Хехе.
Dialogue: 0,0:08:31.50,0:08:37.50,Default,,0000,0000,0000,,Бұл жақсы емес! Ууууууууууууууууууууууу.
Dialogue: 0,0:08:39.58,0:08:41.60,Default,,0000,0000,0000,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:08:41.60,0:08:44.60,Default,,0000,0000,0000,,Біз не істеуіміз керек?
Dialogue: 0,0:08:49.68,0:08:53.72,Default,,0000,0000,0000,,Не болды? Зарбон мырза.
Dialogue: 0,0:08:53.72,0:08:59.78,Default,,0000,0000,0000,,Иә, Фриза-сама. Бұл мәселеге қатысты мен бұрын барлаушымен айналыстым →
Dialogue: 0,0:08:59.78,0:09:02.81,Default,,0000,0000,0000,,Қарапайым адам емес сияқты.
Dialogue: 0,0:09:02.81,0:09:06.85,Default,,0000,0000,0000,,Жауынгерлік күш екі барлаушыны жеңгеннен кейін бірден артады→
Dialogue: 0,0:09:06.85,0:09:09.88,Default,,0000,0000,0000,,Реакция қайтадан жоғалып кетті.
Dialogue: 0,0:09:09.88,0:09:14.26,Default,,0000,0000,0000,,Бұл біртүрлі. Бұл да Вегетаға ұқсамайды.
Dialogue: 0,0:09:14.26,0:09:17.29,Default,,0000,0000,0000,,Иә, менің реакциям Вегетадан басқаша. →
Dialogue: 0,0:09:17.29,0:09:20.32,Default,,0000,0000,0000,,Екеуінің де жауынгерлік күші шамамен 1500 болды.
Dialogue: 0,0:09:20.32,0:09:25.37,Default,,0000,0000,0000,,1500? Оны жалғыз қалдырудың еш айыбы жоқ →
Dialogue: 0,0:09:25.37,0:09:28.40,Default,,0000,0000,0000,,Сіздің көзқарасыңыз жақсы емес сияқты.
Dialogue: 0,0:09:28.40,0:09:31.40,Default,,0000,0000,0000,,Келесі жолы оны тапқанда жойыңыз.
Dialogue: 0,0:09:37.49,0:09:43.55,Default,,0000,0000,0000,,Артық емес, бітті. Мен ешқашан Жерге қайта орала алмаймын.
Dialogue: 0,0:09:43.55,0:09:46.58,Default,,0000,0000,0000,,Бұлма-сан, әзірше осы жерден кетейік. →
Dialogue: 0,0:09:46.58,0:09:50.62,Default,,0000,0000,0000,,Бұл қауіпті. Мүмкін одан да күштісі келеді.
Dialogue: 0,0:09:50.62,0:09:54.66,Default,,0000,0000,0000,,Дұрыс. Мен қатты сезінген сезім Намекяннан емес→
Dialogue: 0,0:09:54.66,0:09:58.70,Default,,0000,0000,0000,,Олар Вегетаның достарына ұқсайды, сондықтан алдымен бір жерге тығылуымыз керек.
Dialogue: 0,0:09:58.70,0:10:01.73,Default,,0000,0000,0000,,Ву-и…. Бұл қалай болады.
Dialogue: 0,0:10:01.73,0:10:05.77,Default,,0000,0000,0000,,Намекиандықтардың ғарыш кемесін жөндейтініне сенімдімін.
Dialogue: 0,0:10:05.77,0:10:08.80,Default,,0000,0000,0000,,Жақсы, мен оптимистпін.
Dialogue: 0,0:10:08.80,0:10:11.00,Default,,0000,0000,0000,,Қандай әдемі бауырлық байланыс! Қалай әсерлі.
Dialogue: 0,0:10:11.00,0:10:13.00,Default,,0000,0000,0000,,Булма-сан….
Dialogue: 0,0:10:16.22,0:10:20.26,Default,,0000,0000,0000,,Хмф, ақыры келдіңіз бе? Баяу апа.
Dialogue: 0,0:10:20.26,0:10:24.30,Default,,0000,0000,0000,,Кю~и~! (Вегета) Иә?
Dialogue: 0,0:10:24.30,0:10:27.30,Default,,0000,0000,0000,,Куя! (жарылыс дыбысы)
Dialogue: 0,0:10:31.37,0:10:34.40,Default,,0000,0000,0000,,Соңында қарсыластар→
Dialogue: 0,0:10:34.40,0:10:37.43,Default,,0000,0000,0000,,Істі реттейтін кез келген сияқты.
Dialogue: 0,0:10:37.43,0:10:40.46,Default,,0000,0000,0000,,Бірақ қолым түсіп қалды. →
Dialogue: 0,0:10:40.46,0:10:45.51,Default,,0000,0000,0000,,Осындай жауынгерлік күшпен сізде жеңу мүмкіндігі жоқ.
Dialogue: 0,0:10:45.51,0:10:48.54,Default,,0000,0000,0000,,Қарсыластар туралы не деуге болады? Хехехехе.
Dialogue: 0,0:10:48.54,0:10:51.57,Default,,0000,0000,0000,,Олай болса, мен саған жақсы нәрсе көрсетейін.
Dialogue: 0,0:10:51.57,0:10:56.62,Default,,0000,0000,0000,,Мен Жерге барған кезде олардан қызықты нәрсе білдім.
Dialogue: 0,0:10:56.62,0:10:59.65,Default,,0000,0000,0000,,Қашудың жылдамдығы ше?
Dialogue: 0,0:10:59.65,0:11:02.68,Default,,0000,0000,0000,,Жауынгерлік қуатты басқару.
Dialogue: 0,0:11:02.68,0:11:08.74,Default,,0000,0000,0000,,Жауынгерлік билікті бақылау? (Вегета) Ах~.
Dialogue: 0,0:11:08.74,0:11:12.11,Default,,0000,0000,0000,,Скаутер арқылы менің жауынгерлік қуат сандарыма мұқият қараңыз.
Dialogue: 0,0:11:12.11,0:11:18.17,Default,,0000,0000,0000,,Иә? Ақымақ! Бастапқыда сіз бен біз тең болуымыз керек еді.
Dialogue: 0,0:11:18.17,0:11:22.21,Default,,0000,0000,0000,,Сен ақымақ. Мен үнемі нақты шайқастарға қатысып жүрдім.
Dialogue: 0,0:11:22.21,0:11:26.25,Default,,0000,0000,0000,,Бұл жер бетіндегі өлімге жақын шайқас болды. →
Dialogue: 0,0:11:26.25,0:11:28.27,Default,,0000,0000,0000,,Сізбен бірге Фризаның орнында жайлы және жайлы→
Dialogue: 0,0:11:28.27,0:11:31.30,Default,,0000,0000,0000,,Қалай ойлайсың, біз мәңгілікке тең келеміз бе?
Dialogue: 0,0:11:31.30,0:11:33.32,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:11:33.32,0:11:37.36,Default,,0000,0000,0000,,19 000 20 000 21 000 22 000.
Dialogue: 0,0:11:37.36,0:11:39.38,Default,,0000,0000,0000,,Уау! (жарылыс дыбысы)
Dialogue: 0,0:11:39.38,0:11:42.41,Default,,0000,0000,0000,,Ах. ше? Зарбон.
Dialogue: 0,0:11:42.41,0:11:44.43,Default,,0000,0000,0000,,Менің ойымша, бұл ақаулық →
Dialogue: 0,0:11:44.43,0:11:47.46,Default,,0000,0000,0000,,Вегетадағы скаутер жиынтығының мәні →
Dialogue: 0,0:11:47.46,0:11:50.49,Default,,0000,0000,0000,,22 000-нан астам...
Dialogue: 0,0:11:50.49,0:11:53.52,Default,,0000,0000,0000,,22 000? Бұл шынымен ақаулық.
Dialogue: 0,0:11:53.52,0:11:56.55,Default,,0000,0000,0000,,Скаутеріңіз ескі үлгі. →
Dialogue: 0,0:11:56.55,0:11:58.57,Default,,0000,0000,0000,,Мен дұрыс сандарды қарастырамын.
Dialogue: 0,0:11:58.57,0:12:01.60,Default,,0000,0000,0000,,Хмм... О!?
Dialogue: 0,0:12:01.60,0:12:05.64,Default,,0000,0000,0000,,Сандар қандай? Бұл соншалықты ақымақ ...
Dialogue: 0,0:12:05.64,0:12:09.68,Default,,0000,0000,0000,,Менің жаңа үлгісім де бұзылды ма? 24 мыңға дейін жетеді.
Dialogue: 0,0:12:09.68,0:12:11.86,Default,,0000,0000,0000,,24 000 → дегенді білдіреді
Dialogue: 0,0:12:11.86,0:12:15.07,Default,,0000,0000,0000,,Оның жауынгерлік күші біздікінен асып түседі дейсіз бе?
Dialogue: 0,0:12:15.07,0:12:19.11,Default,,0000,0000,0000,,Жоқ, ол жігіттің жауынгерлік күші 18 000-ға әрең жетті.
Dialogue: 0,0:12:19.11,0:12:24.16,Default,,0000,0000,0000,,Хехехехе таң қалмайсың. →
Dialogue: 0,0:12:24.16,0:12:28.20,Default,,0000,0000,0000,,Вегета алдыңғы шепте соғысты.
Dialogue: 0,0:12:28.20,0:12:31.23,Default,,0000,0000,0000,,Ол жер бетінде небір амалдарды үйренген болуы керек.
Dialogue: 0,0:12:31.23,0:12:34.26,Default,,0000,0000,0000,,Бірақ... (Фриза) Бар болғаны 24 000.
Dialogue: 0,0:12:34.26,0:12:37.29,Default,,0000,0000,0000,,Екеуің ұрыссаңдар →
Dialogue: 0,0:12:37.29,0:12:41.33,Default,,0000,0000,0000,,Жеңіске жету үшін бұл жеткілікті емес пе? →
Dialogue: 0,0:12:41.33,0:12:44.33,Default,,0000,0000,0000,,Хехехехе….
Dialogue: 0,0:12:46.38,0:12:49.41,Default,,0000,0000,0000,,Тоқта, Вегета, мен жақсы нәрсе ойладым.
Dialogue: 0,0:12:49.41,0:12:52.44,Default,,0000,0000,0000,,Маған да жасап берейін.
Dialogue: 0,0:12:52.44,0:12:55.47,Default,,0000,0000,0000,,Мен саған көмектесемін. Мен де, Фриза-сама...
Dialogue: 0,0:12:55.47,0:12:58.50,Default,,0000,0000,0000,,Жоқ, мен Фризаны көптен бері ұнатпадым.
Dialogue: 0,0:12:58.50,0:13:01.53,Default,,0000,0000,0000,,Уау! Уау, бұл жаман емес, солай ма?
Dialogue: 0,0:13:01.53,0:13:03.55,Default,,0000,0000,0000,,Міне, сол жауынгерлік күшпен менімен бірге болыңыз→
Dialogue: 0,0:13:03.55,0:13:07.59,Default,,0000,0000,0000,,Менің ойымша, Зарбон мен Додориа мұны шеше алады.
Dialogue: 0,0:13:07.59,0:13:10.62,Default,,0000,0000,0000,,Сіз бір топ ақымақ өтірік айтып жатырсыз. →
Dialogue: 0,0:13:10.62,0:13:13.98,Default,,0000,0000,0000,,Ол әбден тітіркендіргіш бейбақ.
Dialogue: 0,0:13:13.98,0:13:18.03,Default,,0000,0000,0000,,Хехехехехехе Маған сеніңізші, Вегета.
Dialogue: 0,0:13:18.03,0:13:21.06,Default,,0000,0000,0000,,Әй, Фриза-сама! (Вегета) Не!?
Dialogue: 0,0:13:21.06,0:13:23.08,Default,,0000,0000,0000,,Ақымақ! →
Dialogue: 0,0:13:23.08,0:13:27.12,Default,,0000,0000,0000,,Сықырлаған сықырлау~! →
Dialogue: 0,0:13:27.12,0:13:31.16,Default,,0000,0000,0000,,Емдеу~!
Dialogue: 0,0:13:31.16,0:13:33.18,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:13:33.18,0:13:38.23,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:13:38.23,0:13:42.27,Default,,0000,0000,0000,,Иә? Хахахахаха. →
Dialogue: 0,0:13:42.27,0:13:45.27,Default,,0000,0000,0000,,Хахахаха!
Dialogue: 0,0:13:49.34,0:13:52.37,Default,,0000,0000,0000,,Жауынгерлік күшіңіз қаншалықты өссе де→
Dialogue: 0,0:13:52.37,0:13:55.40,Default,,0000,0000,0000,,Менің байқаусызда мұның құрбаны болып қалуым мүмкін емес.
Dialogue: 0,0:13:55.40,0:13:57.42,Default,,0000,0000,0000,,Бұл тәтті. Уф!?
Dialogue: 0,0:13:57.42,0:14:01.46,Default,,0000,0000,0000,,Бұл тіпті сіз үшін аянышты операция болды. →
Dialogue: 0,0:14:01.46,0:14:03.48,Default,,0000,0000,0000,,Мен таң қалдым. Мен білмей тұрып...
Dialogue: 0,0:14:03.48,0:14:06.51,Default,,0000,0000,0000,,Жауынгерлік қуатты арттыру құралдары →
Dialogue: 0,0:14:06.51,0:14:09.54,Default,,0000,0000,0000,,Бұл жылдамдықтың да өскенін білдіреді. Аа….
Dialogue: 0,0:14:09.54,0:14:14.59,Default,,0000,0000,0000,,Басқаша айтқанда, сіз мені дәл қазір ашуландырдыңыз.
Dialogue: 0,0:14:14.59,0:14:17.62,Default,,0000,0000,0000,,Ах... Ах! →
Dialogue: 0,0:14:17.62,0:14:21.66,Default,,0000,0000,0000,,Уу-у... Эй!
Dialogue: 0,0:14:21.66,0:14:25.70,Default,,0000,0000,0000,,Ух... Ха!
Dialogue: 0,0:14:25.70,0:14:28.73,Default,,0000,0000,0000,,Уау! (Вегета) О, жоқ!
Dialogue: 0,0:14:28.73,0:14:31.76,Default,,0000,0000,0000,,Гуах! Ууууу….
Dialogue: 0,0:14:31.76,0:14:33.78,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:14:33.78,0:14:37.82,Default,,0000,0000,0000,,Өлу. Гуа!
Dialogue: 0,0:14:37.82,0:14:40.82,Default,,0000,0000,0000,,Эй, бұл лас отшашулар.
Dialogue: 0,0:15:52.57,0:15:57.62,Default,,0000,0000,0000,,Bet Vegeta-ның 24 000 саны шын мәнінде.
Dialogue: 0,0:15:57.62,0:15:59.64,Default,,0000,0000,0000,,Ол тапсырманы оңай орындады.
Dialogue: 0,0:15:59.64,0:16:01.66,Default,,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,0:16:01.66,0:16:05.66,Default,,0000,0000,0000,,Енді бесінші Айдаһар допты іздейік.
Dialogue: 0,0:16:07.72,0:16:10.75,Default,,0000,0000,0000,,《Барлаушының арқасында менің әрекеттерім мүлде басқаша. →
Dialogue: 0,0:16:10.75,0:16:15.80,Default,,0000,0000,0000,,Сіз оларға абайсызда жақындасаңыз да, Зарбон мен Додория сонда болады→
Dialogue: 0,0:16:15.80,0:16:18.83,Default,,0000,0000,0000,,Күткендей мен Фризаны жеңе алмаймын. →
Dialogue: 0,0:16:18.83,0:16:22.87,Default,,0000,0000,0000,,Фризаның Скуутерден естіген хабарламасына сәйкес →
Dialogue: 0,0:16:22.87,0:16:28.93,Default,,0000,0000,0000,,Айдаһар шарлары 7 дана жинамайынша әсер етпейтін сияқты.
Dialogue: 0,0:16:28.93,0:16:32.97,Default,,0000,0000,0000,,Жарайды, мен тек біреуін табамын.
Dialogue: 0,0:16:32.97,0:16:34.99,Default,,0000,0000,0000,,Қалған алтауын жинағаннан кейін →
Dialogue: 0,0:16:34.99,0:16:38.03,Default,,0000,0000,0000,,Сүйіктісін тауып алып, сенен ұрлап аламын. Хахаха.
Dialogue: 0,0:16:38.03,0:16:41.06,Default,,0000,0000,0000,,《Егер бәрі ойдағыдай болса, мәңгілік өмірге қол жеткізуге болады. →
Dialogue: 0,0:16:41.06,0:16:44.09,Default,,0000,0000,0000,,Мен мұны істесем, Фризаны жеңу арман емес.
Dialogue: 0,0:16:44.09,0:16:48.47,Default,,0000,0000,0000,,Сол жерде 10 шақты Намекиялықтар жауап берді.
Dialogue: 0,0:16:48.47,0:16:50.49,Default,,0000,0000,0000,,Абыройлы музыка мектептерінде бәрі бәсекелестік рейтингтерге және→
Dialogue: 0,0:16:50.49,0:16:54.53,Default,,0000,0000,0000,,Бесінші Айдаһар добы болғаны жақсы. →
Dialogue: 0,0:16:54.53,0:16:56.55,Default,,0000,0000,0000,,Сақтықты төмендетпеңіз.
Dialogue: 0,0:16:56.55,0:17:00.59,Default,,0000,0000,0000,,Вегетадан басқа оғаш адамдар бар сияқты.
Dialogue: 0,0:17:00.59,0:17:03.59,Default,,0000,0000,0000,,Га. (Фриза) Жүр, кеттік.
Dialogue: 0,0:17:06.65,0:17:10.69,Default,,0000,0000,0000,,Ол жоғалып кетсе, мен бірінші боламын.
Dialogue: 0,0:17:10.69,0:17:14.73,Default,,0000,0000,0000,,Бүкіл ғаламды Сайян Вегета басқарады. →
Dialogue: 0,0:17:14.73,0:17:16.73,Default,,0000,0000,0000,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:17:20.79,0:17:22.81,Default,,0000,0000,0000,,Бұлма-сан, сәл тездету керек. →
Dialogue: 0,0:17:22.81,0:17:25.84,Default,,0000,0000,0000,,Сізді осындай жерден табуға болады.
Dialogue: 0,0:17:25.84,0:17:27.86,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:17:27.86,0:17:31.90,Default,,0000,0000,0000,,Балалар, сендер ұша аласыңдар, солай ма? Мені алып ұшып кет.
Dialogue: 0,0:17:31.90,0:17:37.96,Default,,0000,0000,0000,,Мен мұны істегім келеді, бірақ біз назар аудармай келе жатырмыз.
Dialogue: 0,0:17:37.96,0:17:42.01,Default,,0000,0000,0000,,Бұлма-сан, бұл жақта жақсы. Бұл тесікті табу қиын.
Dialogue: 0,0:17:42.01,0:17:46.21,Default,,0000,0000,0000,,Уау~ Ондай жерде қанша тұруымыз керек?
Dialogue: 0,0:17:46.21,0:17:50.42,Default,,0000,0000,0000,,Ву Хик.
Dialogue: 0,0:17:50.42,0:17:54.46,Default,,0000,0000,0000,,Криллин-сан, сен сол жақтағы энергияны сезе аласың ба?
Dialogue: 0,0:17:54.46,0:17:58.50,Default,,0000,0000,0000,,Бұл дұрыс. Бұрынғыдан басқаша сезіледі.
Dialogue: 0,0:17:58.50,0:18:00.52,Default,,0000,0000,0000,,Мүмкін бұл жолы Намекиан шығар.
Dialogue: 0,0:18:00.52,0:18:05.57,Default,,0000,0000,0000,,А, жасырын! Ол жақтан тағы бір рух келеді!
Dialogue: 0,0:18:05.57,0:18:07.59,Default,,0000,0000,0000,,Не? Эй. Жүр, асығыңыз!
Dialogue: 0,0:18:07.59,0:18:10.62,Default,,0000,0000,0000,,Бұл не? Сатан алғыр.
Dialogue: 0,0:18:10.62,0:18:12.64,Default,,0000,0000,0000,,Мына жолмен келе жатыр.
Dialogue: 0,0:18:12.64,0:18:15.67,Default,,0000,0000,0000,,Олар біз туралы білді ме?
Dialogue: 0,0:18:15.67,0:18:17.67,Default,,0000,0000,0000,,Мен білмеймін.
Dialogue: 0,0:18:20.72,0:18:22.74,Default,,0000,0000,0000,,Спорт күні керемет өтті, иә?
Dialogue: 0,0:18:22.74,0:18:40.92,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:18:40.92,0:18:44.96,Default,,0000,0000,0000,,Мен кеттім. Жақсы, сол адамдар→
Dialogue: 0,0:18:44.96,0:18:47.32,Default,,0000,0000,0000,,Мақсат біз емес сияқты.
Dialogue: 0,0:18:47.32,0:18:50.35,Default,,0000,0000,0000,,Бірақ бұл не болды?
Dialogue: 0,0:18:50.35,0:18:52.37,Default,,0000,0000,0000,,Иә? Ууууу….
Dialogue: 0,0:18:52.37,0:18:54.39,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:18:54.39,0:18:57.42,Default,,0000,0000,0000,,Не болды? Сіз жігіттер.
Dialogue: 0,0:18:57.42,0:19:00.45,Default,,0000,0000,0000,,Күрсін... Күрсін... →
Dialogue: 0,0:19:00.45,0:19:04.49,Default,,0000,0000,0000,,Булма-сан, Айдаһар радарымен тексеріңіз.
Dialogue: 0,0:19:04.49,0:19:07.52,Default,,0000,0000,0000,,Не? Мен бұған дейін қараған кезде →
Dialogue: 0,0:19:07.52,0:19:11.56,Default,,0000,0000,0000,,Төрт айдаһар шары жиналды, солай ма? →
Dialogue: 0,0:19:11.56,0:19:13.58,Default,,0000,0000,0000,,Қазір қандай?
Dialogue: 0,0:19:13.58,0:19:17.62,Default,,0000,0000,0000,,Жарайды, мен оны қараймын. →
Dialogue: 0,0:19:17.62,0:19:19.64,Default,,0000,0000,0000,,Аа, төртеуі де қозғалады. →
Dialogue: 0,0:19:19.64,0:19:22.67,Default,,0000,0000,0000,,...Бұл сөзсіз иә деген сөз. →
Dialogue: 0,0:19:22.67,0:19:25.70,Default,,0000,0000,0000,,Оның төрт айдаһар шары болды!
Dialogue: 0,0:19:25.70,0:19:28.73,Default,,0000,0000,0000,,Мен солай деп ойлаймын.
Dialogue: 0,0:19:28.73,0:19:31.76,Default,,0000,0000,0000,,Гохан. →
Dialogue: 0,0:19:31.76,0:19:34.79,Default,,0000,0000,0000,,Гохан! Ха, иә!
Dialogue: 0,0:19:34.79,0:19:37.82,Default,,0000,0000,0000,,Сіз Гоханды көрдіңіз бе? Бір қызық нәрсе алдыңғы жақтан екінші ұшып бара жатты.
Dialogue: 0,0:19:37.82,0:19:42.87,Default,,0000,0000,0000,,Иә, мен орасан зор күшті сезіндім.
Dialogue: 0,0:19:42.87,0:19:46.08,Default,,0000,0000,0000,,Әй, мен оны көрген сәтте мен тығылып қалдым.
Dialogue: 0,0:19:46.08,0:19:49.27,Default,,0000,0000,0000,,Әй, әлгі Вегетадағы жігіт→
Dialogue: 0,0:19:49.27,0:19:52.30,Default,,0000,0000,0000,,Бұл одан да шектен шығуы мүмкін.
Dialogue: 0,0:19:52.30,0:19:54.32,Default,,0000,0000,0000,,Ей, басқа ғажайыптар да болған сияқты→
Dialogue: 0,0:19:54.32,0:19:57.35,Default,,0000,0000,0000,,Әй, бұл мүлдем басқа деңгейде болды.
Dialogue: 0,0:19:57.35,0:20:01.39,Default,,0000,0000,0000,,Вегетадан артық!? Мынау... ол кім?
Dialogue: 0,0:20:01.39,0:20:05.43,Default,,0000,0000,0000,,Уау, білмеймін. Бірақ мен оны Вегетаның досы деп ойлаймын.
Dialogue: 0,0:20:05.43,0:20:07.45,Default,,0000,0000,0000,,Олардың барлығы бірдей киім киген.
Dialogue: 0,0:20:07.45,0:20:10.48,Default,,0000,0000,0000,,Чикусо! Мен бұл жігіттерден қалай құтыламын?
Dialogue: 0,0:20:10.48,0:20:12.50,Default,,0000,0000,0000,,Айдаһар шарларын ұрлауым керек пе?
Dialogue: 0,0:20:12.50,0:20:17.55,Default,,0000,0000,0000,,Эй, бұл балалар... Олар тағы бір Айдаһар допына бара жатыр. →
Dialogue: 0,0:20:17.55,0:20:20.58,Default,,0000,0000,0000,,Не болып жатыр? Олардың да радары бар ма?
Dialogue: 0,0:20:20.58,0:20:22.60,Default,,0000,0000,0000,,Ол қайда?
Dialogue: 0,0:20:22.60,0:20:25.63,Default,,0000,0000,0000,,Осы бағытта шамамен 14 км.
Dialogue: 0,0:20:25.63,0:20:28.66,Default,,0000,0000,0000,,Криллин Намекиандықтардың болуы мүмкін дейді →
Dialogue: 0,0:20:28.66,0:20:30.68,Default,,0000,0000,0000,,Мен энергияны осы жерден сезіндім.
Dialogue: 0,0:20:30.68,0:20:34.72,Default,,0000,0000,0000,,Мен сонда барып, не болып жатқанын көрейін.
Dialogue: 0,0:20:34.72,0:20:37.75,Default,,0000,0000,0000,,Мен де барамын. Эй... сәл күте тұрыңыз.
Dialogue: 0,0:20:37.75,0:20:40.78,Default,,0000,0000,0000,,Сіз мені осындай жерде жалғыз қалдыруды жоспарлап отырсыз ба?
Dialogue: 0,0:20:40.78,0:20:44.82,Default,,0000,0000,0000,,Жаман жолмен қозғалғаннан гөрі бұл жерде әлдеқайда қауіпсіз.
Dialogue: 0,0:20:44.82,0:20:46.51,Default,,0000,0000,0000,,Ойланып көрейікші, иә.
Dialogue: 0,0:20:46.51,0:20:48.19,Default,,0000,0000,0000,,Олай болса, кеттік.
Dialogue: 0,0:20:48.19,0:20:50.21,Default,,0000,0000,0000,,Тезірек оралыңыз.
Dialogue: 0,0:20:50.21,0:20:54.25,Default,,0000,0000,0000,,Тыңда, Гохан. Асығыңыз және мүмкіндігінше сақ болыңыз.
Dialogue: 0,0:20:54.25,0:20:56.27,Default,,0000,0000,0000,,Сіз мұны істей аласыз ба? иә!
Dialogue: 0,0:20:56.27,0:20:58.27,Default,,0000,0000,0000,,Жарайды!
Dialogue: 0,0:21:00.31,0:21:02.33,Default,,0000,0000,0000,,Мен кеттім.
Dialogue: 0,0:21:02.33,0:21:05.36,Default,,0000,0000,0000,,Мұның жақсы екеніне сенімдісіз бе?
Dialogue: 0,0:21:05.36,0:21:07.38,Default,,0000,0000,0000,,Иә, мен Жермен байланысуым керек.
Dialogue: 0,0:21:07.38,0:21:11.42,Default,,0000,0000,0000,,Шынымен бе? Сонымен, Гохан және басқалары қауіпсіз бе?
Dialogue: 0,0:21:11.42,0:21:15.46,Default,,0000,0000,0000,,Аа, біз Намек планетасына аман-есен жеттік.
Dialogue: 0,0:21:15.46,0:21:17.48,Default,,0000,0000,0000,,Алайда, Намек планетасына келген адам → болды
Dialogue: 0,0:21:17.48,0:21:20.51,Default,,0000,0000,0000,,Бұл тек Гохан және басқалар емес еді.
Dialogue: 0,0:21:20.51,0:21:23.54,Default,,0000,0000,0000,,Сол Вегета деген Сайян да келді.
Dialogue: 0,0:21:23.54,0:21:25.56,Default,,0000,0000,0000,,Вегета!? Әлгі жігіт?
Dialogue: 0,0:21:25.56,0:21:29.60,Default,,0000,0000,0000,,Бұл бәрі емес. Вегетадан гөрі Намекке көп нәрсе бар→
Dialogue: 0,0:21:29.60,0:21:32.63,Default,,0000,0000,0000,,Оның он шақты досы бар сияқты.
Dialogue: 0,0:21:32.63,0:21:35.66,Default,,0000,0000,0000,,Мен мінген ғарыш кемесін олар қиратты→
Dialogue: 0,0:21:35.66,0:21:37.68,Default,,0000,0000,0000,,Мен енді Жерге орала алмайтын сияқтымын.
Dialogue: 0,0:21:37.68,0:21:39.70,Default,,0000,0000,0000,,Не?!
Dialogue: 0,0:21:39.70,0:21:41.72,Default,,0000,0000,0000,,Және олардың кем дегенде біреуі→
Dialogue: 0,0:21:41.72,0:21:44.75,Default,,0000,0000,0000,,Оның Вегетадан асып түсуге ерік-жігері болды.
Dialogue: 0,0:21:44.75,0:21:49.75,Default,,0000,0000,0000,,Жоқ, ондай біреудің Вегетадан асып түсу ниеті бар!?
Dialogue: 0,0:21:53.18,0:21:57.22,Default,,0000,0000,0000,,Иә? Эй, сен оны тірі қалдырдың! →
Dialogue: 0,0:21:57.22,0:22:01.26,Default,,0000,0000,0000,,Неге екенін білмеймін, жол бойы келсем де, қатты ұялып қалдым.
Dialogue: 0,0:22:01.26,0:22:04.29,Default,,0000,0000,0000,,Сензу бұршақтарының дайын болғанына қуаныштымын.
Dialogue: 0,0:22:04.29,0:22:08.33,Default,,0000,0000,0000,,Қарин-сама, маған жасаған 7 дәнді түгел әкеліп берші.
Dialogue: 0,0:22:08.33,0:22:11.36,Default,,0000,0000,0000,,Уау! Мен оны істедім! Бұл жақсы уақыт!
Dialogue: 0,0:22:11.36,0:22:13.38,Default,,0000,0000,0000,,Маған тез тамақ берші!
Dialogue: 0,0:22:13.38,0:22:16.41,Default,,0000,0000,0000,,Науқастарыңызға біртүрлі тамақ беріп жатырсыз...!
Dialogue: 0,0:22:16.41,0:22:18.43,Default,,0000,0000,0000,,Міне, келдіңіз.
Dialogue: 0,0:22:18.43,0:22:20.43,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:22:25.50,0:22:27.52,Default,,0000,0000,0000,,Хах.
Dialogue: 0,0:22:27.52,0:22:30.55,Default,,0000,0000,0000,,I-!? Мен-мен.
Dialogue: 0,0:22:30.55,0:22:33.58,Default,,0000,0000,0000,,Мен~!? (Каме Эрмит) О~.
Dialogue: 0,0:22:33.58,0:22:36.61,Default,,0000,0000,0000,,Хехехе~ Мен осы сәтті күттім!
Dialogue: 0,0:22:36.61,0:22:38.63,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:22:38.63,0:22:40.65,Default,,0000,0000,0000,,Мынау, мынау, Кай патша, осы күнге→
Dialogue: 0,0:22:40.65,0:22:43.68,Default,,0000,0000,0000,,Олар маған жаңа ги жіберді.
Dialogue: 0,0:22:43.68,0:22:45.70,Default,,0000,0000,0000,,E~!?
Dialogue: 0,0:22:45.70,0:22:49.07,Default,,0000,0000,0000,,Жарайды, эй, мен Намек планетасына кеттім!
Dialogue: 0,0:22:49.07,0:22:52.10,Default,,0000,0000,0000,,Ой, кешіріңіз. Мен Сензу бұршақтарының қалғанын аламын.
Dialogue: 0,0:22:52.10,0:22:55.13,Default,,0000,0000,0000,,Намек планетасына қалай баруды жоспарлайсыз?
Dialogue: 0,0:22:55.13,0:22:59.17,Default,,0000,0000,0000,,Хехе~ Әй, Бұлманың әкесі қонаққа келгенде →
Dialogue: 0,0:22:59.17,0:23:01.19,Default,,0000,0000,0000,,Мен оны дұрыс сұрадым.
Dialogue: 0,0:23:01.19,0:23:03.21,Default,,0000,0000,0000,,Кез келген жағдайда ғарыш кемесін құрастырыңыз.
Dialogue: 0,0:23:03.21,0:23:07.25,Default,,0000,0000,0000,,Ғарыш кемесі Құдаймен бірдей ме?
Dialogue: 0,0:23:07.25,0:23:09.27,Default,,0000,0000,0000,,Себебі біз Жерде жоқ нәрсені қолданып жатырмыз→
Dialogue: 0,0:23:09.27,0:23:12.30,Default,,0000,0000,0000,,Бұлманың әкесінің де қолынан келмейді.
Dialogue: 0,0:23:12.30,0:23:14.32,Default,,0000,0000,0000,,Сонда?
Dialogue: 0,0:23:14.32,0:23:18.36,Default,,0000,0000,0000,,Әй, мен бұл туралы ойладым және оның Сайян ғарыш кемесі екенін түсіндім→
Dialogue: 0,0:23:18.36,0:23:21.39,Default,,0000,0000,0000,,Жерде әлі екі қалғанын түсіндім.
Dialogue: 0,0:23:21.39,0:23:25.43,Default,,0000,0000,0000,,Оланың ағасы мінген ғарыш кемесі және Оланың өзі бала кезінде→
Dialogue: 0,0:23:25.43,0:23:28.46,Default,,0000,0000,0000,,Жерге келгенде мінген ғарыш кемесі.
Dialogue: 0,0:23:28.46,0:23:30.48,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:23:30.48,0:23:32.50,Default,,0000,0000,0000,,Мен Бұлманың әкесінен оны іздеп баруын өтінемін →
Dialogue: 0,0:23:32.50,0:23:35.53,Default,,0000,0000,0000,,Ағам екеуміз бірге жарылдық.→
Dialogue: 0,0:23:35.53,0:23:38.56,Default,,0000,0000,0000,,Оланың бірі өткеннен болды, сондықтан ол шынымен қауіпсіз болды.
Dialogue: 0,0:23:38.56,0:23:42.60,Default,,0000,0000,0000,,Мен оларды жөндеп, қайта құруды тапсырамын.
Dialogue: 0,0:23:42.60,0:23:44.62,Default,,0000,0000,0000,,Судзитун~!
Dialogue: 0,0:23:44.62,0:23:47.98,Default,,0000,0000,0000,,Онда мен саған көмектесейін. Иә.
Dialogue: 0,0:23:47.98,0:23:49.98,Default,,0000,0000,0000,,Иә! (Медбике/Дәрігер) Эй!?
Dialogue: 0,0:23:51.02,0:23:53.02,Default,,0000,0000,0000,,Буллман, жүр!
Dialogue: 0,0:23:55.06,0:23:59.10,Default,,0000,0000,0000,,Көмекке бару дегенді қалай түсінесіңдер? (Каме-сеннин) Хмм, шынымен...
Dialogue: 0,0:23:59.10,0:24:02.13,Default,,0000,0000,0000,,Иә!? Бұл өте ақылсыз нәрсе →
Dialogue: 0,0:24:02.13,0:24:04.15,Default,,0000,0000,0000,,Анау бейбақ неге сонша бақытты көрінеді...?
Dialogue: 0,0:24:04.15,0:24:07.18,Default,,0000,0000,0000,,Сайянның қаны шығар деп ойлаймын.
Dialogue: 0,0:24:07.18,0:24:09.20,Default,,0000,0000,0000,,Әрине, мен бәрін құтқарғым келеді→
Dialogue: 0,0:24:09.20,0:24:14.25,Default,,0000,0000,0000,,Ең бастысы, мықтымен күресу үлкен қуаныш сияқты.
Dialogue: 0,0:24:14.25,0:24:18.29,Default,,0000,0000,0000,,А, бұл жігіт қалыпты емес.
Dialogue: 0,0:24:18.29,0:24:20.31,Default,,0000,0000,0000,,Біз бірге шыға алмаймыз.
Dialogue: 0,0:24:20.31,0:24:26.31,Default,,0000,0000,0000,,《Мен сенбеймін... Вегетадан да таңғаларлық біреу бар》
Dialogue: 0,0:24:29.40,0:24:33.44,Default,,0000,0000,0000,,<Намектің айналасына қара бұлттар жиналды. →
Dialogue: 0,0:24:33.44,0:24:38.49,Default,,0000,0000,0000,,Вегета тілектерді орындай алатын адам ма? →
Dialogue: 0,0:24:38.49,0:24:43.54,Default,,0000,0000,0000,,Әлде бұл зұлымдық ұйымдастырушы Фриза ма? →
Dialogue: 0,0:24:43.54,0:24:49.54,Default,,0000,0000,0000,,Гоку, күшті жауларға толы Намек планетасына асығыңыз! ＞
Dialogue: 0,0:24:51.96,0:24:56.01,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:56.01,0:25:16.21,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:16.21,0:25:36.41,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:36.41,0:25:50.41,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:54.59,0:25:58.63,Default,,0000,0000,0000,,Оссу Ора Гоку. Хе~! Бұл үлкен ғарыш кемесі.
Dialogue: 0,0:25:58.63,0:26:01.66,Default,,0000,0000,0000,,Намекте 6 күн осы жігітке мініп жүрсің бе?
Dialogue: 0,0:26:01.66,0:26:04.69,Default,,0000,0000,0000,,Бұл планетаның бәрі қыңыр. →
Dialogue: 0,0:26:04.69,0:26:09.74,Default,,0000,0000,0000,,Жастардың бәрі өлтіргісі келетін сияқты. Хехе.
Dialogue: 0,0:26:09.74,0:26:11.76,Default,,0000,0000,0000,,Тәтті~ Қандай сұмдық адамдар!
Dialogue: 0,0:26:11.76,0:26:14.76,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»
Dialogue: 0,0:26:17.82,0:26:19.82,Default,,0000,0000,0000,,Олардың барлығы дәл Пикколоға ұқсайды.
Dialogue: 0,0:26:21.32,0:26:27.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory