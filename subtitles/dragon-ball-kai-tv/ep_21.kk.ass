Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.69,0:00:18.75,Default,,0000,0000,0000,,<Үміт жұлдызы Намек ғаламшарында қорқынышты жаулар жиналады. →
Dialogue: 0,0:00:18.75,0:00:22.79,Default,,0000,0000,0000,,Криллин мен Гохан әзірге жасырынып жүр→
Dialogue: 0,0:00:22.79,0:00:27.84,Default,,0000,0000,0000,,Фризаның бандасының қозғалысын зерттеу. →
Dialogue: 0,0:00:27.84,0:00:31.88,Default,,0000,0000,0000,,Осы уақытта, Жерде Гоку толығымен қайта жанданды. →
Dialogue: 0,0:00:31.88,0:00:34.88,Default,,0000,0000,0000,,Не болып жатқанын білген бойда сыртқа секіріп түстім >
Dialogue: 0,0:00:37.94,0:00:42.99,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:42.99,0:01:02.19,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:02.19,0:01:22.72,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:22.72,0:01:42.92,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:42.92,0:01:59.92,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:25.55,0:04:28.58,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:04:28.58,0:04:32.62,Default,,0000,0000,0000,,Ах~ Гоку-чан! Бұлманың анасы.
Dialogue: 0,0:04:32.62,0:04:35.65,Default,,0000,0000,0000,,Енді бәрі дайынсың ба?
Dialogue: 0,0:04:35.65,0:04:38.68,Default,,0000,0000,0000,,Хехе, осылай.
Dialogue: 0,0:04:38.68,0:04:41.71,Default,,0000,0000,0000,,Айтпақшы, мен сұраған ғарыш кемесін өзгерте алдыңыз ба?
Dialogue: 0,0:04:41.71,0:04:46.76,Default,,0000,0000,0000,,Енді сіз қалай ойлайсыз? Ол әлі бірдеңе істеп жатқан сияқты.
Dialogue: 0,0:04:46.76,0:04:50.80,Default,,0000,0000,0000,,I~! Әзірше емес!? Жоқ, мен қиналдым.
Dialogue: 0,0:04:50.80,0:04:54.80,Default,,0000,0000,0000,,Хехехехе, ауладағылар, қош келдіңіздер. Иә.
Dialogue: 0,0:04:56.86,0:04:58.88,Default,,0000,0000,0000,,Солай болса да, әлгі кішкентай Гоку-чан→
Dialogue: 0,0:04:58.88,0:05:00.90,Default,,0000,0000,0000,,Бұл қандай керемет.
Dialogue: 0,0:05:00.90,0:05:03.93,Default,,0000,0000,0000,,Ей, келесі жолы кездесуге барайық. Эй!
Dialogue: 0,0:05:03.93,0:05:07.97,Default,,0000,0000,0000,,Уа, у-у-у, алдымен Сайяндарды жеңуіміз керек.
Dialogue: 0,0:05:07.97,0:05:11.17,Default,,0000,0000,0000,,Хмм, сіз бос емессіз. Ах! о иә.
Dialogue: 0,0:05:11.17,0:05:14.37,Default,,0000,0000,0000,,Өткен күні мен өте дәмді торт дүкенін таптым.
Dialogue: 0,0:05:14.37,0:05:16.39,Default,,0000,0000,0000,,Гоку-чанға рахмет.
Dialogue: 0,0:05:16.39,0:05:19.42,Default,,0000,0000,0000,,Жер жоғалып кетсе, біз оны жей алмас едік.
Dialogue: 0,0:05:19.42,0:05:21.44,Default,,0000,0000,0000,,Хаха мен солай ойлаймын ба?
Dialogue: 0,0:05:21.44,0:05:25.48,Default,,0000,0000,0000,,Сен, Гоку-чан, осындасың.
Dialogue: 0,0:05:25.48,0:05:29.52,Default,,0000,0000,0000,,Ой! Эй, бұл →
Dialogue: 0,0:05:29.52,0:05:32.55,Default,,0000,0000,0000,,Ораның ғарыш кемесі!
Dialogue: 0,0:05:32.55,0:05:34.55,Default,,0000,0000,0000,,Бұл өте үлкен!
Dialogue: 0,0:05:39.62,0:05:42.65,Default,,0000,0000,0000,,Ей, эй, Гоку, сен әлі емделдің бе?
Dialogue: 0,0:05:42.65,0:05:44.67,Default,,0000,0000,0000,,Иә, Сензуға рахмет. Бұл менікі, солай ма?
Dialogue: 0,0:05:44.67,0:05:49.72,Default,,0000,0000,0000,,Оның әлі аяқталмағаны рас па? Хмм, тағы біраз.
Dialogue: 0,0:05:49.72,0:05:51.74,Default,,0000,0000,0000,,Кіріңіз.
Dialogue: 0,0:05:51.74,0:05:53.76,Default,,0000,0000,0000,,Жарайды, мен саған ішетін бірдеңе әкелейін.
Dialogue: 0,0:05:53.76,0:05:55.76,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:05:57.80,0:06:00.83,Default,,0000,0000,0000,,Уау, бұл керемет!
Dialogue: 0,0:06:00.83,0:06:03.86,Default,,0000,0000,0000,,Міне, кішкентай ғарыш кемесі осылай болып шықты.
Dialogue: 0,0:06:03.86,0:06:07.90,Default,,0000,0000,0000,,Әй, бәрібір. Барлығы тапсырыс бойынша.
Dialogue: 0,0:06:07.90,0:06:10.93,Default,,0000,0000,0000,,Осының көмегімен сіз тамаша жаттығуға болады.
Dialogue: 0,0:06:10.93,0:06:14.30,Default,,0000,0000,0000,,Сізге қиын болды. Ғарыш кемесін табу қиын болды.
Dialogue: 0,0:06:14.30,0:06:17.33,Default,,0000,0000,0000,,Ол бөліктерге бөлінген.
Dialogue: 0,0:06:17.33,0:06:21.37,Default,,0000,0000,0000,,Маңызды бөліктердің қалғаны бақытыма ие болды.→
Dialogue: 0,0:06:21.37,0:06:23.39,Default,,0000,0000,0000,,Бұл негізінен қайта жазу.
Dialogue: 0,0:06:23.39,0:06:26.42,Default,,0000,0000,0000,,Ораның ғарыш кемесі жыртылып қалды?
Dialogue: 0,0:06:26.42,0:06:29.45,Default,,0000,0000,0000,,Бұл біртүрлі. Бала кезімде бұздым деп ойлаймын.
Dialogue: 0,0:06:29.45,0:06:34.50,Default,,0000,0000,0000,,Жоқ, бірақ Сайян ғылымы керемет.
Dialogue: 0,0:06:34.50,0:06:39.55,Default,,0000,0000,0000,,Иә? Жасанды тартылыс құрылғысы ше?
Dialogue: 0,0:06:39.55,0:06:42.58,Default,,0000,0000,0000,,А, міне, солай.
Dialogue: 0,0:06:42.58,0:06:44.60,Default,,0000,0000,0000,,Иә~ Бұл ма?
Dialogue: 0,0:06:44.60,0:06:46.62,Default,,0000,0000,0000,,Бұл қосқыш. →
Dialogue: 0,0:06:46.62,0:06:48.64,Default,,0000,0000,0000,,Бұл контроллер. →
Dialogue: 0,0:06:48.64,0:06:52.68,Default,,0000,0000,0000,,Тапсырыс бойынша гравитацияны 100G → дейін жасауға болады
Dialogue: 0,0:06:52.68,0:06:56.72,Default,,0000,0000,0000,,Бұл сіз үшін де қисынсыз емес пе?
Dialogue: 0,0:06:56.72,0:07:02.78,Default,,0000,0000,0000,,100G немесе 60кг салмағы 6000кг болады.
Dialogue: 0,0:07:02.78,0:07:04.80,Default,,0000,0000,0000,,6t. Мен өлемін, бұл қалыпты жағдай.
Dialogue: 0,0:07:04.80,0:07:07.83,Default,,0000,0000,0000,,Жарайды, мен сонда жаттығуым керек →
Dialogue: 0,0:07:07.83,0:07:10.86,Default,,0000,0000,0000,,Сайяндарды жеңу мүмкін емес.
Dialogue: 0,0:07:10.86,0:07:12.22,Default,,0000,0000,0000,,...Сонымен бұл жігіт әлі ұша алмайды?
Dialogue: 0,0:07:12.22,0:07:15.25,Default,,0000,0000,0000,,Сіз тіпті ғаламның шетіне дейін ұша аласыз.
Dialogue: 0,0:07:15.25,0:07:17.27,Default,,0000,0000,0000,,Не? Сонда...
Dialogue: 0,0:07:17.27,0:07:19.29,Default,,0000,0000,0000,,Жуынатын бөлме және ас үй→
Dialogue: 0,0:07:19.29,0:07:22.32,Default,,0000,0000,0000,,Ал жатын бөлме сол баспалдақтан төмен...
Dialogue: 0,0:07:22.32,0:07:25.35,Default,,0000,0000,0000,,Әй, әлі не істелмеді?
Dialogue: 0,0:07:25.35,0:07:28.38,Default,,0000,0000,0000,,Стерео үндеткіштердің орнын таңдауда қиындықтар туындады.
Dialogue: 0,0:07:28.38,0:07:30.40,Default,,0000,0000,0000,,Сіз бәрібір оны жақсы дыбыспен естігіңіз келеді, солай ма?
Dialogue: 0,0:07:30.40,0:07:32.42,Default,,0000,0000,0000,,Міне!?
Dialogue: 0,0:07:32.42,0:07:35.45,Default,,0000,0000,0000,,Бұл аяқталмады дегеніңіз осы ма?
Dialogue: 0,0:07:35.45,0:07:38.48,Default,,0000,0000,0000,,«Бұл сізге қажет» Ең жақсы дыбысты тыңдау үшін→
Dialogue: 0,0:07:38.48,0:07:41.51,Default,,0000,0000,0000,,Рефлексия сияқты нәрселер туралы ойлау өте қиын.
Dialogue: 0,0:07:41.51,0:07:45.55,Default,,0000,0000,0000,,Уф! Стерео позиция жақсы.
Dialogue: 0,0:07:45.55,0:07:48.58,Default,,0000,0000,0000,,Әй, тезірек! Дәл қазір кетейік!
Dialogue: 0,0:07:48.58,0:07:50.60,Default,,0000,0000,0000,,Неге сонша асығасың?
Dialogue: 0,0:07:50.60,0:07:53.63,Default,,0000,0000,0000,,Маған Бұлмадан хабар келді. Қалай болғанда да, мен асығуым керек.
Dialogue: 0,0:07:53.63,0:07:55.65,Default,,0000,0000,0000,,Мм.
Dialogue: 0,0:07:55.65,0:07:59.69,Default,,0000,0000,0000,,Мына затты қалай ұшыру керектігін тез айт.
Dialogue: 0,0:07:59.69,0:08:02.72,Default,,0000,0000,0000,,Түсіндім. ...Стереопозиция шынымен жақсы.
Dialogue: 0,0:08:02.72,0:08:06.76,Default,,0000,0000,0000,,Иә, иә. Барлық деректер енгізілді.
Dialogue: 0,0:08:06.76,0:08:09.79,Default,,0000,0000,0000,,Сізге бар болғаны қосқыш→ түймесін басу керек
Dialogue: 0,0:08:09.79,0:08:12.15,Default,,0000,0000,0000,,Намекке 6 күннен кейін жетеміз.
Dialogue: 0,0:08:12.15,0:08:17.20,Default,,0000,0000,0000,,6 күн! Бар болғаны 6 күнде баруға бола ма? Бұл керемет!
Dialogue: 0,0:08:17.20,0:08:19.22,Default,,0000,0000,0000,,（）
Dialogue: 0,0:08:19.22,0:08:21.24,Default,,0000,0000,0000,,Гоку келе жатыр деген рас па?
Dialogue: 0,0:08:21.24,0:08:25.28,Default,,0000,0000,0000,,Иә. Мен дәл қазір ауладағы ғарыш кемелеріне қарап отырмын.
Dialogue: 0,0:08:25.28,0:08:27.30,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:08:27.30,0:08:29.32,Default,,0000,0000,0000,,Уах! →
Dialogue: 0,0:08:29.32,0:08:32.35,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:32.35,0:08:34.37,Default,,0000,0000,0000,,О, құдайым.
Dialogue: 0,0:08:34.37,0:08:37.37,Default,,0000,0000,0000,,Уау! (Пуар) Ууу~!
Dialogue: 0,0:08:39.42,0:08:43.42,Default,,0000,0000,0000,,Ал, бұл түйме туралы не деуге болады?
Dialogue: 0,0:08:45.48,0:08:47.48,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:50.53,0:08:53.53,Default,,0000,0000,0000,,I~! Ииий!
Dialogue: 0,0:09:01.64,0:09:06.69,Default,,0000,0000,0000,,О! Асығыс жасасам да→
Dialogue: 0,0:09:06.69,0:09:09.72,Default,,0000,0000,0000,,Ол жақсы ұшып кетті.
Dialogue: 0,0:09:09.72,0:09:11.91,Default,,0000,0000,0000,,Гоку ше? Эй!
Dialogue: 0,0:09:11.91,0:09:16.12,Default,,0000,0000,0000,,Иә. Мен асығыс кетіп қалдым. →
Dialogue: 0,0:09:16.12,0:09:19.12,Default,,0000,0000,0000,,Стерео шынымен жақсы ма?
Dialogue: 0,0:09:23.19,0:09:28.24,Default,,0000,0000,0000,,Ой, бұл жігіт әрине жылдам.
Dialogue: 0,0:09:28.24,0:09:30.26,Default,,0000,0000,0000,,Маған бірден жаттығуды бастау керек.
Dialogue: 0,0:09:30.26,0:09:33.29,Default,,0000,0000,0000,,Мен оның 6 күннен кейін келетініне ризамын, бірақ оған дейін →
Dialogue: 0,0:09:33.29,0:09:36.32,Default,,0000,0000,0000,,Мен Вегета деген жігіттен асып түсуім керек.
Dialogue: 0,0:09:36.32,0:09:41.37,Default,,0000,0000,0000,,Ал, мен олардың Кай патшаның планетасының тартылыс күші 10 есе көп екенін айтқанына сенімдімін.
Dialogue: 0,0:09:41.37,0:09:46.37,Default,,0000,0000,0000,,20x шамасында үйренген дұрыс емес пе?
Dialogue: 0,0:09:54.50,0:09:56.52,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:56.52,0:09:58.54,Default,,0000,0000,0000,,Коо~!
Dialogue: 0,0:09:58.54,0:10:02.58,Default,,0000,0000,0000,,Аспаз~! Қарғыс атқыр...
Dialogue: 0,0:10:02.58,0:10:06.58,Default,,0000,0000,0000,,Куу~! Бұл шынымен жұмыс істейді!
Dialogue: 0,0:10:12.01,0:10:16.05,Default,,0000,0000,0000,,Жақын, Жақын. Ойыңызды толығымен өшіріңіз.
Dialogue: 0,0:10:16.05,0:10:18.05,Default,,0000,0000,0000,,Жаяу жақындау. (Ұлы Гохан) Иә.
Dialogue: 0,0:10:29.18,0:10:31.18,Default,,0000,0000,0000,,Бұл жартастың арғы жағында.
Dialogue: 0,0:10:35.24,0:10:37.24,Default,,0000,0000,0000,,Сіз керемет көрінесіз.
Dialogue: 0,0:10:42.31,0:10:47.36,Default,,0000,0000,0000,,Бұл біз мінген ғарыш кемесімен бірдей үй!
Dialogue: 0,0:10:47.36,0:10:49.38,Default,,0000,0000,0000,,Олар не істеп жатыр? →
Dialogue: 0,0:10:49.38,0:10:53.42,Default,,0000,0000,0000,,Қалғандарына келсек, сол үшеуі. →
Dialogue: 0,0:10:53.42,0:10:56.45,Default,,0000,0000,0000,,Әсіресе сол ортадағы дөңгелек көлікке мінген адам.
Dialogue: 0,0:10:56.45,0:11:00.49,Default,,0000,0000,0000,,Бұл қорқынышты күшті. Уау, түсіндім.
Dialogue: 0,0:11:00.49,0:11:03.52,Default,,0000,0000,0000,,Ах... Ах!
Dialogue: 0,0:11:03.52,0:11:05.54,Default,,0000,0000,0000,,Әй, екі жақтағы екі адам →
Dialogue: 0,0:11:05.54,0:11:08.57,Default,,0000,0000,0000,,Қолыңда не ұстап тұрғаныңды қара! Бұл Айдаһар добы!
Dialogue: 0,0:11:08.57,0:11:11.77,Default,,0000,0000,0000,,Ах! Үлкен Айдаһар добы!
Dialogue: 0,0:11:11.77,0:11:13.77,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:16.99,0:11:18.01,Default,,0000,0000,0000,,Не болды? Додориа мырза.
Dialogue: 0,0:11:18.01,0:11:22.05,Default,,0000,0000,0000,,Жоқ, жар жағында аздаған күш реакциясы болды.
Dialogue: 0,0:11:22.05,0:11:26.05,Default,,0000,0000,0000,,Енді кетті. Бұл кішкентай жануар немесе жәндік шығар.
Dialogue: 0,0:11:28.11,0:11:32.15,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:11:32.15,0:11:34.17,Default,,0000,0000,0000,,Hii~ Бұл қауіпті. Бұл қауіпті.
Dialogue: 0,0:11:34.17,0:11:38.17,Default,,0000,0000,0000,,Біз дерлік табылдық. Ха~.
Dialogue: 0,0:11:40.23,0:11:43.26,Default,,0000,0000,0000,,Фриза-сама, тек 5 адам табылды. →
Dialogue: 0,0:11:43.26,0:11:46.29,Default,,0000,0000,0000,,Қалғандары жаңа ғана кеткен сияқты.
Dialogue: 0,0:11:46.29,0:11:51.29,Default,,0000,0000,0000,,Қазір шық, өлгің келмесе.
Dialogue: 0,0:11:56.39,0:11:59.42,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:59.42,0:12:04.42,Default,,0000,0000,0000,,Дәл Пикколо сияқты! Жоқ, бұл Намекиан!
Dialogue: 0,0:12:09.52,0:12:11.20,Default,,0000,0000,0000,,Фуфуфуфуфу….
Dialogue: 0,0:12:11.20,0:12:14.91,Default,,0000,0000,0000,,Менің ойымша, олар Намекияндарды не істемекші?
Dialogue: 0,0:12:14.91,0:12:17.94,Default,,0000,0000,0000,,Криллин-сан, олардың бәрі сайяндар ма?
Dialogue: 0,0:12:17.94,0:12:21.98,Default,,0000,0000,0000,,Жоқ, олай емес. Олардың жауынгерлік киімдері бірдей, бірақ олар сайяндар емес.
Dialogue: 0,0:12:21.98,0:12:27.03,Default,,0000,0000,0000,,Вегета жалғыз Сайян болуы керек.
Dialogue: 0,0:12:27.03,0:12:30.06,Default,,0000,0000,0000,,Гоку мен сізден басқа. Сонда...
Dialogue: 0,0:12:30.06,0:12:34.10,Default,,0000,0000,0000,,Айтпақшы, Гокудың ағасы осылай деді.
Dialogue: 0,0:12:34.10,0:12:38.14,Default,,0000,0000,0000,,《Қоршаған ортасы жақсы планетаны іздеп, онда тұратын адамдарды құрту→
Dialogue: 0,0:12:38.14,0:12:41.17,Default,,0000,0000,0000,,Лайықты жұлдызды іздеп жүрген шетелдіктерге→
Dialogue: 0,0:12:41.17,0:12:43.19,Default,,0000,0000,0000,,Менің жұмысым – жоғары бағамен сату》
Dialogue: 0,0:12:43.19,0:12:46.22,Default,,0000,0000,0000,,Мүмкін ол оның достарының бірі шығар.
Dialogue: 0,0:12:46.22,0:12:48.24,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:12:48.24,0:12:52.28,Default,,0000,0000,0000,,Сонда да мен Вегетаны көре алмаймын. →
Dialogue: 0,0:12:52.28,0:12:55.31,Default,,0000,0000,0000,,Айдаһар шарларын басқа жерден іздеп жүрсіз бе?
Dialogue: 0,0:12:55.31,0:12:57.31,Default,,0000,0000,0000,,Сагири тауының шыңында ауа тіпті де жұқа еді!
Dialogue: 0,0:12:59.35,0:13:02.38,Default,,0000,0000,0000,,Жақсы…. (Фриза) Көріп отырғаныңыздай →
Dialogue: 0,0:13:02.38,0:13:05.41,Default,,0000,0000,0000,,Мен сіздің айдаһар шарларыңызды және заттарыңызды жинап жатырмын→
Dialogue: 0,0:13:05.41,0:13:09.45,Default,,0000,0000,0000,,Менің атым Фриеза.
Dialogue: 0,0:13:09.45,0:13:12.81,Default,,0000,0000,0000,,Айтпақшы, қалғандары не болды? →
Dialogue: 0,0:13:12.81,0:13:18.81,Default,,0000,0000,0000,,Біздің тергеуіміз бойынша 10 адам болуы керек.
Dialogue: 0,0:13:21.90,0:13:25.94,Default,,0000,0000,0000,,Сіз ештеңе айтпайсыз ба?
Dialogue: 0,0:13:25.94,0:13:27.94,Default,,0000,0000,0000,,Мен сені өлтіремін.
Dialogue: 0,0:14:56.85,0:14:59.88,Default,,0000,0000,0000,,Енді жауап берейік.
Dialogue: 0,0:14:59.88,0:15:02.88,Default,,0000,0000,0000,,Хе хе хе.
Dialogue: 0,0:15:08.97,0:15:12.01,Default,,0000,0000,0000,,Nuwainita hanitaemao motelekikoet….
Dialogue: 0,0:15:12.01,0:15:14.03,Default,,0000,0000,0000,,Хэхехе. Namekian емес→
Dialogue: 0,0:15:14.03,0:15:17.06,Default,,0000,0000,0000,,Біз түсінетін тілде сөйле.
Dialogue: 0,0:15:17.06,0:15:20.09,Default,,0000,0000,0000,,Мен сенің не айта алатыныңды білемін.
Dialogue: 0,0:15:20.09,0:15:22.11,Default,,0000,0000,0000,,Қалғандары далаға жұмысқа шықты.
Dialogue: 0,0:15:22.11,0:15:26.15,Default,,0000,0000,0000,,Қарттар мен балалар ғана қалдық.
Dialogue: 0,0:15:26.15,0:15:30.19,Default,,0000,0000,0000,,Иә, маған дәл осылай жауап бере алсаңыз→
Dialogue: 0,0:15:30.19,0:15:32.21,Default,,0000,0000,0000,,Ол ештеңе жасамайды. →
Dialogue: 0,0:15:32.21,0:15:36.42,Default,,0000,0000,0000,,Енді жауап беруді жалғастырыңыз. →
Dialogue: 0,0:15:36.42,0:15:38.60,Default,,0000,0000,0000,,Айдаһар шарлары қайда?
Dialogue: 0,0:15:38.60,0:15:41.63,Default,,0000,0000,0000,,Ах! Ах!
Dialogue: 0,0:15:41.63,0:15:44.66,Default,,0000,0000,0000,,Менің ойымша, бұл жерде де бар.
Dialogue: 0,0:15:44.66,0:15:47.69,Default,,0000,0000,0000,,Мен білмеймін! Менде ондай ештеңе жоқ!
Dialogue: 0,0:15:47.69,0:15:51.73,Default,,0000,0000,0000,,Фуфуфуфуфу Додориа-сан. Ха.
Dialogue: 0,0:15:51.73,0:15:54.76,Default,,0000,0000,0000,,Мен өлтірген екінші Намекян → екеніне сенімдімін
Dialogue: 0,0:15:54.76,0:15:56.78,Default,,0000,0000,0000,,Сіз қызықты нәрсе айттыңыз.
Dialogue: 0,0:15:56.78,0:15:58.80,Default,,0000,0000,0000,,Иә. Айдаһар добы →
Dialogue: 0,0:15:58.80,0:16:02.84,Default,,0000,0000,0000,,Оны тек танылған батырға ғана беруге болады.
Dialogue: 0,0:16:02.84,0:16:06.88,Default,,0000,0000,0000,,Иә, иә. Ол кісі өте қыңыр →
Dialogue: 0,0:16:06.88,0:16:10.92,Default,,0000,0000,0000,,Ынтымақтастыққа жету қиын →
Dialogue: 0,0:16:10.92,0:16:14.96,Default,,0000,0000,0000,,Мен саған көрсету үшін бір адамды өлтіремін.→
Dialogue: 0,0:16:14.96,0:16:18.00,Default,,0000,0000,0000,,Осыдан кейін біз әртүрлі нәрселер туралы әңгімелестік. →
Dialogue: 0,0:16:18.00,0:16:22.04,Default,,0000,0000,0000,,Осы планетадағы ең қарт адам жеті Айдаһар шарын жасады. →
Dialogue: 0,0:16:22.04,0:16:26.08,Default,,0000,0000,0000,,Жеті ақсақалдың әрқайсысы оларды мұқият ұстайды. →
Dialogue: 0,0:16:26.08,0:16:30.12,Default,,0000,0000,0000,,Даналық пен күшті олардың әрқайсысымен салыстыру →
Dialogue: 0,0:16:30.12,0:16:32.14,Default,,0000,0000,0000,,Тілегіңіздің себебі туралы айту→
Dialogue: 0,0:16:32.14,0:16:36.85,Default,,0000,0000,0000,,Ал әр ақсақал оны батыр ретінде таныған→
Dialogue: 0,0:16:36.85,0:16:42.58,Default,,0000,0000,0000,,Мен оны ақырында алатын сияқтымын. Дегенмен →
Dialogue: 0,0:16:42.58,0:16:45.61,Default,,0000,0000,0000,,Мен айтқанын орындауға тырыстым→
Dialogue: 0,0:16:45.61,0:16:49.65,Default,,0000,0000,0000,,Олар оны сізге ешқашан бере алмайтындарын айтады →
Dialogue: 0,0:16:49.65,0:16:53.69,Default,,0000,0000,0000,,Мен оны жаңа ғана өлтірдім.
Dialogue: 0,0:16:53.69,0:16:57.73,Default,,0000,0000,0000,,Сондықтан біріншісін табу қиынға соқты. →
Dialogue: 0,0:16:57.73,0:17:02.78,Default,,0000,0000,0000,,Қалған үшеуі оңай болды. Барлығы өте адал.
Dialogue: 0,0:17:02.78,0:17:06.82,Default,,0000,0000,0000,,Хмф, мен түсінемін. Солай ма?
Dialogue: 0,0:17:06.82,0:17:09.85,Default,,0000,0000,0000,,- (Ақсақал) Сонда, шынын айтайын ба?
Dialogue: 0,0:17:09.85,0:17:12.88,Default,,0000,0000,0000,,Уф, өтірік айтшы!
Dialogue: 0,0:17:12.88,0:17:14.90,Default,,0000,0000,0000,,Олай болса, басқа ақсақалдар→
Dialogue: 0,0:17:14.90,0:17:16.92,Default,,0000,0000,0000,,Мен оны сен сияқты біреудің қолына беруім мүмкін емес!
Dialogue: 0,0:17:16.92,0:17:20.96,Default,,0000,0000,0000,,Жоқ, жоқ, мұны істегеннен кейін бірден мойынсұнғыш болдыңыз.
Dialogue: 0,0:17:20.96,0:17:24.96,Default,,0000,0000,0000,,Зарбон мырза, көрсетіңізші. (Зарбон) Иә.
Dialogue: 0,0:17:26.02,0:17:28.04,Default,,0000,0000,0000,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:17:28.04,0:17:31.07,Default,,0000,0000,0000,,Уау…. →
Dialogue: 0,0:17:31.07,0:17:35.11,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:17:35.11,0:17:37.46,Default,,0000,0000,0000,,Не!?
Dialogue: 0,0:17:37.46,0:17:39.48,Default,,0000,0000,0000,,Өзім!
Dialogue: 0,0:17:39.48,0:17:41.50,Default,,0000,0000,0000,,Келіңіздер!
Dialogue: 0,0:17:41.50,0:17:44.53,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:17:44.53,0:17:46.53,Default,,0000,0000,0000,,Гаа~!
Dialogue: 0,0:17:51.60,0:17:53.62,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:17:53.62,0:17:55.64,Default,,0000,0000,0000,,Уа!
Dialogue: 0,0:17:55.64,0:17:58.64,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:18:02.71,0:18:04.71,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:18:08.77,0:18:12.81,Default,,0000,0000,0000,,Олар қандай? Эй, бұл қорқынышты!
Dialogue: 0,0:18:12.81,0:18:15.84,Default,,0000,0000,0000,,Гохан, деміңді ұста, сені байқайды.
Dialogue: 0,0:18:15.84,0:18:17.86,Default,,0000,0000,0000,,Бірақ бәрі осылай қала берсе... Өйткені сіз→
Dialogue: 0,0:18:17.86,0:18:20.89,Default,,0000,0000,0000,,Сіз Пикколо мен барлығын өмірге қайтарғыңыз келеді, солай ма? →
Dialogue: 0,0:18:20.89,0:18:23.92,Default,,0000,0000,0000,,Ол шынымен де бізге сәйкес келмейді. →
Dialogue: 0,0:18:23.92,0:18:26.95,Default,,0000,0000,0000,,Қазір кетсең, өлесің.
Dialogue: 0,0:18:26.95,0:18:28.97,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:18:28.97,0:18:34.03,Default,,0000,0000,0000,,Сізге қалай ұнайды? Кішкене адалырақ сезіндіңіз бе?
Dialogue: 0,0:18:34.03,0:18:38.40,Default,,0000,0000,0000,,Айдаһар шарларын жинаудың мақсаты қандай?
Dialogue: 0,0:18:38.40,0:18:41.43,Default,,0000,0000,0000,,Қандай қызықсыз тілек.
Dialogue: 0,0:18:41.43,0:18:45.47,Default,,0000,0000,0000,,Мен мәңгілік өмірді алғым келеді.
Dialogue: 0,0:18:45.47,0:18:50.52,Default,,0000,0000,0000,,Не? Ендеше, Вегета... А, ол да мәңгі өмір сүреді...
Dialogue: 0,0:18:50.52,0:18:54.56,Default,,0000,0000,0000,,Менің ойымша, ол Вегетамен дос емес. Мен білмеймін.
Dialogue: 0,0:18:54.56,0:18:59.61,Default,,0000,0000,0000,,Мен өлсем де, сен сияқтыларға Айдаһар доптарын бермеймін.
Dialogue: 0,0:18:59.61,0:19:02.64,Default,,0000,0000,0000,,Хохохохохохо Маған берсеңіздер →
Dialogue: 0,0:19:02.64,0:19:05.67,Default,,0000,0000,0000,,Сіз өлімді таңдайсыз ба? Мен түсінемін. →
Dialogue: 0,0:19:05.67,0:19:11.73,Default,,0000,0000,0000,,Бұл планетаның бәрі өте қыңыр көрінеді.
Dialogue: 0,0:19:11.73,0:19:16.78,Default,,0000,0000,0000,,Бірақ бала өлсе де қыңыр бола аласыз ба?
Dialogue: 0,0:19:16.78,0:19:18.78,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:19:22.84,0:19:26.88,Default,,0000,0000,0000,,Уау. (Ақсақал) Сіз және сіздің балаларыңыз!
Dialogue: 0,0:19:26.88,0:19:30.92,Default,,0000,0000,0000,,Жақсы…. Ууууу….
Dialogue: 0,0:19:30.92,0:19:32.94,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:19:32.94,0:19:36.15,Default,,0000,0000,0000,,Иә? Күшті жауынгерлік күш.
Dialogue: 0,0:19:36.15,0:19:39.34,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:39.34,0:19:42.37,Default,,0000,0000,0000,,Иә? Фриза-сама, бұл!
Dialogue: 0,0:19:42.37,0:19:45.40,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:19:45.40,0:19:50.40,Default,,0000,0000,0000,,Уау! Ахаха! (Ақсақал) Әй, келдің ғой!
Dialogue: 0,0:19:53.48,0:19:56.48,Default,,0000,0000,0000,,Намекян. Мен көмектесуге келдім.
Dialogue: 0,0:20:00.55,0:20:03.58,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:20:03.58,0:20:07.62,Default,,0000,0000,0000,,А-а... Шүкір~ Менің жаман сезімім орындалды.
Dialogue: 0,0:20:07.62,0:20:09.64,Default,,0000,0000,0000,,Бұл мәселе.
Dialogue: 0,0:20:09.64,0:20:13.68,Default,,0000,0000,0000,,Олар ақырында Айдаһар шарларын шығара алды.
Dialogue: 0,0:20:13.68,0:20:18.73,Default,,0000,0000,0000,,Жұмысыңды үзіп, мені өлтіреді деп ойламадым.
Dialogue: 0,0:20:18.73,0:20:21.76,Default,,0000,0000,0000,,Мен көремін, ауылға шабуыл жасап, Айдаһар шарларын аламын →
Dialogue: 0,0:20:21.76,0:20:25.80,Default,,0000,0000,0000,,Ұрлық жасайтын адамдар бар деген қауесеттер рас па?
Dialogue: 0,0:20:25.80,0:20:30.85,Default,,0000,0000,0000,,Ой... кешіріңіздер, балалар.
Dialogue: 0,0:20:30.85,0:20:34.89,Default,,0000,0000,0000,,Намек планетасының тыныштығын таптаңыз!
Dialogue: 0,0:20:34.89,0:20:39.28,Default,,0000,0000,0000,,Сіз ұрыспақ ниетіңіз бар ма? Сіздің жауынгерлік күшіңіз қаншалықты күшті?
Dialogue: 0,0:20:39.28,0:20:42.31,Default,,0000,0000,0000,,Мм... Додориа мырза.
Dialogue: 0,0:20:42.31,0:20:45.34,Default,,0000,0000,0000,,Га. Мен оны қараймын.
Dialogue: 0,0:20:45.34,0:20:51.40,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:20:51.40,0:20:55.44,Default,,0000,0000,0000,,Хе хе хе хе хе хе Көңіліңіз қалмаңыз.
Dialogue: 0,0:20:55.44,0:20:59.48,Default,,0000,0000,0000,,Үшеуі де 1000 шамасында. →
Dialogue: 0,0:20:59.48,0:21:02.51,Default,,0000,0000,0000,,Бізге ұрысудың қажеті жоқ.
Dialogue: 0,0:21:02.51,0:21:04.53,Default,,0000,0000,0000,,《Иә, түсіндім. →
Dialogue: 0,0:21:04.53,0:21:08.57,Default,,0000,0000,0000,,Неліктен Намекте бірнеше ауыл ғана шашырап жатыр?→
Dialogue: 0,0:21:08.57,0:21:12.61,Default,,0000,0000,0000,,Оларды дәл табуға бола ма? →
Dialogue: 0,0:21:12.61,0:21:15.64,Default,,0000,0000,0000,,Өйткені сіз оны сол құрылғы арқылы іздей аласыз.
Dialogue: 0,0:21:15.64,0:21:18.67,Default,,0000,0000,0000,,Хе хе хе хе хе мені күлдірдің. →
Dialogue: 0,0:21:18.67,0:21:22.71,Default,,0000,0000,0000,,Бізбен 1000-ға жуық жауынгерлік күшпен соғысқыңыз келе ме? Хехе.
Dialogue: 0,0:21:22.71,0:21:26.75,Default,,0000,0000,0000,,Жоқ. Бұл үшеуі жай ғана ұстап тұр.
Dialogue: 0,0:21:26.75,0:21:29.78,Default,,0000,0000,0000,,Олар мұны білмей ме?
Dialogue: 0,0:21:29.78,0:21:32.81,Default,,0000,0000,0000,,Бұған тіпті Сайяндар да таң қалды.
Dialogue: 0,0:21:32.81,0:21:34.83,Default,,0000,0000,0000,,Жаса!
Dialogue: 0,0:21:34.83,0:21:39.21,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:21:39.21,0:21:42.24,Default,,0000,0000,0000,,Даа~! (Жауынгер) Хаа!
Dialogue: 0,0:21:42.24,0:21:45.27,Default,,0000,0000,0000,,Ей! (Жауынгер) Сондай-ақ!
Dialogue: 0,0:21:45.27,0:21:48.27,Default,,0000,0000,0000,,Уау! Гуха!
Dialogue: 0,0:21:51.33,0:21:54.33,Default,,0000,0000,0000,,(оқ ату)
Dialogue: 0,0:21:56.38,0:21:59.41,Default,,0000,0000,0000,,Таа!
Dialogue: 0,0:21:59.41,0:22:02.41,Default,,0000,0000,0000,,Ха! (Бағыныңқы) Гуо ааа~!
Dialogue: 0,0:22:04.46,0:22:06.46,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:22:08.50,0:22:10.52,Default,,0000,0000,0000,,Таа!
Dialogue: 0,0:22:10.52,0:22:12.52,Default,,0000,0000,0000,,Уау! (Зарбон) Әй!
Dialogue: 0,0:22:17.59,0:22:21.63,Default,,0000,0000,0000,,Ха! Таа!
Dialogue: 0,0:22:21.63,0:22:25.67,Default,,0000,0000,0000,,Сіз нені айтасыз? Бұл 1000 жауынгерлік күші бар ма?
Dialogue: 0,0:22:25.67,0:22:27.69,Default,,0000,0000,0000,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:22:27.69,0:22:29.71,Default,,0000,0000,0000,,Ха!
Dialogue: 0,0:22:29.71,0:22:32.74,Default,,0000,0000,0000,,Не болып жатыр!? Үшеуі де 3000-ға дейін өсті.
Dialogue: 0,0:22:32.74,0:22:34.74,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:22:40.15,0:22:43.18,Default,,0000,0000,0000,,Иә. Уау, мұны істеу өте оңай.
Dialogue: 0,0:22:43.18,0:22:46.21,Default,,0000,0000,0000,,Түсіндік, Намек балалар→
Dialogue: 0,0:22:46.21,0:22:48.23,Default,,0000,0000,0000,,Олар өздерінің жауынгерлік күшін басқара алатын нәсіл.
Dialogue: 0,0:22:48.23,0:22:51.26,Default,,0000,0000,0000,,Бұл сирек кездесетін түрі.
Dialogue: 0,0:22:51.26,0:22:57.32,Default,,0000,0000,0000,,《Жарайды, бұны қосқанда тек үш бұзылмаған машина бар.》
Dialogue: 0,0:22:57.32,0:23:00.35,Default,,0000,0000,0000,,Балалар, менен аулақ жүріңдер.
Dialogue: 0,0:23:00.35,0:23:03.38,Default,,0000,0000,0000,,Не? (Ақсақал) Тезірек!
Dialogue: 0,0:23:03.38,0:23:06.41,Default,,0000,0000,0000,,Додориа мырза. Ха. →
Dialogue: 0,0:23:06.41,0:23:10.45,Default,,0000,0000,0000,,Сіз аянышты бейбақтар.
Dialogue: 0,0:23:10.45,0:23:14.45,Default,,0000,0000,0000,,Мазалама.
Dialogue: 0,0:23:16.51,0:23:19.54,Default,,0000,0000,0000,,Мен үшеуін де тазалай аламын ба?
Dialogue: 0,0:23:19.54,0:23:21.56,Default,,0000,0000,0000,,Өзіңізді еркін сезініңіз.
Dialogue: 0,0:23:21.56,0:23:24.56,Default,,0000,0000,0000,,Таа~! Апыр-ай!
Dialogue: 0,0:23:27.62,0:23:30.65,Default,,0000,0000,0000,,Эй, мына жігіт. Осындай тривиальды техникамен →
Dialogue: 0,0:23:30.65,0:23:33.68,Default,,0000,0000,0000,,Сен мені жеңе аламын деп ойлайсың ба?
Dialogue: 0,0:23:33.68,0:23:35.68,Default,,0000,0000,0000,,Таа~!
Dialogue: 0,0:23:40.09,0:23:44.13,Default,,0000,0000,0000,,Жоқ! Оның мақсаты барлаушы болды!
Dialogue: 0,0:23:44.13,0:23:46.15,Default,,0000,0000,0000,,Скаутер?
Dialogue: 0,0:23:46.15,0:23:50.19,Default,,0000,0000,0000,,А, бұл сіздің қарсыласыңыздың күші мен орналасқан жерін айта алатын машина.
Dialogue: 0,0:23:50.19,0:23:52.21,Default,,0000,0000,0000,,Мен көремін. Өйткені, олар →
Dialogue: 0,0:23:52.21,0:23:56.25,Default,,0000,0000,0000,,Біз Айдаһар шарларының нақты орнын білмейміз. →
Dialogue: 0,0:23:56.25,0:23:59.28,Default,,0000,0000,0000,,Намекиандарды барлаушымен іздеу →
Dialogue: 0,0:23:59.28,0:24:02.31,Default,,0000,0000,0000,,Оны күшпен алып кетіңіз. Сондықтан әлгі қарт →
Dialogue: 0,0:24:02.31,0:24:05.34,Default,,0000,0000,0000,,Мен барлаушыларымның бәрін жойдым.
Dialogue: 0,0:24:05.34,0:24:11.40,Default,,0000,0000,0000,,О...өзім~! →
Dialogue: 0,0:24:11.40,0:24:13.42,Default,,0000,0000,0000,,Уф…. →
Dialogue: 0,0:24:13.42,0:24:16.45,Default,,0000,0000,0000,,Әй, бәрі өлтірілді.
Dialogue: 0,0:24:16.45,0:24:20.49,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:24:20.49,0:24:22.51,Default,,0000,0000,0000,,№~.
Dialogue: 0,0:24:22.51,0:24:26.55,Default,,0000,0000,0000,,Уау~ Олардың бәрін өлтіріңіз~! →
Dialogue: 0,0:24:26.55,0:24:30.59,Default,,0000,0000,0000,,Мен бәрін өлтіремін!
Dialogue: 0,0:24:30.59,0:24:32.61,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:24:32.61,0:24:34.63,Default,,0000,0000,0000,,Ақсақалға қауіп!
Dialogue: 0,0:24:34.63,0:24:36.65,Default,,0000,0000,0000,,Уау! (Ақсақал) Ах!
Dialogue: 0,0:24:36.65,0:24:39.68,Default,,0000,0000,0000,,<Жүйрік ақсақалдың шабуылы. →
Dialogue: 0,0:24:39.68,0:24:44.73,Default,,0000,0000,0000,,Алайда бұл жаудың қаһарын тұтандырды. →
Dialogue: 0,0:24:44.73,0:24:47.76,Default,,0000,0000,0000,,Гохан мен Криллиннің көруден басқа амалы жоқ →
Dialogue: 0,0:24:47.76,0:24:49.76,Default,,0000,0000,0000,,Амал жоқ па?＞
Dialogue: 0,0:24:52.81,0:24:57.86,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:57.86,0:25:17.06,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:17.06,0:25:37.59,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:37.59,0:25:50.59,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:54.76,0:25:56.78,Default,,0000,0000,0000,,Сәлем, Гоку.
Dialogue: 0,0:25:56.78,0:26:00.82,Default,,0000,0000,0000,,Келуімізге 6 күн қалды, сондықтан ойланба, Криллин, Гохан.
Dialogue: 0,0:26:00.82,0:26:02.84,Default,,0000,0000,0000,,Әзірше күте тұрыңыз, Гохан. →
Dialogue: 0,0:26:02.84,0:26:04.86,Default,,0000,0000,0000,,Бізді тапсақ, өлтіреміз.
Dialogue: 0,0:26:04.86,0:26:06.88,Default,,0000,0000,0000,,Маған ұнамайды. Мен ол жігітті түсіремін!
Dialogue: 0,0:26:06.88,0:26:09.91,Default,,0000,0000,0000,,Ақымақ! Қаш, қаш!
Dialogue: 0,0:26:09.91,0:26:12.91,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»
Dialogue: 0,0:26:15.97,0:26:18.97,Default,,0000,0000,0000,,Мен де үндемеймін!
Dialogue: 0,0:26:20.47,0:26:26.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory