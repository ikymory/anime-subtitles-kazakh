Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.41,0:00:10.46,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:10.46,0:00:30.66,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:00:30.66,0:00:50.86,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:00:50.86,0:01:10.40,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:10.40,0:01:28.40,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:03:42.25,0:03:44.27,Default,,0000,0000,0000,,Какарот?
Dialogue: 0,0:03:44.27,0:03:46.29,Default,,0000,0000,0000,,Аа, төмен дәрежелі жауынгердің баласы→
Dialogue: 0,0:03:46.29,0:03:49.32,Default,,0000,0000,0000,,Оны алыстағы планетаға жіберуден басқа амалымыз қалмайды.
Dialogue: 0,0:03:49.32,0:03:51.32,Default,,0000,0000,0000,,Мен солай ойлаймын.
Dialogue: 0,0:03:54.37,0:03:58.41,Default,,0000,0000,0000,,<Вегета планетасында туған бала. →
Dialogue: 0,0:03:58.41,0:04:02.45,Default,,0000,0000,0000,,Оның әкесі мен анасы жұлдызы қазір →
Dialogue: 0,0:04:02.45,0:04:06.45,Default,,0000,0000,0000,,Сұрапыл жау жойылғалы жатыр>
Dialogue: 0,0:04:09.52,0:04:11.54,Default,,0000,0000,0000,,Фриза! (Солдат) Уау!
Dialogue: 0,0:04:11.54,0:04:13.56,Default,,0000,0000,0000,,Уау! →
Dialogue: 0,0:04:13.56,0:04:16.59,Default,,0000,0000,0000,,Иә! Ха! Ха! иә!
Dialogue: 0,0:04:16.59,0:04:18.61,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:04:18.61,0:04:21.64,Default,,0000,0000,0000,,Freeza!
Dialogue: 0,0:04:21.64,0:04:24.67,Default,,0000,0000,0000,,Бұл Фриэза-сама! (Солдат) Фриза-сама.
Dialogue: 0,0:04:24.67,0:04:27.70,Default,,0000,0000,0000,,Хехехе. Бұл бәрін өзгертеді.
Dialogue: 0,0:04:27.70,0:04:31.74,Default,,0000,0000,0000,,Вегета Какарот планетасының тағдыры→
Dialogue: 0,0:04:31.74,0:04:37.80,Default,,0000,0000,0000,,Сіздің де тағдырыңыз!
Dialogue: 0,0:04:37.80,0:04:41.80,Default,,0000,0000,0000,,Бұл соңы!
Dialogue: 0,0:04:45.21,0:04:47.23,Default,,0000,0000,0000,,Хохохохохо. →
Dialogue: 0,0:04:47.23,0:04:50.23,Default,,0000,0000,0000,,Хо-хо-хо-хо-хо!
Dialogue: 0,0:04:52.28,0:04:54.28,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:04:56.32,0:05:00.36,Default,,0000,0000,0000,,Хохохохохо.
Dialogue: 0,0:05:00.36,0:05:02.38,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:05:02.38,0:05:06.38,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:05:08.44,0:05:11.44,Default,,0000,0000,0000,,Бұл өтірік болғандықтан ба?>
Dialogue: 0,0:05:13.49,0:05:17.53,Default,,0000,0000,0000,,Какарот…. →
Dialogue: 0,0:05:17.53,0:05:20.56,Default,,0000,0000,0000,,Ха ха ха. →
Dialogue: 0,0:05:20.56,0:05:24.56,Default,,0000,0000,0000,,Какарот!
Dialogue: 0,0:05:26.62,0:05:28.64,Default,,0000,0000,0000,,Гува~!
Dialogue: 0,0:05:28.64,0:05:34.64,Default,,0000,0000,0000,,(Соқтығыс дыбысы)
Dialogue: 0,0:05:42.11,0:05:46.15,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:05:46.15,0:05:49.18,Default,,0000,0000,0000,,Хохохохо! →
Dialogue: 0,0:05:49.18,0:05:51.18,Default,,0000,0000,0000,,Хо-хо-хо-хо!
Dialogue: 0,0:05:53.22,0:05:56.25,Default,,0000,0000,0000,,《Менің ұлым Какарот. →
Dialogue: 0,0:05:56.25,0:05:58.27,Default,,0000,0000,0000,,Менің өсиетімді мұраға ал. →
Dialogue: 0,0:05:58.27,0:06:03.32,Default,,0000,0000,0000,,Сайяндар…Вегета планетасының жаулары→
Dialogue: 0,0:06:03.32,0:06:05.32,Default,,0000,0000,0000,,Сен мені өлтіресің! 》
Dialogue: 0,0:06:08.37,0:06:10.39,Default,,0000,0000,0000,,(Сұл Гокудың айқайы)
Dialogue: 0,0:06:10.39,0:06:13.42,Default,,0000,0000,0000,,<Осылайша, алыс планетадан→
Dialogue: 0,0:06:13.42,0:06:18.47,Default,,0000,0000,0000,,Жерге сәби қонды. →
Dialogue: 0,0:06:18.47,0:06:23.52,Default,,0000,0000,0000,,Бұл беймәлім тағдырдың арқалаған бала...＞
Dialogue: 0,0:06:23.52,0:06:26.55,Default,,0000,0000,0000,,Оның атын қояйық... Гоку.
Dialogue: 0,0:06:26.55,0:06:32.61,Default,,0000,0000,0000,,<Бұл Сон Гоку оқиғасы>
Dialogue: 0,0:06:32.61,0:06:34.63,Default,,0000,0000,0000,,Иә! Апыр-ай!
Dialogue: 0,0:06:34.63,0:06:39.68,Default,,0000,0000,0000,,<Жақсы өскен Сон Гоку Булмамен бірге→
Dialogue: 0,0:06:39.68,0:06:44.07,Default,,0000,0000,0000,,Оның 7-еуін жинасаң, кез келген тілек орындалады→
Dialogue: 0,0:06:44.07,0:06:50.07,Default,,0000,0000,0000,,Мен Айдаһар шарын табу үшін саяхатқа бара жатыр едім.＞
Dialogue: 0,0:06:53.16,0:06:57.20,Default,,0000,0000,0000,,<Сапар барысында мен көптеген достарды кездестірдім →
Dialogue: 0,0:06:57.20,0:07:03.20,Default,,0000,0000,0000,,Гоку қатты жаттығады және күш үшін күреседі＞
Dialogue: 0,0:07:07.30,0:07:11.34,Default,,0000,0000,0000,,<Әлемді жаулап алуды мақсат еткен жындармен күресте→
Dialogue: 0,0:07:11.34,0:07:17.40,Default,,0000,0000,0000,,Жекпе-жек данышпан Кариннің қол астында күшіңізді одан әрі арттырыңыз →
Dialogue: 0,0:07:17.40,0:07:20.43,Default,,0000,0000,0000,,Айдаһар доппен жасартылған →
Dialogue: 0,0:07:20.43,0:07:26.43,Default,,0000,0000,0000,,Ұлы жын Пикколоның амбициясы басылды>
Dialogue: 0,0:07:29.52,0:07:36.59,Default,,0000,0000,0000,,<Өлім алдында Пикколо артында ұрпақ қалдырды, бірақ→
Dialogue: 0,0:07:36.59,0:07:40.79,Default,,0000,0000,0000,,3 жылдан кейін Пикколоның Мажиниямен реинкарнациясы →
Dialogue: 0,0:07:40.79,0:07:43.99,Default,,0000,0000,0000,,Гоку көп өсті →
Dialogue: 0,0:07:43.99,0:07:46.02,Default,,0000,0000,0000,,Тағдырлы текетірес орын алады. →
Dialogue: 0,0:07:46.02,0:07:52.02,Default,,0000,0000,0000,,Өлімге толы күрестен кейін Гоку жеңіске жетеді.
Dialogue: 0,0:07:54.10,0:08:00.16,Default,,0000,0000,0000,,<Осыдан кейін бес жылдан астам уақыт өткен соң Гоку күтпеген жерден Чи-Чиге үйленді→
Dialogue: 0,0:08:00.16,0:08:04.16,Default,,0000,0000,0000,,Адамдар бейбіт өмір сүрді＞
Dialogue: 0,0:08:06.22,0:08:08.22,Default,,0000,0000,0000,,<Бірақ...>
Dialogue: 0,0:08:42.91,0:08:46.95,Default,,0000,0000,0000,,Гохан-чан! →
Dialogue: 0,0:08:46.95,0:08:49.98,Default,,0000,0000,0000,,Тамақ! →
Dialogue: 0,0:08:49.98,0:08:51.00,Default,,0000,0000,0000,,Гохан-чан!
Dialogue: 0,0:08:51.00,0:08:55.04,Default,,0000,0000,0000,,Иә! Ха! Ха! →
Dialogue: 0,0:08:55.04,0:08:58.07,Default,,0000,0000,0000,,Ура! Жеңілдік! →
Dialogue: 0,0:08:58.07,0:09:02.11,Default,,0000,0000,0000,,Ах... ой!
Dialogue: 0,0:09:02.11,0:09:04.13,Default,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:09:04.13,0:09:06.15,Default,,0000,0000,0000,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:09:06.15,0:09:08.15,Default,,0000,0000,0000,,Atta~!
Dialogue: 0,0:09:13.22,0:09:16.25,Default,,0000,0000,0000,,Гохан-чан!
Dialogue: 0,0:09:16.25,0:09:20.29,Default,,0000,0000,0000,,Иә? Қайтадан қош келдіңіз. Гоку Гохан ше?
Dialogue: 0,0:09:20.29,0:09:24.33,Default,,0000,0000,0000,,Күрсін, қарным ашты.
Dialogue: 0,0:09:24.33,0:09:28.37,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Гохан Чан, сен көрмедің бе?
Dialogue: 0,0:09:28.37,0:09:30.39,Default,,0000,0000,0000,,Не? О, мен оны көрмедім.
Dialogue: 0,0:09:30.39,0:09:33.42,Default,,0000,0000,0000,,Мм... Тамақтанып, тезірек шығуым керек→
Dialogue: 0,0:09:33.42,0:09:35.44,Default,,0000,0000,0000,,Мутен Рошилер тағатсыздана күтіп отыр.
Dialogue: 0,0:09:35.44,0:09:38.47,Default,,0000,0000,0000,,Жақсы! О, мен сені іздеймін.
Dialogue: 0,0:09:38.47,0:09:40.66,Default,,0000,0000,0000,,Менің ойымша, бұл соншалықты алыс емес.
Dialogue: 0,0:09:40.66,0:09:43.85,Default,,0000,0000,0000,,Иә, маған қалдырыңыз!
Dialogue: 0,0:09:43.85,0:09:45.85,Default,,0000,0000,0000,,Өтінемін!
Dialogue: 0,0:09:47.89,0:09:51.93,Default,,0000,0000,0000,,Ах! Ол әдемі.
Dialogue: 0,0:09:51.93,0:09:53.95,Default,,0000,0000,0000,,(құстардың сайрауы)
Dialogue: 0,0:09:53.95,0:09:57.99,Default,,0000,0000,0000,,Менің атым Гохан.
Dialogue: 0,0:09:57.99,0:10:00.02,Default,,0000,0000,0000,,О, күте тұрыңыз!
Dialogue: 0,0:10:00.02,0:10:02.02,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:10:07.09,0:10:09.11,Default,,0000,0000,0000,,Ува Ува Ува! Апыр-ай!
Dialogue: 0,0:10:09.11,0:10:14.11,Default,,0000,0000,0000,,Анашым! Әке!
Dialogue: 0,0:10:16.18,0:10:18.18,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:20.22,0:10:23.25,Default,,0000,0000,0000,,Ах! Апыр-ай!
Dialogue: 0,0:10:23.25,0:10:25.27,Default,,0000,0000,0000,,Гохан!
Dialogue: 0,0:10:25.27,0:10:29.27,Default,,0000,0000,0000,,Иә? Әй, бұл менің әкем!
Dialogue: 0,0:10:31.33,0:10:33.35,Default,,0000,0000,0000,,Буха!
Dialogue: 0,0:10:33.35,0:10:36.38,Default,,0000,0000,0000,,Күте тұрыңыз! Маған қазір көмектесуге рұқсат етіңіз!
Dialogue: 0,0:10:36.38,0:10:38.38,Default,,0000,0000,0000,,Гохан!
Dialogue: 0,0:10:41.77,0:10:43.79,Default,,0000,0000,0000,,Тағы да.
Dialogue: 0,0:10:43.79,0:10:45.79,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:47.83,0:10:51.87,Default,,0000,0000,0000,,Уау~ Әке!
Dialogue: 0,0:10:51.87,0:10:53.87,Default,,0000,0000,0000,,Гохан!
Dialogue: 0,0:11:01.97,0:11:03.99,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:11:03.99,0:11:08.04,Default,,0000,0000,0000,,Уау... Уау!
Dialogue: 0,0:11:08.04,0:11:11.07,Default,,0000,0000,0000,,Әке! Ах!
Dialogue: 0,0:11:11.07,0:11:13.09,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:11:13.09,0:11:16.12,Default,,0000,0000,0000,,Гохан!!
Dialogue: 0,0:11:16.12,0:11:18.14,Default,,0000,0000,0000,,Гохан!
Dialogue: 0,0:11:18.14,0:11:22.18,Default,,0000,0000,0000,,Әке, мен түсе алмаймын!
Dialogue: 0,0:11:22.18,0:11:28.24,Default,,0000,0000,0000,,Қорқынышты қорқынышты. Әке Уау!
Dialogue: 0,0:11:28.24,0:11:31.27,Default,,0000,0000,0000,,Уау, әке, мен қорықтым.
Dialogue: 0,0:11:31.27,0:11:35.31,Default,,0000,0000,0000,,Мен қорықтым, әке.
Dialogue: 0,0:11:35.31,0:11:40.52,Default,,0000,0000,0000,,Иә? Гохан сен...
Dialogue: 0,0:11:40.52,0:11:44.73,Default,,0000,0000,0000,,Иә? Онда қалай көтерілдің?
Dialogue: 0,0:11:44.73,0:11:47.76,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:47.76,0:11:50.79,Default,,0000,0000,0000,,Уау, білмеймін. Иә?
Dialogue: 0,0:11:50.79,0:11:55.84,Default,,0000,0000,0000,,Гохан үйге қайтайық. Мама уайымдап жатыр.
Dialogue: 0,0:11:55.84,0:11:57.86,Default,,0000,0000,0000,,Жақында Мастер Роши ағасының үйіне барады→
Dialogue: 0,0:11:57.86,0:12:01.90,Default,,0000,0000,0000,,Менің кетуім керек. Иә.
Dialogue: 0,0:12:01.90,0:12:07.96,Default,,0000,0000,0000,,Йойшо Йойшо Йойшо Йойшо.
Dialogue: 0,0:12:07.96,0:12:11.00,Default,,0000,0000,0000,,Иә. Тағы бір дем.
Dialogue: 0,0:12:11.00,0:12:13.00,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:23.12,0:12:26.12,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:12:28.17,0:12:31.20,Default,,0000,0000,0000,,Ах... →
Dialogue: 0,0:12:31.20,0:12:35.24,Default,,0000,0000,0000,,Хуи~ Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу... →
Dialogue: 0,0:12:35.24,0:12:37.26,Default,,0000,0000,0000,,♬~
Dialogue: 0,0:12:37.26,0:12:39.28,Default,,0000,0000,0000,,(Соқтығыс дыбысы)
Dialogue: 0,0:12:39.28,0:12:42.64,Default,,0000,0000,0000,,Дохья~! О!
Dialogue: 0,0:12:42.64,0:12:48.64,Default,,0000,0000,0000,,Не? Қазір не болды? Бұл метеорит пе? Бұл НЛО ма?
Dialogue: 0,0:13:03.85,0:13:09.91,Default,,0000,0000,0000,,Күрсін... Бұл метеорит емес. Не? Сатан алғыр.
Dialogue: 0,0:13:09.91,0:13:11.91,Default,,0000,0000,0000,,Уау….
Dialogue: 0,0:13:16.98,0:13:18.98,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:13:26.08,0:13:32.14,Default,,0000,0000,0000,,Ах... Уф... →
Dialogue: 0,0:13:32.14,0:13:35.17,Default,,0000,0000,0000,,Ах~. →
Dialogue: 0,0:13:35.17,0:13:41.23,Default,,0000,0000,0000,,Эй... Уф. →
Dialogue: 0,0:13:41.23,0:13:44.26,Default,,0000,0000,0000,,Уф…. →
Dialogue: 0,0:13:44.26,0:13:50.32,Default,,0000,0000,0000,,Хахаха…. Сен кімсің!? Сіз.
Dialogue: 0,0:13:50.32,0:13:53.35,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:13:53.35,0:13:57.39,Default,,0000,0000,0000,,Тек 5 ұрыс күші? Гомиме.
Dialogue: 0,0:13:57.39,0:14:01.43,Default,,0000,0000,0000,,Цк, маған жақындама! Мен түсіремін!
Dialogue: 0,0:14:01.43,0:14:03.45,Default,,0000,0000,0000,,Да~! (мылтық)
Dialogue: 0,0:14:03.45,0:14:05.45,Default,,0000,0000,0000,,Хун.
Dialogue: 0,0:14:08.50,0:14:11.53,Default,,0000,0000,0000,,Уау! →
Dialogue: 0,0:14:11.53,0:14:15.57,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:14:15.57,0:14:19.61,Default,,0000,0000,0000,,Хун. Қандай нәзік ұлт.
Dialogue: 0,0:14:19.61,0:14:21.63,Default,,0000,0000,0000,,Иә? →
Dialogue: 0,0:14:21.63,0:14:27.69,Default,,0000,0000,0000,,Үлкен күшке ие біреу бар. Қашықтық: 4880.
Dialogue: 0,0:14:27.69,0:14:30.69,Default,,0000,0000,0000,,Какарот!?
Dialogue: 0,0:15:49.51,0:15:51.53,Default,,0000,0000,0000,,Иә!?
Dialogue: 0,0:15:51.53,0:15:55.57,Default,,0000,0000,0000,,Не? Бұл күш.
Dialogue: 0,0:15:55.57,0:15:58.60,Default,,0000,0000,0000,,Бұл Сон Гоку болуы мүмкін бе?
Dialogue: 0,0:15:58.60,0:16:00.60,Default,,0000,0000,0000,,Бұл….
Dialogue: 0,0:16:08.70,0:16:10.70,Default,,0000,0000,0000,,Цк, жоқ!
Dialogue: 0,0:16:16.78,0:16:20.82,Default,,0000,0000,0000,,Цк. Какарот емес.
Dialogue: 0,0:16:20.82,0:16:24.86,Default,,0000,0000,0000,,Сіз кімсіз? Маған пайдасы бар ма?
Dialogue: 0,0:16:24.86,0:16:26.88,Default,,0000,0000,0000,,Сізге пайда жоқ.
Dialogue: 0,0:16:26.88,0:16:30.92,Default,,0000,0000,0000,,Онда не үшін келдің? Өлгің келе ме?
Dialogue: 0,0:16:30.92,0:16:34.96,Default,,0000,0000,0000,,Хе хехе ол сондай күшті.
Dialogue: 0,0:16:34.96,0:16:38.17,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:16:38.17,0:16:43.38,Default,,0000,0000,0000,,Иә? Жауынгерлік күш 322. Мұндай нәрсе болды ма?
Dialogue: 0,0:16:43.38,0:16:47.42,Default,,0000,0000,0000,,Бірақ ол менің жауым емес.
Dialogue: 0,0:16:47.42,0:16:50.45,Default,,0000,0000,0000,,Не? Сіз кіммен сөйлесіп тұрсыз? →
Dialogue: 0,0:16:50.45,0:16:52.47,Default,,0000,0000,0000,,Қарсыласыңды рингтен шығарып таста немесе оны әрекет ете алмайтындай күйге келтір
Dialogue: 0,0:16:52.47,0:16:56.47,Default,,0000,0000,0000,,Келіңіздер. Қарғыс атқыр...
Dialogue: 0,0:16:59.54,0:17:01.56,Default,,0000,0000,0000,,《Бұл жігіттің күші неде》
Dialogue: 0,0:17:01.56,0:17:04.59,Default,,0000,0000,0000,,Уу~ Зуа!
Dialogue: 0,0:17:04.59,0:17:06.61,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:17:06.61,0:17:08.61,Default,,0000,0000,0000,,Иә... Иә!?
Dialogue: 0,0:17:10.65,0:17:13.68,Default,,0000,0000,0000,,Бұл ақымақ қулық.
Dialogue: 0,0:17:13.68,0:17:16.71,Default,,0000,0000,0000,,Ол жай ғана шаңды көтере ме?
Dialogue: 0,0:17:16.71,0:17:21.76,Default,,0000,0000,0000,,Ах….
Dialogue: 0,0:17:21.76,0:17:27.82,Default,,0000,0000,0000,,Енді менің кезегім бе? Енді мен сізге техниканың үлгісін көрсетейін.
Dialogue: 0,0:17:27.82,0:17:31.86,Default,,0000,0000,0000,,Куу….
Dialogue: 0,0:17:31.86,0:17:33.88,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:33.88,0:17:36.91,Default,,0000,0000,0000,,Тағы бір ұлы күш бар. Ха!
Dialogue: 0,0:17:36.91,0:17:38.60,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:17:38.60,0:17:43.32,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:17:43.32,0:17:47.36,Default,,0000,0000,0000,,Сол жерде. Қашықтық: 12 909.
Dialogue: 0,0:17:47.36,0:17:52.41,Default,,0000,0000,0000,,Бұл үлкен. Бұл планетадағы ең үлкен күш.
Dialogue: 0,0:17:52.41,0:17:55.41,Default,,0000,0000,0000,,Бұл жолы Какарот.
Dialogue: 0,0:17:59.48,0:18:05.54,Default,,0000,0000,0000,,Уф! Хахаха….
Dialogue: 0,0:18:05.54,0:18:11.60,Default,,0000,0000,0000,,Ақымақ. Мен дірілдеп, қозғала алмадым.
Dialogue: 0,0:18:11.60,0:18:13.62,Default,,0000,0000,0000,,Қарғыс атсын... Уф.
Dialogue: 0,0:18:13.62,0:18:26.62,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:18:32.81,0:18:35.84,Default,,0000,0000,0000,,Сәлеметсіз бе, ұзақ уақыт!
Dialogue: 0,0:18:35.84,0:18:37.86,Default,,0000,0000,0000,,О. Бұлма мырза.
Dialogue: 0,0:18:37.86,0:18:40.22,Default,,0000,0000,0000,,Ойынға келуімді өтіндіңіз, мен келдім.
Dialogue: 0,0:18:40.22,0:18:44.26,Default,,0000,0000,0000,,Жоқ, жоқ, шынымен де біраз уақыт өтті.
Dialogue: 0,0:18:44.26,0:18:47.29,Default,,0000,0000,0000,,Бұл бұрынғысынша.
Dialogue: 0,0:18:47.29,0:18:52.34,Default,,0000,0000,0000,,Балалар, сендер суып қалдыңдар. Кел, ойнайсың десең, келемін.
Dialogue: 0,0:18:52.34,0:18:54.36,Default,,0000,0000,0000,,Иә. (Кәме-сеннин) Уау!
Dialogue: 0,0:18:54.36,0:18:56.38,Default,,0000,0000,0000,,Кәдесый тоқаштары.
Dialogue: 0,0:18:56.38,0:18:59.41,Default,,0000,0000,0000,,Бұл туралы көп уайымдаудың қажеті жоқ.
Dialogue: 0,0:18:59.41,0:19:03.41,Default,,0000,0000,0000,,Мен сол кеудеге қол тигізсем ғой...
Dialogue: 0,0:19:05.47,0:19:08.50,Default,,0000,0000,0000,,А, сен әлі де жақсы гаг жігітсің.
Dialogue: 0,0:19:08.50,0:19:10.52,Default,,0000,0000,0000,,Ол әлі тентек жігіт.
Dialogue: 0,0:19:10.52,0:19:13.55,Default,,0000,0000,0000,,Айтпақшы, Булма-сан, Ямча-санға не болды?
Dialogue: 0,0:19:13.55,0:19:17.59,Default,,0000,0000,0000,,Ке... Ямча? Сол ақымақ.
Dialogue: 0,0:19:17.59,0:19:20.62,Default,,0000,0000,0000,,Сіз ол жігіт туралы білесіз бе? Себебі мен есінен танып қалдым→
Dialogue: 0,0:19:20.62,0:19:23.65,Default,,0000,0000,0000,,Бүгін бәрі жиналады деп айтқан жоқпын.
Dialogue: 0,0:19:23.65,0:19:27.69,Default,,0000,0000,0000,,Онсыз да жасайық.
Dialogue: 0,0:19:27.69,0:19:30.72,Default,,0000,0000,0000,,Балалар, сендер төбелесесіңдер. Бұл рас.
Dialogue: 0,0:19:30.72,0:19:32.74,Default,,0000,0000,0000,,Айтпақшы, мырза түскі ас ше?
Dialogue: 0,0:19:32.74,0:19:34.76,Default,,0000,0000,0000,,5 жыл бұрын Теншинханды қуу→
Dialogue: 0,0:19:34.76,0:19:37.79,Default,,0000,0000,0000,,Ол бір жерге кетті. →
Dialogue: 0,0:19:37.79,0:19:39.79,Default,,0000,0000,0000,,Оу!
Dialogue: 0,0:19:41.16,0:19:47.22,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:19:47.22,0:19:52.27,Default,,0000,0000,0000,,《Қуат орны айтарлықтай жылдамдықпен қозғалады》
Dialogue: 0,0:19:52.27,0:19:57.32,Default,,0000,0000,0000,,Қараңдаршы, бұл Мутен Рошидің үйі.
Dialogue: 0,0:19:57.32,0:19:59.34,Default,,0000,0000,0000,,Yaho~.
Dialogue: 0,0:19:59.34,0:20:01.36,Default,,0000,0000,0000,,Ах. Міне бітті.
Dialogue: 0,0:20:01.36,0:20:03.38,Default,,0000,0000,0000,,Немересі. Гоку.
Dialogue: 0,0:20:03.38,0:20:05.40,Default,,0000,0000,0000,,Йо. Не? Сол бала.
Dialogue: 0,0:20:05.40,0:20:08.43,Default,,0000,0000,0000,,Сіз бала күтуші болып толық емес жұмыс күнін бастадыңыз ба?
Dialogue: 0,0:20:08.43,0:20:10.45,Default,,0000,0000,0000,,Ол Оланың баласы.
Dialogue: 0,0:20:10.45,0:20:12.47,Default,,0000,0000,0000,,Иә! (Каме-Сеннин) Гоку?
Dialogue: 0,0:20:12.47,0:20:15.47,Default,,0000,0000,0000,,Аа, дұрыс. Біртүрлі ме?
Dialogue: 0,0:20:17.52,0:20:21.56,Default,,0000,0000,0000,,Сора сәлемдесу. Иә? Сәлем.
Dialogue: 0,0:20:21.56,0:20:24.59,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:20:24.59,0:20:27.62,Default,,0000,0000,0000,,Ұлы: Оның есімі Гохан.
Dialogue: 0,0:20:27.62,0:20:29.64,Default,,0000,0000,0000,,Сон Гохан….
Dialogue: 0,0:20:29.64,0:20:32.67,Default,,0000,0000,0000,,О, түсіндім. Сіз оны қайтыс болған атаңыздың атын қойдыңыз.
Dialogue: 0,0:20:32.67,0:20:34.69,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:20:34.69,0:20:36.71,Default,,0000,0000,0000,,Бірақ бұл таңқаларлық. →
Dialogue: 0,0:20:36.71,0:20:39.07,Default,,0000,0000,0000,,Гоку баланы өзімен бірге алып келеді.
Dialogue: 0,0:20:39.07,0:20:43.11,Default,,0000,0000,0000,,Сен нешедесің, Гохан?
Dialogue: 0,0:20:43.11,0:20:45.13,Default,,0000,0000,0000,,Мен 4 жастамын.
Dialogue: 0,0:20:45.13,0:20:48.16,Default,,0000,0000,0000,,Әй, немереңнің баласына әдепті екенсің.
Dialogue: 0,0:20:48.16,0:20:52.20,Default,,0000,0000,0000,,Чичидің жігіті ренжітеді. Хмм. →
Dialogue: 0,0:20:52.20,0:20:56.24,Default,,0000,0000,0000,,Эй Гохан, сен өскенде кім боласың?
Dialogue: 0,0:20:56.24,0:20:58.26,Default,,0000,0000,0000,,Ұлы ғұлама.
Dialogue: 0,0:20:58.26,0:21:02.26,Default,,0000,0000,0000,,Гах, ғұлама... Әй.
Dialogue: 0,0:21:04.32,0:21:06.34,Default,,0000,0000,0000,,Иә? Құйрық.
Dialogue: 0,0:21:06.34,0:21:09.37,Default,,0000,0000,0000,,Әй, бұл бұрынғыдай, солай емес пе?
Dialogue: 0,0:21:09.37,0:21:11.37,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:21:13.41,0:21:19.47,Default,,0000,0000,0000,,Эй, эй, бұл балада ерекше бір оғаш нәрсе болып жатыр ма?
Dialogue: 0,0:21:19.47,0:21:21.49,Default,,0000,0000,0000,,Біртүрлі нәрсе бар ма?
Dialogue: 0,0:21:21.49,0:21:25.53,Default,,0000,0000,0000,,Мысалы, толық ай түнінде өзгеріс болады ма?
Dialogue: 0,0:21:25.53,0:21:30.53,Default,,0000,0000,0000,,Толық ай түні? Жүр, Ораншы, мен ерте жатайын.
Dialogue: 0,0:21:32.60,0:21:34.62,Default,,0000,0000,0000,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:21:34.62,0:21:36.64,Default,,0000,0000,0000,,Жоқ, бұл ештеңе емес, онда бәрі жақсы.
Dialogue: 0,0:21:36.64,0:21:40.02,Default,,0000,0000,0000,,Эй Гоку, ол сен сияқты күшті ме?
Dialogue: 0,0:21:40.02,0:21:42.04,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:21:42.04,0:21:47.09,Default,,0000,0000,0000,,Менің ойымша, оның біраз күші болуы керек.→
Dialogue: 0,0:21:47.09,0:21:51.13,Default,,0000,0000,0000,,Ора Гоханды жаттықтырмақ болған кезде Чи-Чидің жігіті ашуланады.
Dialogue: 0,0:21:51.13,0:21:53.15,Default,,0000,0000,0000,,Тас, қағаз, қайшы.
Dialogue: 0,0:21:53.15,0:21:58.20,Default,,0000,0000,0000,,Неліктен? Бұл ысырап емес пе? Дұрыс па? Сол жігіт →
Dialogue: 0,0:21:58.20,0:22:03.25,Default,,0000,0000,0000,,Қазір әлем бейбітшілікке айналғандықтан, жекпе-жек өнері қажет емес.
Dialogue: 0,0:22:03.25,0:22:06.28,Default,,0000,0000,0000,,Бұдан былай оқу уақыты келді.
Dialogue: 0,0:22:06.28,0:22:10.32,Default,,0000,0000,0000,,Хахахаха! Сол секірген қыз →
Dialogue: 0,0:22:10.32,0:22:13.35,Default,,0000,0000,0000,,Менің ойымша, ол өте тәрбиелі ана болды.
Dialogue: 0,0:22:13.35,0:22:16.38,Default,,0000,0000,0000,,Әке.
Dialogue: 0,0:22:16.38,0:22:20.42,Default,,0000,0000,0000,,Эй, Гохан, бұл айдаһар шарлары сенің қалпағыңда ма?
Dialogue: 0,0:22:20.42,0:22:24.46,Default,,0000,0000,0000,,Аа, бұл төрт жұлдызды доп. Бұл менің атамның естелігі.
Dialogue: 0,0:22:24.46,0:22:27.49,Default,,0000,0000,0000,,Мен оны тауып алдым да кидім.
Dialogue: 0,0:22:27.49,0:22:31.53,Default,,0000,0000,0000,,Сонымен қатар, мен Сансей шарын және Рокусей шарын таптым→
Dialogue: 0,0:22:31.53,0:22:34.56,Default,,0000,0000,0000,,Оны үйде қалдырыңыз.
Dialogue: 0,0:22:34.56,0:22:38.56,Default,,0000,0000,0000,,Бұл маған Айдаһар допты еске түсіреді, иә?
Dialogue: 0,0:22:40.95,0:22:42.97,Default,,0000,0000,0000,,Иә? Не?
Dialogue: 0,0:22:42.97,0:22:46.01,Default,,0000,0000,0000,,Не болды? Осы жақта бір нәрсе келе жатыр.
Dialogue: 0,0:22:46.01,0:22:48.01,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:22:51.06,0:22:54.09,Default,,0000,0000,0000,,Бірдеңе келе ме?
Dialogue: 0,0:22:54.09,0:22:58.09,Default,,0000,0000,0000,,《Таңғажайып... мені таңғажайып күшті сезінетін нәрсе! 》
Dialogue: 0,0:23:04.19,0:23:07.22,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:23:07.22,0:23:09.24,Default,,0000,0000,0000,,Спорт күні керемет өтті, иә?
Dialogue: 0,0:23:09.24,0:23:11.26,Default,,0000,0000,0000,,Бұл жерде!
Dialogue: 0,0:23:11.26,0:23:14.26,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:23:16.31,0:23:18.31,Default,,0000,0000,0000,,《Бұл кім!?》
Dialogue: 0,0:23:20.35,0:23:23.38,Default,,0000,0000,0000,,《Бұл қорқынышты кісі өлтіру ниеті не? 》
Dialogue: 0,0:23:23.38,0:23:37.52,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:37.52,0:23:40.52,Default,,0000,0000,0000,,Біз ақыры кездестік пе?
Dialogue: 0,0:23:43.91,0:23:45.93,Default,,0000,0000,0000,,Сіз өстіңіз.
Dialogue: 0,0:23:45.93,0:23:49.97,Default,,0000,0000,0000,,Бірақ мен мұны бір қарағанда білдім, Какарот.
Dialogue: 0,0:23:49.97,0:23:52.00,Default,,0000,0000,0000,,Какарот?
Dialogue: 0,0:23:52.00,0:23:54.02,Default,,0000,0000,0000,,Ол әкесіне ұқсайды.
Dialogue: 0,0:23:54.02,0:23:57.05,Default,,0000,0000,0000,,CRT шеберханасының жартылай жұмысшысы…
Dialogue: 0,0:23:57.05,0:24:00.08,Default,,0000,0000,0000,,Не? Бұл жігіт не деді?
Dialogue: 0,0:24:00.08,0:24:03.11,Default,,0000,0000,0000,,Какарот Бұл планетаның күйі қандай?
Dialogue: 0,0:24:03.11,0:24:07.15,Default,,0000,0000,0000,,Сіздің міндетіңіз адамзатты жою болуы керек еді. →
Dialogue: 0,0:24:07.15,0:24:10.15,Default,,0000,0000,0000,,Сен немен ойнадың?
Dialogue: 0,0:24:13.21,0:24:17.25,Default,,0000,0000,0000,,Әй, эй, қайда екеніңді білмеймін, бірақ→
Dialogue: 0,0:24:17.25,0:24:19.27,Default,,0000,0000,0000,,Қайтарылды Қайтарылды.
Dialogue: 0,0:24:19.27,0:24:22.30,Default,,0000,0000,0000,,Тыныш.
Dialogue: 0,0:24:22.30,0:24:27.35,Default,,0000,0000,0000,,Күндіз болды, сондықтан мен мас болмас едім.
Dialogue: 0,0:24:27.35,0:24:29.37,Default,,0000,0000,0000,,Криллин, аулақ жүр!
Dialogue: 0,0:24:29.37,0:24:31.37,Default,,0000,0000,0000,,Гва!
Dialogue: 0,0:24:34.42,0:24:36.44,Default,,0000,0000,0000,,Криллин!
Dialogue: 0,0:24:36.44,0:24:38.63,Default,,0000,0000,0000,,Ендеше, мен де саған сенемін
Dialogue: 0,0:24:38.63,0:24:40.82,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:24:40.82,0:24:42.84,Default,,0000,0000,0000,,♬~
Dialogue: 0,0:24:42.84,0:24:46.88,Default,,0000,0000,0000,,<Құйрықты адам пайда болды. →
Dialogue: 0,0:24:46.88,0:24:49.88,Default,,0000,0000,0000,,Оның қорқынышты шынайы тұлғасы қандай?＞
Dialogue: 0,0:24:51.93,0:24:56.98,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:56.98,0:25:16.18,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:16.18,0:25:36.38,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:36.38,0:25:49.38,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:51.53,0:25:53.55,Default,,0000,0000,0000,,Сәлем, Гоку! Оның Ора → сияқты құйрығы бар
Dialogue: 0,0:25:53.55,0:25:56.58,Default,,0000,0000,0000,,Сен кімсің? Какаротты еске түсіріңіз. →
Dialogue: 0,0:25:56.58,0:25:59.61,Default,,0000,0000,0000,,Сіздің миссияңыз және Сайяндардың мақтанышы!
Dialogue: 0,0:25:59.61,0:26:01.63,Default,,0000,0000,0000,,Әке, көмектесіңізші!
Dialogue: 0,0:26:01.63,0:26:06.68,Default,,0000,0000,0000,,Ұлыңның өміріне қауіп төніп тұрса, ағаңның бұйрығын орында.
Dialogue: 0,0:26:06.68,0:26:09.68,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»….
Dialogue: 0,0:26:11.73,0:26:13.73,Default,,0000,0000,0000,,Міндетті түрде тексеріңіз!
Dialogue: 0,0:26:15.23,0:26:21.23,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory