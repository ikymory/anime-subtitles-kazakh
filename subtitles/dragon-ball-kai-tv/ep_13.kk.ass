Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.65,0:00:10.65,Default,,0000,0000,0000,,<Сон Гоку қайтып келіп, Наппаны жеңеді>
Dialogue: 0,0:00:14.74,0:00:17.77,Default,,0000,0000,0000,,Ақымақ! Бұл менің ең жақсы шеберлігім.
Dialogue: 0,0:00:17.77,0:00:20.80,Default,,0000,0000,0000,,Жетеді! Сізге түсініксіз. →
Dialogue: 0,0:00:20.80,0:00:22.82,Default,,0000,0000,0000,,Мен оны тазалаймын. Не!?
Dialogue: 0,0:00:22.82,0:00:26.86,Default,,0000,0000,0000,,Ол аянышты. Мен бұл Какаротқа қарсы болады деп ешқашан күтпедім →
Dialogue: 0,0:00:26.86,0:00:29.86,Default,,0000,0000,0000,,Қозғалу үшін менің жолымнан шығуыма ешқандай себеп жоқ.
Dialogue: 0,0:00:31.91,0:00:36.96,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:36.96,0:00:57.16,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:00:57.16,0:01:16.70,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:16.70,0:01:36.90,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:36.90,0:01:53.90,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:15.48,0:04:19.52,Default,,0000,0000,0000,,Ух... tsk tsk шоуы.
Dialogue: 0,0:04:19.52,0:04:24.57,Default,,0000,0000,0000,,Бәс, мен сіздің өлім жазасын Вегетаға тапсырып жатқаныма сенбеймін. →
Dialogue: 0,0:04:24.57,0:04:27.60,Default,,0000,0000,0000,,Бұл бұйрық болғандықтан, мен оны Вегетаға қалдырамын. →
Dialogue: 0,0:04:27.60,0:04:30.63,Default,,0000,0000,0000,,Бірақ мен осылай шегінсем, мен де қуанбаймын.
Dialogue: 0,0:04:30.63,0:04:34.63,Default,,0000,0000,0000,,Хэхехе. Урья~! (Гоку ұлы) Жоқ! Екі адам!
Dialogue: 0,0:04:37.70,0:04:40.73,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:04:40.73,0:04:43.76,Default,,0000,0000,0000,,Жоқ, мен уақытында үлгере алмаймын. Апыр-ай.
Dialogue: 0,0:04:43.76,0:04:45.78,Default,,0000,0000,0000,,Урья~!
Dialogue: 0,0:04:45.78,0:04:47.80,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:04:47.80,0:04:50.83,Default,,0000,0000,0000,,Кайокен!
Dialogue: 0,0:04:50.83,0:04:52.83,Default,,0000,0000,0000,,Не!?
Dialogue: 0,0:04:55.88,0:04:57.88,Default,,0000,0000,0000,,Ах….
Dialogue: 0,0:05:01.94,0:05:06.94,Default,,0000,0000,0000,,Ах... Ах...
Dialogue: 0,0:05:12.39,0:05:17.44,Default,,0000,0000,0000,,Уф! Ааааааааа... Чикусо.
Dialogue: 0,0:05:17.44,0:05:20.47,Default,,0000,0000,0000,,Мен енді төбелесе алмауым керек.
Dialogue: 0,0:05:20.47,0:05:24.51,Default,,0000,0000,0000,,Ол затты өзіңізбен бірге алып, жерден жоғалып кетіңіз.
Dialogue: 0,0:05:24.51,0:05:26.53,Default,,0000,0000,0000,,《Бұл не? →
Dialogue: 0,0:05:26.53,0:05:30.53,Default,,0000,0000,0000,,Бір мезетте жылдамдық та, қуат та жылдам өсті.
Dialogue: 0,0:05:32.59,0:05:35.62,Default,,0000,0000,0000,,Гоку Гоку, сен не істедің?
Dialogue: 0,0:05:35.62,0:05:38.65,Default,,0000,0000,0000,,Кай патша біреу үйреткен әдіс пе?
Dialogue: 0,0:05:38.65,0:05:42.69,Default,,0000,0000,0000,,А, бұл Кайо-кен.
Dialogue: 0,0:05:42.69,0:05:45.72,Default,,0000,0000,0000,,Денеңіздегі барлық энергияны басқарыңыз→
Dialogue: 0,0:05:45.72,0:05:47.74,Default,,0000,0000,0000,,Оны бірден күшейтіңіз.
Dialogue: 0,0:05:47.74,0:05:51.78,Default,,0000,0000,0000,,Іс жақсы болса, күш, жылдамдық, жойқын күш және қорғаныс күші →
Dialogue: 0,0:05:51.78,0:05:54.81,Default,,0000,0000,0000,,Барлығы бірнеше есе көбейеді.
Dialogue: 0,0:05:54.81,0:06:00.87,Default,,0000,0000,0000,,Керемет! Қолымды сонша көтерсем де, әлі де сан есе күшті бола аламын ба деп ойлаймын.
Dialogue: 0,0:06:00.87,0:06:04.91,Default,,0000,0000,0000,,Ах. Гоку да жаман адам.
Dialogue: 0,0:06:04.91,0:06:06.26,Default,,0000,0000,0000,,Ойнайтын уақыт емес шығар.
Dialogue: 0,0:06:06.26,0:06:10.30,Default,,0000,0000,0000,,Егер сізде осындай нәрсе болса, оны басынан бастап жасаңыз.
Dialogue: 0,0:06:10.30,0:06:13.33,Default,,0000,0000,0000,,Хехе, бұл өте жаман. Бұл мүмкін емес.
Dialogue: 0,0:06:13.33,0:06:16.36,Default,,0000,0000,0000,,Сіз өз ойыңызды бақылауда ұстап, оны бақылауыңыз керек →
Dialogue: 0,0:06:16.36,0:06:19.39,Default,,0000,0000,0000,,Оланың өзі өледі. (Гохан/Криллин) Иә?
Dialogue: 0,0:06:19.39,0:06:21.41,Default,,0000,0000,0000,,Басқаша айтқанда….
Dialogue: 0,0:06:21.41,0:06:23.43,Default,,0000,0000,0000,,《Айтқанымдай, қазіргі деңгейде→
Dialogue: 0,0:06:23.43,0:06:26.46,Default,,0000,0000,0000,,Кайокенді жиі қолдануға болмайды. →
Dialogue: 0,0:06:26.46,0:06:31.51,Default,,0000,0000,0000,,Оны дұрыс басқармасаң, өзіңді құртасың. →
Dialogue: 0,0:06:31.51,0:06:34.54,Default,,0000,0000,0000,,Оны кем дегенде екі есе күшті етіңіз. →
Dialogue: 0,0:06:34.54,0:06:37.57,Default,,0000,0000,0000,,Жақсы, одан асып түсетін Қайокең →
Dialogue: 0,0:06:37.57,0:06:40.60,Default,,0000,0000,0000,,Бұл сіздің денеңізге тым көп жүк. →
Dialogue: 0,0:06:40.60,0:06:43.63,Default,,0000,0000,0000,,Басқаша айтқанда, менің денем Кайокеңге ілесе алмады→
Dialogue: 0,0:06:43.63,0:06:48.68,Default,,0000,0000,0000,,Тат үшін тит болады.》 《Иә, түсінемін.》
Dialogue: 0,0:06:48.68,0:06:51.71,Default,,0000,0000,0000,,...Сондықтан. Мен түсінемін.
Dialogue: 0,0:06:51.71,0:06:56.76,Default,,0000,0000,0000,,Вегета, маған көмектесші. →
Dialogue: 0,0:06:56.76,0:06:59.76,Default,,0000,0000,0000,,Ах….
Dialogue: 0,0:07:01.81,0:07:06.02,Default,,0000,0000,0000,,Кешіріңіз...хехехе.
Dialogue: 0,0:07:06.02,0:07:09.22,Default,,0000,0000,0000,,Хмф! Эй... →
Dialogue: 0,0:07:09.22,0:07:12.25,Default,,0000,0000,0000,,Хехе. Апыр-ай.
Dialogue: 0,0:07:12.25,0:07:14.27,Default,,0000,0000,0000,,(Наширо) Рей (Джузо Сузуя) Хм?
Dialogue: 0,0:07:14.27,0:07:19.32,Default,,0000,0000,0000,,Не... Вегета! Вегета!!
Dialogue: 0,0:07:19.32,0:07:22.35,Default,,0000,0000,0000,,Бізге қозғала алмайтын сайандар керек емес!
Dialogue: 0,0:07:22.35,0:07:25.38,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:07:25.38,0:07:30.43,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:07:30.43,0:07:34.47,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:07:34.47,0:07:38.51,Default,,0000,0000,0000,,Сәлем, әке. Не? Не?
Dialogue: 0,0:07:38.51,0:07:40.51,Default,,0000,0000,0000,,Толық кауль!
Dialogue: 0,0:07:43.56,0:07:47.60,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:07:47.60,0:07:51.64,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:07:51.64,0:07:54.67,Default,,0000,0000,0000,,Вегета болыңыз!
Dialogue: 0,0:07:54.67,0:07:57.70,Default,,0000,0000,0000,,Хахаха.
Dialogue: 0,0:07:57.70,0:08:00.73,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:00.73,0:08:05.73,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:08:18.25,0:08:21.28,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:08:21.28,0:08:25.32,Default,,0000,0000,0000,,Тіпті өзінің жолдастарын да өлтірді.
Dialogue: 0,0:08:25.32,0:08:28.32,Default,,0000,0000,0000,,Ааааа….
Dialogue: 0,0:08:30.37,0:08:33.40,Default,,0000,0000,0000,,Ах….
Dialogue: 0,0:08:33.40,0:08:35.42,Default,,0000,0000,0000,,Гохан Криллин.
Dialogue: 0,0:08:35.42,0:08:40.47,Default,,0000,0000,0000,,Екеуің тез арада тасбақа үйіне оралыңдар.
Dialogue: 0,0:08:40.47,0:08:43.50,Default,,0000,0000,0000,,Не? Иә?
Dialogue: 0,0:08:43.50,0:08:45.52,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:08:45.52,0:08:48.55,Default,,0000,0000,0000,,Гохан Сіз мұны естідіңіз. Тез барайық.
Dialogue: 0,0:08:48.55,0:08:51.58,Default,,0000,0000,0000,,Не? Өйткені...
Dialogue: 0,0:08:51.58,0:08:53.60,Default,,0000,0000,0000,,Гохан: Бұл жігіт тым керемет.
Dialogue: 0,0:08:53.60,0:08:56.63,Default,,0000,0000,0000,,Біз болсақ та, оның еш пайдасы болмас еді.
Dialogue: 0,0:08:56.63,0:08:59.66,Default,,0000,0000,0000,,Біз сонда болғандықтан, Гоку шынымен де мұқият болды→
Dialogue: 0,0:08:59.66,0:09:01.68,Default,,0000,0000,0000,,Бұл жай ғана кедергі жасайды.
Dialogue: 0,0:09:01.68,0:09:05.88,Default,,0000,0000,0000,,Шынымен бе? әке.
Dialogue: 0,0:09:05.88,0:09:10.10,Default,,0000,0000,0000,,Кешіріңіз. Оның күші мен күткеннен де асып түсті.
Dialogue: 0,0:09:10.10,0:09:15.15,Default,,0000,0000,0000,,Уф... Иә, түсіндім.
Dialogue: 0,0:09:15.15,0:09:20.20,Default,,0000,0000,0000,,Дұрыс, Гоку. Орын ауыстырып ұрыспайсың ба?
Dialogue: 0,0:09:20.20,0:09:23.23,Default,,0000,0000,0000,,Бәрінің мәйіті быт-шыт болып кетсе ше→
Dialogue: 0,0:09:23.23,0:09:26.26,Default,,0000,0000,0000,,Мен өмірге оралғанда Өйткені бұл жаман.
Dialogue: 0,0:09:26.26,0:09:28.28,Default,,0000,0000,0000,,«Өмірге оралғанда»→
Dialogue: 0,0:09:28.28,0:09:31.31,Default,,0000,0000,0000,,Пикколо өлген кезде Құдай да өлді.
Dialogue: 0,0:09:31.31,0:09:35.35,Default,,0000,0000,0000,,Айдаһар шарлары мәңгілікке жоғалды.
Dialogue: 0,0:09:35.35,0:09:39.39,Default,,0000,0000,0000,,Өкінішке орай, әрбір адам ешқашан өмірге оралмайды.
Dialogue: 0,0:09:39.39,0:09:42.42,Default,,0000,0000,0000,,А, мен мұны білемін.
Dialogue: 0,0:09:42.42,0:09:45.45,Default,,0000,0000,0000,,Кукуририн-сан, кездейсоқ...
Dialogue: 0,0:09:45.45,0:09:48.48,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:09:48.48,0:09:51.51,Default,,0000,0000,0000,,Мәліметтерді кейінірек айтамын.
Dialogue: 0,0:09:51.51,0:09:54.54,Default,,0000,0000,0000,,Гоку ол жігітті жеңе алса...
Dialogue: 0,0:09:54.54,0:10:00.60,Default,,0000,0000,0000,,«Егер мен жеңе алсам»... Қалай болғанда да, мен жеңуім керек.
Dialogue: 0,0:10:00.60,0:10:02.60,Default,,0000,0000,0000,,Кез келген жағдайда.
Dialogue: 0,0:10:05.31,0:10:09.02,Default,,0000,0000,0000,,Сіз не істеп жатырсыз? Бұрынғы серпініңізге не болды?
Dialogue: 0,0:10:09.02,0:10:12.05,Default,,0000,0000,0000,,Қорқыныштан қашу туралы айтып тұрсың ба?
Dialogue: 0,0:10:12.05,0:10:16.09,Default,,0000,0000,0000,,Олай болса, орынды өзгертіп, бар күшімізді салып көрейік.
Dialogue: 0,0:10:16.09,0:10:19.12,Default,,0000,0000,0000,,Әйтеуір, маған қалдырыңыз. Иә?
Dialogue: 0,0:10:19.12,0:10:24.17,Default,,0000,0000,0000,,Гоку. Өкініштісі, тағдырымды тек саған тапсырамын.
Dialogue: 0,0:10:24.17,0:10:27.17,Default,,0000,0000,0000,,Ешқашан өлме, ең жақын досым.
Dialogue: 0,0:10:30.23,0:10:32.23,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:10:34.27,0:10:38.31,Default,,0000,0000,0000,,Әке. Гохан.
Dialogue: 0,0:10:38.31,0:10:43.36,Default,,0000,0000,0000,,Әкем тірі келсе, тағы бірге балық аулауға барайық.
Dialogue: 0,0:10:43.36,0:10:46.39,Default,,0000,0000,0000,,Ах….
Dialogue: 0,0:10:46.39,0:10:48.39,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:10:53.46,0:10:58.51,Default,,0000,0000,0000,,Хахахаха. Қашудың қажеті жоқ екенін білетін сияқтысыз.
Dialogue: 0,0:10:58.51,0:11:01.54,Default,,0000,0000,0000,,Ұрысатын жерімізді өзгертейік.
Dialogue: 0,0:11:01.54,0:11:05.54,Default,,0000,0000,0000,,Өзіңе ұнайтын нәрсені істе, ол да солай.
Dialogue: 0,0:11:08.94,0:11:10.94,Default,,0000,0000,0000,,Әке.
Dialogue: 0,0:11:24.10,0:11:28.10,Default,,0000,0000,0000,,《Күтілгендей, олар оңай жүреді》
Dialogue: 0,0:11:38.24,0:11:40.26,Default,,0000,0000,0000,,Гохан. →
Dialogue: 0,0:11:40.26,0:11:43.29,Default,,0000,0000,0000,,Сәлем Гохан. Иә!
Dialogue: 0,0:11:43.29,0:11:47.29,Default,,0000,0000,0000,,Тезірек тасбақа үйіне қайтайық. Иә….
Dialogue: 0,0:11:49.35,0:11:51.37,Default,,0000,0000,0000,,Уайымдайтын кез келді.
Dialogue: 0,0:11:51.37,0:11:56.42,Default,,0000,0000,0000,,Жердің тағдыры оның қолында.
Dialogue: 0,0:11:56.42,0:11:58.44,Default,,0000,0000,0000,,Жарайды, Гохан.
Dialogue: 0,0:11:58.44,0:12:02.48,Default,,0000,0000,0000,,Гоку мұны істейтініне сенімдімін.
Dialogue: 0,0:12:02.48,0:12:07.87,Default,,0000,0000,0000,,Кеттік. Анаңызға қаншалықты жақсы екеніңізді мүмкіндігінше тезірек көрсетіңіз.
Dialogue: 0,0:12:07.87,0:12:10.87,Default,,0000,0000,0000,,Иә. Иә.
Dialogue: 0,0:12:12.92,0:12:14.92,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:12:17.97,0:12:22.97,Default,,0000,0000,0000,,《Бұл жерде жақсы болар еді, адамдар да, жануарлар да жоқ.》
Dialogue: 0,0:12:28.08,0:12:30.10,Default,,0000,0000,0000,,Мен көремін. →
Dialogue: 0,0:12:30.10,0:12:37.10,Default,,0000,0000,0000,,Сонда зират ретінде осы жерді таңдадың ба? Хехехе.
Dialogue: 0,0:12:39.19,0:12:44.24,Default,,0000,0000,0000,,Қуаныңыз! Сіз сияқты төмен санатты жауынгер →
Dialogue: 0,0:12:44.24,0:12:48.24,Default,,0000,0000,0000,,Сіз өзіңізбен супер элита ойнай аласыз.
Dialogue: 0,0:12:51.31,0:12:55.35,Default,,0000,0000,0000,,Сайандар туылғаннан кейін олардың жауынгерлік қасиеттері сыналады.
Dialogue: 0,0:12:55.35,0:13:00.40,Default,,0000,0000,0000,,Ол кездегі мән төмен. Сен сияқты ақымақ →
Dialogue: 0,0:13:00.40,0:13:03.43,Default,,0000,0000,0000,,Ол негізгі жаулары жоқ планетаға жіберіледі. →
Dialogue: 0,0:13:03.43,0:13:07.80,Default,,0000,0000,0000,,Қысқасы, сен сәтсіздікке ұшырадың!
Dialogue: 0,0:13:07.80,0:13:10.83,Default,,0000,0000,0000,,Соның арқасында Ола бұл жерге келді.
Dialogue: 0,0:13:10.83,0:13:13.86,Default,,0000,0000,0000,,Мен риза болуым керек. Міне →
Dialogue: 0,0:13:13.86,0:13:15.88,Default,,0000,0000,0000,,Артында қалсаңыз да, бар күшіңізді салыңыз →
Dialogue: 0,0:13:15.88,0:13:18.91,Default,,0000,0000,0000,,Элитадан асып түсуге болатын шығар.
Dialogue: 0,0:13:18.91,0:13:23.96,Default,,0000,0000,0000,,Хехехехе Күлкілі әзіл екен. →
Dialogue: 0,0:13:23.96,0:13:27.00,Default,,0000,0000,0000,,Сонда жалғыз күшпен еңсерілмейтін қабырғалар бар→
Dialogue: 0,0:13:27.00,0:13:29.02,Default,,0000,0000,0000,,Сізге көрсетейін!
Dialogue: 0,0:13:29.02,0:13:31.04,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:13:31.04,0:13:40.04,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:15:12.71,0:15:16.75,Default,,0000,0000,0000,,Фуууря~!
Dialogue: 0,0:15:16.75,0:15:18.77,Default,,0000,0000,0000,,Дада да да…!
Dialogue: 0,0:15:18.77,0:15:22.77,Default,,0000,0000,0000,,Да-да-да-да... Торя~!
Dialogue: 0,0:15:24.83,0:15:26.85,Default,,0000,0000,0000,,Уау! Ха.
Dialogue: 0,0:15:26.85,0:15:28.85,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:15:32.91,0:15:34.93,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:34.93,0:15:36.95,Default,,0000,0000,0000,,Тааааа!
Dialogue: 0,0:15:36.95,0:15:38.97,Default,,0000,0000,0000,,Дада да…! Дадада...!
Dialogue: 0,0:15:38.97,0:15:43.01,Default,,0000,0000,0000,,Не болды? Какарот: Бұл соншалықты жаман емес шығар.
Dialogue: 0,0:15:43.01,0:15:47.05,Default,,0000,0000,0000,,Наппаның жігітін жеңгенде олай емес еді!
Dialogue: 0,0:15:47.05,0:15:50.05,Default,,0000,0000,0000,,Маған көрсет! Апыр-ай!
Dialogue: 0,0:15:51.44,0:15:54.47,Default,,0000,0000,0000,,Хехехе. Күткендей.
Dialogue: 0,0:15:54.47,0:15:58.51,Default,,0000,0000,0000,,Ол әлі байсалды емес→
Dialogue: 0,0:15:58.51,0:16:02.55,Default,,0000,0000,0000,,Жылдамдығы да, шеберлігі де Орадан асып түседі.
Dialogue: 0,0:16:02.55,0:16:04.57,Default,,0000,0000,0000,,Маған көрсет.
Dialogue: 0,0:16:04.57,0:16:08.61,Default,,0000,0000,0000,,Әлде күшіңіз таусылды ма?
Dialogue: 0,0:16:08.61,0:16:12.65,Default,,0000,0000,0000,,Түсіндім, көрсетемін!
Dialogue: 0,0:16:12.65,0:16:16.69,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:16:16.69,0:16:20.73,Default,,0000,0000,0000,,Куу~.
Dialogue: 0,0:16:20.73,0:16:24.73,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:16:33.86,0:16:36.86,Default,,0000,0000,0000,,Кайокен! Даа~!
Dialogue: 0,0:16:40.93,0:16:42.95,Default,,0000,0000,0000,,Урья~!
Dialogue: 0,0:16:42.95,0:16:48.16,Default,,0000,0000,0000,,Да-да-да-да...!
Dialogue: 0,0:16:48.16,0:16:49.35,Default,,0000,0000,0000,,Дория~!
Dialogue: 0,0:16:49.35,0:16:52.38,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:16:52.38,0:16:54.38,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:16:56.42,0:16:59.45,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:16:59.45,0:17:03.49,Default,,0000,0000,0000,,Ағымдағы шек шек болса, бұл үлкен көңілсіздік.
Dialogue: 0,0:17:03.49,0:17:06.52,Default,,0000,0000,0000,,《Не деген сұмдық》
Dialogue: 0,0:17:06.52,0:17:09.55,Default,,0000,0000,0000,,Хехе, бірақ жарайды→
Dialogue: 0,0:17:09.55,0:17:14.60,Default,,0000,0000,0000,,Осындай қауіпті кезеңде де мен өзімді толқыдым.
Dialogue: 0,0:17:14.60,0:17:18.64,Default,,0000,0000,0000,,《Ол күледі. Сіз бас тартып, қайталап көрдіңіз бе? Немесе →
Dialogue: 0,0:17:18.64,0:17:22.68,Default,,0000,0000,0000,,Сіз өзіңіздің жауынгерлік күшіңізді одан әрі арттыра аласыз ба? 》
Dialogue: 0,0:17:22.68,0:17:25.71,Default,,0000,0000,0000,,Не болды? Қазірдің өзінде бітті ме?
Dialogue: 0,0:17:25.71,0:17:27.73,Default,,0000,0000,0000,,Бұл шек сияқты.
Dialogue: 0,0:17:27.73,0:17:32.78,Default,,0000,0000,0000,,Олай болса, мен саған өлімнен естелік ретінде көрсетемін.
Dialogue: 0,0:17:32.78,0:17:35.81,Default,,0000,0000,0000,,Супер элита Сайянның басым күші. →
Dialogue: 0,0:17:35.81,0:17:39.85,Default,,0000,0000,0000,,Хахахаха сол әлсіз күлімсіреу әп-сәтте жоғалады.
Dialogue: 0,0:17:39.85,0:17:46.85,Default,,0000,0000,0000,,Хаа~.
Dialogue: 0,0:17:53.32,0:17:57.36,Default,,0000,0000,0000,,Ааа….
Dialogue: 0,0:17:57.36,0:18:02.36,Default,,0000,0000,0000,,Хаа~.
Dialogue: 0,0:18:07.46,0:18:15.54,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:18:15.54,0:18:19.54,Default,,0000,0000,0000,,Кук кук….
Dialogue: 0,0:18:25.64,0:18:29.68,Default,,0000,0000,0000,,Ух... Ах!
Dialogue: 0,0:18:29.68,0:18:34.73,Default,,0000,0000,0000,,Не болды? Бүкіл жер дірілдеп тұрғандай.
Dialogue: 0,0:18:34.73,0:18:44.83,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:18:44.83,0:18:46.85,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:18:46.85,0:18:52.25,Default,,0000,0000,0000,,Хаа~.
Dialogue: 0,0:18:52.25,0:18:56.29,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:18:56.29,0:18:58.29,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:01.34,0:19:04.37,Default,,0000,0000,0000,,Бұл тайфун екені сөзсіз.
Dialogue: 0,0:19:04.37,0:19:19.52,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:19:19.52,0:19:24.57,Default,,0000,0000,0000,,Ах! Апыр-ай!
Dialogue: 0,0:19:24.57,0:19:30.57,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:40.73,0:19:44.77,Default,,0000,0000,0000,,Ой...
Dialogue: 0,0:19:44.77,0:19:48.14,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:19:48.14,0:19:52.18,Default,,0000,0000,0000,,Иә? Ауа дірілдеп қалды.
Dialogue: 0,0:19:52.18,0:19:55.18,Default,,0000,0000,0000,,Қарғыс атсын, бұлттардың бәрі ұшып кетті.
Dialogue: 0,0:19:58.24,0:20:07.33,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:20:07.33,0:20:10.36,Default,,0000,0000,0000,,Бітті, Какарот.
Dialogue: 0,0:20:10.36,0:20:14.40,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:20:14.40,0:20:20.46,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:20:20.46,0:20:23.46,Default,,0000,0000,0000,,Ақымақ! Артында қалды!
Dialogue: 0,0:20:26.52,0:20:29.55,Default,,0000,0000,0000,,Иә? Ах.
Dialogue: 0,0:20:29.55,0:20:31.57,Default,,0000,0000,0000,,Тааааа!
Dialogue: 0,0:20:31.57,0:20:34.57,Default,,0000,0000,0000,,Kaiohken қос! Даа~!
Dialogue: 0,0:20:37.63,0:20:39.63,Default,,0000,0000,0000,,Таа~!
Dialogue: 0,0:20:42.68,0:20:46.72,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:20:46.72,0:20:49.08,Default,,0000,0000,0000,,Жарайды, жарайды, мен одан құтылуды жақсы орындадым. →
Dialogue: 0,0:20:49.08,0:20:54.08,Default,,0000,0000,0000,,Мен қашуды жеңілдетдім. Оңай өлсем қызық болар еді.
Dialogue: 0,0:21:02.21,0:21:06.25,Default,,0000,0000,0000,,《Қарғыс~ Қандай күш пен жылдамдық. →
Dialogue: 0,0:21:06.25,0:21:10.25,Default,,0000,0000,0000,,Тіпті 2x Кайокен де жете алмайды.
Dialogue: 0,0:21:13.32,0:21:17.36,Default,,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:21:17.36,0:21:20.39,Default,,0000,0000,0000,,Менің денем бұзылса да, мен бәрібір өлемін, солай ма? Жоқ.
Dialogue: 0,0:21:20.39,0:21:24.39,Default,,0000,0000,0000,,Менде Кайо-кенді 3 есе арттырудан басқа амалым жоқ!
Dialogue: 0,0:21:27.46,0:21:30.49,Default,,0000,0000,0000,,《Зімбірдің жақындағаны сонша, мен оны тексеруге келдім.→
Dialogue: 0,0:21:30.49,0:21:34.53,Default,,0000,0000,0000,,Бұл не... Әлгі бейбақ пен Гоку тым күшті→
Dialogue: 0,0:21:34.53,0:21:37.53,Default,,0000,0000,0000,,Жаман түс көргендей.
Dialogue: 0,0:21:40.59,0:21:45.64,Default,,0000,0000,0000,,《Енді, Кайокенді 3 есе → дейін көтеріңіз
Dialogue: 0,0:21:45.64,0:21:49.01,Default,,0000,0000,0000,,Менің денем қанша уақытқа шыдай алады деп ойлаймын.
Dialogue: 0,0:21:49.01,0:21:53.05,Default,,0000,0000,0000,,Не болды? Какарот, жүр.
Dialogue: 0,0:21:53.05,0:21:59.11,Default,,0000,0000,0000,,《Қалай болғанда да, мен мұны осылай істеуден басқа амалым жоқ, мен ешқашан жеңбеймін》
Dialogue: 0,0:21:59.11,0:22:02.14,Default,,0000,0000,0000,,Хахахаха! Сіз қолыңыздағы барлық нәрсені жоғалттыңыз ба?
Dialogue: 0,0:22:02.14,0:22:05.17,Default,,0000,0000,0000,,Қарсы тарап кінәлі сияқты.
Dialogue: 0,0:22:05.17,0:22:09.21,Default,,0000,0000,0000,,Мен ең күшті Сайян болдым.
Dialogue: 0,0:22:09.21,0:22:13.25,Default,,0000,0000,0000,,Қанша жаттығу жасасаң да, сәтсіздікке ұшырайсың.
Dialogue: 0,0:22:13.25,0:22:18.30,Default,,0000,0000,0000,,Жеңілу уақыты сәл ғана ұзағырақ болды.
Dialogue: 0,0:22:18.30,0:22:20.32,Default,,0000,0000,0000,,《Мүмкін емес. →
Dialogue: 0,0:22:20.32,0:22:23.35,Default,,0000,0000,0000,,Мені итеріп жіберетін Сайян бейбақ. →
Dialogue: 0,0:22:23.35,0:22:27.39,Default,,0000,0000,0000,,Қазір қашып кеткенім дұрыс болар еді. →
Dialogue: 0,0:22:27.39,0:22:29.41,Default,,0000,0000,0000,,Иә, қашу керек. →
Dialogue: 0,0:22:29.41,0:22:32.41,Default,,0000,0000,0000,,Мен болсам да көмектеспес еді.
Dialogue: 0,0:22:36.48,0:22:38.50,Default,,0000,0000,0000,,Хун.
Dialogue: 0,0:22:38.50,0:22:42.54,Default,,0000,0000,0000,,Хаа~.
Dialogue: 0,0:22:42.54,0:22:45.57,Default,,0000,0000,0000,,Хмм? Апыр-ай.
Dialogue: 0,0:22:45.57,0:22:51.97,Default,,0000,0000,0000,,Куу~.
Dialogue: 0,0:22:51.97,0:22:55.01,Default,,0000,0000,0000,,Денеңізді алыңыз! Бұл 3 есе Кайокен!
Dialogue: 0,0:22:55.01,0:23:00.06,Default,,0000,0000,0000,,Жоқ! Сіз одан екі есе асып кете алмайсыз, Сон Гоку.
Dialogue: 0,0:23:00.06,0:23:04.10,Default,,0000,0000,0000,,Алайда, егер бәрі сол күйінде қалса, жеңіске жету мүмкіндігі болмайтыны рас.
Dialogue: 0,0:23:04.10,0:23:08.14,Default,,0000,0000,0000,,Мен оның соншалықты күшті болатынын ешқашан күтпедім.
Dialogue: 0,0:23:08.14,0:23:14.20,Default,,0000,0000,0000,,Ааааааааааааааааааа... Бұл ойын жұмыс істемеуі мүмкін.
Dialogue: 0,0:23:14.20,0:23:18.24,Default,,0000,0000,0000,,Куу~.
Dialogue: 0,0:23:18.24,0:23:22.24,Default,,0000,0000,0000,,Даа~!
Dialogue: 0,0:23:25.31,0:23:28.34,Default,,0000,0000,0000,,Ааа….
Dialogue: 0,0:23:28.34,0:23:32.38,Default,,0000,0000,0000,,Не болды? (Оолонг) Не, бірдеңе болды ма?
Dialogue: 0,0:23:32.38,0:23:34.40,Default,,0000,0000,0000,,Менің ойымша, бұл сенің немерең →
Dialogue: 0,0:23:34.40,0:23:38.44,Default,,0000,0000,0000,,Менің жауынгерлік күшімнің саны айтарлықтай өсті.
Dialogue: 0,0:23:38.44,0:23:40.46,Default,,0000,0000,0000,,Гоку! Гоку!
Dialogue: 0,0:23:40.46,0:23:44.50,Default,,0000,0000,0000,,17 000 19 000 21 000….
Dialogue: 0,0:23:44.50,0:23:47.69,Default,,0000,0000,0000,,Ай!
Dialogue: 0,0:23:47.69,0:23:50.69,Default,,0000,0000,0000,,Дұрыс...
Dialogue: 0,0:23:54.93,0:23:57.96,Default,,0000,0000,0000,,Иә? Иә?
Dialogue: 0,0:23:57.96,0:23:59.98,Default,,0000,0000,0000,,Ааа….
Dialogue: 0,0:23:59.98,0:24:14.13,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:14.13,0:24:23.13,Default,,0000,0000,0000,,Куу~.
Dialogue: 0,0:24:26.25,0:24:28.27,Default,,0000,0000,0000,,Уақыты келді…
Dialogue: 0,0:24:28.27,0:24:30.29,Default,,0000,0000,0000,,Куу~.
Dialogue: 0,0:24:30.29,0:24:34.33,Default,,0000,0000,0000,,Даа~!
Dialogue: 0,0:24:34.33,0:24:39.38,Default,,0000,0000,0000,,<Гоку тыйым салынған 3x Кайокэнді пайдаланады. →
Dialogue: 0,0:24:39.38,0:24:43.38,Default,,0000,0000,0000,,Дене шекті қуатқа төтеп бере ала ма? ＞
Dialogue: 0,0:24:46.45,0:24:51.50,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:51.50,0:25:11.70,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:11.70,0:25:31.90,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:31.90,0:25:44.90,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:48.40,0:25:52.44,Default,,0000,0000,0000,,Сәлем, Гоку. Менің денем 3x Kaioken-тен дірілдеп тұр.
Dialogue: 0,0:25:52.44,0:25:56.48,Default,,0000,0000,0000,,Қалайша сіздің жауынгерлік күшіңіз менікіден асып түседі!? Кешір мені!
Dialogue: 0,0:25:56.48,0:25:58.50,Default,,0000,0000,0000,,Жеңіске жетудің жалғыз жолы - Генкидаманы пайдалану.
Dialogue: 0,0:25:58.50,0:26:01.53,Default,,0000,0000,0000,,Мен сені тезірек аяқтаймын, Вегета!
Dialogue: 0,0:26:01.53,0:26:05.57,Default,,0000,0000,0000,,Бұл менің жолым. Бұл шіркін және жиіркенішті, бірақ бұл құпия!
Dialogue: 0,0:26:05.57,0:26:07.57,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»
Dialogue: 0,0:26:11.63,0:26:13.63,Default,,0000,0000,0000,,Мен де ұрысамын, әке!
Dialogue: 0,0:26:15.13,0:26:21.13,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory