Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.41,0:00:11.46,Default,,0000,0000,0000,,<Жер бетіне ең күшті сайяндар келді. →
Dialogue: 0,0:00:11.46,0:00:16.51,Default,,0000,0000,0000,,Гоку шешуші шайқасқа дайындалды→
Dialogue: 0,0:00:16.51,0:00:20.55,Default,,0000,0000,0000,,Ақырында Шенрон қайта тірілтті. →
Dialogue: 0,0:00:20.55,0:00:24.59,Default,,0000,0000,0000,,Бірақ менің Жерге оралуыма тағы бір күн қалды. →
Dialogue: 0,0:00:24.59,0:00:28.59,Default,,0000,0000,0000,,Гоку оны уақытында жасай ма? ＞
Dialogue: 0,0:00:31.66,0:00:36.71,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:36.71,0:00:56.91,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:00:56.91,0:01:16.44,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:16.44,0:01:36.64,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:36.64,0:01:53.64,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:15.56,0:04:18.59,Default,,0000,0000,0000,,Олар қандай? (Еркек) Сіз кімсіз?
Dialogue: 0,0:04:18.59,0:04:23.64,Default,,0000,0000,0000,,Сіз Жер дедіңіз. Бұл өте жұлдыз, солай емес пе?
Dialogue: 0,0:04:23.64,0:04:25.66,Default,,0000,0000,0000,,Шулы балапандарға дыбыстық сигнал→
Dialogue: 0,0:04:25.66,0:04:27.68,Default,,0000,0000,0000,,Сәлем беруім керек пе?
Dialogue: 0,0:04:27.68,0:04:31.72,Default,,0000,0000,0000,,Хехехе, реттеңіз.
Dialogue: 0,0:04:31.72,0:04:35.72,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:04:43.84,0:04:46.87,Default,,0000,0000,0000,,Ах! (Теншин күріші) Бұл не!?→
Dialogue: 0,0:04:46.87,0:04:48.89,Default,,0000,0000,0000,,Эй, олар не істеді!?
Dialogue: 0,0:04:48.89,0:04:51.92,Default,,0000,0000,0000,,күрсіну…. Куу….
Dialogue: 0,0:04:51.92,0:04:55.92,Default,,0000,0000,0000,,Не болды...? Бұл үлкен қателік.
Dialogue: 0,0:04:57.98,0:05:10.45,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:05:10.45,0:05:15.50,Default,,0000,0000,0000,,Хахахаха! Сәлемдесуде сәл сыпайы болдым деп ойлаймын.
Dialogue: 0,0:05:15.50,0:05:18.53,Default,,0000,0000,0000,,Бұл туралы, Наппа.
Dialogue: 0,0:05:18.53,0:05:22.57,Default,,0000,0000,0000,,Егер сіз мұны өте жарқырасаңыз, бұл жұлдыз жоғары бағаға сатылмайды.
Dialogue: 0,0:05:22.57,0:05:24.59,Default,,0000,0000,0000,,көремін. Дұрыс →
Dialogue: 0,0:05:24.59,0:05:28.63,Default,,0000,0000,0000,,Кез келген тілек орындалады дейді.Мен де доп іздеген шығармын.
Dialogue: 0,0:05:28.63,0:05:30.65,Default,,0000,0000,0000,,Бұл Айдаһар добы.
Dialogue: 0,0:05:30.65,0:05:33.68,Default,,0000,0000,0000,,Алдымен Радицті өлтірген адамды табыңыз→
Dialogue: 0,0:05:33.68,0:05:36.71,Default,,0000,0000,0000,,Мен сенен Айдаһар туралы сұрайын ба?
Dialogue: 0,0:05:36.71,0:05:39.74,Default,,0000,0000,0000,,Дұрыс. (Вегета) Бірақ егер →
Dialogue: 0,0:05:39.74,0:05:42.77,Default,,0000,0000,0000,,Айдаһар добы осында жақын болса→
Dialogue: 0,0:05:42.77,0:05:47.82,Default,,0000,0000,0000,,«Мәңгілік өмірге ие болайық» деген тілек парызға айналады. →
Dialogue: 0,0:05:47.82,0:05:50.85,Default,,0000,0000,0000,,Сенің ақымақ амандасуың үшін.
Dialogue: 0,0:05:50.85,0:05:55.90,Default,,0000,0000,0000,,Кешіріңіз. Мен бұл туралы кездейсоқ ұмытып кеттім.
Dialogue: 0,0:05:55.90,0:05:57.92,Default,,0000,0000,0000,,Міне, орындалды. →
Dialogue: 0,0:05:57.92,0:06:01.96,Default,,0000,0000,0000,,Әзірге ең жоғары жауынгерлік күші барын табыңыз.
Dialogue: 0,0:06:01.96,0:06:05.16,Default,,0000,0000,0000,,Радицті өлтірген сол.
Dialogue: 0,0:06:05.16,0:06:09.37,Default,,0000,0000,0000,,Иә? Бұл біртүрлі. →
Dialogue: 0,0:06:09.37,0:06:15.43,Default,,0000,0000,0000,,Жауынгерлік қуат: Бір немесе екі реакция 1000-нан аспайды.
Dialogue: 0,0:06:15.43,0:06:17.45,Default,,0000,0000,0000,,Неліктен мұндай планетада?
Dialogue: 0,0:06:17.45,0:06:21.49,Default,,0000,0000,0000,,Дүрбелеңге салынбаңыз. Ол біздің жауымыз емес.
Dialogue: 0,0:06:21.49,0:06:25.53,Default,,0000,0000,0000,,Тек ең ұрыс күші бар біреуін іздеңіз.
Dialogue: 0,0:06:25.53,0:06:27.55,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:06:27.55,0:06:29.57,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:06:29.57,0:06:31.59,Default,,0000,0000,0000,,Мен оны таптым.
Dialogue: 0,0:06:31.59,0:06:34.62,Default,,0000,0000,0000,,Екі өте жоғары реакция бар.
Dialogue: 0,0:06:34.62,0:06:39.62,Default,,0000,0000,0000,,Жарайды, Наппа, ойынға барайық.
Dialogue: 0,0:06:47.75,0:06:50.78,Default,,0000,0000,0000,,Осылайша, осы сияқты ауқымды жер сілкінісінің себептері →
Dialogue: 0,0:06:50.78,0:06:52.80,Default,,0000,0000,0000,,Мүлдем түсініксіз. →
Dialogue: 0,0:06:52.80,0:06:55.83,Default,,0000,0000,0000,,Осы жер сілкінісінің ошағы деп есептелетін шығыс астана қай қала?→
Dialogue: 0,0:06:55.83,0:07:00.88,Default,,0000,0000,0000,,Қазіргі уақытта біз мүлдем хабарласа алмаймыз және біз азаматтардың қауіпсіздігіне алаңдаймыз.
Dialogue: 0,0:07:00.88,0:07:04.92,Default,,0000,0000,0000,,Хмм, сіз келдіңіз.
Dialogue: 0,0:07:04.92,0:07:07.28,Default,,0000,0000,0000,,Сіз көңіл көтересіз бе? Бұл сізге оның қайда екенін айтады.
Dialogue: 0,0:07:07.28,0:07:10.31,Default,,0000,0000,0000,,Әй, өлсем де бармаймын!
Dialogue: 0,0:07:10.31,0:07:12.33,Default,,0000,0000,0000,,Мен барамын!
Dialogue: 0,0:07:12.33,0:07:16.37,Default,,0000,0000,0000,,Ямча-саманың да баратынына сенімдімін.
Dialogue: 0,0:07:16.37,0:07:18.39,Default,,0000,0000,0000,,Жоқ, тоқтайық.
Dialogue: 0,0:07:18.39,0:07:21.42,Default,,0000,0000,0000,,Не? (Роши Роши) Деңгейлер тым әртүрлі. →
Dialogue: 0,0:07:21.42,0:07:24.45,Default,,0000,0000,0000,,Мен сонда болсам да, мен жай ғана мазасызданатын едім. →
Dialogue: 0,0:07:24.45,0:07:28.49,Default,,0000,0000,0000,,Бұдан былай барлығының жеңісінен ғана үміт күтемін.
Dialogue: 0,0:07:28.49,0:07:31.52,Default,,0000,0000,0000,,Немерем, тез келші. →
Dialogue: 0,0:07:31.52,0:07:33.52,Default,,0000,0000,0000,,Тез кел!
Dialogue: 0,0:07:37.58,0:07:41.58,Default,,0000,0000,0000,,《Мен кеткенше шыдаңдар, бәрің! 》
Dialogue: 0,0:07:45.66,0:07:49.70,Default,,0000,0000,0000,,Вахахаха!
Dialogue: 0,0:07:49.70,0:07:52.73,Default,,0000,0000,0000,,Хэ-хэ-хэ, бұл жақсы.
Dialogue: 0,0:07:52.73,0:07:57.73,Default,,0000,0000,0000,,Бұл Жер планетасының тартылыс күші өте аз, сондықтан ол оңай қозғалады.
Dialogue: 0,0:08:02.83,0:08:05.03,Default,,0000,0000,0000,,Ол үлкен жылдамдықпен қозғалады.
Dialogue: 0,0:08:05.03,0:08:09.23,Default,,0000,0000,0000,,Мен өзімді жақсы сезінетін тағы екі адамға қарай бет алдым.
Dialogue: 0,0:08:09.23,0:08:12.26,Default,,0000,0000,0000,,Келеді! Олар осында келеді.
Dialogue: 0,0:08:12.26,0:08:14.28,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:08:14.28,0:08:19.33,Default,,0000,0000,0000,,Джоза, сен осында қал! (Гйоза) Маған ұнамайды. Мен де барамын!
Dialogue: 0,0:08:19.33,0:08:21.35,Default,,0000,0000,0000,,Қорықпаңыз.
Dialogue: 0,0:08:21.35,0:08:25.39,Default,,0000,0000,0000,,Біз бір жыл бұрынғымен салыстыруға келмейтіндей күшті болдық.
Dialogue: 0,0:08:25.39,0:08:27.41,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:08:27.41,0:08:29.43,Default,,0000,0000,0000,,Арғы жақтан бір нәрсе жақындап келеді.
Dialogue: 0,0:08:29.43,0:08:32.46,Default,,0000,0000,0000,,Бізге қарай келе жатқан басқалары бар!
Dialogue: 0,0:08:32.46,0:08:35.49,Default,,0000,0000,0000,,Екі ғана Сайян бар!?
Dialogue: 0,0:08:35.49,0:08:37.51,Default,,0000,0000,0000,,Иә!?
Dialogue: 0,0:08:37.51,0:08:41.55,Default,,0000,0000,0000,,Сайян!? Әй, біраз уақыт болды, Пикколо.
Dialogue: 0,0:08:41.55,0:08:44.58,Default,,0000,0000,0000,,Бұл не, сен? Хехе.
Dialogue: 0,0:08:44.58,0:08:49.63,Default,,0000,0000,0000,,Мұндағы мақсат не? Сіз мұнда мазасыздану үшін келдіңіз бе?
Dialogue: 0,0:08:49.63,0:08:53.67,Default,,0000,0000,0000,,Мұнда келуге тырысатын басқа ақымақтар бар сияқты...
Dialogue: 0,0:08:53.67,0:08:57.71,Default,,0000,0000,0000,,Аа, бәрі келетініне сенімдімін. Мен ең жақын болдым.
Dialogue: 0,0:08:57.71,0:09:01.75,Default,,0000,0000,0000,,Мастер Рошимен бірге болған адам есімде.
Dialogue: 0,0:09:01.75,0:09:03.77,Default,,0000,0000,0000,,А, бұл криллин.
Dialogue: 0,0:09:03.77,0:09:06.14,Default,,0000,0000,0000,,Сіз әлдеқайда күшті болдыңыз.
Dialogue: 0,0:09:06.14,0:09:09.17,Default,,0000,0000,0000,,Гокудың бала кезіндегідей.
Dialogue: 0,0:09:09.17,0:09:13.21,Default,,0000,0000,0000,,Кішкентай, бірақ күшті, солай ма? Әкем солай айтатын.
Dialogue: 0,0:09:13.21,0:09:16.24,Default,,0000,0000,0000,,Сондықтан сіз бізбен күресе аласыз!
Dialogue: 0,0:09:16.24,0:09:20.28,Default,,0000,0000,0000,,Гоку мұны айтты ма?
Dialogue: 0,0:09:20.28,0:09:23.28,Default,,0000,0000,0000,,Әңгіменің бәрі осы! Міне келдік!
Dialogue: 0,0:09:30.38,0:09:34.42,Default,,0000,0000,0000,,Хехехехехе сонда болды. →
Dialogue: 0,0:09:34.42,0:09:37.45,Default,,0000,0000,0000,,Тағы бір балық, күшті болып көрінетіндері үшеу.
Dialogue: 0,0:09:37.45,0:09:41.49,Default,,0000,0000,0000,,Сіз біз туралы көп білетін шығарсыз.
Dialogue: 0,0:09:41.49,0:09:54.62,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:09:54.62,0:09:59.67,Default,,0000,0000,0000,,Сіз көптен күткен сияқтысыз. Пісір, пісір, пісір.
Dialogue: 0,0:09:59.67,0:10:02.70,Default,,0000,0000,0000,,Міне. →
Dialogue: 0,0:10:02.70,0:10:08.09,Default,,0000,0000,0000,,Сенімді болу үшін, балалар, мұнда не үшін келдіңдер?
Dialogue: 0,0:10:08.09,0:10:12.13,Default,,0000,0000,0000,,Сол дауыс... Түсіндім. Радицті кім жеңді?
Dialogue: 0,0:10:12.13,0:10:14.15,Default,,0000,0000,0000,,Сіз бе? дауыс?
Dialogue: 0,0:10:14.15,0:10:18.19,Default,,0000,0000,0000,,Радиц саған айтқан жоқ па?
Dialogue: 0,0:10:18.19,0:10:22.23,Default,,0000,0000,0000,,Бұл зат байланыс құралы қызметін де атқарады.
Dialogue: 0,0:10:22.23,0:10:24.25,Default,,0000,0000,0000,,Ол Намекиан.
Dialogue: 0,0:10:24.25,0:10:27.28,Default,,0000,0000,0000,,Шамасы. Радиц өлтірілсе де →
Dialogue: 0,0:10:27.28,0:10:30.31,Default,,0000,0000,0000,,Сонда бәрі біртүрлі болған жоқ па?
Dialogue: 0,0:10:30.31,0:10:32.33,Default,,0000,0000,0000,,Намекян?
Dialogue: 0,0:10:32.33,0:10:36.37,Default,,0000,0000,0000,,Намекиялықтарда ерекше жауынгерлік күштен басқа → бар
Dialogue: 0,0:10:36.37,0:10:39.37,Default,,0000,0000,0000,,Оның жұмбақ қабілеті бар сияқты.
Dialogue: 0,0:10:41.42,0:10:45.46,Default,,0000,0000,0000,,《Ой, мен бөтен планеталық Намектен бе? 》
Dialogue: 0,0:10:45.46,0:10:49.50,Default,,0000,0000,0000,,Ал сиқыршы сияқты іспен айналысатын адамдар бар.→
Dialogue: 0,0:10:49.50,0:10:51.52,Default,,0000,0000,0000,,Мен бұл туралы естідім. →
Dialogue: 0,0:10:51.52,0:10:54.55,Default,,0000,0000,0000,,Түсіндім, Айдаһар добы деген нәрсе→
Dialogue: 0,0:10:54.55,0:10:56.57,Default,,0000,0000,0000,,Оны жасаған сен болдың.
Dialogue: 0,0:10:56.57,0:11:01.62,Default,,0000,0000,0000,,Иә! Сіз тіпті Dragon Ball туралы білесіз бе?
Dialogue: 0,0:11:01.62,0:11:04.65,Default,,0000,0000,0000,,Бұл Айдаһар шарлары - басты мақсат.
Dialogue: 0,0:11:04.65,0:11:07.01,Default,,0000,0000,0000,,Оны бізге тыныш беріңіз.
Dialogue: 0,0:11:07.01,0:11:11.05,Default,,0000,0000,0000,,Намекейлер қанша болса да, бір немесе одан да көп →
Dialogue: 0,0:11:11.05,0:11:13.07,Default,,0000,0000,0000,,Біз шыбындарды көре алмаймыз.
Dialogue: 0,0:11:13.07,0:11:15.09,Default,,0000,0000,0000,,Әй, рахмет.
Dialogue: 0,0:11:15.09,0:11:20.14,Default,,0000,0000,0000,,Сіздердің арқаларыңызда мен ата-бабам туралы біраз нәрсені түсіндім.
Dialogue: 0,0:11:20.14,0:11:22.16,Default,,0000,0000,0000,,Бірақ бұл ұят болды. →
Dialogue: 0,0:11:22.16,0:11:25.19,Default,,0000,0000,0000,,Айдаһар шарларын жасаған мен емес едім.
Dialogue: 0,0:11:25.19,0:11:30.19,Default,,0000,0000,0000,,Менің мамандығым – жекпе-жек.
Dialogue: 0,0:11:32.26,0:11:35.29,Default,,0000,0000,0000,,Байқап көріңіз, шыбын сияқты ма!
Dialogue: 0,0:11:35.29,0:11:37.31,Default,,0000,0000,0000,,God….
Dialogue: 0,0:11:37.31,0:11:43.37,Default,,0000,0000,0000,,Мен жат планеталық екенімді білмедім.
Dialogue: 0,0:11:43.37,0:11:48.42,Default,,0000,0000,0000,,Мен басқалардан аздап ерекшеленетін сияқтымын...
Dialogue: 0,0:11:48.42,0:11:51.45,Default,,0000,0000,0000,,Баяғыда Айдаһар допты жасаған адам → болды
Dialogue: 0,0:11:51.45,0:11:55.49,Default,,0000,0000,0000,,Бұл сөзсіз мен.
Dialogue: 0,0:11:55.49,0:12:00.54,Default,,0000,0000,0000,,Дегенмен, мен оны бірінші рет жасап тұрсам да, біртүрлі ностальгияны сезіндім. →
Dialogue: 0,0:12:00.54,0:12:05.76,Default,,0000,0000,0000,,Намек→ деген планетаны да біреу жасаған шығар
Dialogue: 0,0:12:05.76,0:12:10.97,Default,,0000,0000,0000,,Айдаһар добы сияқты бірдеңе болған болуы керек.
Dialogue: 0,0:12:10.97,0:12:14.01,Default,,0000,0000,0000,,Наппа, скаутеріңізді алып тастаңыз. не?
Dialogue: 0,0:12:14.01,0:12:18.05,Default,,0000,0000,0000,,Бұл жігіттер ұрысқа байланысты өздерінің жауынгерлік күшін өзгертеді.
Dialogue: 0,0:12:18.05,0:12:21.08,Default,,0000,0000,0000,,Мұндай сандар енді сенімді емес.
Dialogue: 0,0:12:21.08,0:12:24.11,Default,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:12:24.11,0:12:27.14,Default,,0000,0000,0000,,Радицтің әлсіреген ақымақы барлаушының нөмірлерінен абайсызда ұсталды→
Dialogue: 0,0:12:27.14,0:12:30.14,Default,,0000,0000,0000,,Мені ұрып жатқандай болды.
Dialogue: 0,0:12:32.19,0:12:36.23,Default,,0000,0000,0000,,Ла Радиц - Гоку және сіз.→
Dialogue: 0,0:12:36.23,0:12:40.27,Default,,0000,0000,0000,,Бұл сіз ақырында жеңген Сайян, солай ма? Сіз әлсізсіз бе?
Dialogue: 0,0:12:40.27,0:12:45.32,Default,,0000,0000,0000,,Дұрыс, мына жігіттердің халін көрейін.
Dialogue: 0,0:12:45.32,0:12:49.36,Default,,0000,0000,0000,,Әй, Наппа, тағы 6 культиватор болды.
Dialogue: 0,0:12:49.36,0:12:51.38,Default,,0000,0000,0000,,Мені шығарыңыз.
Dialogue: 0,0:12:51.38,0:12:54.41,Default,,0000,0000,0000,,Вегета да ойнағанды ​​ұнатады.
Dialogue: 0,0:12:54.41,0:12:58.45,Default,,0000,0000,0000,,Сонымен, адам өсіруші? Бұл не?
Dialogue: 0,0:12:58.45,0:13:00.47,Default,,0000,0000,0000,,Бұл сөзсіз 6 дән.
Dialogue: 0,0:13:00.47,0:13:05.47,Default,,0000,0000,0000,,Бұл топырақта жақсы культиватор өседі.
Dialogue: 0,0:13:09.90,0:13:12.93,Default,,0000,0000,0000,,Не болды!
Dialogue: 0,0:13:12.93,0:13:15.96,Default,,0000,0000,0000,,Мен музыка колледжінде Саки Аримамен бір курс болғанмын, сондықтан→
Dialogue: 0,0:13:15.96,0:13:17.96,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:13:22.03,0:13:27.08,Default,,0000,0000,0000,,Ей, бұл балалар қорқынышты.
Dialogue: 0,0:13:27.08,0:13:32.08,Default,,0000,0000,0000,,Гуэ Гуе Гуе Гуе.
Dialogue: 0,0:13:34.15,0:13:36.15,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:13:42.23,0:13:44.25,Default,,0000,0000,0000,,Гуе! Апыр-ай!
Dialogue: 0,0:13:44.25,0:13:46.27,Default,,0000,0000,0000,,Жақсы!
Dialogue: 0,0:13:46.27,0:13:48.27,Default,,0000,0000,0000,,Гуе~!
Dialogue: 0,0:13:54.35,0:13:57.38,Default,,0000,0000,0000,,Ги~!
Dialogue: 0,0:13:57.38,0:14:01.38,Default,,0000,0000,0000,,Мақсаттар осы үшеу. Оларды ренжітіңіз, өсіруші адам.
Dialogue: 0,0:15:16.50,0:15:32.66,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:15:32.66,0:15:34.66,Default,,0000,0000,0000,,Уау... иә?
Dialogue: 0,0:15:36.70,0:15:39.73,Default,,0000,0000,0000,,Жігіт~.
Dialogue: 0,0:15:39.73,0:15:43.77,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:15:43.77,0:15:45.79,Default,,0000,0000,0000,,Цк.
Dialogue: 0,0:15:45.79,0:15:49.79,Default,,0000,0000,0000,,Гохан Көңіліңді түсірме! иә.
Dialogue: 0,0:15:51.85,0:15:53.87,Default,,0000,0000,0000,,Жігіт~.
Dialogue: 0,0:15:53.87,0:15:55.89,Default,,0000,0000,0000,,Келесі жолы осы жерден баруым керек пе?
Dialogue: 0,0:15:55.89,0:15:58.89,Default,,0000,0000,0000,,（）
Dialogue: 0,0:16:02.96,0:16:06.00,Default,,0000,0000,0000,,Тяньцзинь күріш! Гиоза да келді ме?
Dialogue: 0,0:16:06.00,0:16:08.02,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:16:08.02,0:16:11.38,Default,,0000,0000,0000,,Екі Сайян емес пе?
Dialogue: 0,0:16:11.38,0:16:14.41,Default,,0000,0000,0000,,Түрлі себептерге байланысты саны көбейіп кеткен сияқты.
Dialogue: 0,0:16:14.41,0:16:17.44,Default,,0000,0000,0000,,Бұл кез келген адам санына қатысты.
Dialogue: 0,0:16:17.44,0:16:20.47,Default,,0000,0000,0000,,Солай ма? Гокудың баласы.
Dialogue: 0,0:16:20.47,0:16:24.47,Default,,0000,0000,0000,,Ах, Пикколо оны біраз жаттықтырған сияқты.
Dialogue: 0,0:16:31.58,0:16:33.60,Default,,0000,0000,0000,,Криллин Кешіктіргеніміз үшін кешіріңіз.
Dialogue: 0,0:16:33.60,0:16:37.64,Default,,0000,0000,0000,,Ямча мырза! Гокудан басқаның бәрі осында.
Dialogue: 0,0:16:37.64,0:16:41.68,Default,,0000,0000,0000,,1 2 3 4 5 6 жануарлар.
Dialogue: 0,0:16:41.68,0:16:46.73,Default,,0000,0000,0000,,Қызықты. Дәл сол Cultivation Man саны. →
Dialogue: 0,0:16:46.73,0:16:53.80,Default,,0000,0000,0000,,Қалайсыңдар, балалар, біздің жауынгерлермен бір-бірден соғыспайсыңдар ма?
Dialogue: 0,0:16:53.80,0:16:55.82,Default,,0000,0000,0000,,Бұл ойын.
Dialogue: 0,0:16:55.82,0:16:58.85,Default,,0000,0000,0000,,Қарғыс атқыр... бұл ойын ба? Бұл бос сөз!
Dialogue: 0,0:16:58.85,0:17:00.87,Default,,0000,0000,0000,,Бұндай айналма әрекет жасама →
Dialogue: 0,0:17:00.87,0:17:02.89,Default,,0000,0000,0000,,Барлығын бірден шешіңіз!
Dialogue: 0,0:17:02.89,0:17:06.93,Default,,0000,0000,0000,,Өте орынды. Бізге ыңғайлы.
Dialogue: 0,0:17:06.93,0:17:10.14,Default,,0000,0000,0000,,Гоку жігіті де әлі келген жоқ.
Dialogue: 0,0:17:10.14,0:17:14.35,Default,,0000,0000,0000,,Жақсы, мен мұны өзім жасаймын.
Dialogue: 0,0:17:14.35,0:17:16.37,Default,,0000,0000,0000,,Келіңдер, келіңдер.
Dialogue: 0,0:17:16.37,0:17:19.40,Default,,0000,0000,0000,,Хахахаха! →
Dialogue: 0,0:17:19.40,0:17:23.44,Default,,0000,0000,0000,,Сол Культиватордың қаншалықты күшті екенін білсем→
Dialogue: 0,0:17:23.44,0:17:26.47,Default,,0000,0000,0000,,Бұл ақылсыз.
Dialogue: 0,0:17:26.47,0:17:30.51,Default,,0000,0000,0000,,Сіз бірінші барасыз. Бар күшіңмен соққан жақсы.
Dialogue: 0,0:17:30.51,0:17:33.54,Default,,0000,0000,0000,,Гу.
Dialogue: 0,0:17:33.54,0:17:35.56,Default,,0000,0000,0000,,Ги~!
Dialogue: 0,0:17:35.56,0:17:37.56,Default,,0000,0000,0000,,Тур!
Dialogue: 0,0:17:39.60,0:17:41.62,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:17:41.62,0:17:52.73,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:17:52.73,0:17:55.76,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:17:55.76,0:17:57.76,Default,,0000,0000,0000,,Таа!
Dialogue: 0,0:17:59.80,0:18:03.84,Default,,0000,0000,0000,,Иә! Күткендей, бұл Теншинхан!
Dialogue: 0,0:18:03.84,0:18:05.84,Default,,0000,0000,0000,,Күрсін, бұл керемет.
Dialogue: 0,0:18:07.88,0:18:11.25,Default,,0000,0000,0000,,А...
Dialogue: 0,0:18:11.25,0:18:15.29,Default,,0000,0000,0000,,Ақымақ. Cultivation Адамның жауынгерлік күші - 1200!
Dialogue: 0,0:18:15.29,0:18:18.32,Default,,0000,0000,0000,,Тек қуат тұрғысынан оны Радицпен салыстыруға болады.
Dialogue: 0,0:18:18.32,0:18:22.36,Default,,0000,0000,0000,,Оның жауынгерлік күші бұдан асып түседі, солай ма?
Dialogue: 0,0:18:22.36,0:18:25.39,Default,,0000,0000,0000,,Бірақ...
Dialogue: 0,0:18:25.39,0:18:28.42,Default,,0000,0000,0000,,Бұл қарапайым есеп. Мұндай деректер...
Dialogue: 0,0:18:28.42,0:18:30.44,Default,,0000,0000,0000,,Хехехехе.
Dialogue: 0,0:18:30.44,0:18:34.44,Default,,0000,0000,0000,,Наппа Олар аздап көңіл көтеретін сияқты.
Dialogue: 0,0:18:36.50,0:18:38.50,Default,,0000,0000,0000,,Гва~!
Dialogue: 0,0:18:41.55,0:18:43.57,Default,,0000,0000,0000,,Жоқ... (Гйоза) Ах...
Dialogue: 0,0:18:43.57,0:18:46.60,Default,,0000,0000,0000,,Уф…. Уау...
Dialogue: 0,0:18:46.60,0:18:49.63,Default,,0000,0000,0000,,Бет Вегета, не істеп жатырсың...?
Dialogue: 0,0:18:49.63,0:18:54.68,Default,,0000,0000,0000,,Әлгі өсіруші оған шабуыл жасады. →
Dialogue: 0,0:18:54.68,0:18:58.72,Default,,0000,0000,0000,,Мен саған бәріңе барыңдар дедім.
Dialogue: 0,0:18:58.72,0:19:00.74,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:19:00.74,0:19:05.79,Default,,0000,0000,0000,,《Әй, Сайян құбыжықты әп-сәтте жарып жіберді... →
Dialogue: 0,0:19:05.79,0:19:07.81,Default,,0000,0000,0000,,What destructive power》
Dialogue: 0,0:19:07.81,0:19:10.00,Default,,0000,0000,0000,,Енді келесі кім?
Dialogue: 0,0:19:10.00,0:19:13.20,Default,,0000,0000,0000,,Жарайды, жарайды, мен сенің қарсыласыңмын!
Dialogue: 0,0:19:13.20,0:19:16.23,Default,,0000,0000,0000,,Күте тұрыңыз, криллин. Ямча мырза.
Dialogue: 0,0:19:16.23,0:19:19.26,Default,,0000,0000,0000,,Маған орындауға рұқсат етіңіз. Осы жерде көңіл көтеріңіз →
Dialogue: 0,0:19:19.26,0:19:22.29,Default,,0000,0000,0000,,Мен сенің қалағаныңды істей алатыныңды көрсеткім келеді.
Dialogue: 0,0:19:22.29,0:19:25.32,Default,,0000,0000,0000,,Ямча-сан, егер солай болса, мен де...
Dialogue: 0,0:19:25.32,0:19:28.35,Default,,0000,0000,0000,,Сізді бір рет Айдаһар шарлары өмірге қайтарды.
Dialogue: 0,0:19:28.35,0:19:30.37,Default,,0000,0000,0000,,Бірдеңе болса →
Dialogue: 0,0:19:30.37,0:19:34.41,Default,,0000,0000,0000,,Сіз ешқашан өмірге орала алмайсыз. Мұны маған қалдырыңыз.
Dialogue: 0,0:19:34.41,0:19:37.44,Default,,0000,0000,0000,,Қалған бесеуін бірден шешемін.
Dialogue: 0,0:19:37.44,0:19:40.47,Default,,0000,0000,0000,,Хехехехе Әдемі достық деген бар ма?
Dialogue: 0,0:19:40.47,0:19:43.50,Default,,0000,0000,0000,,Жарайды, сен менің қарсыласым бола аласың. (Өсіруші адам) Гуе.
Dialogue: 0,0:19:43.50,0:19:47.50,Default,,0000,0000,0000,,Келіңіздер! Бізді жеңіл қабылдамаңыз!
Dialogue: 0,0:19:49.56,0:19:53.60,Default,,0000,0000,0000,,《Бұл қандай қызық толқу? Менде жағымсыз сезім бар. →
Dialogue: 0,0:19:53.60,0:19:58.60,Default,,0000,0000,0000,,Пикколо Мен сізден Ора қайтып келгенше шыдауды өтіндім! 》
Dialogue: 0,0:20:00.67,0:20:02.67,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:20:04.71,0:20:07.74,Default,,0000,0000,0000,,Ол жоғалып кетті.
Dialogue: 0,0:20:07.74,0:20:12.12,Default,,0000,0000,0000,,Ей, ақымақ, қатты жылдамдықпен қозғалады. Энергияңыздың қозғалысын сезініңіз!
Dialogue: 0,0:20:12.12,0:20:14.14,Default,,0000,0000,0000,,Ци қозғалысы?
Dialogue: 0,0:20:14.14,0:20:17.17,Default,,0000,0000,0000,,Оны сізден басқа барлығы көре алады.
Dialogue: 0,0:20:17.17,0:20:22.22,Default,,0000,0000,0000,,Иә, мұны бәріңіз көре аласыз ба? Жақсы!
Dialogue: 0,0:20:22.22,0:20:25.25,Default,,0000,0000,0000,,Денеңіздің ішіне қараңыз.
Dialogue: 0,0:20:25.25,0:20:28.28,Default,,0000,0000,0000,,Көздер бүкіл денеде….
Dialogue: 0,0:20:28.28,0:20:30.28,Default,,0000,0000,0000,,Куу….
Dialogue: 0,0:20:42.42,0:20:45.45,Default,,0000,0000,0000,,Ах! Сіз оны көрдіңіз бе?
Dialogue: 0,0:20:45.45,0:20:47.45,Default,,0000,0000,0000,,Атата!
Dialogue: 0,0:20:52.52,0:20:54.54,Default,,0000,0000,0000,,Мен оны көрдім!
Dialogue: 0,0:20:54.54,0:21:10.87,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:21:10.87,0:21:12.87,Default,,0000,0000,0000,,Теня да батыр ма?
Dialogue: 0,0:21:16.10,0:21:19.13,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:21:19.13,0:21:22.13,Default,,0000,0000,0000,,Қалғанын саған қалдырамын.
Dialogue: 0,0:21:24.18,0:21:26.20,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:21:26.20,0:21:28.22,Default,,0000,0000,0000,,Керемет.
Dialogue: 0,0:21:28.22,0:21:30.24,Default,,0000,0000,0000,,Қазіргі жасыңда мәңгі қалу—
Dialogue: 0,0:21:30.24,0:21:32.26,Default,,0000,0000,0000,,Жердегілер басымдылыққа ие!
Dialogue: 0,0:21:32.26,0:21:38.26,Default,,0000,0000,0000,,Иә! Ия, иә, иә!
Dialogue: 0,0:21:45.39,0:21:47.41,Default,,0000,0000,0000,,Қайта кездескенше.
Dialogue: 0,0:21:47.41,0:21:50.41,Default,,0000,0000,0000,,Хаа….
Dialogue: 0,0:21:53.47,0:21:56.50,Default,,0000,0000,0000,,Hmph, сіз қанша ойласаңыз, сонша →
Dialogue: 0,0:21:56.50,0:21:59.53,Default,,0000,0000,0000,,Бұл құбыжықтар күшті болмаған сияқты.
Dialogue: 0,0:21:59.53,0:22:03.57,Default,,0000,0000,0000,,Не?! (Вегета) Шу шығарма, Наппа.
Dialogue: 0,0:22:03.57,0:22:07.61,Default,,0000,0000,0000,,Қалған төртеуін өзім шешемін.
Dialogue: 0,0:22:07.61,0:22:10.30,Default,,0000,0000,0000,,Аспаз аспаз Аспаз. →
Dialogue: 0,0:22:10.30,0:22:13.00,Default,,0000,0000,0000,,Балалар, бұл жолы Мәдениет адамын бағаламаған сияқтысыңдар.
Dialogue: 0,0:22:13.00,0:22:15.02,Default,,0000,0000,0000,,Не? Ах!
Dialogue: 0,0:22:15.02,0:22:17.04,Default,,0000,0000,0000,,О!
Dialogue: 0,0:22:17.04,0:22:19.06,Default,,0000,0000,0000,,Га~!
Dialogue: 0,0:22:19.06,0:22:22.09,Default,,0000,0000,0000,,Маған қамқор болған сен бе? Рақмет…
Dialogue: 0,0:22:22.09,0:22:26.09,Default,,0000,0000,0000,,Ug….
Dialogue: 0,0:22:30.17,0:22:34.17,Default,,0000,0000,0000,,Өте жақсы…. (Өсіруші адам) Хахахаха.
Dialogue: 0,0:22:36.23,0:22:38.23,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:22:40.27,0:22:42.29,Default,,0000,0000,0000,,Гва~! (жарылыс дыбысы)
Dialogue: 0,0:22:42.29,0:22:45.32,Default,,0000,0000,0000,,Ах! (Пиколо/Гохан) Ах!
Dialogue: 0,0:22:45.32,0:22:47.32,Default,,0000,0000,0000,,Ямча!
Dialogue: 0,0:22:50.37,0:22:54.41,Default,,0000,0000,0000,,Иә, жақсы.
Dialogue: 0,0:22:54.41,0:22:58.41,Default,,0000,0000,0000,,Не болды? Ол өзін-өзі жоюға тырысты.
Dialogue: 0,0:23:01.48,0:23:04.48,Default,,0000,0000,0000,,Бұл қорқынышты.
Dialogue: 0,0:23:15.95,0:23:19.99,Default,,0000,0000,0000,,Тш, өлді.
Dialogue: 0,0:23:19.99,0:23:22.02,Default,,0000,0000,0000,,Ямча-сама! Ямча-сама! →
Dialogue: 0,0:23:22.02,0:23:26.06,Default,,0000,0000,0000,,Ямча-сама~! →
Dialogue: 0,0:23:26.06,0:23:31.11,Default,,0000,0000,0000,,Ямча-сама! Ямча-сама! →
Dialogue: 0,0:23:31.11,0:23:35.15,Default,,0000,0000,0000,,Ямча-сама~! Ууууу…. →
Dialogue: 0,0:23:35.15,0:23:39.19,Default,,0000,0000,0000,,Ямча-сама~!
Dialogue: 0,0:23:39.19,0:23:42.22,Default,,0000,0000,0000,,Ямчаның көңілі нашар болса керек. →
Dialogue: 0,0:23:42.22,0:23:45.25,Default,,0000,0000,0000,,Сонымен, менің орныма... →
Dialogue: 0,0:23:45.25,0:23:48.25,Default,,0000,0000,0000,,Читчикишо~.
Dialogue: 0,0:23:50.30,0:23:52.32,Default,,0000,0000,0000,,Чикишо~!
Dialogue: 0,0:23:52.32,0:23:56.36,Default,,0000,0000,0000,,Пуар мен Булма-санға не айтайын!
Dialogue: 0,0:23:56.36,0:24:00.40,Default,,0000,0000,0000,,Қандай аянышты мәдениетші!
Dialogue: 0,0:24:00.40,0:24:03.43,Default,,0000,0000,0000,,Ондай ақымаққа не істедің?
Dialogue: 0,0:24:03.43,0:24:09.43,Default,,0000,0000,0000,,Әй, бұл лас. Мына шүберекті тазалаңыз.
Dialogue: 0,0:24:11.84,0:24:14.87,Default,,0000,0000,0000,,Қарғыс атсын! →
Dialogue: 0,0:24:14.87,0:24:17.87,Default,,0000,0000,0000,,Барлығы аулақ болсын!
Dialogue: 0,0:24:19.92,0:24:24.92,Default,,0000,0000,0000,,Ямча мырза, мен міндетті түрде жауды шығарамын.
Dialogue: 0,0:24:26.99,0:24:30.99,Default,,0000,0000,0000,,Тренингтің нәтижесін көрсетемін!
Dialogue: 0,0:24:32.05,0:24:37.10,Default,,0000,0000,0000,,<Ямчаның өлімі кенеттен келді. →
Dialogue: 0,0:24:37.10,0:24:43.10,Default,,0000,0000,0000,,Криллиннің ашулануына себеп болған жаттығуларының нәтижесі қандай болды? ＞
Dialogue: 0,0:24:46.19,0:24:51.24,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:51.24,0:25:11.44,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:11.44,0:25:31.64,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:31.64,0:25:44.64,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:47.80,0:25:49.82,Default,,0000,0000,0000,,Сәлем, Гоку.
Dialogue: 0,0:25:49.82,0:25:52.85,Default,,0000,0000,0000,,Жақын жерде. Күте тұрыңыз, бәріңіз!
Dialogue: 0,0:25:52.85,0:25:55.88,Default,,0000,0000,0000,,Сен не ойладың, Джоза, ақымақ болма!
Dialogue: 0,0:25:55.88,0:25:58.91,Default,,0000,0000,0000,,Гёза мырза!
Dialogue: 0,0:25:58.91,0:26:01.94,Default,,0000,0000,0000,,Джоза Сен жалғызсың, мен сені жалғыз қалдырмаймын. →
Dialogue: 0,0:26:01.94,0:26:05.98,Default,,0000,0000,0000,,Менің соңғы қадамымды же, Саян!
Dialogue: 0,0:26:05.98,0:26:08.98,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»
Dialogue: 0,0:26:11.38,0:26:13.38,Default,,0000,0000,0000,,Тез кел, әке!
Dialogue: 0,0:26:14.88,0:26:20.88,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory