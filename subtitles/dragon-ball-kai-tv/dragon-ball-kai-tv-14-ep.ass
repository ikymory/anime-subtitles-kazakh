Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:10.96,0:00:15.96,Default,,0000,0000,0000,,<Вегета Наппаны өзі жерледі>
Dialogue: 0,0:00:18.04,0:00:22.08,Default,,0000,0000,0000,,<Соңында сол ерекше қабілеттің алдында→
Dialogue: 0,0:00:22.08,0:00:29.15,Default,,0000,0000,0000,,Гоку өзінің шегінен шығатын тамаша қимылмен құмар ойнайды.
Dialogue: 0,0:00:29.15,0:00:34.15,Default,,0000,0000,0000,,Маған денеңді әкел! Бұл 3 есе Кайокен!
Dialogue: 0,0:00:36.22,0:00:41.27,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:41.27,0:01:01.47,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:01.47,0:01:21.00,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:21.00,0:01:41.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:41.20,0:01:58.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:20.79,0:04:30.89,Default,,0000,0000,0000,,Ооооооо~.
Dialogue: 0,0:04:30.89,0:04:33.92,Default,,0000,0000,0000,,Ууууууу~.
Dialogue: 0,0:04:33.92,0:04:36.95,Default,,0000,0000,0000,,Ууууууу~.
Dialogue: 0,0:04:36.95,0:04:41.00,Default,,0000,0000,0000,,Гууууууу~.
Dialogue: 0,0:04:41.00,0:04:47.06,Default,,0000,0000,0000,,Ууууууу~.
Dialogue: 0,0:04:47.06,0:04:52.11,Default,,0000,0000,0000,,Торя~!
Dialogue: 0,0:04:52.11,0:04:58.17,Default,,0000,0000,0000,,У~ Уу~.
Dialogue: 0,0:04:58.17,0:05:00.19,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:05:00.19,0:05:03.22,Default,,0000,0000,0000,,Ой... ой... →
Dialogue: 0,0:05:03.22,0:05:05.24,Default,,0000,0000,0000,,Кууууу….
Dialogue: 0,0:05:05.24,0:05:13.65,Default,,0000,0000,0000,,3x Kaioken~!
Dialogue: 0,0:05:13.65,0:05:16.68,Default,,0000,0000,0000,,Гуаа.
Dialogue: 0,0:05:16.68,0:05:19.71,Default,,0000,0000,0000,,Урья~!
Dialogue: 0,0:05:19.71,0:05:21.73,Default,,0000,0000,0000,,Гуаа. →
Dialogue: 0,0:05:21.73,0:05:24.76,Default,,0000,0000,0000,,Гуа~.
Dialogue: 0,0:05:24.76,0:05:26.78,Default,,0000,0000,0000,,Бұл таңқаларлық.
Dialogue: 0,0:05:26.78,0:05:28.80,Default,,0000,0000,0000,,Қарғыс атсын. Ха.
Dialogue: 0,0:05:28.80,0:05:30.82,Default,,0000,0000,0000,,Терия~!
Dialogue: 0,0:05:30.82,0:05:32.82,Default,,0000,0000,0000,,Тория! (Вегета) Гуаа.
Dialogue: 0,0:05:41.93,0:05:44.96,Default,,0000,0000,0000,,Гаа~!
Dialogue: 0,0:05:44.96,0:05:46.98,Default,,0000,0000,0000,,《Өзім~! 》
Dialogue: 0,0:05:46.98,0:05:48.98,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:05:52.04,0:05:54.06,Default,,0000,0000,0000,,Гах! Ууууу….
Dialogue: 0,0:05:54.06,0:05:57.09,Default,,0000,0000,0000,,Уу-у...
Dialogue: 0,0:05:57.09,0:06:00.12,Default,,0000,0000,0000,,Куу~.
Dialogue: 0,0:06:00.12,0:06:05.17,Default,,0000,0000,0000,,Кууууууууууууууууууууууууууу….
Dialogue: 0,0:06:05.17,0:06:09.21,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:06:09.21,0:06:13.59,Default,,0000,0000,0000,,Кел, сен! →
Dialogue: 0,0:06:13.59,0:06:15.61,Default,,0000,0000,0000,,Теях.
Dialogue: 0,0:06:15.61,0:06:18.64,Default,,0000,0000,0000,,Күрсін... Күрсін.
Dialogue: 0,0:06:18.64,0:06:22.68,Default,,0000,0000,0000,,Мен бара аламын. Менің ойымша, бұл жігіт жеңе алады.
Dialogue: 0,0:06:22.68,0:06:24.70,Default,,0000,0000,0000,,Дея.
Dialogue: 0,0:06:24.70,0:06:27.73,Default,,0000,0000,0000,,Кууууууууууууууу~!
Dialogue: 0,0:06:27.73,0:06:32.78,Default,,0000,0000,0000,,Гуа~! Ууууууууууу!
Dialogue: 0,0:06:32.78,0:06:35.81,Default,,0000,0000,0000,,Ахх!
Dialogue: 0,0:06:35.81,0:06:38.84,Default,,0000,0000,0000,,Сол бір кездей…
Dialogue: 0,0:06:38.84,0:06:43.89,Default,,0000,0000,0000,,Дея каа~!
Dialogue: 0,0:06:43.89,0:06:45.91,Default,,0000,0000,0000,,Урья~! (Вегета) Уууу.
Dialogue: 0,0:06:45.91,0:06:49.95,Default,,0000,0000,0000,,Оля~! Әзірше емес!
Dialogue: 0,0:06:49.95,0:06:55.01,Default,,0000,0000,0000,,Атта~ Ататата! Дорья~!
Dialogue: 0,0:06:55.01,0:06:58.04,Default,,0000,0000,0000,,Урья~! (Вегета) Гаха!
Dialogue: 0,0:06:58.04,0:07:00.04,Default,,0000,0000,0000,,Ууууу~.
Dialogue: 0,0:07:02.08,0:07:05.11,Default,,0000,0000,0000,,Кук кук….
Dialogue: 0,0:07:05.11,0:07:08.14,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:07:08.14,0:07:14.53,Default,,0000,0000,0000,,Кук… хаа ха….
Dialogue: 0,0:07:14.53,0:07:17.56,Default,,0000,0000,0000,,Ух... Гах Гах. →
Dialogue: 0,0:07:17.56,0:07:19.58,Default,,0000,0000,0000,,Уу-у...
Dialogue: 0,0:07:19.58,0:07:22.61,Default,,0000,0000,0000,,《Жаман, ақымақ. Ол жігіт Какарот →
Dialogue: 0,0:07:22.61,0:07:26.65,Default,,0000,0000,0000,,Мен оның жауынгерлік күшімнен асып түсетініне сене алмаймын! 》
Dialogue: 0,0:07:26.65,0:07:31.70,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:07:31.70,0:07:37.76,Default,,0000,0000,0000,,Читчикушо Ол қатал жігіт. Мен тез шешім қабылдауым керек...
Dialogue: 0,0:07:37.76,0:07:39.78,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:07:39.78,0:07:43.82,Default,,0000,0000,0000,,Қарғыс атсын, менің денем...
Dialogue: 0,0:07:43.82,0:07:46.85,Default,,0000,0000,0000,,Мұндай жағдайдың болуы шыдамсыз ба? →
Dialogue: 0,0:07:46.85,0:07:48.87,Default,,0000,0000,0000,,Мен супер элитамын. →
Dialogue: 0,0:07:48.87,0:07:54.93,Default,,0000,0000,0000,,Мен мұндай төмен дәрежелі жауынгерден жеңілуге жол жоқ!
Dialogue: 0,0:07:54.93,0:07:58.97,Default,,0000,0000,0000,,Мен әлемдегі ең жақсымын!!
Dialogue: 0,0:07:58.97,0:08:03.02,Default,,0000,0000,0000,,《Күтілгендей, 3x Kaioken мүмкін емес сияқты. →
Dialogue: 0,0:08:03.02,0:08:07.06,Default,,0000,0000,0000,,Мен мұны істегенде, мен алдымен өлемін.
Dialogue: 0,0:08:07.06,0:08:11.43,Default,,0000,0000,0000,,Қарғыс атсын.
Dialogue: 0,0:08:11.43,0:08:14.46,Default,,0000,0000,0000,,Иә? Ах!? Қан! →
Dialogue: 0,0:08:14.46,0:08:18.50,Default,,0000,0000,0000,,Мен өзімнің асыл қаныммен осындай қоқыспен бетпе-бет келемін... →
Dialogue: 0,0:08:18.50,0:08:22.54,Default,,0000,0000,0000,,Ю-сан. Мүлдем→
Dialogue: 0,0:08:22.54,0:08:27.59,Default,,0000,0000,0000,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:08:27.59,0:08:29.61,Default,,0000,0000,0000,,Енді осындай жұлдыздар бар ма?
Dialogue: 0,0:08:29.61,0:08:34.66,Default,,0000,0000,0000,,Жерді жарып жібереді!!→
Dialogue: 0,0:08:34.66,0:08:36.68,Default,,0000,0000,0000,,Гаа~!
Dialogue: 0,0:08:36.68,0:08:39.68,Default,,0000,0000,0000,,Не!? (Вегета) Тааа!
Dialogue: 0,0:08:42.74,0:08:44.76,Default,,0000,0000,0000,,Егер сіз бірдеңеден жалтарсаңыз, одан құтылуға тырысыңыз. →
Dialogue: 0,0:08:44.76,0:08:48.80,Default,,0000,0000,0000,,Құтқарылсаң да жер жарылады!
Dialogue: 0,0:08:48.80,0:08:51.83,Default,,0000,0000,0000,,Мен бұл туралы ойладым, Чикушо!
Dialogue: 0,0:08:51.83,0:08:54.86,Default,,0000,0000,0000,,Гаа~!
Dialogue: 0,0:08:54.86,0:08:56.86,Default,,0000,0000,0000,,Менің оны қағудан басқа амалым жоқ.
Dialogue: 0,0:08:59.91,0:09:03.95,Default,,0000,0000,0000,,Хаа~.
Dialogue: 0,0:09:03.95,0:09:09.01,Default,,0000,0000,0000,,3x Кайокен →
Dialogue: 0,0:09:09.01,0:09:12.37,Default,,0000,0000,0000,,Камехамеха!
Dialogue: 0,0:09:12.37,0:09:18.43,Default,,0000,0000,0000,,Ka～ Мен～→
Dialogue: 0,0:09:18.43,0:09:21.46,Default,,0000,0000,0000,,бұл...
Dialogue: 0,0:09:21.46,0:09:24.49,Default,,0000,0000,0000,,Менің галициялық зеңбірегім ешқашан тоқтатылмайды!
Dialogue: 0,0:09:24.49,0:09:29.54,Default,,0000,0000,0000,,Сәлеметсіз бе.
Dialogue: 0,0:09:29.54,0:09:34.59,Default,,0000,0000,0000,,Жермен бірге ғаламның шаңы бол! Хаа~!!
Dialogue: 0,0:09:34.59,0:09:40.65,Default,,0000,0000,0000,,Толқын~!!
Dialogue: 0,0:09:40.65,0:09:42.65,Default,,0000,0000,0000,,Дохья~!
Dialogue: 0,0:09:47.72,0:09:51.76,Default,,0000,0000,0000,,Не!? Бұл менің Галрик зеңбірегіме ұқсайды.
Dialogue: 0,0:09:51.76,0:09:54.79,Default,,0000,0000,0000,,Шетелге, қалағанымша кез келген жерге бара алар едім—
Dialogue: 0,0:09:54.79,0:09:58.79,Default,,0000,0000,0000,,Дея~!
Dialogue: 0,0:10:02.87,0:10:09.87,Default,,0000,0000,0000,,Қарғыс атқыр... Кайокең 4 есе күшті!
Dialogue: 0,0:10:16.35,0:10:19.38,Default,,0000,0000,0000,,Гуах!? Әй, мені итеріп жатыр... →
Dialogue: 0,0:10:19.38,0:10:21.40,Default,,0000,0000,0000,,Уу-у... →
Dialogue: 0,0:10:21.40,0:10:25.40,Default,,0000,0000,0000,,Гуа~!!
Dialogue: 0,0:10:33.52,0:10:38.57,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:10:38.57,0:10:41.60,Default,,0000,0000,0000,,Ой... аа~.
Dialogue: 0,0:10:41.60,0:10:47.66,Default,,0000,0000,0000,,Ия, иә, иә. Мен оны істедім. →
Dialogue: 0,0:10:47.66,0:10:52.71,Default,,0000,0000,0000,,Немерем! Сен мұны істедің, бейбақ!
Dialogue: 0,0:10:52.71,0:10:54.73,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:54.73,0:10:57.76,Default,,0000,0000,0000,,Яджиробе, сен мұнда не үшін келдің?
Dialogue: 0,0:10:57.76,0:10:59.78,Default,,0000,0000,0000,,Не, мен мұны түсінбедім.
Dialogue: 0,0:10:59.78,0:11:03.82,Default,,0000,0000,0000,,Сіз бен біз шынымен үмітсіз болған шығармыз.
Dialogue: 0,0:11:03.82,0:11:05.84,Default,,0000,0000,0000,,Хахаха жақсы.
Dialogue: 0,0:11:05.84,0:11:08.87,Default,,0000,0000,0000,,Әйтсе де, мен әлгі ессіз жігітті үрлеп жіберетінмін.
Dialogue: 0,0:11:08.87,0:11:11.23,Default,,0000,0000,0000,,Сен шынымен де үлкен, ақымақ бейбақсың...
Dialogue: 0,0:11:11.23,0:11:14.26,Default,,0000,0000,0000,,Уау! Аа!?
Dialogue: 0,0:11:14.26,0:11:16.28,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:11:16.28,0:11:19.31,Default,,0000,0000,0000,,Не? ше?
Dialogue: 0,0:11:19.31,0:11:22.34,Default,,0000,0000,0000,,Сіз денеңізге мүмкін емес әдісті қолдандыңыз.
Dialogue: 0,0:11:22.34,0:11:25.37,Default,,0000,0000,0000,,Бұл қалыпты жағдай емес еді.
Dialogue: 0,0:11:25.37,0:11:29.41,Default,,0000,0000,0000,,Яджиробе, қашу керек.
Dialogue: 0,0:11:29.41,0:11:31.43,Default,,0000,0000,0000,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:11:31.43,0:11:34.46,Default,,0000,0000,0000,,Амал жоқ... Ол тірі.
Dialogue: 0,0:11:34.46,0:11:38.50,Default,,0000,0000,0000,,Егер сіз ашуланып өлетін адам болсаңыз, бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:11:38.50,0:11:41.53,Default,,0000,0000,0000,,Бірақ, жақсы ма?
Dialogue: 0,0:11:41.53,0:11:43.55,Default,,0000,0000,0000,,Сен менен күштірек болдың.
Dialogue: 0,0:11:43.55,0:11:47.59,Default,,0000,0000,0000,,Мен саған айттым, менің денем тым қатты күш салудан қатты.
Dialogue: 0,0:11:47.59,0:11:49.61,Default,,0000,0000,0000,,Мен өз шегіме жетуге жақын болуым мүмкін.
Dialogue: 0,0:11:49.61,0:11:51.63,Default,,0000,0000,0000,,көремін.
Dialogue: 0,0:11:51.63,0:11:53.65,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:11:53.65,0:11:55.67,Default,,0000,0000,0000,,Сонда кездескенше.
Dialogue: 0,0:11:55.67,0:12:01.73,Default,,0000,0000,0000,,Гах гах, қолыңнан келгенін істе. Ахаха! Иә?
Dialogue: 0,0:12:01.73,0:12:05.73,Default,,0000,0000,0000,,Гуа~!!
Dialogue: 0,0:12:07.79,0:12:10.99,Default,,0000,0000,0000,,Ууууууу! →
Dialogue: 0,0:12:10.99,0:12:15.20,Default,,0000,0000,0000,,Қарғыс атсын! →
Dialogue: 0,0:12:15.20,0:12:20.25,Default,,0000,0000,0000,,Неліктен!? Неліктен Какароттың жауынгерлік күші меннен асып түседі!?→
Dialogue: 0,0:12:20.25,0:12:22.27,Default,,0000,0000,0000,,Чикусо! →
Dialogue: 0,0:12:22.27,0:12:27.32,Default,,0000,0000,0000,,Мен Сайянмын! Мен әлемдегі ең күштімін!
Dialogue: 0,0:12:27.32,0:12:32.37,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:12:32.37,0:12:36.41,Default,,0000,0000,0000,,Бұл орын алған кезде бұл ұсқынсыз және жиіркенішті, бірақ бұл соңғы шара.
Dialogue: 0,0:12:36.41,0:12:40.45,Default,,0000,0000,0000,,Мен үлкен маймылға айналып, сені жаншып аламын. Хехехе.
Dialogue: 0,0:12:40.45,0:12:44.49,Default,,0000,0000,0000,,Менің мына алып маймылым онша күшті емес.
Dialogue: 0,0:12:44.49,0:12:48.53,Default,,0000,0000,0000,,Қарғыс атсын, мына ғаламшардағы жігіттерден тез құтылу үшін→
Dialogue: 0,0:12:48.53,0:12:50.55,Default,,0000,0000,0000,,Толық ай келетін күнді таңдадым→
Dialogue: 0,0:12:50.55,0:12:54.59,Default,,0000,0000,0000,,Мен оның Какаротты жеңу үшін өзгереді деп ешқашан ойламадым.
Dialogue: 0,0:12:54.59,0:12:56.59,Default,,0000,0000,0000,,Бұл ақылсыз!
Dialogue: 0,0:13:00.65,0:13:04.69,Default,,0000,0000,0000,,Айды көруге қолайлы уақыт болса да, біртүрлі.
Dialogue: 0,0:13:04.69,0:13:06.71,Default,,0000,0000,0000,,（） →
Dialogue: 0,0:13:06.71,0:13:11.10,Default,,0000,0000,0000,,Сайян, қанша іздесең де бекер. Ай жоқ.
Dialogue: 0,0:13:11.10,0:13:14.13,Default,,0000,0000,0000,,《Мен Пикколо сияқты нәрсе осылай аяқталады деп қорықтым→
Dialogue: 0,0:13:14.13,0:13:16.15,Default,,0000,0000,0000,,Мен оны әлдеқашан өшіріп тастадым. →
Dialogue: 0,0:13:16.15,0:13:21.20,Default,,0000,0000,0000,,Дегенмен, Сон Гокуда энергия қалмауы керек. →
Dialogue: 0,0:13:21.20,0:13:24.23,Default,,0000,0000,0000,,Сайян ұлы маймылға айналса да→
Dialogue: 0,0:13:24.23,0:13:26.25,Default,,0000,0000,0000,,Шымшуда өзгеріс жоқ. →
Dialogue: 0,0:13:26.25,0:13:28.27,Default,,0000,0000,0000,,Бірақ ол да әлсіз болып қалды. →
Dialogue: 0,0:13:28.27,0:13:35.27,Default,,0000,0000,0000,,Генкидам. Генкидама соққанша, сіз міндетті түрде жеңесіз.
Dialogue: 0,0:13:39.38,0:13:43.42,Default,,0000,0000,0000,,《Бұл біртүрлі. Ол қозғалып, тітіркендіреді. →
Dialogue: 0,0:13:43.42,0:13:45.44,Default,,0000,0000,0000,,Неге қоңырау шалмадың? 》
Dialogue: 0,0:13:45.44,0:13:50.49,Default,,0000,0000,0000,,Жоқ. жоқ! Чикушо: Ай еш жерде жоқ. →
Dialogue: 0,0:13:50.49,0:13:52.51,Default,,0000,0000,0000,,Сонымен, мен Кираны қоса алғанда сегіз адаммен бірге сусын іштім.
Dialogue: 0,0:13:52.51,0:13:57.56,Default,,0000,0000,0000,,Дұрыс, Чикушо. Ол мені үнемі ашуландыратын бейбақ.
Dialogue: 0,0:13:57.56,0:14:01.60,Default,,0000,0000,0000,,Какароттың жігіті айды алдын ала өшіріп тастады. Сөзсіз. →
Dialogue: 0,0:14:01.60,0:14:06.65,Default,,0000,0000,0000,,Оның жауынгерлік күші біршама төмен болғанымен, басқа амал жоқ сияқты.
Dialogue: 0,0:14:06.65,0:14:11.70,Default,,0000,0000,0000,,Ха, оның жүзіндегі таңданыс пен дүрбелең бір нәрсеге ұқсайды. Хахахаха! →
Dialogue: 0,0:14:11.70,0:14:13.70,Default,,0000,0000,0000,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:15:27.79,0:15:29.79,Default,,0000,0000,0000,,Ақыры мен түстім.
Dialogue: 0,0:15:34.86,0:15:37.89,Default,,0000,0000,0000,,《Генкидама оны жеңудің жалғыз жолы. →
Dialogue: 0,0:15:37.89,0:15:40.92,Default,,0000,0000,0000,,Сіз зейінді жақсы жинай аласыз ба?
Dialogue: 0,0:15:40.92,0:15:42.94,Default,,0000,0000,0000,,Какарот. Иә?
Dialogue: 0,0:15:42.94,0:15:45.97,Default,,0000,0000,0000,,Менің ойымша, олар айды өшіріп, мұны істей алады.→
Dialogue: 0,0:15:45.97,0:15:49.01,Default,,0000,0000,0000,,Бұл дұрыс емес. ай? Не айтқың келеді?
Dialogue: 0,0:15:49.01,0:15:54.06,Default,,0000,0000,0000,,Хахаха, сен сондай ақымақсың. Қымбаттым, неге толған айға қарап→
Dialogue: 0,0:15:54.06,0:15:58.10,Default,,0000,0000,0000,,Сіз өзгерте алатыныңызды білесіз бе? Трансформация?
Dialogue: 0,0:15:58.10,0:16:02.14,Default,,0000,0000,0000,,Ай сәулесі – шағылған күн сәулесі.
Dialogue: 0,0:16:02.14,0:16:04.16,Default,,0000,0000,0000,,Ай шағылысқан кезде ғана →
Dialogue: 0,0:16:04.16,0:16:07.19,Default,,0000,0000,0000,,Күн сәулесінде Бруц толқындары бар.
Dialogue: 0,0:16:07.19,0:16:09.21,Default,,0000,0000,0000,,Бруц толқыны толық айға айналғанда→
Dialogue: 0,0:16:09.21,0:16:13.25,Default,,0000,0000,0000,,Бұл 17 миллион Зенон санынан асып түседі.
Dialogue: 0,0:16:13.25,0:16:15.27,Default,,0000,0000,0000,,Сіз не айттыңыз?
Dialogue: 0,0:16:15.27,0:16:20.65,Default,,0000,0000,0000,,Егер сіз көзіңіз арқылы 17 миллион зенодан астам Бруц толқындарын жұтып алсаңыз →
Dialogue: 0,0:16:20.65,0:16:24.69,Default,,0000,0000,0000,,Трансформация құйрықты жауап ретінде басталады. →
Dialogue: 0,0:16:24.69,0:16:29.74,Default,,0000,0000,0000,,17 миллионнан астам ксеносы бар толық ай, тек шектеулі саны сайяндарға жасанды түрде қол жетімді →
Dialogue: 0,0:16:29.74,0:16:31.76,Default,,0000,0000,0000,,Оны жасауға болады. →
Dialogue: 0,0:16:31.76,0:16:34.79,Default,,0000,0000,0000,,Сіздің жоспарыңыз дұрыс болмады. Айды өшірсем де→
Dialogue: 0,0:16:34.79,0:16:39.84,Default,,0000,0000,0000,,Жұлдыздық оттегін осы қуат шарымен араластыру арқылы. →
Dialogue: 0,0:16:39.84,0:16:45.90,Default,,0000,0000,0000,,Хаа~. →
Dialogue: 0,0:16:45.90,0:16:49.94,Default,,0000,0000,0000,,Сізді күткенім үшін кешіріңіз, Какарот. Сіздің өлетін уақытыңыз келді.
Dialogue: 0,0:16:49.94,0:16:55.00,Default,,0000,0000,0000,,Төмен дәрежелі жауынгер супер элитаны жекпе-жекке шақырмауы керек еді.
Dialogue: 0,0:16:55.00,0:16:59.04,Default,,0000,0000,0000,,《Сол біртүрлі нұрды шығарған бойда оған деген қызығушылығым жоғалып кетті. →
Dialogue: 0,0:16:59.04,0:17:03.04,Default,,0000,0000,0000,,Одан кейін не істеуді жоспарлап отырсың? 》
Dialogue: 0,0:17:05.10,0:17:07.12,Default,,0000,0000,0000,,Хехе. →
Dialogue: 0,0:17:07.12,0:17:10.15,Default,,0000,0000,0000,,Дея~!!
Dialogue: 0,0:17:10.15,0:17:12.15,Default,,0000,0000,0000,,Мен білмейтін қыз…➡
Dialogue: 0,0:17:20.58,0:17:23.58,Default,,0000,0000,0000,,Шашыратыңыз және араластырыңыз.
Dialogue: 0,0:17:25.63,0:17:27.63,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:17:30.68,0:17:34.72,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:17:34.72,0:17:39.77,Default,,0000,0000,0000,,А, бұл... →
Dialogue: 0,0:17:39.77,0:17:42.77,Default,,0000,0000,0000,,Не? Сіз не істедіңіз?
Dialogue: 0,0:17:44.82,0:17:47.85,Default,,0000,0000,0000,,Жоқ...
Dialogue: 0,0:17:47.85,0:17:51.85,Default,,0000,0000,0000,,Ол айды жаратты!
Dialogue: 0,0:17:54.92,0:17:58.96,Default,,0000,0000,0000,,Хахахаха мен құйрығымнан айырылдым →
Dialogue: 0,0:17:58.96,0:18:02.00,Default,,0000,0000,0000,,Өкінбе. Эй Какарот!
Dialogue: 0,0:18:02.00,0:18:08.06,Default,,0000,0000,0000,,Ууууууууууууууууууууууууу....
Dialogue: 0,0:18:08.06,0:18:13.11,Default,,0000,0000,0000,,Күрсін... Күрсін... →
Dialogue: 0,0:18:13.11,0:18:17.15,Default,,0000,0000,0000,,Гаа~!
Dialogue: 0,0:18:17.15,0:18:19.34,Default,,0000,0000,0000,,Ах!?
Dialogue: 0,0:18:19.34,0:18:22.54,Default,,0000,0000,0000,,Ах... Гәккун.
Dialogue: 0,0:18:22.54,0:18:24.56,Default,,0000,0000,0000,,Осы уақытқа дейін?
Dialogue: 0,0:18:24.56,0:18:26.58,Default,,0000,0000,0000,,Ah Ah….
Dialogue: 0,0:18:26.58,0:18:32.64,Default,,0000,0000,0000,,Гаа~!
Dialogue: 0,0:18:32.64,0:18:34.66,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:34.66,0:18:36.68,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:18:36.68,0:18:43.75,Default,,0000,0000,0000,,Гуах~аа~!
Dialogue: 0,0:18:43.75,0:18:46.78,Default,,0000,0000,0000,,О!
Dialogue: 0,0:18:46.78,0:18:50.82,Default,,0000,0000,0000,,Ууууууу~.
Dialogue: 0,0:18:50.82,0:18:53.85,Default,,0000,0000,0000,,Ааа….
Dialogue: 0,0:18:53.85,0:18:56.88,Default,,0000,0000,0000,,Ууууууу…. →
Dialogue: 0,0:18:56.88,0:19:04.96,Default,,0000,0000,0000,,Гууууууу….
Dialogue: 0,0:19:04.96,0:19:07.99,Default,,0000,0000,0000,,Сәлем, сәлем.
Dialogue: 0,0:19:07.99,0:19:10.02,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:19:10.02,0:19:13.05,Default,,0000,0000,0000,,Әй, біз сол жақтан келдік.
Dialogue: 0,0:19:13.05,0:19:16.08,Default,,0000,0000,0000,,Маған қызық, бұл не, ол сондай жарық.
Dialogue: 0,0:19:16.08,0:19:18.10,Default,,0000,0000,0000,,Ааа….
Dialogue: 0,0:19:18.10,0:19:21.46,Default,,0000,0000,0000,,О...
Dialogue: 0,0:19:21.46,1180:06:49.65526,Default,,0000,0000,0000,,Бұл өте ақымақ.
Dialogue: 0,1180:06:49.65526,1180:06:53.65530,Default,,0000,0000,0000,,Ооо...
Dialogue: 0,1180:06:53.65530,1180:07:03.65440,Default,,0000,0000,0000,,Ууууууу~. →
Dialogue: 0,1180:07:03.65440,1180:07:06.65443,Default,,0000,0000,0000,,Ооооооооо!
Dialogue: 0,1180:07:06.65443,1180:07:09.65446,Default,,0000,0000,0000,,Не? Мен шынымен толқудамын.
Dialogue: 0,1180:07:09.65446,1180:07:13.65450,Default,,0000,0000,0000,,Әкеңнің көңіл-күйі тағы көтерілді деп ойлаймын.
Dialogue: 0,1180:07:13.65450,1180:07:17.65454,Default,,0000,0000,0000,,А-а, бұл жағымсыз сезім оның санасы ғана.
Dialogue: 0,1180:07:17.65454,1180:07:20.65457,Default,,0000,0000,0000,,Сонда да бұл жігіттің көңіл-күйі тозақ.
Dialogue: 0,1180:07:20.65457,1180:07:23.65460,Default,,0000,0000,0000,,Не болып жатыр?
Dialogue: 0,1180:07:23.65460,1180:07:28.65460,Default,,0000,0000,0000,,О, әке. Қарғыс атсын.
Dialogue: 0,1180:07:31.65468,1180:07:34.65471,Default,,0000,0000,0000,,Гохан.
Dialogue: 0,1180:07:34.65471,1180:07:37.65474,Default,,0000,0000,0000,,Мен қайтып барамын.
Dialogue: 0,1180:07:37.65474,1180:07:39.65476,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1180:07:39.65476,1180:07:41.65478,Default,,0000,0000,0000,,Қайтару.
Dialogue: 0,1180:07:41.65478,1180:07:45.65499,Default,,0000,0000,0000,,Гокуға қайта барасыз ба?
Dialogue: 0,1180:07:45.65499,1180:07:48.65518,Default,,0000,0000,0000,,Әкеңе қауіп төніп тұрғанын түсіндім.
Dialogue: 0,1180:07:48.65518,1180:07:51.65521,Default,,0000,0000,0000,,Бұлай жалғаса берсе, мен өлемін.
Dialogue: 0,1180:07:51.65521,1180:07:56.65526,Default,,0000,0000,0000,,Сен не айтып тұрсың, Гохан? Гоку... сенің әкең...
Dialogue: 0,1180:07:56.65526,1180:07:58.65528,Default,,0000,0000,0000,,Өлуге жол жоқ. →
Dialogue: 0,1180:07:58.65528,1180:08:02.65532,Default,,0000,0000,0000,,Бірінші: Біз сондай керемет рухпен бұл жігітке барсақ та...
Dialogue: 0,1180:08:02.65532,1180:08:06.00,Default,,0000,0000,0000,,Иә, білемін.
Dialogue: 0,1180:08:06.00,1180:08:08.65438,Default,,0000,0000,0000,,Бірақ→
Dialogue: 0,1180:08:08.65438,1180:08:11.65441,Default,,0000,0000,0000,,Мен міндетті түрде баруым керек!
Dialogue: 0,1180:08:11.65441,1180:08:13.65443,Default,,0000,0000,0000,,Ах!? Эй, эй! →
Dialogue: 0,1180:08:13.65443,1180:08:16.65443,Default,,0000,0000,0000,,Күте тұрыңыз, Гохан!
Dialogue: 0,1180:08:20.65450,1180:08:24.65454,Default,,0000,0000,0000,,Дея~! →
Dialogue: 0,1180:08:24.65454,1180:08:27.65457,Default,,0000,0000,0000,,Ах~. →
Dialogue: 0,1180:08:27.65457,1180:08:30.65460,Default,,0000,0000,0000,,Дея. Апыр-ай.
Dialogue: 0,1180:08:30.65460,1180:08:35.65465,Default,,0000,0000,0000,,Хахахахаха Қалайсың, Какарот?
Dialogue: 0,1180:08:35.65465,1180:08:37.65467,Default,,0000,0000,0000,,Бұл сіз үшін аяқталды!
Dialogue: 0,1180:08:37.65467,1180:08:39.65469,Default,,0000,0000,0000,,Уау.
Dialogue: 0,1180:08:39.65469,1180:08:42.65472,Default,,0000,0000,0000,,Ах~.
Dialogue: 0,1180:08:42.65472,1180:08:44.65474,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,1180:08:44.65474,1180:08:46.65474,Default,,0000,0000,0000,,Дея.
Dialogue: 0,1180:08:48.65512,1180:08:51.65512,Default,,0000,0000,0000,,Уу~ Ах!
Dialogue: 0,1180:08:53.65517,1180:08:56.65520,Default,,0000,0000,0000,,Уф. Гаа~!
Dialogue: 0,1180:08:56.65520,1180:09:00.65520,Default,,0000,0000,0000,,О, ұлы маймыл? Үлкен маймыл құбыжығы.
Dialogue: 0,1180:09:02.65526,1180:09:04.65528,Default,,0000,0000,0000,,Nu~. →
Dialogue: 0,1180:09:04.65528,1180:09:08.65532,Default,,0000,0000,0000,,Хахахаха мен саған жақсы нәрсе айтайын.
Dialogue: 0,1180:09:08.65532,1180:09:11.65535,Default,,0000,0000,0000,,Ұлы маймылға айналған Сайян→
Dialogue: 0,1180:09:11.65535,1180:09:14.65438,Default,,0000,0000,0000,,Сіздің жауынгерлік күшіңіз он есе артады!
Dialogue: 0,1180:09:14.65438,1180:09:16.65440,Default,,0000,0000,0000,,Иә?
Dialogue: 0,1180:09:16.65440,1180:09:19.65443,Default,,0000,0000,0000,,Ах!
Dialogue: 0,1180:09:19.65443,1180:09:24.65448,Default,,0000,0000,0000,,《Гоку, толық ай түні үлкен маймыл құбыжық пайда болады. →
Dialogue: 0,1180:09:24.65448,1180:09:29.65453,Default,,0000,0000,0000,,Ешқашан далаға шықпаңыз. Ұйықтасаңыз қауіпсіз.
Dialogue: 0,1180:09:29.65453,1180:09:31.65455,Default,,0000,0000,0000,,《Ол құйрық менікі→
Dialogue: 0,1180:09:31.65455,1180:09:34.65458,Default,,0000,0000,0000,,Мәңгілік өспесін. →
Dialogue: 0,1180:09:34.65458,1180:09:37.65461,Default,,0000,0000,0000,,Бұл қандай да бір жолмен кедергі болатын шығар.
Dialogue: 0,1180:09:37.65461,1180:09:42.65466,Default,,0000,0000,0000,,《Түсіндім, түсіндім.》
Dialogue: 0,1180:09:42.65466,1180:09:47.65504,Default,,0000,0000,0000,,О, құдайым. Атамды басып өлтірген →
Dialogue: 0,1180:09:47.65504,1180:09:52.65509,Default,,0000,0000,0000,,Сондай-ақ жекпе-жек өнері алаңында пайда болған құбыжық болды және оны жойды →
Dialogue: 0,1180:09:52.65509,1180:09:56.65513,Default,,0000,0000,0000,,Эй, бұл Ора ма еді?
Dialogue: 0,1180:09:56.65513,1180:09:59.65516,Default,,0000,0000,0000,,Уу~ Аа~. →
Dialogue: 0,1180:09:59.65516,1180:10:02.65519,Default,,0000,0000,0000,,Ах~.
Dialogue: 0,1180:10:02.65519,1180:10:06.65523,Default,,0000,0000,0000,,《Кешіріңіз, ақсақал, бұл жігіт шектен шыққан→
Dialogue: 0,1180:10:06.65523,1180:10:09.65526,Default,,0000,0000,0000,,Мүмкін мен барлық күш-қуатымды жұмсауым керек шығар→
Dialogue: 0,1180:10:09.65526,1180:10:11.65528,Default,,0000,0000,0000,,Жеңіске жету мүмкіндігі жоқ сияқты. →
Dialogue: 0,1180:10:11.65528,1180:10:16.65533,Default,,0000,0000,0000,,Өліп, ақыретке қайтқанда, Барып кешірім сұраймын.
Dialogue: 0,1180:10:16.65533,1180:10:20.65437,Default,,0000,0000,0000,,Деяаааааааааааааааааааааааааааааааа
Dialogue: 0,1180:10:20.65437,1180:10:22.65439,Default,,0000,0000,0000,,Мен саған Вегетаны көрсетемін!
Dialogue: 0,1180:10:22.65439,1180:10:28.65439,Default,,0000,0000,0000,,Ола мен жердің энергетикалық шарлары, Мен оларды тоқ қарынымды тойғызамын!
Dialogue: 0,1180:10:34.65451,1180:10:36.65451,Default,,0000,0000,0000,,《О, әке》
Dialogue: 0,1180:10:38.65455,1180:10:43.65460,Default,,0000,0000,0000,,《Гоку сенің ұлың ғой》
Dialogue: 0,1180:10:43.65460,1180:10:48.65498,Default,,0000,0000,0000,,Кук кук….
Dialogue: 0,1180:10:48.65498,1180:10:50.65500,Default,,0000,0000,0000,,Уау.
Dialogue: 0,1180:10:50.65500,1180:10:54.65500,Default,,0000,0000,0000,,Иә!? Дея~! Таа~!
Dialogue: 0,1180:10:57.65507,1180:11:02.65512,Default,,0000,0000,0000,,Кук кук ууу….
Dialogue: 0,1180:11:02.65512,1180:11:04.65514,Default,,0000,0000,0000,,Уау~ Иә. Апыр-ай.
Dialogue: 0,1180:11:04.65514,1180:11:07.65517,Default,,0000,0000,0000,,Хахахаха.
Dialogue: 0,1180:11:07.65517,1180:11:09.65519,Default,,0000,0000,0000,,Иә~!
Dialogue: 0,1180:11:09.65519,1180:11:11.65521,Default,,0000,0000,0000,,Као Кайокен!
Dialogue: 0,1180:11:11.65521,1180:11:15.65521,Default,,0000,0000,0000,,Дея. Таааа! Апыр-ай!
Dialogue: 0,1180:11:18.65528,1180:11:21.65531,Default,,0000,0000,0000,,Уф…. (Вегета) Хахахаха! →
Dialogue: 0,1180:11:21.65531,1180:11:26.00,Default,,0000,0000,0000,,Не болды? Ха ха ха ха.
Dialogue: 0,1180:11:26.00,1180:11:30.65440,Default,,0000,0000,0000,,Сіз тіпті қашып кете алмайсыз ба!?→
Dialogue: 0,1180:11:30.65440,1180:11:33.65443,Default,,0000,0000,0000,,Өл~!!
Dialogue: 0,1180:11:33.65443,1180:11:36.65446,Default,,0000,0000,0000,,Уау!
Dialogue: 0,1180:11:36.65446,1180:11:39.65449,Default,,0000,0000,0000,,Хахахахаха Не болды? Какарот. →
Dialogue: 0,1180:11:39.65449,1180:11:42.65452,Default,,0000,0000,0000,,Қолдарыңыз бен аяқтарыңыз шығып тұр ма? Ха ха ха ха.
Dialogue: 0,1180:11:42.65452,1180:11:46.65489,Default,,0000,0000,0000,,Бұл өте үлкен және өте жылдам.
Dialogue: 0,1180:11:46.65489,1180:11:50.65493,Default,,0000,0000,0000,,Менде энергия шарларын алу үшін шоғырлануға уақытым жоқ.
Dialogue: 0,1180:11:50.65493,1180:11:54.65497,Default,,0000,0000,0000,,Кайо-кенді 5 есе арттырсаңыз да, ол оған қарсы жұмыс істемейді.
Dialogue: 0,1180:11:54.65497,1180:11:57.65500,Default,,0000,0000,0000,,А, келе жатыр емес пе?
Dialogue: 0,1180:11:57.65500,1180:12:00.65503,Default,,0000,0000,0000,,Олай болса, осы жерден кетеміз!
Dialogue: 0,1180:12:00.65503,1180:12:05.65508,Default,,0000,0000,0000,,<Үмітсіз жағдай! Ұлы маймылға айналған Вегетаның алдында →
Dialogue: 0,1180:12:05.65508,1180:12:09.65512,Default,,0000,0000,0000,,Сен рухтық допты боса аласың ба, Гоку!?>
Dialogue: 0,1180:12:09.65512,1180:12:12.65515,Default,,0000,0000,0000,,Қарғыс атқыр, бұл бар болғаны 10 секундты алады.
Dialogue: 0,1180:12:12.65515,1180:12:15.65515,Default,,0000,0000,0000,,Маған көңіл бөлуге уақыт беріңіз!
Dialogue: 0,1180:12:17.65520,1180:12:22.65525,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,1180:12:22.65525,1180:12:42.65445,Default,,0000,0000,0000,,Сен
Dialogue: 0,1180:12:42.65445,1180:13:02.65465,Default,,0000,0000,0000,,Сен
Dialogue: 0,1180:13:02.65465,1180:13:15.65465,Default,,0000,0000,0000,,Сен
Dialogue: 0,1180:13:19.65482,1180:13:23.65486,Default,,0000,0000,0000,,Сәлем, Гоку. Жердің түкпір-түкпірінен қуат жинасам да, қарғыс атсын.
Dialogue: 0,1180:13:23.65486,1180:13:26.65489,Default,,0000,0000,0000,,Вегетаның шабуылы тым жылдам болды, ал Генкидам...
Dialogue: 0,1180:13:26.65489,1180:13:28.65491,Default,,0000,0000,0000,,Не істегіңіз келетінін білмеймін, бірақ бұл мағынасыз. →
Dialogue: 0,1180:13:28.65491,1180:13:31.65494,Default,,0000,0000,0000,,Мен сені қолыммен жаншып аламын.
Dialogue: 0,1180:13:31.65494,1180:13:33.65496,Default,,0000,0000,0000,,Тоқта! Әкеңді жібер!
Dialogue: 0,1180:13:33.65496,1180:13:36.65499,Default,,0000,0000,0000,,Не!? Сіз менің құйрығыма ұмтыласыз ба?
Dialogue: 0,1180:13:36.65499,1180:13:39.65499,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»
Dialogue: 0,1180:13:42.65505,1180:13:44.65505,Default,,0000,0000,0000,,Мен сені жеңемін!
Dialogue: 0,1180:13:46.15,1180:13:52.15,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory