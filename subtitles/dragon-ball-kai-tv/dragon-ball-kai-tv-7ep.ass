Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.83,0:00:10.87,Default,,0000,0000,0000,,<Ақыры мен жыланның жолының соңын көрдім. →
Dialogue: 0,0:00:10.87,0:00:16.93,Default,,0000,0000,0000,,Үлкен ауырлық жағдайында Кай патша берген бірінші тапсырма → болды
Dialogue: 0,0:00:16.93,0:00:20.97,Default,,0000,0000,0000,,Chasing my pet Bubbles. →
Dialogue: 0,0:00:20.97,0:00:25.02,Default,,0000,0000,0000,,Сайяндардың келуіне 158 күн қалды. →
Dialogue: 0,0:00:25.02,0:00:29.02,Default,,0000,0000,0000,,Гоку қаншалықты күшті бола алады? ＞
Dialogue: 0,0:00:31.08,0:00:36.13,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:36.13,0:00:56.33,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:00:56.33,0:01:16.87,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:16.87,0:01:36.07,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:36.07,0:01:53.07,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:21.71,0:04:26.76,Default,,0000,0000,0000,,Уау, бұл тамаша тамақтану тәсілі. Ah, already...
Dialogue: 0,0:04:26.76,0:04:29.79,Default,,0000,0000,0000,,А, тағы бірдеңе...
Dialogue: 0,0:04:29.79,0:04:32.82,Default,,0000,0000,0000,,Әй, неге сәл кідірмейсің?
Dialogue: 0,0:04:32.82,0:04:34.84,Default,,0000,0000,0000,,Take the bowl!
Dialogue: 0,0:04:34.84,0:04:38.88,Default,,0000,0000,0000,,Hahahaha! Take off the bowl. Да~!
Dialogue: 0,0:04:38.88,0:04:40.90,Default,,0000,0000,0000,,Where's the pun? Эй.
Dialogue: 0,0:04:40.90,0:04:46.96,Default,,0000,0000,0000,,Пуха~ Мен жедім, жедім! Дәміне қарамай ішім тоқ.
Dialogue: 0,0:04:46.96,0:04:52.02,Default,,0000,0000,0000,,This man probably doesn't respect me.
Dialogue: 0,0:04:52.02,0:04:54.04,Default,,0000,0000,0000,,But, King Kai→
Dialogue: 0,0:04:54.04,0:04:58.08,Default,,0000,0000,0000,,I never get bored on such a small planet.
Dialogue: 0,0:04:58.08,0:05:01.11,Default,,0000,0000,0000,,Фуфуфуфуфуфуфу Сен жассың.
Dialogue: 0,0:05:01.11,0:05:03.13,Default,,0000,0000,0000,,Осындай жерде де, егер ұнаса →
Dialogue: 0,0:05:03.13,0:05:07.51,Default,,0000,0000,0000,,Қызықты істер көп. →
Dialogue: 0,0:05:07.51,0:05:10.54,Default,,0000,0000,0000,,Қанша шөп өсіп жатқанын сана→
Dialogue: 0,0:05:10.54,0:05:13.57,Default,,0000,0000,0000,,Аспанға қарап →
Dialogue: 0,0:05:13.57,0:05:17.61,Default,,0000,0000,0000,,Зәріңізді алысқа шашыңыз.
Dialogue: 0,0:05:17.61,0:05:21.65,Default,,0000,0000,0000,,Соңғы уақыттағы хоббиім →
Dialogue: 0,0:05:21.65,0:05:24.65,Default,,0000,0000,0000,,Drive, I guess.
Dialogue: 0,0:05:27.71,0:05:30.74,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:30.74,0:05:33.77,Default,,0000,0000,0000,,Енді асығыңыз да, Көпіршіктерді ұстаңыз.
Dialogue: 0,0:05:33.77,0:05:38.82,Default,,0000,0000,0000,,Әйтпесе, сен маған соғыс өнерін ешқашан үйрете алмайсың.
Dialogue: 0,0:05:38.82,0:05:41.85,Default,,0000,0000,0000,,А-а, мен бар күшімді саламын. Жақсы.
Dialogue: 0,0:05:41.85,0:05:43.87,Default,,0000,0000,0000,,Аа, дұрыс. иә?
Dialogue: 0,0:05:43.87,0:05:46.90,Default,,0000,0000,0000,,Бұрын шешіп алған ауыр киім мен аяқ киімді киіп, қайта жүгіріңіз.
Dialogue: 0,0:05:46.90,0:05:49.93,Default,,0000,0000,0000,,Не? (Каиу) Бұл тиімдірек.
Dialogue: 0,0:05:49.93,0:05:53.97,Default,,0000,0000,0000,,Оны кигенде жүгіру одан да қиын.
Dialogue: 0,0:05:53.97,0:05:55.99,Default,,0000,0000,0000,,Маған жақсы нәрсе айтайын.
Dialogue: 0,0:05:55.99,0:06:00.04,Default,,0000,0000,0000,,Сайяндар өмір сүрген планетаның тартылыс күші шамамен осы жердегідей болды.
Dialogue: 0,0:06:00.04,0:06:03.07,Default,,0000,0000,0000,,Олар сонда жаттығады.
Dialogue: 0,0:06:03.07,0:06:05.25,Default,,0000,0000,0000,,Аа...
Dialogue: 0,0:06:05.25,0:06:10.47,Default,,0000,0000,0000,,Сайян күшінің сырын аз да болса түсіндіңіздер деп ойлаймын.
Dialogue: 0,0:06:10.47,0:06:12.49,Default,,0000,0000,0000,,Бірақ бұл бәрі емес.
Dialogue: 0,0:06:12.49,0:06:16.53,Default,,0000,0000,0000,,Сайандар туа біткен күрес сезімімен туады.
Dialogue: 0,0:06:16.53,0:06:20.57,Default,,0000,0000,0000,,Бұл да қиын тұс.
Dialogue: 0,0:06:20.57,0:06:24.61,Default,,0000,0000,0000,,Жарайды, мен де Сайянмын.
Dialogue: 0,0:06:24.61,0:06:26.63,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:06:26.63,0:06:29.66,Default,,0000,0000,0000,,Ta~! Atatatatatata!
Dialogue: 0,0:06:29.66,0:06:33.70,Default,,0000,0000,0000,,Оля~! Торя~! Торя~!
Dialogue: 0,0:06:33.70,0:06:35.72,Default,,0000,0000,0000,,Атататата!
Dialogue: 0,0:06:35.72,0:06:37.74,Default,,0000,0000,0000,,Таа!
Dialogue: 0,0:06:37.74,0:06:39.76,Default,,0000,0000,0000,,Гва! иә!
Dialogue: 0,0:06:39.76,0:06:42.79,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:06:42.79,0:06:45.82,Default,,0000,0000,0000,,Хехе... Бұл жақсы соққы. →
Dialogue: 0,0:06:45.82,0:06:49.86,Default,,0000,0000,0000,,Шабуыл жасауды тоқтатпа!
Dialogue: 0,0:06:49.86,0:06:51.88,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:06:51.88,0:06:53.90,Default,,0000,0000,0000,,Буха.
Dialogue: 0,0:06:53.90,0:06:57.90,Default,,0000,0000,0000,,Әй, аға, көмектесіңізші.
Dialogue: 0,0:06:59.96,0:07:02.99,Default,,0000,0000,0000,,Бұзық болма, боқтық!
Dialogue: 0,0:07:02.99,0:07:05.69,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:07:05.69,0:07:07.37,Default,,0000,0000,0000,,Кехо Кехо Кехо Кехо.
Dialogue: 0,0:07:07.37,0:07:10.40,Default,,0000,0000,0000,,Өйткені, өзінің мүмкіндігін көрсететін адам →
Dialogue: 0,0:07:10.40,0:07:13.40,Default,,0000,0000,0000,,Бұл тек толық ай түндерінде бола ма?
Dialogue: 0,0:07:26.56,0:07:28.58,Default,,0000,0000,0000,,Хакушон! Ауырсыну.
Dialogue: 0,0:07:28.58,0:07:32.62,Default,,0000,0000,0000,,Хмф... Соңғы алты айда жылау мәселесін шешіп алған сияқтысыз.
Dialogue: 0,0:07:32.62,0:07:34.64,Default,,0000,0000,0000,,Хэхехе.
Dialogue: 0,0:07:34.64,0:07:39.69,Default,,0000,0000,0000,,Эй, Пикколо-сан, сен әкеңмен баяғыда ұрысып қалдың ғой, солай ма?
Dialogue: 0,0:07:39.69,0:07:42.72,Default,,0000,0000,0000,,Шайқас әлі аяқталған жоқ.
Dialogue: 0,0:07:42.72,0:07:47.77,Default,,0000,0000,0000,,Сайяндарды жеңсек, келесі кезегі сенің әкеңе келеді.
Dialogue: 0,0:07:47.77,0:07:52.82,Default,,0000,0000,0000,,Бірақ әкең солай деді. Пикколо мырза қайта дүниеге келді →
Dialogue: 0,0:07:52.82,0:07:55.85,Default,,0000,0000,0000,,Бұрынғыдай жаман адам емес сияқты.
Dialogue: 0,0:07:55.85,0:07:59.89,Default,,0000,0000,0000,,Цк. Мен де солай ойлаймын.
Dialogue: 0,0:07:59.89,0:08:03.93,Default,,0000,0000,0000,,Анам мен атам қорқып қалды.
Dialogue: 0,0:08:03.93,0:08:07.31,Default,,0000,0000,0000,,Бос сөзді қойып, ұйықта!
Dialogue: 0,0:08:07.31,0:08:09.33,Default,,0000,0000,0000,,Ертең мұндай жұмсақ жаттығу болмайды!
Dialogue: 0,0:08:09.33,0:08:11.33,Default,,0000,0000,0000,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің.
Dialogue: 0,0:08:16.40,0:08:22.46,Default,,0000,0000,0000,,(ұйықтау)
Dialogue: 0,0:08:22.46,0:08:26.46,Default,,0000,0000,0000,,Куу... қарғыс атсын.
Dialogue: 0,0:08:28.52,0:08:36.60,Default,,0000,0000,0000,,<Сосын көзді ашып-жұмғанша үш апта өтті>
Dialogue: 0,0:08:36.60,0:08:40.64,Default,,0000,0000,0000,,Шумайдың дәмі сондай дәмді.
Dialogue: 0,0:08:40.64,0:08:45.69,Default,,0000,0000,0000,,Сен, Шумай, Кими, Шумай... Сен, сен білмейсің.
Dialogue: 0,0:08:45.69,0:08:49.73,Default,,0000,0000,0000,,Аххххх! Тамаша, тамаша, аха!
Dialogue: 0,0:08:49.73,0:08:51.75,Default,,0000,0000,0000,,Хахаха! Ха~ Уфуфу... →
Dialogue: 0,0:08:51.75,0:08:54.78,Default,,0000,0000,0000,,О? Тыңдап жатқан ешкім жоқ па?
Dialogue: 0,0:08:54.78,0:08:57.81,Default,,0000,0000,0000,,Дея Дея Дея Дея Дея! Уууууу уууу.
Dialogue: 0,0:08:57.81,0:09:01.85,Default,,0000,0000,0000,,Күт, күт, күт, күт! Дея дея!
Dialogue: 0,0:09:01.85,0:09:04.88,Default,,0000,0000,0000,,Гиоза бар.
Dialogue: 0,0:09:04.88,0:09:06.88,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:09:09.26,0:09:11.26,Default,,0000,0000,0000,,Могумогу….
Dialogue: 0,0:09:15.32,0:09:17.34,Default,,0000,0000,0000,,Енді.
Dialogue: 0,0:09:17.34,0:09:19.34,Default,,0000,0000,0000,,Бұл ұят.
Dialogue: 0,0:09:21.38,0:09:24.41,Default,,0000,0000,0000,,Уау. Уау!
Dialogue: 0,0:09:24.41,0:09:27.44,Default,,0000,0000,0000,,Қарғыс атсын.
Dialogue: 0,0:09:27.44,0:09:30.47,Default,,0000,0000,0000,,Уууу уууу. Жақсы.
Dialogue: 0,0:09:30.47,0:09:33.50,Default,,0000,0000,0000,,Уу-у-уу-у.
Dialogue: 0,0:09:33.50,0:09:35.52,Default,,0000,0000,0000,,Хехехе, жақсы жүрсің. →
Dialogue: 0,0:09:35.52,0:09:37.54,Default,,0000,0000,0000,,Уф. Күте тұрыңыз!
Dialogue: 0,0:09:37.54,0:09:41.58,Default,,0000,0000,0000,,Өйткені, олар мені мүлдем сыйламайды.
Dialogue: 0,0:09:41.58,0:09:55.72,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:09:55.72,0:09:57.74,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:57.74,0:10:00.77,Default,,0000,0000,0000,,Уу-ууу!
Dialogue: 0,0:10:00.77,0:10:06.16,Default,,0000,0000,0000,,Бұл жігіт шынымен де керемет. Бірақ, мен жеңілмеймін.
Dialogue: 0,0:10:06.16,0:10:09.19,Default,,0000,0000,0000,,Дея Дея Дея Дея Дея!
Dialogue: 0,0:10:09.19,0:10:12.22,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:10:12.22,0:10:16.26,Default,,0000,0000,0000,,Ухо Ухо Ухо Ухо.
Dialogue: 0,0:10:16.26,0:10:19.29,Default,,0000,0000,0000,,Хмм... ол жақында қалды.
Dialogue: 0,0:10:19.29,0:10:22.32,Default,,0000,0000,0000,,О? Иә?
Dialogue: 0,0:10:22.32,0:10:25.35,Default,,0000,0000,0000,,Иә? Бұл дұрыс.
Dialogue: 0,0:10:25.35,0:10:28.35,Default,,0000,0000,0000,,Дея Дея Дея Дея!
Dialogue: 0,0:10:31.41,0:10:33.43,Default,,0000,0000,0000,,Дея Дея Дея! Уууу!?
Dialogue: 0,0:10:33.43,0:10:37.47,Default,,0000,0000,0000,,Күтілгендей. Дея! Уууууу ууууу!
Dialogue: 0,0:10:37.47,0:10:39.49,Default,,0000,0000,0000,,Дея deya deya deya! Жақсы.
Dialogue: 0,0:10:39.49,0:10:42.49,Default,,0000,0000,0000,,Дея deya deya deya! Күте тұрыңыз!
Dialogue: 0,0:10:48.58,0:10:50.60,Default,,0000,0000,0000,,Баа~. Күте тұрыңыз!
Dialogue: 0,0:10:50.60,0:10:53.63,Default,,0000,0000,0000,,Дея Дея Дея Дея Дея! Уууууу ууууу!
Dialogue: 0,0:10:53.63,0:10:55.65,Default,,0000,0000,0000,,Дея Дея Дея! Уау!
Dialogue: 0,0:10:55.65,0:10:57.67,Default,,0000,0000,0000,,Делляяля!
Dialogue: 0,0:10:57.67,0:10:59.69,Default,,0000,0000,0000,,Торя~!
Dialogue: 0,0:10:59.69,0:11:01.71,Default,,0000,0000,0000,,О.
Dialogue: 0,0:11:01.71,0:11:03.73,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:11:03.73,0:11:06.09,Default,,0000,0000,0000,,Уау~ Мен мұны жасадым~!
Dialogue: 0,0:11:06.09,0:11:09.12,Default,,0000,0000,0000,,Мен оны ұстадым!
Dialogue: 0,0:11:09.12,0:11:13.16,Default,,0000,0000,0000,,《Мм, ол мен ойлағандай керемет. →
Dialogue: 0,0:11:13.16,0:11:19.22,Default,,0000,0000,0000,,Сіз бұл жұлдыздың тартылыс күшін өзіңіздікіне айналдырдыңыз ба? →
Dialogue: 0,0:11:19.22,0:11:24.22,Default,,0000,0000,0000,,Ол Кайо-кенді меңгеруі мүмкін.
Dialogue: 0,0:11:32.35,0:11:34.37,Default,,0000,0000,0000,,Нуа~! Апыр-ай!
Dialogue: 0,0:11:34.37,0:11:38.41,Default,,0000,0000,0000,,Хахахахаха Тез тұр.
Dialogue: 0,0:11:38.41,0:11:40.43,Default,,0000,0000,0000,,Дея.
Dialogue: 0,0:11:40.43,0:11:43.46,Default,,0000,0000,0000,,Хехе. Хехехе.
Dialogue: 0,0:11:43.46,0:11:47.50,Default,,0000,0000,0000,,Бір-екі рет жалтарып, алданып қалмаңыз.
Dialogue: 0,0:11:47.50,0:11:49.52,Default,,0000,0000,0000,,Әлі де тәтті!
Dialogue: 0,0:11:49.52,0:11:53.52,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:11:57.60,0:12:01.64,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:12:01.64,0:12:04.67,Default,,0000,0000,0000,,Маған көмектесіңізші.
Dialogue: 0,0:12:04.67,0:12:07.04,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:12:07.04,0:12:10.04,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:12:14.11,0:12:16.11,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:12:20.17,0:12:23.20,Default,,0000,0000,0000,,Өз күшіңізбен келіңіз!
Dialogue: 0,0:12:23.20,0:12:26.20,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:12:39.36,0:12:46.43,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:12:46.43,0:12:49.43,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:12:51.48,0:12:56.53,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:12:56.53,0:12:58.53,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:13:06.96,0:13:09.99,Default,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:13:09.99,0:13:12.02,Default,,0000,0000,0000,,Тиін! Қарбыз!
Dialogue: 0,0:13:12.02,0:13:16.06,Default,,0000,0000,0000,,Шағала! Медака! құбыжық!
Dialogue: 0,0:13:16.06,0:13:20.10,Default,,0000,0000,0000,,Сиыр! Ақ аю! Мари!
Dialogue: 0,0:13:20.10,0:13:25.15,Default,,0000,0000,0000,,Apple! горилла! Арыстан!
Dialogue: 0,0:13:25.15,0:13:28.18,Default,,0000,0000,0000,,Келесі Айтыңыз!
Dialogue: 0,0:13:28.18,0:13:39.29,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:13:39.29,0:13:43.33,Default,,0000,0000,0000,,Тен-сан да, Ямча-сан да қайта таң қалдырды.
Dialogue: 0,0:13:43.33,0:13:45.35,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:13:45.35,0:13:48.35,Default,,0000,0000,0000,,Ха! Ха!
Dialogue: 0,0:13:50.40,0:13:53.40,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:13:57.47,0:13:59.49,Default,,0000,0000,0000,,Ха~!
Dialogue: 0,0:13:59.49,0:14:01.51,Default,,0000,0000,0000,,...tttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt.
Dialogue: 0,0:14:01.51,0:14:04.54,Default,,0000,0000,0000,,Yajirobe Мұны байыппен жасаңыз!
Dialogue: 0,0:14:04.54,0:14:06.56,Default,,0000,0000,0000,,Хун.
Dialogue: 0,0:14:06.56,0:14:08.58,Default,,0000,0000,0000,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:14:08.58,0:14:11.61,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:14:11.61,0:14:13.61,Default,,0000,0000,0000,,Ауырды!
Dialogue: 0,0:15:36.79,0:15:39.82,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:15:39.82,0:15:44.87,Default,,0000,0000,0000,,Хаха~ жасадым мен жасадым~ Хаха~. Ууууууу.
Dialogue: 0,0:15:44.87,0:15:47.90,Default,,0000,0000,0000,,Кай патша, енді не істеуім керек?
Dialogue: 0,0:15:47.90,0:15:50.93,Default,,0000,0000,0000,,«Мен не істеуім керек?» Ал...
Dialogue: 0,0:15:50.93,0:15:53.96,Default,,0000,0000,0000,,Сіз бірдеңе істейсіз бе? аа.
Dialogue: 0,0:15:53.96,0:15:56.99,Default,,0000,0000,0000,,Олай болса, күнжіт тұқымын пайдаланғыңыз келе ме? Хехехе.
Dialogue: 0,0:15:56.99,0:16:00.03,Default,,0000,0000,0000,,Uppupupupu…. ау.
Dialogue: 0,0:16:00.03,0:16:02.05,Default,,0000,0000,0000,,Пепе Пепе.
Dialogue: 0,0:16:02.05,0:16:06.09,Default,,0000,0000,0000,,Кай патша, мен тез жаттығуым керек, Сайяндар...
Dialogue: 0,0:16:06.09,0:16:10.13,Default,,0000,0000,0000,,Хмф, үрейленбеңіз. Әлі 135 күн бар.
Dialogue: 0,0:16:10.13,0:16:14.17,Default,,0000,0000,0000,,Бұл өте тез өтеді.
Dialogue: 0,0:16:14.17,0:16:18.21,Default,,0000,0000,0000,,Сонымен...
Dialogue: 0,0:16:18.21,0:16:26.29,Default,,0000,0000,0000,,Ах!!
Dialogue: 0,0:16:26.29,0:16:29.32,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:16:29.32,0:16:32.68,Default,,0000,0000,0000,,Не? Иә?
Dialogue: 0,0:16:32.68,0:16:36.68,Default,,0000,0000,0000,,Қайтып келетін уақыт та аз қалды. қайтып келу?
Dialogue: 0,0:16:40.76,0:16:44.80,Default,,0000,0000,0000,,Эй, міне. Иә?
Dialogue: 0,0:16:44.80,0:16:49.85,Default,,0000,0000,0000,,A~!!
Dialogue: 0,0:16:49.85,0:16:51.87,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:16:51.87,0:16:54.90,Default,,0000,0000,0000,,Көзді ашып-жұмғанша Армадильо.
Dialogue: 0,0:16:54.90,0:16:57.93,Default,,0000,0000,0000,,Пуффуфуфу Тамаша, тамаша Мен тамаша істеп жатырмын.
Dialogue: 0,0:16:57.93,0:17:00.96,Default,,0000,0000,0000,,Сіз шынымен күштісіз бе?
Dialogue: 0,0:17:00.96,0:17:03.96,Default,,0000,0000,0000,,- (Григорий) Бұл дөрекі! Иә?
Dialogue: 0,0:17:07.03,0:17:10.06,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:17:10.06,0:17:13.06,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:17:17.13,0:17:21.17,Default,,0000,0000,0000,,Жарқанат, сен шегірткеге ұқсайсың. (Грегорий) Батта?
Dialogue: 0,0:17:21.17,0:17:23.19,Default,,0000,0000,0000,,Сен сондай шегірткесің. →
Dialogue: 0,0:17:23.19,0:17:27.23,Default,,0000,0000,0000,,Күшік. Ах, мен жақсы жүрмін. (Грегори) Көңіліңізді қалдырғаным үшін кешіріңіз.
Dialogue: 0,0:17:27.23,0:17:30.43,Default,,0000,0000,0000,,Мен Кай патшаның жеке істерімен айналысамын→
Dialogue: 0,0:17:30.43,0:17:32.62,Default,,0000,0000,0000,,Оның аты - Григорий.
Dialogue: 0,0:17:32.62,0:17:34.64,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:17:34.64,0:17:38.68,Default,,0000,0000,0000,,Ол бүкіл ғаламның құдайларының басында тұр→
Dialogue: 0,0:17:38.68,0:17:40.70,Default,,0000,0000,0000,,Кай патшаға...
Dialogue: 0,0:17:40.70,0:17:44.74,Default,,0000,0000,0000,,Кукуку... осындай шегіртке хахахаха!
Dialogue: 0,0:17:44.74,0:17:47.77,Default,,0000,0000,0000,,Охон. Кай патшаға қарай →
Dialogue: 0,0:17:47.77,0:17:51.81,Default,,0000,0000,0000,,«Сен шынымен де сондай күштісің бе? Мен жиі сұраймын, бірақ не істерімді білмеймін.
Dialogue: 0,0:17:51.81,0:17:54.84,Default,,0000,0000,0000,,Надандықтың да шегі бар!
Dialogue: 0,0:17:54.84,0:17:57.87,Default,,0000,0000,0000,,Әй, менде қамшы жоқ.
Dialogue: 0,0:17:57.87,0:17:59.89,Default,,0000,0000,0000,,Күшік күшік! →
Dialogue: 0,0:17:59.89,0:18:02.92,Default,,0000,0000,0000,,Сон Гоку, сен өте перспективалысың.
Dialogue: 0,0:18:02.92,0:18:06.96,Default,,0000,0000,0000,,Кай патша, қазір күлдіретін уақыт емес.
Dialogue: 0,0:18:06.96,0:18:08.98,Default,,0000,0000,0000,,Ой, дәл Сон Гоку.
Dialogue: 0,0:18:08.98,0:18:12.02,Default,,0000,0000,0000,,Көпіршіктер, сіздің келесі қарсыласыңыз Григорий.
Dialogue: 0,0:18:12.02,0:18:14.04,Default,,0000,0000,0000,,Не? Бұл жігіт?
Dialogue: 0,0:18:14.04,0:18:16.06,Default,,0000,0000,0000,,Бұл қандай бет?
Dialogue: 0,0:18:16.06,0:18:21.11,Default,,0000,0000,0000,,Мен Кай патшаның маған тікелей үйреткені жақсы болар еді деп ойладым.
Dialogue: 0,0:18:21.11,0:18:24.14,Default,,0000,0000,0000,,Кай патша, мен қатты ашуландым.
Dialogue: 0,0:18:24.14,0:18:27.17,Default,,0000,0000,0000,,Мені менсінбейтін мына жігіттің мұрнының көпірі→
Dialogue: 0,0:18:27.17,0:18:29.19,Default,,0000,0000,0000,,Мен оны бүктеуді ойлап отырмын, бірақ сіз қалай ойлайсыз?
Dialogue: 0,0:18:29.19,0:18:31.19,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:18:33.56,0:18:35.58,Default,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:18:35.58,0:18:39.62,Default,,0000,0000,0000,,Ка, Кай патша, бұл тым үлкен емес пе?
Dialogue: 0,0:18:39.62,0:18:42.65,Default,,0000,0000,0000,,Сон Гоку көрінісі.
Dialogue: 0,0:18:42.65,0:18:44.67,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:18:44.67,0:18:47.70,Default,,0000,0000,0000,,Ауыр екен. Ууууу….
Dialogue: 0,0:18:47.70,0:18:49.72,Default,,0000,0000,0000,,Ойнайық. Әйтеуір біз пианисттер ғой.
Dialogue: 0,0:18:49.72,0:18:53.76,Default,,0000,0000,0000,,Сол балғамен Грегориді құлату →
Dialogue: 0,0:18:53.76,0:18:56.76,Default,,0000,0000,0000,,Келесі тренинг. Осымен?
Dialogue: 0,0:18:58.81,0:19:02.85,Default,,0000,0000,0000,,Егер сіз мұны тамаша орындай алсаңыз, мен сізді келесі жолы жеке жаттықтырамын.
Dialogue: 0,0:19:02.85,0:19:04.87,Default,,0000,0000,0000,,Жарайды, мен жасап көремін.
Dialogue: 0,0:19:04.87,0:19:08.87,Default,,0000,0000,0000,,Хмф! Мені сен сияқты ебедейсіз адам басып алуы мүмкін бе?
Dialogue: 0,0:19:26.09,0:19:28.09,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:30.30,0:19:33.49,Default,,0000,0000,0000,,Асығыңыз! Ах.
Dialogue: 0,0:19:33.49,0:19:35.51,Default,,0000,0000,0000,,Гү!
Dialogue: 0,0:19:35.51,0:19:37.51,Default,,0000,0000,0000,,Қарғыс атсын.
Dialogue: 0,0:19:47.63,0:19:50.66,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:50.66,0:19:53.69,Default,,0000,0000,0000,,Біраз уақыт алатын сияқты. Ууууууу.
Dialogue: 0,0:19:53.69,0:19:57.73,Default,,0000,0000,0000,,Ауырды. Жарайды, келесі жолы.
Dialogue: 0,0:19:57.73,0:20:00.76,Default,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:20:00.76,0:20:03.79,Default,,0000,0000,0000,,Be~.
Dialogue: 0,0:20:03.79,0:20:05.81,Default,,0000,0000,0000,,Аняру.
Dialogue: 0,0:20:05.81,0:20:07.83,Default,,0000,0000,0000,,Тоқта, күт!
Dialogue: 0,0:20:07.83,0:20:11.87,Default,,0000,0000,0000,,Дея deya deya deya deya!
Dialogue: 0,0:20:11.87,0:20:14.90,Default,,0000,0000,0000,,Күте тұрыңыз!
Dialogue: 0,0:20:14.90,0:20:16.92,Default,,0000,0000,0000,,Терең! Өте сау-саламат көрінесің! Бір жақсы жаңалық болды ма?
Dialogue: 0,0:20:16.92,0:20:19.95,Default,,0000,0000,0000,,Боу! Мүмкін емес!
Dialogue: 0,0:20:19.95,0:20:21.95,Default,,0000,0000,0000,,Хорё~!
Dialogue: 0,0:20:26.02,0:20:29.05,Default,,0000,0000,0000,,Сіздің жақсы болғаныңызға қуаныштымын.
Dialogue: 0,0:20:29.05,0:20:33.05,Default,,0000,0000,0000,,Ах~ Ууууууу. Уухохо.
Dialogue: 0,0:20:36.45,0:20:38.45,Default,,0000,0000,0000,,Дея дея!
Dialogue: 0,0:20:41.50,0:20:43.50,Default,,0000,0000,0000,,Уууу.
Dialogue: 0,0:20:45.54,0:20:47.54,Default,,0000,0000,0000,,Ухо.
Dialogue: 0,0:20:50.59,0:20:53.62,Default,,0000,0000,0000,,Дея дея!
Dialogue: 0,0:20:53.62,0:20:55.64,Default,,0000,0000,0000,,Ухо. →
Dialogue: 0,0:20:55.64,0:20:58.67,Default,,0000,0000,0000,,Уухоу уау.
Dialogue: 0,0:20:58.67,0:21:02.71,Default,,0000,0000,0000,,《Мен міндетті түрде Сайяндардан күшті боламын》
Dialogue: 0,0:21:02.71,0:21:04.73,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:21:04.73,0:21:06.75,Default,,0000,0000,0000,,《Қарғыс атсын》
Dialogue: 0,0:21:06.75,0:21:09.78,Default,,0000,0000,0000,,Менен әлдеқашан асып түстің. →
Dialogue: 0,0:21:09.78,0:21:12.81,Default,,0000,0000,0000,,Попо мырза екеуміз сізге нені үйретеміз →
Dialogue: 0,0:21:12.81,0:21:14.83,Default,,0000,0000,0000,,Басқа ештеңе жоқ. →
Dialogue: 0,0:21:14.83,0:21:18.87,Default,,0000,0000,0000,,Осыдан кейін, қарсыласу уақыты келгенше, жерге түсу→
Dialogue: 0,0:21:18.87,0:21:22.91,Default,,0000,0000,0000,,Әрқайсысы өз өнерін шыңдасын. Мен болашақты сұрадым.
Dialogue: 0,0:21:22.91,0:21:24.93,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:21:24.93,0:21:27.96,Default,,0000,0000,0000,,Ах~ Мен бұл ауыр көйлекті шешсем де, жарайды, ия?
Dialogue: 0,0:21:27.96,0:21:29.98,Default,,0000,0000,0000,,Қаласаңыз.
Dialogue: 0,0:21:29.98,0:21:31.34,Default,,0000,0000,0000,,Барлығы жерге түсіп, жұмысты аяқтайды.
Dialogue: 0,0:21:31.34,0:21:34.37,Default,,0000,0000,0000,,Оның қуатын одан да арттыратыны сөзсіз.
Dialogue: 0,0:21:34.37,0:21:36.39,Default,,0000,0000,0000,,Барлығы ғажайыпқа айналды.
Dialogue: 0,0:21:36.39,0:21:41.44,Default,,0000,0000,0000,,《Гоку, мен сені тезірек көргім келеді.》
Dialogue: 0,0:21:41.44,0:21:46.49,Default,,0000,0000,0000,,<Балғамен екі апта>
Dialogue: 0,0:21:46.49,0:21:52.55,Default,,0000,0000,0000,,(автомобиль жөндеу дыбысы)
Dialogue: 0,0:21:52.55,0:21:55.55,Default,,0000,0000,0000,,Жарайды. Ха.
Dialogue: 0,0:21:57.60,0:21:59.62,Default,,0000,0000,0000,,Уа.
Dialogue: 0,0:21:59.62,0:22:01.64,Default,,0000,0000,0000,,Ой!
Dialogue: 0,0:22:01.64,0:22:03.66,Default,,0000,0000,0000,,《Жақында》
Dialogue: 0,0:22:03.66,0:22:05.68,Default,,0000,0000,0000,,Қарғыс атқыр, ол табанды.
Dialogue: 0,0:22:05.68,0:22:09.72,Default,,0000,0000,0000,,Жарайды. Урья~!
Dialogue: 0,0:22:09.72,0:22:21.84,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:22:21.84,0:22:24.87,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:22:24.87,0:22:27.90,Default,,0000,0000,0000,,Жоқ!
Dialogue: 0,0:22:27.90,0:22:30.09,Default,,0000,0000,0000,,Дайындық Григорий. Уф!
Dialogue: 0,0:22:30.09,0:22:33.29,Default,,0000,0000,0000,,Иә! Иә?
Dialogue: 0,0:22:33.29,0:22:35.31,Default,,0000,0000,0000,,Уууу уууу уууу.
Dialogue: 0,0:22:35.31,0:22:38.34,Default,,0000,0000,0000,,Мені қатты ұрсаң, ауырады.
Dialogue: 0,0:22:38.34,0:22:42.38,Default,,0000,0000,0000,,Бұл тәтті. Менің денем тастан да қатты.
Dialogue: 0,0:22:42.38,0:22:45.41,Default,,0000,0000,0000,,Сайяндарды ондай нәрсемен жеңе алмайсың.
Dialogue: 0,0:22:45.41,0:22:49.45,Default,,0000,0000,0000,,Шынымен бе? Бірақ менде соққы бар.
Dialogue: 0,0:22:49.45,0:22:53.49,Default,,0000,0000,0000,,Иә? Ол ауырды. Хахахаха.
Dialogue: 0,0:22:53.49,0:22:56.52,Default,,0000,0000,0000,,《118 күн қалды. →
Dialogue: 0,0:22:56.52,0:23:01.57,Default,,0000,0000,0000,,Ол Кайо-кенді меңгеруі мүмкін.
Dialogue: 0,0:23:01.57,0:23:03.59,Default,,0000,0000,0000,,Хахахаха.
Dialogue: 0,0:23:03.59,0:23:06.62,Default,,0000,0000,0000,,《Мен бұл туралы армандасам да→
Dialogue: 0,0:23:06.62,0:23:09.65,Default,,0000,0000,0000,,Мен Кайо-кенді игере алмадым. →
Dialogue: 0,0:23:09.65,0:23:12.68,Default,,0000,0000,0000,,Және бұл ерекше қозғалыс》
Dialogue: 0,0:23:12.68,0:23:14.70,Default,,0000,0000,0000,,Кай патша, уәде еткендей...
Dialogue: 0,0:23:14.70,0:23:18.74,Default,,0000,0000,0000,,Сіз бұған дайын екеніңізге сенімдімін, бірақ менің жаттығуларым сіз ойлағаннан да қиын болады.
Dialogue: 0,0:23:18.74,0:23:21.77,Default,,0000,0000,0000,,Сен шыдай аласың ба? Иә, мен тырысамын.
Dialogue: 0,0:23:21.77,0:23:25.81,Default,,0000,0000,0000,,Егер сіз әлемдегі ең жақсы болуды мақсат етсеңіз, әлемдегі ең жақсы болыңыз.
Dialogue: 0,0:23:25.81,0:23:29.85,Default,,0000,0000,0000,,Дене де, ой да. Жақсы.
Dialogue: 0,0:23:29.85,0:23:31.85,Default,,0000,0000,0000,,​​Түсіндім.
Dialogue: 0,0:23:35.24,0:23:39.28,Default,,0000,0000,0000,,Мен апамның жердің болашағын болжағанын қалаймын.
Dialogue: 0,0:23:39.28,0:23:42.31,Default,,0000,0000,0000,,Жердің болашағы туралы не деуге болады?
Dialogue: 0,0:23:42.31,0:23:45.34,Default,,0000,0000,0000,,Сіз келесі жылы не болатынын білгіңіз келеді.
Dialogue: 0,0:23:45.34,0:23:48.37,Default,,0000,0000,0000,,Жарайды, сәуегейлік айтып көрейік. →
Dialogue: 0,0:23:48.37,0:23:52.41,Default,,0000,0000,0000,,Чочой но Чой Нададия~. →
Dialogue: 0,0:23:52.41,0:23:56.45,Default,,0000,0000,0000,,О! Хмм! Ах~! →
Dialogue: 0,0:23:56.45,0:23:59.48,Default,,0000,0000,0000,,Га~.
Dialogue: 0,0:23:59.48,0:24:03.52,Default,,0000,0000,0000,,Жақсы емес. Бұл болашақты болжай алмайтын жалғыз жолым.
Dialogue: 0,0:24:03.52,0:24:05.54,Default,,0000,0000,0000,,А, мінекей.
Dialogue: 0,0:24:05.54,0:24:10.59,Default,,0000,0000,0000,,Жарайды, дұрыс. Мен өз ойымды басқара бастадым.
Dialogue: 0,0:24:10.59,0:24:12.61,Default,,0000,0000,0000,,Өте тәтті! Апыр-ай.
Dialogue: 0,0:24:12.61,0:24:18.67,Default,,0000,0000,0000,,<Кайокен қандай техника? →
Dialogue: 0,0:24:18.67,0:24:21.67,Default,,0000,0000,0000,,Ал бұл ерекше қозғалыс дегеніміз не? ＞
Dialogue: 0,0:24:23.72,0:24:29.78,Default,,0000,0000,0000,,<Шешуші шайқас сәті бұлтартпай жақындап қалды>
Dialogue: 0,0:24:29.78,0:24:43.78,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:46.29,0:24:51.34,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:51.34,0:25:11.54,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:11.54,0:25:31.74,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:31.74,0:25:44.74,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:48.91,0:25:52.95,Default,,0000,0000,0000,,Сәлем, Гоку. Аа!? Мен бірінші күні қателік жібердім бе?
Dialogue: 0,0:25:52.95,0:25:57.00,Default,,0000,0000,0000,,Олай болса, Сайяндар келгенше үлгере алмаймыз, Кай-сама.
Dialogue: 0,0:25:57.00,0:26:02.05,Default,,0000,0000,0000,,Иә? Бұл қандай сезім? Олар ақыры келді ме?
Dialogue: 0,0:26:02.05,0:26:05.05,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»
Dialogue: 0,0:26:08.11,0:26:12.11,Default,,0000,0000,0000,,Біз тағы да кездесе аламыз, әке.
Dialogue: 0,0:26:13.61,0:26:19.61,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory