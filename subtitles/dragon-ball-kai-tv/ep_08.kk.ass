Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.56,0:00:12.56,Default,,0000,0000,0000,,<Гохан Пикколоның қатал жаттығуларына қатты шыдайды>
Dialogue: 0,0:00:15.65,0:00:19.69,Default,,0000,0000,0000,,<Теншинхан және басқалары аспан әлемінде оқуларын аяқтады→
Dialogue: 0,0:00:19.69,0:00:24.74,Default,,0000,0000,0000,,Шешуші шайқасқа дайындық кезінде олардың әрқайсысы төменгі әлемге түсті. →
Dialogue: 0,0:00:24.74,0:00:27.77,Default,,0000,0000,0000,,Және Гоку →
Dialogue: 0,0:00:27.77,0:00:33.77,Default,,0000,0000,0000,,Ол Кай патша тікелей тапсырған Кайо-кенді таңғаларлық жылдамдықпен меңгерді>
Dialogue: 0,0:00:35.85,0:00:39.89,Default,,0000,0000,0000,,<Сайяндардың келуіне екі күн қалды. →
Dialogue: 0,0:00:39.89,0:00:42.89,Default,,0000,0000,0000,,Тренингтің нәтижесі қандай?＞
Dialogue: 0,0:00:45.95,0:00:50.00,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:50.00,0:01:10.53,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:10.53,0:01:30.73,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:30.73,0:01:50.93,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:50.93,0:02:07.93,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:29.52,0:04:41.64,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:41.64,0:04:45.68,Default,,0000,0000,0000,,Бүгін менің сіздермен өткізген жаттығуымның соңғы күні. →
Dialogue: 0,0:04:45.68,0:04:48.71,Default,,0000,0000,0000,,Сөздерді үйрену жеткіліксіз болды, бірақ→
Dialogue: 0,0:04:48.71,0:04:53.76,Default,,0000,0000,0000,,Мен сізге көп нәрсені айттым деп ойладым.
Dialogue: 0,0:04:53.76,0:04:57.80,Default,,0000,0000,0000,,Осы уақытқа дейін алған білімімізді қайталайық. Байқап көріңіз.
Dialogue: 0,0:04:57.80,0:04:59.82,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:04:59.82,0:05:01.84,Default,,0000,0000,0000,,Ең алдымен, Көпіршіктер. Апыр-ай. →
Dialogue: 0,0:05:01.84,0:05:07.84,Default,,0000,0000,0000,,Уууу уууу уууу уууу ууууу уууу уууу.
Dialogue: 0,0:05:12.95,0:05:14.95,Default,,0000,0000,0000,,Бастаймын!
Dialogue: 0,0:05:16.99,0:05:20.36,Default,,0000,0000,0000,,Oh 0.8 seconds! Жаңа рекорд!
Dialogue: 0,0:05:20.36,0:05:22.38,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:05:22.38,0:05:24.40,Default,,0000,0000,0000,,Уухоу Уууу.
Dialogue: 0,0:05:24.40,0:05:26.42,Default,,0000,0000,0000,,Келесі! Григорий.
Dialogue: 0,0:05:26.42,0:05:29.45,Default,,0000,0000,0000,,Иә! Хехе.
Dialogue: 0,0:05:29.45,0:05:32.45,Default,,0000,0000,0000,,Уухоу Уухоу. Иә.
Dialogue: 0,0:05:34.50,0:05:37.50,Default,,0000,0000,0000,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:05:39.55,0:05:41.57,Default,,0000,0000,0000,,Бастаймын!
Dialogue: 0,0:05:41.57,0:05:45.61,Default,,0000,0000,0000,,Ал, кеттік!
Dialogue: 0,0:05:45.61,0:05:49.65,Default,,0000,0000,0000,,Ха~!
Dialogue: 0,0:05:49.65,0:05:51.67,Default,,0000,0000,0000,,Иә? О, ауырады!
Dialogue: 0,0:05:51.67,0:05:55.71,Default,,0000,0000,0000,,1 секунд 2…. Хе~ сене алар емеспін.
Dialogue: 0,0:05:55.71,0:05:57.73,Default,,0000,0000,0000,,Ал енді не болады?
Dialogue: 0,0:05:57.73,0:06:01.77,Default,,0000,0000,0000,,Okay, finally, check your Genkidama.
Dialogue: 0,0:06:01.77,0:06:07.77,Default,,0000,0000,0000,,Мен көптен күттім. Хаа~.
Dialogue: 0,0:06:11.87,0:06:31.41,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:06:31.41,0:06:41.51,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:06:41.51,0:06:44.54,Default,,0000,0000,0000,,Каа~!
Dialogue: 0,0:06:44.54,0:06:56.66,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:06:56.66,0:06:59.66,Default,,0000,0000,0000,,Жарайды, жарайды, Кай патша.
Dialogue: 0,0:07:01.71,0:07:05.71,Default,,0000,0000,0000,,Мм. Барайық.
Dialogue: 0,0:07:08.78,0:07:12.82,Default,,0000,0000,0000,,Осы үлкен кірпіштің керемет жылдамдығын түсіріп көріңіз!
Dialogue: 0,0:07:12.82,0:07:14.84,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:07:14.84,0:07:17.84,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:07:33.36,0:07:37.36,Default,,0000,0000,0000,,Иә, керемет жылдамдық!
Dialogue: 0,0:07:47.50,0:07:49.52,Default,,0000,0000,0000,,Тория!
Dialogue: 0,0:07:49.52,0:07:54.57,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:07:54.57,0:07:57.60,Default,,0000,0000,0000,,Ах~.
Dialogue: 0,0:07:57.60,0:08:04.67,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:08:04.67,0:08:07.70,Default,,0000,0000,0000,,Хе хе хе хе хе хе.
Dialogue: 0,0:08:07.70,0:08:11.74,Default,,0000,0000,0000,,О! Оңай, жақсы... →
Dialogue: 0,0:08:11.74,0:08:13.76,Default,,0000,0000,0000,,Керемет Сон Гоку. →
Dialogue: 0,0:08:13.76,0:08:16.79,Default,,0000,0000,0000,,Генки Даманы өте жақсы пайдалана білу→
Dialogue: 0,0:08:16.79,0:08:20.16,Default,,0000,0000,0000,,Шынымды айтсам, олай ойламадым. Бұл көп күш жұмсады.
Dialogue: 0,0:08:20.16,0:08:24.20,Default,,0000,0000,0000,,Иә. Қайта-қайта айта беретін сияқтымын →
Dialogue: 0,0:08:24.20,0:08:28.24,Default,,0000,0000,0000,,Genkidama дегеніміз не? Шөптер мен ағаштар, адамдар мен жануарлар→
Dialogue: 0,0:08:28.24,0:08:34.30,Default,,0000,0000,0000,,Соңында заттардан атмосфераға дейінгі барлық энергия түрлері→
Dialogue: 0,0:08:34.30,0:08:40.36,Default,,0000,0000,0000,,Бұл бірте-бірте бөліп, сосын жинап, босататын әдіс.
Dialogue: 0,0:08:40.36,0:08:44.40,Default,,0000,0000,0000,,Иә. Бұл шынымен таңғажайып техника.
Dialogue: 0,0:08:44.40,0:08:49.45,Default,,0000,0000,0000,,Тіпті кішкентай жұлдызды энергия шарының да жойғыш күші бар. →
Dialogue: 0,0:08:49.45,0:08:51.47,Default,,0000,0000,0000,,Сіз күресіп жатқан жер →
Dialogue: 0,0:08:51.47,0:08:56.52,Default,,0000,0000,0000,,Оның үлкендігі сонша, оны мұндағымен салыстыруға келмейді. →
Dialogue: 0,0:08:56.52,0:09:02.58,Default,,0000,0000,0000,,Ал сіз тіпті орасан зор энергияға ие күнді өз одақтасыңызға айналдыра аласыз→
Dialogue: 0,0:09:02.58,0:09:05.61,Default,,0000,0000,0000,,Бұл керемет күші бар рухани доп. →
Dialogue: 0,0:09:05.61,0:09:08.64,Default,,0000,0000,0000,,Егер сіз бірдеңені дұрыс істемейтін болсаңыз, тіпті өз планетаңызды жоғалтуыңыз мүмкін →
Dialogue: 0,0:09:08.64,0:09:11.67,Default,,0000,0000,0000,,Ол жойылуы мүмкін. →
Dialogue: 0,0:09:11.67,0:09:13.69,Default,,0000,0000,0000,,Мүмкін болса, оны қолданбаңыз. →
Dialogue: 0,0:09:13.69,0:09:16.72,Default,,0000,0000,0000,,Ештеңе істеу мүмкін болмаған кезде ғана →
Dialogue: 0,0:09:16.72,0:09:19.92,Default,,0000,0000,0000,,Бір ғана атуға рұқсат етілген. Жақсы ма?
Dialogue: 0,0:09:19.92,0:09:23.12,Default,,0000,0000,0000,,Иә, түсіндім. Мен тек Кайо-кенмен бірдеңе істей алатыныма сенімдімін.
Dialogue: 0,0:09:23.12,0:09:27.16,Default,,0000,0000,0000,,Енді, міне, шешуші шайқас күні де жақындап қалды.
Dialogue: 0,0:09:27.16,0:09:30.19,Default,,0000,0000,0000,,Сайандар ертең жерге түседі.
Dialogue: 0,0:09:30.19,0:09:33.22,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:09:33.22,0:09:36.25,Default,,0000,0000,0000,,О!? Ол кетті!
Dialogue: 0,0:09:36.25,0:09:39.28,Default,,0000,0000,0000,,Не? не болды?
Dialogue: 0,0:09:39.28,0:09:43.32,Default,,0000,0000,0000,,Жоқ, білесіз бе, үйге жылан жолы арқылы қайту үшін қажет уақыт→
Dialogue: 0,0:09:43.32,0:09:45.34,Default,,0000,0000,0000,,Есепке кірмейді.
Dialogue: 0,0:09:45.34,0:09:48.37,Default,,0000,0000,0000,,Егер сіз Кай патша болсаңыз, бұл Ора туралы→
Dialogue: 0,0:09:48.37,0:09:51.40,Default,,0000,0000,0000,,Төменгі әлемге ұшуға болады емес пе?
Dialogue: 0,0:09:51.40,0:09:53.42,Default,,0000,0000,0000,,Жоқ, жоқ, бұл...
Dialogue: 0,0:09:53.42,0:09:56.45,Default,,0000,0000,0000,,Сіз шынымен де үйге қайтатын жолды қайталайсыз ба?
Dialogue: 0,0:09:56.45,0:09:59.48,Default,,0000,0000,0000,,Оған жарты жыл уақыт кетті.
Dialogue: 0,0:09:59.48,0:10:02.51,Default,,0000,0000,0000,,Егер сіз қазіргі адам болсаңыз, екі күннен кейін келе аласыз. →
Dialogue: 0,0:10:02.51,0:10:06.55,Default,,0000,0000,0000,,Мен Жер құдайына айтамын, сені қарсы ал!
Dialogue: 0,0:10:06.55,0:10:10.59,Default,,0000,0000,0000,,Иә, бұл бір күн бітті. Барлығы өлтіріледі.
Dialogue: 0,0:10:10.59,0:10:14.63,Default,,0000,0000,0000,,Шырылдап айтпа. Тіпті мен кейде қателесемін!
Dialogue: 0,0:10:14.63,0:10:16.65,Default,,0000,0000,0000,,Иә? иә?
Dialogue: 0,0:10:16.65,0:10:19.35,Default,,0000,0000,0000,,Тездетіп, Жерде бізге қосылыңыз →
Dialogue: 0,0:10:19.35,0:10:23.06,Default,,0000,0000,0000,,Оған Айдаһар шарларын немесе оны өмірге қайтару үшін бірдеңені пайдалануын айт.
Dialogue: 0,0:10:23.06,0:10:26.09,Default,,0000,0000,0000,,Маған қалай айттыңыз?
Dialogue: 0,0:10:26.09,0:10:33.16,Default,,0000,0000,0000,,Қолыңды арқама қойып, жүрегіңнен айт. Ол осылай жұмыс істейді.
Dialogue: 0,0:10:33.16,0:10:36.19,Default,,0000,0000,0000,,Шынымен бе? бұл сияқты?
Dialogue: 0,0:10:36.19,0:10:40.23,Default,,0000,0000,0000,,Иә, иә, бұл. Тез айт!
Dialogue: 0,0:10:40.23,0:10:46.29,Default,,0000,0000,0000,,《Ата, ата, бұл Гоку. Менің дауысымды ести аласыз ба? →
Dialogue: 0,0:10:46.29,0:10:48.29,Default,,0000,0000,0000,,Сәлем, ата! 》
Dialogue: 0,0:10:52.35,0:10:56.39,Default,,0000,0000,0000,,Хмф, хмф, сөзбен айтып жеткізу мүмкін емес бұл қыз...
Dialogue: 0,0:10:56.39,0:10:59.42,Default,,0000,0000,0000,,《Иә?》
Dialogue: 0,0:10:59.42,0:11:04.47,Default,,0000,0000,0000,,Гоку!? Гоку!? Қайда? Қайда!?
Dialogue: 0,0:11:04.47,0:11:06.49,Default,,0000,0000,0000,,《Мен естідім! →
Dialogue: 0,0:11:06.49,0:11:10.53,Default,,0000,0000,0000,,Мастер Рошидің атасы Ора әлі о дүниеде. →
Dialogue: 0,0:11:10.53,0:11:15.58,Default,,0000,0000,0000,,Кайто алыстан ойда сөйлейді.
Dialogue: 0,0:11:15.58,0:11:17.60,Default,,0000,0000,0000,,Әй, бұл дүние...
Dialogue: 0,0:11:17.60,0:11:20.96,Default,,0000,0000,0000,,《Сіз барлық айдаһар шарларын жинадыңыз ба? 》
Dialogue: 0,0:11:20.96,0:11:23.99,Default,,0000,0000,0000,,Ааа! Мен оларды баяғыда жинадым.
Dialogue: 0,0:11:23.99,0:11:28.04,Default,,0000,0000,0000,,Барлығы сізді құтқаруға тырысты.
Dialogue: 0,0:11:28.04,0:11:33.09,Default,,0000,0000,0000,,《Рахмет. Кешіріңіз, бірақ дәл қазір Шенронға қоңырау шалыңыз →
Dialogue: 0,0:11:33.09,0:11:36.12,Default,,0000,0000,0000,,Сіз Оланы өмірге қайтара аласыз ба? →
Dialogue: 0,0:11:36.12,0:11:39.15,Default,,0000,0000,0000,,Сайяндар ертең Жерге келеді.
Dialogue: 0,0:11:39.15,0:11:44.20,Default,,0000,0000,0000,,Не?! Ертең не?→
Dialogue: 0,0:11:44.20,0:11:47.23,Default,,0000,0000,0000,,Біз күткеннен бір ай бұрын.
Dialogue: 0,0:11:47.23,0:11:51.27,Default,,0000,0000,0000,,《Тез жүріңіз, ата. Мен сәл кешігіп қалдым →
Dialogue: 0,0:11:51.27,0:11:54.30,Default,,0000,0000,0000,,Мен міндетті түрде бірдеңе істеймін! 》
Dialogue: 0,0:11:54.30,0:11:56.32,Default,,0000,0000,0000,,Ууу... Бұл Гоку.
Dialogue: 0,0:11:56.32,0:11:58.34,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:11:58.34,0:12:03.39,Default,,0000,0000,0000,,Мм... ауырады. Аа, кешіріңіз.
Dialogue: 0,0:12:03.39,0:12:08.44,Default,,0000,0000,0000,,Жарайды, жақсы, түсіндім. Сонымен, Гоку, сен қалай ойлайсың?
Dialogue: 0,0:12:08.44,0:12:11.47,Default,,0000,0000,0000,,（） →
Dialogue: 0,0:12:11.47,0:12:13.49,Default,,0000,0000,0000,,Сіз қаншалықты табыстысыз?
Dialogue: 0,0:12:13.49,0:12:15.51,Default,,0000,0000,0000,,《Иә, тамаша》
Dialogue: 0,0:12:15.51,0:12:20.89,Default,,0000,0000,0000,,- (Каме Эрмит) Түсінемін. Сонда сіз сенімді бола аласыз.
Dialogue: 0,0:12:20.89,0:12:24.93,Default,,0000,0000,0000,,Иә? (Оолонг) Эй, эй, жақсысың ба?
Dialogue: 0,0:12:24.93,0:12:28.97,Default,,0000,0000,0000,,Мастер Рошидің қарт адамы ваннада бірдеңе деп күбірлеп жатыр.
Dialogue: 0,0:12:28.97,0:12:30.99,Default,,0000,0000,0000,,Бұлыңғыр ма деп ойлаймын.
Dialogue: 0,0:12:30.99,0:12:32.01,Default,,0000,0000,0000,,(дәретхананың ағу дыбысы)
Dialogue: 0,0:12:32.01,0:12:36.05,Default,,0000,0000,0000,,Эй, Айдаһар шарларын дереу дайында!
Dialogue: 0,0:12:36.05,0:12:38.05,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:45.14,0:12:48.17,Default,,0000,0000,0000,,Бұл керемет, Кай патша, мен дұрыс түсіндім.
Dialogue: 0,0:12:48.17,0:12:52.21,Default,,0000,0000,0000,,Hmph, әрине. Мен ақыры өмірге қайта келе аламын.
Dialogue: 0,0:12:52.21,0:12:56.25,Default,,0000,0000,0000,,Жарайды, мен сенің өмірге оралуыңды күтемін→
Dialogue: 0,0:12:56.25,0:13:00.29,Default,,0000,0000,0000,,Сол ауыр, жыртылған киімдер туралы бірдеңе жасайық.
Dialogue: 0,0:13:00.29,0:13:02.31,Default,,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:13:02.31,0:13:04.31,Default,,0000,0000,0000,,Қараңыз.
Dialogue: 0,0:13:07.36,0:13:12.41,Default,,0000,0000,0000,,Иә? Уау, уау, бұл әлдеқайда жеңілірек!
Dialogue: 0,0:13:12.41,0:13:17.46,Default,,0000,0000,0000,,Бұл жай ғана жарық емес. Ол жақсы, берік матадан жасалған.
Dialogue: 0,0:13:17.46,0:13:20.83,Default,,0000,0000,0000,,Ұсақ шабуылдарға тойтарыс беру.
Dialogue: 0,0:13:20.83,0:13:22.85,Default,,0000,0000,0000,,Рахмет, Кай патша.
Dialogue: 0,0:13:22.85,0:13:26.89,Default,,0000,0000,0000,,Уау, бұл жақсы. Тасбақа белгісі әлі де бар.
Dialogue: 0,0:13:26.89,0:13:30.93,Default,,0000,0000,0000,,Ой, мен Кай патша сияқты киім кигенім керемет болар еді деп ойламаймын→
Dialogue: 0,0:13:30.93,0:13:34.97,Default,,0000,0000,0000,,Мен уайымдадым. Бұл жаман болды.
Dialogue: 0,0:13:34.97,0:13:39.02,Default,,0000,0000,0000,,Әй, ол жақын арада өмірге орала ма деп ойлаймын.
Dialogue: 0,0:13:39.02,0:13:45.08,Default,,0000,0000,0000,,Артқы жағындағы белгі ең сәнді нүкте. Не?
Dialogue: 0,0:13:45.08,0:13:48.08,Default,,0000,0000,0000,,Иә? аа!
Dialogue: 0,0:15:00.49,0:15:02.49,Default,,0000,0000,0000,,Ха~!
Dialogue: 0,0:15:06.55,0:15:10.55,Default,,0000,0000,0000,,Не болды? Жалтару арқылы жауды жеңе алмайсың!
Dialogue: 0,0:15:18.67,0:15:20.69,Default,,0000,0000,0000,,《Жарайды》 Иә?
Dialogue: 0,0:15:20.69,0:15:22.71,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:15:22.71,0:15:25.74,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:15:25.74,0:15:27.74,Default,,0000,0000,0000,,Угья!
Dialogue: 0,0:15:29.78,0:15:31.80,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:31.80,0:15:36.85,Default,,0000,0000,0000,,Кенеттен. Кішкене күшті болды ма?
Dialogue: 0,0:15:36.85,0:15:39.88,Default,,0000,0000,0000,,А... иә?
Dialogue: 0,0:15:39.88,0:15:41.90,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:15:41.90,0:15:46.95,Default,,0000,0000,0000,,Хмм... Бұл қулық. Көзіңді пайдаланба дедім.
Dialogue: 0,0:15:46.95,0:15:51.00,Default,,0000,0000,0000,,Көңілсіз болмаңыз. Мұндай уәде шайқаста орындала ма?
Dialogue: 0,0:15:51.00,0:15:56.00,Default,,0000,0000,0000,,Бірақ, Пикколо-сан, мен сенің жауың емеспін.
Dialogue: 0,0:16:00.42,0:16:04.46,Default,,0000,0000,0000,,Кел, Шенрон!
Dialogue: 0,0:16:04.46,0:16:15.46,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:16:27.69,0:16:29.69,Default,,0000,0000,0000,,Ах….
Dialogue: 0,0:16:31.73,0:16:33.75,Default,,0000,0000,0000,,(Найзағай)
Dialogue: 0,0:16:33.75,0:16:37.75,Default,,0000,0000,0000,,Күндіз болса да, кенет қараңғы болды.
Dialogue: 0,0:16:41.83,0:16:44.83,Default,,0000,0000,0000,,(Найзағай)
Dialogue: 0,0:16:50.92,0:16:53.95,Default,,0000,0000,0000,,Кешіріңіз. Иә? Маған тимеңіз!
Dialogue: 0,0:16:53.95,0:16:57.33,Default,,0000,0000,0000,,Қанша көрсем де, қорқытады.
Dialogue: 0,0:16:57.33,0:17:08.44,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:17:08.44,0:17:13.49,Default,,0000,0000,0000,,Муо~. →
Dialogue: 0,0:17:13.49,0:17:20.56,Default,,0000,0000,0000,,Өз тілегіңді айт. Сіздің тілегіңіз қандай болса да, мен оны орындаймын.
Dialogue: 0,0:17:20.56,0:17:22.58,Default,,0000,0000,0000,,Ууууу….
Dialogue: 0,0:17:22.58,0:17:25.61,Default,,0000,0000,0000,,Ей, эй, у... Сайяндарды жеңу→
Dialogue: 0,0:17:25.61,0:17:30.66,Default,,0000,0000,0000,,Менің ойымша, жердің құтқарылуын тілеу жақсы емес.
Dialogue: 0,0:17:30.66,0:17:35.71,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Немереңізді өлі қалдыруды жоспарлап отырсыз ба?
Dialogue: 0,0:17:35.71,0:17:39.75,Default,,0000,0000,0000,,Жоқ, егер Гоку келесі жолы тірілсе →
Dialogue: 0,0:17:39.75,0:17:42.78,Default,,0000,0000,0000,,Бұл оңай.
Dialogue: 0,0:17:42.78,0:17:48.84,Default,,0000,0000,0000,,Бұл мүмкін емес тілек. Мені Құдай жаратқан.
Dialogue: 0,0:17:48.84,0:17:53.89,Default,,0000,0000,0000,,Демек, Алланың құдіретінен асатын тілек орындалмайды.
Dialogue: 0,0:17:53.89,0:17:57.26,Default,,0000,0000,0000,,Сон Гокуды тірілтіңіз.
Dialogue: 0,0:17:57.26,0:18:02.31,Default,,0000,0000,0000,,Бұл оңай тілек. →
Dialogue: 0,0:18:02.31,0:18:08.31,Default,,0000,0000,0000,,Муа~!
Dialogue: 0,0:18:17.46,0:18:21.50,Default,,0000,0000,0000,,(Найзағай)
Dialogue: 0,0:18:21.50,0:18:25.54,Default,,0000,0000,0000,,《Сон Гоку ақыры қайта тіріледі ме? →
Dialogue: 0,0:18:25.54,0:18:29.58,Default,,0000,0000,0000,,Ха! Бұл сайяндар → дегенді білдіреді
Dialogue: 0,0:18:29.58,0:18:32.58,Default,,0000,0000,0000,,Мен ойлағаннан да ерте келе ме!?
Dialogue: 0,0:18:34.63,0:18:37.66,Default,,0000,0000,0000,,Уа. Жарайды, бастың үстіндегі сақина жоғалып кетті.
Dialogue: 0,0:18:37.66,0:18:39.68,Default,,0000,0000,0000,,Ол өмірге қайта оралды.
Dialogue: 0,0:18:39.68,0:18:42.71,Default,,0000,0000,0000,,Иә! Ухоу уау.
Dialogue: 0,0:18:42.71,0:18:45.74,Default,,0000,0000,0000,,Тез жүр! иә!
Dialogue: 0,0:18:45.74,0:18:49.78,Default,,0000,0000,0000,,Жақсы ма? Жаулар - сіз ойлағаннан да күшті зұлым адамдар.
Dialogue: 0,0:18:49.78,0:18:52.81,Default,,0000,0000,0000,,Біз сақтықты бір сәтке де түсіре алмаймыз.
Dialogue: 0,0:18:52.81,0:18:55.17,Default,,0000,0000,0000,,Өмірге қайта ораламын деп ойлама.
Dialogue: 0,0:18:55.17,0:18:59.21,Default,,0000,0000,0000,,Жарайды. Айдаһар шарлары сізді бір рет қана өмірге қайтарады.
Dialogue: 0,0:18:59.21,0:19:02.24,Default,,0000,0000,0000,,Мен бар күшімді саламын. Көріңіз.
Dialogue: 0,0:19:02.24,0:19:04.26,Default,,0000,0000,0000,,Хмм.
Dialogue: 0,0:19:04.26,0:19:07.29,Default,,0000,0000,0000,,Барлығы үшін рахмет, Кай патша.
Dialogue: 0,0:19:07.29,0:19:10.32,Default,,0000,0000,0000,,Егер мен өлсем, мен сені қайта көремін.
Dialogue: 0,0:19:10.32,0:19:12.34,Default,,0000,0000,0000,,Көпіршіктер. Апыр-ай.
Dialogue: 0,0:19:12.34,0:19:14.36,Default,,0000,0000,0000,,Григорий. (Грегорий) Жақсысың деп үміттенемін.
Dialogue: 0,0:19:14.36,0:19:16.38,Default,,0000,0000,0000,,Мен... Мен ондай жігіттерді шын жек көремін!
Dialogue: 0,0:19:16.38,0:19:25.47,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:19:25.47,0:19:27.47,Default,,0000,0000,0000,,Иә!?
Dialogue: 0,0:19:30.52,0:19:32.54,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:32.54,0:19:34.56,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:19:34.56,0:19:36.58,Default,,0000,0000,0000,,Сау болыңыз!
Dialogue: 0,0:19:36.58,0:19:47.69,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:19:47.69,0:19:51.73,Default,,0000,0000,0000,,Не деген қайратты жігіт.
Dialogue: 0,0:19:51.73,0:19:55.11,Default,,0000,0000,0000,,Оның үстіне жүрек кристалдан да таза.
Dialogue: 0,0:19:55.11,0:19:58.14,Default,,0000,0000,0000,,Төменгі әлемде сондай біреу бар деп естідім.
Dialogue: 0,0:19:58.14,0:20:01.17,Default,,0000,0000,0000,,Сіз Кай патшадан күштірек болдыңыз.
Dialogue: 0,0:20:01.17,0:20:04.20,Default,,0000,0000,0000,,Кохон!
Dialogue: 0,0:20:04.20,0:20:07.23,Default,,0000,0000,0000,,Бірақ оның юмор сезімі керемет емес еді.
Dialogue: 0,0:20:07.23,0:20:11.27,Default,,0000,0000,0000,,Келесі келгенде мен сені сонда жаттықтырамын.
Dialogue: 0,0:20:11.27,0:20:14.30,Default,,0000,0000,0000,,Ухохохо.
Dialogue: 0,0:20:14.30,0:20:17.33,Default,,0000,0000,0000,,《Шу болма! Шулы》
Dialogue: 0,0:20:17.33,0:20:21.37,Default,,0000,0000,0000,,Ха ха ха вау~.
Dialogue: 0,0:20:21.37,0:20:24.40,Default,,0000,0000,0000,,Уау~ Жарық жарық.
Dialogue: 0,0:20:24.40,0:20:27.43,Default,,0000,0000,0000,,Оның денесі мақта сияқты жеңіл.
Dialogue: 0,0:20:27.43,0:20:30.46,Default,,0000,0000,0000,,Ия!
Dialogue: 0,0:20:30.46,0:20:33.49,Default,,0000,0000,0000,,Иә? Бұл дұрыс!
Dialogue: 0,0:20:33.49,0:20:36.49,Default,,0000,0000,0000,,《Бұл таңданатын уақыт емес. Біз асығуымыз керек! 》
Dialogue: 0,0:20:40.56,0:20:46.56,Default,,0000,0000,0000,,<және келесі күні 11:43>
Dialogue: 0,0:20:51.67,0:20:53.69,Default,,0000,0000,0000,,＜Соңында, Жер→
Dialogue: 0,0:20:53.69,0:20:59.08,Default,,0000,0000,0000,,Мен екі Сайянның басып кіруіне рұқсат бердім.＞
Dialogue: 0,0:20:59.08,0:21:19.28,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:21:19.28,0:21:23.32,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:21:23.32,0:21:26.35,Default,,0000,0000,0000,,Әке, қарным ашты.
Dialogue: 0,0:21:26.35,0:21:30.39,Default,,0000,0000,0000,,Иә? О, осыншама ұзақ па?
Dialogue: 0,0:21:30.39,0:21:32.39,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:49.58,0:21:53.58,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:21:57.99,0:21:59.01,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:21:59.01,0:22:03.01,Default,,0000,0000,0000,,(Айқай)
Dialogue: 0,0:22:10.12,0:22:13.15,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:22:13.15,0:22:16.15,Default,,0000,0000,0000,,Не болды?
Dialogue: 0,0:22:18.20,0:22:20.22,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:22:20.22,0:22:25.22,Default,,0000,0000,0000,,Бұл таңқаларлық. (Еркек) Бірдеңе құлап кеткен сияқты.
Dialogue: 0,0:22:31.33,0:22:33.35,Default,,0000,0000,0000,,Ия, мен оны білдім.
Dialogue: 0,0:22:33.35,0:22:36.35,Default,,0000,0000,0000,,Анау дөңгелек нәрсе құлап түсті.
Dialogue: 0,0:22:39.41,0:22:41.43,Default,,0000,0000,0000,,Бұл да осында.
Dialogue: 0,0:22:41.43,0:23:01.96,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:23:01.96,0:23:03.98,Default,,0000,0000,0000,,Адамдар! (Әйел) Кя~!
Dialogue: 0,0:23:03.98,0:23:06.01,Default,,0000,0000,0000,,Бір адам шықты.
Dialogue: 0,0:23:06.01,0:23:08.03,Default,,0000,0000,0000,,Дәл осы жерде.
Dialogue: 0,0:23:08.03,0:23:14.09,Default,,0000,0000,0000,,Бұл адам! (Ер) А, не?
Dialogue: 0,0:23:14.09,0:23:16.09,Default,,0000,0000,0000,,Ах~.
Dialogue: 0,0:23:18.13,0:23:20.13,Default,,0000,0000,0000,,А...
Dialogue: 0,0:23:29.24,0:23:33.28,Default,,0000,0000,0000,,Сайян келді.
Dialogue: 0,0:23:33.28,0:23:37.28,Default,,0000,0000,0000,,Сіз керемет көрінесіз, Пикколо-сан.
Dialogue: 0,0:23:43.38,0:23:45.40,Default,,0000,0000,0000,,Сәлем, Тен мырза!
Dialogue: 0,0:23:45.40,0:23:50.45,Default,,0000,0000,0000,,Tsk, бұл мен күткеннен әлдеқайда жылдам болды.
Dialogue: 0,0:23:50.45,0:23:54.66,Default,,0000,0000,0000,,Сайяндардың келетін уақыты болып қалды. Асығыңыз!
Dialogue: 0,0:23:54.66,0:23:57.86,Default,,0000,0000,0000,,Күте тұрыңыз, бәріңіз!
Dialogue: 0,0:23:57.86,0:24:00.86,Default,,0000,0000,0000,,Торя~! Урья~!
Dialogue: 0,0:24:06.95,0:24:08.95,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:24:11.00,0:24:13.02,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:24:13.02,0:24:25.14,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:25.14,0:24:27.16,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:24:27.16,0:24:29.18,Default,,0000,0000,0000,,Сен ұсқынсыз қатыгезсің!!
Dialogue: 0,0:24:29.18,0:24:35.24,Default,,0000,0000,0000,,<Мен қорқып жүрген күнім де жетті>
Dialogue: 0,0:24:35.24,0:24:43.24,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:24:46.35,0:24:51.40,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:51.40,0:25:11.60,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:11.60,0:25:31.80,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:31.80,0:25:44.80,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:48.97,0:25:52.01,Default,,0000,0000,0000,,Сәлем, Гоку. Не? Менде бір нәрсе туралы жаман сезім бар.
Dialogue: 0,0:25:52.01,0:25:55.37,Default,,0000,0000,0000,,Уау! Топырақтан бірдеңе шықты.
Dialogue: 0,0:25:55.37,0:25:57.39,Default,,0000,0000,0000,,Күте тұрыңыз, сіз өсіруші адам дейсіз бе?
Dialogue: 0,0:25:57.39,0:26:01.43,Default,,0000,0000,0000,,Олар қорқынышты адамдар. Сон Гоку әлі келген жоқ →
Dialogue: 0,0:26:01.43,0:26:05.47,Default,,0000,0000,0000,,Мұнда да 6 адам бар. Мен бөліктерді кезекпен біріктіремін!
Dialogue: 0,0:26:05.47,0:26:08.47,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»
Dialogue: 0,0:26:10.52,0:26:13.52,Default,,0000,0000,0000,,Ямча-сан, абай бол!
Dialogue: 0,0:26:15.02,0:26:21.02,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory