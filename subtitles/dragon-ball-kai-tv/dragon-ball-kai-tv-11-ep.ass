Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.43,0:00:07.45,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:00:07.45,0:00:10.48,Default,,0000,0000,0000,,<Гйоза өмірінен айырылды...>
Dialogue: 0,0:00:10.48,0:00:13.48,Default,,0000,0000,0000,,Бұл цигон зеңбірегі!
Dialogue: 0,0:00:16.54,0:00:18.56,Default,,0000,0000,0000,,Өкіну.
Dialogue: 0,0:00:18.56,0:00:21.59,Default,,0000,0000,0000,,<Теншинхан да соңынан ерді>
Dialogue: 0,0:00:21.59,0:00:23.61,Default,,0000,0000,0000,,Наппа!
Dialogue: 0,0:00:23.61,0:00:29.61,Default,,0000,0000,0000,,Шабуыл қайта басталғанша <3 сағат. Тезірек, Гоку! ＞
Dialogue: 0,0:00:31.69,0:00:36.74,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:36.74,0:00:56.94,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:00:56.94,0:01:16.48,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:16.48,0:01:36.68,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:36.68,0:01:53.68,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:18.63,0:04:36.81,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:36.81,0:04:39.84,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:04:39.84,0:04:42.87,Default,,0000,0000,0000,,Какаротты не үшін күтіп отырсың?
Dialogue: 0,0:04:42.87,0:04:46.91,Default,,0000,0000,0000,,Өйткені ол бізге сайяндар үшін сатқын. →
Dialogue: 0,0:04:46.91,0:04:50.95,Default,,0000,0000,0000,,Сатқындар жазалануы керек. →
Dialogue: 0,0:04:50.95,0:04:53.98,Default,,0000,0000,0000,,Оның көз алдында ұлым мен достарым →
Dialogue: 0,0:04:53.98,0:04:55.00,Default,,0000,0000,0000,,Мен сені өлтіремін.
Dialogue: 0,0:04:55.00,0:04:57.02,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:04:57.02,0:05:01.06,Default,,0000,0000,0000,,Осыдан кейін мен оны ақырын пісіремін. →
Dialogue: 0,0:05:01.06,0:05:05.06,Default,,0000,0000,0000,,Мен сенің дәрменсіздігіңді түсініп, мені қиналып, қинаймын.
Dialogue: 0,0:05:07.45,0:05:10.48,Default,,0000,0000,0000,,Хехехе….
Dialogue: 0,0:05:10.48,0:05:13.51,Default,,0000,0000,0000,,Ал бүгін, 3-4 сағат ішінде→
Dialogue: 0,0:05:13.51,0:05:15.53,Default,,0000,0000,0000,,Сендер, үндемеңдер!➡
Dialogue: 0,0:05:15.53,0:05:19.57,Default,,0000,0000,0000,,Тозақтан тамаша спектакль қоя алатынымызға сенімдімін.
Dialogue: 0,0:05:19.57,0:05:22.60,Default,,0000,0000,0000,,Түсіндім, сенің айтып тұрғаның осы. Бұл жақсы.
Dialogue: 0,0:05:22.60,0:05:26.64,Default,,0000,0000,0000,,Егер ол үш сағат ішінде келсе.
Dialogue: 0,0:05:26.64,0:05:30.68,Default,,0000,0000,0000,,Мен Какаротты тапсырамын, бірақ сол үшеуін шешуге рұқсат етіңіз.
Dialogue: 0,0:05:30.68,0:05:34.72,Default,,0000,0000,0000,,Өзіңізге ұнайтын нәрсені жасаңыз. Дегенмен, Намекиялықтар →
Dialogue: 0,0:05:34.72,0:05:38.72,Default,,0000,0000,0000,,Оны Айдаһар шарлары туралы құстырғаннан кейін.
Dialogue: 0,0:05:42.80,0:05:46.80,Default,,0000,0000,0000,,Какарот келеді деп үміттенемін... Хехе.
Dialogue: 0,0:05:48.86,0:05:50.88,Default,,0000,0000,0000,,'Белдік менің денеме тартылып жатыр.'
Dialogue: 0,0:05:50.88,0:05:54.92,Default,,0000,0000,0000,,Эй, егер бұл орын алса, мен қашуым керек сияқты.
Dialogue: 0,0:05:54.92,0:05:57.95,Default,,0000,0000,0000,,Жеңіске жету мүмкіндігі жоқ. Бұл қыңыр заман емес.
Dialogue: 0,0:05:57.95,0:06:00.98,Default,,0000,0000,0000,,Ақымақ! Олар кез келген жағдайда →
Dialogue: 0,0:06:00.98,0:06:02.00,Default,,0000,0000,0000,,Біз адамзатты жоюға ниеттіміз.
Dialogue: 0,0:06:02.00,0:06:05.20,Default,,0000,0000,0000,,Қазір қашсаң да солай.
Dialogue: 0,0:06:05.20,0:06:08.39,Default,,0000,0000,0000,,Ух... tsk tsk шоуы.
Dialogue: 0,0:06:08.39,0:06:11.42,Default,,0000,0000,0000,,Өтінемін, Гоку! Келіңіздер!
Dialogue: 0,0:06:11.42,0:06:15.42,Default,,0000,0000,0000,,Маған сол жігіттерден қаншалықты күшті екеніңізді көрсетіңіз!
Dialogue: 0,0:06:17.48,0:06:19.50,Default,,0000,0000,0000,,Асығыңыз, асығыңыз, асығыңыз!
Dialogue: 0,0:06:19.50,0:06:21.52,Default,,0000,0000,0000,,Хмм... әлі жоқ.
Dialogue: 0,0:06:21.52,0:06:24.52,Default,,0000,0000,0000,,Барлығыңыз, шыдамды болыңыздар!
Dialogue: 0,0:06:30.61,0:06:34.65,Default,,0000,0000,0000,,Пикколо. Гоку үш сағатта келетініне сенімдімін, солай ма?
Dialogue: 0,0:06:34.65,0:06:36.67,Default,,0000,0000,0000,,Келіңіздер. (Криллин/Гохан) Иә?
Dialogue: 0,0:06:36.67,0:06:38.69,Default,,0000,0000,0000,,Сон Гоку келгенше →
Dialogue: 0,0:06:38.69,0:06:41.72,Default,,0000,0000,0000,,Оларға қандай да бір зиян келтіру туралы ойланыңыз.
Dialogue: 0,0:06:41.72,0:06:44.75,Default,,0000,0000,0000,,Пиппи Пикколо-сан.
Dialogue: 0,0:06:44.75,0:06:47.78,Default,,0000,0000,0000,,А... тағы да үш сағат жаттығыңыз.
Dialogue: 0,0:06:47.78,0:06:49.80,Default,,0000,0000,0000,,Көңілсіз болмаңыз!
Dialogue: 0,0:06:49.80,0:06:53.84,Default,,0000,0000,0000,,Қорқақтардың пайдасы жоқ. Мен жақында қайтамын.
Dialogue: 0,0:06:53.84,0:06:55.86,Default,,0000,0000,0000,,Пиппи Пикколо-сан.
Dialogue: 0,0:06:55.86,0:06:59.90,Default,,0000,0000,0000,,Ааа….
Dialogue: 0,0:06:59.90,0:07:03.94,Default,,0000,0000,0000,,Ааааааааааааааааааа~ Пикколо!
Dialogue: 0,0:07:03.94,0:07:09.34,Default,,0000,0000,0000,,《Бәрін қойдым. Сіз де бұл деңгейде емес шығарсыз.
Dialogue: 0,0:07:09.34,0:07:14.34,Default,,0000,0000,0000,,Гохан, қайтып кел. Гохан!
Dialogue: 0,0:07:16.41,0:07:18.43,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:07:18.43,0:07:21.46,Default,,0000,0000,0000,,Бала, сен қашпақшысың ба?
Dialogue: 0,0:07:21.46,0:07:25.50,Default,,0000,0000,0000,,Бұл ақылдырақ болар еді, хахахаха!
Dialogue: 0,0:07:25.50,0:07:29.54,Default,,0000,0000,0000,,Кім қашады! Анаң, шық!
Dialogue: 0,0:07:29.54,0:07:31.56,Default,,0000,0000,0000,,Еее~!?→
Dialogue: 0,0:07:31.56,0:07:33.58,Default,,0000,0000,0000,,Әй, әлгі жігіт.
Dialogue: 0,0:07:33.58,0:07:36.61,Default,,0000,0000,0000,,Сіз қайдан білесіз? (Вегета) Хэхехехе.
Dialogue: 0,0:07:36.61,0:07:39.61,Default,,0000,0000,0000,,Анам шыққалы жатыр.
Dialogue: 0,0:07:45.70,0:07:50.75,Default,,0000,0000,0000,,Мен оқиға орнына барынша жақындауға тырысамын.
Dialogue: 0,0:07:50.75,0:07:53.78,Default,,0000,0000,0000,,Жер бетінде не болды? →
Dialogue: 0,0:07:53.78,0:07:55.80,Default,,0000,0000,0000,,Толық ақпаратты білмеймін, бірақ→
Dialogue: 0,0:07:55.80,0:07:58.80,Default,,0000,0000,0000,,Уақыт деген нәрсе жоқ деп ойлаймын...
Dialogue: 0,0:08:00.85,0:08:03.88,Default,,0000,0000,0000,,Мүмкін мен біраз ойнайтын шығармын.
Dialogue: 0,0:08:03.88,0:08:06.24,Default,,0000,0000,0000,,Мен мұндай жерде үш сағат бір орында тұра алмаймын.
Dialogue: 0,0:08:06.24,0:08:09.27,Default,,0000,0000,0000,,Өзіңізге ұнайтын нәрсені жасаңыз. Бірақ бұл Наппа→
Dialogue: 0,0:08:09.27,0:08:12.30,Default,,0000,0000,0000,,Тым жылтыр болмаңыз. Неліктен?
Dialogue: 0,0:08:12.30,0:08:15.33,Default,,0000,0000,0000,,3 сағаттан кейін Тозақтық шоу үшін.
Dialogue: 0,0:08:15.33,0:08:18.36,Default,,0000,0000,0000,,Иа, дұрыс, Вегета.
Dialogue: 0,0:08:18.36,0:08:22.36,Default,,0000,0000,0000,,Хехехехе Бұл жай ғана сәлемдесу. Уайымдама.
Dialogue: 0,0:08:25.43,0:08:28.46,Default,,0000,0000,0000,,Әй, Сайян аспанға ұшты. →
Dialogue: 0,0:08:28.46,0:08:32.50,Default,,0000,0000,0000,,Сіз қайда баруды жоспарлап отырсыз?
Dialogue: 0,0:08:32.50,0:08:34.52,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:08:34.52,0:08:37.55,Default,,0000,0000,0000,,Иә? Уау, әйтеуір бізге қарай →
Dialogue: 0,0:08:37.55,0:08:40.58,Default,,0000,0000,0000,,Жақындап бара жатқан сияқты!
Dialogue: 0,0:08:40.58,0:08:43.61,Default,,0000,0000,0000,,Уау! Хахаха!
Dialogue: 0,0:08:43.61,0:08:46.61,Default,,0000,0000,0000,,Уа, мен сені қуып келемін!
Dialogue: 0,0:08:48.66,0:08:50.68,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:50.68,0:08:53.71,Default,,0000,0000,0000,,Бұл жерде. (Еркек) Камераны бұрыңыз!
Dialogue: 0,0:08:53.71,0:08:56.74,Default,,0000,0000,0000,,Қаш!
Dialogue: 0,0:08:56.74,0:08:59.74,Default,,0000,0000,0000,,Бұл көзге ауыр тиді, құтыл!
Dialogue: 0,0:09:04.82,0:09:07.82,Default,,0000,0000,0000,,Ah Ah….
Dialogue: 0,0:09:10.21,0:09:13.24,Default,,0000,0000,0000,,Мен сенімді емеспін, бірақ Гоку әлі келді ме?
Dialogue: 0,0:09:13.24,0:09:16.27,Default,,0000,0000,0000,,Уфххххххххххххххххххххххххххх
Dialogue: 0,0:09:16.27,0:09:18.29,Default,,0000,0000,0000,,Менің аузым қанша күлкілі болса да→
Dialogue: 0,0:09:18.29,0:09:22.33,Default,,0000,0000,0000,,Бұл күлетін уақыт емес. Жердің тағдыры қыл үстінде тұр.
Dialogue: 0,0:09:22.33,0:09:24.33,Default,,0000,0000,0000,,Тезірек, Сон Гоку!
Dialogue: 0,0:09:27.38,0:09:30.41,Default,,0000,0000,0000,,А? Мен көрдім!
Dialogue: 0,0:09:30.41,0:09:32.41,Default,,0000,0000,0000,,Бар!
Dialogue: 0,0:09:34.45,0:09:37.48,Default,,0000,0000,0000,,Nu? (Попо мырза) Гокудың болуы.
Dialogue: 0,0:09:37.48,0:09:41.48,Default,,0000,0000,0000,,А, біз жақындап қалдық. Мүмкін біз оны уақытында жасаймыз.
Dialogue: 0,0:09:47.58,0:09:51.62,Default,,0000,0000,0000,,Тағы бір сағат?
Dialogue: 0,0:09:51.62,0:09:55.66,Default,,0000,0000,0000,,Какарот қорқақ сияқты әрекет етпеді.
Dialogue: 0,0:09:55.66,0:09:57.68,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:09:57.68,0:10:01.68,Default,,0000,0000,0000,,《Бұл жалғыз нұсқа сияқты.》
Dialogue: 0,0:10:05.93,0:10:08.12,Default,,0000,0000,0000,,А... міне! Сон Гоку келді!
Dialogue: 0,0:10:08.12,0:10:11.15,Default,,0000,0000,0000,,Құдай, асығыңыз!
Dialogue: 0,0:10:11.15,0:10:13.15,Default,,0000,0000,0000,,Жыланның жолы бітті!
Dialogue: 0,0:10:16.20,0:10:19.23,Default,,0000,0000,0000,,Асығыңыз! Бұл керемет жылдам болды.
Dialogue: 0,0:10:19.23,0:10:22.26,Default,,0000,0000,0000,,Иә? Күшті рух екіге бөлінеді.
Dialogue: 0,0:10:22.26,0:10:24.28,Default,,0000,0000,0000,,Сонымен, мен Кираны қоса алғанда сегіз адаммен бірге сусын іштім.
Dialogue: 0,0:10:24.28,0:10:28.32,Default,,0000,0000,0000,,＜Ал Гоку келмеді →
Dialogue: 0,0:10:28.32,0:10:31.32,Default,,0000,0000,0000,,Үш сағат өтті>
Dialogue: 0,0:10:33.37,0:10:36.40,Default,,0000,0000,0000,,Уақыт келді. Шүкір~!
Dialogue: 0,0:10:36.40,0:10:41.40,Default,,0000,0000,0000,,Хехехехе Күтудің қажеті жоқ сияқты.
Dialogue: 0,0:10:43.47,0:10:46.50,Default,,0000,0000,0000,,Иә? Әлі келген жоқ па?
Dialogue: 0,0:10:46.50,0:10:49.53,Default,,0000,0000,0000,,Қорқақ Какарот келмеді.
Dialogue: 0,0:10:49.53,0:10:52.56,Default,,0000,0000,0000,,Әкем қорқақ емес!
Dialogue: 0,0:10:52.56,0:10:55.59,Default,,0000,0000,0000,,Боқ~ Неге келмейсің?
Dialogue: 0,0:10:55.59,0:10:59.63,Default,,0000,0000,0000,,《Сон Гоку...》
Dialogue: 0,0:10:59.63,0:11:03.67,Default,,0000,0000,0000,,Енді мен сені ақырын ренжітейін.
Dialogue: 0,0:11:03.67,0:11:06.04,Default,,0000,0000,0000,,Оны Какаротқа көрсете алмағаным ұят.
Dialogue: 0,0:11:06.04,0:11:09.07,Default,,0000,0000,0000,,Қарғыс атсын. Ууууу….
Dialogue: 0,0:11:09.07,0:11:14.12,Default,,0000,0000,0000,,Оны жеңуіміздің бір ғана мүмкіндігі бар.
Dialogue: 0,0:11:14.12,0:11:17.15,Default,,0000,0000,0000,,Іс жақсы болса, әрине.
Dialogue: 0,0:11:17.15,0:11:20.18,Default,,0000,0000,0000,,Жарайды, ең алдымен, криллин→
Dialogue: 0,0:11:20.18,0:11:24.22,Default,,0000,0000,0000,,Сіз оның назарын толығымен аударуға тырысасыз. →
Dialogue: 0,0:11:24.22,0:11:26.24,Default,,0000,0000,0000,,Содан мен өзіме ұнайтын нәрсені таптым →
Dialogue: 0,0:11:26.24,0:11:28.26,Default,,0000,0000,0000,,Құйрықты ұстау - Сайянның осалдығы.
Dialogue: 0,0:11:28.26,0:11:30.28,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:11:30.28,0:11:33.31,Default,,0000,0000,0000,,Күш-қуатым таусылып, қозғала алмай қалғанда→
Dialogue: 0,0:11:33.31,0:11:36.34,Default,,0000,0000,0000,,Гохан, бар күшіңді салып, зарядта!
Dialogue: 0,0:11:36.34,0:11:40.38,Default,,0000,0000,0000,,Иә! Мен бұл жолы енді қашпаймын, сондықтан жақсы!
Dialogue: 0,0:11:40.38,0:11:45.43,Default,,0000,0000,0000,,Әрине. Жердің тағдыры өз қолыңызда екеніне сеніңіз.
Dialogue: 0,0:11:45.43,0:11:47.45,Default,,0000,0000,0000,,Гохан Өзіңізге сенімді болыңыз.
Dialogue: 0,0:11:47.45,0:11:51.45,Default,,0000,0000,0000,,Сезсеңіз, менен артық күшіңіз бар.
Dialogue: 0,0:12:00.58,0:12:02.60,Default,,0000,0000,0000,,Хэхе...
Dialogue: 0,0:12:02.60,0:12:06.97,Default,,0000,0000,0000,,Жарайды... Кук...
Dialogue: 0,0:12:06.97,0:12:10.01,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:12:10.01,0:12:12.03,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:12:12.03,0:12:14.05,Default,,0000,0000,0000,,Гоку! О, Құдай!
Dialogue: 0,0:12:14.05,0:12:17.08,Default,,0000,0000,0000,,Тез, мені ұста! сұраңыз!
Dialogue: 0,0:12:17.08,0:12:19.10,Default,,0000,0000,0000,,А... анау бала.
Dialogue: 0,0:12:19.10,0:12:23.10,Default,,0000,0000,0000,,Мен Кай патшадан шынымен оралдым.
Dialogue: 0,0:12:25.16,0:12:29.20,Default,,0000,0000,0000,,Онда мен барамын. Жаттығу тамаша.
Dialogue: 0,0:12:29.20,0:12:32.23,Default,,0000,0000,0000,,Мен мұны сұрадым. (Попо мырза) Сәттілік, Гоку.
Dialogue: 0,0:12:32.23,0:12:34.25,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:12:34.25,0:12:40.31,Default,,0000,0000,0000,,Барлығына! Гохан! Өтінемін аман бол!
Dialogue: 0,0:12:40.31,0:12:44.35,Default,,0000,0000,0000,,Бұл осында. Сон Гоку қатты шаршады.
Dialogue: 0,0:12:44.35,0:12:47.38,Default,,0000,0000,0000,,Сәлем! Ах~!
Dialogue: 0,0:12:47.38,0:12:49.40,Default,,0000,0000,0000,,Қарин-сама~!
Dialogue: 0,0:12:49.40,0:12:54.45,Default,,0000,0000,0000,,Соңғы екі сензу бұршақтары. бұл!
Dialogue: 0,0:12:54.45,0:12:58.49,Default,,0000,0000,0000,,Рахмет! Бұл пайдалы болды. Мен оны сұрадым.
Dialogue: 0,0:12:58.49,0:13:00.49,Default,,0000,0000,0000,,Бір таблетканы дереу қабылдаңыз.
Dialogue: 0,0:13:06.90,0:13:10.90,Default,,0000,0000,0000,,Жарайды, мен өзімді жақсы сезінемін. Бұлшық ет бұлты!
Dialogue: 0,0:13:12.96,0:13:15.99,Default,,0000,0000,0000,,Біраз уақыт болды~ Өтінемін!
Dialogue: 0,0:13:15.99,0:13:18.02,Default,,0000,0000,0000,,Көп энергия жиналуда. Ол жерде!
Dialogue: 0,0:13:18.02,0:13:20.04,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:13:20.04,0:13:27.04,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:14:39.50,0:14:44.55,Default,,0000,0000,0000,,Уф... уф.
Dialogue: 0,0:14:44.55,0:14:47.58,Default,,0000,0000,0000,,Жарайды, кеттік! →
Dialogue: 0,0:14:47.58,0:14:50.61,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:14:50.61,0:14:54.61,Default,,0000,0000,0000,,Хаха, сен кенет маған кіріп кеттің.
Dialogue: 0,0:14:57.68,0:14:59.70,Default,,0000,0000,0000,,《Назар аударту》
Dialogue: 0,0:14:59.70,0:15:03.74,Default,,0000,0000,0000,,Иә. Апыр-ай!
Dialogue: 0,0:15:03.74,0:15:05.74,Default,,0000,0000,0000,,Айтпасаң да түсінікті — өзің көресің
Dialogue: 0,0:15:07.78,0:15:09.80,Default,,0000,0000,0000,,Құрметті сіздер.
Dialogue: 0,0:15:09.80,0:15:11.82,Default,,0000,0000,0000,,Гохан!
Dialogue: 0,0:15:11.82,0:15:14.85,Default,,0000,0000,0000,,Гува~!
Dialogue: 0,0:15:14.85,0:15:17.88,Default,,0000,0000,0000,,Хехе, ақымақ.
Dialogue: 0,0:15:17.88,0:15:19.90,Default,,0000,0000,0000,,Ә!? Уф.
Dialogue: 0,0:15:19.90,0:15:22.93,Default,,0000,0000,0000,,Сәттілік….
Dialogue: 0,0:15:22.93,0:15:27.93,Default,,0000,0000,0000,,Аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:15:32.03,0:15:35.39,Default,,0000,0000,0000,,Пиппи Пикколо-сан….
Dialogue: 0,0:15:35.39,0:15:38.42,Default,,0000,0000,0000,,Гуааа….
Dialogue: 0,0:15:38.42,0:15:42.46,Default,,0000,0000,0000,,Ой, мен өлмеймін, хехехехе.
Dialogue: 0,0:15:42.46,0:15:48.52,Default,,0000,0000,0000,,Маған әлі Айдаһар добы туралы айту керек.
Dialogue: 0,0:15:48.52,0:15:51.55,Default,,0000,0000,0000,,Сонымен, солай, солай….
Dialogue: 0,0:15:51.55,0:15:55.59,Default,,0000,0000,0000,,Хахаха! Мен қате есептедім деп ойлаймын.
Dialogue: 0,0:15:55.59,0:15:59.63,Default,,0000,0000,0000,,Біз өзіміздің әлсіз жақтарымызды ешқашан жаттықтырмаймыз деп ойладыңыз ба?
Dialogue: 0,0:15:59.63,0:16:03.67,Default,,0000,0000,0000,,Хэ-хэ-хэ, бұл көңілді қалдырды.
Dialogue: 0,0:16:03.67,0:16:08.72,Default,,0000,0000,0000,,Бұл планетадағы ең жақсы пайдаланушының өзі бір соққымен осы күйде болады.
Dialogue: 0,0:16:08.72,0:16:12.76,Default,,0000,0000,0000,,Пип Пикколо-сан, мықты бол!
Dialogue: 0,0:16:12.76,0:16:17.81,Default,,0000,0000,0000,,Ал... мына жігіт менің үстімде ұйықтап жатқанда→
Dialogue: 0,0:16:17.81,0:16:21.85,Default,,0000,0000,0000,,Мүмкін мен кішкентай балалармен ойнайтын шығармын. Хехехе.
Dialogue: 0,0:16:21.85,0:16:24.88,Default,,0000,0000,0000,,Ah Ah….
Dialogue: 0,0:16:24.88,0:16:29.93,Default,,0000,0000,0000,,Фью~ Какароттың ұлынан бастайық.
Dialogue: 0,0:16:29.93,0:16:34.31,Default,,0000,0000,0000,,Эй, сенің де Сайянның қаны бар екені анық.
Dialogue: 0,0:16:34.31,0:16:37.34,Default,,0000,0000,0000,,Бұл аздап қызық болады, солай ма?
Dialogue: 0,0:16:37.34,0:16:39.36,Default,,0000,0000,0000,,Хахахаха.
Dialogue: 0,0:16:39.36,0:16:42.39,Default,,0000,0000,0000,,Уаааа….
Dialogue: 0,0:16:42.39,0:16:44.39,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:16:51.48,0:16:55.52,Default,,0000,0000,0000,,Ей, эй, әлі берілме.
Dialogue: 0,0:16:55.52,0:16:57.54,Default,,0000,0000,0000,,Маған сендермен тағы біраз ойнайын.
Dialogue: 0,0:16:57.54,0:17:00.54,Default,,0000,0000,0000,,Ой.
Dialogue: 0,0:17:04.61,0:17:08.65,Default,,0000,0000,0000,,Хе хе хе. Ух ха ха….
Dialogue: 0,0:17:08.65,0:17:12.69,Default,,0000,0000,0000,,Хахахаха мен мұны істеуім керек.
Dialogue: 0,0:17:12.69,0:17:14.69,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:17:16.73,0:17:18.75,Default,,0000,0000,0000,,Конняро!
Dialogue: 0,0:17:18.75,0:17:28.85,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:17:28.85,0:17:32.89,Default,,0000,0000,0000,,Ал... қимылы өте әсерлі.
Dialogue: 0,0:17:32.89,0:17:36.89,Default,,0000,0000,0000,,Хе, мен оны қайда сақтайтынымды көрсетемін.
Dialogue: 0,0:17:38.29,0:17:46.29,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:17:53.44,0:17:56.47,Default,,0000,0000,0000,,Хмм? (Вегета) Иә?
Dialogue: 0,0:17:56.47,0:18:00.51,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:18:00.51,0:18:02.51,Default,,0000,0000,0000,,Хах.
Dialogue: 0,0:18:04.55,0:18:06.55,Default,,0000,0000,0000,,Уф.
Dialogue: 0,0:18:13.64,0:18:16.67,Default,,0000,0000,0000,,Киензан! →
Dialogue: 0,0:18:16.67,0:18:18.69,Default,,0000,0000,0000,,Тым~!
Dialogue: 0,0:18:18.69,0:18:23.69,Default,,0000,0000,0000,,Иә? Ха, бұл ақымақ қулық.
Dialogue: 0,0:18:25.76,0:18:27.76,Default,,0000,0000,0000,,Наппа Додж!
Dialogue: 0,0:18:37.21,0:18:41.25,Default,,0000,0000,0000,,Ah Ah….
Dialogue: 0,0:18:41.25,0:18:45.29,Default,,0000,0000,0000,,Әлгі ақымақ! Мен оның қандай техника екенін түсіне алмаймын.
Dialogue: 0,0:18:45.29,0:18:47.31,Default,,0000,0000,0000,,Қарғыс атсын.
Dialogue: 0,0:18:47.31,0:18:51.31,Default,,0000,0000,0000,,Уу-у...
Dialogue: 0,0:18:55.39,0:18:58.42,Default,,0000,0000,0000,,О, өзім!
Dialogue: 0,0:18:58.42,0:19:03.47,Default,,0000,0000,0000,,Ал... жарайды, менің бетімді жараладың!
Dialogue: 0,0:19:03.47,0:19:09.53,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:19:09.53,0:19:13.57,Default,,0000,0000,0000,,Жоғал!
Dialogue: 0,0:19:13.57,0:19:18.62,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:19:18.62,0:19:20.64,Default,,0000,0000,0000,,Хехе.
Dialogue: 0,0:19:20.64,0:19:22.66,Default,,0000,0000,0000,,Ах! Аяқтаңыз!
Dialogue: 0,0:19:22.66,0:19:24.66,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:19:27.71,0:19:30.71,Default,,0000,0000,0000,,Гоу~.
Dialogue: 0,0:19:34.11,0:19:39.16,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:19:39.16,0:19:42.19,Default,,0000,0000,0000,,Сіз әлі ояндыңыз ба?
Dialogue: 0,0:19:42.19,0:19:45.22,Default,,0000,0000,0000,,Иә, бейбақ!
Dialogue: 0,0:19:45.22,0:19:50.27,Default,,0000,0000,0000,,Хахаха! Сенің қиналып жатқан сияқтысың, Наппа.
Dialogue: 0,0:19:50.27,0:19:56.33,Default,,0000,0000,0000,,Мына жерді жалама... Саян!
Dialogue: 0,0:19:56.33,0:20:01.38,Default,,0000,0000,0000,,Мен жындымын!
Dialogue: 0,0:20:01.38,0:20:04.41,Default,,0000,0000,0000,,Айдаһар шарлары үшін тек сізді өлтіру мүмкін емес→
Dialogue: 0,0:20:04.41,0:20:08.45,Default,,0000,0000,0000,,Мен жеңіл жүрдім. Мен өзімді жақсы сезіне бастадым!
Dialogue: 0,0:20:08.45,0:20:11.48,Default,,0000,0000,0000,,Өзіңізді жақсы сезінетін адамсыз.
Dialogue: 0,0:20:11.48,0:20:15.52,Default,,0000,0000,0000,,Иә!? Не? Бұл рух.
Dialogue: 0,0:20:15.52,0:20:21.58,Default,,0000,0000,0000,,Ғажайып сезім алыстан жақындап келеді.
Dialogue: 0,0:20:21.58,0:20:24.61,Default,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:20:24.61,0:20:28.65,Default,,0000,0000,0000,,Бұл керемет, бірақ мен сағыныш сезінемін.
Dialogue: 0,0:20:28.65,0:20:34.04,Default,,0000,0000,0000,,Оған күмәнім жоқ... Мен оны сеземін.
Dialogue: 0,0:20:34.04,0:20:36.06,Default,,0000,0000,0000,,Бір ғана.
Dialogue: 0,0:20:36.06,0:20:39.06,Default,,0000,0000,0000,,Сон Гоку.
Dialogue: 0,0:20:42.12,0:20:47.17,Default,,0000,0000,0000,,《Жақында, Гоку, асығыңыз, асығыңыз》
Dialogue: 0,0:20:47.17,0:20:51.21,Default,,0000,0000,0000,,Сон Гоку! Сон Гоку келе жатыр.
Dialogue: 0,0:20:51.21,0:20:56.26,Default,,0000,0000,0000,,Мен оның келетініне сенімді болдым. Сөйтсем, әлгі бейбақ, мені күте тұр.
Dialogue: 0,0:20:56.26,0:21:01.31,Default,,0000,0000,0000,,Әй, әке, әке келе жатыр.
Dialogue: 0,0:21:01.31,0:21:03.33,Default,,0000,0000,0000,,Асығыңыз, асығыңыз!
Dialogue: 0,0:21:03.33,0:21:06.36,Default,,0000,0000,0000,,Хэхе... Гоку.
Dialogue: 0,0:21:06.36,0:21:11.41,Default,,0000,0000,0000,,Бұл жігіттерде олардың қатысуынан анықталатын тылсым күш бар.
Dialogue: 0,0:21:11.41,0:21:16.46,Default,,0000,0000,0000,,Какарот... қайсысы?
Dialogue: 0,0:21:16.46,0:21:20.50,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:21:20.50,0:21:23.53,Default,,0000,0000,0000,,Мен оның келе жатқанын сеземін. Менде екі үлкен сезім бар →
Dialogue: 0,0:21:23.53,0:21:27.57,Default,,0000,0000,0000,,Тағы екі үлкен сезім және бір кішкентай сезім.
Dialogue: 0,0:21:27.57,0:21:32.62,Default,,0000,0000,0000,,Сандар сәйкес келмейді. Сонда біреу өлді ме?
Dialogue: 0,0:21:32.62,0:21:36.62,Default,,0000,0000,0000,,Суджитун, асығыңыз!
Dialogue: 0,0:21:38.02,0:21:40.04,Default,,0000,0000,0000,,Ах….
Dialogue: 0,0:21:40.04,0:21:44.08,Default,,0000,0000,0000,,Вегета Бұл жігіттердің айтқаны рас па?
Dialogue: 0,0:21:44.08,0:21:46.10,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:21:46.10,0:21:50.14,Default,,0000,0000,0000,,Какарот шынымен де осы жолмен келе ме?
Dialogue: 0,0:21:50.14,0:21:53.17,Default,,0000,0000,0000,,Мен бұл Какарот па, білмеймін→
Dialogue: 0,0:21:53.17,0:21:58.22,Default,,0000,0000,0000,,Мұнда төрт минуттан кейін біреу келеді.
Dialogue: 0,0:21:58.22,0:22:03.27,Default,,0000,0000,0000,,Жауынгерлік қабілеті шамамен 5000.
Dialogue: 0,0:22:03.27,0:22:07.31,Default,,0000,0000,0000,,5... 5000!? Ақымақ!
Dialogue: 0,0:22:07.31,0:22:10.34,Default,,0000,0000,0000,,Наппа! Оларды өлтір.
Dialogue: 0,0:22:10.34,0:22:14.38,Default,,0000,0000,0000,,Төртеу түгел қосылса, әбігерге түсетін шығар.
Dialogue: 0,0:22:14.38,0:22:17.41,Default,,0000,0000,0000,,Сондай-ақ Какаротқа үлгі ретінде.
Dialogue: 0,0:22:17.41,0:22:20.44,Default,,0000,0000,0000,,Не!? иә?
Dialogue: 0,0:22:20.44,0:22:23.47,Default,,0000,0000,0000,,Тынш, бірақ Dragon Ball ше?
Dialogue: 0,0:22:23.47,0:22:27.51,Default,,0000,0000,0000,,Мәселе жоқ! Менде бір идея бар.
Dialogue: 0,0:22:27.51,0:22:30.54,Default,,0000,0000,0000,,Намекиялықтардың туған қаласы Намек планетасына барсаңыз→
Dialogue: 0,0:22:30.54,0:22:34.91,Default,,0000,0000,0000,,Мен одан да күшті Айдаһар шарлары бар екеніне сенімдімін.
Dialogue: 0,0:22:34.91,0:22:36.93,Default,,0000,0000,0000,,Мен бұл ақымақ өсек деп ойладым→
Dialogue: 0,0:22:36.93,0:22:39.96,Default,,0000,0000,0000,,Егер Какарот шынымен өмірге оралса→
Dialogue: 0,0:22:39.96,0:22:43.00,Default,,0000,0000,0000,,Бұл аңыз ақиқат болды.
Dialogue: 0,0:22:43.00,0:22:47.04,Default,,0000,0000,0000,,Мен көремін. Ендеше, сізден бастайық.
Dialogue: 0,0:22:47.04,0:22:51.08,Default,,0000,0000,0000,,Қарғыс атсын. Пип Пикколо-сан, қаш!
Dialogue: 0,0:22:51.08,0:22:55.12,Default,,0000,0000,0000,,Мен оны әкем келгенше ұстауға бар күшімді саламын.
Dialogue: 0,0:22:55.12,0:22:57.14,Default,,0000,0000,0000,,Не? Өйткені →
Dialogue: 0,0:22:57.14,0:23:00.17,Default,,0000,0000,0000,,Пикколо өлсе, Құдай да өледі→
Dialogue: 0,0:23:00.17,0:23:02.19,Default,,0000,0000,0000,,Айдаһар добы...
Dialogue: 0,0:23:02.19,0:23:05.22,Default,,0000,0000,0000,,Әй, сен бос сөз айтып тұрсың.
Dialogue: 0,0:23:05.22,0:23:08.25,Default,,0000,0000,0000,,Оны пайдалану арқылы ғана тоқтата алмайсыз.
Dialogue: 0,0:23:08.25,0:23:14.31,Default,,0000,0000,0000,,Ей, сен мені күлдірдің. Мына жырау!
Dialogue: 0,0:23:14.31,0:23:16.33,Default,,0000,0000,0000,,《Жоқ! 》
Dialogue: 0,0:23:16.33,0:23:20.37,Default,,0000,0000,0000,,Ууаааа…. Хахаха!
Dialogue: 0,0:23:20.37,0:23:23.37,Default,,0000,0000,0000,,Яаааааа!
Dialogue: 0,0:23:30.47,0:23:37.47,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:23:45.95,0:23:47.95,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:23:50.00,0:23:54.04,Default,,0000,0000,0000,,Ой... мына жыныс~.
Dialogue: 0,0:23:54.04,0:23:57.04,Default,,0000,0000,0000,,Міне!
Dialogue: 0,0:24:03.13,0:24:06.16,Default,,0000,0000,0000,,Ааааа….
Dialogue: 0,0:24:06.16,0:24:09.16,Default,,0000,0000,0000,,Мүмкін емес.
Dialogue: 0,0:24:11.21,0:24:14.24,Default,,0000,0000,0000,,Өл! →
Dialogue: 0,0:24:14.24,0:24:17.27,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:24:17.27,0:24:21.27,Default,,0000,0000,0000,,Уау~ Ааа….
Dialogue: 0,0:24:23.33,0:24:25.35,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:24:25.35,0:24:27.35,Default,,0000,0000,0000,,Ха~хахаха!
Dialogue: 0,0:24:29.39,0:24:32.42,Default,,0000,0000,0000,,Ахх. Апыр-ай!
Dialogue: 0,0:24:32.42,0:24:36.46,Default,,0000,0000,0000,,<Бұл күтпеген әрекет болды. →
Dialogue: 0,0:24:36.46,0:24:39.49,Default,,0000,0000,0000,,Пикколоның басына қандай ой келді? →
Dialogue: 0,0:24:39.49,0:24:43.49,Default,,0000,0000,0000,,Ал өмір мен өлім ше!?>
Dialogue: 0,0:24:46.56,0:24:51.61,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:51.61,0:25:11.81,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:11.81,0:25:31.01,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:31.01,0:25:43.01,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:48.52,0:25:52.56,Default,,0000,0000,0000,,Сәлем, Гоку. Бір рух жоғалады. Амал жоқ...
Dialogue: 0,0:25:52.56,0:25:54.58,Default,,0000,0000,0000,,Бұл сенің ата-анаңның кінәсі. →
Dialogue: 0,0:25:54.58,0:25:56.60,Default,,0000,0000,0000,,Әй, тәтті менде жоғалып кетті.
Dialogue: 0,0:25:56.60,0:26:00.64,Default,,0000,0000,0000,,Пикколо-сан, неге? Өлме, Пикколо!
Dialogue: 0,0:26:00.64,0:26:02.66,Default,,0000,0000,0000,,Гува~!
Dialogue: 0,0:26:02.66,0:26:04.68,Default,,0000,0000,0000,,Мені кешіріңдер, балалар!
Dialogue: 0,0:26:04.68,0:26:07.68,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»
Dialogue: 0,0:26:10.74,0:26:13.74,Default,,0000,0000,0000,,Керемет! Әке күшті!
Dialogue: 0,0:26:15.24,0:26:21.24,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory