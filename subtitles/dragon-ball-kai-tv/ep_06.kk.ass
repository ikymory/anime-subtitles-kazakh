Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.70,0:00:14.76,Default,,0000,0000,0000,,<Гохан толған айды көргеннен кейін алғаш рет ұлы маймылға айналады. →
Dialogue: 0,0:00:14.76,0:00:17.79,Default,,0000,0000,0000,,Оның орасан зор жойқын күшін басу үшін→
Dialogue: 0,0:00:17.79,0:00:23.85,Default,,0000,0000,0000,,Пикколо айды түгелдей жояды→
Dialogue: 0,0:00:23.85,0:00:27.89,Default,,0000,0000,0000,,Гоханның құйрығын алып тастады＞
Dialogue: 0,0:00:27.89,0:00:33.95,Default,,0000,0000,0000,,Мен өзімді жаттықтыруым керек. Қазір барайық.
Dialogue: 0,0:00:33.95,0:00:38.95,Default,,0000,0000,0000,,<Осылайша алты ай өтті>
Dialogue: 0,0:00:41.03,0:00:46.08,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:46.08,0:01:06.61,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:06.61,0:01:26.81,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:26.81,0:01:46.01,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:46.01,0:02:03.01,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:25.60,0:04:29.60,Default,,0000,0000,0000,,(Құстар әні)
Dialogue: 0,0:04:41.76,0:04:43.78,Default,,0000,0000,0000,,Хуа~.
Dialogue: 0,0:04:43.78,0:04:45.80,Default,,0000,0000,0000,,(Эмма) Бүкіл отбасыны алып шығу үшін. (Мусика) Дұрыс
Dialogue: 0,0:04:45.80,0:04:47.80,Default,,0000,0000,0000,,Жарайды.
Dialogue: 0,0:04:49.84,0:04:51.86,Default,,0000,0000,0000,,Yaho!
Dialogue: 0,0:04:51.86,0:04:54.89,Default,,0000,0000,0000,,Иә! Ха ха.
Dialogue: 0,0:04:54.89,0:04:58.89,Default,,0000,0000,0000,,Иә, иә, иә.
Dialogue: 0,0:05:03.98,0:05:10.05,Default,,0000,0000,0000,,Хаа~ ла ла ла ла~ йа~!
Dialogue: 0,0:05:10.05,0:05:13.08,Default,,0000,0000,0000,,Иә~!
Dialogue: 0,0:05:13.08,0:05:30.58,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:05:30.58,0:05:32.58,Default,,0000,0000,0000,,Хэхехехе Иә?
Dialogue: 0,0:05:41.69,0:05:43.69,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:49.77,0:05:54.82,Default,,0000,0000,0000,,Не, тағы сен бе? Мен өкінбеймін.
Dialogue: 0,0:05:54.82,0:05:57.82,Default,,0000,0000,0000,,(үру)
Dialogue: 0,0:06:00.88,0:06:03.91,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:06:03.91,0:06:13.01,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:06:13.01,0:06:18.01,Default,,0000,0000,0000,,Әй, бұл осылай. Сүйікті.
Dialogue: 0,0:06:26.47,0:06:28.47,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:06:30.51,0:06:34.51,Default,,0000,0000,0000,,Олай болса мен тағы ет аламын.
Dialogue: 0,0:06:39.60,0:06:43.60,Default,,0000,0000,0000,,Ақыры құйрығыңнан айырыласың.
Dialogue: 0,0:06:47.68,0:06:49.68,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:06:59.80,0:07:05.86,Default,,0000,0000,0000,,Хм... Сәл жақсырақ болған сияқты. Хехе.
Dialogue: 0,0:07:05.86,0:07:10.91,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:07:10.91,0:07:15.13,Default,,0000,0000,0000,,Әлі емес пе? Кай патша қайда? Хахаха….
Dialogue: 0,0:07:15.13,0:07:26.40,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:26.40,0:07:29.43,Default,,0000,0000,0000,,Ой, егер бізде осы мүшелердің барлығы болса →
Dialogue: 0,0:07:29.43,0:07:31.45,Default,,0000,0000,0000,,Сайандар мүлде қорқынышты емес.
Dialogue: 0,0:07:31.45,0:07:35.49,Default,,0000,0000,0000,,Құдай маған қандай тәрбие береді екен деп асыға күтемін.
Dialogue: 0,0:07:35.49,0:07:37.51,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:07:37.51,0:07:48.62,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:48.62,0:07:55.69,Default,,0000,0000,0000,,Хм... Менімен ажырасқаннан кейінгі алты айдың ішінде сәл жақсы болған сияқтысың.
Dialogue: 0,0:07:55.69,0:07:59.73,Default,,0000,0000,0000,,Ендеше, мен оған толыққанды сығымдаймын делік.
Dialogue: 0,0:07:59.73,0:08:01.75,Default,,0000,0000,0000,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,0:08:01.75,0:08:04.78,Default,,0000,0000,0000,,Таа~!
Dialogue: 0,0:08:04.78,0:08:07.81,Default,,0000,0000,0000,,Хо хо хо ха фуфу. Урья~!
Dialogue: 0,0:08:07.81,0:08:09.83,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:09.83,0:08:11.85,Default,,0000,0000,0000,,Не болды!
Dialogue: 0,0:08:11.85,0:08:14.88,Default,,0000,0000,0000,,Иә~!
Dialogue: 0,0:08:14.88,0:08:17.25,Default,,0000,0000,0000,,Міне! Таааа! Апыр-ай.
Dialogue: 0,0:08:17.25,0:08:21.29,Default,,0000,0000,0000,,Мақсатыңызды жоғалтпаңыз! Мен оның соншалықты жылдам жүріп жатқанын көре алмаймын.
Dialogue: 0,0:08:21.29,0:08:25.33,Default,,0000,0000,0000,,Көрме, сезін.
Dialogue: 0,0:08:25.33,0:08:29.37,Default,,0000,0000,0000,,Айтуға оңай, бірақ... ауырады.
Dialogue: 0,0:08:29.37,0:08:31.37,Default,,0000,0000,0000,,Ках!
Dialogue: 0,0:08:36.44,0:08:39.47,Default,,0000,0000,0000,,Хо хо хо хо.
Dialogue: 0,0:08:39.47,0:08:44.47,Default,,0000,0000,0000,,Күрсіну~ Ха, мен әлі де соңғы нүктені көре алмаймын.
Dialogue: 0,0:08:46.54,0:08:55.63,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:08:55.63,0:08:58.66,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:08:58.66,0:09:05.73,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:09:05.73,0:09:07.73,Default,,0000,0000,0000,,Ммм.
Dialogue: 0,0:09:13.81,0:09:15.99,Default,,0000,0000,0000,,Эй, сәлем….
Dialogue: 0,0:09:15.99,0:09:17.99,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:09:19.20,0:09:21.22,Default,,0000,0000,0000,,Ах~.
Dialogue: 0,0:09:21.22,0:09:23.24,Default,,0000,0000,0000,,Бұл құйрық!
Dialogue: 0,0:09:23.24,0:09:26.27,Default,,0000,0000,0000,,Иә! Біз осындамыз!
Dialogue: 0,0:09:26.27,0:09:29.30,Default,,0000,0000,0000,,Құлағы~.
Dialogue: 0,0:09:29.30,0:09:33.34,Default,,0000,0000,0000,,Құлағы~.
Dialogue: 0,0:09:33.34,0:09:35.36,Default,,0000,0000,0000,,Хахахаха~ Хаха.
Dialogue: 0,0:09:35.36,0:09:37.38,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:09:37.38,0:09:42.43,Default,,0000,0000,0000,,Уау~ Уау уау….
Dialogue: 0,0:09:42.43,0:09:44.43,Default,,0000,0000,0000,,Иә? Иә?
Dialogue: 0,0:09:46.47,0:09:48.47,Default,,0000,0000,0000,,Ештеңе.
Dialogue: 0,0:09:52.53,0:09:55.56,Default,,0000,0000,0000,,Бұл өтірік, солай ма?
Dialogue: 0,0:09:55.56,0:09:58.59,Default,,0000,0000,0000,,Иә? Не? Бұл.
Dialogue: 0,0:09:58.59,0:10:00.59,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:02.63,0:10:07.68,Default,,0000,0000,0000,,Міне! Кай патша сол жерде.
Dialogue: 0,0:10:07.68,0:10:09.70,Default,,0000,0000,0000,,Yahoo~!
Dialogue: 0,0:10:09.70,0:10:23.17,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:23.17,0:10:27.21,Default,,0000,0000,0000,,Біздің үйіміз бар ғой.
Dialogue: 0,0:10:27.21,0:10:31.25,Default,,0000,0000,0000,,Иә? Ааааааааааааа....
Dialogue: 0,0:10:31.25,0:10:33.25,Default,,0000,0000,0000,,Не? Не?
Dialogue: 0,0:10:36.30,0:10:40.34,Default,,0000,0000,0000,,Куу~кууууууууууууууууууууу....
Dialogue: 0,0:10:40.34,0:10:44.38,Default,,0000,0000,0000,,Не? Бұл жер.
Dialogue: 0,0:10:44.38,0:10:47.41,Default,,0000,0000,0000,,Куу~ Гугугу….
Dialogue: 0,0:10:47.41,0:10:49.41,Default,,0000,0000,0000,,Қарғыс атсын.
Dialogue: 0,0:10:52.46,0:10:58.52,Default,,0000,0000,0000,,Уау... Керемет күшпен сорып жатқан сияқты.
Dialogue: 0,0:10:58.52,0:11:00.54,Default,,0000,0000,0000,,Уф! Бұл жақсы емес.
Dialogue: 0,0:11:00.54,0:11:04.58,Default,,0000,0000,0000,,Денесі қорғасындай ауыр болды.
Dialogue: 0,0:11:04.58,0:11:09.63,Default,,0000,0000,0000,,Боқ~ Гугугугу….
Dialogue: 0,0:11:09.63,0:11:14.68,Default,,0000,0000,0000,,Kugggggggg….
Dialogue: 0,0:11:14.68,0:11:21.09,Default,,0000,0000,0000,,Біз осы уақытқа дейін жеттік...
Dialogue: 0,0:11:21.09,0:11:27.15,Default,,0000,0000,0000,,О, мен Кай патшаны міндетті түрде кездестіремін...
Dialogue: 0,0:11:27.15,0:11:31.19,Default,,0000,0000,0000,,Тағы біраз.
Dialogue: 0,0:11:31.19,0:11:36.24,Default,,0000,0000,0000,,Уф... ол жақында қалды.
Dialogue: 0,0:11:36.24,0:11:39.27,Default,,0000,0000,0000,,Әй?
Dialogue: 0,0:11:39.27,0:11:42.30,Default,,0000,0000,0000,,Оған дейін тамақ іздеп көрейік.
Dialogue: 0,0:11:42.30,0:11:45.30,Default,,0000,0000,0000,,Ууууууууууууууууууу.
Dialogue: 0,0:11:51.39,0:11:54.39,Default,,0000,0000,0000,,Хехе... хехе.
Dialogue: 0,0:11:58.46,0:12:01.49,Default,,0000,0000,0000,,Ауырды.
Dialogue: 0,0:12:01.49,0:12:05.53,Default,,0000,0000,0000,,Uwagggggg….
Dialogue: 0,0:12:05.53,0:12:08.53,Default,,0000,0000,0000,,Уау! Хахаха….
Dialogue: 0,0:12:14.62,0:12:19.00,Default,,0000,0000,0000,,Ка-Кай-сама? Кай патша ма?
Dialogue: 0,0:12:19.00,0:12:23.04,Default,,0000,0000,0000,,Уууу уууу уууу уууу.
Dialogue: 0,0:12:23.04,0:12:27.08,Default,,0000,0000,0000,,《Осындай көрінсе де керемет екеніне сенімдімін》
Dialogue: 0,0:12:27.08,0:12:31.12,Default,,0000,0000,0000,,Сәлем, бұл Сон Гоку.
Dialogue: 0,0:12:31.12,0:12:34.15,Default,,0000,0000,0000,,Мен сіздің жаттығуларыңызды асыға күтемін.
Dialogue: 0,0:12:34.15,0:12:39.20,Default,,0000,0000,0000,,Кай патша, маған соғыс өнерін үйретші... өтінемін.
Dialogue: 0,0:12:39.20,0:12:41.22,Default,,0000,0000,0000,,Уау. иә?
Dialogue: 0,0:12:41.22,0:12:46.27,Default,,0000,0000,0000,,Уххххххххххххххххххххххххххххххххххххххххххххххххх
Dialogue: 0,0:12:46.27,0:12:48.29,Default,,0000,0000,0000,,А, бұл жаттығу ма?
Dialogue: 0,0:12:48.29,0:12:52.33,Default,,0000,0000,0000,,Уууу. Мен сізге бұл қозғалысты жасауды айтып жатырмын.
Dialogue: 0,0:12:52.33,0:12:55.36,Default,,0000,0000,0000,,Иә! Кай патша.
Dialogue: 0,0:12:55.36,0:13:00.41,Default,,0000,0000,0000,,Әй, мұнда жер қандай?
Dialogue: 0,0:13:00.41,0:13:04.45,Default,,0000,0000,0000,,Уххххххххххххххххххххххххххххх
Dialogue: 0,0:13:04.45,0:13:07.48,Default,,0000,0000,0000,,- (Кай) Эй, сен не істеп жатырсың?
Dialogue: 0,0:13:07.48,0:13:10.48,Default,,0000,0000,0000,,Иә? иә?
Dialogue: 0,0:13:13.54,0:13:17.54,Default,,0000,0000,0000,,Ааа... Иә?
Dialogue: 0,0:13:19.93,0:13:23.93,Default,,0000,0000,0000,,А... ыстық.
Dialogue: 0,0:14:35.69,0:14:38.72,Default,,0000,0000,0000,,Ухохохохо Ухохохохо.
Dialogue: 0,0:14:38.72,0:14:42.76,Default,,0000,0000,0000,,Ухохохохо Ухохохохо....
Dialogue: 0,0:14:42.76,0:14:46.80,Default,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:46.80,0:14:49.83,Default,,0000,0000,0000,,Не? О? иә? О, сен...
Dialogue: 0,0:14:49.83,0:14:52.86,Default,,0000,0000,0000,,Хехехехе Мен бе?
Dialogue: 0,0:14:52.86,0:14:56.90,Default,,0000,0000,0000,,Мен… Пори Пори Пори Пори. →
Dialogue: 0,0:14:56.90,0:15:00.94,Default,,0000,0000,0000,,Хмм, бәрі жақсы. Жарайды. →
Dialogue: 0,0:15:00.94,0:15:03.97,Default,,0000,0000,0000,,Кай~оо~ Кай~оо.
Dialogue: 0,0:15:03.97,0:15:05.99,Default,,0000,0000,0000,,Кай патша.
Dialogue: 0,0:15:05.99,0:15:07.01,Default,,0000,0000,0000,,Ә!?
Dialogue: 0,0:15:07.01,0:15:10.04,Default,,0000,0000,0000,,Ааааааа... Сонда ол ше?
Dialogue: 0,0:15:10.04,0:15:14.08,Default,,0000,0000,0000,,Бұл менің үй жануарым көпіршіктерім.
Dialogue: 0,0:15:14.08,0:15:17.11,Default,,0000,0000,0000,,Хахахаха не? Хаха.
Dialogue: 0,0:15:17.11,0:15:20.14,Default,,0000,0000,0000,,Мен бұл біртүрлі болды деп ойладым.
Dialogue: 0,0:15:20.14,0:15:25.19,Default,,0000,0000,0000,,Біртүрлі сенсің. айтпақшы….
Dialogue: 0,0:15:25.19,0:15:28.22,Default,,0000,0000,0000,,Бұл сөз тіркесі ең жақсы болды деп ойламайсыз ба?
Dialogue: 0,0:15:28.22,0:15:31.58,Default,,0000,0000,0000,,Күліңіз.
Dialogue: 0,0:15:31.58,0:15:33.58,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:15:36.63,0:15:40.67,Default,,0000,0000,0000,,Тыңдай алмай қобалжыдыңыз.
Dialogue: 0,0:15:40.67,0:15:43.70,Default,,0000,0000,0000,,Бұл мүлдем үмітсіз.
Dialogue: 0,0:15:43.70,0:15:48.75,Default,,0000,0000,0000,,Ал, мен сізге басқа сөз тіркесімен қызмет етемін.
Dialogue: 0,0:15:48.75,0:15:51.78,Default,,0000,0000,0000,,Пуруруруру Пуруруру.
Dialogue: 0,0:15:51.78,0:15:55.82,Default,,0000,0000,0000,,Гача Сәлеметсіз бе? сәлем?
Dialogue: 0,0:15:55.82,0:15:59.86,Default,,0000,0000,0000,,Иә? Телефонға ешкім жауап бермейді.
Dialogue: 0,0:15:59.86,0:16:02.89,Default,,0000,0000,0000,,Ухухуху. Иә?
Dialogue: 0,0:16:02.89,0:16:06.93,Default,,0000,0000,0000,,Кукукуку... Күшік! Бұл тамаша!
Dialogue: 0,0:16:06.93,0:16:08.93,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:16:12.99,0:16:15.02,Default,,0000,0000,0000,,Сен мұнда не үшін келдің?
Dialogue: 0,0:16:15.02,0:16:20.07,Default,,0000,0000,0000,,Не... Ах! Мен Кай корольді жаттықтыруды ойладым.
Dialogue: 0,0:16:20.07,0:16:22.07,Default,,0000,0000,0000,,Бұл жаттығу ма?
Dialogue: 0,0:16:24.11,0:16:26.13,Default,,0000,0000,0000,,Торя~! Алақай!
Dialogue: 0,0:16:26.13,0:16:28.15,Default,,0000,0000,0000,,Торя~.
Dialogue: 0,0:16:28.15,0:16:31.52,Default,,0000,0000,0000,,Уа, ау, әй, әй, әй.
Dialogue: 0,0:16:31.52,0:16:34.55,Default,,0000,0000,0000,,Не? Бұл қорғаныс па?
Dialogue: 0,0:16:34.55,0:16:46.67,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:16:46.67,0:16:48.69,Default,,0000,0000,0000,,Көбірек шоғырланыңыз! →
Dialogue: 0,0:16:48.69,0:16:52.73,Default,,0000,0000,0000,,Мен сені өлтіргім келіп тұр!
Dialogue: 0,0:16:52.73,0:16:57.78,Default,,0000,0000,0000,,Hehehehe Тренинг? Сіз жасай аласыз.
Dialogue: 0,0:16:57.78,0:16:59.80,Default,,0000,0000,0000,,Шынымен!?
Dialogue: 0,0:16:59.80,0:17:03.84,Default,,0000,0000,0000,,Бірақ егер сіз сынақтан өтсеңіз ғана.
Dialogue: 0,0:17:03.84,0:17:05.86,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:05.86,0:17:08.89,Default,,0000,0000,0000,,Бұл гений гений, Кай патша→
Dialogue: 0,0:17:08.89,0:17:11.92,Default,,0000,0000,0000,,Жұрттың күлкісін қағып алсам ғой.
Dialogue: 0,0:17:11.92,0:17:14.95,Default,,0000,0000,0000,,Ә!? Бұл сөз тіркесі ме?
Dialogue: 0,0:17:14.95,0:17:17.98,Default,,0000,0000,0000,,Фуфуфуфу қорқасың ба? →
Dialogue: 0,0:17:17.98,0:17:21.02,Default,,0000,0000,0000,,Бұл өте ауыр сөз болмаса, мен күлмеймін.
Dialogue: 0,0:17:21.02,0:17:23.04,Default,,0000,0000,0000,,Ал ше?
Dialogue: 0,0:17:23.04,0:17:27.08,Default,,0000,0000,0000,,Ммммммм.
Dialogue: 0,0:17:27.08,0:17:32.46,Default,,0000,0000,0000,,Пайдасы жоқ сияқты. Сосын бас тартып, үйге қайт!
Dialogue: 0,0:17:32.46,0:17:37.51,Default,,0000,0000,0000,,Пфф... футон ұшып кетті!
Dialogue: 0,0:17:37.51,0:17:40.54,Default,,0000,0000,0000,,О! Еееееееее... →
Dialogue: 0,0:17:40.54,0:17:45.59,Default,,0000,0000,0000,,А, футон ұшып кетті ме?
Dialogue: 0,0:17:45.59,0:17:47.61,Default,,0000,0000,0000,,Whoopupupup….
Dialogue: 0,0:17:47.61,0:17:49.63,Default,,0000,0000,0000,,《Тағы бір қадам》
Dialogue: 0,0:17:49.63,0:17:52.66,Default,,0000,0000,0000,,Мысық ұйықтап қалды!
Dialogue: 0,0:17:52.66,0:17:55.69,Default,,0000,0000,0000,,Жарайсың~! Pupupu….
Dialogue: 0,0:17:55.69,0:17:58.72,Default,,0000,0000,0000,,Қарындаштар көрінбейді!
Dialogue: 0,0:17:58.72,0:18:01.75,Default,,0000,0000,0000,,Ах! →
Dialogue: 0,0:18:01.75,0:18:03.77,Default,,0000,0000,0000,,Күшік… Кукукуку.
Dialogue: 0,0:18:03.77,0:18:08.82,Default,,0000,0000,0000,,А, мен күлдім! Кай патша күлді.
Dialogue: 0,0:18:08.82,0:18:10.84,Default,,0000,0000,0000,,Ахахха.
Dialogue: 0,0:18:10.84,0:18:12.86,Default,,0000,0000,0000,,Шабыт жарқылы!
Dialogue: 0,0:18:12.86,0:18:17.91,Default,,0000,0000,0000,,Аххх! Ахахха!
Dialogue: 0,0:18:17.91,0:18:21.95,Default,,0000,0000,0000,,Жоқ, сіз қарапайым адам емессіз.
Dialogue: 0,0:18:21.95,0:18:23.97,Default,,0000,0000,0000,,Сіз кәсіпқойсыз, солай ма? →
Dialogue: 0,0:18:23.97,0:18:28.02,Default,,0000,0000,0000,,Жақсы, жаттықтырайық. Мен саған айтамын.
Dialogue: 0,0:18:28.02,0:18:31.38,Default,,0000,0000,0000,,Керемет гаг.
Dialogue: 0,0:18:31.38,0:18:36.43,Default,,0000,0000,0000,,Е, гаг, гаг жақсы, маған жекпе-жек өнерін үйретші.
Dialogue: 0,0:18:36.43,0:18:41.48,Default,,0000,0000,0000,,Не, жекпе-жек өнері? Неге бірінші соны айтпайсың?
Dialogue: 0,0:18:41.48,0:18:43.50,Default,,0000,0000,0000,,Жарайды, келіңіз.
Dialogue: 0,0:18:43.50,0:18:46.53,Default,,0000,0000,0000,,Қаншалықты жақсы екеніңді көрейік.
Dialogue: 0,0:18:46.53,0:18:48.55,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:18:48.55,0:18:50.57,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:50.57,0:18:53.60,Default,,0000,0000,0000,,Не болды? Бұл біртүрлі.
Dialogue: 0,0:18:53.60,0:18:57.64,Default,,0000,0000,0000,,Қозғалу өте қиын болды, денем ауыр болды.
Dialogue: 0,0:18:57.64,0:19:01.68,Default,,0000,0000,0000,,Сіз қайдансыз? Жер ме?
Dialogue: 0,0:19:01.68,0:19:04.71,Default,,0000,0000,0000,,Ой-оу. Сонда ол ауыр болуы керек.
Dialogue: 0,0:19:04.71,0:19:07.74,Default,,0000,0000,0000,,Бұл кішкентай жұлдыз, бірақ оның тартылыс күші бар.
Dialogue: 0,0:19:07.74,0:19:11.78,Default,,0000,0000,0000,,Бұл сіздің жұлдызыңыздан шамамен 10 есе қымбат болуы мүмкін. →
Dialogue: 0,0:19:11.78,0:19:16.83,Default,,0000,0000,0000,,Демек сіздің салмағыңыз да 10 есе артады. иә?
Dialogue: 0,0:19:16.83,0:19:20.87,Default,,0000,0000,0000,,Жай ғана секіріңіз. Менің қолымнан келетіні осы.
Dialogue: 0,0:19:20.87,0:19:23.90,Default,,0000,0000,0000,,Ах. иә!
Dialogue: 0,0:19:23.90,0:19:27.94,Default,,0000,0000,0000,,О, ау... Уау!
Dialogue: 0,0:19:27.94,0:19:30.30,Default,,0000,0000,0000,,Жоқ, ол сәл ғана көтерілуі мүмкін.
Dialogue: 0,0:19:30.30,0:19:36.36,Default,,0000,0000,0000,,《Хммм...Мен оның ауырлық күшімен 10 есе жоғары секіретініне сене алар емеспін. →
Dialogue: 0,0:19:36.36,0:19:41.41,Default,,0000,0000,0000,,Бұл жігіт оны асыға күтеді!
Dialogue: 0,0:19:41.41,0:20:01.61,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:20:01.61,0:20:21.81,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:20:21.81,0:20:27.87,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:20:27.87,0:20:32.26,Default,,0000,0000,0000,,Жарайды, мен жаттығуды бастайын деп жатырмын, бірақ оны қанша уақытқа дейін жоспарлайсыз?
Dialogue: 0,0:20:32.26,0:20:34.28,Default,,0000,0000,0000,,Не? Хмм.
Dialogue: 0,0:20:34.28,0:20:39.33,Default,,0000,0000,0000,,Әй, жыланның жолымен қанша күн жүгіргенімді білмеймін.
Dialogue: 0,0:20:39.33,0:20:41.35,Default,,0000,0000,0000,,Бірақ бізде көп уақыт жоқ деп ойлаймын.
Dialogue: 0,0:20:41.35,0:20:45.39,Default,,0000,0000,0000,,Біздің планетада сайандар бар →
Dialogue: 0,0:20:45.39,0:20:47.41,Default,,0000,0000,0000,,Олар мұнда жасырынбақ ойнауға келген сияқты.
Dialogue: 0,0:20:47.41,0:20:52.46,Default,,0000,0000,0000,,Сол себепті мен сіздердің сол уақытқа дейін аз ғана уақыт болса да жаттығуды қалаймын.
Dialogue: 0,0:20:52.46,0:20:54.48,Default,,0000,0000,0000,,Сайян?
Dialogue: 0,0:20:54.48,0:20:57.51,Default,,0000,0000,0000,,Менің көзіме тағы бір мазасыз адам түсті.
Dialogue: 0,0:20:57.51,0:21:00.54,Default,,0000,0000,0000,,Қандай…. иә?
Dialogue: 0,0:21:00.54,0:21:05.54,Default,,0000,0000,0000,,Сайяндардың Жерге қашан келетінін білейік.
Dialogue: 0,0:21:07.61,0:21:16.70,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:21:16.70,0:21:20.70,Default,,0000,0000,0000,,Сайяндардың ұшатыны рас.
Dialogue: 0,0:21:22.76,0:21:25.79,Default,,0000,0000,0000,,Жерге осылай жетесіз деп ойлаймын... →
Dialogue: 0,0:21:25.79,0:21:29.99,Default,,0000,0000,0000,,Бар болғаны 158 күн қалды.
Dialogue: 0,0:21:29.99,0:21:32.19,Default,,0000,0000,0000,,Керемет! Сіз мұны түсінесіз бе?
Dialogue: 0,0:21:32.19,0:21:37.24,Default,,0000,0000,0000,,Мұндай ыңғайлы антенна. ...О құдайым-ай.
Dialogue: 0,0:21:37.24,0:21:41.28,Default,,0000,0000,0000,,Хехехе, ең жақсысы.
Dialogue: 0,0:21:41.28,0:21:43.28,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:21:46.33,0:21:49.36,Default,,0000,0000,0000,,Жаттығуды тоқтатуым керек пе?
Dialogue: 0,0:21:49.36,0:21:53.40,Default,,0000,0000,0000,,Вахахаха! Ең жақсы, ең жақсы, ең жақсы.
Dialogue: 0,0:21:53.40,0:21:55.42,Default,,0000,0000,0000,,Мен және ұлым
Dialogue: 0,0:21:55.42,0:22:00.47,Default,,0000,0000,0000,,Бірақ сайяндардың келуіне 158 күн ғана қалды емес пе?
Dialogue: 0,0:22:00.47,0:22:05.52,Default,,0000,0000,0000,,158 күн жеткілікті. иә?
Dialogue: 0,0:22:05.52,0:22:08.55,Default,,0000,0000,0000,,Осы планетада 158 күн жаттығамын→
Dialogue: 0,0:22:08.55,0:22:13.60,Default,,0000,0000,0000,,Бұл сіздің жер бетіндегі мыңдаған жылдық жаттығуларыңыз сияқты құнды.
Dialogue: 0,0:22:13.60,0:22:15.62,Default,,0000,0000,0000,,Шынымен!? (Кайоу) Дегенмен →
Dialogue: 0,0:22:15.62,0:22:19.66,Default,,0000,0000,0000,,Сіз жаттығу жасасаңыз да, Сайянды жеңе алмайсыз.
Dialogue: 0,0:22:19.66,0:22:23.70,Default,,0000,0000,0000,,Екі Сайян Жерге қарай бет алды→
Dialogue: 0,0:22:23.70,0:22:26.73,Default,,0000,0000,0000,,Бұл өте күшті.
Dialogue: 0,0:22:26.73,0:22:30.10,Default,,0000,0000,0000,,Ашығын айтқанда, оның күші мына қыраннан артық.
Dialogue: 0,0:22:30.10,0:22:34.14,Default,,0000,0000,0000,,Уа! Кай патшадан артық па? (Кай) Болды.
Dialogue: 0,0:22:34.14,0:22:38.18,Default,,0000,0000,0000,,Бұл ең болмағанда меннен асып түсуің керек деген сөз→
Dialogue: 0,0:22:38.18,0:22:42.18,Default,,0000,0000,0000,,Сайяндарды жеңу мүмкін емес.
Dialogue: 0,0:22:45.25,0:22:48.28,Default,,0000,0000,0000,,Ендеше бірден бастайық.
Dialogue: 0,0:22:48.28,0:22:51.31,Default,,0000,0000,0000,,Эй, көпіршіктер.
Dialogue: 0,0:22:51.31,0:22:56.36,Default,,0000,0000,0000,,Уххххххххххххххххххххххххххххххххххххххххххххххххххх
Dialogue: 0,0:22:56.36,0:22:59.39,Default,,0000,0000,0000,,Уфхххххххххххххххххххххххххх
Dialogue: 0,0:22:59.39,0:23:04.44,Default,,0000,0000,0000,,Біріншіден, біз мұнда ауыр ауырлық күшін жеңуіміз керек. →
Dialogue: 0,0:23:04.44,0:23:08.48,Default,,0000,0000,0000,,Мына көпіршіктерді ұстап алайық. Әзірге →
Dialogue: 0,0:23:08.48,0:23:12.52,Default,,0000,0000,0000,,Егер сіз сонша қозғала алмасаңыз, бұл туралы айтудың қажеті жоқ.
Dialogue: 0,0:23:12.52,0:23:14.54,Default,,0000,0000,0000,,Ғұн ғұн хун хун.
Dialogue: 0,0:23:14.54,0:23:17.57,Default,,0000,0000,0000,,Жарайды, түсіндім.
Dialogue: 0,0:23:17.57,0:23:20.60,Default,,0000,0000,0000,,Енді жүгір, Көпіршіктер. Ууууууу.
Dialogue: 0,0:23:20.60,0:23:25.65,Default,,0000,0000,0000,,А... Күте тұрыңыз.
Dialogue: 0,0:23:25.65,0:23:27.67,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:23:27.67,0:23:30.03,Default,,0000,0000,0000,,Уухоу Уууу.
Dialogue: 0,0:23:30.03,0:23:34.07,Default,,0000,0000,0000,,Эй, сәлем….
Dialogue: 0,0:23:34.07,0:23:39.12,Default,,0000,0000,0000,,Чичикушо Менің денем шынымен ауыр.
Dialogue: 0,0:23:39.12,0:23:42.15,Default,,0000,0000,0000,,Блять.
Dialogue: 0,0:23:42.15,0:23:46.19,Default,,0000,0000,0000,,Жарайды, қараңызшы.
Dialogue: 0,0:23:46.19,0:23:48.21,Default,,0000,0000,0000,,Урья~!
Dialogue: 0,0:23:48.21,0:23:51.21,Default,,0000,0000,0000,,Coo-hmph.
Dialogue: 0,0:23:54.27,0:23:57.27,Default,,0000,0000,0000,,О... Хахаха….
Dialogue: 0,0:23:59.32,0:24:02.35,Default,,0000,0000,0000,,Мен сені ұстаймын.
Dialogue: 0,0:24:02.35,0:24:08.41,Default,,0000,0000,0000,,О, сіз өте ауыр жабдықты киіп алғансыз ба?
Dialogue: 0,0:24:08.41,0:24:11.44,Default,,0000,0000,0000,,Хи хи хи.
Dialogue: 0,0:24:11.44,0:24:14.47,Default,,0000,0000,0000,,Енді ол әлдеқайда жеңіл. Хи хи хи.
Dialogue: 0,0:24:14.47,0:24:18.51,Default,,0000,0000,0000,,Уау? Міне бітті!
Dialogue: 0,0:24:18.51,0:24:23.56,Default,,0000,0000,0000,,<Гокудың қатал жаттығулары ақыры басталды. →
Dialogue: 0,0:24:23.56,0:24:27.60,Default,,0000,0000,0000,,Кай патшаның планетасының тартылыс күші Жерден 10 есе артық →
Dialogue: 0,0:24:27.60,0:24:32.65,Default,,0000,0000,0000,,Мұны шынымен жеңу мүмкін бе? →
Dialogue: 0,0:24:32.65,0:24:39.72,Default,,0000,0000,0000,,Сайяндардың Жерге келуіне 158 күн қалды. →
Dialogue: 0,0:24:39.72,0:24:43.72,Default,,0000,0000,0000,,Сот жаңа ғана басталды>
Dialogue: 0,0:24:46.79,0:24:51.84,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:51.84,0:25:11.04,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:11.04,0:25:31.58,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:31.58,0:25:44.58,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:48.75,0:25:51.78,Default,,0000,0000,0000,,Сәлем, Гоку. Мен сені міндетті түрде ұстаймын, Көпіршіктер!
Dialogue: 0,0:25:51.78,0:25:55.82,Default,,0000,0000,0000,,Тренинг кезінде мен көп пудинг жедім... →
Dialogue: 0,0:25:55.82,0:25:58.85,Default,,0000,0000,0000,,Күшік! Мен данышпанмын. иә?
Dialogue: 0,0:25:58.85,0:26:01.88,Default,,0000,0000,0000,,Мүмкін мен жаттығуды доғарғаным дұрыс шығар.
Dialogue: 0,0:26:01.88,0:26:04.91,Default,,0000,0000,0000,,Вахахаха! Ең жақсы, ең жақсы.
Dialogue: 0,0:26:04.91,0:26:06.91,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»
Dialogue: 0,0:26:10.97,0:26:13.97,Default,,0000,0000,0000,,Әке, сіз шынымен жаттығасыз ба?
Dialogue: 0,0:26:15.47,0:26:21.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory