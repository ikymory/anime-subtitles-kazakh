Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.16,0:00:12.23,Default,,0000,0000,0000,,<Күшті! Тым күшті Наппамен күрес. →
Dialogue: 0,0:00:12.23,0:00:17.28,Default,,0000,0000,0000,,Гокуның келуі жақын. →
Dialogue: 0,0:00:17.28,0:00:23.28,Default,,0000,0000,0000,,Бірақ ең ауыр дағдарыс аяусыз келді.
Dialogue: 0,0:00:25.36,0:00:29.36,Default,,0000,0000,0000,,Ууу... Өл!
Dialogue: 0,0:00:31.42,0:00:36.47,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:36.47,0:00:56.67,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:00:56.67,0:01:16.20,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:16.20,0:01:36.40,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:36.40,0:01:53.40,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:15.33,0:04:17.35,Default,,0000,0000,0000,,Өл!
Dialogue: 0,0:04:17.35,0:04:20.38,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:04:20.38,0:04:22.40,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:04:22.40,0:04:25.40,Default,,0000,0000,0000,,Уау! Ха~хахаха!
Dialogue: 0,0:04:27.45,0:04:29.47,Default,,0000,0000,0000,,Иә! →
Dialogue: 0,0:04:29.47,0:04:36.47,Default,,0000,0000,0000,,Гуа~!
Dialogue: 0,0:04:41.59,0:04:43.61,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:04:43.61,0:04:46.61,Default,,0000,0000,0000,,Хехехехе.
Dialogue: 0,0:04:50.68,0:04:52.68,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:59.77,0:05:02.80,Default,,0000,0000,0000,,Ах... Ах, Пиппи Пикколо-сан.
Dialogue: 0,0:05:02.80,0:05:05.80,Default,,0000,0000,0000,,Қаш, Гохан...
Dialogue: 0,0:05:07.18,0:05:10.21,Default,,0000,0000,0000,,Ах, а, а...
Dialogue: 0,0:05:10.21,0:05:12.23,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:05:12.23,0:05:17.28,Default,,0000,0000,0000,,Пип Пикколо-сан, сен маған неге көмектесесің...?
Dialogue: 0,0:05:17.28,0:05:23.34,Default,,0000,0000,0000,,Ni мен саған қашып кет дедім. Мен асығуым керек...
Dialogue: 0,0:05:23.34,0:05:25.36,Default,,0000,0000,0000,,Өлме.
Dialogue: 0,0:05:25.36,0:05:28.39,Default,,0000,0000,0000,,Әкем дереу келіп, қамқорлық жасайды.
Dialogue: 0,0:05:28.39,0:05:31.42,Default,,0000,0000,0000,,Өтінемін, өлме.
Dialogue: 0,0:05:31.42,0:05:36.47,Default,,0000,0000,0000,,Tsk! Ақымақ, өлтіру реті өзгерді, бірақ жарайды.
Dialogue: 0,0:05:36.47,0:05:38.47,Default,,0000,0000,0000,,Бұл екі жағдайда да бірдей.
Dialogue: 0,0:05:44.55,0:05:47.58,Default,,0000,0000,0000,,《Жалғыз qi кішірейіп барады. →
Dialogue: 0,0:05:47.58,0:05:50.58,Default,,0000,0000,0000,,Біреу өледі》
Dialogue: 0,0:05:54.65,0:05:59.70,Default,,0000,0000,0000,,Хаа ха ха ха ха.... →
Dialogue: 0,0:05:59.70,0:06:02.73,Default,,0000,0000,0000,,Менің өмірім ақыры аяқталатын сияқты. →
Dialogue: 0,0:06:02.73,0:06:05.93,Default,,0000,0000,0000,,Гоку уақытында үлгермеді ме? →
Dialogue: 0,0:06:05.93,0:06:10.14,Default,,0000,0000,0000,,Бірақ ең соңында Пикколо меннен Құдай ретінде асып түсті. →
Dialogue: 0,0:06:10.14,0:06:13.17,Default,,0000,0000,0000,,Уф, мен өте қуаныштымын...
Dialogue: 0,0:06:13.17,0:06:15.19,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:06:15.19,0:06:19.23,Default,,0000,0000,0000,,U~ Құдай...
Dialogue: 0,0:06:19.23,0:06:22.26,Default,,0000,0000,0000,,Қандай аянышты оқиға. →
Dialogue: 0,0:06:22.26,0:06:25.29,Default,,0000,0000,0000,,Ұлы жын патшасы Пиппи Пикколо→
Dialogue: 0,0:06:25.29,0:06:29.33,Default,,0000,0000,0000,,Баланы қорғау жиіркенішті. →
Dialogue: 0,0:06:29.33,0:06:31.35,Default,,0000,0000,0000,,Хе хе хе хе....
Dialogue: 0,0:06:31.35,0:06:33.35,Default,,0000,0000,0000,,Әй, аға!
Dialogue: 0,0:06:36.40,0:06:40.44,Default,,0000,0000,0000,,Гохан... Эй, менімен дұрыс сөйлескен →
Dialogue: 0,0:06:40.44,0:06:43.47,Default,,0000,0000,0000,,Жалғыз сен едің.
Dialogue: 0,0:06:43.47,0:06:47.51,Default,,0000,0000,0000,,《Бірақ әкем солай айтты. Пикколо мырза қайта дүниеге келді →
Dialogue: 0,0:06:47.51,0:06:51.55,Default,,0000,0000,0000,,Бұрынғыдай жаман адам емес сияқты.
Dialogue: 0,0:06:51.55,0:06:54.58,Default,,0000,0000,0000,,《Цк》 《Мен де солай ойлаймын. →
Dialogue: 0,0:06:54.58,0:06:57.61,Default,,0000,0000,0000,,Анам мен атам қорқып қалды. →
Dialogue: 0,0:06:57.61,0:07:02.66,Default,,0000,0000,0000,,Хмм... Бұл қулық. Көзіңді пайдаланба дедім.
Dialogue: 0,0:07:02.66,0:07:06.03,Default,,0000,0000,0000,,《Қызық болма. Мұндай уәде шайқаста орындала ма? 》
Dialogue: 0,0:07:06.03,0:07:11.08,Default,,0000,0000,0000,,《Бірақ, Пикколо мырза, мен сіздің жауыңыз емеспін》
Dialogue: 0,0:07:11.08,0:07:15.12,Default,,0000,0000,0000,,Мен сенімен бірге өткен жыл жаман болған жоқ...
Dialogue: 0,0:07:15.12,0:07:18.15,Default,,0000,0000,0000,,Ағай!
Dialogue: 0,0:07:18.15,0:07:22.19,Default,,0000,0000,0000,,Өлме, бар, бар, бар....
Dialogue: 0,0:07:22.19,0:07:27.24,Default,,0000,0000,0000,,Уау! Ағай!
Dialogue: 0,0:07:27.24,0:07:31.28,Default,,0000,0000,0000,,Попо мырза, маған еріңіз.
Dialogue: 0,0:07:31.28,0:07:33.30,Default,,0000,0000,0000,,Құдай~! →
Dialogue: 0,0:07:33.30,0:07:37.34,Default,,0000,0000,0000,,Құдай~!
Dialogue: 0,0:07:37.34,0:07:42.39,Default,,0000,0000,0000,,Ууууууууууууууууууу!
Dialogue: 0,0:07:42.39,0:07:45.42,Default,,0000,0000,0000,,Ах!?
Dialogue: 0,0:07:45.42,0:07:48.45,Default,,0000,0000,0000,,Иә? Қызық. Сіз мұны істеуге дайынсыз ба?
Dialogue: 0,0:07:48.45,0:07:50.47,Default,,0000,0000,0000,,Сиқырлы жарқыл!
Dialogue: 0,0:07:50.47,0:07:53.50,Default,,0000,0000,0000,,Иә? Уау, бұл керемет.
Dialogue: 0,0:07:53.50,0:07:58.55,Default,,0000,0000,0000,,Ki~.
Dialogue: 0,0:07:58.55,0:08:01.58,Default,,0000,0000,0000,,700 1,200…. →
Dialogue: 0,0:08:01.58,0:08:04.61,Default,,0000,0000,0000,,2,400.
Dialogue: 0,0:08:04.61,0:08:08.99,Default,,0000,0000,0000,,Жауынгерлік қуат 2800!
Dialogue: 0,0:08:08.99,0:08:11.02,Default,,0000,0000,0000,,Күтілгендей, бұл жігіттердің жауынгерлік күші күрт өзгереді.
Dialogue: 0,0:08:11.02,0:08:13.04,Default,,0000,0000,0000,,2,800?
Dialogue: 0,0:08:13.04,0:08:15.06,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:08:15.06,0:08:19.10,Default,,0000,0000,0000,,Нуа~!
Dialogue: 0,0:08:19.10,0:08:21.12,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:08:21.12,0:08:23.14,Default,,0000,0000,0000,,Хахахаха.
Dialogue: 0,0:08:23.14,0:08:25.16,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:08:25.16,0:08:29.20,Default,,0000,0000,0000,,Кішкентай жігіт болсаң да, сен ғажап істер жасай аласың.
Dialogue: 0,0:08:29.20,0:08:33.24,Default,,0000,0000,0000,,Хехехехе менің қолым аздап ұйып қалды.
Dialogue: 0,0:08:33.24,0:08:37.28,Default,,0000,0000,0000,,Иә? Менің жауынгерлік қабілетім күрт төмендеді.
Dialogue: 0,0:08:37.28,0:08:41.32,Default,,0000,0000,0000,,Бар күшіңді сарп еткен сияқтысың.
Dialogue: 0,0:08:41.32,0:08:44.35,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:08:44.35,0:08:49.35,Default,,0000,0000,0000,,Пиппи Пикколо-сан, кешіріңіз, бірақ мен жауға шабуыл жасай алмадым.
Dialogue: 0,0:08:51.42,0:08:53.44,Default,,0000,0000,0000,,Гохан, жүгір! Жүгір!
Dialogue: 0,0:08:53.44,0:08:59.50,Default,,0000,0000,0000,,Хехехе кішкентай, мен сені осы жолы о дүниеге жіберемін.
Dialogue: 0,0:08:59.50,0:09:04.55,Default,,0000,0000,0000,,Менің енді қашуға күшім жоқ.
Dialogue: 0,0:09:04.55,0:09:08.92,Default,,0000,0000,0000,,Хахахаха мен сықырлап басып қалдым →
Dialogue: 0,0:09:08.92,0:09:10.94,Default,,0000,0000,0000,,Ұлымды көргенде... хахаха! →
Dialogue: 0,0:09:10.94,0:09:12.96,Default,,0000,0000,0000,,Мен Какароттың жүзін көруді асыға күтемін!
Dialogue: 0,0:09:12.96,0:09:14.98,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:09:14.98,0:09:17.01,Default,,0000,0000,0000,,Иә? (Вегета) Иә?
Dialogue: 0,0:09:17.01,0:09:21.01,Default,,0000,0000,0000,,А, а... ой!?
Dialogue: 0,0:09:25.09,0:09:29.09,Default,,0000,0000,0000,,Иә? Әй, Судзитун!?
Dialogue: 0,0:09:37.21,0:09:39.23,Default,,0000,0000,0000,,Әй, әке.
Dialogue: 0,0:09:39.23,0:09:43.27,Default,,0000,0000,0000,,Ах... Гоку.
Dialogue: 0,0:09:43.27,0:09:51.35,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:09:51.35,0:09:53.35,Default,,0000,0000,0000,,Ол ақырында пайда болды.
Dialogue: 0,0:09:56.40,0:09:59.43,Default,,0000,0000,0000,,Неге келдің осынша жолмен, Какарот?
Dialogue: 0,0:09:59.43,0:10:02.46,Default,,0000,0000,0000,,Сенің бізді жеңуге тырысып жатқаныңа сене алар емеспін→
Dialogue: 0,0:10:02.46,0:10:06.46,Default,,0000,0000,0000,,Сенің мұнда ақымақ әзіл айту үшін келмегеніңе сенімдімін.
Dialogue: 0,0:10:10.87,0:10:12.87,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:15.92,0:10:18.95,Default,,0000,0000,0000,,Пикколо….
Dialogue: 0,0:10:18.95,0:10:21.95,Default,,0000,0000,0000,,Пикколо-сан мені қорғап өлді.
Dialogue: 0,0:10:24.01,0:10:26.01,Default,,0000,0000,0000,,Иә!?
Dialogue: 0,0:10:28.05,0:10:30.05,Default,,0000,0000,0000,,《Тяньцзинь тағамы…》
Dialogue: 0,0:10:34.11,0:10:36.13,Default,,0000,0000,0000,,Ямча….
Dialogue: 0,0:10:36.13,0:10:41.18,Default,,0000,0000,0000,,Хехехехе ақымақ достарыңның бәрі өлгеніне таң қалдың ба?
Dialogue: 0,0:10:41.18,0:10:43.20,Default,,0000,0000,0000,,Дұрыс, тағы бір →
Dialogue: 0,0:10:43.20,0:10:46.23,Default,,0000,0000,0000,,Бөлінген чибилер болса керек.
Dialogue: 0,0:10:46.23,0:10:48.25,Default,,0000,0000,0000,,Иә!?
Dialogue: 0,0:10:48.25,0:10:52.29,Default,,0000,0000,0000,,Ауыр адамға жараспаса да, оның біраз күші бар еді.
Dialogue: 0,0:10:52.29,0:10:57.34,Default,,0000,0000,0000,,《Көрдім, тіпті гёза да... Құдай да. →
Dialogue: 0,0:10:57.34,0:11:00.37,Default,,0000,0000,0000,,Қарғыс атсын ~》
Dialogue: 0,0:11:00.37,0:11:06.77,Default,,0000,0000,0000,,Хехе, қайғырудың қажеті жоқ. Жақында сіз бізге қосыласыз. →
Dialogue: 0,0:11:06.77,0:11:11.77,Default,,0000,0000,0000,,Тірілсем де, Нококо шықты.
Dialogue: 0,0:11:13.84,0:11:16.87,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:11:16.87,0:11:20.91,Default,,0000,0000,0000,,Жауынгерлік күш тез өсуде.
Dialogue: 0,0:11:20.91,0:11:23.94,Default,,0000,0000,0000,,Иә? Хехехе.
Dialogue: 0,0:11:23.94,0:11:29.00,Default,,0000,0000,0000,,Не? Сіз өлуге дайынсыз ба?
Dialogue: 0,0:11:29.00,0:11:31.02,Default,,0000,0000,0000,,Бұл сәлемдесу!
Dialogue: 0,0:11:31.02,0:11:33.04,Default,,0000,0000,0000,,Тея!
Dialogue: 0,0:11:33.04,0:11:36.07,Default,,0000,0000,0000,,《Тез! 》 Иә!?
Dialogue: 0,0:11:36.07,0:11:38.07,Default,,0000,0000,0000,,Гохан осылай.
Dialogue: 0,0:11:40.11,0:11:43.14,Default,,0000,0000,0000,,Криллин. Гоку.
Dialogue: 0,0:11:43.14,0:11:48.19,Default,,0000,0000,0000,,Кешіктіргенім үшін кешіріңіз. Екеуің де шыдамды болдыңдар.
Dialogue: 0,0:11:48.19,0:11:51.22,Default,,0000,0000,0000,,Осының жартысын жеп қойыңыз.
Dialogue: 0,0:11:51.22,0:11:56.27,Default,,0000,0000,0000,,Не? Бұл сензу бұршақтары емес пе? Менде әлі де Карин-сама болды.
Dialogue: 0,0:11:56.27,0:11:58.29,Default,,0000,0000,0000,,Иә. Бұл соңғы дән.
Dialogue: 0,0:11:58.29,0:12:02.33,Default,,0000,0000,0000,,Ондай жағдайда оны жеу керек.
Dialogue: 0,0:12:02.33,0:12:05.52,Default,,0000,0000,0000,,Жарайды, мен тамақтанып қойдым.
Dialogue: 0,0:12:05.52,0:12:09.73,Default,,0000,0000,0000,,Жоқ, жағдайға байланысты сақтаңыз.
Dialogue: 0,0:12:09.73,0:12:13.77,Default,,0000,0000,0000,,Уа, біздің жақсаруымызға көмектеспейді.
Dialogue: 0,0:12:13.77,0:12:15.79,Default,,0000,0000,0000,,Көп уайымдамаңыз.
Dialogue: 0,0:12:15.79,0:12:20.84,Default,,0000,0000,0000,,Жемесең, лақтырып тастаймын. Қараңдар!
Dialogue: 0,0:12:20.84,0:12:22.86,Default,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:12:22.86,0:12:26.90,Default,,0000,0000,0000,,Гохан сен де. Уф иә.
Dialogue: 0,0:12:26.90,0:12:28.90,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:12:30.94,0:12:34.98,Default,,0000,0000,0000,,Криллин, сен шынымен қолыңды көтердің. Мен оны түсіндім.
Dialogue: 0,0:12:34.98,0:12:37.01,Default,,0000,0000,0000,,Бұл менің ниетім еді, бірақ бұл жақсы емес.
Dialogue: 0,0:12:37.01,0:12:40.04,Default,,0000,0000,0000,,Бұл оларда жұмыс істемейді. Бұл тым күшті.
Dialogue: 0,0:12:40.04,0:12:44.08,Default,,0000,0000,0000,,Барлығы... Мен бәрін өлуге рұқсат етемін.
Dialogue: 0,0:12:44.08,0:12:49.13,Default,,0000,0000,0000,,Гохан Сіз де дұрыс түсінбедіңіз. Мен жақсы жаттықтым.
Dialogue: 0,0:12:49.13,0:12:53.17,Default,,0000,0000,0000,,Иә, мені Пикколо мырза оқытты.
Dialogue: 0,0:12:53.17,0:12:55.19,Default,,0000,0000,0000,,Бірақ мен ештеңе істей алмадым.
Dialogue: 0,0:12:55.19,0:12:58.22,Default,,0000,0000,0000,,Пикколо-сан, егер сен өлсең, Айдаһар шарлары да жоғалады→
Dialogue: 0,0:12:58.22,0:13:03.27,Default,,0000,0000,0000,,Қайта пайдалану мүмкін емес. Ешкім тірі оралмайды.
Dialogue: 0,0:13:03.27,0:13:07.64,Default,,0000,0000,0000,,Жауды бірге құлатайық. Гоку қосылады деп үміттенемін →
Dialogue: 0,0:13:07.64,0:13:10.67,Default,,0000,0000,0000,,Бір адамға бірдеңе болатын шығар.
Dialogue: 0,0:13:10.67,0:13:15.72,Default,,0000,0000,0000,,Эй, Гоку, сен Кай патша деген таңғажайып адаммен жаттығасың, солай ма?
Dialogue: 0,0:13:15.72,0:13:19.76,Default,,0000,0000,0000,,Ах. Бірақ мен олармен жалғыз күресемін.
Dialogue: 0,0:13:19.76,0:13:23.80,Default,,0000,0000,0000,,Балалар, аулақ жүріңдер, тамашалаңдар. Ортаға түсіп қалмаңыз.
Dialogue: 0,0:13:23.80,0:13:25.82,Default,,0000,0000,0000,,Эй, бір ғана адам!?→
Dialogue: 0,0:13:25.82,0:13:28.85,Default,,0000,0000,0000,,Гоку қаншалықты қисынсыз болса да. →
Dialogue: 0,0:13:28.85,0:13:32.89,Default,,0000,0000,0000,,Олардың күші біздің қиялымыздан да асып түседі.
Dialogue: 0,0:13:32.89,0:13:35.92,Default,,0000,0000,0000,,Бұл рас, әке.
Dialogue: 0,0:13:35.92,0:13:38.95,Default,,0000,0000,0000,,Иә!? Иә?
Dialogue: 0,0:13:38.95,0:13:41.95,Default,,0000,0000,0000,,Куу… Куу~.
Dialogue: 0,0:13:45.02,0:13:49.06,Default,,0000,0000,0000,,Ku~!
Dialogue: 0,0:13:49.06,0:13:52.09,Default,,0000,0000,0000,,Кум Гоку. Эй әке!
Dialogue: 0,0:13:52.09,0:13:57.14,Default,,0000,0000,0000,,Ах! Оны Гокуға қалдырыңыз. Өйткені...
Dialogue: 0,0:13:57.14,0:14:02.19,Default,,0000,0000,0000,,Мен Гокудың мұндай ашуланғанын ешқашан көрген емеспін. →
Dialogue: 0,0:14:02.19,0:14:05.22,Default,,0000,0000,0000,,Ой, бізге кіруге орын жоқ.
Dialogue: 0,0:14:05.22,0:14:11.28,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:14:11.28,0:14:14.31,Default,,0000,0000,0000,,Сәлем.
Dialogue: 0,0:14:14.31,0:14:18.35,Default,,0000,0000,0000,,Не? Маған бұл жағы ұнамайды.
Dialogue: 0,0:14:18.35,0:14:22.39,Default,,0000,0000,0000,,Хехехехе сені оңай өлтіргенімді қалайсың ба?
Dialogue: 0,0:14:22.39,0:14:26.43,Default,,0000,0000,0000,,Мені кешіріңіздер, балалар...!
Dialogue: 0,0:14:26.43,0:14:29.43,Default,,0000,0000,0000,,Ах~!
Dialogue: 0,0:15:45.22,0:15:49.22,Default,,0000,0000,0000,,Ах~!
Dialogue: 0,0:15:53.30,0:15:55.32,Default,,0000,0000,0000,,О, әке, бұл керемет.
Dialogue: 0,0:15:55.32,0:16:00.37,Default,,0000,0000,0000,,Жауынгерлік қуат 7 000 8 000….
Dialogue: 0,0:16:00.37,0:16:02.37,Default,,0000,0000,0000,,Ақымақ!
Dialogue: 0,0:16:04.41,0:16:06.43,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:16:06.43,0:16:08.43,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:16:13.50,0:16:15.52,Default,,0000,0000,0000,,Вегета!
Dialogue: 0,0:16:15.52,0:16:19.56,Default,,0000,0000,0000,,Какароттың жауынгерлік күші қандай?
Dialogue: 0,0:16:19.56,0:16:22.59,Default,,0000,0000,0000,,Бұл 8000-нан асады.
Dialogue: 0,0:16:22.59,0:16:27.64,Default,,0000,0000,0000,,8000-нан астам!? Қандай да бір қателік болуы керек. Ол дұрыс жұмыс істемейді.
Dialogue: 0,0:16:27.64,0:16:31.68,Default,,0000,0000,0000,,Уайымдамаңыз, мен сізге Kaioken қолданбасын әлі қолдана алмаймын.
Dialogue: 0,0:16:31.68,0:16:34.71,Default,,0000,0000,0000,,Кайокен!? Шулы!
Dialogue: 0,0:16:34.71,0:16:39.93,Default,,0000,0000,0000,,Мен Наппа-самаға тең келе алмаймын! →
Dialogue: 0,0:16:39.93,0:16:42.12,Default,,0000,0000,0000,,Иә! Урья~!
Dialogue: 0,0:16:42.12,0:16:44.14,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:16:44.14,0:16:46.16,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:16:46.16,0:16:48.18,Default,,0000,0000,0000,,Не!? Қарғыс атқыр...
Dialogue: 0,0:16:48.18,0:16:52.22,Default,,0000,0000,0000,,Сіз мұны қалай жасадыңыз? Дәл қазір.
Dialogue: 0,0:16:52.22,0:16:59.29,Default,,0000,0000,0000,,Уф уф... мен білмей тұрып қайттым...
Dialogue: 0,0:16:59.29,0:17:02.32,Default,,0000,0000,0000,,Кел, сен!
Dialogue: 0,0:17:02.32,0:17:05.35,Default,,0000,0000,0000,,Егер сіз тәкаппар болсаңыз, бұл үлкен мәселе емес.
Dialogue: 0,0:17:05.35,0:17:09.39,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:17:09.39,0:17:12.42,Default,,0000,0000,0000,,Эй, сен мені маңызды емес деп ойлайсың ба!?
Dialogue: 0,0:17:12.42,0:17:15.45,Default,,0000,0000,0000,,Дұрыс, мен дәл қазір шабуылдан түсіндім.
Dialogue: 0,0:17:15.45,0:17:18.48,Default,,0000,0000,0000,,Күрсіну….
Dialogue: 0,0:17:18.48,0:17:24.54,Default,,0000,0000,0000,,Маған қалай білгеніңізді айтып бере аласыз ба?
Dialogue: 0,0:17:24.54,0:17:26.56,Default,,0000,0000,0000,,Оля!
Dialogue: 0,0:17:26.56,0:17:28.56,Default,,0000,0000,0000,,Дея~!
Dialogue: 0,0:17:31.61,0:17:33.63,Default,,0000,0000,0000,,О!
Dialogue: 0,0:17:33.63,0:17:36.66,Default,,0000,0000,0000,,Әжеміздің бір ескі танысы шығар. Ах, дұрыс.
Dialogue: 0,0:17:36.66,0:17:38.68,Default,,0000,0000,0000,,Урья~!
Dialogue: 0,0:17:38.68,0:17:44.68,Default,,0000,0000,0000,,Біртүрлі. Оның жауынгерлік күші Радицпен шайқасқан кезден мүлдем басқаша.
Dialogue: 0,0:17:46.09,0:17:48.11,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:17:48.11,0:17:50.13,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:17:50.13,0:17:53.16,Default,,0000,0000,0000,,Осы жолмен! Ах!
Dialogue: 0,0:17:53.16,0:17:55.18,Default,,0000,0000,0000,,Жақсы….
Dialogue: 0,0:17:55.18,0:17:59.22,Default,,0000,0000,0000,,Көрдіңіз бе? Әкеңнің қимылдары...
Dialogue: 0,0:17:59.22,0:18:03.22,Default,,0000,0000,0000,,Жоқ. Бірақ бұл таңқаларлық.
Dialogue: 0,0:18:08.31,0:18:11.34,Default,,0000,0000,0000,,《Сіз нені айтып тұрсыз? Какароттағы. →
Dialogue: 0,0:18:11.34,0:18:15.38,Default,,0000,0000,0000,,Қысқа уақыт ішінде сонша күш-қуатты қалай жинадың!?
Dialogue: 0,0:18:15.38,0:18:19.42,Default,,0000,0000,0000,,Иә!? Торя~!
Dialogue: 0,0:18:19.42,0:18:24.47,Default,,0000,0000,0000,,Нұх!? Ооо….
Dialogue: 0,0:18:24.47,0:18:27.50,Default,,0000,0000,0000,,Ух... Ах!
Dialogue: 0,0:18:27.50,0:18:31.54,Default,,0000,0000,0000,,Торя~! О...
Dialogue: 0,0:18:31.54,0:18:37.60,Default,,0000,0000,0000,,Ааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:18:37.60,0:18:40.97,Default,,0000,0000,0000,,Қазіргісі - Джозаның кек.
Dialogue: 0,0:18:40.97,0:18:44.01,Default,,0000,0000,0000,,Гугугу….
Dialogue: 0,0:18:44.01,0:18:52.09,Default,,0000,0000,0000,,Хаа хаа ха ха.... →
Dialogue: 0,0:18:52.09,0:18:55.12,Default,,0000,0000,0000,,Чикусо! →
Dialogue: 0,0:18:55.12,0:18:58.15,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:18:58.15,0:19:01.15,Default,,0000,0000,0000,,Ямчаның ызасы!
Dialogue: 0,0:19:06.23,0:19:10.27,Default,,0000,0000,0000,,Өзім!
Dialogue: 0,0:19:10.27,0:19:14.31,Default,,0000,0000,0000,,Қарғыс атсын... қарғыс атқыр бала!
Dialogue: 0,0:19:14.31,0:19:17.31,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:19:19.36,0:19:22.39,Default,,0000,0000,0000,,Дея~!
Dialogue: 0,0:19:22.39,0:19:25.42,Default,,0000,0000,0000,,Мұндай нәрседен жалтарудың қажеті жоқ.
Dialogue: 0,0:19:25.42,0:19:28.45,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:19:28.45,0:19:30.45,Default,,0000,0000,0000,,Уау! Апыр-ай!
Dialogue: 0,0:19:34.51,0:19:40.90,Default,,0000,0000,0000,,Хаха ха ха....
Dialogue: 0,0:19:40.90,0:19:42.90,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:19:50.00,0:19:52.02,Default,,0000,0000,0000,,А, не!?
Dialogue: 0,0:19:52.02,0:19:56.06,Default,,0000,0000,0000,,Сен оны тек рухыңмен өшірдің!
Dialogue: 0,0:19:56.06,0:19:59.09,Default,,0000,0000,0000,,Қарғыс атсын.
Dialogue: 0,0:19:59.09,0:20:02.12,Default,,0000,0000,0000,,Бұл жігіт Теншинханның кекшесі!
Dialogue: 0,0:20:02.12,0:20:04.14,Default,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:20:04.14,0:20:08.18,Default,,0000,0000,0000,,Какарот неге сонша күшке ие!
Dialogue: 0,0:20:08.18,0:20:10.20,Default,,0000,0000,0000,,Не!?
Dialogue: 0,0:20:10.20,0:20:13.23,Default,,0000,0000,0000,,Ал бұл Пикколоның өшпенділігі!
Dialogue: 0,0:20:13.23,0:20:17.23,Default,,0000,0000,0000,,Гуа~! Шүкір~!
Dialogue: 0,0:20:24.34,0:20:27.34,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:20:34.44,0:20:38.48,Default,,0000,0000,0000,,Керемет, шынымен де керемет, Гоку!
Dialogue: 0,0:20:38.48,0:20:40.48,Default,,0000,0000,0000,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:20:48.91,0:20:52.95,Default,,0000,0000,0000,,Қазір~! Чикусо! →
Dialogue: 0,0:20:52.95,0:20:59.02,Default,,0000,0000,0000,,Хаа хаа ха ха.... →
Dialogue: 0,0:20:59.02,0:21:02.05,Default,,0000,0000,0000,,Чикусо!
Dialogue: 0,0:21:02.05,0:21:04.07,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:21:04.07,0:21:07.10,Default,,0000,0000,0000,,Мен көрдім. Оның қаншалықты қиын екені таңқаларлық.
Dialogue: 0,0:21:07.10,0:21:10.13,Default,,0000,0000,0000,,Мен беделді отбасынан шыққан элиталық жауынгермін. →
Dialogue: 0,0:21:10.13,0:21:14.17,Default,,0000,0000,0000,,Сіз сияқты төмен дәрежелі жауынгердің мазақтауынан шаршадыңыз ба?
Dialogue: 0,0:21:14.17,0:21:18.21,Default,,0000,0000,0000,,Мен сені кешірмеймін, өлтіремін!
Dialogue: 0,0:21:18.21,0:21:22.25,Default,,0000,0000,0000,,Ақымақ! Басыңызды суытыңыз. Сабырмен бағаласаңыз →
Dialogue: 0,0:21:22.25,0:21:25.28,Default,,0000,0000,0000,,Қолға түсетін қарсылас емес шығар. →
Dialogue: 0,0:21:25.28,0:21:27.28,Default,,0000,0000,0000,,Наппа, сабыр ет!
Dialogue: 0,0:21:31.34,0:21:36.39,Default,,0000,0000,0000,,Хаха мен көрдім. Рахмет сізге Вегета. →
Dialogue: 0,0:21:36.39,0:21:39.39,Default,,0000,0000,0000,,күрсіну.
Dialogue: 0,0:21:41.78,0:21:44.81,Default,,0000,0000,0000,,Сізге рахмет, мен ояндым.
Dialogue: 0,0:21:44.81,0:21:46.83,Default,,0000,0000,0000,,《Тч, бір клеткалы ақымақ. →
Dialogue: 0,0:21:46.83,0:21:50.87,Default,,0000,0000,0000,,Осы қарқынмен менің кезегім келетін сияқты.
Dialogue: 0,0:21:50.87,0:21:54.91,Default,,0000,0000,0000,,Менің басыма қан жүгіргені рас. →
Dialogue: 0,0:21:54.91,0:21:59.96,Default,,0000,0000,0000,,Енді сіздің шынайы әлеуетіңізді көрсететін уақыт. Дайынсыз ба? Бұл Какарот.
Dialogue: 0,0:21:59.96,0:22:02.99,Default,,0000,0000,0000,,Мен оны асыға күтемін.
Dialogue: 0,0:22:02.99,0:22:05.02,Default,,0000,0000,0000,,Хехе, сен итермелеп жатырсың.
Dialogue: 0,0:22:05.02,0:22:07.04,Default,,0000,0000,0000,,《Бұл батылдық туралы емес. →
Dialogue: 0,0:22:07.04,0:22:11.04,Default,,0000,0000,0000,,Оның жан тыныштығы мен абсолютті сенімділігі бар》
Dialogue: 0,0:22:24.21,0:22:28.25,Default,,0000,0000,0000,,Кум Гоку…. әке….
Dialogue: 0,0:22:28.25,0:22:36.33,Default,,0000,0000,0000,,Гуа~!
Dialogue: 0,0:22:36.33,0:22:40.70,Default,,0000,0000,0000,,I~. мен~.
Dialogue: 0,0:22:40.70,0:22:44.74,Default,,0000,0000,0000,,Ум! →
Dialogue: 0,0:22:44.74,0:22:48.78,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:22:48.78,0:22:52.82,Default,,0000,0000,0000,,Сендер, үндемеңдер!➡
Dialogue: 0,0:22:52.82,0:22:56.82,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:22:59.89,0:23:02.92,Default,,0000,0000,0000,,Мен оны көріп тұрмын! →
Dialogue: 0,0:23:02.92,0:23:04.94,Default,,0000,0000,0000,,Ах! →
Dialogue: 0,0:23:04.94,0:23:06.96,Default,,0000,0000,0000,,Иә! Ха!
Dialogue: 0,0:23:06.96,0:23:10.00,Default,,0000,0000,0000,,Уау! →
Dialogue: 0,0:23:10.00,0:23:13.03,Default,,0000,0000,0000,,Урья~! Торя~!
Dialogue: 0,0:23:13.03,0:23:17.07,Default,,0000,0000,0000,,Да-да-да-да...!
Dialogue: 0,0:23:17.07,0:23:20.10,Default,,0000,0000,0000,,Ой, қазір жағдай әлдеқайда жақсы, солай емес пе?
Dialogue: 0,0:23:20.10,0:23:25.15,Default,,0000,0000,0000,,Хехехе, өзіңді жақсы сезінесің бе? →
Dialogue: 0,0:23:25.15,0:23:29.19,Default,,0000,0000,0000,,Мен анау қарғыс атқыр сөзді тоқтатамын.
Dialogue: 0,0:23:29.19,0:23:31.21,Default,,0000,0000,0000,,Міне.
Dialogue: 0,0:23:31.21,0:23:34.24,Default,,0000,0000,0000,,Ка~! →
Dialogue: 0,0:23:34.24,0:23:37.27,Default,,0000,0000,0000,,Ta~! Толқындар!
Dialogue: 0,0:23:37.27,0:23:40.27,Default,,0000,0000,0000,,Хаа~!
Dialogue: 0,0:23:42.65,0:23:45.68,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:23:45.68,0:23:49.72,Default,,0000,0000,0000,,Жақсы... Не деген →
Dialogue: 0,0:23:49.72,0:23:52.75,Default,,0000,0000,0000,,Ол соншалықты жақын қашықтықтан әп-сәтте қысқарды!
Dialogue: 0,0:23:52.75,0:23:56.79,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:23:56.79,0:23:59.82,Default,,0000,0000,0000,,Ах... Ах!
Dialogue: 0,0:23:59.82,0:24:03.86,Default,,0000,0000,0000,,Уау~ Дәл қазір жеп қойсам, қорқынышты болар еді.
Dialogue: 0,0:24:03.86,0:24:09.92,Default,,0000,0000,0000,,Ақымақ! Бұл менің ең жақсы шеберлігім. Мен оны итеріп жібердім.
Dialogue: 0,0:24:09.92,0:24:12.95,Default,,0000,0000,0000,,Ол өте қатал жігіт.
Dialogue: 0,0:24:12.95,0:24:15.98,Default,,0000,0000,0000,,Мені Камехамеха толқыны соғуы керек еді.
Dialogue: 0,0:24:15.98,0:24:17.00,Default,,0000,0000,0000,,Мұның соңы жоқ сияқты.
Dialogue: 0,0:24:17.00,0:24:20.03,Default,,0000,0000,0000,,Жетеді! Түс, Наппа. →
Dialogue: 0,0:24:20.03,0:24:23.06,Default,,0000,0000,0000,,Сіз оны түсіне алмайсыз. Мен онымен айналысамын.
Dialogue: 0,0:24:23.06,0:24:25.08,Default,,0000,0000,0000,,Не!?
Dialogue: 0,0:24:25.08,0:24:29.12,Default,,0000,0000,0000,,Ол аянышты. Мен бұл Какаротқа қарсы болады деп ешқашан күтпедім →
Dialogue: 0,0:24:29.12,0:24:32.15,Default,,0000,0000,0000,,Қозғалу үшін менің жолымнан шығуыма ешқандай себеп жоқ.
Dialogue: 0,0:24:32.15,0:24:35.18,Default,,0000,0000,0000,,Сол жігіт ақыры шыға ма?
Dialogue: 0,0:24:35.18,0:24:38.21,Default,,0000,0000,0000,,Одан анау үлкен жігіт те қорықты.
Dialogue: 0,0:24:38.21,0:24:43.21,Default,,0000,0000,0000,,<Вегетамен шешуші шайқастың уақыты келді ме?>
Dialogue: 0,0:24:46.62,0:24:51.67,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:51.67,0:25:11.87,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:11.87,0:25:31.07,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:31.07,0:25:44.07,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:48.24,0:25:51.27,Default,,0000,0000,0000,,Сәлем, Гоку. Ол тіпті өз халқына шабуыл жасады.
Dialogue: 0,0:25:51.27,0:25:54.30,Default,,0000,0000,0000,,Алғыс айт, мен, супер элита, →
Dialogue: 0,0:25:54.30,0:25:57.33,Default,,0000,0000,0000,,Мен сен сияқты бейшараға серіктес боламын.
Dialogue: 0,0:25:57.33,0:26:01.37,Default,,0000,0000,0000,,Хаха Астарлылар элитадан асып түсетін кездер болатынына сенімдімін.
Dialogue: 0,0:26:01.37,0:26:05.41,Default,,0000,0000,0000,,Хмф, мен саған тек күш-жігермен жеңе алмайтын қабырғаны көрсетемін!
Dialogue: 0,0:26:05.41,0:26:07.41,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»
Dialogue: 0,0:26:11.47,0:26:13.47,Default,,0000,0000,0000,,Жүр! әке.
Dialogue: 0,0:26:14.97,0:26:20.97,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory