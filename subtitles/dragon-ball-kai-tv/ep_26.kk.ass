Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:12.50,0:00:18.56,Default,,0000,0000,0000,,<Криллин ақсақалдан Айдаһар шарын алды. →
Dialogue: 0,0:00:18.56,0:00:25.56,Default,,0000,0000,0000,,Гохан Вегета жасырғанын қорғау үшін де қозғалды.
Dialogue: 0,0:00:27.65,0:00:30.68,Default,,0000,0000,0000,,<Ал Фриза және оның қалған бесеуі бар достары →
Dialogue: 0,0:00:30.68,0:00:34.68,Default,,0000,0000,0000,,Ұсталған Вегетаның денесі＞
Dialogue: 0,0:00:37.75,0:00:42.80,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:42.80,0:01:02.00,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:02.00,0:01:22.54,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:22.54,0:01:42.74,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:42.74,0:01:59.74,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:25.70,0:04:30.75,Default,,0000,0000,0000,,Бұл өте аз зиян. Бұл ұзақ уақытқа созылуы мүмкін. →
Dialogue: 0,0:04:30.75,0:04:34.79,Default,,0000,0000,0000,,Өтінемін, есін жимасаңыз→
Dialogue: 0,0:04:34.79,0:04:38.83,Default,,0000,0000,0000,,Өйткені Фриеза-саманың соққысын алатын адам менмін. →
Dialogue: 0,0:04:38.83,0:04:44.83,Default,,0000,0000,0000,,Бұл жақсы. Енді оның оянғанын күту ғана қалды.
Dialogue: 0,0:04:47.92,0:04:49.94,Default,,0000,0000,0000,,Ах!?→
Dialogue: 0,0:04:49.94,0:04:52.94,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:04:54.99,0:04:57.02,Default,,0000,0000,0000,,Сіз қалай ойлайсыз? Вегета - бұл.
Dialogue: 0,0:04:57.02,0:05:00.05,Default,,0000,0000,0000,,Күрсін... Жақында есін жинайды.
Dialogue: 0,0:05:00.05,0:05:05.10,Default,,0000,0000,0000,,Бұл жақсы. (Зарбон) Иә, иә...
Dialogue: 0,0:05:05.10,0:05:07.12,Default,,0000,0000,0000,,Гү!
Dialogue: 0,0:05:07.12,0:05:10.15,Default,,0000,0000,0000,,Не? Қазіргі жарылыс туралы не деуге болады?
Dialogue: 0,0:05:10.15,0:05:12.15,Default,,0000,0000,0000,,Мүмкін емес...
Dialogue: 0,0:05:16.54,0:05:20.58,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:05:20.58,0:05:24.62,Default,,0000,0000,0000,,Менің төзімділігімді бағаламаған сияқтысыз.
Dialogue: 0,0:05:24.62,0:05:27.62,Default,,0000,0000,0000,,Иә? Ал...
Dialogue: 0,0:05:30.68,0:05:32.70,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:05:32.70,0:05:35.73,Default,,0000,0000,0000,,Шүкір, бұл емхана ғой.
Dialogue: 0,0:05:35.73,0:05:37.73,Default,,0000,0000,0000,,Зарбон-сан, тезірек!
Dialogue: 0,0:05:41.79,0:05:45.83,Default,,0000,0000,0000,,Мен қашып кеттім. (Фриза) Не?
Dialogue: 0,0:05:45.83,0:05:48.86,Default,,0000,0000,0000,,《Жақсы! Фриза да менімен бірге》
Dialogue: 0,0:05:48.86,0:05:52.90,Default,,0000,0000,0000,,Асығыңыз! Мен жақында жетемін. (Зарбон) Эй, мен!
Dialogue: 0,0:05:52.90,0:05:55.93,Default,,0000,0000,0000,,Асығыңыз! Мен оны не болса да табамын. →
Dialogue: 0,0:05:55.93,0:05:58.96,Default,,0000,0000,0000,,Сіз әлі алысқа бармаған шығарсыз.
Dialogue: 0,0:05:58.96,0:06:02.96,Default,,0000,0000,0000,,《Сен ақымақ. Ұсталу оңай болды.
Dialogue: 0,0:06:07.05,0:06:11.26,Default,,0000,0000,0000,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:06:11.26,0:06:14.45,Default,,0000,0000,0000,,Хехехехехехе.
Dialogue: 0,0:06:14.45,0:06:18.49,Default,,0000,0000,0000,,《Құрметті Фриеза-сама, дәл осы сәтте →
Dialogue: 0,0:06:18.49,0:06:21.52,Default,,0000,0000,0000,,Сіздің уақытыңыз аяқталды. →
Dialogue: 0,0:06:21.52,0:06:24.55,Default,,0000,0000,0000,,Сіздің қымбатты Вегетадан》
Dialogue: 0,0:06:24.55,0:06:29.60,Default,,0000,0000,0000,,Кук кук кук.
Dialogue: 0,0:06:29.60,0:06:31.60,Default,,0000,0000,0000,,Мен жеңдім!
Dialogue: 0,0:06:37.68,0:06:41.68,Default,,0000,0000,0000,,Иә? Хмм….
Dialogue: 0,0:06:44.75,0:06:49.75,Default,,0000,0000,0000,,Ерм... осы жерде.
Dialogue: 0,0:06:54.85,0:06:58.89,Default,,0000,0000,0000,,Ах...
Dialogue: 0,0:06:58.89,0:07:11.69,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:07:11.69,0:07:14.69,Default,,0000,0000,0000,,Бұл қорқынышты.
Dialogue: 0,0:07:18.43,0:07:21.43,Default,,0000,0000,0000,,Мен мұны Вегета жасағанына сенімдімін.
Dialogue: 0,0:07:23.48,0:07:26.51,Default,,0000,0000,0000,,Бұл қайда! Бұл қайда!
Dialogue: 0,0:07:26.51,0:07:29.54,Default,,0000,0000,0000,,Вегета қайда қашып кетті?
Dialogue: 0,0:07:29.54,0:07:32.57,Default,,0000,0000,0000,,Бұлай тез құтылудың жолы жоқ.
Dialogue: 0,0:07:32.57,0:07:34.59,Default,,0000,0000,0000,,Бір жерде жасырынып жатқан шығар.
Dialogue: 0,0:07:34.59,0:07:37.62,Default,,0000,0000,0000,,Сіз оны әлі тапмадыңыз ба, Зарбон мырза?
Dialogue: 0,0:07:37.62,0:07:40.65,Default,,0000,0000,0000,,Қарғыс атсын.
Dialogue: 0,0:07:40.65,0:07:43.68,Default,,0000,0000,0000,,Мен осылай қашып кетсем→
Dialogue: 0,0:07:43.68,0:07:48.73,Default,,0000,0000,0000,,Мен сенен өз өлімің үшін жауапкершілікті алуды сұраймын.
Dialogue: 0,0:07:48.73,0:07:52.77,Default,,0000,0000,0000,,Куккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккen ккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккen
Dialogue: 0,0:07:52.77,0:07:54.79,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:07:54.79,0:07:59.84,Default,,0000,0000,0000,,1 2 3 4... Міндетті түрде 5 болды. →
Dialogue: 0,0:07:59.84,0:08:02.87,Default,,0000,0000,0000,,Олар менің жарамды емдеп қана қойған жоқ→
Dialogue: 0,0:08:02.87,0:08:08.93,Default,,0000,0000,0000,,Айдаһар шарларының әрқайсысы алынып тасталды. →
Dialogue: 0,0:08:08.93,0:08:11.96,Default,,0000,0000,0000,,Бірақ бес заттың барлығымен қашып құтыла алмайсыз. →
Dialogue: 0,0:08:11.96,0:08:16.34,Default,,0000,0000,0000,,Оның үстіне демалуға, ойлануға уақыт жоқ сияқты.
Dialogue: 0,0:08:16.34,0:08:18.34,Default,,0000,0000,0000,,Мен музыка колледжінде Саки Аримамен бір курс болғанмын, сондықтан→
Dialogue: 0,0:08:24.42,0:08:29.47,Default,,0000,0000,0000,,Хаа~. →
Dialogue: 0,0:08:29.47,0:08:34.52,Default,,0000,0000,0000,,Уау. →
Dialogue: 0,0:08:34.52,0:08:38.56,Default,,0000,0000,0000,,Сізден өтінемін, жақсылық жасаңыз. →
Dialogue: 0,0:08:38.56,0:08:41.59,Default,,0000,0000,0000,,Сәлем! Сіз ұсталды, мен әлі кемедемін!
Dialogue: 0,0:08:41.59,0:08:44.62,Default,,0000,0000,0000,,Жоқ!? (Зарбон) Не?
Dialogue: 0,0:08:44.62,0:08:46.62,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:08:55.73,0:08:58.76,Default,,0000,0000,0000,,Гва~!
Dialogue: 0,0:08:58.76,0:09:01.76,Default,,0000,0000,0000,,Чичикушо!
Dialogue: 0,0:09:04.82,0:09:06.82,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:09:09.87,0:09:12.87,Default,,0000,0000,0000,,Хаа~! Қазір!
Dialogue: 0,0:09:19.30,0:09:23.34,Default,,0000,0000,0000,,Вегета ше? Ол қайда!
Dialogue: 0,0:09:23.34,0:09:25.36,Default,,0000,0000,0000,,Куу….
Dialogue: 0,0:09:25.36,0:09:30.41,Default,,0000,0000,0000,,Амал жоқ, мүмкін емес, Вегета Айдаһар допты көздеп отыр!
Dialogue: 0,0:09:30.41,0:09:33.44,Default,,0000,0000,0000,,Ха! Ха! →
Dialogue: 0,0:09:33.44,0:09:35.44,Default,,0000,0000,0000,,(Наширо) Рей (Джузо Сузуя) Хм?
Dialogue: 0,0:09:42.53,0:09:45.53,Default,,0000,0000,0000,,Жарайды, бұл жолы менмін.
Dialogue: 0,0:09:47.58,0:09:51.62,Default,,0000,0000,0000,,Айдаһар добы нүкте!
Dialogue: 0,0:09:51.62,0:09:54.62,Default,,0000,0000,0000,,Әй, әлгі бейбақ!
Dialogue: 0,0:09:58.69,0:10:01.69,Default,,0000,0000,0000,,Әй, бұл уақыт қайда?
Dialogue: 0,0:10:11.99,0:10:13.18,Default,,0000,0000,0000,,Фуфу Фриза-сама. →
Dialogue: 0,0:10:13.18,0:10:16.21,Default,,0000,0000,0000,,О, ол тағы да ғарыш кемесінде ме?
Dialogue: 0,0:10:16.21,0:10:20.21,Default,,0000,0000,0000,,Іздеу! (Зарбон) Иә, иә.
Dialogue: 0,0:10:22.27,0:10:25.30,Default,,0000,0000,0000,,Хехехе.
Dialogue: 0,0:10:25.30,0:10:27.32,Default,,0000,0000,0000,,《Абайсыз ұшып кетсең →
Dialogue: 0,0:10:27.32,0:10:31.36,Default,,0000,0000,0000,,Фриза сізді тез қуып жетеді.
Dialogue: 0,0:10:31.36,0:10:43.48,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:10:43.48,0:10:46.51,Default,,0000,0000,0000,,Қандай жексұрын! →
Dialogue: 0,0:10:46.51,0:10:50.55,Default,,0000,0000,0000,,Вегета ғана емес, тіпті Айдаһар шарлары да қашып кетті! →
Dialogue: 0,0:10:50.55,0:10:52.57,Default,,0000,0000,0000,,5 шарға дейін ұстау →
Dialogue: 0,0:10:52.57,0:10:55.60,Default,,0000,0000,0000,,Әп-сәтте қашып құтылу мүмкін емес.
Dialogue: 0,0:10:55.60,0:10:58.63,Default,,0000,0000,0000,,Мен ғарыш кемесінің ішінен іздеймін→
Dialogue: 0,0:10:58.63,0:11:01.66,Default,,0000,0000,0000,,Сырттан мұқият іздеңіз. (Зарбон) Ха.
Dialogue: 0,0:11:01.66,0:11:05.70,Default,,0000,0000,0000,,Дайын болғаныңыз жақсы. Вегета тіпті бір сағаттан кейін →
Dialogue: 0,0:11:05.70,0:11:11.42,Default,,0000,0000,0000,,Мен сені осында әкеле алмасам... Қарғыс атсын.
Dialogue: 0,0:11:11.42,0:11:13.42,Default,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:11:24.22,0:11:28.26,Default,,0000,0000,0000,,Иә? иә? Осы жолмен...
Dialogue: 0,0:11:28.26,0:11:30.26,Default,,0000,0000,0000,,Менің үйімнің ішінде емес пе?
Dialogue: 0,0:11:33.31,0:11:39.31,Default,,0000,0000,0000,,Көремін, тіпті Вегета да оны көлден таба алмайды.
Dialogue: 0,0:12:02.60,0:12:04.60,Default,,0000,0000,0000,,Иә!
Dialogue: 0,0:12:06.64,0:12:10.68,Default,,0000,0000,0000,,Пуха~ Ха....
Dialogue: 0,0:12:10.68,0:12:12.68,Default,,0000,0000,0000,,болды.
Dialogue: 0,0:12:14.05,0:12:23.14,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:12:23.14,0:12:27.18,Default,,0000,0000,0000,,Буха! Хахаха…. →
Dialogue: 0,0:12:27.18,0:12:33.24,Default,,0000,0000,0000,,Хахаха….
Dialogue: 0,0:12:33.24,0:12:38.24,Default,,0000,0000,0000,,Күрсін... Мен бұл жерде бір жерде екеніне сенімдімін.
Dialogue: 0,0:12:43.34,0:12:46.37,Default,,0000,0000,0000,,Хахахаха! Міне болды! Міне болды!
Dialogue: 0,0:12:46.37,0:12:49.40,Default,,0000,0000,0000,,Үлкен бақылау.
Dialogue: 0,0:12:49.40,0:12:53.44,Default,,0000,0000,0000,,Маған қарашы, Фриза. →
Dialogue: 0,0:12:53.44,0:12:57.48,Default,,0000,0000,0000,,Соңында мен оның Айдаһар допын алдым.
Dialogue: 0,0:12:57.48,0:12:59.50,Default,,0000,0000,0000,,Хахахаха! →
Dialogue: 0,0:12:59.50,0:13:02.53,Default,,0000,0000,0000,,Енді сол ауылда батқанды қоссам →
Dialogue: 0,0:13:02.53,0:13:06.57,Default,,0000,0000,0000,,Сіз бір ғана элементпен барлық 7 элементті ала аласыз. →
Dialogue: 0,0:13:06.57,0:13:10.61,Default,,0000,0000,0000,,Ха! Күшті жауынгерлік күш... Зарбон? →
Dialogue: 0,0:13:10.61,0:13:14.98,Default,,0000,0000,0000,,Жоқ, олай емес. Оның жауынгерлік күші Зарбоннан төмен.
Dialogue: 0,0:13:14.98,0:13:17.01,Default,,0000,0000,0000,,Ах!
Dialogue: 0,0:13:17.01,0:13:20.04,Default,,0000,0000,0000,,А, бұл...
Dialogue: 0,0:13:20.04,0:13:24.08,Default,,0000,0000,0000,,Хья~хахаха Күте тұр, Гохан.
Dialogue: 0,0:13:24.08,0:13:29.08,Default,,0000,0000,0000,,Үлкен кісіге барсаң, одан да күшті боласың.
Dialogue: 0,0:13:32.16,0:13:35.19,Default,,0000,0000,0000,,Ол жерлік...
Dialogue: 0,0:13:35.19,0:13:38.22,Default,,0000,0000,0000,,Неліктен осы Намек планетасында? →
Dialogue: 0,0:13:38.22,0:13:42.26,Default,,0000,0000,0000,,Оның үстіне ол соңғы Айдаһар допты өзімен бірге алып кетті.
Dialogue: 0,0:13:42.26,0:13:44.28,Default,,0000,0000,0000,,Хахахаха!
Dialogue: 0,0:13:44.28,0:13:47.31,Default,,0000,0000,0000,,Сәттілік барлық жағынан маған қарай бұрылды. →
Dialogue: 0,0:13:47.31,0:13:50.31,Default,,0000,0000,0000,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:15:09.80,0:15:14.85,Default,,0000,0000,0000,,Тез! Жақында біз сонда боламыз.
Dialogue: 0,0:15:14.85,0:15:17.88,Default,,0000,0000,0000,,Бұл Жердің мақсаты да Айдаһар допына ұқсас.
Dialogue: 0,0:15:17.88,0:15:21.92,Default,,0000,0000,0000,,Бірақ мен сізде барын аламын. →
Dialogue: 0,0:15:21.92,0:15:27.98,Default,,0000,0000,0000,,Хухахаха! Енді сіз барлық 7 айдаһар шарын жинай аласыз!
Dialogue: 0,0:15:27.98,0:15:32.03,Default,,0000,0000,0000,,Қарғыс атсын, Вегета, сен қайдасың...?
Dialogue: 0,0:15:32.03,0:15:37.08,Default,,0000,0000,0000,,Скаутермен оңай ашылатын нәрселер... Қарғыс атсын.
Dialogue: 0,0:15:37.08,0:15:39.08,Default,,0000,0000,0000,,Гү!
Dialogue: 0,0:15:43.14,0:15:48.14,Default,,0000,0000,0000,,Іс осылай жалғаса берсе, менің өмірім Фризаның қолында болады...
Dialogue: 0,0:15:50.21,0:15:53.24,Default,,0000,0000,0000,,Вегета? →
Dialogue: 0,0:15:53.24,0:15:58.29,Default,,0000,0000,0000,,Жоқ. Намекиан баласын құтқаруға келген адам.
Dialogue: 0,0:15:58.29,0:16:01.49,Default,,0000,0000,0000,,Бірақ Dragon Ball сияқты нәрсе...
Dialogue: 0,0:16:01.49,0:16:04.68,Default,,0000,0000,0000,,Ха! →
Dialogue: 0,0:16:04.68,0:16:06.70,Default,,0000,0000,0000,,Вегета!
Dialogue: 0,0:16:06.70,0:16:10.74,Default,,0000,0000,0000,,Мен оны таптым, бұл менікі!
Dialogue: 0,0:16:10.74,0:16:29.93,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:16:29.93,0:16:33.97,Default,,0000,0000,0000,,Иә? Ол үлкен жауынгерлік күшпен келеді.
Dialogue: 0,0:16:33.97,0:16:38.02,Default,,0000,0000,0000,,Зарбон сізді тапқан сияқты. Tsk, сен қиын бейбақсың.
Dialogue: 0,0:16:38.02,0:16:42.06,Default,,0000,0000,0000,,Бірақ бұл жақсы уақыт. Мен оны осы жолы тазалаймын.
Dialogue: 0,0:16:42.06,0:16:46.10,Default,,0000,0000,0000,,Соңғы шайқас оған толық сенімді болды.
Dialogue: 0,0:16:46.10,0:16:48.10,Default,,0000,0000,0000,,Сіз сақтықты түсіруіңіз керек еді.
Dialogue: 0,0:16:54.18,0:16:56.18,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:16:59.23,0:17:01.92,Default,,0000,0000,0000,,Сәлем~!
Dialogue: 0,0:17:01.92,0:17:03.92,Default,,0000,0000,0000,,А... А?
Dialogue: 0,0:17:05.62,0:17:09.66,Default,,0000,0000,0000,,Уф! Криллин емес! Мені қорқытпа!
Dialogue: 0,0:17:09.66,0:17:11.68,Default,,0000,0000,0000,,А, бұл қауіпті емес пе, Бұлма-сан?
Dialogue: 0,0:17:11.68,0:17:15.72,Default,,0000,0000,0000,,Егер сіз сыртта демалып, кітап оқып жатсаңыз, олар сізді тауып алады.
Dialogue: 0,0:17:15.72,0:17:19.76,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз? Мен ұзақ уақыт бойы осындай үңгірде болдым ...
Dialogue: 0,0:17:19.76,0:17:23.80,Default,,0000,0000,0000,,Не? Сонымен, бұл Dragon Ball болуы мүмкін бе!?
Dialogue: 0,0:17:23.80,0:17:26.83,Default,,0000,0000,0000,,Хэхе~ Дұрыс~.
Dialogue: 0,0:17:26.83,0:17:29.86,Default,,0000,0000,0000,,Эй, нағыз Айдаһар добы қандай?
Dialogue: 0,0:17:29.86,0:17:32.89,Default,,0000,0000,0000,,Бұл өте үлкен.
Dialogue: 0,0:17:32.89,0:17:35.92,Default,,0000,0000,0000,,Ол ең қарт адам болатын және оны түсінуге оңай болатын.
Dialogue: 0,0:17:35.92,0:17:40.97,Default,,0000,0000,0000,,А, иә, Булма-сан, Гохан біздің үйде ме? →
Dialogue: 0,0:17:40.97,0:17:44.01,Default,,0000,0000,0000,,Мен оны үлкеніне апарғым келеді.
Dialogue: 0,0:17:44.01,0:17:47.04,Default,,0000,0000,0000,,Мен басқа Айдаһар шарын табуға бардым.
Dialogue: 0,0:17:47.04,0:17:49.06,Default,,0000,0000,0000,,Не? Бұл менің радарымда болды. →
Dialogue: 0,0:17:49.06,0:17:52.09,Default,,0000,0000,0000,,Қараңдаршы, Вегета шабуыл жасап жатыр деген ауылдың айналасына.
Dialogue: 0,0:17:52.09,0:17:55.12,Default,,0000,0000,0000,,Иә? Шынымен бе?
Dialogue: 0,0:17:55.12,0:18:00.17,Default,,0000,0000,0000,,Ақыл! Мен осында бара жатырмын. Дәл сол жерде...
Dialogue: 0,0:18:00.17,0:18:04.17,Default,,0000,0000,0000,,Гохан, сен жылдам болдың. Жоқ, бұл Гохан емес!
Dialogue: 0,0:18:06.57,0:18:09.57,Default,,0000,0000,0000,,Вегета болыңыз!
Dialogue: 0,0:18:17.68,0:18:20.71,Default,,0000,0000,0000,,《Ол кетті! Мен күшейіп кетсем де, мен толқып отырмын→
Dialogue: 0,0:18:20.71,0:18:22.73,Default,,0000,0000,0000,,Мен оны байқамадым.
Dialogue: 0,0:18:22.73,0:18:28.79,Default,,0000,0000,0000,,Мен сені күтпеген жерден кездестірдім, Жер. Балалар сендер осы планетаға келе аласыңдар→
Dialogue: 0,0:18:28.79,0:18:31.82,Default,,0000,0000,0000,,Өркениет бар деп ойламадым. →
Dialogue: 0,0:18:31.82,0:18:34.85,Default,,0000,0000,0000,,Мұқият ұстаған Айдаһар шарына қарап →
Dialogue: 0,0:18:34.85,0:18:38.89,Default,,0000,0000,0000,,Мақсаты бір болса керек.
Dialogue: 0,0:18:38.89,0:18:43.94,Default,,0000,0000,0000,,Тыңдаңыздар, мен бұл допты алғанша бірдеңе істеуім керек.
Dialogue: 0,0:18:43.94,0:18:46.97,Default,,0000,0000,0000,,Бірақ мен онымен қашып кетемін деп ойламаймын.
Dialogue: 0,0:18:46.97,0:18:48.99,Default,,0000,0000,0000,,Біртүрлі болып оянбағаныңыз жөн. →
Dialogue: 0,0:18:48.99,0:18:51.02,Default,,0000,0000,0000,,Сен ғана емес, әйел де өледі.
Dialogue: 0,0:18:51.02,0:18:53.04,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:18:53.04,0:18:55.06,Default,,0000,0000,0000,,Бұл осында.
Dialogue: 0,0:18:55.06,0:18:57.06,Default,,0000,0000,0000,,Ах.
Dialogue: 0,0:18:59.10,0:19:01.10,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:19:05.49,0:19:07.51,Default,,0000,0000,0000,,Бұл кім?
Dialogue: 0,0:19:07.51,0:19:11.55,Default,,0000,0000,0000,,Осы жүзге қарап, сіз әділдік жағындасыз деп ойлаймын?
Dialogue: 0,0:19:11.55,0:19:13.55,Default,,0000,0000,0000,,Бұл дұрыс емес...
Dialogue: 0,0:19:18.62,0:19:20.62,Default,,0000,0000,0000,,Хун.
Dialogue: 0,0:19:29.73,0:19:31.75,Default,,0000,0000,0000,,Бұл ең нашар.
Dialogue: 0,0:19:31.75,0:19:35.79,Default,,0000,0000,0000,,Ең жаманы не? Ол өте жақсы жігіт емес.
Dialogue: 0,0:19:35.79,0:19:39.83,Default,,0000,0000,0000,,Осындай уақытта біреуді бетіне қарап бағаламаңыз.
Dialogue: 0,0:19:39.83,0:19:42.86,Default,,0000,0000,0000,,Өйткені, әдетте, екіншісі - әділдік.
Dialogue: 0,0:19:42.86,0:19:45.89,Default,,0000,0000,0000,,Бұл Жер емес, Намек планетасы.
Dialogue: 0,0:19:45.89,0:19:47.91,Default,,0000,0000,0000,,Мен мұны білемін.
Dialogue: 0,0:19:47.91,0:19:51.91,Default,,0000,0000,0000,,Бұлма-сан ештеңе түсінбейді.
Dialogue: 0,0:19:57.01,0:20:02.39,Default,,0000,0000,0000,,Сен маған еліктеп керемет жұмыс жасадың, Вегета.
Dialogue: 0,0:20:02.39,0:20:05.42,Default,,0000,0000,0000,,Иә. (Зарбон) Түсінемін. Осылайша →
Dialogue: 0,0:20:05.42,0:20:08.45,Default,,0000,0000,0000,,Айдаһар добы бар кішкентай жігітті де танимын.
Dialogue: 0,0:20:08.45,0:20:10.47,Default,,0000,0000,0000,,Ах... Ахах...
Dialogue: 0,0:20:10.47,0:20:13.50,Default,,0000,0000,0000,,Балалар, қыдырып отырдыңыздар ма?
Dialogue: 0,0:20:13.50,0:20:16.53,Default,,0000,0000,0000,,Yahoo! Yaho yahoo yahoo!
Dialogue: 0,0:20:16.53,0:20:18.55,Default,,0000,0000,0000,,Вегетаны ұрыңыз.
Dialogue: 0,0:20:18.55,0:20:20.57,Default,,0000,0000,0000,,Иә, сен білесің бе?
Dialogue: 0,0:20:20.57,0:20:23.60,Default,,0000,0000,0000,,Бұл маңызды емес.
Dialogue: 0,0:20:23.60,0:20:27.64,Default,,0000,0000,0000,,Вегета Айдаһар шарларының қалған бөлігін қайда жасырдың?
Dialogue: 0,0:20:27.64,0:20:31.68,Default,,0000,0000,0000,,Мен сізден Фриза-саманың алдындағы орын туралы айтуыңызды сұраймын.
Dialogue: 0,0:20:31.68,0:20:33.70,Default,,0000,0000,0000,,Байқап көріңіз!
Dialogue: 0,0:20:33.70,0:20:36.73,Default,,0000,0000,0000,,Аспазшы жазалау Яцуме.
Dialogue: 0,0:20:36.73,0:20:38.73,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:20:41.78,0:20:45.82,Default,,0000,0000,0000,,Да-да-да-да...!
Dialogue: 0,0:20:45.82,0:20:47.84,Default,,0000,0000,0000,,Басынан бастап осы тапаншамен атып тастауым керек еді! ➡
Dialogue: 0,0:20:47.84,0:20:49.84,Default,,0000,0000,0000,,Дея~!
Dialogue: 0,0:20:51.88,0:20:53.90,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:20:53.90,0:20:55.92,Default,,0000,0000,0000,,Мені жалама.
Dialogue: 0,0:20:55.92,0:20:58.92,Default,,0000,0000,0000,,Иә! Дея! (Зарбон) құдай!
Dialogue: 0,0:21:04.35,0:21:06.37,Default,,0000,0000,0000,,《Қалай болса...》
Dialogue: 0,0:21:06.37,0:21:09.37,Default,,0000,0000,0000,,Ақырында, сізге ұнады ма?
Dialogue: 0,0:21:12.43,0:21:15.43,Default,,0000,0000,0000,,Гу~!
Dialogue: 0,0:21:21.52,0:21:25.56,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:21:25.56,0:21:29.56,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:21:31.62,0:21:33.64,Default,,0000,0000,0000,,Ол бәрібір жаман адам!
Dialogue: 0,0:21:33.64,0:21:36.67,Default,,0000,0000,0000,,Не? Ол құбыжық. →
Dialogue: 0,0:21:36.67,0:21:40.71,Default,,0000,0000,0000,,Оның үстіне қуат айтарлықтай өсті.
Dialogue: 0,0:21:40.71,0:21:42.73,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:21:42.73,0:21:44.73,Default,,0000,0000,0000,,Ха~!
Dialogue: 0,0:21:46.77,0:21:48.77,Default,,0000,0000,0000,,《Ол Зарбонды ұстап алды》
Dialogue: 0,0:21:50.81,0:21:52.81,Default,,0000,0000,0000,,Хэхе~.
Dialogue: 0,0:21:56.87,0:21:58.89,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:21:58.89,0:22:00.91,Default,,0000,0000,0000,,Уф боп.
Dialogue: 0,0:22:00.91,0:22:03.27,Default,,0000,0000,0000,,Дея~!
Dialogue: 0,0:22:03.27,0:22:06.30,Default,,0000,0000,0000,,Уау! (Криллин Булма) Сәлем!
Dialogue: 0,0:22:06.30,0:22:09.33,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:22:09.33,0:22:11.33,Default,,0000,0000,0000,,Иә! (Зарбон) Уау!
Dialogue: 0,0:22:13.37,0:22:15.39,Default,,0000,0000,0000,,Яа~.
Dialogue: 0,0:22:15.39,0:22:19.43,Default,,0000,0000,0000,,Да-да-да-да...!
Dialogue: 0,0:22:19.43,0:22:22.46,Default,,0000,0000,0000,,Бұлма-сан, қазір уақыт келді. Қанекей жүгірейік.
Dialogue: 0,0:22:22.46,0:22:25.49,Default,,0000,0000,0000,,Өйткені ол қашып кетсе, мен оны өлтіремін.
Dialogue: 0,0:22:25.49,0:22:28.52,Default,,0000,0000,0000,,Қашпасаң да өлтіресің. тез!
Dialogue: 0,0:22:28.52,0:22:31.55,Default,,0000,0000,0000,,Мен саған бұлай істеуге рұқсат бермеймін!
Dialogue: 0,0:22:31.55,0:22:34.58,Default,,0000,0000,0000,,Уау! Кя!
Dialogue: 0,0:22:34.58,0:22:38.58,Default,,0000,0000,0000,,Қат! Орын жоқ сияқты.
Dialogue: 0,0:22:40.64,0:22:45.64,Default,,0000,0000,0000,,Иә? Екі керемет сезім! Мені күтіп тұрған Бұлма-сан.
Dialogue: 0,0:22:51.75,0:22:54.78,Default,,0000,0000,0000,,Вегета Жарайсың!
Dialogue: 0,0:22:54.78,0:22:57.81,Default,,0000,0000,0000,,Хехехехе Бұл өте жақсы жұмыс істеген сияқты.
Dialogue: 0,0:22:57.81,0:23:00.84,Default,,0000,0000,0000,,Сіздің физикалық күшіңіз айтарлықтай төмендеді.
Dialogue: 0,0:23:00.84,0:23:04.21,Default,,0000,0000,0000,,Зарбон мырза, сіздің өліміңіз жақындап қалған сияқты.
Dialogue: 0,0:23:04.21,0:23:07.24,Default,,0000,0000,0000,,Өлім жақын болса ше? Хахахаха.
Dialogue: 0,0:23:07.24,0:23:11.28,Default,,0000,0000,0000,,Мені күлдірмеңіз. Менің жауынгерлік қабілетім сенен жоғары.
Dialogue: 0,0:23:11.28,0:23:13.30,Default,,0000,0000,0000,,Зарбон мырза, сіз →
Dialogue: 0,0:23:13.30,0:23:18.35,Default,,0000,0000,0000,,Сайандар туралы көбірек білу керек емес пе еді?
Dialogue: 0,0:23:18.35,0:23:21.38,Default,,0000,0000,0000,,Мен өлейін деп жатқанда мені абайсызда емдеген адам → болды
Dialogue: 0,0:23:21.38,0:23:24.41,Default,,0000,0000,0000,,Бұл жаман болды. Маған солай көрінеді. (Зарбон) Уф.
Dialogue: 0,0:23:24.41,0:23:27.44,Default,,0000,0000,0000,,Сайянның өлім аузынан шыққан сайын→
Dialogue: 0,0:23:27.44,0:23:31.48,Default,,0000,0000,0000,,Сіз өзіңіздің жауынгерлік күшіңізді тұрақты түрде арттыра аласыз.
Dialogue: 0,0:23:31.48,0:23:36.53,Default,,0000,0000,0000,,Мен қазір ойлап қарасам, Гоку да әр кескілескен шайқас сайын күшейе түсті.
Dialogue: 0,0:23:36.53,0:23:41.58,Default,,0000,0000,0000,,Боқ~ Сондықтан да болар, Вегетаның энергиясы қатты көтерілді.
Dialogue: 0,0:23:41.58,0:23:44.61,Default,,0000,0000,0000,,Жауынгерлік күшіңізді қаншалықты арттырсаңыз да→
Dialogue: 0,0:23:44.61,0:23:48.65,Default,,0000,0000,0000,,Сенің шынайы күшіңді түрлендіретін және боса алатын мені жеңу мүмкін емес.
Dialogue: 0,0:23:48.65,0:23:51.68,Default,,0000,0000,0000,,Хехехе. (Зарбон) Уу~!
Dialogue: 0,0:23:51.68,0:23:55.68,Default,,0000,0000,0000,,Сайандар - күрескен нәсіл! Оны жалама! →
Dialogue: 0,0:24:00.77,0:24:02.12,Default,,0000,0000,0000,,Тея!
Dialogue: 0,0:24:02.12,0:24:06.16,Default,,0000,0000,0000,,Уау! Жақсы...
Dialogue: 0,0:24:06.16,0:24:09.16,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:24:14.24,0:24:17.27,Default,,0000,0000,0000,,Уу а~.
Dialogue: 0,0:24:17.27,0:24:21.31,Default,,0000,0000,0000,,Кух….
Dialogue: 0,0:24:21.31,0:24:24.34,Default,,0000,0000,0000,,Бәс, Вегета... Уау, мен →
Dialogue: 0,0:24:24.34,0:24:27.37,Default,,0000,0000,0000,,Маған жаңа ғана Фриза-сама бұйырды.
Dialogue: 0,0:24:27.37,0:24:29.39,Default,,0000,0000,0000,,Оған назар аудармауыңызды өтінемін.
Dialogue: 0,0:24:29.39,0:24:32.42,Default,,0000,0000,0000,,Осы уақытқа дейін мен оны көп қолдандым →
Dialogue: 0,0:24:32.42,0:24:34.44,Default,,0000,0000,0000,,Заттарды елеусіз қалдырмаңыз!
Dialogue: 0,0:24:34.44,0:24:37.47,Default,,0000,0000,0000,,Дұрыс, қол ұстасайық.
Dialogue: 0,0:24:37.47,0:24:41.51,Default,,0000,0000,0000,,Егер сіз мұны жасасаңыз, сіз тіпті Фризаны жеңе аласыз.
Dialogue: 0,0:24:41.51,0:24:43.53,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:24:43.53,0:24:46.56,Default,,0000,0000,0000,,Ах! Ах~!
Dialogue: 0,0:24:46.56,0:24:48.58,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:24:48.58,0:24:50.58,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:24:52.62,0:24:57.67,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:57.67,0:25:17.87,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:17.87,0:25:37.07,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:37.07,0:25:50.07,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:54.24,0:25:57.27,Default,,0000,0000,0000,,Сәлем, Гоку. Ора Намекке келгенше →
Dialogue: 0,0:25:57.27,0:26:00.30,Default,,0000,0000,0000,,Бар болғаны екі күн қалды. Барлығыңыз аман болыңыздар!
Dialogue: 0,0:26:00.30,0:26:03.67,Default,,0000,0000,0000,,Боқ~ Мен алуға көп уақыт кеткен Айдаһар шарлары... →
Dialogue: 0,0:26:03.67,0:26:06.70,Default,,0000,0000,0000,,Гохан Егер мұндай жағдайлар орын алса, мен сенетін жалғыз адам сенсің. →
Dialogue: 0,0:26:06.70,0:26:09.73,Default,,0000,0000,0000,,Мені ешкім таппай қайтып келіңізші!
Dialogue: 0,0:26:09.73,0:26:12.73,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»
Dialogue: 0,0:26:15.79,0:26:19.79,Default,,0000,0000,0000,,Қашайық, мүмкіндікті күтейік!
Dialogue: 0,0:26:21.29,0:26:27.29,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory