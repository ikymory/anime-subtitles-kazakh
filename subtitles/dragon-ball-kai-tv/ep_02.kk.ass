Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.41,0:00:07.43,Default,,0000,0000,0000,,《Иә!? Осы жақта бір нәрсе келе жатыр. →
Dialogue: 0,0:00:07.43,0:00:09.45,Default,,0000,0000,0000,,Бұл Пикколо болуы мүмкін бе? 》
Dialogue: 0,0:00:09.45,0:00:12.48,Default,,0000,0000,0000,,《Дея~! Дея! « «Апыр-ай! 》
Dialogue: 0,0:00:12.48,0:00:16.48,Default,,0000,0000,0000,,Мен бес жыл бұрын Тенкайчи Будокайда Пикколомен шайқастым...
Dialogue: 0,0:00:21.57,0:00:23.59,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:00:23.59,0:00:25.59,Default,,0000,0000,0000,,Әйтеуір Ола жеңді.
Dialogue: 0,0:00:27.63,0:00:32.63,Default,,0000,0000,0000,,Сіз бес жыл жаттығып, Оланы жеңу үшін оралдыңыз ба?
Dialogue: 0,0:00:35.71,0:00:38.74,Default,,0000,0000,0000,,《Мм, жоқ! Бұл кім? 》
Dialogue: 0,0:00:38.74,0:00:44.74,Default,,0000,0000,0000,,<Кенеттен келген бұл адам кім? ＞
Dialogue: 0,0:00:46.82,0:00:51.87,Default,,0000,0000,0000,,『Ｄｒａｇｏｎ Ｓｏｕｌ』
Dialogue: 0,0:00:51.87,0:01:11.40,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:11.40,0:01:31.60,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:31.60,0:01:51.80,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:01:51.80,0:02:09.80,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:04:31.40,0:04:34.43,Default,,0000,0000,0000,,Бұл құйрық. Бұл жігіттің де құйрығы бар.
Dialogue: 0,0:04:34.43,0:04:40.49,Default,,0000,0000,0000,,Фуфуфуфу Сіз менің шынайы тұлғамды анықтаған сияқтысыз.
Dialogue: 0,0:04:40.49,0:04:43.52,Default,,0000,0000,0000,,Шынайы тұлға? (Сон Гохан) Хмм...
Dialogue: 0,0:04:43.52,0:04:46.55,Default,,0000,0000,0000,,Сіз нені айтасыз!? Жүр, осы жаққа кел.
Dialogue: 0,0:04:46.55,0:04:48.57,Default,,0000,0000,0000,,Какарот →
Dialogue: 0,0:04:48.57,0:04:51.60,Default,,0000,0000,0000,,Сіз бұл туралы ұмыттыңыз ба?
Dialogue: 0,0:04:51.60,0:04:55.64,Default,,0000,0000,0000,,Оланың біртүрлі аты жоқ.
Dialogue: 0,0:04:55.64,0:04:59.68,Default,,0000,0000,0000,,Сон Гоку! Tsk, не айтып тұрсың?
Dialogue: 0,0:04:59.68,0:05:01.68,Default,,0000,0000,0000,,Маған ұнамайды.
Dialogue: 0,0:05:04.73,0:05:06.75,Default,,0000,0000,0000,,А... Мына жаққа өт.
Dialogue: 0,0:05:06.75,0:05:09.78,Default,,0000,0000,0000,,Эй, сен бұрын →
Dialogue: 0,0:05:09.78,0:05:12.81,Default,,0000,0000,0000,,Сіз басыңызға қатты соққы алдыңыз ба?
Dialogue: 0,0:05:12.81,0:05:14.83,Default,,0000,0000,0000,,Не?
Dialogue: 0,0:05:14.83,0:05:19.88,Default,,0000,0000,0000,,Жас кезіңізде де басыңызды қатты ұрған кезіңіз болды ма?
Dialogue: 0,0:05:19.88,0:05:21.07,Default,,0000,0000,0000,,Сұрақтарға жауап беріңіз! болу.
Dialogue: 0,0:05:21.07,0:05:23.25,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:05:23.25,0:05:27.29,Default,,0000,0000,0000,,Есімде жоқ, бірақ жас кезімде басымды ұрдым.
Dialogue: 0,0:05:27.29,0:05:29.31,Default,,0000,0000,0000,,Бұл солай болды ма?
Dialogue: 0,0:05:29.31,0:05:32.34,Default,,0000,0000,0000,,Бірақ бұл нені білдіреді?
Dialogue: 0,0:05:32.34,0:05:34.36,Default,,0000,0000,0000,,Гоку. Иә?
Dialogue: 0,0:05:34.36,0:05:40.42,Default,,0000,0000,0000,,Баяғыда атаң Сон Гохан маған бірдеңе айтты. →
Dialogue: 0,0:05:40.42,0:05:46.48,Default,,0000,0000,0000,,Бір күні терең алқаптан мен біртүрлі құлаған затқа ұқсайтын нәрсені таптым. →
Dialogue: 0,0:05:46.48,0:05:50.52,Default,,0000,0000,0000,,Жақындаған кезде оны дөңгелек капсула ішінен табасыз→
Dialogue: 0,0:05:50.52,0:05:53.55,Default,,0000,0000,0000,,Ішінде құйрық бала болды. →
Dialogue: 0,0:05:53.55,0:05:56.58,Default,,0000,0000,0000,,Мен оны үйге әкеліп, өсіруге тырыстым, бірақ→
Dialogue: 0,0:05:56.58,0:06:00.62,Default,,0000,0000,0000,,Мінезі дөрекі, менімен тіл табысуға тырыспайды→
Dialogue: 0,0:06:00.62,0:06:03.62,Default,,0000,0000,0000,,Ол шынымен де ұтылып қалған сияқты.
Dialogue: 0,0:06:05.67,0:06:09.71,Default,,0000,0000,0000,,Бірақ бір күні байқаусызда алқапқа құлап қалдым→
Dialogue: 0,0:06:09.71,0:06:11.73,Default,,0000,0000,0000,,Басымды қатты соғып, өліп қала жаздадым→
Dialogue: 0,0:06:11.73,0:06:16.78,Default,,0000,0000,0000,,Нәресте өзінің керемет өмірлік күшінің арқасында аман қалған сияқты. →
Dialogue: 0,0:06:16.78,0:06:20.82,Default,,0000,0000,0000,,Не керек, одан кейін оның кісілігінің қаталдығы сейілді→
Dialogue: 0,0:06:20.82,0:06:23.19,Default,,0000,0000,0000,,Жақсы бала болды дейді.
Dialogue: 0,0:06:23.19,0:06:27.23,Default,,0000,0000,0000,,Бұл сіз бе? Бұл нені білдіреді?
Dialogue: 0,0:06:27.23,0:06:31.23,Default,,0000,0000,0000,,Немересімен қарым-қатынасы бар ма?
Dialogue: 0,0:06:33.29,0:06:37.33,Default,,0000,0000,0000,,Сен кімсің? Сен кімсің!?
Dialogue: 0,0:06:37.33,0:06:41.37,Default,,0000,0000,0000,,Хехехехе мен саған айтамын.
Dialogue: 0,0:06:41.37,0:06:45.41,Default,,0000,0000,0000,,Сіз бұл планетада адам емессіз. Хмм!?
Dialogue: 0,0:06:45.41,0:06:48.44,Default,,0000,0000,0000,,Вегета планетасында дүниеге келген.
Dialogue: 0,0:06:48.44,0:06:51.47,Default,,0000,0000,0000,,Мақтаншақ, бүкіл ғаламдағы ең күшті жауынгер нәсіл→
Dialogue: 0,0:06:51.47,0:06:54.50,Default,,0000,0000,0000,,Ол Сайян. Ғаламның...
Dialogue: 0,0:06:54.50,0:06:56.52,Default,,0000,0000,0000,,Жауынгер!? Саян!?
Dialogue: 0,0:06:56.52,0:07:02.58,Default,,0000,0000,0000,,Ал мен сенің ағаң Радицпін!
Dialogue: 0,0:07:02.58,0:07:05.61,Default,,0000,0000,0000,,Гоку ағасы ма?
Dialogue: 0,0:07:05.61,0:07:08.64,Default,,0000,0000,0000,,Сен бауырым? өтірік?
Dialogue: 0,0:07:08.64,0:07:10.66,Default,,0000,0000,0000,,Боқтамаңыз!
Dialogue: 0,0:07:10.66,0:07:14.70,Default,,0000,0000,0000,,Дұрыс! Егер Гоку бөтен планеталық болса, ол неге Жерде?
Dialogue: 0,0:07:14.70,0:07:18.74,Default,,0000,0000,0000,,Хехехехе хахахахаха!
Dialogue: 0,0:07:18.74,0:07:21.93,Default,,0000,0000,0000,,Жауап қарапайым, Какарот.
Dialogue: 0,0:07:21.93,0:07:24.13,Default,,0000,0000,0000,,Сіз осы планетада өмір сүретін қиын адамдарсыз→
Dialogue: 0,0:07:24.13,0:07:27.16,Default,,0000,0000,0000,,Оларды жоюға жіберілді.
Dialogue: 0,0:07:27.16,0:07:30.19,Default,,0000,0000,0000,,Не?! Біз Сайяндықтар →
Dialogue: 0,0:07:30.19,0:07:33.22,Default,,0000,0000,0000,,Олар өте құрметті жауынгер нәсіл. →
Dialogue: 0,0:07:33.22,0:07:40.29,Default,,0000,0000,0000,,Ғаламды аралап, жақсы ортасы бар жұлдызды табыңыз және онда тұратын адамдарды жойыңыз →
Dialogue: 0,0:07:40.29,0:07:43.32,Default,,0000,0000,0000,,Лайықты жұлдызды іздеп жүрген шетелдіктерге→
Dialogue: 0,0:07:43.32,0:07:46.35,Default,,0000,0000,0000,,Менің жұмысым – қымбат бағаға сату. →
Dialogue: 0,0:07:46.35,0:07:52.41,Default,,0000,0000,0000,,Ересек жауынгерлер жауынгерлік қабілеті жоғары адамдар орналасқан планетаға мінеді→
Dialogue: 0,0:07:52.41,0:07:59.41,Default,,0000,0000,0000,,Осылайша сіз сияқты сәбилер деңгейі төмен жұлдыздарға жіберіледі.
Dialogue: 0,0:08:03.52,0:08:07.56,Default,,0000,0000,0000,,Какарот Егер сізге бірнеше жыл қажет болса→
Dialogue: 0,0:08:07.56,0:08:11.60,Default,,0000,0000,0000,,Маған қолайсыздықты жою керек еді.
Dialogue: 0,0:08:11.60,0:08:16.65,Default,,0000,0000,0000,,Бұйрықтар есімде болса болды. Ах...
Dialogue: 0,0:08:16.65,0:08:20.69,Default,,0000,0000,0000,,Бақытымызға орай, бұл планетаның да айы бар.
Dialogue: 0,0:08:20.69,0:08:25.07,Default,,0000,0000,0000,,Иә? Эй, ай міне. Неліктен бақыттысың?
Dialogue: 0,0:08:25.07,0:08:29.11,Default,,0000,0000,0000,,Алданбаңыз! Міне, ай мінсіз шеңбер сызады →
Dialogue: 0,0:08:29.11,0:08:33.15,Default,,0000,0000,0000,,Біз Сайяндар үшін өзіміздің шынайы әлеуетімізді көрсететін уақыт жеткен жоқ па?
Dialogue: 0,0:08:33.15,0:08:36.18,Default,,0000,0000,0000,,
Dialogue: 0,0:08:36.18,0:08:39.21,Default,,0000,0000,0000,,Сіз не туралы айтып отырсыз!? Мен сенің не айтып тұрғаныңды білмеймін!
Dialogue: 0,0:08:39.21,0:08:45.27,Default,,0000,0000,0000,,Не? Жоқ, құйрығың ше?
Dialogue: 0,0:08:45.27,0:08:47.29,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:08:47.29,0:08:50.32,Default,,0000,0000,0000,,Құйрығыңа не болды? Иә?
Dialogue: 0,0:08:50.32,0:08:53.35,Default,,0000,0000,0000,,Баяғыда үзілген.
Dialogue: 0,0:08:53.35,0:08:56.38,Default,,0000,0000,0000,,Сіз нені айтасыз?
Dialogue: 0,0:08:56.38,0:08:59.41,Default,,0000,0000,0000,,Ақымақ! Иә?
Dialogue: 0,0:08:59.41,0:09:05.47,Default,,0000,0000,0000,,Біздің планетаның адамдарымен жақсы араласатынымыз таңқаларлық емес.
Dialogue: 0,0:09:05.47,0:09:07.49,Default,,0000,0000,0000,,Жетеді.
Dialogue: 0,0:09:07.49,0:09:10.52,Default,,0000,0000,0000,,Бұл басқа планетадан келген Ора сияқты нәрсе →
Dialogue: 0,0:09:10.52,0:09:13.55,Default,,0000,0000,0000,,Менің ағам болсаң бәрібір!
Dialogue: 0,0:09:13.55,0:09:18.60,Default,,0000,0000,0000,,Адамдарды қыратындар - ең жаман!
Dialogue: 0,0:09:18.60,0:09:23.98,Default,,0000,0000,0000,,Ола - осында өскен Сон Гоку. Тез үйге қайт!
Dialogue: 0,0:09:23.98,0:09:26.01,Default,,0000,0000,0000,,Иә, иә. (Kame-sennin) That's what it means.
Dialogue: 0,0:09:26.01,0:09:31.06,Default,,0000,0000,0000,,Өткенде не болғанына қарамастан, қазіргі Сон Гоку басқалардан гөрі таңғаларлық жерлік.
Dialogue: 0,0:09:31.06,0:09:35.10,Default,,0000,0000,0000,,Гоку Хана Кем дегенде бұл әлемді құтқарды.
Dialogue: 0,0:09:35.10,0:09:37.12,Default,,0000,0000,0000,,Қайт, үйге қайт!
Dialogue: 0,0:09:37.12,0:09:40.15,Default,,0000,0000,0000,,Хехехехехе. →
Dialogue: 0,0:09:40.15,0:09:44.19,Default,,0000,0000,0000,,However, that's not the case.
Dialogue: 0,0:09:44.19,0:09:48.23,Default,,0000,0000,0000,,Сайандар бастапқыда азшылық нәсіл →
Dialogue: 0,0:09:48.23,0:09:56.31,Default,,0000,0000,0000,,Вегета планетасы алып метеоритпен соқтығысуы салдарынан жарылды.
Dialogue: 0,0:09:56.31,0:09:59.34,Default,,0000,0000,0000,,(Жарылыс дыбысы)
Dialogue: 0,0:09:59.34,0:10:03.38,Default,,0000,0000,0000,,Сайяндардың барлығы дерлік ғаламның шаңында жоғалып кетті.
Dialogue: 0,0:10:03.38,0:10:07.38,Default,,0000,0000,0000,,Neither our fathers nor our mothers.
Dialogue: 0,0:10:10.45,0:10:12.47,Default,,0000,0000,0000,,The remaining Saiyans, including you→
Dialogue: 0,0:10:12.47,0:10:14.49,Default,,0000,0000,0000,,Бар болғаны төрт адам.
Dialogue: 0,0:10:14.49,0:10:18.53,Default,,0000,0000,0000,,Мен және тағы бір адам басқа планетаға шабуыл жасауға шықты және құтқарылды.
Dialogue: 0,0:10:18.53,0:10:20.55,Default,,0000,0000,0000,,And one more person →
Dialogue: 0,0:10:20.55,0:10:26.95,Default,,0000,0000,0000,,Мен сен сияқты жұлдыздарға жіберілгенім үшін бақыттымын. →
Dialogue: 0,0:10:26.95,0:10:29.98,Default,,0000,0000,0000,,Жақында ол өте қымбат бағаға сатылатын сияқты болды→
Dialogue: 0,0:10:29.98,0:10:31.00,Default,,0000,0000,0000,,Жақсы жұлдыз табылды.
Dialogue: 0,0:10:31.00,0:10:36.00,Default,,0000,0000,0000,,Мен сонда шабуылдағым келеді, бірақ бұл үш адаммен аздап күресетін сияқты.
Dialogue: 0,0:10:38.07,0:10:41.10,Default,,0000,0000,0000,,That's when I remembered Kakarot. →
Dialogue: 0,0:10:41.10,0:10:44.13,Default,,0000,0000,0000,,Сіз әлі ұрысқа толық қабілетті болмасаңыз да →
Dialogue: 0,0:10:44.13,0:10:49.18,Default,,0000,0000,0000,,Үшеумізге қосылсаң, бірдеңе істей аламыз.
Dialogue: 0,0:10:49.18,0:10:54.23,Default,,0000,0000,0000,,Don't come near me! Wake up, Kakarot.
Dialogue: 0,0:10:54.23,0:10:56.25,Default,,0000,0000,0000,,It's fun.
Dialogue: 0,0:10:56.25,0:10:58.27,Default,,0000,0000,0000,,This is scary...
Dialogue: 0,0:10:58.27,0:11:00.29,Default,,0000,0000,0000,,Мені ақымақ деп айт! Иә?
Dialogue: 0,0:11:00.29,0:11:03.32,Default,,0000,0000,0000,,Солай ма? Мен өлсем де саған көмектеспеймін!
Dialogue: 0,0:11:03.32,0:11:08.37,Default,,0000,0000,0000,,Ммм, түсіндім.
Dialogue: 0,0:11:08.37,0:11:10.39,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:11:10.39,0:11:12.41,Default,,0000,0000,0000,,Мен бұл туралы біраздан бері ойланып жүрмін→
Dialogue: 0,0:11:12.41,0:11:16.45,Default,,0000,0000,0000,,Isn't that your child behind you?
Dialogue: 0,0:11:16.45,0:11:19.48,Default,,0000,0000,0000,,Цк, жоқ! There's no point in fooling around. →
Dialogue: 0,0:11:19.48,0:11:22.84,Default,,0000,0000,0000,,Бұл ненің құйрығы? →
Dialogue: 0,0:11:22.84,0:11:25.87,Default,,0000,0000,0000,,Бұл сіздің Сайян қаныңыздың бар екендігінің дәлелі емес пе?
Dialogue: 0,0:11:25.87,0:11:28.90,Default,,0000,0000,0000,,Сонда не болды!
Dialogue: 0,0:11:28.90,0:11:32.94,Default,,0000,0000,0000,,Сіз, әкем, нәрселерді түсіну қиынға соғады →
Dialogue: 0,0:11:32.94,0:11:34.96,Default,,0000,0000,0000,,Should I ask you to lend me your son?
Dialogue: 0,0:11:34.96,0:11:36.96,Default,,0000,0000,0000,,Хмм...
Dialogue: 0,0:11:39.01,0:11:41.03,Default,,0000,0000,0000,,Хун. Қарғыс атқыр...
Dialogue: 0,0:11:41.03,0:11:46.08,Default,,0000,0000,0000,,Келме! (Булма/Гохан) Ух...
Dialogue: 0,0:11:46.08,0:11:50.12,Default,,0000,0000,0000,,Try getting any closer. Мен сені үрлеймін!
Dialogue: 0,0:11:50.12,0:11:53.15,Default,,0000,0000,0000,,О. Хмф!
Dialogue: 0,0:11:53.15,0:11:55.15,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:11:57.19,0:12:00.22,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:12:00.22,0:12:02.24,Default,,0000,0000,0000,,О!
Dialogue: 0,0:12:02.24,0:12:06.28,Default,,0000,0000,0000,,Guah! Ah, father!
Dialogue: 0,0:12:06.28,0:12:08.30,Default,,0000,0000,0000,,I don't like it, Dad!
Dialogue: 0,0:12:08.30,0:12:11.33,Default,,0000,0000,0000,,Ой. (Тасбақа гермит) Хм!
Dialogue: 0,0:12:11.33,0:12:15.37,Default,,0000,0000,0000,,Какарот, баланы өз қамқорлығыңызда ұстауыңызды өтінемін.
Dialogue: 0,0:12:15.37,0:12:19.41,Default,,0000,0000,0000,,Оның тірі қалғанын қаласаңыз, мына ағамыздың бұйрығын тыңдаңыз.
Dialogue: 0,0:12:19.41,0:12:24.79,Default,,0000,0000,0000,,Читчикушо.
Dialogue: 0,0:12:24.79,0:12:28.83,Default,,0000,0000,0000,,Какарот: Мен мұны бір күн ғана жасаймын, ойланыңыз. →
Dialogue: 0,0:12:28.83,0:12:32.87,Default,,0000,0000,0000,,Жарайды, менің топқа қосылудан басқа амалым жоқ шығар.
Dialogue: 0,0:12:32.87,0:12:34.89,Default,,0000,0000,0000,,Уф...
Dialogue: 0,0:12:34.89,0:12:37.92,Default,,0000,0000,0000,,Дегенмен, мен сізге дәлелді көрсетуіңізді сұраймын.
Dialogue: 0,0:12:37.92,0:12:39.94,Default,,0000,0000,0000,,Ах….
Dialogue: 0,0:12:39.94,0:12:44.99,Default,,0000,0000,0000,,Не? Бұл қарапайым. Осы уақытқа дейін ертең →
Dialogue: 0,0:12:44.99,0:12:48.03,Default,,0000,0000,0000,,Осы планетада шамамен 100 адамды өлтіру→
Dialogue: 0,0:12:48.03,0:12:50.05,Default,,0000,0000,0000,,Мәйітті осында үйіп таста.
Dialogue: 0,0:12:50.05,0:12:52.05,Default,,0000,0000,0000,,Уф!
Dialogue: 0,0:12:55.10,0:12:57.12,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:12:57.12,0:13:02.17,Default,,0000,0000,0000,,Сіз мұны естідіңіз бе? Мен ертеңді асыға күтемін.
Dialogue: 0,0:13:02.17,0:13:07.22,Default,,0000,0000,0000,,Менің інімнің баласы. Мүмкін болса, мен де оны өлтіргім келмейді.
Dialogue: 0,0:13:07.22,0:13:10.25,Default,,0000,0000,0000,,Мен қорқамын, әке! Хехехе.
Dialogue: 0,0:13:10.25,0:13:13.28,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:13:13.28,0:13:16.31,Default,,0000,0000,0000,,Уу-у~.
Dialogue: 0,0:13:16.31,0:13:20.35,Default,,0000,0000,0000,,Гохан Коншақ...
Dialogue: 0,0:13:20.35,0:13:23.72,Default,,0000,0000,0000,,Хехехехе. →
Dialogue: 0,0:13:23.72,0:13:26.72,Default,,0000,0000,0000,,Осы жолы соңына дейін шайқасамын!
Dialogue: 0,0:14:38.47,0:14:41.50,Default,,0000,0000,0000,,Жарайсың ба? Тағы бір рет еске салайын.
Dialogue: 0,0:14:41.50,0:14:45.54,Default,,0000,0000,0000,,Ертеңге дейін осы планетада 100 адамды өлтіріңіз→
Dialogue: 0,0:14:45.54,0:14:48.57,Default,,0000,0000,0000,,Мәйіттердің үйіліп жатқан жері.
Dialogue: 0,0:14:48.57,0:14:52.61,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:14:52.61,0:14:56.65,Default,,0000,0000,0000,,Олай болса сені қатарымызға қосамыз.
Dialogue: 0,0:14:56.65,0:15:02.71,Default,,0000,0000,0000,,Әрине, мәйіт болмаса, ұлың өледі.
Dialogue: 0,0:15:02.71,0:15:05.74,Default,,0000,0000,0000,,Баланы пайдаланып қалуға не жетсін!
Dialogue: 0,0:15:05.74,0:15:07.76,Default,,0000,0000,0000,,Дұрыс. (Кәме-сеннин) Дұрыс.
Dialogue: 0,0:15:07.76,0:15:12.81,Default,,0000,0000,0000,,Гоку ешкімді өлтіре алмайды!
Dialogue: 0,0:15:12.81,0:15:16.85,Default,,0000,0000,0000,,Жақсы. Бұл жігіт өлсе →
Dialogue: 0,0:15:16.85,0:15:21.90,Default,,0000,0000,0000,,100 мәйітті дайындаудың қажеті жоқ.
Dialogue: 0,0:15:21.90,0:15:29.98,Default,,0000,0000,0000,,Дегенмен, бұл планетадағы адамдар жақын болашақта жойылып кетуі мүмкін.
Dialogue: 0,0:15:29.98,0:15:33.35,Default,,0000,0000,0000,,Келесі жұлдызға шабуыл жасап, оны жеңгеннен кейін келесі нысана → болады
Dialogue: 0,0:15:33.35,0:15:36.38,Default,,0000,0000,0000,,Мен осы жұлдыз туралы шешім қабылдадым. (Барлығы) Иә!?
Dialogue: 0,0:15:36.38,0:15:39.41,Default,,0000,0000,0000,,Не?! Хехехехе.
Dialogue: 0,0:15:39.41,0:15:44.46,Default,,0000,0000,0000,,Осы планетаның жігіттері бізге құласа, үш Сайян→
Dialogue: 0,0:15:44.46,0:15:47.49,Default,,0000,0000,0000,,Ол бір айдан кейін жойылады.
Dialogue: 0,0:15:47.49,0:15:50.52,Default,,0000,0000,0000,,Хмф!
Dialogue: 0,0:15:50.52,0:15:52.54,Default,,0000,0000,0000,,Уф….
Dialogue: 0,0:15:52.54,0:15:54.56,Default,,0000,0000,0000,,Әке!
Dialogue: 0,0:15:54.56,0:15:59.61,Default,,0000,0000,0000,,Түсіндім, Какарот. Қанша тырыссам да →
Dialogue: 0,0:15:59.61,0:16:02.64,Default,,0000,0000,0000,,Бұл ағалардың қатарына қосылудан басқа амалыңыз жоқ.
Dialogue: 0,0:16:02.64,0:16:05.67,Default,,0000,0000,0000,,Әй, баланы маған қайтар!
Dialogue: 0,0:16:05.67,0:16:11.73,Default,,0000,0000,0000,,Хмф, мен жақсы жауап күтемін.
Dialogue: 0,0:16:11.73,0:16:14.76,Default,,0000,0000,0000,,Сіз үшін де.
Dialogue: 0,0:16:14.76,0:16:18.80,Default,,0000,0000,0000,,Уф. Оған қарсы шығуды тіпті ойламаңыз.
Dialogue: 0,0:16:18.80,0:16:21.83,Default,,0000,0000,0000,,Ах! Хехехе. →
Dialogue: 0,0:16:21.83,0:16:24.86,Default,,0000,0000,0000,,Аяқталмаған жауынгерлік күшіңізбен →
Dialogue: 0,0:16:24.86,0:16:28.90,Default,,0000,0000,0000,,Өйткені, мен бұл ағаға тең келер емеспін!
Dialogue: 0,0:16:28.90,0:16:31.93,Default,,0000,0000,0000,,Әке!
Dialogue: 0,0:16:31.93,0:16:36.31,Default,,0000,0000,0000,,Олай болса, ертеңгі күнді асыға күтемін.
Dialogue: 0,0:16:36.31,0:16:39.34,Default,,0000,0000,0000,,Гохан!!
Dialogue: 0,0:16:39.34,0:16:44.39,Default,,0000,0000,0000,,Хахахаха! Әке!!
Dialogue: 0,0:16:44.39,0:16:49.44,Default,,0000,0000,0000,,Гохан!! Уф... Уф.
Dialogue: 0,0:16:49.44,0:16:51.46,Default,,0000,0000,0000,,Амансың ба? Немересі.
Dialogue: 0,0:16:51.46,0:16:55.50,Default,,0000,0000,0000,,Кешіріңіз. Біз ештеңе істей алмадық.
Dialogue: 0,0:16:55.50,0:16:58.53,Default,,0000,0000,0000,,Гоку.
Dialogue: 0,0:16:58.53,0:17:02.57,Default,,0000,0000,0000,,Судзитун!
Dialogue: 0,0:17:02.57,0:17:05.60,Default,,0000,0000,0000,,Күте тұрыңыз! Ақылсыз болу жағдайды тездетпейді.
Dialogue: 0,0:17:05.60,0:17:07.62,Default,,0000,0000,0000,,Жоқ, сені өлтіреді.
Dialogue: 0,0:17:07.62,0:17:11.66,Default,,0000,0000,0000,,Боқ~ Не істеуім керек?
Dialogue: 0,0:17:11.66,0:17:13.68,Default,,0000,0000,0000,,Ойлан.
Dialogue: 0,0:17:13.68,0:17:16.71,Default,,0000,0000,0000,,Уау.
Dialogue: 0,0:17:16.71,0:17:19.74,Default,,0000,0000,0000,,Мықты.
Dialogue: 0,0:17:19.74,0:17:23.78,Default,,0000,0000,0000,,Бұл таң қалдырды, мен күтпеген жерден жақын туыстарымды таптым→
Dialogue: 0,0:17:23.78,0:17:26.81,Default,,0000,0000,0000,,Соған ұқсас.
Dialogue: 0,0:17:26.81,0:17:31.86,Default,,0000,0000,0000,,Сенің ағаң онша күшті емес.
Dialogue: 0,0:17:31.86,0:17:34.22,Default,,0000,0000,0000,,Бұл құйрық. (Барлығы) иә?
Dialogue: 0,0:17:34.22,0:17:38.26,Default,,0000,0000,0000,,Оның... Құйрығын мықтап ұстасаң→
Dialogue: 0,0:17:38.26,0:17:41.29,Default,,0000,0000,0000,,Сіз өзіңізді әлсіз сезінуіңіз керек.
Dialogue: 0,0:17:41.29,0:17:43.31,Default,,0000,0000,0000,,Ола солай болды.
Dialogue: 0,0:17:43.31,0:17:48.36,Default,,0000,0000,0000,,Бірақ сіз оның құйрығын ұстай аласыз ба?
Dialogue: 0,0:17:48.36,0:17:52.40,Default,,0000,0000,0000,,Балалар, сендер мұны істей алмайсыңдар. (Криллин, Мастер Роши) Иә?
Dialogue: 0,0:17:52.40,0:17:54.42,Default,,0000,0000,0000,,Иә?
Dialogue: 0,0:17:54.42,0:17:57.42,Default,,0000,0000,0000,,Пикколо!
Dialogue: 0,0:18:04.52,0:18:07.55,Default,,0000,0000,0000,,Оның күші ерекше→
Dialogue: 0,0:18:07.55,0:18:09.57,Default,,0000,0000,0000,,Сіз түсінуіңіз керек еді.
Dialogue: 0,0:18:09.57,0:18:15.63,Default,,0000,0000,0000,,Сен де, мен де олармен дұрыс бәсекелесе алмаймыз.
Dialogue: 0,0:18:15.63,0:18:21.69,Default,,0000,0000,0000,,Дегенмен, сіз бен біз бірге жұмыс жасасақ, оны жеңу мүмкіндігіміз аз.
Dialogue: 0,0:18:21.69,0:18:26.74,Default,,0000,0000,0000,,Қандай жел соғып тұрсың?
Dialogue: 0,0:18:26.74,0:18:28.76,Default,,0000,0000,0000,,Мені қате түсінбеңіз.
Dialogue: 0,0:18:28.76,0:18:32.97,Default,,0000,0000,0000,,Мен тыныштықпен оянғандай емес.
Dialogue: 0,0:18:32.97,0:18:36.18,Default,,0000,0000,0000,,Маған сенің ұлың бәрібір.
Dialogue: 0,0:18:36.18,0:18:40.22,Default,,0000,0000,0000,,Қарғыс атсын. Менің мақсатым – әлемді бағындыру →
Dialogue: 0,0:18:40.22,0:18:42.24,Default,,0000,0000,0000,,Ол жай ғана мазасыз!
Dialogue: 0,0:18:42.24,0:18:45.27,Default,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:18:45.27,0:18:51.33,Default,,0000,0000,0000,,Сізбен біріккен екі жігіт пен жігіттерді тазалап болған соң →
Dialogue: 0,0:18:51.33,0:18:56.38,Default,,0000,0000,0000,,Әрине, осыдан кейін мен сені жермен жексен етемін және бұл жолы →
Dialogue: 0,0:18:56.38,0:18:59.41,Default,,0000,0000,0000,,Дүниені өз қолыма алуға ниетім бар.
Dialogue: 0,0:18:59.41,0:19:01.43,Default,,0000,0000,0000,,Мен саған бұлай істеуге рұқсат бермеймін.
Dialogue: 0,0:19:01.43,0:19:03.45,Default,,0000,0000,0000,,Иә? Мен сізге бұлай істеуге рұқсат бермеймін →
Dialogue: 0,0:19:03.45,0:19:07.49,Default,,0000,0000,0000,,Екі адам бірге жұмыс істегенде жақсы идея.
Dialogue: 0,0:19:07.49,0:19:10.52,Default,,0000,0000,0000,,Қараңызшы, бұл жалғыз жол.
Dialogue: 0,0:19:10.52,0:19:14.52,Default,,0000,0000,0000,,Міне. Мен ұстаймын деп ойлаймын.
Dialogue: 0,0:19:20.62,0:19:26.68,Default,,0000,0000,0000,,Мен сенімен бірігіп кетсем, тіпті ренжіп қалар едім.
Dialogue: 0,0:19:26.68,0:19:29.71,Default,,0000,0000,0000,,Булма, маған Айдаһар радарын қарызға бер.
Dialogue: 0,0:19:29.71,0:19:32.40,Default,,0000,0000,0000,,Не? Иә.
Dialogue: 0,0:19:32.40,0:19:34.09,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:19:34.09,0:19:38.13,Default,,0000,0000,0000,,Синтун жылдамдығына ілесе аласыз ба?
Dialogue: 0,0:19:38.13,0:19:41.16,Default,,0000,0000,0000,,Өзіңізді алдамаңыз! Менікі сен сияқты →
Dialogue: 0,0:19:41.16,0:19:44.19,Default,,0000,0000,0000,,Бұл патетикалық би техникасынан мүлдем басқаша.
Dialogue: 0,0:19:44.19,0:19:46.21,Default,,0000,0000,0000,,Иә.
Dialogue: 0,0:19:46.21,0:19:57.32,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:19:57.32,0:20:03.38,Default,,0000,0000,0000,,～ ～ ～
Dialogue: 0,0:20:03.38,0:20:05.40,Default,,0000,0000,0000,,Ал...
Dialogue: 0,0:20:05.40,0:20:10.45,Default,,0000,0000,0000,,Иә? Бұл біртүрлі ескерту сигналы.
Dialogue: 0,0:20:10.45,0:20:12.47,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:20:12.47,0:20:16.51,Default,,0000,0000,0000,,Жауынгерлік қуат 710 немесе одан да көп.
Dialogue: 0,0:20:16.51,0:20:20.55,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:20:20.55,0:20:22.57,Default,,0000,0000,0000,,Не!? (жылау)
Dialogue: 0,0:20:22.57,0:20:26.61,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:20:26.61,0:20:28.63,Default,,0000,0000,0000,,Біраз ашық емес пе?
Dialogue: 0,0:20:28.63,0:20:31.66,Default,,0000,0000,0000,,Боқ~ Ақаулық бар ма? →
Dialogue: 0,0:20:31.66,0:20:33.66,Default,,0000,0000,0000,,Қорқыту.
Dialogue: 0,0:20:36.04,0:20:38.06,Default,,0000,0000,0000,,Төмен түсіп, жақындау уақыты келді.
Dialogue: 0,0:20:38.06,0:20:41.09,Default,,0000,0000,0000,,Бұл пайдасыз. Тек осылай жүре бер.
Dialogue: 0,0:20:41.09,0:20:45.13,Default,,0000,0000,0000,,Не? Ол машина пайдаланады.
Dialogue: 0,0:20:45.13,0:20:50.18,Default,,0000,0000,0000,,Нысананың орнын және оның күшін көруге болады.
Dialogue: 0,0:20:50.18,0:20:52.20,Default,,0000,0000,0000,,Олай болса, Оралар жақындап келеді...
Dialogue: 0,0:20:52.20,0:20:55.23,Default,,0000,0000,0000,,Әрине, сіз байқағаныңыз жөн еді.
Dialogue: 0,0:20:55.23,0:20:57.25,Default,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:20:57.25,0:21:01.29,Default,,0000,0000,0000,,Жалғыз жол - оны тікелей орындау.
Dialogue: 0,0:21:01.29,0:21:03.31,Default,,0000,0000,0000,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:21:03.31,0:21:05.33,Default,,0000,0000,0000,,Тағы да. Пеп!
Dialogue: 0,0:21:05.33,0:21:10.38,Default,,0000,0000,0000,,Жауынгерлік күш 710.
Dialogue: 0,0:21:10.38,0:21:13.41,Default,,0000,0000,0000,,Цк. Бұл ақаулық па?
Dialogue: 0,0:21:13.41,0:21:17.45,Default,,0000,0000,0000,,《Иә? Екі реакция бар》
Dialogue: 0,0:21:17.45,0:21:19.45,Default,,0000,0000,0000,,Ол осында келе жатыр.
Dialogue: 0,0:21:21.49,0:21:27.55,Default,,0000,0000,0000,,Бір немесе екі. Жауынгерлік қуат 322 және 334. →
Dialogue: 0,0:21:27.55,0:21:32.43,Default,,0000,0000,0000,,Біреуінің қабілеті Какарот сияқты. →
Dialogue: 0,0:21:32.43,0:21:35.96,Default,,0000,0000,0000,,Бірақ ол келе алмайды. →
Dialogue: 0,0:21:35.96,0:21:40.01,Default,,0000,0000,0000,,Сіздің жеңу мүмкіндігіңіз нөлге жақын екенін жақсы білуіңіз керек.
Dialogue: 0,0:21:40.01,0:21:45.06,Default,,0000,0000,0000,,1 Бұл жерді табу мүмкін емес. →
Dialogue: 0,0:21:45.06,0:21:50.11,Default,,0000,0000,0000,,Кешіріңіз, ол мүлдем істен шықты.
Dialogue: 0,0:21:50.11,0:21:53.14,Default,,0000,0000,0000,,Жоқ! →
Dialogue: 0,0:21:53.14,0:21:55.14,Default,,0000,0000,0000,,Міне келді!
Dialogue: 0,0:22:00.21,0:22:02.23,Default,,0000,0000,0000,,Иә! Ха!
Dialogue: 0,0:22:02.23,0:22:17.23,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:22:19.40,0:22:23.44,Default,,0000,0000,0000,,Сіз бұл жер туралы қайдан білдіңіз? Мен саған айтамын!
Dialogue: 0,0:22:23.44,0:22:26.47,Default,,0000,0000,0000,,А... Жарайды.
Dialogue: 0,0:22:26.47,0:22:29.50,Default,,0000,0000,0000,,Енді басқа сұрақ қояйын.
Dialogue: 0,0:22:29.50,0:22:32.87,Default,,0000,0000,0000,,Балалар сендер мұнда не үшін келдіңдер?
Dialogue: 0,0:22:32.87,0:22:37.92,Default,,0000,0000,0000,,Оланың баласын қайтаруға келгеніңізге сенімдімін!
Dialogue: 0,0:22:37.92,0:22:41.96,Default,,0000,0000,0000,,Яғни, олар бір Сайян болса да→
Dialogue: 0,0:22:41.96,0:22:44.99,Default,,0000,0000,0000,,Бұл сіздің топқа қосылғыңыз келмейтінін білдіре ме?
Dialogue: 0,0:22:44.99,0:22:46.01,Default,,0000,0000,0000,,Мен айттым ғой!
Dialogue: 0,0:22:46.01,0:22:50.05,Default,,0000,0000,0000,,Сен ағаңның айтқанын орындамайсың.
Dialogue: 0,0:22:50.05,0:22:53.05,Default,,0000,0000,0000,,Ей, үлкен аға жоқ!
Dialogue: 0,0:22:55.10,0:22:57.12,Default,,0000,0000,0000,,Какарот. →
Dialogue: 0,0:22:57.12,0:23:03.18,Default,,0000,0000,0000,,Мен сені аздап ақылдырақ болар деп ойладым.
Dialogue: 0,0:23:03.18,0:23:07.22,Default,,0000,0000,0000,,Менің ойымша, сіз бұл туралы айта аласыз.
Dialogue: 0,0:23:07.22,0:23:09.24,Default,,0000,0000,0000,,《Иә? →
Dialogue: 0,0:23:09.24,0:23:11.26,Default,,0000,0000,0000,,Жауынгерлік күш 408-ге дейін артты》
Dialogue: 0,0:23:11.26,0:23:14.29,Default,,0000,0000,0000,,Түсіндім, сен де қатты дайындалып жатырсың.
Dialogue: 0,0:23:14.29,0:23:16.29,Default,,0000,0000,0000,,《Иә?》
Dialogue: 0,0:23:18.33,0:23:22.37,Default,,0000,0000,0000,,Мүмкін біз мұнымен жақсырақ күресе аламыз.
Dialogue: 0,0:23:22.37,0:23:27.42,Default,,0000,0000,0000,,《Какарот 416》
Dialogue: 0,0:23:27.42,0:23:30.45,Default,,0000,0000,0000,,А... уахахаха! →
Dialogue: 0,0:23:30.45,0:23:33.81,Default,,0000,0000,0000,,Балалар! Сіз күшті болуға тырысасыз ба?
Dialogue: 0,0:23:33.81,0:23:35.83,Default,,0000,0000,0000,,Не!? Иә!?
Dialogue: 0,0:23:35.83,0:23:40.88,Default,,0000,0000,0000,,Мені күлдір. Мен мұндай бала келеді деп күтпедім. →
Dialogue: 0,0:23:40.88,0:23:43.91,Default,,0000,0000,0000,,Надандық деген осы.
Dialogue: 0,0:23:43.91,0:23:47.95,Default,,0000,0000,0000,,Бәсекелестікте тек күшті болу ғана емес!
Dialogue: 0,0:23:47.95,0:23:51.99,Default,,0000,0000,0000,,Иә? Бізде стратегия бар!
Dialogue: 0,0:23:51.99,0:23:55.03,Default,,0000,0000,0000,,Мен сенің естігеніңді ұмытып қалдым.
Dialogue: 0,0:23:55.03,0:23:57.05,Default,,0000,0000,0000,,Какарот →
Dialogue: 0,0:23:57.05,0:24:01.09,Default,,0000,0000,0000,,Мен сенімен дос болудан бас тарттым.
Dialogue: 0,0:24:01.09,0:24:05.13,Default,,0000,0000,0000,,Бұл жай ғана кедергі болатын сияқты.
Dialogue: 0,0:24:05.13,0:24:09.17,Default,,0000,0000,0000,,Бұл менің отбасым үшін масқара. Өл!
Dialogue: 0,0:24:09.17,0:24:11.17,Default,,0000,0000,0000,,Иә! Ха!
Dialogue: 0,0:24:13.21,0:24:15.23,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:24:15.23,0:24:18.26,Default,,0000,0000,0000,,Уау!
Dialogue: 0,0:24:18.26,0:24:23.31,Default,,0000,0000,0000,,Өлер алдында мен саған бір жақсылық айтайын.
Dialogue: 0,0:24:23.31,0:24:26.34,Default,,0000,0000,0000,,Хехехехе….
Dialogue: 0,0:24:26.34,0:24:29.37,Default,,0000,0000,0000,,Менен басқа аман қалған екі Сайян →
Dialogue: 0,0:24:29.37,0:24:33.41,Default,,0000,0000,0000,,Сіздің жауынгерлік күшіңіз менікінен де жоғары.
Dialogue: 0,0:24:33.41,0:24:36.44,Default,,0000,0000,0000,,Ах…. Эх...
Dialogue: 0,0:24:36.44,0:24:38.46,Default,,0000,0000,0000,,<Бұрын-соңды болмаған қорқыныш. →
Dialogue: 0,0:24:38.46,0:24:43.51,Default,,0000,0000,0000,,Радицті жеңсең де, әлі де күшті жауынгерлер бар ма? →
Dialogue: 0,0:24:43.51,0:24:48.51,Default,,0000,0000,0000,,Гоку мен Пикколо туралы ештеңе істеуге болмайды!?>
Dialogue: 0,0:24:51.59,0:24:56.64,Default,,0000,0000,0000,,『ＹｅａｈＢｒｅａｋＣａｒｅＢｒｅａｋ』
Dialogue: 0,0:24:56.64,0:25:16.84,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:16.84,0:25:36.37,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:36.37,0:25:49.37,Default,,0000,0000,0000,,Сен
Dialogue: 0,0:25:51.52,0:25:54.55,Default,,0000,0000,0000,,Сәлем, Гоку! Қарғыс атсын, Радиц деген жігіт сондай күшті.
Dialogue: 0,0:25:54.55,0:25:56.57,Default,,0000,0000,0000,,Тісімді көтере алмайтын сияқтымын. Сон Гоку. →
Dialogue: 0,0:25:56.57,0:25:59.60,Default,,0000,0000,0000,,Мен саған өзімнің жаңа трюкімді көрсетемін. →
Dialogue: 0,0:25:59.60,0:26:02.63,Default,,0000,0000,0000,,Егер бұл жұмыс істемесе, оны жеңудің жолы жоқ.
Dialogue: 0,0:26:02.63,0:26:05.66,Default,,0000,0000,0000,,Жарайды, бұл бір немесе екіншісі. Оны тоқтатуға тырысайық.
Dialogue: 0,0:26:05.66,0:26:08.66,Default,,0000,0000,0000,,Келесі жолы «Айдаһар доп Кай»….
Dialogue: 0,0:26:11.72,0:26:13.72,Default,,0000,0000,0000,,Әкеңді қорлама!
Dialogue: 0,0:26:15.22,0:26:21.22,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory