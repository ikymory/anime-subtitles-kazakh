Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:34.22,0:00:37.74,Default,,0,0,0,,<Бұл шығармада не жасырылды...>
Dialogue: 0,0:00:37.74,0:00:40.23,Default,,0,0,0,,＜…Көп шу! ＞
Dialogue: 0,0:00:40.23,0:00:41.73,Default,,0,0,0,,<Солай...>
Dialogue: 0,0:00:45.80,0:00:47.30,Default,,0,0,0,,Эх!
Dialogue: 0,0:00:53.24,0:00:55.24,Default,,0,0,0,,<Супер танымал кумир...>
Dialogue: 0,0:00:56.73,0:01:01.23,Default,,0,0,0,,<Соңғы аниме өндірісінің сайты туралы толығырақ соңғы мерзім жақындаған сайын →
Dialogue: 0,0:01:01.23,0:01:03.24,Default,,0,0,0,,Гонкун жасырын түрде кіріп келеді! ＞
Dialogue: 0,0:01:03.24,0:01:06.74,Default,,0,0,0,,<«Аңшы x аңшыны» білмесеңіз де, жақсы! ＞
Dialogue: 0,0:01:06.74,0:01:09.81,Default,,0,0,0,,<«Рыцарлар» үшін қарапайым аңшылар курсы>
Dialogue: 0,0:01:09.81,0:01:12.81,Default,,0,0,0,,Оланың ерекше қозғалысын қабылдаңыз! (Цучия) Мен Тохоку акцентімен аяқталдым.
Dialogue: 0,0:01:13.75,0:01:16.75,Default,,0,0,0,,<Жаңа фильм нұсқасы туралы толығырақ...>
Dialogue: 0,0:01:19.23,0:01:21.24,Default,,0,0,0,,Яби, бұл керемет...
Dialogue: 0,0:01:21.24,0:01:24.24,Default,,0,0,0,,«Менің бас терісімде қаздар пайда болды»!
Dialogue: 0,0:01:32.33,0:01:36.75,Default,,0,0,0,,Сәлем, менің атым Хироюки Амано. Okada Does Babyon!
Dialogue: 0,0:01:36.75,0:01:38.74,Default,,0,0,0,,Міне, бүгін →
Dialogue: 0,0:01:38.74,0:01:41.26,Default,,0,0,0,,«Аңшы-Аңшының» сүйкімділігі... Жоқ, жоқ, эй!
Dialogue: 0,0:01:41.26,0:01:43.23,Default,,0,0,0,,Не ол?
Dialogue: 0,0:01:43.23,0:01:47.25,Default,,0,0,0,,Дөрекі! Ryogane Saeba Салмағы 100 тонна балға...
Dialogue: 0,0:01:47.25,0:01:49.73,Default,,0,0,0,,«Қала аңшысы»!
Dialogue: 0,0:01:49.73,0:01:51.27,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:01:51.27,0:01:53.30,Default,,0,0,0,,Ей, Окада мырзаның мұндай білімі бар→
Dialogue: 0,0:01:53.30,0:01:55.24,Default,,0,0,0,,Гонкун, не болып жатыр? Осымен.
Dialogue: 0,0:01:55.24,0:01:59.73,Default,,0,0,0,,Окада мырза, егер мені танымасаңыз...
Dialogue: 0,0:01:59.73,0:02:01.74,Default,,0,0,0,,Тоқта! сәл.
Dialogue: 0,0:02:01.74,0:02:03.75,Default,,0,0,0,,Бүгін менің шаруам жоқ. Тоқта!
Dialogue: 0,0:02:03.75,0:02:05.73,Default,,0,0,0,,Бұл шықты! Еріксіз «жабу сықырлауы».
Dialogue: 0,0:02:05.73,0:02:09.75,Default,,0,0,0,,Айтпақшы, Шигемори-чан, сен қалай ойлайсың? «Аңшы х аңшы».
Dialogue: 0,0:02:09.75,0:02:12.30,Default,,0,0,0,,Мен мұны тіпті білмеймін →
Dialogue: 0,0:02:12.30,0:02:17.24,Default,,0,0,0,,Мен Гон-санға тез қарағанымда...
Dialogue: 0,0:02:17.24,0:02:19.23,Default,,0,0,0,,Е! Сондықтан басты кейіпкер екеніңізді естідім →
Dialogue: 0,0:02:19.23,0:02:20.73,Default,,0,0,0,,Эй...
Dialogue: 0,0:02:20.73,0:02:22.23,Default,,0,0,0,,«Сіз әлсіз көрінесіз»!
Dialogue: 0,0:02:22.23,0:02:24.23,Default,,0,0,0,,Шигемори-чан екеуміз, өтінемін.
Dialogue: 0,0:02:24.23,0:02:26.74,Default,,0,0,0,,Екеуіңіз сияқты "Аңшы x аңшыны" білмейтіндер үшін →
Dialogue: 0,0:02:26.74,0:02:30.76,Default,,0,0,0,,Бүгін біз «Аңшы x аңшыны» жақсы көретін комедияларды жинаймыз!
Dialogue: 0,0:02:30.76,0:02:33.31,Default,,0,0,0,,Амано мырза! Мен комедия емеспін!
Dialogue: 0,0:02:33.31,0:02:35.31,Default,,0,0,0,,Мен кумирмін.
Dialogue: 0,0:02:36.25,0:02:38.25,Default,,0,0,0,,Бірақ сіз «Қисумайдың» «Майсацугумиінен» емессіз бе?
Dialogue: 0,0:02:38.25,0:02:40.23,Default,,0,0,0,,Дұрыс, біз де «Майсацугумиді» іске қосамыз→
Dialogue: 0,0:02:40.23,0:02:42.23,Default,,0,0,0,,Менің атым Мията. Сізбен танысқаныма қуаныштымын.
Dialogue: 0,0:02:42.23,0:02:45.24,Default,,0,0,0,,Бұл күндері кез келген кумир... Мен бәрін істеймін.
Dialogue: 0,0:02:45.24,0:02:47.26,Default,,0,0,0,,Өйткені сіз отаку биін де жасай аласыз, солай ма?
Dialogue: 0,0:02:47.26,0:02:49.78,Default,,0,0,0,,Дұрыс. Тек байқап көріңіз.
Dialogue: 0,0:02:49.78,0:02:52.33,Default,,0,0,0,,О, керемет! Біздің істеп жатқанымыз осы.
Dialogue: 0,0:02:52.33,0:02:55.33,Default,,0,0,0,,«Аңшы x аңшы» ойынымен таныссыз ба? Бұл өте егжей-тегжейлі.
Dialogue: 0,0:02:57.75,0:03:00.24,Default,,0,0,0,,Кішкене сабақ алайық, ақыры, ғашық болғым келеді.
Dialogue: 0,0:03:00.24,0:03:02.74,Default,,0,0,0,,Сондай-ақ, менің ойымша...
Dialogue: 0,0:03:05.72,0:03:07.74,Default,,0,0,0,,Эх!
Dialogue: 0,0:03:07.74,0:03:09.24,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:03:09.24,0:03:11.24,Default,,0,0,0,,Оның үстіне рөл...
Dialogue: 0,0:03:14.32,0:03:15.85,Default,,0,0,0,,Дәл керісінше!
Dialogue: 0,0:03:15.85,0:03:17.74,Default,,0,0,0,,«Аңшы x аңшы» фильмінің маған ұнайтыны осы...
Dialogue: 0,0:03:17.74,0:03:20.26,Default,,0,0,0,,Мен оған мүлдем тәуелдімін. Мен аздап қызығушылық таныттым.
Dialogue: 0,0:03:20.26,0:03:22.74,Default,,0,0,0,,Бүгін біз «Аңшы х аңшы» → ұлылығы туралы сөйлесетін боламыз
Dialogue: 0,0:03:22.74,0:03:25.24,Default,,0,0,0,,Мен сені дұрыс оқытқым келеді.
Dialogue: 0,0:03:28.23,0:03:31.23,Default,,0,0,0,,...Болады деген сөз, бәрің!
Dialogue: 0,0:03:31.23,0:03:33.27,Default,,0,0,0,,Қарап көріңіз!
Dialogue: 0,0:03:33.27,0:03:36.77,Default,,0,0,0,,Жарнамаға баратындай әрекет жасамаңыз. Аа, сіз жарнамаға бармайсыз ба?
Dialogue: 0,0:03:40.74,0:03:43.23,Default,,0,0,0,,Күлсін... Мені саған ғашық ететін →
Dialogue: 0,0:03:43.23,0:03:45.25,Default,,0,0,0,,Бұл қиын сияқты.
Dialogue: 0,0:03:45.25,0:03:48.25,Default,,0,0,0,,А, мен осы киберкеңістіктің қожайынымын→
Dialogue: 0,0:03:48.25,0:03:49.75,Default,,0,0,0,,Менің атым Мегуми Хан.
Dialogue: 0,0:03:49.75,0:03:52.74,Default,,0,0,0,,Даусың Гонға ұқсайды ма?
Dialogue: 0,0:03:52.74,0:03:55.26,Default,,0,0,0,,Дұрыс. Гонның дауысы →
Dialogue: 0,0:03:55.26,0:03:57.31,Default,,0,0,0,,Мен не істеп жатырмын.
Dialogue: 0,0:03:57.31,0:03:59.34,Default,,0,0,0,,Бұл жолы мен саған қамқор боламын →
Dialogue: 0,0:03:59.34,0:04:02.25,Default,,0,0,0,,``Hunter x Hunter'' әлеміне қош келдіңіз.
Dialogue: 0,0:04:02.25,0:04:05.25,Default,,0,0,0,,Ең алдымен, «Аңшы x аңшы» негізі →
Dialogue: 0,0:04:05.25,0:04:07.75,Default,,0,0,0,,Біз қызықты білім аламыз ба?
Dialogue: 0,0:04:10.74,0:04:14.24,Default,,0,0,0,,Алдымен осы жерден қараңыз.
Dialogue: 0,0:04:18.31,0:04:21.31,Default,,0,0,0,,<Бұған қарап тұрсаңыз, бәрін түсінесіз! ＞
Dialogue: 0,0:04:24.72,0:04:27.24,Default,,0,0,0,,Сәлеметсіз бе, мен «Рыцарлар»мын. Қолдауыңызға рахмет.
Dialogue: 0,0:04:27.24,0:04:29.74,Default,,0,0,0,,«Аңшы x аңшы» анимесінің жаңа фильмі →
Dialogue: 0,0:04:29.74,0:04:32.74,Default,,0,0,0,,Енді ол көпшілікке ашық болғандықтан, мен көп зерттеулер жүргіздім.
Dialogue: 0,0:04:32.74,0:04:34.74,Default,,0,0,0,,Өтінемін.
Dialogue: 0,0:04:36.73,0:04:39.23,Default,,0,0,0,,Тоғашы мырзаның шедеврін айтсақ...
Dialogue: 0,0:04:40.77,0:04:43.32,Default,,0,0,0,,Бұл қызықты болды. Бұл Юдзо Каяма.
Dialogue: 0,0:04:43.32,0:04:46.74,Default,,0,0,0,,Бұл «Аңшы-Аңшы» да Тоғаши-сенсейдің шығармасы→
Dialogue: 0,0:04:46.74,0:04:50.73,Default,,0,0,0,,Қалай болғанда да, бұл өте танымал жұмыс және тіпті кітап бар →
Dialogue: 0,0:04:50.73,0:04:53.23,Default,,0,0,0,,Өте көп... өте көп... Біраз болуы мүмкін.
Dialogue: 0,0:04:53.23,0:04:57.25,Default,,0,0,0,,Жарияланған даналардың жалпы саны таңқаларлық.
Dialogue: 0,0:04:57.25,0:04:59.74,Default,,0,0,0,,Әркімде бар, достарым. Барлығында бар.
Dialogue: 0,0:04:59.74,0:05:02.79,Default,,0,0,0,,Енді бұл Такеда, солай ма? Бұл мүмкін емес!
Dialogue: 0,0:05:02.79,0:05:05.23,Default,,0,0,0,,Айналаңыздағы адамдарды ұру мүмкін емес.
Dialogue: 0,0:05:05.23,0:05:08.73,Default,,0,0,0,,Мен қазір көшірмелерді санап жатырмын. Бұл есептелетін сан емес.
Dialogue: 0,0:05:08.73,0:05:11.23,Default,,0,0,0,,Бұл Ямашита, солай ма? Менде де аз емес.
Dialogue: 0,0:05:11.23,0:05:14.74,Default,,0,0,0,,Қалай болғанда да, менде олар өте көп, олар керемет туындылар.
Dialogue: 0,0:05:14.74,0:05:16.74,Default,,0,0,0,,Оның қаншалықты ғажайып екенін айтып жеткізе алмаймын.
Dialogue: 0,0:05:18.26,0:05:21.31,Default,,0,0,0,,<Онда дұрыстап түсіндірейін>
Dialogue: 0,0:05:21.31,0:05:23.31,Default,,0,0,0,,<“Аңшы x Аңшы” бұл…>
Dialogue: 0,0:05:25.25,0:05:28.25,Default,,0,0,0,,<Иосихиро Тогашидің өте танымал мангасы>
Dialogue: 0,0:05:38.74,0:05:42.31,Default,,0,0,0,,<Әңгіменің басты кейіпкері...>
Dialogue: 0,0:05:42.31,0:05:45.81,Default,,0,0,0,,<Кішкентай аралда тұратын 12 жасар бала>
Dialogue: 0,0:05:48.25,0:05:50.74,Default,,0,0,0,,<Ұлы аңшы әке Джиннің ізімен→
Dialogue: 0,0:05:50.74,0:05:54.74,Default,,0,0,0,,Ол өзі аңшы болу үшін аралдан кетеді＞
Dialogue: 0,0:06:03.29,0:06:05.32,Default,,0,0,0,,<Қатаң емтиханнан өтсең→
Dialogue: 0,0:06:05.32,0:06:08.74,Default,,0,0,0,,Сіз кәсіби аңшы бола аласыз＞
Dialogue: 0,0:06:08.74,0:06:10.76,Default,,0,0,0,,Жасың нешеде? 12 жаста.
Dialogue: 0,0:06:10.76,0:06:13.76,Default,,0,0,0,,<Гон аңшы емтиханын тапсырды...>
Dialogue: 0,0:06:15.25,0:06:17.73,Default,,0,0,0,,＜... сияқты достармен танысу＞
Dialogue: 0,0:06:17.73,0:06:20.74,Default,,0,0,0,,<Олармен көптеген сынақтарды жеңу→
Dialogue: 0,0:06:20.74,0:06:23.26,Default,,0,0,0,,Гон керемет...＞
Dialogue: 0,0:06:23.26,0:06:25.76,Default,,0,0,0,,<Мен кәсіби аңшы болдым>
Dialogue: 0,0:06:27.34,0:06:30.73,Default,,0,0,0,,Енді кейіпкерлерге тоқталайық.
Dialogue: 0,0:06:30.73,0:06:33.73,Default,,0,0,0,,Басты кейіпкер...
Dialogue: 0,0:06:33.73,0:06:35.23,Default,,0,0,0,,Бұл ұзақ. Біраз ұзақ.
Dialogue: 0,0:06:35.23,0:06:38.24,Default,,0,0,0,,Гон Накаяма айып добын орындай алмады.
Dialogue: 0,0:06:38.24,0:06:42.26,Default,,0,0,0,,Gon Freecss. Гонның ең жақын досы.
Dialogue: 0,0:06:42.26,0:06:46.28,Default,,0,0,0,,Аты аңызға айналған өлтіруші отбасының баласы...
Dialogue: 0,0:06:46.28,0:06:49.85,Default,,0,0,0,,Бұл Киллуа. Ол тым түзу. Оның кісі өлтіру ниеті бар.
Dialogue: 0,0:06:49.85,0:06:55.35,Default,,0,0,0,,Менің де басқа достарым бар, сондықтан мен үнемі сабырлы, жинақы...
Dialogue: 0,0:06:56.24,0:06:59.24,Default,,0,0,0,,Капибаралар сабырлы, бірақ көп қозғалмайды.
Dialogue: 0,0:06:59.24,0:07:04.24,Default,,0,0,0,,Сондай-ақ өте сөйлейтін және іскерлік келіссөздерді өте жақсы білетін тағы бір адам бар...
Dialogue: 0,0:07:05.75,0:07:08.23,Default,,0,0,0,,Қарттарды алдасаң, олай етпе.
Dialogue: 0,0:07:08.23,0:07:11.27,Default,,0,0,0,,Бұл төрт адам шын мәнінде аңшы емтиханын тапсырды→
Dialogue: 0,0:07:11.27,0:07:13.81,Default,,0,0,0,,Сіз кәсіби аңшысыз, солай ма? Бұл дұрыс.
Dialogue: 0,0:07:13.81,0:07:17.24,Default,,0,0,0,,Осы кәсіпқой аңшы өткен бойда →
Dialogue: 0,0:07:17.24,0:07:20.23,Default,,0,0,0,,Олар Аңшылар қауымдастығы деп аталатын ұйымға жатады.
Dialogue: 0,0:07:20.23,0:07:22.25,Default,,0,0,0,,Аңшылар қауымдастығы бар.
Dialogue: 0,0:07:22.25,0:07:26.75,Default,,0,0,0,,Ол осы Аңшылар қауымдастығының жоғарғы жағында билік етеді...
Dialogue: 0,0:07:26.75,0:07:29.74,Default,,0,0,0,,Иә, не болды?
Dialogue: 0,0:07:29.74,0:07:32.26,Default,,0,0,0,,Не болды? Кенеттен не болды? Ұйқыңыз келе ме?
Dialogue: 0,0:07:32.26,0:07:36.34,Default,,0,0,0,,Мен ұйықтап жатырмын. Бұл жақсы емес. Қазір үйде ұйықта.
Dialogue: 0,0:07:36.34,0:07:38.23,Default,,0,0,0,,Аа, Төраға Нетеро деген адам бар... Төраға Нетеро шықты.
Dialogue: 0,0:07:38.23,0:07:40.75,Default,,0,0,0,,Төраға Нетеро керемет түрде пайда болды.
Dialogue: 0,0:07:40.75,0:07:43.75,Default,,0,0,0,,Бұл Нетеро Төрағасы мен Гон алғаш рет кездескен кезде → болды
Dialogue: 0,0:07:43.75,0:07:47.24,Default,,0,0,0,,Гон аңшы емтиханын тапсырудың ортасында болды, солай ма?
Dialogue: 0,0:07:47.24,0:07:50.24,Default,,0,0,0,,Мен сенімдімін дирижабльде келесі сынақ алаңына →
Dialogue: 0,0:07:50.24,0:07:54.28,Default,,0,0,0,,Гон мен Киллуа төраға Нетеродан допты ұрлаған ойын→
Dialogue: 0,0:07:54.28,0:07:56.83,Default,,0,0,0,,Мен бастадым. Бұл ойынға не болды?
Dialogue: 0,0:07:56.83,0:07:59.23,Default,,0,0,0,,Соңында мен допты ұрлай алмадым.
Dialogue: 0,0:07:59.23,0:08:01.72,Default,,0,0,0,,Менің ойымша, Гонның көңілі қалды.
Dialogue: 0,0:08:01.72,0:08:04.24,Default,,0,0,0,,Мүлдем, Гонның көзқарасы бойынша, сол доппен→
Dialogue: 0,0:08:04.24,0:08:07.74,Default,,0,0,0,,Ол айып добын орындауы керек еді. Бұл Гон Накаяма!
Dialogue: 0,0:08:09.74,0:08:12.73,Default,,0,0,0,,<Енді, аңшылар және аңшылар қауымдастығы туралы→
Dialogue: 0,0:08:12.73,0:08:15.28,Default,,0,0,0,,Мен егжей-тегжейлі түсіндіремін＞
Dialogue: 0,0:08:15.28,0:08:19.25,Default,,0,0,0,,<Аңшылардың ең үлкен қаруы деп атауға болатын белгілі бір қабілет бар.>
Dialogue: 0,0:08:19.25,0:08:20.75,Default,,0,0,0,,<Бұл...>
Dialogue: 0,0:08:22.24,0:08:25.24,Default,,0,0,0,,<Тәнімнен тасып...>
Dialogue: 0,0:08:29.23,0:08:33.73,Default,,0,0,0,,<Аңшылар бұл «Ненді» жаулармен күресу үшін пайдаланады>
Dialogue: 0,0:08:35.80,0:08:37.80,Default,,0,0,0,,Ах...!!
Dialogue: 0,0:08:39.74,0:08:42.23,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:42.23,0:08:44.73,Default,,0,0,0,,Бля сен ақымақ...
Dialogue: 0,0:08:47.75,0:08:49.25,Default,,0,0,0,,Гаха!
Dialogue: 0,0:08:49.25,0:08:53.24,Default,,0,0,0,,<Нен қабілетінің арнайы қимылдары кейіпкерге байланысты өзгереді>
Dialogue: 0,0:08:53.24,0:08:57.33,Default,,0,0,0,,<Бұл «Аңшы-Аңшының» бір сүйкімділігі>
Dialogue: 0,0:08:57.33,0:09:00.33,Default,,0,0,0,,<Айтпақшы, Гонның ерекше қимылы мынау...>
Dialogue: 0,0:09:02.23,0:09:05.75,Default,,0,0,0,,Жан! Кен!
Dialogue: 0,0:09:05.75,0:09:07.74,Default,,0,0,0,,Гу~!!
Dialogue: 0,0:09:07.74,0:09:10.72,Default,,0,0,0,,<Аураңызды жұдырығыңызға салып, мүмкіндігінше жұдырықпен ұрыңыз→
Dialogue: 0,0:09:10.72,0:09:12.74,Default,,0,0,0,,Бұл күшті соққы＞
Dialogue: 0,0:09:12.74,0:09:17.78,Default,,0,0,0,,<Қазір командаға 600 кәсіби аңшы кіреді→
Dialogue: 0,0:09:17.78,0:09:20.83,Default,,0,0,0,,Аңшылар қауымдастығы туралы түсіндіремін＞
Dialogue: 0,0:09:20.83,0:09:23.83,Default,,0,0,0,,<Осы бірлестіктің басшысы...>
Dialogue: 0,0:09:25.74,0:09:27.22,Default,,0,0,0,,＜Шамамен 20 жыл бұрын→
Dialogue: 0,0:09:27.22,0:09:30.23,Default,,0,0,0,,Жасы 100-ге жуықтады дейтін қария →
Dialogue: 0,0:09:30.23,0:09:33.23,Default,,0,0,0,,Қалай болғанда да, бұл өте күшті! ＞
Dialogue: 0,0:09:34.73,0:09:37.23,Default,,0,0,0,,«Хякушики Каннон».
Dialogue: 0,0:09:39.73,0:09:43.30,Default,,0,0,0,,＜Неннің ең күшті қабілетін басқару «Хьякушики Каннон» →
Dialogue: 0,0:09:43.30,0:09:46.80,Default,,0,0,0,,Барлық аңшылардың басында билік жүргізеді＞
Dialogue: 0,0:09:48.74,0:09:51.23,Default,,0,0,0,,Күтілгендей, «Аңшы x аңшы» фильмінің ең басты ерекшелігі →
Dialogue: 0,0:09:51.23,0:09:54.23,Default,,0,0,0,,Бұл шайқас сахнасы. Бұл әсерлі, солай емес пе?
Dialogue: 0,0:09:55.73,0:09:58.25,Default,,0,0,0,,Жоқ, бұл қандай қабілет?
Dialogue: 0,0:09:58.25,0:10:00.74,Default,,0,0,0,,Бұл нен қабілеті. Өйткені бұл «Nonen Rena қабілеті» емес.
Dialogue: 0,0:10:00.74,0:10:04.74,Default,,0,0,0,,Гонның ерекше қимылы сол қабілетті пайдаланады...
Dialogue: 0,0:10:06.23,0:10:08.25,Default,,0,0,0,,Бұл қандай ерекше қимыл? «Джеджи жұдырық».
Dialogue: 0,0:10:08.25,0:10:11.75,Default,,0,0,0,,Оланың ерекше қозғалысын қабылдаңыз! Мен Тохоку акцентімен аяқталдым.
Dialogue: 0,0:10:11.75,0:10:13.74,Default,,0,0,0,,Ол енді Гон емес, солай ма?
Dialogue: 0,0:10:13.74,0:10:16.25,Default,,0,0,0,,Джедже! Дегенмен, қозғалыстар сәйкес келеді.
Dialogue: 0,0:10:16.25,0:10:18.74,Default,,0,0,0,,Қозғалыс ``Джажанкен'' болса да.
Dialogue: 0,0:10:18.74,0:10:21.26,Default,,0,0,0,,Төрағаның ерекше қимылы таң қалдырады. Ерекше қозғалыс бар.
Dialogue: 0,0:10:21.26,0:10:22.79,Default,,0,0,0,,Нете мырза….
Dialogue: 0,0:10:22.79,0:10:26.25,Default,,0,0,0,,Нацубаппа сияқты айтпа! «Нетеджиджи» деп айту қиын.
Dialogue: 0,0:10:26.25,0:10:29.75,Default,,0,0,0,,Бұл фильмде де көрінеді...
Dialogue: 0,0:10:31.74,0:10:34.26,Default,,0,0,0,,Тек «формула» дұрыс.
Dialogue: 0,0:10:34.26,0:10:36.74,Default,,0,0,0,,Ата: Ол өте күшті.
Dialogue: 0,0:10:36.74,0:10:38.76,Default,,0,0,0,,«Қария өте күшті» қысқаша →
Dialogue: 0,0:10:38.76,0:10:41.28,Default,,0,0,0,,Ол «GMT» деп аталады. Оны жіберіп алмаңыз! сен.
Dialogue: 0,0:10:41.28,0:10:43.31,Default,,0,0,0,,Сол кезде туған жеріме қайтатын шығармын.
Dialogue: 0,0:10:43.31,0:10:45.23,Default,,0,0,0,,"Ама-чанды" ұмытатын кезің аз қалды ма?
Dialogue: 0,0:10:45.23,0:10:47.75,Default,,0,0,0,,Сондай-ақ, аңшылардың әртүрлі түрлері бар.
Dialogue: 0,0:10:47.75,0:10:51.24,Default,,0,0,0,,Bounty Hunter және т.б. Treasure Hunter т.б. →
Dialogue: 0,0:10:51.24,0:10:53.76,Default,,0,0,0,,Аңшылардың әртүрлі түрлері бар.
Dialogue: 0,0:10:53.76,0:10:57.23,Default,,0,0,0,,Сондай-ақ дәмді тағамдарды жеуге ұмтылатын талғампаз аңшылар бар.
Dialogue: 0,0:10:57.23,0:11:00.27,Default,,0,0,0,,Сондай-ақ, теңіз кірпілерін қуу...
Dialogue: 0,0:11:00.27,0:11:02.30,Default,,0,0,0,,«Ама-чан» дегенді ұмытыңыз.
Dialogue: 0,0:11:02.30,0:11:04.74,Default,,0,0,0,,Сондай-ақ, пұттарды қуу...
Dialogue: 0,0:11:04.74,0:11:06.24,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:11:06.24,0:11:09.24,Default,,0,0,0,,Арата Фурута туралы ''Аңшы x Аңшы'' сияқты сөйлеме.
Dialogue: 0,0:11:09.24,0:11:11.76,Default,,0,0,0,,Мұнымен нені айтасыз?
Dialogue: 0,0:11:11.76,0:11:14.75,Default,,0,0,0,,Бұл ақылсыз емес пе! Сіз өзіңізді тым көп мәжбүрлейсіз. Жарайды.
Dialogue: 0,0:11:14.75,0:11:17.25,Default,,0,0,0,,Барлығыңыз, ''Ама-чан'' фильмінің нұсқасы есіңізде ме?
Dialogue: 0,0:11:17.25,0:11:19.25,Default,,0,0,0,,Бұл ''HUNTER x HUNTER'' фильмінің нұсқасы. Бұл туралы алаңдамаңыз.
Dialogue: 0,0:11:19.25,0:11:21.30,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:11:21.30,0:11:23.34,Default,,0,0,0,,Керемет! Бұл жеңіс!
Dialogue: 0,0:11:23.34,0:11:27.74,Default,,0,0,0,,Жоқ, жоқ, бұл «жеңімпаз» емес. Бұл «МАНЗАЙ» емес, судья.
Dialogue: 0,0:11:27.74,0:11:29.73,Default,,0,0,0,,Жоқ, мен көбірек білгім келеді! Мен білгім келеді!
Dialogue: 0,0:11:29.73,0:11:32.23,Default,,0,0,0,,Шигемори-чан, қызықсың ба? Мен де солай ойладым.
Dialogue: 0,0:11:34.73,0:11:36.75,Default,,0,0,0,,Бұл ат құйрығы емес! Нетеро?
Dialogue: 0,0:11:36.75,0:11:38.75,Default,,0,0,0,,Ол осы жаста шынымен күшті, солай ма?
Dialogue: 0,0:11:38.75,0:11:42.26,Default,,0,0,0,,«Хякушики Каннон» өте күшті. Бұл «Хякушики Каннонның» күші.
Dialogue: 0,0:11:42.26,0:11:44.31,Default,,0,0,0,,Бұл сөзсіз күшті.
Dialogue: 0,0:11:44.31,0:11:46.31,Default,,0,0,0,,Мен де...
Dialogue: 0,0:11:50.25,0:11:52.23,Default,,0,0,0,,Жұдырықпен→
Dialogue: 0,0:11:52.23,0:11:55.23,Default,,0,0,0,,Нанды осылай жасайсың...
Dialogue: 0,0:11:56.25,0:11:58.74,Default,,0,0,0,,Демек, дыбыс жылдамдығы...
Dialogue: 0,0:11:58.74,0:12:02.24,Default,,0,0,0,,Тез... Жұдырықтан кейінгі дыбыс естіледі.
Dialogue: 0,0:12:06.82,0:12:10.24,Default,,0,0,0,,Жарық бүгін жарқырап тұр. Сөйлеу Сөйлеу.
Dialogue: 0,0:12:10.24,0:12:13.24,Default,,0,0,0,,Музыкалық шоудан бері ол көп сөйледі.
Dialogue: 0,0:14:22.75,0:14:25.75,Default,,0,0,0,,<Бұрын айтылмаған нәрсе...>
Dialogue: 0,0:14:29.74,0:14:32.26,Default,,0,0,0,,<Бәрі бірнеше ондаған жылдар бұрын басталды→
Dialogue: 0,0:14:32.26,0:14:35.31,Default,,0,0,0,,Нетеро әлі жас кезінде→
Dialogue: 0,0:14:35.31,0:14:39.25,Default,,0,0,0,,Бұрын Аңшылар қауымдастығы қастандықтар мен диверсияларға жауапты →
Dialogue: 0,0:14:39.25,0:14:42.72,Default,,0,0,0,,«Көлеңке»> деген қара жұмыс күші болды
Dialogue: 0,0:14:42.72,0:14:45.72,Default,,0,0,0,,<Сол бөлімді басқарған...>
Dialogue: 0,0:14:45.72,0:14:49.23,Default,,0,0,0,,<Нетеромен бірге қауымдастықты қолдаған элиталық аңшы>
Dialogue: 0,0:14:49.23,0:14:52.78,Default,,0,0,0,,<Алайда, «көлеңке» бірте-бірте радикалданды>
Dialogue: 0,0:14:52.78,0:14:56.22,Default,,0,0,0,,＜Осыған алаңдаған Нетеро ең күшті аңшыларды жинады →
Dialogue: 0,0:14:56.22,0:15:00.72,Default,,0,0,0,,Ол «Сейрин корпусын» басқарды және Джедпен бірге «көлеңкені» жойды.＞
Dialogue: 0,0:15:00.72,0:15:05.23,Default,,0,0,0,,Джед, мұны бітірейік.
Dialogue: 0,0:15:05.23,0:15:07.23,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:15:09.25,0:15:12.25,Default,,0,0,0,,<Және бірнеше ондаған жылдар өткен соң...>
Dialogue: 0,0:15:14.22,0:15:16.22,Default,,0,0,0,,Бұл ностальгиялық.
Dialogue: 0,0:15:21.73,0:15:24.73,Default,,0,0,0,,Аспан аренасы.
Dialogue: 0,0:15:24.73,0:15:28.75,Default,,0,0,0,,<Жауынгерлік Олимпиада өтетін аспан аренасы>
Dialogue: 0,0:15:28.75,0:15:31.30,Default,,0,0,0,,<Онда не пайда болды→
Dialogue: 0,0:15:31.30,0:15:34.74,Default,,0,0,0,,Бұл Джед> болды
Dialogue: 0,0:15:34.74,0:15:36.72,Default,,0,0,0,,Сіз...!
Dialogue: 0,0:15:36.72,0:15:41.73,Default,,0,0,0,,<Ол кек алу үшін ``Көлеңке'' қараңғы тобын басқарып қайта тірілген.>
Dialogue: 0,0:15:41.73,0:15:46.23,Default,,0,0,0,,<«Көлеңке» «Ненге» қарама-қарсы қараңғы қабілетті пайдаланады…>
Dialogue: 0,0:15:52.24,0:15:55.24,Default,,0,0,0,,<Ол күштің көзі - Аңшылар қауымдастығы→
Dialogue: 0,0:15:55.24,0:15:59.24,Default,,0,0,0,,Нетероға деген ашу мен өшпенділік>
Dialogue: 0,0:16:01.23,0:16:02.73,Default,,0,0,0,,Нетеро мырза!
Dialogue: 0,0:16:02.73,0:16:08.74,Default,,0,0,0,,<«Кек» құдіретті күшінен зардап шеккен жолдастар құлады>
Dialogue: 0,0:16:08.74,0:16:12.24,Default,,0,0,0,,Психикалық қабілеті бар әрбір адам бұл дүниеден жоғалады.
Dialogue: 0,0:16:12.24,0:16:14.23,Default,,0,0,0,,«Кек» бәрін басқарады.
Dialogue: 0,0:16:14.23,0:16:16.23,Default,,0,0,0,,<Достарымды сақтау үшін→
Dialogue: 0,0:16:16.23,0:16:19.23,Default,,0,0,0,,Гон да тыйым салынған күшпен айналыса ма? ＞
Dialogue: 0,0:16:19.23,0:16:22.23,Default,,0,0,0,,<Ал қауымдастықтың қараңғылығы неде? ＞
Dialogue: 0,0:16:23.81,0:16:25.32,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:16:25.32,0:16:27.82,Default,,0,0,0,,Бұл қауіпті емес пе?
Dialogue: 0,0:16:29.74,0:16:31.25,Default,,0,0,0,,Ех! Кек күшті емес.
Dialogue: 0,0:16:31.25,0:16:33.73,Default,,0,0,0,,Жоқ, бұл қорқынышты! Әрине, әрине.
Dialogue: 0,0:16:33.73,0:16:36.73,Default,,0,0,0,,Нетеро абсолютті күшке ие→
Dialogue: 0,0:16:36.73,0:16:41.22,Default,,0,0,0,,Түпнұсқа шығармада да Нетероны жеңетін ешкім жоқ→
Dialogue: 0,0:16:41.22,0:16:45.28,Default,,0,0,0,,Бұл Джед мінсіз серігі деп айтылады.
Dialogue: 0,0:16:45.28,0:16:46.81,Default,,0,0,0,,Өте күшті.
Dialogue: 0,0:16:46.81,0:16:50.75,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз фильмді тезірек көргіңіз келеді, солай ма?
Dialogue: 0,0:16:50.75,0:16:55.25,Default,,0,0,0,,Шын мәнінде, бұл фильмнен басқа көруге болатын нәрсе көп.
Dialogue: 0,0:17:01.24,0:17:03.74,Default,,0,0,0,,<Аңшылар қауымдастығының алдына шығу...>
Dialogue: 0,0:17:04.78,0:17:08.78,Default,,0,0,0,,<Бұл адам «көлеңкеге» жетекшілік ететін Джедтің дауысына жауапты болды>
Dialogue: 0,0:17:10.75,0:17:13.24,Default,,0,0,0,,«Біз білеміз.
Dialogue: 0,0:17:13.24,0:17:17.23,Default,,0,0,0,,Аңшылар қауымдастығы сахна артында қаншалықты қанды болды?
Dialogue: 0,0:17:17.23,0:17:19.74,Default,,0,0,0,,Сіз қараңғы тарихты бастан өткердіңіз бе?
Dialogue: 0,0:17:19.74,0:17:24.74,Default,,0,0,0,,<Сонымен қатар, «Көлеңкедегі» жалғыз жауынгер әйел Ренгокудың дауысы...>
Dialogue: 0,0:17:27.82,0:17:31.76,Default,,0,0,0,,«Мен Аңшылар қауымдастығы жасаған қылмыстарды кешірмеймін».
Dialogue: 0,0:17:31.76,0:17:33.72,Default,,0,0,0,,«Қара ұшқынды жазалау платформасы»!
Dialogue: 0,0:17:33.72,0:17:36.73,Default,,0,0,0,,<Және тағы бір мүше...>
Dialogue: 0,0:17:36.73,0:17:40.25,Default,,0,0,0,,Сіз мұнда жете алмайсыз.
Dialogue: 0,0:17:40.25,0:17:42.25,Default,,0,0,0,,<Бұл дауыс осы бағдарламаның MC болып табылады→
Dialogue: 0,0:17:42.25,0:17:44.74,Default,,0,0,0,,Хироюки Амано бұған жауапты>
Dialogue: 0,0:17:44.74,0:17:48.31,Default,,0,0,0,,«Біз сізге өмір бойы адалдық танытамыз →
Dialogue: 0,0:17:48.31,0:17:51.81,Default,,0,0,0,,Мен барлық аңшылардан кек алуға ант етемін».
Dialogue: 0,0:17:55.75,0:17:57.25,Default,,0,0,0,,Ғашық.
Dialogue: 0,0:17:57.25,0:17:59.23,Default,,0,0,0,,<Осыдан кейін «Аңшы х аңшының» сүйкімділігі→
Dialogue: 0,0:17:59.23,0:18:01.73,Default,,0,0,0,,Мен саған көп нәрсені үйретемін! ＞
Dialogue: 0,0:20:19.72,0:20:22.22,Default,,0,0,0,,Енді қайсысын орындаймыз?
Dialogue: 0,0:20:23.73,0:20:27.73,Default,,0,0,0,,«Аңшы x аңшының» үндеуі туралы толық сөйлесейік!
Dialogue: 0,0:20:29.72,0:20:32.22,Default,,0,0,0,,<Өзіңіздің сүйкімділігіңіз туралы айтыңыз! ＞
Dialogue: 0,0:20:36.29,0:20:38.33,Default,,0,0,0,,Иә! (Шиномия) Әңгімелесейік!
Dialogue: 0,0:20:38.33,0:20:40.73,Default,,0,0,0,,Күткендей, Амано мырза бастады.
Dialogue: 0,0:20:40.73,0:20:45.23,Default,,0,0,0,,«Аңшы x аңшы» кітабын оқу өзімді жек көреді!
Dialogue: 0,0:20:48.24,0:20:50.72,Default,,0,0,0,,Е! (Мэдзима) Түсінемін.
Dialogue: 0,0:20:50.72,0:20:53.76,Default,,0,0,0,,Амано мырза, мен толық түсінемін. Не айтқың келеді?
Dialogue: 0,0:20:53.76,0:20:57.33,Default,,0,0,0,,Қалай болғанда да, Шигемори-чан жай ғана: «Ол қосалқы кейіпкер сияқты» деді →
Dialogue: 0,0:20:57.33,0:21:00.75,Default,,0,0,0,,Сіз айтқан Гон басты кейіпкер, бірақ сол Гон →
Dialogue: 0,0:21:00.75,0:21:04.74,Default,,0,0,0,,Мен әкеммен танысқым келеді, сондықтан мен аңшы болып, бар күшімді саламын.
Dialogue: 0,0:21:04.74,0:21:06.24,Default,,0,0,0,,бұл….
Dialogue: 0,0:21:08.24,0:21:09.74,Default,,0,0,0,,Күрсін.
Dialogue: 0,0:21:09.74,0:21:12.23,Default,,0,0,0,,Сонда сіз Киллуа сияқты достар таба аласыз→
Dialogue: 0,0:21:12.23,0:21:14.75,Default,,0,0,0,,Тіпті Киллуаны және т.б. қорғау кезінде→
Dialogue: 0,0:21:14.75,0:21:17.30,Default,,0,0,0,,Сіз өзіңіздің өміріңізді алаңдатпай қорғайсыз.
Dialogue: 0,0:21:17.30,0:21:18.83,Default,,0,0,0,,Содан кейін Киллуа →
Dialogue: 0,0:21:18.83,0:21:20.72,Default,,0,0,0,,«Мен мұны істей аламын ба?»→
Dialogue: 0,0:21:20.72,0:21:23.72,Default,,0,0,0,,Мен уайымдап отырмын, өйткені Гон өте тура алға.
Dialogue: 0,0:21:23.72,0:21:25.72,Default,,0,0,0,,Тым таза. (Шигемори) Түсіндім.
Dialogue: 0,0:21:30.75,0:21:33.75,Default,,0,0,0,,…Тоқта! Иә иә.
Dialogue: 0,0:21:33.75,0:21:36.27,Default,,0,0,0,,Гонға мұндай есептеулер жасаудың қажеті жоқ.
Dialogue: 0,0:21:36.27,0:21:38.82,Default,,0,0,0,,Бұл таза. Бұл керемет. Сондықтан →
Dialogue: 0,0:21:38.82,0:21:41.24,Default,,0,0,0,,Оқыған сайын...
Dialogue: 0,0:21:41.24,0:21:42.74,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:21:42.74,0:21:46.23,Default,,0,0,0,,...Мен әр түрлі нәрселер туралы ойлаймын. Мен түсінемін.
Dialogue: 0,0:21:46.23,0:21:49.23,Default,,0,0,0,,Бұл бөлік мені өзімді жек көреді.
Dialogue: 0,0:21:49.23,0:21:53.72,Default,,0,0,0,,Бірақ басты кейіпкердің өзі сондай тура. Мен түсінемін.
Dialogue: 0,0:21:53.72,0:21:56.79,Default,,0,0,0,,Олай болса, кеттік. Келесі, Мията-кун, өтінемін.
Dialogue: 0,0:21:56.79,0:21:58.31,Default,,0,0,0,,Дегенмен, менің ойымша, бұл жақсы жоспар.
Dialogue: 0,0:21:58.31,0:22:00.24,Default,,0,0,0,,Кеттік! Ұлы рух.
Dialogue: 0,0:22:00.24,0:22:02.24,Default,,0,0,0,,«Аңшы x аңшы» оқу →
Dialogue: 0,0:22:02.24,0:22:05.74,Default,,0,0,0,,Білмей тұрып, ғашық болдың!
Dialogue: 0,0:22:08.72,0:22:10.22,Default,,0,0,0,,Эх!
Dialogue: 0,0:22:10.22,0:22:12.24,Default,,0,0,0,,Сіз ұмыттыңыз ба? А, мен ұмытып қалдым.
Dialogue: 0,0:22:12.24,0:22:14.24,Default,,0,0,0,,Ғашық болған әйелдер ғана емес.
Dialogue: 0,0:22:14.24,0:22:17.31,Default,,0,0,0,,Біз еркектер де ғашық боламыз.
Dialogue: 0,0:22:17.31,0:22:18.81,Default,,0,0,0,,Эх!
Dialogue: 0,0:22:21.23,0:22:23.25,Default,,0,0,0,,Сізге қай кейіпкер ұнайтыны туралы емес пе?
Dialogue: 0,0:22:23.25,0:22:25.75,Default,,0,0,0,,Маған ұнайды, шынымен...
Dialogue: 0,0:22:27.75,0:22:30.74,Default,,0,0,0,,«Фантом труппа» деп аталатын ұрылар тобы→
Dialogue: 0,0:22:30.74,0:22:32.72,Default,,0,0,0,,Бұл гор деп аталады. О!
Dialogue: 0,0:22:32.72,0:22:34.74,Default,,0,0,0,,Мачи мырза. Әй.
Dialogue: 0,0:22:34.74,0:22:36.78,Default,,0,0,0,,Ғажайып Оның тікенді мінезі бар.
Dialogue: 0,0:22:36.78,0:22:38.81,Default,,0,0,0,,Бірдеңе сияқты сезіледі. Кішкене цунами болғандай.
Dialogue: 0,0:22:38.81,0:22:43.22,Default,,0,0,0,,Ақыр соңында, мен мұны бір рет жасадым ...
Dialogue: 0,0:22:43.22,0:22:46.74,Default,,0,0,0,,Көрдіңіз бе, Гон, Курапика және Киллуа →
Dialogue: 0,0:22:46.74,0:22:49.74,Default,,0,0,0,,Бұл фантом труппасының жетекшісін ұрлап әкетпек болған көрініс→
Dialogue: 0,0:22:49.74,0:22:55.73,Default,,0,0,0,,Содан кейін Киллуа пышақпен Махидің асқазанына пышақ салады.
Dialogue: 0,0:22:55.73,0:22:58.25,Default,,0,0,0,,Сонда менің ішім керемет →
Dialogue: 0,0:22:58.25,0:23:00.30,Default,,0,0,0,,Бір кептеліп қалса, шықпайды.
Dialogue: 0,0:23:00.30,0:23:01.82,Default,,0,0,0,,О, менің…. (Шигемори) Ех!
Dialogue: 0,0:23:01.82,0:23:04.22,Default,,0,0,0,,Мачи сізді пышақтап алған кезде осылай қорғайды.
Dialogue: 0,0:23:04.22,0:23:07.22,Default,,0,0,0,,Осылай күзетсең, ішіңе пышақ сұғады...
Dialogue: 0,0:23:07.22,0:23:10.74,Default,,0,0,0,,Осы кезде мен қашып құтыла алмаймын, сондықтан Мачи Киллуаға осылай қарайды→
Dialogue: 0,0:23:10.74,0:23:12.75,Default,,0,0,0,,«Мен оны ұстадым». Апыр-ай.
Dialogue: 0,0:23:12.75,0:23:14.73,Default,,0,0,0,,«Егер сен соған ұмтылсаң, бұл мойын →
Dialogue: 0,0:23:14.73,0:23:16.73,Default,,0,0,0,,Мен оны қорғадым.''
Dialogue: 0,0:23:16.73,0:23:19.25,Default,,0,0,0,,Сізді өлтіріңіз...
Dialogue: 0,0:23:19.25,0:23:22.32,Default,,0,0,0,,Мен ойладым... бұл рас. (күлді)
Dialogue: 0,0:23:22.32,0:23:24.74,Default,,0,0,0,,Ең….
Dialogue: 0,0:23:24.74,0:23:29.25,Default,,0,0,0,,Амансың ба? Маған Миячидің толқуы ұнайды, бірақ...
Dialogue: 0,0:23:29.25,0:23:32.73,Default,,0,0,0,,Мен қазірдің өзінде терлеп жатырмын.
Dialogue: 0,0:23:32.73,0:23:34.74,Default,,0,0,0,,Бұл біршама ынталы→
Dialogue: 0,0:23:34.74,0:23:36.75,Default,,0,0,0,,Бұл осында. Мен оны өткізіп алдым.
Dialogue: 0,0:23:36.75,0:23:38.79,Default,,0,0,0,,Онда, Шиномия, жақсысың ба?
Dialogue: 0,0:23:38.79,0:23:41.73,Default,,0,0,0,,Жарайды, оның қаншалықты тартымды екенін айтайын.
Dialogue: 0,0:23:41.73,0:23:44.73,Default,,0,0,0,,Олай болса, мен бақытсыз болуы керек Киллуамын→
Dialogue: 0,0:23:44.73,0:23:48.73,Default,,0,0,0,,Сен сондай жақсы қызсың!
Dialogue: 0,0:23:53.72,0:23:57.78,Default,,0,0,0,,Бір кеңсе сіз үшін де жұмыс істей алмайды. Мұны істеу қиын! Бұл сізге байланысты.
Dialogue: 0,0:23:57.78,0:23:59.83,Default,,0,0,0,,Қолды жоғары көтеру. Керісінше, бұл өтірік.
Dialogue: 0,0:23:59.83,0:24:01.83,Default,,0,0,0,,Бұл сөзсіз бірдей нәрсе. Не?
Dialogue: 0,0:24:03.23,0:24:05.22,Default,,0,0,0,,Уау, бұл өте жақсы→
Dialogue: 0,0:24:05.22,0:24:08.22,Default,,0,0,0,,Киллуа кейіпкері танымал, бірақ...
Dialogue: 0,0:24:08.22,0:24:10.24,Default,,0,0,0,,Бұл таңба Киллуа деп аталады.→
Dialogue: 0,0:24:10.24,0:24:15.24,Default,,0,0,0,,Шындығында, ол Золдиктер отбасы деп аталатын өлтіруші отбасына жатады→
Dialogue: 0,0:24:15.24,0:24:17.24,Default,,0,0,0,,Мен қазірдің өзінде супер элитамын.
Dialogue: 0,0:24:17.24,0:24:19.80,Default,,0,0,0,,Ата мен әке де өлтіруші.
Dialogue: 0,0:24:19.80,0:24:21.72,Default,,0,0,0,,Ол сүйкімді көрінеді, бірақ шын мәнінде...
Dialogue: 0,0:24:21.72,0:24:24.24,Default,,0,0,0,,Кішкентай кезімнен өлтіруші болу→
Dialogue: 0,0:24:24.24,0:24:26.74,Default,,0,0,0,,Ол бұрыннан дайындалған.
Dialogue: 0,0:24:26.74,0:24:29.72,Default,,0,0,0,,Өлтіруші ретінде сіз жақсы жұмыс жасайсыз деп үміттенемін →
Dialogue: 0,0:24:29.72,0:24:31.74,Default,,0,0,0,,Киллуа осында...
Dialogue: 0,0:24:31.74,0:24:33.73,Default,,0,0,0,,Пышақтаған сияқты...
Dialogue: 0,0:24:33.73,0:24:36.25,Default,,0,0,0,,Аға інісін басқарады.
Dialogue: 0,0:24:36.25,0:24:39.25,Default,,0,0,0,,Е! (Шигемори) Уау, бұл күрделі.
Dialogue: 0,0:24:41.74,0:24:43.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:45.72,0:24:47.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:48.73,0:24:50.73,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:24:50.73,0:24:53.21,Default,,0,0,0,,Бұл кім? Мен кімді пышақтадым? Ақымақ.
Dialogue: 0,0:24:53.21,0:24:56.77,Default,,0,0,0,,Отырыңыз! Суырып алсам да тайғақ.
Dialogue: 0,0:24:56.77,0:24:59.82,Default,,0,0,0,,Бұл сіздің әлеуетіңіз! сол.
Dialogue: 0,0:24:59.82,0:25:01.74,Default,,0,0,0,,......→ сияқты күрделі бөлшектер
Dialogue: 0,0:25:01.74,0:25:04.22,Default,,0,0,0,,Оның бір қызығы осы. Түсінемін, Гонкун.
Dialogue: 0,0:25:04.22,0:25:05.73,Default,,0,0,0,,Иә.
Dialogue: 0,0:25:05.73,0:25:09.25,Default,,0,0,0,,Мен барлығынан үлкен ынта-жігерді сезіндім.
Dialogue: 0,0:25:09.25,0:25:12.72,Default,,0,0,0,,Барлығы «Аңшы x аңшыны» жақсы көреді!
Dialogue: 0,0:25:12.72,0:25:15.24,Default,,0,0,0,,Маған ұнайды! Гонкун: Одан кейін не болады...
Dialogue: 0,0:25:15.24,0:25:16.77,Default,,0,0,0,,Иә, иә! Гонкун, жақсысың ба?
Dialogue: 0,0:25:16.77,0:25:18.81,Default,,0,0,0,,Жарайды. Өтінемін, Гон Чан.
Dialogue: 0,0:25:18.81,0:25:22.23,Default,,0,0,0,,Иә! Негізі бүгін осы студияға келгім келді.
Dialogue: 0,0:25:22.23,0:25:24.73,Default,,0,0,0,,Мен келе алмадым...
Dialogue: 0,0:25:26.73,0:25:28.23,Default,,0,0,0,,Онда біреу бар ма? Әлі сонда біреу бар ма?
Dialogue: 0,0:25:28.23,0:25:31.74,Default,,0,0,0,,Маған «Hunter x Hunter» ұнайды! Менің атым Мизуки Ямамото.
Dialogue: 0,0:25:31.74,0:25:35.22,Default,,0,0,0,,<«CanCam» моделі және актриса Мизуки Ямамото да шұғыл түрде қатысуда>
Dialogue: 0,0:25:35.22,0:25:37.26,Default,,0,0,0,,<Курапиканы жақсы көремін деген қыздан→
Dialogue: 0,0:25:37.26,0:25:38.76,Default,,0,0,0,,Таңқаларлық мәлімдеме! ＞
Dialogue: 0,0:25:52.24,0:25:54.24,Default,,0,0,0,,Өте әдемі тіршілік иесі →
Dialogue: 0,0:25:54.24,0:25:58.23,Default,,0,0,0,,Өйткені ол таза және сүйкімді қыз→
Dialogue: 0,0:25:58.23,0:26:00.23,Default,,0,0,0,,Мынадай нәрсе...
Dialogue: 0,0:26:02.77,0:26:04.30,Default,,0,0,0,,Ухуху….
Dialogue: 0,0:26:04.30,0:26:06.72,Default,,0,0,0,,Осылайша...
Dialogue: 0,0:26:06.72,0:26:11.23,Default,,0,0,0,,Мен олай айтқан жоқпын. (күлді)
Dialogue: 0,0:26:11.23,0:26:14.23,Default,,0,0,0,,Курапиканы бір сөзбен қалай сипаттар едіңіз?
Dialogue: 0,0:26:14.23,0:26:16.75,Default,,0,0,0,,Эх!
Dialogue: 0,0:26:16.75,0:26:18.73,Default,,0,0,0,,(күлді)
Dialogue: 0,0:26:18.73,0:26:21.25,Default,,0,0,0,,Күте тұрыңыз... не? Бұл «CanCam» үлгісі...
Dialogue: 0,0:26:21.25,0:26:23.79,Default,,0,0,0,,Ол мен бұрын көрмеген жүзбен сөйлеп тұрды.
Dialogue: 0,0:26:23.79,0:26:26.22,Default,,0,0,0,,Түсіндің бе? Түсінемін, шынымен.
Dialogue: 0,0:26:26.22,0:26:28.74,Default,,0,0,0,,Өзімді жолдас тапқаныма шын бақытты сезінемін.
Dialogue: 0,0:26:28.74,0:26:30.73,Default,,0,0,0,,Әйел - Курапика-сан→
Dialogue: 0,0:26:30.73,0:26:32.73,Default,,0,0,0,,Оған ғашық болатыныңызға сенімдімін.
Dialogue: 0,0:26:32.73,0:26:35.73,Default,,0,0,0,,Менің сүйікті жолым бар→
Dialogue: 0,0:26:35.73,0:26:37.75,Default,,0,0,0,,Мен бірдеңе айта аламын ба? өтінемін.
Dialogue: 0,0:26:37.75,0:26:39.75,Default,,0,0,0,,Ей, масқара, өліммен төле!
Dialogue: 0,0:26:46.74,0:26:50.23,Default,,0,0,0,,Осы уақытқа дейін манга басталғаннан бері мен сабырлы және жинақы болдым →
Dialogue: 0,0:26:50.23,0:26:53.73,Default,,0,0,0,,Гонға мейірімді болып, достарына қамқорлық көрсетсе де→
Dialogue: 0,0:26:53.73,0:26:55.24,Default,,0,0,0,,«Фантом труппасы» туралы сөз болғанда →
Dialogue: 0,0:26:55.24,0:26:57.72,Default,,0,0,0,,Құрта тайпасы деп аталатын этникалық топқа жататынмын.→
Dialogue: 0,0:26:57.72,0:27:00.76,Default,,0,0,0,,Құрта тайпасының барлығын фантом труппасы қырды...
Dialogue: 0,0:27:00.76,0:27:03.81,Default,,0,0,0,,Иә, менің достарымды өлтіріп жатыр...
Dialogue: 0,0:27:03.81,0:27:06.25,Default,,0,0,0,,Кек сезімі соншалықты күшті...
Dialogue: 0,0:27:06.25,0:27:08.23,Default,,0,0,0,,Жинақталған…. Иә, Курапика осы уақытқа дейін →
Dialogue: 0,0:27:08.23,0:27:11.74,Default,,0,0,0,,Менің сүйкімді бейнем бірден жойылды...
Dialogue: 0,0:27:11.74,0:27:14.22,Default,,0,0,0,,Мен... деген сөздерді айтып күрестім.
Dialogue: 0,0:27:14.22,0:27:17.74,Default,,0,0,0,,Оның төбелесу тәсілі - оның қызыл көзі толық ашылған→
Dialogue: 0,0:27:17.74,0:27:19.74,Default,,0,0,0,,Біз «Император уақыты» деп аталатын нәрсені қолданамыз→
Dialogue: 0,0:27:19.74,0:27:21.80,Default,,0,0,0,,Бұл өте керемет және мен... →
Dialogue: 0,0:27:21.80,0:27:23.83,Default,,0,0,0,,Манга оқығанда жүрегімнің соғуын тоқтата алмаймын...
Dialogue: 0,0:27:23.83,0:27:25.75,Default,,0,0,0,,«Жүректің соғуы» дегеніміз не? Ал, тыңдаңыз.
Dialogue: 0,0:27:25.75,0:27:27.25,Default,,0,0,0,,Медицина Медицина.
Dialogue: 0,0:27:27.25,0:27:29.24,Default,,0,0,0,,Мен де...
Dialogue: 0,0:27:29.24,0:27:30.72,Default,,0,0,0,,Сізге айтқанын қалайсыз ба?
Dialogue: 0,0:27:30.72,0:27:33.24,Default,,0,0,0,,Неліктен сіз фантом труппасының жағындасыз?
Dialogue: 0,0:27:33.24,0:27:37.24,Default,,0,0,0,,Мен оны қатты естігім келеді...!
Dialogue: 0,0:27:37.24,0:27:39.25,Default,,0,0,0,,Ол аздап өзгерді →
Dialogue: 0,0:27:39.25,0:27:41.28,Default,,0,0,0,,Бұл екі...
Dialogue: 0,0:27:41.28,0:27:43.83,Default,,0,0,0,,Бұл екі адамның кірісі жеткілікті. Жоқ, жоқ...
Dialogue: 0,0:27:43.83,0:27:45.74,Default,,0,0,0,,Жолдың жартысы ғана аяқталды. Әлі жартысы ма?
Dialogue: 0,0:27:45.74,0:27:47.74,Default,,0,0,0,,Одан да көп айта аласыз, солай ма? иә.
Dialogue: 0,0:27:47.74,0:27:49.24,Default,,0,0,0,,Бұл шынымен Шигемори-чан→
Dialogue: 0,0:27:49.24,0:27:51.73,Default,,0,0,0,,Қыздар бұған қатты құмар...
Dialogue: 0,0:27:51.73,0:27:53.74,Default,,0,0,0,,Бірақ Курапика-санның әңгімесін тыңдау →
Dialogue: 0,0:27:53.74,0:27:55.71,Default,,0,0,0,,Мен түсіндім. (Мэдзима) Түсіндің бе?
Dialogue: 0,0:27:55.71,0:27:58.23,Default,,0,0,0,,Әдетте ұрыс-керіс пен заттарды жек көретін жігіт бар→
Dialogue: 0,0:27:58.23,0:28:03.30,Default,,0,0,0,,Ол қызды қорғағанда немесе өзіне маңызды біреу ренжігенде ғана ашуланады→
Dialogue: 0,0:28:03.30,0:28:07.24,Default,,0,0,0,,Осылай төбелескенде үлкен алшақтық болады.
Dialogue: 0,0:28:07.24,0:28:11.23,Default,,0,0,0,,Достары үшін оянады. Бұл шынымен керемет. Мен түссіндім.
Dialogue: 0,0:28:11.23,0:28:13.71,Default,,0,0,0,,Сондықтан мен бір қарап алғым келді. Оны оқып шығыңыз.
Dialogue: 0,0:28:13.71,0:28:16.72,Default,,0,0,0,,Шигемори-чан, спектакль біткен соң екеуің біраз сөйлессеңдер жақсы болар еді→
Dialogue: 0,0:28:16.72,0:28:19.24,Default,,0,0,0,,Не? Жоқ, бірақ сәл ғана...
Dialogue: 0,0:28:19.24,0:28:21.79,Default,,0,0,0,,Температура әлі де жоғары.
Dialogue: 0,0:28:21.79,0:28:24.22,Default,,0,0,0,,<Осыдан кейін «Қисумай» Мията жабайы болады! ＞
Dialogue: 0,0:28:24.22,0:28:26.72,Default,,0,0,0,,<Осындай пұт көрген емеспін>
Dialogue: 0,0:30:43.76,0:30:45.73,Default,,0,0,0,,Әрі қарай, сіз айтқыңыз келген кез келген адам!
Dialogue: 0,0:30:45.73,0:30:48.74,Default,,0,0,0,,Иә, иә, иә...! (Шиномия) Иә, иә, иә...!
Dialogue: 0,0:30:48.74,0:30:51.74,Default,,0,0,0,,Иә, иә, иә...!
Dialogue: 0,0:30:54.26,0:30:58.28,Default,,0,0,0,,Бүгін мұнда жеңе алмайсыз. (Шиномия) Ол өте мықты қарсылас.
Dialogue: 0,0:30:58.28,0:31:00.83,Default,,0,0,0,,Мията-кун, өтінемін.
Dialogue: 0,0:31:00.83,0:31:04.83,Default,,0,0,0,,Келесі Құдай, Хисокаға еліктей алсаң!
Dialogue: 0,0:31:07.25,0:31:09.74,Default,,0,0,0,,Сіз нені айтасыз? Бірінші кезекте →
Dialogue: 0,0:31:09.74,0:31:11.74,Default,,0,0,0,,Мен міндетті түрде кейіпкерлерге еліктегім келеді→
Dialogue: 0,0:31:11.74,0:31:13.24,Default,,0,0,0,,Мен орта мектепте оқып жүрген кезім.
Dialogue: 0,0:31:13.24,0:31:15.26,Default,,0,0,0,,Хисока осылайша карталарды лақтырады→
Dialogue: 0,0:31:15.26,0:31:18.73,Default,,0,0,0,,Мен ағам екеуміз карточкаларды осылай лақтырдық...
Dialogue: 0,0:31:18.73,0:31:21.25,Default,,0,0,0,,Бұл... ақыр соңында.
Dialogue: 0,0:31:21.25,0:31:24.25,Default,,0,0,0,,Егер сіз мектепке ойын картасын әкелсеңіз...
Dialogue: 0,0:31:27.26,0:31:29.74,Default,,0,0,0,,«Қауіпті жігіт осында». Бұл көп жағынан қауіпті.
Dialogue: 0,0:31:29.74,0:31:35.23,Default,,0,0,0,,Мията кенеттен карталарды лақтыра бастаса, мен таң қалар едім.
Dialogue: 0,0:31:35.23,0:31:38.24,Default,,0,0,0,,Мен белгілі бір көріністі қайта жасауды ойладым.
Dialogue: 0,0:31:38.24,0:31:41.27,Default,,0,0,0,,Шықты, шықты, шықты.... (Шигемори) Ах!
Dialogue: 0,0:31:41.27,0:31:42.81,Default,,0,0,0,,Уау, мен жасадым.
Dialogue: 0,0:31:42.81,0:31:45.34,Default,,0,0,0,,Жоқ, Перот Хисоканы жасайды.
Dialogue: 0,0:31:45.34,0:31:48.26,Default,,0,0,0,,Емтихан ойынын бастайық.
Dialogue: 0,0:31:48.26,0:31:51.75,Default,,0,0,0,,Ууууууууууууууууу....
Dialogue: 0,0:31:51.75,0:31:55.25,Default,,0,0,0,,Шуш! (Шиномия) Шығады!
Dialogue: 0,0:31:55.25,0:31:58.76,Default,,0,0,0,,Сенің көздерің жақсы. Сіз емтиханнан өттіңіз.
Dialogue: 0,0:31:58.76,0:32:01.26,Default,,0,0,0,,Бұл шықты!
Dialogue: 0,0:32:01.26,0:32:04.83,Default,,0,0,0,,Ах! Кенеттен, кенеттен...
Dialogue: 0,0:32:04.83,0:32:07.25,Default,,0,0,0,,Гон кенеттен араласып кетті. «Джи.»
Dialogue: 0,0:32:07.25,0:32:10.25,Default,,0,0,0,,Мен мұны Гонға айтып тұрмын.
Dialogue: 0,0:32:10.25,0:32:12.27,Default,,0,0,0,,Аңшы емтиханының бірінші турында.
Dialogue: 0,0:32:12.27,0:32:14.24,Default,,0,0,0,,Ей, бүгінгі Мията-кун →
Dialogue: 0,0:32:14.24,0:32:16.74,Default,,0,0,0,,Осы мүшеге қарасаңыз...
Dialogue: 0,0:32:19.26,0:32:22.28,Default,,0,0,0,,Кел, Гон Чан. иә.
Dialogue: 0,0:32:22.28,0:32:23.78,Default,,0,0,0,,Шын мәнінде...
Dialogue: 0,0:32:27.27,0:32:30.25,Default,,0,0,0,,Окада мырза және Амано мырза Сәлеметсіз бе, мен Юдзумын.
Dialogue: 0,0:32:30.25,0:32:32.25,Default,,0,0,0,,Бұл Хайдайн.
Dialogue: 0,0:32:54.26,0:32:56.26,Default,,0,0,0,,Біз үшін.
Dialogue: 0,0:32:59.75,0:33:01.77,Default,,0,0,0,,Мацуда: Бұл ойын-сауық емес.
Dialogue: 0,0:33:01.77,0:33:03.77,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:33:05.81,0:33:07.81,Default,,0,0,0,,Менің ойымша, бар.
Dialogue: 0,0:33:09.26,0:33:11.76,Default,,0,0,0,,(күлді)
Dialogue: 0,0:33:11.76,0:33:14.75,Default,,0,0,0,,Бұл тақырыптан мүлдем тыс емес пе? Бұл жаман сөз.
Dialogue: 0,0:33:14.75,0:33:17.25,Default,,0,0,0,,Неліктен сіз әзілкеш Окада туралы жаман сөздер айтып жатырсыз?
Dialogue: 0,0:33:17.25,0:33:20.75,Default,,0,0,0,,Бірақ мен бұған сенбеймін, өйткені мен ``Аңшы x Аңшыны» білмеймін.
Dialogue: 0,0:33:20.75,0:33:23.79,Default,,0,0,0,,Бүгін сөйлесіп отырғанымызда неге көрмедің деп жүргенім рас.→
Dialogue: 0,0:33:23.79,0:33:25.83,Default,,0,0,0,,Мен өзімді аздап кінәлі сезінемін.
Dialogue: 0,0:33:25.83,0:33:27.74,Default,,0,0,0,,«Юзу» және Хядайн →
Dialogue: 0,0:33:27.74,0:33:30.26,Default,,0,0,0,,Сізге ''Hunter x Hunter'' ұнайды.
Dialogue: 0,0:33:30.26,0:33:34.25,Default,,0,0,0,,Фильмге тақырыптық ән айтқаныңызға өте қуаныштымын.
Dialogue: 0,0:33:34.25,0:33:37.25,Default,,0,0,0,,Иә? Маған айтпадың ба?
Dialogue: 0,0:33:42.78,0:33:44.81,Default,,0,0,0,,<Осы фильмнің тақырыптық әнін кім басқарды→
Dialogue: 0,0:33:44.81,0:33:47.75,Default,,0,0,0,,Соңғы уақыттан жалғасы...＞
Dialogue: 0,0:33:47.75,0:33:53.75,Default,,0,0,0,,♪~ Бір тиынның екі жағы, оны саусақтарыңызбен аударыңыз, монета ауада билейді
Dialogue: 0,0:33:53.75,0:33:55.75,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:34:02.31,0:34:03.75,Default,,0,0,0,,...соған ұқсас нәрсе.
Dialogue: 0,0:34:03.75,0:34:05.75,Default,,0,0,0,,<Тақырыбы: «Бір монетаның екі жағы»>
Dialogue: 0,0:34:05.75,0:34:09.75,Default,,0,0,0,,<Бұл шын мәнінде фильмдермен тығыз байланысты кілт сөз>
Dialogue: 0,0:34:09.75,0:34:12.74,Default,,0,0,0,,<Оны театрда көріңіз>
Dialogue: 0,0:34:12.74,0:34:15.24,Default,,0,0,0,,<Осыдан кейін мерзім жақындап қалды...>
Dialogue: 0,0:36:34.73,0:36:36.75,Default,,0,0,0,,Олай болса бұл келесісі.
Dialogue: 0,0:36:36.75,0:36:40.25,Default,,0,0,0,,Гонды фильм түсіру сайтына жіберіңіз.
Dialogue: 0,0:36:40.25,0:36:43.75,Default,,0,0,0,,Соңғы анимациялар қалай жасалады?
Dialogue: 0,0:36:53.33,0:36:55.74,Default,,0,0,0,,Барлығына! «HUNTER x HUNTER» фильмінің нұсқасы →
Dialogue: 0,0:36:55.74,0:37:00.24,Default,,0,0,0,,Оны ``Madhouse'' деп аталатын аниме өндіруші компания жасаған.
Dialogue: 0,0:37:00.24,0:37:03.74,Default,,0,0,0,,Енді ішке кірейік.
Dialogue: 0,0:37:03.74,0:37:06.23,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:37:06.23,0:37:08.75,Default,,0,0,0,,Қайырлы таң.
Dialogue: 0,0:37:08.75,0:37:11.75,Default,,0,0,0,,<Гон-кунды қарсы алған адам...>
Dialogue: 0,0:37:17.24,0:37:19.26,Default,,0,0,0,,<Мұндағы «Жындыхана» →
Dialogue: 0,0:37:19.26,0:37:23.25,Default,,0,0,0,,«Паприка» Венеция халықаралық кинофестивалінде көрсетілді →
Dialogue: 0,0:37:23.25,0:37:27.23,Default,,0,0,0,,Қоғамдық құбылысқа айналған «ӨЛІМ ЖАЗЫ», «НАНА» сияқты әндермен жұмыс істеді→
Dialogue: 0,0:37:27.23,0:37:30.24,Default,,0,0,0,,Біз соңғы анимация өндіруші компаниямыз＞
Dialogue: 0,0:37:30.24,0:37:33.29,Default,,0,0,0,,О ~ «НАНА»! таңқаларлық.
Dialogue: 0,0:37:33.29,0:37:37.26,Default,,0,0,0,,<Өндіріс алаңына дереу кіруге рұқсат берілетін Гон-кун>
Dialogue: 0,0:37:37.26,0:37:39.75,Default,,0,0,0,,<Бірақ бұл уақытта көрініс дәл → болды
Dialogue: 0,0:37:39.75,0:37:44.25,Default,,0,0,0,,«HUNTER x HUNTER» фильмінің нұсқасын аяқтау жұмыстарының ортасында＞
Dialogue: 0,0:37:45.75,0:37:47.25,Default,,0,0,0,,Уау.
Dialogue: 0,0:37:50.24,0:37:52.79,Default,,0,0,0,,<Оқиға орнындағы шиеленіс атмосферасы>
Dialogue: 0,0:37:52.79,0:37:55.73,Default,,0,0,0,,<Гон-кун, өтінемін, маған көп кедергі жасама>
Dialogue: 0,0:37:55.73,0:37:58.73,Default,,0,0,0,,Алдымен мына адамды таныстырып өтейін.
Dialogue: 0,0:37:58.73,0:38:00.73,Default,,0,0,0,,Бұл көзілдірік...
Dialogue: 0,0:38:06.74,0:38:08.76,Default,,0,0,0,,Танысқаныма қуаныштымын!
Dialogue: 0,0:38:08.76,0:38:11.76,Default,,0,0,0,,<“HUNTER x HUNTER” фильмінің бұл нұсқасы…>
Dialogue: 0,0:38:15.23,0:38:17.23,Default,,0,0,0,,Эй, эй….
Dialogue: 0,0:38:20.25,0:38:22.25,Default,,0,0,0,,Ең алдымен...
Dialogue: 0,0:38:27.24,0:38:31.28,Default,,0,0,0,,Дәл қазір менің үстелімде →
Dialogue: 0,0:38:31.28,0:38:33.28,Default,,0,0,0,,Мынадай.
Dialogue: 0,0:38:34.73,0:38:37.74,Default,,0,0,0,,Бұл өте жабайы салынған сурет.
Dialogue: 0,0:38:37.74,0:38:39.76,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:38:39.76,0:38:41.76,Default,,0,0,0,,<Эй, Гонкун! ＞
Dialogue: 0,0:38:41.76,0:38:45.25,Default,,0,0,0,,<Бұл сюжеттік тақтаны режиссер аниме жасау үшін ойластырады→
Dialogue: 0,0:38:45.25,0:38:48.75,Default,,0,0,0,,Бұл ең маңыздысы.＞
Dialogue: 0,0:38:48.75,0:38:53.34,Default,,0,0,0,,<Кейіпкерлердің қимылдары, сызықтары және мимика нұсқаулары→
Dialogue: 0,0:38:53.34,0:38:56.84,Default,,0,0,0,,Мәліметтер егжей-тегжейлі сипатталған.＞
Dialogue: 0,0:38:59.24,0:39:02.74,Default,,0,0,0,,Уау, режиссер керемет екен.
Dialogue: 0,0:39:04.75,0:39:07.25,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:39:09.75,0:39:13.25,Default,,0,0,0,,Әзірге...
Dialogue: 0,0:39:17.84,0:39:20.25,Default,,0,0,0,,Иә!?
Dialogue: 0,0:39:20.25,0:39:22.27,Default,,0,0,0,,Мұндай нәрсе!
Dialogue: 0,0:39:22.27,0:39:25.27,Default,,0,0,0,,<Жоқ, жоқ, режиссердің сюжеті негізінде...>
Dialogue: 0,0:39:28.25,0:39:30.25,Default,,0,0,0,,Маман?
Dialogue: 0,0:39:40.75,0:39:44.25,Default,,0,0,0,,<«генга адам» деп аталатын кескіндеме мамандары жауапты болады>
Dialogue: 0,0:39:44.25,0:39:47.76,Default,,0,0,0,,<Кино өндірісі қазір қарыштап жатыр...>
Dialogue: 0,0:39:47.76,0:39:50.26,Default,,0,0,0,,＜...шарсыз жұмыс істейді＞
Dialogue: 0,0:39:50.26,0:39:52.26,Default,,0,0,0,,100 адам!?
Dialogue: 0,0:39:52.26,0:39:54.76,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:40:04.24,0:40:07.24,Default,,0,0,0,,＜100 түпнұсқа суретшіні біріктіру...＞
Dialogue: 0,0:40:09.25,0:40:12.25,Default,,0,0,0,,<Қанша маман болса да, әр төл өнерпаздың өз өнері бар→
Dialogue: 0,0:40:12.25,0:40:15.24,Default,,0,0,0,,Нәзік сурет салу әр жағдайда пайда болады＞
Dialogue: 0,0:40:15.24,0:40:17.74,Default,,0,0,0,,<Бірлік сезімін қалыптастыру мақсатында→
Dialogue: 0,0:40:17.74,0:40:20.29,Default,,0,0,0,,Түзетулерді жасайтын анимация режиссері>
Dialogue: 0,0:40:20.29,0:40:24.24,Default,,0,0,0,,«Мията-кунға» деп жаза аласыз ба? бұл.
Dialogue: 0,0:40:24.24,0:40:29.25,Default,,0,0,0,,<Жұмысты тек анимациялық режиссермен ғана аяқтауға болады.>
Dialogue: 0,0:40:29.25,0:40:31.75,Default,,0,0,0,,Бірақ бұл түпнұсқа сурет менікі→
Dialogue: 0,0:40:31.75,0:40:34.24,Default,,0,0,0,,Біртүрлі нәрсе бар ма?
Dialogue: 0,0:40:34.24,0:40:38.26,Default,,0,0,0,,<Түпнұсқа сурет бір әрекеттің басы мен соңының суреті ғана>
Dialogue: 0,0:40:38.26,0:40:41.83,Default,,0,0,0,,<Анимация тек осымен ғана аяқталмайды>
Dialogue: 0,0:40:41.83,0:40:45.75,Default,,0,0,0,,<Анимацияның бірқалыпты қозғалуы үшін әлі де жұмыс істеу керек>
Dialogue: 0,0:40:45.75,0:40:48.75,Default,,0,0,0,,<Ары қарай, Гон-кун басшылық етті...>
Dialogue: 0,0:40:54.76,0:40:57.24,Default,,0,0,0,,Бәріңе сәлем!
Dialogue: 0,0:40:57.24,0:40:59.24,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:41:02.32,0:41:05.74,Default,,0,0,0,,<Ол жердегі адамдарды «бейне адамдар» деп атаған>
Dialogue: 0,0:41:05.74,0:41:08.74,Default,,0,0,0,,<Егер түпнұсқа сурет басы мен аяғының суреті болса→
Dialogue: 0,0:41:08.74,0:41:11.74,Default,,0,0,0,,Бейне – бұл арасындағы қозғалыстың суреті.＞
Dialogue: 0,0:41:11.74,0:41:13.74,Default,,0,0,0,,<Осыны қосу арқылы →
Dialogue: 0,0:41:13.74,0:41:18.25,Default,,0,0,0,,Сурет осылайша қозғалып жатқан сияқты.＞
Dialogue: 0,0:41:18.25,0:41:20.25,Default,,0,0,0,,<Бұл бейне де бір-бірден →
Dialogue: 0,0:41:20.25,0:41:24.34,Default,,0,0,0,,Бейне суретші мұқият салған＞
Dialogue: 0,0:41:24.34,0:41:26.34,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:41:35.73,0:41:38.25,Default,,0,0,0,,<Көп жағдайда бейнеге жауапты адам → болады
Dialogue: 0,0:41:38.25,0:41:42.25,Default,,0,0,0,,Жаңа ғана аниматор болған жаңа аниматорлар сияқты.
Dialogue: 0,0:41:44.26,0:41:48.76,Default,,0,0,0,,<Осы уақытта мен компанияға осы жылдың сәуір айында қосылған жаңа қызметкерді таптым>
Dialogue: 0,0:42:03.24,0:42:06.76,Default,,0,0,0,,Бұл...
Dialogue: 0,0:42:06.76,0:42:11.25,Default,,0,0,0,,<мырза Кай бала кезінен сурет салуды жақсы көреді>
Dialogue: 0,0:42:11.25,0:42:13.80,Default,,0,0,0,,<Бір күні ерекше анимация суретшісі болуды армандау→
Dialogue: 0,0:42:13.80,0:42:16.30,Default,,0,0,0,,Күн сайын бейнелер салуды жалғастырыңыз＞
Dialogue: 0,0:42:17.74,0:42:20.74,Default,,0,0,0,,<Сонымен қатар, «HUNTER x HUNTER» бейне адамының фильмдік нұсқасы →
Dialogue: 0,0:42:20.74,0:42:23.26,Default,,0,0,0,,Олар Жапониядан тыс жерлерде бар＞
Dialogue: 0,0:42:23.26,0:42:27.77,Default,,0,0,0,,<Фильм аяқталғаннан кейін кредиттерде, кредиттерде шетелдік тұлғаның аты-жөні→
Dialogue: 0,0:42:27.77,0:42:29.74,Default,,0,0,0,,Сіз бірдеңе байқадыңыз ба? ＞
Dialogue: 0,0:42:29.74,0:42:31.27,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:42:31.27,0:42:34.84,Default,,0,0,0,,<«HUNTER x HUNTER» фильмінің нұсқасына арналған бейненің үлкен көлеміне байланысты→
Dialogue: 0,0:42:34.84,0:42:38.26,Default,,0,0,0,,Жұмыс шетелде де жүргізілуде>
Dialogue: 0,0:42:38.26,0:42:40.25,Default,,0,0,0,,<және түн>
Dialogue: 0,0:42:40.25,0:42:43.75,Default,,0,0,0,,<Гон-кун Кай-санға тағы да қонаққа барды>
Dialogue: 0,0:42:43.75,0:42:45.75,Default,,0,0,0,,Кай мырза….
Dialogue: 0,0:42:55.33,0:42:57.83,Default,,0,0,0,,Бүгін...
Dialogue: 0,0:42:59.73,0:43:03.75,Default,,0,0,0,,18 дана!? Уау, бұл керемет!
Dialogue: 0,0:43:03.75,0:43:07.24,Default,,0,0,0,,<Алайда, анимацияда бір секунд жасау үшін→
Dialogue: 0,0:43:07.24,0:43:09.76,Default,,0,0,0,,Ол 12 суретті алады>
Dialogue: 0,0:43:09.76,0:43:12.76,Default,,0,0,0,,<Кай-сан бір күнде 18 сурет салса да→
Dialogue: 0,0:43:12.76,0:43:16.15,Default,,0,0,0,,Бұл бар болғаны бір жарым секундты алады>
Dialogue: 0,0:43:16.15,0:43:18.65,Default,,0,0,0,,Аа...
Dialogue: 0,0:43:21.24,0:43:23.26,Default,,0,0,0,,Фильм қанша уақытқа созылады?
Dialogue: 0,0:43:23.26,0:43:26.26,Default,,0,0,0,,<«HUNTER x HUNTER» фильмінің осы нұсқасында→
Dialogue: 0,0:43:26.26,0:43:29.83,Default,,0,0,0,,Шамамен 50 000 сурет салынған>
Dialogue: 0,0:43:29.83,0:43:31.75,Default,,0,0,0,,<Кай мырзаның және басқалардың тұрақты жұмысымен→
Dialogue: 0,0:43:31.75,0:43:34.75,Default,,0,0,0,,Аниме бірте-бірте аяқталуда.＞
Dialogue: 0,0:43:35.77,0:43:38.25,Default,,0,0,0,,<Енді анимацияны қалай жасауға болатынына қайта оралайық>
Dialogue: 0,0:43:38.25,0:43:40.26,Default,,0,0,0,,<Дерлік аяқталды>
Dialogue: 0,0:43:40.26,0:43:44.26,Default,,0,0,0,,<Бұл таңбаға түс қосатын «бояу» деп аталатын процесс>
Dialogue: 0,0:43:44.26,0:43:49.26,Default,,0,0,0,,Иә? Мен бояу үшін түрлі-түсті қарындаштарды немесе бояуларды қолданбаймын.
Dialogue: 0,0:43:50.73,0:43:54.24,Default,,0,0,0,,<Барлық бояу компьютердің көмегімен орындалады>
Dialogue: 0,0:43:54.24,0:43:56.74,Default,,0,0,0,,<Бірінші, 50 000 сурет→
Dialogue: 0,0:43:56.74,0:44:00.24,Default,,0,0,0,,Әрбір парақты сканермен түсіру және оны деректерге түрлендіру＞
Dialogue: 0,0:44:01.23,0:44:05.23,Default,,0,0,0,,<Таңбаға орнатылған түсті қосу>
Dialogue: 0,0:44:06.78,0:44:08.82,Default,,0,0,0,,<Бұл Гонкунның түс үлгісі>
Dialogue: 0,0:44:08.82,0:44:11.25,Default,,0,0,0,,<Түсінде шамалы айырмашылық болса да→
Dialogue: 0,0:44:11.25,0:44:15.24,Default,,0,0,0,,Барлығы ұсақ-түйекке дейін шешіледі.＞
Dialogue: 0,0:44:15.24,0:44:19.24,Default,,0,0,0,,Уау, мен сондай түрлі түсті болдым.
Dialogue: 0,0:44:21.25,0:44:26.29,Default,,0,0,0,,<Фильмді серпінді ету үшін...>
Dialogue: 0,0:44:26.29,0:44:29.34,Default,,0,0,0,,<… сонымен қатар қолданылады>
Dialogue: 0,0:44:29.34,0:44:31.74,Default,,0,0,0,,<Бұл Нетеро Төрағасының Нен қабілеті→
Dialogue: 0,0:44:31.74,0:44:35.26,Default,,0,0,0,,«Хякушики Каннонның» үшөлшемді CG>
Dialogue: 0,0:44:35.26,0:44:39.26,Default,,0,0,0,,<Осы CG құруға қанша уақыт қажет болды? ＞
Dialogue: 0,0:44:44.74,0:44:47.79,Default,,0,0,0,,<Тіпті Гонкун да бұған таң қалды! ＞
Dialogue: 0,0:44:47.79,0:44:51.24,Default,,0,0,0,,<Осылай жасалған таңбаны фонмен біріктіру→
Dialogue: 0,0:44:51.24,0:44:53.73,Default,,0,0,0,,Соңында... соңында →
Dialogue: 0,0:44:53.73,0:44:57.23,Default,,0,0,0,,Бір көрініс аяқталды＞
Dialogue: 0,0:45:06.28,0:45:09.85,Default,,0,0,0,,<Көп адам, көп уақыт→
Dialogue: 0,0:45:09.85,0:45:12.25,Default,,0,0,0,,Және көп махаббат>
Dialogue: 0,0:45:12.25,0:45:17.25,Default,,0,0,0,,<"ХАНТЕР x HUNTER" фильмінің нұсқасы осылай жасалды>
Dialogue: 0,0:45:17.25,0:45:20.26,Default,,0,0,0,,Жоқ! Сіз қалай ойлайсыз? бұл.
Dialogue: 0,0:45:20.26,0:45:23.26,Default,,0,0,0,,Бұл қиын! Эй Шигемори, сен мұны көрдің бе?
Dialogue: 0,0:45:23.26,0:45:26.76,Default,,0,0,0,,1 секунд... Не...? 12 бөлікке 1 секунд қажет.
Dialogue: 0,0:45:26.76,0:45:29.75,Default,,0,0,0,,Негізі мен күніне 18 ғана сурет сала алатынмын!
Dialogue: 0,0:45:29.75,0:45:32.25,Default,,0,0,0,,Шыққаннан кейін, «Театрлық нұсқа қойылым шешілді» сияқты→
Dialogue: 0,0:45:32.25,0:45:34.29,Default,,0,0,0,,Бұл өте ұзақ, солай емес пе?
Dialogue: 0,0:45:34.29,0:45:37.74,Default,,0,0,0,,Күтетін біздің көзқарасымыздан →
Dialogue: 0,0:45:37.74,0:45:39.74,Default,,0,0,0,,«Жоқ, жоқ, тезірек өтінемін» деп ойлап отырмын. →
Dialogue: 0,0:45:39.74,0:45:42.74,Default,,0,0,0,,Қазір қарап отырсам, қатты өкінемін.
Dialogue: 0,0:45:46.27,0:45:49.74,Default,,0,0,0,,Курукуру уф... Курукуру уф...
Dialogue: 0,0:45:49.74,0:45:53.79,Default,,0,0,0,,А-а... Аа, кешіріңіз, мен жаңа ғана алып кеттім.
Dialogue: 0,0:45:53.79,0:45:56.84,Default,,0,0,0,,Мен соңғы кездері осы ойынға құмар болдым.
Dialogue: 0,0:45:56.84,0:45:58.34,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:46:03.75,0:46:07.25,Default,,0,0,0,,<Біріншіден, бұл өте танымал смартфон ойыны «Пазл және Айдаһарлар»>
Dialogue: 0,0:46:09.24,0:46:12.74,Default,,0,0,0,,<...Бұл қазір бүкіл Жапонияның әуестеніп кеткен ойыны>
Dialogue: 0,0:46:12.74,0:46:15.24,Default,,0,0,0,,<Осы фильмнің шығуына орай→
Dialogue: 0,0:46:15.24,0:46:17.80,Default,,0,0,0,,«Аңшы х аңшы» фильміндегі қандай кейіпкер →
Dialogue: 0,0:46:17.80,0:46:20.33,Default,,0,0,0,,«Батырлар мен айдаһарлар» әлемінде пайда болу! ＞
Dialogue: 0,0:46:20.33,0:46:22.25,Default,,0,0,0,,<Сонымен қатар, барлық таңбалар→
Dialogue: 0,0:46:22.25,0:46:25.25,Default,,0,0,0,,Бұл осы оқиғаға арналған арнайы шығарылым＞
Dialogue: 0,0:46:26.76,0:46:30.26,Default,,0,0,0,,<Одан да басқа, бұл Гонда бар...>
Dialogue: 0,0:46:31.74,0:46:35.77,Default,,0,0,0,,＜Шын мәнінде, ``Pizza La'' және ''Hunter x Hunter'' да бірлесіп жұмыс істейді.＞
Dialogue: 0,0:46:35.77,0:46:39.34,Default,,0,0,0,,<Түпнұсқа фигуралар, құйылған қолтаңбасы бар сценарийлер және т.б.→
Dialogue: 0,0:46:39.34,0:46:42.24,Default,,0,0,0,,Сіз өте сирек кездесетін заттарды ұтып ала аласыз! ＞
Dialogue: 0,0:46:42.24,0:46:44.74,Default,,0,0,0,,<Енді, ақырында...>
Dialogue: 0,0:49:03.73,0:49:05.80,Default,,0,0,0,,Жарайды, барлығына, күткендеріңізге рахмет.
Dialogue: 0,0:49:05.80,0:49:08.23,Default,,0,0,0,,«HUNTER×HUNTER THE LAST MISSION» фильмінің нұсқасы →
Dialogue: 0,0:49:08.23,0:49:11.73,Default,,0,0,0,,Алғашқы 6 минут 3 секунд үзілмей таратылады.
