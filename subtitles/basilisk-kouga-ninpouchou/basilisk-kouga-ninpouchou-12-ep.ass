Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.34,0:00:11.01,Default,,0,0,0,,Бірін-бірі жек көретін адамдар болды
Dialogue: 0,0:00:12.92,0:00:17.68,Default,,0,0,0,,Далада дене шіриді, рух қанға боялады.
Dialogue: 0,0:00:20.27,0:00:23.77,Default,,0,0,0,,Байланыс пышақпен бөлінді
Dialogue: 0,0:00:23.94,0:00:26.98,Default,,0,0,0,,(сұңқардың айқайы)
Dialogue: 0,0:00:32.53,0:00:33.49,Default,,0,0,0,,(айқай)
Dialogue: 0,0:00:37.37,0:00:38.66,Default,,0,0,0,,(айқай)
Dialogue: 0,0:00:39.78,0:00:42.37,Default,,0,0,0,,Қараңғылықтың шынайылығы жылайды
Dialogue: 0,0:00:42.50,0:00:43.91,Default,,0,0,0,,(сұңқардың айқайы)
Dialogue: 0,0:00:45.33,0:00:49.42,Default,,0,0,0,,Сүйіктім, өлуге дайын
Dialogue: 0,0:01:01.51,0:01:06.06,Default,,0,0,0,,♪～
Dialogue: 0,0:02:26.72,0:02:30.56,Default,,0,0,0,,～♪
Dialogue: 0,0:02:44.41,0:02:45.66,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:55.38,0:02:56.46,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:56.75,0:02:57.76,Default,,0,0,0,,Уф!
Dialogue: 0,0:02:58.80,0:02:59.63,Default,,0,0,0,,Фу…
Dialogue: 0,0:03:06.06,0:03:06.89,Default,,0,0,0,,Ахх...
Dialogue: 0,0:03:10.10,0:03:11.35,Default,,0,0,0,,Сол қыз...
Dialogue: 0,0:03:11.69,0:03:14.52,Default,,0,0,0,,Жау жараланды, жалғыз маған жетеді.
Dialogue: 0,0:03:14.65,0:03:15.86,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:03:16.27,0:03:19.32,Default,,0,0,0,,Генносуке-самадан кешірім сұрауға тура келетін кездер болады.
Dialogue: 0,0:03:19.61,0:03:20.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:21.78,0:03:22.82,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:38.63,0:03:39.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:42.01,0:03:47.89,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:03:48.72,0:03:50.39,Default,,0,0,0,,Яшамару?
Dialogue: 0,0:03:51.31,0:03:52.44,Default,,0,0,0,,О...
Dialogue: 0,0:03:52.56,0:03:54.40,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:03:54.85,0:03:56.65,Default,,0,0,0,,Бұл көріксіз, Өрт сөндіруші
Dialogue: 0,0:03:57.48,0:03:59.61,Default,,0,0,0,,Кисараги Заемон…
Dialogue: 0,0:04:01.49,0:04:03.11,Default,,0,0,0,,Ннн!
Dialogue: 0,0:04:07.78,0:04:09.83,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:04:09.95,0:04:10.87,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:12.66,0:04:14.79,Default,,0,0,0,,Иә! Керемет...
Dialogue: 0,0:04:18.04,0:04:19.13,Default,,0,0,0,,Уф…
Dialogue: 0,0:04:40.19,0:04:42.24,Default,,0,0,0,,Ууууууууууууууууу...
Dialogue: 0,0:04:42.86,0:04:46.11,Default,,0,0,0,,Көктемнің ұзақ жаңбыры сүйегіме тиеді.
Dialogue: 0,0:04:46.49,0:04:48.41,Default,,0,0,0,,Ненки Дото мен Firefly - бұл...
Dialogue: 0,0:04:48.53,0:04:51.58,Default,,0,0,0,,Сіз Кога-гумидің қайда екенін білген кезде ме?
Dialogue: 0,0:04:53.33,0:04:56.33,Default,,0,0,0,,Өз бейітімді қазбасам ғой.
Dialogue: 0,0:04:58.88,0:05:03.88,Default,,0,0,0,,Мен Генносукені өлтірсем ғой...
Dialogue: 0,0:05:08.22,0:05:11.35,Default,,0,0,0,,Өйткені, ол көсемнің ыдысы емес.
Dialogue: 0,0:05:12.10,0:05:14.10,Default,,0,0,0,,...сіз мұны айтасыз ба?
Dialogue: 0,0:05:15.06,0:05:17.31,Default,,0,0,0,,Өйткені, Оборо-сама...
Dialogue: 0,0:05:22.11,0:05:24.32,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:05:24.86,0:05:26.57,Default,,0,0,0,,Ууууууууууууууууууу...
Dialogue: 0,0:05:35.54,0:05:41.54,Default,,0,0,0,,♪ (флейтада ойнау)
Dialogue: 0,0:06:07.49,0:06:08.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:09.74,0:06:10.99,Default,,0,0,0,,Оборо ше?
Dialogue: 0,0:06:12.91,0:06:14.33,Default,,0,0,0,,Мен...
Dialogue: 0,0:06:15.20,0:06:18.50,Default,,0,0,0,,Мен әрқашан Генносуке-самадан кешірім сұрауға тура келді...
Dialogue: 0,0:06:19.54,0:06:23.00,Default,,0,0,0,,Мен Генносуке-самамен кездесуге бармас бұрын да...
Dialogue: 0,0:06:24.09,0:06:27.63,Default,,0,0,0,,Мен шешім қабылдадым.
Dialogue: 0,0:06:30.05,0:06:33.55,Default,,0,0,0,,«Егер сіз маған бәрібір десеңіз»…
Dialogue: 0,0:06:39.52,0:06:42.73,Default,,0,0,0,,«Кез келген джентльменмен»…
Dialogue: 0,0:06:45.53,0:06:46.57,Default,,0,0,0,,Ха…
Dialogue: 0,0:06:47.61,0:06:50.20,Default,,0,0,0,,Сенің көзің... (бұлыңғыр) А?
Dialogue: 0,0:06:51.03,0:06:53.07,Default,,0,0,0,,Мен бұл көздерді көргенде...
Dialogue: 0,0:06:54.95,0:06:56.79,Default,,0,0,0,,Ақыры мен сені кездестірдім...
Dialogue: 0,0:07:03.00,0:07:04.59,Default,,0,0,0,,Генносуке-сама...
Dialogue: 0,0:07:06.96,0:07:10.80,Default,,0,0,0,,Жоқ, жігіттің айтқаны әзіл сияқты, бірақ...
Dialogue: 0,0:07:12.43,0:07:15.76,Default,,0,0,0,,Мен де...
Dialogue: 0,0:07:25.69,0:07:26.86,Default,,0,0,0,,Обородо
Dialogue: 0,0:07:34.12,0:07:37.87,Default,,0,0,0,,Қатаң қыстың өзі ақыры бітеді
Dialogue: 0,0:07:38.58,0:07:42.92,Default,,0,0,0,,Мен бұл маусымды көптен күттім.
Dialogue: 0,0:08:08.98,0:08:10.23,Default,,0,0,0,,Уууу…
Dialogue: 0,0:08:10.94,0:08:17.58,Default,,0,0,0,,(Обораның айқайы)
Dialogue: 0,0:08:17.70,0:08:19.16,Default,,0,0,0,,Ннн…
Dialogue: 0,0:08:19.49,0:08:25.92,Default,,0,0,0,,(Обораның айқайы)
Dialogue: 0,0:08:34.09,0:08:34.93,Default,,0,0,0,,(Біреуді тесіп өткендей дыбыс)
Dialogue: 0,0:08:35.89,0:08:36.72,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:40.14,0:08:41.60,Default,,0,0,0,,Сіз темекі шектіңіз бе...
Dialogue: 0,0:08:54.03,0:08:55.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:06.50,0:09:09.96,Default,,0,0,0,,Мені олай атама! лас!
Dialogue: 0,0:09:28.90,0:09:33.44,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:09:33.61,0:09:36.95,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:09:38.32,0:09:39.95,Default,,0,0,0,,Уууу…
Dialogue: 0,0:09:46.54,0:09:47.54,Default,,0,0,0,,Ах…
Dialogue: 0,0:09:47.96,0:09:50.59,Default,,0,0,0,,Уф! Уууу...
Dialogue: 0,0:10:01.26,0:10:02.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:08.06,0:10:09.44,Default,,0,0,0,,Саймон ше...
Dialogue: 0,0:10:27.20,0:10:28.83,Default,,0,0,0,,Өртке не болды?
Dialogue: 0,0:10:30.79,0:10:32.04,Default,,0,0,0,,Саймон
Dialogue: 0,0:10:32.79,0:10:36.01,Default,,0,0,0,,А... Мені алдамшы көбелек айналдырды.
Dialogue: 0,0:10:36.59,0:10:38.59,Default,,0,0,0,,Көбелек қайда кетті?
Dialogue: 0,0:10:39.34,0:10:41.93,Default,,0,0,0,,Егер Хигашижа (Генносуке)...
Dialogue: 0,0:10:43.22,0:10:46.18,Default,,0,0,0,,Өрт сөндірушілер батысқа қарай жүгірген болуы мүмкін.
Dialogue: 0,0:10:47.22,0:10:50.44,Default,,0,0,0,,Мүмкін, Сузукадан тыс
Dialogue: 0,0:10:55.15,0:10:56.32,Default,,0,0,0,,(Нәрсені қатты жерге ұрған дыбыс)
Dialogue: 0,0:11:02.57,0:11:04.33,Default,,0,0,0,,Саймон ше...
Dialogue: 0,0:11:29.39,0:11:32.52,Default,,0,0,0,,(Джингороның қорылдауы)
Dialogue: 0,0:12:00.67,0:12:01.67,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:10.39,0:12:11.68,Default,,0,0,0,,Егер бұл жігіт өлетін болғысы келмесе, денесін Сукунаға тапсырғаны дұрыс—
Dialogue: 0,0:12:32.37,0:12:36.21,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:12:46.97,0:12:48.35,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:12:49.64,0:12:52.56,Default,,0,0,0,,Ханшайым араласпаса да...
Dialogue: 0,0:12:53.81,0:12:57.23,Default,,0,0,0,,Мен сол көздерден жеңілдім.
Dialogue: 0,0:12:59.06,0:13:02.94,Default,,0,0,0,,Бұл адам ба? Бұл жын ба?
Dialogue: 0,0:13:12.08,0:13:15.12,Default,,0,0,0,,Аа... аа...
Dialogue: 0,0:13:17.67,0:13:19.92,Default,,0,0,0,,Ха... бұл кім?
Dialogue: 0,0:13:24.59,0:13:28.47,Default,,0,0,0,,Менің артымда бірдеңе бар
Dialogue: 0,0:13:29.22,0:13:31.72,Default,,0,0,0,,Бұл кім?Ол кім?
Dialogue: 0,0:13:32.77,0:13:33.77,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:13:49.49,0:13:51.58,Default,,0,0,0,,Бұл кім?Ол кім?
Dialogue: 0,0:13:51.83,0:13:52.66,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:13:55.04,0:13:56.21,Default,,0,0,0,,Ха…
Dialogue: 0,0:13:58.54,0:14:01.04,Default,,0,0,0,,Бұл... Коширо?
Dialogue: 0,0:14:11.14,0:14:12.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:13.81,0:14:15.02,Default,,0,0,0,,Коширо...
Dialogue: 0,0:14:19.48,0:14:21.77,Default,,0,0,0,,Ах! (Шину) Коширо!
Dialogue: 0,0:14:27.90,0:14:29.41,Default,,0,0,0,,Өкінішті...
Dialogue: 0,0:14:31.66,0:14:35.24,Default,,0,0,0,,Макото, мейірімді
Dialogue: 0,0:14:35.70,0:14:38.87,Default,,0,0,0,,(тістердің сықырлаған дыбысы)
Dialogue: 0,0:14:39.96,0:14:41.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:22.29,0:15:23.54,Default,,0,0,0,,Ахх...
Dialogue: 0,0:15:31.34,0:15:33.26,Default,,0,0,0,,Өрт сөндіруші! Өрт сөндіруші!
Dialogue: 0,0:15:33.84,0:15:35.30,Default,,0,0,0,,Котаби Сунпуға қарай бет алды
Dialogue: 0,0:15:35.43,0:15:38.27,Default,,0,0,0,,Апай мені ертіп жүруге таңдады.
Dialogue: 0,0:15:38.64,0:15:39.98,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:15:41.06,0:15:45.31,Default,,0,0,0,,Кемпір күткендей, ол әлі қартаюда.
Dialogue: 0,0:15:45.44,0:15:48.19,Default,,0,0,0,,Ах! Айтпа
Dialogue: 0,0:15:48.86,0:15:49.86,Default,,0,0,0,,Иә
Dialogue: 0,0:15:51.24,0:15:53.74,Default,,0,0,0,,Иә, мен саған кәдесый сатып аламын.
Dialogue: 0,0:15:53.86,0:15:56.83,Default,,0,0,0,,Не жақсы? Лапис лазули шаш қыстырғышын алғыңыз келе ме?
Dialogue: 0,0:15:56.95,0:15:59.20,Default,,0,0,0,,Әлде бұл сәнді обидом ба?
Dialogue: 0,0:15:59.33,0:16:02.62,Default,,0,0,0,,А, бұл мен үшін, ниндзя...
Dialogue: 0,0:16:02.75,0:16:05.21,Default,,0,0,0,,Хаха... Ұстамаңыз.
Dialogue: 0,0:16:05.33,0:16:08.25,Default,,0,0,0,,Ниндзюцуда жаттығудың сүйкімді ештеңесі жоқ
Dialogue: 0,0:16:08.38,0:16:10.88,Default,,0,0,0,,Кейде сіз Оборо-сама сияқтысыз...
Dialogue: 0,0:16:11.63,0:16:12.68,Default,,0,0,0,,Хмм...
Dialogue: 0,0:16:14.01,0:16:16.10,Default,,0,0,0,,Ах... Эй, Хотаруби!
Dialogue: 0,0:16:17.72,0:16:18.56,Default,,0,0,0,,Мен...
Dialogue: 0,0:16:18.68,0:16:19.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:23.23,0:16:24.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:26.31,0:16:29.65,Default,,0,0,0,,Соғыс болмаймын деген уәде соншалықты жаман емес...
Dialogue: 0,0:16:30.78,0:16:33.20,Default,,0,0,0,,Мен мұны істеп жатқанда ғана ойлаймын.
Dialogue: 0,0:16:33.65,0:16:35.28,Default,,0,0,0,,Яшамару...
Dialogue: 0,0:16:36.45,0:16:38.66,Default,,0,0,0,,Қолдарың қанға боялған...
Dialogue: 0,0:16:39.24,0:16:40.74,Default,,0,0,0,,Мен оны көргім келмейді.
Dialogue: 0,0:16:44.87,0:16:46.58,Default,,0,0,0,,Кешпеймін…
Dialogue: 0,0:16:51.26,0:16:53.26,Default,,0,0,0,,Ммм... мммм!
Dialogue: 0,0:16:58.80,0:16:59.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:03.27,0:17:04.52,Default,,0,0,0,,Ә? Рика?
Dialogue: 0,0:17:05.81,0:17:08.52,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:17:09.44,0:17:11.32,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,0:17:30.13,0:17:31.50,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:17:34.13,0:17:36.51,Default,,0,0,0,,Біз бірге қайтамыз... (Коширо) А...
Dialogue: 0,0:17:47.81,0:17:48.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:49.19,0:17:50.86,Default,,0,0,0,,Бұл қалай орындалды?
Dialogue: 0,0:17:54.61,0:17:55.65,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:17:58.32,0:18:01.49,Default,,0,0,0,,Коширо туралы не ойлайсың?
Dialogue: 0,0:18:01.66,0:18:04.24,Default,,0,0,0,,Иә? (Сину) Бұл Оборо-сама.
Dialogue: 0,0:18:07.25,0:18:09.42,Default,,0,0,0,,Генносуке Кога Игамен бірге...
Dialogue: 0,0:18:09.54,0:18:13.25,Default,,0,0,0,,Жоқ, мен Оборо-самамен ажырастым.
Dialogue: 0,0:18:13.92,0:18:15.80,Default,,0,0,0,,Дегенмен, Оборо-сама...
Dialogue: 0,0:18:21.01,0:18:22.68,Default,,0,0,0,,Оборо-самаға...
Dialogue: 0,0:18:23.64,0:18:27.39,Default,,0,0,0,,Маған сенің Генносукеге деген байланысыңды үзуің керек...
Dialogue: 0,0:18:28.64,0:18:30.94,Default,,0,0,0,,Бұл да Иганың жалпы ниеті...
Dialogue: 0,0:18:33.57,0:18:38.03,Default,,0,0,0,,Бұл менің де әйел ретіндегі ойым.
Dialogue: 0,0:18:40.61,0:18:44.03,Default,,0,0,0,,Осылай жалғаса берсе, Оборо-саманы аяймын...
Dialogue: 0,0:18:45.20,0:18:48.41,Default,,0,0,0,,Генносуке Коганы ұмыту үшін...
Dialogue: 0,0:18:49.33,0:18:51.58,Default,,0,0,0,,Егер сіз мұны істей алсаңыз ...
Dialogue: 0,0:18:52.96,0:18:54.29,Default,,0,0,0,,Немесе бұл сәл қатігездік пе?
Dialogue: 0,0:18:54.42,0:18:58.13,Default,,0,0,0,,Мен ханшайымның барлық мүмкін жүзін көрдім деп ойладым.
Dialogue: 0,0:18:58.67,0:19:02.47,Default,,0,0,0,,Күлімсіреу, жылаған жүз, бәрі...
Dialogue: 0,0:19:04.18,0:19:05.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:08.18,0:19:13.36,Default,,0,0,0,,Бірақ ханшайымның Генносукпен жүзі...
Dialogue: 0,0:19:21.74,0:19:23.99,Default,,0,0,0,,Бұл бет...
Dialogue: 0,0:19:24.91,0:19:26.33,Default,,0,0,0,,Ахх...
Dialogue: 0,0:19:28.91,0:19:30.33,Default,,0,0,0,,Коширо...
Dialogue: 0,0:19:32.29,0:19:35.79,Default,,0,0,0,,Осының арқасында мен оған қараудың қажеті жоқ (Шину) Иә?
Dialogue: 0,0:19:37.25,0:19:41.30,Default,,0,0,0,,Ханшайымның жаңбырда суланып жатқанын көру...
Dialogue: 0,0:19:45.97,0:19:47.14,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:00.82,0:20:02.74,Default,,0,0,0,,Киотодан келген вице-канцлер де сол жоғары лауазымды тұлғалардың бірі ғой, иә?
Dialogue: 0,0:20:10.66,0:20:11.50,Default,,0,0,0,,Ха…
Dialogue: 0,0:20:11.83,0:20:13.37,Default,,0,0,0,,Вермилион жібек Каэ?
Dialogue: 0,0:20:14.46,0:20:15.63,Default,,0,0,0,,Оборо-сама...
Dialogue: 0,0:20:19.76,0:20:22.67,Default,,0,0,0,,Не болды? Сондай дымқыл
Dialogue: 0,0:20:23.68,0:20:25.72,Default,,0,0,0,,Қызыл жібек? (Шину) Жоқ...
Dialogue: 0,0:20:26.30,0:20:30.22,Default,,0,0,0,,…
Dialogue: 0,0:20:31.39,0:20:33.98,Default,,0,0,0,,（）
Dialogue: 0,0:20:35.27,0:20:39.86,Default,,0,0,0,,Мен енді ешкімді жоғалтқым келмейді.
Dialogue: 0,0:20:40.94,0:20:42.19,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:20:54.54,0:20:56.17,Default,,0,0,0,,Генносуке-сама...
Dialogue: 0,0:21:03.88,0:21:05.09,Default,,0,0,0,,Обородо...
Dialogue: 0,0:21:18.02,0:21:23.78,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:21:24.15,0:21:26.24,Default,,0,0,0,,(Жан) Не…
Dialogue: 0,0:21:30.16,0:21:31.24,Default,,0,0,0,,Ах…
Dialogue: 0,0:21:31.70,0:21:33.54,Default,,0,0,0,,Ннн…
Dialogue: 0,0:21:37.58,0:21:38.63,Default,,0,0,0,,Ха…
Dialogue: 0,0:21:41.25,0:21:44.42,Default,,0,0,0,,Ақырында мен жеттім.
Dialogue: 0,0:21:44.67,0:21:45.92,Default,,0,0,0,,Nenki Do!
Dialogue: 0,0:21:47.84,0:21:50.10,Default,,0,0,0,,Қуаныңыз Оттаяқ
Dialogue: 0,0:21:51.51,0:21:54.89,Default,,0,0,0,,Мен Генносуке мен оның достарын өлтірдім.
Dialogue: 0,0:21:55.06,0:21:56.48,Default,,0,0,0,,Ха…
Dialogue: 0,0:22:06.45,0:22:11.45,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.95,0:23:35.78,Default,,0,0,0,,～♪
Dialogue: 0,0:23:39.16,0:23:41.46,Default,,0,0,0,,Батыс жарысы, әр сәтке жарысады
Dialogue: 0,0:23:41.58,0:23:45.38,Default,,0,0,0,,Мазасыз арқамда жорғалағаны – фантасмагориялық жау.
Dialogue: 0,0:23:45.50,0:23:48.00,Default,,0,0,0,,Көз жасы жаңбырымен суланған жалғыздықтың тереңіне...
Dialogue: 0,0:23:48.13,0:23:51.76,Default,,0,0,0,,...
Dialogue: 0,0:23:51.88,0:23:54.18,Default,,0,0,0,,Айналмалы трагедия
Dialogue: 0,0:23:54.30,0:23:56.39,Default,,0,0,0,,Тағдыр деп айту тым аяусыз.
Dialogue: 0,0:23:56.51,0:23:58.77,Default,,0,0,0,,Бұл асураға апаратын жол
Dialogue: 0,0:23:59.98,0:24:03.19,Default,,0,0,0,,Келесі жолы «Basilisk ~Koga Ninja Scroll~»
Dialogue: 0,0:24:04.69,0:24:10.69,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
