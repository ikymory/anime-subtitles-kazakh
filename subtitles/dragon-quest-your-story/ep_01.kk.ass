Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:10.01,Default,,0,0,0,,NETFLIX түпнұсқалық анимациялық фильмі
Dialogue: 0,0:00:14.80,0:00:21.77,Default,,0,0,0,,(Пусан дауысы)
Dialogue: 0,0:00:28.57,0:00:35.53,Default,,0,0,0,,(Пусан дауысы)
Dialogue: 0,0:00:41.41,0:00:48.38,Default,,0,0,0,,(Пусан дауысы)
Dialogue: 0,0:01:11.82,0:01:14.49,Default,,0,0,0,,(баланың жылауы)
Dialogue: 0,0:02:06.58,0:02:11.38,Default,,0,0,0,,«Алькапа»
Dialogue: 0,0:02:28.64,0:02:34.52,Default,,0,0,0,,Сәлем! Алыңыз! Алақай! Ах!
Dialogue: 0,0:02:38.19,0:02:40.45,Default,,0,0,0,,Не болды, Лукас? Сіз қазірдің өзінде бас тартасыз ба? ‬
Dialogue: 0,0:02:41.28,0:02:42.24,Default,,0,0,0,,Әлі жоқ! ‬
Dialogue: 0,0:02:42.62,0:02:43.87,Default,,0,0,0,,Сәлем! ‬
Dialogue: 0,0:02:43.95,0:02:46.62,Default,,0,0,0,,Өл! Иә! О, жоқ! ‬
Dialogue: 0,0:02:46.70,0:02:47.54,Default,,0,0,0,,(тыныс алу дыбысы)
Dialogue: 0,0:02:48.91,0:02:51.37,Default,,0,0,0,,(Лукас бала) Күте тұрыңыз! Күте тұрыңыз!
Dialogue: 0,0:02:51.46,0:02:52.17,Default,,0,0,0,,Хехехе
Dialogue: 0,0:02:52.25,0:02:53.63,Default,,0,0,0,,Эй, күте тұр!
Dialogue: 0,0:02:55.50,0:02:56.59,Default,,0,0,0,,(қылыш тарту дыбысы)
Dialogue: 0,0:02:56.67,0:02:59.38,Default,,0,0,0,,Ол өте өсті...
Dialogue: 0,0:02:59.47,0:03:00.84,Default,,0,0,0,,(Санчоның айқайы)
Dialogue: 0,0:03:00.93,0:03:02.59,Default,,0,0,0,,Не болды, Санчо? ‬
Dialogue: 0,0:03:02.68,0:03:06.56,Default,,0,0,0,,Жоқ, мен әйеліме сенің қазір қандай екеніңді көрсетсем ғой.
Dialogue: 0,0:03:08.22,0:03:09.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:09.31,0:03:11.60,Default,,0,0,0,,(Лукас бала) Күте тұрыңыз! Күте тұрыңыз! Бұл дұрыс.
Dialogue: 0,0:03:11.69,0:03:12.77,Default,,0,0,0,,(Лукас бала) Уф
Dialogue: 0,0:03:12.85,0:03:13.90,Default,,0,0,0,,Қабыл ал! ‬
Dialogue: 0,0:03:14.56,0:03:16.44,Default,,0,0,0,,Мен бардым~~
Dialogue: 0,0:03:16.52,0:03:19.19,Default,,0,0,0,,Иә? Geregere? Қайда бардың? ‬
Dialogue: 0,0:03:19.28,0:03:20.32,Default,,0,0,0,,(Ер) Сен, сен (Лукас бала) Уау! ‬
Dialogue: 0,0:03:20.95,0:03:23.36,Default,,0,0,0,,(Ер) Аа, сізді таң қалдырғаным үшін кешіріңіз.
Dialogue: 0,0:03:24.03,0:03:24.99,Default,,0,0,0,,О? ‬
Dialogue: 0,0:03:25.62,0:03:27.83,Default,,0,0,0,,Сізде таңғажайып шар бар.
Dialogue: 0,0:03:28.87,0:03:30.50,Default,,0,0,0,,Маған бірдеңе көрсете аласыз ба? ‬
Dialogue: 0,0:03:30.58,0:03:33.37,Default,,0,0,0,,Сәлем Лукас, саяхатқа шығатын кез келді.
Dialogue: 0,0:03:33.46,0:03:34.46,Default,,0,0,0,,(Бала Лукас) Иә.
Dialogue: 0,0:03:35.96,0:03:41.05,Default,,0,0,0,,(Лукас бала) Хохохохохохохохохо
Dialogue: 0,0:03:43.72,0:03:46.43,Default,,0,0,0,,Ха ха ха ха! ‬
Dialogue: 0,0:03:49.64,0:03:52.56,Default,,0,0,0,,(Лукас ұйықтап жатқанда сөйлейді) Әкесі әлемдегі ең күшті.
Dialogue: 0,0:03:54.02,0:03:56.40,Default,,0,0,0,,Сәлем! Алыңыз! ‬
Dialogue: 0,0:03:57.19,0:03:58.86,Default,,0,0,0,,(Лукас бала) Сәлем! Уф! ‬
Dialogue: 0,0:03:59.57,0:04:01.36,Default,,0,0,0,,Сіз жақсардыңыз, Лукас.
Dialogue: 0,0:04:01.44,0:04:02.61,Default,,0,0,0,,Әкем бақытты.
Dialogue: 0,0:04:03.11,0:04:06.78,Default,,0,0,0,,А... жыл сайын осы уақытта
Dialogue: 0,0:04:06.87,0:04:08.70,Default,,0,0,0,,Бұл көңілсіз...
Dialogue: 0,0:04:09.66,0:04:11.37,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:04:11.45,0:04:13.21,Default,,0,0,0,,‪‬
Dialogue: 0,0:04:13.29,0:04:15.17,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:04:16.04,0:04:19.34,Default,,0,0,0,,Мен күдікті емеспін. Менің атым Паппас.
Dialogue: 0,0:04:19.67,0:04:21.05,Default,,0,0,0,,Мені патша шақырды.
Dialogue: 0,0:04:21.13,0:04:24.26,Default,,0,0,0,,‪… ‬
Dialogue: 0,0:04:25.26,0:04:27.26,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:04:27.35,0:04:28.89,Default,,0,0,0,,‪‬
Dialogue: 0,0:04:28.97,0:04:32.31,Default,,0,0,0,,Папас мырзаға оралыңыз.
Dialogue: 0,0:04:32.39,0:04:34.39,Default,,0,0,0,,(Бала Генри) Маған ұнамайды, өйткені ол шулы.
Dialogue: 0,0:04:34.48,0:04:36.31,Default,,0,0,0,,Аумақтың сыртында қауіпті
Dialogue: 0,0:04:36.40,0:04:39.15,Default,,0,0,0,,Шулы Том! Мен тағы да арқама бақа қондырамын! ‬
Dialogue: 0,0:04:39.23,0:04:39.90,Default,,0,0,0,,‪‬
Dialogue: 0,0:04:39.98,0:04:40.57,Default,,0,0,0,,Хехехе
Dialogue: 0,0:04:41.23,0:04:42.65,Default,,0,0,0,,‪（）‬
Dialogue: 0,0:04:43.28,0:04:44.57,Default,,0,0,0,,(Генри бала) Сіз кімсіз?
Dialogue: 0,0:04:44.65,0:04:45.86,Default,,0,0,0,,‪ ‬
Dialogue: 0,0:04:46.36,0:04:47.82,Default,,0,0,0,,‪‬
Dialogue: 0,0:04:47.91,0:04:50.12,Default,,0,0,0,,Сізден де мені қорғауды сұрады ма? ‬
Dialogue: 0,0:04:50.20,0:04:50.83,Default,,0,0,0,,Иә
Dialogue: 0,0:04:51.29,0:04:52.58,Default,,0,0,0,,Сіз Генрисіз.
Dialogue: 0,0:04:52.66,0:04:54.91,Default,,0,0,0,,Маған дұрыс ханзада Генри деп атаңыз.
Dialogue: 0,0:04:55.00,0:04:57.33,Default,,0,0,0,,Мен патшадан кейінгі ең ұлы адаммын.
Dialogue: 0,0:04:57.42,0:04:58.04,Default,,0,0,0,,‪‬
Dialogue: 0,0:04:58.46,0:05:00.96,Default,,0,0,0,,Менің әкем де әлемдегі ең мықты.
Dialogue: 0,0:05:01.55,0:05:02.80,Default,,0,0,0,,‪〜‬
Dialogue: 0,0:05:02.88,0:05:04.17,Default,,0,0,0,,‪‬
Dialogue: 0,0:05:04.72,0:05:07.76,Default,,0,0,0,,‪‬ ‪‬
Dialogue: 0,0:05:07.84,0:05:09.60,Default,,0,0,0,,‪‬
Dialogue: 0,0:05:09.68,0:05:11.43,Default,,0,0,0,,(Бала Генри) 3 2 1 Бастау (Бала Лукас) Уау! ‬
Dialogue: 0,0:05:12.93,0:05:14.27,Default,,0,0,0,,(Лукас бала) Бұл жасырын.
Dialogue: 0,0:05:15.35,0:05:17.31,Default,,0,0,0,,‪ ‬ ‪（）‬
Dialogue: 0,0:05:17.40,0:05:18.35,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:05:20.02,0:05:21.61,Default,,0,0,0,,‪（）‬ ‪（）‬
Dialogue: 0,0:05:21.90,0:05:23.57,Default,,0,0,0,,‪（） ‬
Dialogue: 0,0:05:24.11,0:05:26.20,Default,,0,0,0,,(Генри бала) Не істеп жатырсың! Жіберу! ‬
Dialogue: 0,0:05:26.28,0:05:27.78,Default,,0,0,0,,‪‬
Dialogue: 0,0:05:27.86,0:05:30.33,Default,,0,0,0,,Әке! ‬
Dialogue: 0,0:05:30.95,0:05:32.74,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:05:32.83,0:05:34.95,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:05:35.04,0:05:36.79,Default,,0,0,0,,Қашайық. (Бала Генри) Мен күштімін...
Dialogue: 0,0:05:37.37,0:05:38.92,Default,,0,0,0,,Бұл рас болды
Dialogue: 0,0:05:39.00,0:05:40.04,Default,,0,0,0,,(Джемманың дауысы) Хохохохо
Dialogue: 0,0:05:40.46,0:05:43.38,Default,,0,0,0,,Хохохохохохо
Dialogue: 0,0:05:43.84,0:05:46.51,Default,,0,0,0,,Бұл керемет, хехехе
Dialogue: 0,0:05:46.88,0:05:50.51,Default,,0,0,0,,Джами мен Гонцты жеңу хахахаха
Dialogue: 0,0:05:50.60,0:05:51.68,Default,,0,0,0,,Гаймма! ‬
Dialogue: 0,0:05:51.76,0:05:54.93,Default,,0,0,0,,Бірақ мұны істесек ше?
Dialogue: 0,0:05:55.39,0:05:56.48,Default,,0,0,0,,(Бала Лукас пен Бала Генри) Уау!
Dialogue: 0,0:05:59.06,0:05:59.98,Default,,0,0,0,,Арх! ‬
Dialogue: 0,0:06:00.06,0:06:03.48,Default,,0,0,0,,Охохохохо
Dialogue: 0,0:06:04.36,0:06:05.99,Default,,0,0,0,,Уф
Dialogue: 0,0:06:06.57,0:06:10.11,Default,,0,0,0,,Енді қанағат еткенше күрес! ‬
Dialogue: 0,0:06:10.20,0:06:13.74,Default,,0,0,0,,Хе хе хе хе хе...
Dialogue: 0,0:06:14.16,0:06:16.87,Default,,0,0,0,,Сіз бұрын жақсы жұмыс істедіңіз.
Dialogue: 0,0:06:16.95,0:06:18.21,Default,,0,0,0,,Өзіңізді дайындаңыз! ‬
Dialogue: 0,0:06:18.29,0:06:19.04,Default,,0,0,0,,‪‬
Dialogue: 0,0:06:19.12,0:06:19.87,Default,,0,0,0,,Арх! ‬
Dialogue: 0,0:06:20.25,0:06:21.67,Default,,0,0,0,,(күлді)
Dialogue: 0,0:06:21.75,0:06:22.79,Default,,0,0,0,,Лукас! ‬
Dialogue: 0,0:06:23.34,0:06:25.21,Default,,0,0,0,,Оян, Лукас! ‬
Dialogue: 0,0:06:27.22,0:06:28.84,Default,,0,0,0,,Уау! Апыр-ай! ‬
Dialogue: 0,0:06:28.93,0:06:30.43,Default,,0,0,0,,Лукас, тыңда! ‬
Dialogue: 0,0:06:30.51,0:06:31.68,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:06:31.76,0:06:33.39,Default,,0,0,0,,Арх! ‬
Dialogue: 0,0:06:33.97,0:06:35.56,Default,,0,0,0,,Уф
Dialogue: 0,0:06:37.35,0:06:38.89,Default,,0,0,0,,Арх! ‬
Dialogue: 0,0:06:40.40,0:06:41.69,Default,,0,0,0,,(Лукас бала) Әке! ‬
Dialogue: 0,0:06:41.77,0:06:45.07,Default,,0,0,0,,Хохохохохо
Dialogue: 0,0:06:45.73,0:06:49.40,Default,,0,0,0,,Баласын ойлайтын ата-ананың болғаны жақсы ғой, хаха.
Dialogue: 0,0:06:50.03,0:06:53.20,Default,,0,0,0,,Сосын соңғысын орындаймын.
Dialogue: 0,0:06:57.37,0:06:58.37,Default,,0,0,0,,Әке
Dialogue: 0,0:06:59.33,0:07:02.42,Default,,0,0,0,,Лукас... өтінемін...
Dialogue: 0,0:07:03.42,0:07:07.00,Default,,0,0,0,,Нуаааааа! ‬
Dialogue: 0,0:07:07.09,0:07:09.51,Default,,0,0,0,,(Люканың дауысы) Әке
Dialogue: 0,0:07:10.43,0:07:12.93,Default,,0,0,0,,(Люканың дауысы) Әке! Фуфуфуфуфу
Dialogue: 0,0:07:13.64,0:07:15.43,Default,,0,0,0,,Бұл өте жақсы естіледі.
Dialogue: 0,0:07:15.97,0:07:19.35,Default,,0,0,0,,Келіңіздер, көбірек тыңдауға рұқсат етіңіздер! ‬
Dialogue: 0,0:07:19.43,0:07:20.85,Default,,0,0,0,,Нуаааааа! ‬
Dialogue: 0,0:07:20.94,0:07:23.44,Default,,0,0,0,,Әке! Әке! ‬
Dialogue: 0,0:07:23.52,0:07:24.52,Default,,0,0,0,,Лукас…
Dialogue: 0,0:07:26.27,0:07:28.28,Default,,0,0,0,,Сенің анаң...
Dialogue: 0,0:07:29.74,0:07:31.36,Default,,0,0,0,,Ол тірі болуы керек...
Dialogue: 0,0:07:32.91,0:07:34.12,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:07:35.20,0:07:36.58,Default,,0,0,0,,Менің анам...
Dialogue: 0,0:07:38.04,0:07:39.00,Default,,0,0,0,,Уф
Dialogue: 0,0:07:39.08,0:07:43.17,Default,,0,0,0,,(Бала Лукас) Әке! Хохохохохо
Dialogue: 0,0:07:43.75,0:07:46.50,Default,,0,0,0,,Шынымен әдемі хехе...
Dialogue: 0,0:07:47.46,0:07:50.67,Default,,0,0,0,,Әке! ‬
Dialogue: 0,0:07:50.76,0:07:53.22,Default,,0,0,0,,Жібер! Уф! ‬
Dialogue: 0,0:07:53.68,0:07:57.47,Default,,0,0,0,,Құл болып бақытты өмір сүр
Dialogue: 0,0:07:57.56,0:07:59.64,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:08:00.22,0:08:05.31,Default,,0,0,0,,Уф! Ха ха ха ха ха
Dialogue: 0,0:08:07.86,0:08:09.65,Default,,0,0,0,,(Генри) Жақсысың ба? Лукас
Dialogue: 0,0:08:10.36,0:08:12.03,Default,,0,0,0,,Мен тағы да таң қалдым.
Dialogue: 0,0:08:12.40,0:08:15.57,Default,,0,0,0,,Жоқ, менде бәрі жақсы, Генри.
Dialogue: 0,0:08:15.66,0:08:18.16,Default,,0,0,0,,А, мені олай атама.
Dialogue: 0,0:08:18.58,0:08:20.87,Default,,0,0,0,,Маған дұрыс ханзада Генри деп атаңыз.
Dialogue: 0,0:08:20.95,0:08:22.71,Default,,0,0,0,,Сен менің қолбасымсың.
Dialogue: 0,0:08:23.12,0:08:26.17,Default,,0,0,0,,Сіз бұл туралы қашаннан бері ерекше болдыңыз? ‬
Dialogue: 0,0:08:26.25,0:08:27.96,Default,,0,0,0,,Екеуміз де құл болсақ та
Dialogue: 0,0:08:28.04,0:08:30.30,Default,,0,0,0,,Бұл жай ғана менің табиғатым. Еш нәрсе істей алмайсың.
Dialogue: 0,0:08:31.26,0:08:32.88,Default,,0,0,0,,Бірақ 10 жыл өтті...
Dialogue: 0,0:08:32.97,0:08:36.26,Default,,0,0,0,,Бұл ғибадатханадан қашу мүмкін емес пе?
Dialogue: 0,0:08:36.34,0:08:38.18,Default,,0,0,0,,Бұл қауіпті.
Dialogue: 0,0:08:38.26,0:08:41.02,Default,,0,0,0,,Сен мені неше рет айтуға мәжбүрлейсің?
Dialogue: 0,0:08:45.02,0:08:47.73,Default,,0,0,0,,(Хокман) Эй! Айналаңдап жүрме! ‬
Dialogue: 0,0:08:48.15,0:08:51.57,Default,,0,0,0,,(Хокмен) Сен менің жолыма түстің! (Құл) Уау...
Dialogue: 0,0:08:53.11,0:08:56.95,Default,,0,0,0,,(А құл) Хехехехе о эй
Dialogue: 0,0:08:57.53,0:08:58.53,Default,,0,0,0,,Не?
Dialogue: 0,0:08:58.91,0:09:01.87,Default,,0,0,0,,Балалар бұл жерден кеткіңіз келеді.
Dialogue: 0,0:09:03.00,0:09:05.08,Default,,0,0,0,,(Генри) Шығудың жолы бар ма? ‬
Dialogue: 0,0:09:05.16,0:09:06.00,Default,,0,0,0,,Бар
Dialogue: 0,0:09:06.08,0:09:07.12,Default,,0,0,0,,Алайда
Dialogue: 0,0:09:07.88,0:09:09.92,Default,,0,0,0,,Бөшкедегі біреуі ғана
Dialogue: 0,0:09:10.00,0:09:10.80,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:09:10.88,0:09:12.80,Default,,0,0,0,,Бұл мәйіт. Бұл мәйіт.
Dialogue: 0,0:09:13.34,0:09:15.13,Default,,0,0,0,,Бұған шыдамағандар
Dialogue: 0,0:09:15.22,0:09:17.80,Default,,0,0,0,,Бөшкеге салып, өзенге лақтырмаңыз.
Dialogue: 0,0:09:17.89,0:09:19.14,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:09:19.22,0:09:20.93,Default,,0,0,0,,(Генри) Міне болды! ‬
Dialogue: 0,0:09:21.01,0:09:22.06,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:09:22.31,0:09:25.06,Default,,0,0,0,,(Бөшкенің құлаған дыбысы)
Dialogue: 0,0:09:36.61,0:09:38.28,Default,,0,0,0,,Сіз мұны шынымен жасайсыз ба? ‬
Dialogue: 0,0:09:38.78,0:09:42.20,Default,,0,0,0,,Әрине, мен мұны жалғыз жасаймын.
Dialogue: 0,0:09:43.33,0:09:45.37,Default,,0,0,0,,Сонда оған көмектесу мүмкін емес...
Dialogue: 0,0:09:48.54,0:09:50.21,Default,,0,0,0,,Ой, ау, не істеп жатырсың! ‬
Dialogue: 0,0:09:50.29,0:09:51.54,Default,,0,0,0,,Сасық! Тоқта! ‬
Dialogue: 0,0:09:51.63,0:09:53.34,Default,,0,0,0,,Тынш, мен тауып беремін.
Dialogue: 0,0:09:53.42,0:09:54.80,Default,,0,0,0,,Бұл не? ‬
Dialogue: 0,0:09:55.26,0:09:57.51,Default,,0,0,0,,Ішінде сол қалқып тұрды.
Dialogue: 0,0:09:57.59,0:09:58.22,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:09:58.30,0:09:59.89,Default,,0,0,0,,(Шыбындардың дыбысы)
Dialogue: 0,0:09:59.97,0:10:01.22,Default,,0,0,0,,(Генри) Бұл...
Dialogue: 0,0:10:01.60,0:10:03.81,Default,,0,0,0,,Жоқ... Эй! ‬
Dialogue: 0,0:10:04.81,0:10:07.77,Default,,0,0,0,,Оны орындау кезінде өте сақ болу керек.
Dialogue: 0,0:10:07.85,0:10:08.64,Default,,0,0,0,,(Шыбындардың дыбысы)
Dialogue: 0,0:10:23.03,0:10:24.45,Default,,0,0,0,,(Емен) Иә? ‬
Dialogue: 0,0:10:24.54,0:10:27.08,Default,,0,0,0,,Мына бөшке осындай жерде болды ма? ‬
Dialogue: 0,0:10:27.46,0:10:29.12,Default,,0,0,0,,(Емен патшасы) Бұл, әрине, біртүрлі.
Dialogue: 0,0:10:29.21,0:10:31.08,Default,,0,0,0,,(бөшкенің соғу дыбысы)
Dialogue: 0,0:10:36.71,0:10:38.76,Default,,0,0,0,,(Емен патшасы) Уау! ‬
Dialogue: 0,0:10:38.84,0:10:40.68,Default,,0,0,0,,(Емен патшасы) Боқ~
Dialogue: 0,0:10:41.09,0:10:42.97,Default,,0,0,0,,Тезірек, ағып кетіңіз! ‬
Dialogue: 0,0:10:43.05,0:10:45.01,Default,,0,0,0,,(Емен) Иә...
Dialogue: 0,0:10:49.85,0:10:51.10,Default,,0,0,0,,(Орктар) Ууууууууу!
Dialogue: 0,0:11:05.08,0:11:07.66,Default,,0,0,0,,(Лука мен Генри) Иә? Ой ой
Dialogue: 0,0:11:07.75,0:11:11.96,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:11:12.54,0:11:14.63,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:11:14.71,0:11:16.34,Default,,0,0,0,,(су дыбысы)
Dialogue: 0,0:11:20.59,0:11:21.93,Default,,0,0,0,,(Лука мен Генри) Фуха! ‬
Dialogue: 0,0:11:22.01,0:11:25.81,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:11:26.43,0:11:27.68,Default,,0,0,0,,Тірі
Dialogue: 0,0:11:28.27,0:11:30.14,Default,,0,0,0,,Өмір бар
Dialogue: 0,0:11:30.23,0:11:32.98,Default,,0,0,0,,Сенгісіз! ‬
Dialogue: 0,0:11:33.06,0:11:34.40,Default,,0,0,0,,(Хокман) Ол қашқын.
Dialogue: 0,0:11:35.06,0:11:38.28,Default,,0,0,0,,(Лука мен Генри) Уау! ‬
Dialogue: 0,0:11:42.28,0:11:46.45,Default,,0,0,0,,(Лука мен Генри) Ооо! ‬
Dialogue: 0,0:11:47.41,0:11:49.70,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:11:51.33,0:11:52.87,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:11:52.96,0:11:54.96,Default,,0,0,0,,(Лука мен Генри) Уау! ‬
Dialogue: 0,0:11:56.38,0:11:57.71,Default,,0,0,0,,(Лука мен Генри)
Dialogue: 0,0:11:59.05,0:11:59.88,Default,,0,0,0,,га
Dialogue: 0,0:11:59.96,0:12:02.38,Default,,0,0,0,,(Лука мен Генри) Уау! ‬
Dialogue: 0,0:12:09.64,0:12:11.31,Default,,0,0,0,,(Орктар) Пуахахахаха
Dialogue: 0,0:12:11.39,0:12:14.73,Default,,0,0,0,,Рахмет және тағы кездескенше.
Dialogue: 0,0:12:14.81,0:12:16.90,Default,,0,0,0,,(Емен) Мен тым көп ішіп алдым.
Dialogue: 0,0:12:16.98,0:12:23.78,Default,,0,0,0,,(Орктар) Уау!
Dialogue: 0,0:12:30.08,0:12:31.25,Default,,0,0,0,,Сәлем
Dialogue: 0,0:12:32.71,0:12:34.21,Default,,0,0,0,,Сіз қазір шыға аласыз.
Dialogue: 0,0:12:34.29,0:12:36.04,Default,,0,0,0,,Иә (Генри) Хмм.
Dialogue: 0,0:12:37.96,0:12:39.96,Default,,0,0,0,,Эй, мынаны іш.
Dialogue: 0,0:12:40.05,0:12:41.67,Default,,0,0,0,,Жылы
Dialogue: 0,0:12:41.76,0:12:44.13,Default,,0,0,0,,Ах, итадакамасу
Dialogue: 0,0:12:47.72,0:12:49.18,Default,,0,0,0,,Га
Dialogue: 0,0:12:49.26,0:12:52.77,Default,,0,0,0,,Кункун хмм, бәрібір сасық.
Dialogue: 0,0:12:53.89,0:12:57.40,Default,,0,0,0,,Кешіріңіз, мұның астарында мән-жайлар бар...
Dialogue: 0,0:12:57.48,0:12:58.77,Default,,0,0,0,,Әй, бұл...
Dialogue: 0,0:12:59.19,0:13:00.40,Default,,0,0,0,,Неден бастау керек?
Dialogue: 0,0:13:00.48,0:13:02.40,Default,,0,0,0,,Мен Пусанмын
Dialogue: 0,0:13:02.49,0:13:04.49,Default,,0,0,0,,Қашқындарды қабыл алыңыздар! ‬
Dialogue: 0,0:13:04.95,0:13:07.24,Default,,0,0,0,,Мұнда ғибадатхананы зерттеу үшін Әулие Бересте.
Dialogue: 0,0:13:07.32,0:13:08.74,Default,,0,0,0,,Мен дүкен ашып жатырмын.
Dialogue: 0,0:13:08.82,0:13:11.20,Default,,0,0,0,,Өте қауіпті... иә? ‬
Dialogue: 0,0:13:11.29,0:13:12.83,Default,,0,0,0,,Жақсы
Dialogue: 0,0:13:13.20,0:13:16.08,Default,,0,0,0,,Бірақ жағдай осылай жалғаса берсе, бұл үлкен мәселе болады.
Dialogue: 0,0:13:16.62,0:13:19.21,Default,,0,0,0,,Шамасы, Гема жындар әлемінің қақпасын ашты.
Dialogue: 0,0:13:19.88,0:13:22.59,Default,,0,0,0,,Мен Ұлы жын патша Милдратты тірілткім келеді.
Dialogue: 0,0:13:23.13,0:13:24.67,Default,,0,0,0,,Милдрас? ‬
Dialogue: 0,0:13:25.26,0:13:30.97,Default,,0,0,0,,Бұл әлемді қараңғылыққа батыратын ең күшті құбыжық.
Dialogue: 0,0:13:31.85,0:13:34.98,Default,,0,0,0,,Бір кездері Скайлингтер Милдратты мөрлеп тастады.
Dialogue: 0,0:13:35.06,0:13:37.69,Default,,0,0,0,,Қанша адамның өліміне әкелді?
Dialogue: 0,0:13:38.85,0:13:39.94,Default,,0,0,0,,Джемма…
Dialogue: 0,0:13:40.94,0:13:42.61,Default,,0,0,0,,Ол былай деуге дейін барады...
Dialogue: 0,0:13:42.69,0:13:43.90,Default,,0,0,0,,Иә.
Dialogue: 0,0:13:44.65,0:13:47.40,Default,,0,0,0,,Сондықтан мен көктегі батырды іздедім.
Dialogue: 0,0:13:47.49,0:13:49.20,Default,,0,0,0,,Мен ойынды тоқтатқым келеді
Dialogue: 0,0:13:50.62,0:13:55.12,Default,,0,0,0,,Мен көп нәрсені еске саламын.
Dialogue: 0,0:14:03.71,0:14:05.88,Default,,0,0,0,,Vista портына сұрау
Dialogue: 0,0:14:07.05,0:14:08.93,Default,,0,0,0,,Эй, тыңдап тұрсың ба? ‬
Dialogue: 0,0:14:09.80,0:14:12.51,Default,,0,0,0,,Менің қолымнан келетіні осы
Dialogue: 0,0:14:12.60,0:14:15.18,Default,,0,0,0,,Қалғанын өзіміз жасаймыз.
Dialogue: 0,0:14:16.06,0:14:18.14,Default,,0,0,0,,Шебер бол
Dialogue: 0,0:14:18.23,0:14:20.31,Default,,0,0,0,,Жағымсыз иіс шыққан жігіттер.
Dialogue: 0,0:14:32.87,0:14:34.20,Default,,0,0,0,,Тоқта! ‬
Dialogue: 0,0:14:34.29,0:14:36.12,Default,,0,0,0,,Бұдан былай бұл желілік қалпақ! ‬
Dialogue: 0,0:14:36.66,0:14:38.96,Default,,0,0,0,,Біз бөгде адамдарды өткізе алмаймыз! ‬
Dialogue: 0,0:14:39.92,0:14:42.21,Default,,0,0,0,,(Генри) Сіз өте бастықсыз, Том.
Dialogue: 0,0:14:42.79,0:14:43.84,Default,,0,0,0,,Хмм? ‬
Dialogue: 0,0:14:43.92,0:14:45.34,Default,,0,0,0,,Неліктен менің атым?
Dialogue: 0,0:14:45.84,0:14:49.09,Default,,0,0,0,,(Генри) Сіз әлі де бақаларға жақсы емессіз бе? ‬
Dialogue: 0,0:14:49.17,0:14:52.22,Default,,0,0,0,,Ең жақсысы мен бақаны төсегіме жатқыздым.
Dialogue: 0,0:14:52.30,0:14:53.55,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:14:53.64,0:14:57.06,Default,,0,0,0,,Сөйлеудің бұл түрі маған ұнамайды...
Dialogue: 0,0:14:57.14,0:14:58.52,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:14:59.64,0:15:03.02,Default,,0,0,0,,Ханзада Генри! Мен сенің әлі тірі екеніңе сене алар емеспін! ‬
Dialogue: 0,0:15:03.11,0:15:04.94,Default,,0,0,0,,Маған рұқсат ет, Том.
Dialogue: 0,0:15:05.73,0:15:09.40,Default,,0,0,0,,Әулие Берес тауында құбыжықтар күшейіп келеді.
Dialogue: 0,0:15:09.49,0:15:11.78,Default,,0,0,0,,Мен тезірек әкеме хабарлауым керек.
Dialogue: 0,0:15:12.16,0:15:13.82,Default,,0,0,0,,Кеттік, Лукас.
Dialogue: 0,0:15:13.91,0:15:15.12,Default,,0,0,0,,күрсіну
Dialogue: 0,0:15:15.95,0:15:17.29,Default,,0,0,0,,Ал...
Dialogue: 0,0:15:17.37,0:15:19.79,Default,,0,0,0,,Неге менімен бармайсың? ‬
Dialogue: 0,0:15:20.96,0:15:22.42,Default,,0,0,0,,Әкемнің...
Dialogue: 0,0:15:23.42,0:15:26.96,Default,,0,0,0,,Әкемнің соңғы сөзі жанымда қалды.
Dialogue: 0,0:15:28.38,0:15:32.55,Default,,0,0,0,,Ол маңызды нәрсені жеткізгісі келгендей болды.
Dialogue: 0,0:15:34.64,0:15:36.51,Default,,0,0,0,,Бұл сіздің анаңыз туралы ма?
Dialogue: 0,0:15:36.93,0:15:38.14,Default,,0,0,0,,Иә
Dialogue: 0,0:15:38.52,0:15:41.69,Default,,0,0,0,,Неліктен мен Санта Роузға барамын?
Dialogue: 0,0:15:41.77,0:15:44.31,Default,,0,0,0,,Мен әкеммен бірге тұрған үйшік бар.
Dialogue: 0,0:15:44.98,0:15:46.11,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:15:47.23,0:15:49.57,Default,,0,0,0,,Бұл жерден басқа жол бар.
Dialogue: 0,0:15:49.65,0:15:51.95,Default,,0,0,0,,Сау бол, Генри
Dialogue: 0,0:15:52.86,0:15:55.20,Default,,0,0,0,,Ханзаданы ал, ақымақ.
Dialogue: 0,0:15:55.28,0:15:57.08,Default,,0,0,0,,Ол бұрынғыдай дөрекі.
Dialogue: 0,0:15:57.16,0:15:57.99,Default,,0,0,0,,Қазір барыңыз
Dialogue: 0,0:15:58.58,0:15:59.41,Default,,0,0,0,,Иә
Dialogue: 0,0:16:00.04,0:16:02.75,Default,,0,0,0,,Мен бір күні міндетті түрде Рейнхутқа қайта келемін.
Dialogue: 0,0:16:02.83,0:16:03.87,Default,,0,0,0,,-де
Dialogue: 0,0:16:10.71,0:16:12.42,Default,,0,0,0,,Лукас! Ашық
Dialogue: 0,0:16:16.14,0:16:17.39,Default,,0,0,0,,Не болды? ‬
Dialogue: 0,0:16:17.85,0:16:18.97,Default,,0,0,0,,Қалғаны
Dialogue: 0,0:16:19.85,0:16:22.06,Default,,0,0,0,,Өйткені бұл менің табиғатым
Dialogue: 0,0:16:22.14,0:16:23.94,Default,,0,0,0,,Көптен бері айта алмадым...
Dialogue: 0,0:16:24.90,0:16:25.90,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:26.90,0:16:29.27,Default,,0,0,0,,Сенің әкең...
Dialogue: 0,0:16:29.36,0:16:30.90,Default,,0,0,0,,Папа мырзаға...
Dialogue: 0,0:16:31.44,0:16:32.28,Default,,0,0,0,,Мен
Dialogue: 0,0:16:32.90,0:16:33.99,Default,,0,0,0,,Жоқ, I
Dialogue: 0,0:16:35.45,0:16:37.45,Default,,0,0,0,,Маған өмір берілгенін білемін.
Dialogue: 0,0:16:40.79,0:16:42.16,Default,,0,0,0,,Сонымен Лукас
Dialogue: 0,0:16:42.91,0:16:46.29,Default,,0,0,0,,Егер сізге бірдеңе болса, маған айтудан тартынбаңыз.
Dialogue: 0,0:16:46.75,0:16:48.54,Default,,0,0,0,,Бар күшіңізді салып жүгіріңіз
Dialogue: 0,0:17:02.52,0:17:04.89,Default,,0,0,0,,Санта Роуз өзгерген жоқ.
Dialogue: 0,0:17:12.86,0:17:17.78,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:17:20.20,0:17:22.79,Default,,0,0,0,,Мен қайтып келдім, әке.
Dialogue: 0,0:17:27.21,0:17:28.58,Default,,0,0,0,,Цука Сами! ‬
Dialogue: 0,0:17:29.75,0:17:34.09,Default,,0,0,0,,Е...
Dialogue: 0,0:17:38.84,0:17:41.60,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:17:42.14,0:17:44.56,Default,,0,0,0,,U~ Өрт Өрт Өрт
Dialogue: 0,0:17:44.64,0:17:45.56,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:17:46.02,0:17:47.64,Default,,0,0,0,,Уау, эй~
Dialogue: 0,0:17:48.06,0:17:49.94,Default,,0,0,0,,Ой-ау
Dialogue: 0,0:17:50.90,0:17:53.65,Default,,0,0,0,,Ооооооо
Dialogue: 0,0:17:59.62,0:18:01.41,Default,,0,0,0,,Ооо
Dialogue: 0,0:18:07.71,0:18:09.21,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:18:10.00,0:18:11.75,Default,,0,0,0,,Әкемнің бөлмесі? ‬
Dialogue: 0,0:18:17.17,0:18:18.38,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:18:22.35,0:18:23.81,Default,,0,0,0,,Бұл
Dialogue: 0,0:18:24.52,0:18:25.93,Default,,0,0,0,,Бұл күнделік.
Dialogue: 0,0:18:27.64,0:18:31.56,Default,,0,0,0,,«Мен көптен бері келе жатқан сұрақты шештім».
Dialogue: 0,0:18:32.31,0:18:36.57,Default,,0,0,0,,«Джема жындар әлемінің қақпасын ашатын сиқырды білгісі келетін сияқты».
Dialogue: 0,0:18:36.65,0:18:40.03,Default,,0,0,0,,«Олар аспан адамы Мартаны түрмеге қамап жатқан сияқты».
Dialogue: 0,0:18:40.57,0:18:43.16,Default,,0,0,0,,«Марта әлі тірі»
Dialogue: 0,0:18:43.24,0:18:45.20,Default,,0,0,0,,«Аспандағы қылыш пен батырды тап»
Dialogue: 0,0:18:46.37,0:18:49.33,Default,,0,0,0,,«Егер мен жындар әлемінің қақпасын мөрлей алсам...»
Dialogue: 0,0:18:49.41,0:18:51.71,Default,,0,0,0,,«Сіз Мартаны құтқара аласыз.»
Dialogue: 0,0:18:53.04,0:18:56.55,Default,,0,0,0,,«Ал мен Лукаспын».
Dialogue: 0,0:18:56.63,0:18:58.88,Default,,0,0,0,,«Мен аспанның батыры екенімді ойлаймын».
Dialogue: 0,0:19:00.26,0:19:01.59,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:19:02.64,0:19:04.72,Default,,0,0,0,,Мен батырмын ба? ‬
Dialogue: 0,0:19:13.02,0:19:16.32,Default,,0,0,0,,Хар…
Dialogue: 0,0:19:16.90,0:19:19.15,Default,,0,0,0,,Сіз ұры! Ооо
Dialogue: 0,0:19:19.82,0:19:23.07,Default,,0,0,0,,Бұл менің үйім! ‬
Dialogue: 0,0:19:23.16,0:19:24.58,Default,,0,0,0,,үшін? ‬
Dialogue: 0,0:19:25.66,0:19:27.12,Default,,0,0,0,,Санчо? ‬
Dialogue: 0,0:19:27.87,0:19:29.54,Default,,0,0,0,,Бұл көздер...
Dialogue: 0,0:19:29.62,0:19:31.67,Default,,0,0,0,,Жоқ, Лукас! ‬
Dialogue: 0,0:19:31.75,0:19:35.42,Default,,0,0,0,,О, сен тірісің! ‬
Dialogue: 0,0:19:35.50,0:19:36.59,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:19:36.67,0:19:39.42,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:19:39.97,0:19:42.43,Default,,0,0,0,,Уау, өте жақсы! ‬
Dialogue: 0,0:19:43.05,0:19:45.30,Default,,0,0,0,,Бұл дәм, мына дәм
Dialogue: 0,0:19:45.39,0:19:46.93,Default,,0,0,0,,Көбірек жей беріңіз.
Dialogue: 0,0:19:47.39,0:19:50.31,Default,,0,0,0,,Санчо, мен ешқашан бүгінгідей бақытты болған емеспін...
Dialogue: 0,0:19:50.39,0:19:53.15,Default,,0,0,0,,Уф уф
Dialogue: 0,0:19:53.94,0:19:57.11,Default,,0,0,0,,Мен әрқашан сендім
Dialogue: 0,0:19:57.19,0:19:59.82,Default,,0,0,0,,Кішкентай Лукас тірі.
Dialogue: 0,0:20:00.19,0:20:02.70,Default,,0,0,0,,Гема маған ғибадатхана салуды бұйырды.
Dialogue: 0,0:20:02.78,0:20:04.82,Default,,0,0,0,,Маған жаман қарады.
Dialogue: 0,0:20:04.91,0:20:06.53,Default,,0,0,0,,Мартаның әңгімесі қандай? ‬
Dialogue: 0,0:20:06.62,0:20:09.95,Default,,0,0,0,,Әкемнің күнделігінде мені түрмеге қамап жатқаны жазылған.
Dialogue: 0,0:20:10.04,0:20:12.46,Default,,0,0,0,,Мен оның соншалықты жақын екеніне сене алмадым
Dialogue: 0,0:20:12.54,0:20:14.96,Default,,0,0,0,,Менімен кездесе алмадың, солай ма? ‬
Dialogue: 0,0:20:15.04,0:20:17.09,Default,,0,0,0,,Айтсам, ол құл болған! ‬
Dialogue: 0,0:20:17.59,0:20:20.67,Default,,0,0,0,,Күнделікті шаршағанша жұмыс істедім.
Dialogue: 0,0:20:20.76,0:20:22.42,Default,,0,0,0,,Не? ‬
Dialogue: 0,0:20:23.22,0:20:26.18,Default,,0,0,0,,Мүмкін кішкентай Лукасты құтқарып қалуға болады.
Dialogue: 0,0:20:26.26,0:20:27.26,Default,,0,0,0,,Мен? ‬
Dialogue: 0,0:20:27.35,0:20:30.60,Default,,0,0,0,,Бұл көздер сенің Аспан қанының бар екендігінің дәлелі.
Dialogue: 0,0:20:30.68,0:20:33.19,Default,,0,0,0,,Сен аспанның батырысың
Dialogue: 0,0:20:33.27,0:20:36.15,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:20:36.23,0:20:39.36,Default,,0,0,0,,Папас мырза да солай күткен болуы керек.
Dialogue: 0,0:20:39.44,0:20:41.69,Default,,0,0,0,,Күнделігіме осылай жаздым.
Dialogue: 0,0:20:41.78,0:20:42.90,Default,,0,0,0,,Иә! ‬
Dialogue: 0,0:20:42.99,0:20:44.95,Default,,0,0,0,,Папас мырза да былай деді:
Dialogue: 0,0:20:45.03,0:20:48.87,Default,,0,0,0,,Аспанның қылышын қынынан суырып алатын батыр ғана.
Dialogue: 0,0:20:48.95,0:20:52.54,Default,,0,0,0,,Егер сіз бұл қылышты жындар әлемінің қақпасына лақтырсаңыз,
Dialogue: 0,0:20:52.62,0:20:54.33,Default,,0,0,0,,Қақпа мөрленген кезде! ‬
Dialogue: 0,0:20:54.41,0:20:57.88,Default,,0,0,0,,Бірақ мұндай қылышты қайдан таба аламын? ‬
Dialogue: 0,0:20:58.38,0:20:59.46,Default,,0,0,0,,Сенімді болыңыз
Dialogue: 0,0:20:59.54,0:21:00.71,Default,,0,0,0,,Рудман мырзадан
Dialogue: 0,0:21:00.80,0:21:03.76,Default,,0,0,0,,Мен сенің Аспан семсерін алғаныңды естідім.
Dialogue: 0,0:21:04.26,0:21:05.30,Default,,0,0,0,,Бар...
Dialogue: 0,0:21:05.38,0:21:06.22,Default,,0,0,0,,Кішкентай Лукас
Dialogue: 0,0:21:07.22,0:21:10.72,Default,,0,0,0,,Сарабонаға барып, Рудман мырзамен кездесуіңізді өтінемін! ‬
Dialogue: 0,0:21:11.18,0:21:14.18,Default,,0,0,0,,Сарабона? Сонша алыс па? ‬
Dialogue: 0,0:21:14.64,0:21:18.15,Default,,0,0,0,,Құбыжықтар басқан ормандарды, үңгірлерді және шөлдерді кесіп өтіңіз.
Dialogue: 0,0:21:18.23,0:21:20.73,Default,,0,0,0,,Бұл... Мынаны пайдаланыңыз! ‬
Dialogue: 0,0:21:20.82,0:21:22.19,Default,,0,0,0,,Папас мырзадан естелік.
Dialogue: 0,0:21:23.11,0:21:25.20,Default,,0,0,0,,Әкенің қылышы...
Dialogue: 0,0:21:26.36,0:21:28.28,Default,,0,0,0,,Бұл мен үшін тым ауыр
Dialogue: 0,0:21:28.82,0:21:30.83,Default,,0,0,0,,Мен сенің әкең емеспін
Dialogue: 0,0:21:30.91,0:21:32.62,Default,,0,0,0,,Ол жерге жету мүмкін емес
Dialogue: 0,0:21:33.20,0:21:34.79,Default,,0,0,0,,Мен қорқамын
Dialogue: 0,0:21:35.41,0:21:38.38,Default,,0,0,0,,Мен қорқамын, қорқамын, шыдай алмаймын
Dialogue: 0,0:21:43.71,0:21:45.59,Default,,0,0,0,,Маған анаң туралы айтып бер.
Dialogue: 0,0:21:46.38,0:21:49.76,Default,,0,0,0,,Ол әдемі және ақылды болды.
Dialogue: 0,0:21:50.72,0:21:52.93,Default,,0,0,0,,Менің есте сақтау қабілетім нашар
Dialogue: 0,0:21:53.60,0:21:57.39,Default,,0,0,0,,(Марта) Мұнда кел, Лукас.
Dialogue: 0,0:21:59.23,0:22:02.32,Default,,0,0,0,,(Лукас бала) Ананың қолы жылы
Dialogue: 0,0:22:03.23,0:22:07.99,Default,,0,0,0,,Әкемнің Мартаны құтқаруды шын тілегі еді.
Dialogue: 0,0:22:08.95,0:22:10.16,Default,,0,0,0,,Лукас…
Dialogue: 0,0:22:10.95,0:22:12.33,Default,,0,0,0,,Өтінемін...
Dialogue: 0,0:22:13.29,0:22:16.54,Default,,0,0,0,,Нувааааааааа! ‬
Dialogue: 0,0:22:24.34,0:22:28.38,Default,,0,0,0,,♪～
Dialogue: 0,0:22:37.06,0:22:39.73,Default,,0,0,0,,Барғаныңыз дұрыс! Барайық! ‬
Dialogue: 0,0:22:48.45,0:22:50.32,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:22:51.57,0:22:52.53,Default,,0,0,0,,Сәлем! ‬
Dialogue: 0,0:22:53.33,0:22:55.66,Default,,0,0,0,,Сәлем! О құдайым-ай! ‬
Dialogue: 0,0:22:57.04,0:22:59.25,Default,,0,0,0,,...
Dialogue: 0,0:22:59.96,0:23:00.92,Default,,0,0,0,,Жоқ! ‬
Dialogue: 0,0:23:03.17,0:23:04.50,Default,,0,0,0,,Әй! ‬
Dialogue: 0,0:23:04.59,0:23:05.59,Default,,0,0,0,,Баги! ‬
Dialogue: 0,0:23:08.92,0:23:10.05,Default,,0,0,0,,Уау
Dialogue: 0,0:23:11.43,0:23:12.59,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:23:13.05,0:23:16.06,Default,,0,0,0,,Маған шламды серік керек емес.
Dialogue: 0,0:23:22.94,0:23:24.27,Default,,0,0,0,,Мен...
Dialogue: 0,0:23:24.36,0:23:25.77,Default,,0,0,0,,Өте керемет пе? ‬
Dialogue: 0,0:23:27.73,0:23:28.44,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:23:29.32,0:23:32.11,Default,,0,0,0,,Не, сен тағы артымнан келе жатырсың ба?
Dialogue: 0,0:23:32.20,0:23:34.37,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:23:35.62,0:23:36.91,Default,,0,0,0,,Кеттік, Сура...
Dialogue: 0,0:23:39.58,0:23:41.37,Default,,0,0,0,,Сурарин! ‬
Dialogue: 0,0:23:43.58,0:23:44.92,Default,,0,0,0,,Әке
Dialogue: 0,0:23:45.00,0:23:48.46,Default,,0,0,0,,Мен шынымен де батырмын ба?
Dialogue: 0,0:23:48.84,0:23:51.13,Default,,0,0,0,,Мен қателестім.
Dialogue: 0,0:23:51.22,0:23:53.30,Default,,0,0,0,,Бұл сапар қате! ‬
Dialogue: 0,0:23:53.39,0:23:53.97,Default,,0,0,0,,(Үру)
Dialogue: 0,0:23:54.05,0:23:57.31,Default,,0,0,0,,Әй, эй, сәл тынышталайық.
Dialogue: 0,0:23:57.39,0:23:59.35,Default,,0,0,0,,Қараңызшы, ешқандай дұшпандық жоқ.
Dialogue: 0,0:23:59.43,0:24:02.19,Default,,0,0,0,,(еңілдеп) Жоқ, бұл ештеңе емес.
Dialogue: 0,0:24:02.27,0:24:03.06,Default,,0,0,0,,Жарайды
Dialogue: 0,0:24:03.65,0:24:05.11,Default,,0,0,0,,Өйткені бәрі жақсы
Dialogue: 0,0:24:06.73,0:24:08.61,Default,,0,0,0,,Жүгірейік! ‬
Dialogue: 0,0:24:09.28,0:24:12.61,Default,,0,0,0,,Маған үзіліс беріңізші.
Dialogue: 0,0:24:13.07,0:24:14.32,Default,,0,0,0,,(Үру)
Dialogue: 0,0:24:14.87,0:24:18.29,Default,,0,0,0,,Хе хе ха ха ха
Dialogue: 0,0:24:18.99,0:24:20.83,Default,,0,0,0,,үшін? Geregere…
Dialogue: 0,0:24:21.33,0:24:24.21,Default,,0,0,0,,Бұл біраз әбігершілік емес пе! ‬
Dialogue: 0,0:24:27.38,0:24:28.88,Default,,0,0,0,,Бар
Dialogue: 0,0:24:32.80,0:24:35.80,Default,,0,0,0,,♪～
Dialogue: 0,0:24:38.18,0:24:40.10,Default,,0,0,0,,О, менің...
Dialogue: 0,0:24:50.94,0:24:53.99,Default,,0,0,0,,Солай ма? Сарабонаны Буон деген жігіт жасады...
Dialogue: 0,0:24:54.49,0:24:57.78,Default,,0,0,0,,(Әйел) Біліңіз, егер сіз Буонды жеңсеңіз, Рудман отбасын мұра ете аласыз.
Dialogue: 0,0:24:57.87,0:25:00.99,Default,,0,0,0,,Ондаған атақты адамдар оған қарсы шықты.
Dialogue: 0,0:25:01.08,0:25:03.79,Default,,0,0,0,,Ешкім қайтып келмейді.
Dialogue: 0,0:25:03.87,0:25:04.92,Default,,0,0,0,,Уау...
Dialogue: 0,0:25:05.00,0:25:07.17,Default,,0,0,0,,(Ер адам) Ол үлкен жігіт.
Dialogue: 0,0:25:07.25,0:25:08.25,Default,,0,0,0,,(Жер діріл) (Қала тұрғындары) Ооо! ‬
Dialogue: 0,0:25:08.34,0:25:11.05,Default,,0,0,0,,(Буонның күркіреуі)
Dialogue: 0,0:25:11.59,0:25:15.09,Default,,0,0,0,,Ол сол ғибадатханада ұйықтап жатыр.
Dialogue: 0,0:25:15.63,0:25:17.26,Default,,0,0,0,,Шынайы...
Dialogue: 0,0:25:22.27,0:25:27.81,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:25:28.27,0:25:30.48,Default,,0,0,0,,Я, мен қиналып қалдым...
Dialogue: 0,0:25:32.07,0:25:32.82,Default,,0,0,0,,О! ‬
Dialogue: 0,0:25:32.90,0:25:35.32,Default,,0,0,0,,Тағы бір жаңа қарсылас.
Dialogue: 0,0:25:35.40,0:25:36.78,Default,,0,0,0,,Сіз жындарды ұстайсыз ба? ‬
Dialogue: 0,0:25:38.16,0:25:40.78,Default,,0,0,0,,Бұл жолы Буонның жігіті! ‬
Dialogue: 0,0:25:40.87,0:25:41.62,Default,,0,0,0,,(Флора) Әке! ‬
Dialogue: 0,0:25:41.70,0:25:43.58,Default,,0,0,0,,О, Флора
Dialogue: 0,0:25:43.66,0:25:45.04,Default,,0,0,0,,Бұл жаңа қарсылас.
Dialogue: 0,0:25:46.46,0:25:47.92,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:25:48.00,0:25:51.09,Default,,0,0,0,,Мен осы сияқты нәрселерге қарап кімге үйленетінімді шешуге қарсымын.
Dialogue: 0,0:25:51.84,0:25:53.38,Default,,0,0,0,,Енді не айтып тұрсың?
Dialogue: 0,0:25:53.46,0:25:55.72,Default,,0,0,0,,(Флора) Әйтеуір, бас тартамын.
Dialogue: 0,0:25:55.80,0:25:58.26,Default,,0,0,0,,А, күте тұр, күте тұр.
Dialogue: 0,0:26:00.35,0:26:02.81,Default,,0,0,0,,Не? (Флора) Кя! ‬
Dialogue: 0,0:26:05.10,0:26:07.14,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:26:07.23,0:26:08.27,Default,,0,0,0,,Амансың ба? ‬
Dialogue: 0,0:26:10.23,0:26:10.86,Default,,0,0,0,,Иә! ‬
Dialogue: 0,0:26:12.23,0:26:12.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:14.07,0:26:15.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:15.86,0:26:17.20,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:26:18.49,0:26:19.45,Default,,0,0,0,,Сіз...
Dialogue: 0,0:26:20.28,0:26:21.74,Default,,0,0,0,,Мүмкін Флора? ‬
Dialogue: 0,0:26:24.54,0:26:25.79,Default,,0,0,0,,Лукас мырза...
Dialogue: 0,0:26:27.21,0:26:29.21,Default,,0,0,0,,Ол тірі болды.
Dialogue: 0,0:26:29.29,0:26:30.38,Default,,0,0,0,,Иә! ‬
Dialogue: 0,0:26:31.96,0:26:34.59,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:26:34.67,0:26:37.42,Default,,0,0,0,,Ха ха ха ха атта хе хе хе хе хе
Dialogue: 0,0:26:37.51,0:26:38.76,Default,,0,0,0,,(жылау)
Dialogue: 0,0:26:38.84,0:26:39.34,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:26:39.84,0:26:41.34,Default,,0,0,0,,Не болды, Флора?
Dialogue: 0,0:26:42.26,0:26:46.47,Default,,0,0,0,,Иә? Сіз, кездейсоқ ...
Dialogue: 0,0:26:47.68,0:26:51.10,Default,,0,0,0,,Мен ешқашан Лукас тірі деп ойлаған емеспін.
Dialogue: 0,0:26:51.19,0:26:53.11,Default,,0,0,0,,Флора күйеуінің қайтыс болғанын естігенде,
Dialogue: 0,0:26:53.19,0:26:55.98,Default,,0,0,0,,Мен ұзақ жыл өмір сүрдім.
Dialogue: 0,0:26:56.07,0:26:57.74,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,0:26:58.45,0:27:02.20,Default,,0,0,0,,...Сонымен сіз Буонға да қарсы шыққыңыз келе ме? ‬
Dialogue: 0,0:27:02.28,0:27:03.62,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:27:03.70,0:27:06.24,Default,,0,0,0,,Сен олай сөз айтқан жоқсың.
Dialogue: 0,0:27:06.33,0:27:07.83,Default,,0,0,0,,Егер сіз Буонды жеңсеңіз
Dialogue: 0,0:27:07.91,0:27:10.67,Default,,0,0,0,,Ақырында мен Рудман отбасының мұрагері боламын.
Dialogue: 0,0:27:10.75,0:27:14.29,Default,,0,0,0,,Бұл Флораға үйленуге болатынын білдіреді.
Dialogue: 0,0:27:14.38,0:27:16.80,Default,,0,0,0,,А... Неке? ‬
Dialogue: 0,0:27:16.88,0:27:19.34,Default,,0,0,0,,Менің ойымша, бұл жаман оқиға емес.
Dialogue: 0,0:27:19.42,0:27:22.72,Default,,0,0,0,,Жоқ, жоқ, жоқ, мен маңызды нәрсені ұмытып қалдым.
Dialogue: 0,0:27:22.80,0:27:25.39,Default,,0,0,0,,Мен Буонды жеңе алмаймын.
Dialogue: 0,0:27:25.47,0:27:28.68,Default,,0,0,0,,Ммммммм...
Dialogue: 0,0:27:28.77,0:27:30.06,Default,,0,0,0,,Бәлкім, бәрі жақсы болады
Dialogue: 0,0:27:30.14,0:27:33.40,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Оны көргенде түсінесіз.
Dialogue: 0,0:27:33.48,0:27:36.44,Default,,0,0,0,,Жоқ, көздің түсі...
Dialogue: 0,0:27:37.03,0:27:39.61,Default,,0,0,0,,Мені аспанның батыры деп ойлайсың ба? ‬
Dialogue: 0,0:27:40.07,0:27:43.41,Default,,0,0,0,,Аспан семсерін жұлып алсаң, түсінесің, солай ма? ‬
Dialogue: 0,0:27:43.49,0:27:45.74,Default,,0,0,0,,Аспан қылышы Әлі осында ма? ‬
Dialogue: 0,0:27:45.83,0:27:46.95,Default,,0,0,0,,Оның шағуы
Dialogue: 0,0:27:47.54,0:27:49.83,Default,,0,0,0,,Менің ойымша, сізде де біраз үміт бар.
Dialogue: 0,0:27:50.66,0:27:51.67,Default,,0,0,0,,(құлыпты ашу дыбысы)
Dialogue: 0,0:27:51.75,0:27:55.38,Default,,0,0,0,,Енді аспанның семсері ішінде сақталады.
Dialogue: 0,0:27:55.46,0:27:57.71,Default,,0,0,0,,Тек оны тартып алыңыз! ‬
Dialogue: 0,0:27:57.80,0:27:59.34,Default,,0,0,0,,Аспан батыры! ‬
Dialogue: 0,0:28:05.85,0:28:07.31,Default,,0,0,0,,Иә? Иә? ‬
Dialogue: 0,0:28:09.06,0:28:11.14,Default,,0,0,0,,Ах! ! ‬
Dialogue: 0,0:28:11.23,0:28:12.94,Default,,0,0,0,,Олар оны алды...
Dialogue: 0,0:28:14.69,0:28:15.77,Default,,0,0,0,,Яғни...
Dialogue: 0,0:28:16.44,0:28:20.15,Default,,0,0,0,,Аспан қылышы Буон ғибадатханасында ма? ‬
Dialogue: 0,0:28:20.78,0:28:22.53,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:28:24.24,0:28:25.12,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:28:25.82,0:28:28.49,Default,,0,0,0,,Мен бұл туралы бір сәт ойланып көрейін бе? ‬
Dialogue: 0,0:28:34.42,0:28:35.54,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:28:35.63,0:28:37.13,Default,,0,0,0,,Лукас мырза
Dialogue: 0,0:28:38.04,0:28:39.71,Default,,0,0,0,,Флора-сан
Dialogue: 0,0:28:42.42,0:28:45.01,Default,,0,0,0,,Буонды бағындыру тоқтайды.
Dialogue: 0,0:28:45.09,0:28:48.51,Default,,0,0,0,,Бұл мен үшін біраз ауыр жүк...
Dialogue: 0,0:28:48.60,0:28:50.14,Default,,0,0,0,,Жақсы
Dialogue: 0,0:28:50.22,0:28:52.93,Default,,0,0,0,,Егер сіз Буонды бағындыруға шешім қабылдасаңыз
Dialogue: 0,0:28:53.02,0:28:54.98,Default,,0,0,0,,Мен не істеймін деп ойладым.
Dialogue: 0,0:28:55.06,0:28:57.40,Default,,0,0,0,,Сіз өте ауыр нәрсе айтып тұрсыз ба? ‬
Dialogue: 0,0:28:58.61,0:29:02.40,Default,,0,0,0,,Себебі мен Буонды жеңсем...
Dialogue: 0,0:29:02.90,0:29:04.15,Default,,0,0,0,,Сіздермен...
Dialogue: 0,0:29:04.65,0:29:05.20,Default,,0,0,0,,Бұл...
Dialogue: 0,0:29:05.61,0:29:07.87,Default,,0,0,0,,Жоқ, жоқ, керісінше.
Dialogue: 0,0:29:07.95,0:29:09.91,Default,,0,0,0,,Әрине, егер сіз Буонды жеңсеңіз
Dialogue: 0,0:29:09.99,0:29:11.62,Default,,0,0,0,,Мен ешқашан мұндай бақытты болған емеспін.
Dialogue: 0,0:29:11.70,0:29:13.62,Default,,0,0,0,,(Флора) Бірақ Буон... сен бақыттысың ба? ‬
Dialogue: 0,0:29:13.71,0:29:14.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:29:15.08,0:29:18.08,Default,,0,0,0,,Жоқ, бұл жалпы әңгіме.
Dialogue: 0,0:29:18.17,0:29:21.05,Default,,0,0,0,,Саған үйленетіндіктен емес.
Dialogue: 0,0:29:21.13,0:29:24.01,Default,,0,0,0,,Бұл маған ұнамайды, бірақ...
Dialogue: 0,0:29:24.09,0:29:27.05,Default,,0,0,0,,А, кешіріңізші.
Dialogue: 0,0:29:27.14,0:29:27.72,Default,,0,0,0,,Ах
Dialogue: 0,0:29:28.22,0:29:29.89,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:29:32.43,0:29:33.48,Default,,0,0,0,,Бұл...
Dialogue: 0,0:29:34.48,0:29:36.10,Default,,0,0,0,,Мынау! ‬
Dialogue: 0,0:29:36.64,0:29:37.69,Default,,0,0,0,,Бұл! ‬
Dialogue: 0,0:29:38.19,0:29:43.69,Default,,0,0,0,,Ууууууууу
Dialogue: 0,0:29:45.49,0:29:48.32,Default,,0,0,0,,(Буонның айқайы) (жердің шуылдауы)
Dialogue: 0,0:29:51.49,0:29:55.91,Default,,0,0,0,,(жану дыбысы)
Dialogue: 0,0:29:56.00,0:30:00.25,Default,,0,0,0,,Кім... пілдерді біріктірді...
Dialogue: 0,0:30:02.17,0:30:03.76,Default,,0,0,0,,(Ер адам) Әлі де бар ма? ‬
Dialogue: 0,0:30:03.84,0:30:05.01,Default,,0,0,0,,(Ер) Жоқ, жоқ.
Dialogue: 0,0:30:05.09,0:30:06.30,Default,,0,0,0,,(Ер) Мен оны қолдандым.
Dialogue: 0,0:30:06.38,0:30:08.01,Default,,0,0,0,,Менде бар.
Dialogue: 0,0:30:08.80,0:30:09.93,Default,,0,0,0,,(Әйел) Бұл кім? ‬
Dialogue: 0,0:30:10.01,0:30:12.22,Default,,0,0,0,,(Ер адам) Бұл кеше келген тұтынушы.
Dialogue: 0,0:30:12.81,0:30:14.02,Default,,0,0,0,,(ырылдаған дыбыс)
Dialogue: 0,0:30:14.10,0:30:16.85,Default,,0,0,0,,Сен есейдің, гереге (ырылдаған дыбыс)
Dialogue: 0,0:30:18.60,0:30:20.69,Default,,0,0,0,,Иә, мұны жасаңыз.
Dialogue: 0,0:30:20.77,0:30:21.94,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:30:28.78,0:30:30.49,Default,,0,0,0,,Рахмет
Dialogue: 0,0:30:30.87,0:30:33.58,Default,,0,0,0,,Мүмкін бұл дұрыс емес адам шығар.
Dialogue: 0,0:30:33.66,0:30:34.49,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:30:34.95,0:30:36.87,Default,,0,0,0,,Мен кішкентай кезімде Шато де Ренюрде
Dialogue: 0,0:30:36.96,0:30:39.83,Default,,0,0,0,,Мен жегіш аруақты жеңдім деп ойладым.
Dialogue: 0,0:30:39.92,0:30:41.92,Default,,0,0,0,,Ол әңгіме... кімнен? ‬
Dialogue: 0,0:30:42.34,0:30:44.09,Default,,0,0,0,,Сол кездегі жолдасымның жүзі...
Dialogue: 0,0:30:44.84,0:30:46.30,Default,,0,0,0,,Сіз ұмыттыңыз ба? ‬
Dialogue: 0,0:30:47.09,0:30:49.93,Default,,0,0,0,,Сіз... сіз Бианкасыз ба? ‬
Dialogue: 0,0:30:50.01,0:30:51.72,Default,,0,0,0,,Ақыры есіме түсті.
Dialogue: 0,0:30:52.30,0:30:54.01,Default,,0,0,0,,Лукас Эль-Квел Гранбания! ‬
Dialogue: 0,0:30:54.10,0:30:55.39,Default,,0,0,0,,Бианка! ‬
Dialogue: 0,0:30:55.89,0:30:57.39,Default,,0,0,0,,Бұл шынымен де Бианка! ‬
Dialogue: 0,0:30:57.48,0:31:00.40,Default,,0,0,0,,(Ер адам) Бианка, мен естідім. (Әйел) Бұл сиқыршының аты.
Dialogue: 0,0:31:00.48,0:31:02.40,Default,,0,0,0,,(Ер) Бегирагонды қолдануға болады.
Dialogue: 0,0:31:02.48,0:31:04.32,Default,,0,0,0,,Кеттік, жарай ма? ‬
Dialogue: 0,0:31:09.24,0:31:11.74,Default,,0,0,0,,Бір минут күтіңіз! Күте тұрыңыз! ‬
Dialogue: 0,0:31:12.74,0:31:13.49,Default,,0,0,0,,Не?
Dialogue: 0,0:31:13.58,0:31:16.08,Default,,0,0,0,,Менің ойымша, сіз бірге күресуге ниетіңіз жоқ.
Dialogue: 0,0:31:16.16,0:31:18.04,Default,,0,0,0,,Мен сені жалғыз қалдыра алмаймын.
Dialogue: 0,0:31:18.12,0:31:20.21,Default,,0,0,0,,Одан аулақ болыңыз.
Dialogue: 0,0:31:20.29,0:31:22.33,Default,,0,0,0,,Менің не ұнамайды? ‬
Dialogue: 0,0:31:22.42,0:31:23.75,Default,,0,0,0,,Бұл мағынаны білдірмейді.
Dialogue: 0,0:31:23.84,0:31:26.59,Default,,0,0,0,,Менің артымнан жүр! ‬
Dialogue: 0,0:31:27.55,0:31:29.84,Default,,0,0,0,,Маған қызық, сен оны неге тастап кеттің! ‬
Dialogue: 0,0:31:34.22,0:31:36.31,Default,,0,0,0,,Саған менің не ұнамайды? ‬
Dialogue: 0,0:31:36.39,0:31:38.18,Default,,0,0,0,,Бұл дұрыс емес...
Dialogue: 0,0:31:38.27,0:31:40.44,Default,,0,0,0,,Бұл жерде өте қауіпті.
Dialogue: 0,0:31:42.02,0:31:43.06,Default,,0,0,0,,Не? ‬
Dialogue: 0,0:31:43.69,0:31:45.61,Default,,0,0,0,,Ол маған қыз сияқты қарайды.
Dialogue: 0,0:31:45.69,0:31:46.77,Default,,0,0,0,,Шулы
Dialogue: 0,0:31:47.44,0:31:49.44,Default,,0,0,0,,А, бұл! ‬
Dialogue: 0,0:31:49.53,0:31:50.19,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:31:54.12,0:31:56.20,Default,,0,0,0,,Аспандағы қылыш! ‬
Dialogue: 0,0:31:56.28,0:31:58.12,Default,,0,0,0,,Егер сіз оны қолдансаңыз, сіз жеңілмейтінсіз! ‬
Dialogue: 0,0:31:58.20,0:32:00.75,Default,,0,0,0,,Күте тұрыңыз, бұл қауіпті ме? ‬
Dialogue: 0,0:32:00.83,0:32:03.21,Default,,0,0,0,,Мен сені аспанның батыры деп естідім.
Dialogue: 0,0:32:03.29,0:32:05.25,Default,,0,0,0,,Бірақ келіңіз.
Dialogue: 0,0:32:05.67,0:32:07.92,Default,,0,0,0,,Бірінші жүріс жеңеді, хехе
Dialogue: 0,0:32:10.01,0:32:10.51,Default,,0,0,0,,Фуфу
Dialogue: 0,0:32:10.59,0:32:11.67,Default,,0,0,0,,Уау
Dialogue: 0,0:32:12.43,0:32:15.72,Default,,0,0,0,,(Буон) Оде-саманың ұйқысын не бұзады?
Dialogue: 0,0:32:15.80,0:32:16.97,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:32:17.43,0:32:19.85,Default,,0,0,0,,шықты! Бұл өте үлкен! ‬
Dialogue: 0,0:32:20.27,0:32:21.43,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:32:21.81,0:32:23.85,Default,,0,0,0,,Бұрынғы жігіт емес.
Dialogue: 0,0:32:24.27,0:32:25.69,Default,,0,0,0,,Нагжу
Dialogue: 0,0:32:25.77,0:32:27.23,Default,,0,0,0,,Кяаааааааааа! Апыр-ай! ‬
Dialogue: 0,0:32:30.65,0:32:32.78,Default,,0,0,0,,(жөтел)
Dialogue: 0,0:32:32.86,0:32:35.20,Default,,0,0,0,,Бианка, аспандағы қылышты тап.
Dialogue: 0,0:32:35.28,0:32:36.95,Default,,0,0,0,,Мен Буонның назарын аударамын! ‬
Dialogue: 0,0:32:37.03,0:32:39.37,Default,,0,0,0,,Түсіндім! Мен оны сұрадым! ‬
Dialogue: 0,0:32:40.70,0:32:41.96,Default,,0,0,0,,Бағима! ‬
Dialogue: 0,0:32:42.04,0:32:43.08,Default,,0,0,0,,(Бум) Хамф! ‬
Dialogue: 0,0:32:43.46,0:32:45.25,Default,,0,0,0,,Бұл жұмыс істемейді.
Dialogue: 0,0:32:45.67,0:32:46.88,Default,,0,0,0,,Және аааа! ‬
Dialogue: 0,0:32:46.96,0:32:47.92,Default,,0,0,0,,(Бум) Хмф! Апыр-ай! ‬
Dialogue: 0,0:32:48.00,0:32:49.05,Default,,0,0,0,,(Қабырғаға соғылған дыбыс)
Dialogue: 0,0:32:53.05,0:32:54.05,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:32:54.13,0:32:55.80,Default,,0,0,0,,Бианка Сіз оны таптыңыз ба? ‬
Dialogue: 0,0:32:55.89,0:32:59.26,Default,,0,0,0,,Мен оны қазір іздеп жүрмін! Маған тағы біраз беріңізші! ‬
Dialogue: 0,0:32:59.35,0:33:02.27,Default,,0,0,0,,Өтінемін, асығыңыз!
Dialogue: 0,0:33:03.81,0:33:06.52,Default,,0,0,0,,Кя! Не істеп жатырсың, Лукас?
Dialogue: 0,0:33:06.60,0:33:08.44,Default,,0,0,0,,Сіз оны таба алмайсыз! ‬
Dialogue: 0,0:33:08.52,0:33:11.36,Default,,0,0,0,,Осылай айтсаң да, бұл тек шек! ‬
Dialogue: 0,0:33:11.82,0:33:13.78,Default,,0,0,0,,Блять! ‬
Dialogue: 0,0:33:14.78,0:33:15.78,Default,,0,0,0,,Бағима! ‬
Dialogue: 0,0:33:16.95,0:33:18.37,Default,,0,0,0,,Ооооооо
Dialogue: 0,0:33:21.62,0:33:22.75,Default,,0,0,0,,Міне болды! ‬
Dialogue: 0,0:33:24.79,0:33:26.25,Default,,0,0,0,,(Айлау) (Тізбектердің үзілген дыбысы)
Dialogue: 0,0:33:27.04,0:33:29.21,Default,,0,0,0,,Лукас! Кіреберіске қарай жүріңіз! ‬
Dialogue: 0,0:33:29.29,0:33:30.59,Default,,0,0,0,,Түсіндім! ‬
Dialogue: 0,0:33:30.67,0:33:33.34,Default,,0,0,0,,Ал, Оде-саманың жүзі.
Dialogue: 0,0:33:34.05,0:33:35.26,Default,,0,0,0,,Жеңдер! ‬
Dialogue: 0,0:33:36.93,0:33:39.76,Default,,0,0,0,,Гигигги...
Dialogue: 0,0:33:40.81,0:33:42.85,Default,,0,0,0,,...
Dialogue: 0,0:33:42.93,0:33:43.77,Default,,0,0,0,,Лукас! ‬
Dialogue: 0,0:33:47.15,0:33:47.81,Default,,0,0,0,,(қабылдау дыбысы)
Dialogue: 0,0:33:50.90,0:33:52.48,Default,,0,0,0,,Жарайсыңдар! ‬
Dialogue: 0,0:33:53.15,0:33:54.07,Default,,0,0,0,,Бум! ‬
Dialogue: 0,0:33:54.86,0:33:57.70,Default,,0,0,0,,Мен саған осы аспан қылышын беремін.
Dialogue: 0,0:33:57.78,0:33:59.20,Default,,0,0,0,,Мен саған жанашырлығымды көрсетемін! !
Dialogue: 0,0:33:59.28,0:34:00.45,Default,,0,0,0,,Ммм
Dialogue: 0,0:34:00.53,0:34:02.04,Default,,0,0,0,,Иә! ‬
Dialogue: 0,0:34:02.12,0:34:03.75,Default,,0,0,0,,Мм! ‬
Dialogue: 0,0:34:04.62,0:34:06.75,Default,,0,0,0,,Гуджиджиги! (BGM тонусы төмендейді)
Dialogue: 0,0:34:06.83,0:34:07.62,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:34:08.12,0:34:08.83,Default,,0,0,0,,Бұл солай ма? ‬
Dialogue: 0,0:34:08.92,0:34:10.17,Default,,0,0,0,,Хмф! ‬
Dialogue: 0,0:34:12.17,0:34:12.96,Default,,0,0,0,,Жооооо
Dialogue: 0,0:34:13.55,0:34:14.84,Default,,0,0,0,,Қарғыс атсын! ‬
Dialogue: 0,0:34:15.51,0:34:17.67,Default,,0,0,0,,Хмф! Хамф! ‬
Dialogue: 0,0:34:17.76,0:34:19.09,Default,,0,0,0,,Хмм.
Dialogue: 0,0:34:19.68,0:34:23.77,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:34:24.52,0:34:25.73,Default,,0,0,0,,Қылыш...
Dialogue: 0,0:34:26.43,0:34:27.98,Default,,0,0,0,,Қашып кете алмаймын
Dialogue: 0,0:34:28.06,0:34:29.48,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:34:29.56,0:34:32.15,Default,,0,0,0,,Сен аспанның батыры емессің бе? ‬
Dialogue: 0,0:34:32.23,0:34:34.23,Default,,0,0,0,,Басқаша көрінеді...
Dialogue: 0,0:34:35.03,0:34:35.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:34:35.82,0:34:37.65,Default,,0,0,0,,(Бууунның дауысы) Бухехехе
Dialogue: 0,0:34:37.74,0:34:39.99,Default,,0,0,0,,Қуырылған тұтас
Dialogue: 0,0:34:40.07,0:34:40.99,Default,,0,0,0,,Бұл қауіпті
Dialogue: 0,0:34:42.24,0:34:44.37,Default,,0,0,0,,Аііііі! ‬
Dialogue: 0,0:34:45.62,0:34:49.04,Default,,0,0,0,,(Буонның күркіреуі)
Dialogue: 0,0:34:50.67,0:34:52.21,Default,,0,0,0,,Буон ашулы
Dialogue: 0,0:34:52.29,0:34:54.50,Default,,0,0,0,,(Флора) Бұл Лукас болуы мүмкін бе? ‬
Dialogue: 0,0:34:54.59,0:34:58.63,Default,,0,0,0,,Мен оларды енді кешіре алмаймын.
Dialogue: 0,0:34:58.72,0:35:00.18,Default,,0,0,0,,(Гүрілдеу)
Dialogue: 0,0:35:01.68,0:35:04.14,Default,,0,0,0,,(Бум) Қайда бардың! (Найзағай)
Dialogue: 0,0:35:04.56,0:35:06.60,Default,,0,0,0,,Уау! (Найзағай)
Dialogue: 0,0:35:06.68,0:35:09.23,Default,,0,0,0,,(найзағай)
Dialogue: 0,0:35:09.31,0:35:10.98,Default,,0,0,0,,Мен таптым! ‬
Dialogue: 0,0:35:11.06,0:35:12.19,Default,,0,0,0,,Бегирагон! ‬
Dialogue: 0,0:35:13.56,0:35:16.98,Default,,0,0,0,,Шүкір, бір жерде әлсіздік болуы керек.
Dialogue: 0,0:35:17.07,0:35:18.11,Default,,0,0,0,,Мен мұны түсінемін ...
Dialogue: 0,0:35:22.32,0:35:23.53,Default,,0,0,0,,Көз…
Dialogue: 0,0:35:24.41,0:35:25.58,Default,,0,0,0,,Маңдайдағы көздер
Dialogue: 0,0:35:25.66,0:35:27.41,Default,,0,0,0,,(Үру)
Dialogue: 0,0:35:29.12,0:35:31.00,Default,,0,0,0,,Сіз Буонды жеңе аласыз
Dialogue: 0,0:35:31.46,0:35:32.33,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:35:32.42,0:35:34.63,Default,,0,0,0,,Мына жерде тығыл, Гереге.
Dialogue: 0,0:35:36.75,0:35:38.88,Default,,0,0,0,,Уф! Хе... хе
Dialogue: 0,0:35:39.42,0:35:42.22,Default,,0,0,0,,Жарайды, кезек Сураринге! Өтінемін! ‬
Dialogue: 0,0:35:42.80,0:35:43.64,Default,,0,0,0,,? ‬
Dialogue: 0,0:35:45.30,0:35:48.10,Default,,0,0,0,,Қашудың пайдасы жоқ.
Dialogue: 0,0:35:56.23,0:35:57.69,Default,,0,0,0,,(Бооон) Бухехехехе
Dialogue: 0,0:35:57.78,0:36:00.61,Default,,0,0,0,,Қуыруға дайынсыз ба? ‬
Dialogue: 0,0:36:00.70,0:36:04.12,Default,,0,0,0,,Сіз дайын болуыңыз керек! Бум! ‬
Dialogue: 0,0:36:05.62,0:36:08.08,Default,,0,0,0,,(Бум) Болды... Ал аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа ‬
Dialogue: 0,0:36:08.83,0:36:09.75,Default,,0,0,0,,Бағима! ‬
Dialogue: 0,0:36:14.00,0:36:18.13,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:36:18.21,0:36:21.38,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:36:21.47,0:36:22.88,Default,,0,0,0,,Арх! ‬
Dialogue: 0,0:36:24.72,0:36:28.22,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:36:28.81,0:36:31.77,Default,,0,0,0,,(Үру)
Dialogue: 0,0:36:32.35,0:36:36.81,Default,,0,0,0,,Оданы өлтіресің бе? Бұл Буон-сама
Dialogue: 0,0:36:38.19,0:36:40.11,Default,,0,0,0,,Таңдаңыз, Буон.
Dialogue: 0,0:36:40.19,0:36:43.78,Default,,0,0,0,,Осы жерде өліңіз немесе ант етіңіз! ‬
Dialogue: 0,0:36:48.83,0:36:53.54,Default,,0,0,0,,Фуууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:36:57.46,0:37:00.59,Default,,0,0,0,,...Ода өлгісі келмейді
Dialogue: 0,0:37:01.88,0:37:04.34,Default,,0,0,0,,Иә! ‬
Dialogue: 0,0:37:04.63,0:37:06.18,Default,,0,0,0,,Лука! ‬
Dialogue: 0,0:37:06.26,0:37:09.68,Default,,0,0,0,,Ах ха ха ха ха
Dialogue: 0,0:37:09.76,0:37:12.73,Default,,0,0,0,,(Қала тұрғындары) Рахмет! Көмегіңіз үшін рақмет! ‬
Dialogue: 0,0:37:16.35,0:37:18.98,Default,,0,0,0,,Құрметті аспан батыры...
Dialogue: 0,0:37:19.07,0:37:23.11,Default,,0,0,0,,Бұл туралы айтпауға болады ма? ‬
Dialogue: 0,0:37:23.65,0:37:26.07,Default,,0,0,0,,Бірінші кезекте барлығы тым көп мінеді.
Dialogue: 0,0:37:26.16,0:37:26.91,Default,,0,0,0,,(Қала тұрғыны) Рахмет
Dialogue: 0,0:37:26.99,0:37:29.66,Default,,0,0,0,,Мен үшін не істей аласың? Мен баратын жерім жоқ сияқты сезінемін.
Dialogue: 0,0:37:29.74,0:37:31.99,Default,,0,0,0,,Бірақ, екінші жағынан,
Dialogue: 0,0:37:32.08,0:37:33.96,Default,,0,0,0,,Мен аспанның батыры болмасам да
Dialogue: 0,0:37:34.04,0:37:36.79,Default,,0,0,0,,Сіз бұл Буонды жеңдіңіз, солай ма?
Dialogue: 0,0:37:36.87,0:37:38.83,Default,,0,0,0,,Бұл таңқаларлық емес пе? ‬
Dialogue: 0,0:37:39.21,0:37:40.92,Default,,0,0,0,,(Әйелдер) Лукас! ‬
Dialogue: 0,0:37:41.59,0:37:44.84,Default,,0,0,0,,Жоқ, мұның бәрі Бианканың арқасында.
Dialogue: 0,0:37:45.34,0:37:49.05,Default,,0,0,0,,Бала кезімнен арқамды арқалайтын жалғыз сенсің.
Dialogue: 0,0:37:49.14,0:37:51.35,Default,,0,0,0,,Ренур қамалында және осы жолы да
Dialogue: 0,0:37:51.72,0:37:53.64,Default,,0,0,0,,Эй, сен шыншыл емессің.
Dialogue: 0,0:37:53.72,0:37:56.64,Default,,0,0,0,,Сонда сіз үлес аласыз, солай ма? ‬
Dialogue: 0,0:37:56.73,0:38:00.27,Default,,0,0,0,,Бұл сізге Рудман мырзадан мыңдаған алтын алуға уәде ме? ‬
Dialogue: 0,0:38:00.36,0:38:01.32,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:38:02.65,0:38:04.69,Default,,0,0,0,,…Егер сіз бұл тапсырманы сәтті орындасаңыз
Dialogue: 0,0:38:06.11,0:38:08.86,Default,,0,0,0,,Мен Флораға тұрмысқа шығуым керек.
Dialogue: 0,0:38:09.41,0:38:10.49,Default,,0,0,0,,Флора? ‬
Dialogue: 0,0:38:12.20,0:38:13.54,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:38:14.20,0:38:15.83,Default,,0,0,0,,Рудман тұқымдасының флорасы? ‬
Dialogue: 0,0:38:15.91,0:38:19.08,Default,,0,0,0,,Барлық адамдар таңданатын Флорамен бе? ‬
Dialogue: 0,0:38:19.58,0:38:20.96,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:38:21.04,0:38:23.30,Default,,0,0,0,,Мен осылай уәде бердім.
Dialogue: 0,0:38:23.38,0:38:24.21,Default,,0,0,0,,Эхехе
Dialogue: 0,0:38:24.30,0:38:27.30,Default,,0,0,0,,Мен мүлде күліп тұрған жоқпын.
Dialogue: 0,0:38:29.14,0:38:29.80,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:38:30.47,0:38:32.31,Default,,0,0,0,,Ол
Dialogue: 0,0:38:34.60,0:38:36.73,Default,,0,0,0,,Мен сенен маған дұрыс үйленуіңді сұраймын.
Dialogue: 0,0:38:36.81,0:38:37.44,Default,,0,0,0,,Ол
Dialogue: 0,0:38:37.52,0:38:40.31,Default,,0,0,0,,Қыздарға ата-анасы жақсырақ қызмет көрсетеді
Dialogue: 0,0:38:40.40,0:38:42.61,Default,,0,0,0,,Басқа адамның өтініші бойынша некеге тұру жақсы.
Dialogue: 0,0:38:42.69,0:38:44.36,Default,,0,0,0,,Мен әлдеқайда бақыттымын.
Dialogue: 0,0:38:44.44,0:38:46.82,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:38:46.90,0:38:49.41,Default,,0,0,0,,...Ал сен неге менің артымнан келе жатырсың?
Dialogue: 0,0:38:49.49,0:38:52.83,Default,,0,0,0,,Өзіңіз айта аласыз ба? Бұл мүмкін емес, солай ма?
Dialogue: 0,0:38:52.91,0:38:54.20,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:38:54.95,0:38:58.87,Default,,0,0,0,,Дәл осындай дағдарысты басынан өткерген адам ретінде бұл самурайдың жанашырлығы.
Dialogue: 0,0:38:58.96,0:39:00.96,Default,,0,0,0,,Бұл оны пайдаланудың біртүрлі әдісі ме? ‬
Dialogue: 0,0:39:01.04,0:39:03.38,Default,,0,0,0,,Жоғалып кету.
Dialogue: 0,0:39:03.46,0:39:05.46,Default,,0,0,0,,Кетіңіз
Dialogue: 0,0:39:05.55,0:39:07.51,Default,,0,0,0,,Сіз менің анамсыз ба?
Dialogue: 0,0:39:07.59,0:39:08.22,Default,,0,0,0,,Лукас мырза
Dialogue: 0,0:39:08.80,0:39:09.59,Default,,0,0,0,,Иә! ‬
Dialogue: 0,0:39:12.14,0:39:14.31,Default,,0,0,0,,Квест сәтті өткенін естідім.
Dialogue: 0,0:39:14.39,0:39:15.51,Default,,0,0,0,,Әкем де қатты қуанды.
Dialogue: 0,0:39:16.02,0:39:17.85,Default,,0,0,0,,Ах ха ха эх
Dialogue: 0,0:39:17.93,0:39:18.89,Default,,0,0,0,,… әйтеуір
Dialogue: 0,0:39:19.73,0:39:20.77,Default,,0,0,0,,Сонымен
Dialogue: 0,0:39:21.27,0:39:22.56,Default,,0,0,0,,Бұл...
Dialogue: 0,0:39:24.61,0:39:26.61,Default,,0,0,0,,Не айтайын...
Dialogue: 0,0:39:26.69,0:39:28.44,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:39:30.99,0:39:32.82,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:39:32.91,0:39:33.91,Default,,0,0,0,,‪‬
Dialogue: 0,0:39:33.99,0:39:35.20,Default,,0,0,0,,Бианка? ‬
Dialogue: 0,0:39:35.95,0:39:37.08,Default,,0,0,0,,Не? Сіз
Dialogue: 0,0:39:37.16,0:39:38.12,Default,,0,0,0,,Қиындық! ‬
Dialogue: 0,0:39:38.20,0:39:41.12,Default,,0,0,0,,Мен сенен маған тұрмысқа шығуды сұрай алмаймын.
Dialogue: 0,0:39:41.21,0:39:42.25,Default,,0,0,0,,А, қазірдің өзінде!
Dialogue: 0,0:39:42.33,0:39:45.25,Default,,0,0,0,,Мені тартпа.
Dialogue: 0,0:39:45.88,0:39:47.63,Default,,0,0,0,,Сен ақымақ
Dialogue: 0,0:39:47.71,0:39:49.84,Default,,0,0,0,,Мен Флораға бірдеңе айтқым келеді.
Dialogue: 0,0:39:49.92,0:39:51.76,Default,,0,0,0,,Шулы
Dialogue: 0,0:39:53.43,0:39:54.68,Default,,0,0,0,,Бұл...
Dialogue: 0,0:39:55.81,0:39:57.14,Default,,0,0,0,,Ал...
Dialogue: 0,0:39:58.22,0:39:59.31,Default,,0,0,0,,Мен және...
Dialogue: 0,0:40:00.18,0:40:01.98,Default,,0,0,0,,Маған тұрмысқа шықшы! ‬
Dialogue: 0,0:40:04.06,0:40:05.19,Default,,0,0,0,,Мен бақыттымын! ‬
Dialogue: 0,0:40:05.82,0:40:07.61,Default,,0,0,0,,Бұл рас па? ‬
Dialogue: 0,0:40:08.28,0:40:10.69,Default,,0,0,0,,Күрсін, бұл жақсы болды.
Dialogue: 0,0:40:10.78,0:40:13.82,Default,,0,0,0,,Квест сәтті болса да, ұсыныс жасалмаса
Dialogue: 0,0:40:13.91,0:40:16.03,Default,,0,0,0,,Мен не істеймін деп ойладым.
Dialogue: 0,0:40:17.87,0:40:21.33,Default,,0,0,0,,Бианка сізге батасын береді, солай ма? ‬
Dialogue: 0,0:40:21.41,0:40:23.08,Default,,0,0,0,,Иә, әрине
Dialogue: 0,0:40:23.17,0:40:27.34,Default,,0,0,0,,Бианка маған бұл тапсырмада үлкен көмектесті.
Dialogue: 0,0:40:27.42,0:40:30.84,Default,,0,0,0,,Бірақ мен оған алғысымды білдіргенімде ол қатты шулады.
Dialogue: 0,0:40:30.92,0:40:33.68,Default,,0,0,0,,Ол көптен бері шулы.
Dialogue: 0,0:40:34.22,0:40:37.05,Default,,0,0,0,,Мен шынымен де кез келген нәрсені айта алатындай сезінемін.
Dialogue: 0,0:40:37.14,0:40:37.81,Default,,0,0,0,,Мүлдем...
Dialogue: 0,0:40:39.01,0:40:42.44,Default,,0,0,0,,Жүр, көп же, Муко-доно.
Dialogue: 0,0:40:42.52,0:40:43.35,Default,,0,0,0,,Муко! ‬
Dialogue: 0,0:40:43.44,0:40:45.23,Default,,0,0,0,,Гохо гохо (Флора) Уфуфу
Dialogue: 0,0:40:53.78,0:41:00.41,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:41:01.00,0:41:03.50,Default,,0,0,0,,Неке?
Dialogue: 0,0:41:03.91,0:41:05.50,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:41:05.92,0:41:07.21,Default,,0,0,0,,(Қала тұрғындары) Бианкаға...
Dialogue: 0,0:41:07.29,0:41:09.67,Default,,0,0,0,,(Қала тұрғындары) Сәттілік! Эй балалар
Dialogue: 0,0:41:09.75,0:41:12.51,Default,,0,0,0,,Қанша рет болды? Біраз шулы...
Dialogue: 0,0:41:12.59,0:41:16.09,Default,,0,0,0,,(сөйлеу)
Dialogue: 0,0:41:18.60,0:41:20.72,Default,,0,0,0,,О, Лукас! ‬
Dialogue: 0,0:41:21.27,0:41:22.22,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:41:22.60,0:41:25.23,Default,,0,0,0,,Буонды жеңген аспан батыры...
Dialogue: 0,0:41:25.31,0:41:27.44,Default,,0,0,0,,Тыныш емес, мм.
Dialogue: 0,0:41:27.52,0:41:31.28,Default,,0,0,0,,Жындарды ұстағыш Лука келді! ‬
Dialogue: 0,0:41:31.36,0:41:34.07,Default,,0,0,0,,(Қала тұрғындары) Ооооооооооооооооо
Dialogue: 0,0:41:34.15,0:41:36.32,Default,,0,0,0,,Жүр, ішіп алайық
Dialogue: 0,0:41:36.41,0:41:37.70,Default,,0,0,0,,Мен олай істемеймін.
Dialogue: 0,0:41:37.78,0:41:41.16,Default,,0,0,0,,Үйлену тойының алдындағы сыйлық ретінде жеткілікті
Dialogue: 0,0:41:41.24,0:41:43.79,Default,,0,0,0,,Жоқ, бүгін тым көп нәрсе болып жатыр.
Dialogue: 0,0:41:43.87,0:41:45.00,Default,,0,0,0,,Хмм? ‬
Dialogue: 0,0:41:45.75,0:41:48.38,Default,,0,0,0,,Ендеше бәріміз алдымен бір дем алайық.
Dialogue: 0,0:41:48.46,0:41:51.25,Default,,0,0,0,,Не! Лукас! ‬
Dialogue: 0,0:41:52.34,0:41:56.26,Default,,0,0,0,,Сіз Бьянканың спиртін іше алмаймын дейсіз бе? ‬
Dialogue: 0,0:41:56.34,0:41:58.97,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:41:59.05,0:42:01.18,Default,,0,0,0,,Бианка да модерацияда.
Dialogue: 0,0:42:01.26,0:42:03.22,Default,,0,0,0,,Күте тұрыңыз! ‬
Dialogue: 0,0:42:05.10,0:42:06.77,Default,,0,0,0,,Лука ақымақ
Dialogue: 0,0:42:07.73,0:42:09.15,Default,,0,0,0,,Хар…
Dialogue: 0,0:42:09.23,0:42:10.31,Default,,0,0,0,,Ішейік~
Dialogue: 0,0:42:10.40,0:42:11.98,Default,,0,0,0,,Ол (қаладағы адамдар) Оххх
Dialogue: 0,0:42:12.07,0:42:14.44,Default,,0,0,0,,Сіз көп ішімдікке айналасыз ба?
Dialogue: 0,0:42:15.61,0:42:17.82,Default,,0,0,0,,(есіктің ашылған дыбысы) Иә? ‬
Dialogue: 0,0:42:18.61,0:42:19.82,Default,,0,0,0,,…Ммм.
Dialogue: 0,0:42:19.91,0:42:22.20,Default,,0,0,0,,Сізге бірдеңе керек пе? ‬
Dialogue: 0,0:42:22.28,0:42:23.83,Default,,0,0,0,,Ммммммммммм
Dialogue: 0,0:42:23.91,0:42:26.12,Default,,0,0,0,,Ваааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа ‬
Dialogue: 0,0:42:26.62,0:42:30.63,Default,,0,0,0,,Мына көздер... жақсы көрсетші.
Dialogue: 0,0:42:31.04,0:42:31.75,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:42:32.21,0:42:37.13,Default,,0,0,0,,Сіз... үйлену туралы алаңдайсыз.
Dialogue: 0,0:42:37.22,0:42:41.26,Default,,0,0,0,,ше? Жақында тұрмысқа шығатыныма сенімдімін
Dialogue: 0,0:42:41.35,0:42:43.01,Default,,0,0,0,,Мен уайымдамаймын.
Dialogue: 0,0:42:43.72,0:42:46.56,Default,,0,0,0,,Менің серігім тамаша әйел.
Dialogue: 0,0:42:46.64,0:42:49.31,Default,,0,0,0,,Мен қазір жеткілікті бақыттымын.
Dialogue: 0,0:42:49.40,0:42:52.19,Default,,0,0,0,,Хмм, бұл біртүрлі.
Dialogue: 0,0:42:52.27,0:42:56.24,Default,,0,0,0,,Көздерің бірдеңені іздейді.
Dialogue: 0,0:42:56.32,0:42:59.86,Default,,0,0,0,,Міне, төмен ұстап тұрған көздер.
Dialogue: 0,0:43:00.53,0:43:04.95,Default,,0,0,0,,Енді сен өзіңе сиқыр жасадың ба?
Dialogue: 0,0:43:05.58,0:43:08.00,Default,,0,0,0,,Бұл дұрыс болуы мүмкін емес.
Dialogue: 0,0:43:08.08,0:43:10.42,Default,,0,0,0,,Дайынсың ба? Мен шаршадым.
Dialogue: 0,0:43:10.50,0:43:11.71,Default,,0,0,0,,Олай болса
Dialogue: 0,0:43:13.54,0:43:16.38,Default,,0,0,0,,Сенің шын жүрегіңде
Dialogue: 0,0:43:16.46,0:43:18.84,Default,,0,0,0,,Менімен танысқыңыз келе ме?
Dialogue: 0,0:43:18.92,0:43:19.84,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:43:19.93,0:43:21.05,Default,,0,0,0,,Жарайды
Dialogue: 0,0:43:21.14,0:43:23.51,Default,,0,0,0,,Мен әрқашан шын жүректен әрекет етемін.
Dialogue: 0,0:43:23.60,0:43:25.93,Default,,0,0,0,,Не? Эй, мұны істе! ‬
Dialogue: 0,0:43:26.02,0:43:29.18,Default,,0,0,0,,Егер бұл сенім шынайы болса
Dialogue: 0,0:43:29.27,0:43:32.02,Default,,0,0,0,,Осыны ішіп ал, қаралады
Dialogue: 0,0:43:32.10,0:43:34.98,Default,,0,0,0,,Сіз өзіңіздің шынайы жүрегіңізді кездестіре аласыз
Dialogue: 0,0:43:35.07,0:43:37.44,Default,,0,0,0,,Жұмбақ қасиетті су
Dialogue: 0,0:43:37.53,0:43:42.41,Default,,0,0,0,,Осыны ішсең, терең жерде боласың.
Dialogue: 0,0:43:42.49,0:43:46.70,Default,,0,0,0,,Сіз өз жүрегіңізбен кездесе білуіңіз керек.
Dialogue: 0,0:43:46.79,0:43:47.95,Default,,0,0,0,,Иә иә
Dialogue: 0,0:43:48.04,0:43:50.21,Default,,0,0,0,,Менің ішуге ниетім жоқ.
Dialogue: 0,0:43:50.29,0:43:51.71,Default,,0,0,0,,Қазір кетіңіз.
Dialogue: 0,0:43:51.79,0:43:53.00,Default,,0,0,0,,Күтіңіз, күтіңіз
Dialogue: 0,0:43:53.08,0:43:57.38,Default,,0,0,0,,Сіз оны соншалықты жек көресіз.
Dialogue: 0,0:43:59.63,0:44:02.64,Default,,0,0,0,,Жарайды, мен оны кез келген жағдайда аламын.
Dialogue: 0,0:44:02.72,0:44:04.26,Default,,0,0,0,,Мен ішпеймін
Dialogue: 0,0:44:04.35,0:44:06.81,Default,,0,0,0,,Ішімдік ішпеу деген сөз.
Dialogue: 0,0:44:06.89,0:44:09.06,Default,,0,0,0,,Жоқ, жоқ, мен оны ішемін.
Dialogue: 0,0:44:09.14,0:44:11.73,Default,,0,0,0,,Хи хи хи хи хи
Dialogue: 0,0:44:14.61,0:44:16.57,Default,,0,0,0,,... күлкілі
Dialogue: 0,0:44:30.83,0:44:32.62,Default,,0,0,0,,А, қазірдің өзінде! ‬
Dialogue: 0,0:44:38.00,0:44:40.84,Default,,0,0,0,,Бәрібір ештеңе өзгермейді деп ойлаймын.
Dialogue: 0,0:44:44.05,0:44:44.72,Default,,0,0,0,,Гефу
Dialogue: 0,0:44:46.64,0:44:50.52,Default,,0,0,0,,(көпіршік дыбысы)
Dialogue: 0,0:44:50.60,0:44:52.43,Default,,0,0,0,,‎Флора флорасы
Dialogue: 0,0:44:52.52,0:44:54.19,Default,,0,0,0,,Өсімдік әлемін таңдау
Dialogue: 0,0:44:54.90,0:44:58.57,Default,,0,0,0,,Флора Флораны таңдаңыз
Dialogue: 0,0:44:58.65,0:45:01.61,Default,,0,0,0,,Флора Флораны таңдаңыз
Dialogue: 0,0:45:09.24,0:45:11.75,Default,,0,0,0,,(көпіршікті дыбыс)
Dialogue: 0,0:45:18.29,0:45:18.92,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:45:19.00,0:45:20.00,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:45:22.72,0:45:24.51,Default,,0,0,0,,…Жоқ, жоқ, жоқ.
Dialogue: 0,0:45:25.93,0:45:27.39,Default,,0,0,0,,Бұл ештеңе емес.
Dialogue: 0,0:45:27.93,0:45:30.14,Default,,0,0,0,,Анау кемпір жасанды ғой...
Dialogue: 0,0:45:35.39,0:45:37.65,Default,,0,0,0,,Шынымен! ‬
Dialogue: 0,0:45:37.73,0:45:40.94,Default,,0,0,0,,Міне, мен әлдеқашан біреудің айтқанын естідім.
Dialogue: 0,0:45:41.78,0:45:42.57,Default,,0,0,0,,Иә
Dialogue: 0,0:45:43.65,0:45:45.32,Default,,0,0,0,,Біз кез келген нәрсе туралы айта аламыз.
Dialogue: 0,0:45:46.07,0:45:47.99,Default,,0,0,0,,Мен үшін өте маңызды адам
Dialogue: 0,0:45:49.03,0:45:50.83,Default,,0,0,0,,Иә...
Dialogue: 0,0:45:50.91,0:45:52.29,Default,,0,0,0,,Солай ма? ‬
Dialogue: 0,0:45:53.04,0:45:55.00,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:45:55.08,0:45:56.79,Default,,0,0,0,,болуы мүмкін
Dialogue: 0,0:45:57.50,0:45:59.29,Default,,0,0,0,,Жоқ, бұл жаман, жаман, жаман
Dialogue: 0,0:45:59.38,0:46:00.96,Default,,0,0,0,,Эх! ‬
Dialogue: 0,0:46:05.13,0:46:06.30,Default,,0,0,0,,(демілеу дыбысы)
Dialogue: 0,0:46:06.88,0:46:08.43,Default,,0,0,0,,О, құдайым...
Dialogue: 0,0:46:09.72,0:46:12.56,Default,,0,0,0,,Мен шын жүрегімді түсіндім...
Dialogue: 0,0:46:15.18,0:46:16.27,Default,,0,0,0,,Не! ‬
Dialogue: 0,0:46:16.81,0:46:18.94,Default,,0,0,0,,Мен некені тоқтатқым келеді! ‬
Dialogue: 0,0:46:19.02,0:46:20.19,Default,,0,0,0,,Иә
Dialogue: 0,0:46:20.27,0:46:23.32,Default,,0,0,0,,Енді не туралы айтып тұрсың, мырза?
Dialogue: 0,0:46:23.40,0:46:25.19,Default,,0,0,0,,Мен өзім қатты таң қалдым! ‬
Dialogue: 0,0:46:25.28,0:46:27.82,Default,,0,0,0,,Тынш, айқайлама
Dialogue: 0,0:46:27.91,0:46:30.53,Default,,0,0,0,,Флора сізді еститін шығар.
Dialogue: 0,0:46:30.62,0:46:31.66,Default,,0,0,0,,Флораға
Dialogue: 0,0:46:32.45,0:46:34.58,Default,,0,0,0,,Мен істеген ісіме қатты өкінемін.
Dialogue: 0,0:46:35.00,0:46:37.16,Default,,0,0,0,,О, бұл дегеніміз
Dialogue: 0,0:46:37.25,0:46:39.37,Default,,0,0,0,,Сіз, Флора және Рудман отбасы.
Dialogue: 0,0:46:39.46,0:46:41.17,Default,,0,0,0,,Сіз бұл маңызды емес деп ойлайсыз.
Dialogue: 0,0:46:41.25,0:46:42.88,Default,,0,0,0,,Бұл асыра сілтеу
Dialogue: 0,0:46:43.34,0:46:45.26,Default,,0,0,0,,Ең болмаса Флораға деген сезімім.
Dialogue: 0,0:46:45.34,0:46:46.80,Default,,0,0,0,,Бұл өтірік емес еді
Dialogue: 0,0:46:46.88,0:46:48.38,Default,,0,0,0,,Неліктен? ‬
Dialogue: 0,0:46:49.68,0:46:53.47,Default,,0,0,0,,Маған көбірек көңіл бөлетін адамдар бар екенін түсіндім.
Dialogue: 0,0:46:53.56,0:46:55.39,Default,,0,0,0,,Өзіңізге өтірік айтпаңыз
Dialogue: 0,0:46:55.47,0:46:57.43,Default,,0,0,0,,Гунунуну
Dialogue: 0,0:46:57.52,0:46:59.94,Default,,0,0,0,,Дөрекі жігіт, хмф.
Dialogue: 0,0:47:00.02,0:47:01.94,Default,,0,0,0,,Сізді көру ыңғайсыз.
Dialogue: 0,0:47:02.02,0:47:03.36,Default,,0,0,0,,Бұл қаладан кет! ‬
Dialogue: 0,0:47:05.28,0:47:07.57,Default,,0,0,0,,Мен мұны саған қайтарамын.
Dialogue: 0,0:47:08.65,0:47:10.70,Default,,0,0,0,,Өйткені мен батыр емеспін
Dialogue: 0,0:47:19.08,0:47:20.17,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,0:47:21.29,0:47:22.50,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:47:22.92,0:47:26.09,Default,,0,0,0,,Сіз қазірден бастап кейіпкерді табуды жоспарлап отырсыз.
Dialogue: 0,0:47:27.13,0:47:28.13,Default,,0,0,0,,Иә
Dialogue: 0,0:47:28.22,0:47:31.09,Default,,0,0,0,,Олай болса мынаны өзіңізбен бірге алыңыз.
Dialogue: 0,0:47:31.18,0:47:31.93,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:47:32.51,0:47:36.06,Default,,0,0,0,,Егер сіз оны тапсаңыз, Әулие Берес тауына барыңыз.
Dialogue: 0,0:47:36.64,0:47:38.23,Default,,0,0,0,,Бұл нені білдіреді? ‬
Dialogue: 0,0:47:38.89,0:47:41.23,Default,,0,0,0,,Айдаһар шебері адамға айналады
Dialogue: 0,0:47:41.31,0:47:42.73,Default,,0,0,0,,Ол сонда тұрады.
Dialogue: 0,0:47:42.81,0:47:44.31,Default,,0,0,0,,Маған күш беріңізші
Dialogue: 0,0:47:44.77,0:47:46.40,Default,,0,0,0,,Неліктен мен? ‬
Dialogue: 0,0:47:46.48,0:47:48.57,Default,,0,0,0,,Мына таудың басына қара
Dialogue: 0,0:47:49.07,0:47:52.28,Default,,0,0,0,,Жындар әлемінің күші артып келеді.
Dialogue: 0,0:47:52.36,0:47:55.24,Default,,0,0,0,,Мен де бұл дүние үшін алаңдаймын.
Dialogue: 0,0:47:56.24,0:47:57.83,Default,,0,0,0,,Ха… және
Dialogue: 0,0:47:57.91,0:48:01.42,Default,,0,0,0,,Бұл жолы сіз менің ашуыма тиді деп есептеймін.
Dialogue: 0,0:48:01.50,0:48:02.67,Default,,0,0,0,,Жақсы ма? ‬
Dialogue: 0,0:48:02.75,0:48:04.08,Default,,0,0,0,,Ант етемін.
Dialogue: 0,0:48:04.67,0:48:07.67,Default,,0,0,0,,Жүр, шық, жігіт.
Dialogue: 0,0:48:07.75,0:48:09.59,Default,,0,0,0,,Флораны енді ешқашан көрмеңіз.
Dialogue: 0,0:48:10.51,0:48:11.59,Default,,0,0,0,,Ах~аа
Dialogue: 0,0:48:11.68,0:48:14.18,Default,,0,0,0,,Кедей флора...
Dialogue: 0,0:48:16.60,0:48:18.02,Default,,0,0,0,,Флора…
Dialogue: 0,0:48:19.39,0:48:20.52,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:48:21.35,0:48:22.56,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:48:22.64,0:48:25.44,Default,,0,0,0,,Сен ақымақсың ба? Сен ақымақсың ба? Сен не істеп жатырсың? ‬
Dialogue: 0,0:48:25.52,0:48:26.36,Default,,0,0,0,,Бұл флора
Dialogue: 0,0:48:26.44,0:48:28.03,Default,,0,0,0,,Футтата? Тыныш
Dialogue: 0,0:48:29.15,0:48:30.19,Default,,0,0,0,,Әлемде
Dialogue: 0,0:48:30.28,0:48:33.32,Default,,0,0,0,,Мен мистер Рудманның ашуына тиген болуым керек.
Dialogue: 0,0:48:33.41,0:48:35.49,Default,,0,0,0,,(Ер адам) Әй, бұл қауесет.
Dialogue: 0,0:48:35.57,0:48:37.74,Default,,0,0,0,,(Әйел) Мен оны аяймын.
Dialogue: 0,0:48:37.83,0:48:40.25,Default,,0,0,0,,Бұл дұрыс емес пе? ‬
Dialogue: 0,0:48:40.33,0:48:43.17,Default,,0,0,0,,Сіз бұл туралы ұялып қалдыңыз, сондықтан сіз оқиғаны ойдан шығардыңыз, солай ма? ‬
Dialogue: 0,0:48:43.71,0:48:46.42,Default,,0,0,0,,Егер сіздің айтқаныңыз рас болса
Dialogue: 0,0:48:46.50,0:48:52.47,Default,,0,0,0,,Сіз бұл маңайдағы ең үлкен ақымақсыз.
Dialogue: 0,0:48:52.55,0:48:54.80,Default,,0,0,0,,Мен өзіме көбірек ұнайтын қыз бар екенін енді түсіндім.
Dialogue: 0,0:48:54.89,0:48:56.80,Default,,0,0,0,,Иә? Бұл не? ‬
Dialogue: 0,0:48:57.43,0:48:59.14,Default,,0,0,0,,Сіз кездейсоқ әйелсіз бе?
Dialogue: 0,0:48:59.22,0:49:01.39,Default,,0,0,0,,Сіз үрленбедіңіз, солай ма? ‬
Dialogue: 0,0:49:01.48,0:49:03.27,Default,,0,0,0,,Жалпы айтқанда, Лукас бұрыннан бар...
Dialogue: 0,0:49:03.35,0:49:04.52,Default,,0,0,0,,Міне
Dialogue: 0,0:49:04.60,0:49:08.02,Default,,0,0,0,,Ол әлі де менің ең жақсы досым, арқа сүйейтін адамым.
Dialogue: 0,0:49:08.11,0:49:10.69,Default,,0,0,0,,Сәлем! Қайда бара жатырсың?
Dialogue: 0,0:49:11.11,0:49:12.44,Default,,0,0,0,,Жоғарыдан
Dialogue: 0,0:49:13.53,0:49:15.61,Default,,0,0,0,,Дауысты және дөрекі
Dialogue: 0,0:49:17.99,0:49:20.29,Default,,0,0,0,,Бірақ ол күлгенде өте сүйкімді
Dialogue: 0,0:49:22.50,0:49:23.29,Default,,0,0,0,,Е...
Dialogue: 0,0:49:26.04,0:49:27.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:49:28.50,0:49:30.96,Default,,0,0,0,,‪‬
Dialogue: 0,0:49:32.38,0:49:33.97,Default,,0,0,0,,Күтіңіз, күтіңіз, жоқ.
Dialogue: 0,0:49:34.47,0:49:35.80,Default,,0,0,0,,Өйткені менің ойым осы
Dialogue: 0,0:49:36.43,0:49:38.22,Default,,0,0,0,,Кейін өкінетін боласыз! ‬
Dialogue: 0,0:49:38.30,0:49:39.14,Default,,0,0,0,,Оны аузыңа салма...
Dialogue: 0,0:49:39.22,0:49:40.47,Default,,0,0,0,,Бианка Санто Алькапа! ‬
Dialogue: 0,0:49:40.93,0:49:42.02,Default,,0,0,0,,Иә! ‬
Dialogue: 0,0:49:42.10,0:49:44.89,Default,,0,0,0,,Лукас эль кел Гранбания тілек білдіреді
Dialogue: 0,0:49:45.94,0:49:46.69,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:49:47.56,0:49:49.90,Default,,0,0,0,,Өтінемін, өмірлік серігім бол.
Dialogue: 0,0:49:53.49,0:49:56.32,Default,,0,0,0,,Мен айттым ғой.
Dialogue: 0,0:49:58.07,0:49:59.24,Default,,0,0,0,,Қазірдің өзінде
Dialogue: 0,0:50:00.24,0:50:02.12,Default,,0,0,0,,Себебі мен айттым.
Dialogue: 0,0:50:03.70,0:50:05.83,Default,,0,0,0,,Енді қайтуға болмайды! ‬
Dialogue: 0,0:50:06.83,0:50:09.08,Default,,0,0,0,,Өзін осылай сезіну―
Dialogue: 0,0:50:09.17,0:50:11.09,Default,,0,0,0,,Себебі бұл болды.
Dialogue: 0,0:50:13.51,0:50:20.47,Default,,0,0,0,,(қолдау) (қол шапалақтау)
Dialogue: 0,0:50:35.65,0:50:38.45,Default,,0,0,0,,Әй, сол кезде... (қол шапалақтау)
Dialogue: 0,0:50:40.20,0:50:41.62,Default,,0,0,0,,Әже! ‬
Dialogue: 0,0:50:42.95,0:50:47.12,Default,,0,0,0,,Сіз өзіңіздің шынайы болмысыңызды кездестірген сияқтысыз.
Dialogue: 0,0:50:47.58,0:50:49.58,Default,,0,0,0,,Мұның бәрі сенің арқаң.
Dialogue: 0,0:50:49.67,0:50:51.46,Default,,0,0,0,,Хи хи хи
Dialogue: 0,0:50:51.54,0:50:53.75,Default,,0,0,0,,Әдемі, мейірімді әйел
Dialogue: 0,0:50:53.84,0:50:55.96,Default,,0,0,0,,Рудман мырзаның мүлкі мен мәртебесі
Dialogue: 0,0:50:56.05,0:50:58.22,Default,,0,0,0,,Мұның бәрі бос сөз.
Dialogue: 0,0:50:58.30,0:51:01.76,Default,,0,0,0,,Өзімді-өзім алдау арқылы алғаным осы
Dialogue: 0,0:51:01.85,0:51:03.72,Default,,0,0,0,,Оның құны қандай?
Dialogue: 0,0:51:03.81,0:51:06.43,Default,,0,0,0,,Жаман нәтижеге қол жеткізбеу
Dialogue: 0,0:51:06.52,0:51:10.65,Default,,0,0,0,,Бірақ оның көзіне қарап-ақ білуге болады.
Dialogue: 0,0:51:10.73,0:51:12.98,Default,,0,0,0,,Тіпті өзім де байқамаған едім.
Dialogue: 0,0:51:13.07,0:51:15.32,Default,,0,0,0,,Әйелдің түйсігін төмендетпеңіз.
Dialogue: 0,0:51:15.40,0:51:16.49,Default,,0,0,0,,Жас жігіт
Dialogue: 0,0:51:16.82,0:51:19.40,Default,,0,0,0,,Бұл үшін кешіріңіз.
Dialogue: 0,0:51:19.49,0:51:21.62,Default,,0,0,0,,Керемет кеңес пен жұмбақ қасиетті су
Dialogue: 0,0:51:21.70,0:51:23.12,Default,,0,0,0,,Рахмет
Dialogue: 0,0:51:23.20,0:51:24.20,Default,,0,0,0,,Мм.
Dialogue: 0,0:51:24.28,0:51:25.33,Default,,0,0,0,,-да
Dialogue: 0,0:51:28.91,0:51:33.88,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:51:38.13,0:51:39.13,Default,,0,0,0,,Өйткені
Dialogue: 0,0:51:39.93,0:51:42.55,Default,,0,0,0,,Мұны істеуді тоқтатуым керек пе еді?
Dialogue: 0,0:51:43.47,0:51:46.89,Default,,0,0,0,,Бірақ мен оны байқадым.
Dialogue: 0,0:51:47.72,0:51:49.85,Default,,0,0,0,,Сіздің шынайы сезімдеріңіз
Dialogue: 0,0:51:51.35,0:51:58.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:51:58.49,0:52:00.65,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:00.74,0:52:03.87,Default,,0,0,0,,Рахмет, Милдрас мырза.
Dialogue: 0,0:52:04.62,0:52:06.28,Default,,0,0,0,,Қайсы?
Dialogue: 0,0:52:07.49,0:52:10.12,Default,,0,0,0,,Уаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа (жарылыс дыбысы)
Dialogue: 0,0:52:11.00,0:52:13.21,Default,,0,0,0,,(Үру)
Dialogue: 0,0:52:13.71,0:52:16.50,Default,,0,0,0,,Әлі де күшті емес пе?
Dialogue: 0,0:52:16.59,0:52:18.76,Default,,0,0,0,,Маған не болса да
Dialogue: 0,0:52:19.34,0:52:22.55,Default,,0,0,0,,Міндетті түрде қуат алыңыз және оны көрсетіңіз.
Dialogue: 0,0:52:23.72,0:52:26.10,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:52:26.18,0:52:28.72,Default,,0,0,0,,Сізге пайдалы деп үміттенемін.
Dialogue: 0,0:52:28.81,0:52:30.02,Default,,0,0,0,,Марта
Dialogue: 0,0:52:35.40,0:52:38.36,Default,,0,0,0,,♪～
Dialogue: 0,0:53:05.51,0:53:09.35,Default,,0,0,0,,(нәресте жылады)
Dialogue: 0,0:53:19.82,0:53:21.28,Default,,0,0,0,,Бааа!
Dialogue: 0,0:53:21.36,0:53:23.57,Default,,0,0,0,,Кя кя кя
Dialogue: 0,0:53:23.65,0:53:25.74,Default,,0,0,0,,Бұл менің әкем.
Dialogue: 0,0:53:28.37,0:53:30.66,Default,,0,0,0,,Арсбоханның көзінің түсі
Dialogue: 0,0:53:30.74,0:53:32.95,Default,,0,0,0,,Сіз Лукасқа қатты ұқсайсыз.
Dialogue: 0,0:53:33.04,0:53:33.91,Default,,0,0,0,,№
Dialogue: 0,0:53:34.54,0:53:36.63,Default,,0,0,0,,Нақтырақ
Dialogue: 0,0:53:36.71,0:53:39.13,Default,,0,0,0,,Қандай қызық түс.
Dialogue: 0,0:53:40.25,0:53:42.21,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:53:42.30,0:53:43.84,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:53:44.72,0:53:46.89,Default,,0,0,0,,Соңғы кездері мен де солай сезінемін.
Dialogue: 0,0:53:47.97,0:53:49.30,Default,,0,0,0,,Кейіпкерді тез табыңыз
Dialogue: 0,0:53:49.39,0:53:51.64,Default,,0,0,0,,Мүмкін мен асығып тұрған шығармын.
Dialogue: 0,0:53:52.35,0:53:55.02,Default,,0,0,0,,Мен көп уақыт өткіздім
Dialogue: 0,0:53:55.10,0:53:57.35,Default,,0,0,0,,Мен тағы да саяхаттаймын.
Dialogue: 0,0:53:57.44,0:53:58.77,Default,,0,0,0,,О
Dialogue: 0,0:53:58.86,0:54:01.23,Default,,0,0,0,,Арс үшін де (Арстың күлкісі)
Dialogue: 0,0:54:01.73,0:54:04.74,Default,,0,0,0,,Дүниенің қараңғылыққа батып кетуіне жол бере алмаймыз.
Dialogue: 0,0:54:05.99,0:54:07.16,Default,,0,0,0,,Иә.
Dialogue: 0,0:54:09.41,0:54:10.41,Default,,0,0,0,,Иә? ‬
Dialogue: 0,0:54:11.41,0:54:13.87,Default,,0,0,0,,Мен сені «Ботчан» деп атайтынмын.
Dialogue: 0,0:54:14.62,0:54:16.16,Default,,0,0,0,,Бұл қате болған сияқты.
Dialogue: 0,0:54:16.25,0:54:17.04,Default,,0,0,0,,Жоқ
Dialogue: 0,0:54:19.67,0:54:20.54,Default,,0,0,0,,(Үру)
Dialogue: 0,0:54:23.21,0:54:24.38,Default,,0,0,0,,Зиянкес! ‬
Dialogue: 0,0:54:27.09,0:54:28.34,Default,,0,0,0,,Уау! Кя! ‬
Dialogue: 0,0:54:29.05,0:54:30.97,Default,,0,0,0,,(Джами сері) Эй! Хахахаха
Dialogue: 0,0:54:31.05,0:54:32.22,Default,,0,0,0,,Осы жолмен
Dialogue: 0,0:54:32.31,0:54:34.64,Default,,0,0,0,,(Арс жылайды) Жарайды, жарайды.
Dialogue: 0,0:54:35.68,0:54:37.44,Default,,0,0,0,,(Джами сері) Ах ха ха ха
Dialogue: 0,0:54:37.52,0:54:39.02,Default,,0,0,0,,(Үру)
Dialogue: 0,0:54:39.40,0:54:41.23,Default,,0,0,0,,Төмен! Басын төмен түсір! ‬
Dialogue: 0,0:54:41.98,0:54:43.36,Default,,0,0,0,,(Орктар) Сәлем! ‬
Dialogue: 0,0:54:45.82,0:54:46.78,Default,,0,0,0,,Жоғары! ‬
Dialogue: 0,0:54:48.07,0:54:49.66,Default,,0,0,0,,(Емен) Қараңдар! ‬
Dialogue: 0,0:54:49.74,0:54:51.62,Default,,0,0,0,,Жоғары! Лукас! ‬
Dialogue: 0,0:54:52.33,0:54:53.91,Default,,0,0,0,,Гаруру! ‬
Dialogue: 0,0:54:55.83,0:54:57.41,Default,,0,0,0,,Мен алдымен Алькапаға бардым.
Dialogue: 0,0:54:57.50,0:54:58.54,Default,,0,0,0,,(Арстың жылауы)
Dialogue: 0,0:54:58.62,0:55:00.04,Default,,0,0,0,,Мен Арсты сұраймын! ‬
Dialogue: 0,0:55:00.13,0:55:02.54,Default,,0,0,0,,Түсінікті! ‬
Dialogue: 0,0:55:04.88,0:55:07.34,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:55:07.42,0:55:10.05,Default,,0,0,0,,Мен саған бір ғана аяқ беремін.
Dialogue: 0,0:55:10.14,0:55:12.55,Default,,0,0,0,,Өйткені маған Гема-сама айтты! ‬
Dialogue: 0,0:55:12.64,0:55:14.81,Default,,0,0,0,,Гууууууу
Dialogue: 0,0:55:16.60,0:55:17.81,Default,,0,0,0,,Лукас! ‬
Dialogue: 0,0:55:17.89,0:55:18.81,Default,,0,0,0,,Бианка! ‬
Dialogue: 0,0:55:20.15,0:55:21.44,Default,,0,0,0,,Одан аулақ жүр! ‬
Dialogue: 0,0:55:21.86,0:55:23.90,Default,,0,0,0,,Әйел! Маған кедергі жасама! ‬
Dialogue: 0,0:55:23.98,0:55:25.53,Default,,0,0,0,,Лалихома
Dialogue: 0,0:55:25.61,0:55:27.57,Default,,0,0,0,,Ухехехехе
Dialogue: 0,0:55:33.95,0:55:35.04,Default,,0,0,0,,Бианкааааа! ‬
Dialogue: 0,0:55:35.87,0:55:37.04,Default,,0,0,0,,Мен түсіндім! ‬
Dialogue: 0,0:55:38.79,0:55:40.21,Default,,0,0,0,,Уау! ‬
Dialogue: 0,0:55:41.21,0:55:41.96,Default,,0,0,0,,Иә
Dialogue: 0,0:55:42.46,0:55:43.63,Default,,0,0,0,,Не болды? ‬
Dialogue: 0,0:55:44.79,0:55:46.71,Default,,0,0,0,,Орындалды
Dialogue: 0,0:55:46.80,0:55:48.67,Default,,0,0,0,,Бұл күшті ақымақ
Dialogue: 0,0:55:53.35,0:55:55.93,Default,,0,0,0,,Гррр... Гррр...
Dialogue: 0,0:55:56.81,0:55:59.89,Default,,0,0,0,,Гррр... Гррр...
Dialogue: 0,0:56:01.23,0:56:04.44,Default,,0,0,0,,Хмм.
Dialogue: 0,0:56:06.15,0:56:08.69,Default,,0,0,0,,Мен қиналып жатырмын...
Dialogue: 0,0:56:09.90,0:56:10.45,Default,,0,0,0,,О? ‬
Dialogue: 0,0:56:11.82,0:56:13.24,Default,,0,0,0,,Бұл әйел
Dialogue: 0,0:56:15.37,0:56:19.37,Default,,0,0,0,,Жоқ, хехехе
Dialogue: 0,0:56:19.95,0:56:21.75,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:56:22.42,0:56:23.58,Default,,0,0,0,,Бианка! ‬
Dialogue: 0,0:56:23.67,0:56:24.63,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:56:25.21,0:56:26.38,Default,,0,0,0,,Эйяаааааааааа! ‬
Dialogue: 0,0:56:26.46,0:56:28.55,Default,,0,0,0,,Гвааааааааааааааааааа
Dialogue: 0,0:56:28.63,0:56:30.51,Default,,0,0,0,,Хохохохохо
Dialogue: 0,0:56:31.80,0:56:35.55,Default,,0,0,0,,Сіз мұнда не үшін келдіңіз? ‬
Dialogue: 0,0:56:35.64,0:56:36.93,Default,,0,0,0,,Ууууууу...
Dialogue: 0,0:56:37.01,0:56:38.35,Default,,0,0,0,,Джемма…
Dialogue: 0,0:56:38.64,0:56:40.18,Default,,0,0,0,,бірінші кезекте‎―
Dialogue: 0,0:56:40.27,0:56:44.60,Default,,0,0,0,,Мен сені Мартамен кездесуге апаратын болдым, бірақ...
Dialogue: 0,0:56:45.19,0:56:47.07,Default,,0,0,0,,Хехе, күтпеген жерден
Dialogue: 0,0:56:47.61,0:56:51.03,Default,,0,0,0,,Мен керемет нәрсе алдым.
Dialogue: 0,0:56:51.49,0:56:53.82,Default,,0,0,0,,Сіз не істемексіз? Гема! ‬
Dialogue: 0,0:56:53.91,0:56:58.37,Default,,0,0,0,,Қақпадағы мөрді ашуларыңызды сұраймын.
Dialogue: 0,0:56:58.45,0:57:03.16,Default,,0,0,0,,Өйткені Марта мүлдем оянбайды.
Dialogue: 0,0:57:03.58,0:57:06.25,Default,,0,0,0,,Қақпаны тек Аспан халқы ғана ашуы керек.
Dialogue: 0,0:57:06.67,0:57:08.00,Default,,0,0,0,,Әй
Dialogue: 0,0:57:08.09,0:57:12.13,Default,,0,0,0,,Әлгі жігіт ештеңе түсінбейді.
Dialogue: 0,0:57:12.22,0:57:18.05,Default,,0,0,0,,Ахахха хи хи хи
Dialogue: 0,0:57:18.30,0:57:19.64,Default,,0,0,0,,Қазір
Dialogue: 0,0:57:19.72,0:57:22.56,Default,,0,0,0,,Мен сізге ерекше алғыс айтуым керек.
Dialogue: 0,0:57:23.27,0:57:27.56,Default,,0,0,0,,Ааа, сен маған сондай керемет нәрсе сыйладың.
Dialogue: 0,0:57:27.65,0:57:31.07,Default,,0,0,0,,Арх! Арх! ‬
Dialogue: 0,0:57:31.15,0:57:32.49,Default,,0,0,0,,Тоқта! ‬
Dialogue: 0,0:57:32.57,0:57:33.82,Default,,0,0,0,,Арх! ‬
Dialogue: 0,0:57:33.90,0:57:35.91,Default,,0,0,0,,Гуах
Dialogue: 0,0:57:35.99,0:57:37.87,Default,,0,0,0,,Иә.
Dialogue: 0,0:57:37.95,0:57:41.16,Default,,0,0,0,,Олар мүмкіндігінше ұзақ уақыт ләззат алсын
Dialogue: 0,0:57:43.00,0:57:46.42,Default,,0,0,0,,Жоқ! ‬
Dialogue: 0,0:57:46.50,0:57:49.96,Default,,0,0,0,,Уф! Уф! ‬
Dialogue: 0,0:57:51.00,0:57:52.59,Default,,0,0,0,,Баги... Крест! ‬
Dialogue: 0,0:57:55.43,0:57:59.72,Default,,0,0,0,,Гуаааааааааааааа! ‬
Dialogue: 0,0:57:59.80,0:58:02.97,Default,,0,0,0,,Хехехехе
Dialogue: 0,0:58:03.60,0:58:06.06,Default,,0,0,0,,Ах~~~
Dialogue: 0,0:58:06.64,0:58:09.86,Default,,0,0,0,,Ах~~~
Dialogue: 0,0:58:09.94,0:58:12.86,Default,,0,0,0,,Хе хе хе хе хе
Dialogue: 0,0:58:13.74,0:58:15.20,Default,,0,0,0,,Әдемі...
Dialogue: 0,0:58:16.53,0:58:19.12,Default,,0,0,0,,Өте жақсы жүз
Dialogue: 0,0:58:19.20,0:58:21.08,Default,,0,0,0,,Сол жерден қараңыз
Dialogue: 0,0:58:22.62,0:58:27.29,Default,,0,0,0,,Дүниенің қараңғылыққа батып бара жатқанын көру
Dialogue: 0,0:58:27.37,0:58:29.17,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:58:29.25,0:58:31.21,Default,,0,0,0,,Ахахахахаха (қанаттардың дыбысы)
Dialogue: 0,0:58:31.29,0:58:33.46,Default,,0,0,0,,Ах ха ха ха ха
Dialogue: 0,0:58:33.55,0:58:37.13,Default,,0,0,0,,Ах ха ха ха ха ха! ‬
Dialogue: 0,0:58:56.07,0:58:58.07,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:58:59.20,0:59:03.24,Default,,0,0,0,,Аспан адамдарының қаны бар басқа адамдар бар екенін білмедім.
Dialogue: 0,0:59:03.70,0:59:06.66,Default,,0,0,0,,Мартаның ұлымен
Dialogue: 0,0:59:06.75,0:59:08.79,Default,,0,0,0,,Сіз үйленгенсіз бе?
Dialogue: 0,0:59:08.87,0:59:11.42,Default,,0,0,0,,Охохохохохохо
Dialogue: 0,0:59:11.50,0:59:14.38,Default,,0,0,0,,Мен? ақымақ
Dialogue: 0,0:59:15.05,0:59:17.72,Default,,0,0,0,,Аспанда осындай көзі бар адам бар ма? ‬
Dialogue: 0,0:59:17.80,0:59:19.97,Default,,0,0,0,,Хохохохо
Dialogue: 0,0:59:20.05,0:59:22.14,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:59:22.22,0:59:24.89,Default,,0,0,0,,Бетіңізге мұқият қараңыз
Dialogue: 0,0:59:26.72,0:59:27.93,Default,,0,0,0,,Сіз бе?
Dialogue: 0,0:59:28.64,0:59:31.56,Default,,0,0,0,,Ол табылған бала.
Dialogue: 0,0:59:32.27,0:59:35.19,Default,,0,0,0,,(Аңқылдаған дыбыс) Фуфуфуфуфу
Dialogue: 0,0:59:35.28,0:59:39.07,Default,,0,0,0,,Сізді жасыратын нағыз ата-ана
Dialogue: 0,0:59:39.15,0:59:42.62,Default,,0,0,0,,Көзінің түсін өзгерту үшін сиқырлаған сияқты.
Dialogue: 0,0:59:43.28,0:59:44.66,Default,,0,0,0,,Енді осында кел
Dialogue: 0,0:59:44.74,0:59:45.99,Default,,0,0,0,,Жібер! ‬
Dialogue: 0,0:59:52.50,0:59:54.04,Default,,0,0,0,,Бұл...
Dialogue: 0,0:59:54.13,0:59:55.34,Default,,0,0,0,,Бұл Марта.
Dialogue: 0,0:59:56.92,0:59:58.38,Default,,0,0,0,,Маған қарсы
Dialogue: 0,0:59:58.46,1:00:00.93,Default,,0,0,0,,Мен қоршауда қалдым.
Dialogue: 0,1:00:01.01,1:00:02.47,Default,,0,0,0,,Міне...
Dialogue: 0,1:00:03.34,1:00:05.85,Default,,0,0,0,,Аңыз бойынша аспан адамдары
Dialogue: 0,1:00:06.39,1:00:08.98,Default,,0,0,0,,Ақылмен сөйлесуге болатын сияқты.
Dialogue: 0,1:00:10.73,1:00:14.98,Default,,0,0,0,,Өтінемін, оны ашатын сиқырды тыңдаңыз.
Dialogue: 0,1:00:15.69,1:00:18.74,Default,,0,0,0,,Мен оны ашуыңызды қалаймын.
Dialogue: 0,1:00:19.86,1:00:23.07,Default,,0,0,0,,Бұл... жындар әлеміне кіретін есік.
Dialogue: 0,1:00:24.07,1:00:28.75,Default,,0,0,0,,Әрине, тілегімді орындасаң.
Dialogue: 0,1:00:28.83,1:00:32.75,Default,,0,0,0,,Мен сені босатуға рұқсат етемін
Dialogue: 0,1:00:37.17,1:00:40.42,Default,,0,0,0,,Марта-сан Марта-сан
Dialogue: 0,1:00:41.67,1:00:44.34,Default,,0,0,0,,Мені кім шақырып жатыр? ‬
Dialogue: 0,1:00:44.43,1:00:46.51,Default,,0,0,0,,Менің атым Бианка.
Dialogue: 0,1:00:47.31,1:00:48.72,Default,,0,0,0,,Ол Луканың әйелі.
Dialogue: 0,1:00:49.27,1:00:52.27,Default,,0,0,0,,Иә, Лукас сенімен бірге.
Dialogue: 0,1:00:52.94,1:00:55.52,Default,,0,0,0,,Бианка Не болса да
Dialogue: 0,1:00:55.61,1:00:58.23,Default,,0,0,0,,Геманың айтқанын тыңдама.
Dialogue: 0,1:00:59.15,1:01:02.07,Default,,0,0,0,,Гема тұрақты түрде күш алып келеді, бірақ
Dialogue: 0,1:01:02.45,1:01:05.82,Default,,0,0,0,,Егер Аспаншы сиқырламаса
Dialogue: 0,1:01:05.91,1:01:08.58,Default,,0,0,0,,Жындар әлемінің қақпасы ашылмайды.
Dialogue: 0,1:01:10.50,1:01:13.46,Default,,0,0,0,,Өтінемін, аман болыңыз.
Dialogue: 0,1:01:14.67,1:01:17.71,Default,,0,0,0,,Ештеңе істей алмағаным үшін кешіріңіз.
Dialogue: 0,1:01:22.92,1:01:25.76,Default,,0,0,0,,Марта! Марта! ‬
Dialogue: 0,1:01:26.18,1:01:31.47,Default,,0,0,0,,Жүр, маған Аспаншының күшін көрсет.
Dialogue: 0,1:01:33.31,1:01:34.81,Default,,0,0,0,,Мелазома! ‬
Dialogue: 0,1:01:37.65,1:01:41.48,Default,,0,0,0,,Сіз мені тастап кетпеуіңіз керек, Лукас ханым.
Dialogue: 0,1:01:42.11,1:01:44.78,Default,,0,0,0,,Басқаша айтқанда, менің артымнан еруге ниетіңіз жоқ...
Dialogue: 0,1:01:44.86,1:01:45.86,Default,,0,0,0,,Әрине! ‬
Dialogue: 0,1:01:45.95,1:01:48.62,Default,,0,0,0,,Бұл мәселе.
Dialogue: 0,1:01:48.70,1:01:50.12,Default,,0,0,0,,Бегирагон! ‬
Dialogue: 0,1:01:50.20,1:01:52.41,Default,,0,0,0,,Мудамуда Меразома! ‬
Dialogue: 0,1:01:52.50,1:01:53.00,Default,,0,0,0,,Ах! ‬
Dialogue: 0,1:01:53.08,1:01:54.25,Default,,0,0,0,,Мелазома! Мелазома! ‬
Dialogue: 0,1:01:54.33,1:01:55.46,Default,,0,0,0,,Жоқ! ‬
Dialogue: 0,1:01:55.54,1:01:57.46,Default,,0,0,0,,Қандай ысырап! ‬
Dialogue: 0,1:01:59.25,1:02:03.42,Default,,0,0,0,,Күй тым басқа. бас тарт.
Dialogue: 0,1:02:04.34,1:02:05.72,Default,,0,0,0,,Гема! ‬
Dialogue: 0,1:02:06.51,1:02:07.59,Default,,0,0,0,,Келіңіздер
Dialogue: 0,1:02:08.30,1:02:09.18,Default,,0,0,0,,Қол ұшын созайық
Dialogue: 0,1:02:09.26,1:02:11.14,Default,,0,0,0,,Уф... (сүйектің сықырлаған дыбысы)
Dialogue: 0,1:02:11.93,1:02:12.47,Default,,0,0,0,,Не...
Dialogue: 0,1:02:12.56,1:02:14.02,Default,,0,0,0,,Хмф! Уф...
Dialogue: 0,1:02:24.36,1:02:27.53,Default,,0,0,0,,Бұл қызықсыз спектакль.
Dialogue: 0,1:02:41.17,1:02:44.88,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:02:47.68,1:02:49.84,Default,,0,0,0,,(нәресте дауысы)
Dialogue: 0,1:02:50.64,1:02:56.98,Default,,0,0,0,,(Химера жылауы)
Dialogue: 0,1:02:57.06,1:03:01.48,Default,,0,0,0,,(Гиганттың қадамдары) (Айқай)
Dialogue: 0,1:03:04.86,1:03:08.53,Default,,0,0,0,,(Химера жылауы)
Dialogue: 0,1:03:17.37,1:03:18.83,Default,,0,0,0,,(Бала) Ақырын...
Dialogue: 0,1:03:18.92,1:03:23.21,Default,,0,0,0,,(Бала) Ақырын (шығыр дыбысы)
Dialogue: 0,1:03:23.29,1:03:24.84,Default,,0,0,0,,(шығыр дыбысы)
Dialogue: 0,1:03:28.84,1:03:30.38,Default,,0,0,0,,Соңында бұл...
Dialogue: 0,1:03:30.47,1:03:32.39,Default,,0,0,0,,(Үру)
Dialogue: 0,1:03:32.47,1:03:34.68,Default,,0,0,0,,(Бала) Уау, бұл жаман. Асықшы! ‬
Dialogue: 0,1:03:37.10,1:03:40.48,Default,,0,0,0,,(Бала) Уау! Апыр-ай!
Dialogue: 0,1:03:40.56,1:03:42.98,Default,,0,0,0,,(шығыр дыбысы)
Dialogue: 0,1:03:43.06,1:03:44.36,Default,,0,0,0,,(Үру)
Dialogue: 0,1:03:44.44,1:03:46.69,Default,,0,0,0,,(Ер) Уау, уау, уау!
Dialogue: 0,1:03:46.78,1:03:48.40,Default,,0,0,0,,(Гүрілдеу) (Бала) Тезірек! ‬
Dialogue: 0,1:03:50.24,1:03:51.20,Default,,0,0,0,,(Бала) Лула! ‬
Dialogue: 0,1:03:53.53,1:03:54.70,Default,,0,0,0,,Лула! ‬
Dialogue: 0,1:04:03.29,1:04:04.50,Default,,0,0,0,,(қону дыбысы) (химера айқайы)
Dialogue: 0,1:04:04.59,1:04:05.29,Default,,0,0,0,,(Бала) Уау! ‬
Dialogue: 0,1:04:08.71,1:04:10.30,Default,,0,0,0,,Иә! ‬
Dialogue: 0,1:04:10.38,1:04:16.97,Default,,0,0,0,,(Таяқтан резонанс)
Dialogue: 0,1:04:18.98,1:04:19.93,Default,,0,0,0,,Уф...
Dialogue: 0,1:04:20.02,1:04:21.81,Default,,0,0,0,,(Бала) Ооо! Алақай! ‬
Dialogue: 0,1:04:21.89,1:04:23.56,Default,,0,0,0,,Соңында орындадым! ‬
Dialogue: 0,1:04:23.65,1:04:24.94,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:04:25.02,1:04:28.78,Default,,0,0,0,,Мен сенің кім екеніңді білмеймін, бірақ рахмет.
Dialogue: 0,1:04:28.86,1:04:30.95,Default,,0,0,0,,Сіз не туралы айтып отырсыз? мен...
Dialogue: 0,1:04:31.03,1:04:31.78,Default,,0,0,0,,(Бала) Ах! (айқай)
Dialogue: 0,1:04:32.36,1:04:33.82,Default,,0,0,0,,Дааааа! ‬
Dialogue: 0,1:04:33.91,1:04:37.12,Default,,0,0,0,,Сонымен! О құдайым-ай! ‬
Dialogue: 0,1:04:37.20,1:04:39.08,Default,,0,0,0,,(Ауаны жарып өткен қылыштың дыбысы) (Бала) Хехехехе
Dialogue: 0,1:04:41.04,1:04:42.75,Default,,0,0,0,,Сол ұзын қылыш...
Dialogue: 0,1:04:43.33,1:04:45.46,Default,,0,0,0,,Жоқ, сен...
Dialogue: 0,1:04:45.54,1:04:47.04,Default,,0,0,0,,Сіз түсіндіңіз бе?
Dialogue: 0,1:04:47.46,1:04:50.59,Default,,0,0,0,,Иә, мен сенің ұлыңмын Арс.
Dialogue: 0,1:04:51.26,1:04:54.72,Default,,0,0,0,,Өйткені сіз оны білмей тұрып! ‬
Dialogue: 0,1:04:54.80,1:04:55.93,Default,,0,0,0,,А, артта! ‬
Dialogue: 0,1:04:56.01,1:04:56.97,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:04:57.05,1:04:58.43,Default,,0,0,0,,Уау
Dialogue: 0,1:04:58.56,1:05:00.81,Default,,0,0,0,,(Гүрілдеу)
Dialogue: 0,1:05:00.89,1:05:02.52,Default,,0,0,0,,Уау
Dialogue: 0,1:05:04.06,1:05:05.69,Default,,0,0,0,,Ars Мынаны пайдаланыңыз! ‬
Dialogue: 0,1:05:05.77,1:05:07.40,Default,,0,0,0,,(Қыңырлап) Рахмет, әке! ‬
Dialogue: 0,1:05:07.48,1:05:09.61,Default,,0,0,0,,Ах! Бұл қылыш жаман...
Dialogue: 0,1:05:10.36,1:05:11.36,Default,,0,0,0,,Ars Бұл мүмкін емес! ‬
Dialogue: 0,1:05:11.44,1:05:12.78,Default,,0,0,0,,Бұл аспан! ‬
Dialogue: 0,1:05:17.99,1:05:24.96,Default,,0,0,0,,♪～
Dialogue: 0,1:05:32.13,1:05:33.26,Default,,0,0,0,,Дааааааа! ‬
Dialogue: 0,1:05:34.68,1:05:36.18,Default,,0,0,0,,О, Құдайым! ‬
Dialogue: 0,1:05:36.26,1:05:38.01,Default,,0,0,0,,(айқай)
Dialogue: 0,1:05:52.61,1:05:56.36,Default,,0,0,0,,(Үру)
Dialogue: 0,1:05:57.53,1:05:59.08,Default,,0,0,0,,Уау...
Dialogue: 0,1:05:59.16,1:05:59.91,Default,,0,0,0,,Бұл не! ‬
Dialogue: 0,1:06:00.33,1:06:01.99,Default,,0,0,0,,Әке, бұл не?
Dialogue: 0,1:06:02.08,1:06:03.66,Default,,0,0,0,,Бұл ғажайып қылыш не? ‬
Dialogue: 0,1:06:04.96,1:06:07.00,Default,,0,0,0,,Аспан семсері...
Dialogue: 0,1:06:09.38,1:06:10.67,Default,,0,0,0,,Мұнда...
Dialogue: 0,1:06:11.80,1:06:13.38,Default,,0,0,0,,Мен осында болдым
Dialogue: 0,1:06:13.46,1:06:14.88,Default,,0,0,0,,Аспан батыры...
Dialogue: 0,1:06:16.34,1:06:18.43,Default,,0,0,0,,Сіз болдыңыз ба?
Dialogue: 0,1:06:19.01,1:06:21.81,Default,,0,0,0,,Лука-сама! ‬
Dialogue: 0,1:06:21.89,1:06:23.56,Default,,0,0,0,,Санчо! ‬
Dialogue: 0,1:06:24.14,1:06:25.98,Default,,0,0,0,,Арс бала! ‬
Dialogue: 0,1:06:27.69,1:06:30.02,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:06:30.11,1:06:32.07,Default,,0,0,0,,Екеуің де амансыңдар деп үміттенемін.
Dialogue: 0,1:06:32.44,1:06:33.78,Default,,0,0,0,,Бұл Санчо
Dialogue: 0,1:06:34.19,1:06:37.49,Default,,0,0,0,,Мен бүгінгідей бақытты болған емеспін.
Dialogue: 0,1:06:37.57,1:06:39.82,Default,,0,0,0,,(жылау)
Dialogue: 0,1:06:39.91,1:06:43.29,Default,,0,0,0,,Вау уан ван ван
Dialogue: 0,1:06:43.37,1:06:45.62,Default,,0,0,0,,Жылама, Санчо (жылап)
Dialogue: 0,1:06:45.71,1:06:47.75,Default,,0,0,0,,Сіз одан үлкен көрінесіз. Апыр-ай.
Dialogue: 0,1:06:47.83,1:06:52.34,Default,,0,0,0,,Себебі Лукас-саманың тасқа айналғанына сегіз жыл болды.
Dialogue: 0,1:06:52.42,1:06:54.76,Default,,0,0,0,,8 жыл! Уау аа
Dialogue: 0,1:06:54.84,1:06:56.26,Default,,0,0,0,,Сегіз жыл болды ма? ‬
Dialogue: 0,1:06:56.34,1:07:03.26,Default,,0,0,0,,(жылау)
Dialogue: 0,1:07:21.78,1:07:23.58,Default,,0,0,0,,Ол айтарлықтай өсті.
Dialogue: 0,1:07:23.99,1:07:25.41,Default,,0,0,0,,Маған да көрсет
Dialogue: 0,1:07:27.12,1:07:29.92,Default,,0,0,0,,Уау, бұл үлкен сан! ‬
Dialogue: 0,1:07:30.00,1:07:31.25,Default,,0,0,0,,Бір жерде
Dialogue: 0,1:07:31.92,1:07:35.00,Default,,0,0,0,,Сонымен, сізде Марта әже және сіздің анаңыз бар.
Dialogue: 0,1:07:35.09,1:07:35.92,Default,,0,0,0,,О
Dialogue: 0,1:07:36.30,1:07:39.68,Default,,0,0,0,,Бірақ ғибадатханаға жету өте қиын.
Dialogue: 0,1:07:41.30,1:07:43.47,Default,,0,0,0,,Мен Айдаһар шеберімен кездесе аламын деп үміттенемін.
Dialogue: 0,1:07:46.14,1:07:47.98,Default,,0,0,0,,‪‬
Dialogue: 0,1:07:48.06,1:07:50.77,Default,,0,0,0,,Иә, иә, мен қазір кетемін.
Dialogue: 0,1:07:51.77,1:07:53.61,Default,,0,0,0,,Сіз шыдамсызсыз~
Dialogue: 0,1:07:55.82,1:07:57.57,Default,,0,0,0,,Ум... аа!
Dialogue: 0,1:07:57.65,1:07:58.99,Default,,0,0,0,,Сіз! ‬
Dialogue: 0,1:07:59.40,1:08:01.70,Default,,0,0,0,,О, есімде! ‬
Dialogue: 0,1:08:02.74,1:08:04.28,Default,,0,0,0,,Сасық жігіт! ‬
Dialogue: 0,1:08:04.37,1:08:05.33,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:05.91,1:08:08.62,Default,,0,0,0,,Мен адамдарға көмектесуім керек деп ойлаймын.
Dialogue: 0,1:08:08.70,1:08:10.41,Default,,0,0,0,,Мен бұл сен болады деп күтпедім.
Dialogue: 0,1:08:10.87,1:08:13.46,Default,,0,0,0,,Мен оны аспан батырымен келеді деп күтпедім.
Dialogue: 0,1:08:13.54,1:08:14.96,Default,,0,0,0,,Мистер Пуссин
Dialogue: 0,1:08:15.04,1:08:17.96,Default,,0,0,0,,Менің анам мен әйелім Геманың тұтқынында.
Dialogue: 0,1:08:18.05,1:08:18.76,Default,,0,0,0,,Сондықтан
Dialogue: 0,1:08:18.84,1:08:21.18,Default,,0,0,0,,Менің мақсатым мен сенікі бір.
Dialogue: 0,1:08:22.05,1:08:25.81,Default,,0,0,0,,Дүниені зұлмат ғасырлардан сақта...
Dialogue: 0,1:08:26.31,1:08:28.64,Default,,0,0,0,,Демек, бұл қалада айдаһар шебері бар.
Dialogue: 0,1:08:28.72,1:08:31.35,Default,,0,0,0,,Олар адам кейпінде өмір сүреді деп естідім. Сіз білмейсіз бе? ‬
Dialogue: 0,1:08:31.43,1:08:33.35,Default,,0,0,0,,Нгг
Dialogue: 0,1:08:33.44,1:08:34.73,Default,,0,0,0,,Гехогехохо
Dialogue: 0,1:08:35.40,1:08:36.36,Default,,0,0,0,,Гехо
Dialogue: 0,1:08:36.77,1:08:38.02,Default,,0,0,0,,Ммм
Dialogue: 0,1:08:38.90,1:08:40.86,Default,,0,0,0,,Сіз менің не айтып тұрғанымды білесіз, солай ма? ‬
Dialogue: 0,1:08:41.53,1:08:42.28,Default,,0,0,0,,ше? ‬
Dialogue: 0,1:08:42.86,1:08:43.74,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:08:45.95,1:08:47.28,Default,,0,0,0,,Иә!
Dialogue: 0,1:08:47.37,1:08:48.99,Default,,0,0,0,,Ача
Dialogue: 0,1:08:49.08,1:08:51.21,Default,,0,0,0,,Гехогехогехо
Dialogue: 0,1:08:52.12,1:08:56.13,Default,,0,0,0,,Мен Пусан мырзаны айдаһардың шебері деп ешқашан ойламаппын.
Dialogue: 0,1:08:56.21,1:08:58.38,Default,,0,0,0,,Эй, иә...
Dialogue: 0,1:08:58.46,1:09:00.51,Default,,0,0,0,,Жоқ, сондықтан мен ынтымақтасқым келеді...
Dialogue: 0,1:09:00.59,1:09:01.76,Default,,0,0,0,,Қалай болғанда да! ‬
Dialogue: 0,1:09:01.84,1:09:04.05,Default,,0,0,0,,Бірақ бұл мүмкін емес, иә? ‬
Dialogue: 0,1:09:04.72,1:09:06.47,Default,,0,0,0,,өтіңіз…
Dialogue: 0,1:09:06.55,1:09:08.51,Default,,0,0,0,,…Айдаһар шары
Dialogue: 0,1:09:08.60,1:09:10.27,Default,,0,0,0,,Мен оны жоғалтып алдым, иә? ‬
Dialogue: 0,1:09:10.35,1:09:12.14,Default,,0,0,0,,Онсыз мен айдаһарға қайта орала алмаймын.
Dialogue: 0,1:09:12.23,1:09:14.48,Default,,0,0,0,,Иә? Бұл рас па? ‬
Dialogue: 0,1:09:14.85,1:09:18.36,Default,,0,0,0,,Неліктен мен маңызды нәрсені жоғалтып аламын?
Dialogue: 0,1:09:18.44,1:09:19.69,Default,,0,0,0,,Нақты қай жерде? ‬
Dialogue: 0,1:09:20.11,1:09:23.78,Default,,0,0,0,,Мен мұны ешқашан ұмытпаймын, Castle Renure.
Dialogue: 0,1:09:23.86,1:09:26.49,Default,,0,0,0,,Мұнда? Алькапа маңында...
Dialogue: 0,1:09:26.91,1:09:29.66,Default,,0,0,0,,А, мүмкін солай ма?
Dialogue: 0,1:09:30.24,1:09:32.04,Default,,0,0,0,,Бұл? Бұл...
Dialogue: 0,1:09:32.54,1:09:34.67,Default,,0,0,0,,Айдаһар шарының бір бөлігі емес пе?
Dialogue: 0,1:09:34.75,1:09:37.88,Default,,0,0,0,,Мен оны бала кезімде Шато де Ренюрде алдым.
Dialogue: 0,1:09:37.96,1:09:40.71,Default,,0,0,0,,Бірақ оны Гамема қиратты...
Dialogue: 0,1:09:40.80,1:09:42.17,Default,,0,0,0,,Жоқ, күте тұрыңыз...
Dialogue: 0,1:09:42.97,1:09:44.22,Default,,0,0,0,,Бұл жалған.
Dialogue: 0,1:09:44.30,1:09:45.47,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:09:45.55,1:09:47.51,Default,,0,0,0,,Бұл нені білдіреді? ‬
Dialogue: 0,1:09:47.60,1:09:49.39,Default,,0,0,0,,Ммм
Dialogue: 0,1:09:50.47,1:09:51.52,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:52.39,1:09:54.31,Default,,0,0,0,,тығырыққа тірелді...
Dialogue: 0,1:09:55.81,1:09:56.73,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:09:57.23,1:09:58.86,Default,,0,0,0,,Мен періден сұрауым керек пе?
Dialogue: 0,1:09:59.44,1:10:00.48,Default,,0,0,0,,Ертегі? ‬
Dialogue: 0,1:10:00.57,1:10:01.23,Default,,0,0,0,,О
Dialogue: 0,1:10:01.32,1:10:04.03,Default,,0,0,0,,Ол Чисотто тауларындағы терең үңгірде тұрады.
Dialogue: 0,1:10:04.11,1:10:06.32,Default,,0,0,0,,Кез келген тілек орындалады дейді.
Dialogue: 0,1:10:06.41,1:10:08.70,Default,,0,0,0,,Алайда кездесу оңай емес
Dialogue: 0,1:10:09.20,1:10:11.45,Default,,0,0,0,,Роботтар перілерді қорғайды.
Dialogue: 0,1:10:11.54,1:10:12.66,Default,,0,0,0,,Робот? ‬
Dialogue: 0,1:10:12.75,1:10:15.25,Default,,0,0,0,,Сізге сәйкес келмейтін нәрсе бар ма? ‬
Dialogue: 0,1:10:15.33,1:10:16.21,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,1:10:16.29,1:10:18.75,Default,,0,0,0,,Бұл шешімде солай болады.
Dialogue: 0,1:10:19.34,1:10:20.59,Default,,0,0,0,,Бұл жолы? ‬
Dialogue: 0,1:10:20.67,1:10:23.46,Default,,0,0,0,,Содан не керек, бұл ыңғайсыздық
Dialogue: 0,1:10:24.17,1:10:28.55,Default,,0,0,0,,Сынақтарды өз күшімен жеңген перілер ғана.
Dialogue: 0,1:10:29.09,1:10:31.01,Default,,0,0,0,,Бағаланбаған
Dialogue: 0,1:10:35.98,1:10:36.85,Default,,0,0,0,,Уау!
Dialogue: 0,1:10:37.39,1:10:38.60,Default,,0,0,0,,Слурин
Dialogue: 0,1:10:39.06,1:10:41.73,Default,,0,0,0,,Сіз менің артымнан жүрдіңіз бе?
Dialogue: 0,1:10:43.11,1:10:44.11,Default,,0,0,0,,Уау! ‬
Dialogue: 0,1:10:47.53,1:10:49.74,Default,,0,0,0,,Уау, өте жақсы...
Dialogue: 0,1:10:52.91,1:10:53.54,Default,,0,0,0,,Уау
Dialogue: 0,1:11:00.63,1:11:02.29,Default,,0,0,0,,Ол шықты.
Dialogue: 0,1:11:03.13,1:11:04.00,Default,,0,0,0,,Гех
Dialogue: 0,1:11:19.94,1:11:20.81,Default,,0,0,0,,күрсіну
Dialogue: 0,1:11:23.32,1:11:25.65,Default,,0,0,0,,Шынымды айтсам, сіз бара алмайсыз! ‬
Dialogue: 0,1:11:26.11,1:11:27.82,Default,,0,0,0,,Жол болуы керек
Dialogue: 0,1:11:27.90,1:11:29.53,Default,,0,0,0,,Ойлан, ойла! ‬
Dialogue: 0,1:11:31.03,1:11:32.37,Default,,0,0,0,,Слурин
Dialogue: 0,1:11:32.74,1:11:34.45,Default,,0,0,0,,Сенің осында болғаныңа қуаныштымын
Dialogue: 0,1:11:34.54,1:11:35.08,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:11:41.29,1:11:43.88,Default,,0,0,0,,Біз мұны істей аламыз. Біз толықтай аламыз! ‬
Dialogue: 0,1:11:45.55,1:11:46.17,Default,,0,0,0,,Жоқ! ‬
Dialogue: 0,1:12:00.94,1:12:02.23,Default,,0,0,0,,Ғай...
Dialogue: 0,1:12:03.61,1:12:06.44,Default,,0,0,0,,Уф, иә?
Dialogue: 0,1:12:06.53,1:12:08.65,Default,,0,0,0,,Мен бардым~
Dialogue: 0,1:12:08.74,1:12:10.03,Default,,0,0,0,,Не? Не? ‬
Dialogue: 0,1:12:10.11,1:12:11.66,Default,,0,0,0,,Не? иә? ‬
Dialogue: 0,1:12:11.74,1:12:13.53,Default,,0,0,0,,Уау Уау Уау
Dialogue: 0,1:12:13.62,1:12:18.70,Default,,0,0,0,,Уау! ‬
Dialogue: 0,1:12:20.91,1:12:26.17,Default,,0,0,0,,(Тыныс алу) (Ертегі қанаттарының дыбысы)
Dialogue: 0,1:12:30.13,1:12:32.26,Default,,0,0,0,,(пері ханшайымының қанаттары)
Dialogue: 0,1:12:34.64,1:12:36.43,Default,,0,0,0,,Сен перісің! ‬
Dialogue: 0,1:12:36.51,1:12:37.77,Default,,0,0,0,,(Фея) Оны сол күйінде қалдыр.
Dialogue: 0,1:12:37.85,1:12:39.22,Default,,0,0,0,,Сіздің даналығыңыз
Dialogue: 0,1:12:39.31,1:12:41.94,Default,,0,0,0,,Батылдығыңызды сынағаным үшін кешірім сұраймын.
Dialogue: 0,1:12:42.02,1:12:44.73,Default,,0,0,0,,Шламға шыдаңыз
Dialogue: 0,1:12:46.90,1:12:49.53,Default,,0,0,0,,Сіз осында үлгердіңіз.
Dialogue: 0,1:12:49.61,1:12:51.90,Default,,0,0,0,,Сіз әділ адам сияқтысыз.
Dialogue: 0,1:12:52.40,1:12:53.41,Default,,0,0,0,,Жарайды
Dialogue: 0,1:12:53.49,1:12:55.28,Default,,0,0,0,,Тілектеріңіз орындалсын
Dialogue: 0,1:12:55.74,1:12:58.79,Default,,0,0,0,,Олай болса, жындар әлемінің қақпасын мәңгілікке бекітіңіз.
Dialogue: 0,1:12:58.87,1:13:00.66,Default,,0,0,0,,Анам мен әйеліме көмектесіңізші
Dialogue: 0,1:13:01.04,1:13:02.66,Default,,0,0,0,,(Ертегі) Мен...
Dialogue: 0,1:13:03.17,1:13:07.46,Default,,0,0,0,,Мен саған өз еркіңді орындауға көмектесемін.
Dialogue: 0,1:13:07.54,1:13:10.71,Default,,0,0,0,,Бірақ сіз тікелей әрекет ете алмайсыз.
Dialogue: 0,1:13:10.80,1:13:12.09,Default,,0,0,0,,Сонымен не? ‬
Dialogue: 0,1:13:12.97,1:13:15.51,Default,,0,0,0,,Бұл сіз қалаған нәрсе
Dialogue: 0,1:13:15.59,1:13:18.10,Default,,0,0,0,,Айдаһар шары! неге сен? ‬
Dialogue: 0,1:13:18.18,1:13:20.06,Default,,0,0,0,,(Ертегі) Бұл жалған. Эх...
Dialogue: 0,1:13:20.72,1:13:23.60,Default,,0,0,0,,Мен сені уақытында қайтарамын
Dialogue: 0,1:13:23.69,1:13:26.52,Default,,0,0,0,,Балалық шағыңызды сонда кездестіріңіз
Dialogue: 0,1:13:26.61,1:13:30.40,Default,,0,0,0,,Иә, сол уақыт, сол жер.
Dialogue: 0,1:13:30.90,1:13:34.61,Default,,0,0,0,,(Ер адам) Сізде таңғажайып шар бар. Маған көрсете аласыз ба? ‬
Dialogue: 0,1:13:35.78,1:13:39.16,Default,,0,0,0,,Иә? Мен мұны ешқашан күтпеген едім ...
Dialogue: 0,1:13:39.54,1:13:41.58,Default,,0,0,0,,Иә, сол жерде.
Dialogue: 0,1:13:41.95,1:13:45.12,Default,,0,0,0,,Не істеу керек... сіз білесіз.
Dialogue: 0,1:13:45.21,1:13:47.71,Default,,0,0,0,,Өткенге барасың
Dialogue: 0,1:13:47.79,1:13:50.30,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:13:50.38,1:13:52.97,Default,,0,0,0,,(Өткенге бағытталған дыбыс эффектісі)
Dialogue: 0,1:13:53.05,1:13:55.80,Default,,0,0,0,,Иә? Герегеге Қайда бардың? ‬
Dialogue: 0,1:13:55.88,1:13:56.89,Default,,0,0,0,,Сен, сен (бала Лукас) Уау! ‬
Dialogue: 0,1:13:57.51,1:13:59.93,Default,,0,0,0,,Аа, сізді таң қалдырғаным үшін кешіріңіз.
Dialogue: 0,1:14:00.01,1:14:02.35,Default,,0,0,0,,Мен адасып қалдым
Dialogue: 0,1:14:02.43,1:14:03.60,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:14:03.68,1:14:05.31,Default,,0,0,0,,О
Dialogue: 0,1:14:05.94,1:14:08.06,Default,,0,0,0,,Сізде таңғажайып шар бар.
Dialogue: 0,1:14:08.15,1:14:09.61,Default,,0,0,0,,Маған бірдеңе көрсете аласыз ба? ‬
Dialogue: 0,1:14:09.69,1:14:11.61,Default,,0,0,0,,Е, сен қайдан білдің? ‬
Dialogue: 0,1:14:11.69,1:14:14.15,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,1:14:14.24,1:14:17.32,Default,,0,0,0,,Мен сенің сөмкеңдегі шардың иісін сеземін.
Dialogue: 0,1:14:17.41,1:14:18.24,Default,,0,0,0,,Сәлем
Dialogue: 0,1:14:19.32,1:14:20.20,Default,,0,0,0,,Бірақ жоқ
Dialogue: 0,1:14:20.28,1:14:22.79,Default,,0,0,0,,Бұл маңызды
Dialogue: 0,1:14:22.87,1:14:24.62,Default,,0,0,0,,Сол жаққа барсаңыз, Санта Роуз
Dialogue: 0,1:14:24.71,1:14:25.37,Default,,0,0,0,,Олай болса
Dialogue: 0,1:14:25.46,1:14:26.96,Default,,0,0,0,,Эй, сәл күте тұрыңыз! ‬
Dialogue: 0,1:14:27.04,1:14:28.96,Default,,0,0,0,,Менің ұрлық жасау ойым жоқ.
Dialogue: 0,1:14:29.04,1:14:30.17,Default,,0,0,0,,Маған сенгеніңізді қалаймын.
Dialogue: 0,1:14:30.25,1:14:32.38,Default,,0,0,0,,А, мұны істейік.
Dialogue: 0,1:14:32.46,1:14:34.88,Default,,0,0,0,,Мен саған қымбатты досымды көрсетемін.
Dialogue: 0,1:14:34.97,1:14:37.05,Default,,0,0,0,,Оның орнына шарыңызды көрсете аласыз ба? ‬
Dialogue: 0,1:14:37.13,1:14:40.43,Default,,0,0,0,,Маған осындай келісімді ұсынған жігіт
Dialogue: 0,1:14:40.51,1:14:42.06,Default,,0,0,0,,Ең қауіптісі, солай емес пе?
Dialogue: 0,1:14:42.47,1:14:44.77,Default,,0,0,0,,Ммм, түсіндім.
Dialogue: 0,1:14:44.85,1:14:47.10,Default,,0,0,0,,Бірақ менің достарыма қараңдаршы
Dialogue: 0,1:14:47.19,1:14:48.98,Default,,0,0,0,,Сіз мұны айта аласыз ба? ‬
Dialogue: 0,1:14:51.11,1:14:53.40,Default,,0,0,0,,Шламды шлам
Dialogue: 0,1:14:55.86,1:14:58.70,Default,,0,0,0,,Әй, бұл шлам ба?
Dialogue: 0,1:14:59.53,1:15:02.49,Default,,0,0,0,,Менің де бала пантера досым бар.
Dialogue: 0,1:15:02.78,1:15:03.99,Default,,0,0,0,,Ол Гер Гир деп аталады.
Dialogue: 0,1:15:04.37,1:15:06.29,Default,,0,0,0,,О, бұл таңқаларлық
Dialogue: 0,1:15:06.37,1:15:08.83,Default,,0,0,0,,Сіз осы жаста пантера баласыз ба? ‬
Dialogue: 0,1:15:09.21,1:15:12.92,Default,,0,0,0,,Мен саған аз да болса көмектесіп, дос болып кеттік.
Dialogue: 0,1:15:13.42,1:15:15.21,Default,,0,0,0,,Иә.
Dialogue: 0,1:15:15.84,1:15:17.38,Default,,0,0,0,,Әйел алған кезде
Dialogue: 0,1:15:17.47,1:15:18.97,Default,,0,0,0,,Мұқият ойлан
Dialogue: 0,1:15:19.89,1:15:21.89,Default,,0,0,0,,Біз кез келген нәрсе туралы айта аламыз.
Dialogue: 0,1:15:21.97,1:15:24.01,Default,,0,0,0,,Ол өте маңызды адам.
Dialogue: 0,1:15:24.43,1:15:25.60,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,1:15:25.68,1:15:27.39,Default,,0,0,0,,О, сен сондай адалсың.
Dialogue: 0,1:15:27.98,1:15:30.73,Default,,0,0,0,,Жарайды, сен жаман адам емес сияқтысың.
Dialogue: 0,1:15:30.81,1:15:32.77,Default,,0,0,0,,Мен сізге ерекше нәрсе көрсетемін.
Dialogue: 0,1:15:32.86,1:15:33.73,Default,,0,0,0,,Түсіндім! ‬
Dialogue: 0,1:15:35.53,1:15:36.94,Default,,0,0,0,,Ой... (Лукас бала) Қазірдің өзінде
Dialogue: 0,1:15:37.44,1:15:38.90,Default,,0,0,0,,Не істеп жатырсың! ‬
Dialogue: 0,1:15:38.99,1:15:40.41,Default,,0,0,0,,жаман жаман
Dialogue: 0,1:15:41.11,1:15:42.12,Default,,0,0,0,,Иә
Dialogue: 0,1:15:42.62,1:15:44.87,Default,,0,0,0,,Бұл өте әдемі шар.
Dialogue: 0,1:15:44.95,1:15:46.25,Default,,0,0,0,,Рахмет
Dialogue: 0,1:15:46.33,1:15:47.62,Default,,0,0,0,,Сәлем Лукас
Dialogue: 0,1:15:47.70,1:15:49.12,Default,,0,0,0,,Саяхатқа шығатын кез келді
Dialogue: 0,1:15:49.21,1:15:50.08,Default,,0,0,0,,(Бала Лукас) Иә.
Dialogue: 0,1:15:51.63,1:15:53.04,Default,,0,0,0,,(Лукас бала) Мен қазір кетуім керек.
Dialogue: 0,1:15:54.92,1:15:55.92,Default,,0,0,0,,(Лукас бала) Не болды? ‬
Dialogue: 0,1:15:56.00,1:15:57.26,Default,,0,0,0,,Бұл сенің әкең бе? ‬
Dialogue: 0,1:15:57.71,1:15:59.72,Default,,0,0,0,,Иә, бұл өте күшті.
Dialogue: 0,1:15:59.80,1:16:01.34,Default,,0,0,0,,Ол мақтаншақ әке.
Dialogue: 0,1:16:01.43,1:16:03.80,Default,,0,0,0,,Хехе, онда кеттік.
Dialogue: 0,1:16:03.89,1:16:04.47,Default,,0,0,0,,‪‬
Dialogue: 0,1:16:04.56,1:16:06.77,Default,,0,0,0,,Маған қазынаны көрсеткеніңіз үшін рахмет.
Dialogue: 0,1:16:06.85,1:16:07.77,Default,,0,0,0,,Иә
Dialogue: 0,1:16:09.35,1:16:10.27,Default,,0,0,0,,Гереге
Dialogue: 0,1:16:10.35,1:16:11.94,Default,,0,0,0,,Эй (бала Лукас) Не? ‬
Dialogue: 0,1:16:12.44,1:16:14.90,Default,,0,0,0,,Егер сізді көптеген қиын істер күтіп тұрса, не істер едіңіз? ‬
Dialogue: 0,1:16:15.44,1:16:18.82,Default,,0,0,0,,Түрім осылай болса да, мен сол папаның баласымын.
Dialogue: 0,1:16:18.90,1:16:22.03,Default,,0,0,0,,Қанша қиын болса да, мен берілмеймін.
Dialogue: 0,1:16:23.41,1:16:26.20,Default,,0,0,0,,Иә, дұрыс! ‬
Dialogue: 0,1:16:26.62,1:16:27.70,Default,,0,0,0,,Сонда кездескенше! ‬
Dialogue: 0,1:16:30.25,1:16:31.79,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:16:34.50,1:16:36.59,Default,,0,0,0,,♪～
Dialogue: 0,1:16:36.67,1:16:41.26,Default,,0,0,0,,(Үру)
Dialogue: 0,1:16:41.34,1:16:47.56,Default,,0,0,0,,♪～
Dialogue: 0,1:16:51.44,1:16:54.23,Default,,0,0,0,,(Шебер Айдаһар) Мықтап ұстаңыз! ‬
Dialogue: 0,1:16:54.31,1:16:59.44,Default,,0,0,0,,(Гүрілдеу)
Dialogue: 0,1:17:09.37,1:17:11.00,Default,,0,0,0,,Керемет...
Dialogue: 0,1:17:11.58,1:17:13.50,Default,,0,0,0,,(Айдаһар шебері) Міне болды! ‬
Dialogue: 0,1:17:14.25,1:17:15.67,Default,,0,0,0,,Құрметті! ‬
Dialogue: 0,1:17:21.51,1:17:23.97,Default,,0,0,0,,Күрсін... Уф...
Dialogue: 0,1:17:24.72,1:17:25.64,Default,,0,0,0,,Бианка! ‬
Dialogue: 0,1:17:26.05,1:17:26.97,Default,,0,0,0,,Лукас! ‬
Dialogue: 0,1:17:27.97,1:17:29.26,Default,,0,0,0,,Анашым! ‬
Dialogue: 0,1:17:30.72,1:17:31.98,Default,,0,0,0,,Сіз...
Dialogue: 0,1:17:32.06,1:17:34.14,Default,,0,0,0,,Кез келген жағдайда, Арс? ‬
Dialogue: 0,1:17:34.23,1:17:35.06,Default,,0,0,0,,Иә! ‬
Dialogue: 0,1:17:35.15,1:17:37.27,Default,,0,0,0,,Ол соншалықты үлкен ...
Dialogue: 0,1:17:38.27,1:17:40.73,Default,,0,0,0,,Осы уақытқа дейін сені жалғыз қалдырғаным үшін кешір.
Dialogue: 0,1:17:40.82,1:17:42.19,Default,,0,0,0,,Анашым! ‬
Dialogue: 0,1:17:44.36,1:17:47.20,Default,,0,0,0,,Мен ең сүйкімді сәтті сағындым
Dialogue: 0,1:17:47.62,1:17:50.04,Default,,0,0,0,,Сіз қазірден бастап қалағаныңызша қайтара аласыз.
Dialogue: 0,1:17:50.12,1:17:52.66,Default,,0,0,0,,Иә? Бянка бұл көздер
Dialogue: 0,1:17:53.16,1:17:55.67,Default,,0,0,0,,Мен де Аспан жұртының ұрпағы едім.
Dialogue: 0,1:17:56.08,1:17:59.50,Default,,0,0,0,,Солай болды ма? Міне бітті! ‬
Dialogue: 0,1:18:01.92,1:18:04.17,Default,,0,0,0,,Сенің енең ана жақта.
Dialogue: 0,1:18:19.48,1:18:20.02,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:20.11,1:18:22.78,Default,,0,0,0,,(Марта) Лукас... Лукас...
Dialogue: 0,1:18:22.86,1:18:25.49,Default,,0,0,0,,Бұл сенің анаң Марта.
Dialogue: 0,1:18:25.57,1:18:26.20,Default,,0,0,0,,Иә? ‬
Dialogue: 0,1:18:26.28,1:18:27.66,Default,,0,0,0,,Ана? Ах
Dialogue: 0,1:18:29.20,1:18:32.87,Default,,0,0,0,,Лукас, келдің.
Dialogue: 0,1:18:33.20,1:18:35.62,Default,,0,0,0,,Мен анама көмектескім келеді
Dialogue: 0,1:18:35.71,1:18:38.42,Default,,0,0,0,,Сол сезім жеткілікті
Dialogue: 0,1:18:38.50,1:18:39.42,Default,,0,0,0,,Геманы жеңу
Dialogue: 0,1:18:39.50,1:18:42.71,Default,,0,0,0,,Жындар әлемінің қақпасын жабуға тырыспаңыз.
Dialogue: 0,1:18:42.80,1:18:44.63,Default,,0,0,0,,Осы жерге кері бұрылыңыз! ‬
Dialogue: 0,1:18:44.72,1:18:45.84,Default,,0,0,0,,… Міне! ‬
Dialogue: 0,1:18:45.92,1:18:50.39,Default,,0,0,0,,Бұл жолы мен Милдрастың зор күшін сезіндім.
Dialogue: 0,1:18:50.47,1:18:54.10,Default,,0,0,0,,Оның әлемді жоюға күші жетеді.
Dialogue: 0,1:18:54.18,1:18:56.73,Default,,0,0,0,,Ұрысуға тырыспаңыз
Dialogue: 0,1:18:56.81,1:18:57.94,Default,,0,0,0,,Бұл жолы? ‬
Dialogue: 0,1:18:58.02,1:19:01.40,Default,,0,0,0,,(Марта) Дұрыс, бұрынғыдан мүлде басқа күш...
Dialogue: 0,1:19:02.23,1:19:05.03,Default,,0,0,0,,(Марта) Бұл біз күресе алатын адам емес.
Dialogue: 0,1:19:05.11,1:19:07.03,Default,,0,0,0,,(Марта) Мен сиқырламасам
Dialogue: 0,1:19:07.11,1:19:09.49,Default,,0,0,0,,(Марта) Жындар әлемінің қақпасы ешқашан ашылмайды.
Dialogue: 0,1:19:10.16,1:19:13.79,Default,,0,0,0,,(Марта) Бұл әлемді құтқарудың жалғыз жолы! ‬
Dialogue: 0,1:19:13.87,1:19:14.49,Default,,0,0,0,,Ах
Dialogue: 0,1:19:14.58,1:19:15.87,Default,,0,0,0,,(Марта) Ах! ‬
Dialogue: 0,1:19:16.16,1:19:17.83,Default,,0,0,0,,Әй, анашым! ‬
Dialogue: 0,1:19:18.29,1:19:19.83,Default,,0,0,0,,Хахахаха
Dialogue: 0,1:19:20.83,1:19:22.50,Default,,0,0,0,,Мастер Айдаһар! ‬
Dialogue: 0,1:19:22.59,1:19:25.38,Default,,0,0,0,,Мен бұрынғы адамнан өзгешемін.
Dialogue: 0,1:19:25.46,1:19:26.72,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:19:26.80,1:19:28.68,Default,,0,0,0,,(Шебер Айдаһар) Қандай күш...
Dialogue: 0,1:19:29.09,1:19:32.30,Default,,0,0,0,,Уау! (Мастер Айдаһар) Ууууууууууууууууууууууу
Dialogue: 0,1:19:33.76,1:19:36.02,Default,,0,0,0,,Мен үшін алаңдамай, кет! ‬
Dialogue: 0,1:19:36.10,1:19:37.68,Default,,0,0,0,,Пусанға рахмет! ‬
Dialogue: 0,1:19:43.73,1:19:44.86,Default,,0,0,0,,Гемаааааа! ‬
Dialogue: 0,1:19:46.40,1:19:47.49,Default,,0,0,0,,Анашым! ‬
Dialogue: 0,1:19:49.40,1:19:50.70,Default,,0,0,0,,Ана...
Dialogue: 0,1:19:52.45,1:19:53.58,Default,,0,0,0,,Лукас…
Dialogue: 0,1:19:56.70,1:20:00.67,Default,,0,0,0,,Мен сенімен танысқым келеді...
Dialogue: 0,1:20:00.75,1:20:02.25,Default,,0,0,0,,Ах
Dialogue: 0,1:20:03.21,1:20:06.96,Default,,0,0,0,,(Марта) Мен осы күнге дейін аман қалдым.
Dialogue: 0,1:20:10.59,1:20:12.09,Default,,0,0,0,,(Марта) Бірақ бұл...
Dialogue: 0,1:20:14.26,1:20:16.43,Default,,0,0,0,,Қақпаны ашатын сиқыр
Dialogue: 0,1:20:17.85,1:20:21.31,Default,,0,0,0,,Мәңгі мөрленген
Dialogue: 0,1:20:22.31,1:20:24.65,Default,,0,0,0,,Хааааааааааааааааааааааа
Dialogue: 0,1:20:24.73,1:20:26.02,Default,,0,0,0,,Ана...
Dialogue: 0,1:20:29.24,1:20:30.45,Default,,0,0,0,,Гемаааааа! ‬
Dialogue: 0,1:20:31.24,1:20:33.28,Default,,0,0,0,,Құрметті сіз! !
Dialogue: 0,1:20:33.82,1:20:35.99,Default,,0,0,0,,Адамдар, қабыл алыңыздар.
Dialogue: 0,1:20:36.87,1:20:43.00,Default,,0,0,0,,♪～
Dialogue: 0,1:20:43.08,1:20:44.21,Default,,0,0,0,,Екі көрпе! ‬
Dialogue: 0,1:20:44.29,1:20:45.75,Default,,0,0,0,,Бағима! ‬
Dialogue: 0,1:20:50.42,1:20:52.38,Default,,0,0,0,,Ааааааа! ‬
Dialogue: 0,1:20:59.56,1:21:01.27,Default,,0,0,0,,Уаааааааааааааааааааааааа
Dialogue: 0,1:21:01.85,1:21:02.60,Default,,0,0,0,,Кеттік! ‬
Dialogue: 0,1:21:02.69,1:21:03.73,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:09.23,1:21:11.82,Default,,0,0,0,,Уа, уау, ау!
Dialogue: 0,1:21:13.45,1:21:15.16,Default,,0,0,0,,Гига Даин! ‬
Dialogue: 0,1:21:22.87,1:21:24.92,Default,,0,0,0,,Уау! ‬
Dialogue: 0,1:21:27.46,1:21:28.38,Default,,0,0,0,,Зараки! ‬
Dialogue: 0,1:21:30.30,1:21:31.46,Default,,0,0,0,,Мелами! ‬
Dialogue: 0,1:21:32.17,1:21:33.43,Default,,0,0,0,,Бегирагон! ‬
Dialogue: 0,1:21:38.89,1:21:40.64,Default,,0,0,0,,Өте көп! ‬
Dialogue: 0,1:21:42.89,1:21:45.23,Default,,0,0,0,,Охохохохо
Dialogue: 0,1:21:45.31,1:21:48.69,Default,,0,0,0,,Енді аяқтаймыз.
Dialogue: 0,1:21:48.77,1:21:50.40,Default,,0,0,0,,Хехехехе
Dialogue: 0,1:21:50.48,1:21:54.07,Default,,0,0,0,,Хохохохо! ‬
Dialogue: 0,1:21:54.15,1:21:54.74,Default,,0,0,0,,Га
Dialogue: 0,1:21:57.28,1:21:59.03,Default,,0,0,0,,(Құбыжықтар) Уау!
Dialogue: 0,1:21:59.12,1:22:00.08,Default,,0,0,0,,Не! ‬
Dialogue: 0,1:22:00.49,1:22:02.16,Default,,0,0,0,,Ах! ‬
Dialogue: 0,1:22:12.26,1:22:14.67,Default,,0,0,0,,Мен жақсылықты қайтаруға келдім! ‬
Dialogue: 0,1:22:14.76,1:22:18.76,Default,,0,0,0,,(Жауынгерлік айқай)
Dialogue: 0,1:22:18.85,1:22:20.72,Default,,0,0,0,,Ода да! ‬
Dialogue: 0,1:22:21.14,1:22:22.18,Default,,0,0,0,,Балалар! ‬
Dialogue: 0,1:22:22.27,1:22:24.73,Default,,0,0,0,,Менімен жалғастыр! ‬
Dialogue: 0,1:22:30.77,1:22:33.23,Default,,0,0,0,,Гунунуну
Dialogue: 0,1:22:34.07,1:22:36.82,Default,,0,0,0,,Гуну Гуну Нунуну
Dialogue: 0,1:22:38.11,1:22:39.24,Default,,0,0,0,,(Генри) Сәлем!
Dialogue: 0,1:22:41.03,1:22:43.29,Default,,0,0,0,,Гргххххххх
Dialogue: 0,1:22:44.20,1:22:46.71,Default,,0,0,0,,Ах! Лукас! Қайын енең! ‬
Dialogue: 0,1:22:47.29,1:22:48.29,Default,,0,0,0,,Ах!
Dialogue: 0,1:22:50.25,1:22:52.17,Default,,0,0,0,,Мұны маған қалдырыңыз! ‬
Dialogue: 0,1:22:52.25,1:22:53.80,Default,,0,0,0,,Кешіріңіз, Генри
Dialogue: 0,1:22:58.26,1:22:59.59,Default,,0,0,0,,Мазасыздықты жойыңыз
Dialogue: 0,1:23:03.39,1:23:04.89,Default,,0,0,0,,Біз қарсыласпыз, Лукас! ‬
Dialogue: 0,1:23:04.98,1:23:05.89,Default,,0,0,0,,Арх! ‬
Dialogue: 0,1:23:05.98,1:23:07.48,Default,,0,0,0,,Ааааааааааааааааааааааааа
Dialogue: 0,1:23:07.56,1:23:09.27,Default,,0,0,0,,Күте тұрыңыз, Гема! ‬
Dialogue: 0,1:23:09.77,1:23:12.07,Default,,0,0,0,,Эй, сен жалғызсың ба? ‬
Dialogue: 0,1:23:12.48,1:23:15.49,Default,,0,0,0,,Сонда сіз жарақат алу үшін келдіңіз бе? ‬
Dialogue: 0,1:23:15.57,1:23:17.70,Default,,0,0,0,,Ахахха охохохохо
Dialogue: 0,1:23:17.78,1:23:20.49,Default,,0,0,0,,Ууууууу! ‬
Dialogue: 0,1:23:27.21,1:23:28.04,Default,,0,0,0,,Бағима! ‬
Dialogue: 0,1:23:28.12,1:23:29.21,Default,,0,0,0,,Сондай-ақ——! ‬
Dialogue: 0,1:23:29.92,1:23:32.09,Default,,0,0,0,,Уаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,1:23:32.17,1:23:33.84,Default,,0,0,0,,Уау! ‬
Dialogue: 0,1:23:43.89,1:23:46.35,Default,,0,0,0,,Уау!
Dialogue: 0,1:23:46.85,1:23:48.35,Default,,0,0,0,,Батыр емес саған
Dialogue: 0,1:23:48.44,1:23:50.98,Default,,0,0,0,,Сіз не істей аласыз? ‬
Dialogue: 0,1:23:51.06,1:23:52.27,Default,,0,0,0,,Құрметті! ‬
Dialogue: 0,1:23:53.11,1:23:54.11,Default,,0,0,0,,Баги Крест! ‬
Dialogue: 0,1:23:59.36,1:24:00.45,Default,,0,0,0,,Уау!
Dialogue: 0,1:24:03.70,1:24:04.99,Default,,0,0,0,,Иә
Dialogue: 0,1:24:05.08,1:24:07.25,Default,,0,0,0,,Уау! ‬
Dialogue: 0,1:24:07.33,1:24:08.04,Default,,0,0,0,,Уау
Dialogue: 0,1:24:09.96,1:24:10.54,Default,,0,0,0,,Уау! ‬
Dialogue: 0,1:24:12.42,1:24:15.09,Default,,0,0,0,,Уау! ‬
Dialogue: 0,1:24:15.17,1:24:17.55,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,1:24:17.96,1:24:19.17,Default,,0,0,0,,Хехехе
Dialogue: 0,1:24:19.97,1:24:23.97,Default,,0,0,0,,Бұл шынымен ұят.
Dialogue: 0,1:24:25.06,1:24:28.31,Default,,0,0,0,,Бұл дерлік болды! ‬
Dialogue: 0,1:24:32.48,1:24:38.69,Default,,0,0,0,,(еңіреді)
Dialogue: 0,1:24:39.11,1:24:41.28,Default,,0,0,0,,Хехехе
Dialogue: 0,1:24:41.36,1:24:44.24,Default,,0,0,0,,Хмм хе хе хе хе хе
Dialogue: 0,1:24:51.75,1:24:52.75,Default,,0,0,0,,Арс! ‬
Dialogue: 0,1:24:52.83,1:24:58.59,Default,,0,0,0,,Гунуннуннунну
Dialogue: 0,1:24:58.67,1:25:01.93,Default,,0,0,0,,Ияййййййййй! ‬
Dialogue: 0,1:25:02.84,1:25:05.97,Default,,0,0,0,,Гааааааааааааааааааа! ‬
Dialogue: 0,1:25:14.40,1:25:17.65,Default,,0,0,0,,Иә!
Dialogue: 0,1:25:17.73,1:25:19.73,Default,,0,0,0,,Осы жылдамдықпен...
Dialogue: 0,1:25:20.36,1:25:24.03,Default,,0,0,0,,Бұл бітпейді...
Dialogue: 0,1:25:25.37,1:25:26.83,Default,,0,0,0,,Хахахаха
Dialogue: 0,1:25:26.91,1:25:31.04,Default,,0,0,0,,Анамның құрбандығымен жын дүниенің қақпасы мәңгілікке жабылды.
Dialogue: 0,1:25:31.12,1:25:34.12,Default,,0,0,0,,Сіздің амбицияңыз аяқталды! ‬
Dialogue: 0,1:25:34.58,1:25:35.88,Default,,0,0,0,,Тыныш өл! ‬
Dialogue: 0,1:25:35.96,1:25:38.04,Default,,0,0,0,,Иә!
Dialogue: 0,1:25:38.13,1:25:42.51,Default,,0,0,0,,Қалай ойлайсың, мен осылай бітемін бе? ‬
Dialogue: 0,1:25:42.59,1:25:44.88,Default,,0,0,0,,Сиқыр мәңгілік жерленген! ‬
Dialogue: 0,1:25:44.97,1:25:46.39,Default,,0,0,0,,Ештеңе қалмады! ‬
Dialogue: 0,1:25:47.01,1:25:49.22,Default,,0,0,0,,Уақыт пісіп қалды
Dialogue: 0,1:25:50.68,1:25:54.23,Default,,0,0,0,,Қақпадан ағып жатқан жын әлемінің жарығымен
Dialogue: 0,1:25:54.31,1:25:58.61,Default,,0,0,0,,Өйткені мен бұл күшке ие болдым! ‬
Dialogue: 0,1:25:58.69,1:25:59.98,Default,,0,0,0,,Хааааааааа
Dialogue: 0,1:26:00.07,1:26:01.48,Default,,0,0,0,,Уау! ‬
Dialogue: 0,1:26:01.57,1:26:06.16,Default,,0,0,0,,Ах, Милдрат-сама
Dialogue: 0,1:26:06.24,1:26:10.08,Default,,0,0,0,,Қақпаларды ашатын кез келді! ‬
Dialogue: 0,1:26:10.99,1:26:14.87,Default,,0,0,0,,Хахахаха... Ооо
Dialogue: 0,1:26:14.96,1:26:17.42,Default,,0,0,0,,Бұл адамның қабілеті
Dialogue: 0,1:26:17.50,1:26:20.59,Default,,0,0,0,,Ол ағып жатыр.
Dialogue: 0,1:26:22.01,1:26:25.51,Default,,0,0,0,,Бұл Мартаның күші ме?! ‬
Dialogue: 0,1:26:26.80,1:26:31.72,Default,,0,0,0,,Ашушы Ил Милдрас
Dialogue: 0,1:26:38.10,1:26:39.86,Default,,0,0,0,,Енді...
Dialogue: 0,1:26:40.65,1:26:43.57,Default,,0,0,0,,Менің шын тілегім...
Dialogue: 0,1:26:43.65,1:26:46.53,Default,,0,0,0,,Ахахха
Dialogue: 0,1:26:47.36,1:26:49.87,Default,,0,0,0,,Орындау
Dialogue: 0,1:26:49.95,1:26:51.78,Default,,0,0,0,,Уф...
Dialogue: 0,1:27:01.00,1:27:04.05,Default,,0,0,0,,Мен мұны тоқтатамын.
Dialogue: 0,1:27:04.96,1:27:07.18,Default,,0,0,0,,Бұны лақтырсаң, қақпа ашылады! ‬
Dialogue: 0,1:27:07.26,1:27:07.97,Default,,0,0,0,,Бірақ
Dialogue: 0,1:27:08.34,1:27:10.43,Default,,0,0,0,,Ол жерге қалай жеттіңіз...
Dialogue: 0,1:27:13.68,1:27:16.14,Default,,0,0,0,,(Бооон) Ұстап алды~~
Dialogue: 0,1:27:16.73,1:27:19.60,Default,,0,0,0,,Оде оны лақтырады!
Dialogue: 0,1:27:19.69,1:27:22.32,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:27:26.53,1:27:27.53,Default,,0,0,0,,Сәлем! ‬
Dialogue: 0,1:27:35.95,1:27:37.41,Default,,0,0,0,,Әке! ‬
Dialogue: 0,1:27:38.00,1:27:40.54,Default,,0,0,0,,Арс! Жарайсың! ‬
Dialogue: 0,1:27:40.63,1:27:43.04,Default,,0,0,0,,Бұл әлемді құтқара ма...
Dialogue: 0,1:28:05.61,1:28:08.07,Default,,0,0,0,,Бұл не...
Dialogue: 0,1:28:10.03,1:28:11.66,Default,,0,0,0,,Не болды...
Dialogue: 0,1:28:11.74,1:28:13.20,Default,,0,0,0,,Нақты не болды? ‬
Dialogue: 0,1:28:14.16,1:28:17.00,Default,,0,0,0,,Бианка Эй Бианка
Dialogue: 0,1:28:17.08,1:28:19.12,Default,,0,0,0,,(Дауыс) Ха ха ха ха
Dialogue: 0,1:28:31.84,1:28:33.64,Default,,0,0,0,,(Мильдрас) Жарайсың.
Dialogue: 0,1:28:34.55,1:28:36.64,Default,,0,0,0,,Соңғы технологиядан күткендей
Dialogue: 0,1:28:37.14,1:28:38.22,Default,,0,0,0,,Не...
Dialogue: 0,1:28:38.31,1:28:39.14,Default,,0,0,0,,Міне...
Dialogue: 0,1:28:39.68,1:28:41.56,Default,,0,0,0,,Дегенмен, негізгі бағдарлама...
Dialogue: 0,1:28:45.48,1:28:46.40,Default,,0,0,0,,Ах! ‬
Dialogue: 0,1:28:46.82,1:28:48.28,Default,,0,0,0,,Маған көрсетейін
Dialogue: 0,1:28:48.36,1:28:50.07,Default,,0,0,0,,Дүниенің шындығы
Dialogue: 0,1:28:50.57,1:28:52.36,Default,,0,0,0,,Карталау өшірулі
Dialogue: 0,1:29:00.08,1:29:01.54,Default,,0,0,0,,Не істеп жатырсың! ‬
Dialogue: 0,1:29:01.62,1:29:03.21,Default,,0,0,0,,Гравитация өшірулі
Dialogue: 0,1:29:05.79,1:29:06.50,Default,,0,0,0,,Бианка
Dialogue: 0,1:29:06.59,1:29:08.21,Default,,0,0,0,,Соқтығыс өшірулі
Dialogue: 0,1:29:09.26,1:29:10.42,Default,,0,0,0,,Бианка…
Dialogue: 0,1:29:10.88,1:29:12.22,Default,,0,0,0,,Бианка! ‬
Dialogue: 0,1:29:13.01,1:29:15.05,Default,,0,0,0,,Өңдеуді жеңілдетейік
Dialogue: 0,1:29:17.31,1:29:20.81,Default,,0,0,0,,Ах... а...
Dialogue: 0,1:29:23.77,1:29:24.77,Default,,0,0,0,,Тоқта! ‬
Dialogue: 0,1:29:25.65,1:29:27.11,Default,,0,0,0,,Тоқта! ‬
Dialogue: 0,1:29:27.90,1:29:28.86,Default,,0,0,0,,Хахахаха
Dialogue: 0,1:29:29.40,1:29:32.82,Default,,0,0,0,,Тоқтатыңызшы! ‬
Dialogue: 0,1:29:35.57,1:29:37.45,Default,,0,0,0,,(Мильдраттың дауысы) Фуфуфуфуфу
Dialogue: 0,1:29:38.79,1:29:41.62,Default,,0,0,0,,Сіз Милдратсыз ба? ‬
Dialogue: 0,1:29:42.04,1:29:44.25,Default,,0,0,0,,Дәл емес
Dialogue: 0,1:29:44.33,1:29:45.67,Default,,0,0,0,,Мен Милдраспын
Dialogue: 0,1:29:45.75,1:29:47.59,Default,,0,0,0,,Мимиктік таңба коды
Dialogue: 0,1:29:47.67,1:29:50.09,Default,,0,0,0,,Бұл инвазивті вирус.
Dialogue: 0,1:29:53.05,1:29:55.64,Default,,0,0,0,,Марта мұны байқаған сияқты.
Dialogue: 0,1:29:56.30,1:29:57.97,Default,,0,0,0,,Бұрын «Айдаһар квесті» деп аталған
Dialogue: 0,1:29:58.05,1:30:01.43,Default,,0,0,0,,Әлемге әйгілі ойын шығарылды.
Dialogue: 0,1:30:01.52,1:30:03.48,Default,,0,0,0,,Содан бері бірнеше ондаған жылдар өтті...
Dialogue: 0,1:30:04.14,1:30:07.56,Default,,0,0,0,,Бұл заманауи виртуалды жүйе аяқталды.
Dialogue: 0,1:30:07.65,1:30:09.36,Default,,0,0,0,,Ол танымал болған кезде
Dialogue: 0,1:30:09.82,1:30:12.32,Default,,0,0,0,,«Айдаһар іздеу» ойыны
Dialogue: 0,1:30:12.40,1:30:15.03,Default,,0,0,0,,Жаңа ортамен қайта жасалды
Dialogue: 0,1:30:15.66,1:30:17.03,Default,,0,0,0,,Иә.
Dialogue: 0,1:30:17.12,1:30:18.37,Default,,0,0,0,,Бұл әлем
Dialogue: 0,1:30:20.16,1:30:22.04,Default,,0,0,0,,Сіз сондай сағынышсыз
Dialogue: 0,1:30:22.12,1:30:24.96,Default,,0,0,0,,Мен осы жүйеге қосылуды шештім.
Dialogue: 0,1:30:25.37,1:30:26.29,Default,,0,0,0,,Сондықтан
Dialogue: 0,1:30:26.37,1:30:29.04,Default,,0,0,0,,Сіз осы жүйеге кіргеннен бері
Dialogue: 0,1:30:29.13,1:30:31.75,Default,,0,0,0,,Бірнеше сағат болды.
Dialogue: 0,1:30:35.80,1:30:38.68,Default,,0,0,0,,...Бұл дүниені неге құртып жатырсың? ‬
Dialogue: 0,1:30:39.30,1:30:41.43,Default,,0,0,0,,Неге мені жалғыз қалдырмайсың? ‬
Dialogue: 0,1:30:41.51,1:30:43.56,Default,,0,0,0,,Мені жаратқан адам
Dialogue: 0,1:30:43.64,1:30:46.35,Default,,0,0,0,,Осы ақымақ виртуалды әлемнің тұрғындары
Dialogue: 0,1:30:46.44,1:30:48.69,Default,,0,0,0,,Мен оны жек көремін, мен оны жек көремін, мен оған көмектесе алмаймын.
Dialogue: 0,1:30:49.19,1:30:50.82,Default,,0,0,0,,Бұл мені жасады
Dialogue: 0,1:30:50.90,1:30:52.32,Default,,0,0,0,,Жіберілді
Dialogue: 0,1:30:53.73,1:30:55.86,Default,,0,0,0,,Сондықтан да...
Dialogue: 0,1:30:56.65,1:30:58.41,Default,,0,0,0,,Осындай ақымақ себеппен! ‬
Dialogue: 0,1:30:58.49,1:31:00.24,Default,,0,0,0,,Міне, солай.
Dialogue: 0,1:31:00.32,1:31:03.95,Default,,0,0,0,,Бұл данышпан бағдарламашының уақытты өлтіру тәсілі.
Dialogue: 0,1:31:04.50,1:31:05.46,Default,,0,0,0,,А, иә.
Dialogue: 0,1:31:05.54,1:31:07.79,Default,,0,0,0,,Менің одан хабарым бар.
Dialogue: 0,1:31:08.46,1:31:11.38,Default,,0,0,0,,«Өсе»
Dialogue: 0,1:31:12.96,1:31:14.21,Default,,0,0,0,,Ересек? ‬
Dialogue: 0,1:31:14.67,1:31:17.43,Default,,0,0,0,,Енді шындыққа оралыңыз.
Dialogue: 0,1:31:17.84,1:31:21.14,Default,,0,0,0,,Арх! ‬
Dialogue: 0,1:31:21.30,1:31:23.97,Default,,0,0,0,,Ааааааааааааааа! ‬
Dialogue: 0,1:31:24.06,1:31:25.43,Default,,0,0,0,,(Қызметкерлер) Сіз осында болғаныңызда,
Dialogue: 0,1:31:25.52,1:31:27.14,Default,,0,0,0,,Сіздің жадыңыз уақытша
Dialogue: 0,1:31:27.23,1:31:28.35,Default,,0,0,0,,Ол жойылады.
Dialogue: 0,1:31:28.44,1:31:31.36,Default,,0,0,0,,«Айдаһар квестінің тәжірибесі»
Dialogue: 0,1:31:28.44,1:31:31.36,Default,,0,0,0,,Сіз басты кейіпкердің өмірін толығымен көре аласыз.
Dialogue: 0,1:31:31.44,1:31:32.98,Default,,0,0,0,,(жалақы Лукас) Осы әлемнің тұрғыны болыңыз
Dialogue: 0,1:31:33.07,1:31:35.61,Default,,0,0,0,,Шытырман оқиғаға бару керемет.
Dialogue: 0,1:31:35.99,1:31:37.49,Default,,0,0,0,,Бианка немесе Флора?
Dialogue: 0,1:31:37.57,1:31:39.28,Default,,0,0,0,,Сіз көп уайымдамадыңыз ба? ‬
Dialogue: 0,1:31:39.36,1:31:41.28,Default,,0,0,0,,Бұл жолы мен міндетті түрде Флорамен бірге барғым келеді.
Dialogue: 0,1:31:41.37,1:31:42.95,Default,,0,0,0,,Бұл әрқашан Бьянка болатын
Dialogue: 0,1:31:43.03,1:31:45.54,Default,,0,0,0,,(Қызметкерлер) Менің ойымша, бұл жабдықпен сізде көбірек қиындықтар туындайды.
Dialogue: 0,1:31:45.62,1:31:46.12,Default,,0,0,0,,Ах!
Dialogue: 0,1:31:46.20,1:31:48.58,Default,,0,0,0,,(Көрсетуші) Өйткені, менің сезімім басты кейіпкермен бірдей.
Dialogue: 0,1:31:48.66,1:31:50.83,Default,,0,0,0,,Автоұсынуды пайдалануым керек пе?
Dialogue: 0,1:31:50.92,1:31:53.29,Default,,0,0,0,,Флора Флораны таңдаңыз! ‬
Dialogue: 0,1:31:53.38,1:31:54.59,Default,,0,0,0,,(Қызметкерлер) Ах, тұтынушы.
Dialogue: 0,1:31:54.67,1:31:55.63,Default,,0,0,0,,Не? (Қызметкерлер) Қазір
Dialogue: 0,1:31:55.71,1:31:57.72,Default,,0,0,0,,Автоұсыну бағдарламасы орнатылды.
Dialogue: 0,1:31:57.80,1:32:00.09,Default,,0,0,0,,Шынайы ма? Асығыңыз
Dialogue: 0,1:32:00.18,1:32:02.05,Default,,0,0,0,,(Офицер) Ахахха
Dialogue: 0,1:32:00.18,1:32:02.05,Default,,0,0,0,,«Айдаһар квесті тәжірибесі»
Dialogue: 0,1:32:02.14,1:32:04.43,Default,,0,0,0,,Бұл жүйе жаңа бағдарламаларды лезде жасайды.
Dialogue: 0,1:32:04.51,1:32:05.56,Default,,0,0,0,,Ол жасайды
Dialogue: 0,1:32:05.64,1:32:06.93,Default,,0,0,0,,Бас тарту керек пе? ‬
Dialogue: 0,1:32:07.02,1:32:09.52,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,1:32:09.60,1:32:12.19,Default,,0,0,0,,О, сен роботтармен де күресе аласың ба? ‬
Dialogue: 0,1:32:12.27,1:32:13.31,Default,,0,0,0,,(Офицер) Иә, мүмкін.
Dialogue: 0,1:32:13.40,1:32:15.23,Default,,0,0,0,,Оны опция ретінде қосыңыз.
Dialogue: 0,1:32:15.32,1:32:17.82,Default,,0,0,0,,Енді басты кейіпкердің атын таңдаңыз.
Dialogue: 0,1:32:18.32,1:32:19.24,Default,,0,0,0,,Лукаста
Dialogue: 0,1:32:19.32,1:32:21.32,Default,,0,0,0,,Бала кезімнен солай.
Dialogue: 0,1:32:21.41,1:32:24.16,Default,,0,0,0,,Иә, онда мен көзілдірікті түсіремін.
Dialogue: 0,1:32:24.70,1:32:26.62,Default,,0,0,0,,Ішіндегі мәтінді оқи аласыз ба? ‬
Dialogue: 0,1:32:26.70,1:32:27.66,Default,,0,0,0,,Иә
Dialogue: 0,1:32:27.75,1:32:30.04,Default,,0,0,0,,Параметрлерде қателер бар ма? ‬
Dialogue: 0,1:32:30.12,1:32:30.96,Default,,0,0,0,,№
Dialogue: 0,1:32:31.04,1:32:32.42,Default,,0,0,0,,Бастайық
Dialogue: 0,1:32:32.50,1:32:34.17,Default,,0,0,0,,Көңілді болыңыз
Dialogue: 0,1:32:35.38,1:32:38.97,Default,,0,0,0,,Гууууууууууу! ‬
Dialogue: 0,1:32:39.55,1:32:40.59,Default,,0,0,0,,Жүр, асығыңыз! ‬
Dialogue: 0,1:32:41.38,1:32:44.39,Default,,0,0,0,,Гррр! ‬
Dialogue: 0,1:32:44.47,1:32:45.89,Default,,0,0,0,,Неліктен алысқа бардың?
Dialogue: 0,1:32:45.97,1:32:47.93,Default,,0,0,0,,Сіз бұл дүниеге жабысып тұрсыз ба? ‬
Dialogue: 0,1:32:48.02,1:32:48.93,Default,,0,0,0,,Сізге де
Dialogue: 0,1:32:50.31,1:32:54.02,Default,,0,0,0,,Сізді жіберген адам да білмейді! ‬
Dialogue: 0,1:32:54.11,1:32:56.48,Default,,0,0,0,,(Баланың кеңсе қызметкері Луканың анасының дауысы) Туған күніңмен
Dialogue: 0,1:32:56.57,1:32:59.19,Default,,0,0,0,,(Бала кеңсе қызметкері Луканың дауысы) Ия, бұл Айдаһар Quest V.
Dialogue: 0,1:32:59.57,1:33:01.86,Default,,0,0,0,,(Луканың дауысы) Бала кезімнен
Dialogue: 0,1:33:03.70,1:33:05.78,Default,,0,0,0,,Мен үшін ойын әлемі
Dialogue: 0,1:33:05.87,1:33:07.70,Default,,0,0,0,,Бұл ешқашан өтірік болған емес
Dialogue: 0,1:33:09.00,1:33:11.37,Default,,0,0,0,,Бағдарлама болса да
Dialogue: 0,1:33:12.04,1:33:15.38,Default,,0,0,0,,Менің олармен өткізген уақытым шынайы болды.
Dialogue: 0,1:33:15.92,1:33:17.96,Default,,0,0,0,,Бұл сапар да
Dialogue: 0,1:33:18.05,1:33:19.46,Default,,0,0,0,,Бұл шайқас
Dialogue: 0,1:33:19.84,1:33:21.51,Default,,0,0,0,,Бұл кездесу де! ‬
Dialogue: 0,1:33:23.05,1:33:24.84,Default,,0,0,0,,Барлығы осында қалады! ‬
Dialogue: 0,1:33:24.93,1:33:26.80,Default,,0,0,0,,Бұл жоқтық, бұл елес.
Dialogue: 0,1:33:27.22,1:33:27.89,Default,,0,0,0,,Жоқ! ‬
Dialogue: 0,1:33:28.76,1:33:30.52,Default,,0,0,0,,Тағы бір шындық! ‬
Dialogue: 0,1:33:31.48,1:33:32.31,Default,,0,0,0,,Аузыңды жап! ‬
Dialogue: 0,1:33:33.31,1:33:34.94,Default,,0,0,0,,Жоғал! ‬
Dialogue: 0,1:33:35.35,1:33:37.57,Default,,0,0,0,,Ааааааааааааааааааааааааааа
Dialogue: 0,1:33:37.65,1:33:39.03,Default,,0,0,0,,Уау
Dialogue: 0,1:33:41.74,1:33:43.32,Default,,0,0,0,,Уау
Dialogue: 0,1:33:43.40,1:33:44.07,Default,,0,0,0,,Сурарин? ‬
Dialogue: 0,1:33:44.53,1:33:45.66,Default,,0,0,0,,Алданбаңыз
Dialogue: 0,1:33:46.45,1:33:47.91,Default,,0,0,0,,Сау болыңыз! ‬
Dialogue: 0,1:33:47.99,1:33:49.08,Default,,0,0,0,,Сіз ше? ‬
Dialogue: 0,1:33:49.16,1:33:52.16,Default,,0,0,0,,Мен бұл дүниені бақылап отырдым
Dialogue: 0,1:33:52.25,1:33:54.50,Default,,0,0,0,,Вирусқа қарсы бағдарлама! ‬
Dialogue: 0,1:33:55.75,1:33:58.13,Default,,0,0,0,,Менде вакцина дайын.
Dialogue: 0,1:33:58.92,1:34:01.01,Default,,0,0,0,,Саған сеніп тапсырамын! ‬
Dialogue: 0,1:34:02.09,1:34:05.51,Default,,0,0,0,,Шытырман оқиғаңызды аяқтаңыз! ‬
Dialogue: 0,1:34:10.18,1:34:12.60,Default,,0,0,0,,Ааааааааааа! ‬
Dialogue: 0,1:34:12.68,1:34:14.44,Default,,0,0,0,,Жоғал! ‬
Dialogue: 0,1:34:24.32,1:34:27.28,Default,,0,0,0,,Ах... а...
Dialogue: 0,1:34:27.37,1:34:33.20,Default,,0,0,0,,Гуаааааааааааааааааааааааааа...
Dialogue: 0,1:34:42.25,1:34:43.96,Default,,0,0,0,,Әлем...
Dialogue: 0,1:34:44.84,1:34:46.18,Default,,0,0,0,,Қайтарылды...
Dialogue: 0,1:34:47.18,1:34:49.47,Default,,0,0,0,,Әке! ‬
Dialogue: 0,1:34:51.43,1:34:52.68,Default,,0,0,0,,Барлығы...
Dialogue: 0,1:34:54.10,1:34:55.48,Default,,0,0,0,,Не болды? ‬
Dialogue: 0,1:34:55.56,1:34:58.02,Default,,0,0,0,,Сізді ұйықтатты.
Dialogue: 0,1:34:58.56,1:35:00.52,Default,,0,0,0,,Милдрат жоғалып кетті
Dialogue: 0,1:35:02.65,1:35:05.28,Default,,0,0,0,,Ол керемет қорқынышты жау болды.
Dialogue: 0,1:35:06.28,1:35:07.28,Default,,0,0,0,,(Генри) Лукас
Dialogue: 0,1:35:07.95,1:35:09.53,Default,,0,0,0,,Сіз мұны жасадыңыз ба? ‬
Dialogue: 0,1:35:10.37,1:35:12.99,Default,,0,0,0,,(Генри) Сен нағыз батырсың! ‬
Dialogue: 0,1:35:15.83,1:35:17.58,Default,,0,0,0,,Барлығына! ‬
Dialogue: 0,1:35:18.21,1:35:21.54,Default,,0,0,0,,Біз Гемамен соғысып жатырмыз.
Dialogue: 0,1:35:22.04,1:35:24.38,Default,,0,0,0,,Біз жеңдік! ‬
Dialogue: 0,1:35:24.46,1:35:31.47,Default,,0,0,0,,(Рейнхат армиясы) Ууууу! ‬
Dialogue: 0,1:35:34.77,1:35:37.31,Default,,0,0,0,,Егер бірдеңе болса, мен Одеге хабарласамын.
Dialogue: 0,1:35:37.73,1:35:39.85,Default,,0,0,0,,(Бум) Мен күтемін.
Dialogue: 0,1:35:40.73,1:35:42.94,Default,,0,0,0,,Біздің елге міндетті түрде келіңіз! ‬
Dialogue: 0,1:35:43.02,1:35:44.44,Default,,0,0,0,,Мен күтемін! ‬
Dialogue: 0,1:35:44.53,1:35:45.74,Default,,0,0,0,,Міндетті
Dialogue: 0,1:35:46.19,1:35:48.24,Default,,0,0,0,,Қайта кездескенше! ‬
Dialogue: 0,1:35:49.16,1:35:50.36,Default,,0,0,0,,(Генри) Қоштасу.
Dialogue: 0,1:35:51.95,1:35:53.16,Default,,0,0,0,,Қош бол
Dialogue: 0,1:35:53.24,1:35:54.41,Default,,0,0,0,,Ах...
Dialogue: 0,1:35:54.87,1:35:56.00,Default,,0,0,0,,Менде жағымсыз оқиға болды
Dialogue: 0,1:35:56.08,1:35:57.41,Default,,0,0,0,,Мистер Пуссин! ‬
Dialogue: 0,1:35:57.91,1:35:59.25,Default,,0,0,0,,Жарайсыңдар
Dialogue: 0,1:35:59.67,1:36:01.42,Default,,0,0,0,,Сасық жігіт! ‬
Dialogue: 0,1:36:01.50,1:36:03.67,Default,,0,0,0,,Ах ха ха
Dialogue: 0,1:36:04.67,1:36:05.63,Default,,0,0,0,,‪‬
Dialogue: 0,1:36:07.55,1:36:09.13,Default,,0,0,0,,Бәріңе сәлем
Dialogue: 0,1:36:09.22,1:36:11.34,Default,,0,0,0,,Осы жерден Санта Роуз қаласы келеді.
Dialogue: 0,1:36:11.43,1:36:14.01,Default,,0,0,0,,Бұл жақсы көрінеді.
Dialogue: 0,1:36:14.10,1:36:16.47,Default,,0,0,0,,(күлді)
Dialogue: 0,1:36:16.56,1:36:17.98,Default,,0,0,0,,‎Туған жеріме қайтқанда
Dialogue: 0,1:36:18.64,1:36:20.73,Default,,0,0,0,,Бұл саяхат аяқталды
Dialogue: 0,1:36:21.65,1:36:24.40,Default,,0,0,0,,Мен шынайы әлемге қайта ораламын деп ойлаймын
Dialogue: 0,1:36:26.73,1:36:27.99,Default,,0,0,0,,Бірақ
Dialogue: 0,1:36:28.53,1:36:30.74,Default,,0,0,0,,Балалар, әрине сонда болдыңдар.
Dialogue: 0,1:36:40.75,1:36:41.67,Default,,0,0,0,,Слурин…
Dialogue: 0,1:36:45.09,1:36:47.96,Default,,0,0,0,,Лука! не болды? ‬
Dialogue: 0,1:36:48.05,1:36:50.01,Default,,0,0,0,,Тез кел! ‬
Dialogue: 0,1:36:50.09,1:36:51.01,Default,,0,0,0,,Сәлем
Dialogue: 0,1:36:51.43,1:36:52.72,Default,,0,0,0,,Ахаха
Dialogue: 0,1:36:52.80,1:36:55.01,Default,,0,0,0,,Ақылсыз, біртүрлі адам
Dialogue: 0,1:36:55.10,1:36:56.85,Default,,0,0,0,,Бұл мені күлдіреді.
Dialogue: 0,1:36:56.93,1:36:58.02,Default,,0,0,0,,Хехехе
Dialogue: 0,1:36:58.10,1:36:59.77,Default,,0,0,0,,Бұл шытырман оқиға
Dialogue: 0,1:36:59.85,1:37:02.02,Default,,0,0,0,,Мен ешқашан ұмытпаймын
Dialogue: 0,1:37:02.10,1:37:04.86,Default,,0,0,0,,Не? Неге күлесің?
Dialogue: 0,1:37:04.94,1:37:05.98,Default,,0,0,0,,№
Dialogue: 0,1:37:06.07,1:37:08.23,Default,,0,0,0,,Мен жалғыз емеспін
Dialogue: 0,1:37:08.32,1:37:10.28,Default,,0,0,0,,Иә? Бұл анық, солай ма?
Dialogue: 0,1:37:10.36,1:37:12.07,Default,,0,0,0,,Біз осындамыз.
Dialogue: 0,1:37:12.15,1:37:12.95,Default,,0,0,0,,Тіпті Арс
Dialogue: 0,1:37:13.03,1:37:15.49,Default,,0,0,0,,Ол қазірден бастап үлкенірек болады.
Dialogue: 0,1:37:16.33,1:37:17.70,Default,,0,0,0,,Отшашу! ‬
Dialogue: 0,1:37:17.79,1:37:20.20,Default,,0,0,0,,Бұл мерекелік отшашу болатыны сөзсіз.
Dialogue: 0,1:37:20.29,1:37:21.21,Default,,0,0,0,,Қарашы, Лукас.
Dialogue: 0,1:37:21.29,1:37:23.29,Default,,0,0,0,,Сіз әлемді құтқардыңыз.
Dialogue: 0,1:37:23.37,1:37:24.71,Default,,0,0,0,,Мен мұны дұрыс орындауым керек! ‬
Dialogue: 0,1:37:24.79,1:37:26.04,Default,,0,0,0,,Міне кеттік! ‬
Dialogue: 0,1:37:26.13,1:37:28.84,Default,,0,0,0,,Бұл болды~ Эххе
Dialogue: 0,1:37:28.92,1:37:30.55,Default,,0,0,0,,Ой, бұл не?
Dialogue: 0,1:37:30.63,1:37:32.88,Default,,0,0,0,,Бұл қатты ауырды, хехе
Dialogue: 0,1:37:32.97,1:37:34.47,Default,,0,0,0,,Ендеше неге күлесің?
Dialogue: 0,1:37:34.55,1:37:35.72,Default,,0,0,0,,Жоқ, сондықтан
Dialogue: 0,1:37:36.30,1:37:38.47,Default,,0,0,0,,Бұл қатты ауырды.
Dialogue: 0,1:37:40.02,1:37:41.23,Default,,0,0,0,,Иә.
Dialogue: 0,1:37:41.68,1:37:42.85,Default,,0,0,0,,I
Dialogue: 0,1:37:44.40,1:37:46.06,Default,,0,0,0,,Ол батыр болды.
Dialogue: 0,1:37:47.56,1:37:53.56,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
