Dialogue: 0,0:02:06.98,0:02:11.98,720,title,0,0,0,,Қайғылы актер
Dialogue: 0,0:19:30.13,0:19:31.60,720,gan,0,0,0,,:
Dialogue: 0,0:05:18.61,0:05:22.12,720,man,0,0,0,,Баказуки: Маджонг терминологиясы, ниет - әрекет,сәттілік.
Dialogue: 0,0:00:03.22,0:00:04.38,720,fio,0,0,0,,Рональд
Dialogue: 0,0:00:05.20,0:00:07.65,720,fio,0,0,0,,Менің ағамды отбасына қайтаруыңызды өтінемін.
Dialogue: 0,0:00:11.40,0:00:13.88,720,ron,0,0,0,,Нерон Галассияға ант берсе
Dialogue: 0,0:00:13.88,0:00:15.80,720,ron,0,0,0,,Мен сенің өміріңді аяймын.
Dialogue: 0,0:00:15.80,0:00:20.32,720,ron,0,0,0,,Бірақ келесі дон - Фрейт,ақырында...
Dialogue: 0,0:00:21.44,0:00:24.90,720,fio,0,0,0,,Мен енді отбасылық ұрысты көргім келмейді.
Dialogue: 0,0:00:25.93,0:00:26.98,720,fio,0,0,0,,(Элис) Иә,ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:00:28.53,0:00:30.86,720,ron,0,0,0,,Барлығы Неронға байланысты
Dialogue: 0,0:00:30.86,0:00:33.16,720,ron,0,0,0,,Тізерлеп отырса
Dialogue: 0,0:02:12.18,0:02:17.04,720,fan,0,0,0,,Сүйекті сығу үшін лимонды 30 секундқа айналдырыңыз.
Dialogue: 0,0:02:17.04,0:02:19.36,720,fan,0,0,0,,Оған біраз күш салыңыз
Dialogue: 0,0:02:19.56,0:02:22.10,720,fan,0,0,0,,Бұл ащылықты азайтады.
Dialogue: 0,0:02:22.36,0:02:24.02,720,fan,0,0,0,,Бұл тамаша
Dialogue: 0,0:02:24.89,0:02:26.91,720,fan,0,0,0,,Өтінемін,жеп қойыңыз.
Dialogue: 0,0:02:26.91,0:02:29.99,720,fan,0,0,0,,Мен бүгін саған қамқор болғым келеді.
Dialogue: 0,0:02:29.99,0:02:31.96,720,nero,0,0,0,,Оны қабылдаңыз.
Dialogue: 0,0:02:32.17,0:02:34.96,720,fan,0,0,0,,Мен шынымен ризамын.
Dialogue: 0,0:02:34.96,0:02:38.13,720,fan,0,0,0,,Оркоға қамқор бола білдің.
Dialogue: 0,0:02:38.30,0:02:40.99,720,fan,0,0,0,,Сізге рахмет,мен қазір
Dialogue: 0,0:02:42.01,0:02:43.64,720,fan,0,0,0,,Король
Dialogue: 0,0:02:44.06,0:02:46.11,720,nero,0,0,0,,Дәмі бұзылмаған.
Dialogue: 0,0:02:48.50,0:02:50.80,720,lac,0,0,0,,Нене Ойланып қарасам,білемін.
Dialogue: 0,0:02:50.95,0:02:55.43,720,lac,0,0,0,,Бұл ірімшік Италияның оңтүстігіндегі Пуглиядан әкелінді.
Dialogue: 0,0:02:55.70,0:02:58.81,720,lac,0,0,0,,Сіз мұны Италияның етегінде білдіңіз бе?
Dialogue: 0,0:02:58.81,0:03:02.23,720,lac,0,0,0,,Демек,ол Рудольф Валентиномен туысқан.
Dialogue: 0,0:03:03.58,0:03:05.58,720,lac,0,0,0,,Көзге ұқсастық жоқ.
Dialogue: 0,0:03:05.58,0:03:08.98,720,lac,0,0,0,,Бұл кісінің анасы да мөлдір Адриатика теңізіндей.
Dialogue: 0,0:03:08.98,0:03:10.82,720,lac,0,0,0,,өте таза
Dialogue: 0,0:03:13.79,0:03:16.42,720,fan,0,0,0,,Содан кейін Банетти отбасы бар.
Dialogue: 0,0:03:17.17,0:03:20.96,720,fan,0,0,0,,Біз өмір сүргенше доспыз.
Dialogue: 0,0:03:22.25,0:03:24.80,720,nero,0,0,0,,Егер мен мұны айтсам,бұл менің бөлмедегі досым болар еді.
Dialogue: 0,0:03:24.80,0:03:26.68,720,nero,0,0,0,,Бөлме жалға алынғанша
Dialogue: 0,0:03:27.57,0:03:29.65,720,fan,0,0,0,,Кез келген жағдайда...
Dialogue: 0,0:03:28.85,0:03:31.83,720,lac,0,0,0,,Барынша жабайы болыңыз
Dialogue: 0,0:03:31.83,0:03:33.06,720,lac,0,0,0,,Сіз оны асыға күтесіз бе?
Dialogue: 0,0:03:34.02,0:03:36.94,720,nero,0,0,0,,Жарайды,мен сенің үмітіңді ақтауым керек.
Dialogue: 0,0:03:40.30,0:03:42.33,720,fan,0,0,0,,Енді ішуге бола ма?
Dialogue: 0,0:03:42.56,0:03:44.24,720,nero,0,0,0,,А,жеткілікті.
Dialogue: 0,0:03:45.14,0:03:49.59,720,fan,0,0,0,,Дұрыс,балалар сендерде ішімдік көп.
Dialogue: 0,0:03:50.91,0:03:54.06,720,lac,0,0,0,,Эй,келесі жолы ішіп алайыншы.
Dialogue: 0,0:03:59.34,0:04:01.05,720,nero,0,0,0,,Фанго бейбақ
Dialogue: 0,0:04:01.05,0:04:04.13,720,nero,0,0,0,,Ол бізді жек көреді,өйткені ол бізді толығымен пайдаланғысы келеді.
Dialogue: 0,0:04:04.62,0:04:07.02,720,av,0,0,0,,Бұлай жалғаса берсе,заңсыз аспан да жойылады.
Dialogue: 0,0:04:07.60,0:04:09.74,720,av,0,0,0,,Жұмысты аяқтағаннан кейін...
Dialogue: 0,0:04:14.83,0:04:16.28,720,nero,0,0,0,,Сіз не істер едіңіз?
Dialogue: 0,0:04:16.94,0:04:21.51,720,av,0,0,0,,Соңында жалғыз демалыс орны - Ванетти отбасы.
Dialogue: 0,0:04:22.25,0:04:24.46,720,av,0,0,0,,Мәселе Фрейт пен Рональд.
Dialogue: 0,0:04:30.40,0:04:31.84,720,ron,0,0,0,,Соңына дейін баруға тура келеді,білесің бе.
Dialogue: 0,0:04:32.19,0:04:34.75,720,ron,0,0,0,,Әй,Цезарь не болды?
Dialogue: 0,0:04:35.58,0:04:38.41,720,ron,0,0,0,,Сен сүйекті лақтырғанда батыл болдың.
Dialogue: 0,0:04:38.71,0:04:40.55,720,ron,0,0,0,,Қазір өкінесің бе?
Dialogue: 0,0:04:42.91,0:04:47.00,720,ron,0,0,0,,Фрат,сенде Неронда жоқ жақсы нәрсе бар.
Dialogue: 0,0:04:47.47,0:04:48.39,720,fra,0,0,0,,Шиганьшинаға апаратын жолды іздеуге аттанған Зерттеу корпусы
Dialogue: 0,0:04:48.76,0:04:50.76,720,ron,0,0,0,,Адал немере ағасы
Dialogue: 0,0:04:51.31,0:04:53.56,720,ron,0,0,0,,Бұл маған ұнады.
Dialogue: 0,0:04:54.65,0:04:57.98,720,ron,0,0,0,,Отбасыңның қамын ойлайтын сенсің.
Dialogue: 0,0:04:58.39,0:05:00.50,720,ron,0,0,0,,Содан кейін Неронды ойнаңыз.
Dialogue: 0,0:05:01.17,0:05:04.02,720,ron,0,0,0,,Отбасыңызды тек сіз ғана сақтай аласыз.
Dialogue: 0,0:05:06.02,0:05:08.86,720,ron,0,0,0,,Осыны ішіп,демалыңыз.
Dialogue: 0,0:05:16.04,0:05:17.94,720,man,0,0,0,,Маған заңсыз аспан беріңіз
Dialogue: 0,0:05:18.61,0:05:22.12,720,man,0,0,0,,Мен бүгін ақымақтық жасадым,сондықтан маған бөтелке беріңіз.
Dialogue: 0,0:05:22.33,0:05:25.26,720,bar,0,0,0,,Сол спиртті ішкіңіз келсе,Фангоға барыңыз.
Dialogue: 0,0:05:25.86,0:05:26.98,720,man,0,0,0,,Бұл керісінше болар еді.
Dialogue: 0,0:05:26.98,0:05:30.22,720,man,0,0,0,,Менің ойымша,бұл тек Банеттидің дүкенінде сатылады...
Dialogue: 0,0:05:36.79,0:05:38.88,720,nero,0,0,0,,Біраз уақытқа
Dialogue: 0,0:05:38.88,0:05:41.36,720,nero,0,0,0,,Сіз оны Фангоннан сатып ала аласыз ба?
Dialogue: 0,0:05:41.62,0:05:43.29,720,nero,0,0,0,,Оны жаман көрсетпе
Dialogue: 0,0:05:46.66,0:05:50.02,720,bar,0,0,0,,Жарайды,мен саған біреуін беремін.
Dialogue: 0,0:05:50.89,0:05:53.77,720,nero,0,0,0,,Олай етпесең,мен саған ризамын.
Dialogue: 0,0:05:54.33,0:05:55.91,720,gan,0,0,0,,Келесі шайқас!
Dialogue: 0,0:05:56.25,0:05:58.62,720,gan,0,0,0,,Жолақтарды рұқсатсыз жоймаңыз
Dialogue: 0,0:05:58.90,0:06:01.30,720,vol,0,0,0,,Мен сенімен араласқым келмейді.
Dialogue: 0,0:06:01.30,0:06:03.58,720,vol,0,0,0,,Артқа бұрылып,дереу үйге қайт.
Dialogue: 0,0:06:07.87,0:06:10.15,720,nero,0,0,0,,Ганцоның ағасы
Dialogue: 0,0:06:10.38,0:06:12.38,720,gan,0,0,0,,Фангоның тағамы дәмді ме?
Dialogue: 0,0:06:13.85,0:06:16.98,720,nero,0,0,0,,Әрине,бұл жай ғана тамақ болуы мүмкін емес.
Dialogue: 0,0:06:17.94,0:06:19.54,720,gan,0,0,0,,Маған сәл бет бұрыңыз
Dialogue: 0,0:06:24.69,0:06:27.00,720,gan,0,0,0,,Қайтып кел,Нерон.
Dialogue: 0,0:06:27.33,0:06:29.54,720,gan,0,0,0,,Бұл жай ғана ағайын-туыстың ұрысы.
Dialogue: 0,0:06:29.54,0:06:31.70,720,gan,0,0,0,,Мен сөйлесемін.
Dialogue: 0,0:06:33.62,0:06:37.46,720,gan,0,0,0,,Мен саған және Фрейтке әйелдер туралы үйреттім.
Dialogue: 0,0:06:38.21,0:06:40.87,720,gan,0,0,0,,Мен оны толыққанды адам еттім.
Dialogue: 0,0:06:41.17,0:06:43.17,720,gan,0,0,0,,Тыңда және тыңда
Dialogue: 0,0:06:44.92,0:06:46.64,720,nero,0,0,0,,Бұл қорқынышты болды
Dialogue: 0,0:06:47.31,0:06:50.65,720,gan,0,0,0,,Сіздің отбасыңызда сізді жақсы көретін адамдар көп.
Dialogue: 0,0:06:51.02,0:06:52.38,720,nero,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:06:52.38,0:06:55.59,720,gan,0,0,0,,Рас,әркім ақша жұмсағысы келеді.
Dialogue: 0,0:06:56.14,0:06:56.88,720,nero,0,0,0,,Таку
Dialogue: 0,0:06:57.63,0:06:59.74,720,nero,0,0,0,,Мен ағаммен тең емеспін.
Dialogue: 0,0:07:02.45,0:07:04.10,720,fra,0,0,0,,Міне.
Dialogue: 0,0:07:04.42,0:07:06.46,720,fra,0,0,0,,Бухгалтер не істеді?
Dialogue: 0,0:07:06.83,0:07:09.29,720,fra,0,0,0,,Көтеру үш ай бұрынғы көрсеткіштің жартысы.
Dialogue: 0,0:07:09.73,0:07:12.23,720,gan,0,0,0,,Нерон самогонды алды.
Dialogue: 0,0:07:12.23,0:07:13.98,720,gan,0,0,0,,Ботлегтермен қалай ақша табуға болады...
Dialogue: 0,0:07:13.98,0:07:15.74,720,ron,0,0,0,,Бұл алаңсыз.
Dialogue: 0,0:07:16.21,0:07:17.52,720,gan,0,0,0,,Тіпті қазір де жағдай осылай,...
Dialogue: 0,0:07:17.73,0:07:21.74,720,ron,0,0,0,,Сіз кездескеннен кейін де Нерон менің үйімді бүлдіріп жатыр.
Dialogue: 0,0:07:22.48,0:07:26.04,720,ron,0,0,0,,Бұлай жалғаса берсе,Фанго мен Нерон сені талқандайды.
Dialogue: 0,0:07:27.63,0:07:30.76,720,fra,0,0,0,,Енді ағаммен өмір не өлім.
Dialogue: 0,0:07:31.07,0:07:35.14,720,gan,0,0,0,,Сіз бұл сызықты Винсенттің алдында айта аласыз ба?
Dialogue: 0,0:07:38.52,0:07:41.72,720,ron,0,0,0,,Осы тұста анық айтайын.
Dialogue: 0,0:07:42.98,0:07:45.46,720,ron,0,0,0,,Нерон – отбасының жауы
Dialogue: 0,0:07:45.46,0:07:50.58,720,ron,0,0,0,,Дон Галассия да Фрейт оның мұрагері болады деп үміттенеді.
Dialogue: 0,0:07:54.30,0:07:56.23,720,nero,0,0,0,,Фанго қалай қозғалады?
Dialogue: 0,0:07:56.63,0:07:59.60,720,av,0,0,0,,Лотчтың орналасқан жері әлдеқашан белгілі.
Dialogue: 0,0:07:59.60,0:08:00.58,720,nero,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:08:00.58,0:08:04.16,720,nero,0,0,0,,Ликер рецепті болмаса,бұл жай ғана үлкен бу моншасы.
Dialogue: 0,0:08:04.53,0:08:07.38,720,nero,0,0,0,,Мен Кортео үшін алаңдаймын.
Dialogue: 0,0:08:07.84,0:08:10.68,720,av,0,0,0,,Жарайды,Барберо менімен бірге.
Dialogue: 0,0:08:36.06,0:08:37.52,720,fio,0,0,0,,Пияз сорпасы.
Dialogue: 0,0:08:39.64,0:08:42.73,720,nero,0,0,0,,Коннидің анасы мұны көп жасады деп ойлаймын.
Dialogue: 0,0:08:46.03,0:08:49.40,720,fio,0,0,0,,Мен бұрынғыдай бола алмаймын
Dialogue: 0,0:08:49.40,0:08:52.83,720,nero,0,0,0,,Отбасымды қорғау үшін әкеме қолдау көрсеттім.
Dialogue: 0,0:08:53.32,0:08:55.42,720,nero,0,0,0,,Мен мұны жалғастырамын.
Dialogue: 0,0:08:55.42,0:08:56.72,720,fra,0,0,0,,Мүмкін емес.
Dialogue: 0,0:08:57.11,0:08:58.86,720,fra,0,0,0,,Сіздің ағаңыз не ойлайды?
Dialogue: 0,0:08:58.86,0:09:01.17,720,fra,0,0,0,,Мұның бәрі жіңішке мақтаныш туралы.
Dialogue: 0,0:09:01.76,0:09:03.42,720,nero,0,0,0,,Намысты жоғалтқанда
Dialogue: 0,0:09:03.42,0:09:06.02,720,nero,0,0,0,,Енді отбасын қорғаудың мәні болмас еді.
Dialogue: 0,0:09:06.02,0:09:09.11,720,fra,0,0,0,,Егер сіз Галассияға қарсы шықсаңыз,сіздің отбасыңыз жойылады.
Dialogue: 0,0:09:09.13,0:09:10.96,720,fra,0,0,0,,Менің бұрынғы жігітім де,балаларым да жоқ.
Dialogue: 0,0:09:11.36,0:09:14.56,720,nero,0,0,0,,Галассия Ванеттиді жұтып қоюға ниетті.
Dialogue: 0,0:09:14.89,0:09:16.58,720,nero,0,0,0,,Бізде күресуден басқа амал жоқ.
Dialogue: 0,0:09:16.89,0:09:18.69,720,nero,0,0,0,,Неге түсінбейсің?
Dialogue: 0,0:09:18.69,0:09:23.10,720,fra,0,0,0,,Бұған жол бермеу үшін әпкем Рональдқа үйленді.
Dialogue: 0,0:09:23.10,0:09:25.24,720,fra,0,0,0,,Бірақ менің інім тым шатасыпты...
Dialogue: 0,0:09:25.24,0:09:28.07,720,nero,0,0,0,,Сен Рональдтың қуыршағысың.
Dialogue: 0,0:09:31.50,0:09:34.13,720,fra,0,0,0,,Әрқашан әрқашан әрқашан...
Dialogue: 0,0:09:34.80,0:09:38.34,720,fra,0,0,0,,Кішкентай кезінен ол тек қалағанын ғана орындады.
Dialogue: 0,0:09:39.48,0:09:41.76,720,fra,0,0,0,,Жексенбілік қызметке де бармаңыз
Dialogue: 0,0:09:41.76,0:09:43.74,720,fra,0,0,0,,Мен өзіме ұнағандай ойнадым.
Dialogue: 0,0:09:45.61,0:09:48.06,720,nero,0,0,0,,Шақырсам да келмедің.
Dialogue: 0,0:09:48.43,0:09:50.51,720,nero,0,0,0,,Мен әкемнен үнемі қорқатынмын.
Dialogue: 0,0:09:51.10,0:09:54.93,720,fra,0,0,0,,Ағам маған үнемі менсінбей қарайтын.
Dialogue: 0,0:09:56.28,0:09:58.17,720,nero,0,0,0,,Бірақ Рональд басқа.
Dialogue: 0,0:09:59.22,0:10:00.86,720,fra,0,0,0,,Ол мені таниды.
Dialogue: 0,0:10:01.08,0:10:03.83,720,nero,0,0,0,,Билік мойындауға тұрарлық нәрсе емес.
Dialogue: 0,0:10:03.83,0:10:05.33,720,nero,0,0,0,,Өзіңіз көрсетіңіз
Dialogue: 0,0:10:06.21,0:10:08.13,720,fra,0,0,0,,Олай айтпа.
Dialogue: 0,0:10:08.47,0:10:09.90,720,fra,0,0,0,,Менің өзімшілдігімде
Dialogue: 0,0:10:09.90,0:10:11.79,720,fra,0,0,0,,Отбасымен араласқаннан кейін
Dialogue: 0,0:10:12.10,0:10:14.91,720,fra,0,0,0,,Сен өлсең,отбасы бұрынғы қалпына келеді.
Dialogue: 0,0:10:20.46,0:10:21.69,720,fio,0,0,0,,Сабыр етіңіз
Dialogue: 0,0:10:22.64,0:10:25.77,720,fio,0,0,0,,Бауырым,Рональдпен сөйлес.
Dialogue: 0,0:10:26.30,0:10:30.76,720,fio,0,0,0,,Мүмкін бұл қаланы Галассия алып кетуі мүмкін.
Dialogue: 0,0:10:31.25,0:10:34.45,720,fio,0,0,0,,Бірақ отбасы қалпына келеді.
Dialogue: 0,0:10:35.91,0:10:38.16,720,fio,0,0,0,,Екеуің де бірдейсіңдер
Dialogue: 0,0:10:39.69,0:10:42.21,720,fio,0,0,0,,Балалар,сендер айтып отырған «отбасы» дегеніміз не?
Dialogue: 0,0:10:42.70,0:10:44.66,720,fio,0,0,0,,Ағайындылардың бірін-бірі өлтіруі
Dialogue: 0,0:10:44.66,0:10:46.41,720,fio,0,0,0,,Отбасы дегеніміз не?
Dialogue: 0,0:10:47.05,0:10:49.14,720,fio,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:10:49.88,0:10:54.36,720,fio,0,0,0,,Бауырлар мен отбасы мүшелері бір-бірін өлтіруді доғарсын.
Dialogue: 0,0:10:55.41,0:10:56.70,720,fio,0,0,0,,Мүлдем
Dialogue: 0,0:11:02.51,0:11:04.30,720,nero,0,0,0,,Күн суып барады.
Dialogue: 0,0:11:12.40,0:11:14.50,720,nero,0,0,0,,Рональдпен сөйлесу
Dialogue: 0,0:11:14.89,0:11:17.93,720,av,0,0,0,,Ұзақ уақыттан кейін кездесу сізді жақындастыра алды ма?
Dialogue: 0,0:11:19.31,0:11:21.47,720,av,0,0,0,,Арзан сентиментализмнен бас тарт
Dialogue: 0,0:11:21.47,0:11:24.12,720,av,0,0,0,,Фрейт – бұл не өлетін іс.
Dialogue: 0,0:11:24.67,0:11:27.07,720,nero,0,0,0,,Ол менің қандас ағам.
Dialogue: 0,0:11:27.85,0:11:30.49,720,nero,0,0,0,,Отбасы отбасынан маңыздырақ.
Dialogue: 0,0:11:31.69,0:11:34.03,720,av,0,0,0,,Менің де інім бар еді.
Dialogue: 0,0:11:35.33,0:11:37.51,720,av,0,0,0,,Мен оны уақытында реттеймін.
Dialogue: 0,0:11:42.00,0:11:44.55,720,av,0,0,0,,Бұлай жалғаса берсе,Нерон өледі.
Dialogue: 0,0:11:44.89,0:11:46.49,720,vol,0,0,0,,(Баяндау) Бір күні адамсыз жүзуші кеме табылды.
Dialogue: 0,0:11:47.02,0:11:50.37,720,av,0,0,0,,Нерон Рональдпен сөйлесетінін айтады.
Dialogue: 0,0:11:50.37,0:11:53.31,720,av,0,0,0,,Бірақ бұл енді олай емес.
Dialogue: 0,0:11:54.20,0:11:57.92,720,av,0,0,0,,Қызық,сіз бұрын Неронға Ванеттидің үйінде көмектескенсіз бе?
Dialogue: 0,0:12:00.10,0:12:01.99,720,av,0,0,0,,Маған тағы да күш-қуатыңызды беріңізші.
Dialogue: 0,0:12:03.32,0:12:05.90,720,vol,0,0,0,,Мен Нерон үшін бәрін жасаймын
Dialogue: 0,0:12:07.90,0:12:10.40,720,av,0,0,0,,Ертең жексенбі.
Dialogue: 0,0:12:19.47,0:12:21.79,720,ron,0,0,0,,Апта сайын жасалатын сыпайы іс.
Dialogue: 0,0:12:22.69,0:12:25.24,720,fra,0,0,0,,Мен сені менімен бірге шығуды ешқашан сұраған емеспін.
Dialogue: 0,0:12:27.70,0:12:29.57,720,ron,0,0,0,,Нерон маған хабарласты.
Dialogue: 0,0:12:30.73,0:12:32.80,720,ron,0,0,0,,Келесі аптадағы қызметтен кейін
Dialogue: 0,0:12:32.80,0:12:35.10,720,ron,0,0,0,,Біз осы сарайда кездесетін сияқтымыз.
Dialogue: 0,0:12:36.49,0:12:39.88,720,ron,0,0,0,,Банетти отбасы енді сіздікі.
Dialogue: 0,0:13:02.22,0:13:03.90,720,ron,0,0,0,,Ақымақ
Dialogue: 0,0:13:09.92,0:13:12.47,720,vol,0,0,0,,Қарғыс атсын,мен оны ағыздым.
Dialogue: 0,0:13:12.82,0:13:13.72,720,av,0,0,0,,Жара
Dialogue: 0,0:13:14.22,0:13:15.93,720,vol,0,0,0,,Тигрдің саған күлуіне жол берме
Dialogue: 0,0:13:16.32,0:13:18.62,720,av,0,0,0,,Мен қанды бір жерден тоқтатуым керек.
Dialogue: 0,0:13:26.44,0:13:28.65,720,vol,0,0,0,,Қан тоқтамайды
Dialogue: 0,0:13:28.65,0:13:31.29,720,vol,0,0,0,,Нерон осылай деді...
Dialogue: 0,0:13:35.72,0:13:38.09,720,av,0,0,0,,Неронды жайына қалдырыңыз.
Dialogue: 0,0:13:43.14,0:13:44.51,720,fra,0,0,0,,Volpe.
Dialogue: 0,0:13:45.96,0:13:49.27,720,gan,0,0,0,,Тыныштал,Нерон мұны істейді...
Dialogue: 0,0:13:49.27,0:13:50.47,720,fra,0,0,0,,Блоктамаңыз
Dialogue: 0,0:13:50.70,0:13:52.93,720,fra,0,0,0,,Өліп қала жаздадық.
Dialogue: 0,0:13:53.77,0:13:55.81,720,fra,0,0,0,,Рональдтың айтуы бойынша...
Dialogue: 0,0:13:59.31,0:14:02.58,720,fra,0,0,0,,Егер бұл орын алса, оны не істейсіз,не соққы аласыз.
Dialogue: 0,0:14:42.28,0:14:45.63,720,fra,0,0,0,,Мен енді бұлай өмір сүргім келмейді.
Dialogue: 0,0:14:46.45,0:14:47.76,720,fra,0,0,0,,Қай уақытқа дейін...
Dialogue: 0,0:14:47.76,0:14:49.51,720,ron,0,0,0,,Тек арандатушылық
Dialogue: 0,0:14:49.94,0:14:52.49,720,ron,0,0,0,,Дон Ванетти де осы сарайда.
Dialogue: 0,0:14:52.72,0:14:54.33,720,ron,0,0,0,,Көп нәрсені істей алмаймын
Dialogue: 0,0:14:54.98,0:14:56.42,720,fra,0,0,0,,Қаладан шығайық
Dialogue: 0,0:14:56.69,0:14:58.62,720,fra,0,0,0,,Чикагодағы Галасияның орнында.
Dialogue: 0,0:14:58.62,0:15:00.22,720,ron,0,0,0,,Көңілсіз болмаңыз
Dialogue: 0,0:15:06.67,0:15:08.37,720,ron,0,0,0,,Мен бұл туралы бірдеңе істеймін.
Dialogue: 0,0:15:09.11,0:15:11.06,720,ron,0,0,0,,Енді біраз демалыңыз
Dialogue: 0,0:15:19.81,0:15:20.56,720,fra,0,0,0,,Бұл құрамадағы ең қауіпсіз орын
Dialogue: 0,0:15:31.90,0:15:33.65,720,ron,0,0,0,,Мен Неронмен сөйлескім келеді.
Dialogue: 0,0:15:34.69,0:15:36.86,720,ron,0,0,0,,Менің ойымша,бұл сіз қалаған нәрсе.
Dialogue: 0,0:15:37.21,0:15:38.63,720,ron,0,0,0,,Тілектеріңді тыңдаймын
Dialogue: 0,0:15:39.08,0:15:40.70,720,fio,0,0,0,,Қазір шынымен солай ма?
Dialogue: 0,0:15:41.38,0:15:45.13,720,ron,0,0,0,,Бұлай жалғаса берсе,Фрейт Нероннан жеңіледі.
Dialogue: 0,0:15:45.13,0:15:47.62,720,ron,0,0,0,,Отбасын Галассия талқандады.
Dialogue: 0,0:15:48.40,0:15:49.99,720,ron,0,0,0,,Неронның да өмірі
Dialogue: 0,0:15:50.44,0:15:53.98,720,ron,0,0,0,,Мен де,балаң да.
Dialogue: 0,0:15:56.46,0:15:58.81,720,ron,0,0,0,,Бірақ мен сені құтқара аламын.
Dialogue: 0,0:15:59.18,0:16:02.03,720,ron,0,0,0,,Нерон,Фрейт және отбасы
Dialogue: 0,0:16:03.18,0:16:05.82,720,ron,0,0,0,,Менің ойымша,сіз әлі балалар туралы сөйлескен жоқсыз.
Dialogue: 0,0:16:06.50,0:16:08.10,720,ron,0,0,0,,Неронға айтыңыз
Dialogue: 0,0:16:08.65,0:16:10.76,720,ron,0,0,0,,Бұл бала – үміт.
Dialogue: 0,0:16:11.27,0:16:14.85,720,ron,0,0,0,,Галассия мен Ванетти арасындағы татуласу символы
Dialogue: 0,0:16:15.82,0:16:20.00,720,ron,0,0,0,,Бұл бала бәрін өз орнына қояды.
Dialogue: 0,0:16:33.05,0:16:35.53,720,fan,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:16:35.53,0:16:39.76,720,fan,0,0,0,,Өйткені,сіз Ванеттидің донына айналатын адамсыз.
Dialogue: 0,0:16:40.12,0:16:42.22,720,fan,0,0,0,,Қолымнан келгенше ынтымақтасамын.
Dialogue: 0,0:16:45.52,0:16:49.49,720,fan,0,0,0,,Керемет әрлеу
Dialogue: 0,0:16:51.35,0:16:53.73,720,nero,0,0,0,,Қанша адам қаза тапты?
Dialogue: 0,0:16:54.08,0:16:55.81,720,nero,0,0,0,,Сіз қанша адамды өлтірдіңіз?
Dialogue: 0,0:16:56.33,0:16:58.88,720,nero,0,0,0,,Бастапқыда бір отбасынан
Dialogue: 0,0:16:59.79,0:17:00.78,720,tig,0,0,0,,Нерон
Dialogue: 0,0:17:02.18,0:17:04.36,720,tig,0,0,0,,Бұл Фиодан келген телефон қоңырауы.
Dialogue: 0,0:17:04.73,0:17:05.64,720,nero,0,0,0,,Fio?
Dialogue: 0,0:17:12.93,0:17:15.54,720,fio,0,0,0,,Бауырым,мен сенімен сөйлесуім керек.
Dialogue: 0,0:17:26.19,0:17:27.14,720,ron,0,0,0,,Не?
Dialogue: 0,0:17:27.42,0:17:30.69,720,gan,0,0,0,,Неронның хабаршысы келді. Мен оған рұқсат бере аламын ба?
Dialogue: 0,0:17:31.00,0:17:32.10,720,ron,0,0,0,,Денені тексеру
Dialogue: 0,0:17:32.42,0:17:33.55,720,gan,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:17:39.22,0:17:41.21,720,av,0,0,0,,Нероннан Фио мырзаға дейін
Dialogue: 0,0:17:42.93,0:17:44.31,720,fio,0,0,0,,Менің ағам
Dialogue: 0,0:17:44.31,0:17:46.27,720,av,0,0,0,,Кішкене кідіріс болатын сияқты.
Dialogue: 0,0:17:46.27,0:17:47.23,720,fio,0,0,0,,Иә
Dialogue: 0,0:17:47.85,0:17:49.97,720,ron,0,0,0,,Ол шынымен келе жатыр деп ойлаймын.
Dialogue: 0,0:17:49.97,0:17:50.95,720,av,0,0,0,,Әрине
Dialogue: 0,0:17:51.27,0:17:53.93,720,av,0,0,0,,Кешігіп келсем де,бір сағаттай ғана қалды.
Dialogue: 0,0:17:55.00,0:17:57.59,720,ron,0,0,0,,Осы кезде мен ашық пікірлескім келеді.
Dialogue: 0,0:17:57.59,0:18:00.71,720,ron,0,0,0,,Мен,Нерон және Фио
Dialogue: 0,0:18:00.71,0:18:03.47,720,av,0,0,0,,Иә,Нерон да солай істемекші.
Dialogue: 0,0:18:03.47,0:18:04.24,720,av,0,0,0,,Сонымен
Dialogue: 0,0:18:22.14,0:18:23.83,720,ron,0,0,0,,Сақтық шарасы ретінде.
Dialogue: 0,0:18:25.32,0:18:26.62,720,ron,0,0,0,,Зенитсу неге қылышын шешпей жатқанын түсінбейсің бе?
Dialogue: 0,0:18:27.12,0:18:28.83,720,ron,0,0,0,,Жақсы болатынына сенімдімін.
Dialogue: 0,0:18:29.64,0:18:31.88,720,fio,0,0,0,,Сен ағаңды өлтірмексің бе?
Dialogue: 0,0:18:35.23,0:18:38.41,720,ron,0,0,0,,Ванеттиде Галасияның қуыршағына айналудан басқа амал жоқ.
Dialogue: 0,0:18:38.81,0:18:40.88,720,ron,0,0,0,,Фрейт мұны біледі.
Dialogue: 0,0:18:41.56,0:18:43.16,720,ron,0,0,0,,Бірақ Нерон
Dialogue: 0,0:18:45.47,0:18:48.37,720,ron,0,0,0,,Уайымдама,жақын арада...
Dialogue: 0,0:19:07.77,0:19:09.38,720,ron,0,0,0,,Fio...
Dialogue: 0,0:19:09.38,0:19:10.62,720,fio,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:10.62,0:19:12.73,720,ron,0,0,0,,Ванетти...
Dialogue: 0,0:19:12.73,0:19:18.01,720,fio,0,0,0,,Бұл Фрейт пен оның отбасын қорғаудың жалғыз жолы.
Dialogue: 0,0:19:18.01,0:19:19.28,720,ron,0,0,0,,Қарғыс атқан...
Dialogue: 0,0:19:30.13,0:19:31.60,720,gan,0,0,0,,Боуна Нот
Dialogue: 0,0:19:51.46,0:19:53.12,720,nero,0,0,0,,Не болды,Фрейт?
Dialogue: 0,0:19:53.12,0:19:54.65,720,nero,0,0,0,,Сіз бозарған сияқтысыз.
Dialogue: 0,0:19:55.89,0:19:58.09,720,nero,0,0,0,,Ол жерде қанша уақытқа дейін қамауда отырасыз?
Dialogue: 0,0:19:58.42,0:20:00.09,720,nero,0,0,0,,Бәрі бітті
Dialogue: 0,0:20:00.45,0:20:02.75,720,nero,0,0,0,,Біраз уақыт ел ауасымен дем ал.
Dialogue: 0,0:20:03.66,0:20:07.71,720,fra,0,0,0,,Мен бұл үйге енді қайтып келмейтін шығармын.
Dialogue: 0,0:20:10.49,0:20:13.44,720,fra,0,0,0,,Мен ешқашан намазды қалдырған емеспін.
Dialogue: 0,0:20:14.42,0:20:17.41,720,fra,0,0,0,,Ағам үнемі өз ісімен айналысатын.
Dialogue: 0,0:20:18.51,0:20:22.23,720,fra,0,0,0,,Бірақ әкем жақсы көретін ағам болатын.
Dialogue: 0,0:20:22.80,0:20:26.08,720,fra,0,0,0,,Мен ағамды үнемі қызғанатынмын.
Dialogue: 0,0:20:26.79,0:20:28.91,720,fra,0,0,0,,Әкем бекіткен
Dialogue: 0,0:20:29.77,0:20:31.91,720,nero,0,0,0,,Әкем сені жақсы көретін
Dialogue: 0,0:20:32.61,0:20:36.88,720,fra,0,0,0,,Сүйікті болғым келеді,Қабыл алғым келеді.
Dialogue: 0,0:21:00.08,0:21:01.99,720,av,0,0,0,,Бұл ыңғайсыздық.
Dialogue: 0,0:21:02.51,0:21:07.28,720,av,0,0,0,,Бауырларыңыздың жанжалына қанша адам араласты деп ойлаймын.
Dialogue: 0,0:21:09.42,0:21:12.20,720,av,0,0,0,,Жетеді,неге оны аяқтамайсың?
Dialogue: 0,0:21:23.41,0:21:28.56,720,fra,0,0,0,,Мен қорқамын...Өзім көрсетемін
Dialogue: 0,0:21:29.43,0:21:31.64,720,nero,0,0,0,,Оны тоқтатыңыз
Dialogue: 0,0:21:34.76,0:21:37.28,720,ron,0,0,0,,Жасай бер,Фрат.
Dialogue: 0,0:22:12.61,0:22:15.23,720,av,0,0,0,,Рональдты өлтірген Фрейт болды.
Dialogue: 0,0:22:15.61,0:22:19.90,720,av,0,0,0,,Сонымен Нерон өзінің інісін Галассияға адалдығын көрсету үшін алды.
Dialogue: 0,0:22:19.90,0:22:21.94,720,av,0,0,0,,Ол ағасының қолынан ұстады.
Dialogue: 0,0:24:06.21,0:24:07.20,720,av,0,0,0,,Нерон
Dialogue: 0,0:24:08.02,0:24:10.16,720,av,0,0,0,,Бүгіннен бастап мен сенің ағаңмын.
Dialogue: 0,0:24:11.66,0:24:17.66,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
