Dialogue: 0,0:01:20.97,0:01:25.98,720,,0,0,0,,1-күн Кісі өлтіру түні
Dialogue: 0,0:16:45.81,0:16:49.69,720,,0,0,0,,Ваннадағы гин: Америкада тыйым салынған кезеңде заңсыз нарықта заңсыз алкогольге сұраныс көп болды.
Dialogue: 0,0:00:30.00,0:00:35.00,,,0,0,0,,Түпнұсқа субтитрлер ✿ Гүл тілі және Чинатсу субтитр тобы ✿ Бірлескен туынды
Dialogue: 0,0:00:06.36,0:00:09.11,720,,0,0,0,,Шынында да жаңбыр көп жауады.
Dialogue: 0,0:00:09.72,0:00:12.86,720,,0,0,0,,Менің кірлерім кептірілмейді.
Dialogue: 0,0:00:15.30,0:00:16.74,720,,0,0,0,,Бруно мырза
Dialogue: 0,0:00:17.12,0:00:18.04,720,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:00:18.04,0:00:20.41,720,,0,0,0,,Анджело: Рагуса бар.
Dialogue: 0,0:00:20.41,0:00:22.88,720,,0,0,0,,Мекенжай сіздің бөлмеңіз...
Dialogue: 0,0:00:24.27,0:00:26.08,720,,0,0,0,,сенікі не?
Dialogue: 0,0:00:35.05,0:00:36.97,720,,0,0,0,,Бұл жиіркенішті.
Dialogue: 0,0:00:37.55,0:00:39.93,720,,0,0,0,,Сіз тірісіз бе,әлде өлісіз бе?
Dialogue: 0,0:01:14.07,0:01:15.57,720,,0,0,0,,Banettii
Dialogue: 0,0:01:38.77,0:01:40.73,720,,0,0,0,,Ыстық емес
Dialogue: 0,0:01:40.73,0:01:41.66,720,,0,0,0,,Иә
Dialogue: 0,0:01:41.66,0:01:43.58,720,,0,0,0,,Жанып тұрған фитиль емес
Dialogue: 0,0:01:43.58,0:01:46.00,720,,0,0,0,,Парафин – шырақ құрамдас бөлігі.
Dialogue: 0,0:01:46.00,0:01:47.03,720,,0,0,0,,Өзегін таңдасаңыз да...
Dialogue: 0,0:01:47.03,0:01:48.10,720,,0,0,0,,Содан кейін орындаңыз.
Dialogue: 0,0:02:16.32,0:02:18.94,720,,0,0,0,,Уау,ыстық емес.
Dialogue: 0,0:02:18.94,0:02:20.17,720,,0,0,0,,А,қараңдаршы
Dialogue: 0,0:02:21.56,0:02:23.85,720,,0,0,0,,Бірақ өте ыстық болған болуы керек.
Dialogue: 0,0:02:23.85,0:02:24.82,720,,0,0,0,,Мүлдем емес
Dialogue: 0,0:02:25.72,0:02:27.31,720,,0,0,0,,Маған тезірек үйге бару керек.
Dialogue: 0,0:02:28.75,0:02:31.25,720,,0,0,0,,Тортты бірге жейміз
Dialogue: 0,0:02:31.49,0:02:32.81,720,,0,0,0,,Келесі кездескенше
Dialogue: 0,0:02:33.36,0:02:34.90,720,,0,0,0,,Торт дәмді.
Dialogue: 0,0:02:35.40,0:02:36.84,720,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:02:36.84,0:02:39.10,720,,0,0,0,,Че,жарайды.
Dialogue: 0,0:02:39.10,0:02:42.17,720,,0,0,0,,Кортео Анаңызбен бірге тамақтаныңыз.
Dialogue: 0,0:02:42.61,0:02:45.08,720,,0,0,0,,Кейін Бұл көп емес,бірақ...
Dialogue: 0,0:02:49.06,0:02:51.28,720,,0,0,0,,Кешіріңіз,әрқашан
Dialogue: 0,0:02:51.28,0:02:52.48,720,,0,0,0,,Жарайды.
Dialogue: 0,0:02:52.94,0:02:55.48,720,,0,0,0,,Алдымен анаңның жағдайы қалай?
Dialogue: 0,0:02:56.61,0:02:58.94,720,,0,0,0,,Соңғы кездері өте жақсы сияқты.
Dialogue: 0,0:02:59.21,0:03:01.39,720,,0,0,0,,Бұл жақсы болар еді
Dialogue: 0,0:03:02.54,0:03:03.68,720,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:03:03.68,0:03:05.17,720,,0,0,0,,Қайырлы түн Люс
Dialogue: 0,0:03:07.84,0:03:09.04,720,,0,0,0,,Анджело
Dialogue: 0,0:03:09.93,0:03:12.95,720,,0,0,0,,Шам: Сіз оны саусақпен сөндірдіңіз бе?
Dialogue: 0,0:03:16.48,0:03:18.77,720,,0,0,0,,Сәуір болды ғой,солай емес пе?
Dialogue: 0,0:03:18.77,0:03:19.56,720,,0,0,0,,Иә
Dialogue: 0,0:03:25.72,0:03:26.85,720,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:03:26.85,0:03:28.06,720,,0,0,0,,Жүрегім суып тұр
Dialogue: 0,0:03:28.06,0:03:29.64,720,,0,0,0,,Туған күнің құтты болсын
Dialogue: 0,0:04:01.82,0:04:04.05,720,,0,0,0,,Дауыстап айтсаңыз,ол жұмыс істемейді.
Dialogue: 0,0:04:04.05,0:04:04.97,720,,0,0,0,,Ах
Dialogue: 0,0:04:05.13,0:04:05.96,720,,0,0,0,,келді
Dialogue: 0,0:04:06.43,0:04:07.52,720,,0,0,0,,Сол жігіттер
Dialogue: 0,0:04:07.94,0:04:09.97,720,,0,0,0,,Енді қоңырау шалайық.
Dialogue: 0,0:04:10.37,0:04:12.18,720,,0,0,0,,Анджело
Dialogue: 0,0:04:12.18,0:04:13.49,720,,0,0,0,,Люс
Dialogue: 0,0:04:13.85,0:04:15.46,720,,0,0,0,,Кираны қолдайтындардың бар екеніне таңғалмаймын.
Dialogue: 0,0:04:18.16,0:04:20.40,720,,0,0,0,,Сынақ құралы,оны ашыңыз.
Dialogue: 0,0:04:20.40,0:04:21.49,720,,0,0,0,,Бұл Винсент.
Dialogue: 0,0:04:22.23,0:04:23.29,720,,0,0,0,,Винс?
Dialogue: 0,0:04:23.29,0:04:24.90,720,,0,0,0,,Аа,қазірдің өзінде
Dialogue: 0,0:04:24.90,0:04:26.22,720,,0,0,0,,Мен бірден қайтамын
Dialogue: 0,0:04:27.20,0:04:30.10,720,,0,0,0,,Менің үйіме келуіңіз ерекше.
Dialogue: 0,0:04:30.85,0:04:31.76,720,,0,0,0,,Сіз ішесіз бе?
Dialogue: 0,0:04:32.75,0:04:33.87,720,,0,0,0,,Жоқ
Dialogue: 0,0:04:34.12,0:04:35.96,720,,0,0,0,,Керісінше, тынышталып,тыңдаңыз.
Dialogue: 0,0:04:36.76,0:04:38.24,720,,0,0,0,,Дон жеңіліске ұшырады
Dialogue: 0,0:04:49.39,0:04:50.94,720,,0,0,0,,Оркодан келгендер ме?
Dialogue: 0,0:04:52.50,0:04:53.26,720,,0,0,0,,Жоқ
Dialogue: 0,0:04:54.07,0:04:55.30,720,,0,0,0,,Бұл менмін
Dialogue: 0,0:04:56.69,0:04:58.95,720,,0,0,0,,Тынышпен қараңыз
Dialogue: 0,0:04:58.95,0:05:00.41,720,,0,0,0,,Мен жақында үйде боламын.
Dialogue: 0,0:05:03.26,0:05:05.44,720,,0,0,0,,Отбасымды қорғау үшін
Dialogue: 0,0:05:05.94,0:05:08.20,720,,0,0,0,,Мен саған өте қарыздар едім...
Dialogue: 0,0:05:08.37,0:05:10.33,720,,0,0,0,,Жоқ,сынаушы
Dialogue: 0,0:05:10.64,0:05:12.66,720,,0,0,0,,Сіз ештеңе түсінбейсіз
Dialogue: 0,0:05:12.98,0:05:17.12,720,,0,0,0,,Галассияға қанша құйғаныңызды табыңыз
Dialogue: 0,0:05:17.12,0:05:19.14,720,,0,0,0,,Жетеді,кітапшаны шығар.
Dialogue: 0,0:05:20.25,0:05:21.50,720,,0,0,0,,Мұнда емес
Dialogue: 0,0:05:21.80,0:05:23.17,720,,0,0,0,,Банкке салынған
Dialogue: 0,0:05:23.43,0:05:25.34,720,,0,0,0,,Маған кітапты қазір беріңіз.
Dialogue: 0,0:05:25.34,0:05:27.83,720,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:05:38.01,0:05:38.94,720,,0,0,0,,Елена
Dialogue: 0,0:05:40.24,0:05:41.42,720,,0,0,0,,Амансың ба?
Dialogue: 0,0:05:41.42,0:05:42.60,720,,0,0,0,,Ручу
Dialogue: 0,0:05:42.60,0:05:43.58,720,,0,0,0,,О, өтінемін,мені өлтірме
Dialogue: 0,0:06:03.83,0:06:04.60,720,,0,0,0,,О, өтінемін,мені өлтірме
Dialogue: 0,0:06:04.60,0:06:05.77,720,,0,0,0,,Оған қарамаңыз
Dialogue: 0,0:06:06.17,0:06:07.50,720,,0,0,0,,Винсент
Dialogue: 0,0:06:07.64,0:06:09.13,720,,0,0,0,,Мына балаға көмектес
Dialogue: 0,0:06:10.00,0:06:12.30,720,,0,0,0,,Ешқашан ешкімге айтпа
Dialogue: 0,0:06:12.58,0:06:13.71,720,,0,0,0,,Сонымен...
Dialogue: 0,0:06:14.56,0:06:16.89,720,,0,0,0,,Елена Мұқият тыңда.
Dialogue: 0,0:06:17.39,0:06:20.06,720,,0,0,0,,Ол бала бізді ешқашан ұмытпайды
Dialogue: 0,0:06:21.10,0:06:22.61,720,,0,0,0,,Мен өмір сүргенше
Dialogue: 0,0:06:22.61,0:06:23.35,720,,0,0,0,,О, өтінемін,мені өлтірме
Dialogue: 0,0:06:23.35,0:06:24.33,720,,0,0,0,,(Элис) Иә,ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:06:31.46,0:06:33.18,720,,0,0,0,,Сүртетін нәрсе бар ма?
Dialogue: 0,0:06:37.26,0:06:38.84,720,,0,0,0,,Біз екінші қабаттамыз
Dialogue: 0,0:06:38.84,0:06:41.29,720,,0,0,0,,Нерон,өзіңді іздеу керек.
Dialogue: 0,0:08:13.75,0:08:15.55,720,,0,0,0,,Мен какао жасадым
Dialogue: 0,0:08:22.18,0:08:23.06,720,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:23.69,0:08:25.35,720,,0,0,0,,Мен келмеуім керек еді
Dialogue: 0,0:08:25.77,0:08:26.90,720,,0,0,0,,Жарайды
Dialogue: 0,0:08:27.31,0:08:29.23,720,,0,0,0,,Мен сізге осы уақытқа дейін бармаймын.
Dialogue: 0,0:08:39.47,0:08:41.24,720,,0,0,0,,Біраз ұйықтаңыз.
Dialogue: 0,0:08:51.48,0:08:52.55,720,,0,0,0,,Авильо
Dialogue: 0,0:08:53.18,0:08:56.72,720,,0,0,0,,Бұдан былай біз ағайынбыз.
Dialogue: 0,0:08:57.49,0:08:58.94,720,,0,0,0,,Бұдан былай
Dialogue: 0,0:11:49.56,0:11:51.48,720,,0,0,0,,Керемет соққы
Dialogue: 0,0:11:51.48,0:11:54.61,720,,0,0,0,,Өйткені,бұл саке келесі.
Dialogue: 0,0:11:55.24,0:11:56.36,720,,0,0,0,,Эй
Dialogue: 0,0:11:56.36,0:12:00.17,720,,0,0,0,,Сондықтан мен оны Orco отбасылық дүкендеріне көтерме сатамын.
Dialogue: 0,0:12:00.17,0:12:02.52,720,,0,0,0,,Сіз оны ағымдағы бағадан үш есеге сата аласыз.
Dialogue: 0,0:12:03.04,0:12:04.75,720,,0,0,0,,Мен мафияны жек көремін
Dialogue: 0,0:12:05.35,0:12:08.56,720,,0,0,0,,Бұл самогон шығаратын адам айтқан жол ма?
Dialogue: 0,0:12:09.26,0:12:12.71,720,,0,0,0,,Менің ағам қазір мистер Фангода тұрады.
Dialogue: 0,0:12:12.71,0:12:13.87,720,,0,0,0,,Мен білмеймін
Dialogue: 0,0:12:14.25,0:12:16.71,720,,0,0,0,,Осы уақыт ішінде Орко отбасына қосылған адам.
Dialogue: 0,0:12:16.71,0:12:18.84,720,,0,0,0,,Сіз шынымен де барынша пайдаланасыз.
Dialogue: 0,0:12:18.86,0:12:20.66,720,,0,0,0,,Қайтып кел,Челот.
Dialogue: 0,0:12:20.66,0:12:22.09,720,,0,0,0,,Кортео
Dialogue: 0,0:12:22.09,0:12:24.09,720,,0,0,0,,Бұл қоқыс шұңқырында мәңгі қалады...
Dialogue: 0,0:12:24.11,0:12:25.14,720,,0,0,0,,Үйге қайт
Dialogue: 0,0:12:26.84,0:12:28.71,720,,0,0,0,,Мен не болатынын білмеймін.
Dialogue: 0,0:12:33.21,0:12:34.85,720,,0,0,0,,Жақсы өтті ме?
Dialogue: 0,0:12:34.85,0:12:35.77,720,,0,0,0,,А Аники
Dialogue: 0,0:12:36.04,0:12:38.47,720,,0,0,0,,Сондықтан мен мафияны жек көремін...
Dialogue: 0,0:12:40.39,0:12:42.48,720,,0,0,0,,Бізге алкоголь беріңіз
Dialogue: 0,0:12:45.95,0:12:47.98,720,,0,0,0,,Сіз алкоголь сатасыз ба?
Dialogue: 0,0:12:47.98,0:12:50.04,720,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:13:03.59,0:13:04.68,720,,0,0,0,,Тоқта!
Dialogue: 0,0:13:06.65,0:13:10.30,720,,0,0,0,,Мен бизнестегі бәсекелестерімді жеңгім келеді.
Dialogue: 0,0:13:16.65,0:13:17.76,720,,0,0,0,,Анджелу
Dialogue: 0,0:13:19.94,0:13:21.32,720,,0,0,0,,Мен жасадым
Dialogue: 0,0:13:21.73,0:13:23.10,720,,0,0,0,,Оны ішіп көріңіз.
Dialogue: 0,0:13:23.10,0:13:24.81,720,,0,0,0,,Мен мұның жақсы екенін білемін.
Dialogue: 0,0:13:28.01,0:13:31.58,720,,0,0,0,,Шыны керек,самогон жасағым келмейді.
Dialogue: 0,0:13:31.58,0:13:34.08,720,,0,0,0,,Мен ақша жинап,мектепке барғым келеді.
Dialogue: 0,0:13:36.62,0:13:37.88,720,,0,0,0,,Анджелу
Dialogue: 0,0:13:37.88,0:13:39.84,720,,0,0,0,,Жеті жыл бойы не істедің?
Dialogue: 0,0:13:39.85,0:13:42.83,720,,0,0,0,,Авильио Бруно Ол өзін қазір осылай атайды.
Dialogue: 0,0:13:43.71,0:13:47.20,720,,0,0,0,,Бұл қалаға қайтып келуге болады ма?
Dialogue: 0,0:13:52.48,0:13:53.93,720,,0,0,0,,Сіз шаршаған болуыңыз керек.
Dialogue: 0,0:13:54.31,0:13:55.73,720,,0,0,0,,Осы бөлмені пайдаланыңыз.
Dialogue: 0,0:13:56.33,0:13:57.46,720,,0,0,0,,Апай
Dialogue: 0,0:13:59.24,0:14:00.44,720,,0,0,0,,Өткен жазда...
Dialogue: 0,0:14:00.92,0:14:04.20,720,,0,0,0,,Сонда ешкімді уайымдаудың қажеті жоқ.
Dialogue: 0,0:14:05.34,0:14:07.15,720,,0,0,0,,Бірге ақша тапқыңыз келе ме?
Dialogue: 0,0:14:08.19,0:14:10.86,720,,0,0,0,,Мұны отбасыңызға сатыңыз.
Dialogue: 0,0:14:11.46,0:14:14.61,720,,0,0,0,,Мен отбасыммен ешнәрсе істегім келмейді.
Dialogue: 0,0:14:14.87,0:14:16.31,720,,0,0,0,,Дәл осылай Анджелоға да қатысты...
Dialogue: 0,0:14:16.31,0:14:18.03,720,,0,0,0,,Өтінемін,Кортео.
Dialogue: 0,0:14:21.91,0:14:24.83,720,,0,0,0,,Икіғай адамдарға күш береді
Dialogue: 0,0:14:24.83,0:14:27.42,720,,0,0,0,,Достық пышақтан да күшті
Dialogue: 0,0:14:28.03,0:14:30.24,720,,0,0,0,,Біз ағайындымыз,солай ма?
Dialogue: 0,0:14:32.75,0:14:34.88,720,,0,0,0,,Бұл құм - бұл арал.
Dialogue: 0,0:14:37.12,0:14:40.25,720,,0,0,0,,Менің ойымша,бұл жерде ең жоғары бағаларды сатуға болады.
Dialogue: 0,0:14:41.23,0:14:43.07,720,,0,0,0,,Тыйым салынғаннан кейін
Dialogue: 0,0:14:43.07,0:14:45.48,720,,0,0,0,,Бұзақылар оларды жинап алды.
Dialogue: 0,0:14:46.78,0:14:49.82,720,,0,0,0,,Бірақ ол жерге кіруге болатын сияқты.
Dialogue: 0,0:14:49.82,0:14:51.57,720,,0,0,0,,Бұл арзан сөз емес.
Dialogue: 0,0:15:11.84,0:15:14.30,720,,0,0,0,,Ол шіркеу қазір бар.
Dialogue: 0,0:15:18.27,0:15:20.76,720,,0,0,0,,Сіз қалай ойлайсыз? Жаман болуы керек.
Dialogue: 0,0:15:21.33,0:15:23.06,720,,0,0,0,,Бұл Бранның құрметіне.
Dialogue: 0,0:15:23.06,0:15:24.61,720,,0,0,0,,бұл дұрыс
Dialogue: 0,0:15:24.61,0:15:27.74,720,,0,0,0,,Шекараның арғы жағындағы үздіктердің ең жақсысы.
Dialogue: 0,0:15:28.07,0:15:30.62,720,,0,0,0,,Мен бұрын-соңды мұндай дәмді алкогольді ішкен емеспін.
Dialogue: 0,0:15:30.62,0:15:32.58,720,,0,0,0,,Сіз Гето болуыңыз керек.
Dialogue: 0,0:15:32.58,0:15:33.86,720,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:15:34.13,0:15:37.09,720,,0,0,0,,Жақсы алкогольге келсек,оны ішпей-ақ оның иісін сезіңіз.
Dialogue: 0,0:15:37.30,0:15:39.25,720,,0,0,0,,Құлақтың иісін де сезейік.
Dialogue: 0,0:15:40.99,0:15:44.70,720,,0,0,0,,Дәл қазір Орко отбасы шекара жолын бақылауда.
Dialogue: 0,0:15:46.88,0:15:49.98,720,,0,0,0,,Балалар сендер Оркодан ұрладыңдар ма?
Dialogue: 0,0:15:50.43,0:15:51.96,720,,0,0,0,,Сіз қайдан білдіңіз?
Dialogue: 0,0:15:52.17,0:15:54.29,720,,0,0,0,,Бірақ сендер ондай емессіңдер...
Dialogue: 0,0:15:54.29,0:15:55.45,720,,0,0,0,,Гранчио мырза
Dialogue: 0,0:16:01.86,0:16:05.59,720,,0,0,0,,Менің ішімдігімді біреу ұрлап кеткен деп ойлаймын.
Dialogue: 0,0:16:05.59,0:16:07.21,720,,0,0,0,,Мен оны іздеп жүрмін.
Dialogue: 0,0:16:07.78,0:16:10.24,720,,0,0,0,,Мен сенің кім екеніңді білмеймін.
Dialogue: 0,0:16:10.44,0:16:11.96,720,,0,0,0,,Орко отбасы?
Dialogue: 0,0:16:14.14,0:16:16.90,720,,0,0,0,,А,бұл Фанго деп аталады.
Dialogue: 0,0:16:17.88,0:16:19.21,720,,0,0,0,,Бұл қандай спирт?
Dialogue: 0,0:16:19.36,0:16:20.90,720,,0,0,0,,Мен әкелдім.
Dialogue: 0,0:16:21.35,0:16:22.49,720,,0,0,0,,Қайдан
Dialogue: 0,0:16:22.67,0:16:24.16,720,,0,0,0,,Ол сол жақтан.
Dialogue: 0,0:16:25.10,0:16:29.08,720,,0,0,0,,Е-е, шын айтсаң керек,балам.
Dialogue: 0,0:16:38.10,0:16:40.22,720,,0,0,0,,Қайта тыңдайық
Dialogue: 0,0:16:40.22,0:16:42.35,720,,0,0,0,,Бұл алкогольге не болды?
Dialogue: 0,0:16:42.94,0:16:44.68,720,,0,0,0,,Мен сізге алкоголь сатып алуыңызды қалаймын.
Dialogue: 0,0:16:44.69,0:16:45.81,720,,0,0,0,,Үйге қайт
Dialogue: 0,0:16:45.81,0:16:49.69,720,,0,0,0,,Мұнда Темера шығаратындай ваннаға арналған шай жоқ.
Dialogue: 0,0:17:00.38,0:17:02.89,720,,0,0,0,,Гәки,алданып қалғанда.
Dialogue: 0,0:17:04.20,0:17:05.34,720,,0,0,0,,Бұл...
Dialogue: 0,0:17:22.46,0:17:24.11,720,,0,0,0,,Сатып алайық
Dialogue: 0,0:17:25.39,0:17:27.38,720,,0,0,0,,Біз оны үйге жібере аламыз.
Dialogue: 0,0:17:27.38,0:17:29.40,720,,0,0,0,,Тіпті тікелей сатып алсаңыз да...
Dialogue: 0,0:17:30.52,0:17:32.30,720,,0,0,0,,Сен оны лақтырып жібердің.
Dialogue: 0,0:17:32.30,0:17:34.53,720,,0,0,0,,Мен іштім,солай емес пе?
Dialogue: 0,0:17:34.89,0:17:36.52,720,,0,0,0,,Дұрыс.
Dialogue: 0,0:17:36.52,0:17:39.00,720,,0,0,0,,Әй, қария,кофе берші.
Dialogue: 0,0:17:39.31,0:17:40.07,720,,0,0,0,,Иә.
Dialogue: 0,0:17:40.48,0:17:42.07,720,,0,0,0,,Бөтелке қанша тұрады?
Dialogue: 0,0:17:42.38,0:17:43.58,720,,0,0,0,,3.5
Dialogue: 0,0:17:43.86,0:17:45.28,720,,0,0,0,,Бұл туралы айтудың қажеті жоқ
Dialogue: 0,0:17:46.21,0:17:48.10,720,,0,0,0,,Аптасына қанша сатуға болады?
Dialogue: 0,0:17:49.43,0:17:51.08,720,,0,0,0,,Мен сені ұрамын
Dialogue: 0,0:17:56.26,0:17:58.75,720,,0,0,0,,Акелло
Dialogue: 0,0:17:59.05,0:18:01.83,720,,0,0,0,,Ой, ұрып-соғып жатырсың,жігіт.
Dialogue: 0,0:18:01.83,0:18:04.07,720,,0,0,0,,Шуды көргенде білесің
Dialogue: 0,0:18:04.07,0:18:04.97,720,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады
Dialogue: 0,0:18:04.97,0:18:06.74,720,,0,0,0,,Күтейік,көрейік
Dialogue: 0,0:18:06.74,0:18:07.66,720,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:18:08.28,0:18:10.14,720,,0,0,0,,Оны ала аламын ба?
Dialogue: 0,0:18:10.14,0:18:11.31,720,,0,0,0,,Дәптерімді қайтар.
Dialogue: 0,0:18:13.03,0:18:15.99,720,,0,0,0,,Көңілді бөлім үшін кешіріңіз.
Dialogue: 0,0:18:15.99,0:18:17.45,720,,0,0,0,,Фанго Монмон
Dialogue: 0,0:18:17.47,0:18:20.72,720,,0,0,0,,Содан бері Орко отбасы бос емес.
Dialogue: 0,0:18:20.72,0:18:24.38,720,,0,0,0,,Нерон,менің Ванетти деген жігітпен бір ісім бар.
Dialogue: 0,0:18:24.38,0:18:25.59,720,,0,0,0,,Жоқ?
Dialogue: 0,0:18:27.45,0:18:28.49,720,,0,0,0,,Нерон
Dialogue: 0,0:18:28.49,0:18:30.58,720,,0,0,0,,Дон Ванеттидің ұлы.
Dialogue: 0,0:18:30.76,0:18:34.80,720,,0,0,0,,Бұл аралға қиындық келтірме
Dialogue: 0,0:18:34.80,0:18:36.59,720,,0,0,0,,Бұл жерде ереже осы.
Dialogue: 0,0:18:36.59,0:18:38.27,720,,0,0,0,,Ережелер?
Dialogue: 0,0:18:38.78,0:18:41.36,720,,0,0,0,,Бұл, әрине,маңызды.
Dialogue: 0,0:18:41.36,0:18:45.19,720,,0,0,0,,Мен де бүгін сол ережені түзету үшін келдім.
Dialogue: 0,0:18:45.56,0:18:47.23,720,,0,0,0,,Дәл қазір
Dialogue: 0,0:18:47.23,0:18:52.19,720,,0,0,0,,Мен үйімнен ұрланған алкогольді сол тұрақтан таптым.
Dialogue: 0,0:18:52.19,0:18:53.77,720,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:18:54.98,0:18:56.68,720,,0,0,0,,Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:18:56.68,0:18:57.63,720,,0,0,0,,Жоқ
Dialogue: 0,0:18:57.63,0:19:00.71,720,,0,0,0,,және Нерон Ванетти.
Dialogue: 0,0:19:00.71,0:19:04.22,720,,0,0,0,,Жас монах осы дүкенге тоқтаған дейді.
Dialogue: 0,0:19:06.54,0:19:08.00,720,,0,0,0,,Бұл сенсің
Dialogue: 0,0:19:08.71,0:19:10.66,720,,0,0,0,,Мен келемін.
Dialogue: 0,0:19:16.75,0:19:18.38,720,,0,0,0,,Бұл Нерон.
Dialogue: 0,0:19:18.79,0:19:21.27,720,,0,0,0,,Жоқ,мен Нерон емеспін.
Dialogue: 0,0:19:21.97,0:19:24.18,720,,0,0,0,,Басқа неролар бар ма?
Dialogue: 0,0:19:25.30,0:19:28.32,720,,0,0,0,,Қараңызшы,бұл сізсіз.
Dialogue: 0,0:19:28.84,0:19:31.80,720,,0,0,0,,Адамдардың ішімдіктерін ұрлаған жаман бала
Dialogue: 0,0:19:31.80,0:19:33.15,720,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:19:33.15,0:19:34.26,720,,0,0,0,,Бұл менмін
Dialogue: 0,0:19:34.60,0:19:35.84,720,,0,0,0,,Мен Неронмын
Dialogue: 0,0:19:36.39,0:19:38.98,720,,0,0,0,,Олай болса,бұл жігіт
Dialogue: 0,0:19:39.30,0:19:40.18,720,,0,0,0,,Цукуёми, тез бол,тез бол
Dialogue: 0,0:19:40.88,0:19:43.48,720,,0,0,0,,Иә,тез айтыңыз.
Dialogue: 0,0:19:43.61,0:19:45.73,720,,0,0,0,,Жаңа Нерон
Dialogue: 0,0:19:45.73,0:19:47.08,720,,0,0,0,,Барлығымыз бірге жүрейік.
Dialogue: 0,0:20:01.22,0:20:04.66,720,,0,0,0,,Ей,жасайық.
Dialogue: 0,0:20:05.48,0:20:07.08,720,,0,0,0,,Оны жіберіңіз
Dialogue: 0,0:20:08.27,0:20:11.10,720,,0,0,0,,Серпенте,мұны істе.
Dialogue: 0,0:20:11.10,0:20:12.69,720,,0,0,0,,Тамақты кесу
Dialogue: 0,0:20:14.64,0:20:17.60,720,,0,0,0,,Мен бұл жігітке бұлай істей алмаймын.
Dialogue: 0,0:20:19.13,0:20:21.65,720,,0,0,0,,Иә,келіңіз.
Dialogue: 0,0:20:28.66,0:20:30.50,720,,0,0,0,,Әй,бұл осылай.
Dialogue: 0,0:20:34.88,0:20:36.90,720,,0,0,0,,Есептегіште темір табақ бар.
Dialogue: 0,0:20:37.19,0:20:38.54,720,,0,0,0,,Жақсы,жігітім.
Dialogue: 0,0:20:38.54,0:20:40.50,720,,0,0,0,,Гранчио қашып кетті.
Dialogue: 0,0:20:43.55,0:20:44.59,720,,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:20:44.59,0:20:46.39,720,,0,0,0,,Бетіңді көрсетсең,ара ұясы.
Dialogue: 0,0:20:46.41,0:20:48.13,720,,0,0,0,,Оқ таусылғанша күтуім керек пе?
Dialogue: 0,0:20:48.27,0:20:49.61,720,,0,0,0,,Сәлем Серпенте
Dialogue: 0,0:20:49.61,0:20:52.69,720,,0,0,0,,Оқ таңбалары. Сол жерден бірнеше оқ алыңыз.
Dialogue: 0,0:20:52.69,0:20:53.85,720,,0,0,0,,Түсінікті
Dialogue: 0,0:20:54.45,0:20:57.29,720,,0,0,0,,Мылтық бізге тең келмейді.
Dialogue: 0,0:20:57.52,0:20:58.57,720,,0,0,0,,Қарама
Dialogue: 0,0:20:58.57,0:21:00.61,720,,0,0,0,,Олардың айналасына ішімдік лақтыр
Dialogue: 0,0:21:00.62,0:21:01.60,720,,0,0,0,,Түсіндім
Dialogue: 0,0:21:04.89,0:21:07.22,720,,0,0,0,,Әлгі бейбақ ойнап жүр.
Dialogue: 0,0:21:08.37,0:21:12.25,720,,0,0,0,,Мен бір жынды жігіт Оркоға қосылды деп естідім. Бұл ол ма?
Dialogue: 0,0:21:12.25,0:21:14.53,720,,0,0,0,,Ақыр соңында, Орко,біз бір-бірімізге байсалдымыз.
Dialogue: 0,0:21:15.49,0:21:16.96,720,,0,0,0,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:21:16.63,0:21:19.40,720,,0,0,0,,Кел,кел!
Dialogue: 0,0:21:17.61,0:21:19.04,720,,0,0,0,,Бөлме айналып-айналып тұр — керемет
Dialogue: 0,0:21:19.24,0:21:21.23,720,,0,0,0,,Егер сіз мұны лақтырсаңыз,ол шығуға қарай кетеді.
Dialogue: 0,0:21:21.71,0:21:23.07,720,,0,0,0,,Жерде не бар?
Dialogue: 0,0:21:23.07,0:21:24.84,720,,0,0,0,,Жарайды,жасаңыз.
Dialogue: 0,0:21:38.81,0:21:39.97,720,,0,0,0,,Шұғыл хабар,шұғыл хабар!
Dialogue: 0,0:21:50.58,0:21:51.60,720,,0,0,0,,Тигрей
Dialogue: 0,0:21:52.41,0:21:53.29,720,,0,0,0,,Эй
Dialogue: 0,0:21:53.69,0:21:55.08,720,,0,0,0,,Егер бұл операция сәтті өтсе,...
Dialogue: 0,0:22:05.42,0:22:08.35,720,,0,0,0,,Ой,бүгін қандай күн.
Dialogue: 0,0:22:08.35,0:22:10.42,720,,0,0,0,,Бірақ бұл қызықты емес пе?
Dialogue: 0,0:22:10.42,0:22:12.51,720,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:22:12.85,0:22:14.81,720,,0,0,0,,Шамның ингредиенттері
Dialogue: 0,0:22:14.81,0:22:15.97,720,,0,0,0,,Парафин?
Dialogue: 0,0:22:16.85,0:22:19.59,720,,0,0,0,,Парафинді сұйылтып,содан кейін сумен араластыруға болады.
Dialogue: 0,0:22:19.59,0:22:21.93,720,,0,0,0,,Бон,дұрыс.
Dialogue: 0,0:22:22.52,0:22:25.58,720,,0,0,0,,Сізге рахмет,мен ол жерге біраз уақыт жақындай алмаймын.
Dialogue: 0,0:22:25.58,0:22:28.99,720,,0,0,0,,Сонда да секең дәмді болды.
Dialogue: 0,0:22:28.99,0:22:30.24,720,,0,0,0,,Сіз мұнымен ақша таба аласыз.
Dialogue: 0,0:22:32.16,0:22:35.41,720,,0,0,0,,Қараңызшы,бұл Ванеттис театры.
Dialogue: 0,0:22:35.41,0:22:37.00,720,,0,0,0,,Бұл үлкен мәселе болуы керек.
Dialogue: 0,0:22:37.38,0:22:40.82,720,,0,0,0,,Мен Донға аяқталған нұсқасын мүмкіндігінше тезірек көрсеткім келеді.
Dialogue: 0,0:22:41.51,0:22:43.86,720,,0,0,0,,Бұл қала үшін жарамсыз
Dialogue: 0,0:22:44.05,0:22:45.17,720,,0,0,0,,Қара…
Dialogue: 0,0:22:45.17,0:22:46.72,720,,0,0,0,,Нерон есімді адам
Dialogue: 0,0:22:46.72,0:22:48.43,720,,0,0,0,,34-тарау: Үнсіз ойнатылған реквием,Бірінші бөлім
Dialogue: 0,0:22:50.65,0:22:52.55,720,,0,0,0,,Нерон Ванетти...
Dialogue: 0,0:22:54.23,0:22:55.40,720,,0,0,0,,Бұл менмін
Dialogue: 0,0:22:56.90,0:23:02.90,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
