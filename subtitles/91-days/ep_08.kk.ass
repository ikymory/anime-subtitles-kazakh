Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:06.10,Default,,0,0,0,,Нерон
Dialogue: 0,0:00:06.05,0:00:08.06,Default,,0,0,0,,Бүгіннен бастап мен сенің ағаңмын.
Dialogue: 0,0:01:50.00,0:01:55.00,Default,,0,0,0,,Пердеден кейін
Dialogue: 0,0:02:02.04,0:02:06.03,Default,,0,0,0,,Бұл Чикагодан келген федералды агент Дельфи мырза.
Dialogue: 0,0:02:07.07,0:02:12.08,Default,,0,0,0,,Енді ол менің орныма осы қаланың тыныштығын қорғайды.
Dialogue: 0,0:02:13.01,0:02:15.05,Default,,0,0,0,,Дельфи мырза, сіз бұл қалаға не үшін келдіңіз?
Dialogue: 0,0:02:15.06,0:02:18.07,Default,,0,0,0,,Бұл қалада жағымсыз иіс бар.
Dialogue: 0,0:02:18.07,0:02:21.08,Default,,0,0,0,,Ал сол иістің көзі – мафия.
Dialogue: 0,0:02:21.08,0:02:25.09,Default,,0,0,0,,Полицейлердің ит болған күндерін аяқтаймын.
Dialogue: 0,0:02:29.06,0:02:31.04,Default,,0,0,0,,Мафия дегеніміз не?
Dialogue: 0,0:02:31.04,0:02:33.05,Default,,0,0,0,,Біріншіден, Фанго отбасы
Dialogue: 0,0:02:35.09,0:02:38.03,Default,,0,0,0,,Фанго Орконың орнына Дон болды.
Dialogue: 0,0:02:38.03,0:02:42.03,Default,,0,0,0,,Ол қаладағы беделді адамдармен күш біріктіру арқылы өз ықпалын кеңейтуде.
Dialogue: 0,0:02:48.09,0:02:51.09,Default,,0,0,0,,Ал олардың жасырынатын орны, арал.
Dialogue: 0,0:02:52.04,0:02:54.09,Default,,0,0,0,,Бұл зұлымдық ұясы
Dialogue: 0,0:02:56.00,0:02:57.08,Default,,0,0,0,,Мен оны тазалаймын
Dialogue: 0,0:02:59.04,0:03:03.07,Default,,0,0,0,,Бұдан әрі Ванетти отбасы бұл қаланы ұзақ уақыт басқарды.
Dialogue: 0,0:03:04.00,0:03:06.06,Default,,0,0,0,,Ішкі жанжал ақыры аяқталды.
Dialogue: 0,0:03:07.01,0:03:12.00,Default,,0,0,0,,Енді нақты дон - Винсенттің үлкен ұлы Нерон.
Dialogue: 0,0:03:12.08,0:03:16.04,Default,,0,0,0,,Олар сатып алып жатқан заңсыз аспан
Dialogue: 0,0:03:16.04,0:03:19.08,Default,,0,0,0,,Жақында ел ішінде және шетелде жоғары бағамен саудаланды
Dialogue: 0,0:03:22.06,0:03:26.05,Default,,0,0,0,,Бірақ бұл қалада Нерон танымал.
Dialogue: 0,0:03:26.05,0:03:28.05,Default,,0,0,0,,Полициядан әлдеқайда көп
Dialogue: 0,0:03:28.05,0:03:31.09,Default,,0,0,0,,Олар азаматтардың қанын соратын қоқыстар.
Dialogue: 0,0:03:32.04,0:03:34.06,Default,,0,0,0,,Мен қазір сіздің бетпердеңізді шешемін.
Dialogue: 0,0:03:35.06,0:03:37.07,Default,,0,0,0,,Екі отбасы арасындағы билік үшін күресте
Dialogue: 0,0:03:37.07,0:03:40.06,Default,,0,0,0,,Қалада қоғамдық тәртіп айтарлықтай нашарлады.
Dialogue: 0,0:03:40.09,0:03:42.05,Default,,0,0,0,,Мен...жоқ
Dialogue: 0,0:03:42.05,0:03:46.00,Default,,0,0,0,,Біз полицейлер алдымен самогонға қарсы әрекет жасаймыз.
Dialogue: 0,0:03:46.00,0:03:48.02,Default,,0,0,0,,Олардың табыс көзін кесіңіз
Dialogue: 0,0:03:48.02,0:03:50.06,Default,,0,0,0,,Ал жақсы азаматтар үшін
Dialogue: 0,0:03:50.06,0:03:52.08,Default,,0,0,0,,Оларды міндетті түрде сүртіңіз...
Dialogue: 0,0:03:53.02,0:03:55.07,Default,,0,0,0,,Ол қызық бейбақ.
Dialogue: 0,0:03:55.07,0:04:00.03,Default,,0,0,0,,«Заңсыз аспан» туындысын біраз уақытқа тоқтатқан дұрыс сияқты.
Dialogue: 0,0:04:00.03,0:04:02.05,Default,,0,0,0,,Жоқ, одан да көп жаса.
Dialogue: 0,0:04:04.01,0:04:06.09,Default,,0,0,0,,Күнәһар азаматтар күтіп тұр.
Dialogue: 0,0:04:11.04,0:04:14.01,Default,,0,0,0,,Сіздің сиқырыңыз үлкен сияқты.
Dialogue: 0,0:04:15.00,0:04:18.00,Default,,0,0,0,,Мұрныңыз үлкен болса, мұрныңыз да үлкен.
Dialogue: 0,0:04:19.02,0:04:23.09,Default,,0,0,0,,Бірақ мұрны үлкен, икемсіз, түзу жігіт.
Dialogue: 0,0:04:23.09,0:04:26.08,Default,,0,0,0,,Мұндай адамдарды басқару оңайырақ.
Dialogue: 0,0:04:28.02,0:04:30.00,Default,,0,0,0,,Мүмкін уақыт келді
Dialogue: 0,0:04:30.03,0:04:31.00,Default,,0,0,0,,Түсінікті.
Dialogue: 0,0:04:32.02,0:04:35.02,Default,,0,0,0,,Ванеттиді жаншу уақыты келді.
Dialogue: 0,0:04:45.02,0:04:46.04,Default,,0,0,0,,Сіз сенімдісіз бе...
Dialogue: 0,0:04:47.04,0:04:50.00,Default,,0,0,0,,Бұл Delphi, федералды агент.
Dialogue: 0,0:04:52.03,0:04:53.02,Default,,0,0,0,,Қандай күш! Қандай табандылық!
Dialogue: 0,0:04:55.08,0:04:58.09,Default,,0,0,0,,Дельфи мырза, мен сізді қолдаймын.
Dialogue: 0,0:04:58.09,0:05:00.06,Default,,0,0,0,,Мен зорлық-зомбылықтан шаршадым
Dialogue: 0,0:05:00.09,0:05:03.04,Default,,0,0,0,,Сіздің бұлай айтқаныңызды естігенім тыныштандырады.
Dialogue: 0,0:05:03.04,0:05:06.00,Default,,0,0,0,,Мен сізге тезірек...
Dialogue: 0,0:05:14.04,0:05:16.08,Default,,0,0,0,,Ванеттидің иті не үшін?
Dialogue: 0,0:05:20.04,0:05:21.05,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:22.03,0:05:25.03,Default,,0,0,0,,Егер сіз осында жаңа ғана көшіп келген болсаңыз, көп нәрсені айтуыңыз мүмкін.
Dialogue: 0,0:05:31.03,0:05:33.04,Default,,0,0,0,,Лас ақшаны жабыңыз
Dialogue: 0,0:05:34.01,0:05:37.06,Default,,0,0,0,,Қызым, менің ойымша, ол 4 жаста еді.
Dialogue: 0,0:05:43.00,0:05:45.05,Default,,0,0,0,,Отбасыңды күтуің керек.
Dialogue: 0,0:05:49.03,0:05:50.04,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,0:05:51.05,0:05:53.05,Default,,0,0,0,,Нерон Ванеттиге айтыңыз.
Dialogue: 0,0:05:53.05,0:05:55.08,Default,,0,0,0,,Мен оны міндетті түрде жоямын.
Dialogue: 0,0:06:06.03,0:06:08.06,Default,,0,0,0,,Мен оның отбасын тергегеніне де сене алар емеспін.
Dialogue: 0,0:06:11.07,0:06:14.05,Default,,0,0,0,,Мафия барлық жерде, солай емес пе?
Dialogue: 0,0:06:20.06,0:06:22.03,Default,,0,0,0,,Әлгі үлкен мұрын жігіт
Dialogue: 0,0:06:24.08,0:06:25.07,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:29.09,0:06:34.07,Default,,0,0,0,,Дельфин мырза күн сайын самогондар дүкендеріне рейд жасайды.
Dialogue: 0,0:06:36.05,0:06:37.09,Default,,0,0,0,,Мені жалап
Dialogue: 0,0:06:38.03,0:06:42.00,Default,,0,0,0,,Nero Барған сайын көп дүкендер алкогольді сатып алуға құлықсыз.
Dialogue: 0,0:06:43.05,0:06:46.06,Default,,0,0,0,,Мына үлкен мұрынды үйге бірнеше оқ атыңыз.
Dialogue: 0,0:06:46.09,0:06:49.00,Default,,0,0,0,,Егер бұл жұмыс істемесе, жай ғана орындаңыз.
Dialogue: 0,0:06:49.00,0:06:53.00,Default,,0,0,0,,Түпнұсқа субтитрлер ✿ Гүл тілі және Чинатсу субтитр тобы ✿ Бірлескен туынды Сәлем Нерон
Dialogue: 0,0:06:53.01,0:06:54.09,Default,,0,0,0,,Ол көп сүйреп барады.
Dialogue: 0,0:06:55.04,0:06:57.00,Default,,0,0,0,,Имбирь шығар
Dialogue: 0,0:07:05.00,0:07:06.04,Default,,0,0,0,,Вайолет те оны көруге баруы керек еді.
Dialogue: 0,0:07:07.09,0:07:09.04,Default,,0,0,0,,Көлікке барайық па?
Dialogue: 0,0:07:10.02,0:07:15.06,Default,,0,0,0,,Кешіріңіз, бірақ мен сіз басқаратын көлікке енді мінбеймін деп шештім.
Dialogue: 0,0:07:29.08,0:07:31.08,Default,,0,0,0,,Фанго оны жақында орнатады.
Dialogue: 0,0:07:32.06,0:07:35.07,Default,,0,0,0,,Бұдан былай мұқият қозғалған дұрыс.
Dialogue: 0,0:07:38.08,0:07:40.07,Default,,0,0,0,,Мен ғана қалдым
Dialogue: 0,0:07:42.01,0:07:44.03,Default,,0,0,0,,Мен өз отбасымды қорғаймын
Dialogue: 0,0:07:46.07,0:07:49.05,Default,,0,0,0,,Сол себепті, И
Dialogue: 0,0:07:54.01,0:07:55.05,Default,,0,0,0,,Менімен келесің бе?
Dialogue: 0,0:08:03.09,0:08:07.06,Default,,0,0,0,,Мен сені мафияның бір бөлігі болады деп ойламаппын.
Dialogue: 0,0:08:07.06,0:08:09.05,Default,,0,0,0,,Оқиғаның күтпеген бұрылысы.
Dialogue: 0,0:08:09.09,0:08:13.02,Default,,0,0,0,,Мафияны ұнатпаймын десең де.
Dialogue: 0,0:08:14.01,0:08:15.08,Default,,0,0,0,,Мен оны әлі де жек көремін
Dialogue: 0,0:08:17.04,0:08:18.03,Default,,0,0,0,,Кортео
Dialogue: 0,0:08:18.09,0:08:22.04,Default,,0,0,0,,Негізі Фанго мырза сізді қалайды.
Dialogue: 0,0:08:23.08,0:08:25.07,Default,,0,0,0,,Тек осында
Dialogue: 0,0:08:25.07,0:08:27.09,Default,,0,0,0,,Тыйым жақында бітетін сияқты.
Dialogue: 0,0:08:29.01,0:08:31.05,Default,,0,0,0,,Бұл маңызды адамнан естіген ақпарат.
Dialogue: 0,0:08:32.01,0:08:35.06,Default,,0,0,0,,Бұл орын алған соң, оны кез келген адам оңай сатып ала алады.
Dialogue: 0,0:08:35.06,0:08:37.00,Default,,0,0,0,,Баяғыда қарашы.
Dialogue: 0,0:08:37.08,0:08:40.06,Default,,0,0,0,,Фанго мырза сол уақытқа дайындалып жатыр.
Dialogue: 0,0:08:40.06,0:08:42.09,Default,,0,0,0,,Мен шынымен жақсы сусын алғым келеді.
Dialogue: 0,0:08:43.09,0:08:46.09,Default,,0,0,0,,Сондықтан маған сіздердің көмектеріңіз керек.
Dialogue: 0,0:08:47.02,0:08:50.03,Default,,0,0,0,,Ол кісінің танылуы ғажап емес пе?
Dialogue: 0,0:08:52.07,0:08:53.07,Default,,0,0,0,,Мен жұмыстан шыққан кезде
Dialogue: 0,0:08:53.07,0:08:58.01,Default,,0,0,0,,Неліктен? Бұл бай болу мүмкіндігі.
Dialogue: 0,0:09:10.06,0:09:11.09,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:09:12.01,0:09:15.01,Default,,0,0,0,,Аллаға ант етемін
Dialogue: 0,0:09:15.04,0:09:18.05,Default,,0,0,0,,Уайымдамаңыз, бұл транзакция.
Dialogue: 0,0:09:20.07,0:09:23.06,Default,,0,0,0,,Тек ақпаратты беру
Dialogue: 0,0:09:24.00,0:09:25.07,Default,,0,0,0,,Қонақ үй...
Dialogue: 0,0:09:26.01,0:09:28.03,Default,,0,0,0,,Delphi-ге қатысты тергеу басталды.
Dialogue: 0,0:09:28.03,0:09:29.09,Default,,0,0,0,,Мен бұған жол бермеймін. Мен бұған жол бермеймін!
Dialogue: 0,0:09:31.03,0:09:33.01,Default,,0,0,0,,Оның отбасына қамқор болу.
Dialogue: 0,0:09:34.03,0:09:35.08,Default,,0,0,0,,Оның өзі ғана жеткілікті
Dialogue: 0,0:09:35.08,0:09:36.07,Default,,0,0,0,,жақында жолымыз қиылысар.
Dialogue: 0,0:09:37.05,0:09:41.01,Default,,0,0,0,,Сонда тергеуді біреу өз қолына алады.
Dialogue: 0,0:09:42.05,0:09:43.05,Default,,0,0,0,,Иә.
Dialogue: 0,0:09:43.07,0:09:46.05,Default,,0,0,0,,Delphi тергеуді өзі аяқтасын.
Dialogue: 0,0:09:47.05,0:09:49.00,Default,,0,0,0,,Бір дем алайық
Dialogue: 0,0:09:49.06,0:09:53.00,Default,,0,0,0,,Айтпақшы, келесі жолы отбасыммен бірге пикникке барамын.
Dialogue: 0,0:09:53.00,0:09:54.00,Default,,0,0,0,,Қалай?
Dialogue: 0,0:09:54.05,0:09:57.02,Default,,0,0,0,,Жоқ, барғым келеді, бірақ бұл мүмкін емес.
Dialogue: 0,0:09:57.02,0:09:58.04,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:09:58.04,0:10:01.02,Default,,0,0,0,,Мен жақында отбасыммен қыдырғым келеді.
Dialogue: 0,0:10:01.02,0:10:02.06,Default,,0,0,0,,Мен сені әлі де шақырамын.
Dialogue: 0,0:10:08.08,0:10:10.00,Default,,0,0,0,,Эй, Нагаре, басынан бастап бар күшіңді салып жатырсың ба?
Dialogue: 0,0:10:10.03,0:10:12.00,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:10:12.00,0:10:14.01,Default,,0,0,0,,Сіз отбасыңызбен қалай араласа аласыз?
Dialogue: 0,0:10:15.00,0:10:17.09,Default,,0,0,0,,Кек алу мақсаты Банецчи жігіттері болады.
Dialogue: 0,0:10:21.07,0:10:22.09,Default,,0,0,0,,696-санды тұтқын – Мұнда не болып жатыр өзі?
Dialogue: 0,0:10:23.05,0:10:25.03,Default,,0,0,0,,Сіз мектепке барған шығарсыз.
Dialogue: 0,0:10:26.06,0:10:28.01,Default,,0,0,0,,Енді менімен араласпа.
Dialogue: 0,0:10:33.01,0:10:35.02,Default,,0,0,0,,Сіз мені араластырдыңыз, солай емес пе?
Dialogue: 0,0:10:52.00,0:10:53.02,Default,,0,0,0,,Тедди
Dialogue: 0,0:10:53.02,0:10:56.00,Default,,0,0,0,,Эй, мен Дедидің қайда кеткенін білмеймін... Ахахахаха! Хахахахаха!
Dialogue: 0,0:10:54.09,0:10:56.08,Default,,0,0,0,,Тергеуді қазір тоқтатыңыз.
Dialogue: 0,0:10:58.01,0:11:00.01,Default,,0,0,0,,Мен қорқытуларға көнбеймін.
Dialogue: 0,0:11:01.03,0:11:02.09,Default,,0,0,0,,Соңғы кеңес.
Dialogue: 0,0:11:02.09,0:11:03.07,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:11:03.07,0:11:05.05,Default,,0,0,0,,Мені қайта-қайта айтуға мәжбүрлеме
Dialogue: 0,0:11:07.01,0:11:10.08,Default,,0,0,0,,Сіз тым көп жұмыс жасайсыз. Үзіліс жасаңыз.
Dialogue: 0,0:11:12.00,0:11:13.01,Default,,0,0,0,,Мен де солай ойладым, бірақ бұл шешімді талқылаудың қажеті жоқ
Dialogue: 0,0:11:13.01,0:11:13.51,Default,,0,0,0,,Иә
Dialogue: 0,0:11:15.03,0:11:17.04,Default,,0,0,0,,Әкем келмейді
Dialogue: 0,0:11:18.01,0:11:20.09,Default,,0,0,0,,Анаңның айтқанын мұқият тыңда.
Dialogue: 0,0:11:25.09,0:11:27.03,Default,,0,0,0,,Мен кетейін деп жатырмын
Dialogue: 0,0:11:40.03,0:11:41.01,Default,,0,0,0,,Иә
Dialogue: 0,0:12:16.09,0:12:19.08,Default,,0,0,0,,Бұл ақпарат дұрыс деп ойлаймын.
Dialogue: 0,0:12:21.01,0:12:23.00,Default,,0,0,0,,Бірақ қандай тосын сый!
Dialogue: 0,0:12:23.05,0:12:27.04,Default,,0,0,0,,Мен сізден мұндай нәрсені естимін деп күтпедім.
Dialogue: 0,0:12:33.00,0:12:34.00,Default,,0,0,0,,Таку
Dialogue: 0,0:12:35.01,0:12:37.05,Default,,0,0,0,,Әрқашан осылай аяқталады.
Dialogue: 0,0:12:39.04,0:12:41.05,Default,,0,0,0,,Delphi мәселесі шешілді.
Dialogue: 0,0:12:41.05,0:12:43.03,Default,,0,0,0,,Егер сіз ложаға көзіңізді жұмысаңыз,
Dialogue: 0,0:12:44.02,0:12:47.04,Default,,0,0,0,,Сізді шақырған кілемнің түсі ме?
Dialogue: 0,0:12:54.05,0:12:55.08,Default,,0,0,0,,Жақын келме
Dialogue: 0,0:12:56.04,0:12:59.01,Default,,0,0,0,,Бұл Неро Ванетти, солай ма?
Dialogue: 0,0:12:59.05,0:13:01.07,Default,,0,0,0,,Мен сенің жанкүйеріңмін
Dialogue: 0,0:13:02.00,0:13:04.09,Default,,0,0,0,,Иә, бұл үшін рахмет.
Dialogue: 0,0:13:05.03,0:13:08.03,Default,,0,0,0,,Әй, мені тыңдашы.
Dialogue: 0,0:13:08.03,0:13:10.08,Default,,0,0,0,,Мені отбасыңа қосшы, эй.
Dialogue: 0,0:13:10.08,0:13:12.03,Default,,0,0,0,,Ей, тез жоғалып кетейік.
Dialogue: 0,0:13:12.03,0:13:15.00,Default,,0,0,0,,Мұндай суық сөздерді айтпа.
Dialogue: 0,0:13:24.09,0:13:25.07,Default,,0,0,0,,Нерон
Dialogue: 0,0:13:46.05,0:13:47.08,Default,,0,0,0,,Бұл Фанго.
Dialogue: 0,0:13:48.03,0:13:50.02,Default,,0,0,0,,Ақырында мен оны орнаттым.
Dialogue: 0,0:13:50.06,0:13:56.03,Default,,0,0,0,,Бірақ Неронның бүгін осында болатынын санаулы адамдар ғана білді.
Dialogue: 0,0:13:59.03,0:14:01.06,Default,,0,0,0,,Сатқынды табыңыз
Dialogue: 0,0:14:02.08,0:14:04.04,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:14:05.00,0:14:06.08,Default,,0,0,0,,Сізді тыныштандыруға мүмкіндік жоқ.
Dialogue: 0,0:14:06.08,0:14:09.07,Default,,0,0,0,,Сәлем, Кортео-чан
Dialogue: 0,0:14:09.07,0:14:13.03,Default,,0,0,0,,Сені менің үйімде жасыру арзан.
Dialogue: 0,0:14:13.09,0:14:15.04,Default,,0,0,0,,Бірақ
Dialogue: 0,0:14:15.04,0:14:18.08,Default,,0,0,0,,Сонда сіздің сатқын екеніңіз ашылады.
Dialogue: 0,0:14:20.09,0:14:22.07,Default,,0,0,0,,Тек осыны ішіп, тынышталыңыз.
Dialogue: 0,0:14:30.01,0:14:32.06,Default,,0,0,0,,Келесі жолы Неронды ойнаймыз
Dialogue: 0,0:14:32.06,0:14:35.02,Default,,0,0,0,,Содан кейін Ванетти аяқталды.
Dialogue: 0,0:14:36.01,0:14:39.08,Default,,0,0,0,,Үйде ішімдік жасау арқылы көп ақша табуға болады.
Dialogue: 0,0:14:39.08,0:14:41.07,Default,,0,0,0,,Барлығы бақытты
Dialogue: 0,0:14:43.04,0:14:45.02,Default,,0,0,0,,Бақыттысың ба?
Dialogue: 0,0:14:45.02,0:14:47.09,Default,,0,0,0,,Иә Purpy
Dialogue: 0,0:14:50.03,0:14:52.04,Default,,0,0,0,,Бұл жаман ат, балам.
Dialogue: 0,0:14:53.07,0:14:56.05,Default,,0,0,0,,Ах, жақсы. Бұл алкоголь туралы.
Dialogue: 0,0:14:56.09,0:14:59.03,Default,,0,0,0,,Ой, үйге жаяу барасың ба?
Dialogue: 0,0:15:00.08,0:15:05.02,Default,,0,0,0,,Барлығы, бұл жігіт, тек өзі туралы айтады.
Dialogue: 0,0:15:15.04,0:15:17.07,Default,,0,0,0,,Жоғары дабыл күйі дегеніміз не?
Dialogue: 0,0:15:18.04,0:15:21.08,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:15:19.02,0:15:20.05,Default,,0,0,0,,Нерон, бұл менмін.
Dialogue: 0,0:15:21.08,0:15:23.06,Default,,0,0,0,,Айтар сөзім бар, ашайық.
Dialogue: 0,0:15:26.02,0:15:29.03,Default,,0,0,0,,Не, Шикударе, менің сенімен шаруам жоқ.
Dialogue: 0,0:15:29.06,0:15:31.09,Default,,0,0,0,,Неронды енді ешкім кездестіре алмайды.
Dialogue: 0,0:15:31.09,0:15:35.02,Default,,0,0,0,,Әй, балақай, менің мұнда қанша уақыт болды деп ойлайсың?
Dialogue: 0,0:15:35.02,0:15:36.08,Default,,0,0,0,,Нерон туылғанға дейін...
Dialogue: 0,0:15:36.00,0:15:36.50,Default,,0,0,0,,Ағай
Dialogue: 0,0:15:39.01,0:15:40.09,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:15:50.07,0:15:52.00,Default,,0,0,0,,Ешкім кіре алмайды.
Dialogue: 0,0:16:05.07,0:16:06.06,Default,,0,0,0,,Кортео
Dialogue: 0,0:16:12.06,0:16:13.09,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:13.09,0:16:16.08,Default,,0,0,0,,Бұл жерде біразға дейін бетімді көрсете алмаймын деп ойлаймын.
Dialogue: 0,0:16:18.01,0:16:20.07,Default,,0,0,0,,Мақсатыңызға қалай жеттіңіз?
Dialogue: 0,0:16:20.09,0:16:24.00,Default,,0,0,0,,Бәрі де күдікті сияқты.
Dialogue: 0,0:16:24.07,0:16:26.01,Default,,0,0,0,,Мен де, сен де.
Dialogue: 0,0:16:28.02,0:16:31.00,Default,,0,0,0,,Ал, мұны маған қалдырыңыз.
Dialogue: 0,0:16:31.00,0:16:32.06,Default,,0,0,0,,А, бұл көмектеседі.
Dialogue: 0,0:17:10.06,0:17:13.05,Default,,0,0,0,,Атын есте сақта, бұл бірінші.
Dialogue: 0,0:17:13.05,0:17:14.03,Default,,0,0,0,,Иә
Dialogue: 0,0:17:14.06,0:17:16.09,Default,,0,0,0,,Сигіңіз келсе, тықылдатыңыз.
Dialogue: 0,0:17:17.06,0:17:19.05,Default,,0,0,0,,Шақырылған қонақтардың тізімі
Dialogue: 0,0:17:19.05,0:17:22.07,Default,,0,0,0,,Қарсы тараптың жауабын күткеннен басқасы.
Dialogue: 0,0:17:22.07,0:17:25.07,Default,,0,0,0,,Мен білмейтін есімдер көп. Жарайды ма?
Dialogue: 0,0:17:26.01,0:17:27.08,Default,,0,0,0,,Дұрыс тексеріп, қоңырау шалыңыз.
Dialogue: 0,0:17:28.00,0:17:29.01,Default,,0,0,0,,Осылайша, қарындас мектептер арасындағы алмасу шарасы—
Dialogue: 0,0:17:38.01,0:17:39.05,Default,,0,0,0,,Бұл қалай?
Dialogue: 0,0:17:40.07,0:17:42.01,Default,,0,0,0,,Әдемі әткеншек
Dialogue: 0,0:17:42.01,0:17:46.02,Default,,0,0,0,,Бұл Кортео туралы. Нерон туралы ақпарат алдыңыз ба?
Dialogue: 0,0:17:46.02,0:17:48.05,Default,,0,0,0,,Әлі ештеңе жоқ
Dialogue: 0,0:17:51.04,0:17:54.02,Default,,0,0,0,,Қымбаттым, ерекше қонақ.
Dialogue: 0,0:17:57.04,0:17:59.02,Default,,0,0,0,,Сіз әлі осы қаладасыз ба?
Dialogue: 0,0:17:59.02,0:18:01.06,Default,,0,0,0,,Бұрынғы сот орындаушысы
Dialogue: 0,0:18:02.01,0:18:06.00,Default,,0,0,0,,Сізге рахмет, мен жұмысқа қайта ораламын.
Dialogue: 0,0:18:07.04,0:18:10.03,Default,,0,0,0,,Мен таң қалдым, виолончель емес пе?
Dialogue: 0,0:18:10.03,0:18:12.02,Default,,0,0,0,,Сәлеметсіз бе, Скуза мырза.
Dialogue: 0,0:18:13.09,0:18:15.04,Default,,0,0,0,,Сен мұнда болғансың ғой.
Dialogue: 0,0:18:15.07,0:18:18.01,Default,,0,0,0,,Иә, жақсы...
Dialogue: 0,0:18:20.06,0:18:22.03,Default,,0,0,0,,Ой… ой, жоқ
Dialogue: 0,0:18:23.04,0:18:26.05,Default,,0,0,0,,Ал Кортео ше?
Dialogue: 0,0:18:26.08,0:18:29.05,Default,,0,0,0,,Ол тым көп біледі
Dialogue: 0,0:18:36.02,0:18:38.06,Default,,0,0,0,,Осы сағатта сізге телефон соғудың мәні неде?
Dialogue: 0,0:18:42.01,0:18:44.03,Default,,0,0,0,,Бүгін түн өте тыныш, солай емес пе?
Dialogue: 0,0:18:45.04,0:18:48.09,Default,,0,0,0,,Соңғы кездері бұл қалада жағдай барған сайын алаңдатады.
Dialogue: 0,0:18:51.08,0:18:54.08,Default,,0,0,0,,Мен жай ғана Чикагоға баруым керек пе?
Dialogue: 0,0:18:56.01,0:18:57.07,Default,,0,0,0,,Сондай-ақ тыйым салатын заң бар
Dialogue: 0,0:18:57.07,0:19:00.07,Default,,0,0,0,,Рецепт сізде болғанша...
Dialogue: 0,0:19:02.05,0:19:04.03,Default,,0,0,0,,Сен нені айтып тұрсың?
Dialogue: 0,0:19:07.06,0:19:10.05,Default,,0,0,0,,Жоқ, мен ішімдіктің иісіне шыдамаймын.
Dialogue: 0,0:19:11.02,0:19:12.08,Default,,0,0,0,,Мен мас болып бара жатырмын
Dialogue: 0,0:19:25.06,0:19:29.04,Default,,0,0,0,,Менің сарайыма қош келдіңіз
Dialogue: 0,0:19:30.00,0:19:32.00,Default,,0,0,0,,Ішіп алсақ қайтеді?
Dialogue: 0,0:19:33.07,0:19:36.02,Default,,0,0,0,,Сол оқиға...
Dialogue: 0,0:19:36.09,0:19:38.06,Default,,0,0,0,,Қысқа болыңыз
Dialogue: 0,0:19:40.03,0:19:43.06,Default,,0,0,0,,Мен сенімен жұмыс істеуді тоқтаттым.
Dialogue: 0,0:19:47.04,0:19:51.01,Default,,0,0,0,,Шынымды айтсам, енді маған пайдасы жоқ.
Dialogue: 0,0:19:55.02,0:19:56.09,Default,,0,0,0,,Бірақ алкоголь
Dialogue: 0,0:19:57.07,0:19:59.07,Default,,0,0,0,,Менің сусынымды қаламайсың ба?
Dialogue: 0,0:20:01.04,0:20:04.00,Default,,0,0,0,,Алдымен ішіп, тынышталыңыз.
Dialogue: 0,0:20:11.00,0:20:12.06,Default,,0,0,0,,Заңсыз аспан
Dialogue: 0,0:20:13.03,0:20:14.03,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:20:17.09,0:20:18.06,Default,,0,0,0,,Рецепт
Dialogue: 0,0:20:19.00,0:20:20.04,Default,,0,0,0,,Бұл Скуза.
Dialogue: 0,0:20:20.05,0:20:24.03,Default,,0,0,0,,Үлкен мұрынды тәркілегенде көшіріп алған.
Dialogue: 0,0:20:24.03,0:20:27.09,Default,,0,0,0,,Олар тіпті үлгіні мұқият жасады.
Dialogue: 0,0:20:30.03,0:20:33.01,Default,,0,0,0,,Бұл соққы дұрыс
Dialogue: 0,0:20:36.02,0:20:40.07,Default,,0,0,0,,Бірақ ол шынымен де адам баласы.
Dialogue: 0,0:20:41.04,0:20:45.03,Default,,0,0,0,,Олар бұл жігітті күлкілі қымбат бағаға сатты.
Dialogue: 0,0:20:46.09,0:20:52.03,Default,,0,0,0,,Әйтеуір, маған енді саған бәрібір.
Dialogue: 0,0:21:20.09,0:21:24.06,Default,,0,0,0,,Ал, жоғалып кет.
Dialogue: 0,0:21:26.04,0:21:31.06,Default,,0,0,0,,Айырбастап, Неронға сатқынның кім екенін айтамын ба деп ойлаймын.
Dialogue: 0,0:21:39.04,0:21:42.07,Default,,0,0,0,,Эй, бұл оператор Банеттидің үйі.
Dialogue: 0,0:21:42.07,0:21:45.04,Default,,0,0,0,,Мені Неро Ванеттимен байланыстырыңыз.
Dialogue: 0,0:21:49.03,0:21:50.02,Default,,0,0,0,,Не?
Dialogue: 0,0:21:50.09,0:21:55.06,Default,,0,0,0,,Мен? Менің атым Фанго.
Dialogue: 0,0:22:09.08,0:22:12.08,Default,,0,0,0,,Мен сенің қайда кеткеніңді көріп тұрмын.
Dialogue: 0,0:22:14.07,0:22:18.02,Default,,0,0,0,,Жақсы емес пе, бала?
Dialogue: 0,0:22:19.52,0:22:24.52,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
