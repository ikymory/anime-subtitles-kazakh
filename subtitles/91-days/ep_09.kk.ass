Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:02:26.00,0:02:31.00,Default,,0,0,0,,Лак-қара амбиция
Dialogue: 0,0:02:31.00,0:02:34.00,Default,,0,0,0,,Негізгі субтитр Ю✿Гүл тілі және Чинатсу субтитр тобы✿Бірлескен өндіріс
Dialogue: 0,0:02:55.02,0:02:57.04,Default,,0,0,0,,Неронды нысанаға алдың?
Dialogue: 0,0:02:58.05,0:03:00.03,Default,,0,0,0,,Бұл кімдікі?
Dialogue: 0,0:02:59.06,0:03:01.01,Default,,0,0,0,,Неліктен Кортео?
Dialogue: 0,0:03:04.07,0:03:08.00,Default,,0,0,0,,Фангода Неронның қимылдары ойналды
Dialogue: 0,0:03:08.00,0:03:09.09,Default,,0,0,0,,Мен де кеше аралға келдім.
Dialogue: 0,0:03:11.03,0:03:14.07,Default,,0,0,0,,Сондықтан ол Кортеоның ақпаратын сыйлық ретінде қабылдады.
Dialogue: 0,0:03:14.07,0:03:16.05,Default,,0,0,0,,Сол үшін жылап келдім.
Dialogue: 0,0:03:16.08,0:03:19.06,Default,,0,0,0,,Жоғары сізбен күш біріктіргісі келеді.
Dialogue: 0,0:03:20.01,0:03:24.06,Default,,0,0,0,,Фангосыз біз біттік.
Dialogue: 0,0:03:28.01,0:03:32.04,Default,,0,0,0,,Сен бізге Орконнан келдің.
Dialogue: 0,0:03:32.04,0:03:34.05,Default,,0,0,0,,Иә, бұл Камеро.
Dialogue: 0,0:03:35.06,0:03:38.07,Default,,0,0,0,,Жылы ештеңе жасамаңыз. Одан құтыл.
Dialogue: 0,0:03:40.06,0:03:42.08,Default,,0,0,0,,Неронды нысанаға алдың?
Dialogue: 0,0:03:44.05,0:03:47.01,Default,,0,0,0,,Фангомен не жоспарладыңыз?
Dialogue: 0,0:03:53.02,0:03:54.07,Default,,0,0,0,,Басқа серіктестер
Dialogue: 0,0:03:55.04,0:03:57.00,Default,,0,0,0,,Бірдеңе айт
Dialogue: 0,0:04:12.04,0:04:14.00,Default,,0,0,0,,Мен ештеңе істей алмаймын
Dialogue: 0,0:04:15.06,0:04:17.03,Default,,0,0,0,,Кортео өлсін
Dialogue: 0,0:04:19.01,0:04:21.00,Default,,0,0,0,,Нерон, маған бір сәт болады ма?
Dialogue: 0,0:04:24.08,0:04:28.05,Default,,0,0,0,,Ертең таңертең мен Фанго отбасының басшыларына қоңырау шалдым.
Dialogue: 0,0:04:29.02,0:04:30.04,Default,,0,0,0,,Әңгімелесейік
Dialogue: 0,0:04:30.07,0:04:32.00,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:04:32.07,0:04:35.03,Default,,0,0,0,,Сонымен, сіз Кортео туралы айтып отырсыз.
Dialogue: 0,0:04:37.00,0:04:38.07,Default,,0,0,0,,Оны алып тастай аласыз ба?
Dialogue: 0,0:04:50.08,0:04:52.03,Default,,0,0,0,,Сол Фанго.
Dialogue: 0,0:04:52.03,0:04:54.00,Default,,0,0,0,,Мен әлі де сенбеймін.
Dialogue: 0,0:04:54.05,0:04:55.08,Default,,0,0,0,,О, Авильо
Dialogue: 0,0:04:58.04,0:05:00.05,Default,,0,0,0,,Ей, бұл жер шатастырылған.
Dialogue: 0,0:05:01.00,0:05:03.04,Default,,0,0,0,,Менің ойымша, сіз Кортеомен араласа алмайсыз.
Dialogue: 0,0:05:04.00,0:05:06.06,Default,,0,0,0,,Ол не деді?
Dialogue: 0,0:05:08.00,0:05:10.03,Default,,0,0,0,,Бұл ештеңе айтпайды.
Dialogue: 0,0:05:10.07,0:05:12.07,Default,,0,0,0,,Біраз уақыт алатын сияқты.
Dialogue: 0,0:05:13.00,0:05:17.02,Default,,0,0,0,,Бірақ осылай қарасақ, Ганзо мырза мұны істемекші сияқты.
Dialogue: 0,0:05:17.09,0:05:21.08,Default,,0,0,0,,Ағай, Неронға келгенде басыма қан жүгіреді.
Dialogue: 0,0:05:22.02,0:05:23.06,Default,,0,0,0,,Импульс тым көп...
Dialogue: 0,0:05:26.06,0:05:27.08,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:28.03,0:05:29.00,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:18.08,0:06:20.07,Default,,0,0,0,,Авильо Бұл менмін.
Dialogue: 0,0:06:24.09,0:06:28.02,Default,,0,0,0,,Түсіндім, сен қамауға алындың ғой.
Dialogue: 0,0:06:30.08,0:06:34.00,Default,,0,0,0,,Мен істей алатын бірдеңе бар ма?
Dialogue: 0,0:06:35.09,0:06:38.06,Default,,0,0,0,,Мен...ол жігіт...
Dialogue: 0,0:06:38.06,0:06:39.08,Default,,0,0,0,,Не болды
Dialogue: 0,0:06:41.05,0:06:43.01,Default,,0,0,0,,Неліктен Кортео Фангоды ойнайды?
Dialogue: 0,0:06:45.07,0:06:48.06,Default,,0,0,0,,Кортеоны Фанго сатып жіберді.
Dialogue: 0,0:06:49.09,0:06:52.03,Default,,0,0,0,,Скузадан рецепт алғаннан кейін
Dialogue: 0,0:06:53.03,0:06:55.05,Default,,0,0,0,,Ол әлдеқашан қолданылған.
Dialogue: 0,0:06:56.09,0:07:00.03,Default,,0,0,0,,Мен мұндай нәрсе болады деп ешқашан күтпедім.
Dialogue: 0,0:07:01.03,0:07:05.00,Default,,0,0,0,,Мен бала кезімнен мафияны жек көретінмін.
Dialogue: 0,0:07:05.04,0:07:08.05,Default,,0,0,0,,Бұл ирониялық, шындап келгенде.
Dialogue: 0,0:07:10.04,0:07:11.08,Default,,0,0,0,,Неге ол жігіт?
Dialogue: 0,0:07:11.08,0:07:14.04,Default,,0,0,0,,Ол тіпті Неронды ойнау үшін Фангомен бірігіп кетті.
Dialogue: 0,0:07:19.01,0:07:21.00,Default,,0,0,0,,Сіз мені араластырдыңыз, солай емес пе?
Dialogue: 0,0:08:08.08,0:08:10.08,Default,,0,0,0,,Әй, біреу келші.
Dialogue: 0,0:08:15.01,0:08:17.05,Default,,0,0,0,,Қарғыс атсын, қарғыс атсын.
Dialogue: 0,0:08:17.09,0:08:20.03,Default,,0,0,0,,Ол артқы жағында. Терезеден жүгіріңіз.
Dialogue: 0,0:08:21.02,0:08:22.01,Default,,0,0,0,,Ағай
Dialogue: 0,0:08:22.03,0:08:23.06,Default,,0,0,0,,Кортео қашып кетті
Dialogue: 0,0:08:23.06,0:08:24.06,Default,,0,0,0,,Айналыңыз
Dialogue: 0,0:08:26.03,0:08:28.03,Default,,0,0,0,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:08:30.01,0:08:31.03,Default,,0,0,0,,Колизейдің кіреберісі ғой?
Dialogue: 0,0:08:39.07,0:08:41.04,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:08:41.04,0:08:43.02,Default,,0,0,0,,Мен сені тыңдаймын.
Dialogue: 0,0:08:44.00,0:08:47.05,Default,,0,0,0,,Кенет мына ақымақ маған мылтық сілтеді.
Dialogue: 0,0:08:48.04,0:08:49.05,Default,,0,0,0,,Қайда ол? Сол кілтке ұқсас зат қайда…
Dialogue: 0,0:08:51.01,0:08:53.07,Default,,0,0,0,,Мен оны ұнатпаймын деп ойладым.
Dialogue: 0,0:08:54.06,0:08:55.08,Default,,0,0,0,,Бұл туралы сен бәрінен жақсы білуің керек
Dialogue: 0,0:08:57.07,0:08:58.08,Default,,0,0,0,,Оларға қашып кетуге жол бермеңдер
Dialogue: 0,0:09:00.06,0:09:03.03,Default,,0,0,0,,Мен қаладан шығатын жолды тоқтатамын.
Dialogue: 0,0:09:51.02,0:09:51.52,Default,,0,0,0,,Нерон
Dialogue: 0,0:09:53.06,0:09:55.04,Default,,0,0,0,,Бұл Авильо туралы.
Dialogue: 0,0:09:56.04,0:09:58.09,Default,,0,0,0,,Ол және Кортео ескі достар.
Dialogue: 0,0:09:59.05,0:10:02.09,Default,,0,0,0,,Оның үстіне мен Кортеоны бұдан былай қорғаймын.
Dialogue: 0,0:10:03.09,0:10:04.09,Default,,0,0,0,,Меніңше...
Dialogue: 0,0:10:04.09,0:10:07.09,Default,,0,0,0,,Себебі біз бала кезден доспыз.
Dialogue: 0,0:10:07.09,0:10:12.05,Default,,0,0,0,,Барберо Әр нәрсеге тым күдікпен қарайтын сенің жаман әдетің.
Dialogue: 0,0:10:14.00,0:10:16.02,Default,,0,0,0,,Алдымен Кортеоны табыңыз.
Dialogue: 0,0:10:16.05,0:10:18.03,Default,,0,0,0,,Мұның бәрі бар.
Dialogue: 0,0:10:21.09,0:10:25.00,Default,,0,0,0,,Иә, тапсаңыз маған хабарлаңыз.
Dialogue: 0,0:10:38.09,0:10:40.01,Default,,0,0,0,,Кортео
Dialogue: 0,0:10:42.05,0:10:43.05,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:10:48.04,0:10:50.00,Default,,0,0,0,,Мен өлтіремін...
Dialogue: 0,0:10:50.08,0:10:52.09,Default,,0,0,0,,...Сіз Неронды өлтіруіңіз керек
Dialogue: 0,0:10:54.01,0:10:55.04,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:10:56.01,0:10:57.00,Default,,0,0,0,,Ертең
Dialogue: 0,0:10:58.00,0:11:00.03,Default,,0,0,0,,Мен осы уақытта тағы барамын
Dialogue: 0,0:11:01.08,0:11:06.03,Default,,0,0,0,,Нерон осы уақытқа дейін өлмеген болса, мен үшін өмір жоқ.
Dialogue: 0,0:11:09.01,0:11:10.03,Default,,0,0,0,,Сіз кіммен біргесіз?
Dialogue: 0,0:11:11.03,0:11:13.03,Default,,0,0,0,,Сол хатты жіберуші...
Dialogue: 0,0:11:41.04,0:11:42.04,Default,,0,0,0,,Шынымен
Dialogue: 0,0:11:43.00,0:11:44.08,Default,,0,0,0,,Рагусаны айттыңыз ба?
Dialogue: 0,0:11:46.04,0:11:48.05,Default,,0,0,0,,Сіз жалғыз емес сияқтысыз
Dialogue: 0,0:11:50.06,0:11:52.05,Default,,0,0,0,,Мені қосқанда төрт адам бар.
Dialogue: 0,0:11:54.00,0:11:55.09,Default,,0,0,0,,Басқа адамнан кейін
Dialogue: 0,0:12:46.02,0:12:47.08,Default,,0,0,0,,Бұл алаңсыз.
Dialogue: 0,0:12:49.00,0:12:51.06,Default,,0,0,0,,Мен Фанго сияқты ақымақпын
Dialogue: 0,0:12:52.02,0:12:53.06,Default,,0,0,0,,Кортеоның қадамдары
Dialogue: 0,0:12:55.03,0:12:56.07,Default,,0,0,0,,Мен оны әлі ала алмаймын
Dialogue: 0,0:12:59.02,0:13:03.09,Default,,0,0,0,,Бүгін ең бастысы жиналып, отбасының болашағы туралы әңгімелесу болды.
Dialogue: 0,0:13:03.09,0:13:06.03,Default,,0,0,0,,Фангодағы жігіт те шаршады.
Dialogue: 0,0:13:08.00,0:13:09.06,Default,,0,0,0,,Сіз де қатыса аласыз.
Dialogue: 0,0:13:11.02,0:13:12.00,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:13:24.08,0:13:27.00,Default,,0,0,0,,Ағай, жараларыңыз қалай?
Dialogue: 0,0:13:28.00,0:13:30.09,Default,,0,0,0,,Бұл аздап ауырады, бірақ бұл үлкен мәселе емес.
Dialogue: 0,0:13:30.09,0:13:32.06,Default,,0,0,0,,Оның орнына ол
Dialogue: 0,0:13:32.06,0:13:34.01,Default,,0,0,0,,Әлі табылмады
Dialogue: 0,0:13:34.06,0:13:36.05,Default,,0,0,0,,Бұл жай ғана уақыт мәселесі ме?
Dialogue: 0,0:14:05.06,0:14:08.00,Default,,0,0,0,,Сізді шақырғаным үшін кешіріңіз.
Dialogue: 0,0:14:08.05,0:14:09.04,Default,,0,0,0,,Әке
Dialogue: 0,0:14:10.00,0:14:14.00,Default,,0,0,0,,Барберо енді отбасында басшы болып жұмыс істейтін болады.
Dialogue: 0,0:14:14.06,0:14:18.00,Default,,0,0,0,,Мен сізге көбірек адалдық танытамын.
Dialogue: 0,0:14:19.00,0:14:22.08,Default,,0,0,0,,Жаңа Авильо Брнодан кейін
Dialogue: 0,0:14:23.07,0:14:25.00,Default,,0,0,0,,Бұл алкоголь?
Dialogue: 0,0:14:25.08,0:14:28.04,Default,,0,0,0,,Әй, мына жігіт әкелді.
Dialogue: 0,0:14:29.00,0:14:31.01,Default,,0,0,0,,Оның ерік-жігері көп.
Dialogue: 0,0:14:36.05,0:14:38.01,Default,,0,0,0,,Мен Неронды сұрадым.
Dialogue: 0,0:14:39.03,0:14:41.04,Default,,0,0,0,,Жарайды, Дон.
Dialogue: 0,0:14:43.06,0:14:46.08,Default,,0,0,0,,Балалар білмегенше ересек болады.
Dialogue: 0,0:14:47.02,0:14:49.03,Default,,0,0,0,,Мен саған сонша қамқорлық жасасам да.
Dialogue: 0,0:14:50.09,0:14:53.07,Default,,0,0,0,,Фрат қайтыс болды, Фио да кетті.
Dialogue: 0,0:14:56.06,0:15:00.04,Default,,0,0,0,,Нерон, мен сені кінәлап отырған жоқпын.
Dialogue: 0,0:15:00.04,0:15:03.05,Default,,0,0,0,,Барлығы отбасын қорғау үшін болды.
Dialogue: 0,0:15:04.05,0:15:10.06,Default,,0,0,0,,Мен Рональдты қарсы алу отбасын қорғаудың жолы деп ойладым.
Dialogue: 0,0:15:11.00,0:15:16.01,Default,,0,0,0,,Мен сіздің емес, Рональдтың сөзін қабылдадым.
Dialogue: 0,0:15:17.00,0:15:21.01,Default,,0,0,0,,Бірақ бұл Фрейтті одан әрі өсірді
Dialogue: 0,0:15:21.04,0:15:24.08,Default,,0,0,0,,Өйткені, Рональд аутсайдер.
Dialogue: 0,0:15:24.08,0:15:28.06,Default,,0,0,0,,Иә, мен қателесіппін.
Dialogue: 0,0:15:29.06,0:15:34.04,Default,,0,0,0,,Дон ретінде мен отбасы үшін ең жақсы нәрсені істеп жатырмын деп ойладым.
Dialogue: 0,0:15:34.07,0:15:36.05,Default,,0,0,0,,Мұндай нәрсе жоқ
Dialogue: 0,0:15:36.05,0:15:40.00,Default,,0,0,0,,Демек, бұл дана қарттың даналығы ғана.
Dialogue: 0,0:15:40.08,0:15:44.01,Default,,0,0,0,,Жетер, бәрі бітті.
Dialogue: 0,0:15:44.01,0:15:45.05,Default,,0,0,0,,Сол бала...
Dialogue: 0,0:15:46.01,0:15:51.00,Default,,0,0,0,,Егер Фрейт өлмегенде, Галассия үнсіз қалмас еді.
Dialogue: 0,0:15:51.06,0:15:55.06,Default,,0,0,0,,Нерон, сен не істеу керектігін істедің.
Dialogue: 0,0:15:57.02,0:16:01.08,Default,,0,0,0,,Қозғалмайтынға аспан қолын созбайды.
Dialogue: 0,0:16:03.07,0:16:07.07,Default,,0,0,0,,Бұдан былай сен осында отырасың.
Dialogue: 0,0:16:49.07,0:16:52.01,Default,,0,0,0,,Менің ойымша, сіз бұрыннан білесіз.
Dialogue: 0,0:16:52.01,0:16:55.07,Default,,0,0,0,,Фанго отбасы бізге қосылды
Dialogue: 0,0:16:55.07,0:16:57.00,Default,,0,0,0,,Сондықтан қазірден бастап
Dialogue: 0,0:16:57.00,0:17:00.04,Default,,0,0,0,,Аралдарға назар аудара отырып, сату арналарына шолу
Dialogue: 0,0:17:00.07,0:17:04.06,Default,,0,0,0,,Қайта құруды жалғастырыңыз және бір уақытта ложаның көлемін кеңейтіңіз
Dialogue: 0,0:17:05.02,0:17:07.03,Default,,0,0,0,,Біз жаппай өндіріске де назар аударамыз.
Dialogue: 0,0:17:08.06,0:17:11.01,Default,,0,0,0,,Заңсыз аспанға қатысты
Dialogue: 0,0:17:11.04,0:17:14.04,Default,,0,0,0,,Біз жақында Чикагоға көтерме саудаға дайындықты бастаймыз.
Dialogue: 0,0:17:14.06,0:17:18.01,Default,,0,0,0,,Чикаго ?Гарасия, өтінемін, үндемеңіз.
Dialogue: 0,0:17:18.01,0:17:20.00,Default,,0,0,0,,Әрине, мен баяндаманы тапсырамын.
Dialogue: 0,0:17:21.00,0:17:22.03,Default,,0,0,0,,Сол кезде мен өзімді жеңілген адам ретінде өмір сүруді бастадым.
Dialogue: 0,0:17:22.03,0:17:24.08,Default,,0,0,0,,Театрдың ашылуында кездескенше
Dialogue: 0,0:17:24.08,0:17:28.01,Default,,0,0,0,,Мен алкогольді Дон Галассияға алдын ала жеткізгім келеді.
Dialogue: 0,0:17:28.07,0:17:29.05,Default,,0,0,0,,Авильо
Dialogue: 0,0:17:30.02,0:17:32.00,Default,,0,0,0,,Менің орныма кетіңізші.
Dialogue: 0,0:17:32.00,0:17:34.07,Default,,0,0,0,,Күте тұр, Нерон, мен барамын.
Dialogue: 0,0:17:34.07,0:17:36.00,Default,,0,0,0,,Авильо әлі де...
Dialogue: 0,0:17:36.00,0:17:38.07,Default,,0,0,0,,Жоқ, мен бұл жолы оны Авильоға қалдырамын.
Dialogue: 0,0:17:38.07,0:17:41.04,Default,,0,0,0,,Бізде театр дайын.
Dialogue: 0,0:17:42.06,0:17:43.06,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:17:45.07,0:17:46.07,Default,,0,0,0,,Мен оны сұрадым.
Dialogue: 0,0:17:47.05,0:17:51.03,Default,,0,0,0,,Әке, жақында театрда дайындық басталады.
Dialogue: 0,0:17:51.08,0:17:53.03,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:17:53.08,0:17:56.07,Default,,0,0,0,,Иә, мен оны асыға күтемін.
Dialogue: 0,0:18:07.02,0:18:09.00,Default,,0,0,0,,Нерон Дон ба?
Dialogue: 0,0:18:09.07,0:18:13.06,Default,,0,0,0,,Жарайды, сенің дон бола алатыныңа сенімдімін.
Dialogue: 0,0:18:15.02,0:18:18.03,Default,,0,0,0,,Әкемнің қасындағы адам кім болды?
Dialogue: 0,0:18:18.05,0:18:21.02,Default,,0,0,0,,Сіз дель Торо туралы айтып отырсыз ба?
Dialogue: 0,0:18:21.04,0:18:23.03,Default,,0,0,0,,Мен сенің сөйлегеніңді көрген емеспін.
Dialogue: 0,0:18:23.06,0:18:28.00,Default,,0,0,0,,Көбінесе Бірінші дүниежүзілік соғыс Бұрынғы соғыста жойылған көрінеді.
Dialogue: 0,0:18:28.01,0:18:32.06,Default,,0,0,0,,Еуропада соғысып жүргенде мен әкемнің қол астындағы адам едім.
Dialogue: 0,0:18:32.06,0:18:34.07,Default,,0,0,0,,Бұл өте ескі қор.
Dialogue: 0,0:18:35.07,0:18:39.06,Default,,0,0,0,,Ол кісі міндетті түрде кеңседе болды.
Dialogue: 0,0:18:40.00,0:18:41.09,Default,,0,0,0,,Отбасы жұмысына байланысты.
Dialogue: 0,0:18:41.09,0:18:43.09,Default,,0,0,0,,Иә...
Dialogue: 0,0:18:44.05,0:18:47.03,Default,,0,0,0,,Өткен жылдың алдында шыққан.
Dialogue: 0,0:18:47.09,0:18:49.07,Default,,0,0,0,,Оның ішінде қанша болды?
Dialogue: 0,0:18:49.07,0:18:52.08,Default,,0,0,0,,Міне, бес жылдай болды.
Dialogue: 0,0:18:53.05,0:18:55.07,Default,,0,0,0,,Кеңсе осыдан жеті жыл бұрын ашылған.
Dialogue: 0,0:18:57.02,0:19:01.00,Default,,0,0,0,,Сіздің алғашқы жұмысыңыз дәл солай болды ма?
Dialogue: 0,0:19:01.03,0:19:04.04,Default,,0,0,0,,Жоқ, мен келуім керек еді.
Dialogue: 0,0:19:04.04,0:19:06.08,Default,,0,0,0,,Мен сол бұрынғы кеңсеге кірдім.
Dialogue: 0,0:19:08.05,0:19:09.08,Default,,0,0,0,,Бұл иіссіз.
Dialogue: 0,0:19:22.07,0:19:23.06,Default,,0,0,0,,Ертең
Dialogue: 0,0:19:24.06,0:19:26.08,Default,,0,0,0,,Сондай-ақ осы уақытта қоңырау шалыңыз
Dialogue: 0,0:19:28.03,0:19:32.07,Default,,0,0,0,,Нерон сол кезде өлмесе, мен үшін өмір жоқ.
Dialogue: 0,0:19:54.04,0:19:57.08,Default,,0,0,0,,Ганзоның ағасы сізді көп сатып алды.
Dialogue: 0,0:19:58.09,0:20:00.01,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:20:00.04,0:20:04.05,Default,,0,0,0,,Ол мені сені сонда апаруға мәжбүр етті.
Dialogue: 0,0:20:05.03,0:20:10.00,Default,,0,0,0,,Мен таң қалдым, әйтеуір, ескішіл қария екен.
Dialogue: 0,0:20:10.03,0:20:14.04,Default,,0,0,0,,Мен бірден қарсылыққа тап боламын деп ойладым, бірақ бұл керісінше болды.
Dialogue: 0,0:20:17.06,0:20:18.07,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:26.06,0:20:29.05,Default,,0,0,0,,Сенің танылғаныңа қуаныштымын.
Dialogue: 0,0:20:31.01,0:20:33.02,Default,,0,0,0,,Мен қатты маспын. Мен бірінші үйге барамын.
Dialogue: 0,0:20:38.06,0:20:40.01,Default,,0,0,0,,Жеті жыл бұрын
Dialogue: 0,0:20:41.04,0:20:44.09,Default,,0,0,0,,Әкем мені алғаш жұмысқа апарған түні
Dialogue: 0,0:20:47.09,0:20:50.00,Default,,0,0,0,,Қашып кеткен бала ғана емес
Dialogue: 0,0:20:51.05,0:20:53.09,Default,,0,0,0,,Ешкім ата алмады
Dialogue: 0,0:20:57.05,0:20:59.04,Default,,0,0,0,,Мен атуға қорықтым
Dialogue: 0,0:21:00.08,0:21:03.02,Default,,0,0,0,,Мен әкемнің құрметсіздігін сезіндім.
Dialogue: 0,0:21:05.00,0:21:09.03,Default,,0,0,0,,Сондықтан әкемнің разылығын алу үшін Мүшараға келдім.
Dialogue: 0,0:21:10.02,0:21:11.06,Default,,0,0,0,,Мен өлтірдім
Dialogue: 0,0:21:14.08,0:21:18.07,Default,,0,0,0,,Және Фрат...
Dialogue: 0,0:21:20.02,0:21:24.03,Default,,0,0,0,,Ақырында, содан бері ештеңе өзгермеген шығар.
Dialogue: 0,0:21:25.01,0:21:27.00,Default,,0,0,0,,Бірақ сіз мұны қазір жасай аласыз.
Dialogue: 0,0:21:28.09,0:21:31.01,Default,,0,0,0,,Жеті жыл бұрын мен кадрды жіберіп алғанмын.
Dialogue: 0,0:21:31.05,0:21:32.08,Default,,0,0,0,,Әлгі жігіт
Dialogue: 0,0:22:34.05,0:22:36.02,Default,,0,0,0,,Менің ойымша, бұл сіз болдыңыз.
Dialogue: 0,0:22:38.07,0:22:41.04,Default,,0,0,0,,Дұрыс, Анджело.
Dialogue: 0,0:22:42.54,0:22:47.54,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
