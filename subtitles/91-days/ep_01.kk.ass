Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.03,0:00:09.01,Default,,0,0,0,,Шынында да жаңбыр көп жауады.
Dialogue: 0,0:00:09.07,0:00:12.08,Default,,0,0,0,,Менің кірлерім кептірілмейді.
Dialogue: 0,0:00:15.03,0:00:16.07,Default,,0,0,0,,Бруно мырза
Dialogue: 0,0:00:17.01,0:00:18.00,Default,,0,0,0,,Хаха… бұл қызық екен.
Dialogue: 0,0:00:18.00,0:00:20.04,Default,,0,0,0,,Анджело: Рагуса бар.
Dialogue: 0,0:00:20.04,0:00:22.08,Default,,0,0,0,,Мекенжай сіздің бөлмеңіз...
Dialogue: 0,0:00:24.02,0:00:26.00,Default,,0,0,0,,сенікі не?
Dialogue: 0,0:00:30.00,0:00:35.00,Default,,0,0,0,,Түпнұсқа субтитрлер ✿ Гүл тілі және Чинатсу субтитр тобы ✿ Бірлескен туынды
Dialogue: 0,0:00:35.00,0:00:36.09,Default,,0,0,0,,Бұл жиіркенішті.
Dialogue: 0,0:00:37.05,0:00:39.09,Default,,0,0,0,,Сіз тірісіз бе, әлде өлісіз бе?
Dialogue: 0,0:01:14.00,0:01:15.05,Default,,0,0,0,,Banettii
Dialogue: 0,0:01:20.09,0:01:25.09,Default,,0,0,0,,1-күн Кісі өлтіру түні
Dialogue: 0,0:01:38.07,0:01:40.07,Default,,0,0,0,,Ыстық емес
Dialogue: 0,0:01:40.07,0:01:41.06,Default,,0,0,0,,Иә
Dialogue: 0,0:01:41.06,0:01:43.05,Default,,0,0,0,,Жанып тұрған фитиль емес
Dialogue: 0,0:01:43.05,0:01:46.00,Default,,0,0,0,,Парафин – шырақ құрамдас бөлігі.
Dialogue: 0,0:01:46.00,0:01:47.00,Default,,0,0,0,,Өзегін таңдасаңыз да...
Dialogue: 0,0:01:47.00,0:01:48.01,Default,,0,0,0,,Содан кейін орындаңыз.
Dialogue: 0,0:02:16.03,0:02:18.09,Default,,0,0,0,,Уау, ыстық емес.
Dialogue: 0,0:02:18.09,0:02:20.01,Default,,0,0,0,,А, қараңдаршы
Dialogue: 0,0:02:21.05,0:02:23.08,Default,,0,0,0,,Бірақ өте ыстық болған болуы керек.
Dialogue: 0,0:02:23.08,0:02:24.08,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:02:25.07,0:02:27.03,Default,,0,0,0,,Маған тезірек үйге бару керек.
Dialogue: 0,0:02:28.07,0:02:31.02,Default,,0,0,0,,Тортты бірге жейміз
Dialogue: 0,0:02:31.04,0:02:32.08,Default,,0,0,0,,Келесі кездескенше
Dialogue: 0,0:02:33.03,0:02:34.09,Default,,0,0,0,,Торт дәмді.
Dialogue: 0,0:02:35.04,0:02:36.08,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:02:36.08,0:02:39.01,Default,,0,0,0,,Че, жарайды.
Dialogue: 0,0:02:39.01,0:02:42.01,Default,,0,0,0,,Кортео Анаңызбен бірге тамақтаныңыз.
Dialogue: 0,0:02:42.06,0:02:45.00,Default,,0,0,0,,Кейін Бұл көп емес, бірақ...
Dialogue: 0,0:02:49.00,0:02:51.02,Default,,0,0,0,,Кешіріңіз, әрқашан
Dialogue: 0,0:02:51.02,0:02:52.04,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:02:52.09,0:02:55.04,Default,,0,0,0,,Алдымен анаңның жағдайы қалай?
Dialogue: 0,0:02:56.06,0:02:58.09,Default,,0,0,0,,Соңғы кездері өте жақсы сияқты.
Dialogue: 0,0:02:59.02,0:03:01.03,Default,,0,0,0,,Бұл жақсы болар еді
Dialogue: 0,0:03:02.05,0:03:03.06,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:03:03.06,0:03:05.01,Default,,0,0,0,,Қайырлы түн Люс
Dialogue: 0,0:03:07.08,0:03:09.00,Default,,0,0,0,,Анджело
Dialogue: 0,0:03:09.09,0:03:12.09,Default,,0,0,0,,Шам: Сіз оны саусақпен сөндірдіңіз бе?
Dialogue: 0,0:03:16.04,0:03:18.07,Default,,0,0,0,,Сәуір болды ғой, солай емес пе?
Dialogue: 0,0:03:18.07,0:03:19.05,Default,,0,0,0,,Иә
Dialogue: 0,0:03:25.07,0:03:26.08,Default,,0,0,0,,Өз өмірімді өз шарттарыммен өткіземін
Dialogue: 0,0:03:26.08,0:03:28.00,Default,,0,0,0,,Жүрегім суып тұр
Dialogue: 0,0:03:28.00,0:03:29.06,Default,,0,0,0,,Туған күнің құтты болсын
Dialogue: 0,0:04:01.08,0:04:04.00,Default,,0,0,0,,Дауыстап айтсаңыз, ол жұмыс істемейді.
Dialogue: 0,0:04:04.00,0:04:04.50,Default,,0,0,0,,Ах
Dialogue: 0,0:04:05.01,0:04:05.51,Default,,0,0,0,,келді
Dialogue: 0,0:04:06.04,0:04:07.05,Default,,0,0,0,,Сол жігіттер
Dialogue: 0,0:04:07.09,0:04:09.09,Default,,0,0,0,,Енді қоңырау шалайық.
Dialogue: 0,0:04:10.03,0:04:12.01,Default,,0,0,0,,Анджело
Dialogue: 0,0:04:12.01,0:04:13.04,Default,,0,0,0,,Люс
Dialogue: 0,0:04:13.08,0:04:15.04,Default,,0,0,0,,Кираны қолдайтындардың бар екеніне таңғалмаймын.
Dialogue: 0,0:04:18.01,0:04:20.04,Default,,0,0,0,,Сынақ құралы, оны ашыңыз.
Dialogue: 0,0:04:20.04,0:04:21.04,Default,,0,0,0,,Бұл Винсент.
Dialogue: 0,0:04:22.02,0:04:23.02,Default,,0,0,0,,Винс?
Dialogue: 0,0:04:23.02,0:04:24.09,Default,,0,0,0,,Аа, қазірдің өзінде
Dialogue: 0,0:04:24.09,0:04:26.02,Default,,0,0,0,,Мен бірден қайтамын
Dialogue: 0,0:04:27.02,0:04:30.01,Default,,0,0,0,,Менің үйіме келуіңіз ерекше.
Dialogue: 0,0:04:30.08,0:04:31.07,Default,,0,0,0,,Сіз ішесіз бе?
Dialogue: 0,0:04:32.07,0:04:33.08,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:34.01,0:04:35.09,Default,,0,0,0,,Керісінше, тынышталып, тыңдаңыз.
Dialogue: 0,0:04:36.07,0:04:38.02,Default,,0,0,0,,Дон жеңіліске ұшырады
Dialogue: 0,0:04:49.03,0:04:50.09,Default,,0,0,0,,Оркодан келгендер ме?
Dialogue: 0,0:04:52.05,0:04:53.02,Default,,0,0,0,,Жоқ
Dialogue: 0,0:04:54.00,0:04:55.03,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:04:56.06,0:04:58.09,Default,,0,0,0,,Тынышпен қараңыз
Dialogue: 0,0:04:58.09,0:05:00.04,Default,,0,0,0,,Мен жақында үйде боламын.
Dialogue: 0,0:05:03.02,0:05:05.04,Default,,0,0,0,,Отбасымды қорғау үшін
Dialogue: 0,0:05:05.09,0:05:08.02,Default,,0,0,0,,Мен саған өте қарыздар едім...
Dialogue: 0,0:05:08.03,0:05:10.03,Default,,0,0,0,,Жоқ, сынаушы
Dialogue: 0,0:05:10.06,0:05:12.06,Default,,0,0,0,,Сіз ештеңе түсінбейсіз
Dialogue: 0,0:05:12.09,0:05:17.01,Default,,0,0,0,,Галассияға қанша құйғаныңызды табыңыз
Dialogue: 0,0:05:17.01,0:05:19.01,Default,,0,0,0,,Жетеді, кітапшаны шығар.
Dialogue: 0,0:05:20.02,0:05:21.05,Default,,0,0,0,,Мұнда емес
Dialogue: 0,0:05:21.08,0:05:23.01,Default,,0,0,0,,Банкке салынған
Dialogue: 0,0:05:23.04,0:05:25.03,Default,,0,0,0,,Маған кітапты қазір беріңіз.
Dialogue: 0,0:05:25.03,0:05:27.08,Default,,0,0,0,,Оны қазірдің өзінде тоқтатыңыз.
Dialogue: 0,0:05:38.00,0:05:38.50,Default,,0,0,0,,Елена
Dialogue: 0,0:05:40.02,0:05:41.04,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:05:41.04,0:05:42.06,Default,,0,0,0,,Ручу
Dialogue: 0,0:05:42.06,0:05:43.05,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:06:03.08,0:06:04.06,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:06:04.06,0:06:05.07,Default,,0,0,0,,Оған қарамаңыз
Dialogue: 0,0:06:06.01,0:06:07.05,Default,,0,0,0,,Винсент
Dialogue: 0,0:06:07.06,0:06:09.01,Default,,0,0,0,,Мына балаға көмектес
Dialogue: 0,0:06:10.00,0:06:12.03,Default,,0,0,0,,Ешқашан ешкімге айтпа
Dialogue: 0,0:06:12.05,0:06:13.07,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:06:14.05,0:06:16.08,Default,,0,0,0,,Елена Мұқият тыңда.
Dialogue: 0,0:06:17.03,0:06:20.00,Default,,0,0,0,,Ол бала бізді ешқашан ұмытпайды
Dialogue: 0,0:06:21.01,0:06:22.06,Default,,0,0,0,,Мен өмір сүргенше
Dialogue: 0,0:06:22.06,0:06:23.03,Default,,0,0,0,,О, өтінемін, мені өлтірме
Dialogue: 0,0:06:23.03,0:06:24.03,Default,,0,0,0,,(Элис) Иә, ханым. (Туған туыс) Бір сәт!
Dialogue: 0,0:06:31.04,0:06:33.01,Default,,0,0,0,,Сүртетін нәрсе бар ма?
Dialogue: 0,0:06:37.02,0:06:38.08,Default,,0,0,0,,Біз екінші қабаттамыз
Dialogue: 0,0:06:38.08,0:06:41.02,Default,,0,0,0,,Нерон, өзіңді іздеу керек.
Dialogue: 0,0:08:13.07,0:08:15.05,Default,,0,0,0,,Мен какао жасадым
Dialogue: 0,0:08:22.01,0:08:23.00,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:23.06,0:08:25.03,Default,,0,0,0,,Мен келмеуім керек еді
Dialogue: 0,0:08:25.07,0:08:26.09,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:27.03,0:08:29.02,Default,,0,0,0,,Мен сізге осы уақытқа дейін бармаймын.
Dialogue: 0,0:08:39.04,0:08:41.02,Default,,0,0,0,,Біраз ұйықтаңыз.
Dialogue: 0,0:08:51.04,0:08:52.05,Default,,0,0,0,,Авильо
Dialogue: 0,0:08:53.01,0:08:56.07,Default,,0,0,0,,Бұдан былай біз ағайынбыз.
Dialogue: 0,0:08:57.04,0:08:58.09,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:11:49.05,0:11:51.04,Default,,0,0,0,,Керемет соққы
Dialogue: 0,0:11:51.04,0:11:54.06,Default,,0,0,0,,Өйткені, бұл саке келесі.
Dialogue: 0,0:11:55.02,0:11:56.03,Default,,0,0,0,,Эй
Dialogue: 0,0:11:56.03,0:12:00.01,Default,,0,0,0,,Сондықтан мен оны Orco отбасылық дүкендеріне көтерме сатамын.
Dialogue: 0,0:12:00.01,0:12:02.05,Default,,0,0,0,,Сіз оны ағымдағы бағадан үш есеге сата аласыз.
Dialogue: 0,0:12:03.00,0:12:04.07,Default,,0,0,0,,Мен мафияны жек көремін
Dialogue: 0,0:12:05.03,0:12:08.05,Default,,0,0,0,,Бұл самогон шығаратын адам айтқан жол ма?
Dialogue: 0,0:12:09.02,0:12:12.07,Default,,0,0,0,,Менің ағам қазір мистер Фангода тұрады.
Dialogue: 0,0:12:12.07,0:12:13.08,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:12:14.02,0:12:16.07,Default,,0,0,0,,Осы уақыт ішінде Орко отбасына қосылған адам.
Dialogue: 0,0:12:16.07,0:12:18.08,Default,,0,0,0,,Сіз шынымен де барынша пайдаланасыз.
Dialogue: 0,0:12:18.08,0:12:20.06,Default,,0,0,0,,Қайтып кел, Челот.
Dialogue: 0,0:12:20.06,0:12:22.00,Default,,0,0,0,,Кортео
Dialogue: 0,0:12:22.00,0:12:24.00,Default,,0,0,0,,Бұл қоқыс шұңқырында мәңгі қалады...
Dialogue: 0,0:12:24.01,0:12:25.01,Default,,0,0,0,,Үйге қайт
Dialogue: 0,0:12:26.08,0:12:28.07,Default,,0,0,0,,Мен не болатынын білмеймін.
Dialogue: 0,0:12:33.02,0:12:34.08,Default,,0,0,0,,Жақсы өтті ме?
Dialogue: 0,0:12:34.08,0:12:35.07,Default,,0,0,0,,А Аники
Dialogue: 0,0:12:36.00,0:12:38.04,Default,,0,0,0,,Сондықтан мен мафияны жек көремін...
Dialogue: 0,0:12:40.03,0:12:42.04,Default,,0,0,0,,Бізге алкоголь беріңіз
Dialogue: 0,0:12:45.09,0:12:47.09,Default,,0,0,0,,Сіз алкоголь сатасыз ба?
Dialogue: 0,0:12:47.09,0:12:50.00,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:13:03.05,0:13:04.06,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:13:06.06,0:13:10.03,Default,,0,0,0,,Мен бизнестегі бәсекелестерімді жеңгім келеді.
Dialogue: 0,0:13:16.06,0:13:17.07,Default,,0,0,0,,Анджелу
Dialogue: 0,0:13:19.09,0:13:21.03,Default,,0,0,0,,Мен жасадым
Dialogue: 0,0:13:21.07,0:13:23.01,Default,,0,0,0,,Оны ішіп көріңіз.
Dialogue: 0,0:13:23.01,0:13:24.08,Default,,0,0,0,,Мен мұның жақсы екенін білемін.
Dialogue: 0,0:13:28.00,0:13:31.05,Default,,0,0,0,,Шыны керек, самогон жасағым келмейді.
Dialogue: 0,0:13:31.05,0:13:34.00,Default,,0,0,0,,Мен ақша жинап, мектепке барғым келеді.
Dialogue: 0,0:13:36.06,0:13:37.08,Default,,0,0,0,,Анджелу
Dialogue: 0,0:13:37.08,0:13:39.08,Default,,0,0,0,,Жеті жыл бойы не істедің?
Dialogue: 0,0:13:39.08,0:13:42.08,Default,,0,0,0,,Авильио Бруно Ол өзін қазір осылай атайды.
Dialogue: 0,0:13:43.07,0:13:47.02,Default,,0,0,0,,Бұл қалаға қайтып келуге болады ма?
Dialogue: 0,0:13:52.04,0:13:53.09,Default,,0,0,0,,Сіз шаршаған болуыңыз керек.
Dialogue: 0,0:13:54.03,0:13:55.07,Default,,0,0,0,,Осы бөлмені пайдаланыңыз.
Dialogue: 0,0:13:56.03,0:13:57.04,Default,,0,0,0,,Апай
Dialogue: 0,0:13:59.02,0:14:00.04,Default,,0,0,0,,Өткен жазда...
Dialogue: 0,0:14:00.09,0:14:04.02,Default,,0,0,0,,Сонда ешкімді уайымдаудың қажеті жоқ.
Dialogue: 0,0:14:05.03,0:14:07.01,Default,,0,0,0,,Бірге ақша тапқыңыз келе ме?
Dialogue: 0,0:14:08.01,0:14:10.08,Default,,0,0,0,,Мұны отбасыңызға сатыңыз.
Dialogue: 0,0:14:11.04,0:14:14.06,Default,,0,0,0,,Мен отбасыммен ешнәрсе істегім келмейді.
Dialogue: 0,0:14:14.08,0:14:16.03,Default,,0,0,0,,Дәл осылай Анджелоға да қатысты...
Dialogue: 0,0:14:16.03,0:14:18.00,Default,,0,0,0,,Өтінемін, Кортео.
Dialogue: 0,0:14:21.09,0:14:24.08,Default,,0,0,0,,Икіғай адамдарға күш береді
Dialogue: 0,0:14:24.08,0:14:27.04,Default,,0,0,0,,Достық пышақтан да күшті
Dialogue: 0,0:14:28.00,0:14:30.02,Default,,0,0,0,,Біз ағайындымыз, солай ма?
Dialogue: 0,0:14:32.07,0:14:34.08,Default,,0,0,0,,Бұл құм - бұл арал.
Dialogue: 0,0:14:37.01,0:14:40.02,Default,,0,0,0,,Менің ойымша, бұл жерде ең жоғары бағаларды сатуға болады.
Dialogue: 0,0:14:41.02,0:14:43.00,Default,,0,0,0,,Тыйым салынғаннан кейін
Dialogue: 0,0:14:43.00,0:14:45.04,Default,,0,0,0,,Бұзақылар оларды жинап алды.
Dialogue: 0,0:14:46.07,0:14:49.08,Default,,0,0,0,,Бірақ ол жерге кіруге болатын сияқты.
Dialogue: 0,0:14:49.08,0:14:51.05,Default,,0,0,0,,Бұл арзан сөз емес.
Dialogue: 0,0:15:11.08,0:15:14.03,Default,,0,0,0,,Ол шіркеу қазір бар.
Dialogue: 0,0:15:18.02,0:15:20.07,Default,,0,0,0,,Сіз қалай ойлайсыз? Жаман болуы керек.
Dialogue: 0,0:15:21.03,0:15:23.00,Default,,0,0,0,,Бұл Бранның құрметіне.
Dialogue: 0,0:15:23.00,0:15:24.06,Default,,0,0,0,,бұл дұрыс
Dialogue: 0,0:15:24.06,0:15:27.07,Default,,0,0,0,,Шекараның арғы жағындағы үздіктердің ең жақсысы.
Dialogue: 0,0:15:28.00,0:15:30.06,Default,,0,0,0,,Мен бұрын-соңды мұндай дәмді алкогольді ішкен емеспін.
Dialogue: 0,0:15:30.06,0:15:32.05,Default,,0,0,0,,Сіз Гето болуыңыз керек.
Dialogue: 0,0:15:32.05,0:15:33.08,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:15:34.01,0:15:37.00,Default,,0,0,0,,Жақсы алкогольге келсек, оны ішпей-ақ оның иісін сезіңіз.
Dialogue: 0,0:15:37.03,0:15:39.02,Default,,0,0,0,,Құлақтың иісін де сезейік.
Dialogue: 0,0:15:40.09,0:15:44.07,Default,,0,0,0,,Дәл қазір Орко отбасы шекара жолын бақылауда.
Dialogue: 0,0:15:46.08,0:15:49.09,Default,,0,0,0,,Балалар сендер Оркодан ұрладыңдар ма?
Dialogue: 0,0:15:50.04,0:15:51.09,Default,,0,0,0,,Сіз қайдан білдіңіз?
Dialogue: 0,0:15:52.01,0:15:54.02,Default,,0,0,0,,Бірақ сендер ондай емессіңдер...
Dialogue: 0,0:15:54.02,0:15:55.04,Default,,0,0,0,,Гранчио мырза
Dialogue: 0,0:16:01.08,0:16:05.05,Default,,0,0,0,,Менің ішімдігімді біреу ұрлап кеткен деп ойлаймын.
Dialogue: 0,0:16:05.05,0:16:07.02,Default,,0,0,0,,Мен оны іздеп жүрмін.
Dialogue: 0,0:16:07.07,0:16:10.02,Default,,0,0,0,,Мен сенің кім екеніңді білмеймін.
Dialogue: 0,0:16:10.04,0:16:11.09,Default,,0,0,0,,Орко отбасы?
Dialogue: 0,0:16:14.01,0:16:16.09,Default,,0,0,0,,А, бұл Фанго деп аталады.
Dialogue: 0,0:16:17.08,0:16:19.02,Default,,0,0,0,,Бұл қандай спирт?
Dialogue: 0,0:16:19.03,0:16:20.09,Default,,0,0,0,,Мен әкелдім.
Dialogue: 0,0:16:21.03,0:16:22.04,Default,,0,0,0,,Қайдан
Dialogue: 0,0:16:22.06,0:16:24.01,Default,,0,0,0,,Ол сол жақтан.
Dialogue: 0,0:16:25.01,0:16:29.00,Default,,0,0,0,,Е-е, шын айтсаң керек, балам.
Dialogue: 0,0:16:38.01,0:16:40.02,Default,,0,0,0,,Қайта тыңдайық
Dialogue: 0,0:16:40.02,0:16:42.03,Default,,0,0,0,,Бұл алкогольге не болды?
Dialogue: 0,0:16:42.09,0:16:44.06,Default,,0,0,0,,Мен сізге алкоголь сатып алуыңызды қалаймын.
Dialogue: 0,0:16:44.06,0:16:45.08,Default,,0,0,0,,Үйге қайт
Dialogue: 0,0:16:45.08,0:16:49.06,Default,,0,0,0,,Ваннадағы гин: Америкада тыйым салынған кезеңде заңсыз нарықта заңсыз алкогольге сұраныс көп болды. Мұнда Темера шығаратындай ваннаға арналған шай жоқ.
Dialogue: 0,0:17:00.03,0:17:02.08,Default,,0,0,0,,Гәки, алданып қалғанда.
Dialogue: 0,0:17:04.02,0:17:05.03,Default,,0,0,0,,Бұл...
Dialogue: 0,0:17:22.04,0:17:24.01,Default,,0,0,0,,Сатып алайық
Dialogue: 0,0:17:25.03,0:17:27.03,Default,,0,0,0,,Біз оны үйге жібере аламыз.
Dialogue: 0,0:17:27.03,0:17:29.04,Default,,0,0,0,,Тіпті тікелей сатып алсаңыз да...
Dialogue: 0,0:17:30.05,0:17:32.03,Default,,0,0,0,,Сен оны лақтырып жібердің.
Dialogue: 0,0:17:32.03,0:17:34.05,Default,,0,0,0,,Мен іштім, солай емес пе?
Dialogue: 0,0:17:34.08,0:17:36.05,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:17:36.05,0:17:39.00,Default,,0,0,0,,Әй, қария, кофе берші.
Dialogue: 0,0:17:39.03,0:17:40.00,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:40.04,0:17:42.00,Default,,0,0,0,,Бөтелке қанша тұрады?
Dialogue: 0,0:17:42.03,0:17:43.05,Default,,0,0,0,,3.5
Dialogue: 0,0:17:43.08,0:17:45.02,Default,,0,0,0,,Бұл туралы айтудың қажеті жоқ
Dialogue: 0,0:17:46.02,0:17:48.01,Default,,0,0,0,,Аптасына қанша сатуға болады?
Dialogue: 0,0:17:49.04,0:17:51.00,Default,,0,0,0,,Мен сені ұрамын
Dialogue: 0,0:17:56.02,0:17:58.07,Default,,0,0,0,,Акелло
Dialogue: 0,0:17:59.00,0:18:01.08,Default,,0,0,0,,Ой, ұрып-соғып жатырсың, жігіт.
Dialogue: 0,0:18:01.08,0:18:04.00,Default,,0,0,0,,Шуды көргенде білесің
Dialogue: 0,0:18:04.00,0:18:06.07,Default,,0,0,0,,Кираны қуалау – кешірілмейтін әрекет; оны тіпті қылмыс деп те айтуға болады Күтейік, көрейік
Dialogue: 0,0:18:06.07,0:18:07.06,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:18:08.02,0:18:10.01,Default,,0,0,0,,Оны ала аламын ба?
Dialogue: 0,0:18:10.01,0:18:11.03,Default,,0,0,0,,Дәптерімді қайтар.
Dialogue: 0,0:18:13.00,0:18:15.09,Default,,0,0,0,,Көңілді бөлім үшін кешіріңіз.
Dialogue: 0,0:18:15.09,0:18:17.04,Default,,0,0,0,,Фанго Монмон
Dialogue: 0,0:18:17.04,0:18:20.07,Default,,0,0,0,,Содан бері Орко отбасы бос емес.
Dialogue: 0,0:18:20.07,0:18:24.03,Default,,0,0,0,,Нерон, менің Ванетти деген жігітпен бір ісім бар.
Dialogue: 0,0:18:24.03,0:18:25.05,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:18:27.04,0:18:28.04,Default,,0,0,0,,Нерон
Dialogue: 0,0:18:28.04,0:18:30.05,Default,,0,0,0,,Дон Ванеттидің ұлы.
Dialogue: 0,0:18:30.07,0:18:34.08,Default,,0,0,0,,Бұл аралға қиындық келтірме
Dialogue: 0,0:18:34.08,0:18:36.05,Default,,0,0,0,,Бұл жерде ереже осы.
Dialogue: 0,0:18:36.05,0:18:38.02,Default,,0,0,0,,Ережелер?
Dialogue: 0,0:18:38.07,0:18:41.03,Default,,0,0,0,,Бұл, әрине, маңызды.
Dialogue: 0,0:18:41.03,0:18:45.01,Default,,0,0,0,,Мен де бүгін сол ережені түзету үшін келдім.
Dialogue: 0,0:18:45.05,0:18:47.02,Default,,0,0,0,,Дәл қазір
Dialogue: 0,0:18:47.02,0:18:52.01,Default,,0,0,0,,Мен үйімнен ұрланған алкогольді сол тұрақтан таптым.
Dialogue: 0,0:18:52.01,0:18:53.07,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:18:54.09,0:18:56.06,Default,,0,0,0,,Сіз бірдеңе айттыңыз ба?
Dialogue: 0,0:18:56.06,0:18:57.06,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:57.06,0:19:00.07,Default,,0,0,0,,және Нерон Ванетти.
Dialogue: 0,0:19:00.07,0:19:04.02,Default,,0,0,0,,Жас монах осы дүкенге тоқтаған дейді.
Dialogue: 0,0:19:06.05,0:19:08.00,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:19:08.07,0:19:10.06,Default,,0,0,0,,Мен келемін.
Dialogue: 0,0:19:16.07,0:19:18.03,Default,,0,0,0,,Бұл Нерон.
Dialogue: 0,0:19:18.07,0:19:21.02,Default,,0,0,0,,Жоқ, мен Нерон емеспін.
Dialogue: 0,0:19:21.09,0:19:24.01,Default,,0,0,0,,Басқа неролар бар ма?
Dialogue: 0,0:19:25.03,0:19:28.03,Default,,0,0,0,,Қараңызшы, бұл сізсіз.
Dialogue: 0,0:19:28.08,0:19:31.08,Default,,0,0,0,,Адамдардың ішімдіктерін ұрлаған жаман бала
Dialogue: 0,0:19:31.08,0:19:33.01,Default,,0,0,0,,Міндетті түрде.
Dialogue: 0,0:19:33.01,0:19:34.02,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:19:34.06,0:19:35.08,Default,,0,0,0,,Мен Неронмын
Dialogue: 0,0:19:36.03,0:19:38.09,Default,,0,0,0,,Олай болса, бұл жігіт
Dialogue: 0,0:19:39.03,0:19:40.01,Default,,0,0,0,,Цукуёми, тез бол, тез бол
Dialogue: 0,0:19:40.08,0:19:43.04,Default,,0,0,0,,Иә, тез айтыңыз.
Dialogue: 0,0:19:43.06,0:19:45.07,Default,,0,0,0,,Жаңа Нерон
Dialogue: 0,0:19:45.07,0:19:47.00,Default,,0,0,0,,Барлығымыз бірге жүрейік.
Dialogue: 0,0:20:01.02,0:20:04.06,Default,,0,0,0,,Ей, жасайық.
Dialogue: 0,0:20:05.04,0:20:07.00,Default,,0,0,0,,Оны жіберіңіз
Dialogue: 0,0:20:08.02,0:20:11.01,Default,,0,0,0,,Серпенте, мұны істе.
Dialogue: 0,0:20:11.01,0:20:12.06,Default,,0,0,0,,Тамақты кесу
Dialogue: 0,0:20:14.06,0:20:17.06,Default,,0,0,0,,Мен бұл жігітке бұлай істей алмаймын.
Dialogue: 0,0:20:19.01,0:20:21.06,Default,,0,0,0,,Иә, келіңіз.
Dialogue: 0,0:20:28.06,0:20:30.05,Default,,0,0,0,,Әй, бұл осылай.
Dialogue: 0,0:20:34.08,0:20:36.09,Default,,0,0,0,,Есептегіште темір табақ бар.
Dialogue: 0,0:20:37.01,0:20:38.05,Default,,0,0,0,,Жақсы, жігітім.
Dialogue: 0,0:20:38.05,0:20:40.05,Default,,0,0,0,,Гранчио қашып кетті.
Dialogue: 0,0:20:43.05,0:20:44.05,Default,,0,0,0,,Миссия аяқталған соң маған үйлен.
Dialogue: 0,0:20:44.05,0:20:46.03,Default,,0,0,0,,Бетіңді көрсетсең, ара ұясы.
Dialogue: 0,0:20:46.04,0:20:48.01,Default,,0,0,0,,Оқ таусылғанша күтуім керек пе?
Dialogue: 0,0:20:48.02,0:20:49.06,Default,,0,0,0,,Сәлем Серпенте
Dialogue: 0,0:20:49.06,0:20:52.06,Default,,0,0,0,,Оқ таңбалары. Сол жерден бірнеше оқ алыңыз.
Dialogue: 0,0:20:52.06,0:20:53.08,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:20:54.04,0:20:57.02,Default,,0,0,0,,Мылтық бізге тең келмейді.
Dialogue: 0,0:20:57.05,0:20:58.05,Default,,0,0,0,,Қарама
Dialogue: 0,0:20:58.05,0:21:00.06,Default,,0,0,0,,Олардың айналасына ішімдік лақтыр
Dialogue: 0,0:21:00.06,0:21:01.06,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:21:04.08,0:21:07.02,Default,,0,0,0,,Әлгі бейбақ ойнап жүр.
Dialogue: 0,0:21:08.03,0:21:12.02,Default,,0,0,0,,Мен бір жынды жігіт Оркоға қосылды деп естідім. Бұл ол ма?
Dialogue: 0,0:21:12.02,0:21:14.05,Default,,0,0,0,,Ақыр соңында, Орко, біз бір-бірімізге байсалдымыз.
Dialogue: 0,0:21:15.04,0:21:16.09,Default,,0,0,0,,Балалар сендер не істеп жатырсыңдар?
Dialogue: 0,0:21:16.06,0:21:19.04,Default,,0,0,0,,Кел, кел!
Dialogue: 0,0:21:17.06,0:21:19.00,Default,,0,0,0,,Бөлме айналып-айналып тұр — керемет
Dialogue: 0,0:21:19.02,0:21:21.02,Default,,0,0,0,,Егер сіз мұны лақтырсаңыз, ол шығуға қарай кетеді.
Dialogue: 0,0:21:21.07,0:21:23.00,Default,,0,0,0,,Жерде не бар?
Dialogue: 0,0:21:23.00,0:21:24.08,Default,,0,0,0,,Жарайды, жасаңыз.
Dialogue: 0,0:21:38.08,0:21:39.09,Default,,0,0,0,,Шұғыл хабар, шұғыл хабар!
Dialogue: 0,0:21:50.05,0:21:51.06,Default,,0,0,0,,Тигрей
Dialogue: 0,0:21:52.04,0:21:53.02,Default,,0,0,0,,Эй
Dialogue: 0,0:21:53.06,0:21:55.00,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:22:05.04,0:22:08.03,Default,,0,0,0,,Ой, бүгін қандай күн.
Dialogue: 0,0:22:08.03,0:22:10.04,Default,,0,0,0,,Бірақ бұл қызықты емес пе?
Dialogue: 0,0:22:10.04,0:22:12.05,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:22:12.08,0:22:14.08,Default,,0,0,0,,Шамның ингредиенттері
Dialogue: 0,0:22:14.08,0:22:15.09,Default,,0,0,0,,Парафин?
Dialogue: 0,0:22:16.08,0:22:19.05,Default,,0,0,0,,Парафинді сұйылтып, содан кейін сумен араластыруға болады.
Dialogue: 0,0:22:19.05,0:22:21.09,Default,,0,0,0,,Бон, дұрыс.
Dialogue: 0,0:22:22.05,0:22:25.05,Default,,0,0,0,,Сізге рахмет, мен ол жерге біраз уақыт жақындай алмаймын.
Dialogue: 0,0:22:25.05,0:22:28.09,Default,,0,0,0,,Сонда да секең дәмді болды.
Dialogue: 0,0:22:28.09,0:22:30.02,Default,,0,0,0,,Сіз мұнымен ақша таба аласыз.
Dialogue: 0,0:22:32.01,0:22:35.04,Default,,0,0,0,,Қараңызшы, бұл Ванеттис театры.
Dialogue: 0,0:22:35.04,0:22:37.00,Default,,0,0,0,,Бұл үлкен мәселе болуы керек.
Dialogue: 0,0:22:37.03,0:22:40.08,Default,,0,0,0,,Мен Донға аяқталған нұсқасын мүмкіндігінше тезірек көрсеткім келеді.
Dialogue: 0,0:22:41.05,0:22:43.08,Default,,0,0,0,,Бұл қала үшін жарамсыз
Dialogue: 0,0:22:44.00,0:22:45.01,Default,,0,0,0,,Қара…
Dialogue: 0,0:22:45.01,0:22:46.07,Default,,0,0,0,,Нерон есімді адам
Dialogue: 0,0:22:46.07,0:22:48.04,Default,,0,0,0,,34-тарау: Үнсіз ойнатылған реквием, Бірінші бөлім
Dialogue: 0,0:22:50.06,0:22:52.05,Default,,0,0,0,,Нерон Ванетти...
Dialogue: 0,0:22:54.02,0:22:55.04,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:22:56.54,0:23:01.54,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
