Dialogue: 0,0:05:02.94,0:05:07.95,720,sign,0,0,0,,Кісі өлтіру
Dialogue: 0,0:00:17.00,0:00:22.00,,,0,0,0,,Негізгі субтитр Ю✿Гүл тілі және Чинатсу субтитр тобы✿Бірлескен өндіріс
Dialogue: 0,0:19:44.44,0:19:50.28,720,,0,0,0,,Құлақсыз,таза түсінік
Dialogue: 0,0:00:18.16,0:00:20.64,720,,0,0,0,,Темекі жақсы болар еді.
Dialogue: 0,0:00:22.70,0:00:24.80,720,,0,0,0,,Темекі шегетін сияқтысың
Dialogue: 0,0:00:29.82,0:00:31.06,720,,0,0,0,,Арқамыздағы бостандық қанаттары
Dialogue: 0,0:00:31.06,0:00:34.84,720,,0,0,0,,Ол менің орныма Орко ойнайды.
Dialogue: 0,0:00:34.84,0:00:37.32,720,,0,0,0,,А,бұл арзан.
Dialogue: 0,0:00:37.32,0:00:39.70,720,,0,0,0,,Бұл сізге көп уақытты үнемдейді
Dialogue: 0,0:00:39.70,0:00:41.56,720,,0,0,0,,Не болды?
Dialogue: 0,0:00:44.04,0:00:47.36,720,,0,0,0,,Мына жігіт саған жоспары бар деді.
Dialogue: 0,0:00:47.36,0:00:48.82,720,,0,0,0,,Әй,олай емес.
Dialogue: 0,0:00:51.80,0:00:54.86,720,,0,0,0,,Менің қарным ашқандықтан миым жұмыс істемейді
Dialogue: 0,0:00:54.86,0:00:57.56,720,,0,0,0,,Маған тамақ бер,сусын бер.
Dialogue: 0,0:00:57.56,0:01:01.18,720,,0,0,0,,Өтінемін,осы күндері дұрыс тамақ ішіңіз.
Dialogue: 0,0:01:02.84,0:01:08.30,720,,0,0,0,,Менің ұстанымымды түсінбейтін сияқтысың,балам.
Dialogue: 0,0:01:12.20,0:01:13.80,720,,0,0,0,,Жалап көрейік
Dialogue: 0,0:01:15.93,0:01:17.74,720,,0,0,0,,Тәтті ауыстыру
Dialogue: 0,0:01:17.74,0:01:20.97,720,,0,0,0,,Италияның жақсы етін пайдаланамыз.
Dialogue: 0,0:01:36.32,0:01:40.70,720,,0,0,0,,Не болды? Италияның аяғын тез жеп алайық.
Dialogue: 0,0:01:45.08,0:01:47.98,720,,0,0,0,,Маған бірдеңе жеуге рұқсат етіңіз.
Dialogue: 0,0:01:57.74,0:02:00.39,720,,0,0,0,,Нерон қашып кеткен сияқты.
Dialogue: 0,0:02:01.64,0:02:04.85,720,,0,0,0,,А,мен оны табайын деп жатырмын.
Dialogue: 0,0:02:04.85,0:02:09.78,720,,0,0,0,,Әдеттегідей мен сенімен жақсы араласқым келеді.
Dialogue: 0,0:02:09.78,0:02:12.86,720,,0,0,0,,Ол үшін ол кедергі болуы керек.
Dialogue: 0,0:02:12.86,0:02:16.64,720,,0,0,0,,Орко мырза,сіз бірдеңе естідіңіз бе?
Dialogue: 0,0:02:18.06,0:02:21.28,720,,0,0,0,,Соңғы кездері оның жағдайы жақсы сияқты.
Dialogue: 0,0:02:22.08,0:02:24.22,720,,0,0,0,,Барлық жерде міндетті түрде өмір сүруге құқығы жоқ адамдар бар,...
Dialogue: 0,0:02:24.22,0:02:29.00,720,,0,0,0,,Менің ойымша,олар Лоулесс Бевен деген сусыннан көп ақша тауып жатыр.
Dialogue: 0,0:02:29.00,0:02:32.92,720,,0,0,0,,Бұл Неронның рұқсатсыз жасауға рұқсат берген спирті.
Dialogue: 0,0:02:32.92,0:02:36.26,720,,0,0,0,,Маған да берейін.
Dialogue: 0,0:02:36.26,0:02:37.51,720,,0,0,0,,Мочиро
Dialogue: 0,0:02:37.51,0:02:39.54,720,,0,0,0,,Неронды ұстап алғанша
Dialogue: 0,0:02:39.54,0:02:43.88,720,,0,0,0,,Сакенің рецепті мен спиртін алуға болады.
Dialogue: 0,0:02:43.88,0:02:47.70,720,,0,0,0,,Егер сіз бірдеңе білсеңіз,маған хабарласыңыз.
Dialogue: 0,0:02:47.70,0:02:51.20,720,,0,0,0,,Бұл да Галасияның үміті.
Dialogue: 0,0:02:51.20,0:02:53.23,720,,0,0,0,,Мультфильмдерді көруге қатысты
Dialogue: 0,0:03:02.00,0:03:04.22,720,,0,0,0,,Балапан
Dialogue: 0,0:03:04.22,0:03:06.86,720,,0,0,0,,Галассия желінің соғуы
Dialogue: 0,0:03:06.86,0:03:09.88,720,,0,0,0,,Бұл Неронның соңы ма?
Dialogue: 0,0:03:11.56,0:03:17.12,720,,0,0,0,,Менің ойымша,біз менің кері серпілісімде ештеңе істей алмаймыз.
Dialogue: 0,0:03:18.84,0:03:20.50,720,,0,0,0,,Мүлдем
Dialogue: 0,0:03:20.50,0:03:25.26,720,,0,0,0,,Осыншама уайым болса,тамаққа тоймайсың.
Dialogue: 0,0:03:29.96,0:03:33.23,720,,0,0,0,,Эй,сізде лазанья бар ма?
Dialogue: 0,0:05:09.95,0:05:13.22,720,,0,0,0,,Жақсы,ұйықтау ыңғайсыз болды.
Dialogue: 0,0:05:13.22,0:05:17.48,720,,0,0,0,,Менің шағымданатын жағдайым жоқ,бірақ бәрібір...
Dialogue: 0,0:05:17.48,0:05:19.20,720,,0,0,0,,Ол Тегаренің құтқарылғанын айтты.
Dialogue: 0,0:05:19.20,0:05:20.54,720,,0,0,0,,Мен көремін.
Dialogue: 0,0:05:21.06,0:05:22.46,720,,0,0,0,,Бірақ жақсы
Dialogue: 0,0:05:22.46,0:05:26.13,720,,0,0,0,,Оркомен күресе алмасақ,бәріміз балыққа жем боламыз.
Dialogue: 0,0:05:26.13,0:05:30.12,720,,0,0,0,,Авильо Мен ештеңе ойламаймын...
Dialogue: 0,0:05:28.88,0:05:30.12,720,,0,0,0,,Харизма!
Dialogue: 0,0:05:30.12,0:05:32.06,720,,0,0,0,,Арнайы тағам
Dialogue: 0,0:05:32.06,0:05:34.22,720,,0,0,0,,Бірақ сіз сол кезде...
Dialogue: 0,0:05:34.22,0:05:36.36,720,,0,0,0,,Оркоға ағып кетсе,бітті.
Dialogue: 0,0:05:36.36,0:05:39.58,720,,0,0,0,,Сіз неғұрлым аз адам білсеңіз,соғұрлым жақсы.
Мұны
Dialogue: 0,0:05:39.58,0:05:41.80,720,,0,0,0,,-де қалай жасауға болады
Dialogue: 0,0:05:42.42,0:05:43.78,720,,0,0,0,,Volpe
Dialogue: 0,0:05:43.78,0:05:46.54,720,,0,0,0,,Маған тауық ұстаңыз.
Dialogue: 0,0:05:58.50,0:06:00.59,720,,0,0,0,,Жүр,алайық.
Dialogue: 0,0:06:05.34,0:06:08.84,720,,0,0,0,,Бұл өте жақсы қорғалған дүкен,солай емес пе?
Dialogue: 0,0:06:09.46,0:06:10.84,720,,0,0,0,,Тоқта
Dialogue: 0,0:06:12.00,0:06:13.30,720,,0,0,0,,Сіз Неронсыз.
Dialogue: 0,0:06:14.02,0:06:15.44,720,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:06:15.44,0:06:18.40,720,,0,0,0,,Мен тамақ ішу үшін жолдан шықтым.
Dialogue: 0,0:06:18.40,0:06:20.32,720,,0,0,0,,Және бизнес.
Dialogue: 0,0:06:20.32,0:06:22.36,720,,0,0,0,,Дон,мені Оркомен байланыстыр.
Dialogue: 0,0:06:27.04,0:06:28.53,720,,0,0,0,,Денені тексеру
Dialogue: 0,0:06:29.58,0:06:31.84,720,,0,0,0,,Мұнда не ұсынылады?
Dialogue: 0,0:06:33.18,0:06:34.98,720,,0,0,0,,Анамның дәмі бар ма?
Dialogue: 0,0:06:36.22,0:06:37.56,720,,0,0,0,,Қою
Dialogue: 0,0:06:44.56,0:06:46.72,720,,0,0,0,,О Нерон
Dialogue: 0,0:06:46.72,0:06:50.72,720,,0,0,0,,Ең дұрысы,менің алдымда жүзіңді көрсете білдің.
Dialogue: 0,0:06:50.72,0:06:53.05,720,,0,0,0,,Сіз бұл қай жерде екенін білесіз бе?
Dialogue: 0,0:06:53.05,0:06:54.90,720,,0,0,0,,Оттимо Орко
Dialogue: 0,0:06:54.90,0:06:58.94,720,,0,0,0,,Лоулесстегі ең жақсы мейрамхана шығар.
Dialogue: 0,0:06:58.94,0:07:00.92,720,,0,0,0,,Ол менің соңғы жебеме айналғанша...
Dialogue: 0,0:07:08.34,0:07:11.00,720,,0,0,0,,Ағаларым мені іздеді.
Dialogue: 0,0:07:12.62,0:07:14.78,720,,0,0,0,,Қазіргі үй
Dialogue: 0,0:07:15.74,0:07:17.52,720,,0,0,0,,Сәтсіз аяқталды.
Dialogue: 0,0:07:17.52,0:07:19.00,720,,0,0,0,,Не
Dialogue: 0,0:07:20.66,0:07:24.24,720,,0,0,0,,Бұл мен ішкен ең жақсы лазанья.
Dialogue: 0,0:07:24.24,0:07:27.17,720,,0,0,0,,Мен Орко отбасына қосылуым керек еді.
Dialogue: 0,0:07:31.40,0:07:35.20,720,,0,0,0,,Қызықты нәрселерді айтады.
Dialogue: 0,0:07:40.72,0:07:44.68,720,,0,0,0,,Менде сені өлтіру үшін көптеген себептер бар.
Dialogue: 0,0:07:44.68,0:07:47.50,720,,0,0,0,,Бұл мүмкіндікті пайдалануға ешқандай себеп жоқ.
Dialogue: 0,0:07:47.50,0:07:50.40,720,,0,0,0,,Мен жол бойы келдім.
Dialogue: 0,0:07:50.40,0:07:51.70,720,,0,0,0,,Естісем де
Dialogue: 0,0:07:51.70,0:07:53.58,720,,0,0,0,,Сіз қазір не туралы айтып отырсыз?
Dialogue: 0,0:07:53.58,0:07:55.86,720,,0,0,0,,Мен сенің өміріңді сұрағаныңды тыңдамаймын.
Dialogue: 0,0:07:57.16,0:08:02.04,720,,0,0,0,,Мен сіздің әкеңіз Винсентті 40 жылдан бері білемін.
Dialogue: 0,0:08:02.54,0:08:05.58,720,,0,0,0,,Біздің қарым-қатынасымыз жақсы болды.
Dialogue: 0,0:08:05.58,0:08:08.70,720,,0,0,0,,Сіз оны жойдыңыз.
Dialogue: 0,0:08:08.70,0:08:12.18,720,,0,0,0,,Сіз біздің барлық сусындарды бүлдіріп жібердіңіз.
Dialogue: 0,0:08:12.18,0:08:16.14,720,,0,0,0,,Дұрыс,бұл өзара. Бұл бизнес түрі.
Dialogue: 0,0:08:19.16,0:08:22.19,720,,0,0,0,,Соңғы кешкі ас аяқталды
Dialogue: 0,0:08:25.60,0:08:28.94,720,,0,0,0,,Ең жақсы саке ішу
Dialogue: 0,0:08:28.94,0:08:32.07,720,,0,0,0,,Өкінбей-ақ о дүниеге кет.
Dialogue: 0,0:08:36.12,0:08:40.41,720,,0,0,0,,Түсіндім,сосын қабыл алыңыз.
Dialogue: 0,0:08:43.26,0:08:47.13,720,,0,0,0,,Bootlegs,винтаждық Виндзор.
Dialogue: 0,0:08:47.13,0:08:48.90,720,,0,0,0,,Жақсы мұрын
Dialogue: 0,0:08:48.90,0:08:52.00,720,,0,0,0,,Мен 30 жылдық шарапты сирек ішетін едім.
Dialogue: 0,0:08:52.00,0:08:54.01,720,,0,0,0,,Дәмін көрдіңіз бе?
Dialogue: 0,0:08:54.01,0:08:57.14,720,,0,0,0,,Аа,дәмі талғампаз.
Dialogue: 0,0:08:57.14,0:08:59.93,720,,0,0,0,,Бірақ оның қазіргідей дәмі жоқ.
Dialogue: 0,0:09:23.37,0:09:27.33,720,,0,0,0,,Байқап көріңіз,бұл тек бір айлық сусын.
Dialogue: 0,0:09:27.33,0:09:29.54,720,,0,0,0,,Жоқ,үш апта.
Dialogue: 0,0:09:33.01,0:09:33.97,720,,0,0,0,,Дон
Dialogue: 0,0:09:50.72,0:09:54.36,720,,0,0,0,,Хмм,бұл заңсыз аспан ба?
Dialogue: 0,0:09:54.36,0:09:58.54,720,,0,0,0,,Егер менде бұл саке болса,мен Сатсуды ақшаны алу үшін көбірек жұмыстандырар едім.
Dialogue: 0,0:09:58.54,0:10:01.62,720,,0,0,0,,Шекарадан тасымалдаудың қажеті жоқ
Dialogue: 0,0:10:02.52,0:10:04.16,720,,0,0,0,,Өз кезегінде
Dialogue: 0,0:10:04.16,0:10:06.56,720,,0,0,0,,Мен мұндай жігіттің не айтарын білмеймін...
Dialogue: 0,0:10:06.56,0:10:07.86,720,,0,0,0,,Шулы
Dialogue: 0,0:10:07.86,0:10:12.68,720,,0,0,0,,Бізге орақ дайындасаң,мен саған біз сияқты бір үй беремін.
Dialogue: 0,0:10:12.68,0:10:14.05,720,,0,0,0,,Не?
Dialogue: 0,0:10:15.76,0:10:17.52,720,,0,0,0,,Барлығы
Dialogue: 0,0:10:21.80,0:10:24.18,720,,0,0,0,,Бұл көмір шахтасының қалдықтары емес пе?
Dialogue: 0,0:10:24.98,0:10:27.28,720,,0,0,0,,Сіз де көмір қазасыз ба?
Dialogue: 0,0:10:27.28,0:10:30.38,720,,0,0,0,,Іздегеніңіз қара тесіктің ішінде.
Dialogue: 0,0:10:32.06,0:10:33.61,720,,0,0,0,,Мына жігітті көріңдер.
Dialogue: 0,0:10:33.61,0:10:35.50,720,,0,0,0,,Сізде оттық бар ма?
Dialogue: 0,0:10:35.50,0:10:36.76,720,,0,0,0,,Шулы
Dialogue: 0,0:10:40.88,0:10:43.87,720,,0,0,0,,Сіз Авильо дедіңіз.
Dialogue: 0,0:10:43.87,0:10:46.76,720,,0,0,0,,Ол Фангоны ойнауға тырысады.
Dialogue: 0,0:10:48.18,0:10:53.09,720,,0,0,0,,Фангодан келген жігіттің шалбарын ғана киіп қашып кеткенін естідім.
Dialogue: 0,0:10:53.09,0:10:56.48,720,,0,0,0,,Әй,мен қаңғыбас мысықтай қаштым.
Dialogue: 0,0:10:56.48,0:11:00.59,720,,0,0,0,,Сол кезде қалсаңыз жақсы болар еді.
Dialogue: 0,0:11:01.88,0:11:04.31,720,,0,0,0,,Хат жіберген сіз болдыңыз ба?
Dialogue: 0,0:11:04.31,0:11:05.68,720,,0,0,0,,Хат?
Dialogue: 0,0:11:05.68,0:11:07.31,720,,0,0,0,,(Баяндау) Бір күні адамсыз жүзуші кеме табылды.
Dialogue: 0,0:11:07.31,0:11:08.50,720,,0,0,0,,Жоқ
Dialogue: 0,0:11:09.50,0:11:11.46,720,,0,0,0,,Неге мені қолданбайсың?
Dialogue: 0,0:11:12.54,0:11:15.76,720,,0,0,0,,Нерон үшін бәрі бітті.
Dialogue: 0,0:11:16.44,0:11:18.26,720,,0,0,0,,Сенуге болмайды
Dialogue: 0,0:11:19.12,0:11:23.08,720,,0,0,0,,Менің шын атым Анджело Рагуса.
Dialogue: 0,0:11:23.08,0:11:26.04,720,,0,0,0,,Менің әкемнің аты Теста Рагуса
Dialogue: 0,0:11:26.04,0:11:27.62,720,,0,0,0,,Рагуса
Dialogue: 0,0:11:30.18,0:11:33.30,720,,0,0,0,,Мен баяғыда сенімдімін
Dialogue: 0,0:11:33.30,0:11:37.10,720,,0,0,0,,Әкемді өлтірген Винсент Ванетти болды.
Dialogue: 0,0:11:38.92,0:11:40.10,720,,0,0,0,,Дон
Dialogue: 0,0:11:46.38,0:11:49.73,720,,0,0,0,,Ол осындай жерде жасалған ба?
Dialogue: 0,0:11:49.73,0:11:53.34,720,,0,0,0,,Менде осы қонақжай мен анау ішімдіктің рецепті болса ғой.
Dialogue: 0,0:11:53.34,0:11:55.24,720,,0,0,0,,Бұл қала сенікі.
Dialogue: 0,0:11:55.24,0:11:56.50,720,,0,0,0,,Рецепт
Dialogue: 0,0:11:56.50,0:11:59.24,720,,0,0,0,,Маған соны айтсаң,мен бітемін.
Dialogue: 0,0:11:59.24,0:12:00.52,720,,0,0,0,,Тоқта
Dialogue: 0,0:12:01.26,0:12:03.87,720,,0,0,0,,Түсіндірсеңіз жақсы болар еді.
Dialogue: 0,0:12:03.87,0:12:05.76,720,,0,0,0,,Ішіп алайық
Dialogue: 0,0:12:05.76,0:12:08.24,720,,0,0,0,,Бұл қатты кесе.
Dialogue: 0,0:12:08.24,0:12:09.60,720,,0,0,0,,Тоқтамаңыз
Dialogue: 0,0:12:14.50,0:12:16.17,720,,0,0,0,,Қорықпа
Dialogue: 0,0:12:29.52,0:12:32.56,720,,0,0,0,,Бұл қызғылт сары ащы қосылған.
Dialogue: 0,0:12:32.56,0:12:34.14,720,,0,0,0,,Сіз сусын алғыңыз келе ме?
Dialogue: 0,0:12:47.76,0:12:49.72,720,,0,0,0,,Келіңіздер,орындаңыздар.
Dialogue: 0,0:12:49.72,0:12:51.22,720,,0,0,0,,Бұл дәмді
Dialogue: 0,0:12:53.20,0:12:55.70,720,,0,0,0,,О,маған еліктейсің бе?
Dialogue: 0,0:13:02.80,0:13:05.02,720,,0,0,0,,Эй,бұл маңызды өнім.
Dialogue: 0,0:13:07.60,0:13:10.56,720,,0,0,0,,Жарайды, не ұнатса,соны істе.
Dialogue: 0,0:13:26.74,0:13:28.28,720,,0,0,0,,Ол бос болар еді.
Dialogue: 0,0:13:39.74,0:13:43.20,720,,0,0,0,,Нерон,сен оны бұздың.
Dialogue: 0,0:13:43.20,0:13:45.13,720,,0,0,0,,Нашар қозғалыс
Dialogue: 0,0:13:55.94,0:13:57.64,720,,0,0,0,,Барлығы шайқасып жатыр.
Dialogue: 0,0:13:58.58,0:14:00.40,720,,0,0,0,,Нерон Ванетти
Dialogue: 0,0:14:01.22,0:14:03.07,720,,0,0,0,,Рабу...
Dialogue: 0,0:14:26.26,0:14:27.72,720,,0,0,0,,Бұл жігітті шын мәнінде өлтіру керек.
Dialogue: 0,0:14:34.38,0:14:37.22,720,,0,0,0,,Дон,мына жігіттен де құтылайық.
Dialogue: 0,0:14:37.22,0:14:39.06,720,,0,0,0,,Мен түсінбей тұрған сияқтымын.
Dialogue: 0,0:14:39.06,0:14:41.84,720,,0,0,0,,Неліктен достарыңызды соңғы сәтте сатасыз?
Dialogue: 0,0:14:41.84,0:14:46.32,720,,0,0,0,,Бұл жігіт туралы не білесіз?
Dialogue: 0,0:14:46.32,0:14:48.50,720,,0,0,0,,Бұл жігіт кім?
Dialogue: 0,0:14:48.50,0:14:51.50,720,,0,0,0,,Мен ата-анамның кекімді алдым.
Dialogue: 0,0:14:51.50,0:14:53.66,720,,0,0,0,,Бұл мен қараған адам.
Dialogue: 0,0:14:54.66,0:14:57.26,720,,0,0,0,,Эй,мені шеш.
Dialogue: 0,0:14:57.26,0:15:00.68,720,,0,0,0,,Кешіріңіз,артқы жағында шығу бар.
Dialogue: 0,0:15:00.68,0:15:02.06,720,,0,0,0,,Мен қашып құтыла алдым
Dialogue: 0,0:15:02.06,0:15:03.14,720,,0,0,0,,Сонымен
Dialogue: 0,0:15:04.30,0:15:06.96,720,,0,0,0,,Мен сені ұстап алғанша қайтып келме.
Dialogue: 0,0:15:06.96,0:15:08.48,720,,0,0,0,,Иә
Dialogue: 0,0:15:09.64,0:15:12.24,720,,0,0,0,,Оны пайдалана алмайтындар ғана
Dialogue: 0,0:15:12.24,0:15:13.90,720,,0,0,0,,Ішіп алайық
Dialogue: 0,0:15:13.90,0:15:16.82,720,,0,0,0,,О,бұл жақсы
Dialogue: 0,0:15:28.28,0:15:31.44,720,,0,0,0,,Ванетти,сонымен қатар Фанго
Dialogue: 0,0:15:32.22,0:15:34.34,720,,0,0,0,,Бітті
Dialogue: 0,0:15:34.91,0:15:36.38,720,,0,0,0,,Отбасына
Dialogue: 0,0:15:36.38,0:15:37.68,720,,0,0,0,,Отбасына
Dialogue: 0,0:15:41.96,0:15:45.46,720,,0,0,0,,Бұл жігіт өте дәмді
Dialogue: 0,0:15:45.46,0:15:49.44,720,,0,0,0,,Эй, мен Неронды өлтірдім,бірақ рецепт сақталды деп ойлаймын.
Dialogue: 0,0:15:49.44,0:15:53.35,720,,0,0,0,,Аа,мұны жасаған адам менің бір танысым.
Dialogue: 0,0:15:53.35,0:15:56.56,720,,0,0,0,,Шынында да, менде бұл саке бар болса,менде бәрі жақсы болады.
Dialogue: 0,0:15:56.56,0:16:00.14,720,,0,0,0,,Мен Галассияға тағзым етпейтін сияқтымын.
Dialogue: 0,0:16:04.94,0:16:06.68,720,,0,0,0,,Не болды?
Dialogue: 0,0:16:07.57,0:16:10.28,720,,0,0,0,,Мен кенеттен мас болып қалдым...
Dialogue: 0,0:16:20.44,0:16:23.70,720,,0,0,0,,Бұл не?
Dialogue: 0,0:16:41.72,0:16:44.28,720,,0,0,0,,Енді, міне,сізге қажет элемент.
Dialogue: 0,0:16:52.14,0:16:55.88,720,,0,0,0,,Қайырлы таң Дон Орко
Dialogue: 0,0:16:55.88,0:16:57.96,720,,0,0,0,,Сіз ояусыз ба?
Dialogue: 0,0:17:03.96,0:17:05.56,720,,0,0,0,,Фанго
Dialogue: 0,0:17:05.56,0:17:09.02,720,,0,0,0,,Қандай ақсақ ойдан шығарылған.
Dialogue: 0,0:17:10.59,0:17:14.28,720,,0,0,0,,Бейшара Дон Орко
Dialogue: 0,0:17:15.88,0:17:18.10,720,,0,0,0,,Сізге не керек?
Dialogue: 0,0:17:18.10,0:17:22.93,720,,0,0,0,,Сізде бар нәрсенің бәрі
Dialogue: 0,0:17:30.03,0:17:32.62,720,,0,0,0,,Сол кезде үйге кірген адам
Dialogue: 0,0:17:32.62,0:17:36.38,720,,0,0,0,,Винсент Нерон Ванноның үштігі
Dialogue: 0,0:17:36.38,0:17:39.58,720,,0,0,0,,Бірақ Нерон төртеуі бар деп айтқан шығар.
Dialogue: 0,0:17:39.58,0:17:41.58,720,,0,0,0,,Төртінші тұлға кім?
Dialogue: 0,0:17:42.50,0:17:46.14,720,,0,0,0,,Хат жіберуші Орко деп ойладым.
Dialogue: 0,0:17:46.14,0:17:48.67,720,,0,0,0,,Өйткені мен Ванеттиге қарсымын.
Dialogue: 0,0:17:48.67,0:17:50.38,720,,0,0,0,,ғана ерекшеленеді
Dialogue: 0,0:17:50.38,0:17:54.10,720,,0,0,0,,Бұл қарттың жақын досы шығар
Dialogue: 0,0:17:54.10,0:17:55.59,720,,0,0,0,,Төртінші адам.
Dialogue: 0,0:17:55.59,0:18:01.97,720,,0,0,0,,Бұл оның өкініштен кек алуға көмектескісі келетінін білдіре ме?
Dialogue: 0,0:18:03.16,0:18:04.86,720,,0,0,0,,Немесе...
Dialogue: 0,0:18:09.94,0:18:12.69,720,,0,0,0,,Ей,мені баққан тауық.
Dialogue: 0,0:18:12.69,0:18:15.46,720,,0,0,0,,Мен оны ұшаның үстіне қойдым.
Dialogue: 0,0:18:17.22,0:18:20.26,720,,0,0,0,,Бұл шындыққа өте жақын болды.
Dialogue: 0,0:18:20.26,0:18:25.54,720,,0,0,0,,«Неро Ванетти,сен осы сәтті күткенсің».
Dialogue: 0,0:18:26.84,0:18:29.75,720,,0,0,0,,Себебі мен оған өз сезімімді салдым
Dialogue: 0,0:18:29.75,0:18:33.30,720,,0,0,0,,Меніңше,сонша рет оқ тигенім соншалықты жаман емес еді.
Dialogue: 0,0:18:33.30,0:18:36.90,720,,0,0,0,,Ол тамаша редис актері болған.
Dialogue: 0,0:18:36.90,0:18:38.55,720,,0,0,0,,Урус
Dialogue: 0,0:18:40.88,0:18:42.42,720,,0,0,0,,Уақыты келген жоқ па?
Dialogue: 0,0:18:44.06,0:18:46.90,720,,0,0,0,,Джетман
Dialogue: 0,0:18:46.90,0:18:51.72,720,,0,0,0,,Бүгін мен ұзақ жылдар бойы отбасын асырап келе жатқан барлық басшыларға алғысымды білдіргім келеді.
Dialogue: 0,0:18:51.72,0:18:56.00,720,,0,0,0,,Сіздің осында болу үлкен мәртебе.
Dialogue: 0,0:18:59.76,0:19:05.76,720,,0,0,0,,Енді бүгіннен бастап Орко отбасы Фанго отбасына айналады.
Dialogue: 0,0:19:05.76,0:19:08.78,720,,0,0,0,,Келіспейтіндер бар ма?
Dialogue: 0,0:19:11.18,0:19:15.64,720,,0,0,0,,Әрине,бұл дүкен де Оттимо Фанго ретінде қайта пайда болады.
Dialogue: 0,0:19:15.64,0:19:20.50,720,,0,0,0,,Маған келсек,мұнда Орко жасаған дәм ұнамайды.
Dialogue: 0,0:19:20.50,0:19:23.84,720,,0,0,0,,Мен оны кез келген жағдайда қорғағым келеді
Dialogue: 0,0:19:25.96,0:19:27.31,720,,0,0,0,,Сонымен
Dialogue: 0,0:19:27.31,0:19:32.52,720,,0,0,0,,Тонг-ол қандай асүйге көңіл бөлуді жалғастырды?
Dialogue: 0,0:19:34.64,0:19:36.19,720,,0,0,0,,Бұл лазанья.
Dialogue: 0,0:19:36.19,0:19:39.99,720,,0,0,0,,Жарайды,лазанья.
Dialogue: 0,0:19:39.99,0:19:44.44,720,,0,0,0,,Лазанья Оттимо Орконың мақтанышы болды.
Dialogue: 0,0:19:44.44,0:19:50.28,720,,0,0,0,,Және, әрине,Оттимо Фангоның дәмі қандай???
Dialogue: 0,0:20:16.23,0:20:18.76,720,,0,0,0,,Не болды,Корво?
Dialogue: 0,0:20:18.76,0:20:22.99,720,,0,0,0,,Менің лазаньямда у бар деп ойлайсың ба?
Dialogue: 0,0:20:22.99,0:20:24.96,720,,0,0,0,,Жақсы,онда
Dialogue: 0,0:20:30.75,0:20:36.00,720,,0,0,0,,Енді тіліңізбен баяу дәмдеңіз.
Dialogue: 0,0:20:51.56,0:20:52.84,720,,0,0,0,,Дәмді
Dialogue: 0,0:20:54.56,0:20:58.28,720,,0,0,0,,Жүр,жеп ал!
Dialogue: 0,0:21:02.54,0:21:03.78,720,,0,0,0,,Дәмді
Dialogue: 0,0:21:04.56,0:21:06.22,720,,0,0,0,,Әрине
Dialogue: 0,0:21:06.22,0:21:09.58,720,,0,0,0,,Дон Орко да жесе ғой.
Dialogue: 0,0:21:11.08,0:21:12.60,720,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:21:13.28,0:21:14.30,720,,0,0,0,,Мақсатқа жету біртүрлі бос сезім екен,иә?
Dialogue: 0,0:21:14.30,0:21:18.90,720,,0,0,0,,Бұл сіздің шаршағаныңыз үшін.
Dialogue: 0,0:21:18.90,0:21:20.70,720,,0,0,0,,Бұл соңы ма?
Dialogue: 0,0:21:20.70,0:21:23.92,720,,0,0,0,,Өкінішті,мен қанша кесе жей аламын деп ойлаймын.
Dialogue: 0,0:21:23.92,0:21:29.16,720,,0,0,0,,Жоқ,толтыру көп.
Dialogue: 0,0:21:56.56,0:22:02.16,720,,0,0,0,,Бұл қалай? Бұл дәмді ме? Бұл дәмді ме?
Dialogue: 0,0:22:06.02,0:22:09.24,720,,0,0,0,,Осы майлы тағамды енді жеуге бола ма?
Dialogue: 0,0:22:10.24,0:22:12.30,720,,0,0,0,,Өзіңізді қатты итермеңіз
Dialogue: 0,0:22:12.30,0:22:13.92,720,,0,0,0,,Мен білемін
Dialogue: 0,0:22:13.92,0:22:16.84,720,,0,0,0,,Міне,мен оны жеңдім деп ойлаймын.
Dialogue: 0,0:22:17.42,0:22:20.54,720,,0,0,0,,Жоқ,бұдан былай қиын болады.
Dialogue: 0,0:22:20.54,0:22:23.36,720,,0,0,0,,Тамақтың дәмі нашар болады.
Dialogue: 0,0:22:23.36,0:22:25.36,720,,0,0,0,,Ей,тауық етін же!
Dialogue: 0,0:22:26.70,0:22:28.74,720,,0,0,0,,Фангоның әлі де жаулары бар
Dialogue: 0,0:22:29.44,0:22:32.80,720,,0,0,0,,Олар да біздің жауымыз.
Dialogue: 0,0:22:33.72,0:22:35.44,720,,0,0,0,,850 жылы адамзат алғаш рет Титаннан өз жерін қайтарып алды
Dialogue: 0,0:22:41.30,0:22:45.08,720,,0,0,0,,Тамақ ішейік. Лазанья ақыры суыды.
Dialogue: 0,0:22:46.58,0:22:52.58,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
