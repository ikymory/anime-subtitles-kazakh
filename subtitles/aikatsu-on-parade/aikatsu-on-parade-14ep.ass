Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:34.16,0:00:36.16,Default,,0,0,0,,Бәріміз ән айтайық...
Dialogue: 0,0:00:36.16,0:00:38.17,Default,,0,0,0,,Би билейік. Кумирлер де...
Dialogue: 0,0:00:38.17,0:00:40.59,Default,,0,0,0,,Көйлектер де... Үлкен жиын!
Dialogue: 0,0:00:40.59,0:00:46.16,Default,,0,0,0,,『Икацуон шеруі! «Ол басталады! Ой
Dialogue: 0,0:00:46.16,0:00:49.23,Default,,0,0,0,,<Чао! Мен Раки Химейши
Dialogue: 0,0:00:49.23,0:00:52.16,Default,,0,0,0,,Жұлдыздар гармония академиясының 2 курс орта мектебінің студенті
Dialogue: 0,0:00:52.16,0:00:56.65,Default,,0,0,0,,Менің арманым бір күні өзім құрастырған премиум көйлекті кию.
Dialogue: 0,0:00:56.65,0:00:59.84,Default,,0,0,0,,Үлкен әпкемнің маған берген жарқыраған қабағы мені қозғады.
Dialogue: 0,0:00:59.84,0:01:02.81,Default,,0,0,0,,Мен білмейтін көп пұттармен дос болдым.
Dialogue: 0,0:01:02.81,0:01:06.24,Default,,0,0,0,,Мен шынымен де твимін. Бақытты.
Dialogue: 0,0:01:06.24,0:01:09.85,Default,,0,0,0,,Оның үстіне апамның тәжірибесінің әсерінен
Dialogue: 0,0:01:09.85,0:01:12.17,Default,,0,0,0,,Әртүрлі мектептер мен Икатсу әлемі байланысты
Dialogue: 0,0:01:12.17,0:01:14.32,Default,,0,0,0,,Екеуміз бір болып кеткендей болдық
Dialogue: 0,0:01:14.32,0:01:17.69,Default,,0,0,0,,Бірақ неге дәл осылай істеп жатырсыз?
Dialogue: 0,0:01:17.69,0:01:20.69,Default,,0,0,0,,Айкацу инженерінің қарындасын іздеу кезінде
Dialogue: 0,0:01:20.69,0:01:23.19,Default,,0,0,0,,Бүгін де барымызды салайық! ＞
Dialogue: 0,0:01:26.16,0:01:32.67,Default,,0,0,0,,Мен өзімнің бірегей премиум мекенжайымды жасай аламын деп үміттенемін.
Dialogue: 0,0:01:32.67,0:01:37.51,Default,,0,0,0,,Сондай-ақ, осы жылы кездесулеріңіз көп және сәттілік тілеймін!
Dialogue: 0,0:01:37.51,0:01:41.53,Default,,0,0,0,,Хохо, бұл сенің тілегің бе?
Dialogue: 0,0:01:41.53,0:01:44.40,Default,,0,0,0,,Не, Құдай!? Иә!
Dialogue: 0,0:01:44.40,0:01:46.94,Default,,0,0,0,,Мен көптеген керемет пұттарды кездестірдім.
Dialogue: 0,0:01:46.94,0:01:49.05,Default,,0,0,0,,Мен де ұлы кумир болғым келеді.
Dialogue: 0,0:01:49.05,0:01:51.52,Default,,0,0,0,,Осы мақсатта
Dialogue: 0,0:01:51.52,0:01:55.18,Default,,0,0,0,,Сізге қазіргіден көбірек тырысу керек болады.
Dialogue: 0,0:01:55.18,0:02:01.00,Default,,0,0,0,,Еңбек етсең, тілегіңді орындаймын.
Dialogue: 0,0:02:01.00,0:02:04.50,Default,,0,0,0,,Иә! Мен бар күшімді саламын
Dialogue: 0,0:02:04.50,0:02:07.51,Default,,0,0,0,,Жарайды, маған қалдырыңыз.
Dialogue: 0,0:02:07.51,0:02:12.84,Default,,0,0,0,,Иә? (Лили) Бірақ орнына
Dialogue: 0,0:02:12.84,0:02:15.18,Default,,0,0,0,,Менің Раки-чанға өтінішім бар.
Dialogue: 0,0:02:15.18,0:02:17.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:04.18,0:05:06.18,Default,,0,0,0,,Мен Раки-чанды әкелдім.
Dialogue: 0,0:05:06.18,0:05:10.87,Default,,0,0,0,,Уау~ Идолдар өте көп
Dialogue: 0,0:05:10.87,0:05:15.33,Default,,0,0,0,,《Мен бірден көптеген кумирлерді кездестірдім. Бақытты》
Dialogue: 0,0:05:15.33,0:05:19.48,Default,,0,0,0,,Әлгі Юдзу-сан? (Майка) Маған Бақытты әкел
Dialogue: 0,0:05:19.48,0:05:22.48,Default,,0,0,0,,Бұл қандай жиын?
Dialogue: 0,0:05:22.48,0:05:25.39,Default,,0,0,0,,Шындығында, Юдзу мен Риен...
Dialogue: 0,0:05:25.39,0:05:29.17,Default,,0,0,0,,А...
Dialogue: 0,0:05:29.17,0:05:34.16,Default,,0,0,0,,Ако-чан мені жануарларға арналған бағдарлама жүргізуге тағайындады.
Dialogue: 0,0:05:34.16,0:05:38.37,Default,,0,0,0,,Бағдарламаны қызықты ету үшін барлығының бізге қосылғанын қалаймыз.
Dialogue: 0,0:05:38.37,0:05:41.34,Default,,0,0,0,,Сонымен, мен де келе аламын ба?
Dialogue: 0,0:05:41.34,0:05:44.02,Default,,0,0,0,,Иә, танысқаныма қуаныштымын.
Dialogue: 0,0:05:44.02,0:05:47.88,Default,,0,0,0,,Қосымша ақпарат алу үшін осы жерді басыңыз
Dialogue: 0,0:05:47.88,0:05:50.18,Default,,0,0,0,,Баршаңызға қайырлы күн
Dialogue: 0,0:05:50.18,0:05:54.17,Default,,0,0,0,,Менің Голливудтағы дебютім шешілді...
Dialogue: 0,0:05:54.17,0:05:58.17,Default,,0,0,0,,Мен Жапониядан біраз уақытқа кетемін.
Dialogue: 0,0:05:58.17,0:06:00.99,Default,,0,0,0,,Сол уақыт ішінде мен өз бағдарламамды жүргіздім.
Dialogue: 0,0:06:00.99,0:06:04.99,Default,,0,0,0,,Жүзі-сенпай мен Лили-сенпайға өтініш айттым.
Dialogue: 0,0:06:04.99,0:06:08.00,Default,,0,0,0,,Шынымды айтсам, аздап уайымдап тұрмын...
Dialogue: 0,0:06:08.00,0:06:11.18,Default,,0,0,0,,А, жоқ, бұл ештеңе емес!
Dialogue: 0,0:06:11.18,0:06:15.82,Default,,0,0,0,,Хмм! Бұл сізге тудыруы мүмкін кез келген қолайсыздық үшін кешірім сұраймыз.
Dialogue: 0,0:06:15.82,0:06:18.82,Default,,0,0,0,,Бес бос дәптер парағы
Dialogue: 0,0:06:18.82,0:06:21.84,Default,,0,0,0,,Міне. Тек!
Dialogue: 0,0:06:21.84,0:06:25.26,Default,,0,0,0,,Шоуды сол қалпында орындасаңыз, қызық емес.
Dialogue: 0,0:06:25.26,0:06:29.33,Default,,0,0,0,,Мен аздап бұралған апалы шоу жасауды жоспарлап отырмын.
Dialogue: 0,0:06:29.33,0:06:32.17,Default,,0,0,0,,Ой, бұл қандай бағдарлама болады екен?
Dialogue: 0,0:06:32.17,0:06:36.16,Default,,0,0,0,,Бірақ неге бізді шақырдыңыз?
Dialogue: 0,0:06:36.16,0:06:39.58,Default,,0,0,0,,Ал...
Dialogue: 0,0:06:39.58,0:06:42.01,Default,,0,0,0,,Дүние жүзіндегі Эма Хината
Dialogue: 0,0:06:42.01,0:06:44.00,Default,,0,0,0,,Майка Чоно
Dialogue: 0,0:06:44.00,0:06:46.00,Default,,0,0,0,,Комедияның кумирі Нина Дожима
Dialogue: 0,0:06:46.00,0:06:49.49,Default,,0,0,0,,Бақытты күш Химейши Раки-чан. Е!?
Dialogue: 0,0:06:49.49,0:06:52.32,Default,,0,0,0,,Егер бәріңізбен бағдарлама жасасақ ше?
Dialogue: 0,0:06:52.32,0:06:55.66,Default,,0,0,0,,Мен бұл шынымен қызықты болуы мүмкін деп ойладым.
Dialogue: 0,0:06:55.66,0:06:58.83,Default,,0,0,0,,Басқаша айтқанда, Юдзу интуициясы.
Dialogue: 0,0:06:58.83,0:07:04.00,Default,,0,0,0,,Юдзу Мен адамдарды көргенде күлдіретін бағдарлама жасағым келеді.
Dialogue: 0,0:07:04.00,0:07:06.34,Default,,0,0,0,,Күлімсірейтін бағдарламалар
Dialogue: 0,0:07:06.34,0:07:08.49,Default,,0,0,0,,Көңіл көтеру - ең жақсы нәрсе
Dialogue: 0,0:07:08.49,0:07:10.51,Default,,0,0,0,,Күлімсіреу
Dialogue: 0,0:07:10.51,0:07:13.49,Default,,0,0,0,,Күлкіге келгенде, маған қалдыр!
Dialogue: 0,0:07:13.49,0:07:17.65,Default,,0,0,0,,Қансайдың комедиялық кумирінен күткендей. Сенімді~
Dialogue: 0,0:07:17.65,0:07:19.68,Default,,0,0,0,,А, жоқ, бұл дұрыс емес.
Dialogue: 0,0:07:19.68,0:07:23.50,Default,,0,0,0,,Мен Қансайдан емеспін. (Майка) А? Солай ма?
Dialogue: 0,0:07:23.50,0:07:26.37,Default,,0,0,0,,Иә. Қансай диалектісін сахнада қолдануға бола ма?
Dialogue: 0,0:07:26.37,0:07:29.43,Default,,0,0,0,,Адамдарды күлдіретін есеп.
Dialogue: 0,0:07:29.43,0:07:31.66,Default,,0,0,0,,Юдзуға келетін болсақ, бұл рас.
Dialogue: 0,0:07:31.66,0:07:35.53,Default,,0,0,0,,Бағдарламаны жасауға бар күшімді саламын.
Dialogue: 0,0:07:35.53,0:07:37.82,Default,,0,0,0,,Барлығыңызға рахмет.
Dialogue: 0,0:07:37.82,0:07:40.51,Default,,0,0,0,,Рио! әпкеңе қалдыр
Dialogue: 0,0:07:40.51,0:07:42.82,Default,,0,0,0,,Қызық бола бастады, солай емес пе?
Dialogue: 0,0:07:42.82,0:07:45.36,Default,,0,0,0,,Жақсы, жақсы, жақсы сезім
Dialogue: 0,0:07:45.36,0:07:47.91,Default,,0,0,0,,Міне сценарий
Dialogue: 0,0:07:47.91,0:07:50.98,Default,,0,0,0,,Уау! Сіз әлі де мазмұнды өзгерте аласыз
Dialogue: 0,0:07:50.98,0:07:53.50,Default,,0,0,0,,Біз де барлығынан идея іздейміз.
Dialogue: 0,0:07:53.50,0:07:57.69,Default,,0,0,0,,Иә, иә, маған да бұрыш жасауға рұқсат етіңіз.
Dialogue: 0,0:07:57.69,0:08:00.63,Default,,0,0,0,,Лаки-чан, мұны бірге жасағыларың келе ме?
Dialogue: 0,0:08:00.63,0:08:03.85,Default,,0,0,0,,Қолдауыңыз үшін көп рахмет. Нина-чан
Dialogue: 0,0:08:03.85,0:08:08.25,Default,,0,0,0,,Арнайы қонақты шақырсақ қалай болады?
Dialogue: 0,0:08:08.25,0:08:10.67,Default,,0,0,0,,Мұны қабылдаңыз. Кім жақсы деп ойлайсың?
Dialogue: 0,0:08:10.67,0:08:12.69,Default,,0,0,0,,Әлде жануарлар ма?
Dialogue: 0,0:08:12.69,0:08:15.19,Default,,0,0,0,,《Менің ойымша, мен әртүрлі үлкендердің жұмысын көре аламын.
Dialogue: 0,0:08:15.19,0:08:19.68,Default,,0,0,0,,Менің де жаңа есігім ашылатын сияқты.
Dialogue: 0,0:08:19.68,0:08:22.68,Default,,0,0,0,,Камера айналады
Dialogue: 0,0:08:22.68,0:08:24.98,Default,,0,0,0,,３ ２…
Dialogue: 0,0:08:30.99,0:08:34.33,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:08:34.33,0:08:36.51,Default,,0,0,0,,Юдзу Никайдо!
Dialogue: 0,0:08:36.51,0:08:40.01,Default,,0,0,0,,Бұл Лили Широган. Рақмет сізге.
Dialogue: 0,0:08:40.01,0:08:43.52,Default,,0,0,0,,Бүгін жаңа жылдың бірінші күні, сондықтан ерекше.
Dialogue: 0,0:08:43.52,0:08:46.55,Default,,0,0,0,,«Юзутто Линян» басталғалы тұр.
Dialogue: 0,0:08:46.55,0:08:51.11,Default,,0,0,0,,Қонақтардың көп болуын және көп көңіл көтеруді мақсат етеміз.
Dialogue: 0,0:08:51.11,0:08:55.01,Default,,0,0,0,,Барлығы күледі! (2 адам) Мен жануарларды жақсы көремін!
Dialogue: 0,0:08:55.01,0:08:58.02,Default,,0,0,0,,Юзутто Линян
Dialogue: 0,0:08:58.02,0:09:01.04,Default,,0,0,0,,Ендеше, кенеттен болса да сахнаға шығайық.
Dialogue: 0,0:09:01.04,0:09:04.19,Default,,0,0,0,,Бірінші ән - Бал мысықтың екеуі.
Dialogue: 0,0:09:04.19,0:09:06.19,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:09:08.18,0:09:20.72,Default,,0,0,0,,～
Dialogue: 0,0:09:20.72,0:09:27.51,Default,,0,0,0,,«Сіз кесіп өткен жол айрығы, жасырын өрнек»
Dialogue: 0,0:09:27.51,0:09:31.52,Default,,0,0,0,,«Бұл мені күлдіретін біртүрлі».
Dialogue: 0,0:09:31.52,0:09:33.85,Default,,0,0,0,,«Ең жақсы бұрыш»
Dialogue: 0,0:09:33.85,0:09:40.02,Default,,0,0,0,,«Ол қалжыңға икемді, тез қарап алады».
Dialogue: 0,0:09:40.02,0:09:45.03,Default,,0,0,0,,«Осы жағы да бар».
Dialogue: 0,0:09:45.03,0:09:48.72,Default,,0,0,0,,«Өте жақсы».
Dialogue: 0,0:09:48.72,0:09:52.35,Default,,0,0,0,,«Мен мұны білмей тұрып, мен сенімен мәңгі бірге болғым келеді».
Dialogue: 0,0:09:52.35,0:09:55.52,Default,,0,0,0,,«Неғұрлым әртүрлі болса, соғұрлым күшті».
Dialogue: 0,0:09:55.52,0:10:01.70,Default,,0,0,0,,«Екеуміз бір-бірімізден ерекшеленеміз».
Dialogue: 0,0:10:01.70,0:10:08.52,Default,,0,0,0,,«Сенің басыңдағы нәрсе менікінен өзгеше екеніне сенімдімін».
Dialogue: 0,0:10:08.52,0:10:12.04,Default,,0,0,0,,«Кішкентай сәйкестіктер» «Тасып жатқан ғажайыптар»
Dialogue: 0,0:10:12.04,0:10:17.53,Default,,0,0,0,,«Ашық түстермен жинау».
Dialogue: 0,0:10:17.53,0:10:30.37,Default,,0,0,0,,～
Dialogue: 0,0:10:30.37,0:10:33.86,Default,,0,0,0,,«Ешқашан жалғыз еңкейме».
Dialogue: 0,0:10:33.86,0:10:37.20,Default,,0,0,0,,«Себебі бізде бөлек көздер бар».
Dialogue: 0,0:10:37.20,0:10:43.02,Default,,0,0,0,,«Мен ең кішкентай мүмкіндікті де жіберіп алмаймын».
Dialogue: 0,0:10:43.02,0:10:50.01,Default,,0,0,0,,«Сенің басыңдағы нәрсе менікінен өзгеше екеніне сенімдімін».
Dialogue: 0,0:10:50.01,0:10:53.53,Default,,0,0,0,,«Әдеттегі көрініс» «Мен бұрын көрмеген қала»
Dialogue: 0,0:10:53.53,0:11:00.19,Default,,0,0,0,,«Көп түсті таралу».
Dialogue: 0,0:11:00.19,0:11:04.19,Default,,0,0,0,,～
Dialogue: 0,0:11:04.19,0:11:07.85,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:11:07.85,0:11:09.83,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:11:09.83,0:11:11.85,Default,,0,0,0,,Осыдан кейін мен және Майка Чоно
Dialogue: 0,0:11:11.85,0:11:16.90,Default,,0,0,0,,Эма Хината жіберген «Фурей жануарлары» бұрышы
Dialogue: 0,0:11:16.90,0:11:22.34,Default,,0,0,0,,Енді арнайы қонаққа келейік.
Dialogue: 0,0:11:22.34,0:11:25.18,Default,,0,0,0,,Сәлем, бұл Микуру Нацуки.
Dialogue: 0,0:11:25.18,0:11:27.21,Default,,0,0,0,,ｷｭｷｭｰ
Dialogue: 0,0:11:27.21,0:11:29.27,Default,,0,0,0,,Бұл баланың аты Феррет.
Dialogue: 0,0:11:29.27,0:11:32.50,Default,,0,0,0,,Уау, бұл сүйкімді. Бұл күзен.
Dialogue: 0,0:11:32.50,0:11:35.37,Default,,0,0,0,,Иә, ол өте жақсы қыз.
Dialogue: 0,0:11:35.37,0:11:38.53,Default,,0,0,0,,Сонымен... сүйкімді~
Dialogue: 0,0:11:38.53,0:11:43.70,Default,,0,0,0,,Ахаха... Менің ойымша, сіз ұсақ жануарлармен жақсы қарым-қатынаста емессіз.
Dialogue: 0,0:11:43.70,0:11:48.57,Default,,0,0,0,,Ал, мен сендерге Микуру мен Ферретаның кереметін көрсетейін.
Dialogue: 0,0:11:48.57,0:11:52.19,Default,,0,0,0,,Кеттік, Феррета. Отыр.
Dialogue: 0,0:11:52.19,0:11:54.18,Default,,0,0,0,,Қолдар
Dialogue: 0,0:11:54.18,0:11:56.21,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:11:56.21,0:11:59.26,Default,,0,0,0,,《Феррета ұсақ жануарлар санатына жатады ма?
Dialogue: 0,0:11:59.26,0:12:02.52,Default,,0,0,0,,хомяк тым кішкентай және қорқынышты. Бірақ котенка жақсы.
Dialogue: 0,0:12:02.52,0:12:05.50,Default,,0,0,0,,Көлемі бойынша Ферретта котенкамен бірдей ме?
Dialogue: 0,0:12:05.50,0:12:08.69,Default,,0,0,0,,Мен бір нәрсені түсінбей бастадым...
Dialogue: 0,0:12:08.69,0:12:11.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:11.36,0:12:15.01,Default,,0,0,0,,Уф... Жарайды. Сен тыныш баласың.
Dialogue: 0,0:12:15.01,0:12:17.68,Default,,0,0,0,,Ема-чан оны еркелеткенімді қалайтын сияқты.
Dialogue: 0,0:12:17.68,0:12:20.28,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:12:24.57,0:12:28.03,Default,,0,0,0,,Жарайды... бұл біраз қорқынышты болуы мүмкін.
Dialogue: 0,0:12:28.03,0:12:30.18,Default,,0,0,0,,《Эмма-чан, қолыңнан келгенін істе》
Dialogue: 0,0:12:30.18,0:12:33.18,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:12:33.18,0:12:35.35,Default,,0,0,0,,Кью. Ах...
Dialogue: 0,0:12:35.35,0:12:38.70,Default,,0,0,0,,Жарайсыңдар. Эма, сен істедің.
Dialogue: 0,0:12:38.70,0:12:41.50,Default,,0,0,0,,Уау... Мен қатты әсер алдым.
Dialogue: 0,0:12:43.52,0:12:45.88,Default,,0,0,0,,《Мен де өзіме күш салдым.
Dialogue: 0,0:12:45.88,0:12:48.51,Default,,0,0,0,,Мен біраз қобалжыдым.
Dialogue: 0,0:12:48.51,0:12:50.85,Default,,0,0,0,,Мен қазір өте бақыттымын》
Dialogue: 0,0:12:50.85,0:12:53.35,Default,,0,0,0,,Ахаха сондай сүйкімді
Dialogue: 0,0:12:53.35,0:12:58.27,Default,,0,0,0,,Әрі қарай, бұл біздің бұрышымыз.
Dialogue: 0,0:12:58.27,0:13:02.69,Default,,0,0,0,,Юдзу айтқандай, көп күлуді мақсат етейік!
Dialogue: 0,0:13:02.69,0:13:06.79,Default,,0,0,0,,Иә! Жаңа есік ашайық!
Dialogue: 0,0:13:09.60,0:13:11.87,Default,,0,0,0,,Чао! Бұл Раки Химейши.
Dialogue: 0,0:13:11.87,0:13:15.74,Default,,0,0,0,,Көп күлкі! Дожима Нина!
Dialogue: 0,0:13:15.74,0:13:20.24,Default,,0,0,0,,«Сәтті жануар қош келдіңіз!» бұрыш басталады
Dialogue: 0,0:15:01.51,0:15:05.02,Default,,0,0,0,,Ал, бүгін біз Бақыттыға байланысты жануарлар туралы сөйлесеміз.
Dialogue: 0,0:15:05.02,0:15:07.18,Default,,0,0,0,,Мен сені Мечамен таныстырамын.
Dialogue: 0,0:15:07.18,0:15:09.17,Default,,0,0,0,,《Тамаша! Нина-чан
Dialogue: 0,0:15:09.17,0:15:12.36,Default,,0,0,0,,Нақты спектакль басталғаннан кейінгі менің шиеленісуім мүлдем басқаша болды.
Dialogue: 0,0:15:12.36,0:15:14.86,Default,,0,0,0,,Мен де ұтылмаймын》
Dialogue: 0,0:15:14.86,0:15:18.36,Default,,0,0,0,,Енді мен бұл жолы таныстыратыным ~
Dialogue: 0,0:15:23.48,0:15:26.34,Default,,0,0,0,,Бұл Үкіден шыққан Хо Чан. (Хо-чан) Хо
Dialogue: 0,0:15:26.34,0:15:28.37,Default,,0,0,0,,Қарға «сәттілік келеді» дейді
Dialogue: 0,0:15:28.37,0:15:30.51,Default,,0,0,0,,«Қиындықсыз» мағынасында
Dialogue: 0,0:15:30.51,0:15:32.83,Default,,0,0,0,,Сәттілік әкелетін берекелі жаратылыс ретінде де белгілі.
Dialogue: 0,0:15:32.83,0:15:35.50,Default,,0,0,0,,Қауіпті екені айтылады.
Dialogue: 0,0:15:35.50,0:15:38.80,Default,,0,0,0,,Мұны көргенде сен де қуанасың. Эй Хо Чан
Dialogue: 0,0:15:41.37,0:15:43.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:43.90,0:15:46.82,Default,,0,0,0,,ﾋﾞﾖｰﾝ！ ﾊﾟｯ
Dialogue: 0,0:15:46.82,0:15:49.83,Default,,0,0,0,,О, сізді таң қалдырғаным үшін кешіріңіз.
Dialogue: 0,0:15:49.83,0:15:52.73,Default,,0,0,0,,Қиналдым, қиналдым
Dialogue: 0,0:15:55.98,0:15:58.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:58.17,0:16:00.85,Default,,0,0,0,,Мүмкін Хочанның да басына түскен шығар~
Dialogue: 0,0:16:00.85,0:16:04.01,Default,,0,0,0,,Не? Хо-чанды әкел
Dialogue: 0,0:16:04.01,0:16:07.34,Default,,0,0,0,,Негізі Нина-чан ең көп қиналған адам.
Dialogue: 0,0:16:07.34,0:16:11.48,Default,,0,0,0,,Мен жалқаумын деген сөздерді доғарғаныңызды қалаймын!
Dialogue: 0,0:16:11.48,0:16:14.50,Default,,0,0,0,,Себебі сен Хочанды қатты қуантып жатырсың.
Dialogue: 0,0:16:14.50,0:16:18.66,Default,,0,0,0,,Ача~ Бейонға енді Раки-чан рұқсат етілмейді
Dialogue: 0,0:16:18.66,0:16:21.83,Default,,0,0,0,,Жоқ! (2 адам) Бейонг. Пат!
Dialogue: 0,0:16:21.83,0:16:24.83,Default,,0,0,0,,Олар мұны бірден істеп жатыр!
Dialogue: 0,0:16:24.83,0:16:29.73,Default,,0,0,0,,Енді Раки-чан да комедия айдолдарының қатарына қосылады.
Dialogue: 0,0:16:29.73,0:16:32.67,Default,,0,0,0,,Е, мен бұл туралы естімеппін!
Dialogue: 0,0:16:32.67,0:16:34.82,Default,,0,0,0,,Комедияның айдолдары!
Dialogue: 0,0:16:34.82,0:16:37.66,Default,,0,0,0,,Комедия немесе айдол, біреуін таңдаңыз!
Dialogue: 0,0:16:37.66,0:16:39.68,Default,,0,0,0,,ｱﾀｰｯ！
Dialogue: 0,0:16:39.68,0:16:42.33,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:16:42.33,0:16:46.32,Default,,0,0,0,,《Әр адам өмір сүруге шебер. Бұл керемет》
Dialogue: 0,0:16:46.32,0:16:49.17,Default,,0,0,0,,Комедиялық идолдар өте күлкілі емес
Dialogue: 0,0:16:49.17,0:16:52.67,Default,,0,0,0,,Екеуі де жаман адамдар.
Dialogue: 0,0:16:52.67,0:16:56.83,Default,,0,0,0,,Енді Хо-чан аман-есен оралды,
Dialogue: 0,0:16:56.83,0:16:59.51,Default,,0,0,0,,Нина-чанның сахнасына барайық
Dialogue: 0,0:16:59.51,0:17:03.21,Default,,0,0,0,,Енді не көріп тұрсыңдар? Хоо
Dialogue: 0,0:17:05.40,0:17:09.60,Default,,0,0,0,,Иә! Барлығы жиналсын!
Dialogue: 0,0:17:11.53,0:17:19.83,Default,,0,0,0,,«Миел миел, бал миел»
Dialogue: 0,0:17:19.83,0:17:26.01,Default,,0,0,0,,«Мильмье жарығы – люмиер»
Dialogue: 0,0:17:26.01,0:17:30.49,Default,,0,0,0,,｢ﾐｴﾙ ｷﾃﾙ ｻﾌﾟﾗｲｽﾞ｣
Dialogue: 0,0:17:30.49,0:17:35.00,Default,,0,0,0,,"Ах! Сол дүкенге барайық."
Dialogue: 0,0:17:35.00,0:17:43.16,Default,,0,0,0,,«Осылай аталу сезімі».
Dialogue: 0,0:17:43.16,0:17:47.33,Default,,0,0,0,,«Тағдырлы кездейсоқтық»
Dialogue: 0,0:17:47.33,0:17:55.50,Default,,0,0,0,,«Купиттің де кернеуі жоғары»
Dialogue: 0,0:17:55.50,0:17:59.51,Default,,0,0,0,,«Мен тым көп нәрсені қалаймын».
Dialogue: 0,0:17:59.51,0:18:04.16,Default,,0,0,0,,«Бәрі көз қысып тұр».
Dialogue: 0,0:18:04.16,0:18:06.53,Default,,0,0,0,,«Мен армандаймын».
Dialogue: 0,0:18:06.53,0:18:12.84,Default,,0,0,0,,«Бір күні бүкіл қала шкафтың шахтасы болады!»
Dialogue: 0,0:18:12.84,0:18:18.99,Default,,0,0,0,,«Бір ғана кездесудің кереметі».
Dialogue: 0,0:18:18.99,0:18:21.16,Default,,0,0,0,,«Жарқыраған»
Dialogue: 0,0:18:21.16,0:18:27.07,Default,,0,0,0,,«Шашақты бал түсті жарық»
Dialogue: 0,0:18:27.07,0:18:29.67,Default,,0,0,0,,«Бір-біріне қара»
Dialogue: 0,0:18:29.67,0:18:33.84,Default,,0,0,0,,«Менің жәрдемақым шектеулі».
Dialogue: 0,0:18:33.84,0:18:42.00,Default,,0,0,0,,«Сондықтан мен сізбен хабарласамын».
Dialogue: 0,0:18:42.00,0:18:50.01,Default,,0,0,0,,«Миел миел, бал - миел».
Dialogue: 0,0:18:50.01,0:18:56.55,Default,,0,0,0,,«Мильмье жарығы – люмиер»
Dialogue: 0,0:18:56.55,0:19:01.02,Default,,0,0,0,,｢ﾐｴﾙ ﾜｶﾙ｣
Dialogue: 0,0:19:01.02,0:19:06.94,Default,,0,0,0,,～
Dialogue: 0,0:19:06.94,0:19:11.36,Default,,0,0,0,,Келесі - «Жануарларды жылдам басу викторинасы» бұрышы.
Dialogue: 0,0:19:11.36,0:19:15.53,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:19:15.53,0:19:18.50,Default,,0,0,0,,Йохо Харука да келді
Dialogue: 0,0:19:18.50,0:19:20.90,Default,,0,0,0,,ﾒｯﾁｬ ｻﾌﾟﾗｲｽﾞ！
Dialogue: 0,0:19:20.90,0:19:24.51,Default,,0,0,0,,Мен таң қалдым. Харука Микуру-чан командасынан.
Dialogue: 0,0:19:24.51,0:19:28.00,Default,,0,0,0,,Иә, иә. Сізбен танысқаныма қуаныштымын. Сатып ал!
Dialogue: 0,0:19:28.00,0:19:30.36,Default,,0,0,0,,Шу шығармаңыз~
Dialogue: 0,0:19:30.36,0:19:33.72,Default,,0,0,0,,Енді мәселеге тікелей көшейік.
Dialogue: 0,0:19:33.72,0:19:37.27,Default,,0,0,0,,1-сұрақ. Сиырдың асқазаны...
Dialogue: 0,0:19:37.27,0:19:40.49,Default,,0,0,0,,Сан 4!
Dialogue: 0,0:19:40.49,0:19:42.69,Default,,0,0,0,,Бірақ соғыс жыртқыштары сиқыр қолдана алмайды ғой, иә?
Dialogue: 0,0:19:42.69,0:19:45.55,Default,,0,0,0,,Не? Мен сізге әлі барлық сұрақтарды айтқан жоқпын.
Dialogue: 0,0:19:45.55,0:19:49.12,Default,,0,0,0,,Эй Майка, егер бұл айлалы сұрақ болса, не істер едің?
Dialogue: 0,0:19:49.12,0:19:52.84,Default,,0,0,0,,Кішкене құмар ойын. Сіз бірінші сұрақтан жақсы боласыз, солай ма?
Dialogue: 0,0:19:52.84,0:19:55.84,Default,,0,0,0,,Уау, бұл сұмдық жау.
Dialogue: 0,0:19:55.84,0:19:57.84,Default,,0,0,0,,Бұл екеуі керемет
Dialogue: 0,0:19:57.84,0:20:02.20,Default,,0,0,0,,Гүлдер мен өсімдіктерге келсек, мен де еш айырмашылығым жоқ.
Dialogue: 0,0:20:02.20,0:20:05.17,Default,,0,0,0,,Келесі сұраққа көшейік.
Dialogue: 0,0:20:05.17,0:20:07.57,Default,,0,0,0,,Екінші...
Dialogue: 0,0:20:07.57,0:20:10.84,Default,,0,0,0,,Иә!? Мен оны бірінші басуға тырыстым.
Dialogue: 0,0:20:10.84,0:20:13.84,Default,,0,0,0,,Микуру-сан Сосын...
Dialogue: 0,0:20:13.84,0:20:15.84,Default,,0,0,0,,ﾊﾞﾄﾝﾀｯﾁ！
Dialogue: 0,0:20:15.84,0:20:20.16,Default,,0,0,0,,Жоқ, жоқ... бұл тіпті сұраққа жауап бермейді.
Dialogue: 0,0:20:20.16,0:20:22.37,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:22.37,0:20:25.20,Default,,0,0,0,,Микуру-сан Файтин Файтин
Dialogue: 0,0:20:25.20,0:20:27.34,Default,,0,0,0,,Жеміс?
Dialogue: 0,0:20:27.34,0:20:31.36,Default,,0,0,0,,Бұл дұрыс. Бақытты!
Dialogue: 0,0:20:31.36,0:20:34.68,Default,,0,0,0,,Сәлем, Харука! Кез келген мәселені тыңдаңыз
Dialogue: 0,0:20:34.68,0:20:38.20,Default,,0,0,0,,Бұл басқа ойынға айналады. Иә.
Dialogue: 0,0:20:38.20,0:20:41.34,Default,,0,0,0,,Мен мүлде жауап бере алмаймын. Жарайды.
Dialogue: 0,0:20:41.34,0:20:43.67,Default,,0,0,0,,Lucky-chan Келесі Қолдан келгеннің бәрін жасайық!
Dialogue: 0,0:20:43.67,0:20:47.74,Default,,0,0,0,,Жарайды, соңғы сұрақ. иә? Соңғысы?
Dialogue: 0,0:20:47.74,0:20:50.79,Default,,0,0,0,,және мұнда үлкен мүмкіндік бар
Dialogue: 0,0:20:50.79,0:20:53.20,Default,,0,0,0,,Бұл ерекше ереже.
Dialogue: 0,0:20:53.20,0:20:56.57,Default,,0,0,0,,Осы сұраққа дұрыс жауап берген топ жеңімпаз атанады.
Dialogue: 0,0:20:56.57,0:20:58.59,Default,,0,0,0,,Е!
Dialogue: 0,0:20:58.59,0:21:01.21,Default,,0,0,0,,Бұл орынды міндетті түрде алу керек.
Dialogue: 0,0:21:01.21,0:21:06.03,Default,,0,0,0,,3-сұрақ.Ол дүниедегі ең бақытты жануар дейді.
Dialogue: 0,0:21:06.03,0:21:09.03,Default,,0,0,0,,Aqua Love белгілері қандай?
Dialogue: 0,0:21:09.03,0:21:12.83,Default,,0,0,0,,Кеңес! Жауабы осы бағдарламада.
Dialogue: 0,0:21:16.19,0:21:19.86,Default,,0,0,0,,《Мен оны күшпен итеріп жібердім, бірақ мен мүлдем түсінбеймін》
Dialogue: 0,0:21:19.86,0:21:22.86,Default,,0,0,0,,《Жауап бағдарламада ма?
Dialogue: 0,0:21:22.86,0:21:25.35,Default,,0,0,0,,А, мүмкін》
Dialogue: 0,0:21:25.35,0:21:28.50,Default,,0,0,0,,Лаки-чан бұл
Dialogue: 0,0:21:28.50,0:21:31.69,Default,,0,0,0,,А, күлімсіреу?
Dialogue: 0,0:21:31.69,0:21:35.56,Default,,0,0,0,,Бұл дұрыс. Алақай! Мен оны істедім!
Dialogue: 0,0:21:35.56,0:21:41.53,Default,,0,0,0,,Aqua Lover Австралияда тұратын сүйкімді күлкілі жануар.
Dialogue: 0,0:21:41.53,0:21:45.52,Default,,0,0,0,,Өте сүйкімді! Бұл сізді шынымен күлдіретін жануар.
Dialogue: 0,0:21:45.52,0:21:48.67,Default,,0,0,0,,Бұл күлкілі жануар
Dialogue: 0,0:21:48.67,0:21:55.18,Default,,0,0,0,,Сонымен жеңімпаз Лаки-чан және Нина-чан командасы
Dialogue: 0,0:21:55.18,0:21:57.18,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:57.18,0:21:59.85,Default,,0,0,0,,Ха... Мен оны жақсы көрдім.
Dialogue: 0,0:21:59.85,0:22:03.73,Default,,0,0,0,,Пұттардың, күлкілердің және энергияның синергетикасы
Dialogue: 0,0:22:03.73,0:22:06.85,Default,,0,0,0,,Енді теңдеу аяқталды
Dialogue: 0,0:22:06.85,0:22:09.02,Default,,0,0,0,,ｲｴｰｲ！
Dialogue: 0,0:22:09.02,0:22:14.68,Default,,0,0,0,,Сіз Юзутто Лилидің сахнасының басталуын күткенсіз.
Dialogue: 0,0:22:14.68,0:22:16.70,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:22:16.70,0:22:33.30,Default,,0,0,0,,～
Dialogue: 0,0:22:33.30,0:22:41.91,Default,,0,0,0,,«Күн күлімдеді, сондықтан құстар мен шөптер әуен айтады».
Dialogue: 0,0:22:41.91,0:22:49.85,Default,,0,0,0,,«Гүлдердің иісі мен судың иісі.Қайда қаласақ, соған барайық».
Dialogue: 0,0:22:49.85,0:22:53.85,Default,,0,0,0,,«Қолдарыңызды қанатыңызды жайғандай көтеріп, поза жасаңыз».
Dialogue: 0,0:22:53.85,0:22:58.02,Default,,0,0,0,,«Иә, енді бұрылып, келесі тармаққа сүңгіңіз».
Dialogue: 0,0:22:58.02,0:23:04.53,Default,,0,0,0,,"Иә! Мен барлық джунглиді, орманды, тауларды және өзенді аралап жүгіргім келеді."
Dialogue: 0,0:23:04.53,0:23:07.03,Default,,0,0,0,,～
Dialogue: 0,0:23:07.03,0:23:14.86,Default,,0,0,0,,«Жануарлар денелерін кез келген уақытта еркін қозғалта алатыны сияқты».
Dialogue: 0,0:23:14.86,0:23:23.03,Default,,0,0,0,,«Мен ырғақты табиғи түрде ойнаймын, мен дыбысқа қазірдің өзінде толқуым мүмкін».
Dialogue: 0,0:23:23.03,0:23:27.02,Default,,0,0,0,,«Карнавал бүкіл әлемде ойналды»
Dialogue: 0,0:23:27.02,0:23:31.86,Default,,0,0,0,,«Ритмге сай билейік»
Dialogue: 0,0:23:31.86,0:23:35.84,Default,,0,0,0,,«Мен қандай қадамдар жасауым керек?»
Dialogue: 0,0:23:35.84,0:23:39.85,Default,,0,0,0,,«Мен сені бұрыннан білемін».
Dialogue: 0,0:23:39.85,0:23:48.52,Default,,0,0,0,,«Егер сіз өзіңіздің қызығушылығыңызға ерсеңіз, сіз ешкімге еліктей алмайтын нәрсеге айнала аласыз».
Dialogue: 0,0:23:48.52,0:23:52.83,Default,,0,0,0,,«Біз бұрын көрмеген табиғатты тамашалайық».
Dialogue: 0,0:23:52.83,0:23:58.78,Default,,0,0,0,,«Шытырман оқиға басталады».
Dialogue: 0,0:23:58.78,0:24:03.00,Default,,0,0,0,,｢Бұл жай ғана жаңа әлем｣
Dialogue: 0,0:24:03.00,0:24:12.83,Default,,0,0,0,,～
Dialogue: 0,0:24:12.83,0:24:14.83,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:24:14.83,0:24:19.84,Default,,0,0,0,,Бүгін біз барлығымыз қуат пен күлкіге толы болдық.
Dialogue: 0,0:24:19.84,0:24:22.34,Default,,0,0,0,,«Күлгендерге бақыт та келеді».
Dialogue: 0,0:24:22.34,0:24:27.48,Default,,0,0,0,,Фуку бақытты дегенді білдіреді, солай емес пе? Бұл дұрыс. Па!
Dialogue: 0,0:24:27.48,0:24:30.50,Default,,0,0,0,,Келесі аптада кездескенше.
Dialogue: 0,0:24:30.50,0:24:32.83,Default,,0,0,0,,Бізбен бірге болыңыз!
Dialogue: 0,0:24:32.83,0:24:35.03,Default,,0,0,0,,ﾊﾞｲﾊﾞｲ！
Dialogue: 0,0:24:37.82,0:24:40.21,Default,,0,0,0,,ｷｬﾊｰｯ！
Dialogue: 0,0:24:40.21,0:24:43.16,Default,,0,0,0,,Лаки-чан қазір қатты күліп тұр
Dialogue: 0,0:24:43.16,0:24:46.53,Default,,0,0,0,,Бұл өте қызықты және қарауға қуат беретін сахна.
Dialogue: 0,0:24:46.53,0:24:49.32,Default,,0,0,0,,Мен біраз қуат алдым.
Dialogue: 0,0:24:49.32,0:24:51.33,Default,,0,0,0,,Оған не болды?
Dialogue: 0,0:24:51.33,0:24:54.32,Default,,0,0,0,,Балық балық адамды күлдіреді, көңілді көтереді!
Dialogue: 0,0:24:54.32,0:24:58.83,Default,,0,0,0,,Бұл энергияны алатын адам ғана емес, оны беретін адам да.
Dialogue: 0,0:24:58.83,0:25:02.16,Default,,0,0,0,,Мен өте керемет нәрсе естідім.
Dialogue: 0,0:25:02.16,0:25:04.50,Default,,0,0,0,,Бұл шынымен ақылсыз.
Dialogue: 0,0:25:04.50,0:25:08.82,Default,,0,0,0,,Мен де адамдарды күлдіргім келеді және көңіл-күйді жақсартқым келеді!
Dialogue: 0,0:25:08.82,0:25:10.82,Default,,0,0,0,,Иә, бар күшіңізді салыңыз.
Dialogue: 0,0:25:10.82,0:25:13.84,Default,,0,0,0,,Мен Раки Чанның сүйкімді қызын іздеп жүрмін.
Dialogue: 0,0:25:13.84,0:25:16.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:25:19.16,0:25:22.83,Default,,0,0,0,,Келесі аптада кездескенше. Оны асыға күтіңіз.
Dialogue: 0,0:25:22.83,0:25:26.00,Default,,0,0,0,,ﾊﾞｲﾊﾞｲ！
Dialogue: 0,0:25:26.00,0:25:27.99,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:25:27.99,0:25:30.66,Default,,0,0,0,,Олар көңілді жүрген сияқты, бірақ олар қу!
Dialogue: 0,0:25:30.66,0:25:36.16,Default,,0,0,0,,Келесі жолы мен де бар күшімді саламын!
Dialogue: 0,0:28:10.83,0:28:13.19,Default,,0,0,0,,Бүгін де жеке шолу жиналысының басталуы.
Dialogue: 0,0:28:13.19,0:28:15.19,Default,,0,0,0,,Бұл туралы алаңдамағаныңыз жөн.
Dialogue: 0,0:28:15.19,0:28:18.56,Default,,0,0,0,,Уау, олардың көптігі сонша, мен тіпті есептерді орындай алмаймын!
Dialogue: 0,0:28:18.56,0:28:21.26,Default,,0,0,0,,Ертең жел соғады
Dialogue: 0,0:30:38.35,0:30:41.50,Default,,0,0,0,,Бұл тікелей эфир болғандықтан, субтитрлерде типографиялық қателер болуы мүмкін. Түсінгеніңізге рахмет.
Dialogue: 0,0:30:43.00,0:30:49.00,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
