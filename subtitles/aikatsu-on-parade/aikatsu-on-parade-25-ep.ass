Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.14,0:00:11.12,Default,,0,0,0,,Бәріміз ән айтайық...
Dialogue: 0,0:00:11.12,0:00:13.13,Default,,0,0,0,,Би билейік. Кумирлер де...
Dialogue: 0,0:00:13.13,0:00:15.58,Default,,0,0,0,,Көйлектер де... Үлкен жиын!
Dialogue: 0,0:00:15.58,0:00:19.88,Default,,0,0,0,,『Икацуон шеруі! «Ол басталады! Ой
Dialogue: 0,0:00:21.77,0:00:23.79,Default,,0,0,0,,Хмм, жақсы ауа-райы!
Dialogue: 0,0:00:23.79,0:00:25.77,Default,,0,0,0,,Өйткені ол өшірулі.
Dialogue: 0,0:00:25.77,0:00:27.77,Default,,0,0,0,,Бірге демалайық, Раки-чан!
Dialogue: 0,0:00:27.77,0:00:29.79,Default,,0,0,0,,Рахмет
Dialogue: 0,0:00:29.79,0:00:33.11,Default,,0,0,0,,Жан! (2 адам) Томат насыбайгүл ірімшігі ерекше сэндвич!
Dialogue: 0,0:00:33.11,0:00:35.11,Default,,0,0,0,,Керемет!
Dialogue: 0,0:00:35.11,0:00:37.78,Default,,0,0,0,,Біз де кедергі жасай аламыз ба?
Dialogue: 0,0:00:37.78,0:00:40.45,Default,,0,0,0,,Ичиго-чан, Акари-чан, Юмэ-чан!?
Dialogue: 0,0:00:40.45,0:00:43.12,Default,,0,0,0,,Мен түскі қорапты әкелдім.
Dialogue: 0,0:00:43.12,0:00:45.44,Default,,0,0,0,,Мен де тортымды алып келдім.
Dialogue: 0,0:00:45.44,0:00:48.11,Default,,0,0,0,,Иә! Кәне!
Dialogue: 0,0:00:48.11,0:00:50.11,Default,,0,0,0,,Қалайсыңдар!?
Dialogue: 0,0:00:50.11,0:00:53.80,Default,,0,0,0,,Сіз таң қалдыңыз ба? Кішкене қосымша
Dialogue: 0,0:00:53.80,0:00:56.47,Default,,0,0,0,,Негізі бізден Лаки-чанға.
Dialogue: 0,0:00:56.47,0:00:59.82,Default,,0,0,0,,Бір өтініш бойынша жиналдық. Өтініш?
Dialogue: 0,0:00:59.82,0:01:04.79,Default,,0,0,0,,Lucky-chan Айкацу On Parade оқиғасы Сіз өте көп жұмыс істедіңіз.
Dialogue: 0,0:01:04.79,0:01:07.46,Default,,0,0,0,,Біз де алғысымызды білдіргіміз келеді...
Dialogue: 0,0:01:07.46,0:01:09.77,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:01:09.77,0:01:14.10,Default,,0,0,0,,Бізбен бірге сахнаға шығуды қалайсыз ба?
Dialogue: 0,0:01:14.10,0:01:16.10,Default,,0,0,0,,Иә!!
Dialogue: 0,0:04:02.44,0:04:06.84,Default,,0,0,0,,ｱｲｶﾂ ｱｲｶﾂ ｱｲｶﾂ ｱｲｶﾂ！
Dialogue: 0,0:04:06.84,0:04:10.10,Default,,0,0,0,,Лаки-чан күш алды. Шынымен!
Dialogue: 0,0:04:10.10,0:04:13.77,Default,,0,0,0,,Мен алғаш бастаған кезде, бұл менің қолымнан келгеннің барлығын орындау болды.
Dialogue: 0,0:04:13.77,0:04:15.77,Default,,0,0,0,,Мен бәрімен көңілді жүргенімде
Dialogue: 0,0:04:15.77,0:04:18.47,Default,,0,0,0,,Мен де жүгіруді ұната бастадым.
Dialogue: 0,0:04:21.19,0:04:23.74,Default,,0,0,0,,Себебі Мизуки-сан маған кеңсесін қарызға берді.
Dialogue: 0,0:04:23.74,0:04:26.10,Default,,0,0,0,,Сіз қалағаныңызша көп сабақ ала аласыз
Dialogue: 0,0:04:26.10,0:04:29.75,Default,,0,0,0,,Мен барлығымен бірге сабақ алуды асыға күттім.
Dialogue: 0,0:04:29.75,0:04:32.10,Default,,0,0,0,,Мен де!
Dialogue: 0,0:04:32.10,0:04:34.44,Default,,0,0,0,,Лаки-чан, не болды?
Dialogue: 0,0:04:34.44,0:04:37.77,Default,,0,0,0,,Муша дірілдейді!
Dialogue: 0,0:04:37.77,0:04:41.79,Default,,0,0,0,,Олай болса, бірден бастайық. иә!
Dialogue: 0,0:04:41.79,0:04:57.53,Default,,0,0,0,,...
Dialogue: 0,0:04:57.53,0:05:00.10,Default,,0,0,0,,Эй, мен шаршадым.
Dialogue: 0,0:05:00.10,0:05:03.12,Default,,0,0,0,,Мен мұндайды көрмегелі біраз болды!
Dialogue: 0,0:05:03.12,0:05:05.72,Default,,0,0,0,,Сәлем! Мен жақсы нәрсе ойлап таптым!
Dialogue: 0,0:05:07.77,0:05:09.77,Default,,0,0,0,,ﾌﾌﾌﾌｯ
Dialogue: 0,0:05:11.77,0:05:14.11,Default,,0,0,0,,Джажан! О!
Dialogue: 0,0:05:14.11,0:05:17.13,Default,,0,0,0,,Уау! үшін бірге жақсы көрінеді!
Dialogue: 0,0:05:17.13,0:05:20.78,Default,,0,0,0,,Акари-чанның лентасы соншалықты сағыныш сезімін тудырады.
Dialogue: 0,0:05:20.78,0:05:26.17,Default,,0,0,0,,Иә, себебі дебют жасағанда Хошимия-сенпайға еліктедім.
Dialogue: 0,0:05:26.17,0:05:28.77,Default,,0,0,0,,Акари-чан Мен әрқашан Ичиго-чанға тәнті болдым
Dialogue: 0,0:05:28.77,0:05:31.11,Default,,0,0,0,,Сіз мұны айттыңыз.
Dialogue: 0,0:05:31.11,0:05:33.13,Default,,0,0,0,,Мен сенің сезіміңді білемін.
Dialogue: 0,0:05:33.13,0:05:36.78,Default,,0,0,0,,Мен Химе-сенпайдай болғым келді.
Dialogue: 0,0:05:36.78,0:05:39.79,Default,,0,0,0,,Мен Айкацу ойнай бастадым. Мен де.
Dialogue: 0,0:05:39.79,0:05:42.77,Default,,0,0,0,,Сахнада Мизуки-санды көргеннен кейін кумирге айналдым.
Dialogue: 0,0:05:42.77,0:05:44.82,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:05:44.82,0:05:46.78,Default,,0,0,0,,Мені Мио шақырды
Dialogue: 0,0:05:46.78,0:05:49.46,Default,,0,0,0,,Мен Мио сияқты кумир болғым келеді
Dialogue: 0,0:05:49.46,0:05:55.45,Default,,0,0,0,,Мен үшін Lovemeetia-ның екі мүшесі мен іздеген жол көрсетуші тіректер болды.
Dialogue: 0,0:05:55.45,0:05:57.49,Default,,0,0,0,,《Мен түсінемін.
Dialogue: 0,0:05:57.49,0:06:00.77,Default,,0,0,0,,Менің үлкендерімде де сондай кез болған.
Dialogue: 0,0:06:00.77,0:06:02.77,Default,,0,0,0,,(шу)
Dialogue: 0,0:06:07.15,0:06:09.18,Default,,0,0,0,,Чао! Апыр-ай!
Dialogue: 0,0:06:09.18,0:06:11.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:11.08,0:06:13.08,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:06:15.09,0:06:17.11,Default,,0,0,0,,Бақытты-чан! Аа!?
Dialogue: 0,0:06:17.11,0:06:20.54,Default,,0,0,0,,Бұл шынайы! Апыр-ай!
Dialogue: 0,0:06:20.54,0:06:23.10,Default,,0,0,0,,Сіз Лаки Чанның жанкүйерісіз бе?
Dialogue: 0,0:06:23.10,0:06:25.15,Default,,0,0,0,,Соған ұқсайды!
Dialogue: 0,0:06:25.15,0:06:28.45,Default,,0,0,0,,Мен бұл көздерді білемін...
Dialogue: 0,0:06:28.45,0:06:41.76,Default,,0,0,0,,...
Dialogue: 0,0:06:41.76,0:06:44.76,Default,,0,0,0,,Бір күні біз...
Dialogue: 0,0:06:46.75,0:06:50.17,Default,,0,0,0,,Ум, кешіріңіз. Мен сенің сабағыңа үңілдім.
Dialogue: 0,0:06:50.17,0:06:52.09,Default,,0,0,0,,Жоқ, жақсы.
Dialogue: 0,0:06:52.09,0:06:55.09,Default,,0,0,0,,Кокоро-чанға қолдау көрсеткеніңіз үшін рахмет
Dialogue: 0,0:06:55.09,0:06:57.09,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:06:59.10,0:07:01.77,Default,,0,0,0,,Иә, бұл сәтті зат.
Dialogue: 0,0:07:01.77,0:07:04.77,Default,,0,0,0,,Уау, Lucky-chan бар сәйкеслента!
Dialogue: 0,0:07:04.77,0:07:06.76,Default,,0,0,0,,Енді сәйкес келеді
Dialogue: 0,0:07:06.76,0:07:10.18,Default,,0,0,0,,Күндердің күнінде сіз өзіңізге ұнайтын түсті лента табасыз деп үміттенемін.
Dialogue: 0,0:07:10.18,0:07:13.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:13.11,0:07:15.75,Default,,0,0,0,,үшінмыз сахнаға шығамыз ба?
Dialogue: 0,0:07:15.75,0:07:18.58,Default,,0,0,0,,Хехе, бұл арман сияқты!
Dialogue: 0,0:07:18.58,0:07:21.75,Default,,0,0,0,,Мен шынымен...
Dialogue: 0,0:07:21.75,0:07:25.17,Default,,0,0,0,,Ашық па?
Dialogue: 0,0:07:25.17,0:07:27.78,Default,,0,0,0,,Ой! Қайтадан қош келдіңіз
Dialogue: 0,0:07:27.78,0:07:31.80,Default,,0,0,0,,Үлкен әпке!? Ой! Аа, ауырады~
Dialogue: 0,0:07:31.80,0:07:35.42,Default,,0,0,0,,Әй, әпке! Осы уақытқа дейін қайда болдың?
Dialogue: 0,0:07:35.42,0:07:37.75,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:07:37.75,0:07:39.79,Default,,0,0,0,,Мен тыныш отыра алмаймын!
Dialogue: 0,0:07:39.79,0:07:41.79,Default,,0,0,0,,Неліктен осы уақытқа дейін қайтып келмедің?
Dialogue: 0,0:07:41.79,0:07:45.21,Default,,0,0,0,,Мен мұнда және мұнда тексергім келетін көптеген нәрселер бар.
Dialogue: 0,0:07:45.21,0:07:49.11,Default,,0,0,0,,Деректер жинап, оны қарастырумен айналыстым.
Dialogue: 0,0:07:49.11,0:07:52.47,Default,,0,0,0,,Бірақ эксперимент аяқталуға жақын.
Dialogue: 0,0:07:52.47,0:07:56.52,Default,,0,0,0,,Біртұтас болған Айқас әлемін бұрынғы қалпына қайтаруға ниеттімін.
Dialogue: 0,0:07:56.52,0:07:59.46,Default,,0,0,0,,Не? Дәл қазір бұл тек сынақ кезеңі.
Dialogue: 0,0:07:59.46,0:08:02.44,Default,,0,0,0,,Жүйеге артық салмақ түсіруге болмайды.
Dialogue: 0,0:08:02.44,0:08:04.85,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:08:04.85,0:08:09.10,Default,,0,0,0,,Менің бұл тәжірибені бастау себебім Икатсу әлемін дамыту болды.
Dialogue: 0,0:08:09.10,0:08:11.12,Default,,0,0,0,,Мурата мырза!
Dialogue: 0,0:08:11.12,0:08:15.11,Default,,0,0,0,,Сәтті көйлек тігудегі арманыңыз
Dialogue: 0,0:08:15.11,0:08:18.46,Default,,0,0,0,,Себебі мен сені қолдағым келді. Е!?
Dialogue: 0,0:08:18.46,0:08:22.45,Default,,0,0,0,,Жолың болса, бұл жай ғана сәттілік емес, бұл позитивті ақылдың күші.
Dialogue: 0,0:08:22.45,0:08:26.14,Default,,0,0,0,,Мен кез келген нәрсені жеңе алатыныма сендім.
Dialogue: 0,0:08:26.14,0:08:30.79,Default,,0,0,0,,Сіз тамаша жұмыс жасадыңыз.
Dialogue: 0,0:08:30.79,0:08:33.16,Default,,0,0,0,,Менің жолым болды
Dialogue: 0,0:08:33.16,0:08:35.78,Default,,0,0,0,,Бұдан былай алған сәулемді осында пайдаланамын.
Dialogue: 0,0:08:35.78,0:08:37.78,Default,,0,0,0,,Мен сенің болашаққа қосылуыңды қалаймын
Dialogue: 0,0:08:37.78,0:08:40.45,Default,,0,0,0,,Лаки мұны істей алуы керек.
Dialogue: 0,0:08:40.45,0:08:44.12,Default,,0,0,0,,Келесі кезең - барлығымен кездесудің соңғы мүмкіндігі.
Dialogue: 0,0:08:44.12,0:08:46.72,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:08:48.77,0:08:51.44,Default,,0,0,0,,Соңғы…
Dialogue: 0,0:08:51.44,0:08:55.11,Default,,0,0,0,,Түсіндім, қоштасатын кез келді...
Dialogue: 0,0:08:55.11,0:08:57.13,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:08:57.13,0:08:59.49,Default,,0,0,0,,Біз барлық пұттарды айтамыз.
Dialogue: 0,0:08:59.49,0:09:02.64,Default,,0,0,0,,Иә. Психикалық тұрғыдан дайындалу керек.
Dialogue: 0,0:09:02.64,0:09:04.97,Default,,0,0,0,,Бұл түс сияқты болды.
Dialogue: 0,0:09:04.97,0:09:09.44,Default,,0,0,0,,Көптеген сүйкімді пұттармен танысу қызықты болды.
Dialogue: 0,0:09:09.44,0:09:13.78,Default,,0,0,0,,Тәжірибенің ортасынан бастап ынтымақтастығыңыз үшін барлығыңызға рахмет.
Dialogue: 0,0:09:13.78,0:09:16.44,Default,,0,0,0,,Осы уақытқа дейін еш қиналмай келдім.
Dialogue: 0,0:09:16.44,0:09:19.77,Default,,0,0,0,,Рахмет. (Эльза) Сонымен?
Dialogue: 0,0:09:19.77,0:09:23.44,Default,,0,0,0,,Осындай нәрсені істегеннен кейін мен мұндай болады деп күткен жоқпын...
Dialogue: 0,0:09:23.44,0:09:27.11,Default,,0,0,0,,Бұл болмайды, солай ма?
Dialogue: 0,0:09:27.11,0:09:30.78,Default,,0,0,0,,Жаңа нәрселерді байқамайынша, алға жылжу болмайды.
Dialogue: 0,0:09:30.78,0:09:33.79,Default,,0,0,0,,Осы уақытқа дейін біз жүйені жаңарттық.
Dialogue: 0,0:09:33.79,0:09:37.46,Default,,0,0,0,,Соның салдарынан кейде оғаш оқиғалар болды.
Dialogue: 0,0:09:37.46,0:09:41.13,Default,,0,0,0,,Инженерлер жанкүйерлер мен қызметкерлер сияқты.
Dialogue: 0,0:09:41.13,0:09:44.80,Default,,0,0,0,,Мен пұттардың өсуіне қолдау көрсеткім келеді.
Dialogue: 0,0:09:44.80,0:09:49.80,Default,,0,0,0,,Мен жаңа нәрселерге ұмтылуды жалғастырамын.
Dialogue: 0,0:09:53.46,0:09:56.12,Default,,0,0,0,,Икатсу әлемінің болашағы туралы не ойлайсыз?
Dialogue: 0,0:09:56.12,0:09:58.12,Default,,0,0,0,,Дәл солай.
Dialogue: 0,0:10:04.55,0:10:06.47,Default,,0,0,0,,Келесі жолы Хошимия және т.б
Dialogue: 0,0:10:06.47,0:10:09.47,Default,,0,0,0,,Мен оның Раки Чанмен бірге сахнаға шығатынын естідім.
Dialogue: 0,0:10:09.47,0:10:14.17,Default,,0,0,0,,Толыққанды жандандырып, ұмытылмас күн болсын
Dialogue: 0,0:12:02.43,0:12:04.79,Default,,0,0,0,,Кіру үшін осы жерді басыңыз!
Dialogue: 0,0:12:04.79,0:12:07.79,Default,,0,0,0,,Спектакль басталуына бір сағат қалғанда!
Dialogue: 0,0:12:12.09,0:12:14.11,Default,,0,0,0,,Көптеген пұттар!
Dialogue: 0,0:12:14.11,0:12:16.10,Default,,0,0,0,,Мизуки және басқалардың шақыруы бойынша
Dialogue: 0,0:12:16.10,0:12:19.08,Default,,0,0,0,,Көп пұттар жиналды деп естідім.
Dialogue: 0,0:12:19.08,0:12:24.11,Default,,0,0,0,,Осыншама пұттардың бір жерде болуы ғажап!
Dialogue: 0,0:12:24.11,0:12:26.46,Default,,0,0,0,,үшін маған қарап тұр.
Dialogue: 0,0:12:26.46,0:12:29.46,Default,,0,0,0,,Оны міндетті түрде жақсы сахнаға айналдырайық! иә!
Dialogue: 0,0:12:31.85,0:12:33.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:33.88,0:12:36.79,Default,,0,0,0,,Кокоро-чан! Ах!
Dialogue: 0,0:12:36.79,0:12:38.79,Default,,0,0,0,,Бақытты-чан!
Dialogue: 0,0:12:38.79,0:12:42.16,Default,,0,0,0,,Өткен күні Кокоро саған қамқор болған сияқты.
Dialogue: 0,0:12:42.16,0:12:44.19,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:12:44.19,0:12:48.46,Default,,0,0,0,,Бұл қыз лентаны алғаннан кейін пұт болғысы келетінін айта бастады.
Dialogue: 0,0:12:48.46,0:12:51.85,Default,,0,0,0,,Солай ма!? Мен көбірек күле бастадым.
Dialogue: 0,0:12:51.85,0:12:55.45,Default,,0,0,0,,Жарқырап, ән айту, би билеу, сабақ оқу, спортпен шұғылдану.
Dialogue: 0,0:12:55.45,0:12:58.12,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасауға бел будым.
Dialogue: 0,0:12:58.12,0:13:00.49,Default,,0,0,0,,үшін өте керемет!
Dialogue: 0,0:13:00.49,0:13:03.80,Default,,0,0,0,,Пұттардың күші зор, солай ма?
Dialogue: 0,0:13:03.80,0:13:07.77,Default,,0,0,0,,Біз бірге жанкүйер болдық! Уууу
Dialogue: 0,0:13:07.77,0:13:09.79,Default,,0,0,0,,Уау, мен өте қуаныштымын!
Dialogue: 0,0:13:09.79,0:13:13.44,Default,,0,0,0,,Мен әрқашан жанкүйерлерді қолдаймын.
Dialogue: 0,0:13:13.44,0:13:17.13,Default,,0,0,0,,Мен көп қуат аламын! рақмет сізге!
Dialogue: 0,0:13:17.13,0:13:20.46,Default,,0,0,0,,Кезең Мен оны асыға күтемін!! Хаха!
Dialogue: 0,0:13:20.46,0:13:23.27,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз!
Dialogue: 0,0:13:23.27,0:13:26.27,Default,,0,0,0,,Шындық осында!
Dialogue: 0,0:13:26.27,0:13:29.15,Default,,0,0,0,,Иә! иә! иә! Дұрыс!
Dialogue: 0,0:13:29.15,0:13:32.22,Default,,0,0,0,,Осы кезеңге дейін...
Dialogue: 0,0:13:32.22,0:13:35.43,Default,,0,0,0,,Бүгінге дейін, менің ағаларымнан
Dialogue: 0,0:13:35.43,0:13:37.83,Default,,0,0,0,,Мен көп нәрсені алдым...
Dialogue: 0,0:13:37.83,0:13:40.12,Default,,0,0,0,,Ол маған үнемі сабақ берді.
Dialogue: 0,0:13:40.12,0:13:42.78,Default,,0,0,0,,Ол маған көйлек туралы айтты...
Dialogue: 0,0:13:42.78,0:13:46.79,Default,,0,0,0,,Сізге көп рахмет!
Dialogue: 0,0:13:46.79,0:13:49.79,Default,,0,0,0,,Жарайды, ештеңе емес.
Dialogue: 0,0:13:49.79,0:13:53.45,Default,,0,0,0,,Біз де көп нәрсе алдық.
Dialogue: 0,0:13:53.45,0:13:56.80,Default,,0,0,0,,Армандар мен аңсаулар
Dialogue: 0,0:13:56.80,0:14:00.20,Default,,0,0,0,,Көптеген маңызды нәрселер
Dialogue: 0,0:14:04.12,0:14:08.79,Default,,0,0,0,,Ах! Үлкендеріңізбен көбірек көңіл көтеріңіз
Dialogue: 0,0:14:08.79,0:14:13.18,Default,,0,0,0,,Мен көп адамдарды күлдіргім келді!
Dialogue: 0,0:14:13.18,0:14:16.79,Default,,0,0,0,,Біз әрқашан Раки-чанның қасында боламыз.
Dialogue: 0,0:14:16.79,0:14:20.12,Default,,0,0,0,,Иә, жақсы! Сіз жалғыз емессіз
Dialogue: 0,0:14:20.12,0:14:24.76,Default,,0,0,0,,Көре алмасақ та, Аспанда жарқыраған жұлдыздармыз.
Dialogue: 0,0:14:24.76,0:14:26.78,Default,,0,0,0,,Сәлем, Акари-чан
Dialogue: 0,0:14:26.78,0:14:30.78,Default,,0,0,0,,Дұрыс, біздің махаббатымыз жалғасады.
Dialogue: 0,0:14:30.78,0:14:33.77,Default,,0,0,0,,Арман - бұл сіз көрген нәрсе емес, сіз орындайтын нәрсе.
Dialogue: 0,0:14:33.77,0:14:36.79,Default,,0,0,0,,Дұрыс, Юме-чан! Ой
Dialogue: 0,0:14:36.79,0:14:38.81,Default,,0,0,0,,Уәде берейік
Dialogue: 0,0:14:38.81,0:14:44.21,Default,,0,0,0,,Бір-бірімізден бөлек болсақ та, бір жарықта жүреміз.
Dialogue: 0,0:14:46.78,0:14:49.45,Default,,0,0,0,,Мен шынымен бақыттымын!
Dialogue: 0,0:14:49.45,0:14:55.11,Default,,0,0,0,,Өйткені мен осындай тамаша қарттарды кездестіре алдым!
Dialogue: 0,0:14:55.11,0:14:57.78,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:57.78,0:15:01.11,Default,,0,0,0,,Алдымен, қазіргі жағдайды ескерсек—
Dialogue: 0,0:15:01.11,0:15:04.45,Default,,0,0,0,,Таспа!? Уау, сондай сүйкімді!
Dialogue: 0,0:15:04.45,0:15:07.82,Default,,0,0,0,,Бұл уәденің белгісі. Рахмет сізге.
Dialogue: 0,0:15:07.82,0:15:11.44,Default,,0,0,0,,《үшін мен
Dialogue: 0,0:15:11.44,0:15:13.78,Default,,0,0,0,,Алған біліміңді бағала
Dialogue: 0,0:15:13.78,0:15:19.43,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:15:19.43,0:15:23.10,Default,,0,0,0,,Бір күні тағы да...
Dialogue: 0,0:15:23.10,0:15:27.77,Default,,0,0,0,,Мүлдем! Мен міндетті түрде кездесемін деп үміттенемін! 》
Dialogue: 0,0:15:27.77,0:15:59.42,Default,,0,0,0,,...
Dialogue: 0,0:15:59.42,0:16:09.11,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:16:09.11,0:16:12.77,Default,,0,0,0,,«Енді бізді байланыстырады»
Dialogue: 0,0:16:12.77,0:16:19.26,Default,,0,0,0,,«Кеудедегі жарқыраған сызық»
Dialogue: 0,0:16:19.26,0:16:31.77,Default,,0,0,0,,...
Dialogue: 0,0:16:31.77,0:16:34.14,Default,,0,0,0,,«Маған тыңдауға рұқсат етіңіз».
Dialogue: 0,0:16:34.14,0:16:38.43,Default,,0,0,0,,«Бұл кімнің әңгімесі?»
Dialogue: 0,0:16:38.43,0:16:40.48,Default,,0,0,0,,«Табылды»
Dialogue: 0,0:16:40.48,0:16:44.87,Default,,0,0,0,,«Бұл менің әңгімем»
Dialogue: 0,0:16:44.87,0:16:47.10,Default,,0,0,0,,«Мен білгім келеді»
Dialogue: 0,0:16:47.10,0:16:51.11,Default,,0,0,0,,«Қалайсың?»
Dialogue: 0,0:16:51.11,0:16:57.78,Default,,0,0,0,,"Сену арманымен жүрдің ғой, солай ма?"
Dialogue: 0,0:16:57.78,0:17:00.77,Default,,0,0,0,,«Көз жасыңызға қолшатыр қойыңыз»
Dialogue: 0,0:17:00.77,0:17:04.09,Default,,0,0,0,,«Күлкі – шынайы».
Dialogue: 0,0:17:04.09,0:17:12.53,Default,,0,0,0,,«Ұмтылу әрқашан бірінші бағдар болып табылады».
Dialogue: 0,0:17:12.53,0:17:15.76,Default,,0,0,0,,«Қазір біздің аспанымызда»
Dialogue: 0,0:17:15.76,0:17:18.78,Default,,0,0,0,,«Мен оны тапсырамын деп үміттенемін».
Dialogue: 0,0:17:18.78,0:17:22.10,Default,,0,0,0,,«Мен алған батылдықпен көбірек»
Dialogue: 0,0:17:22.10,0:17:25.76,Default,,0,0,0,,«Бұл болашаққа дейін баруы мүмкін сияқты».
Dialogue: 0,0:17:25.76,0:17:27.76,Default,,0,0,0,,«Таяқша алды»
Dialogue: 0,0:17:27.76,0:17:31.76,Default,,0,0,0,,«Сізді байланыстыратын жарық сызығы»
Dialogue: 0,0:17:31.76,0:17:36.45,Default,,0,0,0,,«Мені бақытты ет»
Dialogue: 0,0:17:36.45,0:17:52.08,Default,,0,0,0,,...
Dialogue: 0,0:17:52.08,0:18:00.11,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:18:00.11,0:18:03.66,Default,,0,0,0,,Сіз жылап жатырсыз ба? Иә
Dialogue: 0,0:18:03.66,0:18:07.43,Default,,0,0,0,,Мен қатты әсер еттім, өйткені бәрі жарқырап тұрды.
Dialogue: 0,0:18:07.43,0:18:10.77,Default,,0,0,0,,Раки-чан да пұтқа көбірек ұқсайды.
Dialogue: 0,0:18:10.77,0:18:16.44,Default,,0,0,0,,Жас жеткіншектеріміздің өсіп-өркендеуін көріп, алдымызға келгендерге мақтаныш сезімін ұялатады.
Dialogue: 0,0:18:16.44,0:18:19.43,Default,,0,0,0,,үшінна жол көрсетуші болу
Dialogue: 0,0:18:19.43,0:18:22.10,Default,,0,0,0,,Біз де жүре беруіміз керек
Dialogue: 0,0:18:22.10,0:18:25.42,Default,,0,0,0,,Иә. Жаңа жарық үшін де.
Dialogue: 0,0:18:25.42,0:18:28.77,Default,,0,0,0,,Таңдану тағы бір аңсар туады.
Dialogue: 0,0:18:28.77,0:18:31.12,Default,,0,0,0,,Таяқшаларды байланыстырайық
Dialogue: 0,0:18:31.12,0:18:34.72,Default,,0,0,0,,Ikats әлемінің жарқын болашағы үшін
Dialogue: 0,0:18:59.83,0:19:02.12,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:19:02.12,0:19:05.09,Default,,0,0,0,,Біз өткен бірінші орын
Dialogue: 0,0:19:05.09,0:19:07.78,Default,,0,0,0,,Бұл есік төрт жұлдызды академия
Dialogue: 0,0:19:07.78,0:19:11.43,Default,,0,0,0,,Ол Starlight академиясына қосылған.
Dialogue: 0,0:19:11.43,0:19:18.09,Default,,0,0,0,,Түсіндім... сен шынымен қайтып бара жатырсың. Иә.
Dialogue: 0,0:19:18.09,0:19:20.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:20.11,0:19:24.09,Default,,0,0,0,,Осындай кезде күлейік! Фуфуфуфу!
Dialogue: 0,0:19:24.09,0:19:26.09,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:26.09,0:19:29.41,Default,,0,0,0,,ｷｬﾊｰ！
Dialogue: 0,0:19:29.41,0:19:38.84,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:19:38.84,0:20:00.15,Default,,0,0,0,,...
Dialogue: 0,0:20:00.15,0:20:02.15,Default,,0,0,0,,Әй, сәлем айт
Dialogue: 0,0:20:04.77,0:20:07.77,Default,,0,0,0,,Жақында кездескенше! Сау бол!
Dialogue: 0,0:20:10.79,0:20:14.19,Default,,0,0,0,,Біз де барайық. Иә.
Dialogue: 0,0:20:41.12,0:20:44.14,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:20:44.14,0:20:46.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:46.12,0:20:49.72,Default,,0,0,0,,(Құстар әні)
Dialogue: 0,0:20:59.45,0:21:03.46,Default,,0,0,0,,Қайырлы таң, апа! Не?
Dialogue: 0,0:21:03.46,0:21:05.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:07.45,0:21:10.11,Default,,0,0,0,,《Әйтеуір...》
Dialogue: 0,0:21:10.11,0:21:12.12,Default,,0,0,0,,Боу?
Dialogue: 0,0:21:12.12,0:21:15.52,Default,,0,0,0,,《Ұзақ түс көргендей болдым...》
Dialogue: 0,0:21:15.52,0:21:21.11,Default,,0,0,0,,Қайырлы таң Химейши-сан. Ах, қайырлы таң.
Dialogue: 0,0:21:21.11,0:21:24.45,Default,,0,0,0,,Амансың ба? Не болды? иә?
Dialogue: 0,0:21:24.45,0:21:26.83,Default,,0,0,0,,Жоқ, әйтеуір
Dialogue: 0,0:21:26.83,0:21:29.43,Default,,0,0,0,,Мен маңызды нәрсені ұмытып кеткен сияқтымын.
Dialogue: 0,0:21:29.43,0:21:31.45,Default,,0,0,0,,Мен өзімді біртүрлі сезінемін...
Dialogue: 0,0:21:31.45,0:21:33.79,Default,,0,0,0,,Кішкене шаршаған жоқсың ба?
Dialogue: 0,0:21:33.79,0:21:35.76,Default,,0,0,0,,Өйткені мен мектептерді жаңа ғана ауыстырдым.
Dialogue: 0,0:21:35.76,0:21:38.23,Default,,0,0,0,,Сабақты жалғастыру қиын болуы керек.
Dialogue: 0,0:21:38.23,0:21:41.46,Default,,0,0,0,,Сіз жаңа ғана ауыстырдыңыз ба?
Dialogue: 0,0:21:41.46,0:21:44.13,Default,,0,0,0,,Уау! Бірінші күннен бастап көйлек туралы болды.
Dialogue: 0,0:21:44.13,0:21:47.49,Default,,0,0,0,,Эйн мен Мионың қасында қалған батылдық қайдан шықты?
Dialogue: 0,0:21:47.49,0:21:49.79,Default,,0,0,0,,Көңілдеріңіз көтеріңкі!
Dialogue: 0,0:21:49.79,0:21:51.79,Default,,0,0,0,,ﾄﾞﾚｽ…
Dialogue: 0,0:21:53.78,0:21:56.44,Default,,0,0,0,,《Мен бір нәрсені ұмытып қалдым.
Dialogue: 0,0:21:56.44,0:21:59.13,Default,,0,0,0,,Мен сенімдімін...
Dialogue: 0,0:21:59.13,0:22:02.13,Default,,0,0,0,,Маңызды нәрсе жасаңыз! 》
Dialogue: 0,0:22:04.75,0:22:07.11,Default,,0,0,0,,《Бұл арман емес...
Dialogue: 0,0:22:07.11,0:22:10.76,Default,,0,0,0,,Бұл түс сияқты болды, бірақ ол шынайы болды.
Dialogue: 0,0:22:10.76,0:22:13.76,Default,,0,0,0,,үшінмен өткізілетін уақыт
Dialogue: 0,0:22:13.76,0:22:17.75,Default,,0,0,0,,Мен тапсырған ерлікті, сағынышты, үмітті ешқашан ұмытпаймын.
Dialogue: 0,0:22:17.75,0:22:20.10,Default,,0,0,0,,Мен көп нәрсе алдым.
Dialogue: 0,0:22:20.10,0:22:22.77,Default,,0,0,0,,Мен ол күннен өзгешемін
Dialogue: 0,0:22:22.77,0:22:26.12,Default,,0,0,0,,Алған батылдықты күшке айналдыр
Dialogue: 0,0:22:26.12,0:22:29.72,Default,,0,0,0,,Бұл жаңа бастапқы сызық! 》
Dialogue: 0,0:22:32.70,0:22:35.78,Default,,0,0,0,,Біз жарқын болашаққа баруымыз керек!
Dialogue: 0,0:22:37.82,0:22:41.12,Default,,0,0,0,,Уау!? Не?
Dialogue: 0,0:22:41.12,0:22:44.78,Default,,0,0,0,,Вакаба Харуказенің достары! Тыңдау!?
Dialogue: 0,0:22:44.78,0:22:48.78,Default,,0,0,0,,Иә! Мен шынымен сүйкімдімін!
Dialogue: 0,0:22:48.78,0:22:51.18,Default,,0,0,0,,ﾗｯｷｰ!!
Dialogue: 0,0:22:53.45,0:23:00.11,Default,,0,0,0,,Жазба нөмірі 777 - Раки Химейши! рақмет сізге!
Dialogue: 0,0:23:00.11,0:23:02.11,Default,,0,0,0,,Олай болса, алдымен
Dialogue: 0,0:23:02.11,0:23:04.11,Default,,0,0,0,,Маған армандарыңызды айта аласыз ба?
Dialogue: 0,0:23:04.11,0:23:06.13,Default,,0,0,0,,Иә!
Dialogue: 0,0:23:06.13,0:23:09.43,Default,,0,0,0,,Мен әрқашан өз премиум мекенжайымды жасағым келді.
Dialogue: 0,0:23:09.43,0:23:11.45,Default,,0,0,0,,Мен ойладым
Dialogue: 0,0:23:11.45,0:23:14.44,Default,,0,0,0,,Бірақ қазір менде жаңа арман бар.
Dialogue: 0,0:23:14.44,0:23:16.46,Default,,0,0,0,,Жаңа арман?
Dialogue: 0,0:23:16.46,0:23:20.13,Default,,0,0,0,,Бір күні мен жарқыраған Айкацу асуын пайдалансам
Dialogue: 0,0:23:20.13,0:23:24.57,Default,,0,0,0,,Мен білмейтін көптеген пұттарды кездестірдім.
Dialogue: 0,0:23:24.57,0:23:28.45,Default,,0,0,0,,Бір-біріңді жоғары көтеріп, бірге жарқыра
Dialogue: 0,0:23:28.45,0:23:30.46,Default,,0,0,0,,Біздің жүрегіміз бір болады
Dialogue: 0,0:23:30.46,0:23:33.94,Default,,0,0,0,,Жаңа кальмардың барлық түрін жасауға болады.
Dialogue: 0,0:23:33.94,0:23:37.45,Default,,0,0,0,,Және де болашақ пұттарға.
Dialogue: 0,0:23:37.45,0:23:40.77,Default,,0,0,0,,Барған сайын жаңа кальмарлар
Dialogue: 0,0:23:40.77,0:23:43.77,Default,,0,0,0,,Барған сайын таралуда
Dialogue: 0,0:23:43.77,0:23:46.17,Default,,0,0,0,,Лента байлау сияқты
Dialogue: 0,0:23:46.17,0:23:49.77,Default,,0,0,0,,Мен жарқырауды байланыстырғым келеді.
Dialogue: 0,0:23:49.77,0:24:53.77,Default,,0,0,0,,...
Dialogue: 0,0:24:53.77,0:24:57.47,Default,,0,0,0,,Кездескенше, Раки-чан!
Dialogue: 0,0:25:02.08,0:25:04.10,Default,,0,0,0,,үшінна!
Dialogue: 0,0:25:04.10,0:25:08.10,Default,,0,0,0,,ｱｲｶｰﾂ!!
Dialogue: 0,0:27:45.43,0:27:48.10,Default,,0,0,0,,үшін үшін рахмет, Ичиго-чан
Dialogue: 0,0:27:48.10,0:27:50.45,Default,,0,0,0,,Бұл қоштасу емес, Раки-чан!
Dialogue: 0,0:27:50.45,0:27:52.47,Default,,0,0,0,,Уау! Мен келісемін!
Dialogue: 0,0:27:52.47,0:27:54.77,Default,,0,0,0,,Біз тағы кездесетінімізге сенімдімін!
Dialogue: 0,0:27:57.77,0:28:00.44,Default,,0,0,0,,Дориакадағы арнайы шығарылым веб-анимация жинағы
Dialogue: 0,0:28:00.44,0:28:03.29,Default,,0,0,0,,Осыдан кейін сағат 11.00-де басталады.
Dialogue: 0,0:28:03.29,0:28:05.85,Default,,0,0,0,,Күзде, ``Икатсу!'' ” телехикаясы
Dialogue: 0,0:28:05.85,0:28:08.38,Default,,0,0,0,,Жаңа жоба да басталып жатыр.
Dialogue: 0,0:28:08.38,0:28:11.28,Default,,0,0,0,,Қосымша ақпарат алу үшін бағдарламаның басты бетін қараңыз.
Dialogue: 0,0:28:12.78,0:28:18.78,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
