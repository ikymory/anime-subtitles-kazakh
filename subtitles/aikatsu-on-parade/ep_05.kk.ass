Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.73,0:00:35.73,Default,,0,0,0,,Бәріміз ән айтайық...
Dialogue: 0,0:00:35.73,0:00:37.73,Default,,0,0,0,,Би билейік. Кумирлер де...
Dialogue: 0,0:00:37.73,0:00:40.14,Default,,0,0,0,,Көйлектер де... Үлкен жиын!
Dialogue: 0,0:00:40.14,0:00:45.73,Default,,0,0,0,,«Икатсу On Parade» басталғалы жатыр! Ой
Dialogue: 0,0:00:45.73,0:00:48.78,Default,,0,0,0,,<Чао! Мен Раки Химейши
Dialogue: 0,0:00:48.78,0:00:51.85,Default,,0,0,0,,«Star Harmony» академиясының орта мектебінің 2 курс студенті
Dialogue: 0,0:00:51.85,0:00:56.74,Default,,0,0,0,,Менің арманым – бір күні өзім құрастырған премиум көйлекті кию.
Dialogue: 0,0:00:56.74,0:01:00.74,Default,,0,0,0,,Мектептерді ауыстырған соң, мен әпкем берген Айкацу асуын қолдандым.
Dialogue: 0,0:01:00.74,0:01:03.16,Default,,0,0,0,,Жұмбақ есік пайда болады...
Dialogue: 0,0:01:03.16,0:01:05.18,Default,,0,0,0,,Мен білмейтін жерлерге бара аламын.
Dialogue: 0,0:01:05.18,0:01:07.40,Default,,0,0,0,,Мен көптеген пұттармен кездестім
Dialogue: 0,0:01:07.40,0:01:09.73,Default,,0,0,0,,Мен шынымен бақыттымын!
Dialogue: 0,0:01:09.73,0:01:12.42,Default,,0,0,0,,Бірақ бұл неліктен болып жатыр?
Dialogue: 0,0:01:12.42,0:01:16.09,Default,,0,0,0,,Сіздің әпкеңіз бірдеңе білетін сияқты.
Dialogue: 0,0:01:16.09,0:01:18.74,Default,,0,0,0,,Айкацу инженерінің үлкен әпкесін іздеу кезінде
Dialogue: 0,0:01:18.74,0:01:21.74,Default,,0,0,0,,Бүгін де барымызды салайық! ＞
Dialogue: 0,0:01:32.74,0:01:35.41,Default,,0,0,0,,ﾊｯﾋﾟｰﾊﾛｳｨﾝ！
Dialogue: 0,0:01:35.41,0:01:37.39,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:01:37.39,0:01:40.71,Default,,0,0,0,,Сәлеметсіз бе, бұл Акари Озора.
Dialogue: 0,0:01:40.71,0:01:43.07,Default,,0,0,0,,Мұздағы күлгін гүлдер
Dialogue: 0,0:01:43.07,0:01:45.23,Default,,0,0,0,,Бұл Хинаки Синдзо.
Dialogue: 0,0:01:45.23,0:01:47.72,Default,,0,0,0,,Жарық
Dialogue: 0,0:01:47.72,0:01:49.76,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:01:49.76,0:01:53.41,Default,,0,0,0,,Бүгін сіз Starlight академиясының Хэллоуин кешіне келдіңіз.
Dialogue: 0,0:01:53.41,0:01:55.41,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:01:55.41,0:01:57.58,Default,,0,0,0,,үшінна ләззат алу үшін
Dialogue: 0,0:01:57.58,0:02:00.73,Default,,0,0,0,,Бұл әр түрлі талғамға толы кеш.
Dialogue: 0,0:02:00.73,0:02:04.10,Default,,0,0,0,,Пұт сахналары, киім сайыстары және т.б.
Dialogue: 0,0:02:04.10,0:02:06.24,Default,,0,0,0,,Бұл өте көп!
Dialogue: 0,0:02:06.24,0:02:08.26,Default,,0,0,0,,ｷｬﾊｯ ﾗｯｷｰ！
Dialogue: 0,0:02:08.26,0:02:11.76,Default,,0,0,0,,Жұлдыздың жарығы Хэллоуин Оны барынша ләззат алайық!
Dialogue: 0,0:04:58.76,0:05:02.36,Default,,0,0,0,,Бірінші кезеңді біз Luminus-те жеткіземіз.
Dialogue: 0,0:05:04.72,0:05:09.41,Default,,0,0,0,,Жарқыраған нәрсе...
Dialogue: 0,0:05:09.41,0:05:12.41,Default,,0,0,0,,Жарқыраған! (қуаныш)
Dialogue: 0,0:05:12.41,0:05:18.40,Default,,0,0,0,,"ҚЫЗЫҚ! КӨҢІЛ! КӨҢІЛДІ! Ұлдар мен Қыздар! Келіңдер, бәріміз."
Dialogue: 0,0:05:18.40,0:05:20.40,Default,,0,0,0,,｢POP！POP！POP！ соққыңызды шайқаңыз！｣
Dialogue: 0,0:05:20.40,0:05:24.74,Default,,0,0,0,,«Кеш уақыты басталғалы жатыр!»
Dialogue: 0,0:05:24.74,0:05:33.41,Default,,0,0,0,,...
Dialogue: 0,0:05:33.41,0:05:37.07,Default,,0,0,0,,«Қолға қарай»
Dialogue: 0,0:05:37.07,0:05:42.47,Default,,0,0,0,,«Қозғалса, мына саусақты тоқтат».
Dialogue: 0,0:05:42.47,0:05:45.76,Default,,0,0,0,,«Мен сені күттім».
Dialogue: 0,0:05:45.76,0:05:51.15,Default,,0,0,0,,«Сізді арнайы уақытқа шақыруға рұқсат етіңіз».
Dialogue: 0,0:05:51.15,0:05:55.08,Default,,0,0,0,,«Күлкіден күлкі»
Dialogue: 0,0:05:55.08,0:05:59.74,Default,,0,0,0,,«Лалала МАХАББАТ туды».
Dialogue: 0,0:05:59.74,0:06:07.41,Default,,0,0,0,,«Сүйікті жеріңді көрсет!»
Dialogue: 0,0:06:07.41,0:06:11.80,Default,,0,0,0,,«Біз кездескен қала – біздің сахна»
Dialogue: 0,0:06:11.80,0:06:16.07,Default,,0,0,0,,«Жарқыраған армандар және ынтымақтастық»
Dialogue: 0,0:06:16.07,0:06:21.48,Default,,0,0,0,,«Бүгін өзіңе лента тақ».
Dialogue: 0,0:06:21.48,0:06:25.75,Default,,0,0,0,,«Қазынаға айналдырайық»
Dialogue: 0,0:06:25.75,0:06:30.40,Default,,0,0,0,,"ҚЫЗЫҚ! КӨҢІЛДІ! КӨҢІЛДІ! Ұлдар мен қыздар! Бірге ән айтайық."
Dialogue: 0,0:06:30.40,0:06:32.42,Default,,0,0,0,,｢POP！POP！POP！ Битіңізді шайқаңыз！｣
Dialogue: 0,0:06:32.42,0:06:35.82,Default,,0,0,0,,«Ерекше естеліктер»
Dialogue: 0,0:06:35.82,0:06:41.10,Default,,0,0,0,,«Кими және коллекция»
Dialogue: 0,0:06:41.10,0:06:46.80,Default,,0,0,0,,｢ﾗﾗﾗﾗﾗ…｣
Dialogue: 0,0:06:50.07,0:06:55.37,Default,,0,0,0,,｢ﾗﾗﾗﾗﾗ…｣
Dialogue: 0,0:06:57.41,0:07:00.07,Default,,0,0,0,,｢ｺﾚｸｼｮﾝ｣
Dialogue: 0,0:07:00.07,0:07:02.77,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:07:10.73,0:07:14.73,Default,,0,0,0,,Маған «Luminous» сахнасы қатты әсер етті.
Dialogue: 0,0:07:14.73,0:07:17.73,Default,,0,0,0,,Иә, бөлімнің аты сияқты, ол шынымен де жарқырап тұрды.
Dialogue: 0,0:07:17.73,0:07:19.74,Default,,0,0,0,,Оны достарыңнан сездің.
Dialogue: 0,0:07:19.74,0:07:21.72,Default,,0,0,0,,ﾊｯﾋﾟｰﾊﾛｳｨﾝ
Dialogue: 0,0:07:21.72,0:07:24.06,Default,,0,0,0,,Иә? Сізге көп рахмет...
Dialogue: 0,0:07:24.06,0:07:26.08,Default,,0,0,0,,Ах! Мирай-сан!
Dialogue: 0,0:07:26.08,0:07:29.43,Default,,0,0,0,,Yahoo! (Карен) Сондай-ақ өтінемін
Dialogue: 0,0:07:29.43,0:07:31.45,Default,,0,0,0,,ﾊｯﾋﾟｰﾊﾛｳｨﾝ
Dialogue: 0,0:07:31.45,0:07:34.50,Default,,0,0,0,,Құрметті Карен-сан, мұнда неге келдің?
Dialogue: 0,0:07:34.50,0:07:37.07,Default,,0,0,0,,Жарайды, мен оны сұрадым.
Dialogue: 0,0:07:37.07,0:07:40.11,Default,,0,0,0,,Мираи үшін Хэллоуин оқиғасын жасаңыз
Dialogue: 0,0:07:40.11,0:07:42.16,Default,,0,0,0,,ﾌﾟﾛﾃﾞｭｰｽ!?
Dialogue: 0,0:07:42.16,0:07:45.74,Default,,0,0,0,,Бірге жоспарласақ қызық болар еді деп ойлаймын.
Dialogue: 0,0:07:45.74,0:07:48.08,Default,,0,0,0,,Біз бәріміз дос болдық, солай ма?
Dialogue: 0,0:07:48.08,0:07:50.43,Default,,0,0,0,,Иә. Карен-сан және Мираи-сан
Dialogue: 0,0:07:50.43,0:07:53.07,Default,,0,0,0,,Ол біз таңданатын үлкен аға.
Dialogue: 0,0:07:53.07,0:07:57.41,Default,,0,0,0,,Иә? Бірақ Мирай-сан неге Starlight академиясына келді?
Dialogue: 0,0:07:57.41,0:08:01.41,Default,,0,0,0,,Сахнадан кейін мен өзімді танымайтын қалада таптым...
Dialogue: 0,0:08:01.41,0:08:04.81,Default,,0,0,0,,Мен көрікті жерлерді аралап жүргенімде, мен Акари-чанды кездестірдім, солай ма?
Dialogue: 0,0:08:04.81,0:08:07.42,Default,,0,0,0,,Дұрыс. Екеуіңізге де сенімдімін.
Dialogue: 0,0:08:07.42,0:08:09.40,Default,,0,0,0,,Лаки-Чанның жарқыраған қабағы өтуіне байланысты
Dialogue: 0,0:08:09.40,0:08:11.40,Default,,0,0,0,,Мен мұнда келдім
Dialogue: 0,0:08:11.40,0:08:13.46,Default,,0,0,0,,Хинаки-чан Джури-чан сияқты
Dialogue: 0,0:08:13.46,0:08:15.74,Default,,0,0,0,,Не? (2 адам) Бұл ештеңе емес!
Dialogue: 0,0:08:15.74,0:08:18.76,Default,,0,0,0,,Айтпақшы, бәрің неге осындасыңдар?
Dialogue: 0,0:08:18.76,0:08:21.40,Default,,0,0,0,,Біз осы мектептің Хинаки Синджомыз.
Dialogue: 0,0:08:21.40,0:08:23.40,Default,,0,0,0,,Шақыру бойынша
Dialogue: 0,0:08:23.40,0:08:26.07,Default,,0,0,0,,Мен де Акари-чан мен Сумире-чанмен дос болдым.
Dialogue: 0,0:08:26.07,0:08:28.09,Default,,0,0,0,,Жарық ең жақсы болды
Dialogue: 0,0:08:28.09,0:08:32.07,Default,,0,0,0,,Сонымен қатар, мен нағыз махаббат метрін кездестірдім.
Dialogue: 0,0:08:32.07,0:08:34.73,Default,,0,0,0,,Мен бұрылып жатырмын! Ах!
Dialogue: 0,0:08:34.73,0:08:39.73,Default,,0,0,0,,Мен Раки Химейшимін, Star Harmony академиясының екінші курс орта мектебінің оқушысымын.
Dialogue: 0,0:08:39.73,0:08:41.73,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:08:41.73,0:08:44.07,Default,,0,0,0,,Мен жақсымын. Құрметпен.
Dialogue: 0,0:08:44.07,0:08:47.09,Default,,0,0,0,,Мирай-сан, мен аруақты үйді реттедім.
Dialogue: 0,0:08:47.09,0:08:50.08,Default,,0,0,0,,Растаңыз. Уау, ол әлдеқашан болды ма?
Dialogue: 0,0:08:50.08,0:08:54.06,Default,,0,0,0,,Иә. Мен қызметкерлерден оны аздап қорқынышты етуді сұрадым.
Dialogue: 0,0:08:54.06,0:08:56.12,Default,,0,0,0,,Күтілгендей, рахмет
Dialogue: 0,0:08:56.12,0:08:58.73,Default,,0,0,0,,Содан кейін біз жұмысқа қайта ораламыз.
Dialogue: 0,0:08:58.73,0:09:01.74,Default,,0,0,0,,Оқиғадан ләззат алыңыз!
Dialogue: 0,0:09:01.74,0:09:04.41,Default,,0,0,0,,Мирай-сан, қайда жүрсең де белсенді
Dialogue: 0,0:09:04.41,0:09:06.76,Default,,0,0,0,,Акари екеуміз жақсы араласатын сияқтымыз.
Dialogue: 0,0:09:06.76,0:09:08.81,Default,,0,0,0,,Ерекше бірдеңе болып жатыр ма? Кез келген оқиғалар немесе сондай нәрселер болды ма?
Dialogue: 0,0:09:08.81,0:09:11.06,Default,,0,0,0,,Сүміре-сенпай кезеңі басталады
Dialogue: 0,0:09:11.06,0:09:13.07,Default,,0,0,0,,Сіз оны өткізіп жібере алмайсыз
Dialogue: 0,0:09:13.07,0:09:16.09,Default,,0,0,0,,Асығыңыз! Сумире-чанның сахнасы
Dialogue: 0,0:09:16.09,0:09:18.39,Default,,0,0,0,,Оны да барып көрейік
Dialogue: 0,0:09:24.06,0:09:27.76,Default,,0,0,0,,Мен ханшайыммын
Dialogue: 0,0:09:27.76,0:09:34.77,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:09:34.77,0:09:43.75,Default,,0,0,0,,«Бұл мен таңдаған тағдыр, Королеваның картасы».
Dialogue: 0,0:09:43.75,0:09:55.07,Default,,0,0,0,,«Тәждің түсімен боялған, Жарықтықта алға қарай жүремін».
Dialogue: 0,0:09:55.07,0:10:01.75,Default,,0,0,0,,...
Dialogue: 0,0:10:01.75,0:10:08.74,Default,,0,0,0,,«Қол шапалақтау жаңғырығы, мен сенің махаббатыңды сеземін».
Dialogue: 0,0:10:08.74,0:10:15.78,Default,,0,0,0,,«Бұл кері позицияда болуды білдірсе де, бұл сәтсіздік болады».
Dialogue: 0,0:10:15.78,0:10:23.09,Default,,0,0,0,,«Арманның, шамның, әннің әдемі екенін айтқым келеді».
Dialogue: 0,0:10:23.09,0:10:30.09,Default,,0,0,0,,«Айырбастап, кейде эмоцияларыңызды жасыру жақсы».
Dialogue: 0,0:10:30.09,0:10:37.12,Default,,0,0,0,,«Бақытты әлем, барлығының күлкілері»
Dialogue: 0,0:10:37.12,0:10:44.74,Default,,0,0,0,,«Мен сені қорғауды жалғастыру үшін сені ұстағым келеді».
Dialogue: 0,0:10:44.74,0:10:51.41,Default,,0,0,0,,«Мен бір нәрсені жоғалтудың қаншалықты қорқынышты екенін білдім».
Dialogue: 0,0:10:51.41,0:10:58.42,Default,,0,0,0,,«Мен әлі күнге дейін жүрегімде жатқан қорқыныш тікенектерімен күресемін».
Dialogue: 0,0:10:58.42,0:11:05.43,Default,,0,0,0,,«Мен таңдаған тағдыр - патшайымның картасы».
Dialogue: 0,0:11:05.43,0:11:12.77,Default,,0,0,0,,«Тәждің түсімен боялған, Жарықтықта жүремін».
Dialogue: 0,0:11:12.77,0:11:16.42,Default,,0,0,0,,«Сахнада лайықты»
Dialogue: 0,0:11:16.42,0:11:24.45,Default,,0,0,0,,«Мен, тікенектер патшайымы»
Dialogue: 0,0:11:24.45,0:11:27.75,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:11:27.75,0:11:30.77,Default,,0,0,0,,Сахнада күткендей мұз гүлі гүлдейді.
Dialogue: 0,0:11:30.77,0:11:34.76,Default,,0,0,0,,Виолет-чан, сен сондай әдемі едің. иә?
Dialogue: 0,0:11:34.76,0:11:38.06,Default,,0,0,0,,Бұл Лаки Чан ба?
Dialogue: 0,0:11:40.43,0:11:44.10,Default,,0,0,0,,ﾌｩ～｡ (ﾉｯｸ)
Dialogue: 0,0:11:44.10,0:11:46.74,Default,,0,0,0,,Өтінемін. Кешіріңіз.
Dialogue: 0,0:11:46.74,0:11:49.74,Default,,0,0,0,,Лаки-чан. Эхехе
Dialogue: 0,0:11:52.11,0:11:55.41,Default,,0,0,0,,Дәл қазір сахна өте керемет болды!
Dialogue: 0,0:11:55.41,0:11:58.81,Default,,0,0,0,,Сіз оны көрдіңіз. Рахмет сізге.
Dialogue: 0,0:12:01.42,0:12:05.34,Default,,0,0,0,,Ал... ән де жақсы болды.
Dialogue: 0,0:12:05.34,0:12:07.74,Default,,0,0,0,,Көйлек өте әдемі болды
Dialogue: 0,0:12:07.74,0:12:11.73,Default,,0,0,0,,Қорқынышпен күресетін патшайымнан батылдық алдым.
Dialogue: 0,0:12:11.73,0:12:14.41,Default,,0,0,0,,Мен мұны шынымен жеткізгім келеді
Dialogue: 0,0:12:14.41,0:12:16.41,Default,,0,0,0,,ｴﾍﾍﾍｯ
Dialogue: 0,0:12:18.75,0:12:22.80,Default,,0,0,0,,Бұл көйлек көптеген естеліктерді сақтайды.
Dialogue: 0,0:12:22.80,0:12:27.06,Default,,0,0,0,,Қастерлеп, мәңгілік киіп жүргім келеді.
Dialogue: 0,0:12:27.06,0:12:30.08,Default,,0,0,0,,Қахат Көйлегі де көңілді.
Dialogue: 0,0:12:30.08,0:12:33.07,Default,,0,0,0,,Иә? Tarot картасы
Dialogue: 0,0:12:33.07,0:12:35.13,Default,,0,0,0,,Таро арқылы болжау жасай аласыз ба?
Dialogue: 0,0:12:35.13,0:12:39.13,Default,,0,0,0,,Иә. Сізге байлығыңызды айтайын ба? Апыр-ай!
Dialogue: 0,0:12:43.09,0:12:47.39,Default,,0,0,0,,Интуитивті түрде бір картаны таңдап, оны сызыңыз.
Dialogue: 0,0:12:53.40,0:12:55.77,Default,,0,0,0,,Дүниенің дұрыс орналасуы
Dialogue: 0,0:12:55.77,0:12:58.41,Default,,0,0,0,,Бұл картаның мағынасы саяхат
Dialogue: 0,0:12:58.41,0:13:01.74,Default,,0,0,0,,Сондай-ақ мақсатқа жету мағынасы бар.
Dialogue: 0,0:13:01.74,0:13:05.73,Default,,0,0,0,,Мен саяхаттап жатырмын... дәл осы сәтте.
Dialogue: 0,0:13:05.73,0:13:08.40,Default,,0,0,0,,Иә. Жақсы сапар болатынына сенімдімін.
Dialogue: 0,0:13:08.40,0:13:11.75,Default,,0,0,0,,ｷｬﾊｯ ﾗｯｷｰ！ ｳﾌﾌｯ
Dialogue: 0,0:13:11.75,0:13:14.77,Default,,0,0,0,,Бірақ мақсатқа жету...
Dialogue: 0,0:13:14.77,0:13:18.83,Default,,0,0,0,,Иә! Мен әпкемді қуып келдім.
Dialogue: 0,0:13:18.83,0:13:20.75,Default,,0,0,0,,Үлкен әпке?
Dialogue: 0,0:13:20.75,0:13:23.08,Default,,0,0,0,,Мен Хэллоуин мерекесіне қатты құмар болғаным сонша, мен оны мүлдем ұмытып кеттім.
Dialogue: 0,0:13:23.08,0:13:25.78,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:13:31.42,0:13:35.82,Default,,0,0,0,,《Менің әпкем осында болуы керек.》
Dialogue: 0,0:13:40.07,0:13:44.77,Default,,0,0,0,,Эксперимент жақсы өтіп жатқан сияқты. Ой.
Dialogue: 0,0:15:26.76,0:15:29.09,Default,,0,0,0,,ﾊｧｯ ﾊｧｯ ﾊｧｯ…
Dialogue: 0,0:15:29.09,0:15:31.76,Default,,0,0,0,,Әпкең қайда?
Dialogue: 0,0:15:31.76,0:15:33.76,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:15:33.76,0:15:36.43,Default,,0,0,0,,ﾊﾛｰ ｴﾌﾞﾘﾊﾆｰ！
Dialogue: 0,0:15:36.43,0:15:39.42,Default,,0,0,0,,Көңілді жүрсің бе?
Dialogue: 0,0:15:39.42,0:15:41.42,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:15:41.42,0:15:43.44,Default,,0,0,0,,ｵｰｹｰ！
Dialogue: 0,0:15:43.44,0:15:48.93,Default,,0,0,0,,үшінңыз, бүгінгі басты оқиғаның идол костюмдер байқауын міндетті түрде тексеріңіз.
Dialogue: 0,0:15:48.93,0:15:51.10,Default,,0,0,0,,Сәлем, Акари-чан! сүйкімді!
Dialogue: 0,0:15:51.10,0:15:54.12,Default,,0,0,0,,Әрине, мен де қосыламын.
Dialogue: 0,0:15:54.12,0:15:56.10,Default,,0,0,0,,Және не
Dialogue: 0,0:15:56.10,0:15:58.75,Default,,0,0,0,,Бірінші және екінші орынға келген екі бал
Dialogue: 0,0:15:58.75,0:16:03.74,Default,,0,0,0,,Иә! Сахнаға арнайы бөлім ретінде шығамыз.
Dialogue: 0,0:16:03.74,0:16:07.20,Default,,0,0,0,,Менің айтқым келгені осы еді. (Қуаныш)
Dialogue: 0,0:16:07.20,0:16:10.42,Default,,0,0,0,,Біз әлі де қатысушы пұттарды жинап жатырмыз.
Dialogue: 0,0:16:10.42,0:16:12.40,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:16:12.40,0:16:15.84,Default,,0,0,0,,Менің де барғым келеді! Маған болады ма?
Dialogue: 0,0:16:15.84,0:16:18.41,Default,,0,0,0,,Бақытты-чан! Иә әрине.
Dialogue: 0,0:16:18.41,0:16:22.44,Default,,0,0,0,,Иә! Бақытты! менде сен барсың!
Dialogue: 0,0:16:22.44,0:16:24.50,Default,,0,0,0,,Жоқ, ол кенет жоғалып кетті.
Dialogue: 0,0:16:24.50,0:16:26.43,Default,,0,0,0,,Екеуміз бірге шығайық.
Dialogue: 0,0:16:26.43,0:16:29.83,Default,,0,0,0,,Не? Идол костюмдер байқауы
Dialogue: 0,0:16:34.07,0:16:36.41,Default,,0,0,0,,Ой~!
Dialogue: 0,0:16:36.41,0:16:39.09,Default,,0,0,0,,Басқа мектептердің оқушылары да қатыса алады деп ойлаймын.
Dialogue: 0,0:16:39.09,0:16:41.08,Default,,0,0,0,,Костюмнің материалы...
Dialogue: 0,0:16:41.08,0:16:43.75,Default,,0,0,0,,Сіз оны сол жерден еркін пайдалана аласыз.
Dialogue: 0,0:16:43.75,0:16:47.42,Default,,0,0,0,,Эй Мио, не істеуіміз керек? Мен уайымдап тұрмын.
Dialogue: 0,0:16:47.42,0:16:51.42,Default,,0,0,0,,Перілер сүйкімді, бірақ мумияларды тастау қиын.
Dialogue: 0,0:16:51.42,0:16:53.43,Default,,0,0,0,,Бұл әдетте істемейтін нәрсе болса да.
Dialogue: 0,0:16:53.43,0:16:56.75,Default,,0,0,0,,Сіз жасайтын нәрсе көйлек дизайнымен бірдей.
Dialogue: 0,0:16:56.75,0:17:00.10,Default,,0,0,0,,Хмм... Жарайсыңдар!
Dialogue: 0,0:17:00.10,0:17:02.75,Default,,0,0,0,,Мұны істеу ғана қалды. (Мио/Айне) Асығыңыз!
Dialogue: 0,0:17:02.75,0:17:05.79,Default,,0,0,0,,Уау! Жаңашыл және Раки-чанға ұқсайды
Dialogue: 0,0:17:05.79,0:17:09.76,Default,,0,0,0,,Иә. Аяқталғанда өте қызық көйлек болады деп ойлаймын.
Dialogue: 0,0:17:09.76,0:17:13.06,Default,,0,0,0,,Жарайды, қолымыздан келгеннің бәрін жасайық!
Dialogue: 0,0:17:21.42,0:17:24.44,Default,,0,0,0,,Белдемшенің етегі мынадай...
Dialogue: 0,0:17:24.44,0:17:26.61,Default,,0,0,0,,А, бұл жерде кездейсоқ болған дұрыс...
Dialogue: 0,0:17:26.61,0:17:30.10,Default,,0,0,0,,Біз де қолымыздан келгеннің бәрін жасайық. иә!
Dialogue: 0,0:17:30.10,0:17:32.75,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:17:32.75,0:17:40.41,Default,,0,0,0,,Әрбір бал, Сіз оны күткенсіз! Идол костюмдер байқауы басталғалы жатыр! Алақай!
Dialogue: 0,0:17:40.41,0:17:43.41,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:17:43.41,0:17:47.06,Default,,0,0,0,,Ең жақсы қамыр - Акари Озора Бал!
Dialogue: 0,0:17:47.06,0:17:49.40,Default,,0,0,0,,ｶﾓﾝ！
Dialogue: 0,0:17:51.73,0:17:55.39,Default,,0,0,0,,ﾄﾘｯｸ･ｵｱ･ﾄﾘｰﾄ
Dialogue: 0,0:17:55.39,0:18:00.74,Default,,0,0,0,,Ләззат алмасаң, бәлеге түсемін!
Dialogue: 0,0:18:00.74,0:18:03.08,Default,,0,0,0,,ﾊｯﾋﾟｰﾊﾛｳｨﾝ！
Dialogue: 0,0:18:03.08,0:18:06.73,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:18:06.73,0:18:08.73,Default,,0,0,0,,Акари-чан өте сүйкімді!
Dialogue: 0,0:18:08.73,0:18:10.72,Default,,0,0,0,,Шынымен
Dialogue: 0,0:18:10.72,0:18:13.14,Default,,0,0,0,,Қызық, Лаки Чан әлі осында ма?
Dialogue: 0,0:18:13.14,0:18:18.39,Default,,0,0,0,,Иә... сіз қолыңыздан келгеннің бәрін жасағыңыз келетінін айттыңыз.
Dialogue: 0,0:18:18.39,0:18:23.43,Default,,0,0,0,,Келесі кумирлер - Star Harmony академиясынан қатысқан екі адам.
Dialogue: 0,0:18:23.43,0:18:28.40,Default,,0,0,0,,Юуки Айне Бал Минато Мио Бал, кел!
Dialogue: 0,0:18:28.40,0:18:30.80,Default,,0,0,0,,Кеттік. Иә.
Dialogue: 0,0:18:35.74,0:18:39.40,Default,,0,0,0,,Осы түнде мен бәріңе періштенің махаббатын жеткіземін.
Dialogue: 0,0:18:39.40,0:18:43.42,Default,,0,0,0,,Қайырлы кеш, бұл Айне Юки. Уууу.
Dialogue: 0,0:18:43.42,0:18:47.09,Default,,0,0,0,,Бүгін түнде құлаған періштенің сүйкімділігі сізге түседі.
Dialogue: 0,0:18:47.09,0:18:50.09,Default,,0,0,0,,Қайырлы кеш, бұл Мио Минато.
Dialogue: 0,0:18:50.09,0:18:53.46,Default,,0,0,0,,Біз таза палитрамыз!
Dialogue: 0,0:18:53.46,0:18:55.50,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:18:55.50,0:18:58.42,Default,,0,0,0,,Мен бұл екеуін бірінші рет көріп тұрмын, бірақ олар кумир ме?
Dialogue: 0,0:18:58.42,0:19:00.39,Default,,0,0,0,,Бірақ екеуі де сүйкімді!
Dialogue: 0,0:19:00.39,0:19:03.79,Default,,0,0,0,,Көйлектің дизайны да өте әдемі. Иә.
Dialogue: 0,0:19:03.79,0:19:06.41,Default,,0,0,0,,ｳﾌｯ
Dialogue: 0,0:19:06.41,0:19:10.08,Default,,0,0,0,,үшін толқыды ма?
Dialogue: 0,0:19:10.08,0:19:12.75,Default,,0,0,0,,ｲｴｰｲ！ ｵｰｹｰ
Dialogue: 0,0:19:12.75,0:19:16.75,Default,,0,0,0,,Келесі қатысушы да Star Harmony академиясының кумирі.
Dialogue: 0,0:19:16.75,0:19:20.41,Default,,0,0,0,,Химейши Бақытты бал Келіңіздер!
Dialogue: 0,0:19:20.41,0:19:22.74,Default,,0,0,0,,ﾎﾜｯﾂ ﾊﾌﾟﾝ？
Dialogue: 0,0:19:22.74,0:19:26.41,Default,,0,0,0,,Химейши Бақытты бал Келіңізші
Dialogue: 0,0:19:26.41,0:19:28.81,Default,,0,0,0,,Не болды? иә?
Dialogue: 0,0:19:28.81,0:19:32.42,Default,,0,0,0,,Бұл өте жаман... Бақытты-чан...
Dialogue: 0,0:19:32.42,0:19:37.44,Default,,0,0,0,,Өкінішке орай, Бал Химейши кетіп қалды...
Dialogue: 0,0:19:37.44,0:19:39.46,Default,,0,0,0,,Бір минут күте тұрыңыз!
Dialogue: 0,0:19:39.46,0:19:41.49,Default,,0,0,0,,Қазір кеттік!
Dialogue: 0,0:19:41.49,0:19:44.41,Default,,0,0,0,,1-аудио үзінді Хигучидің көлігінің ішінен; 2-ші үзінді Сакура TV-ден, өтінемін.
Dialogue: 0,0:19:44.41,0:19:47.75,Default,,0,0,0,,Ішке бақытты қыз келді
Dialogue: 0,0:19:47.75,0:19:49.78,Default,,0,0,0,,Сәттілік, келіңіздер!
Dialogue: 0,0:19:49.78,0:19:54.86,Default,,0,0,0,,Өз бақытыңызды алыңыз!
Dialogue: 0,0:19:54.86,0:19:57.43,Default,,0,0,0,,Мен шынымен де твимін.
Dialogue: 0,0:19:57.43,0:19:59.74,Default,,0,0,0,,Бүгін тағы бір тамаша сахнаны көрдім.
Dialogue: 0,0:19:59.74,0:20:02.08,Default,,0,0,0,,Мен армандаған адамды кездестірдім
Dialogue: 0,0:20:02.08,0:20:06.15,Default,,0,0,0,,Мен Айкату ойнай бастағаннан бері көптеген қуанышты оқиғалар болды.
Dialogue: 0,0:20:06.15,0:20:10.07,Default,,0,0,0,,Олай болса, бәріңізге де сәттілік тілеймін.
Dialogue: 0,0:20:10.07,0:20:13.41,Default,,0,0,0,,Осыны ескере отырып, мен бұл көйлекті тігіп алдым.
Dialogue: 0,0:20:13.41,0:20:16.75,Default,,0,0,0,,Баршаңызға сәттілік!
Dialogue: 0,0:20:16.75,0:20:20.73,Default,,0,0,0,,Хэхе! Әйтеуір қазір өзімді бақытты сезіне бастадым.
Dialogue: 0,0:20:20.73,0:20:22.73,Default,,0,0,0,,Иә, бұл мені күлдіреді.
Dialogue: 0,0:20:22.73,0:20:25.17,Default,,0,0,0,,Рахмет Lucky!
Dialogue: 0,0:20:25.17,0:20:27.26,Default,,0,0,0,,Мен өзімді жақсы сезінемін!
Dialogue: 0,0:20:27.26,0:20:29.41,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:20:29.41,0:20:31.78,Default,,0,0,0,,ﾌﾌﾌｯ ﾌﾌﾌｯ！
Dialogue: 0,0:20:31.78,0:20:34.08,Default,,0,0,0,,ﾌﾌﾌｯ！
Dialogue: 0,0:20:34.08,0:20:38.10,Default,,0,0,0,,Соңында соңғы сайыскер пайда болады.
Dialogue: 0,0:20:38.10,0:20:43.76,Default,,0,0,0,,Осы оқиғаның продюсері және Чигакаваны қуған супер кумир.
Dialogue: 0,0:20:43.76,0:20:47.36,Default,,0,0,0,,Асука Мираи бал Танысқаныма қуаныштымын!
Dialogue: 0,0:20:51.75,0:20:55.08,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:20:55.08,0:20:59.74,Default,,0,0,0,,ﾄﾘｯｸ･ｵｱ･ﾄﾘｰﾄ！
Dialogue: 0,0:20:59.74,0:21:01.76,Default,,0,0,0,,ﾊｯ！
Dialogue: 0,0:21:01.76,0:21:05.76,Default,,0,0,0,,үшінмыз кәмпит алайық!
Dialogue: 0,0:21:05.76,0:21:07.76,Default,,0,0,0,,Керемет! Ха!
Dialogue: 0,0:21:09.75,0:21:11.75,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:21:11.75,0:21:13.75,Default,,0,0,0,,ﾊｯﾋﾟｰﾊﾛｳｨﾝ！
Dialogue: 0,0:21:13.75,0:21:16.09,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:21:16.09,0:21:20.78,Default,,0,0,0,,Енді нәтижелерді жариялауға көшейік, Бал және достар.
Dialogue: 0,0:21:20.78,0:21:24.76,Default,,0,0,0,,Беделді арнайы бөлімшеге таңдалған кумир...
Dialogue: 0,0:21:24.76,0:21:28.08,Default,,0,0,0,,(ﾄﾞﾗﾑﾛｰﾙ)
Dialogue: 0,0:21:28.08,0:21:30.10,Default,,0,0,0,,ｺﾝｸﾞﾗﾁｭﾚｰｼｮﾝ！
Dialogue: 0,0:21:30.10,0:21:32.45,Default,,0,0,0,,Бірінші орын Асука Мирайханиге бұйырды
Dialogue: 0,0:21:32.45,0:21:35.76,Default,,0,0,0,,Екінші орынды Акари Озора Бал алады. Алақай!
Dialogue: 0,0:21:35.76,0:21:38.76,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:21:38.76,0:21:40.76,Default,,0,0,0,,​​үшінңызға рахмет!
Dialogue: 0,0:21:40.76,0:21:43.18,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:21:43.18,0:21:46.75,Default,,0,0,0,,Енді көп созбай, екеуміз бірлік кезеңді ашайық.
Dialogue: 0,0:21:46.75,0:21:49.92,Default,,0,0,0,,Бұған дейін, маған бір сәт болады ма? иә?
Dialogue: 0,0:21:49.92,0:21:54.43,Default,,0,0,0,,Мен «жақсы жұмыс» марапатын бергім келетін кумир бар.
Dialogue: 0,0:21:54.43,0:21:56.76,Default,,0,0,0,,үшінна деген жанашырлық сезімі
Dialogue: 0,0:21:56.76,0:22:00.13,Default,,0,0,0,,Оның жүрегіне жабысып қалғаны мені еліктірді.
Dialogue: 0,0:22:00.13,0:22:04.07,Default,,0,0,0,,үшінның көңілін көтеріп, күлкіге бөленген адам
Dialogue: 0,0:22:04.07,0:22:07.77,Default,,0,0,0,,Бұл Раки Химейши. Аа!?
Dialogue: 0,0:22:07.77,0:22:09.92,Default,,0,0,0,,Раки-чанға сыйлық ретінде
Dialogue: 0,0:22:09.92,0:22:12.79,Default,,0,0,0,,Жеке сахналық қойылым көрсеткім келеді.
Dialogue: 0,0:22:12.79,0:22:16.43,Default,,0,0,0,,Сен істедің, Лаки-чан! Бұл күш салуға тұрарлық болды
Dialogue: 0,0:22:16.43,0:22:19.77,Default,,0,0,0,,Иә, рахмет! Ой
Dialogue: 0,0:22:19.77,0:22:24.16,Default,,0,0,0,,Ал, Акари-чан, бізден бастайық. Иә!
Dialogue: 0,0:22:24.16,0:22:28.08,Default,,0,0,0,,Акари-чанмен бірге сахнаға шыққаныма қуаныштымын.
Dialogue: 0,0:22:28.08,0:22:30.11,Default,,0,0,0,,Мен де Мираи-сан.
Dialogue: 0,0:22:30.11,0:22:32.50,Default,,0,0,0,,Бұл кезең ойдағыдай өтсе
Dialogue: 0,0:22:32.50,0:22:35.77,Default,,0,0,0,,Менің ойымша, Хэллоуин оқиғасы да сәтті өтті.
Dialogue: 0,0:22:35.77,0:22:39.44,Default,,0,0,0,,Сондықтан мен одан толық ләззат алғым келеді.
Dialogue: 0,0:22:39.44,0:22:42.06,Default,,0,0,0,,Иә, біз мұны істей аламыз.
Dialogue: 0,0:22:42.06,0:22:45.06,Default,,0,0,0,,Ең жақсысын жасайық. Иә!
Dialogue: 0,0:22:45.06,0:22:49.75,Default,,0,0,0,,Ай! Кесу!
Dialogue: 0,0:22:49.75,0:22:55.74,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:22:55.74,0:23:06.06,Default,,0,0,0,,...
Dialogue: 0,0:23:06.06,0:23:09.43,Default,,0,0,0,,«Қызыл қауын күлгін лимон»
Dialogue: 0,0:23:09.43,0:23:12.57,Default,,0,0,0,,«Қызғылт удон вакуваку» Се-бон! ""
Dialogue: 0,0:23:12.57,0:23:16.09,Default,,0,0,0,,«Гайкотурибон көз алмасы»
Dialogue: 0,0:23:16.09,0:23:19.41,Default,,0,0,0,,«Нан даршынға толы».
Dialogue: 0,0:23:19.41,0:23:22.78,Default,,0,0,0,,"Ерекше! Бірегей! Бірегей! Ерекше!"
Dialogue: 0,0:23:22.78,0:23:25.85,Default,,0,0,0,,«Егер сіз оларды қатарластырсаңыз, олар үй сөздері».
Dialogue: 0,0:23:25.85,0:23:29.24,Default,,0,0,0,,«Араласыңыз» «Араласыңыз»
Dialogue: 0,0:23:29.24,0:23:32.39,Default,,0,0,0,,«Сүйкімді де» «Сүйкімді және аралас»
Dialogue: 0,0:23:32.39,0:23:38.08,Default,,0,0,0,,«А, жаңашыл бибики».
Dialogue: 0,0:23:38.08,0:23:42.25,Default,,0,0,0,,ﾄﾞﾚﾐﾚ ｶﾌｪ･ｵ･ﾚ
Dialogue: 0,0:23:42.25,0:23:45.40,Default,,0,0,0,,«Ах, менің сүйіктім»
Dialogue: 0,0:23:45.40,0:23:48.77,Default,,0,0,0,,«Суки — мен үшін тамаша құпия сөз».
Dialogue: 0,0:23:48.77,0:23:52.41,Default,,0,0,0,,«Жел өзгереді, айналып жүру қызық».
Dialogue: 0,0:23:52.41,0:23:55.40,Default,,0,0,0,,«Өзгеше болған дұрыс, бәрі бұрын-соңды болмаған».
Dialogue: 0,0:23:55.40,0:23:59.07,Default,,0,0,0,,«Сондықтан мен айналамын, айналамын, «Мен»»
Dialogue: 0,0:23:59.07,0:24:08.41,Default,,0,0,0,,...
Dialogue: 0,0:24:08.41,0:24:10.91,Default,,0,0,0,,«үшінмен бірге»
Dialogue: 0,0:24:10.91,0:24:13.41,Default,,0,0,0,,«үшін сәйкес келеді».
Dialogue: 0,0:24:13.41,0:24:18.74,Default,,0,0,0,,«Бұл өте маңызды саясат».
Dialogue: 0,0:24:18.74,0:24:21.11,Default,,0,0,0,,«Мен бірегеймін»
Dialogue: 0,0:24:21.11,0:24:23.41,Default,,0,0,0,,«Мен ғана жеткілікті».
Dialogue: 0,0:24:23.41,0:24:28.81,Default,,0,0,0,,«Бұл да өте маңызды сәйкестік».
Dialogue: 0,0:24:28.81,0:24:31.08,Default,,0,0,0,,...
Dialogue: 0,0:24:31.08,0:24:34.49,Default,,0,0,0,,"Мен солай ойладым. Ол шертті."
Dialogue: 0,0:24:34.49,0:24:37.76,Default,,0,0,0,,«Жарқырап тұрды».
Dialogue: 0,0:24:37.76,0:24:41.16,Default,,0,0,0,,«Суки — мен үшін тамаша құпия сөз».
Dialogue: 0,0:24:41.16,0:24:44.45,Default,,0,0,0,,«Жел өзгереді, айналып жүру қызық».
Dialogue: 0,0:24:44.45,0:24:47.60,Default,,0,0,0,,«Өзгеше болған дұрыс, бәрі бұрын-соңды болмаған».
Dialogue: 0,0:24:47.60,0:24:51.10,Default,,0,0,0,,«Сондықтан мен айналамын, айналамын, «Мен»»
Dialogue: 0,0:24:51.10,0:24:53.10,Default,,0,0,0,,«Чигакава жақсы!»
Dialogue: 0,0:24:53.10,0:24:56.09,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:24:56.09,0:24:59.76,Default,,0,0,0,,Керемет тыныс алу. Мен оны бірінші рет жинап жатқаныма сене алар емеспін.
Dialogue: 0,0:24:59.76,0:25:02.45,Default,,0,0,0,,Сол Мирай-санға ілесе алатыныма сене алар емеспін.
Dialogue: 0,0:25:02.45,0:25:05.42,Default,,0,0,0,,Акари-чан керемет! Бұл керемет!
Dialogue: 0,0:25:05.42,0:25:07.84,Default,,0,0,0,,ﾌﾌﾌｯ！
Dialogue: 0,0:25:07.84,0:25:11.07,Default,,0,0,0,,Келесі менің кезегім
Dialogue: 0,0:25:11.07,0:25:14.78,Default,,0,0,0,,Толық ләззат алыңыз!
Dialogue: 0,0:25:14.78,0:25:16.76,Default,,0,0,0,,Иә!?
Dialogue: 0,0:25:16.76,0:25:18.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:26.42,0:25:30.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:30.79,0:25:33.85,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:25:33.85,0:25:35.85,Default,,0,0,0,,ｳﾌｯ！
Dialogue: 0,0:28:10.74,0:28:13.74,Default,,0,0,0,,Лаки-чанды ерен еңбегіңіз үшін марапатыңызбен құттықтаймыз!
Dialogue: 0,0:28:13.74,0:28:16.41,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:28:16.41,0:28:18.39,Default,,0,0,0,,Керемет! Міне солай!
Dialogue: 0,0:28:18.39,0:28:20.79,Default,,0,0,0,,«Берекелілік бір мақсатпен келеді».
Dialogue: 0,0:28:22.29,0:28:28.29,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
