Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:14.24,0:00:16.22,Default,,0,0,0,,Бәріміз ән айтайық...
Dialogue: 0,0:00:16.22,0:00:18.21,Default,,0,0,0,,Би билейік. Кумирлер де...
Dialogue: 0,0:00:18.21,0:00:20.65,Default,,0,0,0,,Көйлектер де... Үлкен жиын!
Dialogue: 0,0:00:20.65,0:00:26.22,Default,,0,0,0,,『Икацуон шеруі! «Ол басталады! Ой
Dialogue: 0,0:00:26.22,0:00:29.27,Default,,0,0,0,,<Чао! Мен Раки Химейши
Dialogue: 0,0:00:29.27,0:00:32.32,Default,,0,0,0,,Жұлдыздар гармония академиясының 2 курс орта мектебінің студенті
Dialogue: 0,0:00:32.32,0:00:36.71,Default,,0,0,0,,Менің арманым бір күні өзім құрастырған премиум көйлекті кию.
Dialogue: 0,0:00:36.71,0:00:39.38,Default,,0,0,0,,Үлкен әпкемнің маған берген жарқыраған қабағы мені қозғады.
Dialogue: 0,0:00:39.38,0:00:42.05,Default,,0,0,0,,Мен білмейтін көп пұттармен дос болдым.
Dialogue: 0,0:00:42.05,0:00:45.55,Default,,0,0,0,,Мен шынымен сүйкімдімін! Бақытты!
Dialogue: 0,0:00:45.55,0:00:48.72,Default,,0,0,0,,Оның үстіне апамның тәжірибесінің әсерінен
Dialogue: 0,0:00:48.72,0:00:51.09,Default,,0,0,0,,Әртүрлі мектептер мен Икатсу әлемі байланысты
Dialogue: 0,0:00:51.09,0:00:53.13,Default,,0,0,0,,Екеуміз бір болып кеткендей болдық
Dialogue: 0,0:00:53.13,0:00:57.23,Default,,0,0,0,,Бірақ сенің әпкең неге бұлай істеп жатыр?
Dialogue: 0,0:00:57.23,0:01:00.05,Default,,0,0,0,,Айкацу инженерінің қарындасын іздеу кезінде
Dialogue: 0,0:01:00.05,0:01:03.24,Default,,0,0,0,,Бүгін де барымызды салайық! ＞
Dialogue: 0,0:01:03.24,0:01:06.71,Default,,0,0,0,,"Икатсу! Жаңа дүние жүзі!!" да танымал болып келеді.
Dialogue: 0,0:01:06.71,0:01:08.73,Default,,0,0,0,,Соңғы күн келді
Dialogue: 0,0:01:08.73,0:01:13.06,Default,,0,0,0,,Бүгін бес мектепте Рождестволық кезең өтеді.
Dialogue: 0,0:01:13.06,0:01:16.23,Default,,0,0,0,,Dream Academy негізгі кезеңінен осы жерді басыңыз
Dialogue: 0,0:01:16.23,0:01:20.72,Default,,0,0,0,,Біз әр мектепті біріктіріп, сіздерге фестивальді таратамыз.
Dialogue: 0,0:01:20.72,0:01:24.66,Default,,0,0,0,,Біз үй иесі Мадока Амабамыз
Dialogue: 0,0:01:24.66,0:01:27.75,Default,,0,0,0,,Раки Химейши. Ноэль Отоджо
Dialogue: 0,0:01:27.75,0:01:33.55,Default,,0,0,0,,Мен барлығының сіңлісімін, Періште апалар. Хехе!
Dialogue: 0,0:01:33.55,0:01:36.05,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:01:36.05,0:01:40.06,Default,,0,0,0,,ﾌﾌﾌ ｵｹｵｹ ｵｰｹｰ！
Dialogue: 0,0:01:40.06,0:01:44.56,Default,,0,0,0,,Ол бірқалыпты басталды. Продюсер болудың қызығы артып барады!
Dialogue: 0,0:01:44.56,0:01:46.55,Default,,0,0,0,,Мерикури де!
Dialogue: 0,0:01:46.55,0:01:49.25,Default,,0,0,0,,ｱｲ ｶｰﾂ！
Dialogue: 0,0:04:36.22,0:04:39.22,Default,,0,0,0,,Енді сахнаға шығайық!
Dialogue: 0,0:04:39.22,0:04:44.14,Default,,0,0,0,,Осы төрт адам Рождестволық сахнаның басын безендіреді.
Dialogue: 0,0:04:44.14,0:04:49.06,Default,,0,0,0,,Арман академиясының Сейра Отожо және Кии Саекуса
Dialogue: 0,0:04:49.06,0:04:53.43,Default,,0,0,0,,Сора Казезава Мария Химесато
Dialogue: 0,0:04:53.43,0:04:58.72,Default,,0,0,0,,Бұл ән бес пұт мектебін қосуға өте ыңғайлы.
Dialogue: 0,0:04:58.72,0:05:02.02,Default,,0,0,0,,『ﾊｯﾋﾟｨ ｸﾚｯｼｪﾝﾄﾞ』！
Dialogue: 0,0:05:07.40,0:05:11.07,Default,,0,0,0,,«Харттың көлемі кенет өседі»
Dialogue: 0,0:05:11.07,0:05:14.96,Default,,0,0,0,,«Жарқыраған және түрлі-түсті мектеп күндері»
Dialogue: 0,0:05:14.96,0:05:20.21,Default,,0,0,0,,«Ән айтатын дауыстардың қабаттасатын сәті»
Dialogue: 0,0:05:20.21,0:05:24.22,Default,,0,0,0,,«Қараңдар, бақытты кресендо».
Dialogue: 0,0:05:24.22,0:05:38.80,Default,,0,0,0,,...
Dialogue: 0,0:05:38.80,0:05:42.22,Default,,0,0,0,,«Өте сүйкімді және қызға ұқсайтын форма».
Dialogue: 0,0:05:42.22,0:05:45.89,Default,,0,0,0,,«Пикапика сыныбы мен мұғалімдер ең жақсы»
Dialogue: 0,0:05:45.89,0:05:49.37,Default,,0,0,0,,«Бір минут күтіңіз, бұл өте сүйкімді».
Dialogue: 0,0:05:49.37,0:05:52.39,Default,,0,0,0,,«Оқу және сабақ алу кез келген жерден жақсы».
Dialogue: 0,0:05:52.39,0:05:56.23,Default,,0,0,0,,«Үлкен және жарық кафетерий ранчосы»
Dialogue: 0,0:05:56.23,0:05:59.72,Default,,0,0,0,,«Үстінде кемпірқосақ бар фонтан керемет».
Dialogue: 0,0:05:59.72,0:06:03.65,Default,,0,0,0,,«Маған ұнайды, иә, екеуі де».
Dialogue: 0,0:06:03.65,0:06:05.87,Default,,0,0,0,,"Мен түсіне бастадым! Иә!"
Dialogue: 0,0:06:05.87,0:06:07.88,Default,,0,0,0,,"Мен оны сезінемін! Иә!"
Dialogue: 0,0:06:07.88,0:06:10.54,Default,,0,0,0,,«Қазір біз»
Dialogue: 0,0:06:10.54,0:06:14.45,Default,,0,0,0,,«Харттың көлемі кенет артады»
Dialogue: 0,0:06:14.45,0:06:18.05,Default,,0,0,0,,«Жарқыраған және түрлі-түсті мектеп күндері»
Dialogue: 0,0:06:18.05,0:06:25.08,Default,,0,0,0,,«Біздің киімдеріміз әртүрлі болса да, біз бірдей сезінетінімізге сенімдіміз».
Dialogue: 0,0:06:25.08,0:06:28.61,Default,,0,0,0,,«Мен ерінбей жұмыс істейтін достарымды жақсы көремін».
Dialogue: 0,0:06:28.61,0:06:32.20,Default,,0,0,0,,«Мен армандарыма жету үшін жұмыс істеген сайын күнді жақсы көремін».
Dialogue: 0,0:06:32.20,0:06:37.76,Default,,0,0,0,,«Ән айтатын дауыстардың қабаттасатын сәті»
Dialogue: 0,0:06:37.76,0:06:41.89,Default,,0,0,0,,«Міне, бақытты кресендо».
Dialogue: 0,0:06:41.89,0:06:59.79,Default,,0,0,0,,...
Dialogue: 0,0:07:01.70,0:07:05.87,Default,,0,0,0,,Уау, басталды, Мио!
Dialogue: 0,0:07:05.87,0:07:11.56,Default,,0,0,0,,Иә, біз де бүгін күні бойы сахнадағы оқиғалармен айналысамыз.
Dialogue: 0,0:07:11.56,0:07:14.54,Default,,0,0,0,,Біз жақсы дайындалып, оны қызықты етуіміз керек.
Dialogue: 0,0:07:14.54,0:07:17.96,Default,,0,0,0,,Иә! үшінның достарын біріктіру
Dialogue: 0,0:07:17.96,0:07:21.55,Default,,0,0,0,,Фестиваль сәтті өтсін! иә!
Dialogue: 0,0:07:21.55,0:07:27.87,Default,,0,0,0,,Ал, бүгін сахнадан басқа біз де әр мектепте боламыз.
Dialogue: 0,0:07:27.87,0:07:30.88,Default,,0,0,0,,Рождество мерекесіне байланысты іс-шара болады.
Dialogue: 0,0:07:30.88,0:07:34.88,Default,,0,0,0,,Тікелей эфирде не істеп жатқанымызды көрейік
Dialogue: 0,0:07:34.88,0:07:37.55,Default,,0,0,0,,Хабаршы Мария!
Dialogue: 0,0:07:37.55,0:07:41.89,Default,,0,0,0,,Иә, Панпакапа!
Dialogue: 0,0:07:41.89,0:07:46.56,Default,,0,0,0,,Мен, Мария Химесато, биік таудың басындамын.
Dialogue: 0,0:07:46.56,0:07:50.56,Default,,0,0,0,,Міне, алып шырша жасау үшін...
Dialogue: 0,0:07:50.56,0:07:55.38,Default,,0,0,0,,Бұл үлкен ағашты барлық пұттар жасаған.
Dialogue: 0,0:07:55.38,0:07:58.24,Default,,0,0,0,,Олар оны қысқартуға келген сияқты...
Dialogue: 0,0:07:58.24,0:08:00.27,Default,,0,0,0,,Міне!
Dialogue: 0,0:08:00.27,0:08:03.81,Default,,0,0,0,,Оносы бар адам - ​​Харуказэ Вакаба-чан.
Dialogue: 0,0:08:03.81,0:08:06.39,Default,,0,0,0,,Ммм, сен осылай істейсің бе?
Dialogue: 0,0:08:06.39,0:08:08.73,Default,,0,0,0,,Вакаба Мен оны толығымен жаттап алдым.
Dialogue: 0,0:08:08.73,0:08:12.03,Default,,0,0,0,,Фестивальді көркейтуге бар күшімізді саламыз.
Dialogue: 0,0:08:14.22,0:08:17.66,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:08:17.66,0:08:19.56,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:19.56,0:08:21.54,Default,,0,0,0,,ｱｲ…
Dialogue: 0,0:08:21.54,0:08:23.54,Default,,0,0,0,,ｶｰﾂ！
Dialogue: 0,0:08:30.55,0:08:33.07,Default,,0,0,0,,Мен мұны істедім~ Уууу!
Dialogue: 0,0:08:33.07,0:08:35.39,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:08:35.39,0:08:40.39,Default,,0,0,0,,Содан кейін мен тікұшақпен басқа есеп беру орнына барамын.
Dialogue: 0,0:08:44.70,0:08:46.72,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:08:46.72,0:08:50.87,Default,,0,0,0,,Пұттардың үлкен ағаштар жасауы дәстүрі ғой, солай ма?
Dialogue: 0,0:08:50.87,0:08:53.87,Default,,0,0,0,,Айтпақшы, сол тікұшақ
Dialogue: 0,0:08:53.87,0:08:56.24,Default,,0,0,0,,Бұл Мария-чанның жеке тікұшағы.
Dialogue: 0,0:08:56.24,0:09:00.30,Default,,0,0,0,,Жас ханымның керемет деңгейі күткендей.
Dialogue: 0,0:09:00.30,0:09:02.88,Default,,0,0,0,,Мадока-чан түзу.
Dialogue: 0,0:09:02.88,0:09:06.04,Default,,0,0,0,,Басқа орындарды да қарастырайық.
Dialogue: 0,0:09:06.04,0:09:09.22,Default,,0,0,0,,Тілші апа Сейра!
Dialogue: 0,0:09:09.22,0:09:11.23,Default,,0,0,0,,(ｷﾞﾀｰ)
Dialogue: 0,0:09:11.23,0:09:16.40,Default,,0,0,0,,Лалала~ Мен қазір төрт жұлдызды академиядамын
Dialogue: 0,0:09:16.40,0:09:20.37,Default,,0,0,0,,Мұнда барлық пұттар бірге жұмыс істейді
Dialogue: 0,0:09:20.37,0:09:23.32,Default,,0,0,0,,Мен үлкен Рождестволық торт жасап жатырмын.
Dialogue: 0,0:09:23.32,0:09:25.71,Default,,0,0,0,,Кішкене сұхбат алайық
Dialogue: 0,0:09:25.71,0:09:27.89,Default,,0,0,0,,Сіз қандай торт жасайсыз?
Dialogue: 0,0:09:27.89,0:09:31.75,Default,,0,0,0,,Мұның сыры. Аяқтағанша ләззат алыңыз.
Dialogue: 0,0:09:31.75,0:09:35.28,Default,,0,0,0,,Ха, болмайды, суши торты!?
Dialogue: 0,0:09:35.28,0:09:37.55,Default,,0,0,0,,Иә! Үйеңкі суши!
Dialogue: 0,0:09:37.55,0:09:41.22,Default,,0,0,0,,Жоқ, жоқ! Бұл шындық болуы мүмкін емес, иә?
Dialogue: 0,0:09:41.22,0:09:45.08,Default,,0,0,0,,Мен сиқырлы торт жасаймын, күте тұрыңыз.
Dialogue: 0,0:09:45.08,0:09:48.23,Default,,0,0,0,,ﾚｯﾂ ｴﾝｼﾞｮｲ！
Dialogue: 0,0:09:48.23,0:09:51.22,Default,,0,0,0,,Мектеп шекарасынан тыс ынтымақтастық іс-шарасы
Dialogue: 0,0:09:51.22,0:09:53.73,Default,,0,0,0,,Бұл өте қызықты болатын сияқты
Dialogue: 0,0:09:53.73,0:09:56.39,Default,,0,0,0,,Ынтымақтастық туралы айтатын болсақ, Раки-чан
Dialogue: 0,0:09:56.39,0:10:00.37,Default,,0,0,0,,Өткен күні сіз Ичиго Хошимиямен бірге сахнаға шықтыңыз, солай ма?
Dialogue: 0,0:10:00.37,0:10:02.56,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:10:02.56,0:10:05.43,Default,,0,0,0,,Бұл менің бірінші рет жұмыс істеп, дос болып отырмын.
Dialogue: 0,0:10:05.43,0:10:08.98,Default,,0,0,0,,Мен қатты қобалжыдым, бірақ бұл өте қызық болды.
Dialogue: 0,0:10:08.98,0:10:11.55,Default,,0,0,0,,Бұл тамаша. Мен де бір күні жасаймын.
Dialogue: 0,0:10:11.55,0:10:14.05,Default,,0,0,0,,Мен Ичиго-чанмен бір сахнада тұрғым келеді
Dialogue: 0,0:10:14.05,0:10:16.71,Default,,0,0,0,,Бір ғажабы, бүгін мен Хошимия-сенпайдың қасында болдым.
Dialogue: 0,0:10:16.71,0:10:19.23,Default,,0,0,0,,Олар ынтымақтастық кезеңін көрсететін сияқты.
Dialogue: 0,0:10:19.23,0:10:22.56,Default,,0,0,0,,Иә, мен келемін. Чао!
Dialogue: 0,0:10:22.56,0:10:27.22,Default,,0,0,0,,Хошимия-сенпай мен Раки-чанның серіктес достары Бақытты құлпынай
Dialogue: 0,0:10:27.22,0:10:29.87,Default,,0,0,0,,Бұл сүйкімді сахна. Ән бұл...
Dialogue: 0,0:10:29.87,0:10:33.07,Default,,0,0,0,,『ｱｺｶﾞﾚｶｽﾀﾏｲｽﾞ』！
Dialogue: 0,0:10:35.56,0:10:40.56,Default,,0,0,0,,«Мен бір күні армандаған адам» «Мен қазір осындамын»
Dialogue: 0,0:10:40.56,0:10:46.22,Default,,0,0,0,,«Мен бүгін өзім болуды мақсат етіп отырмын» «Мен болуым керек».
Dialogue: 0,0:10:46.22,0:10:51.23,Default,,0,0,0,,«Ұмтыстар үнемі жаңарып отырады»
Dialogue: 0,0:10:51.23,0:10:55.88,Default,,0,0,0,,...
Dialogue: 0,0:10:55.88,0:10:58.25,Default,,0,0,0,,"Оян! Менің жаңа стилім"
Dialogue: 0,0:10:58.25,0:11:00.55,Default,,0,0,0,,«Мен оны ең көп кигім келеді»
Dialogue: 0,0:11:00.55,0:11:02.92,Default,,0,0,0,,"Оян! Менің жаңа болашағым"
Dialogue: 0,0:11:02.92,0:11:05.22,Default,,0,0,0,,«Қазір таңдау»
Dialogue: 0,0:11:05.22,0:11:07.22,Default,,0,0,0,,«Армандар» «Армандар»
Dialogue: 0,0:11:07.22,0:11:09.63,Default,,0,0,0,,«X орындаңыз»
Dialogue: 0,0:11:09.63,0:11:11.65,Default,,0,0,0,,"шаршы" "орындалды"
Dialogue: 0,0:11:11.65,0:11:13.56,Default,,0,0,0,,«Бүгін дүрбелең»
Dialogue: 0,0:11:13.56,0:11:18.57,Default,,0,0,0,,«Жоспарлар маңызды емес».
Dialogue: 0,0:11:18.57,0:11:22.89,Default,,0,0,0,,«Бүгін жел қай бағытта соғады?» «Сондай бақытты».
Dialogue: 0,0:11:22.89,0:11:24.89,Default,,0,0,0,,«тұрақты» «1 2»
Dialogue: 0,0:11:24.89,0:11:27.54,Default,,0,0,0,,«Жоғарылау кезінде»
Dialogue: 0,0:11:27.54,0:11:29.56,Default,,0,0,0,,«Тағдыр» «1 2»
Dialogue: 0,0:11:29.56,0:11:33.55,Default,,0,0,0,,«Келесі кезеңге дайындық!»
Dialogue: 0,0:11:33.55,0:11:39.22,Default,,0,0,0,,«Мен бір кездері армандаған кумирім, мен болуға ұмтылған кумирім».
Dialogue: 0,0:11:39.22,0:11:42.89,Default,,0,0,0,,«Теледидардағы үлгі»
Dialogue: 0,0:11:42.89,0:11:48.88,Default,,0,0,0,,«Егер сіз өзіңізді баптасаңыз, сіз жаңа қоспаны табасыз.»
Dialogue: 0,0:11:48.88,0:11:51.24,Default,,0,0,0,,"Сәлем! Достар!" «Сіз не ойлайсыз?»
Dialogue: 0,0:11:51.24,0:11:53.60,Default,,0,0,0,,«Бұл жақсы!» «Бұл жақсы.»
Dialogue: 0,0:11:53.60,0:11:58.23,Default,,0,0,0,,«Мен өзім жобалаймын».
Dialogue: 0,0:11:58.23,0:12:02.88,Default,,0,0,0,,...
Dialogue: 0,0:12:02.88,0:12:05.27,Default,,0,0,0,,"Оян! Менің жаңа стилім"
Dialogue: 0,0:12:05.27,0:12:07.53,Default,,0,0,0,,«Мен мұны көп істегім келеді»
Dialogue: 0,0:12:07.53,0:12:10.22,Default,,0,0,0,,"Оян! Менің жаңа болашағым"
Dialogue: 0,0:12:10.22,0:12:12.59,Default,,0,0,0,,«Қазір таңдау»
Dialogue: 0,0:12:12.59,0:12:15.88,Default,,0,0,0,,｢Арман!!｣
Dialogue: 0,0:12:15.88,0:12:20.56,Default,,0,0,0,,«Армандық арман»
Dialogue: 0,0:12:20.56,0:12:26.56,Default,,0,0,0,,｢ｶｽﾀﾏｲｽﾞ｣
Dialogue: 0,0:12:33.56,0:12:35.61,Default,,0,0,0,,Ақаулық орын алғаны рас па?
Dialogue: 0,0:12:35.61,0:12:39.40,Default,,0,0,0,,Иә, дұрыс. Пасо-кун, өтінемін
Dialogue: 0,0:12:39.40,0:12:43.39,Default,,0,0,0,,Ағаш үшін қолданылатын шамның өлшемі
Dialogue: 0,0:12:43.39,0:12:45.39,Default,,0,0,0,,Бұйрық қателікпен берілген сияқты.
Dialogue: 0,0:12:45.39,0:12:48.23,Default,,0,0,0,,Оны бұрынғыдай пайдалану мүмкін емес сияқты.
Dialogue: 0,0:12:48.23,0:12:52.90,Default,,0,0,0,,Фестивальдің шарықтау шегі үшін алып ағаштың жарықтандырылуы өте маңызды.
Dialogue: 0,0:12:52.90,0:12:56.25,Default,,0,0,0,,Қалай ойлайсың, қазір қажетті шамдарды жинай аласың ба?
Dialogue: 0,0:12:56.25,0:13:00.32,Default,,0,0,0,,Бұл үлкен сан, бірақ егер үлкен адамдар тобы бөлініп, оларды сатып алса,
Dialogue: 0,0:13:00.32,0:13:04.37,Default,,0,0,0,,Біз оны уақытында жасай аламыз. Бірақ барлық кумирлер
Dialogue: 0,0:13:04.37,0:13:06.91,Default,,0,0,0,,Сахналар мен оқиғалармен өте бос емессің, солай ма?
Dialogue: 0,0:13:06.91,0:13:09.46,Default,,0,0,0,,Мен шынымен дүкенге бара алмаймын.
Dialogue: 0,0:13:09.46,0:13:11.97,Default,,0,0,0,,А, мен не істеуім керек!
Dialogue: 0,0:13:11.97,0:13:15.87,Default,,0,0,0,,Уайымдамаңыздар, алтындарым.
Dialogue: 0,0:13:15.87,0:13:18.22,Default,,0,0,0,,Джонни мырза!
Dialogue: 0,0:13:18.22,0:13:21.23,Default,,0,0,0,,Егер мен бәрін Джонни Беппуге және басқаларға тапсырсам
Dialogue: 0,0:13:21.23,0:13:24.08,Default,,0,0,0,,ｵｹｵｹ ｵｰｹｰ！
Dialogue: 0,0:13:24.08,0:13:26.55,Default,,0,0,0,,Пұттар тынбай еңбек етіп жатса да
Dialogue: 0,0:13:26.55,0:13:29.57,Default,,0,0,0,,Үлкендер бей-жай қала алмайды
Dialogue: 0,0:13:29.57,0:13:32.57,Default,,0,0,0,,Егер сіз бес мектептің мұғалімдері мен қызметкерлерін жинасаңыз,
Dialogue: 0,0:13:32.57,0:13:35.24,Default,,0,0,0,,Адамдардың айтарлықтай саны болады.
Dialogue: 0,0:13:35.24,0:13:38.13,Default,,0,0,0,,Сізге де көмектесуге рұқсат ете аласыз ба?
Dialogue: 0,0:13:38.13,0:13:40.54,Default,,0,0,0,,Әрине, рахмет!
Dialogue: 0,0:13:40.54,0:13:42.55,Default,,0,0,0,,Алдын ала рахмет
Dialogue: 0,0:13:42.55,0:13:44.75,Default,,0,0,0,,ｵｰｹｰ！
Dialogue: 0,0:13:44.75,0:13:49.12,Default,,0,0,0,,Мен сүйкімді оқушыларыма уақытында келуге тырысамын!
Dialogue: 0,0:13:49.12,0:13:53.32,Default,,0,0,0,,Атысайық! (3 адам) Ия!
Dialogue: 0,0:15:35.23,0:15:37.73,Default,,0,0,0,,Ах, тілші Мария-чан.
Dialogue: 0,0:15:37.73,0:15:40.20,Default,,0,0,0,,Сіз басқа мектепке келген сияқтысыз.
Dialogue: 0,0:15:40.20,0:15:43.55,Default,,0,0,0,,Иә, бұл сайттағы Мария.
Dialogue: 0,0:15:43.55,0:15:47.42,Default,,0,0,0,,Бұл жолы біз Neo Venus Arc жылыжайындамыз.
Dialogue: 0,0:15:47.42,0:15:52.06,Default,,0,0,0,,Қараңдаршы, қаншама әдемі гүлдер бар.
Dialogue: 0,0:15:52.06,0:15:56.28,Default,,0,0,0,,Менің Элизабет IIIм де өте бақытты көрінеді.
Dialogue: 0,0:15:56.28,0:15:59.72,Default,,0,0,0,,Мұнда біз жылыжай өсімдіктерін қолданамыз.
Dialogue: 0,0:15:59.72,0:16:03.55,Default,,0,0,0,,Мен олар үлкен Рождестволық гүл шоқтарын жасайды деп естідім.
Dialogue: 0,0:16:03.55,0:16:06.04,Default,,0,0,0,,Қандай жалдау түрі құрылады?
Dialogue: 0,0:16:06.04,0:16:09.44,Default,,0,0,0,,Мен оны асыға күтемін. Ой.
Dialogue: 0,0:16:09.44,0:16:15.90,Default,,0,0,0,,Сізге көп рахмет. Келесі кезекте журналист Сора Чан!
Dialogue: 0,0:16:15.90,0:16:23.31,Default,,0,0,0,,Сүйкімді Курукуру Мен қазір Star Harmony академиясындамын.
Dialogue: 0,0:16:23.31,0:16:26.08,Default,,0,0,0,,Бұл шарада пұттар
Dialogue: 0,0:16:26.08,0:16:28.23,Default,,0,0,0,,Аяз атаның костюмін кию
Dialogue: 0,0:16:28.23,0:16:30.58,Default,,0,0,0,,Жанкүйерлеріммен естелік суретке түсіп жатырмын.
Dialogue: 0,0:16:30.58,0:16:33.62,Default,,0,0,0,,Мен сені үнемі қолдаймын, бар күшіңді сал!
Dialogue: 0,0:16:33.62,0:16:36.55,Default,,0,0,0,,Бірге суретке түсу керемет!
Dialogue: 0,0:16:36.55,0:16:38.57,Default,,0,0,0,,Олай болса барлығымыз жиналайық
Dialogue: 0,0:16:38.57,0:16:41.27,Default,,0,0,0,,ｱｲ ｶｰﾂ！
Dialogue: 0,0:16:43.54,0:16:47.73,Default,,0,0,0,,Ноно-чан, Лиза-чан, сен неге Аяз атаның костюмін киіп жүрсің?
Dialogue: 0,0:16:47.73,0:16:51.89,Default,,0,0,0,,Барлық жанкүйерлер аз болса да қуанатынына сенемін.
Dialogue: 0,0:16:51.89,0:16:54.89,Default,,0,0,0,,Ах, Ноно-чан. иә?
Dialogue: 0,0:16:54.89,0:16:57.76,Default,,0,0,0,,Үлпілдек~
Dialogue: 0,0:16:57.76,0:17:00.88,Default,,0,0,0,,Мен анаммен де, әкеммен де сөйлестім—
Dialogue: 0,0:17:00.88,0:17:03.56,Default,,0,0,0,,Егер сіз мұны жасасаңыз, одан да жақсырақ болуы мүмкін
Dialogue: 0,0:17:03.56,0:17:06.55,Default,,0,0,0,,Бұл рас! Рисаппе қараңыз
Dialogue: 0,0:17:06.55,0:17:10.72,Default,,0,0,0,,Рахмет, Сора-чан. Оқасы жоқ.
Dialogue: 0,0:17:10.72,0:17:15.09,Default,,0,0,0,,Өтінемін, өтіп жатқан жерге келіп, бізге келіңіз.
Dialogue: 0,0:17:15.09,0:17:17.38,Default,,0,0,0,,Біз сізді күтеміз.
Dialogue: 0,0:17:17.38,0:17:20.55,Default,,0,0,0,,Аяз атаның киімі сүйкімді болды
Dialogue: 0,0:17:20.55,0:17:23.22,Default,,0,0,0,,Міне~ Келіңіздер!
Dialogue: 0,0:17:23.22,0:17:28.61,Default,,0,0,0,,Фестивальдің шарықтау шегіне қарай ол барған сайын қызықты бола түсуде!
Dialogue: 0,0:17:28.61,0:18:10.06,Default,,0,0,0,,...
Dialogue: 0,0:18:10.06,0:18:12.38,Default,,0,0,0,,үшін, уақыт келді.
Dialogue: 0,0:18:12.38,0:18:16.22,Default,,0,0,0,,Арнайы сахнаға шығатын пұттар, күтулеріңізді сұраймыз.
Dialogue: 0,0:18:16.22,0:18:19.22,Default,,0,0,0,,Енді, Киимо!
Dialogue: 0,0:18:19.22,0:18:45.07,Default,,0,0,0,,...
Dialogue: 0,0:18:45.07,0:18:49.55,Default,,0,0,0,,Рождестволық кезеңнің шарықтау шегі де жетті!
Dialogue: 0,0:18:49.55,0:18:54.56,Default,,0,0,0,,Бұл біз сізге жеткізетін соңғы ән.
Dialogue: 0,0:18:54.56,0:18:58.11,Default,,0,0,0,,Эстафета арқылы бес мектепті қосу
Dialogue: 0,0:18:58.11,0:19:01.53,Default,,0,0,0,,Кумирлер ән айтатын ерекше ынтымақтастық кезеңі!
Dialogue: 0,0:19:01.53,0:19:03.90,Default,,0,0,0,,Ән...
Dialogue: 0,0:19:03.90,0:19:06.40,Default,,0,0,0,,『Сізді Рождество мерекесімен құттықтаймыз』!
Dialogue: 0,0:19:06.40,0:19:18.73,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:19:18.73,0:19:33.06,Default,,0,0,0,,...
Dialogue: 0,0:19:33.06,0:19:36.57,Default,,0,0,0,,｢Сізді Рождество мерекесімен құттықтаймыз, ｣
Dialogue: 0,0:19:36.57,0:19:40.24,Default,,0,0,0,,｢Сізді Рождество мерекесімен құттықтаймыз, ｣
Dialogue: 0,0:19:40.24,0:19:44.12,Default,,0,0,0,,｢Сізді Рождество мерекесімен құттықтаймыз, ｣
Dialogue: 0,0:19:44.12,0:19:47.91,Default,,0,0,0,,｢Жаңа жыл құтты болсын.｣
Dialogue: 0,0:19:47.91,0:19:51.57,Default,,0,0,0,,｢Сізді Рождество мерекесімен құттықтаймыз, ｣
Dialogue: 0,0:19:51.57,0:19:55.45,Default,,0,0,0,,｢Сізді Рождество мерекесімен құттықтаймыз, ｣
Dialogue: 0,0:19:55.45,0:19:59.07,Default,,0,0,0,,｢Сізді Рождество мерекесімен құттықтаймыз, ｣
Dialogue: 0,0:19:59.07,0:20:03.08,Default,,0,0,0,,｢Жаңа жыл құтты болсын.｣
Dialogue: 0,0:20:03.08,0:20:05.11,Default,,0,0,0,,"Сен күттің бе? Мен мәңгі күттім!"
Dialogue: 0,0:20:05.11,0:20:07.15,Default,,0,0,0,,«Сенімен қасиетті түн, кеш түні»
Dialogue: 0,0:20:07.15,0:20:10.57,Default,,0,0,0,,«Бояныңыз, киініңіз, деңгейіңізді көтеріңіз, мен сізді кездестіремін»
Dialogue: 0,0:20:10.57,0:20:12.54,Default,,0,0,0,,«Жұлдыз жарығы биі Жұлдыздың соғуы»
Dialogue: 0,0:20:12.54,0:20:14.54,Default,,0,0,0,,«Күлкі және лентамен сүй»
Dialogue: 0,0:20:14.54,0:20:18.21,Default,,0,0,0,,«Драматикалық болыңыз, романтикалық болыңыз, естеліктер жасаңыз! Ұлдар мен қыздар»
Dialogue: 0,0:20:18.21,0:20:25.38,Default,,0,0,0,,｢Жақсы хабар әкелеміз, Саған және туыстарыңа｣
Dialogue: 0,0:20:25.38,0:20:29.05,Default,,0,0,0,,｢Сізді Рождество мерекесімен құттықтаймыз, ｣
Dialogue: 0,0:20:29.05,0:20:32.92,Default,,0,0,0,,｢Жаңа жыл құтты болсын.｣
Dialogue: 0,0:20:32.92,0:20:36.54,Default,,0,0,0,,｢Сізді Рождество мерекесімен құттықтаймыз, ｣
Dialogue: 0,0:20:36.54,0:20:40.21,Default,,0,0,0,,｢Сізді Рождество мерекесімен құттықтаймыз, ｣
Dialogue: 0,0:20:40.21,0:20:43.88,Default,,0,0,0,,｢Сізді Рождество мерекесімен құттықтаймыз, ｣
Dialogue: 0,0:20:43.88,0:20:47.75,Default,,0,0,0,,｢Жаңа жыл құтты болсын.｣
Dialogue: 0,0:20:47.75,0:20:51.54,Default,,0,0,0,,｢Сізді Рождество мерекесімен құттықтаймыз, ｣
Dialogue: 0,0:20:51.54,0:20:55.43,Default,,0,0,0,,｢Сізді Рождество мерекесімен құттықтаймыз, ｣
Dialogue: 0,0:20:55.43,0:20:59.05,Default,,0,0,0,,｢Сізді Рождество мерекесімен құттықтаймыз, ｣
Dialogue: 0,0:20:59.05,0:21:09.23,Default,,0,0,0,,｢Жаңа жыл құтты болсын.｣
Dialogue: 0,0:21:09.23,0:21:16.88,Default,,0,0,0,,...
Dialogue: 0,0:21:16.88,0:21:22.56,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:21:22.56,0:21:26.21,Default,,0,0,0,,Барлық пайда болған пұттарға рахмет.
Dialogue: 0,0:21:26.21,0:21:28.90,Default,,0,0,0,,Бұл керемет сахна болды!
Dialogue: 0,0:21:28.90,0:21:30.88,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:30.88,0:21:36.57,Default,,0,0,0,,Мен сізге "Айкацу! New World Face!!" жібердім. Рождестволық кезең
Dialogue: 0,0:21:36.57,0:21:40.46,Default,,0,0,0,,Соңында барлығына ерекше сыйлық.
Dialogue: 0,0:21:40.46,0:21:44.08,Default,,0,0,0,,Сізге дайын. Артыңа қара!
Dialogue: 0,0:21:44.08,0:21:50.90,Default,,0,0,0,,Бәріңе, үлкен шырша да келді.
Dialogue: 0,0:21:50.90,0:21:53.39,Default,,0,0,0,,Мен уақытында үлгердім.
Dialogue: 0,0:21:53.39,0:21:55.77,Default,,0,0,0,,Ал, қалғандары...
Dialogue: 0,0:21:55.77,0:22:00.89,Default,,0,0,0,,Жарайсыңдар бәріңе! Бұл соңғы жанасу!
Dialogue: 0,0:22:00.89,0:22:04.23,Default,,0,0,0,,Мен шыдаймын!
Dialogue: 0,0:22:04.23,0:22:11.14,Default,,0,0,0,,Иә! (Әйелдер) Сүйкімді!
Dialogue: 0,0:22:11.14,0:22:14.06,Default,,0,0,0,,Моробоши мырза, терлеп жатырсыз.
Dialogue: 0,0:22:14.06,0:22:17.23,Default,,0,0,0,,Тынымсыз жұмыс - мен жақсы емес нәрсе.
Dialogue: 0,0:22:17.23,0:22:20.88,Default,,0,0,0,,Шектеуді бұзыңыз, келіңіз!
Dialogue: 0,0:22:20.88,0:22:26.90,Default,,0,0,0,,Иә! (Әйелдер) Ikarts!
Dialogue: 0,0:22:26.90,0:22:30.22,Default,,0,0,0,,Келесі, Neo Venus Arc
Dialogue: 0,0:22:30.22,0:22:34.02,Default,,0,0,0,,Үлкен өлшемді гүл шоғы да аяқталды. Эй!
Dialogue: 0,0:22:37.65,0:22:41.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:41.05,0:22:47.06,Default,,0,0,0,,Сансыз шамдар дәл осы жердегі көптеген пұттар сияқты.
Dialogue: 0,0:22:47.06,0:22:51.88,Default,,0,0,0,,Әрқайсысы қатты жарқырап, үлкен нұрға айналады
Dialogue: 0,0:22:51.88,0:22:56.23,Default,,0,0,0,,Сіз романтистсіз. Жас жұбайлар. иә?
Dialogue: 0,0:22:56.23,0:22:59.27,Default,,0,0,0,,Мұғалімдер мен менеджерлерге рахмет
Dialogue: 0,0:22:59.27,0:23:01.54,Default,,0,0,0,,Мен қиындықтан аман-есен өттім.
Dialogue: 0,0:23:01.54,0:23:03.87,Default,,0,0,0,,Продюсер ретінде сізге алғыс айтқым келеді.
Dialogue: 0,0:23:03.87,0:23:05.91,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:23:05.91,0:23:09.96,Default,,0,0,0,,Фуфуфу Жақсы жұмыс!
Dialogue: 0,0:23:09.96,0:23:12.72,Default,,0,0,0,,Тағы да бар!
Dialogue: 0,0:23:12.72,0:23:19.89,Default,,0,0,0,,Төрт жұлдыз академиясынан үлкен Рождестволық торт сыйлығы!
Dialogue: 0,0:23:19.89,0:23:23.23,Default,,0,0,0,,Иә? Сол торт...
Dialogue: 0,0:23:23.23,0:23:27.55,Default,,0,0,0,,Дұрыс, бұл Анхель Шугердің жаңа көйлегі үшін жасалған дизайн.
Dialogue: 0,0:23:27.55,0:23:33.24,Default,,0,0,0,,Үлпілдек періштенің бейнесі мен лентаның пішіні шынымен сүйкімді.
Dialogue: 0,0:23:33.24,0:23:37.11,Default,,0,0,0,,Үй иесі болып тер төккен үш қарындас періштеге
Dialogue: 0,0:23:37.11,0:23:39.73,Default,,0,0,0,,Әр адамнан сыйлық беру
Dialogue: 0,0:23:39.73,0:23:44.73,Default,,0,0,0,,Туған күніңмен, Ноэль.
Dialogue: 0,0:23:44.73,0:23:49.04,Default,,0,0,0,,Уау, мен өте қуаныштымын! (2 адам) Рахмет!
Dialogue: 0,0:23:49.04,0:23:52.39,Default,,0,0,0,,Енді тортты аяқтаңыз.
Dialogue: 0,0:23:52.39,0:23:54.39,Default,,0,0,0,,ｳﾌﾌ！
Dialogue: 0,0:23:56.96,0:23:59.88,Default,,0,0,0,,ｳﾌﾌﾌ！
Dialogue: 0,0:23:59.88,0:24:01.88,Default,,0,0,0,,ｲｴｰｲ！
Dialogue: 0,0:24:10.54,0:24:13.23,Default,,0,0,0,,Мерикури де!
Dialogue: 0,0:24:13.23,0:24:16.58,Default,,0,0,0,,ｱｲｶｰﾂ！
Dialogue: 0,0:24:16.58,0:24:18.88,Default,,0,0,0,,(қуаныш)
Dialogue: 0,0:24:22.24,0:24:25.56,Default,,0,0,0,,Сөз айтқандай есікті ашайық
Dialogue: 0,0:24:25.56,0:24:28.04,Default,,0,0,0,,Фестиваль арқылы әртүрлі ынтымақтастықтар жасалды.
Dialogue: 0,0:24:28.04,0:24:30.56,Default,,0,0,0,,Пұттар біртұтас болып кеткен сияқты.
Dialogue: 0,0:24:30.56,0:24:33.88,Default,,0,0,0,,Фестиваль өте сәтті өтті, Карен-чан.
Dialogue: 0,0:24:33.88,0:24:37.05,Default,,0,0,0,,Пұттар бір-бірін шабыттандырады
Dialogue: 0,0:24:37.05,0:24:39.07,Default,,0,0,0,,Бірін-бірі ұлғайту
Dialogue: 0,0:24:39.07,0:24:43.72,Default,,0,0,0,,Біреумен кездесіп, оның күлкісіне тамсанып, жол көрсету
Dialogue: 0,0:24:43.72,0:24:48.60,Default,,0,0,0,,Жарайды, бәрінің көзінің түсі бұрынғыға қарағанда әртүрлі.
Dialogue: 0,0:24:48.60,0:24:53.30,Default,,0,0,0,,Мен болашақты елестетемін, нұр үстіне нұр
Dialogue: 0,0:24:56.89,0:24:59.76,Default,,0,0,0,,《Мен көп кальмар алғым келеді
Dialogue: 0,0:24:59.76,0:25:04.03,Default,,0,0,0,,Мен көбірек көйлек көргім келеді Ах! 》
Dialogue: 0,0:25:04.03,0:25:07.36,Default,,0,0,0,,Қар жауды!
Dialogue: 0,0:25:07.36,0:25:10.42,Default,,0,0,0,,《Маған қарашы, жұлдыз.
Dialogue: 0,0:25:10.42,0:25:13.54,Default,,0,0,0,,Керемет пұттарға жақындау
Dialogue: 0,0:25:13.54,0:25:17.24,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын! 》
Dialogue: 0,0:27:51.21,0:27:53.55,Default,,0,0,0,,Пұтқа не қажет?
Dialogue: 0,0:27:53.55,0:27:56.08,Default,,0,0,0,,Мен көйлек киген сүйкімдімін!
Dialogue: 0,0:27:56.08,0:27:58.87,Default,,0,0,0,,Панпакапаа!
Dialogue: 0,0:27:58.87,0:28:01.27,Default,,0,0,0,,Жынға қылыш, пұтқа көйлек
Dialogue: 0,0:28:02.77,0:28:08.77,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
