Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:47.54,0:00:50.63,Default,,0,0,0,,Мицуко-чан, мен дүкенге барамын.
Dialogue: 0,0:00:50.75,0:00:53.88,Default,,0,0,0,,Аа~ күте тұрыңыз~
Dialogue: 0,0:00:50.75,0:00:53.88,Default,,0,0,0,,Күрсін... Күрсін...
Dialogue: 0,0:00:53.88,0:00:55.01,Default,,0,0,0,,Күрсін... Күрсін...
Dialogue: 0,0:00:55.13,0:00:59.14,Default,,0,0,0,,Біз де барайық.
Dialogue: 0,0:01:00.93,0:01:02.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:05.48,0:01:07.65,Default,,0,0,0,,Не? Сенімен бәрі жақсы ма?
Dialogue: 0,0:01:07.77,0:01:09.77,Default,,0,0,0,,Оны жөндеуге бола ма?
Dialogue: 0,0:01:09.90,0:01:11.44,Default,,0,0,0,,Бетінде бір атмосфера.
Dialogue: 0,0:01:12.57,0:01:15.45,Default,,0,0,0,,(Котароның күш дауысы)
Dialogue: 0,0:01:15.57,0:01:17.66,Default,,0,0,0,,(Жаңа баланың есінеуі)
Dialogue: 0,0:01:18.03,0:01:19.07,Default,,0,0,0,,​​О?
Dialogue: 0,0:01:26.00,0:01:28.04,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:01:28.79,0:01:32.55,Default,,0,0,0,,Көктем келсе, жасыл аққұйрықтар шулайды.
Dialogue: 0,0:01:32.92,0:01:35.88,Default,,0,0,0,,Жасыл Кодзиро өткен жазда...
Dialogue: 0,0:01:36.01,0:01:38.47,Default,,0,0,0,,Жақсы! Міне, дайын болды.
Dialogue: 0,0:01:38.59,0:01:39.76,Default,,0,0,0,,Мінейік (Шинко) Иә!
Dialogue: 0,0:01:41.39,0:01:44.68,Default,,0,0,0,,Мұны өткен жазда атам маған жасап берді.
Dialogue: 0,0:01:44.81,0:01:47.06,Default,,0,0,0,,Мен осы вистерия жүзім гамакынан құлаған кезде...
Dialogue: 0,0:01:48.94,0:01:51.15,Default,,0,0,0,,Маған өзенде бір ой келді
Dialogue: 0,0:01:52.98,0:01:54.90,Default,,0,0,0,,(Жасыл Кодзироның ізі)
Dialogue: 0,0:01:55.03,0:01:58.70,Default,,0,0,0,,Оны біз ғана көре аламыз, өйткені біз оны ойлап таптық.
Dialogue: 0,0:01:58.82,0:02:00.57,Default,,0,0,0,,Шинко (Шинко) иә?
Dialogue: 0,0:02:00.70,0:02:03.54,Default,,0,0,0,,Сіз қалай ойлайсыз? (Шинко) А?
Dialogue: 0,0:02:03.66,0:02:05.29,Default,,0,0,0,,Чумонхану өзені-
Dialogue: 0,0:02:05.70,0:02:10.54,Default,,0,0,0,,Ол кенет тік бұрышпен қисайып, ағып жатқандай емес.
Dialogue: 0,0:02:10.67,0:02:12.84,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:02:12.96,0:02:16.42,Default,,0,0,0,,Бірақ көптен бері солай болған жоқ па?
Dialogue: 0,0:02:16.55,0:02:20.22,Default,,0,0,0,,Бұл қанша уақыт бұрын болды деп ойлайсыз?
Dialogue: 0,0:02:20.34,0:02:22.01,Default,,0,0,0,,Менің атам мектепте мұғалім болған.
Dialogue: 0,0:02:22.01,0:02:24.22,Default,,0,0,0,,Менің атам мектепте мұғалім болған.
Dialogue: 0,0:02:22.01,0:02:24.22,Default,,0,0,0,,(Котароның жөтелі)
Dialogue: 0,0:02:25.06,0:02:27.81,Default,,0,0,0,,Шинко: Дұрыс.
Dialogue: 0,0:02:27.93,0:02:30.60,Default,,0,0,0,,Мың жыл артқа бару
Dialogue: 0,0:02:30.73,0:02:32.02,Default,,0,0,0,,Мың жыл?
Dialogue: 0,0:02:32.15,0:02:35.48,Default,,0,0,0,,Жай ғана кең бидай алқабы...
Dialogue: 0,0:02:35.61,0:02:39.61,Default,,0,0,0,,Бұл жерде жай ғана жатқан сияқты...
Dialogue: 0,0:02:39.74,0:02:41.36,Default,,0,0,0,,(Котароның жөтелі)
Dialogue: 0,0:02:41.49,0:02:44.37,Default,,0,0,0,,Мың жыл бұрын... Уф...
Dialogue: 0,0:02:44.49,0:02:46.91,Default,,0,0,0,,Атамның демікпесі басталғанда...
Dialogue: 0,0:02:47.04,0:02:48.33,Default,,0,0,0,,Бұл аздап қиындайды.
Dialogue: 0,0:02:49.79,0:02:51.83,Default,,0,0,0,,Бірақ бір қызығы...
Dialogue: 0,0:02:52.54,0:02:55.09,Default,,0,0,0,,Саған бәрінің атасы үйретеді.
Dialogue: 0,0:03:13.86,0:03:16.23,Default,,0,0,0,,(Локомотив ысқырығы)
Dialogue: 0,0:03:35.17,0:03:40.92,Default,,0,0,0,,Митажири~ Митажири~
Dialogue: 0,0:03:41.01,0:03:42.93,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:43.01,0:03:48.31,Default,,0,0,0,,Уау! Әпке, ақымақ!
Dialogue: 0,0:03:48.43,0:03:49.18,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:03:49.18,0:03:50.85,Default,,0,0,0,,Уау! Ах!
Dialogue: 0,0:03:49.18,0:03:50.85,Default,,0,0,0,,Заббун
Dialogue: 0,0:03:50.98,0:03:55.02,Default,,0,0,0,,Әй, не болды, Микчан?
Dialogue: 0,0:03:55.15,0:03:55.44,Default,,0,0,0,,Менің әпкемде де Кеупидің қолы бар!
Dialogue: 0,0:03:55.44,0:03:56.81,Default,,0,0,0,,Менің әпкемде де Кеупидің қолы бар!
Dialogue: 0,0:03:55.44,0:03:56.81,Default,,0,0,0,,Букубукубукубуку
Dialogue: 0,0:03:56.81,0:03:59.69,Default,,0,0,0,,Менің әпкемде де Кеупидің қолы бар!
Dialogue: 0,0:03:59.82,0:04:01.57,Default,,0,0,0,,О...
Dialogue: 0,0:04:01.69,0:04:02.90,Default,,0,0,0,,Неліктен бұлай етер едіңіз?
Dialogue: 0,0:04:02.90,0:04:05.37,Default,,0,0,0,,Неліктен бұлай етер едіңіз?
Dialogue: 0,0:04:02.90,0:04:05.37,Default,,0,0,0,,Букубукубукубукубуку…
Dialogue: 0,0:04:05.37,0:04:06.70,Default,,0,0,0,,Букубукубукубукубуку…
Dialogue: 0,0:04:07.95,0:04:09.66,Default,,0,0,0,,Бех
Dialogue: 0,0:04:12.41,0:04:15.17,Default,,0,0,0,,Осы бидай алқабында мың жыл бұрын...
Dialogue: 0,0:04:15.29,0:04:17.71,Default,,0,0,0,,Ел астанасы кең...
Dialogue: 0,0:04:17.83,0:04:20.34,Default,,0,0,0,,Тік бұрышты өзен Сол кезден бастап...
Dialogue: 0,0:04:20.46,0:04:24.38,Default,,0,0,0,,Ол қисық және ағып жатқан болуы керек ...
Dialogue: 0,0:04:24.63,0:04:26.14,Default,,0,0,0,,Суо елі
Dialogue: 0,0:04:26.26,0:04:29.47,Default,,0,0,0,,Бұл аймақ бұрын Суо провинциясы ретінде белгілі болған.
Dialogue: 0,0:04:29.60,0:04:31.93,Default,,0,0,0,,Өзен тік бұрыш жасай қисық...
Dialogue: 0,0:04:32.06,0:04:34.94,Default,,0,0,0,,А, бұл жаңа үлгі.
Dialogue: 0,0:04:35.06,0:04:39.11,Default,,0,0,0,,Тік бұрыштағы өзен - торлы өрнек бойымен ағып жатқан арықтың қалдықтары...
Dialogue: 0,0:04:39.48,0:04:41.44,Default,,0,0,0,,Сәлем, Энко Кай?
Dialogue: 0,0:04:41.57,0:04:42.99,Default,,0,0,0,,О, солай.
Dialogue: 0,0:04:43.11,0:04:45.57,Default,,0,0,0,,Ол үшін уайымдамаңыз, сіз жай ғана қызып кетесіз ...
Dialogue: 0,0:04:45.70,0:04:47.62,Default,,0,0,0,,Осы соңғы үлгіні қараңыз...
Dialogue: 0,0:04:47.74,0:04:49.99,Default,,0,0,0,,Сол жерде Йошимура мырза мен Эжима мырза...
Dialogue: 0,0:04:50.12,0:04:51.95,Default,,0,0,0,,Ауызша жанжалдан соң жол да бітті.
Dialogue: 0,0:04:52.08,0:04:55.96,Default,,0,0,0,,Көне заманнан бері болса керек...
Dialogue: 0,0:05:01.42,0:05:04.47,Default,,0,0,0,,Атам маған сол қызықтардың бәрін үйретті.
Dialogue: 0,0:05:04.47,0:05:05.63,Default,,0,0,0,,Атам маған сол қызықтардың бәрін үйретті.
Dialogue: 0,0:05:04.47,0:05:05.63,Default,,0,0,0,,(Эджима мен Йошимура арасындағы жекпе-жек)
Dialogue: 0,0:05:05.63,0:05:06.55,Default,,0,0,0,,(Эджима мен Йошимура арасындағы жекпе-жек)
Dialogue: 0,0:05:07.14,0:05:09.10,Default,,0,0,0,,Рахмет сізге ата
Dialogue: 0,0:05:09.10,0:05:09.80,Default,,0,0,0,,Рахмет сізге ата
Dialogue: 0,0:05:09.10,0:05:09.80,Default,,0,0,0,,Мұның мәні неде? (Йошимура)
Dialogue: 0,0:05:09.80,0:05:11.06,Default,,0,0,0,,Мұның мәні неде? (Йошимура)
Dialogue: 0,0:05:11.14,0:05:13.77,Default,,0,0,0,,Иә! (Котаро) Охон
Dialogue: 0,0:05:13.89,0:05:15.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:17.02,0:05:19.36,Default,,0,0,0,,Шинко, сен көрмедің бе? (Хатсуэ) Жоқ, жоқ.
Dialogue: 0,0:05:19.48,0:05:21.94,Default,,0,0,0,,Қазірдің өзінде... тағамдарға буға пісірілген нан да кетті.
Dialogue: 0,0:05:23.48,0:05:25.03,Default,,0,0,0,,Шинко!
Dialogue: 0,0:05:25.15,0:05:29.62,Default,,0,0,0,,Шинко! Қайда бардың?
Dialogue: 0,0:05:29.74,0:05:32.29,Default,,0,0,0,,Сен сондасың ба?
Dialogue: 0,0:05:32.41,0:05:36.83,Default,,0,0,0,,Қыңыр болып, үйден қашатын болсаң, байсалды болма!
Dialogue: 0,0:05:36.91,0:05:37.33,Default,,0,0,0,,Шинко ~ Шинко ~
Dialogue: 0,0:05:37.33,0:05:40.29,Default,,0,0,0,,Шинко ~ Шинко ~
Dialogue: 0,0:05:37.33,0:05:40.29,Default,,0,0,0,,А, хмм, мен сені естімеймін!
Dialogue: 0,0:05:40.38,0:05:40.75,Default,,0,0,0,,Ахх!
Dialogue: 0,0:05:40.75,0:05:41.79,Default,,0,0,0,,Ахх!
Dialogue: 0,0:05:40.75,0:05:41.79,Default,,0,0,0,,Әй, мен саған бір кесе күріш беремін, кел, ал.
Dialogue: 0,0:05:41.79,0:05:43.96,Default,,0,0,0,,Әй, мен саған бір кесе күріш беремін, ал кел.
Dialogue: 0,0:05:43.96,0:05:46.30,Default,,0,0,0,,Әй, мен саған бір кесе күріш беремін, кел, ал.
Dialogue: 0,0:05:43.96,0:05:46.30,Default,,0,0,0,,Мың жылдық елдің астанасы... Ол қандай?
Dialogue: 0,0:05:46.30,0:05:48.01,Default,,0,0,0,,Мың жылдық елдің астанасы... Ол қандай?
Dialogue: 0,0:05:48.13,0:05:50.68,Default,,0,0,0,,(шөп дыбысы)
Dialogue: 0,0:05:54.02,0:05:56.77,Default,,0,0,0,,Хмм, солай болды.
Dialogue: 0,0:05:56.89,0:05:59.35,Default,,0,0,0,,Хэхе! Бұл туралы ше?
Dialogue: 0,0:06:02.44,0:06:08.15,Default,,0,0,0,,Эйса Эйса Эйса…
Dialogue: 0,0:06:08.24,0:06:08.95,Default,,0,0,0,,Уау! (Еркектер) Қараңдар!
Dialogue: 0,0:06:08.95,0:06:10.78,Default,,0,0,0,,Уау! (Еркектер) Қараңдар!
Dialogue: 0,0:06:08.95,0:06:10.78,Default,,0,0,0,,Шинко~!
Dialogue: 0,0:06:10.87,0:06:12.78,Default,,0,0,0,,Тезірек шықшы!
Dialogue: 0,0:06:12.87,0:06:16.20,Default,,0,0,0,,Хехехе, осында болсаң жақсы болады.
Dialogue: 0,0:06:16.54,0:06:19.04,Default,,0,0,0,,Көп ұзамай астанадан қайық келеді.
Dialogue: 0,0:06:19.17,0:06:21.50,Default,,0,0,0,,Мен сізді тездетіп алып кетуім керек.
Dialogue: 0,0:06:21.63,0:06:25.21,Default,,0,0,0,,Иә! Елордадан ханшайымның келетініне сенімдімін.
Dialogue: 0,0:06:28.30,0:06:32.76,Default,,0,0,0,,Омоникаджи!
Dialogue: 0,0:06:34.64,0:06:36.22,Default,,0,0,0,,О! Міне!
Dialogue: 0,0:06:36.35,0:06:42.06,Default,,0,0,0,,67 жасында Мотосуке Киёхара алғаш рет елдің қорғаушысы ретінде қызмет етуге шақырылды.
Dialogue: 0,0:06:42.15,0:06:43.90,Default,,0,0,0,,Ел…
Dialogue: 0,0:06:48.36,0:06:51.28,Default,,0,0,0,,Шығыңыз.
Dialogue: 0,0:06:51.99,0:06:54.49,Default,,0,0,0,,Ендеше бірге қарайық
Dialogue: 0,0:06:56.12,0:06:56.95,Default,,0,0,0,,Кя!
Dialogue: 0,0:06:56.95,0:06:57.41,Default,,0,0,0,,Кя!
Dialogue: 0,0:06:56.95,0:06:57.41,Default,,0,0,0,,Корпус мүшелеріне бір-біріне негізсіз қылыш кезенуге мүлде болмайды!
Dialogue: 0,0:06:57.41,0:06:57.79,Default,,0,0,0,,Корпус мүшелеріне бір-біріне негізсіз қылыш кезенуге мүлде болмайды!
Dialogue: 0,0:06:58.37,0:07:01.04,Default,,0,0,0,,Біреу бар ма? Алаңның ортасында ойнайық!
Dialogue: 0,0:07:01.17,0:07:03.42,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:07:03.84,0:07:07.42,Default,,0,0,0,,Поо! Ханшайым шығуға жақын болды!
Dialogue: 0,0:07:26.65,0:07:28.65,Default,,0,0,0,,Міне, Киико.
Dialogue: 0,0:07:28.78,0:07:29.86,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:49.84,0:07:51.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:49.84,0:07:51.05,Default,,0,0,0,,Шимазу мырза осында ма?
Dialogue: 0,0:07:51.05,0:07:53.30,Default,,0,0,0,,Шимазу мырза осында ма?
Dialogue: 0,0:07:53.63,0:07:57.72,Default,,0,0,0,,Сәлеметсіз бе, бұл жалпы мәселелер бөлімінің қызметкері Фудзивара (Шимадзу) А, сәлем.
Dialogue: 0,0:07:57.85,0:08:01.27,Default,,0,0,0,,Токиодан бару қиын болды.
Dialogue: 0,0:08:01.39,0:08:04.65,Default,,0,0,0,,Аа, осындай адам болғаныңызға рахмет.
Dialogue: 0,0:08:04.77,0:08:07.82,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ
Dialogue: 0,0:08:07.94,0:08:09.90,Default,,0,0,0,,Жас ханым? (Шимадзу) Иә.
Dialogue: 0,0:08:11.24,0:08:13.82,Default,,0,0,0,,Бұл басты көше.
Dialogue: 0,0:08:13.91,0:08:17.83,Default,,0,0,0,,Ал, Токиомен салыстырғанда бұл шағын қала.
Dialogue: 0,0:08:18.37,0:08:23.00,Default,,0,0,0,,Біраз барған соң, ештеңе жоқ сияқты...
Dialogue: 0,0:08:34.67,0:08:38.55,Default,,0,0,0,,…менің бөлмесіне келуім керек деді—
Dialogue: 0,0:08:41.10,0:08:42.93,Default,,0,0,0,,О, жоқ хахаха
Dialogue: 0,0:08:43.60,0:08:45.90,Default,,0,0,0,,Жылқы да, сиыр да бар.
Dialogue: 0,0:08:46.02,0:08:47.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:47.44,0:08:49.61,Default,,0,0,0,,Бұл жай ғана кең алқап бидай.
Dialogue: 0,0:08:49.73,0:08:52.53,Default,,0,0,0,,Токио, бұл үлкен айырмашылық.
Dialogue: 0,0:08:55.40,0:08:56.95,Default,,0,0,0,,Барка Барка Барка
Dialogue: 0,0:08:57.07,0:08:58.53,Default,,0,0,0,,Сіз де олай айтпайсыз.
Dialogue: 0,0:08:59.08,0:09:02.29,Default,,0,0,0,,Ұрысып қалсам қолымнан келмейді, бірақ...
Dialogue: 0,0:09:15.88,0:09:18.05,Default,,0,0,0,,(тұңғыш ызылдау)
Dialogue: 0,0:09:18.59,0:09:21.22,Default,,0,0,0,,Барлығы соғысқа 10 жыл болды дейді...
Dialogue: 0,0:09:21.35,0:09:24.60,Default,,0,0,0,,Желдің екпіні сияқты.
Dialogue: 0,0:09:24.73,0:09:28.81,Default,,0,0,0,,Өйткені, бұл бар болғаны мың жылдық тарих.
Dialogue: 0,0:09:28.94,0:09:30.57,Default,,0,0,0,,Дұрыс айтасың, ата.
Dialogue: 0,0:09:30.94,0:09:32.53,Default,,0,0,0,,Иә Дәрі
Dialogue: 0,0:09:33.53,0:09:36.65,Default,,0,0,0,,Әкем де кеше үйге келмеді.
Dialogue: 0,0:09:36.86,0:09:40.74,Default,,0,0,0,,Жұмысым бос емес (Шинко) Ахх...
Dialogue: 0,0:09:42.12,0:09:44.37,Default,,0,0,0,,Эй, Шинко, тезірек таңғы асыңды іш.
Dialogue: 0,0:09:44.50,0:09:46.46,Default,,0,0,0,,Ахх (фотон) Хмф!
Dialogue: 0,0:09:46.54,0:09:48.96,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:09:51.54,0:09:53.96,Default,,0,0,0,,А, кешігіп қалдым, кешігіп қалдым, жарайды.
Dialogue: 0,0:09:54.51,0:09:56.47,Default,,0,0,0,,Хмм, бұл Май Майдың кінәсі.
Dialogue: 0,0:09:56.55,0:09:59.51,Default,,0,0,0,,Күрсін... Ах...
Dialogue: 0,0:10:00.09,0:10:01.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:01.72,0:10:02.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:01.72,0:10:02.35,Default,,0,0,0,,(Жасыл Кодзироның ізі)
Dialogue: 0,0:10:02.35,0:10:02.43,Default,,0,0,0,,(Жасыл Кодзироның ізі)
Dialogue: 0,0:10:02.43,0:10:04.77,Default,,0,0,0,,(Жасыл Кодзироның ізі)
Dialogue: 0,0:10:02.43,0:10:04.77,Default,,0,0,0,,Ой! Бұл жылдам
Dialogue: 0,0:10:05.35,0:10:07.64,Default,,0,0,0,,Эй, мен жеңілемін!
Dialogue: 0,0:10:24.70,0:10:28.00,Default,,0,0,0,,Иә? (Балалар) Қарғыс атсын! Қарғыс атқыр...
Dialogue: 0,0:10:28.12,0:10:30.63,Default,,0,0,0,,Бұл ненің иісі?
Dialogue: 0,0:10:32.08,0:10:35.21,Default,,0,0,0,,Сасық... (Шинко) Сасық па?
Dialogue: 0,0:10:35.34,0:10:39.43,Default,,0,0,0,,Ал... Не айтарымды білмеймін, бірақ иіс.
Dialogue: 0,0:10:39.55,0:10:41.84,Default,,0,0,0,,Кеше келген ауыспалы студент
Dialogue: 0,0:10:42.72,0:10:44.72,Default,,0,0,0,,Оны не үшін киіп жүрсің?
Dialogue: 0,0:10:44.85,0:10:46.77,Default,,0,0,0,,Білмеймін, білмеймін (қыздар) Ахахха
Dialogue: 0,0:10:46.89,0:10:50.48,Default,,0,0,0,,Далапқа келетін болсақ, далапты жағудың көптеген жолдары бар.
Dialogue: 0,0:10:52.56,0:10:54.98,Default,,0,0,0,,Бөтен бөртпе болуы керек.
Dialogue: 0,0:10:55.11,0:10:56.86,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:10:57.19,0:11:00.61,Default,,0,0,0,,Бұл жағымсыз сезім.
Dialogue: 0,0:11:01.03,0:11:03.12,Default,,0,0,0,,Иә, 3 курс, 3 сынып
Dialogue: 0,0:11:03.24,0:11:06.87,Default,,0,0,0,,Сол күні кешке доктор Ханаданың әйелі кенет босанды.
Dialogue: 0,0:11:06.99,0:11:09.08,Default,,0,0,0,,Уау! (Әйел) Сіз дүниеге келдіңіз бе?
Dialogue: 0,0:11:09.58,0:11:13.08,Default,,0,0,0,,Иә, сондықтан бірінші кезең өздік жұмыс.
Dialogue: 0,0:11:13.83,0:11:15.21,Default,,0,0,0,,Қыз? Қыз...
Dialogue: 0,0:11:15.34,0:11:15.88,Default,,0,0,0,,Хизуру-сенсэй, сен солай айттың ба?
Dialogue: 0,0:11:15.88,0:11:17.67,Default,,0,0,0,,Хизуру-сенсэй, сен солай айттың ба?
Dialogue: 0,0:11:15.88,0:11:17.67,Default,,0,0,0,,Йошиока мырза, сіз бояуға жақсы емессіз (Йосиока) Бұл жақсы.
Dialogue: 0,0:11:17.67,0:11:20.17,Default,,0,0,0,,Йошиока мырза, сіз бояуды жақсы білмейсіз (Ёшиока) Бұл дұрыс емес.
Dialogue: 0,0:11:20.30,0:11:23.01,Default,,0,0,0,,Ей, балақай, сен оны қалай атайсың деп ойлаймын.
Dialogue: 0,0:11:23.14,0:11:24.43,Default,,0,0,0,,Мұғалім туралы.
Dialogue: 0,0:11:24.55,0:11:27.39,Default,,0,0,0,,«Хибари» немесе «Чиеми», солай емес пе?
Dialogue: 0,0:11:27.52,0:11:29.64,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:11:29.77,0:11:30.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:32.10,0:11:34.65,Default,,0,0,0,,Сіз кешегі радионы естідіңіз бе? (Қыз) Сағат 6-дан ба?
Dialogue: 0,0:11:34.77,0:11:36.23,Default,,0,0,0,,Иә, иә, естідім.
Dialogue: 0,0:11:43.32,0:11:45.24,Default,,0,0,0,,О, керемет!
Dialogue: 0,0:11:45.32,0:11:47.37,Default,,0,0,0,,Әй... (Иппей) Сол түсті қарындаштар
Dialogue: 0,0:11:47.74,0:11:49.16,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:50.75,0:11:52.00,Default,,0,0,0,,Әй, бұл қандай түсті қарындаштар?
Dialogue: 0,0:11:52.00,0:11:53.37,Default,,0,0,0,,Әй, бұл қандай түсті қарындаштар?
Dialogue: 0,0:11:52.00,0:11:53.37,Default,,0,0,0,,(Балалар шуы)
Dialogue: 0,0:11:53.37,0:11:54.38,Default,,0,0,0,,(Балалар шуы)
Dialogue: 0,0:11:54.38,0:11:56.13,Default,,0,0,0,,(Балалар шуы)
Dialogue: 0,0:11:54.38,0:11:56.13,Default,,0,0,0,,Әй, оның неше түсі бар?
Dialogue: 0,0:11:56.13,0:11:56.75,Default,,0,0,0,,Әй, оның неше түсі бар?
Dialogue: 0,0:11:58.09,0:11:59.84,Default,,0,0,0,,Уау~
Dialogue: 0,0:12:02.38,0:12:04.59,Default,,0,0,0,,Бұрын көрмеппін (Шинко) Бұл не?
Dialogue: 0,0:12:04.72,0:12:06.10,Default,,0,0,0,,Такчоки мырза
Dialogue: 0,0:12:06.18,0:12:07.05,Default,,0,0,0,,Уау~
Dialogue: 0,0:12:07.43,0:12:12.23,Default,,0,0,0,,２ ４ ６ ８ 10 12 14…
Dialogue: 0,0:12:12.31,0:12:13.94,Default,,0,0,0,,...
Dialogue: 0,0:12:14.06,0:12:17.23,Default,,0,0,0,,Уау! 26 түс бар! (Оқушылар) Уау!
Dialogue: 0,0:12:17.31,0:12:19.44,Default,,0,0,0,,Ал мен бұрын көрмеген түстер өте көп.
Dialogue: 0,0:12:19.57,0:12:21.57,Default,,0,0,0,,Эй, бұл импортталған ба?
Dialogue: 0,0:12:21.65,0:12:25.32,Default,,0,0,0,,Басқа елдерде қызыл және көк түстер бар.
Dialogue: 0,0:12:25.45,0:12:26.28,Default,,0,0,0,,Ах~
Dialogue: 0,0:12:26.41,0:12:28.83,Default,,0,0,0,,Сен дұрыс оқисың ба? 3 курс, 3 сынып?
Dialogue: 0,0:12:28.91,0:12:30.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:36.71,0:12:39.88,Default,,0,0,0,,Ах, 5 курс Тацуёси.
Dialogue: 0,0:12:40.00,0:12:41.67,Default,,0,0,0,,Сондай-ақ саботокчору
Dialogue: 0,0:12:41.80,0:12:43.88,Default,,0,0,0,,Такчоки мырза
Dialogue: 0,0:12:50.81,0:12:52.22,Default,,0,0,0,,Ноу
Dialogue: 0,0:12:52.81,0:12:55.10,Default,,0,0,0,,Маған осы түсті беріңізші.
Dialogue: 0,0:12:55.64,0:12:56.73,Default,,0,0,0,,Ноу
Dialogue: 0,0:12:56.81,0:13:00.27,Default,,0,0,0,,Мен Сето ішкі теңізін осы түспен бояуға тырыстым.
Dialogue: 0,0:13:00.40,0:13:01.23,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:13:01.61,0:13:03.74,Default,,0,0,0,,(Қыздың есінеуі)
Dialogue: 0,0:13:04.11,0:13:06.53,Default,,0,0,0,,Хе хехе
Dialogue: 0,0:13:07.53,0:13:10.74,Default,,0,0,0,,(түрлі-түсті қарындаштарды ысқылау дыбысы)
Dialogue: 0,0:13:10.83,0:13:12.33,Default,,0,0,0,,Мм...!
Dialogue: 0,0:13:12.45,0:13:14.71,Default,,0,0,0,,Бұл әдемі түс болса да...
Dialogue: 0,0:13:14.83,0:13:16.50,Default,,0,0,0,,Сіз...
Dialogue: 0,0:13:16.58,0:13:20.34,Default,,0,0,0,,...
Dialogue: 0,0:13:20.42,0:13:21.42,Default,,0,0,0,,Ах! !
Dialogue: 0,0:13:21.55,0:13:24.80,Default,,0,0,0,,Ақыр аяғында, сынды...!
Dialogue: 0,0:13:24.92,0:13:27.05,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:13:35.23,0:13:36.64,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:13:38.73,0:13:40.11,Default,,0,0,0,,(ядроның сынған дыбысы)
Dialogue: 0,0:13:43.32,0:13:44.61,Default,,0,0,0,,Енді жоқ, иә?
Dialogue: 0,0:13:45.69,0:13:47.66,Default,,0,0,0,,Қайтарыңыз Оны қайтарыңыз
Dialogue: 0,0:13:47.78,0:13:51.37,Default,,0,0,0,,Әй, қауіпті, қауіпті, қауіпті...!
Dialogue: 0,0:13:51.45,0:13:52.58,Default,,0,0,0,,Мына көйлек әдемі емес пе? (Балалар) Ах!
Dialogue: 0,0:13:52.58,0:13:54.37,Default,,0,0,0,,Мына көйлек әдемі емес пе? (Балалар) Ах!
Dialogue: 0,0:13:52.58,0:13:54.37,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:13:54.91,0:13:57.87,Default,,0,0,0,,А... жақсысың ба? (Ханада мырза) Міне!
Dialogue: 0,0:13:57.96,0:14:00.42,Default,,0,0,0,,Трансферант қызға не істеуім керек?
Dialogue: 0,0:14:00.54,0:14:01.88,Default,,0,0,0,,Әй, Ханада мырза!
Dialogue: 0,0:14:02.34,0:14:07.38,Default,,0,0,0,,Қашып құтыла алмадың, иә? Өте жылдам әрі өте күшті еді — тіпті көре де алмадың, иә?
Dialogue: 0,0:14:07.47,0:14:09.51,Default,,0,0,0,,Ханада әке
Dialogue: 0,0:14:09.64,0:14:11.30,Default,,0,0,0,,Әке (Ханада Сенсей) Міне, келдің.
Dialogue: 0,0:14:11.39,0:14:13.76,Default,,0,0,0,,Мені мазақ етпе
Dialogue: 0,0:14:16.39,0:14:22.40,Default,,0,0,0,,(Балалар дауысы)
Dialogue: 0,0:14:35.95,0:14:37.66,Default,,0,0,0,,Уау, уау, уау (ер) Бұл қауіпті
Dialogue: 0,0:14:46.76,0:14:50.97,Default,,0,0,0,,(Жақындап келе жатқан пойыздың дыбысы)
Dialogue: 0,0:15:22.92,0:15:25.25,Default,,0,0,0,,Ах... у...
Dialogue: 0,0:15:25.38,0:15:27.96,Default,,0,0,0,,Шимазу... Кико-сан?
Dialogue: 0,0:15:29.21,0:15:32.84,Default,,0,0,0,,Неге! Шигеру ғана орнынан тұруы керек...
Dialogue: 0,0:15:35.22,0:15:36.51,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:15:36.64,0:15:39.89,Default,,0,0,0,,Неге... білесің бе?
Dialogue: 0,0:15:42.56,0:15:44.61,Default,,0,0,0,,Пок-юн!
Dialogue: 0,0:15:51.45,0:15:54.03,Default,,0,0,0,,Әй, эй! Эй!
Dialogue: 0,0:15:54.16,0:15:55.12,Default,,0,0,0,,Сіз біртүрлі екенсіз.
Dialogue: 0,0:15:58.62,0:16:01.12,Default,,0,0,0,,Хааа~
Dialogue: 0,0:16:03.00,0:16:05.08,Default,,0,0,0,,Кел, танысайық.
Dialogue: 0,0:16:05.21,0:16:08.00,Default,,0,0,0,,Қамшыбай? Сіз не істемексіз?
Dialogue: 0,0:16:08.59,0:16:11.51,Default,,0,0,0,,Ах~ Компанияның тұрғын үйі Компанияның тұрғын үйі Чубута~
Dialogue: 0,0:16:11.67,0:16:14.51,Default,,0,0,0,,Қайтарылған жердің ішінде осындай қала болған.
Dialogue: 0,0:16:15.93,0:16:17.01,Default,,0,0,0,,Мен білмедім.
Dialogue: 0,0:16:17.10,0:16:19.77,Default,,0,0,0,,Қамшыбай Қамшыбайды қарашы!
Dialogue: 0,0:16:19.89,0:16:23.02,Default,,0,0,0,,Жүр! (Балалар) Суретті әңгіме шоуы Ах!
Dialogue: 0,0:16:33.65,0:16:35.57,Default,,0,0,0,,Фу
Dialogue: 0,0:16:40.54,0:16:41.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:44.29,0:16:45.54,Default,,0,0,0,,Мм... (Шинко) А?
Dialogue: 0,0:16:46.17,0:16:47.54,Default,,0,0,0,,Жалғастырыңыз
Dialogue: 0,0:16:50.80,0:16:52.21,Default,,0,0,0,,Хмм
Dialogue: 0,0:16:56.55,0:17:00.26,Default,,0,0,0,,Ах! А, жарайды, жарайды, жарайды.
Dialogue: 0,0:17:00.35,0:17:02.39,Default,,0,0,0,,О~ Ой~ Жарайды, жарайды, жарайды.
Dialogue: 0,0:17:02.52,0:17:05.77,Default,,0,0,0,,А, жарайсыңдар! Қышқан жері жоқ па?
Dialogue: 0,0:17:05.85,0:17:08.15,Default,,0,0,0,,Ах~ хахахаха
Dialogue: 0,0:17:08.27,0:17:11.61,Default,,0,0,0,,Жарайды, жарайды, жарайды, ах~ ахахха
Dialogue: 0,0:17:11.73,0:17:15.28,Default,,0,0,0,,Ах~ хахахаха Жарайды, жарайды, жарайды, жарайды.
Dialogue: 0,0:17:15.40,0:17:16.86,Default,,0,0,0,,Уау хахаха
Dialogue: 0,0:17:16.99,0:17:21.16,Default,,0,0,0,,Олай болса, иттермен жақсы қарым-қатынаста емессің, иә?
Dialogue: 0,0:17:21.74,0:17:23.37,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:24.33,0:17:25.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:29.29,0:17:31.55,Default,,0,0,0,,Я~
Dialogue: 0,0:17:32.17,0:17:35.22,Default,,0,0,0,,Ах, неміс ағашы.
Dialogue: 0,0:17:35.34,0:17:37.30,Default,,0,0,0,,Бұтақтың ортасында тесік бар...
Dialogue: 0,0:17:37.43,0:17:39.80,Default,,0,0,0,,Ол бос, уайымдамаңыз.
Dialogue: 0,0:17:46.44,0:17:48.23,Default,,0,0,0,,Егер ол бос болса...
Dialogue: 0,0:17:48.81,0:17:50.48,Default,,0,0,0,,Бұл «Deutsugi» ме?
Dialogue: 0,0:17:53.15,0:17:56.24,Default,,0,0,0,,Хмм... мм... Білмеймін.
Dialogue: 0,0:18:01.33,0:18:03.24,Default,,0,0,0,,Хааа~
Dialogue: 0,0:18:09.00,0:18:11.38,Default,,0,0,0,,Жарайды, мұнда ешкім жоқ.
Dialogue: 0,0:18:11.50,0:18:13.75,Default,,0,0,0,,Анаң ше? (Киико) Онда жоқ.
Dialogue: 0,0:18:14.30,0:18:17.42,Default,,0,0,0,,Сондықтан жоғары көтерілсе де жақсы
Dialogue: 0,0:18:17.72,0:18:18.84,Default,,0,0,0,,Иә
Dialogue: 0,0:18:22.43,0:18:24.77,Default,,0,0,0,,Уау! Ал, баспалдақтар
Dialogue: 0,0:18:25.14,0:18:29.60,Default,,0,0,0,,Иә, бұл менің үйімде немесе менің көршімде немесе еш жерде емес.
Dialogue: 0,0:18:40.45,0:18:42.16,Default,,0,0,0,,Саған хабарлап қояйын, бәлкім қажет болады.
Dialogue: 0,0:18:42.28,0:18:44.62,Default,,0,0,0,,Иә...
Dialogue: 0,0:18:51.08,0:18:52.54,Default,,0,0,0,,Ха~
Dialogue: 0,0:19:03.68,0:19:04.76,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:19:04.89,0:19:08.48,Default,,0,0,0,,А, бұл аю! Аю болды!
Dialogue: 0,0:19:08.60,0:19:10.56,Default,,0,0,0,,Аю Ойнайық~
Dialogue: 0,0:19:10.69,0:19:12.77,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:19:12.90,0:19:17.03,Default,,0,0,0,,А... «Аю»!
Dialogue: 0,0:19:30.46,0:19:36.46,Default,,0,0,0,,(сағат 3 сигналы)
Dialogue: 0,0:19:40.47,0:19:43.64,Default,,0,0,0,,Сүт... Ішеміз бе?
Dialogue: 0,0:19:43.72,0:19:46.72,Default,,0,0,0,,(жанып жатқан газдың дыбысы)
Dialogue: 0,0:19:46.85,0:19:49.85,Default,,0,0,0,,А, бұл газ тоңазытқышы!
Dialogue: 0,0:19:49.98,0:19:51.44,Default,,0,0,0,,Я~
Dialogue: 0,0:19:51.56,0:19:54.40,Default,,0,0,0,,Мен отты салқындату үшін ішіне от жағатынын естідім...
Dialogue: 0,0:19:54.52,0:19:56.11,Default,,0,0,0,,Ол қай жерде жанады?
Dialogue: 0,0:19:56.23,0:19:57.32,Default,,0,0,0,,Артқы жағы
Dialogue: 0,0:19:57.40,0:19:59.07,Default,,0,0,0,,Эй, менікі...
Dialogue: 0,0:19:59.15,0:20:02.74,Default,,0,0,0,,«Мұз дүкені күнде мұз толтырады» деген сияқты емес.
Dialogue: 0,0:20:03.07,0:20:04.66,Default,,0,0,0,,Я~
Dialogue: 0,0:20:05.32,0:20:07.95,Default,,0,0,0,,Эй, мен қауесетті естідім...
Dialogue: 0,0:20:08.08,0:20:09.87,Default,,0,0,0,,Сіз оны теледидардан көрдіңіз бе?
Dialogue: 0,0:20:12.96,0:20:14.21,Default,,0,0,0,,Иә...
Dialogue: 0,0:20:15.00,0:20:16.54,Default,,0,0,0,,Токиода...
Dialogue: 0,0:20:18.21,0:20:19.92,Default,,0,0,0,,Шамамен екі рет
Dialogue: 0,0:20:20.13,0:20:20.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:21.09,0:20:24.38,Default,,0,0,0,,Сәлем! Эй... Сонда солай ма?
Dialogue: 0,0:20:24.97,0:20:28.14,Default,,0,0,0,,(Музыкалық қорап)
Dialogue: 0,0:20:29.51,0:20:30.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:50.99,0:20:52.75,Default,,0,0,0,,Түрлі-түсті қарындаштар…
Dialogue: 0,0:20:53.62,0:20:55.92,Default,,0,0,0,,Ол шынымен де сонда болды.
Dialogue: 0,0:20:57.08,0:20:58.29,Default,,0,0,0,,Иә...
Dialogue: 0,0:21:00.25,0:21:01.46,Default,,0,0,0,,(Рюи) Неге сен өртеніп жатқан жоқсың?
Dialogue: 0,0:21:01.84,0:21:05.38,Default,,0,0,0,,Әке... Ол керемет адам ма?
Dialogue: 0,0:21:05.76,0:21:08.80,Default,,0,0,0,,Жоқ, дәрігер.
Dialogue: 0,0:21:09.60,0:21:10.81,Default,,0,0,0,,Зауыт
Dialogue: 0,0:21:10.93,0:21:12.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:13.81,0:21:15.02,Default,,0,0,0,,Парфюмерия...
Dialogue: 0,0:21:16.69,0:21:19.23,Default,,0,0,0,,Мен оны киюім керек еді.
Dialogue: 0,0:21:19.36,0:21:21.40,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:21:22.03,0:21:23.74,Default,,0,0,0,,…Маған ұнайды.
Dialogue: 0,0:21:25.49,0:21:28.28,Default,,0,0,0,,Мен оны енді кимеймін...
Dialogue: 0,0:21:28.41,0:21:31.12,Default,,0,0,0,,Мен мектептемін...
Dialogue: 0,0:21:31.24,0:21:32.29,Default,,0,0,0,,Иә
Dialogue: 0,0:21:52.64,0:21:56.18,Default,,0,0,0,,Неге келмейсің?
Dialogue: 0,0:21:56.69,0:21:58.69,Default,,0,0,0,,Менің орнымда...
Dialogue: 0,0:22:01.27,0:22:04.44,Default,,0,0,0,,Тез кел...
Dialogue: 0,0:22:05.11,0:22:07.45,Default,,0,0,0,,Кел, кел! Асығыңыз, асығыңыз
Dialogue: 0,0:22:09.36,0:22:11.37,Default,,0,0,0,,Қараңдаршы, бұл біздің үй.
Dialogue: 0,0:22:11.62,0:22:15.08,Default,,0,0,0,,Қараңыз... хехе
Dialogue: 0,0:22:17.37,0:22:19.37,Default,,0,0,0,,Бұл кемеге ұқсайды, солай ма?
Dialogue: 0,0:22:19.54,0:22:22.25,Default,,0,0,0,,Көк бидай толқындарын кесіп өту...
Dialogue: 0,0:22:22.54,0:22:24.84,Default,,0,0,0,,Өлтірген барлық адамдарыңа — соның ішінде менің атамды да!
Dialogue: 0,0:22:24.96,0:22:27.55,Default,,0,0,0,,Бұл менің атам
Dialogue: 0,0:22:27.63,0:22:31.60,Default,,0,0,0,,Бұл мен үшін қорқынышты емес, бірақ басқа адамдар үшін бұл аздап қорқынышты.
Dialogue: 0,0:22:31.72,0:22:32.55,Default,,0,0,0,,Қорқынышты ма?
Dialogue: 0,0:22:32.80,0:22:33.93,Default,,0,0,0,,Хехе
Dialogue: 0,0:22:34.06,0:22:36.68,Default,,0,0,0,,Бірақ, өтінемін, менің үйіме кірген ұры отырсын...
Dialogue: 0,0:22:36.81,0:22:39.10,Default,,0,0,0,,Мен саған кешкі ас жегіздім (Киико) хаха
Dialogue: 0,0:22:39.23,0:22:41.56,Default,,0,0,0,,Бұл менің әжем
Dialogue: 0,0:22:42.02,0:22:44.52,Default,,0,0,0,,Олай болса қараңыз! Ха!
Dialogue: 0,0:22:44.65,0:22:46.90,Default,,0,0,0,,Мына жақта, былай! (Кико) Ха
Dialogue: 0,0:22:48.57,0:22:49.40,Default,,0,0,0,,Ах...!
Dialogue: 0,0:22:49.82,0:22:53.37,Default,,0,0,0,,Қараңдар, қараңдар, құпия қазына мұражайы
Dialogue: 0,0:22:53.87,0:22:55.37,Default,,0,0,0,,Ха...
Dialogue: 0,0:22:55.45,0:22:57.37,Default,,0,0,0,,Барлық Glico қосымшалары.
Dialogue: 0,0:22:57.95,0:23:01.75,Default,,0,0,0,,Негізі мен осының ішіне электр тоғын жаққым келеді.
Dialogue: 0,0:23:01.88,0:23:03.38,Default,,0,0,0,,Я~
Dialogue: 0,0:23:03.63,0:23:07.38,Default,,0,0,0,,Түнде сыртқа жасырын шықсаңыз, жарқыраған терезелерді көресіз.
Dialogue: 0,0:23:07.51,0:23:08.97,Default,,0,0,0,,Хехе, әдемі екен.
Dialogue: 0,0:23:09.09,0:23:10.88,Default,,0,0,0,,Иә...
Dialogue: 0,0:23:11.01,0:23:12.89,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:23:13.01,0:23:13.89,Default,,0,0,0,,Хехе
Dialogue: 0,0:23:14.22,0:23:15.72,Default,,0,0,0,,Бұл фотон (фотон) Хмм!
Dialogue: 0,0:23:16.22,0:23:17.39,Default,,0,0,0,,Әпке
Dialogue: 0,0:23:17.52,0:23:18.73,Default,,0,0,0,,Сәлеметсіз бе...
Dialogue: 0,0:23:19.39,0:23:20.31,Default,,0,0,0,,Бұл
Dialogue: 0,0:23:20.44,0:23:21.85,Default,,0,0,0,,Ха! Мен бұл не деп ойлаймын
Dialogue: 0,0:23:21.98,0:23:23.77,Default,,0,0,0,,Сәлем, Агари мырза.
Dialogue: 0,0:23:23.90,0:23:25.94,Default,,0,0,0,,Эй, бұл не?
Dialogue: 0,0:23:26.07,0:23:28.53,Default,,0,0,0,,Ах... (Мицуко) Бұл не кәдесый?
Dialogue: 0,0:23:28.65,0:23:29.65,Default,,0,0,0,,Аа...
Dialogue: 0,0:23:29.90,0:23:31.15,Default,,0,0,0,,Уау! (Шинко) Кинкира!
Dialogue: 0,0:23:31.24,0:23:32.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:32.45,0:23:35.20,Default,,0,0,0,,Бұл әкемнің үстелінде...
Dialogue: 0,0:23:35.33,0:23:36.74,Default,,0,0,0,,Иә? (Мицуко) Иә! ?
Dialogue: 0,0:23:36.87,0:23:38.16,Default,,0,0,0,,Өйткені бұл кәдесый
Dialogue: 0,0:23:38.25,0:23:40.96,Default,,0,0,0,,Уау~ Бұл өте жарқыраған
Dialogue: 0,0:23:41.08,0:23:43.46,Default,,0,0,0,,Аха! Ішінде шоколад бар.
Dialogue: 0,0:23:43.58,0:23:45.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:45.13,0:23:47.55,Default,,0,0,0,,Ммммммммм!
Dialogue: 0,0:23:47.63,0:23:49.80,Default,,0,0,0,,Ха ха ха!
Dialogue: 0,0:23:49.92,0:23:52.22,Default,,0,0,0,,Нхуфуфуху!
Dialogue: 0,0:23:52.30,0:23:53.72,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:23:53.97,0:23:55.22,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:23:58.47,0:23:59.64,Default,,0,0,0,,Хмм
Dialogue: 0,0:24:00.14,0:24:01.39,Default,,0,0,0,,Хмм
Dialogue: 0,0:24:01.94,0:24:02.85,Default,,0,0,0,,Әй?
Dialogue: 0,0:24:03.40,0:24:04.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:05.15,0:24:07.52,Default,,0,0,0,,Гехогехо (Шинко) Бұл не?
Dialogue: 0,0:24:07.65,0:24:09.28,Default,,0,0,0,,Бірдеңе шықты (фотон) хаха~
Dialogue: 0,0:24:09.69,0:24:12.53,Default,,0,0,0,,Ықылық... о хахе га хитефу
Dialogue: 0,0:24:13.11,0:24:15.37,Default,,0,0,0,,О, хахе? (Шинко) Иә, бұл алкоголь.
Dialogue: 0,0:24:15.57,0:24:18.20,Default,,0,0,0,,Иә! Хмм!
Dialogue: 0,0:24:18.33,0:24:21.58,Default,,0,0,0,,Хахахаха Уау!
Dialogue: 0,0:24:21.71,0:24:25.17,Default,,0,0,0,,Денең өртеніп жатқан сияқты!
Dialogue: 0,0:24:25.25,0:24:27.71,Default,,0,0,0,,Мм, жалбыз суына ұқсайды.
Dialogue: 0,0:24:27.84,0:24:28.21,Default,,0,0,0,,Жақсы, кастор майы шығар.
Dialogue: 0,0:24:28.21,0:24:30.59,Default,,0,0,0,,Жақсы, кастор майы шығар.
Dialogue: 0,0:24:28.21,0:24:30.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:30.59,0:24:31.63,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:31.63,0:24:34.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:31.63,0:24:34.05,Default,,0,0,0,,Кастор майы... дәмді ме?
Dialogue: 0,0:24:34.05,0:24:34.26,Default,,0,0,0,,Кастор майы... дәмді ме?
Dialogue: 0,0:24:34.80,0:24:36.51,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:24:36.64,0:24:39.35,Default,,0,0,0,,Нәжіс шыққанда кастор майын атаңыз
Dialogue: 0,0:24:39.47,0:24:41.89,Default,,0,0,0,,Жиренішті, тезек шығады.
Dialogue: 0,0:24:42.02,0:24:43.64,Default,,0,0,0,,Дәмді! (Кико) Ықылық!
Dialogue: 0,0:24:44.60,0:24:46.19,Default,,0,0,0,,Мынау дәмді!
Dialogue: 0,0:24:46.31,0:24:48.32,Default,,0,0,0,,Бұл тәтті сусын.
Dialogue: 0,0:24:48.61,0:24:51.19,Default,,0,0,0,,Kyahahahahaha (Жаңа бала) Ахаха Аха~
Dialogue: 0,0:24:51.32,0:24:55.36,Default,,0,0,0,,Шоколад тәтті, бірақ алкоголь де тәтті Ахаха
Dialogue: 0,0:24:55.45,0:24:59.66,Default,,0,0,0,,(тұңғыш ызылдау)
Dialogue: 0,0:24:55.45,0:24:59.66,Default,,0,0,0,,(Синко мен Мицуконың күлкісі)
Dialogue: 0,0:24:59.78,0:25:03.96,Default,,0,0,0,,Менің анам журнал фото байқауында.
Dialogue: 0,0:25:04.08,0:25:07.21,Default,,0,0,0,,Жүлдеңізді жоғалтқан кезіңіз болды ма?
Dialogue: 0,0:25:07.33,0:25:10.50,Default,,0,0,0,,Тұрмысқа шығып, отбасым дүниеге келсе де...
Dialogue: 0,0:25:10.63,0:25:14.97,Default,,0,0,0,,Бойдақ екеніңді жазып, фотосын жібер... Ахаха...
Dialogue: 0,0:25:15.09,0:25:17.05,Default,,0,0,0,,Ха~а (Шинко) Ха
Dialogue: 0,0:25:17.18,0:25:20.01,Default,,0,0,0,,Хахаха хахахаха!
Dialogue: 0,0:25:20.14,0:25:22.06,Default,,0,0,0,,Ықылық
Dialogue: 0,0:25:22.35,0:25:24.85,Default,,0,0,0,,Әй, Киіко-танның анасы кім?
Dialogue: 0,0:25:24.98,0:25:27.31,Default,,0,0,0,,Ықылық! (Жаңа бала) Ммммммм
Dialogue: 0,0:25:27.44,0:25:30.82,Default,,0,0,0,,Ммммм аа
Dialogue: 0,0:25:30.94,0:25:32.69,Default,,0,0,0,,Хахаха хахаха
Dialogue: 0,0:25:32.82,0:25:35.99,Default,,0,0,0,,Менің анам қайтыс болды~
Dialogue: 0,0:25:36.11,0:25:38.53,Default,,0,0,0,,Ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха ха
Dialogue: 0,0:25:38.66,0:25:43.16,Default,,0,0,0,,Өкпемдегі судан өлдім!
Dialogue: 0,0:25:43.29,0:25:45.46,Default,,0,0,0,,Ха, бұл не? (Фото) Ахаха
Dialogue: 0,0:25:45.54,0:25:48.46,Default,,0,0,0,,Хм
Dialogue: 0,0:25:53.13,0:25:55.55,Default,,0,0,0,,Хм
Dialogue: 0,0:25:55.63,0:25:56.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:56.84,0:25:58.76,Default,,0,0,0,,Әке!
Dialogue: 0,0:25:58.89,0:26:01.05,Default,,0,0,0,,Хмм...
Dialogue: 0,0:26:01.39,0:26:03.06,Default,,0,0,0,,Анашым!
Dialogue: 0,0:26:03.85,0:26:05.06,Default,,0,0,0,,Фотон
Dialogue: 0,0:26:05.18,0:26:06.89,Default,,0,0,0,,Фотон!
Dialogue: 0,0:26:07.35,0:26:09.94,Default,,0,0,0,,Ах! Сен де жейсің!
Dialogue: 0,0:26:10.06,0:26:13.07,Default,,0,0,0,,Не істеуім керек... Ах!
Dialogue: 0,0:26:13.15,0:26:15.36,Default,,0,0,0,,Әке, бұл виски.
Dialogue: 0,0:26:15.49,0:26:17.74,Default,,0,0,0,,Бұл соңы ма? (үлкен бала) Ой-оу.
Dialogue: 0,0:26:17.86,0:26:20.16,Default,,0,0,0,,Тағы біреуі қалды...
Dialogue: 0,0:26:20.28,0:26:22.49,Default,,0,0,0,,Ах! Екі қалды (Котаро) Хамф.
Dialogue: 0,0:26:22.62,0:26:25.91,Default,,0,0,0,,Сәлем? Сен қай жақтансын?
Dialogue: 0,0:26:26.04,0:26:29.50,Default,,0,0,0,,Бұл Киико Шимазу.
Dialogue: 0,0:26:29.62,0:26:33.38,Default,,0,0,0,,Мен сол жақтағы компанияның үйінен келдім~
Dialogue: 0,0:26:33.50,0:26:35.88,Default,,0,0,0,,ех хе хе хе хе хе хе хе хе хе хе хе хе
Dialogue: 0,0:26:36.01,0:26:38.38,Default,,0,0,0,,(Тұңғыш пен Хатсудың күрсінуі)
Dialogue: 0,0:26:38.51,0:26:39.76,Default,,0,0,0,,Жоқ
Dialogue: 0,0:26:42.30,0:26:44.26,Default,,0,0,0,,шөлдеген
Dialogue: 0,0:26:44.39,0:26:45.93,Default,,0,0,0,,Иә
Dialogue: 0,0:26:46.52,0:26:47.56,Default,,0,0,0,,Эй—
Dialogue: 0,0:26:47.68,0:26:50.98,Default,,0,0,0,,Бұл ештеңеге орын емес.
Dialogue: 0,0:26:51.10,0:26:52.27,Default,,0,0,0,,Иә...
Dialogue: 0,0:26:52.52,0:26:55.57,Default,,0,0,0,,Өйткені Шинко-чан осында... Ықылық
Dialogue: 0,0:26:55.69,0:26:58.28,Default,,0,0,0,,Хехе, олай етпе.
Dialogue: 0,0:26:58.82,0:27:01.32,Default,,0,0,0,,Иә! Судың орнына (Kiiko) Ықылық
Dialogue: 0,0:27:01.61,0:27:02.91,Default,,0,0,0,,Хмм?
Dialogue: 0,0:27:03.45,0:27:04.83,Default,,0,0,0,,Хмм?
Dialogue: 0,0:27:05.62,0:27:06.79,Default,,0,0,0,,Хмм?
Dialogue: 0,0:27:08.20,0:27:10.04,Default,,0,0,0,,Мен осылай көзімді жұмғанда...
Dialogue: 0,0:27:10.17,0:27:13.34,Default,,0,0,0,,Май-майым осылай ызылдады...
Dialogue: 0,0:27:13.46,0:27:15.46,Default,,0,0,0,,«Маймай» деген не?
Dialogue: 0,0:27:15.59,0:27:17.17,Default,,0,0,0,,Ууух!
Dialogue: 0,0:27:17.30,0:27:18.59,Default,,0,0,0,,мұнда
Dialogue: 0,0:27:18.72,0:27:21.30,Default,,0,0,0,,Менің басымның төбесі мен еститін жалғыз нәрсе.
Dialogue: 0,0:27:21.43,0:27:23.18,Default,,0,0,0,,Мұнда да май-май бар.
Dialogue: 0,0:27:23.30,0:27:25.81,Default,,0,0,0,,О, Цумужика?
Dialogue: 0,0:27:26.22,0:27:29.52,Default,,0,0,0,,Жоқ, олай емес.
Dialogue: 0,0:27:30.23,0:27:33.61,Default,,0,0,0,,Неге екенін білмеймін, тек бізде туғаннан бар.
Dialogue: 0,0:27:33.73,0:27:36.27,Default,,0,0,0,,Міне, мына жердегі шаштар былай болып кетті...
Dialogue: 0,0:27:36.40,0:27:37.94,Default,,0,0,0,,А, бұл біртүрлі!
Dialogue: 0,0:27:38.07,0:27:39.65,Default,,0,0,0,,Бұлай болмағанын қалаймын.
Dialogue: 0,0:27:40.20,0:27:44.12,Default,,0,0,0,,Бірақ, бұл май-май, кейде осылай...
Dialogue: 0,0:27:44.24,0:27:47.04,Default,,0,0,0,,Менде шаншып қалатын кездер болады.
Dialogue: 0,0:27:48.75,0:27:51.75,Default,,0,0,0,,Мына бидай алқабы ештеңеге ұқсамайды
Dialogue: 0,0:27:51.87,0:27:54.58,Default,,0,0,0,,Бұл жерде мың жылдық құпия бар.
Dialogue: 0,0:27:54.71,0:27:57.67,Default,,0,0,0,,Мың жылдық… құпиясы?
Dialogue: 0,0:27:57.80,0:27:59.71,Default,,0,0,0,,Иә, мың жыл
Dialogue: 0,0:27:59.84,0:28:02.01,Default,,0,0,0,,Уф! Сондай ащы
Dialogue: 0,0:28:02.13,0:28:03.30,Default,,0,0,0,,Сіз ояусыз ба? (Кико) Иә?
Dialogue: 0,0:28:03.43,0:28:04.80,Default,,0,0,0,,Сіз маған қаншалықты жалқау екеніңізді көрсетіп жатырсыз.
Dialogue: 0,0:28:05.30,0:28:08.60,Default,,0,0,0,,Міне! (Кико) А, сәл күте тұрыңыз.
Dialogue: 0,0:28:08.68,0:28:10.23,Default,,0,0,0,,мұнда
Dialogue: 0,0:28:10.48,0:28:11.89,Default,,0,0,0,,«Аздап жұмсауға да болар...» деп ойладым.
Dialogue: 0,0:28:12.02,0:28:16.11,Default,,0,0,0,,Көрдіңіз бе, бұл жол осында мың жыл болды.
Dialogue: 0,0:28:16.23,0:28:17.77,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:28:18.27,0:28:20.74,Default,,0,0,0,,Міне, осылай! (Кико) О, күте тұрыңыз.
Dialogue: 0,0:28:21.11,0:28:23.91,Default,,0,0,0,,Мың жыл бұрын... Әй, бұл қандай болды?
Dialogue: 0,0:28:24.03,0:28:25.95,Default,,0,0,0,,Сиыр көлікті тартып алды.
Dialogue: 0,0:28:26.07,0:28:26.49,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:28:26.49,0:28:27.24,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:28:26.49,0:28:27.24,Default,,0,0,0,,(Сиырдың улауы)
Dialogue: 0,0:28:27.24,0:28:27.53,Default,,0,0,0,,(Сиырдың улауы)
Dialogue: 0,0:28:27.53,0:28:28.95,Default,,0,0,0,,(Сиырдың улауы)
Dialogue: 0,0:28:27.53,0:28:28.95,Default,,0,0,0,,А, қараңдаршы
Dialogue: 0,0:28:29.58,0:28:31.00,Default,,0,0,0,,келді
Dialogue: 0,0:28:31.12,0:28:32.46,Default,,0,0,0,,Э~?
Dialogue: 0,0:28:32.75,0:28:34.37,Default,,0,0,0,,Әй, соқтығыс, соқтығыс! Хехе
Dialogue: 0,0:28:34.50,0:28:36.67,Default,,0,0,0,,Қауіпті, қауіпті Ахахха
Dialogue: 0,0:28:37.29,0:28:39.80,Default,,0,0,0,,Хмм? (Шинко) Ой, қарағым, Киико да.
Dialogue: 0,0:28:39.88,0:28:41.42,Default,,0,0,0,,Уф, у... (Шинко) Жалтар, қаш!
Dialogue: 0,0:28:41.55,0:28:43.80,Default,,0,0,0,,Иә! ? Ааа...
Dialogue: 0,0:28:43.88,0:28:46.34,Default,,0,0,0,,Хахаха аха!
Dialogue: 0,0:28:46.47,0:28:47.30,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:47.64,0:28:50.01,Default,,0,0,0,,Хахаха! Хаха! (Шинко) Уфуфун хаха!
Dialogue: 0,0:28:50.10,0:28:53.89,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:29:05.49,0:29:06.57,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:29:11.45,0:29:12.79,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:29:13.25,0:29:16.54,Default,,0,0,0,,Кел... менің орныма да...
Dialogue: 0,0:29:18.00,0:29:19.54,Default,,0,0,0,,Сонымен қатар, Алл Майт мені қазірдің өзінде бақылап отыр—
Dialogue: 0,0:29:27.72,0:29:29.80,Default,,0,0,0,,Ахахахахаха
Dialogue: 0,0:29:29.93,0:29:32.56,Default,,0,0,0,,Хехехе хаха
Dialogue: 0,0:29:32.68,0:29:33.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:29:37.65,0:29:38.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:42.32,0:29:44.74,Default,,0,0,0,,Ой! Бұл өзен болды, сондықтан сақ болыңыз.
Dialogue: 0,0:29:44.86,0:29:46.57,Default,,0,0,0,,Өзен! ? Ахаха
Dialogue: 0,0:29:46.65,0:29:49.45,Default,,0,0,0,,♪Мың жыл бұрынғы темір ұстасы
Dialogue: 0,0:29:49.57,0:29:51.95,Default,,0,0,0,,♪Тонтенкан Тонтенкан
Dialogue: 0,0:29:52.08,0:29:54.66,Default,,0,0,0,,♪Тонтенкан Тонтенкан
Dialogue: 0,0:29:54.79,0:29:57.58,Default,,0,0,0,,♪Тонтенкан Тонтенкан
Dialogue: 0,0:29:57.67,0:30:00.59,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:30:10.09,0:30:11.64,Default,,0,0,0,,Не істеді?
Dialogue: 0,0:30:11.72,0:30:13.93,Default,,0,0,0,,(Шинко мен Киконың күлкісі)
Dialogue: 0,0:30:16.27,0:30:18.60,Default,,0,0,0,,Жүр, тезірек.
Dialogue: 0,0:30:22.23,0:30:23.07,Default,,0,0,0,,Иә
Dialogue: 0,0:30:25.03,0:30:27.57,Default,,0,0,0,,Ах! Хе, міне қара.
Dialogue: 0,0:30:28.11,0:30:31.07,Default,,0,0,0,,«Бұл мың жыл бұрын елдің астанасы болған».
Dialogue: 0,0:30:31.16,0:30:32.08,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:30:32.20,0:30:33.70,Default,,0,0,0,,Атам осылай деді.
Dialogue: 0,0:30:37.87,0:30:39.21,Default,,0,0,0,,Міне, қараңдаршы!
Dialogue: 0,0:30:39.71,0:30:42.21,Default,,0,0,0,,Бұл әлі де Кокуга аялдамасы.
Dialogue: 0,0:30:42.29,0:30:44.71,Default,,0,0,0,,Бұл рас! Фуфу (Шинко) Қараңдар!
Dialogue: 0,0:30:46.21,0:30:47.72,Default,,0,0,0,,Қараңдар, өзен!
Dialogue: 0,0:30:47.80,0:30:49.26,Default,,0,0,0,,Мың жыл болды!
Dialogue: 0,0:30:49.26,0:30:50.09,Default,,0,0,0,,Мың жыл болды!
Dialogue: 0,0:30:49.26,0:30:50.09,Default,,0,0,0,,(судың шашырауы)
Dialogue: 0,0:30:50.09,0:30:50.22,Default,,0,0,0,,(судың шашырауының дыбысы)
Dialogue: 0,0:30:50.22,0:30:52.14,Default,,0,0,0,,(судың шашырауының дыбысы)
Dialogue: 0,0:30:50.22,0:30:52.14,Default,,0,0,0,,Ах! Хаха
Dialogue: 0,0:30:57.64,0:30:59.23,Default,,0,0,0,,Хаха хехехе
Dialogue: 0,0:31:01.94,0:31:04.23,Default,,0,0,0,,Хехе, мен жеңілмеймін.
Dialogue: 0,0:31:04.65,0:31:05.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:31:06.57,0:31:08.24,Default,,0,0,0,,Бұл да тік бұрышты иілу.
Dialogue: 0,0:31:08.36,0:31:10.11,Default,,0,0,0,,Мұнда да бір нәрсе салынған.
Dialogue: 0,0:31:10.24,0:31:11.24,Default,,0,0,0,,Ол салынды ма?
Dialogue: 0,0:31:11.36,0:31:13.83,Default,,0,0,0,,Бұл үлкен. Бұл сарай ма?
Dialogue: 0,0:31:13.95,0:31:15.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:31:19.87,0:31:21.79,Default,,0,0,0,,Уау~
Dialogue: 0,0:31:23.33,0:31:25.25,Default,,0,0,0,,Ум!
Dialogue: 0,0:31:25.63,0:31:28.97,Default,,0,0,0,,Не істеп жатырсың?! ?
Dialogue: 0,0:31:29.42,0:31:31.84,Default,,0,0,0,,О, мен оны қазып жатырмын.
Dialogue: 0,0:31:31.97,0:31:34.72,Default,,0,0,0,,Ескі ғимараттардың қирандылары
Dialogue: 0,0:31:34.85,0:31:36.93,Default,,0,0,0,,Қандай ғимарат! ?
Dialogue: 0,0:31:37.47,0:31:40.60,Default,,0,0,0,,Ах, бұл жерде Суо-но-ками деп аталады.
Dialogue: 0,0:31:40.73,0:31:43.94,Default,,0,0,0,,Ең ұлы адамның сарайы болуы мүмкін.
Dialogue: 0,0:31:44.44,0:31:46.82,Default,,0,0,0,,Шинко-чан айтқандай.
Dialogue: 0,0:31:47.07,0:31:50.45,Default,,0,0,0,,Сәлем! Қуыршақтар да болған жоқ! ?
Dialogue: 0,0:31:50.78,0:31:53.32,Default,,0,0,0,,Не? Қуыршақ?
Dialogue: 0,0:31:53.45,0:31:56.24,Default,,0,0,0,,Мың жыл бұрын қандай қуыршақ болды?
Dialogue: 0,0:31:56.37,0:31:59.20,Default,,0,0,0,,Өйткені, ол Кеупиге ұқсайды! ?
Dialogue: 0,0:31:59.58,0:32:02.67,Default,,0,0,0,,Қуыршақтар... бұл мүмкін емес.
Dialogue: 0,0:32:02.79,0:32:06.25,Default,,0,0,0,,Ондай жұмсақ заттар топырақта қалмайды.
Dialogue: 0,0:32:06.42,0:32:07.96,Default,,0,0,0,,Эй, не?
Dialogue: 0,0:32:08.05,0:32:09.42,Default,,0,0,0,,Иә? Нфуфу
Dialogue: 0,0:32:09.55,0:32:11.67,Default,,0,0,0,,Дұрыс, иә.
Dialogue: 0,0:32:11.80,0:32:14.14,Default,,0,0,0,,Онда бір қыз тұратын шығар!
Dialogue: 0,0:32:14.26,0:32:17.06,Default,,0,0,0,,Шамамен сізбен бір жаста.
Dialogue: 0,0:32:17.18,0:32:18.35,Default,,0,0,0,,Шынымен...?
Dialogue: 0,0:32:18.60,0:32:21.02,Default,,0,0,0,,Хэхе хахахаха
Dialogue: 0,0:32:21.14,0:32:27.15,Default,,0,0,0,,♪～
Dialogue: 0,0:33:04.10,0:33:08.77,Default,,0,0,0,,Ай!
Dialogue: 0,0:33:08.86,0:33:13.90,Default,,0,0,0,,Eho Eho Eho Eho Eho
Dialogue: 0,0:33:17.20,0:33:19.87,Default,,0,0,0,,Уау, сен сондай батылсың.
Dialogue: 0,0:33:19.99,0:33:23.08,Default,,0,0,0,,Комацухики балаларды қорғау күнінде осы аймақта
Dialogue: 0,0:33:24.08,0:33:28.46,Default,,0,0,0,,Қарағайда мың жылдың рухы мекендейді дейді.
Dialogue: 0,0:33:28.58,0:33:31.50,Default,,0,0,0,,Мен де биыл жастамын.
Dialogue: 0,0:33:31.63,0:33:35.59,Default,,0,0,0,,Мен сені қашанға дейін бақылай аламын?
Dialogue: 0,0:33:38.76,0:33:40.22,Default,,0,0,0,,Бұрынғы ғалым
Dialogue: 0,0:33:40.35,0:33:44.35,Default,,0,0,0,,Сіз Кацума храмының арғы жағында теңіз болғанын айттыңыз.
Dialogue: 0,0:33:44.48,0:33:46.14,Default,,0,0,0,,Мың жыл бұрын
Dialogue: 0,0:33:46.39,0:33:47.94,Default,,0,0,0,,Полигон
Dialogue: 0,0:33:49.11,0:33:51.32,Default,,0,0,0,,Сіз Kiiko компаниясының тұрғын үйін көре аласыз.
Dialogue: 0,0:33:51.69,0:33:52.53,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:33:53.03,0:33:55.11,Default,,0,0,0,,Мен теңіздемін!
Dialogue: 0,0:33:55.24,0:33:57.91,Default,,0,0,0,,Заббун Заббун (Киико) Фуфуфу
Dialogue: 0,0:33:58.41,0:34:01.20,Default,,0,0,0,,Заббун Заббун
Dialogue: 0,0:34:01.33,0:34:02.87,Default,,0,0,0,,Хехехе
Dialogue: 0,0:34:03.12,0:34:05.37,Default,,0,0,0,,Әй, ол қандай қыз? (Шинко) А?
Dialogue: 0,0:34:05.50,0:34:07.79,Default,,0,0,0,,Мың жыл бұрынғы қыз (Шинко) Фуун
Dialogue: 0,0:34:08.46,0:34:09.79,Default,,0,0,0,,Хмм.
Dialogue: 0,0:34:09.92,0:34:12.00,Default,,0,0,0,,Бір минут күтіңіз~
Dialogue: 0,0:34:12.13,0:34:15.80,Default,,0,0,0,,Аа, күте тұрыңыз, мен оны өзім сынап көргім келеді.
Dialogue: 0,0:34:15.92,0:34:17.22,Default,,0,0,0,,Иә
Dialogue: 0,0:34:17.63,0:34:19.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:34:19.93,0:34:22.10,Default,,0,0,0,,Күтіңіз... Күтіңіз.
Dialogue: 0,0:34:22.22,0:34:23.81,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:34:24.22,0:34:25.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:34:26.31,0:34:28.02,Default,,0,0,0,,Ах... Эхехехе
Dialogue: 0,0:34:28.14,0:34:31.27,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:34:31.40,0:34:32.61,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:34:33.02,0:34:34.53,Default,,0,0,0,,Сен болсаң жақсы болар еді.
Dialogue: 0,0:34:34.65,0:34:35.86,Default,,0,0,0,,Бала сонымен бірге...
Dialogue: 0,0:34:36.44,0:34:38.90,Default,,0,0,0,,Синко-чан сияқты достар...
Dialogue: 0,0:34:39.03,0:34:40.74,Default,,0,0,0,,Бетінде бір атмосфера.
Dialogue: 0,0:34:42.70,0:34:44.41,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:34:44.54,0:34:48.71,Default,,0,0,0,,Ханшайым әр күнін жалғыз өткізе ме?
Dialogue: 0,0:34:49.42,0:34:51.83,Default,,0,0,0,,Өйткені егер сіз Суоға келсе...
Dialogue: 0,0:34:51.96,0:34:54.84,Default,,0,0,0,,Себебі мені жасы шамалы қыз күтіп тұр...
Dialogue: 0,0:34:55.09,0:34:57.22,Default,,0,0,0,,Мен естідім (Татара) А?
Dialogue: 0,0:34:57.63,0:35:00.72,Default,,0,0,0,,Бірақ қанша күн күтсем де ол қонаққа келмейді.
Dialogue: 0,0:35:01.22,0:35:04.64,Default,,0,0,0,,Менімен ойнауға астанадан Хина қуыршақ келді...
Dialogue: 0,0:35:04.76,0:35:06.72,Default,,0,0,0,,Мен көп жиһаз әкелсем де.
Dialogue: 0,0:35:07.23,0:35:08.06,Default,,0,0,0,,Хмм?
Dialogue: 0,0:35:08.18,0:35:11.77,Default,,0,0,0,,Әдемі қағазды қиып, кимоно жаса...
Dialogue: 0,0:35:11.90,0:35:13.61,Default,,0,0,0,,Ханшайым...
Dialogue: 0,0:35:13.73,0:35:18.36,Default,,0,0,0,,Ханшайыммен құрдас қызды дайындап, күтіп отырғанбыз...
Dialogue: 0,0:35:18.53,0:35:21.24,Default,,0,0,0,,Шынайы бол
Dialogue: 0,0:35:21.74,0:35:27.70,Default,,0,0,0,,Алайда мен адам өмірін шынымен түсінбеймін.
Dialogue: 0,0:35:27.83,0:35:28.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:35:29.29,0:35:30.67,Default,,0,0,0,,Менің ұлым мен ұлым да...
Dialogue: 0,0:35:30.79,0:35:34.71,Default,,0,0,0,,Ол менің сүйікті әпкем болатын.
Dialogue: 0,0:35:36.55,0:35:39.92,Default,,0,0,0,,Ханшайым бұл жерді басқа ештеңе емес деп ойласа да...
Dialogue: 0,0:35:40.05,0:35:43.14,Default,,0,0,0,,Біз үшін олай емес.
Dialogue: 0,0:35:43.85,0:35:48.22,Default,,0,0,0,,Біздің ата-бабаларымыз мұнда мұхиттың арғы жағынан келген.
Dialogue: 0,0:35:49.18,0:35:53.52,Default,,0,0,0,,Біз кәсібі темірді құрайтын халықпыз.
Dialogue: 0,0:35:53.65,0:35:55.52,Default,,0,0,0,,Ең жақсы темір -
Dialogue: 0,0:35:55.65,0:35:58.94,Default,,0,0,0,,Түнгі аспаннан түскен жұлдыздардан алынған
Dialogue: 0,0:35:59.69,0:36:04.28,Default,,0,0,0,,Біздің ата-бабаларымыз аққан жұлдыздарды қуып, осында келген...
Dialogue: 0,0:36:04.41,0:36:06.58,Default,,0,0,0,,Ауыл ашты
Dialogue: 0,0:36:07.58,0:36:09.45,Default,,0,0,0,,бастап жүздеген жылдар
Dialogue: 0,0:36:09.62,0:36:13.08,Default,,0,0,0,,Біз осы жерде темір жасауды жалғастырамыз.
Dialogue: 0,0:36:14.33,0:36:16.04,Default,,0,0,0,,Қазірдің өзінде жерді қазғанда...
Dialogue: 0,0:36:16.17,0:36:19.34,Default,,0,0,0,,Ата-бабаларымыз темір құйған татараның қалдықтары...
Dialogue: 0,0:36:19.46,0:36:20.76,Default,,0,0,0,,Көбісі шығады.
Dialogue: 0,0:36:21.34,0:36:22.68,Default,,0,0,0,,Жүздеген жылдар?
Dialogue: 0,0:36:22.88,0:36:24.76,Default,,0,0,0,,Жүздеген жылдар
Dialogue: 0,0:36:24.89,0:36:25.89,Default,,0,0,0,,Жарайды
Dialogue: 0,0:36:25.97,0:36:29.43,Default,,0,0,0,,Суо Нару Катсума Умая деген жерде...
Dialogue: 0,0:36:29.52,0:36:31.98,Default,,0,0,0,,Балаларды қорғау күні: Поэзия
Dialogue: 0,0:36:32.10,0:36:32.94,Default,,0,0,0,,Хмм
Dialogue: 0,0:36:33.85,0:36:37.82,Default,,0,0,0,,Ойлан
Dialogue: 0,0:36:38.32,0:36:40.44,Default,,0,0,0,,Мыңжылдық көктемі
Dialogue: 0,0:36:40.99,0:36:43.65,Default,,0,0,0,,Пер Кефу
Dialogue: 0,0:36:44.53,0:36:48.49,Default,,0,0,0,,Катсума жоқ Ура
Dialogue: 0,0:36:48.62,0:36:49.62,Default,,0,0,0,,Мың жыл өтсе де өсетін қарағай
Dialogue: 0,0:36:49.62,0:36:51.29,Default,,0,0,0,,Мың жыл өтсе де өсетін қарағай
Dialogue: 0,0:36:49.62,0:36:51.29,Default,,0,0,0,,Жағадағы Химематсу
Dialogue: 0,0:36:51.29,0:36:51.45,Default,,0,0,0,,Жағадағы Химематсу
Dialogue: 0,0:36:51.45,0:36:52.46,Default,,0,0,0,,Жағадағы Химематсу
Dialogue: 0,0:36:51.45,0:36:52.46,Default,,0,0,0,,Осы сағыныш күнді мәңгі есте сақтаңыз.
Dialogue: 0,0:36:52.46,0:36:55.92,Default,,0,0,0,,Осы сағыныш күнді мәңгі есте сақтаңыз.
Dialogue: 0,0:36:56.46,0:36:58.67,Default,,0,0,0,,Ертеде адамдар болған
Dialogue: 0,0:36:58.79,0:37:01.96,Default,,0,0,0,,Мың жылдан кейін әлі біреу болады
Dialogue: 0,0:37:02.09,0:37:03.97,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:37:04.26,0:37:06.68,Default,,0,0,0,,Хмм... жоқ...
Dialogue: 0,0:37:06.80,0:37:09.68,Default,,0,0,0,,Жоқ... бұл жақсы емес.
Dialogue: 0,0:37:09.81,0:37:13.98,Default,,0,0,0,,Оның қандай қыз болғанын білмеймін.
Dialogue: 0,0:37:14.77,0:37:18.40,Default,,0,0,0,,Май-майсыз жақсы емес шығар...
Dialogue: 0,0:37:30.33,0:37:34.16,Default,,0,0,0,,А-а... Менің анам қандай адам еді деп ойлаймын...
Dialogue: 0,0:37:34.29,0:37:36.33,Default,,0,0,0,,Мен енді есімде жоқ
Dialogue: 0,0:37:38.29,0:37:41.13,Default,,0,0,0,,Мен туылғанға дейінгі анам
Dialogue: 0,0:37:42.21,0:37:45.47,Default,,0,0,0,,Ах~ мен де қалаймын, май май
Dialogue: 0,0:37:45.93,0:37:46.97,Default,,0,0,0,,(Юки) Қыз ба? (Миямура) Ұл ба?
Dialogue: 0,0:37:53.39,0:37:54.43,Default,,0,0,0,,Хмм
Dialogue: 0,0:37:55.31,0:37:57.48,Default,,0,0,0,,Эй~ (Қыздар) Уау!
Dialogue: 0,0:37:57.73,0:38:00.27,Default,,0,0,0,,Киико саған жақсы көрінеді.
Dialogue: 0,0:38:01.07,0:38:02.78,Default,,0,0,0,,Бум! (Бала) Ия!
Dialogue: 0,0:38:02.86,0:38:05.82,Default,,0,0,0,,Қашып құтыла алмадың, иә? Өте жылдам әрі өте күшті еді — тіпті көре де алмадың, иә?
Dialogue: 0,0:38:14.79,0:38:17.21,Default,,0,0,0,,Уф! (Балалар) Уау!
Dialogue: 0,0:38:18.37,0:38:21.04,Default,,0,0,0,,Киико! Құлақ құлақ! (Кико) Иә?
Dialogue: 0,0:38:21.21,0:38:22.55,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:38:24.13,0:38:26.97,Default,,0,0,0,,Уау! Ахаха
Dialogue: 0,0:38:27.05,0:38:29.34,Default,,0,0,0,,Ахаха ахахха!
Dialogue: 0,0:38:34.14,0:38:36.23,Default,,0,0,0,,Бум, сіз білмедіңіз бе?
Dialogue: 0,0:38:36.35,0:38:37.81,Default,,0,0,0,,Киико
Dialogue: 0,0:38:38.14,0:38:39.31,Default,,0,0,0,,Иә...
Dialogue: 0,0:38:39.44,0:38:41.90,Default,,0,0,0,,Тас, қағаз, қайшы, т.б.
Dialogue: 0,0:38:42.02,0:38:45.03,Default,,0,0,0,,Гррр! Нхухуху
Dialogue: 0,0:38:45.11,0:38:46.90,Default,,0,0,0,,Ах, Шигеру.
Dialogue: 0,0:38:47.03,0:38:48.78,Default,,0,0,0,,5-сынып Хитоши де солай.
Dialogue: 0,0:38:49.70,0:38:51.91,Default,,0,0,0,,Анау тұт алқабында не істеп жүрсің...
Dialogue: 0,0:38:52.91,0:38:55.37,Default,,0,0,0,,Хахаха... Ахахха
Dialogue: 0,0:39:01.21,0:39:02.88,Default,,0,0,0,,Хехехе
Dialogue: 0,0:39:03.25,0:39:05.34,Default,,0,0,0,,Сәлем! Сіз не істемексіз?
Dialogue: 0,0:39:05.42,0:39:07.01,Default,,0,0,0,,Уау! Апыр-ай...!
Dialogue: 0,0:39:07.13,0:39:10.68,Default,,0,0,0,,Жарайсың, Шигеру Шинко.
Dialogue: 0,0:39:11.64,0:39:12.68,Default,,0,0,0,,Сіз не істедіңіз?
Dialogue: 0,0:39:12.80,0:39:14.76,Default,,0,0,0,,О, бөгет жоқ
Dialogue: 0,0:39:14.89,0:39:15.93,Default,,0,0,0,,Дамкаа
Dialogue: 0,0:39:16.02,0:39:17.81,Default,,0,0,0,,Кеттік! Міне!
Dialogue: 0,0:39:18.06,0:39:19.81,Default,,0,0,0,,Уау! Ахаха!
Dialogue: 0,0:39:20.19,0:39:21.44,Default,,0,0,0,,Міне, тағы барамыз! (Шигеру Шинко) Уау
Dialogue: 0,0:39:21.56,0:39:23.94,Default,,0,0,0,,Міне! (Шигеру Шинко) Уау!
Dialogue: 0,0:39:24.07,0:39:25.44,Default,,0,0,0,,Ахаха! Апыр-ай!
Dialogue: 0,0:39:25.52,0:39:27.07,Default,,0,0,0,,Жарайды, онда... болды!
Dialogue: 0,0:39:27.15,0:39:28.44,Default,,0,0,0,,Уау!
Dialogue: 0,0:39:28.57,0:39:30.40,Default,,0,0,0,,Қарашы, Киико да (Киико) Иә?
Dialogue: 0,0:39:30.49,0:39:32.99,Default,,0,0,0,,Уау, ой, кеттік!
Dialogue: 0,0:39:33.12,0:39:34.99,Default,,0,0,0,,Уау! Ахаха!
Dialogue: 0,0:39:35.12,0:39:37.08,Default,,0,0,0,,Ах! Уау луч
Dialogue: 0,0:39:37.20,0:39:38.75,Default,,0,0,0,,Ах (Кико) Иә?
Dialogue: 0,0:39:39.00,0:39:40.25,Default,,0,0,0,,Ой-ау
Dialogue: 0,0:39:40.33,0:39:43.25,Default,,0,0,0,,Ой... (Кико) Уф~ Уф
Dialogue: 0,0:39:44.67,0:39:47.21,Default,,0,0,0,,(көңілді дауыс)
Dialogue: 0,0:39:48.26,0:39:49.97,Default,,0,0,0,,Әй, сен не істейсің?
Dialogue: 0,0:39:50.42,0:39:51.38,Default,,0,0,0,,Дамба!
Dialogue: 0,0:39:51.51,0:39:53.47,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:39:54.01,0:39:56.26,Default,,0,0,0,,Жарайды, тақтаны табыңыз~
Dialogue: 0,0:39:56.39,0:39:57.43,Default,,0,0,0,,Жалғастырыңыз!
Dialogue: 0,0:39:57.56,0:39:59.48,Default,,0,0,0,,Эй, сен кімсің? Бұл
Dialogue: 0,0:39:59.60,0:40:01.14,Default,,0,0,0,,Мицуру 6-сынып
Dialogue: 0,0:40:01.27,0:40:03.23,Default,,0,0,0,,Хехе, мен мұндай нәрсені жақсы көремін.
Dialogue: 0,0:40:03.35,0:40:04.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:06.44,0:40:09.11,Default,,0,0,0,,Ааа... ой...
Dialogue: 0,0:40:09.24,0:40:11.90,Default,,0,0,0,,Ах... Тацуоши Ум...
Dialogue: 0,0:40:13.45,0:40:14.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:40:14.57,0:40:17.08,Default,,0,0,0,,Тацюоши, сен білесің...
Dialogue: 0,0:40:17.16,0:40:19.25,Default,,0,0,0,,Мен оны саған апарып беремін, сондықтан сәл күте тұр.
Dialogue: 0,0:40:19.37,0:40:20.91,Default,,0,0,0,,Маған көмектесіңізші.
Dialogue: 0,0:40:24.25,0:40:25.63,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:28.21,0:40:33.34,Default,,0,0,0,,(Хитошидің гуілдеуі)
Dialogue: 0,0:40:33.97,0:40:35.80,Default,,0,0,0,,(Балалардың жаңа күш айқайы)
Dialogue: 0,0:40:35.89,0:40:38.89,Default,,0,0,0,,Йон, йон, йон! (Кико) Хмм!
Dialogue: 0,0:40:38.97,0:40:41.18,Default,,0,0,0,,Иә! иә!
Dialogue: 0,0:40:41.31,0:40:44.48,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммм! иә?
Dialogue: 0,0:40:44.77,0:40:48.57,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,0:40:49.40,0:40:51.36,Default,,0,0,0,,Шинко-чан, сен не істеп жатырсың?
Dialogue: 0,0:40:51.49,0:40:53.57,Default,,0,0,0,,Арал! (Кико) О
Dialogue: 0,0:40:53.70,0:40:54.78,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:57.12,0:40:58.78,Default,,0,0,0,,Тацуйоши…
Dialogue: 0,0:41:01.91,0:41:03.25,Default,,0,0,0,,Хмм... Иә!
Dialogue: 0,0:41:03.37,0:41:04.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:41:04.83,0:41:06.17,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:41:07.04,0:41:08.88,Default,,0,0,0,,Міне! (Шигеру/Шинко) Иә!
Dialogue: 0,0:41:13.76,0:41:15.72,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:41:15.84,0:41:19.05,Default,,0,0,0,,Мынадай үлкен тоған... дайын.
Dialogue: 0,0:41:19.76,0:41:23.18,Default,,0,0,0,,Тезірек, мен суға шыдамаймын.
Dialogue: 0,0:41:27.52,0:41:28.77,Default,,0,0,0,,Мм... солай ма?
Dialogue: 0,0:41:28.90,0:41:30.44,Default,,0,0,0,,Иә? (Кико) Ах.
Dialogue: 0,0:41:30.52,0:41:31.90,Default,,0,0,0,,Өткен күні...
Dialogue: 0,0:41:32.19,0:41:33.28,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:41:33.40,0:41:35.03,Default,,0,0,0,,Не? (Жаңа бала) Хаха
Dialogue: 0,0:41:35.45,0:41:37.24,Default,,0,0,0,,Ах... аа (Шинко) хехехе
Dialogue: 0,0:41:37.36,0:41:40.45,Default,,0,0,0,,Осы судың бәрі бірден ағып кетсе...
Dialogue: 0,0:41:40.58,0:41:42.58,Default,,0,0,0,,Бұл жақсы сезінеді
Dialogue: 0,0:41:42.70,0:41:44.58,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:41:44.71,0:41:46.75,Default,,0,0,0,,Бұл біраз ысырап.
Dialogue: 0,0:41:46.87,0:41:48.29,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:41:48.42,0:41:49.96,Default,,0,0,0,,Өйткені біз күш біріктірдік
Dialogue: 0,0:41:50.46,0:41:52.84,Default,,0,0,0,,Бірақ оны қатты орындайық.
Dialogue: 0,0:41:52.96,0:41:54.63,Default,,0,0,0,,Мұны соққымен жасаңыз!
Dialogue: 0,0:41:54.76,0:41:56.18,Default,,0,0,0,,Жасайық! Қанекей мынаны істейік!
Dialogue: 0,0:41:56.30,0:41:57.26,Default,,0,0,0,,Хехе
Dialogue: 0,0:41:57.38,0:41:58.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:00.68,0:42:02.14,Default,,0,0,0,,Қызыл...
Dialogue: 0,0:42:02.26,0:42:03.14,Default,,0,0,0,,Жалпы алғанда, сол хабар тарату мұнарасынан өткеннен кейін сигнал әдетте жақсы болады
Dialogue: 0,0:42:09.48,0:42:10.94,Default,,0,0,0,,Алтын балық?
Dialogue: 0,0:42:11.73,0:42:15.65,Default,,0,0,0,,Әй, тұт алқабының сылдырлаған дыбысы
Dialogue: 0,0:42:15.78,0:42:19.16,Default,,0,0,0,,Бұл мың жыл бұрын мөлдір өзен еді...
Dialogue: 0,0:42:19.28,0:42:23.54,Default,,0,0,0,,Бұл қайық тұрған қарағай.
Dialogue: 0,0:42:23.66,0:42:25.41,Default,,0,0,0,,Тек осы екі қарапайым белгіні есте сақта.
Dialogue: 0,0:42:26.00,0:42:30.92,Default,,0,0,0,,Бірақ мың жыл бұрынғы қыздарға келгенде... Мен түсінбеймін.
Dialogue: 0,0:42:31.54,0:42:34.51,Default,,0,0,0,,Бұл бала «Нагико-чан» ма?
Dialogue: 0,0:42:34.63,0:42:35.55,Default,,0,0,0,,Иә
Dialogue: 0,0:42:35.97,0:42:38.80,Default,,0,0,0,,Бұл кітаптың аты осындай болуы мүмкін...
Dialogue: 0,0:42:38.93,0:42:40.55,Default,,0,0,0,,Я~
Dialogue: 0,0:42:40.68,0:42:43.06,Default,,0,0,0,,Менің әкем уақа ақын... бірақ...
Dialogue: 0,0:42:43.56,0:42:46.60,Default,,0,0,0,,Суо но Ками болды және Киотодан келді.
Dialogue: 0,0:42:46.73,0:42:49.69,Default,,0,0,0,,Сіздің қызыңыз да сізбен бірге келгеніне сенімдімін.
Dialogue: 0,0:42:50.35,0:42:54.02,Default,,0,0,0,,Осы Кокугада мың жыл бұрын болған қыз...
Dialogue: 0,0:42:54.11,0:42:56.74,Default,,0,0,0,,Есімін білетін жалғыз адам.
Dialogue: 0,0:42:56.86,0:42:57.82,Default,,0,0,0,,Хехе
Dialogue: 0,0:42:57.95,0:43:00.91,Default,,0,0,0,,Хизуру Сенсей: Иә, иіс шықты.
Dialogue: 0,0:43:01.03,0:43:01.95,Default,,0,0,0,,Иә
Dialogue: 0,0:43:02.20,0:43:03.99,Default,,0,0,0,,Жақсы иіс шықты.
Dialogue: 0,0:43:04.66,0:43:06.83,Default,,0,0,0,,Сіз хат жаздыңыз, Хизуру мырза.
Dialogue: 0,0:43:06.95,0:43:08.87,Default,,0,0,0,,Мен көрдім бе? (Кико) Хехе
Dialogue: 0,0:43:09.50,0:43:10.92,Default,,0,0,0,,Мүмкін ғашыққа?
Dialogue: 0,0:43:11.04,0:43:11.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:12.42,0:43:14.38,Default,,0,0,0,,Хехехехехехе
Dialogue: 0,0:43:19.34,0:43:20.88,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:43:21.47,0:43:22.97,Default,,0,0,0,,Хехе
Dialogue: 0,0:43:25.39,0:43:26.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:43:26.47,0:43:28.39,Default,,0,0,0,,Иә? Шинко және басқалар.
Dialogue: 0,0:43:28.89,0:43:30.77,Default,,0,0,0,,Мен нан жасауды ойлап жүрмін.
Dialogue: 0,0:43:30.85,0:43:32.73,Default,,0,0,0,,Біз де мектептегі түскі асты тастағымыз келеді.
Dialogue: 0,0:43:32.73,0:43:33.27,Default,,0,0,0,,Біз де мектептегі түскі асты тастағымыз келеді.
Dialogue: 0,0:43:32.73,0:43:33.27,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:43:33.27,0:43:33.40,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:43:33.40,0:43:34.52,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:43:33.40,0:43:34.52,Default,,0,0,0,,Иә? Уф...
Dialogue: 0,0:43:34.52,0:43:34.65,Default,,0,0,0,,Иә? Уф...
Dialogue: 0,0:43:34.65,0:43:35.32,Default,,0,0,0,,Иә? Уф...
Dialogue: 0,0:43:34.65,0:43:35.32,Default,,0,0,0,,(Мизуон)
Dialogue: 0,0:43:35.32,0:43:35.44,Default,,0,0,0,,(Мизуон)
Dialogue: 0,0:43:35.44,0:43:36.28,Default,,0,0,0,,(Мизуон)
Dialogue: 0,0:43:35.44,0:43:36.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:40.11,0:43:42.16,Default,,0,0,0,,Тацуёси... Уау!
Dialogue: 0,0:43:42.28,0:43:44.20,Default,,0,0,0,,Сәлем, бәрі осында.
Dialogue: 0,0:43:44.33,0:43:46.54,Default,,0,0,0,,Мен алтын балығыма ат ойлап таптым.
Dialogue: 0,0:43:46.62,0:43:47.91,Default,,0,0,0,,А, бұл да!
Dialogue: 0,0:43:48.00,0:43:48.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:49.04,0:43:51.33,Default,,0,0,0,,«Хизуру» туралы не деуге болады? Жоқ?
Dialogue: 0,0:43:51.42,0:43:53.25,Default,,0,0,0,,Ах! (Жаңа бала) Эй!
Dialogue: 0,0:43:53.50,0:43:55.38,Default,,0,0,0,,Эй, о
Dialogue: 0,0:43:55.63,0:43:57.38,Default,,0,0,0,,Ендеше менің қалпына келу қабілетім…
Dialogue: 0,0:43:58.30,0:44:00.84,Default,,0,0,0,,О, түсіндім.
Dialogue: 0,0:44:00.97,0:44:03.39,Default,,0,0,0,,Барлығы бірдей (Шинко/Хитоши) Ахаха
Dialogue: 0,0:44:04.64,0:44:06.64,Default,,0,0,0,,Жарайды, бір адамға 10 иен
Dialogue: 0,0:44:06.72,0:44:08.64,Default,,0,0,0,,10 иен төлегеннен кейін оны салыңыз.
Dialogue: 0,0:44:09.06,0:44:12.02,Default,,0,0,0,,Аяқтаған соң, аудитория жарық түспей тұрып сыртқа шығыңыз.
Dialogue: 0,0:44:12.69,0:44:14.52,Default,,0,0,0,,Проекция бөлмесіндегі әкем мені тауып алғанын қаламаймын.
Dialogue: 0,0:44:14.61,0:44:20.03,Default,,0,0,0,,(фильмдер)
Dialogue: 0,0:44:20.99,0:44:22.53,Default,,0,0,0,,Ай! (Иппей) Тынш!
Dialogue: 0,0:44:23.91,0:44:28.04,Default,,0,0,0,,(фильмдер)
Dialogue: 0,0:44:30.12,0:44:31.54,Default,,0,0,0,,Ихихи (Жаңа балалар) Уау...
Dialogue: 0,0:44:31.62,0:44:35.29,Default,,0,0,0,,Ах~ Мен жастық шақпын...
Dialogue: 0,0:44:35.42,0:44:37.84,Default,,0,0,0,,Өскенде ғашық болған кезде не болады?
Dialogue: 0,0:44:37.96,0:44:39.96,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:44:40.21,0:44:42.38,Default,,0,0,0,,Мен... білмеймін...
Dialogue: 0,0:44:42.51,0:44:46.72,Default,,0,0,0,,Мен Хизуру-сенсейдің бақытты болғанын қалаймын.
Dialogue: 0,0:44:46.93,0:44:48.81,Default,,0,0,0,,Kiss~Anata~n
Dialogue: 0,0:44:48.93,0:44:50.18,Default,,0,0,0,,Хизуру Сенсей, қарасаң...
Dialogue: 0,0:44:50.18,0:44:51.27,Default,,0,0,0,,Хизуру-сенсэй, егер сен маған қарасаң...
Dialogue: 0,0:44:50.18,0:44:51.27,Default,,0,0,0,,Тоқта, тоқта, тоқта...
Dialogue: 0,0:44:51.27,0:44:51.39,Default,,0,0,0,,Тоқта, тоқта, тоқта...
Dialogue: 0,0:44:51.39,0:44:54.44,Default,,0,0,0,,Тоқта, тоқта, тоқта...
Dialogue: 0,0:44:51.39,0:44:54.44,Default,,0,0,0,,Менің анам да сондай болды ма деп ойлаймын.
Dialogue: 0,0:44:54.44,0:44:54.73,Default,,0,0,0,,Менің анам да сондай болды ма деп ойлаймын.
Dialogue: 0,0:44:54.73,0:44:55.56,Default,,0,0,0,,Менің анам да сондай болды ма деп ойлаймын.
Dialogue: 0,0:44:54.73,0:44:55.56,Default,,0,0,0,,Мұнда...
Dialogue: 0,0:44:55.81,0:44:58.02,Default,,0,0,0,,Kiiko Look
Dialogue: 0,0:44:58.52,0:44:59.65,Default,,0,0,0,,Иә
Dialogue: 0,0:45:00.03,0:45:06.03,Default,,0,0,0,,♪～
Dialogue: 0,0:45:29.10,0:45:29.93,Default,,0,0,0,,Хаха
Dialogue: 0,0:45:33.14,0:45:35.77,Default,,0,0,0,,Ах! Бұл ракетаның құйрығы...
Dialogue: 0,0:45:35.89,0:45:37.40,Default,,0,0,0,,Хехе, бұл рас.
Dialogue: 0,0:45:37.52,0:45:39.69,Default,,0,0,0,,Хехе, Хизуру-чанға ұқсайды
Dialogue: 0,0:45:39.82,0:45:41.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:41.32,0:45:43.19,Default,,0,0,0,,Хизуру-чан дегеніміз не?
Dialogue: 0,0:45:43.32,0:45:44.82,Default,,0,0,0,,Хмм, иә, фотон (фотон) ааа
Dialogue: 0,0:45:44.95,0:45:48.28,Default,,0,0,0,,Хмм! (Шинко) Ахх.
Dialogue: 0,0:45:48.41,0:45:52.20,Default,,0,0,0,,Эй, бұл не? Хизуру-чан дегеніміз не?
Dialogue: 0,0:45:52.37,0:45:53.66,Default,,0,0,0,,О, бұл не? (Мицуко) А...
Dialogue: 0,0:45:53.79,0:45:56.33,Default,,0,0,0,,Әпке~
Dialogue: 0,0:45:56.83,0:45:58.71,Default,,0,0,0,,Эй!
Dialogue: 0,0:45:59.33,0:46:01.42,Default,,0,0,0,,Сәлем! Тацуёсидің әкесі!
Dialogue: 0,0:46:01.42,0:46:02.55,Default,,0,0,0,,Сәлем! Тацуёсидің әкесі!
Dialogue: 0,0:46:01.42,0:46:02.55,Default,,0,0,0,,Әпке~
Dialogue: 0,0:46:02.55,0:46:02.67,Default,,0,0,0,,Әпке~
Dialogue: 0,0:46:02.67,0:46:04.55,Default,,0,0,0,,Әпке~
Dialogue: 0,0:46:02.67,0:46:04.55,Default,,0,0,0,,Ол солай ма?
Dialogue: 0,0:46:04.88,0:46:07.18,Default,,0,0,0,,Иә, Тами, алтын балық.
Dialogue: 0,0:46:07.30,0:46:09.51,Default,,0,0,0,,Оның аты Хизуру-чан.
Dialogue: 0,0:46:09.64,0:46:11.05,Default,,0,0,0,,Мен сенің үмітіңе сүйенемін, Гран Торино
Dialogue: 0,0:46:12.47,0:46:14.18,Default,,0,0,0,,Міне (Хитоси Шигеру) Уау.
Dialogue: 0,0:46:15.52,0:46:18.02,Default,,0,0,0,,Менің достарым толы.
Dialogue: 0,0:46:18.15,0:46:19.69,Default,,0,0,0,,Иә, жарайды!
Dialogue: 0,0:46:19.94,0:46:21.61,Default,,0,0,0,,Шинко-чанға рахмет (қыз) Ммммммм
Dialogue: 0,0:46:21.73,0:46:23.23,Default,,0,0,0,,Рахмет
Dialogue: 0,0:46:23.36,0:46:26.86,Default,,0,0,0,,Мың жылдық сиқырдың арқасында
Dialogue: 0,0:46:26.99,0:46:30.16,Default,,0,0,0,,Алтын балықтармен де дос болғаныңызға қуаныштымын.
Dialogue: 0,0:46:30.37,0:46:35.54,Default,,0,0,0,,Менің үйімде достасқым келетін тағы бір бала бар.
Dialogue: 0,0:46:35.83,0:46:38.33,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:46:38.75,0:46:39.96,Default,,0,0,0,,Нобуко-чан
Dialogue: 0,0:46:42.13,0:46:44.17,Default,,0,0,0,,Бұл кішкентай көздер, кішкентай көздер.
Dialogue: 0,0:46:44.30,0:46:46.09,Default,,0,0,0,,Кішкентай сүйектер!
Dialogue: 0,0:46:46.17,0:46:47.38,Default,,0,0,0,,Иә!
Dialogue: 0,0:46:47.51,0:46:48.97,Default,,0,0,0,,Ах~
Dialogue: 0,0:46:49.30,0:46:51.43,Default,,0,0,0,,Иә, өте жақсы
Dialogue: 0,0:46:52.68,0:46:53.72,Default,,0,0,0,,Иә
Dialogue: 0,0:46:57.02,0:46:59.85,Default,,0,0,0,,Қайта, есесіне, қайтарып!
Dialogue: 0,0:47:00.02,0:47:01.94,Default,,0,0,0,,Ах! Эххе~
Dialogue: 0,0:47:02.06,0:47:04.53,Default,,0,0,0,,Мынау және мынау туралы не айтасыз!
Dialogue: 0,0:47:07.15,0:47:10.45,Default,,0,0,0,,Хмм, бір күн демалыс...
Dialogue: 0,0:47:10.57,0:47:12.53,Default,,0,0,0,,Енді тағы бір рет!
Dialogue: 0,0:47:12.70,0:47:14.83,Default,,0,0,0,,А, сәл күте тұрыңыз!
Dialogue: 0,0:47:15.41,0:47:17.20,Default,,0,0,0,,Күте алмаймын! Алақай!
Dialogue: 0,0:47:17.58,0:47:18.41,Default,,0,0,0,,Хаха!
Dialogue: 0,0:47:19.54,0:47:22.79,Default,,0,0,0,,Олай болса, көз жақсы, көз жақсы
Dialogue: 0,0:47:22.96,0:47:24.17,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:47:24.46,0:47:25.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:47:25.46,0:47:27.67,Default,,0,0,0,,Ах... Ах~
Dialogue: 0,0:47:29.59,0:47:31.97,Default,,0,0,0,,Хмм, міне!
Dialogue: 0,0:47:35.18,0:47:37.93,Default,,0,0,0,,Уау! Уау
Dialogue: 0,0:47:38.81,0:47:40.02,Default,,0,0,0,,Хототоғысу
Dialogue: 0,0:47:40.14,0:47:42.44,Default,,0,0,0,,Және Унохана!
Dialogue: 0,0:47:45.23,0:47:47.57,Default,,0,0,0,,Ммммммммммммммммммммммммммм
Dialogue: 0,0:47:47.69,0:47:48.78,Default,,0,0,0,,Иә
Dialogue: 0,0:47:49.82,0:47:52.49,Default,,0,0,0,,Әй, қарашы, сонда да.
Dialogue: 0,0:47:52.61,0:47:53.91,Default,,0,0,0,,Қараңызшы, ол жерде әлі бос, солай ма?
Dialogue: 0,0:47:54.16,0:47:55.66,Default,,0,0,0,,Мен мұндай нәрсені бірінші рет жасап отырмын.
Dialogue: 0,0:47:55.78,0:47:56.87,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:47:56.99,0:47:58.62,Default,,0,0,0,,Өте әдемі
Dialogue: 0,0:48:00.83,0:48:03.63,Default,,0,0,0,,Құдайға шүкір, Эмма енді жақсы.
Dialogue: 0,0:48:08.71,0:48:11.30,Default,,0,0,0,,Бұл тек кішігірім жауынгерлерге ғана тиімді. Тастайық.
Dialogue: 0,0:48:22.81,0:48:24.40,Default,,0,0,0,,Ойнайық...
Dialogue: 0,0:48:35.62,0:48:36.74,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:48:36.87,0:48:40.37,Default,,0,0,0,,Кеттік, Кессацутай! Оу! !
Dialogue: 0,0:48:41.00,0:48:44.04,Default,,0,0,0,,Ноу Тацуйоши, мен сенің ағаш қылышыңа сүйенемін.
Dialogue: 0,0:48:44.17,0:48:45.71,Default,,0,0,0,,Мен мұны сұрадым
Dialogue: 0,0:48:46.29,0:48:49.84,Default,,0,0,0,,Әй, бұл әуе қорғанысында шынымен қарақшылар бар ма?
Dialogue: 0,0:48:49.96,0:48:50.92,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:48:51.05,0:48:53.05,Default,,0,0,0,,Қарақшылар сұрағанда
Dialogue: 0,0:48:53.18,0:48:56.35,Default,,0,0,0,,Қарақшылардың мылтықтары болуы мүмкін, бірақ олар білмейді.
Dialogue: 0,0:48:56.47,0:48:57.55,Default,,0,0,0,,Иә~
Dialogue: 0,0:48:57.68,0:48:59.14,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:48:59.26,0:49:00.60,Default,,0,0,0,,Біз шарасыз жасақпыз.
Dialogue: 0,0:49:00.72,0:49:03.19,Default,,0,0,0,,Сол ағаш қылыш Тацуёсидің әкесідікі.
Dialogue: 0,0:49:03.31,0:49:06.56,Default,,0,0,0,,Тацуёсидің әкесі төртінші дан кендо ойыншысы.
Dialogue: 0,0:49:17.20,0:49:19.16,Default,,0,0,0,,Уау! Күте тұрыңыз! Күте тұрыңыз!
Dialogue: 0,0:49:19.28,0:49:20.66,Default,,0,0,0,,Тынышталыңыз
Dialogue: 0,0:49:21.29,0:49:23.12,Default,,0,0,0,,Хааа~
Dialogue: 0,0:49:27.46,0:49:31.46,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:49:40.76,0:49:42.27,Default,,0,0,0,,Көріскенше мысық
Dialogue: 0,0:49:42.35,0:49:44.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:44.35,0:49:46.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:46.69,0:49:48.36,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:49:48.61,0:49:50.02,Default,,0,0,0,,Аа~ бұл қорқынышты болды~
Dialogue: 0,0:49:50.15,0:49:52.36,Default,,0,0,0,,Қорқынышты болды, бауырыңды суыт.
Dialogue: 0,0:49:53.44,0:49:55.36,Default,,0,0,0,,Бұл қандай көз алмасы еді?
Dialogue: 0,0:49:55.49,0:49:57.61,Default,,0,0,0,,Бұл мысық. (Жаңа балалар) Бұл мысық.
Dialogue: 0,0:49:57.74,0:49:59.66,Default,,0,0,0,,Ахахха (Киико) Не?
Dialogue: 0,0:49:59.78,0:50:02.74,Default,,0,0,0,,Ахахха... (Тұңғыш) Жаңа бала!
Dialogue: 0,0:50:02.83,0:50:05.58,Default,,0,0,0,,Мицуконы көргенде, «Ұйқы уақыты келді~» деп айтыңыз.
Dialogue: 0,0:50:05.71,0:50:07.87,Default,,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:50:08.00,0:50:10.04,Default,,0,0,0,,Иә? иә? фотон
Dialogue: 0,0:50:10.17,0:50:12.59,Default,,0,0,0,,Иә? иә? О, жоқ!
Dialogue: 0,0:50:15.67,0:50:17.09,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:50:18.05,0:50:19.34,Default,,0,0,0,,Фотон~
Dialogue: 0,0:50:19.47,0:50:21.10,Default,,0,0,0,,Мицуко-чан
Dialogue: 0,0:50:21.39,0:50:23.85,Default,,0,0,0,,Фотон? Сен ондасың ба?
Dialogue: 0,0:50:27.27,0:50:28.44,Default,,0,0,0,,Мұнда емес
Dialogue: 0,0:50:28.56,0:50:30.11,Default,,0,0,0,,Гетара мұнда...
Dialogue: 0,0:50:30.23,0:50:32.82,Default,,0,0,0,,Біраз қазып алайық (Шинко) Иә? Ах...
Dialogue: 0,0:50:36.07,0:50:37.36,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:50:40.03,0:50:41.49,Default,,0,0,0,,Кокуга…
Dialogue: 0,0:50:41.66,0:50:43.37,Default,,0,0,0,,Ол тым кең...
Dialogue: 0,0:50:44.54,0:50:45.50,Default,,0,0,0,,Фотон!
Dialogue: 0,0:50:45.62,0:50:47.21,Default,,0,0,0,,Фотон!
Dialogue: 0,0:50:49.17,0:50:51.96,Default,,0,0,0,,Не істеуім керек... Не істеуім керек? А?
Dialogue: 0,0:50:52.42,0:50:53.75,Default,,0,0,0,,Хизуру Сенсей!
Dialogue: 0,0:50:53.84,0:50:55.51,Default,,0,0,0,,Аоки-сан (Шинко) иә...
Dialogue: 0,0:50:55.63,0:50:57.92,Default,,0,0,0,,♬~
Dialogue: 0,0:50:58.05,0:51:01.22,Default,,0,0,0,,Мұғалім...Кішкентай қызды көрмедің бе?
Dialogue: 0,0:51:01.34,0:51:04.89,Default,,0,0,0,,Құдайым, мен шамамен 5 жаста едім және осыншама...
Dialogue: 0,0:51:06.35,0:51:08.27,Default,,0,0,0,,Мен оны көрмедім.
Dialogue: 0,0:51:08.94,0:51:09.90,Default,,0,0,0,,Не болды?
Dialogue: 0,0:51:09.98,0:51:12.65,Default,,0,0,0,,Е-е, қарасаң қарсы болмасаң, иә.
Dialogue: 0,0:51:12.77,0:51:13.90,Default,,0,0,0,,Сау болыңыз! (Хизуру мырза) Ах!
Dialogue: 0,0:51:16.11,0:51:18.99,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:51:19.11,0:51:21.20,Default,,0,0,0,,Сіз қалай ойлайсыз? сонда болды?
Dialogue: 0,0:51:21.32,0:51:23.99,Default,,0,0,0,,А... ммм...
Dialogue: 0,0:51:24.12,0:51:25.66,Default,,0,0,0,,А, бұл
Dialogue: 0,0:51:26.08,0:51:27.41,Default,,0,0,0,,Шинконың үйінің алдында
Dialogue: 0,0:51:29.54,0:51:31.25,Default,,0,0,0,,А... полиция...
Dialogue: 0,0:51:31.37,0:51:33.50,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:51:34.75,0:51:36.80,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:51:34.75,0:51:36.80,Default,,0,0,0,,Нхуфуфуфу
Dialogue: 0,0:51:36.92,0:51:40.26,Default,,0,0,0,,Ах ха...
Dialogue: 0,0:51:36.92,0:51:40.26,Default,,0,0,0,,Мысық хаха
Dialogue: 0,0:51:40.38,0:51:41.43,Default,,0,0,0,,Ах... (Кико) Иә?
Dialogue: 0,0:51:41.51,0:51:44.30,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:51:41.51,0:51:44.30,Default,,0,0,0,,Мұны тіпті ақымақ та түсінетіндей етіп түсіндірейін.
Dialogue: 0,0:51:44.43,0:51:45.56,Default,,0,0,0,,Жоқ, Санкаку тоғанынан
Dialogue: 0,0:51:45.56,0:51:46.64,Default,,0,0,0,,Жоқ, Санкакуике тоғанынан...
Dialogue: 0,0:51:45.56,0:51:46.64,Default,,0,0,0,,Ах! Хахаха
Dialogue: 0,0:51:46.64,0:51:46.77,Default,,0,0,0,,Ах! Хахаха
Dialogue: 0,0:51:46.77,0:51:47.81,Default,,0,0,0,,Ах! Хахаха
Dialogue: 0,0:51:46.77,0:51:47.81,Default,,0,0,0,,Жоғарыдағы гольф алаңына кіру-
Dialogue: 0,0:51:47.81,0:51:48.60,Default,,0,0,0,,Жоғарыдағы гольф алаңына кіру-
Dialogue: 0,0:51:48.73,0:51:51.65,Default,,0,0,0,,Сіз гольф добын алмақ болдыңыз.
Dialogue: 0,0:51:52.52,0:51:55.07,Default,,0,0,0,,Қандай жағдай болмасын, еңбегіңіз үшін рахмет.
Dialogue: 0,0:51:55.19,0:51:56.53,Default,,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:51:57.32,0:51:58.69,Default,,0,0,0,,Олай болса бұл.
Dialogue: 0,0:51:58.69,0:51:58.90,Default,,0,0,0,,Олай болса бұл.
Dialogue: 0,0:51:58.69,0:51:58.90,Default,,0,0,0,,Хахаха, міне, мысық~
Dialogue: 0,0:51:58.90,0:51:59.03,Default,,0,0,0,,Хахаха, міне, мысық~
Dialogue: 0,0:51:59.03,0:52:02.07,Default,,0,0,0,,Хахаха, міне, мысық~
Dialogue: 0,0:51:59.03,0:52:02.07,Default,,0,0,0,,Күрсін, бұл жақсы.
Dialogue: 0,0:52:17.17,0:52:20.13,Default,,0,0,0,,Хаа~ (Шинко) Хэхе
Dialogue: 0,0:52:20.26,0:52:23.26,Default,,0,0,0,,Ахаха хехехе
Dialogue: 0,0:52:29.81,0:52:30.60,Default,,0,0,0,,Уф!
Dialogue: 0,0:52:33.44,0:52:34.94,Default,,0,0,0,,Сіз оны көтерсеңіз, мен қарсы емеспін ...
Dialogue: 0,0:52:35.06,0:52:36.61,Default,,0,0,0,,Өзіңізге қамқорлық жасаңыз
Dialogue: 0,0:52:36.98,0:52:40.24,Default,,0,0,0,,Иә, мен тікелей полиция қызметкері болғым келмейді.
Dialogue: 0,0:52:41.07,0:52:43.61,Default,,0,0,0,,Бұрын қарақшы өз-өзіне тосқауыл қойғанда...
Dialogue: 0,0:52:43.74,0:52:47.08,Default,,0,0,0,,Мен бірінші болып ерікті болдым, мен дұрыс емес адамды ұстадым.
Dialogue: 0,0:52:47.20,0:52:49.66,Default,,0,0,0,,Иә, бұл нағыз суицид отряды.
Dialogue: 0,0:52:49.79,0:52:51.75,Default,,0,0,0,,Иә? (Котаро) Хмм
Dialogue: 0,0:52:51.83,0:52:54.29,Default,,0,0,0,,Фотон~ Фотон~ (Фотон) Ммм~
Dialogue: 0,0:52:54.42,0:52:57.29,Default,,0,0,0,,Бұл керемет Ахаха
Dialogue: 0,0:52:57.42,0:53:00.26,Default,,0,0,0,,О, сіз дәл сол жердесіз.
Dialogue: 0,0:53:00.55,0:53:03.84,Default,,0,0,0,,Әпкесі (Шинко) Хизуру-сенсей?
Dialogue: 0,0:53:06.30,0:53:07.68,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:53:07.80,0:53:10.27,Default,,0,0,0,,Мұғалім де сені іздеді.
Dialogue: 0,0:53:10.39,0:53:11.60,Default,,0,0,0,,Иә
Dialogue: 0,0:53:12.31,0:53:15.15,Default,,0,0,0,,Мұғалім, мен дірілдеп тұрмын.
Dialogue: 0,0:53:15.27,0:53:17.27,Default,,0,0,0,,Осы кең Кокугада...
Dialogue: 0,0:53:17.40,0:53:19.98,Default,,0,0,0,,Мен шынымен бірдеңе болып жатқандай сезінемін.
Dialogue: 0,0:53:20.11,0:53:21.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:21.32,0:53:24.74,Default,,0,0,0,,Өзін аздап дірілдеп, бақытты сезіну
Dialogue: 0,0:53:24.86,0:53:27.28,Default,,0,0,0,,Менің ойымша, бұл жыныстық жетілуге байланысты.
Dialogue: 0,0:53:27.41,0:53:29.74,Default,,0,0,0,,Бұл сәл басқаша болуы мүмкін.
Dialogue: 0,0:53:30.20,0:53:34.37,Default,,0,0,0,,Мұның бәрі үлкендердің арқасы.
Dialogue: 0,0:53:34.79,0:53:37.54,Default,,0,0,0,,Менің атам, Тацуёсидің әкесі...
Dialogue: 0,0:53:37.67,0:53:39.54,Default,,0,0,0,,Ал Хизуру... Иә?
Dialogue: 0,0:53:39.84,0:53:42.55,Default,,0,0,0,,Әй, сақина! Әдемі
Dialogue: 0,0:53:42.63,0:53:45.88,Default,,0,0,0,,Хмм, менің ойымша, оған көмектесу мүмкін емес.
Dialogue: 0,0:53:46.01,0:53:48.30,Default,,0,0,0,,Шындығында, мырза.
Dialogue: 0,0:53:48.43,0:53:52.10,Default,,0,0,0,,Мен келесі сенбіде мектептен шығамын. (Шинко) А?
Dialogue: 0,0:53:52.22,0:53:53.93,Default,,0,0,0,,Үйлену
Dialogue: 0,0:53:55.19,0:53:56.85,Default,,0,0,0,,Осы күз
Dialogue: 0,0:53:56.98,0:54:00.48,Default,,0,0,0,,Бірақ менде көп дайындық бар, сондықтан мектеп келесі аптада басталмайды.
Dialogue: 0,0:54:00.61,0:54:03.07,Default,,0,0,0,,Дүйсенбі күні таңертеңгі жиналысқа дейін құпия сақтаңыз.
Dialogue: 0,0:54:04.03,0:54:06.57,Default,,0,0,0,,Сіз кімге тұрмыстасыз?
Dialogue: 0,0:54:07.53,0:54:09.37,Default,,0,0,0,,Колледждегі достар
Dialogue: 0,0:54:09.49,0:54:12.66,Default,,0,0,0,,Мен Токиода тұрамын, сондықтан Токиоға барамын.
Dialogue: 0,0:54:12.79,0:54:16.79,Default,,0,0,0,,Ол регби ойыншысы, ол шынымен де үлкен.
Dialogue: 0,0:54:16.92,0:54:18.46,Default,,0,0,0,,Ах~
Dialogue: 0,0:54:18.58,0:54:22.71,Default,,0,0,0,,Егер солай болса, мен де Токиоға барғым келеді.
Dialogue: 0,0:54:22.96,0:54:25.72,Default,,0,0,0,,Өскенде қош келдің
Dialogue: 0,0:54:25.84,0:54:26.72,Default,,0,0,0,,Көңіл көтеру үшін
Dialogue: 0,0:54:26.84,0:54:28.84,Default,,0,0,0,,Қош бол (Шинко) Хехе
Dialogue: 0,0:54:28.97,0:54:31.89,Default,,0,0,0,,Қалың-сан Қалың-сан (Мицуко) Аан
Dialogue: 0,0:54:32.01,0:54:33.22,Default,,0,0,0,,Киико Киико!
Dialogue: 0,0:54:33.31,0:54:34.14,Default,,0,0,0,,Ах~ Аа?
Dialogue: 0,0:54:34.27,0:54:36.18,Default,,0,0,0,,Оны Киикодан құпия сақтаңыз...
Dialogue: 0,0:54:39.48,0:54:40.77,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:54:41.15,0:54:42.73,Default,,0,0,0,,Фуфуфу фуфуфу (Киико) Ах!
Dialogue: 0,0:54:49.03,0:54:50.87,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:54:50.99,0:54:52.91,Default,,0,0,0,,Ха! (Шинко) А?
Dialogue: 0,0:54:53.49,0:54:54.74,Default,,0,0,0,,Хмм
Dialogue: 0,0:54:56.33,0:54:58.29,Default,,0,0,0,,Иә? (Кико) Хаха
Dialogue: 0,0:55:01.04,0:55:03.17,Default,,0,0,0,,Құттықтаймыз Хизуру-чан
Dialogue: 0,0:55:05.55,0:55:07.42,Default,,0,0,0,,Мереке? Не?
Dialogue: 0,0:55:07.55,0:55:09.18,Default,,0,0,0,,Шинко-чан да! (Шинко) Ах, уау.
Dialogue: 0,0:55:10.39,0:55:11.72,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:55:13.35,0:55:16.27,Default,,0,0,0,,Қарашы, Шинко-чан да! (Шинко) Иә.
Dialogue: 0,0:55:17.02,0:55:18.10,Default,,0,0,0,,Ахаха
Dialogue: 0,0:55:21.27,0:55:22.11,Default,,0,0,0,,Ойнайық
Dialogue: 0,0:55:22.19,0:55:24.61,Default,,0,0,0,,Иә! Қарашы, Шинко-чан
Dialogue: 0,0:55:24.69,0:55:25.61,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:55:29.49,0:55:32.87,Default,,0,0,0,,Шынында да, астанада, мысалы, Цукидзи учаскесінің жоғарғы топырағы...
Dialogue: 0,0:55:32.99,0:55:35.08,Default,,0,0,0,,Сіз тұқым себесіз бе?
Dialogue: 0,0:55:35.20,0:55:37.50,Default,,0,0,0,,Дұрыс, қазіргі император не істеп жатыр...
Dialogue: 0,0:55:37.62,0:55:39.46,Default,,0,0,0,,Ол талғампаздығымен танымал.
Dialogue: 0,0:55:39.58,0:55:41.83,Default,,0,0,0,,Ой...
Dialogue: 0,0:55:43.25,0:55:44.09,Default,,0,0,0,,Хехе
Dialogue: 0,0:55:44.42,0:55:47.51,Default,,0,0,0,,Гүлдер жайнады, тоғандағы гүлдер.
Dialogue: 0,0:55:47.63,0:55:50.34,Default,,0,0,0,,Керемет, Киико, өте әдемі.
Dialogue: 0,0:55:50.47,0:55:51.59,Default,,0,0,0,,Әдемі
Dialogue: 0,0:55:51.72,0:55:55.22,Default,,0,0,0,,Мен... Әй, мына мәрмәрді де сал.
Dialogue: 0,0:55:55.35,0:55:56.89,Default,,0,0,0,,А, мен де!
Dialogue: 0,0:55:57.56,0:55:58.39,Default,,0,0,0,,Сен екеуің алда барыңдар!
Dialogue: 0,0:55:59.10,0:56:00.85,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:56:00.98,0:56:02.90,Default,,0,0,0,,Ах, Хизуру келді.
Dialogue: 0,0:56:05.40,0:56:07.40,Default,,0,0,0,,Сізге ұнаса, қараңыз.
Dialogue: 0,0:56:07.48,0:56:09.36,Default,,0,0,0,,Жапырақ футоны
Dialogue: 0,0:56:09.49,0:56:12.45,Default,,0,0,0,,Ұйықтаушы Шии-сан Хизуру-чан
Dialogue: 0,0:56:12.57,0:56:15.33,Default,,0,0,0,,Балықтар футонда ұйықтай алмайды (Мицуко)
Dialogue: 0,0:56:16.12,0:56:19.75,Default,,0,0,0,,О, бұл керемет (Шинко/Киико) Фуфуфуфуфуфуфуфу
Dialogue: 0,0:56:19.87,0:56:20.75,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:56:24.83,0:56:26.46,Default,,0,0,0,,Не? (Шинко) Иә.
Dialogue: 0,0:56:26.59,0:56:29.21,Default,,0,0,0,,Ах! Сіз ашуланасыз (Шинко) Тшш!
Dialogue: 0,0:56:31.93,0:56:36.14,Default,,0,0,0,,Хухуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфу
Dialogue: 0,0:56:36.22,0:56:38.56,Default,,0,0,0,,Хуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфуфу
Dialogue: 0,0:56:38.68,0:56:41.77,Default,,0,0,0,,Мен де үйімді бірдеңемен безендіргім келеді (Мицуко) Ах~
Dialogue: 0,0:56:44.60,0:56:48.15,Default,,0,0,0,,(күтушінің уағызы)
Dialogue: 0,0:56:48.23,0:56:53.57,Default,,0,0,0,,Бұл адамдар маған ойнама деп жатыр.
Dialogue: 0,0:56:54.78,0:56:56.32,Default,,0,0,0,,Сол қызбен...
Dialogue: 0,0:56:57.74,0:57:00.50,Default,,0,0,0,,Мен мұны түсінбеймін ...
Dialogue: 0,0:57:01.04,0:57:02.08,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:57:03.08,0:57:04.04,Default,,0,0,0,,Әй!
Dialogue: 0,0:57:05.33,0:57:06.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:06.63,0:57:10.51,Default,,0,0,0,,Иә? Мен неге жыладым?
Dialogue: 0,0:57:13.51,0:57:16.43,Default,,0,0,0,,Ха ха ха ха!
Dialogue: 0,0:57:19.60,0:57:20.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:57:21.52,0:57:22.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:57:22.93,0:57:23.81,Default,,0,0,0,,Хмм...
Dialogue: 0,0:57:26.10,0:57:27.56,Default,,0,0,0,,Шинко?
Dialogue: 0,0:57:27.69,0:57:29.19,Default,,0,0,0,,Бұл қиын...
Dialogue: 0,0:57:42.00,0:57:43.54,Default,,0,0,0,,Кико...
Dialogue: 0,0:57:44.21,0:57:47.38,Default,,0,0,0,,Анамның әтірі...
Dialogue: 0,0:57:47.54,0:57:50.59,Default,,0,0,0,,Жарайды... мен ойладым...
Dialogue: 0,0:57:50.96,0:57:53.72,Default,,0,0,0,,Бүгін көргенде... қақпақ...
Dialogue: 0,0:57:54.09,0:57:55.47,Default,,0,0,0,,Ашық болды...
Dialogue: 0,0:57:55.59,0:57:57.09,Default,,0,0,0,,Әпке
Dialogue: 0,0:57:57.22,0:58:00.51,Default,,0,0,0,,Хизуру... Сіз өліп қалуыңыз мүмкін бе?
Dialogue: 0,0:58:00.81,0:58:04.48,Default,,0,0,0,,А, күн батқаннан да қызарып кетті.
Dialogue: 0,0:58:05.39,0:58:06.77,Default,,0,0,0,,Хизуру~
Dialogue: 0,0:58:06.90,0:58:07.73,Default,,0,0,0,,Бұл ысырап
Dialogue: 0,0:58:08.40,0:58:11.07,Default,,0,0,0,,Егер олай болмаса, мен бәрін сынап көрдім.
Dialogue: 0,0:58:11.19,0:58:13.94,Default,,0,0,0,,Бәріміз бірге жерлеу рәсімін өткізейік!
Dialogue: 0,0:58:16.65,0:58:18.62,Default,,0,0,0,,Иә (Шинко) Жерлеу рәсімін жасайық.
Dialogue: 0,0:58:18.74,0:58:20.49,Default,,0,0,0,,Тарихи жерде
Dialogue: 0,0:58:20.83,0:58:24.75,Default,,0,0,0,,Нанмаэ да~ Нанмэ да~
Dialogue: 0,0:58:24.83,0:58:26.33,Default,,0,0,0,,Нанмаэ да~ Нанмэ да~
Dialogue: 0,0:58:26.46,0:58:28.12,Default,,0,0,0,,Оған шындап табын
Dialogue: 0,0:58:28.58,0:58:30.67,Default,,0,0,0,,Тіпті ағам қайтыс болғанда...
Dialogue: 0,0:58:30.79,0:58:32.92,Default,,0,0,0,,Ей, мен көкке бардым, өйткені мен жасадым.
Dialogue: 0,0:58:33.05,0:58:36.55,Default,,0,0,0,,15 тамызда намаз оқысаңыз...
Dialogue: 0,0:58:36.67,0:58:38.01,Default,,0,0,0,,Өйткені мен қайтамын
Dialogue: 0,0:58:38.13,0:58:40.55,Default,,0,0,0,,Ол келмейді, мен үйге бармаймын.
Dialogue: 0,0:58:40.68,0:58:41.76,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:58:44.81,0:58:46.68,Default,,0,0,0,,Анаң туралы да...
Dialogue: 0,0:58:47.73,0:58:51.56,Default,,0,0,0,,Еске түсірмейік...
Dialogue: 0,0:58:52.94,0:58:53.78,Default,,0,0,0,,Эй, сәлем-
Dialogue: 0,0:58:54.48,0:58:57.36,Default,,0,0,0,,15 тамыз қай күн?
Dialogue: 0,0:58:57.49,0:59:00.28,Default,,0,0,0,,Тек Обон үшін.
Dialogue: 0,0:59:01.57,0:59:04.29,Default,,0,0,0,,Сол жерде жерлеу рәсімі болды ма?
Dialogue: 0,0:59:05.29,0:59:09.29,Default,,0,0,0,,Мыңжылдық жерінің негізгі орны...
Dialogue: 0,0:59:09.37,0:59:10.92,Default,,0,0,0,,Мен солай айтқандықтан ба?
Dialogue: 0,0:59:11.04,0:59:13.13,Default,,0,0,0,,Өмірге қайта оралмайсың ба?
Dialogue: 0,0:59:13.25,0:59:15.71,Default,,0,0,0,,Мыңжылдық елінің сиқырымен
Dialogue: 0,0:59:16.76,0:59:20.80,Default,,0,0,0,,Мен оны сиқырлы жерге көмгендіктен... Сиқырлы балыққа айналды...
Dialogue: 0,0:59:20.93,0:59:23.68,Default,,0,0,0,,Хизуру: Бұл жолы сен мың жыл өмір сүресің, солай ма?
Dialogue: 0,0:59:23.81,0:59:29.02,Default,,0,0,0,,Егер ол мың жыл өмір сүрсе, ол осы үй сияқты үлкен болар еді, солай ма? Эй?
Dialogue: 0,0:59:30.35,0:59:32.69,Default,,0,0,0,,Осы мақсатта Киико...
Dialogue: 0,0:59:33.90,0:59:35.19,Default,,0,0,0,,Иә
Dialogue: 0,0:59:44.24,0:59:46.08,Default,,0,0,0,,Хаха хаха
Dialogue: 0,0:59:46.54,0:59:49.54,Default,,0,0,0,,Шинко~ Күтіңіз~
Dialogue: 0,0:59:49.62,0:59:51.87,Default,,0,0,0,,Сәлем! Ха ха ха
Dialogue: 0,0:59:52.00,0:59:54.75,Default,,0,0,0,,Бұл, бұл тұрарлық.
Dialogue: 0,0:59:54.88,0:59:56.96,Default,,0,0,0,,Не? Бұл...
Dialogue: 0,0:59:57.51,1:00:00.34,Default,,0,0,0,,Ағында жүзіп келе жатқан шағала көрдім.
Dialogue: 0,1:00:00.47,1:00:02.89,Default,,0,0,0,,Хизуруға ұқсайтын қызыл алтын балық
Dialogue: 0,1:00:03.01,1:00:03.97,Default,,0,0,0,,Шынымен!
Dialogue: 0,1:00:04.10,1:00:07.52,Default,,0,0,0,,Менің көршім, тас қабырға (Шинко) Иә.
Dialogue: 0,1:00:07.64,1:00:10.35,Default,,0,0,0,,Мен сол жерде қызыл ұшқындарды көрдім.
Dialogue: 0,1:00:10.44,1:00:12.31,Default,,0,0,0,,Жоғарыдан қарасаңыз...
Dialogue: 0,1:00:12.44,1:00:14.52,Default,,0,0,0,,Хизуру дәл соған ұқсады
Dialogue: 0,1:00:14.65,1:00:18.32,Default,,0,0,0,,Ол өлуі керек болса да, біртүрлі.
Dialogue: 0,1:00:21.24,1:00:23.16,Default,,0,0,0,,Ах Киико!
Dialogue: 0,1:00:23.28,1:00:25.37,Default,,0,0,0,,Сәлем Киико Эй!
Dialogue: 0,1:00:25.49,1:00:27.45,Default,,0,0,0,,Нанмаэ да~ Нанмэ да~
Dialogue: 0,1:00:27.58,1:00:31.00,Default,,0,0,0,,Нанмаэ да~ Нанмэ да~
Dialogue: 0,1:00:31.08,1:00:33.79,Default,,0,0,0,,Нанмаэда~ Нанмаэда~
Dialogue: 0,1:00:33.92,1:00:38.50,Default,,0,0,0,,Нанмаэ да~ Нанмэ да~
Dialogue: 0,1:00:38.59,1:00:43.01,Default,,0,0,0,,Нанмаэ да~ Нанмэ да~
Dialogue: 0,1:00:43.72,1:00:47.22,Default,,0,0,0,,Хизуру Ноу мырза мектепті тастап кеткен сияқты.
Dialogue: 0,1:00:47.35,1:00:49.68,Default,,0,0,0,,Ех! Бұл дұрыс...
Dialogue: 0,1:00:49.81,1:00:52.60,Default,,0,0,0,,Хизуру Сенсей, менің сүйіктім дүниеден өтті.
Dialogue: 0,1:00:52.73,1:00:53.65,Default,,0,0,0,,Е...
Dialogue: 0,1:00:53.77,1:00:57.27,Default,,0,0,0,,Себебі мен үйленгенмін және әйелім бар.
Dialogue: 0,1:00:57.40,1:00:58.27,Default,,0,0,0,,Иә?
Dialogue: 0,1:00:58.40,1:01:00.03,Default,,0,0,0,,Ештеңе жасаудың қажеті жоқ.
Dialogue: 0,1:01:00.11,1:01:01.82,Default,,0,0,0,,Хизуру Сенсей, сен соншалықты үмітсізсің...
Dialogue: 0,1:01:01.94,1:01:04.53,Default,,0,0,0,,Токиода басқа адамға тұрмысқа шығу туралы не айтасыз?
Dialogue: 0,1:01:06.49,1:01:08.16,Default,,0,0,0,,Әйтеуір, көңілім түсіп кетті.
Dialogue: 0,1:01:08.28,1:01:12.50,Default,,0,0,0,,Хизуру Чуу Мен алтын балықтың аты да лас сияқты сезіне бастадым.
Dialogue: 0,1:01:13.92,1:01:15.17,Default,,0,0,0,,Ах!
Dialogue: 0,1:01:15.29,1:01:17.75,Default,,0,0,0,,Мицуру-доно, дайын бол!
Dialogue: 0,1:01:17.88,1:01:19.63,Default,,0,0,0,,Эхммм! Не! Ха
Dialogue: 0,1:01:19.75,1:01:20.84,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:01:21.17,1:01:23.34,Default,,0,0,0,,Ақылсыз сөз айтсаң ше?
Dialogue: 0,1:01:23.47,1:01:25.18,Default,,0,0,0,,Ноу (жаңа бала) қазірдің өзінде
Dialogue: 0,1:01:25.89,1:01:27.85,Default,,0,0,0,,Сәлем Шинко
Dialogue: 0,1:01:27.97,1:01:28.93,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,1:01:29.93,1:01:33.81,Default,,0,0,0,,Сізде Кииконы тарта алатындай сенімділік бар ма?
Dialogue: 0,1:01:34.10,1:01:36.60,Default,,0,0,0,,Егер сізде алтын балық болмаса, не істер едіңіз?
Dialogue: 0,1:01:37.90,1:01:40.27,Default,,0,0,0,,Жоқ, менде ешқандай сенім жоқ.
Dialogue: 0,1:01:40.48,1:01:41.73,Default,,0,0,0,,Бірақ-
Dialogue: 0,1:01:42.57,1:01:45.53,Default,,0,0,0,,Хизурудың да менімен бірге болғанын қалаймын.
Dialogue: 0,1:01:47.91,1:01:49.37,Default,,0,0,0,,Оны іздеп көрейік
Dialogue: 0,1:01:49.49,1:01:50.83,Default,,0,0,0,,Ертең де
Dialogue: 0,1:01:51.29,1:01:53.00,Default,,0,0,0,,Не? Шигеру
Dialogue: 0,1:01:53.12,1:01:54.58,Default,,0,0,0,,Сіз жай ғана интровертсіз.
Dialogue: 0,1:01:54.71,1:01:55.87,Default,,0,0,0,,Екеуміз далаға шығайық
Dialogue: 0,1:01:56.29,1:01:57.83,Default,,0,0,0,,Тацуёси
Dialogue: 0,1:01:58.00,1:01:59.84,Default,,0,0,0,,Егер Тацуёси солай айтса
Dialogue: 0,1:02:00.17,1:02:01.63,Default,,0,0,0,,Мицуру мен Хитоши ше?
Dialogue: 0,1:02:01.75,1:02:03.84,Default,,0,0,0,,Ммммммм біз...
Dialogue: 0,1:02:04.09,1:02:07.26,Default,,0,0,0,,Ха, бұл ауыр бөксе.
Dialogue: 0,1:02:07.39,1:02:08.89,Default,,0,0,0,,Өйткені мен уәде беремін
Dialogue: 0,1:02:09.26,1:02:12.31,Default,,0,0,0,,Йо ине, мың уәде.
Dialogue: 0,1:02:12.43,1:02:14.93,Default,,0,0,0,,Ертең міндетті түрде алтын балық табасың
Dialogue: 0,1:02:15.06,1:02:18.27,Default,,0,0,0,,Үмітсіз корпустың ағаш қылышы осылай дейді.
Dialogue: 0,1:02:19.31,1:02:21.69,Default,,0,0,0,,Хмм, егер сіз сұрасаңыз
Dialogue: 0,1:02:21.82,1:02:24.03,Default,,0,0,0,,Жарайды, оған көмектесу мүмкін емес.
Dialogue: 0,1:02:24.99,1:02:29.20,Default,,0,0,0,,Алға, Киико. Ертең сен де күле аласың.
Dialogue: 0,1:02:31.95,1:02:33.08,Default,,0,0,0,,Иә
Dialogue: 0,1:02:35.41,1:02:37.12,Default,,0,0,0,,Маған ертең уәде бер.
Dialogue: 0,1:02:38.88,1:02:42.04,Default,,0,0,0,,Ертең мен боламын, бәріміз бірге күлейік.
Dialogue: 0,1:02:42.80,1:02:44.17,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,1:02:45.76,1:02:47.55,Default,,0,0,0,,Хакуба Тенгу тірі
Dialogue: 0,1:02:47.68,1:02:49.43,Default,,0,0,0,,Ол жай ғана лас қолға түсті!
Dialogue: 0,1:02:47.68,1:02:49.43,Default,,0,0,0,,Тацуёси ересек адам емес.
Dialogue: 0,1:02:49.43,1:02:49.55,Default,,0,0,0,,Тацуёси ересек адам емес.
Dialogue: 0,1:02:49.55,1:02:50.18,Default,,0,0,0,,Тацуёси ересек адам емес.
Dialogue: 0,1:02:49.55,1:02:50.18,Default,,0,0,0,,Хакуба Тенгу міндетті түрде сен сияқты біреуден жеңіледі.
Dialogue: 0,1:02:50.18,1:02:50.30,Default,,0,0,0,,Хакуба Тенгу сен сияқты біреуден міндетті түрде жеңіледі.
Dialogue: 0,1:02:50.30,1:02:52.39,Default,,0,0,0,,Хакуба Тенгу сен сияқты біреуден міндетті түрде жеңіледі.
Dialogue: 0,1:02:50.30,1:02:52.39,Default,,0,0,0,,Кел, кел!
Dialogue: 0,1:02:52.39,1:02:52.76,Default,,0,0,0,,Хакуба Тенгу сен сияқты біреуден міндетті түрде жеңіледі.
Dialogue: 0,1:02:52.89,1:02:53.22,Default,,0,0,0,,Хахахаха! Әлі де осындай дүниеде
Dialogue: 0,1:02:53.22,1:02:55.06,Default,,0,0,0,,Хахахаха! Әлі де осындай дүниеде
Dialogue: 0,1:02:53.22,1:02:55.06,Default,,0,0,0,,Қараңыз, ah
Dialogue: 0,1:02:55.06,1:02:56.68,Default,,0,0,0,,Хахахаха! Әлі де осындай дүниеде
Dialogue: 0,1:02:56.81,1:02:59.06,Default,,0,0,0,,Мен сенемін, тіпті сенемін!
Dialogue: 0,1:02:59.19,1:03:00.61,Default,,0,0,0,,Қауіпті! Хикохачиро
Dialogue: 0,1:03:00.61,1:03:00.73,Default,,0,0,0,,Қауіпті! Хикохачиро
Dialogue: 0,1:03:00.61,1:03:00.73,Default,,0,0,0,,Тек қолтаңба ғана — ерекше алғыс
Dialogue: 0,1:03:00.73,1:03:00.86,Default,,0,0,0,,Тек қолтаңба ғана — ерекше алғыс
Dialogue: 0,1:03:00.86,1:03:02.40,Default,,0,0,0,,Тек қолтаңба ғана — ерекше алғыс
Dialogue: 0,1:03:00.86,1:03:02.40,Default,,0,0,0,,Котохиме-сама!
Dialogue: 0,1:03:02.40,1:03:02.52,Default,,0,0,0,,Тек қолтаңба ғана — ерекше алғыс
Dialogue: 0,1:03:02.52,1:03:03.40,Default,,0,0,0,,Тек қолтаңба ғана — ерекше алғыс
Dialogue: 0,1:03:02.52,1:03:03.40,Default,,0,0,0,,Хикохачиро дағдарысында Хакуба Тенгу...
Dialogue: 0,1:03:03.40,1:03:03.94,Default,,0,0,0,,Хикохачиро дағдарысында Хакуба Тенгу...
Dialogue: 0,1:03:03.94,1:03:04.98,Default,,0,0,0,,Хикохачиро дағдарысында Хакуба Тенгу...
Dialogue: 0,1:03:03.94,1:03:04.98,Default,,0,0,0,,Иә
Dialogue: 0,1:03:04.98,1:03:05.11,Default,,0,0,0,,Иә
Dialogue: 0,1:03:05.11,1:03:05.40,Default,,0,0,0,,Иә
Dialogue: 0,1:03:05.11,1:03:05.40,Default,,0,0,0,,Әлі уақытында емес
Dialogue: 0,1:03:05.40,1:03:07.32,Default,,0,0,0,,Әлі уақыт жоқ
Dialogue: 0,1:03:07.74,1:03:10.32,Default,,0,0,0,,Енді мен сендерге тақырыптық әнді жіберуге рұқсат етіңіздер.
Dialogue: 0,1:03:10.41,1:03:11.87,Default,,0,0,0,,(радиодраманың тақырыптық әні)
Dialogue: 0,1:03:11.87,1:03:12.87,Default,,0,0,0,,(радиодраманың тақырыптық әні)
Dialogue: 0,1:03:11.87,1:03:12.87,Default,,0,0,0,,Осы тапаншаны пайдаланып—
Dialogue: 0,1:03:12.87,1:03:12.99,Default,,0,0,0,,(радиодраманың тақырыптық әні)
Dialogue: 0,1:03:12.99,1:03:14.41,Default,,0,0,0,,(радио драмалық ән)
Dialogue: 0,1:03:12.99,1:03:14.41,Default,,0,0,0,,«Ертең кездескенше»?
Dialogue: 0,1:03:14.41,1:03:16.08,Default,,0,0,0,,«Ертең кездескенше»?
Dialogue: 0,1:03:16.50,1:03:18.37,Default,,0,0,0,,Хуа~ (тұңғыш) жаңа бала
Dialogue: 0,1:03:18.50,1:03:19.33,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:19.42,1:03:20.67,Default,,0,0,0,,Сузуки-кун келе жатыр.
Dialogue: 0,1:03:20.79,1:03:23.80,Default,,0,0,0,,Иә? Сузуки? (Тұңғыш) Иә.
Dialogue: 0,1:03:23.88,1:03:26.30,Default,,0,0,0,,Suzuki… Suzuki…
Dialogue: 0,1:03:26.38,1:03:28.84,Default,,0,0,0,,Әй, Тацуёси Сузуки?
Dialogue: 0,1:03:30.51,1:03:32.26,Default,,0,0,0,,Не?
Dialogue: 0,1:03:32.55,1:03:34.31,Default,,0,0,0,,Кешіріңіз Шинко
Dialogue: 0,1:03:34.43,1:03:35.47,Default,,0,0,0,,Иә?
Dialogue: 0,1:03:36.27,1:03:39.56,Default,,0,0,0,,Ертең бәрі түсінеді деп ойлаймын.
Dialogue: 0,1:03:40.02,1:03:41.06,Default,,0,0,0,,Хмм...
Dialogue: 0,1:03:41.98,1:03:44.27,Default,,0,0,0,,Менің де көңілім қалды.
Dialogue: 0,1:03:45.86,1:03:46.98,Default,,0,0,0,,Ақымақ
Dialogue: 0,1:03:47.19,1:03:50.32,Default,,0,0,0,,Мен сенің не айтып тұрғаныңды білмеймін.
Dialogue: 0,1:03:50.45,1:03:51.74,Default,,0,0,0,,Мүлдем емес...
Dialogue: 0,1:03:53.99,1:03:55.91,Default,,0,0,0,,Майор
Dialogue: 0,1:03:56.04,1:03:58.25,Default,,0,0,0,,Хмм? не болды?
Dialogue: 0,1:03:58.70,1:04:02.92,Default,,0,0,0,,Енді артқа өтіңіз, Йошимура мырза мұнда жоқ.
Dialogue: 0,1:04:03.04,1:04:06.63,Default,,0,0,0,,Өткен күні Мицуконы тапқан полиция қызметкері
Dialogue: 0,1:04:06.75,1:04:07.80,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,1:04:07.92,1:04:11.68,Default,,0,0,0,,Мен басымды салбырап тұрған полиция бөлімінде
Dialogue: 0,1:04:11.80,1:04:12.80,Default,,0,0,0,,Иә! ?
Dialogue: 0,1:04:12.93,1:04:16.93,Default,,0,0,0,,Ол порт қаласындағы якудзамен араласып кеткен сияқты.
Dialogue: 0,1:04:17.06,1:04:19.52,Default,,0,0,0,,Бар Калифорния Чутоконың екінші қабаты -
Dialogue: 0,1:04:19.64,1:04:22.90,Default,,0,0,0,,Мен ашық жерге түсіп, сол жерде әйелге түсіп қалдым...
Dialogue: 0,1:04:23.02,1:04:25.11,Default,,0,0,0,,Әһем
Dialogue: 0,1:04:25.61,1:04:26.94,Default,,0,0,0,,Гохон Гохон
Dialogue: 0,1:04:27.07,1:04:29.15,Default,,0,0,0,,Сонымен қатар, демікпе
Dialogue: 0,1:04:29.28,1:04:33.66,Default,,0,0,0,,Сондықтан мен жүздеген мың доллар қарызға баттым...
Dialogue: 0,1:04:33.78,1:04:34.70,Default,,0,0,0,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,1:04:34.82,1:04:39.33,Default,,0,0,0,,Жауапкершілікті алып, өсиет қалдырыңыз...
Dialogue: 0,1:04:39.45,1:04:40.71,Default,,0,0,0,,Күрсін...
Dialogue: 0,1:04:40.83,1:04:43.46,Default,,0,0,0,,Біз айырылысып қала жаздадық...
Dialogue: 0,1:04:43.58,1:04:46.29,Default,,0,0,0,,Біз ертең де солай уәде ете алдық...
Dialogue: 0,1:04:46.84,1:04:50.34,Default,,0,0,0,,Бұл Тацуёси әкесінің ағаш қылышының арқасында болды.
Dialogue: 0,1:04:52.13,1:04:54.22,Default,,0,0,0,,Ертең не болар екен...
Dialogue: 0,1:04:55.26,1:04:57.10,Default,,0,0,0,,Жазықсыз қылмыс
Dialogue: 0,1:04:57.22,1:04:58.81,Default,,0,0,0,,Бұл туралы шешім қабылданды
Dialogue: 0,1:05:01.48,1:05:02.69,Default,,0,0,0,,Маған көмектесші, ата...
Dialogue: 0,1:05:02.81,1:05:04.85,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,1:05:04.94,1:05:06.52,Default,,0,0,0,,Иә, абайсыздықты доғар!
Dialogue: 0,1:05:06.61,1:05:07.90,Default,,0,0,0,,Офицер Сузукидің ұлы...
Dialogue: 0,1:05:07.98,1:05:10.65,Default,,0,0,0,,Сен Шинконың досын білесің бе?
Dialogue: 0,1:05:10.78,1:05:13.03,Default,,0,0,0,,О, дұрыс...
Dialogue: 0,1:05:13.15,1:05:15.03,Default,,0,0,0,,Шинко сізді естиді.
Dialogue: 0,1:05:15.16,1:05:17.16,Default,,0,0,0,,Мен сондай адаммын.
Dialogue: 0,1:05:18.24,1:05:20.79,Default,,0,0,0,,Менің өзіммен шамалас балам бар.
Dialogue: 0,1:05:21.16,1:05:24.29,Default,,0,0,0,,Әй, өлгенде ауырады ма?
Dialogue: 0,1:05:24.54,1:05:25.54,Default,,0,0,0,,Уф
Dialogue: 0,1:05:25.75,1:05:26.83,Default,,0,0,0,,Ал...
Dialogue: 0,1:05:26.96,1:05:30.84,Default,,0,0,0,,Сен тағы да мектеп оқушысы сияқтысың...
Dialogue: 0,1:05:30.96,1:05:31.80,Default,,0,0,0,,(Толық шоғырлану тынысы)
Dialogue: 0,1:05:31.88,1:05:32.88,Default,,0,0,0,,Бетінде бір атмосфера.
Dialogue: 0,1:05:33.01,1:05:36.68,Default,,0,0,0,,Тұңғыш ұлыңыз мұны байыппен қабылдады ма?
Dialogue: 0,1:05:36.80,1:05:40.68,Default,,0,0,0,,Менің ойымша, әртүрлі азғырулар болды.
Dialogue: 0,1:05:41.06,1:05:42.52,Default,,0,0,0,,Ең алдымен -
Dialogue: 0,1:05:42.64,1:05:45.31,Default,,0,0,0,,Оны бомба ұстап алған болуы керек.
Dialogue: 0,1:05:45.85,1:05:47.90,Default,,0,0,0,,Бұл әңгіме.
Dialogue: 0,1:05:48.02,1:05:50.52,Default,,0,0,0,,Бұл жазықсыз қылмыс деп айтпаңыз
Dialogue: 0,1:05:51.15,1:05:52.11,Default,,0,0,0,,Ертең-
Dialogue: 0,1:05:53.61,1:05:56.20,Default,,0,0,0,,Ол сондай жарқырап көрінсе де
Dialogue: 0,1:05:56.82,1:05:58.95,Default,,0,0,0,,Мың жылдық сиқыр...
Dialogue: 0,1:05:59.91,1:06:01.99,Default,,0,0,0,,Оның енді еш пайдасы жоқ.
Dialogue: 0,1:06:04.46,1:06:06.42,Default,,0,0,0,,Мен ұмытып қалдым
Dialogue: 0,1:06:07.17,1:06:11.00,Default,,0,0,0,,Мен Киикоға Glico электр желдеткішін беруге уәде бердім.
Dialogue: 0,1:06:11.13,1:06:12.88,Default,,0,0,0,,Барсам болады ма?
Dialogue: 0,1:06:13.01,1:06:14.47,Default,,0,0,0,,Ертең болса ше?\NМен
Dialogue: 0,1:06:14.59,1:06:17.22,Default,,0,0,0,,-ге баруға уәде бердім\NМен
Dialogue: 0,1:06:17.22,1:06:17.68,Default,,0,0,0,,-ге баруға уәде бердім
Dialogue: 0,1:06:17.22,1:06:17.68,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,1:06:17.68,1:06:18.18,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,1:06:18.18,1:06:19.47,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,1:06:18.18,1:06:19.47,Default,,0,0,0,,Жүректеріңізді құрбан етіңіздер!! Жүректеріңізді құрбан етіңіздер!! (Әскери полиция) Хич
Dialogue: 0,1:06:19.47,1:06:22.10,Default,,0,0,0,,Әй, мама, бүгін мен жақсы бала болдым ба?
Dialogue: 0,1:06:23.64,1:06:26.73,Default,,0,0,0,,Шинко~ Ең болмаса фонарь алып кел...
Dialogue: 0,1:06:26.85,1:06:28.52,Default,,0,0,0,,Түсіндім!
Dialogue: 0,1:06:41.41,1:06:44.04,Default,,0,0,0,,Анашым, қарным ашты.
Dialogue: 0,1:06:44.12,1:06:47.54,Default,,0,0,0,,Әй, Микчанның асқазаны әлдеқашан...
Dialogue: 0,1:06:47.62,1:06:49.38,Default,,0,0,0,,Хаа ха ха ха ха
Dialogue: 0,1:06:57.13,1:06:58.97,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,1:06:59.47,1:07:01.18,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,1:07:09.02,1:07:10.27,Default,,0,0,0,,Тацуёси
Dialogue: 0,1:07:10.40,1:07:12.15,Default,,0,0,0,,Сіз сондасыз ба? Ха
Dialogue: 0,1:07:14.82,1:07:17.40,Default,,0,0,0,,Сізде Тацуёси бар ма?
Dialogue: 0,1:07:17.53,1:07:18.86,Default,,0,0,0,,Шинко?
Dialogue: 0,1:07:19.36,1:07:20.45,Default,,0,0,0,,Иә...
Dialogue: 0,1:07:22.91,1:07:24.62,Default,,0,0,0,,Ертең келгенде...
Dialogue: 0,1:07:25.49,1:07:28.21,Default,,0,0,0,,Менімен ойнама деп бәрі айтады.
Dialogue: 0,1:07:28.96,1:07:32.33,Default,,0,0,0,,Ертеңгі күннің уәдесі жақсы.
Dialogue: 0,1:07:33.04,1:07:37.63,Default,,0,0,0,,Мен бүгін кешке Хизуруды табуды ойлап жүрмін.
Dialogue: 0,1:07:37.92,1:07:39.34,Default,,0,0,0,,Екі адам?
Dialogue: 0,1:07:39.47,1:07:41.09,Default,,0,0,0,,Мен үйден қашып кеттім
Dialogue: 0,1:07:41.76,1:07:44.85,Default,,0,0,0,,Бірақ маған енді Тацуёсимен ойнаудың қажеті жоқ.
Dialogue: 0,1:07:44.97,1:07:46.97,Default,,0,0,0,,Ең жаманы сол бар...
Dialogue: 0,1:07:47.14,1:07:48.23,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,1:07:48.35,1:07:49.85,Default,,0,0,0,,Калифорния
Dialogue: 0,1:07:50.23,1:07:52.02,Default,,0,0,0,,Мынау ана жақтағы әйел емес пе?
Dialogue: 0,1:07:52.15,1:07:54.82,Default,,0,0,0,,Оны жаман әйел дейді.
Dialogue: 0,1:07:56.15,1:07:57.57,Default,,0,0,0,,(Тодороки) Оған өз қалауынша сол күшті босатуға жол беру қауіпті
Dialogue: 0,1:07:57.69,1:08:00.61,Default,,0,0,0,,Мен туыстарыммен сөйлесуге бардым, бүгін қайтпаймын.
Dialogue: 0,1:08:01.78,1:08:03.03,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:08:03.45,1:08:05.49,Default,,0,0,0,,Хизуру жақсы емес.
Dialogue: 0,1:08:07.08,1:08:10.33,Default,,0,0,0,,Атам үйреткен мың жылдық сиқыр...
Dialogue: 0,1:08:10.46,1:08:11.96,Default,,0,0,0,,Иә, бітті.
Dialogue: 0,1:08:12.71,1:08:15.04,Default,,0,0,0,,Солай ма? Соны айтсам да
Dialogue: 0,1:08:16.59,1:08:18.55,Default,,0,0,0,,Тацуёси, кеттік.
Dialogue: 0,1:08:18.80,1:08:19.72,Default,,0,0,0,,Қайда?
Dialogue: 0,1:08:19.84,1:08:22.43,Default,,0,0,0,,Ертеңгі уәде етілген кек
Dialogue: 0,1:08:22.72,1:08:26.47,Default,,0,0,0,,Бір шо күріш кез келген жерге кетеді
Dialogue: 0,1:08:37.94,1:08:39.28,Default,,0,0,0,,Олай болса, жас ханым.
Dialogue: 0,1:08:39.36,1:08:42.57,Default,,0,0,0,,Күйеуіңіз үйге келгенше есікті жабық ұстаңыз.
Dialogue: 0,1:08:42.70,1:08:44.70,Default,,0,0,0,,Еңбегіңіз үшін рахмет.
Dialogue: 0,1:08:50.58,1:08:51.75,Default,,0,0,0,,(пошта жәшігінің ашылған дыбысы)
Dialogue: 0,1:08:51.91,1:08:52.92,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:56.67,1:08:57.88,Default,,0,0,0,,Хат?
Dialogue: 0,1:09:04.93,1:09:07.56,Default,,0,0,0,,«Құрметті Киико-сама, кешіріңіз.»
Dialogue: 0,1:09:08.18,1:09:10.35,Default,,0,0,0,,Ха! Шинко-чан?
Dialogue: 0,1:09:13.10,1:09:15.52,Default,,0,0,0,,«Бұдан былай біз алысқа кетеміз...»
Dialogue: 0,1:09:15.65,1:09:19.15,Default,,0,0,0,,«Мені болашақта бір бай алып кетуі мүмкін».
Dialogue: 0,1:09:19.27,1:09:22.57,Default,,0,0,0,,«Сізді ұрлаушы топ ұстап алуыңыз мүмкін».
Dialogue: 0,1:09:22.70,1:09:23.99,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:09:25.70,1:09:29.54,Default,,0,0,0,,Не айтып тұрғаныңызды түсінбеймін, Шинко-чан...
Dialogue: 0,1:09:31.45,1:09:32.66,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:09:33.33,1:09:37.79,Default,,0,0,0,,Бір-бірімізді түсіне алмайтындай алшақтап кеттік пе деп ойлаймын.
Dialogue: 0,1:09:38.67,1:09:42.38,Default,,0,0,0,,«Учиха, мың жылдық сиқырды қолдануды доғар...»
Dialogue: 0,1:09:42.51,1:09:44.51,Default,,0,0,0,,«Барлық дайындықпен...»
Dialogue: 0,1:09:44.63,1:09:47.34,Default,,0,0,0,,«Мен Кииконы сүйретуді доғарамын.»
Dialogue: 0,1:09:47.47,1:09:50.35,Default,,0,0,0,,«Бәрі үшін кешірім сұраймын».
Dialogue: 0,1:09:51.31,1:09:53.10,Default,,0,0,0,,Неге деп ойлаймын
Dialogue: 0,1:09:53.89,1:09:56.35,Default,,0,0,0,,Мен енді анамды ойламаймын...
Dialogue: 0,1:09:56.48,1:09:59.15,Default,,0,0,0,,Есіңде қалмауды шешкендіктен бе?
Dialogue: 0,1:09:59.52,1:10:01.40,Default,,0,0,0,,Сонда Шинко-чан да?
Dialogue: 0,1:10:03.69,1:10:05.65,Default,,0,0,0,,Бірақ, Шинко-чан
Dialogue: 0,1:10:05.78,1:10:06.91,Default,,0,0,0,,Сонымен, не болды?
Dialogue: 0,1:10:06.99,1:10:09.49,Default,,0,0,0,,Синко-чан ғана білетін мың жыл бұрынғы қыз...
Dialogue: 0,1:10:09.62,1:10:11.24,Default,,0,0,0,,Мен сені аяймын.
Dialogue: 0,1:10:15.37,1:10:18.50,Default,,0,0,0,,Бала кезімде анам оқыған кітап
Dialogue: 0,1:10:20.25,1:10:23.59,Default,,0,0,0,,...Мен мұны әкемнің аузынан естігендіктен ғана білемін.
Dialogue: 0,1:10:27.68,1:10:30.10,Default,,0,0,0,,Егер Шинко-чан болмаса...
Dialogue: 0,1:10:30.18,1:10:33.22,Default,,0,0,0,,Егер мен жалғыз болсам...
Dialogue: 0,1:10:33.56,1:10:36.35,Default,,0,0,0,,Мен ол жерге міндетті түрде бара алмаймын.
Dialogue: 0,1:10:36.48,1:10:40.81,Default,,0,0,0,,(Шинко мен Киконың күлкісі)
Dialogue: 0,1:11:00.04,1:11:02.63,Default,,0,0,0,,Сатсу патрульдерінің саны артты.
Dialogue: 0,1:11:03.21,1:11:05.01,Default,,0,0,0,,Өйткені бұл болды.
Dialogue: 0,1:11:05.13,1:11:06.55,Default,,0,0,0,,Бұл полиция оқиғасы?
Dialogue: 0,1:11:07.97,1:11:09.55,Default,,0,0,0,,Осы артқы аллеяда-
Dialogue: 0,1:11:09.68,1:11:13.47,Default,,0,0,0,,Мен әкемді аққұба әйелмен бірге көрдім.
Dialogue: 0,1:11:13.60,1:11:16.68,Default,,0,0,0,,Бұл бар Калифорния.
Dialogue: 0,1:11:16.93,1:11:19.23,Default,,0,0,0,,Қорқынышты ма? Шинко
Dialogue: 0,1:11:20.48,1:11:22.48,Default,,0,0,0,,Не... не?!
Dialogue: 0,1:11:22.61,1:11:24.65,Default,,0,0,0,,Неліктен бұлай болды?
Dialogue: 0,1:11:24.73,1:11:26.57,Default,,0,0,0,,Білмеймін (Шинко) Білмеймін...!
Dialogue: 0,1:11:26.69,1:11:29.45,Default,,0,0,0,,Мен оны тағы немен ұратынымды білмеймін.
Dialogue: 0,1:11:29.57,1:11:30.86,Default,,0,0,0,,Кеттік!
Dialogue: 0,1:11:31.37,1:11:33.16,Default,,0,0,0,,Менің әдебиетімді мазақ етесің бе?
Dialogue: 0,1:11:33.28,1:11:34.95,Default,,0,0,0,,Әй, емледен басынан баста.
Dialogue: 0,1:11:35.08,1:11:37.00,Default,,0,0,0,,Тохо? Білмеймін…
Dialogue: 0,1:11:38.21,1:11:40.58,Default,,0,0,0,,Міне, сіз!
Dialogue: 0,1:11:40.71,1:11:43.13,Default,,0,0,0,,Ендеше, уайымдамаңыздар, маскүнемдер.
Dialogue: 0,1:11:43.21,1:11:45.92,Default,,0,0,0,,Ой, жарайды, мұнымен тоқтап қалма.
Dialogue: 0,1:11:46.05,1:11:48.05,Default,,0,0,0,,Көбірек істегіңіз келе ме?
Dialogue: 0,1:11:48.17,1:11:50.05,Default,,0,0,0,,О! Балалар сендерде де сыра бар ма?
Dialogue: 0,1:11:51.43,1:11:53.35,Default,,0,0,0,,Олармен көз тигізбеңіз
Dialogue: 0,1:11:54.51,1:11:55.51,Default,,0,0,0,,Иә
Dialogue: 0,1:11:55.89,1:11:58.18,Default,,0,0,0,,Тонтенкан Тонтенкан
Dialogue: 0,1:11:58.31,1:12:00.81,Default,,0,0,0,,Мың жыл бұрынғы ұста...
Dialogue: 0,1:12:02.06,1:12:06.57,Default,,0,0,0,,Сол маңда өзен бар еді, мен кептеліп қала жаздадым...
Dialogue: 0,1:12:07.36,1:12:10.95,Default,,0,0,0,,Тік бұрышты өзен, ұзын дуалмен қоршалған сарай...
Dialogue: 0,1:12:11.07,1:12:14.62,Default,,0,0,0,,Онда тұратын қыз қуыршақтармен ойнап отыр.
Dialogue: 0,1:12:14.74,1:12:19.33,Default,,0,0,0,,Дұрыс, мен... Ол баланың түрін бір рет көрдім...
Dialogue: 0,1:12:19.41,1:12:21.00,Default,,0,0,0,,Әйелі...
Dialogue: 0,1:12:21.12,1:12:22.33,Default,,0,0,0,,Гүлдер...
Dialogue: 0,1:12:22.67,1:12:24.38,Default,,0,0,0,,Ақ гүл
Dialogue: 0,1:12:24.54,1:12:26.92,Default,,0,0,0,,Ол осылай гүлдейді
Dialogue: 0,1:12:27.46,1:12:30.30,Default,,0,0,0,,Көп адам күлді.
Dialogue: 0,1:12:31.63,1:12:34.30,Default,,0,0,0,,Бірақ ол бала күлмейді
Dialogue: 0,1:12:35.76,1:12:38.52,Default,,0,0,0,,Ол менің ең көп күлгім келетін адам.
Dialogue: 0,1:12:38.64,1:12:40.14,Default,,0,0,0,,Шинко-чан
Dialogue: 0,1:12:40.93,1:12:42.94,Default,,0,0,0,,Ертеңгі уәде...
Dialogue: 0,1:12:43.31,1:12:45.61,Default,,0,0,0,,Ертең бәріміз бірге күлеміз
Dialogue: 0,1:12:46.65,1:12:47.48,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:48.28,1:12:49.99,Default,,0,0,0,,Ол бала бүгін жоқ.
Dialogue: 0,1:12:51.24,1:12:52.40,Default,,0,0,0,,Не!?
Dialogue: 0,1:12:53.11,1:12:54.49,Default,,0,0,0,,Мен мұны білмей тұрып...
Dialogue: 0,1:12:54.62,1:12:56.49,Default,,0,0,0,,Білмей тұрып көрдім.
Dialogue: 0,1:12:56.62,1:12:58.16,Default,,0,0,0,,А, бар! ?
Dialogue: 0,1:12:58.41,1:13:00.12,Default,,0,0,0,,(Цубаки) Косей! Уф!
Dialogue: 0,1:13:00.25,1:13:01.91,Default,,0,0,0,,Сондықтан, егер Урарака ханым алғашқы қадамды жасаса…
Dialogue: 0,1:13:02.04,1:13:03.58,Default,,0,0,0,,Иә? Ах! !
Dialogue: 0,1:13:04.79,1:13:06.50,Default,,0,0,0,,Май-май бар
Dialogue: 0,1:13:11.80,1:13:13.18,Default,,0,0,0,,Ха...
Dialogue: 0,1:13:13.30,1:13:15.43,Default,,0,0,0,,Ханшайым! Ханшайым! (Кико) А... иә?
Dialogue: 0,1:13:15.51,1:13:18.14,Default,,0,0,0,,Кішкентай ханшайым
Dialogue: 0,1:13:19.60,1:13:21.43,Default,,0,0,0,,Жүр, кеттік
Dialogue: 0,1:13:23.19,1:13:24.31,Default,,0,0,0,,Ах...
Dialogue: 0,1:13:25.73,1:13:27.40,Default,,0,0,0,,Ах!
Dialogue: 0,1:13:27.73,1:13:30.57,Default,,0,0,0,,(медбикенің айқайлауы)
Dialogue: 0,1:13:30.69,1:13:33.57,Default,,0,0,0,,Сіз мұны істей алмайсыз. Мында басыңыз.
Dialogue: 0,1:13:35.16,1:13:36.20,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,1:13:40.95,1:13:42.16,Default,,0,0,0,,Әдемі!
Dialogue: 0,1:13:42.29,1:13:45.25,Default,,0,0,0,,Керемет! гүлдерге толы
Dialogue: 0,1:13:46.13,1:13:48.00,Default,,0,0,0,,Ах, Татара тауы
Dialogue: 0,1:13:48.71,1:13:50.38,Default,,0,0,0,,Бірдей пішін!
Dialogue: 0,1:13:51.92,1:13:55.09,Default,,0,0,0,,Тонтенкан Тонтенкан Тонтенкан
Dialogue: 0,1:13:56.05,1:13:57.26,Default,,0,0,0,,Хааа~
Dialogue: 0,1:14:00.39,1:14:03.81,Default,,0,0,0,,Тонтенкан Тонтенкан Тонтенкан Тонтенкан
Dialogue: 0,1:14:03.93,1:14:05.60,Default,,0,0,0,,Ғажайып, ғажап, ғажап, Шинко-чан
Dialogue: 0,1:14:06.73,1:14:08.69,Default,,0,0,0,,Мың жыл бұрынғы әлем―
Dialogue: 0,1:14:08.81,1:14:11.32,Default,,0,0,0,,Берілме, Шинко-чан!
Dialogue: 0,1:14:16.91,1:14:18.53,Default,,0,0,0,,Уау!
Dialogue: 0,1:14:18.62,1:14:20.58,Default,,0,0,0,,(Әйелдің күлкісі)
Dialogue: 0,1:14:20.70,1:14:23.41,Default,,0,0,0,,Келесі жолы ақша әкелуді ұмытпаңыз!
Dialogue: 0,1:14:25.04,1:14:27.75,Default,,0,0,0,,Сабырлы болыңыз, жақындап қалды
Dialogue: 0,1:14:28.33,1:14:29.67,Default,,0,0,0,,Жақында
Dialogue: 0,1:14:29.79,1:14:32.13,Default,,0,0,0,,Жақында
Dialogue: 0,1:14:32.34,1:14:35.26,Default,,0,0,0,,Жақында кездесеміз. Мен ол қызды кездестіремін.
Dialogue: 0,1:14:35.88,1:14:38.34,Default,,0,0,0,,Жақында
Dialogue: 0,1:14:38.47,1:14:39.68,Default,,0,0,0,,Жақында!
Dialogue: 0,1:14:44.52,1:14:46.85,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,1:14:46.98,1:14:48.31,Default,,0,0,0,,Міне
Dialogue: 0,1:14:50.44,1:14:51.32,Default,,0,0,0,,Мұнда
Dialogue: 0,1:14:57.61,1:15:00.70,Default,,0,0,0,,(Мысық қаупі)
Dialogue: 0,1:15:14.00,1:15:15.46,Default,,0,0,0,,Ка~пеппе
Dialogue: 0,1:15:18.68,1:15:24.35,Default,,0,0,0,,(Ерлер мен әйелдер күледі)
Dialogue: 0,1:15:27.52,1:15:28.89,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,1:15:29.02,1:15:31.65,Default,,0,0,0,,Тоқта, солай ма?
Dialogue: 0,1:15:33.65,1:15:34.90,Default,,0,0,0,,Хмм...
Dialogue: 0,1:15:38.32,1:15:41.20,Default,,0,0,0,,Хахаха хахаха ха...
Dialogue: 0,1:15:41.32,1:15:42.57,Default,,0,0,0,,О?
Dialogue: 0,1:15:45.87,1:15:48.46,Default,,0,0,0,,О, оны қалай қойдыңыз?
Dialogue: 0,1:15:48.58,1:15:49.96,Default,,0,0,0,,Балалар
Dialogue: 0,1:15:50.54,1:15:51.83,Default,,0,0,0,,Я~
Dialogue: 0,1:15:53.46,1:15:57.17,Default,,0,0,0,,Уа, сенің апаң... Калифорния штатындағы әйел ме?
Dialogue: 0,1:15:57.55,1:15:58.55,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,1:16:00.63,1:16:02.01,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,1:16:02.14,1:16:04.72,Default,,0,0,0,,Не? Анау ұйықтап жатқан піскен иіс
Dialogue: 0,1:16:05.06,1:16:06.93,Default,,0,0,0,,Менің тәтем Бар Кали... (Бар әйел) Дұрыс!
Dialogue: 0,1:16:07.06,1:16:10.02,Default,,0,0,0,,Сіздің әпкеңіз Калифорния штатындағы бар әйел.
Dialogue: 0,1:16:10.14,1:16:13.23,Default,,0,0,0,,(Әйел мен Оябунның күлкісі)
Dialogue: 0,1:16:13.36,1:16:16.86,Default,,0,0,0,,Қарт екінші қабатта гангстер жүргізіп жатыр ма? ?
Dialogue: 0,1:16:16.98,1:16:18.11,Default,,0,0,0,,Шинко
Dialogue: 0,1:16:19.82,1:16:24.49,Default,,0,0,0,,Цк, дауыстап айқайлап, «Иә!» деп айтыңыз.
Dialogue: 0,1:16:24.62,1:16:30.25,Default,,0,0,0,,Кішкентай бейбақтар, жаман мінез-құлыққа жақсы тәрбиелі екенсіңдер.
Dialogue: 0,1:16:30.83,1:16:34.25,Default,,0,0,0,,О! Ата-анаңның білімі саған жетпесе...
Dialogue: 0,1:16:35.04,1:16:39.92,Default,,0,0,0,,Біз мейірімді ата-ана ретінде әрекет етуіміз керек.
Dialogue: 0,1:16:40.05,1:16:43.34,Default,,0,0,0,,Мен оны саған беремін.
Dialogue: 0,1:16:46.14,1:16:47.14,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:47.26,1:16:48.18,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:48.72,1:16:50.39,Default,,0,0,0,,Ноу? (Шинко) Хе...!
Dialogue: 0,1:16:50.48,1:16:54.86,Default,,0,0,0,,Аққұба әйел! Тацуйоши кек алуға келді!
Dialogue: 0,1:16:55.19,1:16:58.11,Default,,0,0,0,,Тацуёсидің әкесі ауыр полиция қызметкері.
Dialogue: 0,1:16:58.23,1:17:00.99,Default,,0,0,0,,Мен аққұба әйелдің қолына түсіп, өз-өзіме қол жұмсадым...
Dialogue: 0,1:17:00.99,1:17:01.61,Default,,0,0,0,,Мен аққұба әйелдің қолына түсіп, өз-өзіме қол жұмсадым...
Dialogue: 0,1:17:00.99,1:17:01.61,Default,,0,0,0,,Ах
Dialogue: 0,1:17:01.61,1:17:01.74,Default,,0,0,0,,Ах
Dialogue: 0,1:17:01.74,1:17:02.20,Default,,0,0,0,,Ах
Dialogue: 0,1:17:01.74,1:17:02.20,Default,,0,0,0,,Біз жаудан кек алу үшін жиналдық!
Dialogue: 0,1:17:02.20,1:17:04.11,Default,,0,0,0,,Біз жаудан кек алу үшін жиналдық!
Dialogue: 0,1:17:06.95,1:17:10.16,Default,,0,0,0,,Бізге ертеңгі уәдемізді қайтар!
Dialogue: 0,1:17:13.25,1:17:15.71,Default,,0,0,0,,Уф... Уф... Уф...
Dialogue: 0,1:17:15.83,1:17:16.96,Default,,0,0,0,,Мен—
Dialogue: 0,1:17:18.55,1:17:19.50,Default,,0,0,0,,Ах
Dialogue: 0,1:17:20.88,1:17:21.72,Default,,0,0,0,,Ах!
Dialogue: 0,1:17:21.80,1:17:25.14,Default,,0,0,0,,Әй, сарайда бизнеспен айналысудан үзіліс алғаным үшін кешіріңіз.
Dialogue: 0,1:17:25.22,1:17:25.39,Default,,0,0,0,,Уф
Dialogue: 0,1:17:25.39,1:17:27.18,Default,,0,0,0,,Уф
Dialogue: 0,1:17:25.39,1:17:27.18,Default,,0,0,0,,Біз өте өкінеміз.
Dialogue: 0,1:17:27.18,1:17:28.97,Default,,0,0,0,,Біз өте өкінеміз.
Dialogue: 0,1:17:29.22,1:17:33.77,Default,,0,0,0,,Мен жаман балық жедім, үйдегілердің бәрі соққыға жығылды...
Dialogue: 0,1:17:33.89,1:17:35.10,Default,,0,0,0,,Сіз де?
Dialogue: 0,1:17:35.23,1:17:37.52,Default,,0,0,0,,Асқазаныңыз ауырады ма? (Чифуру) Ой-оу.
Dialogue: 0,1:17:37.65,1:17:41.57,Default,,0,0,0,,Бірақ мен анам мен әпкелеріме қарауым керек.
Dialogue: 0,1:17:42.11,1:17:45.82,Default,,0,0,0,,А, мен ұмытып қалдым! Үйдегі кішкентай құстарға азық пен ресурстар...
Dialogue: 0,1:17:45.95,1:17:48.45,Default,,0,0,0,,Ол үнемі осылай көрінеді
Dialogue: 0,1:17:50.04,1:17:51.54,Default,,0,0,0,,Көбірек күлкім келеді
Dialogue: 0,1:17:51.66,1:17:52.54,Default,,0,0,0,,Иә!
Dialogue: 0,1:17:54.54,1:17:57.29,Default,,0,0,0,,Мына монахтың түрі сондай оғаш па?
Dialogue: 0,1:17:57.79,1:18:00.25,Default,,0,0,0,,Бекер күлме, Тацуёси.
Dialogue: 0,1:18:00.50,1:18:02.30,Default,,0,0,0,,Тацуоши!
Dialogue: 0,1:18:06.13,1:18:10.22,Default,,0,0,0,,Ә? Кім туралы айтып тұрсың?
Dialogue: 0,1:18:12.27,1:18:13.52,Default,,0,0,0,,Жарайды, солай.
Dialogue: 0,1:18:13.64,1:18:16.73,Default,,0,0,0,,Мені ағаш қылышпен ұрсаң, якудзаға айналасың.
Dialogue: 0,1:18:16.73,1:18:17.60,Default,,0,0,0,,Мені ағаш қылышпен ұрсаң, якудзаға айналасың.
Dialogue: 0,1:18:16.73,1:18:17.60,Default,,0,0,0,,(Әйелдің айқайы)
Dialogue: 0,1:18:17.60,1:18:17.73,Default,,0,0,0,,(Әйелдің айқайы)
Dialogue: 0,1:18:17.73,1:18:19.15,Default,,0,0,0,,(Әйелдің айқайы)
Dialogue: 0,1:18:17.73,1:18:19.15,Default,,0,0,0,,Иә? Сіз не істедіңіз?
Dialogue: 0,1:18:19.27,1:18:20.15,Default,,0,0,0,,Кел, күл!
Dialogue: 0,1:18:23.57,1:18:25.28,Default,,0,0,0,,Ал, ішіңіз.
Dialogue: 0,1:18:26.57,1:18:27.82,Default,,0,0,0,,Ноу монах
Dialogue: 0,1:18:28.24,1:18:31.16,Default,,0,0,0,,Расында жеңетін бегоманы қалай қыруға болады
Dialogue: 0,1:18:31.28,1:18:33.83,Default,,0,0,0,,Мен сізге айтайын
Dialogue: 0,1:18:34.16,1:18:35.46,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:38.25,1:18:41.09,Default,,0,0,0,,Цк, сен дос емес сияқтысың.
Dialogue: 0,1:18:41.21,1:18:42.30,Default,,0,0,0,,Сәлем
Dialogue: 0,1:18:42.59,1:18:46.13,Default,,0,0,0,,Неге маған өтірік айтпадың?
Dialogue: 0,1:18:46.22,1:18:48.51,Default,,0,0,0,,Хехе, солай.
Dialogue: 0,1:18:48.64,1:18:52.72,Default,,0,0,0,,Бір күні мен Сузукидің күйеуіне ішуді айттым.
Dialogue: 0,1:18:53.01,1:18:56.94,Default,,0,0,0,,Күйеуім мән бермесе, Көзімнен нұр жауады.
Dialogue: 0,1:18:57.06,1:18:59.27,Default,,0,0,0,,Hmph ah
Dialogue: 0,1:18:59.40,1:19:00.90,Default,,0,0,0,,Көңілді көрінді
Dialogue: 0,1:19:02.19,1:19:03.90,Default,,0,0,0,,Сіз ақымақ нәрсе айтасыз...
Dialogue: 0,1:19:04.65,1:19:07.32,Default,,0,0,0,,Ол бала Сузуки мырзаның ұлы.
Dialogue: 0,1:19:07.45,1:19:09.41,Default,,0,0,0,,Мен сізге кем дегенде беигома жасауды үйретер едім...
Dialogue: 0,1:19:09.49,1:19:13.29,Default,,0,0,0,,Жоқ! Маған айтқым келмеді.
Dialogue: 0,1:19:13.87,1:19:15.12,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:16.62,1:19:18.00,Default,,0,0,0,,Әке-
Dialogue: 0,1:19:19.62,1:19:22.00,Default,,0,0,0,,«Айтайын ба?» деген кездерім болды.
Dialogue: 0,1:19:22.13,1:19:23.92,Default,,0,0,0,,Мен... «Иә» дедім.
Dialogue: 0,1:19:24.17,1:19:27.22,Default,,0,0,0,,Гетара, сен мені ұрдың.
Dialogue: 0,1:19:29.09,1:19:31.47,Default,,0,0,0,,Әкем бөлмеде болмағанда...
Dialogue: 0,1:19:33.14,1:19:35.77,Default,,0,0,0,,Мас болу, мас болу
Dialogue: 0,1:19:35.89,1:19:37.14,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,1:19:37.27,1:19:41.27,Default,,0,0,0,,(Тацуёсидің айқайы)
Dialogue: 0,1:19:56.54,1:19:59.79,Default,,0,0,0,,(баланың күлкісі)
Dialogue: 0,1:20:00.58,1:20:03.75,Default,,0,0,0,,Енді бала кезімде әкем...
Dialogue: 0,1:20:03.88,1:20:06.00,Default,,0,0,0,,Мен осы дүкеннің алдынан жүгірдім.
Dialogue: 0,1:20:06.25,1:20:10.84,Default,,0,0,0,,Мүмкін болса, мен сенімен бірге жүгіремін.
Dialogue: 0,1:20:11.05,1:20:13.76,Default,,0,0,0,,Уф... Әке...!
Dialogue: 0,1:20:15.01,1:20:17.31,Default,,0,0,0,,Иә, барыңыз, монах.
Dialogue: 0,1:20:18.52,1:20:20.19,Default,,0,0,0,,Кеттік, Тацуёси!
Dialogue: 0,1:20:20.31,1:20:22.94,Default,,0,0,0,,Уаааааааааааааааааааааааа!
Dialogue: 0,1:20:23.06,1:20:28.03,Default,,0,0,0,,Ах! ! Дааа! !
Dialogue: 0,1:20:28.15,1:20:32.28,Default,,0,0,0,,Уау! ! Дааа! !
Dialogue: 0,1:20:33.32,1:20:35.41,Default,,0,0,0,,Ах! ! (Шинко) Ах! !
Dialogue: 0,1:20:35.49,1:20:38.50,Default,,0,0,0,,Ах! !
Dialogue: 0,1:20:38.62,1:20:41.00,Default,,0,0,0,,Сәлем! Якмаширога!
Dialogue: 0,1:20:43.96,1:20:47.25,Default,,0,0,0,,Гао Гао Гао
Dialogue: 0,1:20:48.26,1:20:49.63,Default,,0,0,0,,Әй, бұл жын.
Dialogue: 0,1:20:49.76,1:20:52.01,Default,,0,0,0,,Аурудың көзі (Әпкелер) Уау!
Dialogue: 0,1:20:52.13,1:20:53.47,Default,,0,0,0,,Гао (әпкелер) Ах!
Dialogue: 0,1:20:53.59,1:20:55.97,Default,,0,0,0,,Мен бәрін ауыртамын~
Dialogue: 0,1:20:56.10,1:20:57.39,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,1:20:57.72,1:20:59.64,Default,,0,0,0,,Мынау... Ах.
Dialogue: 0,1:20:59.77,1:21:00.85,Default,,0,0,0,,Хосо мырза
Dialogue: 0,1:21:00.98,1:21:04.52,Default,,0,0,0,,Оның төрт көзі мен найзасы бар, сондықтан ол одан да күшті.
Dialogue: 0,1:21:05.02,1:21:07.07,Default,,0,0,0,,Жүр, мен жынды жеңемін.
Dialogue: 0,1:21:07.19,1:21:09.36,Default,,0,0,0,,Бұл жын! Бұл жын ғой!
Dialogue: 0,1:21:09.48,1:21:11.28,Default,,0,0,0,,Ei Ei Ei!
Dialogue: 0,1:21:11.40,1:21:14.53,Default,,0,0,0,,Ах! Жын қашып кетті
Dialogue: 0,1:21:14.66,1:21:17.78,Default,,0,0,0,,Тонери~ бізге көбірек көмек керек
Dialogue: 0,1:21:18.37,1:21:20.50,Default,,0,0,0,,Ммммммм
Dialogue: 0,1:21:23.79,1:21:25.29,Default,,0,0,0,,Гусак Гусак
Dialogue: 0,1:21:25.42,1:21:28.75,Default,,0,0,0,,Eye-tat-tat, ita-tatto… Eye-tatata…
Dialogue: 0,1:21:28.84,1:21:30.67,Default,,0,0,0,,Ахаха
Dialogue: 0,1:21:30.76,1:21:33.88,Default,,0,0,0,,Ах! !
Dialogue: 0,1:21:40.77,1:21:43.06,Default,,0,0,0,,♬~
Dialogue: 0,1:21:43.18,1:21:44.48,Default,,0,0,0,,Шинко
Dialogue: 0,1:21:45.19,1:21:46.35,Default,,0,0,0,,Мен...
Dialogue: 0,1:21:46.90,1:21:48.77,Default,,0,0,0,,Ол ертең жоқ болады
Dialogue: 0,1:21:49.77,1:21:50.86,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:51.53,1:21:55.95,Default,,0,0,0,,Ертең мен пойызбен Осакадағы анамның туыстарына барамын.
Dialogue: 0,1:21:58.83,1:22:01.04,Default,,0,0,0,,Мен уәде беремін
Dialogue: 0,1:22:01.16,1:22:03.16,Default,,0,0,0,,Мен лайықты ересек болдым...
Dialogue: 0,1:22:03.46,1:22:06.33,Default,,0,0,0,,Бегоманың қырыну және аяқты батпырауыққа қалай бекіту керек.
Dialogue: 0,1:22:06.46,1:22:09.00,Default,,0,0,0,,Балаларыңызды дұрыс оқытыңыз
Dialogue: 0,1:22:09.21,1:22:10.30,Default,,0,0,0,,Иә
Dialogue: 0,1:22:11.50,1:22:14.34,Default,,0,0,0,,Шинко, мынаны ал.
Dialogue: 0,1:22:14.47,1:22:15.47,Default,,0,0,0,,Иә
Dialogue: 0,1:22:18.26,1:22:19.68,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:22:19.97,1:22:21.31,Default,,0,0,0,,Хэджага Тацуйоши!
Dialogue: 0,1:22:22.31,1:22:26.31,Default,,0,0,0,,Оған дейін бар күшімізді салып, аянбай ойнайық!
Dialogue: 0,1:22:26.90,1:22:29.06,Default,,0,0,0,,Әртүрлі ойындарды көбірек біліңіз.
Dialogue: 0,1:22:29.19,1:22:31.73,Default,,0,0,0,,Мен мұны балаларыма беремін.
Dialogue: 0,1:22:31.86,1:22:34.82,Default,,0,0,0,,Хеджадан қатты ойнайық!
Dialogue: 0,1:22:34.95,1:22:36.95,Default,,0,0,0,,Шарасыз корпустың жолдастары...!
Dialogue: 0,1:22:37.91,1:22:39.66,Default,,0,0,0,,Хехехе
Dialogue: 0,1:22:40.08,1:22:42.45,Default,,0,0,0,,Хехехе ахаха
Dialogue: 0,1:22:42.87,1:22:47.83,Default,,0,0,0,,(Ұйқыдағы әпкелер)
Dialogue: 0,1:22:51.71,1:22:53.46,Default,,0,0,0,,Ертең де ойнайық
Dialogue: 0,1:22:53.59,1:22:54.84,Default,,0,0,0,,Иә
Dialogue: 0,1:22:55.05,1:22:57.63,Default,,0,0,0,,(жәндіктер мен бақа дыбыстары)
Dialogue: 0,1:22:57.76,1:23:00.14,Default,,0,0,0,,Ақыры шын күлдім.
Dialogue: 0,1:23:01.26,1:23:02.68,Default,,0,0,0,,Сол жігіт
Dialogue: 0,1:23:06.94,1:23:07.81,Default,,0,0,0,,Олай болса, біз де...
Dialogue: 0,1:23:07.81,1:23:08.77,Default,,0,0,0,,Олай болса, біз де...
Dialogue: 0,1:23:07.81,1:23:08.77,Default,,0,0,0,,(Мизуон)
Dialogue: 0,1:23:08.77,1:23:08.90,Default,,0,0,0,,(Мизуон)
Dialogue: 0,1:23:08.90,1:23:09.23,Default,,0,0,0,,(Мизуон)
Dialogue: 0,1:23:08.90,1:23:09.23,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:09.23,1:23:09.81,Default,,0,0,0,,Ах...
Dialogue: 0,1:23:11.40,1:23:12.48,Default,,0,0,0,,Иә?
Dialogue: 0,1:23:14.23,1:23:15.65,Default,,0,0,0,,≪Бұл жігіт не өзі?!≫
Dialogue: 0,1:23:22.58,1:23:25.37,Default,,0,0,0,,Қайырлы кеш Қайырлы кеш Қайырлы кеш
Dialogue: 0,1:23:25.50,1:23:29.25,Default,,0,0,0,,Иә~ (Шинко) Ха, ха... Аа~
Dialogue: 0,1:23:29.37,1:23:31.00,Default,,0,0,0,,Көшелер сонша көп, мүлде адасып кеттім.
Dialogue: 0,1:23:31.13,1:23:32.50,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:23:32.63,1:23:34.17,Default,,0,0,0,,Бұл Шинко Аоки.
Dialogue: 0,1:23:34.25,1:23:36.46,Default,,0,0,0,,Гликоның бонустық электр желдеткіші.
Dialogue: 0,1:23:36.59,1:23:38.43,Default,,0,0,0,,Оны Киикоға беруге уәде беріңіз.
Dialogue: 0,1:23:38.55,1:23:41.01,Default,,0,0,0,,Әй, Кико!
Dialogue: 0,1:23:41.14,1:23:43.26,Default,,0,0,0,,Менің досым Ао... (Кико) Шинко-чан!
Dialogue: 0,1:23:43.56,1:23:46.39,Default,,0,0,0,,Мен... таптым! (Шинко) Аяқ киіміңді ки!
Dialogue: 0,1:23:46.52,1:23:47.89,Default,,0,0,0,,Жүр, кеттік!
Dialogue: 0,1:23:48.02,1:23:49.89,Default,,0,0,0,,Біз қайда баруымыз керек?
Dialogue: 0,1:23:49.98,1:23:52.02,Default,,0,0,0,,(Сырқыраған дауыс)
Dialogue: 0,1:23:52.15,1:23:52.98,Default,,0,0,0,,Иә! ?
Dialogue: 0,1:23:53.40,1:23:54.94,Default,,0,0,0,,Асығыңыз! (Кико) Иә!
Dialogue: 0,1:23:55.07,1:23:56.65,Default,,0,0,0,,Әке, мен біраз уақытқа барамын.
Dialogue: 0,1:23:57.03,1:24:00.41,Default,,0,0,0,,Сіз барасыз ба? Эй... Кико? (Шинко/Кико) Фуфуфуфу
Dialogue: 0,1:24:03.58,1:24:05.70,Default,,0,0,0,,Хизуру алтын балығы тірі болды ма?
Dialogue: 0,1:24:06.33,1:24:08.41,Default,,0,0,0,,Көргім келеді Көргім келеді!
Dialogue: 0,1:24:08.50,1:24:09.96,Default,,0,0,0,,Оны көргіңіз келе ме? (Кико) Иә!
Dialogue: 0,1:24:10.08,1:24:12.96,Default,,0,0,0,,Көргім келеді Көргім келеді Көргім келеді Көргім келеді Көргім келеді!
Dialogue: 0,1:24:13.08,1:24:14.17,Default,,0,0,0,,Жарайды! !
Dialogue: 0,1:24:14.96,1:24:17.80,Default,,0,0,0,,Ха ха ха ха ха
Dialogue: 0,1:24:17.92,1:24:20.05,Default,,0,0,0,,Ах... (Кико) Шинко-чан! баяу!
Dialogue: 0,1:24:24.47,1:24:26.89,Default,,0,0,0,,Қайда? (Шинко) Міне! Сол аймақ
Dialogue: 0,1:24:30.89,1:24:33.31,Default,,0,0,0,,Осы жерде болған болуы керек.
Dialogue: 0,1:24:33.86,1:24:35.15,Default,,0,0,0,,Әй...
Dialogue: 0,1:24:35.27,1:24:36.65,Default,,0,0,0,,Хмм.
Dialogue: 0,1:24:37.44,1:24:41.61,Default,,0,0,0,,Бұл біртүрлі... бұл жерде әрине...
Dialogue: 0,1:24:42.28,1:24:42.78,Default,,0,0,0,,(Мизуон)
Dialogue: 0,1:24:42.78,1:24:43.78,Default,,0,0,0,,(Мизуон)
Dialogue: 0,1:24:42.78,1:24:43.78,Default,,0,0,0,,Ах!
Dialogue: 0,1:24:52.04,1:24:52.87,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,1:24:53.33,1:24:55.38,Default,,0,0,0,,Бұл рас (Шинко), солай емес пе?
Dialogue: 0,1:24:56.17,1:24:57.17,Default,,0,0,0,,Ах
Dialogue: 0,1:25:00.38,1:25:02.93,Default,,0,0,0,,Батарея бітті.
Dialogue: 0,1:25:03.05,1:25:04.72,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,1:25:07.14,1:25:09.02,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,1:25:10.02,1:25:11.10,Default,,0,0,0,,Мен жақсымын
Dialogue: 0,1:25:11.23,1:25:13.14,Default,,0,0,0,,Шинко-чан осында.
Dialogue: 0,1:25:13.90,1:25:18.19,Default,,0,0,0,,Сондай қараңғыда Құс жолының астында болу...
Dialogue: 0,1:25:18.57,1:25:21.28,Default,,0,0,0,,Бұл жерде көп нәрсе бар...
Dialogue: 0,1:25:22.11,1:25:25.41,Default,,0,0,0,,Олар біздің айналамызда жүргендей әсер қалдырады.
Dialogue: 0,1:25:26.20,1:25:28.20,Default,,0,0,0,,Иә, мен осындамын.
Dialogue: 0,1:25:28.87,1:25:30.45,Default,,0,0,0,,Тацуёсидің әкесі де...
Dialogue: 0,1:25:30.95,1:25:32.83,Default,,0,0,0,,Киконың анасы да
Dialogue: 0,1:25:32.96,1:25:37.29,Default,,0,0,0,,Бізді ұмытпасаң, осында мәңгі қал.
Dialogue: 0,1:25:38.00,1:25:41.42,Default,,0,0,0,,Дұрыс, мен оны жаңа ғана таптым.
Dialogue: 0,1:25:41.67,1:25:43.34,Default,,0,0,0,,Кітапқа жабысып қалды.
Dialogue: 0,1:25:44.43,1:25:46.64,Default,,0,0,0,,Бала кезімде анам
Dialogue: 0,1:25:47.97,1:25:50.72,Default,,0,0,0,,Киико, сен анаңа ұқсамайсың.
Dialogue: 0,1:25:50.85,1:25:53.10,Default,,0,0,0,,үшін? (Шинко) Бұрын мен үйде болдым.
Dialogue: 0,1:25:53.23,1:25:55.90,Default,,0,0,0,,Мен жүгіру жарысында Кииконы жеңе алмадым.
Dialogue: 0,1:25:56.02,1:25:59.32,Default,,0,0,0,,Негізі біз тобымызда ең баяумыз.
Dialogue: 0,1:25:59.52,1:26:02.86,Default,,0,0,0,,Шинко-чан өте жылдам көрінеді
Dialogue: 0,1:26:02.99,1:26:04.99,Default,,0,0,0,,Хэ-хэ, бірақ-
Dialogue: 0,1:26:05.45,1:26:07.82,Default,,0,0,0,,Сіз тек жасыл Кодзироға қарсы жеңе аласыз.
Dialogue: 0,1:26:07.95,1:26:09.37,Default,,0,0,0,,Кім? ол
Dialogue: 0,1:26:09.95,1:26:11.70,Default,,0,0,0,,Біз бұл туралы ойладық
Dialogue: 0,1:26:11.83,1:26:14.87,Default,,0,0,0,,Арқасына семсер алып, су бетінде жүгіріп келе жатқан адам
Dialogue: 0,1:26:17.42,1:26:19.25,Default,,0,0,0,,Бұл жерде де осындай заттар бар.
Dialogue: 0,1:26:19.38,1:26:20.42,Default,,0,0,0,,Хехе
Dialogue: 0,1:26:20.55,1:26:22.92,Default,,0,0,0,,Ішінде әлі көп нәрсе бар.
Dialogue: 0,1:26:23.05,1:26:25.13,Default,,0,0,0,,Шинко-чан осында! (Шинко) Ита!
Dialogue: 0,1:26:25.55,1:26:28.68,Default,,0,0,0,,Эй, сен не істейсің? Кико Шимазу! (Кико) Ахахахаха
Dialogue: 0,1:26:28.80,1:26:31.10,Default,,0,0,0,,Эй, эй... мынау! (Кико) Ахахаха
Dialogue: 0,1:26:31.22,1:26:33.31,Default,,0,0,0,,Неміс медицинасы мен ғылымында осындай нәрселер бар шығар—
Dialogue: 0,1:26:33.43,1:26:38.19,Default,,0,0,0,,Ахахха хахаха
Dialogue: 0,1:26:38.31,1:26:39.27,Default,,0,0,0,,Бірақ-
Dialogue: 0,1:26:40.11,1:26:42.48,Default,,0,0,0,,Бұл алтын балық шынайы.
Dialogue: 0,1:26:42.86,1:26:43.94,Default,,0,0,0,,Иә
Dialogue: 0,1:26:44.24,1:26:46.53,Default,,0,0,0,,Тіпті ертең де, одан кейінгі күні де, одан кейінгі күні де...
Dialogue: 0,1:26:46.65,1:26:48.74,Default,,0,0,0,,Осы жерде болса керек.
Dialogue: 0,1:26:49.20,1:26:50.20,Default,,0,0,0,,Иә
Dialogue: 0,1:26:50.66,1:26:53.16,Default,,0,0,0,,Шинко~ (Кико) Иә?
Dialogue: 0,1:27:03.25,1:27:04.38,Default,,0,0,0,,Уф
Dialogue: 0,1:27:05.26,1:27:06.63,Default,,0,0,0,,Оу Шинко
Dialogue: 0,1:27:06.76,1:27:08.26,Default,,0,0,0,,А, әке.
Dialogue: 0,1:27:08.34,1:27:09.93,Default,,0,0,0,,Хмф (Шинко) Хаа!
Dialogue: 0,1:27:10.89,1:27:13.35,Default,,0,0,0,,Әке! Әкең шын ба?
Dialogue: 0,1:27:13.47,1:27:16.56,Default,,0,0,0,,Не? Сіздің жалған әкеңіз бар ма?
Dialogue: 0,1:27:17.02,1:27:19.10,Default,,0,0,0,,Ғибадатхананың Ұлы Қожайыны үйіне сирек оралады.
Dialogue: 0,1:27:19.23,1:27:22.19,Default,,0,0,0,,Менің әкеме айналып бара жатыр деп ойладым.
Dialogue: 0,1:27:23.02,1:27:24.65,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,1:27:24.98,1:27:27.49,Default,,0,0,0,,Аталар уайымдайды.
Dialogue: 0,1:27:27.61,1:27:29.24,Default,,0,0,0,,Иә, мен атамды жақсы көремін.
Dialogue: 0,1:27:29.36,1:27:31.07,Default,,0,0,0,,Хмф, ау.
Dialogue: 0,1:27:31.70,1:27:34.79,Default,,0,0,0,,Армандауды жақсы көретін Шинко Аоки есімді адамның жартысынан көбі...
Dialogue: 0,1:27:34.91,1:27:39.17,Default,,0,0,0,,Қате болмаңыз, ол атаның ингредиенттерінен жасалған.
Dialogue: 0,1:27:39.58,1:27:41.21,Default,,0,0,0,,О? мм?
Dialogue: 0,1:27:41.33,1:27:42.63,Default,,0,0,0,,Бұл Киико Шимазу.
Dialogue: 0,1:27:42.75,1:27:44.50,Default,,0,0,0,,Мен Шинкомен бір сыныпта оқимын.
Dialogue: 0,1:27:44.63,1:27:46.97,Default,,0,0,0,,О, түсіндім, бұл
Dialogue: 0,1:27:47.09,1:27:48.47,Default,,0,0,0,,Бұл Тосуке Аоки.
Dialogue: 0,1:27:48.59,1:27:51.18,Default,,0,0,0,,Мен Ямагучи университетінде жасыл балдырларды зерттеп жатырмын.
Dialogue: 0,1:27:51.30,1:27:53.14,Default,,0,0,0,,Компанияның тұрғын үйіндегі бала
Dialogue: 0,1:27:54.14,1:27:57.43,Default,,0,0,0,,Хмф, онда жіберейік (Кико/Шинко) Хэхехе
Dialogue: 0,1:27:57.56,1:27:58.69,Default,,0,0,0,,Хахаха
Dialogue: 0,1:27:58.81,1:28:01.73,Default,,0,0,0,,Бірақ сендер жамансыңдар.
Dialogue: 0,1:28:01.94,1:28:03.77,Default,,0,0,0,,Әкесінің қызы
Dialogue: 0,1:28:03.90,1:28:07.11,Default,,0,0,0,,Идиот! Тіпті ата-ана мен баланың гендері сәл өзгеше.
Dialogue: 0,1:28:07.24,1:28:09.57,Default,,0,0,0,,Сіздікі менікі сияқты жақсы емес.
Dialogue: 0,1:28:09.70,1:28:10.95,Default,,0,0,0,,Хи хи нча
Dialogue: 0,1:28:12.41,1:28:15.54,Default,,0,0,0,,Ол жақсы адам, Шинконың әкесі.
Dialogue: 0,1:28:15.66,1:28:17.83,Default,,0,0,0,,Хехе, иә, жігітім.
Dialogue: 0,1:28:17.95,1:28:20.54,Default,,0,0,0,,Әркім, бәрі халық үшін.
Dialogue: 0,1:28:20.75,1:28:23.63,Default,,0,0,0,,Киико, ертең де ойнайық.
Dialogue: 0,1:28:23.75,1:28:24.84,Default,,0,0,0,,Иә
Dialogue: 0,1:28:30.13,1:28:32.01,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,1:28:35.89,1:28:37.64,Default,,0,0,0,,Хизуру Сенсей~
Dialogue: 0,1:28:39.27,1:28:41.10,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,1:28:41.23,1:28:47.23,Default,,0,0,0,,♪～
Dialogue: 0,1:29:18.64,1:29:22.56,Default,,0,0,0,,Қыстың аяғында атам дүниеден өтті...
Dialogue: 0,1:29:24.56,1:29:27.86,Default,,0,0,0,,Бұл жолы Шинко-чан көшіп барады.
Dialogue: 0,1:29:30.03,1:29:33.49,Default,,0,0,0,,Шинконың әкесі жұмыс істейтін және университет орналасқан қалашықта.
Dialogue: 0,1:29:33.61,1:29:34.61,Default,,0,0,0,,Барлығына!
Dialogue: 0,1:29:34.91,1:29:37.95,Default,,0,0,0,,Мен мұны істеймін Камекичи (Мицуко) Ах!
Dialogue: 0,1:29:38.08,1:29:41.00,Default,,0,0,0,,Сонда бұл Иә! (Шинко) Не?
Dialogue: 0,1:29:41.58,1:29:45.08,Default,,0,0,0,,Мен оны Тенжин қаласындағы жаңа тайяки дүкенінен сатып алдым.
Dialogue: 0,1:29:45.21,1:29:46.33,Default,,0,0,0,,Хехе
Dialogue: 0,1:29:46.50,1:29:48.63,Default,,0,0,0,,Мен бірден сонда барғым келді.
Dialogue: 0,1:29:48.80,1:29:50.17,Default,,0,0,0,,Рахмет
Dialogue: 0,1:29:50.30,1:29:52.63,Default,,0,0,0,,Канаяма Шокудодан келген Хироко мені жаман деп атаса да...
Dialogue: 0,1:29:52.76,1:29:54.09,Default,,0,0,0,,Мен жеңілуге шыдай алмаймын!
Dialogue: 0,1:29:54.22,1:29:56.05,Default,,0,0,0,,Иә! Мен жеңілемін деп ойлаймын
Dialogue: 0,1:29:56.18,1:29:57.51,Default,,0,0,0,,Шинко-чан!
Dialogue: 0,1:29:57.64,1:29:58.97,Default,,0,0,0,,Эй, сәлем
Dialogue: 0,1:29:59.10,1:30:01.35,Default,,0,0,0,,Шинко Тағы кездескенше~ (Фото) Сау болыңыз
Dialogue: 0,1:30:02.77,1:30:04.69,Default,,0,0,0,,(шөп дыбысы)
Dialogue: 0,1:30:05.44,1:30:07.86,Default,,0,0,0,,(шөптің дыбысы)
Dialogue: 0,1:30:08.94,1:30:11.69,Default,,0,0,0,,(шөп дыбысы)
Dialogue: 0,1:30:13.19,1:30:19.19,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory