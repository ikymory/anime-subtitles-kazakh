Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:40.70,0:00:42.70,Default,,0,0,0,,Хью!
Dialogue: 0,0:00:42.70,0:00:45.71,Default,,0,0,0,,Айт! Хмф!
Dialogue: 0,0:00:45.71,0:00:47.71,Default,,0,0,0,,Хмф!
Dialogue: 0,0:00:47.71,0:00:49.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:52.71,0:00:55.22,Default,,0,0,0,,Firebolt Wow!
Dialogue: 0,0:00:55.22,0:00:57.72,Default,,0,0,0,,Уф! Уау...
Dialogue: 0,0:00:57.72,0:00:59.72,Default,,0,0,0,,А Айша-сан?
Dialogue: 0,0:00:59.72,0:01:01.92,Default,,0,0,0,,Неге...
Dialogue: 0,0:01:05.06,0:01:07.06,Default,,0,0,0,,Кек сақтасаң, бұл қылық➡
Dialogue: 0,0:01:07.06,0:01:09.23,Default,,0,0,0,,Богиняны жек көрме!
Dialogue: 0,0:01:09.23,0:01:11.23,Default,,0,0,0,,Уау! Апыр-ай! Қарғыс атқыр...
Dialogue: 0,0:01:13.24,0:01:15.24,Default,,0,0,0,,《Қоңырау: Тез! 》 Богиняның көзінде ➡
Dialogue: 0,0:01:15.24,0:01:17.64,Default,,0,0,0,,Шатасып кеткенің үшін өзіңді қарғап тұрсың.
Dialogue: 0,0:01:19.91,0:01:21.91,Default,,0,0,0,,Иә. 《Қоңырау: Және қуат➡
Dialogue: 0,0:01:21.91,0:01:24.75,Default,,0,0,0,,Енді сен мен сияқты 3-деңгейсің! ? 》
Dialogue: 0,0:01:24.75,0:01:26.75,Default,,0,0,0,,Хмф! Гуаааа!
Dialogue: 0,0:01:26.75,0:01:30.25,Default,,0,0,0,,Гррр… Ах….
Dialogue: 0,0:01:30.25,0:01:32.45,Default,,0,0,0,,《Қоңырау: Осылай қалдырыңыз》
Dialogue: 0,0:01:35.19,0:01:37.89,Default,,0,0,0,,Қарғыс атсын! ? Ха.
Dialogue: 0,0:01:37.89,0:01:39.86,Default,,0,0,0,,Лорд Белл!
Dialogue: 0,0:01:42.40,0:01:45.20,Default,,0,0,0,,Эй, сен неге мұндасың?
Dialogue: 0,0:01:45.20,0:01:47.40,Default,,0,0,0,,Түсіндің бе? Ха!
Dialogue: 0,0:01:47.40,0:01:49.91,Default,,0,0,0,,Маған бәрібір!
Dialogue: 0,0:01:49.91,0:01:51.91,Default,,0,0,0,,Арх! Хааааа!
Dialogue: 0,0:01:51.91,0:01:53.91,Default,,0,0,0,,Арх! Хмф!
Dialogue: 0,0:01:53.91,0:01:56.91,Default,,0,0,0,,Ха! Ха!
Dialogue: 0,0:01:56.91,0:01:58.91,Default,,0,0,0,,А... хмф!
Dialogue: 0,0:01:58.91,0:02:01.25,Default,,0,0,0,,Гаха! Ха!
Dialogue: 0,0:02:01.25,0:02:03.25,Default,,0,0,0,,Уф! Қарғыс атсын!
Dialogue: 0,0:02:03.25,0:02:05.25,Default,,0,0,0,,Ой, Құдай-ай! Енді кеш болып барады.
Dialogue: 0,0:02:05.25,0:02:08.92,Default,,0,0,0,,Ааааа! Уф... Уф!
Dialogue: 0,0:02:08.92,0:02:10.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:18.10,0:02:21.27,Default,,0,0,0,,Уф... Мм!
Dialogue: 0,0:02:21.27,0:02:23.77,Default,,0,0,0,,Гегегегеге.
Dialogue: 0,0:02:23.77,0:02:26.14,Default,,0,0,0,,Геге!
Dialogue: 0,0:02:29.58,0:02:32.28,Default,,0,0,0,,Балалар! Мен оны тез жылжытамын➡
Dialogue: 0,0:02:32.28,0:02:34.52,Default,,0,0,0,,Дайын бол!
Dialogue: 0,0:02:34.52,0:02:38.02,Default,,0,0,0,,Айша-сан➡
Dialogue: 0,0:02:38.02,0:02:40.02,Default,,0,0,0,,Біздің мақсатымыз➡
Dialogue: 0,0:02:40.02,0:02:42.69,Default,,0,0,0,,Бұл адам болды ма?
Dialogue: 0,0:02:42.69,0:02:45.69,Default,,0,0,0,,Иә, Иштар-саманың бұйрығымен.
Dialogue: 0,0:02:56.54,0:02:58.54,Default,,0,0,0,,(тілді жалау дыбысы)
Dialogue: 0,0:04:46.52,0:04:49.35,Default,,0,0,0,,Хмм… аа….
Dialogue: 0,0:04:49.35,0:04:51.35,Default,,0,0,0,,Ха!?
Dialogue: 0,0:05:00.36,0:05:02.36,Default,,0,0,0,,Бұл қайда?
Dialogue: 0,0:05:02.36,0:05:04.67,Default,,0,0,0,,Сіз оянған сияқтысыз. Ха!
Dialogue: 0,0:05:08.37,0:05:11.21,Default,,0,0,0,,Хехехе…. Ааааааааааааааааааааааааааааа!
Dialogue: 0,0:05:11.21,0:05:13.38,Default,,0,0,0,,Мына бақаны ізде!
Dialogue: 0,0:05:13.38,0:05:15.38,Default,,0,0,0,,Әлгі бейбақ, Кішкентай Руки➡
Dialogue: 0,0:05:15.38,0:05:17.38,Default,,0,0,0,,Мен оны ұрлап жеймін!
Dialogue: 0,0:05:17.38,0:05:19.88,Default,,0,0,0,,Мені жесе, әлгі бәйбіше жойылады!
Dialogue: 0,0:05:19.88,0:05:24.05,Default,,0,0,0,,Ха! Егер сіз оны тапсаңыз, маған хабарлаңыз. Бар!
Dialogue: 0,0:05:24.05,0:05:28.16,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:05:33.20,0:05:35.53,Default,,0,0,0,,Аа... (тізбектердің дыбысы)
Dialogue: 0,0:05:35.53,0:05:37.80,Default,,0,0,0,,Хмм….
Dialogue: 0,0:05:41.20,0:05:44.37,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:05:44.37,0:05:47.04,Default,,0,0,0,,Харухиме-доно….
Dialogue: 0,0:05:47.04,0:05:49.51,Default,,0,0,0,,А... иә?
Dialogue: 0,0:05:51.55,0:05:53.55,Default,,0,0,0,,Кууууууууу! Хмф!
Dialogue: 0,0:05:53.55,0:05:55.55,Default,,0,0,0,,Қарғыс атсын! Ммм!
Dialogue: 0,0:05:55.55,0:05:58.72,Default,,0,0,0,,Уф! Ммм!
Dialogue: 0,0:05:58.72,0:06:01.22,Default,,0,0,0,,Уф! Уф!
Dialogue: 0,0:06:01.22,0:06:04.69,Default,,0,0,0,,Ахх. Күте тұрыңыз...
Dialogue: 0,0:06:04.69,0:06:06.70,Default,,0,0,0,,Муф! ?
Dialogue: 0,0:06:08.73,0:06:10.73,Default,,0,0,0,,Мен ойлағандай➡
Dialogue: 0,0:06:10.73,0:06:13.24,Default,,0,0,0,,Дәмді көрінеді!
Dialogue: 0,0:06:13.24,0:06:15.87,Default,,0,0,0,,Уф... Уф! ?
Dialogue: 0,0:06:15.87,0:06:17.87,Default,,0,0,0,,Уф! ?
Dialogue: 0,0:06:20.54,0:06:23.08,Default,,0,0,0,,Енді, онда➡
Dialogue: 0,0:06:23.08,0:06:26.08,Default,,0,0,0,,Қалай ойнау керек...
Dialogue: 0,0:06:26.08,0:06:29.75,Default,,0,0,0,,Иә! ? Ах, а, жоқ!
Dialogue: 0,0:06:29.75,0:06:32.25,Default,,0,0,0,,Сіз қалағаныңызша зорлық көрсете аласыз...
Dialogue: 0,0:06:32.25,0:06:36.32,Default,,0,0,0,,Бұл Атайдың жалғыз махаббат бөлмесі.
Dialogue: 0,0:06:36.32,0:06:38.33,Default,,0,0,0,,Қанша шу шығарсаң да➡
Dialogue: 0,0:06:38.33,0:06:40.83,Default,,0,0,0,,Ешкім келмейді.
Dialogue: 0,0:06:40.83,0:06:42.83,Default,,0,0,0,,Уф! ? қарақат….
Dialogue: 0,0:06:42.83,0:06:45.00,Default,,0,0,0,,Гегегеге!
Dialogue: 0,0:06:45.00,0:06:47.34,Default,,0,0,0,,Сіз әдемі көрінесіз.
Dialogue: 0,0:06:47.34,0:06:49.67,Default,,0,0,0,,Мен шыдай алмаймын!
Dialogue: 0,0:06:49.67,0:06:52.67,Default,,0,0,0,,Жүр, суланайық!
Dialogue: 0,0:06:52.67,0:06:55.51,Default,,0,0,0,,Хохо! ? Tsk!
Dialogue: 0,0:06:55.51,0:06:57.85,Default,,0,0,0,,бұл…. Мен оны пайдалана алмаймын.
Dialogue: 0,0:06:57.85,0:07:01.02,Default,,0,0,0,,Күте тұрыңыз, мен сізге дәрі әкелемін.
Dialogue: 0,0:07:01.02,0:07:03.85,Default,,0,0,0,,Ех... Егер сіз оны қолдансаңыз ➡
Dialogue: 0,0:07:03.85,0:07:06.86,Default,,0,0,0,,Барлығы Атайға ғашық болады.
Dialogue: 0,0:07:06.86,0:07:10.56,Default,,0,0,0,,Сен де Атайға жабысасың.
Dialogue: 0,0:07:14.53,0:07:19.03,Default,,0,0,0,,Мен сені үйілген қоянға ұқсатамын!
Dialogue: 0,0:07:19.03,0:07:23.04,Default,,0,0,0,,Гегегегехеге!
Dialogue: 0,0:07:23.04,0:07:25.04,Default,,0,0,0,,Мен қашуым керек!
Dialogue: 0,0:07:25.04,0:07:28.04,Default,,0,0,0,,Gugggggggg!
Dialogue: 0,0:07:28.04,0:07:30.15,Default,,0,0,0,,Ugggggggg! Эй! ?
Dialogue: 0,0:07:32.98,0:07:35.15,Default,,0,0,0,,Мистер Кранель?
Dialogue: 0,0:07:35.15,0:07:37.65,Default,,0,0,0,,бұл... Харухиме-сан!
Dialogue: 0,0:07:37.65,0:07:40.32,Default,,0,0,0,,Ши! Мен ұялшақпын➡
Dialogue: 0,0:07:40.32,0:07:42.52,Default,,0,0,0,,Кранел мырза.
Dialogue: 0,0:07:44.49,0:07:47.10,Default,,0,0,0,,Хмм… мм….
Dialogue: 0,0:07:49.86,0:07:52.83,Default,,0,0,0,,Шешілді! Апыр-ай!
Dialogue: 0,0:07:52.83,0:07:55.87,Default,,0,0,0,,Уф... Уф, бұл қорқынышты болды!
Dialogue: 0,0:07:55.87,0:07:58.54,Default,,0,0,0,,Ууууууууууууууууууу... Кранель мырза... бұл...
Dialogue: 0,0:07:58.54,0:08:02.68,Default,,0,0,0,,Уф... А...а...
Dialogue: 0,0:08:02.68,0:08:05.51,Default,,0,0,0,,Уф….
Dialogue: 0,0:08:05.51,0:08:09.02,Default,,0,0,0,,Уф… Ықылық….
Dialogue: 0,0:08:09.02,0:08:12.02,Default,,0,0,0,,Сәлем! ? Мен мұнда емеспін!
Dialogue: 0,0:08:12.02,0:08:14.82,Default,,0,0,0,,Tsk! Сіз қиындық тудырып жатырсыз!
Dialogue: 0,0:08:20.53,0:08:22.53,Default,,0,0,0,,Қайда кетті шіркін!
Dialogue: 0,0:08:22.53,0:08:24.53,Default,,0,0,0,,Лорд Белл….
Dialogue: 0,0:08:26.57,0:08:28.54,Default,,0,0,0,,Ятаноширо Қарға.
Dialogue: 0,0:08:34.18,0:08:36.18,Default,,0,0,0,,Қолданылу аясынан тыс па?
Dialogue: 0,0:08:36.18,0:08:38.18,Default,,0,0,0,,Мистер Белл қайда...?
Dialogue: 0,0:08:38.18,0:08:41.98,Default,,0,0,0,,Ол үйдің ішінде болуы керек. Табыңыз!
Dialogue: 0,0:08:41.98,0:08:44.49,Default,,0,0,0,,Хмф!
Dialogue: 0,0:08:44.49,0:08:47.19,Default,,0,0,0,,Ммм...
Dialogue: 0,0:08:47.19,0:08:49.36,Default,,0,0,0,,Харухиме!
Dialogue: 0,0:08:51.36,0:08:53.86,Default,,0,0,0,,Мынадай жасырын үзінді болды.
Dialogue: 0,0:08:53.86,0:08:56.53,Default,,0,0,0,,Иә, егер сіз мұны қолдансаңыз➡
Dialogue: 0,0:08:56.53,0:08:59.53,Default,,0,0,0,,Қызыл жарық аймағына көрінбей шығуға болады.
Dialogue: 0,0:08:59.53,0:09:02.04,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:09:02.04,0:09:04.04,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:09:04.04,0:09:07.38,Default,,0,0,0,,Ах! Бірақ Микото-сан!
Dialogue: 0,0:09:07.38,0:09:11.05,Default,,0,0,0,,Кілт Микото-самаға берілді.
Dialogue: 0,0:09:11.05,0:09:14.05,Default,,0,0,0,,Мен ол адамның қашып құтыла алатынына сенімдімін.
Dialogue: 0,0:09:14.05,0:09:16.05,Default,,0,0,0,,Аа...
Dialogue: 0,0:09:16.05,0:09:18.89,Default,,0,0,0,,Бірақ Харухиме-сан жақсы ма?➡
Dialogue: 0,0:09:18.89,0:09:20.89,Default,,0,0,0,,Егер сіз осындай әрекет жасап, ұсталсаңыз...
Dialogue: 0,0:09:20.89,0:09:23.56,Default,,0,0,0,,Мен Фрин мырзаның қазірдің өзінде екеніне сенімдімін➡
Dialogue: 0,0:09:23.56,0:09:25.56,Default,,0,0,0,,Сіз білесіз. иә?
Dialogue: 0,0:09:25.56,0:09:28.06,Default,,0,0,0,,Бұл бөлме туралы кім біледі?
Dialogue: 0,0:09:28.06,0:09:31.40,Default,,0,0,0,,Бұл мен ғана.
Dialogue: 0,0:09:31.40,0:09:33.57,Default,,0,0,0,,((Ха….
Dialogue: 0,0:09:38.64,0:09:41.14,Default,,0,0,0,,Ха...ха! ?
Dialogue: 0,0:09:41.14,0:09:44.05,Default,,0,0,0,,Ешкімге айтпа))
Dialogue: 0,0:09:45.98,0:09:48.82,Default,,0,0,0,,Міне! Содан кейін Харухиме-сан➡
Dialogue: 0,0:09:48.82,0:09:50.82,Default,,0,0,0,,Бұл қауіпті!
Dialogue: 0,0:09:52.82,0:09:55.32,Default,,0,0,0,,Бұл маған жетеді.
Dialogue: 0,0:09:55.32,0:09:57.33,Default,,0,0,0,,Хмм….
Dialogue: 0,0:09:57.33,0:10:03.16,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:10:03.16,0:10:05.37,Default,,0,0,0,,...
Dialogue: 0,0:10:08.17,0:10:10.34,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:10:10.34,0:10:13.51,Default,,0,0,0,,Уф….
Dialogue: 0,0:10:13.51,0:10:15.61,Default,,0,0,0,,Бұл бөлме ше?
Dialogue: 0,0:10:20.01,0:10:23.18,Default,,0,0,0,,«Сесшосеки» рәсімі….
Dialogue: 0,0:10:23.18,0:10:25.85,Default,,0,0,0,,Жетеді...
Dialogue: 0,0:10:25.85,0:10:28.36,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,0:10:28.36,0:10:31.36,Default,,0,0,0,,Не? Екеуіңізге қашып кетуге мүмкіндік беріңіз➡
Dialogue: 0,0:10:31.36,0:10:33.86,Default,,0,0,0,,Менің соңғы өзімшілдігім.
Dialogue: 0,0:10:33.86,0:10:35.86,Default,,0,0,0,,Айша және басқалар да болатынына сенімдімін➡
Dialogue: 0,0:10:35.86,0:10:37.87,Default,,0,0,0,,Олар бұған шыдайды.
Dialogue: 0,0:10:41.20,0:10:43.20,Default,,0,0,0,,Не болды? Жоқ ➡
Dialogue: 0,0:10:43.20,0:10:45.21,Default,,0,0,0,,Бұл….
Dialogue: 0,0:10:45.21,0:10:48.04,Default,,0,0,0,,Мына Харухиме-сан! иә….
Dialogue: 0,0:10:48.04,0:10:50.04,Default,,0,0,0,,Шын мәнінде, біз сізсіз➡
Dialogue: 0,0:10:50.04,0:10:52.05,Default,,0,0,0,,Мен өзімді ақтап алуды ойлап жүрмін!
Dialogue: 0,0:10:52.05,0:10:54.05,Default,,0,0,0,,Ха...
Dialogue: 0,0:10:54.05,0:10:57.55,Default,,0,0,0,,Ха, Микото-сан екеуміз сөйлестік!
Dialogue: 0,0:10:57.55,0:10:59.55,Default,,0,0,0,,Құдай және барлығы менімен келіседі➡
Dialogue: 0,0:10:59.55,0:11:01.56,Default,,0,0,0,,Ақша табу➡
Dialogue: 0,0:11:01.56,0:11:03.56,Default,,0,0,0,,Бұл әлі де біраз уақыт алуы мүмкін...
Dialogue: 0,0:11:05.56,0:11:08.73,Default,,0,0,0,,Мен де, Микото-сан да саған көмектескіміз келеді.
Dialogue: 0,0:11:08.73,0:11:10.73,Default,,0,0,0,,Аа...
Dialogue: 0,0:11:10.73,0:11:13.90,Default,,0,0,0,,Харухиме-сан?
Dialogue: 0,0:11:13.90,0:11:15.90,Default,,0,0,0,,Тек… бала сенің жаныңнан алыстап бара жатқанда…
Dialogue: 0,0:11:15.90,0:11:19.24,Default,,0,0,0,,Харухиме бақытты.
Dialogue: 0,0:11:19.24,0:11:21.24,Default,,0,0,0,,Микото-самаға...
Dialogue: 0,0:11:21.24,0:11:23.58,Default,,0,0,0,,Мұның бәрі сіз үшін➡
Dialogue: 0,0:11:23.58,0:11:26.41,Default,,0,0,0,,Сенің бұлай ойлайтыныңа сене алар емеспін.
Dialogue: 0,0:11:26.41,0:11:28.42,Default,,0,0,0,,Бұл сөздерді тыңдаңыз➡
Dialogue: 0,0:11:28.42,0:11:31.25,Default,,0,0,0,,Менде артық естеліктер жоқ.
Dialogue: 0,0:11:31.25,0:11:33.19,Default,,0,0,0,,Аа...
Dialogue: 0,0:11:33.19,0:11:36.09,Default,,0,0,0,,Кеттік, мистер Кранель.
Dialogue: 0,0:11:53.58,0:11:56.24,Default,,0,0,0,,Маған кедергі жасама.
Dialogue: 0,0:11:56.24,0:11:58.21,Default,,0,0,0,,Әлгі қарғыс атқыр қоян...
Dialogue: 0,0:12:08.56,0:12:10.56,Default,,0,0,0,,Мен көремін➡
Dialogue: 0,0:12:10.56,0:12:13.39,Default,,0,0,0,,Қарсылас «Ishtar Familia»...?
Dialogue: 0,0:12:13.39,0:12:15.40,Default,,0,0,0,,Иә... Белл-самамен➡
Dialogue: 0,0:12:15.40,0:12:17.40,Default,,0,0,0,,Микото-саманы ұрлап кеткен жерде➡
Dialogue: 0,0:12:17.40,0:12:20.57,Default,,0,0,0,,Мен бірнеше амазонкалардың қашып бара жатқанын көрдім.
Dialogue: 0,0:12:20.57,0:12:24.07,Default,,0,0,0,,Мен қызыл шам аймағында көрген кейбір жүздер...
Dialogue: 0,0:12:24.07,0:12:26.91,Default,,0,0,0,,Бірақ неге екенін білмеймін.
Dialogue: 0,0:12:26.91,0:12:28.91,Default,,0,0,0,,Неліктен бұл екі адам...?
Dialogue: 0,0:12:28.91,0:12:30.91,Default,,0,0,0,,Хмм….
Dialogue: 0,0:12:30.91,0:12:34.35,Default,,0,0,0,,А-а... сен Харухиме-чан туралы айтып тұрсың ба?
Dialogue: 0,0:12:34.35,0:12:36.85,Default,,0,0,0,,Өйткені оны екі адам төлемекші болды➡
Dialogue: 0,0:12:36.85,0:12:38.85,Default,,0,0,0,,Оны тоқтатуға тырысуда...
Dialogue: 0,0:12:38.85,0:12:41.86,Default,,0,0,0,,Күте тұрыңыз, осындай көлемдегі отбасы➡
Dialogue: 0,0:12:41.86,0:12:44.19,Default,,0,0,0,,Харухиме-сама, соңғы мүше➡
Dialogue: 0,0:12:44.19,0:12:46.23,Default,,0,0,0,,Мен оны қорғайды деп ойламаймын.
Dialogue: 0,0:12:46.23,0:12:49.90,Default,,0,0,0,,Ах, Ай қанша сирек болса да,➡
Dialogue: 0,0:12:49.90,0:12:52.07,Default,,0,0,0,,Ойлау қиын...
Dialogue: 0,0:12:52.07,0:12:55.24,Default,,0,0,0,,Бірақ егер Харухиме де қатысы болмаса➡
Dialogue: 0,0:12:55.24,0:12:57.24,Default,,0,0,0,,Неліктен «Ishtar Familia»...
Dialogue: 0,0:12:57.24,0:12:59.24,Default,,0,0,0,,Бұл туралы айтатын болсақ➡
Dialogue: 0,0:12:59.24,0:13:01.91,Default,,0,0,0,,Белл-кун Иштар туралы бірдеңе деді.
Dialogue: 0,0:13:01.91,0:13:04.38,Default,,0,0,0,,Не? Бұл Гермес➡ екеніне сенімдімін
Dialogue: 0,0:13:04.38,0:13:07.72,Default,,0,0,0,,Ол Иштарға бір зат әкелді...
Dialogue: 0,0:13:07.72,0:13:10.22,Default,,0,0,0,,Аа, сен солай айттың.
Dialogue: 0,0:13:10.22,0:13:12.22,Default,,0,0,0,,Маған қызық, бұл не➡
Dialogue: 0,0:13:12.22,0:13:14.72,Default,,0,0,0,,Әйтеуір тас дейді... Ха! ?
Dialogue: 0,0:13:14.72,0:13:16.72,Default,,0,0,0,,Бұл «Сесшосеки» емес! ?
Dialogue: 0,0:13:16.72,0:13:19.23,Default,,0,0,0,,Ах! Міне бітті! Апыр-ай!
Dialogue: 0,0:13:19.23,0:13:22.73,Default,,0,0,0,,Шынымен! Ол шынымен «Сесшосеки» деді ме? ?
Dialogue: 0,0:13:22.73,0:13:25.23,Default,,0,0,0,,Ааа….
Dialogue: 0,0:13:25.23,0:13:27.44,Default,,0,0,0,,бұл….
Dialogue: 0,0:13:31.41,0:13:34.84,Default,,0,0,0,,Мм... «Сесшосеки» дегеніміз не?
Dialogue: 0,0:13:34.84,0:13:36.84,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:13:39.51,0:13:41.52,Default,,0,0,0,,«Сесшосеки» дегеніміз не➡
Dialogue: 0,0:13:41.52,0:13:43.85,Default,,0,0,0,,Сел Ренардтың жаны➡
Dialogue: 0,0:13:43.85,0:13:46.02,Default,,0,0,0,,Бұл тыйым салынған сиқырлы зат.
Dialogue: 0,0:13:46.02,0:13:48.02,Default,,0,0,0,,Жан?
Dialogue: 0,0:13:48.02,0:13:50.02,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:13:50.02,0:13:52.69,Default,,0,0,0,,Қарапайым сөзбен айтқанда, сол тасты ұстау арқылы➡
Dialogue: 0,0:13:52.69,0:13:55.03,Default,,0,0,0,,Ренардың күшті сиқыры➡
Dialogue: 0,0:13:55.03,0:13:57.53,Default,,0,0,0,,Сіз «Сиқырды» пайдалана аласыз.
Dialogue: 0,0:13:57.53,0:13:59.87,Default,,0,0,0,,Сиқырлы белсендіру құрылғысы➡
Dialogue: 0,0:13:59.87,0:14:03.37,Default,,0,0,0,,Дәл осыны айтқың келе ме?
Dialogue: 0,0:14:03.37,0:14:05.54,Default,,0,0,0,,Сиқырлы қылыш сияқты.
Dialogue: 0,0:14:05.54,0:14:09.04,Default,,0,0,0,,Жоқ, бұл сиқырлы қылыштан да көп болуы мүмкін.
Dialogue: 0,0:14:09.04,0:14:12.71,Default,,0,0,0,,«Сесшосеки» тіпті үзіндімен де тиімді.
Dialogue: 0,0:14:12.71,0:14:14.72,Default,,0,0,0,,Тек фрагменттерді?
Dialogue: 0,0:14:14.72,0:14:17.55,Default,,0,0,0,,Аа, кішкене фрагмент болса да➡
Dialogue: 0,0:14:17.55,0:14:20.89,Default,,0,0,0,,Егер сізде бар болса, сіз ``сиқырды'' дәл осылай пайдалана аласыз.
Dialogue: 0,0:14:20.89,0:14:23.06,Default,,0,0,0,,Ха!?
Dialogue: 0,0:14:23.06,0:14:25.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:25.39,0:14:27.40,Default,,0,0,0,,Демек, «Сесшосеки» - ➡
Dialogue: 0,0:14:27.40,0:14:30.40,Default,,0,0,0,,Жанға мөр басылғаннан кейін бірден жаншылады.
Dialogue: 0,0:14:30.40,0:14:32.40,Default,,0,0,0,,Оның артында қандай себеп тұрса да,
Dialogue: 0,0:14:32.40,0:14:34.34,Default,,0,0,0,,Сыну... содан кейін➡
Dialogue: 0,0:14:34.34,0:14:36.50,Default,,0,0,0,,Жан сонда мөрленген! ?
Dialogue: 0,0:14:36.50,0:14:39.01,Default,,0,0,0,,Ха! (Чигуса) Ренардың жаны ➡
Dialogue: 0,0:14:39.01,0:14:42.01,Default,,0,0,0,,Не болады? ?
Dialogue: 0,0:14:42.01,0:14:44.18,Default,,0,0,0,,Сынған тас –➡
Dialogue: 0,0:14:44.18,0:14:46.18,Default,,0,0,0,,Артқа жол жоқ.
Dialogue: 0,0:14:49.35,0:14:52.69,Default,,0,0,0,,Сол сияқты... жан ➡
Dialogue: 0,0:14:52.69,0:14:54.69,Default,,0,0,0,,Бір рет сынған➡
Dialogue: 0,0:14:54.69,0:14:56.86,Default,,0,0,0,,Енді ешқашан...
Dialogue: 0,0:14:56.86,0:14:58.86,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:14:58.86,0:15:00.86,Default,,0,0,0,,Міне...
Dialogue: 0,0:15:04.20,0:15:07.54,Default,,0,0,0,,Харухиме-чан…. Қарғыс атсын!
Dialogue: 0,0:15:07.54,0:15:09.87,Default,,0,0,0,,Амал жоқ... Белл-кун және басқалары➡
Dialogue: 0,0:15:09.87,0:15:12.87,Default,,0,0,0,,Себебі мен онымен араластым...
Dialogue: 0,0:15:12.87,0:15:15.71,Default,,0,0,0,,Бамбук? Ренардың жаны➡
Dialogue: 0,0:15:15.71,0:15:17.71,Default,,0,0,0,,«Сесшосекиге» қалай ауысуға болады ➡
Dialogue: 0,0:15:17.71,0:15:20.38,Default,,0,0,0,,Ритуал қажет.
Dialogue: 0,0:15:20.38,0:15:24.05,Default,,0,0,0,,Толық ай түнінде орын алады...
Dialogue: 0,0:15:24.05,0:15:26.55,Default,,0,0,0,,Ха, болмайды! ?
Dialogue: 0,0:15:26.55,0:15:29.06,Default,,0,0,0,,Ах➡
Dialogue: 0,0:15:29.06,0:15:31.16,Default,,0,0,0,,Бүгін түнде.
Dialogue: 0,0:15:41.00,0:15:43.00,Default,,0,0,0,,Мен осындай жерге барамын...
Dialogue: 0,0:15:46.84,0:15:48.84,Default,,0,0,0,,Мистер Кранел….
Dialogue: 0,0:15:55.88,0:15:58.55,Default,,0,0,0,,Тез қашыңыз.
Dialogue: 0,0:16:00.72,0:16:02.72,Default,,0,0,0,,Мистер Кранель?
Dialogue: 0,0:16:02.72,0:16:04.73,Default,,0,0,0,,Харухиме-сан….
Dialogue: 0,0:16:04.73,0:16:06.69,Default,,0,0,0,,Ақыр соңында, егер жағдай осылай жалғаса берсе, сіз...
Dialogue: 0,0:16:08.73,0:16:10.73,Default,,0,0,0,,Мистер Кранел….
Dialogue: 0,0:16:10.73,0:16:13.23,Default,,0,0,0,,Бұл жаға менің қайда екенімді көрсетеді➡
Dialogue: 0,0:16:13.23,0:16:15.40,Default,,0,0,0,,Хабарландыру үшін сиқырлы элемент.
Dialogue: 0,0:16:15.40,0:16:17.41,Default,,0,0,0,,Менің орным➡
Dialogue: 0,0:16:17.41,0:16:20.24,Default,,0,0,0,,Мен әрқашан Иштарға ғашықпын.
Dialogue: 0,0:16:20.24,0:16:22.24,Default,,0,0,0,,Сондықтан➡
Dialogue: 0,0:16:22.24,0:16:24.25,Default,,0,0,0,,Мұның бәрі мен үшін.
Dialogue: 0,0:16:24.25,0:16:26.41,Default,,0,0,0,,Неліктен бұлай...?
Dialogue: 0,0:16:26.41,0:16:28.42,Default,,0,0,0,,Харухиме-доно! Ха...
Dialogue: 0,0:16:28.42,0:16:31.25,Default,,0,0,0,,Хахаха... Микото-сан!
Dialogue: 0,0:16:31.25,0:16:33.82,Default,,0,0,0,,Жарайды... Ха...
Dialogue: 0,0:16:33.82,0:16:37.83,Default,,0,0,0,,Харухиме-доно, сенен сұрайтыным бар!
Dialogue: 0,0:16:37.83,0:16:40.50,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:40.50,0:16:43.66,Default,,0,0,0,,«Сесшосеки» туралы білесіз бе?
Dialogue: 0,0:16:43.66,0:16:45.87,Default,,0,0,0,,Ха...
Dialogue: 0,0:16:49.00,0:16:51.34,Default,,0,0,0,,Ақымақ!
Dialogue: 0,0:16:51.34,0:16:53.51,Default,,0,0,0,,Өтінемін, өтірік айтыңызшы!
Dialogue: 0,0:16:53.51,0:16:56.01,Default,,0,0,0,,Сен құрбан боласың!
Dialogue: 0,0:16:56.01,0:16:58.01,Default,,0,0,0,,Құрбан шалу?
Dialogue: 0,0:17:00.01,0:17:02.02,Default,,0,0,0,,Мұның бәрі осы ма?
Dialogue: 0,0:17:02.02,0:17:04.02,Default,,0,0,0,,Ха!?
Dialogue: 0,0:17:04.02,0:17:07.19,Default,,0,0,0,,Кяах! Ах!
Dialogue: 0,0:17:07.19,0:17:09.19,Default,,0,0,0,,Айша!
Dialogue: 0,0:17:09.19,0:17:11.86,Default,,0,0,0,,Бақытымызға орай, мені бақа жеп қойған жоқ➡
Dialogue: 0,0:17:11.86,0:17:14.36,Default,,0,0,0,,Қиындыққа жол берме.
Dialogue: 0,0:17:14.36,0:17:17.06,Default,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:17:22.70,0:17:25.61,Default,,0,0,0,,Соғыс. (2 адам) Не! ?
Dialogue: 0,0:17:27.71,0:17:31.55,Default,,0,0,0,,Біз «Фрея Фамилияны» ұсақтаймыз.
Dialogue: 0,0:17:31.55,0:17:34.48,Default,,0,0,0,,Бұл Құдайдың шақыруы.
Dialogue: 0,0:17:34.48,0:17:36.48,Default,,0,0,0,,Міне!
Dialogue: 0,0:17:36.48,0:17:38.99,Default,,0,0,0,,Бұл мүмкін емес деп ойлайсыз ба?
Dialogue: 0,0:17:38.99,0:17:42.66,Default,,0,0,0,,Қарсылас Орарионың ең мықты отбасы екені рас.
Dialogue: 0,0:17:42.66,0:17:45.83,Default,,0,0,0,,Бірақ бізде бұл жігіт бар!
Dialogue: 0,0:17:45.83,0:17:48.00,Default,,0,0,0,,Оның Харухиме-санға қандай қатысы бар?
Dialogue: 0,0:17:48.00,0:17:50.00,Default,,0,0,0,,Бұл көңілсіз!
Dialogue: 0,0:17:50.00,0:17:52.00,Default,,0,0,0,,Бұл жігіттің күші бар.
Dialogue: 0,0:17:52.00,0:17:54.67,Default,,0,0,0,,Сені мен зынданда ұрып-соқтым, солай ма?
Dialogue: 0,0:17:54.67,0:17:57.04,Default,,0,0,0,,Ха... мүмкін емес➡
Dialogue: 0,0:17:57.04,0:17:59.87,Default,,0,0,0,,Сол кезде?
Dialogue: 0,0:17:59.87,0:18:03.21,Default,,0,0,0,,«Деңгейді көтеру» Бұл Харухиманың сиқыры!
Dialogue: 0,0:18:03.21,0:18:05.21,Default,,0,0,0,,Ха...
Dialogue: 0,0:18:05.21,0:18:07.72,Default,,0,0,0,,Харухиме бүгін түнде құрбандыққа шалынады.
Dialogue: 0,0:18:07.72,0:18:11.39,Default,,0,0,0,,Бізге көмектесу үшін.
Dialogue: 0,0:18:11.39,0:18:14.06,Default,,0,0,0,,А... күте тұрыңыз ➡
Dialogue: 0,0:18:14.06,0:18:16.06,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:18:16.06,0:18:18.06,Default,,0,0,0,,Сіз бұрын не туралы айттыңыз? ?
Dialogue: 0,0:18:18.06,0:18:20.39,Default,,0,0,0,,Құрбандық немесе құрбандық➡
Dialogue: 0,0:18:20.39,0:18:24.07,Default,,0,0,0,,Харухиме-сан өлген сияқты!
Dialogue: 0,0:18:24.07,0:18:26.40,Default,,0,0,0,,Сен өлесің.
Dialogue: 0,0:18:26.40,0:18:28.87,Default,,0,0,0,,Харухиме бүгін түнде өледі.
Dialogue: 0,0:18:28.87,0:18:32.81,Default,,0,0,0,,Баяғыда шешілді.
Dialogue: 0,0:18:32.81,0:18:37.31,Default,,0,0,0,,Бұл не...?
Dialogue: 0,0:18:37.31,0:18:41.65,Default,,0,0,0,,Бір отбасының мүшелері ➡
Dialogue: 0,0:18:41.65,0:18:43.65,Default,,0,0,0,,Сіз қалай ойлайсыз? ?
Dialogue: 0,0:18:43.65,0:18:46.99,Default,,0,0,0,,Оны шайқас құралы ретінде пайдаланыңыз, бір рет қолданылатын етіп жасаңыз!
Dialogue: 0,0:18:46.99,0:18:50.83,Default,,0,0,0,,Бұл мүлдем дұрыс емес!
Dialogue: 0,0:18:50.83,0:18:53.10,Default,,0,0,0,,Мен солай айтамын.
Dialogue: 0,0:18:53.10,0:18:56.86,Default,,0,0,0,,Мына жігітті ұрлағың келе ме?
Dialogue: 0,0:18:56.86,0:18:58.83,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:18:58.83,0:19:00.84,Default,,0,0,0,,Сосын соғыс➡
Dialogue: 0,0:19:00.84,0:19:03.34,Default,,0,0,0,,Отбасыңызбен!
Dialogue: 0,0:19:03.34,0:19:05.34,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:09.84,0:19:12.68,Default,,0,0,0,,Бір жезөкше туралы әңгіме айтып берейін.
Dialogue: 0,0:19:12.68,0:19:14.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:14.68,0:19:16.85,Default,,0,0,0,,Анау жезөкшенің амалы жоқ➡
Dialogue: 0,0:19:16.85,0:19:19.35,Default,,0,0,0,,Маған ұнамайтын бір адам болды.
Dialogue: 0,0:19:19.35,0:19:22.02,Default,,0,0,0,,Қиыр Шығыстан келген➡
Dialogue: 0,0:19:22.02,0:19:24.13,Default,,0,0,0,,Ол Ренардың баласы. Эх...
Dialogue: 0,0:19:28.23,0:19:31.07,Default,,0,0,0,,Ол баланы зұлым бала алдап кетті➡
Dialogue: 0,0:19:31.07,0:19:36.30,Default,,0,0,0,,Осы қалада сатылып, шайылып кеткен көрінеді.
Dialogue: 0,0:19:36.30,0:19:38.31,Default,,0,0,0,,Қанша қамқорлық жасасаңыз да➡
Dialogue: 0,0:19:38.31,0:19:42.81,Default,,0,0,0,,Бәрінен бас тартқандай күледі.
Dialogue: 0,0:19:42.81,0:19:45.65,Default,,0,0,0,,Басқаларға ашық емес.
Dialogue: 0,0:19:45.65,0:19:47.85,Default,,0,0,0,,Дүние де білмейді.
Dialogue: 0,0:19:51.82,0:19:54.32,Default,,0,0,0,,Мен тіпті жыламаймын.
Dialogue: 0,0:20:03.66,0:20:07.37,Default,,0,0,0,,Сол жезөкше оны жек көреді және жек көреді➡
Dialogue: 0,0:20:09.50,0:20:12.61,Default,,0,0,0,,Бір күні мен ақымақ соққы жасадым.
Dialogue: 0,0:20:14.68,0:20:16.68,Default,,0,0,0,,Үйге әкелінді➡
Dialogue: 0,0:20:16.68,0:20:18.88,Default,,0,0,0,,Мен маңызды тасты сындырдым.
Dialogue: 0,0:20:22.18,0:20:25.19,Default,,0,0,0,,Әрине, жезөкшенің не істегені анықталды.
Dialogue: 0,0:20:30.86,0:20:32.86,Default,,0,0,0,,Қарғыс атқан құрбақа➡
Dialogue: 0,0:20:32.86,0:20:34.86,Default,,0,0,0,,Ол толығымен жойылды.
Dialogue: 0,0:20:36.86,0:20:39.07,Default,,0,0,0,,Және….
Dialogue: 0,0:20:43.87,0:20:46.87,Default,,0,0,0,,Бас құдайдың қолынан, Ақыл-ойымнан айнып қалдым➡
Dialogue: 0,0:20:46.87,0:20:49.08,Default,,0,0,0,,Таң қалдырды.
Dialogue: 0,0:20:51.05,0:20:53.55,Default,,0,0,0,,Содан бері сол ақымақ жезөкше➡
Dialogue: 0,0:20:53.55,0:20:56.55,Default,,0,0,0,,Бас құдайдың әмірлеріне мойынсұнбауға болмайды.
Dialogue: 0,0:20:56.55,0:20:58.89,Default,,0,0,0,,Familia деген осы.
Dialogue: 0,0:20:58.89,0:21:00.89,Default,,0,0,0,,Ха...
Dialogue: 0,0:21:00.89,0:21:03.22,Default,,0,0,0,,Сәлем, жаңадан келген бала. Ха! ?
Dialogue: 0,0:21:03.22,0:21:06.23,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:21:06.23,0:21:08.23,Default,,0,0,0,,Уф….
Dialogue: 0,0:21:08.23,0:21:10.23,Default,,0,0,0,,Олар ұрлауға келмей ме?
Dialogue: 0,0:21:10.23,0:21:12.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:12.23,0:21:15.90,Default,,0,0,0,,Неге келмейсің? Мен абдырап қалдым! ?
Dialogue: 0,0:21:15.90,0:21:18.24,Default,,0,0,0,,Бұл… бұл….
Dialogue: 0,0:21:18.24,0:21:21.08,Default,,0,0,0,,Сайып келгенде, бұл жай ғана жанашырлық.
Dialogue: 0,0:21:21.08,0:21:24.41,Default,,0,0,0,,Жоқ…. Сонда неге қозғалмайды? ?
Dialogue: 0,0:21:24.41,0:21:27.08,Default,,0,0,0,,Отбасы маңызды ма?
Dialogue: 0,0:21:27.08,0:21:30.25,Default,,0,0,0,,Сіз соғыстан қорқасыз ба?
Dialogue: 0,0:21:30.25,0:21:33.15,Default,,0,0,0,,Мына жігітті құтқара аласың ба? ?
Dialogue: 0,0:21:35.02,0:21:38.36,Default,,0,0,0,,Бұл жақсы емес, Белл Кранел.
Dialogue: 0,0:21:38.36,0:21:41.06,Default,,0,0,0,,Мен саған Харухимені бере алмаймын.
Dialogue: 0,0:21:43.03,0:21:46.20,Default,,0,0,0,,Сізде ер тұлға жоқ.
Dialogue: 0,0:21:46.20,0:21:48.54,Default,,0,0,0,,Бас айналу және депрессия➡
Dialogue: 0,0:21:48.54,0:21:51.37,Default,,0,0,0,,Тек ақымақ баланың түрі.
Dialogue: 0,0:21:51.37,0:21:53.37,Default,,0,0,0,,Сіз бұл бала үшінсіз➡
Dialogue: 0,0:21:53.37,0:21:55.38,Default,,0,0,0,,Бәрінен бас тартуға болмайды.
Dialogue: 0,0:21:58.55,0:22:00.55,Default,,0,0,0,,Айша~!
Dialogue: 0,0:22:00.55,0:22:02.55,Default,,0,0,0,,Иружан Кішкентай Руки
Dialogue: 0,0:22:02.55,0:22:04.55,Default,,0,0,0,,Неге ұстамайсың?
Dialogue: 0,0:22:04.55,0:22:07.05,Default,,0,0,0,,Ха! Өтінемін қашып кет!
Dialogue: 0,0:22:07.05,0:22:11.06,Default,,0,0,0,,Лорд Белл!
Dialogue: 0,0:22:11.06,0:22:13.06,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:22:13.06,0:22:15.56,Default,,0,0,0,,Бармайсың ба?
Dialogue: 0,0:22:15.56,0:22:17.57,Default,,0,0,0,,Сонда мен де жақсымын!
Dialogue: 0,0:22:17.57,0:22:20.23,Default,,0,0,0,,Күте тұрыңыз! Мен сенің қашуыңа жол бермеймін!
Dialogue: 0,0:22:20.23,0:22:23.57,Default,,0,0,0,,Уф... Жалқау болма.
Dialogue: 0,0:22:23.57,0:22:25.87,Default,,0,0,0,,Бұл Ампонтан. Ах...
Dialogue: 0,0:22:39.19,0:22:43.86,Default,,0,0,0,,Гррр! Хахахаха!
Dialogue: 0,0:22:43.86,0:22:46.06,Default,,0,0,0,,《Қоңырау: Менмін》
Dialogue: 0,0:22:47.56,0:22:52.56,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
