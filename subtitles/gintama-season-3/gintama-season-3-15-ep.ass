Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:08.17,0:00:09.67,Default,,0,0,0,,Әке
Dialogue: 0,0:00:09.84,0:00:13.38,Default,,0,0,0,,Ақырында «Жаным Арайды» орындадым...
Dialogue: 0,0:00:15.26,0:00:19.35,Default,,0,0,0,,Сол қылышпен менің одақтасым менімен жаңа дәуірді ашады...
Dialogue: 0,0:00:19.85,0:00:21.22,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:00:22.89,0:00:24.14,Default,,0,0,0,,Он сегізінші ұрпақ...
Dialogue: 0,0:00:24.27,0:00:25.31,Default,,0,0,0,,...
Dialogue: 0,0:00:27.52,0:00:32.53,Default,,0,0,0,,♪~
Dialogue: 0,0:01:54.11,0:01:58.45,Default,,0,0,0,,~♪
Dialogue: 0,0:02:15.21,0:02:17.34,Default,,0,0,0,,Гинтоки Саката
Dialogue: 0,0:02:17.67,0:02:18.63,Default,,0,0,0,,Жоқ-
Dialogue: 0,0:02:18.76,0:02:21.93,Default,,0,0,0,,Мен сені Ақ Яша десем болады ма?
Dialogue: 0,0:02:22.64,0:02:26.10,Default,,0,0,0,,Сен де қылыштан өткендер сияқтысың.
Dialogue: 0,0:02:26.31,0:02:28.43,Default,,0,0,0,,10 жыл бұрын менің басымды кесу керек еді.
Dialogue: 0,0:02:29.27,0:02:31.40,Default,,0,0,0,,Ол әкесі жіберген күнәкар.
Dialogue: 0,0:02:31.52,0:02:32.11,Default,,0,0,0,,Не!
Dialogue: 0,0:02:32.23,0:02:35.57,Default,,0,0,0,,Сіздің өміріңіз алдыңғы Йемон.
Dialogue: 0,0:02:35.69,0:02:38.44,Default,,0,0,0,,Әкем құтқарғандар
Dialogue: 0,0:02:38.86,0:02:40.41,Default,,0,0,0,,Олай болса, бұл аз емес...
Dialogue: 0,0:02:40.74,0:02:43.83,Default,,0,0,0,,Сізде де орындауға міндеттер болуы керек.
Dialogue: 0,0:02:44.58,0:02:48.41,Default,,0,0,0,,Менің әкем күнәкарларды құтқару үшін өлді.
Dialogue: 0,0:02:49.00,0:02:52.92,Default,,0,0,0,,Ал Асемон әкесінің атын қараңғыда көмгісі келді...
Dialogue: 0,0:02:53.79,0:02:57.96,Default,,0,0,0,,Оның өзі сатқын болып, қуғынға ұшырады.
Dialogue: 0,0:02:59.51,0:03:02.14,Default,,0,0,0,,Икеда отбасы сақтап қалған өмір
Dialogue: 0,0:03:02.26,0:03:06.06,Default,,0,0,0,,Сіз оны Ikeda отбасы үшін пайдалансаңыз да, сіз барабан таяқшаларын алмайсыз.
Dialogue: 0,0:03:09.14,0:03:10.31,Default,,0,0,0,,Асемон...
Dialogue: 0,0:03:11.52,0:03:13.40,Default,,0,0,0,,Мені қорғағаныңды қалаймын
Dialogue: 0,0:03:14.40,0:03:15.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:15.65,0:03:18.40,Default,,0,0,0,,Сіз өлтірушіні бірінші ұстадыңыз ба?
Dialogue: 0,0:03:18.53,0:03:19.69,Default,,0,0,0,,Иә
Dialogue: 0,0:03:19.82,0:03:24.41,Default,,0,0,0,,Икедалар отбасы бізден алда келе жатқандай болды.
Dialogue: 0,0:03:24.53,0:03:28.79,Default,,0,0,0,,Сіздің отбасыңыздың ұятына отбасы ретінде қарсы тұруға батылыңыз бар ма?
Dialogue: 0,0:03:28.91,0:03:30.12,Default,,0,0,0,,Бұл алғашқы «Глория».
Dialogue: 0,0:03:30.25,0:03:33.25,Default,,0,0,0,,Басын кесетін шенеуніктің мұндай өкілеттігі жоқ.
Dialogue: 0,0:03:33.37,0:03:36.29,Default,,0,0,0,,Астыңғы балаларды дереу тапсыруын айт.
Dialogue: 0,0:03:36.42,0:03:38.17,Default,,0,0,0,,Қазірдің өзінде кеш
Dialogue: 0,0:03:38.30,0:03:40.80,Default,,0,0,0,,Қазірдің өзінде жалғыз жаман адам - мойын.
Dialogue: 0,0:03:40.92,0:03:42.34,Default,,0,0,0,,Не?!
Dialogue: 0,0:03:42.47,0:03:45.01,Default,,0,0,0,,Жамандарды басқаратын біз емеспіз.
Dialogue: 0,0:03:45.43,0:03:47.81,Default,,0,0,0,,Ол Мимаваригумиге тапсырылды.
Dialogue: 0,0:03:47.93,0:03:49.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:03:49.39,0:03:54.19,Default,,0,0,0,,Қатаң соттан кейін оның басы сол күні алынады деп шешілді.
Dialogue: 0,0:03:54.94,0:03:59.23,Default,,0,0,0,,Өлім жазасын Яэмон Икеда орындап қойған.
Dialogue: 0,0:03:59.36,0:04:00.99,Default,,0,0,0,,ақымақ
Dialogue: 0,0:04:01.11,0:04:04.16,Default,,0,0,0,,Неліктен сот үкімі тез шығарылады...
Dialogue: 0,0:04:04.28,0:04:05.20,Default,,0,0,0,,О
Dialogue: 0,0:04:05.82,0:04:08.28,Default,,0,0,0,,Сот тергеушісінің растауы да алынды.
Dialogue: 0,0:04:09.24,0:04:11.79,Default,,0,0,0,,Ол, әрине, жаман қылышшы.
Dialogue: 0,0:04:12.37,0:04:15.29,Default,,0,0,0,,Бұл Чоемон Икеданың басшысы.
Dialogue: 0,0:04:16.88,0:04:18.21,Default,,0,0,0,,Ум...
Dialogue: 0,0:04:18.59,0:04:21.13,Default,,0,0,0,,Қате түсінсем кешіріңіз.
Dialogue: 0,0:04:21.26,0:04:23.38,Default,,0,0,0,,Мен әлі тірімін, солай ма?
Dialogue: 0,0:04:23.55,0:04:24.93,Default,,0,0,0,,Бұл менің қиялым болса керек.
Dialogue: 0,0:04:25.05,0:04:27.39,Default,,0,0,0,,Өлгендер аузын жауып, көздерін жұмып отыруы керек.
Dialogue: 0,0:04:27.51,0:04:30.93,Default,,0,0,0,,Бірақ менің алдымда көзі ашық мәйіт тұр.
Dialogue: 0,0:04:31.27,0:04:33.27,Default,,0,0,0,,Мәйіттің көзі кімнің көзі?
Dialogue: 0,0:04:33.39,0:04:37.44,Default,,0,0,0,,Сонымен, мен әлі өлмеген шығармын.
Dialogue: 0,0:04:37.73,0:04:39.86,Default,,0,0,0,,Қағазда өлі...
Dialogue: 0,0:04:40.02,0:04:42.11,Default,,0,0,0,,Қоғамдық жазалаушы күткендей
Dialogue: 0,0:04:42.32,0:04:46.41,Default,,0,0,0,,Медициналық сарапшы Мимаваригумидегі әртүрлі істерге араласатын сияқты.
Dialogue: 0,0:04:46.53,0:04:49.37,Default,,0,0,0,,Мәйітке айналсам, менікі.
Dialogue: 0,0:04:49.49,0:04:51.04,Default,,0,0,0,,Өлген мәйіт –
Dialogue: 0,0:04:51.16,0:04:54.66,Default,,0,0,0,,Қоғамдық жазалаушы болу, сынау мақсатында пайдалану.
Dialogue: 0,0:04:54.79,0:04:55.58,Default,,0,0,0,,Температура-
Dialogue: 0,0:04:55.71,0:04:57.96,Default,,0,0,0,,Тіпті сынау кесу үшін князьдерге арналған мәйіт.
Dialogue: 0,0:04:58.08,0:04:59.92,Default,,0,0,0,,Мен сіз келісім жасап жатырсыз деп естідім.
Dialogue: 0,0:05:00.04,0:05:02.80,Default,,0,0,0,,Оны сол мәйіттің ішіне тығып, қашып кетуге рұқсат етіңіз бе?
Dialogue: 0,0:05:02.92,0:05:05.63,Default,,0,0,0,,Мен одан мені тоқтатуын өтіндім...
Dialogue: 0,0:05:05.76,0:05:09.55,Default,,0,0,0,,Олар мені қорғауды өтінген тәртіпсіз отбасы.
Dialogue: 0,0:05:09.68,0:05:14.10,Default,,0,0,0,,Күнәһардың басын былай қойғанда, өз басын кесіп те алмайтын өлім құдайы...
Dialogue: 0,0:05:14.27,0:05:16.35,Default,,0,0,0,,Оның әлі де пайдасы бар деп ойлайсыз ба?
Dialogue: 0,0:05:16.64,0:05:20.77,Default,,0,0,0,,Менің қылышым енді ештеңені кесе алмайды.
Dialogue: 0,0:05:20.94,0:05:24.36,Default,,0,0,0,,Өйткені мен енді адам емеспін
Dialogue: 0,0:05:25.19,0:05:26.45,Default,,0,0,0,,Хаа…
Dialogue: 0,0:05:27.57,0:05:31.37,Default,,0,0,0,,Қылмыс жасап, жынға айналған адам...
Dialogue: 0,0:05:31.49,0:05:34.50,Default,,0,0,0,,Ақырында, адамдарға қайтаруға болатын нәрсе ...
Dialogue: 0,0:05:35.00,0:05:37.50,Default,,0,0,0,,Адамдардың басын кесетін жын емес.
Dialogue: 0,0:05:37.62,0:05:40.63,Default,,0,0,0,,Адамдардың жанын ұрлайтын өлім құдайы да емес.
Dialogue: 0,0:05:40.75,0:05:43.76,Default,,0,0,0,,Адамдардың күнәсін өлтіріп, жанын сақта.
Dialogue: 0,0:05:44.63,0:05:47.34,Default,,0,0,0,,Тек адамдар ма?
Dialogue: 0,0:05:47.47,0:05:50.01,Default,,0,0,0,,Неліктен... неге?
Dialogue: 0,0:05:52.18,0:05:56.89,Default,,0,0,0,,Баяғыда бір басы кесілген шенеунік осылай депті.
Dialogue: 0,0:05:59.65,0:06:01.61,Default,,0,0,0,,Мен сұрауға қорқамын...
Dialogue: 0,0:06:01.73,0:06:05.40,Default,,0,0,0,,Джин мырза, сіз қандай қылмыс жасадыңыз?
Dialogue: 0,0:06:05.78,0:06:07.32,Default,,0,0,0,,Тек тарих үшін...
Dialogue: 0,0:06:07.45,0:06:11.12,Default,,0,0,0,,Оған кез келген уақытта опасыздық жасады деген айып тағылуы мүмкін.
Dialogue: 0,0:06:11.57,0:06:13.58,Default,,0,0,0,,Жаяу Әдепсіздік Әл
Dialogue: 0,0:06:13.70,0:06:16.91,Default,,0,0,0,,Бұл қоғамдық әдепсіздік қылмысы емес пе?
Dialogue: 0,0:06:17.37,0:06:19.62,Default,,0,0,0,,Цудзигири жасаған адамдарға рахмет...
Dialogue: 0,0:06:19.75,0:06:23.59,Default,,0,0,0,,Көмек берудің өзі мұң екен.
Dialogue: 0,0:06:24.34,0:06:26.67,Default,,0,0,0,,Джин-санның кім екенін білген соң...
Dialogue: 0,0:06:27.05,0:06:30.18,Default,,0,0,0,,Бізді пайдаланып қалу үшін хабарласқаны көрініп тұр.
Dialogue: 0,0:06:30.72,0:06:34.60,Default,,0,0,0,,Егер солай болса, Асемон-сан аман-есен қашып кетсе де...
Dialogue: 0,0:06:34.72,0:06:36.43,Default,,0,0,0,,Осыдан кейін біз...
Dialogue: 0,0:06:36.81,0:06:40.27,Default,,0,0,0,,Қалай болғанда да, енді артқа жол жоқ.
Dialogue: 0,0:06:40.44,0:06:41.94,Default,,0,0,0,,Сіз қылмысқа серіктес болсаңыз да.
Dialogue: 0,0:06:42.06,0:06:44.57,Default,,0,0,0,,Енді мен фрикадельник жеуді шештім...
Dialogue: 0,0:06:45.07,0:06:46.73,Default,,0,0,0,,Ал оны түгел жұтпасаң, лас болады
Dialogue: 0,0:06:46.86,0:06:50.53,Default,,0,0,0,,Әй, бір ақымақ мені қиыншылыққа ұшыратты!
Dialogue: 0,0:06:51.07,0:06:53.78,Default,,0,0,0,,Рас, келіндерім таусылып барады.
Dialogue: 0,0:06:53.95,0:06:55.79,Default,,0,0,0,,Ондай жағдайда мен оны аламын.
Dialogue: 0,0:06:55.91,0:06:56.58,Default,,0,0,0,,Хмм
Dialogue: 0,0:06:56.99,0:06:58.58,Default,,0,0,0,,3 мезгіл тамақтану кіреді
Dialogue: 0,0:06:58.70,0:07:02.54,Default,,0,0,0,,Біздің де қарапайым, бірақ тыныш өмір сүре алатын өз үйіміз бар.
Dialogue: 0,0:07:02.67,0:07:03.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:03.33,0:07:04.96,Default,,0,0,0,,торлы
Dialogue: 0,0:07:05.38,0:07:08.30,Default,,0,0,0,,Бұл міндетті өзгерту. Кемені тоқтатыңыз.
Dialogue: 0,0:07:08.42,0:07:10.17,Default,,0,0,0,,Темераның кемесінің ішінде -
Dialogue: 0,0:07:10.30,0:07:12.76,Default,,0,0,0,,Оны өзгертуге болады ма?
Dialogue: 0,0:07:15.93,0:07:18.64,Default,,0,0,0,,Қанша күнәкардың басын кессең де...
Dialogue: 0,0:07:18.77,0:07:22.56,Default,,0,0,0,,Адамдарды адам ретінде құтқару үшін жүрегіңізді жоғалтпаңыз.
Dialogue: 0,0:07:23.06,0:07:28.07,Default,,0,0,0,,Бұл бұрынғы қоғамдық жазалаушы Икеда Яемонның ілімі болды.
Dialogue: 0,0:07:29.57,0:07:33.61,Default,,0,0,0,,Біз өлім жазасына кесу кезінде қолданатын әдіс жанға шабуыл деп аталады.
Dialogue: 0,0:07:33.74,0:07:35.91,Default,,0,0,0,,Рухтың көрінісі
Dialogue: 0,0:07:36.33,0:07:38.91,Default,,0,0,0,,Басың жерге түсіп, лас болып қалмасын.
Dialogue: 0,0:07:39.04,0:07:43.42,Default,,0,0,0,,Мен тек өмірді ұрлап, кішіпейілділікпен жанды жіберемін.
Dialogue: 0,0:07:43.92,0:07:46.25,Default,,0,0,0,,Мені қожайыным алып кеткеннен бері...
Dialogue: 0,0:07:46.38,0:07:50.05,Default,,0,0,0,,Қоғамдық жазалаушы ретінде оның ілімдері оған тереңдетілген...
Dialogue: 0,0:07:50.17,0:07:53.26,Default,,0,0,0,,Көптеген күнәкарлар сол қылышпен сотталды.
Dialogue: 0,0:07:54.59,0:07:56.18,Default,,0,0,0,,Бірақ сол күні...
Dialogue: 0,0:07:56.80,0:08:00.18,Default,,0,0,0,,Мен ол адамды өлтіруім керек болғанда...
Dialogue: 0,0:08:00.48,0:08:03.77,Default,,0,0,0,,Мен... түсінбеймін.
Dialogue: 0,0:08:05.40,0:08:07.40,Default,,0,0,0,,Күнә дегеніміз не?
Dialogue: 0,0:08:07.77,0:08:10.28,Default,,0,0,0,,Біреуді соттау деген нені білдіреді?
Dialogue: 0,0:08:11.15,0:08:12.40,Default,,0,0,0,,Өйткені—
Dialogue: 0,0:08:12.53,0:08:17.03,Default,,0,0,0,,Өйткені ол күнәкар мен үшін заң болды...
Dialogue: 0,0:08:18.08,0:08:20.16,Default,,0,0,0,,Барлығын ұмыту -
Dialogue: 0,0:08:20.29,0:08:22.46,Default,,0,0,0,,Жын болмай қия алмас едім
Dialogue: 0,0:08:27.67,0:08:30.25,Default,,0,0,0,,Басқалардан маңыздырақ адам...
Dialogue: 0,0:08:32.97,0:08:36.47,Default,,0,0,0,,Мен сенің адам болып өлуіңе жол бере алмадым.
Dialogue: 0,0:08:40.60,0:08:43.85,Default,,0,0,0,,Мен өз өмірімді өлтірмек болдым...
Dialogue: 0,0:08:43.98,0:08:46.35,Default,,0,0,0,,Бұл үй үшін емес.
Dialogue: 0,0:08:46.60,0:08:50.36,Default,,0,0,0,,Өйткені мен сотталуға тиісті жын екенімді білдім.
Dialogue: 0,0:08:51.94,0:08:53.61,Default,,0,0,0,,Гвуу…
Dialogue: 0,0:08:54.32,0:08:55.95,Default,,0,0,0,,Менің мұғалімім-
Dialogue: 0,0:08:56.53,0:09:00.99,Default,,0,0,0,,Ол шынымен де өлімге әкелетін қылмыс жасаған күнәкар болды ма?
Dialogue: 0,0:09:01.95,0:09:03.79,Default,,0,0,0,,Менің әкем...
Dialogue: 0,0:09:04.37,0:09:06.12,Default,,0,0,0,,Бұл жын болды ма?
Dialogue: 0,0:09:07.38,0:09:09.84,Default,,0,0,0,,Заң әділдік болса...
Dialogue: 0,0:09:10.13,0:09:12.09,Default,,0,0,0,,Қате болма, бұл жын.
Dialogue: 0,0:09:12.26,0:09:13.26,Default,,0,0,0,,Ha
Dialogue: 0,0:09:13.63,0:09:17.64,Default,,0,0,0,,Өйткені ол мен сияқтыларды аспанға лақтыратын жігіт.
Dialogue: 0,0:09:19.22,0:09:20.30,Default,,0,0,0,,Әпкем…
Dialogue: 0,0:09:21.26,0:09:23.06,Default,,0,0,0,,Адамдар туралы не деуге болады?
Dialogue: 0,0:09:23.22,0:09:26.31,Default,,0,0,0,,Біз адамдар жасаған заңдарды ғана емес, көбірек қорғауымыз керек.
Dialogue: 0,0:09:26.44,0:09:28.85,Default,,0,0,0,,Бізде Теме заңы деген нәрсе бар.
Dialogue: 0,0:09:33.07,0:09:36.95,Default,,0,0,0,,Қарияң бұны бұзбайды.
Dialogue: 0,0:09:37.78,0:09:41.74,Default,,0,0,0,,Адамдарды адам ретінде құрметтеу Тек жазалаушының сенімі...
Dialogue: 0,0:09:42.24,0:09:43.95,Default,,0,0,0,,Майыстырмаңыз
Dialogue: 0,0:09:44.70,0:09:48.96,Default,,0,0,0,,Бұл жаман нәрсе ме, әлде жақсы нәрсе ме...
Dialogue: 0,0:09:49.08,0:09:51.96,Default,,0,0,0,,Бұл жын ба, әлде адам ба...
Dialogue: 0,0:09:52.21,0:09:53.88,Default,,0,0,0,,Сізге білудің қажеті жоқ
Dialogue: 0,0:09:54.38,0:09:56.76,Default,,0,0,0,,Ол жай ғана жақсы жігіт еді.
Dialogue: 0,0:09:57.38,0:10:00.97,Default,,0,0,0,,Ол да сен сияқты ебедейсіз ақымақ еді.
Dialogue: 0,0:10:02.85,0:10:05.98,Default,,0,0,0,,Не істеп жатырсың! Қылмыскерлердің денелерін тасымалдау...
Dialogue: 0,0:10:06.10,0:10:08.73,Default,,0,0,0,,Бұл тамаша сынақ рөлі!
Dialogue: 0,0:10:09.90,0:10:11.65,Default,,0,0,0,,Егер бұл шынымен де мәйіт болса.
Dialogue: 0,0:10:12.06,0:10:13.15,Default,,0,0,0,,Сугоны зерттеңіз
Dialogue: 0,0:10:13.27,0:10:14.61,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:10:14.73,0:10:16.74,Default,,0,0,0,,Мұны істеуге сізде қандай өкілеттік бар?
Dialogue: 0,0:10:16.86,0:10:19.66,Default,,0,0,0,,Мен елеусіз қалдырғым келмейтін Цудзигири - бұл...
Dialogue: 0,0:10:19.78,0:10:23.49,Default,,0,0,0,,Бұл сіздің және Икеда отбасының бастамасымен жасалды.
Dialogue: 0,0:10:23.62,0:10:25.66,Default,,0,0,0,,Мен сенің жаман жігітті жасырып жүргеніңді білемін.
Dialogue: 0,0:10:23.62,0:10:27.00,Default,,0,0,0,,Жолдан кет... (Асаемон) Хм...
Dialogue: 0,0:10:25.83,0:10:27.00,Default,,0,0,0,,Тез шығарыңыз.
Dialogue: 0,0:10:27.12,0:10:30.50,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Ондай мәйіттер ғана бар!
Dialogue: 0,0:10:30.63,0:10:32.00,Default,,0,0,0,,Бұл кеңістікті ашық қалдырыңыз...
Dialogue: 0,0:10:31.21,0:10:35.76,Default,,0,0,0,,Сіз мұны тегін жасай аласыз деп ойлаймын, Полли!
Dialogue: 0,0:10:32.13,0:10:35.76,Default,,0,0,0,,Жоқ, жоқ, жоқ, ызыл... о...
Dialogue: 0,0:10:35.88,0:10:37.17,Default,,0,0,0,,(Сұңқыр дыбыс)
Dialogue: 0,0:10:37.80,0:10:38.51,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:39.84,0:10:40.93,Default,,0,0,0,,Қызметкерлер де, клиенттер де ережені ұстанып, тәртіп сақтайды.➡
Dialogue: 0,0:10:41.22,0:10:42.14,Default,,0,0,0,,Бірдеңе шықты!
Dialogue: 0,0:10:42.26,0:10:45.51,Default,,0,0,0,,Арара Ішінде егеуқұйрық бар сияқты.
Dialogue: 0,0:10:46.56,0:10:48.10,Default,,0,0,0,,Міне, бұл жолы осы жерден! Хмф!
Dialogue: 0,0:10:48.64,0:10:51.81,Default,,0,0,0,,Энергетикалық тышқан Ни (Шинпачи) Бұл рас! Мылтық!
Dialogue: 0,0:10:51.94,0:10:53.40,Default,,0,0,0,,Ой~ Темера!
Dialogue: 0,0:10:53.52,0:10:55.86,Default,,0,0,0,,Қалай қарасаң да, егеуқұйрық емес!
Dialogue: 0,0:10:55.98,0:10:58.36,Default,,0,0,0,,Суго осы жолмен! Мынаны тексеріңіз!
Dialogue: 0,0:10:58.49,0:11:01.66,Default,,0,0,0,,Иә? Хиджиката-сан, маған да көмектес.
Dialogue: 0,0:11:01.78,0:11:03.24,Default,,0,0,0,,Олай болса, мынаны тексеріңіз!
Dialogue: 0,0:11:03.66,0:11:06.08,Default,,0,0,0,,Мүмкін тіпті елес пайда болады...
Dialogue: 0,0:11:06.20,0:11:06.95,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:11:07.08,0:11:09.46,Default,,0,0,0,,Сен ақымақсың ба? Ешқандай себеп жоқ.
Dialogue: 0,0:11:09.58,0:11:11.12,Default,,0,0,0,,Мен өлі денелерді көруден шаршадым!
Dialogue: 0,0:11:11.50,0:11:13.92,Default,,0,0,0,,Жаса... жолдан кет!
Dialogue: 0,0:11:14.04,0:11:14.92,Default,,0,0,0,,Цукуёми-кун мен Каэрубүки-санға қандай сынақтар қойылған?
Dialogue: 0,0:11:16.17,0:11:18.59,Default,,0,0,0,,Жеті ұрпақ қарғысқа ұшырайды, Кораа
Dialogue: 0,0:11:18.71,0:11:19.80,Default,,0,0,0,,Менің атым Джоэстар. Өмірімді сақтап қалғаныңыз үшін алғыс айтқым келеді.
Dialogue: 0,0:11:19.92,0:11:22.39,Default,,0,0,0,,Хиджиката-сан, онда да мәйіт бар.
Dialogue: 0,0:11:22.80,0:11:25.85,Default,,0,0,0,,Жоқ, майонез жолының кіреберісі...
Dialogue: 0,0:11:25.97,0:11:26.72,Default,,0,0,0,,мотивацияң — мүлде басқаша болады ғой?
Dialogue: 0,0:11:26.85,0:11:28.64,Default,,0,0,0,,Күшті болыңыз.
Dialogue: 0,0:11:29.10,0:11:32.48,Default,,0,0,0,,Жаман балалар олардың қолына түспей тұрып табуымыз керек.
Dialogue: 0,0:11:32.60,0:11:33.60,Default,,0,0,0,,Мына жігіттер?
Dialogue: 0,0:11:33.73,0:11:35.65,Default,,0,0,0,,Бұл өте айқын
Dialogue: 0,0:11:35.77,0:11:38.15,Default,,0,0,0,,Біз мұны әлдеқашан зерттедік.
Dialogue: 0,0:11:38.32,0:11:41.03,Default,,0,0,0,,Цудзигиридің жеке басы анықталды
Dialogue: 0,0:11:41.86,0:11:43.53,Default,,0,0,0,,Мен өзімді ақылмен жасырдым, бірақ...
Dialogue: 0,0:11:44.16,0:11:46.53,Default,,0,0,0,,Жой соғысы аяқталғаннан кейін...
Dialogue: 0,0:11:47.20,0:11:50.75,Default,,0,0,0,,Тазартуға тиіс патриоттар және олардың серіктері
Dialogue: 0,0:11:51.62,0:11:55.54,Default,,0,0,0,,Ол қаһарлы генерал ретінде танымал ханзада Сайфую Хитоцубашиді жеңіліске ұшыратты.
Dialogue: 0,0:11:55.67,0:11:58.88,Default,,0,0,0,,Анекохара шайқасына қатысқандар
Dialogue: 0,0:11:59.09,0:12:03.18,Default,,0,0,0,,Хитоцубаши енді сегунатты жаулап алу жолында...
Dialogue: 0,0:12:03.30,0:12:04.51,Default,,0,0,0,,Сол шайқасқа байланысты
Dialogue: 0,0:12:04.64,0:12:08.51,Default,,0,0,0,,Биліктен ұзақ кезең болды.
Dialogue: 0,0:12:09.93,0:12:13.48,Default,,0,0,0,,Соғыстан кейін сол шайқасқа қатысқан жауынгерлер...
Dialogue: 0,0:12:13.60,0:12:18.77,Default,,0,0,0,,Олардың көпшілігі, тіпті руластары да тазартудан зардап шекті...
Dialogue: 0,0:12:19.44,0:12:23.82,Default,,0,0,0,,Бірақ біз тіпті әйелдер мен балалардың да аяусыз жойылатынына өкінеміз.
Dialogue: 0,0:12:23.95,0:12:26.53,Default,,0,0,0,,Мұны сақтаудың жолы болды.
Dialogue: 0,0:12:27.12,0:12:30.62,Default,,0,0,0,,Бұл басы кесілген шенеунік, бұрынғы Йемон Икеда болатын.
Dialogue: 0,0:12:30.74,0:12:31.66,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:32.46,0:12:34.33,Default,,0,0,0,,Осы түнде Эмон өлтірілді.
Dialogue: 0,0:12:34.46,0:12:38.29,Default,,0,0,0,,Йемон құтқарған адамдар да құлап жатыр...
Dialogue: 0,0:12:38.67,0:12:40.50,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:12:42.17,0:12:43.51,Default,,0,0,0,,Сол бөлме енді сенікі, білесің бе.
Dialogue: 0,0:12:44.34,0:12:45.47,Default,,0,0,0,,Күйеуі
Dialogue: 0,0:12:46.76,0:12:50.31,Default,,0,0,0,,Сіздің бастарыңыз бен бұрынғы Йемонның басы сатылды.
Dialogue: 0,0:12:50.43,0:12:51.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:51.43,0:12:56.40,Default,,0,0,0,,Келесі генерал болады деген қауесет бар Кики Хитоцубашиді жеңу.
Dialogue: 0,0:12:57.73,0:12:58.77,Default,,0,0,0,,Мм...
Dialogue: 0,0:13:00.15,0:13:01.86,Default,,0,0,0,,Өлім құдайына...
Dialogue: 0,0:13:14.12,0:13:16.21,Default,,0,0,0,,Хитоцубашиге сатылды ма?
Dialogue: 0,0:13:16.33,0:13:18.63,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:13:19.25,0:13:20.42,Default,,0,0,0,,Осымен.
Dialogue: 0,0:13:20.79,0:13:23.01,Default,,0,0,0,,Бірде Хитоцубашидің кекін тапты...
Dialogue: 0,0:13:23.13,0:13:26.68,Default,,0,0,0,,Тазалау кезінде өлетіндер және олардың отбасылары...
Dialogue: 0,0:13:27.26,0:13:30.18,Default,,0,0,0,,Алдыңғы Йемон оған жасырын түрде қашып кетуге рұқсат берді.
Dialogue: 0,0:13:31.26,0:13:34.06,Default,,0,0,0,,Бірақ 10 жылдан кейін сол түні...
Dialogue: 0,0:13:34.48,0:13:36.69,Default,,0,0,0,,Икеда отбасы кәдеге жаратты...
Dialogue: 0,0:13:36.94,0:13:39.73,Default,,0,0,0,,Йемон құтқарғандар да...
Dialogue: 0,0:13:40.06,0:13:45.61,Default,,0,0,0,,Цуджигири... Жоқ, оны Икеда отбасы кәдеге жаратты.
Dialogue: 0,0:13:47.28,0:13:51.83,Default,,0,0,0,,Бұл кемеде тасымалданатын барлық денелер осындай.
Dialogue: 0,0:13:51.95,0:13:54.50,Default,,0,0,0,,Хитоцубаши мектебіне қосылу
Dialogue: 0,0:13:54.62,0:13:55.45,Default,,0,0,0,,Ах
Dialogue: 0,0:13:55.75,0:13:59.17,Default,,0,0,0,,Йемон сізге және басқаларға тарту ретінде ұсынды.
Dialogue: 0,0:13:59.29,0:14:01.29,Default,,0,0,0,,Сонымен... бұл...
Dialogue: 0,0:14:01.42,0:14:03.09,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,0:14:03.21,0:14:06.38,Default,,0,0,0,,Йемонның жүгіріп келе жатқан иті болды және оның алдыңғысын өлтірді.
Dialogue: 0,0:14:06.51,0:14:09.43,Default,,0,0,0,,Цудзигири де жасаған жігіт осылай дейді емес пе?
Dialogue: 0,0:14:09.55,0:14:12.22,Default,,0,0,0,,Асэмон Цудзигири жасаған жоқ!
Dialogue: 0,0:14:12.35,0:14:13.85,Default,,0,0,0,,Джин Чан - жалғыз қылмыскер!
Dialogue: 0,0:14:13.97,0:14:16.81,Default,,0,0,0,,Жоқ! Керек емес сөздер айтпа, Кагура-чан!
Dialogue: 0,0:14:16.93,0:14:18.64,Default,,0,0,0,,Оянатын уақыт келді
Dialogue: 0,0:14:18.77,0:14:21.40,Default,,0,0,0,,Темераны және басқаларды тасымалдаудың орнына алып жүрді.
Dialogue: 0,0:14:21.52,0:14:23.61,Default,,0,0,0,,Біртүрлі ұнтақты көтеріп бара жатқан Джин-Чан Аль!
Dialogue: 0,0:14:23.73,0:14:25.36,Default,,0,0,0,,Ол затты кім және қашан алып жүрді?
Dialogue: 0,0:14:25.48,0:14:27.15,Default,,0,0,0,,Алдан, Қараңғыда төрелік ететін ұнтақ!
Dialogue: 0,0:14:27.28,0:14:29.41,Default,,0,0,0,,Мен сені қараңғылықпен соттайын ба?
Dialogue: 0,0:14:30.11,0:14:32.12,Default,,0,0,0,,Бірақ Хитоцубаши мырза.
Dialogue: 0,0:14:32.24,0:14:35.12,Default,,0,0,0,,Менің бұл ебедейсіз адамды беруге шамам жоқ.
Dialogue: 0,0:14:35.79,0:14:38.96,Default,,0,0,0,,Өкінішке орай, біз адамдарға жағымпаздануға шебер емеспіз.
Dialogue: 0,0:14:39.12,0:14:41.13,Default,,0,0,0,,Егер сіз бұл мәселеден бас тартпасаңыз...
Dialogue: 0,0:14:41.58,0:14:44.63,Default,,0,0,0,,Маған оның келесі генералға кандидат бола ма, жоқ па, бәрібір...
Dialogue: 0,0:14:44.75,0:14:47.42,Default,,0,0,0,,Лорд Хитоцубаши жауапты болады.
Dialogue: 0,0:14:47.55,0:14:48.63,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:14:48.97,0:14:53.05,Default,,0,0,0,,Бұл кемедегі жүк әдеттегі процедуралар арқылы реттелді.
Dialogue: 0,0:14:53.18,0:14:55.35,Default,,0,0,0,,Қылмыс жасады деп айыптауға негіз жоқ.
Dialogue: 0,0:14:55.47,0:15:00.02,Default,,0,0,0,,Бұл кемеге қуана семсер ұсынылды.
Dialogue: 0,0:15:00.14,0:15:04.06,Default,,0,0,0,,Мен сол сот слэш үшін тек мәйіт бар деп естідім.
Dialogue: 0,0:15:04.57,0:15:07.94,Default,,0,0,0,,Өлім Құдайы, ол адамдарды кесіп таста.
Dialogue: 0,0:15:08.07,0:15:09.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:10.03,0:15:11.82,Default,,0,0,0,,Егер сіз бізге
Dialogue: 0,0:15:11.95,0:15:15.08,Default,,0,0,0,,Икеда отбасының келесі сегунат ретіндегі орны сенімді.
Dialogue: 0,0:15:15.20,0:15:18.20,Default,,0,0,0,,Бұл мәселені қараңғыда да сақтауға болады.
Dialogue: 0,0:15:18.66,0:15:23.17,Default,,0,0,0,,Сол үшін патронаттық ата-анасының басын кесіп алған жоқ па?
Dialogue: 0,0:15:23.63,0:15:25.00,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:33.68,0:15:36.93,Default,,0,0,0,,Асемон... жақсы шыдамды болдыңыз.
Dialogue: 0,0:15:37.60,0:15:39.27,Default,,0,0,0,,Жоғары қара
Dialogue: 0,0:15:39.98,0:15:42.85,Default,,0,0,0,,Сен тапсырманы жақсы орындадың.
Dialogue: 0,0:15:43.65,0:15:46.90,Default,,0,0,0,,Ата-ана немесе мұғалім болса да...
Dialogue: 0,0:15:47.07,0:15:50.57,Default,,0,0,0,,Күнәларды бірдей соттау – біздің міндетіміз.
Dialogue: 0,0:15:51.32,0:15:53.53,Default,,0,0,0,,Сіз Икеда отбасын құрметтейсіз...
Dialogue: 0,0:15:53.66,0:15:57.62,Default,,0,0,0,,Әкемнің атын сол қылышпен қорғадым.
Dialogue: 0,0:16:02.04,0:16:06.04,Default,,0,0,0,,Лорд Йемон... И
Dialogue: 0,0:16:07.21,0:16:10.55,Default,,0,0,0,,Сіз бұл қылышпен нақты нені қорғадыңыз?
Dialogue: 0,0:16:12.22,0:16:16.85,Default,,0,0,0,,Мен... мен...
Dialogue: 0,0:16:19.01,0:16:22.06,Default,,0,0,0,,Осындай нәрсе үшін сол адам...
Dialogue: 0,0:16:22.48,0:16:24.73,Default,,0,0,0,,Сіз не істеп жатырсыз? Асықшы!
Dialogue: 0,0:16:24.85,0:16:28.98,Default,,0,0,0,,Сансыз күнәкарлардың басын кескен өлім құдайының қылышын көрсетші.
Dialogue: 0,0:16:29.44,0:16:31.78,Default,,0,0,0,,Мен не туралы шатасуым керек?
Dialogue: 0,0:16:31.90,0:16:33.82,Default,,0,0,0,,Ата-анаңның басын шауып алған қылышың...
Dialogue: 0,0:16:33.95,0:16:35.53,Default,,0,0,0,,Ол лас... Гах!
Dialogue: 0,0:16:38.12,0:16:39.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:39.37,0:16:40.74,Default,,0,0,0,,Мм... Концер...
Dialogue: 0,0:16:41.12,0:16:45.00,Default,,0,0,0,,Әй, жаңа ғана аузымен сөйлеген жігіт
Dialogue: 0,0:16:45.12,0:16:46.50,Default,,0,0,0,,Gack cum...
Dialogue: 0,0:16:46.63,0:16:49.17,Default,,0,0,0,,Мына жігіттің қылышында не лас?
Dialogue: 0,0:16:49.34,0:16:51.67,Default,,0,0,0,,Шинигами қайда орналасқан?
Dialogue: 0,0:16:51.80,0:16:54.05,Default,,0,0,0,,Көзіңізді ашып, мұқият қараңыз.
Dialogue: 0,0:16:54.26,0:16:56.30,Default,,0,0,0,,Сен... Сен!
Dialogue: 0,0:16:56.80,0:17:00.72,Default,,0,0,0,,Егер сіз қырғи-қабақ болсаңыз, сіз осындасыз, шошқалар.
Dialogue: 0,0:17:02.60,0:17:03.64,Default,,0,0,0,,Жоқ, жоқ!
Dialogue: 0,0:17:03.77,0:17:06.19,Default,,0,0,0,,Не! Не болып жатыр?
Dialogue: 0,0:17:09.23,0:17:15.28,Default,,0,0,0,,Кешіріңіз, бірақ нағыз Шинигами бір қылышпен ештеңе істемейді.
Dialogue: 0,0:17:16.03,0:17:20.37,Default,,0,0,0,,Темераня, сен кесілген таяқпен жақсы көрінесің
Dialogue: 0,0:17:21.79,0:17:23.95,Default,,0,0,0,,Оңай өлемін деп ойлама.
Dialogue: 0,0:17:25.12,0:17:27.75,Default,,0,0,0,,Келіңдер, балалар! Егер бұл жай ғана...
Dialogue: 0,0:17:27.88,0:17:30.34,Default,,0,0,0,,Жарайсыз, сэр.
Dialogue: 0,0:17:30.46,0:17:34.51,Default,,0,0,0,,Сіз оны бізге немесе оларға бермеуді жоспарлайсыз ба?
Dialogue: 0,0:17:35.22,0:17:38.26,Default,,0,0,0,,Оның да, сіздің де басыңыз.
Dialogue: 0,0:17:38.43,0:17:41.01,Default,,0,0,0,,Менің мойным енді...
Dialogue: 0,0:17:41.14,0:17:43.56,Default,,0,0,0,,Басын кескен ақымақ шенеунікке рахмет.
Dialogue: 0,0:17:45.02,0:17:47.94,Default,,0,0,0,,Онда мен саған мына басты беремін...
Dialogue: 0,0:17:48.06,0:17:51.90,Default,,0,0,0,,Маған ол сияқты бас кесетін ақымақ шенеунік керек.
Dialogue: 0,0:17:52.02,0:17:53.15,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:53.57,0:17:58.20,Default,,0,0,0,,Кет! Ол жігіттерден құтыл!
Dialogue: 0,0:17:59.24,0:18:00.07,Default,,0,0,0,,Асемон!
Dialogue: 0,0:18:00.74,0:18:02.83,Default,,0,0,0,,Сенің қылышың кір емес!
Dialogue: 0,0:18:03.45,0:18:06.21,Default,,0,0,0,,Өменің қариясын өлтірген сен едің!
Dialogue: 0,0:18:07.37,0:18:08.71,Default,,0,0,0,,Бұл Яемон екеуміз!
Dialogue: 0,0:18:09.29,0:18:12.59,Default,,0,0,0,,Сонда да сен ол қылышты тартпайсың!
Dialogue: 0,0:18:13.46,0:18:16.05,Default,,0,0,0,,Тіпті өлтірілу керек күнәнің алдында да...
Dialogue: 0,0:18:16.17,0:18:19.72,Default,,0,0,0,,Сіз әлі де жүзіңізді өзіңізге бағыттайсыз ба?
Dialogue: 0,0:18:20.05,0:18:22.93,Default,,0,0,0,,Менің қылышымды қолдануға сонша бос уақытым болса ғой...
Dialogue: 0,0:18:23.39,0:18:26.85,Default,,0,0,0,,Ішіме пышақ тығылса да, ішегім ілініп қалса да...
Dialogue: 0,0:18:26.98,0:18:30.40,Default,,0,0,0,,Сол семсерді таяғыңмен алсаң да, алға ұмтыл!
Dialogue: 0,0:18:30.81,0:18:33.48,Default,,0,0,0,,Йемонның басы ма, менікі ме маңызды емес!
Dialogue: 0,0:18:33.61,0:18:37.03,Default,,0,0,0,,Сол қылышпен алдыңдағы жауды шауып таста!
Dialogue: 0,0:18:37.57,0:18:40.03,Default,,0,0,0,,Міне, біз шынымен де қорғауымыз керек.
Dialogue: 0,0:18:40.16,0:18:43.08,Default,,0,0,0,,Сізде қоғамдық жазалаушының мақтанышы жоқ па?
Dialogue: 0,0:18:45.49,0:18:48.96,Default,,0,0,0,,Кім адамды адамға қайтара алады?
Dialogue: 0,0:18:49.08,0:18:52.08,Default,,0,0,0,,Адамдардың басын кесетін жын емес.
Dialogue: 0,0:18:52.21,0:18:55.67,Default,,0,0,0,,Адамдардың жанын ұрлайтын өлім құдайы емес
Dialogue: 0,0:18:57.26,0:19:02.59,Default,,0,0,0,,Адамдардың күнәсін өлтіріп, жанын сақта.
Dialogue: 0,0:19:11.31,0:19:13.11,Default,,0,0,0,,Тек адамдар
Dialogue: 0,0:19:24.91,0:19:26.24,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:19:26.74,0:19:28.70,Default,,0,0,0,,Сіз шынымен оны өлтіремін деп ойладыңыз ба?
Dialogue: 0,0:19:28.83,0:19:29.45,Default,,0,0,0,,О
Dialogue: 0,0:19:29.58,0:19:31.21,Default,,0,0,0,,ақымақ адам
Dialogue: 0,0:19:31.33,0:19:34.75,Default,,0,0,0,,Біреуді өртеу үшін өз мойныңды жем ретінде пайдаланатын сияқтысың.
Dialogue: 0,0:19:35.71,0:19:39.46,Default,,0,0,0,,Қандай қылмыс жасағаныңды білмеймін, жауыз.
Dialogue: 0,0:19:39.97,0:19:43.89,Default,,0,0,0,,Бірақ... ол адам саған неге көмектесті?
Dialogue: 0,0:19:44.01,0:19:45.93,Default,,0,0,0,,Мен аздап түсіндім деп ойлаймын.
Dialogue: 0,0:19:46.76,0:19:50.56,Default,,0,0,0,,Ол адам ешнәрсе істеген жоқ.
Dialogue: 0,0:19:51.60,0:19:52.48,Default,,0,0,0,,Джин Чан!
Dialogue: 0,0:19:53.15,0:19:53.98,Default,,0,0,0,,Асемон-сан!
Dialogue: 0,0:19:59.32,0:20:01.24,Default,,0,0,0,,Ол жерден кет!
Dialogue: 0,0:20:02.61,0:20:04.62,Default,,0,0,0,,Yaemon қайда?
Dialogue: 0,0:20:10.00,0:20:13.00,Default,,0,0,0,,Асаемон Кешіріңіз.
Dialogue: 0,0:20:13.42,0:20:17.13,Default,,0,0,0,,Сіз өзіңіздің алдыңғы ағаңыз сияқты қателік жасауға қалай батылы барасыз?
Dialogue: 0,0:20:17.46,0:20:22.22,Default,,0,0,0,,Біз Икеда отбасын таңертең және түнде қорғауға ант етсек те.
Dialogue: 0,0:20:23.22,0:20:25.72,Default,,0,0,0,,Сіз шынымен сатқын болдыңыз ба?
Dialogue: 0,0:20:27.05,0:20:29.81,Default,,0,0,0,,Маған опасыздық жасаған сен болдың.
Dialogue: 0,0:20:30.31,0:20:33.35,Default,,0,0,0,,Ресми жазалаушы Икеда Яемон...
Dialogue: 0,0:20:33.89,0:20:36.56,Default,,0,0,0,,Бұл атауды одан әрі ластау ...
Dialogue: 0,0:20:37.40,0:20:38.90,Default,,0,0,0,,Мен сені кешірмеймін!
Dialogue: 0,0:20:40.53,0:20:43.65,Default,,0,0,0,,Алдыңғы жолдасыңыздың жолымен жүресіз бе?
Dialogue: 0,0:20:44.03,0:20:48.70,Default,,0,0,0,,Күнәкардың өмірін сақтау үшін мен өз рөлімді тастадым...
Dialogue: 0,0:20:49.24,0:20:50.70,Default,,0,0,0,,Біздің рөл...
Dialogue: 0,0:20:51.75,0:20:53.54,Default,,0,0,0,,Қорғауға тиісті заң қандай?
Dialogue: 0,0:20:53.66,0:20:56.42,Default,,0,0,0,,Бұл адамдарды адамдар ретінде қорғауға арналған.
Dialogue: 0,0:20:57.83,0:21:00.34,Default,,0,0,0,,Ол жазықсызды құтқарады...
Dialogue: 0,0:21:00.46,0:21:04.55,Default,,0,0,0,,Ол заңды ұстанған, халық алдында өте жақсы жазалаушы.
Dialogue: 0,0:21:07.93,0:21:09.68,Default,,0,0,0,,Кімді соттау керек
Dialogue: 0,0:21:09.81,0:21:13.43,Default,,0,0,0,,Біз оны үйімізді қорғау үшін шақырдық және оны өлтірдік!
Dialogue: 0,0:21:14.81,0:21:15.85,Default,,0,0,0,,Йемон...
Dialogue: 0,0:21:20.07,0:21:22.57,Default,,0,0,0,,Мен сенің осында менімен бірге өлгеніңді қалаймын.
Dialogue: 0,0:21:24.86,0:21:26.95,Default,,0,0,0,,Сіз өзара кек алуға дайынсыз ба?
Dialogue: 0,0:21:27.16,0:21:30.03,Default,,0,0,0,,Өміріңді қылышпен қатерге алсаң...
Dialogue: 0,0:21:30.33,0:21:33.95,Default,,0,0,0,,Қылыш осы 18-ші Йемонның мойнына жеткенде,
Dialogue: 0,0:21:34.54,0:21:35.96,Default,,0,0,0,,Осыншама алысқа барсаң да...
Dialogue: 0,0:21:36.08,0:21:39.71,Default,,0,0,0,,Адам қалдырған қызықсыз нәрселерді қорғау
Dialogue: 0,0:21:43.42,0:21:45.34,Default,,0,0,0,,Яемон!
Dialogue: 0,0:21:45.92,0:21:46.76,Default,,0,0,0,,баяу
Dialogue: 0,0:21:46.88,0:21:49.93,Default,,0,0,0,,Менің қылышым келді.
Dialogue: 0,0:21:52.64,0:21:54.43,Default,,0,0,0,,Сіздің мойныңызда
Dialogue: 0,0:21:55.89,0:21:56.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:02.48,0:22:03.78,Default,,0,0,0,,Арх! Алақай!
Dialogue: 0,0:22:09.70,0:22:10.62,Default,,0,0,0,,Ха!
Dialogue: 0,0:22:11.78,0:22:15.20,Default,,0,0,0,,Асемон-сан!
Dialogue: 0,0:22:15.41,0:22:20.42,Default,,0,0,0,,♪~
Dialogue: 0,0:23:40.96,0:23:45.46,Default,,0,0,0,,~♪
Dialogue: 0,0:23:46.13,0:23:47.09,Default,,0,0,0,,Адамдардан адамдарға
Dialogue: 0,0:23:47.21,0:23:48.92,Default,,0,0,0,,Нені қайтаруға болады -
Dialogue: 0,0:23:49.34,0:23:53.47,Default,,0,0,0,,Адамдардың күнәсін өлтіріп, жанын сақта.
Dialogue: 0,0:23:53.89,0:23:55.39,Default,,0,0,0,,Тек адамдар
Dialogue: 0,0:23:57.31,0:23:59.22,Default,,0,0,0,,Келесі жолы «Қоштасу Шинигами»
Dialogue: 0,0:24:00.72,0:24:06.72,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory