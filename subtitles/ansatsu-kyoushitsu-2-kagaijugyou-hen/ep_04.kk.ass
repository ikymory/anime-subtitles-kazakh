Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.46,0:00:10.42,Default,,0,0,0,,Сөйлеу?
Dialogue: 0,0:00:10.51,0:00:12.01,Default,,0,0,0,,Иә
Dialogue: 0,0:00:12.09,0:00:15.93,Default,,0,0,0,,Мен сізге білімімнің басты жетістігі ретінде ұсынғым келеді.
Dialogue: 0,0:00:16.01,0:00:18.68,Default,,0,0,0,,Сіздің отбасыңыз да бақытты болады.
Dialogue: 0,0:00:19.56,0:00:20.89,Default,,0,0,0,,Демек, Қамалардың сыртында шынымен қалалар бар екен, және онда адамдар тұрады…
Dialogue: 0,0:00:21.47,0:00:24.23,Default,,0,0,0,,Асано-кун қолжазбасы
Dialogue: 0,0:00:24.31,0:00:25.23,Default,,0,0,0,,Иә
Dialogue: 0,0:00:27.86,0:00:28.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:30.15,0:00:31.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:31.44,0:00:34.07,Default,,0,0,0,,Барлығының көзінше бұл мазмұн ше?
Dialogue: 0,0:00:35.16,0:00:39.08,Default,,0,0,0,,«Мен Е сыныбында сыныптастарымның жемқорлықты көрдім».
Dialogue: 0,0:00:39.74,0:00:43.71,Default,,0,0,0,,«Белгілі бір адамдармен арам жыныстық қатынасқа түсуге әуестенген студент».
Dialogue: 0,0:00:43.79,0:00:45.25,Default,,0,0,0,,«Зорлықшыл студент»
Dialogue: 0,0:00:45.33,0:00:48.17,Default,,0,0,0,,«Өмірдегі жалғыз мақсаты тамақ ішу болып табылатын семіз оқушы»
Dialogue: 0,0:00:48.25,0:00:50.75,Default,,0,0,0,,«Бұзылған әрекеттерге баратын студенттер»
Dialogue: 0,0:00:50.84,0:00:54.63,Default,,0,0,0,,«Маңызды қарым-қатынас проблемалары бар студенттер»
Dialogue: 0,0:00:54.72,0:00:58.64,Default,,0,0,0,,«Олардың негізгі ғимаратқа оралу мүмкіндігі жоқ».
Dialogue: 0,0:00:58.72,0:01:00.89,Default,,0,0,0,,«Сол Куногаоканың студенті ретінде»
Dialogue: 0,0:01:00.97,0:01:04.85,Default,,0,0,0,,«Мен оларды аздап болса да қалпына келтіргім келді».
Dialogue: 0,0:01:06.27,0:01:09.31,Default,,0,0,0,,«Олай болса, бәріңізге бір өтінішім бар».
Dialogue: 0,0:01:09.40,0:01:13.44,Default,,0,0,0,,«Мен олардың бүкіл өмірін бақылап, қайта тәрбиелеуім үшін».
Dialogue: 0,0:01:13.53,0:01:17.49,Default,,0,0,0,,«Е тобының басқару комитетін құруға келісіміңізді беріңіз.»
Dialogue: 0,0:01:18.32,0:01:21.08,Default,,0,0,0,,Бүкіл мектеп жиналысында оқысаңыз
Dialogue: 0,0:01:21.16,0:01:25.33,Default,,0,0,0,,Сізге жаңа студенттік кеңестің басқару комитетін дайындаймыз.
Dialogue: 0,0:01:25.41,0:01:28.42,Default,,0,0,0,,Сынып бойынша түзетілген сыныптастары
Dialogue: 0,0:01:28.50,0:01:31.80,Default,,0,0,0,,Бұл есеп тек орта мектепте ғана емес, сонымен қатар орта мектепте де резонанс тудырады.
Dialogue: 0,0:01:31.88,0:01:34.84,Default,,0,0,0,,Сіз тіпті үздік университеттерге ұсыныстарды көре аласыз.
Dialogue: 0,0:01:34.92,0:01:35.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:01:38.38,0:01:41.39,Default,,0,0,0,,Әлсіз жағыңнан әлі өткен жоқсың.
Dialogue: 0,0:01:41.47,0:01:42.43,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:42.51,0:01:45.98,Default,,0,0,0,,Бұл сіздің қайта туылуыңыз үшін қажетті рәсім.
Dialogue: 0,0:01:46.60,0:01:49.10,Default,,0,0,0,,Бұрынғы достарына үстемдік ету арқылы
Dialogue: 0,0:01:49.19,0:01:52.07,Default,,0,0,0,,Өзіңді мықты адамдай ұстауды үйрен.
Dialogue: 0,0:01:53.94,0:01:55.15,Default,,0,0,0,,Күшті…
Dialogue: 0,0:01:55.94,0:01:59.20,Default,,0,0,0,,Менің отбасым сияқты күшті адамдар...
Dialogue: 0,0:01:59.86,0:02:02.95,Default,,0,0,0,,Олар сияқты... күшті адамдар
Dialogue: 0,0:02:08.33,0:02:09.71,Default,,0,0,0,,Мен істеймін
Dialogue: 0,0:02:14.50,0:02:15.34,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:16.26,0:02:18.26,Default,,0,0,0,,Мен полиция шақырамын, Коросей.
Dialogue: 0,0:02:18.34,0:02:19.34,Default,,0,0,0,,Нюя!
Dialogue: 0,0:02:19.43,0:02:21.43,Default,,0,0,0,,Мұғалім неге қараңғыда жоғалып кетті?
Dialogue: 0,0:02:21.51,0:02:23.43,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:02:23.51,0:02:25.93,Default,,0,0,0,,Менің енді өлтіруге еш қатысым жоқ.
Dialogue: 0,0:02:27.85,0:02:28.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:29.56,0:02:31.60,Default,,0,0,0,,Көрнекі макияж
Dialogue: 0,0:02:31.69,0:02:34.77,Default,,0,0,0,,Мен сіздің ерекше отаку кейіпкеріңізді өлтіруге тырыстым.
Dialogue: 0,0:02:34.86,0:02:36.82,Default,,0,0,0,,Бұл мен емеспін.
Dialogue: 0,0:02:36.90,0:02:38.53,Default,,0,0,0,,Такебаяши-кун
Dialogue: 0,0:02:38.61,0:02:41.53,Default,,0,0,0,,Мұғалімді өлтірмеу сенің еркіндігің.
Dialogue: 0,0:02:41.61,0:02:42.87,Default,,0,0,0,,Бірақ
Dialogue: 0,0:02:42.95,0:02:45.58,Default,,0,0,0,,Адам өлтіру – күнделікті өмірде болатын әрекет.
Dialogue: 0,0:02:45.66,0:02:46.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:46.87,0:02:49.12,Default,,0,0,0,,Негізі, тек отбасы мойындау үшін
Dialogue: 0,0:02:49.21,0:02:52.79,Default,,0,0,0,,Сіз өзіңіздің еркін өзіңізді өлтіргіңіз келеді.
Dialogue: 0,0:02:52.88,0:02:55.50,Default,,0,0,0,,Бірақ егер бұл сен болсаң, бір күні
Dialogue: 0,0:02:55.59,0:03:00.01,Default,,0,0,0,,Ішіңдегі қарғыс атқан адамды өлтіретін күн міндетті түрде келеді.
Dialogue: 0,0:03:00.09,0:03:02.43,Default,,0,0,0,,Сізде сонша күш бар
Dialogue: 0,0:03:03.51,0:03:07.06,Default,,0,0,0,,Асықпаңыз, асықпаңыз және өлтіру мүмкіндігін мақсат етіңіз.
Dialogue: 0,0:03:07.14,0:03:11.19,Default,,0,0,0,,Ақыл-кеңес керек болса, қараңғылық жамылып кез келген уақытта келемін.
Dialogue: 0,0:03:11.27,0:03:13.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:20.03,0:03:20.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:21.07,0:03:23.20,Default,,0,0,0,,Бамбук орманы тағы бір сөз айтады?
Dialogue: 0,0:03:23.28,0:03:25.45,Default,,0,0,0,,- (Чиба) Мен қатты толқып тұрмын - (Сугино) А?
Dialogue: 0,0:03:25.53,0:03:28.29,Default,,0,0,0,,Мен бамбук орманынан кісі өлтіру ниетін сеземін.
Dialogue: 0,0:03:28.37,0:03:30.33,Default,,0,0,0,,Маңызды нәрсе
Dialogue: 0,0:03:30.41,0:03:33.17,Default,,0,0,0,,Мен оны шатастырып жіберетін сияқтымын...
Dialogue: 0,0:03:33.96,0:03:37.09,Default,,0,0,0,,Менің не істегім келетінін тыңдаңыз.
Dialogue: 0,0:03:37.17,0:03:40.26,Default,,0,0,0,,Енді бұл күшті болудың алғашқы қадамы.
Dialogue: 0,0:03:40.34,0:03:41.84,Default,,0,0,0,,Котаро Такебаяши
Dialogue: 0,0:03:41.93,0:03:46.60,Default,,0,0,0,,Мен болған Е сыныбы – әлсіз адамдар тобы.
Dialogue: 0,0:03:46.68,0:03:49.31,Default,,0,0,0,,Себебі менде оқу қабілетінің күші болмады
Dialogue: 0,0:03:49.39,0:03:53.10,Default,,0,0,0,,Мектебіміздегі барлық адамдардан кемсітушілікке ұшырадым.
Dialogue: 0,0:03:54.10,0:03:55.65,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:03:55.73,0:03:58.02,Default,,0,0,0,,Мен осындай Е класына жататынмын...
Dialogue: 0,0:03:59.28,0:04:02.11,Default,,0,0,0,,Қызметші кафесіндей ыңғайлы.
Dialogue: 0,0:04:02.20,0:04:03.86,Default,,0,0,0,,- (Гакухиде) Не! -(Асано) Әй!
Dialogue: 0,0:04:05.57,0:04:08.24,Default,,0,0,0,,Мен өтірік айттым.
Dialogue: 0,0:04:08.33,0:04:11.33,Default,,0,0,0,,Мен мықты болып, танылғым келеді.
Dialogue: 0,0:04:11.41,0:04:12.25,Default,,0,0,0,,Бірақ
Dialogue: 0,0:04:12.33,0:04:16.25,Default,,0,0,0,,Е сыныбында пайдасыз болдым, мені сатып кеттім.
Dialogue: 0,0:04:16.33,0:04:19.25,Default,,0,0,0,,Сыныптастарым мені тексеруге талай рет келді.
Dialogue: 0,0:04:19.92,0:04:23.88,Default,,0,0,0,,Мұғалім мен сияқты баяу оқушыны да түсіне алады.
Dialogue: 0,0:04:23.97,0:04:26.51,Default,,0,0,0,,Қол ауыстырды, бұйымдарды ауыстырды, тапқырлықпен үйретті.
Dialogue: 0,0:04:27.85,0:04:30.77,Default,,0,0,0,,Менің отбасым да, бәрі де мені құптаған жоқ.
Dialogue: 0,0:04:30.85,0:04:34.77,Default,,0,0,0,,Е сыныбында барлығы маған бірдей көзқараспен қарады.
Dialogue: 0,0:04:34.85,0:04:38.36,Default,,0,0,0,,Баршаңызға, әлем мойындаған, айқын мықты тұлғалар болуды мақсат еткен.
Dialogue: 0,0:04:38.44,0:04:41.15,Default,,0,0,0,,Мен оны дұрыс деп есептеймін және оны құрметтеймін.
Dialogue: 0,0:04:41.23,0:04:45.03,Default,,0,0,0,,Бірақ мен біраз уақытқа әлсіз боламын.
Dialogue: 0,0:04:45.11,0:04:48.32,Default,,0,0,0,,Әлсізге шыда, әлсіздіктен ләззат ал
Dialogue: 0,0:04:48.41,0:04:50.91,Default,,0,0,0,,Мықтының басын көздеген өмірге оралу
Dialogue: 0,0:04:50.99,0:04:53.12,Default,,0,0,0,,Жындысың ба, кішкентай шабақ?
Dialogue: 0,0:04:53.20,0:04:55.92,Default,,0,0,0,,Бас тартыңыз және кешірім сұраңыз, Такебаяши, немесе...
Dialogue: 0,0:04:56.96,0:04:57.79,Default,,0,0,0,,Не!
Dialogue: 0,0:04:57.88,0:05:00.84,Default,,0,0,0,,Көрмедегі заттарды аралап шықтым.
Dialogue: 0,0:05:00.92,0:05:04.63,Default,,0,0,0,,Бұл жеке мектептің үздік менеджерін танудың қалқанындай.
Dialogue: 0,0:05:04.72,0:05:05.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:05.97,0:05:08.97,Default,,0,0,0,,Төраға шынымен де мықты адам.
Dialogue: 0,0:05:09.05,0:05:11.56,Default,,0,0,0,,Барлық әрекеттер ұтымды
Dialogue: 0,0:05:12.47,0:05:15.02,Default,,0,0,0,,(Қалқанның сынған дыбысы)
Dialogue: 0,0:05:15.10,0:05:16.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:16.85,0:05:18.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:19.44,0:05:20.94,Default,,0,0,0,,Асано-кун айтады
Dialogue: 0,0:05:21.02,0:05:24.57,Default,,0,0,0,,Бұрын осыған ұқсас әрекет жасаған оқушы болды ма?
Dialogue: 0,0:05:24.65,0:05:27.61,Default,,0,0,0,,Прецеденттен негізді түрде қарастырылған
Dialogue: 0,0:05:28.45,0:05:31.62,Default,,0,0,0,,Мен де Е тобына барамын.
Dialogue: 0,0:05:34.16,0:05:35.37,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:05:35.46,0:05:37.71,Default,,0,0,0,,Мен сені құтқара алмаймын.
Dialogue: 0,0:05:37.79,0:05:41.79,Default,,0,0,0,,Мен саған мықты болуға мүмкіндік бердім.
Dialogue: 0,0:05:41.88,0:05:43.25,Default,,0,0,0,,Күшті?
Dialogue: 0,0:05:43.34,0:05:46.97,Default,,0,0,0,,Ол жай ғана қорқып кеткендей болды.
Dialogue: 0,0:05:47.05,0:05:49.68,Default,,0,0,0,,Сіз және барлығы
Dialogue: 0,0:05:49.76,0:05:50.76,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:51.51,0:05:52.93,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:59.81,0:06:03.44,Default,,0,0,0,,Екінші семестрден бастап қастандыққа жаңа элементтер енгізіледі.
Dialogue: 0,0:06:03.52,0:06:04.98,Default,,0,0,0,,Солардың бірі – мылтық.
Dialogue: 0,0:06:05.07,0:06:06.03,Default,,0,0,0,,Әлде... мылтық па?
Dialogue: 0,0:06:06.11,0:06:09.53,Default,,0,0,0,,Оның құдіреті - қастандық үшін үлкен тартымдылық.
Dialogue: 0,0:06:10.41,0:06:14.04,Default,,0,0,0,,Терасака сияқты қауіпті пайдалануға мүлде тыйым салынады.
Dialogue: 0,0:06:14.12,0:06:17.33,Default,,0,0,0,,Осы мақсатта мылтықпен қауіпсіз жұмыс істеу өте маңызды.
Dialogue: 0,0:06:17.41,0:06:19.71,Default,,0,0,0,,Бір адам оны жақсы жаттап алсын
Dialogue: 0,0:06:19.79,0:06:24.63,Default,,0,0,0,,Менің рұқсатым және бір жетекшім - мылтықты қолдану шарты.
Dialogue: 0,0:06:24.71,0:06:27.13,Default,,0,0,0,,Енді біреу есінде ме?
Dialogue: 0,0:06:27.22,0:06:28.67,Default,,0,0,0,,Уау, өте қалың.
Dialogue: 0,0:06:28.76,0:06:31.26,Default,,0,0,0,,Жоқ, сол ұлттық біліктілік бойынша оқу.
Dialogue: 0,0:06:32.14,0:06:35.26,Default,,0,0,0,,Оқуға пайдасы жоқ білім
Dialogue: 0,0:06:35.35,0:06:39.10,Default,,0,0,0,,Бұл да бір жерде пайдалы болуы мүмкін.
Dialogue: 0,0:06:39.19,0:06:41.19,Default,,0,0,0,,Сіз оны жаттай аласыз ба?
Dialogue: 0,0:06:41.27,0:06:42.90,Default,,0,0,0,,Такебаяши-кун
Dialogue: 0,0:06:42.98,0:06:43.94,Default,,0,0,0,,Иә
Dialogue: 0,0:06:44.02,0:06:46.15,Default,,0,0,0,,Егер сіз оны 2 маусымның ашылуына арналған пародия әнін жасасаңыз, бұл оңай болады.
Dialogue: 0,0:06:46.15,0:06:48.19,Default,,0,0,0,,2 маусымның ашылуына арналған пародия әнін жасасаңыз, оңай болады.
