Dialogue: 0,0:00:07.84,0:00:09.84,Default,,0,0,0,,B. (гитара дыбысы)
Dialogue: 0,0:00:09.84,0:00:12.51,Default,,0,0,0,,Emaj7. (гитара дыбысы)
Dialogue: 0,0:00:12.51,0:00:14.84,Default,,0,0,0,,B. (гитара дыбысы)
Dialogue: 0,0:00:14.84,0:00:17.01,Default,,0,0,0,,Е. (гитара дыбысы)
Dialogue: 0,0:00:17.01,0:00:19.01,Default,,0,0,0,,B. (гитара дыбысы)
Dialogue: 0,0:00:19.01,0:00:21.02,Default,,0,0,0,,Е. (гитара дыбысы)
Dialogue: 0,0:00:21.02,0:00:23.02,Default,,0,0,0,,F Шах…. (гитара дыбысы)
Dialogue: 0,0:00:23.02,0:00:26.52,Default,,0,0,0,,Хмм... F#.
Dialogue: 0,0:00:26.52,0:00:28.52,Default,,0,0,0,,(гитара дыбысы)
Dialogue: 0,0:00:28.52,0:00:31.03,Default,,0,0,0,,B. (гитара дыбысы)
Dialogue: 0,0:00:31.03,0:00:33.03,Default,,0,0,0,,B7. (гитара дыбысы)
Dialogue: 0,0:00:33.03,0:00:36.03,Default,,0,0,0,,Е. (гитара дыбысы)
Dialogue: 0,0:00:36.03,0:00:38.20,Default,,0,0,0,,F Шах… Уф…. (гитара дыбысы)
Dialogue: 0,0:00:38.20,0:00:40.20,Default,,0,0,0,,Ау!
Dialogue: 0,0:00:40.20,0:00:42.54,Default,,0,0,0,,Шынымен ісіп кеткен жоқ па?
Dialogue: 0,0:00:42.54,0:00:45.04,Default,,0,0,0,,А, мен осылай екеніне сенімдімін ...
Dialogue: 0,0:00:45.04,0:00:47.34,Default,,0,0,0,,А, сонда, сонда.
Dialogue: 0,0:00:50.55,0:00:56.05,Default,,0,0,0,,♬ (гитара)
Dialogue: 0,0:00:56.05,0:01:03.49,Default,,0,0,0,,♬～
Dialogue: 0,0:01:03.49,0:01:05.49,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:01:05.49,0:01:08.33,Default,,0,0,0,,Керемет! Мен оны ойнай бастадым.
Dialogue: 0,0:01:08.33,0:01:10.83,Default,,0,0,0,,Дұрыс! (Тацуки) Сіз соңына дейін ойнай аласыз ба?
Dialogue: 0,0:01:10.83,0:01:13.34,Default,,0,0,0,,Уф... бұл... басталады!
Dialogue: 0,0:01:13.34,0:01:15.84,Default,,0,0,0,,Күрсіну…. Хехе... Осылай➡
Dialogue: 0,0:01:15.84,0:01:17.84,Default,,0,0,0,,Сіз қандай әнді орындап жатырсыз?
Dialogue: 0,0:01:17.84,0:01:19.84,Default,,0,0,0,,Жақсы әндер болды.
Dialogue: 0,0:01:19.84,0:01:22.01,Default,,0,0,0,,``Касуга Кейдж'' жақсы. Хмм.
Dialogue: 0,0:01:22.01,0:01:24.35,Default,,0,0,0,,Менің ойымша, бұл тәжірибе үшін жақсы, бірақ...
Dialogue: 0,0:01:24.35,0:01:26.35,Default,,0,0,0,,«Тәжірибе үшін» нені білдіреді?
Dialogue: 0,0:01:26.35,0:01:28.35,Default,,0,0,0,,Э~?
Dialogue: 0,0:01:28.35,0:01:30.69,Default,,0,0,0,,О? (Айне/Сойо) Ах.
Dialogue: 0,0:01:30.69,0:01:35.52,Default,,0,0,0,,Бұл... әннің мәтіні ме? (Жарық) Иә.
Dialogue: 0,0:01:35.52,0:01:38.03,Default,,0,0,0,,Мүмкін жаңа ән шығар! ? Иә.
Dialogue: 0,0:01:38.03,0:01:40.86,Default,,0,0,0,,Айне Чанның өтініші бойынша. иә?
Dialogue: 0,0:01:40.86,0:01:45.70,Default,,0,0,0,,Әй, сен оны маған жаздың ба? Солай ма?
Dialogue: 0,0:01:45.70,0:01:48.54,Default,,0,0,0,,Маған көрсет, маған көрсет~. Эй, неге! ?
Dialogue: 0,0:01:48.54,0:01:52.54,Default,,0,0,0,,Алғашқы тікелей шоуыңыз үшін өте қолайлы. Маған көрсет~
Dialogue: 0,0:01:52.54,0:01:55.71,Default,,0,0,0,,Мен оны сұрадым, сондықтан оны көруге құқығыңыз бар! ?
Dialogue: 0,0:01:55.71,0:01:58.71,Default,,0,0,0,,Я... Эй, Тацуки-чан➡
Dialogue: 0,0:01:58.71,0:02:03.92,Default,,0,0,0,,Бұл Ту Чан жазған жаңа әніміз, солай ма?
Dialogue: 0,0:02:05.82,0:02:08.16,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:02:08.16,0:02:10.33,Default,,0,0,0,,Мен ән жазамын. (Айне/Ту) Иә?
Dialogue: 0,0:02:10.33,0:02:14.33,Default,,0,0,0,,Не? Е, Тацуки-чан, сен де музыка шығара аласың ба?
Dialogue: 0,0:02:14.33,0:02:18.17,Default,,0,0,0,,Мен оқитынмын, бірақ Ту оны маған жазды➡
Dialogue: 0,0:02:18.17,0:02:20.67,Default,,0,0,0,,Мен мұны істеймін.
Dialogue: 0,0:04:05.31,0:04:08.14,Default,,0,0,0,,Олай болса~ Тацуки және басқалармен➡
Dialogue: 0,0:04:08.14,0:04:11.05,Default,,0,0,0,,Мен RiNG тікелей шоуына қатысуды шештім.
Dialogue: 0,0:04:15.32,0:04:17.32,Default,,0,0,0,,Бұл аяқталғаннан кейін➡
Dialogue: 0,0:04:17.32,0:04:20.32,Default,,0,0,0,,Біздің топқа Муцу-чанды да шақырайық.
Dialogue: 0,0:04:23.49,0:04:27.16,Default,,0,0,0,,Мен бүгін үйге қайтып келе жатқанда Шо-чанмен сөйлесуді ойладым➡
Dialogue: 0,0:04:27.16,0:04:29.66,Default,,0,0,0,,Муцу-чанмен барғың келе ме?
Dialogue: 0,0:04:32.33,0:04:34.84,Default,,0,0,0,,Мен бармаймын... Неге?
Dialogue: 0,0:04:34.84,0:04:38.54,Default,,0,0,0,,Бүгін фортепиано күні болды деп ойламаймын.
Dialogue: 0,0:04:42.18,0:04:44.18,Default,,0,0,0,,Мен бармаймын...
Dialogue: 0,0:04:47.18,0:04:49.85,Default,,0,0,0,,♬ (құлаққаптан музыка ағып жатыр)
Dialogue: 0,0:04:49.85,0:04:58.36,Default,,0,0,0,,♬～
Dialogue: 0,0:04:58.36,0:05:00.30,Default,,0,0,0,,Күрсіну…. ♬～
Dialogue: 0,0:05:00.30,0:05:02.30,Default,,0,0,0,,(Музыканы тоқтататын дыбыс)
Dialogue: 0,0:05:04.47,0:05:10.97,Default,,0,0,0,,♬～
Dialogue: 0,0:05:10.97,0:05:13.81,Default,,0,0,0,,(пернетақтадан енгізілген дыбыс)
Dialogue: 0,0:05:15.81,0:05:33.83,Default,,0,0,0,,♬～
Dialogue: 0,0:05:33.83,0:05:36.67,Default,,0,0,0,,Таңғышты салғанда қолым ауырады➡
Dialogue: 0,0:05:36.67,0:05:38.67,Default,,0,0,0,,Гитарада ойнағанда тайып кеттім.
Dialogue: 0,0:05:38.67,0:05:41.84,Default,,0,0,0,,Маған саусақтардың икемділігі жаттығуларын үйретті➡
Dialogue: 0,0:05:41.84,0:05:44.51,Default,,0,0,0,,Мұны істеу саусақтарыңызды күшейтетін сияқты~➡
Dialogue: 0,0:05:44.51,0:05:47.84,Default,,0,0,0,,Тек орындаңыз, мен оны байқап көремін деп ойлаймын.
Dialogue: 0,0:05:47.84,0:05:50.35,Default,,0,0,0,,Ах! Сойо мырза? Ах...
Dialogue: 0,0:05:53.52,0:05:55.52,Default,,0,0,0,,Өйткені менің жақын жерде істейтін жұмысым бар еді.
Dialogue: 0,0:05:55.52,0:05:58.02,Default,,0,0,0,,Сіз мені көп күттіңіз~! ? Жаттығуға барайық!
Dialogue: 0,0:05:58.02,0:06:02.12,Default,,0,0,0,,Ах, Сойо-сан ұсынған хош иіс шынымен босаңсыды.
Dialogue: 0,0:06:02.12,0:06:04.29,Default,,0,0,0,,Құдайға шүкір.
Dialogue: 0,0:06:04.29,0:06:07.30,Default,,0,0,0,,♬ (гитара)
Dialogue: 0,0:06:07.30,0:06:10.60,Default,,0,0,0,,Жақсы көрінеді~ Сен жақсысың. (есіктің ашылған дыбысы)
Dialogue: 0,0:06:13.30,0:06:15.30,Default,,0,0,0,,Иә? Тацуки-чан➡
Dialogue: 0,0:06:15.30,0:06:17.31,Default,,0,0,0,,Сен киіміңді ауыстырдың ба? (Тацуки) Мен әлсіреп қалдым.
Dialogue: 0,0:06:17.31,0:06:19.64,Default,,0,0,0,,Иә! ? мектеп! ? Ол ақаулы.
Dialogue: 0,0:06:19.64,0:06:21.81,Default,,0,0,0,,Мен өлең шығардым.
Dialogue: 0,0:06:21.81,0:06:23.81,Default,,0,0,0,,Қазірдің өзінде? Шынымен бе?
Dialogue: 0,0:06:23.81,0:06:25.81,Default,,0,0,0,,Тацуки-чан керемет!
Dialogue: 0,0:06:25.81,0:06:27.98,Default,,0,0,0,,Шынайы ма? жақсы? Иә.
Dialogue: 0,0:06:27.98,0:06:29.99,Default,,0,0,0,,Асығыңыз, асығыңыз!
Dialogue: 0,0:06:29.99,0:06:43.16,Default,,0,0,0,,♬～
Dialogue: 0,0:06:43.16,0:06:45.83,Default,,0,0,0,,Бұл өте жақсы. Уау... (қол шапалақтау)
Dialogue: 0,0:06:45.83,0:06:47.84,Default,,0,0,0,,Бұл шын мәнінде ән.
Dialogue: 0,0:06:47.84,0:06:50.14,Default,,0,0,0,,Жарық туралы не айтасыз?
Dialogue: 0,0:06:52.67,0:06:55.34,Default,,0,0,0,,Жылы.
Dialogue: 0,0:06:55.34,0:06:58.51,Default,,0,0,0,,Бұл жақсы дегенді білдіре ме?
Dialogue: 0,0:06:58.51,0:07:01.62,Default,,0,0,0,,Иә. қолымнан келгеннің бәрін жаса!
Dialogue: 0,0:07:01.62,0:07:04.12,Default,,0,0,0,,Ах...! Мен түсінемін.
Dialogue: 0,0:07:04.12,0:07:08.29,Default,,0,0,0,,Ым, бәлкім, сәл баяулау керек шығар.
Dialogue: 0,0:07:08.29,0:07:10.79,Default,,0,0,0,,Жоқ, өйткені сіз жүгіру сезімін жоғалтасыз.
Dialogue: 0,0:07:10.79,0:07:13.63,Default,,0,0,0,,Уф... (Тацуки) Ал, мен саған нота жіберемін.
Dialogue: 0,0:07:13.63,0:07:17.13,Default,,0,0,0,,♬
Dialogue: 0,0:07:17.13,0:07:19.13,Default,,0,0,0,,Не? Мен ештеңе жазған жоқпын ба?
Dialogue: 0,0:07:19.13,0:07:21.80,Default,,0,0,0,,Код жазылған, солай ма? Тек дыбысты тыңдаңыз.
Dialogue: 0,0:07:21.80,0:07:23.81,Default,,0,0,0,,Ха! ? Саусақтарыңызды төмен түсіретін ештеңе жоқ! ?
Dialogue: 0,0:07:23.81,0:07:25.81,Default,,0,0,0,,Табуляцияны айтасыз ба?
Dialogue: 0,0:07:25.81,0:07:28.48,Default,,0,0,0,,Тацуки-чан, әкеңмен компьютерде сөйлесе аласың ба?
Dialogue: 0,0:07:28.48,0:07:30.48,Default,,0,0,0,,Мүмкін емес. Эх! ?
Dialogue: 0,0:07:30.48,0:07:33.15,Default,,0,0,0,,Онсыз мүмкін емес! (есіктің ашылған дыбысы)
Dialogue: 0,0:07:33.15,0:07:35.15,Default,,0,0,0,,болды.
Dialogue: 0,0:07:35.15,0:07:37.15,Default,,0,0,0,,Ах! Қаңғыбас мысық!
Dialogue: 0,0:07:40.49,0:07:42.82,Default,,0,0,0,,Ал...
Dialogue: 0,0:07:42.82,0:07:45.33,Default,,0,0,0,,Топта ойнау. Менде сенің үлесің жоқ.
Dialogue: 0,0:07:45.33,0:07:47.33,Default,,0,0,0,,Жақсы. істеу.
Dialogue: 0,0:07:47.33,0:07:51.63,Default,,0,0,0,,♬～
Dialogue: 0,0:07:55.50,0:08:00.44,Default,,0,0,0,,♬ (гитара)
Dialogue: 0,0:08:00.44,0:08:16.79,Default,,0,0,0,,♬～
Dialogue: 0,0:08:16.79,0:08:19.46,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:08:19.46,0:08:22.80,Default,,0,0,0,,♬ (гитара)
Dialogue: 0,0:08:22.80,0:08:25.47,Default,,0,0,0,,Ағымдағыны қосып, оны қайта жасаңыз. (Айне/Сойо) Иә?
Dialogue: 0,0:08:25.47,0:08:27.97,Default,,0,0,0,,Қаңғыбас мысықтар күнде келеді. (Айне/Сойо) Иә~?
Dialogue: 0,0:08:27.97,0:08:31.31,Default,,0,0,0,,♬ (гитара)
Dialogue: 0,0:08:31.31,0:08:35.14,Default,,0,0,0,,Айдың соңына дейін күнде бір уақытта ала аласыз ба?
Dialogue: 0,0:08:35.14,0:08:37.81,Default,,0,0,0,,Иә. Студенттік жеңілдік және ертерек қабылдауға жеңілдік➡
Dialogue: 0,0:08:37.81,0:08:39.98,Default,,0,0,0,,Қызметкерлерді тағайындау.
Dialogue: 0,0:08:39.98,0:08:42.78,Default,,0,0,0,,Рахмет. Сіз қолыңыздан келгеннің бәрін істеп жатырсыз.
Dialogue: 0,0:08:44.82,0:08:47.66,Default,,0,0,0,,Мен күн сайын брондау жасадым.
Dialogue: 0,0:08:47.66,0:08:50.66,Default,,0,0,0,,Джи~ Сіз қолыңыздан келгеннің бәрін жасайсыз ба?
Dialogue: 0,0:08:53.83,0:08:56.16,Default,,0,0,0,,Жарық.
Dialogue: 0,0:08:56.16,0:08:58.50,Default,,0,0,0,,Шие бар.
Dialogue: 0,0:08:58.50,0:09:00.77,Default,,0,0,0,,Жарық?
Dialogue: 0,0:09:00.77,0:09:06.61,Default,,0,0,0,,♬ "Сіз жеткілікті түрде жұмыс істеп жатырсыз. Сіз қазірдің өзінде жеткілікті жақсысыз."
Dialogue: 0,0:09:06.61,0:09:09.94,Default,,0,0,0,,♬ «Мен шалынып құладым».
Dialogue: 0,0:09:09.94,0:09:13.78,Default,,0,0,0,,♬ «Мен орнымнан тұрып келдім».
Dialogue: 0,0:09:13.78,0:09:15.78,Default,,0,0,0,,[[]]Енді байқап көрейік.
Dialogue: 0,0:09:15.78,0:09:19.12,Default,,0,0,0,,[[]]6-шы жол төмен жоғары төмен жоғары. (гитара дыбысы)
Dialogue: 0,0:09:19.12,0:09:22.96,Default,,0,0,0,,[[]]5-ші жол төмен жоғары төмен жоғары. (гитара дыбысы)
Dialogue: 0,0:09:22.96,0:09:27.63,Default,,0,0,0,,[[]]4-ші жол төмен жоғары төмен жоғары. 3-ші ішек... (гитара дыбысы)
Dialogue: 0,0:09:27.63,0:09:38.14,Default,,0,0,0,,(пернетақтадан енгізілген дыбыс)
Dialogue: 0,0:09:40.14,0:09:42.48,Default,,0,0,0,,Жағалауда көрінетін жер бедерінің бұл түрлері ➡
Dialogue: 0,0:09:42.48,0:09:44.48,Default,,0,0,0,,Жағалау террасасы деп аталады.
Dialogue: 0,0:09:44.48,0:09:47.65,Default,,0,0,0,,Хоккайдодағы Хидака аймағы әйгілі жер➡
Dialogue: 0,0:09:47.65,0:09:50.49,Default,,0,0,0,,Солтүстік Санрику жағалауы Бұл Сикокудағы Мурото мүйісі.
Dialogue: 0,0:09:50.49,0:09:52.49,Default,,0,0,0,,Мұғалім.
Dialogue: 0,0:09:52.49,0:09:54.66,Default,,0,0,0,,Аа, Мисуми мырза. Бұл уақыт болды.
Dialogue: 0,0:09:54.66,0:09:58.16,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:09:58.16,0:10:00.16,Default,,0,0,0,,Сәттілік! Келіңіздер.
Dialogue: 0,0:10:00.16,0:10:02.36,Default,,0,0,0,,Рахмет. Ұрыс.
Dialogue: 0,0:10:04.33,0:10:08.04,Default,,0,0,0,,-де біз өзен террассаларынан айырмашылығын түсіндіреміз.
Dialogue: 0,0:10:10.51,0:10:13.01,Default,,0,0,0,,Ол неге келмейді?
Dialogue: 0,0:10:13.01,0:10:15.68,Default,,0,0,0,,Сіз бұл күнде болады дедіңіз.
Dialogue: 0,0:10:15.68,0:10:17.68,Default,,0,0,0,,Жаттығу жасаймыз ба?
Dialogue: 0,0:10:17.68,0:10:19.85,Default,,0,0,0,,Бүгін таңертең жіберген адам мұны жасайды, солай ма?
Dialogue: 0,0:10:19.85,0:10:22.02,Default,,0,0,0,,Орналастыруды қайта қарастырыңыз. Ха! ?
Dialogue: 0,0:10:22.02,0:10:24.02,Default,,0,0,0,,Сіз қалай жаттығу жасайсыз?
Dialogue: 0,0:10:27.36,0:10:29.66,Default,,0,0,0,,(басылған дыбыс)
Dialogue: 0,0:10:31.69,0:10:33.90,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:10:36.20,0:10:38.40,Default,,0,0,0,,((Шоко: Не болды?
Dialogue: 0,0:10:42.87,0:10:45.37,Default,,0,0,0,,А, міне...
Dialogue: 0,0:10:45.37,0:10:48.21,Default,,0,0,0,,Бұл туралы не деуге болады?
Dialogue: 0,0:10:48.21,0:10:50.21,Default,,0,0,0,,Ах... Аа...))
Dialogue: 0,0:10:59.39,0:11:04.89,Default,,0,0,0,,♬～
Dialogue: 0,0:11:07.66,0:11:11.33,Default,,0,0,0,,Сіз 10 минутқа кешігіп қалдыңыз! Асығыңыз, ашуланыңыз!
Dialogue: 0,0:11:11.33,0:11:14.50,Default,,0,0,0,,Күте тұрыңыз, Айн-чан.
Dialogue: 0,0:11:14.50,0:11:16.50,Default,,0,0,0,,Кешіріңіз! Кезекшілікте!
Dialogue: 0,0:11:16.50,0:11:18.84,Default,,0,0,0,,Келесің бе, келмейсің бе, айтшы.
Dialogue: 0,0:11:18.84,0:11:21.68,Default,,0,0,0,,Иә? иә? Мұнда.
Dialogue: 0,0:11:21.68,0:11:24.18,Default,,0,0,0,,Олай емес... Ммм➡
Dialogue: 0,0:11:24.18,0:11:29.52,Default,,0,0,0,,Келер алдында хабарлап жіберсеңіз, көмектесер ме деп ойлаймын.
Dialogue: 0,0:11:29.52,0:11:32.52,Default,,0,0,0,,Иә. иә? мен? Ах...
Dialogue: 0,0:11:35.02,0:11:37.86,Default,,0,0,0,,Мен сені топқа қостым, келіңдер.
Dialogue: 0,0:11:37.86,0:11:41.36,Default,,0,0,0,,Кешіктіру де жақсы емес.
Dialogue: 0,0:11:41.36,0:11:43.87,Default,,0,0,0,,Жарық Жаттығуды бастайық.
Dialogue: 0,0:11:43.87,0:11:46.37,Default,,0,0,0,,А... иә….
Dialogue: 0,0:11:49.87,0:11:52.04,Default,,0,0,0,,Мм... не?
Dialogue: 0,0:11:52.04,0:11:54.54,Default,,0,0,0,,Қай нота? Кеше.
Dialogue: 0,0:11:54.54,0:11:56.54,Default,,0,0,0,,Аа...
Dialogue: 0,0:11:58.71,0:12:00.65,Default,,0,0,0,,Ойнау мүмкін болғанша жеке жаттығыңыз.
Dialogue: 0,0:12:00.65,0:12:03.82,Default,,0,0,0,,Е. Бәріміз бірге жасайық.
Dialogue: 0,0:12:03.82,0:12:07.16,Default,,0,0,0,,(гитара дыбысы)
Dialogue: 0,0:12:07.16,0:12:10.33,Default,,0,0,0,,Неліктен жоқ?
Dialogue: 0,0:12:10.33,0:12:12.49,Default,,0,0,0,,Бұл.
Dialogue: 0,0:12:12.49,0:12:15.00,Default,,0,0,0,,Жарайсың ба? (гитара дыбысы)
Dialogue: 0,0:12:22.34,0:12:27.34,Default,,0,0,0,,♬
Dialogue: 0,0:12:27.34,0:12:31.65,Default,,0,0,0,,♬～
Dialogue: 0,0:12:34.02,0:12:36.02,Default,,0,0,0,,Қанағаттану. сәл.
Dialogue: 0,0:12:36.02,0:12:39.02,Default,,0,0,0,,Бұл әлі аяқталған жоқ. Ол әлі толық сәйкес келмейді.
Dialogue: 0,0:12:39.02,0:12:43.19,Default,,0,0,0,,Иә? Бұл дұрыс. Ах.
Dialogue: 0,0:12:43.19,0:12:45.53,Default,,0,0,0,,Ракун жақсы емес пе?
Dialogue: 0,0:12:45.53,0:12:47.70,Default,,0,0,0,,Мен ше? Сіз дұрыс жаттығу жасайсыз ба?
Dialogue: 0,0:12:47.70,0:12:49.70,Default,,0,0,0,,Не? Мен істеп жатырмын.
Dialogue: 0,0:12:49.70,0:12:54.04,Default,,0,0,0,,Мен бұрынғыдан да нашармын. Жарайды, мен бар күшімді салып жатырмын.
Dialogue: 0,0:12:54.04,0:12:56.70,Default,,0,0,0,,Бәрі жараспаса, бұл топ емес!
Dialogue: 0,0:12:56.70,0:12:58.87,Default,,0,0,0,,Әй... (Тацуки) Сен де жақсы емессің!
Dialogue: 0,0:12:58.87,0:13:00.81,Default,,0,0,0,,А, жақсы.
Dialogue: 0,0:13:00.81,0:13:03.98,Default,,0,0,0,,Басқаларға қарағанда екі есе көп жаттығу. (Айне) Мен мұны істеймін, бірақ...
Dialogue: 0,0:13:03.98,0:13:08.58,Default,,0,0,0,,А, мен қайтып келдім! Бұл шынымен мысыққа ұқсайды.
Dialogue: 0,0:13:11.49,0:13:17.99,Default,,0,0,0,,♬～
Dialogue: 0,0:13:17.99,0:13:21.00,Default,,0,0,0,,Мен жақсы жаттыға алмадым...
Dialogue: 0,0:13:21.00,0:13:23.33,Default,,0,0,0,,Қаңғыбас мысықтардан құтылайық...
Dialogue: 0,0:13:23.33,0:13:26.50,Default,,0,0,0,,Немесе...
Dialogue: 0,0:13:26.50,0:13:29.50,Default,,0,0,0,,Тікелей эфирге келетініңізге кепілдік жоқ...
Dialogue: 0,0:13:29.50,0:13:31.51,Default,,0,0,0,,Егер сіз ұпайды тағы да шатастырсаңыз➡
Dialogue: 0,0:13:31.51,0:13:34.34,Default,,0,0,0,,Әуесқойлар онымен күресе алмайды...
Dialogue: 0,0:13:34.34,0:13:38.35,Default,,0,0,0,,((Шоко: Мен Тоудың сөзіне сәйкес келетін ән жазамын.
Dialogue: 0,0:13:38.35,0:13:40.68,Default,,0,0,0,,Менен кез келген нәрсені сұрай аласыз.
Dialogue: 0,0:13:40.68,0:13:44.85,Default,,0,0,0,,Бұл ән жазған адам ретінде менің міндетім))
Dialogue: 0,0:13:44.85,0:13:47.19,Default,,0,0,0,,күрсіну.
Dialogue: 0,0:13:47.19,0:13:50.53,Default,,0,0,0,,Неге қазір...?
Dialogue: 0,0:14:01.14,0:14:03.14,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:14:03.14,0:14:05.31,Default,,0,0,0,,Бұл ел бітті ғой, иә?
Dialogue: 0,0:14:05.31,0:14:07.31,Default,,0,0,0,,Ол бүгін тағы келді!
Dialogue: 0,0:14:07.31,0:14:09.98,Default,,0,0,0,,Сойо қазір топта ойнайды.
Dialogue: 0,0:14:09.98,0:14:14.08,Default,,0,0,0,,Мені де шақырып жатыр... Сіз мені болжап отырсыз ба?
Dialogue: 0,0:14:16.32,0:14:18.65,Default,,0,0,0,,Күрсіну…. Одан аулақ болған сайын➡
Dialogue: 0,0:14:18.65,0:14:20.99,Default,,0,0,0,,Ол сені қуады деген сөз.
Dialogue: 0,0:14:20.99,0:14:23.79,Default,,0,0,0,,Мен қиналып жатырмын...
Dialogue: 0,0:14:26.83,0:14:30.16,Default,,0,0,0,,Ертегіні айтуымыз керек.
Dialogue: 0,0:14:30.16,0:14:32.83,Default,,0,0,0,,Сіз Цукиномириге келесіз бе?
Dialogue: 0,0:14:32.83,0:14:35.17,Default,,0,0,0,,Мен бара аламын...!
Dialogue: 0,0:14:35.17,0:14:37.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:39.17,0:14:42.08,Default,,0,0,0,,Концерт болатын күні кездесе аламыз деп ойлаймын.
Dialogue: 0,0:14:44.68,0:14:46.88,Default,,0,0,0,,Қашан?
Dialogue: 0,0:14:49.35,0:14:53.35,Default,,0,0,0,,Иә? Келмедің бе? Мен сене алар емеспін...
Dialogue: 0,0:14:53.35,0:14:56.36,Default,,0,0,0,,Мүмкін мен бұрынғыдай кешігіп қалған шығармын?
Dialogue: 0,0:14:58.36,0:15:00.29,Default,,0,0,0,,♬ (гитара)
Dialogue: 0,0:15:00.29,0:15:03.13,Default,,0,0,0,,Онда! басқа!
Dialogue: 0,0:15:03.13,0:15:05.47,Default,,0,0,0,,Айқайламаңыз.
Dialogue: 0,0:15:05.47,0:15:07.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:09.64,0:15:12.31,Default,,0,0,0,,Келген сайын өзгертіңіз!
Dialogue: 0,0:15:12.31,0:15:14.64,Default,,0,0,0,,Мен тырыссам да, олар мені елемейді немесе сәтсіздікке ұшырайды!
Dialogue: 0,0:15:14.64,0:15:16.81,Default,,0,0,0,,Адамдар туралы көбірек ойланыңыз!
Dialogue: 0,0:15:16.81,0:15:21.15,Default,,0,0,0,,Тіпті осында...! Екеуің тынышталыңдар.
Dialogue: 0,0:15:21.15,0:15:24.82,Default,,0,0,0,,Тацуки-чан, сен бар күшіңді салып жатырсың.
Dialogue: 0,0:15:24.82,0:15:27.32,Default,,0,0,0,,Бұлай жасамаңыз.
Dialogue: 0,0:15:27.32,0:15:30.49,Default,,0,0,0,,Кешіріңіз, мен оны Тацуки-чанға қалдырдым...
Dialogue: 0,0:15:30.49,0:15:34.16,Default,,0,0,0,,Мм... мен де... мен де...!
Dialogue: 0,0:15:34.16,0:15:36.33,Default,,0,0,0,,Мен сізге көмектесе аламын ба?
Dialogue: 0,0:15:36.33,0:15:38.53,Default,,0,0,0,,Егер бәріміз мұны жасасақ, біз мұны істей аламыз, солай ма?
Dialogue: 0,0:15:41.84,0:15:46.34,Default,,0,0,0,,Бұл маған сенуге болмайды дегенді білдіре ме? иә?
Dialogue: 0,0:15:46.34,0:15:48.34,Default,,0,0,0,,Мен бұлай айтқан жоқпын.
Dialogue: 0,0:15:48.34,0:15:50.55,Default,,0,0,0,,Мен мұны Шоко сияқты істей алмаймын!
Dialogue: 0,0:15:53.51,0:15:55.62,Default,,0,0,0,,Тацуки-чан….
Dialogue: 0,0:16:01.62,0:16:04.83,Default,,0,0,0,,Тацуки-чан, өзіңді итеріп жіберген шығарсың...
Dialogue: 0,0:16:08.13,0:16:10.13,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:16:10.13,0:16:12.33,Default,,0,0,0,,Барлығынсыз...
Dialogue: 0,0:16:14.64,0:16:16.84,Default,,0,0,0,,(жүгіру дыбысы)
Dialogue: 0,0:16:19.31,0:16:23.48,Default,,0,0,0,,)) Келесіде Кишиможин-мэ Кишиможин-мэ.
Dialogue: 0,0:16:23.48,0:16:26.65,Default,,0,0,0,,)) Читосебаши білім беру залының алдында.
Dialogue: 0,0:16:26.65,0:16:31.49,Default,,0,0,0,,(Темір жол өткелінің дабыл дыбысы)
Dialogue: 0,0:16:31.49,0:16:33.49,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:16:54.34,0:16:56.84,Default,,0,0,0,,Менің әпкем мен Шоко дайын➡
Dialogue: 0,0:16:56.84,0:17:00.45,Default,,0,0,0,,Мен неге...?
Dialogue: 0,0:17:00.45,0:17:06.29,Default,,0,0,0,,☎ (Қоңырау үні)
Dialogue: 0,0:17:06.29,0:17:08.62,Default,,0,0,0,,Жоқ. Олар шықпайды.
Dialogue: 0,0:17:08.62,0:17:12.13,Default,,0,0,0,,Әдеттегідей қаңғыбас мысықтар келмейді.
Dialogue: 0,0:17:12.13,0:17:15.83,Default,,0,0,0,,Кеше бүгін келу қиын...
Dialogue: 0,0:17:18.30,0:17:21.14,Default,,0,0,0,,Ммм... Мен дұрыс түсіндім➡
Dialogue: 0,0:17:21.14,0:17:24.64,Default,,0,0,0,,Оған көп нәрсе қалдырғаным рас...
Dialogue: 0,0:17:31.81,0:17:35.32,Default,,0,0,0,,Иә. Өйткені, бәрі болмаса, жақсылық болмас еді.
Dialogue: 0,0:17:35.32,0:17:37.32,Default,,0,0,0,,Мен сені іздеймін!
Dialogue: 0,0:17:37.32,0:17:39.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:42.82,0:17:44.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:48.83,0:17:54.50,Default,,0,0,0,,☎
Dialogue: 0,0:17:54.50,0:17:57.00,Default,,0,0,0,,Band Баруым керек пе?
Dialogue: 0,0:18:02.11,0:18:05.78,Default,,0,0,0,,Мен көремін. Көңіл-күйім түскенде үнсіз жүргенім жақсы.
Dialogue: 0,0:18:05.78,0:18:09.95,Default,,0,0,0,,Ал, мен үйге бара жатырмын, өйткені менің тобым бар.
Dialogue: 0,0:18:09.95,0:18:12.79,Default,,0,0,0,,Топ туралы көңілім түсіп тұрса да➡
Dialogue: 0,0:18:12.79,0:18:14.96,Default,,0,0,0,,Жақсы айтылған...
Dialogue: 0,0:18:14.96,0:18:20.13,Default,,0,0,0,,Мен өз топтарының қамын ойлайтын адамдарды аздап қызғанамын.
Dialogue: 0,0:18:20.13,0:18:22.13,Default,,0,0,0,,Сонымен.
Dialogue: 0,0:18:24.80,0:18:27.30,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:18:49.82,0:18:51.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:51.99,0:18:54.10,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:19:11.78,0:19:13.78,Default,,0,0,0,,⚟Бірақ кеш!
Dialogue: 0,0:19:15.78,0:19:20.29,Default,,0,0,0,,Мен 2 сағат, 56 минут және 31 секунд күттім. Тачи-чан.
Dialogue: 0,0:19:20.29,0:19:22.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:22.46,0:19:24.79,Default,,0,0,0,,Ол қашып кетті! Ах! Айн-чан!
Dialogue: 0,0:19:24.79,0:19:32.13,Default,,0,0,0,,♬～
Dialogue: 0,0:19:32.13,0:19:34.30,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:19:34.30,0:19:36.80,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:19:36.80,0:19:38.81,Default,,0,0,0,,Ах... Айне-чан!
Dialogue: 0,0:19:38.81,0:19:41.48,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:19:41.48,0:19:48.32,Default,,0,0,0,,♬～
Dialogue: 0,0:19:48.32,0:19:50.32,Default,,0,0,0,,Аяқ киім….
Dialogue: 0,0:19:50.32,0:19:54.32,Default,,0,0,0,,Ха ха ха ха….
Dialogue: 0,0:19:54.32,0:19:56.32,Default,,0,0,0,,Не істеуім керек...
Dialogue: 0,0:19:56.32,0:19:58.49,Default,,0,0,0,,Қашпа!
Dialogue: 0,0:19:58.49,0:20:00.10,Default,,0,0,0,,Қашпаймын! Өйткені сен менің артымнан келе жатырсың!
Dialogue: 0,0:20:00.10,0:20:03.83,Default,,0,0,0,,Олай болса тоқта! Неге олай дейсің?
Dialogue: 0,0:20:03.83,0:20:06.50,Default,,0,0,0,,Дәлірек айтқанда, шекара бұзу! Сенімен бәрі жақсы ма!
Dialogue: 0,0:20:06.50,0:20:09.50,Default,,0,0,0,,Бұл дұрыс емес! Ол анықталса да, бұл рефлексия хаты!
Dialogue: 0,0:20:09.50,0:20:12.51,Default,,0,0,0,,Уау...Мен жазуға шебермін.
Dialogue: 0,0:20:12.51,0:20:14.68,Default,,0,0,0,,Білсе де, жақсы болды! ?
Dialogue: 0,0:20:14.68,0:20:17.18,Default,,0,0,0,,Шулы, бұл ең соңғы шара!
Dialogue: 0,0:20:17.18,0:20:20.18,Default,,0,0,0,,Тоқтасаң бәрі шешіледі!
Dialogue: 0,0:20:20.18,0:20:23.35,Default,,0,0,0,,Кім тоқтайды! Олай болса, мен сені қуалай беремін.
Dialogue: 0,0:20:23.35,0:20:25.35,Default,,0,0,0,,Қатты тітіркендіргіш.
Dialogue: 0,0:20:32.69,0:20:35.20,Default,,0,0,0,,Хахаха….
Dialogue: 0,0:20:35.20,0:20:37.36,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:20:37.36,0:20:40.70,Default,,0,0,0,,Вату! Абуна Сәлем!
Dialogue: 0,0:20:40.70,0:20:42.70,Default,,0,0,0,,Уау. Тома….
Dialogue: 0,0:20:42.70,0:20:44.71,Default,,0,0,0,,Тааа~. Апыр-ай!
Dialogue: 0,0:20:44.71,0:20:46.87,Default,,0,0,0,,Уф... мінеки! сен!
Dialogue: 0,0:20:46.87,0:20:48.88,Default,,0,0,0,,Уау, қан! иә?
Dialogue: 0,0:20:48.88,0:20:51.55,Default,,0,0,0,,Бұл теңіз жануарлары сериясының 6-шы бөлімі.
Dialogue: 0,0:20:51.55,0:20:55.72,Default,,0,0,0,,Манта сәулесі Күн балығы Ескек балық Кит акуласы➡
Dialogue: 0,0:20:55.72,0:20:59.99,Default,,0,0,0,,Әй, бұл көк кит пен аққұба кит!
Dialogue: 0,0:20:59.99,0:21:01.99,Default,,0,0,0,,Аа... Фуфуфу….
Dialogue: 0,0:21:01.99,0:21:04.66,Default,,0,0,0,,Ахахаха! Хахахахаха! иә? Неге күлесің?
Dialogue: 0,0:21:04.66,0:21:08.00,Default,,0,0,0,,Ахахах... Айтайын дегенім, өте сүйкімді.
Dialogue: 0,0:21:08.00,0:21:10.00,Default,,0,0,0,,Шамдар сүйкімді.
Dialogue: 0,0:21:12.33,0:21:15.14,Default,,0,0,0,,Ертең тікелей эфир бар. Сіз не істемексіз?
Dialogue: 0,0:21:17.17,0:21:19.51,Default,,0,0,0,,Енді қаша алмайсың.
Dialogue: 0,0:21:19.51,0:21:23.01,Default,,0,0,0,,Рахмет.
Dialogue: 0,0:21:23.01,0:21:25.01,Default,,0,0,0,,Аа...
Dialogue: 0,0:21:25.01,0:21:28.18,Default,,0,0,0,,Мен үшін? Мен үшін? шулы.
Dialogue: 0,0:21:28.18,0:21:31.35,Default,,0,0,0,,Иә? Басқа айтар сөзің бар ма?
Dialogue: 0,0:21:31.35,0:21:33.35,Default,,0,0,0,,Не? (Айна) Рахмет➡
Dialogue: 0,0:21:33.35,0:21:35.36,Default,,0,0,0,,Рахмет! Рақмет сізге!
Dialogue: 0,0:21:35.36,0:21:37.36,Default,,0,0,0,,Неліктен? Сен не істеп жатырсың?
Dialogue: 0,0:21:37.36,0:21:39.36,Default,,0,0,0,,Иә? О, неге! ?
Dialogue: 0,0:21:39.36,0:21:41.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:41.53,0:21:44.20,Default,,0,0,0,,Мен мысықпен ойнадым. (Мысық мияулайды)
Dialogue: 0,0:21:44.20,0:21:47.70,Default,,0,0,0,,Ұзын мысық! Сен менің орта мектебімсің! ?
Dialogue: 0,0:21:47.70,0:21:50.70,Default,,0,0,0,,3-сынып. (Мысық мияулайды)
Dialogue: 0,0:21:52.20,0:21:58.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
