Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:56.80,0:00:59.76,Default,,0,0,0,,Бүгін Фуюки қаласы апатының 10 жылдығы.
Dialogue: 0,0:00:59.93,0:01:03.14,Default,,0,0,0,,Фуюки орталық саябағында еске алу кеші өтті.
Dialogue: 0,0:01:05.27,0:01:09.77,Default,,0,0,0,,500-ден астам құрбан болған және себебі әлі белгісіз ірі апат.
Dialogue: 0,0:01:10.19,0:01:13.61,Default,,0,0,0,,Апат әлі де зардап шеккен аймақтарда үлкен із қалдыруда.
Dialogue: 0,0:01:13.99,0:01:16.40,Default,,0,0,0,,Қатысқан 400 қайғылы отбасы мен апат құрбандары...
Dialogue: 0,0:01:16.57,0:01:19.53,Default,,0,0,0,,Апат туралы мемориал алдында гүл шоқтарын ұсыну және үнсіздік сәті.
Dialogue: 0,0:01:19.70,0:01:21.33,Default,,0,0,0,,Біз қайта құруға тағы да ант бердік.
Dialogue: 0,0:01:21.49,0:01:22.45,Default,,0,0,0,,Фуга!
Dialogue: 0,0:01:22.62,0:01:24.79,Default,,0,0,0,,Фуюки қаласындағы жаңалықтарды жалғастыру.
Dialogue: 0,0:01:25.00,0:01:29.00,Default,,0,0,0,,Үздіксіз газдың ағуынан болатын апаттар осы айдың 20-сынан бастап жиі орын алуда.
Dialogue: 0,0:01:29.38,0:01:32.88,Default,,0,0,0,,Мен енді тамақ жей алмаймын~ Хм
Dialogue: 0,0:01:34.42,0:01:36.47,Default,,0,0,0,,Сәл кеш
Dialogue: 0,0:01:40.05,0:01:42.47,Default,,0,0,0,,Мен кешірім сұраймын.
Dialogue: 0,0:01:44.52,0:01:47.64,Default,,0,0,0,,Мен оны сізге жіберемін. Соңғы уақытта көп қиындық болды.
Dialogue: 0,0:01:49.27,0:01:53.65,Default,,0,0,0,,Есікті құлыптауда абай болу керек.
Dialogue: 0,0:01:53.78,0:01:55.44,Default,,0,0,0,,Кирицугу-чан
Dialogue: 0,0:01:56.44,0:01:58.15,Default,,0,0,0,,(Широу мен Сакураның күлкісі)
Dialogue: 0,0:02:00.03,0:02:01.49,Default,,0,0,0,,Кешіріңіз, Сенпай.
Dialogue: 0,0:02:01.70,0:02:03.91,Default,,0,0,0,,А, жоқ, кешірім сұрайтын менмін.
Dialogue: 0,0:02:04.45,0:02:06.87,Default,,0,0,0,,Бүгін кешке үйді аралауға көмектесейін.
Dialogue: 0,0:02:07.33,0:02:08.83,Default,,0,0,0,,Бірлесіп әрекет етіп жатыр ма?
Dialogue: 0,0:02:09.00,0:02:12.17,Default,,0,0,0,,Көп адамдармен бірге тамақ ішу қызық.
Dialogue: 0,0:02:16.88,0:02:17.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:17.76,0:02:19.18,Default,,0,0,0,,Сенпай, бұл көш...
Dialogue: 0,0:02:19.47,0:02:20.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:21.26,0:02:23.56,Default,,0,0,0,,Мен оны қоқыспен айналысып жатқанда кесіп алдым деп ойлаймын...
Dialogue: 0,0:02:24.35,0:02:25.60,Default,,0,0,0,,айт
Dialogue: 0,0:02:25.89,0:02:27.85,Default,,0,0,0,,Сенің денең менімен бірге
Dialogue: 0,0:02:28.31,0:02:30.52,Default,,0,0,0,,Менің тағдырым сенің қылышыңда
Dialogue: 0,0:02:31.31,0:02:33.36,Default,,0,0,0,,Қасиетті Граил жағына сәйкес -
Dialogue: 0,0:02:33.52,0:02:36.73,Default,,0,0,0,,Осы мағынаны, осы қағиданы ұстансаң, жауап бер.
Dialogue: 0,0:02:37.61,0:02:39.07,Default,,0,0,0,,Осы жерде кепіл
Dialogue: 0,0:02:39.53,0:02:42.20,Default,,0,0,0,,Мәңгілік ізгі менмін.
Dialogue: 0,0:02:42.74,0:02:45.83,Default,,0,0,0,,Мәңгілік дүниеде бар зұлымдықты қоятын менмін.
Dialogue: 0,0:02:46.04,0:02:50.42,Default,,0,0,0,,Тоқтау шеңберінен кел, Үш ұлы сөзді киіп алдың.
Dialogue: 0,0:02:57.17,0:02:59.55,Default,,0,0,0,,Таразы сақшысы!
Dialogue: 0,0:03:01.93,0:03:03.97,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:03:11.94,0:03:12.73,Default,,0,0,0,,Босап шыққан адам –…
Dialogue: 0,0:03:16.77,0:03:18.74,Default,,0,0,0,,Қасиетті Граил соғысы
Dialogue: 0,0:03:19.36,0:03:23.87,Default,,0,0,0,,Оны ұстағандардың тілегін орындайтын құдіретті тілек машинасы.
Dialogue: 0,0:03:24.03,0:03:27.08,Default,,0,0,0,,Жеті шебер Қасиетті Граиль үшін шайқасады...
Dialogue: 0,0:03:27.24,0:03:31.37,Default,,0,0,0,,Жеті қызметші арасындағы шайқас
Dialogue: 0,0:03:32.58,0:03:33.88,Default,,0,0,0,,Қасиетті Граил -
Dialogue: 0,0:03:34.04,0:03:37.30,Default,,0,0,0,,Өзіңе ие болуға лайықты адамды таңдаңыз.
Dialogue: 0,0:03:37.46,0:03:39.71,Default,,0,0,0,,Бір-біріңмен жарысып, өлтіріңдер.
Dialogue: 0,0:03:39.88,0:03:43.05,Default,,0,0,0,,Тек бір иесін таңдаңыз
Dialogue: 0,0:03:43.59,0:03:45.22,Default,,0,0,0,,Қызметші дегеніміз не?
Dialogue: 0,0:03:45.39,0:03:49.93,Default,,0,0,0,,Қасиетті Граил тудырған аңызға айналған қаһарман
Dialogue: 0,0:03:50.93,0:03:55.44,Default,,0,0,0,,Олар негізінен рух ретінде қожайындарына жақын болады.
Dialogue: 0,0:03:55.94,0:03:59.19,Default,,0,0,0,,Қажет болса материалдандырыңыз.
Dialogue: 0,0:03:59.69,0:04:01.90,Default,,0,0,0,,Күресуге болады
Dialogue: 0,0:04:02.78,0:04:05.78,Default,,0,0,0,,Егер Қасиетті Граил осындай кереметті тудырса...
Dialogue: 0,0:04:05.95,0:04:10.12,Default,,0,0,0,,Иесіне шексіз билік беріңіз
Dialogue: 0,0:04:11.12,0:04:12.04,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:04:19.84,0:04:20.71,Default,,0,0,0,,850 жылы қайта пайда болған Колоссалды Титан қабырғаны бұзып өтті,
Dialogue: 0,0:04:21.05,0:04:22.80,Default,,0,0,0,,Мен әлі де адамдар қалғанына сене алар емеспін.
Dialogue: 0,0:04:33.98,0:04:34.73,Default,,0,0,0,,«және күн сайын күрсінемін.»
Dialogue: 0,0:04:34.89,0:04:35.60,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:37.48,0:04:39.02,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:05:06.72,0:05:07.47,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:07.68,0:05:08.76,Default,,0,0,0,,Ахх!
Dialogue: 0,0:05:10.43,0:05:12.68,Default,,0,0,0,,Ах! Уф! Қарғыс атқыр...
Dialogue: 0,0:05:39.58,0:05:40.59,Default,,0,0,0,,Хааах!
Dialogue: 0,0:05:42.88,0:05:44.59,Default,,0,0,0,,… …
Dialogue: 0,0:05:47.13,0:05:50.72,Default,,0,0,0,,Шақыру бойынша қызметші Сабер келді.
Dialogue: 0,0:05:56.89,0:05:57.94,Default,,0,0,0,,Сұраймыз
Dialogue: 0,0:06:00.94,0:06:03.07,Default,,0,0,0,,Сіз менің қожайынымсыз ба?
Dialogue: 0,0:06:37.81,0:06:39.31,Default,,0,0,0,,Ширу Эмия
Dialogue: 0,0:06:40.27,0:06:43.86,Default,,0,0,0,,Сіздің әлеміңіз қазірден бастап толығымен өзгереді.
Dialogue: 0,0:06:44.57,0:06:48.53,Default,,0,0,0,,Сіз өлтірген және өлтірілген адам болдыңыз.
Dialogue: 0,0:06:49.95,0:06:53.41,Default,,0,0,0,,Өйткені сіз шеберсіз
Dialogue: 0,0:06:54.74,0:06:56.16,Default,,0,0,0,,Мен күресемін
Dialogue: 0,0:06:56.79,0:06:58.00,Default,,0,0,0,,Осы сияқты-
Dialogue: 0,0:06:58.16,0:07:02.00,Default,,0,0,0,,Қасиетті Граил соғысы ақымақ қақтығысты тоқтатуға арналған.
Dialogue: 0,0:07:07.96,0:07:10.47,Default,,0,0,0,,Ой, қуан, балам.
Dialogue: 0,0:07:10.97,0:07:13.76,Default,,0,0,0,,Сіздің тілегіңіз ақыры орындалады
Dialogue: 0,0:07:15.26,0:07:16.81,Default,,0,0,0,,Жамау жоқ.
Dialogue: 0,0:07:17.35,0:07:20.81,Default,,0,0,0,,Сіздің күресіңіз адам ретінде өте орынды.
Dialogue: 0,0:07:24.90,0:07:26.19,Default,,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:07:26.48,0:07:30.19,Default,,0,0,0,,Сіз біздің шынымен жау екенімізді түсінесіз бе?
Dialogue: 0,0:07:30.36,0:07:31.40,Default,,0,0,0,,Жау?
Dialogue: 0,0:07:33.95,0:07:36.99,Default,,0,0,0,,Көрдің бе, мен сені Кирейдің шіркеуіне апардым...
Dialogue: 0,0:07:37.16,0:07:40.46,Default,,0,0,0,,Өйткені сен ештеңе білмедің және менің жауым болмадың.
Dialogue: 0,0:07:40.62,0:07:43.50,Default,,0,0,0,,Бірақ Эмия-кун да қазір шебер, солай ма?
Dialogue: 0,0:07:43.83,0:07:46.54,Default,,0,0,0,,Менің ойымша, бір ғана іс бар.
Dialogue: 0,0:07:46.71,0:07:47.92,Default,,0,0,0,,Тек сол жерде тұрып ұйықтап жат.
Dialogue: 0,0:07:48.42,0:07:49.71,Default,,0,0,0,,Қауіпке барма.
Dialogue: 0,0:07:50.09,0:07:53.13,Default,,0,0,0,,Сіз күресіп жатқан қарсыластың дайындығы маңызды емес, солай ма?
Dialogue: 0,0:07:53.30,0:07:55.39,Default,,0,0,0,,Айтпасаң да
Dialogue: 0,0:07:55.55,0:07:57.68,Default,,0,0,0,,Білсең, әрекет жаса
Dialogue: 0,0:07:57.85,0:08:00.93,Default,,0,0,0,,Сіз маған мейірімділік танытқыңыз келген жоқ деп ойлаймын, солай ма?
Dialogue: 0,0:08:01.10,0:08:02.73,Default,,0,0,0,,Бұл емес!
Dialogue: 0,0:08:05.02,0:08:06.02,Default,,0,0,0,,Тек...
Dialogue: 0,0:08:08.15,0:08:10.57,Default,,0,0,0,,Өзіңіз білмейтін адамға қарсы күресті бастау...
Dialogue: 0,0:08:10.74,0:08:12.03,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:08:12.20,0:08:14.03,Default,,0,0,0,,Хамф, бұл тағы да қиын.
Dialogue: 0,0:08:17.41,0:08:19.04,Default,,0,0,0,,Осы жерден бөлінейік
Dialogue: 0,0:08:19.37,0:08:23.50,Default,,0,0,0,,Ертеңнен бастап бір-бірімізге мейірімділік танытпаймыз, сондықтан дайын болыңдар.
Dialogue: 0,0:08:23.66,0:08:24.71,Default,,0,0,0,,О
Dialogue: 0,0:08:25.29,0:08:28.04,Default,,0,0,0,,Тохсака: Ол жақсы жігіт.
Dialogue: 0,0:08:28.67,0:08:30.00,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:08:30.51,0:08:32.59,Default,,0,0,0,,Маған жағымпаздансаң да, мен қиналмаймын.
Dialogue: 0,0:08:32.76,0:08:34.01,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:08:34.17,0:08:37.85,Default,,0,0,0,,Бірақ, мүмкін болса, жау болғым келмеді.
Dialogue: 0,0:08:38.85,0:08:41.35,Default,,0,0,0,,Мен де сен сияқты жігітпін.
Dialogue: 0,0:08:42.39,0:08:43.48,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:08:44.89,0:08:45.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:54.65,0:08:57.20,Default,,0,0,0,,Және...тек сақ болыңыз, солай ма?
Dialogue: 0,0:08:57.78,0:08:59.78,Default,,0,0,0,,Сабер қаншалықты жақсы болса да...
Dialogue: 0,0:08:59.95,0:09:02.50,Default,,0,0,0,,Жеңілсең, болды.
Dialogue: 0,0:09:02.66,0:09:03.79,Default,,0,0,0,,(Қыздың күлкісі)
Dialogue: 0,0:09:03.96,0:09:05.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:05.41,0:09:06.33,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:06.50,0:09:10.71,Default,,0,0,0,,(Қыздың күлкісі)
Dialogue: 0,0:09:13.92,0:09:15.13,Default,,0,0,0,,Ильясвиел?
Dialogue: 0,0:09:15.42,0:09:16.68,Default,,0,0,0,,Жабырқаушы ма?
Dialogue: 0,0:09:23.43,0:09:25.06,Default,,0,0,0,,Ширу, артқа тұр!
Dialogue: 0,0:09:29.44,0:09:31.52,Default,,0,0,0,,Жасай бер
Dialogue: 0,0:09:50.42,0:09:51.63,Default,,0,0,0,,Эй!
Dialogue: 0,0:10:01.76,0:10:03.26,Default,,0,0,0,,Ахх! (Широу) Сабер!
Dialogue: 0,0:10:16.49,0:10:19.11,Default,,0,0,0,,Көрінбейтін ... қылыш
Dialogue: 0,0:10:29.67,0:10:31.00,Default,,0,0,0,,Уа!
Dialogue: 0,0:10:33.42,0:10:35.71,Default,,0,0,0,,Ей! Ха! Апыр-ай!
Dialogue: 0,0:10:49.02,0:10:51.48,Default,,0,0,0,,(Берсеркердің ырылдауы)
Dialogue: 0,0:10:55.65,0:10:56.78,Default,,0,0,0,,Сабер!
Dialogue: 0,0:10:59.20,0:11:02.07,Default,,0,0,0,,Ха! Иә! Ха!
Dialogue: 0,0:11:04.03,0:11:05.95,Default,,0,0,0,,(Берсеркердің айқайы)
Dialogue: 0,0:11:17.88,0:11:19.26,Default,,0,0,0,,Хааааааааааа!
Dialogue: 0,0:11:29.48,0:11:30.64,Default,,0,0,0,,Ой... аа!
Dialogue: 0,0:11:30.81,0:11:32.52,Default,,0,0,0,,(Берсеркердің айқайы)
Dialogue: 0,0:11:33.90,0:11:35.31,Default,,0,0,0,,(Берсеркердің айқайы)
Dialogue: 0,0:11:35.90,0:11:37.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:56.13,0:11:56.96,Default,,0,0,0,,Сабер!
Dialogue: 0,0:11:57.13,0:11:58.88,Default,,0,0,0,,Идиот! Сіз өлтіресіз.
Dialogue: 0,0:11:59.17,0:12:01.09,Default,,0,0,0,,Саберді жалғыз қалдыра аласыз ба?
Dialogue: 0,0:12:04.97,0:12:05.97,Default,,0,0,0,,Ширу!
Dialogue: 0,0:12:07.01,0:12:08.10,Default,,0,0,0,,Садақшы?
Dialogue: 0,0:12:09.43,0:12:12.14,Default,,0,0,0,,Алыс тұр дегенің не?
Dialogue: 0,0:12:38.71,0:12:39.71,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:12:44.59,0:12:47.01,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:12:51.43,0:12:54.60,Default,,0,0,0,,(Берсеркердің ыңырануы)
Dialogue: 0,0:13:12.54,0:13:13.50,Default,,0,0,0,,Ширу
Dialogue: 0,0:13:17.33,0:13:18.17,Default,,0,0,0,,Шын жүректен осылай сезінемін
Dialogue: 0,0:13:18.33,0:13:20.00,Default,,0,0,0,,Садақшының қаруы
Dialogue: 0,0:13:20.63,0:13:21.42,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:13:24.22,0:13:28.18,Default,,0,0,0,,Ол мені Берсеркермен бірге нысанаға алды.
Dialogue: 0,0:13:31.81,0:13:34.93,Default,,0,0,0,,Сабер мен Тохсака қатысатынын білемін.
Dialogue: 0,0:13:39.69,0:13:42.53,Default,,0,0,0,,(Берсеркердің ырылдауы)
Dialogue: 0,0:13:44.44,0:13:46.57,Default,,0,0,0,,Мен оны қарап шықтым, Рин.
Dialogue: 0,0:13:46.90,0:13:49.53,Default,,0,0,0,,Бұлай етпе, садақшың.
Dialogue: 0,0:13:55.37,0:13:57.41,Default,,0,0,0,,Берсеркерге қайтайық
Dialogue: 0,0:14:02.34,0:14:03.38,Default,,0,0,0,,Қош бол
Dialogue: 0,0:14:03.55,0:14:06.51,Default,,0,0,0,,Қайта кездескенше, ағайын.
Dialogue: 0,0:14:09.18,0:14:11.72,Default,,0,0,0,,Ух... а... а
Dialogue: 0,0:14:14.06,0:14:15.22,Default,,0,0,0,,Ширу
Dialogue: 0,0:14:16.27,0:14:17.39,Default,,0,0,0,,Эмия-кун?
Dialogue: 0,0:14:37.58,0:14:40.25,Default,,0,0,0,,Сіз байсалдысыз ба? бітімгершілік келісімі дегеніміз не?
Dialogue: 0,0:14:40.75,0:14:44.17,Default,,0,0,0,,Берсеркер мен ойлағаннан да күшті жау.
Dialogue: 0,0:14:44.92,0:14:48.42,Default,,0,0,0,,Қазір Саберге және басқаларға қарсы болған адам...
Dialogue: 0,0:14:48.84,0:14:50.38,Default,,0,0,0,,Жақсы идея емес, солай ма?
Dialogue: 0,0:14:52.80,0:14:55.93,Default,,0,0,0,,Бұл жақсы идея емес, бұл кедергі.
Dialogue: 0,0:14:56.31,0:14:57.60,Default,,0,0,0,,Қайтадан ойланыңыз Рин
Dialogue: 0,0:14:58.14,0:15:01.06,Default,,0,0,0,,Шебердің саясатын ұстануға болмайды дейсіз бе?
Dialogue: 0,0:15:07.82,0:15:08.99,Default,,0,0,0,,(Садақшының күрсінуі)
Dialogue: 0,0:15:09.74,0:15:11.49,Default,,0,0,0,,Мойынсұнудан басқа амал жоқ
Dialogue: 0,0:15:11.86,0:15:14.16,Default,,0,0,0,,Менің қожайыным болғанша
Dialogue: 0,0:15:14.33,0:15:15.28,Default,,0,0,0,,Ол мойнын қорғап қалды
Dialogue: 0,0:15:16.62,0:15:21.12,Default,,0,0,0,,Мен сенің қандай батырлық рух екенін әлі естіген жоқпын.
Dialogue: 0,0:15:21.79,0:15:24.21,Default,,0,0,0,,Шын есім Есіңізде ме?
Dialogue: 0,0:15:25.09,0:15:26.84,Default,,0,0,0,,Қайдасың?
Dialogue: 0,0:15:30.76,0:15:32.80,Default,,0,0,0,,Есте сақтау қабілетінің жетіспеушілігі бар сияқты.
Dialogue: 0,0:15:34.80,0:15:36.31,Default,,0,0,0,,Түсінікті болу үшін, Рин
Dialogue: 0,0:15:37.47,0:15:40.35,Default,,0,0,0,,Бұл сіздің толық емес шақыруыңыздың құны.
Dialogue: 0,0:15:41.64,0:15:42.39,Default,,0,0,0,,Ешкімге… ешкімге…!!
Dialogue: 0,0:15:42.56,0:15:44.48,Default,,0,0,0,,Өте керемет! аздап!
Dialogue: 0,0:15:44.65,0:15:47.32,Default,,0,0,0,,Менің жүгімді алып жүруге көмектесіңізші!
Dialogue: 0,0:16:09.71,0:16:10.34,Default,,0,0,0,,Ах
Dialogue: 0,0:16:13.34,0:16:14.18,Default,,0,0,0,,Ауырды!
Dialogue: 0,0:16:19.10,0:16:20.35,Default,,0,0,0,,Арман...?
Dialogue: 0,0:16:22.98,0:16:24.69,Default,,0,0,0,,Тағы толтыра аламын ба?
Dialogue: 0,0:16:24.85,0:16:25.77,Default,,0,0,0,,Иә
Dialogue: 0,0:16:25.94,0:16:28.15,Default,,0,0,0,,Саберді ұнататын немесе ұнатпайтын нәрселер бар ма?
Dialogue: 0,0:16:28.32,0:16:31.03,Default,,0,0,0,,Иә, дәмі жақсы болғанша.
Dialogue: 0,0:16:31.19,0:16:32.82,Default,,0,0,0,,Мен бұған жаман емеспін
Dialogue: 0,0:16:33.07,0:16:35.66,Default,,0,0,0,,Мен осыншама толтыру арқылы салмақ қоса алмайтыныма сене алар емеспін...
Dialogue: 0,0:16:35.82,0:16:37.20,Default,,0,0,0,,Мен қызғанамын
Dialogue: 0,0:16:37.49,0:16:38.91,Default,,0,0,0,,Қайырлы таң!
Dialogue: 0,0:16:39.08,0:16:41.04,Default,,0,0,0,,Менің де қарным ашты!
Dialogue: 0,0:16:41.54,0:16:44.37,Default,,0,0,0,,(Мисо сорпасының шырылдаған дыбысы)
Dialogue: 0,0:16:49.80,0:16:52.26,Default,,0,0,0,,Уф... жоқ!
Dialogue: 0,0:16:53.30,0:16:58.22,Default,,0,0,0,,Сәлем! Біз қашаннан бері үлкен отбасы болдық?
Dialogue: 0,0:16:58.51,0:17:01.64,Default,,0,0,0,,Мен сенімді түсіндіруге үміттенемін! Ораора
Dialogue: 0,0:17:01.81,0:17:03.48,Default,,0,0,0,,Осы суретте олар мінсіз жұп сияқты көрінеді, иә?
Dialogue: 0,0:17:04.64,0:17:07.81,Default,,0,0,0,,Профессор Фуджимурамен тезірек кеңесуім керек еді.
Dialogue: 0,0:17:07.98,0:17:09.06,Default,,0,0,0,,«Бұл менің махаббатымның хикаясы—»
Dialogue: 0,0:17:10.06,0:17:12.61,Default,,0,0,0,,Менің үйім толық жөндеуден өтіп жатқанда...
Dialogue: 0,0:17:16.20,0:17:17.61,Default,,0,0,0,,Эй
Dialogue: 0,0:17:19.57,0:17:23.04,Default,,0,0,0,,Сол кезде күтпеген жерден шет елден ағайын келді?
Dialogue: 0,0:17:23.70,0:17:25.75,Default,,0,0,0,,Бұл қиын болған шығар, Тохсака мырза.
Dialogue: 0,0:17:25.91,0:17:29.92,Default,,0,0,0,,Мен сабақтан біраз уақыт үзіліс жасап, қонақүйде тұруды жоспарладым.
Dialogue: 0,0:17:30.42,0:17:33.59,Default,,0,0,0,,Мен Эмия-кунның мейіріміне еріп кеттім.
Dialogue: 0,0:17:34.67,0:17:36.59,Default,,0,0,0,,Мен сыныптас болсам да, мен...
Dialogue: 0,0:17:36.93,0:17:39.80,Default,,0,0,0,,Әй, жақсы, жақсы, бұл үй де...
Dialogue: 0,0:17:41.39,0:17:42.81,Default,,0,0,0,,Ширу да...
Dialogue: 0,0:17:43.27,0:17:45.18,Default,,0,0,0,,Оны қалауыңызша пайдаланыңыз
Dialogue: 0,0:17:45.85,0:17:47.60,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:47.77,0:17:49.52,Default,,0,0,0,,Қайта толтырыңыз! (Сабыр) Маған да беріңізші.
Dialogue: 0,0:17:49.69,0:17:50.90,Default,,0,0,0,,Иә
Dialogue: 0,0:17:52.61,0:17:55.15,Default,,0,0,0,,Сакура-чан, таңғы жаттығуға кешігіп келесің~
Dialogue: 0,0:17:55.32,0:17:56.45,Default,,0,0,0,,Асығыңыз~
Dialogue: 0,0:17:56.61,0:17:58.99,Default,,0,0,0,,Иә, кешіріңіз (Тайга) Мен тез кетемін.
Dialogue: 0,0:17:59.16,0:18:01.62,Default,,0,0,0,,Қара, қара, асығайық~ (Сакура) Иә.
Dialogue: 0,0:18:03.04,0:18:05.08,Default,,0,0,0,,Менің артымнан мектепке барғың келе ме?
Dialogue: 0,0:18:05.29,0:18:08.12,Default,,0,0,0,,Қызметші қожайынын қорғайды.
Dialogue: 0,0:18:08.46,0:18:10.63,Default,,0,0,0,,Мектепте адамдар көп.
Dialogue: 0,0:18:10.79,0:18:13.25,Default,,0,0,0,,Уайымдамаңыз, үйде күтіңіз.
Dialogue: 0,0:18:17.42,0:18:21.10,Default,,0,0,0,,Ұстаз солай десе, сенуден басқа амалым жоқ.
Dialogue: 0,0:18:21.97,0:18:24.47,Default,,0,0,0,,Бірақ маған уәде беріңізші.
Dialogue: 0,0:18:26.31,0:18:27.06,Default,,0,0,0,,Е...
Dialogue: 0,0:18:27.31,0:18:29.94,Default,,0,0,0,,Өзіңізді қауіп төніп тұрғандай сезінсеңіз, бізге міндетті түрде қоңырау шалыңыз.
Dialogue: 0,0:18:30.69,0:18:34.78,Default,,0,0,0,,Мен керек болсам, хабарлаймын.
Dialogue: 0,0:18:35.28,0:18:38.65,Default,,0,0,0,,Егер сіз оны уақытында орындамаймын деп шешсеңіз, пәрмен емлесін пайдаланыңыз.
Dialogue: 0,0:18:38.82,0:18:41.07,Default,,0,0,0,,А, мен уәде беремін.
Dialogue: 0,0:19:02.34,0:19:03.85,Default,,0,0,0,,Соғыс күші жағынан олар сөзсіз сенімді.
Dialogue: 0,0:19:05.97,0:19:08.89,Default,,0,0,0,,Бұл... тәтті сезім...
Dialogue: 0,0:19:21.86,0:19:23.62,Default,,0,0,0,,Йо Эмия
Dialogue: 0,0:19:24.32,0:19:25.87,Default,,0,0,0,,Асықпасаң, кешігіп қаласың.
Dialogue: 0,0:19:26.03,0:19:26.87,Default,,0,0,0,,Синдзи
Dialogue: 0,0:19:27.49,0:19:31.29,Default,,0,0,0,,Иә? Не, сен бозармайсың ба?
Dialogue: 0,0:19:31.92,0:19:35.04,Default,,0,0,0,,Ештеңе емес, мен аздап жеңілдеп қалдым.
Dialogue: 0,0:19:35.21,0:19:39.72,Default,,0,0,0,,Уайымдама, сен өлетін сияқтысың.
Dialogue: 0,0:19:39.88,0:19:41.22,Default,,0,0,0,,Хехехе
Dialogue: 0,0:19:45.72,0:19:46.93,Default,,0,0,0,,Тосқауыл?
Dialogue: 0,0:19:47.39,0:19:50.02,Default,,0,0,0,,Бұл мектепте тағы бір шебер бар...
Dialogue: 0,0:19:50.18,0:19:53.02,Default,,0,0,0,,Міне, тосқауыл қоюда.
Dialogue: 0,0:19:53.40,0:19:55.98,Default,,0,0,0,,Сол кездегі ыңғайсыздықты сезіндіңіз бе?
Dialogue: 0,0:19:56.23,0:19:58.53,Default,,0,0,0,,Бірақ неге олай етер едіңіз?
Dialogue: 0,0:19:58.69,0:20:01.95,Default,,0,0,0,,Қызметші адамның рухын қаншалықты жесе, соншалықты...
Dialogue: 0,0:20:02.11,0:20:03.57,Default,,0,0,0,,Сиқырлы күштерді жинақтау
Dialogue: 0,0:20:03.74,0:20:05.53,Default,,0,0,0,,Менің шәкіртімді құрбан ет
Dialogue: 0,0:20:05.70,0:20:08.33,Default,,0,0,0,,Сіз өзіңіздің қызметшіңізді күштірек етуге тырысасыз ба?
Dialogue: 0,0:20:08.49,0:20:09.41,Default,,0,0,0,,Не?
Dialogue: 0,0:20:10.08,0:20:12.83,Default,,0,0,0,,Бірақ кедергі әлі толық емес сияқты...
Dialogue: 0,0:20:13.00,0:20:15.29,Default,,0,0,0,,Қате жасасаңыз да, оны іске қосуға рұқсат бермеймін.
Dialogue: 0,0:20:15.46,0:20:18.05,Default,,0,0,0,,Біз шеберді дереу тауып, оны тоқтатуымыз керек.
Dialogue: 0,0:20:18.21,0:20:19.63,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:20:21.92,0:20:22.97,Default,,0,0,0,,Қазір ғана…
Dialogue: 0,0:20:23.13,0:20:24.09,Default,,0,0,0,,Айқай?
Dialogue: 0,0:20:25.59,0:20:27.26,Default,,0,0,0,,Сәлем! Эмия-кун!
Dialogue: 0,0:20:35.02,0:20:37.44,Default,,0,0,0,,Жақсы, мен ес-түссіз жатырмын деп ойлаймын.
Dialogue: 0,0:20:37.81,0:20:39.48,Default,,0,0,0,,Бұл мүлде мүмкін емес
Dialogue: 0,0:20:39.65,0:20:42.49,Default,,0,0,0,,Сіздің өмірлік күшіңіз сарқылып жатыр. Күте тұрыңыз.
Dialogue: 0,0:20:42.65,0:20:44.28,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:20:48.08,0:20:51.79,Default,,0,0,0,,(неміс емлесі)
Dialogue: 0,0:20:58.75,0:20:59.75,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:06.47,0:21:07.80,Default,,0,0,0,,Баланы жалғыз қалдырыңыз
Dialogue: 0,0:21:09.01,0:21:09.85,Default,,0,0,0,,Эмия-кун!
Dialogue: 0,0:21:20.32,0:21:24.32,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:21:39.04,0:21:41.63,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:21:42.09,0:21:44.92,Default,,0,0,0,,Мен оның мұнда жалғыз келеді деп ойламадым.
Dialogue: 0,0:21:46.68,0:21:48.01,Default,,0,0,0,,Синдзи!
Dialogue: 0,0:21:51.31,0:21:53.35,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:21:54.56,0:21:57.64,Default,,0,0,0,,(Широудың ыңырануы)
Dialogue: 0,0:22:02.02,0:22:06.11,Default,,0,0,0,,Сіз қызметшіңізді шақырмайсыз ба?
Dialogue: 0,0:22:06.28,0:22:08.95,Default,,0,0,0,,Я, Эмия сондай ыстық.
Dialogue: 0,0:22:09.20,0:22:11.53,Default,,0,0,0,,Мен оны қалай атайтынымды ұмытып қалдым.
Dialogue: 0,0:22:14.37,0:22:18.96,Default,,0,0,0,,Мен күткен жоқпын... Мектептің айналасына шлагбаум орнаттым...
Dialogue: 0,0:22:19.37,0:22:20.79,Default,,0,0,0,,О, бұл менмін
Dialogue: 0,0:22:20.96,0:22:24.55,Default,,0,0,0,,Сіз қалаған уақытта мектептегі барлық адамды өлтіре аласыз.
Dialogue: 0,0:22:24.71,0:22:26.17,Default,,0,0,0,,Тоқта
Dialogue: 0,0:22:26.88,0:22:30.14,Default,,0,0,0,,О? Сіз маған нұсқаулар бересіз бе?
Dialogue: 0,0:22:30.30,0:22:32.05,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:22:33.26,0:22:34.43,Default,,0,0,0,,Синдзи!
Dialogue: 0,0:22:35.06,0:22:36.81,Default,,0,0,0,,Бұл тітіркендіргіш.
Dialogue: 0,0:22:37.35,0:22:39.81,Default,,0,0,0,,Эмия, өл.
Dialogue: 0,0:22:50.24,0:22:51.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:23:05.25,0:23:06.09,Default,,0,0,0,,Ах
Dialogue: 0,0:23:07.26,0:23:08.76,Default,,0,0,0,,Жүр, шабандоз.
Dialogue: 0,0:23:13.35,0:23:15.31,Default,,0,0,0,,Олар мектептің айналасына шлагбаум орнатты...
Dialogue: 0,0:23:15.47,0:23:17.10,Default,,0,0,0,,Ах, Синдзи.
Dialogue: 0,0:23:17.27,0:23:19.27,Default,,0,0,0,,Бұрынғы студент қыз ше?
Dialogue: 0,0:23:19.43,0:23:21.10,Default,,0,0,0,,Мен қалпына келдім.
Dialogue: 0,0:23:36.79,0:23:37.95,Default,,0,0,0,,Иә
Dialogue: 0,0:23:38.12,0:23:40.71,Default,,0,0,0,,(Шыны сынып жатқан дыбыс)
Dialogue: 0,0:23:50.42,0:23:51.47,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:23:56.93,0:23:58.14,Default,,0,0,0,,Ширу!
Dialogue: 0,0:24:06.65,0:24:07.82,Default,,0,0,0,,Келіңіз...
Dialogue: 0,0:24:09.99,0:24:12.74,Default,,0,0,0,,Се... Сабер!
Dialogue: 0,0:24:21.37,0:24:22.75,Default,,0,0,0,,Ах, жоқ, мәселе сол емес! Мен бұған дейін ешқашан жеп көрмеппін…
Dialogue: 0,0:24:25.00,0:24:25.79,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:24:28.67,0:24:29.67,Default,,0,0,0,,Ширу
Dialogue: 0,0:24:29.84,0:24:31.67,Default,,0,0,0,,Сабер, осында өтінемін.
Dialogue: 0,0:24:31.84,0:24:33.30,Default,,0,0,0,,Түсіндім, ұстаз.
Dialogue: 0,0:24:33.68,0:24:35.43,Default,,0,0,0,,Ха! Иә!
Dialogue: 0,0:24:37.18,0:24:39.18,Default,,0,0,0,,Иә! Иә! Ха!
Dialogue: 0,0:24:44.48,0:24:45.85,Default,,0,0,0,,Иносукэ, кешір мені. Егер оны ертерек байқап қалсам...
Dialogue: 0,0:24:50.73,0:24:54.03,Default,,0,0,0,,Күлден күлге, шаңнан шаңға
Dialogue: 0,0:24:54.36,0:24:55.07,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:25:02.54,0:25:03.21,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:07.21,0:25:08.75,Default,,0,0,0,,Шлагбаумның бастапқы нүктесі.
Dialogue: 0,0:25:10.92,0:25:12.38,Default,,0,0,0,,Иә! Ха!
Dialogue: 0,0:25:15.55,0:25:16.38,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:25:18.39,0:25:18.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:23.77,0:25:24.43,Default,,0,0,0,,Ах
Dialogue: 0,0:25:28.31,0:25:29.65,Default,,0,0,0,,Қорқынышты...
Dialogue: 0,0:25:38.87,0:25:39.53,Default,,0,0,0,,Эй!
Dialogue: 0,0:25:40.08,0:25:41.91,Default,,0,0,0,,Синдзи! Сіз...
Dialogue: 0,0:25:43.91,0:25:47.17,Default,,0,0,0,,Жоқ... Жоқ, жоқ, жоқ, жоқ!
Dialogue: 0,0:25:47.33,0:25:49.96,Default,,0,0,0,,Жоқ? Мен мұндай нәрселерді жиі жасаймын.
Dialogue: 0,0:25:50.29,0:25:53.42,Default,,0,0,0,,Тосқауылды қазір алып тастаңыз немесе...
Dialogue: 0,0:25:53.92,0:25:57.63,Default,,0,0,0,,Бұл мен емес едім. Оны өлтірген мен емес едім.
Dialogue: 0,0:25:59.26,0:25:59.80,Default,,0,0,0,,Ах
Dialogue: 0,0:26:04.02,0:26:05.77,Default,,0,0,0,,Бұрынғы қызметші
Dialogue: 0,0:26:19.03,0:26:22.12,Default,,0,0,0,,Сондықтан бұл мен емес. Ол шабандоз...
Dialogue: 0,0:26:23.12,0:26:24.62,Default,,0,0,0,,Ол кім?
Dialogue: 0,0:26:24.79,0:26:26.62,Default,,0,0,0,,Ши... Білмеймін!
Dialogue: 0,0:26:29.17,0:26:31.58,Default,,0,0,0,,（）
Dialogue: 0,0:26:38.38,0:26:39.55,Default,,0,0,0,,Ел көлеміндегі ең ізденетін Зұлымдар Альянсы
Dialogue: 0,0:26:40.47,0:26:42.68,Default,,0,0,0,,Мен жай ғана күзетімді түсірдім...
Dialogue: 0,0:26:44.60,0:26:45.81,Default,,0,0,0,,Тыныс бар
Dialogue: 0,0:26:46.98,0:26:48.48,Default,,0,0,0,,Әлі уақыт бар
Dialogue: 0,0:26:48.64,0:26:49.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:49.69,0:26:52.23,Default,,0,0,0,,Барлығы тірі және құтқарылды!
Dialogue: 0,0:26:52.65,0:26:54.98,Default,,0,0,0,,(Жедел жәрдем сигналы)
Dialogue: 0,0:26:55.57,0:26:57.74,Default,,0,0,0,,Эмия-кун, дәл қазір...
Dialogue: 0,0:26:58.95,0:26:59.86,Default,,0,0,0,,Жоқ
Dialogue: 0,0:27:00.49,0:27:03.45,Default,,0,0,0,,Сіз өте сабырлысыз, мен таң қалдым.
Dialogue: 0,0:27:03.70,0:27:06.29,Default,,0,0,0,,Екеуміз де өзімізді ұмыттық.
Dialogue: 0,0:27:07.12,0:27:10.08,Default,,0,0,0,,Мен өлілерді көруге үйренгенмін, сондықтан айта аламын.
Dialogue: 0,0:27:10.62,0:27:11.92,Default,,0,0,0,,Міне
Dialogue: 0,0:27:12.08,0:27:13.17,Default,,0,0,0,,Бұл таныс сияқты ма?
Dialogue: 0,0:27:15.25,0:27:18.38,Default,,0,0,0,,Не, Сабердің мұнда келгеніне таң қалдым.
Dialogue: 0,0:27:19.17,0:27:22.01,Default,,0,0,0,,Сіз! Енді не істеуді жоспарлап отырсыз?
Dialogue: 0,0:27:23.18,0:27:26.31,Default,,0,0,0,,Мен қожайыныма бірдеңе болғанын сезіп, оған қарай жүгірдім.
Dialogue: 0,0:27:26.85,0:27:30.06,Default,,0,0,0,,Алайда іс біткен сияқты.
Dialogue: 0,0:27:30.23,0:27:33.36,Default,,0,0,0,,Иә, орындалды!
Dialogue: 0,0:27:33.86,0:27:37.82,Default,,0,0,0,,Мен саған не болғанын айтамын, сол жаққа қайт!
Dialogue: 0,0:27:37.98,0:27:42.82,Default,,0,0,0,,Сен демалып жатқанда Ширу екеумізге не болды?
Dialogue: 0,0:27:43.24,0:27:46.53,Default,,0,0,0,,Сіз жекпе-жектен бас тартасыз ба? бала
Dialogue: 0,0:27:46.70,0:27:49.54,Default,,0,0,0,,Қызметшісіз күресу мүмкін емес!
Dialogue: 0,0:27:50.00,0:27:52.37,Default,,0,0,0,,Шабандозға қоқысты ұстауға жол берме!
Dialogue: 0,0:27:52.54,0:27:54.54,Default,,0,0,0,,Қызметші нашар болды ма?
Dialogue: 0,0:27:54.71,0:27:55.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:27:56.29,0:28:00.09,Default,,0,0,0,,Біздің жеңілгенімізге мен кінәлі емеспін, олар...
Dialogue: 0,0:28:00.26,0:28:02.76,Default,,0,0,0,,Сіз өте мақтаншақ көрінесіз! !
Dialogue: 0,0:28:02.93,0:28:05.68,Default,,0,0,0,,Сіз әлі де күресуге бел будыңыз, солай емес пе?
Dialogue: 0,0:28:06.89,0:28:08.52,Default,,0,0,0,,Сіз бақыттысыз
Dialogue: 0,0:28:08.89,0:28:12.56,Default,,0,0,0,,Бос тұрған бір қызметші бар.
Dialogue: 0,0:28:16.40,0:28:17.73,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:28:19.53,0:28:20.82,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:28:23.70,0:28:24.99,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:28:28.12,0:28:29.37,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:28:39.59,0:28:40.84,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:28:42.51,0:28:43.72,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:28:45.68,0:28:46.97,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:28:49.76,0:28:50.68,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:28:52.56,0:28:53.85,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:28:55.77,0:28:57.02,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:28:58.77,0:29:00.11,Default,,0,0,0,,Қан жарылысы!
Dialogue: 0,0:29:11.79,0:29:12.95,Default,,0,0,0,,Сабер үшін-
Dialogue: 0,0:29:13.12,0:29:16.92,Default,,0,0,0,,Сізге тітіркендіргіш Берсеркерді жеңуге рұқсат етіңіз.
Dialogue: 0,0:29:17.17,0:29:18.33,Default,,0,0,0,,ЖоЖо, бұл сәл оғаш сұрақ болуы мүмкін, бірақ менде бір өтініш бар
Dialogue: 0,0:29:19.09,0:29:21.13,Default,,0,0,0,,Мен бұл бұйрықты қабылдаймын.
Dialogue: 0,0:29:47.49,0:29:48.28,Default,,0,0,0,,Бұл галлюцинация ма? Карстың қолы тышқанға айналып кетті…
Dialogue: 0,0:29:49.24,0:29:50.91,Default,,0,0,0,,Рюдоужи храмының қамқоршысы
Dialogue: 0,0:29:51.08,0:29:52.70,Default,,0,0,0,,Ассасин қызметшісі
Dialogue: 0,0:29:52.87,0:29:55.08,Default,,0,0,0,,Менің ойымша, сіз осы жерден өткіңіз келеді.
Dialogue: 0,0:29:56.41,0:29:58.33,Default,,0,0,0,,Содан кейін итеріңіз.
Dialogue: 0,0:30:20.10,0:30:20.81,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:30:25.32,0:30:27.03,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:30:27.32,0:30:29.82,Default,,0,0,0,,(Широудың ауыр тыныс алуы)
Dialogue: 0,0:30:30.70,0:30:33.33,Default,,0,0,0,,Сен... неге мұндасың?
Dialogue: 0,0:30:33.95,0:30:36.00,Default,,0,0,0,,Мен жәй өтіп бара жатырмын, оған алаңдама.
Dialogue: 0,0:30:37.87,0:30:39.71,Default,,0,0,0,,Садақшы өлтіруші
Dialogue: 0,0:30:40.00,0:30:41.04,Default,,0,0,0,,Сіз не істеп жүрсіз?
Dialogue: 0,0:30:41.21,0:30:42.46,Default,,0,0,0,,Осылай болмас еді...
Dialogue: 0,0:30:42.63,0:30:45.05,Default,,0,0,0,,Бір жерде екі қызметші
Dialogue: 0,0:30:45.30,0:30:48.30,Default,,0,0,0,,Кастер, сіздің қожайыныңыз және Ассасиннің қожайыны...
Dialogue: 0,0:30:48.47,0:30:50.97,Default,,0,0,0,,Біз бір-бірімізбен ынтымақтасамыз дейсіз бе?
Dialogue: 0,0:30:52.10,0:30:53.47,Default,,0,0,0,,Ынтымақтастық?
Dialogue: 0,0:30:54.39,0:30:57.81,Default,,0,0,0,,Мен шақырған пешка ғана болған адаммен бе?
Dialogue: 0,0:30:57.98,0:30:59.02,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:30:59.48,0:31:01.48,Default,,0,0,0,,Сіз ережені бұздыңыз.
Dialogue: 0,0:31:01.65,0:31:06.36,Default,,0,0,0,,О, мен бастапқыда сиқыршымын, бірақ қызметшіні шақырдым...
Dialogue: 0,0:31:06.90,0:31:08.57,Default,,0,0,0,,Мәселе неде?
Dialogue: 0,0:31:08.90,0:31:11.49,Default,,0,0,0,,Қаладағы адамдардан жан жұту...
Dialogue: 0,0:31:11.66,0:31:14.95,Default,,0,0,0,,Соғыстың орнына Ассасинді қолдану арқылы өзімді қорғауым керек пе?
Dialogue: 0,0:31:15.74,0:31:16.29,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:31:18.00,0:31:18.71,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:24.29,0:31:25.55,Default,,0,0,0,,Соншама?
Dialogue: 0,0:31:35.93,0:31:37.35,Default,,0,0,0,,Сіз қанша уақыт тұрасыз?
Dialogue: 0,0:31:39.43,0:31:40.27,Default,,0,0,0,,Ах
Dialogue: 0,0:31:41.14,0:31:42.56,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:31:43.10,0:31:43.86,Default,,0,0,0,,Ширу!
Dialogue: 0,0:31:46.15,0:31:48.28,Default,,0,0,0,,Неліктен осы қиыншылықтан өтіп жатырсың?
Dialogue: 0,0:31:49.69,0:31:50.90,Default,,0,0,0,,Менен түс, ақымақ!
Dialogue: 0,0:31:51.07,0:31:53.41,Default,,0,0,0,,Аузыңды жап! Менен сұрағанда...
Dialogue: 0,0:31:53.57,0:31:56.12,Default,,0,0,0,,Менің ақымақтығым басымды ауыртады.
Dialogue: 0,0:32:06.79,0:32:07.46,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:32:08.17,0:32:09.21,Default,,0,0,0,,Уау!
Dialogue: 0,0:32:15.68,0:32:20.14,Default,,0,0,0,,Хехе... қалай? Сіз қозғала аласыз ба? садақшы
Dialogue: 0,0:32:21.10,0:32:23.31,Default,,0,0,0,,Бұл соңы сияқты.
Dialogue: 0,0:32:23.48,0:32:25.81,Default,,0,0,0,,Сабыр да сыртта жүрген сияқты...
Dialogue: 0,0:32:25.98,0:32:28.65,Default,,0,0,0,,Менің саған енді уақытым жоқ.
Dialogue: 0,0:32:29.28,0:32:30.15,Default,,0,0,0,,Додж
Dialogue: 0,0:32:30.65,0:32:31.82,Default,,0,0,0,,Бірдеңе?
Dialogue: 0,0:32:31.99,0:32:34.45,Default,,0,0,0,,Оя! Мен қаш, Кастер дедім.
Dialogue: 0,0:32:45.12,0:32:46.92,Default,,0,0,0,,Менің негізгі ойым-
Dialogue: 0,0:32:47.34,0:32:49.21,Default,,0,0,0,,бұралған және ақылсыз
Dialogue: 0,0:32:51.21,0:32:53.05,Default,,0,0,0,,Каладболг
Dialogue: 0,0:33:15.20,0:33:15.82,Default,,0,0,0,,Ах
Dialogue: 0,0:33:17.95,0:33:20.66,Default,,0,0,0,,Неліктен оны алып тастадыңыз?
Dialogue: 0,0:33:21.04,0:33:23.79,Default,,0,0,0,,Қылышты қолға алсаң, бұл сенімді жеңіске мүмкіндік...
Dialogue: 0,0:33:23.96,0:33:26.04,Default,,0,0,0,,Тек өлтіремін деп ант бергенде
Dialogue: 0,0:33:26.54,0:33:28.71,Default,,0,0,0,,Мен мағынасыз өлтіруге шебер емеспін.
Dialogue: 0,0:33:29.75,0:33:33.84,Default,,0,0,0,,Олай болса, сендер ұқсассыңдар...
Dialogue: 0,0:33:34.22,0:33:35.13,Default,,0,0,0,,Не?
Dialogue: 0,0:33:35.30,0:33:38.14,Default,,0,0,0,,Мәнсіз сойғанды ұнатпайсың.
Dialogue: 0,0:33:38.39,0:33:43.10,Default,,0,0,0,,Мен ол баланың туысы жоқ адамды құрбандыққа шалуына жол бере алмаймын.
Dialogue: 0,0:33:43.39,0:33:45.02,Default,,0,0,0,,Олар дәл солай емес пе?
Dialogue: 0,0:33:45.18,0:33:48.10,Default,,0,0,0,,Ақымақ болма! Бұл жігітпен кім бар?
Dialogue: 0,0:33:48.98,0:33:50.40,Default,,0,0,0,,Біз бәріміз құтқарылар едік
Dialogue: 0,0:33:50.69,0:33:52.53,Default,,0,0,0,,Негізінен басқа
Dialogue: 0,0:33:52.90,0:33:53.82,Default,,0,0,0,,Иә
Dialogue: 0,0:33:54.19,0:33:56.40,Default,,0,0,0,,Оны жауға айналдыру ұят болар.
Dialogue: 0,0:33:57.45,0:33:59.24,Default,,0,0,0,,Менімен қол ұстасып
Dialogue: 0,0:33:59.45,0:34:00.41,Default,,0,0,0,,Не?
Dialogue: 0,0:34:02.08,0:34:06.41,Default,,0,0,0,,Мен қазіргі серіктесімнен жақсырақ нәрсені ұсына аламын.
Dialogue: 0,0:34:06.83,0:34:08.58,Default,,0,0,0,,Кім сені ойлайды!
Dialogue: 0,0:34:08.75,0:34:09.83,Default,,0,0,0,,(Иносукэ) Эй! (Зэнитсу) Ұф…
Dialogue: 0,0:34:10.00,0:34:12.13,Default,,0,0,0,,Сіздің фракцияңызға күш жетіспейді.
Dialogue: 0,0:34:12.59,0:34:14.55,Default,,0,0,0,,Беруге негіз жоқ
Dialogue: 0,0:34:14.76,0:34:17.97,Default,,0,0,0,,Бұл келіссөздер үзілді дегенді білдіре ме?
Dialogue: 0,0:34:18.13,0:34:18.93,Default,,0,0,0,,Иә.
Dialogue: 0,0:34:19.30,0:34:23.39,Default,,0,0,0,,Бірақ мен мұнда жалғыз болдым.
Dialogue: 0,0:34:23.56,0:34:25.27,Default,,0,0,0,,Сізді өлтіруге ешқандай себеп жоқ
Dialogue: 0,0:34:25.77,0:34:26.98,Default,,0,0,0,,Шығу
Dialogue: 0,0:34:27.69,0:34:28.94,Default,,0,0,0,,Не?
Dialogue: 0,0:34:29.77,0:34:30.44,Default,,0,0,0,,Иә
Dialogue: 0,0:34:32.61,0:34:33.69,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:34:34.94,0:34:36.53,Default,,0,0,0,,Неліктен оның қашып кетуіне жол бердіңіз?
Dialogue: 0,0:34:36.69,0:34:40.28,Default,,0,0,0,,Қалада болып жатқан оқиғалар оның ісі.
Dialogue: 0,0:34:40.45,0:34:42.08,Default,,0,0,0,,Оны тоқтатуға себеп бар ма?
Dialogue: 0,0:34:42.24,0:34:43.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:43.62,0:34:46.70,Default,,0,0,0,,Кастер адамнан тіршілікті сорып алады...
Dialogue: 0,0:34:46.87,0:34:50.04,Default,,0,0,0,,Берсеркерді жоғары күшпен жеңіңіз
Dialogue: 0,0:34:50.54,0:34:52.17,Default,,0,0,0,,Біз сонда-
Dialogue: 0,0:34:53.42,0:34:54.84,Default,,0,0,0,,Тек Кастерді жеңіңіз
Dialogue: 0,0:34:55.00,0:34:57.97,Default,,0,0,0,,Өзіңізді алдамаңыз! Мен сенен басқашамын
Dialogue: 0,0:34:58.13,0:35:01.43,Default,,0,0,0,,Жеңіске жету, нәтиже үшін басқаларды құрбан ету.
Dialogue: 0,0:35:02.14,0:35:04.76,Default,,0,0,0,,Барлық адамдарды құтқару мүмкін емес.
Dialogue: 0,0:35:07.23,0:35:08.35,Default,,0,0,0,,Оны мойындаңыз.
Dialogue: 0,0:35:09.10,0:35:11.77,Default,,0,0,0,,Бір адамды өлтірмеу идеясы...
Dialogue: 0,0:35:12.15,0:35:14.65,Default,,0,0,0,,Ақырында ешкімді құтқару мүмкін емес
Dialogue: 0,0:35:21.03,0:35:23.16,Default,,0,0,0,,Өміріңді жоғалтқың келмесе, мұны істеме.
Dialogue: 0,0:35:29.12,0:35:30.16,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:35:31.33,0:35:32.42,Default,,0,0,0,,Сәлем! (Широу) Уау!
Dialogue: 0,0:35:35.92,0:35:39.05,Default,,0,0,0,,Бұл соңы. Ұрысудың мәні жоқ.
Dialogue: 0,0:35:40.59,0:35:44.05,Default,,0,0,0,,Ширу Эмия осында өледі.
Dialogue: 0,0:35:45.47,0:35:46.26,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:35:53.35,0:35:54.36,Default,,0,0,0,,Ширу
Dialogue: 0,0:35:56.65,0:35:58.61,Default,,0,0,0,,Se... iver...
Dialogue: 0,0:36:02.45,0:36:04.82,Default,,0,0,0,,Неге қазір мені өлтірмедің?
Dialogue: 0,0:36:05.20,0:36:06.91,Default,,0,0,0,,Бұл этикалық емес
Dialogue: 0,0:36:07.20,0:36:09.62,Default,,0,0,0,,Бір сәттік гүлді теруге болмайды
Dialogue: 0,0:36:10.04,0:36:10.87,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:36:12.29,0:36:14.54,Default,,0,0,0,,Кешіріңіз, келісім болуы керек
Dialogue: 0,0:36:16.79,0:36:18.88,Default,,0,0,0,,Сіз кедергі келтіресіз бе? Самурай
Dialogue: 0,0:36:19.38,0:36:23.89,Default,,0,0,0,,Сағынатынымды айттыңыз. Сіз менің жолыма кедергі келтіргіңіз келе ме?
Dialogue: 0,0:36:49.04,0:36:50.20,Default,,0,0,0,,Фуджиниді босатыңыз
Dialogue: 0,0:36:50.91,0:36:51.66,Default,,0,0,0,,Иә
Dialogue: 0,0:36:57.84,0:36:58.92,Default,,0,0,0,,Сәлем Фудзи!
Dialogue: 0,0:37:01.88,0:37:02.76,Default,,0,0,0,,(түтіксіз соққы дыбысы)
Dialogue: 0,0:37:07.76,0:37:09.31,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:37:10.60,0:37:12.64,Default,,0,0,0,,(Сабердің ыңырануы)
Dialogue: 0,0:37:22.57,0:37:24.78,Default,,0,0,0,,Асыл фантазм ережесін бұзушы
Dialogue: 0,0:37:25.66,0:37:28.28,Default,,0,0,0,,Барлық келісім-шарттардың күшін жою.
Dialogue: 0,0:37:28.45,0:37:29.87,Default,,0,0,0,,Сатқындық және қасиетсіз қылыш
Dialogue: 0,0:37:30.33,0:37:32.04,Default,,0,0,0,,Сіз! Сабер...
Dialogue: 0,0:37:32.20,0:37:34.75,Default,,0,0,0,,Иә, мен оны өзіме таныс еттім.
Dialogue: 0,0:37:38.29,0:37:41.63,Default,,0,0,0,,Алдымен мына қызды өлтір.
Dialogue: 0,0:37:51.31,0:37:52.56,Default,,0,0,0,,Тоқта
Dialogue: 0,0:37:53.31,0:37:54.64,Default,,0,0,0,,Өлтіру
Dialogue: 0,0:37:58.06,0:37:59.15,Default,,0,0,0,,Тоқта! !
Dialogue: 0,0:38:00.56,0:38:01.48,Default,,0,0,0,,(түтіксіз соққы дыбысы)
Dialogue: 0,0:38:07.99,0:38:10.28,Default,,0,0,0,,(Широудың ыңырануы)
Dialogue: 0,0:38:10.66,0:38:13.12,Default,,0,0,0,,Сіз бұйрық заклинаның байланыстарына қарсы тұрғыңыз келе ме?
Dialogue: 0,0:38:15.96,0:38:18.04,Default,,0,0,0,,Қаш... Широ...
Dialogue: 0,0:38:26.09,0:38:27.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:38:28.88,0:38:30.18,Default,,0,0,0,,Сабер…
Dialogue: 0,0:38:37.85,0:38:39.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:38:57.71,0:38:59.83,Default,,0,0,0,,(Широудың ыңырануы)
Dialogue: 0,0:39:00.37,0:39:00.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:39:05.96,0:39:07.05,Default,,0,0,0,,Рем – Рем
Dialogue: 0,0:39:14.06,0:39:15.06,Default,,0,0,0,,Бұл…
Dialogue: 0,0:39:18.14,0:39:19.73,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:39:21.77,0:39:25.32,Default,,0,0,0,,(Сабердің ыңырсыуы)
Dialogue: 0,0:39:27.15,0:39:30.74,Default,,0,0,0,,Қалайша түні бойы бұйрық заклинаның байланыстарынан бас тартуға болады?
Dialogue: 0,0:39:31.95,0:39:34.53,Default,,0,0,0,,(Кастердің күлуі)
Dialogue: 0,0:39:36.58,0:39:40.54,Default,,0,0,0,,(Сабердің ыңырануы)
Dialogue: 0,0:39:50.17,0:39:54.39,Default,,0,0,0,,Анау келіншек мына жерді иіскесе жолы болмайды.
Dialogue: 0,0:40:36.18,0:40:39.06,Default,,0,0,0,,Иә, ол Кирейді өлтірді.
Dialogue: 0,0:40:42.64,0:40:46.65,Default,,0,0,0,,Ол мойынсұнушылықпен Қасиетті Граалды ұсынатын адам сияқты көрінбеді.
Dialogue: 0,0:40:47.19,0:40:48.27,Default,,0,0,0,,Бұл...
Dialogue: 0,0:40:53.90,0:40:55.82,Default,,0,0,0,,Катсураги... Сенсей
Dialogue: 0,0:40:57.41,0:41:00.74,Default,,0,0,0,,-де? Сіз мәйітті растадыңыз ба?
Dialogue: 0,0:41:01.04,0:41:02.83,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:41:03.00,0:41:06.33,Default,,0,0,0,,Ха! Кирей осылай оңай өле ме деп ойлаймын.
Dialogue: 0,0:41:06.63,0:41:09.75,Default,,0,0,0,,Сіз шынымен де пайдасыз әйелсіз.
Dialogue: 0,0:41:10.05,0:41:13.92,Default,,0,0,0,,Саберді құтқарыңыз. Мен ол сиқыршымен айналысамын.
Dialogue: 0,0:41:14.51,0:41:17.26,Default,,0,0,0,,Рин: Сиқыршы құюшыға тең келмейді.
Dialogue: 0,0:41:17.43,0:41:18.30,Default,,0,0,0,,Қарсыласыңды рингтен шығарып таста немесе оны әрекет ете алмайтындай күйге келтір
Dialogue: 0,0:41:19.35,0:41:20.85,Default,,0,0,0,,Оны міндетті түрде жеңіп, көрсетіңіз
Dialogue: 0,0:41:22.22,0:41:23.68,Default,,0,0,0,,Бұл идеализм.
Dialogue: 0,0:41:24.19,0:41:27.69,Default,,0,0,0,,Өкінішке орай, бұл жерде Кастерді өлтіру қиын.
Dialogue: 0,0:41:27.94,0:41:32.03,Default,,0,0,0,,Өйткені ол қашып құтылу үшін өз ағасын да жұлып алатын әйел.
Dialogue: 0,0:41:32.82,0:41:34.03,Default,,0,0,0,,Сәлем! сен не істейсің?
Dialogue: 0,0:41:34.53,0:41:39.03,Default,,0,0,0,,Айдаһар тісінен жасалған гуманоид пішіні Колхида патшаның сиқыры деп естимін.
Dialogue: 0,0:41:39.74,0:41:44.04,Default,,0,0,0,,Оның қызы Медея ханшайымды сирек кездесетін бақсы деп атаған сияқты.
Dialogue: 0,0:41:44.91,0:41:45.79,Default,,0,0,0,,Иә
Dialogue: 0,0:41:46.58,0:41:49.79,Default,,0,0,0,,Олай болса, бұл жағдайда қай тараптың басым екенін білесіз бе?
Dialogue: 0,0:41:50.54,0:41:53.76,Default,,0,0,0,,Сабыр көп ұзамай менің қолыма түседі.
Dialogue: 0,0:41:53.92,0:41:54.80,Default,,0,0,0,,(Сабердің ыңырануы)
Dialogue: 0,0:41:56.38,0:42:00.30,Default,,0,0,0,,Хмф! Тіпті командалық заклинание қолданылса да, Сабер оған төтеп бере алады.
Dialogue: 0,0:42:00.64,0:42:02.56,Default,,0,0,0,,Аз уақытқа болса да...
Dialogue: 0,0:42:03.35,0:42:05.39,Default,,0,0,0,,Бұл сізді аяқтауға жеткілікті.
Dialogue: 0,0:42:05.56,0:42:06.56,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:42:07.48,0:42:10.19,Default,,0,0,0,,Мен алдыңғы әңгімені қабылдаймын.
Dialogue: 0,0:42:11.02,0:42:14.57,Default,,0,0,0,,Бас тартсаңыз да, жеңіл-желпі болыңыз
Dialogue: 0,0:42:15.03,0:42:16.65,Default,,0,0,0,,Жағдайлар өзгерді
Dialogue: 0,0:42:16.90,0:42:20.24,Default,,0,0,0,,Сабер сіз жақта болса, жеңіске жету мүмкіндігі сіздікі.
Dialogue: 0,0:42:20.41,0:42:22.16,Default,,0,0,0,,Садақшы Сіз...
Dialogue: 0,0:42:22.33,0:42:24.58,Default,,0,0,0,,Ал... Келісімшартты бұзушыны пайдаланыңыз.
Dialogue: 0,0:42:30.25,0:42:31.17,Default,,0,0,0,,(түтіксіз соққы дыбысы)
Dialogue: 0,0:42:50.35,0:42:51.02,Default,,0,0,0,,Ширу!
Dialogue: 0,0:42:52.94,0:42:54.28,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:43:00.57,0:43:01.41,Default,,0,0,0,,Бақылау қосулы
Dialogue: 0,0:43:08.58,0:43:10.83,Default,,0,0,0,,Ха! Уф! Ха!
Dialogue: 0,0:43:11.42,0:43:12.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:43:13.09,0:43:13.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:16.34,0:43:17.26,Default,,0,0,0,,Қ-Қандай?
Dialogue: 0,0:43:17.63,0:43:20.97,Default,,0,0,0,,Әскерге қосылудың бір ғана шарты бар.
Dialogue: 0,0:43:21.14,0:43:23.05,Default,,0,0,0,,Шарт? Енді ше?
Dialogue: 0,0:43:23.89,0:43:25.81,Default,,0,0,0,,Мұнда оларды елемеңіз.
Dialogue: 0,0:43:26.77,0:43:29.52,Default,,0,0,0,,Кез келген жағдайда ол шебердің қызметін атқара алмайды.
Dialogue: 0,0:43:29.89,0:43:31.06,Default,,0,0,0,,Өлтіруге тұрарлық емес шығар.
Dialogue: 0,0:43:33.31,0:43:35.11,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:43:35.27,0:43:38.74,Default,,0,0,0,,Жеңілгендер жеңілгендер сияқты әрекет етіп, тез кетуі керек.
Dialogue: 0,0:43:41.07,0:43:42.32,Default,,0,0,0,,Кеттік
Dialogue: 0,0:43:52.37,0:43:54.84,Default,,0,0,0,,Жеке сөйлеу... бірақ...
Dialogue: 0,0:43:56.13,0:43:58.34,Default,,0,0,0,,Мен шамалы қателескен шығармын.
Dialogue: 0,0:43:58.92,0:44:03.01,Default,,0,0,0,,Мен Кастерді басынан бастап кез келген әдіспен жеңуім керек еді.
Dialogue: 0,0:44:04.76,0:44:08.93,Default,,0,0,0,,Оның арғы бетке өткені Арчердің ғана кінәсі емес.
Dialogue: 0,0:44:10.52,0:44:13.69,Default,,0,0,0,,Мүмкін мен өз пікірімде қателескен шығармын.
Dialogue: 0,0:44:14.19,0:44:16.36,Default,,0,0,0,,Тохсака қателеспеді.
Dialogue: 0,0:44:16.52,0:44:17.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:17.86,0:44:21.36,Default,,0,0,0,,Мен сәтсіздікке ұшыраған шығармын, бірақ мен қателескен жоқпын.
Dialogue: 0,0:44:23.49,0:44:25.32,Default,,0,0,0,,Сондықтан мақтануға болады
Dialogue: 0,0:44:30.33,0:44:31.46,Default,,0,0,0,,Ширу...
Dialogue: 0,0:44:35.63,0:44:39.13,Default,,0,0,0,,Сонда да Шируға сене алар емеспін.
Dialogue: 0,0:44:39.88,0:44:42.80,Default,,0,0,0,,Арчермен бірдей қылышты проекциялау?
Dialogue: 0,0:44:43.26,0:44:45.14,Default,,0,0,0,,Мен тіпті таң қалдым.
Dialogue: 0,0:44:45.51,0:44:48.47,Default,,0,0,0,,Осы уақытқа дейін мен қаруды жобалай алмадым...
Dialogue: 0,0:44:48.64,0:44:50.47,Default,,0,0,0,,Оның қылышы басқаша болды.
Dialogue: 0,0:44:51.31,0:44:53.77,Default,,0,0,0,,Құрылым туралы ойлау процесін өткізіп жіберу...
Dialogue: 0,0:44:54.06,0:44:56.06,Default,,0,0,0,,Ойға бір айқын бейне түсті.
Dialogue: 0,0:44:56.73,0:45:00.07,Default,,0,0,0,,Басынан бері болған сияқты
Dialogue: 0,0:45:02.24,0:45:03.28,Default,,0,0,0,,Уау!
Dialogue: 0,0:45:07.20,0:45:09.87,Default,,0,0,0,,Әйтеуір, болашақ стратегиямызды жоспарлап алайық.
Dialogue: 0,0:45:12.00,0:45:14.33,Default,,0,0,0,,Дұрыс, мен мұны қайтаруым керек.
Dialogue: 0,0:45:22.80,0:45:24.13,Default,,0,0,0,,Тохсаканыкі, солай ма?
Dialogue: 0,0:45:24.30,0:45:28.68,Default,,0,0,0,,Мен оны кешегі күні Тохсака бөлмесінен дәл осындай пішінді тапқанша байқамадым.
Dialogue: 0,0:45:41.78,0:45:45.24,Default,,0,0,0,,Эй, Илья деген қыздан көмек сұрай аламыз ба?
Dialogue: 0,0:45:45.45,0:45:47.61,Default,,0,0,0,,Сіз кенеттен не айтып тұрсыз?
Dialogue: 0,0:45:47.78,0:45:49.16,Default,,0,0,0,,Берсеркердің шебері...
Dialogue: 0,0:45:49.32,0:45:51.79,Default,,0,0,0,,Біздің басқа күштермен күш біріктіру мүмкін емес.
Dialogue: 0,0:45:52.24,0:45:54.29,Default,,0,0,0,,Сіз бұл туралы сөйлеспейінше түсінбейсіз, солай ма?
Dialogue: 0,0:45:54.79,0:45:56.29,Default,,0,0,0,,Мүмкіндік нөлге тең емес
Dialogue: 0,0:45:56.46,0:45:57.79,Default,,0,0,0,,Бұл ақылсыз
Dialogue: 0,0:45:57.96,0:45:59.79,Default,,0,0,0,,Сіз қаншалықты адалсыз?
Dialogue: 0,0:46:00.88,0:46:01.96,Default,,0,0,0,,Егер садақшы...
Dialogue: 0,0:46:02.13,0:46:04.63,Default,,0,0,0,,Соншалықты белгісіз нәрсеге қалай үміт артуға болады?
Dialogue: 0,0:46:04.80,0:46:06.47,Default,,0,0,0,,Сіз мұны күлкілі деп айтасыз.
Dialogue: 0,0:46:06.63,0:46:08.34,Default,,0,0,0,,Бірақ біз басқашамыз.
Dialogue: 0,0:46:08.93,0:46:12.81,Default,,0,0,0,,Мүмкіндік он мыңнан 1 болса да сенейік
Dialogue: 0,0:46:20.27,0:46:21.90,Default,,0,0,0,,(Берсеркердің айқайы)
Dialogue: 0,0:46:30.57,0:46:32.83,Default,,0,0,0,,(Берсеркердің ырылдауы)
Dialogue: 0,0:46:33.83,0:46:35.83,Default,,0,0,0,,Берсеркер...
Dialogue: 0,0:46:36.21,0:46:40.88,Default,,0,0,0,,(Шинджидің күлуі)
Dialogue: 0,0:46:41.42,0:46:43.00,Default,,0,0,0,,Неліктен ол...
Dialogue: 0,0:46:48.93,0:46:49.93,Default,,0,0,0,,Ерен шын ниетін жасырып жүр деп есептесек➡
Dialogue: 0,0:46:51.18,0:46:51.85,Default,,0,0,0,,Хмф!
Dialogue: 0,0:47:01.98,0:47:03.44,Default,,0,0,0,,Берсеркер
Dialogue: 0,0:47:06.65,0:47:07.86,Default,,0,0,0,,Аспан тізбектері
Dialogue: 0,0:47:18.96,0:47:21.50,Default,,0,0,0,,Бұл тізбекте байланысқандар-
Dialogue: 0,0:47:21.67,0:47:25.05,Default,,0,0,0,,Тіпті Құдай қашып құтыла алмайды
Dialogue: 0,0:47:32.34,0:47:35.01,Default,,0,0,0,,(Берсеркердің айқайы)
Dialogue: 0,0:47:44.02,0:47:47.82,Default,,0,0,0,,(Берсеркердің айқайы)
Dialogue: 0,0:47:48.28,0:47:49.82,Default,,0,0,0,,Жабырқаушы!
Dialogue: 0,0:47:59.62,0:48:00.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:10.30,0:48:11.76,Default,,0,0,0,,Қуыршақ кел
Dialogue: 0,0:48:11.93,0:48:12.88,Default,,0,0,0,,Мен осындамын ғой?
Dialogue: 0,0:48:13.09,0:48:17.01,Default,,0,0,0,,Жоқ, жоқ, жоқ, жоқ!
Dialogue: 0,0:48:24.81,0:48:25.90,Default,,0,0,0,,(түтіксіз соққы дыбысы)
Dialogue: 0,0:48:26.77,0:48:27.44,Default,,0,0,0,,Иә
Dialogue: 0,0:48:33.16,0:48:35.62,Default,,0,0,0,,Тоқта! !
Dialogue: 0,0:48:47.04,0:48:48.05,Default,,0,0,0,,Эмия!
Dialogue: 0,0:48:49.00,0:48:50.96,Default,,0,0,0,,Аудитория болды ма?
Dialogue: 0,0:48:51.13,0:48:54.13,Default,,0,0,0,,Менің батырлық жағымды көргіңіз келетінін түсінемін, бірақ...
Dialogue: 0,0:48:54.47,0:48:56.39,Default,,0,0,0,,Өзіңіз туралы хабардар болыңыз!
Dialogue: 0,0:48:59.14,0:49:00.22,Default,,0,0,0,,Күте тұрыңыз.
Dialogue: 0,0:49:00.68,0:49:01.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:02.14,0:49:06.90,Default,,0,0,0,,Эй, бұл менің жаңа қызметшім.
Dialogue: 0,0:49:08.98,0:49:10.73,Default,,0,0,0,,Өмірің үшін жалбарын
Dialogue: 0,0:49:11.94,0:49:15.78,Default,,0,0,0,,Солай етсең, мен сенің жаныңды аямаймын.
Dialogue: 0,0:49:17.37,0:49:17.99,Default,,0,0,0,,Бас тарт!
Dialogue: 0,0:49:18.24,0:49:19.66,Default,,0,0,0,,Жоқ! Бля... Бля...
Dialogue: 0,0:49:21.83,0:49:23.25,Default,,0,0,0,,Мына жерде қызметші!
Dialogue: 0,0:49:23.41,0:49:24.12,Default,,0,0,0,,Иә? (Синдзи) Аа.
Dialogue: 0,0:49:24.67,0:49:27.42,Default,,0,0,0,,Бір саусағыңды қимылдасаң, Ұстаздың өмірі кетеді.
Dialogue: 0,0:49:27.88,0:49:28.96,Default,,0,0,0,,Тохсака
Dialogue: 0,0:49:29.42,0:49:31.00,Default,,0,0,0,,Мен қожайынды өлтірсем де...
Dialogue: 0,0:49:31.17,0:49:34.80,Default,,0,0,0,,Мені тоқтата алмаймын деп шештің бе, қыз?
Dialogue: 0,0:49:37.55,0:49:39.30,Default,,0,0,0,,Эй, сен нені айтып тұрсың?
Dialogue: 0,0:49:39.68,0:49:41.31,Default,,0,0,0,,Жағдайлар өзгерді
Dialogue: 0,0:49:41.52,0:49:44.85,Default,,0,0,0,,Оның үстіне, ол тамаша кеме.
Dialogue: 0,0:49:45.02,0:49:45.77,Default,,0,0,0,,Әй?
Dialogue: 0,0:49:48.94,0:49:51.02,Default,,0,0,0,,Қуаныштымын, Тохсақа.
Dialogue: 0,0:49:51.44,0:49:53.53,Default,,0,0,0,,Тірі болғаныңызға рахмет
Dialogue: 0,0:49:53.82,0:49:56.74,Default,,0,0,0,,Сіз Кастердің қуат жинап жатқанын білесіз бе?
Dialogue: 0,0:49:57.28,0:50:00.08,Default,,0,0,0,,Рюдоужи храмы осы уақытқа арналған құрбандық үстелі болып табылады.
Dialogue: 0,0:50:00.49,0:50:03.87,Default,,0,0,0,,Егер сіз тұтқынға түссеңіз, сіз аздап кемшіліктесіз.
Dialogue: 0,0:50:04.20,0:50:07.33,Default,,0,0,0,,Сіз қалай ойлайсыз? Эмиияны жайына қалдыр.
Dialogue: 0,0:50:07.83,0:50:09.54,Default,,0,0,0,,Бізбен күш біріктіргіңіз келе ме?
Dialogue: 0,0:50:09.71,0:50:10.71,Default,,0,0,0,,№
Dialogue: 0,0:50:10.88,0:50:11.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:11.88,0:50:14.34,Default,,0,0,0,,Сізді өз пайдаңызға пайдаланып жатырсыз...
Dialogue: 0,0:50:14.51,0:50:16.13,Default,,0,0,0,,Менің артымнан еруге ешқандай себеп жоқ.
Dialogue: 0,0:50:16.30,0:50:18.05,Default,,0,0,0,,Не... Иә?
Dialogue: 0,0:50:18.97,0:50:20.05,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:50:20.72,0:50:24.60,Default,,0,0,0,,Сізде сиқыршылық қабілеті жоқ, сондықтан сіз өзіңізді шебермін деп ойлайсыз...
Dialogue: 0,0:50:24.77,0:50:26.56,Default,,0,0,0,,Сен жалғызсың.
Dialogue: 0,0:50:26.73,0:50:28.56,Default,,0,0,0,,Ал... уақыт бітті.
Dialogue: 0,0:50:28.73,0:50:31.52,Default,,0,0,0,,Одан әрі қалдырсаңыз, ол шіріп кетеді.
Dialogue: 0,0:50:31.73,0:50:32.90,Default,,0,0,0,,Эй!
Dialogue: 0,0:50:33.11,0:50:36.07,Default,,0,0,0,,Қат! Өкінбе!
Dialogue: 0,0:50:42.08,0:50:43.24,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:50:52.75,0:50:53.75,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:50:55.59,0:50:59.26,Default,,0,0,0,,Оның алдына шығып кетсең өлтіретініңді білдің ғой, солай ма?
Dialogue: 0,0:50:59.51,0:51:02.35,Default,,0,0,0,,...
Dialogue: 0,0:51:04.77,0:51:06.52,Default,,0,0,0,,Ештеңе жоқ
Dialogue: 0,0:51:07.27,0:51:09.10,Default,,0,0,0,,Себебі мен көмектескім келді
Dialogue: 0,0:51:09.85,0:51:13.90,Default,,0,0,0,,Мен мұны әдеттен тыс деп ойладым, бірақ қазір мен сенімдімін.
Dialogue: 0,0:51:15.36,0:51:17.94,Default,,0,0,0,,Ширудың өмір жолы өте бұрмаланған.
Dialogue: 0,0:51:18.95,0:51:22.41,Default,,0,0,0,,Өзіңнің өміріңнен гөрі өзгенің өмірі маңызды деп ойлау дұрыс емес.
Dialogue: 0,0:51:22.87,0:51:25.79,Default,,0,0,0,,Адам өзін бірінші орынға қоюы керек
Dialogue: 0,0:51:25.95,0:51:29.66,Default,,0,0,0,,Біріншіден, сізде бар нәрсе - бұл өлшеуге болмайтын ерекше жағдай.
Dialogue: 0,0:51:29.96,0:51:32.67,Default,,0,0,0,,Бұл шкаланың өзі, былайша айтқанда.
Dialogue: 0,0:51:33.13,0:51:36.80,Default,,0,0,0,,Бірақ сіз таразыны сындырдыңыз...
Dialogue: 0,0:51:36.96,0:51:38.47,Default,,0,0,0,,Басқаларға көмектесуге тырысу
Dialogue: 0,0:51:38.76,0:51:39.97,Default,,0,0,0,,Тохсака…
Dialogue: 0,0:51:41.05,0:51:42.47,Default,,0,0,0,,Сізде өзіңіз жоқ.
Dialogue: 0,0:51:42.64,0:51:45.43,Default,,0,0,0,,Егер сіз жай ғана өмір сүргіңіз келетін адам болсаңыз, бұл жақсы.
Dialogue: 0,0:51:45.64,0:51:48.39,Default,,0,0,0,,Бірақ Ширудың өз тұлғасы бар.
Dialogue: 0,0:51:48.73,0:51:50.85,Default,,0,0,0,,Менің өзімді сезінуім соншалықты күшті болса да
Dialogue: 0,0:51:51.02,0:51:52.98,Default,,0,0,0,,Өзіңізге немқұрайлы қарауға қалай батылыңыз бар?
Dialogue: 0,0:51:53.15,0:51:56.69,Default,,0,0,0,,Осылай істей берсең, ол бір күні міндетті түрде бұзылады.
Dialogue: 0,0:51:57.65,0:51:59.11,Default,,0,0,0,,Мен оның сынғанына сене алмаймын ...
Dialogue: 0,0:51:59.36,0:52:01.49,Default,,0,0,0,,Керісінше, мұның алдын алу үшін
Dialogue: 0,0:52:01.70,0:52:04.70,Default,,0,0,0,,Жоқ, ол жеткілікті түрде сынған.
Dialogue: 0,0:52:05.66,0:52:07.37,Default,,0,0,0,,Мен не болғанын білмеймін
Dialogue: 0,0:52:07.87,0:52:09.41,Default,,0,0,0,,Бірақ айтыңызшы.
Dialogue: 0,0:52:09.58,0:52:12.75,Default,,0,0,0,,Сондықтан болар, жынды болдыңыз.
Dialogue: 0,0:52:13.79,0:52:15.67,Default,,0,0,0,,Мен мектепте оқып жүргенде де солай болды.
Dialogue: 0,0:52:16.71,0:52:18.67,Default,,0,0,0,,Сіз барлық өлі денелерді көрдіңіз ...
Dialogue: 0,0:52:18.84,0:52:21.51,Default,,0,0,0,,Ол сабырлы ғана емес, оны көріп үйренгенін айтты.
Dialogue: 0,0:52:22.51,0:52:25.93,Default,,0,0,0,,Сіз бұрын соншалықты көп көрдіңіз, солай емес пе?
Dialogue: 0,0:52:26.76,0:52:28.18,Default,,0,0,0,,Мен үйреніп қалғанмын...
Dialogue: 0,0:52:29.60,0:52:32.85,Default,,0,0,0,,А, мен оны бірінші рет көргенім жоқ.
Dialogue: 0,0:52:33.19,0:52:35.65,Default,,0,0,0,,Бірақ... жоқ, жоқ.
Dialogue: 0,0:52:36.02,0:52:38.86,Default,,0,0,0,,10 жыл бұрынғы өрт мені құтқарды.
Dialogue: 0,0:52:39.03,0:52:42.24,Default,,0,0,0,,Тохсаканы кінәлауға болмайды.
Dialogue: 0,0:52:43.82,0:52:47.03,Default,,0,0,0,,Жоқ, Тохсака, мен жаңа ғана құтқарылдым.
Dialogue: 0,0:52:47.99,0:52:49.45,Default,,0,0,0,,Сізге көмектесті ме?
Dialogue: 0,0:53:01.67,0:53:04.38,Default,,0,0,0,,Ол кезде мен өлімді мойындадым.
Dialogue: 0,0:53:04.97,0:53:07.05,Default,,0,0,0,,Мен өлемін деп ойладым
Dialogue: 0,0:53:07.60,0:53:11.06,Default,,0,0,0,,Осындай күйде менің денем аман қалғанда...
Dialogue: 0,0:53:11.31,0:53:13.56,Default,,0,0,0,,Тіпті жүректің де қайта тірілуіне жол жоқ.
Dialogue: 0,0:53:14.06,0:53:16.40,Default,,0,0,0,,Ол кезде мен бос едім...
Dialogue: 0,0:53:17.15,0:53:20.57,Default,,0,0,0,,Сіз қымбат нәрсеге сүйсінген жоқсыз ба?
Dialogue: 0,0:53:23.95,0:53:27.28,Default,,0,0,0,,Мен жалғыз құтқарылғандықтан солай ойладым.
Dialogue: 0,0:53:29.20,0:53:31.75,Default,,0,0,0,,Көмек көрсету мүмкін болмағандардың орнына -
Dialogue: 0,0:53:31.91,0:53:35.71,Default,,0,0,0,,Мен барлығына көмектесуім керек.
Dialogue: 0,0:53:37.00,0:53:39.75,Default,,0,0,0,,Құтқарылған болсаң, өзіңді сақта!
Dialogue: 0,0:53:40.17,0:53:42.76,Default,,0,0,0,,Егер сіз кездейсоқ құтқарылсаңыз...
Dialogue: 0,0:53:42.92,0:53:45.13,Default,,0,0,0,,Бақытты болыңыз
Dialogue: 0,0:53:45.30,0:53:47.26,Default,,0,0,0,,Егер сіз осыншама қиындықты бастан өткерсеңіз...
Dialogue: 0,0:53:47.43,0:53:50.60,Default,,0,0,0,,Енді мен бақыттымын деуім керек, бұл өтірік! ?
Dialogue: 0,0:53:56.14,0:53:58.15,Default,,0,0,0,,Рахмет сізге Тохсака
Dialogue: 0,0:53:58.52,0:54:01.69,Default,,0,0,0,,Мен қате істеп жатқаныма сенімдімін.
Dialogue: 0,0:54:02.28,0:54:03.49,Default,,0,0,0,,Бірақ бәрібір.
Dialogue: 0,0:54:04.86,0:54:07.78,Default,,0,0,0,,Біреуге көмектескім келетін жалғыз нәрсе...
Dialogue: 0,0:54:07.95,0:54:10.49,Default,,0,0,0,,Бұл дұрыс емес
Dialogue: 0,0:54:18.17,0:54:20.29,Default,,0,0,0,,Болмауы керек 8-ші адам
Dialogue: 0,0:54:21.21,0:54:24.13,Default,,0,0,0,,Қалай қарасаң да бар қызметші емес.
Dialogue: 0,0:54:24.30,0:54:27.26,Default,,0,0,0,,Неліктен оның Синдзимен келісімшарты бар екені де жұмбақ.
Dialogue: 0,0:54:27.43,0:54:29.47,Default,,0,0,0,,Біріншіден, бұл құюшы.
Dialogue: 0,0:54:29.64,0:54:32.47,Default,,0,0,0,,Ол мұны істеп жатқанда да, ол күш жинайды.
Dialogue: 0,0:54:34.22,0:54:35.35,Default,,0,0,0,,Иә.
Dialogue: 0,0:54:35.64,0:54:36.81,Default,,0,0,0,,Иә
Dialogue: 0,0:54:37.14,0:54:40.11,Default,,0,0,0,,Балалар, мұны жалғыз орындау мүмкін емес.
Dialogue: 0,0:54:47.86,0:54:48.78,Default,,0,0,0,,Лансер!
Dialogue: 0,0:54:49.16,0:54:51.07,Default,,0,0,0,,Күте тұрыңыз, менің ұрысқым келмейді.
Dialogue: 0,0:54:51.24,0:54:51.91,Default,,0,0,0,,Не?
Dialogue: 0,0:54:52.83,0:54:55.75,Default,,0,0,0,,Мен сізге аздап көмектесуге тырысамын.
Dialogue: 0,0:54:55.91,0:54:57.00,Default,,0,0,0,,Анықтама?
Dialogue: 0,0:54:57.25,0:54:59.79,Default,,0,0,0,,Бұл сіздің идеяңыз ба? Немесе...
Dialogue: 0,0:54:59.96,0:55:01.67,Default,,0,0,0,,Шебердің нұсқаулары.
Dialogue: 0,0:55:02.04,0:55:06.34,Default,,0,0,0,,Кастер күшін арттырып, серіктесті қалайды.
Dialogue: 0,0:55:06.84,0:55:11.34,Default,,0,0,0,,Жарайды...оларды жоймайынша бұл біртұтас майдан.
Dialogue: 0,0:55:17.43,0:55:20.56,Default,,0,0,0,,Мен келісемін Эмия-кун ше?
Dialogue: 0,0:55:21.81,0:55:24.36,Default,,0,0,0,,Мен саған бірден сенемін деп ойлайсың ба?
Dialogue: 0,0:55:24.52,0:55:25.73,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:55:25.90,0:55:28.65,Default,,0,0,0,,Сіздің қызметкеріңіз жақсы әйел.
Dialogue: 0,0:55:28.86,0:55:30.86,Default,,0,0,0,,Жақсы әйел қол ұшын береді.
Dialogue: 0,0:55:31.36,0:55:34.16,Default,,0,0,0,,Сіз де бір нәрсені ұнататын мейірімді адамсыз, солай ма?
Dialogue: 0,0:55:41.46,0:55:45.71,Default,,0,0,0,,Мен сізге бірден айтамын, бұл Ширу маған қайтарып берген кулон.
Dialogue: 0,0:55:46.30,0:55:48.72,Default,,0,0,0,,Оның біреуі ғана.
Dialogue: 0,0:55:49.38,0:55:52.14,Default,,0,0,0,,Ширу менің бөлмемнен тауып алған кулон...
Dialogue: 0,0:55:52.39,0:55:54.72,Default,,0,0,0,,Арчер оны маған қайтарып берді.
Dialogue: 0,0:55:55.35,0:55:59.98,Default,,0,0,0,,Мен оны міндетті түрде алып, маған берді деп ойладым.
Dialogue: 0,0:56:16.79,0:56:19.50,Default,,0,0,0,,Бұл сіз туралы. Мен сенің келетініңді білдім.
Dialogue: 0,0:56:21.92,0:56:22.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:56:23.67,0:56:27.88,Default,,0,0,0,,Сіз кездесіп отырған адам менмін.
Dialogue: 0,0:56:28.59,0:56:33.93,Default,,0,0,0,,Хмф, сіз бірнеше күннің ішінде жаңа қызметшімен келісім-шарт жасадыңыз ба?
Dialogue: 0,0:56:34.84,0:56:35.97,Default,,0,0,0,,Барыңыз
Dialogue: 0,0:56:36.89,0:56:38.60,Default,,0,0,0,,Уау! Алақай!
Dialogue: 0,0:56:45.56,0:56:47.44,Default,,0,0,0,,(Широу мен Риннің тыныс алуы)
Dialogue: 0,0:57:25.40,0:57:29.15,Default,,0,0,0,,Түсінбедім, сен шынымен садақшысың ба?
Dialogue: 0,0:57:31.40,0:57:33.99,Default,,0,0,0,,Бұл керемет шеберлік, бірақ...
Dialogue: 0,0:57:35.28,0:57:40.91,Default,,0,0,0,,Сіздің қылышыңызда мақтаныш жоқ!
Dialogue: 0,0:57:42.29,0:57:45.17,Default,,0,0,0,,Өкінішке орай, менде мақтаныш жоқ.
Dialogue: 0,0:57:50.13,0:57:53.51,Default,,0,0,0,,Мен қылышымның сүйегімін.
Dialogue: 0,0:57:55.51,0:57:57.76,Default,,0,0,0,,Жоооу!
Dialogue: 0,0:57:58.30,0:58:00.60,Default,,0,0,0,,Геборг!
Dialogue: 0,0:58:01.68,0:58:02.93,Default,,0,0,0,,Аия!
Dialogue: 0,0:58:06.14,0:58:07.31,Default,,0,0,0,,Фууун!
Dialogue: 0,0:58:13.36,0:58:14.36,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:58:15.20,0:58:19.32,Default,,0,0,0,,Бұл дүниеде Аяксты тесетін найза бар ма?
Dialogue: 0,0:58:20.53,0:58:22.66,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:58:23.16,0:58:24.58,Default,,0,0,0,,Жай садақшы
Dialogue: 0,0:58:24.95,0:58:26.29,Default,,0,0,0,,Қат!
Dialogue: 0,0:58:26.54,0:58:29.75,Default,,0,0,0,,Садақшының асыл фантазмдардан қорғайтын қалқаны бар ма?
Dialogue: 0,0:58:30.21,0:58:32.30,Default,,0,0,0,,Сіз бұл туралы көбірек білесіз бе?
Dialogue: 0,0:58:35.13,0:58:38.89,Default,,0,0,0,,Кастер, мен күткеннен де қиынға түскен сияқтысың.
Dialogue: 0,0:58:44.18,0:58:48.02,Default,,0,0,0,,Цк, теме, сен басынан солайсың ба?
Dialogue: 0,0:59:05.66,0:59:06.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:59:08.75,0:59:09.54,Default,,0,0,0,,Уау!
Dialogue: 0,0:59:09.96,0:59:10.58,Default,,0,0,0,,Мен...
Dialogue: 0,0:59:13.55,0:59:14.38,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:59:21.30,0:59:22.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:59:25.77,0:59:26.85,Default,,0,0,0,,Уау!
Dialogue: 0,0:59:30.77,0:59:32.19,Default,,0,0,0,,(Риннің айқайы)
Dialogue: 0,0:59:41.07,0:59:42.66,Default,,0,0,0,,Бақылау қосулы
Dialogue: 0,0:59:46.37,0:59:47.33,Default,,0,0,0,,Уф!
Dialogue: 0,0:59:47.91,0:59:48.58,Default,,0,0,0,,О!
Dialogue: 0,0:59:49.21,0:59:52.46,Default,,0,0,0,,(Кастердің ыңырсыуы)
Dialogue: 0,0:59:53.13,0:59:54.59,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,1:00:00.80,1:00:04.30,Default,,0,0,0,,Соичиро...
Dialogue: 0,1:00:06.10,1:00:07.31,Default,,0,0,0,,Кастер
Dialogue: 0,1:00:21.20,1:00:22.57,Default,,0,0,0,,О!
Dialogue: 0,1:00:23.78,1:00:25.33,Default,,0,0,0,,А... а...
Dialogue: 0,1:00:34.54,1:00:35.59,Default,,0,0,0,,Садақшы
Dialogue: 0,1:00:36.00,1:00:38.50,Default,,0,0,0,,Мүмкін деп ойладым
Dialogue: 0,1:00:38.76,1:00:40.01,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:00:43.68,1:00:44.89,Default,,0,0,0,,Сабер!
Dialogue: 0,1:00:48.77,1:00:49.81,Default,,0,0,0,,Сабер!
Dialogue: 0,1:00:53.02,1:00:54.65,Default,,0,0,0,,Ширу...
Dialogue: 0,1:00:59.03,1:01:00.23,Default,,0,0,0,,Сіз оны жойдыңыз ба?
Dialogue: 0,1:01:02.86,1:01:04.16,Default,,0,0,0,,Қандай ақша?
Dialogue: 0,1:01:10.37,1:01:14.00,Default,,0,0,0,,Мен тек өз мақсаттарым үшін әрекет етемін
Dialogue: 0,1:01:14.96,1:01:16.71,Default,,0,0,0,,Сіз әлі де Шируды өлтіруді жоспарлап жүрсіз бе?
Dialogue: 0,1:01:19.05,1:01:20.71,Default,,0,0,0,,Тоқта, Арчер.
Dialogue: 0,1:01:21.30,1:01:24.47,Default,,0,0,0,,Егер сіз сол денемен бірдеңе жасасаңыз, ол бірден жоғалады.
Dialogue: 0,1:01:24.93,1:01:27.89,Default,,0,0,0,,Мен оны қорғауға, оның қылышына айналуға ант бердім.
Dialogue: 0,1:01:29.39,1:01:30.39,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:01:30.81,1:01:32.85,Default,,0,0,0,,Олай болса, осында жоғалып кет!
Dialogue: 0,1:01:34.85,1:01:35.40,Default,,0,0,0,,Аһ!
Dialogue: 0,1:01:44.65,1:01:45.86,Default,,0,0,0,,О, бұл…
Dialogue: 0,1:01:47.78,1:01:48.83,Default,,0,0,0,,Уау!
Dialogue: 0,1:01:49.41,1:01:50.91,Default,,0,0,0,,Ах! аа!
Dialogue: 0,1:01:55.75,1:01:57.13,Default,,0,0,0,,Бақылау қосулы
Dialogue: 0,1:01:58.54,1:02:01.17,Default,,0,0,0,,Жарамсыз сиқыр сізді құртады
Dialogue: 0,1:02:02.00,1:02:05.09,Default,,0,0,0,,Осы уақытқа дейін сізді тірі қалдырған ғажайыптың бағасы ...
Dialogue: 0,1:02:05.76,1:02:07.89,Default,,0,0,0,,Енді осында төлеу керек.
Dialogue: 0,1:02:10.10,1:02:11.60,Default,,0,0,0,,Иә! (Широу) Ха!
Dialogue: 0,1:02:15.60,1:02:17.02,Default,,0,0,0,,Уау!
Dialogue: 0,1:02:17.73,1:02:19.52,Default,,0,0,0,,Бұл сіздің шегіңіз!
Dialogue: 0,1:02:19.77,1:02:20.77,Default,,0,0,0,,айт
Dialogue: 0,1:02:22.02,1:02:25.78,Default,,0,0,0,,Тәнің менікі, тағдырым сенің қылышың.
Dialogue: 0,1:02:26.03,1:02:27.86,Default,,0,0,0,,Қасиетті Граил жағына сәйкес -
Dialogue: 0,1:02:28.07,1:02:30.91,Default,,0,0,0,,Осы мағынаны, осы қағиданы ұстансаң, жауап бер.
Dialogue: 0,1:02:31.20,1:02:34.79,Default,,0,0,0,,Міне, менің антым: Мен мәңгілікке жақсылық жасаймын.
Dialogue: 0,1:02:34.95,1:02:37.33,Default,,0,0,0,,Мәңгілік дүниенің бар жамандығын тарататын менмін.
Dialogue: 0,1:02:37.50,1:02:41.59,Default,,0,0,0,,Тоқтау сақинасынан кел, үш ұлы сөздің рухын киген жеті аспан.
Dialogue: 0,1:02:41.75,1:02:43.05,Default,,0,0,0,,Таразыны сақтаушы
Dialogue: 0,1:02:43.71,1:02:48.22,Default,,0,0,0,,Менің артымнан жүр, онда бұл тағдырды қылышыңа тапсыр.
Dialogue: 0,1:02:55.98,1:02:58.64,Default,,0,0,0,,Сабер атына берілген ант қабылдаңыз
Dialogue: 0,1:02:59.69,1:03:02.65,Default,,0,0,0,,Мен сізді Рин мырзам ретінде қабылдаймын
Dialogue: 0,1:03:19.58,1:03:22.92,Default,,0,0,0,,Қалай ойлайсың, сенің қазір менімен жеңу мүмкіндігің бар ма?
Dialogue: 0,1:03:23.38,1:03:24.63,Default,,0,0,0,,Хмф! Қанекей мынаны істейік!
Dialogue: 0,1:03:27.51,1:03:28.51,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:03:32.43,1:03:33.26,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,1:03:35.10,1:03:38.35,Default,,0,0,0,,Мен асыл фантасманы бұрын қолданғанмын, сондықтан менің сиқырлы күшім төмен болуы керек.
Dialogue: 0,1:03:38.77,1:03:41.69,Default,,0,0,0,,Шебер жоқ енді не істей аласың?
Dialogue: 0,1:03:43.02,1:03:44.52,Default,,0,0,0,,Садақшының қызметшісі -
Dialogue: 0,1:03:44.69,1:03:47.19,Default,,0,0,0,,Қожайыннан айырылсаң да, екі күн аман қалуың мүмкін.
Dialogue: 0,1:03:47.57,1:03:49.95,Default,,0,0,0,,Баланы өлтіруге жеткілікті.
Dialogue: 0,1:03:50.24,1:03:53.66,Default,,0,0,0,,Неліктен... неге мұндай нәтижені қалайсыз?
Dialogue: 0,1:03:54.37,1:03:56.12,Default,,0,0,0,,Сіздің үмітіңіз қате.
Dialogue: 0,1:03:56.58,1:03:58.87,Default,,0,0,0,,Сіз мұны істесеңіз де, сіз...
Dialogue: 0,1:03:59.29,1:04:02.46,Default,,0,0,0,,Қанша уақыт жалған үмітпен жүрсің?
Dialogue: 0,1:04:04.13,1:04:04.79,Default,,0,0,0,,Аһ!
Dialogue: 0,1:04:09.17,1:04:12.05,Default,,0,0,0,,Мен қылышымның сүйегімін.
Dialogue: 0,1:04:13.14,1:04:13.97,Default,,0,0,0,,Тоқта
Dialogue: 0,1:04:14.43,1:04:18.22,Default,,0,0,0,,Өлімге дейін белгісіз. Өмірге де белгісіз.
Dialogue: 0,1:04:19.89,1:04:23.23,Default,,0,0,0,,Пышақтың шексіз жұмысы.
Dialogue: 0,1:04:27.15,1:04:28.23,Default,,0,0,0,,Қалай болғанда да, бастайық!
Dialogue: 0,1:04:49.92,1:04:51.59,Default,,0,0,0,,Бірегей тосқауыл?
Dialogue: 0,1:04:51.92,1:04:54.01,Default,,0,0,0,,Психикалық пейзажды бейнелеу-
Dialogue: 0,1:04:54.43,1:04:57.05,Default,,0,0,0,,Шындықты бұзатын үлкен тыйым салынған заклинание
Dialogue: 0,1:04:57.43,1:05:00.02,Default,,0,0,0,,Менде бар нәрсе – осы дүние.
Dialogue: 0,1:05:00.73,1:05:04.44,Default,,0,0,0,,Егер бұл қару болса, оны қарап шығу арқылы көшіріп, сақтаңыз.
Dialogue: 0,1:05:05.48,1:05:08.27,Default,,0,0,0,,Бұл менің батырлық рух ретіндегі қабілетім.
Dialogue: 0,1:05:08.94,1:05:11.69,Default,,0,0,0,,Бұл сіздің әлеміңіз деп айтасыз ба?
Dialogue: 0,1:05:12.32,1:05:15.57,Default,,0,0,0,,Қасиетті қылышыңды сынауға қарсы емеспін.
Dialogue: 0,1:05:15.95,1:05:17.78,Default,,0,0,0,,Оны қайта шығаруды қамтамасыз етейік
Dialogue: 0,1:05:18.49,1:05:20.29,Default,,0,0,0,,Сіз оның шын мәнінде не екенін білесіз бе?
Dialogue: 0,1:05:20.58,1:05:23.75,Default,,0,0,0,,Ондай нәрсеге келгенде, мінсіз көшірме жасау мүмкін емес...
Dialogue: 0,1:05:23.92,1:05:25.79,Default,,0,0,0,,Шындыққа жақындауға болады
Dialogue: 0,1:05:25.96,1:05:27.21,Default,,0,0,0,,Ах!
Dialogue: 0,1:05:39.85,1:05:40.56,Default,,0,0,0,,Хмф!
Dialogue: 0,1:05:44.89,1:05:45.65,Default,,0,0,0,,Ширу Жоқ!
Dialogue: 0,1:05:55.24,1:05:58.07,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,1:06:01.04,1:06:04.96,Default,,0,0,0,,Қалжыңдамаңыз! О, менің!
Dialogue: 0,1:06:13.38,1:06:17.18,Default,,0,0,0,,(Широудың ыңырануы)
Dialogue: 0,1:06:22.22,1:06:24.48,Default,,0,0,0,,Эй... не істеп жатырсың!
Dialogue: 0,1:06:24.98,1:06:27.48,Default,,0,0,0,,Мені жібер, ақымақ!
Dialogue: 0,1:06:34.32,1:06:35.11,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,1:06:36.03,1:06:38.20,Default,,0,0,0,,Енді кедергі болмайтын жерде.
Dialogue: 0,1:06:39.20,1:06:40.70,Default,,0,0,0,,Ринмен не істеуді жоспарлайсыз?
Dialogue: 0,1:06:40.87,1:06:42.20,Default,,0,0,0,,Айырбастау шарттары
Dialogue: 0,1:06:43.24,1:06:45.96,Default,,0,0,0,,Анау баланың мені қуудан басқа амалы жоқ.
Dialogue: 0,1:06:46.41,1:06:48.83,Default,,0,0,0,,Сонымен қатар, Рин сіздің қожайыныңыз.
Dialogue: 0,1:06:49.67,1:06:52.29,Default,,0,0,0,,Баланы қанша қорғауға тырыссаң да...
Dialogue: 0,1:06:52.55,1:06:54.76,Default,,0,0,0,,Ұстаз өмірінің орны толмас
Dialogue: 0,1:06:57.13,1:07:00.97,Default,,0,0,0,,Қала маңындағы орманды Эйнцберн сарайы
Dialogue: 0,1:07:01.30,1:07:03.60,Default,,0,0,0,,Онда ешқандай кедергі жоқ
Dialogue: 0,1:07:03.76,1:07:04.89,Default,,0,0,0,,Ширу
Dialogue: 0,1:07:05.73,1:07:07.64,Default,,0,0,0,,Мен сіздің шағымдарыңызды сонда тыңдаймын.
Dialogue: 0,1:07:08.85,1:07:12.52,Default,,0,0,0,,Оның орнына Тохсакаға хабарласып көріңіз.
Dialogue: 0,1:07:12.90,1:07:15.07,Default,,0,0,0,,Тіпті Сабердің көмегімен...
Dialogue: 0,1:07:16.03,1:07:18.07,Default,,0,0,0,,Мен сені өлтіремін!
Dialogue: 0,1:07:20.24,1:07:21.07,Default,,0,0,0,,Хмф!
Dialogue: 0,1:07:30.75,1:07:32.42,Default,,0,0,0,,Іс бітті ме? монах
Dialogue: 0,1:07:35.00,1:07:35.76,Default,,0,0,0,,Бұл галлюцинация ма? Карстың қолы тышқанға айналып кетті…
Dialogue: 0,1:07:35.92,1:07:37.17,Default,,0,0,0,,Жоқ, өмірден бас тартпа
Dialogue: 0,1:07:37.34,1:07:39.93,Default,,0,0,0,,Бұл жігіт бізге көмектесті.
Dialogue: 0,1:07:40.09,1:07:40.80,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:41.55,1:07:43.68,Default,,0,0,0,,Әй, қыз, не болды?
Dialogue: 0,1:07:46.27,1:07:48.10,Default,,0,0,0,,Арчер ұрлап әкетті
Dialogue: 0,1:07:48.27,1:07:49.27,Default,,0,0,0,,Не?
Dialogue: 0,1:07:56.40,1:07:57.03,Default,,0,0,0,,Ах!
Dialogue: 0,1:08:01.03,1:08:01.95,Default,,0,0,0,,Садақшы
Dialogue: 0,1:08:02.95,1:08:05.91,Default,,0,0,0,,Шируды өлтіргіңіз келетініне сенімдісіз бе?
Dialogue: 0,1:08:06.12,1:08:10.79,Default,,0,0,0,,Әй, мұндай тәтті адам қазір жоғалып кетуі керек.
Dialogue: 0,1:08:13.25,1:08:15.21,Default,,0,0,0,,Мен оның тәтті екенін білемін
Dialogue: 0,1:08:16.21,1:08:20.88,Default,,0,0,0,,Бірақ оның тәтті жағы сүйкімді деп ойлаймын.
Dialogue: 0,1:08:21.30,1:08:23.72,Default,,0,0,0,,Ол осындай болуы керек.
Dialogue: 0,1:08:24.26,1:08:28.02,Default,,0,0,0,,Мен мұндай адамның болғаны дұрыс деп ойласам, өзімді құтқарылғандай сезінемін.
Dialogue: 0,1:08:34.48,1:08:36.82,Default,,0,0,0,,Йо Тохсака
Dialogue: 0,1:08:36.98,1:08:38.11,Default,,0,0,0,,Синдзи!
Dialogue: 0,1:08:41.15,1:08:42.57,Default,,0,0,0,,Бұл не, Арчер?
Dialogue: 0,1:08:42.99,1:08:46.33,Default,,0,0,0,,Хаха Менің Гильгамешімді қарашы, сен бычақсың ба?
Dialogue: 0,1:08:46.66,1:08:47.95,Default,,0,0,0,,Сіз Ринді мақсат етіп отырсыз ба?
Dialogue: 0,1:08:48.24,1:08:49.62,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,1:08:49.83,1:08:52.83,Default,,0,0,0,,Әйтпесе, бұлай көгерген сарайға кім келеді?
Dialogue: 0,1:08:53.00,1:08:56.59,Default,,0,0,0,,Содан кейін мен Ширу Эмияны аяқтағанша күте тұрыңыз.
Dialogue: 0,1:08:57.09,1:08:59.42,Default,,0,0,0,,Мен оны орындағаннан кейін беремін.
Dialogue: 0,1:09:00.30,1:09:02.13,Default,,0,0,0,,Егер сіз оны ести алмасаңыз
Dialogue: 0,1:09:03.09,1:09:06.35,Default,,0,0,0,,Хмф, бұл күлкілі, сайқымазақ.
Dialogue: 0,1:09:08.01,1:09:09.52,Default,,0,0,0,,Жақсы.
Dialogue: 0,1:09:09.77,1:09:12.35,Default,,0,0,0,,Арчерді жалғыз қалдырсаңыз, ол бәрібір жоғалады.
Dialogue: 0,1:09:12.98,1:09:14.44,Default,,0,0,0,,Жалған
Dialogue: 0,1:09:16.06,1:09:17.36,Default,,0,0,0,,Ихихихихи
Dialogue: 0,1:09:17.69,1:09:20.11,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,1:09:29.24,1:09:30.16,Default,,0,0,0,,(Серо) «Өте жылдам адам» деген лақап ат тек сән үшін ғана емес қой?
Dialogue: 0,1:09:31.12,1:09:32.87,Default,,0,0,0,,Тохсақа не болды? ?
Dialogue: 0,1:09:33.33,1:09:38.17,Default,,0,0,0,,Сіз кешіккендіктен, мен оны бірінші келген Синдзиге бердім.
Dialogue: 0,1:09:38.42,1:09:39.63,Default,,0,0,0,,Асықпаңыз
Dialogue: 0,1:09:39.96,1:09:42.88,Default,,0,0,0,,Бастапқыда мен сол жас ханымның өліп қалмауын ойладым...
Dialogue: 0,1:09:43.05,1:09:44.84,Default,,0,0,0,,Бұл менің қожайынымның бұйрығы.
Dialogue: 0,1:09:55.64,1:09:58.61,Default,,0,0,0,,Бізде дәл осындай кулондар болды.
Dialogue: 0,1:10:01.53,1:10:05.49,Default,,0,0,0,,Бірақ бастапқыда бұл кулонның біреуі ғана бар.
Dialogue: 0,1:10:06.24,1:10:07.24,Default,,0,0,0,,Иә.
Dialogue: 0,1:10:07.49,1:10:11.20,Default,,0,0,0,,Міне, менің өмірімді сақтап қалған сен, өмір бойы өзіңмен бірге алып жүрдің.
Dialogue: 0,1:10:12.08,1:10:15.87,Default,,0,0,0,,Рин Тохсаканың әкесінен қалған ерекше естелік.
Dialogue: 0,1:10:17.42,1:10:18.38,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:10:19.04,1:10:20.75,Default,,0,0,0,,Сіздің шын есіміңіз кім?
Dialogue: 0,1:10:22.55,1:10:24.26,Default,,0,0,0,,Батырлық рух Эмия
Dialogue: 0,1:10:25.22,1:10:27.18,Default,,0,0,0,,Бұл сіздің шын есіміңіз
Dialogue: 0,1:10:28.68,1:10:30.01,Default,,0,0,0,,Ширу идеалдары
Dialogue: 0,1:10:30.35,1:10:33.35,Default,,0,0,0,,Батыр болған сен емес пе?
Dialogue: 0,1:10:33.72,1:10:37.23,Default,,0,0,0,,Бірақ неге сені өлтіретіндей әрекет жасадың?
Dialogue: 0,1:10:37.60,1:10:41.19,Default,,0,0,0,,Расында, мен идеалдалған батырлық рухқа айналдым.
Dialogue: 0,1:10:41.82,1:10:46.45,Default,,0,0,0,,Мен бір кездері адамдарды құтқарып, әлемді дағдарыстан құтқардым.
Dialogue: 0,1:10:51.28,1:10:56.29,Default,,0,0,0,,Бірақ мен ең соңында өкінгенім болды.
Dialogue: 0,1:10:57.41,1:11:00.29,Default,,0,0,0,,Өлім ғана қалды.
Dialogue: 0,1:11:00.63,1:11:02.96,Default,,0,0,0,,Өлім... тек қана?
Dialogue: 0,1:11:03.42,1:11:06.55,Default,,0,0,0,,Мүмкіндігінше көп адамдарды құтқару үшін-
Dialogue: 0,1:11:06.76,1:11:09.97,Default,,0,0,0,,Өлді, өлтірілді, өлтірілді
Dialogue: 0,1:11:10.59,1:11:14.89,Default,,0,0,0,,Менің идеалдарымды жүзеге асыру үшін көптеген адамдарды өлтіру ...
Dialogue: 0,1:11:15.27,1:11:18.39,Default,,0,0,0,,Мен өлтіргеннен мың есе көп адамдарды құтқардым.
Dialogue: 0,1:11:19.10,1:11:22.98,Default,,0,0,0,,Мен мұны қанша рет қайталағанымды білмеймін.
Dialogue: 0,1:11:23.15,1:11:24.15,Default,,0,0,0,,Сабер
Dialogue: 0,1:11:24.94,1:11:28.32,Default,,0,0,0,,Менің бұл шеңберден құтылудың жолы жоқ.
Dialogue: 0,1:11:29.15,1:11:32.57,Default,,0,0,0,,Иә, бір қоспағанда
Dialogue: 0,1:11:33.08,1:11:34.08,Default,,0,0,0,,Сіз...
Dialogue: 0,1:11:34.74,1:11:36.25,Default,,0,0,0,,Сіз өкінесіз бе?
Dialogue: 0,1:11:36.66,1:11:37.66,Default,,0,0,0,,Әрине
Dialogue: 0,1:11:37.96,1:11:42.79,Default,,0,0,0,,Мен... Жоқ, батырлық рухқа айналмау керек еді.
Dialogue: 0,1:11:43.00,1:11:45.71,Default,,0,0,0,,Сонда біз басқа адамдармыз.
Dialogue: 0,1:11:45.88,1:11:47.67,Default,,0,0,0,,Мен еш өкінбеймін
Dialogue: 0,1:11:47.88,1:11:50.43,Default,,0,0,0,,Сондықтан да мен сені танымаймын!
Dialogue: 0,1:11:50.59,1:11:53.68,Default,,0,0,0,,Жалған мұраттарды өз қолыммен талқандаймын!
Dialogue: 0,1:11:54.10,1:11:55.85,Default,,0,0,0,,Сіз түсінген сияқтысыз.
Dialogue: 0,1:11:56.60,1:12:00.52,Default,,0,0,0,,Менімен соғысу – қылыш жасауға жарысу.
Dialogue: 0,1:12:02.52,1:12:05.86,Default,,0,0,0,,Мен қылышымның сүйегімін.
Dialogue: 0,1:12:16.62,1:12:18.29,Default,,0,0,0,,Бақылау!
Dialogue: 0,1:12:25.04,1:12:26.88,Default,,0,0,0,,Иә! (Широу) Яаааа!
Dialogue: 0,1:12:29.34,1:12:30.63,Default,,0,0,0,,Синдзи!
Dialogue: 0,1:12:30.80,1:12:32.26,Default,,0,0,0,,(Шинджидің күлуі)
Dialogue: 0,1:12:32.68,1:12:34.68,Default,,0,0,0,,Уф! Арх! Апыр-ай!
Dialogue: 0,1:12:35.55,1:12:36.56,Default,,0,0,0,,Лансер!
Dialogue: 0,1:12:36.89,1:12:38.06,Default,,0,0,0,,Қозғалмай отырыңыз
Dialogue: 0,1:12:39.22,1:12:40.89,Default,,0,0,0,,Міне, Лансер.
Dialogue: 0,1:12:41.56,1:12:42.48,Default,,0,0,0,,Не?
Dialogue: 0,1:12:46.69,1:12:47.69,Default,,0,0,0,,Кирей!
Dialogue: 0,1:12:47.94,1:12:49.40,Default,,0,0,0,,Ол әлі тірі ме?
Dialogue: 0,1:12:49.69,1:12:53.70,Default,,0,0,0,,Қожайыным көрінбейді деген сенімім емес пе?
Dialogue: 0,1:12:53.86,1:12:56.24,Default,,0,0,0,,Тәртіпті бұзған сенсің.
Dialogue: 0,1:12:56.58,1:12:59.75,Default,,0,0,0,,Ол Арчерді жоюға бұйрық беруі керек еді.
Dialogue: 0,1:13:00.25,1:13:02.58,Default,,0,0,0,,Оны жалғыз қалдырсаңыз да, ол өзін-өзі құртады.
Dialogue: 0,1:13:02.75,1:13:06.75,Default,,0,0,0,,Оның үстіне бұл бала сіздің ақшаңыз ба?
Dialogue: 0,1:13:07.17,1:13:09.17,Default,,0,0,0,,Мен адамдарды нашар естимін.
Dialogue: 0,1:13:09.42,1:13:11.63,Default,,0,0,0,,Біз онымен ынтымақтастық қарым-қатынастамыз.
Dialogue: 0,1:13:12.01,1:13:16.35,Default,,0,0,0,,Біз Қасиетті Граильді алу үшін бірге жұмыс істеуге келістік.
Dialogue: 0,1:13:16.51,1:13:17.68,Default,,0,0,0,,Есе әке!
Dialogue: 0,1:13:17.93,1:13:19.72,Default,,0,0,0,,Бұл әйелді не істеуіміз керек?
Dialogue: 0,1:13:19.89,1:13:22.39,Default,,0,0,0,,Оқушыма көмектескім келеді дегенім өтірік болды ма?
Dialogue: 0,1:13:22.60,1:13:25.90,Default,,0,0,0,,Бұл өтірік пе? Бұл маңызды бөлік.
Dialogue: 0,1:13:26.19,1:13:28.73,Default,,0,0,0,,Оңай зейнетке шықсаң жалықпайды
Dialogue: 0,1:13:28.90,1:13:31.32,Default,,0,0,0,,Сондықтан мені қорғауыңызды өтіндім.
Dialogue: 0,1:13:31.86,1:13:34.45,Default,,0,0,0,,Ата-ана махаббаты үшін бұл жеткілікті.
Dialogue: 0,1:13:36.53,1:13:38.08,Default,,0,0,0,,Одан құтылыңыз
Dialogue: 0,1:13:39.28,1:13:42.45,Default,,0,0,0,,Егер мұны істегенімді қаласаңыз, пәрмен емлесін пайдалануға болады.
Dialogue: 0,1:13:42.96,1:13:44.54,Default,,0,0,0,,Мен сізге бұйрық берейін.
Dialogue: 0,1:13:44.79,1:13:46.25,Default,,0,0,0,,Өзіңді өлтір, Лансер.
Dialogue: 0,1:13:54.13,1:13:56.34,Default,,0,0,0,,(Лансердің ыңырсыуы)
Dialogue: 0,1:13:56.59,1:13:57.72,Default,,0,0,0,,Лансер!
Dialogue: 0,1:13:57.89,1:13:59.76,Default,,0,0,0,,(Лансердің ыңырсыуы)
Dialogue: 0,1:13:59.93,1:14:04.64,Default,,0,0,0,,Котомине! Мен... Са... Маа! !
Dialogue: 0,1:14:15.11,1:14:17.99,Default,,0,0,0,,Рин, сен де өлуің керек.
Dialogue: 0,1:14:21.03,1:14:21.83,Default,,0,0,0,,Уф...
Dialogue: 0,1:14:24.71,1:14:25.58,Default,,0,0,0,,(түтіксіз соққы дыбысы)
Dialogue: 0,1:14:27.17,1:14:30.13,Default,,0,0,0,,(Кирейдің ыңырануы)
Dialogue: 0,1:14:35.63,1:14:36.47,Default,,0,0,0,,Ах!
Dialogue: 0,1:14:37.01,1:14:38.59,Default,,0,0,0,,Сен... Сен!
Dialogue: 0,1:14:39.64,1:14:42.43,Default,,0,0,0,,Егер мен осылай былдырлайтын болсам, мен...
Dialogue: 0,1:14:42.85,1:14:46.85,Default,,0,0,0,,Батыр болма!
Dialogue: 0,1:14:51.77,1:14:53.28,Default,,0,0,0,,Уф... аа...
Dialogue: 0,1:14:58.66,1:15:04.24,Default,,0,0,0,,(Шинджидің күлуі)
Dialogue: 0,1:15:10.17,1:15:13.38,Default,,0,0,0,,Ха ха ақымақтар! Бір-біріңді өлтіруге еркін болыңдар
Dialogue: 0,1:15:13.71,1:15:16.63,Default,,0,0,0,,«Қасиетті Граил сенікі» деген не?
Dialogue: 0,1:15:16.80,1:15:19.51,Default,,0,0,0,,(Шинджидің күлуі)
Dialogue: 0,1:15:27.89,1:15:30.44,Default,,0,0,0,,Қасиетті Граил қазірдің өзінде...
Dialogue: 0,1:15:34.82,1:15:36.40,Default,,0,0,0,,Бұл менікі!
Dialogue: 0,1:15:36.74,1:15:40.07,Default,,0,0,0,,Сіздің көзқарасыңызға байланысты біз оны бөлуге болады.
Dialogue: 0,1:15:40.24,1:15:41.03,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,1:15:41.20,1:15:43.62,Default,,0,0,0,,Маған жағымпаздануға тырыс, Тохсақа
Dialogue: 0,1:15:45.16,1:15:48.54,Default,,0,0,0,,Ол қол тигізетін әйел емес.
Dialogue: 0,1:15:49.54,1:15:50.75,Default,,0,0,0,,Сен әлі тірісің бе?
Dialogue: 0,1:15:51.29,1:15:52.92,Default,,0,0,0,,Жоғалтып алмаңыз!
Dialogue: 0,1:15:53.38,1:15:54.21,Default,,0,0,0,,Уау!
Dialogue: 0,1:15:56.84,1:15:59.68,Default,,0,0,0,,(Шинджидің үрейлі дауысы)
Dialogue: 0,1:16:04.76,1:16:05.60,Default,,0,0,0,,Лансер
Dialogue: 0,1:16:11.44,1:16:13.11,Default,,0,0,0,,Жараны жабу керек!
Dialogue: 0,1:16:13.81,1:16:16.78,Default,,0,0,0,,Геборг жойған жүрек емделмейді.
Dialogue: 0,1:16:29.54,1:16:30.58,Default,,0,0,0,,Уууууууу!!
Dialogue: 0,1:16:41.09,1:16:42.47,Default,,0,0,0,,Қош бол Лансер
Dialogue: 0,1:16:43.89,1:16:45.60,Default,,0,0,0,,Аз уақытқа болса да...
Dialogue: 0,1:16:46.10,1:16:48.72,Default,,0,0,0,,Маған сен сияқты адамдар ұнайды.
Dialogue: 0,1:16:48.89,1:16:50.64,Default,,0,0,0,,Ха! Кішкентай қыз
Dialogue: 0,1:16:52.48,1:16:55.48,Default,,0,0,0,,Кішкене есейгенде қайт.
Dialogue: 0,1:17:09.29,1:17:12.62,Default,,0,0,0,,Уау!
Dialogue: 0,1:17:16.96,1:17:17.75,Default,,0,0,0,,Ах!
Dialogue: 0,1:17:18.50,1:17:23.26,Default,,0,0,0,,Сенің қылышың мен менің қылышым бірдей деп ойладың ба?
Dialogue: 0,1:17:24.64,1:17:27.80,Default,,0,0,0,,Сіз әлі де негіздерді нашар түсінесіз.
Dialogue: 0,1:17:27.97,1:17:30.14,Default,,0,0,0,,Шулы! ! !
Dialogue: 0,1:18:17.65,1:18:20.23,Default,,0,0,0,,Сіз оны қазір көруіңіз керек еді.
Dialogue: 0,1:18:20.40,1:18:22.40,Default,,0,0,0,,Болашақты күтіп тұрған шындық
Dialogue: 0,1:18:23.19,1:18:26.41,Default,,0,0,0,,Өмір бойы түкке тұрғысыз мұратқа жабысқан жалған.
Dialogue: 0,1:18:27.49,1:18:30.41,Default,,0,0,0,,Сіз кім екеніңізді түсіндіңіз бе?
Dialogue: 0,1:18:36.71,1:18:39.67,Default,,0,0,0,,Бұл! ! !
Dialogue: 0,1:18:43.42,1:18:45.51,Default,,0,0,0,,Сіз шынымен батыр болғыңыз келе ме?
Dialogue: 0,1:18:45.92,1:18:47.76,Default,,0,0,0,,Мен болғым келмейді
Dialogue: 0,1:18:48.01,1:18:49.43,Default,,0,0,0,,Бұл міндетті түрде болады!
Dialogue: 0,1:18:49.68,1:18:51.05,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,1:18:51.22,1:18:55.31,Default,,0,0,0,,Өйткені бұл сізде бар жалғыз сезім.
Dialogue: 0,1:18:55.60,1:18:56.64,Default,,0,0,0,,Не!
Dialogue: 0,1:18:57.02,1:18:59.56,Default,,0,0,0,,Сіз маған жаңа ғана сүйсіндіңіз.
Dialogue: 0,1:19:01.02,1:19:05.49,Default,,0,0,0,,Сізді құтқарған адам өте бақытты көрінді...
Dialogue: 0,1:19:05.74,1:19:08.03,Default,,0,0,0,,Мен де солай болғым келді.
Dialogue: 0,1:19:08.24,1:19:10.78,Default,,0,0,0,,Сіздің идеалдарыңыз тек қарызға алынған нәрселер.
Dialogue: 0,1:19:10.95,1:19:11.99,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:19:15.29,1:19:18.46,Default,,0,0,0,,Менің денем біреу үшін болуы керек.
Dialogue: 0,1:19:18.62,1:19:20.79,Default,,0,0,0,,Мен құмарлықтың жетегінде кеттім.
Dialogue: 0,1:19:21.00,1:19:24.80,Default,,0,0,0,,Мен тіпті сәтсіздікке ұшырағанын түсінбедім, жүгіре бердім.
Dialogue: 0,1:19:25.46,1:19:29.13,Default,,0,0,0,,Әркім бақытты болсын деген тілек – ертегі.
Dialogue: 0,1:19:29.72,1:19:32.47,Default,,0,0,0,,Осындай арманмен ғана өмір сүре алсаң...
Dialogue: 0,1:19:32.64,1:19:34.31,Default,,0,0,0,,Мені ұстап тұрып суға батып кет!
Dialogue: 0,1:19:41.73,1:19:42.81,Default,,0,0,0,,Дене...
Dialogue: 0,1:19:43.65,1:19:45.94,Default,,0,0,0,,Денесі қылыштан жасалған
Dialogue: 0,1:19:46.32,1:19:48.11,Default,,0,0,0,,Сіз әлі де...
Dialogue: 0,1:19:48.82,1:19:50.57,Default,,0,0,0,,Мен сенен жеңілмеймін
Dialogue: 0,1:19:51.07,1:19:53.62,Default,,0,0,0,,Біреуден жеңілген дұрыс, бірақ...
Dialogue: 0,1:19:53.91,1:19:55.62,Default,,0,0,0,,Мен өзімнен жеңіле алмаймын!
Dialogue: 0,1:19:57.29,1:19:58.08,Default,,0,0,0,,Бұл жігіт
Dialogue: 0,1:20:01.83,1:20:03.63,Default,,0,0,0,,...бірдеңе емес
Dialogue: 0,1:20:06.42,1:20:10.68,Default,,0,0,0,,Орындалмайтынын біле тұра тырысуды жалғастыру ақымақтық
Dialogue: 0,1:20:11.18,1:20:13.22,Default,,0,0,0,,Бұл қате емес!
Dialogue: 0,1:20:19.68,1:20:22.48,Default,,0,0,0,,(Садақшы мен Ширудың айқайы)
Dialogue: 0,1:20:26.53,1:20:29.03,Default,,0,0,0,,Бұл менің қателігім болса керек.
Dialogue: 0,1:20:29.24,1:20:32.20,Default,,0,0,0,,Бұл қате емес!
Dialogue: 0,1:20:35.03,1:20:37.58,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,1:20:40.25,1:20:42.67,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,1:20:48.55,1:20:50.26,Default,,0,0,0,,(түтіксіз соққы дыбысы)
Dialogue: 0,1:21:00.52,1:21:03.48,Default,,0,0,0,,Мен жеңдім, Садақшы.
Dialogue: 0,1:21:04.56,1:21:07.15,Default,,0,0,0,,О, және-
Dialogue: 0,1:21:07.65,1:21:09.48,Default,,0,0,0,,Бұл менің жеңілісім.
Dialogue: 0,1:21:17.53,1:21:21.58,Default,,0,0,0,,Болашақта не күтіп тұрса да, өкінбеймін.
Dialogue: 0,1:21:21.75,1:21:23.75,Default,,0,0,0,,Мен жеңемін
Dialogue: 0,1:21:24.04,1:21:25.75,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,1:21:26.08,1:21:28.25,Default,,0,0,0,,Өтпесең өтірік
Dialogue: 0,1:21:30.42,1:21:32.42,Default,,0,0,0,,Маған ұнады.
Dialogue: 0,1:21:32.76,1:21:36.76,Default,,0,0,0,,Бұл фейктер арасындағы нағыз ақымақ шайқас болды.
Dialogue: 0,1:21:38.18,1:21:39.60,Default,,0,0,0,,Уф! Қарғыс атсын!
Dialogue: 0,1:21:39.76,1:21:40.68,Default,,0,0,0,,Уау!
Dialogue: 0,1:21:43.77,1:21:46.94,Default,,0,0,0,,(Садақшының ыңырсыуы)
Dialogue: 0,1:21:52.86,1:21:56.95,Default,,0,0,0,,Түсіндіңіз бе? Бұл нағыз салмақ
Dialogue: 0,1:21:57.12,1:22:00.12,Default,,0,0,0,,Жалған заттар тез қоқысқа айналуы керек.
Dialogue: 0,1:22:04.41,1:22:06.96,Default,,0,0,0,,(Садақшының ыңырсыуы)
Dialogue: 0,1:22:07.96,1:22:08.96,Default,,0,0,0,,Садақшы!
Dialogue: 0,1:22:09.88,1:22:11.13,Default,,0,0,0,,Сіз оны жеңесіз
Dialogue: 0,1:22:11.63,1:22:13.47,Default,,0,0,0,,Сіз жеңе аласыз
Dialogue: 0,1:22:24.14,1:22:26.98,Default,,0,0,0,,Бұл! менің садақшым!
Dialogue: 0,1:22:31.19,1:22:31.98,Default,,0,0,0,,Төмен түсіңіз
Dialogue: 0,1:22:38.66,1:22:40.03,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,1:22:40.53,1:22:41.41,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:46.67,1:22:48.50,Default,,0,0,0,,шаңмен ластаныңыз
Dialogue: 0,1:22:49.29,1:22:51.59,Default,,0,0,0,,Өміріңді сақтап қалдың, маскүнем.
Dialogue: 0,1:22:52.25,1:22:53.46,Default,,0,0,0,,Сіз қашып бара жатырсыз ба?
Dialogue: 0,1:22:53.67,1:22:56.51,Default,,0,0,0,,Біз Қасиетті Граилдың аяқталуын тездетуіміз керек.
Dialogue: 0,1:22:56.84,1:23:00.51,Default,,0,0,0,,Егер мен ақшамды жоғалтып алсам және ол асып кетсе, онда сіз...
Dialogue: 0,1:23:00.72,1:23:03.31,Default,,0,0,0,,Себебі мен сенің не істеріңді білмеймін.
Dialogue: 0,1:23:10.86,1:23:14.11,Default,,0,0,0,,Ол Людонг храмындағы Қасиетті Граалды аяқтамақ.
Dialogue: 0,1:23:14.28,1:23:15.78,Default,,0,0,0,,Бұл шабуыл туралы.
Dialogue: 0,1:23:15.94,1:23:18.36,Default,,0,0,0,,Гильгамешті тау қақпасының алдында тоқтатасың.
Dialogue: 0,1:23:18.53,1:23:20.82,Default,,0,0,0,,Ширу екеуміз арт жақтан айналамыз.
Dialogue: 0,1:23:21.03,1:23:23.79,Default,,0,0,0,,Күте тұрыңыз, Сейбер онымен күресуде қолайсыз жағдайға жетті.
Dialogue: 0,1:23:25.20,1:23:26.20,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:23:26.54,1:23:28.79,Default,,0,0,0,,Оның күші соғыстың өзі.
Dialogue: 0,1:23:29.62,1:23:32.21,Default,,0,0,0,,Бірдей күш болмаса, онымен күресуге болмайды.
Dialogue: 0,1:23:32.38,1:23:33.96,Default,,0,0,0,,Сонда кім?
Dialogue: 0,1:23:37.01,1:23:38.84,Default,,0,0,0,,Бір түрдегі өкілеттіктер…
Dialogue: 0,1:23:39.38,1:23:40.39,Default,,0,0,0,,Оның қарсыласы...
Dialogue: 0,1:23:40.55,1:23:42.18,Default,,0,0,0,,Сіз мұны істеймін дейсіз бе?
Dialogue: 0,1:23:43.43,1:23:45.27,Default,,0,0,0,,Бұған қарсы тұра алатын күш...
Dialogue: 0,1:23:45.43,1:23:47.98,Default,,0,0,0,,Тек Арчер пайдаланатын бірегей кедергі
Dialogue: 0,1:23:48.14,1:23:51.65,Default,,0,0,0,,Бірақ бұл үшін орасан зор сиқырлы күш қажет.
Dialogue: 0,1:23:51.90,1:23:53.61,Default,,0,0,0,,Сіз өзіңіз үшін өтей алмайтын нәрсе -
Dialogue: 0,1:23:53.77,1:23:56.74,Default,,0,0,0,,Сиқыршы - оны басқа жерден әкелетін адам.
Dialogue: 0,1:24:00.57,1:24:02.24,Default,,0,0,0,,Ах... сондықтан...
Dialogue: 0,1:24:04.37,1:24:05.54,Default,,0,0,0,,Мен бар күшімді салып, сол екі команданың ұпайларын жұлып аламын!
Dialogue: 0,1:24:07.33,1:24:08.20,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:09.37,1:24:16.05,Default,,0,0,0,,(Шинджидің жөтел дауысы)
Dialogue: 0,1:24:17.01,1:24:18.51,Default,,0,0,0,,Сөзсіз
Dialogue: 0,1:24:18.67,1:24:20.76,Default,,0,0,0,,Мен де сенімен жақсымын.
Dialogue: 0,1:24:23.60,1:24:24.51,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,1:24:29.52,1:24:30.94,Default,,0,0,0,,… …
Dialogue: 0,1:24:31.52,1:24:34.27,Default,,0,0,0,,Сіз Қасиетті Граильді алғыңыз келді, солай ма?
Dialogue: 0,1:24:34.44,1:24:36.48,Default,,0,0,0,,(Гильгамештің күлкісі)
Dialogue: 0,1:24:39.86,1:24:41.95,Default,,0,0,0,,Бұл маңызды қасиетті тас.
Dialogue: 0,1:24:44.62,1:24:47.12,Default,,0,0,0,,Енді ешқашан жіберме
Dialogue: 0,1:24:47.29,1:24:49.16,Default,,0,0,0,,(Гильгамештің күлкісі)
Dialogue: 0,1:24:57.71,1:25:02.47,Default,,0,0,0,,Тохсаканың сиқырлы мөрін ауыстыруға болады ма?
Dialogue: 0,1:25:02.93,1:25:04.76,Default,,0,0,0,,Басқа амал жоқ
Dialogue: 0,1:25:05.10,1:25:08.81,Default,,0,0,0,,Егер сіз табысқа жетсеңіз, бірегей кедергіні меңгеру үшін сізде сиқырлы күш жеткілікті болады.
Dialogue: 0,1:25:08.97,1:25:11.14,Default,,0,0,0,,Мен Шируды жеткізе аламын.
Dialogue: 0,1:25:11.73,1:25:13.14,Default,,0,0,0,,Ойыңызды шоғырландырыңыз
Dialogue: 0,1:25:13.73,1:25:14.77,Default,,0,0,0,,бастайық
Dialogue: 0,1:25:19.82,1:25:22.03,Default,,0,0,0,,Хиоку шақыруы
Dialogue: 0,1:25:22.28,1:25:23.66,Default,,0,0,0,,Гравюраны бақылау
Dialogue: 0,1:25:23.99,1:25:26.83,Default,,0,0,0,,1-ші 16-шы тоқтата тұру
Dialogue: 0,1:25:27.16,1:25:31.41,Default,,0,0,0,,Шарт құрастыру 1 2 3
Dialogue: 0,1:25:31.58,1:25:34.17,Default,,0,0,0,,4 5 6
Dialogue: 0,1:25:34.46,1:25:37.67,Default,,0,0,0,,Санақсыз, кіші, үлкен
Dialogue: 0,1:25:37.92,1:25:42.01,Default,,0,0,0,,Үлкен және кіші Хиоку шығу тегі
Dialogue: 0,1:25:44.68,1:25:45.51,Default,,0,0,0,,Ах...
Dialogue: 0,1:26:28.85,1:26:30.81,Default,,0,0,0,,Сәтті болды ма?
Dialogue: 0,1:26:32.39,1:26:34.64,Default,,0,0,0,,Қалғаны сіздің күш-жігеріңізге байланысты.
Dialogue: 0,1:26:34.81,1:26:37.56,Default,,0,0,0,,А, рахмет, Тохсака.
Dialogue: 0,1:26:38.40,1:26:39.31,Default,,0,0,0,,Тохсака?
Dialogue: 0,1:26:41.57,1:26:43.07,Default,,0,0,0,,Адамның жады...
Dialogue: 0,1:26:44.65,1:26:45.57,Default,,0,0,0,,Көрдіңіз бе?
Dialogue: 0,1:26:45.74,1:26:47.57,Default,,0,0,0,,Иә? мм...
Dialogue: 0,1:26:50.49,1:26:52.91,Default,,0,0,0,,Бұл! Кедамо жоқ!
Dialogue: 0,1:26:54.08,1:26:58.83,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:27:19.19,1:27:20.86,Default,,0,0,0,,Мен сені күттім, Сабыр.
Dialogue: 0,1:27:22.11,1:27:22.86,Default,,0,0,0,,Ассасин!
Dialogue: 0,1:27:24.23,1:27:26.61,Default,,0,0,0,,Енді сізді шақырған кастер жоғалып кетті...
Dialogue: 0,1:27:27.28,1:27:29.74,Default,,0,0,0,,Оның бұл жерде қалуы мүмкін емес.
Dialogue: 0,1:27:30.32,1:27:32.12,Default,,0,0,0,,Қанша сиқыршы болса да...
Dialogue: 0,1:27:32.78,1:27:36.37,Default,,0,0,0,,Мазмұны жоқ қызметші қызметшіні асырай алмайды.
Dialogue: 0,1:27:37.58,1:27:42.46,Default,,0,0,0,,Сол жылқы мені шақырып, құрбандыққа осы жерді таңдады.
Dialogue: 0,1:27:43.13,1:27:44.67,Default,,0,0,0,,Сондықтан, мен-
Dialogue: 0,1:27:45.05,1:27:47.63,Default,,0,0,0,,Осы Санмон бар болғанша, ол ешқашан жоғалмайды.
Dialogue: 0,1:27:54.76,1:27:56.47,Default,,0,0,0,,Таң атқанша жүрме
Dialogue: 0,1:27:57.14,1:28:01.10,Default,,0,0,0,,Осы уақытқа дейін төтеп бере алғанымыз бір бақыт.
Dialogue: 0,1:28:03.48,1:28:06.61,Default,,0,0,0,,Сонда менімен күресу керек пе?
Dialogue: 0,1:28:07.44,1:28:09.65,Default,,0,0,0,,Әуелден бұл дене гүлдей түседі.
Dialogue: 0,1:28:10.11,1:28:13.37,Default,,0,0,0,,Егер сіз соңына жете алсаңыз ...
Dialogue: 0,1:28:14.49,1:28:16.04,Default,,0,0,0,,Бұдан артық перде болмайды.
Dialogue: 0,1:28:24.17,1:28:25.00,Default,,0,0,0,,Ах!
Dialogue: 0,1:28:25.42,1:28:26.75,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:28:30.43,1:28:33.09,Default,,0,0,0,,Бұл Қасиетті Граил ма?
Dialogue: 0,1:28:34.10,1:28:37.93,Default,,0,0,0,,Бұл әлі болуы керек емес, бірақ ол жарылып кету алдында тұр.
Dialogue: 0,1:28:43.69,1:28:44.36,Default,,0,0,0,,Ах...
Dialogue: 0,1:28:44.77,1:28:47.44,Default,,0,0,0,,Сол үмітсіз жүзді қайта көремін деп ойламаппын.
Dialogue: 0,1:28:47.94,1:28:48.94,Default,,0,0,0,,Гильгамеш!
Dialogue: 0,1:28:49.19,1:28:50.15,Default,,0,0,0,,Өтірік…
Dialogue: 0,1:28:51.20,1:28:54.03,Default,,0,0,0,,Сонда Сабер кіммен соғысып жатыр?
Dialogue: 0,1:28:57.45,1:28:59.70,Default,,0,0,0,,Сол піллә жұмыртқадан шығады
Dialogue: 0,1:29:03.21,1:29:07.21,Default,,0,0,0,,Жалғыз мен ғана бақылап тұрсам, бұл жалғыз болуы керек.
Dialogue: 0,1:29:08.21,1:29:12.22,Default,,0,0,0,,Қорқыныш болуды шешіп, не болатынын көрсеңіз...
Dialogue: 0,1:29:12.55,1:29:14.97,Default,,0,0,0,,Сіздің әділдігіңіздің де мәні бар.
Dialogue: 0,1:29:15.51,1:29:18.35,Default,,0,0,0,,көремін. Кешіріңіз, бірақ бұл...
Dialogue: 0,1:29:18.51,1:29:21.10,Default,,0,0,0,,Мен сіздің Қасиетті Граильді дәл қазір тоқтатамын!
Dialogue: 0,1:29:21.48,1:29:22.73,Default,,0,0,0,,Кішкентай қыз
Dialogue: 0,1:29:22.89,1:29:24.56,Default,,0,0,0,,Кімнен рұқсат алдың?
Dialogue: 0,1:29:24.98,1:29:26.31,Default,,0,0,0,,Бақылау!
Dialogue: 0,1:29:26.90,1:29:27.69,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,1:29:33.57,1:29:34.74,Default,,0,0,0,,Сен Кираны асып өлтіремін дедің, ал қазір оны өлтірді деп айтып тұрсың ба? Дәл осыны айтқың келе ме?
Dialogue: 0,1:29:47.25,1:29:48.25,Default,,0,0,0,,Уф!
Dialogue: 0,1:29:53.26,1:29:54.51,Default,,0,0,0,,Сіз!
Dialogue: 0,1:30:02.93,1:30:04.06,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,1:30:05.02,1:30:07.77,Default,,0,0,0,,Сора Сора! Демалуға уақыт жоқ
Dialogue: 0,1:30:09.02,1:30:10.11,Default,,0,0,0,,Уау! !
Dialogue: 0,1:30:14.45,1:30:16.70,Default,,0,0,0,,(Широудың тыныс алуы)
Dialogue: 0,1:30:17.74,1:30:18.91,Default,,0,0,0,,Иелік тәжірибесі
Dialogue: 0,1:30:20.79,1:30:22.58,Default,,0,0,0,,Процесс аяқталды
Dialogue: 0,1:30:25.29,1:30:27.38,Default,,0,0,0,,Барлық проекцияның күту режимі
Dialogue: 0,1:30:28.75,1:30:29.67,Default,,0,0,0,,Иә?
Dialogue: 0,1:30:30.21,1:30:33.46,Default,,0,0,0,,Менің барлық көрінетін пішіндерімді көшірдіңіз бе?
Dialogue: 0,1:30:34.17,1:30:35.88,Default,,0,0,0,,Тіпті ұпай жинауда...
Dialogue: 0,1:30:37.97,1:30:39.47,Default,,0,0,0,,Ерітуді тоқтатыңыз
Dialogue: 0,1:30:39.64,1:30:40.93,Default,,0,0,0,,...Жасай берейік!
Dialogue: 0,1:30:42.06,1:30:44.98,Default,,0,0,0,,Толық проекциялық үздіксіз қабат кескіні!
Dialogue: 0,1:30:51.23,1:30:51.98,Default,,0,0,0,,Ха!
Dialogue: 0,1:31:02.33,1:31:03.16,Default,,0,0,0,,Құпия қылыш...
Dialogue: 0,1:31:07.67,1:31:09.50,Default,,0,0,0,,Цубамегаэши!
Dialogue: 0,1:31:12.17,1:31:13.17,Default,,0,0,0,,Тааа!
Dialogue: 0,1:31:23.51,1:31:24.52,Default,,0,0,0,,Бару
Dialogue: 0,1:31:34.36,1:31:36.86,Default,,0,0,0,,Мен бұл әдемі кішкентай құс деп ойладым, бірақ...
Dialogue: 0,1:31:37.36,1:31:38.86,Default,,0,0,0,,Жеміс-
Dialogue: 0,1:31:39.32,1:31:41.70,Default,,0,0,0,,Арыстан сияқты болды ма?
Dialogue: 0,1:31:45.08,1:31:49.50,Default,,0,0,0,,Бұл жағдайда Арчер қалғаны жақсы болар еді.
Dialogue: 0,1:31:49.83,1:31:53.71,Default,,0,0,0,,Ол да жасанды, бірақ оның философиясы сұмдық емес еді.
Dialogue: 0,1:31:54.30,1:31:55.88,Default,,0,0,0,,Ол да осылай деді.
Dialogue: 0,1:31:56.05,1:31:58.22,Default,,0,0,0,,Сіздің идеологияңыз қарызға алынған.
Dialogue: 0,1:31:58.47,1:32:00.72,Default,,0,0,0,,Мен көремін.
Dialogue: 0,1:32:00.89,1:32:01.72,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:02.39,1:32:06.77,Default,,0,0,0,,Арманның соңында жатқанды жалған деп айтқан ол...
Dialogue: 0,1:32:06.93,1:32:09.98,Default,,0,0,0,,Менің ойымша, сіз бұл арманға соңына дейін берік болдыңыз.
Dialogue: 0,1:32:11.02,1:32:14.07,Default,,0,0,0,,Өйткені бұл менде бола алмайтын идеал...
Dialogue: 0,1:32:14.40,1:32:16.57,Default,,0,0,0,,Бағалылығына сүйсініп жыладым.
Dialogue: 0,1:32:19.57,1:32:21.49,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,1:32:21.66,1:32:25.24,Default,,0,0,0,,Қарызға алған мұрат болса да, соңына дейін ұстансаң
Dialogue: 0,1:32:26.24,1:32:26.99,Default,,0,0,0,,Ухммм… ммм…
Dialogue: 0,1:32:27.16,1:32:31.67,Default,,0,0,0,,Бұл өлімге әкелетін жарақат болуы керек еді, бірақ бала таңқаларлықтай табанды болды.
Dialogue: 0,1:32:32.25,1:32:33.54,Default,,0,0,0,,Жоғал!
Dialogue: 0,1:32:35.50,1:32:37.00,Default,,0,0,0,,Кетіңізші, Ширу!
Dialogue: 0,1:32:37.17,1:32:38.55,Default,,0,0,0,,(Ичи) Вице-канцлермен кездесуге әлі біраз уақыт бар, бірақ—
Dialogue: 0,1:32:39.42,1:32:40.26,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,1:32:42.01,1:32:43.09,Default,,0,0,0,,Қалғаны өзіме байланысты.
Dialogue: 0,1:32:43.26,1:32:45.93,Default,,0,0,0,,Жоқ, мен өзіме жетеді, Сабыр.
Dialogue: 0,1:32:46.10,1:32:46.76,Default,,0,0,0,,Ширу?
Dialogue: 0,1:32:47.27,1:32:50.60,Default,,0,0,0,,Оның орнына Тохсакадан Қасиетті Граалды тоқтатуды сұраңыз.
Dialogue: 0,1:32:56.02,1:32:56.94,Default,,0,0,0,,Шыгандшинаға баратын жолды іздеуге аттанған Зерттеу корпусы,
Dialogue: 0,1:32:58.44,1:33:00.19,Default,,0,0,0,,Сенің есі дұрыс па? Сіз
Dialogue: 0,1:33:00.78,1:33:05.37,Default,,0,0,0,,Егер сіз қызметшінің көмегіне сенбей, оның орнына кішкентай қызға көмектесетін болсаңыз ше?
Dialogue: 0,1:33:05.70,1:33:07.41,Default,,0,0,0,,Мен қате түсіндім
Dialogue: 0,1:33:07.58,1:33:10.79,Default,,0,0,0,,Менің қылыш жасауым қылыш жасау емес.
Dialogue: 0,1:33:11.04,1:33:14.21,Default,,0,0,0,,Бұл менің жүрегіме пішін беру туралы болды.
Dialogue: 0,1:33:15.63,1:33:18.25,Default,,0,0,0,,Мен қылышымның сүйегімін.
Dialogue: 0,1:33:21.30,1:33:22.63,Default,,0,0,0,,Не?
Dialogue: 0,1:33:23.47,1:33:25.01,Default,,0,0,0,,Менің жасағаным-
Dialogue: 0,1:33:26.80,1:33:28.14,Default,,0,0,0,,Шексіз
Dialogue: 0,1:33:29.77,1:33:30.81,Default,,0,0,0,,Қылыш-
Dialogue: 0,1:33:32.06,1:33:33.81,Default,,0,0,0,,Құрамындағы дүние
Dialogue: 0,1:33:35.15,1:33:36.48,Default,,0,0,0,,Ал «Біреу бәрі үшін» жоғалған соң, бұл біздің міндетіміз
Dialogue: 0,1:33:41.74,1:33:45.16,Default,,0,0,0,,Шексіз пышақ жұмысы!
Dialogue: 0,1:33:52.33,1:33:53.71,Default,,0,0,0,,Бірегей тосқауыл?
Dialogue: 0,1:33:54.08,1:33:56.17,Default,,0,0,0,,Бұлардың бәрі жалған!
Dialogue: 0,1:33:56.33,1:33:58.71,Default,,0,0,0,,Мен елеусізмін дейсің.
Dialogue: 0,1:33:58.88,1:33:59.67,Default,,0,0,0,,Мен сиқыр жасаймын.
Dialogue: 0,1:34:00.17,1:34:03.30,Default,,0,0,0,,Жалғанның шынайы нәрсемен бәсекелесе алмайтынына ешқандай себеп жоқ.
Dialogue: 0,1:34:03.84,1:34:05.55,Default,,0,0,0,,Кеттік, Батырлар патшасы
Dialogue: 0,1:34:05.76,1:34:07.68,Default,,0,0,0,,Қару-жарақ қоры жеткілікті ме?
Dialogue: 0,1:34:08.18,1:34:11.02,Default,,0,0,0,,Көңіліңді көтерме, әйтеуір!
Dialogue: 0,1:34:17.02,1:34:17.98,Default,,0,0,0,,Рин!
Dialogue: 0,1:34:18.48,1:34:20.98,Default,,0,0,0,,Жоқ! бұл балшыққа тиіспе
Dialogue: 0,1:34:22.28,1:34:22.99,Default,,0,0,0,,Бірақ...
Dialogue: 0,1:34:23.28,1:34:26.99,Default,,0,0,0,,Бұл жігіт оны жақында ойнай алады, бірақ оған дейін мен оны асыл фантазммен қиып аламын.
Dialogue: 0,1:34:27.20,1:34:30.70,Default,,0,0,0,,Тез, сыртқа шығайық.Тоғанға жеткен соң, қалғанын өзім жасаймын.
Dialogue: 0,1:34:33.37,1:34:34.21,Default,,0,0,0,,Уф...
Dialogue: 0,1:34:37.71,1:34:39.67,Default,,0,0,0,,Қарғыс атсын, бәрі...
Dialogue: 0,1:34:39.88,1:34:42.38,Default,,0,0,0,,Синдзи мен де сенен кешірім сұраймын.
Dialogue: 0,1:34:42.88,1:34:43.38,Default,,0,0,0,,Мен көмектесе алмаймын...
Dialogue: 0,1:34:43.55,1:34:44.63,Default,,0,0,0,,Жарайды, жүгір.
Dialogue: 0,1:34:45.55,1:34:48.30,Default,,0,0,0,,Мұндай ыңырсығанға ешкім құлақ аспайды.
Dialogue: 0,1:34:54.85,1:34:56.39,Default,,0,0,0,,(Риннің айқайы)
Dialogue: 0,1:35:08.70,1:35:10.57,Default,,0,0,0,,Сабер өтінемін!
Dialogue: 0,1:35:17.58,1:35:18.58,Default,,0,0,0,,Бұрынғы-
Dialogue: 0,1:35:21.09,1:35:23.21,Default,,0,0,0,,Калибур! ! !
Dialogue: 0,1:35:41.61,1:35:42.86,Default,,0,0,0,,Сабер! ! !
Dialogue: 0,1:36:04.00,1:36:04.84,Default,,0,0,0,,Ах...
Dialogue: 0,1:36:06.17,1:36:07.21,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,1:36:08.13,1:36:11.22,Default,,0,0,0,,Ол кетті, құнсыз әйел.
Dialogue: 0,1:36:18.39,1:36:20.98,Default,,0,0,0,,Сен... Сен!
Dialogue: 0,1:36:21.56,1:36:24.48,Default,,0,0,0,,Алып кетпе, балақай!
Dialogue: 0,1:36:35.33,1:36:39.91,Default,,0,0,0,,Ууууууууууу! ! !
Dialogue: 0,1:36:40.66,1:36:43.33,Default,,0,0,0,,Деяаааааааааааааааа!
Dialogue: 0,1:36:44.42,1:36:45.79,Default,,0,0,0,,Қарғыс атсын... ақымақ...
Dialogue: 0,1:36:46.46,1:36:48.13,Default,,0,0,0,,Ууууууу!
Dialogue: 0,1:36:51.80,1:36:53.30,Default,,0,0,0,,Бұл мен...
Dialogue: 0,1:36:56.93,1:37:00.27,Default,,0,0,0,,Осындай жалғандық!
Dialogue: 0,1:37:02.35,1:37:04.02,Default,,0,0,0,,Бар!
Dialogue: 0,1:37:04.23,1:37:07.78,Default,,0,0,0,,Сәлем! Кешіріңіз! Кешіріңіз! Кешіріңіз! Кешіріңіз!
Dialogue: 0,1:37:07.94,1:37:12.11,Default,,0,0,0,,Сәлем! Кешіріңіз! Кешіріңіз! Кешіріңіз! Кешіріңіз!
Dialogue: 0,1:37:12.70,1:37:13.95,Default,,0,0,0,,Сәлем! Кешіріңіз!
Dialogue: 0,1:37:14.20,1:37:15.37,Default,,0,0,0,,Сәлем! Кешіріңіз!
Dialogue: 0,1:37:21.37,1:37:23.37,Default,,0,0,0,,Маған рұқсат етіңіз!
Dialogue: 0,1:37:25.25,1:37:26.38,Default,,0,0,0,,Сәлем!
Dialogue: 0,1:37:34.13,1:37:36.76,Default,,0,0,0,,(Широудың айқайы)
Dialogue: 0,1:37:36.93,1:37:39.39,Default,,0,0,0,,Яаааааааааааа! !
Dialogue: 0,1:37:43.10,1:37:44.81,Default,,0,0,0,,Не?
Dialogue: 0,1:37:45.90,1:37:49.78,Default,,0,0,0,,(Гильгамештің айқайы)
Dialogue: 0,1:38:09.38,1:38:10.67,Default,,0,0,0,,Уф! Ах! Апыр-ай!
Dialogue: 0,1:38:12.76,1:38:15.18,Default,,0,0,0,,Tsk, бұл сәтсіз болды.
Dialogue: 0,1:38:15.34,1:38:18.14,Default,,0,0,0,,Қолдауын жоғалтып, маған қарай асығады деп ойлау.
Dialogue: 0,1:38:18.68,1:38:22.18,Default,,0,0,0,,Бір қызметшінің өзек бола алмайтынын түсінбейсің бе?
Dialogue: 0,1:38:27.06,1:38:29.77,Default,,0,0,0,,(Широудың ыңырануы)
Dialogue: 0,1:38:30.02,1:38:31.28,Default,,0,0,0,,Оңға жылжытыңыз
Dialogue: 0,1:38:36.61,1:38:37.53,Default,,0,0,0,,Ки…
Dialogue: 0,1:38:38.12,1:38:41.12,Default,,0,0,0,,Ки... Са... Ма...
Dialogue: 0,1:38:42.29,1:38:46.62,Default,,0,0,0,,Садақшы! ! !
Dialogue: 0,1:38:51.50,1:38:55.30,Default,,0,0,0,,(Широудың тыныс алуы)
Dialogue: 0,1:39:11.57,1:39:12.73,Default,,0,0,0,,Садақшы!
Dialogue: 0,1:39:17.32,1:39:18.49,Default,,0,0,0,,Садақшы
Dialogue: 0,1:39:19.07,1:39:21.49,Default,,0,0,0,,Менімен қайтадан келісім-шарт жаса
Dialogue: 0,1:39:23.41,1:39:24.91,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,1:39:25.58,1:39:27.83,Default,,0,0,0,,Менің ондай құқығым жоқ.
Dialogue: 0,1:39:28.00,1:39:30.67,Default,,0,0,0,,Оның енді мақсаты жоқ.
Dialogue: 0,1:39:31.92,1:39:34.00,Default,,0,0,0,,Менің шайқасым аяқталды.
Dialogue: 0,1:39:34.17,1:39:34.96,Default,,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,1:39:35.51,1:39:38.80,Default,,0,0,0,,Сонда қанша уақыт өтсе де...
Dialogue: 0,1:39:40.59,1:39:41.89,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,1:39:42.51,1:39:44.35,Default,,0,0,0,,Бұл дүниеде өкініш жоқ, бірақ
Dialogue: 0,1:39:45.81,1:39:47.85,Default,,0,0,0,,Рин, сұраңызшы
Dialogue: 0,1:39:48.10,1:39:50.52,Default,,0,0,0,,Өздеріңіз білетіндей, ол сенімсіз.
Dialogue: 0,1:39:51.86,1:39:53.15,Default,,0,0,0,,Садақшы
Dialogue: 0,1:40:01.28,1:40:02.99,Default,,0,0,0,,Мүмкін сіз, мырза, сөгіс естігенді ұнататын сол қиын мінезді жандардың бірісіз бе?
Dialogue: 0,1:40:03.33,1:40:04.70,Default,,0,0,0,,Мен бар күшімді саламын
Dialogue: 0,1:40:05.45,1:40:09.29,Default,,0,0,0,,Оның маған ғашық болуы үшін бар күшімді салатыныма сенімдімін.
Dialogue: 0,1:40:10.87,1:40:12.25,Default,,0,0,0,,Сонымен, сіз де
Dialogue: 0,1:40:14.55,1:40:15.96,Default,,0,0,0,,Мен жауапты алдым
Dialogue: 0,1:40:17.13,1:40:18.63,Default,,0,0,0,,Жарайды, Тохсака.
Dialogue: 0,1:40:18.97,1:40:21.72,Default,,0,0,0,,Мен де қазірден бастап бар күшімді саламын.
Dialogue: 0,1:40:26.14,1:40:26.97,Default,,0,0,0,,Ах...
Dialogue: 0,1:40:30.48,1:40:31.60,Default,,0,0,0,,Бұл ғұн.
Dialogue: 0,1:40:31.98,1:40:36.36,Default,,0,0,0,,Соңында мен шағымданбадым.
Dialogue: 0,1:40:52.50,1:40:54.25,Default,,0,0,0,,Кейде есіме түсіп кетеді
Dialogue: 0,1:40:54.59,1:40:56.50,Default,,0,0,0,,Темірдің қатты дыбысы
Dialogue: 0,1:40:58.84,1:41:03.43,Default,,0,0,0,,Алыстан тамылжыған қылышты қалай тартарымды білмедім
Dialogue: 0,1:41:06.26,1:41:09.35,Default,,0,0,0,,Біз бір-біріміздің сенімімізді талқыладық.
Dialogue: 0,1:41:12.44,1:41:15.69,Default,,0,0,0,,Өз тілегімді орындау үшін...
Dialogue: 0,1:41:15.86,1:41:18.28,Default,,0,0,0,,Өз мұратына қарсы
Dialogue: 0,1:41:20.86,1:41:22.74,Default,,0,0,0,,Нәтижелер әлі қол жетімді емес
Dialogue: 0,1:41:23.74,1:41:27.37,Default,,0,0,0,,Жауабын білгенше көп уақыт өтеді.
Dialogue: 0,1:41:43.30,1:41:48.31,Default,,0,0,0,,♪～
Dialogue: 0,1:44:36.35,1:44:41.35,Default,,0,0,0,,～♪
Dialogue: 0,1:44:47.19,1:44:51.24,Default,,0,0,0,,(қылыштың соқтығысқан дыбысы)
Dialogue: 0,1:44:52.41,1:44:56.24,Default,,0,0,0,,(қылыштың соқтығысқан дыбысы)
Dialogue: 0,1:45:12.51,1:45:17.72,Default,,0,0,0,,（）
