Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.59,0:00:09.13,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.21,0:00:12.47,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.55,0:00:14.76,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:17.01,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.10,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.60,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.31,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.40,0:00:28.69,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:33.57,0:00:36.41,Default,,0,0,0,,Жануар рухы! Cerbeus!
Dialogue: 0,0:00:36.61,0:00:38.24,Default,,0,0,0,,Бегемот!
Dialogue: 0,0:00:38.32,0:00:43.04,Default,,0,0,0,,Ааа!
Dialogue: 0,0:00:45.08,0:00:46.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:46.46,0:00:47.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:47.96,0:00:50.13,Default,,0,0,0,,Инуске де жеңді!
Dialogue: 0,0:00:50.21,0:00:52.17,Default,,0,0,0,,Үздік 8-і анықталды!
Dialogue: 0,0:00:53.26,0:00:54.80,Default,,0,0,0,,Келесі үшінші тур!
Dialogue: 0,0:00:54.97,0:00:57.09,Default,,0,0,0,,Инсуке Руиге қарсы ойнайды
Dialogue: 0,0:00:57.39,0:00:59.64,Default,,0,0,0,,Ал Шу - Уакия!
Dialogue: 0,0:01:07.85,0:01:10.23,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:10.57,0:01:15.74,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:27.04,0:01:30.42,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:30.92,0:01:33.05,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:33.46,0:01:37.59,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:37.72,0:01:40.93,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:01:41.05,0:01:47.48,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:01:47.77,0:01:52.19,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:01:52.69,0:01:58.11,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:01:58.24,0:02:00.49,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:00.57,0:02:05.29,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:05.45,0:02:10.54,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:10.83,0:02:13.09,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:13.29,0:02:15.63,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:15.92,0:02:19.84,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:20.01,0:02:25.01,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:25.22,0:02:27.39,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:31.27,0:02:33.94,Default,,0,0,0,,Спригган В.С.Виверн!
Dialogue: 0,0:02:35.15,0:02:36.28,Default,,0,0,0,,Әке!
Dialogue: 0,0:02:36.36,0:02:39.28,Default,,0,0,0,,Мен оны үздік 8-ге жеткіздім! Бұл керемет!
Dialogue: 0,0:02:39.40,0:02:40.91,Default,,0,0,0,,Сіздің арманыңыз қандай?
Dialogue: 0,0:02:41.03,0:02:43.74,Default,,0,0,0,,Әлемдегі ең жақсы Бейблейдер болу емес пе?
Dialogue: 0,0:02:43.83,0:02:45.58,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:02:45.66,0:02:47.50,Default,,0,0,0,,Қуануға әлі ерте!
Dialogue: 0,0:02:47.58,0:02:50.25,Default,,0,0,0,,Бәріміз бірге тойласақ та.
Dialogue: 0,0:02:50.33,0:02:51.83,Default,,0,0,0,,Менің ойымша, бұл дұрыс емес.
Dialogue: 0,0:02:51.92,0:02:54.38,Default,,0,0,0,,Дұрыс, ағаңды мақтаңдар~
Dialogue: 0,0:02:54.67,0:02:55.63,Default,,0,0,0,,Барт
Dialogue: 0,0:02:55.71,0:02:58.63,Default,,0,0,0,,Сіз Бэйді мақтау үшін ойнап жатқан жоқсыз, солай ма?
Dialogue: 0,0:02:58.76,0:02:59.67,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:59.80,0:03:00.72,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:03:00.80,0:03:02.93,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:03:03.22,0:03:04.47,Default,,0,0,0,,Жақсы айттыңыз!
Dialogue: 0,0:03:04.55,0:03:07.43,Default,,0,0,0,,Тыңда, берілме!
Dialogue: 0,0:03:07.68,0:03:09.52,Default,,0,0,0,,Мен білемін, әке!
Dialogue: 0,0:03:09.60,0:03:11.19,Default,,0,0,0,,Жарайсың, Бал-нии!
Dialogue: 0,0:03:11.35,0:03:13.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:15.94,0:03:17.19,Default,,0,0,0,,Комурасаки...
Dialogue: 0,0:03:17.48,0:03:19.90,Default,,0,0,0,,Мен вивернді анық көріп тұрмын.
Dialogue: 0,0:03:21.28,0:03:22.91,Default,,0,0,0,,Сізді қалай жеңуге болады?
Dialogue: 0,0:03:23.07,0:03:24.62,Default,,0,0,0,,Мен жақсы білемін!
Dialogue: 0,0:03:28.83,0:03:30.66,Default,,0,0,0,,Жүр!
Dialogue: 0,0:03:31.58,0:03:32.92,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:03:33.67,0:03:36.54,Default,,0,0,0,,Уау! (Макото Сасаки) Уау!
Dialogue: 0,0:03:38.42,0:03:40.05,Default,,0,0,0,,О...!
Dialogue: 0,0:03:40.26,0:03:41.80,Default,,0,0,0,,Сен күткендей, балам!
Dialogue: 0,0:03:42.34,0:03:45.35,Default,,0,0,0,,Осы жаңа техниканың көмегімен Шу хит болуы мүмкін!
Dialogue: 0,0:03:45.72,0:03:48.60,Default,,0,0,0,,Оған оңай болма.
Dialogue: 0,0:03:51.89,0:03:54.10,Default,,0,0,0,,Бір ғана күш пен шеберлік жеткіліксіз...
Dialogue: 0,0:03:54.90,0:03:56.98,Default,,0,0,0,,Ең бастысы - жеңістің бейнесі.
Dialogue: 0,0:03:59.11,0:04:00.32,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:04:01.57,0:04:02.86,Default,,0,0,0,,Хэхехе...
Dialogue: 0,0:04:02.95,0:04:04.57,Default,,0,0,0,,Бейне жаттығулары да тамаша!
Dialogue: 0,0:04:04.78,0:04:07.20,Default,,0,0,0,,Бум!
Dialogue: 0,0:04:07.66,0:04:10.08,Default,,0,0,0,,Реактивті ату!
Dialogue: 0,0:04:13.12,0:04:15.79,Default,,0,0,0,,...Не істеп жатырсың, ақымақ!
Dialogue: 0,0:04:15.88,0:04:17.92,Default,,0,0,0,,Арандатушылықты неге қабылдамайсың!
Dialogue: 0,0:04:18.50,0:04:21.26,Default,,0,0,0,,Бір… Жоқ…
Dialogue: 0,0:04:21.34,0:04:22.92,Default,,0,0,0,,Мен жеңілмеймін!
Dialogue: 0,0:04:23.01,0:04:24.68,Default,,0,0,0,,Келесі турнир –
Dialogue: 0,0:04:24.76,0:04:26.34,Default,,0,0,0,,Финалға міндетті түрде өтіңіз!
Dialogue: 0,0:04:26.43,0:04:30.47,Default,,0,0,0,,Уау~
Dialogue: 0,0:04:30.68,0:04:35.14,Default,,0,0,0,,Охх~
Dialogue: 0,0:04:36.15,0:04:37.94,Default,,0,0,0,,Олар қандай...
Dialogue: 0,0:04:40.23,0:04:46.36,Default,,0,0,0,,Уау~
Dialogue: 0,0:04:49.78,0:04:51.04,Default,,0,0,0,,Мақсат!
Dialogue: 0,0:04:51.12,0:04:53.66,Default,,0,0,0,,Мен ең жақсымын! Вай - ең жақсы!
Dialogue: 0,0:04:53.75,0:04:54.91,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:04:55.00,0:04:56.67,Default,,0,0,0,,Менің ойымша, бұл маған байланысты
Dialogue: 0,0:04:56.87,0:04:59.67,Default,,0,0,0,,(Дауыстар таласып жатыр)
Dialogue: 0,0:04:59.75,0:05:00.75,Default,,0,0,0,,Шу!
Dialogue: 0,0:05:01.55,0:05:03.09,Default,,0,0,0,,Кім үздік болды?
Dialogue: 0,0:05:03.17,0:05:03.97,Default,,0,0,0,,Бұл менмін, солай ма?
Dialogue: 0,0:05:04.05,0:05:04.55,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:04.63,0:05:05.26,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:05:05.34,0:05:06.18,Default,,0,0,0,,Бұл менмін!
Dialogue: 0,0:05:06.72,0:05:07.93,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:05:08.01,0:05:08.76,Default,,0,0,0,,…Сары тау
Dialogue: 0,0:05:08.85,0:05:11.26,Default,,0,0,0,,Шааа! (3 адам) Е...
Dialogue: 0,0:05:11.60,0:05:15.06,Default,,0,0,0,,Вакия! Эй, сен командадан кеткен жоқсың ба?
Dialogue: 0,0:05:15.14,0:05:16.19,Default,,0,0,0,,Бұл тітіркендіргіш!
Dialogue: 0,0:05:16.27,0:05:17.52,Default,,0,0,0,,Не деген сұмдық!
Dialogue: 0,0:05:17.60,0:05:18.52,Default,,0,0,0,,Хмф!
Dialogue: 0,0:05:18.60,0:05:21.61,Default,,0,0,0,,О, мен осылай сезінемін. Көп уақыт өтті.
Dialogue: 0,0:05:21.69,0:05:22.86,Default,,0,0,0,,"Дегенмен ол жүгірді."
Dialogue: 0,0:05:22.94,0:05:25.32,Default,,0,0,0,,Біз доспыз ғой!
Dialogue: 0,0:05:25.40,0:05:26.15,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:26.36,0:05:28.74,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:05:28.82,0:05:30.37,Default,,0,0,0,,Ұлдар мен қыздар
Dialogue: 0,0:05:30.45,0:05:32.49,Default,,0,0,0,,Бүгін тағы да Блэдерстің армандары
Dialogue: 0,0:05:32.58,0:05:34.66,Default,,0,0,0,,Менің ойым әр шығанақпен
Dialogue: 0,0:05:34.75,0:05:37.25,Default,,0,0,0,,Стадион арқылы жүгірейік!
Dialogue: 0,0:05:37.33,0:05:38.92,Default,,0,0,0,,Ұлттық турнир және жеке жарыстар.
Dialogue: 0,0:05:39.00,0:05:41.17,Default,,0,0,0,,Үшінші раундтың уақыты келді!
Dialogue: 0,0:05:41.50,0:05:43.88,Default,,0,0,0,,Бірінші ойыннан бастап қызықты болады!
Dialogue: 0,0:05:44.21,0:05:47.05,Default,,0,0,0,,Инусуке-нии-чан! Жеңілмейтін сәуле!
Dialogue: 0,0:05:47.76,0:05:50.47,Default,,0,0,0,,Мен бүгін сені осылай қолдаймын!
Dialogue: 0,0:05:50.55,0:05:52.22,Default,,0,0,0,,Ол бақытты болады.
Dialogue: 0,0:05:52.43,0:05:54.43,Default,,0,0,0,,Ой... ой...
Dialogue: 0,0:05:54.97,0:05:56.39,Default,,0,0,0,,Не болды? Балтық
Dialogue: 0,0:05:56.48,0:05:58.10,Default,,0,0,0,,Кенді Шу және Уақия
Dialogue: 0,0:05:58.19,0:05:59.85,Default,,0,0,0,,Екеуін де қолдаған дұрыс па?
Dialogue: 0,0:05:59.94,0:06:02.27,Default,,0,0,0,,Иә? Бұл өте рас!
Dialogue: 0,0:06:02.36,0:06:03.23,Default,,0,0,0,,Ада!
Dialogue: 0,0:06:03.32,0:06:04.40,Default,,0,0,0,,(Сора) Мен оны біршама болжаған едім, бірақ осыншалықты шектен тыс боларын ойламаппын.
Dialogue: 0,0:06:04.48,0:06:07.40,Default,,0,0,0,,Бұл өте назар аударатын шайқастан басталады!
Dialogue: 0,0:06:09.45,0:06:12.08,Default,,0,0,0,,Соңғы аймақтық іріктеуде, финалда Бенишудан жеңіліп қалдым.
Dialogue: 0,0:06:12.16,0:06:14.58,Default,,0,0,0,,Комурасаки Вакия бір қадамға жете алмады
Dialogue: 0,0:06:14.66,0:06:16.79,Default,,0,0,0,,Біз мақсатымызға жеттік!
Dialogue: 0,0:06:17.04,0:06:18.25,Default,,0,0,0,,Ботчан
Dialogue: 0,0:06:18.50,0:06:21.08,Default,,0,0,0,,Ақырында кек алатын уақыт келді.
Dialogue: 0,0:06:22.00,0:06:23.63,Default,,0,0,0,,Қарсы!
Dialogue: 0,0:06:24.80,0:06:27.09,Default,,0,0,0,,Алдыңғы жүлдегердің атынан -
Dialogue: 0,0:06:27.17,0:06:29.22,Default,,0,0,0,,Сіз бұл жерде тоқтай алмайсыз!
Dialogue: 0,0:06:29.30,0:06:31.43,Default,,0,0,0,,Төрт құбылмалы император Бенишу!
Dialogue: 0,0:06:31.55,0:06:33.60,Default,,0,0,0,,Шу! Вакия!
Dialogue: 0,0:06:33.68,0:06:35.39,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз!
Dialogue: 0,0:06:35.47,0:06:40.14,Default,,0,0,0,,Бұрынғы қарсыластар бір командамен командалық жарысқа қатысады!
Dialogue: 0,0:06:40.23,0:06:45.40,Default,,0,0,0,,Ал енді дос болған екеуі тағы да жау болып соқтығысады!
Dialogue: 0,0:06:45.61,0:06:47.74,Default,,0,0,0,,Шуу... Мен осы сәтті асыға күтемін...
Dialogue: 0,0:06:47.82,0:06:49.57,Default,,0,0,0,,Мен сені көптен бері күттім
Dialogue: 0,0:06:49.65,0:06:51.82,Default,,0,0,0,,Мен бүгін ерекше нәрсе көрдім!
Dialogue: 0,0:06:52.41,0:06:54.16,Default,,0,0,0,,Оны асыға күтемін!
Dialogue: 0,0:06:54.24,0:06:55.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:55.33,0:06:56.79,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:06:58.54,0:06:59.96,Default,,0,0,0,,Сол қолмен ату...
Dialogue: 0,0:07:00.04,0:07:02.04,Default,,0,0,0,,Бақылауға мән беру
Dialogue: 0,0:07:02.13,0:07:03.63,Default,,0,0,0,,Күтілгендей!
Dialogue: 0,0:07:04.00,0:07:05.96,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:07:08.13,0:07:11.09,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:11.55,0:07:13.80,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:15.30,0:07:17.97,Default,,0,0,0,,Бірінші контакт өткізіп алынды!
Dialogue: 0,0:07:18.06,0:07:19.31,Default,,0,0,0,,Бұл... Вайверн
Dialogue: 0,0:07:19.39,0:07:22.65,Default,,0,0,0,,Ол Спригганның жоғарғы соққысының жолын оқып, одан қашып кетті!
Dialogue: 0,0:07:22.73,0:07:24.11,Default,,0,0,0,,Оның қашып кетуіне жол берме, Спригган!
Dialogue: 0,0:07:24.52,0:07:26.77,Default,,0,0,0,,Спригган жеделдету-
Dialogue: 0,0:07:27.23,0:07:29.03,Default,,0,0,0,,Flying Wyvern!
Dialogue: 0,0:07:29.32,0:07:30.11,Default,,0,0,0,,Вакия!
Dialogue: 0,0:07:30.32,0:07:34.28,Default,,0,0,0,,Дәл осылай, аяқтау... А? Ол тоқтады!
Dialogue: 0,0:07:34.41,0:07:35.66,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:07:35.74,0:07:36.49,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:36.62,0:07:37.49,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:07:38.62,0:07:40.54,Default,,0,0,0,,Вайверн құлап түсті!
Dialogue: 0,0:07:41.00,0:07:42.83,Default,,0,0,0,,Бұл Вайдың жаңа техникасы!
Dialogue: 0,0:07:44.63,0:07:46.09,Default,,0,0,0,,Вайверн!
Dialogue: 0,0:07:48.30,0:07:51.42,Default,,0,0,0,,Hyper Shield апаты!
Dialogue: 0,0:07:54.89,0:07:56.30,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:07:56.55,0:07:57.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:58.43,0:08:01.89,Default,,0,0,0,,Wild Wyvern 1 ұпай
Dialogue: 0,0:08:01.98,0:08:02.77,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:02.85,0:08:05.81,Default,,0,0,0,,Вайдың жаңа техникасынан жеңілу қандай сезімде?
Dialogue: 0,0:08:06.02,0:08:07.94,Default,,0,0,0,,Бірінші голды кім соқты?
Dialogue: 0,0:08:08.02,0:08:09.98,Default,,0,0,0,,Бұл Комурасаки Вакия!
Dialogue: 0,0:08:10.74,0:08:11.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:12.07,0:08:14.24,Default,,0,0,0,,Hyper Shield апаты...
Dialogue: 0,0:08:14.41,0:08:16.62,Default,,0,0,0,,Бастапқыда қарсыластың шабуыл күші -
Dialogue: 0,0:08:16.70,0:08:18.37,Default,,0,0,0,,Фурико сияқты оралу техникасы
Dialogue: 0,0:08:18.45,0:08:21.00,Default,,0,0,0,,Спригганның күшті шабуылын қолдану
Dialogue: 0,0:08:21.08,0:08:23.08,Default,,0,0,0,,Қуат одан әрі ұлғайтылды ма?
Dialogue: 0,0:08:23.16,0:08:25.88,Default,,0,0,0,,Вакия жігіті мұны істеді!
Dialogue: 0,0:08:25.96,0:08:27.79,Default,,0,0,0,,Керемет жұмыс! Вакия-сан
Dialogue: 0,0:08:27.88,0:08:29.59,Default,,0,0,0,,Керемет!
Dialogue: 0,0:08:29.67,0:08:31.26,Default,,0,0,0,,Вакия керемет!
Dialogue: 0,0:08:31.34,0:08:32.55,Default,,0,0,0,,Шу Куяшии!
Dialogue: 0,0:08:32.63,0:08:34.30,Default,,0,0,0,,Вакия! Шуу!
Dialogue: 0,0:08:34.38,0:08:36.05,Default,,0,0,0,,Керемет! Өте өкінішті!
Dialogue: 0,0:08:36.14,0:08:37.80,Default,,0,0,0,,А-а!
Dialogue: 0,0:08:38.01,0:08:41.35,Default,,0,0,0,,Комурасаки Вакия жетекшілік ететін оқиғалардың күтпеген бұрылысы!
Dialogue: 0,0:08:41.43,0:08:43.18,Default,,0,0,0,,Бенишудың жоғарғы өркені
Dialogue: 0,0:08:43.27,0:08:46.23,Default,,0,0,0,,Мен оны сізге Hyper Shield Crash арқылы қайтардым!
Dialogue: 0,0:08:46.56,0:08:48.61,Default,,0,0,0,,Бір ауыз сөз айта алмаймын.
Dialogue: 0,0:08:48.94,0:08:51.53,Default,,0,0,0,,Комурасаки... Бұл керемет техника.
Dialogue: 0,0:08:51.61,0:08:55.03,Default,,0,0,0,,Мінсіз оқусыз және дәл түсіру күшінсіз мұны істей алмайсыз...
Dialogue: 0,0:08:55.32,0:08:56.41,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:08:57.28,0:08:58.57,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:09:03.79,0:09:05.83,Default,,0,0,0,,Оң қолмен ату.
Dialogue: 0,0:09:05.92,0:09:07.46,Default,,0,0,0,,Қуатқа бағытталған кадрлар
Dialogue: 0,0:09:07.54,0:09:08.79,Default,,0,0,0,,Тұру көлденең
Dialogue: 0,0:09:08.88,0:09:11.00,Default,,0,0,0,,Мен сені күшпен итеруге тырысамын.
Dialogue: 0,0:09:11.25,0:09:13.21,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:09:13.46,0:09:16.76,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:16.84,0:09:19.05,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:26.98,0:09:27.77,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:27.94,0:09:29.94,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:09:32.78,0:09:33.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:34.03,0:09:37.45,Default,,0,0,0,,Сторм Спригган мәреге жеткені үшін 1 ұпай
Dialogue: 0,0:09:37.66,0:09:38.70,Default,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:09:39.49,0:09:41.28,Default,,0,0,0,,Не... енді...?
Dialogue: 0,0:09:41.37,0:09:44.33,Default,,0,0,0,,Вивернге өзін қорғауға да мүмкіндік бермеді.
Dialogue: 0,0:09:44.70,0:09:46.25,Default,,0,0,0,,Виверн ортасында -
Dialogue: 0,0:09:46.33,0:09:48.54,Default,,0,0,0,,Тоқтағалы тұрған сәтке бейімделдің бе...
Dialogue: 0,0:09:48.83,0:09:51.46,Default,,0,0,0,,Солай болса да, қандай құдірет!
Dialogue: 0,0:09:51.54,0:09:53.38,Default,,0,0,0,,Бұл өте оңай...
Dialogue: 0,0:09:53.67,0:09:55.26,Default,,0,0,0,,Тек қуат емес
Dialogue: 0,0:09:55.34,0:09:57.88,Default,,0,0,0,,Түсіру уақытының дәлдігі де артты
Dialogue: 0,0:09:58.63,0:10:00.64,Default,,0,0,0,,Уау... Шу!
Dialogue: 0,0:10:00.93,0:10:03.10,Default,,0,0,0,,(Түтін дыбысы)
Dialogue: 0,0:10:04.18,0:10:06.43,Default,,0,0,0,,Бұл... қазір мен!
Dialogue: 0,0:10:06.77,0:10:07.89,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:08.14,0:10:12.02,Default,,0,0,0,,Куришуу Біз 1-1 есебімен тең түстік!
Dialogue: 0,0:10:12.11,0:10:14.07,Default,,0,0,0,,Бір қадам болса да бір-бірімізден бас тартпайық!
Dialogue: 0,0:10:14.15,0:10:15.36,Default,,0,0,0,,Екеуі де...
Dialogue: 0,0:10:15.69,0:10:18.07,Default,,0,0,0,,Әрі қарай... қалай шығады?
Dialogue: 0,0:10:20.70,0:10:22.53,Default,,0,0,0,,Шу! Уай тағы да...
Dialogue: 0,0:10:22.62,0:10:24.62,Default,,0,0,0,,Hyper Shield Crash арқылы жүріңіз!
Dialogue: 0,0:10:25.75,0:10:27.37,Default,,0,0,0,,Не!
Dialogue: 0,0:10:27.46,0:10:29.96,Default,,0,0,0,,Үшінші шайқас алдында Комурасаки Вакиядан -
Dialogue: 0,0:10:30.04,0:10:31.92,Default,,0,0,0,,Гипер декларация!
Dialogue: 0,0:10:32.00,0:10:34.25,Default,,0,0,0,,Е! Вакия мырза!
Dialogue: 0,0:10:34.34,0:10:36.21,Default,,0,0,0,,Неге олай дедің?
Dialogue: 0,0:10:36.51,0:10:37.92,Default,,0,0,0,,Бала...
Dialogue: 0,0:10:38.72,0:10:39.93,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:10:40.64,0:10:42.51,Default,,0,0,0,,Шу! Мен саған көрсетемін
Dialogue: 0,0:10:42.60,0:10:45.18,Default,,0,0,0,,Дәл қазір немен айналысып жатырсыз?
Dialogue: 0,0:10:46.39,0:10:47.64,Default,,0,0,0,,Мен қайталап көремін...
Dialogue: 0,0:10:47.73,0:10:49.39,Default,,0,0,0,,Жоғарғы атумен жүріңіз!
Dialogue: 0,0:10:49.60,0:10:51.77,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:51.85,0:10:54.32,Default,,0,0,0,,Сенгісіз! Сенгісіз!
Dialogue: 0,0:10:54.40,0:10:56.07,Default,,0,0,0,,Күтпеген оқиға!
Dialogue: 0,0:10:56.15,0:10:58.94,Default,,0,0,0,,Куришу да өз стратегиясын ашты!
Dialogue: 0,0:11:02.70,0:11:04.16,Default,,0,0,0,,Қызықты Шу
Dialogue: 0,0:11:04.24,0:11:06.45,Default,,0,0,0,,Мен дәл қазір өзімді тамаша сезінемін!
Dialogue: 0,0:11:06.54,0:11:08.54,Default,,0,0,0,,Комурасаки... Кеттік!
Dialogue: 0,0:11:08.62,0:11:09.91,Default,,0,0,0,,Біз жеңеміз!
Dialogue: 0,0:11:10.29,0:11:11.83,Default,,0,0,0,,Мен жеңген адаммын!
Dialogue: 0,0:11:12.04,0:11:13.79,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:11:14.00,0:11:17.55,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:17.63,0:11:19.92,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:21.13,0:11:22.30,Default,,0,0,0,,Бенишу
Dialogue: 0,0:11:22.39,0:11:25.47,Default,,0,0,0,,Жарияланғандай, өте жылдам апперкат... Ахх!
Dialogue: 0,0:11:25.55,0:11:27.81,Default,,0,0,0,,Мен Виверннен жалтардым!
Dialogue: 0,0:11:27.89,0:11:29.93,Default,,0,0,0,,Дәл осындай трюк Ботчанда жұмыс істемейді!
Dialogue: 0,0:11:30.43,0:11:33.40,Default,,0,0,0,,Бұл бірінші шайқас сияқты даму!
Dialogue: 0,0:11:33.48,0:11:34.90,Default,,0,0,0,,Хе-хе, хе-хе-хе…
Dialogue: 0,0:11:35.77,0:11:37.15,Default,,0,0,0,,сәби әлі тірі. Бұл адам баланы қорғап қалған болар.
Dialogue: 0,0:11:37.23,0:11:39.61,Default,,0,0,0,,Бұл... Hyper Shield Crash...
Dialogue: 0,0:11:39.69,0:11:41.45,Default,,0,0,0,,Ол шығады ма? Шыққан жоқ па?
Dialogue: 0,0:11:42.03,0:11:43.74,Default,,0,0,0,,Алға, Вайверн!
Dialogue: 0,0:11:43.82,0:11:46.58,Default,,0,0,0,,Бұл шығады!
Dialogue: 0,0:11:48.04,0:11:50.62,Default,,0,0,0,,Hyper Shield апаты!
Dialogue: 0,0:11:51.29,0:11:52.25,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,0:11:52.33,0:11:52.96,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:11:53.25,0:11:54.46,Default,,0,0,0,,Шешілді ме?
Dialogue: 0,0:11:54.71,0:11:57.09,Default,,0,0,0,,Спригган Бұл ойын!
Dialogue: 0,0:11:58.46,0:12:00.21,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:12:03.51,0:12:04.34,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:12:04.43,0:12:06.14,Default,,0,0,0,,Спригган жалтарып кетті!
Dialogue: 0,0:12:06.22,0:12:08.93,Default,,0,0,0,,Бірақ Wyvern әлі күшін де, жылдамдығын да жоғалтқан жоқ!
Dialogue: 0,0:12:09.01,0:12:12.23,Default,,0,0,0,,Hyper Shield апаты тағы да келе жатыр... Міне, келді!
Dialogue: 0,0:12:12.31,0:12:13.85,Default,,0,0,0,,Қайтадан жасаңыз!
Dialogue: 0,0:12:13.94,0:12:16.52,Default,,0,0,0,,Hyper Shield апаты!
Dialogue: 0,0:12:16.61,0:12:17.94,Default,,0,0,0,,(Айдаһардың айқайы)
Dialogue: 0,0:12:20.07,0:12:23.07,Default,,0,0,0,,Спригганның жоғарғы түсірілімі!
Dialogue: 0,0:12:23.20,0:12:24.45,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:12:26.78,0:12:28.41,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:12:30.08,0:12:32.12,Default,,0,0,0,,Не... Ято...!
Dialogue: 0,0:12:32.37,0:12:35.71,Default,,0,0,0,,Спригганның дауылы мәре 2 ұпай
Dialogue: 0,0:12:35.92,0:12:37.25,Default,,0,0,0,,Үштен бірге дейін -
Dialogue: 0,0:12:37.33,0:12:39.17,Default,,0,0,0,,Бенишудың жеңісі!
Dialogue: 0,0:12:40.92,0:12:43.22,Default,,0,0,0,,Спригганның жоғарғы соққысы!
Dialogue: 0,0:12:43.42,0:12:46.01,Default,,0,0,0,,Бұл шайқау болды!
Dialogue: 0,0:12:46.09,0:12:48.01,Default,,0,0,0,,Қарсыластар мен достар
Dialogue: 0,0:12:48.10,0:12:49.56,Default,,0,0,0,,Бұл шайқаста кім жеңді
Dialogue: 0,0:12:49.64,0:12:52.14,Default,,0,0,0,,Бұл данышпан Куришу!
Dialogue: 0,0:12:54.69,0:12:56.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:00.82,0:13:02.03,Default,,0,0,0,,Вакия…
Dialogue: 0,0:13:02.90,0:13:06.66,Default,,0,0,0,,Ахондара! Ахондара!
Dialogue: 0,0:13:06.99,0:13:13.45,Default,,0,0,0,,Ахондара! Ахондара! Ахондара…
Dialogue: 0,0:13:13.54,0:13:15.83,Default,,0,0,0,,Ах! Бала, өтінемін тоқта!
Dialogue: 0,0:13:16.08,0:13:17.37,Default,,0,0,0,,Шулы!
Dialogue: 0,0:13:17.46,0:13:19.04,Default,,0,0,0,,Мен жеңілдім!
Dialogue: 0,0:13:19.34,0:13:21.75,Default,,0,0,0,,барлық қуаттың 100% -
Dialogue: 0,0:13:21.84,0:13:23.13,Default,,0,0,0,,Бәрі бітсе де!
Dialogue: 0,0:13:23.21,0:13:26.51,Default,,0,0,0,,Мен оған рұқсат бере алмадым... Шуу жеңді!
Dialogue: 0,0:13:26.59,0:13:28.68,Default,,0,0,0,,Тоқтатыңызшы!
Dialogue: 0,0:13:28.76,0:13:29.80,Default,,0,0,0,,Әзірге үш минут
Dialogue: 0,0:13:29.89,0:13:31.31,Default,,0,0,0,,Бұл! Жіберу!
Dialogue: 0,0:13:31.76,0:13:32.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:36.27,0:13:39.10,Default,,0,0,0,,(Эндевор) Менің ұлым, Шото, All Might-ты басып озуға міндетті.
Dialogue: 0,0:13:41.44,0:13:42.23,Default,,0,0,0,,…!
Dialogue: 0,0:13:42.32,0:13:44.32,Default,,0,0,0,,Тоқта! Вакия!
Dialogue: 0,0:13:45.32,0:13:46.40,Default,,0,0,0,,Бұл оң қол -
Dialogue: 0,0:13:46.49,0:13:48.32,Default,,0,0,0,,Бұл жіптерді тартуға арналған!
Dialogue: 0,0:13:50.53,0:13:51.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:54.83,0:13:56.87,Default,,0,0,0,,Мен... Мен...
Dialogue: 0,0:13:56.96,0:13:58.96,Default,,0,0,0,,Бала барын салуда
Dialogue: 0,0:13:59.04,0:14:01.00,Default,,0,0,0,,Мен оны басқаларға қарағанда жақынырақ көрдім.
Dialogue: 0,0:14:01.42,0:14:02.59,Default,,0,0,0,,Бала -
Dialogue: 0,0:14:02.67,0:14:05.59,Default,,0,0,0,,Мен мұндай жерге тоқтайтын жігіт емеспін.
Dialogue: 0,0:14:05.92,0:14:06.97,Default,,0,0,0,,Әрине...
Dialogue: 0,0:14:07.47,0:14:09.80,Default,,0,0,0,,Ол міндетті түрде биікке көтерілетін адам!
Dialogue: 0,0:14:10.14,0:14:13.10,Default,,0,0,0,,Ол бір рет жеңілуге ​​тұрарлық дейді!
Dialogue: 0,0:14:13.22,0:14:14.56,Default,,0,0,0,,Хоудзи...!
Dialogue: 0,0:14:14.64,0:14:16.39,Default,,0,0,0,,(көз жасын сүрту дыбысы)
Dialogue: 0,0:14:17.31,0:14:20.86,Default,,0,0,0,,Идиот! Тоқтауға амалым жоқ!
Dialogue: 0,0:14:21.36,0:14:24.19,Default,,0,0,0,,Кеттік! Келесі матч басталады!
Dialogue: 0,0:14:25.03,0:14:27.36,Default,,0,0,0,,Сол үшін сен бокчансың!
Dialogue: 0,0:14:35.04,0:14:37.71,Default,,0,0,0,,Шу! Бұл керемет шайқас болды!
Dialogue: 0,0:14:37.79,0:14:40.33,Default,,0,0,0,,Вакияның жаңа техникасы керемет болды!
Dialogue: 0,0:14:40.42,0:14:41.17,Default,,0,0,0,,О
Dialogue: 0,0:14:41.25,0:14:42.79,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:14:44.13,0:14:45.34,Default,,0,0,0,,Вакия…
Dialogue: 0,0:14:45.67,0:14:46.88,Default,,0,0,0,,Не?
Dialogue: 0,0:14:47.01,0:14:49.88,Default,,0,0,0,,Мен үшін мүлде депрессияға түсу біртүрлі!
Dialogue: 0,0:14:50.22,0:14:51.97,Default,,0,0,0,,Батырмаңыз!
Dialogue: 0,0:14:52.60,0:14:53.68,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:14:53.76,0:14:56.31,Default,,0,0,0,,Ертерек сәл сәтсіз болды!
Dialogue: 0,0:14:56.64,0:14:58.02,Default,,0,0,0,,Бұл дәмді болды.
Dialogue: 0,0:14:58.10,0:15:00.69,Default,,0,0,0,,Уау, бұл қызу шайқас болды!
Dialogue: 0,0:15:00.77,0:15:03.15,Default,,0,0,0,,Сен бұлай айтсаң мен қуанбаймын.
Dialogue: 0,0:15:03.23,0:15:04.15,Default,,0,0,0,,Hihii
Dialogue: 0,0:15:04.23,0:15:07.07,Default,,0,0,0,,Кешіріңіз, бірақ ойын аяқталды.
Dialogue: 0,0:15:07.15,0:15:09.03,Default,,0,0,0,,Мен саған тағы да қамқор боламын.
Dialogue: 0,0:15:09.11,0:15:09.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:10.07,0:15:12.95,Default,,0,0,0,,Енді келесі шайқасқа назар аударыңыз!
Dialogue: 0,0:15:13.03,0:15:14.95,Default,,0,0,0,,Төрт-он император Ең күшті адам!
Dialogue: 0,0:15:15.03,0:15:17.24,Default,,0,0,0,,Ширасаги сарайы Луиспен таныстыру!
Dialogue: 0,0:15:17.58,0:15:19.29,Default,,0,0,0,,Қарсы
Dialogue: 0,0:15:19.37,0:15:22.92,Default,,0,0,0,,Инусуке Мидорикава, жер асты әлемін қорғайтын үш басты күзетші ит!
Dialogue: 0,0:15:23.25,0:15:25.67,Default,,0,0,0,,Жақсы! Инуске, қолыңнан келгенін істе!
Dialogue: 0,0:15:25.75,0:15:27.38,Default,,0,0,0,,Инусуке-нии-чан!
Dialogue: 0,0:15:27.96,0:15:28.92,Default,,0,0,0,,Капитан Магатоға не деп тұрсың!!
Dialogue: 0,0:15:29.67,0:15:31.63,Default,,0,0,0,,Жеңіске жетейік!
Dialogue: 0,0:15:31.84,0:15:33.01,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:15:33.09,0:15:35.89,Default,,0,0,0,,Инусуке-нии-чан, оның жоспары бар деді!
Dialogue: 0,0:15:39.56,0:15:40.94,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:15:45.69,0:15:47.19,Default,,0,0,0,,Бұл шайқас...
Dialogue: 0,0:15:47.36,0:15:49.78,Default,,0,0,0,,Кербеустың күшін ашыңыз!
Dialogue: 0,0:15:49.86,0:15:51.61,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:15:52.15,0:15:55.20,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:55.28,0:15:57.91,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:04.12,0:16:05.75,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:16:06.59,0:16:07.67,Default,,0,0,0,,Хехехе… Біраз мақтанып қояйын
Dialogue: 0,0:16:08.63,0:16:10.92,Default,,0,0,0,,Жоғалған Лонгинус жарылуы аяқталды!
Dialogue: 0,0:16:11.09,0:16:12.17,Default,,0,0,0,,2 ұпай!
Dialogue: 0,0:16:12.26,0:16:13.72,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:13.80,0:16:15.84,Default,,0,0,0,,Не! longinus
Dialogue: 0,0:16:15.93,0:16:18.93,Default,,0,0,0,,Мен бір соққымен Кербейді басып қалдым!
Dialogue: 0,0:16:19.01,0:16:19.97,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:20.06,0:16:21.27,Default,,0,0,0,,Иттерге қызмет көрсету…
Dialogue: 0,0:16:21.68,0:16:23.31,Default,,0,0,0,,Inusuke-nii-chan...
Dialogue: 0,0:16:24.27,0:16:26.19,Default,,0,0,0,,Сіз мұны істедіңіз!
Dialogue: 0,0:16:26.27,0:16:29.02,Default,,0,0,0,,Плюш мыңжапырақ Бұл маңызды мәселе емес!
Dialogue: 0,0:16:29.36,0:16:30.61,Default,,0,0,0,,италиялықтарға тән —
Dialogue: 0,0:16:30.99,0:16:33.28,Default,,0,0,0,,Инуске-нии-чанды мазақ етпе!
Dialogue: 0,0:16:33.70,0:16:35.32,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:16:35.41,0:16:38.03,Default,,0,0,0,,Дұрыс айтасың, Инуске! Осы жерден!
Dialogue: 0,0:16:38.12,0:16:39.62,Default,,0,0,0,,Қарсы шабуыл басталды!
Dialogue: 0,0:16:39.70,0:16:40.91,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз!
Dialogue: 0,0:16:41.00,0:16:42.87,Default,,0,0,0,,Жеңілмейтін сәуле!
Dialogue: 0,0:16:42.96,0:16:44.08,Default,,0,0,0,,Кейсуке!
Dialogue: 0,0:16:44.16,0:16:47.84,Default,,0,0,0,,Кейсуке! Кейсуке! Кейсуке!
Dialogue: 0,0:16:47.92,0:16:50.00,Default,,0,0,0,,Йонекома Гакуэн...
Dialogue: 0,0:16:50.09,0:16:51.59,Default,,0,0,0,,Инсукенің тірек бекеті
Dialogue: 0,0:16:51.67,0:16:53.13,Default,,0,0,0,,Жігіттер де!
Dialogue: 0,0:16:53.22,0:16:54.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:54.26,0:16:56.80,Default,,0,0,0,,Кейсуке! Кейсуке!
Dialogue: 0,0:16:56.89,0:17:00.64,Default,,0,0,0,,Кейсуке! Кейсуке! Кейсуке!
Dialogue: 0,0:17:01.56,0:17:02.98,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:17:04.02,0:17:06.60,Default,,0,0,0,,Не! Барлық алаңнан -
Dialogue: 0,0:17:06.69,0:17:08.69,Default,,0,0,0,,Бұл таң қалдыратын қоңырау!
Dialogue: 0,0:17:08.90,0:17:10.86,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:10.98,0:17:12.78,Default,,0,0,0,,Мен де жеңілмеймін!
Dialogue: 0,0:17:12.86,0:17:14.36,Default,,0,0,0,,Луи!
Dialogue: 0,0:17:14.45,0:17:15.78,Default,,0,0,0,,Мүмкін оның мақсаты – Эренді жеп қою.
Dialogue: 0,0:17:16.07,0:17:18.74,Default,,0,0,0,,Луи мұндайды ұнатпайды.
Dialogue: 0,0:17:19.16,0:17:21.04,Default,,0,0,0,,Барша адамның ішінде мен дәл осылай қысылып қалсам…
Dialogue: 0,0:17:21.29,0:17:22.62,Default,,0,0,0,,Барлығының дауысы...
Dialogue: 0,0:17:22.70,0:17:24.41,Default,,0,0,0,,Бұл маған көмектеседі!
Dialogue: 0,0:17:24.87,0:17:26.00,Default,,0,0,0,,I-
Dialogue: 0,0:17:26.21,0:17:27.42,Default,,0,0,0,,Аң бол!
Dialogue: 0,0:17:27.96,0:17:29.42,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:17:35.55,0:17:37.76,Default,,0,0,0,,Инсукенің түрі тағы өзгерді!
Dialogue: 0,0:17:38.01,0:17:39.60,Default,,0,0,0,,Ойланып қарасаңыз
Dialogue: 0,0:17:39.68,0:17:40.51,Default,,0,0,0,,О
Dialogue: 0,0:17:40.68,0:17:42.47,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:17:42.97,0:17:46.27,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:46.35,0:17:48.81,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:54.11,0:17:56.49,Default,,0,0,0,,Тістеп ал! Cerbeus!
Dialogue: 0,0:17:58.70,0:17:59.70,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:17:59.91,0:18:01.99,Default,,0,0,0,,Әлі жоқ, Кербеус...
Dialogue: 0,0:18:02.08,0:18:04.66,Default,,0,0,0,,Мені тістесең, мен сені жібермеймін!
Dialogue: 0,0:18:08.67,0:18:11.17,Default,,0,0,0,,(иттің үруі)
Dialogue: 0,0:18:11.25,0:18:13.38,Default,,0,0,0,,Оны жыртып тастаңыз!
Dialogue: 0,0:18:13.46,0:18:15.55,Default,,0,0,0,,Cerbeus бар күшіңізбен шабуыл жасаңыз!
Dialogue: 0,0:18:15.63,0:18:17.76,Default,,0,0,0,,Лонгинус жарылды!
Dialogue: 0,0:18:17.84,0:18:19.22,Default,,0,0,0,,Цербеус - орталық!
Dialogue: 0,0:18:19.30,0:18:20.72,Default,,0,0,0,,Керемет Инусуке!
Dialogue: 0,0:18:20.80,0:18:21.68,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:18:21.93,0:18:24.52,Default,,0,0,0,,Лонгинустың күшін пайдаландың ба?
Dialogue: 0,0:18:24.60,0:18:26.93,Default,,0,0,0,,Сіз жарылысқа дайындалған шабуыл жасадыңыз.
Dialogue: 0,0:18:27.35,0:18:28.85,Default,,0,0,0,,Жақсы істедің, Иносукэ!
Dialogue: 0,0:18:28.94,0:18:30.15,Default,,0,0,0,,Инсуке!
Dialogue: 0,0:18:30.69,0:18:33.98,Default,,0,0,0,,Алайда Лонгинустың күші бәсеңдеген жоқ!
Dialogue: 0,0:18:34.07,0:18:34.90,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:18:35.28,0:18:37.90,Default,,0,0,0,,А... Өлім спиралы!
Dialogue: 0,0:18:39.74,0:18:41.12,Default,,0,0,0,,Лонгинус
Dialogue: 0,0:18:41.20,0:18:44.16,Default,,0,0,0,,Толқындық шабуылдармен Кербеуспен жүрейік!
Dialogue: 0,0:18:48.00,0:18:49.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:49.54,0:18:50.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:53.00,0:18:55.34,Default,,0,0,0,,Ах... Иносуке-нии-чан...
Dialogue: 0,0:18:57.71,0:18:59.76,Default,,0,0,0,,Күте тұрыңыз, Кербеус!
Dialogue: 0,0:18:59.84,0:19:01.26,Default,,0,0,0,,Сіз мұны істей аласыз!
Dialogue: 0,0:19:01.34,0:19:03.26,Default,,0,0,0,,Cerbeus!
Dialogue: 0,0:19:05.72,0:19:06.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:10.81,0:19:12.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:12.98,0:19:16.11,Default,,0,0,0,,Лонгинусты айналдыру үшін 1 ұпай жоғалтты
Dialogue: 0,0:19:16.19,0:19:17.36,Default,,0,0,0,,3-0-
Dialogue: 0,0:19:17.44,0:19:19.32,Default,,0,0,0,,Руи Ширасагидің жеңісі!
Dialogue: 0,0:19:19.40,0:19:22.41,Default,,0,0,0,,Соңында соққы алмасқан адамның сен болғаныңа қуаныштымын
Dialogue: 0,0:19:22.49,0:19:23.62,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:23.70,0:19:28.95,Default,,0,0,0,,Ууууууууу!
Dialogue: 0,0:19:29.04,0:19:34.13,Default,,0,0,0,,Ууууууууу!
Dialogue: 0,0:19:34.21,0:19:36.00,Default,,0,0,0,,Inusuke-nii-chan...
Dialogue: 0,0:19:36.09,0:19:38.34,Default,,0,0,0,,Ууууууууу!
Dialogue: 0,0:19:38.55,0:19:39.72,Default,,0,0,0,,Бұл солтүстік-батырдағы қала ма?
Dialogue: 0,0:19:40.09,0:19:41.76,Default,,0,0,0,,А... А?
Dialogue: 0,0:19:41.84,0:19:43.09,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:43.51,0:19:46.05,Default,,0,0,0,,Кё, сен Иносуке Мидорикавасың.
Dialogue: 0,0:19:46.14,0:19:47.56,Default,,0,0,0,,Сіздің жауынгерлік рухыңыз мені еліктірді.
Dialogue: 0,0:19:47.64,0:19:48.56,Default,,0,0,0,,А...?
Dialogue: 0,0:19:48.89,0:19:50.14,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:19:50.48,0:19:55.61,Default,,0,0,0,,Жарайды! B блогының жартылай финалистері анықталды!
Dialogue: 0,0:19:56.02,0:19:59.11,Default,,0,0,0,,Мен бұл екеуінің шайқасын асыға күтемін!
Dialogue: 0,0:20:00.03,0:20:01.49,Default,,0,0,0,,Ең алдымен, Куришу!
Dialogue: 0,0:20:01.57,0:20:02.99,Default,,0,0,0,,шығанағы - Спригган дауылы!
Dialogue: 0,0:20:03.28,0:20:05.12,Default,,0,0,0,,Және Ширасаги сарайы Луис!
Dialogue: 0,0:20:05.20,0:20:07.33,Default,,0,0,0,,шығанақ - Лостронгинус!
Dialogue: 0,0:20:07.41,0:20:08.99,Default,,0,0,0,,Төрт айналатын император бірге!
Dialogue: 0,0:20:09.08,0:20:12.87,Default,,0,0,0,,Ал соңғы турнирдің қорытынды картасы орындалды!
Dialogue: 0,0:20:12.96,0:20:16.08,Default,,0,0,0,,(Бұрынғы Патша) Біз, Имантия, осы Дисбордта ең әлсізбіз.
Dialogue: 0,0:20:23.72,0:20:25.89,Default,,0,0,0,,Біз дәл қазір ұрысып қалдық...
Dialogue: 0,0:20:25.97,0:20:27.43,Default,,0,0,0,,Бұл өтірік сияқты, солай ма?
Dialogue: 0,0:20:27.55,0:20:28.35,Default,,0,0,0,,О
Dialogue: 0,0:20:29.47,0:20:31.02,Default,,0,0,0,,Тыныш.
Dialogue: 0,0:20:31.85,0:20:32.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:33.23,0:20:35.60,Default,,0,0,0,,Артқа қайтып, қайтадан жаттығу жасаңыз!
Dialogue: 0,0:20:35.69,0:20:36.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:42.53,0:20:43.90,Default,,0,0,0,,Бұл жара...
Dialogue: 0,0:20:45.78,0:20:47.28,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:20:48.37,0:20:49.53,Default,,0,0,0,,Сол кезде...
Dialogue: 0,0:20:49.66,0:20:50.66,Default,,0,0,0,,Шу!
Dialogue: 0,0:20:51.58,0:20:53.87,Default,,0,0,0,,Мен бұрын айтуды ұмытып кеткен бір нәрсе бар.
Dialogue: 0,0:20:54.41,0:20:56.12,Default,,0,0,0,,Мен сені жеңемін -
Dialogue: 0,0:20:56.21,0:20:59.00,Default,,0,0,0,,Мен шыңға жету үшін осынша жолмен келдім.
Dialogue: 0,0:20:59.21,0:21:00.67,Default,,0,0,0,,Мен солай ойладым.
Dialogue: 0,0:21:00.84,0:21:02.46,Default,,0,0,0,,Мен қатты ашуландым...
Dialogue: 0,0:21:02.55,0:21:04.55,Default,,0,0,0,,Сіз осында болғаныңыз үшін...
Dialogue: 0,0:21:05.13,0:21:06.01,Default,,0,0,0,,Иә
Dialogue: 0,0:21:07.51,0:21:09.64,Default,,0,0,0,,Мен сізге алғыс айтқым келеді.
Dialogue: 0,0:21:10.18,0:21:11.18,Default,,0,0,0,,Барлығы осы.
Dialogue: 0,0:21:13.06,0:21:14.14,Default,,0,0,0,,Кішкентай күлгін
Dialogue: 0,0:21:14.98,0:21:16.23,Default,,0,0,0,,Қайтадан жасайық
Dialogue: 0,0:21:16.52,0:21:17.35,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:17.98,0:21:19.40,Default,,0,0,0,,Әрине!
Dialogue: 0,0:21:22.69,0:21:23.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:29.87,0:21:32.20,Default,,0,0,0,,Келесі жолы мен жеңемін!
Dialogue: 0,0:21:34.50,0:21:38.63,Default,,0,0,0,,Вакия... мен, мен... (Рантаро) Хехехехе!
Dialogue: 0,0:21:38.79,0:21:41.46,Default,,0,0,0,,Мен таң қалдым! Эй, балалар...
Dialogue: 0,0:21:41.59,0:21:45.22,Default,,0,0,0,,Ол жақсы жігіт! Уакия бала!
Dialogue: 0,0:21:45.30,0:21:46.97,Default,,0,0,0,,Бұл өте қатты!
Dialogue: 0,0:21:47.05,0:21:49.01,Default,,0,0,0,,«Мен тек рахмет айтамын».
Dialogue: 0,0:21:49.09,0:21:51.85,Default,,0,0,0,,Бұл! Ұшып кетіңіз! (Рантаро) Хахаха
Dialogue: 0,0:21:51.93,0:21:54.10,Default,,0,0,0,,Кумичо Өте ұқсас! (Рантаро) Дұрыс!
Dialogue: 0,0:21:54.18,0:21:55.43,Default,,0,0,0,,Олар бір-біріне ұқсамайды!
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.32,0:23:27.82,Default,,0,0,0,,Ақырында мен...
Dialogue: 0,0:23:27.90,0:23:30.07,Default,,0,0,0,,Біз Шақа тұратын жерге келдік!
Dialogue: 0,0:23:30.40,0:23:32.82,Default,,0,0,0,,Не, Шақа күлмейді!
Dialogue: 0,0:23:32.91,0:23:35.91,Default,,0,0,0,,Мен сіздің керемет жауынгерлік рухыңызды сезінемін!
Dialogue: 0,0:23:35.99,0:23:38.70,Default,,0,0,0,,Бар күшіммен соғудан басқа амалым жоқ!
Dialogue: 0,0:23:38.79,0:23:40.66,Default,,0,0,0,,Мен Шаканы міндетті түрде жеңемін!
Dialogue: 0,0:23:41.16,0:23:43.21,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:43.29,0:23:45.75,Default,,0,0,0,,Қатты шайқас! Балто және Шака
Dialogue: 0,0:23:46.09,0:23:47.88,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.96,0:23:49.51,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.01,0:23:57.01,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory