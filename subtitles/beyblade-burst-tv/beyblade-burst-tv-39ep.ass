Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.50,0:00:09.17,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.25,0:00:12.59,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.67,0:00:14.68,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.76,0:00:16.97,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.05,0:00:18.68,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.52,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.31,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.40,0:00:28.69,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.40,0:00:34.07,Default,,0,0,0,,Ұлттық турнирдің командалық финалы
Dialogue: 0,0:00:34.15,0:00:37.20,Default,,0,0,0,,Күшті шайқаста Луи екеуміз соқтығыстық.
Dialogue: 0,0:00:37.28,0:00:38.78,Default,,0,0,0,,Луидің Лос Лонгинус
Dialogue: 0,0:00:38.87,0:00:41.08,Default,,0,0,0,,Бұл солға айналатын өте агрессивті шығанақ.
Dialogue: 0,0:00:43.71,0:00:45.83,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:00:46.54,0:00:47.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:47.54,0:00:49.92,Default,,0,0,0,,Енді ұпайлар 3-тен 3-ке дейін
Dialogue: 0,0:00:50.09,0:00:53.38,Default,,0,0,0,,Бұл келесі шайқаста кімнің шығатыны туралы көпшілік дауыс болды.
Dialogue: 0,0:00:53.80,0:00:55.80,Default,,0,0,0,,Дина оны маған берді.
Dialogue: 0,0:00:55.88,0:00:57.76,Default,,0,0,0,,Рахмет саған Дина!
Dialogue: 0,0:00:57.84,0:00:59.55,Default,,0,0,0,,Бірақ Йотаро-сан бәрі жақсы деді.
Dialogue: 0,0:00:59.64,0:01:01.26,Default,,0,0,0,,Міне!
Dialogue: 0,0:01:01.72,0:01:03.81,Default,,0,0,0,,Бар күшіммен жасаймын
Dialogue: 0,0:01:04.10,0:01:05.85,Default,,0,0,0,,Мен бұл жолы Луиді жеңемін
Dialogue: 0,0:01:10.73,0:01:11.73,Default,,0,0,0,,Ах
Dialogue: 0,0:01:12.07,0:01:13.82,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:01:13.90,0:01:16.91,Default,,0,0,0,,Йонекома Гакуэн ойыннан бас тартты ма?
Dialogue: 0,0:01:16.99,0:01:19.91,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:01:27.83,0:01:30.21,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:30.54,0:01:35.72,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:47.02,0:01:50.40,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:50.90,0:01:53.02,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:53.44,0:01:57.57,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:57.70,0:02:00.91,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:02:01.03,0:02:07.46,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:07.75,0:02:12.17,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:12.67,0:02:18.09,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:18.22,0:02:20.47,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:20.55,0:02:25.27,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:25.43,0:02:30.52,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:30.81,0:02:33.06,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:33.27,0:02:35.61,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:35.90,0:02:39.82,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:39.99,0:02:44.99,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:45.20,0:02:47.37,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:51.04,0:02:53.29,Default,,0,0,0,,Жарылыс! Өлім спиралы!
Dialogue: 0,0:02:55.04,0:02:58.38,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:02:58.46,0:03:00.63,Default,,0,0,0,,Неліктен Балтоға қол көтердің?
Dialogue: 0,0:03:00.84,0:03:02.76,Default,,0,0,0,,Мен оны көргім келді.
Dialogue: 0,0:03:02.84,0:03:06.56,Default,,0,0,0,,Балттың жауынгерлік рухы оны қаншалықты күшті етеді?
Dialogue: 0,0:03:08.22,0:03:10.98,Default,,0,0,0,,Енді қызу командалық жарыстың финалына.
Dialogue: 0,0:03:11.06,0:03:13.61,Default,,0,0,0,,Бесінші шайқасқа дейін шиеленіскен
Dialogue: 0,0:03:13.69,0:03:15.61,Default,,0,0,0,,Және жүзік
Dialogue: 0,0:03:15.69,0:03:19.07,Default,,0,0,0,,Руи Ширасаги VS Балт Аои
Dialogue: 0,0:03:19.44,0:03:22.74,Default,,0,0,0,,Бір ғажабы, екеуі күшпен шайқасады.
Dialogue: 0,0:03:22.82,0:03:24.49,Default,,0,0,0,,Тағы бір қақтығыс
Dialogue: 0,0:03:24.99,0:03:26.87,Default,,0,0,0,,Патшаның күшін көрсет
Dialogue: 0,0:03:26.95,0:03:28.54,Default,,0,0,0,,Ширасаги сарайы Луис!
Dialogue: 0,0:03:29.20,0:03:31.71,Default,,0,0,0,,Күшті шайқаста кек аласың ба?
Dialogue: 0,0:03:31.79,0:03:33.42,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:03:33.88,0:03:36.92,Default,,0,0,0,,Екі команда да қазір 3-3 есебімен тең.
Dialogue: 0,0:03:37.00,0:03:40.01,Default,,0,0,0,,Қайсысын ажыратуымыз керек?
Dialogue: 0,0:03:40.34,0:03:43.59,Default,,0,0,0,,Әлде бұл шайқас соңы бола ма?
Dialogue: 0,0:03:44.59,0:03:47.10,Default,,0,0,0,,Луис, біз қайтадан шайқаса аламыз.
Dialogue: 0,0:03:47.89,0:03:49.35,Default,,0,0,0,,Неге күлесің?
Dialogue: 0,0:03:49.52,0:03:52.64,Default,,0,0,0,,Мен сенімен көбірек шайқасқым келеді.
Dialogue: 0,0:03:53.94,0:03:55.61,Default,,0,0,0,,Мен оны аяқтаймын
Dialogue: 0,0:03:56.11,0:03:57.73,Default,,0,0,0,,Бесінші шайқас
Dialogue: 0,0:03:58.19,0:03:59.65,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:03:59.86,0:04:01.61,Default,,0,0,0,,кеттік досым
Dialogue: 0,0:04:01.69,0:04:03.86,Default,,0,0,0,,Өте керемет шайқас өткізейік
Dialogue: 0,0:04:05.57,0:04:07.41,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:04:07.83,0:04:10.91,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:04:11.12,0:04:13.33,Default,,0,0,0,,Жүр! Ат!
Dialogue: 0,0:04:18.25,0:04:20.55,Default,,0,0,0,,Аяқталмаған супер ояну т.б.
Dialogue: 0,0:04:20.76,0:04:22.72,Default,,0,0,0,,Лонгинуспен жұмыс істемейді
Dialogue: 0,0:04:22.80,0:04:26.51,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:04:28.30,0:04:30.56,Default,,0,0,0,,Бұл бетпе-бет соқтығыс болды ма?
Dialogue: 0,0:04:30.77,0:04:31.93,Default,,0,0,0,,Менің қашып кетуіме жол берме
Dialogue: 0,0:04:37.11,0:04:38.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:40.32,0:04:43.61,Default,,0,0,0,,Ой! Валькирияның жолы өзгерді
Dialogue: 0,0:04:44.32,0:04:45.61,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:04:45.70,0:04:47.12,Default,,0,0,0,,Жақсы, Валькири.
Dialogue: 0,0:04:47.20,0:04:48.83,Default,,0,0,0,,Тез ату
Dialogue: 0,0:04:50.08,0:04:52.75,Default,,0,0,0,,Лонгинусты жоғары итеріңіз!
Dialogue: 0,0:04:55.62,0:04:56.54,Default,,0,0,0,,Фу…
Dialogue: 0,0:04:56.62,0:04:58.67,Default,,0,0,0,,Валькири - асығыс ату
Dialogue: 0,0:04:58.92,0:05:00.55,Default,,0,0,0,,Кеттік, Балто.
Dialogue: 0,0:05:00.75,0:05:03.05,Default,,0,0,0,,Егер сіз оны асығыс ату арқылы төменнен жоғары итерсеңіз
Dialogue: 0,0:05:03.13,0:05:06.72,Default,,0,0,0,,Тіпті Лонгинустың өзі зақым келтіруі керек.
Dialogue: 0,0:05:06.80,0:05:07.93,Default,,0,0,0,,Жасай бер!
Dialogue: 0,0:05:08.39,0:05:09.72,Default,,0,0,0,,"Олар әңгімелесіп жатыр!"
Dialogue: 0,0:05:16.81,0:05:17.90,Default,,0,0,0,,Дұрыс. Соның арқасында мен ұтылдым.
Dialogue: 0,0:05:17.98,0:05:19.02,Default,,0,0,0,,Ах
Dialogue: 0,0:05:19.61,0:05:21.57,Default,,0,0,0,,Луидің сол кездегі түрі
Dialogue: 0,0:05:23.44,0:05:24.53,Default,,0,0,0,,Барт…
Dialogue: 0,0:05:24.86,0:05:27.49,Default,,0,0,0,,Асыққан асығыс!
Dialogue: 0,0:05:27.82,0:05:29.41,Default,,0,0,0,,Келіңіз және көріңіз
Dialogue: 0,0:05:36.66,0:05:38.37,Default,,0,0,0,,Балто абай болыңыз
Dialogue: 0,0:05:38.58,0:05:39.50,Default,,0,0,0,,Не!
Dialogue: 0,0:05:40.71,0:05:42.63,Default,,0,0,0,,Валькири таң қалды
Dialogue: 0,0:05:43.92,0:05:45.01,Default,,0,0,0,,Бал-нии!
Dialogue: 0,0:05:50.01,0:05:52.89,Default,,0,0,0,,Барто Аои шығанақты бірден ұстап алды!
Dialogue: 0,0:05:52.97,0:05:54.81,Default,,0,0,0,,А... жоқ, бірақ бұл
Dialogue: 0,0:05:56.06,0:05:57.10,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:57.89,0:05:59.44,Default,,0,0,0,,Аяқтаумен
Dialogue: 0,0:05:59.52,0:06:01.27,Default,,0,0,0,,Лостронгин 1 ұпай
Dialogue: 0,0:06:01.36,0:06:02.82,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:02.90,0:06:06.44,Default,,0,0,0,,Бесінші шайқаста жеңіске жеткен адам Лос Лонгинус болды!
Dialogue: 0,0:06:06.69,0:06:09.11,Default,,0,0,0,,Жүгіру 4-3
Dialogue: 0,0:06:09.20,0:06:10.91,Default,,0,0,0,,Шайқас әлі аяқталды
Dialogue: 0,0:06:14.70,0:06:15.79,Default,,0,0,0,,Қазір ғана…
Dialogue: 0,0:06:16.00,0:06:17.46,Default,,0,0,0,,Сен мені көздедің бе?
Dialogue: 0,0:06:17.83,0:06:18.92,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:06:19.62,0:06:20.63,Default,,0,0,0,,Не~!
Dialogue: 0,0:06:22.17,0:06:23.92,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:06:24.00,0:06:25.30,Default,,0,0,0,,Уақыт!
Dialogue: 0,0:06:27.22,0:06:28.22,Default,,0,0,0,,Шу
Dialogue: 0,0:06:28.93,0:06:31.26,Default,,0,0,0,,Емделу уақытын сұрау
Dialogue: 0,0:06:31.34,0:06:33.76,Default,,0,0,0,,Емдеу дегенді қалай түсінесіз?
Dialogue: 0,0:06:34.18,0:06:35.52,Default,,0,0,0,,Балтоның сол қолы
Dialogue: 0,0:06:35.60,0:06:38.35,Default,,0,0,0,,Ол шығанақты ұстап алған шоктан есеңгіреп қалса керек.
Dialogue: 0,0:06:38.89,0:06:40.65,Default,,0,0,0,,Тайм-ауттарға рұқсат беріңіз
Dialogue: 0,0:06:40.73,0:06:42.73,Default,,0,0,0,,Екі жүзік те орындыққа оралады
Dialogue: 0,0:06:44.36,0:06:45.48,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:06:48.61,0:06:50.70,Default,,0,0,0,,Үлкен аға, амансың ба?
Dialogue: 0,0:06:50.78,0:06:53.41,Default,,0,0,0,,Бұл сома сізге зиян тигізбейді.
Dialogue: 0,0:06:53.49,0:06:55.62,Default,,0,0,0,,Балтоны тыныштандыру үшін Шу
Dialogue: 0,0:06:55.70,0:06:57.33,Default,,0,0,0,,Мен уақытымды алдым.
Dialogue: 0,0:06:57.41,0:06:59.12,Default,,0,0,0,,Жақсы шешім.
Dialogue: 0,0:07:01.17,0:07:02.79,Default,,0,0,0,,Оған сол қолыңызды қойыңыз.
Dialogue: 0,0:07:03.13,0:07:04.38,Default,,0,0,0,,Түсіндіру мүмкін емес
Dialogue: 0,0:07:04.46,0:07:06.34,Default,,0,0,0,,Балтоға кіріңіз
Dialogue: 0,0:07:06.42,0:07:07.46,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:07:11.01,0:07:12.18,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,0:07:12.26,0:07:14.55,Default,,0,0,0,,Бұл табиғи, өйткені ол мұз.
Dialogue: 0,0:07:14.64,0:07:16.01,Default,,0,0,0,,Мұны біраз уақытқа орындаңыз.
Dialogue: 0,0:07:16.43,0:07:17.35,Default,,0,0,0,,О
Dialogue: 0,0:07:17.56,0:07:18.64,Default,,0,0,0,,Барт
Dialogue: 0,0:07:18.72,0:07:21.31,Default,,0,0,0,,Сіз Луиге біртүрлі нәрсе айттыңыз.
Dialogue: 0,0:07:21.52,0:07:23.48,Default,,0,0,0,,«Маған бағытталған»
Dialogue: 0,0:07:23.60,0:07:25.11,Default,,0,0,0,,Луи мені көздеп тұр
Dialogue: 0,0:07:25.19,0:07:27.78,Default,,0,0,0,,Мен Валькириді ұшып жібергендей болдым.
Dialogue: 0,0:07:27.86,0:07:29.19,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:07:29.28,0:07:32.20,Default,,0,0,0,,Қарсыласыңды көздеп, оны асыра аяқтау.
Dialogue: 0,0:07:32.28,0:07:34.28,Default,,0,0,0,,Жоқ, ол болуы мүмкін.
Dialogue: 0,0:07:34.37,0:07:35.20,Default,,0,0,0,,Не!
Dialogue: 0,0:07:35.41,0:07:36.99,Default,,0,0,0,,Эй Шу, түсіндім.
Dialogue: 0,0:07:37.08,0:07:39.58,Default,,0,0,0,,Мүмкін бұл сізге де бағытталған шығар.
Dialogue: 0,0:07:39.87,0:07:41.00,Default,,0,0,0,,Шу…
Dialogue: 0,0:07:46.50,0:07:47.96,Default,,0,0,0,,Аяқтау
Dialogue: 0,0:07:48.55,0:07:50.09,Default,,0,0,0,,Лостронгин 1 ұпай
Dialogue: 0,0:07:50.97,0:07:52.30,Default,,0,0,0,,Алдыңғы жарыс
Dialogue: 0,0:07:52.63,0:07:55.39,Default,,0,0,0,,Луи екеуміз финалда бір-бірімізге қарсы ойнаған кезде
Dialogue: 0,0:07:55.47,0:07:57.14,Default,,0,0,0,,Дәл осындай жағдай бұрын да болған
Dialogue: 0,0:07:58.43,0:08:00.93,Default,,0,0,0,,«Абайлаңыз» деп айқайлағаныңыздың себебі осы ма?
Dialogue: 0,0:08:01.39,0:08:03.14,Default,,0,0,0,,Менің бір болжамым бар еді.
Dialogue: 0,0:08:03.23,0:08:04.56,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:08:04.85,0:08:06.19,Default,,0,0,0,,Сіздің...
Dialogue: 0,0:08:08.32,0:08:11.11,Default,,0,0,0,,Бұл оқыс оқиға болып шықты.
Dialogue: 0,0:08:11.19,0:08:13.74,Default,,0,0,0,,А, бұл кездейсоқтық болды.
Dialogue: 0,0:08:13.82,0:08:16.74,Default,,0,0,0,,Бұл Луи болуы мүмкін емес.
Dialogue: 0,0:08:16.82,0:08:17.78,Default,,0,0,0,,Ол!
Dialogue: 0,0:08:17.87,0:08:18.62,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:18.70,0:08:20.16,Default,,0,0,0,,Луи Яроу
Dialogue: 0,0:08:20.24,0:08:21.54,Default,,0,0,0,,Демек, бұл басқаша.
Dialogue: 0,0:08:21.95,0:08:23.83,Default,,0,0,0,,Мұны істеу мүмкін емес.
Dialogue: 0,0:08:25.12,0:08:28.17,Default,,0,0,0,,Бұл данышпан қаншалықты мейірімді?
Dialogue: 0,0:08:28.25,0:08:30.00,Default,,0,0,0,,Луи басқа адамның жүрегіне барады
Dialogue: 0,0:08:30.13,0:08:32.92,Default,,0,0,0,,Ол сені бөлшектеп тастағысы келетін жігіт.
Dialogue: 0,0:08:34.47,0:08:35.89,Default,,0,0,0,,Қазіргі уақытта сіз
Dialogue: 0,0:08:35.97,0:08:38.85,Default,,0,0,0,,Сол матчта Луи сенің жүрегіңді жараламады ма?
Dialogue: 0,0:08:39.55,0:08:40.56,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:41.93,0:08:44.19,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:08:44.27,0:08:45.77,Default,,0,0,0,,Ұлттық турнирдің финалы
Dialogue: 0,0:08:46.06,0:08:50.73,Default,,0,0,0,,Лостронгинустың жеңісі оның күш-қуатындағы ерекше айырмашылығын көрсетті!
Dialogue: 0,0:08:50.82,0:08:51.98,Default,,0,0,0,,Ширасаги сарайы Луис
Dialogue: 0,0:08:52.07,0:08:54.07,Default,,0,0,0,,Қатарынан 4 жеңіске жетті!
Dialogue: 0,0:08:54.49,0:08:57.78,Default,,0,0,0,,Куришуу Мүлдем шыдай алмадым!
Dialogue: 0,0:08:58.70,0:09:01.37,Default,,0,0,0,,Фухахахаха...
Dialogue: 0,0:09:02.16,0:09:03.87,Default,,0,0,0,,Сол ащылық
Dialogue: 0,0:09:03.96,0:09:05.46,Default,,0,0,0,,Оны да ешқашан ұмытпаймын.
Dialogue: 0,0:09:06.92,0:09:09.54,Default,,0,0,0,,Бұл әдейі жасалмаған хаха~
Dialogue: 0,0:09:09.63,0:09:11.38,Default,,0,0,0,,қызығушылық танытуыңды түсінемін.
Dialogue: 0,0:09:11.84,0:09:13.46,Default,,0,0,0,,Бұл өте қорқынышты.
Dialogue: 0,0:09:13.80,0:09:14.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:15.47,0:09:17.84,Default,,0,0,0,,Луис мырза, бұл шынымен де керемет.
Dialogue: 0,0:09:17.93,0:09:19.55,Default,,0,0,0,,Сіз өз мақсатыңызды орындадыңыз, солай ма?
Dialogue: 0,0:09:19.76,0:09:21.97,Default,,0,0,0,,Күшті күшті көрсету
Dialogue: 0,0:09:22.06,0:09:24.14,Default,,0,0,0,,Қарсыласыңызды күресуге деген ынтасынан айырыңыз
Dialogue: 0,0:09:24.23,0:09:26.14,Default,,0,0,0,,Луи мұны істей алады.
Dialogue: 0,0:09:26.23,0:09:28.15,Default,,0,0,0,,Бұл керемет, Луи-сан.
Dialogue: 0,0:09:28.23,0:09:30.02,Default,,0,0,0,,Мен мұндайды бұрын-соңды көрген емеспін.
Dialogue: 0,0:09:30.23,0:09:31.11,Default,,0,0,0,,Дамар!
Dialogue: 0,0:09:31.44,0:09:32.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:35.49,0:09:38.45,Default,,0,0,0,,Сол матчта мені Луи жеңді.
Dialogue: 0,0:09:38.78,0:09:40.95,Default,,0,0,0,,Бірақ мен өзімді қайта құруға тырыстым.
Dialogue: 0,0:09:41.12,0:09:42.37,Default,,0,0,0,,Біз осы уақытқа дейін жеттік
Dialogue: 0,0:09:42.87,0:09:45.08,Default,,0,0,0,,Мен Луимен ең көп шайқастым
Dialogue: 0,0:09:45.16,0:09:46.29,Default,,0,0,0,,Бұл сенсің.
Dialogue: 0,0:09:48.04,0:09:49.88,Default,,0,0,0,,Маған араласу
Dialogue: 0,0:09:49.96,0:09:52.21,Default,,0,0,0,,Ал мен екі рет жеңілдім.
Dialogue: 0,0:09:53.00,0:09:55.63,Default,,0,0,0,,Ку~, өте аянышты
Dialogue: 0,0:09:55.72,0:09:56.67,Default,,0,0,0,,Ауырды!
Dialogue: 0,0:09:56.76,0:09:58.43,Default,,0,0,0,,Олардың мүлде қозғалмай жатқаны оғаш екен
Dialogue: 0,0:09:58.51,0:09:59.80,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:10:00.26,0:10:03.06,Default,,0,0,0,,Егер Луи Бейді мақсатты түрде ұрса ше?
Dialogue: 0,0:10:03.14,0:10:05.35,Default,,0,0,0,,Мен сені кешіре алмаймын
Dialogue: 0,0:10:05.43,0:10:07.56,Default,,0,0,0,,Егер сіз шығанақты денеңізге жақсаңыз
Dialogue: 0,0:10:07.64,0:10:10.35,Default,,0,0,0,,Аяқтау және жеңу
Dialogue: 0,0:10:10.44,0:10:11.73,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:10:12.02,0:10:14.86,Default,,0,0,0,,Бірақ егер сіз мұны істей алсаңыз ...
Dialogue: 0,0:10:17.74,0:10:20.57,Default,,0,0,0,,Сіз қанша жаттығу жасадыңыз?
Dialogue: 0,0:10:20.87,0:10:22.03,Default,,0,0,0,,Қалтамды ұстап көруге қалай батылың жетті—
Dialogue: 0,0:10:22.28,0:10:26.00,Default,,0,0,0,,Маған қарағанда ондаған, жүздеген есе көп жаттығу жасаған болуыңыз керек.
Dialogue: 0,0:10:28.54,0:10:29.50,Default,,0,0,0,,Луис
Dialogue: 0,0:10:34.75,0:10:37.30,Default,,0,0,0,,Мен онымен күресемін.
Dialogue: 0,0:10:37.92,0:10:39.18,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:10:39.76,0:10:40.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:40.89,0:10:43.35,Default,,0,0,0,,Дәл қазір ашуланбадың ба?
Dialogue: 0,0:10:43.43,0:10:44.64,Default,,0,0,0,,Сен ақымақсың ғой
Dialogue: 0,0:10:45.14,0:10:47.35,Default,,0,0,0,,Лонгинуспен тағы да
Dialogue: 0,0:10:49.35,0:10:50.35,Default,,0,0,0,,О... Эй!
Dialogue: 0,0:10:50.81,0:10:52.65,Default,,0,0,0,,Матчты жалғастырыңыз
Dialogue: 0,0:10:52.73,0:10:54.86,Default,,0,0,0,,Алтыншы пышақ, алға шық.
Dialogue: 0,0:10:57.28,0:10:59.11,Default,,0,0,0,,Өзімшіл нәрсе Суная
Dialogue: 0,0:10:59.20,0:11:01.24,Default,,0,0,0,,Мен сізді естімеймін, Барто.
Dialogue: 0,0:11:01.53,0:11:03.12,Default,,0,0,0,,Жарайсың ба, Шу?
Dialogue: 0,0:11:03.20,0:11:05.41,Default,,0,0,0,,Сіз келесі жолы баруды жоспарлағансыз.
Dialogue: 0,0:11:05.91,0:11:06.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:07.12,0:11:09.37,Default,,0,0,0,,Міне, мен барамын.
Dialogue: 0,0:11:09.46,0:11:10.79,Default,,0,0,0,,Сіз не ойлап отырсыз?
Dialogue: 0,0:11:10.87,0:11:12.88,Default,,0,0,0,,Вакия
Dialogue: 0,0:11:12.96,0:11:15.54,Default,,0,0,0,,А, қазірдің өзінде! Мен білмеймін!
Dialogue: 0,0:11:16.00,0:11:17.42,Default,,0,0,0,,Тағы да!
Dialogue: 0,0:11:26.26,0:11:27.31,Default,,0,0,0,,Луис
Dialogue: 0,0:11:29.23,0:11:30.77,Default,,0,0,0,,Тағы бір рет!
Dialogue: 0,0:11:38.44,0:11:39.86,Default,,0,0,0,,Ха... хех хе...
Dialogue: 0,0:11:40.36,0:11:41.20,Default,,0,0,0,,Эй...
Dialogue: 0,0:11:41.28,0:11:42.41,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:11:45.12,0:11:46.91,Default,,0,0,0,,Сіз оны таныдыңыз ба?
Dialogue: 0,0:11:47.58,0:11:49.37,Default,,0,0,0,,Не... не?
Dialogue: 0,0:11:49.45,0:11:52.58,Default,,0,0,0,,Алтыншы шайқаста да осы екеуі бар.
Dialogue: 0,0:11:52.92,0:11:54.42,Default,,0,0,0,,Йонекома Гакуэн шығанағы клубы
Dialogue: 0,0:11:54.50,0:11:55.54,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:11:55.63,0:11:58.88,Default,,0,0,0,,Ал Rideout - Ширасадиджо Луи.
Dialogue: 0,0:12:03.88,0:12:05.14,Default,,0,0,0,,Алтыншы шайқас
Dialogue: 0,0:12:06.30,0:12:08.76,Default,,0,0,0,,Егер сіз Лонгинусты бассаңыз
Dialogue: 0,0:12:08.85,0:12:10.35,Default,,0,0,0,,Маған тағы да соққы болады
Dialogue: 0,0:12:10.43,0:12:13.02,Default,,0,0,0,,Бірақ Валькири кетуі керек.
Dialogue: 0,0:12:13.35,0:12:16.27,Default,,0,0,0,,Мен сені ұсақтаймын
Dialogue: 0,0:12:16.48,0:12:18.57,Default,,0,0,0,,Ол ұсақталады ма?
Dialogue: 0,0:12:19.86,0:12:20.40,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:12:20.86,0:12:22.57,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:12:22.78,0:12:25.95,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:12:26.03,0:12:29.12,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:12:29.20,0:12:30.45,Default,,0,0,0,,Жүр!
Dialogue: 0,0:12:34.42,0:12:35.12,Default,,0,0,0,,Не!
Dialogue: 0,0:12:35.46,0:12:36.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:41.38,0:12:44.51,Default,,0,0,0,,Валькири қабырғаға тиген сәтсіз соққы
Dialogue: 0,0:12:44.59,0:12:47.22,Default,,0,0,0,,Алайда мен Лонгинустың шабуылынан жалтардым.
Dialogue: 0,0:12:48.51,0:12:50.81,Default,,0,0,0,,Қатты шайқалса да жүгіруді жалғастырыңыз
Dialogue: 0,0:12:50.89,0:12:52.68,Default,,0,0,0,,Сол қол бұлдыр
Dialogue: 0,0:12:52.77,0:12:54.60,Default,,0,0,0,,Жоқ, бұл жігіт мұны істей алады.
Dialogue: 0,0:12:54.81,0:12:56.48,Default,,0,0,0,,Na~is
Dialogue: 0,0:12:56.56,0:12:58.61,Default,,0,0,0,,Бұл өте күтпеген жағдай.
Dialogue: 0,0:12:58.69,0:13:01.82,Default,,0,0,0,,Лонгинус жолынан толықтай.
Dialogue: 0,0:13:02.82,0:13:04.82,Default,,0,0,0,,Атыс күші ең жақсы
Dialogue: 0,0:13:05.28,0:13:07.24,Default,,0,0,0,,Импульс бәсеңдемейді.
Dialogue: 0,0:13:07.62,0:13:09.49,Default,,0,0,0,,Жүгіріп өт, Валькири
Dialogue: 0,0:13:09.83,0:13:11.79,Default,,0,0,0,,Бұл қашқын ба?
Dialogue: 0,0:13:11.87,0:13:13.04,Default,,0,0,0,,Бұл шынымен бақылаудан шықты!
Dialogue: 0,0:13:13.37,0:13:15.92,Default,,0,0,0,,Тіпті Луис бұл қадамды болжай алмады.
Dialogue: 0,0:13:16.00,0:13:18.71,Default,,0,0,0,,Лонгинус өзінің олжасын көрмей қалды.
Dialogue: 0,0:13:19.04,0:13:20.42,Default,,0,0,0,,Қаш!
Dialogue: 0,0:13:21.59,0:13:22.76,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:13:22.96,0:13:24.22,Default,,0,0,0,,Лонгинус
Dialogue: 0,0:13:24.30,0:13:26.18,Default,,0,0,0,,Әрқашан олжаңызды ұстаңыз
Dialogue: 0,0:13:31.39,0:13:32.60,Default,,0,0,0,,Лонгинус
Dialogue: 0,0:13:32.68,0:13:34.68,Default,,0,0,0,,Валькиримен қашықтықты жабыңыз
Dialogue: 0,0:13:34.77,0:13:36.60,Default,,0,0,0,,Толығымен ауқымда.
Dialogue: 0,0:13:36.94,0:13:39.27,Default,,0,0,0,,Валькири қашып жатқан жоқ.
Dialogue: 0,0:13:39.90,0:13:41.44,Default,,0,0,0,,Алға!
Dialogue: 0,0:13:41.52,0:13:44.40,Default,,0,0,0,,Нағыз жарқыл түсіру!
Dialogue: 0,0:13:44.49,0:13:45.78,Default,,0,0,0,,Уау
Dialogue: 0,0:13:45.86,0:13:48.16,Default,,0,0,0,,Валькири қайтадан жолын өзгертті.
Dialogue: 0,0:13:48.24,0:13:51.12,Default,,0,0,0,,Бұл нағыз флэш-түсірілім
Dialogue: 0,0:13:51.20,0:13:52.79,Default,,0,0,0,,Валькирияның алдында
Dialogue: 0,0:13:52.87,0:13:55.66,Default,,0,0,0,,Лонгинус бар.
Dialogue: 0,0:13:56.79,0:13:57.83,Default,,0,0,0,,Жүр!
Dialogue: 0,0:13:57.92,0:14:00.83,Default,,0,0,0,,Валькири Лонгинусқа соғылады
Dialogue: 0,0:14:00.92,0:14:02.25,Default,,0,0,0,,Додж, Балто!
Dialogue: 0,0:14:02.34,0:14:03.25,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:03.34,0:14:04.26,Default,,0,0,0,,О...
Dialogue: 0,0:14:04.51,0:14:06.92,Default,,0,0,0,,(еденге құлаған шығанақтың дыбысы)
Dialogue: 0,0:14:18.31,0:14:20.73,Default,,0,0,0,,Екеуі де бір уақытта аяқтайды
Dialogue: 0,0:14:20.81,0:14:21.81,Default,,0,0,0,,Ұтыс!
Dialogue: 0,0:14:22.02,0:14:23.36,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:23.44,0:14:25.78,Default,,0,0,0,,Қандай ұтыс!
Dialogue: 0,0:14:26.03,0:14:27.65,Default,,0,0,0,,Ширасаги сарайы Луис
Dialogue: 0,0:14:27.74,0:14:30.49,Default,,0,0,0,,Ұлттық турнирдегі бірінші жеребе тарту
Dialogue: 0,0:14:30.57,0:14:32.99,Default,,0,0,0,,Бұл таңғаларлық оқиға.
Dialogue: 0,0:14:33.33,0:14:35.29,Default,,0,0,0,,Ұпайлар 4-тен 3-ке дейін
Dialogue: 0,0:14:35.37,0:14:37.37,Default,,0,0,0,,Rideout жетекшіде қалады
Dialogue: 0,0:14:37.45,0:14:38.66,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:14:38.75,0:14:40.04,Default,,0,0,0,,Жақсы, Валькири.
Dialogue: 0,0:14:40.12,0:14:41.54,Default,,0,0,0,,Жарайсың
Dialogue: 0,0:14:41.88,0:14:46.88,Default,,0,0,0,,Ах~ Валькири баяу құлаған болуы керек.
Dialogue: 0,0:14:46.96,0:14:47.97,Default,,0,0,0,,Бір уақытта
Dialogue: 0,0:14:48.13,0:14:50.30,Default,,0,0,0,,Егер Балто Валькириге тиіссе
Dialogue: 0,0:14:50.38,0:14:51.97,Default,,0,0,0,,Мен жеңіліп қала жаздадым.
Dialogue: 0,0:14:52.05,0:14:53.47,Default,,0,0,0,,Сәттілік.
Dialogue: 0,0:14:54.22,0:14:55.76,Default,,0,0,0,,Жеребе ше?
Dialogue: 0,0:14:56.18,0:14:58.31,Default,,0,0,0,,Жарайды, қазір істейік Луи.
Dialogue: 0,0:14:58.81,0:15:00.31,Default,,0,0,0,,Сіз мұны тағы бір рет жасай аласыз.
Dialogue: 0,0:15:00.39,0:15:02.27,Default,,0,0,0,,Мен өте қуаныштымын.
Dialogue: 0,0:15:02.35,0:15:04.40,Default,,0,0,0,,Цк, жарайды.
Dialogue: 0,0:15:04.73,0:15:06.03,Default,,0,0,0,,Сізбен шайқас
Dialogue: 0,0:15:06.11,0:15:08.03,Default,,0,0,0,,Ой, қызық бола бастады.
Dialogue: 0,0:15:08.65,0:15:09.99,Default,,0,0,0,,Көңілді…
Dialogue: 0,0:15:10.45,0:15:12.24,Default,,0,0,0,,Келесі шайқас
Dialogue: 0,0:15:12.32,0:15:14.62,Default,,0,0,0,,Мен сені мүлде талқандаймын!
Dialogue: 0,0:15:14.70,0:15:15.62,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:16.04,0:15:17.12,Default,,0,0,0,,Уақыт
Dialogue: 0,0:15:17.41,0:15:18.79,Default,,0,0,0,,Сұраныс уақыты
Dialogue: 0,0:15:21.71,0:15:23.42,Default,,0,0,0,,Бұрын болған оқиға кездейсоқ болды.
Dialogue: 0,0:15:23.50,0:15:26.34,Default,,0,0,0,,Мұндай уақытта оны қалай ұруға болады?
Dialogue: 0,0:15:26.42,0:15:28.67,Default,,0,0,0,,1000 рет орындаңыз, ол бір рет болады немесе болмайды.
Dialogue: 0,0:15:28.88,0:15:30.80,Default,,0,0,0,,Көзге көрінетін нәрселерді айтпа
Dialogue: 0,0:15:34.72,0:15:35.97,Default,,0,0,0,,Бұрынғы
Dialogue: 0,0:15:36.06,0:15:38.97,Default,,0,0,0,,Сол қолым дірілдеп тұрғандықтан, Луидің болжамдарын жіберіп алдым...
Dialogue: 0,0:15:40.35,0:15:43.02,Default,,0,0,0,,Валькири шынымен төбелескісі келеді
Dialogue: 0,0:15:43.81,0:15:45.98,Default,,0,0,0,,Аса ояну жақын қалды.
Dialogue: 0,0:15:46.48,0:15:48.23,Default,,0,0,0,,Сіз қышиды
Dialogue: 0,0:15:48.32,0:15:49.36,Default,,0,0,0,,Мен айта аламын.
Dialogue: 0,0:15:49.78,0:15:51.49,Default,,0,0,0,,Сәлем Балто
Dialogue: 0,0:15:51.57,0:15:54.03,Default,,0,0,0,,Қазір Балто аймақта.
Dialogue: 0,0:15:54.11,0:15:55.16,Default,,0,0,0,,Аймақ?
Dialogue: 0,0:15:55.37,0:15:58.74,Default,,0,0,0,,Шамадан тыс шоғырланудан туындаған психикалық күй.
Dialogue: 0,0:15:58.95,0:16:00.37,Default,,0,0,0,,Үздік спортшылар
Dialogue: 0,0:16:00.45,0:16:02.37,Default,,0,0,0,,Мұндай жағдай орын алуы мүмкін.
Dialogue: 0,0:16:02.67,0:16:05.38,Default,,0,0,0,,Ойыншының ең жақсы жағдайы
Dialogue: 0,0:16:05.46,0:16:06.67,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:16:06.75,0:16:09.30,Default,,0,0,0,,Бұл жігіт өте жақсы.
Dialogue: 0,0:16:12.05,0:16:14.18,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:16:14.26,0:16:15.30,Default,,0,0,0,,О
Dialogue: 0,0:16:16.39,0:16:18.01,Default,,0,0,0,,Жетінші пышақ
Dialogue: 0,0:16:18.10,0:16:19.18,Default,,0,0,0,,Алға шық
Dialogue: 0,0:16:23.10,0:16:25.90,Default,,0,0,0,,Енді нүктелер 4-тен 3-ке дейін қалады.
Dialogue: 0,0:16:25.98,0:16:27.86,Default,,0,0,0,,Жүгіру жолақтары
Dialogue: 0,0:16:27.94,0:16:31.49,Default,,0,0,0,,Блейдерлер Барто Аои мен Руи Ширасадиджоу болып қалады.
Dialogue: 0,0:16:31.57,0:16:34.78,Default,,0,0,0,,Оқиғаның осылай болатынын кім болжаған!
Dialogue: 0,0:16:35.16,0:16:36.78,Default,,0,0,0,,Жетінші шайқас
Dialogue: 0,0:16:37.16,0:16:38.95,Default,,0,0,0,,Мен мұны сұрадым, Балто!
Dialogue: 0,0:16:39.03,0:16:39.95,Default,,0,0,0,,Жеңіс!
Dialogue: 0,0:16:40.04,0:16:41.62,Default,,0,0,0,,Капитанды шешіңіз
Dialogue: 0,0:16:47.63,0:16:50.21,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:50.55,0:16:52.38,Default,,0,0,0,,Барлығыңызды кешіріңіз...
Dialogue: 0,0:16:53.17,0:16:55.34,Default,,0,0,0,,Мен капитан болсам да
Dialogue: 0,0:16:55.55,0:16:57.76,Default,,0,0,0,,Менің аяғымды тартпа
Dialogue: 0,0:16:57.85,0:16:58.80,Default,,0,0,0,,Вакия
Dialogue: 0,0:16:58.89,0:17:01.02,Default,,0,0,0,,Уай мен Шу жеңді ме?
Dialogue: 0,0:17:01.10,0:17:02.06,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:17:02.39,0:17:03.48,Default,,0,0,0,,Не?!
Dialogue: 0,0:17:03.56,0:17:04.85,Default,,0,0,0,,Біз топ болып жеңіске жеттік.
Dialogue: 0,0:17:05.35,0:17:07.35,Default,,0,0,0,,Сояна Соятта
Dialogue: 0,0:17:07.44,0:17:09.56,Default,,0,0,0,,Ештеңе істемейтін адамдар бар.
Dialogue: 0,0:17:09.65,0:17:10.31,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:17:10.65,0:17:12.82,Default,,0,0,0,,Мен мұндай командадан жеңілемін деп ойламадым.
Dialogue: 0,0:17:13.03,0:17:14.65,Default,,0,0,0,,Нөлдік топтық жұмыс
Dialogue: 0,0:17:15.15,0:17:16.99,Default,,0,0,0,,Капитан ештеңе істеп жатқан жоқ.
Dialogue: 0,0:17:20.07,0:17:21.49,Default,,0,0,0,,Кешіріңіз Инсуке
Dialogue: 0,0:17:22.87,0:17:26.62,Default,,0,0,0,,Бірақ мен капитанмын, сондықтан бар күшімді салуым керек.
Dialogue: 0,0:17:28.42,0:17:30.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:32.25,0:17:34.72,Default,,0,0,0,,Жарайды, Инуске, тағы бір рет.
Dialogue: 0,0:17:35.05,0:17:38.14,Default,,0,0,0,,Дәл қазіргідей тағы бір керемет шайқас болсын.
Dialogue: 0,0:17:38.72,0:17:40.43,Default,,0,0,0,,Бұл Балто, солай ма?
Dialogue: 0,0:17:41.14,0:17:41.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:42.06,0:17:43.02,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:17:43.52,0:17:45.18,Default,,0,0,0,,Өйткені Балт - Балт.
Dialogue: 0,0:17:47.44,0:17:48.60,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:17:49.44,0:17:52.02,Default,,0,0,0,,Мен өзім болғаным дұрыс.
Dialogue: 0,0:17:52.11,0:17:52.94,Default,,0,0,0,,Шу~
Dialogue: 0,0:17:53.03,0:17:53.94,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:17:54.03,0:17:55.40,Default,,0,0,0,,Заттарды көзге көрсету~
Dialogue: 0,0:17:55.49,0:17:56.82,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:17:56.90,0:17:57.99,Default,,0,0,0,,Жақсы, Вакия!
Dialogue: 0,0:17:58.07,0:17:59.32,Default,,0,0,0,,Аняр!
Dialogue: 0,0:17:59.41,0:18:01.78,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:02.24,0:18:03.37,Default,,0,0,0,,Ал Хинацуру…
Dialogue: 0,0:18:07.83,0:18:09.67,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:18:10.58,0:18:12.38,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:18:14.55,0:18:18.26,Default,,0,0,0,,Командалық жарыстың финалы тартысты тартысты өтті.
Dialogue: 0,0:18:18.34,0:18:20.43,Default,,0,0,0,,Бұл шайқас аяқталады ма?
Dialogue: 0,0:18:20.64,0:18:22.30,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:22.81,0:18:23.68,Default,,0,0,0,,Үш
Dialogue: 0,0:18:23.76,0:18:25.06,Default,,0,0,0,,Ең бастысы
Dialogue: 0,0:18:25.27,0:18:26.14,Default,,0,0,0,,Екі
Dialogue: 0,0:18:26.27,0:18:27.73,Default,,0,0,0,,Қалай жеңуге болады
Dialogue: 0,0:18:28.19,0:18:29.19,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:18:29.27,0:18:31.52,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:34.82,0:18:38.36,Default,,0,0,0,,Лонгинус қабырғаға соқты... жоқ, соқты.
Dialogue: 0,0:18:38.45,0:18:40.82,Default,,0,0,0,,Стадион бойымен жүгіру үшін кері айналдыруды пайдаланыңыз.
Dialogue: 0,0:18:41.12,0:18:41.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:42.57,0:18:43.45,Default,,0,0,0,,Әй
Dialogue: 0,0:18:45.58,0:18:47.33,Default,,0,0,0,,Бұл керісінше.
Dialogue: 0,0:18:47.41,0:18:49.41,Default,,0,0,0,,Қабырғадан не секіреді?
Dialogue: 0,0:18:49.50,0:18:50.71,Default,,0,0,0,,Ростронгинус
Dialogue: 0,0:18:50.96,0:18:52.04,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:18:52.13,0:18:54.96,Default,,0,0,0,,Мен кездейсоқ болған нәрсеге қайта ораламын.
Dialogue: 0,0:18:56.67,0:18:59.42,Default,,0,0,0,,Valkyrie True Flash Shoot
Dialogue: 0,0:19:00.51,0:19:01.97,Default,,0,0,0,,Валькирия
Dialogue: 0,0:19:02.14,0:19:03.93,Default,,0,0,0,,Лонгинусты қолға түсіресіз бе?
Dialogue: 0,0:19:04.39,0:19:06.47,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:06.56,0:19:08.81,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:19:10.35,0:19:12.10,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:19:14.90,0:19:17.53,Default,,0,0,0,,Өлім спиралы!\NЛонгинустың
Dialogue: 0,0:19:27.37,0:19:29.25,Default,,0,0,0,,
Dialogue: 0,0:19:32.54,0:19:34.79,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:19:41.34,0:19:43.30,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:19:47.18,0:19:48.68,Default,,0,0,0,,...
Dialogue: 0,0:19:48.77,0:19:51.23,Default,,0,0,0,,Өлім спиралы шешілді!
Dialogue: 0,0:19:51.31,0:19:52.98,Default,,0,0,0,,Валькирия жарылысы
Dialogue: 0,0:19:56.32,0:19:57.57,Default,,0,0,0,,Рослонгинус
Dialogue: 0,0:19:57.65,0:20:00.15,Default,,0,0,0,,2 ұпай
Dialogue: 0,0:20:00.24,0:20:02.20,Default,,0,0,0,,Rideout 6-3 есебімен жеңеді
Dialogue: 0,0:20:02.65,0:20:03.61,Default,,0,0,0,,Га
Dialogue: 0,0:20:04.57,0:20:06.24,Default,,0,0,0,,(Луидің күлкісі)
Dialogue: 0,0:20:06.33,0:20:07.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:08.45,0:20:13.75,Default,,0,0,0,,(Луидің күлкісі)
Dialogue: 0,0:20:13.83,0:20:16.38,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:20:16.71,0:20:21.01,Default,,0,0,0,,Ұлттық турнирдің командалық жарысында жеңімпаз команда - Ride Out
Dialogue: 0,0:20:21.22,0:20:23.18,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:20:27.14,0:20:28.22,Default,,0,0,0,,Мен
Dialogue: 0,0:20:28.43,0:20:29.81,Default,,0,0,0,,Сіз жеңілдіңіз бе?
Dialogue: 0,0:20:30.14,0:20:31.73,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,0:20:31.81,0:20:34.02,Default,,0,0,0,,Сізде әлі де жеке жарыстар бар, солай емес пе?
Dialogue: 0,0:20:34.10,0:20:35.40,Default,,0,0,0,,Бұл ауырсыну
Dialogue: 0,0:20:35.48,0:20:36.98,Default,,0,0,0,,Жеке шайқаста ойыңызды тазартыңыз.
Dialogue: 0,0:20:37.31,0:20:38.15,Default,,0,0,0,,О
Dialogue: 0,0:20:38.23,0:20:39.73,Default,,0,0,0,,Оны маған қалдыратын уақыт келді!
Dialogue: 0,0:20:40.07,0:20:42.82,Default,,0,0,0,,Екінші орын - Йонекома Гакуэн Бэй клубы
Dialogue: 0,0:20:42.90,0:20:43.86,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:20:43.95,0:20:45.32,Default,,0,0,0,,Кеттік
Dialogue: 0,0:20:48.58,0:20:49.41,Default,,0,0,0,,Уау
Dialogue: 0,0:20:49.49,0:20:50.58,Default,,0,0,0,,Ах
Dialogue: 0,0:20:51.66,0:20:56.12,Default,,0,0,0,,Уф... у... у...
Dialogue: 0,0:20:59.17,0:21:02.63,Default,,0,0,0,,(Балтоның айқайы)
Dialogue: 0,0:21:11.60,0:21:15.14,Default,,0,0,0,,(Балтоның айқайы)
Dialogue: 0,0:21:15.23,0:21:16.56,Default,,0,0,0,,Мен жеңілдім...
Dialogue: 0,0:21:17.15,0:21:18.40,Default,,0,0,0,,Бал аға
Dialogue: 0,0:21:18.48,0:21:19.61,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:21:19.94,0:21:21.98,Default,,0,0,0,,Жарайды, Барт
Dialogue: 0,0:21:22.65,0:21:25.95,Default,,0,0,0,,Сіз зиян келтірдіңіз, Киракира-кун.
Dialogue: 0,0:21:26.03,0:21:28.37,Default,,0,0,0,,Сіз бұл жерде бұзылатын адам емессіз.
Dialogue: 0,0:21:28.91,0:21:30.95,Default,,0,0,0,,Күміс медаль алыңыз
Dialogue: 0,0:21:31.03,0:21:32.49,Default,,0,0,0,,Барт
Dialogue: 0,0:21:33.33,0:21:34.33,Default,,0,0,0,,Өзі соққыны қабылдауға дайын қарсы шабуыл!
Dialogue: 0,0:21:42.55,0:21:43.59,Default,,0,0,0,,…Yes.
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.48,0:23:28.82,Default,,0,0,0,,Егер сіз Луиден жеңілсеңіз, ол аяқталмайды
Dialogue: 0,0:23:28.90,0:23:30.57,Default,,0,0,0,,Мен жеке матчта қайта ораламын.
Dialogue: 0,0:23:30.65,0:23:32.82,Default,,0,0,0,,Менің алдымда, қалпына келуге тырысады
Dialogue: 0,0:23:32.91,0:23:36.33,Default,,0,0,0,,Нова Нептунды пайдаланыңыз Наоки деген жігіт шығады.
Dialogue: 0,0:23:36.41,0:23:38.91,Default,,0,0,0,,Не? Анам жол апатына ұшырады ма?
Dialogue: 0,0:23:39.33,0:23:41.16,Default,,0,0,0,,Анашым, аман болыңыз!
Dialogue: 0,0:23:41.62,0:23:43.63,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:43.71,0:23:46.04,Default,,0,0,0,,Қабыл ал! Елімізде №1!
Dialogue: 0,0:23:46.13,0:23:47.84,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.92,0:23:49.46,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.96,0:23:56.96,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory