Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.09,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.17,0:00:12.47,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.63,0:00:14.76,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:16.97,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.05,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.52,0:00:24.23,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.31,0:00:26.27,Default,,0,0,0,,Бейде арманмен күрес
Dialogue: 0,0:00:26.35,0:00:28.86,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:33.36,0:00:36.70,Default,,0,0,0,,Балто мен сені құртамын.
Dialogue: 0,0:00:36.78,0:00:38.28,Default,,0,0,0,,Не!
Dialogue: 0,0:00:40.08,0:00:43.12,Default,,0,0,0,,Бұл «Аңдар» фильміндегі Инсуке Мидорикава.
Dialogue: 0,0:00:43.20,0:00:45.08,Default,,0,0,0,,Сіз жауды айтасыз...
Dialogue: 0,0:00:45.83,0:00:47.50,Default,,0,0,0,,Командалық жартылай финал
Dialogue: 0,0:00:48.13,0:00:51.55,Default,,0,0,0,,Біз Аңдармен Инусукемен күресеміз!
Dialogue: 0,0:00:53.38,0:00:54.30,Default,,0,0,0,,Куу!
Dialogue: 0,0:00:54.38,0:00:57.72,Default,,0,0,0,,Жүр! Тізбек ату!
Dialogue: 0,0:00:59.35,0:01:02.85,Default,,0,0,0,,Сіз қалай ойлайсыз? Дәл ортасында Рагнаруктың орны бар!
Dialogue: 0,0:01:02.93,0:01:04.52,Default,,0,0,0,,Уайымдамаңыз!
Dialogue: 0,0:01:12.40,0:01:13.90,Default,,0,0,0,,Рагнарук не болды?
Dialogue: 0,0:01:17.07,0:01:19.57,Default,,0,0,0,,Түсіндім, Кумичо!
Dialogue: 0,0:01:21.87,0:01:23.95,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:01:24.16,0:01:26.00,Default,,0,0,0,,О... шындап...
Dialogue: 0,0:01:26.29,0:01:27.54,Default,,0,0,0,,Нуа~!
Dialogue: 0,0:01:27.62,0:01:29.46,Default,,0,0,0,,(Жеңіс айқайы)
Dialogue: 0,0:01:30.67,0:01:34.26,Default,,0,0,0,,Кумичо, өкінішке орай, Инсукеден жеңіліп қалды.
Dialogue: 0,0:01:34.34,0:01:36.30,Default,,0,0,0,,Шайқас қазір басталады!
Dialogue: 0,0:01:44.77,0:01:47.14,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:47.48,0:01:52.65,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:02:03.95,0:02:07.33,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:02:07.83,0:02:09.96,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:02:10.38,0:02:14.50,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:14.63,0:02:17.84,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:02:17.97,0:02:24.39,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:24.68,0:02:29.10,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:29.60,0:02:35.02,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:35.15,0:02:37.40,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:37.49,0:02:42.20,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:42.37,0:02:47.45,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:47.75,0:02:50.00,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:50.21,0:02:52.54,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:52.83,0:02:56.75,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:56.92,0:03:01.93,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:03:02.14,0:03:04.30,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:08.02,0:03:10.94,Default,,0,0,0,,Аң! Бегемот хайуан!
Dialogue: 0,0:03:12.60,0:03:13.90,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:03:13.98,0:03:15.44,Default,,0,0,0,,Ұлдар мен қыздар!
Dialogue: 0,0:03:15.52,0:03:16.98,Default,,0,0,0,,Жартылай финал А блогы
Dialogue: 0,0:03:17.07,0:03:20.45,Default,,0,0,0,,Біріншіден, Аңдар алда, 1-0!
Dialogue: 0,0:03:20.53,0:03:23.62,Default,,0,0,0,,Енді екінші жүзу жалғасады.
Dialogue: 0,0:03:23.70,0:03:26.91,Default,,0,0,0,,Йонекома Гакуэн Бей клубы - Комурасаки Вакия
Dialogue: 0,0:03:27.24,0:03:30.00,Default,,0,0,0,,Аңдар – Рика Сакурадзима!
Dialogue: 0,0:03:30.08,0:03:33.00,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:33.08,0:03:35.71,Default,,0,0,0,,Бар күшіңізбен жүріңіз! Вакия!
Dialogue: 0,0:03:35.79,0:03:37.05,Default,,0,0,0,,Абайлаңыз!
Dialogue: 0,0:03:37.13,0:03:39.42,Default,,0,0,0,,Жарылып кетсе, памперс киюге тура келеді!
Dialogue: 0,0:03:40.09,0:03:42.34,Default,,0,0,0,,Мұны кімге айтуым керек?
Dialogue: 0,0:03:42.59,0:03:44.01,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:03:46.10,0:03:48.89,Default,,0,0,0,,Шығанақтағы жалынды сөндір
Dialogue: 0,0:03:48.97,0:03:52.56,Default,,0,0,0,,Виверннің күшіне қарасаң.
Dialogue: 0,0:03:52.64,0:03:54.48,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:03:54.56,0:03:57.98,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:03:58.07,0:04:00.28,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:00.36,0:04:01.40,Default,,0,0,0,,Хунга!
Dialogue: 0,0:04:01.49,0:04:04.32,Default,,0,0,0,,Мен Wild Wyvern орталығын аламын!
Dialogue: 0,0:04:05.37,0:04:08.37,Default,,0,0,0,,Ой, бұл қалқан ату!
Dialogue: 0,0:04:08.45,0:04:10.20,Default,,0,0,0,,Бетпе-бет шайқас!
Dialogue: 0,0:04:14.25,0:04:16.96,Default,,0,0,0,,Түсіндім, Shield Crash!
Dialogue: 0,0:04:19.05,0:04:21.76,Default,,0,0,0,,Арх! Мен оны ұшырып жіберуге рұқсат етіңіз!
Dialogue: 0,0:04:23.59,0:04:25.51,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:04:25.72,0:04:26.55,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:04:27.93,0:04:30.06,Default,,0,0,0,,Бұл шықты! Shield Crash!
Dialogue: 0,0:04:30.35,0:04:31.98,Default,,0,0,0,,Жабайы уайверн
Dialogue: 0,0:04:32.10,0:04:34.10,Default,,0,0,0,,2 ұпай
Dialogue: 0,0:04:34.19,0:04:36.27,Default,,0,0,0,,Найзағай сияқты!
Dialogue: 0,0:04:36.35,0:04:39.11,Default,,0,0,0,,Комурасаки Вакия Өлімге әкелетін соққы!
Dialogue: 0,0:04:39.19,0:04:41.07,Default,,0,0,0,,Қазір Йонекома Гакуэн Бей клубы
Dialogue: 0,0:04:41.15,0:04:43.61,Default,,0,0,0,,Есеп 2-1 болды!
Dialogue: 0,0:04:43.70,0:04:44.82,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:04:44.90,0:04:46.07,Default,,0,0,0,,Керемет, Вакия!
Dialogue: 0,0:04:46.16,0:04:48.91,Default,,0,0,0,,Аняро, сенің қолыңнан келеді!
Dialogue: 0,0:04:49.24,0:04:51.12,Default,,0,0,0,,Әрине.
Dialogue: 0,0:04:51.45,0:04:53.62,Default,,0,0,0,,Енді финалға өтуді мақсат етіңіз.
Dialogue: 0,0:04:53.71,0:04:56.87,Default,,0,0,0,,Екі команда арасындағы қызу тартыс жалғасуда!
Dialogue: 0,0:04:56.96,0:05:00.42,Default,,0,0,0,,Кім үшінші ұпайды алады және матчты шешеді!
Dialogue: 0,0:05:00.50,0:05:03.21,Default,,0,0,0,,Тағдырлы үшінші шайқасқа кіріңіз!
Dialogue: 0,0:05:03.67,0:05:04.97,Default,,0,0,0,,Жақсы
Dialogue: 0,0:05:05.05,0:05:07.01,Default,,0,0,0,,Маған осыншалықты көрсетуіңіз керек.
Dialogue: 0,0:05:07.09,0:05:09.18,Default,,0,0,0,,Мен финалға шыққандағы қарсыласым ретінде...
Dialogue: 0,0:05:09.26,0:05:10.76,Default,,0,0,0,,Бұл қызық емес.
Dialogue: 0,0:05:11.01,0:05:13.06,Default,,0,0,0,,Жарайсың Вакия!
Dialogue: 0,0:05:13.14,0:05:16.64,Default,,0,0,0,,Мен сенің қарызыңды еселеп қайтардым.
Dialogue: 0,0:05:16.73,0:05:18.56,Default,,0,0,0,,Вакия... сен...
Dialogue: 0,0:05:18.65,0:05:19.98,Default,,0,0,0,,Егер бұл сыпайылық болса, онда иә.
Dialogue: 0,0:05:20.06,0:05:23.44,Default,,0,0,0,,Бұл жоғалтқанын қайтару үшін күшті құбыжықтың рөлі.
Dialogue: 0,0:05:23.69,0:05:25.36,Default,,0,0,0,,Мен әлсізмін дейсің бе?
Dialogue: 0,0:05:25.45,0:05:26.78,Default,,0,0,0,,Y-ден көп
Dialogue: 0,0:05:26.86,0:05:30.58,Default,,0,0,0,,Қарғыс атсын... Мен саған ешқашан рахмет айтпаймын!
Dialogue: 0,0:05:30.95,0:05:32.54,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:05:32.62,0:05:34.08,Default,,0,0,0,,Бұл бетті жасама!
Dialogue: 0,0:05:34.75,0:05:37.21,Default,,0,0,0,,Мен жеңгім келеді! Капитан болуы керек!
Dialogue: 0,0:05:38.21,0:05:39.67,Default,,0,0,0,,Бегемот…
Dialogue: 0,0:05:39.79,0:05:41.29,Default,,0,0,0,,Мен ұмытқан жоқпын...
Dialogue: 0,0:05:41.75,0:05:43.38,Default,,0,0,0,,Сол кез туралы!
Dialogue: 0,0:05:45.92,0:05:48.76,Default,,0,0,0,,Жеңімпаз үш дүркін чемпион болды.
Dialogue: 0,0:05:48.84,0:05:50.76,Default,,0,0,0,,Бұл Ширасадиджо Луи!
Dialogue: 0,0:05:51.10,0:05:52.51,Default,,0,0,0,,Ей, жартылай жұмыс істейтін! Алдыңа шықшы, өтінемін!
Dialogue: 0,0:05:54.93,0:05:57.48,Default,,0,0,0,,Капитан... Бұлай алысқа барудың қажеті жоқ...
Dialogue: 0,0:05:57.85,0:05:58.64,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:58.73,0:06:00.27,Default,,0,0,0,,Дұрыс, араға үш жыл түсті.
Dialogue: 0,0:06:01.11,0:06:02.02,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:06:02.32,0:06:03.98,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:04.36,0:06:05.69,Default,,0,0,0,,Жақсы істедің, Иносукэ!
Dialogue: 0,0:06:07.11,0:06:08.95,Default,,0,0,0,,Тағы бір рет! Бегемот!
Dialogue: 0,0:06:09.36,0:06:11.37,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:11.45,0:06:12.83,Default,,0,0,0,,Жақсы істедің, Иносукэ!
Dialogue: 0,0:06:13.12,0:06:14.24,Default,,0,0,0,,Тағы бір рет!
Dialogue: 0,0:06:14.33,0:06:16.33,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:28.72,0:06:30.38,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:06:32.80,0:06:33.72,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:06:33.81,0:06:36.22,Default,,0,0,0,,Сіз қайтадан жарылып кетесіз бе?
Dialogue: 0,0:06:36.31,0:06:38.85,Default,,0,0,0,,Бұл жолы капитанның жеңіс сериясы рекорды...
Dialogue: 0,0:06:38.94,0:06:40.06,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:06:45.32,0:06:47.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:47.19,0:06:49.36,Default,,0,0,0,,Кеттік, Бегемот!
Dialogue: 0,0:06:52.28,0:06:54.03,Default,,0,0,0,,Үшінші қуық Алдыңғы
Dialogue: 0,0:06:54.12,0:06:56.58,Default,,0,0,0,,Жарайды, келесі менің кезегім!
Dialogue: 0,0:06:56.66,0:06:59.71,Default,,0,0,0,,Барт Сақ болыңыз
Dialogue: 0,0:07:00.12,0:07:02.33,Default,,0,0,0,,Азуки Бендің құбыжық Бегемоты -
Dialogue: 0,0:07:02.42,0:07:06.34,Default,,0,0,0,,Ол өзінің шынайы күшін шайқас соңында көрсетеді деген қауесет бар.
Dialogue: 0,0:07:06.42,0:07:08.76,Default,,0,0,0,,Бегемот шабуылдың түрі, солай ма?
Dialogue: 0,0:07:08.84,0:07:11.05,Default,,0,0,0,,Шапшаң шабуыл жасау сенің шеберлігің емес пе?
Dialogue: 0,0:07:11.13,0:07:12.51,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:07:12.59,0:07:15.30,Default,,0,0,0,,Мен Бегемоттың шайқас кадрларын қарадым, бірақ...
Dialogue: 0,0:07:16.18,0:07:18.02,Default,,0,0,0,,Барлығы бастапқы кезеңде шешіледі
Dialogue: 0,0:07:18.10,0:07:19.98,Default,,0,0,0,,Соңында не болғанын түсінбедім.
Dialogue: 0,0:07:20.94,0:07:23.40,Default,,0,0,0,,Бұл жай ғана тез жеңіске жету.
Dialogue: 0,0:07:23.48,0:07:24.81,Default,,0,0,0,,Y сияқты!
Dialogue: 0,0:07:24.90,0:07:27.57,Default,,0,0,0,,Ах! Қазір шеш, Балто!
Dialogue: 0,0:07:27.65,0:07:29.57,Default,,0,0,0,,О, оны маған қалдырыңыз!
Dialogue: 0,0:07:30.07,0:07:32.07,Default,,0,0,0,,Кел, жартылай финал А блогы
Dialogue: 0,0:07:32.16,0:07:34.20,Default,,0,0,0,,Қарау керек үшінші пышақ...
Dialogue: 0,0:07:34.62,0:07:37.45,Default,,0,0,0,,Ыстық Бей рухы құйын тудырады!
Dialogue: 0,0:07:37.54,0:07:39.00,Default,,0,0,0,,Йонекома Гакуэн шығанағы клубы
Dialogue: 0,0:07:39.08,0:07:41.58,Default,,0,0,0,,Капитан Балт Аои!
Dialogue: 0,0:07:43.04,0:07:46.67,Default,,0,0,0,,Аңды стадион деп аталатын торға жібереді!
Dialogue: 0,0:07:46.75,0:07:49.38,Default,,0,0,0,,Аңдар капитаны Азуки Бен!
Dialogue: 0,0:07:49.80,0:07:50.88,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:50.97,0:07:53.55,Default,,0,0,0,,Барто Аои! Сіздің шығанақ -
Dialogue: 0,0:07:53.93,0:07:56.80,Default,,0,0,0,,Мына хайуан бегемот оны жыртып тастайды!
Dialogue: 0,0:07:56.89,0:08:00.31,Default,,0,0,0,,...Не? Бұл жүргізуші пішіні
Dialogue: 0,0:08:00.39,0:08:02.52,Default,,0,0,0,,Соңы өте ыстық!
Dialogue: 0,0:08:03.31,0:08:05.61,Default,,0,0,0,,Бұл ұстау драйвері ме...
Dialogue: 0,0:08:05.69,0:08:08.11,Default,,0,0,0,,Мен шынайы нәрсені бірінші рет көріп тұрмын.
Dialogue: 0,0:08:08.19,0:08:10.99,Default,,0,0,0,,Ұшында табақшасы бар бұрағыш...
Dialogue: 0,0:08:11.07,0:08:12.86,Default,,0,0,0,,Бұл көп кездесе бермейтін түрі.
Dialogue: 0,0:08:12.95,0:08:15.74,Default,,0,0,0,,Маңыздысы сыртқы түрі емес, өнімділігі.
Dialogue: 0,0:08:16.28,0:08:17.87,Default,,0,0,0,,Драйверді ұстаңыз…
Dialogue: 0,0:08:18.37,0:08:20.41,Default,,0,0,0,,Маған бірдеңе бар сияқты...
Dialogue: 0,0:08:21.04,0:08:24.08,Default,,0,0,0,,Бұл шығанақ қалай қозғалады?
Dialogue: 0,0:08:24.67,0:08:26.13,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:08:26.46,0:08:27.67,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:08:28.34,0:08:31.34,Default,,0,0,0,,Бегемот Бұл сіздің олжаңыз!
Dialogue: 0,0:08:31.42,0:08:32.97,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:08:33.30,0:08:36.72,Default,,0,0,0,,Кеттік, Валькири! Мен міндетті түрде жеңемін!
Dialogue: 0,0:08:36.93,0:08:38.64,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:08:39.43,0:08:42.93,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:43.02,0:08:45.06,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:48.19,0:08:50.07,Default,,0,0,0,,Жүр!
Dialogue: 0,0:08:50.15,0:08:53.11,Default,,0,0,0,,Валькиридің шапшаң соққысы!
Dialogue: 0,0:08:54.95,0:08:57.41,Default,,0,0,0,,Балт шапшаң ату керек.
Dialogue: 0,0:08:57.49,0:08:59.53,Default,,0,0,0,,Жаңа қарсыласпен соғысқанда...
Dialogue: 0,0:08:59.62,0:09:01.20,Default,,0,0,0,,Өйткені әрқашан солай.
Dialogue: 0,0:09:01.87,0:09:03.79,Default,,0,0,0,,А, мен түсіндім!
Dialogue: 0,0:09:04.12,0:09:06.71,Default,,0,0,0,,Екінші жағынан, Бегемот ...
Dialogue: 0,0:09:07.33,0:09:08.29,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:09:08.79,0:09:12.09,Default,,0,0,0,,Ықшам жолмен Валькириге қарай бет алу...
Dialogue: 0,0:09:12.17,0:09:13.97,Default,,0,0,0,,Мен сізбен байланыса алмаймын!
Dialogue: 0,0:09:16.18,0:09:17.72,Default,,0,0,0,,Міне, тағы барамыз!
Dialogue: 0,0:09:17.80,0:09:20.30,Default,,0,0,0,,Біз әлі де бір-бірімізге шабуыл жасай алмаймыз!
Dialogue: 0,0:09:20.39,0:09:22.06,Default,,0,0,0,,Валькирия…
Dialogue: 0,0:09:22.22,0:09:24.48,Default,,0,0,0,,Аа, Валькири баяулады...
Dialogue: 0,0:09:24.56,0:09:26.23,Default,,0,0,0,,Қозғалыстар азайып барады!
Dialogue: 0,0:09:26.31,0:09:29.02,Default,,0,0,0,,Бегемотқа қарсы Стадионға көтерілу!
Dialogue: 0,0:09:29.11,0:09:31.23,Default,,0,0,0,,Ол әлі баяулаған жоқ!
Dialogue: 0,0:09:31.32,0:09:32.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:32.19,0:09:33.07,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:33.15,0:09:33.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:33.94,0:09:36.49,Default,,0,0,0,,Құлап қалма, мына жігіт...
Dialogue: 0,0:09:36.57,0:09:38.07,Default,,0,0,0,,Тезірек барады!
Dialogue: 0,0:09:38.53,0:09:40.32,Default,,0,0,0,,Жеңдер! Бегемот!
Dialogue: 0,0:09:40.53,0:09:42.08,Default,,0,0,0,,Бұл... бұл!
Dialogue: 0,0:09:42.16,0:09:44.50,Default,,0,0,0,,Бегемот жылдамдай бастады!
Dialogue: 0,0:09:46.54,0:09:50.33,Default,,0,0,0,,Шығанақтың дыбысы өзгерді. Жануар ақырып жатыр...
Dialogue: 0,0:09:51.00,0:09:52.80,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:09:53.21,0:09:55.01,Default,,0,0,0,,Бегемот құбыжық -
Dialogue: 0,0:09:55.09,0:09:58.34,Default,,0,0,0,,Әдетте жылдамдық төмендейді, бірақ ортаңғы кезеңнен кейін ол жылдамдайды...
Dialogue: 0,0:09:58.43,0:10:00.68,Default,,0,0,0,,Бей өзінің шабуылдарын көрсетеді...
Dialogue: 0,0:10:01.35,0:10:03.72,Default,,0,0,0,,Орташа қорғаныста күш көрсету дегеніміз...
Dialogue: 0,0:10:03.81,0:10:05.31,Default,,0,0,0,,Бұл болды!
Dialogue: 0,0:10:05.39,0:10:07.64,Default,,0,0,0,,Мені қуып жібер!
Dialogue: 0,0:10:07.73,0:10:10.52,Default,,0,0,0,,Мен Бегемот Валькириді қолға түсірдім!
Dialogue: 0,0:10:10.61,0:10:11.61,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:10:11.69,0:10:13.07,Default,,0,0,0,,Бірінші байланыс!
Dialogue: 0,0:10:13.15,0:10:15.36,Default,,0,0,0,,Бегемотты тістеп ал!
Dialogue: 0,0:10:15.44,0:10:17.24,Default,,0,0,0,,Үздік сызықты күшейтіңіз!
Dialogue: 0,0:10:18.70,0:10:21.07,Default,,0,0,0,,Аң азу тістерін ашты!
Dialogue: 0,0:10:21.16,0:10:22.95,Default,,0,0,0,,Бегемоттың құбыжық шабуылы...
Dialogue: 0,0:10:23.03,0:10:24.70,Default,,0,0,0,,Бұл тоқтамайды!
Dialogue: 0,0:10:25.12,0:10:28.12,Default,,0,0,0,,Валькириді өтірік айтып жатыр...
Dialogue: 0,0:10:28.79,0:10:31.04,Default,,0,0,0,,Мынау аң!
Dialogue: 0,0:10:31.13,0:10:33.92,Default,,0,0,0,,Валькири шыдай ала ма?!
Dialogue: 0,0:10:34.00,0:10:35.92,Default,,0,0,0,,Шабуыл, Валькири!
Dialogue: 0,0:10:37.92,0:10:40.64,Default,,0,0,0,,Валькири Раш қайтадан атылды!
Dialogue: 0,0:10:41.14,0:10:42.60,Default,,0,0,0,,Менің жолым өзгерді!
Dialogue: 0,0:10:42.68,0:10:43.64,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:43.85,0:10:45.39,Default,,0,0,0,,Ахахахахаха!
Dialogue: 0,0:10:45.47,0:10:48.06,Default,,0,0,0,,Бұл бұрынғыдай шығанақ па?
Dialogue: 0,0:10:48.52,0:10:50.81,Default,,0,0,0,,Бұл... Бегемот!
Dialogue: 0,0:10:50.90,0:10:51.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:51.90,0:10:55.02,Default,,0,0,0,,Жемін алған жабайы аң қуып келеді!
Dialogue: 0,0:10:55.11,0:10:56.94,Default,,0,0,0,,Ахх!
Dialogue: 0,0:11:01.32,0:11:02.87,Default,,0,0,0,,(үру)
Dialogue: 0,0:11:04.83,0:11:05.66,Default,,0,0,0,,2-раунд, 1-жекпе-жек
Dialogue: 0,0:11:05.74,0:11:08.33,Default,,0,0,0,,Валькири таң қалдырды!
Dialogue: 0,0:11:08.41,0:11:10.71,Default,,0,0,0,,Жақсы істедің, Иносукэ!
Dialogue: 0,0:11:11.29,0:11:13.67,Default,,0,0,0,,Бегемот тағы да шабуыл жасайды!
Dialogue: 0,0:11:14.29,0:11:16.34,Default,,0,0,0,,Азу тістері жемдікке бекінгенде...
Dialogue: 0,0:11:16.42,0:11:18.80,Default,,0,0,0,,Біз енді ешқашан ажырай алмаймыз!
Dialogue: 0,0:11:18.88,0:11:20.63,Default,,0,0,0,,Берілме, Валькири!
Dialogue: 0,0:11:22.55,0:11:23.59,Default,,0,0,0,,Oh?
Dialogue: 0,0:11:23.68,0:11:24.64,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:11:24.93,0:11:27.22,Default,,0,0,0,,Не, не, Валькири!
Dialogue: 0,0:11:27.31,0:11:30.06,Default,,0,0,0,,Мен аңның азу тістерін шешіп алдым!
Dialogue: 0,0:11:33.60,0:11:34.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:36.77,0:11:39.19,Default,,0,0,0,,Сәлем! Егер ол қабырғаға осылай соғылса...
Dialogue: 0,0:11:39.61,0:11:41.90,Default,,0,0,0,,Валькиридің жеңіліске ұшырауы!
Dialogue: 0,0:11:42.57,0:11:43.78,Default,,0,0,0,,Барт…
Dialogue: 0,0:11:45.95,0:11:47.70,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:11:49.75,0:11:51.16,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:11:51.75,0:11:53.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:57.34,0:11:58.30,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:11:58.38,0:12:00.30,Default,,0,0,0,,Әлі біткен жоқ!
Dialogue: 0,0:12:00.38,0:12:02.84,Default,,0,0,0,,Жоқ! Валькирияның керемет жауынгерлік рухы...
Dialogue: 0,0:12:02.93,0:12:04.30,Default,,0,0,0,,Әлі біткен жоқ!
Dialogue: 0,0:12:05.22,0:12:08.97,Default,,0,0,0,,Алға! Валькирия!
Dialogue: 0,0:12:10.64,0:12:12.52,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:12:14.77,0:12:16.36,Default,,0,0,0,,Бегемот!
Dialogue: 0,0:12:16.44,0:12:18.65,Default,,0,0,0,,Уууу!
Dialogue: 0,0:12:24.66,0:12:25.74,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:12:25.82,0:12:26.95,Default,,0,0,0,,Бегемот!
Dialogue: 0,0:12:27.49,0:12:29.66,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:12:33.58,0:12:37.17,Default,,0,0,0,,Сонымен... қайсысы бірінші құлады?
Dialogue: 0,0:12:37.25,0:12:40.00,Default,,0,0,0,,Валькири немесе Бегемот?
Dialogue: 0,0:12:40.59,0:12:43.22,Default,,0,0,0,,Енді назар аударарлық шешім қандай?
Dialogue: 0,0:12:43.84,0:12:45.55,Default,,0,0,0,,Валькирияның жеңісі
Dialogue: 0,0:12:45.63,0:12:47.64,Default,,0,0,0,,Артық бітіру үшін 1 ұпай
Dialogue: 0,0:12:47.72,0:12:49.93,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:50.22,0:12:52.68,Default,,0,0,0,,Жеңімпаз - Валькири!
Dialogue: 0,0:12:52.77,0:12:55.44,Default,,0,0,0,,Сіз аңның азу тістерін сәтті сындырдыңыз!
Dialogue: 0,0:12:55.94,0:12:59.19,Default,,0,0,0,,Йонекома Гакуэн Бей клубы 3-1 есебімен жеңіске жетті!
Dialogue: 0,0:13:01.15,0:13:03.32,Default,,0,0,0,,Жарайсың Балто!
Dialogue: 0,0:13:03.40,0:13:05.28,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:13:05.61,0:13:07.57,Default,,0,0,0,,Бұл дерлік болды!
Dialogue: 0,0:13:08.07,0:13:09.95,Default,,0,0,0,,Йонекома Гакуэн шығанағы клубы
Dialogue: 0,0:13:10.03,0:13:13.12,Default,,0,0,0,,Біз финалға өттік!
Dialogue: 0,0:13:13.33,0:13:15.25,Default,,0,0,0,,Мен жеңдім мен жеңдім!
Dialogue: 0,0:13:15.33,0:13:17.21,Default,,0,0,0,,Жасадың, ағайын!
Dialogue: 0,0:13:17.29,0:13:19.50,Default,,0,0,0,,Сен осындасың... Киракира-кун
Dialogue: 0,0:13:19.88,0:13:22.25,Default,,0,0,0,,Йонекома Гакуэн Бей клубы...
Dialogue: 0,0:13:25.22,0:13:27.47,Default,,0,0,0,,Мұндай қозғалысты көру үшін...
Dialogue: 0,0:13:27.93,0:13:29.72,Default,,0,0,0,,Балт... сен...
Dialogue: 0,0:13:30.30,0:13:33.02,Default,,0,0,0,,Жарайды, жеңіске жеткенше жүгіре берейік!
Dialogue: 0,0:13:33.10,0:13:34.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:34.60,0:13:36.98,Default,,0,0,0,,Жарайсың, Валькири!
Dialogue: 0,0:13:41.61,0:13:45.74,Default,,0,0,0,,Балто... Сені Бей жақсы көреді ғой.
Dialogue: 0,0:13:50.20,0:13:51.70,Default,,0,0,0,,Бегемот…
Dialogue: 0,0:13:52.70,0:13:54.75,Default,,0,0,0,,Ааааааа!
Dialogue: 0,0:13:54.83,0:13:56.08,Default,,0,0,0,,Бен?
Dialogue: 0,0:13:56.16,0:13:57.87,Default,,0,0,0,,Жақсы істедің, Иносукэ!
Dialogue: 0,0:13:57.96,0:13:59.29,Default,,0,0,0,,Балто!
Dialogue: 0,0:13:59.38,0:14:00.29,Default,,0,0,0,,Ақымақ адамдар—
Dialogue: 0,0:14:00.38,0:14:01.09,Default,,0,0,0,,Бал-нии!
Dialogue: 0,0:14:01.17,0:14:02.13,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:14:09.26,0:14:10.26,Default,,0,0,0,,Тағы да!
Dialogue: 0,0:14:11.89,0:14:13.01,Default,,0,0,0,,Мавару үшін!
Dialogue: 0,0:14:18.98,0:14:20.48,Default,,0,0,0,,О, жасайық!
Dialogue: 0,0:14:25.86,0:14:28.82,Default,,0,0,0,,(жылау)
Dialogue: 0,0:14:39.04,0:14:40.83,Default,,0,0,0,,Бұл керемет болды...
Dialogue: 0,0:14:40.96,0:14:42.96,Default,,0,0,0,,Бұл өте керемет болды...
Dialogue: 0,0:14:43.09,0:14:43.92,Default,,0,0,0,,О
Dialogue: 0,0:14:44.46,0:14:46.67,Default,,0,0,0,,Балто біртүрлі жігіт емес пе?
Dialogue: 0,0:14:46.76,0:14:47.55,Default,,0,0,0,,О
Dialogue: 0,0:14:47.63,0:14:48.88,Default,,0,0,0,,Сен ақымақсың
Dialogue: 0,0:14:48.97,0:14:51.09,Default,,0,0,0,,Тіке және жылы...
Dialogue: 0,0:14:51.64,0:14:52.51,Default,,0,0,0,,О
Dialogue: 0,0:14:53.43,0:14:56.43,Default,,0,0,0,,Бен мен Балто ұқсас...
Dialogue: 0,0:15:01.69,0:15:02.61,Default,,0,0,0,,О
Dialogue: 0,0:15:06.36,0:15:07.65,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:15:07.74,0:15:11.24,Default,,0,0,0,,Келесі - В жартылай финалдық блогы! қызыл бұрыш
Dialogue: 0,0:15:11.32,0:15:14.78,Default,,0,0,0,,Жарқыраған өнімділік - абсолютті күштіліктің дәлелі!
Dialogue: 0,0:15:14.87,0:15:17.66,Default,,0,0,0,,Жеңіске қызыл кілем жақындап қалды!
Dialogue: 0,0:15:17.75,0:15:20.29,Default,,0,0,0,,Келіңіздер! Супер жұлдыздар!
Dialogue: 0,0:15:22.37,0:15:23.58,Default,,0,0,0,,Ciao!
Dialogue: 0,0:15:23.67,0:15:26.30,Default,,0,0,0,,Барлығын күткенім үшін кешірім сұраймыз!
Dialogue: 0,0:15:26.38,0:15:28.92,Default,,0,0,0,,Бүгін де мен сендерге ерекше шайқас көрсетемін.
Dialogue: 0,0:15:29.01,0:15:30.34,Default,,0,0,0,,Хахан!
Dialogue: 0,0:15:30.42,0:15:33.39,Default,,0,0,0,,(жанкүйерлерден үлкен қолдау)
Dialogue: 0,0:15:33.80,0:15:35.72,Default,,0,0,0,,және көк бұрыш
Dialogue: 0,0:15:35.80,0:15:38.31,Default,,0,0,0,,Басқаларға кедергі келтіретін керемет күш!
Dialogue: 0,0:15:38.39,0:15:40.02,Default,,0,0,0,,Бірінші жеңімпаз үміткер!
Dialogue: 0,0:15:40.10,0:15:43.06,Default,,0,0,0,,Келіңіздер! Шығу!
Dialogue: 0,0:15:44.77,0:15:46.77,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:48.44,0:15:49.86,Default,,0,0,0,,Ал… біз Карт Титанмен біріктік ➡
Dialogue: 0,0:15:50.11,0:15:52.20,Default,,0,0,0,,Иә? Луи жоқ
Dialogue: 0,0:15:52.28,0:15:53.41,Default,,0,0,0,,Матака?
Dialogue: 0,0:15:53.49,0:15:56.45,Default,,0,0,0,,Ол бұрын ешқашан шықпаған.
Dialogue: 0,0:15:56.53,0:15:57.83,Default,,0,0,0,,Ол келмейді
Dialogue: 0,0:15:57.91,0:15:58.87,Default,,0,0,0,,А...
Dialogue: 0,0:15:59.29,0:16:01.08,Default,,0,0,0,,Ширасаги сарайы Луис…
Dialogue: 0,0:16:01.66,0:16:02.79,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:16:02.87,0:16:05.67,Default,,0,0,0,,Сіз командалық жарыстарға қызықпайсыз, Луи.
Dialogue: 0,0:16:07.42,0:16:11.05,Default,,0,0,0,,Қарсыласыма бір ұпай бермей алға шықтым.
Dialogue: 0,0:16:11.13,0:16:13.76,Default,,0,0,0,,Күшті командалар арасындағы қақтығыс!
Dialogue: 0,0:16:14.22,0:16:16.89,Default,,0,0,0,,Бұл шайқасқа мұқият қараңыз!
Dialogue: 0,0:16:16.97,0:16:20.22,Default,,0,0,0,,Ах! Зак бізге қандай шайқас көрсетеді?
Dialogue: 0,0:16:20.31,0:16:21.98,Default,,0,0,0,,Мен оны асыға күтемін!
Dialogue: 0,0:16:22.06,0:16:25.23,Default,,0,0,0,,Тағатсыздана күту... Сондай бос сөз...
Dialogue: 0,0:16:25.31,0:16:27.19,Default,,0,0,0,,Иә? Келесі жолы кім жеңеді -
Dialogue: 0,0:16:27.27,0:16:29.23,Default,,0,0,0,,Біздің жауымыз Котойя!
Dialogue: 0,0:16:29.32,0:16:30.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:31.11,0:16:33.74,Default,,0,0,0,,Көремін... келесі жау...
Dialogue: 0,0:16:34.28,0:16:35.82,Default,,0,0,0,,Жең, Зак
Dialogue: 0,0:16:35.95,0:16:38.78,Default,,0,0,0,,Мен жаншылған сенсің!
Dialogue: 0,0:16:39.28,0:16:41.20,Default,,0,0,0,,Бірінші пышақ Алдыңғы
Dialogue: 0,0:16:41.66,0:16:44.67,Default,,0,0,0,,Таң қалдырыңыз! Хаха!
Dialogue: 0,0:16:44.75,0:16:46.88,Default,,0,0,0,,Қандай супер жұлдыздар
Dialogue: 0,0:16:46.96,0:16:48.79,Default,,0,0,0,,Алдыңғы күміс пышақ Орочи орнына――
Dialogue: 0,0:16:48.88,0:16:50.71,Default,,0,0,0,,Капитан Зак!
Dialogue: 0,0:16:51.09,0:16:54.22,Default,,0,0,0,,Жанкүйерлер тығырыққа тірелуден шаршайды.
Dialogue: 0,0:16:54.34,0:16:56.59,Default,,0,0,0,,Жол жүру...
Dialogue: 0,0:16:57.51,0:17:00.97,Default,,0,0,0,,Капитан Сакаки Катана!
Dialogue: 0,0:17:01.06,0:17:02.60,Default,,0,0,0,,Райдауттың жеңісі -
Dialogue: 0,0:17:02.68,0:17:04.64,Default,,0,0,0,,Барлығы осы жігіттен басталды!
Dialogue: 0,0:17:04.73,0:17:07.56,Default,,0,0,0,,Бұл жолы да өткірлігіңді көрсетесің бе?
Dialogue: 0,0:17:08.90,0:17:10.06,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:17:10.31,0:17:13.36,Default,,0,0,0,,Хмм, сіз қатты сөйлейсіз.
Dialogue: 0,0:17:13.44,0:17:16.91,Default,,0,0,0,,Тұтынушы қарап отырғандықтан, мен одан бетер смайликпін!
Dialogue: 0,0:17:17.03,0:17:18.66,Default,,0,0,0,,Адам күлгенде...
Dialogue: 0,0:17:18.74,0:17:21.04,Default,,0,0,0,,Тек шыңды бағындырғанда
Dialogue: 0,0:17:21.12,0:17:22.95,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:17:23.16,0:17:26.75,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:26.83,0:17:28.58,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:29.04,0:17:31.75,Default,,0,0,0,,Енді Бейді атып тастады!
Dialogue: 0,0:17:31.84,0:17:32.88,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:17:34.13,0:17:35.05,Default,,0,0,0,,Иә
Dialogue: 0,0:17:35.13,0:17:36.38,Default,,0,0,0,,Мен күлдім...
Dialogue: 0,0:17:38.34,0:17:39.89,Default,,0,0,0,,Аққан жұлдыз...
Dialogue: 0,0:17:41.64,0:17:43.39,Default,,0,0,0,,Идоми күндегі...
Dialogue: 0,0:17:44.48,0:17:45.64,Default,,0,0,0,,Бейресми шашырау
Dialogue: 0,0:17:48.19,0:17:49.35,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:17:49.86,0:17:52.86,Default,,0,0,0,,Қайғылы және жалғыздық
Dialogue: 0,0:17:57.40,0:17:58.78,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:17:58.86,0:17:59.99,Default,,0,0,0,,Әдемі!
Dialogue: 0,0:18:00.45,0:18:03.49,Default,,0,0,0,,Зиллион Зевс 2 ұпай
Dialogue: 0,0:18:03.58,0:18:05.25,Default,,0,0,0,,Өте жақсы!
Dialogue: 0,0:18:05.33,0:18:06.87,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:18:06.96,0:18:09.37,Default,,0,0,0,,Оның үстіне өлең шығарған!
Dialogue: 0,0:18:09.96,0:18:12.84,Default,,0,0,0,,Ұрысқа арналған қысқаша нұсқа
Dialogue: 0,0:18:12.92,0:18:15.13,Default,,0,0,0,,Керемет Зак!
Dialogue: 0,0:18:15.59,0:18:17.09,Default,,0,0,0,,Сіз тым қалжыңдап тұрсыз!
Dialogue: 0,0:18:17.47,0:18:20.93,Default,,0,0,0,,Бірінші жұлдыздар 2 ұпай!
Dialogue: 0,0:18:21.01,0:18:24.77,Default,,0,0,0,,Ride Out Мен осы турнирде бірінші рет ұпай жоғалттым!
Dialogue: 0,0:18:25.31,0:18:28.31,Default,,0,0,0,,Қарғыс атсын... Тағы бір сәт, тезірек болса...
Dialogue: 0,0:18:28.73,0:18:30.23,Default,,0,0,0,,Сол күлкі...
Dialogue: 0,0:18:32.19,0:18:35.86,Default,,0,0,0,,Сіз ондағы барлық қозғалыстарды көрдіңіз бе... Зак?
Dialogue: 0,0:18:36.74,0:18:40.32,Default,,0,0,0,,Біз тұтынушыларымыздың көңілді болуын қамтамасыз етуіміз керек.
Dialogue: 0,0:18:40.78,0:18:43.87,Default,,0,0,0,,Енді екінші Blader!
Dialogue: 0,0:18:44.83,0:18:47.96,Default,,0,0,0,,Бэйді жақсы көретін айдол Мик!
Dialogue: 0,0:18:48.37,0:18:51.54,Default,,0,0,0,,Мен Зак үшін шешім қабылдаймын!
Dialogue: 0,0:18:51.63,0:18:54.25,Default,,0,0,0,,Және Rideout Underclassman
Dialogue: 0,0:18:54.34,0:18:56.42,Default,,0,0,0,,Саннай Кё!
Dialogue: 0,0:18:56.51,0:18:59.22,Default,,0,0,0,,Мен ағаның қарызын қайтарамын!
Dialogue: 0,0:19:00.22,0:19:02.18,Default,,0,0,0,,Аяқталды!
Dialogue: 0,0:19:02.26,0:19:05.76,Default,,0,0,0,,Екінші шайқаста Кио Саннай жеңді!
Dialogue: 0,0:19:06.06,0:19:08.10,Default,,0,0,0,,Сондай-ақ супер жұлдыздар-
Dialogue: 0,0:19:08.18,0:19:10.94,Default,,0,0,0,,Мен бұл турнирде бірінші рет ұпай жоғалттым!
Dialogue: 0,0:19:11.85,0:19:13.73,Default,,0,0,0,,Мен жарылуды көздедім...
Dialogue: 0,0:19:13.81,0:19:16.69,Default,,0,0,0,,Сенпай! Маған не болды?
Dialogue: 0,0:19:16.90,0:19:19.86,Default,,0,0,0,,Байқамайтын сенің жетілмегендігің.
Dialogue: 0,0:19:19.95,0:19:22.11,Default,,0,0,0,,Түсірілім түрі тәтті бола бастады.
Dialogue: 0,0:19:23.16,0:19:24.20,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:19:24.28,0:19:26.62,Default,,0,0,0,,Келесі жолы мен жарылыспен жеңемін!
Dialogue: 0,0:19:26.70,0:19:28.83,Default,,0,0,0,,Жартылай финалдан күткендей!
Dialogue: 0,0:19:28.91,0:19:31.75,Default,,0,0,0,,Ең мықтылар арасындағы кескілескен шайқас!
Dialogue: 0,0:19:32.17,0:19:35.79,Default,,0,0,0,,2-ден 1-ге дейінгі нүктелерге қараған үшінші жүзік...
Dialogue: 0,0:19:35.88,0:19:39.30,Default,,0,0,0,,Бейдің музыкасын тыңдайтын адам, Джинблейд Орочи!
Dialogue: 0,0:19:39.88,0:19:43.84,Default,,0,0,0,,Сіз тағы бір ұпай жинайсыз, Орочи.
Dialogue: 0,0:19:45.35,0:19:48.18,Default,,0,0,0,,Один тек жеңіс әуенін ойнайды.
Dialogue: 0,0:19:48.72,0:19:50.64,Default,,0,0,0,,Және Rideout...
Dialogue: 0,0:19:50.73,0:19:53.65,Default,,0,0,0,,Қатты басқару мұнарасы, үнсіз жауынгер
Dialogue: 0,0:19:53.73,0:19:56.11,Default,,0,0,0,,Капитан Go Chakake!
Dialogue: 0,0:19:56.69,0:19:58.94,Default,,0,0,0,,Го Чакакенің Гигант Гайасы -
Dialogue: 0,0:19:59.03,0:20:01.61,Default,,0,0,0,,Ол Шуумен бірдей баланс түрі.
Dialogue: 0,0:20:01.70,0:20:05.07,Default,,0,0,0,,Шабуыл және қорғаныс: екеуін де пайдалана аламын ба?
Dialogue: 0,0:20:05.16,0:20:07.62,Default,,0,0,0,,Қызық, бұл қандай шайқас болады!
Dialogue: 0,0:20:10.41,0:20:11.62,Default,,0,0,0,,Гая…
Dialogue: 0,0:20:17.17,0:20:19.13,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:22.88,0:20:24.09,Default,,0,0,0,,(Су шашыраған дыбысы)
Dialogue: 0,0:20:24.18,0:20:25.97,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:26.47,0:20:27.51,Default,,0,0,0,,Әлі де тәтті!
Dialogue: 0,0:20:27.72,0:20:29.89,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:30.31,0:20:32.27,Default,,0,0,0,,Уайымдама, кет!
Dialogue: 0,0:20:32.35,0:20:34.56,Default,,0,0,0,,Бұл тым көп!
Dialogue: 0,0:20:34.65,0:20:35.81,Default,,0,0,0,,(Су шашыраған дыбысы)
Dialogue: 0,0:20:35.90,0:20:37.06,Default,,0,0,0,,L-дің бұйрығы бойынша тергеу штабынан тыс ешкім — тіпті орынбасар бастықты да қоса алғанда —
Dialogue: 0,0:20:37.15,0:20:38.77,Default,,0,0,0,,Әлі де сенімді емеспін!
Dialogue: 0,0:20:39.07,0:20:41.44,Default,,0,0,0,,Өте дәл көлденең түсіру…
Dialogue: 0,0:20:41.90,0:20:43.86,Default,,0,0,0,,Егер ол сәтті болса, Гайя ...
Dialogue: 0,0:20:44.45,0:20:46.32,Default,,0,0,0,,Ең күшті шығанақ бол!
Dialogue: 0,0:20:47.12,0:20:49.49,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:50.87,0:20:53.00,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:53.25,0:20:55.42,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:21:02.92,0:21:04.09,Default,,0,0,0,,Куу…
Dialogue: 0,0:21:07.30,0:21:09.89,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:21:09.97,0:21:13.02,Default,,0,0,0,,Ауырлық центрі ауысады, Гигант Гайаның айналмалы бұлыңғырлығы...
Dialogue: 0,0:21:13.10,0:21:15.48,Default,,0,0,0,,Оны жақсы басқарып, орталықты алсаңыз...
Dialogue: 0,0:21:16.06,0:21:17.10,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:21:17.27,0:21:18.86,Default,,0,0,0,,Қазіргісі жақсы.
Dialogue: 0,0:21:19.86,0:21:21.61,Default,,0,0,0,,Гаямен байланысты
Dialogue: 0,0:21:23.69,0:21:24.95,Default,,0,0,0,,Луис…
Dialogue: 0,0:21:27.86,0:21:28.95,Default,,0,0,0,,Гая…
Dialogue: 0,0:21:30.53,0:21:33.00,Default,,0,0,0,,Содан бері біз бір болдық.
Dialogue: 0,0:21:34.41,0:21:35.75,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:21:36.33,0:21:38.29,Default,,0,0,0,,Бұл соңғы қозғалыс.
Dialogue: 0,0:21:39.04,0:21:41.30,Default,,0,0,0,,Гая маған опасыздық жасамайды!
Dialogue: 0,0:21:41.46,0:21:43.76,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:21:43.84,0:21:46.84,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:21:46.93,0:21:49.09,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.36,0:23:28.32,Default,,0,0,0,,Командалық финалға дейін...
Dialogue: 0,0:23:28.40,0:23:32.66,Default,,0,0,0,,Хабар тарату бөлімі Bay Club үшін арнайы бағдарлама дайындайды!
Dialogue: 0,0:23:32.74,0:23:35.53,Default,,0,0,0,,Қарсылас командасына шабуыл жасау!
Dialogue: 0,0:23:35.62,0:23:38.66,Default,,0,0,0,,Шешуші шайқас алдындағы тиісті ойларымыз
Dialogue: 0,0:23:38.75,0:23:41.41,Default,,0,0,0,,Барлығына хабарлау үшін бар күшімді саламын!
Dialogue: 0,0:23:41.50,0:23:43.75,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:43.83,0:23:45.54,Default,,0,0,0,,Ұшу қаупі!
Dialogue: 0,0:23:45.63,0:23:47.34,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.42,0:23:49.13,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.63,0:23:56.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory