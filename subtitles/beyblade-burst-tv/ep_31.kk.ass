Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.59,0:00:09.17,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.25,0:00:12.51,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.67,0:00:14.72,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.80,0:00:16.97,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.05,0:00:18.68,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.52,0:00:24.10,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.19,0:00:26.15,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.23,0:00:28.73,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:36.45,0:00:37.99,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:40.16,0:00:44.37,Default,,0,0,0,,Йонекома Гакуэн Бэй клубы екінші айналымға өтеді
Dialogue: 0,0:00:44.75,0:00:47.00,Default,,0,0,0,,Келесі мен пайда боламын
Dialogue: 0,0:00:47.08,0:00:49.17,Default,,0,0,0,,Шаканы Уай жеңді.
Dialogue: 0,0:00:49.25,0:00:51.88,Default,,0,0,0,,Сіз капитан емессіз, солай ма?
Dialogue: 0,0:00:51.96,0:00:53.01,Default,,0,0,0,,Өз еркімен шешім қабылдамаңыз
Dialogue: 0,0:00:53.09,0:00:56.80,Default,,0,0,0,,Мен біреумен аралассам, ұпай аламын.
Dialogue: 0,0:00:57.01,0:00:58.05,Default,,0,0,0,,Әрине.
Dialogue: 0,0:00:58.14,0:00:59.22,Default,,0,0,0,,Бұл алғашқы «Глория».
Dialogue: 0,0:00:59.30,0:01:00.22,Default,,0,0,0,,Не!
Dialogue: 0,0:01:00.31,0:01:01.64,Default,,0,0,0,,Екеуің де тоқтаңдар.
Dialogue: 0,0:01:02.35,0:01:04.23,Default,,0,0,0,,Мен бірінші раундта жеңдім, бірақ
Dialogue: 0,0:01:04.31,0:01:05.81,Default,,0,0,0,,Команда шашырап кетті
Dialogue: 0,0:01:05.89,0:01:07.10,Default,,0,0,0,,Мұның бәрі күрес туралы.
Dialogue: 0,0:01:07.90,0:01:09.81,Default,,0,0,0,,Мен капитанмын
Dialogue: 0,0:01:09.90,0:01:11.61,Default,,0,0,0,,Бірдеңе істеу керек
Dialogue: 0,0:01:19.78,0:01:22.16,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:22.49,0:01:27.67,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:38.97,0:01:42.35,Default,,0,0,0,,Мен барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:42.85,0:01:44.97,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:45.39,0:01:49.52,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:49.65,0:01:52.86,Default,,0,0,0,,Дұрыс, бетпе-бет.
Dialogue: 0,0:01:52.98,0:01:59.41,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:01:59.70,0:02:04.12,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:04.62,0:02:10.04,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:10.17,0:02:12.42,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:12.50,0:02:17.22,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:17.38,0:02:22.47,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:22.76,0:02:25.01,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:25.22,0:02:27.56,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:27.85,0:02:31.77,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:31.94,0:02:36.94,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:37.15,0:02:39.32,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:43.24,0:02:45.37,Default,,0,0,0,,Amaterios нұсқаулығы
Dialogue: 0,0:02:47.04,0:02:49.87,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:02:49.96,0:02:53.75,Default,,0,0,0,,Team Rideout екінші турға өтеді!
Dialogue: 0,0:02:53.84,0:02:55.75,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:02:55.84,0:02:59.55,Default,,0,0,0,,Енді сіз күткен келесі нәрсе.
Dialogue: 0,0:03:00.17,0:03:02.14,Default,,0,0,0,,Түскі ас уақыты!
Dialogue: 0,0:03:02.43,0:03:04.39,Default,,0,0,0,,Ах
Dialogue: 0,0:03:04.47,0:03:05.81,Default,,0,0,0,,Эхехе...
Dialogue: 0,0:03:07.22,0:03:10.18,Default,,0,0,0,,Аммммммм
Dialogue: 0,0:03:10.27,0:03:12.90,Default,,0,0,0,,Ананың наны дәмді ғой.
Dialogue: 0,0:03:12.98,0:03:15.32,Default,,0,0,0,,Жеңіске жеткеннен кейін бұл қажет емес.
Dialogue: 0,0:03:15.40,0:03:17.40,Default,,0,0,0,,Сіз ұтқан жоқсыз.
Dialogue: 0,0:03:17.48,0:03:19.53,Default,,0,0,0,,Матчқа қатысуға болмайды.
Dialogue: 0,0:03:19.65,0:03:21.74,Default,,0,0,0,,Әй, әрекетіңді жина.
Dialogue: 0,0:03:21.82,0:03:23.87,Default,,0,0,0,,Тек шындықты айт
Dialogue: 0,0:03:23.95,0:03:25.53,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:03:25.62,0:03:27.91,Default,,0,0,0,,Айтпасаң, Бейдің қолын көтер.
Dialogue: 0,0:03:27.99,0:03:28.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:28.70,0:03:30.20,Default,,0,0,0,,Екеуің доғарыңдар.
Dialogue: 0,0:03:30.41,0:03:31.16,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:31.25,0:03:33.08,Default,,0,0,0,,Жеңілген адам шығады деп үміттенемін.
Dialogue: 0,0:03:34.00,0:03:37.67,Default,,0,0,0,,Мен сенімен біржолата реттеу керек деп ойладым. Вакия!
Dialogue: 0,0:03:37.75,0:03:40.47,Default,,0,0,0,,Иә, мен оны кез келген уақытта қабылдаймын.
Dialogue: 0,0:03:40.55,0:03:41.72,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:03:41.80,0:03:43.55,Default,,0,0,0,,Ах
Dialogue: 0,0:03:43.64,0:03:44.64,Default,,0,0,0,,Уау
Dialogue: 0,0:03:45.60,0:03:46.60,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,0:03:46.68,0:03:48.47,Default,,0,0,0,,Балт-кун, жақсысың ба?
Dialogue: 0,0:03:48.77,0:03:50.98,Default,,0,0,0,,А-а... Фай жобу
Dialogue: 0,0:03:53.27,0:03:54.65,Default,,0,0,0,,Хмф!
Dialogue: 0,0:03:58.02,0:03:59.19,Default,,0,0,0,,Күтілгендей...
Dialogue: 0,0:03:59.28,0:04:01.99,Default,,0,0,0,,Капитан жеңілсе жақсы емес.
Dialogue: 0,0:04:02.45,0:04:03.86,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:16.71,0:04:17.92,Default,,0,0,0,,Арнайы дайындық!
Dialogue: 0,0:04:18.00,0:04:19.84,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:26.93,0:04:28.26,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:04:28.35,0:04:32.27,Default,,0,0,0,,(Жаттығу жасап жатқан ұлдардың дауысы)
Dialogue: 0,0:04:32.52,0:04:34.89,Default,,0,0,0,,Мен капитанмын.
Dialogue: 0,0:04:34.98,0:04:37.06,Default,,0,0,0,,Мен одан да күшті болуым керек
Dialogue: 0,0:04:38.11,0:04:40.15,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:42.07,0:04:42.90,Default,,0,0,0,,Ах
Dialogue: 0,0:04:45.20,0:04:46.53,Default,,0,0,0,,Ааа~
Dialogue: 0,0:04:46.61,0:04:47.70,Default,,0,0,0,,Паккунчо
Dialogue: 0,0:04:47.78,0:04:50.91,Default,,0,0,0,,Мен аймақты іріктеу турнирін жеңдім деп ойламаймын.
Dialogue: 0,0:04:50.99,0:04:52.87,Default,,0,0,0,,Қандай керемет сәтсіз кадр.
Dialogue: 0,0:04:52.95,0:04:53.83,Default,,0,0,0,,Ах
Dialogue: 0,0:04:54.04,0:04:55.33,Default,,0,0,0,,Инуске!
Dialogue: 0,0:04:55.42,0:04:57.25,Default,,0,0,0,,Бұл Инуске емес пе?
Dialogue: 0,0:04:57.33,0:04:58.25,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:04:58.63,0:05:00.55,Default,,0,0,0,,Тым көп күш
Dialogue: 0,0:05:00.63,0:05:03.26,Default,,0,0,0,,Сіз матчта жеңіліп қаламын ба деп уайымдайсыз, солай ма?
Dialogue: 0,0:05:03.42,0:05:04.34,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:04.55,0:05:05.80,Default,,0,0,0,,Ах
Dialogue: 0,0:05:06.34,0:05:07.55,Default,,0,0,0,,Инсуке
Dialogue: 0,0:05:07.64,0:05:10.35,Default,,0,0,0,,Сіздің дәл қазіргі шайқасыңыз керемет болды.
Dialogue: 0,0:05:10.43,0:05:12.85,Default,,0,0,0,,Ей, сен шынымен күшті болып кеттің.
Dialogue: 0,0:05:13.06,0:05:14.27,Default,,0,0,0,,Эх-хэ-хэ
Dialogue: 0,0:05:14.35,0:05:15.23,Default,,0,0,0,,Сонда да...
Dialogue: 0,0:05:15.31,0:05:16.81,Default,,0,0,0,,Иә, бар.
Dialogue: 0,0:05:16.89,0:05:19.31,Default,,0,0,0,,Командалық сайыста кім жеңеді?
Dialogue: 0,0:05:19.40,0:05:21.27,Default,,0,0,0,,Өйткені біз хайуанбыз.
Dialogue: 0,0:05:21.36,0:05:23.40,Default,,0,0,0,,Оның күшті болуы табиғи нәрсе.
Dialogue: 0,0:05:23.61,0:05:26.07,Default,,0,0,0,,Жеңімпаз - Йонекома Гакуэн.
Dialogue: 0,0:05:26.15,0:05:26.99,Default,,0,0,0,,Аңдар
Dialogue: 0,0:05:27.07,0:05:28.32,Default,,0,0,0,,Йонекома академиясы
Dialogue: 0,0:05:28.41,0:05:29.32,Default,,0,0,0,,Аңдар
Dialogue: 0,0:05:29.41,0:05:31.41,Default,,0,0,0,,Йонекома академиясы
Dialogue: 0,0:05:31.49,0:05:32.87,Default,,0,0,0,,Жоқ, солай емес пе?
Dialogue: 0,0:05:33.45,0:05:35.41,Default,,0,0,0,,Сонымен, қазір жарысқа қатысасың ба?
Dialogue: 0,0:05:35.50,0:05:37.67,Default,,0,0,0,,Жақсы, тікенді бассың.
Dialogue: 0,0:05:37.75,0:05:39.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:40.25,0:05:41.63,Default,,0,0,0,,Уау
Dialogue: 0,0:05:41.71,0:05:44.01,Default,,0,0,0,,Не болып жатыр? Бұл қауіпті, солай емес пе?
Dialogue: 0,0:05:44.21,0:05:46.76,Default,,0,0,0,,Менің әріптестеріммен араласпа
Dialogue: 0,0:05:47.05,0:05:49.68,Default,,0,0,0,,Мағынасы жоқ не айтып тұрсың?
Dialogue: 0,0:05:49.76,0:05:50.68,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:50.76,0:05:51.85,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:51.93,0:05:53.81,Default,,0,0,0,,Ей, эй, екеуің де.
Dialogue: 0,0:05:53.89,0:05:54.77,Default,,0,0,0,,Гефу
Dialogue: 0,0:05:54.85,0:05:55.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:55.93,0:05:56.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:57.35,0:05:58.48,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:59.40,0:06:01.65,Default,,0,0,0,,О... күте тұрыңыз, Бен.
Dialogue: 0,0:06:01.73,0:06:04.15,Default,,0,0,0,,Не болды?
Dialogue: 0,0:06:04.23,0:06:06.11,Default,,0,0,0,,Ах! (Инсуке/Барт) Иә?
Dialogue: 0,0:06:07.86,0:06:08.95,Default,,0,0,0,,О
Dialogue: 0,0:06:09.03,0:06:09.91,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:06:13.24,0:06:16.83,Default,,0,0,0,,Кәне, бәріміз, түскі ас уақыты аяқталды.
Dialogue: 0,0:06:16.91,0:06:20.58,Default,,0,0,0,,Түстен кейінгі ұйқышылдықты кетіретін қызықты шайқас.
Dialogue: 0,0:06:20.67,0:06:22.09,Default,,0,0,0,,Бұл бастама!
Dialogue: 0,0:06:22.67,0:06:25.09,Default,,0,0,0,,Сіз Балтомен төбелесіп жатырмын деп ойладыңыз ба?
Dialogue: 0,0:06:25.17,0:06:26.17,Default,,0,0,0,,О
Dialogue: 0,0:06:26.26,0:06:29.01,Default,,0,0,0,,Өйткені, бұл Точири Хаято.
Dialogue: 0,0:06:29.09,0:06:30.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:30.26,0:06:33.51,Default,,0,0,0,,Жарайды, көңілімізді көтерейік.
Dialogue: 0,0:06:33.60,0:06:35.56,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:41.10,0:06:42.69,Default,,0,0,0,,Міне, барамын!
Dialogue: 0,0:06:42.77,0:06:45.57,Default,,0,0,0,,Жарық аяқтау арқылы 2 ұпай алыңыз
Dialogue: 0,0:06:46.48,0:06:48.11,Default,,0,0,0,,Аяқталды!
Dialogue: 0,0:06:48.19,0:06:50.07,Default,,0,0,0,,Екінші турға өту
Dialogue: 0,0:06:50.15,0:06:51.91,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:53.53,0:06:55.70,Default,,0,0,0,,Бұл біртүрлі болды, солай емес пе?
Dialogue: 0,0:06:56.12,0:06:57.25,Default,,0,0,0,,Бұрынғы Балто
Dialogue: 0,0:06:57.33,0:06:58.04,Default,,0,0,0,,О
Dialogue: 0,0:06:58.12,0:07:01.46,Default,,0,0,0,,Білмеймін, бірақ бұл әдеттегі Балто емес еді.
Dialogue: 0,0:07:02.00,0:07:03.71,Default,,0,0,0,,Ол жақсы көрінді, бірақ
Dialogue: 0,0:07:04.09,0:07:05.63,Default,,0,0,0,,Кейінірек оралыңыз
Dialogue: 0,0:07:05.75,0:07:06.59,Default,,0,0,0,,Бен
Dialogue: 0,0:07:06.67,0:07:08.59,Default,,0,0,0,,Сіз қымбатты доссыз, солай емес пе?
Dialogue: 0,0:07:09.55,0:07:10.84,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:11.68,0:07:15.43,Default,,0,0,0,,Енді бұл бірінші раунд, соңғы шайқас.
Dialogue: 0,0:07:15.76,0:07:19.85,Default,,0,0,0,,Біріншіден, қызыл бұрыштан көрінетін нәрсе
Dialogue: 0,0:07:21.06,0:07:24.19,Default,,0,0,0,,Күлгіндер тобы
Dialogue: 0,0:07:24.52,0:07:27.15,Default,,0,0,0,,Және Аокого қарсы...
Dialogue: 0,0:07:27.23,0:07:28.94,Default,,0,0,0,,Не?
Dialogue: 0,0:07:29.03,0:07:31.03,Default,,0,0,0,,Жұлдыз жарығы
Dialogue: 0,0:07:32.24,0:07:34.03,Default,,0,0,0,,Барлық жұлдыздар жарқырайды
Dialogue: 0,0:07:34.12,0:07:36.83,Default,,0,0,0,,Күн шыққанша өткінші арман
Dialogue: 0,0:07:38.24,0:07:39.37,Default,,0,0,0,,Ал қазір
Dialogue: 0,0:07:39.62,0:07:41.54,Default,,0,0,0,,Күн пайда болады
Dialogue: 0,0:07:42.42,0:07:44.33,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:07:44.42,0:07:45.92,Default,,0,0,0,,Керемет
Dialogue: 0,0:07:46.00,0:07:47.55,Default,,0,0,0,,Сол жақтағы кішкентайлардың бірі қателесіп қолы тисе, қауіпті болар еді ғой, иә?
Dialogue: 0,0:07:47.67,0:07:51.30,Default,,0,0,0,,Күн өз сәулесін баса алмайды
Dialogue: 0,0:07:51.38,0:07:53.63,Default,,0,0,0,,Кя~
Dialogue: 0,0:07:54.26,0:07:56.93,Default,,0,0,0,,Күннің айналасында жұлдыздар болғандықтан
Dialogue: 0,0:07:57.14,0:07:59.18,Default,,0,0,0,,Менің де айналамда ұжым бар.
Dialogue: 0,0:07:59.56,0:08:01.68,Default,,0,0,0,,Жұлдыздар арасында жарқыраған
Dialogue: 0,0:08:01.77,0:08:03.35,Default,,0,0,0,,Супер команда
Dialogue: 0,0:08:03.44,0:08:04.94,Default,,0,0,0,,Супер жұлдыздар
Dialogue: 0,0:08:06.77,0:08:07.94,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:08.02,0:08:10.90,Default,,0,0,0,,Капитан Зактың өзі мүшелерді таныстырады.
Dialogue: 0,0:08:11.32,0:08:13.91,Default,,0,0,0,,шығанақ ойнаған музыканы тыңдап тұрған адам
Dialogue: 0,0:08:13.99,0:08:15.74,Default,,0,0,0,,Обелиск Один
Dialogue: 0,0:08:15.82,0:08:17.62,Default,,0,0,0,,Күміс жүзі Орочи
Dialogue: 0,0:08:18.12,0:08:19.37,Default,,0,0,0,,Иә, Орочи?
Dialogue: 0,0:08:19.45,0:08:21.87,Default,,0,0,0,,Бұл командада Орочи бар ма?
Dialogue: 0,0:08:22.08,0:08:24.21,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:08:24.29,0:08:25.88,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:08:25.96,0:08:28.29,Default,,0,0,0,,Рагнарук қарсылас кім болса да жеңеді.
Dialogue: 0,0:08:28.38,0:08:30.59,Default,,0,0,0,,Келесі жолы сіздің кезегіңіз деп үміттенемін.
Dialogue: 0,0:08:30.67,0:08:31.42,Default,,0,0,0,,Ал мына бағана бар.
Dialogue: 0,0:08:31.51,0:08:32.34,Default,,0,0,0,,Тыныш
Dialogue: 0,0:08:32.67,0:08:35.43,Default,,0,0,0,,Зак сөйлеп тұр, үндеме.
Dialogue: 0,0:08:35.51,0:08:36.55,Default,,0,0,0,,Яғни, сіз полиция қызметкерісіз ғой, иә? Не істеп отырсыз өзі?
Dialogue: 0,0:08:37.14,0:08:40.47,Default,,0,0,0,,Бірінші раундтағы бірінші жүзуші Орочи болады.
Dialogue: 0,0:08:40.56,0:08:41.43,Default,,0,0,0,,Haha~n
Dialogue: 0,0:08:41.52,0:08:43.14,Default,,0,0,0,,Эй
Dialogue: 0,0:08:43.39,0:08:47.40,Default,,0,0,0,,Мен қарсыласыма маңызды ұрыс тәртібін айттым!
Dialogue: 0,0:08:47.61,0:08:50.36,Default,,0,0,0,,Бұл бұрын-соңды болмаған алдын ала қарау шайқасы.
Dialogue: 0,0:08:50.65,0:08:52.44,Default,,0,0,0,,Жалаған Манет
Dialogue: 0,0:08:52.53,0:08:53.90,Default,,0,0,0,,Ха ха хан~н
Dialogue: 0,0:08:53.99,0:08:57.03,Default,,0,0,0,,Мен саған рахмет айта алмаймын, Күлгін.
Dialogue: 0,0:08:57.32,0:09:00.12,Default,,0,0,0,,Өйткені бұл жердегі барлық адамдарға арналған.
Dialogue: 0,0:09:00.20,0:09:02.95,Default,,0,0,0,,Тек ләззат алу үшін Wink!
Dialogue: 0,0:09:03.04,0:09:05.37,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:05.67,0:09:09.34,Default,,0,0,0,,Бұл бізді әдейі ашуландыратын және қателесетін стратегия ма?
Dialogue: 0,0:09:09.79,0:09:12.88,Default,,0,0,0,,Келесі екінші қуық – мен.
Dialogue: 0,0:09:13.46,0:09:15.26,Default,,0,0,0,,Жарқыраған батыр
Dialogue: 0,0:09:15.34,0:09:17.18,Default,,0,0,0,,Барлығын нұрландыратын нұр
Dialogue: 0,0:09:17.34,0:09:18.97,Default,,0,0,0,,Пұт Күн
Dialogue: 0,0:09:19.05,0:09:21.85,Default,,0,0,0,,Зак Күн сәулесі
Dialogue: 0,0:09:22.85,0:09:24.89,Default,,0,0,0,,(қарау)
Dialogue: 0,0:09:26.10,0:09:28.65,Default,,0,0,0,,Жұлдыздармен таныстырайық
Dialogue: 0,0:09:28.98,0:09:32.07,Default,,0,0,0,,Фредди Боуи Мик
Dialogue: 0,0:09:32.40,0:09:35.07,Default,,0,0,0,,Бейді жақсы көретін үш пұт
Dialogue: 0,0:09:38.16,0:09:40.37,Default,,0,0,0,,Бұл олардың кезегі емес.
Dialogue: 0,0:09:40.70,0:09:42.70,Default,,0,0,0,,Екеуміздің арамызда шешеміз.
Dialogue: 0,0:09:42.79,0:09:43.87,Default,,0,0,0,,Haha~n
Dialogue: 0,0:09:43.95,0:09:48.33,Default,,0,0,0,,О, құдай, алдын ала қарау шайқасынан кейінгі ең қысқа жеңіс туралы мәлімдеме
Dialogue: 0,0:09:48.42,0:09:50.59,Default,,0,0,0,,Енді күлгіндер кім болады?
Dialogue: 0,0:09:50.67,0:09:53.50,Default,,0,0,0,,Мен Зактың қолында ойнамаймын. Мен тынышпын.
Dialogue: 0,0:09:53.59,0:09:57.51,Default,,0,0,0,,Один шықса мен барамын, себебі қорғаныста басымдылығым бар.
Dialogue: 0,0:09:57.59,0:09:58.55,Default,,0,0,0,,О
Dialogue: 0,0:09:59.55,0:10:03.56,Default,,0,0,0,,Бірінші Blader - Ginblade Orochi VS Shun Fujimaru
Dialogue: 0,0:10:04.06,0:10:05.56,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:10:08.94,0:10:10.73,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:10:11.44,0:10:14.19,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:14.48,0:10:16.86,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:20.24,0:10:22.66,Default,,0,0,0,,Екі соққы да сәтті болды.
Dialogue: 0,0:10:23.12,0:10:24.66,Default,,0,0,0,,Бұл кәдімгі дыбыс.
Dialogue: 0,0:10:24.74,0:10:26.70,Default,,0,0,0,,Ортаны алып, қорғау
Dialogue: 0,0:10:28.66,0:10:30.04,Default,,0,0,0,,Санау қажет емес
Dialogue: 0,0:10:31.29,0:10:32.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:32.17,0:10:34.75,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:10:35.34,0:10:38.59,Default,,0,0,0,,Жарық Финиш Superstars 2 ұпай
Dialogue: 0,0:10:38.67,0:10:41.01,Default,,0,0,0,,
Dialogue: 0,0:10:41.64,0:10:44.64,Default,,0,0,0,,Күтілгендей, ол сіздің үміттеріңізді ақтайды.
Dialogue: 0,0:10:44.93,0:10:47.85,Default,,0,0,0,,Бірінші раундта уақыт алсаңыз, сіз жеңе алмайсыз.
Dialogue: 0,0:10:47.93,0:10:49.44,Default,,0,0,0,,Дұрыс, капитан
Dialogue: 0,0:10:49.52,0:10:50.48,Default,,0,0,0,,Haha~n
Dialogue: 0,0:10:50.56,0:10:53.77,Default,,0,0,0,,Білемін, бұл әлі аңғал
Dialogue: 0,0:10:56.36,0:10:57.86,Default,,0,0,0,,Бәріңіз күттіңіздер ме?
Dialogue: 0,0:10:58.99,0:11:01.20,Default,,0,0,0,,Сіз мені күткенсіз...
Dialogue: 0,0:11:03.20,0:11:04.83,Default,,0,0,0,,Циллион Зевс
Dialogue: 0,0:11:04.91,0:11:07.87,Default,,0,0,0,,Мен көптен күттім~
Dialogue: 0,0:11:07.95,0:11:10.46,Default,,0,0,0,,Иә? сол шығанақ
Dialogue: 0,0:11:11.37,0:11:12.67,Default,,0,0,0,,Түсінде шайқас
Dialogue: 0,0:11:12.75,0:11:15.13,Default,,0,0,0,,Бейблейд маскасына өте ұқсас
Dialogue: 0,0:11:15.67,0:11:18.38,Default,,0,0,0,,Мен әлі күнге дейін сол шайқас арман болды деп ойлаймын.
Dialogue: 0,0:11:18.46,0:11:20.34,Default,,0,0,0,,Бұл арман емес
Dialogue: 0,0:11:20.63,0:11:22.09,Default,,0,0,0,,Екінші өргіш
Dialogue: 0,0:11:22.18,0:11:24.26,Default,,0,0,0,,Зак Риота Насуға қарсы
Dialogue: 0,0:11:24.47,0:11:27.10,Default,,0,0,0,,Төзімділік түрі Зевске не тиімді?
Dialogue: 0,0:11:27.18,0:11:29.60,Default,,0,0,0,,Шабуыл түрі Менің кезегім
Dialogue: 0,0:11:32.19,0:11:34.86,Default,,0,0,0,,Рахмет хаха~
Dialogue: 0,0:11:35.06,0:11:38.28,Default,,0,0,0,,Мен сенен бұйра да, жүз жағынан да артықпын.
Dialogue: 0,0:11:38.36,0:11:40.28,Default,,0,0,0,,Мен мұны еске саламын.
Dialogue: 0,0:11:40.74,0:11:41.90,Default,,0,0,0,,Haha~n
Dialogue: 0,0:11:41.99,0:11:43.74,Default,,0,0,0,,Бұл қызық.
Dialogue: 0,0:11:44.28,0:11:45.62,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:11:48.04,0:11:49.70,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:11:50.37,0:11:53.29,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:53.62,0:11:56.92,Default,,0,0,0,,Барып түсіру
Dialogue: 0,0:12:03.97,0:12:06.68,Default,,0,0,0,,Екі соққы да сәтті болды.
Dialogue: 0,0:12:06.93,0:12:09.72,Default,,0,0,0,,Zillion Zeus орталығына барыңыз.
Dialogue: 0,0:12:09.93,0:12:12.23,Default,,0,0,0,,Маған рұқсат етіңіз, әйтпесе мен сізді үрлеймін
Dialogue: 0,0:12:12.31,0:12:13.60,Default,,0,0,0,,Жүр!
Dialogue: 0,0:12:20.28,0:12:22.57,Default,,0,0,0,,Айналамда жұлдыздар жымыңдайды
Dialogue: 0,0:12:22.90,0:12:24.66,Default,,0,0,0,,Хмм, жақсы
Dialogue: 0,0:12:25.53,0:12:28.49,Default,,0,0,0,,Уа, Зак, не болып жатыр?
Dialogue: 0,0:12:28.95,0:12:31.12,Default,,0,0,0,,Менің күшімнен қорықты ма?
Dialogue: 0,0:12:31.45,0:12:32.62,Default,,0,0,0,,Haha~n
Dialogue: 0,0:12:32.87,0:12:35.83,Default,,0,0,0,,Айналамда жұлдыздар жымыңдайды
Dialogue: 0,0:12:37.17,0:12:39.25,Default,,0,0,0,,Біртүрлі әуенді тыңдау кезінде
Dialogue: 0,0:12:41.01,0:12:44.05,Default,,0,0,0,,Тағдырдың үнсіз дөңгелегі
Dialogue: 0,0:12:44.38,0:12:46.39,Default,,0,0,0,,Шабуыл жасай беріңіз!
Dialogue: 0,0:12:46.47,0:12:48.60,Default,,0,0,0,,Әй, сенің көздерің
Dialogue: 0,0:12:49.47,0:12:51.93,Default,,0,0,0,,Келесі супер кумир - мен
Dialogue: 0,0:12:52.31,0:12:54.98,Default,,0,0,0,,Махаббат пен жеңіс раушан гүлдерін ұсыну
Dialogue: 0,0:12:57.48,0:12:58.40,Default,,0,0,0,,Ах
Dialogue: 0,0:12:58.61,0:13:00.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:03.69,0:13:06.07,Default,,0,0,0,,Бұл өлең саған
Dialogue: 0,0:13:07.87,0:13:10.03,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:13:10.37,0:13:12.66,Default,,0,0,0,,Зак шайқаста
Dialogue: 0,0:13:12.75,0:13:14.16,Default,,0,0,0,,Өлең шығардым!
Dialogue: 0,0:13:14.25,0:13:16.08,Default,,0,0,0,,Қандай сән-салтанат!
Dialogue: 0,0:13:16.54,0:13:18.92,Default,,0,0,0,,Циллион Зевстің жарылуы
Dialogue: 0,0:13:19.00,0:13:21.38,Default,,0,0,0,,Супер жұлдыздар 4-0 есебімен жеңіске жетті
Dialogue: 0,0:13:22.05,0:13:25.30,Default,,0,0,0,,Zack the Sunshine тамаша жеңіспен
Dialogue: 0,0:13:25.38,0:13:27.55,Default,,0,0,0,,Көңіл көтеруші ретінде шынайы әлеуетіңізді көрсетіңіз
Dialogue: 0,0:13:27.76,0:13:30.93,Default,,0,0,0,,Беймен көп ойнамаңыз.
Dialogue: 0,0:13:31.01,0:13:33.31,Default,,0,0,0,,Зак осылай жасайды.
Dialogue: 0,0:13:33.39,0:13:36.89,Default,,0,0,0,,Сіздің әлеуетіңізді толық ашатын орта жасаңыз
Dialogue: 0,0:13:36.98,0:13:40.31,Default,,0,0,0,,Бүкіл спектакль Бей үшін болды ма?
Dialogue: 0,0:13:40.40,0:13:41.44,Default,,0,0,0,,Иә
Dialogue: 0,0:13:43.32,0:13:44.99,Default,,0,0,0,,Керемет сахна
Dialogue: 0,0:13:45.07,0:13:47.40,Default,,0,0,0,,Аудиторияның назары қаншалықты көп болса, соғұрлым көп
Dialogue: 0,0:13:47.49,0:13:48.91,Default,,0,0,0,,Күштілігін көрсетіңіз
Dialogue: 0,0:13:49.37,0:13:51.74,Default,,0,0,0,,Бұл Зак есімді қуық.
Dialogue: 0,0:13:52.08,0:13:54.75,Default,,0,0,0,,Зак, ол сондай күшті.
Dialogue: 0,0:13:54.83,0:13:55.83,Default,,0,0,0,,О
Dialogue: 0,0:13:56.00,0:13:59.42,Default,,0,0,0,,Жеңімпаздар супер жұлдыздар болды.
Dialogue: 0,0:13:59.50,0:14:02.92,Default,,0,0,0,,Екінші айналымға өтетін барлық командалар анықталды.
Dialogue: 0,0:14:03.00,0:14:06.22,Default,,0,0,0,,Жеңіске жеткендердің барлығын құттықтаймыз!
Dialogue: 0,0:14:06.30,0:14:09.59,Default,,0,0,0,,Келесі жолы командалық сайыстың екінші кезеңі.
Dialogue: 0,0:14:09.84,0:14:13.76,Default,,0,0,0,,(Адамдар сөйлейді)
Dialogue: 0,0:14:14.06,0:14:16.68,Default,,0,0,0,,Сонымен, Аңдармен бәрі жақсы болып жатыр ма?
Dialogue: 0,0:14:16.77,0:14:17.81,Default,,0,0,0,,Ал...
Dialogue: 0,0:14:17.89,0:14:20.23,Default,,0,0,0,,Бұл шайқастан да сезілді.
Dialogue: 0,0:14:20.60,0:14:21.90,Default,,0,0,0,,Эхехехе...
Dialogue: 0,0:14:22.86,0:14:25.94,Default,,0,0,0,,Капитан Бен екеуміз біртүрлі араласамыз.
Dialogue: 0,0:14:26.44,0:14:28.07,Default,,0,0,0,,Сізбен бірге болу қызық
Dialogue: 0,0:14:28.15,0:14:30.36,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:14:31.12,0:14:33.49,Default,,0,0,0,,Мұның несі тыныштандырады?
Dialogue: 0,0:14:35.04,0:14:37.58,Default,,0,0,0,,Кенет ол жүгіріп келіп, маған жалт қарады.
Dialogue: 0,0:14:38.66,0:14:40.88,Default,,0,0,0,,Менде шамалы түсініспеушілік болды.
Dialogue: 0,0:14:40.96,0:14:43.42,Default,,0,0,0,,Әлі ерте, кешіріңізші.
Dialogue: 0,0:14:43.50,0:14:45.63,Default,,0,0,0,,Бен де кешірім сұрады.
Dialogue: 0,0:14:45.71,0:14:47.55,Default,,0,0,0,,Бұл бетті жасама
Dialogue: 0,0:14:47.63,0:14:49.22,Default,,0,0,0,,Күл, күл
Dialogue: 0,0:14:49.30,0:14:50.55,Default,,0,0,0,,Ха... хаха
Dialogue: 0,0:14:50.63,0:14:52.30,Default,,0,0,0,,Мен сонда болдым, сонда болдым
Dialogue: 0,0:14:52.39,0:14:53.93,Default,,0,0,0,,Мені кешіріңіз.
Dialogue: 0,0:14:54.76,0:14:57.22,Default,,0,0,0,,Інісікенің достары менің достарым.
Dialogue: 0,0:14:57.31,0:14:58.31,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:58.39,0:15:00.23,Default,,0,0,0,,Бен мұны естігенде қуанады.
Dialogue: 0,0:15:00.44,0:15:03.02,Default,,0,0,0,,Мен қазірдің өзінде Beasts мүшесімін.
Dialogue: 0,0:15:03.11,0:15:05.94,Default,,0,0,0,,Инсуке Мен ол жақта жақсы достар таптым.
Dialogue: 0,0:15:06.03,0:15:07.15,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:15:07.23,0:15:08.61,Default,,0,0,0,,Ауырды, Кумичо.
Dialogue: 0,0:15:08.69,0:15:10.24,Default,,0,0,0,,Идиот күші
Dialogue: 0,0:15:10.45,0:15:11.74,Default,,0,0,0,,Азуки Бен
Dialogue: 0,0:15:11.82,0:15:14.41,Default,,0,0,0,,Ол осы турнирде тамашалайтын ойыншылардың бірі.
Dialogue: 0,0:15:14.62,0:15:17.20,Default,,0,0,0,,Мен де оның шайқасын көргім келді.
Dialogue: 0,0:15:17.87,0:15:21.04,Default,,0,0,0,,Ол бірінші турға қатысқан үш адамның арасында болмады.
Dialogue: 0,0:15:21.29,0:15:24.38,Default,,0,0,0,,Бен бірінші раундқа шығуды жоспарлаған жоқ.
Dialogue: 0,0:15:24.46,0:15:26.50,Default,,0,0,0,,Оны бізге қалдырды.
Dialogue: 0,0:15:29.21,0:15:31.59,Default,,0,0,0,,Сенің қолыңнан келеді, мен сенемін.
Dialogue: 0,0:15:32.01,0:15:32.97,Default,,0,0,0,,Хо
Dialogue: 0,0:15:33.05,0:15:36.31,Default,,0,0,0,,Сыртқа шыққысы келетін кейбір капитаннан мүлде басқаша.
Dialogue: 0,0:15:36.39,0:15:37.35,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:37.43,0:15:38.89,Default,,0,0,0,,Тәртіпке бер, жаным.
Dialogue: 0,0:15:39.14,0:15:41.19,Default,,0,0,0,,Жалғыз сөйлеу және ешкім...
Dialogue: 0,0:15:41.27,0:15:44.77,Default,,0,0,0,,Оның үстіне ойланбай жеңілдім деп айта алмаймын.
Dialogue: 0,0:15:44.86,0:15:46.36,Default,,0,0,0,,Сен мұны айтпадың ба?
Dialogue: 0,0:15:48.40,0:15:49.86,Default,,0,0,0,,Сәлем
Dialogue: 0,0:15:50.57,0:15:53.45,Default,,0,0,0,,Мұнда Бейблейд мұражайы бар.
Dialogue: 0,0:15:54.37,0:15:56.08,Default,,0,0,0,,Біріншіден, біз оның кім екенін анықтауымыз керек.
Dialogue: 0,0:15:56.16,0:15:57.70,Default,,0,0,0,,Тез, тез
Dialogue: 0,0:15:58.41,0:16:01.12,Default,,0,0,0,,Уау, қаншама шығанақ бар
Dialogue: 0,0:16:01.21,0:16:02.50,Default,,0,0,0,,Бұл таңқаларлық.
Dialogue: 0,0:16:03.87,0:16:04.92,Default,,0,0,0,,Иә
Dialogue: 0,0:16:05.04,0:16:06.29,Default,,0,0,0,,Уау~
Dialogue: 0,0:16:06.38,0:16:09.88,Default,,0,0,0,,Бұл қарияның бала кезінде соғысқан биі ме?
Dialogue: 0,0:16:10.34,0:16:12.59,Default,,0,0,0,,Мен оны Сутаға да көрсеткім келеді.
Dialogue: 0,0:16:14.55,0:16:18.06,Default,,0,0,0,,Бөшкеде әрқашан бір нәрсе дұрыс емес
Dialogue: 0,0:16:21.52,0:16:23.44,Default,,0,0,0,,Ой, бұл стадион ғой.
Dialogue: 0,0:16:23.77,0:16:26.23,Default,,0,0,0,,Басқа ештеңе жоқ сияқты.
Dialogue: 0,0:16:26.48,0:16:27.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:27.65,0:16:28.90,Default,,0,0,0,,Қазірше тек сен мен мен ғана оралдық.
Dialogue: 0,0:16:28.98,0:16:30.23,Default,,0,0,0,,Үйге барасыз ба?
Dialogue: 0,0:16:30.99,0:16:32.19,Default,,0,0,0,,Не?
Dialogue: 0,0:16:32.70,0:16:34.32,Default,,0,0,0,,«Не?»
Dialogue: 0,0:16:34.41,0:16:37.32,Default,,0,0,0,,Мына жігіт, өтінемін, оны жалғыз қалдырмадыңыз ба?
Dialogue: 0,0:16:37.41,0:16:40.12,Default,,0,0,0,,Бұл шайқас болуы керек, солай ма? Шайқас
Dialogue: 0,0:16:40.20,0:16:41.54,Default,,0,0,0,,Жасайық, Балто
Dialogue: 0,0:16:42.20,0:16:44.29,Default,,0,0,0,,Стадион бар.
Dialogue: 0,0:16:44.62,0:16:47.88,Default,,0,0,0,,А... дұрыс, істейік.
Dialogue: 0,0:16:50.92,0:16:52.63,Default,,0,0,0,,Кеттік.
Dialogue: 0,0:16:59.76,0:17:00.76,Default,,0,0,0,,Inusuke?
Dialogue: 0,0:17:00.85,0:17:01.64,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:17:02.60,0:17:05.10,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:05.52,0:17:07.73,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:12.36,0:17:13.15,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:17:13.24,0:17:14.74,Default,,0,0,0,,Бар, Валькири!
Dialogue: 0,0:17:18.78,0:17:19.45,Default,,0,0,0,,Га
Dialogue: 0,0:17:19.99,0:17:21.95,Default,,0,0,0,,Сіздің әдеттегі асығыс атуыңыз емес
Dialogue: 0,0:17:22.16,0:17:24.71,Default,,0,0,0,,Не болды, Валькири?
Dialogue: 0,0:17:29.96,0:17:31.50,Default,,0,0,0,,Ах
Dialogue: 0,0:17:32.71,0:17:35.22,Default,,0,0,0,,(еденге құлаған шығанақтың дыбысы)
Dialogue: 0,0:17:35.30,0:17:36.88,Default,,0,0,0,,Сізді не уайымдады?
Dialogue: 0,0:17:37.01,0:17:37.89,Default,,0,0,0,,Е...
Dialogue: 0,0:17:38.14,0:17:40.05,Default,,0,0,0,,Жоқ... бұл ештеңе емес.
Dialogue: 0,0:17:40.22,0:17:42.06,Default,,0,0,0,,Барт…
Dialogue: 0,0:17:44.10,0:17:44.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:45.64,0:17:47.31,Default,,0,0,0,,Кешіріңіз Инуске
Dialogue: 0,0:17:48.40,0:17:52.32,Default,,0,0,0,,Бірақ мен капитанмын, сондықтан бар күшімді салуым керек.
Dialogue: 0,0:17:53.03,0:17:53.90,Default,,0,0,0,,Га
Dialogue: 0,0:17:57.74,0:17:58.70,Default,,0,0,0,,Барт
Dialogue: 0,0:18:00.16,0:18:01.74,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:18:02.16,0:18:03.83,Default,,0,0,0,,Бұл қай шығанақ?
Dialogue: 0,0:18:03.91,0:18:06.41,Default,,0,0,0,,Аңызға айналған Amaterios шығанағы
Dialogue: 0,0:18:06.50,0:18:07.96,Default,,0,0,0,,Бұл осында болды.
Dialogue: 0,0:18:08.17,0:18:08.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:09.08,0:18:10.21,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:18:10.42,0:18:12.63,Default,,0,0,0,,Мен сенің шынымен күшті екеніңді естідім.
Dialogue: 0,0:18:12.71,0:18:14.17,Default,,0,0,0,,Өте танымал
Dialogue: 0,0:18:15.01,0:18:16.55,Default,,0,0,0,,Әуесқойлар
Dialogue: 0,0:18:19.34,0:18:22.14,Default,,0,0,0,,Мен, мына жігітпен ұрысамын.
Dialogue: 0,0:18:22.22,0:18:23.35,Default,,0,0,0,,Бұл мүмкін емес
Dialogue: 0,0:18:23.43,0:18:24.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:24.39,0:18:26.68,Default,,0,0,0,,Мен пайдаланып жатқан пышақ қазір жоқ.
Dialogue: 0,0:18:26.77,0:18:28.81,Default,,0,0,0,,Міне, сондықтан
Dialogue: 0,0:18:28.89,0:18:30.06,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:30.85,0:18:33.57,Default,,0,0,0,,Бұл жігіт қандай шайқас болды деп ойлаймын.
Dialogue: 0,0:18:34.11,0:18:35.40,Default,,0,0,0,,Қандай дыбыспен?
Dialogue: 0,0:18:35.57,0:18:37.03,Default,,0,0,0,,Қандай қозғалыс түрі
Dialogue: 0,0:18:37.28,0:18:39.45,Default,,0,0,0,,Ол қаншалықты ғажайып болды?
Dialogue: 0,0:18:39.70,0:18:41.32,Default,,0,0,0,,Сәлем Валькири
Dialogue: 0,0:18:43.28,0:18:45.49,Default,,0,0,0,,Бұл жігітпен қандай шайқас болғанын қалайсыз?
Dialogue: 0,0:18:46.37,0:18:49.16,Default,,0,0,0,,Сіз қалай күресесіз? валкири
Dialogue: 0,0:18:50.96,0:18:52.33,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:18:52.42,0:18:55.09,Default,,0,0,0,,Қатты ұрысқым келеді.
Dialogue: 0,0:18:55.17,0:18:56.42,Default,,0,0,0,,Жасайық, Инуске
Dialogue: 0,0:18:56.51,0:18:57.21,Default,,0,0,0,,Иә
Dialogue: 0,0:18:58.26,0:19:00.05,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:19:00.88,0:19:02.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:02.68,0:19:05.43,Default,,0,0,0,,Неліктен сен ғана ұрысып жатырсың?
Dialogue: 0,0:19:05.51,0:19:07.31,Default,,0,0,0,,Мені кейінірек ауыстырыңыз.
Dialogue: 0,0:19:07.52,0:19:09.39,Default,,0,0,0,,Жеңіс Валькири қарсы.
Dialogue: 0,0:19:09.48,0:19:11.48,Default,,0,0,0,,Кайзер Сербеус
Dialogue: 0,0:19:11.69,0:19:13.15,Default,,0,0,0,,Барыңды істе, ағайын.
Dialogue: 0,0:19:13.23,0:19:14.77,Default,,0,0,0,,Inusuke Fight!
Dialogue: 0,0:19:14.98,0:19:17.11,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:19:17.48,0:19:20.32,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:20.40,0:19:22.99,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:26.58,0:19:28.45,Default,,0,0,0,,Тез ату!
Dialogue: 0,0:19:30.08,0:19:32.12,Default,,0,0,0,,Мен оның келе жатқанын білемін.
Dialogue: 0,0:19:33.38,0:19:34.33,Default,,0,0,0,,Жалтардыңыз ба?
Dialogue: 0,0:19:38.17,0:19:40.72,Default,,0,0,0,,Раш асығыс~
Dialogue: 0,0:19:41.51,0:19:42.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:42.55,0:19:43.76,Default,,0,0,0,,Сол қозғалыс
Dialogue: 0,0:19:43.89,0:19:46.35,Default,,0,0,0,,Ол асығыс атудан бас тартқан сияқты.
Dialogue: 0,0:19:46.56,0:19:48.14,Default,,0,0,0,,Оянған Валькирия
Dialogue: 0,0:19:48.22,0:19:51.27,Default,,0,0,0,,Жылдамдық артқан сайын шыдамдылығыңыз жоғалуы керек.
Dialogue: 0,0:19:51.64,0:19:53.10,Default,,0,0,0,,Әлі жоқ!
Dialogue: 0,0:19:54.86,0:19:57.77,Default,,0,0,0,,Тек Кербеустан жалтарыңыз.
Dialogue: 0,0:19:57.86,0:20:00.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:03.20,0:20:05.82,Default,,0,0,0,,Ха, Кербейдің жолы өзгерді.
Dialogue: 0,0:20:08.08,0:20:08.99,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:20:09.08,0:20:10.12,Default,,0,0,0,,Cerbeus!
Dialogue: 0,0:20:16.46,0:20:18.00,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:20:18.42,0:20:20.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:21.13,0:20:23.51,Default,,0,0,0,,(Сузуя) Адамдар әрдайым бір жерде өліп жатады ғой, иә?
Dialogue: 0,0:20:25.14,0:20:27.43,Default,,0,0,0,,Burst... Burst Finish
Dialogue: 0,0:20:27.51,0:20:29.89,Default,,0,0,0,,Жеңіс Валькирияның жеңісі
Dialogue: 0,0:20:31.31,0:20:33.77,Default,,0,0,0,,Бұл шайқас керемет болды.
Dialogue: 0,0:20:34.56,0:20:35.35,Default,,0,0,0,,Иә
Dialogue: 0,0:20:35.77,0:20:38.23,Default,,0,0,0,,Жарайды, Инуске, тағы бір рет.
Dialogue: 0,0:20:38.44,0:20:41.69,Default,,0,0,0,,Маған тағы бір рет қарашы. Керемет шайқас болайық.
Dialogue: 0,0:20:42.36,0:20:43.99,Default,,0,0,0,,Бұл Барт, солай емес пе?
Dialogue: 0,0:20:44.36,0:20:45.24,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:45.45,0:20:46.70,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:20:47.07,0:20:48.91,Default,,0,0,0,,Өйткені Балт - Балт.
Dialogue: 0,0:20:49.58,0:20:51.83,Default,,0,0,0,,I... I
Dialogue: 0,0:20:54.00,0:20:55.29,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:56.08,0:20:58.79,Default,,0,0,0,,Мен өзім болғаным дұрыс.
Dialogue: 0,0:20:59.29,0:21:00.38,Default,,0,0,0,,Инсуке
Dialogue: 0,0:21:00.96,0:21:02.17,Default,,0,0,0,,Рақмет.
Dialogue: 0,0:21:04.13,0:21:05.34,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:21:06.09,0:21:12.10,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:21:12.22,0:21:14.85,Default,,0,0,0,,Жауабын тапқан сияқтысың, Балто.
Dialogue: 0,0:21:17.40,0:21:18.86,Default,,0,0,0,,Сенің Ат арбаларыңның қозғалысы мен күші—
Dialogue: 0,0:21:18.98,0:21:20.82,Default,,0,0,0,,Бүгін де арнайы дайындық~
Dialogue: 0,0:21:20.90,0:21:22.78,Default,,0,0,0,,Үлкен аға, сен қатты толқыдың~
Dialogue: 0,0:21:22.86,0:21:24.99,Default,,0,0,0,,Ынталы болу деген жоқ.
Dialogue: 0,0:21:25.07,0:21:27.20,Default,,0,0,0,,Бұл кәдімгі Балто, солай ма?
Dialogue: 0,0:21:27.57,0:21:31.12,Default,,0,0,0,,Көңіліңіз түсіп кетсе де тітіркендіреді.
Dialogue: 0,0:21:31.70,0:21:35.04,Default,,0,0,0,,Бәріміз екінші айналымға жаттығу жасайық!
Dialogue: 0,0:21:35.12,0:21:36.79,Default,,0,0,0,,(Тікұшақтың ұшу дыбысы)
Dialogue: 0,0:21:36.92,0:21:38.04,Default,,0,0,0,,Не?
Dialogue: 0,0:21:38.25,0:21:38.92,Default,,0,0,0,,Яғни
Dialogue: 0,0:21:39.00,0:21:42.38,Default,,0,0,0,,(Тікұшақтың ұшу дыбысы)
Dialogue: 0,0:21:47.18,0:21:49.26,Default,,0,0,0,,Бейблейд маскасы бола ма?
Dialogue: 0,0:21:52.14,0:21:54.27,Default,,0,0,0,,Киран
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Артынан қуып барсаң, көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.48,0:23:28.82,Default,,0,0,0,,Бейблейд Маск мені апарған жерге
Dialogue: 0,0:23:28.90,0:23:30.20,Default,,0,0,0,,Ол сонда болды.
Dialogue: 0,0:23:30.28,0:23:31.99,Default,,0,0,0,,Шуды жеңген адам
Dialogue: 0,0:23:32.07,0:23:35.08,Default,,0,0,0,,Ширасаги сарайы Руи, төрт айналымды ең күшті император
Dialogue: 0,0:23:35.16,0:23:37.04,Default,,0,0,0,,Маған төмен қара
Dialogue: 0,0:23:37.12,0:23:38.45,Default,,0,0,0,,Қазір күн жылы
Dialogue: 0,0:23:38.54,0:23:40.08,Default,,0,0,0,,Мен онымен соғысқым келеді
Dialogue: 0,0:23:40.16,0:23:42.25,Default,,0,0,0,,Сонда бәрібір жеңіңіз.
Dialogue: 0,0:23:42.46,0:23:44.38,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:44.46,0:23:46.04,Default,,0,0,0,,Жан түршігерлік циклон!
Dialogue: 0,0:23:46.13,0:23:47.75,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.88,0:23:49.59,Default,,0,0,0,,Бар, ат!
