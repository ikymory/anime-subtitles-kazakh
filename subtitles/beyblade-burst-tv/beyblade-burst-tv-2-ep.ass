Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.21,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.30,0:00:12.59,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.67,0:00:14.55,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.63,0:00:16.89,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:16.97,0:00:18.72,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.52,0:00:24.06,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.14,0:00:26.19,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.27,0:00:28.61,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.19,0:00:32.19,Default,,0,0,0,,Бірақ
Dialogue: 0,0:00:32.86,0:00:33.90,Default,,0,0,0,,Мен қазір
Dialogue: 0,0:00:34.32,0:00:36.24,Default,,0,0,0,,Бұл көңілді екеніне көмектесу мүмкін емес!
Dialogue: 0,0:00:49.34,0:00:51.59,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:51.67,0:00:53.13,Default,,0,0,0,,Валькирияның жеңісі
Dialogue: 0,0:00:53.21,0:00:55.59,Default,,0,0,0,,Шабуылдарды қайта-қайта қайталаңыз
Dialogue: 0,0:00:55.68,0:00:57.22,Default,,0,0,0,,Тез ату!
Dialogue: 0,0:00:57.30,0:00:58.72,Default,,0,0,0,,Тез ату?
Dialogue: 0,0:01:04.60,0:01:07.81,Default,,0,0,0,,) Бұл өтірік болса керек...
Dialogue: 0,0:01:08.15,0:01:09.44,Default,,0,0,0,,(Еденге құлаған шығанақтың дыбысы)
Dialogue: 0,0:01:09.52,0:01:11.69,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:01:11.78,0:01:15.40,Default,,0,0,0,,Біз мұны жасадық, Валькири, біздің бірінші жеңісіміз!
Dialogue: 0,0:01:15.82,0:01:18.41,Default,,0,0,0,,Әрқашан қолдау көрсеткеніңіз үшін рахмет, досым!
Dialogue: 0,0:01:26.75,0:01:29.13,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:29.46,0:01:34.63,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:45.93,0:01:49.31,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:49.81,0:01:51.94,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:52.36,0:01:56.49,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:56.61,0:01:59.82,Default,,0,0,0,,Дұрыс, бетпе-бет.
Dialogue: 0,0:01:59.95,0:02:06.37,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:06.66,0:02:11.08,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:11.58,0:02:17.01,Default,,0,0,0,,Дауысты дауыстап, дірілдеп ойнайық
Dialogue: 0,0:02:17.13,0:02:19.38,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:19.47,0:02:24.18,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:24.35,0:02:29.44,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:29.73,0:02:31.98,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:32.19,0:02:34.52,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:34.82,0:02:38.74,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:38.90,0:02:43.91,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:44.12,0:02:46.29,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:50.46,0:02:53.67,Default,,0,0,0,,Жер асты әлемінің күзетшісі! Cerbeus!
Dialogue: 0,0:02:55.21,0:02:57.09,Default,,0,0,0,,Барлығың мені тыңдаңдар.
Dialogue: 0,0:02:57.59,0:02:59.17,Default,,0,0,0,,I Барто Аои
Dialogue: 0,0:02:59.26,0:03:01.84,Default,,0,0,0,,WBBA аймақтық турнирінің бірінші кезеңі
Dialogue: 0,0:03:01.93,0:03:04.26,Default,,0,0,0,,Сіз сәтті өттіңіз!
Dialogue: 0,0:03:04.35,0:03:07.64,Default,,0,0,0,,Жеңіс Валькиридің Rush Shot жаңа техникасы
Dialogue: 0,0:03:07.72,0:03:09.10,Default,,0,0,0,,Жеңілмейтін!
Dialogue: 0,0:03:10.02,0:03:11.44,Default,,0,0,0,,Уф!
Dialogue: 0,0:03:11.64,0:03:12.52,Default,,0,0,0,,Хмм?
Dialogue: 0,0:03:12.73,0:03:13.90,Default,,0,0,0,,(шу)
Dialogue: 0,0:03:13.98,0:03:17.19,Default,,0,0,0,,Шапшаң ату
Dialogue: 0,0:03:17.28,0:03:18.82,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:03:18.90,0:03:20.53,Default,,0,0,0,,Қалай ойлайсың, сағат неше?
Dialogue: 0,0:03:20.61,0:03:24.32,Default,,0,0,0,,Раш асығыс ~
Dialogue: 0,0:03:24.41,0:03:25.53,Default,,0,0,0,,Қашықтық~
Dialogue: 0,0:03:25.62,0:03:27.54,Default,,0,0,0,,Балтықты тоқтатыңыз~
Dialogue: 0,0:03:27.62,0:03:29.00,Default,,0,0,0,,Ана
Dialogue: 0,0:03:29.25,0:03:31.04,Default,,0,0,0,,«Анашым!» емес
Dialogue: 0,0:03:31.12,0:03:33.42,Default,,0,0,0,,Токонацу мен Ника баяғыда мектепке барған.
Dialogue: 0,0:03:33.50,0:03:34.96,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:03:35.04,0:03:36.34,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:03:36.42,0:03:37.88,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:03:39.13,0:03:42.09,Default,,0,0,0,,Дәл... Күнде таңертең осылай...
Dialogue: 0,0:03:42.47,0:03:46.10,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:03:46.18,0:03:48.18,Default,,0,0,0,,Чикоку Чикоку~
Dialogue: 0,0:03:48.26,0:03:50.23,Default,,0,0,0,,Дәлірек айтсам, дәл біздің астымыздағы теңіз портында…
Dialogue: 0,0:03:50.35,0:03:52.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:52.60,0:03:54.31,Default,,0,0,0,,Әрең қауіпсіз
Dialogue: 0,0:03:55.15,0:03:57.15,Default,,0,0,0,,Ха, мен оны уақытында жасадым.
Dialogue: 0,0:03:57.23,0:03:59.65,Default,,0,0,0,,Мен де таңнан бері ақымақ болдым.
Dialogue: 0,0:03:59.73,0:04:02.74,Default,,0,0,0,,О, Мичо, сен мектепке ерте келдің.
Dialogue: 0,0:04:02.82,0:04:04.57,Default,,0,0,0,,Сіз қиындыққа тап болдыңыз
Dialogue: 0,0:04:05.41,0:04:06.41,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:04:07.12,0:04:10.20,Default,,0,0,0,,Мен сен сияқты ақымақтан жеңілдім деп ойлау...
Dialogue: 0,0:04:10.29,0:04:11.33,Default,,0,0,0,,Кук
Dialogue: 0,0:04:12.00,0:04:16.79,Default,,0,0,0,,Дұрыс, мен жеңдім! Және бұл керемет жеңіс болды.
Dialogue: 0,0:04:16.88,0:04:19.63,Default,,0,0,0,,Кумичоның Рагнарук жарылып кетті
Dialogue: 0,0:04:19.71,0:04:22.30,Default,,0,0,0,,Бұл жеңудің ең керемет жолы.
Dialogue: 0,0:04:22.38,0:04:26.01,Default,,0,0,0,,Теме, сен бір рет жеңдің, неге сонша толқыдың!
Dialogue: 0,0:04:26.09,0:04:27.97,Default,,0,0,0,,Жоқ, онда жоқ. Онда емес.
Dialogue: 0,0:04:28.05,0:04:30.06,Default,,0,0,0,,Өйткені менің қабілетім – менің қабілетім
Dialogue: 0,0:04:30.14,0:04:31.52,Default,,0,0,0,,Тез ату!
Dialogue: 0,0:04:31.60,0:04:34.48,Default,,0,0,0,,Алып бара жатыр дейді ғой!
Dialogue: 0,0:04:34.56,0:04:35.94,Default,,0,0,0,,Барт
Dialogue: 0,0:04:36.02,0:04:37.77,Default,,0,0,0,,Мен матчты көрдім.
Dialogue: 0,0:04:37.86,0:04:40.32,Default,,0,0,0,,Бұл жылдам жеңіс. Мен оны қарап шықтым.
Dialogue: 0,0:04:40.40,0:04:42.53,Default,,0,0,0,,Ал, рахмет, рахмет
Dialogue: 0,0:04:42.61,0:04:46.24,Default,,0,0,0,,Қорытынды техника ғажап болды (Какитани) Бұл шапшаң соққы болды.
Dialogue: 0,0:04:46.32,0:04:50.33,Default,,0,0,0,,Сіз түсінесіз. Көргіңіз келсе маған көрсете аласыз.
Dialogue: 0,0:04:50.41,0:04:51.87,Default,,0,0,0,,Маған көрсет Маған көрсет
Dialogue: 0,0:04:51.95,0:04:55.50,Default,,0,0,0,,Сәлем балалар, сабақ басталғалы жатыр.
Dialogue: 0,0:04:55.58,0:04:56.79,Default,,0,0,0,,Ах, мектеп директоры.
Dialogue: 0,0:04:56.87,0:04:58.63,Default,,0,0,0,,Олай болса, бәріміз, көріскенше.
Dialogue: 0,0:04:58.71,0:04:59.67,Default,,0,0,0,,Ах
Dialogue: 0,0:05:00.42,0:05:02.59,Default,,0,0,0,,Балтоның ісін орындайық
Dialogue: 0,0:05:31.08,0:05:33.20,Default,,0,0,0,,Тез ату
Dialogue: 0,0:05:33.29,0:05:35.83,Default,,0,0,0,,Шапшаң ату
Dialogue: 0,0:05:35.91,0:05:36.87,Default,,0,0,0,,мен мұндай Риппл қолданушыны еркін жібере алмаймын.
Dialogue: 0,0:05:36.96,0:05:39.17,Default,,0,0,0,,Бар-нии, көңілді жүрсің.
Dialogue: 0,0:05:39.25,0:05:41.13,Default,,0,0,0,,Мен шынымен бақыттымын.
Dialogue: 0,0:05:41.21,0:05:42.25,Default,,0,0,0,,Бірдеңе бар
Dialogue: 0,0:05:42.34,0:05:44.51,Default,,0,0,0,,Мен Кумичоға қарсы жеңіске жеттім.
Dialogue: 0,0:05:44.59,0:05:46.76,Default,,0,0,0,,Барлығы керемет дейді.
Dialogue: 0,0:05:47.09,0:05:48.30,Default,,0,0,0,,Бұл сенсің
Dialogue: 0,0:05:48.80,0:05:51.89,Default,,0,0,0,,Мені мазақ еткеніме 100 жыл болды.
Dialogue: 0,0:05:52.31,0:05:54.27,Default,,0,0,0,,Теңгу～ Теңгу～
Dialogue: 0,0:05:54.35,0:05:56.02,Default,,0,0,0,,Теме, бұл мені шынымен жылатады!
Dialogue: 0,0:05:56.10,0:05:57.64,Default,,0,0,0,,Қатты дауыс
Dialogue: 0,0:05:58.23,0:05:59.31,Default,,0,0,0,,Әй?
Dialogue: 0,0:06:00.27,0:06:00.77,Default,,0,0,0,,Ах
Dialogue: 0,0:06:00.86,0:06:02.94,Default,,0,0,0,,Шу! тыныш
Dialogue: 0,0:06:03.65,0:06:04.90,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:11.53,0:06:12.28,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:06:12.37,0:06:14.91,Default,,0,0,0,,Қысқа сәлем үшін кешіріңіз.
Dialogue: 0,0:06:15.91,0:06:18.46,Default,,0,0,0,,Бұл не, Шу? Сіз терлеп жатырсыз, солай емес пе?
Dialogue: 0,0:06:18.54,0:06:21.42,Default,,0,0,0,,Мен, әрине, бәйгемен айналыстым.
Dialogue: 0,0:06:21.50,0:06:23.21,Default,,0,0,0,,Бей практика...?
Dialogue: 0,0:06:23.29,0:06:25.42,Default,,0,0,0,,Ах (Рантаро) Бұл не?
Dialogue: 0,0:06:25.51,0:06:26.46,Default,,0,0,0,,Тер...?
Dialogue: 0,0:06:26.96,0:06:29.22,Default,,0,0,0,,Мұның бәрі Шу-кун ба?
Dialogue: 0,0:06:29.72,0:06:31.89,Default,,0,0,0,,Қанша істедің...
Dialogue: 0,0:06:32.85,0:06:33.72,Default,,0,0,0,,О
Dialogue: 0,0:06:33.81,0:06:34.89,Default,,0,0,0,,Бұл біршама шықты.
Dialogue: 0,0:06:34.97,0:06:36.31,Default,,0,0,0,,Гэвин
Dialogue: 0,0:06:36.39,0:06:39.14,Default,,0,0,0,,Не... Оның не екенін білмеймін.
Dialogue: 0,0:06:39.98,0:06:43.73,Default,,0,0,0,,Қазір мен қатты ауырып қалдым~
Dialogue: 0,0:06:44.40,0:06:47.03,Default,,0,0,0,,Жоғалтпаған жақсы ғой, ағайын.
Dialogue: 0,0:06:47.11,0:06:47.78,Default,,0,0,0,,Иә
Dialogue: 0,0:06:48.74,0:06:51.36,Default,,0,0,0,,Мен де, көбірек жаттығамын.
Dialogue: 0,0:06:51.49,0:06:53.87,Default,,0,0,0,,Мен Rush Shoot ойынымен жеңемін.
Dialogue: 0,0:06:53.95,0:06:54.99,Default,,0,0,0,,Менің ойымша, бұл мүмкін емес.
Dialogue: 0,0:06:55.08,0:06:56.70,Default,,0,0,0,,Неге!
Dialogue: 0,0:06:58.45,0:07:01.25,Default,,0,0,0,,Бір рет жеңіске жетіп, көңілі көтерілетін жігіт
Dialogue: 0,0:07:01.33,0:07:02.42,Default,,0,0,0,,Жеңіске жету мүмкін емес
Dialogue: 0,0:07:03.04,0:07:03.79,Default,,0,0,0,,Уф
Dialogue: 0,0:07:04.59,0:07:07.13,Default,,0,0,0,,Бейблейдтер соншалықты жаман емес.
Dialogue: 0,0:07:08.01,0:07:10.38,Default,,0,0,0,,Ол әлі де сол жігіт.
Dialogue: 0,0:07:10.97,0:07:12.22,Default,,0,0,0,,Бұл не, Шу?
Dialogue: 0,0:07:12.30,0:07:14.51,Default,,0,0,0,,Бұлай айтудың қажеті жоқ.
Dialogue: 0,0:07:14.60,0:07:16.85,Default,,0,0,0,,Шудың ақымақ!
Dialogue: 0,0:07:16.93,0:07:18.47,Default,,0,0,0,,Даусыңыз тым қатты.
Dialogue: 0,0:07:18.98,0:07:21.27,Default,,0,0,0,,Сіздің жеңетініңізге сенімдімін!
Dialogue: 0,0:07:21.35,0:07:23.52,Default,,0,0,0,,Уау~
Dialogue: 0,0:07:24.77,0:07:27.23,Default,,0,0,0,,Әркім, көзіңді күйдір
Dialogue: 0,0:07:27.32,0:07:30.57,Default,,0,0,0,,Бұдан былай мен сізге ең күшті соққымды көрсетемін.
Dialogue: 0,0:07:33.49,0:07:34.32,Default,,0,0,0,,Жарайды
Dialogue: 0,0:07:34.82,0:07:37.66,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:38.04,0:07:40.37,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:42.79,0:07:45.42,Default,,0,0,0,,шығанақ қайтадан орталықта.
Dialogue: 0,0:07:45.50,0:07:47.04,Default,,0,0,0,,Мен бардым
Dialogue: 0,0:07:47.13,0:07:49.51,Default,,0,0,0,,Эх (Накагава) Мен қайтадан оралдым.
Dialogue: 0,0:07:49.59,0:07:51.80,Default,,0,0,0,,Мен мұндай қозғалысты бұрын-соңды көрген емеспін.
Dialogue: 0,0:07:52.18,0:07:53.38,Default,,0,0,0,,Йоша
Dialogue: 0,0:07:53.72,0:07:54.97,Default,,0,0,0,,Дәл Раш
Dialogue: 0,0:07:55.05,0:07:56.01,Default,,0,0,0,,Керемет
Dialogue: 0,0:07:56.10,0:07:57.51,Default,,0,0,0,,Керемет, солай ма?
Dialogue: 0,0:07:57.60,0:08:00.06,Default,,0,0,0,,Кез келген шығанақ бір оқпен жарылады!
Dialogue: 0,0:08:00.14,0:08:03.10,Default,,0,0,0,,Мен тіпті Шудың шоқпарын да үрлеймін.
Dialogue: 0,0:08:03.19,0:08:04.15,Default,,0,0,0,,«Қажет болса», – дейді Джосуке. «Жарайды».
Dialogue: 0,0:08:04.23,0:08:05.52,Default,,0,0,0,,Хахаха (Рантаро)
Dialogue: 0,0:08:05.61,0:08:07.61,Default,,0,0,0,,Толығымен алып кетті
Dialogue: 0,0:08:08.82,0:08:09.90,Default,,0,0,0,,Сәлем Балто
Dialogue: 0,0:08:09.98,0:08:11.82,Default,,0,0,0,,Менімен тағы ұрыс.
Dialogue: 0,0:08:12.07,0:08:13.74,Default,,0,0,0,,Әй, жасайық, жасайық
Dialogue: 0,0:08:13.82,0:08:16.07,Default,,0,0,0,,Қанша тырыссам да жеңемін.
Dialogue: 0,0:08:16.16,0:08:17.83,Default,,0,0,0,,Кеше кездейсоқ болды!
Dialogue: 0,0:08:17.91,0:08:19.24,Default,,0,0,0,,Бұл кездейсоқтық па?
Dialogue: 0,0:08:19.99,0:08:22.75,Default,,0,0,0,,Мен тек бір рет кездейсоқ жеңдім.
Dialogue: 0,0:08:22.83,0:08:24.67,Default,,0,0,0,,Көңіл-күйіңіз жақсы!
Dialogue: 0,0:08:24.75,0:08:26.46,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:08:28.63,0:08:32.13,Default,,0,0,0,,Шапшаң ату дегеніміз не? Мен бұл жолы жеңемін!
Dialogue: 0,0:08:32.34,0:08:34.97,Default,,0,0,0,,Менің Валькириім ешқашан жеңілмейді
Dialogue: 0,0:08:35.89,0:08:37.05,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:08:37.26,0:08:39.14,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:08:41.06,0:08:44.39,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:44.77,0:08:47.02,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:47.10,0:08:47.90,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:48.06,0:08:49.27,Default,,0,0,0,,Кеттік
Dialogue: 0,0:08:49.36,0:08:51.19,Default,,0,0,0,,Тез ату
Dialogue: 0,0:08:57.32,0:08:58.37,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,0:08:58.62,0:08:59.66,Default,,0,0,0,,Сіз елді дүр сілкіндіре білген ардагер орындаушы ретінде әйгілісіз, иә?
Dialogue: 0,0:08:59.74,0:09:01.54,Default,,0,0,0,,Валькири Раш!
Dialogue: 0,0:09:01.70,0:09:03.00,Default,,0,0,0,,Мен бұл туралы білмеймін.
Dialogue: 0,0:09:03.12,0:09:04.71,Default,,0,0,0,,Сүйегім сынды!
Dialogue: 0,0:09:04.79,0:09:06.12,Default,,0,0,0,,Бұл бұрынғыдан өзгеше.
Dialogue: 0,0:09:06.21,0:09:07.21,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:09:07.29,0:09:08.71,Default,,0,0,0,,Қабырғаға соғу
Dialogue: 0,0:09:08.79,0:09:10.71,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:09:10.80,0:09:13.59,Default,,0,0,0,,Валькириге не болды?
Dialogue: 0,0:09:16.34,0:09:20.10,Default,,0,0,0,,Рагнарук есептегіші! Ұшып кетсін
Dialogue: 0,0:09:20.18,0:09:21.47,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:09:21.60,0:09:22.39,Default,,0,0,0,,…бірақ ол құламайды!
Dialogue: 0,0:09:22.77,0:09:23.43,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:23.52,0:09:24.52,Default,,0,0,0,,Бұл өтірік болар еді
Dialogue: 0,0:09:26.27,0:09:28.52,Default,,0,0,0,,Рагнаруктың жарылуы
Dialogue: 0,0:09:28.60,0:09:31.48,Default,,0,0,0,,Кумичо 2 ұпай алу арқылы жеңеді
Dialogue: 0,0:09:31.94,0:09:33.65,Default,,0,0,0,,Толық аяқтау
Dialogue: 0,0:09:33.73,0:09:34.94,Default,,0,0,0,,Жақсы сезінеді~
Dialogue: 0,0:09:35.03,0:09:36.65,Default,,0,0,0,,Rush Shoot дегеніміз не?
Dialogue: 0,0:09:36.74,0:09:39.49,Default,,0,0,0,,Кешегі күннің кездейсоқ болғанын енді білесің.
Dialogue: 0,0:09:39.57,0:09:41.91,Default,,0,0,0,,А, мен өзімді сергек сезіндім.
Dialogue: 0,0:09:42.66,0:09:44.08,Default,,0,0,0,,Валькирия...
Dialogue: 0,0:09:44.37,0:09:46.91,Default,,0,0,0,,Сіздің асығыс атыңыз
Dialogue: 0,0:09:47.00,0:09:48.50,Default,,0,0,0,,Бұл тым тұрақсыз.
Dialogue: 0,0:09:48.71,0:09:50.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:51.17,0:09:54.05,Default,,0,0,0,,Бір рет жеңіп қана бақытты болғандар
Dialogue: 0,0:09:54.13,0:09:55.34,Default,,0,0,0,,Алға жылжу мүмкін емес
Dialogue: 0,0:09:56.55,0:09:57.63,Default,,0,0,0,,Құт
Dialogue: 0,0:09:57.72,0:09:59.68,Default,,0,0,0,,Кешіріңіз, Валькири
Dialogue: 0,0:10:08.81,0:10:10.94,Default,,0,0,0,,Бару-нии, көңілі түсіп кетті ме екен.
Dialogue: 0,0:10:11.02,0:10:13.73,Default,,0,0,0,,Себебі шапшаң ату сәтсіз аяқталды.
Dialogue: 0,0:10:15.57,0:10:17.57,Default,,0,0,0,,Токонацу Ника
Dialogue: 0,0:10:17.78,0:10:18.74,Default,,0,0,0,,Не?
Dialogue: 0,0:10:18.82,0:10:20.91,Default,,0,0,0,,Мен толқыдым ба?
Dialogue: 0,0:10:23.12,0:10:24.04,Default,,0,0,0,,Иә
Dialogue: 0,0:10:24.95,0:10:26.29,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:28.37,0:10:29.87,Default,,0,0,0,,Бакайару
Dialogue: 0,0:10:29.96,0:10:31.63,Default,,0,0,0,,Практика!
Dialogue: 0,0:10:31.71,0:10:34.00,Default,,0,0,0,,Жаттығу!
Dialogue: 0,0:10:34.09,0:10:34.88,Default,,0,0,0,,О
Dialogue: 0,0:10:35.30,0:10:36.34,Default,,0,0,0,,Не болды?
Dialogue: 0,0:10:39.01,0:10:40.22,Default,,0,0,0,,Бұл...
Dialogue: 0,0:10:40.84,0:10:42.60,Default,,0,0,0,,Менің ағама ұқсайды
Dialogue: 0,0:10:43.60,0:10:46.06,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:46.43,0:10:48.31,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:49.10,0:10:51.27,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:51.48,0:10:53.56,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:53.81,0:10:54.86,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:10:54.94,0:10:56.44,Default,,0,0,0,,Бұл өте қарапайым~
Dialogue: 0,0:10:56.53,0:10:58.74,Default,,0,0,0,,Жарайды, келесі кезекте отжимание.
Dialogue: 0,0:10:58.82,0:11:04.87,Default,,0,0,0,,Бұл маңызды! Бұл негізгі! Бұл негізгі! Бұл өте маңызды!
Dialogue: 0,0:11:04.95,0:11:07.37,Default,,0,0,0,,Бар-нии
Dialogue: 0,0:11:07.45,0:11:08.91,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:11:09.46,0:11:12.92,Default,,0,0,0,,Бар-нии, сауда орталығында қуыршақ театры бар.
Dialogue: 0,0:11:13.21,0:11:16.05,Default,,0,0,0,,Ал менің ағама дәл ұқсайтын қуыршақ бар.
Dialogue: 0,0:11:16.13,0:11:17.88,Default,,0,0,0,,Бұл батыр.
Dialogue: 0,0:11:17.96,0:11:19.84,Default,,0,0,0,,Маған ұқсайтын батыр...?
Dialogue: 0,0:11:19.92,0:11:21.43,Default,,0,0,0,,Керемет.
Dialogue: 0,0:11:22.59,0:11:24.05,Default,,0,0,0,,Мен барып көрейін.
Dialogue: 0,0:11:24.18,0:11:27.06,Default,,0,0,0,,Бір минут күте тұрыңыз, мені сүйремеңіз.
Dialogue: 0,0:11:29.39,0:11:30.52,Default,,0,0,0,,Анау, анау!
Dialogue: 0,0:11:30.60,0:11:31.98,Default,,0,0,0,,Мен мұны істеп жатырмын
Dialogue: 0,0:11:32.10,0:11:34.15,Default,,0,0,0,,Ах ха ха ха
Dialogue: 0,0:11:34.23,0:11:36.48,Default,,0,0,0,,Менің өлімші қылышыммен сен, т.б
Dialogue: 0,0:11:36.57,0:11:37.98,Default,,0,0,0,,Ол сені құртады!
Dialogue: 0,0:11:38.07,0:11:40.95,Default,,0,0,0,,Сен сияқты жынды жігіт жеңеді.
Dialogue: 0,0:11:41.03,0:11:42.24,Default,,0,0,0,,Жақсы емес
Dialogue: 0,0:11:42.61,0:11:44.16,Default,,0,0,0,,Не!
Dialogue: 0,0:11:44.32,0:11:45.57,Default,,0,0,0,,Ұқсас~
Dialogue: 0,0:11:45.70,0:11:48.70,Default,,0,0,0,,Маған Шу-күн де солай деді.
Dialogue: 0,0:11:49.08,0:11:51.25,Default,,0,0,0,,Ей, жеңілме, батыр!
Dialogue: 0,0:11:51.33,0:11:52.50,Default,,0,0,0,,Жылау
Dialogue: 0,0:11:52.58,0:11:54.25,Default,,0,0,0,,О
Dialogue: 0,0:11:54.54,0:11:55.33,Default,,0,0,0,,Ах
Dialogue: 0,0:11:55.42,0:11:56.67,Default,,0,0,0,,Батыр Йова~
Dialogue: 0,0:11:56.75,0:11:58.84,Default,,0,0,0,,Мен бір соққымен шынымен жеңілдім.
Dialogue: 0,0:11:58.92,0:12:01.26,Default,,0,0,0,,Не істеп жатырсың, батыр? Қайтарыңыз!
Dialogue: 0,0:12:01.72,0:12:02.68,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:12:02.76,0:12:03.97,Default,,0,0,0,,Мен саған бұлай істеуге рұқсат бермеймін.
Dialogue: 0,0:12:04.05,0:12:05.22,Default,,0,0,0,,Кеттік
Dialogue: 0,0:12:05.30,0:12:06.26,Default,,0,0,0,,
Dialogue: 0,0:12:06.35,0:12:07.10,Default,,0,0,0,,Уау
Dialogue: 0,0:12:07.18,0:12:08.89,Default,,0,0,0,,Кербес
Dialogue: 0,0:12:08.97,0:12:11.06,Default,,0,0,0,,Батырдың ығысып кеткені жақсы емес.
Dialogue: 0,0:12:11.14,0:12:13.85,Default,,0,0,0,,Батыр болсаң, тұр!
Dialogue: 0,0:12:13.94,0:12:15.60,Default,,0,0,0,,О! Иә
Dialogue: 0,0:12:15.69,0:12:16.73,Default,,0,0,0,,(соғу дыбысы)
Dialogue: 0,0:12:16.81,0:12:17.94,Default,,0,0,0,,Олардың мүлде қозғалмай жатқаны оғаш екен
Dialogue: 0,0:12:18.02,0:12:19.11,Default,,0,0,0,,Мықты болыңыз~
Dialogue: 0,0:12:19.19,0:12:21.40,Default,,0,0,0,,Бұл не? Хахаха
Dialogue: 0,0:12:21.57,0:12:23.86,Default,,0,0,0,,Батыр тым әлсіз
Dialogue: 0,0:12:23.95,0:12:26.62,Default,,0,0,0,,Біз айдаһарды жеңеміз.
Dialogue: 0,0:12:27.37,0:12:29.83,Default,,0,0,0,,Кел мен Бетке сәттілік
Dialogue: 0,0:12:29.91,0:12:32.79,Default,,0,0,0,,Бұл не, батыр, тұр!
Dialogue: 0,0:12:32.96,0:12:35.08,Default,,0,0,0,,Ол әдетте мұнда батыр.
Dialogue: 0,0:12:35.17,0:12:36.96,Default,,0,0,0,,Бару-нии, сен жақсы болып қалдың.
Dialogue: 0,0:12:37.04,0:12:38.46,Default,,0,0,0,,Иә сәтті
Dialogue: 0,0:12:38.92,0:12:40.05,Default,,0,0,0,,(бес жоғары дыбыс)
Dialogue: 0,0:12:40.59,0:12:43.05,Default,,0,0,0,,Қуыршақ театры өте қызықты болды
Dialogue: 0,0:12:43.34,0:12:44.47,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:12:44.55,0:12:47.22,Default,,0,0,0,,Кел мен Бет сүйкімді және көңілді
Dialogue: 0,0:12:47.30,0:12:49.68,Default,,0,0,0,,Мен де әкеме көрсеткім келеді.
Dialogue: 0,0:12:49.85,0:12:51.68,Default,,0,0,0,,Эй, сен қазір қайда ұшып бара жатырсың?
Dialogue: 0,0:12:52.06,0:12:54.64,Default,,0,0,0,,Олар бұл Нью-Йоркке кері рейс екенін айтты.
Dialogue: 0,0:12:55.39,0:12:57.52,Default,,0,0,0,,Мүмкін Алясканың үстінде.
Dialogue: 0,0:12:57.94,0:12:59.48,Default,,0,0,0,,Аляска?
Dialogue: 0,0:12:59.57,0:13:02.03,Default,,0,0,0,,Ұшқыш болу керемет. Сіз көптеген жерлерге бара аласыз.
Dialogue: 0,0:13:02.11,0:13:05.03,Default,,0,0,0,,Дұрыс, Бал-ниға ұқсайтын батыр шықты.
Dialogue: 0,0:13:05.11,0:13:06.61,Default,,0,0,0,,Бұл әлсіз
Dialogue: 0,0:13:06.70,0:13:07.36,Default,,0,0,0,,Олар бір-біріне ұқсамайды.
Dialogue: 0,0:13:07.45,0:13:08.57,Default,,0,0,0,,Бұл ұқсас болды.
Dialogue: 0,0:13:09.20,0:13:11.08,Default,,0,0,0,,Бір соққыда жеңілуге болатын жер
Dialogue: 0,0:13:11.16,0:13:12.04,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:13:12.50,0:13:14.29,Default,,0,0,0,,Егер олар бір-біріне ұқсамаса...
Dialogue: 0,0:13:14.50,0:13:16.21,Default,,0,0,0,,Хм
Dialogue: 0,0:13:16.29,0:13:18.33,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:13:18.42,0:13:21.13,Default,,0,0,0,,Егер олар шынымен ұқсамаса...
Dialogue: 0,0:13:21.71,0:13:24.47,Default,,0,0,0,,(өткізу орнындағы шу)
Dialogue: 0,0:13:24.55,0:13:26.55,Default,,0,0,0,,Қызық, ағамның сірі келді ме?
Dialogue: 0,0:13:26.88,0:13:28.01,Default,,0,0,0,,Міне таяп қалды
Dialogue: 0,0:13:29.05,0:13:30.26,Default,,0,0,0,,Әй, Шу-кун!
Dialogue: 0,0:13:30.89,0:13:33.10,Default,,0,0,0,,Бұл ойын сізді де қызықтырады ма?
Dialogue: 0,0:13:33.18,0:13:33.93,Default,,0,0,0,,Иә, бір жағынан солай.
Dialogue: 0,0:13:34.23,0:13:35.68,Default,,0,0,0,,Оқиға болса да, ол
Dialogue: 0,0:13:35.77,0:13:39.27,Default,,0,0,0,,Мен жеңіске жеткен кандидат Рантаро-самаға қарсы шықтым.
Dialogue: 0,0:13:39.36,0:13:41.23,Default,,0,0,0,,Сіз де сақтығыңызды түсіре алмайсыз.
Dialogue: 0,0:13:41.32,0:13:43.40,Default,,0,0,0,,Какккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккккк
Dialogue: 0,0:13:43.48,0:13:45.32,Default,,0,0,0,,Жеңіске жеткендей әрекет етіңіз
Dialogue: 0,0:13:45.40,0:13:47.32,Default,,0,0,0,,(Жарық дыбысының өзгеруі)
Dialogue: 0,0:13:47.40,0:13:48.49,Default,,0,0,0,,Мұндай жағдай болса деп, астымда бронежилет киіп жүрмін.
Dialogue: 0,0:13:48.57,0:13:50.16,Default,,0,0,0,,Ұлдар мен қыздар
Dialogue: 0,0:13:50.62,0:13:52.74,Default,,0,0,0,,Бейблейд Йонекома аудандық турнирі
Dialogue: 0,0:13:52.83,0:13:54.70,Default,,0,0,0,,Екінші тур басталады!
Dialogue: 0,0:13:54.79,0:13:57.04,Default,,0,0,0,,Барлығына! Дайынсыз ба?
Dialogue: 0,0:13:57.12,0:13:59.12,Default,,0,0,0,,Мен ол жігітке ештеңе істей алмаймын
Dialogue: 0,0:13:59.79,0:14:02.92,Default,,0,0,0,,Бірінші кездесуде ол жеңіске жеткен үміткер Рантаро Кияманы жеңді.
Dialogue: 0,0:14:03.00,0:14:04.26,Default,,0,0,0,,Қара жылқы!
Dialogue: 0,0:14:05.46,0:14:07.63,Default,,0,0,0,,Барто Аоимен таныстыру!
Dialogue: 0,0:14:07.72,0:14:09.64,Default,,0,0,0,,
Dialogue: 0,0:14:09.72,0:14:12.14,Default,,0,0,0,,Қара ат... Бұл не?
Dialogue: 0,0:14:12.81,0:14:15.18,Default,,0,0,0,,Сіз мұны білмейсіз бе?
Dialogue: 0,0:14:15.27,0:14:16.85,Default,,0,0,0,,дегеніміз не?
Dialogue: 0,0:14:16.93,0:14:17.89,Default,,0,0,0,,Ах~
Dialogue: 0,0:14:17.98,0:14:19.69,Default,,0,0,0,,Күтпеген ойыншының мағынасы
Dialogue: 0,0:14:20.02,0:14:22.06,Default,,0,0,0,,Үлкен үміт бар.
Dialogue: 0,0:14:22.44,0:14:23.32,Default,,0,0,0,,Э-э… Зеницу-сан
Dialogue: 0,0:14:23.40,0:14:28.36,Default,,0,0,0,,Балто Балто Балто…
Dialogue: 0,0:14:28.45,0:14:31.24,Default,,0,0,0,,Күтілетін
Dialogue: 0,0:14:31.32,0:14:32.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:33.33,0:14:35.54,Default,,0,0,0,,Мен бүгін тағы да жабайы боламын.
Dialogue: 0,0:14:35.62,0:14:39.21,Default,,0,0,0,,Барттың не істеді, қайта ренжіді.
Dialogue: 0,0:14:39.37,0:14:41.42,Default,,0,0,0,,Бұл оның жаман әдеті.
Dialogue: 0,0:14:42.04,0:14:44.88,Default,,0,0,0,,Сен ағаң үшін алаңдайсың ба?
Dialogue: 0,0:14:44.96,0:14:45.88,Default,,0,0,0,,Иии!
Dialogue: 0,0:14:45.96,0:14:47.88,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:14:47.97,0:14:50.72,Default,,0,0,0,,Мен неге ол үшін алаңдаймын?
Dialogue: 0,0:14:50.80,0:14:52.47,Default,,0,0,0,,Рахмет сізге Кумичо
Dialogue: 0,0:14:52.55,0:14:54.26,Default,,0,0,0,,Сондықтан басқаша.
Dialogue: 0,0:14:54.35,0:14:56.93,Default,,0,0,0,,Ал Барто Аои үшін:
Dialogue: 0,0:14:58.43,0:15:00.14,Default,,0,0,0,,Мидорикава Инусуке
Dialogue: 0,0:15:00.23,0:15:01.77,Default,,0,0,0,,(өткізу орнындағы шу)
Dialogue: 0,0:15:02.10,0:15:05.73,Default,,0,0,0,,Бұл менің қарсыласым, Балт Аои ма?
Dialogue: 0,0:15:05.82,0:15:08.19,Default,,0,0,0,,Сен өте ақымақ көрінесің.
Dialogue: 0,0:15:08.28,0:15:09.90,Default,,0,0,0,,Сіз басқа адамдар туралы айта алмайсыз.
Dialogue: 0,0:15:09.99,0:15:12.66,Default,,0,0,0,,Келдің де беті менімен бірдей.
Dialogue: 0,0:15:12.74,0:15:15.53,Default,,0,0,0,,Бұл бірдей емес. Оның басқаша екені анық.
Dialogue: 0,0:15:15.78,0:15:17.95,Default,,0,0,0,,Ах! Антоки қуыршақ!
Dialogue: 0,0:15:18.04,0:15:19.29,Default,,0,0,0,,Мен Келлмін
Dialogue: 0,0:15:19.37,0:15:21.04,Default,,0,0,0,,Мен Бетпін
Dialogue: 0,0:15:21.12,0:15:23.79,Default,,0,0,0,,Барто Аои Сіз мені жеңе алмайсыз
Dialogue: 0,0:15:23.88,0:15:25.54,Default,,0,0,0,,Біз жеңеміз
Dialogue: 0,0:15:26.42,0:15:29.51,Default,,0,0,0,,Керемет! Қуыршақтар шынымен сөйлеп жатыр!
Dialogue: 0,0:15:30.09,0:15:32.18,Default,,0,0,0,,Қуыршақ сөйлей алмайды, солай ма?
Dialogue: 0,0:15:32.38,0:15:34.43,Default,,0,0,0,,Вентрилокизм дегеніміз не?
Dialogue: 0,0:15:36.64,0:15:39.73,Default,,0,0,0,,Кеттік Кайзер Кербеус
Dialogue: 0,0:15:39.81,0:15:41.48,Default,,0,0,0,,Кайзер Сербеус…
Dialogue: 0,0:15:42.19,0:15:43.81,Default,,0,0,0,,Менің Рагнарукымнан да артық
Dialogue: 0,0:15:43.90,0:15:45.44,Default,,0,0,0,,Дөңгеленген қабат
Dialogue: 0,0:15:45.52,0:15:47.48,Default,,0,0,0,,Мүмкін қорғаныс түрі
Dialogue: 0,0:15:47.82,0:15:48.98,Default,,0,0,0,,Қорғаныс
Dialogue: 0,0:15:49.07,0:15:50.78,Default,,0,0,0,,Сіз жақсы қорғайсыз.
Dialogue: 0,0:15:50.86,0:15:51.57,Default,,0,0,0,,Ах
Dialogue: 0,0:15:51.65,0:15:53.82,Default,,0,0,0,,Оның қай шығанақ екені маңызды емес.
Dialogue: 0,0:15:53.91,0:15:55.91,Default,,0,0,0,,Менде асығыс ату бар.
Dialogue: 0,0:15:55.99,0:15:58.12,Default,,0,0,0,,Мен сені бір ұрып жіберемін.
Dialogue: 0,0:15:58.20,0:16:01.12,Default,,0,0,0,,Әлгі ақымақ тағы жынды
Dialogue: 0,0:16:02.29,0:16:04.38,Default,,0,0,0,,Айналдыру аяқталуы
Dialogue: 0,0:16:04.46,0:16:05.54,Default,,0,0,0,,1 ұпай
Dialogue: 0,0:16:05.63,0:16:07.71,Default,,0,0,0,,Жедел мәре – 2 ұпай
Dialogue: 0,0:16:07.80,0:16:10.46,Default,,0,0,0,,Бірінші 2 ұпай алған адам жеңеді.
Dialogue: 0,0:16:12.09,0:16:13.26,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:16:15.26,0:16:17.05,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:16:18.89,0:16:20.31,Default,,0,0,0,,Кеттік
Dialogue: 0,0:16:20.39,0:16:21.23,Default,,0,0,0,,Ах
Dialogue: 0,0:16:21.77,0:16:25.56,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:25.65,0:16:27.86,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:34.32,0:16:35.24,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:35.32,0:16:37.99,Default,,0,0,0,,Тым валькирия тәрізді
Dialogue: 0,0:16:38.08,0:16:40.08,Default,,0,0,0,,Стадионға үйкелу
Dialogue: 0,0:16:40.16,0:16:41.58,Default,,0,0,0,,Уххххххх
Dialogue: 0,0:16:41.66,0:16:44.62,Default,,0,0,0,,Бұл шапшаң ату емес, сәтсіз ату.
Dialogue: 0,0:16:44.71,0:16:45.58,Default,,0,0,0,,Ах
Dialogue: 0,0:16:45.96,0:16:49.80,Default,,0,0,0,,Қарғыс атсын, әлгі ақымақ тағы да тасып жатыр.
Dialogue: 0,0:16:49.92,0:16:51.51,Default,,0,0,0,,Енді жоқ
Dialogue: 0,0:16:51.59,0:16:54.05,Default,,0,0,0,,Тез ату – қауіпті әдіс
Dialogue: 0,0:16:54.59,0:16:57.30,Default,,0,0,0,,Тек үлкен ұқыптылықпен ғана жетістікке жетуге болады.
Dialogue: 0,0:16:57.39,0:17:00.51,Default,,0,0,0,,Ағымдағы түсіру бұрышы тым терең болды.
Dialogue: 0,0:17:01.18,0:17:02.31,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:17:02.39,0:17:03.35,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:17:04.18,0:17:06.65,Default,,0,0,0,,Күте тұрыңыз! Валькирия~
Dialogue: 0,0:17:07.98,0:17:08.73,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:08.81,0:17:10.73,Default,,0,0,0,,Айналу жылдамдығымен көтерілді
Dialogue: 0,0:17:10.82,0:17:13.44,Default,,0,0,0,,Валькири әйтеуір тепе-теңдігін қалпына келтірді.
Dialogue: 0,0:17:13.53,0:17:15.82,Default,,0,0,0,,Кербеусқа шабуыл жасау!
Dialogue: 0,0:17:16.86,0:17:17.49,Default,,0,0,0,,Жаңа велосипедтің қуанышына ештеңе жетпейді, иә?
Dialogue: 0,0:17:17.57,0:17:18.49,Default,,0,0,0,,Иә
Dialogue: 0,0:17:18.87,0:17:20.20,Default,,0,0,0,,Валькиридің шабуылы
Dialogue: 0,0:17:20.28,0:17:22.12,Default,,0,0,0,,Кербеус емделуде!
Dialogue: 0,0:17:22.20,0:17:25.29,Default,,0,0,0,,Сіздің шабуылыңыз Кербеусқа тимейді.
Dialogue: 0,0:17:26.42,0:17:29.59,Default,,0,0,0,,Кайзер Сербеустың ультра қорғаныс қабаты...
Dialogue: 0,0:17:29.67,0:17:32.25,Default,,0,0,0,,Барлық Valkyrie шабуылдарын бұғаттау.
Dialogue: 0,0:17:32.34,0:17:35.01,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,0:17:35.84,0:17:38.68,Default,,0,0,0,,(иттің үруі)
Dialogue: 0,0:17:45.39,0:17:47.90,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:17:51.57,0:17:54.40,Default,,0,0,0,,Ах...аа...аа...
Dialogue: 0,0:17:55.94,0:17:58.70,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:17:59.11,0:18:02.16,Default,,0,0,0,,Валькирияның айналуы тоқтады.
Dialogue: 0,0:18:02.24,0:18:05.12,Default,,0,0,0,,Kaiser Cerbeus Spin Finish!
Dialogue: 0,0:18:05.20,0:18:06.16,Default,,0,0,0,,Ах~
Dialogue: 0,0:18:08.33,0:18:11.00,Default,,0,0,0,,Айналдыру…
Dialogue: 0,0:18:11.75,0:18:14.76,Default,,0,0,0,,Ол кім? Ол тіпті аузына да жақын емес.
Dialogue: 0,0:18:14.84,0:18:17.47,Default,,0,0,0,,Менің Кербеусым ең күшті.
Dialogue: 0,0:18:17.55,0:18:18.26,Default,,0,0,0,,Менің
Dialogue: 0,0:18:18.34,0:18:18.84,Default,,0,0,0,,Иә
Dialogue: 0,0:18:18.93,0:18:19.84,Default,,0,0,0,,Кекекекеке
Dialogue: 0,0:18:20.55,0:18:22.01,Default,,0,0,0,,Не істеп жатырсың...
Dialogue: 0,0:18:22.51,0:18:25.06,Default,,0,0,0,,Осындай маңызды шайқаста сәтсіздікке ұшырағаныма сене алар емеспін.
Dialogue: 0,0:18:25.72,0:18:26.68,Default,,0,0,0,,Кук
Dialogue: 0,0:18:27.64,0:18:28.48,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:18:28.98,0:18:31.31,Default,,0,0,0,,Валькири Кешіріңіз...
Dialogue: 0,0:18:31.40,0:18:35.53,Default,,0,0,0,,Мен бір күндік жаттығудан кейін жақсы болғандай болдым.
Dialogue: 0,0:18:36.28,0:18:40.16,Default,,0,0,0,,Шу күн мен күн жаттықты.
Dialogue: 0,0:18:41.37,0:18:45.62,Default,,0,0,0,,Дина Енді сіз Death Sizer-мен не жейсіз?
Dialogue: 0,0:18:45.70,0:18:48.08,Default,,0,0,0,,Ол әлгі тұлыпқа айналатын сияқты.
Dialogue: 0,0:18:48.21,0:18:52.25,Default,,0,0,0,,Жеңіске деген ықыластары күшті адам ойынды жеңеді.
Dialogue: 0,0:18:52.38,0:18:56.09,Default,,0,0,0,,Кешіріңіз, бірақ дене бітімі жақсы жігіт әуесқой.
Dialogue: 0,0:18:56.21,0:18:58.67,Default,,0,0,0,,Өткен күнгі әлгі шапшаң ату кездейсоқ болды.
Dialogue: 0,0:18:59.34,0:19:01.97,Default,,0,0,0,,Оның көздері әлі өлген жоқ.
Dialogue: 0,0:19:02.26,0:19:03.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:05.35,0:19:06.64,Default,,0,0,0,,Не?
Dialogue: 0,0:19:09.52,0:19:11.35,Default,,0,0,0,,Енді шайқас басталады.
Dialogue: 0,0:19:11.44,0:19:12.90,Default,,0,0,0,,Шайқас әлі де...
Dialogue: 0,0:19:13.56,0:19:15.27,Default,,0,0,0,,Бұл біткен жоқ
Dialogue: 0,0:19:15.98,0:19:16.90,Default,,0,0,0,,Барт…
Dialogue: 0,0:19:16.98,0:19:20.57,Default,,0,0,0,,1 ұпай Аои Барто алдын ала алынған және оның істейтін ештеңесі жоқ.
Dialogue: 0,0:19:20.65,0:19:23.62,Default,,0,0,0,,Екінші шайқаста қалай күресу керек?
Dialogue: 0,0:19:23.70,0:19:25.41,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:19:25.99,0:19:27.58,Default,,0,0,0,,Тағы да Валькири
Dialogue: 0,0:19:27.66,0:19:29.45,Default,,0,0,0,,Мен асығыс атумен барамын.
Dialogue: 0,0:19:29.54,0:19:31.17,Default,,0,0,0,,
Dialogue: 0,0:19:31.33,0:19:34.92,Default,,0,0,0,,Ой! Не! Rash shooting декларациясы жарияланды!
Dialogue: 0,0:19:35.29,0:19:37.17,Default,,0,0,0,,Анау ақымақ, сен не істеп жатырсың?
Dialogue: 0,0:19:37.25,0:19:39.13,Default,,0,0,0,,Мен тағы да сәтсіздікке ұшырайтыныма сенімдімін
Dialogue: 0,0:19:39.21,0:19:41.43,Default,,0,0,0,,Дұрыс, тоқтатыңыз.
Dialogue: 0,0:19:41.55,0:19:44.34,Default,,0,0,0,,Бұл мүмкін емес! Әдеттегідей түсіріңіз
Dialogue: 0,0:19:44.43,0:19:46.43,Default,,0,0,0,,Бал-нии, жақсысың ба?
Dialogue: 0,0:19:46.51,0:19:47.56,Default,,0,0,0,,…
Dialogue: 0,0:19:47.93,0:19:52.64,Default,,0,0,0,,Балттың ұқыпсыз шақыруы үшін қатты дауыс!
Dialogue: 0,0:19:53.06,0:19:54.65,Default,,0,0,0,,(тістерді қысу дыбысы)
Dialogue: 0,0:19:54.73,0:20:00.65,Default,,0,0,0,,Шулы!
Dialogue: 0,0:20:01.28,0:20:03.36,Default,,0,0,0,,Бұл жолы мен міндетті түрде жетістікке жетемін!
Dialogue: 0,0:20:03.45,0:20:05.07,Default,,0,0,0,,Тоқта және қара!
Dialogue: 0,0:20:05.16,0:20:06.07,Default,,0,0,0,,Бал-нии~
Dialogue: 0,0:20:06.16,0:20:06.95,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:20:07.03,0:20:07.66,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:20:08.45,0:20:10.29,Default,,0,0,0,,Егер сіз осы жерден бас тартсаңыз
Dialogue: 0,0:20:10.41,0:20:13.96,Default,,0,0,0,,Валькиридің серіктесі ретінде мен дисквалификацияландым.
Dialogue: 0,0:20:16.29,0:20:17.50,Default,,0,0,0,,Мен
Dialogue: 0,0:20:18.09,0:20:20.67,Default,,0,0,0,,Мен Валькиридің мені жек көргенін қаламаймын.
Dialogue: 0,0:20:21.34,0:20:23.97,Default,,0,0,0,,Дұрыс, Балто, тапсырманы қабылда.
Dialogue: 0,0:20:24.05,0:20:26.30,Default,,0,0,0,,Бар күш-қуатыңызбен шығанағына қаратыңыз.
Dialogue: 0,0:20:28.14,0:20:30.52,Default,,0,0,0,,Валькири, маған сеніңіз.
Dialogue: 0,0:20:30.60,0:20:32.48,Default,,0,0,0,,Қанша талпынсам да солай
Dialogue: 0,0:20:32.56,0:20:34.94,Default,,0,0,0,,Тағы да өзімді құртамын ба деп ойлаймын.
Dialogue: 0,0:20:35.02,0:20:37.77,Default,,0,0,0,,Өйткені Кайзер Кербеус қорғаныс түрі болып табылады.
Dialogue: 0,0:20:37.86,0:20:40.11,Default,,0,0,0,,Бұл шабуыл түрлеріне қарсы тиімді.
Dialogue: 0,0:20:40.19,0:20:41.78,Default,,0,0,0,,Ләззат алу ләззат~
Dialogue: 0,0:20:42.44,0:20:43.86,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:20:43.95,0:20:45.99,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:20:46.45,0:20:50.33,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:20:50.41,0:20:52.62,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:20:52.70,0:20:53.37,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:59.25,0:21:02.26,Default,,0,0,0,,шығанақ қайтадан тым қиғаш!
Dialogue: 0,0:21:02.38,0:21:03.38,Default,,0,0,0,,Өздерін биік әрі мықты санайтын адамдардың сезімдері мен жүректері —
Dialogue: 0,0:21:03.51,0:21:04.51,Default,,0,0,0,,Уау
Dialogue: 0,0:21:04.59,0:21:05.84,Default,,0,0,0,,Мен мұны қайталадым
Dialogue: 0,0:21:07.34,0:21:09.76,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:21:12.06,0:21:14.06,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:21:17.23,0:21:20.32,Default,,0,0,0,,Валькири қалпына келді.
Dialogue: 0,0:21:20.90,0:21:23.15,Default,,0,0,0,,Алға!
Dialogue: 0,0:21:23.74,0:21:25.95,Default,,0,0,0,,Үлкен күшпен көтерілді
Dialogue: 0,0:21:26.03,0:21:27.86,Default,,0,0,0,,Және шабуыл!
Dialogue: 0,0:21:28.53,0:21:31.95,Default,,0,0,0,,Бұл жол! Тез ату!
Dialogue: 0,0:21:32.33,0:21:33.58,Default,,0,0,0,,Ешуа
Dialogue: 0,0:21:33.66,0:21:36.08,Default,,0,0,0,,Міне! Тез ату!
Dialogue: 0,0:21:36.16,0:21:37.12,Default,,0,0,0,,Жүр! Бар! Бар!
Dialogue: 0,0:21:37.21,0:21:38.38,Default,,0,0,0,,Кумичо
Dialogue: 0,0:21:38.46,0:21:40.54,Default,,0,0,0,,Күткендей, олар мені қолдап жатыр.
Dialogue: 0,0:21:43.09,0:21:43.92,Default,,0,0,0,,Келеді
Dialogue: 0,0:21:45.09,0:21:47.76,Default,,0,0,0,,Кербеусты итеріп жібере бер!
Dialogue: 0,0:21:50.05,0:21:52.39,Default,,0,0,0,,Уау
Dialogue: 0,0:22:07.70,0:22:13.79,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:13.99,0:22:20.13,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:20.58,0:22:26.13,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:26.59,0:22:29.93,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:30.09,0:22:35.02,Default,,0,0,0,,Сіз енді ешқашан жоғалмайсыз
Dialogue: 0,0:22:36.93,0:22:39.64,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:39.73,0:22:42.94,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:43.02,0:22:49.36,Default,,0,0,0,,Артынан қуып жетсең көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:49.61,0:22:55.16,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:55.33,0:23:01.92,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:02.50,0:23:07.92,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:08.09,0:23:11.26,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:11.76,0:23:15.72,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:24.61,0:23:26.53,Default,,0,0,0,,Мен көңілді адаммын ба деп ойлаймын.
Dialogue: 0,0:23:26.61,0:23:29.78,Default,,0,0,0,,Мен бір рет жеңіске жеткеннен кейін қуанатын адам емеспін.
Dialogue: 0,0:23:29.86,0:23:31.70,Default,,0,0,0,,Бірақ хехехе
Dialogue: 0,0:23:31.78,0:23:33.62,Default,,0,0,0,,Мен осылай жүре беремін.
Dialogue: 0,0:23:33.70,0:23:36.45,Default,,0,0,0,,Мен Сербеусты және кез келген қарсыласты жеңемін.
Dialogue: 0,0:23:36.54,0:23:38.79,Default,,0,0,0,,Айтпақшы, көңілді адам қандай?
Dialogue: 0,0:23:39.45,0:23:41.16,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:41.25,0:23:43.08,Default,,0,0,0,,Жарылыс! Тез ату!
Dialogue: 0,0:23:43.63,0:23:46.00,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:46.09,0:23:48.46,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:49.96,0:23:55.96,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory