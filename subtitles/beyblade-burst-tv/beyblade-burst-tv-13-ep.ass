Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.59,0:00:09.21,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.30,0:00:12.47,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.63,0:00:14.72,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:16.97,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.05,0:00:19.26,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.52,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.31,0:00:26.23,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.35,0:00:28.77,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:34.24,0:00:37.03,Default,,0,0,0,,Шынайы флэш түсіру!
Dialogue: 0,0:00:37.78,0:00:38.62,Default,,0,0,0,,Жартылай финал -
Dialogue: 0,0:00:38.95,0:00:41.75,Default,,0,0,0,,Мен ақырында Уакияның уивернін жеңдім.
Dialogue: 0,0:00:41.83,0:00:43.62,Default,,0,0,0,,Бұл финалға өтіп жатқанымызды білдіреді.
Dialogue: 0,0:00:44.41,0:00:47.46,Default,,0,0,0,,Ал екінші матч — Шу және Джинблейд Орочи
Dialogue: 0,0:00:48.21,0:00:51.46,Default,,0,0,0,,Шудың Спригганы мен Орочидің Одинінің арасындағы бірінші шайқас
Dialogue: 0,0:00:51.63,0:00:52.67,Default,,0,0,0,,тең аяқталды
Dialogue: 0,0:00:58.43,0:00:59.47,Default,,0,0,0,,Шу
Dialogue: 0,0:01:00.06,0:01:02.10,Default,,0,0,0,,Неліктен ол қозғалмайды?
Dialogue: 0,0:01:02.31,0:01:03.77,Default,,0,0,0,,Не болды деп таң қалдым~
Dialogue: 0,0:01:07.69,0:01:10.40,Default,,0,0,0,,Енді келесі сабаққа көшейік.
Dialogue: 0,0:01:10.86,0:01:13.78,Default,,0,0,0,,Жарайды, бірінші шайқас тең аяқталды.
Dialogue: 0,0:01:13.86,0:01:16.03,Default,,0,0,0,,Куришу VS Silver Blade Orochi
Dialogue: 0,0:01:16.32,0:01:17.95,Default,,0,0,0,,Финалға кім шығады?
Dialogue: 0,0:01:18.03,0:01:20.70,Default,,0,0,0,,Матч екінші шайқаста
Dialogue: 0,0:01:28.79,0:01:31.17,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:31.50,0:01:36.67,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:47.98,0:01:51.36,Default,,0,0,0,,Мен барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:51.86,0:01:53.98,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:54.40,0:01:58.53,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:58.66,0:02:01.87,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:02:01.99,0:02:08.41,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:08.71,0:02:13.13,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:13.63,0:02:19.05,Default,,0,0,0,,Дауысты дауыстап, дірілдеп ойнайық
Dialogue: 0,0:02:19.18,0:02:21.43,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:21.51,0:02:26.22,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:26.39,0:02:31.48,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:31.77,0:02:34.02,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:34.23,0:02:36.57,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:36.86,0:02:40.78,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:40.95,0:02:45.95,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:46.16,0:02:48.33,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:52.58,0:02:54.09,Default,,0,0,0,,Шу соты!
Dialogue: 0,0:02:59.67,0:03:01.47,Default,,0,0,0,,Обелиск Один
Dialogue: 0,0:03:01.55,0:03:04.93,Default,,0,0,0,,Іске қосу жылдамдығы басқа ұялардан әлдеқайда асып түседі.
Dialogue: 0,0:03:05.56,0:03:07.85,Default,,0,0,0,,Silverblade Orochi оның сипаттамаларын пайдаланады.
Dialogue: 0,0:03:08.18,0:03:10.14,Default,,0,0,0,,Қандай позициядан ату керек?
Dialogue: 0,0:03:10.35,0:03:12.90,Default,,0,0,0,,Мен қалаған нәтижеге қол жеткізе алатынымды білемін.
Dialogue: 0,0:03:14.52,0:03:16.15,Default,,0,0,0,,Аудитория мүшелері
Dialogue: 0,0:03:16.48,0:03:18.53,Default,,0,0,0,,(өткізу орнындағы шу)
Dialogue: 0,0:03:18.61,0:03:20.74,Default,,0,0,0,,Ой...
Dialogue: 0,0:03:20.86,0:03:21.86,Default,,0,0,0,,Не?
Dialogue: 0,0:03:22.03,0:03:25.12,Default,,0,0,0,,Аудитория Үлкен аудитория.
Dialogue: 0,0:03:25.20,0:03:26.95,Default,,0,0,0,,Олай болса солай айту керек.
Dialogue: 0,0:03:27.04,0:03:29.66,Default,,0,0,0,,Менің ойымша, катакананы қолдану өте жақсы.
Dialogue: 0,0:03:29.75,0:03:31.87,Default,,0,0,0,,Бұл катакана емес, ағылшын тілі.
Dialogue: 0,0:03:31.96,0:03:34.83,Default,,0,0,0,,Түсінбесең жарайды, бұл Барто.
Dialogue: 0,0:03:36.46,0:03:39.34,Default,,0,0,0,,Бірінші шайқас қалай болды?
Dialogue: 0,0:03:39.42,0:03:42.43,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:42.88,0:03:45.64,Default,,0,0,0,,Иә, иә, жақсы.
Dialogue: 0,0:03:45.97,0:03:48.31,Default,,0,0,0,,Ең жақсысы жақсымен соқтығысады
Dialogue: 0,0:03:48.39,0:03:50.48,Default,,0,0,0,,Бұл тамаша сессия болды.
Dialogue: 0,0:03:50.56,0:03:54.73,Default,,0,0,0,,Біздің билер ойнаған әуенге бұдан да мас болуыңды қалаймын.
Dialogue: 0,0:03:55.02,0:03:56.69,Default,,0,0,0,,Келесі екінші шайқас
Dialogue: 0,0:03:57.90,0:04:00.86,Default,,0,0,0,,Одан да жоғары сапалы музыка тыңдайық.
Dialogue: 0,0:04:02.45,0:04:04.57,Default,,0,0,0,,Дегенмен, ең бастысы – мен.
Dialogue: 0,0:04:04.91,0:04:08.58,Default,,0,0,0,,Сіздің спригганыңыз менің жеңісімді мадақтайтын екпін.
Dialogue: 0,0:04:08.91,0:04:12.83,Default,,0,0,0,,Мысалы, барабан мен флейта корпусының үшбұрышы...
Dialogue: 0,0:04:12.91,0:04:14.12,Default,,0,0,0,,айтуым керек пе?
Dialogue: 0,0:04:14.33,0:04:15.67,Default,,0,0,0,,(үшбұрыш дыбысы)
Dialogue: 0,0:04:15.88,0:04:17.75,Default,,0,0,0,,(Көрермендердің күлкілері)
Dialogue: 0,0:04:18.25,0:04:21.09,Default,,0,0,0,,Үшбұрыш нені білдіреді?
Dialogue: 0,0:04:21.38,0:04:23.68,Default,,0,0,0,,Екінші шайқас алдында
Dialogue: 0,0:04:23.76,0:04:28.35,Default,,0,0,0,,Джинблейд Орочидің қойылымы No... Бұл арандатушылық па?
Dialogue: 0,0:04:28.43,0:04:30.01,Default,,0,0,0,,Аняр
Dialogue: 0,0:04:30.10,0:04:32.23,Default,,0,0,0,,Орочи басты кейіпкерге айналды
Dialogue: 0,0:04:32.31,0:04:33.98,Default,,0,0,0,,Бұл жиіркенішті.
Dialogue: 0,0:04:34.23,0:04:36.15,Default,,0,0,0,,Қалағаныңызды айта аласыз.
Dialogue: 0,0:04:36.23,0:04:38.69,Default,,0,0,0,,Менің ойымша, бұл да Орочи әдісі.
Dialogue: 0,0:04:38.77,0:04:39.73,Default,,0,0,0,,Мұны қалай жасауға болады?
Dialogue: 0,0:04:40.07,0:04:44.32,Default,,0,0,0,,Орочи стадионның сыртында да өз қарқынын белгілейді.
Dialogue: 0,0:04:44.53,0:04:48.95,Default,,0,0,0,,Осылай орындау екінші шайқаста да тиімді.
Dialogue: 0,0:04:49.08,0:04:50.74,Default,,0,0,0,,Бұл психологиялық соғыс.
Dialogue: 0,0:04:51.16,0:04:53.75,Default,,0,0,0,,Не? Сол үшбұрыш...
Dialogue: 0,0:04:53.96,0:04:55.25,Default,,0,0,0,,Шұңқырға байланысты
Dialogue: 0,0:04:55.33,0:04:58.00,Default,,0,0,0,,Көрермендер қатысатын спектакльді баурап алыңыз
Dialogue: 0,0:04:58.08,0:05:01.25,Default,,0,0,0,,Кейбір адамдар өз қабілеттерін көрсете алмауы мүмкін.
Dialogue: 0,0:05:01.55,0:05:03.17,Default,,0,0,0,,Бірақ Шу ше?
Dialogue: 0,0:05:04.47,0:05:07.64,Default,,0,0,0,,Мен олардың тыңдағысы келмейтінін сеземін.
Dialogue: 0,0:05:07.84,0:05:10.56,Default,,0,0,0,,Ах, Шу үшбұрыш емес.
Dialogue: 0,0:05:11.47,0:05:13.06,Default,,0,0,0,,(үшбұрыш дыбысы)
Dialogue: 0,0:05:14.14,0:05:16.48,Default,,0,0,0,,Сіз бұл туралы ерекше айтасыз ба?
Dialogue: 0,0:05:16.85,0:05:19.90,Default,,0,0,0,,Ол тұрғанда басқалардан гөрі ойынға көбірек көңіл бөледі.
Dialogue: 0,0:05:20.27,0:05:21.48,Default,,0,0,0,,Сондықтан да күшті
Dialogue: 0,0:05:22.03,0:05:23.69,Default,,0,0,0,,Сондықтан сіз жеңесіз
Dialogue: 0,0:05:25.95,0:05:27.24,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:05:28.45,0:05:30.20,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:37.87,0:05:41.34,Default,,0,0,0,,Сіз қалай ойлайсыз? Кішкене ойын-сауық, сізге ұнады деп үміттенемін.
Dialogue: 0,0:05:42.50,0:05:43.84,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,0:05:51.43,0:05:53.06,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:05:53.43,0:05:56.27,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:56.52,0:05:58.48,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:00.65,0:06:03.90,Default,,0,0,0,,Аудитория мүшелері, екінші шайқас басталды~
Dialogue: 0,0:06:06.82,0:06:09.61,Default,,0,0,0,,Енді шабуыл жасаңыз! один
Dialogue: 0,0:06:11.62,0:06:13.66,Default,,0,0,0,,Presto Қатты жүр!
Dialogue: 0,0:06:13.83,0:06:16.33,Default,,0,0,0,,Один шабуыл жасайды
Dialogue: 0,0:06:18.96,0:06:21.29,Default,,0,0,0,,Жарайды, жақсы, Спригган.
Dialogue: 0,0:06:23.25,0:06:26.46,Default,,0,0,0,,Бұл бірінші шайқаспен бірдей.
Dialogue: 0,0:06:26.55,0:06:29.09,Default,,0,0,0,,Шудың мақсаты - қарсы үзіліс.
Dialogue: 0,0:06:32.76,0:06:34.64,Default,,0,0,0,,Спригган және Один
Dialogue: 0,0:06:34.72,0:06:36.35,Default,,0,0,0,,Ұшқан ұшқындармен қақтығыс!
Dialogue: 0,0:06:42.69,0:06:45.44,Default,,0,0,0,,Бұл жүріс... Одиннің ерекше қимылы ма?
Dialogue: 0,0:06:47.07,0:06:48.36,Default,,0,0,0,,Стаккато
Dialogue: 0,0:06:48.57,0:06:51.70,Default,,0,0,0,,Жақсы естіледі. Дауысты күшейтіңіз, Один.
Dialogue: 0,0:06:56.83,0:06:59.33,Default,,0,0,0,,Есептегіш үзіліс мөрленген
Dialogue: 0,0:06:59.50,0:07:01.29,Default,,0,0,0,,Ол керемет жұмыс жасайды.
Dialogue: 0,0:07:03.00,0:07:05.09,Default,,0,0,0,,Спригган ұстаңыз.
Dialogue: 0,0:07:08.13,0:07:09.72,Default,,0,0,0,,Бұл кескілескен шайқас!
Dialogue: 0,0:07:09.84,0:07:11.18,Default,,0,0,0,,Спригган да, Один де
Dialogue: 0,0:07:11.30,0:07:13.89,Default,,0,0,0,,Бұл бүкіл стадионды пайдаланатын шабуыл мен қорғаныс!
Dialogue: 0,0:07:15.85,0:07:16.76,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:07:19.85,0:07:22.69,Default,,0,0,0,,Дәл осы жерде шпригган Одинді басып алды.
Dialogue: 0,0:07:22.98,0:07:23.98,Default,,0,0,0,,Не?
Dialogue: 0,0:07:25.94,0:07:28.53,Default,,0,0,0,,Спригганның дауылы
Dialogue: 0,0:07:28.65,0:07:30.65,Default,,0,0,0,,Шу күреңайға 1 ұпай
Dialogue: 0,0:07:30.78,0:07:32.36,Default,,0,0,0,,Керемет! (Рантаро) Жарайды!
Dialogue: 0,0:07:32.86,0:07:34.37,Default,,0,0,0,,Сіз мұны істедіңіз!
Dialogue: 0,0:07:34.57,0:07:36.28,Default,,0,0,0,,Шуу-кун өте керемет!
Dialogue: 0,0:07:36.91,0:07:39.50,Default,,0,0,0,,Қарсыластың мінез-құлқын мұқият оқисың.
Dialogue: 0,0:07:39.66,0:07:40.75,Default,,0,0,0,,Шудан күткендей!
Dialogue: 0,0:07:40.96,0:07:43.75,Default,,0,0,0,,Екінші шайқаста бірінші ұпайды кім алды?
Dialogue: 0,0:07:44.00,0:07:46.38,Default,,0,0,0,,Спригган дауылы!
Dialogue: 0,0:07:46.79,0:07:47.67,Default,,0,0,0,,Иә
Dialogue: 0,0:07:49.76,0:07:51.59,Default,,0,0,0,,Спригган дауылы…
Dialogue: 0,0:07:51.72,0:07:53.68,Default,,0,0,0,,Бей жарылыстан жеңілудің аз-ақ алдында еді.
Dialogue: 0,0:07:54.14,0:07:57.47,Default,,0,0,0,,Аяқтауға жеткілікті күші бар деп ойлау...
Dialogue: 0,0:07:59.47,0:08:00.43,Default,,0,0,0,,Тағы 500 рет!
Dialogue: 0,0:08:04.65,0:08:06.19,Default,,0,0,0,,Диссонанс
Dialogue: 0,0:08:07.02,0:08:09.36,Default,,0,0,0,,Менің музыкамды бұлай бұзады деп ойламадым...
Dialogue: 0,0:08:10.57,0:08:13.15,Default,,0,0,0,,Жарылыс үшін ату
Dialogue: 0,0:08:13.32,0:08:15.16,Default,,0,0,0,,Иығыңдағы жүк артады
Dialogue: 0,0:08:15.95,0:08:17.12,Default,,0,0,0,,Әлі де...
Dialogue: 0,0:08:18.33,0:08:19.70,Default,,0,0,0,,Ол күтіп тұр
Dialogue: 0,0:08:20.79,0:08:22.12,Default,,0,0,0,,Бұл жолы I
Dialogue: 0,0:08:22.58,0:08:24.29,Default,,0,0,0,,Оған жауап беру кезегім.
Dialogue: 0,0:08:26.25,0:08:28.46,Default,,0,0,0,,Мен де сенімен төбелескім келеді
Dialogue: 0,0:08:29.34,0:08:30.34,Default,,0,0,0,,Финалда
Dialogue: 0,0:08:30.92,0:08:32.92,Default,,0,0,0,,Шу маған қарап тұр.
Dialogue: 0,0:08:33.09,0:08:35.30,Default,,0,0,0,,Жоқ, мен Балтоға қарап тұрмын.
Dialogue: 0,0:08:35.59,0:08:37.72,Default,,0,0,0,,Өйткені біз уәде бердік
Dialogue: 0,0:08:37.85,0:08:39.22,Default,,0,0,0,,Финалда кездескенше
Dialogue: 0,0:08:39.30,0:08:40.64,Default,,0,0,0,,Уәде…
Dialogue: 0,0:08:40.72,0:08:43.68,Default,,0,0,0,,Шу уәдені дәл қазір ойлады ма?
Dialogue: 0,0:08:44.27,0:08:47.44,Default,,0,0,0,,Сонымен Шудың жігіті Одиннен бас тартты, солай ма?
Dialogue: 0,0:08:47.61,0:08:49.48,Default,,0,0,0,,Бұлай айтуға әлі ерте.
Dialogue: 0,0:08:49.94,0:08:53.49,Default,,0,0,0,,Одиннің көтерілу жылдамдығын бағаламауға болмайды.
Dialogue: 0,0:08:54.57,0:08:57.37,Default,,0,0,0,,Алдымен ұпайлар алынды, мен қуып жететін күйде болдым.
Dialogue: 0,0:08:57.53,0:08:59.74,Default,,0,0,0,,Үшінші шайқас агрессивті болады.
Dialogue: 0,0:08:59.99,0:09:02.79,Default,,0,0,0,,Иә, бұл қарқынды шабуыл
Dialogue: 0,0:09:02.87,0:09:05.37,Default,,0,0,0,,Спригган келесіде аман қалады ма?
Dialogue: 0,0:09:05.46,0:09:08.21,Default,,0,0,0,,Бұл Спригган қауіпті емес пе?
Dialogue: 0,0:09:08.54,0:09:12.17,Default,,0,0,0,,Міне, Орочи техникасы мен Одиннің ерекшеліктері.
Dialogue: 0,0:09:12.26,0:09:14.55,Default,,0,0,0,,Бұл ең жақсы комбинация.
Dialogue: 0,0:09:14.80,0:09:18.89,Default,,0,0,0,,Оны дәл қазір бәрінен де төбелесіп жатқан Шуу сезінсе керек.
Dialogue: 0,0:09:19.22,0:09:21.06,Default,,0,0,0,,Бірақ Шу мені көрді.
Dialogue: 0,0:09:22.22,0:09:23.52,Default,,0,0,0,,Анықтаңыз
Dialogue: 0,0:09:24.18,0:09:26.98,Default,,0,0,0,,Мен ол маған осылай айтып тұрғандай сезінемін.
Dialogue: 0,0:09:29.02,0:09:31.32,Default,,0,0,0,,Алысқа қарайтын уақыт емес.
Dialogue: 0,0:09:32.69,0:09:36.20,Default,,0,0,0,,Мен сені жеңдім, алға қараймын
Dialogue: 0,0:09:36.28,0:09:39.66,Default,,0,0,0,,Мен бұл сенімділікті келесі жолы жоямын.
Dialogue: 0,0:09:39.74,0:09:42.24,Default,,0,0,0,,Сіздің сприганыңыз жарылып кетеді.
Dialogue: 0,0:09:42.66,0:09:44.33,Default,,0,0,0,,Мен орындаған ерекше қимыл
Dialogue: 0,0:09:44.50,0:09:46.50,Default,,0,0,0,,Жарылыс дыбысымен
Dialogue: 0,0:09:46.75,0:09:49.54,Default,,0,0,0,,Күміс жүз Орочидің тағы бір арандатуы?
Dialogue: 0,0:09:49.96,0:09:52.09,Default,,0,0,0,,Алдын ала қарау сериясы осында!
Dialogue: 0,0:09:52.34,0:09:53.84,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:09:54.21,0:09:55.46,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:03.22,0:10:04.60,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:10:10.48,0:10:12.61,Default,,0,0,0,,Біз ұшыру құрылғысының сыртқы түрін өзгерттік.
Dialogue: 0,0:10:13.61,0:10:15.36,Default,,0,0,0,,Бұл оның ашық мақсаты ма?
Dialogue: 0,0:10:16.19,0:10:17.36,Default,,0,0,0,,Орочидің іске қосу құралы
Dialogue: 0,0:10:17.49,0:10:20.03,Default,,0,0,0,,Менің асығыс атылғаннан бері ол еңкейіп кетті.
Dialogue: 0,0:10:20.57,0:10:21.78,Default,,0,0,0,,Бұл туралы айтатын болсақ
Dialogue: 0,0:10:21.87,0:10:23.62,Default,,0,0,0,,Ол бұрынғыдан да тереңірек.
Dialogue: 0,0:10:24.16,0:10:25.70,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:10:26.16,0:10:28.21,Default,,0,0,0,,Енді мені туттимен шақыр.
Dialogue: 0,0:10:28.79,0:10:32.00,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:32.08,0:10:33.59,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:10:35.34,0:10:36.71,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:10:40.43,0:10:41.72,Default,,0,0,0,,Бұл қозғалыс...
Dialogue: 0,0:10:46.35,0:10:50.69,Default,,0,0,0,,Аудитория, Blastbeat осылай дейді.
Dialogue: 0,0:10:56.23,0:10:57.94,Default,,0,0,0,,Қандай ауыр соққы!
Dialogue: 0,0:10:58.07,0:10:59.53,Default,,0,0,0,,Обелиск Один
Dialogue: 0,0:10:59.74,0:11:02.53,Default,,0,0,0,,Керемет қозғалыспен Спригганға тістеріңізді жалаңаштаңыз
Dialogue: 0,0:11:03.32,0:11:05.91,Default,,0,0,0,,Бұл жарылыс соққысы
Dialogue: 0,0:11:06.37,0:11:09.12,Default,,0,0,0,,Орочидің жарылғаны туралы мәлімдемесі күн емес.
Dialogue: 0,0:11:09.21,0:11:09.87,Default,,0,0,0,,Не?
Dialogue: 0,0:11:09.96,0:11:13.50,Default,,0,0,0,,Жылдамдық және
Dialogue: 0,0:11:13.58,0:11:16.80,Default,,0,0,0,,Үш диск арқылы жасалған ауыр салмақтағы шабуыл...
Dialogue: 0,0:11:17.09,0:11:18.84,Default,,0,0,0,,Бұл жарылыс соқты
Dialogue: 0,0:11:19.42,0:11:20.97,Default,,0,0,0,,Бұл қорқынышты трюк.
Dialogue: 0,0:11:21.05,0:11:22.84,Default,,0,0,0,,Бұл жұмыс істемейді.
Dialogue: 0,0:11:22.93,0:11:24.55,Default,,0,0,0,,Берілме, Спригган!
Dialogue: 0,0:11:30.10,0:11:31.27,Default,,0,0,0,,Спригганға барыңыз!
Dialogue: 0,0:11:34.06,0:11:35.31,Default,,0,0,0,,Қарсы үзіліс!
Dialogue: 0,0:11:37.78,0:11:40.28,Default,,0,0,0,,Обелиск Один ойнаңыз!
Dialogue: 0,0:11:46.62,0:11:48.62,Default,,0,0,0,,Спригганды атып тастаңыз!
Dialogue: 0,0:11:54.75,0:11:56.59,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:12:02.09,0:12:04.30,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:04.89,0:12:07.56,Default,,0,0,0,,Жарылыс және қарсы үзіліс
Dialogue: 0,0:12:07.68,0:12:09.43,Default,,0,0,0,,Қатты қақтығыс!
Dialogue: 0,0:12:09.81,0:12:10.89,Default,,0,0,0,,Бұл үздіксіз шабуыл-
Dialogue: 0,0:12:11.02,0:12:13.31,Default,,0,0,0,,Қай шығанақ басым болады?
Dialogue: 0,0:12:13.77,0:12:15.35,Default,,0,0,0,,Енді аяқталды!
Dialogue: 0,0:12:15.81,0:12:16.73,Default,,0,0,0,,Шешіңіз!
Dialogue: 0,0:12:24.16,0:12:25.99,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:12:26.16,0:12:27.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:30.58,0:12:32.46,Default,,0,0,0,,Ba Burst
Dialogue: 0,0:12:32.54,0:12:34.04,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:34.96,0:12:37.42,Default,,0,0,0,,Дауыл Спригганның жарылуы аяқталды
Dialogue: 0,0:12:37.84,0:12:40.71,Default,,0,0,0,,Куришуу 3-0 есебімен жеңді
Dialogue: 0,0:12:41.42,0:12:42.67,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:12:42.76,0:12:44.38,Default,,0,0,0,,Шу-кун жеңді~!
Dialogue: 0,0:12:45.09,0:12:48.14,Default,,0,0,0,,Жарылыс соққысы мен қарсы үзіліс
Dialogue: 0,0:12:48.35,0:12:49.76,Default,,0,0,0,,Ақыры шешілді!
Dialogue: 0,0:12:49.85,0:12:52.93,Default,,0,0,0,,Куришу Керемет жеңіс!
Dialogue: 0,0:12:53.43,0:12:55.06,Default,,0,0,0,,Иә! Алақай!
Dialogue: 0,0:12:55.31,0:12:57.35,Default,,0,0,0,,Кумичо Дина Инусуке
Dialogue: 0,0:12:57.48,0:12:59.32,Default,,0,0,0,,Міне, осында! Бұл финал!
Dialogue: 0,0:12:59.69,0:13:01.78,Default,,0,0,0,,Шу күшті ғой.
Dialogue: 0,0:13:01.86,0:13:03.99,Default,,0,0,0,,А, мен жарақат алғанша.
Dialogue: 0,0:13:04.07,0:13:06.53,Default,,0,0,0,,Спригганның қабілеті жоғарылады ма?
Dialogue: 0,0:13:07.28,0:13:09.07,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:13:09.91,0:13:11.54,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:13:11.62,0:13:15.12,Default,,0,0,0,,Күшті Шумен шайқаса алатын болсаң, керемет болар еді!
Dialogue: 0,0:13:15.21,0:13:17.88,Default,,0,0,0,,Тез кел, финалға кел!
Dialogue: 0,0:13:18.50,0:13:21.59,Default,,0,0,0,,Финал... Ақыры осы екеуі.
Dialogue: 0,0:13:21.67,0:13:24.01,Default,,0,0,0,,Ол шынымен уәдесінде тұрды...
Dialogue: 0,0:13:24.47,0:13:27.22,Default,,0,0,0,,Шу Ең жақсы финалға айналдырайық!
Dialogue: 0,0:13:28.89,0:13:29.68,Default,,0,0,0,,Әй
Dialogue: 0,0:13:35.06,0:13:36.94,Default,,0,0,0,,Иә...
Dialogue: 0,0:13:37.56,0:13:39.06,Default,,0,0,0,,Матчты не шешті?
Dialogue: 0,0:13:39.19,0:13:41.94,Default,,0,0,0,,Бұл шайқастан басқа не көрдіңіз?
Dialogue: 0,0:13:42.15,0:13:43.11,Default,,0,0,0,,Бұл дегеніміз
Dialogue: 0,0:13:43.73,0:13:45.03,Default,,0,0,0,,Енді не болады?
Dialogue: 0,0:13:45.44,0:13:49.03,Default,,0,0,0,,Менің бар ойым сені ұру еді.
Dialogue: 0,0:13:49.37,0:13:51.12,Default,,0,0,0,,Куришуды жеңу арқылы
Dialogue: 0,0:13:51.41,0:13:53.70,Default,,0,0,0,,Сахнамды келесі деңгейге көтергім келді.
Dialogue: 0,0:13:54.04,0:13:57.58,Default,,0,0,0,,Сіз бұл шайқаста қайтадан күшейуге тырыстыңыз.
Dialogue: 0,0:13:58.21,0:14:00.50,Default,,0,0,0,,Финалда күтіп тұрған жігітке.
Dialogue: 0,0:14:02.13,0:14:05.09,Default,,0,0,0,,Уау, мен бір нәрсеге қатты қуандым!
Dialogue: 0,0:14:07.22,0:14:09.34,Default,,0,0,0,,Бір күні тағы да жарысқым келеді.
Dialogue: 0,0:14:09.55,0:14:12.76,Default,,0,0,0,,Финал Мен сенің ең жақсы өнеріңді күтемін.
Dialogue: 0,0:14:14.56,0:14:17.89,Default,,0,0,0,,Қызу шайқас біткен екеуіне қараңызшы.
Dialogue: 0,0:14:17.98,0:14:21.40,Default,,0,0,0,,Жақсы жекпе-жек үшін бір-бірін мадақтап, қол алысу
Dialogue: 0,0:14:21.56,0:14:22.52,Default,,0,0,0,,Керемет жекпе-жек!
Dialogue: 0,0:14:22.61,0:14:23.52,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:24.65,0:14:25.53,Default,,0,0,0,,…
Dialogue: 0,0:14:31.91,0:14:34.29,Default,,0,0,0,,Сіз, мүмкін емес.
Dialogue: 0,0:14:35.16,0:14:38.04,Default,,0,0,0,,Толық жеңіліс, сол ақыл күші.
Dialogue: 0,0:14:38.79,0:14:40.54,Default,,0,0,0,,Бұл менің әлі де сонда екенімді білдіре ме?
Dialogue: 0,0:14:42.04,0:14:43.25,Default,,0,0,0,,Мен... Мен ондай жігіттерді шын жек көремін!
Dialogue: 0,0:14:45.17,0:14:46.26,Default,,0,0,0,,Okay!
Dialogue: 0,0:14:46.34,0:14:50.22,Default,,0,0,0,,Қатты тартысты WBBA Йонекома аудандық турнирі
Dialogue: 0,0:14:50.30,0:14:52.01,Default,,0,0,0,,Бұл ақырғы шайқас!
Dialogue: 0,0:14:52.47,0:14:54.43,Default,,0,0,0,,Бладер шыңға ұмтылады
Dialogue: 0,0:14:54.51,0:14:55.85,Default,,0,0,0,,Аты...
Dialogue: 0,0:14:56.93,0:15:00.31,Default,,0,0,0,,Куришу Аои Балтқа қарсы!
Dialogue: 0,0:15:00.39,0:15:01.44,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:15:01.52,0:15:03.61,Default,,0,0,0,,У… Уу…
Dialogue: 0,0:15:04.32,0:15:05.77,Default,,0,0,0,,Барлығы қарап отыр
Dialogue: 0,0:15:05.86,0:15:07.15,Default,,0,0,0,,Назар аударыңыз!
Dialogue: 0,0:15:07.74,0:15:09.86,Default,,0,0,0,,Не, қобалжыдың ба?
Dialogue: 0,0:15:09.95,0:15:13.32,Default,,0,0,0,,Мен бұл қызықтырақ болар деп ойладым.
Dialogue: 0,0:15:13.41,0:15:15.08,Default,,0,0,0,,Осы уақытқа дейін өмір
Dialogue: 0,0:15:15.16,0:15:18.04,Default,,0,0,0,,Ол ешқашан назар аудармаған.
Dialogue: 0,0:15:18.12,0:15:19.29,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:19.66,0:15:22.58,Default,,0,0,0,,Кел, Золушка Бала Барто Аои
Dialogue: 0,0:15:22.83,0:15:25.71,Default,,0,0,0,,Сіз ақыры соңғы шайқасқа жеттіңіз!
Dialogue: 0,0:15:25.79,0:15:27.63,Default,,0,0,0,,Және әлі де күшті
Dialogue: 0,0:15:27.76,0:15:30.17,Default,,0,0,0,,Финалист: Куришуу
Dialogue: 0,0:15:30.30,0:15:33.76,Default,,0,0,0,,Жеңісті Валкири немесе Спригган әкеледі ме?
Dialogue: 0,0:15:33.84,0:15:36.85,Default,,0,0,0,,Ұлдар мен қыздар Ақтық шайқаста кездескенше
Dialogue: 0,0:15:36.93,0:15:38.02,Default,,0,0,0,,Кездескенше
Dialogue: 0,0:15:44.65,0:15:45.65,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:45.73,0:15:46.94,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:15:47.02,0:15:48.40,Default,,0,0,0,,Шу!
Dialogue: 0,0:15:48.82,0:15:51.20,Default,,0,0,0,,Жарайсың Шу! Оңай жеңіс!
Dialogue: 0,0:15:51.53,0:15:53.24,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:15:53.53,0:15:57.20,Default,,0,0,0,,Біз қазір Bay Club-та тойлаймыз.
Dialogue: 0,0:15:57.33,0:15:58.95,Default,,0,0,0,,Бірге барайық!
Dialogue: 0,0:15:59.04,0:15:59.95,Default,,0,0,0,,Мереке?
Dialogue: 0,0:16:00.04,0:16:03.21,Default,,0,0,0,,Анам да маған Хисшо наны деген жұмбақ нан әкелді.
Dialogue: 0,0:16:03.92,0:16:05.29,Default,,0,0,0,,Нан ұтып алды ма?
Dialogue: 0,0:16:05.50,0:16:08.00,Default,,0,0,0,,Маған көру қызық болатынын айтты...
Dialogue: 0,0:16:08.09,0:16:09.38,Default,,0,0,0,,Бәлкім, осыған ұқсас нәрсе
Dialogue: 0,0:16:12.26,0:16:13.84,Default,,0,0,0,,Солай ма...?
Dialogue: 0,0:16:13.93,0:16:15.34,Default,,0,0,0,,Иә, мүмкін
Dialogue: 0,0:16:15.72,0:16:18.18,Default,,0,0,0,,Жүр, кеттік! Барлығы бірінші болды
Dialogue: 0,0:16:19.26,0:16:23.10,Default,,0,0,0,,Сен екеуміз ақтық сынға түсетін жолдаспыз.
Dialogue: 0,0:16:23.39,0:16:25.23,Default,,0,0,0,,Екі адамның тойлап жатқаны біртүрлі емес пе?
Dialogue: 0,0:16:25.40,0:16:27.27,Default,,0,0,0,,Біртүрлі болған дұрыс!
Dialogue: 0,0:16:27.36,0:16:29.86,Default,,0,0,0,,Ақырында біз әріптестерміз.
Dialogue: 0,0:16:29.94,0:16:32.19,Default,,0,0,0,,Барлығы бірге көңіл көтерсе жақсы болар еді.
Dialogue: 0,0:16:33.03,0:16:34.61,Default,,0,0,0,,Бартқа ұқсайды.
Dialogue: 0,0:16:34.86,0:16:36.82,Default,,0,0,0,,Сіз әрқашан уәде бердіңіз, солай ма?
Dialogue: 0,0:16:36.91,0:16:38.83,Default,,0,0,0,,Олар финалға шығады.
Dialogue: 0,0:16:39.03,0:16:41.20,Default,,0,0,0,,Уәде орындалды.
Dialogue: 0,0:16:41.29,0:16:43.21,Default,,0,0,0,,Бұл керемет, Шу!
Dialogue: 0,0:16:43.41,0:16:44.83,Default,,0,0,0,,Өйткені бұл уәде
Dialogue: 0,0:16:45.00,0:16:46.29,Default,,0,0,0,,Дина сияқты нәрсе
Dialogue: 0,0:16:46.38,0:16:49.88,Default,,0,0,0,,Жарақат алған бұрынғыдан да күшті екенсің дейді.
Dialogue: 0,0:16:50.09,0:16:51.67,Default,,0,0,0,,Сіз қаншалықты күшті болдыңыз?
Dialogue: 0,0:16:51.76,0:16:54.34,Default,,0,0,0,,Мен финалды асыға күтемін!
Dialogue: 0,0:16:54.43,0:16:56.14,Default,,0,0,0,,Сіз де күшейіп кеттіңіз, солай ма?
Dialogue: 0,0:16:57.05,0:16:57.89,Default,,0,0,0,,А...
Dialogue: 0,0:16:58.39,0:17:00.31,Default,,0,0,0,,Шынайы жарқыл түсіру
Dialogue: 0,0:17:00.43,0:17:03.43,Default,,0,0,0,,Сіздің күшіңіз шайқаста артады.
Dialogue: 0,0:17:03.81,0:17:07.02,Default,,0,0,0,,Мен де сенімен осылай күресуді асыға күтемін.
Dialogue: 0,0:17:09.36,0:17:11.36,Default,,0,0,0,,Bay Club туралы не деуге болады?
Dialogue: 0,0:17:14.03,0:17:16.95,Default,,0,0,0,,Мен сәл кешігіп қаламын, бірақ... барамын.
Dialogue: 0,0:17:17.03,0:17:19.74,Default,,0,0,0,,Ах! Ал, мен күтемін.
Dialogue: 0,0:17:32.17,0:17:33.59,Default,,0,0,0,,Маған қатты әсер етті.
Dialogue: 0,0:17:33.67,0:17:35.55,Default,,0,0,0,,Жартылай финалдық шайқас
Dialogue: 0,0:17:36.05,0:17:37.38,Default,,0,0,0,,Мидорикава…
Dialogue: 0,0:17:37.93,0:17:41.06,Default,,0,0,0,,Мен Балтомен бірге күресіп жатқандай болдым.
Dialogue: 0,0:17:41.14,0:17:42.43,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:17:42.93,0:17:43.85,Default,,0,0,0,,Әй
Dialogue: 0,0:17:44.06,0:17:46.94,Default,,0,0,0,,Ал екеуің уәделеріңді орындадыңдар, солай ма?
Dialogue: 0,0:17:47.27,0:17:50.27,Default,,0,0,0,,Дос болғаным жақсы болар деп ойладым.
Dialogue: 0,0:17:51.15,0:17:52.36,Default,,0,0,0,,That's right.
Dialogue: 0,0:17:56.57,0:17:59.07,Default,,0,0,0,,Ол жақсы жігіт, Балто.
Dialogue: 0,0:17:59.66,0:18:00.32,Default,,0,0,0,,Ах
Dialogue: 0,0:18:00.91,0:18:04.12,Default,,0,0,0,,Мен мектепті қайта-қайта ауыстыра беремін.
Dialogue: 0,0:18:04.33,0:18:06.62,Default,,0,0,0,,Маған достасуда қиналады.
Dialogue: 0,0:18:06.71,0:18:10.04,Default,,0,0,0,,Мен де маған ондай ештеңе керек емес деп ойладым.
Dialogue: 0,0:18:10.25,0:18:12.42,Default,,0,0,0,,Бірақ Бартқа бәрібір.
Dialogue: 0,0:18:12.50,0:18:15.46,Default,,0,0,0,,Ішіме қатты кіріп жатыр.
Dialogue: 0,0:18:16.09,0:18:18.26,Default,,0,0,0,,Бұл Балто, солай емес пе?
Dialogue: 0,0:18:18.80,0:18:21.26,Default,,0,0,0,,Менің ең жақын досым
Dialogue: 0,0:18:21.93,0:18:24.10,Default,,0,0,0,,Шу Балтоның ең жақын досы, солай ма?
Dialogue: 0,0:18:24.85,0:18:27.23,Default,,0,0,0,,Ең жақсы достар бір-біріне уәде береді
Dialogue: 0,0:18:27.48,0:18:28.94,Default,,0,0,0,,Өте жақсы!
Dialogue: 0,0:18:29.02,0:18:30.06,Default,,0,0,0,,Мен қатты әсер алдым!
Dialogue: 0,0:18:30.81,0:18:31.94,Default,,0,0,0,,Мидорикава…
Dialogue: 0,0:18:32.73,0:18:33.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:34.53,0:18:36.86,Default,,0,0,0,,Ал, мен сені Бей клубында күтемін.
Dialogue: 0,0:18:36.94,0:18:38.74,Default,,0,0,0,,Хехе...
Dialogue: 0,0:18:42.16,0:18:44.49,Default,,0,0,0,,Жақсы шайқас болуы керек
Dialogue: 0,0:18:46.87,0:18:49.79,Default,,0,0,0,,Кел, же, же, нан ұтып ал
Dialogue: 0,0:18:49.87,0:18:52.17,Default,,0,0,0,,Мен оның үстінде трофей бар деп ойладым.
Dialogue: 0,0:18:52.25,0:18:54.25,Default,,0,0,0,,Иә, бәрі осылай деді.
Dialogue: 0,0:18:54.63,0:18:56.05,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:18:56.13,0:18:57.67,Default,,0,0,0,,кешіктірілді
Dialogue: 0,0:18:57.88,0:19:00.63,Default,,0,0,0,,Шу Сіз бірге емес пе едіңіз?
Dialogue: 0,0:19:00.72,0:19:01.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:01.59,0:19:03.30,Default,,0,0,0,,Біз бірге емеспіз~
Dialogue: 0,0:19:03.64,0:19:06.47,Default,,0,0,0,,Біртүрлі~ Ол әлі келген жоқ~
Dialogue: 0,0:19:06.77,0:19:08.35,Default,,0,0,0,,Мен жақында боламын
Dialogue: 0,0:19:08.43,0:19:11.06,Default,,0,0,0,,Ол финалға өткеніне қуанышты көрінді.
Dialogue: 0,0:19:11.31,0:19:12.56,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:19:13.27,0:19:14.65,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:19:22.74,0:19:24.49,Default,,0,0,0,,Ол келмейді, Шу-кун.
Dialogue: 0,0:19:25.03,0:19:26.24,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:30.83,0:19:32.17,Default,,0,0,0,,Жер
Dialogue: 0,0:19:32.37,0:19:35.25,Default,,0,0,0,,Мен финалға арнайы дайындық үстіндемін.
Dialogue: 0,0:19:35.67,0:19:36.96,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:19:37.05,0:19:38.71,Default,,0,0,0,,Бұл Шуға көбірек ұқсайды ма?
Dialogue: 0,0:19:44.05,0:19:46.14,Default,,0,0,0,,Мен сенімен кездесемін.
Dialogue: 0,0:20:00.86,0:20:02.70,Default,,0,0,0,,Ауырсыну кетпейді.
Dialogue: 0,0:20:02.78,0:20:03.95,Default,,0,0,0,,Шу
Dialogue: 0,0:20:04.03,0:20:06.24,Default,,0,0,0,,Сайысқа не үшін қатыстыңыз?
Dialogue: 0,0:20:06.33,0:20:10.50,Default,,0,0,0,,Кешіріңіз, мен шығуым керек еді.
Dialogue: 0,0:20:10.58,0:20:11.29,Default,,0,0,0,,Шу
Dialogue: 0,0:20:11.37,0:20:13.92,Default,,0,0,0,,Менің қызуым көтерілді.
Dialogue: 0,0:20:14.08,0:20:16.17,Default,,0,0,0,,Осылай болғанша өзімді итеріп жібергеніме сене алар емеспін...
Dialogue: 0,0:20:16.79,0:20:19.96,Default,,0,0,0,,Егер жағдай осылай жалғаса берсе, оның жазылуына көп уақыт қажет болады.
Dialogue: 0,0:20:20.05,0:20:22.67,Default,,0,0,0,,Бейблейдтерге иығыңыз үшін тыйым салынған.
Dialogue: 0,0:20:23.43,0:20:25.76,Default,,0,0,0,,Мен тек финалда ойнағым келеді.
Dialogue: 0,0:20:26.09,0:20:28.26,Default,,0,0,0,,Бұл доспен уәде.
Dialogue: 0,0:20:28.35,0:20:29.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:29.10,0:20:31.31,Default,,0,0,0,,Бейблейд ойнай алмасаңыз ше?
Dialogue: 0,0:20:31.39,0:20:36.44,Default,,0,0,0,,Сол досым да мұңая ма деп ойлаймын. Бүгінгі шайқас жағдайды қайта ушықтырды.
Dialogue: 0,0:20:36.56,0:20:37.69,Default,,0,0,0,,Міне!
Dialogue: 0,0:20:38.15,0:20:38.77,Default,,0,0,0,,Шу!
Dialogue: 0,0:20:40.65,0:20:41.74,Default,,0,0,0,,Барт…
Dialogue: 0,0:20:43.45,0:20:44.99,Default,,0,0,0,,(ысқыру дыбысы)
Dialogue: 0,0:20:57.67,0:20:59.29,Default,,0,0,0,,Әй, аға!
Dialogue: 0,0:20:59.38,0:21:00.21,Default,,0,0,0,,Бал-нии!
Dialogue: 0,0:21:00.84,0:21:02.71,Default,,0,0,0,,Шу да солай емес пе?
Dialogue: 0,0:21:06.26,0:21:07.72,Default,,0,0,0,,Не болды? Балтық
Dialogue: 0,0:21:14.18,0:21:15.39,Default,,0,0,0,,Барт…
Dialogue: 0,0:21:15.52,0:21:16.27,Default,,0,0,0,,Эй
Dialogue: 0,0:21:21.48,0:21:23.65,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:21:23.99,0:21:26.36,Default,,0,0,0,,Барлығымыз, шайқасайық!
Dialogue: 0,0:21:26.45,0:21:27.49,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:27.57,0:21:28.99,Default,,0,0,0,,Не, кенеттен?
Dialogue: 0,0:21:29.07,0:21:30.78,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:31.03,0:21:33.45,Default,,0,0,0,,Мен... қазір...
Dialogue: 0,0:21:33.54,0:21:35.91,Default,,0,0,0,,Уау, біз шайқастық!
Dialogue: 0,0:21:36.79,0:21:38.08,Default,,0,0,0,,Барт…
Dialogue: 0,0:21:38.79,0:21:40.38,Default,,0,0,0,,Жарайды, жасайық.
Dialogue: 0,0:21:40.46,0:21:41.25,Default,,0,0,0,,О
Dialogue: 0,0:21:41.50,0:21:43.09,Default,,0,0,0,,Мен де істеймін
Dialogue: 0,0:21:43.30,0:21:45.92,Default,,0,0,0,,Жартылай финалдар өртеніп кетті.
Dialogue: 0,0:21:47.22,0:21:49.39,Default,,0,0,0,,Жарайды! Барайық!
Dialogue: 0,0:21:50.80,0:21:53.10,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:21:53.18,0:21:55.27,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Сіз енді ешқашан жоғалмайсыз
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Артынан қусаң да көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.44,0:23:28.99,Default,,0,0,0,,Мен финалда Шумен шайқасамын.
Dialogue: 0,0:23:29.07,0:23:32.16,Default,,0,0,0,,Артық қылса, Шудың ендігі бейі болмас.
Dialogue: 0,0:23:32.28,0:23:33.12,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:23:33.20,0:23:35.24,Default,,0,0,0,,Бұл жақсы емес, оны тоқтату керек.
Dialogue: 0,0:23:35.33,0:23:37.62,Default,,0,0,0,,Бірақ мен Шуумен төбелескім келеді
Dialogue: 0,0:23:37.70,0:23:39.70,Default,,0,0,0,,Біз осы уақытқа дейін жеттік.
Dialogue: 0,0:23:39.79,0:23:42.21,Default,,0,0,0,,Мен не істеуім керек!?
Dialogue: 0,0:23:42.46,0:23:44.21,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:44.42,0:23:45.67,Default,,0,0,0,,Ант шайқасы
Dialogue: 0,0:23:45.75,0:23:47.71,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.88,0:23:49.46,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.96,0:23:56.96,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory