Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.67,0:00:09.21,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.30,0:00:12.47,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.76,0:00:14.76,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:16.97,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.05,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.52,0:00:24.23,Default,,0,0,0,,Beblade Burst дегеніміз не?
Dialogue: 0,0:00:24.31,0:00:26.27,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.35,0:00:28.86,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:33.03,0:00:34.20,Default,,0,0,0,,А?
Dialogue: 0,0:00:34.28,0:00:35.49,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:00:39.95,0:00:40.74,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:41.54,0:00:42.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:46.79,0:00:47.63,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:00:48.88,0:00:50.25,Default,,0,0,0,,Бегемот!
Dialogue: 0,0:00:50.34,0:00:52.38,Default,,0,0,0,,Уууу!
Dialogue: 0,0:00:55.01,0:00:57.72,Default,,0,0,0,,Мен Азуки Бенмен болған кескілескен шайқаста жеңдім!
Dialogue: 0,0:00:57.80,0:01:00.31,Default,,0,0,0,,Біз командалық жарыстың финалына шықтық!
Dialogue: 0,0:01:00.39,0:01:02.81,Default,,0,0,0,,Міне, Киракира-кун.
Dialogue: 0,0:01:02.89,0:01:05.39,Default,,0,0,0,,Йонекома Гакуэн Бей клубы...
Dialogue: 0,0:01:06.56,0:01:08.35,Default,,0,0,0,,Ал жартылай финал
Dialogue: 0,0:01:08.61,0:01:11.65,Default,,0,0,0,,Джинблейд Орочи мен Го Чакаке арасындағы шайқас басталды.
Dialogue: 0,0:01:20.78,0:01:23.16,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:23.50,0:01:28.67,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:39.97,0:01:43.35,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:43.85,0:01:45.98,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:46.39,0:01:50.52,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:50.65,0:01:53.86,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:01:53.98,0:02:00.41,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:00.70,0:02:05.12,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:05.62,0:02:11.04,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:11.17,0:02:13.42,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:13.50,0:02:18.22,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:18.38,0:02:23.47,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:23.76,0:02:26.02,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:26.22,0:02:28.56,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:28.85,0:02:32.77,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:32.94,0:02:37.94,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:38.15,0:02:40.32,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:44.41,0:02:46.20,Default,,0,0,0,,Ұшу қаупі!
Dialogue: 0,0:02:48.08,0:02:50.08,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:02:51.75,0:02:55.25,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:02:55.34,0:02:57.38,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:02:58.67,0:03:00.51,Default,,0,0,0,,Үшінші шайқас басталды!
Dialogue: 0,0:03:00.59,0:03:02.76,Default,,0,0,0,,Екеуі де орталыққа ұмтылады!
Dialogue: 0,0:03:02.84,0:03:04.85,Default,,0,0,0,,Маған енді кіріспе керек емес.
Dialogue: 0,0:03:04.93,0:03:06.51,Default,,0,0,0,,Blast Beat!
Dialogue: 0,0:03:06.60,0:03:09.14,Default,,0,0,0,,Odin Blast Beat көмегімен жылдам шабуыл жасаңыз!
Dialogue: 0,0:03:09.23,0:03:11.60,Default,,0,0,0,,Гайя қорғанысын күшейтуді жоспарлап отыр ма?
Dialogue: 0,0:03:12.10,0:03:14.19,Default,,0,0,0,,Әткеншекпен ату!
Dialogue: 0,0:03:14.27,0:03:15.90,Default,,0,0,0,,Один мен Гая -
Dialogue: 0,0:03:15.98,0:03:18.57,Default,,0,0,0,,Бірінші байланыс!
Dialogue: 0,0:03:22.16,0:03:24.62,Default,,0,0,0,,Гигант Гайя жеңілмейді!
Dialogue: 0,0:03:26.58,0:03:28.20,Default,,0,0,0,,Одиннің жарылыс соққысы
Dialogue: 0,0:03:28.29,0:03:30.79,Default,,0,0,0,,Гайяның соққысы қайтарылуда!
Dialogue: 0,0:03:31.04,0:03:33.33,Default,,0,0,0,,Ой, бұл Гайя шығанақ
Dialogue: 0,0:03:33.42,0:03:35.08,Default,,0,0,0,,Қандай қозғалыс!
Dialogue: 0,0:03:35.17,0:03:36.75,Default,,0,0,0,,Гаяның ширек дискісі
Dialogue: 0,0:03:36.84,0:03:38.76,Default,,0,0,0,,Ауырлық центрі ығысқан
Dialogue: 0,0:03:38.84,0:03:41.30,Default,,0,0,0,,Бұл айналмалы бұлыңғырлықты тудырады
Dialogue: 0,0:03:41.38,0:03:44.93,Default,,0,0,0,,Бұл бұлыңғырлық қарсыластың шабуылын жояды.
Dialogue: 0,0:03:45.01,0:03:47.56,Default,,0,0,0,,Күрделі техника соншалықты оңай орындалды...
Dialogue: 0,0:03:47.64,0:03:50.06,Default,,0,0,0,,Rideout капитанынан күткендей!
Dialogue: 0,0:03:53.44,0:03:55.23,Default,,0,0,0,,Соққыны қабаттаңыз, Один!
Dialogue: 0,0:03:55.31,0:03:57.23,Default,,0,0,0,,Forte! Forte!
Dialogue: 0,0:03:57.32,0:03:59.23,Default,,0,0,0,,Fortissimo!
Dialogue: 0,0:03:59.32,0:04:02.53,Default,,0,0,0,,Ауыр салмақты үштік диск күшті соққы жасайды!
Dialogue: 0,0:04:02.61,0:04:05.49,Default,,0,0,0,,Жарылыс қатты естіледі!
Dialogue: 0,0:04:05.66,0:04:07.24,Default,,0,0,0,,Керемет дыбыс
Dialogue: 0,0:04:10.16,0:04:11.29,Default,,0,0,0,,Жақсы
Dialogue: 0,0:04:11.83,0:04:14.04,Default,,0,0,0,,Осыны финалға шығарайық!
Dialogue: 0,0:04:16.38,0:04:18.42,Default,,0,0,0,,Қорытынды қозғалыс…
Dialogue: 0,0:04:18.50,0:04:19.59,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:04:24.13,0:04:25.09,Default,,0,0,0,,Гая…
Dialogue: 0,0:04:25.26,0:04:28.14,Default,,0,0,0,,Мен сенің ұлылығыңды жақсы білемін...
Dialogue: 0,0:04:28.72,0:04:30.14,Default,,0,0,0,,Бірге төккен тер...
Dialogue: 0,0:04:30.77,0:04:32.18,Default,,0,0,0,,Ешкімге жеңілме!
Dialogue: 0,0:04:32.27,0:04:33.69,Default,,0,0,0,,Жүр!
Dialogue: 0,0:04:34.85,0:04:36.98,Default,,0,0,0,,Айналмалы есептегіш!
Dialogue: 0,0:04:37.06,0:04:39.65,Default,,0,0,0,,Уау! Қозғалыс қандай өзгерді! ?
Dialogue: 0,0:04:39.73,0:04:40.40,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:04:40.48,0:04:42.94,Default,,0,0,0,,Бұл тербелгіш есептегіш!
Dialogue: 0,0:04:43.03,0:04:44.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:44.49,0:04:46.70,Default,,0,0,0,,Шеш, Гайя!
Dialogue: 0,0:04:46.78,0:04:48.53,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:04:50.83,0:04:52.25,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:04:52.33,0:04:53.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:53.71,0:04:55.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:55.71,0:04:58.29,Default,,0,0,0,,Гигант Гаяның жарылуы аяқталды!
Dialogue: 0,0:04:58.38,0:04:59.13,Default,,0,0,0,,Әй
Dialogue: 0,0:04:59.71,0:05:02.21,Default,,0,0,0,,Rideout 3-2 есебімен жеңеді
Dialogue: 0,0:05:02.30,0:05:04.30,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:06.05,0:05:07.72,Default,,0,0,0,,(Изуку) Токоями! (Қара көлеңке) Ой!
Dialogue: 0,0:05:07.80,0:05:09.47,Default,,0,0,0,,Мен бұған мәжбүр болсам да...
Dialogue: 0,0:05:09.55,0:05:12.22,Default,,0,0,0,,Бір соққы кестені өзгертті...
Dialogue: 0,0:05:12.31,0:05:15.56,Default,,0,0,0,,Айналу күші мен жылдамдығы қосылып ауырлық центрін шайқайды.
Dialogue: 0,0:05:15.64,0:05:17.40,Default,,0,0,0,,Қуатты есептегіш
Dialogue: 0,0:05:17.48,0:05:19.40,Default,,0,0,0,,Бұл Гигант Гайаның ерекше қозғалысы.
Dialogue: 0,0:05:19.48,0:05:21.40,Default,,0,0,0,,Бұл тербелгіш есептегіш!
Dialogue: 0,0:05:22.11,0:05:23.99,Default,,0,0,0,,Айналмалы есептегіш…
Dialogue: 0,0:05:24.07,0:05:25.99,Default,,0,0,0,,Бұл техниканы қарғыс атсын
Dialogue: 0,0:05:26.53,0:05:28.70,Default,,0,0,0,,Финалға шығуды кім шешті
Dialogue: 0,0:05:28.78,0:05:30.83,Default,,0,0,0,,Го Чакаке басқарған-
Dialogue: 0,0:05:30.91,0:05:32.87,Default,,0,0,0,,Жүріңіз!
Dialogue: 0,0:05:32.95,0:05:34.83,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:05:40.21,0:05:42.17,Default,,0,0,0,,Менің Одинім...
Dialogue: 0,0:05:42.63,0:05:43.96,Default,,0,0,0,,Один...
Dialogue: 0,0:05:45.47,0:05:46.42,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:47.09,0:05:48.38,Default,,0,0,0,,Сіз жеңілдіңіз бе...
Dialogue: 0,0:05:49.26,0:05:50.51,Default,,0,0,0,,Біз...
Dialogue: 0,0:05:53.22,0:05:55.68,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:59.27,0:06:00.94,Default,,0,0,0,,Бұл менің қателігім болды...
Dialogue: 0,0:06:01.02,0:06:03.44,Default,,0,0,0,,Егер мен Го Чакакемен кездессем...
Dialogue: 0,0:06:07.32,0:06:08.32,Default,,0,0,0,,Зак…
Dialogue: 0,0:06:08.40,0:06:10.70,Default,,0,0,0,,Зак, көңіл көтер!
Dialogue: 0,0:06:10.78,0:06:12.24,Default,,0,0,0,,Зак!
Dialogue: 0,0:06:12.53,0:06:14.29,Default,,0,0,0,,Жылама!
Dialogue: 0,0:06:14.37,0:06:16.29,Default,,0,0,0,,Зак!
Dialogue: 0,0:06:16.37,0:06:19.71,Default,,0,0,0,,(Закқа сәлем)
Dialogue: 0,0:06:36.72,0:06:38.73,Default,,0,0,0,,(Қыздар қолдайды)
Dialogue: 0,0:06:39.89,0:06:43.15,Default,,0,0,0,,Бейблейд маскасы ешқашан құламайды!
Dialogue: 0,0:06:43.23,0:06:45.23,Default,,0,0,0,,Бейблейд бар болғанша...
Dialogue: 0,0:06:45.32,0:06:46.94,Default,,0,0,0,,Қайта-қайта тіріл!
Dialogue: 0,0:06:48.57,0:06:49.99,Default,,0,0,0,,Сынбайтын Бо
Dialogue: 0,0:06:50.32,0:06:52.82,Default,,0,0,0,,Бетперде киген Бейблейд!
Dialogue: 0,0:06:52.91,0:06:56.70,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:57.04,0:06:58.96,Default,,0,0,0,,Бейблейд маскасы~!
Dialogue: 0,0:07:02.33,0:07:04.84,Default,,0,0,0,,Кеудемдегі бұл ауыртпалықты ешқашан ұмытпаймын
Dialogue: 0,0:07:05.75,0:07:09.22,Default,,0,0,0,,Мен супержұлдыздардың өкінішін міндетті түрде толтырамын!
Dialogue: 0,0:07:09.97,0:07:12.30,Default,,0,0,0,,Циллион Зевстің атымен!
Dialogue: 0,0:07:13.05,0:07:14.72,Default,,0,0,0,,Қайта кездескенше!
Dialogue: 0,0:07:15.26,0:07:16.06,Default,,0,0,0,,Ciao!
Dialogue: 0,0:07:20.85,0:07:23.27,Default,,0,0,0,,Бұл не болды? Енді не болды...
Dialogue: 0,0:07:23.35,0:07:26.02,Default,,0,0,0,,Бейблейд маскасы өте керемет!
Dialogue: 0,0:07:26.57,0:07:28.61,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:07:29.24,0:07:31.65,Default,,0,0,0,,Жеңіліп қалсаңыз, байқалады...
Dialogue: 0,0:07:31.74,0:07:32.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:33.20,0:07:34.91,Default,,0,0,0,,Гигант Гая…
Dialogue: 0,0:07:35.07,0:07:37.58,Default,,0,0,0,,Тіпті Зактың Зевсі де міндетті түрде жеңе алмайды...
Dialogue: 0,0:07:37.91,0:07:40.58,Default,,0,0,0,,Айналмалы есептегіш Оны қалай бұзуға болады...
Dialogue: 0,0:07:41.87,0:07:45.38,Default,,0,0,0,,WBBA ұлттық турнирінің командалық жарысы
Dialogue: 0,0:07:45.46,0:07:49.05,Default,,0,0,0,,Финалға өткен командалармен таныстыру!
Dialogue: 0,0:07:49.13,0:07:52.93,Default,,0,0,0,,Біріншілікке үміткер командаларды бірінен соң бірін жеңіп, жеңіске жеттік.
Dialogue: 0,0:07:53.89,0:07:56.68,Default,,0,0,0,,Йонекома Гакуэн шығанағы клубы!
Dialogue: 0,0:07:56.76,0:07:59.47,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:59.81,0:08:03.64,Default,,0,0,0,,Мен әзірге тек 2 ұпай жоғалттым!
Dialogue: 0,0:08:03.73,0:08:05.65,Default,,0,0,0,,Жеңіске апаратын патша жолы
Dialogue: 0,0:08:05.73,0:08:07.52,Default,,0,0,0,,Жүр!
Dialogue: 0,0:08:07.61,0:08:09.69,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:09.98,0:08:12.11,Default,,0,0,0,,Мен бүгін ұпай алдым, бірақ...
Dialogue: 0,0:08:12.40,0:08:14.91,Default,,0,0,0,,Мен финалда тамаша ойынмен жеңемін.
Dialogue: 0,0:08:15.78,0:08:18.49,Default,,0,0,0,,Ақымақ болма! Дұрыс, кеттік!
Dialogue: 0,0:08:18.58,0:08:20.33,Default,,0,0,0,,Менің жылағанымды көрген сенсің!
Dialogue: 0,0:08:20.41,0:08:21.87,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:08:21.95,0:08:24.79,Default,,0,0,0,,Мен бұл командамен жеңіске жеткім келеді
Dialogue: 0,0:08:24.87,0:08:26.50,Default,,0,0,0,,Барлығы бірдей сезінеді
Dialogue: 0,0:08:28.04,0:08:30.55,Default,,0,0,0,,Құдіретімізді көрсетейік!
Dialogue: 0,0:08:30.63,0:08:31.96,Default,,0,0,0,,Бұл жан-жақты шайқас!
Dialogue: 0,0:08:32.05,0:08:33.22,Default,,0,0,0,,О!
Dialogue: 0,0:08:39.76,0:08:41.72,Default,,0,0,0,,Йонекома Гакуэн Бей клубы -
Dialogue: 0,0:08:41.81,0:08:43.77,Default,,0,0,0,,Сіз финалда боласыз, солай ма?
Dialogue: 0,0:08:43.85,0:08:46.56,Default,,0,0,0,,Мен бұл туралы хабар тарату бөлімінде айтқым келеді.
Dialogue: 0,0:08:46.85,0:08:49.07,Default,,0,0,0,,Тақырып «Финалға апарар жол»
Dialogue: 0,0:08:49.32,0:08:50.53,Default,,0,0,0,,Сіз оны қабылдайсыз!
Dialogue: 0,0:08:50.94,0:08:53.49,Default,,0,0,0,,Тәжірибенің қарқынды кезеңінде қолайсыздық
Dialogue: 0,0:08:53.69,0:08:55.28,Default,,0,0,0,,Бұл туралы бірдеңе жасаңыз!
Dialogue: 0,0:08:55.45,0:08:56.95,Default,,0,0,0,,Сәлем, өтінемін!
Dialogue: 0,0:08:57.03,0:08:58.20,Default,,0,0,0,,Не істеуіміз керек, Балто?
Dialogue: 0,0:08:58.28,0:08:59.49,Default,,0,0,0,,Иә? Мен?
Dialogue: 0,0:08:59.58,0:09:01.33,Default,,0,0,0,,Сіз капитансыз, солай ма?
Dialogue: 0,0:09:01.41,0:09:02.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:02.91,0:09:04.83,Default,,0,0,0,,Мен алдымен жаттығу жасаймын.
Dialogue: 0,0:09:05.79,0:09:07.42,Default,,0,0,0,,Шешім қабылдаған кезде маған хабарлаңыз.
Dialogue: 0,0:09:07.54,0:09:08.46,Default,,0,0,0,,Оны маған қалдырыңыз
Dialogue: 0,0:09:08.67,0:09:10.63,Default,,0,0,0,,Мен де бірінші барайын.
Dialogue: 0,0:09:10.71,0:09:11.80,Default,,0,0,0,,Е...
Dialogue: 0,0:09:11.88,0:09:14.30,Default,,0,0,0,,Міндетті түрде керемет видео түсіремін!
Dialogue: 0,0:09:14.38,0:09:16.34,Default,,0,0,0,,Капитан, өтінемін!
Dialogue: 0,0:09:18.93,0:09:20.35,Default,,0,0,0,,(Жазуды бастау дыбысы)
Dialogue: 0,0:09:20.51,0:09:22.52,Default,,0,0,0,,Мм...
Dialogue: 0,0:09:22.60,0:09:27.14,Default,,0,0,0,,Ой, финалға қатысуымыздың себебі...
Dialogue: 0,0:09:27.23,0:09:28.44,Default,,0,0,0,,Хе-хе. Баспалдақтан төмен түсіп кеткенсің ғой?
Dialogue: 0,0:09:28.52,0:09:32.48,Default,,0,0,0,,Мен әр адамның күші менің ішімде тұрғандай сезінемін...
Dialogue: 0,0:09:32.57,0:09:36.11,Default,,0,0,0,,Мен жынды болдым. Мен жынды болдым...
Dialogue: 0,0:09:36.20,0:09:39.70,Default,,0,0,0,,Уф... (Момоко) Тоқта, тоқта!
Dialogue: 0,0:09:39.78,0:09:41.95,Default,,0,0,0,,Нақтырақ сөйлеңіз!
Dialogue: 0,0:09:42.03,0:09:45.66,Default,,0,0,0,,Балто Мен тым қобалжыдым! Бэй ойнаған кездегідей
Dialogue: 0,0:09:45.75,0:09:47.67,Default,,0,0,0,,Жай демалып, сөйлесіңіз.
Dialogue: 0,0:09:47.96,0:09:50.21,Default,,0,0,0,,Бал-нии! Күлімсіреп күліңіз!
Dialogue: 0,0:09:50.29,0:09:52.34,Default,,0,0,0,,Демалыңыз Демалыңыз!
Dialogue: 0,0:09:52.42,0:09:55.38,Default,,0,0,0,,Бей ойнағандай босаңсу...
Dialogue: 0,0:09:55.46,0:09:58.30,Default,,0,0,0,,Келесі - Кумичо! Дайын бол!
Dialogue: 0,0:09:58.47,0:09:59.59,Default,,0,0,0,,Мұқаба!
Dialogue: 0,0:09:59.68,0:10:01.35,Default,,0,0,0,,Сіз қобалжыдыңыз ба?
Dialogue: 0,0:10:01.43,0:10:02.85,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:02.93,0:10:04.93,Default,,0,0,0,,Кумичо! өтінемін!
Dialogue: 0,0:10:05.02,0:10:05.89,Default,,0,0,0,,О!
Dialogue: 0,0:10:07.94,0:10:09.52,Default,,0,0,0,,Ал... а...
Dialogue: 0,0:10:09.60,0:10:11.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:11.40,0:10:13.32,Default,,0,0,0,,(ащы күлімсіреу)
Dialogue: 0,0:10:13.82,0:10:18.07,Default,,0,0,0,,Тч... Аудандық турнирде Балттан жеңіліп қалдым.
Dialogue: 0,0:10:18.15,0:10:19.36,Default,,0,0,0,,Иә, хяфукка...
Dialogue: 0,0:10:19.45,0:10:22.12,Default,,0,0,0,,Тілімді тістеу
Dialogue: 0,0:10:22.20,0:10:23.37,Default,,0,0,0,,(Жазуды бастау дыбысы)
Dialogue: 0,0:10:23.45,0:10:24.95,Default,,0,0,0,,Тіпті қайталау матчында
Dialogue: 0,0:10:25.04,0:10:27.41,Default,,0,0,0,,Сіз Балт-кун, Кумичодан жеңілдіңіз.
Dialogue: 0,0:10:27.50,0:10:29.54,Default,,0,0,0,,Бұған баса назар аудармаңыз!
Dialogue: 0,0:10:29.62,0:10:32.21,Default,,0,0,0,,Балто – тағдырлы нантока.
Dialogue: 0,0:10:32.29,0:10:33.79,Default,,0,0,0,,Тағдырлы қарсылас?
Dialogue: 0,0:10:33.88,0:10:35.25,Default,,0,0,0,,Иә! Міне бітті!
Dialogue: 0,0:10:35.34,0:10:38.17,Default,,0,0,0,,Олар бәсекелестерден гөрі манзай дуэті.
Dialogue: 0,0:10:38.26,0:10:40.01,Default,,0,0,0,,Не! (Какитани) Жарайды!
Dialogue: 0,0:10:40.09,0:10:42.64,Default,,0,0,0,,Жақсы емес Какитани, қоңырау шалушы!
Dialogue: 0,0:10:42.72,0:10:44.68,Default,,0,0,0,,Сіз жеңген матч туралы әлі айтқан жоқсыз...
Dialogue: 0,0:10:44.76,0:10:47.06,Default,,0,0,0,,Ал, бәріміз, әрі қарай жүрейік!
Dialogue: 0,0:10:47.14,0:10:48.35,Default,,0,0,0,,wbba-
Dialogue: 0,0:10:48.43,0:10:51.52,Default,,0,0,0,,Ұлттық оқу орталығына көшуіңізді сұраймыз.
Dialogue: 0,0:10:51.60,0:10:52.81,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:10:52.90,0:10:54.73,Default,,0,0,0,,Шуукун туралы тамаша мәліметтер
Dialogue: 0,0:10:54.82,0:10:56.11,Default,,0,0,0,,Көп суретке түсейік!
Dialogue: 0,0:10:56.19,0:10:59.65,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:11:01.28,0:11:03.70,Default,,0,0,0,,Йонекома Гакуэн Бей клубының мүшелері...
Dialogue: 0,0:11:03.91,0:11:06.83,Default,,0,0,0,,Командалық жарыстың финалы алдындағы арнайы дайындық
Dialogue: 0,0:11:06.91,0:11:09.50,Default,,0,0,0,,Бейблейдерлерді дайындау орталығы бар.
Dialogue: 0,0:11:09.58,0:11:11.29,Default,,0,0,0,,Біз Bay Arena-ға келдік!
Dialogue: 0,0:11:11.37,0:11:13.38,Default,,0,0,0,,Бұл өте үлкен!
Dialogue: 0,0:11:13.46,0:11:15.80,Default,,0,0,0,,Мен толқуды бастадым.
Dialogue: 0,0:11:15.88,0:11:17.67,Default,,0,0,0,,Мұнда бізде соңғы...
Dialogue: 0,0:11:17.76,0:11:19.92,Default,,0,0,0,,Оқу жабдықтары және т.б. бар
Dialogue: 0,0:11:20.51,0:11:24.01,Default,,0,0,0,,Бұл құралды таңдаулы үздік спортшылар ғана пайдалана алады.
Dialogue: 0,0:11:24.10,0:11:26.97,Default,,0,0,0,,Уайдың үйінде оқу орны да бар.
Dialogue: 0,0:11:27.31,0:11:29.18,Default,,0,0,0,,Мұндағы масштаб басқаша.
Dialogue: 0,0:11:29.27,0:11:31.10,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:11:31.35,0:11:32.44,Default,,0,0,0,,Жарайды~
Dialogue: 0,0:11:32.52,0:11:34.73,Default,,0,0,0,,Тез оқу орталығына барайық!
Dialogue: 0,0:11:34.81,0:11:35.36,Default,,0,0,0,,Иә
Dialogue: 0,0:11:35.73,0:11:36.77,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:11:36.86,0:11:38.73,Default,,0,0,0,,Келесі жолы ішін суретке түсіреміз!
Dialogue: 0,0:11:40.24,0:11:42.53,Default,,0,0,0,,А, мініп кет...
Dialogue: 0,0:11:42.61,0:11:43.20,Default,,0,0,0,,Не!
Dialogue: 0,0:11:43.45,0:11:45.16,Default,,0,0,0,,Олар да сонда болды ма?
Dialogue: 0,0:11:45.24,0:11:47.95,Default,,0,0,0,,Олар мұнда жиі жаттығады.
Dialogue: 0,0:11:48.16,0:11:49.37,Default,,0,0,0,,Не!
Dialogue: 0,0:11:49.45,0:11:52.33,Default,,0,0,0,,Руи Ширасаги да осында жаттығады!
Dialogue: 0,0:11:53.46,0:11:54.46,Default,,0,0,0,,Луи...
Dialogue: 0,0:11:55.75,0:11:58.55,Default,,0,0,0,,Rideout арнайы дайындықта...
Dialogue: 0,0:11:58.63,0:12:00.84,Default,,0,0,0,,Олар жай ғана кішігірім адамдар.
Dialogue: 0,0:12:00.92,0:12:03.97,Default,,0,0,0,,Әй, Балт-күн, рұқсатсыз кетпе!
Dialogue: 0,0:12:07.05,0:12:11.23,Default,,0,0,0,,Бұл денеңізді жаттықтыруға болатын жаттығу бөлмесі.
Dialogue: 0,0:12:11.31,0:12:13.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:13.23,0:12:15.10,Default,,0,0,0,,...Ол не үшін қажет?
Dialogue: 0,0:12:15.19,0:12:17.23,Default,,0,0,0,,Менің ойымша, сіз мұнда барлау үшін келдіңіз.
Dialogue: 0,0:12:17.31,0:12:18.44,Default,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:12:18.52,0:12:21.15,Default,,0,0,0,,Бұл жерде кездескеніміз жай ғана кездейсоқтық еді.
Dialogue: 0,0:12:21.24,0:12:23.20,Default,,0,0,0,,кездейсоқ
Dialogue: 0,0:12:23.28,0:12:24.61,Default,,0,0,0,,Бәрі жақсы...
Dialogue: 0,0:12:24.70,0:12:26.82,Default,,0,0,0,,Біздің тәжірибемізді бұзбаңыз.
Dialogue: 0,0:12:27.20,0:12:28.24,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:12:28.33,0:12:30.24,Default,,0,0,0,,Кедергінің қажеті жоқ!
Dialogue: 0,0:12:30.33,0:12:32.58,Default,,0,0,0,,Мен көп жаттығу жасамасам да
Dialogue: 0,0:12:32.87,0:12:35.96,Default,,0,0,0,,Балалар, біздің тәжірибемізді орындап жатырсыңдар ма?
Dialogue: 0,0:12:36.29,0:12:38.88,Default,,0,0,0,,Хмф, менің тіпті жазылғым да келмейді.
Dialogue: 0,0:12:39.17,0:12:40.34,Default,,0,0,0,,Не?!
Dialogue: 0,0:12:40.42,0:12:41.46,Default,,0,0,0,,Тоқта
Dialogue: 0,0:12:41.96,0:12:44.68,Default,,0,0,0,,Кио Матч үшін сол жауынгерлік рухты сақтаңыз.
Dialogue: 0,0:12:44.76,0:12:47.18,Default,,0,0,0,,...Го-сенпай
Dialogue: 0,0:12:47.26,0:12:48.43,Default,,0,0,0,,Комурасаки де
Dialogue: 0,0:12:48.51,0:12:49.51,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:12:49.60,0:12:52.73,Default,,0,0,0,,Мен осындай төменгі сынып оқушысына ашуландым. Мен ақымақпын.
Dialogue: 0,0:12:53.06,0:12:55.14,Default,,0,0,0,,Сіздің төменгі сыныптасыңыз емес!
Dialogue: 0,0:12:55.23,0:12:57.61,Default,,0,0,0,,Сонымен, мен мұны төменгі сыныптарда орындасам, дұрыс па?
Dialogue: 0,0:12:57.69,0:12:58.90,Default,,0,0,0,,Не...!
Dialogue: 0,0:12:58.98,0:13:01.32,Default,,0,0,0,,Не! Финалға дайындалып жатқан команда...
Dialogue: 0,0:13:01.40,0:13:03.44,Default,,0,0,0,,Біз кездейсоқ кездестік!
Dialogue: 0,0:13:03.53,0:13:06.11,Default,,0,0,0,,Екеуінде де жауынгерлік рухтың ұшқындары ұшады!
Dialogue: 0,0:13:06.20,0:13:08.16,Default,,0,0,0,,Саннай-кун Комурасаки-кун
Dialogue: 0,0:13:08.24,0:13:10.49,Default,,0,0,0,,Бір-біріңе көбірек қараңдар!
Dialogue: 0,0:13:10.58,0:13:13.16,Default,,0,0,0,,Камера емес! Бір-бірін, бір-бірін!
Dialogue: 0,0:13:13.33,0:13:15.87,Default,,0,0,0,,Аа... жақсы көрініс болды...
Dialogue: 0,0:13:16.46,0:13:18.88,Default,,0,0,0,,Кішкене жабысқақ болса екен...
Dialogue: 0,0:13:19.08,0:13:21.09,Default,,0,0,0,,Олай болса, Оги-чан, келесі!
Dialogue: 0,0:13:21.59,0:13:23.84,Default,,0,0,0,,А...? Ха! Иә
Dialogue: 0,0:13:24.51,0:13:25.72,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:13:25.80,0:13:27.34,Default,,0,0,0,,Чакаке шығанағына барыңыз.
Dialogue: 0,0:13:27.43,0:13:29.60,Default,,0,0,0,,Ол Гигант Гая деп аталады!
Dialogue: 0,0:13:29.68,0:13:31.14,Default,,0,0,0,,А... а...
Dialogue: 0,0:13:31.47,0:13:33.06,Default,,0,0,0,,Керемет, Оги-чан!
Dialogue: 0,0:13:33.27,0:13:36.31,Default,,0,0,0,,Бұл керемет, солай емес пе? Гигант Гая!
Dialogue: 0,0:13:36.39,0:13:38.52,Default,,0,0,0,,Өткен күнгі шайқас керемет болды!
Dialogue: 0,0:13:38.60,0:13:42.11,Default,,0,0,0,,Одинді күшті айналмалы есептегішпен жарыңыз!
Dialogue: 0,0:13:42.19,0:13:43.44,Default,,0,0,0,,Керемет жұмыс!
Dialogue: 0,0:13:43.53,0:13:44.78,Default,,0,0,0,,…ah
Dialogue: 0,0:13:44.86,0:13:48.32,Default,,0,0,0,,Сіздің сүйікті тағамыңыз қандай?
Dialogue: 0,0:13:48.41,0:13:49.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:49.66,0:13:52.33,Default,,0,0,0,,Сізге тәтті немесе ащы нәрсе керек пе?
Dialogue: 0,0:13:52.41,0:13:55.45,Default,,0,0,0,,О... жоқ! Оги-чан, басқа сұрақ!
Dialogue: 0,0:13:55.66,0:13:56.96,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:13:57.41,0:13:58.96,Default,,0,0,0,,Руи Ширасаги бұл...
Dialogue: 0,0:13:59.04,0:14:01.09,Default,,0,0,0,,Ол командалық шайқастарда пайда бола ма?
Dialogue: 0,0:14:01.17,0:14:03.17,Default,,0,0,0,,Жаттығуды бұзбау
Dialogue: 0,0:14:03.63,0:14:07.17,Default,,0,0,0,,Бірге жаттығу жасайық!
Dialogue: 0,0:14:07.26,0:14:08.26,Default,,0,0,0,,Не?
Dialogue: 0,0:14:08.34,0:14:11.47,Default,,0,0,0,,Уау! Мен мұны жасадым, өйткені бұл өте ауыр болды.
Dialogue: 0,0:14:11.55,0:14:12.60,Default,,0,0,0,,Nuo~
Dialogue: 0,0:14:14.68,0:14:15.56,Default,,0,0,0,,На
Dialogue: 0,0:14:15.64,0:14:18.06,Default,,0,0,0,,Уоооах!
Dialogue: 0,0:14:18.14,0:14:20.27,Default,,0,0,0,,Балт-кун Радауттың капитаны болды.
Dialogue: 0,0:14:20.35,0:14:22.31,Default,,0,0,0,,Салмақ жаттығуларымен өзіңізді сынаңыз!
Dialogue: 0,0:14:22.94,0:14:24.86,Default,,0,0,0,,Бұл ешкімнен кем емес!
Dialogue: 0,0:14:24.94,0:14:27.70,Default,,0,0,0,,Уша! Мен де жеңілмеймін!
Dialogue: 0,0:14:27.90,0:14:30.07,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,0:14:30.16,0:14:31.24,Default,,0,0,0,,Жарайды, мен де!
Dialogue: 0,0:14:31.32,0:14:32.45,Default,,0,0,0,,Мұны да жасаңыз!
Dialogue: 0,0:14:34.24,0:14:35.74,Default,,0,0,0,,Менің жеңілгім келмейді!
Dialogue: 0,0:14:36.33,0:14:38.08,Default,,0,0,0,,Бұл қандай жігіттер...
Dialogue: 0,0:14:38.16,0:14:39.75,Default,,0,0,0,,Бұл ақымақ.
Dialogue: 0,0:14:39.83,0:14:42.50,Default,,0,0,0,,Сені ақымақ деген адамдар ақымақ. (Рантаро) Сені ақымақ деп айтатындар ақымақ!
Dialogue: 0,0:14:42.63,0:14:44.09,Default,,0,0,0,,Көңілді!
Dialogue: 0,0:14:44.17,0:14:45.34,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:14:45.42,0:14:48.09,Default,,0,0,0,,Жоғалтпа, Йонекома Гакуэн Бей клубы!
Dialogue: 0,0:14:48.17,0:14:50.51,Default,,0,0,0,,Бұл жаттығу бөлмесінен.
Dialogue: 0,0:14:50.59,0:14:53.47,Default,,0,0,0,,Қызық!
Dialogue: 0,0:14:57.06,0:14:57.98,Default,,0,0,0,,Иә...
Dialogue: 0,0:14:58.31,0:14:59.81,Default,,0,0,0,,Жігіттер
Dialogue: 0,0:14:59.89,0:15:01.94,Default,,0,0,0,,Керемет тәжірибе!
Dialogue: 0,0:15:02.02,0:15:03.81,Default,,0,0,0,,Біздің де мұны істеуден басқа амалымыз жоқ.
Dialogue: 0,0:15:03.90,0:15:06.23,Default,,0,0,0,,Үйге ертерек барып, тағы да арнайы жаттығулар жасайық.
Dialogue: 0,0:15:06.57,0:15:09.53,Default,,0,0,0,,Иә? Бар-нии, қайда бардың?
Dialogue: 0,0:15:09.61,0:15:11.20,Default,,0,0,0,,Сіз дәл қазір сонда болдыңыз, солай ма?
Dialogue: 0,0:15:11.41,0:15:14.28,Default,,0,0,0,,Қалай ойлайсың, ол Шудың сұхбатын тыңдады ма?
Dialogue: 0,0:15:14.37,0:15:15.49,Default,,0,0,0,,Жоғалған болуы мүмкін
Dialogue: 0,0:15:17.04,0:15:18.95,Default,,0,0,0,,Наннакота, солай ма?
Dialogue: 0,0:15:20.16,0:15:22.71,Default,,0,0,0,,Барлығы қайда кетті?
Dialogue: 0,0:15:22.92,0:15:24.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:27.71,0:15:29.21,Default,,0,0,0,,Бұл дыбыс...
Dialogue: 0,0:15:34.97,0:15:39.68,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:15:40.31,0:15:41.31,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:41.39,0:15:43.90,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:45.52,0:15:47.36,Default,,0,0,0,,(Еденге соғылған сымның дыбысы)
Dialogue: 0,0:15:47.86,0:15:48.86,Default,,0,0,0,,Луис…
Dialogue: 0,0:15:52.99,0:15:53.99,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:54.07,0:15:55.62,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:15:55.95,0:15:57.83,Default,,0,0,0,,Сіз кедергісіз. Кетіңіз.
Dialogue: 0,0:15:57.91,0:16:02.29,Default,,0,0,0,,Бұл өте қызық. Оны қарап шығуға болады.
Dialogue: 0,0:16:05.00,0:16:05.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:06.84,0:16:08.34,Default,,0,0,0,,Құтылдым-ау!
Dialogue: 0,0:16:09.80,0:16:10.92,Default,,0,0,0,,Уф… Мұнда не болып жатыр өзі?
Dialogue: 0,0:16:11.01,0:16:12.09,Default,,0,0,0,,Жоғал
Dialogue: 0,0:16:14.01,0:16:15.05,Default,,0,0,0,,О!
Dialogue: 0,0:16:15.14,0:16:16.51,Default,,0,0,0,,Уау!
Dialogue: 0,0:16:16.60,0:16:17.64,Default,,0,0,0,,Эй!
Dialogue: 0,0:16:17.85,0:16:19.64,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:16:19.72,0:16:21.77,Default,,0,0,0,,Мына сымды көре аласыз ба...
Dialogue: 0,0:16:23.69,0:16:25.98,Default,,0,0,0,,Оған жоғары баға қояды!
Dialogue: 0,0:16:26.06,0:16:29.27,Default,,0,0,0,,Мен сізбен кездескен кезде сізден бір нәрсе сұрайын деп едім.
Dialogue: 0,0:16:29.61,0:16:33.24,Default,,0,0,0,,Күні кеше сен мені жаман қуық деп айттың.
Dialogue: 0,0:16:33.74,0:16:35.70,Default,,0,0,0,,Сол кезде менің Валькириім...
Dialogue: 0,0:16:35.78,0:16:38.53,Default,,0,0,0,,Менің қайта оянуға тырысқанымды байқадыңыз, солай ма?
Dialogue: 0,0:16:38.62,0:16:41.00,Default,,0,0,0,,Сондықтан мен оны мүлде байқамадым...
Dialogue: 0,0:16:41.08,0:16:43.33,Default,,0,0,0,,Сіз мұны жаман қуық деп айттыңыз, солай ма?
Dialogue: 0,0:16:43.96,0:16:45.87,Default,,0,0,0,,Бірақ мен оны да байқадым.
Dialogue: 0,0:16:45.96,0:16:48.92,Default,,0,0,0,,Валькири қатты оянғалы жатыр.
Dialogue: 0,0:16:49.00,0:16:53.05,Default,,0,0,0,,Негізі бұл туралы досым Инуске айтты...
Dialogue: 0,0:16:53.38,0:16:54.84,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:16:57.01,0:16:59.72,Default,,0,0,0,,Өйткені, төрт бұрылыс император керемет.
Dialogue: 0,0:16:59.81,0:17:00.93,Default,,0,0,0,,Әсіресе Луи
Dialogue: 0,0:17:01.02,0:17:04.31,Default,,0,0,0,,Сіз, төрт рет қатарынан ел чемпионатында жеңіске жетуіңіз керемет!
Dialogue: 0,0:17:06.10,0:17:08.19,Default,,0,0,0,,Сіз мені керемет деп ойлайсыз ба?
Dialogue: 0,0:17:08.65,0:17:10.65,Default,,0,0,0,,Ах! Әрине!
Dialogue: 0,0:17:12.48,0:17:15.65,Default,,0,0,0,,Сіз мені ешқашан жеңе алмайсыз
Dialogue: 0,0:17:15.86,0:17:18.07,Default,,0,0,0,,Сіз мені керемет деп ойлаған кезде...
Dialogue: 0,0:17:18.16,0:17:20.32,Default,,0,0,0,,Сіз ұтылып қалдыңыз
Dialogue: 0,0:17:21.16,0:17:23.54,Default,,0,0,0,,Сіз тырыспайынша білмейсіз!
Dialogue: 0,0:17:23.62,0:17:26.79,Default,,0,0,0,,Оши! Олай болса, осы жерде және қазір шайқасайық!
Dialogue: 0,0:17:26.87,0:17:27.75,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:27.83,0:17:30.13,Default,,0,0,0,,Мен мағынасыз шайқастармен күреспеймін
Dialogue: 0,0:17:30.21,0:17:34.01,Default,,0,0,0,,Әсіресе сен сияқты жаман қулыққа қарсы.
Dialogue: 0,0:17:34.09,0:17:36.13,Default,,0,0,0,,Мен жаман қуық емеспін!
Dialogue: 0,0:17:36.22,0:17:39.01,Default,,0,0,0,,Жарайды, сен ақымақ Blader.
Dialogue: 0,0:17:39.51,0:17:40.80,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:17:40.89,0:17:43.64,Default,,0,0,0,,Мен бұл таңғажайып деп ойладым...
Dialogue: 0,0:17:43.72,0:17:47.02,Default,,0,0,0,,Луи! Мен сені енді керемет деп ойламаймын!
Dialogue: 0,0:17:51.02,0:17:53.15,Default,,0,0,0,,Бұл сіздің қолыңыздан келетін нәрсе...
Dialogue: 0,0:17:53.23,0:17:56.20,Default,,0,0,0,,Гррр!
Dialogue: 0,0:17:56.90,0:17:58.61,Default,,0,0,0,,Даа!
Dialogue: 0,0:18:01.78,0:18:02.74,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:18:02.83,0:18:04.37,Default,,0,0,0,,(орам сымының дыбысы)
Dialogue: 0,0:18:04.45,0:18:07.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:07.12,0:18:08.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:09.33,0:18:10.50,Default,,0,0,0,,Гррр…
Dialogue: 0,0:18:10.58,0:18:13.25,Default,,0,0,0,,Менімен күрес, Луи...
Dialogue: 0,0:18:13.34,0:18:15.09,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:18:15.80,0:18:17.34,Default,,0,0,0,,Барто Аои…
Dialogue: 0,0:18:19.09,0:18:20.34,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:18:20.43,0:18:23.68,Default,,0,0,0,,Сол шайқаста мен оңай жеңдім.
Dialogue: 0,0:18:23.76,0:18:25.60,Default,,0,0,0,,Менің вингерім жеңілмейді!
Dialogue: 0,0:18:25.68,0:18:27.23,Default,,0,0,0,,Командалық жарыстың финалында да...
Dialogue: 0,0:18:27.31,0:18:29.06,Default,,0,0,0,,Вайверн мініп шығады...
Dialogue: 0,0:18:29.14,0:18:32.11,Default,,0,0,0,,Иә, жеткілікті. Келесіде Дина-кун.
Dialogue: 0,0:18:32.19,0:18:34.86,Default,,0,0,0,,Не, мен әлі ештеңе айтқан жоқпын.
Dialogue: 0,0:18:35.07,0:18:37.15,Default,,0,0,0,,Сыпайырақ сөйлескіңіз келе ме?
Dialogue: 0,0:18:37.24,0:18:38.61,Default,,0,0,0,,Бұл жеткілікті...
Dialogue: 0,0:18:38.70,0:18:40.07,Default,,0,0,0,,Бұл әлі де жеткіліксіз
Dialogue: 0,0:18:40.16,0:18:42.03,Default,,0,0,0,,Жетер, Уакия!
Dialogue: 0,0:18:42.12,0:18:43.49,Default,,0,0,0,,Ах, Бал-нии
Dialogue: 0,0:18:43.58,0:18:44.66,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:18:44.87,0:18:46.83,Default,,0,0,0,,Мен Луимен кездестім.
Dialogue: 0,0:18:46.91,0:18:48.04,Default,,0,0,0,,Не...
Dialogue: 0,0:18:48.37,0:18:51.58,Default,,0,0,0,,Ол... Ол осы үлкен бөлмеде арнайы жаттығу жасап жатқан.
Dialogue: 0,0:18:52.13,0:18:53.25,Default,,0,0,0,,Арнайы дайындықтың қандай түрі?
Dialogue: 0,0:18:53.63,0:18:54.67,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:55.30,0:18:56.71,Default,,0,0,0,,Көру
Dialogue: 0,0:18:56.80,0:18:59.47,Default,,0,0,0,,Бұл жарылыс!
Dialogue: 0,0:18:59.55,0:19:00.93,Default,,0,0,0,,Өртен! Ұнайды...
Dialogue: 0,0:19:01.47,0:19:03.30,Default,,0,0,0,,Мен мүлде түсінбеймін!
Dialogue: 0,0:19:03.39,0:19:04.93,Default,,0,0,0,,Сіз Луимен сөйлестіңіз бе?
Dialogue: 0,0:19:05.01,0:19:06.22,Default,,0,0,0,,Иә
Dialogue: 0,0:19:06.31,0:19:07.85,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:19:09.69,0:19:13.48,Default,,0,0,0,,Осыны есіме түсіру мен үшін қатты ашуланады!
Dialogue: 0,0:19:13.56,0:19:15.57,Default,,0,0,0,,Аняро!
Dialogue: 0,0:19:15.65,0:19:18.36,Default,,0,0,0,,Бірдеңе болды ма? Жоқ, бірақ...
Dialogue: 0,0:19:18.44,0:19:21.11,Default,,0,0,0,,Мен бәрібір менімен айналысатын адамды ала алмадым.
Dialogue: 0,0:19:21.20,0:19:23.12,Default,,0,0,0,,Е, сен қайдан білесің?
Dialogue: 0,0:19:23.20,0:19:25.08,Default,,0,0,0,,Менің түсінгенім осы ғана!
Dialogue: 0,0:19:25.74,0:19:26.99,Default,,0,0,0,,Бәрі жақсы, мен бұны істей аламын!
Dialogue: 0,0:19:29.16,0:19:31.42,Default,,0,0,0,,Сіз бізбен айналыса алмайсыз...
Dialogue: 0,0:19:31.75,0:19:34.04,Default,,0,0,0,,Мен бұған ренжідім...
Dialogue: 0,0:19:37.00,0:19:39.72,Default,,0,0,0,,Няро, көңіл-күйіңіз жақсы!
Dialogue: 0,0:19:39.92,0:19:41.63,Default,,0,0,0,,Мен өзімді ақымақ сезіндім...
Dialogue: 0,0:19:41.72,0:19:42.93,Default,,0,0,0,,Камера камерасы!
Dialogue: 0,0:19:43.01,0:19:43.84,Default,,0,0,0,,О
Dialogue: 0,0:19:45.60,0:19:47.72,Default,,0,0,0,,Финал... Мен жеңгім келеді
Dialogue: 0,0:19:47.81,0:19:49.22,Default,,0,0,0,,Бұл мүмкін!
Dialogue: 0,0:19:49.31,0:19:50.10,Default,,0,0,0,,That's right.
Dialogue: 0,0:19:50.18,0:19:51.35,Default,,0,0,0,,Мен жасадым!
Dialogue: 0,0:19:51.44,0:19:52.73,Default,,0,0,0,,Сөзсіз жеңіске жетейік!
Dialogue: 0,0:19:52.81,0:19:53.94,Default,,0,0,0,,О!
Dialogue: 0,0:19:54.02,0:19:56.77,Default,,0,0,0,,Міне! Мен мұны суретке түсіргім келді!
Dialogue: 0,0:19:56.98,0:19:59.28,Default,,0,0,0,,Йонекома Гакуэн шығанағы клубы
Dialogue: 0,0:19:59.36,0:20:00.69,Default,,0,0,0,,Ұрыс
Dialogue: 0,0:20:01.03,0:20:02.78,Default,,0,0,0,,О!
Dialogue: 0,0:20:06.99,0:20:08.45,Default,,0,0,0,,Бұрынғы мен――
Dialogue: 0,0:20:08.54,0:20:11.04,Default,,0,0,0,,Барлығы менің жеңісім туралы болды...
Dialogue: 0,0:20:11.58,0:20:12.66,Default,,0,0,0,,Бірақ қазір
Dialogue: 0,0:20:12.75,0:20:15.63,Default,,0,0,0,,Bay Club-тағы барлық адамдар үшін мен...
Dialogue: 0,0:20:15.71,0:20:17.21,Default,,0,0,0,,Мен ойлана бастадым
Dialogue: 0,0:20:18.50,0:20:20.21,Default,,0,0,0,,Келесі финал
Dialogue: 0,0:20:20.30,0:20:21.47,Default,,0,0,0,,Осы турнирде-
Dialogue: 0,0:20:21.55,0:20:24.59,Default,,0,0,0,,Бұл Дина-кун қатыса алатын соңғы матч болады.
Dialogue: 0,0:20:24.68,0:20:26.85,Default,,0,0,0,,Ах, тіпті соңғы матчта...
Dialogue: 0,0:20:26.93,0:20:30.97,Default,,0,0,0,,Команда жеңіске жету үшін ойнамағаным дұрыс деп ойласаңыз
Dialogue: 0,0:20:31.06,0:20:32.81,Default,,0,0,0,,Мен келмеуді таңдаймын
Dialogue: 0,0:20:33.19,0:20:34.06,Default,,0,0,0,,Е...
Dialogue: 0,0:20:34.44,0:20:36.98,Default,,0,0,0,,Мен осылай күресемін.
Dialogue: 0,0:20:38.94,0:20:41.19,Default,,0,0,0,,Бұл тамаша... түрі...
Dialogue: 0,0:20:41.28,0:20:42.74,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:20:42.82,0:20:44.57,Default,,0,0,0,,Жылама...
Dialogue: 0,0:20:48.49,0:20:50.70,Default,,0,0,0,,Өте ояту әлі аяқталған жоқ.
Dialogue: 0,0:20:51.16,0:20:53.41,Default,,0,0,0,,Валькири оның жақын жерде екенін айтады.
Dialogue: 0,0:20:53.91,0:20:56.17,Default,,0,0,0,,Маған супер оянуыңызды көрсетіңіз!
Dialogue: 0,0:20:57.08,0:21:00.88,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:21:00.96,0:21:03.01,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:21:46.63,0:21:51.05,Default,,0,0,0,,(lol)
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.69,0:23:29.36,Default,,0,0,0,,Финал алдындағы арнайы дайындық...
Dialogue: 0,0:23:29.44,0:23:31.61,Default,,0,0,0,,Е! Шынайы!
Dialogue: 0,0:23:31.70,0:23:34.78,Default,,0,0,0,,Бірақ Шу айтса, орындаймыз!
Dialogue: 0,0:23:34.87,0:23:36.95,Default,,0,0,0,,Финалға қатысатын спортшылар:
Dialogue: 0,0:23:37.04,0:23:39.58,Default,,0,0,0,,Кумичо Дина мен Шу!
Dialogue: 0,0:23:39.66,0:23:42.08,Default,,0,0,0,,Мен, капитан, шештім!
Dialogue: 0,0:23:42.17,0:23:44.29,Default,,0,0,0,,Келесі Beblade Burst
Dialogue: 0,0:23:44.38,0:23:46.04,Default,,0,0,0,,Біздің финалдық матч!
Dialogue: 0,0:23:46.13,0:23:48.05,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.13,0:23:49.97,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.47,0:23:57.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory