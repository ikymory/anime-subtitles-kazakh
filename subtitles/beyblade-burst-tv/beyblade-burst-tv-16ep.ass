Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.50,0:00:09.17,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.25,0:00:12.63,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.76,0:00:14.76,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:16.93,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.01,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.60,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.23,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.31,0:00:28.65,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:32.24,0:00:35.61,Default,,0,0,0,,Мен және Шудың уәде етілген орны финалы
Dialogue: 0,0:00:49.34,0:00:50.13,Default,,0,0,0,,Ах
Dialogue: 0,0:00:51.05,0:00:51.96,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:52.21,0:00:53.21,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,0:00:53.63,0:00:57.01,Default,,0,0,0,,Сторм Спригган 1 ұпай айналдырумен
Dialogue: 0,0:00:57.30,0:00:59.89,Default,,0,0,0,,Куришуу 3-2 жеңді!
Dialogue: 0,0:01:00.39,0:01:01.31,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:01:01.39,0:01:02.72,Default,,0,0,0,,Ах~
Dialogue: 0,0:01:02.81,0:01:05.19,Default,,0,0,0,,Шуды жеңе алмадым
Dialogue: 0,0:01:05.39,0:01:07.77,Default,,0,0,0,,Иық ауырғанына шыдады.
Dialogue: 0,0:01:07.85,0:01:08.77,Default,,0,0,0,,Кисаның маған басын айналдыра ғашық болуын қамтамасыз етуім керек
Dialogue: 0,0:01:09.23,0:01:11.23,Default,,0,0,0,,Мен бұл күштің бәрін пайдаландым.
Dialogue: 0,0:01:11.32,0:01:13.94,Default,,0,0,0,,Маған осылай ұйықтауға рұқсат етіңіз.
Dialogue: 0,0:01:14.90,0:01:16.45,Default,,0,0,0,,Шу…
Dialogue: 0,0:01:24.79,0:01:27.17,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:27.50,0:01:32.67,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:43.97,0:01:47.35,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:47.85,0:01:49.98,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:50.40,0:01:54.53,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:54.65,0:01:57.86,Default,,0,0,0,,Дұрыс, маған бетпе-бет келген өрнек
Dialogue: 0,0:01:57.99,0:02:04.41,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:04.70,0:02:09.12,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:09.62,0:02:15.05,Default,,0,0,0,,Дауысты дауыстап, дірілдеп ойнайық
Dialogue: 0,0:02:15.17,0:02:17.42,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:17.51,0:02:22.22,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:22.39,0:02:27.48,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:27.77,0:02:30.02,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:30.23,0:02:32.56,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:32.86,0:02:36.78,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:36.94,0:02:41.95,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:42.16,0:02:44.33,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:47.91,0:02:50.92,Default,,0,0,0,,Таң қалдырыңыз! Арнайы жанып жатқан храм!
Dialogue: 0,0:02:53.08,0:02:54.75,Default,,0,0,0,,Шу!
Dialogue: 0,0:02:54.84,0:02:56.84,Default,,0,0,0,,Эй Шуу
Dialogue: 0,0:02:56.92,0:02:59.13,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:02:59.30,0:03:00.63,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:03:00.72,0:03:02.72,Default,,0,0,0,,Шукун үйде болмады.
Dialogue: 0,0:03:02.80,0:03:05.56,Default,,0,0,0,,Ол мектепке келмеді немесе мектепті сығымдамады.
Dialogue: 0,0:03:05.76,0:03:08.31,Default,,0,0,0,,Аурухана басқа жаққа көшкен сияқты.
Dialogue: 0,0:03:08.39,0:03:10.52,Default,,0,0,0,,Сол мыңжапырақ
Dialogue: 0,0:03:10.60,0:03:12.98,Default,,0,0,0,,Ондай денемен қайда бардың?
Dialogue: 0,0:03:14.36,0:03:15.73,Default,,0,0,0,,Шу…
Dialogue: 0,0:03:16.27,0:03:18.32,Default,,0,0,0,,Шынымен, қайда кетті?
Dialogue: 0,0:03:18.40,0:03:19.57,Default,,0,0,0,,Мұндай жарақатпен
Dialogue: 0,0:03:20.57,0:03:21.65,Default,,0,0,0,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,0:03:21.86,0:03:24.20,Default,,0,0,0,,Шу енді Бейді ойнай алмаса...
Dialogue: 0,0:03:24.28,0:03:25.66,Default,,0,0,0,,Сіз не айтып тұрсыз?
Dialogue: 0,0:03:25.99,0:03:27.45,Default,,0,0,0,,Содан кейін бәрі
Dialogue: 0,0:03:28.29,0:03:30.66,Default,,0,0,0,,Бәріне менің кінәм...
Dialogue: 0,0:03:31.33,0:03:33.04,Default,,0,0,0,,Габринчо
Dialogue: 0,0:03:33.92,0:03:35.17,Default,,0,0,0,,Иттерге қызмет көрсету…
Dialogue: 0,0:03:35.42,0:03:38.00,Default,,0,0,0,,Сіз Шу туралы түсінбейсіз.
Dialogue: 0,0:03:38.09,0:03:39.38,Default,,0,0,0,,Өйткені I
Dialogue: 0,0:03:39.46,0:03:42.51,Default,,0,0,0,,Шудың соңғы шайқастан шығуы мүмкін емес.
Dialogue: 0,0:03:43.38,0:03:45.26,Default,,0,0,0,,Егер Барт
Dialogue: 0,0:03:45.72,0:03:48.14,Default,,0,0,0,,Шумен матчтан бас тарттыңыз ба?
Dialogue: 0,0:03:57.48,0:03:58.69,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:59.28,0:04:00.53,Default,,0,0,0,,Э? Мен сені естімеймін!
Dialogue: 0,0:04:00.61,0:04:01.90,Default,,0,0,0,,Мен онымен соғысқым келеді
Dialogue: 0,0:04:02.11,0:04:02.90,Default,,0,0,0,,Талап етілмеген елу миллиардты қайтарып алу үшін.
Dialogue: 0,0:04:02.99,0:04:05.28,Default,,0,0,0,,Сіз осындай нәрсеге жауапкершілікті сезінесіз бе?
Dialogue: 0,0:04:05.37,0:04:06.62,Default,,0,0,0,,Мен оны аяймын.
Dialogue: 0,0:04:06.87,0:04:09.58,Default,,0,0,0,,Иә, солай...
Dialogue: 0,0:04:09.66,0:04:10.87,Default,,0,0,0,,Көңіл көтеру
Dialogue: 0,0:04:10.95,0:04:12.25,Default,,0,0,0,,Кумичо
Dialogue: 0,0:04:13.33,0:04:14.37,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:04:14.83,0:04:18.59,Default,,0,0,0,,Дұрыс, мен де солай ойлаймын, Балто.
Dialogue: 0,0:04:18.71,0:04:19.71,Default,,0,0,0,,О...
Dialogue: 0,0:04:20.84,0:04:21.80,Default,,0,0,0,,мотивацияң — мүлде басқаша болады ғой?
Dialogue: 0,0:04:22.34,0:04:23.84,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:24.55,0:04:26.34,Default,,0,0,0,,А Шака!
Dialogue: 0,0:04:26.68,0:04:28.47,Default,,0,0,0,,Бейблейд Шитенко
Dialogue: 0,0:04:28.89,0:04:30.72,Default,,0,0,0,,Жанып тұрған ғибадатхана Кайза
Dialogue: 0,0:04:30.85,0:04:32.43,Default,,0,0,0,,Балалар, сендер күтіп тұрғанда
Dialogue: 0,0:04:32.52,0:04:34.52,Default,,0,0,0,,Кішкене жаттығу
Dialogue: 0,0:04:35.06,0:04:35.85,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:36.23,0:04:37.77,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:04:37.86,0:04:40.98,Default,,0,0,0,,Шу қазір атамның қасында.
Dialogue: 0,0:04:41.07,0:04:42.24,Default,,0,0,0,,Қария?
Dialogue: 0,0:04:42.57,0:04:45.32,Default,,0,0,0,,Аа, бұдан былай бәріміз...
Dialogue: 0,0:04:45.41,0:04:47.24,Default,,0,0,0,,Қарттың үйінде!
Dialogue: 0,0:04:47.70,0:04:48.49,Default,,0,0,0,,Бал-нии!
Dialogue: 0,0:04:48.57,0:04:49.45,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:04:49.53,0:04:51.95,Default,,0,0,0,,Бала күнгі дос күткендей.
Dialogue: 0,0:04:52.04,0:04:54.50,Default,,0,0,0,,Сен тіпті атаңның қайда екенін білесің бе?
Dialogue: 0,0:04:54.58,0:04:56.83,Default,,0,0,0,,Жоқ, сіз білмейсіз деп ойлаймын.
Dialogue: 0,0:04:57.13,0:04:58.17,Default,,0,0,0,,Эй
Dialogue: 0,0:04:58.25,0:05:00.04,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:05:00.13,0:05:02.09,Default,,0,0,0,,Тез кел!
Dialogue: 0,0:05:08.39,0:05:11.01,Default,,0,0,0,,Бұл монорельсті бірінші рет мініп отырмын.
Dialogue: 0,0:05:11.18,0:05:13.22,Default,,0,0,0,,Иә, мен қатты әсер алдым.
Dialogue: 0,0:05:13.43,0:05:15.94,Default,,0,0,0,,Сіз Бал-нидің жаттығу алаңын көре аласыз.
Dialogue: 0,0:05:16.27,0:05:18.35,Default,,0,0,0,,Мен ақыры жеттім.
Dialogue: 0,0:05:18.44,0:05:20.15,Default,,0,0,0,,Ника да, Токонацу да
Dialogue: 0,0:05:20.23,0:05:22.94,Default,,0,0,0,,Анаң уайымдамайды деп үміттенемін.
Dialogue: 0,0:05:23.15,0:05:25.70,Default,,0,0,0,,Мен анама міндетті түрде айттым.
Dialogue: 0,0:05:25.78,0:05:26.49,Default,,0,0,0,,Эй
Dialogue: 0,0:05:26.57,0:05:27.53,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,0:05:28.41,0:05:31.03,Default,,0,0,0,,Барлығы екеуіңді сұрайды.
Dialogue: 0,0:05:31.12,0:05:34.50,Default,,0,0,0,,Сондай-ақ, Шу-кунға да сәлем жолдаңыз.
Dialogue: 0,0:05:34.91,0:05:36.71,Default,,0,0,0,,Ihihi…
Dialogue: 0,0:05:37.37,0:05:38.75,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:05:38.83,0:05:41.75,Default,,0,0,0,,Мынаны Шу-кунға бер.
Dialogue: 0,0:05:41.84,0:05:44.05,Default,,0,0,0,,Маған жақсылық жасауыңызды өтінемін.
Dialogue: 0,0:05:44.13,0:05:45.97,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:05:49.93,0:05:52.68,Default,,0,0,0,,(Бартоның ауыр тыныс алуы)
Dialogue: 0,0:05:53.56,0:05:54.97,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:05:55.06,0:05:58.23,Default,,0,0,0,,Өтірік айтасың, әлі көтерілген жоқсың ба?
Dialogue: 0,0:05:59.02,0:06:00.56,Default,,0,0,0,,Шаршадыңыз ба?
Dialogue: 0,0:06:00.65,0:06:02.48,Default,,0,0,0,,Ол аянышты.
Dialogue: 0,0:06:02.57,0:06:04.40,Default,,0,0,0,,Патетикалық Кумичо
Dialogue: 0,0:06:04.48,0:06:05.69,Default,,0,0,0,,Бұл дұрыс, дұрыс.
Dialogue: 0,0:06:05.78,0:06:07.20,Default,,0,0,0,,Боқ~
Dialogue: 0,0:06:07.57,0:06:08.74,Default,,0,0,0,,Сол ептілік
Dialogue: 0,0:06:09.36,0:06:11.16,Default,,0,0,0,,Сіз шынымен адамсыз ба?
Dialogue: 0,0:06:12.53,0:06:13.91,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:06:13.99,0:06:14.99,Default,,0,0,0,,сонымен қатар кейбір қосымша пайда да бар. Олар қандай?
Dialogue: 0,0:06:16.54,0:06:18.12,Default,,0,0,0,,Барға жуық.
Dialogue: 0,0:06:18.25,0:06:19.46,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:06:19.54,0:06:21.29,Default,,0,0,0,,Ұрыс!
Dialogue: 0,0:06:21.38,0:06:22.34,Default,,0,0,0,,Жарайды
Dialogue: 0,0:06:22.42,0:06:24.09,Default,,0,0,0,,Шу, күте тұр.
Dialogue: 0,0:06:24.17,0:06:25.09,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:06:25.17,0:06:27.22,Default,,0,0,0,,Уау! Балтық!
Dialogue: 0,0:06:28.13,0:06:30.51,Default,,0,0,0,,Хаха! Сен не істеп жатырсың?
Dialogue: 0,0:06:30.59,0:06:31.76,Default,,0,0,0,,Урухэ~
Dialogue: 0,0:06:32.22,0:06:33.64,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:06:33.72,0:06:34.76,Default,,0,0,0,,Гахахаха…
Dialogue: 0,0:06:34.85,0:06:35.43,Default,,0,0,0,,Әй!
Dialogue: 0,0:06:35.52,0:06:36.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:39.35,0:06:40.85,Default,,0,0,0,,Міне, Балто.
Dialogue: 0,0:06:40.94,0:06:41.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:42.11,0:06:43.69,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:43.77,0:06:46.11,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:06:46.19,0:06:47.57,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:06:47.94,0:06:50.28,Default,,0,0,0,,Бұл қай жер?
Dialogue: 0,0:06:50.86,0:06:52.32,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:52.57,0:06:53.83,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:54.24,0:06:55.99,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:06:57.41,0:06:58.50,Default,,0,0,0,,Шерри
Dialogue: 0,0:06:58.58,0:07:02.04,Default,,0,0,0,,Бұл «Мен әлі де сені күтіп тұрмын» деген сигнал.
Dialogue: 0,0:07:02.13,0:07:02.92,Default,,0,0,0,,Ах
Dialogue: 0,0:07:03.38,0:07:05.00,Default,,0,0,0,,Кәдімгі жол бар
Dialogue: 0,0:07:10.51,0:07:12.64,Default,,0,0,0,,Өренші ғибадатханасы отбасы
Dialogue: 0,0:07:12.72,0:07:15.35,Default,,0,0,0,,Ежелден келе жатқан жекпе-жек өнерінің мұрагері
Dialogue: 0,0:07:15.43,0:07:16.89,Default,,0,0,0,,Мен адамдарға сабақ беремін
Dialogue: 0,0:07:17.56,0:07:19.43,Default,,0,0,0,,Күн сайын баладан қартқа дейін
Dialogue: 0,0:07:19.52,0:07:22.56,Default,,0,0,0,,Мұнда көптеген адамдар жаттығуға келеді.
Dialogue: 0,0:07:22.65,0:07:24.31,Default,,0,0,0,,Ха! (Барлығы) О~
Dialogue: 0,0:07:24.40,0:07:27.57,Default,,0,0,0,,Маңыздысы күнделікті жаттығу.
Dialogue: 0,0:07:27.86,0:07:31.28,Default,,0,0,0,,Сондықтан да сен епті және физикалық күштісің бе?
Dialogue: 0,0:07:31.36,0:07:34.37,Default,,0,0,0,,Шақа не болса да мықты еді.
Dialogue: 0,0:07:34.45,0:07:35.74,Default,,0,0,0,,Тіпті балабақшада
Dialogue: 0,0:07:36.03,0:07:37.37,Default,,0,0,0,,Жүгіру жарысы
Dialogue: 0,0:07:37.54,0:07:39.58,Default,,0,0,0,,Қол күресінің жеуге болатын мөлшері
Dialogue: 0,0:07:39.66,0:07:41.79,Default,,0,0,0,,Мен не істесем де, мен біріншімін.
Dialogue: 0,0:07:41.87,0:07:44.17,Default,,0,0,0,,Мен мүлде жеңе алмаймын.
Dialogue: 0,0:07:46.79,0:07:50.13,Default,,0,0,0,,Ой~ Тағы барайық.
Dialogue: 0,0:07:50.38,0:07:51.26,Default,,0,0,0,,Эй!
Dialogue: 0,0:07:51.34,0:07:55.14,Default,,0,0,0,,1 2 3 4 5 6 7!
Dialogue: 0,0:07:55.64,0:07:57.60,Default,,0,0,0,,Шака керемет~
Dialogue: 0,0:07:58.47,0:07:59.72,Default,,0,0,0,,Мен де істеймін
Dialogue: 0,0:08:00.77,0:08:02.60,Default,,0,0,0,,Хмм, эй!
Dialogue: 0,0:08:03.60,0:08:06.36,Default,,0,0,0,,Ах, мен қатты күйзелдім.
Dialogue: 0,0:08:06.44,0:08:08.52,Default,,0,0,0,,Сен менің сені қаншалықты ұрғым келгенін білмейсің.
Dialogue: 0,0:08:08.94,0:08:11.11,Default,,0,0,0,,Ол кезде қайғылы еді.
Dialogue: 0,0:08:11.19,0:08:12.65,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:08:12.74,0:08:14.45,Default,,0,0,0,,Сондай сағыныш
Dialogue: 0,0:08:15.57,0:08:17.78,Default,,0,0,0,,Жарайды, келесі иықтар.
Dialogue: 0,0:08:21.04,0:08:23.75,Default,,0,0,0,,Хмм, бұл жерде әлі біраз шиеленіс.
Dialogue: 0,0:08:23.83,0:08:24.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:08:25.54,0:08:26.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:26.54,0:08:28.96,Default,,0,0,0,,Шу, сен тағы да жасырынып жүрсің.
Dialogue: 0,0:08:29.05,0:08:30.76,Default,,0,0,0,,Сіз шығанақпен жаттығу жасадыңыз ба?
Dialogue: 0,0:08:30.84,0:08:31.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:31.84,0:08:35.97,Default,,0,0,0,,Бұлшықеттер сіз ойлағаннан да адал.
Dialogue: 0,0:08:36.55,0:08:37.60,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:38.14,0:08:40.22,Default,,0,0,0,,Ойынның сезімін ұмытқым келмейді
Dialogue: 0,0:08:40.85,0:08:43.56,Default,,0,0,0,,Сіз көптеген адамдарға қарағанда бірнеше есе шыдамдысыз.
Dialogue: 0,0:08:44.14,0:08:46.10,Default,,0,0,0,,Қазіргі иық жағдайы
Dialogue: 0,0:08:46.19,0:08:50.15,Default,,0,0,0,,Кәдімгі бастауыш сынып оқушысы бәрібір жылап, ауырсынатын.
Dialogue: 0,0:08:51.28,0:08:52.32,Default,,0,0,0,,Бірақ
Dialogue: 0,0:08:52.53,0:08:55.15,Default,,0,0,0,,Бей ойынын жалғастырғыңыз келе ме?
Dialogue: 0,0:08:56.70,0:09:00.45,Default,,0,0,0,,Олай болса мен өз денеме көбірек күтім жасауым керек.
Dialogue: 0,0:09:00.62,0:09:01.91,Default,,0,0,0,,Аздап ауырады.
Dialogue: 0,0:09:02.12,0:09:02.95,Default,,0,0,0,,Иә
Dialogue: 0,0:09:03.04,0:09:05.16,Default,,0,0,0,,Уф... Уф...
Dialogue: 0,0:09:05.25,0:09:06.71,Default,,0,0,0,,Шу!
Dialogue: 0,0:09:07.17,0:09:08.08,Default,,0,0,0,,Шу…
Dialogue: 0,0:09:08.79,0:09:11.05,Default,,0,0,0,,Шу…
Dialogue: 0,0:09:11.13,0:09:13.17,Default,,0,0,0,,Балто! Шу-кун
Dialogue: 0,0:09:13.26,0:09:15.34,Default,,0,0,0,,Токонацу Ника
Dialogue: 0,0:09:15.84,0:09:18.43,Default,,0,0,0,,Барлығы сен үшін алаңдайды.
Dialogue: 0,0:09:18.51,0:09:20.30,Default,,0,0,0,,Біз осы уақытқа дейін жеттік.
Dialogue: 0,0:09:20.39,0:09:22.10,Default,,0,0,0,,Сіз мен ойлағаннан да жақсы көрінесіз.
Dialogue: 0,0:09:22.18,0:09:23.22,Default,,0,0,0,,Хехехе...
Dialogue: 0,0:09:23.43,0:09:24.35,Default,,0,0,0,,Шу…
Dialogue: 0,0:09:24.77,0:09:26.02,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:09:26.10,0:09:28.10,Default,,0,0,0,,Сіз шынымен жақсысыз ба?
Dialogue: 0,0:09:29.15,0:09:31.23,Default,,0,0,0,,Уф, тым қызықсыз екен.
Dialogue: 0,0:09:31.44,0:09:32.40,Default,,0,0,0,,Барт…
Dialogue: 0,0:09:32.48,0:09:33.40,Default,,0,0,0,,Әй
Dialogue: 0,0:09:33.69,0:09:35.36,Default,,0,0,0,,Мұрыннан су ағып жатыр.
Dialogue: 0,0:09:38.03,0:09:38.99,Default,,0,0,0,,Хе...
Dialogue: 0,0:09:39.32,0:09:40.53,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:09:41.28,0:09:44.54,Default,,0,0,0,,Ұлттық конгреске уақытында келіңіз
Dialogue: 0,0:09:44.62,0:09:45.41,Default,,0,0,0,,О!
Dialogue: 0,0:09:45.83,0:09:46.62,Default,,0,0,0,,Иә
Dialogue: 0,0:09:46.71,0:09:48.12,Default,,0,0,0,,Менің атам
Dialogue: 0,0:09:48.50,0:09:52.04,Default,,0,0,0,,Жанып тұрған Варюу храмын емдеу арқылы емделмейтін жарақаттар болмайды.
Dialogue: 0,0:09:52.50,0:09:54.05,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:09:55.09,0:09:56.63,Default,,0,0,0,,Шығу уақыты келді.
Dialogue: 0,0:09:56.72,0:09:57.63,Default,,0,0,0,,Юго
Dialogue: 0,0:09:58.26,0:10:00.80,Default,,0,0,0,,Сіз мұны байқадыңыз ба?
Dialogue: 0,0:10:00.89,0:10:01.89,Default,,0,0,0,,(Бакуго) Сол жексұрын данышпан... Маған түк те керек емес!
Dialogue: 0,0:10:03.14,0:10:04.27,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:04.47,0:10:05.85,Default,,0,0,0,,Мен таң қалдым!
Dialogue: 0,0:10:05.93,0:10:07.10,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:10:07.64,0:10:08.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:08.73,0:10:11.56,Default,,0,0,0,,Йонекома ауданының екінші жүлдегері келе жатыр.
Dialogue: 0,0:10:11.65,0:10:13.65,Default,,0,0,0,,Мен жағдайды бақылап отырдым.
Dialogue: 0,0:10:13.86,0:10:17.24,Default,,0,0,0,,Сіздің қаншалықты ер адам екеніңізді көру үшін.
Dialogue: 0,0:10:17.32,0:10:19.66,Default,,0,0,0,,«Онуши» мен бе?
Dialogue: 0,0:10:20.32,0:10:23.08,Default,,0,0,0,,Осындай қарапайым қулықты байқамағаныңызға сене алар емеспін.
Dialogue: 0,0:10:23.53,0:10:25.12,Default,,0,0,0,,Ашық сөйлеңіз
Dialogue: 0,0:10:26.04,0:10:28.12,Default,,0,0,0,,Сіз самурай бола алмайсыз
Dialogue: 0,0:10:28.21,0:10:29.33,Default,,0,0,0,,...
Dialogue: 0,0:10:29.75,0:10:31.79,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:31.88,0:10:34.80,Default,,0,0,0,,Юго әрқашан самурайларға тәнті болған.
Dialogue: 0,0:10:34.88,0:10:36.34,Default,,0,0,0,,Самурай дегеніміз не?
Dialogue: 0,0:10:36.63,0:10:38.05,Default,,0,0,0,,Мына самурай?
Dialogue: 0,0:10:38.13,0:10:39.30,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:10:39.38,0:10:40.38,Default,,0,0,0,,Сіз бе?
Dialogue: 0,0:10:40.47,0:10:42.85,Default,,0,0,0,,Бұрынғы шұңқыр және үлкен бөрене
Dialogue: 0,0:10:42.93,0:10:44.97,Default,,0,0,0,,Сол деңгейдегі әлсіз тон дегеніміз не?
Dialogue: 0,0:10:45.06,0:10:47.39,Default,,0,0,0,,Мұны естіген Шақаның бала күнгі досы шошып кетеді.
Dialogue: 0,0:10:47.48,0:10:49.10,Default,,0,0,0,,Сәлем Юго
Dialogue: 0,0:10:49.31,0:10:52.19,Default,,0,0,0,,Шақа не десе де тыңда.
Dialogue: 0,0:10:52.27,0:10:57.23,Default,,0,0,0,,Міне, мен Шаканың оң қолы Юго Нансуиді өткіземін.
Dialogue: 0,0:10:57.32,0:10:59.40,Default,,0,0,0,,Се... Сеша
Dialogue: 0,0:10:59.49,0:11:01.99,Default,,0,0,0,,Юго, мені қатты қорқытпа.
Dialogue: 0,0:11:02.62,0:11:05.49,Default,,0,0,0,,Бұл жігіт Күйік ғибадатханасының ежелгі жауынгерлік өнер мектебінің шәкірті.
Dialogue: 0,0:11:05.58,0:11:06.70,Default,,0,0,0,,Нансуи Юго
Dialogue: 0,0:11:07.41,0:11:11.50,Default,,0,0,0,,Мен Bay Club Sword Flames тобын бірге жасаған командаласпын.
Dialogue: 0,0:11:12.04,0:11:13.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:13.08,0:11:14.63,Default,,0,0,0,,Танысқаныма қуаныштымын, Юго
Dialogue: 0,0:11:15.09,0:11:16.25,Default,,0,0,0,,Хмф!
Dialogue: 0,0:11:17.59,0:11:19.51,Default,,0,0,0,,Ауырды!
Dialogue: 0,0:11:19.59,0:11:21.47,Default,,0,0,0,,Хахахахаха
Dialogue: 0,0:11:21.55,0:11:24.05,Default,,0,0,0,,Дұрыс, біз осында келдік.
Dialogue: 0,0:11:24.14,0:11:26.93,Default,,0,0,0,,Балалар, менің клубымда жекпе-жек өткізейік.
Dialogue: 0,0:11:27.01,0:11:27.93,Default,,0,0,0,,Шака!
Dialogue: 0,0:11:28.02,0:11:29.93,Default,,0,0,0,,Менде ерекше нәрсе бар.
Dialogue: 0,0:11:30.35,0:11:31.73,Default,,0,0,0,,Арнайы?
Dialogue: 0,0:11:34.81,0:11:37.44,Default,,0,0,0,,Бұл біздің шығанақ клубы
Dialogue: 0,0:11:37.53,0:11:39.44,Default,,0,0,0,,Бұл «Қылыш жалындары» жаттығу ауқымы.
Dialogue: 0,0:11:40.28,0:11:42.41,Default,,0,0,0,,Ах Шака қош келдіңіз
Dialogue: 0,0:11:42.82,0:11:43.66,Default,,0,0,0,,Еркек!
Dialogue: 0,0:11:43.82,0:11:44.99,Default,,0,0,0,,Еркек!
Dialogue: 0,0:11:45.12,0:11:47.41,Default,,0,0,0,,Ей, маған қарашы, Бей.
Dialogue: 0,0:11:47.49,0:11:48.99,Default,,0,0,0,,Мен жаңа қулық үйрендім.
Dialogue: 0,0:11:49.08,0:11:50.87,Default,,0,0,0,,А, мен де, мен де
Dialogue: 0,0:11:51.08,0:11:52.96,Default,,0,0,0,,Шака бұл керемет
Dialogue: 0,0:11:53.17,0:11:54.38,Default,,0,0,0,,Танымал адам
Dialogue: 0,0:11:54.58,0:11:55.67,Default,,0,0,0,,Бірнеше Титанға кезігіп қалғаның өкінішті, бірақ
Dialogue: 0,0:11:56.09,0:11:58.30,Default,,0,0,0,,Ей Шака, ерекшелігі неде?
Dialogue: 0,0:11:58.38,0:12:00.13,Default,,0,0,0,,Арнайы Бұл қайда?
Dialogue: 0,0:12:06.93,0:12:07.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:07.97,0:12:08.97,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:14.77,0:12:16.56,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:23.03,0:12:24.74,Default,,0,0,0,,Біз тез әрекет етуіміз керек
Dialogue: 0,0:12:24.82,0:12:26.91,Default,,0,0,0,,Мен мұндай стадионды бұрын-соңды көрген емеспін.
Dialogue: 0,0:12:27.49,0:12:28.87,Default,,0,0,0,,Хахаха
Dialogue: 0,0:12:28.95,0:12:30.74,Default,,0,0,0,,Ерекшелігі де осында.
Dialogue: 0,0:12:31.08,0:12:32.29,Default,,0,0,0,,Сіз таң қалдыңыз ба?
Dialogue: 0,0:12:32.37,0:12:33.21,Default,,0,0,0,,Барт
Dialogue: 0,0:12:33.79,0:12:35.58,Default,,0,0,0,,Оның тікенектері бар.
Dialogue: 0,0:12:35.75,0:12:38.17,Default,,0,0,0,,Осы шыбықтары бар стадион
Dialogue: 0,0:12:38.29,0:12:40.84,Default,,0,0,0,,Арнайы тек Sword Flames жасаған
Dialogue: 0,0:12:40.92,0:12:43.92,Default,,0,0,0,,Оның аты - Арнайы жанып тұрған храм.
Dialogue: 0,0:12:44.18,0:12:46.09,Default,,0,0,0,,Арнайы жанып тұрған храм
Dialogue: 0,0:12:46.30,0:12:49.85,Default,,0,0,0,,Егер би спик аймағына соқса, сізге зақым келеді.
Dialogue: 0,0:12:49.93,0:12:52.52,Default,,0,0,0,,Жарылу мүмкіндігі бірден артады.
Dialogue: 0,0:12:53.06,0:12:54.73,Default,,0,0,0,,Сіз қалай ойлайсыз? Бұл керемет.
Dialogue: 0,0:12:54.81,0:12:55.56,Default,,0,0,0,,Хахаха…
Dialogue: 0,0:12:55.64,0:12:56.98,Default,,0,0,0,,Кәке~
Dialogue: 0,0:12:57.06,0:12:59.44,Default,,0,0,0,,Әй, Шақа, шайқасайық
Dialogue: 0,0:12:59.52,0:13:00.44,Default,,0,0,0,,О, мен мұны істеймін.
Dialogue: 0,0:13:00.52,0:13:03.11,Default,,0,0,0,,Күте тұрыңыз, сіз
Dialogue: 0,0:13:03.19,0:13:04.49,Default,,0,0,0,,Біріншіден, мен қарсыласпын.
Dialogue: 0,0:13:04.57,0:13:05.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:05.91,0:13:07.82,Default,,0,0,0,,Мен Шақаның оң қолымын
Dialogue: 0,0:13:07.91,0:13:10.99,Default,,0,0,0,,Осы клубта Шакамен жекпе-жек өткізгіңіз келсе.
Dialogue: 0,0:13:11.08,0:13:12.91,Default,,0,0,0,,Алдымен мені жең
Dialogue: 0,0:13:13.00,0:13:14.79,Default,,0,0,0,,Бұл суджи
Dialogue: 0,0:13:15.25,0:13:19.17,Default,,0,0,0,,Ой... Жарайды, мен шынымен түсінбеймін.
Dialogue: 0,0:13:19.25,0:13:21.42,Default,,0,0,0,,Мен сатылған жекпе-жекті сатып аламын.
Dialogue: 0,0:13:29.14,0:13:30.39,Default,,0,0,0,,Е... иә!
Dialogue: 0,0:13:38.94,0:13:42.44,Default,,0,0,0,,Югоның бейі - Джегер Йггдрасил
Dialogue: 0,0:13:42.61,0:13:44.15,Default,,0,0,0,,Бұл төзімділік түрі.
Dialogue: 0,0:13:44.36,0:13:46.86,Default,,0,0,0,,Өйткені Валькири шабуыл түрі болып табылады.
Dialogue: 0,0:13:46.95,0:13:48.61,Default,,0,0,0,,тиімді болуы мүмкін
Dialogue: 0,0:13:49.11,0:13:50.66,Default,,0,0,0,,Нансуи Юго
Dialogue: 0,0:13:50.74,0:13:52.91,Default,,0,0,0,,Бұрынғы ұлттық байқауға қатысушылар
Dialogue: 0,0:13:52.99,0:13:54.54,Default,,0,0,0,,Бұл өте күшті!
Dialogue: 0,0:13:54.75,0:13:56.96,Default,,0,0,0,,Және сол стадион
Dialogue: 0,0:13:57.04,0:13:59.21,Default,,0,0,0,,Таныс Нансуимен салыстырғанда
Dialogue: 0,0:13:59.38,0:14:00.42,Default,,0,0,0,,Барт...
Dialogue: 0,0:14:00.67,0:14:04.17,Default,,0,0,0,,Сол тікенектерге тап болма...
Dialogue: 0,0:14:04.26,0:14:05.97,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:06.05,0:14:08.72,Default,,0,0,0,,Мен мұны тиімді деп айта алмаймын.
Dialogue: 0,0:14:08.80,0:14:10.18,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:14:12.60,0:14:13.39,Default,,0,0,0,,О!
Dialogue: 0,0:14:13.76,0:14:15.35,Default,,0,0,0,,Атмосфера жақсы.
Dialogue: 0,0:14:15.43,0:14:17.60,Default,,0,0,0,,Нағыз самурайға ұқсайды
Dialogue: 0,0:14:18.48,0:14:21.27,Default,,0,0,0,,кеттік досым
Dialogue: 0,0:14:21.52,0:14:23.19,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:14:28.11,0:14:29.78,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:14:30.11,0:14:33.33,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:33.78,0:14:35.95,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:38.54,0:14:40.62,Default,,0,0,0,,Валькири Раш ату
Dialogue: 0,0:14:40.71,0:14:43.17,Default,,0,0,0,,Йггдрасил де диагональ бойынша түсірді.
Dialogue: 0,0:14:43.42,0:14:47.17,Default,,0,0,0,,Сіз Валькиридің шабуылдарынан аулақ болуды жоспарлап отырсыз ба?
Dialogue: 0,0:14:47.88,0:14:49.97,Default,,0,0,0,,Юго шығанағы дыбысы
Dialogue: 0,0:14:50.30,0:14:51.84,Default,,0,0,0,,Бұл өте тегіс.
Dialogue: 0,0:14:52.34,0:14:53.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:53.22,0:14:55.31,Default,,0,0,0,,Шынымен... қанша?
Dialogue: 0,0:14:55.39,0:14:57.81,Default,,0,0,0,,Мұзда сырғанау сияқты
Dialogue: 0,0:14:58.56,0:15:00.48,Default,,0,0,0,,Yggdrasil баратын жері қандай?
Dialogue: 0,0:15:00.56,0:15:03.77,Default,,0,0,0,,Пластмассаға қарағанда тайғақ ерекше материалдан жасалған
Dialogue: 0,0:15:04.27,0:15:06.44,Default,,0,0,0,,Еден бетіне төзімділігі аз
Dialogue: 0,0:15:06.65,0:15:08.78,Default,,0,0,0,,Айналу қуатын ұзақ уақыт сақтай алады
Dialogue: 0,0:15:09.53,0:15:12.41,Default,,0,0,0,,Тұрақты шайқас кезінде Валькири қолайсыз жағдайда.
Dialogue: 0,0:15:12.49,0:15:13.70,Default,,0,0,0,,Әй, қарашы
Dialogue: 0,0:15:13.78,0:15:15.66,Default,,0,0,0,,Юго ұйықтап жатыр.
Dialogue: 0,0:15:15.74,0:15:17.41,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:15:17.49,0:15:20.37,Default,,0,0,0,,Бұл тыныштандырады.
Dialogue: 0,0:15:20.46,0:15:22.42,Default,,0,0,0,,Бұл Шәкенжи стилінің негізінің бірі.
Dialogue: 0,0:15:26.42,0:15:30.17,Default,,0,0,0,,Тыныс алу және зейінді жинақтау
Dialogue: 0,0:15:30.76,0:15:33.09,Default,,0,0,0,,Содан кейін бес сезім мүшелеріне ескерту беріледі.
Dialogue: 0,0:15:35.14,0:15:37.31,Default,,0,0,0,,Валькирияның күші әлсіреді
Dialogue: 0,0:15:37.60,0:15:39.89,Default,,0,0,0,,Бар, жүр, Валькири
Dialogue: 0,0:15:42.65,0:15:45.15,Default,,0,0,0,,Мен сенің барлық қимылыңнан бас тарттым.
Dialogue: 0,0:15:45.23,0:15:47.44,Default,,0,0,0,,Yggdrasil сипап өтіңіз
Dialogue: 0,0:15:47.78,0:15:48.44,Default,,0,0,0,,Не!
Dialogue: 0,0:15:48.53,0:15:50.19,Default,,0,0,0,,Қарсы болды
Dialogue: 0,0:15:50.28,0:15:52.40,Default,,0,0,0,,Күте тұрыңыз, бұл өсу аймағы.
Dialogue: 0,0:15:53.11,0:15:54.11,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:15:54.32,0:15:55.45,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:55.57,0:15:57.53,Default,,0,0,0,,(Соқтығыс дыбысы)
Dialogue: 0,0:15:58.20,0:15:59.58,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:16:07.42,0:16:08.63,Default,,0,0,0,,Бұл шайқас болды
Dialogue: 0,0:16:08.71,0:16:11.88,Default,,0,0,0,,Айналдыру аяқталуы Yggdrasil-ге 1 ұпай береді
Dialogue: 0,0:16:12.26,0:16:14.64,Default,,0,0,0,,Спайкты бір рет соғыңыз
Dialogue: 0,0:16:14.72,0:16:16.01,Default,,0,0,0,,Бұл болады ма?
Dialogue: 0,0:16:16.43,0:16:20.02,Default,,0,0,0,,Бірақ мен бұл жарылып бітпегеніне қуаныштымын.
Dialogue: 0,0:16:20.10,0:16:22.85,Default,,0,0,0,,Бір сәт айналу алдымен тоқтады.
Dialogue: 0,0:16:23.44,0:16:25.19,Default,,0,0,0,,Бұл өте жақын айырмашылық.
Dialogue: 0,0:16:25.81,0:16:26.81,Default,,0,0,0,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:16:26.90,0:16:29.40,Default,,0,0,0,,Осы стадионда осылай күресеміз.
Dialogue: 0,0:16:29.98,0:16:30.69,Default,,0,0,0,,Әй
Dialogue: 0,0:16:31.44,0:16:32.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:32.40,0:16:35.11,Default,,0,0,0,,Бұл стадион қызық
Dialogue: 0,0:16:36.03,0:16:37.07,Default,,0,0,0,,Керемет
Dialogue: 0,0:16:37.16,0:16:41.12,Default,,0,0,0,,Тек тікендердің болуы шайқаста осындай айырмашылықты тудыруы мүмкін.
Dialogue: 0,0:16:41.20,0:16:42.87,Default,,0,0,0,,Бұл масақ емес, бұл масақ.
Dialogue: 0,0:16:43.33,0:16:45.50,Default,,0,0,0,,Сен де дәл қазір таң қалдырдың.
Dialogue: 0,0:16:45.58,0:16:48.50,Default,,0,0,0,,«Мен бас тарттым!» Мен де жаттыққанда.
Dialogue: 0,0:16:48.59,0:16:51.38,Default,,0,0,0,,Сіз осындай нәрсені жасауға дайынсыз ба?
Dialogue: 0,0:16:51.46,0:16:52.92,Default,,0,0,0,,100 жыл бұрын
Dialogue: 0,0:16:53.01,0:16:54.43,Default,,0,0,0,,Сонымен, жақын.
Dialogue: 0,0:16:54.51,0:16:56.09,Default,,0,0,0,,Жарайды, кет.
Dialogue: 0,0:16:56.43,0:16:59.39,Default,,0,0,0,,Ей, бұл екінші шайқас.
Dialogue: 0,0:16:59.81,0:17:00.81,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:17:00.89,0:17:02.18,Default,,0,0,0,,Келесі! Келесі!
Dialogue: 0,0:17:02.27,0:17:04.23,Default,,0,0,0,,Келесі жолы мен жеңілмеймін
Dialogue: 0,0:17:04.31,0:17:06.31,Default,,0,0,0,,Қарашы, Юго.
Dialogue: 0,0:17:07.15,0:17:07.98,Default,,0,0,0,,Ха!
Dialogue: 0,0:17:13.57,0:17:17.11,Default,,0,0,0,,Осы стадионда жинақталған тәжірибені ескере отырып
Dialogue: 0,0:17:17.20,0:17:19.49,Default,,0,0,0,,Бірінші шайқас табиғи нәтиже ме?
Dialogue: 0,0:17:20.74,0:17:22.16,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:17:22.24,0:17:24.79,Default,,0,0,0,,Бұл алдыңғы сәйкестікті қалай пайдаланатыныңызға байланысты.
Dialogue: 0,0:17:25.12,0:17:26.87,Default,,0,0,0,,Балт не істеуі керек?
Dialogue: 0,0:17:27.33,0:17:28.54,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:17:31.09,0:17:34.01,Default,,0,0,0,,Барто Аои, сіз ұстай алмайтын жігіт.
Dialogue: 0,0:17:34.09,0:17:35.59,Default,,0,0,0,,Бірақ келесі жолы
Dialogue: 0,0:17:35.67,0:17:37.93,Default,,0,0,0,,Мен оны міндетті түрде жарып жіберемін
Dialogue: 0,0:17:42.39,0:17:43.22,Default,,0,0,0,,Ах
Dialogue: 0,0:17:43.89,0:17:46.27,Default,,0,0,0,,Жарайды, қолданып көргің келе ме?
Dialogue: 0,0:17:46.35,0:17:48.31,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:17:48.69,0:17:51.82,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:51.90,0:17:53.03,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:17:53.11,0:17:53.86,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:17:53.94,0:17:54.94,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:17:57.49,0:17:59.66,Default,,0,0,0,,Yggdrasil түсіру
Dialogue: 0,0:17:59.74,0:18:01.08,Default,,0,0,0,,Дәл бұрынғыдай
Dialogue: 0,0:18:01.53,0:18:04.04,Default,,0,0,0,,Сонымен стратегияны өзгертудің қажеті жоқ па?
Dialogue: 0,0:18:04.12,0:18:06.54,Default,,0,0,0,,Анярой аты Ягатте
Dialogue: 0,0:18:06.87,0:18:08.79,Default,,0,0,0,,Қазір Валькирия!
Dialogue: 0,0:18:10.00,0:18:11.54,Default,,0,0,0,,Қанша рет қолдансаңыз да, бірдей нәрсе
Dialogue: 0,0:18:11.63,0:18:13.55,Default,,0,0,0,,Додж! Yggdrasil
Dialogue: 0,0:18:15.92,0:18:18.26,Default,,0,0,0,,Жарық түсіру
Dialogue: 0,0:18:18.47,0:18:21.64,Default,,0,0,0,,Оны сипап өтіңіз.
Dialogue: 0,0:18:26.81,0:18:27.64,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:18:28.48,0:18:30.35,Default,,0,0,0,,Yggdrasil-ді қайта құрыңыз!
Dialogue: 0,0:18:33.11,0:18:36.69,Default,,0,0,0,,Шынайы жарқыл түсіру
Dialogue: 0,0:18:41.28,0:18:42.74,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:18:46.95,0:18:48.50,Default,,0,0,0,,Сәйкестік болды!
Dialogue: 0,0:18:48.83,0:18:49.79,Default,,0,0,0,,Валькирия
Dialogue: 0,0:18:49.87,0:18:52.46,Default,,0,0,0,,2 ұпай
Dialogue: 0,0:18:52.79,0:18:54.21,Default,,0,0,0,,Екіден бірге
Dialogue: 0,0:18:54.29,0:18:55.75,Default,,0,0,0,,Аои Балттың жеңісі
Dialogue: 0,0:18:55.84,0:18:57.21,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:57.55,0:19:00.80,Default,,0,0,0,,Бұл спайк пен шынайы жарқылдың тіркесімі ме?
Dialogue: 0,0:19:00.88,0:19:02.76,Default,,0,0,0,,Жақсы идея.
Dialogue: 0,0:19:02.85,0:19:05.10,Default,,0,0,0,,Бұл да үлкен жетістік болды.
Dialogue: 0,0:19:05.56,0:19:07.18,Default,,0,0,0,,Өйткені ол Бал-нии.
Dialogue: 0,0:19:07.89,0:19:09.48,Default,,0,0,0,,Үлкен аға керемет
Dialogue: 0,0:19:10.14,0:19:10.89,Default,,0,0,0,,Әй
Dialogue: 0,0:19:11.19,0:19:13.98,Default,,0,0,0,,Шынымен де, ештеңе өзгерген жоқ.
Dialogue: 0,0:19:14.48,0:19:16.57,Default,,0,0,0,,Эй!
Dialogue: 0,0:19:17.94,0:19:21.16,Default,,0,0,0,,Ей! сәуле!
Dialogue: 0,0:19:21.24,0:19:24.07,Default,,0,0,0,,Сәттілік, Барто, тағы біраз!
Dialogue: 0,0:19:24.16,0:19:25.24,Default,,0,0,0,,Ах
Dialogue: 0,0:19:25.33,0:19:26.20,Default,,0,0,0,,Эй!
Dialogue: 0,0:19:28.50,0:19:29.75,Default,,0,0,0,,Ааах!
Dialogue: 0,0:19:29.83,0:19:31.21,Default,,0,0,0,,Мен мұны істедім
Dialogue: 0,0:19:31.29,0:19:33.83,Default,,0,0,0,,Ия, иә, иә!
Dialogue: 0,0:19:34.17,0:19:35.29,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:19:35.71,0:19:37.92,Default,,0,0,0,,Жақсы сәйкестік көрсетілді.
Dialogue: 0,0:19:38.01,0:19:38.71,Default,,0,0,0,,Олардың екеуі
Dialogue: 0,0:19:38.92,0:19:39.92,Default,,0,0,0,,Хе...
Dialogue: 0,0:19:40.01,0:19:40.80,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:41.38,0:19:42.34,Default,,0,0,0,,Өкінішті
Dialogue: 0,0:19:43.34,0:19:44.51,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:19:44.64,0:19:46.31,Default,,0,0,0,,Келесі - Шакамен.
Dialogue: 0,0:19:46.56,0:19:48.39,Default,,0,0,0,,Тез орындайық
Dialogue: 0,0:19:48.47,0:19:49.89,Default,,0,0,0,,Тез, тез~
Dialogue: 0,0:19:49.98,0:19:50.52,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:19:50.60,0:19:51.14,Default,,0,0,0,,Тез, тез
Dialogue: 0,0:19:51.23,0:19:52.48,Default,,0,0,0,,Ол көңілді жігіт.
Dialogue: 0,0:19:53.23,0:19:54.52,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:19:57.69,0:19:59.99,Default,,0,0,0,,Бар-нии бақытты көрінеді.
Dialogue: 0,0:20:00.07,0:20:02.49,Default,,0,0,0,,Иә, Шақа да.
Dialogue: 0,0:20:02.82,0:20:06.24,Default,,0,0,0,,Мен сіздің ең жақын досыңыз болғаныма қуаныштымын, Балто.
Dialogue: 0,0:20:07.03,0:20:09.79,Default,,0,0,0,,Бірақ матчта бұл маңызды емес.
Dialogue: 0,0:20:10.29,0:20:13.21,Default,,0,0,0,,Бұл менің Bay Xeno Excovery.
Dialogue: 0,0:20:14.75,0:20:16.17,Default,,0,0,0,,О!
Dialogue: 0,0:20:16.25,0:20:17.79,Default,,0,0,0,,Салқын шығанақ
Dialogue: 0,0:20:17.88,0:20:20.51,Default,,0,0,0,,Ол қылышпен келеді. Керемет көрінеді.
Dialogue: 0,0:20:20.71,0:20:22.51,Default,,0,0,0,,Қылыштың сол бөлігі
Dialogue: 0,0:20:22.59,0:20:25.47,Default,,0,0,0,,Жалғыз жүзге айналып, қарсыласыңызға шабуыл жасаңыз.
Dialogue: 0,0:20:26.01,0:20:27.51,Default,,0,0,0,,Бір нүктеге шоғырлану
Dialogue: 0,0:20:27.60,0:20:31.85,Default,,0,0,0,,Максималды қуатты күшті дисперсиясыз алуға болады.
Dialogue: 0,0:20:32.98,0:20:34.23,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:20:34.60,0:20:35.85,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:37.19,0:20:38.40,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:38.57,0:20:40.69,Default,,0,0,0,,Іске қосу құралы...?
Dialogue: 0,0:20:42.28,0:20:45.36,Default,,0,0,0,,Мұны тек Шәке ғана меңгереді дейді...
Dialogue: 0,0:20:45.45,0:20:46.99,Default,,0,0,0,,Бұл қылыш ұшыру құралы.
Dialogue: 0,0:20:47.12,0:20:49.99,Default,,0,0,0,,Керемет~ Бұл іске қосу құрылғысы
Dialogue: 0,0:20:50.08,0:20:52.25,Default,,0,0,0,,Оны қалай пайдаланамын? Эй, эй
Dialogue: 0,0:20:52.45,0:20:53.87,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:20:53.96,0:20:55.42,Default,,0,0,0,,Асықпаңыз
Dialogue: 0,0:20:55.50,0:20:57.04,Default,,0,0,0,,Мен сізге бірден көрсетемін
Dialogue: 0,0:21:01.13,0:21:03.22,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:21:03.80,0:21:06.84,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:21:07.22,0:21:09.35,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:21:09.43,0:21:10.31,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:21:19.86,0:21:21.02,Default,,0,0,0,,(шығанақтың құлау дыбысы)
Dialogue: 0,0:21:21.48,0:21:22.78,Default,,0,0,0,,А...
Dialogue: 0,0:21:24.70,0:21:25.86,Default,,0,0,0,,Жарыс бар
Dialogue: 0,0:21:26.07,0:21:27.28,Default,,0,0,0,,Экскалибур
Dialogue: 0,0:21:27.36,0:21:29.32,Default,,0,0,0,,Артық мәре үшін 1 ұпай
Dialogue: 0,0:21:30.20,0:21:32.62,Default,,0,0,0,,... тым ерте
Dialogue: 0,0:21:32.70,0:21:35.00,Default,,0,0,0,,Сіз әлі көзіңізді жұмған жоқсыз.
Dialogue: 0,0:21:35.83,0:21:37.79,Default,,0,0,0,,Бұл күшті соққы.
Dialogue: 0,0:21:37.92,0:21:39.88,Default,,0,0,0,,Сен мұндай биді жеңе аласың ба?
Dialogue: 0,0:21:40.38,0:21:43.21,Default,,0,0,0,,Бұл Xeno Excalibur
Dialogue: 0,0:21:43.42,0:21:45.47,Default,,0,0,0,,Уау... керемет
Dialogue: 0,0:21:45.55,0:21:48.26,Default,,0,0,0,,Керемет Экскалибур
Dialogue: 0,0:22:09.24,0:22:15.33,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.54,0:22:21.67,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.13,0:22:27.67,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.13,0:22:31.47,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.64,0:22:36.56,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.48,0:22:41.19,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.27,0:22:44.48,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.57,0:22:50.91,Default,,0,0,0,,Артынан қусаң көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:51.16,0:22:56.70,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.87,0:23:03.46,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.04,0:23:09.47,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.63,0:23:12.80,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.30,0:23:17.27,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.65,0:23:29.40,Default,,0,0,0,,Шақа балабақшадан бері ғажап.
Dialogue: 0,0:23:29.49,0:23:32.57,Default,,0,0,0,,Барған сайын үлкейіп барады, күші де ғажап.
Dialogue: 0,0:23:32.66,0:23:34.87,Default,,0,0,0,,Шақаның мықтылығының сырын біл
Dialogue: 0,0:23:34.95,0:23:37.58,Default,,0,0,0,,Сонда мен де міндетті түрде күшті боламын.
Dialogue: 0,0:23:37.66,0:23:40.21,Default,,0,0,0,,Жанып тұрған ғибадатхана Доджо қылыш жалындары
Dialogue: 0,0:23:40.29,0:23:42.08,Default,,0,0,0,,Оны қабылдаңыз!
Dialogue: 0,0:23:42.17,0:23:44.17,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:44.25,0:23:45.84,Default,,0,0,0,,Құдіретті Экскалибур!
Dialogue: 0,0:23:46.21,0:23:48.00,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.09,0:23:49.97,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.47,0:23:57.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory