Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.13,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.21,0:00:12.47,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.55,0:00:14.76,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:17.01,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.10,0:00:18.93,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.35,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.31,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.40,0:00:28.69,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.28,0:00:32.69,Default,,0,0,0,,Haha~n
Dialogue: 0,0:00:32.94,0:00:35.95,Default,,0,0,0,,Айналамда жұлдыздар жымыңдайды
Dialogue: 0,0:00:36.78,0:00:39.08,Default,,0,0,0,,Біртүрлі әуенді тыңдау кезінде
Dialogue: 0,0:00:41.04,0:00:44.08,Default,,0,0,0,,Тағдырдың үнсіз дөңгелегі
Dialogue: 0,0:00:44.16,0:00:46.12,Default,,0,0,0,,Шабуыл жасай беріңіз!
Dialogue: 0,0:00:46.25,0:00:48.38,Default,,0,0,0,,Әй, сенің көздерің
Dialogue: 0,0:00:49.25,0:00:51.76,Default,,0,0,0,,Келесі супер кумир - мен
Dialogue: 0,0:00:52.21,0:00:54.92,Default,,0,0,0,,Махаббат пен жеңіс раушан гүлдерін ұсыну
Dialogue: 0,0:00:57.30,0:01:00.22,Default,,0,0,0,,Бұл сізге арналған өлең
Dialogue: 0,0:01:01.35,0:01:04.06,Default,,0,0,0,,Кя~!
Dialogue: 0,0:01:04.31,0:01:06.98,Default,,0,0,0,,Зак, ол сондай күшті.
Dialogue: 0,0:01:07.06,0:01:08.06,Default,,0,0,0,,О
Dialogue: 0,0:01:08.40,0:01:09.81,Default,,0,0,0,,Бүгін де арнайы дайындық~
Dialogue: 0,0:01:10.02,0:01:12.03,Default,,0,0,0,,Үлкен аға, сен қатты толқыдың~
Dialogue: 0,0:01:12.11,0:01:14.28,Default,,0,0,0,,Көңіл көтеру деген болмайды.
Dialogue: 0,0:01:14.36,0:01:16.49,Default,,0,0,0,,Бұл кәдімгі Балто.
Dialogue: 0,0:01:17.07,0:01:20.53,Default,,0,0,0,,Бәріміз екінші айналымға жаттығу жасайық!
Dialogue: 0,0:01:20.62,0:01:22.49,Default,,0,0,0,,(Тікұшақтың ұшу дыбысы)
Dialogue: 0,0:01:22.58,0:01:23.29,Default,,0,0,0,,Не?
Dialogue: 0,0:01:23.45,0:01:24.58,Default,,0,0,0,,Яғни
Dialogue: 0,0:01:24.75,0:01:28.63,Default,,0,0,0,,Республикалық турнирде командалық жарыстың бірінші кезеңінен кейін жаттығатынмын.
Dialogue: 0,0:01:28.88,0:01:32.30,Default,,0,0,0,,Біздің алдымызда Бейблейд маскасы пайда болды.
Dialogue: 0,0:01:35.63,0:01:38.47,Default,,0,0,0,,Киран
Dialogue: 0,0:01:46.81,0:01:49.19,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:49.52,0:01:54.69,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:02:06.00,0:02:09.37,Default,,0,0,0,,Мен барлығында бар екеніне сенімдімін.
Dialogue: 0,0:02:09.87,0:02:12.00,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:02:12.42,0:02:16.55,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:16.67,0:02:19.88,Default,,0,0,0,,Дұрыс, бетпе-бет.
Dialogue: 0,0:02:20.01,0:02:26.43,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:26.72,0:02:31.15,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:31.65,0:02:37.07,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:37.19,0:02:39.45,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:39.53,0:02:44.24,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:44.41,0:02:49.50,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:49.79,0:02:52.04,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:52.25,0:02:54.59,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:54.88,0:02:58.80,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:58.97,0:03:03.97,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:03:04.18,0:03:06.35,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:10.14,0:03:12.40,Default,,0,0,0,,Жан түршігерлік циклон!
Dialogue: 0,0:03:13.98,0:03:16.77,Default,,0,0,0,,(қону дыбысы)
Dialogue: 0,0:03:16.86,0:03:20.36,Default,,0,0,0,,Бейблейд қуанышын балаларға жеткіземін.
Dialogue: 0,0:03:20.45,0:03:22.16,Default,,0,0,0,,Әділет елшісі
Dialogue: 0,0:03:22.45,0:03:24.32,Default,,0,0,0,,Бейблейд маскасы
Dialogue: 0,0:03:24.91,0:03:26.28,Default,,0,0,0,,Na~is
Dialogue: 0,0:03:26.87,0:03:28.33,Default,,0,0,0,,Бұл тек қана достық теннис матчы.
Dialogue: 0,0:03:28.41,0:03:29.83,Default,,0,0,0,,Мен оны естігім келеді
Dialogue: 0,0:03:30.16,0:03:31.66,Default,,0,0,0,,Сол мыңжапырақ
Dialogue: 0,0:03:31.79,0:03:33.58,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:03:34.17,0:03:36.63,Default,,0,0,0,,Мен түс көріп тұрмын ба?
Dialogue: 0,0:03:36.75,0:03:38.38,Default,,0,0,0,,Жарқыраған
Dialogue: 0,0:03:40.05,0:03:42.05,Default,,0,0,0,,Циллион Зевс тыңдамайды
Dialogue: 0,0:03:44.64,0:03:45.72,Default,,0,0,0,,Салмақ жүргізушісі
Dialogue: 0,0:03:46.05,0:03:46.97,Default,,0,0,0,,Жақсы жұмыс
Dialogue: 0,0:03:47.81,0:03:49.10,Default,,0,0,0,,Ааа~
Dialogue: 0,0:03:49.18,0:03:50.68,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:03:55.23,0:03:56.65,Default,,0,0,0,,Хмм?
Dialogue: 0,0:03:57.11,0:04:00.65,Default,,0,0,0,,Түсіңізде пайда болған Бейблейд маскасы?
Dialogue: 0,0:04:01.15,0:04:02.28,Default,,0,0,0,,Әй
Dialogue: 0,0:04:02.36,0:04:06.53,Default,,0,0,0,,Бұл сіз үшін арман сияқты болған шығар.
Dialogue: 0,0:04:06.91,0:04:09.54,Default,,0,0,0,,Керемет! Бұл өте шынайы арман
Dialogue: 0,0:04:09.87,0:04:12.79,Default,,0,0,0,,Менің ұйықтағым келмейді.
Dialogue: 0,0:04:12.87,0:04:14.50,Default,,0,0,0,,Бал-нии, №.
Dialogue: 0,0:04:14.58,0:04:15.58,Default,,0,0,0,,Мұндай жерде дүкен ашу—
Dialogue: 0,0:04:15.92,0:04:19.63,Default,,0,0,0,,Бейблейд маскасы Сол кезден бастап шайқасты жалғастырайық.
Dialogue: 0,0:04:19.71,0:04:21.01,Default,,0,0,0,,Балтодан құтылыңыз
Dialogue: 0,0:04:21.09,0:04:21.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:21.88,0:04:23.30,Default,,0,0,0,,У-мен жарысу
Dialogue: 0,0:04:23.68,0:04:27.26,Default,,0,0,0,,Анау қарғыс атқыр аузын мықтап жауып қойыпты.
Dialogue: 0,0:04:27.35,0:04:28.55,Default,,0,0,0,,Haha~n
Dialogue: 0,0:04:28.64,0:04:31.60,Default,,0,0,0,,Сіздің мінезіңіз әлі жазылмаған сияқты.
Dialogue: 0,0:04:31.93,0:04:35.02,Default,,0,0,0,,Жеңіске жеткенің үшін үлкен шу шығарма.
Dialogue: 0,0:04:35.10,0:04:37.65,Default,,0,0,0,,Вакия Мен біріншімін.
Dialogue: 0,0:04:37.73,0:04:38.86,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:38.94,0:04:42.07,Default,,0,0,0,,Бұл жауынгерлік рух жақсы
Dialogue: 0,0:04:42.15,0:04:44.20,Default,,0,0,0,,Мотивацияланған адам және сенімді адам
Dialogue: 0,0:04:44.28,0:04:47.49,Default,,0,0,0,,Мен сен сияқты қылшықтарды жақсы көремін.
Dialogue: 0,0:04:48.32,0:04:50.45,Default,,0,0,0,,Қасымда болсаң мен де ұрысамын.
Dialogue: 0,0:04:50.54,0:04:52.16,Default,,0,0,0,,Әрине мен де.
Dialogue: 0,0:04:52.25,0:04:55.33,Default,,0,0,0,,Бәрің аңғалсыңдар
Dialogue: 0,0:04:55.42,0:04:58.04,Default,,0,0,0,,Командалық шайқаста төбелессек жақсы болар еді.
Dialogue: 0,0:04:58.33,0:04:59.54,Default,,0,0,0,,Командалық шайқас?
Dialogue: 0,0:05:00.13,0:05:02.01,Default,,0,0,0,,Менің супер жұлдыздарым
Dialogue: 0,0:05:02.09,0:05:05.51,Default,,0,0,0,,Бұл В блогы, сондықтан финалға өтсеңіз, сіз жеңесіз.
Dialogue: 0,0:05:05.84,0:05:08.68,Default,,0,0,0,,Бейблейд маскасы турнирде жоқ, солай ма?
Dialogue: 0,0:05:08.89,0:05:09.89,Default,,0,0,0,,Бал аға
Dialogue: 0,0:05:09.97,0:05:11.35,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:05:11.68,0:05:13.35,Default,,0,0,0,,Se-no
Dialogue: 0,0:05:13.68,0:05:15.14,Default,,0,0,0,,Ауырды!
Dialogue: 0,0:05:15.35,0:05:17.56,Default,,0,0,0,,Бұл арман емес
Dialogue: 0,0:05:18.48,0:05:20.19,Default,,0,0,0,,Маскаңызды шешіңіз.
Dialogue: 0,0:05:20.90,0:05:23.15,Default,,0,0,0,,Барлық жанкүйерлер байқайды.
Dialogue: 0,0:05:23.36,0:05:25.28,Default,,0,0,0,,Бұл қазірдің өзінде байқалды.
Dialogue: 0,0:05:25.61,0:05:26.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:31.41,0:05:32.37,Default,,0,0,0,,Haha~n
Dialogue: 0,0:05:32.45,0:05:35.37,Default,,0,0,0,,Мен ерекшеленбеймін.
Dialogue: 0,0:05:35.46,0:05:38.42,Default,,0,0,0,,Бейблейдтің махаббат пен әділет маскасы
Dialogue: 0,0:05:38.50,0:05:40.67,Default,,0,0,0,,Бірақ оның шынайы тұлғасы қандай?
Dialogue: 0,0:05:40.92,0:05:42.25,Default,,0,0,0,,Та-да!
Dialogue: 0,0:05:42.71,0:05:45.47,Default,,0,0,0,,Зак Күн сәулесі
Dialogue: 0,0:05:45.67,0:05:48.51,Default,,0,0,0,,Өйткені, бұл Зак мырза.
Dialogue: 0,0:05:49.64,0:05:51.89,Default,,0,0,0,,Бейблейд маскасы...
Dialogue: 0,0:05:51.97,0:05:54.10,Default,,0,0,0,,Бұл Зак, Төрт императордың бірі.
Dialogue: 0,0:05:55.06,0:05:57.10,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:00.10,0:06:02.40,Default,,0,0,0,,Шынымды айтсам, сіз мұны енді ғана түсіндіңіз бе?
Dialogue: 0,0:06:02.86,0:06:04.07,Default,,0,0,0,,Иә
Dialogue: 0,0:06:05.32,0:06:09.53,Default,,0,0,0,,Бүгін мен сені кешке шақыруға келдім.
Dialogue: 0,0:06:10.16,0:06:12.70,Default,,0,0,0,,Барлығы менің концерттік орнымда
Dialogue: 0,0:06:12.78,0:06:14.54,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:06:18.37,0:06:20.71,Default,,0,0,0,,Барлығы көңілді ме?
Dialogue: 0,0:06:21.67,0:06:24.05,Default,,0,0,0,,Осыдан кейін, концерт біткенде
Dialogue: 0,0:06:24.13,0:06:28.34,Default,,0,0,0,,Сіздерге тосын сыйымыз бар, сондықтан күтіңіздер!
Dialogue: 0,0:06:28.42,0:06:29.76,Default,,0,0,0,,Haha~n
Dialogue: 0,0:06:31.59,0:06:32.68,Default,,0,0,0,,Керемет!
Dialogue: 0,0:06:32.76,0:06:33.68,Default,,0,0,0,,О!
Dialogue: 0,0:06:34.56,0:06:36.72,Default,,0,0,0,,Әртүрлі дүңгіршектер бар.
Dialogue: 0,0:06:37.18,0:06:39.23,Default,,0,0,0,,Оны еркін жеуге болады.
Dialogue: 0,0:06:39.31,0:06:41.35,Default,,0,0,0,,Кумир жұлдызынан күткендей
Dialogue: 0,0:06:41.60,0:06:44.15,Default,,0,0,0,,Ах, могу, могу...
Dialogue: 0,0:06:44.48,0:06:47.36,Default,,0,0,0,,Умина мына спагетти
Dialogue: 0,0:06:47.44,0:06:49.53,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:06:51.49,0:06:54.49,Default,,0,0,0,,Мен тамақ жейтін адамның қолына түскім келмейді.
Dialogue: 0,0:06:54.58,0:06:58.87,Default,,0,0,0,,Хахахаха... Шуу осында ғой.
Dialogue: 0,0:06:59.50,0:07:03.50,Default,,0,0,0,,Кейінірек Зак маған бір ғажайып нәрсе көрсеткісі келетінін айтты.
Dialogue: 0,0:07:04.21,0:07:05.59,Default,,0,0,0,,Бұл таңқаларлық емес пе?
Dialogue: 0,0:07:06.34,0:07:08.38,Default,,0,0,0,,Бұл керемет болуы керек.
Dialogue: 0,0:07:08.46,0:07:10.09,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:07:10.17,0:07:11.38,Default,,0,0,0,,О
Dialogue: 0,0:07:12.26,0:07:17.89,Default,,0,0,0,,(Орында музыка ойналады)
Dialogue: 0,0:07:29.61,0:07:31.36,Default,,0,0,0,,Кеттік, Кумичо!
Dialogue: 0,0:07:31.57,0:07:33.32,Default,,0,0,0,,Сәлем Балто!
Dialogue: 0,0:07:33.53,0:07:35.41,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:07:35.74,0:07:38.33,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:38.66,0:07:41.37,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:15.28,0:08:16.53,Default,,0,0,0,,Haha~n
Dialogue: 0,0:08:16.62,0:08:19.08,Default,,0,0,0,,Бүгінгі арнайы қонақ
Dialogue: 0,0:08:19.16,0:08:22.12,Default,,0,0,0,,Олардың өтетін орынға келетін уақыты келді.
Dialogue: 0,0:08:22.21,0:08:23.87,Default,,0,0,0,,Арнайы қонақ?
Dialogue: 0,0:08:23.96,0:08:25.21,Default,,0,0,0,,Қызық, бұл кім?
Dialogue: 0,0:08:25.29,0:08:26.50,Default,,0,0,0,,Fun
Dialogue: 0,0:08:26.92,0:08:28.04,Default,,0,0,0,,Қонақтарды таныстыру
Dialogue: 0,0:08:28.13,0:08:30.51,Default,,0,0,0,,Анами дикторы Кеттік!
Dialogue: 0,0:08:30.59,0:08:31.67,Default,,0,0,0,,Жарайды Зак.
Dialogue: 0,0:08:31.76,0:08:34.88,Default,,0,0,0,,Мен микрофонды алдым. Маған қалдырыңыз.
Dialogue: 0,0:08:34.97,0:08:38.26,Default,,0,0,0,,Ұлдар мен қыздар Теңізге назар аударыңыздар!
Dialogue: 0,0:08:38.35,0:08:41.02,Default,,0,0,0,,Бұл теңізден келген адам
Dialogue: 0,0:08:41.10,0:08:43.06,Default,,0,0,0,,Бейблейдтің төрт императорының бірі
Dialogue: 0,0:08:43.14,0:08:45.56,Default,,0,0,0,,қатарынан 4 ұлттық турнирде жеңіске жетуді жалғастыру
Dialogue: 0,0:08:45.65,0:08:47.56,Default,,0,0,0,,Қауіп ретінде жеңілмейтін мифті жасады
Dialogue: 0,0:08:47.77,0:08:50.40,Default,,0,0,0,,Легенда Жеңілмейтін адам
Dialogue: 0,0:08:50.48,0:08:53.03,Default,,0,0,0,,Ширасаги сарайы Луис!
Dialogue: 0,0:08:53.11,0:08:57.07,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:57.57,0:08:58.95,Default,,0,0,0,,Ширасаги сарайы...?
Dialogue: 0,0:08:59.03,0:09:01.41,Default,,0,0,0,,Өткен республикалық турнирде жекелей сында
Dialogue: 0,0:09:01.49,0:09:03.96,Default,,0,0,0,,Ол финалда Шу-кунмен жекпе-жекке шыққан.
Dialogue: 0,0:09:04.04,0:09:05.92,Default,,0,0,0,,Шу-кунды кім жеңді?
Dialogue: 0,0:09:06.96,0:09:08.38,Default,,0,0,0,,Ол...
Dialogue: 0,0:09:17.64,0:09:18.72,Default,,0,0,0,,Желдей жылдам шабуыл!
Dialogue: 0,0:09:19.51,0:09:21.39,Default,,0,0,0,,Ширасаги сарайы Луис
Dialogue: 0,0:09:22.06,0:09:24.52,Default,,0,0,0,,Луи, сахнаға шық.
Dialogue: 0,0:09:24.60,0:09:25.43,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:09:27.06,0:09:28.06,Default,,0,0,0,,Әй?
Dialogue: 0,0:09:30.06,0:09:31.40,Default,,0,0,0,,Ол
Dialogue: 0,0:09:31.48,0:09:32.69,Default,,0,0,0,,Шуды жеңдім...
Dialogue: 0,0:09:33.94,0:09:34.99,Default,,0,0,0,,Бал аға
Dialogue: 0,0:09:35.07,0:09:35.99,Default,,0,0,0,,Қауіпті
Dialogue: 0,0:09:36.07,0:09:38.28,Default,,0,0,0,,Ой... ау
Dialogue: 0,0:09:42.08,0:09:42.91,Default,,0,0,0,,Ол ұшты ма?
Dialogue: 0,0:09:48.29,0:09:50.29,Default,,0,0,0,,Шуды жеңу
Dialogue: 0,0:09:50.50,0:09:52.21,Default,,0,0,0,,Сіз кереметсіз
Dialogue: 0,0:09:53.50,0:09:55.38,Default,,0,0,0,,Мм, әрине.
Dialogue: 0,0:09:55.72,0:09:57.93,Default,,0,0,0,,Қанша талпынсам да жеңемін.
Dialogue: 0,0:09:58.26,0:10:00.09,Default,,0,0,0,,Қарсылас кім болса да
Dialogue: 0,0:10:00.76,0:10:02.60,Default,,0,0,0,,Ширасаги сарайы Луис
Dialogue: 0,0:10:02.68,0:10:04.18,Default,,0,0,0,,Келесі жолы мен жеңемін
Dialogue: 0,0:10:04.85,0:10:07.02,Default,,0,0,0,,Болашақ шешілді
Dialogue: 0,0:10:07.77,0:10:09.35,Default,,0,0,0,,Болашақ туралы не деуге болады?
Dialogue: 0,0:10:10.65,0:10:12.40,Default,,0,0,0,,Ешкім білмейді
Dialogue: 0,0:10:13.15,0:10:13.90,Default,,0,0,0,,Хун
Dialogue: 0,0:10:14.32,0:10:15.15,Default,,0,0,0,,Ха...
Dialogue: 0,0:10:17.99,0:10:18.61,Default,,0,0,0,,Ах
Dialogue: 0,0:10:21.37,0:10:23.49,Default,,0,0,0,,Менің ойымша, ол бұрынғыдан күштірек.
Dialogue: 0,0:10:24.62,0:10:25.95,Default,,0,0,0,,Әрине.
Dialogue: 0,0:10:27.00,0:10:30.12,Default,,0,0,0,,Мен бұл сенімді жоямын
Dialogue: 0,0:10:30.37,0:10:31.38,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:31.58,0:10:33.13,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:10:33.34,0:10:35.80,Default,,0,0,0,,Мен келесі турнирге қатысамын.
Dialogue: 0,0:10:35.88,0:10:37.59,Default,,0,0,0,,Жанып тұрған ғибадатхана Кайза
Dialogue: 0,0:10:37.67,0:10:40.59,Default,,0,0,0,,Сіз мені аздап көңіл көтересіз, солай ма?
Dialogue: 0,0:10:41.22,0:10:43.76,Default,,0,0,0,,Сіз мұны қазір жасай аласыз.
Dialogue: 0,0:10:44.51,0:10:45.85,Default,,0,0,0,,Тоқта
Dialogue: 0,0:10:45.93,0:10:49.64,Default,,0,0,0,,Балалар, мені елеусіз қалдырып, қобалжуға болмайды.
Dialogue: 0,0:10:49.73,0:10:51.77,Default,,0,0,0,,Әрине, мен бұл жолы жеңемін
Dialogue: 0,0:10:52.48,0:10:53.90,Default,,0,0,0,,Өйткені бұл менмін
Dialogue: 0,0:10:55.11,0:10:56.40,Default,,0,0,0,,Na~is
Dialogue: 0,0:10:56.69,0:10:58.32,Default,,0,0,0,,Трансформацияланған төрт император
Dialogue: 0,0:10:58.40,0:11:00.15,Default,,0,0,0,,Бұл рухтардың қақтығысы
Dialogue: 0,0:11:00.53,0:11:02.37,Default,,0,0,0,,Ах... ғажап
Dialogue: 0,0:11:02.45,0:11:04.58,Default,,0,0,0,,Ах! Бұл керемет
Dialogue: 0,0:11:05.62,0:11:06.79,Default,,0,0,0,,Мен туралы бірдеңе
Dialogue: 0,0:11:06.87,0:11:08.54,Default,,0,0,0,,Ол жанып тұр
Dialogue: 0,0:11:10.16,0:11:12.71,Default,,0,0,0,,Бүгінгі басты оқиға
Dialogue: 0,0:11:12.79,0:11:15.25,Default,,0,0,0,,Музыканың басталуы
Dialogue: 0,0:11:36.90,0:11:38.82,Default,,0,0,0,,Стадионның ортасы
Dialogue: 0,0:11:38.90,0:11:40.49,Default,,0,0,0,,Айналып жатыр
Dialogue: 0,0:11:47.95,0:11:49.66,Default,,0,0,0,,Ой! ...және
Dialogue: 0,0:11:49.75,0:11:50.66,Default,,0,0,0,,О~
Dialogue: 0,0:11:50.75,0:11:52.04,Default,,0,0,0,,Na~is
Dialogue: 0,0:11:52.12,0:11:55.33,Default,,0,0,0,,Бұл Cyclone Bay стадионы.
Dialogue: 0,0:11:57.38,0:11:58.84,Default,,0,0,0,,О!
Dialogue: 0,0:12:01.88,0:12:04.34,Default,,0,0,0,,Орталықтағы айналатын диск айналады.
Dialogue: 0,0:12:04.43,0:12:06.18,Default,,0,0,0,,Бұл жай ғана циклон.
Dialogue: 0,0:12:06.51,0:12:08.14,Default,,0,0,0,,Циклон дегеніміз не?
Dialogue: 0,0:12:08.22,0:12:10.10,Default,,0,0,0,,Бұл тайфун сияқты ма?
Dialogue: 0,0:12:10.43,0:12:12.94,Default,,0,0,0,,Орталық айналып тұр
Dialogue: 0,0:12:13.14,0:12:14.06,Default,,0,0,0,,О
Dialogue: 0,0:12:14.40,0:12:16.44,Default,,0,0,0,,Демек, бұл циклон?
Dialogue: 0,0:12:16.52,0:12:17.98,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:12:18.07,0:12:20.78,Default,,0,0,0,,Бұл Бейдің қимылдарын болжау мүмкін емес.
Dialogue: 0,0:12:21.57,0:12:23.15,Default,,0,0,0,,Қандай стадион!
Dialogue: 0,0:12:23.24,0:12:25.07,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:12:25.16,0:12:27.83,Default,,0,0,0,,Ол шектен шыққан нәрсе әкелді.
Dialogue: 0,0:12:28.41,0:12:30.29,Default,,0,0,0,,Дис стадионы
Dialogue: 0,0:12:30.37,0:12:32.29,Default,,0,0,0,,Циклон жоқ
Dialogue: 0,0:12:32.37,0:12:35.25,Default,,0,0,0,,Мен, мына жігітпен шайқас.
Dialogue: 0,0:12:35.96,0:12:37.17,Default,,0,0,0,,Шынын айтсам, мен де нақты қашан болатынын білмеймін.
Dialogue: 0,0:12:37.38,0:12:38.59,Default,,0,0,0,,Сәлем
Dialogue: 0,0:12:38.92,0:12:39.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:39.71,0:12:40.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:43.13,0:12:44.47,Default,,0,0,0,,Шан мен Широ
Dialogue: 0,0:12:44.68,0:12:46.59,Default,,0,0,0,,Ах... рахмет
Dialogue: 0,0:12:48.01,0:12:49.10,Default,,0,0,0,,Әдептілік талап етілмейді
Dialogue: 0,0:12:49.18,0:12:49.76,Default,,0,0,0,,Ах
Dialogue: 0,0:12:55.19,0:12:57.48,Default,,0,0,0,,Ах, Rideout капитаны
Dialogue: 0,0:12:57.94,0:13:00.82,Default,,0,0,0,,Есте қалатын «Циклон Бей» стадионын тамашалайық.
Dialogue: 0,0:13:00.90,0:13:02.07,Default,,0,0,0,,Ашылатын шайқас
Dialogue: 0,0:13:02.15,0:13:04.03,Default,,0,0,0,,Мен мұны істегім келеді
Dialogue: 0,0:13:04.36,0:13:06.61,Default,,0,0,0,,Сүйектер Мен жасадым!
Dialogue: 0,0:13:06.82,0:13:08.99,Default,,0,0,0,,Маған солай істе~
Dialogue: 0,0:13:09.07,0:13:10.20,Default,,0,0,0,,Сүйектер!
Dialogue: 0,0:13:10.28,0:13:11.33,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:13:11.41,0:13:12.62,Default,,0,0,0,,Қарсылас – Sparking Killing Boy!
Dialogue: 0,0:13:12.70,0:13:13.62,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:13:13.70,0:13:15.21,Default,,0,0,0,,Циклон!
Dialogue: 0,0:13:16.42,0:13:18.46,Default,,0,0,0,,Луи, онымен ойнағың келе ме?
Dialogue: 0,0:13:18.67,0:13:19.54,Default,,0,0,0,,Хун
Dialogue: 0,0:13:19.63,0:13:23.26,Default,,0,0,0,,Барто Аои Ол Куришю командасының капитаны.
Dialogue: 0,0:13:24.30,0:13:26.38,Default,,0,0,0,,Куришудың командасы?
Dialogue: 0,0:13:26.88,0:13:29.01,Default,,0,0,0,,Ол Шу таныған адам.
Dialogue: 0,0:13:29.22,0:13:31.85,Default,,0,0,0,,Хахаха... Сүйектер! Сүйектер~
Dialogue: 0,0:13:32.31,0:13:33.18,Default,,0,0,0,,Луис
Dialogue: 0,0:13:33.27,0:13:35.18,Default,,0,0,0,,Мұнда ойнаудан аулақ болыңыз.
Dialogue: 0,0:13:35.52,0:13:36.39,Default,,0,0,0,,Австралия…
Dialogue: 0,0:13:36.64,0:13:39.69,Default,,0,0,0,,Ride-out ұлттық турнир кезінде өтеді.
Dialogue: 0,0:13:39.77,0:13:41.69,Default,,0,0,0,,Шетелдік матчтарға тыйым салынады.
Dialogue: 0,0:13:42.48,0:13:44.44,Default,,0,0,0,,Сіз де топтың бір бөлігісіз
Dialogue: 0,0:13:44.53,0:13:46.24,Default,,0,0,0,,Ережелерді орындаңыз
Dialogue: 0,0:13:46.32,0:13:47.28,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:47.45,0:13:49.03,Default,,0,0,0,,Луис мініп кетті ме?
Dialogue: 0,0:13:49.37,0:13:52.58,Default,,0,0,0,,Мен әлі ойында ойнаған жоқпын, бірақ бұл Ride Out.
Dialogue: 0,0:13:53.41,0:13:54.41,Default,,0,0,0,,Хун
Dialogue: 0,0:13:54.50,0:13:58.42,Default,,0,0,0,,Мен күресуге тұрарлық деп санайтындармен ғана күресемін.
Dialogue: 0,0:13:59.33,0:14:01.21,Default,,0,0,0,,Мен үшін мұнда ешкім жоқ
Dialogue: 0,0:14:02.09,0:14:03.71,Default,,0,0,0,,Ол сізге айтып береді.
Dialogue: 0,0:14:03.80,0:14:04.76,Default,,0,0,0,,Хун
Dialogue: 0,0:14:05.17,0:14:06.42,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:06.67,0:14:08.26,Default,,0,0,0,,Бұл стадион Луиге тиесілі
Dialogue: 0,0:14:08.34,0:14:10.43,Default,,0,0,0,,Мен сенің оны қалай жеңетініңді көргім келді.
Dialogue: 0,0:14:10.51,0:14:13.06,Default,,0,0,0,,Осы стадиондағы бірінші шайқас менімен болады...
Dialogue: 0,0:14:13.14,0:14:15.02,Default,,0,0,0,,Иә Иә Иә!
Dialogue: 0,0:14:15.10,0:14:16.10,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:16.18,0:14:17.81,Default,,0,0,0,,Хэхехе~
Dialogue: 0,0:14:19.19,0:14:21.44,Default,,0,0,0,,Киракира-кунмен бірге жасайық
Dialogue: 0,0:14:21.98,0:14:23.90,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:14:24.73,0:14:25.82,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:25.90,0:14:27.74,Default,,0,0,0,,Мен судья боламын.
Dialogue: 0,0:14:28.07,0:14:30.11,Default,,0,0,0,,Ойын екі ұпайлық жүйе.
Dialogue: 0,0:14:30.32,0:14:33.28,Default,,0,0,0,,Айналдыру және жоғары финиш - 1 ұпай
Dialogue: 0,0:14:33.37,0:14:35.62,Default,,0,0,0,,Жедел мәре – 2 ұпай
Dialogue: 0,0:14:35.70,0:14:38.71,Default,,0,0,0,,Енді, Cyclone Bay стадионындағы кездесу
Dialogue: 0,0:14:38.79,0:14:40.83,Default,,0,0,0,,Кім бірінші жеңеді?
Dialogue: 0,0:14:41.17,0:14:43.54,Default,,0,0,0,,Жүр, бірінші шайқас
Dialogue: 0,0:14:45.34,0:14:48.51,Default,,0,0,0,,Бейблейд маскасы... бұл Зак емес пе?
Dialogue: 0,0:14:48.59,0:14:52.55,Default,,0,0,0,,Мен өткен күні ұпай жоғалттым, бірақ мен оны міндетті түрде қайтарамын.
Dialogue: 0,0:14:53.10,0:14:54.47,Default,,0,0,0,,Киракира-кун
Dialogue: 0,0:14:54.60,0:14:57.14,Default,,0,0,0,,Мотивацияңыз жақсы.
Dialogue: 0,0:14:57.43,0:15:00.52,Default,,0,0,0,,Бірақ сен шынымен мені жеңе аламын деп ойлайсың ба?
Dialogue: 0,0:15:00.73,0:15:03.11,Default,,0,0,0,,Cyclone Bay стадионы…
Dialogue: 0,0:15:03.19,0:15:04.69,Default,,0,0,0,,Бұл мүлдем белгісіз.
Dialogue: 0,0:15:04.77,0:15:09.15,Default,,0,0,0,,Стадионның іші айналады...
Dialogue: 0,0:15:10.28,0:15:13.03,Default,,0,0,0,,Бұл дегеніміз...
Dialogue: 0,0:15:13.12,0:15:14.33,Default,,0,0,0,,Шығанақтың айналу күші және...
Dialogue: 0,0:15:14.41,0:15:14.91,Default,,0,0,0,,О!
Dialogue: 0,0:15:14.99,0:15:17.91,Default,,0,0,0,,Стадионның айналу күші уақытқа сәйкес келетін болса.
Dialogue: 0,0:15:18.00,0:15:20.16,Default,,0,0,0,,Одан да жоғары жылдамдық пен қуат
Dialogue: 0,0:15:20.25,0:15:23.92,Default,,0,0,0,,Екінші жағынан, сіз бірден қолайсыз жағдайға тап болатын кездер болады.
Dialogue: 0,0:15:24.29,0:15:27.71,Default,,0,0,0,,Балт Бұл айналу күші. Айналу күші.
Dialogue: 0,0:15:28.26,0:15:29.92,Default,,0,0,0,,Валькирия
Dialogue: 0,0:15:30.01,0:15:32.18,Default,,0,0,0,,Мен бір нәрсеге толқуды тоқтата алмаймын.
Dialogue: 0,0:15:32.26,0:15:33.93,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:15:34.30,0:15:37.51,Default,,0,0,0,,Енді Cyclone Bay стадионының алғашқы жеңісі
Dialogue: 0,0:15:37.60,0:15:39.14,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,0:15:39.48,0:15:40.77,Default,,0,0,0,,Бастайық
Dialogue: 0,0:15:42.81,0:15:44.94,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:15:45.98,0:15:49.23,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:49.49,0:15:51.45,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:51.53,0:15:52.36,Default,,0,0,0,,Киран
Dialogue: 0,0:15:52.95,0:15:55.12,Default,,0,0,0,,Енді шайқас бастайық.
Dialogue: 0,0:15:55.20,0:15:57.53,Default,,0,0,0,,Циллион Зевс орталықты алмайды
Dialogue: 0,0:15:57.62,0:15:59.83,Default,,0,0,0,,Стадионның сыртын айналып өту
Dialogue: 0,0:15:59.91,0:16:01.21,Default,,0,0,0,,Бұл келді ме?
Dialogue: 0,0:16:01.29,0:16:03.46,Default,,0,0,0,,Зак сені тексеріп жатыр.
Dialogue: 0,0:16:03.79,0:16:06.88,Default,,0,0,0,,Валькири Раш ату
Dialogue: 0,0:16:06.96,0:16:08.59,Default,,0,0,0,,Уау! Соқпайды!
Dialogue: 0,0:16:08.80,0:16:11.01,Default,,0,0,0,,Бұл ұят болды, Киракира-кун.
Dialogue: 0,0:16:11.22,0:16:12.26,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:16:12.34,0:16:14.39,Default,,0,0,0,,Бару~ Валькирия
Dialogue: 0,0:16:17.68,0:16:19.18,Default,,0,0,0,,What... what?
Dialogue: 0,0:16:19.26,0:16:20.52,Default,,0,0,0,,Haha~n
Dialogue: 0,0:16:20.60,0:16:23.14,Default,,0,0,0,,Әрине, осылай жұмыс істейді.
Dialogue: 0,0:16:23.44,0:16:24.23,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:25.69,0:16:27.23,Default,,0,0,0,,Валькирия
Dialogue: 0,0:16:27.31,0:16:28.69,Default,,0,0,0,,Айналмалы табақты басқан сәт
Dialogue: 0,0:16:28.77,0:16:30.73,Default,,0,0,0,,Айналу жылдамдығын екі есе арттырыңыз
Dialogue: 0,0:16:30.82,0:16:33.86,Default,,0,0,0,,Бұл шынымен циклон.
Dialogue: 0,0:16:34.78,0:16:36.16,Default,,0,0,0,,Өте керемет
Dialogue: 0,0:16:36.24,0:16:38.41,Default,,0,0,0,,Валькири, қатыгезірек бол
Dialogue: 0,0:16:38.62,0:16:40.37,Default,,0,0,0,,Қызықты!
Dialogue: 0,0:16:40.58,0:16:43.08,Default,,0,0,0,,Бұл жылдамдық ақылсыз
Dialogue: 0,0:16:43.16,0:16:43.96,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:16:44.04,0:16:46.42,Default,,0,0,0,,Ол сыртқа секіруі мүмкін.
Dialogue: 0,0:16:46.50,0:16:47.42,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:47.75,0:16:50.59,Default,,0,0,0,,Сол Валькири қозғалысы
Dialogue: 0,0:16:51.05,0:16:53.34,Default,,0,0,0,,Алға, Валькири!
Dialogue: 0,0:16:54.30,0:16:55.72,Default,,0,0,0,,Валькирияның жылдамдығы
Dialogue: 0,0:16:55.80,0:16:57.89,Default,,0,0,0,,Секірді және одан асып кетті
Dialogue: 0,0:16:57.97,0:16:59.43,Default,,0,0,0,,Зевс болған
Dialogue: 0,0:16:59.51,0:17:00.76,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:02.10,0:17:03.02,Default,,0,0,0,,Ааах!
Dialogue: 0,0:17:03.10,0:17:04.23,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:17:04.31,0:17:06.60,Default,,0,0,0,,Екеуі де стадионнан жүгіріп шықты.
Dialogue: 0,0:17:06.69,0:17:09.15,Default,,0,0,0,,Қайсысы? Хм, қайсысы?
Dialogue: 0,0:17:10.23,0:17:12.74,Default,,0,0,0,,Зевс бір сәт жылдамырақ болды.
Dialogue: 0,0:17:12.94,0:17:14.24,Default,,0,0,0,,Аяқтаумен
Dialogue: 0,0:17:14.32,0:17:16.11,Default,,0,0,0,,Валькирия 1 ұпай
Dialogue: 0,0:17:16.20,0:17:18.66,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:17:18.99,0:17:20.45,Default,,0,0,0,,Жарайсың досым
Dialogue: 0,0:17:22.08,0:17:23.75,Default,,0,0,0,,Кездейсоқ
Dialogue: 0,0:17:24.50,0:17:27.12,Default,,0,0,0,,Сен тым жақсысың, Киракира-кун, цк.
Dialogue: 0,0:17:27.58,0:17:29.96,Default,,0,0,0,,Жарайсың Балто
Dialogue: 0,0:17:30.04,0:17:32.38,Default,,0,0,0,,Өйткені ол нөмірлері белгісіз стадион
Dialogue: 0,0:17:32.46,0:17:35.26,Default,,0,0,0,,Балто агрессивті болды және жеңіске жетті.
Dialogue: 0,0:17:35.67,0:17:38.68,Default,,0,0,0,,Мен мұны істей аламын, өйткені мен ештеңе туралы ойлаудың қажеті жоқ.
Dialogue: 0,0:17:38.89,0:17:40.93,Default,,0,0,0,,Бірақ бұл керемет, Бар-нии.
Dialogue: 0,0:17:41.01,0:17:42.89,Default,,0,0,0,,Үлкен ағадан күткендей.
Dialogue: 0,0:17:45.35,0:17:47.64,Default,,0,0,0,,Екінші шайқасқа барайық
Dialogue: 0,0:17:47.73,0:17:48.81,Default,,0,0,0,,О!
Dialogue: 0,0:17:48.90,0:17:52.48,Default,,0,0,0,,Мен Cyclone Bay стадионын қалай пайдалану керектігін білемін.
Dialogue: 0,0:17:53.03,0:17:54.36,Default,,0,0,0,,Көңілді болайық
Dialogue: 0,0:17:54.57,0:17:55.61,Default,,0,0,0,,Киракира-кун
Dialogue: 0,0:17:55.99,0:17:56.90,Default,,0,0,0,,О
Dialogue: 0,0:17:57.11,0:17:58.99,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:17:59.41,0:18:02.74,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:03.04,0:18:05.25,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:05.33,0:18:06.29,Default,,0,0,0,,Жарқыраған
Dialogue: 0,0:18:06.37,0:18:08.83,Default,,0,0,0,,Ой, Зевс, орталықты көзде.
Dialogue: 0,0:18:08.92,0:18:10.92,Default,,0,0,0,,Айналмалы дискінің импульсін жоққа шығару
Dialogue: 0,0:18:11.00,0:18:12.50,Default,,0,0,0,,орталықты алды
Dialogue: 0,0:18:13.17,0:18:15.38,Default,,0,0,0,,Валькири Раш қайтадан ату
Dialogue: 0,0:18:15.46,0:18:17.22,Default,,0,0,0,,Ішке асығыс! Сіз қалай ойлайсыз...
Dialogue: 0,0:18:17.30,0:18:19.09,Default,,0,0,0,,Зевс орталығын қорғады
Dialogue: 0,0:18:19.68,0:18:22.43,Default,,0,0,0,,Айналмалы стадионның үстіндегі шығанақты тоқтату нені білдіреді?
Dialogue: 0,0:18:22.51,0:18:25.68,Default,,0,0,0,,Бұл өте қиын қадам!
Dialogue: 0,0:18:26.89,0:18:27.81,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:27.89,0:18:29.69,Default,,0,0,0,,Зак мұны жасайды.
Dialogue: 0,0:18:30.19,0:18:32.23,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:18:32.31,0:18:35.28,Default,,0,0,0,,Циклонның қуатын өз күшіне айналдыру
Dialogue: 0,0:18:35.36,0:18:38.74,Default,,0,0,0,,Валькирия Зевске қарай бет алды.
Dialogue: 0,0:18:38.82,0:18:40.28,Default,,0,0,0,,Бірақ ешқандай зақым жоқ!
Dialogue: 0,0:18:40.86,0:18:43.08,Default,,0,0,0,,Әй, Валкири Раш.
Dialogue: 0,0:18:43.16,0:18:43.99,Default,,0,0,0,,Асық!
Dialogue: 0,0:18:44.08,0:18:47.75,Default,,0,0,0,,Валькири қайтадан орталыққа қарай шабуыл жасайды.
Dialogue: 0,0:18:47.83,0:18:50.12,Default,,0,0,0,,Бірақ Зевс оны тығырыққа тірейді
Dialogue: 0,0:18:50.21,0:18:52.79,Default,,0,0,0,,Бірақ Валькири де ашуды жалғастыруда.
Dialogue: 0,0:18:53.34,0:18:55.71,Default,,0,0,0,,Күтілгендей, сол Валькири
Dialogue: 0,0:18:56.30,0:18:58.47,Default,,0,0,0,,Бұл шайқаста не болады?
Dialogue: 0,0:18:58.55,0:18:59.51,Default,,0,0,0,,Мен бара аламын ба?
Dialogue: 0,0:19:00.22,0:19:01.47,Default,,0,0,0,,Шабуыл жасауды жалғастырыңыз
Dialogue: 0,0:19:05.06,0:19:06.68,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:08.64,0:19:09.43,Default,,0,0,0,,Не?
Dialogue: 0,0:19:10.23,0:19:12.35,Default,,0,0,0,,Екеуі де қатты соқты!
Dialogue: 0,0:19:12.44,0:19:13.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:13.44,0:19:15.15,Default,,0,0,0,,Бір уақытта дерлік
Dialogue: 0,0:19:15.23,0:19:17.90,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:19:18.15,0:19:19.11,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:19.19,0:19:20.07,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:19:20.15,0:19:22.74,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:22.82,0:19:23.91,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,0:19:24.24,0:19:25.03,Default,,0,0,0,,Ха
Dialogue: 0,0:19:25.78,0:19:28.25,Default,,0,0,0,,Бір сәт Валькири жылдамырақ болды.
Dialogue: 0,0:19:28.45,0:19:30.08,Default,,0,0,0,,Жарып біткен
Dialogue: 0,0:19:30.16,0:19:31.79,Default,,0,0,0,,Циллион Зевс жеңеді.
Dialogue: 0,0:19:32.04,0:19:36.04,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:19:37.34,0:19:38.63,Default,,0,0,0,,Иә
Dialogue: 0,0:19:39.01,0:19:40.59,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:19:40.72,0:19:42.13,Default,,0,0,0,,Ол керемет жігіт.
Dialogue: 0,0:19:42.59,0:19:44.18,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:19:45.30,0:19:46.89,Default,,0,0,0,,Валькирия
Dialogue: 0,0:19:46.97,0:19:48.22,Default,,0,0,0,,Мен таң қалдым
Dialogue: 0,0:19:48.52,0:19:51.69,Default,,0,0,0,,Бұл таңғажайып шайқас болды, Валькири.
Dialogue: 0,0:19:51.77,0:19:56.32,Default,,0,0,0,,Баршаңызға, бұл сүйек стадионы шынымен де қызықты.
Dialogue: 0,0:19:56.40,0:19:57.27,Default,,0,0,0,,♬~
Dialogue: 0,0:19:58.98,0:20:02.32,Default,,0,0,0,,Идиот Балт, бақытты болма.
Dialogue: 0,0:20:02.40,0:20:04.07,Default,,0,0,0,,Оған ұқсайды.
Dialogue: 0,0:20:04.16,0:20:06.07,Default,,0,0,0,,Бұл керемет болды, Балто.
Dialogue: 0,0:20:06.16,0:20:07.24,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:07.45,0:20:09.33,Default,,0,0,0,,Бұл жеңілудің жақсы жолы болды.
Dialogue: 0,0:20:09.41,0:20:10.12,Default,,0,0,0,,Иә
Dialogue: 0,0:20:10.20,0:20:12.96,Default,,0,0,0,,Хмм, «жақсы шығын» деген бар ма?
Dialogue: 0,0:20:13.54,0:20:15.88,Default,,0,0,0,,Барлық жоғалтулар нашар шығындар болып табылады
Dialogue: 0,0:20:15.96,0:20:16.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:17.25,0:20:18.42,Default,,0,0,0,,Сіз
Dialogue: 0,0:20:20.05,0:20:22.05,Default,,0,0,0,,Сіз жаман қуықсыз
Dialogue: 0,0:20:22.59,0:20:23.34,Default,,0,0,0,,Е...
Dialogue: 0,0:20:23.93,0:20:25.59,Default,,0,0,0,,Сіздің шығанақ туралы
Dialogue: 0,0:20:25.68,0:20:27.05,Default,,0,0,0,,Мен ештеңе түсінбеймін
Dialogue: 0,0:20:27.14,0:20:27.93,Default,,0,0,0,,А... а...
Dialogue: 0,0:20:28.01,0:20:29.60,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:20:29.97,0:20:33.19,Default,,0,0,0,,Мен Валькири туралы басқаларға қарағанда көбірек білемін.
Dialogue: 0,0:20:34.02,0:20:36.61,Default,,0,0,0,,Мен бұл шығанақты аяймын.
Dialogue: 0,0:20:37.86,0:20:39.61,Default,,0,0,0,,Е...
Dialogue: 0,0:20:40.07,0:20:43.07,Default,,0,0,0,,Біз орман ішінде жасырынған «Саусақ ұштарын» жоюға басымдық беруіміз керек және Құлқынмен есептесуіміз қажет.
Dialogue: 0,0:20:52.91,0:20:55.12,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:58.67,0:21:01.17,Default,,0,0,0,,Cyclone Bay стадионы
Dialogue: 0,0:21:01.26,0:21:02.59,Default,,0,0,0,,Зұлымдар Альянсы: Даби
Dialogue: 0,0:21:02.67,0:21:03.84,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:21:04.97,0:21:07.72,Default,,0,0,0,,Бірақ аға, мен Зактан жеңіліп қалдым.
Dialogue: 0,0:21:08.14,0:21:09.51,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:21:09.76,0:21:11.43,Default,,0,0,0,,Біз жеңетін сияқты едік.
Dialogue: 0,0:21:11.52,0:21:12.64,Default,,0,0,0,,Әй, Бар-нии
Dialogue: 0,0:21:15.27,0:21:17.73,Default,,0,0,0,,Барлық жоғалтулар нашар шығындар болып табылады
Dialogue: 0,0:21:18.19,0:21:20.69,Default,,0,0,0,,Сіз жаман қуықсыз.
Dialogue: 0,0:21:21.48,0:21:23.94,Default,,0,0,0,,Сол шығанақты аяймын.
Dialogue: 0,0:21:27.49,0:21:29.70,Default,,0,0,0,,Жаса! Бұл!
Dialogue: 0,0:21:29.78,0:21:31.54,Default,,0,0,0,,Бұл! Бұл!
Dialogue: 0,0:21:31.62,0:21:34.33,Default,,0,0,0,,Келесі жолы жеңіңіз! жең! жең!
Dialogue: 0,0:21:34.41,0:21:36.21,Default,,0,0,0,,Жарайды, Балто.
Dialogue: 0,0:21:41.13,0:21:42.30,Default,,0,0,0,,Ауырсыну
Dialogue: 0,0:21:42.46,0:21:43.55,Default,,0,0,0,,Тек қала орталығында ғана емес,
Dialogue: 0,0:21:49.47,0:21:50.39,Default,,0,0,0,,Мен
Dialogue: 0,0:21:51.26,0:21:52.39,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Артынан қуып барсаң, көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.44,0:23:28.40,Default,,0,0,0,,Біздің екінші раундтағы қарсыласымыз
Dialogue: 0,0:23:28.49,0:23:30.40,Default,,0,0,0,,Бұл Шақаның қылыш жалыны.
Dialogue: 0,0:23:30.86,0:23:32.70,Default,,0,0,0,,Менің жеңуден басқа амалым жоқ
Dialogue: 0,0:23:32.78,0:23:33.95,Default,,0,0,0,,Жеңіске жету стратегиясы...
Dialogue: 0,0:23:34.03,0:23:35.24,Default,,0,0,0,,Бұл...
Dialogue: 0,0:23:35.62,0:23:37.74,Default,,0,0,0,,Иә? Мен пайда болмаймын ба?
Dialogue: 0,0:23:37.83,0:23:39.08,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:23:39.16,0:23:41.79,Default,,0,0,0,,Мен мұнда не үшін келдім?
Dialogue: 0,0:23:42.12,0:23:44.08,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:44.17,0:23:46.34,Default,,0,0,0,,Жарылғыш жалын! қос әсер
Dialogue: 0,0:23:46.42,0:23:48.13,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.21,0:23:49.63,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.13,0:23:57.13,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory