Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.59,0:00:09.13,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.21,0:00:12.63,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.76,0:00:14.76,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:16.97,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.05,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.52,0:00:24.23,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.31,0:00:26.27,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.35,0:00:28.86,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.61,0:00:34.32,Default,,0,0,0,,Ұлттық турнирге қайта оралу әрекеті
Dialogue: 0,0:00:34.40,0:00:36.66,Default,,0,0,0,,Аудандық іріктеу турнирінің екінші кезеңі
Dialogue: 0,0:00:37.07,0:00:39.20,Default,,0,0,0,,Вакия мен Хоудзи төбелесті
Dialogue: 0,0:00:39.87,0:00:42.66,Default,,0,0,0,,Виверн шынымен де күшті болды.
Dialogue: 0,0:00:42.75,0:00:44.29,Default,,0,0,0,,Жеңімпаз Вакия болды!
Dialogue: 0,0:00:44.66,0:00:47.54,Default,,0,0,0,,Сосын мен Кумичоға соқтығыстым.
Dialogue: 0,0:00:49.54,0:00:51.59,Default,,0,0,0,,Жүр!
Dialogue: 0,0:00:53.34,0:00:55.09,Default,,0,0,0,,А... бәрі жақсы ма?
Dialogue: 0,0:00:55.88,0:00:57.14,Default,,0,0,0,,Бл…ээ…!!
Dialogue: 0,0:00:57.26,0:00:58.60,Default,,0,0,0,,Балтық
Dialogue: 0,0:00:59.18,0:01:01.93,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:01:02.14,0:01:04.23,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:01:05.10,0:01:06.52,Default,,0,0,0,,Хмм.
Dialogue: 0,0:01:06.60,0:01:07.73,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:01:07.81,0:01:10.52,Default,,0,0,0,,Мен қыши бастадым.
Dialogue: 0,0:01:11.32,0:01:13.28,Default,,0,0,0,,Мен шыдай алмаймын.
Dialogue: 0,0:01:21.79,0:01:24.16,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:24.50,0:01:29.67,Default,,0,0,0,,Ең күшті қуық болуды мақсат етейік
Dialogue: 0,0:01:40.97,0:01:44.35,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:44.85,0:01:46.98,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:47.39,0:01:51.52,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:51.65,0:01:54.86,Default,,0,0,0,,Дұрыс, менімен бетпе-бет келген өрнек
Dialogue: 0,0:01:54.98,0:02:01.41,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:01.70,0:02:06.12,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:06.62,0:02:12.04,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:12.17,0:02:14.42,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:14.50,0:02:19.22,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:19.38,0:02:24.47,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:24.76,0:02:27.02,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:27.23,0:02:29.56,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:29.85,0:02:33.77,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:33.94,0:02:38.95,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:39.15,0:02:41.32,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:44.99,0:02:47.25,Default,,0,0,0,,Бейблейдтің жұмбақ маскасы!
Dialogue: 0,0:02:49.41,0:02:51.37,Default,,0,0,0,,Жақсы, жақсы өтті!
Dialogue: 0,0:02:51.46,0:02:52.79,Default,,0,0,0,,Жоғалтпа~
Dialogue: 0,0:02:52.88,0:02:55.84,Default,,0,0,0,,Жүр! жалғастыра беріңіз~! Шабуыл!
Dialogue: 0,0:02:56.46,0:02:57.71,Default,,0,0,0,,Жүр! Бар!
Dialogue: 0,0:02:57.96,0:02:59.17,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:03:01.47,0:03:02.68,Default,,0,0,0,,Уау~
Dialogue: 0,0:03:02.76,0:03:03.76,Default,,0,0,0,,Ура!
Dialogue: 0,0:03:03.85,0:03:06.18,Default,,0,0,0,,Жеңімпаз аяқталды!
Dialogue: 0,0:03:06.26,0:03:07.85,Default,,0,0,0,,Мені ұрып-соқты~
Dialogue: 0,0:03:07.93,0:03:10.14,Default,,0,0,0,,Шығанақты жақсы көретін ұлдар мен қыздар
Dialogue: 0,0:03:10.23,0:03:11.10,Default,,0,0,0,,А...
Dialogue: 0,0:03:13.40,0:03:15.61,Default,,0,0,0,,Балалар мен сендерді көруге келдім.
Dialogue: 0,0:03:15.86,0:03:18.23,Default,,0,0,0,,Не? Күдікті
Dialogue: 0,0:03:18.53,0:03:19.65,Default,,0,0,0,,О!
Dialogue: 0,0:03:22.61,0:03:24.37,Default,,0,0,0,,Уф... түсіндім!
Dialogue: 0,0:03:26.03,0:03:29.29,Default,,0,0,0,,Ой~ Келме~ Келме~
Dialogue: 0,0:03:29.37,0:03:31.16,Default,,0,0,0,,Саса Саса
Dialogue: 0,0:03:32.00,0:03:33.12,Default,,0,0,0,,Haha~n
Dialogue: 0,0:03:33.21,0:03:35.59,Default,,0,0,0,,Сіз мені дұрыс түсінбеген сияқтысыз.
Dialogue: 0,0:03:38.63,0:03:40.72,Default,,0,0,0,,Мен күдікті адам емеспін
Dialogue: 0,0:03:41.17,0:03:42.84,Default,,0,0,0,,Тым күдікті
Dialogue: 0,0:03:43.05,0:03:45.97,Default,,0,0,0,,Бейблейд ойынының қызығын балаларға жеткізу -
Dialogue: 0,0:03:46.05,0:03:47.31,Default,,0,0,0,,Әділет елшісі
Dialogue: 0,0:03:49.97,0:03:51.77,Default,,0,0,0,,Бейблейд маскасы!
Dialogue: 0,0:03:51.98,0:03:53.69,Default,,0,0,0,,Бейблейд маскасы?
Dialogue: 0,0:03:53.77,0:03:57.40,Default,,0,0,0,,Иә, Бейблейдке деген махаббат пен ынта...
Dialogue: 0,0:03:57.48,0:04:00.24,Default,,0,0,0,,Мені бұл дүниеге әкелдің.
Dialogue: 0,0:04:00.32,0:04:02.11,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:02.20,0:04:03.99,Default,,0,0,0,,Ол қауіпті.
Dialogue: 0,0:04:04.07,0:04:06.24,Default,,0,0,0,,Күте тұрыңыз... бұл дауыс...
Dialogue: 0,0:04:06.32,0:04:09.62,Default,,0,0,0,,Мүмкін ол ``Hahan~n'' немесе ''Nass'' сияқты нәрселерді айтып тұрған шығар.
Dialogue: 0,0:04:10.41,0:04:12.33,Default,,0,0,0,,Бейблейд маскасы
Dialogue: 0,0:04:12.41,0:04:12.91,Default,,0,0,0,,Сол сияқты, бір күні, бір жерде кездесесіздер.
Dialogue: 0,0:04:13.00,0:04:15.21,Default,,0,0,0,,Маған бір нәрсе айтылды.
Dialogue: 0,0:04:15.33,0:04:16.58,Default,,0,0,0,,Айт.
Dialogue: 0,0:04:16.79,0:04:20.34,Default,,0,0,0,,Дәл қазір ең күшті Бейблейд ойыншысы кім?
Dialogue: 0,0:04:20.71,0:04:23.38,Default,,0,0,0,,Яғни...жер күнді айналады.
Dialogue: 0,0:04:23.47,0:04:24.93,Default,,0,0,0,,Айналып жатқандай -
Dialogue: 0,0:04:25.01,0:04:26.30,Default,,0,0,0,,Бұл анық
Dialogue: 0,0:04:26.39,0:04:27.72,Default,,0,0,0,,Алдымен осы жігіт туралы білетіндерімізді реттеп көрейік.
Dialogue: 0,0:04:27.80,0:04:28.72,Default,,0,0,0,,Иә...
Dialogue: 0,0:04:28.81,0:04:30.10,Default,,0,0,0,,Бұл өте дұрыс...
Dialogue: 0,0:04:30.27,0:04:32.60,Default,,0,0,0,,Зак Күн сәулесі!
Dialogue: 0,0:04:32.68,0:04:36.23,Default,,0,0,0,,Бұл бала бүгінгі күннің бірінші бейблейдері!
Dialogue: 0,0:04:36.35,0:04:37.65,Default,,0,0,0,,Сізден бір нәрсе сұрасам…
Dialogue: 0,0:04:38.11,0:04:40.40,Default,,0,0,0,,Егер сіз Зактың бірінші нөмірлі екеніне сенсеңіз...
Dialogue: 0,0:04:40.48,0:04:42.36,Default,,0,0,0,,Ол өте жақсы қыз~
Dialogue: 0,0:04:42.44,0:04:44.36,Default,,0,0,0,,Бұл сыйлық.
Dialogue: 0,0:04:44.70,0:04:46.61,Default,,0,0,0,,Зактың жаңа альбомы!
Dialogue: 0,0:04:46.70,0:04:48.07,Default,,0,0,0,,Және қол қою керек!
Dialogue: 0,0:04:48.24,0:04:49.37,Default,,0,0,0,,​​Күмән жоқ!
Dialogue: 0,0:04:49.78,0:04:52.66,Default,,0,0,0,,Рахмет~ Бейблейд маскасы!
Dialogue: 0,0:04:52.75,0:04:55.67,Default,,0,0,0,,Сен бақыттысың, мен бақыттымын
Dialogue: 0,0:04:55.75,0:04:58.00,Default,,0,0,0,,Haha~n
Dialogue: 0,0:04:58.08,0:05:00.80,Default,,0,0,0,,Бүгін сенен сұрайын дегенім бар.
Dialogue: 0,0:05:00.88,0:05:01.88,Default,,0,0,0,,Не ол?
Dialogue: 0,0:05:02.21,0:05:04.84,Default,,0,0,0,,Бейблейд маскасы қатты ашты
Dialogue: 0,0:05:04.92,0:05:06.55,Default,,0,0,0,,Сіз қарныңыз ашты.
Dialogue: 0,0:05:07.09,0:05:08.26,Default,,0,0,0,,А...?
Dialogue: 0,0:05:09.26,0:05:11.18,Default,,0,0,0,,(асқазанның айқайлауы)
Dialogue: 0,0:05:13.47,0:05:15.60,Default,,0,0,0,,Уау~ Бұл~
Dialogue: 0,0:05:16.02,0:05:18.52,Default,,0,0,0,,Анамның арнайы Бейблейд наны!
Dialogue: 0,0:05:19.81,0:05:21.86,Default,,0,0,0,,Қандай көркем нан!
Dialogue: 0,0:05:22.53,0:05:23.78,Default,,0,0,0,,Не...
Dialogue: 0,0:05:23.86,0:05:25.15,Default,,0,0,0,,Бұл! бұл!
Dialogue: 0,0:05:25.57,0:05:26.65,Default,,0,0,0,,Әлде бұл жыныстық сипаттағы қорлау үшін сылтау ма?
Dialogue: 0,0:05:26.99,0:05:28.24,Default,,0,0,0,,Не!
Dialogue: 0,0:05:28.32,0:05:30.12,Default,,0,0,0,,Бұл кенеттен пайда болды
Dialogue: 0,0:05:30.20,0:05:33.16,Default,,0,0,0,,Сіз өзіңіздің жеке басыңызды жасыруға тырысып жатырсыз...
Dialogue: 0,0:05:33.24,0:05:35.04,Default,,0,0,0,,Керісінше, көзге түседі...
Dialogue: 0,0:05:35.33,0:05:36.71,Default,,0,0,0,,(нан жеу дыбысы)
Dialogue: 0,0:05:36.79,0:05:38.12,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:05:38.33,0:05:40.21,Default,,0,0,0,,Кеттік! Кумичо!
Dialogue: 0,0:05:40.29,0:05:41.67,Default,,0,0,0,,О! Киягаре!
Dialogue: 0,0:05:42.09,0:05:44.80,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:44.88,0:05:46.67,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:46.76,0:05:47.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:47.76,0:05:49.47,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:05:51.60,0:05:53.10,Default,,0,0,0,,Рагнарук аймағы!
Dialogue: 0,0:05:54.60,0:05:56.39,Default,,0,0,0,,(шығақтардың соқтығысқан дыбысы)
Dialogue: 0,0:06:00.69,0:06:04.11,Default,,0,0,0,,Бұл оянған Валькирия!
Dialogue: 0,0:06:04.32,0:06:06.11,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:06:07.03,0:06:09.41,Default,,0,0,0,,Жарайсыңдар! (Рантаро) Куу...!
Dialogue: 0,0:06:09.57,0:06:11.78,Default,,0,0,0,,Керемет! Валькирия!
Dialogue: 0,0:06:11.99,0:06:12.78,Default,,0,0,0,,♬~
Dialogue: 0,0:06:12.87,0:06:14.70,Default,,0,0,0,,Менің көңілім қалды...Балто!
Dialogue: 0,0:06:14.79,0:06:18.08,Default,,0,0,0,,Ей, Валькири, сен қатты өстің!
Dialogue: 0,0:06:18.16,0:06:19.71,Default,,0,0,0,,Дұрыс па? Дұрыс па?
Dialogue: 0,0:06:19.79,0:06:22.63,Default,,0,0,0,,Менің Валькириям қазірдің өзінде тамаша.
Dialogue: 0,0:06:22.92,0:06:24.59,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:06:24.67,0:06:26.96,Default,,0,0,0,,Қайта тым көп алданып қалмаңыз.
Dialogue: 0,0:06:27.05,0:06:29.51,Default,,0,0,0,,Алаңдамаңыз.
Dialogue: 0,0:06:29.59,0:06:33.72,Default,,0,0,0,,Мен Кумичодан бір рет, екі рет, үш рет, төрт рет жеңдім.
Dialogue: 0,0:06:33.81,0:06:35.68,Default,,0,0,0,,Қарғыс атқыр... сен мініп жүрсің ғой, солай ма?
Dialogue: 0,0:06:35.77,0:06:38.68,Default,,0,0,0,,Жүр, жүр, жүр!
Dialogue: 0,0:06:38.77,0:06:40.06,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:06:40.14,0:06:41.60,Default,,0,0,0,,Валькири әлі оятты
Dialogue: 0,0:06:41.69,0:06:44.36,Default,,0,0,0,,Толық бақылауда болмаса да.
Dialogue: 0,0:06:44.44,0:06:45.73,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:06:45.82,0:06:47.61,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:06:47.69,0:06:48.86,Default,,0,0,0,,Орындалды.
Dialogue: 0,0:06:48.95,0:06:50.20,Default,,0,0,0,,Менің қолымнан келмейді~
Dialogue: 0,0:06:50.28,0:06:51.53,Default,,0,0,0,,Орындалды...
Dialogue: 0,0:06:51.61,0:06:52.99,Default,,0,0,0,,Мен мұны істей алмаймын.
Dialogue: 0,0:06:53.07,0:06:55.41,Default,,0,0,0,,Орындалды... Адада
Dialogue: 0,0:06:56.20,0:06:57.54,Default,,0,0,0,,Жылы...
Dialogue: 0,0:06:57.62,0:06:59.54,Default,,0,0,0,,Дұрыс, Дина.
Dialogue: 0,0:07:01.42,0:07:02.54,Default,,0,0,0,,Дина...?
Dialogue: 0,0:07:02.63,0:07:04.71,Default,,0,0,0,,А... дұрыс.
Dialogue: 0,0:07:05.17,0:07:07.88,Default,,0,0,0,,Ал соңғы қарсыласы Один Орочи.
Dialogue: 0,0:07:08.01,0:07:09.72,Default,,0,0,0,,Сіз сияқты шабуыл түрі
Dialogue: 0,0:07:09.80,0:07:11.93,Default,,0,0,0,,Менің Рагнарук басқаша.
Dialogue: 0,0:07:12.01,0:07:13.14,Default,,0,0,0,,Уау!
Dialogue: 0,0:07:13.47,0:07:15.35,Default,,0,0,0,,Содан кейін оған көбірек күш салыңыз!
Dialogue: 0,0:07:15.43,0:07:16.64,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:07:16.72,0:07:18.64,Default,,0,0,0,,Шабуыл жасау туралы көбірек ойланыңыз.
Dialogue: 0,0:07:18.72,0:07:21.02,Default,,0,0,0,,Бұл Один...
Dialogue: 0,0:07:21.10,0:07:23.52,Default,,0,0,0,,Рахмет сізге Кумичо
Dialogue: 0,0:07:23.60,0:07:25.40,Default,,0,0,0,,Не, кенет не болып жатыр?
Dialogue: 0,0:07:25.48,0:07:28.28,Default,,0,0,0,,Мен үшін көп ойлағаныңыз үшін рахмет.
Dialogue: 0,0:07:28.73,0:07:31.03,Default,,0,0,0,,Достардың болғаны өте жақсы.
Dialogue: 0,0:07:31.11,0:07:32.45,Default,,0,0,0,,тым кеш!
Dialogue: 0,0:07:33.11,0:07:34.95,Default,,0,0,0,,Достар... иә...
Dialogue: 0,0:07:36.37,0:07:38.37,Default,,0,0,0,,Жақсы! Келесіде Дина
Dialogue: 0,0:07:38.45,0:07:38.95,Default,,0,0,0,,Е...
Dialogue: 0,0:07:39.08,0:07:40.25,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:07:40.83,0:07:43.21,Default,,0,0,0,,Мен...істерім бар екені есіме түсті...
Dialogue: 0,0:07:43.29,0:07:45.96,Default,,0,0,0,,Е... бүгін... Кешіріңіз.
Dialogue: 0,0:07:47.88,0:07:49.51,Default,,0,0,0,,А…?
Dialogue: 0,0:07:50.09,0:07:53.13,Default,,0,0,0,,Хмм, жоқ, тамақ үшін рахмет.
Dialogue: 0,0:07:53.34,0:07:56.93,Default,,0,0,0,,Эй, Киракира Онии-сан, ол әлі үйде емес пе?
Dialogue: 0,0:07:57.01,0:08:00.93,Default,,0,0,0,,Иә, олар мектепте бек жаттығады деп ойлаймын.
Dialogue: 0,0:08:01.02,0:08:03.39,Default,,0,0,0,,Онда мен бірінші барғым келетін жер бар.
Dialogue: 0,0:08:03.64,0:08:05.23,Default,,0,0,0,,Сіз маған айналаңызды көрсете аласыз ба?
Dialogue: 0,0:08:05.61,0:08:08.40,Default,,0,0,0,,Әрине Бейблейд Камен-сама!
Dialogue: 0,0:08:08.48,0:08:09.82,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:08:09.90,0:08:11.36,Default,,0,0,0,,Кя~
Dialogue: 0,0:08:11.86,0:08:13.74,Default,,0,0,0,,Не, сен?
Dialogue: 0,0:08:14.16,0:08:16.28,Default,,0,0,0,,Бейблейд маскасы?
Dialogue: 0,0:08:16.62,0:08:18.03,Default,,0,0,0,,Иә
Dialogue: 0,0:08:18.12,0:08:21.50,Default,,0,0,0,,Бүгін мен сендермен шайқасқа арнайы келдім.
Dialogue: 0,0:08:21.58,0:08:25.58,Default,,0,0,0,,Жаттығуға араласу немесе бірдеңені таңдау~ (Хоудзи Конта) Иә.
Dialogue: 0,0:08:25.67,0:08:28.25,Default,,0,0,0,,Бір минут күте тұрыңыз...
Dialogue: 0,0:08:28.34,0:08:29.46,Default,,0,0,0,,Әлде бұл жыныстық сипаттағы қорлау үшін сылтау ма?
Dialogue: 0,0:08:29.55,0:08:32.59,Default,,0,0,0,,Мен мұнда соғысу үшін келсем де...
Dialogue: 0,0:08:32.67,0:08:34.72,Default,,0,0,0,,Мен сене алмаймын
Dialogue: 0,0:08:34.80,0:08:35.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:36.43,0:08:37.72,Default,,0,0,0,,Әлгі жігіт...
Dialogue: 0,0:08:38.51,0:08:41.52,Default,,0,0,0,,Бейблейд маскасы менімен шайқас
Dialogue: 0,0:08:41.60,0:08:42.60,Default,,0,0,0,,Хоудзи…
Dialogue: 0,0:08:42.93,0:08:45.85,Default,,0,0,0,,Хаха~ Мотивация алған сияқтысыз.
Dialogue: 0,0:08:45.94,0:08:47.65,Default,,0,0,0,,Na~is
Dialogue: 0,0:08:47.81,0:08:50.02,Default,,0,0,0,,Балам, мұқият қарашы.
Dialogue: 0,0:08:50.23,0:08:51.11,Default,,0,0,0,,Фалько…
Dialogue: 0,0:08:52.53,0:08:54.57,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:08:56.49,0:09:01.04,Default,,0,0,0,,Аудандық іріктеу турниріндегі шайқасыңыз өте әсерлі болды.
Dialogue: 0,0:09:01.12,0:09:03.70,Default,,0,0,0,,Бейдің оған деген сезімі болғаны жақсы.
Dialogue: 0,0:09:04.54,0:09:06.75,Default,,0,0,0,,Мен сенімен шайқасқым келді.
Dialogue: 0,0:09:08.50,0:09:10.04,Default,,0,0,0,,Сіздің Хорсудыңыз -
Dialogue: 0,0:09:10.13,0:09:12.67,Default,,0,0,0,,Бұл менімен бірдей төзімділік түрі.
Dialogue: 0,0:09:13.84,0:09:15.88,Default,,0,0,0,,Бұл Циллион Зевс...
Dialogue: 0,0:09:15.97,0:09:17.64,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:09:17.97,0:09:21.60,Default,,0,0,0,,Кірістірілген металл шарлары бар алты пышақ қабаты бар.
Dialogue: 0,0:09:21.76,0:09:24.14,Default,,0,0,0,,Металл жүргізушіде де қолданылады.
Dialogue: 0,0:09:24.56,0:09:26.35,Default,,0,0,0,,Циллион Зевс...
Dialogue: 0,0:09:26.48,0:09:28.31,Default,,0,0,0,,Сіз оны пайдаланасыз ба...
Dialogue: 0,0:09:28.69,0:09:29.98,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:09:30.19,0:09:32.28,Default,,0,0,0,,Бұл Бейблейд маскасының шынайы идентификациясы қандай?
Dialogue: 0,0:09:32.48,0:09:35.03,Default,,0,0,0,,Мен Закпын, төрт императордың бірімін.
Dialogue: 0,0:09:35.53,0:09:38.28,Default,,0,0,0,,Неліктен Зак мұнда?
Dialogue: 0,0:09:39.62,0:09:43.66,Default,,0,0,0,,Балалар, нағыз күш дегеніміз не?
Dialogue: 0,0:09:43.74,0:09:45.50,Default,,0,0,0,,Мен саған көрсетемін!
Dialogue: 0,0:09:45.71,0:09:47.58,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:09:47.79,0:09:51.04,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:51.42,0:09:54.21,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:58.13,0:09:59.55,Default,,0,0,0,,Ұш! Хорсуд!
Dialogue: 0,0:10:02.51,0:10:04.89,Default,,0,0,0,,Жарайды, мен орталықты бірінші алдым!
Dialogue: 0,0:10:04.97,0:10:06.73,Default,,0,0,0,,Енді бәрі қауіпсіз!
Dialogue: 0,0:10:07.23,0:10:10.44,Default,,0,0,0,,Хорсуд өрісі!
Dialogue: 0,0:10:13.90,0:10:15.40,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:10:15.74,0:10:17.45,Default,,0,0,0,,Фантастикалық
Dialogue: 0,0:10:17.82,0:10:20.70,Default,,0,0,0,,Бірақ Циллион Зевс кеттік!
Dialogue: 0,0:10:23.28,0:10:24.41,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:10:26.50,0:10:27.91,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:10:28.12,0:10:28.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:28.79,0:10:29.67,Default,,0,0,0,,Не?
Dialogue: 0,0:10:29.75,0:10:30.83,Default,,0,0,0,,Хмм…
Dialogue: 0,0:10:30.92,0:10:33.38,Default,,0,0,0,,А... а... ә...
Dialogue: 0,0:10:33.46,0:10:34.84,Default,,0,0,0,,Жарып бітірумен-
Dialogue: 0,0:10:34.92,0:10:36.76,Default,,0,0,0,,Циллион Зевстің жеңісі!
Dialogue: 0,0:10:37.55,0:10:38.59,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:10:38.88,0:10:40.26,Default,,0,0,0,,Керемет
Dialogue: 0,0:10:40.34,0:10:41.84,Default,,0,0,0,,Зевс тым күшті!
Dialogue: 0,0:10:42.39,0:10:44.60,Default,,0,0,0,,Олай болса... сенің кезегің.
Dialogue: 0,0:10:44.89,0:10:45.85,Default,,0,0,0,,Ағымдағы шайқас-
Dialogue: 0,0:10:45.93,0:10:48.98,Default,,0,0,0,,Бұл өте пайдалы болмаған шығар, бірақ
Dialogue: 0,0:10:49.06,0:10:50.31,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:10:50.39,0:10:53.27,Default,,0,0,0,,Хорсудоны бір соққымен жару...
Dialogue: 0,0:10:53.90,0:10:56.32,Default,,0,0,0,,Мына жігіттің шығанағы не...
Dialogue: 0,0:10:56.61,0:10:58.90,Default,,0,0,0,,Жасайық, Вакия-кун
Dialogue: 0,0:10:58.99,0:10:59.82,Default,,0,0,0,,Ах
Dialogue: 0,0:11:00.24,0:11:03.12,Default,,0,0,0,,Финалға дейін жаттығу кестесі ретінде пайдалануға рұқсат етіңіздер.
Dialogue: 0,0:11:03.53,0:11:05.91,Default,,0,0,0,,Сіз тым сенімдісіз.
Dialogue: 0,0:11:05.99,0:11:07.29,Default,,0,0,0,,Олай болса мен үшін жеңіл...
Dialogue: 0,0:11:07.37,0:11:10.46,Default,,0,0,0,,Кішкене абайлап күресуді үйрену керек.
Dialogue: 0,0:11:10.67,0:11:12.63,Default,,0,0,0,,Эй, мен айтайын.
Dialogue: 0,0:11:12.96,0:11:14.38,Default,,0,0,0,,Нағыз сенімділік дегеніміз не?
Dialogue: 0,0:11:14.46,0:11:16.92,Default,,0,0,0,,Мен сияқты шын мықты болмасаң
Dialogue: 0,0:11:17.00,0:11:18.63,Default,,0,0,0,,Менің ойымша, бұл сізде болмауы керек.
Dialogue: 0,0:11:19.13,0:11:20.63,Default,,0,0,0,,Сол екілену...
Dialogue: 0,0:11:20.72,0:11:22.39,Default,,0,0,0,,Мені бірден жап
Dialogue: 0,0:11:24.85,0:11:27.10,Default,,0,0,0,,Түсіндім! Салмақты кеудеше!
Dialogue: 0,0:11:27.18,0:11:28.68,Default,,0,0,0,,Бұрынғыдан да ауыр...
Dialogue: 0,0:11:29.23,0:11:31.60,Default,,0,0,0,,Хаха~ Мен жаттығып жатырмын.
Dialogue: 0,0:11:31.94,0:11:34.15,Default,,0,0,0,,У-ны не нәрсеге байсалды етті?
Dialogue: 0,0:11:34.23,0:11:35.69,Default,,0,0,0,,Сіз өкінесіз.
Dialogue: 0,0:11:36.40,0:11:39.15,Default,,0,0,0,,Мен сені жақсы көремін, «байыпты» сөзі
Dialogue: 0,0:11:39.32,0:11:41.95,Default,,0,0,0,,Керемет, бұл құмарлық сезім
Dialogue: 0,0:11:42.15,0:11:43.74,Default,,0,0,0,,Бірінші шайқас!
Dialogue: 0,0:11:44.62,0:11:45.66,Default,,0,0,0,,мотивацияң — мүлде басқаша болады ғой?
Dialogue: 0,0:11:49.54,0:11:50.66,Default,,0,0,0,,Вакия-кун
Dialogue: 0,0:11:50.75,0:11:53.67,Default,,0,0,0,,Өткен күнгі Ходжи-кунмен кездесу тамаша өтті.
Dialogue: 0,0:11:53.87,0:11:55.63,Default,,0,0,0,,Бірақ маған қарсы...
Dialogue: 0,0:11:55.71,0:11:57.96,Default,,0,0,0,,Біз бірдей өнімділікке қол жеткізе аламыз ба?
Dialogue: 0,0:11:58.05,0:11:59.96,Default,,0,0,0,,Вайверн тіпті ұлттық турнирде де...
Dialogue: 0,0:12:00.05,0:12:02.01,Default,,0,0,0,,Бұл чемпионатқа жетуге болатын деңгей.
Dialogue: 0,0:12:02.13,0:12:03.84,Default,,0,0,0,,Мен саған көп нәрсені көрсетемін!
Dialogue: 0,0:12:03.93,0:12:07.43,Default,,0,0,0,,Бұл шайқасты тек біз ғана көріп отырғанымыз ұят.
Dialogue: 0,0:12:07.51,0:12:09.52,Default,,0,0,0,,Мен де ағама көрсеткім келді.
Dialogue: 0,0:12:09.85,0:12:10.85,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:12.77,0:12:14.06,Default,,0,0,0,,(Жазу түймесін басқан дыбыс)
Dialogue: 0,0:12:14.15,0:12:15.94,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:12:16.36,0:12:19.53,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:12:19.98,0:12:22.19,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:12:22.28,0:12:23.36,Default,,0,0,0,,Жарқыраған
Dialogue: 0,0:12:26.07,0:12:29.70,Default,,0,0,0,,Циллион Зевс қабатының металл шары қозғалғанда
Dialogue: 0,0:12:29.79,0:12:33.41,Default,,0,0,0,,Шексіздік дискінің орталықтан тепкіш күші одан сайын күшейеді.
Dialogue: 0,0:12:34.04,0:12:36.04,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:12:37.33,0:12:39.50,Default,,0,0,0,,Жүр! Вайверн!
Dialogue: 0,0:12:45.26,0:12:47.93,Default,,0,0,0,,Қалқан апаты~!
Dialogue: 0,0:12:50.89,0:12:52.56,Default,,0,0,0,,Виверн жүр!
Dialogue: 0,0:12:52.64,0:12:53.39,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:53.48,0:12:57.23,Default,,0,0,0,,Сеустың алты пышақтары арқылы толығымен жабылған.
Dialogue: 0,0:12:57.86,0:13:00.07,Default,,0,0,0,,Әй... Ондай нәрсе бар ма?
Dialogue: 0,0:13:00.36,0:13:01.40,Default,,0,0,0,,Хехе
Dialogue: 0,0:13:01.48,0:13:02.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:02.32,0:13:06.74,Default,,0,0,0,,Бұл Zillion Zeus Metal салмағының драйвері
Dialogue: 0,0:13:06.82,0:13:08.24,Default,,0,0,0,,Шу!
Dialogue: 0,0:13:09.24,0:13:10.33,Default,,0,0,0,,Ах
Dialogue: 0,0:13:10.41,0:13:12.58,Default,,0,0,0,,Shield Crash тыңдамайды
Dialogue: 0,0:13:13.83,0:13:15.50,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:13:16.83,0:13:17.79,Default,,0,0,0,,Не? Ит пе?
Dialogue: 0,0:13:19.79,0:13:20.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:21.46,0:13:22.38,Default,,0,0,0,,Мен бұны бұрыннан-ақ есіме түсіріп қойдым, білесің бе.
Dialogue: 0,0:13:22.92,0:13:25.97,Default,,0,0,0,,Ба ба ба… жарқыраған аяқтау.
Dialogue: 0,0:13:26.05,0:13:28.55,Default,,0,0,0,,Циллион Зевстің жеңісі...
Dialogue: 0,0:13:28.64,0:13:29.89,Default,,0,0,0,,Жақсы
Dialogue: 0,0:13:30.43,0:13:31.93,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:13:32.01,0:13:32.89,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:13:32.97,0:13:33.77,Default,,0,0,0,,Жарғанат!
Dialogue: 0,0:13:33.97,0:13:36.39,Default,,0,0,0,,Бұл сіздің қазіргі қабілетіңіз
Dialogue: 0,0:13:36.48,0:13:39.86,Default,,0,0,0,,Көп жұмыс істеп, шынайы сенімділікке ие бол
Dialogue: 0,0:13:39.94,0:13:41.36,Default,,0,0,0,,Олай болса қоштасу.
Dialogue: 0,0:13:41.86,0:13:42.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:43.03,0:13:45.78,Default,,0,0,0,,Күте тұрыңыз! бейблейд маскасы
Dialogue: 0,0:13:51.66,0:13:53.62,Default,,0,0,0,,Менмен бала
Dialogue: 0,0:13:53.70,0:13:56.87,Default,,0,0,0,,Мен сені Бейблейдтің дұрыс жолына апардым.
Dialogue: 0,0:13:56.96,0:14:01.09,Default,,0,0,0,,Бұл Бейблейдтің махаббат пен әділет маскасы! Жақсы
Dialogue: 0,0:14:01.29,0:14:04.38,Default,,0,0,0,,Сіз бейблейд маскасына өте байсалдысыз
Dialogue: 0,0:14:04.46,0:14:05.38,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:05.46,0:14:06.92,Default,,0,0,0,,Шляпа о~
Dialogue: 0,0:14:08.34,0:14:10.51,Default,,0,0,0,,Гаа~!
Dialogue: 0,0:14:10.59,0:14:11.60,Default,,0,0,0,,Itte Itte…
Dialogue: 0,0:14:11.68,0:14:13.81,Default,,0,0,0,,Ол менің ағама ұқсайды.
Dialogue: 0,0:14:13.89,0:14:15.52,Default,,0,0,0,,Алып-соғып кеткенде
Dialogue: 0,0:14:15.60,0:14:16.73,Default,,0,0,0,,Нуа~т
Dialogue: 0,0:14:16.81,0:14:17.98,Default,,0,0,0,,Со-бат!
Dialogue: 0,0:14:18.19,0:14:20.48,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:14:20.56,0:14:24.19,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:14:24.61,0:14:26.40,Default,,0,0,0,,Барт...Барт
Dialogue: 0,0:14:26.49,0:14:27.99,Default,,0,0,0,,Тағы біреуін жасаймыз ба?
Dialogue: 0,0:14:28.32,0:14:30.74,Default,,0,0,0,,О... о~
Dialogue: 0,0:14:30.87,0:14:32.99,Default,,0,0,0,,Гуннунну...
Dialogue: 0,0:14:33.08,0:14:34.87,Default,,0,0,0,,Жарайды... Жарайды...
Dialogue: 0,0:14:34.95,0:14:36.33,Default,,0,0,0,,Соңғысы
Dialogue: 0,0:14:36.75,0:14:38.16,Default,,0,0,0,,Кеттік...!
Dialogue: 0,0:14:38.79,0:14:40.17,Default,,0,0,0,,Асық...
Dialogue: 0,0:14:40.25,0:14:41.29,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:14:41.38,0:14:42.63,Default,,0,0,0,,♬~
Dialogue: 0,0:14:43.21,0:14:45.25,Default,,0,0,0,,Ах... Хе...
Dialogue: 0,0:14:45.34,0:14:46.55,Default,,0,0,0,,О!
Dialogue: 0,0:14:46.63,0:14:49.63,Default,,0,0,0,,А... Не істеп жатырсың, Кумичо?
Dialogue: 0,0:14:51.39,0:14:52.39,Default,,0,0,0,,Міне!
Dialogue: 0,0:14:52.47,0:14:54.26,Default,,0,0,0,,Куу~ (Рантаро)~
Dialogue: 0,0:14:54.35,0:14:56.64,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:14:56.72,0:15:01.65,Default,,0,0,0,,Китата мырза
Dialogue: 0,0:15:19.04,0:15:21.46,Default,,0,0,0,,Мен не істедім...
Dialogue: 0,0:15:27.55,0:15:29.47,Default,,0,0,0,,Сіз жеңдіңіз
Dialogue: 0,0:15:29.55,0:15:31.09,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:15:31.88,0:15:34.97,Default,,0,0,0,,Мен... тәртіп бұздым...
Dialogue: 0,0:15:35.35,0:15:37.26,Default,,0,0,0,,Неге жасырып жатырсың?
Dialogue: 0,0:15:37.35,0:15:40.18,Default,,0,0,0,,Тағы бір жеңіс және бұл ұлттық турнир.
Dialogue: 0,0:15:40.39,0:15:41.64,Default,,0,0,0,,Ел бойынша…
Dialogue: 0,0:15:42.19,0:15:43.10,Default,,0,0,0,,Уф!
Dialogue: 0,0:15:44.15,0:15:45.31,Default,,0,0,0,,Куу…
Dialogue: 0,0:15:45.48,0:15:47.52,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:15:47.61,0:15:49.15,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:15:49.23,0:15:50.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:57.37,0:15:59.75,Default,,0,0,0,,Мен... кейде ойлаймын...
Dialogue: 0,0:16:00.08,0:16:01.08,Default,,0,0,0,,А...?
Dialogue: 0,0:16:02.50,0:16:05.79,Default,,0,0,0,,Маған таң қалдым, ол Бэйді неге сонша қатты ойнайды?
Dialogue: 0,0:16:07.04,0:16:07.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:08.75,0:16:10.21,Default,,0,0,0,,Жауабы...?
Dialogue: 0,0:16:10.34,0:16:11.80,Default,,0,0,0,,Шынында да. Мен оны жеңілдетіп бағаладым. Шынында да жеңілдетіп бағаладым
Dialogue: 0,0:16:12.51,0:16:14.89,Default,,0,0,0,,Бірақ мен жеңген кезде ойлаймын
Dialogue: 0,0:16:15.22,0:16:18.01,Default,,0,0,0,,Ол Бейде ойнағанына өте қуанышты екенін айтты.
Dialogue: 0,0:16:18.72,0:16:20.06,Default,,0,0,0,,Мен...
Dialogue: 0,0:16:20.72,0:16:23.89,Default,,0,0,0,,Мен Беймен кездескеніме қуаныштымын...
Dialogue: 0,0:16:25.77,0:16:26.86,Default,,0,0,0,,Ах
Dialogue: 0,0:16:27.40,0:16:29.15,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:16:34.95,0:16:37.03,Default,,0,0,0,,Кешіріңіз Deathsizer
Dialogue: 0,0:16:38.58,0:16:39.99,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:16:40.12,0:16:42.20,Default,,0,0,0,,(жылайды)
Dialogue: 0,0:16:48.54,0:16:49.75,Default,,0,0,0,,Ой...
Dialogue: 0,0:16:51.09,0:16:52.21,Default,,0,0,0,,А...
Dialogue: 0,0:16:53.97,0:16:55.22,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:16:55.30,0:16:56.89,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:16:56.97,0:16:58.68,Default,,0,0,0,,Ана
Dialogue: 0,0:17:00.26,0:17:01.47,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:17:02.18,0:17:04.35,Default,,0,0,0,,Менің қарным ашты...
Dialogue: 0,0:17:04.44,0:17:06.56,Default,,0,0,0,,
Dialogue: 0,0:17:06.65,0:17:11.19,Default,,0,0,0,,Гу~… Гу~... Хмф
Dialogue: 0,0:17:11.32,0:17:12.36,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:13.36,0:17:14.40,Default,,0,0,0,,Ах~
Dialogue: 0,0:17:14.65,0:17:16.24,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,0:17:17.66,0:17:18.57,Default,,0,0,0,,А...?
Dialogue: 0,0:17:18.66,0:17:20.16,Default,,0,0,0,,Хехехе
Dialogue: 0,0:17:21.04,0:17:23.33,Default,,0,0,0,,Бұл арман...
Dialogue: 0,0:17:23.66,0:17:26.08,Default,,0,0,0,,Сене алмайсың, Бар-нии.
Dialogue: 0,0:17:26.17,0:17:28.88,Default,,0,0,0,,Біз де бұл арман шығар деп ойладық.
Dialogue: 0,0:17:28.96,0:17:31.71,Default,,0,0,0,,Мынаны жеп болған соң, менімен Бейбатл өткізейік.
Dialogue: 0,0:17:31.80,0:17:33.51,Default,,0,0,0,,Ааа~
Dialogue: 0,0:17:36.88,0:17:38.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:41.43,0:17:42.93,Default,,0,0,0,,Na~is
Dialogue: 0,0:17:43.81,0:17:45.81,Default,,0,0,0,,Бұл бірінші шайқас.
Dialogue: 0,0:17:46.48,0:17:47.64,Default,,0,0,0,,Балто-кун
Dialogue: 0,0:17:47.73,0:17:50.98,Default,,0,0,0,,Мен сенің бар күшіңмен атып жатқаныңды көргім келгендіктен келдім.
Dialogue: 0,0:17:51.07,0:17:54.28,Default,,0,0,0,,Жарайды, мен саған бар күшіммен атуды көрсетемін!
Dialogue: 0,0:17:55.07,0:17:56.03,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:56.11,0:17:58.16,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:17:59.66,0:18:02.37,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:02.95,0:18:05.04,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:05.12,0:18:06.12,Default,,0,0,0,,Жарқыраған
Dialogue: 0,0:18:09.96,0:18:11.96,Default,,0,0,0,,Менің оянған Валькириім
Dialogue: 0,0:18:12.04,0:18:14.38,Default,,0,0,0,,Мен кез келген шығанақты құртамын!
Dialogue: 0,0:18:15.46,0:18:17.67,Default,,0,0,0,,Тез ату!
Dialogue: 0,0:18:17.88,0:18:19.80,Default,,0,0,0,,Циллион Зевске қарсы тиімді емес
Dialogue: 0,0:18:20.14,0:18:22.18,Default,,0,0,0,,Циллион Зевстің алты жүзі...
Dialogue: 0,0:18:22.26,0:18:24.26,Default,,0,0,0,,Валькириден аулақ болыңыз!
Dialogue: 0,0:18:26.48,0:18:28.60,Default,,0,0,0,,Валькирияның шыдамы таусылды
Dialogue: 0,0:18:29.02,0:18:30.40,Default,,0,0,0,,Әлі жоқ~
Dialogue: 0,0:18:30.48,0:18:32.44,Default,,0,0,0,,Алға, Валькири!
Dialogue: 0,0:18:34.86,0:18:36.32,Default,,0,0,0,,(Қабырғаны тырнау дыбысы)
Dialogue: 0,0:18:36.61,0:18:37.65,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:18:37.74,0:18:40.03,Default,,0,0,0,,Қабырғаға соғылып, жылдамдығым артты!
Dialogue: 0,0:18:40.11,0:18:41.53,Default,,0,0,0,,Жүр!
Dialogue: 0,0:18:42.20,0:18:43.78,Default,,0,0,0,,Зевс көшті!
Dialogue: 0,0:18:44.03,0:18:47.16,Default,,0,0,0,,Мен мұны істеймін... бірақ менде ұзақ жол бар.
Dialogue: 0,0:18:47.87,0:18:49.25,Default,,0,0,0,,Салмақ жүргізушісі
Dialogue: 0,0:18:49.33,0:18:50.37,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:18:50.46,0:18:51.54,Default,,0,0,0,,(Шығанақтың дыбысы)
Dialogue: 0,0:18:51.63,0:18:53.09,Default,,0,0,0,,Ааа~
Dialogue: 0,0:18:53.17,0:18:55.17,Default,,0,0,0,,Валькирия! Ах~
Dialogue: 0,0:18:55.25,0:18:56.92,Default,,0,0,0,,Уау~
Dialogue: 0,0:18:57.01,0:18:58.01,Default,,0,0,0,,Ах, Бал-нии
Dialogue: 0,0:18:58.09,0:18:58.92,Default,,0,0,0,,Аға?
Dialogue: 0,0:18:59.01,0:19:00.68,Default,,0,0,0,,Бал-нии, жақсысың ба?
Dialogue: 0,0:19:00.76,0:19:02.34,Default,,0,0,0,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:19:02.43,0:19:04.26,Default,,0,0,0,,Тағы бір...
Dialogue: 0,0:19:04.35,0:19:06.89,Default,,0,0,0,,Жедел ату…
Dialogue: 0,0:19:06.97,0:19:08.64,Default,,0,0,0,,Мен ұйықтап жатырмын...
Dialogue: 0,0:19:08.93,0:19:11.77,Default,,0,0,0,,Бал-нии! Бар-нии
Dialogue: 0,0:19:12.98,0:19:16.15,Default,,0,0,0,,Бұлай болса, аға, енді қайталанбайды.
Dialogue: 0,0:19:17.07,0:19:18.82,Default,,0,0,0,,Бейблейд маскасы
Dialogue: 0,0:19:18.90,0:19:20.11,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:20.53,0:19:23.99,Default,,0,0,0,,Сіздің ағаңыз жақсы Блейдер.
Dialogue: 0,0:19:24.91,0:19:28.16,Default,,0,0,0,,Мен Циллион Зевсімді жиі ауыстырдым.
Dialogue: 0,0:19:28.62,0:19:32.21,Default,,0,0,0,,Қабырғаға соғылып, одан да жылдамдату...
Dialogue: 0,0:19:32.88,0:19:35.21,Default,,0,0,0,,Мен қайтадан шайқасқа шығуды асыға күтемін.
Dialogue: 0,0:19:35.59,0:19:38.01,Default,,0,0,0,,Бейблейд маскасына рахмет
Dialogue: 0,0:19:38.17,0:19:39.67,Default,,0,0,0,,Олай болса, қош бол!
Dialogue: 0,0:19:39.88,0:19:41.09,Default,,0,0,0,,Ой!
Dialogue: 0,0:19:41.18,0:19:42.84,Default,,0,0,0,,Гьяа, тобық...
Dialogue: 0,0:19:42.93,0:19:44.22,Default,,0,0,0,,Ах~
Dialogue: 0,0:19:44.30,0:19:46.35,Default,,0,0,0,,Тобық...
Dialogue: 0,0:19:46.51,0:19:49.89,Default,,0,0,0,,Хахаха... хахаха... хехехе
Dialogue: 0,0:19:49.98,0:19:51.31,Default,,0,0,0,,Қоштасу~
Dialogue: 0,0:19:52.52,0:19:55.15,Default,,0,0,0,,Кеше қиын болды.
Dialogue: 0,0:19:55.23,0:19:57.94,Default,,0,0,0,,Ағамды саябақтан үйге апару
Dialogue: 0,0:19:58.03,0:20:00.28,Default,,0,0,0,,Ол мүлдем оянбайды.
Dialogue: 0,0:20:00.61,0:20:03.57,Default,,0,0,0,,Түнгі ұйқының арқасында мен толық қалпына келдім!
Dialogue: 0,0:20:06.28,0:20:09.16,Default,,0,0,0,,Зомби Намин Менің ағамның физикалық күші
Dialogue: 0,0:20:09.24,0:20:11.37,Default,,0,0,0,,Мен тіпті зомбилерге де жеңілмеймін!
Dialogue: 0,0:20:11.87,0:20:15.00,Default,,0,0,0,,Міне, мен кеше түс көріп, жоғалып кете жаздадым.
Dialogue: 0,0:20:15.08,0:20:16.17,Default,,0,0,0,,Кира өте икемсіз ғой, иә?
Dialogue: 0,0:20:16.25,0:20:17.92,Default,,0,0,0,,Түсіңізде де төбелесіп көрдіңіз бе?
Dialogue: 0,0:20:18.21,0:20:19.50,Default,,0,0,0,,Міне
Dialogue: 0,0:20:19.59,0:20:23.01,Default,,0,0,0,,Бейблейд Маска есімді біртүрлі жігіт пайда болады.
Dialogue: 0,0:20:23.09,0:20:23.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:24.13,0:20:26.64,Default,,0,0,0,,Уау, сенде мықты шығанақ бар.
Dialogue: 0,0:20:26.72,0:20:28.47,Default,,0,0,0,,Ол Зевс деп аталады...
Dialogue: 0,0:20:29.77,0:20:30.77,Default,,0,0,0,,Бұл...
Dialogue: 0,0:20:30.85,0:20:32.48,Default,,0,0,0,,Әй, Бар-нии
Dialogue: 0,0:20:32.56,0:20:35.94,Default,,0,0,0,,Эй, мен бүгін Кумичомен таңғы жаттығу жасадым.
Dialogue: 0,0:20:36.02,0:20:37.19,Default,,0,0,0,,Ei
Dialogue: 0,0:20:37.27,0:20:38.44,Default,,0,0,0,,Біз тек сүйіскендей боламыз.
Dialogue: 0,0:20:38.52,0:20:39.82,Default,,0,0,0,,Мен барамын
Dialogue: 0,0:20:39.90,0:20:40.90,Default,,0,0,0,,Уфу
Dialogue: 0,0:20:40.98,0:20:43.57,Default,,0,0,0,,Мұның бәрі арман деп ойлайсың.
Dialogue: 0,0:20:43.65,0:20:44.91,Default,,0,0,0,,Иә...
Dialogue: 0,0:20:45.20,0:20:46.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:46.91,0:20:48.45,Default,,0,0,0,,Бейблейд маскасы
Dialogue: 0,0:20:48.53,0:20:51.70,Default,,0,0,0,,Келесі кездескенімізде мен міндетті түрде жеңемін!
Dialogue: 0,0:20:51.79,0:20:53.75,Default,,0,0,0,,Е... ха
Dialogue: 0,0:20:55.00,0:20:56.12,Default,,0,0,0,,Не!
Dialogue: 0,0:20:56.21,0:20:57.17,Default,,0,0,0,,Қазір...
Dialogue: 0,0:20:57.54,0:20:59.00,Default,,0,0,0,,(тықылдаған дыбыс)
Dialogue: 0,0:20:59.09,0:21:01.63,Default,,0,0,0,,Зак мырза, сіздің кезегіңіз. өтінемін
Dialogue: 0,0:21:01.71,0:21:04.09,Default,,0,0,0,,Жарайды, мен қазір барамын.
Dialogue: 0,0:21:09.51,0:21:11.77,Default,,0,0,0,,Қайырлы таң~ Кумичо!
Dialogue: 0,0:21:11.85,0:21:13.18,Default,,0,0,0,,Жасайық, таңғы жаттығу
Dialogue: 0,0:21:13.27,0:21:15.48,Default,,0,0,0,,Менімен бірге болғандарыңызға рахмет.
Dialogue: 0,0:21:19.69,0:21:20.82,Default,,0,0,0,,Міне
Dialogue: 0,0:21:20.98,0:21:21.94,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:22.03,0:21:23.49,Default,,0,0,0,,Не болды? Кумичо
Dialogue: 0,0:21:23.65,0:21:24.82,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:25.03,0:21:26.82,Default,,0,0,0,,Дина жақында келді...
Dialogue: 0,0:21:26.91,0:21:28.82,Default,,0,0,0,,Таңертең де жаттығады ма?
Dialogue: 0,0:21:28.91,0:21:30.33,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:21:30.41,0:21:31.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:31.41,0:21:34.08,Default,,0,0,0,,Жоқ... не?
Dialogue: 0,0:21:34.79,0:21:35.96,Default,,0,0,0,,Дина...
Dialogue: 0,0:21:37.46,0:21:38.46,Default,,0,0,0,,Не деген…
Dialogue: 0,0:21:39.17,0:21:40.92,Default,,0,0,0,,Динаға не болды?
Dialogue: 0,0:21:41.00,0:21:42.50,Default,,0,0,0,,Кумичо…
Dialogue: 0,0:21:42.84,0:21:45.05,Default,,0,0,0,,Не болды?
Dialogue: 0,0:21:47.01,0:21:48.30,Default,,0,0,0,,Ол...
Dialogue: 0,0:21:48.80,0:21:50.39,Default,,0,0,0,,Бей клубынан шығу
Dialogue: 0,0:21:51.26,0:21:52.14,Default,,0,0,0,,А...
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Артынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.40,0:23:30.40,Default,,0,0,0,,Дина, мен сенің қиналғаныңды түсінбедім.
Dialogue: 0,0:23:30.49,0:23:33.66,Default,,0,0,0,,Айтыңызшы, мен Бэйді тастап жатқаным өтірік!
Dialogue: 0,0:23:33.74,0:23:35.78,Default,,0,0,0,,Аймақтық іріктеу турнирінің финалы
Dialogue: 0,0:23:35.87,0:23:37.58,Default,,0,0,0,,Күміс жүз Орочи және Один
Dialogue: 0,0:23:37.66,0:23:39.79,Default,,0,0,0,,Мен шайқасқа назар аударуым керек...
Dialogue: 0,0:23:39.87,0:23:41.75,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:23:42.21,0:23:44.08,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:44.17,0:23:46.46,Default,,0,0,0,,Шешіңіз! Бүкіл ел бойынша қатысады!
Dialogue: 0,0:23:46.55,0:23:48.34,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.42,0:23:50.01,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.51,0:23:57.51,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory