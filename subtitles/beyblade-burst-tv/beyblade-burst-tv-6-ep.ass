Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.00,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.13,0:00:12.42,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.63,0:00:14.68,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.76,0:00:17.05,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.14,0:00:18.68,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.31,0:00:24.10,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.23,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.31,0:00:28.65,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.53,0:00:33.32,Default,,0,0,0,,Кел, Балто.
Dialogue: 0,0:00:33.45,0:00:35.61,Default,,0,0,0,,Мен Бей жаттығуын бастаймын.
Dialogue: 0,0:00:35.70,0:00:37.03,Default,,0,0,0,,Бей жаттығулары?
Dialogue: 0,0:00:37.66,0:00:38.87,Default,,0,0,0,,Сіз менің артымнан келе аласыз ба?
Dialogue: 0,0:00:38.95,0:00:41.66,Default,,0,0,0,,Бұл ұрлық! анам
Dialogue: 0,0:00:42.66,0:00:44.91,Default,,0,0,0,,Іске қосу құрылғысын тұрақтандыру үшін күш қажет
Dialogue: 0,0:00:45.08,0:00:47.21,Default,,0,0,0,,Еденді тазалау - мұны істеудің ең жақсы жолы.
Dialogue: 0,0:00:48.88,0:00:50.80,Default,,0,0,0,,Тек орындаңыз!
Dialogue: 0,0:00:50.88,0:00:53.42,Default,,0,0,0,,Жуып алайық!
Dialogue: 0,0:00:54.51,0:00:56.93,Default,,0,0,0,,Терезелерді тазалаудың құпиясы - иығыңызды пайдалану
Dialogue: 0,0:00:57.34,0:00:59.60,Default,,0,0,0,,Жіпті тартқанда иығыңыз да маңызды.
Dialogue: 0,0:00:59.89,0:01:00.97,Default,,0,0,0,,Иық~!
Dialogue: 0,0:01:01.43,0:01:04.89,Default,,0,0,0,,Егер сіз күш салсаңыз, сіз күш аласыз және сіз екі құсты бір таспен өлтіре аласыз.
Dialogue: 0,0:01:04.98,0:01:07.52,Default,,0,0,0,,Оу!
Dialogue: 0,0:01:07.98,0:01:10.32,Default,,0,0,0,,Өйткені, негізі аяқ пен жамбас.
Dialogue: 0,0:01:10.40,0:01:11.86,Default,,0,0,0,,Бірақ мен өз күнәларыммен осылай бетпе-бет келгенім…
Dialogue: 0,0:01:12.19,0:01:15.28,Default,,0,0,0,,Аяқ пен жамбас жаттығулары!
Dialogue: 0,0:01:15.49,0:01:16.78,Default,,0,0,0,,(қаптың еденге түсірілген дыбысы)
Dialogue: 0,0:01:16.86,0:01:17.66,Default,,0,0,0,,Ана
Dialogue: 0,0:01:17.91,0:01:18.99,Default,,0,0,0,,Әрі қарай не болады? Енді не болады?
Dialogue: 0,0:01:19.12,0:01:22.49,Default,,0,0,0,,Бүгінгі күннің бәрі осы. Қолыңды жуып, үй тапсырмасын орында.
Dialogue: 0,0:01:22.58,0:01:24.16,Default,,0,0,0,,Мен бірден кешкі ас ішемін.
Dialogue: 0,0:01:24.25,0:01:24.87,Default,,0,0,0,,Иә
Dialogue: 0,0:01:24.95,0:01:26.92,Default,,0,0,0,,Мен сенен тағы да жаттығуыңды өтінемін, мама.
Dialogue: 0,0:01:34.01,0:01:34.76,Default,,0,0,0,,Әй
Dialogue: 0,0:01:42.72,0:01:45.10,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:45.43,0:01:50.61,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:02:01.91,0:02:05.29,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:02:05.79,0:02:07.91,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:02:08.33,0:02:12.46,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:12.59,0:02:15.80,Default,,0,0,0,,Дұрыс, бетпе-бет.
Dialogue: 0,0:02:15.92,0:02:22.35,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:22.64,0:02:27.06,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:27.56,0:02:32.98,Default,,0,0,0,,Ыстық және тербеліс ойнайық
Dialogue: 0,0:02:33.11,0:02:35.36,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:35.44,0:02:40.16,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:40.32,0:02:45.41,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:45.70,0:02:47.95,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:48.16,0:02:50.50,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:50.79,0:02:54.71,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:54.88,0:02:59.88,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:03:00.09,0:03:02.26,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:06.56,0:03:09.68,Default,,0,0,0,,Таэро! Бұл арнайы тренинг!
Dialogue: 0,0:03:14.23,0:03:15.57,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:03:17.28,0:03:19.28,Default,,0,0,0,,Оккиро
Dialogue: 0,0:03:20.28,0:03:22.20,Default,,0,0,0,,Иә? Бұл
Dialogue: 0,0:03:22.28,0:03:23.57,Default,,0,0,0,,Бал-нии ше?
Dialogue: 0,0:03:24.37,0:03:26.62,Default,,0,0,0,,Қазір он жылға жуық уақыт болды, иә? Ол анама тіпті кешірім сұрауға да келген жоқ
Dialogue: 0,0:03:26.70,0:03:28.29,Default,,0,0,0,,Бұл турнир Бұл турнир
Dialogue: 0,0:03:28.37,0:03:29.83,Default,,0,0,0,,Бұл турнир.
Dialogue: 0,0:03:34.75,0:03:36.88,Default,,0,0,0,,Вахахахаха!
Dialogue: 0,0:03:37.38,0:03:39.84,Default,,0,0,0,,Мен тым ерте келдім және өтетін орын ашық емес.
Dialogue: 0,0:03:39.96,0:03:42.55,Default,,0,0,0,,Балт-чан әлі ақымақ.
Dialogue: 0,0:03:44.09,0:03:46.43,Default,,0,0,0,,Мектеп әрқашан қызықсыз болса да.
Dialogue: 0,0:03:46.51,0:03:49.56,Default,,0,0,0,,Бал-нии бейге келсек, түзу.
Dialogue: 0,0:03:49.64,0:03:51.18,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:03:51.43,0:03:52.89,Default,,0,0,0,,Ku~! Жанып жатыр!
Dialogue: 0,0:03:52.98,0:03:55.02,Default,,0,0,0,,Тез шайқасайық!
Dialogue: 0,0:03:55.10,0:03:57.11,Default,,0,0,0,,Бүгін Шу-кунның кездесуі.
Dialogue: 0,0:03:57.36,0:03:59.57,Default,,0,0,0,,Бал-нидің арасында шайқас жоқ.
Dialogue: 0,0:04:02.36,0:04:04.57,Default,,0,0,0,,Ұлдар мен қыздар
Dialogue: 0,0:04:04.66,0:04:07.24,Default,,0,0,0,,Бейблейд Йонекома аудандық турнирі 3-ші кезең
Dialogue: 0,0:04:07.33,0:04:09.04,Default,,0,0,0,,Екінші күн басталады!
Dialogue: 0,0:04:09.79,0:04:12.46,Default,,0,0,0,,Бүгін пайда болған бірінші жүзік
Dialogue: 0,0:04:12.71,0:04:15.50,Default,,0,0,0,,Бұл турнирде жеңіске жетуі мүмкін үміткер
Dialogue: 0,0:04:15.58,0:04:16.83,Default,,0,0,0,,Бенишу
Dialogue: 0,0:04:17.08,0:04:18.21,Default,,0,0,0,,Және қарсы
Dialogue: 0,0:04:18.29,0:04:21.21,Default,,0,0,0,,Атсуто Такаги, бір оқпен өлтіруші
Dialogue: 0,0:04:21.42,0:04:22.92,Default,,0,0,0,,Шуу!
Dialogue: 0,0:04:27.97,0:04:29.35,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе!
Dialogue: 0,0:04:29.43,0:04:31.39,Default,,0,0,0,,Фрай Фрей Шуу!
Dialogue: 0,0:04:31.52,0:04:33.60,Default,,0,0,0,,Жарайды, Шу, қолыңнан келеді.
Dialogue: 0,0:04:33.69,0:04:35.85,Default,,0,0,0,,Мен міндетті түрде жеңілмеймін
Dialogue: 0,0:04:35.94,0:04:37.19,Default,,0,0,0,,Шулы!
Dialogue: 0,0:04:39.48,0:04:42.03,Default,,0,0,0,,Менің қарсыласым шабуыл түрі Бей.
Dialogue: 0,0:04:42.53,0:04:43.24,Default,,0,0,0,,Иә
Dialogue: 0,0:04:43.32,0:04:47.07,Default,,0,0,0,,Өйткені Шу-кунның «Дауыл стриганы» тепе-теңдік түрі.
Dialogue: 0,0:04:50.41,0:04:52.25,Default,,0,0,0,,Пайдалы шығанақ жоқ.
Dialogue: 0,0:04:52.45,0:04:54.21,Default,,0,0,0,,Менде жаман шығанақтар жоқ.
Dialogue: 0,0:04:54.54,0:04:56.12,Default,,0,0,0,,Баланс түрі болып табылады
Dialogue: 0,0:04:56.21,0:04:59.21,Default,,0,0,0,,Шұңқырдың төрт түрінің ішінде ең жеке айырмашылықтары бар.
Dialogue: 0,0:04:59.29,0:05:00.34,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:00.46,0:05:03.84,Default,,0,0,0,,Ах, әртүрлі шығанақтардың мүлдем басқа сипаттамалары бар.
Dialogue: 0,0:05:04.76,0:05:05.84,Default,,0,0,0,,Спригган
Dialogue: 0,0:05:05.97,0:05:09.30,Default,,0,0,0,,Қалған үш шығанақ түрінің әлсіз жақтарын біртіндеп өтеңіз
Dialogue: 0,0:05:09.39,0:05:11.47,Default,,0,0,0,,Бұл өзінің осал тұстарын мүмкіндігінше жойған шығанақ.
Dialogue: 0,0:05:11.68,0:05:13.93,Default,,0,0,0,,Ешқандай осал тұстарыңыздың жоқтығы таң қалдырады.
Dialogue: 0,0:05:14.39,0:05:15.89,Default,,0,0,0,,Міндетті емес.
Dialogue: 0,0:05:16.31,0:05:17.90,Default,,0,0,0,,Шабуылға төзімділік
Dialogue: 0,0:05:18.02,0:05:20.69,Default,,0,0,0,,Қорғаныстың биік шыңы бөлігі үшін
Dialogue: 0,0:05:21.11,0:05:23.03,Default,,0,0,0,,Ах! Мен бәрін жоғалтып жатырмын
Dialogue: 0,0:05:23.36,0:05:25.74,Default,,0,0,0,,Спригганның қабілеттерін қалай шығаруға болады
Dialogue: 0,0:05:25.82,0:05:28.07,Default,,0,0,0,,Бұл үлкен шеберлік пен стратегияны қажет етеді.
Dialogue: 0,0:05:28.41,0:05:29.62,Default,,0,0,0,,Эй
Dialogue: 0,0:05:29.78,0:05:33.20,Default,,0,0,0,,Оны қолданатын адамды таңдау деп аталады.
Dialogue: 0,0:05:33.37,0:05:35.96,Default,,0,0,0,,Шуға ұқсайтын би екен.
Dialogue: 0,0:05:36.04,0:05:39.88,Default,,0,0,0,,Жарайды, Көктемгі Гун Шудың серіктесі.
Dialogue: 0,0:05:40.08,0:05:41.75,Default,,0,0,0,,Бұл қиын шығанақ.
Dialogue: 0,0:05:41.84,0:05:43.84,Default,,0,0,0,,Блейдердің қабілеті тексеріледі
Dialogue: 0,0:05:44.63,0:05:47.18,Default,,0,0,0,,Қаншалықты пайдалануға болады Шуға дейін.
Dialogue: 0,0:05:48.93,0:05:51.30,Default,,0,0,0,,Өзара аралық тексеру аяқталды
Dialogue: 0,0:05:51.47,0:05:55.56,Default,,0,0,0,,Қызықты сәттер басталады!
Dialogue: 0,0:05:59.31,0:06:00.77,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:06:01.27,0:06:03.32,Default,,0,0,0,,Қарсыластың күші белгісіз
Dialogue: 0,0:06:03.48,0:06:04.61,Default,,0,0,0,,Ешқашан бағаламау
Dialogue: 0,0:06:05.53,0:06:07.20,Default,,0,0,0,,Бейбатлда абсолютті мәндер жоқ.
Dialogue: 0,0:06:08.03,0:06:09.57,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:06:10.24,0:06:13.45,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:06:14.08,0:06:16.33,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:19.92,0:06:23.96,Default,,0,0,0,,Спригган дауылы стадионның ортасында айнала бастады.
Dialogue: 0,0:06:24.05,0:06:27.22,Default,,0,0,0,,Бұл шабуыл түріндегі қарсыласқа қарсы айналдыруды мақсат ету стратегиясы ма?
Dialogue: 0,0:06:27.88,0:06:31.76,Default,,0,0,0,,Дұрыс, олар Спригганға шабуыл жасайды.
Dialogue: 0,0:06:33.64,0:06:34.64,Default,,0,0,0,,Спригган...
Dialogue: 0,0:06:34.72,0:06:36.47,Default,,0,0,0,,Мен таң қалдым!
Dialogue: 0,0:06:36.56,0:06:38.60,Default,,0,0,0,,Спригганды ары қарай қуу
Dialogue: 0,0:06:38.68,0:06:40.14,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:06:40.52,0:06:41.52,Default,,0,0,0,,Шу-кун!
Dialogue: 0,0:06:44.94,0:06:45.73,Default,,0,0,0,,(Сирена қосылады)
Dialogue: 0,0:06:49.28,0:06:50.36,Default,,0,0,0,,Не!
Dialogue: 0,0:06:50.45,0:06:53.66,Default,,0,0,0,,Спригганның қозғалысы өзгерді!
Dialogue: 0,0:06:54.33,0:06:55.08,Default,,0,0,0,,Жарайды
Dialogue: 0,0:06:57.45,0:07:00.33,Default,,0,0,0,,Спригган Бұл әдеттен тыс шабуыл.
Dialogue: 0,0:07:00.46,0:07:02.08,Default,,0,0,0,,Қандай маневрлік!
Dialogue: 0,0:07:02.21,0:07:03.54,Default,,0,0,0,,Шынайы түрлендіруші
Dialogue: 0,0:07:03.63,0:07:04.46,Default,,0,0,0,,Бл…ээ…!!
Dialogue: 0,0:07:04.59,0:07:06.21,Default,,0,0,0,,Unite Driver қуаты?
Dialogue: 0,0:07:06.92,0:07:08.67,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:07:10.80,0:07:13.85,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:07:13.93,0:07:16.56,Default,,0,0,0,,Сторм Спригган 2 ұпай алады
Dialogue: 0,0:07:16.64,0:07:19.10,Default,,0,0,0,,Бенишудың тамаша жеңісі
Dialogue: 0,0:07:19.39,0:07:22.40,Default,,0,0,0,,Жарайсыңдар! Бұл керемет Шуу
Dialogue: 0,0:07:22.52,0:07:25.52,Default,,0,0,0,,Мен сенің қорқып кеткеніңді қаламаймын.
Dialogue: 0,0:07:25.61,0:07:28.23,Default,,0,0,0,,Бірақ ол жақтан жасалған қарсы шабуыл керемет болды.
Dialogue: 0,0:07:28.32,0:07:31.32,Default,,0,0,0,,Оны есіме алғанның өзінде жүрегім елжіреп қалады~
Dialogue: 0,0:07:31.45,0:07:32.03,Default,,0,0,0,,Салқындату
Dialogue: 0,0:07:32.11,0:07:34.53,Default,,0,0,0,,Қаздар құс па?
Dialogue: 0,0:07:34.62,0:07:35.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:36.37,0:07:37.37,Default,,0,0,0,,Ит терісі?
Dialogue: 0,0:07:37.70,0:07:38.54,Default,,0,0,0,,(ащы күлімсіреу)
Dialogue: 0,0:07:39.00,0:07:40.00,Default,,0,0,0,,Иида-кун мен Яо-санды да құттықтаймыз.
Dialogue: 0,0:07:40.29,0:07:44.33,Default,,0,0,0,,Мен Шумен финалда жекпе-жекке шыққым келеді.
Dialogue: 0,0:07:45.79,0:07:47.84,Default,,0,0,0,,Қасиетті Хорсуд
Dialogue: 0,0:07:47.96,0:07:50.97,Default,,0,0,0,,Кезекті айналдыру үшін барлығы 2 ұпай
Dialogue: 0,0:07:51.05,0:07:52.97,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:07:53.05,0:07:54.51,Default,,0,0,0,,3-ші кезеңнен өту!
Dialogue: 0,0:07:55.22,0:07:57.43,Default,,0,0,0,,Хоудзи Конта Хорсуды пайдаланып
Dialogue: 0,0:07:58.18,0:08:00.10,Default,,0,0,0,,Қарапайым жүзікке ұқсайды, бірақ
Dialogue: 0,0:08:00.22,0:08:02.23,Default,,0,0,0,,Оның астарында жатқан құдіреті өлшеусіз
Dialogue: 0,0:08:08.27,0:08:09.69,Default,,0,0,0,,Ботчан
Dialogue: 0,0:08:11.49,0:08:13.28,Default,,0,0,0,,Енді не болады?
Dialogue: 0,0:08:13.36,0:08:15.24,Default,,0,0,0,,Комурасаки Вакия
Dialogue: 0,0:08:15.32,0:08:18.58,Default,,0,0,0,,Біз барлық ойындарымызды 2:0 есебімен жеңдік.
Dialogue: 0,0:08:18.66,0:08:21.16,Default,,0,0,0,,Қарсыласыңызға бір ұпай алуға мүмкіндік бермедіңіз бе?
Dialogue: 0,0:08:21.25,0:08:23.58,Default,,0,0,0,,Оның айтарлықтай қабілеті бар.
Dialogue: 0,0:08:23.71,0:08:25.79,Default,,0,0,0,,Мен ол жігітті мектепте көрдім.
Dialogue: 0,0:08:25.88,0:08:27.84,Default,,0,0,0,,Сәлем! Бұл өру болды
Dialogue: 0,0:08:27.92,0:08:30.46,Default,,0,0,0,,Ол сонымен қатар жеңіске жету фавориттерінің бірі.
Dialogue: 0,0:08:30.59,0:08:33.17,Default,,0,0,0,,Жақсы! Мен сені кейін Bay Club-қа шақырамын.
Dialogue: 0,0:08:33.42,0:08:34.30,Default,,0,0,0,,Сіз Титантардың бір-бірімен шайқасып жатқанын айтасыз ба?
Dialogue: 0,0:08:34.38,0:08:34.97,Default,,0,0,0,,Чайнатаун болса да, ол Йокогамада ғой!
Dialogue: 0,0:08:35.55,0:08:37.85,Default,,0,0,0,,Оның өз командасы бар.
Dialogue: 0,0:08:38.39,0:08:39.01,Default,,0,0,0,,Ол ата-анасының үйіне оралды
Dialogue: 0,0:08:40.01,0:08:42.73,Default,,0,0,0,,Бұл жағдайда сіз тек бүкіл команданы әкелуіңіз керек.
Dialogue: 0,0:08:42.81,0:08:44.73,Default,,0,0,0,,Адамдар көп болған кезде қызық болады.
Dialogue: 0,0:08:46.60,0:08:47.73,Default,,0,0,0,,мұнда тұтқындарды пайдаланып көмір қазылады
Dialogue: 0,0:08:55.82,0:08:57.24,Default,,0,0,0,,Жабайы уайверн
Dialogue: 0,0:08:57.32,0:09:00.20,Default,,0,0,0,,Айналдыру арқылы бірінші болып 1 ұпай алыңыз
Dialogue: 0,0:09:00.54,0:09:02.33,Default,,0,0,0,,Ол жігіт күшті.
Dialogue: 0,0:09:02.79,0:09:05.25,Default,,0,0,0,,Енді екінші шайқас жалғасуда.
Dialogue: 0,0:09:05.37,0:09:06.21,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:09:12.38,0:09:16.09,Default,,0,0,0,,Вайверн Қарсыластың шабуылдарынан тайынбады
Dialogue: 0,0:09:18.64,0:09:19.60,Default,,0,0,0,,Ой
Dialogue: 0,0:09:19.68,0:09:21.64,Default,,0,0,0,,Керісінше, лақтырылды
Dialogue: 0,0:09:21.72,0:09:24.14,Default,,0,0,0,,шығанақ айналымы кенет төмендейді
Dialogue: 0,0:09:25.43,0:09:26.81,Default,,0,0,0,,Айналдыру аяқталуы
Dialogue: 0,0:09:27.19,0:09:28.77,Default,,0,0,0,,Бұл тамаша
Dialogue: 0,0:09:29.36,0:09:30.86,Default,,0,0,0,,Бұл мықты қорғаныс.
Dialogue: 0,0:09:30.94,0:09:33.78,Default,,0,0,0,,Комурасаки Вакия 4-ші раундқа өтеді
Dialogue: 0,0:09:33.86,0:09:35.57,Default,,0,0,0,,Құттықтаймыз
Dialogue: 0,0:09:35.65,0:09:36.86,Default,,0,0,0,,Керемет
Dialogue: 0,0:09:37.03,0:09:38.91,Default,,0,0,0,,Керемет Керемет Керемет
Dialogue: 0,0:09:39.37,0:09:41.62,Default,,0,0,0,,Барлығы керемет!
Dialogue: 0,0:09:44.45,0:09:46.50,Default,,0,0,0,,Жеңіске жеткеніңе қарамастан, қуанбайсың ба?
Dialogue: 0,0:09:46.58,0:09:47.08,Default,,0,0,0,,Иә
Dialogue: 0,0:09:47.16,0:09:50.04,Default,,0,0,0,,Мен жеңгеніме қуанбаймын. Blader жоқ.
Dialogue: 0,0:09:50.13,0:09:50.92,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:09:51.00,0:09:52.21,Default,,0,0,0,,Қызық екен
Dialogue: 0,0:09:53.30,0:09:54.51,Default,,0,0,0,,Кууу!
Dialogue: 0,0:09:54.59,0:09:56.47,Default,,0,0,0,,Өртеніп жатыр!
Dialogue: 0,0:09:57.30,0:09:58.51,Default,,0,0,0,,Жүр!
Dialogue: 0,0:09:58.80,0:10:00.51,Default,,0,0,0,,Кешіріңіз, Кумичо
Dialogue: 0,0:10:00.64,0:10:03.14,Default,,0,0,0,,Не істеп жатырсың, ақымақ?
Dialogue: 0,0:10:03.22,0:10:05.06,Default,,0,0,0,,Сол себепті кешірім сұрайсыз, солай ма?
Dialogue: 0,0:10:05.14,0:10:07.14,Default,,0,0,0,,Кешірім сұрау деген осы ма?
Dialogue: 0,0:10:07.27,0:10:07.98,Default,,0,0,0,,Не~!
Dialogue: 0,0:10:08.14,0:10:09.48,Default,,0,0,0,,Не болып жатыр?!
Dialogue: 0,0:10:14.07,0:10:15.44,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:10:15.65,0:10:17.03,Default,,0,0,0,,Are you concerned?
Dialogue: 0,0:10:17.11,0:10:20.24,Default,,0,0,0,,Ол осы турнирдің қара тұлпары.
Dialogue: 0,0:10:20.49,0:10:22.58,Default,,0,0,0,,Бұл дүниеде мұндай адамдар жоқ.
Dialogue: 0,0:10:23.03,0:10:25.49,Default,,0,0,0,,Жай ғана кездейсоқтық олай аталмайды.
Dialogue: 0,0:10:28.16,0:10:30.12,Default,,0,0,0,,Мен келдім!
Dialogue: 0,0:10:31.46,0:10:32.96,Default,,0,0,0,,Ана Ана
Dialogue: 0,0:10:33.71,0:10:35.21,Default,,0,0,0,,Бүгінгі жаттығуыңыз қандай?
Dialogue: 0,0:10:35.38,0:10:37.01,Default,,0,0,0,,О, қайта қош келдіңіз Балто
Dialogue: 0,0:10:37.09,0:10:38.55,Default,,0,0,0,,Асығыңыз, асығыңыз!
Dialogue: 0,0:10:40.43,0:10:42.55,Default,,0,0,0,,Бүгінгі күн – ең маңызды тренинг.
Dialogue: 0,0:10:45.35,0:10:46.18,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:10:46.81,0:10:48.02,Default,,0,0,0,,Егер біз сол жүк көлігінің кетуіне жол берсек, апат болар еді
Dialogue: 0,0:10:49.27,0:10:51.56,Default,,0,0,0,,Түсіру Ату
Dialogue: 0,0:10:56.07,0:10:58.15,Default,,0,0,0,,Арам шөппен ату дейсіз бе?
Dialogue: 0,0:10:58.24,0:10:58.99,Default,,0,0,0,,Айтыңызшы?
Dialogue: 0,0:10:59.07,0:11:02.45,Default,,0,0,0,,Арамшөптерді жою - түсіру қуатын жақсартудың ең жақсы жолы.
Dialogue: 0,0:11:02.53,0:11:03.32,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:11:03.41,0:11:04.62,Default,,0,0,0,,Балтоға сәттілік!
Dialogue: 0,0:11:04.70,0:11:06.74,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,0:11:06.83,0:11:09.62,Default,,0,0,0,,Анашым, бүгін керемет болдыңыз, Шу.
Dialogue: 0,0:11:11.67,0:11:12.88,Default,,0,0,0,,Гиннде
Dialogue: 0,0:11:13.17,0:11:14.34,Default,,0,0,0,,Ащы болды
Dialogue: 0,0:11:14.42,0:11:16.71,Default,,0,0,0,,Ашулансаң, күйіп кет
Dialogue: 0,0:11:17.05,0:11:19.17,Default,,0,0,0,,Ол шынымен де жеңілмейтін еді.
Dialogue: 0,0:11:19.34,0:11:20.26,Default,,0,0,0,,Иә
Dialogue: 0,0:11:20.38,0:11:23.39,Default,,0,0,0,,Мен мектепте бейблейд үйірмесін ашып жатырмын.
Dialogue: 0,0:11:23.84,0:11:25.60,Default,,0,0,0,,Қазір төртеуміз ғана.
Dialogue: 0,0:11:25.72,0:11:28.47,Default,,0,0,0,,5 адам болса мектеп директоры бекітеді.
Dialogue: 0,0:11:28.81,0:11:30.64,Default,,0,0,0,,Менің қолым кептеліп қалды.
Dialogue: 0,0:11:30.73,0:11:32.56,Default,,0,0,0,,Ах! оқыту тренингі
Dialogue: 0,0:11:32.77,0:11:35.56,Default,,0,0,0,,Түсіру…
Dialogue: 0,0:11:42.61,0:11:44.78,Default,,0,0,0,,Бейдің жаттығуы туралы ойлағаныңызға да сене алар емеспін.
Dialogue: 0,0:11:44.91,0:11:46.62,Default,,0,0,0,,Сәлеметсіз бе, бұл ана.
Dialogue: 0,0:11:46.83,0:11:49.87,Default,,0,0,0,,Мен көбірек тырысамын!
Dialogue: 0,0:11:52.62,0:11:54.83,Default,,0,0,0,,Сіз қалай ойлайсыз? Эй, керемет емес пе?
Dialogue: 0,0:11:55.00,0:11:56.75,Default,,0,0,0,,Бұл өткір кейіпкер.
Dialogue: 0,0:11:56.92,0:11:58.21,Default,,0,0,0,,Мен оны оқи алмаймын.
Dialogue: 0,0:11:58.46,0:11:59.34,Default,,0,0,0,,Не? иә?
Dialogue: 0,0:11:59.42,0:12:02.26,Default,,0,0,0,,«Beyblade Club» деп дұрыстап жазыңыз.
Dialogue: 0,0:12:02.38,0:12:05.43,Default,,0,0,0,,Бұл Бейблейд клубы ма?
Dialogue: 0,0:12:05.89,0:12:09.18,Default,,0,0,0,,Нағыз Бейблейд клубы осылай жазылған.
Dialogue: 0,0:12:09.68,0:12:11.81,Default,,0,0,0,,Бейблейд клубы
Dialogue: 0,0:12:13.44,0:12:14.81,Default,,0,0,0,,Мұнда да жоқ.
Dialogue: 0,0:12:15.23,0:12:16.98,Default,,0,0,0,,Бұл мүмкін емес, мүмкін емес, бұл мүлдем мүмкін емес
Dialogue: 0,0:12:17.36,0:12:20.69,Default,,0,0,0,,Мен Кумичо маңдайшасын оқи алмаймын, хи...
Dialogue: 0,0:12:20.78,0:12:23.86,Default,,0,0,0,,Сіз оқи алмайтын адамсыз, солай ма? Оның үстіне, ол
Dialogue: 0,0:12:23.95,0:12:24.95,Default,,0,0,0,,Тітіркендіргіш
Dialogue: 0,0:12:25.03,0:12:26.16,Default,,0,0,0,,Не!
Dialogue: 0,0:12:26.24,0:12:27.28,Default,,0,0,0,,Не болып жатыр?!
Dialogue: 0,0:12:28.53,0:12:31.54,Default,,0,0,0,,Екеуі де жетілмеген.
Dialogue: 0,0:12:31.79,0:12:33.29,Default,,0,0,0,,Сіз ересек емессіз!
Dialogue: 0,0:12:33.37,0:12:35.17,Default,,0,0,0,,Сіздің тынысыңыз тамаша, солай емес пе?
Dialogue: 0,0:12:41.13,0:12:43.76,Default,,0,0,0,,Осындай жерде ұрысып жатсаңыз ше?
Dialogue: 0,0:12:43.84,0:12:46.80,Default,,0,0,0,,Алда келе жатқан қарсыластар да мықты болады.
Dialogue: 0,0:12:47.55,0:12:48.76,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:12:48.85,0:12:52.52,Default,,0,0,0,,Қандай бекпен бетпе-бет келсем де, асық атумен соғамын.
Dialogue: 0,0:12:52.60,0:12:54.73,Default,,0,0,0,,Әй, сен тағы да қызықсың.
Dialogue: 0,0:12:54.89,0:12:56.10,Default,,0,0,0,,Не~!
Dialogue: 0,0:12:56.19,0:12:58.31,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:12:58.81,0:13:00.86,Default,,0,0,0,,Жедел түсірілімдердің кемшіліктері бар.
Dialogue: 0,0:13:01.23,0:13:02.07,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:13:02.19,0:13:04.82,Default,,0,0,0,,Менің шапшаң түсіргенімді мазақ етпе
Dialogue: 0,0:13:04.90,0:13:07.28,Default,,0,0,0,,Міне, қан басына қарай ағып жатыр.
Dialogue: 0,0:13:08.12,0:13:11.70,Default,,0,0,0,,Дина мұны пайдаланып, мен шапшаң соққы жасай алмадым.
Dialogue: 0,0:13:11.83,0:13:13.95,Default,,0,0,0,,басы
Dialogue: 0,0:13:14.29,0:13:15.41,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:13:15.50,0:13:16.46,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:13:21.38,0:13:23.46,Default,,0,0,0,,Раш түсірілімі сөзсіз керемет.
Dialogue: 0,0:13:23.55,0:13:25.17,Default,,0,0,0,,Бірақ қаншалықты керемет болса да
Dialogue: 0,0:13:25.26,0:13:27.09,Default,,0,0,0,,Егер сіз оны түсіре алмасаңыз
Dialogue: 0,0:13:27.18,0:13:28.14,Default,,0,0,0,,Жоғалту
Dialogue: 0,0:13:28.22,0:13:29.18,Default,,0,0,0,,Жоғалту?
Dialogue: 0,0:13:31.56,0:13:33.18,Default,,0,0,0,,Валькирия
Dialogue: 0,0:13:37.48,0:13:38.73,Default,,0,0,0,,Арнайы дайындық!
Dialogue: 0,0:13:39.27,0:13:40.23,Default,,0,0,0,,Арнайы дайындық?
Dialogue: 0,0:13:40.44,0:13:41.44,Default,,0,0,0,,Хун
Dialogue: 0,0:13:42.69,0:13:45.28,Default,,0,0,0,,Өз кемшіліктеріңізді қалай түзетуге болады
Dialogue: 0,0:13:45.36,0:13:46.15,Default,,0,0,0,,Қалай?
Dialogue: 0,0:13:46.70,0:13:47.61,Default,,0,0,0,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:13:48.32,0:13:49.16,Default,,0,0,0,,Тікелей
Dialogue: 0,0:13:49.82,0:13:50.99,Default,,0,0,0,,Тікелей…
Dialogue: 0,0:13:52.49,0:13:56.37,Default,,0,0,0,,«Жаман естіген дұрыс» арнайы тренинг!
Dialogue: 0,0:13:56.46,0:13:57.79,Default,,0,0,0,,Зуко!
Dialogue: 0,0:13:58.92,0:14:00.29,Default,,0,0,0,,Керемет!
Dialogue: 0,0:14:00.38,0:14:03.63,Default,,0,0,0,,Түсіндім, жаман сөздерді естуге болады, арнайы дайындық.
Dialogue: 0,0:14:04.00,0:14:05.01,Default,,0,0,0,,Лорд Тенген…
Dialogue: 0,0:14:05.09,0:14:08.80,Default,,0,0,0,,Қан бірден басыңызға түседі. Тыныштық санаңызды қалай жаттықтыруға болады.
Dialogue: 0,0:14:08.93,0:14:09.89,Default,,0,0,0,,Бұл жалғыз нәрсе
Dialogue: 0,0:14:09.97,0:14:13.93,Default,,0,0,0,,Мен Валькири үшін кез келген арнайы жаттығу жасаймын.
Dialogue: 0,0:14:14.01,0:14:14.89,Default,,0,0,0,,Газин!
Dialogue: 0,0:14:14.97,0:14:16.23,Default,,0,0,0,,Жақсы! Бастайық!
Dialogue: 0,0:14:16.31,0:14:17.06,Default,,0,0,0,,О!
Dialogue: 0,0:14:17.60,0:14:19.48,Default,,0,0,0,,Күтілгендей, ол өте жақсы сәйкес келеді.
Dialogue: 0,0:14:19.56,0:14:20.48,Default,,0,0,0,,... дұрыс па?
Dialogue: 0,0:14:23.69,0:14:25.32,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:14:25.78,0:14:28.99,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:29.11,0:14:29.70,Default,,0,0,0,,Хун
Dialogue: 0,0:14:29.78,0:14:31.66,Default,,0,0,0,,Валькири әлсіз!
Dialogue: 0,0:14:32.66,0:14:33.53,Default,,0,0,0,,Не?
Dialogue: 0,0:14:33.62,0:14:36.00,Default,,0,0,0,,Бар, ат! а!
Dialogue: 0,0:14:36.08,0:14:38.37,Default,,0,0,0,,Жоқ, Бар-нии, сонда ашулан.
Dialogue: 0,0:14:38.46,0:14:41.00,Default,,0,0,0,,Сіз Валькириді әлсіз деп атадыңыз.
Dialogue: 0,0:14:41.08,0:14:43.96,Default,,0,0,0,,Ағайын, сабырлы бол, сабырлы бол.
Dialogue: 0,0:14:44.04,0:14:44.88,Default,,0,0,0,,Хмм.
Dialogue: 0,0:14:44.96,0:14:46.17,Default,,0,0,0,,Қайталау
Dialogue: 0,0:14:46.30,0:14:47.51,Default,,0,0,0,,Мен түсіндім~
Dialogue: 0,0:14:47.59,0:14:49.84,Default,,0,0,0,,Бұл не? Сенімен бәрі жақсы ма?
Dialogue: 0,0:14:52.60,0:14:57.06,Default,,0,0,0,,Жоқ, жоқ, сабырлы, сабырлы, сабырлы!
Dialogue: 0,0:14:57.14,0:14:59.14,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:14:59.89,0:15:02.90,Default,,0,0,0,,Сабыр сақтаңыз!
Dialogue: 0,0:15:03.36,0:15:05.77,Default,,0,0,0,,Қарғыс атсын, Балто!
Dialogue: 0,0:15:06.03,0:15:07.23,Default,,0,0,0,,Бір ұяшық!
Dialogue: 0,0:15:07.32,0:15:09.07,Default,,0,0,0,,Көңілді адам! Бугер шайтан!
Dialogue: 0,0:15:09.15,0:15:10.53,Default,,0,0,0,,Сыңқылдаған бас!
Dialogue: 0,0:15:10.61,0:15:12.03,Default,,0,0,0,,Қашқын ақымақ~
Dialogue: 0,0:15:12.24,0:15:13.57,Default,,0,0,0,,Чикокума~
Dialogue: 0,0:15:13.66,0:15:15.08,Default,,0,0,0,,Төсек сулап жатқан бала~
Dialogue: 0,0:15:15.16,0:15:16.16,Default,,0,0,0,,Мұны істеме!
Dialogue: 0,0:15:18.04,0:15:19.37,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:20.37,0:15:22.54,Default,,0,0,0,,Кешіріңіз Валькири Кешіріңіз
Dialogue: 0,0:15:22.63,0:15:23.50,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:24.00,0:15:25.71,Default,,0,0,0,,Ах! Вакия!
Dialogue: 0,0:15:25.92,0:15:27.71,Default,,0,0,0,,Не? Келдің бе?
Dialogue: 0,0:15:27.92,0:15:30.13,Default,,0,0,0,,Сіз Bay Club-қа қосыласыз.
Dialogue: 0,0:15:30.22,0:15:32.13,Default,,0,0,0,,Жарайды, бірге шайқасайық.
Dialogue: 0,0:15:32.22,0:15:36.47,Default,,0,0,0,,Сен ақымақсың ба? Неге мен оған кіре алмаймын?
Dialogue: 0,0:15:36.56,0:15:37.22,Default,,0,0,0,,Ақымаққа ұқсайды
Dialogue: 0,0:15:38.06,0:15:39.10,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:39.68,0:15:41.23,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:15:41.35,0:15:42.52,Default,,0,0,0,,Жалғызсың ба?
Dialogue: 0,0:15:44.27,0:15:46.32,Default,,0,0,0,,Қош келдіңіз, Уакия-сама.
Dialogue: 0,0:15:49.94,0:15:51.74,Default,,0,0,0,,Мен ойлағандай, Барто Аои
Dialogue: 0,0:15:52.40,0:15:54.87,Default,,0,0,0,,Әйтеуір, мен жай ғана кездейсоқ шықтым.
Dialogue: 0,0:15:55.49,0:15:58.12,Default,,0,0,0,,Оның қабілеті жоқ, ол тек ақымақ.
Dialogue: 0,0:15:59.62,0:16:01.04,Default,,0,0,0,,Вай деген кім?
Dialogue: 0,0:16:01.37,0:16:02.54,Default,,0,0,0,,Бенишу
Dialogue: 0,0:16:02.62,0:16:04.00,Default,,0,0,0,,Тек бір адам
Dialogue: 0,0:16:04.17,0:16:05.83,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:16:05.92,0:16:07.92,Default,,0,0,0,,Үшінші турдан өткеніңізбен құттықтаймыз
Dialogue: 0,0:16:08.05,0:16:09.46,Default,,0,0,0,,Сізді не бақытты етеді?
Dialogue: 0,0:16:09.55,0:16:10.76,Default,,0,0,0,,Тек 3-ші тур
Dialogue: 0,0:16:10.84,0:16:13.01,Default,,0,0,0,,Әрине мен жеңемін.
Dialogue: 0,0:16:13.09,0:16:15.51,Default,,0,0,0,,Дұрыс, кешіріңіз.
Dialogue: 0,0:16:17.51,0:16:19.35,Default,,0,0,0,,Хоудзиді жаттықтырайық
Dialogue: 0,0:16:19.43,0:16:20.47,Default,,0,0,0,,Иә, кішкентай бала.
Dialogue: 0,0:16:21.60,0:16:24.98,Default,,0,0,0,,Вакия, Комурасаки отбасынан шыққан адам.
Dialogue: 0,0:16:25.27,0:16:27.44,Default,,0,0,0,,Қандай жағдай болса да, мен жеңбеймін.
Dialogue: 0,0:16:27.77,0:16:28.44,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:28.52,0:16:29.82,Default,,0,0,0,,Ең жақсы бол
Dialogue: 0,0:16:30.90,0:16:32.78,Default,,0,0,0,,Сөзсіз жеңіңіз!
Dialogue: 0,0:16:35.20,0:16:37.41,Default,,0,0,0,,Бей бұл вивернді жеңу үшін
Dialogue: 0,0:16:37.49,0:16:38.95,Default,,0,0,0,,Бұл дүниеде орын жоқ.
Dialogue: 0,0:16:39.20,0:16:40.24,Default,,0,0,0,,Синдо Сасаки
Dialogue: 0,0:16:40.33,0:16:42.33,Default,,0,0,0,,Бүгін баланс түріндегі ұяны пайдаланыңыз.
Dialogue: 0,0:16:42.41,0:16:43.37,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:16:44.62,0:16:47.79,Default,,0,0,0,,Екеуің өздеріңді Спригган деп кейіп көрсетесіңдер.
Dialogue: 0,0:16:47.88,0:16:49.59,Default,,0,0,0,,Виверннің шабуылына ұшырады
Dialogue: 0,0:16:49.67,0:16:51.34,Default,,0,0,0,,Қайтадан жасаңыз!
Dialogue: 0,0:16:51.88,0:16:53.22,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:16:53.51,0:16:55.51,Default,,0,0,0,,Спригган олай қозғалмайды.
Dialogue: 0,0:16:55.97,0:16:58.64,Default,,0,0,0,,Балалар, сендерге күш жетпей ме?
Dialogue: 0,0:16:59.18,0:17:01.06,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:17:02.10,0:17:02.98,Default,,0,0,0,,(Қолдың тиіп тұрған дыбысы)
Dialogue: 0,0:17:03.52,0:17:06.85,Default,,0,0,0,,Бей тек сәттілікпен жеңіске жету оңай емес.
Dialogue: 0,0:17:07.81,0:17:09.40,Default,,0,0,0,,Ондай нәрсе жоқ.
Dialogue: 0,0:17:09.94,0:17:11.61,Default,,0,0,0,,Әй, дайындал!
Dialogue: 0,0:17:11.69,0:17:12.53,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:17:13.11,0:17:14.99,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:15.07,0:17:16.41,Default,,0,0,0,,Ocharake Blader
Dialogue: 0,0:17:16.49,0:17:19.20,Default,,0,0,0,,Яй Хеббоко түсіру
Dialogue: 0,0:17:19.28,0:17:21.04,Default,,0,0,0,,Шулы ма?
Dialogue: 0,0:17:21.16,0:17:22.24,Default,,0,0,0,,Хебохебо~
Dialogue: 0,0:17:22.41,0:17:23.62,Default,,0,0,0,,Цунцун басы
Dialogue: 0,0:17:23.70,0:17:24.46,Default,,0,0,0,,Га~!
Dialogue: 0,0:17:24.54,0:17:25.71,Default,,0,0,0,,Шашырау цехы~
Dialogue: 0,0:17:25.83,0:17:26.96,Default,,0,0,0,,<U.A. орта мектебі, Батырлар курсы>
Dialogue: 0,0:17:27.04,0:17:29.42,Default,,0,0,0,,Ұйқыдағы жын Уф!
Dialogue: 0,0:17:29.50,0:17:32.46,Default,,0,0,0,,Аш құбыжық (Токонацу Ника) Жылдам су жылытқышы
Dialogue: 0,0:17:36.47,0:17:39.14,Default,,0,0,0,,Иә? (Рантаро) Тағы да жоқ!
Dialogue: 0,0:17:39.76,0:17:42.81,Default,,0,0,0,,Осының бәрін жасасаңыз да, сіз мүлдем нәтиже алмайсыз.
Dialogue: 0,0:17:43.02,0:17:45.39,Default,,0,0,0,,Өйткені Бар-нии отты адам.
Dialogue: 0,0:17:45.52,0:17:47.64,Default,,0,0,0,,Бұл арнайы дайындықты босқа өткізуі мүмкін.
Dialogue: 0,0:17:48.15,0:17:50.48,Default,,0,0,0,,Валькирияның айналу жылдамдығы артып келеді.
Dialogue: 0,0:17:50.56,0:17:51.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:59.87,0:18:02.53,Default,,0,0,0,,Не? Айналу жылдамдығы артып келеді
Dialogue: 0,0:18:03.79,0:18:05.33,Default,,0,0,0,,Маған солай көрінді
Dialogue: 0,0:18:06.96,0:18:08.29,Default,,0,0,0,,Көріп көрейік
Dialogue: 0,0:18:10.63,0:18:12.42,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:18:12.50,0:18:14.63,Default,,0,0,0,,Бұл жолы ант беруге болмайды.
Dialogue: 0,0:18:14.76,0:18:17.22,Default,,0,0,0,,Үніңді жауып, қарап тұру керек.
Dialogue: 0,0:18:17.30,0:18:18.76,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:18:20.51,0:18:22.47,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:22.72,0:18:25.35,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:25.93,0:18:26.98,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:18:27.06,0:18:28.19,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:29.60,0:18:30.56,Default,,0,0,0,,Ах
Dialogue: 0,0:18:30.94,0:18:31.77,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:18:36.28,0:18:38.15,Default,,0,0,0,,Бұл сәтсіз түсірілім~
Dialogue: 0,0:18:38.24,0:18:38.78,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:38.86,0:18:41.07,Default,,0,0,0,,Бұл мүлдем басқа жол.
Dialogue: 0,0:18:41.20,0:18:41.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:44.66,0:18:48.25,Default,,0,0,0,,Бірақ оның қазіргі позициясы асығыс соққы болды.
Dialogue: 0,0:18:49.00,0:18:51.67,Default,,0,0,0,,Мен мұндай қозғалысты бұрын-соңды көрген емеспін.
Dialogue: 0,0:19:03.43,0:19:05.35,Default,,0,0,0,,Ағымдағы түсіру дегеніміз не...
Dialogue: 0,0:19:07.47,0:19:09.18,Default,,0,0,0,,Ах Шу!
Dialogue: 0,0:19:09.69,0:19:10.73,Default,,0,0,0,,Сіз жаңа көргеніңізді көрдіңіз бе?
Dialogue: 0,0:19:10.81,0:19:13.15,Default,,0,0,0,,Бұл сәтсіз түсірілген болса да, таңғажайып қозғалды
Dialogue: 0,0:19:13.23,0:19:14.23,Default,,0,0,0,,О
Dialogue: 0,0:19:14.31,0:19:18.03,Default,,0,0,0,,Әдеттегі сәтсіз түсірілімдер қандай?
Dialogue: 0,0:19:18.11,0:19:19.70,Default,,0,0,0,,Бір нәрсе дегеніміз не?
Dialogue: 0,0:19:19.82,0:19:23.07,Default,,0,0,0,,Күткендей, мен де онша түсінбеймін.
Dialogue: 0,0:19:24.28,0:19:25.49,Default,,0,0,0,,Сіз оны пайдалана аласыз~
Dialogue: 0,0:19:25.58,0:19:26.91,Default,,0,0,0,,Не?!
Dialogue: 0,0:19:26.99,0:19:30.37,Default,,0,0,0,,Бұл әзіл-қалжың, әзіл, бірақ сәл салмақты
Dialogue: 0,0:19:30.46,0:19:31.71,Default,,0,0,0,,Сіз мені қалжыңдап тұрсыз ба?
Dialogue: 0,0:19:31.79,0:19:32.92,Default,,0,0,0,,Айналу жылдамдығы!
Dialogue: 0,0:19:33.25,0:19:33.92,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:34.08,0:19:35.42,Default,,0,0,0,,Айналу жылдамдығы?
Dialogue: 0,0:19:35.54,0:19:36.63,Default,,0,0,0,,Иә.
Dialogue: 0,0:19:37.00,0:19:39.76,Default,,0,0,0,,Мен бұрын көрмеген қимылдарға алаңдадым.
Dialogue: 0,0:19:40.09,0:19:42.09,Default,,0,0,0,,Валькирияның айналу жылдамдығының өзі
Dialogue: 0,0:19:42.22,0:19:43.76,Default,,0,0,0,,Бұл, әрине, көтерілді.
Dialogue: 0,0:19:44.34,0:19:46.05,Default,,0,0,0,,шығанақтың айналу жылдамдығы қандай?
Dialogue: 0,0:19:46.14,0:19:49.39,Default,,0,0,0,,Бұл жіпті тарту жылдамдығына байланысты, солай ма?
Dialogue: 0,0:19:49.52,0:19:50.31,Default,,0,0,0,,О
Dialogue: 0,0:19:50.56,0:19:53.81,Default,,0,0,0,,Жіпті жылдам тартсаңыз, айналу жылдамдығы артады.
Dialogue: 0,0:19:54.02,0:19:55.77,Default,,0,0,0,,Ол қуатты қажет етеді
Dialogue: 0,0:19:56.19,0:19:58.32,Default,,0,0,0,,Жіпті тарту күші?
Dialogue: 0,0:19:58.73,0:20:02.40,Default,,0,0,0,,Бұл сіз осы кадрды дайындағандықтан жасай алдыңыз дегенді білдіре ме?
Dialogue: 0,0:20:02.49,0:20:03.82,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:20:03.99,0:20:06.37,Default,,0,0,0,,Бұл арнайы дайындықтың нәтижесі!
Dialogue: 0,0:20:07.87,0:20:09.20,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:20:09.29,0:20:12.54,Default,,0,0,0,,Өйткені, бұл мен ойлаған арнайы дайындық болды.
Dialogue: 0,0:20:12.62,0:20:16.92,Default,,0,0,0,,Кумичоның ойынша, оның байсалдылығын тәрбиелеу үшін арнайы жаттығу, солай емес пе?
Dialogue: 0,0:20:17.00,0:20:20.17,Default,,0,0,0,,Сіз мүлде жаттықпаған сияқтысыз...
Dialogue: 0,0:20:20.26,0:20:20.96,Default,,0,0,0,,...уф
Dialogue: 0,0:20:21.34,0:20:23.47,Default,,0,0,0,,Анамның тәрбиесінің жемісі шығар.
Dialogue: 0,0:20:23.63,0:20:24.80,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:20:25.09,0:20:27.39,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:20:27.51,0:20:31.64,Default,,0,0,0,,Біз Валькири атты жаңа техниканы ойлап таптық.
Dialogue: 0,0:20:31.73,0:20:35.19,Default,,0,0,0,,Уәде етілгендей, қазір 5 мүше бар сияқты.
Dialogue: 0,0:20:35.52,0:20:36.77,Default,,0,0,0,,Директор!
Dialogue: 0,0:20:36.94,0:20:38.48,Default,,0,0,0,,Өте көп
Dialogue: 0,0:20:38.57,0:20:42.36,Default,,0,0,0,,Енді Yonekoma Academy Бейблейд клубын ресми түрде танимыз...
Dialogue: 0,0:20:42.44,0:20:44.36,Default,,0,0,0,,О, сәл күте тұрыңыз.
Dialogue: 0,0:20:44.49,0:20:47.37,Default,,0,0,0,,Шу басқа, сондықтан әлі төрт-ақ мүше...
Dialogue: 0,0:20:47.45,0:20:49.24,Default,,0,0,0,,Сәлем! Бақабалт
Dialogue: 0,0:20:49.99,0:20:53.71,Default,,0,0,0,,Бұл Bay Club үшін, сондықтан үндемеңіз.
Dialogue: 0,0:20:53.79,0:20:55.21,Default,,0,0,0,,Барт сияқты естіледі.
Dialogue: 0,0:20:57.21,0:21:00.25,Default,,0,0,0,,Бей стадионы өтірік айтпайды
Dialogue: 0,0:21:00.38,0:21:01.30,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:01.59,0:21:06.59,Default,,0,0,0,,Бейбладердің төккен тері мен арманы осында жазылған.
Dialogue: 0,0:21:06.97,0:21:07.97,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:21:08.05,0:21:12.35,Default,,0,0,0,,Сенің Бейге деген сезімің шын...
Dialogue: 0,0:21:12.43,0:21:14.35,Default,,0,0,0,,Мүмкін бұл ағын...
Dialogue: 0,0:21:14.43,0:21:15.73,Default,,0,0,0,,Өте кешіріңіз, бірақ бізді бұны басқа уақытта жалғастыруға тура келеді.
Dialogue: 0,0:21:15.98,0:21:19.40,Default,,0,0,0,,Bay Club-қа тіпті 4 адам кіре алады
Dialogue: 0,0:21:21.90,0:21:24.36,Default,,0,0,0,,Бейблейд клубын тану
Dialogue: 0,0:21:24.74,0:21:26.82,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:26.91,0:21:29.28,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:29.45,0:21:30.66,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:30.74,0:21:31.95,Default,,0,0,0,,«Барлығын мен үшін» мұрагері…
Dialogue: 0,0:21:32.04,0:21:33.00,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:33.08,0:21:35.29,Default,,0,0,0,,Әлі де уақытша мақұлдау
Dialogue: 0,0:21:35.46,0:21:37.67,Default,,0,0,0,,Клубқа бесінші мүше кірген кезде
Dialogue: 0,0:21:37.83,0:21:41.50,Default,,0,0,0,,Оны ресми түрде Йонекома Гакуэн клубы деп танайық.
Dialogue: 0,0:21:41.67,0:21:43.38,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:21:45.51,0:21:47.51,Default,,0,0,0,,Бесінші тұлғаны міндетті түрде табыңыз.
Dialogue: 0,0:21:47.84,0:21:51.18,Default,,0,0,0,,Мен міндетті түрде Bay Club мойындаймын.
Dialogue: 0,0:21:51.39,0:21:52.85,Default,,0,0,0,,Оу!
Dialogue: 0,0:22:09.16,0:22:15.25,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.45,0:22:21.59,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады
Dialogue: 0,0:22:22.04,0:22:27.59,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.05,0:22:31.39,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.55,0:22:36.48,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.39,0:22:41.10,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.19,0:22:44.40,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.48,0:22:50.82,Default,,0,0,0,,Артынан қуып жетсең, көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:51.07,0:22:56.62,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.79,0:23:03.38,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:03.96,0:23:09.38,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.55,0:23:12.72,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.22,0:23:17.18,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:25.98,0:23:28.61,Default,,0,0,0,,Е! Менің келесі қарсыласым, Хоудзи
Dialogue: 0,0:23:28.69,0:23:30.28,Default,,0,0,0,,Матчты жеңу керек пе?
Dialogue: 0,0:23:30.45,0:23:31.57,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:23:31.66,0:23:33.62,Default,,0,0,0,,Мен матчты асыға күтемін.
Dialogue: 0,0:23:33.70,0:23:36.83,Default,,0,0,0,,Маған неге қалыс қалуға рұқсат етпеске?
Dialogue: 0,0:23:37.08,0:23:39.83,Default,,0,0,0,,Ал біз жаңа техниканы аяқтаймыз!
Dialogue: 0,0:23:40.16,0:23:42.04,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:42.12,0:23:44.13,Default,,0,0,0,,Өте жылдам! Флеш түсіру!
Dialogue: 0,0:23:44.71,0:23:46.96,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.17,0:23:48.84,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.34,0:23:56.34,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory