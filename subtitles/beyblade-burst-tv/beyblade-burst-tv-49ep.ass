Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.59,0:00:09.21,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.30,0:00:12.47,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.76,0:00:14.80,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.88,0:00:16.97,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.05,0:00:18.85,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.48,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.23,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.31,0:00:28.69,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.03,0:00:34.86,Default,,0,0,0,,Валькирия! Тағы бір жарылғыш атумен барайық!
Dialogue: 0,0:00:35.32,0:00:36.70,Default,,0,0,0,,Бұл өкінішті
Dialogue: 0,0:00:37.07,0:00:39.37,Default,,0,0,0,,Адамдар бір әдісті пайдалана аламыз деп ойлайды.
Dialogue: 0,0:00:39.95,0:00:41.91,Default,,0,0,0,,Мен супержұлдызмын
Dialogue: 0,0:00:42.95,0:00:43.87,Default,,0,0,0,,Үш
Dialogue: 0,0:00:44.75,0:00:45.67,Default,,0,0,0,,Екі
Dialogue: 0,0:00:46.42,0:00:47.46,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:00:47.54,0:00:50.67,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:50.75,0:00:51.55,Default,,0,0,0,,С-сәлем… Қалайсың? Өткенде бәрі үшін рахмет…
Dialogue: 0,0:00:54.47,0:00:56.43,Default,,0,0,0,,Ұлттық турнирдің жартылай финалы
Dialogue: 0,0:00:56.59,0:00:59.39,Default,,0,0,0,,Супержұлдыз Зактың домалау соққысы және
Dialogue: 0,0:00:59.47,0:01:02.02,Default,,0,0,0,,Менің ең жақсы шайқасым
Dialogue: 0,0:01:02.18,0:01:04.68,Default,,0,0,0,,Циллион Зевс керемет күшті болды.
Dialogue: 0,0:01:04.77,0:01:07.06,Default,,0,0,0,,Ақыры финалға шықтым
Dialogue: 0,0:01:10.32,0:01:12.44,Default,,0,0,0,,Оңтүстік крест
Dialogue: 0,0:01:13.69,0:01:15.45,Default,,0,0,0,,Үзіліс! Спригган!
Dialogue: 0,0:01:17.28,0:01:20.08,Default,,0,0,0,,Ал Шу мен Руи арасындағы жартылай финал
Dialogue: 0,0:01:20.24,0:01:22.62,Default,,0,0,0,,Бірінші шайқаста Шу жеңді.
Dialogue: 0,0:01:22.70,0:01:24.91,Default,,0,0,0,,Сол Луистің керемет аяқталуы.
Dialogue: 0,0:01:26.92,0:01:28.00,Default,,0,0,0,,Мен енді жылап жібергім келеді!
Dialogue: 0,0:01:28.54,0:01:29.46,Default,,0,0,0,,…!
Dialogue: 0,0:01:37.80,0:01:40.18,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:40.51,0:01:45.68,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:56.99,0:02:00.37,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:02:00.87,0:02:02.99,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:02:03.41,0:02:07.54,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:07.66,0:02:10.88,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:02:11.00,0:02:17.42,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:17.72,0:02:22.14,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:22.64,0:02:28.06,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:28.18,0:02:30.44,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:30.52,0:02:35.23,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:35.40,0:02:40.49,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:40.78,0:02:43.03,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:43.24,0:02:45.58,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:45.87,0:02:49.79,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:49.96,0:02:54.96,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:55.17,0:02:57.34,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:01.55,0:03:04.26,Default,,0,0,0,,Төрт айналдыратын император! Луиге қарсы Шу!
Dialogue: 0,0:03:05.05,0:03:06.10,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:06.18,0:03:07.89,Default,,0,0,0,,Не! О құдайым-ай!
Dialogue: 0,0:03:07.97,0:03:09.56,Default,,0,0,0,,Жартылай финалдың бірінші шайқасы
Dialogue: 0,0:03:09.64,0:03:11.52,Default,,0,0,0,,Кенеттен және таңғажайып даму!
Dialogue: 0,0:03:11.73,0:03:13.06,Default,,0,0,0,,Лостронгинус
Dialogue: 0,0:03:13.15,0:03:15.11,Default,,0,0,0,,2 ұпай алынып тасталды!
Dialogue: 0,0:03:15.19,0:03:17.32,Default,,0,0,0,,Куришуу, ақыры тағдырлас қарсылас
Dialogue: 0,0:03:17.40,0:03:19.82,Default,,0,0,0,,Бұрыштағы Ширасаги сарайы Луис
Dialogue: 0,0:03:20.24,0:03:21.57,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:21.65,0:03:23.62,Default,,0,0,0,,Осының бәрін бірден жасайық!
Dialogue: 0,0:03:24.07,0:03:26.33,Default,,0,0,0,,Шу екі қолын жаттықтырды.
Dialogue: 0,0:03:26.41,0:03:28.58,Default,,0,0,0,,Осы оңтүстік крест ату үшін
Dialogue: 0,0:03:29.16,0:03:30.41,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:03:30.50,0:03:33.79,Default,,0,0,0,,Шу бұл ерекше кадрға көптен бері жаттығады.
Dialogue: 0,0:03:34.25,0:03:36.21,Default,,0,0,0,,Екі қолмен бір уақытта тарту арқылы
Dialogue: 0,0:03:36.29,0:03:38.21,Default,,0,0,0,,Бейге соңғы билікті беру
Dialogue: 0,0:03:39.13,0:03:42.13,Default,,0,0,0,,Бірақ басқару шексіз қиындай түседі.
Dialogue: 0,0:03:42.68,0:03:44.64,Default,,0,0,0,,Бұл мүмкін емес дерлік.
Dialogue: 0,0:03:44.72,0:03:47.68,Default,,0,0,0,,Мыңдаған, жоқ, он мыңдаған рет тәжірибе
Dialogue: 0,0:03:47.76,0:03:49.22,Default,,0,0,0,,Мен мүмкіндік бердім
Dialogue: 0,0:03:49.47,0:03:51.43,Default,,0,0,0,,Осындай ату
Dialogue: 0,0:03:51.52,0:03:52.73,Default,,0,0,0,,Менің де қолымнан келеді
Dialogue: 0,0:03:52.94,0:03:55.90,Default,,0,0,0,,Мен де істей аламын ба...?
Dialogue: 0,0:03:55.98,0:03:57.15,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:57.23,0:03:58.44,Default,,0,0,0,,Мүмкін...?
Dialogue: 0,0:03:58.52,0:03:59.98,Default,,0,0,0,,Менің қолымнан келмесе де
Dialogue: 0,0:04:01.11,0:04:03.70,Default,,0,0,0,,Өзіңізді итермелеп жатырмын деп айтпаңыз.
Dialogue: 0,0:04:03.78,0:04:04.91,Default,,0,0,0,,Сіз қалай батылсыз!
Dialogue: 0,0:04:05.49,0:04:07.12,Default,,0,0,0,,Шеш, Шу!
Dialogue: 0,0:04:07.20,0:04:08.33,Default,,0,0,0,,Тағы бір!
Dialogue: 0,0:04:08.41,0:04:10.25,Default,,0,0,0,,Тағы бір!
Dialogue: 0,0:04:11.75,0:04:13.08,Default,,0,0,0,,Жарайды, Спригган.
Dialogue: 0,0:04:13.16,0:04:14.29,Default,,0,0,0,,Тағы біреуіне барайық.
Dialogue: 0,0:04:16.63,0:04:20.21,Default,,0,0,0,,Менің ойымша, Балто әрқашан Валькиримен осылай сөйлесетін.
Dialogue: 0,0:04:21.21,0:04:22.38,Default,,0,0,0,,Бейдің дауысы?
Dialogue: 0,0:04:22.92,0:04:24.05,Default,,0,0,0,,Бұл жақсы
Dialogue: 0,0:04:24.55,0:04:28.35,Default,,0,0,0,,(Луидің күлкісі)
Dialogue: 0,0:04:29.01,0:04:31.72,Default,,0,0,0,,Жақсы жұмыс, Лонгинустан ұпай алдым.
Dialogue: 0,0:04:31.81,0:04:32.81,Default,,0,0,0,,Мақтау
Dialogue: 0,0:04:33.94,0:04:36.35,Default,,0,0,0,,Сіз бұрынғыдан сәл күштірек болуыңыз керек.
Dialogue: 0,0:04:36.44,0:04:38.69,Default,,0,0,0,,Мен сені алдымнан шығады деп ойладым.
Dialogue: 0,0:04:40.23,0:04:41.53,Default,,0,0,0,,Ұсақталған болса да
Dialogue: 0,0:04:41.61,0:04:44.61,Default,,0,0,0,,Феникс сияқты міндетті түрде шығады
Dialogue: 0,0:04:44.70,0:04:46.57,Default,,0,0,0,,Бенишудің бәрі осы.
Dialogue: 0,0:04:48.20,0:04:50.08,Default,,0,0,0,,Мен Луиді бірінші рет көріп тұрмын.
Dialogue: 0,0:04:50.16,0:04:52.70,Default,,0,0,0,,Куришу Руиді өртеп жіберді.
Dialogue: 0,0:04:52.79,0:04:55.16,Default,,0,0,0,,Луи-сан жанып жатыр
Dialogue: 0,0:04:56.17,0:04:59.04,Default,,0,0,0,,Луидің нағыз сұмдығы әлі алда.
Dialogue: 0,0:04:59.29,0:05:01.00,Default,,0,0,0,,Оңтүстік крест
Dialogue: 0,0:05:01.09,0:05:02.13,Default,,0,0,0,,Шудың жігіті
Dialogue: 0,0:05:02.21,0:05:04.63,Default,,0,0,0,,Ол таңғажайып техниканы ойлап тапты.
Dialogue: 0,0:05:04.72,0:05:07.18,Default,,0,0,0,,Мен билікте сол Лонгинустан асып түстім.
Dialogue: 0,0:05:07.89,0:05:08.85,Default,,0,0,0,,Күшті!
Dialogue: 0,0:05:09.47,0:05:11.85,Default,,0,0,0,,Жақсы Жақсы Жақсы
Dialogue: 0,0:05:12.14,0:05:13.73,Default,,0,0,0,,Зак Сенпай
Dialogue: 0,0:05:13.81,0:05:15.94,Default,,0,0,0,,Мен бұл екеуімен күресе алмаймын.
Dialogue: 0,0:05:16.02,0:05:18.35,Default,,0,0,0,,Мен қазір қатты қайғырдым.
Dialogue: 0,0:05:18.44,0:05:20.36,Default,,0,0,0,,Сенпай зейнетке шықты, солай ма?
Dialogue: 0,0:05:20.77,0:05:23.11,Default,,0,0,0,,Жоқ. Зейнеткерлікке шығу алынып тасталды.
Dialogue: 0,0:05:23.57,0:05:26.20,Default,,0,0,0,,Мен бұл екеуімен тағы да шайқасамын.
Dialogue: 0,0:05:26.57,0:05:27.57,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:28.36,0:05:30.24,Default,,0,0,0,,Барлығы келсін
Dialogue: 0,0:05:30.33,0:05:32.20,Default,,0,0,0,,Барлығың тыңдаңдар.
Dialogue: 0,0:05:32.29,0:05:33.58,Default,,0,0,0,,Зак Күн сәулесі
Dialogue: 0,0:05:33.66,0:05:36.71,Default,,0,0,0,,Осымен мен Блейдер ретінде қайта тірілгенімді жариялаймын.
Dialogue: 0,0:05:36.79,0:05:37.71,Default,,0,0,0,,Ой
Dialogue: 0,0:05:37.79,0:05:39.83,Default,,0,0,0,,Күн жарқырап тұрғанша
Dialogue: 0,0:05:39.92,0:05:41.92,Default,,0,0,0,,Зактың жарығы өшпейді
Dialogue: 0,0:05:42.00,0:05:42.80,Default,,0,0,0,,Na~is
Dialogue: 0,0:05:43.00,0:05:45.26,Default,,0,0,0,,Мен солай болады деп ойладым.
Dialogue: 0,0:05:45.88,0:05:47.84,Default,,0,0,0,,Иә, бұл Зак Сенпай
Dialogue: 0,0:05:47.93,0:05:49.39,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:05:49.47,0:05:52.47,Default,,0,0,0,,Циллион Зевс міндетті түрде бірінші орынды алады.
Dialogue: 0,0:05:52.56,0:05:53.77,Default,,0,0,0,,Haha~n
Dialogue: 0,0:05:53.85,0:05:56.52,Default,,0,0,0,,Кя~!
Dialogue: 0,0:05:56.77,0:05:57.89,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:05:58.44,0:05:59.65,Default,,0,0,0,,Шу, бұл керемет.
Dialogue: 0,0:06:00.02,0:06:01.90,Default,,0,0,0,,Көп күш жұмсайтын кадрлар
Dialogue: 0,0:06:01.98,0:06:03.52,Default,,0,0,0,,Жоқ, Бал-нии.
Dialogue: 0,0:06:03.61,0:06:05.32,Default,,0,0,0,,Оңтүстік крест ату!
Dialogue: 0,0:06:05.40,0:06:07.86,Default,,0,0,0,,Сіз оны ойлап табу үшін көп қиындық көрдіңіз, солай ма?
Dialogue: 0,0:06:08.82,0:06:12.08,Default,,0,0,0,,Шу-кун! Оңтүстіктің тағы бір соққысы!
Dialogue: 0,0:06:12.16,0:06:13.16,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:06:13.87,0:06:15.16,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:06:16.12,0:06:18.12,Default,,0,0,0,,Оңтүстік крестпен ату
Dialogue: 0,0:06:19.00,0:06:20.12,Default,,0,0,0,,Бенишу
Dialogue: 0,0:06:20.21,0:06:21.71,Default,,0,0,0,,Мен сізді қабылдаймын
Dialogue: 0,0:06:22.75,0:06:24.71,Default,,0,0,0,,Өйткені біз оны бүгін танимыз
Dialogue: 0,0:06:25.38,0:06:28.17,Default,,0,0,0,,Мен сені осы жерде мүлде басып тастаймын
Dialogue: 0,0:06:28.34,0:06:29.51,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:06:29.59,0:06:31.59,Default,,0,0,0,,Ұпайлар жетекші болғанымен
Dialogue: 0,0:06:31.68,0:06:33.64,Default,,0,0,0,,Луис жеңісті жариялады.
Dialogue: 0,0:06:34.43,0:06:37.39,Default,,0,0,0,,Шуу сені басып кетеді!
Dialogue: 0,0:06:37.48,0:06:39.06,Default,,0,0,0,,Эй, тоқтатшы Балто!
Dialogue: 0,0:06:39.14,0:06:40.10,Default,,0,0,0,,Өйткені!
Dialogue: 0,0:06:40.19,0:06:41.69,Default,,0,0,0,,Оны екі адам естімейді.
Dialogue: 0,0:06:41.77,0:06:43.94,Default,,0,0,0,,Өйткені мен өте шоғырланғанмын.
Dialogue: 0,0:06:44.48,0:06:46.98,Default,,0,0,0,,Ол Луидің көңілінен шығатын жігіт емес.
Dialogue: 0,0:06:47.07,0:06:48.86,Default,,0,0,0,,Шуды бастыруға болмайды.
Dialogue: 0,0:06:51.78,0:06:54.12,Default,,0,0,0,,Енді науаға бет бұрыңыз
Dialogue: 0,0:06:54.20,0:06:56.99,Default,,0,0,0,,Екеуінің де рухы зор.
Dialogue: 0,0:06:59.62,0:07:00.25,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:00.67,0:07:03.67,Default,,0,0,0,,Енді сіз оны анық сездіңіз.
Dialogue: 0,0:07:03.75,0:07:04.96,Default,,0,0,0,,Қорық
Dialogue: 0,0:07:05.88,0:07:07.46,Default,,0,0,0,,Сезіммен жеңілме!
Dialogue: 0,0:07:07.80,0:07:09.05,Default,,0,0,0,,Фухаха…
Dialogue: 0,0:07:11.38,0:07:12.22,Default,,0,0,0,,…Ха!
Dialogue: 0,0:07:16.39,0:07:17.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:17.64,0:07:19.48,Default,,0,0,0,,Сенпай бұл
Dialogue: 0,0:07:19.68,0:07:20.52,Default,,0,0,0,,Иә
Dialogue: 0,0:07:23.10,0:07:25.57,Default,,0,0,0,,Жаңа техника жаңа техника ма?
Dialogue: 0,0:07:26.27,0:07:28.53,Default,,0,0,0,,Түнгі түсірілім
Dialogue: 0,0:07:29.36,0:07:31.07,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:07:31.49,0:07:34.62,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:35.07,0:07:37.41,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:38.04,0:07:38.83,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:07:38.91,0:07:40.62,Default,,0,0,0,,Луи денесі бір рет айналады
Dialogue: 0,0:07:40.71,0:07:42.83,Default,,0,0,0,,Бұл қорқынышты түсірілім
Dialogue: 0,0:07:42.92,0:07:44.83,Default,,0,0,0,,Маған қорқынышты түс көр
Dialogue: 0,0:07:44.92,0:07:45.92,Default,,0,0,0,,Лонгинус
Dialogue: 0,0:07:48.34,0:07:49.01,Default,,0,0,0,,Ах
Dialogue: 0,0:07:49.09,0:07:50.26,Default,,0,0,0,,Соқтығыс!
Dialogue: 0,0:07:52.18,0:07:53.51,Default,,0,0,0,,Спригган Додж!
Dialogue: 0,0:07:56.05,0:07:57.51,Default,,0,0,0,,Спригган жалтарып кетті
Dialogue: 0,0:07:57.60,0:07:58.89,Default,,0,0,0,,Жоғарғы түсіру
Dialogue: 0,0:08:02.35,0:08:03.02,Default,,0,0,0,,Жарайды
Dialogue: 0,0:08:03.60,0:08:04.44,Default,,0,0,0,,Иә
Dialogue: 0,0:08:05.69,0:08:07.73,Default,,0,0,0,,Лонгинусты ұсақтау
Dialogue: 0,0:08:14.53,0:08:15.36,Default,,0,0,0,,Уф
Dialogue: 0,0:08:15.62,0:08:16.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:18.53,0:08:19.58,Default,,0,0,0,,Не!
Dialogue: 0,0:08:20.54,0:08:21.33,Default,,0,0,0,,Уау
Dialogue: 0,0:08:21.91,0:08:23.08,Default,,0,0,0,,Ростронгинус
Dialogue: 0,0:08:23.21,0:08:25.29,Default,,0,0,0,,Артық бітіру үшін 1 ұпай
Dialogue: 0,0:08:25.50,0:08:26.42,Default,,0,0,0,,О
Dialogue: 0,0:08:26.50,0:08:27.54,Default,,0,0,0,,Не?
Dialogue: 0,0:08:27.92,0:08:29.71,Default,,0,0,0,,Егер ол жарылып кетпесе ше?
Dialogue: 0,0:08:33.51,0:08:36.14,Default,,0,0,0,,Оның сонша эмоция көрсеткеніне сене алар емеспін.
Dialogue: 0,0:08:36.51,0:08:37.76,Default,,0,0,0,,Бұл сирек кездеседі.
Dialogue: 0,0:08:38.05,0:08:39.47,Default,,0,0,0,,Бұл да керемет.
Dialogue: 0,0:08:39.55,0:08:41.35,Default,,0,0,0,,Түнгі түсірілім
Dialogue: 0,0:08:41.43,0:08:43.68,Default,,0,0,0,,Уау, мені таң қалдырасың.
Dialogue: 0,0:08:44.06,0:08:45.23,Default,,0,0,0,,Haha~n
Dialogue: 0,0:08:45.31,0:08:47.52,Default,,0,0,0,,Ең таң қалғаны - Луи.
Dialogue: 0,0:08:47.86,0:08:48.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:48.61,0:08:51.36,Default,,0,0,0,,Қорқынышты оқпен абсолютті сенімділікпен ату
Dialogue: 0,0:08:51.44,0:08:53.74,Default,,0,0,0,,Өйткені олар оны жарып жібере алмады.
Dialogue: 0,0:08:54.28,0:08:57.03,Default,,0,0,0,,Шу әлі де ұпай саны бойынша көш бастап тұр.
Dialogue: 0,0:08:57.11,0:08:59.08,Default,,0,0,0,,Мені ойша итермеледі.
Dialogue: 0,0:08:59.16,0:09:00.91,Default,,0,0,0,,Қорқынышты түсірілім?
Dialogue: 0,0:09:00.99,0:09:02.58,Default,,0,0,0,,Мазасыз қиыншылық
Dialogue: 0,0:09:03.16,0:09:04.79,Default,,0,0,0,,Шу қауіпсіз
Dialogue: 0,0:09:06.17,0:09:07.08,Default,,0,0,0,,Га
Dialogue: 0,0:09:07.67,0:09:10.50,Default,,0,0,0,,Мен Спригганды Шуға жеткіземін.
Dialogue: 0,0:09:11.84,0:09:12.71,Default,,0,0,0,,Күту уақыты
Dialogue: 0,0:09:13.30,0:09:14.92,Default,,0,0,0,,шығанақты алыңыз
Dialogue: 0,0:09:21.64,0:09:23.81,Default,,0,0,0,,Мен сендерге спригган әкелдім.
Dialogue: 0,0:09:25.77,0:09:27.23,Default,,0,0,0,,Бірақ бұл...
Dialogue: 0,0:09:29.44,0:09:30.52,Default,,0,0,0,,Шу
Dialogue: 0,0:09:30.61,0:09:31.57,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:31.65,0:09:33.32,Default,,0,0,0,,Спригган жақсы.
Dialogue: 0,0:09:33.40,0:09:33.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:36.11,0:09:37.86,Default,,0,0,0,,Бұл шайқаста жеңіске жету
Dialogue: 0,0:09:37.95,0:09:39.91,Default,,0,0,0,,Біз оған барымызды бердік.
Dialogue: 0,0:09:40.28,0:09:41.33,Default,,0,0,0,,Әзірге
Dialogue: 0,0:09:41.41,0:09:42.95,Default,,0,0,0,,Together forever
Dialogue: 0,0:09:43.04,0:09:44.29,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:09:45.66,0:09:46.91,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:09:47.37,0:09:51.13,Default,,0,0,0,,Шу мен Спригган басқаларға қарағанда көбірек жаттығады
Dialogue: 0,0:09:51.46,0:09:52.46,Default,,0,0,0,,Содан кейін
Dialogue: 0,0:09:52.55,0:09:56.22,Default,,0,0,0,,Ақырында мен сол Лонгинустан жарылысты алдым.
Dialogue: 0,0:09:56.67,0:09:59.18,Default,,0,0,0,,Мен қатты толқыдым.
Dialogue: 0,0:09:59.51,0:10:00.26,Default,,0,0,0,,Мен
Dialogue: 0,0:10:00.34,0:10:03.31,Default,,0,0,0,,Мен өзімді Спригганмен бір болғандай сезінемін.
Dialogue: 0,0:10:03.43,0:10:04.43,Default,,0,0,0,,Бірде?
Dialogue: 0,0:10:04.56,0:10:05.68,Default,,0,0,0,,Спригган
Dialogue: 0,0:10:06.18,0:10:08.44,Default,,0,0,0,,Мен дәл қазір үздіктермен күрескім келеді.
Dialogue: 0,0:10:08.77,0:10:09.69,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:10:09.77,0:10:11.19,Default,,0,0,0,,Менің Валькириім де
Dialogue: 0,0:10:11.27,0:10:13.77,Default,,0,0,0,,Мен Спригганмен күресу үшін күйіп жатырмын.
Dialogue: 0,0:10:14.98,0:10:16.90,Default,,0,0,0,,Бізге қара.
Dialogue: 0,0:10:17.15,0:10:20.87,Default,,0,0,0,,Шу, сенімен және Спригганмен біз үшінші шайқаста жеңе аламыз.
Dialogue: 0,0:10:21.16,0:10:22.99,Default,,0,0,0,,Луидің қорқынышты түсірілімі
Dialogue: 0,0:10:23.08,0:10:24.29,Default,,0,0,0,,Артқа серпейік
Dialogue: 0,0:10:24.62,0:10:26.70,Default,,0,0,0,,О, мүлде.
Dialogue: 0,0:10:26.83,0:10:28.12,Default,,0,0,0,,(соғылу дыбысы)
Dialogue: 0,0:10:28.29,0:10:29.37,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:29.46,0:10:32.59,Default,,0,0,0,,Енді Куришу шайқас сахнасына оралды.
Dialogue: 0,0:10:32.67,0:10:34.80,Default,,0,0,0,,Матч қайта басталды!
Dialogue: 0,0:10:35.84,0:10:37.97,Default,,0,0,0,,Бұл осында.
Dialogue: 0,0:10:38.05,0:10:39.22,Default,,0,0,0,,Мен сені қолдаймын!
Dialogue: 0,0:10:39.43,0:10:41.01,Default,,0,0,0,,Шу қолыңнан келгеннің бәрін жаса
Dialogue: 0,0:10:41.09,0:10:43.22,Default,,0,0,0,,Не істегеніңізді көрсетіңіз
Dialogue: 0,0:10:43.60,0:10:46.02,Default,,0,0,0,,Шу, мен сені жеңемін.
Dialogue: 0,0:10:46.10,0:10:47.77,Default,,0,0,0,,Біз мұнда жеңеміз.
Dialogue: 0,0:10:48.10,0:10:49.73,Default,,0,0,0,,Шу-кун!
Dialogue: 0,0:10:49.98,0:10:53.02,Default,,0,0,0,,Шу Шу Шу
Dialogue: 0,0:10:53.11,0:10:56.78,Default,,0,0,0,,Уау! Көрермендер орындықтарынан зор қоңырау болды.
Dialogue: 0,0:10:56.86,0:11:00.36,Default,,0,0,0,,Луи Луи Луис
Dialogue: 0,0:11:00.45,0:11:03.78,Default,,0,0,0,,Жоқ, жоқ, Луидің қолдау көрсететін тобы Луиге де телефон соғады.
Dialogue: 0,0:11:03.87,0:11:06.66,Default,,0,0,0,,Аудиторияға арналған орындар өте ыстық.
Dialogue: 0,0:11:07.29,0:11:08.75,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:11:09.62,0:11:11.87,Default,,0,0,0,,Ату күші одан да жоғары
Dialogue: 0,0:11:12.50,0:11:15.17,Default,,0,0,0,,Міне, осы күнге жеттім.
Dialogue: 0,0:11:16.00,0:11:18.21,Default,,0,0,0,,Мен оған қорқынышты түс көремін
Dialogue: 0,0:11:18.76,0:11:20.67,Default,,0,0,0,,Керемет жарылыста
Dialogue: 0,0:11:23.30,0:11:26.43,Default,,0,0,0,,Жартылай финалдың екінші кездесуі төрт император арасындағы кездесу болды.
Dialogue: 0,0:11:26.68,0:11:28.22,Default,,0,0,0,,Соңғы кезең осында
Dialogue: 0,0:11:28.31,0:11:30.81,Default,,0,0,0,,Ширасаги сарайы Руи мен Куришуу арасындағы өлімге әкелген шайқас
Dialogue: 0,0:11:30.89,0:11:33.15,Default,,0,0,0,,Үшінші шайқасқа кіру
Dialogue: 0,0:11:33.23,0:11:36.61,Default,,0,0,0,,Nightmare Shot қайтадан жарылып кете ме? Немесе
Dialogue: 0,0:11:36.69,0:11:39.78,Default,,0,0,0,,Оңтүстік крест соққысы кері серпіледі ме?
Dialogue: 0,0:11:40.07,0:11:43.03,Default,,0,0,0,,Мен Спригганға сенемін
Dialogue: 0,0:11:44.95,0:11:46.78,Default,,0,0,0,,Мен саған қорқынышты түс көрсетемін
Dialogue: 0,0:11:47.12,0:11:48.62,Default,,0,0,0,,Керемет жарылыста
Dialogue: 0,0:11:51.16,0:11:53.17,Default,,0,0,0,,Түнгі түсірілім
Dialogue: 0,0:11:53.83,0:11:55.42,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:11:55.84,0:11:59.21,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:59.30,0:12:01.63,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:12:01.72,0:12:02.97,Default,,0,0,0,,Міне кеттік!
Dialogue: 0,0:12:03.38,0:12:06.35,Default,,0,0,0,,Куришу қазір одан да үлкен бұрышта.
Dialogue: 0,0:12:06.43,0:12:08.31,Default,,0,0,0,,Жүр! Спригган!
Dialogue: 0,0:12:09.89,0:12:12.48,Default,,0,0,0,,Нағыз жоғарғы түсіру!
Dialogue: 0,0:12:14.60,0:12:15.35,Default,,0,0,0,,Шешіңіз
Dialogue: 0,0:12:15.60,0:12:16.61,Default,,0,0,0,,Жүр!
Dialogue: 0,0:12:17.11,0:12:19.90,Default,,0,0,0,,Спригган Лонгинусты жейді
Dialogue: 0,0:12:19.98,0:12:20.57,Default,,0,0,0,,Иә
Dialogue: 0,0:12:20.65,0:12:21.65,Default,,0,0,0,,Бұл – Огимотоя.
Dialogue: 0,0:12:22.65,0:12:23.74,Default,,0,0,0,,Қалай
Dialogue: 0,0:12:23.82,0:12:25.20,Default,,0,0,0,,Лонгинус жолы
Dialogue: 0,0:12:25.28,0:12:26.37,Default,,0,0,0,,өзгертілді
Dialogue: 0,0:12:26.45,0:12:27.24,Default,,0,0,0,,Ах
Dialogue: 0,0:12:28.99,0:12:31.25,Default,,0,0,0,,Жасай бер! longinus
Dialogue: 0,0:12:31.33,0:12:33.96,Default,,0,0,0,,Лонгинус стадионға жүгіріп келеді
Dialogue: 0,0:12:34.04,0:12:35.67,Default,,0,0,0,,Спригганнан жалтарыңыз
Dialogue: 0,0:12:36.96,0:12:40.09,Default,,0,0,0,,Қалай! Бұл жолы Спригган одан қашып кетті.
Dialogue: 0,0:12:41.63,0:12:42.63,Default,,0,0,0,,Екеуі де
Dialogue: 0,0:12:42.72,0:12:44.93,Default,,0,0,0,,Бір-бірінің шабуылдарына тосқауыл қойды
Dialogue: 0,0:12:45.01,0:12:46.89,Default,,0,0,0,,Үлкен жылдамдықпен
Dialogue: 0,0:12:46.97,0:12:48.97,Default,,0,0,0,,Екі шығанақ бір-бірінен өтеді
Dialogue: 0,0:12:49.05,0:12:50.60,Default,,0,0,0,,Сенгісіз
Dialogue: 0,0:12:51.85,0:12:53.06,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:12:53.39,0:12:55.19,Default,,0,0,0,,Сағат тілімен айналмалы сприган және
Dialogue: 0,0:12:55.27,0:12:56.81,Default,,0,0,0,,Солға бұрылу Longinus
Dialogue: 0,0:12:57.44,0:12:59.52,Default,,0,0,0,,Олар міндетті түрде соқтығысуы керек
Dialogue: 0,0:12:59.77,0:13:00.94,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:13:01.03,0:13:02.78,Default,,0,0,0,,Мүмкін емес нәрсе болып жатыр
Dialogue: 0,0:13:03.44,0:13:04.57,Default,,0,0,0,,Шу
Dialogue: 0,0:13:04.65,0:13:05.70,Default,,0,0,0,,Жеңіске жет!
Dialogue: 0,0:13:06.03,0:13:08.62,Default,,0,0,0,,Бұл күдік қанша уақытқа созылады?
Dialogue: 0,0:13:09.12,0:13:11.08,Default,,0,0,0,,Жүрегім соғуды тоқтатпайды
Dialogue: 0,0:13:11.16,0:13:12.45,Default,,0,0,0,,Мен оны аяқтаймын
Dialogue: 0,0:13:12.54,0:13:13.41,Default,,0,0,0,,Спригган
Dialogue: 0,0:13:18.96,0:13:21.50,Default,,0,0,0,,Шынайы есептегіш үзіліс
Dialogue: 0,0:13:21.59,0:13:23.17,Default,,0,0,0,,Жүр!
Dialogue: 0,0:13:24.34,0:13:27.89,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:13:28.80,0:13:31.93,Default,,0,0,0,,Спригган Жылдамдықты одан әрі арттырды.
Dialogue: 0,0:13:32.01,0:13:32.97,Default,,0,0,0,,О, Құдайым!
Dialogue: 0,0:13:33.06,0:13:35.27,Default,,0,0,0,,Лонгинус те жылдамдайды
Dialogue: 0,0:13:36.23,0:13:37.90,Default,,0,0,0,,Егер қорқынышты түс көрсеңіз
Dialogue: 0,0:13:38.19,0:13:39.86,Default,,0,0,0,,Ал мен оны дәл осы жерде ғана ұшырып жіберсем!
Dialogue: 0,0:13:39.94,0:13:41.44,Default,,0,0,0,,Лонгинус
Dialogue: 0,0:13:41.52,0:13:43.73,Default,,0,0,0,,Спригганға шабуыл жасаңыз!
Dialogue: 0,0:13:45.65,0:13:47.40,Default,,0,0,0,,(айқай)
Dialogue: 0,0:13:48.24,0:13:49.66,Default,,0,0,0,,Хмм... Шат!
Dialogue: 0,0:13:54.08,0:13:56.33,Default,,0,0,0,,Спригган жарылып кетті
Dialogue: 0,0:13:56.41,0:13:57.08,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:13:57.41,0:13:58.33,Default,,0,0,0,,Спригган!
Dialogue: 0,0:14:00.88,0:14:03.09,Default,,0,0,0,,Спригган төңкерілді ме?
Dialogue: 0,0:14:03.42,0:14:04.59,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:14:04.92,0:14:06.17,Default,,0,0,0,,Әлі Спригган емес!
Dialogue: 0,0:14:06.26,0:14:07.84,Default,,0,0,0,,Маған бәрін көрсет!
Dialogue: 0,0:14:09.18,0:14:11.68,Default,,0,0,0,,Спригган қалпына келді!
Dialogue: 0,0:14:11.76,0:14:12.68,Default,,0,0,0,,Не?
Dialogue: 0,0:14:12.93,0:14:14.14,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:14.39,0:14:16.35,Default,,0,0,0,,Осыншама шабуыл жасап жатсаңыз да?
Dialogue: 0,0:14:16.89,0:14:19.19,Default,,0,0,0,,Луи... жарылып кете алмайды
Dialogue: 0,0:14:23.90,0:14:25.61,Default,,0,0,0,,Қарсы үзіліс!
Dialogue: 0,0:14:25.69,0:14:27.19,Default,,0,0,0,,Жүр!
Dialogue: 0,0:14:31.41,0:14:32.74,Default,,0,0,0,,Сіз шешім қабылдадыңыз ба?
Dialogue: 0,0:14:33.16,0:14:34.12,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:34.33,0:14:35.37,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:14:35.49,0:14:36.62,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:14:37.00,0:14:38.08,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:14:38.29,0:14:39.50,Default,,0,0,0,,Керемет!
Dialogue: 0,0:14:40.00,0:14:41.25,Default,,0,0,0,,Шу жеңді!
Dialogue: 0,0:14:42.13,0:14:44.00,Default,,0,0,0,,Күшті соққы
Dialogue: 0,0:14:44.38,0:14:45.88,Default,,0,0,0,,Екеуі де жарылды.
Dialogue: 0,0:14:46.46,0:14:47.76,Default,,0,0,0,,(Жарық дыбысы)
Dialogue: 0,0:14:48.05,0:14:49.09,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:14:49.17,0:14:51.26,Default,,0,0,0,,Ешқайсысы да құламайды.
Dialogue: 0,0:14:51.34,0:14:53.18,Default,,0,0,0,,(Официант) Ж… Жоқ, мырза. Бұл «Неро» деп аталады➡
Dialogue: 0,0:14:53.26,0:14:54.89,Default,,0,0,0,,Бәрін шығар, Спригган!
Dialogue: 0,0:14:55.18,0:14:56.39,Default,,0,0,0,,Барлығын шығарыңыз!
Dialogue: 0,0:14:56.81,0:14:58.35,Default,,0,0,0,,Менің барлық күшім!
Dialogue: 0,0:15:02.77,0:15:05.27,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:15:05.98,0:15:07.90,Default,,0,0,0,,(айқай)
Dialogue: 0,0:15:12.24,0:15:13.37,Default,,0,0,0,,Лонгинус!
Dialogue: 0,0:15:13.45,0:15:15.41,Default,,0,0,0,,ұшып кетті
Dialogue: 0,0:15:15.49,0:15:16.24,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:15:16.62,0:15:17.49,Default,,0,0,0,,Міне, барамын!
Dialogue: 0,0:15:17.79,0:15:19.50,Default,,0,0,0,,Nu~!
Dialogue: 0,0:15:24.21,0:15:25.75,Default,,0,0,0,,Біз жеңе аламыз ба?
Dialogue: 0,0:15:25.84,0:15:26.75,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:15:26.96,0:15:27.84,Default,,0,0,0,,Уф
Dialogue: 0,0:15:28.01,0:15:28.96,Default,,0,0,0,,Га
Dialogue: 0,0:15:45.11,0:15:46.52,Default,,0,0,0,,Ростронгинус
Dialogue: 0,0:15:46.61,0:15:47.86,Default,,0,0,0,,Толық аяқтау
Dialogue: 0,0:15:48.07,0:15:49.32,Default,,0,0,0,,3-2
Dialogue: 0,0:15:49.40,0:15:51.65,Default,,0,0,0,,Руи Ширасадиджоның жеңісі
Dialogue: 0,0:15:51.74,0:15:54.37,Default,,0,0,0,,Міне, барамын!
Dialogue: 0,0:15:54.45,0:15:56.58,Default,,0,0,0,,Жеңімпаз абсолютті чемпион болды.
Dialogue: 0,0:15:56.66,0:15:59.24,Default,,0,0,0,,Бұл Ширасадиджо Луи.
Dialogue: 0,0:15:59.66,0:16:02.46,Default,,0,0,0,,Куришуу чемпионды шегіне дейін бұрышқа түсірді, бірақ
Dialogue: 0,0:16:02.54,0:16:04.08,Default,,0,0,0,,Бір қадам қалды
Dialogue: 0,0:16:04.17,0:16:05.75,Default,,0,0,0,,Бұл жақсы жекпе-жек болды.
Dialogue: 0,0:16:06.46,0:16:07.59,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:16:09.13,0:16:10.59,Default,,0,0,0,,Солай~
Dialogue: 0,0:16:11.51,0:16:12.63,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:16:13.43,0:16:14.84,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:16:16.26,0:16:17.64,Default,,0,0,0,,Мен жеңілдім...
Dialogue: 0,0:16:17.72,0:16:19.14,Default,,0,0,0,,Шу...
Dialogue: 0,0:16:19.39,0:16:20.81,Default,,0,0,0,,Спригган...
Dialogue: 0,0:16:21.39,0:16:22.39,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:16:22.48,0:16:25.56,Default,,0,0,0,,Мен шығанақты ерте бастадым.
Dialogue: 0,0:16:25.65,0:16:27.19,Default,,0,0,0,,Ерте болғаның маңызды емес
Dialogue: 0,0:16:31.28,0:16:32.61,Default,,0,0,0,,Мен сені финалда көргім келеді.
Dialogue: 0,0:16:33.45,0:16:35.82,Default,,0,0,0,,Иә, мен сені финалда көремін.
Dialogue: 0,0:16:35.91,0:16:36.62,Default,,0,0,0,,Ех
Dialogue: 0,0:16:36.70,0:16:39.12,Default,,0,0,0,,Мен әрқашан сенімен күресуге келдім.
Dialogue: 0,0:16:39.79,0:16:41.75,Default,,0,0,0,,Саған берген уәдемді орындау үшін
Dialogue: 0,0:16:42.25,0:16:43.91,Default,,0,0,0,,Менімен күрес! Балтық!
Dialogue: 0,0:16:44.46,0:16:46.21,Default,,0,0,0,,Түсіндім, Шу.
Dialogue: 0,0:16:48.63,0:16:50.71,Default,,0,0,0,,Шуға уәде бер!
Dialogue: 0,0:16:52.59,0:16:53.63,Default,,0,0,0,,О
Dialogue: 0,0:16:54.01,0:16:55.80,Default,,0,0,0,,Бұл уәде, Балто.
Dialogue: 0,0:16:56.18,0:16:57.39,Default,,0,0,0,,Финалда...
Dialogue: 0,0:16:57.80,0:16:59.10,Default,,0,0,0,,Финалда...
Dialogue: 0,0:17:01.47,0:17:04.39,Default,,0,0,0,,Мен жеңілдім... Шуу...
Dialogue: 0,0:17:21.79,0:17:22.87,Default,,0,0,0,,Шу
Dialogue: 0,0:17:24.75,0:17:25.66,Default,,0,0,0,,Луис
Dialogue: 0,0:17:26.29,0:17:27.67,Default,,0,0,0,,Тағы Куяшигаре
Dialogue: 0,0:17:27.83,0:17:30.67,Default,,0,0,0,,Мен сенің шпригіңді сындырдым.
Dialogue: 0,0:17:32.67,0:17:34.05,Default,,0,0,0,,Спригган
Dialogue: 0,0:17:36.38,0:17:37.59,Default,,0,0,0,,Сізге
Dialogue: 0,0:17:38.05,0:17:39.60,Default,,0,0,0,,Ол жойылған жоқ.
Dialogue: 0,0:17:40.68,0:17:42.60,Default,,0,0,0,,Ку… Құт
Dialogue: 0,0:17:43.68,0:17:46.73,Default,,0,0,0,,(Шудың айқайы)
Dialogue: 0,0:17:50.44,0:17:51.86,Default,,0,0,0,,Спригган
Dialogue: 0,0:17:52.94,0:17:54.40,Default,,0,0,0,,Міндетті түрде қайта жаңғырады
Dialogue: 0,0:17:54.82,0:17:56.95,Default,,0,0,0,,Қанша талпынсам да, бәрібір
Dialogue: 0,0:18:01.95,0:18:03.41,Default,,0,0,0,,Ширасаги сарайы Луис
Dialogue: 0,0:18:04.04,0:18:05.33,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:18:06.04,0:18:06.79,Default,,0,0,0,,Хун
Dialogue: 0,0:18:07.16,0:18:09.04,Default,,0,0,0,,Хухахахаха
Dialogue: 0,0:18:11.29,0:18:12.67,Default,,0,0,0,,Өлімге әкелетін шайқаста жеңіңіз
Dialogue: 0,0:18:12.80,0:18:14.84,Default,,0,0,0,,Бейді финалға кім шығарды?
Dialogue: 0,0:18:15.09,0:18:16.47,Default,,0,0,0,,Жеңілмейтін абсолютті чемпион
Dialogue: 0,0:18:16.55,0:18:18.72,Default,,0,0,0,,Ширасаги сарайы Луис
Dialogue: 0,0:18:18.80,0:18:20.64,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:20.72,0:18:23.01,Default,,0,0,0,,Және жылдам жүретін Ғажайып бала
Dialogue: 0,0:18:23.39,0:18:24.97,Default,,0,0,0,,Бұл Барто Аои.
Dialogue: 0,0:18:25.06,0:18:27.23,Default,,0,0,0,,Бұл екі адам
Dialogue: 0,0:18:27.31,0:18:29.98,Default,,0,0,0,,Финалдың соңғы кезеңінде
Dialogue: 0,0:18:30.06,0:18:31.65,Default,,0,0,0,,Соқтығысайық!
Dialogue: 0,0:18:31.73,0:18:32.52,Default,,0,0,0,,Луи!
Dialogue: 0,0:18:33.15,0:18:34.98,Default,,0,0,0,,Мен! Жоқ...
Dialogue: 0,0:18:35.53,0:18:36.94,Default,,0,0,0,,Мен және Валькири
Dialogue: 0,0:18:37.40,0:18:39.91,Default,,0,0,0,,Мен сені міндетті түрде жеңемін!
Dialogue: 0,0:18:40.86,0:18:42.20,Default,,0,0,0,,Ол шықты~
Dialogue: 0,0:18:42.28,0:18:43.28,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:18:43.37,0:18:46.70,Default,,0,0,0,,Чемпион Ширасаги қамал Луиге соғыс жариялайды
Dialogue: 0,0:18:46.79,0:18:48.50,Default,,0,0,0,,О? Бұған қарама-қарсы
Dialogue: 0,0:18:48.58,0:18:51.13,Default,,0,0,0,,Абсолюттік патша мүлде елемейді
Dialogue: 0,0:18:51.21,0:18:54.09,Default,,0,0,0,,Бұл сенімділік белгісі ме?
Dialogue: 0,0:18:54.42,0:18:56.76,Default,,0,0,0,,Енді бұл Луидің бесінші қатарынан жеңісі бола ма?
Dialogue: 0,0:18:56.84,0:19:00.05,Default,,0,0,0,,Әлде Wonder Boy керемет жасайды ма?
Dialogue: 0,0:19:00.13,0:19:03.14,Default,,0,0,0,,Финал басталып кетті.
Dialogue: 0,0:19:14.02,0:19:15.48,Default,,0,0,0,,Спригган
Dialogue: 0,0:19:16.53,0:19:17.44,Default,,0,0,0,,Жарық жасыл, Ято-сан.
Dialogue: 0,0:19:17.69,0:19:19.90,Default,,0,0,0,,Мен сені тым қатты итермеледім.
Dialogue: 0,0:19:20.45,0:19:21.32,Default,,0,0,0,,Мыау! Ах, Ферис, не болды?
Dialogue: 0,0:19:23.16,0:19:24.32,Default,,0,0,0,,Біз оның жайлы өте аз білеміз… Бұл не, мырза Ринатаки?
Dialogue: 0,0:19:25.95,0:19:27.45,Default,,0,0,0,,Шу!
Dialogue: 0,0:19:31.08,0:19:33.00,Default,,0,0,0,,Сіз осында болдыңыз!
Dialogue: 0,0:19:33.33,0:19:34.50,Default,,0,0,0,,Сіз...
Dialogue: 0,0:19:36.17,0:19:37.13,Default,,0,0,0,,Барт
Dialogue: 0,0:19:37.75,0:19:40.76,Default,,0,0,0,,Ух... уау уау уау...
Dialogue: 0,0:19:41.22,0:19:42.72,Default,,0,0,0,,Тотто... Тоа!
Dialogue: 0,0:19:44.14,0:19:45.01,Default,,0,0,0,,Балто!
Dialogue: 0,0:19:48.10,0:19:49.60,Default,,0,0,0,,(Бекки) Ах, емтихандар аяқталды — ақыры тыныш күндер келді~
Dialogue: 0,0:19:50.77,0:19:52.90,Default,,0,0,0,,Жақсы сезінеді~
Dialogue: 0,0:19:53.31,0:19:54.81,Default,,0,0,0,,Шуу да келе жатыр~
Dialogue: 0,0:19:55.65,0:19:57.15,Default,,0,0,0,,Жүзейік~
Dialogue: 0,0:19:58.15,0:19:59.07,Default,,0,0,0,,Бас тарт!
Dialogue: 0,0:20:00.24,0:20:02.53,Default,,0,0,0,,Жақсы сезінемін! Ахаха
Dialogue: 0,0:20:02.61,0:20:03.82,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:20:08.58,0:20:11.08,Default,,0,0,0,,Кешіріңіз, Валькири, мен оны су етіп алдым.
Dialogue: 0,0:20:11.71,0:20:15.00,Default,,0,0,0,,Сіз әрқашан Валькиримен сөйлесесіз.
Dialogue: 0,0:20:15.08,0:20:16.08,Default,,0,0,0,,Тіпті Шуу
Dialogue: 0,0:20:16.17,0:20:19.13,Default,,0,0,0,,Матч кезінде Спригганмен сөйлескен жоқсыз ба?
Dialogue: 0,0:20:19.46,0:20:21.63,Default,,0,0,0,,Сіздің еркелігіңіз маған ауысты.
Dialogue: 0,0:20:21.92,0:20:24.72,Default,,0,0,0,,Спригганмен не туралы сөйлестіңіз?
Dialogue: 0,0:20:25.84,0:20:26.85,Default,,0,0,0,,Бұл құпия
Dialogue: 0,0:20:27.10,0:20:29.60,Default,,0,0,0,,Уау, бұл жиіркенішті.
Dialogue: 0,0:20:29.68,0:20:30.72,Default,,0,0,0,,Алдамаңыз
Dialogue: 0,0:20:30.81,0:20:31.85,Default,,0,0,0,,Цури~
Dialogue: 0,0:20:37.86,0:20:39.61,Default,,0,0,0,,Мен туралы көбірек
Dialogue: 0,0:20:39.69,0:20:41.32,Default,,0,0,0,,Өртеп жіберіңіз
Dialogue: 0,0:20:47.82,0:20:49.37,Default,,0,0,0,,Спригган
Dialogue: 0,0:20:49.45,0:20:50.70,Default,,0,0,0,,Ол түзетіледі, солай ма?
Dialogue: 0,0:20:51.29,0:20:52.75,Default,,0,0,0,,Әрине
Dialogue: 0,0:20:52.96,0:20:54.33,Default,,0,0,0,,Спригган және мен де
Dialogue: 0,0:20:55.29,0:20:56.75,Default,,0,0,0,,Күшті болыңыз
Dialogue: 0,0:20:59.59,0:21:00.63,Default,,0,0,0,,Ум...
Dialogue: 0,0:21:01.21,0:21:02.51,Default,,0,0,0,,Алдыңғы сәйкестік...
Dialogue: 0,0:21:02.59,0:21:04.68,Default,,0,0,0,,Финалда жеңіске жету
Dialogue: 0,0:21:09.26,0:21:10.76,Default,,0,0,0,,Сіз жеңе аласыз
Dialogue: 0,0:21:11.31,0:21:12.10,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:21:13.43,0:21:15.81,Default,,0,0,0,,Сен болмасаң, мен Луиді жеңе алмаймын.
Dialogue: 0,0:21:16.44,0:21:17.19,Default,,0,0,0,,Иә
Dialogue: 0,0:21:17.85,0:21:18.90,Default,,0,0,0,,Мен мұны істеймін
Dialogue: 0,0:21:20.82,0:21:21.90,Default,,0,0,0,,Міндетті түрде орындаңыз
Dialogue: 0,0:21:21.98,0:21:23.74,Default,,0,0,0,,Сондай-ақ Шу мен Спригган үшін
Dialogue: 0,0:21:23.82,0:21:26.53,Default,,0,0,0,,Мен және Валькири бар күш-жігерімізбен күресеміз
Dialogue: 0,0:21:28.87,0:21:30.16,Default,,0,0,0,,Шу, бар.
Dialogue: 0,0:21:30.24,0:21:31.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:31.83,0:21:32.87,Default,,0,0,0,,(Дарио) Қ… Қандай қорқынышты маска. Маған бұл керек емес.
Dialogue: 0,0:21:33.12,0:21:35.12,Default,,0,0,0,,мен зұлымдарды әділ сотқа тартуға тырысар ма едім?
Dialogue: 0,0:21:35.25,0:21:36.79,Default,,0,0,0,,Хяхо~
Dialogue: 0,0:21:37.54,0:21:39.71,Default,,0,0,0,,Сөзсіз жеңіңіз!
Dialogue: 0,0:21:39.79,0:21:42.17,Default,,0,0,0,,Уау! Сіз жеңесіз!
Dialogue: 0,0:21:42.25,0:21:44.21,Default,,0,0,0,,Күте тұрыңыз, Луис!
Dialogue: 0,0:21:47.38,0:21:48.51,Default,,0,0,0,,Барт
Dialogue: 0,0:21:49.09,0:21:50.60,Default,,0,0,0,,Менің саған берген уәдем...
Dialogue: 0,0:21:51.05,0:21:52.72,Default,,0,0,0,,Сізді қорғай алмағаным үшін кешіріңіз.
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.69,0:23:28.03,Default,,0,0,0,,Қорқынышты түс көру
Dialogue: 0,0:23:28.11,0:23:29.90,Default,,0,0,0,,Луидің қорқынышты түсірілімі
Dialogue: 0,0:23:30.15,0:23:31.66,Default,,0,0,0,,Мен қалай жеңе аламын?
Dialogue: 0,0:23:31.86,0:23:33.16,Default,,0,0,0,,Бұл финалдық матч
Dialogue: 0,0:23:33.24,0:23:36.66,Default,,0,0,0,,Луиге қарсы күрескен адамдардың барлығының сезімін білдірейік
Dialogue: 0,0:23:36.91,0:23:38.41,Default,,0,0,0,,Енді осы уақытқа дейін жеттік
Dialogue: 0,0:23:38.50,0:23:40.41,Default,,0,0,0,,Сіз жеңуіңіз керек.
Dialogue: 0,0:23:40.50,0:23:42.79,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:42.87,0:23:45.21,Default,,0,0,0,,Оны жеңейік! абсолютті чемпион
Dialogue: 0,0:23:45.29,0:23:47.21,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.30,0:23:48.76,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.26,0:23:56.26,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory