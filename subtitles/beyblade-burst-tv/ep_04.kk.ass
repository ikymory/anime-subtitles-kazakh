Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.50,0:00:09.05,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.13,0:00:12.38,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.76,0:00:14.55,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.63,0:00:16.85,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:16.93,0:00:18.72,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.52,0:00:24.27,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.35,0:00:26.27,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.35,0:00:28.82,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:32.11,0:00:35.78,Default,,0,0,0,,Мен WBBA аймақтық турниріне қатыстым...
Dialogue: 0,0:00:35.86,0:00:38.70,Default,,0,0,0,,Бірінші раунд Кумичоның көтерілген Рагнарукқа қарсы
Dialogue: 0,0:00:38.78,0:00:41.20,Default,,0,0,0,,Біз күрестік және жеңдік!
Dialogue: 0,0:00:41.83,0:00:43.79,Default,,0,0,0,,Екінші раунд Инсуке Мидорикава болды.
Dialogue: 0,0:00:43.87,0:00:45.25,Default,,0,0,0,,Кайзер Сербеус
Dialogue: 0,0:00:45.46,0:00:47.13,Default,,0,0,0,,Маған өте қиын болды.
Dialogue: 0,0:00:47.25,0:00:49.21,Default,,0,0,0,,Мен тіпті Сербейді де жеңдім
Dialogue: 0,0:00:49.29,0:00:50.42,Default,,0,0,0,,Қатарынан екі жеңіс!
Dialogue: 0,0:00:51.05,0:00:53.38,Default,,0,0,0,,Ал менің келесі қарсыласым...
Dialogue: 0,0:00:53.47,0:00:54.84,Default,,0,0,0,,Бұл Дина Куроками.
Dialogue: 0,0:00:55.72,0:00:57.68,Default,,0,0,0,,Бұл жігіт те керемет
Dialogue: 0,0:00:58.18,0:00:59.26,Default,,0,0,0,,Мен жеңдім!
Dialogue: 0,0:00:59.76,0:01:02.31,Default,,0,0,0,,Шынымды айтсам, бұл үлкен жеңіс!
Dialogue: 0,0:01:12.73,0:01:15.11,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:15.45,0:01:20.62,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:31.92,0:01:35.30,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:35.80,0:01:37.93,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:38.34,0:01:42.47,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:42.60,0:01:45.81,Default,,0,0,0,,Дұрыс, сіздің жүзіңіздегі өрнек
Dialogue: 0,0:01:45.93,0:01:52.36,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:01:52.65,0:01:57.07,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:01:57.57,0:02:02.99,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:03.12,0:02:05.37,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:05.45,0:02:10.17,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:10.33,0:02:15.42,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:15.71,0:02:17.97,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:18.17,0:02:20.51,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:20.80,0:02:24.72,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:24.89,0:02:29.89,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:30.06,0:02:32.23,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:35.98,0:02:39.07,Default,,0,0,0,,Бейблейд клубын жасайық!
Dialogue: 0,0:02:40.57,0:02:43.74,Default,,0,0,0,,Токонацу Ника, ағамды оят.
Dialogue: 0,0:02:43.83,0:02:45.12,Default,,0,0,0,,Уа!
Dialogue: 0,0:02:46.33,0:02:47.87,Default,,0,0,0,,Бал-нии жоқ
Dialogue: 0,0:02:47.95,0:02:49.79,Default,,0,0,0,,А, сен кетіп қалдың ба?
Dialogue: 0,0:02:49.87,0:02:52.08,Default,,0,0,0,,Тез ату!
Dialogue: 0,0:02:52.21,0:02:54.04,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:02:55.80,0:02:57.21,Default,,0,0,0,,(Цубаки мен Ватару) Оның мойын арты! Қандай аппақ тері! (Медбике) Есікті алдымен қағып ал!
Dialogue: 0,0:02:57.30,0:02:59.01,Default,,0,0,0,,Ммм
Dialogue: 0,0:03:00.51,0:03:02.76,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:03:05.76,0:03:08.64,Default,,0,0,0,,Кеттік! Раш аяқ киім…
Dialogue: 0,0:03:09.81,0:03:11.06,Default,,0,0,0,,Ешкімге… ешкімге…!!
Dialogue: 0,0:03:11.23,0:03:12.27,Default,,0,0,0,,Неге!
Dialogue: 0,0:03:12.77,0:03:14.40,Default,,0,0,0,,Қарғыс атсын! Қарғыс атсын!
Dialogue: 0,0:03:15.02,0:03:17.94,Default,,0,0,0,,Уф, ол қозғалмайды.
Dialogue: 0,0:03:18.03,0:03:19.19,Default,,0,0,0,,Незо өте жаман
Dialogue: 0,0:03:19.32,0:03:22.36,Default,,0,0,0,,Оян, мектепке баратын уақыт.
Dialogue: 0,0:03:22.45,0:03:24.03,Default,,0,0,0,,Мен сені тағы да сүйемін
Dialogue: 0,0:03:24.57,0:03:25.62,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:03:25.70,0:03:26.70,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:03:26.78,0:03:27.87,Default,,0,0,0,,(Суға түскен дыбыс)
Dialogue: 0,0:03:27.95,0:03:30.08,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:03:30.16,0:03:32.33,Default,,0,0,0,,Екеуің не істеп жатырсыңдар?
Dialogue: 0,0:03:33.25,0:03:34.83,Default,,0,0,0,,～
Dialogue: 0,0:03:35.88,0:03:39.09,Default,,0,0,0,,Бүгін ашуланбаған шығарсың.
Dialogue: 0,0:03:39.17,0:03:42.30,Default,,0,0,0,,Ах! Мен бүгін Чикокумен шайқаста жеңдім!
Dialogue: 0,0:03:42.38,0:03:44.55,Default,,0,0,0,,Әрең дегенде... қауіпсіз!
Dialogue: 0,0:03:44.64,0:03:45.72,Default,,0,0,0,,Хмм…
Dialogue: 0,0:03:45.93,0:03:48.14,Default,,0,0,0,,Шынымен! Бұл рас!
Dialogue: 0,0:03:48.22,0:03:51.73,Default,,0,0,0,,Оны Beyblade турнирлерінде қолдану жақсы, бірақ...
Dialogue: 0,0:03:51.81,0:03:53.27,Default,,0,0,0,,Чикоку жоқ.
Dialogue: 0,0:03:53.35,0:03:54.60,Default,,0,0,0,,Жеңіске жетсем де
Dialogue: 0,0:03:54.81,0:03:56.31,Default,,0,0,0,,Бұл жай ғана болды
Dialogue: 0,0:03:56.40,0:03:57.48,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:03:57.57,0:03:59.19,Default,,0,0,0,,Бұл не үшін?
Dialogue: 0,0:03:59.28,0:04:01.28,Default,,0,0,0,,Хехе, менің мектебімде.
Dialogue: 0,0:04:01.36,0:04:03.20,Default,,0,0,0,,Бейблейд клубын жасаңыз
Dialogue: 0,0:04:03.49,0:04:05.49,Default,,0,0,0,,Бейблейд клубы?
Dialogue: 0,0:04:05.57,0:04:08.20,Default,,0,0,0,,Футбол клубы Волейбол клубы өнер клубы
Dialogue: 0,0:04:08.28,0:04:09.87,Default,,0,0,0,,Көп нәрсе бар.
Dialogue: 0,0:04:09.95,0:04:11.29,Default,,0,0,0,,Дәл осылай-
Dialogue: 0,0:04:11.37,0:04:14.12,Default,,0,0,0,,Бейблейд клубы болғаны жақсы емес пе?
Dialogue: 0,0:04:14.21,0:04:15.25,Default,,0,0,0,,Төзе бер, шыдай бер!
Dialogue: 0,0:04:15.54,0:04:17.46,Default,,0,0,0,,Директор, өтінемін!
Dialogue: 0,0:04:17.71,0:04:19.09,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:04:20.17,0:04:22.34,Default,,0,0,0,,Жарайсыңдар! Барайық!
Dialogue: 0,0:04:22.76,0:04:25.47,Default,,0,0,0,,Бейблейд клубына қосылыңыз!
Dialogue: 0,0:04:25.55,0:04:26.97,Default,,0,0,0,,Менің бейсбол клубым
Dialogue: 0,0:04:27.05,0:04:28.22,Default,,0,0,0,,Баскетбол клубы
Dialogue: 0,0:04:28.30,0:04:30.22,Default,,0,0,0,,Біз драма клубы
Dialogue: 0,0:04:30.81,0:04:33.81,Default,,0,0,0,,Бейблейд клубтары туралы не деуге болады? Бұл қызық!
Dialogue: 0,0:04:33.89,0:04:34.69,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:04:34.77,0:04:36.31,Default,,0,0,0,,Кешіріңіз (ер студент) Эй.
Dialogue: 0,0:04:36.40,0:04:37.19,Default,,0,0,0,,Кіре алмайсыз ба?
Dialogue: 0,0:04:37.27,0:04:38.19,Default,,0,0,0,,Себебі бос емес
Dialogue: 0,0:04:38.27,0:04:39.90,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:04:40.44,0:04:43.07,Default,,0,0,0,,Әрине Кумичо кіреді.
Dialogue: 0,0:04:43.57,0:04:44.99,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:04:45.07,0:04:47.66,Default,,0,0,0,,Сондықтан бұл Bay Club!
Dialogue: 0,0:04:47.74,0:04:48.66,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:04:49.16,0:04:51.45,Default,,0,0,0,,Мен кеше қарлы аяқ киіммен жаттығатынмын...
Dialogue: 0,0:04:51.54,0:04:52.70,Default,,0,0,0,,Менде бір ой болды.
Dialogue: 0,0:04:54.16,0:04:56.71,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:04:56.79,0:04:58.50,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:59.29,0:05:01.71,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:01.80,0:05:03.88,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:03.97,0:05:04.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:05.05,0:05:06.76,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:06.84,0:05:07.68,Default,,0,0,0,,Уау!
Dialogue: 0,0:05:08.34,0:05:10.47,Default,,0,0,0,,Ах! Бұл дұрыс!
Dialogue: 0,0:05:10.97,0:05:13.39,Default,,0,0,0,,Бұл жалғыз жаттығудан жақсы.
Dialogue: 0,0:05:13.47,0:05:16.23,Default,,0,0,0,,Біз бір-бірімізді қарсылас ретінде ойнай аламыз.
Dialogue: 0,0:05:16.31,0:05:18.60,Default,,0,0,0,,Сіз мұның соншалықты асыра сілтеу екенін түсінесіз бе?
Dialogue: 0,0:05:18.69,0:05:23.03,Default,,0,0,0,,Клуб салынғаннан кейін олар сізге жеке тәжірибе алаңын салар ма?
Dialogue: 0,0:05:23.11,0:05:24.57,Default,,0,0,0,,О, тамаша!
Dialogue: 0,0:05:24.65,0:05:25.95,Default,,0,0,0,,Дұрыс! Дұрыс!
Dialogue: 0,0:05:26.03,0:05:27.49,Default,,0,0,0,,Бірақ клуб болу үшін
Dialogue: 0,0:05:27.57,0:05:29.45,Default,,0,0,0,,5 немесе одан да көп мүшелер бар.
Dialogue: 0,0:05:29.53,0:05:30.49,Default,,0,0,0,,Қазір қанша адам бар?
Dialogue: 0,0:05:30.58,0:05:32.20,Default,,0,0,0,,Иә? 1 адам
Dialogue: 0,0:05:32.70,0:05:33.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:33.62,0:05:35.91,Default,,0,0,0,,Кумичодағы екінші немесе одан да көп адам
Dialogue: 0,0:05:36.00,0:05:37.79,Default,,0,0,0,,Тек екі адам?
Dialogue: 0,0:05:37.87,0:05:40.63,Default,,0,0,0,,Біз мүшелерді қабылдауды енді ғана бастадық.
Dialogue: 0,0:05:40.71,0:05:43.13,Default,,0,0,0,,Оған көмектесу мүмкін емес, мен кіремін.
Dialogue: 0,0:05:43.21,0:05:45.21,Default,,0,0,0,,Ах! Рахмет сізге Кумичо!
Dialogue: 0,0:05:45.30,0:05:47.22,Default,,0,0,0,,Кумичо адам ғой!
Dialogue: 0,0:05:47.34,0:05:49.55,Default,,0,0,0,,Ақымақ, ұялмайсың ба?
Dialogue: 0,0:05:51.43,0:05:53.68,Default,,0,0,0,,Онда мен менеджермін!
Dialogue: 0,0:05:53.77,0:05:55.14,Default,,0,0,0,,(Дос) Не? «Chōzetsu Zekkyō Keikaku 5 (Бес)» деген бар ма?
Dialogue: 0,0:05:55.22,0:05:56.39,Default,,0,0,0,,Сіз шағымданасыз ба?
Dialogue: 0,0:05:56.52,0:05:57.19,Default,,0,0,0,,Иә
Dialogue: 0,0:05:57.27,0:05:59.35,Default,,0,0,0,,Кумичоның менеджер екені біртүрлі.
Dialogue: 0,0:05:59.44,0:06:01.11,Default,,0,0,0,,Сіз өзгердіңіз...
Dialogue: 0,0:06:01.19,0:06:03.27,Default,,0,0,0,,Өйткені Кумичо - Кумичо.
Dialogue: 0,0:06:04.07,0:06:04.90,Default,,0,0,0,,Қалай болғанда да—
Dialogue: 0,0:06:05.65,0:06:07.78,Default,,0,0,0,,Бұл шайқаста шешіледі ме?
Dialogue: 0,0:06:08.11,0:06:08.99,Default,,0,0,0,,О!
Dialogue: 0,0:06:09.07,0:06:11.53,Default,,0,0,0,,Шайқастар әрқашан маңызды!
Dialogue: 0,0:06:12.66,0:06:14.24,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:06:14.33,0:06:18.79,Default,,0,0,0,,Біз Bay Club менеджері кім болатынын шешу үшін шайқас болғалы жатырмыз.
Dialogue: 0,0:06:18.87,0:06:20.79,Default,,0,0,0,,Біз әлі клуб құрған жоқпыз.
Dialogue: 0,0:06:20.88,0:06:21.79,Default,,0,0,0,,Хехе...
Dialogue: 0,0:06:22.00,0:06:24.25,Default,,0,0,0,,Жақсы! Бастайық!
Dialogue: 0,0:06:24.80,0:06:26.30,Default,,0,0,0,,Олай болса, кеттік.
Dialogue: 0,0:06:26.38,0:06:27.72,Default,,0,0,0,,Бірінші шайқас!
Dialogue: 0,0:06:27.88,0:06:29.55,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:06:29.88,0:06:31.76,Default,,0,0,0,,Аудандық турнирдің бірінші турында
Dialogue: 0,0:06:31.84,0:06:33.43,Default,,0,0,0,,Мен Кумичодан жеңдім, бірақ
Dialogue: 0,0:06:33.76,0:06:35.31,Default,,0,0,0,,Осыдан кейін мен жеңілдім...
Dialogue: 0,0:06:35.64,0:06:38.23,Default,,0,0,0,,Сол кезде мен шапшаң соққыны өткізіп алдым.
Dialogue: 0,0:06:38.31,0:06:39.60,Default,,0,0,0,,Есептегішті соғыңыз
Dialogue: 0,0:06:39.69,0:06:41.77,Default,,0,0,0,,Мен Валькирияның жарылуына себепші болдым.
Dialogue: 0,0:06:42.31,0:06:44.73,Default,,0,0,0,,Мен сені қайта бұлай көрсем шыдай алмаймын.
Dialogue: 0,0:06:45.23,0:06:46.23,Default,,0,0,0,,Дос
Dialogue: 0,0:06:47.24,0:06:48.78,Default,,0,0,0,,Балтық мыңжапырақ
Dialogue: 0,0:06:48.86,0:06:53.16,Default,,0,0,0,,Менімен алғаш ұрысқаннан бері сіз керемет өстіңіз...
Dialogue: 0,0:06:53.24,0:06:54.53,Default,,0,0,0,,Бірақ мен...
Dialogue: 0,0:06:54.62,0:06:56.08,Default,,0,0,0,,Ол өсіп келеді!
Dialogue: 0,0:06:56.41,0:06:58.58,Default,,0,0,0,,Маған көрсетейін, Рагнарук!
Dialogue: 0,0:07:00.08,0:07:03.63,Default,,0,0,0,,Балттың ақымақ Раш Шотпен бірге келетін шығар.
Dialogue: 0,0:07:03.71,0:07:05.75,Default,,0,0,0,,Қорғаныс түрі Kaiser Cerbeus
Dialogue: 0,0:07:05.84,0:07:07.51,Default,,0,0,0,,Күшті қорғанысты не жеңді?
Dialogue: 0,0:07:07.59,0:07:10.93,Default,,0,0,0,,Бұл өте жылдам алғашқы байланыс болды.
Dialogue: 0,0:07:11.88,0:07:13.68,Default,,0,0,0,,Бірақ егер оның келе жатқанын білсеңіз...
Dialogue: 0,0:07:14.01,0:07:16.26,Default,,0,0,0,,Оны орындаудың басқа да жолдары бар.
Dialogue: 0,0:07:17.01,0:07:18.77,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:07:20.85,0:07:24.31,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:24.69,0:07:26.86,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:30.57,0:07:32.86,Default,,0,0,0,,Балто асығыс атумен келді!
Dialogue: 0,0:07:32.95,0:07:35.16,Default,,0,0,0,,Жарайсыңдар! Сіз дұрыс оқыдыңыз!
Dialogue: 0,0:07:35.74,0:07:38.62,Default,,0,0,0,,Кумичо Рагнаруктың басына түсірді.
Dialogue: 0,0:07:38.70,0:07:40.46,Default,,0,0,0,,Және ол бұрышта
Dialogue: 0,0:07:40.54,0:07:42.62,Default,,0,0,0,,Ол әрқашан орталық болса да?
Dialogue: 0,0:07:42.71,0:07:43.83,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:07:44.38,0:07:46.67,Default,,0,0,0,,Рагнарук сыртқы шеңберді айналып өтеді.
Dialogue: 0,0:07:46.75,0:07:48.75,Default,,0,0,0,,Валькиридің шабуылынан құтылу
Dialogue: 0,0:07:48.84,0:07:49.67,Default,,0,0,0,,Не!
Dialogue: 0,0:07:50.01,0:07:51.67,Default,,0,0,0,,Валькиридің шабуыл күші де
Dialogue: 0,0:07:51.76,0:07:54.05,Default,,0,0,0,,Біз соқтығыспайтын сияқтымыз!
Dialogue: 0,0:07:57.22,0:07:59.10,Default,,0,0,0,,Есіңізде қалған бір ақымақ нәрсені қараңыз.
Dialogue: 0,0:07:59.18,0:08:01.85,Default,,0,0,0,,Егер сіз асығыс ататыныңызды білсеңіз
Dialogue: 0,0:08:02.56,0:08:05.56,Default,,0,0,0,,Оны ешкім жемейді!
Dialogue: 0,0:08:05.65,0:08:08.23,Default,,0,0,0,,Мен Валькиримен соқтығысудан аулақ болдым.
Dialogue: 0,0:08:08.32,0:08:10.74,Default,,0,0,0,,Кумичо таңқаларлықтай ақылды!
Dialogue: 0,0:08:10.90,0:08:13.20,Default,,0,0,0,,Жан-жағында жүгіру ақымақ!
Dialogue: 0,0:08:13.28,0:08:15.66,Default,,0,0,0,,Букьяро! Бұл да стратегия!
Dialogue: 0,0:08:15.87,0:08:18.78,Default,,0,0,0,,Валькири, тістеме, оны ұста!
Dialogue: 0,0:08:18.87,0:08:20.08,Default,,0,0,0,,Қандай ысырап!
Dialogue: 0,0:08:21.25,0:08:23.37,Default,,0,0,0,,Алға!
Dialogue: 0,0:08:26.13,0:08:26.79,Default,,0,0,0,,Не!
Dialogue: 0,0:08:26.88,0:08:28.34,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:08:29.50,0:08:30.84,Default,,0,0,0,,сәби әлі тірі. Бұл адам баланы қорғап қалған болар.
Dialogue: 0,0:08:30.92,0:08:33.01,Default,,0,0,0,,Рагнарук ортаға шықты
Dialogue: 0,0:08:33.09,0:08:34.38,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:08:34.72,0:08:37.22,Default,,0,0,0,,Шапшаң ату осы жерден шығады!
Dialogue: 0,0:08:41.22,0:08:43.43,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:08:50.27,0:08:52.99,Default,,0,0,0,,Қарғыс атсын! Таэро~ Рагнарук!
Dialogue: 0,0:08:55.45,0:08:57.32,Default,,0,0,0,,(Шайтанның айқайы)
Dialogue: 0,0:09:04.71,0:09:06.75,Default,,0,0,0,,Жүр!
Dialogue: 0,0:09:09.13,0:09:11.00,Default,,0,0,0,,Артқа жанап өтіңіз!
Dialogue: 0,0:09:12.67,0:09:15.38,Default,,0,0,0,,(ұшқан дыбыс)
Dialogue: 0,0:09:15.47,0:09:16.13,Default,,0,0,0,,Не!
Dialogue: 0,0:09:16.22,0:09:17.34,Default,,0,0,0,,Шааа!
Dialogue: 0,0:09:17.64,0:09:20.22,Default,,0,0,0,,Валькири ұшты!
Dialogue: 0,0:09:20.30,0:09:22.27,Default,,0,0,0,,Рагнарук стадионда қалады.
Dialogue: 0,0:09:22.35,0:09:24.64,Default,,0,0,0,,Не!
Dialogue: 0,0:09:27.10,0:09:28.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:28.40,0:09:30.02,Default,,0,0,0,,А... а
Dialogue: 0,0:09:30.61,0:09:33.23,Default,,0,0,0,,Рагнарук жарылып кетті!
Dialogue: 0,0:09:33.32,0:09:35.65,Default,,0,0,0,,
Dialogue: 0,0:09:38.45,0:09:40.07,Default,,0,0,0,,Бір уақытта дерлік...
Dialogue: 0,0:09:40.16,0:09:41.66,Default,,0,0,0,,Бұл не болады?
Dialogue: 0,0:09:42.66,0:09:43.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:43.95,0:09:45.12,Default,,0,0,0,,Қазір ғана…
Dialogue: 0,0:09:45.20,0:09:48.04,Default,,0,0,0,,Өйткені дәл сол уақыт еді...
Dialogue: 0,0:09:48.12,0:09:49.17,Default,,0,0,0,,Ах, мм...
Dialogue: 0,0:09:49.25,0:09:50.42,Default,,0,0,0,,Бұл ұтыс емес пе?
Dialogue: 0,0:09:50.71,0:09:51.79,Default,,0,0,0,,Бір сәт!
Dialogue: 0,0:09:51.88,0:09:52.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:53.50,0:09:54.76,Default,,0,0,0,,Бір уақытта емес
Dialogue: 0,0:09:55.01,0:09:57.97,Default,,0,0,0,,Менің Рагнарук тым тез жарылып кетті.
Dialogue: 0,0:09:58.88,0:09:59.89,Default,,0,0,0,,Бірақ
Dialogue: 0,0:09:59.97,0:10:01.89,Default,,0,0,0,,Сенің көздерің – ойық!
Dialogue: 0,0:10:02.43,0:10:05.77,Default,,0,0,0,,Рагнарук жарылған бойда шайқас аяқталды.
Dialogue: 0,0:10:06.18,0:10:08.81,Default,,0,0,0,,Қалай қарасаңыз да, Валькири жеңеді.
Dialogue: 0,0:10:09.35,0:10:10.65,Default,,0,0,0,,Кумичо…
Dialogue: 0,0:10:11.06,0:10:12.36,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:10:12.65,0:10:14.11,Default,,0,0,0,,Бұл жай ғана болды.
Dialogue: 0,0:10:14.19,0:10:15.19,Default,,0,0,0,,сені бәсекелес деп санайтын Бакуго мен Тодороки емес
Dialogue: 0,0:10:15.57,0:10:17.15,Default,,0,0,0,,Жарқын аяқталу!
Dialogue: 0,0:10:17.24,0:10:19.91,Default,,0,0,0,,Валькири 2 ұпай жинап жеңеді
Dialogue: 0,0:10:19.99,0:10:21.70,Default,,0,0,0,,Шаа~!
Dialogue: 0,0:10:23.91,0:10:25.58,Default,,0,0,0,,Сен істейсің, Балто.
Dialogue: 0,0:10:25.83,0:10:27.29,Default,,0,0,0,,Мен жеңілдім, бірақ мен...
Dialogue: 0,0:10:27.37,0:10:28.75,Default,,0,0,0,,Бұл қандай да бір жақсы сезінеді.
Dialogue: 0,0:10:28.83,0:10:29.71,Default,,0,0,0,,Мен де!
Dialogue: 0,0:10:29.79,0:10:32.34,Default,,0,0,0,,Мен өзімді жақсы сезінемін, өйткені мен жеңдім
Dialogue: 0,0:10:32.42,0:10:33.79,Default,,0,0,0,,Бұл анық!
Dialogue: 0,0:10:33.88,0:10:35.05,Default,,0,0,0,,А, мен түсінемін...
Dialogue: 0,0:10:38.38,0:10:40.38,Default,,0,0,0,,Рахмет сізге Валькири
Dialogue: 0,0:10:45.10,0:10:47.31,Default,,0,0,0,,Сонда менеджер Бал-нии?
Dialogue: 0,0:10:47.39,0:10:48.43,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:10:48.52,0:10:51.06,Default,,0,0,0,,Жоқ, мен де бас менеджер емеспін...
Dialogue: 0,0:10:51.15,0:10:52.61,Default,,0,0,0,,Е...
Dialogue: 0,0:10:52.69,0:10:53.90,Default,,0,0,0,,Сәлем Кумичо
Dialogue: 0,0:10:53.98,0:10:57.28,Default,,0,0,0,,Барлық мүшелер жиналған соң директорды шешейік!
Dialogue: 0,0:10:57.36,0:11:00.28,Default,,0,0,0,,О, жақсы, егер солай істегіңіз келсе.
Dialogue: 0,0:11:00.36,0:11:01.86,Default,,0,0,0,,Рахмет сізге Кумичо
Dialogue: 0,0:11:01.95,0:11:04.12,Default,,0,0,0,,Онда мен мүшелерді жинаймын!
Dialogue: 0,0:11:04.41,0:11:07.50,Default,,0,0,0,,Мен клубқа қосылғым келетін бір адам бар.
Dialogue: 0,0:11:07.91,0:11:09.16,Default,,0,0,0,,Аға?
Dialogue: 0,0:11:10.67,0:11:15.09,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:11:16.30,0:11:18.09,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:11:18.17,0:11:19.38,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:11:23.05,0:11:26.97,Default,,0,0,0,,Көмегіңе рахмет, сен құтқарушысың.
Dialogue: 0,0:11:27.52,0:11:30.02,Default,,0,0,0,,Ханшайым үшін өмірімді бермес едім.
Dialogue: 0,0:11:30.10,0:11:31.48,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:11:31.56,0:11:32.94,Default,,0,0,0,,Құрметті батыр~
Dialogue: 0,0:11:34.73,0:11:36.32,Default,,0,0,0,,
Dialogue: 0,0:11:36.40,0:11:37.86,Default,,0,0,0,,Батыр артта!
Dialogue: 0,0:11:37.94,0:11:40.07,Default,,0,0,0,,Қауіпте, батыр! Артында!
Dialogue: 0,0:11:40.15,0:11:40.99,Default,,0,0,0,,Гах!
Dialogue: 0,0:11:41.07,0:11:41.78,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:11:43.16,0:11:43.95,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:44.03,0:11:45.20,Default,,0,0,0,,Уау!
Dialogue: 0,0:11:45.28,0:11:48.41,Default,,0,0,0,,Вахахаха!
Dialogue: 0,0:11:48.49,0:11:49.95,Default,,0,0,0,,Ача...
Dialogue: 0,0:11:51.37,0:11:54.71,Default,,0,0,0,,Иә? Менің итімнің досы ма?
Dialogue: 0,0:11:55.04,0:11:56.50,Default,,0,0,0,,Бұл Барто Аои.
Dialogue: 0,0:11:57.13,0:12:00.59,Default,,0,0,0,,Осындай жұмыстың арқасында біз көп саяхаттаймыз.
Dialogue: 0,0:12:00.92,0:12:02.17,Default,,0,0,0,,Сонымен Инсуке...
Dialogue: 0,0:12:02.26,0:12:04.55,Default,,0,0,0,,Маған дос табу қиын...
Dialogue: 0,0:12:04.64,0:12:06.10,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:12:06.18,0:12:09.52,Default,,0,0,0,,Балт-кун, Өтінемін, Инсукемен дос бол.
Dialogue: 0,0:12:09.60,0:12:11.31,Default,,0,0,0,,Әрине, маған қалдырыңыз!
Dialogue: 0,0:12:11.39,0:12:12.77,Default,,0,0,0,,Инуске ана
Dialogue: 0,0:12:13.81,0:12:15.98,Default,,0,0,0,,Рахмет батыр
Dialogue: 0,0:12:16.69,0:12:18.77,Default,,0,0,0,,Хе...
Dialogue: 0,0:12:25.07,0:12:26.28,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:26.74,0:12:28.28,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:12:28.70,0:12:31.37,Default,,0,0,0,,Шуды доғар, Бет, сәл тыныштал.
Dialogue: 0,0:12:31.45,0:12:32.79,Default,,0,0,0,,Пунсука
Dialogue: 0,0:12:32.87,0:12:35.50,Default,,0,0,0,,Мен де депрессиядамын...
Dialogue: 0,0:12:35.92,0:12:37.96,Default,,0,0,0,,Өзіңді жақсы сезінесің бе, Инуске?
Dialogue: 0,0:12:38.04,0:12:38.75,Default,,0,0,0,,…Аа!
Dialogue: 0,0:12:41.34,0:12:43.26,Default,,0,0,0,,Барто Аои…
Dialogue: 0,0:12:43.34,0:12:44.13,Default,,0,0,0,,Ахем
Dialogue: 0,0:12:44.22,0:12:47.18,Default,,0,0,0,,Бейблейд клубына қосылсаңыз, өзіңізді жақсы сезінесіз!
Dialogue: 0,0:12:47.30,0:12:48.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:48.26,0:12:49.64,Default,,0,0,0,,Өте көзге түседі.
Dialogue: 0,0:12:49.72,0:12:52.48,Default,,0,0,0,,Жалғыз мүшелер әлі мен және Кумичо.
Dialogue: 0,0:12:52.56,0:12:54.94,Default,,0,0,0,,Егер Инсуке қосылса, ол үшінші тұлға болады...
Dialogue: 0,0:12:55.02,0:12:56.81,Default,,0,0,0,,Мен оны түсінбеймін.
Dialogue: 0,0:12:56.90,0:12:59.40,Default,,0,0,0,,Бірге жаттығу қызық болар еді.
Dialogue: 0,0:12:59.48,0:13:00.44,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:13:00.52,0:13:01.90,Default,,0,0,0,,Өйткені сіз...
Dialogue: 0,0:13:02.28,0:13:03.32,Default,,0,0,0,,Ол менің жауым.
Dialogue: 0,0:13:03.40,0:13:04.70,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:13:04.78,0:13:06.86,Default,,0,0,0,,Жау емес
Dialogue: 0,0:13:06.95,0:13:08.24,Default,,0,0,0,,Бұл бәсекелес!
Dialogue: 0,0:13:08.57,0:13:09.53,Default,,0,0,0,,Қарсылас...?
Dialogue: 0,0:13:10.20,0:13:12.20,Default,,0,0,0,,Оның үстіне біз бұрыннан доспыз.
Dialogue: 0,0:13:13.37,0:13:14.66,Default,,0,0,0,,Достар...?
Dialogue: 0,0:13:15.04,0:13:17.83,Default,,0,0,0,,Ей, бірге жаттығу жасайық!
Dialogue: 0,0:13:19.50,0:13:21.00,Default,,0,0,0,,Сіз кіріп, жасай аласыз.
Dialogue: 0,0:13:21.09,0:13:22.21,Default,,0,0,0,,Ә… Мен келдім бе…
Dialogue: 0,0:13:22.30,0:13:24.17,Default,,0,0,0,,Бір шарт бар.
Dialogue: 0,0:13:24.26,0:13:26.22,Default,,0,0,0,,А... не?
Dialogue: 0,0:13:26.63,0:13:28.68,Default,,0,0,0,,Куришуумен күрессін.
Dialogue: 0,0:13:28.93,0:13:30.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:30.18,0:13:32.72,Default,,0,0,0,,Сен Шумен доссың ба?
Dialogue: 0,0:13:32.81,0:13:33.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:33.81,0:13:36.06,Default,,0,0,0,,Олай болса мен сенімен шайқасуға рұқсат ет!
Dialogue: 0,0:13:36.27,0:13:38.77,Default,,0,0,0,,Неге мен емес, Шу?
Dialogue: 0,0:13:38.85,0:13:40.02,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:40.11,0:13:41.48,Default,,0,0,0,,Мен жеңілдім
Dialogue: 0,0:13:41.57,0:13:43.65,Default,,0,0,0,,Шу дегеніміз не?
Dialogue: 0,0:13:44.57,0:13:46.78,Default,,0,0,0,,Мен тек ұрысқым келеді!
Dialogue: 0,0:13:49.95,0:13:51.08,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:13:52.49,0:13:54.33,Default,,0,0,0,,Шудан рахат алыңыз
Dialogue: 0,0:13:54.41,0:13:56.79,Default,,0,0,0,,Инсукемен шайқас.
Dialogue: 0,0:13:57.08,0:13:58.92,Default,,0,0,0,,Мен жаттығып жатырмын
Dialogue: 0,0:14:00.54,0:14:03.21,Default,,0,0,0,,Олай болса, бұл одан да көп тәжірибе болар еді.
Dialogue: 0,0:14:03.30,0:14:06.26,Default,,0,0,0,,Инусукенің Кербеусы шынымен күшті.
Dialogue: 0,0:14:06.34,0:14:09.13,Default,,0,0,0,,Және ол Шуумен соғысқысы келді.
Dialogue: 0,0:14:09.22,0:14:10.43,Default,,0,0,0,,Мен мұны естігенде, И
Dialogue: 0,0:14:10.51,0:14:13.39,Default,,0,0,0,,Мені бұл клубтан гөрі көбірек алаңдатты.
Dialogue: 0,0:14:13.68,0:14:14.60,Default,,0,0,0,,Барт…
Dialogue: 0,0:14:14.89,0:14:15.85,Default,,0,0,0,,Ал мен...
Dialogue: 0,0:14:15.93,0:14:18.81,Default,,0,0,0,,Инсукемен шайқас өте қызықты болды
Dialogue: 0,0:14:18.89,0:14:20.86,Default,,0,0,0,,Эй Шуу...
Dialogue: 0,0:14:20.94,0:14:21.98,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:14:22.06,0:14:22.98,Default,,0,0,0,,Е...!
Dialogue: 0,0:14:24.65,0:14:25.90,Default,,0,0,0,,Соғысайық
Dialogue: 0,0:14:25.99,0:14:27.53,Default,,0,0,0,,Міне!
Dialogue: 0,0:14:27.61,0:14:28.53,Default,,0,0,0,,Инсуке~!
Dialogue: 0,0:14:28.61,0:14:30.61,Default,,0,0,0,,Матчты Шуу ойнайды!
Dialogue: 0,0:14:31.74,0:14:33.12,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:14:36.87,0:14:38.25,Default,,0,0,0,,Бенишуу...
Dialogue: 0,0:14:38.71,0:14:41.08,Default,,0,0,0,,Мен Инсуке Мидорикавамын
Dialogue: 0,0:14:41.58,0:14:42.59,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:14:43.09,0:14:45.09,Default,,0,0,0,,Маған Балтомен кездесуді көрсетті.
Dialogue: 0,0:14:45.75,0:14:47.76,Default,,0,0,0,,Есіңде ме?
Dialogue: 0,0:14:47.84,0:14:49.47,Default,,0,0,0,,О, әрине
Dialogue: 0,0:14:50.76,0:14:53.60,Default,,0,0,0,,Мен сенімен төбелескім келді
Dialogue: 0,0:14:53.68,0:14:56.72,Default,,0,0,0,,Финалда сенімен жарысу менің арманым еді.
Dialogue: 0,0:14:58.23,0:14:59.10,Default,,0,0,0,,Мен құрметке бөлендім
Dialogue: 0,0:15:01.31,0:15:02.35,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:15:02.44,0:15:03.94,Default,,0,0,0,,Ал, бастайық!
Dialogue: 0,0:15:04.73,0:15:06.28,Default,,0,0,0,,Бірінші шайқас!
Dialogue: 0,0:15:07.90,0:15:09.19,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:15:10.53,0:15:12.32,Default,,0,0,0,,Кайзер Кербеус
Dialogue: 0,0:15:12.41,0:15:15.37,Default,,0,0,0,,Қорғаныс пресс жүргізушісі бар ең ауыр класс
Dialogue: 0,0:15:15.45,0:15:16.74,Default,,0,0,0,,Қорғаныс түрі
Dialogue: 0,0:15:18.25,0:15:20.16,Default,,0,0,0,,Спригган дауылы
Dialogue: 0,0:15:20.25,0:15:21.83,Default,,0,0,0,,Шабуыл және қорғаныс
Dialogue: 0,0:15:21.92,0:15:23.79,Default,,0,0,0,,Екеуінің де өнімділігін біріктіреді
Dialogue: 0,0:15:23.88,0:15:25.13,Default,,0,0,0,,Баланс түрі
Dialogue: 0,0:15:25.46,0:15:27.46,Default,,0,0,0,,Әділ келсе
Dialogue: 0,0:15:27.55,0:15:30.38,Default,,0,0,0,,Сіз толық қорғаныс үшін ұзақ мерзімді шайқас өткізгіңіз келеді.
Dialogue: 0,0:15:30.51,0:15:32.26,Default,,0,0,0,,Сен маған шабуыл жасайсың ба?
Dialogue: 0,0:15:32.34,0:15:34.93,Default,,0,0,0,,Ол қорғаныстан келеді ме? Қайсысы?
Dialogue: 0,0:15:35.26,0:15:37.26,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:15:37.47,0:15:40.81,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:41.31,0:15:43.31,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:49.69,0:15:51.45,Default,,0,0,0,,Не болып жатқанын көрдіңіз бе?
Dialogue: 0,0:15:52.32,0:15:54.28,Default,,0,0,0,,Сіз күткендей күзетіңізді күшейттіңіз.
Dialogue: 0,0:15:54.37,0:15:55.37,Default,,0,0,0,,Ұзақ соғыс болса...
Dialogue: 0,0:15:55.45,0:15:57.58,Default,,0,0,0,,Cerbeus жақсырақ.
Dialogue: 0,0:15:57.66,0:15:59.37,Default,,0,0,0,,Мен күтпеймін, көремін.
Dialogue: 0,0:15:59.45,0:16:01.16,Default,,0,0,0,,Спригганға барыңыз!
Dialogue: 0,0:16:04.46,0:16:06.13,Default,,0,0,0,,Спригган шабуыл жасады!
Dialogue: 0,0:16:06.21,0:16:07.17,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:16:07.25,0:16:09.25,Default,,0,0,0,,Шиноге Кайзер Сербеус!
Dialogue: 0,0:16:11.47,0:16:13.47,Default,,0,0,0,,Шабуылды аяқтаңыз! Спригган!
Dialogue: 0,0:16:13.68,0:16:16.60,Default,,0,0,0,,Стадионды пресс-жүргізушімен бірге соғыңыз!
Dialogue: 0,0:16:21.77,0:16:23.77,Default,,0,0,0,,Спригган да, Сербеус-
Dialogue: 0,0:16:23.85,0:16:26.27,Default,,0,0,0,,Екеуі де керемет!
Dialogue: 0,0:16:26.36,0:16:28.82,Default,,0,0,0,,Спригган Оны құрт!
Dialogue: 0,0:16:33.15,0:16:34.41,Default,,0,0,0,,бөлінген
Dialogue: 0,0:16:34.61,0:16:36.57,Default,,0,0,0,,Жарайды, оны ұзақ мерзімге келтірейік.
Dialogue: 0,0:16:36.66,0:16:37.95,Default,,0,0,0,,Бұл менікі!
Dialogue: 0,0:16:38.03,0:16:39.08,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:16:39.16,0:16:39.70,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:42.33,0:16:42.83,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:43.00,0:16:45.12,Default,,0,0,0,,Цербейдің айналуы әлсірейді.
Dialogue: 0,0:16:45.21,0:16:46.88,Default,,0,0,0,,Мен...
Dialogue: 0,0:16:47.25,0:16:49.80,Default,,0,0,0,,Спригганды ұзақ мерзімді шайқастарда да қолдануға болады.
Dialogue: 0,0:16:49.88,0:16:51.63,Default,,0,0,0,,Бұл баланс түрі!
Dialogue: 0,0:16:53.38,0:16:56.34,Default,,0,0,0,,(Айналудың тоқтау дыбысы)
Dialogue: 0,0:16:56.43,0:17:00.56,Default,,0,0,0,,Айналдыру аяқталуы! Сторм Спригган жеңеді!
Dialogue: 0,0:17:00.64,0:17:02.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:02.56,0:17:04.06,Default,,0,0,0,,1 ұпай Шу үшін
Dialogue: 0,0:17:04.77,0:17:06.35,Default,,0,0,0,,Бұл дәмді Инуске болды
Dialogue: 0,0:17:06.73,0:17:09.23,Default,,0,0,0,,Егер мен аздап қыңыр болсам, жеңуім мүмкін еді.
Dialogue: 0,0:17:09.31,0:17:11.73,Default,,0,0,0,,Маған ешқандай жайлылық керек емес.
Dialogue: 0,0:17:11.82,0:17:14.49,Default,,0,0,0,,Екінші шайқас әлі бар.
Dialogue: 0,0:17:14.82,0:17:17.53,Default,,0,0,0,,О! Олай болса, екінші шайқасқа шығайық!
Dialogue: 0,0:17:17.61,0:17:21.12,Default,,0,0,0,,Келесі жолы мен міндетті түрде жеңемін!
Dialogue: 0,0:17:21.20,0:17:23.25,Default,,0,0,0,,Қазір қызып бара жатқан сияқты.
Dialogue: 0,0:17:23.33,0:17:24.54,Default,,0,0,0,,Сен мені жеңе алмайсың
Dialogue: 0,0:17:24.62,0:17:25.71,Default,,0,0,0,,Не!
Dialogue: 0,0:17:28.42,0:17:29.88,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:17:29.96,0:17:31.34,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:17:32.71,0:17:34.38,Default,,0,0,0,,Сіз шабуыл жасайсыз ба?
Dialogue: 0,0:17:34.47,0:17:36.80,Default,,0,0,0,,Сіз қорғанысқа келесіз бе? Қайсысы?
Dialogue: 0,0:17:37.76,0:17:39.76,Default,,0,0,0,,Мен өзімді ұстай алмадым...
Dialogue: 0,0:17:40.14,0:17:41.72,Default,,0,0,0,,Не істеуім керек...
Dialogue: 0,0:17:42.68,0:17:45.39,Default,,0,0,0,,Бірінші шайқаста аз ғана есеппен жеңілді
Dialogue: 0,0:17:45.48,0:17:46.64,Default,,0,0,0,,Сіз абдырап қалдыңыз.
Dialogue: 0,0:17:47.23,0:17:48.73,Default,,0,0,0,,Шатасу...
Dialogue: 0,0:17:48.81,0:17:51.11,Default,,0,0,0,,Мен саған батамды беремін.
Dialogue: 0,0:17:51.19,0:17:52.98,Default,,0,0,0,,Сіз оны түсінбесеңіз...
Dialogue: 0,0:17:53.48,0:17:55.44,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:17:55.78,0:17:58.99,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:59.87,0:18:02.08,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:07.08,0:18:09.63,Default,,0,0,0,,Уа, Кербеус шабуыл жасады!
Dialogue: 0,0:18:09.71,0:18:11.17,Default,,0,0,0,,Бұл жылдам шабуыл!
Dialogue: 0,0:18:11.25,0:18:12.75,Default,,0,0,0,,Алға!
Dialogue: 0,0:18:12.84,0:18:15.55,Default,,0,0,0,,Кайзер Сербеус!
Dialogue: 0,0:18:15.63,0:18:17.88,Default,,0,0,0,,(иттің үруі)
Dialogue: 0,0:18:17.97,0:18:21.01,Default,,0,0,0,,(ит үреді)
Dialogue: 0,0:18:25.14,0:18:27.85,Default,,0,0,0,,Қабыл алыңыз! Спригган дауылы!
Dialogue: 0,0:18:32.44,0:18:34.78,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:18:40.61,0:18:41.74,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:18:43.16,0:18:43.95,Default,,0,0,0,,Не!
Dialogue: 0,0:18:44.03,0:18:45.37,Default,,0,0,0,,Фуми қалды!
Dialogue: 0,0:18:45.45,0:18:46.87,Default,,0,0,0,,Бұл Спригган
Dialogue: 0,0:18:46.95,0:18:48.87,Default,,0,0,0,,Unite Driver күші!
Dialogue: 0,0:18:48.96,0:18:50.21,Default,,0,0,0,,О~. Құдай-ай!
Dialogue: 0,0:18:50.29,0:18:52.00,Default,,0,0,0,,Қарсы үзіліс!
Dialogue: 0,0:18:53.00,0:18:55.71,Default,,0,0,0,,(үру)
Dialogue: 0,0:18:56.26,0:18:58.38,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:18:58.47,0:19:00.22,Default,,0,0,0,,Ол жарылып кетті!
Dialogue: 0,0:19:06.35,0:19:08.18,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:19:08.81,0:19:09.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:10.14,0:19:12.23,Default,,0,0,0,,А... аа...!
Dialogue: 0,0:19:13.23,0:19:15.82,Default,,0,0,0,,Шу жарылып жеңіске жетті!
Dialogue: 0,0:19:16.82,0:19:18.78,Default,,0,0,0,,Есептегіш үзіліс…
Dialogue: 0,0:19:19.11,0:19:20.65,Default,,0,0,0,,Бенишу...
Dialogue: 0,0:19:20.74,0:19:22.74,Default,,0,0,0,,Бұл өте күшті...!
Dialogue: 0,0:19:24.58,0:19:26.03,Default,,0,0,0,,Бұл жақсы шайқас болды.
Dialogue: 0,0:19:26.54,0:19:28.58,Default,,0,0,0,,Немесе... Керемет ойнамаңыз!
Dialogue: 0,0:19:28.66,0:19:30.00,Default,,0,0,0,,Келесі жолы ұрысамыз...
Dialogue: 0,0:19:30.08,0:19:32.08,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:19:32.17,0:19:35.09,Default,,0,0,0,,Сіз тағы да төбелесесіз, солай ма?
Dialogue: 0,0:19:35.17,0:19:35.96,Default,,0,0,0,,Ах
Dialogue: 0,0:19:36.96,0:19:39.13,Default,,0,0,0,,Қайсысы нағыз сенсің?
Dialogue: 0,0:19:39.21,0:19:40.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:40.30,0:19:42.18,Default,,0,0,0,,Екеуі де инсуке.
Dialogue: 0,0:19:42.26,0:19:43.22,Default,,0,0,0,,Make noise!
Dialogue: 0,0:19:43.30,0:19:45.35,Default,,0,0,0,,Өтінемін, үндемей тұрасың ба?
Dialogue: 0,0:19:45.43,0:19:46.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:47.01,0:19:49.31,Default,,0,0,0,,(тазалау алаңының дыбысы)
Dialogue: 0,0:19:49.64,0:19:51.19,Default,,0,0,0,,Сәлем, Инуске!
Dialogue: 0,0:19:51.27,0:19:52.81,Default,,0,0,0,,Бей клубы, солай ма?
Dialogue: 0,0:19:52.90,0:19:53.90,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:19:53.98,0:19:55.06,Default,,0,0,0,,Гах...
Dialogue: 0,0:19:55.15,0:19:56.69,Default,,0,0,0,,Тағы да әуеніңді бұздың! Қанша рет айтуым керек саған түсіну үшін!—
Dialogue: 0,0:19:56.77,0:19:59.19,Default,,0,0,0,,Сіз кіремін дедіңіз...
Dialogue: 0,0:19:59.28,0:20:00.36,Default,,0,0,0,,Шу!
Dialogue: 0,0:20:00.44,0:20:02.49,Default,,0,0,0,,Әрине кіресің, солай ма?
Dialogue: 0,0:20:02.57,0:20:04.57,Default,,0,0,0,,Біздің Бейблейд клубы
Dialogue: 0,0:20:04.66,0:20:06.66,Default,,0,0,0,,Мен көп адамдарды ұнатпаймын.
Dialogue: 0,0:20:06.74,0:20:07.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:08.62,0:20:10.75,Default,,0,0,0,,Мұны өзіңіз қалағандай жасаңыз.
Dialogue: 0,0:20:11.21,0:20:12.54,Default,,0,0,0,,Е!
Dialogue: 0,0:20:12.62,0:20:15.50,Default,,0,0,0,,Не, Бей клубына қосыл.
Dialogue: 0,0:20:15.58,0:20:17.75,Default,,0,0,0,,Есептегіш үзіліс?
Dialogue: 0,0:20:18.17,0:20:20.55,Default,,0,0,0,,Барған сайын көңілім көтеріліп барады.
Dialogue: 0,0:20:20.92,0:20:23.38,Default,,0,0,0,,Куришуумен шайқас
Dialogue: 0,0:20:23.97,0:20:25.30,Default,,0,0,0,,(үй қоңырауы)
Dialogue: 0,0:20:25.39,0:20:27.85,Default,,0,0,0,,Иә, қазір кеттік!
Dialogue: 0,0:20:28.89,0:20:31.39,Default,,0,0,0,,Иә, иә... Сіз кімсіз?
Dialogue: 0,0:20:31.48,0:20:32.60,Default,,0,0,0,,Бұл Бет.
Dialogue: 0,0:20:32.68,0:20:33.48,Default,,0,0,0,,Кел~
Dialogue: 0,0:20:33.56,0:20:35.65,Default,,0,0,0,,Кяаааа!
Dialogue: 0,0:20:35.73,0:20:37.23,Default,,0,0,0,,Анашым, не болды?
Dialogue: 0,0:20:37.31,0:20:40.48,Default,,0,0,0,,Міне... сыртта біртүрлі нәрсе бар...
Dialogue: 0,0:20:40.57,0:20:41.40,Default,,0,0,0,,Эх!
Dialogue: 0,0:20:42.57,0:20:45.28,Default,,0,0,0,,Иә, ол Балтоның досы...
Dialogue: 0,0:20:45.36,0:20:47.24,Default,,0,0,0,,Оны Инуске деп атайды.
Dialogue: 0,0:20:47.32,0:20:48.91,Default,,0,0,0,,Сәлем
Dialogue: 0,0:20:48.99,0:20:50.37,Default,,0,0,0,,Сәлем
Dialogue: 0,0:20:50.45,0:20:52.12,Default,,0,0,0,,Егер мен сенен көтерілуіңді сұрасам ше?
Dialogue: 0,0:20:52.20,0:20:53.04,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:53.12,0:20:54.41,Default,,0,0,0,,Не үшін келдің?
Dialogue: 0,0:20:54.50,0:20:57.42,Default,,0,0,0,,Ұрыста жеңілгенім үшін, мүмкін, кек алайын деп жатқан шығармын...!
Dialogue: 0,0:20:57.50,0:20:58.84,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:20:59.63,0:21:01.51,Default,,0,0,0,,Бей клубына қосылыңыз
Dialogue: 0,0:21:01.59,0:21:02.42,Default,,0,0,0,,Не!
Dialogue: 0,0:21:02.51,0:21:03.55,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:21:03.72,0:21:05.34,Default,,0,0,0,,Күте тұрыңыз, Инуске!
Dialogue: 0,0:21:05.72,0:21:07.72,Default,,0,0,0,,О! Сен не істеп жатырсың?
Dialogue: 0,0:21:07.80,0:21:09.01,Default,,0,0,0,,Мен жол бойы келдім.
Dialogue: 0,0:21:09.10,0:21:10.81,Default,,0,0,0,,Сабыр етіңіз
Dialogue: 0,0:21:10.89,0:21:12.60,Default,,0,0,0,,Дұрыс, алданып қалмаңыз.
Dialogue: 0,0:21:12.68,0:21:14.94,Default,,0,0,0,,А, жоқ, жоқ, мен үйге бара жатырмын...
Dialogue: 0,0:21:15.02,0:21:16.48,Default,,0,0,0,,(Каишо) Қорықпа—ағамның қаны менікімен бірдей қасиетке ие емес.
Dialogue: 0,0:21:16.56,0:21:17.90,Default,,0,0,0,,Кері сөйлесіңіз
Dialogue: 0,0:21:17.98,0:21:20.77,Default,,0,0,0,,Бар, мен жасаған нанды же!
Dialogue: 0,0:21:21.90,0:21:23.53,Default,,0,0,0,,(Кёсукэ Хори) Егер әке кетіп қалса—
Dialogue: 0,0:21:23.61,0:21:25.03,Default,,0,0,0,,Itadadakimasu...
Dialogue: 0,0:21:25.74,0:21:26.95,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:21:28.03,0:21:30.91,Default,,0,0,0,,Анамның наны дәмді!
Dialogue: 0,0:21:30.99,0:21:32.87,Default,,0,0,0,,(нан жеу дыбысы)
Dialogue: 0,0:21:42.09,0:21:43.09,Default,,0,0,0,,Ах...!
Dialogue: 0,0:21:43.71,0:21:44.63,Default,,0,0,0,,Конверт пе?
Dialogue: 0,0:21:50.85,0:21:52.89,Default,,0,0,0,,Бей клубы құрылғанға дейін
Dialogue: 0,0:21:52.97,0:21:54.52,Default,,0,0,0,,Тағы екеуі ғана!
Dialogue: 0,0:22:09.16,0:22:15.25,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.45,0:22:21.59,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады
Dialogue: 0,0:22:22.04,0:22:27.59,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.05,0:22:31.39,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.55,0:22:36.48,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.39,0:22:41.10,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.19,0:22:44.40,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.48,0:22:50.82,Default,,0,0,0,,Артынан қуып жетсең, көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:51.07,0:22:56.62,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.79,0:23:03.38,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:03.96,0:23:09.38,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.55,0:23:12.72,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.22,0:23:17.18,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.57,0:23:29.53,Default,,0,0,0,,Менің үшінші раундтағы қарсыласым – Курогами Дина.
Dialogue: 0,0:23:29.61,0:23:31.70,Default,,0,0,0,,Ол шынымен жиіркенішті.
Dialogue: 0,0:23:31.78,0:23:34.66,Default,,0,0,0,,Оны жеңу үшін арнайы дайындықтан өту керек!
Dialogue: 0,0:23:34.74,0:23:37.49,Default,,0,0,0,,Шапшаң ату мінсіз болғанша
Dialogue: 0,0:23:37.58,0:23:40.50,Default,,0,0,0,,Арнайы дайындық Арнайы дайындық Әйтеуір, арнайы дайындық!
Dialogue: 0,0:23:40.91,0:23:42.79,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:42.87,0:23:45.79,Default,,0,0,0,,Қасқыр Корин! Қара өлім өлшемі!
Dialogue: 0,0:23:45.88,0:23:48.09,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.17,0:23:49.97,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.47,0:23:57.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory