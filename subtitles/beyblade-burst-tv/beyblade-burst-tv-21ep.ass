Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.09,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.17,0:00:12.59,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.76,0:00:14.80,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.88,0:00:17.18,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.26,0:00:19.39,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.23,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.23,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.31,0:00:28.69,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.69,0:00:34.07,Default,,0,0,0,,Сен менің досымсың!
Dialogue: 0,0:00:34.57,0:00:37.32,Default,,0,0,0,,Қай жерде болсаңыз да, не істеп жатсаңыз да...
Dialogue: 0,0:00:37.41,0:00:39.08,Default,,0,0,0,,Бұл өзгермейді, эй!
Dialogue: 0,0:00:39.16,0:00:41.66,Default,,0,0,0,,Инсуке, бар күшіңді салып жүр!
Dialogue: 0,0:00:41.75,0:00:43.29,Default,,0,0,0,,Мен қарап тұрмын!
Dialogue: 0,0:00:44.29,0:00:47.38,Default,,0,0,0,,Себебі сен мені бақылап тұрсың...
Dialogue: 0,0:00:47.46,0:00:48.92,Default,,0,0,0,,Мен күресе аламын!
Dialogue: 0,0:00:51.13,0:00:53.80,Default,,0,0,0,,Cerbeus! Бұл тізбекті түсірілім!
Dialogue: 0,0:01:00.10,0:01:02.52,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:01:03.48,0:01:06.90,Default,,0,0,0,,Кайзер Кербеус осылайша шайқасады
Dialogue: 0,0:01:06.98,0:01:10.90,Default,,0,0,0,,Енді ойланбаңыз, тізбекті ату!
Dialogue: 0,0:01:12.82,0:01:13.86,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:01:13.94,0:01:19.12,Default,,0,0,0,,Барлығына! Inusuke Sword Flames-тің Укио мен Югоны жеңді.
Dialogue: 0,0:01:19.78,0:01:22.37,Default,,0,0,0,,Мен қазір сенімен шайқаспақпын!
Dialogue: 0,0:01:22.74,0:01:24.66,Default,,0,0,0,,Керемет, шайқасайық!
Dialogue: 0,0:01:25.87,0:01:28.71,Default,,0,0,0,,Ләззат менікі.
Dialogue: 0,0:01:28.79,0:01:30.08,Default,,0,0,0,,Шака…
Dialogue: 0,0:01:30.17,0:01:32.17,Default,,0,0,0,,Соңғы қарсылас – Шақа
Dialogue: 0,0:01:32.63,0:01:35.13,Default,,0,0,0,,Инускені міндетті түрде жеңіңіз
Dialogue: 0,0:01:43.77,0:01:46.14,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:46.48,0:01:51.65,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:02:02.95,0:02:06.33,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:02:06.83,0:02:08.96,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:02:09.37,0:02:13.50,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:13.63,0:02:16.84,Default,,0,0,0,,Дұрыс, сіздің жүзіңіздегі өрнек
Dialogue: 0,0:02:16.97,0:02:23.39,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:23.68,0:02:28.10,Default,,0,0,0,,АУ! Айналып келе жатқан арман
Dialogue: 0,0:02:28.60,0:02:34.02,Default,,0,0,0,,Ыстық және тербеліс ойнайық
Dialogue: 0,0:02:34.15,0:02:36.40,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:36.48,0:02:41.20,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:41.36,0:02:46.45,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:46.74,0:02:49.00,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:49.21,0:02:51.54,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:51.83,0:02:55.75,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:55.92,0:03:00.93,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:03:01.13,0:03:03.30,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:07.52,0:03:09.31,Default,,0,0,0,,Достық шайқасы!
Dialogue: 0,0:03:11.64,0:03:12.60,Default,,0,0,0,,Оссу
Dialogue: 0,0:03:12.77,0:03:15.65,Default,,0,0,0,,Қылыш оттары №3 Шака қарсы.
Dialogue: 0,0:03:15.73,0:03:19.61,Default,,0,0,0,,Йонекома Гакуэн Бэй клубы №3 Мидорикава Инусуке
Dialogue: 0,0:03:21.07,0:03:22.95,Default,,0,0,0,,Шақаға қарсы күрес
Dialogue: 0,0:03:23.36,0:03:25.95,Default,,0,0,0,,Төрт бұрылатын император Шакамен күресуге болады.
Dialogue: 0,0:03:32.00,0:03:33.33,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:03:33.58,0:03:35.50,Default,,0,0,0,,Инсуке Мидорикава…
Dialogue: 0,0:03:36.17,0:03:39.05,Default,,0,0,0,,Қорғаныс түрі Kaiser Cerbeus
Dialogue: 0,0:03:39.13,0:03:42.80,Default,,0,0,0,,Укионы батыл шабуыл стратегиясымен жеңіңіз.
Dialogue: 0,0:03:43.51,0:03:44.80,Default,,0,0,0,,Юго үшін жалғасы...
Dialogue: 0,0:03:45.55,0:03:49.06,Default,,0,0,0,,Қорғаныс пен қарсыластардың үздіксіз шабуылдарымен жеңіске жетті
Dialogue: 0,0:03:50.27,0:03:52.52,Default,,0,0,0,,Кілт шынжырлы шұңқыр болды
Dialogue: 0,0:03:53.02,0:03:54.02,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:03:55.48,0:03:57.44,Default,,0,0,0,,Тізбекті шұңқырды кесіңіз
Dialogue: 0,0:03:58.61,0:04:01.74,Default,,0,0,0,,Шақа күш жағын алып шықты.
Dialogue: 0,0:04:02.15,0:04:04.53,Default,,0,0,0,,Соны жесең, Кербеус та...
Dialogue: 0,0:04:06.82,0:04:09.41,Default,,0,0,0,,Жоқ, сіз төбелесіп көрмейінше білмейсіз.
Dialogue: 0,0:04:11.75,0:04:12.75,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:04:13.12,0:04:14.25,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:04:15.00,0:04:16.79,Default,,0,0,0,,Сіз шынымен жеңе аласыз ба?
Dialogue: 0,0:04:17.54,0:04:20.05,Default,,0,0,0,,Рух бұрынғыдан өзгеше.
Dialogue: 0,0:04:20.55,0:04:21.76,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:21.92,0:04:23.97,Default,,0,0,0,,Мен жеңілсем де, Балто сонда қалады.
Dialogue: 0,0:04:24.30,0:04:25.80,Default,,0,0,0,,Уақыт!
Dialogue: 0,0:04:26.14,0:04:28.43,Default,,0,0,0,,Қатты болма, Инуске
Dialogue: 0,0:04:28.51,0:04:29.85,Default,,0,0,0,,Демалыңыз!
Dialogue: 0,0:04:31.02,0:04:32.89,Default,,0,0,0,,Шақаның бәрін көрсетемін
Dialogue: 0,0:04:33.23,0:04:36.35,Default,,0,0,0,,Мен мені Балтомен байланыстыратын шайқасқа барамын, сонда қалғаны...
Dialogue: 0,0:04:36.48,0:04:37.81,Default,,0,0,0,,Қосылу қажет емес
Dialogue: 0,0:04:38.98,0:04:40.61,Default,,0,0,0,,Жеңіске жет, Инуске
Dialogue: 0,0:04:40.69,0:04:41.86,Default,,0,0,0,,Бұл жан-жақты шайқас
Dialogue: 0,0:04:42.15,0:04:43.24,Default,,0,0,0,,Барт…
Dialogue: 0,0:04:46.61,0:04:47.70,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:04:47.95,0:04:49.58,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:04:51.70,0:04:53.58,Default,,0,0,0,,Менің рухым қайта оралды
Dialogue: 0,0:04:53.66,0:04:55.75,Default,,0,0,0,,Бұл солай болуы керек.
Dialogue: 0,0:04:56.12,0:04:58.21,Default,,0,0,0,,Шака қуат жағында
Dialogue: 0,0:04:58.33,0:04:59.71,Default,,0,0,0,,Сонда мен...
Dialogue: 0,0:05:00.30,0:05:02.17,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:05:02.38,0:05:03.67,Default,,0,0,0,,Мұнда шабуыл жасаңыз
Dialogue: 0,0:05:04.09,0:05:06.93,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:07.43,0:05:09.72,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:14.35,0:05:15.81,Default,,0,0,0,,Сәтсіз ату?
Dialogue: 0,0:05:15.98,0:05:19.31,Default,,0,0,0,,Қозғалыс аласапыран, бірақ күш кеміген жоқ.
Dialogue: 0,0:05:19.94,0:05:22.23,Default,,0,0,0,,Мен мұндай сәтсіз атуды ешқашан көрген емеспін.
Dialogue: 0,0:05:22.65,0:05:25.86,Default,,0,0,0,,Қуат жағы орасан зор қуат береді, бірақ
Dialogue: 0,0:05:25.95,0:05:28.53,Default,,0,0,0,,Тәуекел де үлкен Осыны білдіреді ме...
Dialogue: 0,0:05:28.78,0:05:29.82,Default,,0,0,0,,Иә
Dialogue: 0,0:05:33.49,0:05:34.95,Default,,0,0,0,,Тізбекті ату!
Dialogue: 0,0:05:36.41,0:05:37.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:38.83,0:05:39.96,Default,,0,0,0,,Cerbeus!
Dialogue: 0,0:05:41.54,0:05:42.80,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:05:55.56,0:05:57.56,Default,,0,0,0,,А, тоқтап қалды.
Dialogue: 0,0:05:57.64,0:05:59.35,Default,,0,0,0,,Сәттілік Кербеус
Dialogue: 0,0:06:02.73,0:06:03.65,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,0:06:03.82,0:06:05.61,Default,,0,0,0,,Қайсысы бірінші тоқтайды?
Dialogue: 0,0:06:09.36,0:06:12.33,Default,,0,0,0,,Айналдырудың екеуі де бір уақытта тартылады
Dialogue: 0,0:06:12.66,0:06:13.58,Default,,0,0,0,,Еркек!
Dialogue: 0,0:06:17.25,0:06:19.08,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:06:19.46,0:06:20.88,Default,,0,0,0,,Тізбекті түсіру?
Dialogue: 0,0:06:21.04,0:06:23.00,Default,,0,0,0,,Бұлай етпе, Кербеус
Dialogue: 0,0:06:23.29,0:06:24.30,Default,,0,0,0,,Куу!
Dialogue: 0,0:06:24.38,0:06:27.47,Default,,0,0,0,,Мен шынымен 1 ұпай алдым деп ойладым.
Dialogue: 0,0:06:27.55,0:06:29.22,Default,,0,0,0,,Бұл дәмді болды.
Dialogue: 0,0:06:29.30,0:06:30.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:30.30,0:06:31.59,Default,,0,0,0,,Мен оны келесі жолы аламын.
Dialogue: 0,0:06:31.80,0:06:33.10,Default,,0,0,0,,Жоқ! Inusuke
Dialogue: 0,0:06:34.60,0:06:35.81,Default,,0,0,0,,Келесі жолы...
Dialogue: 0,0:06:37.35,0:06:38.31,Default,,0,0,0,,Ер
Dialogue: 0,0:06:38.39,0:06:39.89,Default,,0,0,0,,Екінші шайқас келе жатыр
Dialogue: 0,0:06:48.69,0:06:49.82,Default,,0,0,0,,Мүлдем...
Dialogue: 0,0:06:49.99,0:06:51.53,Default,,0,0,0,,Келесі жолы міндетті түрде!
Dialogue: 0,0:06:51.78,0:06:53.07,Default,,0,0,0,,Қарапайым айтқанда—
Dialogue: 0,0:06:53.70,0:06:55.03,Default,,0,0,0,,Ол қалай шығады?
Dialogue: 0,0:06:55.37,0:06:56.74,Default,,0,0,0,,Қорғау немесе шабуыл жасау?
Dialogue: 0,0:06:57.29,0:06:58.87,Default,,0,0,0,,Мен қалай жеңе аламын?
Dialogue: 0,0:06:59.25,0:07:01.12,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:07:01.67,0:07:04.46,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:04.71,0:07:07.09,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:07.17,0:07:08.59,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:07:10.80,0:07:11.55,Default,,0,0,0,,мотивацияң — мүлде басқаша болады ғой?
Dialogue: 0,0:07:11.68,0:07:14.14,Default,,0,0,0,,Бірінен соң бірі сәтсіз соққылар жасамаңыз.
Dialogue: 0,0:07:14.22,0:07:15.51,Default,,0,0,0,,Шақа күткендей.
Dialogue: 0,0:07:17.56,0:07:20.56,Default,,0,0,0,,Cerbeus пресс драйвері ең ауыр
Dialogue: 0,0:07:20.89,0:07:23.15,Default,,0,0,0,,Мен тіпті Экскалибурға да жеңілмеймін
Dialogue: 0,0:07:23.60,0:07:25.23,Default,,0,0,0,,Тізбекті ату!
Dialogue: 0,0:07:27.11,0:07:28.03,Default,,0,0,0,,Иә!
Dialogue: 0,0:07:28.11,0:07:29.86,Default,,0,0,0,,Позаны реттеу мүмкін емес
Dialogue: 0,0:07:32.82,0:07:34.53,Default,,0,0,0,,Таэро! Cerbeus
Dialogue: 0,0:07:36.16,0:07:37.33,Default,,0,0,0,,Cerbeus
Dialogue: 0,0:07:39.33,0:07:41.71,Default,,0,0,0,,Жарайды, осы жерден қайта құрастырайық.
Dialogue: 0,0:07:46.25,0:07:48.50,Default,,0,0,0,,Бір әсер
Dialogue: 0,0:07:50.47,0:07:52.05,Default,,0,0,0,,(сыртылдаған дыбыс)
Dialogue: 0,0:07:52.13,0:07:53.55,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:07:54.30,0:07:55.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:55.55,0:07:56.97,Default,,0,0,0,,Толық аяқтау
Dialogue: 0,0:07:57.14,0:07:59.18,Default,,0,0,0,,Excalibur 2 ұпай
Dialogue: 0,0:07:59.27,0:08:02.19,Default,,0,0,0,,Шака 2-0 еркекті жеңді
Dialogue: 0,0:08:04.85,0:08:07.19,Default,,0,0,0,,Бұл тез аяқталды, солай емес пе?
Dialogue: 0,0:08:07.27,0:08:09.19,Default,,0,0,0,,Бұл табиғи нәтиже.
Dialogue: 0,0:08:10.90,0:08:12.20,Default,,0,0,0,,Инсуке!
Dialogue: 0,0:08:14.41,0:08:15.78,Default,,0,0,0,,Жеңіске жете алмады
Dialogue: 0,0:08:16.16,0:08:17.66,Default,,0,0,0,,Жарайсың
Dialogue: 0,0:08:17.74,0:08:19.87,Default,,0,0,0,,Сіздің еңбекқорлығыңыз маған көрсетілді.
Dialogue: 0,0:08:20.95,0:08:22.08,Default,,0,0,0,,Уәде…
Dialogue: 0,0:08:22.83,0:08:24.79,Default,,0,0,0,,Мен мұны істесем де, мен жеңдім.
Dialogue: 0,0:08:25.25,0:08:27.08,Default,,0,0,0,,Барлығы үшін жеңіс
Dialogue: 0,0:08:27.50,0:08:28.50,Default,,0,0,0,,Инсуке
Dialogue: 0,0:08:28.59,0:08:30.59,Default,,0,0,0,,Мен сенің күшіңді толық сезінемін.
Dialogue: 0,0:08:31.09,0:08:32.22,Default,,0,0,0,,Бұл жолы менмін
Dialogue: 0,0:08:32.88,0:08:33.92,Default,,0,0,0,,Барт…
Dialogue: 0,0:08:34.63,0:08:35.51,Default,,0,0,0,,Иә
Dialogue: 0,0:08:35.89,0:08:38.39,Default,,0,0,0,,Біз бәріміз осы уақытқа дейін келдік.
Dialogue: 0,0:08:38.64,0:08:40.18,Default,,0,0,0,,Бірінші 1 ұпай алсаңыз да-
Dialogue: 0,0:08:40.39,0:08:42.68,Default,,0,0,0,,Мен қорғанысқа шықпаймын, шабуылдаймын!
Dialogue: 0,0:08:43.02,0:08:44.89,Default,,0,0,0,,Біз командамыз, солай ма?
Dialogue: 0,0:08:44.98,0:08:45.90,Default,,0,0,0,,О
Dialogue: 0,0:08:45.98,0:08:47.65,Default,,0,0,0,,Біз бір командамыз
Dialogue: 0,0:08:48.86,0:08:50.27,Default,,0,0,0,,Менің жоғалтуым...
Dialogue: 0,0:08:50.36,0:08:52.57,Default,,0,0,0,,Бұл келесі шайқасқа әкеледі деп үміттенемін.
Dialogue: 0,0:08:52.99,0:08:54.61,Default,,0,0,0,,Дұрыс, Кумичо.
Dialogue: 0,0:08:54.70,0:08:56.36,Default,,0,0,0,,Жарайды, мені қос!
Dialogue: 0,0:08:56.45,0:08:57.07,Default,,0,0,0,,О!
Dialogue: 0,0:08:57.41,0:08:59.62,Default,,0,0,0,,Бәріміз бірге күресеміз.
Dialogue: 0,0:08:59.70,0:09:00.79,Default,,0,0,0,,сөзсіз Лорд Дэмиан болары анық.
Dialogue: 0,0:09:00.95,0:09:02.37,Default,,0,0,0,,Ал... жең
Dialogue: 0,0:09:02.83,0:09:04.66,Default,,0,0,0,,Неге олай? Өте суықсың ғой.
Dialogue: 0,0:09:06.04,0:09:08.13,Default,,0,0,0,,Мен қызып кеттім!
Dialogue: 0,0:09:08.21,0:09:11.34,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:09:12.55,0:09:13.42,Default,,0,0,0,,♬~
Dialogue: 0,0:09:14.22,0:09:17.09,Default,,0,0,0,,Қылыш оттары №3 Шака қарсы.
Dialogue: 0,0:09:17.18,0:09:20.43,Default,,0,0,0,,Йонекома Гакуэн Бэй клубы №4 Аои Балт
Dialogue: 0,0:09:20.51,0:09:22.06,Default,,0,0,0,,Бұл матчта кім жеңеді?
Dialogue: 0,0:09:22.14,0:09:24.14,Default,,0,0,0,,Командалық матчта жеңімпаз топ.
Dialogue: 0,0:09:24.43,0:09:26.14,Default,,0,0,0,,Мен оны сұрадым! Балтық
Dialogue: 0,0:09:26.23,0:09:28.23,Default,,0,0,0,,Бар күшіңізбен жүріңіз!
Dialogue: 0,0:09:28.31,0:09:29.69,Default,,0,0,0,,Соғыс!
Dialogue: 0,0:09:30.57,0:09:32.36,Default,,0,0,0,,Бір-бірі, соңғысы
Dialogue: 0,0:09:32.44,0:09:34.99,Default,,0,0,0,,Бұл шайқаста 3 ұпайлық жүйе бар.
Dialogue: 0,0:09:35.36,0:09:37.32,Default,,0,0,0,,О, тамаша! Қанекей мынаны істейік!
Dialogue: 0,0:09:37.41,0:09:39.49,Default,,0,0,0,,Чемпионат матчын қараңыз.
Dialogue: 0,0:09:40.32,0:09:43.04,Default,,0,0,0,,Бірінші 3 ұпай жинаған жеңеді.
Dialogue: 0,0:09:43.70,0:09:44.66,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:09:46.71,0:09:48.42,Default,,0,0,0,,Маған Балтоны көрсет
Dialogue: 0,0:09:48.75,0:09:50.46,Default,,0,0,0,,Жанымды күйдіретін шайқас
Dialogue: 0,0:09:50.84,0:09:53.09,Default,,0,0,0,,Маған қарашы, Инуске, бәрің.
Dialogue: 0,0:09:53.17,0:09:55.88,Default,,0,0,0,,Бар күшіммен шайқас!
Dialogue: 0,0:09:56.17,0:09:58.09,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:09:58.18,0:10:01.26,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:01.51,0:10:03.93,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:04.27,0:10:07.10,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:07.18,0:10:09.69,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:10.56,0:10:12.23,Default,,0,0,0,,Тез ату!
Dialogue: 0,0:10:14.03,0:10:14.90,Default,,0,0,0,,баяу
Dialogue: 0,0:10:17.07,0:10:18.32,Default,,0,0,0,,Не?
Dialogue: 0,0:10:18.40,0:10:20.49,Default,,0,0,0,,Бұл сіздің әдеттегі асығыс атуыңыз емес.
Dialogue: 0,0:10:20.57,0:10:22.28,Default,,0,0,0,,Не? Сәтсіз ату?
Dialogue: 0,0:10:24.37,0:10:26.20,Default,,0,0,0,,Не болды, Валькири?
Dialogue: 0,0:10:27.91,0:10:30.00,Default,,0,0,0,,Цурануке Экскалибур!
Dialogue: 0,0:10:34.96,0:10:36.71,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:10:37.30,0:10:39.05,Default,,0,0,0,,Аяқтау
Dialogue: 0,0:10:39.13,0:10:41.01,Default,,0,0,0,,Excalibur 1 ұпай
Dialogue: 0,0:10:41.09,0:10:42.64,Default,,0,0,0,,1-ден 0-ге дейінгі нүктелер
Dialogue: 0,0:10:43.05,0:10:44.51,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:44.60,0:10:45.93,Default,,0,0,0,,Шақа күткендей!
Dialogue: 0,0:10:46.02,0:10:48.81,Default,,0,0,0,,Тозен! Бұл Шақаның құдіреті
Dialogue: 0,0:10:48.89,0:10:49.73,Default,,0,0,0,,Еркек!
Dialogue: 0,0:10:49.94,0:10:52.40,Default,,0,0,0,,Валькири өте оңай...
Dialogue: 0,0:10:52.48,0:10:54.11,Default,,0,0,0,,Xeno Excalibur
Dialogue: 0,0:10:54.19,0:10:56.15,Default,,0,0,0,,Шабуыл күші нашар.
Dialogue: 0,0:10:56.57,0:10:59.15,Default,,0,0,0,,Валькирияның қимылдары...
Dialogue: 0,0:10:59.49,0:11:01.20,Default,,0,0,0,,Уайымдама, Балто
Dialogue: 0,0:11:01.28,0:11:03.45,Default,,0,0,0,,Өткізілген кадрлар туралы алаңдамаңыз
Dialogue: 0,0:11:03.53,0:11:05.24,Default,,0,0,0,,Сіз оны келесі жолы қайтара аласыз.
Dialogue: 0,0:11:05.45,0:11:08.29,Default,,0,0,0,,Не? Мен сәтсіздікке ұшыраған жоқпын ...
Dialogue: 0,0:11:08.37,0:11:09.62,Default,,0,0,0,,Барт
Dialogue: 0,0:11:10.16,0:11:12.96,Default,,0,0,0,,Сіздің жан-жақты шайқасыңыз осылай ма?
Dialogue: 0,0:11:13.46,0:11:14.92,Default,,0,0,0,,Not yet
Dialogue: 0,0:11:15.13,0:11:17.05,Default,,0,0,0,,Мен сізге бұдан да керемет нәрсе көрсетемін.
Dialogue: 0,0:11:17.46,0:11:19.09,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:11:22.72,0:11:23.89,Default,,0,0,0,,Бар-нии
Dialogue: 0,0:11:23.97,0:11:25.68,Default,,0,0,0,,Бұл негізгі. Бұл негізгі.
Dialogue: 0,0:11:25.76,0:11:26.56,Default,,0,0,0,,Кихон
Dialogue: 0,0:11:26.89,0:11:28.18,Default,,0,0,0,,Негізгі…
Dialogue: 0,0:11:28.97,0:11:30.43,Default,,0,0,0,,Тұрақты аяқ
Dialogue: 0,0:11:30.52,0:11:31.81,Default,,0,0,0,,Қолдарыңызды байлау
Dialogue: 0,0:11:31.89,0:11:34.11,Default,,0,0,0,,Іске қосу құралын ұстап тұрған қолды қозғалтпаңыз
Dialogue: 0,0:11:34.52,0:11:35.31,Default,,0,0,0,,Дегенмен, енді ғана не болды?
Dialogue: 0,0:11:35.94,0:11:36.98,Default,,0,0,0,,Ханым
Dialogue: 0,0:11:37.07,0:11:38.94,Default,,0,0,0,,Бар күшіңізбен атыңыз
Dialogue: 0,0:11:39.03,0:11:39.82,Default,,0,0,0,,Жиын
Dialogue: 0,0:11:40.03,0:11:43.45,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:43.53,0:11:45.83,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:48.66,0:11:50.66,Default,,0,0,0,,Жарайды, тамаша түсірілім.
Dialogue: 0,0:11:52.12,0:11:53.75,Default,,0,0,0,,Бұл жолы жұмыс істеді
Dialogue: 0,0:11:57.46,0:11:59.76,Default,,0,0,0,,Жүр! Бұл флеш түсірілім!
Dialogue: 0,0:12:05.01,0:12:07.14,Default,,0,0,0,,Экскалибурды итеру
Dialogue: 0,0:12:07.47,0:12:09.68,Default,,0,0,0,,Валькириді шашыратыңыз
Dialogue: 0,0:12:14.35,0:12:15.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:15.35,0:12:16.27,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:16.77,0:12:17.65,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:17.73,0:12:19.90,Default,,0,0,0,,Валькирия Кенет кеш болды.
Dialogue: 0,0:12:23.49,0:12:24.57,Default,,0,0,0,,Білемін, білемін!
Dialogue: 0,0:12:24.66,0:12:26.12,Default,,0,0,0,,және басқа да байланыс құралдарын—өшіріп, сол үстелге қойыңыз.
Dialogue: 0,0:12:26.20,0:12:27.32,Default,,0,0,0,,Валькирия
Dialogue: 0,0:12:29.45,0:12:31.12,Default,,0,0,0,,Түсіндім, Балто.
Dialogue: 0,0:12:31.20,0:12:33.37,Default,,0,0,0,,(Шухтаның дыбысы)
Dialogue: 0,0:12:33.46,0:12:34.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:36.04,0:12:36.96,Default,,0,0,0,,Қақпақ
Dialogue: 0,0:12:37.04,0:12:38.00,Default,,0,0,0,,Тікенектер
Dialogue: 0,0:12:43.26,0:12:44.93,Default,,0,0,0,,Аяқтау
Dialogue: 0,0:12:45.13,0:12:48.01,Default,,0,0,0,,Excalibur 1 ұпай 2-0
Dialogue: 0,0:12:49.64,0:12:53.35,Default,,0,0,0,,Валькиридің қимылдары қазір не болып жатыр?
Dialogue: 0,0:12:54.06,0:12:55.69,Default,,0,0,0,,Көліксіз қалай қайтамын? Құдай-ай!
Dialogue: 0,0:12:55.77,0:12:58.11,Default,,0,0,0,,Егер мен шыбықты дәл осылай ұрсам
Dialogue: 0,0:12:58.19,0:12:59.48,Default,,0,0,0,,Ол жарылды.
Dialogue: 0,0:12:59.61,0:13:00.98,Default,,0,0,0,,Уақыт келді. Уақыт келді.
Dialogue: 0,0:13:01.48,0:13:03.49,Default,,0,0,0,,Амансың ба? Балтық
Dialogue: 0,0:13:03.57,0:13:04.53,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:13:04.82,0:13:05.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:06.24,0:13:08.78,Default,,0,0,0,,Валькири әдеттегіден өзгеше.
Dialogue: 0,0:13:09.20,0:13:10.70,Default,,0,0,0,,бірдеңе жасауға тырысу
Dialogue: 0,0:13:11.16,0:13:14.29,Default,,0,0,0,,Бірақ мен мұны мүлдем түсінбеймін
Dialogue: 0,0:13:14.91,0:13:16.37,Default,,0,0,0,,Біз серіктес болсақ та...
Dialogue: 0,0:13:16.46,0:13:18.79,Default,,0,0,0,,Мықты бол Капу
Dialogue: 0,0:13:19.13,0:13:20.34,Default,,0,0,0,,Егер сіз білмесеңіз
Dialogue: 0,0:13:20.42,0:13:22.84,Default,,0,0,0,,Түсінгенше еңбектенетін Барт.
Dialogue: 0,0:13:22.92,0:13:24.72,Default,,0,0,0,,Ешқашан берілме
Dialogue: 0,0:13:25.88,0:13:27.18,Default,,0,0,0,,Инсуке
Dialogue: 0,0:13:28.47,0:13:30.01,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:13:30.55,0:13:31.60,Default,,0,0,0,,Көгілдір аспан арқылы билеп
Dialogue: 0,0:13:31.68,0:13:33.77,Default,,0,0,0,,Маған қуат берші
Dialogue: 0,0:13:34.98,0:13:36.39,Default,,0,0,0,,Сәттілік Балто
Dialogue: 0,0:13:37.77,0:13:38.73,Default,,0,0,0,,Жоспар
Dialogue: 0,0:13:39.06,0:13:41.44,Default,,0,0,0,,Ләззат алыңыз!
Dialogue: 0,0:13:41.65,0:13:44.28,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:45.07,0:13:48.03,Default,,0,0,0,,Мен қызып кеттім!
Dialogue: 0,0:13:52.99,0:13:54.83,Default,,0,0,0,,Тез түсіру
Dialogue: 0,0:13:57.50,0:13:58.54,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:13:58.75,0:14:00.88,Default,,0,0,0,,Бұл биіктікте қуат жеткіліксіз.
Dialogue: 0,0:14:01.17,0:14:03.59,Default,,0,0,0,,Бірақ Flash Shoot, Excalibur көмегімен
Dialogue: 0,0:14:03.67,0:14:05.71,Default,,0,0,0,,Артық өңдеуге дейін созбаңыз
Dialogue: 0,0:14:06.63,0:14:08.93,Default,,0,0,0,,Бал-нии ойланып отыр.
Dialogue: 0,0:14:09.01,0:14:11.22,Default,,0,0,0,,Ойлау қабілетім жетпесе де
Dialogue: 0,0:14:11.68,0:14:12.60,Default,,0,0,0,,Бұл жолы тағы да
Dialogue: 0,0:14:12.68,0:14:14.64,Default,,0,0,0,,Мен басымды күркеге қоямын.
Dialogue: 0,0:14:15.27,0:14:17.94,Default,,0,0,0,,Менің жеңіске жетуді қалаймын
Dialogue: 0,0:14:18.69,0:14:20.23,Default,,0,0,0,,Мидорикава үшін де
Dialogue: 0,0:14:21.40,0:14:22.69,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:14:23.61,0:14:24.40,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:14:28.49,0:14:30.32,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:14:30.87,0:14:33.66,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:33.74,0:14:36.16,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:37.71,0:14:38.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:38.71,0:14:41.17,Default,,0,0,0,,Мен оны әдеттегіден қабырғаға жақынырақ тастадым.
Dialogue: 0,0:14:42.29,0:14:44.25,Default,,0,0,0,,Жарайды, мен мұны мақсат ете аламын.
Dialogue: 0,0:14:44.67,0:14:47.51,Default,,0,0,0,,Excalibur алу үшін сол ұшты пайдаланыңыз...
Dialogue: 0,0:14:47.92,0:14:49.30,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:14:52.51,0:14:53.35,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:56.93,0:14:57.81,Default,,0,0,0,,баяу
Dialogue: 0,0:14:58.18,0:14:59.56,Default,,0,0,0,,Егер біз оны қазір ұстамасақ
Dialogue: 0,0:14:59.64,0:15:00.94,Default,,0,0,0,,Енді мүмкіндік жоқ
Dialogue: 0,0:15:02.98,0:15:04.11,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:15:08.82,0:15:09.95,Default,,0,0,0,,жеделдетілді
Dialogue: 0,0:15:10.15,0:15:11.99,Default,,0,0,0,,Шынайы флэш түсіру!
Dialogue: 0,0:15:12.07,0:15:14.74,Default,,0,0,0,,Әдеттегі шынайы флэш түсірілімнен әлдеқайда жақсы
Dialogue: 0,0:15:15.16,0:15:16.74,Default,,0,0,0,,Бұл әлі де солай ма?
Dialogue: 0,0:15:19.37,0:15:21.04,Default,,0,0,0,,(Шығанақтың ұшып бара жатқан дыбысы)
Dialogue: 0,0:15:21.37,0:15:22.21,Default,,0,0,0,,Әй!
Dialogue: 0,0:15:22.75,0:15:23.83,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:15:24.21,0:15:24.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:25.59,0:15:26.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:29.47,0:15:30.30,Default,,0,0,0,,Казама
Dialogue: 0,0:15:30.38,0:15:31.30,Default,,0,0,0,,О... Еркек!
Dialogue: 0,0:15:31.63,0:15:34.64,Default,,0,0,0,,Валькири 1 ұпай
Dialogue: 0,0:15:34.72,0:15:37.22,Default,,0,0,0,,2-1 тармақтар
Dialogue: 0,0:15:38.52,0:15:39.89,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:40.23,0:15:42.06,Default,,0,0,0,,Сен істедің, Балто.
Dialogue: 0,0:15:42.14,0:15:43.48,Default,,0,0,0,,Керемет
Dialogue: 0,0:15:43.56,0:15:45.06,Default,,0,0,0,,Жарайды, солай.
Dialogue: 0,0:15:45.56,0:15:48.36,Default,,0,0,0,,Сол Шақадан 1 ұпай алдым.
Dialogue: 0,0:15:48.44,0:15:50.07,Default,,0,0,0,,Әлгі жігіт...
Dialogue: 0,0:15:50.90,0:15:52.49,Default,,0,0,0,,Ток соққысы
Dialogue: 0,0:15:53.28,0:15:54.53,Default,,0,0,0,,Қызық!
Dialogue: 0,0:15:54.70,0:15:56.41,Default,,0,0,0,,Кеттік! Балтық
Dialogue: 0,0:15:56.49,0:15:58.16,Default,,0,0,0,,тағы 2 ұпай
Dialogue: 0,0:15:58.24,0:15:59.29,Default,,0,0,0,,Оу!
Dialogue: 0,0:15:59.41,0:16:00.75,Default,,0,0,0,,Шаканы көрдің бе?
Dialogue: 0,0:16:00.83,0:16:02.54,Default,,0,0,0,,Менің супер толық күш шайқасым
Dialogue: 0,0:16:04.96,0:16:05.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:05.96,0:16:06.84,Default,,0,0,0,,Шака?
Dialogue: 0,0:16:07.38,0:16:08.59,Default,,0,0,0,,Балто!
Dialogue: 0,0:16:11.47,0:16:14.64,Default,,0,0,0,,Ол қуат жағын пайдаланады ма?
Dialogue: 0,0:16:14.84,0:16:17.51,Default,,0,0,0,,Сәтсіздікке ұшырауыңыз мүмкін екенін білу
Dialogue: 0,0:16:18.01,0:16:20.72,Default,,0,0,0,,Шака тағы бір ұпай алса жеңеді.
Dialogue: 0,0:16:20.98,0:16:23.23,Default,,0,0,0,,Күш жағын қолдануға батылым жетпесе де.
Dialogue: 0,0:16:23.39,0:16:24.44,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:16:24.73,0:16:27.61,Default,,0,0,0,,Ол Шаканы байыппен қабылдады.
Dialogue: 0,0:16:28.94,0:16:30.61,Default,,0,0,0,,Күшті шайқас
Dialogue: 0,0:16:30.90,0:16:32.07,Default,,0,0,0,,Шығып бара жатырсың ба?
Dialogue: 0,0:16:32.15,0:16:34.11,Default,,0,0,0,,Шынайы флэш түсірілімге барайық!
Dialogue: 0,0:16:34.49,0:16:36.28,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:16:36.62,0:16:39.58,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:40.16,0:16:42.37,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:42.54,0:16:44.50,Default,,0,0,0,,Жарайды, бұл сынақ деп аталғанымен,
Dialogue: 0,0:16:45.42,0:16:46.25,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:16:49.25,0:16:51.09,Default,,0,0,0,,Жүр!
Dialogue: 0,0:16:51.71,0:16:54.93,Default,,0,0,0,,Нағыз жарқыл түсіру!
Dialogue: 0,0:16:57.30,0:16:58.14,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:58.55,0:17:00.39,Default,,0,0,0,,Ең баяу
Dialogue: 0,0:17:00.47,0:17:01.97,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:03.85,0:17:04.98,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:17:06.85,0:17:07.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:08.86,0:17:10.65,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:17:11.32,0:17:12.94,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:17:15.11,0:17:16.03,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:17.16,0:17:19.49,Default,,0,0,0,,Ха, күштірек бол, Балто.
Dialogue: 0,0:17:21.20,0:17:23.54,Default,,0,0,0,,Серпінді финиш 2 ұпай
Dialogue: 0,0:17:23.62,0:17:25.29,Default,,0,0,0,,4-1 тармақтар
Dialogue: 0,0:17:25.37,0:17:29.17,Default,,0,0,0,,Шака жеңсе, бұл шайқас Қылыш жалындарының жеңісі болады.
Dialogue: 0,0:17:29.67,0:17:30.75,Default,,0,0,0,,Еркек!
Dialogue: 0,0:17:30.84,0:17:32.30,Default,,0,0,0,,Еркек!
Dialogue: 0,0:17:36.18,0:17:39.85,Default,,0,0,0,,Мұндай нәрсе... бұрын соңды болмаған.
Dialogue: 0,0:17:42.10,0:17:45.39,Default,,0,0,0,,Валькири оянуға жақын болуы мүмкін.
Dialogue: 0,0:17:46.31,0:17:47.64,Default,,0,0,0,,Оян?
Dialogue: 0,0:17:52.11,0:17:55.03,Default,,0,0,0,,А, сіз мұны тағы да жасадыңыз!
Dialogue: 0,0:17:56.15,0:17:57.57,Default,,0,0,0,,Инускеден сұраңыз
Dialogue: 0,0:17:57.78,0:17:59.41,Default,,0,0,0,,Менімен тағы бір рет сөйлесіңізші.
Dialogue: 0,0:17:59.49,0:18:02.03,Default,,0,0,0,,Сіз Валькириді оятасыз, солай ма?
Dialogue: 0,0:18:02.12,0:18:03.49,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:18:04.12,0:18:06.00,Default,,0,0,0,,Бұл неше рет болды?
Dialogue: 0,0:18:06.08,0:18:07.66,Default,,0,0,0,,Енді есептемеңіз
Dialogue: 0,0:18:07.96,0:18:10.96,Default,,0,0,0,,Балто, Валькириді тез оят.
Dialogue: 0,0:18:11.04,0:18:14.05,Default,,0,0,0,,Инускемен де соғысайық!
Dialogue: 0,0:18:14.13,0:18:14.96,Default,,0,0,0,,О!
Dialogue: 0,0:18:15.26,0:18:17.42,Default,,0,0,0,,Бұл қазір ұйықтап жатқан болуы керек.
Dialogue: 0,0:18:17.63,0:18:19.72,Default,,0,0,0,,Мені ояту үшін шайқас керек.
Dialogue: 0,0:18:19.80,0:18:21.68,Default,,0,0,0,,Балтоға ұқсайды
Dialogue: 0,0:18:21.76,0:18:23.22,Default,,0,0,0,,Өйткені ол менің серіктесім
Dialogue: 0,0:18:23.76,0:18:24.47,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:18:24.64,0:18:26.23,Default,,0,0,0,,Валькирия
Dialogue: 0,0:18:27.94,0:18:30.48,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:30.90,0:18:32.56,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:35.07,0:18:36.94,Default,,0,0,0,,Оян!
Dialogue: 0,0:18:38.40,0:18:39.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:45.12,0:18:46.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:47.20,0:18:48.50,Default,,0,0,0,,Бұл...
Dialogue: 0,0:18:48.66,0:18:50.46,Default,,0,0,0,,Бұл Валькирияның оянуы ма?
Dialogue: 0,0:18:50.79,0:18:52.33,Default,,0,0,0,,Міне, мен күткен реакция.
Dialogue: 0,0:18:52.42,0:18:53.25,Default,,0,0,0,,О
Dialogue: 0,0:18:53.75,0:18:54.88,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:18:54.96,0:18:56.34,Default,,0,0,0,,Бұл керемет, Балто!
Dialogue: 0,0:18:56.59,0:18:57.42,Default,,0,0,0,,А... а...
Dialogue: 0,0:18:57.88,0:19:00.13,Default,,0,0,0,,Сіз әрі қарай жүре аласыз, Валькири.
Dialogue: 0,0:19:00.43,0:19:02.59,Default,,0,0,0,,Жарайды, сенімен тағы сөйлесейік...
Dialogue: 0,0:19:02.76,0:19:04.01,Default,,0,0,0,,Иә Иә
Dialogue: 0,0:19:04.10,0:19:05.43,Default,,0,0,0,,Енді бітті.
Dialogue: 0,0:19:05.89,0:19:07.64,Default,,0,0,0,,Жүр, күтуден шаршадым.
Dialogue: 0,0:19:07.85,0:19:10.06,Default,,0,0,0,,Инсуке, біз келесіміз.
Dialogue: 0,0:19:10.31,0:19:12.77,Default,,0,0,0,,Сәттілік Инсуке
Dialogue: 0,0:19:12.86,0:19:15.77,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:15.98,0:19:18.07,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:18.15,0:19:20.40,Default,,0,0,0,,Екеуіне де сәттілік!
Dialogue: 0,0:19:20.49,0:19:22.78,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:19:25.99,0:19:27.24,Default,,0,0,0,,Яан
Dialogue: 0,0:19:27.62,0:19:29.66,Default,,0,0,0,,Өйткені бұл Инсуке-кунның қоштасу кеші.
Dialogue: 0,0:19:29.75,0:19:31.33,Default,,0,0,0,,Cerbeus фестивалі!
Dialogue: 0,0:19:31.42,0:19:34.21,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:36.00,0:19:37.75,Default,,0,0,0,,Уме!
Dialogue: 0,0:19:39.55,0:19:40.72,Default,,0,0,0,,Шығанақтағы шайқас
Dialogue: 0,0:19:40.80,0:19:42.22,Default,,0,0,0,,Сол қылмыскер... қайтыс болды ма?
Dialogue: 0,0:19:42.63,0:19:45.68,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:46.14,0:19:47.43,Default,,0,0,0,,Эй
Dialogue: 0,0:19:47.76,0:19:49.77,Default,,0,0,0,,А, а
Dialogue: 0,0:19:50.31,0:19:51.19,Default,,0,0,0,,Иә
Dialogue: 0,0:19:53.15,0:19:55.69,Default,,0,0,0,,Жеңдеріңізді сүртпеңіз, орамал қолданыңыз!
Dialogue: 0,0:19:59.78,0:20:03.82,Default,,0,0,0,,Мен қосылсам да, жоғалдым.
Dialogue: 0,0:20:04.70,0:20:07.49,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:20:07.58,0:20:10.75,Default,,0,0,0,,Инсуке-кун басқа мектепке ауысса, ол жалғыз қалады.
Dialogue: 0,0:20:11.33,0:20:12.37,Default,,0,0,0,,Ах, рақмет.
Dialogue: 0,0:20:12.92,0:20:13.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:14.29,0:20:17.17,Default,,0,0,0,,Мен Балтомен және басқалармен әрқашан дос болдым.
Dialogue: 0,0:20:17.25,0:20:18.46,Default,,0,0,0,,Қай жерде болсаңыз да
Dialogue: 0,0:20:18.75,0:20:20.34,Default,,0,0,0,,Дұрыс, анашым.
Dialogue: 0,0:20:20.42,0:20:22.55,Default,,0,0,0,,Мен сені күнде мектепте көрмеймін.
Dialogue: 0,0:20:22.63,0:20:23.93,Default,,0,0,0,,Бұл маңызды емес.
Dialogue: 0,0:20:24.30,0:20:25.43,Default,,0,0,0,,Барт…
Dialogue: 0,0:20:26.35,0:20:29.56,Default,,0,0,0,,Жарайды, бәріміз шайқасайық.
Dialogue: 0,0:20:29.64,0:20:30.97,Default,,0,0,0,,Басқалардың араласуы немесе олардың арасындағы шектеулер соншалықты қарапайым емес.
Dialogue: 0,0:20:40.07,0:20:41.11,Default,,0,0,0,,Біз бірден жойылып кетер едік.
Dialogue: 0,0:20:41.57,0:20:42.32,Default,,0,0,0,,Дина да
Dialogue: 0,0:20:42.82,0:20:44.53,Default,,0,0,0,,Бізге кез келген уақытта келіңіз
Dialogue: 0,0:20:44.86,0:20:46.95,Default,,0,0,0,,Иә, рахмет, Кумичо.
Dialogue: 0,0:20:50.24,0:20:51.12,Default,,0,0,0,,Барт…
Dialogue: 0,0:20:51.45,0:20:53.04,Default,,0,0,0,,Өзіңді жалғыз сезінбе
Dialogue: 0,0:20:53.12,0:20:54.58,Default,,0,0,0,,Мен сені мектепте көре алмаймын.
Dialogue: 0,0:20:55.17,0:20:56.25,Default,,0,0,0,,Жарық жасыл, Ято-сан.
Dialogue: 0,0:20:58.38,0:20:59.50,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:21:00.30,0:21:01.38,Default,,0,0,0,,Хмм... уф
Dialogue: 0,0:21:02.67,0:21:04.72,Default,,0,0,0,,Не істеп жатырсың, батыр?
Dialogue: 0,0:21:04.80,0:21:06.34,Default,,0,0,0,,Мықты болыңыз
Dialogue: 0,0:21:06.43,0:21:07.47,Default,,0,0,0,,Сәнді дизайнерлік аяқ киім алу үшін жинап жүрген 20 000 йенім...
Dialogue: 0,0:21:08.39,0:21:09.55,Default,,0,0,0,,Инсуке
Dialogue: 0,0:21:12.10,0:21:14.23,Default,,0,0,0,,Инсуке тағы да шайқасқа шығатын сияқты
Dialogue: 0,0:21:14.31,0:21:15.52,Default,,0,0,0,,Мүлдем!
Dialogue: 0,0:21:15.98,0:21:17.60,Default,,0,0,0,,Иә, мүлде.
Dialogue: 0,0:21:17.69,0:21:19.36,Default,,0,0,0,,абсолютті абсолютті
Dialogue: 0,0:21:19.44,0:21:21.07,Default,,0,0,0,,Мүлдем, мүлде
Dialogue: 0,0:21:21.15,0:21:23.61,Default,,0,0,0,,Хехе... (Инсуке) Ахаха...
Dialogue: 0,0:21:23.86,0:21:25.57,Default,,0,0,0,,Әрине, біз де солаймыз.
Dialogue: 0,0:21:25.65,0:21:26.45,Default,,0,0,0,,Иә
Dialogue: 0,0:21:26.82,0:21:27.70,Default,,0,0,0,,Иә
Dialogue: 0,0:21:30.95,0:21:33.75,Default,,0,0,0,,(Көлік жүргізу дыбысы)
Dialogue: 0,0:21:35.83,0:21:38.17,Default,,0,0,0,,...! (Рантаро/Дина) Иә!
Dialogue: 0,0:21:41.38,0:21:42.63,Default,,0,0,0,,Рахмет
Dialogue: 0,0:21:42.71,0:21:44.42,Default,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,0:21:45.38,0:21:48.09,Default,,0,0,0,,(Дарионың жөтел ұстамасы)
Dialogue: 0,0:21:51.47,0:21:53.72,Default,,0,0,0,,Барт Жақында кездескенше
Dialogue: 0,0:22:09.11,0:22:15.20,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.41,0:22:21.54,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады
Dialogue: 0,0:22:22.00,0:22:27.55,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.01,0:22:31.34,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.51,0:22:36.43,Default,,0,0,0,,Сіз енді ешқашан жоғалмайсыз
Dialogue: 0,0:22:38.35,0:22:41.06,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.15,0:22:44.36,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.44,0:22:50.78,Default,,0,0,0,,Артынан қусаң да көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:51.03,0:22:56.58,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.75,0:23:03.34,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:03.92,0:23:09.34,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.51,0:23:12.68,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.18,0:23:17.14,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.02,0:23:28.28,Default,,0,0,0,,Жеңілу соңы емес еді
Dialogue: 0,0:23:28.40,0:23:30.28,Default,,0,0,0,,Қарсы кездесу болды.
Dialogue: 0,0:23:30.36,0:23:32.11,Default,,0,0,0,,Шақыру, келіңіз.
Dialogue: 0,0:23:32.32,0:23:34.91,Default,,0,0,0,,Облыстық турнирде финалға өттім.
Dialogue: 0,0:23:34.99,0:23:37.45,Default,,0,0,0,,Бірақ ол келмесе ше?
Dialogue: 0,0:23:37.62,0:23:39.45,Default,,0,0,0,,Осындай нәрселер туралы ойлануға уақытыңыз болса
Dialogue: 0,0:23:39.54,0:23:41.41,Default,,0,0,0,,Арнайы дайындық Арнайы дайындық Арнайы дайындық!
Dialogue: 0,0:23:41.50,0:23:43.00,Default,,0,0,0,,Ол міндетті түрде шығады~
Dialogue: 0,0:23:43.08,0:23:44.88,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:44.96,0:23:46.21,Default,,0,0,0,,Валькирия оянады!
Dialogue: 0,0:23:46.29,0:23:47.88,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.96,0:23:49.63,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.13,0:23:57.13,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory