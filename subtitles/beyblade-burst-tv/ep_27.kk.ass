Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.59,0:00:09.13,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.21,0:00:12.59,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.80,0:00:14.76,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:17.01,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.10,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.60,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.31,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.40,0:00:28.69,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:32.65,0:00:34.20,Default,,0,0,0,,Жүр!
Dialogue: 0,0:00:42.79,0:00:44.87,Default,,0,0,0,,Уау~
Dialogue: 0,0:00:44.96,0:00:46.88,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:48.29,0:00:49.38,Default,,0,0,0,,Жарық жасыл, Ято-сан.
Dialogue: 0,0:00:49.88,0:00:52.30,Default,,0,0,0,,Сіз республикалық байқауға қатыса аласыз!
Dialogue: 0,0:00:54.59,0:00:58.05,Default,,0,0,0,,Бей клубының мүшелері көбейіп, ресми түрде танылды.
Dialogue: 0,0:00:58.72,0:01:00.14,Default,,0,0,0,,Командалық жарыстар
Dialogue: 0,0:01:00.22,0:01:02.27,Default,,0,0,0,,Біз жеңеміз!
Dialogue: 0,0:01:10.77,0:01:13.15,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:13.49,0:01:18.66,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:29.96,0:01:33.34,Default,,0,0,0,,Әркімде бар екеніне сенімдімін.
Dialogue: 0,0:01:33.84,0:01:35.97,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:36.38,0:01:40.51,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:40.64,0:01:43.85,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:01:43.97,0:01:50.40,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:01:50.69,0:01:55.11,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:01:55.61,0:02:01.03,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:01.16,0:02:03.41,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:03.49,0:02:08.21,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:08.37,0:02:13.46,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:13.75,0:02:16.01,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:16.21,0:02:18.55,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:18.84,0:02:22.76,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:22.93,0:02:27.93,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:28.14,0:02:30.31,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:34.15,0:02:37.36,Default,,0,0,0,,Оқу-жаттығу лагері! Викинг стадионы!
Dialogue: 0,0:02:38.32,0:02:40.99,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:02:41.07,0:02:42.82,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:02:42.91,0:02:45.87,Default,,0,0,0,,Бар, Валькири! Тез ату!
Dialogue: 0,0:02:45.95,0:02:49.46,Default,,0,0,0,,Мен сені Рагнарук аймағында жарып жіберемін!
Dialogue: 0,0:02:50.08,0:02:52.21,Default,,0,0,0,,Командалық жарысқа қатысу туралы шешім қабылданды.
Dialogue: 0,0:02:52.29,0:02:54.25,Default,,0,0,0,,Бар-ниилер қатты толқыды.
Dialogue: 0,0:02:54.34,0:02:59.26,Default,,0,0,0,,Бірақ...мүшелердің саны көбейсе де, бұрынғыдай сезіледі!
Dialogue: 0,0:03:00.26,0:03:01.59,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:01.68,0:03:03.18,Default,,0,0,0,,Жауап беріңіз!
Dialogue: 0,0:03:06.18,0:03:07.18,Default,,0,0,0,,Эй!
Dialogue: 0,0:03:07.27,0:03:09.48,Default,,0,0,0,,Бұл Рагнаруктың күші!
Dialogue: 0,0:03:09.68,0:03:11.73,Default,,0,0,0,,Көңіл-күйің жақсы, Кумичо.
Dialogue: 0,0:03:11.81,0:03:14.06,Default,,0,0,0,,Мен командалық жарысты асыға күтемін!
Dialogue: 0,0:03:14.15,0:03:16.02,Default,,0,0,0,,Жеңіске жетейік!
Dialogue: 0,0:03:16.23,0:03:19.28,Default,,0,0,0,,Сіз осылай жеңе аламын деп ойлайсыз ба?
Dialogue: 0,0:03:19.49,0:03:20.99,Default,,0,0,0,,Вакия!
Dialogue: 0,0:03:21.20,0:03:22.45,Default,,0,0,0,,Сіз кешіктіңіз!
Dialogue: 0,0:03:22.53,0:03:24.41,Default,,0,0,0,,Тез жаттығып алайық!
Dialogue: 0,0:03:24.49,0:03:26.74,Default,,0,0,0,,Неліктен мен Bay Club-қа қосылдым?
Dialogue: 0,0:03:26.83,0:03:29.41,Default,,0,0,0,,Өткен күнгі тағы бір қызық шайқас, ол үшін емес.
Dialogue: 0,0:03:29.50,0:03:31.41,Default,,0,0,0,,Бұл қызық шайқас па?
Dialogue: 0,0:03:31.50,0:03:33.50,Default,,0,0,0,,Бүгіннен бастап Bay Club...
Dialogue: 0,0:03:33.58,0:03:35.71,Default,,0,0,0,,Мен жасағандай жаттықтыру.
Dialogue: 0,0:03:36.04,0:03:39.17,Default,,0,0,0,,Мен осы команданың капитаны болдым.
Dialogue: 0,0:03:39.76,0:03:40.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:41.05,0:03:43.05,Default,,0,0,0,,Сіз капитансыз ба?
Dialogue: 0,0:03:43.13,0:03:46.30,Default,,0,0,0,,Y қосылуының арқасында мен командалық шайқасқа қатыса аламын.
Dialogue: 0,0:03:46.39,0:03:47.64,Default,,0,0,0,,Әрине.
Dialogue: 0,0:03:48.06,0:03:49.89,Default,,0,0,0,,Шу – капитан.
Dialogue: 0,0:03:49.97,0:03:51.94,Default,,0,0,0,,Ең күштісі
Dialogue: 0,0:03:52.23,0:03:55.44,Default,,0,0,0,,Күш - капитан болу үшін жалғыз талап емес.
Dialogue: 0,0:03:55.65,0:03:57.44,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:03:57.82,0:04:01.99,Default,,0,0,0,,Тыңдаңдар, команданы біріктіретін капитан.
Dialogue: 0,0:04:02.07,0:04:05.82,Default,,0,0,0,,Бірде қатал, бірде мейірімді, бәрін ойлайтын
Dialogue: 0,0:04:05.91,0:04:09.16,Default,,0,0,0,,Командадағылардың барлығы Блейдердің капитан екендігімен келіседі.
Dialogue: 0,0:04:09.24,0:04:10.91,Default,,0,0,0,,Бұл Y туралы ма?
Dialogue: 0,0:04:11.00,0:04:12.41,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:12.50,0:04:14.04,Default,,0,0,0,,Мен шешіп қойдым
Dialogue: 0,0:04:14.12,0:04:16.04,Default,,0,0,0,,Өз бетіңізше шешім қабылдамаңыз!
Dialogue: 0,0:04:16.13,0:04:17.92,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:04:18.00,0:04:19.96,Default,,0,0,0,,Иә, оқу-жаттығу жиынына барайық!
Dialogue: 0,0:04:20.21,0:04:21.80,Default,,0,0,0,,Оқу-жаттығу лагері~?
Dialogue: 0,0:04:22.22,0:04:23.97,Default,,0,0,0,,Енді бұл Уи капитан
Dialogue: 0,0:04:24.05,0:04:27.05,Default,,0,0,0,,Мен Бэй Клубтың командалық матчта жеңілгенін кешіре алмаймын!
Dialogue: 0,0:04:27.14,0:04:29.22,Default,,0,0,0,,Капитан емес!
Dialogue: 0,0:04:30.14,0:04:31.22,Default,,0,0,0,,ертеңнен бастап-
Dialogue: 0,0:04:31.31,0:04:33.39,Default,,0,0,0,,Beyblade оқу-жаттығу лагерінде арнайы дайындық!
Dialogue: 0,0:04:33.85,0:04:35.48,Default,,0,0,0,,Мен бұған ешқашан жол бермеймін, иә?
Dialogue: 0,0:04:36.98,0:04:38.77,Default,,0,0,0,,Бейблейд жаттығу лагері?!
Dialogue: 0,0:04:38.86,0:04:40.36,Default,,0,0,0,,Өте қызықты!
Dialogue: 0,0:04:40.65,0:04:42.69,Default,,0,0,0,,Сіз күні бойы жолға шыға алмайсыз, солай ма?
Dialogue: 0,0:04:42.78,0:04:44.07,Default,,0,0,0,,Бұл керемет.
Dialogue: 0,0:04:44.15,0:04:45.61,Default,,0,0,0,,Арнайы дайындық Арнайы дайындық ~
Dialogue: 0,0:04:46.03,0:04:48.78,Default,,0,0,0,,Вакиянчи вилласы қандай орын?
Dialogue: 0,0:04:48.87,0:04:50.03,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:04:50.37,0:04:51.29,Default,,0,0,0,,Жыл бойы шорт киетін ұрғашы горилла ма!?
Dialogue: 0,0:04:51.37,0:04:54.00,Default,,0,0,0,,Бұл орындықта ақау бар ма...
Dialogue: 0,0:04:54.08,0:04:56.08,Default,,0,0,0,,Менің бөксем ауыра бастады.
Dialogue: 0,0:04:56.33,0:04:59.13,Default,,0,0,0,,Мен сенімді болмасам да, пойызға отырайық дедім.
Dialogue: 0,0:04:59.21,0:05:01.55,Default,,0,0,0,,(Ұялы телефон жұмысының дыбысы)
Dialogue: 0,0:05:01.63,0:05:03.59,Default,,0,0,0,,Пойыздар осындай!
Dialogue: 0,0:05:03.97,0:05:05.17,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:05:05.26,0:05:07.30,Default,,0,0,0,,Бұл пойыз!
Dialogue: 0,0:05:08.59,0:05:10.64,Default,,0,0,0,,Бұл пойыз ба?
Dialogue: 0,0:05:10.97,0:05:13.43,Default,,0,0,0,,Егер мен көлік сатып алатын болсам, оны қазірге дейін жасаған болар едім...
Dialogue: 0,0:05:13.52,0:05:15.23,Default,,0,0,0,,(тырс еткен дыбыс)
Dialogue: 0,0:05:15.39,0:05:17.27,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:05:17.60,0:05:20.27,Default,,0,0,0,,Не... Күлме!
Dialogue: 0,0:05:26.86,0:05:28.82,Default,,0,0,0,,Оххх
Dialogue: 0,0:05:29.03,0:05:30.33,Default,,0,0,0,,А...
Dialogue: 0,0:05:31.41,0:05:32.87,Default,,0,0,0,,Бұл іс жарыққа шыққанына төрт айдан асты.
Dialogue: 0,0:05:33.20,0:05:34.79,Default,,0,0,0,,Үлкен...
Dialogue: 0,0:05:35.33,0:05:37.83,Default,,0,0,0,,Бұл... вилла...
Dialogue: 0,0:05:40.54,0:05:42.21,Default,,0,0,0,,Біз сізді күттік.
Dialogue: 0,0:05:42.30,0:05:43.80,Default,,0,0,0,,Вакия Бочама
Dialogue: 0,0:05:44.55,0:05:47.93,Default,,0,0,0,,Барлығы сіз сұрағандай реттелген.
Dialogue: 0,0:05:48.26,0:05:50.22,Default,,0,0,0,,Қалғандары кетіп қалды...
Dialogue: 0,0:05:50.30,0:05:52.35,Default,,0,0,0,,Мен жалғызбын.
Dialogue: 0,0:05:52.72,0:05:54.06,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:54.18,0:05:56.06,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:05:56.52,0:05:58.14,Default,,0,0,0,,Ол сізге жетеді ме?
Dialogue: 0,0:05:58.23,0:05:59.10,Default,,0,0,0,,Иә
Dialogue: 0,0:05:59.19,0:06:01.27,Default,,0,0,0,,Ақыры кеше келді.
Dialogue: 0,0:06:01.36,0:06:03.90,Default,,0,0,0,,Енді сіз оны дұрыс пайдалана аласыз.
Dialogue: 0,0:06:03.98,0:06:07.28,Default,,0,0,0,,Шикаши керемет~
Dialogue: 0,0:06:07.36,0:06:09.49,Default,,0,0,0,,Қамалдың ішіне қараңыз
Dialogue: 0,0:06:09.57,0:06:11.91,Default,,0,0,0,,Бұл үлкен жылтыр не?
Dialogue: 0,0:06:11.99,0:06:13.53,Default,,0,0,0,,Бұл люстра.
Dialogue: 0,0:06:13.62,0:06:16.04,Default,,0,0,0,,Мына жігіт жылтыр екен.
Dialogue: 0,0:06:16.12,0:06:17.50,Default,,0,0,0,,Иә, келіңіз.
Dialogue: 0,0:06:18.37,0:06:19.87,Default,,0,0,0,,Оны шешкенде мені ойлағаныңды қалаймын.
Dialogue: 0,0:06:19.96,0:06:21.67,Default,,0,0,0,,Бөлмелер өте көп!
Dialogue: 0,0:06:21.96,0:06:23.88,Default,,0,0,0,,Өзіңізге ұнайтын жерді таңдаңыз
Dialogue: 0,0:06:23.96,0:06:26.51,Default,,0,0,0,,Мен қайда баруым керек?
Dialogue: 0,0:06:27.30,0:06:29.38,Default,,0,0,0,,Мына жақта, былай!
Dialogue: 0,0:06:29.47,0:06:31.64,Default,,0,0,0,,Бұл A Бірақ бұл да...
Dialogue: 0,0:06:31.80,0:06:34.89,Default,,0,0,0,,Мен осында қаламын. Мен мындамын.
Dialogue: 0,0:06:35.35,0:06:37.06,Default,,0,0,0,,Мен абдырап қалдым.
Dialogue: 0,0:06:37.14,0:06:38.48,Default,,0,0,0,,Барлығы қайда...
Dialogue: 0,0:06:38.60,0:06:39.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:39.56,0:06:41.15,Default,,0,0,0,,Иә? а...?
Dialogue: 0,0:06:41.23,0:06:42.98,Default,,0,0,0,,Бал-нии осылай
Dialogue: 0,0:06:43.23,0:06:44.40,Default,,0,0,0,,Ико Ико
Dialogue: 0,0:06:45.69,0:06:47.28,Default,,0,0,0,,Не...
Dialogue: 0,0:06:47.69,0:06:50.57,Default,,0,0,0,,Эй, эй!
Dialogue: 0,0:06:50.66,0:06:51.91,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:06:51.99,0:06:53.32,Default,,0,0,0,,Өте кең!
Dialogue: 0,0:06:54.37,0:06:55.87,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:56.29,0:06:57.54,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:06:59.12,0:07:00.96,Default,,0,0,0,,Бар-нии, бұл қағаз...
Dialogue: 0,0:07:01.46,0:07:02.96,Default,,0,0,0,,Қағаз... Уау!
Dialogue: 0,0:07:03.25,0:07:04.67,Default,,0,0,0,,(Еденге құлаған дыбыс)
Dialogue: 0,0:07:04.75,0:07:06.92,Default,,0,0,0,,Келіңіздер...
Dialogue: 0,0:07:07.00,0:07:08.21,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:07:08.88,0:07:11.18,Default,,0,0,0,,Не істеп жатырсың, Балто?
Dialogue: 0,0:07:11.55,0:07:13.59,Default,,0,0,0,,Қазір жаттығуды бастайық
Dialogue: 0,0:07:13.93,0:07:15.76,Default,,0,0,0,,Арнайы дайындық? Жақсы!
Dialogue: 0,0:07:18.02,0:07:21.19,Default,,0,0,0,,Бұл зәулім сарай сияқты ең заманауи жаттығу орны.
Dialogue: 0,0:07:21.44,0:07:22.90,Default,,0,0,0,,Дәл солай болса, неге әуре?
Dialogue: 0,0:07:22.98,0:07:25.40,Default,,0,0,0,,Менің ойымша, мен осы уақытқа дейін келмеуім керек еді.
Dialogue: 0,0:07:25.73,0:07:28.07,Default,,0,0,0,,Мен ерекше құбыжық дайындадым.
Dialogue: 0,0:07:29.40,0:07:31.99,Default,,0,0,0,,Бұл! Қызық естіледі, солай ма?
Dialogue: 0,0:07:32.74,0:07:35.53,Default,,0,0,0,,Мен оны осы оқу-жаттығу жиынына шетелден тапсырыс бердім.
Dialogue: 0,0:07:35.62,0:07:37.41,Default,,0,0,0,,Викинг стадионы!
Dialogue: 0,0:07:37.54,0:07:39.62,Default,,0,0,0,,Оның азу тісіндей бірдеңе бар.
Dialogue: 0,0:07:39.70,0:07:41.00,Default,,0,0,0,,Бұл ауыр көрінеді...
Dialogue: 0,0:07:41.08,0:07:42.92,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:43.00,0:07:46.04,Default,,0,0,0,,Викинг азу деп аталатын арнайы құрылғы сияқты.
Dialogue: 0,0:07:46.13,0:07:47.09,Default,,0,0,0,,Шамасы?
Dialogue: 0,0:07:47.17,0:07:48.38,Default,,0,0,0,,Мен және бала да...
Dialogue: 0,0:07:48.46,0:07:51.17,Default,,0,0,0,,Біз бұл стадионда әлі ойнаған жоқпыз.
Dialogue: 0,0:07:51.26,0:07:53.55,Default,,0,0,0,,Хоудзи Бір рет көріңіз
Dialogue: 0,0:07:53.63,0:07:54.39,Default,,0,0,0,,Иә
Dialogue: 0,0:07:54.59,0:07:56.72,Default,,0,0,0,,Сонда мен басқа тарап боламын.
Dialogue: 0,0:07:57.14,0:07:58.64,Default,,0,0,0,,Хорсудпен не істеу керек...
Dialogue: 0,0:07:58.72,0:08:00.10,Default,,0,0,0,,Біраз уақыт өтті
Dialogue: 0,0:08:00.98,0:08:04.15,Default,,0,0,0,,Қараңғы Даситер Қасиетті Хорсудоға қарсы!
Dialogue: 0,0:08:04.52,0:08:06.44,Default,,0,0,0,,Сәттілік Дина!
Dialogue: 0,0:08:06.52,0:08:07.73,Default,,0,0,0,,Хоудзи де~
Dialogue: 0,0:08:08.02,0:08:09.69,Default,,0,0,0,,Бұл Викинг азу...
Dialogue: 0,0:08:09.78,0:08:12.11,Default,,0,0,0,,Бір айла бар ма екен деп асыға күтемін.
Dialogue: 0,0:08:12.20,0:08:15.07,Default,,0,0,0,,Түсіндім, мен Өлімнің азуын сол азу тіске итеріп жіберемін.
Dialogue: 0,0:08:15.16,0:08:16.16,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:16.24,0:08:17.16,Default,,0,0,0,,Иә
Dialogue: 0,0:08:17.24,0:08:19.54,Default,,0,0,0,,О, бірінші шайқас~!
Dialogue: 0,0:08:19.83,0:08:22.87,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:08:23.12,0:08:24.92,Default,,0,0,0,,Дайын жиынтық!
Dialogue: 0,0:08:25.25,0:08:27.96,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:28.04,0:08:30.38,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:34.67,0:08:36.47,Default,,0,0,0,,Жүр, өлімші!
Dialogue: 0,0:08:38.26,0:08:39.14,Default,,0,0,0,,Не?!
Dialogue: 0,0:08:39.43,0:08:40.14,Default,,0,0,0,,Әй
Dialogue: 0,0:08:42.10,0:08:43.10,Default,,0,0,0,,Не!
Dialogue: 0,0:08:43.52,0:08:45.48,Default,,0,0,0,,Орталықты алмаңыз!
Dialogue: 0,0:08:47.36,0:08:49.11,Default,,0,0,0,,Шабуыл, Хорсуд!
Dialogue: 0,0:08:52.15,0:08:54.11,Default,,0,0,0,,Хорсуд шабуылға шығады!
Dialogue: 0,0:08:54.32,0:08:56.57,Default,,0,0,0,,Шабуылдарға келетін болсақ, Deathsizer - ең жақсы!
Dialogue: 0,0:09:00.58,0:09:01.58,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,0:09:01.66,0:09:03.87,Default,,0,0,0,,Екеуі де қабырғаға соғылады.
Dialogue: 0,0:09:06.50,0:09:07.67,Default,,0,0,0,,Мочи жауап берді!
Dialogue: 0,0:09:09.96,0:09:11.13,Default,,0,0,0,,Азу тістерді соғыңыз!
Dialogue: 0,0:09:11.46,0:09:12.46,Default,,0,0,0,,Өлім өлшемі!
Dialogue: 0,0:09:14.09,0:09:15.63,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:09:15.72,0:09:16.80,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:17.13,0:09:18.22,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:24.60,0:09:26.27,Default,,0,0,0,,Уа... хо...
Dialogue: 0,0:09:26.35,0:09:28.98,Default,,0,0,0,,Қасиетті Хорсудо жарылуы аяқталды!
Dialogue: 0,0:09:29.23,0:09:30.65,Default,,0,0,0,,Қазір бұл не?
Dialogue: 0,0:09:30.73,0:09:32.90,Default,,0,0,0,,Өлім Сізерді жеп қойды...
Dialogue: 0,0:09:33.94,0:09:36.65,Default,,0,0,0,,Бұл Викинг Азу...
Dialogue: 0,0:09:37.57,0:09:39.95,Default,,0,0,0,,Бей азуға ұсталғанда...
Dialogue: 0,0:09:40.07,0:09:41.99,Default,,0,0,0,,Ішінен жарылу механизмі ме...
Dialogue: 0,0:09:42.74,0:09:45.00,Default,,0,0,0,,Жоқ, бұл жай ғана қулық...
Dialogue: 0,0:09:46.37,0:09:48.96,Default,,0,0,0,,Арнайы жаттығуларға жарамды стадион.
Dialogue: 0,0:09:49.29,0:09:52.80,Default,,0,0,0,,Уау! Бұл стадион өте отты!
Dialogue: 0,0:09:52.88,0:09:54.84,Default,,0,0,0,,Келесі мен, мен! Мен!
Dialogue: 0,0:09:54.92,0:09:58.01,Default,,0,0,0,,Шу! Кумичо! Дина!
Dialogue: 0,0:09:58.22,0:09:59.80,Default,,0,0,0,,Хоудзи немесе вакия жақсы.
Dialogue: 0,0:09:59.89,0:10:02.22,Default,,0,0,0,,Тезірек, шайқасайық!
Dialogue: 0,0:10:02.56,0:10:04.47,Default,,0,0,0,,Жарайды, мен сенің қарсыласыңмын!
Dialogue: 0,0:10:04.56,0:10:07.73,Default,,0,0,0,,Сіздің жаттығуыңыз жай ғана ойын.
Dialogue: 0,0:10:07.81,0:10:10.10,Default,,0,0,0,,Сіздікі басқаша ма?
Dialogue: 0,0:10:10.19,0:10:11.77,Default,,0,0,0,,Бұл анық.
Dialogue: 0,0:10:12.06,0:10:14.53,Default,,0,0,0,,Алтауымыз неге жиналдық?
Dialogue: 0,0:10:14.61,0:10:15.82,Default,,0,0,0,,Не үшін...
Dialogue: 0,0:10:16.49,0:10:18.15,Default,,0,0,0,,Сонда бұл не үшін?
Dialogue: 0,0:10:18.49,0:10:21.24,Default,,0,0,0,,6 адам болса, жалған команда матчын өткізуге болады.
Dialogue: 0,0:10:21.74,0:10:23.70,Default,,0,0,0,,А... иә?
Dialogue: 0,0:10:23.78,0:10:25.41,Default,,0,0,0,,Куришудан күткендей
Dialogue: 0,0:10:25.75,0:10:27.29,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:10:27.50,0:10:29.67,Default,,0,0,0,,Моги... Командалық шайқас?
Dialogue: 0,0:10:29.75,0:10:31.71,Default,,0,0,0,,Нағыз командалық матч сияқты--
Dialogue: 0,0:10:31.79,0:10:33.29,Default,,0,0,0,,Бұл матч ойнауды білдіреді.
Dialogue: 0,0:10:33.50,0:10:34.63,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:10:34.71,0:10:37.30,Default,,0,0,0,,Сіз топтық ойындарды қалай ойнауды білесіз, солай ма?
Dialogue: 0,0:10:37.59,0:10:39.13,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:10:39.22,0:10:41.72,Default,,0,0,0,,Біз қазірдің өзінде Sword Flames-пен күресіп жатырмыз!
Dialogue: 0,0:10:41.80,0:10:44.14,Default,,0,0,0,,Шаканың дойдосында істегенімнен басқаша.
Dialogue: 0,0:10:44.51,0:10:46.02,Default,,0,0,0,,Бұл нокаут емес.
Dialogue: 0,0:10:46.10,0:10:47.60,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:10:48.02,0:10:50.06,Default,,0,0,0,,Хоудзи түсіндіріңіз немесе
Dialogue: 0,0:10:50.65,0:10:52.69,Default,,0,0,0,,Ұлттық турнирдің командалық жарысы -
Dialogue: 0,0:10:52.77,0:10:55.82,Default,,0,0,0,,Бұл жеке матчтың алдында өтетін турнирлік матч.
Dialogue: 0,0:10:55.98,0:10:57.44,Default,,0,0,0,,1 командада 5 адам бар
Dialogue: 0,0:10:57.65,0:10:59.61,Default,,0,0,0,,Олардың үшеуі матчқа қатысады.
Dialogue: 0,0:11:00.45,0:11:03.03,Default,,0,0,0,,Қандай пышақтармен күресетініңізді алдын ала шешіңіз.
Dialogue: 0,0:11:03.28,0:11:05.28,Default,,0,0,0,,Матчқа дейін тіркелу
Dialogue: 0,0:11:05.95,0:11:08.04,Default,,0,0,0,,Мүшелерді ауыстыруға рұқсат етілмейді
Dialogue: 0,0:11:08.70,0:11:10.50,Default,,0,0,0,,Соғыс тәртібі тегін
Dialogue: 0,0:11:11.50,0:11:13.67,Default,,0,0,0,,Кім қандай ретпен шайқасады?
Dialogue: 0,0:11:13.75,0:11:15.46,Default,,0,0,0,,Бұл командалық шайқастардағы маңызды сәт.
Dialogue: 0,0:11:15.54,0:11:16.30,Default,,0,0,0,,Иә...
Dialogue: 0,0:11:16.59,0:11:19.22,Default,,0,0,0,,Бір шайқаста үш адам жарысады.
Dialogue: 0,0:11:19.67,0:11:23.09,Default,,0,0,0,,Сіз жинаған ұпайлар топтың ұпайына айналады.
Dialogue: 0,0:11:26.18,0:11:28.97,Default,,0,0,0,,Бірінші 3 ұпай алған команда жеңеді.
Dialogue: 0,0:11:29.60,0:11:31.69,Default,,0,0,0,,Жақсы! Ережелер тамаша!
Dialogue: 0,0:11:31.77,0:11:33.10,Default,,0,0,0,,Командалық матчта орындайық!
Dialogue: 0,0:11:33.19,0:11:35.40,Default,,0,0,0,,Ал, топтастырудан бастайық.
Dialogue: 0,0:11:35.48,0:11:37.94,Default,,0,0,0,,Сіз қалай шешесіз? Бұл тас, қағаз, қайшы ма?
Dialogue: 0,0:11:38.03,0:11:40.03,Default,,0,0,0,,Классификация жасалды.
Dialogue: 0,0:11:40.15,0:11:41.03,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,0:11:41.40,0:11:43.20,Default,,0,0,0,,Бөлмеде карта болды, солай ма?
Dialogue: 0,0:11:43.91,0:11:46.45,Default,,0,0,0,,Сол қағаздың түсі менің командам.
Dialogue: 0,0:11:50.33,0:11:52.46,Default,,0,0,0,,Біз қызыл командамыз!
Dialogue: 0,0:11:53.67,0:11:55.54,Default,,0,0,0,,Wai және т.б. Көк команда
Dialogue: 0,0:11:56.50,0:11:59.51,Default,,0,0,0,,Цуджихара төреші болсын. Иә.
Dialogue: 0,0:11:59.80,0:12:00.59,Default,,0,0,0,,Иә
Dialogue: 0,0:12:00.67,0:12:02.47,Default,,0,0,0,,Мен қызмет етемін
Dialogue: 0,0:12:03.22,0:12:05.51,Default,,0,0,0,,Командалық шайқасты бастаңыз!
Dialogue: 0,0:12:05.59,0:12:06.76,Default,,0,0,0,,Оу!
Dialogue: 0,0:12:07.76,0:12:09.31,Default,,0,0,0,,Мен бірінші барамын!
Dialogue: 0,0:12:09.39,0:12:11.89,Default,,0,0,0,,Тездетіп, сол стадионда шайқас бол!
Dialogue: 0,0:12:11.98,0:12:13.31,Default,,0,0,0,,Жоқ, мен барамын.
Dialogue: 0,0:12:13.39,0:12:14.69,Default,,0,0,0,,Сіз бұл жерде әлі жоқсыз.
Dialogue: 0,0:12:14.81,0:12:15.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:15.98,0:12:18.27,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:12:18.73,0:12:20.48,Default,,0,0,0,,Бірінші шайқастан бас тарту -
Dialogue: 0,0:12:20.57,0:12:23.40,Default,,0,0,0,,Екінші немесе үшінші болып шыққан болуы керек.
Dialogue: 0,0:12:23.61,0:12:26.16,Default,,0,0,0,,Міне, мен кіремін! осындай нәрсені айт
Dialogue: 0,0:12:26.24,0:12:28.24,Default,,0,0,0,,Ахахха, олар бір-біріне ұқсамайды!
Dialogue: 0,0:12:28.33,0:12:30.91,Default,,0,0,0,,Ой! Қалай болғанда да, команда жеңіске жету үшін...
Dialogue: 0,0:12:31.00,0:12:33.16,Default,,0,0,0,,Жігіттер сендерді жалғыз қалдырған дұрыс!
Dialogue: 0,0:12:33.37,0:12:35.37,Default,,0,0,0,,Түсіндім! Олай болса, солай істейік!
Dialogue: 0,0:12:35.75,0:12:37.13,Default,,0,0,0,,Олай болса, бәріңе.
Dialogue: 0,0:12:37.54,0:12:40.42,Default,,0,0,0,,Сіз бірінші шайқас үшін пышақ туралы шешім қабылдадыңыз ба?
Dialogue: 0,0:12:40.84,0:12:41.80,Default,,0,0,0,,О!
Dialogue: 0,0:12:43.26,0:12:44.09,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:12:44.18,0:12:45.89,Default,,0,0,0,,Бұл Уакия!
Dialogue: 0,0:12:46.22,0:12:47.97,Default,,0,0,0,,Бұл не, Хуаншань?
Dialogue: 0,0:12:48.35,0:12:49.68,Default,,0,0,0,,Қызықты
Dialogue: 0,0:12:49.76,0:12:51.31,Default,,0,0,0,,Менің оқуым қате болды, бірақ...
Dialogue: 0,0:12:51.64,0:12:54.48,Default,,0,0,0,,Мен сенімен бірінші рет кездесіп тұрмын, Вакия.
Dialogue: 0,0:12:54.56,0:12:57.31,Default,,0,0,0,,Мен тек мықты жігіттермен айналысамын.
Dialogue: 0,0:12:57.40,0:12:58.52,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:58.61,0:13:00.57,Default,,0,0,0,,Ол бұрынғыдай әлі де тітіркендіргіш.
Dialogue: 0,0:13:00.65,0:13:03.57,Default,,0,0,0,,Мен анау мұрынның көпірін бұзамын!
Dialogue: 0,0:13:03.82,0:13:05.20,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:13:05.28,0:13:07.32,Default,,0,0,0,,Уакиядан құтылайық!
Dialogue: 0,0:13:07.57,0:13:09.74,Default,,0,0,0,,Төзімділік пен қорғаныс...
Dialogue: 0,0:13:09.83,0:13:12.58,Default,,0,0,0,,Түрлер туралы айтатын болсақ, Рагнаруктың артықшылығы бар...
Dialogue: 0,0:13:12.66,0:13:14.29,Default,,0,0,0,,Қарсылас Комурасаки.
Dialogue: 0,0:13:14.37,0:13:16.21,Default,,0,0,0,,Бұл оңай болмайды.
Dialogue: 0,0:13:16.62,0:13:20.46,Default,,0,0,0,,Рагнарук та, Уиверн де орталықты алу қиын бектер...
Dialogue: 0,0:13:20.54,0:13:23.30,Default,,0,0,0,,Бірінші шайқас орталық үшін тартыс болады.
Dialogue: 0,0:13:23.55,0:13:25.09,Default,,0,0,0,,Уайверна сияқты-
Dialogue: 0,0:13:25.17,0:13:27.38,Default,,0,0,0,,Абыржыған Рагнарук емес!
Dialogue: 0,0:13:27.76,0:13:30.55,Default,,0,0,0,,Бұл бей уивернге сәйкес келмейді.
Dialogue: 0,0:13:30.93,0:13:31.97,Default,,0,0,0,,Кумичо!
Dialogue: 0,0:13:32.06,0:13:34.02,Default,,0,0,0,,Тым жақындасаң күйіп кетесің!
Dialogue: 0,0:13:34.10,0:13:37.10,Default,,0,0,0,,Мен қазір жанып жатырмын!
Dialogue: 0,0:13:37.19,0:13:39.61,Default,,0,0,0,,О, тамаша, Кумичо!
Dialogue: 0,0:13:40.19,0:13:41.94,Default,,0,0,0,,Мен саған Вакияны көрсетемін!
Dialogue: 0,0:13:42.02,0:13:45.19,Default,,0,0,0,,Рагнарук - ортада жеңген адам!
Dialogue: 0,0:13:46.07,0:13:48.45,Default,,0,0,0,,Бұрынғы ұрыс-керіспен айналыспа.
Dialogue: 0,0:13:48.53,0:13:49.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:49.62,0:13:52.54,Default,,0,0,0,,Командалық шайқастарда әр адам бір ғана шайқаса алады.
Dialogue: 0,0:13:52.79,0:13:53.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:54.45,0:13:55.91,Default,,0,0,0,,(Кения) Бірақ білесің бе, біз оны Саторудың аурухана шығындарын жабуға көмектеседі деп ойладық➡
Dialogue: 0,0:13:56.00,0:13:58.75,Default,,0,0,0,,Бір ұпай болса да, сол...
Dialogue: 0,0:13:59.21,0:14:01.46,Default,,0,0,0,,Бірінші шайқас басталады.
Dialogue: 0,0:14:04.00,0:14:07.01,Default,,0,0,0,,Командалық матчта тек бір рет атуға болады...
Dialogue: 0,0:14:07.55,0:14:09.93,Default,,0,0,0,,Не ойласаң да, пайдасы жоқ.
Dialogue: 0,0:14:10.01,0:14:12.01,Default,,0,0,0,,Вивернмен жұмыс істеуге келетін болсақ...
Dialogue: 0,0:14:12.39,0:14:14.06,Default,,0,0,0,,Жеңіске жет, Кумичо!
Dialogue: 0,0:14:15.85,0:14:18.81,Default,,0,0,0,,Red Rising командасы Рагнарукқа қарсы.
Dialogue: 0,0:14:18.89,0:14:22.19,Default,,0,0,0,,Бұл көк жабайы Вайверн командасы.
Dialogue: 0,0:14:22.52,0:14:24.11,Default,,0,0,0,,Соғыс!
Dialogue: 0,0:14:24.19,0:14:25.32,Default,,0,0,0,,Әй
Dialogue: 0,0:14:26.53,0:14:29.03,Default,,0,0,0,,Күтілгендей, бұл командалық шайқас!
Dialogue: 0,0:14:29.57,0:14:31.28,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:14:31.57,0:14:34.70,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:34.95,0:14:37.08,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:40.75,0:14:42.04,Default,,0,0,0,,Бұл диагональды түсіру!
Dialogue: 0,0:14:42.38,0:14:44.21,Default,,0,0,0,,Бұл Рагнарук аймағы емес пе?
Dialogue: 0,0:14:47.09,0:14:49.26,Default,,0,0,0,,Мен сені бір соққымен ұшырып жіберемін!
Dialogue: 0,0:14:49.51,0:14:50.68,Default,,0,0,0,,Диагональ бойынша соғу -
Dialogue: 0,0:14:50.76,0:14:52.80,Default,,0,0,0,,Сіз мені артық аяқтауды жоспарлап отырсыз ба?
Dialogue: 0,0:14:59.14,0:15:01.48,Default,,0,0,0,,Бұл менің командалық шайқас!
Dialogue: 0,0:15:01.90,0:15:03.27,Default,,0,0,0,,Осылай жүре бер!
Dialogue: 0,0:15:03.36,0:15:04.94,Default,,0,0,0,,Аяқталды!
Dialogue: 0,0:15:05.15,0:15:08.28,Default,,0,0,0,,Артық мәреге жету үшін қашықтық жеткілікті емес пе...
Dialogue: 0,0:15:08.61,0:15:10.99,Default,,0,0,0,,Мен бұл туралы қатты ойлаған сияқтымын...
Dialogue: 0,0:15:11.07,0:15:12.11,Default,,0,0,0,,Барлығы осы
Dialogue: 0,0:15:14.58,0:15:15.58,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:15:15.91,0:15:16.62,Default,,0,0,0,,Гррр…
Dialogue: 0,0:15:17.12,0:15:18.70,Default,,0,0,0,,Қалқан апаты!
Dialogue: 0,0:15:20.12,0:15:20.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:21.87,0:15:23.25,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:15:25.04,0:15:25.84,Default,,0,0,0,,Әзірге үш минут
Dialogue: 0,0:15:26.55,0:15:29.42,Default,,0,0,0,,Рагнаруктың көтерілуі аяқталды!
Dialogue: 0,0:15:29.51,0:15:31.59,Default,,0,0,0,,Қызыл команда 2 ұпай!
Dialogue: 0,0:15:31.97,0:15:33.51,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:15:34.09,0:15:35.14,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:15:35.22,0:15:36.64,Default,,0,0,0,,Сіз қалай ойлайсыз? Вакия!
Dialogue: 0,0:15:36.72,0:15:39.60,Default,,0,0,0,,О, менің жеңісім!
Dialogue: 0,0:15:39.68,0:15:41.69,Default,,0,0,0,,Бұл ұят, Бочама.
Dialogue: 0,0:15:42.19,0:15:45.98,Default,,0,0,0,,Ал... бұл менің де стадионға бірінші рет келуім еді.
Dialogue: 0,0:15:46.07,0:15:47.94,Default,,0,0,0,,Вивернді жару деген нені білдіреді?
Dialogue: 0,0:15:48.03,0:15:50.69,Default,,0,0,0,,Бұл трюк шынымен де жұмыс істеді.
Dialogue: 0,0:15:50.95,0:15:53.57,Default,,0,0,0,,Бұл сөзсіз жеңіліс, солай емес пе?
Dialogue: 0,0:15:53.66,0:15:55.45,Default,,0,0,0,,Ошимиді жоғалту Ошимиді жоғалту
Dialogue: 0,0:15:55.74,0:15:58.99,Default,,0,0,0,,Не... не?! Сіз нақты нәрсе туралы айтып отырсыз, иә!
Dialogue: 0,0:15:59.45,0:16:00.79,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:16:01.79,0:16:04.21,Default,,0,0,0,,Ал Дина мен Хоудзи ше?
Dialogue: 0,0:16:04.29,0:16:05.92,Default,,0,0,0,,Арғы жағында қалай болады...
Dialogue: 0,0:16:06.50,0:16:08.21,Default,,0,0,0,,Істейтін ештеңе қалмады.
Dialogue: 0,0:16:08.55,0:16:10.80,Default,,0,0,0,,Келесісін тастасаңыз, ұтыласыз...
Dialogue: 0,0:16:11.09,0:16:12.55,Default,,0,0,0,,Егер сіз жеңсеңіз, онда иә.
Dialogue: 0,0:16:12.63,0:16:13.63,Default,,0,0,0,,Сіз мұны істей аласыз, солай ма?
Dialogue: 0,0:16:14.26,0:16:16.14,Default,,0,0,0,,Әлі де солай ма?
Dialogue: 0,0:16:16.22,0:16:18.85,Default,,0,0,0,,Мен сенемін дегім келмейді немесе оны өзіме қалдырғым келмейді.
Dialogue: 0,0:16:18.93,0:16:22.60,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Қайсысы баратынын тез шешіңіз.
Dialogue: 0,0:16:23.02,0:16:24.19,Default,,0,0,0,,Кеттік
Dialogue: 0,0:16:24.73,0:16:27.19,Default,,0,0,0,,Мен олар туралы сенен гөрі көбірек білемін.
Dialogue: 0,0:16:27.27,0:16:28.94,Default,,0,0,0,,Жарайды, маған қалдырыңыз.
Dialogue: 0,0:16:29.27,0:16:31.69,Default,,0,0,0,,Сонымен, келесі пышақ алға.
Dialogue: 0,0:16:32.28,0:16:32.99,Default,,0,0,0,,О!
Dialogue: 0,0:16:34.49,0:16:36.20,Default,,0,0,0,,Бұл Бал-ни мен Дина!
Dialogue: 0,0:16:36.45,0:16:38.16,Default,,0,0,0,,Шуды тастап кеттің бе?
Dialogue: 0,0:16:38.24,0:16:39.91,Default,,0,0,0,,Мен сені шығарып аламын!
Dialogue: 0,0:16:40.70,0:16:42.12,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:16:43.62,0:16:45.25,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:16:45.67,0:16:47.79,Default,,0,0,0,,Балт, бәрібір жең!
Dialogue: 0,0:16:47.88,0:16:50.59,Default,,0,0,0,,Егер сіз жеңсеңіз, қызыл команда жеңеді!
Dialogue: 0,0:16:50.88,0:16:52.46,Default,,0,0,0,,Маған қалдырыңыз!
Dialogue: 0,0:16:52.55,0:16:53.88,Default,,0,0,0,,Мен шешемін!
Dialogue: 0,0:16:54.55,0:16:56.18,Default,,0,0,0,,Егер менің ағам жеңсе...
Dialogue: 0,0:16:56.26,0:16:58.60,Default,,0,0,0,,Шу-кунның шайқасы жоғалып кете ме?
Dialogue: 0,0:16:58.68,0:17:01.43,Default,,0,0,0,,Қызыл командасы 3 ұпай алады.
Dialogue: 0,0:17:01.52,0:17:04.35,Default,,0,0,0,,Е, мен Шу-кунның шайқасын көргім келеді!
Dialogue: 0,0:17:04.44,0:17:06.81,Default,,0,0,0,,Бірақ мен ағамның жеңгенін қалаймын...
Dialogue: 0,0:17:06.90,0:17:08.35,Default,,0,0,0,,Негізінен, біз қашамыз.
Dialogue: 0,0:17:08.56,0:17:10.40,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:17:11.15,0:17:14.11,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:14.24,0:17:16.53,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:18.24,0:17:20.74,Default,,0,0,0,,Алға, асығыс ат!
Dialogue: 0,0:17:21.08,0:17:23.20,Default,,0,0,0,,Шайқаңыз, Өлім өлшемшісі!
Dialogue: 0,0:17:25.37,0:17:27.25,Default,,0,0,0,,Тез ату және шайқау ату
Dialogue: 0,0:17:27.33,0:17:29.54,Default,,0,0,0,,Екі техника да көп қозғалады.
Dialogue: 0,0:17:29.63,0:17:32.30,Default,,0,0,0,,Екінші шайқас жүгіру туралы бола ма?
Dialogue: 0,0:17:33.96,0:17:34.92,Default,,0,0,0,,Өте жылдам!
Dialogue: 0,0:17:35.13,0:17:36.68,Default,,0,0,0,,Жарайды, жүр!
Dialogue: 0,0:17:38.22,0:17:39.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:39.51,0:17:41.81,Default,,0,0,0,,Әлі ерте және уақыты дұрыс емес!
Dialogue: 0,0:17:42.14,0:17:43.35,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:17:47.06,0:17:48.60,Default,,0,0,0,,Мүлдем емес пе?
Dialogue: 0,0:17:48.69,0:17:50.69,Default,,0,0,0,,Олар тег ойнап жатқан сияқты...
Dialogue: 0,0:17:51.11,0:17:53.11,Default,,0,0,0,,Келіңіздер... Келіңіздер...!
Dialogue: 0,0:17:59.91,0:18:01.78,Default,,0,0,0,,Бұл осы жерден, Валькири!
Dialogue: 0,0:18:02.12,0:18:04.33,Default,,0,0,0,,Жауап бер, өлімші!
Dialogue: 0,0:18:05.75,0:18:08.96,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:18:10.25,0:18:11.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:11.34,0:18:12.63,Default,,0,0,0,,Бұл жұмыс істемейді!
Dialogue: 0,0:18:12.71,0:18:14.55,Default,,0,0,0,,Шыдамның таусылуы
Dialogue: 0,0:18:14.96,0:18:17.67,Default,,0,0,0,,Алғашқы байланыс орнатуға тым ұзақ уақыт кетті.
Dialogue: 0,0:18:17.76,0:18:19.59,Default,,0,0,0,,Rip Death Sizeer!
Dialogue: 0,0:18:19.68,0:18:21.43,Default,,0,0,0,,Шайқаңыз!
Dialogue: 0,0:18:23.76,0:18:26.10,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:18:26.52,0:18:29.31,Default,,0,0,0,,Dark Death Sizeer Burst Finish!
Dialogue: 0,0:18:29.39,0:18:31.61,Default,,0,0,0,,Көк командасы 2 ұпай!
Dialogue: 0,0:18:32.02,0:18:33.86,Default,,0,0,0,,Гррр...
Dialogue: 0,0:18:35.15,0:18:37.40,Default,,0,0,0,,Дина керемет!
Dialogue: 0,0:18:38.95,0:18:40.78,Default,,0,0,0,,Бұл галстук па?
Dialogue: 0,0:18:41.07,0:18:43.74,Default,,0,0,0,,Келесі жеңіске жеткен команда жеңеді немесе
Dialogue: 0,0:18:44.12,0:18:46.79,Default,,0,0,0,,Үшінші шайқас Спригганға қарсы
Dialogue: 0,0:18:46.87,0:18:48.33,Default,,0,0,0,,Қасиетті Хорсуд
Dialogue: 0,0:18:48.71,0:18:50.37,Default,,0,0,0,,Дайындаңыз.
Dialogue: 0,0:18:50.87,0:18:54.34,Default,,0,0,0,,Шу-кунның шайқасын көрмегелі біраз болды!
Dialogue: 0,0:18:55.00,0:18:57.51,Default,,0,0,0,,Шу! Қазір иығың жақсы ма?
Dialogue: 0,0:18:57.59,0:18:58.47,Default,,0,0,0,,О
Dialogue: 0,0:18:58.55,0:19:00.47,Default,,0,0,0,,Сонда біз жеңеміз!
Dialogue: 0,0:19:00.55,0:19:01.68,Default,,0,0,0,,It's still early
Dialogue: 0,0:19:02.34,0:19:03.85,Default,,0,0,0,,Хоудзи Конта…
Dialogue: 0,0:19:04.10,0:19:05.93,Default,,0,0,0,,Мен біреумен бірінші рет ұрысып жатырмын...
Dialogue: 0,0:19:06.01,0:19:08.06,Default,,0,0,0,,Оның қабілеті Комурасакимен салыстыруға келмейді.
Dialogue: 0,0:19:08.64,0:19:10.77,Default,,0,0,0,,Маған Энрио керек, Хоудзи
Dialogue: 0,0:19:14.69,0:19:16.40,Default,,0,0,0,,Шуу-кун жекпе-жек!
Dialogue: 0,0:19:16.48,0:19:17.69,Default,,0,0,0,,Хоудзиге де сәттілік!
Dialogue: 0,0:19:18.32,0:19:19.53,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:19:21.82,0:19:23.12,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:19:23.82,0:19:25.28,Default,,0,0,0,,Бенишу...
Dialogue: 0,0:19:25.37,0:19:27.62,Default,,0,0,0,,Мен саған Хорсудтың күшін көрсетемін!
Dialogue: 0,0:19:32.17,0:19:33.83,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:19:34.17,0:19:37.59,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:37.67,0:19:39.80,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:43.84,0:19:44.60,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:19:44.97,0:19:47.18,Default,,0,0,0,,Мен жылдамдықпен тұрдым Иә, ат!
Dialogue: 0,0:19:49.35,0:19:52.06,Default,,0,0,0,,Шу оны әдеттегіден басқа жерге тастады!
Dialogue: 0,0:19:52.52,0:19:55.48,Default,,0,0,0,,Не ойлап отырсың, Куришуу...
Dialogue: 0,0:19:57.15,0:19:58.15,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:19:58.69,0:20:00.57,Default,,0,0,0,,Яябе, мен орталықты аламын!
Dialogue: 0,0:20:02.78,0:20:03.86,Default,,0,0,0,,Сіз оны уақытында жасайсыз ба?
Dialogue: 0,0:20:06.20,0:20:08.24,Default,,0,0,0,,Хорсуд өрісі!
Dialogue: 0,0:20:16.25,0:20:16.92,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:20:17.71,0:20:19.21,Default,,0,0,0,,Мақсат осы ма?
Dialogue: 0,0:20:19.34,0:20:20.92,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:20:21.84,0:20:22.88,Default,,0,0,0,,Жақындама! Мен саған айттым ғой, оның ашуы тез шығатынын!
Dialogue: 0,0:20:23.18,0:20:24.89,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:24.97,0:20:27.64,Default,,0,0,0,,Спригган дауылы аяқталды!
Dialogue: 0,0:20:29.01,0:20:29.93,Default,,0,0,0,,Әй
Dialogue: 0,0:20:30.47,0:20:32.89,Default,,0,0,0,,Шу! Сіздің мақсатыңыз осы ма еді?
Dialogue: 0,0:20:33.06,0:20:34.52,Default,,0,0,0,,Хорсуд қозғалысы және
Dialogue: 0,0:20:34.60,0:20:37.11,Default,,0,0,0,,Викинг азуының орнын есептеу...
Dialogue: 0,0:20:37.52,0:20:40.15,Default,,0,0,0,,Ең дұрысы жоғарғы атуды сол қалыпта түсіру.
Dialogue: 0,0:20:40.23,0:20:42.53,Default,,0,0,0,,Бұл керемет Шуу!
Dialogue: 0,0:20:42.74,0:20:45.24,Default,,0,0,0,,Стадионның сипаттамаларын ғана қарастыру.
Dialogue: 0,0:20:45.82,0:20:48.41,Default,,0,0,0,,Ал, бәріңе.
Dialogue: 0,0:20:48.49,0:20:49.83,Default,,0,0,0,,Бұл командалық жарыс –
Dialogue: 0,0:20:49.91,0:20:52.37,Default,,0,0,0,,Қызыл командасы жеңеді.
Dialogue: 0,0:20:52.45,0:20:54.16,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:54.25,0:20:55.17,Default,,0,0,0,,Гррр…
Dialogue: 0,0:20:55.54,0:20:57.75,Default,,0,0,0,,Бұл ұят, Бочама.
Dialogue: 0,0:20:57.83,0:20:59.17,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:03.13,0:21:05.59,Default,,0,0,0,,(Токонацу Никаның ұйықтап жатқан тынысы)
Dialogue: 0,0:21:05.68,0:21:08.85,Default,,0,0,0,,Командалық жарыстар жеке жарыстардан мүлде ерекшеленеді.
Dialogue: 0,0:21:09.14,0:21:11.81,Default,,0,0,0,,Мен оны асыға күтемін!
Dialogue: 0,0:21:13.14,0:21:13.98,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:21:14.23,0:21:16.90,Default,,0,0,0,,Көбірек жаттығу жасайық, Валькири!
Dialogue: 0,0:21:18.86,0:21:19.94,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:21:20.07,0:21:21.02,Default,,0,0,0,,О!
Dialogue: 0,0:21:21.48,0:21:22.69,Default,,0,0,0,,Шу!
Dialogue: 0,0:21:22.78,0:21:23.99,Default,,0,0,0,,Сен де келдің бе?
Dialogue: 0,0:21:24.53,0:21:26.45,Default,,0,0,0,,Хехехе!
Dialogue: 0,0:21:27.78,0:21:29.87,Default,,0,0,0,,Не, балалар?
Dialogue: 0,0:21:29.95,0:21:30.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:31.12,0:21:32.41,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:21:32.49,0:21:36.71,Default,,0,0,0,,Мен жасырын жаттығу жасауды жоспарлап едім, бірақ бірінші келуге мәжбүр болдым.
Dialogue: 0,0:21:36.79,0:21:38.04,Default,,0,0,0,,Ойын ойыны-
Dialogue: 0,0:21:38.13,0:21:39.46,Default,,0,0,0,,шығанақтағы жаттығу лагері, солай ма?
Dialogue: 0,0:21:40.88,0:21:43.17,Default,,0,0,0,,Жарайды, шайқасайық!
Dialogue: 0,0:21:43.51,0:21:46.55,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:21:46.63,0:21:48.55,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:22:05.03,0:22:11.12,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:11.33,0:22:17.46,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:17.91,0:22:23.46,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:23.92,0:22:27.26,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:27.42,0:22:32.35,Default,,0,0,0,,Сіз енді ешқашан жоғалмайсыз
Dialogue: 0,0:22:34.26,0:22:36.98,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:37.06,0:22:40.27,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:40.35,0:22:46.69,Default,,0,0,0,,Артынан қусаң да көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:46.94,0:22:52.49,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:52.66,0:22:59.25,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:22:59.83,0:23:05.25,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:05.42,0:23:08.59,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:09.09,0:23:13.05,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:22.35,0:23:24.86,Default,,0,0,0,,Оқу-жаттығу лагерінің арнайы жаттығулары өте қызықты!
Dialogue: 0,0:23:24.94,0:23:28.24,Default,,0,0,0,,Викинг стадионы Мен оны міндетті түрде бағындырамын!
Dialogue: 0,0:23:28.32,0:23:30.82,Default,,0,0,0,,Не! Токонацу мен Ника жоғалып кетті ме?
Dialogue: 0,0:23:30.90,0:23:32.07,Default,,0,0,0,,Қайда кетті?
Dialogue: 0,0:23:32.16,0:23:34.07,Default,,0,0,0,,Вакия! Бұл сіздің виллаңыз ба?
Dialogue: 0,0:23:34.16,0:23:36.33,Default,,0,0,0,,Олардың қайда бара жатқанын айтыңыз!
Dialogue: 0,0:23:36.41,0:23:38.25,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:38.33,0:23:41.25,Default,,0,0,0,,Тау! Бұл өзен! Дауылды шытырман оқиға!
Dialogue: 0,0:23:41.33,0:23:43.04,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:43.13,0:23:44.96,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:46.46,0:23:52.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory