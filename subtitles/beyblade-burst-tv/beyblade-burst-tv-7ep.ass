Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.13,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.21,0:00:12.38,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.76,0:00:14.76,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:16.93,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.01,0:00:18.68,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.48,0:00:24.14,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.23,0:00:26.19,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.27,0:00:28.77,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.48,0:00:34.11,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:00:34.20,0:00:35.74,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:00:35.82,0:00:36.82,Default,,0,0,0,,Уф!
Dialogue: 0,0:00:39.99,0:00:40.87,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:00:45.04,0:00:46.62,Default,,0,0,0,,Бұл сәтсіз түсірілім~
Dialogue: 0,0:00:46.79,0:00:47.58,Default,,0,0,0,,Жоқ
Dialogue: 0,0:00:47.67,0:00:50.25,Default,,0,0,0,,Бұл мүлдем басқа жол.
Dialogue: 0,0:00:50.34,0:00:50.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:53.92,0:00:57.84,Default,,0,0,0,,Оның қазіргі ұстанымы, сөзсіз, асығыс соққы болды.
Dialogue: 0,0:00:57.93,0:01:00.35,Default,,0,0,0,,Мен мұндай қозғалысты бұрын-соңды көрген емеспін.
Dialogue: 0,0:01:08.86,0:01:11.19,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:01:11.27,0:01:15.40,Default,,0,0,0,,Біз Валькирия атты жаңа техниканы ойлап таптық.
Dialogue: 0,0:01:23.75,0:01:26.12,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:26.46,0:01:31.63,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:42.93,0:01:46.31,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:46.81,0:01:48.94,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:49.35,0:01:53.48,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:53.61,0:01:56.82,Default,,0,0,0,,Дұрыс, сіздің жүзіңіздегі өрнек
Dialogue: 0,0:01:56.95,0:02:03.37,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:03.66,0:02:08.08,Default,,0,0,0,,АУ! Айналып келе жатқан арман
Dialogue: 0,0:02:08.58,0:02:14.00,Default,,0,0,0,,Ыстық және тербеліс ойнайық
Dialogue: 0,0:02:14.13,0:02:16.38,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:16.46,0:02:21.18,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:21.34,0:02:26.43,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:26.72,0:02:28.98,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:29.19,0:02:31.52,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:31.81,0:02:35.73,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:35.90,0:02:40.91,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:41.11,0:02:43.28,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:47.00,0:02:49.62,Default,,0,0,0,,Өте жылдам! Флеш түсіру!
Dialogue: 0,0:02:51.71,0:02:53.54,Default,,0,0,0,,Барлығың тыңдаңдар.
Dialogue: 0,0:02:53.63,0:02:55.46,Default,,0,0,0,,Бейблейд клубы дайын!
Dialogue: 0,0:02:56.21,0:02:57.96,Default,,0,0,0,,Бұл әлі де болжамды.
Dialogue: 0,0:02:59.34,0:03:01.47,Default,,0,0,0,,Кеттік! Жаңа ерекше қозғалыс
Dialogue: 0,0:03:01.84,0:03:02.89,Default,,0,0,0,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,0:03:02.97,0:03:06.39,Default,,0,0,0,,Менің көтерілген Рагнарук сенің қарсыласың болады.
Dialogue: 0,0:03:06.85,0:03:09.77,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:03:09.93,0:03:11.31,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:03:17.23,0:03:19.53,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:03:23.78,0:03:25.28,Default,,0,0,0,,...
Dialogue: 0,0:03:25.49,0:03:27.33,Default,,0,0,0,,Бұл жаңа техника емес.
Dialogue: 0,0:03:27.41,0:03:29.04,Default,,0,0,0,,Атқан жоқ-жоқ?
Dialogue: 0,0:03:29.62,0:03:31.71,Default,,0,0,0,,Бұл кәдімгі асығыс ату.
Dialogue: 0,0:03:32.00,0:03:33.71,Default,,0,0,0,,Қандай жаңалық бар?
Dialogue: 0,0:03:33.79,0:03:35.79,Default,,0,0,0,,Мен сені Рагнарукқа тамақтандырамын.
Dialogue: 0,0:03:39.34,0:03:39.92,Default,,0,0,0,,Не!
Dialogue: 0,0:03:40.55,0:03:42.51,Default,,0,0,0,,Шапшаң ату қашып кетті
Dialogue: 0,0:03:42.93,0:03:44.05,Default,,0,0,0,,Мен мүлде не болып жатқанын түсінбеймін.
Dialogue: 0,0:03:44.14,0:03:46.80,Default,,0,0,0,,Бұл револьвер драйверінің күші
Dialogue: 0,0:03:46.89,0:03:47.56,Default,,0,0,0,,Хмм!
Dialogue: 0,0:03:48.14,0:03:49.52,Default,,0,0,0,,Бұл шешілді.
Dialogue: 0,0:03:49.81,0:03:53.44,Default,,0,0,0,,Егер Валькири шабуыл жасай алмаса, ол шыдамдылығын жоғалтады.
Dialogue: 0,0:03:54.19,0:03:56.36,Default,,0,0,0,,Рагнарук нөлдік зиян келтіреді.
Dialogue: 0,0:04:01.32,0:04:02.99,Default,,0,0,0,,Валькири тоқтады.
Dialogue: 0,0:04:03.28,0:04:06.45,Default,,0,0,0,,Рагнарук айналдырумен жеңіске жетті.
Dialogue: 0,0:04:06.53,0:04:07.66,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:04:07.74,0:04:09.91,Default,,0,0,0,,Рагнарук, сен ең жақсысың.
Dialogue: 0,0:04:10.50,0:04:12.75,Default,,0,0,0,,Бар болғаны 1 ұпай алынды.
Dialogue: 0,0:04:12.83,0:04:14.17,Default,,0,0,0,,Келесі - керісінше.
Dialogue: 0,0:04:14.25,0:04:15.04,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:04:15.12,0:04:18.25,Default,,0,0,0,,Бұл Кумичо-сама да екінші шайқасқа ие болады.
Dialogue: 0,0:04:18.34,0:04:19.50,Default,,0,0,0,,Қатты… қатты қиын…
Dialogue: 0,0:04:20.09,0:04:24.13,Default,,0,0,0,,Бұл жолы мен жаңа ерекше қадамымды міндетті түрде сәтті орындаймын.
Dialogue: 0,0:04:24.59,0:04:26.43,Default,,0,0,0,,Екінші шайқасқа барайық
Dialogue: 0,0:04:27.01,0:04:27.55,Default,,0,0,0,,О!
Dialogue: 0,0:04:27.64,0:04:29.10,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:04:29.18,0:04:31.31,Default,,0,0,0,,Өтінемін, Валькири
Dialogue: 0,0:04:32.43,0:04:34.39,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:04:34.48,0:04:36.60,Default,,0,0,0,,Ах... аа аа
Dialogue: 0,0:04:38.90,0:04:40.61,Default,,0,0,0,,Керемет!
Dialogue: 0,0:04:40.69,0:04:43.15,Default,,0,0,0,,Жеңіске жету жақсы.
Dialogue: 0,0:04:43.95,0:04:46.49,Default,,0,0,0,,Неліктен мен арнайы қозғалысты пайдалана алмаймын?
Dialogue: 0,0:04:46.57,0:04:49.78,Default,,0,0,0,,Балто Маған үлгеру қиын.
Dialogue: 0,0:04:49.87,0:04:51.37,Default,,0,0,0,,Керемет!
Dialogue: 0,0:04:57.54,0:04:58.54,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:04:58.63,0:05:01.63,Default,,0,0,0,,Вакия-сан, күте тұрыңыз.
Dialogue: 0,0:05:01.71,0:05:03.63,Default,,0,0,0,,Тым ерте
Dialogue: 0,0:05:05.34,0:05:08.55,Default,,0,0,0,,Сасаки мен Синдо кешігіп қалды.
Dialogue: 0,0:05:08.64,0:05:11.85,Default,,0,0,0,,Егер сіз күштірек болғыңыз келетінін түсінсеңіз
Dialogue: 0,0:05:11.93,0:05:14.48,Default,,0,0,0,,Еш нәрсеге қарамастан сенің соңынан еретініне сенімдімін.
Dialogue: 0,0:05:14.56,0:05:16.19,Default,,0,0,0,,Оны көбірек көтеріңіз Хоудзи
Dialogue: 0,0:05:16.89,0:05:17.94,Default,,0,0,0,,Иә
Dialogue: 0,0:05:19.77,0:05:21.82,Default,,0,0,0,,Қорқынышты көрінеді
Dialogue: 0,0:05:22.32,0:05:23.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:23.40,0:05:25.61,Default,,0,0,0,,Бала, бірінші бар.
Dialogue: 0,0:05:26.24,0:05:29.57,Default,,0,0,0,,Себебі сіз өте биікке көтерілесіз.
Dialogue: 0,0:05:29.66,0:05:30.99,Default,,0,0,0,,Өйткені
Dialogue: 0,0:05:31.08,0:05:34.00,Default,,0,0,0,,Мені ренжітсең, аямайсың ба?
Dialogue: 0,0:05:34.41,0:05:36.41,Default,,0,0,0,,Мен біреуді шақырайын ба?
Dialogue: 0,0:05:36.50,0:05:38.67,Default,,0,0,0,,Тек сонда қал.
Dialogue: 0,0:05:38.75,0:05:39.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:40.88,0:05:42.92,Default,,0,0,0,,Мен сені қазір түсіремін.
Dialogue: 0,0:05:43.00,0:05:44.76,Default,,0,0,0,,Бұтақтан мықтап ұстаңыз.
Dialogue: 0,0:05:44.84,0:05:45.63,Default,,0,0,0,,Иә
Dialogue: 0,0:05:46.38,0:05:48.34,Default,,0,0,0,,Мен баяу түсемін.
Dialogue: 0,0:05:48.76,0:05:49.55,Default,,0,0,0,,Сөйлеме
Dialogue: 0,0:05:49.64,0:05:51.01,Default,,0,0,0,,Иә
Dialogue: 0,0:05:52.01,0:05:54.72,Default,,0,0,0,,Уау, бұл мені құтқарды.
Dialogue: 0,0:05:54.93,0:05:56.02,Default,,0,0,0,,(Мысық мияу)
Dialogue: 0,0:05:56.10,0:05:58.19,Default,,0,0,0,,Хе... Бұл не?
Dialogue: 0,0:05:58.27,0:05:59.56,Default,,0,0,0,,(Токонацудың күлкісі)
Dialogue: 0,0:05:59.65,0:06:01.94,Default,,0,0,0,,Тым абайсызда ештеңе жасамаңыз.
Dialogue: 0,0:06:02.02,0:06:02.77,Default,,0,0,0,,Иә
Dialogue: 0,0:06:02.98,0:06:04.28,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:06:04.53,0:06:05.32,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:06.11,0:06:07.11,Default,,0,0,0,,Сол адам
Dialogue: 0,0:06:07.20,0:06:08.32,Default,,0,0,0,,Кешір… (Иура) Қайдағы жоқ.
Dialogue: 0,0:06:08.78,0:06:11.03,Default,,0,0,0,,Ол менің ағамның келесі қарсыласы.
Dialogue: 0,0:06:11.12,0:06:11.78,Default,,0,0,0,,Не!
Dialogue: 0,0:06:12.08,0:06:14.83,Default,,0,0,0,,Хоудзи Конта дедіңіз бе?
Dialogue: 0,0:06:14.91,0:06:17.00,Default,,0,0,0,,Токонацу Сен маған көмектестің.
Dialogue: 0,0:06:17.08,0:06:18.75,Default,,0,0,0,,Мен саған әлі алғыс айтқан жоқпын.
Dialogue: 0,0:06:18.83,0:06:20.00,Default,,0,0,0,,Бұл болды
Dialogue: 0,0:06:20.08,0:06:21.04,Default,,0,0,0,,Қуып жіберейік
Dialogue: 0,0:06:21.13,0:06:22.67,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:06:23.59,0:06:25.55,Default,,0,0,0,,Иә... Иә!
Dialogue: 0,0:06:25.63,0:06:28.01,Default,,0,0,0,,Дұрыс, есіме түсті!
Dialogue: 0,0:06:28.63,0:06:29.34,Default,,0,0,0,,Қый!
Dialogue: 0,0:06:29.84,0:06:33.14,Default,,0,0,0,,Дәл осы кезде ұшқан доп маған тиді.
Dialogue: 0,0:06:36.27,0:06:37.81,Default,,0,0,0,,Қазірге дейінгі тәжірибелердің нәтижелеріне сүйене отырып,
Dialogue: 0,0:06:37.89,0:06:39.64,Default,,0,0,0,,Мүмкін?
Dialogue: 0,0:06:40.02,0:06:40.90,Default,,0,0,0,,Иә
Dialogue: 0,0:06:42.65,0:06:44.07,Default,,0,0,0,,Бұл шынымен жақсы ма?
Dialogue: 0,0:06:44.15,0:06:45.61,Default,,0,0,0,,О, орындаңызшы.
Dialogue: 0,0:06:46.36,0:06:47.36,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:06:48.03,0:06:48.86,Default,,0,0,0,,О
Dialogue: 0,0:06:53.28,0:06:54.49,Default,,0,0,0,,(Дарио) Дио, мына жаққа кел. Жөтел, жөтел!
Dialogue: 0,0:06:55.37,0:06:57.66,Default,,0,0,0,,Жүр! Сен не істеп жатырсың?
Dialogue: 0,0:06:58.37,0:07:01.08,Default,,0,0,0,,Сіз маған болжауды айтпадыңыз ба?
Dialogue: 0,0:07:01.17,0:07:02.33,Default,,0,0,0,,Бұл өте күшті!
Dialogue: 0,0:07:02.42,0:07:04.96,Default,,0,0,0,,Біз сіз үшін бірге жұмыс істеп жатырмыз.
Dialogue: 0,0:07:05.04,0:07:06.50,Default,,0,0,0,,Бұлай айтуға болмайды.
Dialogue: 0,0:07:06.59,0:07:07.71,Default,,0,0,0,,және ол бұрын сарбаз болған.
Dialogue: 0,0:07:07.80,0:07:08.71,Default,,0,0,0,,Не?
Dialogue: 0,0:07:08.92,0:07:11.93,Default,,0,0,0,,Бұл өте ауыр (Рантаро) Бұл асыра сілтеу.
Dialogue: 0,0:07:12.01,0:07:13.59,Default,,0,0,0,,Екеуі де тым ақымақ
Dialogue: 0,0:07:13.68,0:07:15.85,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:07:15.93,0:07:17.39,Default,,0,0,0,,Білек.
Dialogue: 0,0:07:18.81,0:07:19.81,Default,,0,0,0,,Бәрі сол қорқақтың кесірінен.
Dialogue: 0,0:07:20.27,0:07:22.06,Default,,0,0,0,,Доп Балтоға тиді
Dialogue: 0,0:07:22.15,0:07:24.44,Default,,0,0,0,,Денем сәл еңкейіп қалды.
Dialogue: 0,0:07:24.94,0:07:27.73,Default,,0,0,0,,Барт бейсаналық түрде оны түзетуге тырысты.
Dialogue: 0,0:07:27.82,0:07:29.61,Default,,0,0,0,,Білек түзетілді
Dialogue: 0,0:07:31.03,0:07:31.99,Default,,0,0,0,,Білек…
Dialogue: 0,0:07:32.70,0:07:33.87,Default,,0,0,0,,Сол себепті
Dialogue: 0,0:07:33.95,0:07:37.24,Default,,0,0,0,,Іске қосу қондырғысы мен стадион арасындағы бұрыш параллель болды.
Dialogue: 0,0:07:37.79,0:07:39.04,Default,,0,0,0,,Білек
Dialogue: 0,0:07:39.75,0:07:41.00,Default,,0,0,0,,түзу
Dialogue: 0,0:07:41.71,0:07:43.62,Default,,0,0,0,,Көріп көрейік!
Dialogue: 0,0:07:44.00,0:07:45.46,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:07:46.04,0:07:47.71,Default,,0,0,0,,Бұл Шуу!
Dialogue: 0,0:07:47.80,0:07:49.46,Default,,0,0,0,,Сен маған жақсы қарадың.
Dialogue: 0,0:07:49.88,0:07:53.89,Default,,0,0,0,,Мен бұл жай ғана доптың кінәсі емес деп ойладым, бірақ... мүмкін бұл менің білегім шығар?
Dialogue: 0,0:07:53.97,0:07:56.47,Default,,0,0,0,,Балто, тез орындап, көрсет.
Dialogue: 0,0:07:56.55,0:07:57.43,Default,,0,0,0,,О!
Dialogue: 0,0:07:58.60,0:08:01.35,Default,,0,0,0,,Позиция Rush Shoot сияқты.
Dialogue: 0,0:08:01.43,0:08:03.81,Default,,0,0,0,,Сондықтан білегіңізді тік ұстаңыз.
Dialogue: 0,0:08:04.77,0:08:05.61,Default,,0,0,0,,Зұлымдар Альянсы мен Шие Хачисай-кай арасында жақсы ынтымақтастық жоқ —
Dialogue: 0,0:08:06.15,0:08:08.19,Default,,0,0,0,,Жаңа әдістерді шығарыңыз
Dialogue: 0,0:08:08.69,0:08:10.57,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:08:10.90,0:08:13.65,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:14.24,0:08:15.95,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:19.99,0:08:20.91,Default,,0,0,0,,Ха...
Dialogue: 0,0:08:25.21,0:08:26.50,Default,,0,0,0,,Ааах— сол сұм!
Dialogue: 0,0:08:26.58,0:08:27.96,Default,,0,0,0,,Міне!
Dialogue: 0,0:08:28.46,0:08:29.96,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:08:32.34,0:08:34.22,Default,,0,0,0,,Бұл керемет жылдамдық.
Dialogue: 0,0:08:34.72,0:08:36.43,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:08:36.51,0:08:38.14,Default,,0,0,0,,Вандафо~
Dialogue: 0,0:08:38.22,0:08:39.01,Default,,0,0,0,,О
Dialogue: 0,0:08:39.51,0:08:41.85,Default,,0,0,0,,Қарсылас ортада тұрып қалғанда
Dialogue: 0,0:08:42.56,0:08:44.02,Default,,0,0,0,,Жылдамдықта қалу
Dialogue: 0,0:08:44.10,0:08:45.69,Default,,0,0,0,,Сыртта қуа алады
Dialogue: 0,0:08:47.19,0:08:48.36,Default,,0,0,0,,Иә...
Dialogue: 0,0:08:48.77,0:08:51.19,Default,,0,0,0,,Иә! Мен жасадым
Dialogue: 0,0:08:52.78,0:08:54.65,Default,,0,0,0,,Кумичо Орындалды!
Dialogue: 0,0:08:54.74,0:08:57.57,Default,,0,0,0,,Ах! Мен техникаға атау беруім керек.
Dialogue: 0,0:08:59.12,0:09:00.45,Default,,0,0,0,,Аты?
Dialogue: 0,0:09:01.08,0:09:01.99,Default,,0,0,0,,Валькирия
Dialogue: 0,0:09:02.37,0:09:04.25,Default,,0,0,0,,Сіздің жаңа есіміңіз кім болады?
Dialogue: 0,0:09:06.08,0:09:07.58,Default,,0,0,0,,Иә, түсіндім!
Dialogue: 0,0:09:07.67,0:09:09.54,Default,,0,0,0,,Е, енді ше?
Dialogue: 0,0:09:10.04,0:09:12.92,Default,,0,0,0,,Кез келген жағдайда сіз Валькиримен сөйлесіп тұрсыз ба?
Dialogue: 0,0:09:13.01,0:09:13.84,Default,,0,0,0,,Әрине!
Dialogue: 0,0:09:13.92,0:09:15.05,Default,,0,0,0,,Иә...
Dialogue: 0,0:09:15.13,0:09:17.59,Default,,0,0,0,,Әдетте, егер сіз Blader болсаңыз, сіз сөйлесесіз.
Dialogue: 0,0:09:17.68,0:09:18.51,Default,,0,0,0,,Неге мен отырдым?
Dialogue: 0,0:09:18.59,0:09:19.30,Default,,0,0,0,,Иә
Dialogue: 0,0:09:19.39,0:09:20.43,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:20.51,0:09:22.14,Default,,0,0,0,,Барлығы сөйлей ме? Шынайы ма?
Dialogue: 0,0:09:22.22,0:09:24.77,Default,,0,0,0,,Иә (Рантаро) Иә... Шынайы ма?
Dialogue: 0,0:09:25.77,0:09:28.98,Default,,0,0,0,,«Маған ерекше қадамымның атын Валкири берді».
Dialogue: 0,0:09:29.06,0:09:30.86,Default,,0,0,0,,деп айтудың қажеті жоқ деп ойлаймын.
Dialogue: 0,0:09:31.57,0:09:33.11,Default,,0,0,0,,Оны маған қосты.
Dialogue: 0,0:09:33.19,0:09:34.53,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:09:34.61,0:09:36.74,Default,,0,0,0,,Сонымен жаңа техника қалай аталады?
Dialogue: 0,0:09:38.78,0:09:39.74,Default,,0,0,0,,Жарқыл
Dialogue: 0,0:09:40.41,0:09:41.87,Default,,0,0,0,,Жарық түсіру
Dialogue: 0,0:09:42.20,0:09:43.58,Default,,0,0,0,,Жарық түсіру
Dialogue: 0,0:09:43.66,0:09:45.75,Default,,0,0,0,,Бұл Rush Shoot ойынына ұқсас.
Dialogue: 0,0:09:45.83,0:09:46.91,Default,,0,0,0,,Акселераторға да қолым жетпейді – орындық тым үлкен.
Dialogue: 0,0:09:47.25,0:09:48.42,Default,,0,0,0,,Yes
Dialogue: 0,0:09:48.83,0:09:49.92,Default,,0,0,0,,​​Бұл жақсы есім.
Dialogue: 0,0:09:50.42,0:09:51.50,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:09:51.92,0:09:54.09,Default,,0,0,0,,Мен оның қазір қалай сезінетінін ұмытпас бұрын
Dialogue: 0,0:09:54.17,0:09:56.26,Default,,0,0,0,,Мұқият жаттығу
Dialogue: 0,0:09:57.38,0:09:58.55,Default,,0,0,0,,Кеттік
Dialogue: 0,0:09:58.63,0:10:00.26,Default,,0,0,0,,Жарқын түсірілім!
Dialogue: 0,0:10:07.06,0:10:07.56,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:08.73,0:10:09.81,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:10:11.27,0:10:12.65,Default,,0,0,0,,Қауіп
Dialogue: 0,0:10:13.27,0:10:14.86,Default,,0,0,0,,Олардың мүлде қозғалмай жатқаны оғаш екен
Dialogue: 0,0:10:14.94,0:10:16.61,Default,,0,0,0,,Тағы бір сәтсіз ату
Dialogue: 0,0:10:20.24,0:10:21.16,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:10:22.91,0:10:24.62,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:10:30.63,0:10:31.67,Default,,0,0,0,,Команда құрамын келіссөз жүргізуді бастайық.
Dialogue: 0,0:10:32.42,0:10:35.46,Default,,0,0,0,,Табыс көрсеткіші 10-нан 1-ге тең бе?
Dialogue: 0,0:10:35.55,0:10:38.88,Default,,0,0,0,,Бұл қауіпті және оны матчта пайдалану мүмкін емес.
Dialogue: 0,0:10:38.97,0:10:40.51,Default,,0,0,0,,Ондай нәрсе жоқ
Dialogue: 0,0:10:40.59,0:10:42.97,Default,,0,0,0,,Мен, көбірек жаттығу.
Dialogue: 0,0:10:43.05,0:10:45.06,Default,,0,0,0,,Мен саған қауіп төндірмеймін.
Dialogue: 0,0:10:45.39,0:10:47.64,Default,,0,0,0,,Уәде беремін, досым.
Dialogue: 0,0:10:50.02,0:10:51.81,Default,,0,0,0,,Кешіктіргенім үшін кешіріңіз.
Dialogue: 0,0:10:52.81,0:10:53.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:53.94,0:10:55.19,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:10:55.61,0:10:56.86,Default,,0,0,0,,Хоудзи
Dialogue: 0,0:10:57.57,0:10:59.03,Default,,0,0,0,,Рахмет
Dialogue: 0,0:10:59.11,0:11:01.41,Default,,0,0,0,,Сәлем, келесі ойын.
Dialogue: 0,0:11:01.57,0:11:02.20,Default,,0,0,0,,Иә
Dialogue: 0,0:11:03.28,0:11:05.08,Default,,0,0,0,,Балто деген ақымаққа
Dialogue: 0,0:11:05.16,0:11:06.49,Default,,0,0,0,,Жеңіске жетсең жақсы.
Dialogue: 0,0:11:06.74,0:11:07.45,Default,,0,0,0,,Не!
Dialogue: 0,0:11:08.91,0:11:10.79,Default,,0,0,0,,Бала, бұл...
Dialogue: 0,0:11:10.87,0:11:13.63,Default,,0,0,0,,Сәттілікпен келген сияқты әлгі ақымақтар.
Dialogue: 0,0:11:13.71,0:11:16.55,Default,,0,0,0,,Жартылай финалда мен тез арада мәселені шешемін.
Dialogue: 0,0:11:16.75,0:11:17.76,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:19.22,0:11:21.30,Default,,0,0,0,,Енді тағы бір айналым жасайық.
Dialogue: 0,0:11:21.38,0:11:22.59,Default,,0,0,0,,Иә
Dialogue: 0,0:11:23.05,0:11:25.22,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:11:29.10,0:11:30.27,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:11:30.52,0:11:32.14,Default,,0,0,0,,«Мен жеңдім, иә»?
Dialogue: 0,0:11:33.02,0:11:35.94,Default,,0,0,0,,Бұл Хоудзидің Бар-ниден әдейі жеңілгенін білдіре ме?
Dialogue: 0,0:11:36.02,0:11:36.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:37.32,0:11:40.19,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:40.74,0:11:42.61,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:51.37,0:11:52.58,Default,,0,0,0,,Біз жарты жолды өтіп қойдық — бізді тежеме, жарай ма?
Dialogue: 0,0:11:52.67,0:11:54.88,Default,,0,0,0,,Қанаттарыңды жайып, ұша беріңдер
Dialogue: 0,0:11:56.96,0:11:57.67,Default,,0,0,0,,Неге осы дене функциялары әлі де болады?
Dialogue: 0,0:11:58.05,0:11:59.55,Default,,0,0,0,,Қасиетті Хорсуд
Dialogue: 0,0:12:03.18,0:12:06.80,Default,,0,0,0,,Сіз Балто сияқты ақымақты жеңе аласыз.
Dialogue: 0,0:12:09.22,0:12:11.48,Default,,0,0,0,,Бала... неге?
Dialogue: 0,0:12:12.35,0:12:13.81,Default,,0,0,0,,Хорсуд
Dialogue: 0,0:12:14.27,0:12:16.06,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:12:16.90,0:12:18.02,Default,,0,0,0,,Бізге жақсылап сөйлесу керек!
Dialogue: 0,0:12:20.28,0:12:22.61,Default,,0,0,0,,Бірдеңе айту қиын болуы мүмкін
Dialogue: 0,0:12:22.70,0:12:23.61,Default,,0,0,0,,Иә
Dialogue: 0,0:12:26.16,0:12:27.12,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:28.83,0:12:30.29,Default,,0,0,0,,Қат! тағы бір рет
Dialogue: 0,0:12:30.54,0:12:31.66,Default,,0,0,0,,Жарқын түсірілім!
Dialogue: 0,0:12:32.20,0:12:34.83,Default,,0,0,0,,Одан алыста, Рагнарук!
Dialogue: 0,0:12:37.75,0:12:39.67,Default,,0,0,0,,Жарайды, осы жолы орындайық.
Dialogue: 0,0:12:46.09,0:12:49.26,Default,,0,0,0,,Иә! Бұл Валькирияның күші
Dialogue: 0,0:12:49.35,0:12:51.68,Default,,0,0,0,,Цк, сіз мұны жарқыраған түрде жасадыңыз.
Dialogue: 0,0:12:51.77,0:12:54.60,Default,,0,0,0,,Енді табысқа жету ықтималдығын арттыру керек.
Dialogue: 0,0:12:54.69,0:12:57.31,Default,,0,0,0,,Сіріңкеде пайдалану өте қауіпті
Dialogue: 0,0:12:57.81,0:12:58.65,Default,,0,0,0,,О
Dialogue: 0,0:12:59.06,0:13:00.57,Default,,0,0,0,,Бұл жаңа техника ма?
Dialogue: 0,0:13:00.65,0:13:01.23,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:03.32,0:13:04.61,Default,,0,0,0,,Хоудзи Конта…
Dialogue: 0,0:13:05.07,0:13:07.03,Default,,0,0,0,,Барт осы жерде және қазір
Dialogue: 0,0:13:07.11,0:13:08.16,Default,,0,0,0,,Менімен күрес
Dialogue: 0,0:13:08.24,0:13:08.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:09.66,0:13:10.95,Default,,0,0,0,,Кенет не?
Dialogue: 0,0:13:11.04,0:13:12.91,Default,,0,0,0,,Сіз келесі ойында боласыз
Dialogue: 0,0:13:13.00,0:13:14.87,Default,,0,0,0,,Сіз мұны Балтомен жасауыңыз керек, солай ма?
Dialogue: 0,0:13:16.12,0:13:16.96,Default,,0,0,0,,О
Dialogue: 0,0:13:17.04,0:13:20.25,Default,,0,0,0,,Мүмкін сіз Beyblade клубына қосылғыңыз келе ме?
Dialogue: 0,0:13:20.34,0:13:21.71,Default,,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:13:21.92,0:13:22.80,Default,,0,0,0,,Гаккуши…
Dialogue: 0,0:13:23.01,0:13:25.26,Default,,0,0,0,,Бірақ қазір мен мұны сенімен жасағым келеді
Dialogue: 0,0:13:25.80,0:13:27.43,Default,,0,0,0,,Менің шақыруымды қабыл алыңыз
Dialogue: 0,0:13:27.64,0:13:30.30,Default,,0,0,0,,Мен бұл сезімді толық түсінемін.
Dialogue: 0,0:13:30.39,0:13:32.52,Default,,0,0,0,,Матчты күте алмайсыз ба?
Dialogue: 0,0:13:32.89,0:13:34.35,Default,,0,0,0,,Жарайсыңдар! Қанекей мынаны істейік!
Dialogue: 0,0:13:34.43,0:13:36.39,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:13:36.56,0:13:37.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:37.77,0:13:40.06,Default,,0,0,0,,Мен сенің не ойлап тұрғаныңды түсінбеймін
Dialogue: 0,0:13:40.15,0:13:42.27,Default,,0,0,0,,Біз ақымақ емеспіз.
Dialogue: 0,0:13:42.36,0:13:43.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:43.40,0:13:45.15,Default,,0,0,0,,Бір жасушалы Балтықтан басқа
Dialogue: 0,0:13:45.24,0:13:46.90,Default,,0,0,0,,Бір ұяшық дегеніміз не?
Dialogue: 0,0:13:46.99,0:13:48.49,Default,,0,0,0,,Ақымақ болу
Dialogue: 0,0:13:49.62,0:13:51.74,Default,,0,0,0,,Мына жігіт сенімен ұрыспас бұрын
Dialogue: 0,0:13:51.83,0:13:54.33,Default,,0,0,0,,Мен сенің әлсіз жеріңді табуға келдім.
Dialogue: 0,0:13:54.41,0:13:56.66,Default,,0,0,0,,Эй, Хоудзи, солай деп ойлаймын.
Dialogue: 0,0:13:57.00,0:14:00.21,Default,,0,0,0,,Немесе ол Балтқа психологиялық соғыс жүргізбек болды ма?
Dialogue: 0,0:14:00.29,0:14:02.96,Default,,0,0,0,,Әй, Динаның бұрын істегені.
Dialogue: 0,0:14:03.05,0:14:04.30,Default,,0,0,0,,Ято-сама!
Dialogue: 0,0:14:06.42,0:14:07.38,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:14:09.59,0:14:11.93,Default,,0,0,0,,Бір минут күтіңіз! а?
Dialogue: 0,0:14:12.26,0:14:12.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:16.89,0:14:19.81,Default,,0,0,0,,Бұл шайқасты мен сатып аламын...
Dialogue: 0,0:14:21.15,0:14:24.53,Default,,0,0,0,,Мен басқа адамға қамқор боламын. (Рантаро) Мен онымен айналысамын.
Dialogue: 0,0:14:26.82,0:14:29.36,Default,,0,0,0,,Сіз қайсысын таңдар едіңіз? Сіз шешесіз
Dialogue: 0,0:14:32.78,0:14:34.37,Default,,0,0,0,,Жарайды, жасайық.
Dialogue: 0,0:14:36.70,0:14:39.83,Default,,0,0,0,,Ку~ Неге Дина?
Dialogue: 0,0:14:39.92,0:14:42.38,Default,,0,0,0,,Сіздің Рагнарук пен Хорсуд
Dialogue: 0,0:14:42.46,0:14:44.25,Default,,0,0,0,,Бірдей төзімділік түрі
Dialogue: 0,0:14:44.34,0:14:46.96,Default,,0,0,0,,Deathsizer - шабуыл түрі, солай ма?
Dialogue: 0,0:14:47.88,0:14:49.76,Default,,0,0,0,,Менің Валькириім сияқты
Dialogue: 0,0:14:50.22,0:14:52.93,Default,,0,0,0,,Егер сіз Балтомен күресуді ойласаңыз,
Dialogue: 0,0:14:53.01,0:14:55.56,Default,,0,0,0,,Шабуыл түрін таңдау табиғи нәрсе.
Dialogue: 0,0:14:56.31,0:15:00.10,Default,,0,0,0,,Дина меннен күшті деп ойлағандықтан емес, солай ма?
Dialogue: 0,0:15:00.19,0:15:01.19,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:15:01.27,0:15:02.61,Default,,0,0,0,,Иә, түсінемін, түсінемін.
Dialogue: 0,0:15:02.69,0:15:03.81,Default,,0,0,0,,Олай болса мені кешір
Dialogue: 0,0:15:04.61,0:15:06.23,Default,,0,0,0,,Мен төреші боламын.
Dialogue: 0,0:15:07.32,0:15:09.07,Default,,0,0,0,,Бірінші шайқас!
Dialogue: 0,0:15:11.16,0:15:12.91,Default,,0,0,0,,Бұл ұзын орағыш па?
Dialogue: 0,0:15:12.99,0:15:16.33,Default,,0,0,0,,Оны меңгеру үшін күшті күш керек.
Dialogue: 0,0:15:16.41,0:15:17.70,Default,,0,0,0,,Қуаты қанша?
Dialogue: 0,0:15:17.79,0:15:19.83,Default,,0,0,0,,Мен саған көзім ашылып қарап тұрмын.
Dialogue: 0,0:15:20.25,0:15:22.21,Default,,0,0,0,,Аман қалсаң
Dialogue: 0,0:15:22.29,0:15:25.09,Default,,0,0,0,,Хоудзи - мен төбелесуім керек адам.
Dialogue: 0,0:15:26.30,0:15:28.84,Default,,0,0,0,,Мен сенімен осында күресе алатыныма қуаныштымын.
Dialogue: 0,0:15:30.22,0:15:32.22,Default,,0,0,0,,Қараңғы өлім өлшемі
Dialogue: 0,0:15:32.30,0:15:35.39,Default,,0,0,0,,Валькиридің күшімен салыстыруға болатын би.
Dialogue: 0,0:15:36.43,0:15:38.22,Default,,0,0,0,,Қарсы тарап үшін кемшілік жоқ.
Dialogue: 0,0:15:39.18,0:15:41.27,Default,,0,0,0,,Мұқият қара, Балто.
Dialogue: 0,0:15:41.73,0:15:44.86,Default,,0,0,0,,Өлім Сізердің шайқасы Бұл сіздің күшіңіз болуы керек.
Dialogue: 0,0:15:44.94,0:15:46.32,Default,,0,0,0,,Не?
Dialogue: 0,0:15:47.90,0:15:49.82,Default,,0,0,0,,Саған бәрібір емес пе?
Dialogue: 0,0:15:49.90,0:15:51.20,Default,,0,0,0,,Балтоға ұқсайды.
Dialogue: 0,0:15:51.74,0:15:53.24,Default,,0,0,0,,Өзім үшін де
Dialogue: 0,0:15:53.32,0:15:54.82,Default,,0,0,0,,Осы ойынды ұтып ал
Dialogue: 0,0:15:54.91,0:15:56.70,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:15:57.16,0:16:00.62,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:16:01.08,0:16:02.71,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:16:08.59,0:16:09.80,Default,,0,0,0,,Не?
Dialogue: 0,0:16:10.76,0:16:12.76,Default,,0,0,0,,Тырнақ жүргізуші!
Dialogue: 0,0:16:12.84,0:16:14.64,Default,,0,0,0,,Төрт жұмыс тырнақтары
Dialogue: 0,0:16:14.72,0:16:16.39,Default,,0,0,0,,Орталықтан тепкіш күшті тудырыңыз
Dialogue: 0,0:16:16.47,0:16:17.81,Default,,0,0,0,,Керемет~
Dialogue: 0,0:16:19.39,0:16:22.56,Default,,0,0,0,,Өлім Сізер Өлім құдайының орағымен кесіңіз!
Dialogue: 0,0:16:24.06,0:16:24.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:24.69,0:16:26.15,Default,,0,0,0,,Сіз шабуылдан құтылдыңыз ба?
Dialogue: 0,0:16:26.65,0:16:29.11,Default,,0,0,0,,Шайқас енді басталады. Жүр, өлімші!
Dialogue: 0,0:16:31.44,0:16:32.95,Default,,0,0,0,,Ұш, Хорсуд!
Dialogue: 0,0:16:36.03,0:16:39.03,Default,,0,0,0,,Өлім Сізердің шыдамдылығы таусылады.
Dialogue: 0,0:16:39.12,0:16:40.33,Default,,0,0,0,,Күте тұрыңыз
Dialogue: 0,0:16:43.83,0:16:45.54,Default,,0,0,0,,Мен бұл матчты алдым!
Dialogue: 0,0:16:46.21,0:16:47.88,Default,,0,0,0,,Шабуыл жасауды жалғастырыңыз!
Dialogue: 0,0:16:48.50,0:16:50.34,Default,,0,0,0,,Сіз өлмейтін болуыңыз керек!
Dialogue: 0,0:16:50.96,0:16:53.34,Default,,0,0,0,,Хорсуд өрісі!
Dialogue: 0,0:16:59.56,0:17:00.89,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:17:01.93,0:17:03.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:04.52,0:17:05.81,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:17:05.89,0:17:07.52,Default,,0,0,0,,Кескінмен
Dialogue: 0,0:17:07.60,0:17:08.94,Default,,0,0,0,,Хорсудтың жеңісі
Dialogue: 0,0:17:09.61,0:17:11.03,Default,,0,0,0,,Өлім өлшемі
Dialogue: 0,0:17:11.11,0:17:12.19,Default,,0,0,0,,Жоғалған
Dialogue: 0,0:17:15.40,0:17:17.03,Default,,0,0,0,,Сен мықтысың, жігітім.
Dialogue: 0,0:17:17.32,0:17:19.49,Default,,0,0,0,,Сіздің өлім өлшеміңіз де.
Dialogue: 0,0:17:21.49,0:17:23.08,Default,,0,0,0,,Мен келесі жолы жеңілмеймін
Dialogue: 0,0:17:25.71,0:17:29.00,Default,,0,0,0,,Хорсуд алаңы Бұл таңғажайып техника болды.
Dialogue: 0,0:17:29.54,0:17:32.59,Default,,0,0,0,,Өйткені ол ұзын орағышты пайдалануды білетін жігіт
Dialogue: 0,0:17:32.67,0:17:33.63,Default,,0,0,0,,Бұл орындауға болатын әдіс.
Dialogue: 0,0:17:33.71,0:17:35.97,Default,,0,0,0,,Керемет~ Керемет
Dialogue: 0,0:17:36.05,0:17:39.72,Default,,0,0,0,,Мен онымен шайқасқа барған сайын қызығамын.
Dialogue: 0,0:17:40.68,0:17:41.97,Default,,0,0,0,,Жарайсыңдар бәріңе.
Dialogue: 0,0:17:42.06,0:17:44.18,Default,,0,0,0,,Жаттығу жасайық! Жаттығу!
Dialogue: 0,0:17:44.35,0:17:45.64,Default,,0,0,0,,Бал-нии~!
Dialogue: 0,0:17:45.98,0:17:47.19,Default,,0,0,0,,өте қиын
Dialogue: 0,0:17:47.27,0:17:48.94,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:17:49.35,0:17:50.44,Default,,0,0,0,,Не болды?
Dialogue: 0,0:17:50.52,0:17:52.19,Default,,0,0,0,,Хоудзи...
Dialogue: 0,0:17:59.41,0:18:00.78,Default,,0,0,0,,Ботчан
Dialogue: 0,0:18:01.62,0:18:02.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:02.49,0:18:03.12,Default,,0,0,0,,Не?
Dialogue: 0,0:18:05.79,0:18:08.12,Default,,0,0,0,,Егер сізде бір іс болса, мені кейінірек қалдырыңыз.
Dialogue: 0,0:18:13.80,0:18:15.09,Default,,0,0,0,,Мен...
Dialogue: 0,0:18:15.17,0:18:16.34,Default,,0,0,0,,Мен келесі ойынды ойнамаймын.
Dialogue: 0,0:18:17.38,0:18:18.34,Default,,0,0,0,,Не?
Dialogue: 0,0:18:18.55,0:18:19.97,Default,,0,0,0,,Енді ше?
Dialogue: 0,0:18:21.05,0:18:23.31,Default,,0,0,0,,Матчты жеңу
Dialogue: 0,0:18:23.39,0:18:25.56,Default,,0,0,0,,Мен енді Бей ойнамаймын.
Dialogue: 0,0:18:25.89,0:18:27.73,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:18:28.06,0:18:30.98,Default,,0,0,0,,(Жүгірген аяқ дыбысы)
Dialogue: 0,0:18:31.06,0:18:32.73,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:18:32.82,0:18:35.48,Default,,0,0,0,,Матчтан бас тартпаңыз.
Dialogue: 0,0:18:35.57,0:18:37.86,Default,,0,0,0,,Келесі матч, менімен шындап күрес!
Dialogue: 0,0:18:38.45,0:18:40.45,Default,,0,0,0,,Сіздің Хорсуд өрісіңіз
Dialogue: 0,0:18:40.53,0:18:42.24,Default,,0,0,0,,Мен оны міндетті түрде бұзамын!
Dialogue: 0,0:18:44.24,0:18:45.41,Default,,0,0,0,,Жарайды, Вакия.
Dialogue: 0,0:18:45.99,0:18:47.66,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:18:47.75,0:18:49.37,Default,,0,0,0,,Жеңіңіз және сізбен күресіңіз
Dialogue: 0,0:18:50.12,0:18:52.84,Default,,0,0,0,,Сондықтан Хоудзиге оғаш бұйрық берме.
Dialogue: 0,0:18:53.67,0:18:55.13,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:18:55.59,0:18:59.05,Default,,0,0,0,,Менімен шайқаста жеңіске жетудің қажеті жоқ деді.
Dialogue: 0,0:18:59.13,0:19:00.13,Default,,0,0,0,,Бірақ Хоудзи
Dialogue: 0,0:19:00.22,0:19:03.26,Default,,0,0,0,,Сіз маған ауыр төбелеске келгеніңіз үшін келдіңіз.
Dialogue: 0,0:19:03.35,0:19:05.06,Default,,0,0,0,,Дұрыс па? Хоудзи
Dialogue: 0,0:19:05.39,0:19:05.97,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:07.98,0:19:09.39,Default,,0,0,0,,Бірдеңе айт!
Dialogue: 0,0:19:12.44,0:19:13.69,Default,,0,0,0,,(Деку) Иә. (Яо) Жарайды.
Dialogue: 0,0:19:14.06,0:19:17.19,Default,,0,0,0,,Хоудзи сен де жылдамсың.
Dialogue: 0,0:19:17.28,0:19:19.40,Default,,0,0,0,,Сен ақымақсың ба, әлде шын айтасың ба?
Dialogue: 0,0:19:19.90,0:19:21.28,Default,,0,0,0,,Хоудзи және сіз де
Dialogue: 0,0:19:21.36,0:19:23.74,Default,,0,0,0,,Менің айтқанымды дұрыс түсінбе
Dialogue: 0,0:19:23.99,0:19:24.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:24.91,0:19:26.41,Default,,0,0,0,,Келесі сәйкестік
Dialogue: 0,0:19:26.49,0:19:28.62,Default,,0,0,0,,Әрине Хоудзи жеңеді.
Dialogue: 0,0:19:28.70,0:19:32.12,Default,,0,0,0,,Жартылай финал достар арасындағы тартыс болады.
Dialogue: 0,0:19:32.92,0:19:35.17,Default,,0,0,0,,Егер сіз мұны істесеңіз, бұл қызық емес.
Dialogue: 0,0:19:35.25,0:19:38.17,Default,,0,0,0,,Ендеше, тентекті жеңген дұрыс, солай дедім.
Dialogue: 0,0:19:38.51,0:19:39.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:39.76,0:19:40.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:41.05,0:19:41.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:42.05,0:19:45.47,Default,,0,0,0,,Хоудзи - Ваймен ұзақ уақыт жаттығатын адам.
Dialogue: 0,0:19:45.55,0:19:47.26,Default,,0,0,0,,Бұл устрицадан кейінгі ең күшті.
Dialogue: 0,0:19:47.76,0:19:50.14,Default,,0,0,0,,Менің сенен ұтылуым мүмкін емес.
Dialogue: 0,0:19:51.44,0:19:52.48,Default,,0,0,0,,Ботчан
Dialogue: 0,0:19:53.40,0:19:56.06,Default,,0,0,0,,Сіз мұны түсіндіңіз бе?
Dialogue: 0,0:20:00.49,0:20:02.28,Default,,0,0,0,,Бала, мен...
Dialogue: 0,0:20:02.36,0:20:03.16,Default,,0,0,0,,Мен!
Dialogue: 0,0:20:03.78,0:20:05.45,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:20:05.82,0:20:07.12,Default,,0,0,0,,Келесі сәйкестік
Dialogue: 0,0:20:07.58,0:20:08.87,Default,,0,0,0,,Егер мен жеңсем
Dialogue: 0,0:20:09.66,0:20:11.50,Default,,0,0,0,,Ботчанның ауыр шайқасы
Dialogue: 0,0:20:11.71,0:20:13.04,Default,,0,0,0,,Осы Хорсуда
Dialogue: 0,0:20:13.12,0:20:14.58,Default,,0,0,0,,Мен оны көре аламын ба?
Dialogue: 0,0:20:15.17,0:20:15.92,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:16.21,0:20:17.42,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:20:17.50,0:20:19.67,Default,,0,0,0,,Мен саған өзімнің шынайы болмысымды көрсеттім.
Dialogue: 0,0:20:20.26,0:20:21.63,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:22.55,0:20:23.30,Default,,0,0,0,,Е...
Dialogue: 0,0:20:23.80,0:20:25.14,Default,,0,0,0,,Бұл не өзі?
Dialogue: 0,0:20:25.59,0:20:26.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:28.10,0:20:30.14,Default,,0,0,0,,Балтоның алдағы матчы
Dialogue: 0,0:20:30.22,0:20:31.73,Default,,0,0,0,,Маған жеңуге рұқсат етіңіз
Dialogue: 0,0:20:33.23,0:20:35.10,Default,,0,0,0,,Тіпті мен міндетті түрде жеңемін.
Dialogue: 0,0:20:35.52,0:20:37.31,Default,,0,0,0,,Мен матчты асыға күтемін.
Dialogue: 0,0:20:37.52,0:20:38.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:39.86,0:20:40.53,Default,,0,0,0,,О
Dialogue: 0,0:20:40.61,0:20:42.28,Default,,0,0,0,,Мен де жаттығамын!
Dialogue: 0,0:20:43.78,0:20:46.24,Default,,0,0,0,,Не? Мен жеңілуге ​​шыдай алмаймын!
Dialogue: 0,0:20:46.32,0:20:47.62,Default,,0,0,0,,Бұл жер жеке резервке қойылған!
Dialogue: 0,0:20:47.70,0:20:49.03,Default,,0,0,0,,Маңызды емес!
Dialogue: 0,0:20:49.49,0:20:51.08,Default,,0,0,0,,Менің тәжірибемді бұзба!
Dialogue: 0,0:20:51.16,0:20:52.83,Default,,0,0,0,,Мен сені мазаламаймын!
Dialogue: 0,0:20:52.91,0:20:54.41,Default,,0,0,0,,Өте жақын! Мені қалдырма!
Dialogue: 0,0:20:54.50,0:20:57.54,Default,,0,0,0,,Сіз кетейін бе?
Dialogue: 0,0:20:58.42,0:21:01.96,Default,,0,0,0,,Вакия өте жылдам.
Dialogue: 0,0:21:02.30,0:21:05.68,Default,,0,0,0,,Жарыста Балто ешқашан жеңілмейді.
Dialogue: 0,0:21:05.76,0:21:08.89,Default,,0,0,0,,Ол да мен сияқты жылдам.
Dialogue: 0,0:21:08.97,0:21:12.02,Default,,0,0,0,,Жаяу жылдамдығының шығанаққа қатысы жоқ, солай ма?
Dialogue: 0,0:21:12.35,0:21:14.06,Default,,0,0,0,,Міндетті емес.
Dialogue: 0,0:21:14.14,0:21:15.77,Default,,0,0,0,,(Джозеф Джоэстар) Бақытына орай, Авдолдың мойнындағы жара маңызды нүктеден тыс қалған, сондықтан—
Dialogue: 0,0:21:15.85,0:21:17.65,Default,,0,0,0,,Тек күшті аяқтар мен жамбаспен
Dialogue: 0,0:21:17.73,0:21:20.32,Default,,0,0,0,,Шығанақты ату қуатты тудырады, солай емес пе?
Dialogue: 0,0:21:20.40,0:21:21.53,Default,,0,0,0,,Расында!
Dialogue: 0,0:21:22.57,0:21:24.36,Default,,0,0,0,,Аяқ күші...
Dialogue: 0,0:21:24.44,0:21:25.86,Default,,0,0,0,,Сондықтан Уақия деген балалар бар.
Dialogue: 0,0:21:26.15,0:21:28.16,Default,,0,0,0,,Күн сайын жүгіру
Dialogue: 0,0:21:28.70,0:21:30.12,Default,,0,0,0,,Мен жаттығып жатырмын.
Dialogue: 0,0:21:30.49,0:21:32.83,Default,,0,0,0,,Түсіндім, сіз жаттығудасыз ба?
Dialogue: 0,0:21:32.91,0:21:33.58,Default,,0,0,0,,Аха…
Dialogue: 0,0:21:33.66,0:21:34.91,Default,,0,0,0,,Мен түсінемін...
Dialogue: 0,0:21:35.37,0:21:36.29,Default,,0,0,0,,Йоши
Dialogue: 0,0:21:36.67,0:21:40.25,Default,,0,0,0,,Ертеңнен бастап, жоқ, бүгіннен бастап мен күнде жүгіретін боламын.
Dialogue: 0,0:21:40.34,0:21:43.92,Default,,0,0,0,,Флеш түсіруді аяқтаймыз!
Dialogue: 0,0:21:44.63,0:21:45.84,Default,,0,0,0,,тым кеш!
Dialogue: 0,0:21:45.92,0:21:46.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:47.05,0:21:49.09,Default,,0,0,0,,Олай болса, үйге жүгір!
Dialogue: 0,0:21:49.18,0:21:50.80,Default,,0,0,0,,Үй ішінде де жасама!
Dialogue: 0,0:21:50.89,0:21:53.52,Default,,0,0,0,,Ех~ Жаттығу~!
Dialogue: 0,0:21:53.60,0:21:55.27,Default,,0,0,0,,Балтоның уақыты келді!
Dialogue: 0,0:22:09.16,0:22:15.25,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.45,0:22:21.59,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады
Dialogue: 0,0:22:22.04,0:22:27.59,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.05,0:22:31.39,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.55,0:22:36.48,Default,,0,0,0,,Сіз енді ешқашан жоғалмайсыз
Dialogue: 0,0:22:38.39,0:22:41.10,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.19,0:22:44.40,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.48,0:22:50.82,Default,,0,0,0,,Артынан қусаң да көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:51.07,0:22:56.62,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.79,0:23:03.38,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:03.96,0:23:09.38,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.55,0:23:12.72,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.22,0:23:17.18,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.73,0:23:29.95,Default,,0,0,0,,Хоудзидің Қасиетті Хорсуды өте күшті!
Dialogue: 0,0:23:30.03,0:23:33.24,Default,,0,0,0,,Бірақ егер сіз күшті қарсыласпен бетпе-бет шыға аламын деп ойласаңыз,
Dialogue: 0,0:23:33.32,0:23:35.20,Default,,0,0,0,,Бұл қызықты.
Dialogue: 0,0:23:35.28,0:23:37.54,Default,,0,0,0,,Валькирияның жаңа ерекше қозғалысы
Dialogue: 0,0:23:37.62,0:23:39.58,Default,,0,0,0,,Мен міндетті түрде орындаймын!
Dialogue: 0,0:23:40.04,0:23:42.29,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:42.37,0:23:44.88,Default,,0,0,0,,Қаһарлы жау! Аспандағы Хорсуд!
Dialogue: 0,0:23:44.96,0:23:47.25,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:23:47.34,0:23:48.92,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.42,0:23:56.42,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory