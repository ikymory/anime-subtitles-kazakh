Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.21,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.30,0:00:12.47,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.88,0:00:14.72,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.80,0:00:16.89,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:16.97,0:00:18.85,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.52,0:00:24.35,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.44,0:00:26.27,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.35,0:00:28.77,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.94,0:00:34.61,Default,,0,0,0,,Біздің Бейблейд клубы
Dialogue: 0,0:00:34.70,0:00:36.28,Default,,0,0,0,,Кумичо мен Дина Инусуке
Dialogue: 0,0:00:36.36,0:00:38.20,Default,,0,0,0,,Әркім қолынан келгенін жасайды
Dialogue: 0,0:00:38.28,0:00:40.33,Default,,0,0,0,,Аххххххххх!
Dialogue: 0,0:00:40.66,0:00:41.33,Default,,0,0,0,,Хех, хех
Dialogue: 0,0:00:41.41,0:00:44.12,Default,,0,0,0,,Алайда әлі де бір адам із-түзсіз жоғалған.
Dialogue: 0,0:00:44.21,0:00:47.08,Default,,0,0,0,,Бұл әлі де "уақытша клуб".
Dialogue: 0,0:00:47.17,0:00:48.33,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:00:48.42,0:00:52.17,Default,,0,0,0,,Бейбатл... бұл зерттеу деп аталады ма?
Dialogue: 0,0:00:52.26,0:00:53.34,Default,,0,0,0,,Орындаңыз
Dialogue: 0,0:00:53.42,0:00:56.26,Default,,0,0,0,,Бәріміз бірге күшті болайық
Dialogue: 0,0:00:56.34,0:00:56.97,Default,,0,0,0,,Әй!
Dialogue: 0,0:00:57.97,0:01:00.22,Default,,0,0,0,,Ұйықтама!
Dialogue: 0,0:01:01.64,0:01:04.14,Default,,0,0,0,,Жарайсыңдар!
Dialogue: 0,0:01:04.85,0:01:07.19,Default,,0,0,0,,Бар, жүр! Жақсы, Валькири
Dialogue: 0,0:01:07.40,0:01:08.81,Default,,0,0,0,,Ах! Жақсы!
Dialogue: 0,0:01:11.32,0:01:13.28,Default,,0,0,0,,Аудандық конференция да.
Dialogue: 0,0:01:13.94,0:01:16.57,Default,,0,0,0,,Төртінші раундтың уақыты келді.
Dialogue: 0,0:01:25.75,0:01:28.12,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:28.46,0:01:33.63,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:44.93,0:01:48.31,Default,,0,0,0,,Мен барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:48.81,0:01:50.94,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:51.36,0:01:55.49,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:55.61,0:01:58.82,Default,,0,0,0,,Дұрыс, сіздің жүзіңіздегі өрнек
Dialogue: 0,0:01:58.95,0:02:05.37,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:05.66,0:02:10.08,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:10.58,0:02:16.01,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:16.13,0:02:18.38,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:18.47,0:02:23.18,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:23.35,0:02:28.43,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:28.73,0:02:30.98,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:31.19,0:02:33.52,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:33.82,0:02:37.74,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:37.90,0:02:42.91,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:43.12,0:02:45.29,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:48.91,0:02:51.92,Default,,0,0,0,,Қаһарлы жау! Аспандағы Хорсуд!
Dialogue: 0,0:02:53.59,0:02:56.38,Default,,0,0,0,,Жақында wbba демеушілігімен шығады
Dialogue: 0,0:02:56.46,0:02:59.26,Default,,0,0,0,,Йонекома аудандық турнирінің төртінші кезеңі басталады.
Dialogue: 0,0:02:59.59,0:03:01.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:03:01.72,0:03:03.64,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:03:04.43,0:03:06.18,Default,,0,0,0,,Сіз жақсы көрінесіз.
Dialogue: 0,0:03:06.26,0:03:07.81,Default,,0,0,0,,О! Бұл тамаша
Dialogue: 0,0:03:08.77,0:03:09.81,Default,,0,0,0,,Мен де
Dialogue: 0,0:03:10.31,0:03:12.40,Default,,0,0,0,,Әйтпесе қызық болмас еді.
Dialogue: 0,0:03:12.73,0:03:13.65,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:03:13.73,0:03:15.32,Default,,0,0,0,,Жақында сізді шақырады.
Dialogue: 0,0:03:15.94,0:03:18.03,Default,,0,0,0,,Сіз кіреберісте күте аласыз ба?
Dialogue: 0,0:03:18.23,0:03:19.82,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:22.32,0:03:23.11,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:23.20,0:03:25.91,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар!
Dialogue: 0,0:03:25.99,0:03:27.37,Default,,0,0,0,,1-ші блок ойыны
Dialogue: 0,0:03:27.45,0:03:31.37,Default,,0,0,0,,Хоудзи Конта мен Барто Аои осында!
Dialogue: 0,0:03:31.46,0:03:34.63,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:03:35.88,0:03:36.92,Default,,0,0,0,,Бар-нии!
Dialogue: 0,0:03:37.00,0:03:38.42,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:03:38.50,0:03:39.84,Default,,0,0,0,,Сөзсіз жеңіңіз!
Dialogue: 0,0:03:39.92,0:03:40.63,Default,,0,0,0,,О!
Dialogue: 0,0:03:40.72,0:03:42.05,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:03:42.13,0:03:43.18,Default,,0,0,0,,Өте қатерлі ісік...
Dialogue: 0,0:03:43.30,0:03:44.51,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:03:44.59,0:03:45.55,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:45.64,0:03:46.85,Default,,0,0,0,,Барзе~
Dialogue: 0,0:03:46.93,0:03:47.76,Default,,0,0,0,,Мен өлсем бола ма?
Dialogue: 0,0:03:48.06,0:03:53.02,Default,,0,0,0,,Жеңіс Валькирия VS Қасиетті Хорсуд шайқасы
Dialogue: 0,0:03:53.10,0:03:54.85,Default,,0,0,0,,Жақында
Dialogue: 0,0:03:57.11,0:03:59.90,Default,,0,0,0,,Мен сіздің үміттеріңізді ақтаймын.
Dialogue: 0,0:04:00.94,0:04:03.11,Default,,0,0,0,,Аяқтау Айналдыру
Dialogue: 0,0:04:03.20,0:04:04.61,Default,,0,0,0,,1 ұпай
Dialogue: 0,0:04:04.70,0:04:06.57,Default,,0,0,0,,Жедел мәре – 2 ұпай
Dialogue: 0,0:04:06.99,0:04:09.45,Default,,0,0,0,,Кім 2 ұпай алса, сол жеңеді.
Dialogue: 0,0:04:12.08,0:04:14.00,Default,,0,0,0,,Жабайы жүрейік!
Dialogue: 0,0:04:14.08,0:04:14.96,Default,,0,0,0,,Дос
Dialogue: 0,0:04:16.21,0:04:17.58,Default,,0,0,0,,Хоудзи кеттік
Dialogue: 0,0:04:18.04,0:04:19.96,Default,,0,0,0,,О, келші, Балто.
Dialogue: 0,0:04:22.22,0:04:24.63,Default,,0,0,0,,Барто Аои қолдарын айналдыру
Dialogue: 0,0:04:24.72,0:04:26.64,Default,,0,0,0,,Менің рухым жетеді
Dialogue: 0,0:04:28.05,0:04:30.52,Default,,0,0,0,,Ал қолында ұзын орауыш бар
Dialogue: 0,0:04:30.60,0:04:32.68,Default,,0,0,0,,Хоудзи Конта да отты.
Dialogue: 0,0:04:33.69,0:04:36.10,Default,,0,0,0,,Енді ол қандай шайқас болады?
Dialogue: 0,0:04:36.44,0:04:38.31,Default,,0,0,0,,Бұл қызық болады.
Dialogue: 0,0:04:40.48,0:04:41.61,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:04:44.15,0:04:48.07,Default,,0,0,0,,Хоудзи Хорсуд өрісін шығаруы керек.
Dialogue: 0,0:04:48.16,0:04:51.33,Default,,0,0,0,,Dyna's Death Sizer-ді жарып жіберген техника
Dialogue: 0,0:04:51.41,0:04:52.95,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:04:55.87,0:04:58.21,Default,,0,0,0,,Сіз бұл әдіспен жарыса аласыз.
Dialogue: 0,0:04:59.04,0:05:02.30,Default,,0,0,0,,Мен бір нәрсеге көңілім көтеріліп жатыр.
Dialogue: 0,0:05:03.05,0:05:05.68,Default,,0,0,0,,Не, ол күліп жатыр ма?
Dialogue: 0,0:05:05.76,0:05:07.34,Default,,0,0,0,,Сіз кірген кезде ол бұзылады.
Dialogue: 0,0:05:07.43,0:05:09.10,Default,,0,0,0,,Жүйкесін сезбейтін жігіт.
Dialogue: 0,0:05:09.18,0:05:11.89,Default,,0,0,0,,Бұл шайқаста Хоудзи-сан жеңеді.
Dialogue: 0,0:05:12.93,0:05:15.31,Default,,0,0,0,,Балто... Мен сенемін
Dialogue: 0,0:05:15.39,0:05:18.48,Default,,0,0,0,,Сіз күліп тұрғаныңызды да сезбейтін шығарсыз.
Dialogue: 0,0:05:18.94,0:05:22.32,Default,,0,0,0,,Бірақ мен бұл күлкіні үрлеймін.
Dialogue: 0,0:05:22.40,0:05:25.07,Default,,0,0,0,,Хоудзидің қолы өзгерді.
Dialogue: 0,0:05:25.15,0:05:26.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:26.36,0:05:28.11,Default,,0,0,0,,Бұл басқа нәрсе ме?
Dialogue: 0,0:05:28.20,0:05:29.87,Default,,0,0,0,,Қолмен ұстау
Dialogue: 0,0:05:30.12,0:05:32.91,Default,,0,0,0,,Бұл бақылауды баса көрсететін ұстағыш.
Dialogue: 0,0:05:33.41,0:05:36.41,Default,,0,0,0,,Хоудзиден келген жігіт өте сақ емес пе?
Dialogue: 0,0:05:37.25,0:05:39.46,Default,,0,0,0,,Жеңіске жеткен адам.
Dialogue: 0,0:05:39.54,0:05:42.17,Default,,0,0,0,,Ондай адамнан сақтануға болмайды.
Dialogue: 0,0:05:42.84,0:05:44.55,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:05:46.59,0:05:49.93,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:05:50.26,0:05:52.68,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:56.23,0:05:57.69,Default,,0,0,0,,Ұш, Хорсуд!
Dialogue: 0,0:05:57.89,0:06:00.10,Default,,0,0,0,,Төрт тырнақ ашылды
Dialogue: 0,0:06:00.31,0:06:04.07,Default,,0,0,0,,Күнге қарай ұшқан аңызға айналған құстай.
Dialogue: 0,0:06:04.69,0:06:06.78,Default,,0,0,0,,Және барлығы бірден орталыққа
Dialogue: 0,0:06:07.24,0:06:09.11,Default,,0,0,0,,Валькири тістеп алды!
Dialogue: 0,0:06:12.58,0:06:15.66,Default,,0,0,0,,Валькиридің шұғыл шабуылы!
Dialogue: 0,0:06:15.75,0:06:18.62,Default,,0,0,0,,Жаңа ғана Хорсудоны жарып жіберді!
Dialogue: 0,0:06:19.42,0:06:22.00,Default,,0,0,0,,Валькиридің шапшаң соққысы
Dialogue: 0,0:06:22.09,0:06:23.13,Default,,0,0,0,,Тоқтамаңыз!
Dialogue: 0,0:06:23.21,0:06:24.67,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:25.00,0:06:25.88,Default,,0,0,0,,Шабуыл жасай беріңіз!
Dialogue: 0,0:06:25.96,0:06:27.09,Default,,0,0,0,,Жарайсың, Бал-нии!
Dialogue: 0,0:06:27.17,0:06:27.97,Default,,0,0,0,,Керемет!
Dialogue: 0,0:06:29.72,0:06:31.39,Default,,0,0,0,,Хорсуд өрісі
Dialogue: 0,0:06:31.47,0:06:33.01,Default,,0,0,0,,Енді шайқас келді.
Dialogue: 0,0:06:38.43,0:06:39.48,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:06:41.35,0:06:42.86,Default,,0,0,0,,Не!
Dialogue: 0,0:06:42.94,0:06:45.90,Default,,0,0,0,,Хорсуд өрісі өзінің шынайы әлеуетін көрсетті!
Dialogue: 0,0:06:46.36,0:06:47.07,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:47.61,0:06:50.61,Default,,0,0,0,,Валькири артқа лақтырып, тайдырылды...
Dialogue: 0,0:06:50.70,0:06:53.49,Default,,0,0,0,,Ал... Тома... Тома... Тоқтады!
Dialogue: 0,0:06:53.57,0:06:56.12,Default,,0,0,0,,Бұл Қасиетті Хорсудтың күші!
Dialogue: 0,0:06:56.33,0:06:56.99,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:57.08,0:06:59.25,Default,,0,0,0,,Қасиетті Хорсудоның айналуы
Dialogue: 0,0:06:59.33,0:07:01.21,Default,,0,0,0,,Хоудзи Конта үшін 1 ұпай
Dialogue: 0,0:07:01.42,0:07:02.21,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:07:02.71,0:07:03.67,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:04.13,0:07:06.13,Default,,0,0,0,,Не істеп жатырсың, Балто?
Dialogue: 0,0:07:06.21,0:07:06.96,Default,,0,0,0,,Ах~
Dialogue: 0,0:07:07.05,0:07:08.05,Default,,0,0,0,,Ах… Аман-есен екеніңе қатты қуаныштымын.
Dialogue: 0,0:07:08.13,0:07:09.72,Default,,0,0,0,,Хорсуд өрісі?
Dialogue: 0,0:07:10.01,0:07:10.97,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:07:11.05,0:07:12.93,Default,,0,0,0,,Хоудзи керемет
Dialogue: 0,0:07:13.55,0:07:15.64,Default,,0,0,0,,Басқаруға баса назар аударатын ұстағышпен
Dialogue: 0,0:07:15.72,0:07:17.27,Default,,0,0,0,,Сіз міндетті түрде шешім қабылдадыңыз.
Dialogue: 0,0:07:17.93,0:07:19.64,Default,,0,0,0,,О... бұл дегеніміз
Dialogue: 0,0:07:20.02,0:07:22.65,Default,,0,0,0,,Бұл оның қуатты басатынын білдіре ме?
Dialogue: 0,0:07:22.73,0:07:24.06,Default,,0,0,0,,Аняро~
Dialogue: 0,0:07:25.73,0:07:30.49,Default,,0,0,0,,Шыдам таусылғанда асық ату – аянышты нәрсе.
Dialogue: 0,0:07:31.11,0:07:32.45,Default,,0,0,0,,Киодзи Арами
Dialogue: 0,0:07:32.53,0:07:33.49,Default,,0,0,0,,Иә
Dialogue: 0,0:07:33.57,0:07:37.03,Default,,0,0,0,,Бенишудың сенің атыңды есте қалдыруы үлкен мәртебе.
Dialogue: 0,0:07:38.12,0:07:40.16,Default,,0,0,0,,Қарсыласымның аты есімде.
Dialogue: 0,0:07:40.25,0:07:42.87,Default,,0,0,0,,Балт Яроумен жақсы дос болған дейді.
Dialogue: 0,0:07:42.96,0:07:44.75,Default,,0,0,0,,Маған көбірек қолдау көрсетуіңізді өтінемін
Dialogue: 0,0:07:45.13,0:07:45.88,Default,,0,0,0,,О
Dialogue: 0,0:07:45.96,0:07:47.84,Default,,0,0,0,,Мен жеңіліп жатқанымызды көрдім.
Dialogue: 0,0:07:48.46,0:07:49.59,Default,,0,0,0,,Адам сіріңкесінен
Dialogue: 0,0:07:49.67,0:07:52.05,Default,,0,0,0,,Сіз өзіңіздің ойыныңыз туралы алаңдауыңыз керек
Dialogue: 0,0:07:52.76,0:07:54.01,Default,,0,0,0,,Сіз де
Dialogue: 0,0:07:54.43,0:07:55.22,Default,,0,0,0,,Әй
Dialogue: 0,0:07:55.55,0:07:57.39,Default,,0,0,0,,Сіз мұны жасадыңыз, Хоудзи мырза.
Dialogue: 0,0:07:57.47,0:07:58.81,Default,,0,0,0,,1 ұпай алда
Dialogue: 0,0:07:58.89,0:08:01.68,Default,,0,0,0,,Келесісін алып, тез шешім қабылдайсыз ба?
Dialogue: 0,0:08:01.89,0:08:04.44,Default,,0,0,0,,Оның жеңуі табиғи нәрсе.
Dialogue: 0,0:08:05.23,0:08:07.15,Default,,0,0,0,,Мәселе қалай жеңуге болады.
Dialogue: 0,0:08:07.98,0:08:10.61,Default,,0,0,0,,Хоудзи! Немен ойнап жүрсің?
Dialogue: 0,0:08:10.69,0:08:13.61,Default,,0,0,0,,Сіз бір атумен осындай қарсыласты жарып жібере аласыз!
Dialogue: 0,0:08:16.16,0:08:18.37,Default,,0,0,0,,Хоудзи устрицадан кейінгі ең күшті.
Dialogue: 0,0:08:19.45,0:08:21.04,Default,,0,0,0,,Иә, кішкентай бала.
Dialogue: 0,0:08:21.12,0:08:23.41,Default,,0,0,0,,Келесі жолы мен оны жарылыспен орындаймын
Dialogue: 0,0:08:24.00,0:08:25.33,Default,,0,0,0,,Хоудзи!
Dialogue: 0,0:08:25.75,0:08:28.79,Default,,0,0,0,,Сіздің Хорсуд өрісіңіз керемет.
Dialogue: 0,0:08:29.25,0:08:32.76,Default,,0,0,0,,Менің шапшаң соққым жұмыс істемейтініне таң қалдым.
Dialogue: 0,0:08:33.26,0:08:34.55,Default,,0,0,0,,≫ Тап-тап-тап (аяқ дыбысы) (Ол Майт) Һм?
Dialogue: 0,0:08:34.63,0:08:36.59,Default,,0,0,0,,Сен неге бұрышта тұрсың?
Dialogue: 0,0:08:37.01,0:08:39.47,Default,,0,0,0,,Бірақ келесі жолы олай болмайды.
Dialogue: 0,0:08:39.55,0:08:42.93,Default,,0,0,0,,Екінші шайқаста
Dialogue: 0,0:08:43.02,0:08:44.02,Default,,0,0,0,,Оны қайтарыңыз!
Dialogue: 0,0:08:44.44,0:08:46.56,Default,,0,0,0,,Не, сен әлі күлесің бе?
Dialogue: 0,0:08:46.65,0:08:48.02,Default,,0,0,0,,Сіз бас тарттыңыз ба?
Dialogue: 0,0:08:48.11,0:08:50.48,Default,,0,0,0,,Әлде сен ақымақсың ба?
Dialogue: 0,0:08:51.44,0:08:52.99,Default,,0,0,0,,Ох…
Dialogue: 0,0:08:55.03,0:08:56.99,Default,,0,0,0,,Бал-нии, жақсысың ба?
Dialogue: 0,0:08:57.07,0:08:58.62,Default,,0,0,0,,Сәлем, Балто!
Dialogue: 0,0:08:58.74,0:09:00.12,Default,,0,0,0,,Уақыт жоқ.
Dialogue: 0,0:09:00.20,0:09:01.70,Default,,0,0,0,,Қызықтырақ болыңыз!
Dialogue: 0,0:09:02.04,0:09:03.29,Default,,0,0,0,,Ішінде!
Dialogue: 0,0:09:03.45,0:09:06.17,Default,,0,0,0,,Бұл орын алса, жаңа арнайы қозғалысты қолданыңыз!
Dialogue: 0,0:09:06.37,0:09:08.46,Default,,0,0,0,,Иә, бұл флеш түсіру.
Dialogue: 0,0:09:08.54,0:09:10.75,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:09:10.84,0:09:12.84,Default,,0,0,0,,Жаңа ерекше қозғалыстар бар ма?
Dialogue: 0,0:09:13.26,0:09:16.43,Default,,0,0,0,,Әлі толық аяқталмаған сияқты.
Dialogue: 0,0:09:16.51,0:09:18.47,Default,,0,0,0,,Біз бірдеңе күтетін сияқтымыз
Dialogue: 0,0:09:19.10,0:09:20.68,Default,,0,0,0,,Жарық түсіру…
Dialogue: 0,0:09:21.10,0:09:22.60,Default,,0,0,0,,Сіз мұны істейсіз бе? Балтық
Dialogue: 0,0:09:23.68,0:09:25.94,Default,,0,0,0,,Бұл жаңа ерекше қозғалыс па?
Dialogue: 0,0:09:28.73,0:09:30.23,Default,,0,0,0,,Сол кездегі техника ма?
Dialogue: 0,0:09:34.03,0:09:36.70,Default,,0,0,0,,Екінші шайқаста не істеу керек
Dialogue: 0,0:09:37.41,0:09:39.32,Default,,0,0,0,,Қалай жүгіргіңіз келеді?
Dialogue: 0,0:09:41.41,0:09:43.87,Default,,0,0,0,,Бұл стадионның сыртында.
Dialogue: 0,0:09:43.95,0:09:45.71,Default,,0,0,0,,Ол орбитада үлкен жылдамдықпен жүрді.
Dialogue: 0,0:09:46.37,0:09:47.83,Default,,0,0,0,,Қарсыласыңызды сыртқа итеріңіз
Dialogue: 0,0:09:47.92,0:09:50.00,Default,,0,0,0,,Сол жерде шабуылды жалғастыру техникасы
Dialogue: 0,0:09:51.17,0:09:53.96,Default,,0,0,0,,Бірақ қолдану техникасын білсеңіз
Dialogue: 0,0:09:54.05,0:09:55.38,Default,,0,0,0,,Қарсы шараларды қолдануға болады
Dialogue: 0,0:09:58.05,0:09:59.64,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:09:59.72,0:10:01.14,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:01.22,0:10:05.60,Default,,0,0,0,,Жүр, Аои Балт, жаңа ерекше қозғалыс бар сияқты.
Dialogue: 0,0:10:05.68,0:10:08.44,Default,,0,0,0,,Сонда сіз қарсы шығасыз ба? Әлде Хоудзи Конта ма?
Dialogue: 0,0:10:08.52,0:10:11.69,Default,,0,0,0,,Сіз матчты тура сеттерде шешесіз бе?
Dialogue: 0,0:10:12.02,0:10:14.82,Default,,0,0,0,,Бұл көруге болатын екінші шайқас!
Dialogue: 0,0:10:15.57,0:10:18.95,Default,,0,0,0,,Мен сені өзімнің ең жоғары және ең үлкен күшіммен атып жіберемін.
Dialogue: 0,0:10:20.11,0:10:21.03,Default,,0,0,0,,Хоудзи жігіті
Dialogue: 0,0:10:21.12,0:10:22.91,Default,,0,0,0,,Мен ұстамды қайтадан ауыстырдым.
Dialogue: 0,0:10:22.99,0:10:24.95,Default,,0,0,0,,Қолмен ұстау
Dialogue: 0,0:10:25.04,0:10:27.50,Default,,0,0,0,,Мен тезірек жүруді жоспарлап отырмын.
Dialogue: 0,0:10:28.08,0:10:29.62,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:10:29.96,0:10:31.71,Default,,0,0,0,,Досым, мен оны сұрадым.
Dialogue: 0,0:10:33.29,0:10:36.42,Default,,0,0,0,,Үш екі бір!
Dialogue: 0,0:10:36.80,0:10:39.76,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:40.64,0:10:45.43,Default,,0,0,0,,Хоудзи Конта ұзын орағышты күшті бұрылыспен тартып алады!
Dialogue: 0,0:10:45.64,0:10:46.52,Default,,0,0,0,,Не... не!
Dialogue: 0,0:10:46.60,0:10:48.81,Default,,0,0,0,,Мен оны стадионның сыртына тастадым!
Dialogue: 0,0:10:48.89,0:10:50.73,Default,,0,0,0,,Бұл таңқаларлық стратегия!
Dialogue: 0,0:10:50.81,0:10:52.73,Default,,0,0,0,,Барто Аои туралы не деуге болады?
Dialogue: 0,0:10:52.81,0:10:53.31,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:10:53.40,0:10:57.15,Default,,0,0,0,,Бұл асығыс ату! Мен тағы да шапшаң соққы жасадым!
Dialogue: 0,0:10:57.57,0:10:58.15,Default,,0,0,0,,Не?
Dialogue: 0,0:11:00.78,0:11:02.62,Default,,0,0,0,,Бұл флеш түсіру емес пе?
Dialogue: 0,0:11:02.82,0:11:05.28,Default,,0,0,0,,Бұл шапшаң атуға қатысты
Dialogue: 0,0:11:05.37,0:11:08.33,Default,,0,0,0,,Валькирияның алдында болуы тиіс Хорсуд жоқ.
Dialogue: 0,0:11:08.41,0:11:10.25,Default,,0,0,0,,Хоудзи Контаны толығымен оқыңыз
Dialogue: 0,0:11:10.33,0:11:12.54,Default,,0,0,0,,Валькири басқа адамды жоғалтты.
Dialogue: 0,0:11:12.63,0:11:13.75,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:11:13.83,0:11:14.67,Default,,0,0,0,,Алайда сол кезде теледидар станциясына асығып барған Учида мырзаның өлтірілуі,
Dialogue: 0,0:11:14.75,0:11:16.21,Default,,0,0,0,,Періштенің нұры
Dialogue: 0,0:11:16.30,0:11:17.30,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:11:17.38,0:11:18.67,Default,,0,0,0,,Әй?
Dialogue: 0,0:11:18.76,0:11:20.01,Default,,0,0,0,,Контаның бетіне қараңыз
Dialogue: 0,0:11:21.59,0:11:24.10,Default,,0,0,0,,Менің оқығаным қате болды...
Dialogue: 0,0:11:24.18,0:11:25.85,Default,,0,0,0,,Маған қашып кетуге жол берме!
Dialogue: 0,0:11:25.93,0:11:27.43,Default,,0,0,0,,Бар, Валькири!
Dialogue: 0,0:11:27.68,0:11:29.02,Default,,0,0,0,,Валькирия
Dialogue: 0,0:11:29.10,0:11:32.81,Default,,0,0,0,,Жылдамдықты арттыру үшін стадионның еңісін пайдаланыңыз
Dialogue: 0,0:11:32.90,0:11:33.94,Default,,0,0,0,,Және…
Dialogue: 0,0:11:34.02,0:11:35.44,Default,,0,0,0,,Бұдан басқа...
Dialogue: 0,0:11:35.52,0:11:37.65,Default,,0,0,0,,Хорсуд сонда болды!
Dialogue: 0,0:11:38.07,0:11:39.28,Default,,0,0,0,,Валькирия
Dialogue: 0,0:11:39.36,0:11:42.82,Default,,0,0,0,,Мен басқа адамнан айырылған жоқпын!
Dialogue: 0,0:11:43.41,0:11:45.28,Default,,0,0,0,,Хорсуд өрісі!
Dialogue: 0,0:11:53.37,0:11:54.83,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:11:55.96,0:11:59.38,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:12:01.55,0:12:03.55,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:12:05.59,0:12:07.72,Default,,0,0,0,,Бұзыңыз!
Dialogue: 0,0:12:14.98,0:12:16.81,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:17.69,0:12:19.94,Default,,0,0,0,,Хорсуд лақтырып жіберді!
Dialogue: 0,0:12:20.03,0:12:22.82,Default,,0,0,0,,Бір сәт әлсіреп қалды, бірақ тоқтады!
Dialogue: 0,0:12:23.03,0:12:25.78,Default,,0,0,0,,Енді шайқас басталады! Таеру!
Dialogue: 0,0:12:26.24,0:12:29.33,Default,,0,0,0,,Хорсуд Жекпе-жекке ең қолайлы позицияны мақсат етіңіз
Dialogue: 0,0:12:29.41,0:12:31.04,Default,,0,0,0,,Маған мұны істеуге рұқсат етіңіз!
Dialogue: 0,0:12:31.12,0:12:35.50,Default,,0,0,0,,Валькири орталыққа оралуға тырысып, Хорсудты қайтарады!
Dialogue: 0,0:12:35.58,0:12:37.42,Default,,0,0,0,,Валькириді қуыңыз!
Dialogue: 0,0:12:37.75,0:12:40.13,Default,,0,0,0,,Хорсуд Валькириді қуып келеді
Dialogue: 0,0:12:40.21,0:12:42.47,Default,,0,0,0,,Орталықты жылжыту мүмкін емес!
Dialogue: 0,0:12:42.55,0:12:44.09,Default,,0,0,0,,Ой! Ау!
Dialogue: 0,0:12:44.38,0:12:46.80,Default,,0,0,0,,Валькириді қуу
Dialogue: 0,0:12:46.89,0:12:50.26,Default,,0,0,0,,Төменгі беткейде жылдамдық одан да артады.
Dialogue: 0,0:12:51.93,0:12:53.60,Default,,0,0,0,,Керемет Балто
Dialogue: 0,0:12:53.68,0:12:54.94,Default,,0,0,0,,Жүр!
Dialogue: 0,0:12:55.27,0:12:57.23,Default,,0,0,0,,Жылдамдық барған сайын өсті.
Dialogue: 0,0:12:57.31,0:12:58.94,Default,,0,0,0,,Бұл асығыс ату
Dialogue: 0,0:12:59.36,0:13:01.73,Default,,0,0,0,,Орталыққа оралуға тырысқан Хорсудқа
Dialogue: 0,0:13:01.82,0:13:04.61,Default,,0,0,0,,Валькири жоғарыдан соқты
Dialogue: 0,0:13:04.74,0:13:07.32,Default,,0,0,0,,Қайтарылған Хорсуд орнында қалып, қайтады.
Dialogue: 0,0:13:07.41,0:13:08.99,Default,,0,0,0,,Хорсудты сипап өтіңіз
Dialogue: 0,0:13:10.74,0:13:13.25,Default,,0,0,0,,Жарып өту~ Валькирия!
Dialogue: 0,0:13:16.50,0:13:17.79,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:13:18.75,0:13:21.46,Default,,0,0,0,,Қасиетті Хорсудо жарылыстары!
Dialogue: 0,0:13:21.67,0:13:22.59,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:24.26,0:13:25.97,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:13:26.05,0:13:27.51,Default,,0,0,0,,Уф... аа...
Dialogue: 0,0:13:28.68,0:13:31.43,Default,,0,0,0,,Жеңіс Valkyrie Burst Finish
Dialogue: 0,0:13:31.51,0:13:34.02,Default,,0,0,0,,Барто Аои 2-1 жеңді!
Dialogue: 0,0:13:34.10,0:13:36.73,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:13:37.19,0:13:40.61,Default,,0,0,0,,Керемет! Алақай!
Dialogue: 0,0:13:40.69,0:13:42.23,Default,,0,0,0,,Сіз жеңдіңіз! Мен жеңдім!
Dialogue: 0,0:13:42.36,0:13:44.86,Default,,0,0,0,,Балтоның жігіті мені қобалжытып отыр.
Dialogue: 0,0:13:45.40,0:13:47.49,Default,,0,0,0,,Жеңіспен кері айналу дегеніміз не?
Dialogue: 0,0:13:47.57,0:13:49.53,Default,,0,0,0,,Ол әрқашан шетте.
Dialogue: 0,0:13:50.07,0:13:51.53,Default,,0,0,0,,Не болды?
Dialogue: 0,0:13:52.20,0:13:53.49,Default,,0,0,0,,Валькирия?
Dialogue: 0,0:13:54.04,0:13:56.08,Default,,0,0,0,,Мен жақсы дыбыс естідім.
Dialogue: 0,0:13:56.16,0:13:59.04,Default,,0,0,0,,Бұл, әрине, кездейсоқтық.
Dialogue: 0,0:13:59.12,0:14:00.46,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,0:14:00.54,0:14:01.04,Default,,0,0,0,,Не?
Dialogue: 0,0:14:02.09,0:14:04.88,Default,,0,0,0,,Контаның флеш түсіру арқылы келетінін оқыдым.
Dialogue: 0,0:14:04.96,0:14:07.59,Default,,0,0,0,,Хорсудты стадионның шетіне тастады.
Dialogue: 0,0:14:07.93,0:14:10.59,Default,,0,0,0,,Бірақ Балто шапшаң соққы жасады.
Dialogue: 0,0:14:10.93,0:14:13.39,Default,,0,0,0,,Жоқ, мен Rush Shoot ойынына сендім.
Dialogue: 0,0:14:15.27,0:14:18.73,Default,,0,0,0,,Нәтижесінде асығыс ату жылдамдығы одан да артады.
Dialogue: 0,0:14:18.81,0:14:20.65,Default,,0,0,0,,Күшті есептегішке айналады
Dialogue: 0,0:14:20.73,0:14:22.61,Default,,0,0,0,,Хорсуд жарылысы
Dialogue: 0,0:14:22.69,0:14:24.11,Default,,0,0,0,,Керемет Керемет
Dialogue: 0,0:14:24.19,0:14:26.86,Default,,0,0,0,,Бұл бір сәтте болды ма?
Dialogue: 0,0:14:27.53,0:14:30.07,Default,,0,0,0,,Секундтық шешім өзгерді
Dialogue: 0,0:14:30.91,0:14:32.28,Default,,0,0,0,,(көтерілу дыбысы)
Dialogue: 0,0:14:32.37,0:14:33.45,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:14:34.29,0:14:35.33,Default,,0,0,0,,Хорсуд
Dialogue: 0,0:14:36.50,0:14:38.75,Default,,0,0,0,,Мен саған сендім, досым.
Dialogue: 0,0:14:40.17,0:14:43.25,Default,,0,0,0,,Жартылай финалға өткен блок
Dialogue: 0,0:14:43.38,0:14:46.71,Default,,0,0,0,,Бұл Барто Аои!
Dialogue: 0,0:14:46.80,0:14:48.34,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:48.42,0:14:49.59,Default,,0,0,0,,О...
Dialogue: 0,0:14:51.22,0:14:52.60,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:53.26,0:14:54.64,Default,,0,0,0,,Техехе
Dialogue: 0,0:14:54.72,0:14:56.68,Default,,0,0,0,,Құттықтаймыз Балто
Dialogue: 0,0:14:56.77,0:14:57.98,Default,,0,0,0,,О, а?
Dialogue: 0,0:14:59.89,0:15:01.73,Default,,0,0,0,,Техехе
Dialogue: 0,0:15:01.81,0:15:02.77,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:05.48,0:15:07.19,Default,,0,0,0,,Маған бір нәрсе айтыңыз.
Dialogue: 0,0:15:07.28,0:15:09.90,Default,,0,0,0,,Неліктен жаңа әдіс-тәсілдерді қолданып көрмедің?
Dialogue: 0,0:15:10.57,0:15:12.70,Default,,0,0,0,,Неге...
Dialogue: 0,0:15:13.49,0:15:15.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:16.49,0:15:18.87,Default,,0,0,0,,Мен бұл туралы ойлаған да жоқпын.
Dialogue: 0,0:15:19.58,0:15:20.50,Default,,0,0,0,,Тек...
Dialogue: 0,0:15:20.58,0:15:23.75,Default,,0,0,0,,Менде Валкири Rush Shoot қолданбасын пайдаланғысы келетінін сезіндім.
Dialogue: 0,0:15:24.25,0:15:25.13,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:15:25.88,0:15:28.01,Default,,0,0,0,,Сіз бұл туралы ойламадыңыз ба...
Dialogue: 0,0:15:28.42,0:15:29.42,Default,,0,0,0,,Ахаха
Dialogue: 0,0:15:29.72,0:15:31.80,Default,,0,0,0,,Ахахаха…
Dialogue: 0,0:15:31.88,0:15:34.68,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:15:35.35,0:15:36.35,Default,,0,0,0,,Мен жеңіліп қалсам да
Dialogue: 0,0:15:36.43,0:15:38.39,Default,,0,0,0,,Әйтеуір, бұл өте жақсы.
Dialogue: 0,0:15:38.47,0:15:40.68,Default,,0,0,0,,Менімен тағы шайқасасың ба?
Dialogue: 0,0:15:41.60,0:15:44.27,Default,,0,0,0,,Әрине, қош келдіңіз.
Dialogue: 0,0:15:46.86,0:15:49.36,Default,,0,0,0,,Әй, Балт жігіт
Dialogue: 0,0:15:49.44,0:15:52.91,Default,,0,0,0,,Хоудзи ештеңе ойламайды, ол ақымақтан жеңілмейді.
Dialogue: 0,0:15:52.99,0:15:54.95,Default,,0,0,0,,Бұл өте қызық.
Dialogue: 0,0:15:55.03,0:15:56.20,Default,,0,0,0,,Әлгі ақымақ
Dialogue: 0,0:15:56.74,0:15:58.58,Default,,0,0,0,,Вакия-сан, жақында келеді
Dialogue: 0,0:15:59.04,0:16:00.12,Default,,0,0,0,,Түсіну
Dialogue: 0,0:16:01.87,0:16:03.33,Default,,0,0,0,,Бенишу!
Dialogue: 0,0:16:04.63,0:16:07.54,Default,,0,0,0,,Келесі ойынға назар аударыңыз.
Dialogue: 0,0:16:10.13,0:16:10.84,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:10.92,0:16:13.84,Default,,0,0,0,,Енді келесі шайқас В блогы.
Dialogue: 0,0:16:14.05,0:16:16.10,Default,,0,0,0,,4-ші турға кім өтті
Dialogue: 0,0:16:16.30,0:16:18.06,Default,,0,0,0,,Бақытты жетілік
Dialogue: 0,0:16:18.14,0:16:19.26,Default,,0,0,0,,Харуто Аота!
Dialogue: 0,0:16:19.35,0:16:20.60,Default,,0,0,0,,Сен басқа әлемнен келгеніңді айтасың ба?
Dialogue: 0,0:16:20.68,0:16:23.31,Default,,0,0,0,,Мен жеңетініме сенімдімін
Dialogue: 0,0:16:23.73,0:16:26.23,Default,,0,0,0,,Және жеңімпаз кандидаттардың бірі
Dialogue: 0,0:16:28.52,0:16:30.61,Default,,0,0,0,,Бұл Комурасаки Вакия!
Dialogue: 0,0:16:30.69,0:16:33.74,Default,,0,0,0,,Осы уақытқа дейін қарсыластарымызға қарсы бірде-бір ұпай ала алмауымыздың себебі:
Dialogue: 0,0:16:33.82,0:16:35.07,Default,,0,0,0,,Күтілгендей!
Dialogue: 0,0:16:36.07,0:16:37.66,Default,,0,0,0,,Әрине
Dialogue: 0,0:16:37.74,0:16:40.62,Default,,0,0,0,,Менің тәжірибелік әріптесім бола алсаңыз, жақсы болар еді.
Dialogue: 0,0:16:41.08,0:16:42.54,Default,,0,0,0,,Әзілдеме!
Dialogue: 0,0:16:42.62,0:16:45.79,Default,,0,0,0,,Мен өз қолыммен винттерді үрлеймін.
Dialogue: 0,0:16:45.87,0:16:47.00,Default,,0,0,0,,Не, сен?
Dialogue: 0,0:16:47.08,0:16:49.84,Default,,0,0,0,,Бұрынғы Балто деген жігітке ұқсайды.
Dialogue: 0,0:16:49.92,0:16:51.67,Default,,0,0,0,,Мен «Харутомын»!
Dialogue: 0,0:16:51.76,0:16:54.05,Default,,0,0,0,,Тіпті есімдері де ұқсас! Олар бір-біріне ұқсамайды, солай ма?
Dialogue: 0,0:16:54.13,0:16:55.18,Default,,0,0,0,,(Уакияның күлуі)
Dialogue: 0,0:16:55.26,0:16:57.26,Default,,0,0,0,,Мен міндетті түрде жеңемін!
Dialogue: 0,0:16:57.47,0:16:58.60,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:16:58.68,0:17:01.56,Default,,0,0,0,,Сол ойыншы Аота Бар-нииге ұқсайды.
Dialogue: 0,0:17:01.64,0:17:03.56,Default,,0,0,0,,Иә, ұқсас, ұқсас
Dialogue: 0,0:17:03.64,0:17:05.06,Default,,0,0,0,,Бұл ақымақ сияқты.
Dialogue: 0,0:17:05.73,0:17:07.77,Default,,0,0,0,,Бей де шабуыл түрі болып табылады.
Dialogue: 0,0:17:07.85,0:17:09.56,Default,,0,0,0,,Барто сияқты.
Dialogue: 0,0:17:10.06,0:17:12.90,Default,,0,0,0,,Жабайы Вайверн – қорғаныс түрі.
Dialogue: 0,0:17:12.99,0:17:16.20,Default,,0,0,0,,Шабуыл түрлері бар шайқастар тиімді.
Dialogue: 0,0:17:16.78,0:17:18.53,Default,,0,0,0,,Жеңгеніңізді білетін шайқастар
Dialogue: 0,0:17:18.61,0:17:20.28,Default,,0,0,0,,Мен өзімді ынталы және ұнатамын.
Dialogue: 0,0:17:20.49,0:17:21.74,Default,,0,0,0,,Не?
Dialogue: 0,0:17:21.83,0:17:22.79,Default,,0,0,0,,Соберн
Dialogue: 0,0:17:22.87,0:17:25.12,Default,,0,0,0,,Клиенттердің қарасы
Dialogue: 0,0:17:25.21,0:17:28.00,Default,,0,0,0,,Мен саған өз күшімді көрсетуім керек.
Dialogue: 0,0:17:28.50,0:17:30.75,Default,,0,0,0,,Хона, оны чача дейік.
Dialogue: 0,0:17:30.84,0:17:31.50,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:17:31.59,0:17:32.76,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:17:35.63,0:17:38.30,Default,,0,0,0,,Комурасаки Вакияны асыға күтейік
Dialogue: 0,0:17:38.39,0:17:40.76,Default,,0,0,0,,Біз қандай шайқас көреміз?
Dialogue: 0,0:17:42.43,0:17:45.02,Default,,0,0,0,,Барлығы, көзіңді жыпылықтатпа.
Dialogue: 0,0:17:45.35,0:17:47.19,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:17:47.85,0:17:51.32,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:51.98,0:17:54.11,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:56.45,0:17:57.95,Default,,0,0,0,,Жабайы уайверн
Dialogue: 0,0:17:58.03,0:18:00.24,Default,,0,0,0,,Теңдесі жоқ дәлдікпен түсірілді
Dialogue: 0,0:18:00.32,0:18:02.66,Default,,0,0,0,,Мен стадионның қақ ортасына жеттім.
Dialogue: 0,0:18:03.70,0:18:06.08,Default,,0,0,0,,Бұл менің қалқаным.
Dialogue: 0,0:18:09.46,0:18:11.21,Default,,0,0,0,,Қалқан ату
Dialogue: 0,0:18:14.63,0:18:16.97,Default,,0,0,0,,Стадионның қақ ортасына тоқтады
Dialogue: 0,0:18:17.51,0:18:18.84,Default,,0,0,0,,Тоқтатылмаған
Dialogue: 0,0:18:18.97,0:18:22.68,Default,,0,0,0,,Айналғаны сонша, тоқтап қалғандай.
Dialogue: 0,0:18:23.31,0:18:26.35,Default,,0,0,0,,Бұл соққы дәл болмаса, соғуға болмайтын әдіс.
Dialogue: 0,0:18:26.56,0:18:27.73,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:27.81,0:18:30.06,Default,,0,0,0,,Маған кез келген жерден қоңырау шала аласыз ба?
Dialogue: 0,0:18:30.27,0:18:32.40,Default,,0,0,0,,Харуто Аота жағдайды бақылап тұр.
Dialogue: 0,0:18:32.48,0:18:34.02,Default,,0,0,0,,Сіз Лакиді оята аласыз ба?
Dialogue: 0,0:18:34.36,0:18:35.94,Default,,0,0,0,,Қарғыс атқыр... Маған ұнамайды.
Dialogue: 0,0:18:36.03,0:18:37.65,Default,,0,0,0,,Бірақ менің кетуден басқа амалым жоқ.
Dialogue: 0,0:18:38.03,0:18:39.28,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,0:18:39.74,0:18:41.70,Default,,0,0,0,,Шабуыл басталды!
Dialogue: 0,0:18:43.70,0:18:44.54,Default,,0,0,0,,Не!
Dialogue: 0,0:18:44.70,0:18:48.04,Default,,0,0,0,,Ах, бірақ ол виверндарда жұмыс істемейді.
Dialogue: 0,0:18:48.12,0:18:49.54,Default,,0,0,0,,8 қалақ қабаттары және
Dialogue: 0,0:18:49.62,0:18:51.92,Default,,0,0,0,,Тік диск шабуылдар
Dialogue: 0,0:18:52.00,0:18:54.38,Default,,0,0,0,,Орбита драйвері соққыны сіңіреді!
Dialogue: 0,0:18:54.46,0:18:55.63,Default,,0,0,0,,Сәті болмайды
Dialogue: 0,0:18:56.21,0:18:57.55,Default,,0,0,0,,Керемет!
Dialogue: 0,0:18:58.01,0:19:00.30,Default,,0,0,0,,Бұл виверннің күші.
Dialogue: 0,0:19:00.38,0:19:01.80,Default,,0,0,0,,Мен оны көріп, үйге қайттым.
Dialogue: 0,0:19:02.68,0:19:04.39,Default,,0,0,0,,Сіз үйірмен соғысып көрдіңіз бе?
Dialogue: 0,0:19:04.47,0:19:06.52,Default,,0,0,0,,Онымен барлығына мақтана аласыз.
Dialogue: 0,0:19:08.02,0:19:09.89,Default,,0,0,0,,Шу Иә?
Dialogue: 0,0:19:09.98,0:19:12.60,Default,,0,0,0,,Сіздің Спригганыңыз да осылай болады.
Dialogue: 0,0:19:12.81,0:19:14.31,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:16.19,0:19:17.48,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:19:17.61,0:19:19.57,Default,,0,0,0,,Уау! Бұл жарылыс!
Dialogue: 0,0:19:20.03,0:19:23.62,Default,,0,0,0,,Wild Wyvern бастапқы жылдамдығымен бірдей жылдамдықпен айналуды жалғастыруда!
Dialogue: 0,0:19:23.82,0:19:25.08,Default,,0,0,0,,Комурасаки Вакия!
Dialogue: 0,0:19:25.16,0:19:28.33,Default,,0,0,0,,Бірінші шайқаста тағы бір жеңіліс!
Dialogue: 0,0:19:28.41,0:19:30.37,Default,,0,0,0,,Жоғалған ұпайлар 0 болып қалады
Dialogue: 0,0:19:30.46,0:19:32.54,Default,,0,0,0,,Жартылай финалға өтіңіз!
Dialogue: 0,0:19:32.62,0:19:34.33,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:19:34.42,0:19:37.05,Default,,0,0,0,,Маған онша қызықты болмады.
Dialogue: 0,0:19:37.59,0:19:39.59,Default,,0,0,0,,…ah
Dialogue: 0,0:19:40.17,0:19:41.43,Default,,0,0,0,,Комурасаки бұл...
Dialogue: 0,0:19:41.51,0:19:43.80,Default,,0,0,0,,Өткен жылға қарағанда әлдеқайда күшті
Dialogue: 0,0:19:44.01,0:19:45.85,Default,,0,0,0,,Бұл жігіт керемет
Dialogue: 0,0:19:45.93,0:19:48.81,Default,,0,0,0,,Эй, Балто, бұл таңданатын уақыт емес.
Dialogue: 0,0:19:48.89,0:19:51.31,Default,,0,0,0,,Сіз келесі қарсылассыз.
Dialogue: 0,0:19:51.39,0:19:52.52,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:19:52.98,0:19:54.98,Default,,0,0,0,,Сіз байқамадыңыз ба?
Dialogue: 0,0:19:56.06,0:19:57.23,Default,,0,0,0,,Ол...
Dialogue: 0,0:19:57.57,0:19:58.86,Default,,0,0,0,,Келесі адам
Dialogue: 0,0:19:58.94,0:20:00.15,Default,,0,0,0,,(Дарио) Хе-хе-хе-хе. Эй, қарашы — бұл апат!
Dialogue: 0,0:20:00.53,0:20:03.36,Default,,0,0,0,,Бару-нии, сен қалқан атуын жеңе аласың ба?
Dialogue: 0,0:20:03.78,0:20:05.24,Default,,0,0,0,,Бізде жеңуден басқа амал жоқ.
Dialogue: 0,0:20:05.78,0:20:07.78,Default,,0,0,0,,Бұл менің ағам.
Dialogue: 0,0:20:08.70,0:20:11.25,Default,,0,0,0,,Мен соншалықты таңғажайып нәрсемен күресе алатыныма сене алмаймын.
Dialogue: 0,0:20:11.33,0:20:12.66,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:20:13.50,0:20:14.50,Default,,0,0,0,,Валькирия
Dialogue: 0,0:20:15.21,0:20:18.42,Default,,0,0,0,,Менің келесі қарсыласым керемет күшті жігіт.
Dialogue: 0,0:20:18.75,0:20:21.17,Default,,0,0,0,,Барған сайын көңілім көтеріліп барады.
Dialogue: 0,0:20:21.92,0:20:23.84,Default,,0,0,0,,Эй, сен кімсің?
Dialogue: 0,0:20:23.93,0:20:27.01,Default,,0,0,0,,Уакияның шайқасы керемет.
Dialogue: 0,0:20:27.10,0:20:28.39,Default,,0,0,0,,О
Dialogue: 0,0:20:28.47,0:20:31.18,Default,,0,0,0,,Бала әрқашан биікке көтеріледі.
Dialogue: 0,0:20:33.89,0:20:35.52,Default,,0,0,0,,Вакия мен Балто
Dialogue: 0,0:20:35.90,0:20:38.44,Default,,0,0,0,,Екеуі де қызықты дыбыстар шығарады.
Dialogue: 0,0:20:40.61,0:20:42.61,Default,,0,0,0,,Бұл рас, мама.
Dialogue: 0,0:20:42.69,0:20:45.82,Default,,0,0,0,,Ол өте ыстық, өйткені ол керемет.
Dialogue: 0,0:20:45.91,0:20:49.74,Default,,0,0,0,,Қалқан ату арқылы барлық шабуылдарды тойтарыңыз.
Dialogue: 0,0:20:49.95,0:20:52.33,Default,,0,0,0,,Енді мен түсіндім, мен тоқтамаймын
Dialogue: 0,0:20:52.41,0:20:54.16,Default,,0,0,0,,Нан қамырын илеу де ерекше дайындық.
Dialogue: 0,0:20:54.62,0:20:57.13,Default,,0,0,0,,Ах! Бұл дұрыс, дұрыс
Dialogue: 0,0:20:58.54,0:21:01.71,Default,,0,0,0,,Мен біраз уақыттан бері Уакия туралы көп айтып жүрмін.
Dialogue: 0,0:21:02.01,0:21:04.34,Default,,0,0,0,,Бүгінгі Балтоның ойыны қалай өтті?
Dialogue: 0,0:21:04.42,0:21:07.43,Default,,0,0,0,,Бұл қалқанды бұзу үшін...
Dialogue: 0,0:21:07.76,0:21:09.51,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:21:09.60,0:21:10.85,Default,,0,0,0,,Барт?
Dialogue: 0,0:21:10.93,0:21:13.43,Default,,0,0,0,,Балто, матч қалай өтті?
Dialogue: 0,0:21:16.35,0:21:18.02,Default,,0,0,0,,Бар-нии, мен жеңдім.
Dialogue: 0,0:21:18.48,0:21:20.02,Default,,0,0,0,,4-ші кезеңнен өту
Dialogue: 0,0:21:20.11,0:21:21.48,Default,,0,0,0,,Жақын болды, бірақ
Dialogue: 0,0:21:21.69,0:21:24.07,Default,,0,0,0,,Иә! Балто керемет емес пе?
Dialogue: 0,0:21:24.28,0:21:27.16,Default,,0,0,0,,Мен оны шапшаң соққыммен жасай алуым керек.
Dialogue: 0,0:21:27.32,0:21:29.16,Default,,0,0,0,,Сөзсіз... (Чихару) Құттықтаймын
Dialogue: 0,0:21:29.62,0:21:32.49,Default,,0,0,0,,Асық...Ат! (Чихару) Нх...
Dialogue: 0,0:21:32.58,0:21:33.62,Default,,0,0,0,,(Химецудзима) Жәбірленген-ай… Қандай әлсіз, аянышты бала.
Dialogue: 0,0:21:38.25,0:21:40.71,Default,,0,0,0,,Тез ату! (Чихару) Иә!
Dialogue: 0,0:21:46.01,0:21:47.59,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:21:47.80,0:21:50.43,Default,,0,0,0,,Балто! Дұрыс істе!
Dialogue: 0,0:21:50.51,0:21:54.60,Default,,0,0,0,,Әй, кешіріңіз, анашым.
Dialogue: 0,0:22:09.16,0:22:15.25,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.45,0:22:21.59,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.04,0:22:27.59,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.05,0:22:31.39,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.55,0:22:36.48,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.39,0:22:41.10,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.19,0:22:44.40,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.48,0:22:50.82,Default,,0,0,0,,Артынан қусаң да көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.07,0:22:56.62,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.79,0:23:03.38,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:03.96,0:23:09.38,Default,,0,0,0,,Даңққа жететін күнге дейін
Dialogue: 0,0:23:09.55,0:23:12.72,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.22,0:23:17.18,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.57,0:23:28.65,Default,,0,0,0,,Уакияның үйі өте әдемі.
Dialogue: 0,0:23:28.74,0:23:30.74,Default,,0,0,0,,Бізде соңғы үлгідегі оқу жабдықтары бар.
Dialogue: 0,0:23:30.82,0:23:33.24,Default,,0,0,0,,Сондықтан мен күнде шығанақпен айналысамын.
Dialogue: 0,0:23:33.32,0:23:36.95,Default,,0,0,0,,Не! Вакия жаңа ерекше қозғалысты жетілдірді ме?
Dialogue: 0,0:23:37.04,0:23:39.66,Default,,0,0,0,,Қызық екен, жарысайық, Уақия
Dialogue: 0,0:23:39.75,0:23:42.42,Default,,0,0,0,,Мен бұл ерекше қадамды қабылдаймын.
Dialogue: 0,0:23:42.50,0:23:44.21,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:44.29,0:23:46.00,Default,,0,0,0,,Сіздің жолыңызда винт тұр!
Dialogue: 0,0:23:46.09,0:23:48.00,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.34,0:23:50.13,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.63,0:23:57.63,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory