Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.59,0:00:09.09,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.17,0:00:12.67,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.80,0:00:14.76,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:16.93,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.01,0:00:18.85,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.43,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.27,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.35,0:00:28.82,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:32.07,0:00:33.78,Default,,0,0,0,,(нан жеу дыбысы)
Dialogue: 0,0:00:43.66,0:00:45.33,Default,,0,0,0,,Білесің бе, Балто?
Dialogue: 0,0:00:45.42,0:00:47.38,Default,,0,0,0,,Мен сіздің сезіміңізді түсінемін.
Dialogue: 0,0:00:47.46,0:00:49.54,Default,,0,0,0,,Сізге таңғы ас ішудің қажеті жоқ, солай ма?
Dialogue: 0,0:00:49.71,0:00:51.05,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:00:51.13,0:00:52.34,Default,,0,0,0,,Өйткені
Dialogue: 0,0:00:52.42,0:00:56.22,Default,,0,0,0,,Кешеден бері қолтығымның астынан бәрін көріп тұрмын.
Dialogue: 0,0:00:56.30,0:00:57.39,Default,,0,0,0,,Қазір...
Dialogue: 0,0:00:57.72,0:00:58.68,Default,,0,0,0,,Қай тіл?
Dialogue: 0,0:00:59.05,0:01:01.06,Default,,0,0,0,,Жұтынып болған соң сөйлесеміз бе?
Dialogue: 0,0:01:02.85,0:01:04.27,Default,,0,0,0,,Пуха~
Dialogue: 0,0:01:04.35,0:01:05.52,Default,,0,0,0,,Ендеше, келіңіз
Dialogue: 0,0:01:05.60,0:01:07.15,Default,,0,0,0,,Бұл да (Комурасаки Вакия) Доя
Dialogue: 0,0:01:07.23,0:01:08.90,Default,,0,0,0,,Бұл да
Dialogue: 0,0:01:08.98,0:01:10.90,Default,,0,0,0,,Бұл да! Доя Доя
Dialogue: 0,0:01:10.98,0:01:12.82,Default,,0,0,0,,Бұл да! Доя Доя
Dialogue: 0,0:01:12.90,0:01:15.82,Default,,0,0,0,,Барлығы шынайы бола бастайды!
Dialogue: 0,0:01:15.90,0:01:18.62,Default,,0,0,0,,Доя Доя Доя
Dialogue: 0,0:01:18.70,0:01:19.66,Default,,0,0,0,,Міне
Dialogue: 0,0:01:19.74,0:01:21.37,Default,,0,0,0,,Мен кеше көп жаттығу жасадым.
Dialogue: 0,0:01:21.45,0:01:23.91,Default,,0,0,0,,Ашуыңыз басылған жоқ па?
Dialogue: 0,0:01:24.00,0:01:26.08,Default,,0,0,0,,Болды, бұл арман
Dialogue: 0,0:01:27.25,0:01:28.33,Default,,0,0,0,,Хонма
Dialogue: 0,0:01:28.42,0:01:30.00,Default,,0,0,0,,Бұл дайындық деңгейімен...
Dialogue: 0,0:01:30.08,0:01:33.63,Default,,0,0,0,,Егер сіз қалқан шұңқырын сындырамын деп ойласаңыз, қателесесіз.
Dialogue: 0,0:01:33.71,0:01:35.34,Default,,0,0,0,,Өте тәтті
Dialogue: 0,0:01:35.42,0:01:37.93,Default,,0,0,0,,Міне
Dialogue: 0,0:01:38.01,0:01:40.18,Default,,0,0,0,,Мен жиіркеніштімін!
Dialogue: 0,0:01:40.26,0:01:42.81,Default,,0,0,0,,Түсімде пайда болғаны...
Dialogue: 0,0:01:42.89,0:01:44.89,Default,,0,0,0,,Бұл өте ұят болуы керек.
Dialogue: 0,0:01:44.97,0:01:46.06,Default,,0,0,0,,Ол оны ұстап тұр. Ол оны ұстап тұр.
Dialogue: 0,0:01:46.56,0:01:48.10,Default,,0,0,0,,Бұл маңызды болуы керек...
Dialogue: 0,0:01:48.19,0:01:50.06,Default,,0,0,0,,Хмм!
Dialogue: 0,0:01:50.31,0:01:52.90,Default,,0,0,0,,Ей, сен мына шығанақты ауыстыр.
Dialogue: 0,0:01:52.98,0:01:54.98,Default,,0,0,0,,Мен үшін жұмыс істемейді
Dialogue: 0,0:01:55.07,0:01:58.11,Default,,0,0,0,,Валькири де сенің серігің болған кезде сені аяйды.
Dialogue: 0,0:01:58.20,0:02:00.49,Default,,0,0,0,,Вакия жігіті
Dialogue: 0,0:02:01.07,0:02:03.45,Default,,0,0,0,,Тынышталыңыз.
Dialogue: 0,0:02:03.58,0:02:04.83,Default,,0,0,0,,Бабал аға
Dialogue: 0,0:02:04.91,0:02:07.00,Default,,0,0,0,,Таңертеңнен бері қатты толқыдым
Dialogue: 0,0:02:17.76,0:02:20.14,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:02:20.47,0:02:25.64,Default,,0,0,0,,Ең күшті қуық болуды мақсат етейік
Dialogue: 0,0:02:36.94,0:02:40.32,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:02:40.82,0:02:42.95,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:02:43.37,0:02:47.50,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:47.62,0:02:50.83,Default,,0,0,0,,Дұрыс, менімен бетпе-бет келген өрнек
Dialogue: 0,0:02:50.96,0:02:57.38,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:57.67,0:03:02.09,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:03:02.59,0:03:08.02,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:03:08.14,0:03:10.39,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:10.48,0:03:15.19,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:03:15.36,0:03:20.45,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:03:20.74,0:03:22.99,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:03:23.20,0:03:25.53,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:03:25.83,0:03:29.75,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:03:29.91,0:03:34.92,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:03:35.13,0:03:37.30,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:41.17,0:03:43.76,Default,,0,0,0,,Оны жеңіңіз! Валькирияға сеніңіз!
Dialogue: 0,0:03:45.22,0:03:47.14,Default,,0,0,0,,Мен жеңемін
Dialogue: 0,0:03:47.22,0:03:49.97,Default,,0,0,0,,Таңертең мазалағаным үшін кешіріңіз! Тітіркендіргіш
Dialogue: 0,0:03:50.06,0:03:51.06,Default,,0,0,0,,Маған түкір
Dialogue: 0,0:03:51.14,0:03:52.27,Default,,0,0,0,,Бұл Уакия
Dialogue: 0,0:03:52.35,0:03:53.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:53.73,0:03:56.73,Default,,0,0,0,,Оның басынан бастап жарысуға ниеті болған жоқ.
Dialogue: 0,0:03:56.81,0:03:58.90,Default,,0,0,0,,Мен зертханалық үстел туралы қалжыңдаймын.
Dialogue: 0,0:03:58.98,0:04:00.94,Default,,0,0,0,,Мен Валькири туралы мүлдем шатастырдым.
Dialogue: 0,0:04:01.28,0:04:02.32,Default,,0,0,0,,Пероринчо
Dialogue: 0,0:04:02.40,0:04:03.61,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:04:03.91,0:04:05.57,Default,,0,0,0,,Басыңызды суытыңыз
Dialogue: 0,0:04:05.66,0:04:08.20,Default,,0,0,0,,Мен бұл тітіркендіргіш екенін білемін, бірақ...
Dialogue: 0,0:04:08.28,0:04:09.54,Default,,0,0,0,,Ендеше жеңіңіз
Dialogue: 0,0:04:09.62,0:04:12.33,Default,,0,0,0,,Оған Валькирияның күшін көрсет
Dialogue: 0,0:04:12.54,0:04:13.96,Default,,0,0,0,,бірінші кезекте-
Dialogue: 0,0:04:14.04,0:04:16.17,Default,,0,0,0,,Бұл нақты қарсылас болса да.
Dialogue: 0,0:04:16.75,0:04:19.71,Default,,0,0,0,,Саған ішінде не бар екенін көрсету мүмкін емес.
Dialogue: 0,0:04:19.92,0:04:22.30,Default,,0,0,0,,Міне, мен сенімдімін.
Dialogue: 0,0:04:22.76,0:04:25.93,Default,,0,0,0,,-де Барт арандатушылыққа толықтай көнді.
Dialogue: 0,0:04:26.01,0:04:27.22,Default,,0,0,0,,Му~
Dialogue: 0,0:04:27.30,0:04:29.89,Default,,0,0,0,,Вакия менің басымнан шыға алмайды
Dialogue: 0,0:04:29.97,0:04:30.93,Default,,0,0,0,,Доя
Dialogue: 0,0:04:31.02,0:04:33.18,Default,,0,0,0,,Кумичо да вакияға ұқсайды!
Dialogue: 0,0:04:33.35,0:04:34.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:35.02,0:04:36.19,Default,,0,0,0,,Доя
Dialogue: 0,0:04:37.15,0:04:37.73,Default,,0,0,0,,Доя
Dialogue: 0,0:04:37.81,0:04:38.52,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:04:38.61,0:04:40.57,Default,,0,0,0,,Барлығы ақылсыз
Dialogue: 0,0:04:40.65,0:04:43.15,Default,,0,0,0,,Кеше - кеше!
Dialogue: 0,0:04:43.24,0:04:46.07,Default,,0,0,0,,Неліктен бүгін қатты жаттығуға болмайды?
Dialogue: 0,0:04:46.16,0:04:48.53,Default,,0,0,0,,Иә, жаттығу!
Dialogue: 0,0:04:49.03,0:04:51.54,Default,,0,0,0,,Бидің ашуын Бей шығарады
Dialogue: 0,0:04:52.50,0:04:54.71,Default,,0,0,0,,Мен флэш түсірілімді жетілдіруім керек.
Dialogue: 0,0:04:54.79,0:04:57.08,Default,,0,0,0,,Барлығыңыз, менімен шайқасыңыздар.
Dialogue: 0,0:04:57.67,0:05:00.04,Default,,0,0,0,,Мен жарқылмен түсіруді меңгергім келеді.
Dialogue: 0,0:05:00.17,0:05:02.21,Default,,0,0,0,,Әйтпесе, Уакияны жеңе алмайсың.
Dialogue: 0,0:05:02.76,0:05:04.92,Default,,0,0,0,,Жаттығу...Менімен бірге келесіз деп үміттенемін.
Dialogue: 0,0:05:05.01,0:05:05.97,Default,,0,0,0,,Барт
Dialogue: 0,0:05:06.05,0:05:06.88,Default,,0,0,0,,О
Dialogue: 0,0:05:07.76,0:05:09.55,Default,,0,0,0,,Біз жаттығу үстеліміз бе?
Dialogue: 0,0:05:09.64,0:05:10.89,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:10.97,0:05:13.98,Default,,0,0,0,,Bay Club сіз үшін ме?
Dialogue: 0,0:05:14.06,0:05:16.31,Default,,0,0,0,,Не болды? Кумичо
Dialogue: 0,0:05:16.69,0:05:19.23,Default,,0,0,0,,Ақылға қонымды нәрсе айту сирек.
Dialogue: 0,0:05:19.31,0:05:20.32,Default,,0,0,0,,Бұл тітіркендіргіш!
Dialogue: 0,0:05:20.40,0:05:22.48,Default,,0,0,0,,Кумичо түсінбейді!
Dialogue: 0,0:05:22.82,0:05:25.11,Default,,0,0,0,,Уақия біз туралы басынан бері ойлайды.
Dialogue: 0,0:05:25.19,0:05:27.49,Default,,0,0,0,,Мен сізді бәсекеге қабілетті қарсылас деп санамаймын.
Dialogue: 0,0:05:27.57,0:05:30.24,Default,,0,0,0,,Мен мұны ешқашан кешіре алмаймын.
Dialogue: 0,0:05:30.33,0:05:34.08,Default,,0,0,0,,Мен және Валькири осылай ұтыла алмаймыз.
Dialogue: 0,0:05:34.16,0:05:35.04,Default,,0,0,0,,Мүлдем жоқ!
Dialogue: 0,0:05:37.04,0:05:37.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:39.42,0:05:41.29,Default,,0,0,0,,Кумичо (Рантаро) мен
Dialogue: 0,0:05:41.38,0:05:44.55,Default,,0,0,0,,Дәл қазір сенімен жарысқым келмейді.
Dialogue: 0,0:05:45.21,0:05:47.05,Default,,0,0,0,,Инсуке Дина!
Dialogue: 0,0:05:47.13,0:05:49.43,Default,,0,0,0,,Сабақ басталғалы жатыр, солай ма?
Dialogue: 0,0:05:49.51,0:05:50.85,Default,,0,0,0,,Дұрыс, дұрыс.
Dialogue: 0,0:05:50.93,0:05:52.60,Default,,0,0,0,,Көріскенше, Барто
Dialogue: 0,0:05:55.39,0:05:57.19,Default,,0,0,0,,Жарайды, түсіндім.
Dialogue: 0,0:05:57.27,0:05:58.85,Default,,0,0,0,,Мен мұны жалғыз жасаймын
Dialogue: 0,0:06:00.48,0:06:02.19,Default,,0,0,0,,Жарқын түсірілім!
Dialogue: 0,0:06:07.36,0:06:08.61,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:06:12.62,0:06:14.54,Default,,0,0,0,,Жарқын түсірілім!
Dialogue: 0,0:06:18.75,0:06:21.92,Default,,0,0,0,,А, жоқ, мен мұны істей алмаймын.
Dialogue: 0,0:06:23.75,0:06:26.51,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:06:26.84,0:06:30.43,Default,,0,0,0,,Жарқылды алу үшін қандай позицияда түсіру керек деп ойлаймын...
Dialogue: 0,0:06:30.51,0:06:31.55,Default,,0,0,0,,Бұл солай ма?
Dialogue: 0,0:06:32.26,0:06:35.35,Default,,0,0,0,,Мынадай... Осылай...
Dialogue: 0,0:06:35.43,0:06:36.52,Default,,0,0,0,,Жоқ, солай ма?
Dialogue: 0,0:06:36.60,0:06:37.68,Default,,0,0,0,,...
Dialogue: 0,0:06:38.10,0:06:39.60,Default,,0,0,0,,Комурасаки Вакия...
Dialogue: 0,0:06:39.94,0:06:42.15,Default,,0,0,0,,Ол шынымен де оған ұқсамайды.
Dialogue: 0,0:06:42.23,0:06:43.98,Default,,0,0,0,,Тек жең, жең!
Dialogue: 0,0:06:44.57,0:06:48.57,Default,,0,0,0,,Куроками Динамен шайқасқанда солай болған жоқ па?
Dialogue: 0,0:06:48.65,0:06:50.28,Default,,0,0,0,,Антоки деген не...
Dialogue: 0,0:06:50.36,0:06:52.12,Default,,0,0,0,,Олар ұқсас, бірақ әртүрлі.
Dialogue: 0,0:06:52.53,0:06:54.16,Default,,0,0,0,,Жақсы айта алмаймын, бірақ...
Dialogue: 0,0:06:54.24,0:06:56.33,Default,,0,0,0,,Күн қатты қызып барады
Dialogue: 0,0:06:56.41,0:06:59.00,Default,,0,0,0,,Сіз маңызды нәрсені түсінбейсіз...
Dialogue: 0,0:06:59.08,0:07:01.46,Default,,0,0,0,,Сонымен Шуу маған да айтуы керек.
Dialogue: 0,0:07:01.54,0:07:04.34,Default,,0,0,0,,«Әдеттегі Балтоға не болды?»
Dialogue: 0,0:07:04.71,0:07:06.80,Default,,0,0,0,,Хуаншан өте мейірімді...
Dialogue: 0,0:07:07.00,0:07:09.01,Default,,0,0,0,,Ал, мен уайымдап тұрмын.
Dialogue: 0,0:07:09.92,0:07:12.30,Default,,0,0,0,,Бір соққы айтқан кезде...
Dialogue: 0,0:07:12.64,0:07:14.85,Default,,0,0,0,,Менің ойымша, бұл ең жақсы дәрі.
Dialogue: 0,0:07:15.10,0:07:16.60,Default,,0,0,0,,Мен есірткімін бе?
Dialogue: 0,0:07:16.68,0:07:19.77,Default,,0,0,0,,А, жоқ... олай емес.
Dialogue: 0,0:07:20.52,0:07:23.65,Default,,0,0,0,,Балто мен сені көздеп отырмын.
Dialogue: 0,0:07:23.73,0:07:25.98,Default,,0,0,0,,Мақсат өзгерген жоқ па?
Dialogue: 0,0:07:26.07,0:07:26.86,Default,,0,0,0,,Әй?
Dialogue: 0,0:07:27.19,0:07:28.57,Default,,0,0,0,,Комурасаки Вакия
Dialogue: 0,0:07:29.44,0:07:31.28,Default,,0,0,0,,Оның шайқасында мүмкіндік жоқ.
Dialogue: 0,0:07:31.53,0:07:32.36,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:07:32.45,0:07:34.12,Default,,0,0,0,,Сен әлсіз болсаң не істеуім керек?
Dialogue: 0,0:07:34.20,0:07:35.58,Default,,0,0,0,,Аюлы кім?
Dialogue: 0,0:07:35.66,0:07:38.16,Default,,0,0,0,,Күте тұрыңыз, әңгіме әлі біткен жоқ.
Dialogue: 0,0:07:38.24,0:07:39.12,Default,,0,0,0,,Эй
Dialogue: 0,0:07:39.58,0:07:41.08,Default,,0,0,0,,Менің бір сұрағым бар...
Dialogue: 0,0:07:41.16,0:07:42.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:42.12,0:07:44.92,Default,,0,0,0,,Бартнесс дегеніміз не?
Dialogue: 0,0:07:45.75,0:07:46.38,Default,,0,0,0,,Иә…♡
Dialogue: 0,0:07:47.13,0:07:48.25,Default,,0,0,0,,Жақсы мағынада
Dialogue: 0,0:07:48.84,0:07:49.63,Default,,0,0,0,,Әй
Dialogue: 0,0:07:51.97,0:07:54.59,Default,,0,0,0,,Таңертең мен иә дедім.
Dialogue: 0,0:07:54.68,0:07:56.85,Default,,0,0,0,,Біз де ойланып қалдық.
Dialogue: 0,0:07:56.93,0:07:59.93,Default,,0,0,0,,Балто дәл қазір ыстық сезінеді...
Dialogue: 0,0:08:00.02,0:08:02.23,Default,,0,0,0,,Сабыр ет, Сабыр ет десем де...
Dialogue: 0,0:08:02.31,0:08:04.31,Default,,0,0,0,,Тыңдайтын құлағың жоқ па?
Dialogue: 0,0:08:04.40,0:08:06.81,Default,,0,0,0,,Суыту үшін
Dialogue: 0,0:08:06.90,0:08:09.11,Default,,0,0,0,,Өзің жақсы көретін іспен айналысу...
Dialogue: 0,0:08:09.19,0:08:10.78,Default,,0,0,0,,Менің ойымша, бұл ең жақсы
Dialogue: 0,0:08:10.86,0:08:12.15,Default,,0,0,0,,Біз...
Dialogue: 0,0:08:12.45,0:08:13.82,Default,,0,0,0,,Мен мұны істеймін~
Dialogue: 0,0:08:13.91,0:08:16.32,Default,,0,0,0,,О, сен мұны істей аласың ба?
Dialogue: 0,0:08:16.41,0:08:19.74,Default,,0,0,0,,Жарайды, флэш түсіру жаттығуларынан бастайық.
Dialogue: 0,0:08:19.83,0:08:22.12,Default,,0,0,0,,Егер бұл тәжірибе кестесі болса, онда жоқ.
Dialogue: 0,0:08:22.21,0:08:23.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:23.12,0:08:26.00,Default,,0,0,0,,Жарқылмен түсіруді жаттықтыру да маңызды...
Dialogue: 0,0:08:26.46,0:08:29.46,Default,,0,0,0,,Бей клубының мүшелері ретінде...
Dialogue: 0,0:08:29.55,0:08:32.30,Default,,0,0,0,,Мен жай ғана Балтомен бәсекелескім келеді.
Dialogue: 0,0:08:33.13,0:08:34.34,Default,,0,0,0,,Жарайды, жасайық!
Dialogue: 0,0:08:34.55,0:08:37.93,Default,,0,0,0,,Басыңды жинап, күрессең болғаны.
Dialogue: 0,0:08:39.18,0:08:40.39,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:08:42.52,0:08:43.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:43.52,0:08:46.23,Default,,0,0,0,,Валькири маған сәйкес келмейді.
Dialogue: 0,0:08:46.31,0:08:48.23,Default,,0,0,0,,Мен жоғары қараймын
Dialogue: 0,0:08:48.31,0:08:51.53,Default,,0,0,0,,Вайверн Шудың Спригганын жеңе ме?
Dialogue: 0,0:08:51.61,0:08:53.61,Default,,0,0,0,,Ва-ки-я!
Dialogue: 0,0:08:53.69,0:08:54.95,Default,,0,0,0,,Бұл Инсуке.
Dialogue: 0,0:08:55.03,0:08:56.03,Default,,0,0,0,,Бұл Уакия емес.
Dialogue: 0,0:08:56.11,0:08:57.66,Default,,0,0,0,,Мен сіздерді Азумабито мырзаның резиденциясына апарамын.
Dialogue: 0,0:08:57.74,0:08:59.62,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:08:59.70,0:09:02.62,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:09:02.70,0:09:04.71,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:11.05,0:09:11.92,Default,,0,0,0,,Nga!
Dialogue: 0,0:09:12.00,0:09:13.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:13.42,0:09:14.92,Default,,0,0,0,,Авдол мен басқалар… келе жатыр…
Dialogue: 0,0:09:16.09,0:09:18.34,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:20.72,0:09:21.51,Default,,0,0,0,,Көңілді
Dialogue: 0,0:09:21.89,0:09:23.72,Default,,0,0,0,,Сіз мені күлдіргіңіз келеді.
Dialogue: 0,0:09:23.93,0:09:26.02,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:09:27.10,0:09:28.40,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:09:28.48,0:09:30.31,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:31.27,0:09:32.82,Default,,0,0,0,,Жарайды, мен кеттім.
Dialogue: 0,0:09:32.90,0:09:35.11,Default,,0,0,0,,Валькирия! Тез ату!
Dialogue: 0,0:09:38.36,0:09:39.78,Default,,0,0,0,,Асық! асығыс!
Dialogue: 0,0:09:41.99,0:09:43.16,Default,,0,0,0,,Артқа жанап өтіңіз!
Dialogue: 0,0:09:44.00,0:09:46.00,Default,,0,0,0,,Жақсы, Кербеус!
Dialogue: 0,0:09:48.37,0:09:50.21,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:09:50.29,0:09:51.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:54.84,0:09:56.47,Default,,0,0,0,,Инсукенің жылдам жеңісі
Dialogue: 0,0:09:58.30,0:09:59.76,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:10:00.22,0:10:02.05,Default,,0,0,0,,Мен неге ұтыламын?
Dialogue: 0,0:10:02.39,0:10:05.60,Default,,0,0,0,,Бұл флеш-сессия болуы керек.
Dialogue: 0,0:10:05.68,0:10:06.77,Default,,0,0,0,,Сіз...
Dialogue: 0,0:10:06.85,0:10:09.44,Default,,0,0,0,,Пішін де, бәрі де бейберекет.
Dialogue: 0,0:10:09.52,0:10:11.02,Default,,0,0,0,,Рух
Dialogue: 0,0:10:11.11,0:10:13.11,Default,,0,0,0,,Карамауанри~
Dialogue: 0,0:10:13.19,0:10:15.32,Default,,0,0,0,,Сіз өзіңіздің қолтықтарыңызға тым сенімдісіз.
Dialogue: 0,0:10:15.40,0:10:16.57,Default,,0,0,0,,Келесі жолы менімен бірге жасаңыз
Dialogue: 0,0:10:17.07,0:10:18.45,Default,,0,0,0,,№
Dialogue: 0,0:10:18.90,0:10:20.74,Default,,0,0,0,,Мен жеңілгім келмейді.
Dialogue: 0,0:10:20.82,0:10:21.57,Default,,0,0,0,,Не...
Dialogue: 0,0:10:23.95,0:10:25.49,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:25.66,0:10:27.04,Default,,0,0,0,,Бала!
Dialogue: 0,0:10:27.16,0:10:29.46,Default,,0,0,0,,Біз баламыз, солай ма?
Dialogue: 0,0:10:29.54,0:10:31.42,Default,,0,0,0,,Тым байыпты болмаңыз
Dialogue: 0,0:10:39.68,0:10:41.93,Default,,0,0,0,,Ах, Шуу-кун.
Dialogue: 0,0:10:45.26,0:10:46.47,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:10:46.56,0:10:47.52,Default,,0,0,0,,(сүріну дыбысы)
Dialogue: 0,0:10:47.60,0:10:49.19,Default,,0,0,0,,Ах
Dialogue: 0,0:10:51.69,0:10:52.19,Default,,0,0,0,,Ах
Dialogue: 0,0:10:52.27,0:10:53.94,Default,,0,0,0,,Уф аа
Dialogue: 0,0:10:57.07,0:10:58.61,Default,,0,0,0,,Аа, кешіріңіз...
Dialogue: 0,0:10:58.69,0:11:00.95,Default,,0,0,0,,Қазір абай бол, Ника.
Dialogue: 0,0:11:02.78,0:11:03.87,Default,,0,0,0,,Жарыс басталмас бұрын Қвиркіңді қолданба! Өзіңді шаршатпа!
Dialogue: 0,0:11:03.95,0:11:05.62,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:11:05.70,0:11:07.50,Default,,0,0,0,,Сізге кедергі болды.
Dialogue: 0,0:11:07.91,0:11:08.91,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:11:09.62,0:11:11.79,Default,,0,0,0,,Сонымен қатар, Балтоның жағдайы қалай?
Dialogue: 0,0:11:12.21,0:11:14.04,Default,,0,0,0,,Мен Бей клубына бардым.
Dialogue: 0,0:11:14.67,0:11:17.09,Default,,0,0,0,,Олай болса, маған мынаны айтып бере аласың ба?
Dialogue: 0,0:11:17.17,0:11:18.88,Default,,0,0,0,,Иә, не?
Dialogue: 0,0:11:20.47,0:11:23.26,Default,,0,0,0,,Валькири қалай? Сонымен...
Dialogue: 0,0:11:24.01,0:11:26.43,Default,,0,0,0,,Иә? …Иә
Dialogue: 0,0:11:31.19,0:11:32.98,Default,,0,0,0,,Кешіріңіз, Валькири
Dialogue: 0,0:11:33.65,0:11:35.06,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:11:35.15,0:11:37.69,Default,,0,0,0,,Мен қалай жеңемін деп ойлаймын...
Dialogue: 0,0:11:38.44,0:11:39.65,Default,,0,0,0,,Мен жеңуім керек...
Dialogue: 0,0:11:40.11,0:11:42.53,Default,,0,0,0,,Жеңіске жетпесек, Шуға жетпейміз...
Dialogue: 0,0:11:42.99,0:11:45.62,Default,,0,0,0,,Акио-кун, анау жақта, анау жақта.
Dialogue: 0,0:11:45.70,0:11:46.95,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:11:47.03,0:11:49.70,Default,,0,0,0,,Ника-чанның отбасында шығанақ стадионы бар.
Dialogue: 0,0:11:49.79,0:11:51.25,Default,,0,0,0,,Қараңызшы, міне, осы.
Dialogue: 0,0:11:51.33,0:11:54.67,Default,,0,0,0,,Бірақ бұл жарыстарға арналмаған, сондықтан ол аз.
Dialogue: 0,0:11:54.75,0:11:58.42,Default,,0,0,0,,Сондықтан ағам енді оны көп қолданбайды.
Dialogue: 0,0:11:58.50,0:12:02.13,Default,,0,0,0,,Сіздің ағаңыз дәл қазір аудандық турнирде көп жеңіске жетті, солай ма?
Dialogue: 0,0:12:02.22,0:12:03.84,Default,,0,0,0,,Керемет!
Dialogue: 0,0:12:03.93,0:12:05.14,Default,,0,0,0,,Хехе
Dialogue: 0,0:12:05.22,0:12:07.72,Default,,0,0,0,,Акио шайқасайық!
Dialogue: 0,0:12:07.81,0:12:09.43,Default,,0,0,0,,Иә, жасайық!
Dialogue: 0,0:12:09.52,0:12:11.77,Default,,0,0,0,,Олай болса, бірінші шайқас.
Dialogue: 0,0:12:11.85,0:12:13.52,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:12:13.60,0:12:14.44,Default,,0,0,0,,Ой
Dialogue: 0,0:12:14.52,0:12:16.69,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:12:16.77,0:12:20.03,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:12:20.57,0:12:22.57,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:12:22.65,0:12:24.74,Default,,0,0,0,,Жүр! Жарайды, тамаша!
Dialogue: 0,0:12:26.87,0:12:29.03,Default,,0,0,0,,Керемет! Барыңыз!
Dialogue: 0,0:12:29.12,0:12:31.16,Default,,0,0,0,,Жақсы! Жақсы! Жақсы!
Dialogue: 0,0:12:31.25,0:12:34.25,Default,,0,0,0,,Ұш! Оны артқа аударыңыз!
Dialogue: 0,0:12:34.75,0:12:35.79,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:12:35.88,0:12:38.17,Default,,0,0,0,,Токонацудың жедел жеңісі!
Dialogue: 0,0:12:38.34,0:12:41.05,Default,,0,0,0,,Ия~ Ах~ мен жеңіліп қалдым
Dialogue: 0,0:12:43.51,0:12:45.01,Default,,0,0,0,,Керемет болды!
Dialogue: 0,0:12:45.09,0:12:47.60,Default,,0,0,0,,Мм... сен Бэйге айтасың ба?
Dialogue: 0,0:12:48.01,0:12:49.93,Default,,0,0,0,,Менің ағам үнемі солай істейді.
Dialogue: 0,0:12:50.01,0:12:51.93,Default,,0,0,0,,Ол мені «Айбо» деп атайды.
Dialogue: 0,0:12:52.02,0:12:53.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:53.35,0:12:55.48,Default,,0,0,0,,Әй, бұл жақсы.
Dialogue: 0,0:12:55.56,0:12:57.23,Default,,0,0,0,,Неліктен қолданып көрмеске?
Dialogue: 0,0:12:57.31,0:12:59.11,Default,,0,0,0,,Иә! Байқап көріңіз!
Dialogue: 0,0:12:59.73,0:13:01.86,Default,,0,0,0,,Келесі Жеңіске жетейік!
Dialogue: 0,0:13:02.94,0:13:04.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:04.11,0:13:05.86,Default,,0,0,0,,Бұл өте ұят.
Dialogue: 0,0:13:05.95,0:13:07.78,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:13:07.87,0:13:09.07,Default,,0,0,0,,Хех хех хех
Dialogue: 0,0:13:09.16,0:13:11.41,Default,,0,0,0,,Қайтадан жасайық
Dialogue: 0,0:13:11.49,0:13:13.12,Default,,0,0,0,,Олай болса, бұл жолы мен.
Dialogue: 0,0:13:13.20,0:13:14.96,Default,,0,0,0,,О, жарайды!
Dialogue: 0,0:13:15.04,0:13:17.21,Default,,0,0,0,,Ника Мен көп жұмыс істеймін.
Dialogue: 0,0:13:17.29,0:13:18.92,Default,,0,0,0,,Біз де ұтыла алмаймыз
Dialogue: 0,0:13:19.00,0:13:21.67,Default,,0,0,0,,Хмм, ол туралы ше?
Dialogue: 0,0:13:21.75,0:13:23.21,Default,,0,0,0,,(Үш ашулы дауыс)
Dialogue: 0,0:13:24.05,0:13:26.09,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:13:28.18,0:13:31.10,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:31.18,0:13:33.22,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:36.02,0:13:38.48,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса, жеңілме
Dialogue: 0,0:13:38.56,0:13:39.77,Default,,0,0,0,,Гамба!
Dialogue: 0,0:13:39.86,0:13:41.61,Default,,0,0,0,,Көп жұмыс жасаңыз.
Dialogue: 0,0:13:41.69,0:13:43.15,Default,,0,0,0,,Токонацу да, Ника да
Dialogue: 0,0:13:45.28,0:13:47.74,Default,,0,0,0,,А-а, жақын қалды, сондықтан бар күшіңізді салыңыз!
Dialogue: 0,0:13:47.82,0:13:49.91,Default,,0,0,0,,Бар! Taero!
Dialogue: 0,0:13:49.99,0:13:51.33,Default,,0,0,0,,Ха...
Dialogue: 0,0:13:51.41,0:13:52.74,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:55.08,0:13:56.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:56.79,0:13:59.42,Default,,0,0,0,,Айналдыру Акиоға 1 ұпай береді
Dialogue: 0,0:13:59.50,0:14:01.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:03.46,0:14:06.17,Default,,0,0,0,,А...эй, сәл күте тұрыңыз.
Dialogue: 0,0:14:06.26,0:14:08.26,Default,,0,0,0,,Ника, бәрібір.
Dialogue: 0,0:14:08.34,0:14:10.39,Default,,0,0,0,,Келесі Сізге бар күшіңізді салу керек
Dialogue: 0,0:14:10.47,0:14:12.39,Default,,0,0,0,,Мм... кешіріңіз.
Dialogue: 0,0:14:12.47,0:14:14.18,Default,,0,0,0,,Келесі жолы менімен бірге жасаңыз!
Dialogue: 0,0:14:14.27,0:14:15.85,Default,,0,0,0,,Иә, мен мұны істеймін!
Dialogue: 0,0:14:15.93,0:14:17.77,Default,,0,0,0,,Сіз күліп жатырсыз.
Dialogue: 0,0:14:17.85,0:14:19.48,Default,,0,0,0,,Себебі келесі жолы мен жеңемін.
Dialogue: 0,0:14:19.56,0:14:22.19,Default,,0,0,0,,Керемет! Ұрыс!
Dialogue: 0,0:14:22.27,0:14:23.73,Default,,0,0,0,,Жеңіңіз немесе жеңіліңіз...
Dialogue: 0,0:14:24.57,0:14:26.03,Default,,0,0,0,,Сіз күлесіз...
Dialogue: 0,0:14:36.75,0:14:39.58,Default,,0,0,0,,Валькири Сіз туралы...
Dialogue: 0,0:14:39.67,0:14:41.54,Default,,0,0,0,,Мен оны мүлдем көрмедім.
Dialogue: 0,0:14:42.33,0:14:43.92,Default,,0,0,0,,Даа!
Dialogue: 0,0:14:44.00,0:14:46.42,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:46.63,0:14:47.67,Default,,0,0,0,,Бал-нии!
Dialogue: 0,0:14:47.76,0:14:49.09,Default,,0,0,0,,Мен үйге бара жатыр едім.
Dialogue: 0,0:14:49.17,0:14:50.43,Default,,0,0,0,,Мен де істеймін!
Dialogue: 0,0:14:50.51,0:14:52.01,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:14:52.09,0:14:53.97,Default,,0,0,0,,Бару-нии: Аяқ киім!
Dialogue: 0,0:14:55.22,0:14:58.73,Default,,0,0,0,,Хмм, толық жазылу үшін бір ай қажет.
Dialogue: 0,0:14:59.31,0:15:01.85,Default,,0,0,0,,Бір ай...?
Dialogue: 0,0:15:01.94,0:15:05.15,Default,,0,0,0,,Оң иығыңызға қатты салмақ түсіретін сияқтысыз...
Dialogue: 0,0:15:05.23,0:15:07.53,Default,,0,0,0,,Сіз қандай да бір спорт түрімен айналысасыз ба?
Dialogue: 0,0:15:07.90,0:15:09.45,Default,,0,0,0,,Бейблейд
Dialogue: 0,0:15:09.53,0:15:11.91,Default,,0,0,0,,А, сен Блейдерсің бе?
Dialogue: 0,0:15:12.36,0:15:13.41,Default,,0,0,0,,Иә
Dialogue: 0,0:15:13.49,0:15:14.66,Default,,0,0,0,,Бірақ қазір
Dialogue: 0,0:15:14.74,0:15:17.45,Default,,0,0,0,,Дұрыс емделуге көңіл бөлу
Dialogue: 0,0:15:17.75,0:15:19.46,Default,,0,0,0,,Бір айға тыйым салынады
Dialogue: 0,0:15:19.54,0:15:20.37,Default,,0,0,0,,Зұлым орыннан қозғалмайды!
Dialogue: 0,0:15:20.46,0:15:21.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:24.46,0:15:28.05,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:15:29.34,0:15:31.13,Default,,0,0,0,,Аурухана дегеніміз не?
Dialogue: 0,0:15:32.01,0:15:34.97,Default,,0,0,0,,Баптауда ақау бар ма?
Dialogue: 0,0:15:42.77,0:15:43.90,Default,,0,0,0,,Не...?
Dialogue: 0,0:15:43.98,0:15:45.77,Default,,0,0,0,,Таңертеңгі уақытта қалыптан тыс кернеу
Dialogue: 0,0:15:45.86,0:15:47.32,Default,,0,0,0,,Мен тынышталдым деп ойладым...
Dialogue: 0,0:15:47.78,0:15:51.36,Default,,0,0,0,,Иә, байқадым.
Dialogue: 0,0:15:51.70,0:15:52.40,Default,,0,0,0,,Менде қандай да бір дарын бар адам сияқты көрінемін бе?
Dialogue: 0,0:15:52.74,0:15:55.24,Default,,0,0,0,,Қарау керек нәрсе ішкі жағы емес
Dialogue: 0,0:15:55.32,0:15:56.33,Default,,0,0,0,,Бей!
Dialogue: 0,0:15:56.41,0:15:58.87,Default,,0,0,0,,Мен мүлде түсінбеймін
Dialogue: 0,0:15:58.95,0:16:01.75,Default,,0,0,0,,Жақсы, мен түсінгенімше.
Dialogue: 0,0:16:01.83,0:16:03.71,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:16:03.79,0:16:06.21,Default,,0,0,0,,Балт ең жігерлі.
Dialogue: 0,0:16:06.29,0:16:08.30,Default,,0,0,0,,А, мен хабарлама алдым!
Dialogue: 0,0:16:08.38,0:16:10.46,Default,,0,0,0,,Дұрыс, Шу-куннан.
Dialogue: 0,0:16:10.55,0:16:11.80,Default,,0,0,0,,Шудан?
Dialogue: 0,0:16:11.88,0:16:13.59,Default,,0,0,0,,Мен саябақта жаттығатынмын.
Dialogue: 0,0:16:13.68,0:16:16.01,Default,,0,0,0,,Жарайды, ағама айтар сөзім бар.
Dialogue: 0,0:16:16.10,0:16:18.18,Default,,0,0,0,,«Валькири қалай?»
Dialogue: 0,0:16:18.97,0:16:22.60,Default,,0,0,0,,«Валькири қалай?» Мен қызық…
Dialogue: 0,0:16:24.44,0:16:25.77,Default,,0,0,0,,Ол қатып қалды...
Dialogue: 0,0:16:28.27,0:16:30.03,Default,,0,0,0,,Шу~
Dialogue: 0,0:16:30.94,0:16:33.03,Default,,0,0,0,,Кішігірім болмағаны сирек.
Dialogue: 0,0:16:33.24,0:16:34.57,Default,,0,0,0,,Хехехе
Dialogue: 0,0:16:34.66,0:16:36.53,Default,,0,0,0,,Сіз кеше Ника мен басқаларды кездестірдіңіз, солай ма?
Dialogue: 0,0:16:36.62,0:16:37.49,Default,,0,0,0,,Ах
Dialogue: 0,0:16:37.57,0:16:40.49,Default,,0,0,0,,Валькири жақсы хехе~
Dialogue: 0,0:16:40.58,0:16:41.58,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:16:41.66,0:16:44.12,Default,,0,0,0,,Сондықтан мен сендерге өзімнің қалай жүргенімді көрсетемін
Dialogue: 0,0:16:44.21,0:16:46.29,Default,,0,0,0,,Сабақтан кейін Бей клубына келіңіз.
Dialogue: 0,0:16:46.38,0:16:47.92,Default,,0,0,0,,Шайқасайық!
Dialogue: 0,0:16:48.00,0:16:49.46,Default,,0,0,0,,Жоқ...Мен...
Dialogue: 0,0:16:49.55,0:16:50.92,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:16:51.01,0:16:54.34,Default,,0,0,0,,Мен шайқаста Вакия Комурасакиден жеңіліп қалдым.
Dialogue: 0,0:16:54.80,0:16:57.85,Default,,0,0,0,,Бұл жиіркенішті, мен нені қарасам да, ақымақ сияқты...
Dialogue: 0,0:16:57.93,0:17:01.02,Default,,0,0,0,,Сондықтан мен Валькириді де көре алмадым.
Dialogue: 0,0:17:01.27,0:17:02.98,Default,,0,0,0,,Маған ұқсамайды.
Dialogue: 0,0:17:03.06,0:17:04.89,Default,,0,0,0,,Бұл, әрине, олай емес сияқты.
Dialogue: 0,0:17:04.98,0:17:05.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:05.85,0:17:07.15,Default,,0,0,0,,Сіз ойланып отырсыз
Dialogue: 0,0:17:07.23,0:17:09.02,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:09.90,0:17:10.73,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:17:11.23,0:17:12.11,Default,,0,0,0,,Мектептен кейін
Dialogue: 0,0:17:12.19,0:17:14.11,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:14.90,0:17:17.61,Default,,0,0,0,,Хехехе~ Хэхехехе~
Dialogue: 0,0:17:17.70,0:17:19.91,Default,,0,0,0,,Кешегіден мүлде басқаша.
Dialogue: 0,0:17:19.99,0:17:21.29,Default,,0,0,0,,Жақсы нәрсе болды ма?
Dialogue: 0,0:17:21.37,0:17:24.46,Default,,0,0,0,,Шу бүгін Бей клубқа келеді!
Dialogue: 0,0:17:24.54,0:17:25.96,Default,,0,0,0,,Не! Шуу!
Dialogue: 0,0:17:26.04,0:17:28.25,Default,,0,0,0,,Мен сізге шайқасқа уәде бердім!
Dialogue: 0,0:17:28.33,0:17:30.00,Default,,0,0,0,,Мен оны асыға күтемін!
Dialogue: 0,0:17:33.26,0:17:34.59,Default,,0,0,0,,Ағай~
Dialogue: 0,0:17:34.67,0:17:35.84,Default,,0,0,0,,Бал-нии~
Dialogue: 0,0:17:35.92,0:17:38.14,Default,,0,0,0,,Ой, балалар не істеп жатырсыңдар?
Dialogue: 0,0:17:38.22,0:17:39.68,Default,,0,0,0,,Шу-кун келе жатыр.
Dialogue: 0,0:17:39.76,0:17:41.68,Default,,0,0,0,,Біз де шайқасты тамашаладық!
Dialogue: 0,0:17:43.47,0:17:44.77,Default,,0,0,0,,О!
Dialogue: 0,0:17:44.85,0:17:46.44,Default,,0,0,0,,Келдің бе, Шу?
Dialogue: 0,0:17:46.52,0:17:48.44,Default,,0,0,0,,Тез орындайық!
Dialogue: 0,0:17:48.52,0:17:51.61,Default,,0,0,0,,Эй, сен шынымен ашуланып тұрсың.
Dialogue: 0,0:17:51.69,0:17:54.23,Default,,0,0,0,,Кешегі жеңіс қайда кетті?
Dialogue: 0,0:17:54.65,0:17:56.28,Default,,0,0,0,,Мен жеңгім келеді, әрине!
Dialogue: 0,0:17:56.74,0:17:58.07,Default,,0,0,0,,Жалап жатқан...
Dialogue: 0,0:17:58.16,0:18:00.62,Default,,0,0,0,,Жалғыз, мен сондай ыстықпын...
Dialogue: 0,0:18:00.70,0:18:03.37,Default,,0,0,0,,Сонда Валькири артта қалады.
Dialogue: 0,0:18:03.45,0:18:05.75,Default,,0,0,0,,Бей жалғыз күресе алмайды.
Dialogue: 0,0:18:05.83,0:18:08.37,Default,,0,0,0,,Блэдер мен Бей бірге жұмыс істеуі керек.
Dialogue: 0,0:18:08.75,0:18:10.88,Default,,0,0,0,,Ал, қазір шығанақ клубы бар.
Dialogue: 0,0:18:10.96,0:18:14.63,Default,,0,0,0,,Достарың көбейген, Бай - ең жақсы! Мен солай ойладым
Dialogue: 0,0:18:15.51,0:18:17.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:18.68,0:18:20.30,Default,,0,0,0,,Егер ұйықтап жатқанда Толық шоғырлану тынысын тоқтатсам,
Dialogue: 0,0:18:20.39,0:18:21.60,Default,,0,0,0,,Бар-нии
Dialogue: 0,0:18:21.68,0:18:23.97,Default,,0,0,0,,Яббе, бұл жігіттің даналық қызуы бар.
Dialogue: 0,0:18:24.06,0:18:25.47,Default,,0,0,0,,Салқындатыңыз
Dialogue: 0,0:18:25.56,0:18:27.27,Default,,0,0,0,,Су Су Су～
Dialogue: 0,0:18:27.35,0:18:29.85,Default,,0,0,0,,Себебі мен байыпты сөйлеймін.
Dialogue: 0,0:18:31.36,0:18:33.40,Default,,0,0,0,,Бірінші шайқас!
Dialogue: 0,0:18:34.78,0:18:35.57,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:18:35.65,0:18:37.24,Default,,0,0,0,,Кеттік! Досым!
Dialogue: 0,0:18:38.15,0:18:40.66,Default,,0,0,0,,Өзіңіздің иығыңыз үшін бір әрекетте шешім қабылдаңыз
Dialogue: 0,0:18:43.91,0:18:44.91,Default,,0,0,0,,Уф!
Dialogue: 0,0:18:48.04,0:18:49.54,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:49.62,0:18:52.79,Default,,0,0,0,,Шу? (Рантаро) Пішін әдеттегіден басқаша.
Dialogue: 0,0:18:52.88,0:18:55.21,Default,,0,0,0,,Ей, бұл жаңа ерекше қозғалыс па?
Dialogue: 0,0:18:55.30,0:18:57.21,Default,,0,0,0,,Шу дамыды ма?
Dialogue: 0,0:18:57.30,0:18:58.30,Default,,0,0,0,,Бұл шынымен де…
Dialogue: 0,0:18:58.38,0:19:00.43,Default,,0,0,0,,Мен жай ғана нәрселерді сынап жатырмын.
Dialogue: 0,0:19:01.51,0:19:04.01,Default,,0,0,0,,Бұл керемет, Шу!
Dialogue: 0,0:19:05.76,0:19:08.39,Default,,0,0,0,,Бірақ мен және Валькири...
Dialogue: 0,0:19:08.48,0:19:10.64,Default,,0,0,0,,Бірге жұмыс жасасақ, керемет болар еді
Dialogue: 0,0:19:10.73,0:19:11.77,Default,,0,0,0,,Мен саған көрсетемін!
Dialogue: 0,0:19:13.11,0:19:15.11,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:19:15.19,0:19:18.49,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:19.03,0:19:20.24,Default,,0,0,0,,Таныстырулар!
Dialogue: 0,0:19:23.53,0:19:24.66,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:19:24.74,0:19:25.66,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:25.74,0:19:26.83,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:19:44.05,0:19:46.31,Default,,0,0,0,,Жақсы, Балто! бұл қозғалыс
Dialogue: 0,0:19:46.39,0:19:47.93,Default,,0,0,0,,Кешегі күннен мүлде басқаша
Dialogue: 0,0:19:48.02,0:19:49.73,Default,,0,0,0,,Бұл кәдімгі Валькирия.
Dialogue: 0,0:19:49.81,0:19:52.06,Default,,0,0,0,,Спригганның жылдамдығы да бәсеңдемейді.
Dialogue: 0,0:19:53.19,0:19:55.06,Default,,0,0,0,,Тез ату!
Dialogue: 0,0:19:55.15,0:19:56.94,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:19:59.11,0:20:00.99,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:20:05.41,0:20:06.07,Default,,0,0,0,,Ол шықты~
Dialogue: 0,0:20:06.16,0:20:07.37,Default,,0,0,0,,Тез ату!
Dialogue: 0,0:20:08.20,0:20:11.29,Default,,0,0,0,,Бұл шабуыл тек Спригган үшін ғана емес.
Dialogue: 0,0:20:11.37,0:20:13.08,Default,,0,0,0,,Бұл тіпті маған да ұқсайды
Dialogue: 0,0:20:13.17,0:20:15.79,Default,,0,0,0,,Балт... ол қайтадан күшейіп келеді
Dialogue: 0,0:20:16.88,0:20:18.88,Default,,0,0,0,,Бірақ менің Спригганым...
Dialogue: 0,0:20:18.96,0:20:20.55,Default,,0,0,0,,Ешқашан жеңілме
Dialogue: 0,0:20:20.63,0:20:22.13,Default,,0,0,0,,Спригган!
Dialogue: 0,0:20:26.05,0:20:29.26,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:20:33.27,0:20:34.35,Default,,0,0,0,,(Қайшының кесу дыбысы)
Dialogue: 0,0:20:37.94,0:20:39.52,Default,,0,0,0,,Қарсы үзіліс!
Dialogue: 0,0:20:46.24,0:20:48.33,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:20:53.91,0:20:56.12,Default,,0,0,0,,Физикалық түрде ондай үстел жоқ.
Dialogue: 0,0:20:56.21,0:20:57.58,Default,,0,0,0,,Міне, барамын!
Dialogue: 0,0:20:57.67,0:21:00.34,Default,,0,0,0,,Шу «Best Finish» ойынымен жеңеді!
Dialogue: 0,0:21:01.80,0:21:03.17,Default,,0,0,0,,Керемет!
Dialogue: 0,0:21:03.88,0:21:06.26,Default,,0,0,0,,Шуу керемет~
Dialogue: 0,0:21:06.34,0:21:08.93,Default,,0,0,0,,Өте ыстық болды! Қазір шайқас!
Dialogue: 0,0:21:09.01,0:21:10.85,Default,,0,0,0,,Рахмет, Шу!
Dialogue: 0,0:21:11.60,0:21:15.31,Default,,0,0,0,,Мен көбірек тырысамын және күшті боламын!
Dialogue: 0,0:21:15.89,0:21:17.81,Default,,0,0,0,,Мен финалға міндетті түрде барамын!
Dialogue: 0,0:21:18.90,0:21:20.11,Default,,0,0,0,,Мен оны асыға күтемін
Dialogue: 0,0:21:21.73,0:21:24.11,Default,,0,0,0,,А... сен кетіп қалдың ба?
Dialogue: 0,0:21:24.19,0:21:25.90,Default,,0,0,0,,Сіз көбірек істей алмайсыз ба?
Dialogue: 0,0:21:25.99,0:21:28.32,Default,,0,0,0,,Мен тек бір рет болады деп уәде бердім.
Dialogue: 0,0:21:29.03,0:21:30.91,Default,,0,0,0,,Олай болса, имбирь туралы не айтасыз?
Dialogue: 0,0:21:30.99,0:21:33.33,Default,,0,0,0,,Біз де солай істейміз деп ойладым.
Dialogue: 0,0:21:33.41,0:21:35.71,Default,,0,0,0,,Хихи~ Бұл жаман.
Dialogue: 0,0:21:35.79,0:21:37.92,Default,,0,0,0,,Осы жолы өзіміз жасайық!
Dialogue: 0,0:21:38.00,0:21:39.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:21:39.42,0:21:41.09,Default,,0,0,0,,Жақсы, Валькири.
Dialogue: 0,0:21:41.17,0:21:42.84,Default,,0,0,0,,Қашықтық~
Dialogue: 0,0:21:42.92,0:21:44.59,Default,,0,0,0,,Бар-нии!
Dialogue: 0,0:21:44.67,0:21:45.92,Default,,0,0,0,,Инсуке Ганба!
Dialogue: 0,0:21:46.01,0:21:49.01,Default,,0,0,0,,Бұл Инуске емес, бұл Инуске!
Dialogue: 0,0:21:49.43,0:21:50.64,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:21:51.22,0:21:52.14,Default,,0,0,0,,Барт…
Dialogue: 0,0:21:52.22,0:21:54.93,Default,,0,0,0,,(Балтоның күлкісі)
Dialogue: 0,0:22:09.16,0:22:15.25,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.45,0:22:21.59,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.04,0:22:27.59,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.05,0:22:31.39,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.55,0:22:36.48,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.39,0:22:41.10,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.19,0:22:44.40,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.48,0:22:50.82,Default,,0,0,0,,Артынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.07,0:22:56.62,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.79,0:23:03.38,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:03.96,0:23:09.38,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.55,0:23:12.72,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.22,0:23:17.18,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.53,0:23:28.07,Default,,0,0,0,,Шу жарақат алды ма?
Dialogue: 0,0:23:28.15,0:23:29.19,Default,,0,0,0,,Барлық жерде міндетті түрде өмір сүруге құқығы жоқ адамдар бар,
Dialogue: 0,0:23:29.28,0:23:31.61,Default,,0,0,0,,Оның бұлай болуы мүмкін емес.
Dialogue: 0,0:23:31.70,0:23:33.20,Default,,0,0,0,,Жарайды, Шу.
Dialogue: 0,0:23:33.28,0:23:36.08,Default,,0,0,0,,Әйтпесе, жартылай финал қызық болмас еді.
Dialogue: 0,0:23:36.62,0:23:39.87,Default,,0,0,0,,Не, Вакия, сен не ойлап тұрсың?
Dialogue: 0,0:23:39.96,0:23:42.25,Default,,0,0,0,,Киіміңізді сүртуді тоқтатыңыз.
Dialogue: 0,0:23:42.58,0:23:44.42,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:44.50,0:23:46.04,Default,,0,0,0,,Үмітсіздік Спригган
Dialogue: 0,0:23:46.13,0:23:47.88,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.96,0:23:49.67,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.17,0:23:57.17,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory