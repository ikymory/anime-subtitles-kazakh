Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.59,0:00:09.17,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.25,0:00:12.34,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.84,0:00:14.84,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.93,0:00:17.01,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.10,0:00:18.81,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.48,0:00:24.23,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.31,0:00:26.40,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.48,0:00:28.82,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.57,0:00:33.95,Default,,0,0,0,,Қалқанмен атумен аяқтау
Dialogue: 0,0:00:34.03,0:00:35.61,Default,,0,0,0,,Міне.
Dialogue: 0,0:00:36.24,0:00:37.99,Default,,0,0,0,,Ешкім оларды оятпаса…
Dialogue: 0,0:00:38.45,0:00:39.45,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:00:43.41,0:00:46.33,Default,,0,0,0,,Жарқын түсірілім!
Dialogue: 0,0:00:53.59,0:00:55.76,Default,,0,0,0,,Күте тұрыңыз, Вайверн!
Dialogue: 0,0:00:58.14,0:00:58.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:59.01,0:01:00.10,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:01:01.22,0:01:03.02,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:01:03.10,0:01:05.39,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:01:05.48,0:01:06.73,Default,,0,0,0,,Шамасы...
Dialogue: 0,0:01:06.81,0:01:09.36,Default,,0,0,0,,Маған қаншалықты байсалды екеніңізді көрсетіңіз. Мен түсінбедім.
Dialogue: 0,0:01:10.57,0:01:12.53,Default,,0,0,0,,(Қатты құлаған дыбыс)
Dialogue: 0,0:01:16.11,0:01:17.49,Default,,0,0,0,,Әлгі жігіт-
Dialogue: 0,0:01:17.57,0:01:20.03,Default,,0,0,0,,Сіз осындай бірдеңені киіп ұрыстыңыз ба?
Dialogue: 0,0:01:20.41,0:01:23.66,Default,,0,0,0,,А, мен жеңіл ыңылдадым.
Dialogue: 0,0:01:23.75,0:01:26.66,Default,,0,0,0,,Міне, мұның бәрі көңіл көтеру үшін.
Dialogue: 0,0:01:28.75,0:01:30.21,Default,,0,0,0,,Ең күшті шығанақ-
Dialogue: 0,0:01:30.29,0:01:32.30,Default,,0,0,0,,Мынау жабайы уайвер!
Dialogue: 0,0:01:32.38,0:01:33.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:41.76,0:01:44.14,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:44.47,0:01:49.65,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:02:00.95,0:02:04.33,Default,,0,0,0,,Мен барлығында бар екеніне сенімдімін.
Dialogue: 0,0:02:04.83,0:02:06.96,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:02:07.37,0:02:11.50,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:11.63,0:02:14.84,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:02:14.96,0:02:21.39,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:21.68,0:02:26.10,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:26.60,0:02:32.02,Default,,0,0,0,,Дауысты дауыстап, дірілдеп ойнайық
Dialogue: 0,0:02:32.15,0:02:34.40,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:34.48,0:02:39.20,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:39.36,0:02:44.45,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:44.74,0:02:47.00,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:47.20,0:02:49.54,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:49.83,0:02:53.75,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:53.92,0:02:58.92,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:59.13,0:03:01.30,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:05.31,0:03:07.72,Default,,0,0,0,,Қалқанның таңғажайып апаты!
Dialogue: 0,0:03:09.31,0:03:11.44,Default,,0,0,0,,Соңында соққы алмасқан адамның сен болғаныңа қуаныштымын
Dialogue: 0,0:03:16.73,0:03:19.61,Default,,0,0,0,,Салмақпен осылай ату керек пе?
Dialogue: 0,0:03:19.69,0:03:21.49,Default,,0,0,0,,Қандай жігіт
Dialogue: 0,0:03:21.65,0:03:24.37,Default,,0,0,0,,Бұрынғыдан әлдеқайда күшті көрінеді...
Dialogue: 0,0:03:24.45,0:03:25.91,Default,,0,0,0,,Бұл жасырын
Dialogue: 0,0:03:27.49,0:03:30.71,Default,,0,0,0,,Қолтығым бұрынғыдан да үлкен көрінеді
Dialogue: 0,0:03:31.25,0:03:33.50,Default,,0,0,0,,Қандай кішкентай күлгін вакия
Dialogue: 0,0:03:33.58,0:03:35.63,Default,,0,0,0,,Мен киген салмақты тастадым!
Dialogue: 0,0:03:35.71,0:03:38.13,Default,,0,0,0,,Ол одан да күшті бола ма?
Dialogue: 0,0:03:38.88,0:03:40.97,Default,,0,0,0,,Осымен ойын аяқталды ма?
Dialogue: 0,0:03:41.72,0:03:44.68,Default,,0,0,0,,Бұл қиын шайқас болады, Балто.
Dialogue: 0,0:03:46.35,0:03:48.68,Default,,0,0,0,,Бұл мен күштірек атуға болатынымды білдіре ме...
Dialogue: 0,0:03:49.18,0:03:50.39,Default,,0,0,0,,…
Dialogue: 0,0:03:50.48,0:03:51.56,Default,,0,0,0,,Бар аға...
Dialogue: 0,0:03:52.89,0:03:55.10,Default,,0,0,0,,Керемет жұмыс!
Dialogue: 0,0:03:55.19,0:03:55.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:56.56,0:03:58.90,Default,,0,0,0,,Оған салмақ салыңыз, солай ма?
Dialogue: 0,0:03:58.98,0:04:02.53,Default,,0,0,0,,Олай болса, бұдан былай бұдан да көп шайқастар жасай аламыз!
Dialogue: 0,0:04:05.16,0:04:05.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:06.07,0:04:07.58,Default,,0,0,0,,Не болады?
Dialogue: 0,0:04:07.66,0:04:09.49,Default,,0,0,0,,Қызықты жартылай финал!
Dialogue: 0,0:04:10.16,0:04:11.37,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:04:13.08,0:04:14.25,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:04:14.42,0:04:16.42,Default,,0,0,0,,Тағы бір түсірілім
Dialogue: 0,0:04:17.25,0:04:20.00,Default,,0,0,0,,Бұрынғыдай емес.
Dialogue: 0,0:04:20.26,0:04:22.05,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:04:22.42,0:04:25.84,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:04:26.05,0:04:28.81,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:04:36.98,0:04:37.94,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:04:38.02,0:04:40.61,Default,,0,0,0,,Бұл флеш түсіру!
Dialogue: 0,0:04:40.78,0:04:41.94,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:04:42.03,0:04:42.86,Default,,0,0,0,,Иә!
Dialogue: 0,0:04:42.94,0:04:45.49,Default,,0,0,0,,Жарайды, мен мұны түсіндім!
Dialogue: 0,0:04:46.11,0:04:49.03,Default,,0,0,0,,Алайда, ол уиверннің шабуылына мән бермеді.
Dialogue: 0,0:04:49.12,0:04:50.66,Default,,0,0,0,,Орталыққа оралыңыз!
Dialogue: 0,0:04:50.74,0:04:53.08,Default,,0,0,0,,Бірінші шайқас сияқты даму!
Dialogue: 0,0:04:53.62,0:04:55.25,Default,,0,0,0,,Жоқ, жоқ...
Dialogue: 0,0:04:55.83,0:04:58.25,Default,,0,0,0,,Екеуі тағы да соқтығысты!
Dialogue: 0,0:04:58.33,0:05:01.59,Default,,0,0,0,,Валькири қайтадан шабуылдады!
Dialogue: 0,0:05:03.09,0:05:04.13,Default,,0,0,0,,Бұл нақты нәрсе-
Dialogue: 0,0:05:04.55,0:05:05.88,Default,,0,0,0,,Қалқан апаты!
Dialogue: 0,0:05:09.51,0:05:10.39,Default,,0,0,0,,Ах
Dialogue: 0,0:05:10.64,0:05:12.56,Default,,0,0,0,,Аяқталды!
Dialogue: 0,0:05:12.64,0:05:15.31,Default,,0,0,0,,Жабайы Вайверн 1 ұпай
Dialogue: 0,0:05:15.39,0:05:17.31,Default,,0,0,0,,1-ден 1-ге дейінгі тармақтар!
Dialogue: 0,0:05:17.40,0:05:19.36,Default,,0,0,0,,Сенгісіз!
Dialogue: 0,0:05:19.44,0:05:22.19,Default,,0,0,0,,Жабайы Уайверннің жаңа техникасы жарылып жатыр!
Dialogue: 0,0:05:22.73,0:05:24.53,Default,,0,0,0,,Жарық түсіру...
Dialogue: 0,0:05:24.61,0:05:26.07,Default,,0,0,0,,Сынған...
Dialogue: 0,0:05:26.15,0:05:28.20,Default,,0,0,0,,Түсірілім сәтті өтті!
Dialogue: 0,0:05:28.28,0:05:29.49,Default,,0,0,0,,Сіз нені айтасыз...?
Dialogue: 0,0:05:29.82,0:05:32.37,Default,,0,0,0,,Вивернді қалай аяқтауға болады
Dialogue: 0,0:05:32.91,0:05:34.25,Default,,0,0,0,,Таяз соққы
Dialogue: 0,0:05:34.33,0:05:36.91,Default,,0,0,0,,Оны лақтыру керек.
Dialogue: 0,0:05:39.42,0:05:41.67,Default,,0,0,0,,Бірақ салмақты алып тастау арқылы
Dialogue: 0,0:05:41.75,0:05:45.21,Default,,0,0,0,,Вакияның өркендері бұрынғыдан әлдеқайда күшті болды.
Dialogue: 0,0:05:45.51,0:05:48.34,Default,,0,0,0,,Вайверннің жылдамдығы мен айналуы жылдамырақ болады.
Dialogue: 0,0:05:48.43,0:05:49.43,Default,,0,0,0,,Валькири
Dialogue: 0,0:05:49.51,0:05:52.68,Default,,0,0,0,,Екінші шабуылды бетпе-бет жасау туралы шешім қабылданды.
Dialogue: 0,0:05:54.97,0:05:57.56,Default,,0,0,0,,Shield Crash қарсыластың шабуыл күшін азайтады-
Dialogue: 0,0:05:57.64,0:06:00.15,Default,,0,0,0,,Өлімге әкелетін есептегіштерді максималды пайдалану
Dialogue: 0,0:06:00.23,0:06:02.57,Default,,0,0,0,,Қарсыластың шабуылы неғұрлым күшті болса
Dialogue: 0,0:06:02.65,0:06:03.94,Default,,0,0,0,,Өз күшіңізді көрсетіңіз
Dialogue: 0,0:06:04.48,0:06:05.86,Default,,0,0,0,,Дұрыс, Хоудзи мырза.
Dialogue: 0,0:06:06.24,0:06:07.32,Default,,0,0,0,,О
Dialogue: 0,0:06:07.70,0:06:10.16,Default,,0,0,0,,Жақындап келе жатқан Валькирияның үдеуі
Dialogue: 0,0:06:10.57,0:06:12.66,Default,,0,0,0,,Вайверннің жеке шабуыл күші
Dialogue: 0,0:06:13.08,0:06:14.66,Default,,0,0,0,,Барлық қуат...
Dialogue: 0,0:06:14.74,0:06:18.00,Default,,0,0,0,,Shield Crash жарылғыш жойғыш күшін жасады.
Dialogue: 0,0:06:18.75,0:06:20.25,Default,,0,0,0,,Бұл бала...
Dialogue: 0,0:06:21.13,0:06:22.71,Default,,0,0,0,,Виверннің сұмдығы
Dialogue: 0,0:06:26.55,0:06:28.76,Default,,0,0,0,,Жарылыс өте нашар болды ма?
Dialogue: 0,0:06:28.84,0:06:31.76,Default,,0,0,0,,Шынында да, бұл тек сәттілік.
Dialogue: 0,0:06:32.05,0:06:33.26,Default,,0,0,0,,Күшті...
Dialogue: 0,0:06:33.35,0:06:35.26,Default,,0,0,0,,Бұл керемет күш...
Dialogue: 0,0:06:35.35,0:06:37.81,Default,,0,0,0,,Тіпті флэш түсірілімі де бұзылған.
Dialogue: 0,0:06:37.89,0:06:39.56,Default,,0,0,0,,Мен енді Балтоға көмектесе алмаймын...
Dialogue: 0,0:06:39.89,0:06:41.19,Default,,0,0,0,,Бұл...
Dialogue: 0,0:06:41.27,0:06:42.27,Default,,0,0,0,,…
Dialogue: 0,0:06:42.81,0:06:44.73,Default,,0,0,0,,Енді түсіндің, солай ма?
Dialogue: 0,0:06:44.90,0:06:47.07,Default,,0,0,0,,Тез түсіру және жылдам түсіру
Dialogue: 0,0:06:47.15,0:06:49.20,Default,,0,0,0,,Мен бұл уайвернмен сөйлесе алмаймын.
Dialogue: 0,0:06:49.40,0:06:51.78,Default,,0,0,0,,Куу~
Dialogue: 0,0:06:51.86,0:06:53.95,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:06:54.24,0:06:54.99,Default,,0,0,0,,На
Dialogue: 0,0:06:55.24,0:06:57.37,Default,,0,0,0,,Міне осылай, Валькири!
Dialogue: 0,0:06:57.45,0:06:59.25,Default,,0,0,0,,Мықты көлденең!
Dialogue: 0,0:06:59.33,0:07:00.62,Default,,0,0,0,,Оның шайқалуына жол бермеңіз!
Dialogue: 0,0:07:00.71,0:07:02.04,Default,,0,0,0,,Жарайды, жарайды!
Dialogue: 0,0:07:05.75,0:07:06.96,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:07:07.92,0:07:09.22,Default,,0,0,0,,Бұл адам мені священник деп қате түсінген
Dialogue: 0,0:07:09.30,0:07:11.38,Default,,0,0,0,,Тағы бір түсірілім!
Dialogue: 0,0:07:11.76,0:07:13.05,Default,,0,0,0,,Бұл жолы
Dialogue: 0,0:07:13.14,0:07:15.30,Default,,0,0,0,,Қалқанның соғылуымен жарылу
Dialogue: 0,0:07:15.64,0:07:17.39,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:07:17.89,0:07:21.27,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:07:21.48,0:07:23.98,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:07:24.19,0:07:27.48,Default,,0,0,0,,Ой, үшінші шайқасқа да солай!
Dialogue: 0,0:07:27.57,0:07:29.36,Default,,0,0,0,,Қалқанмен ату VS
Dialogue: 0,0:07:29.44,0:07:32.74,Default,,0,0,0,,Бұл флэш түсіру сайысы!
Dialogue: 0,0:07:34.37,0:07:37.03,Default,,0,0,0,,Жоқ, уайверн тез оралады!
Dialogue: 0,0:07:37.12,0:07:38.74,Default,,0,0,0,,Алдыңғы жағына тағы бір рет соғыңыз!
Dialogue: 0,0:07:38.83,0:07:40.83,Default,,0,0,0,,Екеуі тағы да соқтығысты!
Dialogue: 0,0:07:41.21,0:07:43.42,Default,,0,0,0,,Жарайды, Shield Crash!
Dialogue: 0,0:07:47.63,0:07:48.50,Default,,0,0,0,,Не?
Dialogue: 0,0:07:48.59,0:07:50.55,Default,,0,0,0,,Валькири өзін ұстай алды!
Dialogue: 0,0:07:50.63,0:07:53.63,Default,,0,0,0,,Бұл жолы Shield Crash күші әлсіз бе?
Dialogue: 0,0:07:53.72,0:07:56.76,Default,,0,0,0,,Ах! Қайтадан қақтығыс!
Dialogue: 0,0:07:56.85,0:08:00.31,Default,,0,0,0,,Бірақ Валькири де винтті қозғалта алмайды.
Dialogue: 0,0:08:00.39,0:08:02.19,Default,,0,0,0,,Бір жерде соқтығыс...
Dialogue: 0,0:08:02.27,0:08:03.90,Default,,0,0,0,,Жалғастыруда!
Dialogue: 0,0:08:04.40,0:08:06.31,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:08:06.52,0:08:09.48,Default,,0,0,0,,Екінші шайқастан бастап Валькирияның жылдамдығы артады.
Dialogue: 0,0:08:10.07,0:08:12.36,Default,,0,0,0,,Соғу орны сәл өзгерді.
Dialogue: 0,0:08:12.65,0:08:14.74,Default,,0,0,0,,Бейдің күші не болып жатыр.
Dialogue: 0,0:08:14.95,0:08:15.70,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:08:16.03,0:08:18.28,Default,,0,0,0,,Бар, жүр, жүр!
Dialogue: 0,0:08:18.37,0:08:20.20,Default,,0,0,0,,Екі жақ та бір дюймді де тастамайды
Dialogue: 0,0:08:20.29,0:08:22.33,Default,,0,0,0,,Бұл матчта не болады?
Dialogue: 0,0:08:23.46,0:08:24.50,Default,,0,0,0,,Хмм…
Dialogue: 0,0:08:24.58,0:08:26.38,Default,,0,0,0,,Егер бұл жігітпен тұрақты шайқас болса.
Dialogue: 0,0:08:26.46,0:08:28.54,Default,,0,0,0,,Вайверннің басымдылығы бар.
Dialogue: 0,0:08:29.30,0:08:32.34,Default,,0,0,0,,Виверн қарсыластың шабуылдарын жай ғана тойтарады.
Dialogue: 0,0:08:32.88,0:08:35.22,Default,,0,0,0,,Қуатты жоғалтпастан айналуды жалғастыра алады
Dialogue: 0,0:08:35.43,0:08:37.64,Default,,0,0,0,,Дегенмен, Валькири шабуылын жалғастыруда.
Dialogue: 0,0:08:37.72,0:08:39.55,Default,,0,0,0,,Мен күш-қуатымды жоғалтып жатырмын...
Dialogue: 0,0:08:39.76,0:08:42.31,Default,,0,0,0,,Валькирияның айналуы
Dialogue: 0,0:08:42.39,0:08:44.39,Default,,0,0,0,,Ол тұрақсыз болып барады!
Dialogue: 0,0:08:44.48,0:08:47.27,Default,,0,0,0,,Бұл айналмалы финиш бола ма?
Dialogue: 0,0:08:47.48,0:08:49.90,Default,,0,0,0,,Мен Валькиридің жеңіліп жатқанын көрдім!
Dialogue: 0,0:08:49.98,0:08:52.74,Default,,0,0,0,,Міне, мен финалға өттім.
Dialogue: 0,0:08:53.86,0:08:55.57,Default,,0,0,0,,Ол келесіде
Dialogue: 0,0:08:58.82,0:09:00.03,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:09:03.37,0:09:06.75,Default,,0,0,0,,Виверн те тепе-теңдігін жоғалтты!
Dialogue: 0,0:09:08.46,0:09:10.88,Default,,0,0,0,,Бір уақытта айналдыруды аяқтау
Dialogue: 0,0:09:11.21,0:09:13.51,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:13.71,0:09:15.93,Default,,0,0,0,,Сіз бұл қуанышты ести аласыз ба?
Dialogue: 0,0:09:16.01,0:09:18.76,Default,,0,0,0,,Бұл жартылай финалға лайықты өрлеу!
Dialogue: 0,0:09:18.97,0:09:20.81,Default,,0,0,0,,Жарайды, сурет сал!
Dialogue: 0,0:09:20.89,0:09:23.27,Default,,0,0,0,,Келесі жолы жеңесің, Бар-нии~
Dialogue: 0,0:09:23.35,0:09:25.02,Default,,0,0,0,,Сәттілік, ағайын!
Dialogue: 0,0:09:25.35,0:09:29.11,Default,,0,0,0,,Мен түсірген сайын Валькиридің дыбысы жарқырайды.
Dialogue: 0,0:09:29.90,0:09:31.98,Default,,0,0,0,,Менің естігім келгені осы еді.
Dialogue: 0,0:09:32.36,0:09:33.69,Default,,0,0,0,,Сурет салу?
Dialogue: 0,0:09:33.78,0:09:36.11,Default,,0,0,0,,Сіздің қазіргі соққыңыз тең нәтиже ме?
Dialogue: 0,0:09:36.40,0:09:37.32,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:09:38.20,0:09:41.20,Default,,0,0,0,,Неліктен сізге ешқашан келмейтін адаммен айналысу керек?
Dialogue: 0,0:09:41.83,0:09:43.91,Default,,0,0,0,,Бала асығыс.
Dialogue: 0,0:09:44.16,0:09:46.91,Default,,0,0,0,,Жоқ, жеңген Виверн болды.
Dialogue: 0,0:09:47.00,0:09:49.17,Default,,0,0,0,,Баланың асығуына еш себеп жоқ.
Dialogue: 0,0:09:49.79,0:09:50.54,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:50.92,0:09:52.71,Default,,0,0,0,,Жарайды, сурет сал!
Dialogue: 0,0:09:52.80,0:09:54.67,Default,,0,0,0,,Кеттік, кеттік!
Dialogue: 0,0:09:55.34,0:09:58.18,Default,,0,0,0,,Баланы бұрышта ұстап тұрған сияқты.
Dialogue: 0,0:09:58.55,0:10:01.35,Default,,0,0,0,,Бар! Иә иә!
Dialogue: 0,0:10:01.68,0:10:03.76,Default,,0,0,0,,Осы соңғы минуттық шайқаста...
Dialogue: 0,0:10:03.85,0:10:06.14,Default,,0,0,0,,Балто қайтадан өсуге тырысады
Dialogue: 0,0:10:06.93,0:10:09.15,Default,,0,0,0,,Жарайды, бірінші жартылай финал ойыны
Dialogue: 0,0:10:09.23,0:10:10.52,Default,,0,0,0,,1:1-
Dialogue: 0,0:10:10.61,0:10:12.57,Default,,0,0,0,,Күшті шайқаста!
Dialogue: 0,0:10:12.65,0:10:15.48,Default,,0,0,0,,Сәттілік! Тағы да!
Dialogue: 0,0:10:15.57,0:10:16.94,Default,,0,0,0,,Бұл соңы
Dialogue: 0,0:10:17.74,0:10:19.41,Default,,0,0,0,,Мен келесі жолы шешемін!
Dialogue: 0,0:10:22.45,0:10:24.29,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:10:24.83,0:10:28.29,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:28.37,0:10:30.71,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:32.00,0:10:34.92,Default,,0,0,0,,Жоқ... бұл... өтірік деп айтыңызшы.
Dialogue: 0,0:10:35.00,0:10:37.26,Default,,0,0,0,,Тағы да сол даму!
Dialogue: 0,0:10:38.34,0:10:39.59,Default,,0,0,0,,Жоқ, Вайверн
Dialogue: 0,0:10:39.68,0:10:41.14,Default,,0,0,0,,Жылдамдық артып келеді!
Dialogue: 0,0:10:41.89,0:10:44.76,Default,,0,0,0,,Валькирияның жылдамдығы да артып келеді!
Dialogue: 0,0:10:45.39,0:10:48.43,Default,,0,0,0,,Бұл менің қалқаныма қарсы жұмыс істемейді!
Dialogue: 0,0:10:53.15,0:10:53.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:54.40,0:10:57.44,Default,,0,0,0,,Бұл жолы екеуі де тойтарыс берді!
Dialogue: 0,0:10:58.90,0:11:01.49,Default,,0,0,0,,Жеңілген қалқан апаты!
Dialogue: 0,0:11:01.57,0:11:02.62,Default,,0,0,0,,Бірақ Валькири де
Dialogue: 0,0:11:02.74,0:11:04.62,Default,,0,0,0,,Түсірілім жолын өткізіп алды.
Dialogue: 0,0:11:05.08,0:11:07.08,Default,,0,0,0,,Валькирияның жылдамдығы төмендемейді
Dialogue: 0,0:11:07.16,0:11:08.50,Default,,0,0,0,,Қабырғаға қарай бет алды!
Dialogue: 0,0:11:08.91,0:11:09.54,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:09.87,0:11:11.42,Default,,0,0,0,,Бұл жалғаса берсе...
Dialogue: 0,0:11:11.50,0:11:14.42,Default,,0,0,0,,Қақтығыс!
Dialogue: 0,0:11:15.54,0:11:16.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:24.85,0:11:27.52,Default,,0,0,0,,Wild Wyvern Victory Valkyrie
Dialogue: 0,0:11:27.60,0:11:29.39,Default,,0,0,0,,Бір уақытта аяқтау арқылы сурет салу
Dialogue: 0,0:11:30.02,0:11:30.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:31.48,0:11:33.31,Default,,0,0,0,,Не... енді...
Dialogue: 0,0:11:33.48,0:11:36.65,Default,,0,0,0,,Тағы бір ұтыс ойыны!
Dialogue: 0,0:11:39.44,0:11:41.61,Default,,0,0,0,,Жарайсың Валькирия!
Dialogue: 0,0:11:41.70,0:11:44.57,Default,,0,0,0,,Жарайды! Келесі шайқаста барымызды салайық!
Dialogue: 0,0:11:44.66,0:11:45.37,Default,,0,0,0,,Құпия айтпасам, бүгін түнде ұйықтай алмаймын
Dialogue: 0,0:11:45.95,0:11:46.70,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:47.62,0:11:51.41,Default,,0,0,0,,Қызу шайқас бесінші шайқасқа енді!
Dialogue: 0,0:11:51.71,0:11:54.58,Default,,0,0,0,,Неге... неге жеңе алмаймын?
Dialogue: 0,0:11:55.13,0:11:58.34,Default,,0,0,0,,Басқа жерде тыным таппаймын!
Dialogue: 0,0:11:58.63,0:12:00.09,Default,,0,0,0,,Мен Шуды жақсы көремін...
Dialogue: 0,0:12:00.67,0:12:02.63,Default,,0,0,0,,Финалда Шуды жеңемін!
Dialogue: 0,0:12:03.97,0:12:05.43,Default,,0,0,0,,Бұрынғысы да…
Dialogue: 0,0:12:06.47,0:12:07.60,Default,,0,0,0,,Валькирия...
Dialogue: 0,0:12:07.81,0:12:09.52,Default,,0,0,0,,Ол тездегендей болды...
Dialogue: 0,0:12:13.89,0:12:15.60,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:15.69,0:12:18.23,Default,,0,0,0,,Сен кереметсің, Валькири!
Dialogue: 0,0:12:18.32,0:12:20.53,Default,,0,0,0,,Біз барамыз, барамыз!
Dialogue: 0,0:12:24.57,0:12:25.45,Default,,0,0,0,,Бұл жолы...
Dialogue: 0,0:12:26.12,0:12:27.87,Default,,0,0,0,,Оны құлат!
Dialogue: 0,0:12:28.83,0:12:30.49,Default,,0,0,0,,Бесінші шайқас
Dialogue: 0,0:12:31.45,0:12:33.21,Default,,0,0,0,,Қызу шайқас
Dialogue: 0,0:12:33.29,0:12:35.08,Default,,0,0,0,,Бесінші шайқастың уақыты келді!
Dialogue: 0,0:12:35.42,0:12:37.13,Default,,0,0,0,,Жарық түсіру
Dialogue: 0,0:12:37.21,0:12:39.38,Default,,0,0,0,,Бүгінгі флэш-түсірілімдер арқылы сіз мұны жасай аласыз!
Dialogue: 0,0:12:40.38,0:12:42.13,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:12:48.80,0:12:50.39,Default,,0,0,0,,Бұрынғы нәрсе...
Dialogue: 0,0:12:51.27,0:12:52.77,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:12:57.77,0:12:59.40,Default,,0,0,0,,Уф
Dialogue: 0,0:13:00.36,0:13:02.61,Default,,0,0,0,,Көріп көрейік, Валькири!
Dialogue: 0,0:13:03.57,0:13:06.66,Default,,0,0,0,,Финалда Шумен жұдырықтасамын...!
Dialogue: 0,0:13:07.66,0:13:09.33,Default,,0,0,0,,Мен жеңіле алмаймын
Dialogue: 0,0:13:09.41,0:13:10.70,Default,,0,0,0,,Өткен күні сол жігітке...
Dialogue: 0,0:13:10.78,0:13:12.75,Default,,0,0,0,,Мен жеңіліске шыдай алмаймын.
Dialogue: 0,0:13:13.87,0:13:14.87,Default,,0,0,0,,I-
Dialogue: 0,0:13:15.37,0:13:17.21,Default,,0,0,0,,Өткен күні...
Dialogue: 0,0:13:17.29,0:13:18.42,Default,,0,0,0,,Бұл біткен жоқ!
Dialogue: 0,0:13:19.25,0:13:20.42,Default,,0,0,0,,Бл…ээ…!!
Dialogue: 0,0:13:20.50,0:13:22.05,Default,,0,0,0,,Бұл соңғы шайқас болады...
Dialogue: 0,0:13:24.47,0:13:26.13,Default,,0,0,0,,Бұл пішін...
Dialogue: 0,0:13:26.22,0:13:28.34,Default,,0,0,0,,Дененің айналу күшін пайдалануға тырысу
Dialogue: 0,0:13:29.01,0:13:31.76,Default,,0,0,0,,Валькири финалға барайық...
Dialogue: 0,0:13:32.64,0:13:35.64,Default,,0,0,0,,Ең күшті бек - осы уиверн...!
Dialogue: 0,0:13:36.44,0:13:38.15,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:13:38.69,0:13:41.61,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:42.02,0:13:45.03,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:48.36,0:13:49.70,Default,,0,0,0,,Жабайы уайверн
Dialogue: 0,0:13:49.78,0:13:52.66,Default,,0,0,0,,Мен орталықты алу үшін жылдам қозғалдым!
Dialogue: 0,0:13:52.74,0:13:54.83,Default,,0,0,0,,Қалқан атуы жарылды!
Dialogue: 0,0:13:54.91,0:13:56.25,Default,,0,0,0,,(жоғары дыбыс)
Dialogue: 0,0:13:56.54,0:13:57.67,Default,,0,0,0,,Бұл дыбыс...
Dialogue: 0,0:13:57.87,0:13:59.38,Default,,0,0,0,,Валькирияның жеңісі
Dialogue: 0,0:13:59.46,0:14:01.00,Default,,0,0,0,,Ыстық қудалаудағы флэш түсіру!
Dialogue: 0,0:14:01.09,0:14:03.05,Default,,0,0,0,,Бұл маған қатты әсер етті!
Dialogue: 0,0:14:03.13,0:14:05.84,Default,,0,0,0,,Екеуі де желдей ұшып кетті!
Dialogue: 0,0:14:05.92,0:14:09.22,Default,,0,0,0,,Бұрынғыдан басқа бірінші контакт!
Dialogue: 0,0:14:09.30,0:14:09.97,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:10.05,0:14:11.89,Default,,0,0,0,,Сіз оны толығымен өткізіп жібердіңіз!
Dialogue: 0,0:14:12.43,0:14:14.01,Default,,0,0,0,,Сәтсіз ату?
Dialogue: 0,0:14:14.68,0:14:17.39,Default,,0,0,0,,Жіпке тым көп күш қолданбаңыз.
Dialogue: 0,0:14:17.48,0:14:19.40,Default,,0,0,0,,Мен оны тіпті реттей алмаймын.
Dialogue: 0,0:14:20.23,0:14:22.27,Default,,0,0,0,,Бір-бірімізден сонша алыс болғанымызды қалаймын.
Dialogue: 0,0:14:22.36,0:14:24.48,Default,,0,0,0,,Тіпті флэш-түсірілім уақытында орындалмайды
Dialogue: 0,0:14:24.78,0:14:27.03,Default,,0,0,0,,Ол бір рет болса да шабуыл жасай алмай, өзін-өзі жояды!
Dialogue: 0,0:14:27.65,0:14:30.91,Default,,0,0,0,,Сіз жеңу үшін тым көп тырыстыңыз, Балто.
Dialogue: 0,0:14:31.28,0:14:33.45,Default,,0,0,0,,Ақыры финал болды, балам.
Dialogue: 0,0:14:34.45,0:14:37.33,Default,,0,0,0,,Осы уақытқа дейін жету үшін көп еңбек еттіңіз.
Dialogue: 0,0:14:37.41,0:14:39.62,Default,,0,0,0,,Соңында сәтсіз ату дегеніміз не?
Dialogue: 0,0:14:39.71,0:14:42.25,Default,,0,0,0,,Бұл туралы.
Dialogue: 0,0:14:42.79,0:14:43.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:49.84,0:14:52.14,Default,,0,0,0,,Иә, Валькири! Міне!
Dialogue: 0,0:15:00.48,0:15:01.48,Default,,0,0,0,,Не!
Dialogue: 0,0:15:01.81,0:15:03.81,Default,,0,0,0,,Валькирия...
Dialogue: 0,0:15:03.90,0:15:06.32,Default,,0,0,0,,Керемет күшейту!
Dialogue: 0,0:15:06.86,0:15:09.95,Default,,0,0,0,,Бұл нағыз флеш түсіру...
Dialogue: 0,0:15:10.53,0:15:14.07,Default,,0,0,0,,Шынайы флэш түсіру!
Dialogue: 0,0:15:17.62,0:15:19.71,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:15:21.62,0:15:23.21,Default,,0,0,0,,Мен оны қабылдаймын!
Dialogue: 0,0:15:23.75,0:15:25.67,Default,,0,0,0,,Алып кет, Уайверн!
Dialogue: 0,0:15:33.89,0:15:35.35,Default,,0,0,0,,(Айдаһардың айқайы)
Dialogue: 0,0:15:45.44,0:15:49.15,Default,,0,0,0,,Жүр!
Dialogue: 0,0:15:52.82,0:15:54.57,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:15:57.49,0:16:00.54,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:16:00.83,0:16:01.79,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:03.12,0:16:04.54,Default,,0,0,0,,Толық аяқтау
Dialogue: 0,0:16:04.63,0:16:06.71,Default,,0,0,0,,Валькирияның жеңісі 2 ұпай
Dialogue: 0,0:16:06.92,0:16:10.55,Default,,0,0,0,,Барто Аои 3 пен 1 ұпаймен жеңеді.
Dialogue: 0,0:16:10.71,0:16:13.26,Default,,0,0,0,,супер супер супер
Dialogue: 0,0:16:13.34,0:16:15.05,Default,,0,0,0,,Бұл өте ақылсыз!
Dialogue: 0,0:16:15.14,0:16:16.51,Default,,0,0,0,,Бірақ Йотаро-сан бәрі жақсы деді.
Dialogue: 0,0:16:16.60,0:16:17.81,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:18.93,0:16:21.35,Default,,0,0,0,,Не істеп жатырсың, Балто? О...
Dialogue: 0,0:16:22.52,0:16:23.89,Default,,0,0,0,,Мен жеңдім!
Dialogue: 0,0:16:24.35,0:16:25.85,Default,,0,0,0,,Сіз жеңдіңіз!
Dialogue: 0,0:16:26.56,0:16:28.11,Default,,0,0,0,,Мен жеңдім...
Dialogue: 0,0:16:28.94,0:16:30.28,Default,,0,0,0,,Мен жеңдім...!
Dialogue: 0,0:16:30.69,0:16:32.32,Default,,0,0,0,,Жооой!
Dialogue: 0,0:16:32.40,0:16:35.74,Default,,0,0,0,,Мен жеңдім, жеңдім, жеңдім!
Dialogue: 0,0:16:35.82,0:16:38.16,Default,,0,0,0,,Мен шынымен жеңдім...! Уау
Dialogue: 0,0:16:38.33,0:16:40.70,Default,,0,0,0,,Сіз мұны істедіңіз! Балтық!
Dialogue: 0,0:16:40.87,0:16:42.12,Default,,0,0,0,,«Түстен кейінге дейін тікелей эфир»
Dialogue: 0,0:16:42.20,0:16:45.58,Default,,0,0,0,,Барто Аои жеңген үміткерді тағы да жеңді!
Dialogue: 0,0:16:45.67,0:16:48.17,Default,,0,0,0,,Мені енді қара тұлпар деуге жол бермеймін!
Dialogue: 0,0:16:48.25,0:16:50.96,Default,,0,0,0,,Болашағы бар жаңа жұлдыз туды!
Dialogue: 0,0:16:52.13,0:16:53.92,Default,,0,0,0,,Финалдағы қарсылас –
Dialogue: 0,0:16:54.01,0:16:55.68,Default,,0,0,0,,Сіз Балто Аои болдыңыз ба?
Dialogue: 0,0:16:55.88,0:16:57.72,Default,,0,0,0,,Енді менің кезегім
Dialogue: 0,0:17:01.77,0:17:03.89,Default,,0,0,0,,Айтпақшы, сіз кімсіз өзі?
Dialogue: 0,0:17:05.02,0:17:07.60,Default,,0,0,0,,Бұл жеңілген адамның көзі емес.
Dialogue: 0,0:17:08.90,0:17:12.61,Default,,0,0,0,,Балт қорқынышты қарсылас құрды.
Dialogue: 0,0:17:19.66,0:17:20.66,Default,,0,0,0,,...
Dialogue: 0,0:17:22.16,0:17:25.46,Default,,0,0,0,,Шуудың алдында сен жеңбеу керек жігіт болды.
Dialogue: 0,0:17:26.08,0:17:26.92,Default,,0,0,0,,Бала...
Dialogue: 0,0:17:29.84,0:17:32.05,Default,,0,0,0,,Жаттығуды қазірден бастаңыз
Dialogue: 0,0:17:32.42,0:17:33.26,Default,,0,0,0,,Ол ісініп, қан ағып тұр
Dialogue: 0,0:17:34.63,0:17:37.13,Default,,0,0,0,,Баланың ішінде бірдеңе өзгерді.
Dialogue: 0,0:17:39.30,0:17:41.35,Default,,0,0,0,,Бала одан да күшті болады
Dialogue: 0,0:17:41.93,0:17:44.39,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:17:44.48,0:17:46.44,Default,,0,0,0,,Иә!
Dialogue: 0,0:17:49.02,0:17:52.23,Default,,0,0,0,,Мен Одиннің шайқас кадрларын осы уақытқа дейін іздедім.
Dialogue: 0,0:17:52.65,0:17:54.69,Default,,0,0,0,,Шу-кунның келесі қарсыласы.
Dialogue: 0,0:17:54.78,0:17:55.90,Default,,0,0,0,,Джинблад Орочи...
Dialogue: 0,0:17:55.99,0:17:56.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:56.61,0:17:58.11,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:17:58.20,0:18:00.70,Default,,0,0,0,,Эй, бұл Один!
Dialogue: 0,0:18:00.78,0:18:03.87,Default,,0,0,0,,Бұл Valkyrie сияқты шабуыл түрі.
Dialogue: 0,0:18:04.37,0:18:06.25,Default,,0,0,0,,Валькириге қарағанда жылдам
Dialogue: 0,0:18:06.33,0:18:09.12,Default,,0,0,0,,Обелиск Одиннің экстремалды жүргізушісі -
Dialogue: 0,0:18:09.21,0:18:10.46,Default,,0,0,0,,Қалың резеңке төсем
Dialogue: 0,0:18:11.00,0:18:12.42,Default,,0,0,0,,Жылдамдықты арттырады
Dialogue: 0,0:18:12.71,0:18:16.38,Default,,0,0,0,,Ал ауырлық центрі бар үштік диск үш нүктеге ауысты
Dialogue: 0,0:18:16.84,0:18:18.13,Default,,0,0,0,,Тұрақты емес жол және...
Dialogue: 0,0:18:18.22,0:18:20.09,Default,,0,0,0,,Жоғары шабуыл қуатын жасайды
Dialogue: 0,0:18:22.47,0:18:24.56,Default,,0,0,0,,Аяқталды!
Dialogue: 0,0:18:27.60,0:18:29.39,Default,,0,0,0,,Шабуыл түрлерінің ішінде -
Dialogue: 0,0:18:29.48,0:18:32.06,Default,,0,0,0,,Жоғары жылдамдықты ауыр соққы ұясы
Dialogue: 0,0:18:32.56,0:18:34.02,Default,,0,0,0,,Қандай бекке қарсы тұрсаң да
Dialogue: 0,0:18:34.11,0:18:35.73,Default,,0,0,0,,Шу-кун міндетті түрде жеңеді!
Dialogue: 0,0:18:36.07,0:18:38.40,Default,,0,0,0,,Жарайды! Ұлдар мен қыздар!
Dialogue: 0,0:18:38.49,0:18:42.41,Default,,0,0,0,,Енді екінші жартылай финалдық матч! Дайынсыз ба?
Dialogue: 0,0:18:42.49,0:18:44.45,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:44.79,0:18:46.12,Default,,0,0,0,,Екінші ойын –
Dialogue: 0,0:18:46.20,0:18:47.62,Default,,0,0,0,,Куришу В.С
Dialogue: 0,0:18:47.70,0:18:49.25,Default,,0,0,0,,Бұл күміс пышақ Орочи!
Dialogue: 0,0:18:49.33,0:18:52.13,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:52.21,0:18:53.59,Default,,0,0,0,,Шу!
Dialogue: 0,0:18:54.13,0:18:56.88,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса! Мен сені финалда күтемін!
Dialogue: 0,0:18:59.84,0:19:01.05,Default,,0,0,0,,Хэхехе
Dialogue: 0,0:19:01.14,0:19:03.14,Default,,0,0,0,,Мен мұны бірден айтқым келді.
Dialogue: 0,0:19:04.89,0:19:05.64,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:13.86,0:19:15.19,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:19:16.53,0:19:17.53,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:19:23.87,0:19:25.91,Default,,0,0,0,,Фигураларды финалға не жылжытады?
Dialogue: 0,0:19:25.99,0:19:27.49,Default,,0,0,0,,Бұл қайсысы?
Dialogue: 0,0:19:27.58,0:19:29.20,Default,,0,0,0,,Бір ғана орындық қалды!
Dialogue: 0,0:19:29.29,0:19:31.87,Default,,0,0,0,,Қызықты шайқасты жіберіп алмаңыз!
Dialogue: 0,0:19:32.54,0:19:34.13,Default,,0,0,0,,Бенишу...
Dialogue: 0,0:19:34.59,0:19:36.75,Default,,0,0,0,,Менің Одинге сәйкес келмейді
Dialogue: 0,0:19:37.25,0:19:39.55,Default,,0,0,0,,Мен финалға міндетті түрде өтемін.
Dialogue: 0,0:19:39.63,0:19:40.72,Default,,0,0,0,,Жарайды, тізіле түсіңдер, тізіле түсіңдер
Dialogue: 0,0:19:41.22,0:19:42.93,Default,,0,0,0,,Бір оқта жарылды...!
Dialogue: 0,0:19:43.39,0:19:45.14,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:19:45.51,0:19:48.60,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:49.43,0:19:51.81,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:53.02,0:19:55.36,Default,,0,0,0,,Екі соққы да сәтті болды!
Dialogue: 0,0:19:55.44,0:19:57.82,Default,,0,0,0,,Спригган дауылы Орталыққа барыңыз!
Dialogue: 0,0:19:57.90,0:20:00.03,Default,,0,0,0,,Екінші жағынан, Обелиск Один...
Dialogue: 0,0:20:00.11,0:20:02.28,Default,,0,0,0,,Бұл сырттан жылдам шабуыл!
Dialogue: 0,0:20:02.86,0:20:04.07,Default,,0,0,0,,Бұл кеңейту...
Dialogue: 0,0:20:04.82,0:20:07.08,Default,,0,0,0,,Өткен күнгі Валькири шайқасы сияқты!
Dialogue: 0,0:20:12.21,0:20:13.50,Default,,0,0,0,,Қарсы үзіліс!
Dialogue: 0,0:20:14.00,0:20:16.42,Default,,0,0,0,,Бұл шықты!
Dialogue: 0,0:20:16.50,0:20:18.92,Default,,0,0,0,,Спригганның қарсы үзілісі!
Dialogue: 0,0:20:21.34,0:20:23.05,Default,,0,0,0,,Жарайды, шешілді!
Dialogue: 0,0:20:28.93,0:20:29.81,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:30.02,0:20:31.06,Default,,0,0,0,,Не!
Dialogue: 0,0:20:31.14,0:20:32.48,Default,,0,0,0,,Бір-бірлеріңмен соқтығысуға бардыңдар ма?
Dialogue: 0,0:20:33.89,0:20:36.61,Default,,0,0,0,,Сіз есептегіш сынуды бұздыңыз!
Dialogue: 0,0:20:36.69,0:20:38.69,Default,,0,0,0,,Шабуылды жалғастырыңыз!
Dialogue: 0,0:20:38.86,0:20:40.57,Default,,0,0,0,,(жоғары дыбыс)
Dialogue: 0,0:20:46.20,0:20:48.70,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:20:48.91,0:20:50.16,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:53.04,0:20:53.96,Default,,0,0,0,,Оны тек негізгі денені жойған кезде ғана қолдана аласың. Сынап көр.
Dialogue: 0,0:20:54.29,0:20:56.83,Default,,0,0,0,,Бір уақытта жеребені аяқтау
Dialogue: 0,0:20:56.92,0:20:58.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:58.67,0:21:03.22,Default,,0,0,0,,Екінші матч та бірінші шайқастағы қызықты оқиға болды!
Dialogue: 0,0:21:04.38,0:21:06.64,Default,,0,0,0,,Шудың қарсы үзілуі...
Dialogue: 0,0:21:07.18,0:21:09.10,Default,,0,0,0,,Мен күшпен басып қалдым...
Dialogue: 0,0:21:09.18,0:21:13.10,Default,,0,0,0,,Валькириді жарып жіберген қарсы үзіліс...
Dialogue: 0,0:21:13.18,0:21:16.10,Default,,0,0,0,,Ол... соншалықты күшті болды ма?
Dialogue: 0,0:21:17.77,0:21:19.86,Default,,0,0,0,,Прелюдия аяқталды.
Dialogue: 0,0:21:19.98,0:21:21.73,Default,,0,0,0,,Келесі жолы жарылып көрейік...!
Dialogue: 0,0:21:24.07,0:21:25.11,Default,,0,0,0,,Пайдасы жоқ.
Dialogue: 0,0:21:25.53,0:21:26.70,Default,,0,0,0,,Күміс жүзі Орочи...
Dialogue: 0,0:21:26.78,0:21:28.16,Default,,0,0,0,,Бұл мен ойлағаннан да көп.
Dialogue: 0,0:21:28.24,0:21:29.24,Default,,0,0,0,,Әпкем…
Dialogue: 0,0:21:30.49,0:21:31.24,Default,,0,0,0,,Уф!
Dialogue: 0,0:21:32.33,0:21:34.83,Default,,0,0,0,,Мен бұл жерде ұтыла алмаймын.
Dialogue: 0,0:21:37.17,0:21:38.08,Default,,0,0,0,,Тағы 500 рет!
Dialogue: 0,0:21:41.46,0:21:44.76,Default,,0,0,0,,Егер аяқтау бір сәтке кеш болса...
Dialogue: 0,0:21:44.84,0:21:47.18,Default,,0,0,0,,Спригган жарылып жатты!
Dialogue: 0,0:21:47.26,0:21:48.22,Default,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:22:09.07,0:22:15.16,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.37,0:22:21.50,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:21.96,0:22:27.51,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:27.97,0:22:31.30,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.47,0:22:36.39,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.31,0:22:41.02,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.10,0:22:44.32,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.40,0:22:50.74,Default,,0,0,0,,Артынан қусаң да көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:50.99,0:22:56.54,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.70,0:23:03.29,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:03.88,0:23:09.30,Default,,0,0,0,,Даңққа жететін күнге дейін
Dialogue: 0,0:23:09.47,0:23:12.64,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.14,0:23:17.10,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.48,0:23:28.86,Default,,0,0,0,,Шудың иығы ауыра бастады ма?
Dialogue: 0,0:23:29.07,0:23:30.99,Default,,0,0,0,,Сіз бұл ештеңе емес деп айттыңыз!
Dialogue: 0,0:23:31.07,0:23:33.62,Default,,0,0,0,,Сіз менімен финалда ойнауға уәде бергенсіз!
Dialogue: 0,0:23:33.70,0:23:35.33,Default,,0,0,0,,Не? Inusuke
Dialogue: 0,0:23:35.41,0:23:36.58,Default,,0,0,0,,Сіз не айттыңыз?
Dialogue: 0,0:23:36.79,0:23:38.41,Default,,0,0,0,,Сіз жаңа ғана сөйледіңіз!
Dialogue: 0,0:23:38.50,0:23:40.71,Default,,0,0,0,,Өтінемін, тағы бір рет айтыңызшы!
Dialogue: 0,0:23:41.29,0:23:43.38,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:43.46,0:23:44.75,Default,,0,0,0,,Шу соты!
Dialogue: 0,0:23:45.09,0:23:47.30,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.50,0:23:48.92,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.42,0:23:56.42,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory