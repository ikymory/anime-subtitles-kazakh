Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.05,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.13,0:00:12.51,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.72,0:00:14.76,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:16.93,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.01,0:00:18.81,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.56,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.23,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.31,0:00:28.77,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.48,0:00:34.40,Default,,0,0,0,,Сіз не істегіңіз келеді?
Dialogue: 0,0:00:34.49,0:00:36.66,Default,,0,0,0,,I am I am
Dialogue: 0,0:00:39.83,0:00:40.95,Default,,0,0,0,,Мен жеңгім келеді
Dialogue: 0,0:00:41.91,0:00:43.12,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:43.20,0:00:44.29,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:00:44.37,0:00:45.17,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:00:50.42,0:00:51.80,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:00:51.88,0:00:53.21,Default,,0,0,0,,Мен...
Dialogue: 0,0:00:53.30,0:00:54.84,Default,,0,0,0,,Мен тәртіп бұздым...
Dialogue: 0,0:00:55.76,0:00:58.22,Default,,0,0,0,,Мен... кейде ойлаймын...
Dialogue: 0,0:00:58.64,0:00:59.30,Default,,0,0,0,,А...?
Dialogue: 0,0:00:59.97,0:01:03.14,Default,,0,0,0,,Мен Беймен кездескеніме қуаныштымын...
Dialogue: 0,0:01:05.02,0:01:06.06,Default,,0,0,0,,Ах
Dialogue: 0,0:01:06.64,0:01:08.10,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:01:14.19,0:01:16.15,Default,,0,0,0,,Кешіріңіз Deathsizer
Dialogue: 0,0:01:17.86,0:01:19.03,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:01:21.95,0:01:23.20,Default,,0,0,0,,Міне
Dialogue: 0,0:01:23.37,0:01:25.83,Default,,0,0,0,,Иә? Не болды, Кумичо?
Dialogue: 0,0:01:27.42,0:01:28.79,Default,,0,0,0,,Дина...
Dialogue: 0,0:01:30.21,0:01:31.29,Default,,0,0,0,,Не деген…
Dialogue: 0,0:01:31.63,0:01:33.38,Default,,0,0,0,,Динаға не болды?
Dialogue: 0,0:01:34.51,0:01:35.47,Default,,0,0,0,,Ол...
Dialogue: 0,0:01:36.26,0:01:38.09,Default,,0,0,0,,Бей клубынан шығу
Dialogue: 0,0:01:38.76,0:01:39.93,Default,,0,0,0,,А...
Dialogue: 0,0:01:48.81,0:01:51.19,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:51.52,0:01:56.69,Default,,0,0,0,,Ең күшті қуық болуды мақсат етейік
Dialogue: 0,0:02:08.00,0:02:11.38,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:02:11.88,0:02:14.00,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:02:14.42,0:02:18.55,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:18.68,0:02:21.89,Default,,0,0,0,,Дұрыс, менімен бетпе-бет келген өрнек
Dialogue: 0,0:02:22.01,0:02:28.43,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:28.73,0:02:33.15,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:33.65,0:02:39.07,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:39.20,0:02:41.45,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:41.53,0:02:46.24,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:46.41,0:02:51.50,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:51.79,0:02:54.04,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:54.25,0:02:56.59,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:56.88,0:03:00.80,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:03:00.97,0:03:05.97,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:03:06.18,0:03:08.35,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:12.19,0:03:14.98,Default,,0,0,0,,Шешіңіз! Бүкіл ел бойынша қатысады!
Dialogue: 0,0:03:17.40,0:03:19.19,Default,,0,0,0,,Дина жұмыстан кететінін айтады...
Dialogue: 0,0:03:20.90,0:03:23.82,Default,,0,0,0,,Сіз бұған ілесесіз бе?
Dialogue: 0,0:03:23.91,0:03:24.57,Default,,0,0,0,,Эй!
Dialogue: 0,0:03:24.66,0:03:27.49,Default,,0,0,0,,Егер бұл әзілкеш болса, оны қызықтырақ етіңіз.
Dialogue: 0,0:03:27.58,0:03:29.50,Default,,0,0,0,,Кәне, таңғы жаттығуды жасайық.
Dialogue: 0,0:03:29.58,0:03:32.29,Default,,0,0,0,,Бүкіл денеңізді жылытудан бастаңыз.
Dialogue: 0,0:03:32.42,0:03:34.63,Default,,0,0,0,,Ойч ни~санши
Dialogue: 0,0:03:34.71,0:03:36.29,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:03:36.38,0:03:37.67,Default,,0,0,0,,Bay Club ойынын тоқтату...
Dialogue: 0,0:03:37.75,0:03:40.01,Default,,0,0,0,,Мен енді аймақты іріктеу турниріне қатыса алмаймын.
Dialogue: 0,0:03:41.26,0:03:42.09,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:03:42.30,0:03:44.30,Default,,0,0,0,,Мен де таң қалдым.
Dialogue: 0,0:03:44.39,0:03:46.35,Default,,0,0,0,,Олай болса тезірек айт!
Dialogue: 0,0:03:46.43,0:03:47.72,Default,,0,0,0,,Сіз мұны айтпайсыз ба?
Dialogue: 0,0:03:47.81,0:03:48.85,Default,,0,0,0,,Дина…
Dialogue: 0,0:03:50.52,0:03:51.56,Default,,0,0,0,,Дина!
Dialogue: 0,0:03:52.56,0:03:55.19,Default,,0,0,0,,Дина-кун болса, ол өзін жақсы сезінбегендіктен.
Dialogue: 0,0:03:55.27,0:03:57.27,Default,,0,0,0,,Сіз жұмыстан ерте кеткен сияқтысыз.
Dialogue: 0,0:03:57.36,0:03:58.78,Default,,0,0,0,,Бұл сирек...
Dialogue: 0,0:03:58.94,0:03:59.98,Default,,0,0,0,,А...
Dialogue: 0,0:04:03.20,0:04:03.99,Default,,0,0,0,,Шу…
Dialogue: 0,0:04:04.74,0:04:05.99,Default,,0,0,0,,Бір сәт осында кел.
Dialogue: 0,0:04:06.20,0:04:07.33,Default,,0,0,0,,Менің бір оқиғам бар.
Dialogue: 0,0:04:10.87,0:04:12.96,Default,,0,0,0,,Мен бұған сене алмаймын.
Dialogue: 0,0:04:13.04,0:04:14.67,Default,,0,0,0,,Сізге қаншалықты ұнайды?
Dialogue: 0,0:04:14.75,0:04:17.13,Default,,0,0,0,,Сіз айта алатын және айта алмайтын нәрселер бар.
Dialogue: 0,0:04:17.67,0:04:18.84,Default,,0,0,0,,Бұл рас
Dialogue: 0,0:04:19.13,0:04:21.09,Default,,0,0,0,,Бейбатттағы ереже бұзу...
Dialogue: 0,0:04:21.55,0:04:23.68,Default,,0,0,0,,Дина мұндай әрекетке бармас еді.
Dialogue: 0,0:04:23.76,0:04:24.63,Default,,0,0,0,,Ах
Dialogue: 0,0:04:25.22,0:04:27.14,Default,,0,0,0,,Мен де солай ойлағым келді.
Dialogue: 0,0:04:31.60,0:04:32.89,Default,,0,0,0,,(жылайды)
Dialogue: 0,0:04:32.98,0:04:34.19,Default,,0,0,0,,Тіпті өзім де...
Dialogue: 0,0:04:34.27,0:04:36.94,Default,,0,0,0,,Неге олай істегеніңізді білмеймін...
Dialogue: 0,0:04:37.02,0:04:38.61,Default,,0,0,0,,Байқасаңыз...
Dialogue: 0,0:04:38.86,0:04:40.28,Default,,0,0,0,,Бұл орындалды
Dialogue: 0,0:04:40.94,0:04:42.24,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:04:42.69,0:04:43.86,Default,,0,0,0,,Мен...
Dialogue: 0,0:04:43.95,0:04:47.20,Default,,0,0,0,,Мен ең жақсы көретін нәрсені ластадым.
Dialogue: 0,0:04:47.41,0:04:48.87,Default,,0,0,0,,(жылайды)
Dialogue: 0,0:04:50.20,0:04:53.96,Default,,0,0,0,,Шу Сенің арқаңда менің сезімім анық болды.
Dialogue: 0,0:04:54.04,0:04:55.37,Default,,0,0,0,,Егер мен бұны қазір айтпасам, кейін қарама-қайшылықтар туындауы мүмкін.
Dialogue: 0,0:04:55.79,0:04:58.25,Default,,0,0,0,,Біріншіден, Югоға жаным ашиды.
Dialogue: 0,0:04:59.09,0:05:00.25,Default,,0,0,0,,Кеджиме бұл-
Dialogue: 0,0:05:00.34,0:05:01.80,Default,,0,0,0,,Оны өзіңіз бекітіңіз
Dialogue: 0,0:05:02.80,0:05:03.88,Default,,0,0,0,,Иә
Dialogue: 0,0:05:05.68,0:05:09.30,Default,,0,0,0,,Мен Куроками Нансуи Югоға бара жатқанына сенімдімін.
Dialogue: 0,0:05:09.93,0:05:11.01,Default,,0,0,0,,Ол...
Dialogue: 0,0:05:11.56,0:05:14.06,Default,,0,0,0,,Ең көп қиналған Қара Құдай болуы керек.
Dialogue: 0,0:05:14.60,0:05:16.56,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:05:16.64,0:05:18.44,Default,,0,0,0,,Баккаро!
Dialogue: 0,0:05:18.52,0:05:20.90,Default,,0,0,0,,Динаның баккаросы~
Dialogue: 0,0:05:21.44,0:05:22.53,Default,,0,0,0,,Балто!
Dialogue: 0,0:05:23.28,0:05:25.65,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:05:26.32,0:05:27.91,Default,,0,0,0,,Баккаро~
Dialogue: 0,0:05:28.74,0:05:30.62,Default,,0,0,0,,Баккаро~
Dialogue: 0,0:05:32.33,0:05:33.66,Default,,0,0,0,,Баккаро…
Dialogue: 0,0:05:34.04,0:05:35.00,Default,,0,0,0,,Кууу!
Dialogue: 0,0:05:35.79,0:05:36.91,Default,,0,0,0,,Барт…
Dialogue: 0,0:05:37.75,0:05:40.13,Default,,0,0,0,,Жеткізілмеген адам!
Dialogue: 0,0:05:40.21,0:05:42.09,Default,,0,0,0,,Сәлем! Қарғыс атсын!
Dialogue: 0,0:05:42.67,0:05:44.80,Default,,0,0,0,,Бейбатлда бұзақылық жасағандарға -
Dialogue: 0,0:05:45.30,0:05:47.18,Default,,0,0,0,,Бейде ойнауға құқығы жоқ!
Dialogue: 0,0:05:47.30,0:05:48.34,Default,,0,0,0,,Юго
Dialogue: 0,0:05:48.43,0:05:49.30,Default,,0,0,0,,Ішек
Dialogue: 0,0:05:50.05,0:05:51.14,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:51.22,0:05:53.14,Default,,0,0,0,,WBBA хатшылығы:
Dialogue: 0,0:05:53.22,0:05:55.35,Default,,0,0,0,,Мен сізге жұмыстан кеткенім туралы хабарладым.
Dialogue: 0,0:05:55.77,0:05:57.02,Default,,0,0,0,,Юго финалда...
Dialogue: 0,0:05:57.56,0:05:58.73,Default,,0,0,0,,Сен шық.
Dialogue: 0,0:05:59.23,0:06:00.23,Default,,0,0,0,,Не...
Dialogue: 0,0:06:00.31,0:06:01.94,Default,,0,0,0,,Ол қызық жігіт.
Dialogue: 0,0:06:02.44,0:06:03.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:03.32,0:06:06.53,Default,,0,0,0,,Егер сіз үндемеген болсаңыз, финалға шығуыңыз мүмкін еді.
Dialogue: 0,0:06:06.61,0:06:07.65,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:08.78,0:06:10.62,Default,,0,0,0,,Мен өзімді кешіре алмаймын
Dialogue: 0,0:06:10.82,0:06:11.87,Default,,0,0,0,,(Жедел жүзген қайықтың дыбысы)
Dialogue: 0,0:06:12.53,0:06:15.83,Default,,0,0,0,,Бұл дойдо сен сияқты адамдарға арналған орын емес!
Dialogue: 0,0:06:21.17,0:06:22.34,Default,,0,0,0,,Ол...
Dialogue: 0,0:06:22.54,0:06:24.38,Default,,0,0,0,,Бэйден кетуі мүмкін
Dialogue: 0,0:06:29.38,0:06:30.51,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:06:30.59,0:06:33.01,Default,,0,0,0,,Ах, Бар-нии, қош келдіңіз.
Dialogue: 0,0:06:33.10,0:06:34.31,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:06:34.39,0:06:36.68,Default,,0,0,0,,Аш болуың керек, Балто.
Dialogue: 0,0:06:36.77,0:06:38.77,Default,,0,0,0,,Менде котлет сэндвич бар, оны жеп ал.
Dialogue: 0,0:06:38.85,0:06:39.69,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:39.77,0:06:40.73,Default,,0,0,0,,Фалько…
Dialogue: 0,0:06:40.94,0:06:41.98,Default,,0,0,0,,Барт?
Dialogue: 0,0:06:43.36,0:06:45.07,Default,,0,0,0,,Мектепте бірдеңе болды ма?
Dialogue: 0,0:06:45.15,0:06:47.28,Default,,0,0,0,,Хмм... Мен білмеймін.
Dialogue: 0,0:06:47.61,0:06:48.69,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:52.07,0:06:53.24,Default,,0,0,0,,Бұл табиғи ғой, иә?
Dialogue: 0,0:06:53.57,0:06:55.91,Default,,0,0,0,,Неге, Дина!
Dialogue: 0,0:06:56.79,0:06:59.25,Default,,0,0,0,,Ең көп зардап шегетін адам Қара Құдай болуы керек.
Dialogue: 0,0:07:00.16,0:07:01.33,Default,,0,0,0,,Дина…
Dialogue: 0,0:07:02.63,0:07:04.13,Default,,0,0,0,,Содан бір күні бір сәуле жарқырап түсті,
Dialogue: 0,0:07:04.50,0:07:05.67,Default,,0,0,0,,Дина…
Dialogue: 0,0:07:06.05,0:07:07.88,Default,,0,0,0,,Мен, сен уайымдап тұрсың.
Dialogue: 0,0:07:07.96,0:07:10.17,Default,,0,0,0,,Мен оны мүлде байқамадым
Dialogue: 0,0:07:10.51,0:07:11.63,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:07:12.09,0:07:14.22,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:17.01,0:07:18.93,Default,,0,0,0,,Кешіріңіз, Сута
Dialogue: 0,0:07:24.98,0:07:28.36,Default,,0,0,0,,Уау! Бұл дауылды Спригган ба?
Dialogue: 0,0:07:28.57,0:07:31.11,Default,,0,0,0,,Уау, тамаша!
Dialogue: 0,0:07:31.20,0:07:32.07,Default,,0,0,0,,Шу!
Dialogue: 0,0:07:32.41,0:07:34.62,Default,,0,0,0,,Бұл шынымен күшті, солай емес пе?
Dialogue: 0,0:07:34.70,0:07:36.37,Default,,0,0,0,,Әй, аға!
Dialogue: 0,0:07:36.45,0:07:38.20,Default,,0,0,0,,Мен оны Шу-куннан естідім.
Dialogue: 0,0:07:38.29,0:07:39.04,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:39.54,0:07:42.58,Default,,0,0,0,,Екінші раундта Йггдрасилден жеңілгеніңді естідім...
Dialogue: 0,0:07:42.96,0:07:44.54,Default,,0,0,0,,Ах... а
Dialogue: 0,0:07:44.63,0:07:46.00,Default,,0,0,0,,және алғашқы жарық сигналда… (Әйел турист 2) Ах! Мен білгенмін.
Dialogue: 0,0:07:46.09,0:07:47.75,Default,,0,0,0,,Келесі жолы сәттілік
Dialogue: 0,0:07:48.71,0:07:49.38,Default,,0,0,0,,Иә...
Dialogue: 0,0:07:49.76,0:07:53.01,Default,,0,0,0,,Бірақ он төрт император Шуукунмен дос болу керемет.
Dialogue: 0,0:07:53.34,0:07:56.26,Default,,0,0,0,,Үлкен аға, мен достарыма мақтанамын.
Dialogue: 0,0:07:57.60,0:07:59.39,Default,,0,0,0,,Рахмет Шу
Dialogue: 0,0:08:01.18,0:08:04.48,Default,,0,0,0,,Эй, жүргізушіні түйін дискіне біріктіріңіз.
Dialogue: 0,0:08:04.56,0:08:07.65,Default,,0,0,0,,Міне осылай шықты! Бұл керемет!
Dialogue: 0,0:08:07.86,0:08:10.40,Default,,0,0,0,,Балто финалды көруге келуімді өтінді.
Dialogue: 0,0:08:10.82,0:08:11.82,Default,,0,0,0,,Ах
Dialogue: 0,0:08:13.40,0:08:15.74,Default,,0,0,0,,Міне, ақыры келді!
Dialogue: 0,0:08:15.82,0:08:19.66,Default,,0,0,0,,Жақында аймақты таңдау финалы басталады!
Dialogue: 0,0:08:19.74,0:08:20.70,Default,,0,0,0,,Финалдық матч –
Dialogue: 0,0:08:20.79,0:08:23.71,Default,,0,0,0,,А блоктан D блогына дейін 4 ойын
Dialogue: 0,0:08:23.92,0:08:26.04,Default,,0,0,0,,Осы шайқаста жеңген жүзші
Dialogue: 0,0:08:26.13,0:08:28.34,Default,,0,0,0,,Ұлттық турнирге жолдама алыңыз!
Dialogue: 0,0:08:28.88,0:08:30.55,Default,,0,0,0,,Қатысушылар
Dialogue: 0,0:08:30.71,0:08:32.80,Default,,0,0,0,,Дайынсың ба? Бұл не?
Dialogue: 0,0:08:32.88,0:08:35.30,Default,,0,0,0,,Балтоның мінез-құлқы әдеттегіден өзгеше.
Dialogue: 0,0:08:35.38,0:08:36.76,Default,,0,0,0,,Вакия мона
Dialogue: 0,0:08:37.14,0:08:38.51,Default,,0,0,0,,Аняр!
Dialogue: 0,0:08:38.72,0:08:39.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:40.06,0:08:42.18,Default,,0,0,0,,Мені мазақ ет!
Dialogue: 0,0:08:43.94,0:08:45.73,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:08:46.77,0:08:47.69,Default,,0,0,0,,Не? Ит пе?
Dialogue: 0,0:08:49.57,0:08:50.90,Default,,0,0,0,,Ахаха
Dialogue: 0,0:08:50.98,0:08:51.90,Default,,0,0,0,,Жақсы жұмыс!
Dialogue: 0,0:08:52.07,0:08:52.86,Default,,0,0,0,,Жарқанат!
Dialogue: 0,0:08:53.11,0:08:55.49,Default,,0,0,0,,Бұл сіздің қазіргі қабілетіңіз
Dialogue: 0,0:08:55.57,0:08:59.08,Default,,0,0,0,,Көп жұмыс істеп, шынайы сенімділікке ие бол
Dialogue: 0,0:08:59.16,0:09:00.66,Default,,0,0,0,,Олай болса қоштасу.
Dialogue: 0,0:09:01.24,0:09:03.29,Default,,0,0,0,,Мүлде рұқсат етілмейді
Dialogue: 0,0:09:03.37,0:09:05.00,Default,,0,0,0,,Мына Шитенко деген не?
Dialogue: 0,0:09:05.08,0:09:06.71,Default,,0,0,0,,Келесі кездескенімізде мен...
Dialogue: 0,0:09:06.83,0:09:10.46,Default,,0,0,0,,Тамшылап жатқан бейберекет
Dialogue: 0,0:09:10.55,0:09:12.67,Default,,0,0,0,,Жағымсыз бірдеңе болды.
Dialogue: 0,0:09:12.76,0:09:14.38,Default,,0,0,0,,Түсінуге оңай
Dialogue: 0,0:09:14.63,0:09:16.76,Default,,0,0,0,,Бірақ тым ыстық емес пе?
Dialogue: 0,0:09:16.97,0:09:18.72,Default,,0,0,0,,Баланың жағдайы жақсы
Dialogue: 0,0:09:19.18,0:09:20.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:21.85,0:09:24.73,Default,,0,0,0,,Оның үстіне, Балто өзін жақсы сезініп тұрған жоқ па?
Dialogue: 0,0:09:24.81,0:09:26.02,Default,,0,0,0,,Иә, бір жағынан солай.
Dialogue: 0,0:09:26.23,0:09:27.35,Default,,0,0,0,,Заттың түрі көп.
Dialogue: 0,0:09:28.35,0:09:31.32,Default,,0,0,0,,Дина... сен келесің, солай ма?
Dialogue: 0,0:09:32.32,0:09:34.24,Default,,0,0,0,,Менің ойыныма қараңдаршы.
Dialogue: 0,0:09:34.44,0:09:36.53,Default,,0,0,0,,Бүгін де аудитория орындарында...
Dialogue: 0,0:09:36.61,0:09:38.36,Default,,0,0,0,,Төрт бұрылатын император Бенишу
Dialogue: 0,0:09:38.45,0:09:40.49,Default,,0,0,0,,Жанып тұрған ғибадатхананың Кайзасы да бар
Dialogue: 0,0:09:40.87,0:09:42.95,Default,,0,0,0,,Республикалық турнирге қатысатын блейдерлер
Dialogue: 0,0:09:43.04,0:09:45.20,Default,,0,0,0,,Сіз қызық болуыңыз керек!
Dialogue: 0,0:09:45.75,0:09:48.42,Default,,0,0,0,,Дина...Мен сені қалаймын...
Dialogue: 0,0:09:49.17,0:09:51.00,Default,,0,0,0,,Менің айтарым бар.
Dialogue: 0,0:09:51.88,0:09:54.92,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар
Dialogue: 0,0:09:55.01,0:09:58.51,Default,,0,0,0,,Әр блоктың финалы енді басталады!
Dialogue: 0,0:09:58.59,0:10:00.47,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:00.85,0:10:02.39,Default,,0,0,0,,Блок!
Dialogue: 0,0:10:02.81,0:10:04.02,Default,,0,0,0,,Финал!
Dialogue: 0,0:10:04.52,0:10:06.48,Default,,0,0,0,,Сұрапыл шайқастың соңында-
Dialogue: 0,0:10:06.73,0:10:09.69,Default,,0,0,0,,Жеңіс Валькириді оятқан ғажайып бала
Dialogue: 0,0:10:10.10,0:10:13.19,Default,,0,0,0,,Барто Аоимен таныстыру!
Dialogue: 0,0:10:13.61,0:10:15.94,Default,,0,0,0,,Обелиск Одинге қарсы...
Dialogue: 0,0:10:16.03,0:10:18.07,Default,,0,0,0,,Шығанақ симфониясын ойнау
Dialogue: 0,0:10:18.15,0:10:19.99,Default,,0,0,0,,Стадион дирижері
Dialogue: 0,0:10:20.07,0:10:22.66,Default,,0,0,0,,Күміс жүзді Орочимен таныстыру!
Dialogue: 0,0:10:22.74,0:10:25.87,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:26.20,0:10:28.29,Default,,0,0,0,,Барыңды істе, ағайын!
Dialogue: 0,0:10:28.37,0:10:29.75,Default,,0,0,0,,Жеңіске жет! Балтық
Dialogue: 0,0:10:29.83,0:10:31.17,Default,,0,0,0,,Мықты болыңыз~
Dialogue: 0,0:10:31.25,0:10:33.34,Default,,0,0,0,,Free! Fresh! Балтық!
Dialogue: 0,0:10:33.42,0:10:34.25,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:34.34,0:10:37.72,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:38.72,0:10:40.01,Default,,0,0,0,,Дина…
Dialogue: 0,0:10:48.02,0:10:50.39,Default,,0,0,0,,Қош бол Өлімсізер
Dialogue: 0,0:10:55.27,0:10:57.94,Default,,0,0,0,,Сізге қамқорлық жасайтын адам...
Dialogue: 0,0:10:58.03,0:10:59.11,Default,,0,0,0,,Мен бар екеніне сенімдімін
Dialogue: 0,0:11:04.74,0:11:06.37,Default,,0,0,0,,(Мысық мияу)
Dialogue: 0,0:11:07.58,0:11:09.08,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:11:10.58,0:11:13.67,Default,,0,0,0,,Қайсысы республикалық турнирге барады?
Dialogue: 0,0:11:13.75,0:11:16.71,Default,,0,0,0,,Валькири мен Одиннің шабуыл түрі бірдей!
Dialogue: 0,0:11:16.80,0:11:19.72,Default,,0,0,0,,Бұл қиян-кескі ұрыс болары сөзсіз!
Dialogue: 0,0:11:19.97,0:11:21.68,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:11:21.76,0:11:24.10,Default,,0,0,0,,Мен сенімен күресе аламын!
Dialogue: 0,0:11:25.18,0:11:26.43,Default,,0,0,0,,Дина…
Dialogue: 0,0:11:28.68,0:11:30.73,Default,,0,0,0,,Концентрлен, Балто!
Dialogue: 0,0:11:31.19,0:11:33.65,Default,,0,0,0,,Бұл жігіт не істеп жатыр?
Dialogue: 0,0:11:34.98,0:11:36.11,Default,,0,0,0,,Бар аға...
Dialogue: 0,0:11:36.57,0:11:38.03,Default,,0,0,0,,Один
Dialogue: 0,0:11:38.15,0:11:39.78,Default,,0,0,0,,Ойнауды бастайық!
Dialogue: 0,0:11:40.28,0:11:41.78,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:11:42.11,0:11:45.49,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:45.57,0:11:47.83,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:47.91,0:11:48.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:48.79,0:11:52.00,Default,,0,0,0,,Екі биді де стадионға жіберді!
Dialogue: 0,0:11:52.54,0:11:54.13,Default,,0,0,0,,Менің сол қолым дірілдеп тұр!
Dialogue: 0,0:11:54.38,0:11:55.88,Default,,0,0,0,,Сәтсіз ату...
Dialogue: 0,0:12:00.46,0:12:02.84,Default,,0,0,0,,Ағай, сәл күте тұрыңыз.
Dialogue: 0,0:12:03.01,0:12:03.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:04.26,0:12:05.34,Default,,0,0,0,,Сота?
Dialogue: 0,0:12:07.43,0:12:09.64,Default,,0,0,0,,Бауырым, мен бір нәрсені ұмытып қалдым.
Dialogue: 0,0:12:09.97,0:12:11.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:12.52,0:12:15.31,Default,,0,0,0,,Бұл сенің ағаңның шығанағы, солай ма?
Dialogue: 0,0:12:15.77,0:12:17.11,Default,,0,0,0,,Күшті көрінеді
Dialogue: 0,0:12:18.73,0:12:20.40,Default,,0,0,0,,(шығақтардың соқтығысқан дыбысы)
Dialogue: 0,0:12:21.86,0:12:23.07,Default,,0,0,0,,Сәлем Дина
Dialogue: 0,0:12:23.15,0:12:24.78,Default,,0,0,0,,Сіз өте кереметсіз.
Dialogue: 0,0:12:24.86,0:12:26.70,Default,,0,0,0,,Менімен сөйлеспе, ақымақ
Dialogue: 0,0:12:26.78,0:12:29.16,Default,,0,0,0,,Өйткені мұндай шайқастар сирек кездеседі.
Dialogue: 0,0:12:29.24,0:12:31.04,Default,,0,0,0,,Оны аяқтамау босқа кетеді.
Dialogue: 0,0:12:31.12,0:12:33.75,Default,,0,0,0,,Мен осылай мәңгілік күресуді қалаймын.
Dialogue: 0,0:12:36.29,0:12:37.50,Default,,0,0,0,,Бұл менің шығанағым
Dialogue: 0,0:12:42.47,0:12:45.34,Default,,0,0,0,,Егер сіз шығанақты ұмытып қалсаңыз, сіз қуықшы ретінде дисквалификацияланасыз.
Dialogue: 0,0:12:47.26,0:12:48.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:48.18,0:12:49.64,Default,,0,0,0,,Шекара Regalia-ның қалқаны әрі жалғыз қаруы болып табылады.
Dialogue: 0,0:12:50.01,0:12:52.22,Default,,0,0,0,,Бейблейдтер көңілді.
Dialogue: 0,0:12:53.73,0:12:55.06,Default,,0,0,0,,That's right.
Dialogue: 0,0:12:55.56,0:12:56.56,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:12:59.61,0:13:01.07,Default,,0,0,0,,(Мысық мияу)
Dialogue: 0,0:13:03.90,0:13:05.32,Default,,0,0,0,,(Мысық мияу)
Dialogue: 0,0:13:07.11,0:13:08.62,Default,,0,0,0,,Рахмет
Dialogue: 0,0:13:13.04,0:13:15.41,Default,,0,0,0,,Эй, Валькири, сенің оянуың керек еді.
Dialogue: 0,0:13:15.50,0:13:17.37,Default,,0,0,0,,Менде көп серпін жоқ.
Dialogue: 0,0:13:17.46,0:13:19.08,Default,,0,0,0,,Бұл сәтсіз ату ма?
Dialogue: 0,0:13:19.17,0:13:22.05,Default,,0,0,0,,Один жақындап қалды!
Dialogue: 0,0:13:22.13,0:13:23.01,Default,,0,0,0,,Күшті!
Dialogue: 0,0:13:23.13,0:13:24.51,Default,,0,0,0,,Один
Dialogue: 0,0:13:24.59,0:13:26.43,Default,,0,0,0,,Төтенше жүргізуші жабайы болады
Dialogue: 0,0:13:26.51,0:13:30.68,Default,,0,0,0,,Екі қылыш Валькириге аяусыз шабуыл жасайды!
Dialogue: 0,0:13:31.81,0:13:33.10,Default,,0,0,0,,Валькирия!
Dialogue: 0,0:13:33.18,0:13:34.35,Default,,0,0,0,,Fortissimo!
Dialogue: 0,0:13:35.94,0:13:38.35,Default,,0,0,0,,Один үздіксіз шабуылдармен-
Dialogue: 0,0:13:38.44,0:13:41.57,Default,,0,0,0,,Мен Валькириді құлаттым!
Dialogue: 0,0:13:43.28,0:13:45.11,Default,,0,0,0,,Аяқтау
Dialogue: 0,0:13:45.19,0:13:47.57,Default,,0,0,0,,Обелиск Один 1 ұпай!
Dialogue: 0,0:13:48.16,0:13:49.74,Default,,0,0,0,,Ах... а
Dialogue: 0,0:13:50.45,0:13:52.74,Default,,0,0,0,,Бұл сіздің қабілетіңіз
Dialogue: 0,0:13:52.95,0:13:55.41,Default,,0,0,0,,Балто! Қуаныңыз!
Dialogue: 0,0:13:55.50,0:13:58.58,Default,,0,0,0,,Сіздің Валькирияңыз ондай емес шығар.
Dialogue: 0,0:13:58.67,0:14:00.13,Default,,0,0,0,,Бар-нии, берік бол!
Dialogue: 0,0:14:00.46,0:14:02.50,Default,,0,0,0,,Алдарыңыздағы қарсыласқа назар аударыңыз!
Dialogue: 0,0:14:02.96,0:14:04.63,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:14:04.96,0:14:06.09,Default,,0,0,0,,Балтық жігіті!
Dialogue: 0,0:14:13.68,0:14:15.35,Default,,0,0,0,,Кешіріңіз, досым...
Dialogue: 0,0:14:15.43,0:14:17.43,Default,,0,0,0,,Мен шоғырланған жоқпын.
Dialogue: 0,0:14:17.89,0:14:18.98,Default,,0,0,0,,Сөзсіз...
Dialogue: 0,0:14:19.06,0:14:21.06,Default,,0,0,0,,Бұрын істегеніңізді істемеңіз.
Dialogue: 0,0:14:21.86,0:14:24.07,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:14:25.82,0:14:26.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:27.82,0:14:29.57,Default,,0,0,0,,Балто!
Dialogue: 0,0:14:29.66,0:14:30.61,Default,,0,0,0,,Дина!
Dialogue: 0,0:14:30.70,0:14:31.41,Default,,0,0,0,,​​О?
Dialogue: 0,0:14:31.49,0:14:32.91,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:14:32.99,0:14:35.24,Default,,0,0,0,,Мен сенімен шайқасқым келеді
Dialogue: 0,0:14:35.58,0:14:37.96,Default,,0,0,0,,Мен тағы да жүздеген рет шайқасқым келеді!
Dialogue: 0,0:14:38.58,0:14:40.04,Default,,0,0,0,,Мен де...
Dialogue: 0,0:14:40.50,0:14:41.54,Default,,0,0,0,,Мен де!
Dialogue: 0,0:14:41.88,0:14:44.09,Default,,0,0,0,,Сіздермен көбірек күресейік!
Dialogue: 0,0:14:44.38,0:14:47.09,Default,,0,0,0,,Мені қайтадан Бей клубына кіргізіңіз.
Dialogue: 0,0:14:47.30,0:14:48.47,Default,,0,0,0,,Сен ақымақ
Dialogue: 0,0:14:48.55,0:14:51.05,Default,,0,0,0,,Мен сені жұмыстан шығаруға мәжбүрлемеймін!
Dialogue: 0,0:14:53.47,0:14:54.97,Default,,0,0,0,,Жеңіс!
Dialogue: 0,0:14:55.06,0:14:58.14,Default,,0,0,0,,Балто!
Dialogue: 0,0:15:01.40,0:15:03.31,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:15:03.40,0:15:05.11,Default,,0,0,0,,Міне!
Dialogue: 0,0:15:06.73,0:15:07.86,Default,,0,0,0,,Қарақұйрық
Dialogue: 0,0:15:07.94,0:15:08.82,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:09.28,0:15:10.36,Default,,0,0,0,,Гахаха!
Dialogue: 0,0:15:10.45,0:15:12.66,Default,,0,0,0,,Кәдімгі Балтоға оралды
Dialogue: 0,0:15:12.82,0:15:14.70,Default,,0,0,0,,Қазір қызық болып барады.
Dialogue: 0,0:15:15.70,0:15:16.70,Default,,0,0,0,,Иә
Dialogue: 0,0:15:17.41,0:15:18.75,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:15:23.17,0:15:24.88,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:15:25.38,0:15:28.51,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:28.92,0:15:31.38,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:34.30,0:15:35.35,Default,,0,0,0,,Ойна!
Dialogue: 0,0:15:35.43,0:15:37.39,Default,,0,0,0,,Обелиск Один!
Dialogue: 0,0:15:43.48,0:15:46.32,Default,,0,0,0,,Кенеттен Один жүгіре бастады!
Dialogue: 0,0:15:47.44,0:15:50.74,Default,,0,0,0,,Жабайы жүр, Валькири!
Dialogue: 0,0:15:53.11,0:15:55.12,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:15:57.58,0:15:59.91,Default,,0,0,0,,Валькири жылдам қозғалады!
Dialogue: 0,0:16:00.00,0:16:01.62,Default,,0,0,0,,Одиннен қашты!
Dialogue: 0,0:16:02.33,0:16:03.96,Default,,0,0,0,,Жүр!
Dialogue: 0,0:16:05.00,0:16:06.34,Default,,0,0,0,,(Қабырғаға соғылған дыбыс)
Dialogue: 0,0:16:06.50,0:16:08.46,Default,,0,0,0,,Валькири қабырғаға соқты
Dialogue: 0,0:16:08.55,0:16:10.09,Default,,0,0,0,,Жылдамдық одан да артты!
Dialogue: 0,0:16:10.17,0:16:11.01,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:16:11.13,0:16:12.93,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:16:15.22,0:16:17.64,Default,,0,0,0,,Күшті шабуыл!
Dialogue: 0,0:16:17.85,0:16:19.56,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:21.64,0:16:22.94,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:23.06,0:16:25.02,Default,,0,0,0,,Валькирияның жеңісі
Dialogue: 0,0:16:25.10,0:16:26.40,Default,,0,0,0,,Толық аяқтау
Dialogue: 0,0:16:26.48,0:16:28.73,Default,,0,0,0,,Барто Аои 2-1 жеңді!
Dialogue: 0,0:16:28.82,0:16:32.15,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:32.78,0:16:33.65,Default,,0,0,0,,Иә
Dialogue: 0,0:16:33.74,0:16:35.24,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:35.36,0:16:36.74,Default,,0,0,0,,Валькирия
Dialogue: 0,0:16:36.82,0:16:39.45,Default,,0,0,0,,Аймақ таңдау турнирі: Жеңіс блогы А-
Dialogue: 0,0:16:39.54,0:16:41.20,Default,,0,0,0,,Бүкіл елге билетті кім алды?
Dialogue: 0,0:16:41.29,0:16:43.04,Default,,0,0,0,,Бұл Барто Аои!
Dialogue: 0,0:16:43.71,0:16:45.33,Default,,0,0,0,,Сен істедің, Балто.
Dialogue: 0,0:16:45.83,0:16:47.58,Default,,0,0,0,,Үлкен мәселе емес
Dialogue: 0,0:16:47.67,0:16:50.13,Default,,0,0,0,,Мен сізге бұдан да керемет нәрсе көрсетемін
Dialogue: 0,0:16:51.09,0:16:53.01,Default,,0,0,0,,Келесі - ақырында
Dialogue: 0,0:16:53.09,0:16:54.76,Default,,0,0,0,,Бұл C блогының финалы!
Dialogue: 0,0:16:54.88,0:16:57.01,Default,,0,0,0,,Қорғаныс түрі Wild Wyvern
Dialogue: 0,0:16:57.09,0:16:58.18,Default,,0,0,0,,Темірмен қапталған қорғаныс және
Dialogue: 0,0:16:58.26,0:17:01.10,Default,,0,0,0,,Күшті қарсы қалқан соққысымен қаруланған
Dialogue: 0,0:17:01.47,0:17:03.23,Default,,0,0,0,,Мақсат – ұлттық үстемдік
Dialogue: 0,0:17:03.31,0:17:06.02,Default,,0,0,0,,Бұл адамға жеңіліс жарамайды!
Dialogue: 0,0:17:06.10,0:17:07.85,Default,,0,0,0,,Бұл Комурасаки Вакия!
Dialogue: 0,0:17:07.94,0:17:10.40,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:10.48,0:17:11.53,Default,,0,0,0,,Қарсы
Dialogue: 0,0:17:11.61,0:17:14.53,Default,,0,0,0,,Төзімділік түрі Jaeger Yggdrasil
Dialogue: 0,0:17:14.61,0:17:16.49,Default,,0,0,0,,Стадионда тұрған фигура...
Dialogue: 0,0:17:16.57,0:17:17.95,Default,,0,0,0,,Дәл самурай сияқты
Dialogue: 0,0:17:18.03,0:17:20.74,Default,,0,0,0,,Кім кедергі келтірсе, ол екіге бөлінеді
Dialogue: 0,0:17:20.83,0:17:22.49,Default,,0,0,0,,Нансуи Юго!
Dialogue: 0,0:17:22.58,0:17:24.08,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:24.29,0:17:26.46,Default,,0,0,0,,түрі болса, Юго тиімді.
Dialogue: 0,0:17:26.54,0:17:28.50,Default,,0,0,0,,Уакияның қалай шығатынына байланысты.
Dialogue: 0,0:17:28.58,0:17:30.71,Default,,0,0,0,,Қараңызшы, Юго!
Dialogue: 0,0:17:31.25,0:17:34.05,Default,,0,0,0,,Зактан жеңілгеніңізді ұстамаңыз.
Dialogue: 0,0:17:34.59,0:17:36.34,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:17:40.10,0:17:42.39,Default,,0,0,0,,Бетпе-бет шайқас Икудегозару
Dialogue: 0,0:17:42.60,0:17:44.39,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:17:44.73,0:17:47.90,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:47.98,0:17:49.98,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:51.44,0:17:53.98,Default,,0,0,0,,Wild Wyvern орталығына барыңыз!
Dialogue: 0,0:17:54.07,0:17:55.24,Default,,0,0,0,,Қабыл ал!
Dialogue: 0,0:17:55.36,0:17:57.24,Default,,0,0,0,,Бөшкені сипап өтіңіз!
Dialogue: 0,0:17:57.45,0:17:59.99,Default,,0,0,0,,Slash! Yggdrasil!
Dialogue: 0,0:18:00.07,0:18:03.04,Default,,0,0,0,,Yggdrasil Wyvern-ге шабуыл жасайды
Dialogue: 0,0:18:06.50,0:18:08.08,Default,,0,0,0,,Қалқан апаты!
Dialogue: 0,0:18:08.17,0:18:10.54,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:18:11.29,0:18:13.88,Default,,0,0,0,,Wild Wyvern's Burst Finish
Dialogue: 0,0:18:13.96,0:18:16.92,Default,,0,0,0,,Вакия Комурасаки 2:0 есебімен жеңіске жетті!
Dialogue: 0,0:18:17.09,0:18:19.18,Default,,0,0,0,,С блогының жеңімпазы -
Dialogue: 0,0:18:19.26,0:18:21.26,Default,,0,0,0,,Комурасаки Вакия!
Dialogue: 0,0:18:21.35,0:18:24.97,Default,,0,0,0,,Республикалық турнирге қатысу туралы шешім қабылданды!
Dialogue: 0,0:18:25.06,0:18:27.73,Default,,0,0,0,,Біз бүкіл ел бойынша үздікпіз!
Dialogue: 0,0:18:28.52,0:18:30.81,Default,,0,0,0,,Тыңда, Шу! Бұл ойын!
Dialogue: 0,0:18:31.23,0:18:32.02,Default,,0,0,0,,Иә
Dialogue: 0,0:18:33.19,0:18:35.11,Default,,0,0,0,,Шуды жеңетін менмін!
Dialogue: 0,0:18:35.40,0:18:37.53,Default,,0,0,0,,Ей, мен де осындамын
Dialogue: 0,0:18:38.15,0:18:41.91,Default,,0,0,0,,Уау! Комурасаки Вакия мен Аои Барто төрт айналымнан тұратын император болды.
Dialogue: 0,0:18:41.99,0:18:44.08,Default,,0,0,0,,Шақыру қабылданды!
Dialogue: 0,0:18:44.33,0:18:46.62,Default,,0,0,0,,Шу және Балто Вакия?
Dialogue: 0,0:18:46.70,0:18:48.54,Default,,0,0,0,,Менің ойымша, үш адам қатысады.
Dialogue: 0,0:18:48.62,0:18:50.58,Default,,0,0,0,,Керемет! Йонекома Гакуэн
Dialogue: 0,0:18:50.67,0:18:52.58,Default,,0,0,0,,Барлығына~ Сәттілік~
Dialogue: 0,0:18:52.96,0:18:56.46,Default,,0,0,0,,Енді жеңіске жеткен желаяқтардың мақсаттары қандай?
Dialogue: 0,0:18:56.55,0:18:59.93,Default,,0,0,0,,Бұл ұлттық турнир!
Dialogue: 0,0:19:02.68,0:19:03.72,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:19:03.80,0:19:06.14,Default,,0,0,0,,Анашым, мен жасадым!
Dialogue: 0,0:19:06.47,0:19:07.81,Default,,0,0,0,,Мен жеңдім!
Dialogue: 0,0:19:08.14,0:19:10.23,Default,,0,0,0,,Сіз республикалық байқауға қатыса аласыз!
Dialogue: 0,0:19:12.06,0:19:14.44,Default,,0,0,0,,Иә? Ана...
Dialogue: 0,0:19:16.73,0:19:18.44,Default,,0,0,0,,Ешкім жоқ па...
Dialogue: 0,0:19:18.53,0:19:19.53,Default,,0,0,0,,Ана
Dialogue: 0,0:19:19.74,0:19:20.99,Default,,0,0,0,,(Крекер дыбысы)
Dialogue: 0,0:19:22.53,0:19:23.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:23.66,0:19:25.37,Default,,0,0,0,,Құттықтаймыз!
Dialogue: 0,0:19:25.83,0:19:26.87,Default,,0,0,0,,Анашым...
Dialogue: 0,0:19:26.95,0:19:28.95,Default,,0,0,0,,Токонацу… Ника…
Dialogue: 0,0:19:29.45,0:19:30.79,Default,,0,0,0,,Иә, бұл
Dialogue: 0,0:19:31.12,0:19:32.54,Default,,0,0,0,,Анамның ерекшелігі
Dialogue: 0,0:19:32.62,0:19:35.34,Default,,0,0,0,,Valkyrie Pan жеңімпаз нұсқасы!
Dialogue: 0,0:19:35.42,0:19:38.63,Default,,0,0,0,,Мен мұны жасадым, өйткені мен Балто міндетті түрде жеңеді деп ойладым.
Dialogue: 0,0:19:39.67,0:19:41.09,Default,,0,0,0,,Анашым...
Dialogue: 0,0:19:41.59,0:19:44.01,Default,,0,0,0,,Ұлттық турнирде жабайы болыңыз.
Dialogue: 0,0:19:45.10,0:19:48.27,Default,,0,0,0,,Анам жасаған беймисанга маған жұмыс істеді.
Dialogue: 0,0:19:49.14,0:19:50.48,Default,,0,0,0,,Ангатона
Dialogue: 0,0:19:50.77,0:19:52.85,Default,,0,0,0,,Бал-нии жылап жіберді.
Dialogue: 0,0:19:52.94,0:19:54.77,Default,,0,0,0,,(асқазанның ырылдаған дыбысы)
Dialogue: 0,0:19:54.86,0:19:55.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:55.61,0:19:57.07,Default,,0,0,0,,Менің де ішім дірілдеп кетті
Dialogue: 0,0:19:58.53,0:20:00.28,Default,,0,0,0,,Мен оны аламын.
Dialogue: 0,0:20:02.24,0:20:04.32,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:20:04.41,0:20:07.49,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:20:08.70,0:20:10.33,Default,,0,0,0,,Құрметті Бей клубы
Dialogue: 0,0:20:10.66,0:20:12.46,Default,,0,0,0,,Менде қорқынышты жаңалық бар.
Dialogue: 0,0:20:12.71,0:20:14.54,Default,,0,0,0,,Бұл не, директор?
Dialogue: 0,0:20:14.63,0:20:17.21,Default,,0,0,0,,Ұлттық конкурсқа қатысуға құқығы бар -
Dialogue: 0,0:20:17.29,0:20:19.05,Default,,0,0,0,,Ойыншылары бар командалар үшін -
Dialogue: 0,0:20:19.13,0:20:22.30,Default,,0,0,0,,Сіз командалық жарысқа қатыса аласыз.
Dialogue: 0,0:20:22.38,0:20:23.68,Default,,0,0,0,,Командалық шайқас...?
Dialogue: 0,0:20:23.76,0:20:26.26,Default,,0,0,0,,5 адамнан тұратын командада күресу
Dialogue: 0,0:20:26.35,0:20:29.22,Default,,0,0,0,,Бірақ біз тек үшеуміз.
Dialogue: 0,0:20:29.60,0:20:31.60,Default,,0,0,0,,Мен осындамын (барлығы) Ах...
Dialogue: 0,0:20:31.68,0:20:32.85,Default,,0,0,0,,Шу…
Dialogue: 0,0:20:32.94,0:20:34.19,Default,,0,0,0,,Өйткені сіз...
Dialogue: 0,0:20:35.23,0:20:37.23,Default,,0,0,0,,Мені осы командаға қосуыңызды өтінемін.
Dialogue: 0,0:20:37.48,0:20:38.52,Default,,0,0,0,,Шу…
Dialogue: 0,0:20:38.73,0:20:40.78,Default,,0,0,0,,Мен мұны бірге жасағым келді.
Dialogue: 0,0:20:41.11,0:20:42.40,Default,,0,0,0,,Ваймоя
Dialogue: 0,0:20:42.74,0:20:44.20,Default,,0,0,0,,Вакия?
Dialogue: 0,0:20:44.74,0:20:46.87,Default,,0,0,0,,Бөшкедегі шығанақ сойыл
Dialogue: 0,0:20:47.07,0:20:49.49,Default,,0,0,0,,Сіз осылай айтасыз! Ақымақ болма!
Dialogue: 0,0:20:50.29,0:20:53.58,Default,,0,0,0,,Балалар, сендер менімен күнде шайқаса аласыңдар.
Dialogue: 0,0:20:53.66,0:20:55.21,Default,,0,0,0,,Ұлттық жарысқа
Dialogue: 0,0:20:55.29,0:20:57.21,Default,,0,0,0,,Бұл ең жақсы тәжірибе, солай ма?
Dialogue: 0,0:20:57.63,0:20:58.84,Default,,0,0,0,,"Дегенмен ол жүгірді."
Dialogue: 0,0:21:00.71,0:21:03.34,Default,,0,0,0,,Hona практикалық серіктесі, берік болыңыз.
Dialogue: 0,0:21:03.67,0:21:06.80,Default,,0,0,0,,У-ның ұлттық үстемдігіне байланысты.
Dialogue: 0,0:21:07.39,0:21:09.39,Default,,0,0,0,,Бұл не? Конняро~
Dialogue: 0,0:21:09.47,0:21:10.68,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:21:10.76,0:21:11.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:11.60,0:21:13.93,Default,,0,0,0,,Достарымыздың көп болғанына өте қуаныштымыз!
Dialogue: 0,0:21:14.02,0:21:15.02,Default,,0,0,0,,Балто!
Dialogue: 0,0:21:15.23,0:21:16.52,Default,,0,0,0,,Кумичо
Dialogue: 0,0:21:16.69,0:21:19.73,Default,,0,0,0,,Біз Bay Club-ты ашқанда екеуміз ғана едік...
Dialogue: 0,0:21:19.94,0:21:22.78,Default,,0,0,0,,Мен көптеген жаңа достар таптым!
Dialogue: 0,0:21:22.86,0:21:24.44,Default,,0,0,0,,Ең жақсысы емес пе?
Dialogue: 0,0:21:24.53,0:21:25.86,Default,,0,0,0,,Шаршасаңыз да...
Dialogue: 0,0:21:26.07,0:21:28.53,Default,,0,0,0,,Көріп көрейік! Кумичо
Dialogue: 0,0:21:28.62,0:21:31.91,Default,,0,0,0,,Командалық матчқа қатысу үшін сіздің командаңызға 5 адам керек.
Dialogue: 0,0:21:32.24,0:21:33.41,Default,,0,0,0,,Куу…
Dialogue: 0,0:21:33.75,0:21:35.37,Default,,0,0,0,,Жақсы! Түсінікті!
Dialogue: 0,0:21:35.71,0:21:37.62,Default,,0,0,0,,Мұнда бес адам бар.
Dialogue: 0,0:21:37.87,0:21:39.92,Default,,0,0,0,,Йонекома Гакуэн шығанағы клубы
Dialogue: 0,0:21:40.21,0:21:42.09,Default,,0,0,0,,Ресми түрде туған
Dialogue: 0,0:21:42.17,0:21:43.76,Default,,0,0,0,,Иә!
Dialogue: 0,0:21:44.05,0:21:47.47,Default,,0,0,0,,Ұлттық турнирдің командалық жарысы өткізіледі деп шешілсе.
Dialogue: 0,0:21:47.55,0:21:48.89,Default,,0,0,0,,Жеңіске ұмтылу―
Dialogue: 0,0:21:49.01,0:21:50.39,Default,,0,0,0,,Жүгірейік!
Dialogue: 0,0:21:50.64,0:21:51.97,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.35,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Артынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.27,0:23:29.69,Default,,0,0,0,,Вакия ұлттық турнирге дайындық үшін оқу-жаттығу жиынын өткізетінін айтты.
Dialogue: 0,0:23:29.78,0:23:32.99,Default,,0,0,0,,Барлығымыз Уакияның вилласына баруды шештік.
Dialogue: 0,0:23:33.07,0:23:36.20,Default,,0,0,0,,Ол жерде тозақтың стадионы орнатылған.
Dialogue: 0,0:23:36.28,0:23:38.91,Default,,0,0,0,,Ал командалық жарысқа жаттығу басталды.
Dialogue: 0,0:23:39.00,0:23:41.62,Default,,0,0,0,,Өте жалынды командалық шайқас
Dialogue: 0,0:23:41.71,0:23:43.58,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:43.67,0:23:46.13,Default,,0,0,0,,Оқу-жаттығу лагері! Викинг стадионы!
Dialogue: 0,0:23:46.21,0:23:47.96,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.05,0:23:49.55,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.05,0:23:57.05,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory