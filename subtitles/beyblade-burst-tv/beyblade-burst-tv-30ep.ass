Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.50,0:00:09.13,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.21,0:00:12.51,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.59,0:00:14.68,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.76,0:00:16.85,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:16.97,0:00:19.26,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.43,0:00:24.10,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.19,0:00:26.15,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.23,0:00:28.73,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:33.32,0:00:34.90,Default,,0,0,0,,Мен
Dialogue: 0,0:00:34.99,0:00:36.99,Default,,0,0,0,,Мен серіктесіме ант етемін
Dialogue: 0,0:00:37.28,0:00:40.49,Default,,0,0,0,,Бар күшіммен күресемін.
Dialogue: 0,0:00:40.70,0:00:44.16,Default,,0,0,0,,Ендеше Валькири, барымызды салайық.
Dialogue: 0,0:00:44.25,0:00:47.13,Default,,0,0,0,,Барлығы да қолыңнан келгенін істе
Dialogue: 0,0:00:47.21,0:00:51.00,Default,,0,0,0,,Өте қызу шайқас болайық!
Dialogue: 0,0:00:56.05,0:00:57.26,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:00:57.34,0:00:59.93,Default,,0,0,0,,Республикалық турнирдің басындағы спортшының ант беруі
Dialogue: 0,0:01:00.01,0:01:02.31,Default,,0,0,0,,Мен қатты қобалжыдым~
Dialogue: 0,0:01:02.39,0:01:04.81,Default,,0,0,0,,Мен бар күшімді саламын!
Dialogue: 0,0:01:12.78,0:01:15.15,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:15.49,0:01:20.66,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:31.96,0:01:35.34,Default,,0,0,0,,Мен барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:35.84,0:01:37.97,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:38.38,0:01:42.51,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:42.64,0:01:45.85,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:01:45.98,0:01:52.40,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:01:52.69,0:01:57.11,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:01:57.61,0:02:03.03,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:03.16,0:02:05.41,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:05.50,0:02:10.21,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:10.38,0:02:15.46,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:15.76,0:02:18.01,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:18.22,0:02:20.55,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:20.84,0:02:24.76,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:24.93,0:02:29.94,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:30.15,0:02:32.31,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:36.23,0:02:39.07,Default,,0,0,0,,Жылан қанаттары! Кецалькатл
Dialogue: 0,0:02:40.53,0:02:43.37,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар
Dialogue: 0,0:02:43.49,0:02:46.45,Default,,0,0,0,,Бейблейд ұлттық турнирі бойынша командалық жарыс
Dialogue: 0,0:02:46.62,0:02:50.12,Default,,0,0,0,,Әр аймақтан таңдалған 16 команда құрастырған
Dialogue: 0,0:02:50.21,0:02:51.42,Default,,0,0,0,,Ыстық шайқас
Dialogue: 0,0:02:51.50,0:02:53.33,Default,,0,0,0,,Ақырында бұл ашылу!
Dialogue: 0,0:02:53.42,0:02:56.34,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:02:56.42,0:02:58.63,Default,,0,0,0,,Жарайды, бұл Батчши!
Dialogue: 0,0:02:59.13,0:03:01.93,Default,,0,0,0,,Бірінші айналымда кім жеңеді деп ойлаймын
Dialogue: 0,0:03:02.01,0:03:04.35,Default,,0,0,0,,Кез келген жерге келіңіз!
Dialogue: 0,0:03:04.43,0:03:05.85,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:03:06.01,0:03:08.68,Default,,0,0,0,,Ойын басталар алдында тым ыстық болды.
Dialogue: 0,0:03:08.85,0:03:10.06,Default,,0,0,0,,Ой!
Dialogue: 0,0:03:10.14,0:03:12.81,Default,,0,0,0,,Бұл жерде күн ыстық, қашан күшейеді?
Dialogue: 0,0:03:12.90,0:03:16.40,Default,,0,0,0,,Қызып алайық! (Tokonatsu Aoi/Hinatsu Aoi) Болайық!
Dialogue: 0,0:03:16.52,0:03:18.78,Default,,0,0,0,,Енді бірінші тур басталады.
Dialogue: 0,0:03:18.86,0:03:21.86,Default,,0,0,0,,Бірінші матчтың жұптарын жариялаймыз.
Dialogue: 0,0:03:22.86,0:03:24.70,Default,,0,0,0,,Ол шықты...
Dialogue: 0,0:03:25.91,0:03:27.08,Default,,0,0,0,,Біз?
Dialogue: 0,0:03:27.16,0:03:30.00,Default,,0,0,0,,А блогының бірінші ойынына қатысатын командалар
Dialogue: 0,0:03:30.08,0:03:32.58,Default,,0,0,0,,Капитан Балто Аои басқарды
Dialogue: 0,0:03:32.67,0:03:34.63,Default,,0,0,0,,Йонекома Гакуэн шығанағы клубы
Dialogue: 0,0:03:34.71,0:03:36.04,Default,,0,0,0,,Неге олай? Өте суықсың ғой.
Dialogue: 0,0:03:36.13,0:03:37.96,Default,,0,0,0,,Біз біріншіміз
Dialogue: 0,0:03:38.05,0:03:39.76,Default,,0,0,0,,No... 1-ші?
Dialogue: 0,0:03:39.84,0:03:42.59,Default,,0,0,0,,Бірінші сәйкестік? (Күреңай шу) А.
Dialogue: 0,0:03:43.05,0:03:44.59,Default,,0,0,0,,Менің капитаным
Dialogue: 0,0:03:44.68,0:03:46.89,Default,,0,0,0,,Шынында да, ұтыс ойынының сәттілігі жақсы.
Dialogue: 0,0:03:46.97,0:03:48.77,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:03:48.93,0:03:49.93,Default,,0,0,0,,Хун
Dialogue: 0,0:03:50.06,0:03:51.10,Default,,0,0,0,,Гррр!
Dialogue: 0,0:03:51.43,0:03:55.61,Default,,0,0,0,,Жарайды, енді капитан топпен таныстырады.
Dialogue: 0,0:03:55.94,0:03:57.07,Default,,0,0,0,,Уау~
Dialogue: 0,0:03:57.15,0:03:58.73,Default,,0,0,0,,Әңгімелесу кезінде.
Dialogue: 0,0:03:58.94,0:04:01.69,Default,,0,0,0,,О, о... біз
Dialogue: 0,0:04:02.03,0:04:06.16,Default,,0,0,0,,Йонекома Гакуэн шығанағы клубы
Dialogue: 0,0:04:06.24,0:04:08.83,Default,,0,0,0,,Мм... ой
Dialogue: 0,0:04:09.87,0:04:13.33,Default,,0,0,0,,Ze… Ze Zete
Dialogue: 0,0:04:13.41,0:04:14.75,Default,,0,0,0,,(ысқыру дыбысы)
Dialogue: 0,0:04:16.88,0:04:18.29,Default,,0,0,0,,Жеңіс
Dialogue: 0,0:04:18.46,0:04:23.26,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:04:24.18,0:04:25.64,Default,,0,0,0,,Оны алыңыз~
Dialogue: 0,0:04:25.72,0:04:27.68,Default,,0,0,0,,Бартқа ұқсайды.
Dialogue: 0,0:04:28.14,0:04:29.35,Default,,0,0,0,,Хаха...
Dialogue: 0,0:04:29.43,0:04:30.43,Default,,0,0,0,,Балто~
Dialogue: 0,0:04:30.52,0:04:31.81,Default,,0,0,0,,Кешіріңіз мені кешіріңіз
Dialogue: 0,0:04:32.31,0:04:34.10,Default,,0,0,0,,Бұл сасық ба?
Dialogue: 0,0:04:34.81,0:04:37.27,Default,,0,0,0,,Ал А блогының бірінші ойыны
Dialogue: 0,0:04:37.36,0:04:39.19,Default,,0,0,0,,Команда қарсы
Dialogue: 0,0:04:40.11,0:04:42.57,Default,,0,0,0,,Капитан Сары-Жасыл Куон басқарды
Dialogue: 0,0:04:42.65,0:04:43.74,Default,,0,0,0,,Мұз жалыны
Dialogue: 0,0:04:44.11,0:04:44.82,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:46.45,0:04:48.57,Default,,0,0,0,,Ах! Құдай!
Dialogue: 0,0:04:48.78,0:04:51.66,Default,,0,0,0,,Құдай емес Сары-жасыл Квон
Dialogue: 0,0:04:51.95,0:04:53.62,Default,,0,0,0,,Ice Blaze?
Dialogue: 0,0:04:53.71,0:04:55.54,Default,,0,0,0,,Кенеттен айбатты жау.
Dialogue: 0,0:04:55.62,0:04:56.54,Default,,0,0,0,,О
Dialogue: 0,0:04:56.62,0:04:59.50,Default,,0,0,0,,Сіз Құдайдың командасындасыз ба?
Dialogue: 0,0:04:59.79,0:05:01.30,Default,,0,0,0,,Ice Blaze - бұл
Dialogue: 0,0:05:01.38,0:05:04.55,Default,,0,0,0,,Бүкіл команда қорғаныс түрін пайдаланады.
Dialogue: 0,0:05:04.72,0:05:06.63,Default,,0,0,0,,Бұл өте қорғаныс командасы.
Dialogue: 0,0:05:06.93,0:05:08.51,Default,,0,0,0,,Гахаха!
Dialogue: 0,0:05:08.59,0:05:10.10,Default,,0,0,0,,Балтоның командасымен кенеттен
Dialogue: 0,0:05:10.18,0:05:11.81,Default,,0,0,0,,Куонның командасы жеңді ме?
Dialogue: 0,0:05:12.22,0:05:15.44,Default,,0,0,0,,Шақа кімді қолдайды?
Dialogue: 0,0:05:15.52,0:05:17.40,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:05:17.69,0:05:20.27,Default,,0,0,0,,Қалай болғанда да, бұл қызықты.
Dialogue: 0,0:05:20.52,0:05:22.23,Default,,0,0,0,,Олай болса, кеттік!
Dialogue: 0,0:05:22.36,0:05:24.07,Default,,0,0,0,,Ұлттық турнирдің командалық жарысы
Dialogue: 0,0:05:24.15,0:05:27.28,Default,,0,0,0,,Бірінші раунд Бірінші матчтың басталуы
Dialogue: 0,0:05:27.36,0:05:29.20,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:05:29.28,0:05:31.28,Default,,0,0,0,,Ойыншылар кіреді!
Dialogue: 0,0:05:32.58,0:05:36.04,Default,,0,0,0,,Қызыл бұрыш Йонекома Гакуэн шығанағы клубы
Dialogue: 0,0:05:36.87,0:05:39.38,Default,,0,0,0,,Аудандық іріктеу турнирінде жеңіске жетті
Dialogue: 0,0:05:39.46,0:05:41.63,Default,,0,0,0,,Капитан Балт Аои
Dialogue: 0,0:05:42.09,0:05:45.63,Default,,0,0,0,,Комурасаки Вакия да жеңіске жетті.
Dialogue: 0,0:05:46.22,0:05:49.39,Default,,0,0,0,,Рантаро Кияма үлкен тәжірибесі бар
Dialogue: 0,0:05:50.09,0:05:52.01,Default,,0,0,0,,Қара құдай динасы
Dialogue: 0,0:05:52.51,0:05:55.56,Default,,0,0,0,,Және төрт өзгерген императордың бірі Бенишуу
Dialogue: 0,0:05:56.23,0:05:59.27,Default,,0,0,0,,Бізде ұлттық деңгейдегі барлық қалақшалар бар!
Dialogue: 0,0:05:59.65,0:06:02.27,Default,,0,0,0,,Бал-нии барын салады~Шу-кун~
Dialogue: 0,0:06:02.77,0:06:04.94,Default,,0,0,0,,Жылама! Ақымақ, Косей! Енді мен де…
Dialogue: 0,0:06:06.07,0:06:08.40,Default,,0,0,0,,және көк бұрыш
Dialogue: 0,0:06:09.11,0:06:13.20,Default,,0,0,0,,Республикалық турнир сахнасында салқын дауыл соғады ма?
Dialogue: 0,0:06:13.74,0:06:17.79,Default,,0,0,0,,Капитан Сары-жасыл Куон бастаған ішке кірген...
Dialogue: 0,0:06:18.21,0:06:19.67,Default,,0,0,0,,Киен Юкино
Dialogue: 0,0:06:19.75,0:06:20.92,Default,,0,0,0,,Химуро Минен және
Dialogue: 0,0:06:21.17,0:06:22.54,Default,,0,0,0,,Дэн Фукиадж
Dialogue: 0,0:06:22.63,0:06:24.25,Default,,0,0,0,,Мазин Китахара
Dialogue: 0,0:06:24.63,0:06:27.84,Default,,0,0,0,,Ice Blaze командасымен таныстыру
Dialogue: 0,0:06:29.38,0:06:31.97,Default,,0,0,0,,Екі команда да стендке кірді.
Dialogue: 0,0:06:32.14,0:06:36.56,Default,,0,0,0,,Матчқа 5 жүздің 3-і ғана қатыса алады
Dialogue: 0,0:06:36.64,0:06:38.56,Default,,0,0,0,,Енді кімді таңдайсың?
Dialogue: 0,0:06:38.64,0:06:40.65,Default,,0,0,0,,Стратегия ~ Уақыт!
Dialogue: 0,0:06:40.98,0:06:42.52,Default,,0,0,0,,Хмм.
Dialogue: 0,0:06:42.61,0:06:44.82,Default,,0,0,0,,Құдайдың командасымен жұмыс істей білу
Dialogue: 0,0:06:44.90,0:06:46.32,Default,,0,0,0,,Мен өте қуаныштымын!
Dialogue: 0,0:06:46.40,0:06:48.49,Default,,0,0,0,,Демек, бұл Құдай емес.
Dialogue: 0,0:06:48.90,0:06:50.57,Default,,0,0,0,,Мүшелер не істеуі керек?
Dialogue: 0,0:06:51.07,0:06:52.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:52.28,0:06:54.24,Default,,0,0,0,,Үш адам шыға алмай жатыр.
Dialogue: 0,0:06:54.49,0:06:56.87,Default,,0,0,0,,Ал, шешілді.
Dialogue: 0,0:06:57.12,0:06:58.50,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:06:58.58,0:07:01.25,Default,,0,0,0,,Барлық жаулар қорғаныс типтері.
Dialogue: 0,0:07:01.33,0:07:04.25,Default,,0,0,0,,Сізге тиімді шығанақ алсаңыз, әрине жақсы.
Dialogue: 0,0:07:04.38,0:07:07.67,Default,,0,0,0,,Ой... виверн де қорғаныс емес пе?
Dialogue: 0,0:07:07.84,0:07:10.68,Default,,0,0,0,,Егер сіз типті болсаңыз, Рагнаруктың шыдамдылығының арқасында артықшылығы бар, солай ма?
Dialogue: 0,0:07:11.18,0:07:11.88,Default,,0,0,0,,Хун
Dialogue: 0,0:07:11.97,0:07:13.68,Default,,0,0,0,,Қазір айтысатын уақыт емес.
Dialogue: 0,0:07:14.39,0:07:16.81,Default,,0,0,0,,Балто, сен капитансың.
Dialogue: 0,0:07:16.97,0:07:18.64,Default,,0,0,0,,Сіз шешесіз.
Dialogue: 0,0:07:18.72,0:07:19.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:20.06,0:07:21.81,Default,,0,0,0,,Бұл капитанның жұмысы.
Dialogue: 0,0:07:24.31,0:07:25.77,Default,,0,0,0,,Техехехе
Dialogue: 0,0:07:26.23,0:07:27.40,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:27.48,0:07:29.99,Default,,0,0,0,,Мен шешім қабылдағаным дұрыс, солай ма?
Dialogue: 0,0:07:30.07,0:07:32.49,Default,,0,0,0,,Мен шығамын. Мен бірінші шығамын.
Dialogue: 0,0:07:32.57,0:07:35.45,Default,,0,0,0,,Эй, Балто, бұл туралы тағы да ойлан.
Dialogue: 0,0:07:35.53,0:07:37.20,Default,,0,0,0,,Капитан - ең жақсы!
Dialogue: 0,0:07:37.29,0:07:39.25,Default,,0,0,0,,Сосын...
Dialogue: 0,0:07:39.70,0:07:42.12,Default,,0,0,0,,Әрине, бұл Кумичо-сама...
Dialogue: 0,0:07:42.21,0:07:43.92,Default,,0,0,0,,Шу және Уакия
Dialogue: 0,0:07:44.46,0:07:46.09,Default,,0,0,0,,Неге мен емес?
Dialogue: 0,0:07:46.17,0:07:47.38,Default,,0,0,0,,Қалай болғанда да?
Dialogue: 0,0:07:47.46,0:07:48.63,Default,,0,0,0,,Не?!
Dialogue: 0,0:07:48.71,0:07:50.42,Default,,0,0,0,,Бұл капитанның шешімі.
Dialogue: 0,0:07:50.51,0:07:52.09,Default,,0,0,0,,Иә, бұл таңдау.
Dialogue: 0,0:07:52.30,0:07:53.43,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:53.55,0:07:56.05,Default,,0,0,0,,Оған көмектесу мүмкін емес, бұл Юдзу.
Dialogue: 0,0:07:56.51,0:07:57.81,Default,,0,0,0,,Құдай-ай, неге қыздар дәретханасында граффити жазып жүрсің өзің?!
Dialogue: 0,0:07:57.89,0:07:59.72,Default,,0,0,0,,Міндетті түрде жеңесіңдер!
Dialogue: 0,0:08:00.14,0:08:02.19,Default,,0,0,0,,Әрине
Dialogue: 0,0:08:10.82,0:08:13.65,Default,,0,0,0,,Мұнда командалық жарыстардың ережесі берілген.
Dialogue: 0,0:08:13.74,0:08:15.99,Default,,0,0,0,,Маған қайта қарап шығуға рұқсат етіңіз.
Dialogue: 0,0:08:16.12,0:08:18.16,Default,,0,0,0,,Әр команда үш жүзді таңдаса
Dialogue: 0,0:08:18.45,0:08:22.33,Default,,0,0,0,,Ұрыс реті кімнің шыққанына қарамастан дұрыс.
Dialogue: 0,0:08:22.41,0:08:26.25,Default,,0,0,0,,Бір пышақ бір шайқаста ғана ата алады.
Dialogue: 0,0:08:26.33,0:08:29.55,Default,,0,0,0,,Бірінші 3 ұпай алған команда жеңеді.
Dialogue: 0,0:08:29.92,0:08:33.67,Default,,0,0,0,,Қызық, олар неге Рагнаруктың төзімді түрін шығармайды?
Dialogue: 0,0:08:33.76,0:08:36.72,Default,,0,0,0,,Түрдің үйлесімділігі маңызды деп ойлаймын.
Dialogue: 0,0:08:36.80,0:08:37.64,Default,,0,0,0,,Иә
Dialogue: 0,0:08:37.97,0:08:41.10,Default,,0,0,0,,Мен сенімдімін, аға, сіз ештеңе туралы ойламайсыз.
Dialogue: 0,0:08:41.18,0:08:42.39,Default,,0,0,0,,Онда тас, қағаз, қайшы ойнайық.
Dialogue: 0,0:08:45.90,0:08:48.23,Default,,0,0,0,,Бірінші Бладер, алға шық.
Dialogue: 0,0:08:48.69,0:08:49.90,Default,,0,0,0,,Мен осындамын...
Dialogue: 0,0:08:49.98,0:08:51.40,Default,,0,0,0,,Жарайды, кеттік!
Dialogue: 0,0:08:51.48,0:08:52.57,Default,,0,0,0,,Сәлем~
Dialogue: 0,0:08:54.40,0:08:58.70,Default,,0,0,0,,Бірінші шайқас – капитандар арасындағы шайқас.
Dialogue: 0,0:08:58.78,0:09:01.62,Default,,0,0,0,,Жеңіске жетсем, командаға серпін беремін.
Dialogue: 0,0:09:07.54,0:09:09.00,Default,,0,0,0,,Тағы да келдің бе?
Dialogue: 0,0:09:09.09,0:09:10.88,Default,,0,0,0,,Шақа адам таныды
Dialogue: 0,0:09:11.80,0:09:13.13,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:09:13.51,0:09:15.84,Default,,0,0,0,,Мен сені жеңемін
Dialogue: 0,0:09:16.13,0:09:18.14,Default,,0,0,0,,Республикалық турнирдің бірінші ойынында
Dialogue: 0,0:09:18.22,0:09:19.97,Default,,0,0,0,,Сізбен шайқаса білу
Dialogue: 0,0:09:20.05,0:09:21.47,Default,,0,0,0,,Мен осындамын.
Dialogue: 0,0:09:21.85,0:09:22.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:22.89,0:09:24.18,Default,,0,0,0,,Бұл сәйкестік
Dialogue: 0,0:09:24.27,0:09:27.40,Default,,0,0,0,,Елдің түкпір-түкпіріндегілер теледидардан оған назар аударып жатыр.
Dialogue: 0,0:09:27.48,0:09:29.11,Default,,0,0,0,,Жақында келіңіз
Dialogue: 0,0:09:29.19,0:09:31.15,Default,,0,0,0,,Ұлттық турнирдің басталуы
Dialogue: 0,0:09:31.23,0:09:34.24,Default,,0,0,0,,Бірінші ату сәті келеді
Dialogue: 0,0:09:35.15,0:09:37.28,Default,,0,0,0,,Мен жеңдім.
Dialogue: 0,0:09:37.36,0:09:41.70,Default,,0,0,0,,Басты кейіпкерлер – Кецалькатл екеуміз... Менің ойымша.
Dialogue: 0,0:09:41.95,0:09:43.04,Default,,0,0,0,,Не...!
Dialogue: 0,0:09:43.12,0:09:44.91,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:09:45.12,0:09:47.29,Default,,0,0,0,,Мен міндетті түрде жеңемін.
Dialogue: 0,0:09:47.96,0:09:49.83,Default,,0,0,0,,Мен мұны бір кадрда шешемін.
Dialogue: 0,0:09:50.50,0:09:52.80,Default,,0,0,0,,Ал, қызып кет.
Dialogue: 0,0:09:52.96,0:09:54.21,Default,,0,0,0,,Бұл жаман.
Dialogue: 0,0:09:54.30,0:09:57.63,Default,,0,0,0,,Мен енді қарсыласымның қарқынына төтеп бере алмайтын сияқтымын.
Dialogue: 0,0:09:58.93,0:10:01.68,Default,,0,0,0,,Балт, сабыр ет~
Dialogue: 0,0:10:01.93,0:10:03.76,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:10:03.85,0:10:07.60,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:07.69,0:10:10.61,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:11.69,0:10:14.28,Default,,0,0,0,,Екеуі де атылды~
Dialogue: 0,0:10:14.36,0:10:17.61,Default,,0,0,0,,Кецалькатль орталық позицияны қатты иеленді
Dialogue: 0,0:10:17.70,0:10:19.57,Default,,0,0,0,,Валькири асығыс атуы
Dialogue: 0,0:10:19.70,0:10:22.58,Default,,0,0,0,,Ой, бірақ бұл өте қатты~
Dialogue: 0,0:10:22.70,0:10:25.58,Default,,0,0,0,,Жүр! Валькирия!
Dialogue: 0,0:10:26.45,0:10:27.46,Default,,0,0,0,,Сонымен бірге Rohan деген жігіт те—
Dialogue: 0,0:10:27.54,0:10:30.37,Default,,0,0,0,,Кецалькатлдың қанатының дәмін тат
Dialogue: 0,0:10:30.54,0:10:32.21,Default,,0,0,0,,Бірінші байланыс
Dialogue: 0,0:10:32.29,0:10:35.00,Default,,0,0,0,,Валькиридің оқ жаудырды~
Dialogue: 0,0:10:35.30,0:10:37.80,Default,,0,0,0,,Қашықтық
Dialogue: 0,0:10:37.97,0:10:39.05,Default,,0,0,0,,Бірақ бұл-
Dialogue: 0,0:10:39.22,0:10:41.22,Default,,0,0,0,,Кецалькатльдің серпілу дискісі
Dialogue: 0,0:10:41.34,0:10:44.72,Default,,0,0,0,,Серіппе сияқты соққыны жұтып, күшін жояды
Dialogue: 0,0:10:44.93,0:10:45.97,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:10:46.14,0:10:50.35,Default,,0,0,0,,Бұл Кецалькатлдың қанаттарымен оқ атуы!
Dialogue: 0,0:10:50.69,0:10:53.40,Default,,0,0,0,,Валькирияның төзімділігі ұрланған
Dialogue: 0,0:10:53.48,0:10:55.48,Default,,0,0,0,,Міне... Валькири
Dialogue: 0,0:10:55.78,0:10:58.15,Default,,0,0,0,,Міне, осылай.
Dialogue: 0,0:10:58.57,0:11:01.45,Default,,0,0,0,,Куон, сен қолыңды көтердің.
Dialogue: 0,0:11:01.74,0:11:05.24,Default,,0,0,0,,Бұл дискіні қорғаушы қатты.
Dialogue: 0,0:11:05.33,0:11:07.75,Default,,0,0,0,,Ол жай скейтбордшы емес еді.
Dialogue: 0,0:11:10.75,0:11:13.46,Default,,0,0,0,,Кецалькатл тек қорғаныс үшін ғана емес.
Dialogue: 0,0:11:13.79,0:11:17.17,Default,,0,0,0,,Жыртқышты тістеу Кецалькатль
Dialogue: 0,0:11:19.84,0:11:21.22,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:11:24.60,0:11:26.97,Default,,0,0,0,,Анықталған күшті санауыш
Dialogue: 0,0:11:27.06,0:11:29.77,Default,,0,0,0,,Аңызға айналған жылан азу тістерін аршып алды.
Dialogue: 0,0:11:29.98,0:11:30.68,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:31.56,0:11:32.81,Default,,0,0,0,,Қабырғаға соғылу
Dialogue: 0,0:11:33.60,0:11:34.77,Default,,0,0,0,,Валькирия
Dialogue: 0,0:11:34.86,0:11:39.61,Default,,0,0,0,,Маған оянған күшіңді көрсет~
Dialogue: 0,0:11:40.53,0:11:42.24,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:11:50.37,0:11:53.46,Default,,0,0,0,,Валькири жабайы зарядталады
Dialogue: 0,0:11:53.54,0:11:55.79,Default,,0,0,0,,Кецалькатль оған қарай атып тұр
Dialogue: 0,0:11:56.13,0:11:59.17,Default,,0,0,0,,Барыңыз~ Валькирия!
Dialogue: 0,0:12:01.22,0:12:04.22,Default,,0,0,0,,Флик Кецалькатл
Dialogue: 0,0:12:10.06,0:12:12.06,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:12:12.31,0:12:12.94,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:13.02,0:12:15.52,Default,,0,0,0,,Burst It bust ~
Dialogue: 0,0:12:15.65,0:12:17.44,Default,,0,0,0,,Квадкетзалкатл
Dialogue: 0,0:12:17.52,0:12:19.69,Default,,0,0,0,,2 ұпай
Dialogue: 0,0:12:21.53,0:12:22.82,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:22.95,0:12:25.24,Default,,0,0,0,,Ах, Балто...
Dialogue: 0,0:12:25.32,0:12:26.49,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:12:27.37,0:12:29.45,Default,,0,0,0,,Жарайды, тырнақтар тәтті екен.
Dialogue: 0,0:12:30.08,0:12:32.96,Default,,0,0,0,,Бұл Шақаның таныған жігіт екеніне сене алар емеспін.
Dialogue: 0,0:12:35.08,0:12:38.29,Default,,0,0,0,,Барлығыңызды кешіріңіз... Мен...
Dialogue: 0,0:12:38.59,0:12:40.34,Default,,0,0,0,,Біз әлі жеңілген жоқпыз.
Dialogue: 0,0:12:40.42,0:12:41.63,Default,,0,0,0,,Жоғары қара
Dialogue: 0,0:12:41.84,0:12:45.80,Default,,0,0,0,,Бірақ... мен капитанмын.
Dialogue: 0,0:12:45.89,0:12:47.97,Default,,0,0,0,,Менің аяғым байланған
Dialogue: 0,0:12:48.05,0:12:49.22,Default,,0,0,0,,Вакия
Dialogue: 0,0:12:49.43,0:12:51.72,Default,,0,0,0,,Мен өзім туралы көп ойламаймын.
Dialogue: 0,0:12:51.97,0:12:54.02,Default,,0,0,0,,Екінші Бладер, алға шық.
Dialogue: 0,0:12:54.10,0:12:55.06,Default,,0,0,0,,Вай кетеді
Dialogue: 0,0:12:58.69,0:13:00.32,Default,,0,0,0,,Жарайсың ба, Шу?
Dialogue: 0,0:13:00.40,0:13:01.32,Default,,0,0,0,,О
Dialogue: 0,0:13:01.44,0:13:03.07,Default,,0,0,0,,Аняру…
Dialogue: 0,0:13:03.15,0:13:06.16,Default,,0,0,0,,Уакия осылай айта алады.
Dialogue: 0,0:13:06.24,0:13:07.45,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:13:08.53,0:13:10.33,Default,,0,0,0,,Барлығын кешіріңіз
Dialogue: 0,0:13:10.58,0:13:11.91,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:13:12.33,0:13:13.45,Default,,0,0,0,,Бар-нии
Dialogue: 0,0:13:13.54,0:13:15.41,Default,,0,0,0,,Мен қатты күйзелдім.
Dialogue: 0,0:13:15.92,0:13:18.29,Default,,0,0,0,,Ойын әлі алда.
Dialogue: 0,0:13:20.75,0:13:22.25,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:13:23.13,0:13:25.09,Default,,0,0,0,,Йонекома Гакуэн шығанағы клубы
Dialogue: 0,0:13:25.17,0:13:26.72,Default,,0,0,0,,Комурасаки Вакия
Dialogue: 0,0:13:26.97,0:13:28.18,Default,,0,0,0,,Ice Blaze - бұл
Dialogue: 0,0:13:28.26,0:13:29.68,Default,,0,0,0,,Киен Юкино
Dialogue: 0,0:13:29.76,0:13:31.97,Default,,0,0,0,,Екеуі де қорғаныс түрі.
Dialogue: 0,0:13:32.06,0:13:34.02,Default,,0,0,0,,Бұл қандай шайқас болады?
Dialogue: 0,0:13:34.73,0:13:38.94,Default,,0,0,0,,Балто, мен сенің шығыныңды қайтарамын.
Dialogue: 0,0:13:39.19,0:13:42.19,Default,,0,0,0,,Мен Куон жасаған серпіннен таусылмаймын.
Dialogue: 0,0:13:42.27,0:13:43.44,Default,,0,0,0,,Сізбен бітті.
Dialogue: 0,0:13:43.94,0:13:45.57,Default,,0,0,0,,Әй, бір соққы.
Dialogue: 0,0:13:45.69,0:13:47.24,Default,,0,0,0,,Бір соққымен шешті
Dialogue: 0,0:13:47.74,0:13:49.70,Default,,0,0,0,,Егер қолыңнан келсе, істе
Dialogue: 0,0:13:49.91,0:13:51.74,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:13:52.08,0:13:55.58,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:55.66,0:13:57.92,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:59.12,0:14:01.34,Default,,0,0,0,,Екеуі де атылды
Dialogue: 0,0:14:03.25,0:14:04.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:04.17,0:14:06.38,Default,,0,0,0,,Кенет жарылып кетті!
Dialogue: 0,0:14:06.63,0:14:09.47,Default,,0,0,0,,Секундтарда өлтіру Тек секундтарда өлтіру
Dialogue: 0,0:14:09.55,0:14:11.76,Default,,0,0,0,,Көзімді жыпылықтауға да үлгермедім.
Dialogue: 0,0:14:11.85,0:14:14.39,Default,,0,0,0,,Мен саған айттым ғой, соғып бер.
Dialogue: 0,0:14:14.77,0:14:16.02,Default,,0,0,0,,Бұл...
Dialogue: 0,0:14:16.73,0:14:18.23,Default,,0,0,0,,Жабайы уайверн
Dialogue: 0,0:14:18.31,0:14:20.40,Default,,0,0,0,,2 ұпай
Dialogue: 0,0:14:20.98,0:14:24.57,Default,,0,0,0,,Йонекома Гакуэн Бэй клубы тең нәтижеге жетті
Dialogue: 0,0:14:24.90,0:14:25.94,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:14:26.03,0:14:27.24,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:14:27.32,0:14:28.99,Default,,0,0,0,,Комурасаки күткендей
Dialogue: 0,0:14:29.45,0:14:31.41,Default,,0,0,0,,Уакия~
Dialogue: 0,0:14:32.41,0:14:34.45,Default,,0,0,0,,Иә! Мен жеңдім~
Dialogue: 0,0:14:34.54,0:14:37.41,Default,,0,0,0,,Рахмет, рахмет, Вакия~!
Dialogue: 0,0:14:37.50,0:14:38.79,Default,,0,0,0,,Не, сен?
Dialogue: 0,0:14:38.91,0:14:42.46,Default,,0,0,0,,Жабу... Лас... бет Уакия күткендей
Dialogue: 0,0:14:42.63,0:14:44.30,Default,,0,0,0,,Маған жақындама!
Dialogue: 0,0:14:44.96,0:14:46.21,Default,,0,0,0,,Шамадан тыс қуаныш
Dialogue: 0,0:14:46.30,0:14:48.22,Default,,0,0,0,,Біз әлі жеңген жоқпыз.
Dialogue: 0,0:14:48.30,0:14:49.51,Default,,0,0,0,,Бұл болды
Dialogue: 0,0:14:50.51,0:14:52.30,Default,,0,0,0,,Үшінші қуық Алдыңғы
Dialogue: 0,0:14:52.39,0:14:55.31,Default,,0,0,0,,Шу Бар күшіңмен жүр!
Dialogue: 0,0:14:55.85,0:14:57.06,Default,,0,0,0,,Шешіңіз!
Dialogue: 0,0:14:57.14,0:14:58.18,Default,,0,0,0,,О
Dialogue: 0,0:14:58.77,0:15:01.06,Default,,0,0,0,,Матч осы жерден басталады.
Dialogue: 0,0:15:01.15,0:15:03.31,Default,,0,0,0,,Мен сендерге сенемін.
Dialogue: 0,0:15:03.56,0:15:04.57,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:15:04.65,0:15:06.11,Default,,0,0,0,,Мұз жағу!
Dialogue: 0,0:15:06.19,0:15:06.98,Default,,0,0,0,,Оу!
Dialogue: 0,0:15:07.32,0:15:09.95,Default,,0,0,0,,Куон капитанға ұқсайды.
Dialogue: 0,0:15:10.03,0:15:13.12,Default,,0,0,0,,Балт Сіз де капитансыз, солай емес пе?
Dialogue: 0,0:15:13.20,0:15:14.78,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:15:14.87,0:15:17.33,Default,,0,0,0,,Мәңгілік көңіл күйде қалма
Dialogue: 0,0:15:17.41,0:15:18.45,Default,,0,0,0,,О
Dialogue: 0,0:15:19.12,0:15:20.16,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:15:20.25,0:15:22.42,Default,,0,0,0,,Біз сізді бар күшімізбен қолдаймыз!
Dialogue: 0,0:15:22.50,0:15:23.96,Default,,0,0,0,,Шу
Dialogue: 0,0:15:24.08,0:15:27.00,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз!
Dialogue: 0,0:15:27.09,0:15:28.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:28.76,0:15:30.01,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:15:30.47,0:15:33.64,Default,,0,0,0,,Бірінші матч үшінші шайқасқа әкелді.
Dialogue: 0,0:15:33.76,0:15:36.22,Default,,0,0,0,,Келесі нүкте матчты шешеді.
Dialogue: 0,0:15:36.51,0:15:39.73,Default,,0,0,0,,Сізбен күресу үлкен мәртебе.
Dialogue: 0,0:15:39.81,0:15:41.44,Default,,0,0,0,,Бірақ кім жеңеді...
Dialogue: 0,0:15:41.73,0:15:44.44,Default,,0,0,0,,Мұқият және батыл...
Dialogue: 0,0:15:44.90,0:15:46.07,Default,,0,0,0,,Мұнда шабуыл жасаңыз
Dialogue: 0,0:15:46.40,0:15:48.28,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:15:49.61,0:15:53.24,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:53.32,0:15:55.62,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:56.87,0:15:59.20,Default,,0,0,0,,Екеуі де атылды
Dialogue: 0,0:15:59.70,0:16:02.96,Default,,0,0,0,,Спригган дауылы Жылдам шабуыл жасайды
Dialogue: 0,0:16:03.54,0:16:06.09,Default,,0,0,0,,Жоғарғы түсірілім!
Dialogue: 0,0:16:06.17,0:16:08.17,Default,,0,0,0,,Шешілді!
Dialogue: 0,0:16:08.25,0:16:11.72,Default,,0,0,0,,Бұл қорғанысқа уақыт бермейтін өте жылдам шабуыл!
Dialogue: 0,0:16:11.84,0:16:14.55,Default,,0,0,0,,Спригганның дауылы
Dialogue: 0,0:16:14.89,0:16:17.85,Default,,0,0,0,,Йонекома Гакуэн Бей клубы 3-2 есебімен жеңіске жетті
Dialogue: 0,0:16:17.93,0:16:19.18,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:16:19.52,0:16:23.44,Default,,0,0,0,,Йонекома Гакуэн Бей клубы екінші айналымға өтеді
Dialogue: 0,0:16:23.85,0:16:25.15,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:25.23,0:16:26.31,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:16:26.40,0:16:28.52,Default,,0,0,0,,Біз жеңдік! Біз жеңдік!
Dialogue: 0,0:16:29.48,0:16:30.86,Default,,0,0,0,,Керемет, Йонекома академиясы!
Dialogue: 0,0:16:30.94,0:16:32.07,Default,,0,0,0,,Бұл тамаша!
Dialogue: 0,0:16:32.57,0:16:34.20,Default,,0,0,0,,Сіз мұны істедіңіз!
Dialogue: 0,0:16:38.33,0:16:42.29,Default,,0,0,0,,Жеке ұрыстарда мен сендерді міндетті түрде жеңемін.
Dialogue: 0,0:16:43.66,0:16:45.58,Default,,0,0,0,,Капитан, кешіріңіз.
Dialogue: 0,0:16:45.67,0:16:47.46,Default,,0,0,0,,Біз үшін...
Dialogue: 0,0:16:47.92,0:16:49.09,Default,,0,0,0,,Жылама
Dialogue: 0,0:16:49.17,0:16:50.92,Default,,0,0,0,,Бар күшімді салып, жеңілдім.
Dialogue: 0,0:16:51.34,0:16:54.47,Default,,0,0,0,,Енді келесі турнирге дайындықты бастау керек.
Dialogue: 0,0:16:56.76,0:16:59.93,Default,,0,0,0,,Мұз жағу! (Барлығы) Fi Fi Fi
Dialogue: 0,0:17:00.01,0:17:03.93,Default,,0,0,0,,Йонекома Гакуэн Бэй клубы (барлығы) Phi Phi Phi
Dialogue: 0,0:17:04.14,0:17:05.35,Default,,0,0,0,,Ой
Dialogue: 0,0:17:05.44,0:17:07.90,Default,,0,0,0,,Қарсылас командаға қарсы мұзды жағу
Dialogue: 0,0:17:07.98,0:17:09.48,Default,,0,0,0,,Электрондық хат жіберілді
Dialogue: 0,0:17:09.56,0:17:11.98,Default,,0,0,0,,Бұл тамаша көрініс.
Dialogue: 0,0:17:12.07,0:17:14.15,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:17:17.20,0:17:20.28,Default,,0,0,0,,Екінші тур, біз үшін де бар күшіңізді салыңыз.
Dialogue: 0,0:17:20.66,0:17:22.54,Default,,0,0,0,,А, мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:17:22.87,0:17:26.75,Default,,0,0,0,,Менің капитаным тек еңбектенуге шебер.
Dialogue: 0,0:17:27.00,0:17:28.13,Default,,0,0,0,,Вакия!
Dialogue: 0,0:17:28.50,0:17:30.75,Default,,0,0,0,,Уай мен Шу жеңді.
Dialogue: 0,0:17:30.84,0:17:31.88,Default,,0,0,0,,Біз жасаймыз ба?
Dialogue: 0,0:17:31.96,0:17:33.38,Default,,0,0,0,,Не?!
Dialogue: 0,0:17:33.46,0:17:34.84,Default,,0,0,0,,Біз топ болып жеңіске жеттік.
Dialogue: 0,0:17:35.26,0:17:39.30,Default,,0,0,0,,Дұрыс, ештеңе істемейтіндер бар.
Dialogue: 0,0:17:39.39,0:17:40.47,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:17:40.85,0:17:43.06,Default,,0,0,0,,Мен мұндай командадан жеңілемін деп ешқашан ойламадым.
Dialogue: 0,0:17:43.47,0:17:44.35,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:44.43,0:17:46.39,Default,,0,0,0,,Нөлдік топтық жұмыс
Dialogue: 0,0:17:46.52,0:17:48.56,Default,,0,0,0,,Капитан ештеңе істеп жатқан жоқ.
Dialogue: 0,0:17:49.86,0:17:52.11,Default,,0,0,0,,Сондықтан мен одан бетер түңіліп кеттім.
Dialogue: 0,0:17:52.94,0:17:55.94,Default,,0,0,0,,Шу Вакия Жеке кездесуде кездескенше
Dialogue: 0,0:17:59.87,0:18:01.62,Default,,0,0,0,,Ештеңе жасамау
Dialogue: 0,0:18:02.24,0:18:03.91,Default,,0,0,0,,Мисс Блюбелл, мисс Иберис
Dialogue: 0,0:18:04.75,0:18:06.00,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:18:06.37,0:18:08.29,Default,,0,0,0,,Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:18:08.37,0:18:09.96,Default,,0,0,0,,Цунцун-чан
Dialogue: 0,0:18:10.17,0:18:11.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:11.79,0:18:13.34,Default,,0,0,0,,Команда жеңіске жеткенімен
Dialogue: 0,0:18:13.46,0:18:15.38,Default,,0,0,0,,Бұл мен жеңілгендіктен.
Dialogue: 0,0:18:15.46,0:18:16.97,Default,,0,0,0,,Кербес
Dialogue: 0,0:18:19.59,0:18:20.47,Default,,0,0,0,,Инсуке!
Dialogue: 0,0:18:20.55,0:18:22.01,Default,,0,0,0,,Инсуке
Dialogue: 0,0:18:22.55,0:18:25.27,Default,,0,0,0,,Келдің бе? (Рантаро) Біраз уақыт өтті.
Dialogue: 0,0:18:25.77,0:18:29.35,Default,,0,0,0,,Мен сізді ұлттық конгреске міндетті түрде келеді деп ойладым.
Dialogue: 0,0:18:29.48,0:18:31.02,Default,,0,0,0,,Мен сені сағындым
Dialogue: 0,0:18:31.11,0:18:32.27,Default,,0,0,0,,Қалайсың?
Dialogue: 0,0:18:32.48,0:18:33.65,Default,,0,0,0,,Әрине.
Dialogue: 0,0:18:33.73,0:18:35.90,Default,,0,0,0,,Мен әрқашан жақсымын, Ван Ван
Dialogue: 0,0:18:35.98,0:18:39.03,Default,,0,0,0,,Сіз бізді қолдауға келдіңіз. Рақмет сізге.
Dialogue: 0,0:18:39.11,0:18:40.16,Default,,0,0,0,,Oh?
Dialogue: 0,0:18:41.07,0:18:42.62,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:42.70,0:18:43.74,Default,,0,0,0,,Э?
Dialogue: 0,0:18:44.24,0:18:45.29,Default,,0,0,0,,Сәлеметсіз бе
Dialogue: 0,0:18:45.41,0:18:47.41,Default,,0,0,0,,Жануарлар командасының капитаны
Dialogue: 0,0:18:47.50,0:18:48.71,Default,,0,0,0,,Қызыл бұршақ бен
Dialogue: 0,0:18:49.00,0:18:49.87,Default,,0,0,0,,О
Dialogue: 0,0:18:50.17,0:18:52.25,Default,,0,0,0,,Келесі матч аңдар болады ма?
Dialogue: 0,0:18:52.46,0:18:55.13,Default,,0,0,0,,Мен де сонда боламын, сондықтан бәрі мені қолдасын.
Dialogue: 0,0:18:55.21,0:18:56.13,Default,,0,0,0,,Эх!
Dialogue: 0,0:18:56.21,0:18:59.72,Default,,0,0,0,,Сондықтан мен де «Құрбылар тобының» пышақшысымын.
Dialogue: 0,0:18:59.80,0:19:02.05,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:19:02.39,0:19:05.85,Default,,0,0,0,,Мен Аңдар бар мектепке ауыстым.
Dialogue: 0,0:19:06.22,0:19:09.23,Default,,0,0,0,,Бұл Бен команданы шақырды.
Dialogue: 0,0:19:09.48,0:19:10.48,Default,,0,0,0,,О
Dialogue: 0,0:19:10.56,0:19:12.94,Default,,0,0,0,,Кейін кездескенше.
Dialogue: 0,0:19:13.81,0:19:15.57,Default,,0,0,0,,Мен сенің жеңетініңе сенімдімін.
Dialogue: 0,0:19:15.98,0:19:17.53,Default,,0,0,0,,Инсуке...
Dialogue: 0,0:19:17.61,0:19:18.78,Default,,0,0,0,,Аңдар
Dialogue: 0,0:19:18.86,0:19:20.03,Default,,0,0,0,,Ә… Мен келдім бе…
Dialogue: 0,0:19:20.53,0:19:25.16,Default,,0,0,0,,Айтпақшы, Бен айтқанның бәрі «Ах» болды.
Dialogue: 0,0:19:25.37,0:19:26.45,Default,,0,0,0,,Әрине
Dialogue: 0,0:19:29.33,0:19:30.83,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:19:31.29,0:19:32.67,Default,,0,0,0,,Жеңіс, Инуске
Dialogue: 0,0:19:32.75,0:19:35.46,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз (Рантаро) және оны жойыңыз!
Dialogue: 0,0:19:35.75,0:19:38.76,Default,,0,0,0,,Балто Кумичо Дина
Dialogue: 0,0:19:39.51,0:19:42.38,Default,,0,0,0,,Мен саған қалай өскенімді көрсетемін
Dialogue: 0,0:19:42.47,0:19:44.22,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:19:44.76,0:19:47.93,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:19:48.35,0:19:50.60,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:19:50.77,0:19:54.81,Default,,0,0,0,,Жануарлар командасының екінші пышақшысы Инусуке Мидорикава
Dialogue: 0,0:19:54.90,0:19:56.11,Default,,0,0,0,,Күшті соққы
Dialogue: 0,0:19:56.19,0:19:58.40,Default,,0,0,0,,Сіз орталыққа тез жеттіңіз.
Dialogue: 0,0:19:58.48,0:19:59.99,Default,,0,0,0,,Мен түсіндім!
Dialogue: 0,0:20:01.40,0:20:03.86,Default,,0,0,0,,Бірінші байланыс
Dialogue: 0,0:20:04.49,0:20:06.83,Default,,0,0,0,,Cerbeus есептегіші шешім қабылдады
Dialogue: 0,0:20:06.91,0:20:08.08,Default,,0,0,0,,Жарылыс!
Dialogue: 0,0:20:08.16,0:20:09.16,Default,,0,0,0,,Жарайды
Dialogue: 0,0:20:09.24,0:20:11.58,Default,,0,0,0,,(айқай)
Dialogue: 0,0:20:11.91,0:20:14.79,Default,,0,0,0,,Аңдар 3-0 есебімен жеңді
Dialogue: 0,0:20:15.25,0:20:18.84,Default,,0,0,0,,Beasts командасы екінші айналымға өтеді
Dialogue: 0,0:20:18.92,0:20:21.47,Default,,0,0,0,,Инусуке Мидорикавамен кездесуді шешті
Dialogue: 0,0:20:21.76,0:20:22.59,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:20:22.67,0:20:24.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:24.13,0:20:27.10,Default,,0,0,0,,Инсуке, сен бұл командамен жақсы жарасыпсың.
Dialogue: 0,0:20:27.18,0:20:28.18,Default,,0,0,0,,О
Dialogue: 0,0:20:28.26,0:20:30.27,Default,,0,0,0,,Аңдар қатал.
Dialogue: 0,0:20:30.81,0:20:33.27,Default,,0,0,0,,Мен де капитанның шайқасын көргім келді.
Dialogue: 0,0:20:33.64,0:20:37.15,Default,,0,0,0,,Келесі көріністі Кайза жанып тұрған храм басқарады.
Dialogue: 0,0:20:37.27,0:20:38.77,Default,,0,0,0,,Қылыш оттары!
Dialogue: 0,0:20:38.86,0:20:42.78,Default,,0,0,0,,Қызу тартысты көретініміз күмәнсіз.
Dialogue: 0,0:20:42.86,0:20:44.74,Default,,0,0,0,,Күшті команда
Dialogue: 0,0:20:45.11,0:20:47.32,Default,,0,0,0,,Сәттілік Шақа!
Dialogue: 0,0:20:47.74,0:20:49.20,Default,,0,0,0,,Сәлем Балто
Dialogue: 0,0:20:49.28,0:20:51.75,Default,,0,0,0,,Сіз барлық командаларға қолдау көрсетуді жоспарлап отырсыз ба?
Dialogue: 0,0:20:51.83,0:20:52.83,Default,,0,0,0,,Әрине
Dialogue: 0,0:20:52.96,0:20:55.62,Default,,0,0,0,,Егер бұл матчта Қылыш Жалын жеңсе
Dialogue: 0,0:20:55.71,0:20:57.83,Default,,0,0,0,,Келесі біз боламыз.
Dialogue: 0,0:20:58.17,0:20:58.96,Default,,0,0,0,,Эх!
Dialogue: 0,0:20:59.46,0:21:01.76,Default,,0,0,0,,Бір әсер!
Dialogue: 0,0:21:01.84,0:21:03.05,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:21:04.09,0:21:06.97,Default,,0,0,0,,Күшті, тым күшті Excalibur
Dialogue: 0,0:21:07.14,0:21:08.85,Default,,0,0,0,,Бұл екінші өлтіруден артық, бұл бірден өлтіру.
Dialogue: 0,0:21:08.93,0:21:12.02,Default,,0,0,0,,Қылыш жалындары екінші айналымға өтуге шешім қабылдады.
Dialogue: 0,0:21:12.43,0:21:13.98,Default,,0,0,0,,Қылыш оттары
Dialogue: 0,0:21:14.06,0:21:16.85,Default,,0,0,0,,Біз бір-бірімізді жақыннан танимыз.
Dialogue: 0,0:21:17.35,0:21:18.90,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:21:19.11,0:21:21.48,Default,,0,0,0,,Ол виверлерді білмейді.
Dialogue: 0,0:21:21.90,0:21:26.07,Default,,0,0,0,,Содан кейін Вай пайда болғанда, Вай Шаканы жеңеді.
Dialogue: 0,0:21:26.15,0:21:28.62,Default,,0,0,0,,Сіз капитан емессіз, солай ма?
Dialogue: 0,0:21:28.74,0:21:29.95,Default,,0,0,0,,Өз еркімен шешім қабылдамаңыз
Dialogue: 0,0:21:30.03,0:21:33.83,Default,,0,0,0,,Егер сіз біреумен аралассаңыз, сіз ұпай аласыз.
Dialogue: 0,0:21:33.91,0:21:35.04,Default,,0,0,0,,Әрине.
Dialogue: 0,0:21:35.12,0:21:36.25,Default,,0,0,0,,Бұл алғашқы «Глория».
Dialogue: 0,0:21:36.33,0:21:37.12,Default,,0,0,0,,Не!
Dialogue: 0,0:21:37.21,0:21:38.92,Default,,0,0,0,,Екеуің доғарыңдар.
Dialogue: 0,0:21:39.00,0:21:41.25,Default,,0,0,0,,Қазір бөлінетін уақыт емес.
Dialogue: 0,0:21:41.34,0:21:45.17,Default,,0,0,0,,Ей, мен бұл жігітті ешқашан дос деп ойламаппын.
Dialogue: 0,0:21:45.26,0:21:46.59,Default,,0,0,0,,Не!
Dialogue: 0,0:21:46.68,0:21:47.72,Default,,0,0,0,,Барт…
Dialogue: 0,0:21:48.30,0:21:50.97,Default,,0,0,0,,Мен капитан болсам да, мен...
Dialogue: 0,0:21:51.97,0:21:53.31,Default,,0,0,0,,Жарық жасыл, Ято-сан.
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Артынан қусаң да көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.32,0:23:28.19,Default,,0,0,0,,Зактың супер жұлдыздарына
Dialogue: 0,0:23:28.28,0:23:29.69,Default,,0,0,0,,Орочи болды!
Dialogue: 0,0:23:29.78,0:23:32.61,Default,,0,0,0,,Зак керемет өнер көрсетеді
Dialogue: 0,0:23:32.70,0:23:34.28,Default,,0,0,0,,Бірақ бұл тым көп
Dialogue: 0,0:23:34.49,0:23:35.45,Default,,0,0,0,,Не?!
Dialogue: 0,0:23:35.53,0:23:37.49,Default,,0,0,0,,Бұл аңызға айналған шығанақ
Dialogue: 0,0:23:37.58,0:23:39.70,Default,,0,0,0,,Уау! Күресіп көріңіз!
Dialogue: 0,0:23:39.79,0:23:41.83,Default,,0,0,0,,Инуске де солай ойлайды, солай ма?
Dialogue: 0,0:23:41.92,0:23:43.96,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:44.04,0:23:45.92,Default,,0,0,0,,Amaterios нұсқаулығы
Dialogue: 0,0:23:46.00,0:23:47.80,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.88,0:23:49.51,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.01,0:23:57.01,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory