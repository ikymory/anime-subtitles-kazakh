Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.59,0:00:09.05,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.17,0:00:12.55,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.76,0:00:14.76,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:16.97,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.18,0:00:18.81,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.48,0:00:24.23,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.31,0:00:26.27,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.35,0:00:28.94,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.11,0:00:32.82,Default,,0,0,0,,Дина кеттік!
Dialogue: 0,0:00:32.90,0:00:35.41,Default,,0,0,0,,О! (Рантаро Кияма) Дайын жиынтық
Dialogue: 0,0:00:35.95,0:00:38.16,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:00:38.58,0:00:40.08,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:00:41.91,0:00:45.12,Default,,0,0,0,,Тез ату! Бар! Валькирия!
Dialogue: 0,0:00:45.58,0:00:46.62,Default,,0,0,0,,Өлімді анықтаушы
Dialogue: 0,0:00:46.71,0:00:48.25,Default,,0,0,0,,Шайқаңыз!
Dialogue: 0,0:00:54.26,0:00:56.47,Default,,0,0,0,,Не? Не болып жатыр?
Dialogue: 0,0:00:56.55,0:01:00.22,Default,,0,0,0,,Олар шабуыл түрі болғанымен, бір-бірімен сирек соқтығысады.
Dialogue: 0,0:01:00.43,0:01:04.48,Default,,0,0,0,,Мүмкін жылдамдық айырмашылығы жолға әсер етіп жатқан шығар.
Dialogue: 0,0:01:11.57,0:01:12.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:01:12.57,0:01:14.24,Default,,0,0,0,,Валькири-ау!
Dialogue: 0,0:01:14.32,0:01:15.95,Default,,0,0,0,,Қуат да азайған жоқ.
Dialogue: 0,0:01:16.15,0:01:19.74,Default,,0,0,0,,Бұл оянғалы тұрған Валькирияның күші ме?
Dialogue: 0,0:01:19.95,0:01:22.58,Default,,0,0,0,,Асыққан асығыс!
Dialogue: 0,0:01:26.37,0:01:27.79,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:01:28.25,0:01:29.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:30.00,0:01:32.88,Default,,0,0,0,,Валькири жарылған мәремен жеңеді
Dialogue: 0,0:01:33.13,0:01:34.38,Default,,0,0,0,,Эй!
Dialogue: 0,0:01:35.30,0:01:36.67,Default,,0,0,0,,Үлкен аға жеңеді
Dialogue: 0,0:01:36.76,0:01:37.51,Default,,0,0,0,,Иә
Dialogue: 0,0:01:39.22,0:01:42.22,Default,,0,0,0,,Валькирия барған сайын өседі
Dialogue: 0,0:01:43.01,0:01:44.68,Default,,0,0,0,,Жасайық, досым!
Dialogue: 0,0:01:45.85,0:01:48.48,Default,,0,0,0,,Менің шайқауым...
Dialogue: 0,0:01:49.40,0:01:50.98,Default,,0,0,0,,Мен де күшейемін
Dialogue: 0,0:01:51.40,0:01:53.36,Default,,0,0,0,,көбірек
Dialogue: 0,0:02:01.78,0:02:04.16,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:02:04.49,0:02:09.67,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:02:20.97,0:02:24.35,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:02:24.85,0:02:26.98,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:02:27.39,0:02:31.52,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:31.65,0:02:34.86,Default,,0,0,0,,Дұрыс, сіздің жүзіңіздегі өрнек
Dialogue: 0,0:02:34.98,0:02:41.41,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:41.70,0:02:46.12,Default,,0,0,0,,АУ! Айналып келе жатқан арман
Dialogue: 0,0:02:46.62,0:02:52.04,Default,,0,0,0,,Ыстық және тербеліс ойнайық
Dialogue: 0,0:02:52.17,0:02:54.42,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:54.50,0:02:59.22,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:59.38,0:03:04.47,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:03:04.76,0:03:07.02,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:03:07.22,0:03:09.56,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:03:09.85,0:03:13.77,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:03:13.94,0:03:18.94,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:03:19.15,0:03:21.32,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:25.45,0:03:27.58,Default,,0,0,0,,Валькирия оянады!
Dialogue: 0,0:03:43.64,0:03:45.89,Default,,0,0,0,,Бұл жолы менімен, Балто.
Dialogue: 0,0:03:45.97,0:03:48.31,Default,,0,0,0,,Жақсы! Бұл тағы бір жарылыс
Dialogue: 0,0:03:48.39,0:03:49.97,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:03:50.43,0:03:51.52,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:51.60,0:03:54.19,Default,,0,0,0,,Барлығы жанып жатыр, жарай ма?
Dialogue: 0,0:03:54.27,0:03:56.11,Default,,0,0,0,,Уау
Dialogue: 0,0:03:56.19,0:03:58.86,Default,,0,0,0,,Не болды, Рюзаки?
Dialogue: 0,0:03:59.73,0:04:02.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:04.36,0:04:05.78,Default,,0,0,0,,Мұнда ешкім жоқ сияқты. (Ұшқыш А) Жоқ, бар.
Dialogue: 0,0:04:08.20,0:04:11.54,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:04:13.21,0:04:15.75,Default,,0,0,0,,Эй, шығанақ шаяндары, міне келдік.
Dialogue: 0,0:04:15.83,0:04:18.75,Default,,0,0,0,,Аудан таңдау турниріне шақыру
Dialogue: 0,0:04:19.42,0:04:20.55,Default,,0,0,0,,Міне, келді!
Dialogue: 0,0:04:20.76,0:04:22.42,Default,,0,0,0,,Шақа осылай деді.
Dialogue: 0,0:04:22.51,0:04:23.80,Default,,0,0,0,,Қарсы кездесу
Dialogue: 0,0:04:24.09,0:04:25.51,Default,,0,0,0,,Сізге жақсы.
Dialogue: 0,0:04:25.59,0:04:27.89,Default,,0,0,0,,Мектеп директорының шақыру хаты
Dialogue: 0,0:04:27.97,0:04:29.60,Default,,0,0,0,,Кімге келдің?
Dialogue: 0,0:04:30.06,0:04:33.94,Default,,0,0,0,,Енді мен сізге WBBA-дан шақыру жіберемін.
Dialogue: 0,0:04:35.19,0:04:36.77,Default,,0,0,0,,Біріншісі -
Dialogue: 0,0:04:36.94,0:04:38.06,Default,,0,0,0,,Уа!
Dialogue: 0,0:04:38.52,0:04:41.32,Default,,0,0,0,,Сенің атыңды әлі атаған жоқ, Бал-нии.
Dialogue: 0,0:04:41.53,0:04:44.70,Default,,0,0,0,,Облыстық турнирде екінші орын алғандықтан, әрине...
Dialogue: 0,0:04:44.78,0:04:46.03,Default,,0,0,0,,Куроками Дина-кун
Dialogue: 0,0:04:46.11,0:04:46.78,Default,,0,0,0,,Гаку
Dialogue: 0,0:04:46.95,0:04:47.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:47.74,0:04:48.99,Default,,0,0,0,,Дина-кун
Dialogue: 0,0:04:49.33,0:04:54.00,Default,,0,0,0,,Осы уақытқа дейін жеткен жетістіктеріңіз және үшінші турға дейінгі жетістіктеріңіз мойындалған сияқты.
Dialogue: 0,0:04:54.33,0:04:55.71,Default,,0,0,0,,Жарайсың Дина
Dialogue: 0,0:04:55.79,0:04:56.96,Default,,0,0,0,,Жоқ, тек кедергі келтіресің.
Dialogue: 0,0:04:57.04,0:04:59.04,Default,,0,0,0,,Тек қатысудың мағынасы жоқ.
Dialogue: 0,0:04:59.13,0:05:00.00,Default,,0,0,0,,Мен жеңуім керек
Dialogue: 0,0:05:00.25,0:05:01.75,Default,,0,0,0,,Басқалар мүмкіндігінше тезірек
Dialogue: 0,0:05:01.84,0:05:03.05,Default,,0,0,0,,Вакаттуру
Dialogue: 0,0:05:03.51,0:05:04.97,Default,,0,0,0,,Хоудзи Конта
Dialogue: 0,0:05:05.05,0:05:06.84,Default,,0,0,0,,Комурасаки Вакия-кун
Dialogue: 0,0:05:06.93,0:05:07.55,Default,,0,0,0,,Зуго!
Dialogue: 0,0:05:08.05,0:05:10.72,Default,,0,0,0,,Әлгі екеуі жерде жүгіріп келе жатыр.
Dialogue: 0,0:05:13.06,0:05:14.73,Default,,0,0,0,,Сіз шаршадыңыз ба?\NЕгер
Dialogue: 0,0:05:14.81,0:05:16.10,Default,,0,0,0,,Сіз елді дүр сілкіндіре білген ардагер орындаушы ретінде әйгілісіз, иә?
Dialogue: 0,0:05:16.19,0:05:17.94,Default,,0,0,0,,болса, оны одан да жоғары көтеріңіз~
Dialogue: 0,0:05:18.02,0:05:18.90,Default,,0,0,0,,Иә
Dialogue: 0,0:05:19.61,0:05:21.15,Default,,0,0,0,,Е...! Хмм!
Dialogue: 0,0:05:21.69,0:05:23.94,Default,,0,0,0,,Жарайды, кейінге қалдырамын.
Dialogue: 0,0:05:24.36,0:05:25.15,Default,,0,0,0,,Соңында-
Dialogue: 0,0:05:25.49,0:05:27.66,Default,,0,0,0,,Не? Бір бөлік қалды ма?
Dialogue: 0,0:05:27.74,0:05:29.12,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:05:30.03,0:05:32.37,Default,,0,0,0,,Аои Балт-кун, бұл сенсің.
Dialogue: 0,0:05:32.83,0:05:33.91,Default,,0,0,0,,«Түстен кейінге дейін тікелей эфир»
Dialogue: 0,0:05:34.00,0:05:35.16,Default,,0,0,0,,Бұл Бал-нии.
Dialogue: 0,0:05:36.96,0:05:38.29,Default,,0,0,0,,Бұл шынымен де сізде бар ма?
Dialogue: 0,0:05:40.08,0:05:44.05,Default,,0,0,0,,Бірінші раундта Балттан жеңіліп қалдым, сондықтан оған көмектесу мүмкін емес.
Dialogue: 0,0:05:44.17,0:05:45.92,Default,,0,0,0,,Хахахаха! ... күрсін
Dialogue: 0,0:05:48.01,0:05:49.34,Default,,0,0,0,,Салқын
Dialogue: 0,0:05:49.43,0:05:50.64,Default,,0,0,0,,Кумичо
Dialogue: 0,0:05:51.93,0:05:53.47,Default,,0,0,0,,О? Ах...
Dialogue: 0,0:05:54.35,0:05:55.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:55.10,0:05:56.56,Default,,0,0,0,,Не болды? Бар аға
Dialogue: 0,0:05:58.23,0:05:59.10,Default,,0,0,0,,Қазір...
Dialogue: 0,0:05:59.19,0:06:00.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:00.10,0:06:02.02,Default,,0,0,0,,Бұл дәл осы ашықхат болатын.
Dialogue: 0,0:06:02.48,0:06:05.49,Default,,0,0,0,,Бұл Кумичоға шақыру болған шығар.
Dialogue: 0,0:06:05.74,0:06:09.36,Default,,0,0,0,,Жарайды, балалар, мені жұбатпадыңдар.
Dialogue: 0,0:06:09.45,0:06:10.87,Default,,0,0,0,,Жоқ, шынымен.
Dialogue: 0,0:06:11.16,0:06:13.79,Default,,0,0,0,,Сондықтан мені жұбатудың қажеті жоқ!
Dialogue: 0,0:06:14.16,0:06:16.00,Default,,0,0,0,,Ашуланба
Dialogue: 0,0:06:16.33,0:06:17.62,Default,,0,0,0,,Ашуланба
Dialogue: 0,0:06:18.16,0:06:19.00,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:21.75,0:06:23.29,Default,,0,0,0,,Кумичо
Dialogue: 0,0:06:23.42,0:06:25.09,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:06:25.55,0:06:27.22,Default,,0,0,0,,Міне, болды, болды
Dialogue: 0,0:06:30.51,0:06:31.93,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,0:06:32.60,0:06:33.39,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:06:34.93,0:06:36.64,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:37.81,0:06:39.31,Default,,0,0,0,,Жоқ! Даа!
Dialogue: 0,0:06:39.73,0:06:40.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:41.56,0:06:43.94,Default,,0,0,0,,Atta...
Dialogue: 0,0:06:46.98,0:06:49.20,Default,,0,0,0,,Жоқ, олай болуы мүмкін емес.
Dialogue: 0,0:06:51.91,0:06:53.78,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:54.95,0:06:57.50,Default,,0,0,0,,Маған да келеді деп ойламадым.
Dialogue: 0,0:06:57.79,0:07:01.46,Default,,0,0,0,,Мен сенің қабілетіңді танимын, сондықтан келуің заңды.
Dialogue: 0,0:07:02.08,0:07:03.58,Default,,0,0,0,,Жалпы елге бағытталған
Dialogue: 0,0:07:03.71,0:07:04.75,Default,,0,0,0,,Сізге...
Dialogue: 0,0:07:04.84,0:07:08.34,Default,,0,0,0,,Қайталама матч тығырықтан басқа ештеңе емес.
Dialogue: 0,0:07:08.63,0:07:12.93,Default,,0,0,0,,Бірақ Шуды жеңу үшін мен бұл турнирді міндетті түрде жеңемін.
Dialogue: 0,0:07:13.47,0:07:14.43,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:07:20.39,0:07:21.69,Default,,0,0,0,,Шобон
Dialogue: 0,0:07:24.06,0:07:26.19,Default,,0,0,0,,Кумичо көңілсіз.
Dialogue: 0,0:07:26.27,0:07:27.94,Default,,0,0,0,,Мұны түсіну оңай.
Dialogue: 0,0:07:28.36,0:07:29.86,Default,,0,0,0,,Сәлем Инуске
Dialogue: 0,0:07:29.94,0:07:32.91,Default,,0,0,0,,Сіздің қуыршақ театрыңыз мені таз қылды...
Dialogue: 0,0:07:36.78,0:07:38.37,Default,,0,0,0,,Сіз мұны істей аласыз ба...
Dialogue: 0,0:07:39.41,0:07:41.96,Default,,0,0,0,,Сізге жақсы, Балто.
Dialogue: 0,0:07:42.08,0:07:43.00,Default,,0,0,0,,Иә
Dialogue: 0,0:07:43.79,0:07:46.21,Default,,0,0,0,,Қайталама матчқа қатысуыңызбен құттықтаймыз
Dialogue: 0,0:07:46.29,0:07:47.59,Default,,0,0,0,,Валькирия табасы
Dialogue: 0,0:07:47.67,0:07:49.26,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:07:51.55,0:07:54.05,Default,,0,0,0,,Ммммммм!
Dialogue: 0,0:07:54.39,0:07:56.55,Default,,0,0,0,,Дина-кун да шығады деп естідім.
Dialogue: 0,0:07:56.76,0:07:59.18,Default,,0,0,0,,Топ мүшелерінің бірге болғаны жақсы.
Dialogue: 0,0:08:01.27,0:08:02.27,Default,,0,0,0,,Иә
Dialogue: 0,0:08:04.23,0:08:06.15,Default,,0,0,0,,Не? Балтық?
Dialogue: 0,0:08:06.48,0:08:07.77,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:08:07.86,0:08:08.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:09.94,0:08:12.65,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:08:12.82,0:08:13.91,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:14.45,0:08:17.03,Default,,0,0,0,,Кумичо шақыру алған жоқ.
Dialogue: 0,0:08:17.12,0:08:18.28,Default,,0,0,0,,Маған қамқорлық.
Dialogue: 0,0:08:18.95,0:08:20.04,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:08:20.54,0:08:22.21,Default,,0,0,0,,Сен өте мейірімдісің, Барт.
Dialogue: 0,0:08:22.71,0:08:24.92,Default,,0,0,0,,Анашым, мен қатты толқып тұрмын
Dialogue: 0,0:08:25.00,0:08:27.34,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:08:28.46,0:08:30.46,Default,,0,0,0,,Мен біраз уақытқа барамын.
Dialogue: 0,0:08:36.30,0:08:37.80,Default,,0,0,0,,Сол ашықхат
Dialogue: 0,0:08:37.89,0:08:40.31,Default,,0,0,0,,Ол осы жерде ұшып кетті.
Dialogue: 0,0:08:45.60,0:08:47.19,Default,,0,0,0,,Мен оны міндетті түрде табамын
Dialogue: 0,0:08:48.06,0:08:50.61,Default,,0,0,0,,Сен мұнда не істеп жүрсің?
Dialogue: 0,0:08:54.07,0:08:56.41,Default,,0,0,0,,Директор, сіз не істеп жатырсыз?
Dialogue: 0,0:08:56.82,0:08:59.20,Default,,0,0,0,,Мен соны аламын деп ойладым.
Dialogue: 0,0:09:02.87,0:09:04.16,Default,,0,0,0,,Міне болды!
Dialogue: 0,0:09:11.42,0:09:13.88,Default,,0,0,0,,Міне! Рұқсатсыз жоғары көтерілмеңіз
Dialogue: 0,0:09:13.97,0:09:15.47,Default,,0,0,0,,Мен оны естімеймін.
Dialogue: 0,0:09:21.35,0:09:23.52,Default,,0,0,0,,Қашпа~
Dialogue: 0,0:09:24.98,0:09:26.56,Default,,0,0,0,,Бұл шақыру.
Dialogue: 0,0:09:26.77,0:09:28.35,Default,,0,0,0,,Өйткені, бұл Кумичоға.
Dialogue: 0,0:09:28.44,0:09:29.81,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:30.77,0:09:31.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:32.23,0:09:33.03,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:09:33.11,0:09:34.61,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:34.78,0:09:35.53,Default,,0,0,0,,О...
Dialogue: 0,0:09:36.78,0:09:37.91,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:09:40.91,0:09:43.24,Default,,0,0,0,,Мен жасадым, мен жасадым, Кумичо!
Dialogue: 0,0:09:43.45,0:09:45.00,Default,,0,0,0,,Кумичо!
Dialogue: 0,0:09:45.33,0:09:46.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:46.54,0:09:48.50,Default,,0,0,0,,Әлсіреп қалма — жолды бөгеп тұрсың.
Dialogue: 0,0:09:49.46,0:09:51.63,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:09:55.97,0:09:57.30,Default,,0,0,0,,Мен...
Dialogue: 0,0:09:57.51,0:09:59.47,Default,,0,0,0,,Рагнарук не істеуім керек?
Dialogue: 0,0:10:00.64,0:10:02.51,Default,,0,0,0,,Егер сіз матчқа қатыса алмасаңыз
Dialogue: 0,0:10:03.06,0:10:05.52,Default,,0,0,0,,Балто мен Динаның әріптесі ретінде
Dialogue: 0,0:10:05.93,0:10:08.02,Default,,0,0,0,,Қолымнан келгенін істеймін
Dialogue: 0,0:10:08.89,0:10:10.40,Default,,0,0,0,,Кумичо
Dialogue: 0,0:10:10.48,0:10:12.40,Default,,0,0,0,,Кумичо
Dialogue: 0,0:10:12.48,0:10:14.32,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:10:14.40,0:10:15.86,Default,,0,0,0,,Мен жындымын
Dialogue: 0,0:10:15.94,0:10:19.36,Default,,0,0,0,,Сіз және Динаның жаттығудағы серіктесі ретінде мен бар күшімді саламын.
Dialogue: 0,0:10:19.45,0:10:22.62,Default,,0,0,0,,Сондықтан да елдің түкпір-түкпіріне міндетті түрде бару керек.
Dialogue: 0,0:10:23.91,0:10:26.37,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:10:26.87,0:10:28.66,Default,,0,0,0,,Эй, жақсысың ба?
Dialogue: 0,0:10:28.83,0:10:31.17,Default,,0,0,0,,Кумичомен де барайық.
Dialogue: 0,0:10:31.25,0:10:32.71,Default,,0,0,0,,А? Қайда?
Dialogue: 0,0:10:33.13,0:10:35.42,Default,,0,0,0,,Ол Кумичоға да келді.
Dialogue: 0,0:10:35.63,0:10:36.63,Default,,0,0,0,,Не?
Dialogue: 0,0:10:36.71,0:10:37.72,Default,,0,0,0,,Шақыру
Dialogue: 0,0:10:37.80,0:10:38.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:44.51,0:10:47.85,Default,,0,0,0,,Менің мүмкіндігіммен келуім табиғи нәрсе.
Dialogue: 0,0:10:47.93,0:10:49.85,Default,,0,0,0,,Жылайын деп тұрсам да
Dialogue: 0,0:10:49.94,0:10:51.73,Default,,0,0,0,,Букьяро Сіз жылап жатырсыз ба?
Dialogue: 0,0:10:51.81,0:10:53.27,Default,,0,0,0,,Сен жылап тұрдың.
Dialogue: 0,0:10:53.36,0:10:54.77,Default,,0,0,0,,Жылама
Dialogue: 0,0:10:54.86,0:10:56.40,Default,,0,0,0,,Балто, жаттығу жасайық.
Dialogue: 0,0:10:56.48,0:10:58.49,Default,,0,0,0,,Бүкіл ел бойынша жаттығу
Dialogue: 0,0:10:58.57,0:11:00.03,Default,,0,0,0,,Мен де істеймін
Dialogue: 0,0:11:00.53,0:11:01.70,Default,,0,0,0,,Дина
Dialogue: 0,0:11:03.62,0:11:04.74,Default,,0,0,0,,Жасайық!
Dialogue: 0,0:11:05.41,0:11:08.20,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:08.62,0:11:10.87,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:12.29,0:11:14.75,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар
Dialogue: 0,0:11:14.88,0:11:19.01,Default,,0,0,0,,Бейблейд аймағын таңдау турниріне қош келдіңіз! Қош келдіңіз!
Dialogue: 0,0:11:19.09,0:11:22.68,Default,,0,0,0,,Өкініштісі облыстық турнирде жеңіске жетуден құр қалған блейдерлер арасында.
Dialogue: 0,0:11:22.76,0:11:26.35,Default,,0,0,0,,Бұрынғы рейтингтерге және аудандық турнир нәтижелеріне негізделген
Dialogue: 0,0:11:26.43,0:11:30.73,Default,,0,0,0,,WBBA штаб-пәтері блейдерлерге шақыру жіберді.
Dialogue: 0,0:11:31.35,0:11:33.90,Default,,0,0,0,,Енді ойыншыны тіркеу басталды.
Dialogue: 0,0:11:35.48,0:11:37.94,Default,,0,0,0,,Тіркеу қателерін жасамаңыз
Dialogue: 0,0:11:38.03,0:11:39.36,Default,,0,0,0,,Non Non No
Dialogue: 0,0:11:42.36,0:11:45.41,Default,,0,0,0,,Сәйкестік комбинациялары ойыншыны тіркеумен бір уақытта анықталады
Dialogue: 0,0:11:45.49,0:11:48.95,Default,,0,0,0,,Компьютер кездейсоқ қарсыласты таңдайтын жүйе.
Dialogue: 0,0:11:49.04,0:11:51.00,Default,,0,0,0,,Кімді жеңетініңіз сәттілікке байланысты
Dialogue: 0,0:11:51.08,0:11:52.29,Default,,0,0,0,,Сәттілік!
Dialogue: 0,0:11:52.37,0:11:55.04,Default,,0,0,0,,4 блоктан A B C D
Dialogue: 0,0:11:55.13,0:11:56.75,Default,,0,0,0,,Тек жеңіске жеткендер
Dialogue: 0,0:11:56.84,0:12:00.09,Default,,0,0,0,,Сіз республикалық турнирге қатысу құқығына ие бола аласыз.
Dialogue: 0,0:12:00.17,0:12:02.17,Default,,0,0,0,,Енді сол төрт адам болады
Dialogue: 0,0:12:02.26,0:12:03.63,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:12:04.30,0:12:06.22,Default,,0,0,0,,Енді аудитория орындарында
Dialogue: 0,0:12:06.30,0:12:09.22,Default,,0,0,0,,Соңғы ұлттық турнирдегі төрт бұралған император да осында.
Dialogue: 0,0:12:09.31,0:12:10.72,Default,,0,0,0,,Кемеңгер Куришуу және
Dialogue: 0,0:12:10.81,0:12:13.23,Default,,0,0,0,,Жою патшасы, жанып тұрған ғибадатхананың Кайзасы!
Dialogue: 0,0:12:13.44,0:12:16.23,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:16.69,0:12:18.07,Default,,0,0,0,,Бұл керемет!
Dialogue: 0,0:12:18.15,0:12:20.32,Default,,0,0,0,,Шу-кун мен Шақа Халық
Dialogue: 0,0:12:21.32,0:12:26.12,Default,,0,0,0,,(барабан дыбысы)
Dialogue: 0,0:12:26.32,0:12:29.70,Default,,0,0,0,,(Түтіннің түсу дыбысы)
Dialogue: 0,0:12:32.04,0:12:36.33,Default,,0,0,0,,Содан кейін Төрт императордың супержұлдызының бірі
Dialogue: 0,0:12:36.42,0:12:38.59,Default,,0,0,0,,Зак осында!
Dialogue: 0,0:12:38.67,0:12:39.59,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:39.67,0:12:45.51,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:46.22,0:12:51.47,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:12:51.64,0:12:53.60,Default,,0,0,0,,Дон! хахан
Dialogue: 0,0:12:53.68,0:12:56.48,Default,,0,0,0,,Әрқашан керемет болғаным үшін кешіріңіз, бәріңіз.
Dialogue: 0,0:12:58.77,0:13:00.15,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:00.23,0:13:02.40,Default,,0,0,0,,Эй, сен Закты танымайсың ба?
Dialogue: 0,0:13:02.49,0:13:03.61,Default,,0,0,0,,Атақты?
Dialogue: 0,0:13:03.69,0:13:07.53,Default,,0,0,0,,Ол қазіргі уақытта драмалар мен эстрада шоуларында өте танымал идол әнші.
Dialogue: 0,0:13:07.74,0:13:09.95,Default,,0,0,0,,Жасыңыз бізбен бірдей болса да.
Dialogue: 0,0:13:10.03,0:13:12.45,Default,,0,0,0,,Бейдің қабілеті де данышпан.
Dialogue: 0,0:13:12.54,0:13:14.37,Default,,0,0,0,,Ол төрт-он императордың бірі.
Dialogue: 0,0:13:15.00,0:13:16.87,Default,,0,0,0,,Ғажайып Зак
Dialogue: 0,0:13:16.96,0:13:18.67,Default,,0,0,0,,Олар Суттоны ертіп әкелді.
Dialogue: 0,0:13:18.75,0:13:20.29,Default,,0,0,0,,Ойласам, біз ұзақ уақыт сөйлеспеген сияқтымыз
Dialogue: 0,0:13:21.00,0:13:23.09,Default,,0,0,0,,Жұлдыз жарығы!
Dialogue: 0,0:13:27.68,0:13:31.51,Default,,0,0,0,,Құрметті ойыншылар, сендер сол жұлдыздар сияқтысыңдар.
Dialogue: 0,0:13:31.60,0:13:33.06,Default,,0,0,0,,Әрбір адам – жұлдыз
Dialogue: 0,0:13:33.14,0:13:35.14,Default,,0,0,0,,Жарқырап, жарқырап тұр
Dialogue: 0,0:13:35.23,0:13:37.94,Default,,0,0,0,,Әдемі Жұлдыздар әдемі
Dialogue: 0,0:13:38.15,0:13:39.10,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:13:40.27,0:13:42.86,Default,,0,0,0,,Күн шуағы!
Dialogue: 0,0:13:43.98,0:13:45.28,Default,,0,0,0,,Күн шыққанда
Dialogue: 0,0:13:45.36,0:13:47.24,Default,,0,0,0,,Жұлдыздар қандай әдемі болса да
Dialogue: 0,0:13:47.32,0:13:49.28,Default,,0,0,0,,Ол көрінбейтін болады
Dialogue: 0,0:13:49.78,0:13:51.91,Default,,0,0,0,,Кешіріңіз, жұлдыздар
Dialogue: 0,0:13:51.99,0:13:54.25,Default,,0,0,0,,Мен сенің жарқылыңды өшірдім
Dialogue: 0,0:13:54.62,0:13:56.54,Default,,0,0,0,,Ол күн менмін
Dialogue: 0,0:13:56.87,0:13:59.00,Default,,0,0,0,,Зак Күн сәулесі
Dialogue: 0,0:13:59.08,0:14:00.54,Default,,0,0,0,,Хахан
Dialogue: 0,0:14:04.88,0:14:08.38,Default,,0,0,0,,Барлығыңыз маған жақсы ойын дайындаңыздар.
Dialogue: 0,0:14:09.01,0:14:09.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:12.01,0:14:14.22,Default,,0,0,0,,Сен кереметсің, Зак.
Dialogue: 0,0:14:14.31,0:14:16.89,Default,,0,0,0,,Ол Шу мен Шақа сияқты Төрт ондық патша.
Dialogue: 0,0:14:19.06,0:14:20.31,Default,,0,0,0,,Бар-нии
Dialogue: 0,0:14:20.40,0:14:23.19,Default,,0,0,0,,Жарайды ма? Мен рұқсатсыз көтерілдім.
Dialogue: 0,0:14:23.27,0:14:25.15,Default,,0,0,0,,I Барто Аои
Dialogue: 0,0:14:25.23,0:14:26.82,Default,,0,0,0,,Сізбен күресіңіз
Dialogue: 0,0:14:27.40,0:14:30.53,Default,,0,0,0,,Мен тұрған жерге тез келіңізші.
Dialogue: 0,0:14:30.61,0:14:31.74,Default,,0,0,0,,Ха Хан
Dialogue: 0,0:14:32.37,0:14:33.49,Default,,0,0,0,,Киракира-кун
Dialogue: 0,0:14:33.70,0:14:36.75,Default,,0,0,0,,Мен сенімен бір күні күресуді асыға күтемін.
Dialogue: 0,0:14:38.83,0:14:42.08,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:14:42.17,0:14:45.80,Default,,0,0,0,,А-а, ел аралап, сенімен жекпе-жекке шығамын!
Dialogue: 0,0:14:51.30,0:14:53.35,Default,,0,0,0,,Бұл Зак Күн сәулесі
Dialogue: 0,0:14:53.43,0:14:57.85,Default,,0,0,0,,Осымен аймақты іріктеу турнирінің басталғанын жариялаймыз.
Dialogue: 0,0:15:00.06,0:15:03.27,Default,,0,0,0,,Жарайды, А блогының бірінші ойыны
Dialogue: 0,0:15:03.36,0:15:04.73,Default,,0,0,0,,Бұл екеуі!
Dialogue: 0,0:15:04.82,0:15:07.57,Default,,0,0,0,,Ғажайып бала, облыстық турнирдің жүлдегері
Dialogue: 0,0:15:07.65,0:15:09.28,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:15:09.36,0:15:10.78,Default,,0,0,0,,Не? Мен?
Dialogue: 0,0:15:10.99,0:15:14.24,Default,,0,0,0,,Жанып тұрған храм Доджоның ниндзя шебері
Dialogue: 0,0:15:14.45,0:15:16.33,Default,,0,0,0,,Бұл Укио Юкифуки.
Dialogue: 0,0:15:16.54,0:15:19.29,Default,,0,0,0,,Жарайды, егер мұны бәрібір орындайтын болсаңыз, соғұрлым тезірек жақсырақ.
Dialogue: 0,0:15:19.62,0:15:22.37,Default,,0,0,0,,Жарайды! Қанекей мынаны істейік!
Dialogue: 0,0:15:23.54,0:15:24.88,Default,,0,0,0,,Екі ойыншы да
Dialogue: 0,0:15:24.96,0:15:26.92,Default,,0,0,0,,Ұрыс сахнасына шық
Dialogue: 0,0:15:31.59,0:15:32.80,Default,,0,0,0,,Ха Хан
Dialogue: 0,0:15:32.89,0:15:35.05,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, Киракира-кун
Dialogue: 0,0:15:37.93,0:15:39.18,Default,,0,0,0,,Барто Аои
Dialogue: 0,0:15:39.31,0:15:40.94,Default,,0,0,0,,Мен оны асыға күттім.
Dialogue: 0,0:15:41.44,0:15:42.56,Default,,0,0,0,,Мен де
Dialogue: 0,0:15:43.02,0:15:45.15,Default,,0,0,0,,Сәттілік
Dialogue: 0,0:15:45.23,0:15:48.36,Default,,0,0,0,,Бірінші шайқастағы Қылыш жалынының мүшесі?
Dialogue: 0,0:15:48.86,0:15:50.95,Default,,0,0,0,,Жеңіске жетсең, бір күні жеңесің
Dialogue: 0,0:15:51.20,0:15:53.03,Default,,0,0,0,,Ол да бақыланбайды.
Dialogue: 0,0:15:53.53,0:15:55.78,Default,,0,0,0,,Энронаку Укионы талқандады
Dialogue: 0,0:15:56.28,0:15:57.03,Default,,0,0,0,,Иә
Dialogue: 0,0:15:57.87,0:16:00.37,Default,,0,0,0,,Ойын екі ұпайлық бірінші жүйе.
Dialogue: 0,0:16:00.45,0:16:03.42,Default,,0,0,0,,Аяқтау Айналдыру 1 ұпайға тең
Dialogue: 0,0:16:03.50,0:16:05.54,Default,,0,0,0,,Жедел мәре – 2 ұпай
Dialogue: 0,0:16:05.96,0:16:07.29,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:16:11.47,0:16:13.13,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:16:15.97,0:16:18.97,Default,,0,0,0,,Енді бірінші матчтан бастап назар аударыңыз
Dialogue: 0,0:16:19.06,0:16:20.22,Default,,0,0,0,,Соқтығысайық!
Dialogue: 0,0:16:20.85,0:16:22.98,Default,,0,0,0,,Шабуыл түрі Victory Valkyrie
Dialogue: 0,0:16:23.27,0:16:26.40,Default,,0,0,0,,Бұл бір мүйізді құлпын ашудың қорғаныс түрі.
Dialogue: 0,0:16:27.15,0:16:30.32,Default,,0,0,0,,Жалғыз мүйізді... бұл қорғаныс түрі болса да.
Dialogue: 0,0:16:30.40,0:16:33.15,Default,,0,0,0,,«Мүйізді ату» шабуылының техникасы күшті.
Dialogue: 0,0:16:33.24,0:16:36.53,Default,,0,0,0,,Бірақ Инсуке бір мүйізді жарып жіберді.
Dialogue: 0,0:16:37.16,0:16:40.12,Default,,0,0,0,,Мен де сені Инуске сияқты желдей ұшырамын.
Dialogue: 0,0:16:40.83,0:16:43.87,Default,,0,0,0,,Енді жалғыз мүйізді көлеңкелер жоқ
Dialogue: 0,0:16:44.33,0:16:46.42,Default,,0,0,0,,Бір мүйізділер қорғаныс типтеріне жататындықтан.
Dialogue: 0,0:16:46.54,0:16:49.29,Default,,0,0,0,,Шабуыл түрі Valkyrie қолайсыз.
Dialogue: 0,0:16:49.38,0:16:50.00,Default,,0,0,0,,Эх!
Dialogue: 0,0:16:50.46,0:16:54.55,Default,,0,0,0,,Бірақ егер Балто Валькириді оята алса...
Dialogue: 0,0:16:55.80,0:16:57.18,Default,,0,0,0,,Ояну?
Dialogue: 0,0:16:57.51,0:16:59.22,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:16:59.76,0:17:02.81,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:17:03.14,0:17:05.56,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:17:07.44,0:17:09.31,Default,,0,0,0,,Екеуі де атқа жақсы шықты.
Dialogue: 0,0:17:09.40,0:17:11.36,Default,,0,0,0,,Жүр, Валькири!
Dialogue: 0,0:17:11.82,0:17:13.78,Default,,0,0,0,,Жалғыз мүйізді жүгіру!
Dialogue: 0,0:17:15.65,0:17:17.95,Default,,0,0,0,,Валькиридің шапшаң соққысы
Dialogue: 0,0:17:18.03,0:17:19.87,Default,,0,0,0,,Жалғыз мүйізді қашып барады
Dialogue: 0,0:17:19.95,0:17:20.99,Default,,0,0,0,,Қайтадан қашты
Dialogue: 0,0:17:21.08,0:17:21.66,Default,,0,0,0,,О
Dialogue: 0,0:17:21.95,0:17:22.83,Default,,0,0,0,,Жарайды
Dialogue: 0,0:17:22.91,0:17:23.79,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:26.08,0:17:29.04,Default,,0,0,0,,Укио керемет (Рантаро) Не!
Dialogue: 0,0:17:29.50,0:17:31.21,Default,,0,0,0,,Оян, Валькири!
Dialogue: 0,0:17:31.30,0:17:33.09,Default,,0,0,0,,Жүр!
Dialogue: 0,0:17:33.17,0:17:34.97,Default,,0,0,0,,Валькиридің шабуылы
Dialogue: 0,0:17:35.05,0:17:38.76,Default,,0,0,0,,Бірақ бір мүйізді жалы оны шабуылдан қорғайды.
Dialogue: 0,0:17:38.84,0:17:41.56,Default,,0,0,0,,Ал Масаның үлкен ине жүргізуші
Dialogue: 0,0:17:41.64,0:17:43.02,Default,,0,0,0,,Есептегіш
Dialogue: 0,0:17:43.52,0:17:45.06,Default,,0,0,0,,Мүйіз ату!
Dialogue: 0,0:17:48.23,0:17:50.11,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:17:52.65,0:17:54.94,Default,,0,0,0,,Жалғыз мүйіздің өткір мүйізі
Dialogue: 0,0:17:55.03,0:17:57.20,Default,,0,0,0,,Валькириге қадалған
Dialogue: 0,0:17:57.40,0:17:58.36,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:58.70,0:18:00.24,Default,,0,0,0,,Аяқтау
Dialogue: 0,0:18:00.32,0:18:02.91,Default,,0,0,0,,Алдымен Unicorn 1 ұпай құлпын ашыңыз
Dialogue: 0,0:18:03.12,0:18:05.66,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:18:08.17,0:18:09.75,Default,,0,0,0,,Жарайды, досым.
Dialogue: 0,0:18:10.75,0:18:14.67,Default,,0,0,0,,Мен өзімді жақсы сезіндім, келесі жолы міндетті түрде жасай аламын!
Dialogue: 0,0:18:15.13,0:18:16.97,Default,,0,0,0,,Осы жолы ояныңыз
Dialogue: 0,0:18:18.13,0:18:20.76,Default,,0,0,0,,Ояну? Сен не туралы айтып тұрсың?
Dialogue: 0,0:18:21.72,0:18:22.97,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:18:24.47,0:18:25.81,Default,,0,0,0,,Дерлік
Dialogue: 0,0:18:25.89,0:18:27.31,Default,,0,0,0,,Тағы да
Dialogue: 0,0:18:27.39,0:18:29.94,Default,,0,0,0,,Балттың жігіті қайталап көргісі келеді.
Dialogue: 0,0:18:30.02,0:18:30.85,Default,,0,0,0,,О
Dialogue: 0,0:18:31.23,0:18:32.65,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:18:32.73,0:18:34.40,Default,,0,0,0,,Маған не көрсетпексің?
Dialogue: 0,0:18:34.73,0:18:36.44,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:36.82,0:18:39.91,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:39.99,0:18:42.16,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:45.12,0:18:46.95,Default,,0,0,0,,Екеуі де ұшып шығады
Dialogue: 0,0:18:47.16,0:18:50.29,Default,,0,0,0,,...Уау! Бұл бұрынғы дамумен бірдей.
Dialogue: 0,0:18:50.37,0:18:52.79,Default,,0,0,0,,Бұл жағдайда жалғыз мүйізділердің артықшылығы бар.
Dialogue: 0,0:18:53.21,0:18:55.63,Default,,0,0,0,,Оян! Валькирия!
Dialogue: 0,0:18:58.51,0:19:01.51,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:03.76,0:19:05.85,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:19:08.14,0:19:09.94,Default,,0,0,0,,Тез ату!
Dialogue: 0,0:19:12.86,0:19:14.94,Default,,0,0,0,,Керемет уау
Dialogue: 0,0:19:15.02,0:19:16.19,Default,,0,0,0,,Капитан, бұйрығыңызды
Dialogue: 0,0:19:16.28,0:19:18.65,Default,,0,0,0,,Бұл алдыңғы валькирлерден өзгеше.
Dialogue: 0,0:19:18.74,0:19:20.45,Default,,0,0,0,,Жабайы және жылдам
Dialogue: 0,0:19:20.53,0:19:23.49,Default,,0,0,0,,Жалғыз мүйізді қорқынышты шабуылмен жеңіңіз
Dialogue: 0,0:19:24.24,0:19:25.66,Default,,0,0,0,,Taero Unicorn!
Dialogue: 0,0:19:26.20,0:19:27.20,Default,,0,0,0,,Оянды!
Dialogue: 0,0:19:27.54,0:19:28.58,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:31.25,0:19:32.42,Default,,0,0,0,,Ха Хан
Dialogue: 0,0:19:32.50,0:19:33.79,Default,,0,0,0,,Бұл шоу уақыты
Dialogue: 0,0:19:34.21,0:19:35.63,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:19:37.25,0:19:39.80,Default,,0,0,0,,Жалғыз мүйізді жару
Dialogue: 0,0:19:39.88,0:19:42.55,Default,,0,0,0,,Қарқынды шабуылға шыдай алмадым
Dialogue: 0,0:19:42.76,0:19:45.43,Default,,0,0,0,,Жеңіс Валькиридің жарқырауы
Dialogue: 0,0:19:45.51,0:19:48.10,Default,,0,0,0,,Аои Барто 2-1 есебімен жеңіске жетті
Dialogue: 0,0:19:49.27,0:19:51.19,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:51.27,0:19:53.48,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:19:53.65,0:19:54.81,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:55.06,0:19:57.02,Default,,0,0,0,,Мен жеңдім~
Dialogue: 0,0:19:57.94,0:20:00.57,Default,,0,0,0,,Балт, сен қайтадан есейдің.
Dialogue: 0,0:20:00.94,0:20:01.90,Default,,0,0,0,,О
Dialogue: 0,0:20:02.15,0:20:05.49,Default,,0,0,0,,Өйткені, ол мені қыздырады.
Dialogue: 0,0:20:05.91,0:20:07.66,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:20:08.62,0:20:10.20,Default,,0,0,0,,Кумичо Дина
Dialogue: 0,0:20:10.29,0:20:11.79,Default,,0,0,0,,Мен жеңдім!
Dialogue: 0,0:20:11.87,0:20:13.92,Default,,0,0,0,,Сен істедің, Балто.
Dialogue: 0,0:20:14.29,0:20:15.92,Default,,0,0,0,,Оны да жасайық!
Dialogue: 0,0:20:16.46,0:20:19.55,Default,,0,0,0,,Ал, бірінші айналым иықтарды қолға үйрету.
Dialogue: 0,0:20:21.59,0:20:23.22,Default,,0,0,0,,Валькирия
Dialogue: 0,0:20:23.30,0:20:25.01,Default,,0,0,0,,Сіз кереметсіз
Dialogue: 0,0:20:25.09,0:20:27.60,Default,,0,0,0,,Ұлттық құрылтайға бірге барайық
Dialogue: 0,0:20:29.85,0:20:32.14,Default,,0,0,0,,Киракира-кун Найсу!
Dialogue: 0,0:20:33.10,0:20:35.02,Default,,0,0,0,,Республикалық турнирге кімдер бара алады?
Dialogue: 0,0:20:35.10,0:20:37.19,Default,,0,0,0,,Әр блоктан бір адам
Dialogue: 0,0:20:37.36,0:20:38.86,Default,,0,0,0,,Қыздырылған бірінші раунд
Dialogue: 0,0:20:38.94,0:20:40.86,Default,,0,0,0,,Кім жеңіске жетеді?
Dialogue: 0,0:20:45.91,0:20:48.33,Default,,0,0,0,,Рампаж Вайверн
Dialogue: 0,0:20:48.99,0:20:50.16,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:20:50.66,0:20:52.12,Default,,0,0,0,,Комурасаки Вакия
Dialogue: 0,0:20:52.20,0:20:55.12,Default,,0,0,0,,Лезде өлтіру үшін қосымша қуат
Dialogue: 0,0:20:55.58,0:20:58.42,Default,,0,0,0,,Бұл иық шайқағышқа ұқсайды.
Dialogue: 0,0:21:01.67,0:21:03.55,Default,,0,0,0,,Одинге шабуыл
Dialogue: 0,0:21:03.63,0:21:05.76,Default,,0,0,0,,Одиннің соққысы
Dialogue: 0,0:21:08.01,0:21:10.72,Default,,0,0,0,,Күміс жүз Орочидің жылдам жеңісі
Dialogue: 0,0:21:14.81,0:21:16.98,Default,,0,0,0,,Сейя! Екі қылышпен кесіңіз
Dialogue: 0,0:21:17.23,0:21:18.65,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:21:18.90,0:21:21.48,Default,,0,0,0,,Yggdrasil Unflinching
Dialogue: 0,0:21:21.57,0:21:23.49,Default,,0,0,0,,Жеңімпаз Юго Нансуи болды.
Dialogue: 0,0:21:24.28,0:21:25.24,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:29.16,0:21:32.24,Default,,0,0,0,,Өлім өлшемін шайқаңыз!
Dialogue: 0,0:21:32.74,0:21:33.95,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:21:34.04,0:21:37.58,Default,,0,0,0,,Шайқап түсіру одан да күшті
Dialogue: 0,0:21:37.67,0:21:38.75,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:21:43.59,0:21:46.22,Default,,0,0,0,,Юго екінші раундтағы қарсылас па?
Dialogue: 0,0:21:51.56,0:21:53.77,Default,,0,0,0,,Сөзсіз жеңіңіз!
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Сіз енді ешқашан жоғалмайсыз
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Артынан қусаң да көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.15,0:23:29.65,Default,,0,0,0,,Валькирияның оянуы Оны бәрі көрді ме?
Dialogue: 0,0:23:29.74,0:23:32.16,Default,,0,0,0,,Біз осы қарқынмен жеңіске жетеміз!
Dialogue: 0,0:23:32.24,0:23:33.87,Default,,0,0,0,,Сәйкестік жоқ кезде
Dialogue: 0,0:23:33.95,0:23:37.24,Default,,0,0,0,,Достарыңызға қолдау көрсету Bay Club ережесі.
Dialogue: 0,0:23:37.33,0:23:40.41,Default,,0,0,0,,Кумичо Дина, міндетті түрде жең!
Dialogue: 0,0:23:40.50,0:23:42.67,Default,,0,0,0,,Маған тамаша ойын көрсетіңіз
Dialogue: 0,0:23:42.75,0:23:44.92,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:45.00,0:23:46.59,Default,,0,0,0,,Жалғыз өлімші
Dialogue: 0,0:23:46.67,0:23:48.46,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.55,0:23:49.97,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.47,0:23:57.47,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory