Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.21,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.30,0:00:12.55,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.67,0:00:14.68,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.76,0:00:16.97,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.05,0:00:19.22,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.43,0:00:24.06,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.14,0:00:26.19,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.27,0:00:28.65,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.40,0:00:33.24,Default,,0,0,0,,Республикалық турнирдің 3-туры
Dialogue: 0,0:00:33.57,0:00:35.70,Default,,0,0,0,,Менің қарсыласым Шақа, Төрт ондық император.
Dialogue: 0,0:00:36.11,0:00:37.91,Default,,0,0,0,,Кеттік, Шақа!
Dialogue: 0,0:00:38.32,0:00:39.41,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:00:39.87,0:00:42.45,Default,,0,0,0,,
Dialogue: 0,0:00:42.79,0:00:45.54,Default,,0,0,0,,Шақамен жеке жекпе-жекте кездесетін кез келді.
Dialogue: 0,0:00:45.96,0:00:48.33,Default,,0,0,0,,Өте қызу шайқас басталды
Dialogue: 0,0:00:49.50,0:00:50.71,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:00:51.84,0:00:53.13,Default,,0,0,0,,Үш
Dialogue: 0,0:00:53.92,0:00:55.01,Default,,0,0,0,,Екі
Dialogue: 0,0:00:55.34,0:00:56.38,Default,,0,0,0,,(Ян) Не дедің, жексұрын? Аузыңды жап.
Dialogue: 0,0:00:56.84,0:00:59.76,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:01:01.10,0:01:06.60,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:01:07.19,0:01:08.94,Default,,0,0,0,,Мен тікелей бәсекелеспін
Dialogue: 0,0:01:09.11,0:01:11.94,Default,,0,0,0,,Burst Burst Сондай-ақ үлкен Burst шайқасында
Dialogue: 0,0:01:12.28,0:01:13.99,Default,,0,0,0,,Ақыры мен жеңдім
Dialogue: 0,0:01:14.07,0:01:15.99,Default,,0,0,0,,Жартылай финалға өту
Dialogue: 0,0:01:24.75,0:01:27.12,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:27.46,0:01:32.63,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:43.93,0:01:47.31,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:47.81,0:01:49.94,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:50.36,0:01:54.48,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:54.61,0:01:57.82,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:01:57.95,0:02:04.37,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:04.66,0:02:09.08,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:09.58,0:02:15.00,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:15.13,0:02:17.38,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:17.47,0:02:22.18,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:22.35,0:02:27.43,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:27.73,0:02:29.98,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:30.19,0:02:32.52,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:32.81,0:02:36.73,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:36.90,0:02:41.91,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:42.12,0:02:44.28,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:48.62,0:02:50.58,Default,,0,0,0,,Жұлдызды шайқас!
Dialogue: 0,0:02:52.21,0:02:55.46,Default,,0,0,0,,Жарайсыңдар, қызу республикалық турнир
Dialogue: 0,0:02:55.55,0:02:57.46,Default,,0,0,0,,Ең үлкен толқу байқалды
Dialogue: 0,0:02:57.55,0:03:00.72,Default,,0,0,0,,Барто Аои VS Кайза жанып тұрған ғибадатхананың толқуы
Dialogue: 0,0:03:00.80,0:03:02.97,Default,,0,0,0,,Bay Arena әлі суыған жоқ
Dialogue: 0,0:03:03.05,0:03:05.93,Default,,0,0,0,,Бірақ шайқас әлі жалғасуда~
Dialogue: 0,0:03:06.01,0:03:09.06,Default,,0,0,0,,Жеке турнирдің финалдық матч картасының 3-ші туры
Dialogue: 0,0:03:09.14,0:03:10.06,Default,,0,0,0,,4-ойын
Dialogue: 0,0:03:10.14,0:03:13.73,Default,,0,0,0,,Төрт бұрылыс император Зак Күн сәулесі VS Акира Ямабуки
Dialogue: 0,0:03:13.81,0:03:16.02,Default,,0,0,0,,Ак-кун~!
Dialogue: 0,0:03:16.11,0:03:18.53,Default,,0,0,0,,Зак~!
Dialogue: 0,0:03:22.53,0:03:23.49,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:03:23.78,0:03:24.57,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:24.95,0:03:26.08,Default,,0,0,0,,Зак
Dialogue: 0,0:03:26.16,0:03:29.29,Default,,0,0,0,,Жартылай финалға өтуіңізбен құттықтаймыз, Киракира-кун
Dialogue: 0,0:03:29.37,0:03:32.71,Default,,0,0,0,,Ой, мен бүгін Гира Гира-кун деп айтуым керек сияқты.
Dialogue: 0,0:03:33.08,0:03:34.46,Default,,0,0,0,,Жарқырау?
Dialogue: 0,0:03:34.83,0:03:37.21,Default,,0,0,0,,Осы жүрек соғуын қатты шырылдатыңыз
Dialogue: 0,0:03:37.30,0:03:39.01,Default,,0,0,0,,Бұл аңғал шайқас болды.
Dialogue: 0,0:03:39.51,0:03:42.13,Default,,0,0,0,,Мен сол төрт айналмалы император Шаканы жеңгеніме сене алар емеспін.
Dialogue: 0,0:03:42.47,0:03:44.01,Default,,0,0,0,,Ұнады! Ең жақсы!
Dialogue: 0,0:03:44.09,0:03:47.43,Default,,0,0,0,,Бар күшіммен соқтым.
Dialogue: 0,0:03:47.51,0:03:48.22,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:03:48.43,0:03:49.47,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:03:49.68,0:03:51.48,Default,,0,0,0,,Келесісін күту
Dialogue: 0,0:03:51.56,0:03:53.10,Default,,0,0,0,,Олардың бәрін жеңіп алмасаңыз
Dialogue: 0,0:03:53.27,0:03:55.40,Default,,0,0,0,,Бұл сынақ ешқашан бітпейді~
Dialogue: 0,0:03:55.48,0:03:56.40,Default,,0,0,0,,Haha~n
Dialogue: 0,0:03:56.65,0:03:59.07,Default,,0,0,0,,Қарасам, Шу да бар.
Dialogue: 0,0:03:59.15,0:04:00.19,Default,,0,0,0,,Луи де сонда
Dialogue: 0,0:04:00.28,0:04:03.07,Default,,0,0,0,,Ой~ Мен бұған дейін болдым.
Dialogue: 0,0:04:03.15,0:04:04.45,Default,,0,0,0,,Ұмытпа
Dialogue: 0,0:04:04.53,0:04:05.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:05.74,0:04:07.87,Default,,0,0,0,,Егер мен бұл матчты жеңсем
Dialogue: 0,0:04:07.95,0:04:10.33,Default,,0,0,0,,Мен сені келесі жартылай финалда кездестіремін.
Dialogue: 0,0:04:10.41,0:04:12.21,Default,,0,0,0,,Мен күтемін.
Dialogue: 0,0:04:12.29,0:04:15.88,Default,,0,0,0,,Мені жаңадан келген жігіт күтіп тұрғаны жақсы.
Dialogue: 0,0:04:15.96,0:04:18.17,Default,,0,0,0,,Бірақ мен төрт айналымды императормын
Dialogue: 0,0:04:18.25,0:04:21.30,Default,,0,0,0,,Жаңадан келгендерге нағыз жұлдыздың қандай болатынын көрсету
Dialogue: 0,0:04:21.38,0:04:22.67,Default,,0,0,0,,Маған көрсетейін
Dialogue: 0,0:04:23.59,0:04:25.59,Default,,0,0,0,,Кездескенше~ Хаха~
Dialogue: 0,0:04:26.72,0:04:28.81,Default,,0,0,0,,Сәттілік Зак!
Dialogue: 0,0:04:30.35,0:04:32.89,Default,,0,0,0,,Қолынан келгеннің бәрін жасайтын басқа адам
Dialogue: 0,0:04:34.69,0:04:37.44,Default,,0,0,0,,
Dialogue: 0,0:04:37.86,0:04:39.90,Default,,0,0,0,,Келе жатыр, келе жатыр, келе жатыр!
Dialogue: 0,0:04:39.98,0:04:42.44,Default,,0,0,0,,Бүгін қандай қойылым болады?
Dialogue: 0,0:04:42.90,0:04:44.70,Default,,0,0,0,,Бұл не, балалар?
Dialogue: 0,0:04:49.78,0:04:51.24,Default,,0,0,0,,Haha~n
Dialogue: 0,0:04:51.33,0:04:53.20,Default,,0,0,0,,(Закқа сәлем)
Dialogue: 0,0:04:53.50,0:04:55.37,Default,,0,0,0,,Зак Күн сәулесі
Dialogue: 0,0:04:55.46,0:04:57.13,Default,,0,0,0,,Үшінші ойынның толқуынан өзгеріс
Dialogue: 0,0:04:57.21,0:05:00.21,Default,,0,0,0,,Бұл жолы соқыр жарық келіп тұрғандай.
Dialogue: 0,0:05:00.50,0:05:02.21,Default,,0,0,0,,Зак~!
Dialogue: 0,0:05:02.80,0:05:05.59,Default,,0,0,0,,Менен барлығына сыйлық берейік
Dialogue: 0,0:05:05.68,0:05:08.59,Default,,0,0,0,,Менің махаббатым жеңіс деп аталады.
Dialogue: 0,0:05:08.80,0:05:09.97,Default,,0,0,0,,Ой
Dialogue: 0,0:05:10.05,0:05:11.10,Default,,0,0,0,,Төрт бұрылыс император Зак
Dialogue: 0,0:05:11.18,0:05:13.02,Default,,0,0,0,,Жеңіс туралы декларация осында!
Dialogue: 0,0:05:13.64,0:05:14.89,Default,,0,0,0,,Енді жалғастырыңыз.
Dialogue: 0,0:05:14.98,0:05:17.19,Default,,0,0,0,,Қарсылас пайда болады
Dialogue: 0,0:05:25.36,0:05:27.45,Default,,0,0,0,,(Акира үшін құттықтау)
Dialogue: 0,0:05:34.75,0:05:36.96,Default,,0,0,0,,Ак-кун~!
Dialogue: 0,0:05:37.21,0:05:38.92,Default,,0,0,0,,Керемет!
Dialogue: 0,0:05:39.00,0:05:41.59,Default,,0,0,0,,Уау, бұл жігіт сондай керемет.
Dialogue: 0,0:05:41.67,0:05:44.17,Default,,0,0,0,,Не? Жігіттер, сендер байланып қалдыңдар ма?
Dialogue: 0,0:05:44.26,0:05:46.59,Default,,0,0,0,,Қызық, әзілкештер арасындағы тартыс?
Dialogue: 0,0:05:46.67,0:05:47.55,Default,,0,0,0,,Әрі қарай, Эрен
Dialogue: 0,0:05:47.63,0:05:49.01,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:49.22,0:05:50.80,Default,,0,0,0,,Жарқырап тұр
Dialogue: 0,0:05:51.05,0:05:52.76,Default,,0,0,0,,Акира Ямабуки
Dialogue: 0,0:05:52.85,0:05:55.31,Default,,0,0,0,,Жарқыраған орындаушылықпен көріну!
Dialogue: 0,0:05:56.73,0:05:59.10,Default,,0,0,0,,♪ Айнал, бұр, Анубис айналады.
Dialogue: 0,0:05:59.19,0:06:02.11,Default,,0,0,0,,♪ Баршаңыздан махаббатқа толы
Dialogue: 0,0:06:02.19,0:06:05.40,Default,,0,0,0,,♪Жүрегім де айналады
Dialogue: 0,0:06:05.49,0:06:08.07,Default,,0,0,0,,♪Мен – жеңіс, сен – көз жас
Dialogue: 0,0:06:08.15,0:06:10.53,Default,,0,0,0,,♪Жұлдыз жарқырайды, одан да қызықты
Dialogue: 0,0:06:10.62,0:06:11.87,Default,,0,0,0,,♪Баршаның сүйіспеншілігімен
Dialogue: 0,0:06:12.03,0:06:15.20,Default,,0,0,0,,♪Мен және Анубис, бұл жарқырап тұр
Dialogue: 0,0:06:15.66,0:06:19.17,Default,,0,0,0,,Барлығы~ Мен және Анубис, жеңіс сәті
Dialogue: 0,0:06:19.25,0:06:20.50,Default,,0,0,0,,Қараңыз!
Dialogue: 0,0:06:20.58,0:06:22.59,Default,,0,0,0,,Иә
Dialogue: 0,0:06:22.67,0:06:25.00,Default,,0,0,0,,Мен сені күттім бе, Сенпай?
Dialogue: 0,0:06:25.25,0:06:26.63,Default,,0,0,0,,Шын мәнінде емес.
Dialogue: 0,0:06:26.84,0:06:28.42,Default,,0,0,0,,Сіздің өнімділігіңіз, солай ма?
Dialogue: 0,0:06:28.51,0:06:30.51,Default,,0,0,0,,Орташа сенпайдан басқа
Dialogue: 0,0:06:30.59,0:06:32.76,Default,,0,0,0,,Әрқашан соңғы орында
Dialogue: 0,0:06:32.85,0:06:35.06,Default,,0,0,0,,Өзіңізді таң қалдырыңыз
Dialogue: 0,0:06:37.39,0:06:40.60,Default,,0,0,0,,Сенпай Жоқ, Зак Күн сәулесі!
Dialogue: 0,0:06:41.27,0:06:42.94,Default,,0,0,0,,Сен менің таңданысымсың
Dialogue: 0,0:06:43.31,0:06:45.32,Default,,0,0,0,,Мені бүгінге айналдырғанның бәрі
Dialogue: 0,0:06:45.78,0:06:47.65,Default,,0,0,0,,Мен сенің арқаңды бақылап отырмын
Dialogue: 0,0:06:47.94,0:06:50.11,Default,,0,0,0,,Мен сені қуып жүрдім
Dialogue: 0,0:06:50.20,0:06:51.28,Default,,0,0,0,,Бірақ бүгін
Dialogue: 0,0:06:51.36,0:06:53.07,Default,,0,0,0,,Мен сені жеңемін
Dialogue: 0,0:06:53.16,0:06:55.87,Default,,0,0,0,,Баспалдақпен жоғары көтеріліңіз
Dialogue: 0,0:06:55.95,0:06:57.50,Default,,0,0,0,,Жеңіске жетуді мақсат ету
Dialogue: 0,0:06:57.58,0:07:00.21,Default,,0,0,0,,Жұлдыз сияқты пышақ
Dialogue: 0,0:07:00.29,0:07:02.17,Default,,0,0,0,,Мен жоғарыда тұрамын
Dialogue: 0,0:07:02.58,0:07:05.80,Default,,0,0,0,,Уау! Жеңіс туралы қандай күшті мәлімдеме
Dialogue: 0,0:07:06.00,0:07:08.92,Default,,0,0,0,,Бұл матч: Superstar Zack VS
Dialogue: 0,0:07:09.01,0:07:12.22,Default,,0,0,0,,Бұл тағы бір жұлдызды жол, жарылғыш пұттың жүзі
Dialogue: 0,0:07:12.30,0:07:14.76,Default,,0,0,0,,Акира Ямабукидің жұлдызды кездесуі
Dialogue: 0,0:07:14.85,0:07:16.43,Default,,0,0,0,,Барт Аоидан кейін
Dialogue: 0,0:07:16.51,0:07:19.56,Default,,0,0,0,,Төрт-он императордың бір бұрышын жоюға болады ма?
Dialogue: 0,0:07:20.52,0:07:22.81,Default,,0,0,0,,(тыныш орын)
Dialogue: 0,0:07:23.86,0:07:25.31,Default,,0,0,0,,Керемет
Dialogue: 0,0:07:25.40,0:07:27.65,Default,,0,0,0,,Мен сені қолымды көтеріп алдадым.
Dialogue: 0,0:07:28.36,0:07:29.94,Default,,0,0,0,,Мен қуаныштымын, Акира.
Dialogue: 0,0:07:30.19,0:07:33.03,Default,,0,0,0,,Бірақ жоғарыда тұрған адам ретінде
Dialogue: 0,0:07:33.28,0:07:35.24,Default,,0,0,0,,Шайқауға болмайтын нәрселер бар екенін
Dialogue: 0,0:07:35.32,0:07:36.91,Default,,0,0,0,,Білгім келеді
Dialogue: 0,0:07:37.24,0:07:39.20,Default,,0,0,0,,Мақтаныш?
Dialogue: 0,0:07:39.29,0:07:40.16,Default,,0,0,0,,О
Dialogue: 0,0:07:40.54,0:07:42.29,Default,,0,0,0,,Мен де мақтанышымды ортаға салдым
Dialogue: 0,0:07:42.37,0:07:43.92,Default,,0,0,0,,Мен сенімен соқтығысамын
Dialogue: 0,0:07:44.25,0:07:47.34,Default,,0,0,0,,Жұлдызымдай, Жүзімдей
Dialogue: 0,0:07:47.42,0:07:49.46,Default,,0,0,0,,Бірінші шарықтау шегі
Dialogue: 0,0:07:49.55,0:07:50.72,Default,,0,0,0,,басталады
Dialogue: 0,0:07:51.42,0:07:52.55,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:07:52.93,0:07:55.26,Default,,0,0,0,,Келіңіздер, Зак - Циллион Зевс.
Dialogue: 0,0:07:55.34,0:07:57.10,Default,,0,0,0,,Акира - Анубис қышқылы
Dialogue: 0,0:07:57.18,0:07:59.56,Default,,0,0,0,,Бірінші 3 ұпай жинаған ойынды шешеді.
Dialogue: 0,0:07:59.64,0:08:01.23,Default,,0,0,0,,Төзімділік үшін Zeus түрі
Dialogue: 0,0:08:01.39,0:08:04.35,Default,,0,0,0,,Қорғаныс түрі Анубис қалай күреседі?
Dialogue: 0,0:08:04.44,0:08:05.77,Default,,0,0,0,,Анубис дегеніміз не?
Dialogue: 0,0:08:05.86,0:08:08.40,Default,,0,0,0,,Диск өте үлкен, солай емес пе?
Dialogue: 0,0:08:08.77,0:08:10.69,Default,,0,0,0,,Эй, бұл үлкен бе?
Dialogue: 0,0:08:10.86,0:08:12.82,Default,,0,0,0,,Ол але дискі деп аталады.
Dialogue: 0,0:08:13.20,0:08:14.99,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:08:15.07,0:08:18.20,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:18.58,0:08:21.16,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:21.25,0:08:22.21,Default,,0,0,0,,Жарқыраған
Dialogue: 0,0:08:22.29,0:08:24.54,Default,,0,0,0,,Қандай тамаша кадр
Dialogue: 0,0:08:24.62,0:08:26.67,Default,,0,0,0,,Акира Ямабукидің кезегі анықталды
Dialogue: 0,0:08:26.75,0:08:28.25,Default,,0,0,0,,Кел, Зевс
Dialogue: 0,0:08:28.46,0:08:31.55,Default,,0,0,0,,Анубис дискісі сізді күтуде.
Dialogue: 0,0:08:31.63,0:08:35.43,Default,,0,0,0,,Анубис дискінің өлшеміне байланысты жоғары айналу күшіне қосымша,
Dialogue: 0,0:08:35.64,0:08:38.39,Default,,0,0,0,,Ауырлық центрі ішкі жағында, сондықтан ол шайқалмайды.
Dialogue: 0,0:08:38.68,0:08:40.68,Default,,0,0,0,,Ол жоғары тұрақтылықпен мақтана алады.
Dialogue: 0,0:08:42.18,0:08:44.64,Default,,0,0,0,,Жарқырап тұр, Акира
Dialogue: 0,0:08:44.85,0:08:46.31,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:08:46.40,0:08:48.81,Default,,0,0,0,,Жарқырап тұрмаса мен емеспін
Dialogue: 0,0:08:51.69,0:08:53.82,Default,,0,0,0,,Сенпайдың көңілі көтерілді.
Dialogue: 0,0:08:54.49,0:08:56.11,Default,,0,0,0,,Бұл сіз көрсеткен нәрсе.
Dialogue: 0,0:08:59.20,0:09:01.66,Default,,0,0,0,,Ешбір тарап орталықтан бас тартпайды.
Dialogue: 0,0:09:01.99,0:09:04.08,Default,,0,0,0,,Келіңіздер! Циллион Зевс
Dialogue: 0,0:09:05.46,0:09:06.25,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:09:09.50,0:09:10.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:12.26,0:09:13.55,Default,,0,0,0,,(шығанақтың құлаған дыбысы)
Dialogue: 0,0:09:15.09,0:09:16.59,Default,,0,0,0,,Аяқтау
Dialogue: 0,0:09:16.68,0:09:18.43,Default,,0,0,0,,Циллион Зевс 1 ұпай
Dialogue: 0,0:09:18.51,0:09:20.81,Default,,0,0,0,,
Dialogue: 0,0:09:20.89,0:09:22.10,Default,,0,0,0,,Haha~n
Dialogue: 0,0:09:22.35,0:09:23.39,Default,,0,0,0,,Әрқашан
Dialogue: 0,0:09:23.47,0:09:25.98,Default,,0,0,0,,Орталық – супер жұлдыздардың орны.
Dialogue: 0,0:09:26.19,0:09:27.60,Default,,0,0,0,,Зак~
Dialogue: 0,0:09:27.69,0:09:29.77,Default,,0,0,0,,Жарқырап тұр~
Dialogue: 0,0:09:31.27,0:09:33.15,Default,,0,0,0,,Рэп енді шықпай ма?
Dialogue: 0,0:09:34.94,0:09:37.78,Default,,0,0,0,,Мен мұндай сенпайды бұрын көрген емеспін.
Dialogue: 0,0:09:38.45,0:09:39.87,Default,,0,0,0,,Қатты толқыдым
Dialogue: 0,0:09:39.95,0:09:41.91,Default,,0,0,0,,Бұл Сенпайдың байыптылығы
Dialogue: 0,0:09:42.08,0:09:43.49,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:09:44.37,0:09:46.46,Default,,0,0,0,,Осы сенпайды жеңу үшін
Dialogue: 0,0:09:46.83,0:09:48.50,Default,,0,0,0,,Бүгінгі матчтың мағынасы бар.
Dialogue: 0,0:09:49.88,0:09:52.04,Default,,0,0,0,,Екі ірі жұлдыздың кездесуі
Dialogue: 0,0:09:52.13,0:09:54.71,Default,,0,0,0,,Зак бірінші шайқаста жеңіске жетті.
Dialogue: 0,0:09:54.80,0:09:56.13,Default,,0,0,0,,Біз осылай құтыла аламыз ба?
Dialogue: 0,0:09:56.22,0:09:58.84,Default,,0,0,0,,Әлде Акира Ямабуки оны қайтарып алады ма?
Dialogue: 0,0:09:58.93,0:10:00.72,Default,,0,0,0,,Зак~
Dialogue: 0,0:10:01.18,0:10:04.39,Default,,0,0,0,,Бұл турнир тарихындағы әйелдердің ең жоғары пайызы.
Dialogue: 0,0:10:04.47,0:10:06.73,Default,,0,0,0,,Өйткені бұл Зак пен Аккун.
Dialogue: 0,0:10:06.81,0:10:08.27,Default,,0,0,0,,Әрине!
Dialogue: 0,0:10:08.35,0:10:10.48,Default,,0,0,0,,Огимен сөйлесейік
Dialogue: 0,0:10:10.77,0:10:12.40,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:10:13.15,0:10:14.82,Default,,0,0,0,,Сіздің тартымды түсіріліміңіз
Dialogue: 0,0:10:14.90,0:10:16.40,Default,,0,0,0,,Мен де жасап көремін
Dialogue: 0,0:10:17.28,0:10:19.49,Default,,0,0,0,,Бір ғажабы бар.
Dialogue: 0,0:10:19.61,0:10:22.45,Default,,0,0,0,,Оны Rolling Shot деп атаңыз
Dialogue: 0,0:10:22.74,0:10:24.45,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:10:24.79,0:10:28.25,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:28.33,0:10:30.67,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:31.17,0:10:32.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:32.34,0:10:33.88,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:10:33.96,0:10:36.80,Default,,0,0,0,,Анубис орталықты тез басып алады.
Dialogue: 0,0:10:37.13,0:10:38.80,Default,,0,0,0,,Зак да бұрылды.
Dialogue: 0,0:10:38.88,0:10:40.09,Default,,0,0,0,,Керемет
Dialogue: 0,0:10:40.18,0:10:41.43,Default,,0,0,0,,Қарсыластың соққысы
Dialogue: 0,0:10:41.51,0:10:43.97,Default,,0,0,0,,Мен оны бір рет көргеннен кейін өзім жасадым
Dialogue: 0,0:10:44.35,0:10:46.06,Default,,0,0,0,,Қандай жауап!
Dialogue: 0,0:10:47.14,0:10:48.10,Default,,0,0,0,,Анубис!
Dialogue: 0,0:10:48.27,0:10:50.14,Default,,0,0,0,,Бұл жолы мен есептегіш туралы шешім қабылдаймын!
Dialogue: 0,0:10:53.44,0:10:54.65,Default,,0,0,0,,Толық шегіну.
Dialogue: 0,0:10:54.86,0:10:57.32,Default,,0,0,0,,Зевстің шабуылынан бас тартпа
Dialogue: 0,0:10:57.86,0:10:59.74,Default,,0,0,0,,Зевс, тепе-теңдікті жоғалттыңыз.
Dialogue: 0,0:10:59.82,0:11:02.45,Default,,0,0,0,,Жоқ, мен қабырғаға соғылып, қайта тұрдым.
Dialogue: 0,0:11:02.53,0:11:04.16,Default,,0,0,0,,Нейс Зевс
Dialogue: 0,0:11:04.24,0:11:05.24,Default,,0,0,0,,Би билейік
Dialogue: 0,0:11:06.83,0:11:09.12,Default,,0,0,0,,Сіз қалай ойлайсыз? Зевстің төзімділігі
Dialogue: 0,0:11:09.21,0:11:10.87,Default,,0,0,0,,Ол қанша уақытқа созылады?
Dialogue: 0,0:11:10.96,0:11:12.38,Default,,0,0,0,,Бейбітшілікте билеу
Dialogue: 0,0:11:12.50,0:11:14.21,Default,,0,0,0,,Циллион Зевс!
Dialogue: 0,0:11:16.46,0:11:18.21,Default,,0,0,0,,Ұстап тұрған орталық күй
Dialogue: 0,0:11:18.38,0:11:20.05,Default,,0,0,0,,Мен оны саған бермеймін деп ойлаймын.
Dialogue: 0,0:11:20.42,0:11:21.51,Default,,0,0,0,,Бірлесіп күресу
Dialogue: 0,0:11:21.59,0:11:24.93,Default,,0,0,0,,Кезінде тұрған сахнаны тастамаймын.
Dialogue: 0,0:11:25.01,0:11:27.39,Default,,0,0,0,,Акира шығанағы Күшті
Dialogue: 0,0:11:27.47,0:11:30.10,Default,,0,0,0,,Орталықтан тепкіш күштің арқасында тепе-теңдік жақсы.
Dialogue: 0,0:11:30.64,0:11:33.40,Default,,0,0,0,,Циллион Зевс Каннидің шабуылы
Dialogue: 0,0:11:33.48,0:11:34.15,Default,,0,0,0,,Фу…
Dialogue: 0,0:11:38.07,0:11:38.98,Default,,0,0,0,,Не!
Dialogue: 0,0:11:39.32,0:11:42.28,Default,,0,0,0,,А, Анубистің айналуына қауіп төніп тұр.
Dialogue: 0,0:11:42.36,0:11:43.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:43.66,0:11:46.53,Default,,0,0,0,,Әлі де дірілдеп тұр
Dialogue: 0,0:11:46.62,0:11:48.29,Default,,0,0,0,,Сіз қанша уақытқа шыдай аласыз?
Dialogue: 0,0:11:48.37,0:11:50.04,Default,,0,0,0,,Анубис қышқылы
Dialogue: 0,0:12:01.47,0:12:02.68,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:03.26,0:12:06.18,Default,,0,0,0,,Айналдыру Аяқтау Циллион Зевс 1 ұпай
Dialogue: 0,0:12:06.26,0:12:08.18,Default,,0,0,0,,Кя~!
Dialogue: 0,0:12:08.26,0:12:10.35,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:12:10.47,0:12:13.35,Default,,0,0,0,,Енді, Акира Ямабуки бұрышта тұр.
Dialogue: 0,0:12:13.56,0:12:15.73,Default,,0,0,0,,Төрт айналымшы Зактың 2 ұпайы бар
Dialogue: 0,0:12:15.81,0:12:18.48,Default,,0,0,0,,Акира Ямабукиде 0 ұпай бар
Dialogue: 0,0:12:18.57,0:12:21.19,Default,,0,0,0,,Zack the Sunshine жартылай финалға өтеді
Dialogue: 0,0:12:21.28,0:12:22.95,Default,,0,0,0,,Қолды қою
Dialogue: 0,0:12:25.03,0:12:27.49,Default,,0,0,0,,Осы уақытқа дейін шайқастар қалай өтті?
Dialogue: 0,0:12:27.87,0:12:29.12,Default,,0,0,0,,Сіздің ішіңізде
Dialogue: 0,0:12:29.20,0:12:31.79,Default,,0,0,0,,Сіздің жауынгерлік рухыңыз көтеріліп жатыр деп ойлаймын.
Dialogue: 0,0:12:32.41,0:12:34.08,Default,,0,0,0,,Сәл күте тұрыңыз.
Dialogue: 0,0:12:34.33,0:12:35.50,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:12:35.58,0:12:37.21,Default,,0,0,0,,Мен жеңемін
Dialogue: 0,0:12:37.46,0:12:39.09,Default,,0,0,0,,Келесі жұлдыз – мен
Dialogue: 0,0:12:39.55,0:12:41.34,Default,,0,0,0,,Барлығы маған қарап тұр
Dialogue: 0,0:12:41.71,0:12:43.38,Default,,0,0,0,,Мен ең жақсымын
Dialogue: 0,0:12:43.97,0:12:45.80,Default,,0,0,0,,Мені жұтпа
Dialogue: 0,0:12:46.84,0:12:48.26,Default,,0,0,0,,Мен қазір қандаймын
Dialogue: 0,0:12:49.01,0:12:51.35,Default,,0,0,0,,Себебі мен сахнада жарқырап тұрған Закты көрдім.
Dialogue: 0,0:12:52.22,0:12:53.98,Default,,0,0,0,,Мен сонда тұрғым келді
Dialogue: 0,0:12:54.81,0:12:57.02,Default,,0,0,0,,Сол нұрға шомылғым келді.
Dialogue: 0,0:12:57.10,0:12:58.15,Default,,0,0,0,,Құпия полицияға қарсы жасырын операция
Dialogue: 0,0:12:58.23,0:13:00.36,Default,,0,0,0,,Неғұрлым көп сабақ болса, соғұрлым көп
Dialogue: 0,0:13:00.77,0:13:03.28,Default,,0,0,0,,Сіз тым көп тыңдайсыз
Dialogue: 0,0:13:03.44,0:13:05.57,Default,,0,0,0,,Мен алыста жүргенімді түсіндім.
Dialogue: 0,0:13:06.86,0:13:08.07,Default,,0,0,0,,Мен қазір-
Dialogue: 0,0:13:08.70,0:13:11.16,Default,,0,0,0,,Сонымен біз бір сахнада тұрмыз
Dialogue: 0,0:13:11.41,0:13:13.00,Default,,0,0,0,,Сол нұрға шомылды
Dialogue: 0,0:13:13.20,0:13:14.41,Default,,0,0,0,,Ұрыс
Dialogue: 0,0:13:15.16,0:13:16.42,Default,,0,0,0,,Na~is
Dialogue: 0,0:13:16.50,0:13:18.46,Default,,0,0,0,,Мен сіздің байыптылығыңызды сеземін
Dialogue: 0,0:13:20.29,0:13:22.17,Default,,0,0,0,,Бірақ байыптылық
Dialogue: 0,0:13:22.25,0:13:24.47,Default,,0,0,0,,Мен оны жойып жібергеніме қуаныштымын.
Dialogue: 0,0:13:24.63,0:13:25.84,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:13:26.05,0:13:28.68,Default,,0,0,0,,Мен құлайтын адам болмаймын деп ойлаймын.
Dialogue: 0,0:13:29.05,0:13:30.39,Default,,0,0,0,,Haha~n
Dialogue: 0,0:13:30.47,0:13:32.72,Default,,0,0,0,,Маған мұндай батылдық ұнайды.
Dialogue: 0,0:13:34.81,0:13:36.14,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:13:36.73,0:13:38.94,Default,,0,0,0,,Бұл үлкен шайқас болды.
Dialogue: 0,0:13:39.02,0:13:40.69,Default,,0,0,0,,Көңілді жүрсің бе, Акира?
Dialogue: 0,0:13:40.98,0:13:42.48,Default,,0,0,0,,Сізді ұрыңыз
Dialogue: 0,0:13:42.69,0:13:44.53,Default,,0,0,0,,Менің қызығым осында жатыр
Dialogue: 0,0:13:45.11,0:13:46.40,Default,,0,0,0,,Бұл тамаша.
Dialogue: 0,0:13:46.78,0:13:48.66,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:13:48.74,0:13:52.24,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:52.33,0:13:54.75,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:54.87,0:13:55.75,Default,,0,0,0,,Жарқыраған
Dialogue: 0,0:13:56.21,0:13:57.50,Default,,0,0,0,,Акира Ямабуки
Dialogue: 0,0:13:57.58,0:14:00.38,Default,,0,0,0,,Төрт-он императордан кек алуға бола ма?
Dialogue: 0,0:14:00.46,0:14:01.67,Default,,0,0,0,,Жүр!
Dialogue: 0,0:14:05.05,0:14:07.55,Default,,0,0,0,,(Шығанақтың соғу дыбысы)
Dialogue: 0,0:14:13.81,0:14:15.85,Default,,0,0,0,,Ең көп жарқырап тұрған мен
Dialogue: 0,0:14:16.27,0:14:18.73,Default,,0,0,0,,Анубистің тамаша шеңбері
Dialogue: 0,0:14:18.81,0:14:20.86,Default,,0,0,0,,Мен ешкімнің маған кедергі жасауына жол бермеймін
Dialogue: 0,0:14:31.57,0:14:33.53,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:14:36.33,0:14:37.83,Default,,0,0,0,,Толық аяқтау
Dialogue: 0,0:14:37.91,0:14:40.00,Default,,0,0,0,,Анубис қышқылы 2 ұпай
Dialogue: 0,0:14:40.08,0:14:41.58,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:41.67,0:14:43.42,Default,,0,0,0,,♪Сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:14:43.50,0:14:44.80,Default,,0,0,0,,♪Маған қалдырыңыз
Dialogue: 0,0:14:44.88,0:14:46.13,Default,,0,0,0,,♪Арнайы
Dialogue: 0,0:14:46.21,0:14:47.42,Default,,0,0,0,,♪Ұпай алыңыз
Dialogue: 0,0:14:47.51,0:14:49.68,Default,,0,0,0,,♪Жеңіске ұмтылу
Dialogue: 0,0:14:49.76,0:14:52.18,Default,,0,0,0,,♪Бірге қол жеткізген жеңісіміз ең жақсысы
Dialogue: 0,0:14:52.26,0:14:53.43,Default,,0,0,0,,♪Мен ең күштімін!
Dialogue: 0,0:14:53.51,0:14:55.85,Default,,0,0,0,,Кя~!
Dialogue: 0,0:14:55.93,0:14:58.31,Default,,0,0,0,,♪Йоё Чекера Акира Ямабуки
Dialogue: 0,0:14:58.39,0:15:00.85,Default,,0,0,0,,♪Жеңіс спектаклі О, иә!
Dialogue: 0,0:15:00.94,0:15:02.77,Default,,0,0,0,,Жүр, маған күшті жарылыс бер.
Dialogue: 0,0:15:02.86,0:15:04.02,Default,,0,0,0,,Бірден байлаңыз
Dialogue: 0,0:15:04.23,0:15:06.36,Default,,0,0,0,,Анубис Бұл керемет.
Dialogue: 0,0:15:06.94,0:15:08.53,Default,,0,0,0,,Керемет шеңбер?
Dialogue: 0,0:15:08.61,0:15:10.70,Default,,0,0,0,,Анубис орталықты алған кезде
Dialogue: 0,0:15:10.78,0:15:12.74,Default,,0,0,0,,Бұл мен ешқашан берілмеймін деген сөз.
Dialogue: 0,0:15:12.95,0:15:15.49,Default,,0,0,0,,Енді мен жарылайын деп шештім.
Dialogue: 0,0:15:15.58,0:15:17.16,Default,,0,0,0,,Біз қарсы шығамыз!
Dialogue: 0,0:15:18.08,0:15:19.00,Default,,0,0,0,,Иә
Dialogue: 0,0:15:19.62,0:15:20.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:20.87,0:15:23.88,Default,,0,0,0,,Мен жұлдызмын және батырмын
Dialogue: 0,0:15:23.96,0:15:26.25,Default,,0,0,0,,Батыр бір кезде шымшып қалған.
Dialogue: 0,0:15:26.34,0:15:28.67,Default,,0,0,0,,Керемет кері көріністі жасаңыз
Dialogue: 0,0:15:28.84,0:15:29.72,Default,,0,0,0,,Уф
Dialogue: 0,0:15:30.80,0:15:32.09,Default,,0,0,0,,Күшті шайқас
Dialogue: 0,0:15:33.76,0:15:34.85,Default,,0,0,0,,In
Dialogue: 0,0:15:35.26,0:15:36.43,Default,,0,0,0,,Орындалды.
Dialogue: 0,0:15:36.68,0:15:38.27,Default,,0,0,0,,Дайын жиынтық
Dialogue: 0,0:15:38.68,0:15:41.81,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:15:41.89,0:15:44.23,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:15:44.31,0:15:45.31,Default,,0,0,0,,Жарқыраған
Dialogue: 0,0:15:45.48,0:15:46.27,Default,,0,0,0,,Ei
Dialogue: 0,0:15:46.94,0:15:49.03,Default,,0,0,0,,Енді шыңды көбейтіңіз
Dialogue: 0,0:15:49.11,0:15:50.74,Default,,0,0,0,,Екі жұлдызды кездесу
Dialogue: 0,0:15:50.82,0:15:52.40,Default,,0,0,0,,Бұл оқиғаның соңы ма?
Dialogue: 0,0:15:55.20,0:15:57.83,Default,,0,0,0,,Уау, өте ыстық
Dialogue: 0,0:16:01.62,0:16:03.25,Default,,0,0,0,,Керемет шеңбер
Dialogue: 0,0:16:03.33,0:16:04.75,Default,,0,0,0,,Бұл менің сахнам
Dialogue: 0,0:16:12.80,0:16:15.30,Default,,0,0,0,,Циллион Зевс финалы!
Dialogue: 0,0:16:24.52,0:16:26.94,Default,,0,0,0,,Anubis Go!
Dialogue: 0,0:16:32.24,0:16:33.95,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:16:34.20,0:16:36.70,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:16:38.91,0:16:40.04,Default,,0,0,0,,Анубис…
Dialogue: 0,0:16:40.24,0:16:42.91,Default,,0,0,0,,Циллион Зевстің жарылуы аяқталды!
Dialogue: 0,0:16:43.00,0:16:44.12,Default,,0,0,0,,4-2
Dialogue: 0,0:16:44.21,0:16:46.17,Default,,0,0,0,,Zack the Sunshine жеңеді!
Dialogue: 0,0:16:46.50,0:16:48.34,Default,,0,0,0,,Есеп айырысу!
Dialogue: 0,0:16:48.42,0:16:51.76,Default,,0,0,0,,Төрт ондық патша Зак өзінің күшін көрсетіп, жеңіске жетеді.
Dialogue: 0,0:16:52.97,0:16:54.26,Default,,0,0,0,,(♪ «Twinkle, Twinkle, Little Star» әніне варияциялар»)
Dialogue: 0,0:16:54.76,0:16:56.55,Default,,0,0,0,,Менің тапсырмам...
Dialogue: 0,0:16:57.34,0:17:00.35,Default,,0,0,0,,Ахкун
Dialogue: 0,0:17:00.43,0:17:02.02,Default,,0,0,0,,Зак~
Dialogue: 0,0:17:02.10,0:17:03.64,Default,,0,0,0,,Зак жеңді
Dialogue: 0,0:17:03.73,0:17:04.73,Default,,0,0,0,,Бұл шешілді.
Dialogue: 0,0:17:04.81,0:17:06.90,Default,,0,0,0,,Сіздің келесі қарсыласыңыз
Dialogue: 0,0:17:07.23,0:17:09.19,Default,,0,0,0,,Төрт өзгеріске ұшыраған екінші император ма?
Dialogue: 0,0:17:09.48,0:17:10.90,Default,,0,0,0,,Бізде жеңуден басқа амал жоқ.
Dialogue: 0,0:17:10.98,0:17:11.82,Default,,0,0,0,,О
Dialogue: 0,0:17:12.40,0:17:16.16,Default,,0,0,0,,Зак~ Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:17:16.61,0:17:17.91,Default,,0,0,0,,Киракира-кун
Dialogue: 0,0:17:18.45,0:17:19.99,Default,,0,0,0,,Стейннен алған жарақаттарым әлі толық жазылмағандықтан—
Dialogue: 0,0:17:20.49,0:17:21.87,Default,,0,0,0,,Сенпай
Dialogue: 0,0:17:24.58,0:17:26.00,Default,,0,0,0,,Бұл толық жеңіліс болды.
Dialogue: 0,0:17:26.08,0:17:29.59,Default,,0,0,0,,Сіз Зевсті бір рет жарып жібердіңіз.
Dialogue: 0,0:17:29.67,0:17:31.25,Default,,0,0,0,,Толық жеңіліс деп айтпас едім.
Dialogue: 0,0:17:31.38,0:17:32.25,Default,,0,0,0,,Жоқ
Dialogue: 0,0:17:32.34,0:17:34.17,Default,,0,0,0,,Ақыр аяғында
Dialogue: 0,0:17:34.34,0:17:36.84,Default,,0,0,0,,Мен саған тең келе алмадым.
Dialogue: 0,0:17:37.43,0:17:39.80,Default,,0,0,0,,Өйткені, Күн сәулесі Зак
Dialogue: 0,0:17:39.89,0:17:41.47,Default,,0,0,0,,Менің мәңгілік жұлдызым
Dialogue: 0,0:17:44.06,0:17:46.81,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:17:47.06,0:17:48.06,Default,,0,0,0,,Бұл — бір сәт бұрынғы Итадори ешқашан жасамайтын қимыл
Dialogue: 0,0:17:48.48,0:17:49.69,Default,,0,0,0,,Мені жеңесің бе?
Dialogue: 0,0:17:49.94,0:17:50.94,Default,,0,0,0,,Иә
Dialogue: 0,0:17:51.36,0:17:52.57,Default,,0,0,0,,Мен жеңілмеймін
Dialogue: 0,0:17:52.73,0:17:55.11,Default,,0,0,0,,Зак күн сәулесінің жарығы
Dialogue: 0,0:17:55.19,0:17:56.78,Default,,0,0,0,,Оны ешкім өшіре алмайды
Dialogue: 0,0:17:57.15,0:17:59.66,Default,,0,0,0,,Жарайсыңдар ұлдар мен қыздар
Dialogue: 0,0:17:59.74,0:18:01.74,Default,,0,0,0,,Ұлттық турнир жекелей жарыс
Dialogue: 0,0:18:01.83,0:18:04.83,Default,,0,0,0,,Үшінші раундтың барлық матч карталары аяқталды.
Dialogue: 0,0:18:05.58,0:18:06.33,Default,,0,0,0,,Келесі жолы -
Dialogue: 0,0:18:06.41,0:18:08.25,Default,,0,0,0,,Жартылай финалға арналған матч картасы
Dialogue: 0,0:18:08.33,0:18:09.88,Default,,0,0,0,,Бұл екі жиын
Dialogue: 0,0:18:09.96,0:18:12.29,Default,,0,0,0,,Жеңімпаз финалға өтеді.
Dialogue: 0,0:18:13.05,0:18:14.38,Default,,0,0,0,,Ұлдар мен қыздар
Dialogue: 0,0:18:14.46,0:18:17.30,Default,,0,0,0,,Бэй Аренада тағы кездесейік.
Dialogue: 0,0:18:17.42,0:18:18.38,Default,,0,0,0,,Кездескенше!
Dialogue: 0,0:18:20.26,0:18:22.35,Default,,0,0,0,,Біз тағы да жеңдік, әке.
Dialogue: 0,0:18:22.43,0:18:24.39,Default,,0,0,0,,Келесі жартылай финал.
Dialogue: 0,0:18:24.64,0:18:28.10,Default,,0,0,0,,Ой, алданып қалма, Балто.
Dialogue: 0,0:18:28.23,0:18:29.31,Default,,0,0,0,,Осыдан кейін
Dialogue: 0,0:18:29.39,0:18:32.77,Default,,0,0,0,,Мен бұрынғыдан да мұқият боламын.
Dialogue: 0,0:18:32.98,0:18:34.02,Default,,0,0,0,,Роджер!
Dialogue: 0,0:18:34.48,0:18:36.57,Default,,0,0,0,,Әкем қатал~
Dialogue: 0,0:18:36.82,0:18:40.03,Default,,0,0,0,,Әкем осыны айтқанда Балтоны ойлап отыр.
Dialogue: 0,0:18:40.32,0:18:43.20,Default,,0,0,0,,Балтодан басқаның барлығы төрт айналымнан тұратын император.
Dialogue: 0,0:18:43.28,0:18:46.45,Default,,0,0,0,,Бар күшіңізді салу арқылы жеңе алмайтын қарсыластар бар.
Dialogue: 0,0:18:46.87,0:18:49.12,Default,,0,0,0,,Әке, мен істеймін.
Dialogue: 0,0:18:49.21,0:18:50.46,Default,,0,0,0,,Сөзсіз жеңіңіз!
Dialogue: 0,0:18:50.83,0:18:51.71,Default,,0,0,0,,Ал сосын!
Dialogue: 0,0:18:51.79,0:18:55.38,Default,,0,0,0,,Осы уақытқа дейін жеткен соң, өзіңмен күресетін кез келді.
Dialogue: 0,0:18:55.67,0:18:57.05,Default,,0,0,0,,Өзіммен бе?
Dialogue: 0,0:18:57.13,0:18:59.30,Default,,0,0,0,,Өзіңе сеніп, соқтығыс
Dialogue: 0,0:18:59.38,0:19:00.80,Default,,0,0,0,,Жоғалмаңыз
Dialogue: 0,0:19:01.22,0:19:02.97,Default,,0,0,0,,Иә, түсінемін.
Dialogue: 0,0:19:03.64,0:19:05.35,Default,,0,0,0,,Сіз бүгін уағыздау режиміндесіз.
Dialogue: 0,0:19:05.64,0:19:08.85,Default,,0,0,0,,Кейде әкелік айту керек.
Dialogue: 0,0:19:08.93,0:19:10.06,Default,,0,0,0,,Мен аздап ұялшақпын
Dialogue: 0,0:19:10.14,0:19:10.81,Default,,0,0,0,,Иә
Dialogue: 0,0:19:11.27,0:19:12.56,Default,,0,0,0,,Мені итермеңіз
Dialogue: 0,0:19:12.65,0:19:15.15,Default,,0,0,0,,Сәттілік, тамаша бірдеңе айтып тұрсыз.
Dialogue: 0,0:19:15.40,0:19:16.73,Default,,0,0,0,,Сіз білдіңіз бе...
Dialogue: 0,0:19:16.82,0:19:18.86,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:19:19.40,0:19:20.90,Default,,0,0,0,,Шу~
Dialogue: 0,0:19:20.99,0:19:25.91,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:19:28.41,0:19:30.08,Default,,0,0,0,,Не болды? Бұл тәжірибе ме?
Dialogue: 0,0:19:30.21,0:19:31.25,Default,,0,0,0,,Жасайық
Dialogue: 0,0:19:31.33,0:19:33.63,Default,,0,0,0,,Жоқ, бұл тәжірибе емес.
Dialogue: 0,0:19:33.71,0:19:36.13,Default,,0,0,0,,Не? Сонда ше?
Dialogue: 0,0:19:36.42,0:19:38.21,Default,,0,0,0,,Біз осы уақытқа дейін жеттік.
Dialogue: 0,0:19:38.30,0:19:40.05,Default,,0,0,0,,Жартылай финал?
Dialogue: 0,0:19:40.13,0:19:41.68,Default,,0,0,0,,Жоқ, мен де.
Dialogue: 0,0:19:41.76,0:19:44.09,Default,,0,0,0,,Мен бара алатынымды білдім.
Dialogue: 0,0:19:44.43,0:19:46.76,Default,,0,0,0,,Шу маған тағы айтқанда,
Dialogue: 0,0:19:46.85,0:19:50.60,Default,,0,0,0,,Мен кенет осы уақытқа дейін жеткендей болдым.
Dialogue: 0,0:19:51.10,0:19:52.44,Default,,0,0,0,,Мен Луимен жеңдім
Dialogue: 0,0:19:52.52,0:19:53.98,Default,,0,0,0,,Сонымен, сіз де
Dialogue: 0,0:19:54.06,0:19:55.86,Default,,0,0,0,,Закты жеңіп, финалға өтіңіз
Dialogue: 0,0:19:56.73,0:19:58.65,Default,,0,0,0,,О, бұл уәде.
Dialogue: 0,0:20:00.57,0:20:02.61,Default,,0,0,0,,Менің айтқым келгені осы ғана
Dialogue: 0,0:20:03.36,0:20:06.58,Default,,0,0,0,,Бұл уәдені мен бұрын да бергенмін.
Dialogue: 0,0:20:06.87,0:20:08.41,Default,,0,0,0,,Аудандық конференцияның уақыты келді.
Dialogue: 0,0:20:08.74,0:20:11.37,Default,,0,0,0,,Жарайды! Жанып жатыр
Dialogue: 0,0:20:11.71,0:20:14.42,Default,,0,0,0,,Сол кезде берген уәдемді, Қайтадан шешем.
Dialogue: 0,0:20:15.50,0:20:17.46,Default,,0,0,0,,Шу Ореса
Dialogue: 0,0:20:17.92,0:20:19.88,Default,,0,0,0,,Бейблейд ойнағаныма қуаныштымын
Dialogue: 0,0:20:20.38,0:20:21.34,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:20:21.92,0:20:23.76,Default,,0,0,0,,Мен әртүрлі адамдармен таныстым.
Dialogue: 0,0:20:24.18,0:20:25.84,Default,,0,0,0,,Мен әртүрлі шайқастарға қатыстым.
Dialogue: 0,0:20:26.05,0:20:28.31,Default,,0,0,0,,Қызықты Бейблейд.
Dialogue: 0,0:20:28.81,0:20:30.43,Default,,0,0,0,,Ұлттық турнир ең жақсы
Dialogue: 0,0:20:30.97,0:20:31.73,Default,,0,0,0,,О
Dialogue: 0,0:20:33.31,0:20:34.27,Default,,0,0,0,,Барлығы
Dialogue: 0,0:20:34.35,0:20:36.81,Default,,0,0,0,,Мен осы серіктеспен бірге күресіп жүрмін.
Dialogue: 0,0:20:36.90,0:20:38.77,Default,,0,0,0,,А... жарайды
Dialogue: 0,0:20:38.86,0:20:40.65,Default,,0,0,0,,Финалда кездесуге уәде беріңіз
Dialogue: 0,0:20:40.73,0:20:41.90,Default,,0,0,0,,Бұғатта да жасайық.
Dialogue: 0,0:20:42.61,0:20:43.70,Default,,0,0,0,,шығанақта?
Dialogue: 0,0:20:43.78,0:20:46.78,Default,,0,0,0,,Қол алысу сияқты.
Dialogue: 0,0:20:47.16,0:20:51.16,Default,,0,0,0,,А... Мен жаттығу жасамаймын, сондықтан ештеңе әкелген жоқпын.
Dialogue: 0,0:20:51.37,0:20:52.33,Default,,0,0,0,,Жоқ
Dialogue: 0,0:20:52.41,0:20:54.21,Default,,0,0,0,,Олай болса орындайық.
Dialogue: 0,0:20:54.29,0:20:55.67,Default,,0,0,0,,Біздің уәдеміз
Dialogue: 0,0:20:55.87,0:20:58.17,Default,,0,0,0,,Спригган және Валькири
Dialogue: 0,0:21:01.09,0:21:03.26,Default,,0,0,0,,Қараңдар, мен әкелдім.
Dialogue: 0,0:21:03.34,0:21:06.59,Default,,0,0,0,,Кеттік! Алға барайық және сәйкестендірейік
Dialogue: 0,0:21:06.68,0:21:07.97,Default,,0,0,0,,Мен жеңемін
Dialogue: 0,0:21:10.18,0:21:11.43,Default,,0,0,0,,Біз жеңеміз!
Dialogue: 0,0:21:11.52,0:21:12.98,Default,,0,0,0,,(Шығанақтың соғу дыбысы)
Dialogue: 0,0:21:13.14,0:21:14.39,Default,,0,0,0,,Хехе
Dialogue: 0,0:21:15.10,0:21:17.56,Default,,0,0,0,,Мен Луиге қарсы жеңгім келеді
Dialogue: 0,0:21:17.65,0:21:19.02,Default,,0,0,0,,Осы сприганмен
Dialogue: 0,0:21:21.15,0:21:23.03,Default,,0,0,0,,Сіз және Валькири сияқты
Dialogue: 0,0:21:23.44,0:21:26.41,Default,,0,0,0,,Мен бұл Спригганмен көптен бері күресіп келемін.
Dialogue: 0,0:21:26.49,0:21:27.78,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:21:27.91,0:21:29.53,Default,,0,0,0,,Луи мен Лонгинусқа қарсы шығу
Dialogue: 0,0:21:29.66,0:21:30.53,Default,,0,0,0,,Жоғалған
Dialogue: 0,0:21:30.66,0:21:32.41,Default,,0,0,0,,Сен Луиді жеңгенде
Dialogue: 0,0:21:32.49,0:21:35.71,Default,,0,0,0,,Бұл шынымен де осы сприган болуы керек.
Dialogue: 0,0:21:38.38,0:21:40.71,Default,,0,0,0,,Мен бұл сезімді түсінемін.
Dialogue: 0,0:21:41.17,0:21:43.59,Default,,0,0,0,,Шу Руиді жеңу.
Dialogue: 0,0:21:43.92,0:21:45.63,Default,,0,0,0,,Мен де Закты ұрдым
Dialogue: 0,0:21:45.72,0:21:48.64,Default,,0,0,0,,Олай болса финалда сайысайық.
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.32,0:23:28.44,Default,,0,0,0,,Закпен мәселені шешетін кез келді.
Dialogue: 0,0:23:28.53,0:23:30.70,Default,,0,0,0,,Менің жылтырлығым және Зактың жылтырлығы
Dialogue: 0,0:23:30.82,0:23:32.82,Default,,0,0,0,,Қайсысы жарқырайды?
Dialogue: 0,0:23:32.91,0:23:33.82,Default,,0,0,0,,Бұл таң қалдырады
Dialogue: 0,0:23:33.91,0:23:35.83,Default,,0,0,0,,Көзіңді жұмба
Dialogue: 0,0:23:35.91,0:23:38.58,Default,,0,0,0,,Ал Луи мен Шу арасындағы шайқас басталады.
Dialogue: 0,0:23:38.66,0:23:41.33,Default,,0,0,0,,Баршаңыз, таң қалмаңыздар
Dialogue: 0,0:23:41.67,0:23:43.63,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:43.75,0:23:45.71,Default,,0,0,0,,Бакутен В.С.Бакусу
Dialogue: 0,0:23:45.79,0:23:47.71,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.80,0:23:49.30,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.80,0:23:56.80,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory