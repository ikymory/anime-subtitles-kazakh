Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.71,0:00:09.13,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.21,0:00:12.47,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.80,0:00:14.76,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:17.01,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.10,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.60,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.31,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.40,0:00:28.69,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:31.32,0:00:32.86,Default,,0,0,0,,Жарайды
Dialogue: 0,0:00:32.94,0:00:34.90,Default,,0,0,0,,Ұлдар мен қыздар
Dialogue: 0,0:00:35.11,0:00:36.99,Default,,0,0,0,,Ұлттық турнирдің командалық жарысы да -
Dialogue: 0,0:00:37.07,0:00:39.28,Default,,0,0,0,,Екінші турға қатысу!
Dialogue: 0,0:00:40.62,0:00:42.87,Default,,0,0,0,,Йонекома Гакуэн шығанағы клубы
Dialogue: 0,0:00:42.95,0:00:46.88,Default,,0,0,0,,Қылыш жалынына қарсы!
Dialogue: 0,0:00:46.96,0:00:48.04,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:00:50.17,0:00:52.55,Default,,0,0,0,,Қызыл бұрыш Йонекома Гакуэн шығанағы клубы
Dialogue: 0,0:00:52.63,0:00:53.97,Default,,0,0,0,,Ойыншылар кіреді!
Dialogue: 0,0:00:54.26,0:00:58.68,Default,,0,0,0,,Ғажайып бала Бұл Аои Балт басқаратын ұлттық деңгейдегі жүзгіштер!
Dialogue: 0,0:00:59.30,0:01:02.22,Default,,0,0,0,,Ал көк бұрыш Қылыш оттары!
Dialogue: 0,0:01:02.31,0:01:05.44,Default,,0,0,0,,Құмарлы адам Кайза Жанып тұрған храм басқарады
Dialogue: 0,0:01:05.52,0:01:07.69,Default,,0,0,0,,Жауынгерлік топ кіріп келеді!
Dialogue: 0,0:01:08.06,0:01:11.02,Default,,0,0,0,,Өте әсерлі~ Қылыш оттары
Dialogue: 0,0:01:11.11,0:01:12.98,Default,,0,0,0,,Әй, қолыңнан келгеннің бәрін жаса!
Dialogue: 0,0:01:13.07,0:01:14.82,Default,,0,0,0,,Амансың ба, Балто?
Dialogue: 0,0:01:14.90,0:01:17.78,Default,,0,0,0,,Өткен күні тұзды матчта жеңіліп қалдым.
Dialogue: 0,0:01:17.95,0:01:19.74,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:01:20.41,0:01:22.41,Default,,0,0,0,,Кеше де түннің бір уағына дейін-
Dialogue: 0,0:01:22.49,0:01:24.62,Default,,0,0,0,,Мен көптен бері стратегияны ойлап жүрдім.
Dialogue: 0,0:01:25.79,0:01:29.54,Default,,0,0,0,,
Dialogue: 0,0:01:29.96,0:01:32.84,Default,,0,0,0,,Бүгін Бал-ниидің жеңісі екені сөзсіз.
Dialogue: 0,0:01:32.92,0:01:33.96,Default,,0,0,0,,Иә!
Dialogue: 0,0:01:41.76,0:01:44.14,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:44.47,0:01:49.65,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:02:00.95,0:02:04.33,Default,,0,0,0,,Барлығында бар екеніне сенімдімін.
Dialogue: 0,0:02:04.83,0:02:06.96,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:02:07.37,0:02:11.50,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:02:11.63,0:02:14.84,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:02:14.96,0:02:21.39,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:21.68,0:02:26.10,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:26.60,0:02:32.02,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:32.15,0:02:34.40,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:34.48,0:02:39.20,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:39.36,0:02:44.45,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:44.74,0:02:47.00,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:47.20,0:02:49.54,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:49.83,0:02:53.75,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:53.92,0:02:58.92,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:59.13,0:03:01.30,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:03:05.18,0:03:07.77,Default,,0,0,0,,Жарылғыш жалын! Екі есе әсер!
Dialogue: 0,0:03:09.18,0:03:11.73,Default,,0,0,0,,Жарайды, 5 пышақтан
Dialogue: 0,0:03:11.81,0:03:14.02,Default,,0,0,0,,Қатысу үшін үш адамды таңдаңыз!
Dialogue: 0,0:03:14.11,0:03:15.94,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:03:16.02,0:03:18.82,Default,,0,0,0,,Барт жоқ, иә?
Dialogue: 0,0:03:18.90,0:03:19.94,Default,,0,0,0,,Эй!
Dialogue: 0,0:03:20.03,0:03:22.24,Default,,0,0,0,,Сіз ұмытып кеткеніңізге сенімдімін, солай ма?
Dialogue: 0,0:03:22.32,0:03:23.57,Default,,0,0,0,,Алдыңғы сәйкестік-
Dialogue: 0,0:03:23.91,0:03:28.16,Default,,0,0,0,,«Мен бірінші боламын!» «Жеңіп, командаға серпін беріңіз».
Dialogue: 0,0:03:28.24,0:03:31.37,Default,,0,0,0,,Және т.б., нәтиже толық жоғалту.
Dialogue: 0,0:03:31.46,0:03:33.21,Default,,0,0,0,,Егер мен оны қайтарып алмасам...
Dialogue: 0,0:03:33.29,0:03:35.17,Default,,0,0,0,,Осымен аяқталды.
Dialogue: 0,0:03:35.84,0:03:38.09,Default,,0,0,0,,Сіз тағы да сол әрекетті қайталайсыз ба?
Dialogue: 0,0:03:38.38,0:03:40.47,Default,,0,0,0,,Сіз бұлай айтпайсыз.
Dialogue: 0,0:03:40.55,0:03:41.84,Default,,0,0,0,,Барлығы сәтсіздікке ұшырайды...
Dialogue: 0,0:03:41.93,0:03:43.80,Default,,0,0,0,,Егер сәтсіздікке ұшырасаңыз, ол сонда аяқталады.
Dialogue: 0,0:03:43.97,0:03:45.68,Default,,0,0,0,,Міне, бәсекелестік әлемі!
Dialogue: 0,0:03:45.76,0:03:46.76,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:03:46.85,0:03:47.93,Default,,0,0,0,,Бізді жай ғана адастырды!
Dialogue: 0,0:03:48.10,0:03:49.10,Default,,0,0,0,,Балто!
Dialogue: 0,0:03:49.35,0:03:50.60,Default,,0,0,0,,Ойыншыны таңдау-
Dialogue: 0,0:03:50.68,0:03:52.31,Default,,0,0,0,,Қабілеттердің үйлесімділігі
Dialogue: 0,0:03:52.39,0:03:55.31,Default,,0,0,0,,Тұлғаны жан-жақты бағалау
Dialogue: 0,0:03:59.44,0:04:02.40,Default,,0,0,0,,Әй, рұқсатсыз не істеп жатырсың?
Dialogue: 0,0:04:02.70,0:04:04.78,Default,,0,0,0,,Жан-жақты пайымдау және
Dialogue: 0,0:04:05.03,0:04:06.57,Default,,0,0,0,,Екінші жағы, бәлкім...
Dialogue: 0,0:04:06.66,0:04:08.70,Default,,0,0,0,,Шаканы және сол жігіттерді шығарыңыз!
Dialogue: 0,0:04:08.79,0:04:09.87,Default,,0,0,0,,Жарайды
Dialogue: 0,0:04:09.95,0:04:12.83,Default,,0,0,0,,Үш жүзі де пайда болған сияқты!
Dialogue: 0,0:04:13.16,0:04:16.21,Default,,0,0,0,,Қызыл бұрыш Йонекома Гакуэн шығанағы клубы
Dialogue: 0,0:04:16.75,0:04:18.21,Default,,0,0,0,,Комурасаки Вакия
Dialogue: 0,0:04:18.50,0:04:20.05,Default,,0,0,0,,Қара Құдай Дина
Dialogue: 0,0:04:20.38,0:04:21.92,Default,,0,0,0,,Бенишу
Dialogue: 0,0:04:22.01,0:04:23.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:23.17,0:04:24.97,Default,,0,0,0,,Бал-нии келмей ме?
Dialogue: 0,0:04:25.39,0:04:28.10,Default,,0,0,0,,Көк бұрыштық қылыштың жалындары
Dialogue: 0,0:04:28.68,0:04:30.22,Default,,0,0,0,,Жанып тұрған ғибадатхана Кайза
Dialogue: 0,0:04:30.68,0:04:32.18,Default,,0,0,0,,Нансуи Юго
Dialogue: 0,0:04:32.52,0:04:34.06,Default,,0,0,0,,Бұл Юкифуки Укио!
Dialogue: 0,0:04:34.35,0:04:35.65,Default,,0,0,0,,Қараңдар!
Dialogue: 0,0:04:35.73,0:04:37.06,Default,,0,0,0,,Бұл күткендей емес пе?
Dialogue: 0,0:04:37.52,0:04:39.69,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:04:39.77,0:04:41.32,Default,,0,0,0,,Сәлем! капитан!
Dialogue: 0,0:04:41.40,0:04:43.82,Default,,0,0,0,,Мен неге тағы да кеттім?
Dialogue: 0,0:04:44.03,0:04:45.41,Default,,0,0,0,,Өйткені Уакия...
Dialogue: 0,0:04:45.49,0:04:47.03,Default,,0,0,0,,Уакияға не болды!
Dialogue: 0,0:04:47.12,0:04:48.74,Default,,0,0,0,,Осыны айта бер...
Dialogue: 0,0:04:48.83,0:04:50.70,Default,,0,0,0,,Әй, көңілің қалмады ма?
Dialogue: 0,0:04:50.79,0:04:52.20,Default,,0,0,0,,Бұл көңілсіз...
Dialogue: 0,0:04:52.62,0:04:53.96,Default,,0,0,0,,Сонымен, бұл жолы
Dialogue: 0,0:04:54.04,0:04:55.96,Default,,0,0,0,,Мен стратегияны дұрыс ойладым!
Dialogue: 0,0:04:56.33,0:04:58.88,Default,,0,0,0,,О, ғажап емес пе?
Dialogue: 0,0:04:58.96,0:05:01.25,Default,,0,0,0,,Бұл жолы пайдалы болады!
Dialogue: 0,0:05:01.55,0:05:02.55,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:05:02.63,0:05:03.80,Default,,0,0,0,,Өте жақсы шешіңіз-
Dialogue: 0,0:05:03.88,0:05:05.63,Default,,0,0,0,,Уакияға бір көз жүгіртейік!
Dialogue: 0,0:05:06.05,0:05:07.18,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:05:07.89,0:05:09.18,Default,,0,0,0,,Барлығың тыңдаңдар.
Dialogue: 0,0:05:09.26,0:05:10.10,Default,,0,0,0,,Фалько…
Dialogue: 0,0:05:10.18,0:05:12.97,Default,,0,0,0,,Шақамен және басқалармен бірге ойлап тапқан стратегиямды айтып беремін.
Dialogue: 0,0:05:13.22,0:05:14.27,Default,,0,0,0,,Стратегия...?
Dialogue: 0,0:05:14.64,0:05:16.89,Default,,0,0,0,,Бұл керемет, капитаным.
Dialogue: 0,0:05:16.98,0:05:19.69,Default,,0,0,0,,Қара, Балто, тез көрсетші.
Dialogue: 0,0:05:20.02,0:05:21.40,Default,,0,0,0,,Міне!
Dialogue: 0,0:05:23.65,0:05:24.90,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:25.07,0:05:26.45,Default,,0,0,0,,Бұл адам...?
Dialogue: 0,0:05:26.53,0:05:27.74,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:05:28.07,0:05:29.53,Default,,0,0,0,,Бұл Шака~
Dialogue: 0,0:05:29.62,0:05:31.70,Default,,0,0,0,,Шақа шынында да мықты екен ғой?
Dialogue: 0,0:05:31.78,0:05:34.50,Default,,0,0,0,,Сондықтан мен міндетті түрде соңғы болып шығамын!
Dialogue: 0,0:05:34.83,0:05:36.12,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:05:36.21,0:05:37.37,Default,,0,0,0,,Бұл стратегия ма?
Dialogue: 0,0:05:37.46,0:05:40.84,Default,,0,0,0,,Ах! Соңғы бастық әрқашан соңында пайда болады.
Dialogue: 0,0:05:41.13,0:05:42.17,Default,,0,0,0,,Шака да солай
Dialogue: 0,0:05:42.25,0:05:43.80,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:05:43.88,0:05:46.22,Default,,0,0,0,,3 ұпайлық алдын ала таңдау жүйесі
Dialogue: 0,0:05:46.30,0:05:49.43,Default,,0,0,0,,Алғашқы екі ойыншы 3 ұпай жинаса
Dialogue: 0,0:05:49.51,0:05:51.72,Default,,0,0,0,,Үшінші адам: Ұрыспасам да, жарайды!
Dialogue: 0,0:05:51.80,0:05:52.89,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:05:52.97,0:05:53.68,Default,,0,0,0,,Ах
Dialogue: 0,0:05:53.93,0:05:56.14,Default,,0,0,0,,Иә? сурет? сурет?
Dialogue: 0,0:05:56.35,0:05:59.52,Default,,0,0,0,,Әдетте, күштілері бірінші келеді.
Dialogue: 0,0:05:59.60,0:06:01.15,Default,,0,0,0,,Тиісті ережелер-
Dialogue: 0,0:06:01.23,0:06:02.61,Default,,0,0,0,,Түсінгеннен кейін!
Dialogue: 0,0:06:02.69,0:06:03.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:03.86,0:06:07.78,Default,,0,0,0,,Менің капитаным ережені де білмейді ме?
Dialogue: 0,0:06:11.28,0:06:12.70,Default,,0,0,0,,Бірінші пышақ
Dialogue: 0,0:06:12.78,0:06:13.91,Default,,0,0,0,,Алға шық
Dialogue: 0,0:06:14.29,0:06:17.00,Default,,0,0,0,,Екінші жақтағы бірінші ойыншы сөзсіз Шака.
Dialogue: 0,0:06:17.08,0:06:20.42,Default,,0,0,0,,Ал сіз бұрын не істегеніңізді көрдіңіз.
Dialogue: 0,0:06:20.63,0:06:21.13,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:21.21,0:06:23.80,Default,,0,0,0,,Бұл туралы уайымдаудың қажеті жоқ - бұл Бейдің қабілеті.
Dialogue: 0,0:06:23.88,0:06:26.92,Default,,0,0,0,,Үйлесімділік Тұлғаны жан-жақты қарастырсаңыз
Dialogue: 0,0:06:27.01,0:06:27.63,Default,,0,0,0,,Уф
Dialogue: 0,0:06:27.72,0:06:28.88,Default,,0,0,0,,Балто~
Dialogue: 0,0:06:28.97,0:06:32.14,Default,,0,0,0,,Бұл бірінші нөмір! (Барлығы)...
Dialogue: 0,0:06:34.35,0:06:36.14,Default,,0,0,0,,Бұл сен бе?
Dialogue: 0,0:06:36.22,0:06:37.60,Default,,0,0,0,,Комурасаки Вакия!
Dialogue: 0,0:06:37.85,0:06:39.52,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:06:39.60,0:06:41.44,Default,,0,0,0,,Жанып жатқан Кайза храмы!
Dialogue: 0,0:06:42.11,0:06:44.98,Default,,0,0,0,,Мен бірінші рет осылай төбелесіп тұрмын.
Dialogue: 0,0:06:45.07,0:06:47.90,Default,,0,0,0,,Мен сенімен шайқаста күттім!
Dialogue: 0,0:06:47.99,0:06:49.15,Default,,0,0,0,,Гахахаха
Dialogue: 0,0:06:49.82,0:06:52.32,Default,,0,0,0,,Бейблейдтің төрт императорының бірі
Dialogue: 0,0:06:52.41,0:06:54.49,Default,,0,0,0,,Менің осы жерден жоғары көтерілуім үшін...
Dialogue: 0,0:06:54.58,0:06:56.12,Default,,0,0,0,,Жеңілуге жаман қарсылас
Dialogue: 0,0:06:56.49,0:06:59.21,Default,,0,0,0,,Киракира-кун бүгін көрінбейді.
Dialogue: 0,0:06:59.54,0:07:01.17,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:07:01.33,0:07:03.92,Default,,0,0,0,,Менің ойымша, Вакияның айналасындағы адамдар бұған қарсы болды.
Dialogue: 0,0:07:04.46,0:07:05.80,Default,,0,0,0,,Алдыңғы сәйкестік-
Dialogue: 0,0:07:05.88,0:07:07.51,Default,,0,0,0,,Өйткені мен қатты жеңілдім.
Dialogue: 0,0:07:07.59,0:07:08.88,Default,,0,0,0,,Haha~n
Dialogue: 0,0:07:08.97,0:07:10.63,Default,,0,0,0,,Бейшара.
Dialogue: 0,0:07:10.72,0:07:13.22,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:07:13.30,0:07:14.80,Default,,0,0,0,,Сабыр ет, Кумичо.
Dialogue: 0,0:07:15.14,0:07:18.68,Default,,0,0,0,,Балтқа капитан бол деп айтқан да сол еді.
Dialogue: 0,0:07:18.77,0:07:21.89,Default,,0,0,0,,Бірақ соңында бәрін өзіңіз шешесіз, солай ма?
Dialogue: 0,0:07:22.19,0:07:24.98,Default,,0,0,0,,Комурасакиді айту қиын.
Dialogue: 0,0:07:25.27,0:07:27.40,Default,,0,0,0,,Бірақ мен қате айтқан жоқпын.
Dialogue: 0,0:07:27.53,0:07:28.44,Default,,0,0,0,,Ах
Dialogue: 0,0:07:28.57,0:07:30.61,Default,,0,0,0,,Excalibur – шабуыл түрі
Dialogue: 0,0:07:30.82,0:07:32.95,Default,,0,0,0,,Вайверн ең тиімдісі болып табылады
Dialogue: 0,0:07:33.20,0:07:34.12,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:34.20,0:07:35.28,Default,,0,0,0,,А...
Dialogue: 0,0:07:35.70,0:07:37.45,Default,,0,0,0,,Екеуің де өзгеріңдер.
Dialogue: 0,0:07:37.83,0:07:39.16,Default,,0,0,0,,Шайқас басталады
Dialogue: 0,0:07:42.46,0:07:43.92,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:07:46.25,0:07:47.67,Default,,0,0,0,,(тозған дыбыс)
Dialogue: 0,0:07:55.39,0:07:58.14,Default,,0,0,0,,Не... оның көзі...
Dialogue: 0,0:07:58.39,0:08:00.27,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:08:00.48,0:08:03.98,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:08:04.06,0:08:06.31,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:08:06.40,0:08:07.23,Default,,0,0,0,,Иә
Dialogue: 0,0:08:07.44,0:08:09.53,Default,,0,0,0,,Енді шығанақ босатылды.
Dialogue: 0,0:08:09.61,0:08:10.78,Default,,0,0,0,,Жабайы Вайверн
Dialogue: 0,0:08:10.86,0:08:13.61,Default,,0,0,0,,Орталықты алу үшін қалқан атуын пайдаланыңыз!
Dialogue: 0,0:08:13.91,0:08:16.12,Default,,0,0,0,,Қабыл ал! Экскалибур!
Dialogue: 0,0:08:16.49,0:08:17.95,Default,,0,0,0,,Керемет жылдамдықпен
Dialogue: 0,0:08:18.03,0:08:21.04,Default,,0,0,0,,Бірінші байланыс, Ксено Экскалибур!
Dialogue: 0,0:08:21.12,0:08:23.16,Default,,0,0,0,,Келесі соққы соңы болады!
Dialogue: 0,0:08:23.25,0:08:26.50,Default,,0,0,0,,Өкінішті, бұл күштің бәрі жойылды!
Dialogue: 0,0:08:26.58,0:08:27.21,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:08:27.79,0:08:30.42,Default,,0,0,0,,Виверн Қарсыластың шабуыл күшін қуатқа айналдырады.
Dialogue: 0,0:08:30.51,0:08:31.59,Default,,0,0,0,,Шабуыл!
Dialogue: 0,0:08:31.67,0:08:32.63,Default,,0,0,0,,(Лэйди тауы) Хмм? Не айтқың келеді?
Dialogue: 0,0:08:33.09,0:08:34.55,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,0:08:34.63,0:08:35.64,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:38.43,0:08:40.47,Default,,0,0,0,,Виверннің дыбысы өзгерді.
Dialogue: 0,0:08:40.68,0:08:42.18,Default,,0,0,0,,Экскалибурдың шабуылы
Dialogue: 0,0:08:42.27,0:08:44.44,Default,,0,0,0,,Вайверн есептегішпен күреседі!
Dialogue: 0,0:08:44.69,0:08:47.31,Default,,0,0,0,,Онда! Иә! иә!
Dialogue: 0,0:08:47.69,0:08:50.15,Default,,0,0,0,,Мен жай ғана күш іздедім...
Dialogue: 0,0:08:50.23,0:08:51.40,Default,,0,0,0,,Бұл дыбыс емес
Dialogue: 0,0:08:51.69,0:08:52.82,Default,,0,0,0,,Бұл жігіт қазір
Dialogue: 0,0:08:53.40,0:08:54.90,Default,,0,0,0,,Шығанақтан ләззат алу
Dialogue: 0,0:08:55.32,0:08:57.20,Default,,0,0,0,,Оған Барт Аои әсер етті ме?
Dialogue: 0,0:08:57.28,0:08:58.62,Default,,0,0,0,,Жалғыз болу қиын ғой, иә?
Dialogue: 0,0:08:58.70,0:09:01.99,Default,,0,0,0,,Орочидің құлақтары өте жақсы, солай ма?
Dialogue: 0,0:09:04.50,0:09:05.50,Default,,0,0,0,,Уф
Dialogue: 0,0:09:07.79,0:09:08.96,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:09:09.21,0:09:11.13,Default,,0,0,0,,Керемет! Барайық!
Dialogue: 0,0:09:11.21,0:09:13.51,Default,,0,0,0,,Ах, Экскалибурдың уақыты келді...
Dialogue: 0,0:09:13.59,0:09:15.05,Default,,0,0,0,,Ол шыдамсыз болуы керек.
Dialogue: 0,0:09:15.13,0:09:16.43,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:09:16.88,0:09:19.30,Default,,0,0,0,,Өйткені, Уакия керемет~
Dialogue: 0,0:09:19.39,0:09:22.52,Default,,0,0,0,,Excalibur жарылуға жақын
Dialogue: 0,0:09:23.35,0:09:26.23,Default,,0,0,0,,Экскалибур мен Вайверн қатты қақтығысады
Dialogue: 0,0:09:26.31,0:09:28.77,Default,,0,0,0,,Ол қанша уақытқа созылады?
Dialogue: 0,0:09:30.77,0:09:32.28,Default,,0,0,0,,Мен түсіндім
Dialogue: 0,0:09:32.36,0:09:34.49,Default,,0,0,0,,Алып өтіңіз! Вайверн!
Dialogue: 0,0:09:40.99,0:09:41.99,Default,,0,0,0,,Қайтадан жалғастырылды
Dialogue: 0,0:09:43.04,0:09:45.12,Default,,0,0,0,,Excalibur
Dialogue: 0,0:09:55.05,0:09:57.34,Default,,0,0,0,,Екі есе әсер ету!
Dialogue: 0,0:10:00.93,0:10:02.26,Default,,0,0,0,,(Айдаһардың айқайы)
Dialogue: 0,0:10:02.35,0:10:03.64,Default,,0,0,0,,(жарылған дыбыс)
Dialogue: 0,0:10:03.81,0:10:04.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:05.06,0:10:06.31,Default,,0,0,0,,Қосарлы әсер ету\NXeno Excalibur Burst Finish үшін
Dialogue: 0,0:10:07.35,0:10:08.94,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:10:09.35,0:10:10.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:10.48,0:10:11.19,Default,,0,0,0,,Ха
Dialogue: 0,0:10:11.27,0:10:12.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:12.32,0:10:15.78,Default,,0,0,0,,2 ұпай
Dialogue: 0,0:10:15.86,0:10:18.36,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:10:18.45,0:10:21.82,Default,,0,0,0,,Бұл Экскалибурдың жаңа ерекше қадамы ма?
Dialogue: 0,0:10:21.91,0:10:24.95,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:10:25.29,0:10:28.41,Default,,0,0,0,,Шака Бұл өте жақсы қадам болды.
Dialogue: 0,0:10:28.50,0:10:31.83,Default,,0,0,0,,Бейдің қарсылас шабуыл жасағанда жарылуы үшін -
Dialogue: 0,0:10:32.25,0:10:35.09,Default,,0,0,0,,Диск құлпы 4 рет алға жылжуы керек
Dialogue: 0,0:10:36.71,0:10:40.80,Default,,0,0,0,,Дәл қазір шабуыл екі құлыпты алға жылжытуы мүмкін.
Dialogue: 0,0:10:40.89,0:10:44.51,Default,,0,0,0,,Қабат қылышының ұшы және Magnum дискінің шабуыл бөлігі
Dialogue: 0,0:10:44.60,0:10:46.06,Default,,0,0,0,,Олар жай ғана қабаттасады.
Dialogue: 0,0:10:46.72,0:10:48.10,Default,,0,0,0,,Нару Ходо
Dialogue: 0,0:10:48.18,0:10:51.35,Default,,0,0,0,,Екі шабуыл нүктесі бір нүктеде шоғырланған.
Dialogue: 0,0:10:51.69,0:10:53.11,Default,,0,0,0,,Қосарлы әсер ету
Dialogue: 0,0:10:53.31,0:10:55.07,Default,,0,0,0,,Бұл сізді күштірек етеді
Dialogue: 0,0:10:55.52,0:10:58.44,Default,,0,0,0,,Қарғыс атсын, олар да сондай қызмет етсе ғой.
Dialogue: 0,0:10:58.53,0:11:01.11,Default,,0,0,0,,А, бұл күтпеген жағдай болды.
Dialogue: 0,0:11:01.82,0:11:05.95,Default,,0,0,0,,Мен Double Impact-ті мұнша тез пайдаланамын деп ойламадым.
Dialogue: 0,0:11:06.12,0:11:06.91,Default,,0,0,0,,Түсінікті!
Dialogue: 0,0:11:08.00,0:11:09.54,Default,,0,0,0,,Құт
Dialogue: 0,0:11:09.87,0:11:11.42,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:11:11.54,0:11:12.12,Default,,0,0,0,,А…?
Dialogue: 0,0:11:13.67,0:11:14.96,Default,,0,0,0,,Аняр
Dialogue: 0,0:11:15.13,0:11:16.80,Default,,0,0,0,,Мен де барамын~
Dialogue: 0,0:11:16.88,0:11:18.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:18.09,0:11:19.17,Default,,0,0,0,,《Қорқпа. Дем ал.》
Dialogue: 0,0:11:19.26,0:11:22.39,Default,,0,0,0,,Бұл! бұл! Бар дерлік-
Dialogue: 0,0:11:22.47,0:11:23.64,Default,,0,0,0,,Бар!
Dialogue: 0,0:11:23.72,0:11:25.01,Default,,0,0,0,,Шақаны жеңе алдың.
Dialogue: 0,0:11:25.10,0:11:27.26,Default,,0,0,0,,Вакия! Сен не істеп жатырсың!
Dialogue: 0,0:11:27.97,0:11:29.23,Default,,0,0,0,,Қайсысы да!
Dialogue: 0,0:11:29.31,0:11:32.02,Default,,0,0,0,,Шулы! Маған маңызды емес
Dialogue: 0,0:11:32.23,0:11:35.15,Default,,0,0,0,,Ах! Командалық матчта мұны айта аласыз ба?
Dialogue: 0,0:11:35.23,0:11:38.28,Default,,0,0,0,,Айтайын дегенім, рұқсатсыз көшеге шықпа.
Dialogue: 0,0:11:38.57,0:11:41.82,Default,,0,0,0,,Мен бір рет те жарысқан емеспін және мені біртүрлі екенімді ешкім айтқан жоқ.
Dialogue: 0,0:11:41.95,0:11:42.78,Default,,0,0,0,,Не~!
Dialogue: 0,0:11:42.86,0:11:43.99,Default,,0,0,0,,Уакия~
Dialogue: 0,0:11:45.20,0:11:46.78,Default,,0,0,0,,Дәретхана болды~
Dialogue: 0,0:11:46.87,0:11:47.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:47.91,0:11:50.04,Default,,0,0,0,,Ең жақын дәретхана осы жолмен.
Dialogue: 0,0:11:50.12,0:11:53.33,Default,,0,0,0,,Сіз не айтып тұрсыз? Мен дәретханаға барамын! иә...?
Dialogue: 0,0:11:53.42,0:11:55.33,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:11:56.04,0:11:57.46,Default,,0,0,0,,Не?
Dialogue: 0,0:11:57.55,0:12:01.38,Default,,0,0,0,,Маған дәл қазір шайқас қатты әсер етті.
Dialogue: 0,0:12:01.47,0:12:02.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:02.26,0:12:05.18,Default,,0,0,0,,Мен де жеңілгенімізге қатты ренжідім.
Dialogue: 0,0:12:05.26,0:12:08.26,Default,,0,0,0,,Бірақ олар Шақаны сонша итеріп жіберді.
Dialogue: 0,0:12:08.72,0:12:11.10,Default,,0,0,0,,Вакия керемет
Dialogue: 0,0:12:11.18,0:12:13.48,Default,,0,0,0,,Мен де солай шайқасқым келеді.
Dialogue: 0,0:12:13.89,0:12:14.85,Default,,0,0,0,,♬~
Dialogue: 0,0:12:14.94,0:12:18.02,Default,,0,0,0,,Иә! Енді осы жерде соғысайық
Dialogue: 0,0:12:18.11,0:12:19.23,Default,,0,0,0,,Сонымен ойын қосылды!
Dialogue: 0,0:12:19.32,0:12:21.82,Default,,0,0,0,,Аа, дұрыс, асығуымыз керек.
Dialogue: 0,0:12:22.86,0:12:26.20,Default,,0,0,0,,Ия, мен де...дәретхана~
Dialogue: 0,0:12:26.28,0:12:28.24,Default,,0,0,0,,Ах...
Dialogue: 0,0:12:28.45,0:12:29.62,Default,,0,0,0,,Хмф!
Dialogue: 0,0:12:30.08,0:12:31.50,Default,,0,0,0,,Қалған қарсыластар:
Dialogue: 0,0:12:31.58,0:12:33.66,Default,,0,0,0,,Укио Юкифуки және Юго Нансуи
Dialogue: 0,0:12:34.25,0:12:36.13,Default,,0,0,0,,Қорғаныс түрі бір мүйізді және...
Dialogue: 0,0:12:36.21,0:12:38.29,Default,,0,0,0,,Бұл Yggdrasil төзімділік түрі.
Dialogue: 0,0:12:38.38,0:12:40.71,Default,,0,0,0,,Мінезі бойынша, менің ойымша, бұл Юго.
Dialogue: 0,0:12:40.80,0:12:42.13,Default,,0,0,0,,Укиомен салыстырғанда
Dialogue: 0,0:12:42.21,0:12:44.26,Default,,0,0,0,,Оның мінезі қысқа, оған берілу қиын.
Dialogue: 0,0:12:44.34,0:12:45.22,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:12:45.30,0:12:48.60,Default,,0,0,0,,Матч алдында Нансуи әрқашан рухын жинай бастайды.
Dialogue: 0,0:12:48.68,0:12:49.72,Default,,0,0,0,,Артына қараңыз
Dialogue: 0,0:12:52.22,0:12:53.23,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:12:53.31,0:12:55.39,Default,,0,0,0,,О, енді не болады...
Dialogue: 0,0:12:55.48,0:12:56.90,Default,,0,0,0,,Бұл жалғыз мүйізді қар ұшқыны.
Dialogue: 0,0:12:57.19,0:13:00.36,Default,,0,0,0,,Укио Ол жақта кім пайда болады деп ойлайсың?
Dialogue: 0,0:13:00.44,0:13:02.65,Default,,0,0,0,,Death Sizer шабуыл түрі болғандықтан...
Dialogue: 0,0:13:02.74,0:13:05.20,Default,,0,0,0,,Бұл менің басымнан өтсе, менің жолым болар еді.
Dialogue: 0,0:13:07.82,0:13:08.57,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:09.74,0:13:10.78,Default,,0,0,0,,Бұл ауырады ма?
Dialogue: 0,0:13:11.37,0:13:13.25,Default,,0,0,0,,Жоқ, бұл маңызды мәселе емес.
Dialogue: 0,0:13:13.66,0:13:15.58,Default,,0,0,0,,Ол дерлік сауығып кетуі керек.
Dialogue: 0,0:13:16.00,0:13:17.58,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:17.83,0:13:19.71,Default,,0,0,0,,Мен өзімді сергек сезінемін
Dialogue: 0,0:13:21.21,0:13:22.17,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:13:22.25,0:13:23.67,Default,,0,0,0,,Келесі мен боламын
Dialogue: 0,0:13:23.96,0:13:25.51,Default,,0,0,0,,Соңғы минутқа дейін демалыңыз.
Dialogue: 0,0:13:26.93,0:13:29.18,Default,,0,0,0,,Мен оны келесі шайқаста қайтарамын
Dialogue: 0,0:13:29.97,0:13:30.93,Default,,0,0,0,,Иә!
Dialogue: 0,0:13:31.47,0:13:33.68,Default,,0,0,0,,Екінші пышақ Алдыңғы
Dialogue: 0,0:13:33.77,0:13:36.64,Default,,0,0,0,,Йонекома Гакуэн Бей клубы - Куроками Дина
Dialogue: 0,0:13:36.73,0:13:39.19,Default,,0,0,0,,Қылыш жалынынан: Укио Юкифуки
Dialogue: 0,0:13:39.27,0:13:41.15,Default,,0,0,0,,Бұл тамаша балалар ойыны!
Dialogue: 0,0:13:41.52,0:13:43.03,Default,,0,0,0,,Қара Құдай Дина
Dialogue: 0,0:13:43.23,0:13:46.07,Default,,0,0,0,,Сіз өткен күні менің дохжоға келгелі бері болды.
Dialogue: 0,0:13:46.61,0:13:47.36,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:47.70,0:13:49.70,Default,,0,0,0,,Сәлем! Гррр...
Dialogue: 0,0:13:49.78,0:13:51.99,Default,,0,0,0,,Бейбатлда бұзақылық жасағандарға -
Dialogue: 0,0:13:52.41,0:13:54.50,Default,,0,0,0,,Бейде ойнауға құқығы жоқ!
Dialogue: 0,0:13:58.71,0:14:02.00,Default,,0,0,0,,Ол... Бэйден кетуі мүмкін.
Dialogue: 0,0:14:03.13,0:14:05.09,Default,,0,0,0,,Осылай, біз тағы да ұрысамыз.
Dialogue: 0,0:14:05.17,0:14:06.84,Default,,0,0,0,,Мен шынымен бақыттымын
Dialogue: 0,0:14:07.13,0:14:08.93,Default,,0,0,0,,А, мен де.
Dialogue: 0,0:14:09.13,0:14:10.72,Default,,0,0,0,,Екінші шайқас
Dialogue: 0,0:14:10.80,0:14:11.89,Default,,0,0,0,,Мен саған осылай үнсіз өлуді айта алмаймын!!
Dialogue: 0,0:14:12.18,0:14:13.72,Default,,0,0,0,,Куроками Дина...
Dialogue: 0,0:14:14.10,0:14:16.43,Default,,0,0,0,,Атмосфера әйтеуір өзгерді.
Dialogue: 0,0:14:16.73,0:14:18.31,Default,,0,0,0,,Укио бұрыннан-
Dialogue: 0,0:14:18.39,0:14:20.90,Default,,0,0,0,,Менің шайқау түсірілімімді көрген боларсыз.
Dialogue: 0,0:14:21.02,0:14:23.44,Default,,0,0,0,,Егер сіз одан аулақ болуға тырыссаңыз...
Dialogue: 0,0:14:23.65,0:14:25.48,Default,,0,0,0,,Біз қауіптен аулақ боламыз ба?
Dialogue: 0,0:14:25.57,0:14:27.53,Default,,0,0,0,,Диагональ бойынша ату керек
Dialogue: 0,0:14:27.74,0:14:29.61,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:14:30.11,0:14:33.37,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:33.70,0:14:34.95,Default,,0,0,0,,Бұрылған!
Dialogue: 0,0:14:35.74,0:14:37.71,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:39.00,0:14:40.75,Default,,0,0,0,,Екеуі де атады!
Dialogue: 0,0:14:40.83,0:14:43.63,Default,,0,0,0,,Ой, Дина Куроками Shake Shoot деп мөрлейді.
Dialogue: 0,0:14:43.71,0:14:45.46,Default,,0,0,0,,Көлденең ату уақыты келді!
Dialogue: 0,0:14:45.67,0:14:46.88,Default,,0,0,0,,Сіз оны оқыдыңыз ба?
Dialogue: 0,0:14:47.34,0:14:48.92,Default,,0,0,0,,Диагональ бойынша ату арқылы...
Dialogue: 0,0:14:49.05,0:14:51.47,Default,,0,0,0,,Мен шайқау соққысынан жалтаруға тырыстым.
Dialogue: 0,0:14:51.76,0:14:52.39,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:14:52.55,0:14:55.76,Default,,0,0,0,,Unicorn және Deathsizer екеуі де қашықтықты сақтайды
Dialogue: 0,0:14:55.85,0:14:57.89,Default,,0,0,0,,Мен басқа адам не істейтінін күтемін!
Dialogue: 0,0:14:58.31,0:14:59.44,Default,,0,0,0,,Мұны оқыңыз -
Dialogue: 0,0:14:59.52,0:15:01.15,Default,,0,0,0,,Таңдалған горизонталь шұңқыр
Dialogue: 0,0:15:01.23,0:15:02.73,Default,,0,0,0,,Дина Керемет!
Dialogue: 0,0:15:02.81,0:15:03.94,Default,,0,0,0,,Керемет!
Dialogue: 0,0:15:07.32,0:15:09.07,Default,,0,0,0,,Менің кестем өзгерді.
Dialogue: 0,0:15:09.19,0:15:10.03,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:15:11.74,0:15:12.74,Default,,0,0,0,,Сол әдемі нәрсенің ұштары бар ма!?
Dialogue: 0,0:15:12.95,0:15:15.12,Default,,0,0,0,,Жүр! Өлім сенер!
Dialogue: 0,0:15:15.20,0:15:17.16,Default,,0,0,0,,(шығанақ шыққан дыбыс)
Dialogue: 0,0:15:19.08,0:15:21.29,Default,,0,0,0,,(Сузуя) Адамдар әрдайым бір жерде өліп жатады ғой, иә?
Dialogue: 0,0:15:21.42,0:15:24.59,Default,,0,0,0,,Dark Death Sizeer 1 ұпай
Dialogue: 0,0:15:24.67,0:15:27.80,Default,,0,0,0,,Иә
Dialogue: 0,0:15:28.05,0:15:29.76,Default,,0,0,0,,Жарайды~
Dialogue: 0,0:15:30.09,0:15:32.01,Default,,0,0,0,,Енді 2-ден 1-ге!
Dialogue: 0,0:15:32.09,0:15:34.05,Default,,0,0,0,,Ұпай айырмашылығы 1 ұпайға дейін қысқартылды!
Dialogue: 0,0:15:35.97,0:15:37.26,Default,,0,0,0,,Куроками Дина...
Dialogue: 0,0:15:37.35,0:15:39.22,Default,,0,0,0,,Уау~
Dialogue: 0,0:15:39.52,0:15:41.35,Default,,0,0,0,,Мен Каге Фуми но Укиомын
Dialogue: 0,0:15:41.81,0:15:43.81,Default,,0,0,0,,Шығанақта арт жақтан ұсталу деген нені білдіреді?
Dialogue: 0,0:15:44.02,0:15:45.06,Default,,0,0,0,,Санасыз
Dialogue: 0,0:15:45.36,0:15:47.86,Default,,0,0,0,,Кенет менің артымда тұрма!
Dialogue: 0,0:15:47.94,0:15:48.82,Default,,0,0,0,,Осы сияқты...
Dialogue: 0,0:15:48.90,0:15:50.36,Default,,0,0,0,,Иә! Иә~
Dialogue: 0,0:15:50.44,0:15:52.53,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:15:53.11,0:15:54.41,Default,,0,0,0,,Тағы да ұрысайық
Dialogue: 0,0:15:54.49,0:15:56.08,Default,,0,0,0,,А...
Dialogue: 0,0:15:57.79,0:15:59.50,Default,,0,0,0,,Жарайсың Дина!
Dialogue: 0,0:15:59.75,0:16:02.33,Default,,0,0,0,,Бұл таңқаларлық емес пе, Deathsizer!
Dialogue: 0,0:16:02.41,0:16:03.75,Default,,0,0,0,,Мен оны дұрыс қостым.
Dialogue: 0,0:16:04.46,0:16:05.21,Default,,0,0,0,,Ах
Dialogue: 0,0:16:05.58,0:16:07.46,Default,,0,0,0,,Жарайды, мені мақтаған дұрыс.
Dialogue: 0,0:16:07.54,0:16:09.63,Default,,0,0,0,,Менің ойымша, сіз жаңа ғана ұпай алдыңыз.
Dialogue: 0,0:16:09.71,0:16:10.59,Default,,0,0,0,,Бұл тітіркендіргіш
Dialogue: 0,0:16:10.67,0:16:11.30,Default,,0,0,0,,Қандай азап…
Dialogue: 0,0:16:11.38,0:16:13.01,Default,,0,0,0,,Тоқта, Кумичо.
Dialogue: 0,0:16:13.18,0:16:15.68,Default,,0,0,0,,Біреуді алса, досы қайтарып алады.
Dialogue: 0,0:16:15.97,0:16:17.51,Default,,0,0,0,,Бұл командалық шайқас
Dialogue: 0,0:16:17.64,0:16:18.47,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:18.56,0:16:20.47,Default,,0,0,0,,Сондықтан бұл туралы алаңдамаңыз.
Dialogue: 0,0:16:20.89,0:16:21.93,Default,,0,0,0,,Хмф!
Dialogue: 0,0:16:24.85,0:16:26.98,Default,,0,0,0,,Үшінші қуық Алдыңғы
Dialogue: 0,0:16:27.06,0:16:28.61,Default,,0,0,0,,Өтінемін, Шу.
Dialogue: 0,0:16:28.69,0:16:31.65,Default,,0,0,0,,А, стратегия қандай? капитан
Dialogue: 0,0:16:32.32,0:16:33.28,Default,,0,0,0,,А...
Dialogue: 0,0:16:33.61,0:16:35.49,Default,,0,0,0,,Мен сізге еремін
Dialogue: 0,0:16:35.66,0:16:37.49,Default,,0,0,0,,Ах... Стратегия...
Dialogue: 0,0:16:41.33,0:16:43.62,Default,,0,0,0,,Бұл... у...
Dialogue: 0,0:16:44.42,0:16:45.96,Default,,0,0,0,,Міне солай...
Dialogue: 0,0:16:46.04,0:16:46.83,Default,,0,0,0,,Ал...
Dialogue: 0,0:16:46.92,0:16:49.46,Default,,0,0,0,,Сіріңке – шайқас...
Dialogue: 0,0:16:49.55,0:16:52.30,Default,,0,0,0,,Ал... у...
Dialogue: 0,0:16:52.51,0:16:53.51,Default,,0,0,0,,Эй
Dialogue: 0,0:16:53.59,0:16:54.80,Default,,0,0,0,,...ze...
Dialogue: 0,0:16:55.38,0:16:56.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:56.93,0:16:58.51,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:16:58.60,0:17:00.47,Default,,0,0,0,,Түсіндім, капитан.
Dialogue: 0,0:17:00.64,0:17:01.97,Default,,0,0,0,,Сіз дәл қазір түсіндіңіз бе?
Dialogue: 0,0:17:02.06,0:17:03.27,Default,,0,0,0,,Ии…
Dialogue: 0,0:17:03.35,0:17:04.56,Default,,0,0,0,,Әрине
Dialogue: 0,0:17:05.35,0:17:06.69,Default,,0,0,0,,Онда мен барамын
Dialogue: 0,0:17:08.31,0:17:11.78,Default,,0,0,0,,Енді Қылыш жалындары 1 ұпаймен алда!
Dialogue: 0,0:17:11.86,0:17:14.49,Default,,0,0,0,,Үшінші шайқаста шешіледі ме?
Dialogue: 0,0:17:14.70,0:17:15.65,Default,,0,0,0,,Шу~
Dialogue: 0,0:17:15.74,0:17:16.66,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:17:16.74,0:17:18.28,Default,,0,0,0,,Заттарды көзге көрсету~
Dialogue: 0,0:17:18.36,0:17:19.78,Default,,0,0,0,,Бір ату арқылы шешіңіз!
Dialogue: 0,0:17:19.87,0:17:20.87,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе~
Dialogue: 0,0:17:20.95,0:17:21.91,Default,,0,0,0,,Келіңіздер~
Dialogue: 0,0:17:21.99,0:17:23.75,Default,,0,0,0,,Комурасаки де, Куроками де
Dialogue: 0,0:17:23.83,0:17:25.25,Default,,0,0,0,,Барлығы өзгерді.
Dialogue: 0,0:17:34.42,0:17:35.80,Default,,0,0,0,,Мен де солаймын ба...
Dialogue: 0,0:17:37.55,0:17:39.30,Default,,0,0,0,,Шуу жүр!
Dialogue: 0,0:17:40.10,0:17:42.43,Default,,0,0,0,,Балто мен жеңемін!
Dialogue: 0,0:17:42.97,0:17:44.31,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз!
Dialogue: 0,0:17:44.98,0:17:46.31,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:17:50.56,0:17:52.94,Default,,0,0,0,,Баланс типті спригган
Dialogue: 0,0:17:53.40,0:17:54.90,Default,,0,0,0,,Оны ортаға тастау керек пе...
Dialogue: 0,0:17:54.99,0:17:57.45,Default,,0,0,0,,Әлде айналаңыздан шабуыл жасауды жоспарлап отырсыз ба?
Dialogue: 0,0:17:57.70,0:18:00.20,Default,,0,0,0,,Yggdrasil - төзімділік түрі
Dialogue: 0,0:18:00.57,0:18:02.41,Default,,0,0,0,,ұшы арнайы материалдан жасалған
Dialogue: 0,0:18:03.95,0:18:05.87,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:18:06.33,0:18:09.75,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:18:09.83,0:18:11.96,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:18:12.04,0:18:12.75,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:18:13.80,0:18:15.59,Default,,0,0,0,,Бей атылды!
Dialogue: 0,0:18:15.67,0:18:18.43,Default,,0,0,0,,Орталықты алған адам Джегер Йггдрасил болды!
Dialogue: 0,0:18:18.51,0:18:21.05,Default,,0,0,0,,Содан кейін Спригган дауылы шабуыл жасайды!
Dialogue: 0,0:18:21.35,0:18:22.72,Default,,0,0,0,,Жоғарғы түсірілім!
Dialogue: 0,0:18:22.81,0:18:24.81,Default,,0,0,0,,Спригганның жоғарғы өркені!
Dialogue: 0,0:18:24.89,0:18:27.27,Default,,0,0,0,,Бірақ қозғалыс тұрақсыз.
Dialogue: 0,0:18:27.35,0:18:29.44,Default,,0,0,0,,Yggdrasil Айнымас
Dialogue: 0,0:18:29.52,0:18:30.35,Default,,0,0,0,,Құт
Dialogue: 0,0:18:30.44,0:18:32.02,Default,,0,0,0,,Осыншама азаппен...
Dialogue: 0,0:18:32.11,0:18:33.44,Default,,0,0,0,,Шу…
Dialogue: 0,0:18:36.90,0:18:38.20,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:38.53,0:18:40.11,Default,,0,0,0,,Шұңқырды диагональ етіп жасаңыз
Dialogue: 0,0:18:40.20,0:18:42.07,Default,,0,0,0,,Бұрауыштың бұрышын ысқылаңыз.
Dialogue: 0,0:18:42.16,0:18:44.70,Default,,0,0,0,,Бұл төзімділікті тұтынатын стратегия.
Dialogue: 0,0:18:45.16,0:18:45.95,Default,,0,0,0,,Бірақ
Dialogue: 0,0:18:46.25,0:18:48.50,Default,,0,0,0,,Йггдрасилдің икемді драйвері -
Dialogue: 0,0:18:48.58,0:18:49.79,Default,,0,0,0,,Арнайы материалдар
Dialogue: 0,0:18:49.87,0:18:51.92,Default,,0,0,0,,Мұндай шабуыл нәтиже бермейді
Dialogue: 0,0:18:52.00,0:18:53.46,Default,,0,0,0,,Кеттік! Юго!
Dialogue: 0,0:18:53.54,0:18:54.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:54.38,0:18:55.63,Default,,0,0,0,,Шу~
Dialogue: 0,0:18:55.71,0:18:56.92,Default,,0,0,0,,Эй, бұл ақылсыз.
Dialogue: 0,0:18:57.30,0:18:59.80,Default,,0,0,0,,Жоқ Шудың стратегиясы...
Dialogue: 0,0:19:00.38,0:19:03.43,Default,,0,0,0,,Ағымдағы шабуыл аз зиян келтіретіні рас.
Dialogue: 0,0:19:03.89,0:19:04.72,Default,,0,0,0,,Бірақ!
Dialogue: 0,0:19:05.39,0:19:07.47,Default,,0,0,0,,Күшті бұл күйде тоқтату мүмкін емес.
Dialogue: 0,0:19:07.77,0:19:10.10,Default,,0,0,0,,Жарылу мүмкіндігі артуы керек!
Dialogue: 0,0:19:10.19,0:19:12.90,Default,,0,0,0,,Сен мені мұндай стратегиямен жеңе алмайсың.
Dialogue: 0,0:19:12.98,0:19:14.61,Default,,0,0,0,,Жүр!
Dialogue: 0,0:19:14.69,0:19:15.94,Default,,0,0,0,,Спригган!
Dialogue: 0,0:19:20.95,0:19:22.99,Default,,0,0,0,,(үру)
Dialogue: 0,0:19:23.12,0:19:24.32,Default,,0,0,0,,Yggdrasil!
Dialogue: 0,0:19:24.41,0:19:26.45,Default,,0,0,0,,Мен кек аламын.
Dialogue: 0,0:19:30.21,0:19:31.58,Default,,0,0,0,,(айқай)
Dialogue: 0,0:19:35.29,0:19:37.34,Default,,0,0,0,,Алға!
Dialogue: 0,0:19:41.38,0:19:42.72,Default,,0,0,0,,(шығанақ шыққан дыбыс)
Dialogue: 0,0:19:42.80,0:19:43.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:44.14,0:19:45.47,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:19:47.97,0:19:48.68,Default,,0,0,0,,Әй
Dialogue: 0,0:19:48.81,0:19:51.39,Default,,0,0,0,,Дауыл Спригганның жарылуы аяқталды
Dialogue: 0,0:19:51.48,0:19:53.27,Default,,0,0,0,,Йонекома Гакуэн, 3-тен 2-ге дейін.
Dialogue: 0,0:19:53.35,0:19:54.65,Default,,0,0,0,,Шығанақ шаян жеңеді!
Dialogue: 0,0:19:54.73,0:19:57.07,Default,,0,0,0,,Иә! (Рантаро) Жарайды!
Dialogue: 0,0:19:57.15,0:19:58.82,Default,,0,0,0,,Шудан күткендей
Dialogue: 0,0:19:58.90,0:20:00.90,Default,,0,0,0,,Міне, солай болды деп ойлаймын.
Dialogue: 0,0:20:00.99,0:20:01.78,Default,,0,0,0,,Ах
Dialogue: 0,0:20:02.65,0:20:04.82,Default,,0,0,0,,Куу... Өкінемін...
Dialogue: 0,0:20:05.12,0:20:07.16,Default,,0,0,0,,Гуаааааааааааааааааааааааааааааа
Dialogue: 0,0:20:07.24,0:20:08.87,Default,,0,0,0,,Кешіріңіз Шака
Dialogue: 0,0:20:09.83,0:20:14.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:14.46,0:20:15.58,Default,,0,0,0,,Міне, осы.
Dialogue: 0,0:20:15.67,0:20:18.05,Default,,0,0,0,,Бүгінгі шайқас бітті.
Dialogue: 0,0:20:18.13,0:20:21.88,Default,,0,0,0,,Міне, келесі кезеңге өткен командаларды хабарлаймыз!
Dialogue: 0,0:20:22.63,0:20:24.18,Default,,0,0,0,,Аңдар!
Dialogue: 0,0:20:25.14,0:20:26.30,Default,,0,0,0,,Иә!
Dialogue: 0,0:20:26.39,0:20:28.31,Default,,0,0,0,,Әрине, (Азуки Бен) Ах.
Dialogue: 0,0:20:29.14,0:20:31.14,Default,,0,0,0,,Супер жұлдыздар!
Dialogue: 0,0:20:31.23,0:20:32.81,Default,,0,0,0,,(Қыздар қолдайды)
Dialogue: 0,0:20:33.14,0:20:35.19,Default,,0,0,0,,Күн шуағы
Dialogue: 0,0:20:36.65,0:20:38.65,Default,,0,0,0,,Жүр!
Dialogue: 0,0:20:41.44,0:20:42.49,Default,,0,0,0,,Және-
Dialogue: 0,0:20:42.57,0:20:44.86,Default,,0,0,0,,Йонекома Гакуэн шығанағы клубы!
Dialogue: 0,0:20:45.24,0:20:46.37,Default,,0,0,0,,Эххе
Dialogue: 0,0:20:47.57,0:20:48.66,Default,,0,0,0,,Барт
Dialogue: 0,0:20:48.99,0:20:51.75,Default,,0,0,0,,Шака! Бүгін де жақсы шайқас болды.
Dialogue: 0,0:20:52.08,0:20:52.91,Default,,0,0,0,,О
Dialogue: 0,0:20:53.29,0:20:56.08,Default,,0,0,0,,Мен сізге көрсеткім келмеген қулықты да көрсеттім.
Dialogue: 0,0:20:56.67,0:20:58.17,Default,,0,0,0,,Келесі жолы бұзамын
Dialogue: 0,0:20:58.25,0:20:59.59,Default,,0,0,0,,Дайындық уақыты!
Dialogue: 0,0:20:59.92,0:21:02.42,Default,,0,0,0,,Өйткені Юго мен Укио жеке шайқастарға қатыспайды.
Dialogue: 0,0:21:02.51,0:21:04.26,Default,,0,0,0,,Бұл соңғы рет.
Dialogue: 0,0:21:04.34,0:21:06.26,Default,,0,0,0,,Жақында тағы біреуі болады.
Dialogue: 0,0:21:06.76,0:21:08.72,Default,,0,0,0,,Бұл жағдайда мен жеңемін!
Dialogue: 0,0:21:08.80,0:21:11.56,Default,,0,0,0,,Біз үшін де қолыңнан келгеннің бәрін жаса.
Dialogue: 0,0:21:11.93,0:21:14.81,Default,,0,0,0,,Ах~ Сен үшін де шайқасайық.
Dialogue: 0,0:21:14.89,0:21:16.69,Default,,0,0,0,,Мен жеңетініме сенімдімін!
Dialogue: 0,0:21:16.77,0:21:17.73,Default,,0,0,0,,Иә
Dialogue: 0,0:21:17.81,0:21:19.69,Default,,0,0,0,,Бұл... Куришу...
Dialogue: 0,0:21:20.52,0:21:21.94,Default,,0,0,0,,Иә? Ах
Dialogue: 0,0:21:22.03,0:21:22.78,Default,,0,0,0,,Дәретхана?
Dialogue: 0,0:21:22.86,0:21:23.99,Default,,0,0,0,,Жоқ, Барто.
Dialogue: 0,0:21:25.20,0:21:25.78,Default,,0,0,0,,Фалько…
Dialogue: 0,0:21:26.11,0:21:26.99,Default,,0,0,0,,Мегуми Фушигуро.
Dialogue: 0,0:21:27.61,0:21:29.03,Default,,0,0,0,,Дәл қазір...
Dialogue: 0,0:21:35.58,0:21:36.87,Default,,0,0,0,,Кешіріңіз Шу
Dialogue: 0,0:21:37.42,0:21:39.63,Default,,0,0,0,,Мен... Мен ештеңе байқамадым.
Dialogue: 0,0:21:42.59,0:21:43.71,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:21:43.80,0:21:44.63,Default,,0,0,0,,Шу!
Dialogue: 0,0:21:45.63,0:21:47.34,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:21:48.64,0:21:49.39,Default,,0,0,0,,Не!
Dialogue: 0,0:21:50.51,0:21:51.47,Default,,0,0,0,,Шу...
Dialogue: 0,0:21:52.06,0:21:53.68,Default,,0,0,0,,Сол қолмен ату
Dialogue: 0,0:22:09.20,0:22:15.29,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.50,0:22:21.63,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.09,0:22:27.63,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.09,0:22:31.43,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.60,0:22:36.52,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.44,0:22:41.15,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.23,0:22:44.44,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.52,0:22:50.86,Default,,0,0,0,,Мен оның соңынан қусаң көретін декорация бар деп есептеймін.
Dialogue: 0,0:22:51.11,0:22:56.66,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.83,0:23:03.42,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.00,0:23:09.42,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.59,0:23:12.76,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.26,0:23:17.22,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.19,0:23:27.15,Default,,0,0,0,,Баршаңызға~!
Dialogue: 0,0:23:27.23,0:23:29.95,Default,,0,0,0,,Менің Валькириям өте оянуға тырысуда.
Dialogue: 0,0:23:30.03,0:23:32.41,Default,,0,0,0,,Мен қатты толқыдым.
Dialogue: 0,0:23:32.49,0:23:35.33,Default,,0,0,0,,Демек, командалық матчтың үшінші раундындағы қарсылас...
Dialogue: 0,0:23:35.41,0:23:37.24,Default,,0,0,0,,Инсукенің аңдары
Dialogue: 0,0:23:37.33,0:23:39.12,Default,,0,0,0,,Біз білмейтін Инуске
Dialogue: 0,0:23:39.20,0:23:42.33,Default,,0,0,0,,Аңның азу тістері ашылып, ақырын келеді.
Dialogue: 0,0:23:42.42,0:23:44.38,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:44.46,0:23:46.21,Default,,0,0,0,,Азу тістерін ашқан аңдар
Dialogue: 0,0:23:46.29,0:23:47.75,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:47.84,0:23:49.55,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.05,0:23:57.05,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory