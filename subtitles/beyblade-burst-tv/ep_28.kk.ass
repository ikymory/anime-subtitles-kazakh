Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.09,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.17,0:00:12.47,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.76,0:00:14.76,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.84,0:00:16.97,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.05,0:00:18.76,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.52,0:00:24.23,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.31,0:00:26.27,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.35,0:00:28.86,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:32.03,0:00:35.28,Default,,0,0,0,,көремін. Бүгін кешкі асқа барбекю жасаймыз.
Dialogue: 0,0:00:35.36,0:00:37.87,Default,,0,0,0,,Командалық жарыстарда сыналатын нәрсе – топтық жұмыс
Dialogue: 0,0:00:38.66,0:00:41.45,Default,,0,0,0,,Мен басынан бастап рөлдерді бөлуді шештім.
Dialogue: 0,0:00:41.62,0:00:42.45,Default,,0,0,0,,Иә!
Dialogue: 0,0:00:42.54,0:00:45.00,Default,,0,0,0,,Ей, өзің шешпе!
Dialogue: 0,0:00:45.83,0:00:48.25,Default,,0,0,0,,Хоудзи ингредиенттерді тасымалдауға жауапты.
Dialogue: 0,0:00:49.00,0:00:52.01,Default,,0,0,0,,Ника аспаз.
Dialogue: 0,0:00:52.71,0:00:54.67,Default,,0,0,0,,Ал қалғанының бәрі...
Dialogue: 0,0:00:54.84,0:00:56.97,Default,,0,0,0,,Отты дайындайтын адам!
Dialogue: 0,0:00:59.89,0:01:02.72,Default,,0,0,0,,Оқу-жаттығу жиыны туралы айтатын болсақ, онда әрқашан от жағады!
Dialogue: 0,0:01:03.10,0:01:05.81,Default,,0,0,0,,...Ол не ойлады?
Dialogue: 0,0:01:05.89,0:01:08.73,Default,,0,0,0,,Жарайды, бірақ ол осында.
Dialogue: 0,0:01:09.11,0:01:11.11,Default,,0,0,0,,Тек орындаңыз!
Dialogue: 0,0:01:11.19,0:01:13.82,Default,,0,0,0,,Аяқтаған кезде мен сізге келесі нұсқауларды беремін.
Dialogue: 0,0:01:14.03,0:01:15.74,Default,,0,0,0,,Капитанның соңынан еріңіз
Dialogue: 0,0:01:15.82,0:01:18.74,Default,,0,0,0,,Сіз капитан емессіз, солай ма?
Dialogue: 0,0:01:26.79,0:01:29.17,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:29.50,0:01:34.67,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:45.98,0:01:49.35,Default,,0,0,0,,Мен барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:49.85,0:01:51.98,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:52.40,0:01:56.53,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:56.65,0:01:59.86,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:01:59.99,0:02:06.41,Default,,0,0,0,,Менің ойымша, айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:06.70,0:02:11.13,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:11.63,0:02:17.05,Default,,0,0,0,,Дауысты дауыстап, дірілдеп ойнайық
Dialogue: 0,0:02:17.17,0:02:19.43,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:19.51,0:02:24.22,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:24.39,0:02:29.48,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:29.77,0:02:32.02,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:32.23,0:02:34.57,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:34.86,0:02:38.78,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:38.95,0:02:43.95,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:44.16,0:02:46.33,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:50.00,0:02:53.54,Default,,0,0,0,,Тау! Бұл өзен! Дауылды шытырман оқиға!\NМен мұны
Dialogue: 0,0:02:57.63,0:02:59.38,Default,,0,0,0,,арқылы жасай алдым
Dialogue: 0,0:02:59.72,0:03:02.14,Default,,0,0,0,,Бұл мен күткеннен де қиын болды...
Dialogue: 0,0:03:02.80,0:03:04.60,Default,,0,0,0,,Ақырында аяқталды ма?
Dialogue: 0,0:03:04.68,0:03:06.35,Default,,0,0,0,,Кеш болды.
Dialogue: 0,0:03:07.02,0:03:08.22,Default,,0,0,0,,А?
Dialogue: 0,0:03:09.48,0:03:12.48,Default,,0,0,0,,Сәлем! Отты кім жағатынын шешейік!
Dialogue: 0,0:03:12.56,0:03:13.65,Default,,0,0,0,,Осы сал денені алға итеру үшін от күшін пайдалан!
Dialogue: 0,0:03:13.73,0:03:15.23,Default,,0,0,0,,Алдымен шыға!
Dialogue: 0,0:03:15.40,0:03:16.40,Default,,0,0,0,,Тас, қағаз, қайшы...
Dialogue: 0,0:03:16.52,0:03:17.36,Default,,0,0,0,,(Отты жағу дыбысы)
Dialogue: 0,0:03:17.86,0:03:20.90,Default,,0,0,0,,(оттың дыбысы)
Dialogue: 0,0:03:20.99,0:03:22.82,Default,,0,0,0,,Е!
Dialogue: 0,0:03:23.03,0:03:26.66,Default,,0,0,0,,Не? От жағу капитанның міндеті.
Dialogue: 0,0:03:30.62,0:03:33.12,Default,,0,0,0,,(барбекю грильдеу дыбысы)
Dialogue: 0,0:03:33.21,0:03:35.67,Default,,0,0,0,,Кумичо! Күйіп қалды!
Dialogue: 0,0:03:36.67,0:03:39.46,Default,,0,0,0,,Ах! Бұл Кумичо!
Dialogue: 0,0:03:39.55,0:03:40.88,Default,,0,0,0,,А...
Dialogue: 0,0:03:40.97,0:03:42.72,Default,,0,0,0,,Жарайды, тамақ ішейік!
Dialogue: 0,0:03:43.38,0:03:45.72,Default,,0,0,0,,Не... Бұл жай ғана көк пияз емес пе?
Dialogue: 0,0:03:46.14,0:03:47.26,Default,,0,0,0,,Ет...?
Dialogue: 0,0:03:47.64,0:03:50.02,Default,,0,0,0,,Вакия оны рұқсатсыз жеп қойды...
Dialogue: 0,0:03:50.10,0:03:51.73,Default,,0,0,0,,Не!
Dialogue: 0,0:03:51.81,0:03:53.85,Default,,0,0,0,,Арх! Ха...
Dialogue: 0,0:03:53.94,0:03:56.52,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:03:59.23,0:04:01.74,Default,,0,0,0,,А, мен ұйықтай алмаймын!
Dialogue: 0,0:04:01.82,0:04:04.03,Default,,0,0,0,,Вакия Яроу...!
Dialogue: 0,0:04:07.41,0:04:08.53,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:04:11.75,0:04:14.50,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:04:15.17,0:04:16.21,Default,,0,0,0,,Балто!
Dialogue: 0,0:04:17.29,0:04:19.30,Default,,0,0,0,,Жолақ түбірі!
Dialogue: 0,0:04:19.38,0:04:20.67,Default,,0,0,0,,♬~
Dialogue: 0,0:04:20.76,0:04:21.51,Default,,0,0,0,,Тс…
Dialogue: 0,0:04:22.09,0:04:23.51,Default,,0,0,0,,Кумичо
Dialogue: 0,0:04:23.59,0:04:24.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:25.39,0:04:26.68,Default,,0,0,0,,Хоудзи!
Dialogue: 0,0:04:29.56,0:04:32.60,Default,,0,0,0,,(раменнің шырылдаған дыбысы)
Dialogue: 0,0:04:32.68,0:04:34.10,Default,,0,0,0,,Жалпы айтқанда...
Dialogue: 0,0:04:34.35,0:04:38.06,Default,,0,0,0,,Ей, балам, балам, оны еркелету жақсы емес.
Dialogue: 0,0:04:38.15,0:04:39.19,Default,,0,0,0,,That's right.
Dialogue: 0,0:04:39.27,0:04:41.99,Default,,0,0,0,,Маған дәмді нәрсе әкелші...
Dialogue: 0,0:04:42.07,0:04:44.49,Default,,0,0,0,,Дүние соншалықты тәтті емес.
Dialogue: 0,0:04:44.70,0:04:47.82,Default,,0,0,0,,Бала жалғыз өскендіктен...
Dialogue: 0,0:04:47.91,0:04:48.66,Default,,0,0,0,,Әй?
Dialogue: 0,0:04:49.58,0:04:51.41,Default,,0,0,0,,Ата-анаң бос емес...
Dialogue: 0,0:04:51.49,0:04:53.79,Default,,0,0,0,,Менің айналамдағылардың барлығы көмектесіп жатыр.
Dialogue: 0,0:04:54.25,0:04:56.67,Default,,0,0,0,,Балаға ешкім ұрыспайды.
Dialogue: 0,0:04:56.75,0:04:59.17,Default,,0,0,0,,Жарайды, кеттік! Бар! Бар!
Dialogue: 0,0:04:59.71,0:05:02.13,Default,,0,0,0,,Мен бәріңді өзімнің жанұяларым етемін!
Dialogue: 0,0:05:02.59,0:05:04.22,Default,,0,0,0,,Мынау не жігіт...
Dialogue: 0,0:05:04.30,0:05:05.63,Default,,0,0,0,,(Дарио) Бұл нағыз апат. Бұл жігіт те сол жерде-ақ қаза тапты. ➡
Dialogue: 0,0:05:06.80,0:05:09.68,Default,,0,0,0,,Дос табу қиынға соққан сияқты.
Dialogue: 0,0:05:10.60,0:05:13.60,Default,,0,0,0,,-де? Бұл мен онымен жүруім керек дегенді білдіре ме?
Dialogue: 0,0:05:13.68,0:05:15.44,Default,,0,0,0,,Әй, бұл әзіл емес!
Dialogue: 0,0:05:19.73,0:05:22.03,Default,,0,0,0,,Мықтылардың жиналғаны жақсы.
Dialogue: 0,0:05:22.48,0:05:24.74,Default,,0,0,0,,Бірақ бұл бізді командаға айналдырмайды.
Dialogue: 0,0:05:24.90,0:05:25.90,Default,,0,0,0,,О
Dialogue: 0,0:05:26.49,0:05:30.28,Default,,0,0,0,,Барлығын біріктіру үшін не істеуім керек? Шу
Dialogue: 0,0:05:30.37,0:05:31.78,Default,,0,0,0,,Мен әлі білмеймін
Dialogue: 0,0:05:32.37,0:05:33.20,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:33.29,0:05:34.66,Default,,0,0,0,,Не еді тағы?
Dialogue: 0,0:05:34.75,0:05:37.71,Default,,0,0,0,,Мен саған сенбеймін, мен осылай сөйлеп тұрмын...
Dialogue: 0,0:05:38.17,0:05:41.17,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:05:43.17,0:05:45.97,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:05:46.05,0:05:48.09,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:05:56.39,0:05:58.85,Default,,0,0,0,,Мен сені бұл жолы жеңемін!
Dialogue: 0,0:05:58.94,0:06:01.36,Default,,0,0,0,,Кел, Валькири!
Dialogue: 0,0:06:01.48,0:06:03.52,Default,,0,0,0,,Бал-нии! Бұған дейін!
Dialogue: 0,0:06:03.65,0:06:04.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:05.74,0:06:06.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:07.82,0:06:09.36,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:06:10.91,0:06:13.41,Default,,0,0,0,,Викинг азу жұтқан!
Dialogue: 0,0:06:13.74,0:06:16.62,Default,,0,0,0,,Wild Wyvern's Burst Finish
Dialogue: 0,0:06:16.70,0:06:19.08,Default,,0,0,0,,Бұл Вакия Бочаманың жеңісі.
Dialogue: 0,0:06:20.12,0:06:21.38,Default,,0,0,0,,Ууууу...
Dialogue: 0,0:06:21.92,0:06:24.09,Default,,0,0,0,,Бұл стадиондағы оқ...
Dialogue: 0,0:06:24.17,0:06:25.88,Default,,0,0,0,,Мен позициялау туралы ойлауым керек.
Dialogue: 0,0:06:25.96,0:06:26.84,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:27.30,0:06:29.30,Default,,0,0,0,,Бұл менің үшінші ойым!
Dialogue: 0,0:06:30.09,0:06:31.43,Default,,0,0,0,,Таңертеңгі шайқас...
Dialogue: 0,0:06:31.51,0:06:33.76,Default,,0,0,0,,Көк командасы жеңеді!
Dialogue: 0,0:06:33.85,0:06:35.10,Default,,0,0,0,,Ха
Dialogue: 0,0:06:35.60,0:06:37.81,Default,,0,0,0,,Әлі жоқ! Тағы да!
Dialogue: 0,0:06:37.89,0:06:40.35,Default,,0,0,0,,Қолыңыздан келгенше жүздеген рет жасаңыз...
Dialogue: 0,0:06:40.44,0:06:41.77,Default,,0,0,0,,(Балтоның қарны шымырлаған дыбысы)
Dialogue: 0,0:06:41.85,0:06:43.02,Default,,0,0,0,,Хаха!
Dialogue: 0,0:06:43.11,0:06:45.44,Default,,0,0,0,,Барт Ішімдегі қате шырылдап тұр.
Dialogue: 0,0:06:45.53,0:06:47.15,Default,,0,0,0,,(Рантароның ішінің шұрылдаған дыбысы)
Dialogue: 0,0:06:47.24,0:06:49.70,Default,,0,0,0,,Міне, тамақтың уақыты келді!
Dialogue: 0,0:06:53.99,0:06:55.99,Default,,0,0,0,,Әй, бұл не болды?
Dialogue: 0,0:06:56.24,0:06:58.79,Default,,0,0,0,,Ингредиенттерді өзіміз сатып алу
Dialogue: 0,0:06:59.41,0:07:00.75,Default,,0,0,0,,Оқу-жаттығу жиынына ұқсайды.
Dialogue: 0,0:07:06.96,0:07:08.30,Default,,0,0,0,,Асықпа
Dialogue: 0,0:07:08.38,0:07:10.30,Default,,0,0,0,,Жұмыс істе!
Dialogue: 0,0:07:12.30,0:07:13.26,Default,,0,0,0,,О! Келдің бе!
Dialogue: 0,0:07:14.43,0:07:15.22,Default,,0,0,0,,Аһ!
Dialogue: 0,0:07:15.30,0:07:17.64,Default,,0,0,0,,О! Апыр-ай!
Dialogue: 0,0:07:18.52,0:07:21.14,Default,,0,0,0,,Кумичо! Мұнда олардың үшеуі бар!
Dialogue: 0,0:07:21.35,0:07:23.60,Default,,0,0,0,,Мен жеңілдім! О иә!
Dialogue: 0,0:07:31.70,0:07:34.28,Default,,0,0,0,,Вакия~! Эй!
Dialogue: 0,0:07:36.99,0:07:37.99,Default,,0,0,0,,Қараңдар, қараңдар!
Dialogue: 0,0:07:38.08,0:07:41.00,Default,,0,0,0,,Жемістер көп! Бұл керемет емес пе!
Dialogue: 0,0:07:41.08,0:07:43.83,Default,,0,0,0,,Сәлем, бар! Вакия, оны ал!
Dialogue: 0,0:07:44.38,0:07:47.17,Default,,0,0,0,,Қолымнан келмейді... Қайсысы?
Dialogue: 0,0:07:52.80,0:07:54.18,Default,,0,0,0,,Вакия?
Dialogue: 0,0:07:54.26,0:07:55.51,Default,,0,0,0,,Ааа аа...
Dialogue: 0,0:07:55.60,0:07:58.26,Default,,0,0,0,,Егер сіз осындай нәрсені алсаңыз, не істер едіңіз?
Dialogue: 0,0:07:58.60,0:08:00.98,Default,,0,0,0,,Өте дәмді көрінеді!
Dialogue: 0,0:08:01.06,0:08:02.81,Default,,0,0,0,,Оны жауынгерлік жүлдеге айналдырыңыз!
Dialogue: 0,0:08:03.10,0:08:04.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:04.31,0:08:08.07,Default,,0,0,0,,Ақымақ сияқты! Ой, жаттығу уақыты!
Dialogue: 0,0:08:08.15,0:08:09.44,Default,,0,0,0,,Годзи
Dialogue: 0,0:08:09.53,0:08:11.11,Default,,0,0,0,,Тодороки, сен не айтып тұрсың өзің?
Dialogue: 0,0:08:11.19,0:08:13.82,Default,,0,0,0,,Бала биіктікте жақсы емес.
Dialogue: 0,0:08:14.16,0:08:15.62,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:25.37,0:08:26.92,Default,,0,0,0,,Барлығы өте жақсы!
Dialogue: 0,0:08:27.00,0:08:28.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:28.84,0:08:30.25,Default,,0,0,0,,Балто наны ма?
Dialogue: 0,0:08:30.34,0:08:31.05,Default,,0,0,0,,О!
Dialogue: 0,0:08:31.42,0:08:33.22,Default,,0,0,0,,Жақсы нәрсе жасаңыз!
Dialogue: 0,0:08:33.55,0:08:34.55,Default,,0,0,0,,О!
Dialogue: 0,0:08:37.85,0:08:40.26,Default,,0,0,0,,Дәмді нанды жеуге рұқсат етпе!
Dialogue: 0,0:08:40.35,0:08:42.35,Default,,0,0,0,,Мұны маған анам үйретті.
Dialogue: 0,0:08:42.93,0:08:44.69,Default,,0,0,0,,Балық өртеніп кетті!
Dialogue: 0,0:08:44.77,0:08:46.60,Default,,0,0,0,,Келесі жолы не істейсіз?
Dialogue: 0,0:08:46.69,0:08:47.69,Default,,0,0,0,,Әй
Dialogue: 0,0:08:47.77,0:08:51.07,Default,,0,0,0,,Балалар, менің талғамыма сай бірдеңе жасап беріңдер.
Dialogue: 0,0:08:51.98,0:08:54.78,Default,,0,0,0,,Үш екі бір қарау~
Dialogue: 0,0:08:54.86,0:08:55.82,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:08:55.91,0:08:57.57,Default,,0,0,0,,Әй, дәмді емес пе?
Dialogue: 0,0:08:57.66,0:08:59.37,Default,,0,0,0,,О~ Ахахха
Dialogue: 0,0:08:59.45,0:09:00.83,Default,,0,0,0,,Жарайды, мен де!
Dialogue: 0,0:09:01.29,0:09:04.33,Default,,0,0,0,,Үш екі... Кумичо орындалмады~
Dialogue: 0,0:09:04.41,0:09:06.62,Default,,0,0,0,,Жасыру! (Рантаро) Қарғыс атсын!
Dialogue: 0,0:09:06.71,0:09:08.79,Default,,0,0,0,,… Барып атыңыз!
Dialogue: 0,0:09:09.59,0:09:10.63,Default,,0,0,0,,Не!
Dialogue: 0,0:09:11.21,0:09:12.71,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:14.13,0:09:17.22,Default,,0,0,0,,Х.Балт бұрын адам жетіспейтінін айтты...
Dialogue: 0,0:09:17.59,0:09:19.30,Default,,0,0,0,,Міндетті түрде барыңыз!
Dialogue: 0,0:09:19.39,0:09:22.01,Default,,0,0,0,,Мен бармаймын!
Dialogue: 0,0:09:24.64,0:09:27.94,Default,,0,0,0,,Балалар, сіз осындай нәрсені жасай аласыз ба?
Dialogue: 0,0:09:28.02,0:09:29.73,Default,,0,0,0,,Вакия дәмді!
Dialogue: 0,0:09:29.81,0:09:31.15,Default,,0,0,0,,Тамаша!
Dialogue: 0,0:09:32.78,0:09:35.24,Default,,0,0,0,,Itadadakimasu!
Dialogue: 0,0:09:37.41,0:09:38.91,Default,,0,0,0,,Бұл дәмді!
Dialogue: 0,0:09:39.20,0:09:41.74,Default,,0,0,0,,Шудың макарондары өте дәмді!
Dialogue: 0,0:09:41.83,0:09:43.74,Default,,0,0,0,,Дұрыс, дұрыс!
Dialogue: 0,0:09:43.83,0:09:45.45,Default,,0,0,0,,Мазалама
Dialogue: 0,0:09:45.83,0:09:47.50,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:09:47.58,0:09:48.21,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:51.79,0:09:53.00,Default,,0,0,0,,О!
Dialogue: 0,0:09:57.43,0:09:58.93,Default,,0,0,0,,Және…
Dialogue: 0,0:09:59.01,0:10:00.76,Default,,0,0,0,,Менің арнайы ~
Dialogue: 0,0:10:00.85,0:10:04.10,Default,,0,0,0,,Beyblade Pan жаттығу лагерінің нұсқасы!
Dialogue: 0,0:10:05.81,0:10:08.64,Default,,0,0,0,,Бұл... Өлімнің өлшемі ме?
Dialogue: 0,0:10:09.31,0:10:10.77,Default,,0,0,0,,Спригган…
Dialogue: 0,0:10:12.11,0:10:14.11,Default,,0,0,0,,Ммм
Dialogue: 0,0:10:14.44,0:10:16.99,Default,,0,0,0,,Ах... Рахмет, Балто.
Dialogue: 0,0:10:17.07,0:10:18.45,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:10:18.53,0:10:20.78,Default,,0,0,0,,Аа, оның ерекше дәмі бар.
Dialogue: 0,0:10:20.99,0:10:23.45,Default,,0,0,0,,О! Өйткені мен көп нәрсе жасадым ...
Dialogue: 0,0:10:23.53,0:10:25.37,Default,,0,0,0,,Қалағаныңызша жей аласыз!
Dialogue: 0,0:10:26.00,0:10:27.25,Default,,0,0,0,,А...
Dialogue: 0,0:10:30.08,0:10:31.75,Default,,0,0,0,,Эй, мен оны білдім...
Dialogue: 0,0:10:31.83,0:10:33.92,Default,,0,0,0,,Сіз ертеректен жеміс алуға барғыңыз келе ме?
Dialogue: 0,0:10:34.00,0:10:35.76,Default,,0,0,0,,Бұл үлкен?
Dialogue: 0,0:10:35.84,0:10:39.22,Default,,0,0,0,,Жасырын дайындалып, жеңімпаз топты таң қалдырайық!
Dialogue: 0,0:10:39.30,0:10:40.68,Default,,0,0,0,,Хихихи
Dialogue: 0,0:10:43.43,0:10:46.85,Default,,0,0,0,,Содан кейін Йонекома Гакуэн Бей клубының командалық жарысы
Dialogue: 0,0:10:46.93,0:10:48.98,Default,,0,0,0,,Түскі ас сабағын бастайық
Dialogue: 0,0:10:49.06,0:10:50.39,Default,,0,0,0,,Қарсылық!
Dialogue: 0,0:10:50.69,0:10:53.40,Default,,0,0,0,,Мен неге бұл жігітпен бір командадамын?
Dialogue: 0,0:10:53.48,0:10:54.69,Default,,0,0,0,,(Изуку) Качан… әдетте оң қолымен мықты соққы жасап бастайды
Dialogue: 0,0:10:54.77,0:10:57.40,Default,,0,0,0,,Шағымдама, тас, қағаз, қайшы ойнап шештің.
Dialogue: 0,0:10:57.65,0:10:58.99,Default,,0,0,0,,Адамдар өте оңай өліп қалады, иә?
Dialogue: 0,0:10:59.07,0:11:01.28,Default,,0,0,0,,Жарайды, бастайық!
Dialogue: 0,0:11:01.66,0:11:03.82,Default,,0,0,0,,Эй, эй, мен мұны бірден істегім келеді!
Dialogue: 0,0:11:03.91,0:11:05.37,Default,,0,0,0,,Мен біріншімін!
Dialogue: 0,0:11:05.95,0:11:07.04,Default,,0,0,0,,Бірінші шайқас
Dialogue: 0,0:11:07.62,0:11:10.71,Default,,0,0,0,,Қызыл Қасиетті Хорсуд командасы қарсы.
Dialogue: 0,0:11:10.79,0:11:14.09,Default,,0,0,0,,Бұл көк жеңіс Валькири командасы.
Dialogue: 0,0:11:15.67,0:11:17.84,Default,,0,0,0,,Бұл қызықты стадион
Dialogue: 0,0:11:17.92,0:11:19.88,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:11:20.26,0:11:22.18,Default,,0,0,0,,Себебі мен таңертең қателестім.
Dialogue: 0,0:11:22.26,0:11:24.35,Default,,0,0,0,,Ол асық атпайды.
Dialogue: 0,0:11:24.72,0:11:26.39,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:11:26.76,0:11:29.43,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:11:29.52,0:11:31.44,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:11:34.81,0:11:37.23,Default,,0,0,0,,Не, тағы бір шапшаң ату?
Dialogue: 0,0:11:37.32,0:11:38.82,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:11:38.90,0:11:39.74,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:46.99,0:11:50.00,Default,,0,0,0,,Тағы да... не ойлап отырсың?
Dialogue: 0,0:11:50.20,0:11:52.92,Default,,0,0,0,,Алға, Валькири!
Dialogue: 0,0:11:54.79,0:11:55.79,Default,,0,0,0,,Не!
Dialogue: 0,0:11:56.13,0:11:58.30,Default,,0,0,0,,Ол ұсталғанша қашып кетті!
Dialogue: 0,0:11:58.63,0:12:00.38,Default,,0,0,0,,Балт Міне солай!
Dialogue: 0,0:12:00.46,0:12:02.30,Default,,0,0,0,,Бұл ояту күші...
Dialogue: 0,0:12:03.63,0:12:05.30,Default,,0,0,0,,《Ендеше, мен тыныш демала аламын》
Dialogue: 0,0:12:06.39,0:12:07.51,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:12:09.01,0:12:10.68,Default,,0,0,0,,Валькирияның жеңісі
Dialogue: 0,0:12:10.77,0:12:12.94,Default,,0,0,0,,Жарық аяқтау
Dialogue: 0,0:12:13.02,0:12:14.94,Default,,0,0,0,,Иә! (Рантаро) Жарайды!
Dialogue: 0,0:12:15.86,0:12:18.40,Default,,0,0,0,,Тағы бір ұпаймен біз жеңеміз!
Dialogue: 0,0:12:18.65,0:12:21.69,Default,,0,0,0,,Келесі кезекте Кумичо-сама...
Dialogue: 0,0:12:21.78,0:12:23.36,Default,,0,0,0,,Хона, мен барамын.
Dialogue: 0,0:12:23.45,0:12:25.91,Default,,0,0,0,,Сондықтан өз бетіңізше шешім қабылдамаңыз!
Dialogue: 0,0:12:26.07,0:12:28.83,Default,,0,0,0,,Егер олар келесі жолы жеңілсе, олар бірден шығады.
Dialogue: 0,0:12:29.16,0:12:30.83,Default,,0,0,0,,Бұл Шу шығар.
Dialogue: 0,0:12:31.25,0:12:32.66,Default,,0,0,0,,Сіз жеңе алмайсыз
Dialogue: 0,0:12:32.75,0:12:34.29,Default,,0,0,0,,Айтыңызшы!
Dialogue: 0,0:12:34.37,0:12:37.29,Default,,0,0,0,,Эй, матч кезінде төбелеспе.
Dialogue: 0,0:12:37.38,0:12:40.80,Default,,0,0,0,,Бірінші - Bay Rock Paper Scissors Pon!
Dialogue: 0,0:12:41.67,0:12:44.68,Default,,0,0,0,,Ах... (Рантаро/Вакия) Балто!
Dialogue: 0,0:12:45.55,0:12:47.47,Default,,0,0,0,,Бұл екінші шайқас.
Dialogue: 0,0:12:48.76,0:12:51.06,Default,,0,0,0,,Өйткені, Шудың қолынан келді.
Dialogue: 0,0:12:51.14,0:12:53.60,Default,,0,0,0,,Кумичо! Іске сәт!
Dialogue: 0,0:12:53.68,0:12:55.44,Default,,0,0,0,,Бұл мүмкін емес, мүлде
Dialogue: 0,0:12:55.77,0:12:57.23,Default,,0,0,0,,Аняро~
Dialogue: 0,0:12:57.31,0:13:00.40,Default,,0,0,0,,Бұл жерде жай ғана жеңіп, кезегіңнен айырылып қалма!
Dialogue: 0,0:13:00.94,0:13:02.11,Default,,0,0,0,,Бұл қалай болады?
Dialogue: 0,0:13:02.44,0:13:04.90,Default,,0,0,0,,Мен кеше қиғаш ату арқылы жеңдім.
Dialogue: 0,0:13:04.99,0:13:06.95,Default,,0,0,0,,Бірақ мен Шуумен жекпе-жекке шығамын.
Dialogue: 0,0:13:07.45,0:13:09.45,Default,,0,0,0,,Мен... Мен...
Dialogue: 0,0:13:09.87,0:13:11.95,Default,,0,0,0,,Ортада жеңіске жету~
Dialogue: 0,0:13:12.04,0:13:12.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:13.00,0:13:14.75,Default,,0,0,0,,Сіз міндетті түрде солай ойлайсыз.
Dialogue: 0,0:13:14.83,0:13:16.37,Default,,0,0,0,,Бет-әлпетіне қарап білуге болады
Dialogue: 0,0:13:16.46,0:13:17.63,Default,,0,0,0,,Ешқашан қайталанбасын
Dialogue: 0,0:13:18.04,0:13:19.71,Default,,0,0,0,,Дайын жинақ
Dialogue: 0,0:13:19.79,0:13:23.51,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:13:23.59,0:13:25.55,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:13:28.76,0:13:29.80,Default,,0,0,0,,Оқыңыз!
Dialogue: 0,0:13:29.89,0:13:31.47,Default,,0,0,0,,Қараңыз!
Dialogue: 0,0:13:37.81,0:13:40.77,Default,,0,0,0,,Мен бірінші байланыста шешім қабылдауды жоспарладым, бірақ...
Dialogue: 0,0:13:40.86,0:13:42.86,Default,,0,0,0,,Хуаншань күшейе түсті.
Dialogue: 0,0:13:43.19,0:13:45.11,Default,,0,0,0,,Рагнарук ішектері!
Dialogue: 0,0:13:46.95,0:13:48.41,Default,,0,0,0,,Қарсы үзіліс!
Dialogue: 0,0:13:51.95,0:13:52.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:53.41,0:13:54.54,Default,,0,0,0,,(жарқын дыбыс)
Dialogue: 0,0:13:55.66,0:13:59.12,Default,,0,0,0,,Спригганның дауылы
Dialogue: 0,0:13:59.50,0:14:02.21,Default,,0,0,0,,Мен бұл есікті жеңіп алар едім.
Dialogue: 0,0:14:02.55,0:14:04.17,Default,,0,0,0,,Мен айттым ғой!
Dialogue: 0,0:14:04.26,0:14:05.84,Default,,0,0,0,,Екеуің доғарыңдар.
Dialogue: 0,0:14:05.92,0:14:07.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:07.88,0:14:09.59,Default,,0,0,0,,Балто...!
Dialogue: 0,0:14:10.09,0:14:13.47,Default,,0,0,0,,Shake Shoot жолы Rash Shoot ойынына ұқсас.
Dialogue: 0,0:14:13.56,0:14:15.77,Default,,0,0,0,,Фанг ұстап алуы мүмкін
Dialogue: 0,0:14:15.85,0:14:18.60,Default,,0,0,0,,Death Sizer Valkyrie сияқты жылдамдыққа ие емес.
Dialogue: 0,0:14:19.06,0:14:20.65,Default,,0,0,0,,Бұл көлденең жолақ па?
Dialogue: 0,0:14:20.86,0:14:24.40,Default,,0,0,0,,Жоқ, ол міндетті түрде Комурасаки күткендей болады.
Dialogue: 0,0:14:26.40,0:14:27.78,Default,,0,0,0,,Үшінші шайқас
Dialogue: 0,0:14:27.86,0:14:29.45,Default,,0,0,0,,Dark Death Sizer Vs.
Dialogue: 0,0:14:29.53,0:14:31.66,Default,,0,0,0,,Бұл жабайы виверна.
Dialogue: 0,0:14:32.37,0:14:33.78,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:14:34.16,0:14:36.37,Default,,0,0,0,,Сіз күресіп жатқан қарсыласыңыз басқа...
Dialogue: 0,0:14:36.83,0:14:39.54,Default,,0,0,0,,Оның қалай шығатыны туралы бәрін оқи аласыз.
Dialogue: 0,0:14:41.04,0:14:42.79,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:14:43.13,0:14:46.21,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:46.42,0:14:47.30,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:14:47.38,0:14:49.63,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:53.55,0:14:54.97,Default,,0,0,0,,Шайқаңыз!
Dialogue: 0,0:14:55.06,0:14:57.31,Default,,0,0,0,,Білек бұрышы әдеттегіден тереңірек!
Dialogue: 0,0:14:57.39,0:14:59.06,Default,,0,0,0,,Бұл керемет жылдамдық!
Dialogue: 0,0:14:59.14,0:15:00.27,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:15:00.35,0:15:02.90,Default,,0,0,0,,Сонда сіздің шыдамыңыз тез таусылады.
Dialogue: 0,0:15:03.19,0:15:05.90,Default,,0,0,0,,Дайын болыңыз! Бар! Өлім сенер!
Dialogue: 0,0:15:12.91,0:15:14.78,Default,,0,0,0,,Сіз әлі ұмыттыңыз ба?
Dialogue: 0,0:15:14.87,0:15:16.08,Default,,0,0,0,,Shield Crash болып табылады
Dialogue: 0,0:15:16.16,0:15:19.25,Default,,0,0,0,,Шабуылдарды маятник принципі арқылы қайтаруға болады!
Dialogue: 0,0:15:19.33,0:15:20.16,Default,,0,0,0,,Оны ұсақтаңыз!
Dialogue: 0,0:15:20.25,0:15:21.04,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:15:22.37,0:15:24.42,Default,,0,0,0,,Ах! Міне бітті!
Dialogue: 0,0:15:25.84,0:15:26.96,Default,,0,0,0,,Не!
Dialogue: 0,0:15:27.59,0:15:30.67,Default,,0,0,0,,Shield Crash сипаттамаларын өз пайдаңызға пайдаланыңыз.
Dialogue: 0,0:15:31.09,0:15:32.13,Default,,0,0,0,,Оған сіздер, студенттер де кіресіздер.
Dialogue: 0,0:15:32.22,0:15:34.60,Default,,0,0,0,,Егер сіз оны Фангтың екінші жағына қарай итеруге батыл болсаңыз...
Dialogue: 0,0:15:35.18,0:15:37.31,Default,,0,0,0,,Азу тістегі түзу сызық
Dialogue: 0,0:15:38.18,0:15:40.18,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:15:41.73,0:15:45.27,Default,,0,0,0,,Dark Death Sizeer Burst Finish
Dialogue: 0,0:15:45.36,0:15:48.36,Default,,0,0,0,,Қызыл командасы 4 ұпаймен жеңеді
Dialogue: 0,0:15:48.69,0:15:49.49,Default,,0,0,0,,(бес жоғары дыбыс)
Dialogue: 0,0:15:49.57,0:15:51.07,Default,,0,0,0,,Керемет табыс!
Dialogue: 0,0:15:51.15,0:15:51.86,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:52.32,0:15:55.95,Default,,0,0,0,,Бұл... командалық шайқаста ғана шығарылатын күш!
Dialogue: 0,0:15:56.16,0:15:57.49,Default,,0,0,0,,Дассе!
Dialogue: 0,0:15:57.58,0:15:58.74,Default,,0,0,0,,Не!
Dialogue: 0,0:15:59.04,0:16:01.41,Default,,0,0,0,,Ей, эй, тағы бір рет жасайық!
Dialogue: 0,0:16:01.83,0:16:03.67,Default,,0,0,0,,Жаса! Жаса! Не?
Dialogue: 0,0:16:03.75,0:16:06.88,Default,,0,0,0,,Барт: Токонацу мен Ника әлі оралмады ма?
Dialogue: 0,0:16:07.17,0:16:09.38,Default,,0,0,0,,Ой, енді ойласам...
Dialogue: 0,0:16:09.46,0:16:12.17,Default,,0,0,0,,Эй... Сыртта жаңбыр жауып тұр.
Dialogue: 0,0:16:12.26,0:16:13.72,Default,,0,0,0,,О... О, жоқ!
Dialogue: 0,0:16:13.80,0:16:15.26,Default,,0,0,0,,Қанша жүрдіңіз...
Dialogue: 0,0:16:17.22,0:16:20.27,Default,,0,0,0,,Сәлем, бар! Вакия, оны ал!
Dialogue: 0,0:16:20.35,0:16:22.60,Default,,0,0,0,,Оны жауынгерлік жүлдеге айналдырыңыз!
Dialogue: 0,0:16:23.39,0:16:25.19,Default,,0,0,0,,Бұл жігіттер... Олай емес!
Dialogue: 0,0:16:25.31,0:16:27.02,Default,,0,0,0,,Вакия? (Рантаро) Эй!
Dialogue: 0,0:16:27.11,0:16:29.69,Default,,0,0,0,,(қатты жаңбырдың дыбысы)
Dialogue: 0,0:16:33.36,0:16:36.99,Default,,0,0,0,,Эй, бұл шынымен де төте жол ма?
Dialogue: 0,0:16:37.07,0:16:38.91,Default,,0,0,0,,Иә... мүмкін...
Dialogue: 0,0:16:40.58,0:16:43.25,Default,,0,0,0,,Токонацу! Ника!
Dialogue: 0,0:16:46.50,0:16:48.79,Default,,0,0,0,,Ақыр соңында, сен мұнда келдің...
Dialogue: 0,0:16:49.34,0:16:51.84,Default,,0,0,0,,Токонацу! Ника!
Dialogue: 0,0:16:54.38,0:16:56.30,Default,,0,0,0,,Сіз мұнда бардыңыз ба...
Dialogue: 0,0:16:58.14,0:17:00.06,Default,,0,0,0,,Мен үйге барғым келеді...
Dialogue: 0,0:17:00.43,0:17:01.27,Default,,0,0,0,,Ника…
Dialogue: 0,0:17:01.85,0:17:05.48,Default,,0,0,0,,Біз бұлай ешкімді кездестіре алмайтын шығармыз...
Dialogue: 0,0:17:05.94,0:17:08.35,Default,,0,0,0,,Сонымен... Сонымен...
Dialogue: 0,0:17:08.44,0:17:10.94,Default,,0,0,0,,Ух... мм...
Dialogue: 0,0:17:11.03,0:17:13.57,Default,,0,0,0,,Анашым!
Dialogue: 0,0:17:13.65,0:17:15.15,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:17:15.24,0:17:17.91,Default,,0,0,0,,Ника... Жыласаң жақсы емес.
Dialogue: 0,0:17:17.99,0:17:22.04,Default,,0,0,0,,Үлкен аға! Шуукун!
Dialogue: 0,0:17:22.12,0:17:25.25,Default,,0,0,0,,Жыласаң... Жыласаң жақсы емес...
Dialogue: 0,0:17:25.33,0:17:27.12,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:17:27.21,0:17:29.00,Default,,0,0,0,,(Токонацу Никаның жылаған дауысы)
Dialogue: 0,0:17:29.13,0:17:31.13,Default,,0,0,0,,Ол қайда? Сен қайдасың?
Dialogue: 0,0:17:31.59,0:17:35.76,Default,,0,0,0,,(Токонацу Никаның айқайы)
Dialogue: 0,0:17:35.84,0:17:37.55,Default,,0,0,0,,Токонацу! Ника!
Dialogue: 0,0:17:37.63,0:17:38.89,Default,,0,0,0,,Вакия…
Dialogue: 0,0:17:38.97,0:17:40.47,Default,,0,0,0,,Вакия!
Dialogue: 0,0:17:40.55,0:17:42.35,Default,,0,0,0,,Хо есік! Не...
Dialogue: 0,0:17:45.48,0:17:46.89,Default,,0,0,0,,Ал...
Dialogue: 0,0:17:47.02,0:17:48.15,Default,,0,0,0,,Мен үйге бара жатырмын...
Dialogue: 0,0:17:48.48,0:17:50.65,Default,,0,0,0,,(өзеннің турбулентті ағыны)
Dialogue: 0,0:17:51.19,0:17:53.86,Default,,0,0,0,,Ақан... Өзендегі су көбейіп барады.
Dialogue: 0,0:17:54.40,0:17:56.61,Default,,0,0,0,,(Никаның жылаған дауысы)
Dialogue: 0,0:17:56.70,0:17:59.74,Default,,0,0,0,,Жарайды! Әлі баратын жол бар!
Dialogue: 0,0:17:59.82,0:18:02.37,Default,,0,0,0,,(өзеннің турбулентті ағыны)
Dialogue: 0,0:18:02.74,0:18:04.62,Default,,0,0,0,,Бұл мүмкін емес~
Dialogue: 0,0:18:04.70,0:18:07.50,Default,,0,0,0,,Бұл биікке дейін қорқынышты.
Dialogue: 0,0:18:07.96,0:18:09.63,Default,,0,0,0,,Не айтып тұрсың...
Dialogue: 0,0:18:10.25,0:18:11.50,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:18:11.67,0:18:13.92,Default,,0,0,0,,Мен сізге еремін...
Dialogue: 0,0:18:15.34,0:18:17.42,Default,,0,0,0,,Вакия! Бала!
Dialogue: 0,0:18:17.51,0:18:18.34,Default,,0,0,0,,Хоудзи!
Dialogue: 0,0:18:18.43,0:18:19.64,Default,,0,0,0,,Бал-нии!
Dialogue: 0,0:18:19.72,0:18:21.72,Default,,0,0,0,,Мен сізге бірден көмектесемін!
Dialogue: 0,0:18:21.80,0:18:23.35,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе!
Dialogue: 0,0:18:25.35,0:18:27.85,Default,,0,0,0,,Жақсы! Мұны сіздің өмір жолыңыз етіңіз!
Dialogue: 0,0:18:28.23,0:18:29.27,Default,,0,0,0,,Көмектесіңіз!
Dialogue: 0,0:18:31.44,0:18:33.32,Default,,0,0,0,,Өмір желісі жеткілікті ұзақ!
Dialogue: 0,0:18:34.02,0:18:36.78,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:43.87,0:18:46.45,Default,,0,0,0,,Сәлем! Сен не істеп жатырсың!
Dialogue: 0,0:18:46.54,0:18:48.08,Default,,0,0,0,,Тез өт!
Dialogue: 0,0:18:48.54,0:18:50.83,Default,,0,0,0,,Бала биіктіктен қорқады.
Dialogue: 0,0:18:51.04,0:18:52.33,Default,,0,0,0,,Эх!
Dialogue: 0,0:18:52.88,0:18:55.30,Default,,0,0,0,,Ағайынды Бал келді!
Dialogue: 0,0:18:55.38,0:18:57.38,Default,,0,0,0,,Қазір бәрі жақсы, Вакия.
Dialogue: 0,0:18:57.88,0:19:00.43,Default,,0,0,0,,(сықырлаған көпір)
Dialogue: 0,0:19:00.51,0:19:02.01,Default,,0,0,0,,Төменге қарамаңыз!
Dialogue: 0,0:19:02.09,0:19:03.35,Default,,0,0,0,,Сендер де жақсы жүрсіңдер ғой, Танихара…
Dialogue: 0,0:19:03.72,0:19:06.64,Default,,0,0,0,,Вакия! Мен құламаймын!
Dialogue: 0,0:19:06.72,0:19:08.43,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:19:08.52,0:19:10.39,Default,,0,0,0,,Құлап қалмаңыз!
Dialogue: 0,0:19:10.64,0:19:13.73,Default,,0,0,0,,Идиот! Құлап жатыр деп айтпа!
Dialogue: 0,0:19:13.81,0:19:16.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:19:16.15,0:19:18.11,Default,,0,0,0,,Маған көмектес!
Dialogue: 0,0:19:21.82,0:19:24.03,Default,,0,0,0,,Әй, аспалы көпір бұзылғалы тұр!
Dialogue: 0,0:19:24.12,0:19:25.03,Default,,0,0,0,,Эх!
Dialogue: 0,0:19:26.58,0:19:28.66,Default,,0,0,0,,Бұлай жалғаса берсе, бәрі құлап қалады!
Dialogue: 0,0:19:28.75,0:19:30.87,Default,,0,0,0,,Вакия асығыңыз!
Dialogue: 0,0:19:30.96,0:19:33.04,Default,,0,0,0,,Жоқ, мен сізді естімеймін, себебі мен үрейленіп тұрмын!
Dialogue: 0,0:19:33.13,0:19:34.79,Default,,0,0,0,,Бала!
Dialogue: 0,0:19:34.88,0:19:35.54,Default,,0,0,0,,Балто!
Dialogue: 0,0:19:37.09,0:19:38.34,Default,,0,0,0,,Вакия~!
Dialogue: 0,0:19:38.59,0:19:40.42,Default,,0,0,0,,Токонацу! Ника!
Dialogue: 0,0:19:40.67,0:19:41.55,Default,,0,0,0,,Балто!
Dialogue: 0,0:19:41.63,0:19:42.72,Default,,0,0,0,,Бауырым!
Dialogue: 0,0:19:44.05,0:19:47.18,Default,,0,0,0,,Міне, мен тұрамын!
Dialogue: 0,0:19:47.26,0:19:49.35,Default,,0,0,0,,Идиот! Сонымен, тағы бір тесік бар ...
Dialogue: 0,0:19:49.73,0:19:51.39,Default,,0,0,0,,Оны ашпаңыз!
Dialogue: 0,0:19:51.48,0:19:52.85,Default,,0,0,0,,Маған сеніңіз!
Dialogue: 0,0:19:52.94,0:19:55.94,Default,,0,0,0,,Тыңда, кеттік! Иссей-но-се!
Dialogue: 0,0:19:56.02,0:19:57.98,Default,,0,0,0,,Әй, тезірек!
Dialogue: 0,0:20:00.61,0:20:02.40,Default,,0,0,0,,(арқан сықырлайды)
Dialogue: 0,0:20:02.49,0:20:05.03,Default,,0,0,0,,Өтінемін! Уақытында болыңыз!
Dialogue: 0,0:20:05.62,0:20:07.08,Default,,0,0,0,,Бар!
Dialogue: 0,0:20:10.16,0:20:11.91,Default,,0,0,0,,Өзіңізді көрсетіңіз!
Dialogue: 0,0:20:12.00,0:20:13.71,Default,,0,0,0,,Тағы біраз!
Dialogue: 0,0:20:13.79,0:20:15.63,Default,,0,0,0,,Бала!
Dialogue: 0,0:20:16.00,0:20:17.88,Default,,0,0,0,,А...
Dialogue: 0,0:20:17.96,0:20:19.38,Default,,0,0,0,,Вакия!
Dialogue: 0,0:20:24.84,0:20:26.55,Default,,0,0,0,,Дәл уақытында...
Dialogue: 0,0:20:26.64,0:20:29.43,Default,,0,0,0,,Ботчан (Рантаро) Адам, сен көрсеттің!
Dialogue: 0,0:20:29.51,0:20:31.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:31.10,0:20:32.02,Default,,0,0,0,,Не болды?
Dialogue: 0,0:20:34.52,0:20:37.56,Default,,0,0,0,,Балалар, сендер де жақсы жұмыс істеп жатырсыңдар...
Dialogue: 0,0:20:39.65,0:20:43.95,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:20:51.25,0:20:52.75,Default,,0,0,0,,Вакия!
Dialogue: 0,0:20:53.08,0:20:54.62,Default,,0,0,0,,Алдын ала рахмет!
Dialogue: 0,0:20:55.12,0:20:56.21,Default,,0,0,0,,Мен саған мынаны беремін!
Dialogue: 0,0:20:56.29,0:20:57.54,Default,,0,0,0,,Ертерек айтқаныңызға рахмет!
Dialogue: 0,0:20:57.75,0:20:58.79,Default,,0,0,0,,О
Dialogue: 0,0:21:01.00,0:21:02.13,Default,,0,0,0,,Бұл дәмді!
Dialogue: 0,0:21:02.63,0:21:03.72,Default,,0,0,0,,Хехехе
Dialogue: 0,0:21:03.92,0:21:05.34,Default,,0,0,0,,Сәлем Балто
Dialogue: 0,0:21:05.43,0:21:07.89,Default,,0,0,0,,Мен осы команданың капитанымын...
Dialogue: 0,0:21:08.10,0:21:09.18,Default,,0,0,0,,Әй, істе!
Dialogue: 0,0:21:09.51,0:21:11.97,Default,,0,0,0,,Иә! Уакия емес пе?
Dialogue: 0,0:21:12.43,0:21:15.73,Default,,0,0,0,,Мен бұл бейберекет жігіттерге қамқорлық жасай алмаймын!
Dialogue: 0,0:21:16.85,0:21:18.27,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:21:18.36,0:21:19.82,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:21:19.90,0:21:21.48,Default,,0,0,0,,Құттықтаймыз Бал-нии!
Dialogue: 0,0:21:21.57,0:21:22.78,Default,,0,0,0,,Мектеп оқушысы үшін ол өзімен бірге таңғаларлықтай 50 000 йен алып жүр
Dialogue: 0,0:21:25.15,0:21:26.20,Default,,0,0,0,,Әке болу мен агент болуды қатар алып жүру қиын болар
Dialogue: 0,0:21:26.57,0:21:28.32,Default,,0,0,0,,Хона мен үйге бара жатырмын
Dialogue: 0,0:21:29.07,0:21:30.41,Default,,0,0,0,,(Жан) Д… Жоқ, басқа нәрсе. Қара, ол сонда тұр.
Dialogue: 0,0:21:33.83,0:21:35.54,Default,,0,0,0,,А... біз ше?
Dialogue: 0,0:21:35.62,0:21:37.37,Default,,0,0,0,,Маған мінгізбейсіз бе...
Dialogue: 0,0:21:37.71,0:21:40.63,Default,,0,0,0,,Ол мүлде өзгерген жоқ!
Dialogue: 0,0:21:51.43,0:21:52.93,Default,,0,0,0,,Гочисо-сан
Dialogue: 0,0:22:08.36,0:22:14.45,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:14.66,0:22:20.79,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:21.25,0:22:26.80,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:27.26,0:22:30.59,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:30.76,0:22:35.68,Default,,0,0,0,,Сіз енді ешқашан жоғалмайсыз
Dialogue: 0,0:22:37.60,0:22:40.31,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:40.40,0:22:43.61,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:43.69,0:22:50.03,Default,,0,0,0,,Артынан қусаң да көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:50.28,0:22:55.83,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:55.99,0:23:02.58,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:03.17,0:23:08.59,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:08.76,0:23:11.93,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:12.43,0:23:16.39,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:25.77,0:23:28.86,Default,,0,0,0,,Ұлттық турнир ақыры басталады!
Dialogue: 0,0:23:28.94,0:23:31.70,Default,,0,0,0,,Мен ойыншы ант беруім керек.
Dialogue: 0,0:23:31.78,0:23:33.28,Default,,0,0,0,,Мен уайымдағанда, мен кездейсоқ...
Dialogue: 0,0:23:33.37,0:23:35.28,Default,,0,0,0,,Мен Валькириямды жоғалтып алдым!
Dialogue: 0,0:23:35.37,0:23:37.33,Default,,0,0,0,,Қайда кетті?
Dialogue: 0,0:23:37.41,0:23:40.71,Default,,0,0,0,,А, мен не істеуім керек?!
Dialogue: 0,0:23:41.08,0:23:43.00,Default,,0,0,0,,Келесі Бейблейд жарылысы
Dialogue: 0,0:23:43.08,0:23:45.25,Default,,0,0,0,,№1 мақсат қойыңыз!
Dialogue: 0,0:23:45.34,0:23:46.84,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:46.92,0:23:48.55,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:50.05,0:23:56.05,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory