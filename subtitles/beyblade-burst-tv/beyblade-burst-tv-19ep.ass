Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.54,0:00:09.05,Default,,0,0,0,,Бейблейд дегеніміз не?
Dialogue: 0,0:00:09.13,0:00:12.63,Default,,0,0,0,,Әлемдегі ең ләззат алған шайқас күнжіті
Dialogue: 0,0:00:12.72,0:00:14.68,Default,,0,0,0,,Іске қосу құрылғысынан шығатын шығанақ
Dialogue: 0,0:00:14.76,0:00:16.97,Default,,0,0,0,,Blader құмарлығымен
Dialogue: 0,0:00:17.05,0:00:18.72,Default,,0,0,0,,Олар стадионда соқтығысады.
Dialogue: 0,0:00:22.43,0:00:24.19,Default,,0,0,0,,Beyblade Burst дегеніміз не?
Dialogue: 0,0:00:24.27,0:00:26.23,Default,,0,0,0,,Шығанақтағы армандар үшін күрес
Dialogue: 0,0:00:26.31,0:00:28.69,Default,,0,0,0,,Бұл ер балалар туралы әңгіме.
Dialogue: 0,0:00:34.57,0:00:36.28,Default,,0,0,0,,Бірінші 1 ұпай алсаңыз да-
Dialogue: 0,0:00:36.36,0:00:39.12,Default,,0,0,0,,Мен қорғанысқа шықпаймын, мен шабуылға шығамын!
Dialogue: 0,0:00:39.20,0:00:41.33,Default,,0,0,0,,Саған көлеңкем түспесін!
Dialogue: 0,0:00:41.41,0:00:43.71,Default,,0,0,0,,Шешіңіз! Өлім сенер!
Dialogue: 0,0:00:47.46,0:00:49.96,Default,,0,0,0,,Цурануке! жалғыз мүйізді!
Dialogue: 0,0:00:55.68,0:00:56.97,Default,,0,0,0,,Ах...
Dialogue: 0,0:01:00.72,0:01:03.39,Default,,0,0,0,,Мен Өлімсізердің жауымын!
Dialogue: 0,0:01:04.77,0:01:07.27,Default,,0,0,0,,Кәне, жасайық! жалғыз мүйізді!
Dialogue: 0,0:01:07.35,0:01:09.52,Default,,0,0,0,,Мен сенің бұрышыңды бұзамын!
Dialogue: 0,0:01:09.61,0:01:10.69,Default,,0,0,0,,Бірмүйіз
Dialogue: 0,0:01:10.77,0:01:13.07,Default,,0,0,0,,Рагнаруктың көлеңкесінде жүреміз бе?
Dialogue: 0,0:01:13.61,0:01:15.20,Default,,0,0,0,,Бұл сізді алаңдатпасын!
Dialogue: 0,0:01:15.28,0:01:17.49,Default,,0,0,0,,Кумичо жеңді!
Dialogue: 0,0:01:17.82,0:01:19.78,Default,,0,0,0,,Kumicho Go!
Dialogue: 0,0:01:27.75,0:01:30.13,Default,,0,0,0,,Бейблейд! Бастайық
Dialogue: 0,0:01:30.46,0:01:35.63,Default,,0,0,0,,Ең мықты қуық болуды мақсат етейік
Dialogue: 0,0:01:46.94,0:01:50.31,Default,,0,0,0,,Мен барлығында бар екеніне сенімдімін.
Dialogue: 0,0:01:50.81,0:01:52.94,Default,,0,0,0,,Жеңіске ұмтылу сезімі
Dialogue: 0,0:01:53.36,0:01:57.49,Default,,0,0,0,,Сіздің жеке Бейблейдіңіз!
Dialogue: 0,0:01:57.61,0:02:00.82,Default,,0,0,0,,Дұрыс, бетпе-бет
Dialogue: 0,0:02:00.95,0:02:07.37,Default,,0,0,0,,Менің айналамда күштірек болғысы келетін сезім айналады.
Dialogue: 0,0:02:07.66,0:02:12.09,Default,,0,0,0,,АТЫС! Айналып келе жатқан арман
Dialogue: 0,0:02:12.59,0:02:18.01,Default,,0,0,0,,Құмарланып, тербеліп ойнайық
Dialogue: 0,0:02:18.13,0:02:20.39,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:20.47,0:02:25.18,Default,,0,0,0,,Біз міндетті түрде жеңеміз деген шынайы сезімдеріміз
Dialogue: 0,0:02:25.35,0:02:30.44,Default,,0,0,0,,Біз соқтығысқанда жара туады.
Dialogue: 0,0:02:30.73,0:02:32.98,Default,,0,0,0,,Шешуші сәт
Dialogue: 0,0:02:33.19,0:02:35.53,Default,,0,0,0,,Оны бірге қуайық!
Dialogue: 0,0:02:35.82,0:02:39.74,Default,,0,0,0,,Мен енді тоқтай алмаймын, мен шешуім керек
Dialogue: 0,0:02:39.90,0:02:44.91,Default,,0,0,0,,Ең күшті! Жарқын аяқтаңыз!
Dialogue: 0,0:02:45.12,0:02:47.29,Default,,0,0,0,,Үш екі бір ату!
Dialogue: 0,0:02:50.92,0:02:53.92,Default,,0,0,0,,Рагнарук VS Unicorn!
Dialogue: 0,0:02:55.92,0:02:57.55,Default,,0,0,0,,Жиренішті!
Dialogue: 0,0:02:57.63,0:02:58.97,Default,,0,0,0,,Бұл шынымен жиіркенішті!
Dialogue: 0,0:02:59.05,0:03:00.97,Default,,0,0,0,,Дина Укиодан жеңіліп қалды
Dialogue: 0,0:03:01.05,0:03:03.55,Default,,0,0,0,,Менің жеңілгенімнен, достарымның жеңілгені жақсы...
Dialogue: 0,0:03:03.64,0:03:05.05,Default,,0,0,0,,Одан да жиіркенішті!
Dialogue: 0,0:03:05.64,0:03:07.18,Default,,0,0,0,,Кумичо, жең!
Dialogue: 0,0:03:07.27,0:03:08.77,Default,,0,0,0,,Сөзсіз жеңіңіз!
Dialogue: 0,0:03:08.85,0:03:10.73,Default,,0,0,0,,Ер адам! Бірінші шайқас!
Dialogue: 0,0:03:19.24,0:03:21.20,Default,,0,0,0,,Unicorn құлпын ашу…
Dialogue: 0,0:03:21.28,0:03:23.91,Default,,0,0,0,,Сіз Dyna's Death Sizeer-ді ұшырып жібердіңіз.
Dialogue: 0,0:03:28.20,0:03:31.66,Default,,0,0,0,,Бір рет ұтыс ойынына әкелген Шакаға, Валькириге...
Dialogue: 0,0:03:31.92,0:03:35.08,Default,,0,0,0,,Бұл жігіт тәжірибеде бірнеше рет жеңіске жеткенін айтты.
Dialogue: 0,0:03:35.38,0:03:36.17,Default,,0,0,0,,Әй
Dialogue: 0,0:03:36.25,0:03:38.50,Default,,0,0,0,,Мүмкін бізде қызықты шайқас болады...
Dialogue: 0,0:03:38.76,0:03:40.09,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:03:40.17,0:03:41.26,Default,,0,0,0,,Уақыт уақыты!
Dialogue: 0,0:03:41.51,0:03:42.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:42.68,0:03:43.72,Default,,0,0,0,,Уақыт келді
Dialogue: 0,0:03:43.93,0:03:45.64,Default,,0,0,0,,Әй, не болды?
Dialogue: 0,0:03:45.76,0:03:47.10,Default,,0,0,0,,Тым толқыдым...
Dialogue: 0,0:03:47.18,0:03:48.89,Default,,0,0,0,,Жуынатын бөлмеге барғыңыз келді ме?
Dialogue: 0,0:03:49.64,0:03:51.27,Default,,0,0,0,,Мен бір нәрсені ұмытып қалдым.
Dialogue: 0,0:03:51.60,0:03:54.02,Default,,0,0,0,,Бұл не, Кумичо? Бірдеңе жоғалтты ма?
Dialogue: 0,0:03:54.65,0:03:57.07,Default,,0,0,0,,Дина, маған кеңес беріңізші.
Dialogue: 0,0:03:57.48,0:03:58.19,Default,,0,0,0,,А...
Dialogue: 0,0:03:58.52,0:04:00.32,Default,,0,0,0,,Тікелей шайқасқан сен...
Dialogue: 0,0:04:00.40,0:04:03.40,Default,,0,0,0,,You should know the most about that unicorn.
Dialogue: 0,0:04:03.61,0:04:05.62,Default,,0,0,0,,Бәрі жақсы, маған айт.
Dialogue: 0,0:04:06.45,0:04:07.37,Default,,0,0,0,,Бізді жай ғана адастырды!
Dialogue: 0,0:04:08.12,0:04:10.20,Default,,0,0,0,,Егер менің тәжірибем пайдалы болса
Dialogue: 0,0:04:11.04,0:04:11.79,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:04:11.87,0:04:13.29,Default,,0,0,0,,Бұл командалық ойын
Dialogue: 0,0:04:13.37,0:04:15.83,Default,,0,0,0,,Хихи, достар арасында бір-біріңе көмектесіңдер
Dialogue: 0,0:04:15.92,0:04:17.83,Default,,0,0,0,,Дұрыс, мынау.
Dialogue: 0,0:04:18.71,0:04:21.21,Default,,0,0,0,,Шу Сіз кірмейсіз бе?
Dialogue: 0,0:04:21.67,0:04:22.47,Default,,0,0,0,,О
Dialogue: 0,0:04:23.01,0:04:25.05,Default,,0,0,0,,Сіз бұрынғыдайсыз.
Dialogue: 0,0:04:25.80,0:04:27.51,Default,,0,0,0,,Мен жалғыз болғанды жөн көремін
Dialogue: 0,0:04:28.18,0:04:30.60,Default,,0,0,0,,Сізге ұқсайды, бірақ...
Dialogue: 0,0:04:31.52,0:04:33.39,Default,,0,0,0,,Командалар да жақсы.
Dialogue: 0,0:04:33.56,0:04:35.06,Default,,0,0,0,,Гахахахаха!
Dialogue: 0,0:04:35.27,0:04:38.82,Default,,0,0,0,,Құлыптан босатылған жалғыз мүйізді мүйіздің ең үлкен ерекшелігі...
Dialogue: 0,0:04:40.82,0:04:42.69,Default,,0,0,0,,Ауырлық орталығы төмен төмен диск және-
Dialogue: 0,0:04:42.78,0:04:44.28,Default,,0,0,0,,Бұл ине жүргізуші.
Dialogue: 0,0:04:44.86,0:04:46.91,Default,,0,0,0,,Төменгі дискінің ауырлық орталығы төмен
Dialogue: 0,0:04:47.32,0:04:49.78,Default,,0,0,0,,Ине жүргізуші түйіршікті.
Dialogue: 0,0:04:50.08,0:04:52.75,Default,,0,0,0,,Сізге шабуыл жасалса да, оның күшімен...
Dialogue: 0,0:04:52.83,0:04:54.50,Default,,0,0,0,,Орныңызда болыңыз
Dialogue: 0,0:04:55.16,0:04:56.29,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:04:56.37,0:04:57.67,Default,,0,0,0,,Бұл бәрі емес
Dialogue: 0,0:04:57.96,0:04:59.09,Default,,0,0,0,,Айналдыру кезінде-
Dialogue: 0,0:04:59.17,0:05:01.71,Default,,0,0,0,,Өлім Сізердің күші таратылды.
Dialogue: 0,0:05:01.80,0:05:04.17,Default,,0,0,0,,Бұл шабуылға ұшырауды білдіреді...
Dialogue: 0,0:05:04.26,0:05:07.26,Default,,0,0,0,,Сонымен, сіз Death Sizer-тің шыдамдылығын ұрладыңыз ба?
Dialogue: 0,0:05:07.34,0:05:08.89,Default,,0,0,0,,Егер қорғанысты күшейте алсаңыз...
Dialogue: 0,0:05:08.97,0:05:10.76,Default,,0,0,0,,Шабуыл жасау қиынға соғады
Dialogue: 0,0:05:11.18,0:05:12.60,Default,,0,0,0,,Мен болсам, тез шабуылдаушы едім!
Dialogue: 0,0:05:12.68,0:05:14.85,Default,,0,0,0,,Жарық түсіру арқылы шабуыл!
Dialogue: 0,0:05:14.93,0:05:18.06,Default,,0,0,0,,Рагнарукта флэш-сессия жоқ.
Dialogue: 0,0:05:19.19,0:05:22.11,Default,,0,0,0,,Рагнарук аймағының арнайы қозғалысы туралы не деуге болады?
Dialogue: 0,0:05:22.19,0:05:24.78,Default,,0,0,0,,Бұл төзімділік шайқасы.
Dialogue: 0,0:05:24.86,0:05:27.07,Default,,0,0,0,,Егер сіз оны ұзақ мерзімді шайқасқа айналдырсаңыз, сізде артықшылық болады.
Dialogue: 0,0:05:27.49,0:05:28.20,Default,,0,0,0,,дәл қазір менің алдымда тұр!
Dialogue: 0,0:05:28.28,0:05:31.37,Default,,0,0,0,,Жалғыз мүйізді қарсы тұруы мүмкін.
Dialogue: 0,0:05:33.24,0:05:35.04,Default,,0,0,0,,Көп нәрсе шықты...
Dialogue: 0,0:05:35.20,0:05:37.62,Default,,0,0,0,,Бұл сізде барлығына барудан басқа амал жоқ дегенді білдіреді!
Dialogue: 0,0:05:38.00,0:05:39.67,Default,,0,0,0,,Дина, маған қара!
Dialogue: 0,0:05:39.75,0:05:41.67,Default,,0,0,0,,Мен сені үрлеймін!
Dialogue: 0,0:05:42.13,0:05:44.09,Default,,0,0,0,,Сондықтан бұл Кумичо!
Dialogue: 0,0:05:44.17,0:05:47.76,Default,,0,0,0,,Жарайды, Балто, маған бу беріңіз!
Dialogue: 0,0:05:48.38,0:05:49.47,Default,,0,0,0,,Әке болу мен агент болуды қатар алып жүру қиын болар
Dialogue: 0,0:05:49.55,0:05:51.43,Default,,0,0,0,,Kumicho Go!
Dialogue: 0,0:05:52.10,0:05:53.01,Default,,0,0,0,,Хе-хе, түсінгеніңе ризамын.
Dialogue: 0,0:05:53.64,0:05:54.64,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:54.77,0:05:55.93,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:05:56.02,0:05:57.56,Default,,0,0,0,,Бал-нии тым көп істеп жатыр
Dialogue: 0,0:05:57.64,0:06:00.73,Default,,0,0,0,,Жақсы! Мен келе жатырмын!
Dialogue: 0,0:06:01.31,0:06:02.98,Default,,0,0,0,,Ер адам! Матч қайта жалғасты
Dialogue: 0,0:06:03.07,0:06:04.40,Default,,0,0,0,,Бірінші шайқас!
Dialogue: 0,0:06:04.90,0:06:07.11,Default,,0,0,0,,Менің жолдарым өзгеріссіз қалады
Dialogue: 0,0:06:07.36,0:06:08.99,Default,,0,0,0,,Мен сенің көлеңкеңді суға батырамын
Dialogue: 0,0:06:09.45,0:06:12.41,Default,,0,0,0,,Мен өз жолыммен шабуыл жасаймын!
Dialogue: 0,0:06:12.78,0:06:14.74,Default,,0,0,0,,Дайын жиынтық!
Dialogue: 0,0:06:15.79,0:06:19.17,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:06:19.25,0:06:21.42,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:06:24.80,0:06:26.63,Default,,0,0,0,,Диагональ бойынша түсіру
Dialogue: 0,0:06:26.84,0:06:28.97,Default,,0,0,0,,Хуаншан шабуылға шықты.
Dialogue: 0,0:06:31.39,0:06:32.55,Default,,0,0,0,,Енді Л тергеу мәліметтерінің маған тарағанын түсінгеннен кейін,
Dialogue: 0,0:06:32.80,0:06:34.97,Default,,0,0,0,,Қарсыласыңыздың артына шығыңыз, Unicorn!
Dialogue: 0,0:06:35.47,0:06:37.48,Default,,0,0,0,,Бұл да жақсы!
Dialogue: 0,0:06:38.18,0:06:42.15,Default,,0,0,0,,Рагнарук Көлеңке түсірме, алға қадам бас!
Dialogue: 0,0:06:43.65,0:06:44.44,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:06:44.73,0:06:47.03,Default,,0,0,0,,Рагнаруктың жылдамдығы жоғары
Dialogue: 0,0:06:47.44,0:06:49.28,Default,,0,0,0,,Жалғыз мүйізді қуып жетіңіз!
Dialogue: 0,0:06:49.36,0:06:50.11,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:06:50.20,0:06:51.53,Default,,0,0,0,,Міне!
Dialogue: 0,0:06:51.61,0:06:53.24,Default,,0,0,0,,Ах, қандай жалықтырарлық.
Dialogue: 0,0:06:55.08,0:06:56.74,Default,,0,0,0,,Көлеңкеде не бар?
Dialogue: 0,0:06:56.83,0:06:58.16,Default,,0,0,0,,Біз сізді бұрышта қалдырдық!
Dialogue: 0,0:06:58.25,0:07:00.83,Default,,0,0,0,,Рагнарукты ұшырып жібер!
Dialogue: 0,0:07:03.88,0:07:06.59,Default,,0,0,0,,Мен мұндай нәрсеге ұрынатын жалғыз мүйізді емеспін.
Dialogue: 0,0:07:07.05,0:07:09.17,Default,,0,0,0,,Эй, мен білемін!
Dialogue: 0,0:07:14.85,0:07:17.81,Default,,0,0,0,,Рагнарук бір мүйізді бірте-бірте итеріп жатыр!
Dialogue: 0,0:07:17.89,0:07:19.68,Default,,0,0,0,,Кумичо керемет!
Dialogue: 0,0:07:19.77,0:07:22.52,Default,,0,0,0,,Оңай қайтарылмайтын ине жүргізушінің ерекшеліктері
Dialogue: 0,0:07:22.60,0:07:23.90,Default,,0,0,0,,Мен оны пайдаландым.
Dialogue: 0,0:07:24.19,0:07:25.40,Default,,0,0,0,,Мен мұны істеймін...
Dialogue: 0,0:07:25.48,0:07:26.73,Default,,0,0,0,,Рантаро Кияма
Dialogue: 0,0:07:27.48,0:07:29.07,Default,,0,0,0,,Керемет!
Dialogue: 0,0:07:29.15,0:07:31.11,Default,,0,0,0,,Оны осылай итеріп шығаруға болады ма?
Dialogue: 0,0:07:31.20,0:07:32.78,Default,,0,0,0,,Мен бара аламын! Мен бара аламын!
Dialogue: 0,0:07:32.86,0:07:34.53,Default,,0,0,0,,Шығудың қажеті жоқ
Dialogue: 0,0:07:34.62,0:07:35.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:35.41,0:07:37.87,Default,,0,0,0,,Бұл Кумичоның мақсаты.
Dialogue: 0,0:07:43.08,0:07:44.25,Default,,0,0,0,,Спайк...
Dialogue: 0,0:07:44.79,0:07:46.84,Default,,0,0,0,,Алға, Рагнарук!
Dialogue: 0,0:07:46.92,0:07:49.21,Default,,0,0,0,,Оны шыңдарға дейін айналдырыңыз!
Dialogue: 0,0:07:52.80,0:07:53.68,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:07:53.76,0:07:54.51,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:07:56.93,0:07:57.64,Default,,0,0,0,,Үш ойыншы оны тежеп жатса да—
Dialogue: 0,0:07:58.22,0:07:59.52,Default,,0,0,0,,Тек соғыңыз!
Dialogue: 0,0:08:01.89,0:08:02.85,Default,,0,0,0,,Рагнарук!
Dialogue: 0,0:08:03.10,0:08:03.98,Default,,0,0,0,,Бірмүйіз!
Dialogue: 0,0:08:06.40,0:08:07.27,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:08:07.36,0:08:09.48,Default,,0,0,0,,Төзімді шайқастың уақыты келді!
Dialogue: 0,0:08:09.57,0:08:12.07,Default,,0,0,0,,Жабысқақтыққа келсек, Рагнарук жақсырақ.
Dialogue: 0,0:08:12.70,0:08:13.82,Default,,0,0,0,,Сіз жеңе аласыз...
Dialogue: 0,0:08:13.91,0:08:16.49,Default,,0,0,0,,Рагнарук... ұстаңыз!
Dialogue: 0,0:08:16.82,0:08:18.95,Default,,0,0,0,,Жалғыз мүйізді, айналуды жалғастырыңыз!
Dialogue: 0,0:08:40.31,0:08:41.31,Default,,0,0,0,,Екеуі де—
Dialogue: 0,0:08:41.39,0:08:43.81,Default,,0,0,0,,Айналдыру мәресі бір уақытта!
Dialogue: 0,0:08:44.14,0:08:44.94,Default,,0,0,0,,Еркек!
Dialogue: 0,0:08:45.02,0:08:46.77,Default,,0,0,0,,Қарғыс атсын, бұл тең ойын...
Dialogue: 0,0:08:47.06,0:08:48.94,Default,,0,0,0,,Мен сол жерде болдым
Dialogue: 0,0:08:49.32,0:08:50.90,Default,,0,0,0,,Стратегия жақсы болды, бірақ...
Dialogue: 0,0:08:50.98,0:08:52.53,Default,,0,0,0,,Бұл өкінішті болды.
Dialogue: 0,0:08:52.61,0:08:53.78,Default,,0,0,0,,Не...!
Dialogue: 0,0:08:53.86,0:08:55.32,Default,,0,0,0,,Рантаро Кияма
Dialogue: 0,0:08:55.66,0:08:59.62,Default,,0,0,0,,Мен оның ұлттық деңгейдегі ойыншы екенін асыға күттім.
Dialogue: 0,0:08:59.70,0:09:03.50,Default,,0,0,0,,Әйтеуір айлакер стратегиямен тең түсіп қалдық...
Dialogue: 0,0:09:03.58,0:09:04.87,Default,,0,0,0,,Сіз қолыңыздан келгеннің бәрін істеп жатырсыз ба?
Dialogue: 0,0:09:05.25,0:09:07.79,Default,,0,0,0,,Егер бұл жасырын стратегия болса...
Dialogue: 0,0:09:07.88,0:09:10.17,Default,,0,0,0,,Басқа адамдардың техникасы
Dialogue: 0,0:09:10.25,0:09:12.26,Default,,0,0,0,,Бұл флэш түсірілімге еліктеу шығар.
Dialogue: 0,0:09:12.51,0:09:15.51,Default,,0,0,0,,Басқа біреуге еліктегеніңіз үшін ұпай алсаңыз...
Dialogue: 0,0:09:15.59,0:09:18.22,Default,,0,0,0,,Достарым маған күле жаздады...
Dialogue: 0,0:09:18.59,0:09:21.51,Default,,0,0,0,,Еліктеу... Қайтадан айт!
Dialogue: 0,0:09:21.60,0:09:22.60,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:09:22.68,0:09:23.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:24.06,0:09:25.31,Default,,0,0,0,,Балаларға арналған тағам.
Dialogue: 0,0:09:26.39,0:09:27.69,Default,,0,0,0,,Сені махаббат сиқырымен баурап алатын боламын.
Dialogue: 0,0:09:27.77,0:09:29.27,Default,,0,0,0,,Екеуің де тоқтаңдар!
Dialogue: 0,0:09:29.36,0:09:31.57,Default,,0,0,0,,Ойын жүріп жатыр, ашуланба.
Dialogue: 0,0:09:31.65,0:09:32.57,Default,,0,0,0,,Сабырлы болыңыз
Dialogue: 0,0:09:32.65,0:09:33.44,Default,,0,0,0,,(Толық шоғырлану тынысы)
Dialogue: 0,0:09:33.53,0:09:34.78,Default,,0,0,0,,Сол мыңжапырақ...
Dialogue: 0,0:09:35.65,0:09:38.41,Default,,0,0,0,,Жеребеден көңілі қалған Укиоға да солай.
Dialogue: 0,0:09:38.49,0:09:39.24,Default,,0,0,0,,А...
Dialogue: 0,0:09:39.32,0:09:40.45,Default,,0,0,0,,Бұл психологиялық соғыс.
Dialogue: 0,0:09:40.53,0:09:42.16,Default,,0,0,0,,Мен сені жынды қылайын...
Dialogue: 0,0:09:42.24,0:09:44.66,Default,,0,0,0,,Мен екінші шайқасты тиімдірек етуге тырысамын.
Dialogue: 0,0:09:45.16,0:09:46.50,Default,,0,0,0,,Чикишум!
Dialogue: 0,0:09:46.83,0:09:50.29,Default,,0,0,0,,Мен оның жоспарына түсіп кете жаздадым!
Dialogue: 0,0:09:50.38,0:09:52.67,Default,,0,0,0,,Иә! Мені ашуландыратын стратегияңыз қандай?
Dialogue: 0,0:09:52.75,0:09:54.67,Default,,0,0,0,,Сіз бізді тыңдай алмайсыз!
Dialogue: 0,0:09:54.76,0:09:56.05,Default,,0,0,0,,Мен тыңдаймын
Dialogue: 0,0:09:56.13,0:09:57.51,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:09:57.59,0:09:59.39,Default,,0,0,0,,Бұл өте қызық.
Dialogue: 0,0:09:59.47,0:10:00.72,Default,,0,0,0,,Барттың командасы
Dialogue: 0,0:10:00.80,0:10:03.10,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:10:03.18,0:10:05.10,Default,,0,0,0,,Ер адам! Екінші шайқас!
Dialogue: 0,0:10:05.47,0:10:06.98,Default,,0,0,0,,Аняро~
Dialogue: 0,0:10:07.06,0:10:08.48,Default,,0,0,0,,Бұл тістерімді қақыратады, ақымақ! Ал, ал да кет.
Dialogue: 0,0:10:08.85,0:10:10.77,Default,,0,0,0,,Мен оның мұндай тактиканы қолданады деп ойламаппын...
Dialogue: 0,0:10:10.94,0:10:13.15,Default,,0,0,0,,Мен ойлағандай сақамды түсіре алмаймын.
Dialogue: 0,0:10:13.48,0:10:16.32,Default,,0,0,0,,Дәл осындай қозғалыс жұмыс істемейтін шығар...
Dialogue: 0,0:10:16.40,0:10:18.28,Default,,0,0,0,,Мен не істеуім керек, Рагнарук...
Dialogue: 0,0:10:18.45,0:10:20.66,Default,,0,0,0,,Хе... Менің кетуім керек!
Dialogue: 0,0:10:20.74,0:10:22.83,Default,,0,0,0,,Дайын жинақ!
Dialogue: 0,0:10:23.20,0:10:26.33,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:10:27.00,0:10:29.08,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:10:33.25,0:10:35.59,Default,,0,0,0,,Хуаншан шығанағын көлденең жіберді...
Dialogue: 0,0:10:36.05,0:10:37.17,Default,,0,0,0,,Бірақ қызық емес пе?
Dialogue: 0,0:10:37.26,0:10:39.30,Default,,0,0,0,,Кумичоның ерекше қозғалысы!
Dialogue: 0,0:10:39.59,0:10:41.39,Default,,0,0,0,,Рагнарук аймағы!
Dialogue: 0,0:10:50.81,0:10:52.98,Default,,0,0,0,,Маған кез келген жерден қоңырау шалыңыз!
Dialogue: 0,0:10:56.36,0:10:57.90,Default,,0,0,0,,Жақсы, Рагнарук!
Dialogue: 0,0:10:57.99,0:10:59.45,Default,,0,0,0,,Бас тартпаңыз!
Dialogue: 0,0:10:59.53,0:11:00.36,Default,,0,0,0,,бірақ соғыс бишісі Вараби-химе маған берген бұл белдемше
Dialogue: 0,0:11:00.74,0:11:02.32,Default,,0,0,0,,Рагнарук аймағы –
Dialogue: 0,0:11:02.41,0:11:04.91,Default,,0,0,0,,Төзімділік жоғалуын азайту әдістері...
Dialogue: 0,0:11:05.62,0:11:08.70,Default,,0,0,0,,Сіз оны өзіңіздің мамандығыңыз болып табылатын шыдамды шайқасқа әкелдіңіз бе?
Dialogue: 0,0:11:08.87,0:11:09.83,Default,,0,0,0,,Ей, ей, ей! Бар дейсің бе? Қайда, нақты қай жерде?
Dialogue: 0,0:11:12.83,0:11:13.92,Default,,0,0,0,,Жалғыз мүйізді…
Dialogue: 0,0:11:14.75,0:11:17.09,Default,,0,0,0,,Бірмүйіз күшін жоғалтып жатыр
Dialogue: 0,0:11:17.17,0:11:18.96,Default,,0,0,0,,Укио бұрышта тұр
Dialogue: 0,0:11:22.39,0:11:24.55,Default,,0,0,0,,Жалғыз мүйізді дірілдей бастады!
Dialogue: 0,0:11:24.64,0:11:26.26,Default,,0,0,0,,Егер сіз шабуыл жасағыңыз келсе, дәл қазір!
Dialogue: 0,0:11:26.35,0:11:28.14,Default,,0,0,0,,Жоқ, сол күйінде қалдырыңыз!
Dialogue: 0,0:11:28.81,0:11:31.02,Default,,0,0,0,,Рагнарук осылай күреседі!
Dialogue: 0,0:11:31.39,0:11:34.48,Default,,0,0,0,,Егер бұл төзімділік шайқасы болса, бұл!
Dialogue: 0,0:11:36.23,0:11:38.28,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:11:44.03,0:11:46.83,Default,,0,0,0,,Айналмалы финишпен көтерілген Рагнарук...
Dialogue: 0,0:11:46.91,0:11:47.83,Default,,0,0,0,,1 ұпай!
Dialogue: 0,0:11:48.24,0:11:49.45,Default,,0,0,0,,Хааа~
Dialogue: 0,0:11:49.54,0:11:50.96,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:51.04,0:11:53.17,Default,,0,0,0,,Иә! Кумичо!
Dialogue: 0,0:11:53.25,0:11:54.67,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:54.75,0:11:56.04,Default,,0,0,0,,Сіз қалай ойлайсыз? Барлығына!
Dialogue: 0,0:11:56.34,0:11:58.21,Default,,0,0,0,,Кумичо! Керемет!
Dialogue: 0,0:11:58.30,0:12:00.26,Default,,0,0,0,,Кумичо! Керемет!
Dialogue: 0,0:12:00.34,0:12:01.97,Default,,0,0,0,,Иә, олай етпе...
Dialogue: 0,0:12:02.17,0:12:03.34,Default,,0,0,0,,…ол қалағанынша барлығын басқара алады…
Dialogue: 0,0:12:03.51,0:12:04.76,Default,,0,0,0,,Фалько…
Dialogue: 0,0:12:05.05,0:12:06.85,Default,,0,0,0,,Мықты бол, Рагнарук!
Dialogue: 0,0:12:06.93,0:12:08.47,Default,,0,0,0,,Мен мұны істеймін~
Dialogue: 0,0:12:08.56,0:12:10.18,Default,,0,0,0,,Мен оны қарап шықтым~
Dialogue: 0,0:12:10.43,0:12:11.48,Default,,0,0,0,,Рантаро Кияма!
Dialogue: 0,0:12:11.56,0:12:12.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:12.14,0:12:13.06,Default,,0,0,0,,Адам ойыны
Dialogue: 0,0:12:13.14,0:12:15.19,Default,,0,0,0,,Сіз маған дәл көрсеттіңіз!
Dialogue: 0,0:12:15.27,0:12:16.11,Default,,0,0,0,,Лорд Тенген…
Dialogue: 0,0:12:16.44,0:12:19.40,Default,,0,0,0,,Укио, байсалды болатын кез келді.
Dialogue: 0,0:12:19.73,0:12:23.07,Default,,0,0,0,,Бізге шынымен келе жатқан басқа командаға бұл дөрекі.
Dialogue: 0,0:12:23.49,0:12:25.91,Default,,0,0,0,,Ең бастысы, мен сені осы уақытқа дейін апардым.
Dialogue: 0,0:12:26.03,0:12:28.20,Default,,0,0,0,,Рантаро Киямаға қарсы
Dialogue: 0,0:12:28.95,0:12:30.12,Default,,0,0,0,,Мен қойған сұрақтарға ғана жауап бер.
Dialogue: 0,0:12:30.70,0:12:31.75,Default,,0,0,0,,Не~!
Dialogue: 0,0:12:31.95,0:12:34.58,Default,,0,0,0,,Сіз осы уақытқа дейін байсалды емес едіңіз!
Dialogue: 0,0:12:34.67,0:12:35.67,Default,,0,0,0,,Кумичо
Dialogue: 0,0:12:36.08,0:12:38.88,Default,,0,0,0,,Бұл да сізді күлдіретін тактика болуы мүмкін.
Dialogue: 0,0:12:39.55,0:12:40.59,Default,,0,0,0,,Кешіріңіз, Сары тау
Dialogue: 0,0:12:40.67,0:12:41.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:41.67,0:12:43.13,Default,,0,0,0,,Мен Укиодамын...
Dialogue: 0,0:12:43.22,0:12:46.30,Default,,0,0,0,,Мен сізге арнайы қимылыңызды қолдануыңызды айтқым келді.
Dialogue: 0,0:12:46.80,0:12:48.30,Default,,0,0,0,,Арнайы қозғалыс...?
Dialogue: 0,0:12:48.51,0:12:51.77,Default,,0,0,0,,Шака Неге соны жауларыңа үйретпейсің?
Dialogue: 0,0:12:52.27,0:12:54.64,Default,,0,0,0,,Мен мұны жасыратын нәрсе емес деп ойлаймын.
Dialogue: 0,0:12:54.89,0:12:56.10,Default,,0,0,0,,Сәлем? Укио
Dialogue: 0,0:12:57.10,0:12:59.48,Default,,0,0,0,,Екінші шайқас жеңіліске ұшырады.
Dialogue: 0,0:12:59.69,0:13:01.36,Default,,0,0,0,,Сонымен, үшінші шайқас ше?
Dialogue: 0,0:13:01.69,0:13:03.82,Default,,0,0,0,,Жару үшін мүйізді атуды пайдаланыңыз!
Dialogue: 0,0:13:04.45,0:13:05.74,Default,,0,0,0,,Мүйіз ату...!
Dialogue: 0,0:13:06.03,0:13:08.74,Default,,0,0,0,,Unicorn-ның арнайы қозғалысының құлпын ашыңыз
Dialogue: 0,0:13:09.03,0:13:10.33,Default,,0,0,0,,Мүйіз ату…
Dialogue: 0,0:13:10.91,0:13:13.25,Default,,0,0,0,,Мен осы уақытқа дейін ешбір турнирге қатысқан жоқпын.
Dialogue: 0,0:13:13.33,0:13:14.83,Default,,0,0,0,,Ақпарат жоқ
Dialogue: 0,0:13:15.41,0:13:16.92,Default,,0,0,0,,Жаңа техника...
Dialogue: 0,0:13:17.54,0:13:19.71,Default,,0,0,0,,Жалғыз мүйізді — аңызға айналған бірмүйіз
Dialogue: 0,0:13:20.34,0:13:21.88,Default,,0,0,0,,Аты айтып тұрғандай -
Dialogue: 0,0:13:22.17,0:13:25.26,Default,,0,0,0,,Қарсыласыңызға өткір бұрышпен қарсы шабуыл жасау...
Dialogue: 0,0:13:26.05,0:13:27.64,Default,,0,0,0,,Мүйіз ату
Dialogue: 0,0:13:28.59,0:13:30.47,Default,,0,0,0,,Оны жегенде қатты болады.
Dialogue: 0,0:13:30.85,0:13:32.35,Default,,0,0,0,,Гахаха...
Dialogue: 0,0:13:32.97,0:13:36.02,Default,,0,0,0,,Сіздің техникаңызды алдын ала мәлімдегеніңіз...
Dialogue: 0,0:13:36.23,0:13:37.85,Default,,0,0,0,,Мен өте сенімдімін.
Dialogue: 0,0:13:38.23,0:13:41.11,Default,,0,0,0,,Уау! Жанып жатыр!
Dialogue: 0,0:13:41.19,0:13:43.44,Default,,0,0,0,,Мүйізді түсіру Мен түсіндім!
Dialogue: 0,0:13:44.19,0:13:45.15,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:13:45.24,0:13:47.91,Default,,0,0,0,,Жоқ, жоқ, бұл Балто емес.
Dialogue: 0,0:13:47.99,0:13:49.41,Default,,0,0,0,,Аа, дұрыс...
Dialogue: 0,0:13:49.49,0:13:50.99,Default,,0,0,0,,(ащы күлімсіреу)
Dialogue: 0,0:13:51.08,0:13:53.29,Default,,0,0,0,,Мүйіз ату немесе басқасы...
Dialogue: 0,0:13:53.37,0:13:55.50,Default,,0,0,0,,Менің Рагнарук қашпайды!
Dialogue: 0,0:13:55.58,0:13:57.21,Default,,0,0,0,,Бұл бетпе-бет шайқас!
Dialogue: 0,0:13:57.29,0:13:59.63,Default,,0,0,0,,О, дұрыс, Кумичо!
Dialogue: 0,0:13:59.96,0:14:02.25,Default,,0,0,0,,Осы сезім сияқты, ұнайды
Dialogue: 0,0:14:02.34,0:14:03.84,Default,,0,0,0,,Ол көтеріліп жатыр!
Dialogue: 0,0:14:03.92,0:14:06.80,Default,,0,0,0,,Құмар жанның өзі шығады!
Dialogue: 0,0:14:07.42,0:14:10.05,Default,,0,0,0,,Ер адамның ойыны осындай болуы керек!
Dialogue: 0,0:14:10.34,0:14:12.81,Default,,0,0,0,,Ер адам! Үшінші шайқас!
Dialogue: 0,0:14:13.22,0:14:15.35,Default,,0,0,0,,Егер сіз мүйізді түсіргіңіз келсе...
Dialogue: 0,0:14:15.43,0:14:18.39,Default,,0,0,0,,Мен тағы да Рагнарук аймағына барамын!
Dialogue: 0,0:14:18.77,0:14:21.11,Default,,0,0,0,,Хе, не қалайсың...
Dialogue: 0,0:14:21.73,0:14:24.98,Default,,0,0,0,,Мүйіз атудың қандай техникасы екеніне де қарамаңыз.
Dialogue: 0,0:14:25.19,0:14:27.57,Default,,0,0,0,,Мен Рагнарук аймағына баратынымды мәлімдедім.
Dialogue: 0,0:14:27.65,0:14:29.70,Default,,0,0,0,,Хуаншань Әлі ерте.
Dialogue: 0,0:14:29.99,0:14:33.58,Default,,0,0,0,,Шақа дұрыс айтса, мүйізді ату – қарсы әдіс.
Dialogue: 0,0:14:33.66,0:14:36.66,Default,,0,0,0,,Егер сіз шабуыл жасамасаңыз, сіз есептегішті алмайсыз.
Dialogue: 0,0:14:36.83,0:14:39.25,Default,,0,0,0,,Рагнарук аймағы дұрыс жауап болуы керек!
Dialogue: 0,0:14:39.58,0:14:41.54,Default,,0,0,0,,Жарайсың, Кумичо!
Dialogue: 0,0:14:41.92,0:14:44.63,Default,,0,0,0,,Мен мүйіз өркеннің қаншалықты үлкен екенін білмеймін...
Dialogue: 0,0:14:44.71,0:14:46.30,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:14:46.63,0:14:48.22,Default,,0,0,0,,Дайын жиынтық!
Dialogue: 0,0:14:48.59,0:14:51.72,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:14:52.05,0:14:54.18,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:14:57.14,0:14:58.18,Default,,0,0,0,,Иә, аға, сен кереметсің.
Dialogue: 0,0:14:58.27,0:15:00.60,Default,,0,0,0,,Бірмүйіздің жылдамдығы артып келеді
Dialogue: 0,0:15:01.23,0:15:02.65,Default,,0,0,0,,Жалғыз мүйізге барыңыз!
Dialogue: 0,0:15:02.73,0:15:04.23,Default,,0,0,0,,Орталықты ұстаңыз!
Dialogue: 0,0:15:09.03,0:15:10.86,Default,,0,0,0,,Орталық бірінші болып алынды!
Dialogue: 0,0:15:11.11,0:15:13.16,Default,,0,0,0,,Бұл Укионың стратегиясы ма...
Dialogue: 0,0:15:15.03,0:15:15.87,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:15:16.45,0:15:18.33,Default,,0,0,0,,Ине драйвері -
Dialogue: 0,0:15:18.41,0:15:19.41,Default,,0,0,0,,Фуми қалады!
Dialogue: 0,0:15:20.04,0:15:21.83,Default,,0,0,0,,Қарсы шабуыл позициясы...
Dialogue: 0,0:15:22.29,0:15:24.54,Default,,0,0,0,,Сіз мүйіздің атуын көре аласыз!
Dialogue: 0,0:15:24.63,0:15:26.63,Default,,0,0,0,,Жүр! Рагнарук!
Dialogue: 0,0:15:27.17,0:15:29.17,Default,,0,0,0,,Шешіңіз, жалғыз мүйізді!
Dialogue: 0,0:15:33.80,0:15:36.01,Default,,0,0,0,,(жылқының көрісі)
Dialogue: 0,0:15:41.39,0:15:42.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:43.69,0:15:44.94,Default,,0,0,0,,Рагнарук!
Dialogue: 0,0:15:46.52,0:15:47.86,Default,,0,0,0,,(жарық дыбыс)
Dialogue: 0,0:15:48.11,0:15:49.90,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:15:50.11,0:15:52.45,Default,,0,0,0,,Жалғыз мүйізді жару -
Dialogue: 0,0:15:52.53,0:15:54.03,Default,,0,0,0,,Юкифуки Укио жеңді!
Dialogue: 0,0:15:54.82,0:15:57.03,Default,,0,0,0,,Гуаааааааааааааааааааааааааа...
Dialogue: 0,0:16:00.25,0:16:01.58,Default,,0,0,0,,Бұл...
Dialogue: 0,0:16:01.83,0:16:04.33,Default,,0,0,0,,Бұл төзімділік сайысы емес еді.
Dialogue: 0,0:16:04.42,0:16:05.29,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:16:05.63,0:16:06.38,Default,,0,0,0,,Әй
Dialogue: 0,0:16:10.55,0:16:12.59,Default,,0,0,0,,Керемет...
Dialogue: 0,0:16:12.68,0:16:13.93,Default,,0,0,0,,Кумичо…
Dialogue: 0,0:16:20.14,0:16:22.35,Default,,0,0,0,,Әлі жеңілгеніміз жоқ.
Dialogue: 0,0:16:22.43,0:16:24.23,Default,,0,0,0,,Не? Өйткені...
Dialogue: 0,0:16:24.31,0:16:26.36,Default,,0,0,0,,Бұл шайқас командалық шайқас.
Dialogue: 0,0:16:26.65,0:16:27.69,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:27.77,0:16:28.94,Default,,0,0,0,,Дұрыс па?
Dialogue: 0,0:16:29.23,0:16:30.53,Default,,0,0,0,,Және қалағаныңа қол жеткізе алмасаң—
Dialogue: 0,0:16:31.03,0:16:33.40,Default,,0,0,0,,Олай болса келесі жолы ұтып ал.
Dialogue: 0,0:16:33.49,0:16:35.91,Default,,0,0,0,,Біздің команда әлі жеңілген жоқ.
Dialogue: 0,0:16:35.99,0:16:37.07,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:16:37.16,0:16:38.45,Default,,0,0,0,,Мен әлі жеңілген жоқпын!
Dialogue: 0,0:16:39.99,0:16:41.70,Default,,0,0,0,,Біз командамыз, солай ма?
Dialogue: 0,0:16:41.83,0:16:42.58,Default,,0,0,0,,О
Dialogue: 0,0:16:42.96,0:16:44.71,Default,,0,0,0,,Біз бір командамыз!
Dialogue: 0,0:16:44.96,0:16:47.21,Default,,0,0,0,,Менің жоғалтуым...
Dialogue: 0,0:16:47.29,0:16:49.59,Default,,0,0,0,,Бұл келесі шайқасқа әкеледі деп үміттенемін.
Dialogue: 0,0:16:49.92,0:16:51.59,Default,,0,0,0,,Дұрыс, Кумичо.
Dialogue: 0,0:16:51.67,0:16:53.34,Default,,0,0,0,,Жарайды, мені қос!
Dialogue: 0,0:16:53.42,0:16:54.30,Default,,0,0,0,,О!
Dialogue: 0,0:16:54.38,0:16:57.01,Default,,0,0,0,,Мен ең жек көретін сөздерім—
Dialogue: 0,0:16:58.72,0:16:59.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:00.68,0:17:03.93,Default,,0,0,0,,Мен мүйіздің оқынан бір соққымен жарылып кете алмадым...
Dialogue: 0,0:17:05.73,0:17:07.56,Default,,0,0,0,,Егер тікенектер болмаса...
Dialogue: 0,0:17:07.73,0:17:10.19,Default,,0,0,0,,Рагнарук шыдамды болуы мүмкін
Dialogue: 0,0:17:10.44,0:17:11.48,Default,,0,0,0,,Ер…
Dialogue: 0,0:17:11.69,0:17:15.45,Default,,0,0,0,,Бұл мүйізді жылтыратуға әлі де орын бар дегенді білдіреді.
Dialogue: 0,0:17:15.57,0:17:17.66,Default,,0,0,0,,Оның қабілетін танимын.
Dialogue: 0,0:17:17.74,0:17:19.07,Default,,0,0,0,,Сондықтан мен айттым
Dialogue: 0,0:17:19.16,0:17:21.45,Default,,0,0,0,,Хуаншань - сіз өзіңізді қорғай алмайтын адам.
Dialogue: 0,0:17:22.24,0:17:23.12,Default,,0,0,0,,Иә...
Dialogue: 0,0:17:24.91,0:17:27.33,Default,,0,0,0,,Хуаншан Бұл жақсы шайқас болды.
Dialogue: 0,0:17:27.88,0:17:28.92,Default,,0,0,0,,Шака…
Dialogue: 0,0:17:29.42,0:17:31.13,Default,,0,0,0,,Ха
Dialogue: 0,0:17:32.13,0:17:33.42,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:17:33.51,0:17:35.30,Default,,0,0,0,,Бұл Укионың байыптылығын көрсетті.
Dialogue: 0,0:17:35.51,0:17:36.97,Default,,0,0,0,,Рахмет
Dialogue: 0,0:17:37.26,0:17:40.89,Default,,0,0,0,,Оның үнемі өзін ұстайтын әдеті бар...
Dialogue: 0,0:17:41.26,0:17:41.89,Default,,0,0,0,,Хмф!
Dialogue: 0,0:17:42.35,0:17:44.52,Default,,0,0,0,,Келесі жолы мен мүлде жеңілмеймін!
Dialogue: 0,0:17:44.81,0:17:47.39,Default,,0,0,0,,Мен келесі матчқа барғым келеді, бірақ...
Dialogue: 0,0:17:48.19,0:17:50.56,Default,,0,0,0,,Түскі асқа дейін жаттығу уақыты.
Dialogue: 0,0:17:50.73,0:17:52.23,Default,,0,0,0,,Гахаха...
Dialogue: 0,0:17:52.36,0:17:53.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:54.11,0:17:56.95,Default,,0,0,0,,Менің артымнан ерсең, артымнан ер!
Dialogue: 0,0:17:57.03,0:17:58.57,Default,,0,0,0,,Укио мен барамын
Dialogue: 0,0:17:58.66,0:18:00.41,Default,,0,0,0,,Иә? ...Ах!
Dialogue: 0,0:18:01.74,0:18:03.54,Default,,0,0,0,,Біз де барайық!
Dialogue: 0,0:18:03.62,0:18:04.70,Default,,0,0,0,,Лорд Тенген…
Dialogue: 0,0:18:04.79,0:18:06.08,Default,,0,0,0,,Жоқ, өмірден бас тартпа
Dialogue: 0,0:18:07.25,0:18:09.54,Default,,0,0,0,,Не... не болды?
Dialogue: 0,0:18:09.88,0:18:12.29,Default,,0,0,0,,Инсуке... бірдеңе болып жатыр, солай ма?
Dialogue: 0,0:18:13.09,0:18:14.59,Default,,0,0,0,,Ештеңе...
Dialogue: 0,0:18:14.96,0:18:17.72,Default,,0,0,0,,Жасырмаңыз, біз бір командамыз.
Dialogue: 0,0:18:18.18,0:18:20.97,Default,,0,0,0,,Одан гөрі жаттығу жасайық!
Dialogue: 0,0:18:21.30,0:18:22.51,Default,,0,0,0,,Егер ол Кира болса, тергеу штабын басқаратын L —
Dialogue: 0,0:18:22.60,0:18:24.06,Default,,0,0,0,,Бұл не?!
Dialogue: 0,0:18:25.27,0:18:26.73,Default,,0,0,0,,Инсуке!
Dialogue: 0,0:18:29.60,0:18:31.31,Default,,0,0,0,,Күте тұрыңыз, Инуске!
Dialogue: 0,0:18:33.15,0:18:35.86,Default,,0,0,0,,Ол сондай жылдам еді...
Dialogue: 0,0:18:35.94,0:18:37.32,Default,,0,0,0,,Инсуке!
Dialogue: 0,0:18:38.28,0:18:40.32,Default,,0,0,0,,Не болды, Инуске?
Dialogue: 0,0:18:40.78,0:18:42.20,Default,,0,0,0,,Ештеңе!
Dialogue: 0,0:18:42.28,0:18:44.91,Default,,0,0,0,,Ештеңесі жоқ адамның мінезі осындай!
Dialogue: 0,0:18:44.99,0:18:47.20,Default,,0,0,0,,Сіз ештеңе жоқ дейсіз.
Dialogue: 0,0:18:47.29,0:18:49.12,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,0:18:49.21,0:18:50.25,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:18:55.55,0:18:57.21,Default,,0,0,0,,Мұндай жігіт...
Dialogue: 0,0:18:57.30,0:18:59.51,Default,,0,0,0,,Мен ешкімге жеңілмеймін!
Dialogue: 0,0:18:59.59,0:19:02.51,Default,,0,0,0,,Мен де барамын! Ілгері жүру!
Dialogue: 0,0:19:08.89,0:19:10.23,Default,,0,0,0,,Сөйле, Инуске
Dialogue: 0,0:19:10.73,0:19:12.31,Default,,0,0,0,,Біз бір командамыз, солай ма?
Dialogue: 0,0:19:13.73,0:19:15.69,Default,,0,0,0,,Жарайды, мен сөйлесемін.
Dialogue: 0,0:19:15.77,0:19:18.57,Default,,0,0,0,,Негізі бұл туралы әлі айтқым келмеді.
Dialogue: 0,0:19:20.90,0:19:23.91,Default,,0,0,0,,Маған әрқашан сіздің көзқарасыңыз қызық болды.
Dialogue: 0,0:19:24.16,0:19:26.54,Default,,0,0,0,,Дина түсінеді деп ойлаймын.
Dialogue: 0,0:19:26.62,0:19:27.79,Default,,0,0,0,,Мен туралы...
Dialogue: 0,0:19:28.04,0:19:30.25,Default,,0,0,0,,Сіз бір нәрсеге алаңдайсыз ба?
Dialogue: 0,0:19:32.83,0:19:34.79,Default,,0,0,0,,Біздің билікке не қатысымыз бар?
Dialogue: 0,0:19:36.04,0:19:36.96,Default,,0,0,0,,Иттерге қызмет көрсету…
Dialogue: 0,0:19:39.09,0:19:41.47,Default,,0,0,0,,Мен мектептерді ауыстыруым керек.
Dialogue: 0,0:19:41.68,0:19:42.72,Default,,0,0,0,,Не!
Dialogue: 0,0:19:44.09,0:19:46.26,Default,,0,0,0,,Осы жаттығу матчы аяқталғаннан кейін...
Dialogue: 0,0:19:46.35,0:19:48.47,Default,,0,0,0,,Қалаға қайтып келгенде, көшіңіз.
Dialogue: 0,0:19:49.18,0:19:50.73,Default,,0,0,0,,Не... неге...?
Dialogue: 0,0:19:51.14,0:19:53.19,Default,,0,0,0,,Үйдегі жұмыс міндеттеріне байланысты...
Dialogue: 0,0:19:53.48,0:19:55.44,Default,,0,0,0,,Сондықтан мектептер өзгереді...
Dialogue: 0,0:19:55.90,0:19:57.19,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:57.69,0:19:59.69,Default,,0,0,0,,Біз команда бола алсақ та...
Dialogue: 0,0:20:00.03,0:20:02.24,Default,,0,0,0,,Команда да бөлек...
Dialogue: 0,0:20:02.57,0:20:05.45,Default,,0,0,0,,Бұл жақсы емес! Мен тоқтай алмаймын...
Dialogue: 0,0:20:06.83,0:20:09.29,Default,,0,0,0,,Мен де тастағым келмейді...
Dialogue: 0,0:20:09.58,0:20:11.12,Default,,0,0,0,,Мен тастағым келмейді...
Dialogue: 0,0:20:12.25,0:20:13.37,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:13.58,0:20:16.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:20.67,0:20:23.22,Default,,0,0,0,,Не істеп жатырсың, ақымақ?
Dialogue: 0,0:20:23.30,0:20:24.30,Default,,0,0,0,,Барт…
Dialogue: 0,0:20:24.38,0:20:26.22,Default,,0,0,0,,Ақымақ болма!
Dialogue: 0,0:20:26.30,0:20:27.60,Default,,0,0,0,,♬ Соңғы межеге күйдіретін үнсіз ләуһит
Dialogue: 0,0:20:28.39,0:20:30.10,Default,,0,0,0,,Жіберме, Балто!
Dialogue: 0,0:20:30.18,0:20:32.35,Default,,0,0,0,,Өлсең де сөйлейсің бе?
Dialogue: 0,0:20:32.43,0:20:33.89,Default,,0,0,0,,Енді тартайық!
Dialogue: 0,0:20:34.27,0:20:36.23,Default,,0,0,0,,Куу!
Dialogue: 0,0:20:37.77,0:20:41.86,Default,,0,0,0,,(тыныс)
Dialogue: 0,0:20:42.61,0:20:43.70,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:20:44.40,0:20:45.99,Default,,0,0,0,,Бұл қауіпті болуы мүмкін!
Dialogue: 0,0:20:46.62,0:20:49.53,Default,,0,0,0,,Кешіріңіз, кешіріңіз...
Dialogue: 0,0:20:50.12,0:20:52.41,Default,,0,0,0,,Сәлем, Бар-ниис.
Dialogue: 0,0:20:52.50,0:20:55.12,Default,,0,0,0,,Шақа мен басқалары қайтып кетті...
Dialogue: 0,0:20:59.92,0:21:01.63,Default,,0,0,0,,А, мен қайтып келдім!
Dialogue: 0,0:21:01.71,0:21:02.92,Default,,0,0,0,,Бауырлар!
Dialogue: 0,0:21:06.13,0:21:06.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:15.06,0:21:16.77,Default,,0,0,0,,Бірдеңе болды...
Dialogue: 0,0:21:17.10,0:21:19.40,Default,,0,0,0,,Енді ойынды жалғастырайық!
Dialogue: 0,0:21:19.82,0:21:22.19,Default,,0,0,0,,Менің келесі қарсыласым кім?
Dialogue: 0,0:21:22.28,0:21:23.11,Default,,0,0,0,,Мен...
Dialogue: 0,0:21:23.19,0:21:24.74,Default,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,0:21:24.82,0:21:26.15,Default,,0,0,0,,Мені жіберіңізші!
Dialogue: 0,0:21:26.32,0:21:27.16,Default,,0,0,0,,Өйткені...
Dialogue: 0,0:21:27.24,0:21:27.95,Default,,0,0,0,,Балто!
Dialogue: 0,0:21:28.32,0:21:30.33,Default,,0,0,0,,Маған Инсукеге баруға рұқсат етіңізші.
Dialogue: 0,0:21:32.33,0:21:33.41,Default,,0,0,0,,Сонымен қатар, сен тоғыздық кестесін жатқа білмейсің бе?
Dialogue: 0,0:21:34.29,0:21:35.33,Default,,0,0,0,,Мен мұны істеймін!
Dialogue: 0,0:21:39.08,0:21:41.09,Default,,0,0,0,,Команда мүшесі ретінде -
Dialogue: 0,0:21:41.17,0:21:44.17,Default,,0,0,0,,Бұл менің соңғы шайқасым болуы мүмкін.
Dialogue: 0,0:21:44.80,0:21:45.84,Default,,0,0,0,,Барт…
Dialogue: 0,0:21:46.51,0:21:47.59,Default,,0,0,0,,Кумичо…
Dialogue: 0,0:21:48.43,0:21:49.43,Default,,0,0,0,,Дина…
Dialogue: 0,0:21:49.89,0:21:51.31,Default,,0,0,0,,Менің шайқасым-
Dialogue: 0,0:21:51.68,0:21:52.97,Default,,0,0,0,,Мені бақылаңыз!
Dialogue: 0,0:22:09.24,0:22:15.33,Default,,0,0,0,,Арқаңа үлкен үміт арту
Dialogue: 0,0:22:15.54,0:22:21.67,Default,,0,0,0,,Пойыз енді болашаққа қарай жүре бастады.
Dialogue: 0,0:22:22.13,0:22:27.67,Default,,0,0,0,,Арман билетіңізді мықтап ұстаңыз
Dialogue: 0,0:22:28.13,0:22:31.47,Default,,0,0,0,,Қорықпай жалғастырыңыз
Dialogue: 0,0:22:31.64,0:22:36.56,Default,,0,0,0,,Мен енді ешқашан адаспаймын
Dialogue: 0,0:22:38.48,0:22:41.19,Default,,0,0,0,,Шексіз ұзын рельс
Dialogue: 0,0:22:41.27,0:22:44.48,Default,,0,0,0,,Баратын жеріңізді өзіңіз шешіңіз
Dialogue: 0,0:22:44.57,0:22:50.91,Default,,0,0,0,,Артынан қусаң көретін декорация бар деп ойлаймын.
Dialogue: 0,0:22:51.16,0:22:56.70,Default,,0,0,0,,Жүгіру, жүгіруді жалғастыру, жүгіру
Dialogue: 0,0:22:56.87,0:23:03.46,Default,,0,0,0,,Көптеген кедергілерді жеңе отырып, біз күшейеміз
Dialogue: 0,0:23:04.04,0:23:09.47,Default,,0,0,0,,Бір күні атақ-даңққа жететін күнге дейін
Dialogue: 0,0:23:09.63,0:23:12.80,Default,,0,0,0,,Арман арман болып қалмайды
Dialogue: 0,0:23:13.30,0:23:17.27,Default,,0,0,0,,Ешқашан бітпейтін саяхат жалғасуда
Dialogue: 0,0:23:26.48,0:23:28.94,Default,,0,0,0,,Инсуке! Мен сенімді емеспін.
Dialogue: 0,0:23:29.03,0:23:31.49,Default,,0,0,0,,Мектептерді ауыстыру Неге күттіңіз!
Dialogue: 0,0:23:31.57,0:23:34.57,Default,,0,0,0,,Біз дос емеспіз бе?
Dialogue: 0,0:23:34.66,0:23:36.49,Default,,0,0,0,,Мен өзімді жалғыз уайымдағаныма сене алар емеспін...
Dialogue: 0,0:23:36.58,0:23:39.20,Default,,0,0,0,,Балалар... біз...
Dialogue: 0,0:23:39.29,0:23:41.50,Default,,0,0,0,,Біз енді команданың бір бөлігі емеспіз бе?
Dialogue: 0,0:23:41.92,0:23:43.92,Default,,0,0,0,,Келесі жолы Beblade Burst
Dialogue: 0,0:23:44.04,0:23:46.17,Default,,0,0,0,,Тізбекті түсіруді қосыңыз!
Dialogue: 0,0:23:46.25,0:23:47.92,Default,,0,0,0,,Үш екі бір
Dialogue: 0,0:23:48.00,0:23:49.80,Default,,0,0,0,,Бар, ат!
Dialogue: 0,0:23:51.30,0:23:57.30,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory