Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:18.26,0:00:21.68,Default,,0,0,0,,Өлгендерге шүкіршілік етейік
Dialogue: 0,0:00:29.40,0:00:33.19,Default,,0,0,0,,Бүгін де дүние жақсы көрінеді.
Dialogue: 0,0:00:33.90,0:00:36.07,Default,,0,0,0,,Қоштасу
Dialogue: 0,0:00:36.57,0:00:39.33,Default,,0,0,0,,Мына жиіркенішті дүниеде
Dialogue: 0,0:00:41.20,0:00:44.21,Default,,0,0,0,,Артқа жол жоқ
Dialogue: 0,0:00:47.54,0:00:49.54,Default,,0,0,0,,♪～
Dialogue: 0,0:02:14.50,0:02:16.51,Default,,0,0,0,,～♪
Dialogue: 0,0:02:30.40,0:02:32.65,Default,,0,0,0,,Теми жасаған сахна
Dialogue: 0,0:02:32.73,0:02:36.19,Default,,0,0,0,,Қан қалдырмай жоғалып кетті ме?
Dialogue: 0,0:02:37.78,0:02:38.74,Default,,0,0,0,,Ал ең бастысы, Иносукэ, өзің қалайсың?
Dialogue: 0,0:02:41.16,0:02:41.87,Default,,0,0,0,,Чи…
Dialogue: 0,0:02:42.37,0:02:45.08,Default,,0,0,0,,Ішкі ағзаларыңыз бір жерде зақымдалған сияқты.
Dialogue: 0,0:02:45.58,0:02:49.37,Default,,0,0,0,,Жарылыс салдарынан мен жақсы естімеймін.
Dialogue: 0,0:02:49.46,0:02:50.83,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:02:55.04,0:02:58.01,Default,,0,0,0,,Ячиру! Ячиру қайда!
Dialogue: 0,0:02:58.51,0:03:01.09,Default,,0,0,0,,Бұл аяқталды, жауап беріңіз!
Dialogue: 0,0:03:02.05,0:03:02.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:07.14,0:03:08.31,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:03:08.39,0:03:10.85,Default,,0,0,0,,Сіз жеңдіңіз, капитан!
Dialogue: 0,0:03:11.39,0:03:15.48,Default,,0,0,0,,Эй, сендер Ячируды сол жерде көрмедіңдер ме?
Dialogue: 0,0:03:15.57,0:03:16.65,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:16.73,0:03:18.82,Default,,0,0,0,,Жоқ, мен көрген жоқпын.
Dialogue: 0,0:03:18.90,0:03:20.74,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:03:20.82,0:03:21.95,Default,,0,0,0,,Капитанның орынбасары Кусака
Dialogue: 0,0:03:22.03,0:03:22.99,Default,,0,0,0,,Іздеу
Dialogue: 0,0:03:23.07,0:03:23.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:23.82,0:03:27.20,Default,,0,0,0,,Бірақ мен ешқандай реиатсуды сезбеймін, мен сенің қасыңда емеспін.
Dialogue: 0,0:03:27.29,0:03:28.49,Default,,0,0,0,,Оны іздеңіз!
Dialogue: 0,0:03:28.58,0:03:30.25,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:03:30.33,0:03:31.62,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:03:31.71,0:03:33.83,Default,,0,0,0,,Бөлініп, ізденіңдер!
Dialogue: 0,0:03:35.54,0:03:36.79,Default,,0,0,0,,Ячиру…
Dialogue: 0,0:03:41.47,0:03:42.43,Default,,0,0,0,,Ga!
Dialogue: 0,0:03:43.22,0:03:44.26,Default,,0,0,0,,Қайдан бастарын білмеймін.
Dialogue: 0,0:03:44.34,0:03:46.30,Default,,0,0,0,,Тосын шабуыл, лас!
Dialogue: 0,0:03:46.39,0:03:47.93,Default,,0,0,0,,Әзіл!
Dialogue: 0,0:03:48.01,0:03:50.77,Default,,0,0,0,,Қарсылас – Кенпачи Зараки.
Dialogue: 0,0:03:50.85,0:03:52.56,Default,,0,0,0,,Бұл табиғи нәрсе.
Dialogue: 0,0:03:52.64,0:03:55.06,Default,,0,0,0,,Бұл ыңғайсыздық! Мен сені үрлеймін!
Dialogue: 0,0:03:55.15,0:03:56.94,Default,,0,0,0,,Айқайламаңыз
Dialogue: 0,0:03:57.02,0:03:59.53,Default,,0,0,0,,Дереу жолдан кетіңіз.
Dialogue: 0,0:04:02.32,0:04:04.28,Default,,0,0,0,,Қараңызшы... не?
Dialogue: 0,0:04:08.08,0:04:09.87,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:04:12.96,0:04:15.46,Default,,0,0,0,,Капитан, сіз өлейін деп жатырсыз.
Dialogue: 0,0:04:15.54,0:04:18.00,Default,,0,0,0,,Асыққан уақыт босқа кетеді.
Dialogue: 0,0:04:20.63,0:04:21.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:21.71,0:04:23.59,Default,,0,0,0,,Эй... күте тұрыңыз.
Dialogue: 0,0:04:23.68,0:04:26.43,Default,,0,0,0,,Маған емес, капитанға жүгір.
Dialogue: 0,0:04:26.51,0:04:27.30,Default,,0,0,0,,Шу!
Dialogue: 0,0:04:27.39,0:04:30.72,Default,,0,0,0,,Сіз өзіңіздің біртүрлі күштеріңізді пайдаланып, мені өлтіруге тырысасыз, солай ма?
Dialogue: 0,0:04:30.81,0:04:32.73,Default,,0,0,0,,Бұл қорлау.
Dialogue: 0,0:04:32.81,0:04:36.10,Default,,0,0,0,,Менің бұлай күресуге қабілетім жоқ.
Dialogue: 0,0:04:36.19,0:04:38.98,Default,,0,0,0,,Мені қиюдың пайдасы жоқ.
Dialogue: 0,0:04:39.07,0:04:40.23,Default,,0,0,0,,Егер ағам мен әпкем әлі тірі болса…
Dialogue: 0,0:04:44.40,0:04:46.07,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:04:46.16,0:04:49.08,Default,,0,0,0,,Менің қаныма шомылдым
Dialogue: 0,0:04:49.16,0:04:51.87,Default,,0,0,0,,Қаныма шомылғанда
Dialogue: 0,0:04:51.95,0:04:56.46,Default,,0,0,0,,Менің айтқанымды ғана тыңдайтын мәйітке айналасың.
Dialogue: 0,0:04:59.25,0:05:01.80,Default,,0,0,0,,Иә! Барлығы сеппуку жасайды
Dialogue: 0,0:05:01.88,0:05:03.67,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:05:06.34,0:05:07.93,Default,,0,0,0,,Капитанды қорғаңыз!
Dialogue: 0,0:05:08.01,0:05:09.14,Default,,0,0,0,,Еш қағыспа!
Dialogue: 0,0:05:09.22,0:05:10.85,Default,,0,0,0,,Ра~ки!
Dialogue: 0,0:05:11.35,0:05:13.98,Default,,0,0,0,,Гвааах!
Dialogue: 0,0:05:16.85,0:05:19.81,Default,,0,0,0,,Өйткені ақымақтардың бәрі бір жерге жиналды
Dialogue: 0,0:05:19.90,0:05:21.90,Default,,0,0,0,,Бұл бір реттік мәміле емес пе?
Dialogue: 0,0:05:28.28,0:05:30.62,Default,,0,0,0,,Зако кеткенде
Dialogue: 0,0:05:30.70,0:05:34.12,Default,,0,0,0,,Тез арада басымды алып қалар ма екенмін. Бұл арнайы әскери күш.
Dialogue: 0,0:05:36.04,0:05:36.71,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:38.50,0:05:39.50,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:05:41.00,0:05:42.13,Default,,0,0,0,,Ал ең бастысы, Иносукэ, өзің қалайсың?
Dialogue: 0,0:05:47.80,0:05:50.22,Default,,0,0,0,,Бұл өлейін деп жатқан адамның қимылы емес!
Dialogue: 0,0:05:50.30,0:05:52.39,Default,,0,0,0,,Сондықтан да болар, бұл ерекше күш.
Dialogue: 0,0:05:58.64,0:06:00.10,Default,,0,0,0,,Абуни
Dialogue: 0,0:06:00.19,0:06:03.48,Default,,0,0,0,,Гремимен жасаған әрекеттен кейін қалай осылай қозғалуға болады?
Dialogue: 0,0:06:03.57,0:06:05.23,Default,,0,0,0,,Бұл құбыжық па?
Dialogue: 0,0:06:10.45,0:06:11.74,Default,,0,0,0,,Темера...
Dialogue: 0,0:06:11.82,0:06:14.24,Default,,0,0,0,,Сіз әлі ояусыз ба?
Dialogue: 0,0:06:14.33,0:06:16.04,Default,,0,0,0,,Тек өл!
Dialogue: 0,0:06:27.17,0:06:29.09,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:06:29.18,0:06:31.55,Default,,0,0,0,,Бұл жәндіктердің тынысы деп аталады, солай ма?
Dialogue: 0,0:06:32.43,0:06:34.31,Default,,0,0,0,,Маған соңғы соққыны кім береді?
Dialogue: 0,0:06:34.39,0:06:36.27,Default,,0,0,0,,Менің ойымша, Гуппер әділ.
Dialogue: 0,0:06:36.35,0:06:39.73,Default,,0,0,0,,Уф... Мен денемді қозғалта алмаймын.
Dialogue: 0,0:06:40.65,0:06:41.40,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:06:41.90,0:06:43.90,Default,,0,0,0,,Барлығы осы ма?
Dialogue: 0,0:06:45.57,0:06:47.44,Default,,0,0,0,,Капитан Заракидің реятсу...
Dialogue: 0,0:06:47.94,0:06:49.32,Default,,0,0,0,,Руқиядан ауытқыма
Dialogue: 0,0:06:49.90,0:06:54.08,Default,,0,0,0,,Соңғы шайқастағы тозудан әлі айыға алмадыңыз.
Dialogue: 0,0:06:54.16,0:06:55.49,Default,,0,0,0,,Бірақ аға...
Dialogue: 0,0:06:55.99,0:06:56.66,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:58.70,0:06:59.41,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:03.50,0:07:06.38,Default,,0,0,0,,Сенде солай болды ма, аға?
Dialogue: 0,0:07:20.48,0:07:21.81,Default,,0,0,0,,Бұл қайталау...
Dialogue: 0,0:07:24.06,0:07:25.44,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:26.77,0:07:27.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:30.57,0:07:31.53,Default,,0,0,0,,Не?
Dialogue: 0,0:07:32.16,0:07:33.74,Default,,0,0,0,,Не келді?
Dialogue: 0,0:07:37.12,0:07:37.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:38.54,0:07:40.25,Default,,0,0,0,,Құлаған сияқты болды ма?
Dialogue: 0,0:07:40.75,0:07:41.66,Default,,0,0,0,,Құлды.
Dialogue: 0,0:07:42.17,0:07:43.21,Default,,0,0,0,,Өтірікші
Dialogue: 0,0:07:43.29,0:07:44.75,Default,,0,0,0,,Сіз —
Dialogue: 0,0:07:44.83,0:07:47.38,Default,,0,0,0,,Сіз тым ынталы болдыңыз.
Dialogue: 0,0:07:49.26,0:07:50.67,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:07:52.51,0:07:55.64,Default,,0,0,0,,Бұл не? Мұның бәрі тозған, солай емес пе? Кенпачи
Dialogue: 0,0:07:57.43,0:08:00.98,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:08:02.89,0:08:06.23,Default,,0,0,0,,Саған осылай айтатын уақыт келеді деп ойламаппын.
Dialogue: 0,0:08:13.40,0:08:14.78,Default,,0,0,0,,Мен көмектесуге келдім.
Dialogue: 0,0:08:16.20,0:08:17.03,Default,,0,0,0,,Ха…
Dialogue: 0,0:08:17.95,0:08:21.29,Default,,0,0,0,,Мен саған көмектесемін деп ешқашан ойламаппын...
Dialogue: 0,0:08:21.37,0:08:23.29,Default,,0,0,0,,Мен оны келеді деп күтпедім.
Dialogue: 0,0:08:23.79,0:08:24.67,Default,,0,0,0,,Сіз тұра аласыз ба?
Dialogue: 0,0:08:25.58,0:08:27.29,Default,,0,0,0,,Сен тұра аласың ба?
Dialogue: 0,0:08:28.04,0:08:29.25,Default,,0,0,0,,Ақымақ болма.
Dialogue: 0,0:08:29.75,0:08:32.88,Default,,0,0,0,,Менен гөрі сені уайымда.
Dialogue: 0,0:08:37.76,0:08:38.47,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:38.97,0:08:39.93,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:48.19,0:08:48.94,Default,,0,0,0,,Уау
Dialogue: 0,0:08:50.65,0:08:51.48,Default,,0,0,0,,Аһ!
Dialogue: 0,0:08:51.57,0:08:52.40,Default,,0,0,0,,Аһ!
Dialogue: 0,0:08:52.49,0:08:53.40,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:00.99,0:09:02.41,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:09:02.91,0:09:04.83,Default,,0,0,0,,Мен күзетімді түсірдім.
Dialogue: 0,0:09:05.33,0:09:08.00,Default,,0,0,0,,Қауіпсіздікке жол бермеңіз, бұл орынды.
Dialogue: 0,0:09:08.79,0:09:11.38,Default,,0,0,0,,Бұл жігіт ең көрнекті күш...
Dialogue: 0,0:09:12.13,0:09:13.63,Default,,0,0,0,,Бұл Ичиго Куросаки.
Dialogue: 0,0:09:14.97,0:09:16.84,Default,,0,0,0,,Шу!
Dialogue: 0,0:09:16.93,0:09:17.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:17.84,0:09:20.85,Default,,0,0,0,,Арнайы күш? Ичиго Куросаки?
Dialogue: 0,0:09:20.93,0:09:22.60,Default,,0,0,0,,Сіз мұны білесіз бе?
Dialogue: 0,0:09:23.35,0:09:27.48,Default,,0,0,0,,Мені шаң басып қалған жалғыз нәрсе...
Dialogue: 0,0:09:27.56,0:09:29.94,Default,,0,0,0,,Мен сені ешқашан кешірмеймін!
Dialogue: 0,0:09:30.44,0:09:34.49,Default,,0,0,0,,Күн сайын басқалардан неше сағат ерте оянып, шашыңызды қайырамын деп ойлайсыз?
Dialogue: 0,0:09:34.57,0:09:35.86,Default,,0,0,0,,Қат!
Dialogue: 0,0:09:37.45,0:09:39.49,Default,,0,0,0,,Уау, өте қорқынышты
Dialogue: 0,0:09:39.57,0:09:41.28,Default,,0,0,0,,Міне, ашуланасың.
Dialogue: 0,0:09:47.21,0:09:48.87,Default,,0,0,0,,Гальвано жарылысы!
Dialogue: 0,0:09:52.13,0:09:55.05,Default,,0,0,0,,5 гигаджоульмен күлге айналдыр, қарғыс атсын!
Dialogue: 0,0:09:55.13,0:09:59.89,Default,,0,0,0,,Идиот, Қасиетті өлтіруші жебесінен (Гейрих Пфейл) бір немесе екі оқ сізді өлтіреді.
Dialogue: 0,0:10:12.69,0:10:13.69,Default,,0,0,0,,Қараңызшы... не?
Dialogue: 0,0:10:24.33,0:10:28.21,Default,,0,0,0,,Келдің бе? Ичиго Куросаки
Dialogue: 0,0:10:34.30,0:10:35.42,Default,,0,0,0,,Бастайық
Dialogue: 0,0:10:36.17,0:10:39.26,Default,,0,0,0,,Хашвальд Урю
Dialogue: 0,0:10:41.39,0:10:43.01,Default,,0,0,0,,Бұл басталады ма?
Dialogue: 0,0:10:43.51,0:10:44.51,Default,,0,0,0,,Қазір...
Dialogue: 0,0:10:45.01,0:10:48.68,Default,,0,0,0,,Мен таңдай аламын ба?
Dialogue: 0,0:10:55.15,0:10:56.69,Default,,0,0,0,,Біл... уф!
Dialogue: 0,0:10:57.28,0:10:57.99,Default,,0,0,0,,Буха!
Dialogue: 0,0:10:58.49,0:10:59.11,Default,,0,0,0,,Мен шайқаса аламын!
Dialogue: 0,0:10:59.61,0:11:02.28,Default,,0,0,0,,Әдейі істедің, қарғыс атқыр!
Dialogue: 0,0:11:03.66,0:11:05.66,Default,,0,0,0,,Жоқ, бұл күшті.
Dialogue: 0,0:11:06.16,0:11:09.04,Default,,0,0,0,,Сонша тастасаң да бәрі қайтады.
Dialogue: 0,0:11:09.12,0:11:10.66,Default,,0,0,0,,Бұл тітіркендіргіш.
Dialogue: 0,0:11:10.75,0:11:12.42,Default,,0,0,0,,(Мадо) Бірақ… (Иба) Мадо!
Dialogue: 0,0:11:12.50,0:11:14.96,Default,,0,0,0,,Біз бүгін сирек келісеміз.
Dialogue: 0,0:11:15.04,0:11:16.17,Default,,0,0,0,,Мен келісемін.
Dialogue: 0,0:11:16.25,0:11:19.05,Default,,0,0,0,,Барлығы келіссе, әлі ерте.
Dialogue: 0,0:11:20.42,0:11:22.30,Default,,0,0,0,,Орындау туралы шешім қабылданды!
Dialogue: 0,0:11:22.39,0:11:23.80,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:11:23.89,0:11:26.01,Default,,0,0,0,,Мен шаршадым, өйткені мен шаршадым
Dialogue: 0,0:11:26.10,0:11:28.56,Default,,0,0,0,,Меніңше, сойған жақсы емес.
Dialogue: 0,0:11:28.64,0:11:31.27,Default,,0,0,0,,Түсіндім! Онда қара
Dialogue: 0,0:11:31.35,0:11:33.81,Default,,0,0,0,,Арнайы күштер тізімінің жоғарғы жағы: Мені өлтіріңіз.
Dialogue: 0,0:11:33.90,0:11:36.27,Default,,0,0,0,,Мен барлық несиені аламын!
Dialogue: 0,0:11:41.45,0:11:42.91,Default,,0,0,0,,Гальвано Джавелин!
Dialogue: 0,0:11:45.95,0:11:47.70,Default,,0,0,0,,Гецуга Теншо
Dialogue: 0,0:11:53.58,0:11:55.00,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:12:00.55,0:12:01.51,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:12:01.59,0:12:03.97,Default,,0,0,0,,Мінсіз Евхаристия болғаны дұрыс емес пе?
Dialogue: 0,0:12:04.47,0:12:05.93,Default,,0,0,0,,Дартеннен артық
Dialogue: 0,0:12:06.43,0:12:08.14,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:12:08.64,0:12:10.47,Default,,0,0,0,,Мұны істеудің қажеті жоқ.
Dialogue: 0,0:12:10.98,0:12:12.85,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:12:12.94,0:12:14.65,Default,,0,0,0,,Склавера
Dialogue: 0,0:12:17.73,0:12:19.28,Default,,0,0,0,,Sklaverei
Dialogue: 0,0:12:22.19,0:12:23.57,Default,,0,0,0,,Sklaverei
Dialogue: 0,0:12:27.12,0:12:28.70,Default,,0,0,0,,Құдайдың өлімі
Dialogue: 0,0:12:32.08,0:12:33.58,Default,,0,0,0,,Құдайдың күші (Пунипора)
Dialogue: 0,0:12:38.92,0:12:40.09,Default,,0,0,0,,Құдайдың аштығы
Dialogue: 0,0:12:43.88,0:12:45.43,Default,,0,0,0,,Гантельді шаң жинағыш
Dialogue: 0,0:12:47.80,0:12:49.68,Default,,0,0,0,,Гантельді шайқау
Dialogue: 0,0:12:52.73,0:12:53.43,Default,,0,0,0,,Сөз сөйледі
Dialogue: 0,0:12:57.06,0:12:57.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:58.98,0:12:59.69,Default,,0,0,0,,Spiff
Dialogue: 0,0:13:06.95,0:13:09.74,Default,,0,0,0,,Хмм!
Dialogue: 0,0:13:10.74,0:13:13.79,Default,,0,0,0,,Би өлі жігіттер клубы!
Dialogue: 0,0:13:18.42,0:13:19.96,Default,,0,0,0,,♪ Хун ху хун хун
Dialogue: 0,0:13:23.55,0:13:24.17,Default,,0,0,0,,Әй!
Dialogue: 0,0:13:25.30,0:13:26.88,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:28.72,0:13:29.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:30.35,0:13:32.22,Default,,0,0,0,,Itadaki~!
Dialogue: 0,0:13:33.56,0:13:35.85,Default,,0,0,0,,...
Dialogue: 0,0:13:37.10,0:13:37.60,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:38.98,0:13:41.82,Default,,0,0,0,,Менің ойымша, арнайы күштер жақсы.
Dialogue: 0,0:13:42.32,0:13:43.61,Default,,0,0,0,,Алтын сын!
Dialogue: 0,0:13:43.69,0:13:45.07,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:50.37,0:13:51.70,Default,,0,0,0,,Мен құтқарылдым~
Dialogue: 0,0:13:51.78,0:13:52.70,Default,,0,0,0,,Чи…
Dialogue: 0,0:13:53.79,0:13:55.12,Default,,0,0,0,,Гантельді шаң жинағыш
Dialogue: 0,0:13:55.20,0:13:56.12,Default,,0,0,0,,Хартелес!
Dialogue: 0,0:13:57.08,0:13:58.00,Default,,0,0,0,,Апыр-ай!? (Лорд Джоэстар) С… Сен…
Dialogue: 0,0:14:00.33,0:14:01.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:01.42,0:14:02.38,Default,,0,0,0,,Мазасыздық!
Dialogue: 0,0:14:08.59,0:14:11.10,Default,,0,0,0,,Өзіңді тым мақтаншақ сезінбе.
Dialogue: 0,0:14:11.60,0:14:12.64,Default,,0,0,0,,Склавера!
Dialogue: 0,0:14:19.69,0:14:21.06,Default,,0,0,0,,Құдайдың найзағайы!
Dialogue: 0,0:14:22.90,0:14:24.69,Default,,0,0,0,,Мұндай бет...
Dialogue: 0,0:14:29.20,0:14:32.66,Default,,0,0,0,,Мен оны жегеннен кейін де дем алып жатыр деп үміттенемін!
Dialogue: 0,0:14:35.45,0:14:37.79,Default,,0,0,0,,Ток соғу!
Dialogue: 0,0:14:39.71,0:14:40.62,Default,,0,0,0,,Әй!
Dialogue: 0,0:14:43.29,0:14:45.71,Default,,0,0,0,,...
Dialogue: 0,0:14:48.97,0:14:49.88,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:49.97,0:14:51.47,Default,,0,0,0,,Мен мұны жеймін бе?
Dialogue: 0,0:14:51.55,0:14:52.68,Default,,0,0,0,,Жалтар, ақымақ!
Dialogue: 0,0:15:11.24,0:15:13.99,Default,,0,0,0,,Шит… шит…
Dialogue: 0,0:15:14.49,0:15:16.91,Default,,0,0,0,,Қат!
Dialogue: 0,0:15:17.66,0:15:18.66,Default,,0,0,0,,Джиги, сауығып кет!
Dialogue: 0,0:15:18.75,0:15:20.16,Default,,0,0,0,,Иә? Бұл жақсы ма?
Dialogue: 0,0:15:20.25,0:15:22.54,Default,,0,0,0,,Сен ақымақсың ба? Мен сені қансыз емдеймін.
Dialogue: 0,0:15:23.04,0:15:24.17,Default,,0,0,0,,Тс…
Dialogue: 0,0:15:26.88,0:15:27.63,Default,,0,0,0,,Хой
Dialogue: 0,0:15:29.88,0:15:31.84,Default,,0,0,0,,Жарайсың, жарайсың.
Dialogue: 0,0:15:31.93,0:15:34.09,Default,,0,0,0,,Тыныштал, қаншық
Dialogue: 0,0:15:34.18,0:15:37.51,Default,,0,0,0,,Осылай ақыл-ойыңды жоғалтсаң, жеңетін жекпе-жекте де жеңе алмайсың.
Dialogue: 0,0:15:37.60,0:15:38.56,Default,,0,0,0,,Шу!
Dialogue: 0,0:15:39.06,0:15:41.23,Default,,0,0,0,,Кеттік, Ичиго Куросаки!
Dialogue: 0,0:15:41.31,0:15:43.48,Default,,0,0,0,,Мені өлтір!
Dialogue: 0,0:15:45.56,0:15:46.40,Default,,0,0,0,,Ах!
Dialogue: 0,0:15:50.19,0:15:50.99,Default,,0,0,0,,Не...
Dialogue: 0,0:15:51.49,0:15:54.41,Default,,0,0,0,,Өкінішті, өліңізші.
Dialogue: 0,0:15:54.99,0:15:57.49,Default,,0,0,0,,Басби, о...
Dialogue: 0,0:15:57.99,0:16:00.66,Default,,0,0,0,,Несие - бұл шиеленіс
Dialogue: 0,0:16:00.75,0:16:03.96,Default,,0,0,0,,Оны алып кету – кейін келгендердің артықшылығы.
Dialogue: 0,0:16:04.46,0:16:06.29,Default,,0,0,0,,Эй, сен солай ойлайсың ба?
Dialogue: 0,0:16:06.38,0:16:08.63,Default,,0,0,0,,Ичиго Куросаки
Dialogue: 0,0:16:09.13,0:16:11.38,Default,,0,0,0,,Бұл рас (Басби) А?
Dialogue: 0,0:16:11.47,0:16:13.80,Default,,0,0,0,,Сәл кешірек келуің керек еді.
Dialogue: 0,0:16:13.88,0:16:16.30,Default,,0,0,0,,Олар бір уақытта келгендіктен
Dialogue: 0,0:16:16.39,0:16:18.51,Default,,0,0,0,,Ямавакемен бірге барайық.
Dialogue: 0,0:16:19.01,0:16:20.27,Default,,0,0,0,,Ха~а...
Dialogue: 0,0:16:20.35,0:16:22.18,Default,,0,0,0,,Бояу туралы сөйлеме.
Dialogue: 0,0:16:23.02,0:16:25.52,Default,,0,0,0,,Оны өлтірген адам барлық ақшаны алсын.
Dialogue: 0,0:16:36.41,0:16:38.45,Default,,0,0,0,,Бұл не жарық...
Dialogue: 0,0:16:43.96,0:16:45.46,Default,,0,0,0,,Юхабах!
Dialogue: 0,0:16:46.83,0:16:48.38,Default,,0,0,0,,Бұл басталды ма?
Dialogue: 0,0:16:49.75,0:16:51.38,Default,,0,0,0,,Алғыс айту
Dialogue: 0,0:16:52.21,0:16:56.97,Default,,0,0,0,,Бізді жарыққа шығарғанға
Dialogue: 0,0:16:58.60,0:17:00.39,Default,,0,0,0,,Сізге рахмет...
Dialogue: 0,0:17:01.10,0:17:06.06,Default,,0,0,0,,Мен Рух патшасының сарайына басып кіре аламын.
Dialogue: 0,0:17:13.90,0:17:16.53,Default,,0,0,0,,Сейрейтейде спирттердің шоғырлануы азаяды.
Dialogue: 0,0:17:16.61,0:17:18.12,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,0:17:18.20,0:17:20.53,Default,,0,0,0,,Жанды қорғайтын қабықшада тесік бар!
Dialogue: 0,0:17:21.62,0:17:22.95,Default,,0,0,0,,Кілт...
Dialogue: 0,0:17:23.54,0:17:26.04,Default,,0,0,0,,Сіз есікті аштыңыз.
Dialogue: 0,0:17:26.54,0:17:30.92,Default,,0,0,0,,Ичиго Куросаки киген өлім сауыты болса керек.
Dialogue: 0,0:17:31.00,0:17:35.30,Default,,0,0,0,,Патша кілті деп аталады, ол нөлдік отрядтың сүйектері мен шаштарынан тоқылған.
Dialogue: 0,0:17:35.80,0:17:38.84,Default,,0,0,0,,Қарсылығы мен қорғаныс қабілетінің арқасында
Dialogue: 0,0:17:38.93,0:17:43.56,Default,,0,0,0,,Ичиго Куросаки Рейо сарайы мен Сейрейтейдің арасында орналасқан.
Dialogue: 0,0:17:43.64,0:17:48.02,Default,,0,0,0,,72-қабатты тосқауылдан зақымданбай өту.
Dialogue: 0,0:17:48.73,0:17:49.61,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:17:49.69,0:17:53.53,Default,,0,0,0,,Жанды қорғайтын мембрананың регенерация жылдамдығынан есептелген.
Dialogue: 0,0:17:53.61,0:17:58.03,Default,,0,0,0,,Ашылғаннан кейін есік қайта жабылу үшін 6000 секунд қажет.
Dialogue: 0,0:18:00.12,0:18:02.03,Default,,0,0,0,,Егер арасында болса
Dialogue: 0,0:18:02.12,0:18:06.62,Default,,0,0,0,,Рух патшасының сарайына кіруге мүмкіндік беретін тік тесік ашылды.
Dialogue: 0,0:18:10.25,0:18:12.29,Default,,0,0,0,,Мен мұны білдім, бірақ
Dialogue: 0,0:18:12.96,0:18:16.80,Default,,0,0,0,,Өйткені, жаудың нысанасы Рух патшасы еді.
Dialogue: 0,0:18:26.52,0:18:27.52,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:18:28.94,0:18:30.52,Default,,0,0,0,,Нөлдік топ...
Dialogue: 0,0:18:33.52,0:18:35.48,Default,,0,0,0,,Сонымен, ақыры уақыт келді—
Dialogue: 0,0:18:43.08,0:18:47.37,Default,,0,0,0,,Сіздің ойыңызша, айналаңызда көптеген адамдар тұрғанда Ұлы Мәртебені қалай қууға болады?
Dialogue: 0,0:18:47.45,0:18:49.25,Default,,0,0,0,,Мен аңғалмын
Dialogue: 0,0:18:49.75,0:18:50.83,Default,,0,0,0,,Алмазды итеру
Dialogue: 0,0:18:59.72,0:19:01.55,Default,,0,0,0,,Ол мықты адам.
Dialogue: 0,0:19:03.26,0:19:04.47,Default,,0,0,0,,Әй!
Dialogue: 0,0:19:06.27,0:19:07.18,Default,,0,0,0,,♬ Ора ора ора ора, ора ора ора ора
Dialogue: 0,0:19:07.27,0:19:09.35,Default,,0,0,0,,Оттық саусақ 1!
Dialogue: 0,0:19:09.43,0:19:10.44,Default,,0,0,0,,Бір мүйізбен осындай күш.
Dialogue: 0,0:19:18.94,0:19:19.65,Default,,0,0,0,,Ренжи!
Dialogue: 0,0:19:20.15,0:19:23.41,Default,,0,0,0,,Бар, бұл жігіттер сені өткізбейді.
Dialogue: 0,0:19:23.91,0:19:26.20,Default,,0,0,0,,Мен егжей-тегжейлі білмеймін, бірақ
Dialogue: 0,0:19:26.29,0:19:29.04,Default,,0,0,0,,Квинси жетекшісімен араларыңызда байланыс бар, солай ма?
Dialogue: 0,0:19:30.91,0:19:32.29,Default,,0,0,0,,Мен оны саған беремін.
Dialogue: 0,0:19:33.29,0:19:35.00,Default,,0,0,0,,Бұл сіздің жұмысыңыз.
Dialogue: 0,0:19:38.30,0:19:39.63,Default,,0,0,0,,Маған қашуға рұқсат етіңіз!
Dialogue: 0,0:19:40.55,0:19:41.18,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:19:45.14,0:19:49.14,Default,,0,0,0,,Бұл керемет емес, сондықтан мені қайта-қайта айтуға мәжбүрлеме.
Dialogue: 0,0:19:53.40,0:19:55.61,Default,,0,0,0,,Мен саған жіберме дедім.
Dialogue: 0,0:20:00.44,0:20:01.53,Default,,0,0,0,,Юхабах!
Dialogue: 0,0:20:03.53,0:20:04.53,Default,,0,0,0,,Ел көлеміндегі ең ізденетін Зұлымдар Альянсы
Dialogue: 0,0:20:07.53,0:20:08.04,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:09.29,0:20:09.95,Default,,0,0,0,,Аһ!
Dialogue: 0,0:20:10.95,0:20:11.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:21.80,0:20:22.67,Default,,0,0,0,,Ишида…
Dialogue: 0,0:20:23.18,0:20:25.51,Default,,0,0,0,,Неге сен?
Dialogue: 0,0:20:26.14,0:20:27.76,Default,,0,0,0,,Куросаки үйге қайт
Dialogue: 0,0:20:27.85,0:20:28.43,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:20:28.93,0:20:31.93,Default,,0,0,0,,Мәртебелін тоқтата алмайсың.
Dialogue: 0,0:20:33.31,0:20:35.94,Default,,0,0,0,,Не айтып тұрсың... Ишида
Dialogue: 0,0:20:36.44,0:20:40.36,Default,,0,0,0,,Өміріңді босқа өткізбей тұрып, үйге қайт.
Dialogue: 0,0:20:40.44,0:20:43.70,Default,,0,0,0,,Мен сенің мұнда не үшін келгеніңді сұраймын!
Dialogue: 0,0:20:47.53,0:20:48.70,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:20:53.04,0:20:53.87,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:55.58,0:20:56.58,Default,,0,0,0,,Жарық жаңбыр (Личт Реген)
Dialogue: 0,0:20:58.88,0:20:59.75,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:21:00.63,0:21:01.34,Default,,0,0,0,,Аһ!
Dialogue: 0,0:21:03.59,0:21:04.42,Default,,0,0,0,,Әй!
Dialogue: 0,0:21:16.14,0:21:17.06,Default,,0,0,0,,Исида мырза
Dialogue: 0,0:21:17.56,0:21:18.44,Default,,0,0,0,,Ишида
Dialogue: 0,0:21:24.24,0:21:27.86,Default,,0,0,0,,Күте тұрыңыз! Сіз әлі ештеңе жауап берген жоқсыз!
Dialogue: 0,0:21:28.74,0:21:30.74,Default,,0,0,0,,Қоштасып кеттіңіз бе?
Dialogue: 0,0:21:31.24,0:21:32.12,Default,,0,0,0,,Иә
Dialogue: 0,0:21:33.29,0:21:36.25,Default,,0,0,0,,Бұл мәңгілік қоштасу болады.
Dialogue: 0,0:21:38.13,0:21:39.75,Default,,0,0,0,,Мен мұны түсінемін
Dialogue: 0,0:21:48.39,0:21:49.43,Default,,0,0,0,,Ишида!
Dialogue: 0,0:21:51.26,0:21:52.56,Default,,0,0,0,,Бірдеңе айт
Dialogue: 0,0:22:00.06,0:22:01.94,Default,,0,0,0,,Ишида!
Dialogue: 0,0:22:05.82,0:22:07.82,Default,,0,0,0,,♪～
Dialogue: 0,0:23:31.03,0:23:33.03,Default,,0,0,0,,～♪
Dialogue: 0,0:23:39.20,0:23:40.75,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:23:43.83,0:23:45.59,Default,,0,0,0,,Шинухо
Dialogue: 0,0:23:47.09,0:23:53.09,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
