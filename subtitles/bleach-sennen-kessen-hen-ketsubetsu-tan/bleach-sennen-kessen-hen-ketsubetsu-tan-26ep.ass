Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.46,0:00:08.84,Default,,0,0,0,,Уақыт толы
Dialogue: 0,0:00:09.34,0:00:10.92,Default,,0,0,0,,Қанаттарыңды көрсетіңдер
Dialogue: 0,0:00:12.09,0:00:13.93,Default,,0,0,0,,Жұлдызды крест рыцарлары (Sternritter)
Dialogue: 0,0:00:24.64,0:00:28.82,Default,,0,0,0,,Менен ешкім ештеңе тартып ала алмайды
Dialogue: 0,0:00:29.32,0:00:30.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:30.57,0:00:35.41,Default,,0,0,0,,Бұл дүниеде бәрі мен үшін алып кету керек.
Dialogue: 0,0:00:35.91,0:00:38.62,Default,,0,0,0,,Тіпті бұл Рух патшасы болса да
Dialogue: 0,0:00:59.85,0:01:02.39,Default,,0,0,0,,Балалар, кеттік.
Dialogue: 0,0:01:05.48,0:01:07.48,Default,,0,0,0,,♪～
Dialogue: 0,0:02:32.52,0:02:34.52,Default,,0,0,0,,～♪
Dialogue: 0,0:02:38.36,0:02:39.15,Default,,0,0,0,,Уф...
Dialogue: 0,0:02:40.66,0:02:42.82,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:42.91,0:02:47.08,Default,,0,0,0,,Бұл Киелі кітапта (Аусвелен) бөлісілген «қосымша күш» ме?
Dialogue: 0,0:02:47.66,0:02:50.33,Default,,0,0,0,,Сонымен бұрын өтпеген оқ
Dialogue: 0,0:02:50.42,0:02:54.17,Default,,0,0,0,,Бұл Чанбокудың денесінде тесік бар дегенді білдіре ме?
Dialogue: 0,0:02:54.25,0:02:55.84,Default,,0,0,0,,Екі қате бар.
Dialogue: 0,0:02:56.34,0:02:59.84,Default,,0,0,0,,Біріншіден, бұл күш «арғы күш» емес.
Dialogue: 0,0:03:00.55,0:03:04.14,Default,,0,0,0,,Ертеректе өзімнің бастапқы күшімді көрсетуге уақытым болмады.
Dialogue: 0,0:03:04.64,0:03:06.60,Default,,0,0,0,,Екіншіден
Dialogue: 0,0:03:06.68,0:03:10.18,Default,,0,0,0,,Денеңді тесіп өткен оқ емес еді.
Dialogue: 0,0:03:12.65,0:03:16.15,Default,,0,0,0,,Сондықтан қанша қабырға болса да сені қорғай алмайды.
Dialogue: 0,0:03:16.23,0:03:17.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:20.74,0:03:23.53,Default,,0,0,0,,Менің құдіретімнің аты – «Барлық нәрсеге ену»
Dialogue: 0,0:03:24.03,0:03:25.12,Default,,0,0,0,,Оқ жоқ
Dialogue: 0,0:03:25.20,0:03:27.58,Default,,0,0,0,,Тұмсық пен нысананың арасында не бар?
Dialogue: 0,0:03:27.66,0:03:29.75,Default,,0,0,0,,Барлығына бірдей ену
Dialogue: 0,0:03:31.75,0:03:33.88,Default,,0,0,0,,Сіз кезекке тұра аласыз ба?
Dialogue: 0,0:03:34.38,0:03:36.34,Default,,0,0,0,,Енді бір оқпен атып өлтіруге болады
Dialogue: 0,0:03:41.34,0:03:44.22,Default,,0,0,0,,Ерте жатсаңыз, өзіңізді күте алмайсыз.
Dialogue: 0,0:03:50.18,0:03:54.10,Default,,0,0,0,,Қайтыс болған таң Бәріңе менің досым!
Dialogue: 0,0:03:54.77,0:03:56.90,Default,,0,0,0,,Лижье тесіп кетсе де, өлмейсің.
Dialogue: 0,0:03:56.98,0:03:58.36,Default,,0,0,0,,Ол бірбеткей жігіт.
Dialogue: 0,0:03:59.23,0:04:02.70,Default,,0,0,0,,Қанат өссе, өзіңізді жеңдім деп ойлайсыз ба?
Dialogue: 0,0:04:02.78,0:04:06.07,Default,,0,0,0,,Біз бесеуміз бүкіл Готей 13 күшінен күштіміз.
Dialogue: 0,0:04:06.16,0:04:07.70,Default,,0,0,0,,Жеңіл қабылдамаңыз!
Dialogue: 0,0:04:07.78,0:04:11.12,Default,,0,0,0,,Сіз Рух Патша сарайына кіре алмайсыз, т.б.
Dialogue: 0,0:04:11.20,0:04:13.33,Default,,0,0,0,,Бұл тағы бір арман
Dialogue: 0,0:04:13.41,0:04:15.50,Default,,0,0,0,,Ей, кеттік!
Dialogue: 0,0:04:39.07,0:04:39.69,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:04:45.61,0:04:46.11,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:50.37,0:04:52.75,Default,,0,0,0,,Бұл кішкентай қылыш қана ма?
Dialogue: 0,0:04:52.83,0:04:54.41,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:04:54.50,0:04:56.17,Default,,0,0,0,,Әртүрлі заттар
Dialogue: 0,0:04:56.67,0:04:57.79,Default,,0,0,0,,Пышақтау
Dialogue: 0,0:04:58.29,0:05:01.55,Default,,0,0,0,,Жаласаң, тілің тесіліп қалады.
Dialogue: 0,0:05:04.42,0:05:06.63,Default,,0,0,0,,Енді нақты нәрсе келеді.
Dialogue: 0,0:05:06.72,0:05:08.80,Default,,0,0,0,,Менің қонақжайлығым!
Dialogue: 0,0:05:16.81,0:05:17.98,Default,,0,0,0,,Хехе
Dialogue: 0,0:05:18.48,0:05:20.11,Default,,0,0,0,,Аматерасу жыпылықтайды!
Dialogue: 0,0:05:20.19,0:05:22.15,Default,,0,0,0,,Кинбика!
Dialogue: 0,0:05:22.65,0:05:24.03,Default,,0,0,0,,Мына жігіт шіркін
Dialogue: 0,0:05:32.99,0:05:33.58,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:35.41,0:05:36.12,Default,,0,0,0,,(Танжиро) Бірақ құбыжықтар жалғыз жүруі керек еді ғой?
Dialogue: 0,0:05:36.21,0:05:36.79,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:05:39.88,0:05:41.09,Default,,0,0,0,,Осы жерде күтіңіз!
Dialogue: 0,0:05:41.17,0:05:43.30,Default,,0,0,0,,Күтудің қажеті жоқ.
Dialogue: 0,0:05:43.38,0:05:45.30,Default,,0,0,0,,Сіз бен мен сәйкес емеспіз.
Dialogue: 0,0:05:45.38,0:05:46.67,Default,,0,0,0,,өліммен аяқталды
Dialogue: 0,0:05:46.76,0:05:47.59,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:05:53.43,0:05:53.93,Default,,0,0,0,,Хмф!
Dialogue: 0,0:05:55.48,0:05:56.48,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:05:57.98,0:06:02.15,Default,,0,0,0,,Ей, сен өзгенің жақсылығын түсінбейсің.
Dialogue: 0,0:06:03.02,0:06:04.15,Default,,0,0,0,,Юха!
Dialogue: 0,0:06:04.23,0:06:09.41,Default,,0,0,0,,Ар-намысың үшін мен сенің билігіңді әдейі екіге бөлдім.
Dialogue: 0,0:06:10.74,0:06:14.08,Default,,0,0,0,,Күшті күш жаншып кетсе
Dialogue: 0,0:06:14.16,0:06:17.46,Default,,0,0,0,,Мен Квинсилерге ұят көрсеткім келмейді.
Dialogue: 0,0:06:19.12,0:06:22.92,Default,,0,0,0,,Жарайды, өлсем, бетім де, боқтығы да қалмайды.
Dialogue: 0,0:06:23.00,0:06:24.13,Default,,0,0,0,,100 қадамдық қоршау!
Dialogue: 0,0:06:24.21,0:06:26.59,Default,,0,0,0,,Сыртқы қан тамыры (Bluto Vene Anhaven)!
Dialogue: 0,0:06:27.84,0:06:29.80,Default,,0,0,0,,Ура Хадо Сан-но До
Dialogue: 0,0:06:29.88,0:06:31.64,Default,,0,0,0,,Темір жел өлтіреді!
Dialogue: 0,0:06:36.52,0:06:37.81,Default,,0,0,0,,Сора
Dialogue: 0,0:06:37.89,0:06:39.56,Default,,0,0,0,,Сіз маған тиістіңіз бе?
Dialogue: 0,0:06:42.69,0:06:43.86,Default,,0,0,0,,Мамма миа, мен бара жатырмын
Dialogue: 0,0:06:50.32,0:06:51.91,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:06:51.99,0:06:54.62,Default,,0,0,0,,Мен Рух патша сарайына кірмеймін.
Dialogue: 0,0:06:54.70,0:06:59.29,Default,,0,0,0,,Мен сондай-ақ Рух Патшасының ізбасарлары Нөлдік отрядтың денелеріне кіремін.
Dialogue: 0,0:06:59.37,0:07:02.67,Default,,0,0,0,,Көбінесе адамның талғамының нашарлығы кінәлі.
Dialogue: 0,0:07:02.75,0:07:04.63,Default,,0,0,0,,Мен сені жазалаймын.
Dialogue: 0,0:07:05.84,0:07:07.30,Default,,0,0,0,,Қара
Dialogue: 0,0:07:09.72,0:07:11.43,Default,,0,0,0,,Бір таңба
Dialogue: 0,0:07:16.01,0:07:17.89,Default,,0,0,0,,Не болды?
Dialogue: 0,0:07:17.97,0:07:20.94,Default,,0,0,0,,Қылқалам мен жүздің айырмашылығын айта аласың ба?
Dialogue: 0,0:07:30.11,0:07:32.07,Default,,0,0,0,,Бұл пышақ не?
Dialogue: 0,0:07:32.16,0:07:36.41,Default,,0,0,0,,Сияны шашып, мүлде қия алмау емес пе?
Dialogue: 0,0:07:37.79,0:07:41.41,Default,,0,0,0,,Атауды екіге қысқартқан сол жүз бе?
Dialogue: 0,0:07:42.00,0:07:43.71,Default,,0,0,0,,Бірақ сіз білесіз
Dialogue: 0,0:07:43.79,0:07:46.17,Default,,0,0,0,,Аты мен қуат екіге бөлінеді
Dialogue: 0,0:07:46.25,0:07:50.67,Default,,0,0,0,,Мен оны өз күшіммен қалпына келтіре алатыныма сенемін.
Dialogue: 0,0:07:50.76,0:07:53.63,Default,,0,0,0,,Бұл жүз мені жеңе алмайды.
Dialogue: 0,0:07:54.14,0:07:55.76,Default,,0,0,0,,Сен менің...
Dialogue: 0,0:07:55.85,0:07:56.35,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,0:07:56.43,0:07:56.93,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:07:57.01,0:07:57.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:57.89,0:08:00.14,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:08:01.35,0:08:04.52,Default,,0,0,0,,Сол қылыштың аты қалай?
Dialogue: 0,0:08:04.60,0:08:06.02,Default,,0,0,0,,Білмеймін
Dialogue: 0,0:08:06.11,0:08:08.15,Default,,0,0,0,,Жоқ, сіз білесіз бе?
Dialogue: 0,0:08:08.23,0:08:11.99,Default,,0,0,0,,Қылыштың аты жоқ.
Dialogue: 0,0:08:13.07,0:08:17.03,Default,,0,0,0,,Бір әріппен толтырылғандар атын жоғалтады.
Dialogue: 0,0:08:17.62,0:08:20.04,Default,,0,0,0,,Атауы жоқ заттардың күші жоқ
Dialogue: 0,0:08:20.62,0:08:24.04,Default,,0,0,0,,Аты жоқ қылышпен, аты жоқ крестпен...
Dialogue: 0,0:08:25.21,0:08:28.54,Default,,0,0,0,,Сіз мені өлтіре аламын деп ойлайсыз ба?
Dialogue: 0,0:08:30.46,0:08:31.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:31.71,0:08:33.72,Default,,0,0,0,,Хахаха!
Dialogue: 0,0:08:33.80,0:08:37.43,Default,,0,0,0,,Менің жүрегімді осылай инемен өлтіре аласың ба?
Dialogue: 0,0:08:50.44,0:08:51.48,Default,,0,0,0,,Не!
Dialogue: 0,0:08:57.07,0:08:57.57,Default,,0,0,0,,Әй!
Dialogue: 0,0:08:59.33,0:08:59.99,Default,,0,0,0,,Әй!
Dialogue: 0,0:09:03.08,0:09:04.66,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:09:04.75,0:09:05.25,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:07.79,0:09:08.79,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:09:10.80,0:09:11.30,Default,,0,0,0,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,0:09:11.38,0:09:13.92,Default,,0,0,0,,Бұл олардың үйлесімді еместігінде ғана емес.
Dialogue: 0,0:09:15.42,0:09:18.39,Default,,0,0,0,,Сен маған қарағанда баяусың
Dialogue: 0,0:09:26.69,0:09:29.31,Default,,0,0,0,,Мен де әлгі қызық жігітті бұрын айттым.
Dialogue: 0,0:09:29.40,0:09:31.69,Default,,0,0,0,,Мені қорлағандар...
Dialogue: 0,0:09:31.77,0:09:32.28,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:32.36,0:09:35.36,Default,,0,0,0,,Өлім... Бұл не?
Dialogue: 0,0:09:35.86,0:09:36.78,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:09:37.57,0:09:38.28,Default,,0,0,0,,(Баяндаушы) Цезарь не болып жатқанын мүлде түсінбеді.
Dialogue: 0,0:09:38.86,0:09:40.28,Default,,0,0,0,,Ол өтіп кетті ме?
Dialogue: 0,0:09:41.74,0:09:43.79,Default,,0,0,0,,Сіз біртүрлі әдістерді қолданасыз!
Dialogue: 0,0:09:44.41,0:09:46.87,Default,,0,0,0,,Менің көзім сенің жылдамдығыңа үйреніп қалды.
Dialogue: 0,0:09:47.37,0:09:48.67,Default,,0,0,0,,Келесі - соңы.
Dialogue: 0,0:09:49.96,0:09:51.88,Default,,0,0,0,,Yo!
Dialogue: 0,0:09:51.96,0:09:54.09,Default,,0,0,0,,Бас тарту жақсы идея сияқты.
Dialogue: 0,0:09:59.18,0:10:00.85,Default,,0,0,0,,Сіз ату мүмкін емес, солай ма?
Dialogue: 0,0:10:01.35,0:10:02.72,Default,,0,0,0,,Уаа!
Dialogue: 0,0:10:02.81,0:10:03.60,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:06.85,0:10:08.81,Default,,0,0,0,,Сіз аттыңыз
Dialogue: 0,0:10:09.31,0:10:11.23,Default,,0,0,0,,Бірақ Юхар...
Dialogue: 0,0:10:11.90,0:10:13.52,Default,,0,0,0,,Жақсы болды ма?
Dialogue: 0,0:10:14.78,0:10:15.90,Default,,0,0,0,,Ал мен оны дәл осы жерде ғана ұшырып жіберсем!
Dialogue: 0,0:10:16.49,0:10:18.32,Default,,0,0,0,,Менің Ixaxis
Dialogue: 0,0:10:18.40,0:10:21.16,Default,,0,0,0,,Тұмсық пен нысананың арасында не бар?
Dialogue: 0,0:10:21.24,0:10:23.74,Default,,0,0,0,,Барлығы бірдей еніп кетсе
Dialogue: 0,0:10:33.34,0:10:34.67,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:10:34.75,0:10:38.17,Default,,0,0,0,,Олай болса, сенің де билігіңді тартып аламын.
Dialogue: 0,0:10:38.67,0:10:42.89,Default,,0,0,0,,Аты жоқпен емес, өз күшіммен!
Dialogue: 0,0:10:44.68,0:10:46.60,Default,,0,0,0,,Құрбандық үстелі!
Dialogue: 0,0:10:50.52,0:10:54.52,Default,,0,0,0,,Сенің қаралығың да менің күшіме айналады.
Dialogue: 0,0:11:06.83,0:11:10.87,Default,,0,0,0,,Бұл бүкіл Gotei 13 корпусының деңгейі ме немесе одан да көп пе?
Dialogue: 0,0:11:10.96,0:11:12.63,Default,,0,0,0,,Ішімнің бір жағы ауырады.
Dialogue: 0,0:11:12.71,0:11:15.17,Default,,0,0,0,,Сіз асығыссыз.
Dialogue: 0,0:11:15.67,0:11:20.51,Default,,0,0,0,,Олар әлі күнге дейін Готей корпусындағыдай күшке ие емес.
Dialogue: 0,0:11:20.59,0:11:21.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:21.59,0:11:24.43,Default,,0,0,0,,Рух Патшасын қорғауға арналған арнайы патша миссиясы
Dialogue: 0,0:11:24.51,0:11:27.52,Default,,0,0,0,,Егер Квинси сені түсірсе, бәрі бітті!
Dialogue: 0,0:11:27.60,0:11:30.69,Default,,0,0,0,,Тұр! Zero Squad тобының барлығы
Dialogue: 0,0:11:34.90,0:11:35.77,Default,,0,0,0,,Сенжумару
Dialogue: 0,0:11:35.86,0:11:38.53,Default,,0,0,0,,Оларды өлтіретін сенсің.
Dialogue: 0,0:11:38.61,0:11:40.53,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:11:40.61,0:11:45.24,Default,,0,0,0,,Мың қолың болса, алтыға жуық адамды ұстай аласың, солай ма?
Dialogue: 0,0:11:45.32,0:11:47.12,Default,,0,0,0,,Оны асыра пайдаланбаңыз
Dialogue: 0,0:11:47.20,0:11:48.49,Default,,0,0,0,,Мен не білдім
Dialogue: 0,0:11:50.50,0:11:53.37,Default,,0,0,0,,Мен сізге Zero Squad қаншалықты маңызды екенін көрсетемін.
Dialogue: 0,0:11:57.71,0:11:59.00,Default,,0,0,0,,Суицид?
Dialogue: 0,0:12:10.52,0:12:11.23,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:14.27,0:12:18.90,Default,,0,0,0,,Төрт адам да шыдай алмаса, бір адаммен не істей аламыз?
Dialogue: 0,0:12:18.98,0:12:21.94,Default,,0,0,0,,Біздің қабілеттеріміз жеңгеңді бұлғау ғана.
Dialogue: 0,0:12:22.03,0:12:24.53,Default,,0,0,0,,Аспан мен жердің үш әлемін тербету
Dialogue: 0,0:12:25.03,0:12:28.74,Default,,0,0,0,,Сондықтан біз өмірімізді біріктіреміз
Dialogue: 0,0:12:28.83,0:12:31.50,Default,,0,0,0,,Нағыз қылыш мөрмен жабылды
Dialogue: 0,0:12:32.50,0:12:36.33,Default,,0,0,0,,Ал енді үш өмірдің орнына
Dialogue: 0,0:12:36.42,0:12:39.80,Default,,0,0,0,,Қан антының мөрі бұзылды.
Dialogue: 0,0:12:41.13,0:12:42.84,Default,,0,0,0,,Абайлаңыз
Dialogue: 0,0:12:45.05,0:12:46.43,Default,,0,0,0,,Банкай
Dialogue: 0,0:13:16.83,0:13:20.13,Default,,0,0,0,,Ұшаның қиылысы
Dialogue: 0,0:13:20.63,0:13:21.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:28.76,0:13:29.68,Default,,0,0,0,,Тонна
Dialogue: 0,0:13:30.30,0:13:31.01,Default,,0,0,0,,Тонна
Dialogue: 0,0:13:31.51,0:13:34.18,Default,,0,0,0,,бастап
Dialogue: 0,0:13:34.98,0:13:35.68,Default,,0,0,0,,Тонна
Dialogue: 0,0:13:36.39,0:13:37.69,Default,,0,0,0,,бастап
Dialogue: 0,0:13:38.19,0:13:38.69,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:41.77,0:13:45.57,Default,,0,0,0,,...
Dialogue: 0,0:13:48.66,0:13:52.54,Default,,0,0,0,,Артқа қадала қарасаң, көзің шалады
Dialogue: 0,0:13:54.29,0:13:56.41,Default,,0,0,0,,Екі жақты шешім...
Dialogue: 0,0:13:56.50,0:13:59.83,Default,,0,0,0,,Әй, бұл не...
Dialogue: 0,0:13:59.92,0:14:02.13,Default,,0,0,0,,Пышақты сауыт
Dialogue: 0,0:14:03.30,0:14:04.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:07.76,0:14:08.30,Default,,0,0,0,,Ха!
Dialogue: 0,0:14:08.38,0:14:13.14,Default,,0,0,0,,Тұратын ештеңе жоқ
Dialogue: 0,0:14:14.89,0:14:16.73,Default,,0,0,0,,Санрей Каба
Dialogue: 0,0:14:18.06,0:14:19.65,Default,,0,0,0,,Қара құм ішектер
Dialogue: 0,0:14:22.94,0:14:24.73,Default,,0,0,0,,Манипуляция жасайтын қол
Dialogue: 0,0:14:28.82,0:14:30.70,Default,,0,0,0,,Өлім
Dialogue: 0,0:14:33.83,0:14:35.87,Default,,0,0,0,,Ширейкаба…
Dialogue: 0,0:14:35.95,0:14:38.71,Default,,0,0,0,,Хмм... бұл қызықсыз қулық.
Dialogue: 0,0:14:38.79,0:14:39.62,Default,,0,0,0,,Татакзан...
Dialogue: 0,0:14:41.13,0:14:41.63,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:41.71,0:14:44.04,Default,,0,0,0,,Мұздатылған төсек жабындары
Dialogue: 0,0:14:45.59,0:14:46.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:46.96,0:14:49.01,Default,,0,0,0,,Егер сіз бұзсаңыз, енді ешқашан жасамаңыз.
Dialogue: 0,0:14:49.63,0:14:51.51,Default,,0,0,0,,Оянбайтын жер
Dialogue: 0,0:14:53.89,0:14:57.56,Default,,0,0,0,,Өртенген өріс
Dialogue: 0,0:15:08.78,0:15:10.78,Default,,0,0,0,,Күл болғанша
Dialogue: 0,0:15:13.07,0:15:15.45,Default,,0,0,0,,Шығу жолы жоқ
Dialogue: 0,0:15:18.54,0:15:20.29,Default,,0,0,0,,Рокуреи Каба
Dialogue: 0,0:15:20.79,0:15:22.79,Default,,0,0,0,,Қараңғы түннің жұлдызы
Dialogue: 0,0:15:29.30,0:15:31.18,Default,,0,0,0,,Ұстап алсаң, бітті
Dialogue: 0,0:15:38.22,0:15:40.18,Default,,0,0,0,,Өлім жұлдызы
Dialogue: 0,0:15:42.06,0:15:44.86,Default,,0,0,0,,Жаман балалар, тез қараңдар!
Dialogue: 0,0:15:45.94,0:15:48.65,Default,,0,0,0,,Хиомандан, оны реттеңіз
Dialogue: 0,0:15:49.15,0:15:51.20,Default,,0,0,0,,Бұл машинаны босатыңыз
Dialogue: 0,0:15:52.53,0:15:55.99,Default,,0,0,0,,Шиде Рокушоку Укибунки
Dialogue: 0,0:16:10.09,0:16:12.72,Default,,0,0,0,,Менің күшім «қара»
Dialogue: 0,0:16:13.88,0:16:17.14,Default,,0,0,0,,Бір әріпті босатқаннан кейін
Dialogue: 0,0:16:17.22,0:16:19.52,Default,,0,0,0,,Грим Реапер де, Квинси де
Dialogue: 0,0:16:19.60,0:16:22.39,Default,,0,0,0,,Тірі немесе өліге қарамастан.
Dialogue: 0,0:16:22.98,0:16:25.52,Default,,0,0,0,,Бұл дүниедегі барлық қаралық...
Dialogue: 0,0:16:28.23,0:16:29.98,Default,,0,0,0,,Бұл менікі
Dialogue: 0,0:16:35.61,0:16:37.45,Default,,0,0,0,,Юхабах
Dialogue: 0,0:16:37.53,0:16:41.58,Default,,0,0,0,,Жоқ... Мен Юхабах едім.
Dialogue: 0,0:16:41.66,0:16:44.16,Default,,0,0,0,,Атын жоғалтудың өзі азапты болуы керек.
Dialogue: 0,0:16:44.67,0:16:47.04,Default,,0,0,0,,Кедейге мен...
Dialogue: 0,0:16:48.38,0:16:50.42,Default,,0,0,0,,Оған атау беріңіз
Dialogue: 0,0:16:51.00,0:16:54.93,Default,,0,0,0,,Шинучи Шира қылқалам бір кейіпкер
Dialogue: 0,0:16:55.63,0:16:57.85,Default,,0,0,0,,Қазіргі тілмен айтқанда:
Dialogue: 0,0:16:57.93,0:17:00.56,Default,,0,0,0,,«Банқай» деп аталады ма?
Dialogue: 0,0:17:00.64,0:17:05.14,Default,,0,0,0,,Өйткені, бұл дүниеде Банкай болғанға дейін көп уақыт болды.
Dialogue: 0,0:17:05.23,0:17:09.15,Default,,0,0,0,,Бірінші дамыған Занпакуто
Dialogue: 0,0:17:09.73,0:17:13.36,Default,,0,0,0,,Бұл қылыш бір таңбамен толтырылған.
Dialogue: 0,0:17:13.44,0:17:16.91,Default,,0,0,0,,Жаңа есімді ойып жаза алады
Dialogue: 0,0:17:18.70,0:17:21.37,Default,,0,0,0,,Ал, көңіл күйлерің қалай?
Dialogue: 0,0:17:21.45,0:17:24.91,Default,,0,0,0,,Бір кездері Юхабах болған қара құмырсқа.
Dialogue: 0,0:17:25.00,0:17:27.25,Default,,0,0,0,,Оншидің күші енді
Dialogue: 0,0:17:27.33,0:17:30.09,Default,,0,0,0,,Жерде жорғалаған қара құмырсқадай.
Dialogue: 0,0:17:30.17,0:17:33.30,Default,,0,0,0,,Нәзік, өткінші өмірге айналды.
Dialogue: 0,0:17:34.38,0:17:37.01,Default,,0,0,0,,Бұл... әзірге...
Dialogue: 0,0:17:37.51,0:17:40.05,Default,,0,0,0,,Иә, «әзірше»
Dialogue: 0,0:17:40.55,0:17:43.31,Default,,0,0,0,,Билікте үлкен айырмашылық болды.
Dialogue: 0,0:17:43.39,0:17:47.06,Default,,0,0,0,,Оншидің тағдыры да солай.
Dialogue: 0,0:17:47.14,0:17:51.19,Default,,0,0,0,,Мен осы уақытқа дейін өлтірген Шинигамидің өмірімен танысу
Dialogue: 0,0:17:51.77,0:17:55.53,Default,,0,0,0,,Қара құмырсқадай езіліп өл!
Dialogue: 0,0:17:59.45,0:18:01.87,Default,,0,0,0,,Жәндіктер патшасы
Dialogue: 0,0:18:03.41,0:18:05.04,Default,,0,0,0,,Қоштасу
Dialogue: 0,0:18:21.76,0:18:23.76,Default,,0,0,0,,♪～
Dialogue: 0,0:19:46.97,0:19:48.97,Default,,0,0,0,,～♪
Dialogue: 0,0:19:52.06,0:19:53.81,Default,,0,0,0,,Ұзақ уақыт ағартқыш!
Dialogue: 0,0:19:53.90,0:19:55.02,Default,,0,0,0,,Қанша уақыт?
Dialogue: 0,0:19:55.11,0:19:58.48,Default,,0,0,0,,Елдің түкпір-түкпіріндегі егде жастағы әйелдер, сондай-ақ бейбақтар.
Dialogue: 0,0:19:58.57,0:19:59.94,Default,,0,0,0,,Хошу оқиғасынан екі күн өткен соң
Dialogue: 0,0:20:00.03,0:20:04.11,Default,,0,0,0,,Бұл Нью-Йорк королі ретінде де белгілі Кон мырза!
Dialogue: 0,0:20:04.20,0:20:07.24,Default,,0,0,0,,Сізге екінші маусымның соңғы бөлімі ұнады ма?
Dialogue: 0,0:20:07.33,0:20:09.12,Default,,0,0,0,,Бүгін менің аранжировкам.
Dialogue: 0,0:20:09.20,0:20:14.42,Default,,0,0,0,,«Reaper Picture Book» өте танымал бұрышы қайта оралды!
Dialogue: 0,0:20:14.50,0:20:16.25,Default,,0,0,0,,Менің ең жақсы таңдауым
Dialogue: 0,0:20:16.34,0:20:18.96,Default,,0,0,0,,Ичиго мен оның достары анау-мынау жасады.
Dialogue: 0,0:20:19.05,0:20:22.47,Default,,0,0,0,,Мен сізге ерекше нәрсе көрсетемін, сондықтан риза болыңыз.
Dialogue: 0,0:20:22.55,0:20:24.80,Default,,0,0,0,,Олай болса, дереу кеттік!
Dialogue: 0,0:20:25.30,0:20:27.60,Default,,0,0,0,,«Reaper иллюстрацияланған кітап»
Dialogue: 0,0:20:28.10,0:20:30.43,Default,,0,0,0,,«Көптен бері көрмедім!»
Dialogue: 0,0:20:32.23,0:20:33.10,Default,,0,0,0,,Мүмкін емес пе?
Dialogue: 0,0:20:33.19,0:20:37.23,Default,,0,0,0,,Қираған Банкай ешқашан бұрынғы күйіне оралмайды.
Dialogue: 0,0:20:37.31,0:20:39.73,Default,,0,0,0,,Не... Сонда не істеуім керек...
Dialogue: 0,0:20:39.82,0:20:40.90,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:20:40.98,0:20:41.61,Default,,0,0,0,,Екі күн бұрын банк тонаған жігіт енді автобусты ұрлап кетті.
Dialogue: 0,0:20:41.69,0:20:43.86,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:43.95,0:20:44.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:44.82,0:20:46.87,Default,,0,0,0,,Тоқта, мына жігіт! (Офицер) Мені ұстаңыз!
Dialogue: 0,0:20:46.95,0:20:49.12,Default,,0,0,0,,Бірақ, өтінемін, кетіңіз~!
Dialogue: 0,0:20:49.20,0:20:50.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:50.66,0:20:53.54,Default,,0,0,0,,О, Құдайым! Біреу мені ұшырып жіберді
Dialogue: 0,0:20:53.62,0:20:55.58,Default,,0,0,0,,А... Ичиго?
Dialogue: 0,0:20:55.67,0:20:57.75,Default,,0,0,0,,Иә! Сен... сен кімсің?
Dialogue: 0,0:20:57.83,0:20:58.84,Default,,0,0,0,,Кім...
Dialogue: 0,0:20:58.92,0:21:01.63,Default,,0,0,0,,Біраз уақыт өткендіктен, бұл оны білдірмейді.
Dialogue: 0,0:21:01.71,0:21:04.72,Default,,0,0,0,,Білесің бе, сен білесің!
Dialogue: 0,0:21:04.80,0:21:06.34,Default,,0,0,0,,Мына сүйкімді жүз
Dialogue: 0,0:21:06.43,0:21:08.47,Default,,0,0,0,,Сонымен қатар, бұл сүйкімді тұлға
Dialogue: 0,0:21:08.55,0:21:10.51,Default,,0,0,0,,Ал мына сүйкімді жүз
Dialogue: 0,0:21:10.60,0:21:14.35,Default,,0,0,0,,Бұл Нью-Йорк королі ретінде белгілі Кон мырза!
Dialogue: 0,0:21:14.43,0:21:17.48,Default,,0,0,0,,Әй... Әй, бұл не...
Dialogue: 0,0:21:17.98,0:21:21.27,Default,,0,0,0,,Мен сені көптен бері көрмедім, бірақ сен есейіп қалдың...
Dialogue: 0,0:21:21.36,0:21:22.65,Default,,0,0,0,,Ол – Лорд Широ.
Dialogue: 0,0:21:22.73,0:21:27.07,Default,,0,0,0,,Ненің дұрыс емес екеніне мұқият болуды доғарыңыз және оны мейірімділікпен білдіріңіз!
Dialogue: 0,0:21:27.16,0:21:28.62,Default,,0,0,0,,Мені тыңда, Ичиго.
Dialogue: 0,0:21:28.70,0:21:31.33,Default,,0,0,0,,Мұнда және қазір, бұл менің қиындықтарымның тарихы.
Dialogue: 0,0:21:31.41,0:21:33.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:21:33.37,0:21:34.29,Default,,0,0,0,,А... а...
Dialogue: 0,0:21:34.37,0:21:36.00,Default,,0,0,0,,Міне, сондықтан...
Dialogue: 0,0:21:36.08,0:21:38.79,Default,,0,0,0,,А... А, негізгі тақырыпқа қайтайын!
Dialogue: 0,0:21:38.88,0:21:40.34,Default,,0,0,0,,Ол азайып барады. Ұстаңыз!
Dialogue: 0,0:21:40.42,0:21:42.13,Default,,0,0,0,,Гяааах!
Dialogue: 0,0:21:42.21,0:21:43.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:43.17,0:21:45.34,Default,,0,0,0,,Менің артымнан жүр, Ичиго Куросаки
Dialogue: 0,0:21:45.42,0:21:47.97,Default,,0,0,0,,Zero Squad-sama осында.
Dialogue: 0,0:21:50.35,0:21:53.85,Default,,0,0,0,,«Ол жерден естеліктер»
Dialogue: 0,0:21:53.93,0:21:55.68,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:21:55.77,0:21:57.31,Default,,0,0,0,,Иә, Кучики.
Dialogue: 0,0:21:57.81,0:21:58.65,Default,,0,0,0,,Иә
Dialogue: 0,0:21:59.19,0:22:01.19,Default,,0,0,0,,Шынымен! иә!
Dialogue: 0,0:22:01.27,0:22:03.07,Default,,0,0,0,,Иә? Ол кім?
Dialogue: 0,0:22:03.15,0:22:04.74,Default,,0,0,0,,Киринжи храмы залынан
Dialogue: 0,0:22:04.82,0:22:06.95,Default,,0,0,0,,Ағам жазылып кеткен сияқты!
Dialogue: 0,0:22:07.03,0:22:09.74,Default,,0,0,0,,Сіз қалпына келдіңіз бе? Жақсы
Dialogue: 0,0:22:10.70,0:22:14.33,Default,,0,0,0,,Бұл тамақ жеп, қылышымды соғамын деген сөз.
Dialogue: 0,0:22:14.41,0:22:16.00,Default,,0,0,0,,Содан кейін...
Dialogue: 0,0:22:16.08,0:22:17.16,Default,,0,0,0,,Сол жерде...
Dialogue: 0,0:22:18.04,0:22:20.42,Default,,0,0,0,,Ол жерде қорқынышты болды.
Dialogue: 0,0:22:20.50,0:22:22.38,Default,,0,0,0,,Бұл тозақтың өлшемі болды.
Dialogue: 0,0:22:22.46,0:22:25.05,Default,,0,0,0,,Аға, жалаңаштанған...
Dialogue: 0,0:22:25.13,0:22:26.67,Default,,0,0,0,,Тіпті есіме түсіргім де келмейді
Dialogue: 0,0:22:27.17,0:22:28.34,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:22:29.13,0:22:31.89,Default,,0,0,0,,Сәлем Ренжи! неге есіңе түсті
Dialogue: 0,0:22:31.97,0:22:35.02,Default,,0,0,0,,Еске салма, Ренжи!
Dialogue: 0,0:22:38.31,0:22:39.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:39.10,0:22:42.65,Default,,0,0,0,,Сұрақ қоймаңыз. Сіз мені естімеген боларсыз.
Dialogue: 0,0:22:42.73,0:22:45.19,Default,,0,0,0,,«Мен саған беліңді шеш деп айттым».
Dialogue: 0,0:22:45.28,0:22:47.86,Default,,0,0,0,,Жоқ, жоқ, бұл өлім қалпақтың өлшемі, солай ма?
Dialogue: 0,0:22:47.94,0:22:50.36,Default,,0,0,0,,Сіз тек белдемше киіп жүрсеңіз де жасай аласыз.
Dialogue: 0,0:22:50.45,0:22:54.45,Default,,0,0,0,,Көремін, көремін.
Dialogue: 0,0:22:54.53,0:22:57.12,Default,,0,0,0,,Сіз бір нәрсені кесіп алып, оны өлшедіңіз делік.
Dialogue: 0,0:22:57.20,0:22:59.04,Default,,0,0,0,,Жарайды, мен оны қазір шешемін!
Dialogue: 0,0:22:59.54,0:23:00.37,Default,,0,0,0,,Ха!
Dialogue: 0,0:23:00.46,0:23:02.67,Default,,0,0,0,,Сен ояусың ба, Ренжи? Жақсы
Dialogue: 0,0:23:02.75,0:23:05.88,Default,,0,0,0,,Киімімді шешуді ұмытпағаныма өте қуаныштымын.
Dialogue: 0,0:23:06.59,0:23:09.13,Default,,0,0,0,,Бірақ сіз бір жаққа
Dialogue: 0,0:23:09.22,0:23:11.97,Default,,0,0,0,,Ағам осындай қорлыққа ұшырай ма деп ойлаймын.
Dialogue: 0,0:23:12.05,0:23:13.76,Default,,0,0,0,,Мен өзімді кесіп тастайтындай сезінемін.
Dialogue: 0,0:23:14.26,0:23:15.51,Default,,0,0,0,,«Бүйірлік»?
Dialogue: 0,0:23:15.60,0:23:17.93,Default,,0,0,0,,Оитавашия ағасы
Dialogue: 0,0:23:19.73,0:23:21.90,Default,,0,0,0,,Хаа... міне осы.
Dialogue: 0,0:23:21.98,0:23:25.11,Default,,0,0,0,,Маған осыны көбірек көрсетуіңізді қалаймын.
Dialogue: 0,0:23:25.19,0:23:27.48,Default,,0,0,0,,Грим Реапер мен Квинси дірілдеп тұр
Dialogue: 0,0:23:27.57,0:23:31.41,Default,,0,0,0,,«Бұл соңғы шайқас, бұл қоштасу» формальды нәрсе.
Dialogue: 0,0:23:31.49,0:23:33.66,Default,,0,0,0,,Менің толық сезіміммен
Dialogue: 0,0:23:33.74,0:23:37.62,Default,,0,0,0,,2-ші маусымның соңғы бөлімі Мен сізге үлкен қызмет көрсеттім.
Dialogue: 0,0:23:37.70,0:23:39.08,Default,,0,0,0,,Барлығы қарап отыр
Dialogue: 0,0:23:39.16,0:23:42.46,Default,,0,0,0,,Экран алдында қол шапалақтап, қошеметпен жауап беріңіз.
Dialogue: 0,0:23:42.54,0:23:45.67,Default,,0,0,0,,Енді осымен бітті.
Dialogue: 0,0:23:45.75,0:23:49.30,Default,,0,0,0,,Менімен қайта кездесуді асыға күтіңіздер.
Dialogue: 0,0:23:49.38,0:23:50.92,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:23:52.42,0:23:58.42,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
