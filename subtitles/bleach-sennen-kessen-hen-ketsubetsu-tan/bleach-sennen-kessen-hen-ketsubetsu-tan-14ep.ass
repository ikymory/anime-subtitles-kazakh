Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:43.37,0:00:48.96,Default,,0,0,0,,Сізде ха бар
Dialogue: 0,0:00:49.46,0:00:55.34,Default,,0,0,0,,Сізде ха бар
Dialogue: 0,0:00:55.84,0:01:02.27,Default,,0,0,0,,Сізде ха бар
Dialogue: 0,0:01:09.48,0:01:11.48,Default,,0,0,0,,♪～
Dialogue: 0,0:02:36.53,0:02:38.53,Default,,0,0,0,,～♪
Dialogue: 0,0:02:43.74,0:02:46.95,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:02:47.66,0:02:49.66,Default,,0,0,0,,Ичиго Куросаки
Dialogue: 0,0:02:50.33,0:02:55.55,Default,,0,0,0,,Өздеріңіз білетіндей, Жан қоғамы терең жараға ұшырады.
Dialogue: 0,0:02:57.26,0:02:59.59,Default,,0,0,0,,(Анн) Эй! Тағы соқтығысып қалдық. Машинаңмен апарып тастайсың ба?
Dialogue: 0,0:03:00.09,0:03:04.55,Default,,0,0,0,,Мың жыл тыныштық өлім құдайларын әлсіретіп жіберді.
Dialogue: 0,0:03:04.64,0:03:07.64,Default,,0,0,0,,«Нөлдік отряд» мұны жаңа ғана көрді, солай ма?
Dialogue: 0,0:03:07.72,0:03:12.15,Default,,0,0,0,,Тек қарау, бұл да біздің міндетіміз.
Dialogue: 0,0:03:12.81,0:03:16.77,Default,,0,0,0,,Жыныс мүшесін жаттықтыру да біздің міндетіміз.
Dialogue: 0,0:03:18.48,0:03:21.40,Default,,0,0,0,,Олар міндетті түрде қайтадан келеді
Dialogue: 0,0:03:21.99,0:03:24.41,Default,,0,0,0,,Алыс емес болашақта
Dialogue: 0,0:03:25.45,0:03:26.37,Default,,0,0,0,,О
Dialogue: 0,0:03:27.49,0:03:28.95,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:03:31.58,0:03:33.00,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:03:33.08,0:03:35.63,Default,,0,0,0,,Менің ойымша, бұл Soul Society деп шешілді.
Dialogue: 0,0:03:35.71,0:03:37.80,Default,,0,0,0,,Олар келгенше мен қайтуым керек.
Dialogue: 0,0:03:37.88,0:03:40.88,Default,,0,0,0,,Сізді өлтіруге барасыз ба?
Dialogue: 0,0:03:42.22,0:03:43.80,Default,,0,0,0,,Қазіргідей
Dialogue: 0,0:03:44.39,0:03:47.76,Default,,0,0,0,,Юхабахты жеңе алмайсың
Dialogue: 0,0:03:47.85,0:03:48.93,Default,,0,0,0,,Ха…
Dialogue: 0,0:04:07.41,0:04:09.08,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:04:14.54,0:04:16.54,Default,,0,0,0,,үшін крест ұсынады!
Dialogue: 0,0:04:20.80,0:04:23.76,Default,,0,0,0,,Мәртебелі Юхабахқа сәлем!
Dialogue: 0,0:04:28.89,0:04:32.06,Default,,0,0,0,,Дайынсың ба? Жұлдызды крест рыцарлары (Sternritter)
Dialogue: 0,0:04:33.98,0:04:37.56,Default,,0,0,0,,Мың жыл бұрын, біз, Квинси,
Dialogue: 0,0:04:37.65,0:04:41.11,Default,,0,0,0,,Қылмыскердің қатыгез шабуылы астында
Dialogue: 0,0:04:41.19,0:04:43.40,Default,,0,0,0,,Талай жерлесінен айырылды
Dialogue: 0,0:04:43.49,0:04:46.45,Default,,0,0,0,,Тірі қалу қаупі бар
Dialogue: 0,0:04:47.16,0:04:50.83,Default,,0,0,0,,Біз көлеңкелер патшалығында өмір сүргенбіз (Шаттан Берейх)
Dialogue: 0,0:04:50.91,0:04:55.33,Default,,0,0,0,,Қорлыққа шыдап, мың жыл күттім.
Dialogue: 0,0:04:56.25,0:05:00.34,Default,,0,0,0,,Жақында соңғы шайқас басталады.
Dialogue: 0,0:05:00.42,0:05:04.63,Default,,0,0,0,,Жан қоғамын және Шинигамиді жою
Dialogue: 0,0:05:04.72,0:05:08.59,Default,,0,0,0,,Квинсидің мақтаныш сезімін қалпына келтіру уақыты келді.
Dialogue: 0,0:05:15.06,0:05:19.15,Default,,0,0,0,,Шайқас алдында бәріңізге айтар жаңалығым бар.
Dialogue: 0,0:05:19.90,0:05:20.52,Default,,0,0,0,,Егер сол күйді сақтай отырып қозғалсам…
Dialogue: 0,0:05:27.57,0:05:29.62,Default,,0,0,0,,Бұл кім? Әлгі бейбақ
Dialogue: 0,0:05:29.70,0:05:33.08,Default,,0,0,0,,Неліктен Мәртебелімен бір мінберде тұрсыз?
Dialogue: 0,0:05:34.12,0:05:36.12,Default,,0,0,0,,Урю Ишида
Dialogue: 0,0:05:36.21,0:05:39.58,Default,,0,0,0,,Бұл дүниеде қалған соңғы Квинси.
Dialogue: 0,0:05:41.00,0:05:44.21,Default,,0,0,0,,Мен бұл адаммын
Dialogue: 0,0:05:44.96,0:05:47.93,Default,,0,0,0,,Менің мұрагерімді тағайындаңыз
Dialogue: 0,0:05:48.01,0:05:48.76,Default,,0,0,0,,Не!
Dialogue: 0,0:05:50.14,0:05:51.35,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:51.43,0:05:53.22,Default,,0,0,0,,Мәртебелі мұрагері?
Dialogue: 0,0:05:53.31,0:05:56.93,Default,,0,0,0,,Әлгі жігіт... гегегеге
Dialogue: 0,0:05:57.56,0:05:59.19,Default,,0,0,0,,Егер бұл жігіт өлетін болғысы келмесе, денесін Сукунаға тапсырғаны дұрыс—
Dialogue: 0,0:05:59.90,0:06:00.94,Default,,0,0,0,,Гюго
Dialogue: 0,0:06:01.02,0:06:04.28,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:06:05.40,0:06:08.95,Default,,0,0,0,,Қарсылық жоқ, алаңдаушылық жоқ.
Dialogue: 0,0:06:09.03,0:06:12.70,Default,,0,0,0,,Бұл адамның күші алдағы шайқаста пайдаланылады.
Dialogue: 0,0:06:12.78,0:06:17.96,Default,,0,0,0,,Мұндағы әркім өзі біледі.
Dialogue: 0,0:06:19.29,0:06:20.88,Default,,0,0,0,,Осымен
Dialogue: 0,0:06:27.76,0:06:28.93,Default,,0,0,0,,(Есіктің жабылу дыбысы)
Dialogue: 0,0:06:29.01,0:06:31.39,Default,,0,0,0,,А, мен түсінбедім!
Dialogue: 0,0:06:34.64,0:06:36.52,Default,,0,0,0,,Сіз (мүше)сіз бе?... Иә?
Dialogue: 0,0:06:36.60,0:06:40.02,Default,,0,0,0,,Мен ренжідім, енді менің бөлмеме кел.
Dialogue: 0,0:06:40.10,0:06:41.65,Default,,0,0,0,,Бұл... құрмет!
Dialogue: 0,0:06:41.73,0:06:42.61,Default,,0,0,0,,Ширауды одан сайын тартыңыз!
Dialogue: 0,0:06:44.61,0:06:46.73,Default,,0,0,0,,Баа!
Dialogue: 0,0:06:49.78,0:06:52.57,Default,,0,0,0,,А-а, тағы да осындай былық шығардың.
Dialogue: 0,0:06:52.66,0:06:54.12,Default,,0,0,0,,Бэмби-чан
Dialogue: 0,0:06:54.20,0:06:56.33,Default,,0,0,0,,Бөлмеде бәрі жақсы, солай ма?
Dialogue: 0,0:06:56.41,0:06:58.04,Default,,0,0,0,,Сырттан да, іштен де айтқан жоқпын.
Dialogue: 0,0:06:58.70,0:07:01.17,Default,,0,0,0,,Мен ренжісем, әдемі еркектерді таңдап, өлтіретін әдетім бар.
Dialogue: 0,0:07:01.25,0:07:02.88,Default,,0,0,0,,Сіз маған бірдеңе істеуді айтып тұрсыз!
Dialogue: 0,0:07:03.50,0:07:05.09,Default,,0,0,0,,не үшін қолданылады?
Dialogue: 0,0:07:05.17,0:07:06.67,Default,,0,0,0,,Басбидің бейбақы
Dialogue: 0,0:07:06.75,0:07:09.17,Default,,0,0,0,,Олар сол жерде әлі Гья Гья жасап жатыр.
Dialogue: 0,0:07:09.26,0:07:13.22,Default,,0,0,0,,Бетімді көрсетсем ше? Сіз де қатты ашулысыз, солай емес пе?
Dialogue: 0,0:07:13.30,0:07:15.76,Default,,0,0,0,,Шынымен ақымақ емес
Dialogue: 0,0:07:16.39,0:07:18.39,Default,,0,0,0,,Мен мүлде түсінбеймін!
Dialogue: 0,0:07:18.47,0:07:21.98,Default,,0,0,0,,Бұл не? Біреу түсіндіріңізші!
Dialogue: 0,0:07:22.06,0:07:24.48,Default,,0,0,0,,Түсіндірме! Оны кім жасайды?
Dialogue: 0,0:07:24.56,0:07:27.23,Default,,0,0,0,,) Егер кімде-кім мұны істей алатын болса, бұл тек Ұлы мәртебелі.
Dialogue: 0,0:07:27.32,0:07:28.82,Default,,0,0,0,,Түсіндіру және бос сөз
Dialogue: 0,0:07:28.90,0:07:33.03,Default,,0,0,0,,Мұрагер дегенді бірінші рет естіп тұрған шығармын, бейбақ.
Dialogue: 0,0:07:33.11,0:07:35.49,Default,,0,0,0,,Мәртебелі мырза, көп ұзамай қалды ма деп ойлаймын.
Dialogue: 0,0:07:35.58,0:07:39.25,Default,,0,0,0,,Кэнди-чан, сол мұрагерді неге шымшып көрмейсің?
Dialogue: 0,0:07:39.33,0:07:42.50,Default,,0,0,0,,Иә? Адамдарды менсінбейтін сияқты сөйлеме!
Dialogue: 0,0:07:42.58,0:07:44.46,Default,,0,0,0,,Сіз бұл шындық емес сияқты айтасыз.
Dialogue: 0,0:07:44.54,0:07:45.08,Default,,0,0,0,,мен жіпті көремін.
Dialogue: 0,0:07:45.17,0:07:47.46,Default,,0,0,0,,Тәтті, түсіндің бе?
Dialogue: 0,0:07:51.88,0:07:53.13,Default,,0,0,0,,Қайда бара жатырсың? busbee
Dialogue: 0,0:07:54.14,0:07:56.64,Default,,0,0,0,,Сіз ешқайда кетпейсіз, солай ма?
Dialogue: 0,0:07:57.39,0:08:00.22,Default,,0,0,0,,Мен ұлы мәртебелі мұрагермін.
Dialogue: 0,0:08:00.31,0:08:02.85,Default,,0,0,0,,Мен бұл сен деп ойладым.
Dialogue: 0,0:08:03.35,0:08:05.19,Default,,0,0,0,,Егер сіз мұрагер болсаңыз
Dialogue: 0,0:08:05.27,0:08:08.52,Default,,0,0,0,,Рыцарлардың көпшілігі (Риттер) шағымданбас еді.
Dialogue: 0,0:08:08.61,0:08:11.57,Default,,0,0,0,,Сонда да сен ештеңе емессің!
Dialogue: 0,0:08:11.65,0:08:14.07,Default,,0,0,0,,Мәртебелі қалауы бәрі.
Dialogue: 0,0:08:14.57,0:08:17.45,Default,,0,0,0,,Мен сияқты біреудің араласатын жері жоқ.
Dialogue: 0,0:08:18.78,0:08:22.66,Default,,0,0,0,,Цк... Бұл ақымақтық. Менің көңілім қалды.
Dialogue: 0,0:08:23.16,0:08:26.50,Default,,0,0,0,,Олай болса маған дәл қазір мына орындықты беріңіз!
Dialogue: 0,0:08:26.58,0:08:28.92,Default,,0,0,0,,Егер бұл орындық болса, осылай шығып кетуге болады.
Dialogue: 0,0:08:29.00,0:08:31.26,Default,,0,0,0,,Мен оны алып, отырамын!
Dialogue: 0,0:08:31.34,0:08:32.67,Default,,0,0,0,,Сабыр ет, Басби.
Dialogue: 0,0:08:32.76,0:08:35.68,Default,,0,0,0,,О? Мен тынышпын
Dialogue: 0,0:08:35.76,0:08:37.26,Default,,0,0,0,,Сіз қазіргіден әлдеқайда жақсы!
Dialogue: 0,0:08:39.01,0:08:39.60,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:42.43,0:08:45.14,Default,,0,0,0,,Рас, сен сабырлысың.
Dialogue: 0,0:08:45.23,0:08:47.81,Default,,0,0,0,,Асықпады
Dialogue: 0,0:08:47.90,0:08:51.19,Default,,0,0,0,,Мен тынышпын Мен сабырлымын ~
Dialogue: 0,0:08:51.28,0:08:54.90,Default,,0,0,0,,Кнуклевар, сен қандай еліктеп жатырсың?
Dialogue: 0,0:08:54.99,0:08:58.16,Default,,0,0,0,,Мен саған көмектестім. Ұрыс жақсы емес.
Dialogue: 0,0:08:58.24,0:09:00.24,Default,,0,0,0,,Қалай болғанда да, тоқтайтын кез келді.
Dialogue: 0,0:09:00.33,0:09:03.16,Default,,0,0,0,,Мұндай шайқас дәмді де, сөзбен жеткізу мүмкін емес.
Dialogue: 0,0:09:03.75,0:09:06.87,Default,,0,0,0,,Бұл сізге әсіресе улы.
Dialogue: 0,0:09:06.96,0:09:08.67,Default,,0,0,0,,Сіз білуіңіз керек
Dialogue: 0,0:09:08.75,0:09:12.05,Default,,0,0,0,,Сәлем? келесі император
Dialogue: 0,0:09:25.81,0:09:30.06,Default,,0,0,0,,Салтанатты шараның алдында мен сізге бір сұрақ қойғым келеді.
Dialogue: 0,0:09:30.15,0:09:31.19,Default,,0,0,0,,Хмм
Dialogue: 0,0:09:31.77,0:09:35.19,Default,,0,0,0,,Мен неге сіздің мұрагеріңізмін?
Dialogue: 0,0:09:36.07,0:09:37.70,Default,,0,0,0,,Сұрақ?
Dialogue: 0,0:09:37.78,0:09:42.12,Default,,0,0,0,,Мен сізді неге мұрагер етіп тағайындадым, т.б.
Dialogue: 0,0:09:42.20,0:09:45.54,Default,,0,0,0,,Біраз ойланып қарасаңыз, түсінесіз.
Dialogue: 0,0:09:47.08,0:09:50.38,Default,,0,0,0,,Түсінбейсіз бе? сұрайық.
Dialogue: 0,0:09:50.88,0:09:55.76,Default,,0,0,0,,Урю, сен неге қазір тірісің?
Dialogue: 0,0:10:14.53,0:10:17.40,Default,,0,0,0,,Сіз білесіз
Dialogue: 0,0:10:17.49,0:10:22.53,Default,,0,0,0,,Сіз бағыштаудан тыс аман қалдыңыз (Аусвелен).
Dialogue: 0,0:10:22.62,0:10:26.33,Default,,0,0,0,,Тарихтағы жалғыз Квинси.
Dialogue: 0,0:10:26.41,0:10:30.92,Default,,0,0,0,,Сіздің аман қалуыңыздың себебі бар.
Dialogue: 0,0:10:32.04,0:10:34.09,Default,,0,0,0,,Анам қайтыс болған күннен бастап
Dialogue: 0,0:10:34.17,0:10:35.84,Default,,0,0,0,,Мен бұл туралы көптен бері ойлап жүрдім.
Dialogue: 0,0:10:36.34,0:10:39.47,Default,,0,0,0,,Неліктен анам өліп, мені тірі қалдырды?
Dialogue: 0,0:10:39.97,0:10:42.05,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:10:42.55,0:10:45.39,Default,,0,0,0,,Жауабы атамның дәптерінде болатын.
Dialogue: 0,0:10:45.89,0:10:48.27,Default,,0,0,0,,Бұрынғы Мәртебелі сөзінде
Dialogue: 0,0:10:48.35,0:10:51.69,Default,,0,0,0,,Мен мұның бәрі шындық екеніне сенімді болдым.
Dialogue: 0,0:10:51.77,0:10:56.48,Default,,0,0,0,,Квинси ешқандай жағдайда Grim Reaper-мен үйлесімді емес.
Dialogue: 0,0:10:57.44,0:11:00.74,Default,,0,0,0,,Ал мен кіммін?
Dialogue: 0,0:11:02.82,0:11:04.24,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:11:06.12,0:11:09.08,Default,,0,0,0,,Бәрінен үзіліп, осында келдім.
Dialogue: 0,0:11:09.58,0:11:11.87,Default,,0,0,0,,Өлім құдайын жерлеу
Dialogue: 0,0:11:15.21,0:11:17.88,Default,,0,0,0,,Менімен бірге жүр
Dialogue: 0,0:11:18.55,0:11:21.63,Default,,0,0,0,,Мен саған болашақты көрсетемін
Dialogue: 0,0:11:23.05,0:11:25.39,Default,,0,0,0,,Мәртебелі.
Dialogue: 0,0:11:40.99,0:11:45.41,Default,,0,0,0,,Енді сіздің күшіңіз жақында оянады.
Dialogue: 0,0:11:46.03,0:11:48.04,Default,,0,0,0,,Қасиетті хаттарды беріңіз
Dialogue: 0,0:11:48.99,0:11:53.87,Default,,0,0,0,,Сізде мен сияқты «А» әрпі бар.
Dialogue: 0,0:12:05.51,0:12:07.26,Default,,0,0,0,,Бұл реакция...
Dialogue: 0,0:12:07.35,0:12:08.43,Default,,0,0,0,,Көп нәрсе болды, бірақ ақыры өз орныңды тапқан сияқтысың.
Dialogue: 0,0:12:08.51,0:12:11.89,Default,,0,0,0,,Бұл Негар қирандылары алыс еді.
Dialogue: 0,0:12:11.98,0:12:15.35,Default,,0,0,0,,Сіз аман-есен жеткен сияқтысыз. Мен қуаныштымын.
Dialogue: 0,0:12:15.86,0:12:19.23,Default,,0,0,0,,Бұл көбірек уақытты қажет ететін сияқты.
Dialogue: 0,0:12:19.32,0:12:22.82,Default,,0,0,0,,Ол жақсы деді, өйткені ол Перо-чан арқылы қарап отырды.
Dialogue: 0,0:12:22.90,0:12:25.95,Default,,0,0,0,,Қатты қиналсам да, олар келмеді.
Dialogue: 0,0:12:26.03,0:12:26.95,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:12:27.74,0:12:29.99,Default,,0,0,0,,Мен жаттығуды бірден бастаймын.
Dialogue: 0,0:12:30.49,0:12:32.96,Default,,0,0,0,,Уақытымыз аз
Dialogue: 0,0:12:33.04,0:12:34.87,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:12:36.08,0:12:39.13,Default,,0,0,0,,Куросаки-кун, жақсысың ба?
Dialogue: 0,0:12:49.56,0:12:50.97,Default,,0,0,0,,Ичиго.
Dialogue: 0,0:12:51.06,0:12:56.10,Default,,0,0,0,,Қазіргі жағдайға байланысты Юхабахты жеңу мүмкін емес.
Dialogue: 0,0:12:56.19,0:12:59.36,Default,,0,0,0,,Сондықтан мен сенің өлім құдайынан асып түсуіңді сұраймын.
Dialogue: 0,0:12:59.44,0:13:01.53,Default,,0,0,0,,Мен бәрінен де асып түсемін
Dialogue: 0,0:13:01.61,0:13:02.32,Default,,0,0,0,,Сондықтан...
Dialogue: 0,0:13:02.40,0:13:05.70,Default,,0,0,0,,Занпакутоны қалай пайдалану керектігін үйреткеннен кейін
Dialogue: 0,0:13:05.78,0:13:08.20,Default,,0,0,0,,Шинигами шинигами болып қалады.
Dialogue: 0,0:13:08.28,0:13:09.20,Default,,0,0,0,,А...
Dialogue: 0,0:13:09.95,0:13:11.12,Default,,0,0,0,,Ком-Омбодағы адам да шынайы емес пе еді?
Dialogue: 0,0:13:11.20,0:13:12.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:14.71,0:13:16.00,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:13:16.08,0:13:17.50,Default,,0,0,0,,Жұмысты бастау
Dialogue: 0,0:13:28.72,0:13:31.18,Default,,0,0,0,,Бұл Рух Патшасының рұқсатынсыз.
Dialogue: 0,0:13:31.26,0:13:35.60,Default,,0,0,0,,Бұл киелі аймақ, оған кіруге болмайды.
Dialogue: 0,0:13:36.23,0:13:37.31,Default,,0,0,0,,Рух патшасы…
Dialogue: 0,0:13:37.39,0:13:41.32,Default,,0,0,0,,Онши өлім құдайынан асып түсетін ыдыс екенін.
Dialogue: 0,0:13:41.40,0:13:43.86,Default,,0,0,0,,Маған растауға рұқсат етіңіз
Dialogue: 0,0:13:47.07,0:13:49.70,Default,,0,0,0,,Қолыңнан келгеннің бәрін істеп жатырсың ба, Ичиго?
Dialogue: 0,0:13:49.78,0:13:51.20,Default,,0,0,0,,Сіз уайымдап тұрсыз ба?
Dialogue: 0,0:13:51.28,0:13:54.29,Default,,0,0,0,,Ол адам тамақ іше алмайды.
Dialogue: 0,0:13:54.37,0:13:56.37,Default,,0,0,0,,Мен де өзіммен бірге Ичигоны алып кеттім.
Dialogue: 0,0:13:56.46,0:13:59.29,Default,,0,0,0,,Бұл шынымен де Сейрейтей үшін бе?
Dialogue: 0,0:13:59.38,0:14:00.42,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:00.50,0:14:03.05,Default,,0,0,0,,Ой, жоқ, жоқ, жоқ.
Dialogue: 0,0:14:03.13,0:14:05.01,Default,,0,0,0,,Оны қазір ұмыт, хехе
Dialogue: 0,0:14:06.67,0:14:09.18,Default,,0,0,0,,Қолымыздан келгенін істейік.
Dialogue: 0,0:14:09.26,0:14:10.09,Default,,0,0,0,,Иә
Dialogue: 0,0:14:11.01,0:14:12.72,Default,,0,0,0,,Ал...
Dialogue: 0,0:14:12.81,0:14:14.18,Default,,0,0,0,,Бұйрық бермеңіз!
Dialogue: 0,0:14:14.27,0:14:17.69,Default,,0,0,0,,Басыңды иіп: «Өтінемін!» деп сұрамайсың ба?
Dialogue: 0,0:14:17.77,0:14:19.52,Default,,0,0,0,,Кім иіліп жатыр!
Dialogue: 0,0:14:19.60,0:14:22.65,Default,,0,0,0,,Телефон арқылы да айта аламын. Басыңды име!
Dialogue: 0,0:14:22.73,0:14:24.65,Default,,0,0,0,,Мен мұны бәрібір сізге қалдырдым.
Dialogue: 0,0:14:24.73,0:14:27.32,Default,,0,0,0,,Сіз мұны жасай алатын жалғыз адамсыз!
Dialogue: 0,0:14:27.40,0:14:30.36,Default,,0,0,0,,Таңдалған адам болу қандай сезім! Мен шыдай алмаймын
Dialogue: 0,0:14:30.45,0:14:31.03,Default,,0,0,0,,Хонана~!
Dialogue: 0,0:14:31.12,0:14:31.66,Default,,0,0,0,,(Қоңырау ажыратылған дыбыс)
Dialogue: 0,0:14:31.74,0:14:33.45,Default,,0,0,0,,Күте тұрыңыз, мен қайғырып отырмын! (Арисакида) Хиори-сан
Dialogue: 0,0:14:33.53,0:14:36.20,Default,,0,0,0,,Жан қоғамынан пакет келді.
Dialogue: 0,0:14:36.29,0:14:36.87,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:14:36.95,0:14:38.79,Default,,0,0,0,,Дұрысы, поштаны жеткізуге бола ма?
Dialogue: 0,0:14:38.87,0:14:40.00,Default,,0,0,0,,Және жолда!
Dialogue: 0,0:14:40.08,0:14:42.79,Default,,0,0,0,,Жіберуші – бірлескен атау
Dialogue: 0,0:14:42.88,0:14:46.26,Default,,0,0,0,,Мако Хирако және Майури Нирика
Dialogue: 0,0:14:48.88,0:14:52.01,Default,,0,0,0,,А, енді қолыңнан келмейді, қарғыс атсын!
Dialogue: 0,0:14:52.09,0:14:53.89,Default,,0,0,0,,«Осы әлем мен жан қоғамы арасында»
Dialogue: 0,0:14:53.97,0:14:57.31,Default,,0,0,0,,«Мазасыз дүниенің бұрмалануын жөндеу тобының» құрылуы!
Dialogue: 0,0:14:57.39,0:14:59.14,Default,,0,0,0,,Қалыптастыру...
Dialogue: 0,0:14:59.23,0:15:00.60,Default,,0,0,0,,Біз де солай істейміз бе?
Dialogue: 0,0:15:00.69,0:15:03.19,Default,,0,0,0,,Көрініп тұр, ақымақ!
Dialogue: 0,0:15:05.02,0:15:07.78,Default,,0,0,0,,(Тердің ағу дыбысы)
Dialogue: 0,0:15:09.74,0:15:10.53,Default,,0,0,0,,(Тердің ағуы)
Dialogue: 0,0:15:14.95,0:15:15.87,Default,,0,0,0,,(Үлкен қоңыраудың дыбысы)
Dialogue: 0,0:15:15.95,0:15:17.62,Default,,0,0,0,,Пуха!
Dialogue: 0,0:15:17.70,0:15:20.71,Default,,0,0,0,,Ху~ Бұл қиын.
Dialogue: 0,0:15:20.79,0:15:21.92,Default,,0,0,0,,Оян!
Dialogue: 0,0:15:22.00,0:15:25.17,Default,,0,0,0,,Жағдаятқа жай ғана бетпе-бет келуге үйретуде не қиын?
Dialogue: 0,0:15:25.25,0:15:28.13,Default,,0,0,0,,Ақымақ! Мен лайық емеспін
Dialogue: 0,0:15:28.21,0:15:32.13,Default,,0,0,0,,Бір орында тұрып қалмайсың, одақтастарыңа қылыш сілтемейсің.
Dialogue: 0,0:15:32.22,0:15:33.84,Default,,0,0,0,,Мен... мен де
Dialogue: 0,0:15:33.93,0:15:36.76,Default,,0,0,0,,Мен одақтасқа қылыш сілтеуге жарамаймын!
Dialogue: 0,0:15:36.85,0:15:38.64,Default,,0,0,0,,Егер ішіне әдемі қызбен бірге мінгенімде ғой.
Dialogue: 0,0:15:39.14,0:15:40.60,Default,,0,0,0,,Иә, Кучики.
Dialogue: 0,0:15:41.10,0:15:41.94,Default,,0,0,0,,Иә
Dialogue: 0,0:15:42.44,0:15:43.52,Default,,0,0,0,,Шынымен!
Dialogue: 0,0:15:43.60,0:15:45.36,Default,,0,0,0,,Иә? Ол кім? иә
Dialogue: 0,0:15:45.44,0:15:46.82,Default,,0,0,0,,Киринджи храмы залынан
Dialogue: 0,0:15:46.90,0:15:49.19,Default,,0,0,0,,Ағам жазылып кеткен сияқты!
Dialogue: 0,0:15:50.44,0:15:53.11,Default,,0,0,0,,Бұл өте ұзақ ванна болды.
Dialogue: 0,0:15:53.20,0:15:56.03,Default,,0,0,0,,Мен ваннада көп болдым.
Dialogue: 0,0:15:56.12,0:15:57.87,Default,,0,0,0,,Бұл бірінші рет.
Dialogue: 0,0:15:58.66,0:16:01.12,Default,,0,0,0,,Сіз қалай ойлайсыз? Қызып кетпейсіз бе?
Dialogue: 0,0:16:01.87,0:16:03.50,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:16:04.46,0:16:09.51,Default,,0,0,0,,Менің күшім тым жетілмегенін білемін.
Dialogue: 0,0:16:10.42,0:16:12.42,Default,,0,0,0,,Өйткені ол мәңгілікке созылады
Dialogue: 0,0:16:12.51,0:16:15.89,Default,,0,0,0,,Сіз толқу үшін күш алуыңыз керек.
Dialogue: 0,0:16:16.76,0:16:17.76,Default,,0,0,0,,Иә
Dialogue: 0,0:16:17.85,0:16:20.52,Default,,0,0,0,,Сіз қалпына келдіңіз бе? Жақсы
Dialogue: 0,0:16:20.60,0:16:23.81,Default,,0,0,0,,Айтпақшы, сандарды қашан ауыстырдыңыз?
Dialogue: 0,0:16:23.89,0:16:25.94,Default,,0,0,0,,Да~хахахаха!
Dialogue: 0,0:16:26.02,0:16:28.98,Default,,0,0,0,,Енді сіз көп сөйлей аласыз.
Dialogue: 0,0:16:29.73,0:16:32.86,Default,,0,0,0,,Мен мұнда алғаш келгенде қозғала алмадым.
Dialogue: 0,0:16:32.95,0:16:35.57,Default,,0,0,0,,Еденде жай ғана қисайғандар
Dialogue: 0,0:16:35.66,0:16:37.99,Default,,0,0,0,,Жоқ, бұл керемет! Бұл тамаша!
Dialogue: 0,0:16:38.58,0:16:43.00,Default,,0,0,0,,Артқы бөлмеге келіп, менімен бірге жаттығасың ба?
Dialogue: 0,0:16:43.08,0:16:44.25,Default,,0,0,0,,Иә!
Dialogue: 0,0:16:45.12,0:16:45.87,Default,,0,0,0,,Ичиго?
Dialogue: 0,0:16:45.96,0:16:47.29,Default,,0,0,0,,Егер Арисава
Dialogue: 0,0:16:47.38,0:16:50.13,Default,,0,0,0,,Ичигоның қайда кеткенін білесің бе деп ойлап едім.
Dialogue: 0,0:16:50.21,0:16:52.01,Default,,0,0,0,,Сіз білуге ​​мүмкіндік жоқ, солай ма?
Dialogue: 0,0:16:52.09,0:16:54.05,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:16:54.13,0:16:57.30,Default,,0,0,0,,Чад, Инуэ мырза және Ишида мырза мұнда жоқ.
Dialogue: 0,0:16:57.39,0:16:59.89,Default,,0,0,0,,Менің ойымша, бұл Жан қоғамына қатысты нәрсе.
Dialogue: 0,0:16:59.97,0:17:01.64,Default,,0,0,0,,Үй тапсырмасын орындауға қатысты
Dialogue: 0,0:17:02.14,0:17:02.89,Default,,0,0,0,,Кім?
Dialogue: 0,0:17:03.60,0:17:06.19,Default,,0,0,0,,Сіз 8-ші отрядтың капитанысыз, солай ма?
Dialogue: 0,0:17:06.27,0:17:10.77,Default,,0,0,0,,Мен өзімді таныстырмасам да, мені есіңе түсіргеніне қуаныштымын.
Dialogue: 0,0:17:11.40,0:17:12.40,Default,,0,0,0,,Мен сізге қалай көмектесе аламын?
Dialogue: 0,0:17:12.90,0:17:16.70,Default,,0,0,0,,Бұл капитан шыға алатындай маңызды оқиға, солай емес пе?
Dialogue: 0,0:17:16.78,0:17:17.49,Default,,0,0,0,,О
Dialogue: 0,0:17:17.57,0:17:21.99,Default,,0,0,0,,Бүгін мен сізге бір нәрсе айтуым керек.
Dialogue: 0,0:17:22.49,0:17:24.91,Default,,0,0,0,,Ичиго-кунмен қоштасу туралы
Dialogue: 0,0:17:26.12,0:17:28.17,Default,,0,0,0,,Қоштасу дегеніміз не?
Dialogue: 0,0:17:28.25,0:17:30.25,Default,,0,0,0,,Балалар, бәрібір мені қайтадан араластырдыңдар.
Dialogue: 0,0:17:30.34,0:17:31.46,Default,,0,0,0,,Сәлем Кейго!
Dialogue: 0,0:17:31.55,0:17:33.38,Default,,0,0,0,,Өзіңнің жалғыз сатылатын жерің – жастығың екенін көрсеткің келе ме? Енді жас емессің ғой
Dialogue: 0,0:17:33.46,0:17:34.59,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:34.67,0:17:36.84,Default,,0,0,0,,Сіз ойлағандай
Dialogue: 0,0:17:36.93,0:17:39.93,Default,,0,0,0,,Ичиго-кун енді жан қоғамын қорғау үшін.
Dialogue: 0,0:17:40.01,0:17:41.68,Default,,0,0,0,,Ол осында келе жатыр.
Dialogue: 0,0:17:42.56,0:17:44.52,Default,,0,0,0,,Ичиго қазір қайда бара жатыр?
Dialogue: 0,0:17:44.60,0:17:47.77,Default,,0,0,0,,Жан қоғамында ерекше орын.
Dialogue: 0,0:17:48.27,0:17:52.90,Default,,0,0,0,,Әңгіме ол туралы болғандықтан, ол аман-есен оралады деп ойлаймын.
Dialogue: 0,0:17:53.61,0:17:55.53,Default,,0,0,0,,Бірақ мені алаңдататын нәрсе
Dialogue: 0,0:17:55.61,0:18:00.37,Default,,0,0,0,,Оның қандай күшпен қайтып келетінін білмейміз.
Dialogue: 0,0:18:00.87,0:18:03.04,Default,,0,0,0,,Бұл мәселе неде?
Dialogue: 0,0:18:03.12,0:18:05.25,Default,,0,0,0,,Күш түріне байланысты
Dialogue: 0,0:18:05.33,0:18:08.58,Default,,0,0,0,,Бұл өмірге де әсер етуі мүмкін.
Dialogue: 0,0:18:09.08,0:18:10.75,Default,,0,0,0,,Егер бұл орын алса...
Dialogue: 0,0:18:11.34,0:18:14.42,Default,,0,0,0,,Мен оның бұл дүниеге оралуына жол бере алмаймын.
Dialogue: 0,0:18:15.09,0:18:18.51,Default,,0,0,0,,Мұның бәрі сізге байланысты!
Dialogue: 0,0:18:18.59,0:18:20.89,Default,,0,0,0,,Ичиго сол жерге жан қоғамына барды.
Dialogue: 0,0:18:20.97,0:18:25.14,Default,,0,0,0,,Мені мына дүние үшін қамап қоясың ба?
Dialogue: 0,0:18:26.35,0:18:28.14,Default,,0,0,0,,Бұл жағдайда солай болады.
Dialogue: 0,0:18:29.19,0:18:29.98,Default,,0,0,0,,Бұл…
Dialogue: 0,0:18:30.06,0:18:33.07,Default,,0,0,0,,Мүмкіндіктер туралы айту... солай ма?
Dialogue: 0,0:18:34.07,0:18:37.86,Default,,0,0,0,,Ағымдағы болжамның ақиқат болу ықтималдығы қаншалықты?
Dialogue: 0,0:18:37.95,0:18:41.78,Default,,0,0,0,,Оның орын алу мүмкіндігі 10 000-нан 1 немесе одан аз.
Dialogue: 0,0:18:41.87,0:18:46.45,Default,,0,0,0,,Бұлай болуы мүмкін емес екені рас.
Dialogue: 0,0:18:46.95,0:18:50.83,Default,,0,0,0,,Неліктен мұндай мүмкіндік туралы айтудың қажеті бар ...
Dialogue: 0,0:18:50.92,0:18:56.13,Default,,0,0,0,,Достарыңыздың мұндай мүмкіндігі туралы үндемегеніңіз дұрыс.
Dialogue: 0,0:18:56.21,0:18:58.84,Default,,0,0,0,,Ичиго-кунға қарыздармын деп айта аласыз ба?
Dialogue: 0,0:19:00.30,0:19:01.34,Default,,0,0,0,,Жарақатым жазылды, сондықтан бүгіннен бастап қалыпты мектеп кестесіне оралдым.
Dialogue: 0,0:19:02.34,0:19:03.47,Default,,0,0,0,,Иә, бұл!
Dialogue: 0,0:19:07.98,0:19:09.52,Default,,0,0,0,,Не? Бұл
Dialogue: 0,0:19:09.60,0:19:11.98,Default,,0,0,0,,Бұл жан билеті деп аталады.
Dialogue: 0,0:19:12.06,0:19:15.23,Default,,0,0,0,,Төтенше жағдайда сіз «Жан» қоғамына бара аласыз.
Dialogue: 0,0:19:15.32,0:19:18.57,Default,,0,0,0,,Бұл Ичиго-кунды көруге билет.
Dialogue: 0,0:19:19.78,0:19:21.57,Default,,0,0,0,,Бұл бетті жасама.
Dialogue: 0,0:19:22.20,0:19:24.70,Default,,0,0,0,,Бүгін немесе ертең туралы ештеңе жоқ
Dialogue: 0,0:19:24.78,0:19:27.24,Default,,0,0,0,,Әлі ұзақ жол
Dialogue: 0,0:19:32.33,0:19:34.71,Default,,0,0,0,,Шаршадыңыз ба? Инуэ
Dialogue: 0,0:19:34.79,0:19:36.59,Default,,0,0,0,,Бүгінгі күнді атаймыз ба?
Dialogue: 0,0:19:37.92,0:19:41.72,Default,,0,0,0,,Мен өзімді сондай тыныш сезіндім.
Dialogue: 0,0:19:41.80,0:19:43.14,Default,,0,0,0,,Бейбітшілік?
Dialogue: 0,0:19:43.64,0:19:46.47,Default,,0,0,0,,Олар бізге жақында басып кірсе, таң қалмас еді.
Dialogue: 0,0:19:46.56,0:19:49.22,Default,,0,0,0,,Бұл рас...
Dialogue: 0,0:19:49.93,0:19:53.31,Default,,0,0,0,,Бірақ, адам ретінде біз
Dialogue: 0,0:19:53.40,0:19:57.77,Default,,0,0,0,,Қиял әлемінде қалыпты өмір сүру, қираған адамдарға көмектесу.
Dialogue: 0,0:19:57.86,0:20:00.57,Default,,0,0,0,,Шинигами халқы үшін аянбай еңбек ету...
Dialogue: 0,0:20:00.65,0:20:03.03,Default,,0,0,0,,Мен мұны жақсы деп ойладым.
Dialogue: 0,0:20:04.62,0:20:08.16,Default,,0,0,0,,Мен мұндай нәрселер мәңгілікке жалғаса берсін.
Dialogue: 0,0:20:08.79,0:20:10.62,Default,,0,0,0,,Бір-бірімізге мәңгілік көмектесейік
Dialogue: 0,0:20:11.12,0:20:13.92,Default,,0,0,0,,Бір-бірінің дүниесін бағала
Dialogue: 0,0:20:14.83,0:20:16.29,Default,,0,0,0,,Мәңгілік сияқты
Dialogue: 0,0:20:16.88,0:20:20.30,Default,,0,0,0,,Ұрыс ешқашан басталған жоқ...
Dialogue: 0,0:20:21.13,0:20:23.93,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:20:47.78,0:20:49.66,Default,,0,0,0,,Не? Не болды!
Dialogue: 0,0:20:49.74,0:20:51.16,Default,,0,0,0,,Бұл қандай көрініс?
Dialogue: 0,0:20:51.25,0:20:51.83,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:20:51.91,0:20:54.33,Default,,0,0,0,,Барлық құралдар ауытқуларды көрсетуде
Dialogue: 0,0:20:54.41,0:20:55.67,Default,,0,0,0,,Не болып жатыр!
Dialogue: 0,0:20:55.75,0:20:57.04,Default,,0,0,0,,Бұл Жолиненің брошы
Dialogue: 0,0:20:57.13,0:20:59.92,Default,,0,0,0,,Мынадай нәрсе... осындай нәрсе болуы мүмкін бе?
Dialogue: 0,0:21:00.00,0:21:03.17,Default,,0,0,0,,Сейрейтей... жоғалып кетті!
Dialogue: 0,0:21:04.84,0:21:07.14,Default,,0,0,0,,Шабуыл аяқталды.
Dialogue: 0,0:21:07.80,0:21:08.43,Default,,0,0,0,,Урю
Dialogue: 0,0:21:09.43,0:21:13.06,Default,,0,0,0,,Кайзер Гесанды білесіз бе?
Dialogue: 0,0:21:13.14,0:21:13.77,Default,,0,0,0,,Иә
Dialogue: 0,0:21:14.39,0:21:16.52,Default,,0,0,0,,«Квинсидің түрмедегі патшасы»
Dialogue: 0,0:21:16.60,0:21:19.44,Default,,0,0,0,,«900 жылдан кейін жүрек соғысын қалпына келтіру»
Dialogue: 0,0:21:19.94,0:21:22.03,Default,,0,0,0,,«90 жылдан кейін ақыл-ойды қалпына келтіру»
Dialogue: 0,0:21:22.90,0:21:25.61,Default,,0,0,0,,«Тоғыз жылдан кейін билікті қалпына келтіру»
Dialogue: 0,0:21:26.36,0:21:29.28,Default,,0,0,0,,Әнде тағы да көп нәрсе бар
Dialogue: 0,0:21:30.08,0:21:33.25,Default,,0,0,0,,«Квинсидің түрмедегі патшасы»
Dialogue: 0,0:21:33.33,0:21:36.67,Default,,0,0,0,,«900 жылдан кейін жүрек соғысын қалпына келтіру»
Dialogue: 0,0:21:36.75,0:21:40.17,Default,,0,0,0,,«90 жылдан кейін ақыл-ойды қалпына келтіру»
Dialogue: 0,0:21:40.25,0:21:43.55,Default,,0,0,0,,«Тоғыз жылдан кейін билікті қалпына келтіру»
Dialogue: 0,0:21:46.26,0:21:48.55,Default,,0,0,0,,«Тоғыз күн ішінде»
Dialogue: 0,0:21:51.30,0:21:53.56,Default,,0,0,0,,«Әлемді қайтарып ал»
Dialogue: 0,0:21:54.18,0:21:56.94,Default,,0,0,0,,Кеттік, Урю Хашвальд.
Dialogue: 0,0:21:58.81,0:22:01.94,Default,,0,0,0,,Тоғыз күннен кейін дүние жойылады.
Dialogue: 0,0:22:06.82,0:22:08.82,Default,,0,0,0,,♪～
Dialogue: 0,0:23:32.03,0:23:34.03,Default,,0,0,0,,～♪
Dialogue: 0,0:23:38.91,0:23:41.46,Default,,0,0,0,,Арқамдағы қақаған аяз
Dialogue: 0,0:23:42.08,0:23:46.42,Default,,0,0,0,,Жанып тұрған пышақтың тітіркенуін кесіңіз
Dialogue: 0,0:23:47.92,0:23:53.92,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
