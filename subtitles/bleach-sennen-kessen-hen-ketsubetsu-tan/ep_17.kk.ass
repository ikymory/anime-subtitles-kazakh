Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.75,0:00:04.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:00:04.17,0:00:05.50,Default,,0,0,0,,Гвааах!
Dialogue: 0,0:00:09.50,0:00:13.59,Default,,0,0,0,,Нағыз үмітсіздік осыдан басталады.
Dialogue: 0,0:00:15.01,0:00:17.76,Default,,0,0,0,,Яббе жаңғырып, ұшып кетті
Dialogue: 0,0:00:17.85,0:00:20.27,Default,,0,0,0,,Жақсы емес пе? Егер сіз оны қолданғыңыз келсе, оны қолданыңыз.
Dialogue: 0,0:00:20.35,0:00:22.85,Default,,0,0,0,,Шаршағандықтан маған керегі жоқ.
Dialogue: 0,0:00:22.93,0:00:24.31,Default,,0,0,0,,Мен де
Dialogue: 0,0:00:24.39,0:00:25.52,Default,,0,0,0,,Бамбиетта
Dialogue: 0,0:00:25.60,0:00:27.19,Default,,0,0,0,,Сіз оны пайдаланып жатқан сияқтысыз.
Dialogue: 0,0:00:27.27,0:00:28.82,Default,,0,0,0,,Менің ойымша, солай.
Dialogue: 0,0:00:28.90,0:00:31.74,Default,,0,0,0,,Жоғалып кеткеніміз болса да, ренжідім.
Dialogue: 0,0:00:31.82,0:00:33.36,Default,,0,0,0,,Қорқынышты
Dialogue: 0,0:00:33.45,0:00:36.70,Default,,0,0,0,,Жоқ, ол бала сияқты біреудің сізді пайдалануына жол бермеу керек.
Dialogue: 0,0:00:37.62,0:00:39.20,Default,,0,0,0,,Өйткені бұл бала ақымақ.
Dialogue: 0,0:00:39.91,0:00:43.54,Default,,0,0,0,,Расында да, бұл шайқас жақында бітеді.
Dialogue: 0,0:00:44.54,0:00:46.54,Default,,0,0,0,,♪～
Dialogue: 0,0:02:11.50,0:02:13.50,Default,,0,0,0,,～♪
Dialogue: 0,0:02:25.89,0:02:28.98,Default,,0,0,0,,Сіз қалай өзгердіңіз? Төңкерілген - төңкерілген...
Dialogue: 0,0:02:36.11,0:02:38.95,Default,,0,0,0,,Төңкерілген не? Дасса!
Dialogue: 0,0:02:39.03,0:02:41.41,Default,,0,0,0,,Егер сіз жоғары-төмен немесе сол-оңды білмесеңіз
Dialogue: 0,0:02:41.49,0:02:45.20,Default,,0,0,0,,Бірден жоямын, үсті-үсті, оңы-солы, алды-арты.
Dialogue: 0,0:02:45.29,0:02:48.62,Default,,0,0,0,,Менің жарылысыммен!
Dialogue: 0,0:02:55.71,0:02:56.34,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:59.34,0:03:00.72,Default,,0,0,0,,Иә
Dialogue: 0,0:03:01.51,0:03:02.68,Default,,0,0,0,,Қайта оралуыңмен!
Dialogue: 0,0:03:03.18,0:03:04.43,Default,,0,0,0,,Капитан! иә?
Dialogue: 0,0:03:05.01,0:03:06.31,Default,,0,0,0,,Қай бағыныңқы?
Dialogue: 0,0:03:06.39,0:03:08.47,Default,,0,0,0,,Ит? Күлімдей ме?
Dialogue: 0,0:03:09.31,0:03:09.85,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:10.60,0:03:11.52,Default,,0,0,0,,Иә
Dialogue: 0,0:03:13.65,0:03:15.23,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:03:16.48,0:03:18.40,Default,,0,0,0,,Абайсыз! Вице-капитан Хинамори
Dialogue: 0,0:03:18.48,0:03:22.61,Default,,0,0,0,,Оның бомбалауын Тобиумның бомбалауымен толтыруға болатын нәрсе емес.
Dialogue: 0,0:03:22.70,0:03:26.41,Default,,0,0,0,,Ал қалқансыз немесе сауытсыз сіз өзіңізді қорғай алмайсыз.
Dialogue: 0,0:03:26.49,0:03:28.20,Default,,0,0,0,,«Оның алдын алуға болмайды»?
Dialogue: 0,0:03:28.79,0:03:29.62,Default,,0,0,0,,Әй!
Dialogue: 0,0:03:29.70,0:03:33.42,Default,,0,0,0,,Ол шелек сені жеуден сақтайтын сияқты емес.
Dialogue: 0,0:03:36.59,0:03:37.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:39.88,0:03:40.76,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:03:42.47,0:03:46.35,Default,,0,0,0,,Соққы кезінде мен біртүрлі нәрсені сезіндім де, басымды жұлып алдым.
Dialogue: 0,0:03:46.43,0:03:49.39,Default,,0,0,0,,Иттен күткендей. Жануарлардың интуициясы?
Dialogue: 0,0:03:50.48,0:03:54.10,Default,,0,0,0,,Иә, сіз менің бомбалауымның алдын ала алмайсыз.
Dialogue: 0,0:03:54.19,0:03:57.36,Default,,0,0,0,,Мен Рейко бомбасын түсірмеймін.
Dialogue: 0,0:03:57.44,0:04:01.32,Default,,0,0,0,,Менің рухани баламды атып тастағанның бәрі бомбаға айналады.
Dialogue: 0,0:04:01.82,0:04:05.74,Default,,0,0,0,,Сондықтан оны көзді ашып-жұмғанша сүртіп тастаудың пайдасы жоқ.
Dialogue: 0,0:04:06.37,0:04:07.37,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:07.45,0:04:10.20,Default,,0,0,0,,Енді бұл туралы не істеуіміз керек?
Dialogue: 0,0:04:10.29,0:04:12.25,Default,,0,0,0,,Бір…чан!
Dialogue: 0,0:04:12.33,0:04:13.71,Default,,0,0,0,,Менің артымнан жүр!
Dialogue: 0,0:04:15.38,0:04:16.79,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:04:20.42,0:04:21.26,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:04:21.34,0:04:25.30,Default,,0,0,0,,Әйтеуір, сауытыңыз сынғандықтан ғана өлген жоқсыз ғой?
Dialogue: 0,0:04:25.39,0:04:27.60,Default,,0,0,0,,Шелекте не бар?
Dialogue: 0,0:04:28.10,0:04:28.72,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:35.06,0:04:38.31,Default,,0,0,0,,Бұл не... Бұл енді ит емес.
Dialogue: 0,0:04:41.82,0:04:43.57,Default,,0,0,0,,«Гуманизация техникасы»
Dialogue: 0,0:04:43.65,0:04:47.32,Default,,0,0,0,,Менің отбасымның құпиясы осы ма?
Dialogue: 0,0:04:47.99,0:04:49.12,Default,,0,0,0,,О
Dialogue: 0,0:04:49.62,0:04:54.33,Default,,0,0,0,,Менің қасқырлар отбасымның күнәлары үшін
Dialogue: 0,0:04:54.41,0:04:56.67,Default,,0,0,0,,Аңның жолына түсіп қалды
Dialogue: 0,0:04:56.75,0:04:58.88,Default,,0,0,0,,Әлі де өле алмаймын
Dialogue: 0,0:04:58.96,0:05:03.46,Default,,0,0,0,,Отбасы «Жан» қоғамына оралды
Dialogue: 0,0:05:04.13,0:05:07.64,Default,,0,0,0,,Сол кінәнің шынжырын бір сәтке үз
Dialogue: 0,0:05:07.72,0:05:13.14,Default,,0,0,0,,Айуан болып күнә жасамас бұрын күйге оралу
Dialogue: 0,0:05:13.22,0:05:15.85,Default,,0,0,0,,Үлкен күшке ие болыңыз
Dialogue: 0,0:05:15.94,0:05:20.69,Default,,0,0,0,,Бұл әдіс ізгілендіру техникасы деп аталады.
Dialogue: 0,0:05:21.19,0:05:23.19,Default,,0,0,0,,Мұны қалай істеуім керек...
Dialogue: 0,0:05:27.45,0:05:29.95,Default,,0,0,0,,Жүрегіңді ұсын
Dialogue: 0,0:05:30.03,0:05:31.03,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:31.12,0:05:33.66,Default,,0,0,0,,Жүректі өз қолыңызбен ойып алыңыз
Dialogue: 0,0:05:34.25,0:05:36.33,Default,,0,0,0,,Маған ұсыныңыз
Dialogue: 0,0:05:36.83,0:05:40.63,Default,,0,0,0,,Олай болсаң, мен саған ізгілендіру өнерін үйретемін.
Dialogue: 0,0:05:42.88,0:05:47.18,Default,,0,0,0,,Сіз алмайсыз ба? Бұл да жақсы.
Dialogue: 0,0:05:47.26,0:05:52.31,Default,,0,0,0,,Өлім құдайлары үшін өз өміріңді құрбан етуге ешқандай себеп жоқ.
Dialogue: 0,0:05:53.64,0:05:54.56,Default,,0,0,0,,Ширауды одан сайын тартыңыз!
Dialogue: 0,0:05:55.35,0:05:56.31,Default,,0,0,0,,Һм?
Dialogue: 0,0:05:56.39,0:05:59.56,Default,,0,0,0,,Тыныссыз өмір сүруге шыдай алмаймын
Dialogue: 0,0:05:59.65,0:06:02.11,Default,,0,0,0,,Отбасын тастап, қашқан ұятсыз қыран.
Dialogue: 0,0:06:02.19,0:06:04.82,Default,,0,0,0,,Оны көтерген Генрюсай-доно
Dialogue: 0,0:06:05.53,0:06:08.32,Default,,0,0,0,,Генрюсай-доно, мен оған өте қарыздармын,
Dialogue: 0,0:06:08.82,0:06:11.20,Default,,0,0,0,,Оның өмірі Квинсилердің қолында аяқталды.
Dialogue: 0,0:06:11.91,0:06:16.08,Default,,0,0,0,,Мен бұл қорлық үшін міндетті түрде кек алуым керек!
Dialogue: 0,0:06:25.67,0:06:29.38,Default,,0,0,0,,Вице-капитан Хинамори, капитан Хираконы өзіңізбен бірге алыңыз.
Dialogue: 0,0:06:29.93,0:06:30.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:32.72,0:06:33.22,Default,,0,0,0,,Иә
Dialogue: 0,0:06:37.64,0:06:39.06,Default,,0,0,0,,Сөзсіз
Dialogue: 0,0:06:41.27,0:06:42.31,Default,,0,0,0,,Банкай
Dialogue: 0,0:06:43.77,0:06:46.15,Default,,0,0,0,,Куронава Тенбан Миу
Dialogue: 0,0:06:49.99,0:06:52.37,Default,,0,0,0,,Даньёроги!
Dialogue: 0,0:07:08.38,0:07:09.67,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:07:10.17,0:07:10.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:17.31,0:07:20.85,Default,,0,0,0,,Шоқай... Банкайдың іші ит те емес.
Dialogue: 0,0:07:21.73,0:07:25.98,Default,,0,0,0,,Әлгі құбыжықтың бетінің астында ит бар шығар?
Dialogue: 0,0:07:34.53,0:07:36.12,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:07:36.91,0:07:41.62,Default,,0,0,0,,Куронава Тенкан Мио – өмірге енген сауыт банкай.
Dialogue: 0,0:07:42.25,0:07:45.13,Default,,0,0,0,,Бронды арқан сауытынан лақтырады.
Dialogue: 0,0:07:45.21,0:07:48.63,Default,,0,0,0,,Тек реиацу, тек қуат ашық.
Dialogue: 0,0:07:49.30,0:07:52.09,Default,,0,0,0,,Мен сені техникаңмен жеңе алмаймын!
Dialogue: 0,0:08:08.23,0:08:10.86,Default,,0,0,0,,Егер сіздің Рейатсуыңыз ашылып қалса, сіздің әлсіздігіңіз ашылады!
Dialogue: 0,0:08:13.53,0:08:14.57,Default,,0,0,0,,Мазарлардағы барлық ескі суреттер
Dialogue: 0,0:08:15.07,0:08:18.03,Default,,0,0,0,,Бомбаға айналып, ыдырайтын қорқыныш қорқынышты.
Dialogue: 0,0:08:18.12,0:08:20.04,Default,,0,0,0,,Өйткені өмір бар.
Dialogue: 0,0:08:20.79,0:08:25.17,Default,,0,0,0,,Егер өмір болмаса, ыдырап кетудің қорқынышты ештеңесі жоқ!
Dialogue: 0,0:08:26.04,0:08:26.88,Default,,0,0,0,,(Присцилла) Сол тәрбиесіз шлюхаға—
Dialogue: 0,0:08:26.96,0:08:30.13,Default,,0,0,0,,Құрыш - Тенбан Миу үшін өмір
Dialogue: 0,0:08:30.71,0:08:35.13,Default,,0,0,0,,Данёроги – өз өмірін қиған Тенбан Мионың бейнесі.
Dialogue: 0,0:08:35.22,0:08:37.64,Default,,0,0,0,,Жоқ... дейсіз бе?
Dialogue: 0,0:08:37.72,0:08:41.43,Default,,0,0,0,,Білесіз бе! Осы уақытқа дейін сіздің Банкайыңыз жанымда болды.
Dialogue: 0,0:08:41.52,0:08:43.81,Default,,0,0,0,,Банкай мен иесі қосылған.
Dialogue: 0,0:08:47.15,0:08:48.48,Default,,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:08:48.56,0:08:50.48,Default,,0,0,0,,Банкай бұзылса да жарайды.
Dialogue: 0,0:08:50.57,0:08:53.28,Default,,0,0,0,,Сіз, иесі, ондай емессіз...
Dialogue: 0,0:08:54.70,0:08:56.78,Default,,0,0,0,,Жоқ... ол қандай тесік?
Dialogue: 0,0:08:56.86,0:09:00.24,Default,,0,0,0,,Менің денем енді раковинаға айналды
Dialogue: 0,0:09:00.33,0:09:03.12,Default,,0,0,0,,Сізді жеңетін кеме ғана.
Dialogue: 0,0:09:03.62,0:09:06.04,Default,,0,0,0,,Біздің ізгілендірудің құпия өнері қандай?
Dialogue: 0,0:09:06.12,0:09:10.67,Default,,0,0,0,,Жүрегіңді құрбан ету арқылы өлместікке қалай қол жеткізуге болады.
Dialogue: 0,0:09:11.17,0:09:13.46,Default,,0,0,0,,Адам кейпіндегі Учиха
Dialogue: 0,0:09:13.97,0:09:16.09,Default,,0,0,0,,Мен ешқашан соңғы демімді алмаймын.
Dialogue: 0,0:09:16.18,0:09:17.59,Default,,0,0,0,,Ха…
Dialogue: 0,0:09:22.89,0:09:25.23,Default,,0,0,0,,Бұл не? Сіз өміріңізді лақтырып жатырсыз ба?
Dialogue: 0,0:09:25.31,0:09:27.94,Default,,0,0,0,,Жеңілсем өлемін... Өлемін.
Dialogue: 0,0:09:28.02,0:09:30.48,Default,,0,0,0,,Ұнамағандықтан ұрысып жатырсың!
Dialogue: 0,0:09:30.57,0:09:33.94,Default,,0,0,0,,Егер сіз шайқаста өз өміріңізді құрбан етсеңіз, жеңіске жетудің мәні жоқ!
Dialogue: 0,0:09:34.53,0:09:36.20,Default,,0,0,0,,Оны лақтырмаңыз
Dialogue: 0,0:09:36.70,0:09:38.28,Default,,0,0,0,,Жаңа ғана баға қойдым.
Dialogue: 0,0:09:38.78,0:09:42.41,Default,,0,0,0,,Генрюсай-доно шайқаста өз өмірін қатерге тігеді
Dialogue: 0,0:09:42.49,0:09:45.66,Default,,0,0,0,,Мен өз өмірімді қатерге тігудің себебі бар ма?
Dialogue: 0,0:09:46.33,0:09:48.75,Default,,0,0,0,,Осы шайқасқа кіріспес бұрын...
Dialogue: 0,0:09:52.55,0:09:55.42,Default,,0,0,0,,Мен өмірімді баяғыда артқа тастадым!
Dialogue: 0,0:09:58.93,0:10:00.34,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:10:05.68,0:10:08.48,Default,,0,0,0,,Саджин немесе Саджин
Dialogue: 0,0:10:08.56,0:10:13.57,Default,,0,0,0,,Жарайсыңдар, сондықтан менің отбасым
Dialogue: 0,0:10:14.07,0:10:17.86,Default,,0,0,0,,Мен қазір сенмін.
Dialogue: 0,0:10:18.53,0:10:22.66,Default,,0,0,0,,Мен сені мақтан тұтамын, Саджин.
Dialogue: 0,0:10:23.70,0:10:26.50,Default,,0,0,0,,Бұл өтірік... Бомба жарылмайды.
Dialogue: 0,0:10:26.58,0:10:30.75,Default,,0,0,0,,Ол жарылғаннан тезірек менің ішімде бұралып қалды.
Dialogue: 0,0:10:31.38,0:10:32.38,Default,,0,0,0,,Осы сияқты...
Dialogue: 0,0:10:33.34,0:10:34.96,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:11:05.53,0:11:06.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:19.88,0:11:21.01,Default,,0,0,0,,Уф!
Dialogue: 0,0:11:21.09,0:11:24.89,Default,,0,0,0,,Хаа һаа һаа һаа…
Dialogue: 0,0:11:25.55,0:11:26.85,Default,,0,0,0,,әріптес сарбаздардың жүрегіне үрей ұялататындай болды
Dialogue: 0,0:11:26.93,0:11:31.27,Default,,0,0,0,,Енді маған аздап берші... Адамгершіліктің құпия өнері.
Dialogue: 0,0:11:31.81,0:11:33.65,Default,,0,0,0,,Менің жүрегім!
Dialogue: 0,0:11:36.23,0:11:39.78,Default,,0,0,0,,Біз олардың қамалына жетуіміз керек.
Dialogue: 0,0:11:40.49,0:11:41.78,Default,,0,0,0,,Юхбах...
Dialogue: 0,0:11:43.49,0:11:45.87,Default,,0,0,0,,Біз оны жеңуіміз керек!
Dialogue: 0,0:11:49.70,0:11:53.96,Default,,0,0,0,,Жақсы... Жақсы, Сажинья
Dialogue: 0,0:11:54.79,0:11:59.42,Default,,0,0,0,,Сіз білесіз бе? Сол жағы
Dialogue: 0,0:11:59.92,0:12:05.34,Default,,0,0,0,,Сенің бұл сезімің – кек.
Dialogue: 0,0:12:06.26,0:12:08.97,Default,,0,0,0,,Сен досыңа көп уағыз айттың.
Dialogue: 0,0:12:09.06,0:12:12.94,Default,,0,0,0,,Бұл менің өмірімді құрбан еткенім үшін кек болды.
Dialogue: 0,0:12:13.94,0:12:14.65,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:12:16.48,0:12:18.57,Default,,0,0,0,,Картоп Бұл жақсы.
Dialogue: 0,0:12:19.32,0:12:23.95,Default,,0,0,0,,Кек – менің отбасымның шынайы түрі
Dialogue: 0,0:12:24.74,0:12:28.78,Default,,0,0,0,,Сіз де ақыры оралдыңыз.
Dialogue: 0,0:12:29.29,0:12:30.37,Default,,0,0,0,,Мен антидотты қолға түсірдім.
Dialogue: 0,0:12:30.95,0:12:33.37,Default,,0,0,0,,Менің отбасыма
Dialogue: 0,0:12:33.46,0:12:35.33,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:12:36.42,0:12:38.84,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:12:39.34,0:12:41.71,Default,,0,0,0,,Уф!Уф...
Dialogue: 0,0:12:43.01,0:12:45.47,Default,,0,0,0,,Түсіндім, бұл...
Dialogue: 0,0:12:48.30,0:12:50.18,Default,,0,0,0,,Бұл баға ма?
Dialogue: 0,0:12:51.47,0:12:54.48,Default,,0,0,0,,Дұрыс айтасың Саджин.
Dialogue: 0,0:12:54.56,0:12:57.86,Default,,0,0,0,,Сіздің адам ретіндегі өміріңіз жақын арада аяқталады.
Dialogue: 0,0:12:58.65,0:13:01.36,Default,,0,0,0,,Кекшіл аңға түсу
Dialogue: 0,0:13:01.44,0:13:05.86,Default,,0,0,0,,Соңына дейін ашуға болмайды, қарғауға болмайды.
Dialogue: 0,0:13:05.95,0:13:09.37,Default,,0,0,0,,Кекпен жазыңыз.
Dialogue: 0,0:13:09.45,0:13:12.66,Default,,0,0,0,,Сол қара ренішті сусындату
Dialogue: 0,0:13:12.75,0:13:15.62,Default,,0,0,0,,Мен тағы да созамын
Dialogue: 0,0:13:16.33,0:13:20.13,Default,,0,0,0,,Саджин және сүйкімді Саджин
Dialogue: 0,0:13:20.71,0:13:24.22,Default,,0,0,0,,Мен үшін рахмет
Dialogue: 0,0:13:24.72,0:13:28.34,Default,,0,0,0,,Мен үнсіз аңға айналғанша
Dialogue: 0,0:13:28.43,0:13:30.55,Default,,0,0,0,,Мен үшін...
Dialogue: 0,0:13:31.14,0:13:32.97,Default,,0,0,0,,(5-сынып оқушысы 5) Сүтсіз. (4-сынып оқушысы 4) Жырт.
Dialogue: 0,0:13:40.11,0:13:43.48,Default,,0,0,0,,Кек алу үшін жаныңды сатқаның үшін
Dialogue: 0,0:13:43.98,0:13:45.86,Default,,0,0,0,,Бұл сыйлық па?
Dialogue: 0,0:13:46.45,0:13:48.78,Default,,0,0,0,,Готей атын алып жүру
Dialogue: 0,0:13:48.86,0:13:52.28,Default,,0,0,0,,Өз кек алу үшін жаныңды сатқанның сыйы ма?
Dialogue: 0,0:13:53.29,0:13:55.29,Default,,0,0,0,,Төсенге айтқан сөзім
Dialogue: 0,0:13:55.37,0:13:59.79,Default,,0,0,0,,Бұл өз-өзіме ескерту жасамағаным үшін жаза ма?
Dialogue: 0,0:14:00.96,0:14:02.38,Default,,0,0,0,,Мен...
Dialogue: 0,0:14:14.47,0:14:16.43,Default,,0,0,0,,Кеттік, капитан.
Dialogue: 0,0:14:16.52,0:14:19.48,Default,,0,0,0,,Капитан қателеспейді.
Dialogue: 0,0:14:19.56,0:14:21.94,Default,,0,0,0,,Сіз қателесе алмайсыз.
Dialogue: 0,0:14:23.32,0:14:25.15,Default,,0,0,0,,Капитанмен күресейік
Dialogue: 0,0:14:25.65,0:14:29.03,Default,,0,0,0,,Юхабахтың бейбақын жеңейік.
Dialogue: 0,0:14:29.11,0:14:32.20,Default,,0,0,0,,Генрюсай Ямамото үшін
Dialogue: 0,0:14:42.54,0:14:45.05,Default,,0,0,0,,) Ха ха ха…
Dialogue: 0,0:14:45.13,0:14:46.09,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:49.80,0:14:50.55,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:54.18,0:14:57.93,Default,,0,0,0,,) Зақымдану деңгейі 45%-ға дейін жөнделді
Dialogue: 0,0:15:09.57,0:15:10.95,Default,,0,0,0,,Қарғыс атсын
Dialogue: 0,0:15:11.03,0:15:15.16,Default,,0,0,0,,Мен Грим Реаперден жеңілгеніме сене алмаймын.
Dialogue: 0,0:15:15.66,0:15:19.33,Default,,0,0,0,,Жеңілген бестіктің біріншісі болу...
Dialogue: 0,0:15:20.21,0:15:21.67,Default,,0,0,0,,Мен кешіре алмаймын
Dialogue: 0,0:15:21.75,0:15:25.13,Default,,0,0,0,,Мен мұндай нәрсені ешқашан кешіре алмаймын.
Dialogue: 0,0:15:26.05,0:15:26.96,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:27.05,0:15:28.96,Default,,0,0,0,,Бейшара Бэмби
Dialogue: 0,0:15:29.92,0:15:31.47,Default,,0,0,0,,Мен саған көмектесемін
Dialogue: 0,0:15:31.55,0:15:33.97,Default,,0,0,0,,Бэмби болмаса, біз жалғыз болар едік.
Dialogue: 0,0:15:34.93,0:15:37.14,Default,,0,0,0,,Эй, жоқ... тоқтат.
Dialogue: 0,0:15:37.64,0:15:39.31,Default,,0,0,0,,Тоқта, Джижи...
Dialogue: 0,0:15:41.69,0:15:43.94,Default,,0,0,0,,Соғыс жағдайы біркелкі сияқты.
Dialogue: 0,0:15:44.02,0:15:46.44,Default,,0,0,0,,Бұл қарапайым талдау.
Dialogue: 0,0:15:46.52,0:15:48.61,Default,,0,0,0,,Бірақ біз келісетін сияқтымыз.
Dialogue: 0,0:15:48.69,0:15:50.36,Default,,0,0,0,,Мен де солай ойлаймын.
Dialogue: 0,0:15:50.44,0:15:51.36,Default,,0,0,0,,О
Dialogue: 0,0:15:51.86,0:15:54.62,Default,,0,0,0,,Әйтпесе, менің мұнда келуімнің мәні жоқ.
Dialogue: 0,0:15:54.70,0:15:59.66,Default,,0,0,0,,Менің рөлім екеуінің арасындағы тепе-теңдікті сақтау.
Dialogue: 0,0:16:00.16,0:16:00.66,Default,,0,0,0,,(Үкідің ұлуы)
Dialogue: 0,0:16:01.91,0:16:03.21,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:16:03.92,0:16:06.13,Default,,0,0,0,,Ол кенет орнынан қозғалды.
Dialogue: 0,0:16:06.21,0:16:09.30,Default,,0,0,0,,Айтпақшы, Квинси рухани балаларды ұрлай алады, солай ма?
Dialogue: 0,0:16:09.38,0:16:13.80,Default,,0,0,0,,Шлагбаумның рухтары бірте-бірте бұл жақтан алынып, жіңішкерілді.
Dialogue: 0,0:16:14.39,0:16:16.39,Default,,0,0,0,,Бұл күтілгеннен ұзағырақ уақыт алды
Dialogue: 0,0:16:16.89,0:16:18.56,Default,,0,0,0,,Бұл тамаша техника.
Dialogue: 0,0:16:18.64,0:16:20.22,Default,,0,0,0,,Өйткені
Dialogue: 0,0:16:20.31,0:16:22.85,Default,,0,0,0,,Абырой болғанымды айтайын.
Dialogue: 0,0:16:22.94,0:16:24.10,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:16:27.65,0:16:31.11,Default,,0,0,0,,Қабырғаны сүртуге көп уақыт кетсе.
Dialogue: 0,0:16:31.19,0:16:34.86,Default,,0,0,0,,Бұл біздің жағымызға жаңа қабырға тұрғызуға уақыт болғанын білдіреді.
Dialogue: 0,0:16:35.70,0:16:39.08,Default,,0,0,0,,Бұл қабырғаның біріншіден мүлдем басқа түрі.
Dialogue: 0,0:16:39.16,0:16:43.33,Default,,0,0,0,,Бұл қатты қабырға болмағандықтан, ол нәзік көрінеді ме?
Dialogue: 0,0:16:43.41,0:16:44.62,Default,,0,0,0,,О
Dialogue: 0,0:16:45.25,0:16:47.75,Default,,0,0,0,,Бірақ ашық нәзік болу дегенді білдіреді
Dialogue: 0,0:16:47.84,0:16:50.50,Default,,0,0,0,,Сол нәзіктікте тұзақ бар.
Dialogue: 0,0:16:52.46,0:16:53.88,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:16:54.59,0:16:56.97,Default,,0,0,0,,Қатал шараларды қолданыңыз
Dialogue: 0,0:17:07.10,0:17:08.15,Default,,0,0,0,,Уақыт?
Dialogue: 0,0:17:08.81,0:17:11.19,Default,,0,0,0,,Мәртебелі күтіп тұр. Кешіріңіз.
Dialogue: 0,0:17:11.28,0:17:13.90,Default,,0,0,0,,Эй, сен осында келдің және үйге барасың ба?
Dialogue: 0,0:17:15.07,0:17:17.16,Default,,0,0,0,,Оған алғыс айту керек.
Dialogue: 0,0:17:17.70,0:17:19.62,Default,,0,0,0,,Қашан қайтасыз?
Dialogue: 0,0:17:20.49,0:17:22.49,Default,,0,0,0,,Мен өлген бойда,
Dialogue: 0,0:17:23.12,0:17:24.41,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:17:24.91,0:17:28.00,Default,,0,0,0,,Енді мен жаңа шай қайнатып, күтемін.
Dialogue: 0,0:17:32.30,0:17:35.13,Default,,0,0,0,,Бұл бұрын таңғажайып жарылыс болды.
Dialogue: 0,0:17:35.22,0:17:37.01,Default,,0,0,0,,Екі Рейацу жоғалып кетті.
Dialogue: 0,0:17:37.51,0:17:40.14,Default,,0,0,0,,Бірі – жау, екіншісі –...
Dialogue: 0,0:17:40.89,0:17:42.47,Default,,0,0,0,,Капитан Комамура.
Dialogue: 0,0:17:42.56,0:17:43.06,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:17:43.14,0:17:45.02,Default,,0,0,0,,Мырза!
Dialogue: 0,0:17:45.10,0:17:47.27,Default,,0,0,0,,Екінші айналым, оян.
Dialogue: 0,0:17:48.02,0:17:49.02,Default,,0,0,0,,Не? Сол бала
Dialogue: 0,0:17:49.61,0:17:51.57,Default,,0,0,0,,Жоқ Кішкентай қария ма?
Dialogue: 0,0:17:51.65,0:17:53.40,Default,,0,0,0,,Қане, ол жігіт енді төбелесе алмайды...
Dialogue: 0,0:17:53.48,0:17:56.74,Default,,0,0,0,,Мырза!
Dialogue: 0,0:17:56.82,0:17:57.61,Default,,0,0,0,,Не!
Dialogue: 0,0:17:58.53,0:18:00.07,Default,,0,0,0,,Жарайсың Джеймс!
Dialogue: 0,0:18:00.87,0:18:01.58,Default,,0,0,0,,Нуфу
Dialogue: 0,0:18:01.66,0:18:02.95,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:18:03.04,0:18:04.41,Default,,0,0,0,,Вахаха!
Dialogue: 0,0:18:04.50,0:18:07.37,Default,,0,0,0,,Супер жұлдыздардың екінші туры бар
Dialogue: 0,0:18:07.46,0:18:09.12,Default,,0,0,0,,Сіз бұл жеке матч деп айттыңыз!
Dialogue: 0,0:18:09.21,0:18:10.83,Default,,0,0,0,,Гонг, Джеймс!
Dialogue: 0,0:18:10.92,0:18:12.71,Default,,0,0,0,,Сәлем мырза!
Dialogue: 0,0:18:13.80,0:18:15.21,Default,,0,0,0,,Әзіл!
Dialogue: 0,0:18:15.71,0:18:18.47,Default,,0,0,0,,Менің жолдасым әрқашан байсалды!
Dialogue: 0,0:18:18.55,0:18:19.89,Default,,0,0,0,,Аһ!
Dialogue: 0,0:18:19.97,0:18:20.51,Default,,0,0,0,,О!
Dialogue: 0,0:18:21.76,0:18:22.26,Default,,0,0,0,,Мамма миа, мен бара жатырмын
Dialogue: 0,0:18:22.35,0:18:24.22,Default,,0,0,0,,Бұл не өзі?!
Dialogue: 0,0:18:28.89,0:18:32.82,Default,,0,0,0,,Әй, бір екі үш!
Dialogue: 0,0:18:34.57,0:18:35.36,Default,,0,0,0,,Нуху!
Dialogue: 0,0:18:38.57,0:18:39.99,Default,,0,0,0,,Сәлем Джеймс
Dialogue: 0,0:18:40.07,0:18:40.82,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:18:40.91,0:18:44.12,Default,,0,0,0,,Осымен бекітілген капитан атағы дерлік расталды.
Dialogue: 0,0:18:44.20,0:18:46.25,Default,,0,0,0,,Бірақ жеңгенімізге қарамастан
Dialogue: 0,0:18:46.33,0:18:49.16,Default,,0,0,0,,Галереяның жоқтығы өкінішті, Джеймс.
Dialogue: 0,0:18:49.25,0:18:51.88,Default,,0,0,0,,Сәлем! Дұрыс айтасыз, мырза.
Dialogue: 0,0:18:55.46,0:18:58.63,Default,,0,0,0,,Иә? Сол жарық...
Dialogue: 0,0:18:58.72,0:19:00.34,Default,,0,0,0,,Жаңа жау!
Dialogue: 0,0:19:00.43,0:19:04.64,Default,,0,0,0,,Мен ол жаққа бару керек пе, жоқ па білмеймін.
Dialogue: 0,0:19:04.72,0:19:06.01,Default,,0,0,0,,Сіз қалай ойлайсыз? Джеймс
Dialogue: 0,0:19:06.10,0:19:06.64,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:19:06.72,0:19:09.64,Default,,0,0,0,,Жылтырап, көзге түсетін құлағандарды тазалап болған соң
Dialogue: 0,0:19:09.73,0:19:10.85,Default,,0,0,0,,Бұл байқалады
Dialogue: 0,0:19:10.94,0:19:14.11,Default,,0,0,0,,Кеттік! Артында қалма, Джеймс.
Dialogue: 0,0:19:14.19,0:19:14.69,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:19:16.73,0:19:17.69,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:19:19.61,0:19:20.95,Default,,0,0,0,,Күтіңіз...
Dialogue: 0,0:19:21.03,0:19:25.24,Default,,0,0,0,,Сіз бізді үш есеппен ғана жеңді деп ойлайсыз ба?
Dialogue: 0,0:19:27.83,0:19:29.75,Default,,0,0,0,,Бұл менің ниетім.
Dialogue: 0,0:19:31.71,0:19:33.42,Default,,0,0,0,,Мамма миа, мен бара жатырмын
Dialogue: 0,0:19:36.09,0:19:37.00,Default,,0,0,0,,(Үкідің ұлуы)
Dialogue: 0,0:19:37.80,0:19:38.38,Default,,0,0,0,,Чи…
Dialogue: 0,0:19:38.88,0:19:42.76,Default,,0,0,0,,Жаттығуымнан еш нәтиже шықпай, мен оңай жеңілдім.
Dialogue: 0,0:19:42.84,0:19:45.01,Default,,0,0,0,,Өкінішті вице-капитан.
Dialogue: 0,0:19:45.10,0:19:47.01,Default,,0,0,0,,Сіз осы жігіттердің бірісіз бе?
Dialogue: 0,0:19:47.10,0:19:50.31,Default,,0,0,0,,9-дивизия капитаны Мугурума Кенниши
Dialogue: 0,0:19:50.81,0:19:53.02,Default,,0,0,0,,Мына жақтағы жеңсіз капитан.
Dialogue: 0,0:19:53.10,0:19:55.73,Default,,0,0,0,,Капитан, бұл тамаша!
Dialogue: 0,0:19:55.81,0:19:58.98,Default,,0,0,0,,Әдетте мен ең жақсы қарсылас болар едім, бірақ, өкінішке орай, қазір мен
Dialogue: 0,0:19:59.07,0:20:02.82,Default,,0,0,0,,Ең көзге түсетін құлаған затты іздеуге бағыттау.
Dialogue: 0,0:20:02.91,0:20:05.45,Default,,0,0,0,,Жарайды, олай айтпа.
Dialogue: 0,0:20:06.12,0:20:08.24,Default,,0,0,0,,Сіз екі капитанға қарсы тұрсыз, солай ма?
Dialogue: 0,0:20:08.33,0:20:11.71,Default,,0,0,0,,Егер сіз ерекшеленгіңіз келсе, менің ойымша, сіз жақсы сәйкессіз.
Dialogue: 0,0:20:12.33,0:20:13.54,Default,,0,0,0,,Хо…
Dialogue: 0,0:20:14.46,0:20:15.38,Default,,0,0,0,,О!
Dialogue: 0,0:20:18.46,0:20:20.84,Default,,0,0,0,,Олай болса, маған қоңырау шалыңыз!
Dialogue: 0,0:20:21.42,0:20:24.72,Default,,0,0,0,,Уайымдама, мен сенің уақытыңды алмаймын.
Dialogue: 0,0:20:24.80,0:20:25.89,Default,,0,0,0,,Хун
Dialogue: 0,0:20:27.05,0:20:30.56,Default,,0,0,0,,Нуфуфуфуфуфу
Dialogue: 0,0:20:31.85,0:20:33.85,Default,,0,0,0,,♪～
Dialogue: 0,0:21:57.06,0:21:59.06,Default,,0,0,0,,～♪
Dialogue: 0,0:22:01.02,0:22:06.19,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:22:06.70,0:22:07.95,Default,,0,0,0,,немесе оны түпнұсқасы деп те айтуға болады.
Dialogue: 0,0:22:10.37,0:22:15.12,Default,,0,0,0,,Сол салмақты мен қорғауға тырысамын.
Dialogue: 0,0:22:16.25,0:22:18.67,Default,,0,0,0,,Не көрсең, соны көресің
Dialogue: 0,0:22:19.17,0:22:24.67,Default,,0,0,0,,Барлық заттар мәңгілік, мәңгілік жады және түсіндіру.
Dialogue: 0,0:22:24.76,0:22:27.92,Default,,0,0,0,,яғни патшаның билігі
Dialogue: 0,0:22:37.68,0:22:38.81,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:41.19,0:22:45.48,Default,,0,0,0,,Оған құйылған күштің шамасына төтеп бере алатын ыдыс па?
Dialogue: 0,0:22:45.57,0:22:48.15,Default,,0,0,0,,Сынуға болатын тостаған
Dialogue: 0,0:22:48.82,0:22:50.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:22:50.53,0:22:54.91,Default,,0,0,0,,Ааа!
Dialogue: 0,0:22:57.75,0:23:02.54,Default,,0,0,0,,(Ичигоның айқайы)
Dialogue: 0,0:23:04.96,0:23:08.09,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:23:13.30,0:23:18.18,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:23:32.86,0:23:35.53,Default,,0,0,0,,Әрі қарай не істеуім керек?
Dialogue: 0,0:23:40.04,0:23:43.50,Default,,0,0,0,,Аспанда жаңғырық жалған дыбыс
Dialogue: 0,0:23:44.25,0:23:48.34,Default,,0,0,0,,Жүрегімді тебірентетін әуен
Dialogue: 0,0:23:49.84,0:23:55.84,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
