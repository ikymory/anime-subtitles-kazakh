Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:09.38,0:00:09.88,Default,,0,0,0,,Хмф!
Dialogue: 0,0:00:09.96,0:00:11.88,Default,,0,0,0,,Гррр…
Dialogue: 0,0:00:13.38,0:00:14.38,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:00:21.14,0:00:22.14,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:00:22.23,0:00:24.81,Default,,0,0,0,,Оттық саусақ 2!
Dialogue: 0,0:00:32.49,0:00:33.36,Default,,0,0,0,,Ал ең бастысы, Иносукэ, өзің қалайсың?
Dialogue: 0,0:00:39.12,0:00:40.08,Default,,0,0,0,,Чи…
Dialogue: 0,0:00:44.96,0:00:46.50,Default,,0,0,0,,Бітті ме?
Dialogue: 0,0:00:47.50,0:00:49.75,Default,,0,0,0,,) Осы жерде тоқта, Базби.
Dialogue: 0,0:00:51.00,0:00:52.26,Default,,0,0,0,,Мен сізге соңғы соққыны беремін
Dialogue: 0,0:00:52.76,0:00:54.72,Default,,0,0,0,,Бұл басып алу ма? Сото
Dialogue: 0,0:00:55.22,0:00:57.64,Default,,0,0,0,,Мәртебелі мырза сізді жазалайды.
Dialogue: 0,0:00:57.72,0:01:01.35,Default,,0,0,0,,«Капитанды ұрлаған Банкаймен өлтір» дегенді білдіреді
Dialogue: 0,0:01:01.43,0:01:03.39,Default,,0,0,0,,Бұл Мәртебелі шешім.
Dialogue: 0,0:01:03.48,0:01:04.64,Default,,0,0,0,,Чи…
Dialogue: 0,0:01:09.73,0:01:11.36,Default,,0,0,0,,Мацумото!
Dialogue: 0,0:01:12.48,0:01:14.28,Default,,0,0,0,,Ол маңызды вице-капитан емес пе?
Dialogue: 0,0:01:14.78,0:01:17.24,Default,,0,0,0,,Олай болса қатар өлуіміз керек.
Dialogue: 0,0:01:18.11,0:01:22.24,Default,,0,0,0,,Қасиетті Крест рыцарлары (Sternritter) «Мен» Көк Темір қаласы
Dialogue: 0,0:01:22.91,0:01:25.58,Default,,0,0,0,,Бірге өмір сүргендер бірге өледі.
Dialogue: 0,0:01:25.66,0:01:27.79,Default,,0,0,0,,Бұл менің стилім
Dialogue: 0,0:01:29.63,0:01:30.75,Default,,0,0,0,,Банкай
Dialogue: 0,0:01:35.80,0:01:37.76,Default,,0,0,0,,Дайгурэн Хёринмару
Dialogue: 0,0:01:39.26,0:01:42.22,Default,,0,0,0,,Мен оны бірінші рет көріп тұрған шығармын.
Dialogue: 0,0:01:42.93,0:01:44.47,Default,,0,0,0,,Әдемі Банкай
Dialogue: 0,0:01:45.18,0:01:48.10,Default,,0,0,0,,Бұл да сізбен бірге өмір сүрген нәрсе.
Dialogue: 0,0:01:49.48,0:01:52.15,Default,,0,0,0,,Сізден тек осы Банкайды тартып алады.
Dialogue: 0,0:01:52.65,0:01:53.82,Default,,0,0,0,,Өлгеннен кейін де
Dialogue: 0,0:01:53.90,0:01:55.69,Default,,0,0,0,,Маған аман қалуға рұқсат етіңіз
Dialogue: 0,0:01:56.69,0:01:59.24,Default,,0,0,0,,Мен шынымен кешірім сұраймын.
Dialogue: 0,0:02:00.24,0:02:01.66,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:02:01.74,0:02:02.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:02.87,0:02:04.70,Default,,0,0,0,,А, жалғанған, жалғанған
Dialogue: 0,0:02:04.79,0:02:05.58,Default,,0,0,0,,Құрметті сізге...
Dialogue: 0,0:02:05.66,0:02:08.54,Default,,0,0,0,,Сәлем, бұл мен, Урахара.
Dialogue: 0,0:02:09.33,0:02:12.25,Default,,0,0,0,,Банкайды қайтару әдісі аяқталды.
Dialogue: 0,0:02:12.34,0:02:13.17,Default,,0,0,0,,Ха!
Dialogue: 0,0:02:18.51,0:02:20.51,Default,,0,0,0,,♪～
Dialogue: 0,0:03:45.51,0:03:47.51,Default,,0,0,0,,～♪
Dialogue: 0,0:03:49.56,0:03:50.93,Default,,0,0,0,,Не?
Dialogue: 0,0:03:51.02,0:03:54.56,Default,,0,0,0,,«Банкайды қалпына келтіру» деп естідім бе?
Dialogue: 0,0:03:54.65,0:03:56.56,Default,,0,0,0,,Иә, дәл
Dialogue: 0,0:03:56.65,0:04:01.74,Default,,0,0,0,,Енді мен жойылу шеберлері (Квинси) принципінің әлсіздігін түсіндірдім,
Dialogue: 0,0:04:01.82,0:04:04.82,Default,,0,0,0,,Оны Манджи шабуылын тоқтату үшін пайдаланыңыз.
Dialogue: 0,0:04:04.91,0:04:08.58,Default,,0,0,0,,Сонымен қатар, сіз ұрланған Банкайды қалпына келтіре аласыз.
Dialogue: 0,0:04:08.66,0:04:09.91,Default,,0,0,0,,Бұл дегеніміз
Dialogue: 0,0:04:09.99,0:04:12.29,Default,,0,0,0,,Керемет... Кисуке Урахара күткендей
Dialogue: 0,0:04:12.37,0:04:13.71,Default,,0,0,0,,Идиот! Сіз... (Офицер) Ах!
Dialogue: 0,0:04:13.79,0:04:17.96,Default,,0,0,0,,Көремін, түсінемін, бұл тамаша зерттеу нәтижесі.
Dialogue: 0,0:04:18.04,0:04:21.59,Default,,0,0,0,,Жарайды, менде солай болды.
Dialogue: 0,0:04:22.09,0:04:24.68,Default,,0,0,0,,Бірақ бұл басқа әңгіме.
Dialogue: 0,0:04:24.76,0:04:25.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:25.34,0:04:29.39,Default,,0,0,0,,Менің киімдеріме рұқсатсыз байланыс құралын бекіту қылмысы болып табылады
Dialogue: 0,0:04:29.47,0:04:30.81,Default,,0,0,0,,Өлуге тұрарлық
Dialogue: 0,0:04:30.89,0:04:31.98,Default,,0,0,0,,Иә? Бір минут күте тұрыңыз
Dialogue: 0,0:04:32.06,0:04:33.77,Default,,0,0,0,,Байланысты үзгіңіз келе ме?
Dialogue: 0,0:04:33.85,0:04:34.60,Default,,0,0,0,,Спидвегон, мен мұнда келдім —
Dialogue: 0,0:04:34.69,0:04:36.27,Default,,0,0,0,,Бұл өтірік емес пе? Сәл күте тұрыңыз!
Dialogue: 0,0:04:36.35,0:04:37.15,Default,,0,0,0,,Кеспеңіз...
Dialogue: 0,0:04:37.23,0:04:38.86,Default,,0,0,0,,На-чат
Dialogue: 0,0:04:38.94,0:04:40.57,Default,,0,0,0,,Уау! Адам шықты
Dialogue: 0,0:04:40.65,0:04:42.65,Default,,0,0,0,,А, мен сені таң қалдырдым ба?
Dialogue: 0,0:04:42.74,0:04:44.07,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:04:44.15,0:04:47.12,Default,,0,0,0,,Жарықтың ішінен звондап жатырмын.
Dialogue: 0,0:04:47.62,0:04:51.74,Default,,0,0,0,,Сондықтан мен капитан Нирукиден ынтымақтастық сұрағым келеді.
Dialogue: 0,0:04:51.83,0:04:54.87,Default,,0,0,0,,Хмф, көмектесу үшін ештеңе істей алмаймыз.
Dialogue: 0,0:04:55.37,0:04:57.96,Default,,0,0,0,,Көріп отырғаныңыздай, бұл Квинсилердің айласы.
Dialogue: 0,0:04:58.04,0:05:00.88,Default,,0,0,0,,Техникалық даму бюросы бейтараптандырылды
Dialogue: 0,0:05:00.96,0:05:03.84,Default,,0,0,0,,Жоқ, жоқ, сен не айтып тұрсың?
Dialogue: 0,0:05:03.92,0:05:05.80,Default,,0,0,0,,Бұл солай емес пе?
Dialogue: 0,0:05:05.88,0:05:08.68,Default,,0,0,0,,Квинсилердің көлеңкелерінің ерекшеліктерін қалай көруге болады?
Dialogue: 0,0:05:08.76,0:05:11.43,Default,,0,0,0,,Капитан Нирука күткендей
Dialogue: 0,0:05:11.51,0:05:14.27,Default,,0,0,0,,Маған көмектесе аласыз ба?
Dialogue: 0,0:05:15.94,0:05:16.77,Default,,0,0,0,,Адамзат тағы да Титанның шапқыншылығына жол берді
Dialogue: 0,0:05:23.28,0:05:24.53,Default,,0,0,0,,Барлық капитандар Вице-капитандар
Dialogue: 0,0:05:24.61,0:05:25.90,Default,,0,0,0,,Орын координаталарын анықтаңыз!
Dialogue: 0,0:05:25.99,0:05:26.70,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:26.78,0:05:29.16,Default,,0,0,0,,Қалған барлық өзгертілген жәндіктерді жіберіңіз!
Dialogue: 0,0:05:29.24,0:05:33.54,Default,,0,0,0,,Квинсидің механикалық заттарын өзгертілген жәндіктермен өзгерту арқылы қолданыңыз.
Dialogue: 0,0:05:34.04,0:05:36.66,Default,,0,0,0,,Осы бөлмеде жүйеге қосылуға мүмкіндік беріңіз!
Dialogue: 0,0:05:37.46,0:05:38.50,Default,,0,0,0,,(Изуку) Мен үшін ұпайлар аса маңызды емес. (Оқушы) Жоғары ондықтағы біреу…
Dialogue: 0,0:05:38.58,0:05:40.54,Default,,0,0,0,,Жоқ, қосылу мүмкін емес!
Dialogue: 0,0:05:40.63,0:05:43.30,Default,,0,0,0,,Сіз мұны бұрын ешқашан жасамағандықтан жасай алмайтыныңыз табиғи нәрсе.
Dialogue: 0,0:05:43.38,0:05:44.55,Default,,0,0,0,,Оны алғанша көріңіз!
Dialogue: 0,0:05:44.63,0:05:45.30,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:46.42,0:05:48.30,Default,,0,0,0,,Контрасты препарат
Dialogue: 0,0:05:49.14,0:05:50.85,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:50.93,0:05:51.80,Default,,0,0,0,,Иә
Dialogue: 0,0:05:51.89,0:05:55.43,Default,,0,0,0,,Енді сіз Манджи Кайтакуды толығымен тоқтата аласыз.
Dialogue: 0,0:05:55.93,0:05:59.90,Default,,0,0,0,,Мен капитандардың Банкай ұрланды деген хабарды естідім.
Dialogue: 0,0:05:59.98,0:06:02.40,Default,,0,0,0,,Иллюзия сферасында қалуды шешті
Dialogue: 0,0:06:03.11,0:06:04.78,Default,,0,0,0,,Ол Хуэко Мундо тілінде
Dialogue: 0,0:06:04.86,0:06:08.03,Default,,0,0,0,,Манджи Кайтакуды болдырмауға арналған кеңестер бар.
Dialogue: 0,0:06:08.11,0:06:09.82,Default,,0,0,0,,Себебі мен оны өз көзіммен көрдім
Dialogue: 0,0:06:10.62,0:06:11.37,Default,,0,0,0,,Триггер не болды?
Dialogue: 0,0:06:11.45,0:06:14.99,Default,,0,0,0,,Мен бос орынды сіңірген Кильге Опиге тап болған кезде болды.
Dialogue: 0,0:06:15.08,0:06:19.58,Default,,0,0,0,,Ол Шұңқырды сіңірген сәтте оның келбеті күрт құлдырады.
Dialogue: 0,0:06:19.67,0:06:22.67,Default,,0,0,0,,Күшті көтере алмайтындай сезіндім.
Dialogue: 0,0:06:23.17,0:06:25.63,Default,,0,0,0,,Капитан Нирука біледі,
Dialogue: 0,0:06:25.71,0:06:30.84,Default,,0,0,0,,Сынған қылыштың шығуы семсер түріндегі жан қуатын алады.
Dialogue: 0,0:06:30.93,0:06:34.22,Default,,0,0,0,,Оны босатыңыз және үлкен күшке ие болыңыз
Dialogue: 0,0:06:34.72,0:06:38.64,Default,,0,0,0,,Бұл Банқаймен дерлік бірдей деуге болатын қабілет.
Dialogue: 0,0:06:39.35,0:06:41.44,Default,,0,0,0,,Егер капитандардың Банкайын ұрлай алсаңыз
Dialogue: 0,0:06:41.52,0:06:44.94,Default,,0,0,0,,Арранкардың қайта тірілуін де ұрлай алуыңыз керек.
Dialogue: 0,0:06:45.44,0:06:48.57,Default,,0,0,0,,Алайда, Арранкарлардың қайта тірілуі
Dialogue: 0,0:06:48.65,0:06:51.86,Default,,0,0,0,,Ешкім тоналмаған.
Dialogue: 0,0:06:52.57,0:06:55.99,Default,,0,0,0,,Бұл Квинсиді Арранкарға қызықтырмағаны емес.
Dialogue: 0,0:06:56.08,0:06:59.00,Default,,0,0,0,,Іс жүзінде олар бірнеше Арранкарды басып алды.
Dialogue: 0,0:06:59.08,0:07:01.17,Default,,0,0,0,,Оны солдат ретінде қайтарып жатыр.
Dialogue: 0,0:07:01.67,0:07:04.38,Default,,0,0,0,,Сонда да мен Қайта тірілуді алып тастамаймын.
Dialogue: 0,0:07:05.38,0:07:07.55,Default,,0,0,0,,Екі мүмкін себеп бар.
Dialogue: 0,0:07:07.63,0:07:10.05,Default,,0,0,0,,«Релексияны жоюға болмайды»?
Dialogue: 0,0:07:10.13,0:07:13.93,Default,,0,0,0,,Әлде «оны алып кету олар үшін кемшілік бола ма»?
Dialogue: 0,0:07:14.01,0:07:14.89,Default,,0,0,0,,Иә
Dialogue: 0,0:07:15.39,0:07:17.64,Default,,0,0,0,,Шұңқырларды зерттеуден
Dialogue: 0,0:07:17.72,0:07:21.35,Default,,0,0,0,,Неліктен сіз Банкайды ұрлай аласыз, бірақ Қайта тірілмейсіз
Dialogue: 0,0:07:21.44,0:07:23.31,Default,,0,0,0,,Менде ештеңе жоқ
Dialogue: 0,0:07:23.40,0:07:24.81,Default,,0,0,0,,Егер
Dialogue: 0,0:07:25.31,0:07:28.82,Default,,0,0,0,,Кемшіліктер бар деп ойлау орынды.
Dialogue: 0,0:07:31.57,0:07:33.74,Default,,0,0,0,,Сейрейтейдің іші мен сырты
Dialogue: 0,0:07:33.82,0:07:36.45,Default,,0,0,0,,Капитандардың Рейацу позициялары басып алынды!
Dialogue: 0,0:07:36.95,0:07:38.58,Default,,0,0,0,,Тенкокура дайын
Dialogue: 0,0:07:38.66,0:07:39.83,Default,,0,0,0,,Сіз сөйлесе аласыз!
Dialogue: 0,0:07:39.91,0:07:41.75,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:07:42.96,0:07:45.29,Default,,0,0,0,,Сәлеметсіз бе, Готей капитаны 13
Dialogue: 0,0:07:45.38,0:07:48.00,Default,,0,0,0,,Барлық вице-капитандарға сәлем.
Dialogue: 0,0:07:48.09,0:07:50.17,Default,,0,0,0,,Бұл Кисуке Урахара.
Dialogue: 0,0:07:50.26,0:07:50.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:51.38,0:07:53.51,Default,,0,0,0,,Бізге жаңадан келгендер және бізді жақсы танымайтындар үшін.
Dialogue: 0,0:07:53.59,0:07:55.72,Default,,0,0,0,,Мен сенемін...
Dialogue: 0,0:07:55.80,0:07:57.81,Default,,0,0,0,,Сенің бұл жерде болуың мүмкін емес, ақымақ.
Dialogue: 0,0:07:58.39,0:07:59.56,Default,,0,0,0,,Осы байланыспен бір уақытта
Dialogue: 0,0:07:59.64,0:08:02.77,Default,,0,0,0,,Мен бәріңе қара таблетканы жібердім.
Dialogue: 0,0:08:02.85,0:08:05.86,Default,,0,0,0,,Банкай бар адамдарға ғана әсер ететін дәрі
Dialogue: 0,0:08:05.94,0:08:07.44,Default,,0,0,0,,Контрасты препарат
Dialogue: 0,0:08:07.52,0:08:09.90,Default,,0,0,0,,Оның үстіне қолың болсын, аяғың болсын, қылышың болсын бәрібір.
Dialogue: 0,0:08:09.98,0:08:11.15,Default,,0,0,0,,түртіңіз
Dialogue: 0,0:08:11.24,0:08:12.90,Default,,0,0,0,,Байланыс арқылы сіңеді
Dialogue: 0,0:08:13.40,0:08:16.82,Default,,0,0,0,,Таблетка жанға терең енеді.
Dialogue: 0,0:08:17.70,0:08:19.66,Default,,0,0,0,,Квиндер туралы
Dialogue: 0,0:08:19.74,0:08:22.21,Default,,0,0,0,,Маған ұзақ уақыт бойы бір нәрсе жабысты.
Dialogue: 0,0:08:22.29,0:08:26.13,Default,,0,0,0,,Квинсилердің Холлоусқа деген толық дұшпандығы
Dialogue: 0,0:08:26.21,0:08:27.34,Default,,0,0,0,,Аңыз бойынша
Dialogue: 0,0:08:27.42,0:08:30.76,Default,,0,0,0,,Өкпеден туған нәрсе емес пе?
Dialogue: 0,0:08:30.84,0:08:33.67,Default,,0,0,0,,Дұшпандық дегеніміз не? Ол идеологиядағы айырмашылықтардан туған.
Dialogue: 0,0:08:34.18,0:08:39.06,Default,,0,0,0,,Ерік-жігері, идеологиясы жоқ адамды одан әрі жек көру мүмкін емес.
Dialogue: 0,0:08:40.18,0:08:41.64,Default,,0,0,0,,Осыншама дұшпандық
Dialogue: 0,0:08:41.72,0:08:45.48,Default,,0,0,0,,Біз мәңгілік ұстануымыздың бір себебі бар
Dialogue: 0,0:08:46.10,0:08:49.90,Default,,0,0,0,,Өмірге қауіп төндіретін заттарға қарсы.
Dialogue: 0,0:08:49.98,0:08:52.86,Default,,0,0,0,,Тек алғашқы қорқыныш
Dialogue: 0,0:08:52.94,0:08:54.70,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:54.78,0:09:00.12,Default,,0,0,0,,Квинсилер - қуыстарға қарсы антиденелері жоқ нәсіл.
Dialogue: 0,0:09:00.20,0:09:03.75,Default,,0,0,0,,Холлоу туралы бәрі Квинси үшін у.
Dialogue: 0,0:09:03.83,0:09:08.00,Default,,0,0,0,,Егер сіз қуыс эрозиясын алсаңыз, сіздің рухани күшіңіз әлсіреп қана қоймайды.
Dialogue: 0,0:09:08.08,0:09:11.80,Default,,0,0,0,,Ақырында жан күйреп, өлім болады.
Dialogue: 0,0:09:11.88,0:09:14.97,Default,,0,0,0,,Қасқыр сияқты, қуысқа айналатын жол да қалмады.
Dialogue: 0,0:09:15.47,0:09:20.01,Default,,0,0,0,,Сондықтан Квинсилер Шұңқырларды жоюы керек.
Dialogue: 0,0:09:20.60,0:09:24.06,Default,,0,0,0,,Басқаша айтқанда, ол Hollow қуатының аз мөлшерін сіңіреді.
Dialogue: 0,0:09:24.14,0:09:27.77,Default,,0,0,0,,Банкайды бір сәт ойпаңға айналдырсам.
Dialogue: 0,0:09:27.85,0:09:29.52,Default,,0,0,0,,Банкай да...
Dialogue: 0,0:09:30.48,0:09:33.28,Default,,0,0,0,,Квинсиге улы
Dialogue: 0,0:09:39.70,0:09:40.70,Default,,0,0,0,,Не?
Dialogue: 0,0:09:40.78,0:09:42.33,Default,,0,0,0,,Не болып жатыр...
Dialogue: 0,0:09:42.41,0:09:43.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:49.08,0:09:50.46,Default,,0,0,0,,Сен не істедің?
Dialogue: 0,0:09:50.96,0:09:51.96,Default,,0,0,0,,Саана
Dialogue: 0,0:09:52.46,0:09:55.97,Default,,0,0,0,,Хёринмару қайтқысы келетінін айтып тұрған жоқ па?
Dialogue: 0,0:10:07.89,0:10:12.27,Default,,0,0,0,,) Капитан жеңілгеннен кейін оның әлі де қарсы тұруға күші бар ма?
Dialogue: 0,0:10:12.36,0:10:16.03,Default,,0,0,0,,Өлім алдында деректер жинағым келді.
Dialogue: 0,0:10:16.11,0:10:18.36,Default,,0,0,0,,Капитан, мынау
Dialogue: 0,0:10:19.61,0:10:22.70,Default,,0,0,0,,Енді сіз Bankai қызметін пайдалана алуыңыз керек.
Dialogue: 0,0:10:22.78,0:10:25.16,Default,,0,0,0,,Мен түсініктемені толық түсінбедім...
Dialogue: 0,0:10:25.24,0:10:29.79,Default,,0,0,0,,Жақын бомбалаудан кейін дыбыс жинағыштың сезімталдығы автоматты түрде төмендейді.
Dialogue: 0,0:10:29.87,0:10:32.67,Default,,0,0,0,,Сіз қаттырақ сөйлей аласыз ба?
Dialogue: 0,0:10:34.05,0:10:36.30,Default,,0,0,0,,Байланысыңыз баяу ма?
Dialogue: 0,0:10:37.34,0:10:39.38,Default,,0,0,0,,Шұңқырлы Банкай...
Dialogue: 0,0:10:40.22,0:10:43.55,Default,,0,0,0,,Бұл сіздің денеңіздің функцияларына кедергі келтіреді.
Dialogue: 0,0:10:43.64,0:10:45.77,Default,,0,0,0,,Капитан! Мен мұны бұрын естідім ...
Dialogue: 0,0:10:45.85,0:10:50.60,Default,,0,0,0,,Ей, ақымақ... Әлгі тітіркендіргіш дауыстан оянбасқа амал жоқ.
Dialogue: 0,0:10:52.10,0:10:53.56,Default,,0,0,0,,Банкай!
Dialogue: 0,0:10:54.94,0:10:57.36,Default,,0,0,0,,Торғай арасының күркіреуі қоғамдық қамшы!
Dialogue: 0,0:10:57.94,0:10:58.74,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:10:58.82,0:11:00.70,Default,,0,0,0,,Фунбарео Омаэда
Dialogue: 0,0:11:01.20,0:11:02.07,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:02.16,0:11:05.08,Default,,0,0,0,,Банкай саған не үшін келді...
Dialogue: 0,0:11:05.16,0:11:06.62,Default,,0,0,0,,...
Dialogue: 0,0:11:07.12,0:11:10.12,Default,,0,0,0,,Өзіңіз көріңіз және талдаңыз!
Dialogue: 0,0:11:15.71,0:11:17.34,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:11:24.93,0:11:25.93,Default,,0,0,0,,Ха…
Dialogue: 0,0:11:26.01,0:11:28.14,Default,,0,0,0,,Мені ештеңе істеуге мәжбүрлеме
Dialogue: 0,0:11:28.64,0:11:31.69,Default,,0,0,0,,Өзіңізге шабуыл жасай алмайсыз.
Dialogue: 0,0:11:35.98,0:11:39.94,Default,,0,0,0,,Сіз Банкайға жүрегіңіз бар сияқты сөйлесуді тоқтата аласыз ба?
Dialogue: 0,0:11:44.95,0:11:47.16,Default,,0,0,0,,Пантеизм маған сәйкес келмейді
Dialogue: 0,0:11:50.58,0:11:51.29,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:11:51.37,0:11:54.33,Default,,0,0,0,,Банкайдың жүрегі жоқ
Dialogue: 0,0:11:54.42,0:11:56.50,Default,,0,0,0,,Сіз мұны шындап айтып тұрсыз ба?
Dialogue: 0,0:11:57.00,0:12:00.01,Default,,0,0,0,,А, солай сияқты.
Dialogue: 0,0:12:00.51,0:12:03.13,Default,,0,0,0,,Даусыңды естігелі біраз болды
Dialogue: 0,0:12:03.72,0:12:05.26,Default,,0,0,0,,Сізді қайта көргеніме қуаныштымын
Dialogue: 0,0:12:07.05,0:12:08.39,Default,,0,0,0,,Хёринмару
Dialogue: 0,0:12:10.56,0:12:12.10,Default,,0,0,0,,Қанаттар...
Dialogue: 0,0:12:12.18,0:12:14.73,Default,,0,0,0,,Егер сіз бетіңізді мазасыз деп ойласаңыз
Dialogue: 0,0:12:14.81,0:12:18.61,Default,,0,0,0,,Айтпақшы, Банкайды бір сәт ойпаңға айналдыруға болатынын айттыңыз.
Dialogue: 0,0:12:18.69,0:12:19.69,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:12:20.19,0:12:23.61,Default,,0,0,0,,Менің әзірше осылай жалғастырудан басқа амалым жоқ.
Dialogue: 0,0:12:23.70,0:12:25.82,Default,,0,0,0,,Жылан тырнағы!
Dialogue: 0,0:12:32.87,0:12:36.42,Default,,0,0,0,,Гүл кресті Хёринмарудың эмблемасы.
Dialogue: 0,0:12:37.67,0:12:40.80,Default,,0,0,0,,Кешіріңіз, мен оны бесбұрышқа айналдыра алмадым.
Dialogue: 0,0:12:41.92,0:12:44.09,Default,,0,0,0,,Таяқ жеме.
Dialogue: 0,0:12:44.88,0:12:46.34,Default,,0,0,0,,Дасина
Dialogue: 0,0:12:47.43,0:12:49.76,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:12:51.56,0:12:52.73,Default,,0,0,0,,(♪ «Twinkle, Twinkle, Little Star» әніне варияциялар»)
Dialogue: 0,0:12:54.31,0:12:56.94,Default,,0,0,0,,Күте тұрыңыз... Мацумото
Dialogue: 0,0:12:57.44,0:13:00.15,Default,,0,0,0,,Енді... көмек...
Dialogue: 0,0:13:29.97,0:13:33.89,Default,,0,0,0,,Банкай Шинигамидің қолына оралды ма?
Dialogue: 0,0:13:41.07,0:13:42.73,Default,,0,0,0,,Оу! Екінші оқ сәл қалды!
Dialogue: 0,0:13:43.23,0:13:47.91,Default,,0,0,0,,«Саны көп болса да, бағындыр» деп ойлағың келмей ме?
Dialogue: 0,0:13:50.24,0:13:52.87,Default,,0,0,0,,Жолдас, сенің бұлай істегеніңе ренжідім.
Dialogue: 0,0:13:53.37,0:13:56.91,Default,,0,0,0,,Достарыңыз болса, қолдануға болмайтын әдістер бар.
Dialogue: 0,0:13:57.00,0:14:00.13,Default,,0,0,0,,Сіздің парасаттылығыңыз да, осы жағдай да
Dialogue: 0,0:14:00.21,0:14:02.75,Default,,0,0,0,,Бәріміз бірге аударамыз.
Dialogue: 0,0:14:06.34,0:14:07.59,Default,,0,0,0,,Банкай
Dialogue: 0,0:14:09.01,0:14:12.72,Default,,0,0,0,,Гякусама зұлым сегіз қазына
Dialogue: 0,0:14:23.90,0:14:26.69,Default,,0,0,0,,Жаулар мен одақтастарды қабылдауды жеңу арқылы
Dialogue: 0,0:14:26.78,0:14:29.78,Default,,0,0,0,,Бір-біріне шабуыл жасауға рұқсат етемін, бірақ менің Банкайым...
Dialogue: 0,0:14:30.28,0:14:33.33,Default,,0,0,0,,Гякусама зұлым сегіз қазына
Dialogue: 0,0:14:33.41,0:14:33.91,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:33.99,0:14:39.04,Default,,0,0,0,,Дәл қазір Сейрейтейде жау мен одақтас араласып жатыр.
Dialogue: 0,0:14:39.12,0:14:41.63,Default,,0,0,0,,Оны көп пайдалана алмағаным ұят.
Dialogue: 0,0:14:45.13,0:14:46.09,Default,,0,0,0,,Енді
Dialogue: 0,0:14:46.17,0:14:49.05,Default,,0,0,0,,Сондықтан Банкайыңызды алып кетеді деп уайымдаудың қажеті жоқ.
Dialogue: 0,0:14:49.55,0:14:50.80,Default,,0,0,0,,Қарсы шабуылға шығамыз ба?
Dialogue: 0,0:14:50.88,0:14:54.35,Default,,0,0,0,,Жоқ, қажетсіз қозғалмаған дұрыс деп ойлаймын.
Dialogue: 0,0:14:54.43,0:14:55.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:55.14,0:14:58.02,Default,,0,0,0,,Көлеңкелер көбейеді, жағымсыз сезім пайда болады.
Dialogue: 0,0:14:58.10,0:14:58.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:00.56,0:15:01.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:01.23,0:15:03.61,Default,,0,0,0,,Бұл не, Мадарама және басқалары?
Dialogue: 0,0:15:03.69,0:15:05.94,Default,,0,0,0,,«Бұл не?» мұндағы сызық.
Dialogue: 0,0:15:06.03,0:15:07.53,Default,,0,0,0,,Неліктен бізге қосылдың?
Dialogue: 0,0:15:07.61,0:15:09.19,Default,,0,0,0,,Мен адасып қалдым.
Dialogue: 0,0:15:09.28,0:15:11.28,Default,,0,0,0,,Жер бедері мүлде басқаша.
Dialogue: 0,0:15:11.36,0:15:13.53,Default,,0,0,0,,Сондықтан олар жауды таба алмайды.
Dialogue: 0,0:15:13.62,0:15:16.70,Default,,0,0,0,,Сейрейтейге жоғары концентрациядағы спиртті шашу
Dialogue: 0,0:15:16.79,0:15:19.33,Default,,0,0,0,,Олар көлеңкеде жасырынып жүрсе керек.
Dialogue: 0,0:15:19.41,0:15:21.54,Default,,0,0,0,,Мен оның қайдан шыққанын білмеймін.
Dialogue: 0,0:15:21.62,0:15:23.33,Default,,0,0,0,,Қозғалыс кезінде абай болыңыз...
Dialogue: 0,0:15:23.42,0:15:24.71,Default,,0,0,0,,Иә!
Dialogue: 0,0:15:24.79,0:15:25.79,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:15:29.51,0:15:32.97,Default,,0,0,0,,Андеркарттағы балалар үшін жақсы қимыл.
Dialogue: 0,0:15:35.18,0:15:36.60,Default,,0,0,0,,Мен сізді мақтауға рұқсат етіңіз.
Dialogue: 0,0:15:36.68,0:15:38.85,Default,,0,0,0,,Андеркартада кім бар? Маска киген Дарума!
Dialogue: 0,0:15:38.93,0:15:41.89,Default,,0,0,0,,Сол масканы шешіп, кір жүзіңе табынамын!
Dialogue: 0,0:15:41.98,0:15:43.02,Default,,0,0,0,,О!
Dialogue: 0,0:15:43.10,0:15:47.02,Default,,0,0,0,,Маскасыз өлім матчы 3-тен 1-ге арналған жалғыз матч
Dialogue: 0,0:15:47.11,0:15:48.44,Default,,0,0,0,,Қызықты
Dialogue: 0,0:15:48.53,0:15:50.86,Default,,0,0,0,,Эй Джеймс, гонгты шырылда!
Dialogue: 0,0:15:50.95,0:15:51.45,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:15:52.82,0:15:53.91,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:15:55.16,0:15:56.91,Default,,0,0,0,,Әзіл!
Dialogue: 0,0:15:57.58,0:15:58.16,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:16:00.00,0:16:00.91,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:01.00,0:16:05.67,Default,,0,0,0,,Егер сіз өз күштеріңізді жасырсаңыз, супер жұлдыздарды жеңе алмайсыз...
Dialogue: 0,0:16:05.75,0:16:07.29,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:16:07.38,0:16:08.42,Default,,0,0,0,,Уф! (Юмичика) Уау!
Dialogue: 0,0:16:10.63,0:16:13.30,Default,,0,0,0,,Хехехе... Хахахаха!
Dialogue: 0,0:16:13.38,0:16:14.76,Default,,0,0,0,,Хмм... Не?
Dialogue: 0,0:16:14.84,0:16:15.72,Default,,0,0,0,,Жарайды, барлығыңыз, ережелерді түсіндірейін
Dialogue: 0,0:16:15.80,0:16:16.55,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:16:17.55,0:16:20.10,Default,,0,0,0,,Тізбекті өлім матчы қосылды!
Dialogue: 0,0:16:24.94,0:16:27.56,Default,,0,0,0,,Ха! Не істеп жатырсың...
Dialogue: 0,0:16:27.65,0:16:28.57,Default,,0,0,0,,Эй!
Dialogue: 0,0:16:30.03,0:16:31.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:31.36,0:16:35.24,Default,,0,0,0,,Мен ұрлаған күш енді менің қолымда емес, оның не қатысы бар?
Dialogue: 0,0:16:35.32,0:16:37.20,Default,,0,0,0,,Менің серіктесімнің иті
Dialogue: 0,0:16:37.28,0:16:39.95,Default,,0,0,0,,Әу баста ол Сейрейтейде де болмаған.
Dialogue: 0,0:16:40.04,0:16:43.29,Default,,0,0,0,,Егер ол жоқ болса, онда ол жоқ деп бірінші болып айту керек!
Dialogue: 0,0:16:43.96,0:16:45.54,Default,,0,0,0,,Сіз тыңдайсыз ба? Сендер...
Dialogue: 0,0:16:47.88,0:16:49.92,Default,,0,0,0,,Неліктен мұнда ешкім жоқ?
Dialogue: 0,0:16:50.00,0:16:52.42,Default,,0,0,0,,Мен өз-өзіммен сөйлескендеймін
Dialogue: 0,0:16:52.51,0:16:55.18,Default,,0,0,0,,Лил Джижи Минни кәмпиттер!
Dialogue: 0,0:16:55.26,0:16:56.89,Default,,0,0,0,,Шық!
Dialogue: 0,0:16:57.76,0:16:59.89,Default,,0,0,0,,Гррр…
Dialogue: 0,0:17:00.51,0:17:02.93,Default,,0,0,0,,Шық!
Dialogue: 0,0:17:03.02,0:17:05.02,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:10.19,0:17:12.94,Default,,0,0,0,,Көшбасшыңызды ұятқа қалдырсаңыз не болады...
Dialogue: 0,0:17:13.03,0:17:17.07,Default,,0,0,0,,Мына жерді түгелдей бос жерге айналдырып, өртеп жіберемін!
Dialogue: 0,0:17:17.16,0:17:18.41,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:17:24.16,0:17:27.50,Default,,0,0,0,,Ит? Неге шелек киіп жүрсің?
Dialogue: 0,0:17:28.00,0:17:30.71,Default,,0,0,0,,Менен қорқасың ба, тіпті бетімді де көрмейсің бе?
Dialogue: 0,0:17:30.79,0:17:33.46,Default,,0,0,0,,Сен үшін уайымдайтын уақытым жоқ.
Dialogue: 0,0:17:34.21,0:17:37.80,Default,,0,0,0,,Мұның бәрі Генрюсай-дононың өкінішіне өш алу үшін жасалды.
Dialogue: 0,0:17:37.89,0:17:40.80,Default,,0,0,0,,Мен Юхабахтың басын аламын!
Dialogue: 0,0:17:41.31,0:17:42.85,Default,,0,0,0,,Бұл дұрыс
Dialogue: 0,0:17:43.35,0:17:45.10,Default,,0,0,0,,Бірақ мейірімді ит
Dialogue: 0,0:17:45.18,0:17:49.19,Default,,0,0,0,,Осылайша сіз достарыңызды қорғау үшін бағытты өзгерттіңіз.
Dialogue: 0,0:17:49.69,0:17:54.49,Default,,0,0,0,,Бірақ батырдың шығуы әлі ерте емес пе?
Dialogue: 0,0:17:54.57,0:17:57.36,Default,,0,0,0,,Одан да тозған соң Сейрейтей кезінде.
Dialogue: 0,0:17:57.45,0:17:58.99,Default,,0,0,0,,Ол шықса қызықтырақ болады.
Dialogue: 0,0:17:59.07,0:18:00.37,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:00.99,0:18:04.37,Default,,0,0,0,,Шынымды айтсам, батыр бола алмаймыз.
Dialogue: 0,0:18:04.45,0:18:09.54,Default,,0,0,0,,Сейрейтейде құлағанша сені қарауға шыдамым жетпейді.
Dialogue: 0,0:18:09.63,0:18:10.67,Default,,0,0,0,,(Шиозаки) «Кісі өлтіруші» дегенің не?
Dialogue: 0,0:18:10.75,0:18:12.29,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:18:12.38,0:18:14.59,Default,,0,0,0,,Мұны маған қалдырып, әрі қарай жүріңіз.
Dialogue: 0,0:18:14.67,0:18:15.17,Default,,0,0,0,,Кавабуки мен Цукуёми командасы
Dialogue: 0,0:18:15.26,0:18:17.09,Default,,0,0,0,,Сәлем! Менің итімді рұқсатсыз алыңыз ...
Dialogue: 0,0:18:17.17,0:18:18.09,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:18.68,0:18:22.05,Default,,0,0,0,,Не болды? Өзіңізді жақсы сезінбейсіз бе?
Dialogue: 0,0:18:23.18,0:18:25.31,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:18:25.39,0:18:28.77,Default,,0,0,0,,«Гяканасу» менің Занпакуто
Dialogue: 0,0:18:28.85,0:18:32.98,Default,,0,0,0,,Көріп тұрған нәрсені төңкеріп, үстіңгі, астыңғы, солға, оңға, алдыға және артқа айналдыр
Dialogue: 0,0:18:33.07,0:18:35.19,Default,,0,0,0,,Үйреніп, төбелесу мүмкін емес.
Dialogue: 0,0:18:35.28,0:18:37.36,Default,,0,0,0,,Басыңыз айналып жатыр ма?
Dialogue: 0,0:18:37.44,0:18:38.45,Default,,0,0,0,,О, Сея
Dialogue: 0,0:18:38.53,0:18:40.78,Default,,0,0,0,,Соңғы кезде сөздерді кері қарай ойнау арқылы жаттығып жүрмін.
Dialogue: 0,0:18:40.86,0:18:43.45,Default,,0,0,0,,Енді мен оны тыңдай аламын.
Dialogue: 0,0:18:43.53,0:18:44.95,Default,,0,0,0,,Мынадай нәрсе!
Dialogue: 0,0:18:45.04,0:18:47.58,Default,,0,0,0,,Сіз бұл мүмкін емес деп отырсыз.
Dialogue: 0,0:18:47.66,0:18:50.08,Default,,0,0,0,,Мен кеш шықтым, бірақ
Dialogue: 0,0:18:50.17,0:18:53.09,Default,,0,0,0,,Мен Мако Хирако, 5-ші дивизияның командирімін.
Dialogue: 0,0:18:54.63,0:18:56.09,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:18:57.09,0:18:58.09,Default,,0,0,0,,Ха…
Dialogue: 0,0:19:00.22,0:19:03.51,Default,,0,0,0,,Қыз: Өлтіру менің жынысыма сәйкес келмейді...
Dialogue: 0,0:19:04.10,0:19:05.60,Default,,0,0,0,,Маған үзіліс беріңіз.
Dialogue: 0,0:19:06.60,0:19:07.77,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:07.85,0:19:09.52,Default,,0,0,0,,Ой, бұл ақсақ!
Dialogue: 0,0:19:12.73,0:19:14.36,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:19:20.65,0:19:22.57,Default,,0,0,0,,Мен мұны төңкеріп айттым
Dialogue: 0,0:19:22.66,0:19:25.62,Default,,0,0,0,,Сізге көмектесу үшін достарыңызды шақыру туралы не айтасыз?
Dialogue: 0,0:19:26.62,0:19:27.45,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:27.54,0:19:30.91,Default,,0,0,0,,Аа, кешіріңіз, сіз жалғыз қалдыңыз ба?
Dialogue: 0,0:19:31.00,0:19:34.84,Default,,0,0,0,,Иттің алдында күлгенді үрле
Dialogue: 0,0:19:34.92,0:19:37.30,Default,,0,0,0,,Не істесең де, мүмкін емес.
Dialogue: 0,0:19:37.92,0:19:38.84,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:42.18,0:19:43.18,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:19:45.64,0:19:47.01,Default,,0,0,0,,А...
Dialogue: 0,0:19:48.18,0:19:49.02,Default,,0,0,0,,Уф… Мұнда не болып жатыр өзі?
Dialogue: 0,0:19:49.10,0:19:50.48,Default,,0,0,0,,Егер Ваму сол затты бірінші қолға алса—
Dialogue: 0,0:19:50.56,0:19:52.23,Default,,0,0,0,,Ах... Арх!
Dialogue: 0,0:19:52.31,0:19:53.94,Default,,0,0,0,,Енді Мадарама!
Dialogue: 0,0:19:54.02,0:19:55.69,Default,,0,0,0,,Ахх!
Dialogue: 0,0:19:57.77,0:19:59.61,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:20:09.54,0:20:10.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:10.62,0:20:12.00,Default,,0,0,0,,Хехе
Dialogue: 0,0:20:12.50,0:20:17.00,Default,,0,0,0,,Мен қуаныштымын, Стернритер.
Dialogue: 0,0:20:23.88,0:20:25.01,Default,,0,0,0,,Бұл жарық...
Dialogue: 0,0:20:25.09,0:20:27.35,Default,,0,0,0,,Бұл не...
Dialogue: 0,0:20:29.31,0:20:31.68,Default,,0,0,0,,Аннигилатордың мінсіздігі (Квинси Форстендиг)
Dialogue: 0,0:20:32.18,0:20:34.85,Default,,0,0,0,,Мен мұны пайдалана алмадым.
Dialogue: 0,0:20:34.94,0:20:36.86,Default,,0,0,0,,Банкай кедергі келтіреді.
Dialogue: 0,0:20:36.94,0:20:41.44,Default,,0,0,0,,Маған осы қуатты пайдалануға рұқсат бергеніңіз үшін рахмет.
Dialogue: 0,0:20:41.94,0:20:44.57,Default,,0,0,0,,Мен Банкайымды қайтардым.
Dialogue: 0,0:20:44.66,0:20:47.87,Default,,0,0,0,,Өкінбеңдер, өлім құдайлары.
Dialogue: 0,0:20:48.37,0:20:50.70,Default,,0,0,0,,Үміт пен жылулыққа толы
Dialogue: 0,0:20:51.20,0:20:53.21,Default,,0,0,0,,Ұрыс ұйқыға ұқсайды
Dialogue: 0,0:20:53.71,0:20:55.46,Default,,0,0,0,,Осы жерде аяқталады
Dialogue: 0,0:21:00.71,0:21:04.97,Default,,0,0,0,,Нағыз үмітсіздік осыдан басталады.
Dialogue: 0,0:21:06.72,0:21:08.72,Default,,0,0,0,,♪～
Dialogue: 0,0:22:31.93,0:22:33.93,Default,,0,0,0,,～♪
Dialogue: 0,0:22:45.57,0:22:47.74,Default,,0,0,0,,Дәл сол жерде болса да...
Dialogue: 0,0:22:48.24,0:22:49.45,Default,,0,0,0,,алыс
Dialogue: 0,0:22:55.54,0:22:56.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:57.45,0:22:59.33,Default,,0,0,0,,Қазір бұл не?
Dialogue: 0,0:23:00.50,0:23:01.17,Default,,0,0,0,,Гррр…
Dialogue: 0,0:23:02.75,0:23:04.09,Default,,0,0,0,,Бәрі жақсы.
Dialogue: 0,0:23:04.59,0:23:07.17,Default,,0,0,0,,Бізде алға жылжудан басқа амал жоқ.
Dialogue: 0,0:23:10.05,0:23:12.09,Default,,0,0,0,,Ха... тағы да.
Dialogue: 0,0:23:12.76,0:23:13.64,Default,,0,0,0,,Уф!
Dialogue: 0,0:23:14.76,0:23:15.64,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:23:17.89,0:23:18.39,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:39.16,0:23:43.21,Default,,0,0,0,,Өз өміріңмен күресуді жалғастыр
Dialogue: 0,0:23:44.50,0:23:48.63,Default,,0,0,0,,Жүрегімде азу бар болғанша
Dialogue: 0,0:23:50.13,0:23:56.13,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
