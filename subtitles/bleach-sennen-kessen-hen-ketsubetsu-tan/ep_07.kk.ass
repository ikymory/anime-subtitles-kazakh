Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:13.21,0:00:15.08,Default,,0,0,0,,Уау! Менің мұрыннан қан кетіп жатыр
Dialogue: 0,0:00:15.17,0:00:16.84,Default,,0,0,0,,Сіз оны бір жерден соқтыңыз ба?
Dialogue: 0,0:00:16.92,0:00:19.01,Default,,0,0,0,,Иә... Мен білмеймін.
Dialogue: 0,0:00:19.51,0:00:21.92,Default,,0,0,0,,Мен солай ойлаймын. Маған солай көрінеді.
Dialogue: 0,0:00:22.01,0:00:23.51,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:00:24.01,0:00:27.35,Default,,0,0,0,,Танысқаныма қуаныштымын, Star Cross Knights (Sternritter) «V»
Dialogue: 0,0:00:27.43,0:00:31.23,Default,,0,0,0,,Мен Жоғалу нүктесінің өкілі Гвенаэль Лимін
Dialogue: 0,0:00:32.52,0:00:35.40,Default,,0,0,0,,Менің бар екенімді білесің...
Dialogue: 0,0:00:35.48,0:00:37.90,Default,,0,0,0,,Иә? Бұл біртүрлі
Dialogue: 0,0:00:38.40,0:00:40.44,Default,,0,0,0,,Мен дұрыс түсіндім деп ойладым.
Dialogue: 0,0:00:41.99,0:00:43.03,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:43.11,0:00:44.82,Default,,0,0,0,,Вице-капитан Құсақа! Бұл дұрыс, сонда дұрыс.
Dialogue: 0,0:00:45.32,0:00:47.99,Default,,0,0,0,,Менің күшімнің үш нұсқасы бар.
Dialogue: 0,0:00:49.45,0:00:52.87,Default,,0,0,0,,Жоғалған 1-нұсқа
Dialogue: 0,0:00:52.96,0:00:55.92,Default,,0,0,0,,Жою 2-нұсқа (Екі)
Dialogue: 0,0:00:57.67,0:01:00.96,Default,,0,0,0,,Ой, реакция жылдамдап барады.
Dialogue: 0,0:01:01.05,0:01:02.30,Default,,0,0,0,,Бұл не деген сөз өзі?
Dialogue: 0,0:01:02.88,0:01:06.30,Default,,0,0,0,,Тіпті санадан жоғалады 3-нұсқа (Үш)
Dialogue: 0,0:01:07.64,0:01:09.89,Default,,0,0,0,,Дәл қазір сонда біреу болды ма?
Dialogue: 0,0:01:09.97,0:01:11.68,Default,,0,0,0,,Ал...
Dialogue: 0,0:01:11.77,0:01:12.93,Default,,0,0,0,,Иә
Dialogue: 0,0:01:14.48,0:01:16.48,Default,,0,0,0,,♪～
Dialogue: 0,0:02:41.52,0:02:43.52,Default,,0,0,0,,～♪
Dialogue: 0,0:02:59.03,0:03:02.66,Default,,0,0,0,,Тағы да «Танысқаныма қуаныштымын».
Dialogue: 0,0:03:03.87,0:03:05.16,Default,,0,0,0,,Иә? (Юон) Эх!
Dialogue: 0,0:03:05.24,0:03:06.49,Default,,0,0,0,,Мен дұрыс түсіндім деп ойладым.
Dialogue: 0,0:03:06.58,0:03:08.12,Default,,0,0,0,,Жоқ... Мынау не жігіт?
Dialogue: 0,0:03:08.20,0:03:10.12,Default,,0,0,0,,Ол мені рефлекстермен ұрды.
Dialogue: 0,0:03:10.21,0:03:11.96,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:03:12.04,0:03:14.54,Default,,0,0,0,,Дос не дұшпан екенін білмейтін адамға
Dialogue: 0,0:03:14.63,0:03:17.00,Default,,0,0,0,,Иә... бірақ бұл жау шығар.
Dialogue: 0,0:03:17.09,0:03:19.46,Default,,0,0,0,,Мен ол кісіні көргенде шошып кеттім.
Dialogue: 0,0:03:19.55,0:03:22.09,Default,,0,0,0,,Иә? Сіз мені инстинктпен ұрдыңыз ба?
Dialogue: 0,0:03:22.18,0:03:23.59,Default,,0,0,0,,Ей, хайуан!
Dialogue: 0,0:03:23.68,0:03:27.64,Default,,0,0,0,,Бұл сыбдырлы сезім маңызды нәрсе.
Dialogue: 0,0:03:28.14,0:03:32.44,Default,,0,0,0,,Зауа суық, ыстық, бақытты... дегенді білдіреді.
Dialogue: 0,0:03:32.52,0:03:34.19,Default,,0,0,0,,Осындай нәрсе
Dialogue: 0,0:03:35.02,0:03:38.44,Default,,0,0,0,,«Ондай адамды тапсам, кесіп тастаймын».
Dialogue: 0,0:03:38.53,0:03:40.11,Default,,0,0,0,,Кен Чан осылай деді
Dialogue: 0,0:03:40.61,0:03:42.36,Default,,0,0,0,,Кен Чан қазір жоқ.
Dialogue: 0,0:03:42.45,0:03:46.66,Default,,0,0,0,,Мен сені кесіп алсам да, Кен Чан, көңіл-күйің болмайды.
Dialogue: 0,0:03:49.45,0:03:51.12,Default,,0,0,0,,Толық кауль!
Dialogue: 0,0:03:53.50,0:03:55.13,Default,,0,0,0,,Жо…
Dialogue: 0,0:03:55.63,0:03:58.92,Default,,0,0,0,,Ақымақ... Мен дәл қазір қылыштан жалтардым.
Dialogue: 0,0:03:59.00,0:04:01.47,Default,,0,0,0,,Мүлдем дұрыс емес.
Dialogue: 0,0:04:01.55,0:04:02.88,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:04:02.97,0:04:06.39,Default,,0,0,0,,Жалтарсам да, қашпасам да қылышым тиеді.
Dialogue: 0,0:04:06.47,0:04:08.56,Default,,0,0,0,,Жоқ... Жато?
Dialogue: 0,0:04:08.64,0:04:11.35,Default,,0,0,0,,Менің қылышым – көшірме қылыш.
Dialogue: 0,0:04:11.43,0:04:15.85,Default,,0,0,0,,Қылышымның алдында да, артында да маған еліктеген балалар бар.
Dialogue: 0,0:04:15.94,0:04:19.02,Default,,0,0,0,,Сондықтан, алшақтықты көрген сайын, бас тартасың.
Dialogue: 0,0:04:19.11,0:04:20.86,Default,,0,0,0,,Қашықтық жойылып, сіз соққы аласыз.
Dialogue: 0,0:04:20.94,0:04:22.86,Default,,0,0,0,,Жүр, шық.
Dialogue: 0,0:04:23.45,0:04:25.03,Default,,0,0,0,,Үш қадамды қылыш аң
Dialogue: 0,0:04:25.70,0:04:27.99,Default,,0,0,0,,Жоқ... Дұрыс!
Dialogue: 0,0:04:30.45,0:04:31.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:31.29,0:04:32.83,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:04:32.91,0:04:34.58,Default,,0,0,0,,Эй, эй
Dialogue: 0,0:04:34.67,0:04:36.33,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:37.13,0:04:39.25,Default,,0,0,0,,Бұл... бұл бастамасы ма?
Dialogue: 0,0:04:39.84,0:04:41.42,Default,,0,0,0,,Қылыш өзгерген жоқ
Dialogue: 0,0:04:41.92,0:04:46.80,Default,,0,0,0,,Банкай жаттығулары арқылы пайда болатын Занпакутудың негізгі бөлігінің көрінісі де емес.
Dialogue: 0,0:04:46.89,0:04:48.89,Default,,0,0,0,,Мен мұндай ашылу барына сене алар емеспін...
Dialogue: 0,0:04:53.14,0:04:54.56,Default,,0,0,0,,Иә? Бұл біртүрлі
Dialogue: 0,0:04:54.64,0:04:57.31,Default,,0,0,0,,Мен сені екіге бөлемін деп ойладым
Dialogue: 0,0:04:57.40,0:04:58.56,Default,,0,0,0,,Идиот...
Dialogue: 0,0:04:58.65,0:05:00.02,Default,,0,0,0,,Кесу алдында тұқымды ашыңыз
Dialogue: 0,0:05:00.11,0:05:02.11,Default,,0,0,0,,Сіз оны айналып өте алмаймын деп ойладыңыз ба?
Dialogue: 0,0:05:02.19,0:05:02.73,Default,,0,0,0,,Уф!
Dialogue: 0,0:05:05.70,0:05:09.20,Default,,0,0,0,,А... бұл өтірік
Dialogue: 0,0:05:09.28,0:05:10.66,Default,,0,0,0,,Бұл өтірік емес
Dialogue: 0,0:05:12.74,0:05:15.16,Default,,0,0,0,,Ха! Мен білмей тұрып, мен тосқауылдың ішінде болдым ...
Dialogue: 0,0:05:15.25,0:05:16.50,Default,,0,0,0,,Бұл...
Dialogue: 0,0:05:17.00,0:05:19.67,Default,,0,0,0,,Мен қолымнан келгеннің бәрін жасадым, солай емес пе?
Dialogue: 0,0:05:19.75,0:05:22.46,Default,,0,0,0,,Иә, мен қатты тырыстым.
Dialogue: 0,0:05:22.96,0:05:26.30,Default,,0,0,0,,Менің қиялымның жемісі ретінде
Dialogue: 0,0:05:26.38,0:05:27.76,Default,,0,0,0,,Жоқ, өмірден бас тартпа
Dialogue: 0,0:05:27.84,0:05:30.51,Default,,0,0,0,,Менің қабілетім болса, мына жігіттер...
Dialogue: 0,0:05:30.60,0:05:32.93,Default,,0,0,0,,Иә, бұл керемет қабілет.
Dialogue: 0,0:05:33.43,0:05:34.43,Default,,0,0,0,,Сіздің бар болуыңыз
Dialogue: 0,0:05:34.52,0:05:38.31,Default,,0,0,0,,Оны көзден, санадан, есте сақтаудан өшіруге болады.
Dialogue: 0,0:05:38.81,0:05:39.98,Default,,0,0,0,,Қараңызшы...
Dialogue: 0,0:05:40.48,0:05:43.90,Default,,0,0,0,,Енді ол менің жадымнан өшіп қалды.
Dialogue: 0,0:05:43.98,0:05:44.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:05:47.11,0:05:49.82,Default,,0,0,0,,Греми~!
Dialogue: 0,0:05:50.41,0:05:51.24,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:05:51.74,0:05:54.08,Default,,0,0,0,,Мен сенің болашағыңды енді елестете алмаймын.
Dialogue: 0,0:05:58.67,0:06:00.63,Default,,0,0,0,,Сен кімсің?
Dialogue: 0,0:06:00.71,0:06:02.50,Default,,0,0,0,,Сол жерден кетіңіз.
Dialogue: 0,0:06:03.00,0:06:04.42,Default,,0,0,0,,Сіз бұл капитандарға алаңдайсыз ба?
Dialogue: 0,0:06:04.50,0:06:05.51,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:06:06.01,0:06:07.47,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,0:06:08.47,0:06:09.47,Default,,0,0,0,,Қазірдің өзінде өлтірілген
Dialogue: 0,0:06:10.05,0:06:10.89,Default,,0,0,0,,Өтірік…
Dialogue: 0,0:06:13.89,0:06:14.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:18.64,0:06:21.10,Default,,0,0,0,,Иә? Менің қолым...
Dialogue: 0,0:06:22.23,0:06:23.82,Default,,0,0,0,,Елестетіп көріңізші
Dialogue: 0,0:06:23.90,0:06:27.61,Default,,0,0,0,,Қол сүйегі печенье болса...
Dialogue: 0,0:06:28.11,0:06:31.49,Default,,0,0,0,,Сіз жай ғана берілуді табиғи деп ойладыңыз, солай ма?
Dialogue: 0,0:06:31.57,0:06:33.66,Default,,0,0,0,,Ал сіз мұны елестедіңіз, солай ма?
Dialogue: 0,0:06:34.16,0:06:35.99,Default,,0,0,0,,«Егер қол сүйектері печенье болса»
Dialogue: 0,0:06:36.08,0:06:39.21,Default,,0,0,0,,«Басқа сүйектердің бәрі печенье емес пе?»
Dialogue: 0,0:06:39.29,0:06:41.17,Default,,0,0,0,,(Джозеф) Бір, екі. (Абдул) Бір, екі.
Dialogue: 0,0:06:41.71,0:06:46.59,Default,,0,0,0,,Бұл дүниедегі ең құдіретті күш – қиял.
Dialogue: 0,0:06:47.09,0:06:49.13,Default,,0,0,0,,Мен елестеткенім болды
Dialogue: 0,0:06:49.22,0:06:52.39,Default,,0,0,0,,үшін шындыққа айналады
Dialogue: 0,0:06:57.35,0:06:58.81,Default,,0,0,0,,Не?
Dialogue: 0,0:06:58.89,0:07:01.90,Default,,0,0,0,,Өйткені Ячирудың реятсуы әбден дірілдеп тұр.
Dialogue: 0,0:07:01.98,0:07:03.23,Default,,0,0,0,,Барсаңыз, іздеңіз...
Dialogue: 0,0:07:04.11,0:07:07.23,Default,,0,0,0,,Бұл бір бала шу шығарып жатыр емес пе?
Dialogue: 0,0:07:09.03,0:07:10.24,Default,,0,0,0,,Кен Чан...
Dialogue: 0,0:07:13.74,0:07:16.79,Default,,0,0,0,,Бұл... Капитан Зараки Ах... Мм...
Dialogue: 0,0:07:17.58,0:07:19.62,Default,,0,0,0,,Капитан Унохана...
Dialogue: 0,0:07:24.13,0:07:25.13,Default,,0,0,0,,Эй!
Dialogue: 0,0:07:29.55,0:07:32.01,Default,,0,0,0,,Солай ма...?
Dialogue: 0,0:07:35.10,0:07:36.89,Default,,0,0,0,,Мен оны өлтірдім
Dialogue: 0,0:07:37.39,0:07:40.31,Default,,0,0,0,,Егер сен мені жек көрсең, мені қия аласың.
Dialogue: 0,0:07:41.64,0:07:42.94,Default,,0,0,0,,Жақсы
Dialogue: 0,0:07:43.44,0:07:46.15,Default,,0,0,0,,Капитан Зараки өлтірілді деген нені білдіреді?
Dialogue: 0,0:07:46.65,0:07:48.19,Default,,0,0,0,,Осылайша ол мұраға қалдырылды ...
Dialogue: 0,0:07:49.61,0:07:51.70,Default,,0,0,0,,Капитан Унохананың аты
Dialogue: 0,0:07:52.70,0:07:54.61,Default,,0,0,0,,Иә
Dialogue: 0,0:07:55.12,0:07:56.45,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:56.53,0:07:59.29,Default,,0,0,0,,Бұл Кенпачи Зараки ме?
Dialogue: 0,0:07:59.83,0:08:00.91,Default,,0,0,0,,Күшті көрінеді
Dialogue: 0,0:08:01.96,0:08:03.58,Default,,0,0,0,,Сіз елестете аласыз.
Dialogue: 0,0:08:04.21,0:08:05.21,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:09.17,0:08:09.67,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:08:19.31,0:08:21.98,Default,,0,0,0,,Иә, мен сахнаны дайындадым.
Dialogue: 0,0:08:22.06,0:08:24.56,Default,,0,0,0,,Өйткені, бұл Кенпачи Зараки.
Dialogue: 0,0:08:24.64,0:08:27.40,Default,,0,0,0,,Біз сізді үлкен сахнада қарсы алмасақ, дөрекі болар еді.
Dialogue: 0,0:08:27.48,0:08:30.69,Default,,0,0,0,,Не, бұл сиқырдың бір түрі ме?
Dialogue: 0,0:08:30.78,0:08:34.45,Default,,0,0,0,,Бұл сиқыр немесе иллюзия емес, бұл шындық.
Dialogue: 0,0:08:35.24,0:08:39.33,Default,,0,0,0,,Мен өз қиялдарымды шындыққа айналдырамын Греми Визионер
Dialogue: 0,0:08:41.08,0:08:44.00,Default,,0,0,0,,Менің ойымша, саған менімен күресу бақыты бұйырды.
Dialogue: 0,0:08:44.50,0:08:48.34,Default,,0,0,0,,Өйткені мен өзімді ең күшті Стернритермін деп ойлаймын.
Dialogue: 0,0:08:49.54,0:08:50.84,Default,,0,0,0,,Ағамның қабіріне барып болған соң, бірдеңе жейік, Жосуке.
Dialogue: 0,0:08:52.59,0:08:54.30,Default,,0,0,0,,Тағы да айтамын
Dialogue: 0,0:08:54.38,0:08:57.30,Default,,0,0,0,,Мен қиялдарымды шындыққа айналдыра аламын.
Dialogue: 0,0:08:57.39,0:08:58.97,Default,,0,0,0,,Қазірдің өзінде, көрдің бе?
Dialogue: 0,0:08:59.05,0:09:02.77,Default,,0,0,0,,«Егер менің денем болаттан күшті болса».
Dialogue: 0,0:09:02.85,0:09:04.43,Default,,0,0,0,,Елестетіп көріңізші...
Dialogue: 0,0:09:08.56,0:09:09.98,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:10.07,0:09:13.57,Default,,0,0,0,,Болаттай қатты болса, соны айт.
Dialogue: 0,0:09:13.65,0:09:16.99,Default,,0,0,0,,Әу бастан үтікті кесемін деген ниетпен кесемін.
Dialogue: 0,0:09:18.49,0:09:20.58,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:21.12,0:09:23.37,Default,,0,0,0,,Сіз оны қия алмаймын деп елестедіңіз бе?
Dialogue: 0,0:09:24.08,0:09:25.08,Default,,0,0,0,,Мен сізге айтайын.
Dialogue: 0,0:09:26.21,0:09:28.67,Default,,0,0,0,,Ерекше қиялмен
Dialogue: 0,0:09:28.75,0:09:31.46,Default,,0,0,0,,Мен қия алмайтын нәрсені жасай алмаймын.
Dialogue: 0,0:09:32.38,0:09:36.22,Default,,0,0,0,,Себебі мен Кенпачимін
Dialogue: 0,0:10:00.69,0:10:01.82,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:10:02.32,0:10:04.11,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:10:04.61,0:10:05.49,Default,,0,0,0,,Уф!
Dialogue: 0,0:10:05.57,0:10:08.24,Default,,0,0,0,,Әй... Әй, мына Реиацу!
Dialogue: 0,0:10:09.74,0:10:11.12,Default,,0,0,0,,Капитан Зараки!
Dialogue: 0,0:10:12.24,0:10:15.66,Default,,0,0,0,,Цк... Астысы сондай шулы.
Dialogue: 0,0:10:15.75,0:10:16.79,Default,,0,0,0,,Міне — жер астында.
Dialogue: 0,0:10:16.87,0:10:20.13,Default,,0,0,0,,Менің ойымша, сіз келгендіктен біз шайқаста жеңе аламыз.
Dialogue: 0,0:10:20.21,0:10:22.05,Default,,0,0,0,,Сіздің қиялыңыз еркін, солай ма?
Dialogue: 0,0:10:22.71,0:10:25.05,Default,,0,0,0,,Жараны қолмен емдеуге бола ма?
Dialogue: 0,0:10:25.13,0:10:26.59,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:10:27.09,0:10:28.22,Default,,0,0,0,,(үшін төрт адам) Һмм? (JoJo) Дерби?
Dialogue: 0,0:10:28.97,0:10:30.05,Default,,0,0,0,,Мен жай ғана...
Dialogue: 0,0:10:30.76,0:10:33.10,Default,,0,0,0,,Кесілген жаралары жазылып үлгерген өзімді көремін.
Dialogue: 0,0:10:33.18,0:10:35.56,Default,,0,0,0,,Мен оны жай ғана елестеттім.
Dialogue: 0,0:10:35.64,0:10:36.27,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:36.77,0:10:39.10,Default,,0,0,0,,«Бұл әзіл-қалжың қабілеті».
Dialogue: 0,0:10:39.19,0:10:40.65,Default,,0,0,0,,Сіз солай ойладыңыз, солай ма?
Dialogue: 0,0:10:41.15,0:10:44.40,Default,,0,0,0,,Сіз сияқты адамдар жеңілгенше солай істейтініне сенімдімін
Dialogue: 0,0:10:44.48,0:10:46.57,Default,,0,0,0,,Менің күшімді түсіне алмаймын
Dialogue: 0,0:10:47.15,0:10:50.74,Default,,0,0,0,,Сондықтан, келіңіз, Кенпачи Зараки.
Dialogue: 0,0:10:51.24,0:10:55.16,Default,,0,0,0,,Мен біреумен бір саусақпен қарым-қатынас жасау туралы ұсақ-түйек ештеңе айтпаймын.
Dialogue: 0,0:10:55.66,0:10:57.91,Default,,0,0,0,,Тіпті саусақты да қолданбаңыз
Dialogue: 0,0:10:58.42,0:11:01.96,Default,,0,0,0,,Мен сені өз басымда өлтіремін
Dialogue: 0,0:11:03.46,0:11:05.26,Default,,0,0,0,,Бұл ақылсыз.
Dialogue: 0,0:11:05.34,0:11:09.22,Default,,0,0,0,,Бірақ мен мағынасы жоқ нәрселерді жек көрмеймін!
Dialogue: 0,0:11:11.01,0:11:13.64,Default,,0,0,0,,Сіз не істеп жатырсыз? Ячиру! Алыс болыңыз!
Dialogue: 0,0:11:13.72,0:11:15.68,Default,,0,0,0,,Өтінемін, бұлай дөрекі болмаңыз.
Dialogue: 0,0:11:15.77,0:11:20.10,Default,,0,0,0,,Енді менің қабілетіммен оның денесінің әрбір сүйегі печеньеге айналды.
Dialogue: 0,0:11:20.69,0:11:22.73,Default,,0,0,0,,Cookie дегеніміз не?
Dialogue: 0,0:11:22.81,0:11:24.52,Default,,0,0,0,,Не, сен білмейсің бе?
Dialogue: 0,0:11:24.61,0:11:27.11,Default,,0,0,0,,Менің ойымша, оны Ракуган немесе басқаша атаған дұрыс болар еді.
Dialogue: 0,0:11:27.19,0:11:28.99,Default,,0,0,0,,Ракуган?
Dialogue: 0,0:11:29.07,0:11:31.07,Default,,0,0,0,,Олай болса, басынан бастап айт.
Dialogue: 0,0:11:31.16,0:11:33.95,Default,,0,0,0,,Үнемі айналасың, бейбақ!
Dialogue: 0,0:11:36.50,0:11:37.16,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:11:39.21,0:11:41.42,Default,,0,0,0,,Сіз аударманы түсінбейсіз бе?
Dialogue: 0,0:11:41.50,0:11:45.13,Default,,0,0,0,,Сіз секірген ауа су астында болды.
Dialogue: 0,0:11:53.76,0:11:56.52,Default,,0,0,0,,Сумен қоршалған, Жердегі жарықтармен жаншылған
Dialogue: 0,0:11:57.10,0:12:00.27,Default,,0,0,0,,Жай ғана өл.
Dialogue: 0,0:12:00.35,0:12:04.77,Default,,0,0,0,,Қанша жынды болсаң да, бір сағат жеткілікті, солай ма?
Dialogue: 0,0:12:09.40,0:12:09.90,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:12:11.99,0:12:15.08,Default,,0,0,0,,Ячирудың сүйектері қалыпқа келген сияқты.
Dialogue: 0,0:12:15.58,0:12:17.91,Default,,0,0,0,,Менімен бәсекелесуге асығады
Dialogue: 0,0:12:17.99,0:12:20.71,Default,,0,0,0,,Ячиру, сен миыңды пайдалану қабілетінен айырылдың ба?
Dialogue: 0,0:12:26.21,0:12:29.09,Default,,0,0,0,,Аа, мүлде...
Dialogue: 0,0:12:29.17,0:12:30.55,Default,,0,0,0,,Дүние жай ғана қиял
Dialogue: 0,0:12:30.63,0:12:33.09,Default,,0,0,0,,Мен ештеңе істей алмайтын адамдарға жаман сөздер айтамын.
Dialogue: 0,0:12:33.18,0:12:36.60,Default,,0,0,0,,Өз қиялымен кез келген нәрсені істей алатын жігітті көргенде
Dialogue: 0,0:12:37.18,0:12:38.47,Default,,0,0,0,,Қолдан ештеңе келмегені жақсы
Dialogue: 0,0:12:38.56,0:12:41.10,Default,,0,0,0,,Қаншалықты тыныш болар екен деп ойлаймын
Dialogue: 0,0:12:42.14,0:12:44.60,Default,,0,0,0,,Котецудың Рейацусы әлі де бар.
Dialogue: 0,0:12:44.69,0:12:46.82,Default,,0,0,0,,Барып қолыңды сауықтыр.
Dialogue: 0,0:12:46.90,0:12:47.94,Default,,0,0,0,,Әй!
Dialogue: 0,0:12:50.82,0:12:53.49,Default,,0,0,0,,Менімен не істей аласың?
Dialogue: 0,0:12:53.99,0:12:55.74,Default,,0,0,0,,Сіз шайқаса аласыз, солай ма?
Dialogue: 0,0:12:56.45,0:12:57.45,Default,,0,0,0,,Шайқас…
Dialogue: 0,0:12:58.03,0:13:00.37,Default,,0,0,0,,Әй, өзіңе не істедің?
Dialogue: 0,0:13:00.87,0:13:03.46,Default,,0,0,0,,Ол ең күшті жойғыш (Квинси) емес пе?
Dialogue: 0,0:13:03.54,0:13:07.96,Default,,0,0,0,,Сен мықты болсаң, неге күштіні талқандамасқа!
Dialogue: 0,0:13:08.04,0:13:11.17,Default,,0,0,0,,Келіңіздер! Ұрысты бастайық
Dialogue: 0,0:13:11.26,0:13:15.18,Default,,0,0,0,,Сіздің назарыңызды алдыңыздағы жаудан басқа нәрсеге аударуға мәжбүр ететін нәрсе.
Dialogue: 0,0:13:15.26,0:13:17.43,Default,,0,0,0,,Оны шайқас деп атамаңыз!
Dialogue: 0,0:13:20.31,0:13:21.56,Default,,0,0,0,,Не?
Dialogue: 0,0:13:25.19,0:13:27.31,Default,,0,0,0,,Мына жігіт не деді?
Dialogue: 0,0:13:27.81,0:13:31.15,Default,,0,0,0,,Ең күшті болсаң, күштіні талқандағың келеді, солай ма?
Dialogue: 0,0:13:31.65,0:13:33.86,Default,,0,0,0,,Мен бұл туралы ешқашан ойламадым.
Dialogue: 0,0:13:34.49,0:13:38.37,Default,,0,0,0,,Әу бастан маған қол қойған бірде-бір адам болған жоқ.
Dialogue: 0,0:13:38.45,0:13:40.54,Default,,0,0,0,,Өйткені мен толық түсінемін.
Dialogue: 0,0:13:41.04,0:13:45.37,Default,,0,0,0,,Менің мықты екенім көрініп тұр.
Dialogue: 0,0:13:46.17,0:13:49.21,Default,,0,0,0,,Оны біреуді өлтіру арқылы дәлелдеудің қажеті жоқ.
Dialogue: 0,0:13:49.79,0:13:51.67,Default,,0,0,0,,Сондықтан мен біреуді жаншып алғым келеді
Dialogue: 0,0:13:51.76,0:13:53.47,Default,,0,0,0,,Мен бұл туралы ешқашан ойлаған емеспін
Dialogue: 0,0:13:54.05,0:13:56.72,Default,,0,0,0,,Бірақ... Бірақ неге...
Dialogue: 0,0:13:57.30,0:13:58.72,Default,,0,0,0,,Мен осындаймын
Dialogue: 0,0:13:59.43,0:14:02.81,Default,,0,0,0,,Мен бұл жігітті жаншып алғым келеді!
Dialogue: 0,0:14:04.52,0:14:05.35,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,0:14:15.61,0:14:16.91,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:14:18.16,0:14:21.83,Default,,0,0,0,,Қолдар... сіз оларды пайдаландыңыз.
Dialogue: 0,0:14:22.70,0:14:23.37,Default,,0,0,0,,Фу…
Dialogue: 0,0:14:23.45,0:14:24.62,Default,,0,0,0,,Жақсы жүз
Dialogue: 0,0:14:25.21,0:14:28.12,Default,,0,0,0,,Ол ақыры бақытты болған сияқты.
Dialogue: 0,0:14:28.79,0:14:30.38,Default,,0,0,0,,Сіздің жүзіңіз жақсы ма?
Dialogue: 0,0:14:31.71,0:14:34.42,Default,,0,0,0,,Мен қазір қандай екенімді білмеймін, бірақ
Dialogue: 0,0:14:35.51,0:14:39.14,Default,,0,0,0,,Қызық, мен неге мұндаймын...
Dialogue: 0,0:14:39.64,0:14:41.39,Default,,0,0,0,,Қазір мен осындаймын...
Dialogue: 0,0:14:41.47,0:14:43.14,Default,,0,0,0,,Мен өзімді тамаша сезінемін!
Dialogue: 0,0:14:44.43,0:14:45.39,Default,,0,0,0,,Екінші жартысында басқалар әлсіреп жатқанда, олар өздерінің көз тартымды Квиркімен жауды өздеріне тартты ➡
Dialogue: 0,0:14:50.19,0:14:52.07,Default,,0,0,0,,Сізде талант жоқ.
Dialogue: 0,0:14:52.15,0:14:55.07,Default,,0,0,0,,Мен айттым ғой, темірмен кесуге болады!
Dialogue: 0,0:14:56.53,0:14:57.20,Default,,0,0,0,,Қашу мүмкін емес!
Dialogue: 0,0:14:58.66,0:14:59.57,Default,,0,0,0,,Ха!
Dialogue: 0,0:15:01.16,0:15:02.99,Default,,0,0,0,,Сізде талант жоқ.
Dialogue: 0,0:15:03.08,0:15:05.58,Default,,0,0,0,,Айттым ғой, қиюдың қажеті жоқ.
Dialogue: 0,0:15:07.50,0:15:08.67,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:15:11.04,0:15:12.42,Default,,0,0,0,,Сіз кешіктіңіз!
Dialogue: 0,0:15:12.50,0:15:14.92,Default,,0,0,0,,Сенің кесілгеніңді кеш түсіндім.
Dialogue: 0,0:15:15.01,0:15:18.88,Default,,0,0,0,,Сол бір сәттік кідірістің арқасында келесі соққы берілді!
Dialogue: 0,0:15:24.35,0:15:25.27,Default,,0,0,0,,Бұл өтірік...
Dialogue: 0,0:15:25.35,0:15:27.89,Default,,0,0,0,,Мен неге бұл жігіттің қылышын тоқтата алмаймын?
Dialogue: 0,0:15:27.98,0:15:30.73,Default,,0,0,0,,Мен бұл жігіттен шынымен жеңілемін бе?
Dialogue: 0,0:15:31.23,0:15:33.65,Default,,0,0,0,,Сен ақымақсың, ақымақсың, ақымақсың...
Dialogue: 0,0:15:33.73,0:15:35.32,Default,,0,0,0,,Эй, досым! Эй, досым!
Dialogue: 0,0:15:36.78,0:15:37.78,Default,,0,0,0,,Не?
Dialogue: 0,0:15:38.78,0:15:40.70,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:15:41.28,0:15:44.33,Default,,0,0,0,,Сіз тіпті жеңілетінімді елестедіңіз бе?
Dialogue: 0,0:15:44.95,0:15:45.99,Default,,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:15:50.46,0:15:51.37,Default,,0,0,0,,Рахмет
Dialogue: 0,0:15:51.88,0:15:53.42,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:15:53.92,0:15:55.55,Default,,0,0,0,,Қазір сіздің сөзіңізбен
Dialogue: 0,0:15:55.63,0:15:59.51,Default,,0,0,0,,Мен өз өлімімнің бейнесін толығымен өшіре алдым.
Dialogue: 0,0:15:59.59,0:16:02.18,Default,,0,0,0,,Мен енді ешқашан өлмеймін
Dialogue: 0,0:16:02.76,0:16:03.93,Default,,0,0,0,,Мен өкінемін
Dialogue: 0,0:16:04.01,0:16:05.89,Default,,0,0,0,,Мен мұны бұрын ешқашан жасаған емеспін!
Dialogue: 0,0:16:07.22,0:16:08.10,Default,,0,0,0,,Ха…
Dialogue: 0,0:16:08.18,0:16:09.98,Default,,0,0,0,,Рахмет ретінде мен...
Dialogue: 0,0:16:10.06,0:16:12.60,Default,,0,0,0,,Мен саған ең үлкен күшімді көрсетемін
Dialogue: 0,0:16:12.69,0:16:14.02,Default,,0,0,0,,Бұл – білім берудің мәні.
Dialogue: 0,0:16:14.11,0:16:15.57,Default,,0,0,0,,Өзгермелі эго емес
Dialogue: 0,0:16:15.65,0:16:19.28,Default,,0,0,0,,Мен де өз қиялыммен өмір жасай аламын.
Dialogue: 0,0:16:21.36,0:16:22.66,Default,,0,0,0,,Кесу де мүмкін емес
Dialogue: 0,0:16:23.41,0:16:24.82,Default,,0,0,0,,Ешқайсымыз да өлмейміз.
Dialogue: 0,0:16:25.33,0:16:26.37,Default,,0,0,0,,Және…
Dialogue: 0,0:16:26.45,0:16:30.58,Default,,0,0,0,,Қиялдың күші екі есе артады.
Dialogue: 0,0:16:32.96,0:16:34.83,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:16:34.92,0:16:36.54,Default,,0,0,0,,Бұл метеорит.
Dialogue: 0,0:16:36.63,0:16:39.09,Default,,0,0,0,,Сейрейтей түгелдей жоғалып кетті.
Dialogue: 0,0:16:39.71,0:16:42.59,Default,,0,0,0,,Үйінділердің арасынан мен ғана аман қалдым.
Dialogue: 0,0:16:42.68,0:16:44.34,Default,,0,0,0,,Метеорит туралы не деуге болады?
Dialogue: 0,0:16:44.43,0:16:47.72,Default,,0,0,0,,Мен ол жігітті әлі қиған жоқпын.
Dialogue: 0,0:16:48.22,0:16:51.60,Default,,0,0,0,,Мен өте қуаныштымын!
Dialogue: 0,0:16:54.65,0:16:57.32,Default,,0,0,0,,Да... жоқ! (Шинигами) құлап жатыр!
Dialogue: 0,0:16:57.40,0:17:00.32,Default,,0,0,0,,Бәріміз өлеміз... өлеміз!
Dialogue: 0,0:17:00.40,0:17:03.15,Default,,0,0,0,,Мысалы... Иә Мысалы
Dialogue: 0,0:17:03.66,0:17:06.57,Default,,0,0,0,,Заттарды жай ғана елестетуден гөрі, мысалға тоқталайық.
Dialogue: 0,0:17:07.41,0:17:10.41,Default,,0,0,0,,Мені дәл қазір өлтірсеңіз ше?
Dialogue: 0,0:17:10.91,0:17:12.21,Default,,0,0,0,,Бірақ бұл пайдасыз.
Dialogue: 0,0:17:12.29,0:17:15.42,Default,,0,0,0,,Метеорит қазірдің өзінде шындық және жоғалып кетпейді
Dialogue: 0,0:17:15.50,0:17:17.96,Default,,0,0,0,,Осы жерге құла, сонда бәрі жойылады
Dialogue: 0,0:17:18.04,0:17:21.59,Default,,0,0,0,,Мен ғана елестеткендей аман қаламын.
Dialogue: 0,0:17:21.67,0:17:25.34,Default,,0,0,0,,Дәрменсіз болу деген осы...
Dialogue: 0,0:17:25.43,0:17:27.43,Default,,0,0,0,,Кенпачи Зараки
Dialogue: 0,0:17:29.01,0:17:31.02,Default,,0,0,0,,Ештеңе істеу мүмкін емес пе?
Dialogue: 0,0:17:31.52,0:17:34.94,Default,,0,0,0,,Дұрыс, мен енді ол жерде болмаймын деп ойлаймын.
Dialogue: 0,0:17:40.90,0:17:43.49,Default,,0,0,0,,Іш, аш!
Dialogue: 0,0:17:50.08,0:17:52.20,Default,,0,0,0,,Қайдан келдің? брат
Dialogue: 0,0:17:56.67,0:17:58.84,Default,,0,0,0,,Гаки Сенің атың кім?
Dialogue: 0,0:18:01.42,0:18:02.46,Default,,0,0,0,,Дұрыс?
Dialogue: 0,0:18:03.84,0:18:04.84,Default,,0,0,0,,Ха-ха-ха-ха! Бұл дәл сен сияқты, Лабраба.
Dialogue: 0,0:18:15.52,0:18:17.23,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:18:38.12,0:18:39.50,Default,,0,0,0,,Құбыжық!
Dialogue: 0,0:18:40.25,0:18:43.13,Default,,0,0,0,,Дау-дамай шығармаңыз, бұл қарапайым.
Dialogue: 0,0:18:44.05,0:18:46.63,Default,,0,0,0,,Мен қия алмайтын ештеңе жоқ
Dialogue: 0,0:18:47.59,0:18:48.64,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:18:49.39,0:18:51.22,Default,,0,0,0,,Бұл қарапайым.
Dialogue: 0,0:18:52.72,0:18:55.60,Default,,0,0,0,,Жануарлардың санын көбейткенде
Dialogue: 0,0:18:55.68,0:18:57.94,Default,,0,0,0,,Ештеңе өзгермейді!
Dialogue: 0,0:18:58.02,0:18:59.40,Default,,0,0,0,,Ол өзгереді
Dialogue: 0,0:18:59.48,0:19:01.48,Default,,0,0,0,,Егер кесуге болмайтын ештеңе болмаса
Dialogue: 0,0:19:01.56,0:19:02.94,Default,,0,0,0,,Материалдық емес...
Dialogue: 0,0:19:03.61,0:19:05.28,Default,,0,0,0,,Мен сені өлтіремін!
Dialogue: 0,0:19:06.07,0:19:08.70,Default,,0,0,0,,Ғарыштың қоршауында өл!
Dialogue: 0,0:19:10.16,0:19:13.41,Default,,0,0,0,,Ғарыш кеңістігінде дене сұйықтықтары булануға мәжбүр болады.
Dialogue: 0,0:19:13.49,0:19:15.54,Default,,0,0,0,,Қан қайнай бастайды
Dialogue: 0,0:19:15.62,0:19:18.75,Default,,0,0,0,,Дене тіндері ыдырап, баяу өлімге әкеледі
Dialogue: 0,0:19:18.83,0:19:21.42,Default,,0,0,0,,Осы уақытқа дейін есіңізде болса.
Dialogue: 0,0:19:21.92,0:19:22.50,Default,,0,0,0,,(Керс) Тас масканың бұл сүйек инесі адам миын тесіп өтуге қауқарлы.
Dialogue: 0,0:19:23.00,0:19:24.25,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:25.30,0:19:28.72,Default,,0,0,0,,Денеңізді қатайтуды ұмытып кетіпсіз.
Dialogue: 0,0:19:33.39,0:19:34.43,Default,,0,0,0,,Не?
Dialogue: 0,0:19:38.89,0:19:40.52,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:19:42.44,0:19:44.90,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:19:54.62,0:19:57.87,Default,,0,0,0,,Бұл не... Бұл шынымен құбыжық па?
Dialogue: 0,0:19:58.37,0:19:59.71,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:19:59.79,0:20:03.54,Default,,0,0,0,,Онда мен тек сенен күшті болуым керек!
Dialogue: 0,0:20:04.29,0:20:06.80,Default,,0,0,0,,Жеңгім келеді Жеңгім келеді Жеңгім келеді
Dialogue: 0,0:20:07.55,0:20:10.30,Default,,0,0,0,,Өмірімде бірінші рет біреуді жеңгім келеді.
Dialogue: 0,0:20:10.38,0:20:14.18,Default,,0,0,0,,Мен сені жаншып, өз күшімді дәлелдеймін!
Dialogue: 0,0:20:14.26,0:20:17.72,Default,,0,0,0,,Өзіңізге!
Dialogue: 0,0:20:22.77,0:20:27.40,Default,,0,0,0,,Сен мені ішіңдегі құбыжыққа айналдырдың.
Dialogue: 0,0:20:28.61,0:20:31.40,Default,,0,0,0,,Сол құбыжық мені өлтірді.
Dialogue: 0,0:20:32.66,0:20:34.45,Default,,0,0,0,,Сен ақымақ
Dialogue: 0,0:20:37.83,0:20:39.83,Default,,0,0,0,,♪～
Dialogue: 0,0:22:03.04,0:22:05.04,Default,,0,0,0,,～♪
Dialogue: 0,0:22:12.84,0:22:16.97,Default,,0,0,0,,Мен... қиялымнан өлдім бе?
Dialogue: 0,0:22:18.39,0:22:19.72,Default,,0,0,0,,Өйткені мен тірі жеп қойылудан шын мәнінде қорқамын
Dialogue: 0,0:22:28.73,0:22:31.40,Default,,0,0,0,,Жоқ, Кенпачи Зараки
Dialogue: 0,0:22:32.11,0:22:34.90,Default,,0,0,0,,Менің қиялым дұрыс болды.
Dialogue: 0,0:22:35.53,0:22:37.49,Default,,0,0,0,,Бұл өте дұрыс
Dialogue: 0,0:22:38.11,0:22:42.54,Default,,0,0,0,,Мен сенің барлық күшіңді дұрыс елестете алдым.
Dialogue: 0,0:22:43.20,0:22:44.37,Default,,0,0,0,,Бір ғана нәрсе...
Dialogue: 0,0:22:45.04,0:22:47.21,Default,,0,0,0,,Мен елестете алмайтын нәрсе болды
Dialogue: 0,0:22:47.71,0:22:49.67,Default,,0,0,0,,Сенің күшіңе кім төтеп бере алады?
Dialogue: 0,0:22:49.75,0:22:53.38,Default,,0,0,0,,Бұл сіздің денеңіз болды.
Dialogue: 0,0:22:54.09,0:22:59.22,Default,,0,0,0,,Саған қиялым емес, тәнім жоғалды.
Dialogue: 0,0:23:00.05,0:23:02.39,Default,,0,0,0,,Жоқ, бұл ақталу.
Dialogue: 0,0:23:02.89,0:23:05.27,Default,,0,0,0,,Әй... Қарғыс атсын.
Dialogue: 0,0:23:06.43,0:23:08.35,Default,,0,0,0,,Мен жеңгім келді
Dialogue: 0,0:23:11.65,0:23:12.52,Default,,0,0,0,,Ха!
Dialogue: 0,0:23:14.40,0:23:16.53,Default,,0,0,0,,Не? Сонымен...
Dialogue: 0,0:23:17.11,0:23:18.20,Default,,0,0,0,,Мен саған айттым
Dialogue: 0,0:23:18.70,0:23:23.03,Default,,0,0,0,,Саусақ көтермей өлтіремін.
Dialogue: 0,0:23:24.08,0:23:28.37,Default,,0,0,0,,Менің бұл денем де менің қиялымның жемісі.
Dialogue: 0,0:23:29.25,0:23:34.50,Default,,0,0,0,,Айтқанымдай, мен саған бір саусақты да қойған жоқпын.
Dialogue: 0,0:23:35.00,0:23:38.42,Default,,0,0,0,,Жарайды, мен өлдім.
Dialogue: 0,0:23:39.84,0:23:44.43,Default,,0,0,0,,А... менің қиялым шегіне жетуге жақын.
Dialogue: 0,0:23:45.68,0:23:47.18,Default,,0,0,0,,Мен сені сағынамын
Dialogue: 0,0:23:47.81,0:23:51.85,Default,,0,0,0,,Ештеңені елестетуге болмайтын бұдан тыс әлем
Dialogue: 0,0:23:51.94,0:23:53.94,Default,,0,0,0,,Елестетсеңіз
Dialogue: 0,0:24:08.45,0:24:10.00,Default,,0,0,0,,Мен ток соғып жатырмын
Dialogue: 0,0:24:11.00,0:24:12.13,Default,,0,0,0,,Сіз
Dialogue: 0,0:24:12.67,0:24:14.46,Default,,0,0,0,,Мен сенің тізерлеп отырғаныңды қалаймын
Dialogue: 0,0:24:15.96,0:24:21.96,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
