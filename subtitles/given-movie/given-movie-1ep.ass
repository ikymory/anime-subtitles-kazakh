Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:11.36,0:00:15.96,Default,,0,0,0,,(Жартылайдың дауысы)
Dialogue: 0,0:00:33.55,0:00:36.22,Default,,0,0,0,,(көліктің кетіп бара жатқан дыбысы)
Dialogue: 0,0:00:36.22,0:00:38.22,Default,,0,0,0,,Ах. (Қыс ортасы) Өтелетін танысу
Dialogue: 0,0:00:38.22,0:00:40.89,Default,,0,0,0,,Жоқ, жоқ, ол адамның дәмі нашар!
Dialogue: 0,0:00:40.89,0:00:45.73,Default,,0,0,0,,((Харуки: Акихико? Бұл өте дөрекі болды.
Dialogue: 0,0:00:45.73,0:00:48.40,Default,,0,0,0,,Қазір әлдеқайда дөңгелек емес пе? ))
Dialogue: 0,0:00:48.40,0:00:52.23,Default,,0,0,0,,Эй, бұл оң жақ.
Dialogue: 0,0:00:52.23,0:00:55.24,Default,,0,0,0,,Каджи мырза. О?
Dialogue: 0,0:00:55.24,0:00:57.57,Default,,0,0,0,,Бүктелген емес
Dialogue: 0,0:00:57.57,0:01:01.27,Default,,0,0,0,,Тек оны Харуки-санның және басқалардың алдында көрсетпе.
Dialogue: 0,0:01:03.25,0:01:05.25,Default,,0,0,0,,ﾌｯ…
Dialogue: 0,0:01:07.25,0:01:10.85,Default,,0,0,0,,Бірақ ол музыкалық жауынгер ретінде жаттықтығысы келетінін айтты.
Dialogue: 0,0:01:10.85,0:01:13.45,Default,,0,0,0,,Концертке менің артымнан келеді деп ешқашан күтпедім.
Dialogue: 0,0:01:19.70,0:01:21.86,Default,,0,0,0,,(Дыбыс баптау)
Dialogue: 0,0:01:21.86,0:01:24.70,Default,,0,0,0,,Билетіңіз үшін рахмет
Dialogue: 0,0:01:24.70,0:01:27.70,Default,,0,0,0,,Бұл шын мәнінде менің кінәм емес.
Dialogue: 0,0:01:27.70,0:01:29.87,Default,,0,0,0,,Иә? Ол жігіт
Dialogue: 0,0:01:29.87,0:01:31.87,Default,,0,0,0,,Мен хат жібергім келеді…
Dialogue: 0,0:01:31.87,0:01:34.38,Default,,0,0,0,,Себебі сен маған ұнайсың
Dialogue: 0,0:01:34.38,0:01:38.71,Default,,0,0,0,,《Қыс ортасы: Мен ол адамды көрдім》
Dialogue: 0,0:01:38.71,0:01:42.51,Default,,0,0,0,,Көрдіңіз бе, менің басым әлі де иіссіз...
Dialogue: 0,0:01:51.56,0:01:53.56,Default,,0,0,0,,♪ 『Чайковский: скрипка концерті 1-қозғалысы』
Dialogue: 0,0:01:53.56,0:02:24.53,Default,,0,0,0,,♪～
Dialogue: 0,0:02:24.53,0:02:28.20,Default,,0,0,0,,Тек сол скрипкашы.
Dialogue: 0,0:02:28.20,0:02:31.40,Default,,0,0,0,,Кім басқаларға ұқсамайды?
Dialogue: 0,0:02:33.37,0:02:36.87,Default,,0,0,0,,Бұл скрипкаға арналған концерт.
Dialogue: 0,0:02:36.87,0:02:38.87,Default,,0,0,0,,♪(Угецу скрипкасыз)
Dialogue: 0,0:02:38.87,0:02:48.05,Default,,0,0,0,,♪～
Dialogue: 0,0:02:48.05,0:02:50.05,Default,,0,0,0,,《Акихико: Угетсу
Dialogue: 0,0:02:50.05,0:02:53.45,Default,,0,0,0,,Ол мен кездескен бірінші данышпан болды.
Dialogue: 0,0:02:59.23,0:03:02.23,Default,,0,0,0,,<Акихико: Зорлық-зомбылық дәрежесіне дейін талантты>
Dialogue: 0,0:03:04.40,0:03:06.40,Default,,0,0,0,,＜ бір кездері әлі сол уақытта
Dialogue: 0,0:03:06.40,0:03:11.67,Default,,0,0,0,,Менің музыкамда арман мен сенім сияқты нәрсе бар.
Dialogue: 0,0:03:11.67,0:03:13.68,Default,,0,0,0,,Бірақ бұл
Dialogue: 0,0:03:13.68,0:03:16.85,Default,,0,0,0,,Мен Угетсумен кездескен күні сөйледім.
Dialogue: 0,0:03:16.85,0:03:21.85,Default,,0,0,0,,Сол күннен бастап мен бұл адамды жек көремін.
Dialogue: 0,0:03:21.85,0:03:35.85,Default,,0,0,0,,♪～
Dialogue: 0,0:03:37.87,0:03:41.87,Default,,0,0,0,,Мен хат жібергім келеді…
Dialogue: 0,0:03:41.87,0:03:43.97,Default,,0,0,0,,Каджи-сан. иә?
Dialogue: 0,0:03:46.04,0:03:52.04,Default,,0,0,0,,Ән шығарғым келеді... ән...
Dialogue: 0,0:03:56.72,0:04:00.72,Default,,0,0,0,,Уау... Екінші көрсетілімнен өттім...
Dialogue: 0,0:04:00.72,0:04:03.39,Default,,0,0,0,,Орта? (Акихико) Бұл қандай іріктеу болды?
Dialogue: 0,0:04:03.39,0:04:06.06,Default,,0,0,0,,CAC жалпыға қолжетімді жазба! Аа!?
Dialogue: 0,0:04:06.06,0:04:08.06,Default,,0,0,0,,CAC дегеніміз не?
Dialogue: 0,0:04:08.06,0:04:10.67,Default,,0,0,0,,ｶｳﾝﾄﾀﾞｳﾝﾌｪｽ ｱﾏﾁｭｱ ｺﾝﾃｽﾄ！
Dialogue: 0,0:04:10.67,0:04:13.50,Default,,0,0,0,,Бізде жыл сайын жыл соңында үлкен рок-фестиваль болады.
Dialogue: 0,0:04:13.50,0:04:16.84,Default,,0,0,0,,Әуесқойларға кәсіпқойларға қосылуға арналған слот бар.
Dialogue: 0,0:04:16.84,0:04:19.17,Default,,0,0,0,,Сіз бұл үшін қашан өтініш бердіңіз?
Dialogue: 0,0:04:19.17,0:04:23.18,Default,,0,0,0,,Сәлем! Топтың атын шешкен кезде біз Entry туралы сөйлестік, солай ма?
Dialogue: 0,0:04:23.18,0:04:26.35,Default,,0,0,0,,Солай бола тұра, сен бастауыш мектепке қашан бардың?
Dialogue: 0,0:04:26.35,0:04:28.35,Default,,0,0,0,,Мен тыңдамадым. (Харуки) Мен айттым.
Dialogue: 0,0:04:28.35,0:04:30.35,Default,,0,0,0,,Құжатты тексеруден өтті
Dialogue: 0,0:04:30.35,0:04:32.35,Default,,0,0,0,,Оның қанша тапсырысы бар?
Dialogue: 0,0:04:32.35,0:04:37.03,Default,,0,0,0,,Келесі үшінші раунд соңғы болып табылады. Содан кейін тікелей көрсетілім
Dialogue: 0,0:04:37.03,0:04:39.03,Default,,0,0,0,,Тікелей Шинса
Dialogue: 0,0:04:39.03,0:04:41.03,Default,,0,0,0,,Неге сонша бақытты көрінесің!?
Dialogue: 0,0:04:41.03,0:04:43.37,Default,,0,0,0,,Мына пальтоның қаншалықты үлкен екенін білесің бе!?
Dialogue: 0,0:04:43.37,0:04:45.37,Default,,0,0,0,,Ең жақсы тұру
Dialogue: 0,0:04:45.37,0:04:49.70,Default,,0,0,0,,Мен мұны істегім келеді. Бір ғана ән бар ма?
Dialogue: 0,0:04:49.70,0:04:51.87,Default,,0,0,0,,Бірақ мен бақыттымын
Dialogue: 0,0:04:51.87,0:04:54.71,Default,,0,0,0,,Пікір Мен қуаныштымын
Dialogue: 0,0:04:54.71,0:04:56.88,Default,,0,0,0,,Сіз бақытты емессіз бе?
Dialogue: 0,0:04:56.88,0:04:59.55,Default,,0,0,0,,Шынымды айтсам. Мен сондай қуаныштымын.
Dialogue: 0,0:04:59.55,0:05:01.55,Default,,0,0,0,,Жоспар
Dialogue: 0,0:05:01.55,0:05:06.25,Default,,0,0,0,,Жақсы. Өйткені мен шынымен көрінгім келеді.
Dialogue: 0,0:05:12.66,0:05:17.33,Default,,0,0,0,,Мафую Сіз ән жазғыңыз келетінін айттыңыз. Иә.
Dialogue: 0,0:05:17.33,0:05:19.33,Default,,0,0,0,,Бірінші ән
Dialogue: 0,0:05:19.33,0:05:24.33,Default,,0,0,0,,Ән мен үшін толық болды, сондықтан келесі жолы...
Dialogue: 0,0:05:28.68,0:05:31.01,Default,,0,0,0,,Аа...｡ Жоқ, не!
Dialogue: 0,0:05:31.01,0:05:33.01,Default,,0,0,0,,Жарты жолда берілме!
Dialogue: 0,0:05:33.01,0:05:35.85,Default,,0,0,0,,Сізде міндетті түрде айтатын нәрсе бар. Сосын айт!
Dialogue: 0,0:05:35.85,0:05:37.85,Default,,0,0,0,,Келесі кездескенше. Аа!?
Dialogue: 0,0:05:39.85,0:05:43.69,Default,,0,0,0,,< Ол кісінің орындауын тыңдау арқылы мен екі нәрсені түсіндім.
Dialogue: 0,0:05:43.69,0:05:50.03,Default,,0,0,0,,Біріншісі – эмоцияны дыбыспен үндестіру тәсілі бар.
Dialogue: 0,0:05:50.03,0:05:56.71,Default,,0,0,0,,Екіншісі, Қажы-сан менімен бірдей шығар.
Dialogue: 0,0:05:56.71,0:05:59.04,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:05:59.04,0:06:01.24,Default,,0,0,0,,Акихико Инно?
Dialogue: 0,0:06:03.38,0:06:08.22,Default,,0,0,0,,Жапонияға оралғаныңызға көп уақыт болды, бірақ алдымен ұйықтап жатырсыз ба?
Dialogue: 0,0:06:08.22,0:06:12.82,Default,,0,0,0,,Эй, Чиконың концерті қалай болды?
Dialogue: 0,0:06:12.82,0:06:14.99,Default,,0,0,0,,Акихико
Dialogue: 0,0:06:14.99,0:06:17.49,Default,,0,0,0,,Жақсы болғаны сонша, өліп қала жаздадым, солай емес пе?
Dialogue: 0,0:06:22.16,0:06:24.16,Default,,0,0,0,,Аки...!
Dialogue: 0,0:06:27.84,0:06:32.17,Default,,0,0,0,,Ия... Ия. Ах~
Dialogue: 0,0:06:32.17,0:06:36.34,Default,,0,0,0,,Бүгін не істеу керек? Ерекше
Dialogue: 0,0:06:36.34,0:06:40.35,Default,,0,0,0,,Акихико неге үйренбейді деп ойлаймын.
Dialogue: 0,0:06:40.35,0:06:42.35,Default,,0,0,0,,<Кадзи-сан да шығар
Dialogue: 0,0:06:42.35,0:06:46.02,Default,,0,0,0,,Қайталанбайтын адамға ғашық болу
Dialogue: 0,0:06:46.02,0:06:48.52,Default,,0,0,0,,Менің жүрегім ауырды＞
Dialogue: 0,0:06:51.03,0:06:57.20,Default,,0,0,0,,(ﾁｬｲﾑ)
Dialogue: 0,0:06:57.20,0:07:00.37,Default,,0,0,0,,Акихико~? Тұтынушы~
Dialogue: 0,0:07:00.37,0:07:03.04,Default,,0,0,0,,Акихико! (команда)
Dialogue: 0,0:07:03.04,0:07:05.54,Default,,0,0,0,,Ах~ 1 минут қалды...
Dialogue: 0,0:07:05.54,0:07:08.54,Default,,0,0,0,,Жоқ, қазір кетпесең, үйге барасың.
Dialogue: 0,0:07:08.54,0:07:12.48,Default,,0,0,0,,Қайсысы…｡ Ах.
Dialogue: 0,0:07:12.48,0:07:14.88,Default,,0,0,0,,Ах! Бұл Утаның баласы!
Dialogue: 0,0:07:16.82,0:07:27.16,Default,,0,0,0,,(Дыбыс баптау)
Dialogue: 0,0:07:27.16,0:07:30.50,Default,,0,0,0,,Бұл қандай диаграмма?
Dialogue: 0,0:07:30.50,0:07:32.50,Default,,0,0,0,,♪(ｷﾞﾀｰ)
Dialogue: 0,0:07:32.50,0:07:48.18,Default,,0,0,0,,♪～
Dialogue: 0,0:07:48.18,0:07:50.18,Default,,0,0,0,,Иә, мүлде емес
Dialogue: 0,0:07:52.19,0:07:55.86,Default,,0,0,0,,Хордың соңғы 6 жолының дамуы шығар
Dialogue: 0,0:07:55.86,0:07:58.69,Default,,0,0,0,,♪“Лара~ Лала~ Лала~” дыбысы
Dialogue: 0,0:07:58.69,0:08:02.70,Default,,0,0,0,,Менің ойымша, ол адасып, осында қоныстанды ...
Dialogue: 0,0:08:02.70,0:08:07.87,Default,,0,0,0,,♪"Лара~ Лала~ Лала~" дегені солай емес пе?
Dialogue: 0,0:08:07.87,0:08:11.17,Default,,0,0,0,,Өйткені бұл сенің ән айтқың келген сезімдер, солай ма?
Dialogue: 0,0:08:15.31,0:08:17.98,Default,,0,0,0,,Қыс ортасы Бұл жаңа ән бе?
Dialogue: 0,0:08:17.98,0:08:20.98,Default,,0,0,0,,Иә. Бұл мен әлі аяқтамаған жалғыз бөлік.
Dialogue: 0,0:08:20.98,0:08:22.98,Default,,0,0,0,,А, түсіндім, түсіндім.
Dialogue: 0,0:08:22.98,0:08:25.49,Default,,0,0,0,,Эй, мен Харукиге уәде бердім.
Dialogue: 0,0:08:25.49,0:08:28.16,Default,,0,0,0,,Угетсумен дұрыс қарым-қатынас жасау
Dialogue: 0,0:08:28.16,0:08:30.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:30.16,0:08:33.83,Default,,0,0,0,,Иә! Оны осылай жалғыз қалдыру дұрыс па?
Dialogue: 0,0:08:33.83,0:08:36.33,Default,,0,0,0,,О~｡ Сәлем! Айтайын дегенім, Акихико
Dialogue: 0,0:08:36.33,0:08:39.00,Default,,0,0,0,,Сіздің бөлмеде тұратын адамыңыз бар ма!? Иә.
Dialogue: 0,0:08:39.00,0:08:42.67,Default,,0,0,0,,Жоқ, бірақ қыстың ортасында оның қаншалықты ұзақ өсетіні қорқынышты.
Dialogue: 0,0:08:42.67,0:08:45.34,Default,,0,0,0,,Осы уақытқа дейін ішімде басылған нәрселер
Dialogue: 0,0:08:45.34,0:08:48.84,Default,,0,0,0,,Бостандыққа шыққандықтан шығар, жарылып жатыр.
Dialogue: 0,0:08:48.84,0:08:50.85,Default,,0,0,0,,《Харуки: Не... бөлмелес...》
Dialogue: 0,0:08:50.85,0:08:53.01,Default,,0,0,0,,Ешбір қолдаусыз шабуылға шығуым жеткілікті.
Dialogue: 0,0:08:53.01,0:08:55.68,Default,,0,0,0,,Ол жынды болып кеткен шығар.
Dialogue: 0,0:08:55.68,0:08:59.35,Default,,0,0,0,,Данышпан осындай болса, оның көзқарас өрісі осындай болады.
Dialogue: 0,0:08:59.35,0:09:01.36,Default,,0,0,0,,《Харуки: үйдегі дос...》
Dialogue: 0,0:09:01.36,0:09:04.86,Default,,0,0,0,,Уенояма да~. Ол қосымша сабақтар алады.
Dialogue: 0,0:09:04.86,0:09:07.53,Default,,0,0,0,,Тек екі пән, солай ма? А~ түсіндім!
Dialogue: 0,0:09:07.53,0:09:11.63,Default,,0,0,0,,Егер сіз сол орта мектепте сыныптың ортасында болсаңыз, сіз әлдеқашан ақылдысыз!?
Dialogue: 0,0:09:11.63,0:09:14.80,Default,,0,0,0,,Ол да данышпан.
Dialogue: 0,0:09:14.80,0:09:16.80,Default,,0,0,0,,Мәселе мынада.
Dialogue: 0,0:09:19.64,0:09:21.64,Default,,0,0,0,,Акихико Хаса
Dialogue: 0,0:09:21.64,0:09:24.15,Default,,0,0,0,,Қалай айту керек Мүмкін солай шығар, бірақ басқаша.
Dialogue: 0,0:09:24.15,0:09:28.65,Default,,0,0,0,,Негізі мен скрипкада өте жақсымын, өйткені мен колледжде оқып жүргенмін.
Dialogue: 0,0:09:28.65,0:09:31.49,Default,,0,0,0,,Шынымды айтсам, сіз гитарада да, баста да ойнай аласыз, солай ма?
Dialogue: 0,0:09:31.49,0:09:35.32,Default,,0,0,0,,Бірақ ол қандай данышпан.
Dialogue: 0,0:09:35.32,0:09:37.33,Default,,0,0,0,,Өзіңізді нашар сезіндіңіз бе?
Dialogue: 0,0:09:37.33,0:09:39.49,Default,,0,0,0,,Әй, Дис? Жоқ!
Dialogue: 0,0:09:39.49,0:09:42.66,Default,,0,0,0,,Кедей және епті болу қандай керемет!
Dialogue: 0,0:09:42.66,0:09:46.67,Default,,0,0,0,,Мен қарапайым адаммын!
Dialogue: 0,0:09:46.67,0:09:52.17,Default,,0,0,0,,Бірақ бұл кейде ауыртпалық емес пе?
Dialogue: 0,0:09:55.51,0:09:58.18,Default,,0,0,0,,Сіз делдал ұясындасыз. иә?
Dialogue: 0,0:09:58.18,0:10:00.98,Default,,0,0,0,,Кез келген адам сұрайды
Dialogue: 0,0:10:03.35,0:10:06.35,Default,,0,0,0,,Га. иә? не?
Dialogue: 0,0:10:06.35,0:10:10.86,Default,,0,0,0,,Жоқ.Мен саған айтамын, сен мен ойлағаннан да танымал боласың.
Dialogue: 0,0:10:10.86,0:10:15.03,Default,,0,0,0,,Негізі мен ешқандай демографиялық танымал емеспін!?
Dialogue: 0,0:10:15.03,0:10:19.87,Default,,0,0,0,,Хмм. Ештеңе.
Dialogue: 0,0:10:19.87,0:10:24.37,Default,,0,0,0,,Угэ... Цусан мен Кадзи-сан...
Dialogue: 0,0:10:24.37,0:10:26.54,Default,,0,0,0,,А, ұйықтап жатырсың ба?
Dialogue: 0,0:10:26.54,0:10:29.21,Default,,0,0,0,,Техникалық тұрғыдан алғанда, біз енді кездесіп жатқан жоқпыз.
Dialogue: 0,0:10:29.21,0:10:32.21,Default,,0,0,0,,А...
Dialogue: 0,0:10:32.21,0:10:35.55,Default,,0,0,0,,Мен Акихикомен орта мектепте таныстым
Dialogue: 0,0:10:35.55,0:10:39.55,Default,,0,0,0,,Менің алғашқы махаббатым өте қызық болды
Dialogue: 0,0:10:43.89,0:10:48.40,Default,,0,0,0,,Еріншек болып кеткенім сонша.
Dialogue: 0,0:10:48.40,0:10:57.07,Default,,0,0,0,,♪～
Dialogue: 0,0:10:57.07,0:10:59.07,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:11:01.91,0:11:04.41,Default,,0,0,0,,Сіз орта мектепті бітірген кезде
Dialogue: 0,0:11:04.41,0:11:07.92,Default,,0,0,0,,Орындаушы ретінде мансабымды бастайтын кез келді
Dialogue: 0,0:11:07.92,0:11:11.02,Default,,0,0,0,,Кенет бір-бірінің қатысуы
Dialogue: 0,0:11:11.02,0:11:15.69,Default,,0,0,0,,Мен бұл дүниеде бәрінен де бір-бірімізді итермелейтінімізді түсіндім.
Dialogue: 0,0:11:15.69,0:11:17.69,Default,,0,0,0,,Мен хат жібергім келеді…
Dialogue: 0,0:11:17.69,0:11:20.36,Default,,0,0,0,,((Акихико｡ Иә.
Dialogue: 0,0:11:20.36,0:11:22.96,Default,,0,0,0,,Қойайық))
Dialogue: 0,0:11:29.87,0:11:32.21,Default,,0,0,0,,Акихико сонда болғанда
Dialogue: 0,0:11:32.21,0:11:36.04,Default,,0,0,0,,Мен енді музыкамен еркін бола алмаймын.
Dialogue: 0,0:11:36.04,0:11:39.05,Default,,0,0,0,,Менің бар болуым негізі
Dialogue: 0,0:11:39.05,0:11:41.72,Default,,0,0,0,,Өйткені бұл Акихико үшін ауыр болды
Dialogue: 0,0:11:41.72,0:11:44.72,Default,,0,0,0,,-дан белгілі болғандай
Dialogue: 0,0:11:44.72,0:11:47.89,Default,,0,0,0,,Екі жылдай жігітім екеуміз ояндық.
Dialogue: 0,0:11:47.89,0:11:51.23,Default,,0,0,0,,Сонымен біз әлі біргеміз.
Dialogue: 0,0:11:51.23,0:11:53.56,Default,,0,0,0,,Неліктен бұл?
Dialogue: 0,0:11:53.56,0:11:56.06,Default,,0,0,0,,Маған бірдеңе айттыңыз ба?
Dialogue: 0,0:11:56.06,0:12:00.40,Default,,0,0,0,,Хахаха! Себебі менің достарым жоқ!
Dialogue: 0,0:12:00.40,0:12:04.24,Default,,0,0,0,,Мүмкін сіз біреудің түсінгенін қалаған боларсыз.
Dialogue: 0,0:12:04.24,0:12:07.41,Default,,0,0,0,,Аз ғана болса жеткілікті
Dialogue: 0,0:12:07.41,0:12:10.85,Default,,0,0,0,,Бетімді көп көрсетпеймін.
Dialogue: 0,0:12:10.85,0:12:15.85,Default,,0,0,0,,Акихико мені ең сұмдық деп жек көретін шығар.
Dialogue: 0,0:12:15.85,0:12:18.52,Default,,0,0,0,,Мен Акихиконы өлердей жақсы көремін
Dialogue: 0,0:12:18.52,0:12:22.52,Default,,0,0,0,,Мені жалғыз қалдыршы, мен сені мүлдем тастап кете алмадым.
Dialogue: 0,0:12:22.52,0:12:25.03,Default,,0,0,0,,Мүмкіндік болған сайын оны лақтырып тастауға тырысамын
Dialogue: 0,0:12:25.03,0:12:27.70,Default,,0,0,0,,Өйткені ол әлі жұмыс істемейді
Dialogue: 0,0:12:27.70,0:12:29.70,Default,,0,0,0,,Мен әрқашан болдым
Dialogue: 0,0:12:29.70,0:12:33.37,Default,,0,0,0,,Мені тастап кететініңді күтемін.
Dialogue: 0,0:12:33.37,0:12:36.87,Default,,0,0,0,,Міне, сондықтан мен де сонда боламын.
Dialogue: 0,0:12:36.87,0:12:40.54,Default,,0,0,0,,Ол дыбыс өткізбейді, сондықтан бөлмені қалауыңызша пайдалана аласыз.
Dialogue: 0,0:12:40.54,0:12:46.71,Default,,0,0,0,,Менің айтқаным сізге ұнаса, оны жаңа әніңізге сілтеме ретінде пайдалануға болады.
Dialogue: 0,0:12:46.71,0:12:49.41,Default,,0,0,0,,(есіктің ашылу және жабылу дыбысы)
Dialogue: 0,0:12:53.55,0:12:57.06,Default,,0,0,0,,<Бірге өмір сүре бастағаннан кейін көп ұзамай
Dialogue: 0,0:12:57.06,0:13:01.56,Default,,0,0,0,,Сіз сыйлықты бірінші рет алған кезде
Dialogue: 0,0:13:01.56,0:13:04.57,Default,,0,0,0,,Неге екені белгісіз, бұл маған ұнамайды.
Dialogue: 0,0:13:04.57,0:13:07.07,Default,,0,0,0,,Мен біреуді қажет етпегендіктен бас тарттым.
Dialogue: 0,0:13:10.00,0:13:14.01,Default,,0,0,0,,<Бұл жай ғана саптыаяқ болса да.
Dialogue: 0,0:13:14.01,0:13:18.35,Default,,0,0,0,,Сол кезде мен бақыттымын деп айтуым керек еді.
Dialogue: 0,0:13:18.35,0:13:20.35,Default,,0,0,0,,Мен сенің жаныңда болғым келеді
Dialogue: 0,0:13:20.35,0:13:23.85,Default,,0,0,0,,Мен сенің жаныңда болғым келеді. Мен сенің жаныңда болғым келеді.
Dialogue: 0,0:13:23.85,0:13:28.45,Default,,0,0,0,,Сонда да мен музыканы жақсы көремін＞
Dialogue: 0,0:13:34.70,0:13:36.70,Default,,0,0,0,,＜ Алайда,
Dialogue: 0,0:13:36.70,0:13:40.37,Default,,0,0,0,,Енді мұндай ештеңе болмайды＞
Dialogue: 0,0:13:40.37,0:13:45.47,Default,,0,0,0,,Ол шынымен жақсы жігіт.
Dialogue: 0,0:13:53.71,0:13:55.72,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:13:55.72,0:14:00.39,Default,,0,0,0,,Не айтасыз, мен бүгін басқа топпен сусын ішемін...
Dialogue: 0,0:14:00.39,0:14:02.72,Default,,0,0,0,,Иә!? Сіз бармайсыз деп не айтасыз?
Dialogue: 0,0:14:02.72,0:14:04.89,Default,,0,0,0,,Сондықтан менің көңіл-күйім нашар
Dialogue: 0,0:14:04.89,0:14:06.89,Default,,0,0,0,,Бүгін жоқ. Мен көремін...
Dialogue: 0,0:14:06.89,0:14:09.33,Default,,0,0,0,,Хмм. (Акихико)
Dialogue: 0,0:14:09.33,0:14:12.83,Default,,0,0,0,,(Дыбыссыз дыбыс)
Dialogue: 0,0:14:12.83,0:14:16.34,Default,,0,0,0,,《Қазір...әйел.
Dialogue: 0,0:14:16.34,0:14:19.34,Default,,0,0,0,,Бұл мүлдем ақылсыз болды》
Dialogue: 0,0:14:19.34,0:14:22.84,Default,,0,0,0,,≪Уау, бұл дәмді көрінеді. ≪Қайсысы?
Dialogue: 0,0:14:22.84,0:14:25.85,Default,,0,0,0,,Бірдеңе болды ма? Ах ха ха...
Dialogue: 0,0:14:25.85,0:14:30.52,Default,,0,0,0,,Акихико соңғы бірнеше күн бойы тығырыққа тірелді...
Dialogue: 0,0:14:30.52,0:14:33.19,Default,,0,0,0,,Сонымен, Хару-чан, сен шаршадың ба?
Dialogue: 0,0:14:33.19,0:14:36.19,Default,,0,0,0,,Ол жігітті жалғыз қалдыру керек.
Dialogue: 0,0:14:36.19,0:14:39.19,Default,,0,0,0,,Жоқ... Иә... Иә...
Dialogue: 0,0:14:41.70,0:14:43.70,Default,,0,0,0,,Сәлем. иә?
Dialogue: 0,0:14:43.70,0:14:47.37,Default,,0,0,0,,Неліктен дем алу үшін басқа топпен бассты ойнап көрмеске?
Dialogue: 0,0:14:47.37,0:14:49.37,Default,,0,0,0,,Тіректе
Dialogue: 0,0:14:49.37,0:14:51.87,Default,,0,0,0,,Не? Таке-чан екеуің қайдасыңдар?
Dialogue: 0,0:14:51.87,0:14:55.38,Default,,0,0,0,,Жоқ. Аа, сіздің бұрынғы қызыңыз.
Dialogue: 0,0:14:55.38,0:14:57.38,Default,,0,0,0,,Бұрынғы жігіт... жоқ, жоқ!
Dialogue: 0,0:14:57.38,0:15:00.21,Default,,0,0,0,,Сен болсаң, жарайды ма деп ойлаймын.
Dialogue: 0,0:15:00.21,0:15:04.22,Default,,0,0,0,,Жарайды...! Сенімен бәрі жақсы ма?
Dialogue: 0,0:15:04.22,0:15:07.56,Default,,0,0,0,,Соңғы уақытта тығылып қалдыңыз ба?
Dialogue: 0,0:15:07.56,0:15:10.16,Default,,0,0,0,,Қазір музыкадан ләззат аласыз ба?
Dialogue: 0,0:15:10.16,0:15:14.66,Default,,0,0,0,,Көңілді болыңыз... жасайсыз...
Dialogue: 0,0:15:14.66,0:15:19.66,Default,,0,0,0,,<Харуки: Бірақ бұл одан да ауыр>
Dialogue: 0,0:15:22.34,0:15:24.51,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:15:24.51,0:15:27.68,Default,,0,0,0,,Бұл екеуің ғанасыңдар ма? Ал Акихико ше?
Dialogue: 0,0:15:27.68,0:15:30.34,Default,,0,0,0,,Университет міндеттемелеріне байланысты келе алмаймын.
Dialogue: 0,0:15:30.34,0:15:33.01,Default,,0,0,0,,《Бұл шынымен университет пе...》
Dialogue: 0,0:15:33.01,0:15:37.18,Default,,0,0,0,,Бүгінгі күн баптаудан гөрі жаңа әндер туралы кеңесу сияқты болды.
Dialogue: 0,0:15:37.18,0:15:41.02,Default,,0,0,0,,Алдымен тыңдай аласыз ба? (Харуки) Иә?
Dialogue: 0,0:15:41.02,0:15:43.02,Default,,0,0,0,,Ал, кеттік.
Dialogue: 0,0:15:43.02,0:15:45.03,Default,,0,0,0,,１ ２ ３ ４
Dialogue: 0,0:15:45.03,0:15:52.87,Default,,0,0,0,,♪～
Dialogue: 0,0:15:52.87,0:15:58.54,Default,,0,0,0,,♪"Бүгінгі гарнир ~ Удон паста ~"
Dialogue: 0,0:15:58.54,0:16:01.88,Default,,0,0,0,,Әй, әннің мәтіні жарасады. Жақсы!
Dialogue: 0,0:16:01.88,0:16:04.21,Default,,0,0,0,,♪～
Dialogue: 0,0:16:04.21,0:16:07.05,Default,,0,0,0,,Бұл жерде барабан толтырылса жақсы болар еді.
Dialogue: 0,0:16:07.05,0:16:09.05,Default,,0,0,0,,♪～
Dialogue: 0,0:16:09.05,0:16:12.32,Default,,0,0,0,,Міне, мен Харуки-санмен кеңескім келді.
Dialogue: 0,0:16:12.32,0:16:14.32,Default,,0,0,0,,《Тоқта, күт.
Dialogue: 0,0:16:14.32,0:16:16.99,Default,,0,0,0,,Қыс ортасы Мен музыканы шынымен түсіне бастадым.
Dialogue: 0,0:16:16.99,0:16:19.99,Default,,0,0,0,,Бізде жәшіктер қашан көп болды!?》
Dialogue: 0,0:16:19.99,0:16:22.16,Default,,0,0,0,,Ән мәтіні әлі жоқ.
Dialogue: 0,0:16:22.16,0:16:24.67,Default,,0,0,0,,Мен бірінші бөлімге дейін ғана аяқтадым.
Dialogue: 0,0:16:24.67,0:16:28.84,Default,,0,0,0,,《Харуки: Мен оны мәтінсіз де түсінемін.
Dialogue: 0,0:16:28.84,0:16:33.34,Default,,0,0,0,,Махаббат әні. Гений
Dialogue: 0,0:16:33.34,0:16:37.18,Default,,0,0,0,,Дыбыс кеңістігінің артында 1000 музыкалық шығарманың белгілері бар.
Dialogue: 0,0:16:37.18,0:16:39.85,Default,,0,0,0,,Барынша тыңдауға тырыстым.
Dialogue: 0,0:16:39.85,0:16:44.52,Default,,0,0,0,,Біреуді данышпан деудің өзі қате.
Dialogue: 0,0:16:44.52,0:16:47.52,Default,,0,0,0,,Кейде мен оны Уеноямадан немесе қыс ортасында сезінемін.
Dialogue: 0,0:16:47.52,0:16:52.19,Default,,0,0,0,,Өзімнен басқа жаратылыс болу сезімімен байланысты бөтендік сезімі
Dialogue: 0,0:16:52.19,0:16:55.36,Default,,0,0,0,,Жоқ. Мен қандаймын!?
Dialogue: 0,0:16:55.36,0:16:58.37,Default,,0,0,0,,Неліктен біз біраз уақытқа тікелей эфирден бас тартуымыз керек?
Dialogue: 0,0:16:58.37,0:17:02.20,Default,,0,0,0,,А-а... Иә, иә, иә.
Dialogue: 0,0:17:02.20,0:17:04.20,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:17:13.65,0:17:15.65,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:26.99,0:17:28.99,Default,,0,0,0,,(есіктің ашылу және жабылу дыбысы)
Dialogue: 0,0:17:31.33,0:17:34.33,Default,,0,0,0,,Йо. Бұл не бет!?
Dialogue: 0,0:17:37.00,0:17:41.68,Default,,0,0,0,,Үйдегі құрбыммен біраз ұрысып қалдым...
Dialogue: 0,0:17:41.68,0:17:44.68,Default,,0,0,0,,Бір-бірлеріңмен ұрысып қалдыңдар ма!? Сіз тіпті бір-біріңізбен ұрысып қалдыңыз ба!?
Dialogue: 0,0:17:44.68,0:17:48.52,Default,,0,0,0,,Енді мен аман қалу үшін ұйықтап жатырмын.
Dialogue: 0,0:17:48.52,0:17:50.69,Default,,0,0,0,,Иә!? Көптен бері үйге келмедің!?
Dialogue: 0,0:17:50.69,0:17:53.52,Default,,0,0,0,,Мәңгі емес.
Dialogue: 0,0:17:53.52,0:17:58.03,Default,,0,0,0,,《Бұл ескі Акихикоға ұқсайды...》
Dialogue: 0,0:17:58.03,0:18:00.70,Default,,0,0,0,,Бүгін студияда қалай болды?
Dialogue: 0,0:18:00.70,0:18:03.36,Default,,0,0,0,,Аа, мен жаңа ән естідім.
Dialogue: 0,0:18:03.36,0:18:07.37,Default,,0,0,0,,Мен жанды музыканы әзірге тоқтатып, ән жазуға көңіл бөлгім келеді.
Dialogue: 0,0:18:07.37,0:18:10.30,Default,,0,0,0,,Олай болса, студияға барайық.
Dialogue: 0,0:18:10.30,0:18:12.97,Default,,0,0,0,,Жазда сенің де уақытың бар, солай ма?
Dialogue: 0,0:18:12.97,0:18:15.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:17.31,0:18:19.65,Default,,0,0,0,,Бірдеңе бар ма?
Dialogue: 0,0:18:19.65,0:18:24.32,Default,,0,0,0,,Е... ерекше ештеңе жоқ сияқты...
Dialogue: 0,0:18:24.32,0:18:28.12,Default,,0,0,0,,Сіз бірдеңені жасырып тұрсыз ба? Хаха
Dialogue: 0,0:18:30.16,0:18:32.99,Default,,0,0,0,,Не жасырып тұрсың? Жоқ, бұл не?
Dialogue: 0,0:18:32.99,0:18:35.33,Default,,0,0,0,,Әй, неге көңіл-күйің жоқ?
Dialogue: 0,0:18:35.33,0:18:38.93,Default,,0,0,0,,Бір нәрсе болуы керек. Ах... бірақ...
Dialogue: 0,0:18:41.50,0:18:45.01,Default,,0,0,0,,Маған айтқаныңды қаламаймын
Dialogue: 0,0:18:45.01,0:18:49.18,Default,,0,0,0,,Эй, ауырып тұр! Жарайды, айтшы
Dialogue: 0,0:18:49.18,0:18:53.01,Default,,0,0,0,,Мен топтың қолдауына қосылуға шақырылдым! Менің бұрынғы қызыма!
Dialogue: 0,0:18:53.01,0:18:55.51,Default,,0,0,0,,Бұл бәрібір сенің шаруаң емес!
Dialogue: 0,0:18:59.19,0:19:01.19,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:19:01.19,0:19:04.36,Default,,0,0,0,,Сіз барасыз ба? Бұрынғы қыз
Dialogue: 0,0:19:04.36,0:19:09.03,Default,,0,0,0,,Қиын болып бара жатыр деп лақтырасың ба? Ағымдағы топ
Dialogue: 0,0:19:09.03,0:19:12.30,Default,,0,0,0,,Бұл дұрыс емес... Мен бұл туралы айтқан жоқпын.
Dialogue: 0,0:19:12.30,0:19:15.30,Default,,0,0,0,,Сіз де!
Dialogue: 0,0:19:15.30,0:19:19.30,Default,,0,0,0,,Мені сүйсең де, қашасың.
Dialogue: 0,0:19:21.81,0:19:25.31,Default,,0,0,0,,Жоқ, не айтып тұрсың... Тоқта, неге!
Dialogue: 0,0:19:25.31,0:19:28.61,Default,,0,0,0,,Неліктен? Бұл жеткілікті
Dialogue: 0,0:19:31.65,0:19:33.65,Default,,0,0,0,,Кел, Харуки
Dialogue: 0,0:19:33.65,0:19:36.32,Default,,0,0,0,,Менің бұрынғы қызым бұл туралы бірдеңе деді.
Dialogue: 0,0:19:36.32,0:19:40.83,Default,,0,0,0,,Сіз шынымен әйелді осылай ұстадыңыз ба?
Dialogue: 0,0:19:40.83,0:19:43.33,Default,,0,0,0,,《Харуки: Бұл әзіл емес. Бұл әзіл емес!
Dialogue: 0,0:19:43.33,0:19:45.93,Default,,0,0,0,,Мен сені кездестіргенше ұстадым! 》
Dialogue: 0,0:19:50.67,0:19:52.87,Default,,0,0,0,,Акихико...!
Dialogue: 0,0:19:55.18,0:19:59.68,Default,,0,0,0,,｜｜｜｜｜Күтіңіз! Бах...!
Dialogue: 0,0:19:59.68,0:20:04.69,Default,,0,0,0,,《Акихико: Кешіріңіз, бұл жай ғана хит.》
Dialogue: 0,0:20:04.69,0:20:07.35,Default,,0,0,0,,<Акихико: Угетсу және мен
Dialogue: 0,0:20:07.35,0:20:10.52,Default,,0,0,0,,Ажырасқаннан кейін де тұрақты қақтығыстар болып тұрады.
Dialogue: 0,0:20:10.52,0:20:12.53,Default,,0,0,0,,Осы орайда
Dialogue: 0,0:20:12.53,0:20:16.53,Default,,0,0,0,,Сөздің шын мағынасында, бөлуге шақырғандай>
Dialogue: 0,0:20:18.87,0:20:21.37,Default,,0,0,0,,<Бұл маған қажет емес
Dialogue: 0,0:20:21.37,0:20:25.54,Default,,0,0,0,,Сол жігіттің дүниесінен күштеп шеттетілгендей.
Dialogue: 0,0:20:25.54,0:20:28.21,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:20:28.21,0:20:32.38,Default,,0,0,0,,Керек болмаса, өкінішімді неге кешіресің?
Dialogue: 0,0:20:32.38,0:20:34.55,Default,,0,0,0,,Өкінішімді түсінсең
Dialogue: 0,0:20:34.55,0:20:37.55,Default,,0,0,0,,Неге мені тастап кетейін деп жатырсың?
Dialogue: 0,0:20:37.55,0:20:39.55,Default,,0,0,0,,Мен оны ұстағым келеді
Dialogue: 0,0:20:39.55,0:20:41.56,Default,,0,0,0,,Мен қашып кеткім келеді
Dialogue: 0,0:20:41.56,0:20:43.56,Default,,0,0,0,,Мен бас тартқым келеді
Dialogue: 0,0:20:43.56,0:20:45.56,Default,,0,0,0,,Мен бас тарта алмаймын
Dialogue: 0,0:20:45.56,0:20:47.73,Default,,0,0,0,,Мен оған қол тигізгім келеді
Dialogue: 0,0:20:47.73,0:20:49.93,Default,,0,0,0,,Ауырсыну>
Dialogue: 0,0:20:53.57,0:20:55.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:55.57,0:20:58.57,Default,,0,0,0,,Акихико…
Dialogue: 0,0:20:58.57,0:21:03.47,Default,,0,0,0,,Га. Бұл не? Тоқта.
Dialogue: 0,0:21:06.75,0:21:09.85,Default,,0,0,0,,Бұл бетті жасамаңыз
Dialogue: 0,0:21:09.85,0:21:12.52,Default,,0,0,0,,Қайғылы көрінбе
Dialogue: 0,0:21:12.52,0:21:16.02,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:21:16.02,0:21:19.02,Default,,0,0,0,,Мен сен үшін бәрін жасаймын
Dialogue: 0,0:21:22.53,0:21:26.23,Default,,0,0,0,,Айтсам да ештеңе болмайды
Dialogue: 0,0:21:29.87,0:21:32.54,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:21:32.54,0:21:37.71,Default,,0,0,0,,<Акихико: Неге сен емес?>
Dialogue: 0,0:21:37.71,0:21:39.71,Default,,0,0,0,,(су тамшылары құлаған дыбыс)
Dialogue: 0,0:21:42.38,0:21:44.55,Default,,0,0,0,,Окабе?
Dialogue: 0,0:21:44.55,0:21:48.75,Default,,0,0,0,,Шынымды айтсам, барлығына мен кінәлімін.
Dialogue: 0,0:21:52.23,0:21:56.73,Default,,0,0,0,,Кешірім сұраған жерім бұл емес.
Dialogue: 0,0:21:56.73,0:22:01.90,Default,,0,0,0,,Мен бәрін істеймін дедім, ақыры тыныштық орнайды.
Dialogue: 0,0:22:01.90,0:22:04.91,Default,,0,0,0,,Әзірше түнеуге болады.
Dialogue: 0,0:22:04.91,0:22:07.24,Default,,0,0,0,,Иә? Мен досымның үйіне барамын.
Dialogue: 0,0:22:07.24,0:22:09.68,Default,,0,0,0,,Таңертең шықшы
Dialogue: 0,0:22:09.68,0:22:13.01,Default,,0,0,0,,Бұл сіздің бөлмеңізде, оны қалауыңызша пайдалана аласыз.
Dialogue: 0,0:22:13.01,0:22:15.18,Default,,0,0,0,,Оны құлыптаудың да қажеті жоқ.
Dialogue: 0,0:22:15.18,0:22:17.52,Default,,0,0,0,,Харуки
Dialogue: 0,0:22:17.52,0:22:20.69,Default,,0,0,0,,Қолдау мәселесін тоқтатайық.
Dialogue: 0,0:22:20.69,0:22:23.89,Default,,0,0,0,,Сондықтан таңертең үйге қайт
Dialogue: 0,0:22:28.86,0:22:32.03,Default,,0,0,0,,((Акихико: Мен саған айтсам да, ештеңе болмайды.
Dialogue: 0,0:22:32.03,0:22:34.03,Default,,0,0,0,,Кешіріңіз))
Dialogue: 0,0:22:43.71,0:22:45.71,Default,,0,0,0,,ｸｿ！
Dialogue: 0,0:22:47.72,0:22:51.55,Default,,0,0,0,,《Мен Харукиге тым тәуелдімін.
Dialogue: 0,0:22:51.55,0:22:55.89,Default,,0,0,0,,Менің баратын жерім жоқ.
Dialogue: 0,0:22:55.89,0:22:58.73,Default,,0,0,0,,<Акихико: Бастау үшін, мен орта мектептің үшінші курсында оқып жүрген кезімде.
Dialogue: 0,0:22:58.73,0:23:01.40,Default,,0,0,0,,Ата-анам бөлек кеткеннен бері менің үйім жоқ.
Dialogue: 0,0:23:01.40,0:23:05.07,Default,,0,0,0,,Мен енді не болатынын ойлап жүргенімде＞
Dialogue: 0,0:23:05.07,0:23:07.07,Default,,0,0,0,,)
Dialogue: 0,0:23:09.07,0:23:13.57,Default,,0,0,0,,＜Сосын менің баратын күн шуақты үйім болды＞
Dialogue: 0,0:23:15.68,0:23:20.68,Default,,0,0,0,,<Угецумен соқтығысқанда, мен не болса да ұйықтайтын орынды бекіттім.
Dialogue: 0,0:23:20.68,0:23:25.69,Default,,0,0,0,,Мен тіпті күле алмайтын шіркін, ұсқынсыз істер жасадым.
Dialogue: 0,0:23:25.69,0:23:29.69,Default,,0,0,0,,Дегенмен, Харуки туралы бір нәрсе бар.
Dialogue: 0,0:23:29.69,0:23:33.03,Default,,0,0,0,,Мұны білгеніңді қаламадым>
Dialogue: 0,0:23:33.03,0:23:35.03,Default,,0,0,0,,Мен… (Дамиан) Хм. Тек балалар ойыны ғой.
Dialogue: 0,0:23:37.87,0:23:39.87,Default,,0,0,0,,♪(мырылдау)
Dialogue: 0,0:23:41.87,0:23:45.71,Default,,0,0,0,,(Жел дыбысы)
Dialogue: 0,0:23:45.71,0:23:48.04,Default,,0,0,0,,《Бірдеңе болды》
Dialogue: 0,0:23:53.21,0:23:55.21,Default,,0,0,0,,《Бірдеңе болды! 》
Dialogue: 0,0:23:57.22,0:23:59.55,Default,,0,0,0,,Саған не болды!?
Dialogue: 0,0:23:59.55,0:24:01.56,Default,,0,0,0,,Аюлар қорқынышты!?
Dialogue: 0,0:24:01.56,0:24:03.56,Default,,0,0,0,,Арпа шайы өте дәмді...
Dialogue: 0,0:24:03.56,0:24:05.56,Default,,0,0,0,,Не болды?
Dialogue: 0,0:24:05.56,0:24:08.06,Default,,0,0,0,,Бірдеңе болғаны анық...
Dialogue: 0,0:24:08.06,0:24:13.00,Default,,0,0,0,,Маған қайта толтырыңыз. Эй, тыңдамайсың ба?
Dialogue: 0,0:24:13.00,0:24:15.17,Default,,0,0,0,,Так-чан. иә?
Dialogue: 0,0:24:15.17,0:24:19.47,Default,,0,0,0,,Таке-чан шашын өзі қиды, солай ма?
Dialogue: 0,0:24:21.51,0:24:26.18,Default,,0,0,0,,《Мүмкін емес. Харуки қайтып келмейді.
Dialogue: 0,0:24:26.18,0:24:29.68,Default,,0,0,0,,Егер мен оны дұрыс емес жерге қойған болсам, ысырап болар деп ойлап, күттім.
Dialogue: 0,0:24:29.68,0:24:32.85,Default,,0,0,0,,Сен оны іздейсің бе? Ол аман деп үміттенемін!? Не!?
Dialogue: 0,0:24:32.85,0:24:35.19,Default,,0,0,0,,Іздеу сұрауын беруім керек пе?》
Dialogue: 0,0:24:35.19,0:24:37.19,Default,,0,0,0,,(есіктің ашылу және жабылу дыбысы)
Dialogue: 0,0:24:41.70,0:24:44.03,Default,,0,0,0,,Харуки…
Dialogue: 0,0:24:44.03,0:24:47.73,Default,,0,0,0,,Иә? Ол әлі де сонда болды.
Dialogue: 0,0:24:50.37,0:24:52.37,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:24:52.37,0:24:54.54,Default,,0,0,0,,Қайырлы таң~
Dialogue: 0,0:24:54.54,0:24:56.88,Default,,0,0,0,,Сонда... бұл шашқа не болды!?
Dialogue: 0,0:24:56.88,0:24:59.05,Default,,0,0,0,,Ыстық болды, мен оны кесіп тастадым.
Dialogue: 0,0:24:59.05,0:25:02.38,Default,,0,0,0,,((Мен сонда болдым
Dialogue: 0,0:25:02.38,0:25:04.38,Default,,0,0,0,,Кешіріңіз, бірақ көріп тұрғаныңыздай
Dialogue: 0,0:25:04.38,0:25:07.05,Default,,0,0,0,,Мен сені тастап кетуден шаршадым.
Dialogue: 0,0:25:07.05,0:25:10.45,Default,,0,0,0,,Үйге келесің бе? Эй, сәл күте тұрыңыз.
Dialogue: 0,0:25:12.66,0:25:16.16,Default,,0,0,0,,Сіз білесіз. Мен жай ғана ашуланып тұрмын.
Dialogue: 0,0:25:18.17,0:25:20.17,Default,,0,0,0,,Бұл жаман... Кешірім сұраған дұрыс.
Dialogue: 0,0:25:20.17,0:25:22.17,Default,,0,0,0,,Олар бір-біріне жабысып қалды!
Dialogue: 0,0:25:22.17,0:25:26.51,Default,,0,0,0,,Үйге қайт. Шынымды айтсам, бір-біріміз үшін.
Dialogue: 0,0:25:26.51,0:25:29.68,Default,,0,0,0,,Қайтаратын жер жоқ
Dialogue: 0,0:25:29.68,0:25:31.85,Default,,0,0,0,,Иә? Қазір шындап
Dialogue: 0,0:25:31.85,0:25:34.01,Default,,0,0,0,,Менің басқа баратын жерім жоқ.
Dialogue: 0,0:25:34.01,0:25:37.18,Default,,0,0,0,,Маған бір-екі күн тұруға рұқсат берді.
Dialogue: 0,0:25:37.18,0:25:40.69,Default,,0,0,0,,Бұл қазірдің өзінде шаршады ...
Dialogue: 0,0:25:40.69,0:25:43.02,Default,,0,0,0,,Қарсы болмасаңыз, біраз уақытқа қалдырыңыз...
Dialogue: 0,0:25:43.02,0:25:45.86,Default,,0,0,0,,Жоқ! Иә...
Dialogue: 0,0:25:45.86,0:25:51.20,Default,,0,0,0,,Мен үй жұмысын істеймін, кез келген жерде ұйықтай аламын.
Dialogue: 0,0:25:51.20,0:25:53.70,Default,,0,0,0,,Еден де жақсы. Аа!?
Dialogue: 0,0:25:53.70,0:25:55.70,Default,,0,0,0,,Енді ешқашан ештеңе жасамаңыз
Dialogue: 0,0:25:55.70,0:25:59.37,Default,,0,0,0,,Кеше мен өз шегімде болдым және ренжідім.
Dialogue: 0,0:25:59.37,0:26:03.37,Default,,0,0,0,,Нашар. Маған көмектесіңізші.
Dialogue: 0,0:26:06.05,0:26:09.65,Default,,0,0,0,,Топ мүшесі болмасаң, мен сені лақтырып жіберемін...))
Dialogue: 0,0:26:09.65,0:26:17.16,Default,,0,0,0,,♪～
Dialogue: 0,0:26:17.16,0:26:19.33,Default,,0,0,0,,Чо Чо Тоқта!
Dialogue: 0,0:26:19.33,0:26:22.00,Default,,0,0,0,,Дыбыс бүгін сәйкес келмейді...
Dialogue: 0,0:26:22.00,0:26:25.67,Default,,0,0,0,,Не? Харуки-сан, неге көңіл-күйің нашар?
Dialogue: 0,0:26:25.67,0:26:27.67,Default,,0,0,0,,《Уау! 》
Dialogue: 0,0:26:27.67,0:26:30.50,Default,,0,0,0,,Кешіріңіз. Мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:26:30.50,0:26:32.70,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:26:37.34,0:26:40.35,Default,,0,0,0,,Сәлем! Харуки! Эй!
Dialogue: 0,0:26:40.35,0:26:43.52,Default,,0,0,0,,Менің артымнан ермеңіз
Dialogue: 0,0:26:43.52,0:26:45.85,Default,,0,0,0,,<Харуки: Қайғылы
Dialogue: 0,0:26:45.85,0:26:50.02,Default,,0,0,0,,Менен басқаның бәрі жарқыраған көрінеді>
Dialogue: 0,0:26:50.02,0:26:52.03,Default,,0,0,0,,Харуки!
Dialogue: 0,0:26:52.03,0:26:54.70,Default,,0,0,0,,<Харуки: Бұл қиын.>
Dialogue: 0,0:26:54.70,0:26:56.70,Default,,0,0,0,,Эй!
Dialogue: 0,0:26:56.70,0:27:00.87,Default,,0,0,0,,<Харуки: Музыка және басқа нәрселер, мен жай ғана шарасызмын>
Dialogue: 0,0:27:00.87,0:27:03.37,Default,,0,0,0,,Бір минут күтіңіз!
Dialogue: 0,0:27:03.37,0:27:06.04,Default,,0,0,0,,Мен саған керек емеспін бе?
Dialogue: 0,0:27:06.04,0:27:09.21,Default,,0,0,0,,Мен басқалар сияқты данышпан емеспін.
Dialogue: 0,0:27:09.21,0:27:12.48,Default,,0,0,0,,Бүгін де дыбыс мүлде сәйкес келмеді!
Dialogue: 0,0:27:12.48,0:27:16.32,Default,,0,0,0,,<Мен бақытсызмын. Мен жоғалғым келеді>
Dialogue: 0,0:27:16.32,0:27:18.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:18.32,0:27:22.16,Default,,0,0,0,,Себебі сіз бүгін бойы төмен қарап ойнадыңыз.
Dialogue: 0,0:27:22.16,0:27:24.66,Default,,0,0,0,,Жоғары қозғалмасаңыз, дыбыс бұзылады.
Dialogue: 0,0:27:24.66,0:27:29.33,Default,,0,0,0,,Алға күтпесең де, Тым болмаса маған дұрыстап қара.
Dialogue: 0,0:27:29.33,0:27:32.33,Default,,0,0,0,,Топ жеке орындаушыдан ерекшеленеді.
Dialogue: 0,0:27:32.33,0:27:37.00,Default,,0,0,0,,Төртеуің данышпан болсаңдар, топта ойнай алмайсыңдар.
Dialogue: 0,0:27:37.00,0:27:40.17,Default,,0,0,0,,Бұл жігіттерді біреу қолдауы керек.
Dialogue: 0,0:27:40.17,0:27:45.17,Default,,0,0,0,,Саған керек деп көптен бері айтып жүрмін!?
Dialogue: 0,0:27:49.35,0:27:52.52,Default,,0,0,0,,Қарсы аргумент дегеніміз не? Жоқ, бірақ...
Dialogue: 0,0:27:52.52,0:27:54.86,Default,,0,0,0,,Сен неге сонша бастықсың?
Dialogue: 0,0:27:54.86,0:27:57.69,Default,,0,0,0,,Кешкі асқа не қалайсыз?
Dialogue: 0,0:27:57.69,0:28:00.53,Default,,0,0,0,,Егер өзіңізді жақсы сезінбесеңіз, мен оны сізге дайындаймын.
Dialogue: 0,0:28:00.53,0:28:02.86,Default,,0,0,0,,Мен жүкті жүктеушімін.
Dialogue: 0,0:28:02.86,0:28:05.53,Default,,0,0,0,,Оның күші жоғары...
Dialogue: 0,0:28:05.53,0:28:07.53,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:28:07.53,0:28:11.64,Default,,0,0,0,,<Харуки: Содан біртүрлі бірге өмір сүру басталды>
Dialogue: 0,0:28:11.64,0:28:19.31,Default,,0,0,0,,♪～
Dialogue: 0,0:28:19.31,0:28:23.82,Default,,0,0,0,,<Акихико мен ойлағаннан да шулы адам болды>
Dialogue: 0,0:28:23.82,0:28:32.83,Default,,0,0,0,,♪～
Dialogue: 0,0:28:32.83,0:28:36.83,Default,,0,0,0,,Соңғы уақытта бас және барабандар жақсы жұмыс істейді.
Dialogue: 0,0:28:36.83,0:28:39.50,Default,,0,0,0,,Иә? (Қыс ортасы) Бірдеңе болды ма?
Dialogue: 0,0:28:39.50,0:28:41.50,Default,,0,0,0,,Жоқ, шынымен емес!?
Dialogue: 0,0:28:41.50,0:28:46.00,Default,,0,0,0,,(велосипедтің жүгіру дыбысы)
Dialogue: 0,0:28:49.18,0:28:53.68,Default,,0,0,0,,<Акихико өзінің қолынан бәрі келеді деп ойлады.
Dialogue: 0,0:28:53.68,0:28:59.18,Default,,0,0,0,,Мен осы уақытқа дейін Акихикоға мүлде қараған емеспін.
Dialogue: 0,0:29:01.69,0:29:03.86,Default,,0,0,0,,＜ Бұл жасырын.
Dialogue: 0,0:29:03.86,0:29:07.16,Default,,0,0,0,,Мен сені шынымен де жек көре алмаймын>
Dialogue: 0,0:29:13.80,0:29:15.80,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:29:15.80,0:29:17.97,Default,,0,0,0,,Ах! (Әйнек есіктің ашылған дыбысы)
Dialogue: 0,0:29:17.97,0:29:20.64,Default,,0,0,0,,Бүгін отшашу фестивалі бар ма?
Dialogue: 0,0:29:20.64,0:29:23.98,Default,,0,0,0,,Бұл жерде сәл биік, сондықтан ол алыс, бірақ сіз оны көре аласыз.
Dialogue: 0,0:29:23.98,0:29:25.98,Default,,0,0,0,,Бұл керемет...
Dialogue: 0,0:29:25.98,0:29:28.32,Default,,0,0,0,,Акихико оны көре алмады ма?
Dialogue: 0,0:29:28.32,0:29:30.32,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:29:30.32,0:29:33.65,Default,,0,0,0,,Жартылай жер асты және дыбыс өткізбейтін болды.
Dialogue: 0,0:29:33.65,0:29:36.49,Default,,0,0,0,,Жылдың осы мезгілінде отшашу барын білмедім.
Dialogue: 0,0:29:36.49,0:29:39.83,Default,,0,0,0,,Мен бұл фактіге таң қалдым.
Dialogue: 0,0:29:39.83,0:29:42.50,Default,,0,0,0,,адаммен
Dialogue: 0,0:29:42.50,0:29:45.00,Default,,0,0,0,,Сен барып көрмедің бе?
Dialogue: 0,0:29:45.00,0:29:47.67,Default,,0,0,0,,Тек күте тұр, сен, қарғыған Деку.
Dialogue: 0,0:29:47.67,0:29:52.01,Default,,0,0,0,,Бірақ бұл өте әдемі.
Dialogue: 0,0:29:52.01,0:29:56.71,Default,,0,0,0,,(отшашулардың дыбысы)
Dialogue: 0,0:29:58.85,0:30:02.68,Default,,0,0,0,,Мен ол жігітпен біттім.
Dialogue: 0,0:30:02.68,0:30:08.19,Default,,0,0,0,,Дәлірек айтсақ, біз жай ғана доспыз және доспыз, ал шын мәнінде кездесіп жатқан жоқпыз.
Dialogue: 0,0:30:08.19,0:30:12.19,Default,,0,0,0,,Екеуміздің қарым-қатынасымыз баяғыда болды, бірақ мен әлі сол адаммын.
Dialogue: 0,0:30:12.19,0:30:15.70,Default,,0,0,0,,Жай ғана ілулі...
Dialogue: 0,0:30:15.70,0:30:17.70,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:30:17.70,0:30:20.37,Default,,0,0,0,,Маған ол адам қатты ұнайды.
Dialogue: 0,0:30:20.37,0:30:23.37,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:30:23.37,0:30:27.37,Default,,0,0,0,,Бірақ бұл қазірдің өзінде ауырады
Dialogue: 0,0:30:31.21,0:30:33.51,Default,,0,0,0,,Иә...
Dialogue: 0,0:30:35.55,0:30:40.72,Default,,0,0,0,,Эй, оны осында қалдырғаныңа рахмет.
Dialogue: 0,0:30:40.72,0:30:43.22,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:30:47.23,0:30:49.56,Default,,0,0,0,,Еңбегіңіз үшін рахмет!
Dialogue: 0,0:30:49.56,0:30:52.23,Default,,0,0,0,,Ән мәтіні Мен әлі дұрыстап алған жоқпын.
Dialogue: 0,0:30:52.23,0:30:54.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:30:54.23,0:30:57.74,Default,,0,0,0,,Алғанымды кейін жіберемін. Барлығы дыбысты тексереді.
Dialogue: 0,0:30:57.74,0:30:59.74,Default,,0,0,0,,Жарық. Иә.
Dialogue: 0,0:30:59.74,0:31:03.41,Default,,0,0,0,,Харуки, сенің осыдан кейін қандай да бір жоспарың бар ма? Жоқ бірақ
Dialogue: 0,0:31:03.41,0:31:06.91,Default,,0,0,0,,Мен сені тағы да ұрғым келеді, неге жеке тәжірибеміз жоқ?
Dialogue: 0,0:31:06.91,0:31:08.92,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:31:08.92,0:31:11.72,Default,,0,0,0,,Жоқ, қызық бола бастады.
Dialogue: 0,0:31:14.52,0:31:17.69,Default,,0,0,0,,Мүмкін бізге басқа тәсіл керек шығар?
Dialogue: 0,0:31:17.69,0:31:20.03,Default,,0,0,0,,Иә? Бұл ән мәтіні туралы.
Dialogue: 0,0:31:20.03,0:31:23.73,Default,,0,0,0,,Өйткені келесі жолы басқа ән жазғым келеді деп бұрын айтқанмын.
Dialogue: 0,0:31:25.70,0:31:29.37,Default,,0,0,0,,Ештеңе ойға мүлде келмейтін сияқты.
Dialogue: 0,0:31:29.37,0:31:32.71,Default,,0,0,0,,Дегенмен мен бірінші қадамдамын.
Dialogue: 0,0:31:32.71,0:31:36.38,Default,,0,0,0,,Менде жақсы сәйкес келетін бөлшектер жеткіліксіз сияқты...
Dialogue: 0,0:31:36.38,0:31:39.21,Default,,0,0,0,,Ал, оны неге іздеп көрмеске?
Dialogue: 0,0:31:39.21,0:31:42.88,Default,,0,0,0,,Қыс ортасы – бұл шын мәнінде менің ішімде пайда болатын сезім.
Dialogue: 0,0:31:42.88,0:31:47.89,Default,,0,0,0,,Айналаңыздағылардың ықпалы - сіздің шығармашылық қабілетіңізге нәр беретін нәрсе түрі.
Dialogue: 0,0:31:47.89,0:31:50.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:31:50.22,0:31:53.89,Default,,0,0,0,,Соңғы пойыз сияқты заттар ерте заманда жоғалып кеткен.
Dialogue: 0,0:31:53.89,0:31:56.06,Default,,0,0,0,,Оны алу босқа кетеді.
Dialogue: 0,0:31:56.06,0:32:00.90,Default,,0,0,0,,Бар болғаны жаяу жүру керек. Сізге тек жаяу жүру керек.
Dialogue: 0,0:32:00.90,0:32:05.07,Default,,0,0,0,,А... не? Осы жерден үйге? есі дұрыс па?
Dialogue: 0,0:32:05.07,0:32:07.41,Default,,0,0,0,,Егер бұл адамның аяғы болса, оған бір сағаттан астам уақыт кетеді.
Dialogue: 0,0:32:07.41,0:32:09.34,Default,,0,0,0,,Сенің есі дұрыс па? Жоқ, жоқ
Dialogue: 0,0:32:09.34,0:32:11.68,Default,,0,0,0,,Бір сағат таңқаларлық қысқа.
Dialogue: 0,0:32:11.68,0:32:16.68,Default,,0,0,0,,Сіз... сіздің идеяларыңыз 20 жастағы колледж студентінен шыққан...
Dialogue: 0,0:32:16.68,0:32:21.02,Default,,0,0,0,,Дахахаха... Эй, тоқтат.
Dialogue: 0,0:32:21.02,0:32:23.52,Default,,0,0,0,,Оны қалай таптың!?
Dialogue: 0,0:32:23.52,0:32:26.86,Default,,0,0,0,,Ол шөпте ілулі тұрды.
Dialogue: 0,0:32:26.86,0:32:30.86,Default,,0,0,0,,Оны бастапқы орнына қайтарыңыз. (Акихико) Е~
Dialogue: 0,0:32:30.86,0:32:34.37,Default,,0,0,0,,Сіз бастауыш сынып оқушысысыз ба? (Акихико) Жәндіктер римдік, солай ма?
Dialogue: 0,0:32:34.37,0:32:37.37,Default,,0,0,0,,Жарайды, мен де көп ұстайтынмын.
Dialogue: 0,0:32:37.37,0:32:40.21,Default,,0,0,0,,Онянма сияқты нәрсе. Ах...
Dialogue: 0,0:32:40.21,0:32:43.54,Default,,0,0,0,,Бірінші пойыз қазір ме? бәлкім
Dialogue: 0,0:32:43.54,0:32:46.55,Default,,0,0,0,,Өйткені сіз әрқашан айналма жолмен жүресіз!
Dialogue: 0,0:32:46.55,0:32:49.75,Default,,0,0,0,,ﾌｯ… ﾊﾊﾊﾊﾊ… ﾊﾊﾊﾊ…
Dialogue: 0,0:32:51.72,0:32:55.02,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:32:58.22,0:33:00.39,Default,,0,0,0,,Мен қазірдің өзінде терлеп жатырмын
Dialogue: 0,0:33:00.39,0:33:02.40,Default,,0,0,0,,Бір қадам да жүргім келмейді
Dialogue: 0,0:33:02.40,0:33:07.57,Default,,0,0,0,,Мен жай ғана душ қабылдаймын деп ойлаймын. Бұл тамаша.
Dialogue: 0,0:33:07.57,0:33:10.34,Default,,0,0,0,,Мен өз шегімдемін...
Dialogue: 0,0:33:10.34,0:33:14.34,Default,,0,0,0,,(жылжымалы есіктің ашылу/жабылу дыбысы)
Dialogue: 0,0:33:22.85,0:33:24.85,Default,,0,0,0,,Мен үйдемін~｡ ♪ (Скрипка)
Dialogue: 0,0:33:24.85,0:33:27.85,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:33:27.85,0:33:31.36,Default,,0,0,0,,Бұл не? Жоқ, мен ойлағаннан да көп.
Dialogue: 0,0:33:31.36,0:33:33.69,Default,,0,0,0,,Скрипканы дұрыс алып жатқаныңызға сенімдімін.
Dialogue: 0,0:33:33.69,0:33:39.03,Default,,0,0,0,,Жоқ, Гачи тобымен салыстырғанда мүлде емес. Солай ма?
Dialogue: 0,0:33:39.03,0:33:42.87,Default,,0,0,0,,Ойлап қарасам, менің университетімде атақты адам бар.
Dialogue: 0,0:33:42.87,0:33:46.37,Default,,0,0,0,,Скрипка туралы не айттыңыз...
Dialogue: 0,0:33:46.37,0:33:48.54,Default,,0,0,0,,А, Угетсу Мурата?
Dialogue: 0,0:33:48.54,0:33:50.54,Default,,0,0,0,,(Полицияның сынған дыбысы)
Dialogue: 0,0:33:50.54,0:33:53.24,Default,,0,0,0,,ﾊｧ ﾊｧ…
Dialogue: 0,0:33:56.38,0:33:58.38,Default,,0,0,0,,А...
Dialogue: 0,0:34:01.89,0:34:03.89,Default,,0,0,0,,Ах~
Dialogue: 0,0:34:03.89,0:34:07.89,Default,,0,0,0,,Мен таң қалдым. Кешіріңіз, есік ашылды.
Dialogue: 0,0:34:07.89,0:34:09.83,Default,,0,0,0,,Өйткені ол керемет дыбыс шығарды
Dialogue: 0,0:34:09.83,0:34:13.67,Default,,0,0,0,,Мен Акихико қайтып келді деп ойладым.
Dialogue: 0,0:34:13.67,0:34:16.34,Default,,0,0,0,,Аа, Каджи-сан мұнда емес пе?
Dialogue: 0,0:34:16.34,0:34:19.67,Default,,0,0,0,,Сіз Акихикоға келдіңіз бе?
Dialogue: 0,0:34:19.67,0:34:22.34,Default,,0,0,0,,Ух... Мен Угецуды көруге келдім!
Dialogue: 0,0:34:22.34,0:34:25.35,Default,,0,0,0,,Мен?
Dialogue: 0,0:34:25.35,0:34:28.18,Default,,0,0,0,,[Монитор] Өте ыстық күндер қыркүйекке дейін жалғасады.
Dialogue: 0,0:34:28.18,0:34:31.85,Default,,0,0,0,,[Монитор] Күзгі жаңбыр фронтының әсерінен Тохоку және Хокурику аудандары
Dialogue: 0,0:34:31.85,0:34:33.85,Default,,0,0,0,,Жаңбыр негізінен таңертең жауады...
Dialogue: 0,0:34:33.85,0:34:36.86,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:34:36.86,0:34:39.03,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:34:39.03,0:34:43.86,Default,,0,0,0,,《Жақында Акихико есінен танып қалған сияқты.》
Dialogue: 0,0:34:51.54,0:34:56.38,Default,,0,0,0,,Қыс ортасы! Тексеру күні ресми түрде анықталды.
Dialogue: 0,0:34:56.38,0:34:59.71,Default,,0,0,0,,Сіз оны уақытында орындаймын деп ойлайсыз ба? Иә
Dialogue: 0,0:34:59.71,0:35:02.22,Default,,0,0,0,,Мен ән мәтінін жаза алдым.
Dialogue: 0,0:35:02.22,0:35:04.88,Default,,0,0,0,,Мен бара аламын.
Dialogue: 0,0:35:04.88,0:35:12.49,Default,,0,0,0,,♪～
Dialogue: 0,0:35:12.49,0:35:15.19,Default,,0,0,0,,(Жаңбыр дыбысы)
Dialogue: 0,0:35:19.67,0:35:23.50,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:35:30.84,0:35:32.84,Default,,0,0,0,,Иә бюллетень
Dialogue: 0,0:35:36.18,0:35:38.18,Default,,0,0,0,,Бұл тікелей көрсетілім деп аталады.
Dialogue: 0,0:35:38.18,0:35:43.52,Default,,0,0,0,,Мен тыңдау сияқты бірдеңені елестеттім...
Dialogue: 0,0:35:43.52,0:35:46.19,Default,,0,0,0,,Атмосфераға мұқият қараңыз.
Dialogue: 0,0:35:46.19,0:35:49.20,Default,,0,0,0,,Ертең біз боламыз. Иә.
Dialogue: 0,0:35:49.20,0:35:51.20,Default,,0,0,0,,Отасе!
Dialogue: 0,0:35:51.20,0:35:53.53,Default,,0,0,0,,Харуки-сан. Кешіріңіз.
Dialogue: 0,0:35:53.53,0:35:55.70,Default,,0,0,0,,Сыртқа шыққанда біраз қобалжыдым.
Dialogue: 0,0:35:55.70,0:35:57.70,Default,,0,0,0,,Жақында басталады ма?
Dialogue: 0,0:35:57.70,0:36:00.71,Default,,0,0,0,,Күрсін...Сен ше, Каджи-сан?
Dialogue: 0,0:36:00.71,0:36:02.88,Default,,0,0,0,,Сіз келе алмайтыныңызға сенімдісіз бе?
Dialogue: 0,0:36:02.88,0:36:05.18,Default,,0,0,0,,Ах...｡ Иә...
Dialogue: 0,0:36:11.48,0:36:13.65,Default,,0,0,0,,♪(ｳﾞｧｲｵﾘﾝ)
Dialogue: 0,0:36:13.65,0:36:20.85,Default,,0,0,0,,♪～
Dialogue: 0,0:36:24.50,0:36:26.70,Default,,0,0,0,,Акихико
Dialogue: 0,0:36:30.50,0:36:34.34,Default,,0,0,0,,Қараңыз. Іш.
Dialogue: 0,0:36:34.34,0:36:36.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:36:40.18,0:36:44.68,Default,,0,0,0,,Білесің бе, мен осы жерден кетемін.
Dialogue: 0,0:36:47.02,0:36:51.86,Default,,0,0,0,,Мен бүгін ұзын жеңді киім әкелейін деп тоқтадым.
Dialogue: 0,0:36:51.86,0:36:57.16,Default,,0,0,0,,Ах... иә...｡ Иә, иә...
Dialogue: 0,0:36:59.53,0:37:03.54,Default,,0,0,0,,Бөлме тым лас емес пе? (Угецу) Шулы.
Dialogue: 0,0:37:03.54,0:37:06.54,Default,,0,0,0,,Алдын ала тамақ жасауым керек пе?
Dialogue: 0,0:37:06.54,0:37:08.54,Default,,0,0,0,,Сіз менің анамсыз ба?
Dialogue: 0,0:37:10.81,0:37:15.31,Default,,0,0,0,,Неліктен? Неге қазір кетіп бара жатырсың?
Dialogue: 0,0:37:17.48,0:37:20.99,Default,,0,0,0,,Соңғы кездері мен музыкадан ләззат аламын.
Dialogue: 0,0:37:20.99,0:37:26.49,Default,,0,0,0,,Мен сізге тең болу үшін скрипкамен айналысуды жалғастырдым.
Dialogue: 0,0:37:26.49,0:37:29.66,Default,,0,0,0,,Менде бар болғаны осы деп ойладым.
Dialogue: 0,0:37:29.66,0:37:32.67,Default,,0,0,0,,Өйткені сен жалғыз едің
Dialogue: 0,0:37:32.67,0:37:36.67,Default,,0,0,0,,Бірақ бұл әрқашан ауыр болды.
Dialogue: 0,0:37:36.67,0:37:42.01,Default,,0,0,0,,Мені ажырасуды сұрағанда, мен басқа нәрсеге қашып кеткім келді.
Dialogue: 0,0:37:42.01,0:37:44.84,Default,,0,0,0,,Барабандарды өзіңіз болжағандай ойнай бастағанда
Dialogue: 0,0:37:44.84,0:37:47.85,Default,,0,0,0,,Классикалық музыкадан жеңіл деп ойладым.
Dialogue: 0,0:37:47.85,0:37:50.68,Default,,0,0,0,,Музыкаға деген құштарлық та суыған.
Dialogue: 0,0:37:50.68,0:37:52.68,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:37:54.69,0:37:56.86,Default,,0,0,0,,Менің бұл жерден кеткім келеді
Dialogue: 0,0:37:56.86,0:38:00.66,Default,,0,0,0,,Мен бұл жерден кетіп, басқа музыканы көргім келеді.
Dialogue: 0,0:38:04.53,0:38:06.93,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:38:10.30,0:38:12.30,Default,,0,0,0,,Маған ұнамайды
Dialogue: 0,0:38:14.31,0:38:16.31,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:38:18.48,0:38:22.48,Default,,0,0,0,,Харуки-сан. Харуки-сан!
Dialogue: 0,0:38:22.48,0:38:26.49,Default,,0,0,0,,Мен барып, сусынның шынысын қайтарайын ба?
Dialogue: 0,0:38:26.49,0:38:29.66,Default,,0,0,0,,Ах. Аа, кешіріңіз.
Dialogue: 0,0:38:29.66,0:38:31.66,Default,,0,0,0,,Рахмет
Dialogue: 0,0:38:31.66,0:38:34.99,Default,,0,0,0,,Сізге қызық па? Каджи-сан туралы
Dialogue: 0,0:38:34.99,0:38:37.00,Default,,0,0,0,,Иә
Dialogue: 0,0:38:37.00,0:38:39.33,Default,,0,0,0,,Біз қазір бірге тұрамыз, солай ма?
Dialogue: 0,0:38:39.33,0:38:42.67,Default,,0,0,0,,Иә!? Нах... Нах, сен қаншалықты білесің...
Dialogue: 0,0:38:42.67,0:38:45.84,Default,,0,0,0,,Мен бұл туралы көп білмеймін. Аа!?
Dialogue: 0,0:38:45.84,0:38:49.51,Default,,0,0,0,,Кейде қарау қиын
Dialogue: 0,0:38:49.51,0:38:52.35,Default,,0,0,0,,Иә? Өйткені Харуки-сан
Dialogue: 0,0:38:52.35,0:38:55.45,Default,,0,0,0,,Маған Каджи-сан ұнайды, солай ма?
Dialogue: 0,0:38:57.68,0:39:01.69,Default,,0,0,0,,Мені түсіну оңай болды ма?
Dialogue: 0,0:39:01.69,0:39:06.03,Default,,0,0,0,,Әйтеуір... түсіндім.
Dialogue: 0,0:39:06.03,0:39:09.03,Default,,0,0,0,,Бірақ бәрібір
Dialogue: 0,0:39:09.03,0:39:13.47,Default,,0,0,0,,Акихикомен біраз уақыт тұрудан басқа ештеңе жоқ.
Dialogue: 0,0:39:13.47,0:39:17.30,Default,,0,0,0,,Уайымдама, мен де олай сезінбеймін.
Dialogue: 0,0:39:17.30,0:39:19.47,Default,,0,0,0,,(Рио) Бұл жай ғана кездейсоқтық, білесің бе.
Dialogue: 0,0:39:19.47,0:39:22.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:26.31,0:39:28.31,Default,,0,0,0,,＜ Дұрыс, кенеттен.
Dialogue: 0,0:39:28.31,0:39:31.11,Default,,0,0,0,,Бұл романтикалық сезімдер жойылып кеткен жоқ.＞
Dialogue: 0,0:39:33.65,0:39:36.99,Default,,0,0,0,,<Басқа адам сізден ештеңе сұрамағанда...
Dialogue: 0,0:39:36.99,0:39:39.49,Default,,0,0,0,,Шаршадым＞
Dialogue: 0,0:39:43.33,0:39:45.33,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:39:50.50,0:39:53.51,Default,,0,0,0,,Сіз не істеп жатырсыз? иә?
Dialogue: 0,0:39:53.51,0:39:57.68,Default,,0,0,0,,Сіз кілтіңізді ұмытып қалдыңыз ба? Менде бар бірақ
Dialogue: 0,0:39:57.68,0:40:01.85,Default,,0,0,0,,Бұл бетке не болды?
Dialogue: 0,0:40:01.85,0:40:04.85,Default,,0,0,0,,Харуки. Не?
Dialogue: 0,0:40:04.85,0:40:07.35,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:40:11.19,0:40:15.70,Default,,0,0,0,,Шынымды айтсам, мен әдетте ашуланамын.
Dialogue: 0,0:40:15.70,0:40:19.00,Default,,0,0,0,,Әйтеуір, үзіліс алған соң ойланып көрейін.
Dialogue: 0,0:40:22.20,0:40:24.20,Default,,0,0,0,,Иә? (Отақты қайта-қайта қосуға тырысқан дыбыс)
Dialogue: 0,0:40:24.20,0:40:28.04,Default,,0,0,0,,А, дүкенге барайық... Нуа!?
Dialogue: 0,0:40:28.04,0:40:31.54,Default,,0,0,0,,Иә? Енді барма.
Dialogue: 0,0:40:35.55,0:40:38.05,Default,,0,0,0,,Осы жерде болыңыз
Dialogue: 0,0:40:41.05,0:40:43.06,Default,,0,0,0,,Бұл керемет болды!
Dialogue: 0,0:40:43.06,0:40:47.06,Default,,0,0,0,,Әй, уау... Барлығы дәмді болды.
Dialogue: 0,0:40:49.40,0:40:53.40,Default,,0,0,0,,Не... Бұл не?
Dialogue: 0,0:40:55.40,0:40:58.07,Default,,0,0,0,,Мен не істеуім керек? Мен қобалжыдым.
Dialogue: 0,0:40:58.07,0:41:00.41,Default,,0,0,0,,Иә! Сіз қобалжыдыңыз ба?
Dialogue: 0,0:41:00.41,0:41:06.75,Default,,0,0,0,,Мен дұрыс ән айта аламын ба деп ойласам қорқамын...
Dialogue: 0,0:41:06.75,0:41:11.02,Default,,0,0,0,,Мен сізге айтқым келеді. Түсінгеніңізді қалаймын.
Dialogue: 0,0:41:11.02,0:41:14.02,Default,,0,0,0,,Ашкөздік пайда болды...
Dialogue: 0,0:41:14.02,0:41:17.22,Default,,0,0,0,,Сіз өзгердіңіз.
Dialogue: 0,0:41:19.36,0:41:23.20,Default,,0,0,0,,Алдымен сіз: «Мен топты жасай алмаймын» дедіңіз. «Мен ештеңе туралы ойламаймын».
Dialogue: 0,0:41:23.20,0:41:26.50,Default,,0,0,0,,«Мен өз ойымды жеткізе алмаймын»...
Dialogue: 0,0:41:30.20,0:41:32.50,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:41:34.54,0:41:38.21,Default,,0,0,0,,Жарайды, сен ең кереметсің.
Dialogue: 0,0:41:38.21,0:41:41.41,Default,,0,0,0,,Иә. (Рицука) Неге құрметті тіл...
Dialogue: 0,0:41:43.38,0:41:48.72,Default,,0,0,0,,♪(ﾄﾞﾗﾑ)
Dialogue: 0,0:41:48.72,0:41:52.23,Default,,0,0,0,,Рахмет. Келесі жолы негіздеңіз.
Dialogue: 0,0:41:52.23,0:41:55.56,Default,,0,0,0,,♪(ﾍﾞｰｽ)
Dialogue: 0,0:41:55.56,0:41:59.56,Default,,0,0,0,,((Неге? Скрипканы лақтыратын адам сенсің!
Dialogue: 0,0:42:02.74,0:42:06.74,Default,,0,0,0,,Жеткілікті. Шығу))
Dialogue: 0,0:42:06.74,0:42:09.08,Default,,0,0,0,,(Құлаған таяқтың дыбысы)
Dialogue: 0,0:42:09.08,0:42:11.84,Default,,0,0,0,,<Егер мен музыканы тастасам
Dialogue: 0,0:42:11.84,0:42:14.44,Default,,0,0,0,,Бәрі жақсы болады, солай ма? ＞
Dialogue: 0,0:42:18.35,0:42:21.85,Default,,0,0,0,,Қараңызшы, сіз аянышты көрінесіз.
Dialogue: 0,0:42:21.85,0:42:25.85,Default,,0,0,0,,№14 Гивун мырза, өтінемін.
Dialogue: 0,0:42:28.69,0:42:32.03,Default,,0,0,0,,<Бұрын мен жай ғана сөзімді айттым
Dialogue: 0,0:42:32.03,0:42:34.37,Default,,0,0,0,,Бұл менің қолымнан келгеннің бәрі болды＞
Dialogue: 0,0:42:34.37,0:42:37.04,Default,,0,0,0,,Иә? Қоңырау шалсын!
Dialogue: 0,0:42:37.04,0:42:39.44,Default,,0,0,0,,Сіз көп ақша жинайсыз, солай емес пе?
Dialogue: 0,0:42:41.37,0:42:43.54,Default,,0,0,0,,<Қыс ортасы: Уэнояма-кун туралы
Dialogue: 0,0:42:43.54,0:42:47.21,Default,,0,0,0,,Менің... біреудің махаббаты
Dialogue: 0,0:42:47.21,0:42:49.88,Default,,0,0,0,,Жаңа музыка
Dialogue: 0,0:42:49.88,0:42:52.98,Default,,0,0,0,,Адамдарды қалай резонансқа айналдыруға болады＞
Dialogue: 0,0:42:55.39,0:43:00.39,Default,,0,0,0,,♪ «Ұйқытай алмасам да, түн атар.»
Dialogue: 0,0:43:00.39,0:43:04.73,Default,,0,0,0,,♪«Менің қарап отырғаным осы.»
Dialogue: 0,0:43:04.73,0:43:14.17,Default,,0,0,0,,♪～
Dialogue: 0,0:43:14.17,0:43:23.02,Default,,0,0,0,,♪ «Өзгермейтін ақ қабырғада»
Dialogue: 0,0:43:23.02,0:43:25.02,Default,,0,0,0,,《Бұл не...》
Dialogue: 0,0:43:25.02,0:43:34.19,Default,,0,0,0,,♪ «Таңертеңгі күн жарқырап, сағат алға жылжиды».
Dialogue: 0,0:43:34.19,0:43:39.03,Default,,0,0,0,,《Бұл сезім...》
Dialogue: 0,0:43:39.03,0:43:46.37,Default,,0,0,0,,♪«Мен сенімен бірге тұрған сол маусымнан»
Dialogue: 0,0:43:46.37,0:43:52.04,Default,,0,0,0,,♪«Бір уақытта бір қадам, тек мен».
Dialogue: 0,0:43:52.04,0:43:58.05,Default,,0,0,0,,♪ «Бұл кетіп бара жатқан сияқты.»
Dialogue: 0,0:43:58.05,0:44:02.39,Default,,0,0,0,,♪～
Dialogue: 0,0:44:02.39,0:44:07.56,Default,,0,0,0,,♪«Түнде осылай жүзіп жүр».
Dialogue: 0,0:44:07.56,0:44:10.00,Default,,0,0,0,,Хаха шын ба?
Dialogue: 0,0:44:10.00,0:44:12.00,Default,,0,0,0,,♪«Мен ұйықтай алмасам да»
Dialogue: 0,0:44:12.00,0:44:14.00,Default,,0,0,0,,《Акихико: Керемет
Dialogue: 0,0:44:14.00,0:44:18.40,Default,,0,0,0,,Қанша уақыттан бері бұлай дірілдегенімді тоқтата алмай жүрмін.
Dialogue: 0,0:44:20.34,0:44:22.51,Default,,0,0,0,,《Акихико: Қашаннан бері...
Dialogue: 0,0:44:22.51,0:44:26.01,Default,,0,0,0,,Мен қашан музыканы жек көре бастадым?
Dialogue: 0,0:44:26.01,0:44:31.02,Default,,0,0,0,,♪«Болу»
Dialogue: 0,0:44:31.02,0:44:33.85,Default,,0,0,0,,♪«Сенсіз де»
Dialogue: 0,0:44:33.85,0:44:37.19,Default,,0,0,0,,《Акихико: Мен сені қатты жақсы көрдім
Dialogue: 0,0:44:37.19,0:44:40.19,Default,,0,0,0,,Мен Угецудың орындауын алғаш естігенде
Dialogue: 0,0:44:40.19,0:44:43.69,Default,,0,0,0,,Мен дәл қазіргідей діріл сезіндім》
Dialogue: 0,0:44:46.37,0:44:50.67,Default,,0,0,0,,《О, мен музыканы жақсы көремін》
Dialogue: 0,0:44:53.21,0:44:56.71,Default,,0,0,0,,♪«Көктемде гүлдейді»
Dialogue: 0,0:44:56.71,0:45:02.38,Default,,0,0,0,,《Угецу: А... соңғы рет тікелей эфирді көрдім.
Dialogue: 0,0:45:02.38,0:45:04.38,Default,,0,0,0,,Егер триггер болса
Dialogue: 0,0:45:04.38,0:45:07.68,Default,,0,0,0,,Мен бұл жігіттің де өзгеретінін сездім...》
Dialogue: 0,0:45:09.66,0:45:12.99,Default,,0,0,0,,《Угецу: Жауаптарды осы жерден тексересің бе?》
Dialogue: 0,0:45:12.99,0:45:14.99,Default,,0,0,0,,ﾊﾊ…
Dialogue: 0,0:45:17.00,0:45:22.50,Default,,0,0,0,,《А, иә. Бұл адам ба?》
Dialogue: 0,0:45:25.34,0:45:27.34,Default,,0,0,0,,♪«Мен білемін.»
Dialogue: 0,0:45:27.34,0:45:32.35,Default,,0,0,0,,♪ «Ұйқытай алмасам да, түн атар.»
Dialogue: 0,0:45:32.35,0:45:37.68,Default,,0,0,0,,♪«Бірге ұстаған қолдар ақырында ажырайды».
Dialogue: 0,0:45:37.68,0:45:42.69,Default,,0,0,0,,♪«Адамға батып, айқайласаң да»
Dialogue: 0,0:45:42.69,0:45:47.86,Default,,0,0,0,,♪"Ақырында жылауыңды қоясың."
Dialogue: 0,0:45:47.86,0:45:53.70,Default,,0,0,0,,♪«Мен сенсіз де өмір сүре аламын».
Dialogue: 0,0:45:53.70,0:45:59.04,Default,,0,0,0,,♪«Сен мені жақсы көрмесең де, сені көргім келеді».
Dialogue: 0,0:45:59.04,0:46:04.21,Default,,0,0,0,,♪«Міне, түн аяқталуға жақын.»
Dialogue: 0,0:46:04.21,0:46:08.91,Default,,0,0,0,,♪«Түннің атысы»
Dialogue: 0,0:46:13.82,0:46:18.66,Default,,0,0,0,,((Егер Акихико осылай қайтып келмесе...
Dialogue: 0,0:46:18.66,0:46:21.49,Default,,0,0,0,,Мен бұл туралы көп ойладым.
Dialogue: 0,0:46:21.49,0:46:25.19,Default,,0,0,0,,Қанша ойласам да, оны дұрыс бейнелей алмаймын.
Dialogue: 0,0:46:27.50,0:46:30.84,Default,,0,0,0,,Мен ертең кенеттен оралуым мүмкін.
Dialogue: 0,0:46:30.84,0:46:33.14,Default,,0,0,0,,Қайтып келер ме екен?
Dialogue: 0,0:46:35.34,0:46:42.01,Default,,0,0,0,,Бірақ мен бұл азаптың біткенін қалаймын))
Dialogue: 0,0:46:42.01,0:46:46.02,Default,,0,0,0,,♪«Қолымыз алшақ болса да, ақырында қайта қосыламыз».
Dialogue: 0,0:46:46.02,0:46:48.35,Default,,0,0,0,,((Бірақ маған бұл әлі де ұнамайды.
Dialogue: 0,0:46:48.35,0:46:53.69,Default,,0,0,0,,Бұл бөлмеде тұрып қалғанның бәрі жоғалады))
Dialogue: 0,0:46:53.69,0:46:58.36,Default,,0,0,0,,♪～
Dialogue: 0,0:46:58.36,0:47:02.37,Default,,0,0,0,,((Қызық, бірдеңе қалды ма?
Dialogue: 0,0:47:02.37,0:47:07.37,Default,,0,0,0,,Ешқашан қайта қосылмасақ та, Алыста жүрсек те
Dialogue: 0,0:47:07.37,0:47:13.65,Default,,0,0,0,,Музыка ғана қалса екен))
Dialogue: 0,0:47:13.65,0:47:17.15,Default,,0,0,0,,♪«Ендеше, бәрі жақсы».
Dialogue: 0,0:47:17.15,0:47:20.82,Default,,0,0,0,,《Қыс ортасы: Жарайды.
Dialogue: 0,0:47:20.82,0:47:24.49,Default,,0,0,0,,Кез келген жерге бара алатыныңызға сенімдімін.
Dialogue: 0,0:47:24.49,0:47:26.99,Default,,0,0,0,,♪«Түннің атысы»
Dialogue: 0,0:47:26.99,0:47:28.99,Default,,0,0,0,,《Қыс ортасы: жеткізу》
Dialogue: 0,0:47:28.99,0:47:32.00,Default,,0,0,0,,♪～
Dialogue: 0,0:47:32.00,0:47:37.84,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:47:37.84,0:47:40.51,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:47:40.51,0:47:47.35,Default,,0,0,0,,Жарайды, жарайды, Азумабито әулетінің мүшелері.
Dialogue: 0,0:47:47.35,0:47:51.52,Default,,0,0,0,,Келесі адамдар дайындалыңыз
Dialogue: 0,0:47:51.52,0:47:53.52,Default,,0,0,0,,Харуки!
Dialogue: 0,0:47:53.52,0:47:55.86,Default,,0,0,0,,Мен біреуді вокзалға апарғым келеді.
Dialogue: 0,0:47:55.86,0:47:59.19,Default,,0,0,0,,Жарайды, бірақ жақын арада келесісі басталады.
Dialogue: 0,0:47:59.19,0:48:01.99,Default,,0,0,0,,Мен жақында қайтамын.
Dialogue: 0,0:48:05.03,0:48:07.37,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:48:07.37,0:48:10.67,Default,,0,0,0,,(Тыныс алу)
Dialogue: 0,0:48:14.47,0:48:18.14,Default,,0,0,0,,ﾊｧ ﾊｧ…
Dialogue: 0,0:48:18.14,0:48:21.15,Default,,0,0,0,,Угетсу! Эй Угетсу!
Dialogue: 0,0:48:21.15,0:48:24.32,Default,,0,0,0,,Эй, тоқта! Маған ұнамайды
Dialogue: 0,0:48:24.32,0:48:26.32,Default,,0,0,0,,Иә!? Не? (Угецу) Өйткені
Dialogue: 0,0:48:26.32,0:48:29.32,Default,,0,0,0,,Тоқтаған кезде қоштасарсың, солай ма?
Dialogue: 0,0:48:29.32,0:48:31.99,Default,,0,0,0,,Барабандар жақсы болды.
Dialogue: 0,0:48:31.99,0:48:36.00,Default,,0,0,0,,Ол әдеттегідей нәзік көрінді.
Dialogue: 0,0:48:36.00,0:48:38.00,Default,,0,0,0,,Эй!
Dialogue: 0,0:48:40.00,0:48:42.00,Default,,0,0,0,,Әй, тыңда!
Dialogue: 0,0:48:44.17,0:48:48.17,Default,,0,0,0,,Маған скрипка ұнайды
Dialogue: 0,0:48:48.17,0:48:50.18,Default,,0,0,0,,Барабандар да көңілді
Dialogue: 0,0:48:50.18,0:48:54.85,Default,,0,0,0,,Менің осы уақытқа дейін скрипкаға құйғаным жалған емес.
Dialogue: 0,0:48:54.85,0:48:59.02,Default,,0,0,0,,Бұл не? Бұл қоштасу әңгімесі емес пе?
Dialogue: 0,0:48:59.02,0:49:03.69,Default,,0,0,0,,Дұрыс. Нашар.
Dialogue: 0,0:49:03.69,0:49:07.86,Default,,0,0,0,,Сені қатты ренжіткенім үшін кешір.
Dialogue: 0,0:49:07.86,0:49:09.86,Default,,0,0,0,,Рахмет
Dialogue: 0,0:49:11.80,0:49:13.80,Default,,0,0,0,,Мен сені қолдаймын.
Dialogue: 0,0:49:16.80,0:49:18.80,Default,,0,0,0,,Енді мен түсіндім, мені жіберіңізші.
Dialogue: 0,0:49:18.80,0:49:41.16,Default,,0,0,0,,♪～
Dialogue: 0,0:49:41.16,0:49:43.46,Default,,0,0,0,,)
Dialogue: 0,0:49:47.83,0:49:51.63,Default,,0,0,0,,Сау бол Акихико
Dialogue: 0,0:49:55.01,0:49:57.34,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:49:57.34,0:50:00.35,Default,,0,0,0,,Сіз қайда тұрасыз? Хмм...
Dialogue: 0,0:50:00.35,0:50:03.68,Default,,0,0,0,,Барлығы үшін рахмет
Dialogue: 0,0:50:03.68,0:50:05.85,Default,,0,0,0,,<Харуки: Осыдан кейін біз
Dialogue: 0,0:50:05.85,0:50:09.19,Default,,0,0,0,,Мен тікелей көрсетілімде сәтсіздікке ұшырауға бір қадам қалдым.
Dialogue: 0,0:50:09.19,0:50:11.52,Default,,0,0,0,,Мен өтемін деп ойламадым.
Dialogue: 0,0:50:11.52,0:50:13.69,Default,,0,0,0,,Құлап қаламын деп те ойламадым.
Dialogue: 0,0:50:13.69,0:50:16.03,Default,,0,0,0,,Менің көңілім қалды, бірақ
Dialogue: 0,0:50:16.03,0:50:19.20,Default,,0,0,0,,Маған көптеген адамдар келді.
Dialogue: 0,0:50:19.20,0:50:24.54,Default,,0,0,0,,Акихико студияға басқаларға қарағанда дайындықпен кірді.
Dialogue: 0,0:50:24.54,0:50:26.71,Default,,0,0,0,,Барлық толық емес жұмыс күндерінен шығу
Dialogue: 0,0:50:26.71,0:50:30.71,Default,,0,0,0,,Мен сені университетте жиі көремін.
Dialogue: 0,0:50:30.71,0:50:34.38,Default,,0,0,0,,Содан жаңа жыл таңы атты
Dialogue: 0,0:50:34.38,0:50:38.55,Default,,0,0,0,,Мен басқа топтың тірегі және қолғапшысы болып жұмыс істеймін.
Dialogue: 0,0:50:38.55,0:50:41.55,Default,,0,0,0,,Мен бірнеше тікелей шоу жасадым＞
Dialogue: 0,0:50:41.55,0:50:43.56,Default,,0,0,0,,Харуки!
Dialogue: 0,0:50:43.56,0:50:46.73,Default,,0,0,0,,Иә, мен саған беремін! (Харуки) Иә!? Сәлем.
Dialogue: 0,0:50:46.73,0:50:49.90,Default,,0,0,0,,Соңғы кездері біртүрлі болып жатқан жоқ па?
Dialogue: 0,0:50:49.90,0:50:52.73,Default,,0,0,0,,Иә, иә, қош келдіңіз.
Dialogue: 0,0:50:52.73,0:50:56.07,Default,,0,0,0,,<Харуки: Сосын көктем келді
Dialogue: 0,0:50:56.07,0:51:00.57,Default,,0,0,0,,Акихико скрипка сайысына қатысты.
Dialogue: 0,0:51:00.57,0:51:02.91,Default,,0,0,0,,Жүрегімнің бір жерінде
Dialogue: 0,0:51:02.91,0:51:07.08,Default,,0,0,0,,Мен Акихикода ондай лас құмарлық жоқ деп ойладым.
Dialogue: 0,0:51:07.08,0:51:12.48,Default,,0,0,0,,《Харуки: Иә? Акихико Каджи осылай болды ма? 》
Dialogue: 0,0:51:14.52,0:51:16.52,Default,,0,0,0,,Кешіріңіз. Мен сәл нашармын.
Dialogue: 0,0:51:16.52,0:51:18.52,Default,,0,0,0,,Мен алдымен үйге барамын. иә?
Dialogue: 0,0:51:22.86,0:51:25.36,Default,,0,0,0,,《Акихико өзгерді
Dialogue: 0,0:51:25.36,0:51:29.70,Default,,0,0,0,,Мен оны кім өзгерткенін білдім.
Dialogue: 0,0:51:29.70,0:51:32.20,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:32.20,0:51:35.04,Default,,0,0,0,,Акихико. Сіз!
Dialogue: 0,0:51:35.04,0:51:37.04,Default,,0,0,0,,Келетін болсаң, келемін де!
Dialogue: 0,0:51:37.04,0:51:39.04,Default,,0,0,0,,Мен оны жарты жолда байқадым да, айқайлай жаздадым!
Dialogue: 0,0:51:39.04,0:51:41.05,Default,,0,0,0,,Шынымды айтсам, мұнда неге келдің!?
Dialogue: 0,0:51:41.05,0:51:44.38,Default,,0,0,0,,Бүгін таңертең мені кенет қыстың ортасына алып кетті...
Dialogue: 0,0:51:44.38,0:51:47.89,Default,,0,0,0,,Бұл өте ұят болды! Бұл өте ұят болды!
Dialogue: 0,0:51:47.89,0:51:50.72,Default,,0,0,0,,Иә... бұл керемет болды ма?
Dialogue: 0,0:51:50.72,0:51:54.39,Default,,0,0,0,,Ду-мо! Сенімен бәрі жақсы ма!? Иә
Dialogue: 0,0:51:54.39,0:51:57.69,Default,,0,0,0,,Нәтиже қалай болды?
Dialogue: 0,0:52:01.57,0:52:04.90,Default,,0,0,0,,4 орын. Құттықтаймын ба?
Dialogue: 0,0:52:04.90,0:52:07.07,Default,,0,0,0,,Көп емес. Өте бақытты емес.
Dialogue: 0,0:52:07.07,0:52:10.47,Default,,0,0,0,,Бірақ рахмет
Dialogue: 0,0:52:12.34,0:52:17.35,Default,,0,0,0,,Угетсу екеуміз сүйген адамыммен ажырасып кеттік.
Dialogue: 0,0:52:17.35,0:52:21.85,Default,,0,0,0,,Аа...! Мен кенеттен кеткендіктен бұл анық болды.
Dialogue: 0,0:52:21.85,0:52:26.86,Default,,0,0,0,,Себебі мен ата-анама хабарласып, ақша беруін өтіндім.
Dialogue: 0,0:52:26.86,0:52:29.86,Default,,0,0,0,,Мен кенеттен өзімді скрипкаға арнай бастадым.
Dialogue: 0,0:52:29.86,0:52:33.20,Default,,0,0,0,,Себебі... Мен осы уақытқа дейін қашып келдім...
Dialogue: 0,0:52:33.20,0:52:35.70,Default,,0,0,0,,Мен қаншалықты алыс жүре алатынымды көргім келеді.
Dialogue: 0,0:52:35.70,0:52:37.70,Default,,0,0,0,,Кенет маған қарсы
Dialogue: 0,0:52:37.70,0:52:39.71,Default,,0,0,0,,Алшақ болыңыз. Бұл...
Dialogue: 0,0:52:39.71,0:52:41.71,Default,,0,0,0,,Мен білмей тұрып, тарақ өзгеріп отырады.
Dialogue: 0,0:52:41.71,0:52:43.71,Default,,0,0,0,,Әй, бұл өте шулы!
Dialogue: 0,0:52:43.71,0:52:46.71,Default,,0,0,0,,Мен! Менің өмір жолымды не өзгертті!
Dialogue: 0,0:52:46.71,0:52:50.38,Default,,0,0,0,,Себебі мен саған лайықты адам болғым келді!
Dialogue: 0,0:52:50.38,0:52:53.68,Default,,0,0,0,,А... А-а!
Dialogue: 0,0:53:00.89,0:53:03.89,Default,,0,0,0,,Уф...
Dialogue: 0,0:53:07.57,0:53:10.50,Default,,0,0,0,,Харуки
Dialogue: 0,0:53:10.50,0:53:12.50,Default,,0,0,0,,Харуки
Dialogue: 0,0:53:12.50,0:53:14.70,Default,,0,0,0,,Мен саған тиісе аламын ба?
Dialogue: 0,0:53:21.35,0:53:23.35,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:53:25.35,0:53:30.65,Default,,0,0,0,,Маған ұнайсың. Өтінемін менімен шығыңыз.
Dialogue: 0,0:58:19.14,0:58:22.31,Default,,0,0,0,,Қарғыс атсын... Мен тым ертемін...
Dialogue: 0,0:58:22.31,0:58:26.49,Default,,0,0,0,,Бұл қатал және бұл жасырын. Бұл әзіл болса да.
Dialogue: 0,0:58:26.49,0:58:29.15,Default,,0,0,0,,Мен сені тағы да ренжітуім мүмкін.
Dialogue: 0,0:58:29.15,0:58:32.49,Default,,0,0,0,,Уенояма маған ашулануы мүмкін.
Dialogue: 0,0:58:32.49,0:58:37.19,Default,,0,0,0,,Қыс ортасы әнін естігеннен бері мен өзгергім келді.
Dialogue: 0,0:58:40.67,0:58:42.67,Default,,0,0,0,,Сонымен тағы да...
Dialogue: 0,0:58:42.67,0:58:44.87,Default,,0,0,0,,Жарайды, жеткілікті. иә?
Dialogue: 0,0:58:47.17,0:58:49.17,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:58:49.17,0:58:53.51,Default,,0,0,0,,Шынайы ма? Ха... шынымен
Dialogue: 0,0:58:53.51,0:58:57.02,Default,,0,0,0,,<Харуки: Қыс ортасының әні сиқыр сияқты
Dialogue: 0,0:58:57.02,0:59:01.69,Default,,0,0,0,,Қайтадан ғашық болғым келеді>
Dialogue: 0,0:59:01.69,0:59:04.52,Default,,0,0,0,,Ах~ Акихико
Dialogue: 0,0:59:04.52,0:59:08.19,Default,,0,0,0,,Үйге қайтайық
Dialogue: 0,0:59:08.19,0:59:12.30,Default,,0,0,0,,Күздің бір күні ғашық болдым
Dialogue: 0,0:59:12.30,0:59:18.80,Default,,0,0,0,,Ортақ бұлақтағы ортақ махаббат туралы әңгіме.
Dialogue: 0,0:59:20.30,0:59:26.30,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory