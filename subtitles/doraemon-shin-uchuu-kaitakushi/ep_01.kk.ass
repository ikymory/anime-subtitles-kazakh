Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:32.61,0:00:34.74,Default,,0,0,0,,Енді бұрмалауды енгізіңіз
Dialogue: 0,0:00:40.29,0:00:44.00,Default,,0,0,0,,(Отото құсының сайрауы)
Dialogue: 0,0:00:44.12,0:00:47.33,Default,,0,0,0,,(айқай)
Dialogue: 0,0:00:47.46,0:00:49.38,Default,,0,0,0,,Хехехехехе
Dialogue: 0,0:00:50.13,0:00:51.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:51.46,0:00:53.84,Default,,0,0,0,,А, Роппл, күте тұр!
Dialogue: 0,0:00:54.01,0:00:57.80,Default,,0,0,0,,Жүгірме! Эй, күт!
Dialogue: 0,0:00:57.93,0:01:00.60,Default,,0,0,0,,(Роппл мен Молинаның күлкісі)
Dialogue: 0,0:01:00.72,0:01:03.02,Default,,0,0,0,,Уау аа аа
Dialogue: 0,0:01:03.14,0:01:05.35,Default,,0,0,0,,Қараңдар, қараңдар (жер гүрілдейді)
Dialogue: 0,0:01:05.48,0:01:07.69,Default,,0,0,0,,Иә? Не? не болды?
Dialogue: 0,0:01:07.81,0:01:08.86,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:01:09.11,0:01:11.82,Default,,0,0,0,,(айқай)
Dialogue: 0,0:01:11.94,0:01:13.69,Default,,0,0,0,,(Жануарлардың үрейленген дыбыстары)
Dialogue: 0,0:01:13.82,0:01:14.99,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:15.11,0:01:16.61,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:01:16.82,0:01:18.87,Default,,0,0,0,,Иә? Не? (2-ер адам) Не болды?
Dialogue: 0,0:01:18.99,0:01:21.45,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:01:21.62,0:01:25.62,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:01:30.42,0:01:32.55,Default,,0,0,0,,Бұл жаман. Бұл энергетикалық толқындардың дауылы.
Dialogue: 0,0:01:32.67,0:01:33.76,Default,,0,0,0,,Уау
Dialogue: 0,0:01:33.88,0:01:35.09,Default,,0,0,0,,(ескерту дыбысы)
Dialogue: 0,0:01:35.22,0:01:37.84,Default,,0,0,0,,Осылай жүре берсек, боранға сіңіп қаламыз.
Dialogue: 0,0:01:38.22,0:01:39.72,Default,,0,0,0,,Екінші зымыран күшейткішінің зақымдануы
Dialogue: 0,0:01:39.84,0:01:40.93,Default,,0,0,0,,Көмекші қозғалтқышты пайдаланыңыз
Dialogue: 0,0:01:41.05,0:01:42.43,Default,,0,0,0,,Жоқ, ол жұмыс істемейді.
Dialogue: 0,0:01:42.56,0:01:46.64,Default,,0,0,0,,Доктор Бернс, мен бұл дауылға шығамын деп ойламадым...
Dialogue: 0,0:01:46.85,0:01:48.06,Default,,0,0,0,,4 бөлім Ауа қысымының төмендеуі
Dialogue: 0,0:01:48.19,0:01:50.02,Default,,0,0,0,,Екінші және үшінші клапандарды ашыңыз.
Dialogue: 0,0:01:50.15,0:01:52.52,Default,,0,0,0,,Әке! Не болды?
Dialogue: 0,0:01:52.65,0:01:53.90,Default,,0,0,0,,Молина
Dialogue: 0,0:01:54.69,0:01:56.78,Default,,0,0,0,,Мен саған мұнда келме дедім.
Dialogue: 0,0:01:56.90,0:02:00.03,Default,,0,0,0,,А, күте тұрыңыз, сіз не істеуді жоспарлап отырсыз? әке
Dialogue: 0,0:02:02.91,0:02:04.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:05.04,0:02:09.96,Default,,0,0,0,,Жарайды, былай көрінсе де, біз көптеген ғарыш кемелерін жасадық.
Dialogue: 0,0:02:12.59,0:02:14.38,Default,,0,0,0,,Сау болыңыз, ағай.
Dialogue: 0,0:02:31.06,0:02:32.19,Default,,0,0,0,,Күшейткіш қозғалды
Dialogue: 0,0:02:32.65,0:02:36.28,Default,,0,0,0,,Жарайды, біз бұрылыстан шығамыз, тез дайындалыңдар.
Dialogue: 0,0:02:36.94,0:02:38.19,Default,,0,0,0,,Хмм... ха
Dialogue: 0,0:02:41.36,0:02:42.57,Default,,0,0,0,,Спидвагон керемет шығып кетті.
Dialogue: 0,0:02:43.20,0:02:43.87,Default,,0,0,0,,Ағай!
Dialogue: 0,0:02:44.66,0:02:45.33,Default,,0,0,0,,Жүгір!
Dialogue: 0,0:02:45.54,0:02:47.79,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:02:52.46,0:02:53.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:53.42,0:02:56.00,Default,,0,0,0,,Гуаааааааааааааааааа
Dialogue: 0,0:02:56.25,0:02:59.97,Default,,0,0,0,,Әке! Біреу әкеме көмектесуін өтінемін!
Dialogue: 0,0:03:00.09,0:03:01.43,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:01.55,0:03:02.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:03:03.01,0:03:06.97,Default,,0,0,0,,(Бернс айқайы)
Dialogue: 0,0:03:08.22,0:03:11.60,Default,,0,0,0,,Оян, Нобита-кун!
Dialogue: 0,0:03:11.85,0:03:14.65,Default,,0,0,0,,Эй, эй (Нобита)...
Dialogue: 0,0:03:14.77,0:03:16.52,Default,,0,0,0,,Не!? Уф...
Dialogue: 0,0:03:17.82,0:03:19.53,Default,,0,0,0,,Сіз неге таң қалдыңыз?
Dialogue: 0,0:03:19.65,0:03:21.40,Default,,0,0,0,,Мен таңғажайып түс көрдім.
Dialogue: 0,0:03:21.53,0:03:25.78,Default,,0,0,0,,Ғарыш кемесін жөндеп жатқанда, энергия толқындарының дауылына тап болдым.
Dialogue: 0,0:03:25.99,0:03:27.16,Default,,0,0,0,,Осылайша ғарыш кемесі жұмысын тоқтатты...
Dialogue: 0,0:03:27.29,0:03:29.95,Default,,0,0,0,,Қазірдің өзінде! Джиан қазір Арашиден жақсы!
Dialogue: 0,0:03:30.08,0:03:30.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:31.54,0:03:32.87,Default,,0,0,0,,Нобита Бұл қиын.
Dialogue: 0,0:03:33.00,0:03:34.42,Default,,0,0,0,,Менің алыптарым стадионы
Dialogue: 0,0:03:34.54,0:03:36.00,Default,,0,0,0,,Кіші мектеп оқушылары ұрлап кеткен
Dialogue: 0,0:03:36.75,0:03:37.67,Default,,0,0,0,,Сәлем Нобита
Dialogue: 0,0:03:37.80,0:03:40.42,Default,,0,0,0,,Біз үндемеуіміз керек пе?
Dialogue: 0,0:03:41.13,0:03:42.47,Default,,0,0,0,,Бұл жақсы емес
Dialogue: 0,0:03:42.59,0:03:43.47,Default,,0,0,0,,Ой хи хи хи
Dialogue: 0,0:03:43.59,0:03:46.22,Default,,0,0,0,,Бұл біздің жеріміз емес пе?
Dialogue: 0,0:03:46.35,0:03:47.81,Default,,0,0,0,,Иә!
Dialogue: 0,0:03:47.93,0:03:50.48,Default,,0,0,0,,Бұл бос жерді пайдалануға құқығымыз бар!
Dialogue: 0,0:03:50.60,0:03:51.43,Default,,0,0,0,,О!
Dialogue: 0,0:03:51.56,0:03:53.69,Default,,0,0,0,,Нобита күткендей, сіз жақсы нәрсе айтасыз.
Dialogue: 0,0:03:53.81,0:03:55.48,Default,,0,0,0,,Күтілгендей салқын
Dialogue: 0,0:03:55.61,0:03:56.86,Default,,0,0,0,,онша емес~
Dialogue: 0,0:03:57.15,0:03:58.82,Default,,0,0,0,,Қайтадан мінді
Dialogue: 0,0:03:59.03,0:04:02.36,Default,,0,0,0,,Жарайсыңдар, сен біздің Алыптардың өкілісің.
Dialogue: 0,0:04:02.49,0:04:04.82,Default,,0,0,0,,Бейсбол стадионындағы жауапты орта мектеп оқушылары және т.б.
Dialogue: 0,0:04:04.95,0:04:05.99,Default,,0,0,0,,Оны қайтарыңыз!
Dialogue: 0,0:04:06.12,0:04:08.58,Default,,0,0,0,,Уау Уау...
Dialogue: 0,0:04:08.70,0:04:10.75,Default,,0,0,0,,О? Не? сен
Dialogue: 0,0:04:10.87,0:04:13.29,Default,,0,0,0,,Вау! (Нобита) Бобобо... Біз де...
Dialogue: 0,0:04:13.41,0:04:15.04,Default,,0,0,0,,Мен мұнда бейсбол ойнағым келеді.
Dialogue: 0,0:04:15.17,0:04:16.75,Default,,0,0,0,,Не?! иә?
Dialogue: 0,0:04:16.88,0:04:20.21,Default,,0,0,0,,Жоқ... Айтайын дегенім, егер сіз орта мектеп оқушысы болсаңыз, неге бейсбол клубына қатыспасқа?
Dialogue: 0,0:04:20.34,0:04:22.67,Default,,0,0,0,,Уф (1-ші кіші мектеп оқушысы) Бейсбол командасында кім бар?
Dialogue: 0,0:04:22.80,0:04:24.18,Default,,0,0,0,,Иә (2-ші кіші мектеп оқушысы) Біз
Dialogue: 0,0:04:24.30,0:04:26.84,Default,,0,0,0,,Мен бейсболдан еркін ләззат алғым келеді.\NМен
Dialogue: 0,0:04:26.97,0:04:30.64,Default,,0,0,0,,сияқты бірдеңе айттым, бірақ мен оған тым жаман болдым, олар мені кіргізбеді.
Dialogue: 0,0:04:30.77,0:04:31.93,Default,,0,0,0,,Гусса
Dialogue: 0,0:04:33.73,0:04:35.56,Default,,0,0,0,,Иә? Шынымен бе?
Dialogue: 0,0:04:35.69,0:04:36.35,Default,,0,0,0,,Уф
Dialogue: 0,0:04:36.56,0:04:39.40,Default,,0,0,0,,Өзіңізді қызықтыратын нәрсені айтыңыз.
Dialogue: 0,0:04:39.52,0:04:41.90,Default,,0,0,0,,Сәлем Сәлем Уау!
Dialogue: 0,0:04:42.74,0:04:44.99,Default,,0,0,0,,Гах! (Кіші мектеп оқушылары) Күтіңіздер! Эй!
Dialogue: 0,0:04:45.11,0:04:47.49,Default,,0,0,0,,Жолдасың, енот ит! Ой...
Dialogue: 0,0:04:47.62,0:04:49.33,Default,,0,0,0,,Мен енот ит емеспін!
Dialogue: 0,0:04:49.45,0:04:51.24,Default,,0,0,0,,Күте тұрыңыз! (Нобита) Хаха...
Dialogue: 0,0:04:51.37,0:04:52.33,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:04:52.95,0:04:55.16,Default,,0,0,0,,Уа, ау, ау, ау...
Dialogue: 0,0:04:55.29,0:04:56.62,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:04:56.75,0:04:58.67,Default,,0,0,0,,Сен қайда бардың? (Кіші мектеп оқушысы 2) Арғы жақтан ізде!
Dialogue: 0,0:04:58.79,0:05:01.42,Default,,0,0,0,,(Кіші мектеп оқушыларының айқайы)
Dialogue: 0,0:05:03.01,0:05:07.64,Default,,0,0,0,,Маған көмектес, Дораемон!
Dialogue: 0,0:05:13.89,0:05:19.90,Default,,0,0,0,,♪〜
Dialogue: 0,0:06:36.56,0:06:42.56,Default,,0,0,0,,〜♪
Dialogue: 0,0:07:03.42,0:07:04.92,Default,,0,0,0,,Уау
Dialogue: 0,0:07:05.04,0:07:08.05,Default,,0,0,0,,Ол мені әлі қуып келеді. Не істеуім керек? Ропле-кун
Dialogue: 0,0:07:08.17,0:07:10.34,Default,,0,0,0,,Жәй үндеме, Чумми.
Dialogue: 0,0:07:10.47,0:07:13.30,Default,,0,0,0,,Ой, қауіпті, қауіпті, қаш, қаш!
Dialogue: 0,0:07:13.43,0:07:14.43,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,0:07:14.55,0:07:15.56,Default,,0,0,0,,Бұрмалау және қашу
Dialogue: 0,0:07:15.68,0:07:17.64,Default,,0,0,0,,Асығыңыз, асығыңыз! Ахх
Dialogue: 0,0:07:17.77,0:07:19.27,Default,,0,0,0,,Қазір емес!
Dialogue: 0,0:07:19.39,0:07:21.10,Default,,0,0,0,,Почи Ни
Dialogue: 0,0:07:24.65,0:07:26.36,Default,,0,0,0,,Олар ақымақ.
Dialogue: 0,0:07:26.48,0:07:29.74,Default,,0,0,0,,Егер сіз осындай жылдамдықпен бұрылсаңыз, сізге тіпті мүмкіндік болмайды.
Dialogue: 0,0:07:29.86,0:07:33.70,Default,,0,0,0,,Бұл сізді қоқысқа тастау қиындықтарынан құтқарады.
Dialogue: 0,0:07:34.78,0:07:37.08,Default,,0,0,0,,Эй Нобита, сен қанша уақыт ұйықтадың?
Dialogue: 0,0:07:37.20,0:07:38.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:38.62,0:07:41.25,Default,,0,0,0,,Иә? Ал ғарыш кемесі ше?
Dialogue: 0,0:07:41.37,0:07:44.38,Default,,0,0,0,,Мұндай жерде жиі ұйықтауға болады.
Dialogue: 0,0:07:44.50,0:07:46.63,Default,,0,0,0,,Бұл тағы да түс болды ма?
Dialogue: 0,0:07:46.75,0:07:49.63,Default,,0,0,0,,Менің ойымша, сіз бос жерді қайтара аласыз ба?
Dialogue: 0,0:07:49.84,0:07:51.97,Default,,0,0,0,,Не? Жоқ, бұл...
Dialogue: 0,0:07:52.09,0:07:52.93,Default,,0,0,0,,Хмм
Dialogue: 0,0:07:53.22,0:07:57.14,Default,,0,0,0,,Қараңызшы, ол бейсбол ойнай алмаса да, Джианның әні бар.
Dialogue: 0,0:07:57.26,0:07:58.39,Default,,0,0,0,,О! Хмм? (Сунео) Эй...
Dialogue: 0,0:07:58.51,0:08:01.64,Default,,0,0,0,,Бұдан былай әнге ден қойған дұрыс.
Dialogue: 0,0:08:01.77,0:08:03.48,Default,,0,0,0,,Иә, әрине!
Dialogue: 0,0:08:03.60,0:08:04.60,Default,,0,0,0,,Ах... Мм, мм...
Dialogue: 0,0:08:04.73,0:08:08.44,Default,,0,0,0,,(Ән айту)
Dialogue: 0,0:08:08.57,0:08:09.98,Default,,0,0,0,,Уау, бірақ Джиан
Dialogue: 0,0:08:10.11,0:08:13.65,Default,,0,0,0,,Кәдімгі концерт өтетін жер де сол бос жер!
Dialogue: 0,0:08:13.78,0:08:14.70,Default,,0,0,0,,Га
Dialogue: 0,0:08:15.03,0:08:17.95,Default,,0,0,0,,Нобита, алдама! Бұл...
Dialogue: 0,0:08:18.08,0:08:19.87,Default,,0,0,0,,Күте тұрыңыз! (Сунео) Ааа...
Dialogue: 0,0:08:19.99,0:08:21.95,Default,,0,0,0,,(Скрипканың сықырлауы)
Dialogue: 0,0:08:22.08,0:08:24.58,Default,,0,0,0,,Шизука-чан а?
Dialogue: 0,0:08:24.71,0:08:26.50,Default,,0,0,0,,Шизука-чан...
Dialogue: 0,0:08:26.63,0:08:28.92,Default,,0,0,0,,Шизука-чан!
Dialogue: 0,0:08:29.13,0:08:31.21,Default,,0,0,0,,Нобита-сан!? (Нобита) Маған көмектес!
Dialogue: 0,0:08:31.34,0:08:34.18,Default,,0,0,0,,Сізді Такеши мырза мен оның достары тағы да қуып бара жатыр ма?
Dialogue: 0,0:08:34.30,0:08:36.93,Default,,0,0,0,,Маған біраз уақыт жасырынуға рұқсат етіңіз!
Dialogue: 0,0:08:37.05,0:08:39.68,Default,,0,0,0,,Басқа таңдау жоқ.
Dialogue: 0,0:08:39.81,0:08:41.22,Default,,0,0,0,,Аххх (Нобита) Уау!
Dialogue: 0,0:08:41.39,0:08:42.52,Default,,0,0,0,,А, мен оны жек көремін.
Dialogue: 0,0:08:42.64,0:08:44.02,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:08:44.73,0:08:46.69,Default,,0,0,0,,Аххх (мамми) өте қиын
Dialogue: 0,0:08:46.81,0:08:49.86,Default,,0,0,0,,Бұл ұйықтайтын уақыт емес. Оян, Роппуру-кун.
Dialogue: 0,0:08:49.98,0:08:51.53,Default,,0,0,0,,Терезенің сыртына қара
Dialogue: 0,0:08:51.65,0:08:52.57,Default,,0,0,0,,Қара, қара, а
Dialogue: 0,0:08:53.53,0:08:55.20,Default,,0,0,0,,Бұл не? Мен қайдамын?
Dialogue: 0,0:08:56.82,0:08:58.66,Default,,0,0,0,,Біз не істеуіміз керек? Не істеуім керек?
Dialogue: 0,0:08:58.78,0:09:01.87,Default,,0,0,0,,Кеме бейтаныс кеңістікте тоқтады.
Dialogue: 0,0:09:04.12,0:09:05.75,Default,,0,0,0,,Сол үшін айттым ғой, солай ма? Chummy
Dialogue: 0,0:09:05.87,0:09:08.17,Default,,0,0,0,,Себебі сіз кенеттен бұрмалау түймесін басқансыз.
Dialogue: 0,0:09:08.29,0:09:11.63,Default,,0,0,0,,Өйткені олар «Тез қашайық» дейді...
Dialogue: 0,0:09:11.75,0:09:15.59,Default,,0,0,0,,Қарғыс атсын, жоғары жылдамдықта деформация уақытты босқа кетірді.
Dialogue: 0,0:09:15.97,0:09:19.55,Default,,0,0,0,,Әйтеуір, түзетуім керек, бәрі менің қайтуымды күтіп отыр.
Dialogue: 0,0:09:19.68,0:09:21.81,Default,,0,0,0,,Ол түзетіледі ме?
Dialogue: 0,0:09:22.10,0:09:23.56,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:23.81,0:09:26.56,Default,,0,0,0,,Бұл не? Бұл қайда? Міне
Dialogue: 0,0:09:27.02,0:09:30.15,Default,,0,0,0,,Бұл біртүрлі, бұл қойма болуы керек.
Dialogue: 0,0:09:30.31,0:09:33.73,Default,,0,0,0,,Уф, ауырып тұр
Dialogue: 0,0:09:33.99,0:09:35.49,Default,,0,0,0,,Атмосфера қорқынышты.
Dialogue: 0,0:09:35.61,0:09:38.66,Default,,0,0,0,,Сіз нені айтасыз? Сәлем Роппуру-кун
Dialogue: 0,0:09:38.78,0:09:40.62,Default,,0,0,0,,Мен түсінбеймін.
Dialogue: 0,0:09:40.74,0:09:42.62,Default,,0,0,0,,Үйге бара алмаймыз ба?
Dialogue: 0,0:09:43.16,0:09:44.45,Default,,0,0,0,,Сәлем Нобита
Dialogue: 0,0:09:44.58,0:09:47.21,Default,,0,0,0,,Иә? Ха, мен тез кемені жөндеуім керек.
Dialogue: 0,0:09:47.33,0:09:48.67,Default,,0,0,0,,Мен сені қуып жетемін. Сен не туралы айтып тұрсың?
Dialogue: 0,0:09:48.79,0:09:50.88,Default,,0,0,0,,Сіз мені тыңдамайсыз ба?
Dialogue: 0,0:09:51.09,0:09:54.17,Default,,0,0,0,,Такеши мырза, қазір сабыр етіңіз.
Dialogue: 0,0:09:54.34,0:09:56.17,Default,,0,0,0,,Бұл Нобитаның кінәсі.
Dialogue: 0,0:09:56.30,0:09:59.47,Default,,0,0,0,,Мен жаңа ғана қашып кеткендіктен, бос жатқан жерді сәл қайтара алмаймын.
Dialogue: 0,0:09:59.93,0:10:02.05,Default,,0,0,0,,Жауапкершілікті жалғыз Нобита-санға қалай жүктей аласың?
Dialogue: 0,0:10:02.18,0:10:03.43,Default,,0,0,0,,Бұл біртүрлі.
Dialogue: 0,0:10:03.56,0:10:05.35,Default,,0,0,0,,Бұл әркімнің мәселесі
Dialogue: 0,0:10:05.47,0:10:06.98,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:10:07.10,0:10:09.69,Default,,0,0,0,,Барлығымыз алмастыратын бос жерді іздейік.
Dialogue: 0,0:10:09.81,0:10:10.77,Default,,0,0,0,,Мм... (Сунео) Мм...
Dialogue: 0,0:10:10.90,0:10:13.57,Default,,0,0,0,,Бірақ бұл маңызды емес.
Dialogue: 0,0:10:13.69,0:10:15.19,Default,,0,0,0,,Хмм...
Dialogue: 0,0:10:15.69,0:10:17.15,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:10:17.28,0:10:19.61,Default,,0,0,0,,Неліктен Дораемоннан оны іздеуді сұрамасқа?
Dialogue: 0,0:10:19.74,0:10:21.49,Default,,0,0,0,,Иә? Хмм?
Dialogue: 0,0:10:22.45,0:10:24.12,Default,,0,0,0,,Сонымен
Dialogue: 0,0:10:24.24,0:10:26.29,Default,,0,0,0,,Дорэмон, бірдеңе істе.
Dialogue: 0,0:10:26.41,0:10:27.62,Default,,0,0,0,,Иә, бұл
Dialogue: 0,0:10:28.91,0:10:30.37,Default,,0,0,0,,Кішкентай жарық?
Dialogue: 0,0:10:30.92,0:10:31.92,Default,,0,0,0,,Жоқ
Dialogue: 0,0:10:32.04,0:10:33.46,Default,,0,0,0,,Егер бәрі кішірейсе
Dialogue: 0,0:10:33.59,0:10:36.21,Default,,0,0,0,,Бейсболды кез келген адамның бақшасында ойнауға болады
Dialogue: 0,0:10:36.63,0:10:38.22,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:10:38.34,0:10:39.59,Default,,0,0,0,,Барлығы кез келген уақытта жинала алады
Dialogue: 0,0:10:39.72,0:10:42.93,Default,,0,0,0,,Мен мүмкіндігінше жүгіре алатын ашық кеңістікті қалаймын!
Dialogue: 0,0:10:43.05,0:10:46.14,Default,,0,0,0,,Біреу үлкен ашық кеңістікті пайдаланып қойған.
Dialogue: 0,0:10:46.27,0:10:48.18,Default,,0,0,0,,Әйтеуір
Dialogue: 0,0:10:48.31,0:10:52.52,Default,,0,0,0,,Бұл мүмкін емес, Жапония кішкентай.
Dialogue: 0,0:10:54.02,0:10:57.32,Default,,0,0,0,,А, мен не істеуім керек?
Dialogue: 0,0:11:00.99,0:11:04.58,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:11:12.58,0:11:13.29,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:13.42,0:11:14.59,Default,,0,0,0,,А, дұрыс! Уау
Dialogue: 0,0:11:14.71,0:11:16.67,Default,,0,0,0,,Ей, қайда болсаң да есікті аш.
Dialogue: 0,0:11:16.80,0:11:18.17,Default,,0,0,0,,Мүмкін, сенің көзіңдегі жамандықтан шығар
Dialogue: 0,0:11:18.42,0:11:20.67,Default,,0,0,0,,Айналасында ешкім жоқ планетаны табу керек.
Dialogue: 0,0:11:21.51,0:11:26.56,Default,,0,0,0,,Эй, кез келген жерде есікті тек 10 жарық жылы ішінде пайдалануға болады!
Dialogue: 0,0:11:26.76,0:11:29.81,Default,,0,0,0,,Олардың арасында бейсбол ойнауға болатын планета жоқ.
Dialogue: 0,0:11:29.93,0:11:32.56,Default,,0,0,0,,Аа~аа қазірдің өзінде... мм
Dialogue: 0,0:11:34.06,0:11:36.98,Default,,0,0,0,,Өтінемін, бұл туралы бірдеңе жасаңыз ...
Dialogue: 0,0:11:37.11,0:11:40.11,Default,,0,0,0,,Менің таңдауым жоқ. Бұл туралы ойланайық.
Dialogue: 0,0:11:40.24,0:11:42.15,Default,,0,0,0,,Шынымен!? Олай болса, танысқаныма қуаныштымын!
Dialogue: 0,0:11:42.28,0:11:43.61,Default,,0,0,0,,Uggggg…
Dialogue: 0,0:11:49.20,0:11:53.71,Default,,0,0,0,,А, жарайды.
Dialogue: 0,0:12:00.13,0:12:02.76,Default,,0,0,0,,А, қарным ашты.
Dialogue: 0,0:12:02.88,0:12:05.76,Default,,0,0,0,,Түскі асыңды неге әкелмедің?
Dialogue: 0,0:12:05.89,0:12:09.31,Default,,0,0,0,,Өйткені мен кеше түнде қайтуым керек еді.
Dialogue: 0,0:12:09.43,0:12:11.10,Default,,0,0,0,,Мен енді шыдай алмаймын
Dialogue: 0,0:12:11.23,0:12:12.48,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:12:12.60,0:12:14.44,Default,,0,0,0,,Тоқтатпа, Роппуру-кун
Dialogue: 0,0:12:14.56,0:12:17.31,Default,,0,0,0,,Мен есіктің сыртын зерттеймін.
Dialogue: 0,0:12:17.57,0:12:18.77,Default,,0,0,0,,Жарайды, Чумми
Dialogue: 0,0:12:18.90,0:12:20.94,Default,,0,0,0,,Сұмдық ауа тұншықтырар.
Dialogue: 0,0:12:21.07,0:12:23.86,Default,,0,0,0,,Уайымдама, уайымдама, Мынадай көрінсең де, мықтысың.
Dialogue: 0,0:12:24.57,0:12:29.37,Default,,0,0,0,,Міне! иә? Бұл біртүрлі
Dialogue: 0,0:12:29.49,0:12:31.87,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:36.04,0:12:37.33,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:12:37.75,0:12:39.13,Default,,0,0,0,,Уау! Бұл жер сілкінісі! Бұл жер сілкінісі!
Dialogue: 0,0:12:39.25,0:12:40.59,Default,,0,0,0,,Нені шулатып жатырсың?
Dialogue: 0,0:12:40.71,0:12:42.92,Default,,0,0,0,,(Нобитаның айқайы)
Dialogue: 0,0:12:43.13,0:12:45.51,Default,,0,0,0,,(Ана мен әке ауыр тыныс алуда)
Dialogue: 0,0:12:47.72,0:12:48.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:49.43,0:12:52.89,Default,,0,0,0,,Шынымды айтсам, денем дірілдегені сонша, мен қалқып кеттім.
Dialogue: 0,0:12:53.02,0:12:55.10,Default,,0,0,0,,Жер сілкінісі болған жоқ.
Dialogue: 0,0:12:55.23,0:12:57.31,Default,,0,0,0,,Тағы бір оғаш нәрсе айтыңыз
Dialogue: 0,0:12:58.11,0:13:00.40,Default,,0,0,0,,Бірақ ол дірілдеп кетті.
Dialogue: 0,0:13:00.52,0:13:03.86,Default,,0,0,0,,Қазір ұйықтаңыз. Жақсы.
Dialogue: 0,0:13:04.28,0:13:06.07,Default,,0,0,0,,Қайырлы түн.
Dialogue: 0,0:13:07.11,0:13:09.41,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:13:10.45,0:13:14.16,Default,,0,0,0,,Бұл біртүрлі. Бұл тірек таяқша ретінде пайдаланылады ма деп ойлаймын.
Dialogue: 0,0:13:14.29,0:13:16.25,Default,,0,0,0,,Жарайды, міне осы.
Dialogue: 0,0:13:16.37,0:13:18.38,Default,,0,0,0,,Тодороки мен Бакуго!
Dialogue: 0,0:13:18.50,0:13:20.71,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:13:21.50,0:13:22.34,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:13:22.46,0:13:24.01,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:24.13,0:13:25.55,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:13:25.67,0:13:27.89,Default,,0,0,0,,Бұл жолы не болды?
Dialogue: 0,0:13:28.01,0:13:31.60,Default,,0,0,0,,Футон жарылып, бірдеңе... бірдеңе...
Dialogue: 0,0:13:31.72,0:13:33.81,Default,,0,0,0,,Не?
Dialogue: 0,0:13:34.14,0:13:35.60,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:13:35.73,0:13:38.06,Default,,0,0,0,,Не? Бұл біртүрлі
Dialogue: 0,0:13:38.35,0:13:41.52,Default,,0,0,0,,(шу)
Dialogue: 0,0:13:41.65,0:13:44.36,Default,,0,0,0,,Қараңызшы, бұл жерде бір нәрсе бар.
Dialogue: 0,0:13:44.74,0:13:48.74,Default,,0,0,0,,(шу)
Dialogue: 0,0:13:49.70,0:13:51.12,Default,,0,0,0,,Ас үйде.
Dialogue: 0,0:13:51.62,0:13:52.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:52.87,0:13:55.66,Default,,0,0,0,,Ахх...
Dialogue: 0,0:14:00.08,0:14:01.54,Default,,0,0,0,,Ахх...
Dialogue: 0,0:14:01.67,0:14:04.84,Default,,0,0,0,,А... мынау мен түсімде көрген қоян.
Dialogue: 0,0:14:05.34,0:14:08.09,Default,,0,0,0,,А, эй... Уау!
Dialogue: 0,0:14:11.18,0:14:13.22,Default,,0,0,0,,Гяа!!
Dialogue: 0,0:14:13.35,0:14:14.81,Default,,0,0,0,,Ах... (Нобита) А...
Dialogue: 0,0:14:14.93,0:14:16.27,Default,,0,0,0,,Сәлем~ Біраз…
Dialogue: 0,0:14:16.39,0:14:17.39,Default,,0,0,0,,О, күте тұрыңыз.
Dialogue: 0,0:14:22.52,0:14:23.36,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:14:29.07,0:14:32.41,Default,,0,0,0,,Хия аа аа ах хию~ Бір минут күте тұрыңыз... аа
Dialogue: 0,0:14:32.53,0:14:33.99,Default,,0,0,0,,Қандай жылдам жігіт.
Dialogue: 0,0:14:36.33,0:14:39.25,Default,,0,0,0,,Хаха... Ахх
Dialogue: 0,0:14:45.46,0:14:47.88,Default,,0,0,0,,Хя, хя, аға, ха
Dialogue: 0,0:14:48.01,0:14:51.80,Default,,0,0,0,,Енді жоқ, ауа нашар, денем ауыр...
Dialogue: 0,0:14:51.93,0:14:52.76,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:14:53.18,0:14:55.18,Default,,0,0,0,,Сен (Чамми) Ах!
Dialogue: 0,0:14:55.31,0:14:59.14,Default,,0,0,0,,Ақырында, ғаламның ақырында, Мені варварлар жейді.
Dialogue: 0,0:14:59.27,0:15:03.27,Default,,0,0,0,,Қалауыңызша қайнатыңыз немесе пісіріңіз, келіңіз.
Dialogue: 0,0:15:03.56,0:15:05.69,Default,,0,0,0,,Сені жабайы деу дөрекі.
Dialogue: 0,0:15:05.82,0:15:07.74,Default,,0,0,0,,Эй, мен сенен бірнәрсе сұрайын деп едім.
Dialogue: 0,0:15:07.86,0:15:10.03,Default,,0,0,0,,Қай жерден жесем де дәмді емес.
Dialogue: 0,0:15:10.15,0:15:11.36,Default,,0,0,0,,Оны жібермеуім керек еді....
Dialogue: 0,0:15:11.49,0:15:14.03,Default,,0,0,0,,Сіз ғарыш кемесінде болдыңыз, солай ма?
Dialogue: 0,0:15:14.16,0:15:15.49,Default,,0,0,0,,Баламен
Dialogue: 0,0:15:15.62,0:15:17.12,Default,,0,0,0,,Ал, Ропле-кун ше?
Dialogue: 0,0:15:17.24,0:15:18.29,Default,,0,0,0,,Сіз білесіз бе?
Dialogue: 0,0:15:19.04,0:15:22.17,Default,,0,0,0,,Қараңдар, мен де сол үшін айттым, солай ма? Дораемон
Dialogue: 0,0:15:22.29,0:15:25.21,Default,,0,0,0,,Бұл жай ғана арман емес еді.
Dialogue: 0,0:15:25.34,0:15:29.97,Default,,0,0,0,,Бірақ бұл нені білдіреді? Шындықты армандау
Dialogue: 0,0:15:30.09,0:15:32.93,Default,,0,0,0,,Әй, мұнда қалай келдің?
Dialogue: 0,0:15:33.05,0:15:34.43,Default,,0,0,0,,Ой, ой… қандай шулы жұрт…
Dialogue: 0,0:15:34.68,0:15:36.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:36.26,0:15:37.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:37.89,0:15:40.98,Default,,0,0,0,,Иә!? Татами астында!?
Dialogue: 0,0:15:43.69,0:15:46.82,Default,,0,0,0,,Ол ғарыш кемесі қоймасына қосылған!
Dialogue: 0,0:15:47.36,0:15:51.78,Default,,0,0,0,,Қарасам, уақыт пен кеңістік әйтеуір ығысып кеткен.
Dialogue: 0,0:15:51.90,0:15:54.20,Default,,0,0,0,,-де бұл татами төсенішінің түбіне қосылды.
Dialogue: 0,0:15:54.57,0:15:56.33,Default,,0,0,0,,Түсіңізде кім көрінді?
Dialogue: 0,0:15:56.99,0:15:58.91,Default,,0,0,0,,Бұл бұрылыстың арқасында.
Dialogue: 0,0:15:59.04,0:16:00.41,Default,,0,0,0,,Мен оның екінші жағында болғанына сенімдімін.
Dialogue: 0,0:16:00.54,0:16:02.87,Default,,0,0,0,,Ропле-кун мен оның достарының еңбекқорлығы
Dialogue: 0,0:16:03.00,0:16:06.38,Default,,0,0,0,,Ол уақыт пен кеңістіктен тыс Нобита-кунға жетті.
Dialogue: 0,0:16:10.92,0:16:13.22,Default,,0,0,0,,Иә, кет, кет.
Dialogue: 0,0:16:13.72,0:16:16.30,Default,,0,0,0,,Ей, біз де барайық.
Dialogue: 0,0:16:16.47,0:16:17.47,Default,,0,0,0,,Уау (соққы дыбысы)
Dialogue: 0,0:16:17.60,0:16:18.56,Default,,0,0,0,,Уф, ауырып тұр~
Dialogue: 0,0:16:18.68,0:16:21.39,Default,,0,0,0,,Абайлаңыз, тік және көлденең бағыттар дұрыс емес.
Dialogue: 0,0:16:21.52,0:16:24.85,Default,,0,0,0,,... Тез айтыңызшы. Ух...
Dialogue: 0,0:16:24.98,0:16:26.27,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:16:26.40,0:16:30.40,Default,,0,0,0,,Дораэмон да келуі керек, ауа сондай сергітеді.
Dialogue: 0,0:16:30.53,0:16:32.36,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:16:32.49,0:16:35.57,Default,,0,0,0,,(Дораэмон мен Нобитаның терең тыныс алуы)
Dialogue: 0,0:16:35.70,0:16:37.87,Default,,0,0,0,,Бұл рас, жақсы сезінеді~
Dialogue: 0,0:16:38.45,0:16:40.91,Default,,0,0,0,,Жүріңдер, ішке кіріңдер.
Dialogue: 0,0:16:41.16,0:16:43.41,Default,,0,0,0,,Менің денем қандай да бір себептермен үлпілдеп тұр.
Dialogue: 0,0:16:43.54,0:16:44.54,Default,,0,0,0,,Ах (Нобита/Дораэмон) Уау
Dialogue: 0,0:16:46.17,0:16:47.75,Default,,0,0,0,,Ропле-кун
Dialogue: 0,0:16:47.88,0:16:49.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:49.84,0:16:50.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:52.26,0:16:54.55,Default,,0,0,0,,А, бұл кім? сен!
Dialogue: 0,0:16:54.68,0:16:56.09,Default,,0,0,0,,Ол аса күдікті емес...
Dialogue: 0,0:16:56.22,0:16:58.22,Default,,0,0,0,,Ал, балалар қарақшыларсыңдар, солай ма?
Dialogue: 0,0:16:58.35,0:16:59.43,Default,,0,0,0,,Қарақшылар!?
Dialogue: 0,0:16:59.56,0:17:02.14,Default,,0,0,0,,Тоқта, күт, олай емес, Ропле-кун.
Dialogue: 0,0:17:02.27,0:17:03.98,Default,,0,0,0,,Ах... (Чуми) Ах.
Dialogue: 0,0:17:11.28,0:17:14.28,Default,,0,0,0,,Иә? жер галактикасы
Dialogue: 0,0:17:15.11,0:17:16.78,Default,,0,0,0,,Мен бұл туралы ешқашан естіген емеспін.
Dialogue: 0,0:17:17.11,0:17:20.53,Default,,0,0,0,,Эй, мен Коя Коя деген жұлдызда тұрамын.
Dialogue: 0,0:17:20.66,0:17:22.24,Default,,0,0,0,,Бірақ мен бұл туралы ешқашан естіген емеспін.
Dialogue: 0,0:17:22.37,0:17:24.12,Default,,0,0,0,,Иә, бұл қиын.
Dialogue: 0,0:17:24.25,0:17:26.75,Default,,0,0,0,,Бір-бірінен керемет алыс орналасқан екі жер
Dialogue: 0,0:17:26.87,0:17:28.79,Default,,0,0,0,,Әйтеуір жабысып қалды.
Dialogue: 0,0:17:29.08,0:17:30.00,Default,,0,0,0,,Хмм.
Dialogue: 0,0:17:30.13,0:17:32.50,Default,,0,0,0,,Ропле-кун, сенің ойың жоқ па?
Dialogue: 0,0:17:32.63,0:17:35.84,Default,,0,0,0,,Олай болса, бұрылыс сәтсіз болғандықтан болуы мүмкін.
Dialogue: 0,0:17:35.97,0:17:37.09,Default,,0,0,0,,Бұрыш дегеніміз не?
Dialogue: 0,0:17:37.22,0:17:38.84,Default,,0,0,0,,Сіз мұны білмейсіз бе?
Dialogue: 0,0:17:38.97,0:17:39.80,Default,,0,0,0,,Шумми
Dialogue: 0,0:17:41.22,0:17:44.98,Default,,0,0,0,,Жұлдыздар арасындағы қашықтық ондаған мың жарық жылы, солай емес пе?
Dialogue: 0,0:17:45.10,0:17:49.44,Default,,0,0,0,,Ол жарық жылдамдығымен жүрсе де, ондаған мың жыл қажет болар еді.
Dialogue: 0,0:17:54.44,0:17:57.24,Default,,0,0,0,,Ғарышта ұшып бара жатқанда жалғастырыңыз
Dialogue: 0,0:17:58.07,0:17:59.95,Default,,0,0,0,,Бұл «бұзу» деп аталады
Dialogue: 0,0:18:00.45,0:18:03.24,Default,,0,0,0,,Неліктен ғарышта алға жылжисыз?
Dialogue: 0,0:18:03.37,0:18:05.04,Default,,0,0,0,,Мм... бұл...
Dialogue: 0,0:18:05.16,0:18:07.08,Default,,0,0,0,,Иә, иә, иә, иә, иә, иә.
Dialogue: 0,0:18:07.21,0:18:08.75,Default,,0,0,0,,Ауырды, ауырады...
Dialogue: 0,0:18:08.87,0:18:09.83,Default,,0,0,0,,Иә
Dialogue: 0,0:18:10.96,0:18:12.63,Default,,0,0,0,,Хмм.
Dialogue: 0,0:18:12.75,0:18:13.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:14.51,0:18:15.92,Default,,0,0,0,,Осы жерден осы жерге
Dialogue: 0,0:18:16.05,0:18:18.97,Default,,0,0,0,,Мен қалай жылдам жүремін?
Dialogue: 0,0:18:20.09,0:18:21.93,Default,,0,0,0,,Егер сіз тура жүрсеңіз...
Dialogue: 0,0:18:22.05,0:18:23.43,Default,,0,0,0,,Жоқ жоқ жоқ (мамми) жоқ жоқ жоқ
Dialogue: 0,0:18:23.56,0:18:26.35,Default,,0,0,0,,Жоқ, сіз тезірек жүре аласыз.
Dialogue: 0,0:18:27.73,0:18:29.73,Default,,0,0,0,,Қараңдаршы, екі орын қосылып тұр.
Dialogue: 0,0:18:30.02,0:18:32.40,Default,,0,0,0,,Иә? (Мамми) Айқай?
Dialogue: 0,0:18:32.94,0:18:35.94,Default,,0,0,0,,Айтайын дегенім, ол барлық жерде есік сияқты.
Dialogue: 0,0:18:37.57,0:18:38.99,Default,,0,0,0,,(Арыстанның ақыруы)
Dialogue: 0,0:18:39.36,0:18:42.03,Default,,0,0,0,,Не? Оны басынан бастап айт.
Dialogue: 0,0:18:42.57,0:18:45.83,Default,,0,0,0,,Сіз әрқашан кеңістік, шәйнектер сияқты оғаш нәрселерді айтасыз.
Dialogue: 0,0:18:46.29,0:18:49.37,Default,,0,0,0,,Нобита-кунға нәрселерді үйрету қиын.
Dialogue: 0,0:18:49.50,0:18:51.17,Default,,0,0,0,,Уайымдама, Роппуру-кун.
Dialogue: 0,0:18:51.29,0:18:54.75,Default,,0,0,0,,Бұл сияқты көрінсе де, Дораэмонның қолынан келмейтін ештеңе жоқ.
Dialogue: 0,0:18:54.88,0:18:57.09,Default,,0,0,0,,Жақсы көрінбегенім үшін кешіріңіз.
Dialogue: 0,0:18:57.21,0:18:59.09,Default,,0,0,0,,Мен тіпті ғарыш кемесін жөндей аламын.
Dialogue: 0,0:18:59.22,0:19:00.51,Default,,0,0,0,,Күте тұрыңыз, Нобита-кун
Dialogue: 0,0:19:00.63,0:19:02.64,Default,,0,0,0,,Мен бұрын-соңды мұндай ғарыш кемесін көрген емеспін.
Dialogue: 0,0:19:02.76,0:19:05.18,Default,,0,0,0,,Мен үйге барғым келеді
Dialogue: 0,0:19:05.31,0:19:07.47,Default,,0,0,0,,(Чаммидің айқайы)
Dialogue: 0,0:19:08.39,0:19:11.23,Default,,0,0,0,,Көрейік пе? (Нобита) Иә.
Dialogue: 0,0:19:11.94,0:19:14.77,Default,,0,0,0,,Артқы жағында механикалық бөлме бар.
Dialogue: 0,0:19:14.98,0:19:17.11,Default,,0,0,0,,Есікті ашқанда, қара.
Dialogue: 0,0:19:17.23,0:19:19.36,Default,,0,0,0,,Нобита-кунның бөлмесіне қосылған
Dialogue: 0,0:19:21.78,0:19:23.12,Default,,0,0,0,,Бұл оңай.
Dialogue: 0,0:19:23.24,0:19:25.49,Default,,0,0,0,,Өтпелі құрсау
Dialogue: 0,0:19:25.62,0:19:26.79,Default,,0,0,0,,(Чаммидің күлкісі)
Dialogue: 0,0:19:26.91,0:19:29.37,Default,,0,0,0,,Жер бетінде жұмбақ құралдар бар.
Dialogue: 0,0:19:30.16,0:19:32.29,Default,,0,0,0,,Мына қапшықтар ше?
Dialogue: 0,0:19:32.42,0:19:34.33,Default,,0,0,0,,Көкөніс және дәнді дақылдардың тұқымдары
Dialogue: 0,0:19:34.46,0:19:36.46,Default,,0,0,0,,Көктем келсе, егістікке сеп.
Dialogue: 0,0:19:36.59,0:19:39.88,Default,,0,0,0,,Бұны сатып алып үйге қайтып бара жатқанымда қарақшылар кемесі маған шабуыл жасады.
Dialogue: 0,0:19:40.67,0:19:42.68,Default,,0,0,0,,Бұрынғы жұлдыздарды қосу
Dialogue: 0,0:19:42.80,0:19:45.26,Default,,0,0,0,,Коя Коядан тұрақты рейс болды.
Dialogue: 0,0:19:46.14,0:19:48.64,Default,,0,0,0,,Әрқашан қорқынышты ғарыш кемелері шабуыл жасайды
Dialogue: 0,0:19:48.77,0:19:50.77,Default,,0,0,0,,Менің барлық жүкім ұрланды.
Dialogue: 0,0:19:51.14,0:19:53.31,Default,,0,0,0,,Ендеше, сен неліктен қайықпен қиналдың?
Dialogue: 0,0:19:53.44,0:19:57.44,Default,,0,0,0,,Мен бұрылыстың бағытын өзгерттім, бірақ маған тағы да қарақшы кеме шабуыл жасады.
Dialogue: 0,0:19:57.57,0:19:59.36,Default,,0,0,0,,Қорқынышты адамдар бар.
Dialogue: 0,0:19:59.48,0:20:00.65,Default,,0,0,0,,Менің таңдауым жоқ
Dialogue: 0,0:20:00.78,0:20:04.03,Default,,0,0,0,,Полиция ғаламның кез келген бұрышына жете алмайды.
Dialogue: 0,0:20:05.74,0:20:06.62,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:06.78,0:20:10.16,Default,,0,0,0,,Менің ойымша, өлшемді діріл басының білігі сынған шығар.
Dialogue: 0,0:20:10.66,0:20:14.46,Default,,0,0,0,,Эй, Дораемон, ол сынғанға дейін сынған жоқ, солай ма?
Dialogue: 0,0:20:14.58,0:20:16.96,Default,,0,0,0,,Не, сіз анық нәрсе айтып тұрсыз ба?
Dialogue: 0,0:20:17.09,0:20:19.80,Default,,0,0,0,,Ондай жағдайда неге уақыт матасын қолданбасқа?
Dialogue: 0,0:20:20.09,0:20:22.84,Default,,0,0,0,,О, ұлы Нобита-кун
Dialogue: 0,0:20:22.97,0:20:24.18,Default,,0,0,0,,Ухун (Нобита) Фуфуфуфуфу
Dialogue: 0,0:20:24.30,0:20:26.85,Default,,0,0,0,,Ал, уақыт Фурошики!
Dialogue: 0,0:20:27.18,0:20:27.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:20:28.18,0:20:29.43,Default,,0,0,0,,Хото
Dialogue: 0,0:20:37.61,0:20:41.07,Default,,0,0,0,,Роппл-кун, тез кел!
Dialogue: 0,0:20:42.44,0:20:44.57,Default,,0,0,0,,Эй, хаха...
Dialogue: 0,0:20:44.70,0:20:46.28,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:20:46.41,0:20:47.82,Default,,0,0,0,,А, күте тұрыңыз ...
Dialogue: 0,0:20:49.03,0:20:49.95,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:20:50.08,0:20:52.04,Default,,0,0,0,,уф уһ iii
Dialogue: 0,0:20:52.16,0:20:54.00,Default,,0,0,0,,Хахахаха
Dialogue: 0,0:20:54.12,0:20:55.08,Default,,0,0,0,,Ах~ Ах~
Dialogue: 0,0:20:55.37,0:20:56.67,Default,,0,0,0,,Қара, қара
Dialogue: 0,0:20:59.17,0:21:00.67,Default,,0,0,0,,Бұл жұлдызды аспан
Dialogue: 0,0:21:00.92,0:21:02.17,Default,,0,0,0,,Ол бекітілген.
Dialogue: 0,0:21:02.30,0:21:05.26,Default,,0,0,0,,Қараңыз, қараңыз, Коякоя жұлдызы...
Dialogue: 0,0:21:05.93,0:21:08.30,Default,,0,0,0,,Жақын көрінеді
Dialogue: 0,0:21:08.47,0:21:11.22,Default,,0,0,0,,Ақырында сіз бұрылыстан құтылдыңыз.
Dialogue: 0,0:21:11.35,0:21:14.73,Default,,0,0,0,,Ах, бірақ жақсы ма? Сол татами есігі
Dialogue: 0,0:21:14.85,0:21:15.85,Default,,0,0,0,,Жоқ! (Нобита) Уф
Dialogue: 0,0:21:16.06,0:21:16.85,Default,,0,0,0,,А... (Чамми) Иә?
Dialogue: 0,0:21:17.40,0:21:18.81,Default,,0,0,0,,Егер ол есік жоғалып кетсе, сіз үйге қайта алмайсыз!
Dialogue: 0,0:21:18.94,0:21:19.61,Default,,0,0,0,,Уф
Dialogue: 0,0:21:19.73,0:21:22.28,Default,,0,0,0,,Гах аха
Dialogue: 0,0:21:22.40,0:21:25.61,Default,,0,0,0,,Жақсы, біз әлі де байланыстамыз.
Dialogue: 0,0:21:26.86,0:21:30.03,Default,,0,0,0,,...
Dialogue: 0,0:21:30.16,0:21:32.33,Default,,0,0,0,,Ой... бұл не? Бұл
Dialogue: 0,0:21:32.45,0:21:34.62,Default,,0,0,0,,Бәлкім, бәрі ақырында қалыпты жағдайға оралады.
Dialogue: 0,0:21:36.12,0:21:38.88,Default,,0,0,0,,Жердің ауасы сәйкес келмейтін сияқты.
Dialogue: 0,0:21:39.00,0:21:41.21,Default,,0,0,0,,Есікті қазір жапқаныңыз жөн.
Dialogue: 0,0:21:43.46,0:21:44.97,Default,,0,0,0,,Барлығы үшін рахмет
Dialogue: 0,0:21:45.22,0:21:47.47,Default,,0,0,0,,Сен сияқты жігіт тазаруға тиіс.
Dialogue: 0,0:21:48.80,0:21:50.05,Default,,0,0,0,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:21:58.48,0:22:00.48,Default,,0,0,0,,Фу~
Dialogue: 0,0:22:07.11,0:22:09.24,Default,,0,0,0,,Мұндай нәрсе болады, солай ма?
Dialogue: 0,0:22:09.36,0:22:10.62,Default,,0,0,0,,Кең әлемде
Dialogue: 0,0:22:10.74,0:22:14.54,Default,,0,0,0,,Мен көптеген жұмбақ нәрселер бар екеніне сенімдімін.
Dialogue: 0,0:22:14.66,0:22:15.70,Default,,0,0,0,,Иә
Dialogue: 0,0:22:23.38,0:22:25.13,Default,,0,0,0,,Сенпай, тоқта!
Dialogue: 0,0:22:25.26,0:22:26.72,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:22:26.84,0:22:29.05,Default,,0,0,0,,...
Dialogue: 0,0:22:29.18,0:22:31.64,Default,,0,0,0,,Сол бос жерді тез арада қайтарып алуымыз керек.
Dialogue: 0,0:22:31.76,0:22:32.64,Default,,0,0,0,,Сәлем Джан
Dialogue: 0,0:22:32.76,0:22:34.72,Default,,0,0,0,,Нобитаның әдеті
Dialogue: 0,0:22:35.02,0:22:36.93,Default,,0,0,0,,Эй, сен үй тапсырмасын бірге орындағың келе ме?
Dialogue: 0,0:22:37.06,0:22:38.19,Default,,0,0,0,,Иә, солай істейік.
Dialogue: 0,0:22:38.31,0:22:40.60,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:42.98,0:22:45.90,Default,,0,0,0,,Үйге әлі келмегенің қызық.
Dialogue: 0,0:22:46.57,0:22:48.74,Default,,0,0,0,,Сен қайда бардың? Нобитаның бірі
Dialogue: 0,0:22:48.86,0:22:51.36,Default,,0,0,0,,Қашып кетсең мен түсінбеймін.
Dialogue: 0,0:22:51.49,0:22:52.78,Default,,0,0,0,,Ах, сонда ол ма еді?
Dialogue: 0,0:22:56.24,0:22:58.08,Default,,0,0,0,,Йоккойшо
Dialogue: 0,0:22:59.62,0:23:00.50,Default,,0,0,0,,Әй?
Dialogue: 0,0:23:00.79,0:23:02.75,Default,,0,0,0,,Нобита Не? Сол кезден бастап
Dialogue: 0,0:23:02.88,0:23:05.13,Default,,0,0,0,,Тынш, тыныш бол.
Dialogue: 0,0:23:05.25,0:23:07.26,Default,,0,0,0,,Жаңа ғана Такеши мырза мен оның достары келді.
Dialogue: 0,0:23:07.38,0:23:08.88,Default,,0,0,0,,Уау, мен білемін.
Dialogue: 0,0:23:09.01,0:23:09.72,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:23:09.88,0:23:11.22,Default,,0,0,0,,（）
Dialogue: 0,0:23:11.34,0:23:12.14,Default,,0,0,0,,（）
Dialogue: 0,0:23:12.26,0:23:13.89,Default,,0,0,0,,Тыныш?
Dialogue: 0,0:23:14.01,0:23:14.76,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:23:15.39,0:23:17.77,Default,,0,0,0,,Сізді әлі де қуып жүр ме?
Dialogue: 0,0:23:18.27,0:23:21.19,Default,,0,0,0,,Менің таңдауым жоқ. Бүгін өз бөлмеңде ұйықтап жатырсың ба?
Dialogue: 0,0:23:21.31,0:23:23.86,Default,,0,0,0,,Сіз үнемі ұйықтап жатсаңыз да
Dialogue: 0,0:23:30.20,0:23:33.37,Default,,0,0,0,,...
Dialogue: 0,0:23:33.49,0:23:35.12,Default,,0,0,0,,Сіз аман-есен келдіңіз бе?
Dialogue: 0,0:23:35.24,0:23:36.66,Default,,0,0,0,,Менің ойымша.
Dialogue: 0,0:23:36.79,0:23:39.12,Default,,0,0,0,,Сізді тағы да қарақшы кеме қуып бара жатыр ма?
Dialogue: 0,0:23:39.25,0:23:42.00,Default,,0,0,0,,А, қараңдар, қараңдар!
Dialogue: 0,0:23:45.17,0:23:45.84,Default,,0,0,0,,Әй... (Нобита) Қараңызшы.
Dialogue: 0,0:23:45.96,0:23:47.25,Default,,0,0,0,,Әлі де қосылған
Dialogue: 0,0:23:47.38,0:23:48.26,Default,,0,0,0,,Иә
Dialogue: 0,0:23:49.09,0:23:51.76,Default,,0,0,0,,Сәлем, Ропле-кун!
Dialogue: 0,0:23:56.26,0:23:57.72,Default,,0,0,0,,Ха (Нобита) Йо
Dialogue: 0,0:24:04.31,0:24:08.19,Default,,0,0,0,,Біз Коякоя планетасына жеткен сияқтымыз.
Dialogue: 0,0:24:11.74,0:24:14.57,Default,,0,0,0,,Иә? Мен шығуды таба алмаймын
Dialogue: 0,0:24:14.70,0:24:16.58,Default,,0,0,0,,А, мынаны қараңыз.
Dialogue: 0,0:24:18.74,0:24:20.25,Default,,0,0,0,,Не?
Dialogue: 0,0:24:20.37,0:24:21.45,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:22.37,0:24:24.79,Default,,0,0,0,,Уау
Dialogue: 0,0:24:26.29,0:24:28.30,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:24:29.25,0:24:30.80,Default,,0,0,0,,Уау...
Dialogue: 0,0:24:33.51,0:24:34.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:37.55,0:24:39.18,Default,,0,0,0,,Ах (Нобита) Уау.
Dialogue: 0,0:24:42.60,0:24:45.69,Default,,0,0,0,,Менің ойымша, бұл Ропле-кун және оның достары тұратын планета ма?
Dialogue: 0,0:24:45.81,0:24:47.81,Default,,0,0,0,,Ештеңе жоқ, солай ма?
Dialogue: 0,0:24:48.02,0:24:51.15,Default,,0,0,0,,Дұрыс, мынаны өзіміздің бос жер етейік.
Dialogue: 0,0:24:51.28,0:24:52.19,Default,,0,0,0,,Иә
Dialogue: 0,0:24:52.32,0:24:55.20,Default,,0,0,0,,Сонда сіз кез келген нәрсені жасай аласыз, солай ма?
Dialogue: 0,0:24:55.32,0:24:56.53,Default,,0,0,0,,Иә? Дааааа
Dialogue: 0,0:24:56.66,0:24:57.82,Default,,0,0,0,,Не!?
Dialogue: 0,0:24:58.33,0:25:00.74,Default,,0,0,0,,Уф, не? Не?
Dialogue: 0,0:25:01.41,0:25:02.33,Default,,0,0,0,,Ах (Нобита) Ухи!
Dialogue: 0,0:25:05.75,0:25:08.96,Default,,0,0,0,,(Қабырғадағы бақа жылайды)
Dialogue: 0,0:25:09.09,0:25:11.25,Default,,0,0,0,,Ой, бұл бақа тәрізді балық.
Dialogue: 0,0:25:11.38,0:25:12.05,Default,,0,0,0,,Уау
Dialogue: 0,0:25:12.17,0:25:16.18,Default,,0,0,0,,(Бақалардың айқайы)
Dialogue: 0,0:25:18.01,0:25:22.02,Default,,0,0,0,,(айқай)
Dialogue: 0,0:25:23.89,0:25:24.81,Default,,0,0,0,,(айқай)
Dialogue: 0,0:25:24.94,0:25:27.40,Default,,0,0,0,,Иә? Бұл қандай дыбыс?
Dialogue: 0,0:25:27.52,0:25:29.44,Default,,0,0,0,,Иә?иә?
Dialogue: 0,0:25:29.56,0:25:33.78,Default,,0,0,0,,Ой, қарашы, Нобита-кун, мінеки!
Dialogue: 0,0:25:38.28,0:25:39.62,Default,,0,0,0,,Қаш (Нобита) Бұл не? Яғни
Dialogue: 0,0:25:39.74,0:25:41.66,Default,,0,0,0,,Бұл цунами Бұл цунами Цунами Ах!
Dialogue: 0,0:25:41.79,0:25:44.20,Default,,0,0,0,,Өйткені теңіз жоқ, солай ма?
Dialogue: 0,0:25:44.33,0:25:45.62,Default,,0,0,0,,Тек қаш!
Dialogue: 0,0:25:45.75,0:25:47.17,Default,,0,0,0,,Уау! о?
Dialogue: 0,0:25:47.29,0:25:50.13,Default,,0,0,0,,Ах!!
Dialogue: 0,0:25:51.50,0:25:53.00,Default,,0,0,0,,Асығыңыз! Мен жетемін
Dialogue: 0,0:25:53.13,0:25:54.67,Default,,0,0,0,,Мен мүлде жете алмаймын
Dialogue: 0,0:25:54.80,0:25:55.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:25:55.59,0:25:57.09,Default,,0,0,0,,Қараңдаршы, мына жылдамдықты қараңдар.
Dialogue: 0,0:25:57.22,0:26:00.47,Default,,0,0,0,,Егер бұл спорт күні болса, мен міндетті түрде бірінші жүлдені аламын хаха!
Dialogue: 0,0:26:00.60,0:26:03.10,Default,,0,0,0,,Хаха, уау
Dialogue: 0,0:26:03.35,0:26:05.60,Default,,0,0,0,,Сіз мұны көрдіңіз бе? (Нобита) Ах!
Dialogue: 0,0:26:06.06,0:26:07.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:26:07.64,0:26:09.06,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:12.94,0:26:15.03,Default,,0,0,0,,А, бұл қорқынышты болды.
Dialogue: 0,0:26:15.15,0:26:16.24,Default,,0,0,0,,Ммм
Dialogue: 0,0:26:16.36,0:26:18.49,Default,,0,0,0,,Маған көмектес, Дораемон!
Dialogue: 0,0:26:20.66,0:26:22.20,Default,,0,0,0,,Маған көмектесіңіз~
Dialogue: 0,0:26:22.33,0:26:24.83,Default,,0,0,0,,А, мен Takecopter туралы ұмытып кетіппін.
Dialogue: 0,0:26:26.25,0:26:28.96,Default,,0,0,0,,Әй, Нобита-кун!
Dialogue: 0,0:26:32.54,0:26:33.92,Default,,0,0,0,,Ах, бұл мені құтқарды.
Dialogue: 0,0:26:34.05,0:26:37.22,Default,,0,0,0,,Бүкіл планетаны цунами басып қалған сияқты.
Dialogue: 0,0:26:37.88,0:26:40.80,Default,,0,0,0,,Әй, ғарыш кемесі, ол қайда кетті?
Dialogue: 0,0:26:40.93,0:26:43.56,Default,,0,0,0,,Ол кемесіз біз Жерге орала алмаймыз.
Dialogue: 0,0:26:43.68,0:26:44.89,Default,,0,0,0,,(Итадори) Ол менің жұдырығымды толық жеделдемей тұрып маңдайына алды!
Dialogue: 0,0:26:45.52,0:26:46.27,Default,,0,0,0,,Эй
Dialogue: 0,0:26:46.39,0:26:49.23,Default,,0,0,0,,Әйтеуір, әзірге бұл құтқарушы сал!
Dialogue: 0,0:26:50.19,0:26:51.15,Default,,0,0,0,,Ei
Dialogue: 0,0:26:54.40,0:26:55.94,Default,,0,0,0,,Енді не істейсіз?
Dialogue: 0,0:26:56.07,0:26:58.45,Default,,0,0,0,,Судың тартылуын күтейік
Dialogue: 0,0:27:46.53,0:27:51.29,Default,,0,0,0,,Яй, көктем келді, көктем болды, көктем!
Dialogue: 0,0:27:51.41,0:27:52.67,Default,,0,0,0,,бұл куәлік ешқашан берілмейді.
Dialogue: 0,0:27:52.79,0:27:55.25,Default,,0,0,0,,(Ропл мен Клемнің күлкісі)
Dialogue: 0,0:27:55.54,0:27:58.30,Default,,0,0,0,,Аа, қыс ұзақ болды.
Dialogue: 0,0:27:58.42,0:28:01.84,Default,,0,0,0,,Сырттың ауасы дәмді ғой, ағайын.
Dialogue: 0,0:28:01.97,0:28:04.55,Default,,0,0,0,,Мен жақында достарыммен ойнағым келеді.
Dialogue: 0,0:28:06.97,0:28:10.93,Default,,0,0,0,,Әй, жақсы топырақ. Бұдан жақсы өнім күтуге болады.
Dialogue: 0,0:28:11.77,0:28:13.40,Default,,0,0,0,,Түсіндің бе? Клем
Dialogue: 0,0:28:13.52,0:28:18.48,Default,,0,0,0,,Көктемгі үлкен су тасқыны бұл өлкеге құнарлы топырақ әкеледі.
Dialogue: 0,0:28:18.61,0:28:20.19,Default,,0,0,0,,Ропле-кун, мұнда кел.
Dialogue: 0,0:28:20.32,0:28:22.99,Default,,0,0,0,,Біртүрлі заттар түсіп жатыр
Dialogue: 0,0:28:23.11,0:28:24.86,Default,,0,0,0,,Ах (Чамми) Не? Бұл
Dialogue: 0,0:28:24.99,0:28:26.91,Default,,0,0,0,,Не? Бұл не? Бұл уау
Dialogue: 0,0:28:27.33,0:28:29.62,Default,,0,0,0,,Хмм, бұл шулы.
Dialogue: 0,0:28:30.20,0:28:32.16,Default,,0,0,0,,А, Нобита-кун
Dialogue: 0,0:28:32.83,0:28:34.42,Default,,0,0,0,,Е, Ропле-кун! солай ма?
Dialogue: 0,0:28:34.54,0:28:35.25,Default,,0,0,0,,О, менің...
Dialogue: 0,0:28:35.38,0:28:37.63,Default,,0,0,0,,Ах, Ожо... (Нобита) Уф.
Dialogue: 0,0:28:38.17,0:28:41.67,Default,,0,0,0,,Дора-чан, сен мұнда не үшін келдің? Эй, неге?
Dialogue: 0,0:28:42.63,0:28:44.30,Default,,0,0,0,,Шын мәнінде, бұл ...
Dialogue: 0,0:28:44.43,0:28:46.93,Default,,0,0,0,,Бұл есік әлі жалғанған.
Dialogue: 0,0:28:47.35,0:28:49.06,Default,,0,0,0,,Су тасқынында...
Dialogue: 0,0:28:49.72,0:28:51.22,Default,,0,0,0,,Не болды? Цикл
Dialogue: 0,0:28:51.35,0:28:54.56,Default,,0,0,0,,Мама, бұлар біз өткен күні сөйлескен Нобита-кун мен Дорэмон-сан.
Dialogue: 0,0:28:54.69,0:28:56.90,Default,,0,0,0,,Жарайды, Жерден неге әуре?
Dialogue: 0,0:28:57.02,0:28:59.82,Default,,0,0,0,,Жарайды, бұл тек татамиді аударып алу.
Dialogue: 0,0:28:59.94,0:29:02.94,Default,,0,0,0,,Сіз маған қауіпті жерде көмектескен сияқтысыз.
Dialogue: 0,0:29:03.07,0:29:04.95,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:29:05.07,0:29:06.41,Default,,0,0,0,,Ал, (Нобита/Дораэмон) Эхехе...
Dialogue: 0,0:29:06.53,0:29:08.87,Default,,0,0,0,,Қатты! Гараж кетті!
Dialogue: 0,0:29:08.99,0:29:09.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:11.45,0:29:12.33,Default,,0,0,0,,Иә...
Dialogue: 0,0:29:13.75,0:29:15.29,Default,,0,0,0,,Кешіріңіз, Ропле-кун.
Dialogue: 0,0:29:15.58,0:29:16.62,Default,,0,0,0,,Біздің үй
Dialogue: 0,0:29:16.75,0:29:19.71,Default,,0,0,0,,Қысқы боран мен көктемгі су тасқынын болдырмау
Dialogue: 0,0:29:19.84,0:29:21.50,Default,,0,0,0,,Жер астында жерленген.
Dialogue: 0,0:29:21.63,0:29:24.30,Default,,0,0,0,,Кешіріңіз, мен қате жасадым.
Dialogue: 0,0:29:24.42,0:29:27.30,Default,,0,0,0,,Жарайды, уақыт біршама нашар болды.
Dialogue: 0,0:29:27.55,0:29:30.43,Default,,0,0,0,,Су шығыс көлден келеді.
Dialogue: 0,0:29:30.76,0:29:34.02,Default,,0,0,0,,Батысқа қарай шайып кетті ме?
Dialogue: 0,0:29:34.14,0:29:35.69,Default,,0,0,0,,Шынында, сол сырғаң өте батыл екен.
Dialogue: 0,0:29:36.10,0:29:37.52,Default,,0,0,0,,Дораемон, біз де барайық
Dialogue: 0,0:29:37.65,0:29:39.44,Default,,0,0,0,,Иә Takecopter
Dialogue: 0,0:29:39.56,0:29:41.78,Default,,0,0,0,,Ах, Ропле-кун да, өтінемін.
Dialogue: 0,0:29:42.69,0:29:46.53,Default,,0,0,0,,Әй, олар жер бетінде сирек кездесетін құралдармен ұшады.
Dialogue: 0,0:29:46.82,0:29:47.78,Default,,0,0,0,,Ой
Dialogue: 0,0:29:48.41,0:29:49.87,Default,,0,0,0,,Ах~ Ах~ Ах~
Dialogue: 0,0:29:50.62,0:29:53.37,Default,,0,0,0,,Абайлаңыз, мен білемін.
Dialogue: 0,0:29:54.66,0:29:56.33,Default,,0,0,0,,Бұл өте бос жер.
Dialogue: 0,0:29:56.46,0:29:57.54,Default,,0,0,0,,Сіз не айтасыз?
Dialogue: 0,0:29:57.67,0:30:00.92,Default,,0,0,0,,Мұндай лас ауасы бар жерден әлдеқайда жақсы.
Dialogue: 0,0:30:01.04,0:30:02.88,Default,,0,0,0,,Қыс енді ғана өтті.
Dialogue: 0,0:30:04.01,0:30:06.67,Default,,0,0,0,,Бірнеше күннен кейін көктем келеді.
Dialogue: 0,0:30:06.80,0:30:08.97,Default,,0,0,0,,Онда онша көп адам тұрмайды.
Dialogue: 0,0:30:09.09,0:30:10.85,Default,,0,0,0,,Үйлері жоғалғандар
Dialogue: 0,0:30:10.97,0:30:13.39,Default,,0,0,0,,Менің бұл планетаға келгеніме небәрі жеті жыл болды.
Dialogue: 0,0:30:13.72,0:30:16.27,Default,,0,0,0,,Я, ол әлі дамудың ортасында.
Dialogue: 0,0:30:16.39,0:30:19.40,Default,,0,0,0,,Бұл планетаны Ропле-кунның әкесі ашқан.
Dialogue: 0,0:30:21.82,0:30:23.90,Default,,0,0,0,,Осыған ұқсас пионер жұлдызы
Dialogue: 0,0:30:24.03,0:30:26.69,Default,,0,0,0,,Мың жарық жылында көп бар.
Dialogue: 0,0:30:26.82,0:30:30.20,Default,,0,0,0,,Басқа нәрселермен қатар бұл ресурстарға бай планета.
Dialogue: 0,0:30:30.32,0:30:32.16,Default,,0,0,0,,Әй, қала!
Dialogue: 0,0:30:39.58,0:30:40.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:42.92,0:30:43.96,Default,,0,0,0,,Бұл ранчо.
Dialogue: 0,0:30:44.09,0:30:45.71,Default,,0,0,0,,Бұл Молина апаның қожалығы.
Dialogue: 0,0:30:45.84,0:30:46.63,Default,,0,0,0,,Әпке?
Dialogue: 0,0:30:46.76,0:30:49.59,Default,,0,0,0,,Бауырластардай бірге болдық.
Dialogue: 0,0:30:51.89,0:30:55.35,Default,,0,0,0,,Молина апа, не? Бар емес пе?
Dialogue: 0,0:30:55.72,0:30:57.35,Default,,0,0,0,,Иә? (Нобита) Иә?
Dialogue: 0,0:30:58.23,0:31:00.56,Default,,0,0,0,,Сақтау қоймасына ұқсайды.
Dialogue: 0,0:31:00.69,0:31:02.15,Default,,0,0,0,,«Бірге өмір сүрейік»
Dialogue: 0,0:31:02.27,0:31:04.86,Default,,0,0,0,,Ропле-кундар үнемі осылай айтып отырса да.
Dialogue: 0,0:31:04.98,0:31:06.82,Default,,0,0,0,,Чумми, енді қайталама.
Dialogue: 0,0:31:06.94,0:31:09.61,Default,,0,0,0,,Эй, мен жалғыз тұрамын.
Dialogue: 0,0:31:09.86,0:31:11.82,Default,,0,0,0,,Иә? Бір жерден көргендеймін...
Dialogue: 0,0:31:11.95,0:31:12.78,Default,,0,0,0,,Бұл кім? иә?
Dialogue: 0,0:31:12.91,0:31:14.03,Default,,0,0,0,,Хахаха
Dialogue: 0,0:31:14.16,0:31:16.49,Default,,0,0,0,,Бұл менмін, Молина-сан.
Dialogue: 0,0:31:17.16,0:31:19.71,Default,,0,0,0,,Мен саған мұнда келме дедім.
Dialogue: 0,0:31:19.83,0:31:21.71,Default,,0,0,0,,Кешіріңіз, бірақ
Dialogue: 0,0:31:21.83,0:31:24.25,Default,,0,0,0,,Жүк кемесін су шайып кетті.
Dialogue: 0,0:31:24.38,0:31:26.42,Default,,0,0,0,,Бұл кім? Бұл балалар
Dialogue: 0,0:31:26.55,0:31:28.26,Default,,0,0,0,,Ол бізге Жерден қонаққа келді—
Dialogue: 0,0:31:28.38,0:31:30.13,Default,,0,0,0,,Бұл Нобита-кун мен Дораемон-сан.
Dialogue: 0,0:31:33.68,0:31:36.85,Default,,0,0,0,,Әй, ол кездегі адам.
Dialogue: 0,0:31:39.56,0:31:42.10,Default,,0,0,0,,Маған қауіпті жағдайдан екі адам көмектесті.
Dialogue: 0,0:31:42.73,0:31:45.19,Default,,0,0,0,,Мен сіздің дүкенге барғаныңызды естідім бе?
Dialogue: 0,0:31:45.32,0:31:46.57,Default,,0,0,0,,Иә...
Dialogue: 0,0:31:47.23,0:31:50.49,Default,,0,0,0,,Мен де осы планетаның тұрғынымын.
Dialogue: 0,0:31:51.32,0:31:52.32,Default,,0,0,0,,Ах
Dialogue: 0,0:31:54.66,0:31:57.95,Default,,0,0,0,,Үлкендердің мұндай кішкентай балаға арқа сүйеу неткен сұмдық.
Dialogue: 0,0:32:00.29,0:32:02.71,Default,,0,0,0,,Осындай жерге келгенде үлкен мәселе.
Dialogue: 0,0:32:02.92,0:32:03.96,Default,,0,0,0,,Тезірек үйге қайт
Dialogue: 0,0:32:05.50,0:32:08.09,Default,,0,0,0,,Ха, мен жаңа ғана өсек бастадым.
Dialogue: 0,0:32:10.67,0:32:12.84,Default,,0,0,0,,Тез жасырыңыз! Асығыңыз!
Dialogue: 0,0:32:13.01,0:32:14.68,Default,,0,0,0,,Ах (Нобита) Ух...
Dialogue: 0,0:32:15.51,0:32:16.93,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:32:17.06,0:32:18.68,Default,,0,0,0,,Мен сенімен кейінірек сөйлесемін. Мында кел.
Dialogue: 0,0:32:18.81,0:32:20.39,Default,,0,0,0,,Тез, тез
Dialogue: 0,0:32:21.89,0:32:24.27,Default,,0,0,0,,Бұл Гартит тау-кен патрульдік қайығы.
Dialogue: 0,0:32:25.10,0:32:26.86,Default,,0,0,0,,Гартитті өндіру?
Dialogue: 0,0:32:35.03,0:32:37.37,Default,,0,0,0,,Қайырлы таң, Молина мырза.
Dialogue: 0,0:32:37.49,0:32:38.66,Default,,0,0,0,,Сен не үшін келдің?
Dialogue: 0,0:32:39.24,0:32:41.87,Default,,0,0,0,,Аспанда белгісіз біреу ұшып бара жатқанын естідім.
Dialogue: 0,0:32:42.33,0:32:44.37,Default,,0,0,0,,Ал, мен білмеймін.
Dialogue: 0,0:32:44.87,0:32:48.09,Default,,0,0,0,,Жарайсың ба? Бұл планетаға жаңа иммиграцияға тыйым салынды.
Dialogue: 0,0:32:48.21,0:32:50.38,Default,,0,0,0,,Егер сіз мұны ұмытып қалсаңыз, мен қиыншылыққа ұшыраймын.
Dialogue: 0,0:32:50.88,0:32:52.80,Default,,0,0,0,,Маған маңызды емес.
Dialogue: 0,0:32:52.92,0:32:56.39,Default,,0,0,0,,Қазір үйге бар, аңдар таң қалады.
Dialogue: 0,0:32:56.64,0:32:59.06,Default,,0,0,0,,Ол біртүрлі жігіт.
Dialogue: 0,0:32:59.18,0:33:00.97,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:33:10.15,0:33:12.90,Default,,0,0,0,,Роппуру-кун мен басқалардың келгеніне небәрі 7 жыл болды емес пе?
Dialogue: 0,0:33:13.44,0:33:15.91,Default,,0,0,0,,Бірақ иммиграцияға әлі тыйым салынды ма?
Dialogue: 0,0:33:16.32,0:33:20.37,Default,,0,0,0,,Сол жігіттер амалсыздан еріксіз заң шығарды.
Dialogue: 0,0:33:21.04,0:33:22.37,Default,,0,0,0,,Неге тағы...
Dialogue: 0,0:33:22.50,0:33:25.92,Default,,0,0,0,,Өкінішке орай, бұл жұлдыз Гартит массасы.
Dialogue: 0,0:33:26.04,0:33:28.92,Default,,0,0,0,,Ал, бұл «Гартит» дегеніміз не?
Dialogue: 0,0:33:29.04,0:33:31.13,Default,,0,0,0,,Чумми сол жерде емес пе?
Dialogue: 0,0:33:31.25,0:33:32.92,Default,,0,0,0,,Мақсаттының екінші ұлы
Dialogue: 0,0:33:45.56,0:33:47.48,Default,,0,0,0,,О (Чамми) Иә, өтінемін.
Dialogue: 0,0:33:47.60,0:33:49.86,Default,,0,0,0,,Уау, қандай әдемі хрусталь.
Dialogue: 0,0:33:49.98,0:33:51.61,Default,,0,0,0,,Бір-біріне ысқылағанда...
Dialogue: 0,0:33:53.48,0:33:54.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:55.15,0:33:56.90,Default,,0,0,0,,Тек тұрып алып ойланып қана отыру – менің стилім емес!
Dialogue: 0,0:33:57.03,0:33:58.78,Default,,0,0,0,,Takecopter болмаса да
Dialogue: 0,0:34:00.53,0:34:03.16,Default,,0,0,0,,Жартылай тартылыс энергиясы түзіледі.
Dialogue: 0,0:34:03.29,0:34:04.08,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:34:05.04,0:34:07.46,Default,,0,0,0,,Кристалл өлшемі және жылжу бұрышы
Dialogue: 0,0:34:07.58,0:34:09.96,Default,,0,0,0,,Энергияны реттеуге болады
Dialogue: 0,0:34:10.79,0:34:13.67,Default,,0,0,0,,Өркениетімізді тіреп тұрған тас.
Dialogue: 0,0:34:14.17,0:34:16.34,Default,,0,0,0,,Қызықты көрінеді
Dialogue: 0,0:34:16.47,0:34:19.93,Default,,0,0,0,,Қарыз бер, қарызға бер, хехехехехе хаха
Dialogue: 0,0:34:21.18,0:34:24.64,Default,,0,0,0,,Олар бізді қуып жібермекші.
Dialogue: 0,0:34:24.97,0:34:28.02,Default,,0,0,0,,Гартит кенін өзіме сақтауға тырысамын.
Dialogue: 0,0:34:28.14,0:34:29.44,Default,,0,0,0,,Бұл сұмдық... (Нобита) Міне, сенің істеп жатқаның!
Dialogue: 0,0:34:29.56,0:34:30.31,Default,,0,0,0,,Иә? Ахх
Dialogue: 0,0:34:31.27,0:34:32.23,Default,,0,0,0,,Уау!
Dialogue: 0,0:34:32.36,0:34:33.82,Default,,0,0,0,,Әй, Нобита-кун!
Dialogue: 0,0:34:34.23,0:34:36.32,Default,,0,0,0,,Жердегілер ебедейсіз емес пе?
Dialogue: 0,0:34:36.44,0:34:38.40,Default,,0,0,0,,Әсіресе Нобита-кун.
Dialogue: 0,0:34:38.53,0:34:39.78,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,0:34:40.16,0:34:42.74,Default,,0,0,0,,Мен таптым! Қараңдар!
Dialogue: 0,0:34:42.87,0:34:44.58,Default,,0,0,0,,Есімнен айнып кетсем де
Dialogue: 0,0:34:44.70,0:34:46.04,Default,,0,0,0,,Хехехехехе
Dialogue: 0,0:34:50.46,0:34:51.50,Default,,0,0,0,,Қызыл ай
Dialogue: 0,0:34:51.63,0:34:55.51,Default,,0,0,0,,Бүгін түнде қызыл ай, ертең көк ай шығады
Dialogue: 0,0:34:55.76,0:34:58.88,Default,,0,0,0,,Эй, мен досымды осында әкелсем бола ма?
Dialogue: 0,0:34:59.01,0:35:01.72,Default,,0,0,0,,Егер сіз Нобита-кунның досы болсаңыз, сізді жақсы көреміз.
Dialogue: 0,0:35:01.84,0:35:03.64,Default,,0,0,0,,Не? Клем Иә
Dialogue: 0,0:35:03.76,0:35:06.43,Default,,0,0,0,,Келесі жолы маған жермен ойнауды үйретіңіз.
Dialogue: 0,0:35:06.56,0:35:08.81,Default,,0,0,0,,Мен де сенімен ойнаймын
Dialogue: 0,0:35:08.94,0:35:11.90,Default,,0,0,0,,Жарайды, бейсбол, футбол, бесік, кендама!
Dialogue: 0,0:35:12.02,0:35:14.86,Default,,0,0,0,,Ропл Клем мектебі ертең басталады.
Dialogue: 0,0:35:15.44,0:35:17.99,Default,,0,0,0,,Сіз қысқы демалыстағы үй тапсырмасын орындадыңыз, солай ма?
Dialogue: 0,0:35:18.11,0:35:20.11,Default,,0,0,0,,А, әлі біраз қалды.
Dialogue: 0,0:35:20.24,0:35:21.41,Default,,0,0,0,,Ах, Нобита-кун
Dialogue: 0,0:35:21.53,0:35:24.37,Default,,0,0,0,,Біз де тезірек үйге баруымыз керек.
Dialogue: 0,0:35:24.62,0:35:26.33,Default,,0,0,0,,Ах (Нобита) Уф
Dialogue: 0,0:35:27.08,0:35:29.71,Default,,0,0,0,,Қайта кел (Нобита) Онда кездескенше.
Dialogue: 0,0:35:32.13,0:35:34.67,Default,,0,0,0,,Бұл... қиын. Менің үйден кеткеніме екі күн болды.
Dialogue: 0,0:35:34.79,0:35:37.67,Default,,0,0,0,,Маған уақыт машинасына оралу керек Уау!
Dialogue: 0,0:35:38.97,0:35:41.38,Default,,0,0,0,,О, бұл не болды? Ноби-чан
Dialogue: 0,0:35:41.51,0:35:43.01,Default,,0,0,0,,Кешіріңіз... Кешіріңіз!
Dialogue: 0,0:35:43.14,0:35:44.93,Default,,0,0,0,,Мұның терең себебі бар...
Dialogue: 0,0:35:45.05,0:35:47.27,Default,,0,0,0,,Біраз көңіл көтеруге шығып кетіп қалдым.
Dialogue: 0,0:35:47.39,0:35:48.18,Default,,0,0,0,,Мен бұған 2 күн кетеді деп ойламаппын...
Dialogue: 0,0:35:48.31,0:35:49.77,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:35:49.89,0:35:51.56,Default,,0,0,0,,Мен де айтайын
Dialogue: 0,0:35:51.81,0:35:54.02,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:35:54.15,0:35:57.61,Default,,0,0,0,,Такеши мырза мен оның достарының ертерек келгеніне екі сағаттан аз уақыт өтті.
Dialogue: 0,0:35:57.73,0:35:59.19,Default,,0,0,0,,Иә? (Нобита) Иә?
Dialogue: 0,0:35:59.32,0:36:02.70,Default,,0,0,0,,Біртүрлі ештеңе айтпа, үй тапсырмасын тез орында.
Dialogue: 0,0:36:03.11,0:36:04.82,Default,,0,0,0,,Ааа... а?
Dialogue: 0,0:36:05.07,0:36:06.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:36:06.16,0:36:08.37,Default,,0,0,0,,Түсіндім! Есіктің арғы жағында және осында
Dialogue: 0,0:36:08.49,0:36:10.41,Default,,0,0,0,,Уақыт басқаша өтеді.
Dialogue: 0,0:36:10.54,0:36:14.71,Default,,0,0,0,,Олай болса, мұндағы бір сағат бір күн сонда?
Dialogue: 0,0:36:14.83,0:36:17.21,Default,,0,0,0,,Мүмкін бұл кеңістік-уақыт бұралғандықтан шығар.
Dialogue: 0,0:36:17.34,0:36:18.46,Default,,0,0,0,,Иә!
Dialogue: 0,0:36:18.59,0:36:21.72,Default,,0,0,0,,Күнде сол жаққа барсаңыз, көп көңіл көтересіз.
Dialogue: 0,0:36:22.72,0:36:25.26,Default,,0,0,0,,Не? Бос жер таптыңыз ба?
Dialogue: 0,0:36:25.39,0:36:27.72,Default,,0,0,0,,Менің қазіргіден гөрі ойнауға көбірек уақытым бар.
Dialogue: 0,0:36:28.06,0:36:30.31,Default,,0,0,0,,Бұл өтірік сияқты.
Dialogue: 0,0:36:30.52,0:36:32.39,Default,,0,0,0,,Шындық болса тамаша емес пе?
Dialogue: 0,0:36:32.60,0:36:35.56,Default,,0,0,0,,Мен скрипкада көбірек жаттыға аламын хаха...
Dialogue: 0,0:36:35.69,0:36:36.94,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:36:37.06,0:36:39.15,Default,,0,0,0,,Ей, жанның досы
Dialogue: 0,0:36:41.24,0:36:43.45,Default,,0,0,0,,Эй, міне. Өтінемін, өтінемін.
Dialogue: 0,0:36:43.57,0:36:45.24,Default,,0,0,0,,Не? Бұл тесік
Dialogue: 0,0:36:45.36,0:36:46.62,Default,,0,0,0,,Хокс та керемет болды.
Dialogue: 0,0:36:46.74,0:36:49.41,Default,,0,0,0,,Иә? Бұл Нобитанның бірінші қабаты емес.
Dialogue: 0,0:36:49.54,0:36:51.62,Default,,0,0,0,,Кел, кел!
Dialogue: 0,0:36:51.75,0:36:53.79,Default,,0,0,0,,Йойшо (Сунео) Доккойшо
Dialogue: 0,0:36:53.92,0:36:55.88,Default,,0,0,0,,Yotto nfufu~
Dialogue: 0,0:36:56.50,0:36:58.42,Default,,0,0,0,,Ха ха ха ха
Dialogue: 0,0:36:58.54,0:37:00.30,Default,,0,0,0,,Жотто ой
Dialogue: 0,0:37:00.42,0:37:01.88,Default,,0,0,0,,Йотто фуфуфуфу (Сунео) Йотто
Dialogue: 0,0:37:02.01,0:37:04.97,Default,,0,0,0,,(Барлығы қуанады)
Dialogue: 0,0:37:05.30,0:37:07.47,Default,,0,0,0,,Уау~
Dialogue: 0,0:37:14.19,0:37:15.73,Default,,0,0,0,,Бір күнде
Dialogue: 0,0:37:15.85,0:37:18.69,Default,,0,0,0,,Мұнда бір айға жуық уақыт болды.
Dialogue: 0,0:37:18.81,0:37:21.19,Default,,0,0,0,,Армандай сұлу жұлдыз
Dialogue: 0,0:37:21.32,0:37:23.36,Default,,0,0,0,,Әй, Нобита-кун!
Dialogue: 0,0:37:24.57,0:37:26.45,Default,,0,0,0,,Ропле-кун!
Dialogue: 0,0:37:26.74,0:37:28.70,Default,,0,0,0,,Мен досымды алып келдім.
Dialogue: 0,0:37:28.82,0:37:29.95,Default,,0,0,0,,Танысқаныма қуаныштымын!
Dialogue: 0,0:37:30.12,0:37:31.41,Default,,0,0,0,,Сәлем
Dialogue: 0,0:37:31.54,0:37:33.83,Default,,0,0,0,,Қош келдіңіздер, Коякоя планетасына.
Dialogue: 0,0:37:34.12,0:37:36.04,Default,,0,0,0,,Бұл өте жақсы жұлдыз.
Dialogue: 0,0:37:36.17,0:37:38.83,Default,,0,0,0,,Әй, бос жер қайда? Нобита
Dialogue: 0,0:37:39.38,0:37:42.67,Default,,0,0,0,,Орманның арғы жағында шабындық бар.
Dialogue: 0,0:37:42.80,0:37:45.42,Default,,0,0,0,,Сабақтан кейін біз де барамыз.
Dialogue: 0,0:37:45.55,0:37:48.39,Default,,0,0,0,,Иә, автобус келді.
Dialogue: 0,0:37:58.56,0:37:59.86,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:37:59.98,0:38:02.73,Default,,0,0,0,,Жарайсыңдар, көңілімізден шыққанша ойнайық!
Dialogue: 0,0:38:02.86,0:38:03.86,Default,,0,0,0,,Оу!
Dialogue: 0,0:38:03.99,0:38:05.99,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:38:06.11,0:38:12.12,Default,,0,0,0,,♪〜
Dialogue: 0,0:39:22.81,0:39:28.82,Default,,0,0,0,,〜♪
Dialogue: 0,0:39:30.65,0:39:32.87,Default,,0,0,0,,Фухахахахахаха!
Dialogue: 0,0:39:32.99,0:39:37.87,Default,,0,0,0,,Жарайсыңдар, бірінші алаңқай рәсімінен бастайық. Мен ұстаушыдан сұраймын, Сунео.
Dialogue: 0,0:39:38.00,0:39:39.71,Default,,0,0,0,,Жарайды! Сонда мен сені қорғаймын.
Dialogue: 0,0:39:39.83,0:39:42.50,Default,,0,0,0,,Жарайды, мен соққан кезегін беремін.
Dialogue: 0,0:39:42.63,0:39:43.29,Default,,0,0,0,,Жарайды
Dialogue: 0,0:39:43.79,0:39:45.80,Default,,0,0,0,,Провокацияны ең көп хаос қажет сәтке тура келтіруіміз керек.
Dialogue: 0,0:39:46.21,0:39:49.30,Default,,0,0,0,,Ммм, не?
Dialogue: 0,0:39:49.72,0:39:50.93,Default,,0,0,0,,Уау (Нобита) Уау
Dialogue: 0,0:39:51.55,0:39:54.05,Default,,0,0,0,,Иә... (Нобита) Хаа
Dialogue: 0,0:39:54.18,0:39:56.64,Default,,0,0,0,,Мен бұлай допты соға алмаймын.
Dialogue: 0,0:39:56.81,0:39:59.89,Default,,0,0,0,,Ах, мен жаңа ғана допты сатып алсам да.
Dialogue: 0,0:40:00.39,0:40:03.19,Default,,0,0,0,,Қатты Нобита, ереуілдің уақыты келді!
Dialogue: 0,0:40:03.31,0:40:05.44,Default,,0,0,0,,Ммм.
Dialogue: 0,0:40:05.69,0:40:06.94,Default,,0,0,0,,Жарайды, міне келдік.
Dialogue: 0,0:40:11.07,0:40:11.95,Default,,0,0,0,,Уау (Нобита) Уау
Dialogue: 0,0:40:12.66,0:40:13.82,Default,,0,0,0,,Уау
Dialogue: 0,0:40:14.70,0:40:15.45,Default,,0,0,0,,Қауіпті!
Dialogue: 0,0:40:15.83,0:40:16.62,Default,,0,0,0,,Иә
Dialogue: 0,0:40:16.87,0:40:17.70,Default,,0,0,0,,Ах!
Dialogue: 0,0:40:18.45,0:40:21.21,Default,,0,0,0,,Ах! Енді түсіндім, сонда
Dialogue: 0,0:40:21.33,0:40:22.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:40:25.92,0:40:28.00,Default,,0,0,0,,Бұл Гартит тау-кен күзетінің қайығы.
Dialogue: 0,0:40:28.13,0:40:29.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:31.30,0:40:33.34,Default,,0,0,0,,Онда! Қозғалма!
Dialogue: 0,0:40:33.47,0:40:37.26,Default,,0,0,0,,Балалар, сендер допты осылай ұрдыңдар!
Dialogue: 0,0:40:39.22,0:40:40.72,Default,,0,0,0,,Ах!
Dialogue: 0,0:40:41.06,0:40:42.44,Default,,0,0,0,,Иә
Dialogue: 0,0:40:42.56,0:40:44.27,Default,,0,0,0,,Мынадай доп бар тесік бар ма?
Dialogue: 0,0:40:49.78,0:40:50.99,Default,,0,0,0,,Ах...
Dialogue: 0,0:40:54.86,0:40:56.45,Default,,0,0,0,,Бұл мен көрмеген бет
Dialogue: 0,0:40:56.57,0:40:59.79,Default,,0,0,0,,Сіз қай планетадансыз? Сіз жаңа иммигрантсыз!
Dialogue: 0,0:40:59.91,0:41:01.87,Default,,0,0,0,,Бұл адам! (Нобита) А... бұл
Dialogue: 0,0:41:02.00,0:41:04.87,Default,,0,0,0,,Т-Мен Жерден келдім, бірақ қоныс аударған жоқпын...
Dialogue: 0,0:41:05.00,0:41:07.04,Default,,0,0,0,,Бұл иммиграциялық заңнаманы бұзу болып табылады. Мені қамауға ал!
Dialogue: 0,0:41:10.05,0:41:11.88,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,0:41:12.42,0:41:13.84,Default,,0,0,0,,Осы жерде күтіңіз!
Dialogue: 0,0:41:13.97,0:41:15.72,Default,,0,0,0,,Әй, қауіпті, қауіпті, ой, ой, ой, ой, тоқтат!
Dialogue: 0,0:41:15.84,0:41:19.01,Default,,0,0,0,,Уф, уау, не істеп жатырсың! Уау
Dialogue: 0,0:41:19.14,0:41:21.14,Default,,0,0,0,,А-а, жақсысың ба?
Dialogue: 0,0:41:22.85,0:41:23.85,Default,,0,0,0,,Бұл қауіпті. Апыр-ай!
Dialogue: 0,0:41:23.98,0:41:24.64,Default,,0,0,0,,Оскар Уэбстердің гострайтері болуға қатты қызығамын.
Dialogue: 0,0:41:25.10,0:41:26.10,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:41:26.23,0:41:29.15,Default,,0,0,0,,Атататататат...
Dialogue: 0,0:41:32.32,0:41:36.16,Default,,0,0,0,,О, олар таңқаларлық жылдам емес пе?
Dialogue: 0,0:41:36.28,0:41:39.91,Default,,0,0,0,,Оны сонша қорқытсаң, ол енді келмейді.
Dialogue: 0,0:41:40.03,0:41:40.99,Default,,0,0,0,,(Уно мен Күмәннің күлкісі)
Dialogue: 0,0:41:41.37,0:41:42.66,Default,,0,0,0,,​​Маған көмектес!
Dialogue: 0,0:41:42.79,0:41:44.79,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:41:49.13,0:41:52.13,Default,,0,0,0,,(Нобита мен оның достарының ауыр тыныс алуы)
Dialogue: 0,0:41:53.76,0:41:56.84,Default,,0,0,0,,Мұндай жерде бейсбол ойнауға болмайды.
Dialogue: 0,0:41:56.97,0:42:00.55,Default,,0,0,0,,Эй Нобита, сен мені осындай қорқынышты планетаға әкелдің.
Dialogue: 0,0:42:00.68,0:42:03.18,Default,,0,0,0,,Мен сені енді досым деп санамаймын, Беловоберо...
Dialogue: 0,0:42:03.31,0:42:04.93,Default,,0,0,0,,Кеттік, Шизука-чан
Dialogue: 0,0:42:05.06,0:42:06.77,Default,,0,0,0,,Иә... (Сунео) Эй!
Dialogue: 0,0:42:14.53,0:42:17.78,Default,,0,0,0,,Иә? Нобита-кун, досыңа не болды?
Dialogue: 0,0:42:17.91,0:42:19.37,Default,,0,0,0,,Мен қайттым
Dialogue: 0,0:42:19.49,0:42:23.04,Default,,0,0,0,,Маған Gartite Mining компаниясының бір жігіті қорқытты.
Dialogue: 0,0:42:23.16,0:42:25.41,Default,,0,0,0,,Қашса ақсақ.
Dialogue: 0,0:42:25.54,0:42:28.46,Default,,0,0,0,,Мен оны тістеп едім, бірақ...
Dialogue: 0,0:42:28.58,0:42:29.67,Default,,0,0,0,,Шумми
Dialogue: 0,0:42:29.79,0:42:32.63,Default,,0,0,0,,Олардың қудалауы күшейе түсуде.
Dialogue: 0,0:42:35.80,0:42:38.68,Default,,0,0,0,,Орманды өртеп жібер, егістіктің дәл қасында болса да.
Dialogue: 0,0:42:41.68,0:42:44.68,Default,,0,0,0,,Өзен суын бөгеп, өз қалауымызша пайдаланамыз.
Dialogue: 0,0:42:49.56,0:42:51.27,Default,,0,0,0,,Шағым жасағыңыз келсе
Dialogue: 0,0:42:51.40,0:42:53.82,Default,,0,0,0,,Жүк кемесін біреу қиратты.
Dialogue: 0,0:42:54.44,0:42:55.69,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:42:55.82,0:42:59.66,Default,,0,0,0,,Қарақшылар сияқты, полиция сенімсіз емес пе?
Dialogue: 0,0:42:59.78,0:43:04.45,Default,,0,0,0,,Өкінішке орай, біздің планетамызды өз қолымызбен қорғаудан басқа амалымыз жоқ.
Dialogue: 0,0:43:05.37,0:43:06.20,Default,,0,0,0,,Бұл соққылы мылтық.
Dialogue: 0,0:43:06.75,0:43:09.58,Default,,0,0,0,,Оның тек сізді таң қалдыратын күші бар.
Dialogue: 0,0:43:11.71,0:43:13.13,Default,,0,0,0,,Уау, керемет
Dialogue: 0,0:43:13.25,0:43:14.96,Default,,0,0,0,,Мен көрші ағашты көздедім.
Dialogue: 0,0:43:15.09,0:43:16.21,Default,,0,0,0,,Uhi~
Dialogue: 0,0:43:16.34,0:43:18.47,Default,,0,0,0,,Эй, сен неге Жерге келмейсің?
Dialogue: 0,0:43:22.05,0:43:24.47,Default,,0,0,0,,Біз планетамызды лақтырып тастай алмаймыз
Dialogue: 0,0:43:24.97,0:43:25.89,Default,,0,0,0,,Ах...
Dialogue: 0,0:43:39.07,0:43:40.24,Default,,0,0,0,,Хмм (Декисуги) Ммм
Dialogue: 0,0:43:42.16,0:43:43.20,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:43:44.20,0:43:47.95,Default,,0,0,0,,О, пайдасыз Нобитаны ішке кіргізбеймін.
Dialogue: 0,0:43:48.08,0:43:51.92,Default,,0,0,0,,Сол кіші мектеп оқушылары өздерінің ақымақтықтарымен ұшты.
Dialogue: 0,0:43:52.04,0:43:54.75,Default,,0,0,0,,Сонымен мен өзімнің көршімде көп шыныны сындырдым.
Dialogue: 0,0:43:54.96,0:43:57.00,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:43:57.30,0:43:58.80,Default,,0,0,0,,Нобитаның бұған қатысы жоқ!
Dialogue: 0,0:43:58.92,0:44:01.76,Default,,0,0,0,,Дұрыс, сол қорқынышты планетамен ойнаңыз.
Dialogue: 0,0:44:01.88,0:44:02.89,Default,,0,0,0,,...
Dialogue: 0,0:44:04.64,0:44:07.51,Default,,0,0,0,,Жарайды, мен де бұл жерде бос емеспін.
Dialogue: 0,0:44:12.90,0:44:13.77,Default,,0,0,0,,Әй
Dialogue: 0,0:44:16.73,0:44:17.90,Default,,0,0,0,,...
Dialogue: 0,0:44:18.03,0:44:20.24,Default,,0,0,0,,(Дораэмон гуілдейді)
Dialogue: 0,0:44:20.36,0:44:21.49,Default,,0,0,0,,Иә!?
Dialogue: 0,0:44:21.61,0:44:24.74,Default,,0,0,0,,Не болды? Мына ойыншықтарды әкел
Dialogue: 0,0:44:24.87,0:44:28.87,Default,,0,0,0,,Галтит кеншілерімен кездескенде, осыны оларға пайдаланыңыз.
Dialogue: 0,0:44:30.41,0:44:32.12,Default,,0,0,0,,Ал, бесік пен ату
Dialogue: 0,0:44:32.25,0:44:34.54,Default,,0,0,0,,Бұл сіздің ерекше шеберлігіңіз.
Dialogue: 0,0:44:34.67,0:44:36.54,Default,,0,0,0,,Бұл тығынның оғы, солай ма?
Dialogue: 0,0:44:36.67,0:44:38.13,Default,,0,0,0,,Жарайды, (Нобита) Жоқтан жақсы.
Dialogue: 0,0:44:38.71,0:44:39.42,Default,,0,0,0,,Үлкен аға
Dialogue: 0,0:44:40.21,0:44:41.76,Default,,0,0,0,,А, а, а (Нобита) А?
Dialogue: 0,0:44:41.88,0:44:43.72,Default,,0,0,0,,Не? Не? Кенеттен
Dialogue: 0,0:44:43.84,0:44:46.51,Default,,0,0,0,,Сіз әдеттегі тексеруді қайта өткізіп жібергіңіз келетін шығар!
Dialogue: 0,0:44:46.64,0:44:48.06,Default,,0,0,0,,Аа, дұрыс, Дорами.
Dialogue: 0,0:44:48.18,0:44:51.43,Default,,0,0,0,,Менің көршімде қауын пісіретін дәмді наубайхана ашылды.
Dialogue: 0,0:44:51.56,0:44:53.06,Default,,0,0,0,,Енді алдау болмайды
Dialogue: 0,0:44:53.69,0:44:56.52,Default,,0,0,0,,Нобита-сан, мен сенің ағаңды бір сәтке қарызға аламын.
Dialogue: 0,0:44:56.65,0:44:59.90,Default,,0,0,0,,Өлгенде жаман ой!
Dialogue: 0,0:45:03.70,0:45:07.03,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:45:07.16,0:45:09.33,Default,,0,0,0,,А? Ах!
Dialogue: 0,0:45:09.45,0:45:12.83,Default,,0,0,0,,Күте тұрыңыз, Барабан!
Dialogue: 0,0:45:14.83,0:45:16.71,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:45:19.59,0:45:22.55,Default,,0,0,0,,Мен кеттім...
Dialogue: 0,0:45:27.05,0:45:29.89,Default,,0,0,0,,Алдымен жалғыз баруым керек пе?
Dialogue: 0,0:45:37.52,0:45:38.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:40.40,0:45:41.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:44.99,0:45:46.41,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:45:46.82,0:45:49.12,Default,,0,0,0,,А... уау
Dialogue: 0,0:45:57.71,0:45:58.67,Default,,0,0,0,,Уау
Dialogue: 0,0:45:59.08,0:46:00.96,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:46:01.09,0:46:04.42,Default,,0,0,0,,Жақсы… Татата…
Dialogue: 0,0:46:04.55,0:46:05.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:09.30,0:46:12.01,Default,,0,0,0,,Сәлем, Ропле-кун
Dialogue: 0,0:46:13.02,0:46:14.93,Default,,0,0,0,,Уф
Dialogue: 0,0:46:15.60,0:46:17.31,Default,,0,0,0,,Ах!
Dialogue: 0,0:46:31.28,0:46:32.45,Default,,0,0,0,,Хмм...
Dialogue: 0,0:46:36.16,0:46:38.79,Default,,0,0,0,,Уау, сәлем~ Уау...
Dialogue: 0,0:46:40.88,0:46:42.71,Default,,0,0,0,,Уф уау
Dialogue: 0,0:46:43.00,0:46:47.01,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:46:48.51,0:46:51.01,Default,,0,0,0,,Ах, у... ха!
Dialogue: 0,0:46:51.68,0:46:53.47,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:46:53.60,0:46:55.85,Default,,0,0,0,,Уф...
Dialogue: 0,0:46:55.97,0:46:57.68,Default,,0,0,0,,Тайтер айтты
Dialogue: 0,0:46:57.81,0:47:01.44,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:47:01.56,0:47:02.23,Default,,0,0,0,,Уау
Dialogue: 0,0:47:02.90,0:47:06.78,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:47:07.07,0:47:10.82,Default,,0,0,0,,Маған көмектесші, Уау, Дораемон!
Dialogue: 0,0:47:10.95,0:47:14.95,Default,,0,0,0,,Шыу!
Dialogue: 0,0:47:19.16,0:47:21.08,Default,,0,0,0,,Ия, мен оны ұстадым!
Dialogue: 0,0:47:21.21,0:47:22.88,Default,,0,0,0,,Амансың ба? Нобита-сан
Dialogue: 0,0:47:23.00,0:47:25.50,Default,,0,0,0,,Ха, бұл қорқынышты болды.
Dialogue: 0,0:47:25.63,0:47:29.09,Default,,0,0,0,,Мен мұнда қайтып келгенімде, аяқ киіміңіз жатыр екен.
Dialogue: 0,0:47:29.22,0:47:32.26,Default,,0,0,0,,Рахмет сізге Дораемон Дорами-чан
Dialogue: 0,0:47:33.05,0:47:36.39,Default,,0,0,0,,Мұндай жерде кеңістік-уақыттың бұрмалануы қалай болуы мүмкін?
Dialogue: 0,0:47:36.81,0:47:39.18,Default,,0,0,0,,Неге?
Dialogue: 0,0:47:39.31,0:47:43.19,Default,,0,0,0,,А... бұл қауіпті, сондықтан оны осында жабық ұстайық.
Dialogue: 0,0:47:43.31,0:47:44.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:44.73,0:47:46.86,Default,,0,0,0,,Енді ойнағың келе ме? Көріскенше, Дорами-чан.
Dialogue: 0,0:47:46.98,0:47:48.61,Default,,0,0,0,,Севаши-кунға сәлем айтыңыз
Dialogue: 0,0:47:48.90,0:47:51.28,Default,,0,0,0,,Иә? біртүрлі аға
Dialogue: 0,0:47:53.28,0:47:55.53,Default,,0,0,0,,Не?
Dialogue: 0,0:47:55.74,0:47:57.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:48:01.33,0:48:02.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:04.33,0:48:06.75,Default,,0,0,0,,Байқауға жақын.
Dialogue: 0,0:48:06.88,0:48:09.42,Default,,0,0,0,,Ах, мүлде Нобита-кунтара
Dialogue: 0,0:48:09.55,0:48:12.59,Default,,0,0,0,,Егер Дорами білсе, мен оның не айтарын білмеймін.
Dialogue: 0,0:48:12.72,0:48:17.22,Default,,0,0,0,,Өйткені сен білмей тұрып, есіктің арасы кеңейіп кетті.
Dialogue: 0,0:48:20.35,0:48:22.56,Default,,0,0,0,,Өте қиын! Уау
Dialogue: 0,0:48:22.69,0:48:24.40,Default,,0,0,0,,Чумми, не болды?
Dialogue: 0,0:48:24.52,0:48:26.98,Default,,0,0,0,,Нобита-сан, Дора-чан, тағы да қарақшылар
Dialogue: 0,0:48:27.11,0:48:28.57,Default,,0,0,0,,Иә
Dialogue: 0,0:48:28.69,0:48:30.86,Default,,0,0,0,,А... (Нобита) Иә?
Dialogue: 0,0:48:30.99,0:48:32.03,Default,,0,0,0,,Ei
Dialogue: 0,0:48:33.41,0:48:34.87,Default,,0,0,0,,Амансың ба? Ропле-кун
Dialogue: 0,0:48:34.99,0:48:37.37,Default,,0,0,0,,А, Нобита-кун, бұл қауіпті, сондықтан ұста!
Dialogue: 0,0:48:37.49,0:48:38.45,Default,,0,0,0,,Міне, келді!
Dialogue: 0,0:48:39.24,0:48:40.37,Default,,0,0,0,,Уау (Чамми) Ах!
Dialogue: 0,0:48:40.50,0:48:41.75,Default,,0,0,0,,Додо (Нобита) Ах...
Dialogue: 0,0:48:46.63,0:48:49.21,Default,,0,0,0,,Жоқ, жылдамдықтар тым әртүрлі.
Dialogue: 0,0:48:50.13,0:48:51.34,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:48:51.47,0:48:53.55,Default,,0,0,0,,Уау Уау
Dialogue: 0,0:48:53.76,0:48:55.97,Default,,0,0,0,,Жарайды, маған қалдырыңыз!
Dialogue: 0,0:48:56.30,0:48:58.35,Default,,0,0,0,,Эх уа (Нобита) һә
Dialogue: 0,0:49:02.18,0:49:02.85,Default,,0,0,0,,13-ші мұғалімнің жаттығу тесті соңына дейін созылып кетті…
Dialogue: 0,0:49:03.14,0:49:03.85,Default,,0,0,0,,Ах
Dialogue: 0,0:49:06.02,0:49:08.15,Default,,0,0,0,,Уау...
Dialogue: 0,0:49:10.73,0:49:11.61,Default,,0,0,0,,Ах!
Dialogue: 0,0:49:12.82,0:49:14.03,Default,,0,0,0,,Дораэмон қауіпті!
Dialogue: 0,0:49:19.87,0:49:21.83,Default,,0,0,0,,Уау
Dialogue: 0,0:49:22.66,0:49:25.46,Default,,0,0,0,,Хирари плащы!
Dialogue: 0,0:49:25.58,0:49:26.75,Default,,0,0,0,,Уф
Dialogue: 0,0:49:29.63,0:49:32.80,Default,,0,0,0,,Уа (Чуми) Мен мұны істедім. Апыр-ай. Апыр-ай.
Dialogue: 0,0:49:32.92,0:49:34.34,Default,,0,0,0,,Мен мұны да басқара алмаймын.
Dialogue: 0,0:49:34.47,0:49:36.34,Default,,0,0,0,,Иә, мен шұғыл қонуға бара жатырмын.
Dialogue: 0,0:49:36.64,0:49:39.01,Default,,0,0,0,,Бұл қорқынышты болды~
Dialogue: 0,0:49:48.31,0:49:50.23,Default,,0,0,0,,Уау (Нобита) Уф...
Dialogue: 0,0:49:58.37,0:50:00.24,Default,,0,0,0,,Барлығы зардап шегеді ме?
Dialogue: 0,0:50:00.37,0:50:01.70,Default,,0,0,0,,Рахмет саған Дораемон
Dialogue: 0,0:50:01.83,0:50:02.49,Default,,0,0,0,,Фу~
Dialogue: 0,0:50:02.62,0:50:04.37,Default,,0,0,0,,О, мынаны қарашы.
Dialogue: 0,0:50:09.04,0:50:11.42,Default,,0,0,0,,Қандай қызық қарақшы кеме.
Dialogue: 0,0:50:11.55,0:50:13.59,Default,,0,0,0,,Тексеріп көрейік. Иә.
Dialogue: 0,0:50:13.71,0:50:16.01,Default,,0,0,0,,Бірақ скафандрсыз
Dialogue: 0,0:50:16.80,0:50:19.51,Default,,0,0,0,,Ал... жеуге болатын скафандр!
Dialogue: 0,0:50:20.10,0:50:22.97,Default,,0,0,0,,Мұны жеген кезде денеңізде оттегі пайда болады.
Dialogue: 0,0:50:23.10,0:50:25.27,Default,,0,0,0,,скафандр тәрізді қабық түзеді
Dialogue: 0,0:50:25.39,0:50:28.27,Default,,0,0,0,,Әй, Жердің өркениеті де ғажап, ғажап.
Dialogue: 0,0:50:30.02,0:50:30.69,Default,,0,0,0,,Иә? (Нобита) А
Dialogue: 0,0:50:31.48,0:50:33.23,Default,,0,0,0,,Гартитті өндіруші күзет қайығы.
Dialogue: 0,0:50:33.36,0:50:34.69,Default,,0,0,0,,Олар кімдер?
Dialogue: 0,0:50:35.32,0:50:36.19,Default,,0,0,0,,Уф
Dialogue: 0,0:50:36.36,0:50:37.78,Default,,0,0,0,,Қозғалмаңдар, бауырлар.
Dialogue: 0,0:50:39.87,0:50:42.37,Default,,0,0,0,,Сіз осындай әрекет жасағаныңыз үшін кешіре аламын деп ойлайсыз ба?
Dialogue: 0,0:50:42.49,0:50:43.99,Default,,0,0,0,,Шулы! Тынышсыңдар...
Dialogue: 0,0:50:44.12,0:50:45.87,Default,,0,0,0,,Мен Коя Коя планетасын тастап кетсем ғой.
Dialogue: 0,0:50:46.00,0:50:48.29,Default,,0,0,0,,Ол зардап шекпеді!
Dialogue: 0,0:50:48.58,0:50:50.42,Default,,0,0,0,,Кім кетеді?
Dialogue: 0,0:50:50.54,0:50:54.05,Default,,0,0,0,,Бұл менің әкем ашқан және біз ізашар болған планета.
Dialogue: 0,0:50:54.17,0:50:55.80,Default,,0,0,0,,Бұл мен сенің қолыңа беремін бе?
Dialogue: 0,0:50:56.63,0:50:58.63,Default,,0,0,0,,Онда оған көмектесу мүмкін емес.
Dialogue: 0,0:50:58.76,0:51:02.51,Default,,0,0,0,,Коякоя планетасына қайта оралуыңызды мүмкін етпейік.
Dialogue: 0,0:51:02.64,0:51:04.85,Default,,0,0,0,,Додо... Дораемон, тезірек маған бірдеңе беріңіз.
Dialogue: 0,0:51:04.97,0:51:06.60,Default,,0,0,0,,А, бұл емес...
Dialogue: 0,0:51:06.77,0:51:09.56,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:51:10.69,0:51:11.90,Default,,0,0,0,,Уф, сен бала болсаң да.
Dialogue: 0,0:51:12.02,0:51:13.82,Default,,0,0,0,,Сізді бірдеңенің мазалауына жол бермеңіз
Dialogue: 0,0:51:13.94,0:51:16.07,Default,,0,0,0,,Сіз шынымен де жарақат алғыңыз келетін сияқты.
Dialogue: 0,0:51:16.57,0:51:18.65,Default,,0,0,0,,Дораэмон тез
Dialogue: 0,0:51:19.20,0:51:21.70,Default,,0,0,0,,(Уно мен Күмәннің күлкісі)
Dialogue: 0,0:51:21.82,0:51:23.95,Default,,0,0,0,,О, бұл дұрыс емес...
Dialogue: 0,0:51:24.08,0:51:25.91,Default,,0,0,0,,(Уно мен Күмәннің күлкісі)
Dialogue: 0,0:51:26.04,0:51:27.45,Default,,0,0,0,,Вертолёт қонды.
Dialogue: 0,0:51:27.95,0:51:29.50,Default,,0,0,0,,Хмм (Нобита) Ахх
Dialogue: 0,0:51:29.62,0:51:31.50,Default,,0,0,0,,Ах!
Dialogue: 0,0:51:31.63,0:51:33.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:51:33.79,0:51:36.71,Default,,0,0,0,,Не? Бұл өтірік. Бұл тығын оғы.
Dialogue: 0,0:51:36.84,0:51:38.80,Default,,0,0,0,,Нобита-кун (Чуми) Таңғажайып таңғажайып
Dialogue: 0,0:51:39.09,0:51:40.93,Default,,0,0,0,,Жарайсың!
Dialogue: 0,0:51:41.05,0:51:41.72,Default,,0,0,0,,Иә
Dialogue: 0,0:51:41.84,0:51:44.26,Default,,0,0,0,,(Күзетшілердің айқайы)
Dialogue: 0,0:51:44.39,0:51:45.26,Default,,0,0,0,,Мм... иә?
Dialogue: 0,0:51:45.39,0:51:46.89,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:51:47.02,0:51:48.73,Default,,0,0,0,,Бұл! Қандай жігіт
Dialogue: 0,0:51:48.85,0:51:51.65,Default,,0,0,0,,Ой, оны тығын оқтарымен жеңе алмайсың ғой.
Dialogue: 0,0:51:51.77,0:51:53.98,Default,,0,0,0,,Тез қаш! Қараңыз
Dialogue: 0,0:51:54.11,0:51:56.15,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,0:51:59.07,0:52:00.61,Default,,0,0,0,,Иә? Нобита-кун күтті
Dialogue: 0,0:52:00.74,0:52:01.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:04.16,0:52:07.20,Default,,0,0,0,,Иә? Мен шынымен де тез болдым ба?
Dialogue: 0,0:52:07.33,0:52:09.62,Default,,0,0,0,,Иә? Мүмкін...
Dialogue: 0,0:52:11.00,0:52:12.37,Default,,0,0,0,,Йотто хой
Dialogue: 0,0:52:16.50,0:52:18.30,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:19.26,0:52:20.92,Default,,0,0,0,,Керемет Дораемон
Dialogue: 0,0:52:21.05,0:52:23.89,Default,,0,0,0,,Осы уақытқа дейін неге байқамадым?
Dialogue: 0,0:52:24.85,0:52:27.89,Default,,0,0,0,,Нобита-кун, біз Супермен боламыз!
Dialogue: 0,0:52:28.93,0:52:31.89,Default,,0,0,0,,Енді қашпасаң да жарайды, хехе
Dialogue: 0,0:52:32.02,0:52:33.90,Default,,0,0,0,,Қара (Нобита) Уау, уау...
Dialogue: 0,0:52:34.02,0:52:35.48,Default,,0,0,0,,Уау Уау Уау...
Dialogue: 0,0:52:35.61,0:52:37.19,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:37.32,0:52:38.19,Default,,0,0,0,,Бұл жігіт!
Dialogue: 0,0:52:38.90,0:52:40.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:42.57,0:52:43.66,Default,,0,0,0,,Ойлағанымдай, жұдырығыммен тиіп,
Dialogue: 0,0:52:45.16,0:52:45.95,Default,,0,0,0,,А...
Dialogue: 0,0:52:46.07,0:52:47.24,Default,,0,0,0,,Мынау!
Dialogue: 0,0:52:47.87,0:52:49.08,Default,,0,0,0,,Нобита-сан керемет
Dialogue: 0,0:52:49.20,0:52:51.29,Default,,0,0,0,,Қараңызшы, мен айтқандай болды, солай ма?
Dialogue: 0,0:52:51.41,0:52:54.00,Default,,0,0,0,,Рас, неге екені белгісіз күшейіп барады.
Dialogue: 0,0:52:54.29,0:52:56.38,Default,,0,0,0,,Бұл ауырлық күшінің айырмашылығына байланысты.
Dialogue: 0,0:52:56.50,0:52:58.63,Default,,0,0,0,,Эй, мен қайта ораламын.
Dialogue: 0,0:52:59.38,0:53:01.63,Default,,0,0,0,,Фу Эй Ха (Дораэмон ызылдайды)
Dialogue: 0,0:53:01.80,0:53:03.43,Default,,0,0,0,,Жарайды, мен де!
Dialogue: 0,0:53:04.18,0:53:04.84,Default,,0,0,0,,Әй
Dialogue: 0,0:53:05.26,0:53:08.89,Default,,0,0,0,,Ха ха ха
Dialogue: 0,0:53:09.01,0:53:09.97,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:53:11.77,0:53:12.85,Default,,0,0,0,,Жылы...
Dialogue: 0,0:53:15.31,0:53:17.44,Default,,0,0,0,,Хаха... (Күзетші) Тоқта, күт!
Dialogue: 0,0:53:21.40,0:53:22.69,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:53:22.82,0:53:24.11,Default,,0,0,0,,Дохья!
Dialogue: 0,0:53:24.32,0:53:26.16,Default,,0,0,0,,Ах, сонда ол ма еді?
Dialogue: 0,0:53:26.28,0:53:28.20,Default,,0,0,0,,Ол менің арқамда. Арқаммен жалғанған.
Dialogue: 0,0:53:28.33,0:53:29.74,Default,,0,0,0,,Ой!
Dialogue: 0,0:53:29.87,0:53:31.54,Default,,0,0,0,,(Күзетшілердің айқайы)
Dialogue: 0,0:53:31.66,0:53:33.00,Default,,0,0,0,,Гяаа
Dialogue: 0,0:53:33.12,0:53:36.37,Default,,0,0,0,,Уф...
Dialogue: 0,0:53:36.88,0:53:38.88,Default,,0,0,0,,(Дораэмон мен Нобитаның күлкісі)
Dialogue: 0,0:53:44.09,0:53:48.01,Default,,0,0,0,,Мен таң қалдым, Нобита-кун. Жердегілер керемет.
Dialogue: 0,0:53:48.14,0:53:49.85,Default,,0,0,0,,Түс сияқты
Dialogue: 0,0:53:50.60,0:53:53.10,Default,,0,0,0,,Аа, дұрыс, бұл арман екені сөзсіз.
Dialogue: 0,0:53:53.22,0:53:55.73,Default,,0,0,0,,Ол ән соншалықты терең.
Dialogue: 0,0:53:55.98,0:53:58.44,Default,,0,0,0,,Армандарды тексеру машинасы
Dialogue: 0,0:53:59.69,0:54:00.86,Default,,0,0,0,,Ауырды
Dialogue: 0,0:54:00.98,0:54:02.90,Default,,0,0,0,,Қараңызшы, бұл түс емес еді ғой?
Dialogue: 0,0:54:03.03,0:54:05.57,Default,,0,0,0,,Ауырды, бірақ мен бақыттымын.
Dialogue: 0,0:54:05.70,0:54:09.03,Default,,0,0,0,,Роппуру-кун, тез үйге барып, полицияға хабарлайық.
Dialogue: 0,0:54:09.16,0:54:11.12,Default,,0,0,0,,Біздің жүк кемесі де
Dialogue: 0,0:54:11.24,0:54:14.62,Default,,0,0,0,,Уайымдамаңыз, менде Дораэмонның фурошикі уақыты бар.
Dialogue: 0,0:54:15.41,0:54:16.75,Default,,0,0,0,,Хе хехе
Dialogue: 0,0:54:16.87,0:54:18.88,Default,,0,0,0,,Хм
Dialogue: 0,0:54:20.34,0:54:22.17,Default,,0,0,0,,Барлығына көрсеткім келді.
Dialogue: 0,0:54:22.88,0:54:25.55,Default,,0,0,0,,«Мен оны тіпті көрмеймін» десем, дәл осылай айтқым келеді.
Dialogue: 0,0:54:25.67,0:54:26.42,Default,,0,0,0,,Бір сәтте
Dialogue: 0,0:54:26.55,0:54:28.72,Default,,0,0,0,,Мен Галтит кеншілерін жеңдім.
Dialogue: 0,0:54:28.84,0:54:31.14,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:54:31.30,0:54:33.10,Default,,0,0,0,,Әй, бұл керемет.
Dialogue: 0,0:54:33.22,0:54:35.14,Default,,0,0,0,,Ей, бұл маңызды емес.
Dialogue: 0,0:54:35.27,0:54:37.19,Default,,0,0,0,,Нобита-сан күшті ғой, солай емес пе?
Dialogue: 0,0:54:37.31,0:54:40.11,Default,,0,0,0,,Дора-чанның тепкені де керемет болды.
Dialogue: 0,0:54:40.23,0:54:41.86,Default,,0,0,0,,Олай емес~
Dialogue: 0,0:54:42.44,0:54:46.61,Default,,0,0,0,,Егер Нобита-кун және басқалары осында болса, біз қатты жеңілденеміз.
Dialogue: 0,0:54:47.07,0:54:50.57,Default,,0,0,0,,Енді біз галтит тау-кен өнеркәсібіне тиісе алмаймыз.
Dialogue: 0,0:54:50.70,0:54:53.54,Default,,0,0,0,,(Каморандардың күлкісі)
Dialogue: 0,0:54:55.33,0:54:57.16,Default,,0,0,0,,Бұл қиын, Роппл.
Dialogue: 0,0:54:59.50,0:55:00.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:55:01.00,0:55:03.71,Default,,0,0,0,,Иә? Гартит кеншілері жоғалып кетті ме?
Dialogue: 0,0:55:04.46,0:55:05.71,Default,,0,0,0,,Мен дереу жүгірдім.
Dialogue: 0,0:55:05.96,0:55:08.97,Default,,0,0,0,,Сынған патрульдік қайықтың бір бөлігі де табылмады.
Dialogue: 0,0:55:09.63,0:55:11.26,Default,,0,0,0,,Бірақ, әрине, біз...
Dialogue: 0,0:55:13.01,0:55:14.26,Default,,0,0,0,,Сәлем Нобита-кун
Dialogue: 0,0:55:14.39,0:55:16.47,Default,,0,0,0,,Қалайша полициядан жылдам қашуға болады?
Dialogue: 0,0:55:16.60,0:55:19.60,Default,,0,0,0,,Менің достарымның жақын жерде болғанына сенімдімін.
Dialogue: 0,0:55:19.85,0:55:23.11,Default,,0,0,0,,Бұл шынымен Гартит тау-кен патрульдік қайығы болды ма?
Dialogue: 0,0:55:23.52,0:55:26.36,Default,,0,0,0,,Өтірік айтпаймын, көрдім.
Dialogue: 0,0:55:26.74,0:55:30.32,Default,,0,0,0,,Өкінішке орай, біз полиция қызметкерлері дәлелсіз әрекет ете алмаймыз.
Dialogue: 0,0:55:32.91,0:55:35.70,Default,,0,0,0,,Мен қазір қауіпсізмін деп ойладым.
Dialogue: 0,0:55:35.83,0:55:38.29,Default,,0,0,0,,Қудалау одан да нашарлауы мүмкін.
Dialogue: 0,0:55:38.41,0:55:40.42,Default,,0,0,0,,Мен мұны енді қаламаймын.
Dialogue: 0,0:55:40.62,0:55:42.71,Default,,0,0,0,,Аға, аға.
Dialogue: 0,0:55:45.17,0:55:46.30,Default,,0,0,0,,Молина
Dialogue: 0,0:55:48.26,0:55:49.97,Default,,0,0,0,,Қауіпті ештеңе жасамаңыз
Dialogue: 0,0:55:50.09,0:55:52.30,Default,,0,0,0,,Ропплге жақсылап айтыңыз.
Dialogue: 0,0:55:59.52,0:56:02.19,Default,,0,0,0,,Полиция шынымен сенімсіз.
Dialogue: 0,0:56:02.31,0:56:04.11,Default,,0,0,0,,Бауырым, бізде бар
Dialogue: 0,0:56:04.23,0:56:06.40,Default,,0,0,0,,Нобита-сан мен Дора-чан осында.
Dialogue: 0,0:56:06.52,0:56:09.36,Default,,0,0,0,,Дұрыс, дұрыс, көңіл көтеріңдер.
Dialogue: 0,0:56:09.82,0:56:10.99,Default,,0,0,0,,Иә.
Dialogue: 0,0:56:11.45,0:56:14.07,Default,,0,0,0,,Бұл әкемнің естелігі.
Dialogue: 0,0:56:14.20,0:56:16.33,Default,,0,0,0,,Нобита-кун маған қарағанда көбірек болуы керек.
Dialogue: 0,0:56:16.62,0:56:19.04,Default,,0,0,0,,Не, сонша маңызды нәрсе ме?
Dialogue: 0,0:56:19.16,0:56:22.29,Default,,0,0,0,,Сізде болса пайдалырақ болар еді.
Dialogue: 0,0:56:22.42,0:56:23.37,Default,,0,0,0,,Хмм...
Dialogue: 0,0:56:26.34,0:56:28.30,Default,,0,0,0,,Менің сыйлығым мынау.
Dialogue: 0,0:56:28.59,0:56:31.72,Default,,0,0,0,,Мен бұл планетада гүлдеген қар гүлдерін бастым.
Dialogue: 0,0:56:32.18,0:56:34.14,Default,,0,0,0,,Әй, әдемі екен.
Dialogue: 0,0:56:34.26,0:56:36.22,Default,,0,0,0,,Қарашы, менде де бар (Нобита), иә?
Dialogue: 0,0:56:36.60,0:56:40.27,Default,,0,0,0,,Бұл менің өлген әкемнің сүйікті гүлі.
Dialogue: 0,0:56:40.52,0:56:43.52,Default,,0,0,0,,Біз үшін бойтұмар сияқты.
Dialogue: 0,0:56:43.65,0:56:45.81,Default,,0,0,0,,А... Рахмет
Dialogue: 0,0:56:46.36,0:56:48.86,Default,,0,0,0,,Бұл шерифтің белгісіне ұқсайды.
Dialogue: 0,0:56:53.91,0:56:55.62,Default,,0,0,0,,Уау!
Dialogue: 0,0:56:56.28,0:56:59.24,Default,,0,0,0,,Бізді қорғауды жалғастырыңыз.
Dialogue: 0,0:56:59.49,0:57:02.33,Default,,0,0,0,,Әрине, мен қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:57:05.50,0:57:07.00,Default,,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:57:14.55,0:57:16.39,Default,,0,0,0,,Сосын мен тағы келемін.
Dialogue: 0,0:57:19.01,0:57:19.60,Default,,0,0,0,,Қашанға дейін—
Dialogue: 0,0:57:19.68,0:57:21.22,Default,,0,0,0,,Қосылған ба? (Есік жабылған дыбыс)
Dialogue: 0,0:57:21.35,0:57:23.27,Default,,0,0,0,,Жүк кемесінің есігі
Dialogue: 0,0:57:23.39,0:57:26.94,Default,,0,0,0,,Кеңістік-уақыттың бұрмалануы қайтадан сәл кеңейді.
Dialogue: 0,0:57:27.06,0:57:32.15,Default,,0,0,0,,Мен оның ешқашан жоғалып кетпеуін қалаймын, мәңгі және мәңгі.
Dialogue: 0,0:57:52.13,0:57:53.51,Default,,0,0,0,,Хмм... Ах.
Dialogue: 0,0:57:53.80,0:57:56.01,Default,,0,0,0,,Иаааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:57:58.34,0:58:02.14,Default,,0,0,0,,Міне, Гильермин мырза, бізге келгеніңізге рахмет.
Dialogue: 0,0:58:02.60,0:58:05.06,Default,,0,0,0,,Баккара меңгерушісі, сіз қате жібердіңіз.
Dialogue: 0,0:58:05.19,0:58:08.61,Default,,0,0,0,,Полиция біздің не істеп жатқанымызды анықтамақ болды.
Dialogue: 0,0:58:08.73,0:58:09.86,Default,,0,0,0,,Ал...
Dialogue: 0,0:58:09.98,0:58:13.03,Default,,0,0,0,,Не? Хаха...
Dialogue: 0,0:58:13.74,0:58:16.32,Default,,0,0,0,,Не деген сұмдық, ақымақ!
Dialogue: 0,0:58:16.91,0:58:19.53,Default,,0,0,0,,Бірақ бастықтар жай ғана адамдар емес.
Dialogue: 0,0:58:19.66,0:58:21.87,Default,,0,0,0,,Мені бала мен енот ит қолсыз айналдырды.
Dialogue: 0,0:58:21.99,0:58:24.00,Default,,0,0,0,,Бұл хабарлауға болатын нәрсе ме? Ой... аа
Dialogue: 0,0:58:24.33,0:58:26.83,Default,,0,0,0,,Иә, бұл мен естіген Супермен.
Dialogue: 0,0:58:26.96,0:58:28.12,Default,,0,0,0,,Бұл дұрыс, дұрыс.
Dialogue: 0,0:58:28.25,0:58:30.04,Default,,0,0,0,,Ақтау жоқ
Dialogue: 0,0:58:30.71,0:58:33.21,Default,,0,0,0,,Мазасыздықтан дереу құтылыңыз.
Dialogue: 0,0:58:33.42,0:58:34.67,Default,,0,0,0,,Қызымнан күткенімдей.
Dialogue: 0,0:58:43.06,0:58:46.48,Default,,0,0,0,,Бұл өте жақсы жұлдыз емес пе? Бұны ұнатамын.
Dialogue: 0,0:58:47.77,0:58:51.02,Default,,0,0,0,,Иммигранттар тобының жігіттері өте қыңыр, мен қиналамын.
Dialogue: 0,0:58:52.69,0:58:53.36,Default,,0,0,0,,Сәлем
Dialogue: 0,0:58:58.61,0:59:02.99,Default,,0,0,0,,Хехе, маған қалдырыңыз хехехехе...
Dialogue: 0,0:59:05.50,0:59:07.29,Default,,0,0,0,,Жарайды, бүгін де жасайық!
Dialogue: 0,0:59:07.41,0:59:10.42,Default,,0,0,0,,Хехехехехехехехе
Dialogue: 0,0:59:10.54,0:59:12.13,Default,,0,0,0,,Ха-ха
Dialogue: 0,0:59:12.25,0:59:13.80,Default,,0,0,0,,Жүріңдер, арамзалар!
Dialogue: 0,0:59:13.92,0:59:16.59,Default,,0,0,0,,Super Nobitaman сіздің қарсыласыңыз болады.
Dialogue: 0,0:59:22.22,0:59:23.05,Default,,0,0,0,,Желдей жылдам шабуыл!
Dialogue: 0,0:59:24.68,0:59:26.77,Default,,0,0,0,,Ха ха
Dialogue: 0,0:59:28.73,0:59:30.27,Default,,0,0,0,,Иә?Ах...
Dialogue: 0,0:59:32.02,0:59:33.94,Default,,0,0,0,,Уау... Уау.
Dialogue: 0,0:59:34.07,0:59:34.98,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:59:35.11,0:59:37.99,Default,,0,0,0,,Мен көрдім мен көрдім хахаха
Dialogue: 0,0:59:38.11,0:59:39.90,Default,,0,0,0,,Әлі де ебедейсіз жігіт
Dialogue: 0,0:59:40.03,0:59:42.87,Default,,0,0,0,,Нобита - бұл Нобита, ахахха...
Dialogue: 0,0:59:42.99,0:59:44.33,Default,,0,0,0,,Ах...
Dialogue: 0,0:59:44.45,0:59:46.45,Default,,0,0,0,,Эй, Сунео, біз де бүгінгі матчта жеңеміз.
Dialogue: 0,0:59:46.58,0:59:50.33,Default,,0,0,0,,Мен Нобитаны кіргізбеймін. Эй! Ахха~
Dialogue: 0,0:59:51.25,0:59:54.71,Default,,0,0,0,,Нобита-сан, неге жараспаймыз?
Dialogue: 0,0:59:56.25,0:59:57.96,Default,,0,0,0,,Бұл менің кінәм емес.
Dialogue: 0,0:59:58.09,1:00:01.59,Default,,0,0,0,,Алыптар кешірім сұраса, мен оларды кешіре аламын.
Dialogue: 0,1:00:01.72,1:00:03.85,Default,,0,0,0,,Мені Коя Коя планетасы күтіп тұр.
Dialogue: 0,1:00:03.97,1:00:05.56,Default,,0,0,0,,Ноби-чан!
Dialogue: 0,1:00:06.39,1:00:07.85,Default,,0,0,0,,Уф...
Dialogue: 0,1:00:08.06,1:00:10.85,Default,,0,0,0,,Сіз тағы да осындай нәрсені жасырдыңыз.
Dialogue: 0,1:00:11.52,1:00:13.69,Default,,0,0,0,,Мен сені бүгін кешірмеймін!
Dialogue: 0,1:00:13.81,1:00:15.36,Default,,0,0,0,,Хмм...
Dialogue: 0,1:00:16.07,1:00:17.48,Default,,0,0,0,,Жоқ! Бұл жақсы
Dialogue: 0,1:00:17.61,1:00:20.57,Default,,0,0,0,,Әзірше сыртқа шықпаңыз. Жақсы оқы!
Dialogue: 0,1:00:20.70,1:00:21.99,Default,,0,0,0,,Жоғары?
Dialogue: 0,1:00:22.57,1:00:25.78,Default,,0,0,0,,Аа, жер бетінде жаман ештеңе болмайды.
Dialogue: 0,1:00:25.91,1:00:29.00,Default,,0,0,0,,Менің көбірек оқудан басқа амалым жоқ.
Dialogue: 0,1:00:29.75,1:00:31.75,Default,,0,0,0,,Жарайды, кеттік! Ммм
Dialogue: 0,1:00:31.96,1:00:33.25,Default,,0,0,0,,Хмм... иә!?
Dialogue: 0,1:00:33.63,1:00:35.38,Default,,0,0,0,,Мама маған тағы ұрысады.
Dialogue: 0,1:00:35.50,1:00:38.00,Default,,0,0,0,,Сыртқа шығу дегеніміз – сыртқа шығу, солай ма?
Dialogue: 0,1:00:38.13,1:00:41.05,Default,,0,0,0,,Тек татамидің астына түсуіміз керек емес пе?
Dialogue: 0,1:00:41.17,1:00:44.30,Default,,0,0,0,,Мен сылтау айтуда өте жақсымын.
Dialogue: 0,1:00:44.43,1:00:45.26,Default,,0,0,0,,Хе хехе хехе
Dialogue: 0,1:00:47.35,1:00:49.06,Default,,0,0,0,,Кеңістіктің арғы жағына барайық!
Dialogue: 0,1:00:49.18,1:00:51.02,Default,,0,0,0,,Фуфу~н
Dialogue: 0,1:00:52.31,1:00:54.35,Default,,0,0,0,,Иә? Ахх
Dialogue: 0,1:00:54.48,1:00:58.15,Default,,0,0,0,,Роппуру-кун, Нобита-сан және Дора-чан келді.
Dialogue: 0,1:00:58.27,1:00:59.23,Default,,0,0,0,,Иә
Dialogue: 0,1:00:59.90,1:01:02.78,Default,,0,0,0,,Эй Чумми, саған еш қиындық жоқ, солай ма?
Dialogue: 0,1:01:03.07,1:01:04.07,Default,,0,0,0,,Нобита-сан
Dialogue: 0,1:01:04.20,1:01:05.78,Default,,0,0,0,,Қош келдіңіз, мен сізді күттім.
Dialogue: 0,1:01:07.24,1:01:08.03,Default,,0,0,0,,Ах...
Dialogue: 0,1:01:09.83,1:01:11.79,Default,,0,0,0,,Хахаха... (Клем мен Ропплдың күлкілері)
Dialogue: 0,1:01:12.96,1:01:14.75,Default,,0,0,0,,Жерден өте ерекшеленеді
Dialogue: 0,1:01:14.87,1:01:18.09,Default,,0,0,0,,Мұнда мені күтіп отырған адамдар бар.
Dialogue: 0,1:01:18.46,1:01:19.67,Default,,0,0,0,,Иә?
Dialogue: 0,1:01:19.80,1:01:21.21,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:01:21.55,1:01:24.26,Default,,0,0,0,,Мм, сен жақсы жігітсің.
Dialogue: 0,1:01:24.38,1:01:25.76,Default,,0,0,0,,Не болды? Нобита-кун
Dialogue: 0,1:01:25.89,1:01:27.89,Default,,0,0,0,,Жоқ, бұл ештеңе емес.
Dialogue: 0,1:01:28.01,1:01:29.64,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,1:02:10.30,1:02:12.72,Default,,0,0,0,,Уау, Нобита-сан, бұл керемет.
Dialogue: 0,1:02:12.85,1:02:14.81,Default,,0,0,0,,Ахаха хахаха...
Dialogue: 0,1:02:15.14,1:02:17.31,Default,,0,0,0,,Иә? Аяторика?
Dialogue: 0,1:02:22.69,1:02:23.94,Default,,0,0,0,,Дәмді!
Dialogue: 0,1:02:24.07,1:02:27.16,Default,,0,0,0,,Ахаха~ Онда мен саған бәрін беремін!
Dialogue: 0,1:02:27.41,1:02:30.58,Default,,0,0,0,,Ей, сараң Дораемон сирек кездеседі.
Dialogue: 0,1:02:30.70,1:02:32.12,Default,,0,0,0,,Тағы не!
Dialogue: 0,1:02:32.24,1:02:35.25,Default,,0,0,0,,(Нобита мен оның достарының күлкісі)
Dialogue: 0,1:02:39.17,1:02:42.67,Default,,0,0,0,,(шұңқырлар ыңырсып)
Dialogue: 0,1:02:44.76,1:02:46.51,Default,,0,0,0,,(Күзетшілер айғайлайды)
Dialogue: 0,1:02:49.59,1:02:51.47,Default,,0,0,0,,Уау~
Dialogue: 0,1:02:51.60,1:02:55.68,Default,,0,0,0,,Тоқта, дала бытыраңқы болады!
Dialogue: 0,1:02:55.81,1:02:59.40,Default,,0,0,0,,Мен зиянкестерді құртып жатырмын, сондықтан маған рахмет айтқым келеді.
Dialogue: 0,1:02:59.52,1:03:02.48,Default,,0,0,0,,Өзіңізді алдамаңыз! Мен полицияға шағымданамын!
Dialogue: 0,1:03:02.73,1:03:05.03,Default,,0,0,0,,Құлпынайлар қайда қашады?
Dialogue: 0,1:03:05.15,1:03:08.49,Default,,0,0,0,,Біз мұны түсінбейміз.
Dialogue: 0,1:03:09.16,1:03:12.45,Default,,0,0,0,,Менің өрісімнен кет! Ешқандай аямаймын!
Dialogue: 0,1:03:13.20,1:03:15.50,Default,,0,0,0,,Қарт адамдарға қауіп төніп тұр, сонда болыңыз!
Dialogue: 0,1:03:15.70,1:03:17.66,Default,,0,0,0,,О, менің...
Dialogue: 0,1:03:17.79,1:03:18.62,Default,,0,0,0,,Әке!
Dialogue: 0,1:03:18.75,1:03:20.21,Default,,0,0,0,,(күзетшілердің күлкісі)
Dialogue: 0,1:03:20.33,1:03:21.46,Default,,0,0,0,,Сол жігіттер
Dialogue: 0,1:03:22.79,1:03:23.46,Default,,0,0,0,,Ах...
Dialogue: 0,1:03:25.71,1:03:27.97,Default,,0,0,0,,Ах, менің өрісім
Dialogue: 0,1:03:28.09,1:03:29.34,Default,,0,0,0,,Күте тұрыңыз! Уф?
Dialogue: 0,1:03:29.47,1:03:30.93,Default,,0,0,0,,Күтіңіз, күтіңіз!
Dialogue: 0,1:03:34.35,1:03:37.02,Default,,0,0,0,,Тексер, келдің бе?
Dialogue: 0,1:03:49.99,1:03:52.11,Default,,0,0,0,,Қазір бұл өрістен кетіңіз!
Dialogue: 0,1:03:52.62,1:03:54.87,Default,,0,0,0,,Балалар, сендер бұл планетаны тастап кетіңдер!
Dialogue: 0,1:03:54.99,1:03:58.66,Default,,0,0,0,,Жаңа иммигранттарды күшпен қайтару дұрыс емес.
Dialogue: 0,1:03:58.79,1:03:59.58,Default,,0,0,0,,Уау
Dialogue: 0,1:04:07.09,1:04:09.13,Default,,0,0,0,,Келіңіздер! Ілгері жүру!
Dialogue: 0,1:04:10.51,1:04:11.88,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,1:04:12.01,1:04:13.85,Default,,0,0,0,,(Слагтардың айқайы)
Dialogue: 0,1:04:13.97,1:04:14.89,Default,,0,0,0,,А-а-а
Dialogue: 0,1:04:15.43,1:04:17.27,Default,,0,0,0,,Бұл жігіт ше?
Dialogue: 0,1:04:26.98,1:04:28.40,Default,,0,0,0,,О, жақсы!
Dialogue: 0,1:04:28.53,1:04:29.78,Default,,0,0,0,,Қандай адамдар!
Dialogue: 0,1:04:31.20,1:04:34.16,Default,,0,0,0,,Ол бала емес пе еді?
Dialogue: 0,1:04:35.70,1:04:38.95,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,1:04:39.08,1:04:43.04,Default,,0,0,0,,Әлгі бала галтит жігіттерін тағы қуып жіберді.
Dialogue: 0,1:04:43.17,1:04:44.96,Default,,0,0,0,,О, шынымен бе?
Dialogue: 0,1:04:45.21,1:04:47.59,Default,,0,0,0,,Ропл айтқандай емес пе?
Dialogue: 0,1:04:47.71,1:04:50.59,Default,,0,0,0,,Мен ол балаларға әу бастан сендім.
Dialogue: 0,1:04:50.72,1:04:51.80,Default,,0,0,0,,Мен де
Dialogue: 0,1:04:52.51,1:04:54.47,Default,,0,0,0,,Әкім алқабында да пайда болды
Dialogue: 0,1:04:54.59,1:04:57.35,Default,,0,0,0,,Ол маған атын да айтпай кетіп қалды.
Dialogue: 0,1:04:57.47,1:04:58.97,Default,,0,0,0,,Бұл үлкен мәселе.
Dialogue: 0,1:04:59.14,1:05:00.73,Default,,0,0,0,,Ол бала осында болғанша
Dialogue: 0,1:05:00.85,1:05:04.02,Default,,0,0,0,,Енді сол Гартит жігіттерінен қорқудың қажеті жоқ.
Dialogue: 0,1:05:04.15,1:05:06.36,Default,,0,0,0,,Бұл жүк қоймасынан келеді.
Dialogue: 0,1:05:06.48,1:05:07.86,Default,,0,0,0,,Иә
Dialogue: 0,1:05:07.98,1:05:09.90,Default,,0,0,0,,Сәлем, Молина!
Dialogue: 0,1:05:10.03,1:05:12.49,Default,,0,0,0,,Жер тұрғынын кездестірдіңіз бе?
Dialogue: 0,1:05:12.99,1:05:16.07,Default,,0,0,0,,Ол кәдімгі бала еді.
Dialogue: 0,1:05:22.20,1:05:26.29,Default,,0,0,0,,Сіз әлі де әкеңіз үшін алаңдайсыз ба?
Dialogue: 0,1:05:26.42,1:05:28.92,Default,,0,0,0,,Бұл түсінікті деп ойлаймын.
Dialogue: 0,1:05:34.51,1:05:37.64,Default,,0,0,0,,Бұл біртүрлі. Бәрі өліп жатыр.
Dialogue: 0,1:05:38.55,1:05:40.26,Default,,0,0,0,,Не болды? Ропле-кун
Dialogue: 0,1:05:40.39,1:05:43.14,Default,,0,0,0,,Мен оны күнде дұрыстап суарып жатырмын, бірақ мынаны қараңыз.
Dialogue: 0,1:05:43.27,1:05:44.73,Default,,0,0,0,,Уф (Нобита) Бұл қорқынышты.
Dialogue: 0,1:05:44.85,1:05:46.02,Default,,0,0,0,,Үлкен аға!
Dialogue: 0,1:05:46.10,1:05:49.69,Default,,0,0,0,,Тіпті Каморалар отбасында да егін кенеттен қурап қалады.
Dialogue: 0,1:05:50.36,1:05:52.19,Default,,0,0,0,,Иә? (Чамми) Бұл қиын!
Dialogue: 0,1:05:52.32,1:05:55.20,Default,,0,0,0,,Қатты! Кел, кел.
Dialogue: 0,1:05:55.32,1:05:57.07,Default,,0,0,0,,(Бақалардың ыңылдауы)
Dialogue: 0,1:05:57.20,1:06:00.49,Default,,0,0,0,,Қараңдаршы, бақалар қиналып жатыр.
Dialogue: 0,1:06:01.58,1:06:03.75,Default,,0,0,0,,Дораемон тым күлкілі.
Dialogue: 0,1:06:03.87,1:06:07.67,Default,,0,0,0,,Иә, бұл өзендегі суда ақау бар шығар.
Dialogue: 0,1:06:07.79,1:06:10.84,Default,,0,0,0,,Rople-kun, we'll investigate. Барайық.
Dialogue: 0,1:06:10.96,1:06:12.80,Default,,0,0,0,,Мен қараймын.
Dialogue: 0,1:06:12.92,1:06:14.84,Default,,0,0,0,,Абайлаңыз (Нобита) Иә.
Dialogue: 0,1:06:18.18,1:06:20.72,Default,,0,0,0,,Дақылдар өзенге жақын өледі.
Dialogue: 0,1:06:20.85,1:06:23.81,Default,,0,0,0,,Бұл жерде жоғарыда бірдеңе болуы керек.
Dialogue: 0,1:06:43.83,1:06:44.66,Default,,0,0,0,,Ах
Dialogue: 0,1:06:44.79,1:06:46.41,Default,,0,0,0,,Дораэмонға қараңыз
Dialogue: 0,1:06:46.54,1:06:47.79,Default,,0,0,0,,Иә
Dialogue: 0,1:06:56.51,1:06:59.39,Default,,0,0,0,,Болды, уы ағып тұрды.
Dialogue: 0,1:06:59.51,1:07:00.47,Default,,0,0,0,,Ах
Dialogue: 0,1:07:07.27,1:07:07.94,Default,,0,0,0,,Ах...
Dialogue: 0,1:07:08.48,1:07:10.81,Default,,0,0,0,,Уф... (Нобита) Ах.
Dialogue: 0,1:07:11.44,1:07:13.23,Default,,0,0,0,,Хехе, осында.
Dialogue: 0,1:07:13.36,1:07:15.94,Default,,0,0,0,,Мен сенен елсіз жерге келем деп ойламадым.
Dialogue: 0,1:07:16.11,1:07:17.70,Default,,0,0,0,,Олар ақымақ.
Dialogue: 0,1:07:17.82,1:07:18.95,Default,,0,0,0,,(Уно мен Күмәннің күлкісі)
Dialogue: 0,1:07:27.04,1:07:28.96,Default,,0,0,0,,Иә? Хмм
Dialogue: 0,1:07:32.13,1:07:33.67,Default,,0,0,0,,Қауіпті!
Dialogue: 0,1:07:36.30,1:07:36.96,Default,,0,0,0,,Ах!
Dialogue: 0,1:07:39.68,1:07:40.97,Default,,0,0,0,,Ах!
Dialogue: 0,1:07:42.22,1:07:44.47,Default,,0,0,0,,Бұл сіз үшін дайындалған лазер.
Dialogue: 0,1:07:44.85,1:07:46.47,Default,,0,0,0,,Жеңдер! (Uno) Жаса!
Dialogue: 0,1:07:47.31,1:07:48.23,Default,,0,0,0,,Ооо
Dialogue: 0,1:07:51.31,1:07:53.77,Default,,0,0,0,,Әй, уау!
Dialogue: 0,1:07:54.36,1:07:56.65,Default,,0,0,0,,Қараңдаршы, мен қолымды да, аяғымды да қозғалта алмаймын.
Dialogue: 0,1:07:56.78,1:07:57.49,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,1:08:06.87,1:08:07.66,Default,,0,0,0,,Иә?
Dialogue: 0,1:08:07.79,1:08:09.71,Default,,0,0,0,,Уау!!
Dialogue: 0,1:08:10.25,1:08:12.08,Default,,0,0,0,,Бұл сіздің де соңыңыз.
Dialogue: 0,1:08:12.21,1:08:13.17,Default,,0,0,0,,Бітті.
Dialogue: 0,1:08:13.96,1:08:15.63,Default,,0,0,0,,Мм... (Нобита) Уау.
Dialogue: 0,1:08:15.75,1:08:18.67,Default,,0,0,0,,Мм... Иә? (Нобита) Тез, тез
Dialogue: 0,1:08:18.80,1:08:21.59,Default,,0,0,0,,А, бұл біртүрлі (Нобита) Тезірек!
Dialogue: 0,1:08:23.59,1:08:25.64,Default,,0,0,0,,Асығыңыз, асығыңыз!
Dialogue: 0,1:08:25.76,1:08:28.14,Default,,0,0,0,,Иә? иә? (Нобита) Қараңызшы, ә!
Dialogue: 0,1:08:29.56,1:08:30.60,Default,,0,0,0,,Уау
Dialogue: 0,1:08:40.11,1:08:42.32,Default,,0,0,0,,Хирари
Dialogue: 0,1:08:43.53,1:08:45.70,Default,,0,0,0,,Жадағай!
Dialogue: 0,1:08:46.95,1:08:49.70,Default,,0,0,0,,Уау
Dialogue: 0,1:08:58.84,1:09:01.22,Default,,0,0,0,,Нобита-кун, бұл жолы дәлелді ал.
Dialogue: 0,1:09:01.34,1:09:02.68,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,1:09:06.76,1:09:07.68,Default,,0,0,0,,Га
Dialogue: 0,1:09:09.01,1:09:10.31,Default,,0,0,0,,(Күзетшілердің үрейлі дауыстары)
Dialogue: 0,1:09:10.68,1:09:12.94,Default,,0,0,0,,Олар кімдер?
Dialogue: 0,1:09:13.06,1:09:16.90,Default,,0,0,0,,Жасайық, Жерлестер, жарылар кез.
Dialogue: 0,1:09:17.86,1:09:18.77,Default,,0,0,0,,Уау
Dialogue: 0,1:09:21.82,1:09:24.07,Default,,0,0,0,,Әй, ол бұзылды.
Dialogue: 0,1:09:24.20,1:09:25.70,Default,,0,0,0,,Дәлелдер жоғалып кетті.
Dialogue: 0,1:09:31.45,1:09:33.29,Default,,0,0,0,,Егер бұл орын алса, мен соңғы қадамымды қолданамын.
Dialogue: 0,1:09:33.62,1:09:35.50,Default,,0,0,0,,Жоқ, сіз оны пайдаланасыз.
Dialogue: 0,1:09:35.62,1:09:36.29,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:37.50,1:09:41.38,Default,,0,0,0,,Мен оларға өзімнің қаншалықты қорқынышты екенімді түсіндіремін.
Dialogue: 0,1:09:42.92,1:09:46.93,Default,,0,0,0,,(Нобита мен оның достарының толқыған дауыстары)
Dialogue: 0,1:09:53.39,1:09:54.94,Default,,0,0,0,,Коякоя жұлдызды ағашы да
Dialogue: 0,1:09:55.06,1:09:58.44,Default,,0,0,0,,Күзде қызыл-сары түске боялады.
Dialogue: 0,1:09:58.56,1:10:01.98,Default,,0,0,0,,Қараңдаршы, Отото құсы көрші планетаға қайтып келеді.
Dialogue: 0,1:10:02.28,1:10:04.70,Default,,0,0,0,,Не, құстар ғарышқа бара ала ма?
Dialogue: 0,1:10:04.82,1:10:07.99,Default,,0,0,0,,Сіз Гартиттің қиыршық тастарын шебер басқарасыз.
Dialogue: 0,1:10:08.12,1:10:11.24,Default,,0,0,0,,А, ағаш бақалар жағаға шыға бастады.
Dialogue: 0,1:10:17.54,1:10:19.67,Default,,0,0,0,,Барлығы жақындап келе жатқан қысқа дайындалуда.
Dialogue: 0,1:10:19.79,1:10:20.46,Default,,0,0,0,,(панк айқай)
Dialogue: 0,1:10:20.84,1:10:23.88,Default,,0,0,0,,Қарасам, бір жылға жуық уақыт өтті.
Dialogue: 0,1:10:24.01,1:10:27.34,Default,,0,0,0,,Көптен бері қыстың тыныш болғанына.
Dialogue: 0,1:10:27.47,1:10:29.64,Default,,0,0,0,,Нобита-сан мен Дора-чанға рахмет
Dialogue: 0,1:10:29.76,1:10:31.51,Default,,0,0,0,,Рахмет (Нобита) хехехе
Dialogue: 0,1:10:31.97,1:10:35.43,Default,,0,0,0,,Әйтеуір, мен бұрыннан дос болғандай сезінемін.
Dialogue: 0,1:10:35.56,1:10:36.60,Default,,0,0,0,,Мен де
Dialogue: 0,1:10:36.73,1:10:39.61,Default,,0,0,0,,Мәңгілік дос болайық
Dialogue: 0,1:10:39.73,1:10:42.32,Default,,0,0,0,,Иә, уәде беремін, Нобита-сан.
Dialogue: 0,1:10:42.44,1:10:46.40,Default,,0,0,0,,Иә, келесі жолы мен саған жаңа бесік үйретемін.
Dialogue: 0,1:10:46.53,1:10:50.12,Default,,0,0,0,,Шынымен бе? Клем мен оны асыға күтемін.
Dialogue: 0,1:10:53.87,1:10:55.45,Default,,0,0,0,,Ах... уау...
Dialogue: 0,1:10:57.58,1:11:00.29,Default,,0,0,0,,Бұл негізгі жою құрылғысы ма?
Dialogue: 0,1:11:02.13,1:11:04.92,Default,,0,0,0,,Жер асты мантиясын ынталандыру
Dialogue: 0,1:11:06.51,1:11:10.05,Default,,0,0,0,,Жұлдызшаны ішінен бөлшектеңіз
Dialogue: 0,1:11:13.22,1:11:16.81,Default,,0,0,0,,Енді сізге тек жұлдыз сынықтарынан Гартит кенін жинау керек.
Dialogue: 0,1:11:19.02,1:11:21.19,Default,,0,0,0,,Бұл планетада әлі де адамдар өмір сүреді...
Dialogue: 0,1:11:21.36,1:11:25.48,Default,,0,0,0,,Егер сіз оларға ескерту жасасаңыз, олардың кетуден басқа амалы қалмайды.
Dialogue: 0,1:11:27.44,1:11:30.03,Default,,0,0,0,,Бірақ дүрбелең болса, полиция келеді.
Dialogue: 0,1:11:30.16,1:11:32.16,Default,,0,0,0,,Басыңызды аздап пайдаланыңыз
Dialogue: 0,1:11:32.28,1:11:35.70,Default,,0,0,0,,Жұлдыз тектоникалық қозғалысқа байланысты жоғалып кетті деп елестетіңіз.
Dialogue: 0,1:11:35.91,1:11:37.20,Default,,0,0,0,,Ах... хехе
Dialogue: 0,1:11:37.75,1:11:39.71,Default,,0,0,0,,Сосын мына Супермен бар.
Dialogue: 0,1:11:40.17,1:11:45.46,Default,,0,0,0,,Эй, жер тұрғындары мен енот иттері бұл планетаға қалай келетінін біл.
Dialogue: 0,1:11:46.71,1:11:50.13,Default,,0,0,0,,Гильермин мырза, менің ойымда бір нәрсе бар.
Dialogue: 0,1:11:50.26,1:11:51.22,Default,,0,0,0,,Егер біз Диоға бет алсақ, әпкемнің жауымен кездесуіміз анық.
Dialogue: 0,1:11:52.93,1:11:54.39,Default,,0,0,0,,Хмм...
Dialogue: 0,1:11:56.47,1:11:59.18,Default,,0,0,0,,Сен мұнда не үшін келдің? (Күмәнді Уно) Ух...
Dialogue: 0,1:11:59.31,1:12:02.23,Default,,0,0,0,,Мен оның соғыс кеңістігінде қайтыс болғанын естідім.
Dialogue: 0,1:12:02.60,1:12:03.65,Default,,0,0,0,,Кім?
Dialogue: 0,1:12:07.44,1:12:09.36,Default,,0,0,0,,Әкеңе өкінемін.
Dialogue: 0,1:12:09.57,1:12:10.49,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:11.36,1:12:12.66,Default,,0,0,0,,Капитанға немесе Каморанға
Dialogue: 0,1:12:12.78,1:12:15.37,Default,,0,0,0,,Олар тастап кеткендей дейді.
Dialogue: 0,1:12:16.16,1:12:17.24,Default,,0,0,0,,Тастап кеттіңіз бе?
Dialogue: 0,1:12:23.00,1:12:24.29,Default,,0,0,0,,Бұл сіздің шаруаңыз емес.
Dialogue: 0,1:12:24.42,1:12:26.25,Default,,0,0,0,,Ух... Гильермин-сама.
Dialogue: 0,1:12:26.38,1:12:29.72,Default,,0,0,0,,Мен доктор Бернспен ұзақ уақыт жұмыс істедім.
Dialogue: 0,1:12:30.22,1:12:31.26,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:31.76,1:12:33.22,Default,,0,0,0,,Әкеммен? (Uno) Иә
Dialogue: 0,1:12:33.34,1:12:36.06,Default,,0,0,0,,Мен сенің әкең туралы өсек естідім...
Dialogue: 0,1:12:36.18,1:12:37.10,Default,,0,0,0,,Иә?
Dialogue: 0,1:12:37.22,1:12:38.77,Default,,0,0,0,,Сіз жол бойы келдіңіз.
Dialogue: 0,1:12:39.64,1:12:40.81,Default,,0,0,0,,Сыбыс…
Dialogue: 0,1:12:41.48,1:12:42.52,Default,,0,0,0,,Өсек деген не?
Dialogue: 0,1:12:43.23,1:12:47.65,Default,,0,0,0,,Оны оқытудың бір ғана шарты бар.
Dialogue: 0,1:12:48.28,1:12:49.11,Default,,0,0,0,,Жағдайлар?
Dialogue: 0,1:12:49.61,1:12:52.61,Default,,0,0,0,,Бұл жердегілер қайдан келеді?
Dialogue: 0,1:12:53.07,1:12:55.03,Default,,0,0,0,,Мүмкін сіз білесіз бе?
Dialogue: 0,1:13:04.46,1:13:06.96,Default,,0,0,0,,Коякоя? Тезек
Dialogue: 0,1:13:07.13,1:13:09.05,Default,,0,0,0,,Көп өтірік айту
Dialogue: 0,1:13:09.17,1:13:11.13,Default,,0,0,0,,Бөлмеге қараған сайын ол жоқ.
Dialogue: 0,1:13:11.26,1:13:13.26,Default,,0,0,0,,Сіз ойнауға ессіз бе?
Dialogue: 0,1:13:13.38,1:13:16.01,Default,,0,0,0,,Мен сені бұл жолы кешірмеймін!
Dialogue: 0,1:13:16.18,1:13:20.27,Default,,0,0,0,,А-а... көрдің бе, Нобита-кун мұны әлі де басқалар үшін істеп жүр...
Dialogue: 0,1:13:20.60,1:13:22.39,Default,,0,0,0,,Мен де Дора-чанға сене алмаймын.
Dialogue: 0,1:13:22.52,1:13:23.27,Default,,0,0,0,,Иә, бұл жақсы нәрсе ме?
Dialogue: 0,1:13:23.39,1:13:24.27,Default,,0,0,0,,Иә
Dialogue: 0,1:13:24.40,1:13:27.65,Default,,0,0,0,,Кешкі асқа дейін үстеліңізден бір қадам болса да қалдырмаңыз.
Dialogue: 0,1:13:28.11,1:13:29.44,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,1:13:30.03,1:13:32.53,Default,,0,0,0,,А, тағы да?
Dialogue: 0,1:13:32.65,1:13:36.07,Default,,0,0,0,,Осы қарқынмен келесі жолы сыртқа шыққанда найзағай көп болады.
Dialogue: 0,1:13:36.20,1:13:40.12,Default,,0,0,0,,Коя Кояға баруды біраз уақытқа тоқтатудан басқа амалым жоқ.
Dialogue: 0,1:13:40.24,1:13:42.12,Default,,0,0,0,,Иә, бұл күндері
Dialogue: 0,1:13:42.25,1:13:45.12,Default,,0,0,0,,Гартит кеншілері де тыныш.
Dialogue: 0,1:13:45.25,1:13:46.42,Default,,0,0,0,,Иә
Dialogue: 0,1:13:49.84,1:13:52.05,Default,,0,0,0,,Бірақ мені мазалайтыны осы.
Dialogue: 0,1:13:52.17,1:13:53.97,Default,,0,0,0,,Иә, әрине
Dialogue: 0,1:13:54.09,1:13:56.68,Default,,0,0,0,,Амансың ба? Барлығы
Dialogue: 0,1:14:14.11,1:14:15.07,Default,,0,0,0,,Иә
Dialogue: 0,1:14:15.82,1:14:17.99,Default,,0,0,0,,Бұл есік (Uno) Иә.
Dialogue: 0,1:14:19.16,1:14:21.70,Default,,0,0,0,,Мен уайымдап тұрмын. Барып көрейік.
Dialogue: 0,1:14:21.83,1:14:25.66,Default,,0,0,0,,Иә, егер сіз тез оралсаңыз, байқамай қалуыңыз мүмкін.
Dialogue: 0,1:14:26.75,1:14:28.08,Default,,0,0,0,,Уау!
Dialogue: 0,1:14:28.42,1:14:30.04,Default,,0,0,0,,Уау...
Dialogue: 0,1:14:31.46,1:14:32.38,Default,,0,0,0,,О (Нобита/Дораэмон) Иә?
Dialogue: 0,1:14:32.50,1:14:35.34,Default,,0,0,0,,Сіз не істеп жатырсыз? (Нобита) О, ештеңе.
Dialogue: 0,1:14:35.47,1:14:36.59,Default,,0,0,0,,Дора-чан, сен не істеп жатырсың?
Dialogue: 0,1:14:36.72,1:14:39.09,Default,,0,0,0,,Диета~ Кешегі күн Аххх
Dialogue: 0,1:14:40.10,1:14:42.43,Default,,0,0,0,,Жоқ, ол ашылмайды.
Dialogue: 0,1:14:42.56,1:14:44.93,Default,,0,0,0,,Бомба қояйық, а?
Dialogue: 0,1:14:45.06,1:14:45.73,Default,,0,0,0,,Иә
Dialogue: 0,1:14:48.65,1:14:51.94,Default,,0,0,0,,Жерлестер есікті ашқан бойда тарс-тұрс естілді.
Dialogue: 0,1:14:52.07,1:14:53.98,Default,,0,0,0,,Біз студенттерміз, көріп тұрсың ғой—
Dialogue: 0,1:14:57.03,1:15:00.74,Default,,0,0,0,,Хмм ха~ аааа
Dialogue: 0,1:15:01.20,1:15:03.24,Default,,0,0,0,,Нобита-сан келмейді.
Dialogue: 0,1:15:03.37,1:15:05.62,Default,,0,0,0,,Олардың да ол жақта бос емес екеніне сенімдімін.
Dialogue: 0,1:15:05.75,1:15:07.12,Default,,0,0,0,,Мен қараймын.
Dialogue: 0,1:15:07.25,1:15:08.25,Default,,0,0,0,,Шумми
Dialogue: 0,1:15:08.96,1:15:10.46,Default,,0,0,0,,Сіз алмайсыз.
Dialogue: 0,1:15:10.58,1:15:13.75,Default,,0,0,0,,Сен ол кісілерге көп қарыздар болып қалдың ғой, солай емес пе?
Dialogue: 0,1:15:14.42,1:15:16.97,Default,,0,0,0,,Бос емес болсам да мазалаған болсам кешіріңіз.
Dialogue: 0,1:15:17.09,1:15:18.47,Default,,0,0,0,,Иә
Dialogue: 0,1:15:19.22,1:15:20.01,Default,,0,0,0,,Ах
Dialogue: 0,1:15:20.34,1:15:21.01,Default,,0,0,0,,Уау
Dialogue: 0,1:15:22.80,1:15:25.14,Default,,0,0,0,,Үлкен аға, ана, қарашы!
Dialogue: 0,1:15:25.43,1:15:27.39,Default,,0,0,0,,А, бұл қиын.
Dialogue: 0,1:15:28.98,1:15:30.19,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,1:15:30.31,1:15:33.23,Default,,0,0,0,,Бұл планетада барлық жанартаулық белсенділік аяқталды.
Dialogue: 0,1:15:33.36,1:15:34.86,Default,,0,0,0,,Әкем айтты, солай ма?
Dialogue: 0,1:15:34.98,1:15:36.69,Default,,0,0,0,,Ол өзінің белсенді кезеңіне қайта кірді ме деп ойлаймын.
Dialogue: 0,1:15:36.82,1:15:37.78,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,1:15:38.53,1:15:41.57,Default,,0,0,0,,Жақсы ма? Тауға жақындасаң жақсы емес.
Dialogue: 0,1:15:41.70,1:15:44.79,Default,,0,0,0,,Анам Каморан мырзаға кеңес алу үшін барады.
Dialogue: 0,1:15:46.04,1:15:48.41,Default,,0,0,0,,Нобита-сан, келмейсің бе?
Dialogue: 0,1:15:49.62,1:15:51.75,Default,,0,0,0,,Жарайды, жұлдыздың ортасында тұр.
Dialogue: 0,1:15:51.88,1:15:54.04,Default,,0,0,0,,Қатты шайқауды жалғастырыңыз
Dialogue: 0,1:15:54.17,1:15:55.46,Default,,0,0,0,,Түсінікті
Dialogue: 0,1:15:56.42,1:16:00.22,Default,,0,0,0,,Гильермин мырза, біздің де қашып кеткеніміз дұрыс емес пе?
Dialogue: 0,1:16:00.34,1:16:03.30,Default,,0,0,0,,Осындай көлемдегі атқылау сізді таң қалдырса, не істер едіңіз?
Dialogue: 0,1:16:03.76,1:16:07.98,Default,,0,0,0,,Жұлдыздың центріндегі ядроның жиілігі ең жоғарғы шегіне жеткенде
Dialogue: 0,1:16:08.10,1:16:10.81,Default,,0,0,0,,Бұл мұнара көк түспен жарқырайды.
Dialogue: 0,1:16:12.23,1:16:15.02,Default,,0,0,0,,Соңғы қосқышты аудару ғана қалды.
Dialogue: 0,1:16:18.24,1:16:21.11,Default,,0,0,0,,Демек, бұл жұлдыз ғаламнан ғайып болады.
Dialogue: 0,1:16:21.24,1:16:22.41,Default,,0,0,0,,Не? (Гуйлямин) Хехехе...
Dialogue: 0,1:16:22.53,1:16:23.95,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,1:16:24.20,1:16:26.79,Default,,0,0,0,,Тұрғындарға ескерту
Dialogue: 0,1:16:26.91,1:16:29.62,Default,,0,0,0,,Бұл планетаны дереу тастаңыз.
Dialogue: 0,1:16:29.75,1:16:32.79,Default,,0,0,0,,Коя Коя жұлдызы жер қыртысының қозғалысына байланысты
Dialogue: 0,1:16:32.92,1:16:35.50,Default,,0,0,0,,Бір апта ішінде жарылады
Dialogue: 0,1:16:35.63,1:16:37.96,Default,,0,0,0,,Уақыт жоқ
Dialogue: 0,1:16:45.05,1:16:47.43,Default,,0,0,0,,(Паопаоның айқайы)
Dialogue: 0,1:16:47.56,1:16:51.56,Default,,0,0,0,,(Жануарлардың айқайы)
Dialogue: 0,1:16:52.06,1:16:53.98,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,1:16:54.15,1:16:55.98,Default,,0,0,0,,Жердегілер неге келмейді?
Dialogue: 0,1:16:56.40,1:16:58.98,Default,,0,0,0,,Иә, маған сенің көмегің керек болып тұратын кездері болады.
Dialogue: 0,1:16:59.53,1:17:01.49,Default,,0,0,0,,Барлығың тынышталыңдар.
Dialogue: 0,1:17:02.03,1:17:04.78,Default,,0,0,0,,Біз қазір иммигранттар үшін шұғыл түрде кеме ұйымдастырып жатырмыз.
Dialogue: 0,1:17:04.91,1:17:06.66,Default,,0,0,0,,Мен бұл планетадан кетуді жек көремін!
Dialogue: 0,1:17:06.78,1:17:08.58,Default,,0,0,0,,Біз қайда баруымыз керек?
Dialogue: 0,1:17:08.70,1:17:10.50,Default,,0,0,0,,Иә, иә! (Әйел) Иә, иә.
Dialogue: 0,1:17:10.83,1:17:11.91,Default,,0,0,0,,Ропле-кун
Dialogue: 0,1:17:12.04,1:17:15.04,Default,,0,0,0,,Нобита-кун мен Дораемон не істеп жатыр?
Dialogue: 0,1:17:15.17,1:17:17.09,Default,,0,0,0,,Сенің келе алмауының себебі бар деп ойлаймын.
Dialogue: 0,1:17:17.21,1:17:18.63,Default,,0,0,0,,Айтыңыз
Dialogue: 0,1:17:18.88,1:17:20.17,Default,,0,0,0,,Біз жалғыз Жер тұрғындарымыз
Dialogue: 0,1:17:20.30,1:17:22.51,Default,,0,0,0,,Көмек алуға тырыспағаныңызға сенімдімін!
Dialogue: 0,1:17:22.63,1:17:24.59,Default,,0,0,0,,Өзімшіл ештеңе айтпа
Dialogue: 0,1:17:25.93,1:17:27.10,Default,,0,0,0,,Молина апа
Dialogue: 0,1:17:27.89,1:17:30.68,Default,,0,0,0,,Жанартау атқылауы бұл планетада проблема болып табылады, солай емес пе?
Dialogue: 0,1:17:30.85,1:17:32.93,Default,,0,0,0,,Оның бұл балаларға қатысы жоқ.
Dialogue: 0,1:17:34.77,1:17:38.15,Default,,0,0,0,,Сіз әрқашан басқа біреуге сенесіз
Dialogue: 0,1:17:38.27,1:17:42.24,Default,,0,0,0,,Бірдеңе болса да, ешкім қол ұшын созбайды.
Dialogue: 0,1:17:43.03,1:17:45.36,Default,,0,0,0,,Менің әкем сияқты.
Dialogue: 0,1:17:45.49,1:17:46.95,Default,,0,0,0,,Ах... Молина
Dialogue: 0,1:17:47.07,1:17:49.91,Default,,0,0,0,,Біз де дәрігерге көмектескіміз келді.
Dialogue: 0,1:17:50.04,1:17:53.04,Default,,0,0,0,,Бірақ мен сол энергия толқынының ішінде қалсам.
Dialogue: 0,1:17:53.16,1:17:54.37,Default,,0,0,0,,Кемеге қауіп төнді
Dialogue: 0,1:17:54.87,1:17:56.04,Default,,0,0,0,,Өтірік айтпа!
Dialogue: 0,1:17:56.17,1:17:56.96,Default,,0,0,0,,Уф
Dialogue: 0,1:17:57.83,1:17:59.92,Default,,0,0,0,,Менің әкем галтит кенін осы планетадан сатып алды.
Dialogue: 0,1:18:00.05,1:18:01.96,Default,,0,0,0,,Мен оны сатуға қарсы болдым.
Dialogue: 0,1:18:02.09,1:18:04.88,Default,,0,0,0,,Бірақ сендер басқаша ойлайсыңдар.
Dialogue: 0,1:18:05.01,1:18:07.34,Default,,0,0,0,,Жоқ Молина, бұл түсінбеушілік.
Dialogue: 0,1:18:07.47,1:18:10.35,Default,,0,0,0,,Сіз бұл планетаны рұқсатсыз сатқансыз.
Dialogue: 0,1:18:10.47,1:18:12.64,Default,,0,0,0,,Жоқ, біз, иммигранттар тобы,
Dialogue: 0,1:18:12.77,1:18:15.02,Default,,0,0,0,,Мені Gartite Mining компаниясы алдап кетті.
Dialogue: 0,1:18:15.56,1:18:16.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:18:17.27,1:18:18.06,Default,,0,0,0,,Ах...
Dialogue: 0,1:18:20.52,1:18:22.53,Default,,0,0,0,,Суық тиіп қалдың ба? Жағдайың қалай?
Dialogue: 0,1:18:25.32,1:18:27.16,Default,,0,0,0,,Кешіріңіз Молина
Dialogue: 0,1:18:27.28,1:18:31.83,Default,,0,0,0,,Әкеңді бір күн де ұмытқан жоқпын.
Dialogue: 0,1:18:36.96,1:18:40.88,Default,,0,0,0,,Осылай мүсін тұрғызсаң да әкең қайтып келмейді!
Dialogue: 0,1:18:42.55,1:18:43.55,Default,,0,0,0,,Молина апа!
Dialogue: 0,1:18:43.67,1:18:46.63,Default,,0,0,0,,(Адамдар айғайлайды)
Dialogue: 0,1:18:46.76,1:18:47.97,Default,,0,0,0,,Мен шештім
Dialogue: 0,1:18:48.09,1:18:50.18,Default,,0,0,0,,Нобита-сан мен Дора-чанды шақыру
Dialogue: 0,1:18:50.30,1:18:52.06,Default,,0,0,0,,О, күте тұр, Чумми.
Dialogue: 0,1:18:56.73,1:18:57.60,Default,,0,0,0,,Хмм
Dialogue: 0,1:18:58.40,1:18:59.81,Default,,0,0,0,,Ах!
Dialogue: 0,1:19:00.77,1:19:02.77,Default,,0,0,0,,Не? (Нобита) Мен ренжідім.
Dialogue: 0,1:19:02.90,1:19:05.15,Default,,0,0,0,,«Бұл қызықты», солай ма? (Нобита)
Dialogue: 0,1:19:05.69,1:19:07.03,Default,,0,0,0,,Бәрібір мен барамын
Dialogue: 0,1:19:07.15,1:19:08.16,Default,,0,0,0,,Нобита-кун
Dialogue: 0,1:19:08.28,1:19:10.12,Default,,0,0,0,,Дорэмон, тоқтамашы
Dialogue: 0,1:19:10.99,1:19:12.78,Default,,0,0,0,,Мен сені неге тоқтатуым керек?
Dialogue: 0,1:19:12.91,1:19:13.58,Default,,0,0,0,,Иә?
Dialogue: 0,1:19:14.04,1:19:15.04,Default,,0,0,0,,Хмм.
Dialogue: 0,1:19:15.20,1:19:17.46,Default,,0,0,0,,Міне! (Екі адам күледі)
Dialogue: 0,1:19:17.66,1:19:19.17,Default,,0,0,0,,Нобита-сан!
Dialogue: 0,1:19:19.29,1:19:20.96,Default,,0,0,0,,Дора-чан! Күте алсаң, Чумми
Dialogue: 0,1:19:22.00,1:19:22.88,Default,,0,0,0,,Үлкен аға
Dialogue: 0,1:19:23.25,1:19:24.13,Default,,0,0,0,,Уау
Dialogue: 0,1:19:26.92,1:19:28.55,Default,,0,0,0,,А... иә? (Нобита) Иә?
Dialogue: 0,1:19:28.68,1:19:31.72,Default,,0,0,0,,Не болды, Дорами, сен кенеттен келе жатырсың ба?
Dialogue: 0,1:19:31.85,1:19:34.89,Default,,0,0,0,,Иә, бұл кезекті тексерудің нәтижесі, нормадан ауытқу жоқ.
Dialogue: 0,1:19:35.02,1:19:37.14,Default,,0,0,0,,Бұл не?
Dialogue: 0,1:19:37.27,1:19:39.14,Default,,0,0,0,,Үлкен аға, сол татами...
Dialogue: 0,1:19:39.35,1:19:41.44,Default,,0,0,0,,Жоқ, қараңызшы, соңғы татами төсеніштері
Dialogue: 0,1:19:41.56,1:19:42.94,Default,,0,0,0,,Ол секіреді, иә.
Dialogue: 0,1:19:43.06,1:19:44.82,Default,,0,0,0,,Бұл егеуқұйрықтардың спорт күні хахаха...
Dialogue: 0,1:19:44.94,1:19:46.40,Default,,0,0,0,,Бұл күдікті болып көрінеді.
Dialogue: 0,1:19:46.53,1:19:47.90,Default,,0,0,0,,(Нобита мен Дорэмонның күлкісі)
Dialogue: 0,1:19:48.65,1:19:51.28,Default,,0,0,0,,Чумми Эй Чумми, жақсысың ба?
Dialogue: 0,1:19:51.41,1:19:53.78,Default,,0,0,0,,Уау, мен таң қалдым.
Dialogue: 0,1:19:55.29,1:19:57.79,Default,,0,0,0,,Неліктен жарылды?
Dialogue: 0,1:19:58.21,1:19:59.50,Default,,0,0,0,,Қазірге дейінгі тәжірибелердің нәтижелеріне сүйене отырып,
Dialogue: 0,1:19:59.62,1:20:02.58,Default,,0,0,0,,Иә? Бұл Gartite Mining компаниясының жұмысы ма?
Dialogue: 0,1:20:02.71,1:20:03.96,Default,,0,0,0,,Менің жеңуімнің себебі…
Dialogue: 0,1:20:04.09,1:20:05.59,Default,,0,0,0,,Әйтеуір, солай.
Dialogue: 0,1:20:05.71,1:20:08.05,Default,,0,0,0,,Сондықтан мен енді Нобита-кунмен және басқалармен кездесе алмаймын.
Dialogue: 0,1:20:08.59,1:20:11.01,Default,,0,0,0,,Біз не істеуіміз керек? Ропле-кун
Dialogue: 0,1:20:11.13,1:20:14.76,Default,,0,0,0,,Қалайша жанартаулар бір уақытта бірден атқылай бастайды?
Dialogue: 0,1:20:14.89,1:20:16.77,Default,,0,0,0,,Біртүрлі екен
Dialogue: 0,1:20:17.02,1:20:18.85,Default,,0,0,0,,Мен тек бірдеңе бар деп ойлаймын.
Dialogue: 0,1:20:19.56,1:20:22.81,Default,,0,0,0,,Чумми, үйге келмесем
Dialogue: 0,1:20:22.94,1:20:24.86,Default,,0,0,0,,Анаң мен Клем туралы сұра
Dialogue: 0,1:20:25.11,1:20:27.23,Default,,0,0,0,,Не айтып тұрсың, Роппуру-кун?
Dialogue: 0,1:20:27.36,1:20:28.78,Default,,0,0,0,,Мен оны қарастырамын.
Dialogue: 0,1:20:28.90,1:20:30.24,Default,,0,0,0,,Күте тұрыңыз, Роппуру-кун.
Dialogue: 0,1:20:30.36,1:20:33.20,Default,,0,0,0,,Уф...
Dialogue: 0,1:20:34.49,1:20:37.74,Default,,0,0,0,,О, Дорами-чан да осында болды, бұл керемет болды.
Dialogue: 0,1:20:38.20,1:20:40.00,Default,,0,0,0,,Ах Шизука-чан
Dialogue: 0,1:20:40.12,1:20:43.29,Default,,0,0,0,,Мен енді қашып кетпес үшін сенен мені қадағалауыңды өтіндім.
Dialogue: 0,1:20:43.58,1:20:46.55,Default,,0,0,0,,Сізден осындай оғаш тілек сұрағаным үшін кешіріңіз.
Dialogue: 0,1:20:46.67,1:20:48.05,Default,,0,0,0,,Жоқ
Dialogue: 0,1:20:48.71,1:20:51.17,Default,,0,0,0,,Дорами-чаннан да сұрасам бола ма?
Dialogue: 0,1:20:51.30,1:20:53.68,Default,,0,0,0,,Түсіндім, маған қалдырыңыз.
Dialogue: 0,1:20:53.80,1:20:56.68,Default,,0,0,0,,Жақсы оқы, бұл жақсы, Нобита.
Dialogue: 0,1:20:56.81,1:20:57.56,Default,,0,0,0,,Иә
Dialogue: 0,1:20:57.97,1:21:00.10,Default,,0,0,0,,Чумми, оян.
Dialogue: 0,1:21:00.43,1:21:01.23,Default,,0,0,0,,Анашым!
Dialogue: 0,1:21:01.98,1:21:05.90,Default,,0,0,0,,Ха, бұл қорқынышты. Роплекун шахтаға барады.
Dialogue: 0,1:21:06.02,1:21:06.69,Default,,0,0,0,,Иә?
Dialogue: 0,1:21:07.19,1:21:08.65,Default,,0,0,0,,Сіздің ағаңыз жалғыз ба?
Dialogue: 0,1:21:08.78,1:21:12.15,Default,,0,0,0,,Мен не істеуім керек? Мен сені қусам да, уақытында үлгере алмаймын.
Dialogue: 0,1:21:12.28,1:21:14.87,Default,,0,0,0,,Осындай кезде Нобитаның осында болғанын қалаймын.
Dialogue: 0,1:21:16.16,1:21:17.49,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:21:17.78,1:21:18.66,Default,,0,0,0,,Га
Dialogue: 0,1:21:19.04,1:21:21.96,Default,,0,0,0,,Қайда? қайда? қайда? есік жерге қосылған
Dialogue: 0,1:21:22.46,1:21:23.96,Default,,0,0,0,,Хмм хмм
Dialogue: 0,1:21:24.08,1:21:26.46,Default,,0,0,0,,Қай жерде uh uh мұнда емес uh
Dialogue: 0,1:21:26.59,1:21:28.50,Default,,0,0,0,,Мм
Dialogue: 0,1:21:31.55,1:21:33.17,Default,,0,0,0,,Уф
Dialogue: 0,1:21:33.30,1:21:33.97,Default,,0,0,0,,Міне болды!
Dialogue: 0,1:21:35.01,1:21:36.43,Default,,0,0,0,,Құдайды өтінемін
Dialogue: 0,1:21:36.55,1:21:39.97,Default,,0,0,0,,Өтінемін, жермен байланыста болыңыз!
Dialogue: 0,1:21:40.52,1:21:41.60,Default,,0,0,0,,Уф
Dialogue: 0,1:21:45.48,1:21:48.48,Default,,0,0,0,,Міне осылай болды, мен ақыры түсіндім.
Dialogue: 0,1:21:48.61,1:21:50.11,Default,,0,0,0,,Мен мазасызданамын.
Dialogue: 0,1:21:50.57,1:21:51.99,Default,,0,0,0,,Нобита-кун бұрын осында болған.
Dialogue: 0,1:21:52.11,1:21:55.99,Default,,0,0,0,,Мен бір рет Ропле-кун айтқан шарасыз ойларды сезіндім.
Dialogue: 0,1:21:56.32,1:21:59.62,Default,,0,0,0,,Сіз жақсы нәрсе айтып, қайтадан қашуды жоспарлап отырсыз ба?
Dialogue: 0,1:21:59.87,1:22:01.04,Default,,0,0,0,,Маған сеніңіз
Dialogue: 0,1:22:01.16,1:22:04.33,Default,,0,0,0,,Не болса да, үй тапсырмасын аяқтайық.
Dialogue: 0,1:22:05.58,1:22:07.79,Default,,0,0,0,,А, сәл қозғалды, жарай ма?
Dialogue: 0,1:22:07.92,1:22:08.79,Default,,0,0,0,,Сено
Dialogue: 0,1:22:09.13,1:22:11.30,Default,,0,0,0,,А, кешіріңіз...
Dialogue: 0,1:22:13.05,1:22:14.30,Default,,0,0,0,,Не!? Иә?
Dialogue: 0,1:22:15.93,1:22:16.76,Default,,0,0,0,,Ой! Ол бұрыштан айналып кетті!
Dialogue: 0,1:22:17.01,1:22:18.55,Default,,0,0,0,,Бұл Чумми емес пе?
Dialogue: 0,1:22:18.68,1:22:20.68,Default,,0,0,0,,Нобита-сан Дора-чан (жылау)
Dialogue: 0,1:22:20.81,1:22:22.89,Default,,0,0,0,,Не болды? Сен жыласаң түсінбеймін
Dialogue: 0,1:22:23.02,1:22:23.81,Default,,0,0,0,,Чумми
Dialogue: 0,1:22:29.98,1:22:31.48,Default,,0,0,0,,Не? Яғни
Dialogue: 0,1:22:41.20,1:22:41.87,Default,,0,0,0,,Ах!
Dialogue: 0,1:22:42.99,1:22:44.29,Default,,0,0,0,,Мен күткендей, Джозефтің қаны араласып жатыр.
Dialogue: 0,1:22:44.58,1:22:47.04,Default,,0,0,0,,OX1 Оқиға орнына асығыңыз
Dialogue: 0,1:22:49.00,1:22:51.38,Default,,0,0,0,,Не, жай құлап жатқан тас па?
Dialogue: 0,1:22:51.96,1:22:54.05,Default,,0,0,0,,Міне, балақай.
Dialogue: 0,1:22:55.17,1:22:55.84,Default,,0,0,0,,Ах
Dialogue: 0,1:22:56.55,1:22:57.55,Default,,0,0,0,,Молина апа!
Dialogue: 0,1:22:57.76,1:22:58.68,Default,,0,0,0,,Ах
Dialogue: 0,1:22:59.43,1:23:00.85,Default,,0,0,0,,Мен қауіпті деп айтпадым ба?
Dialogue: 0,1:23:00.97,1:23:02.31,Default,,0,0,0,,Сен келдің.
Dialogue: 0,1:23:02.43,1:23:04.52,Default,,0,0,0,,Молина, сен мұнда не үшін келдің?
Dialogue: 0,1:23:04.64,1:23:08.06,Default,,0,0,0,,Гильермин есімді адаммен танысу арқылы мен бір нәрсені растағым келеді.
Dialogue: 0,1:23:08.52,1:23:10.90,Default,,0,0,0,,Жарайды, мына баланы ал.
Dialogue: 0,1:23:11.36,1:23:13.90,Default,,0,0,0,,Бұл әзіл емес. Мен саған бұл баламен араласуға жол бермеймін.
Dialogue: 0,1:23:14.65,1:23:15.69,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,1:23:15.82,1:23:19.24,Default,,0,0,0,,Мен дөрекі ештеңе жасамаймын деп уәде беремін.
Dialogue: 0,1:23:20.03,1:23:22.83,Default,,0,0,0,,Дораемон, Коякояға барайық
Dialogue: 0,1:23:22.95,1:23:24.62,Default,,0,0,0,,Иә, ағайын?
Dialogue: 0,1:23:24.74,1:23:26.08,Default,,0,0,0,,Нобита-сан
Dialogue: 0,1:23:26.20,1:23:28.00,Default,,0,0,0,,Өтінемін, тоқтама, Дорами.
Dialogue: 0,1:23:28.12,1:23:30.58,Default,,0,0,0,,Анама айтсаң бәрібір
Dialogue: 0,1:23:30.75,1:23:33.71,Default,,0,0,0,,Бірақ бізді Ропплдар күтіп тұр.
Dialogue: 0,1:23:35.05,1:23:35.71,Default,,0,0,0,,Ах!
Dialogue: 0,1:23:36.05,1:23:38.22,Default,,0,0,0,,Нобита-сан!
Dialogue: 0,1:23:38.59,1:23:40.64,Default,,0,0,0,,Қазір кеттік, Клем-чан.
Dialogue: 0,1:23:40.76,1:23:43.26,Default,,0,0,0,,Екі есік құлағалы тұрған сияқты.
Dialogue: 0,1:23:43.39,1:23:44.89,Default,,0,0,0,,Бірақ менің кетуден басқа амалым жоқ.
Dialogue: 0,1:23:45.02,1:23:46.06,Default,,0,0,0,,Күте тұрыңыз, ағайын.
Dialogue: 0,1:23:46.18,1:23:48.18,Default,,0,0,0,,Есіктен шыққаннан кейін кері қайту мүмкін емес.
Dialogue: 0,1:23:48.31,1:23:49.14,Default,,0,0,0,,Ах!
Dialogue: 0,1:23:49.27,1:23:50.52,Default,,0,0,0,,Алдымен барайық (Нобита және т.б.) Ах.
Dialogue: 0,1:24:11.00,1:24:13.04,Default,,0,0,0,,Нобита-кун сияқты
Dialogue: 0,1:24:13.25,1:24:15.59,Default,,0,0,0,,Мен дайынмын, кеттік!
Dialogue: 0,1:24:15.71,1:24:17.63,Default,,0,0,0,,Әй, аға!
Dialogue: 0,1:24:21.38,1:24:23.05,Default,,0,0,0,,Нобита-санға рахмет
Dialogue: 0,1:24:23.18,1:24:24.72,Default,,0,0,0,,Клем-чан осында.
Dialogue: 0,1:24:24.85,1:24:26.18,Default,,0,0,0,,Тезірек Нобита-кун
Dialogue: 0,1:24:26.31,1:24:27.64,Default,,0,0,0,,Тоқтат! Сол жерде тоқта!
Dialogue: 0,1:24:29.93,1:24:34.06,Default,,0,0,0,,Әке, ағаңызды және Нобита-саныңызды қорғаңыз.
Dialogue: 0,1:24:34.48,1:24:36.52,Default,,0,0,0,,О, мен кеттім, не істеуім керек?
Dialogue: 0,1:24:36.65,1:24:39.74,Default,,0,0,0,,Дорами-чан, сәл күте тұрыңыз, мен бірден келемін.
Dialogue: 0,1:24:39.86,1:24:41.82,Default,,0,0,0,,Ах, Шизука-сан.
Dialogue: 0,1:24:42.20,1:24:44.70,Default,,0,0,0,,Ропле-кун, мен қазір барамын.
Dialogue: 0,1:24:46.62,1:24:48.83,Default,,0,0,0,,Такеши мырза! Сунео мырза!
Dialogue: 0,1:24:48.95,1:24:50.12,Default,,0,0,0,,Ах, Шизука-чан хаха...
Dialogue: 0,1:24:50.25,1:24:52.87,Default,,0,0,0,,Не болды? Бірдеңе болды ма?
Dialogue: 0,1:24:53.00,1:24:55.34,Default,,0,0,0,,Нобита-сан мен Дора-чан қиыншылықта.
Dialogue: 0,1:24:55.54,1:24:58.09,Default,,0,0,0,,Мен Нобита туралы естігім келмейді.
Dialogue: 0,1:24:58.21,1:25:00.55,Default,,0,0,0,,Егер ол кешірім сұраса, мен оны кешіре аламын.
Dialogue: 0,1:25:00.67,1:25:01.34,Default,,0,0,0,,Иә
Dialogue: 0,1:25:03.26,1:25:07.43,Default,,0,0,0,,Бала, менің ойымша, сіз көрмеуіңіз керек нәрсені көрдіңіз.
Dialogue: 0,1:25:07.56,1:25:09.85,Default,,0,0,0,,Бұл сіздің әрекетіңіз болды.
Dialogue: 0,1:25:10.39,1:25:13.23,Default,,0,0,0,,Сіз оғаш машинамен атқылау тудырдыңыз.
Dialogue: 0,1:25:13.35,1:25:14.65,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,1:25:15.44,1:25:17.61,Default,,0,0,0,,Біз кеңес беруіміз керек еді
Dialogue: 0,1:25:17.73,1:25:20.11,Default,,0,0,0,,Бұл планетаны тез тастап, қашып кет.
Dialogue: 0,1:25:20.82,1:25:23.15,Default,,0,0,0,,Бұл біздің планетамыз! Уф
Dialogue: 0,1:25:23.91,1:25:27.12,Default,,0,0,0,,Біз қазір бұл планетамен қоштасуымыз керек.
Dialogue: 0,1:25:27.95,1:25:28.87,Default,,0,0,0,,Уф
Dialogue: 0,1:25:29.37,1:25:30.66,Default,,0,0,0,,Бұл планетаны жою
Dialogue: 0,1:25:31.58,1:25:35.63,Default,,0,0,0,,Көмегің үшін рахмет. Сіз менің жұмысымды жеңілдеттіңіз.
Dialogue: 0,1:25:37.04,1:25:38.67,Default,,0,0,0,,Сол оқиға... Ах.
Dialogue: 0,1:25:39.96,1:25:41.59,Default,,0,0,0,,Не ойнап жүрсің?
Dialogue: 0,1:25:41.71,1:25:44.13,Default,,0,0,0,,(Бакара мен Гильерминнің күлкісі)
Dialogue: 0,1:25:44.84,1:25:46.34,Default,,0,0,0,,Молина апа
Dialogue: 0,1:25:46.47,1:25:47.85,Default,,0,0,0,,Ұф… сен, кішкентай сорлы.
Dialogue: 0,1:25:48.97,1:25:51.64,Default,,0,0,0,,Кешіріңіз, Роппл, мен ақымақ болдым.
Dialogue: 0,1:25:52.93,1:25:54.10,Default,,0,0,0,,«Әкемнің апаты болды...»
Dialogue: 0,1:25:54.23,1:25:56.52,Default,,0,0,0,,«Бұл орнату болуы мүмкін.»
Dialogue: 0,1:25:56.86,1:25:59.23,Default,,0,0,0,,Маған солай айтылды.
Dialogue: 0,1:25:59.36,1:26:01.40,Default,,0,0,0,,Мен оларға Нобита-кун және басқалар туралы айтып бердім...
Dialogue: 0,1:26:02.61,1:26:04.15,Default,,0,0,0,,Не...
Dialogue: 0,1:26:04.28,1:26:05.36,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:26:05.49,1:26:07.41,Default,,0,0,0,,Мен қайтаруға болмайтын нәрсені жасадым.
Dialogue: 0,1:26:14.33,1:26:18.42,Default,,0,0,0,,Жарайды, мен Нобита-кун мен Дораемонның келетініне сенімдімін.
Dialogue: 0,1:26:19.92,1:26:22.26,Default,,0,0,0,,Мен екеуіңе де сенемін.
Dialogue: 0,1:26:25.97,1:26:27.26,Default,,0,0,0,,Ах (Чамми) Бұл не? Бұл
Dialogue: 0,1:26:27.72,1:26:29.80,Default,,0,0,0,,Гартит кенін қазатын машина емес пе?
Dialogue: 0,1:26:29.93,1:26:32.27,Default,,0,0,0,,Бұл үшін сақтық шаралары тым қатал.
Dialogue: 0,1:26:38.27,1:26:39.36,Default,,0,0,0,,Ах
Dialogue: 0,1:26:42.53,1:26:43.78,Default,,0,0,0,,Қар гүлдері
Dialogue: 0,1:26:43.90,1:26:45.20,Default,,0,0,0,,Бұл Ропле-кун.
Dialogue: 0,1:26:45.32,1:26:47.53,Default,,0,0,0,,Мен не істеуім керек? Дораемон тұтқынға алынды.
Dialogue: 0,1:26:47.66,1:26:49.41,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:26:55.00,1:26:57.29,Default,,0,0,0,,Гирокапсула
Dialogue: 0,1:26:57.46,1:26:59.96,Default,,0,0,0,,Осындай көлік көзге түсетіндей емес пе?
Dialogue: 0,1:27:00.08,1:27:02.34,Default,,0,0,0,,Хехехе, қарашы.
Dialogue: 0,1:27:07.88,1:27:10.47,Default,,0,0,0,,Бұл рас! Бұл тасқа ұқсайды
Dialogue: 0,1:27:12.31,1:27:14.64,Default,,0,0,0,,Не, тағы құлаған тас?
Dialogue: 0,1:27:15.39,1:27:17.31,Default,,0,0,0,,Иә? Дораемонмен бе?
Dialogue: 0,1:27:17.44,1:27:19.98,Default,,0,0,0,,Сіз галтит өндіру өнеркәсібіне араластыңыз ба?
Dialogue: 0,1:27:20.36,1:27:23.02,Default,,0,0,0,,Біз не істеуіміз керек? Мен уайымдаймын, мен уайымдаймын.
Dialogue: 0,1:27:23.40,1:27:25.94,Default,,0,0,0,,Қандай ақымақ, Нобита.
Dialogue: 0,1:27:26.07,1:27:30.07,Default,,0,0,0,,Нобита не істей алады? Неге менімен сөйлеспейсің?
Dialogue: 0,1:27:30.20,1:27:32.12,Default,,0,0,0,,Мен ол жігітті ұшырып жіберемін!
Dialogue: 0,1:27:32.28,1:27:34.12,Default,,0,0,0,,Шизука-чан, тезірек барайық!
Dialogue: 0,1:27:34.87,1:27:36.54,Default,,0,0,0,,Рахмет, Таке-сан.
Dialogue: 0,1:27:36.66,1:27:38.62,Default,,0,0,0,,Иә... солай.
Dialogue: 0,1:27:38.75,1:27:41.33,Default,,0,0,0,,Мені жалғыз қалдырмаңыз, мен де барамын!
Dialogue: 0,1:27:41.58,1:27:43.29,Default,,0,0,0,,Мен қазір барамын.
Dialogue: 0,1:27:46.51,1:27:48.55,Default,,0,0,0,,Сіз жарылуға дайын сияқтысыз.
Dialogue: 0,1:27:48.68,1:27:51.84,Default,,0,0,0,,Лорд Гильермин, біздің қашатын кез келді.
Dialogue: 0,1:27:51.97,1:27:55.52,Default,,0,0,0,,Әлі ерте. Мен оны жарылып кете жаздағанша дәл осы жерден қараймын.
Dialogue: 0,1:27:55.64,1:27:58.14,Default,,0,0,0,,Енді мені ешкім мазаламайды.
Dialogue: 0,1:27:58.60,1:28:01.48,Default,,0,0,0,,Қоянды жеңу үшін бар күшіңізді салыңыз
Dialogue: 0,1:28:01.60,1:28:04.15,Default,,0,0,0,,Мен осылай жұмыс істеймін.
Dialogue: 0,1:28:04.52,1:28:07.78,Default,,0,0,0,,Тым байыпты болу проблема болуы мүмкін.
Dialogue: 0,1:28:10.66,1:28:13.03,Default,,0,0,0,,Қараңдаршы, жарық...
Dialogue: 0,1:28:14.03,1:28:15.03,Default,,0,0,0,,Нобита-кун
Dialogue: 0,1:28:15.58,1:28:17.12,Default,,0,0,0,,Ах, Гильермин-сама.
Dialogue: 0,1:28:17.25,1:28:19.33,Default,,0,0,0,,Бірдеңе дұрыс емес пе? (Оператор) Мүлде жоқ.
Dialogue: 0,1:28:20.71,1:28:21.71,Default,,0,0,0,,Эй
Dialogue: 0,1:28:22.42,1:28:24.79,Default,,0,0,0,,Төменгі сол жақтағы экранда не бар?
Dialogue: 0,1:28:25.04,1:28:26.96,Default,,0,0,0,,Бұл тек құлап жатқан тас
Dialogue: 0,1:28:27.09,1:28:28.84,Default,,0,0,0,,Бүгінгі күні тым көп.
Dialogue: 0,1:28:29.01,1:28:31.09,Default,,0,0,0,,Көздерің ойық па?
Dialogue: 0,1:28:31.22,1:28:33.55,Default,,0,0,0,,Қараңдаршы, бұл қандай табиғи емес қозғалыс!
Dialogue: 0,1:28:34.72,1:28:35.72,Default,,0,0,0,,Ах
Dialogue: 0,1:28:36.60,1:28:40.06,Default,,0,0,0,,Барлық патрульдік қайықтарға асығыңыз және оны жойыңыз!
Dialogue: 0,1:28:42.69,1:28:43.86,Default,,0,0,0,,Қараңдар! Күзет қайығы!
Dialogue: 0,1:28:43.98,1:28:45.94,Default,,0,0,0,,Мен таптым (2 адам) А.
Dialogue: 0,1:28:51.90,1:28:54.28,Default,,0,0,0,,Ол кетті (Нобита) Бұл толығымен көрінеді.
Dialogue: 0,1:28:54.41,1:28:55.99,Default,,0,0,0,,Қаш!
Dialogue: 0,1:28:58.95,1:29:00.33,Default,,0,0,0,,Уф!
Dialogue: 0,1:29:08.25,1:29:11.05,Default,,0,0,0,,Иә! Жарайды, жарайды, атып таста!
Dialogue: 0,1:29:12.51,1:29:14.68,Default,,0,0,0,,Сен күткендей келдің бе, Жерлес?
Dialogue: 0,1:29:14.80,1:29:17.47,Default,,0,0,0,,Жарайды, мен сенің қарсыласыңмын!
Dialogue: 0,1:29:22.44,1:29:24.65,Default,,0,0,0,,Уау, үлкен жігіт келді!
Dialogue: 0,1:29:27.40,1:29:28.69,Default,,0,0,0,,Мынаны же!
Dialogue: 0,1:29:28.82,1:29:31.24,Default,,0,0,0,,Тоқта, Дора-чан, мынаны қара!
Dialogue: 0,1:29:34.53,1:29:35.45,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,1:29:36.03,1:29:37.99,Default,,0,0,0,,Ропле-кун! Молина мырза!
Dialogue: 0,1:29:38.62,1:29:40.58,Default,,0,0,0,,Біз не істеуіміз керек? Дораемон
Dialogue: 0,1:29:40.91,1:29:43.12,Default,,0,0,0,,Мен саған осы жерден көңіл айтамын.
Dialogue: 0,1:29:44.00,1:29:45.17,Default,,0,0,0,,Қауіпті!
Dialogue: 0,1:29:47.21,1:29:47.88,Default,,0,0,0,,Уау
Dialogue: 0,1:29:50.13,1:29:52.30,Default,,0,0,0,,Ах!
Dialogue: 0,1:29:52.67,1:29:54.05,Default,,0,0,0,,Ммм...
Dialogue: 0,1:29:54.18,1:29:56.34,Default,,0,0,0,,Секіруге тым ауыр. Өткізіп жіберуге болмайды
Dialogue: 0,1:29:56.76,1:29:58.55,Default,,0,0,0,,Гильермин мырза күткендей
Dialogue: 0,1:29:58.68,1:30:02.81,Default,,0,0,0,,Бостандықтарын ауыр антит кенімен тартып алу?
Dialogue: 0,1:30:02.93,1:30:05.85,Default,,0,0,0,,Енот ит болсам да бар күшімді саламын
Dialogue: 0,1:30:06.23,1:30:07.11,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,1:30:07.40,1:30:10.07,Default,,0,0,0,,А... Иә? Ах хмм
Dialogue: 0,1:30:10.19,1:30:11.57,Default,,0,0,0,,Дораэмон Do... Құралдар
Dialogue: 0,1:30:11.69,1:30:13.24,Default,,0,0,0,,А (Нобита) Асығыңыз!
Dialogue: 0,1:30:13.36,1:30:14.53,Default,,0,0,0,,Қайсысы...
Dialogue: 0,1:30:15.03,1:30:16.03,Default,,0,0,0,,Апарып бара жатып тайып кеттім
Dialogue: 0,1:30:19.12,1:30:19.99,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,1:30:20.12,1:30:23.25,Default,,0,0,0,,Мен түсінбеймін. Маған қарай үлкен тас ұшып келеді.
Dialogue: 0,1:30:26.42,1:30:28.38,Default,,0,0,0,,Эй Нобита, жақсысың ба?
Dialogue: 0,1:30:28.50,1:30:30.25,Default,,0,0,0,,Үлкен аға! (Нобита/Дораемон) Иә?
Dialogue: 0,1:30:30.38,1:30:32.76,Default,,0,0,0,,Анау, қарашы, қарашы, жартасқа
Dialogue: 0,1:30:37.47,1:30:39.80,Default,,0,0,0,,Сол үлкен жігітті жайына қалдыр!
Dialogue: 0,1:30:39.93,1:30:42.56,Default,,0,0,0,,Маған қарашы, Уау!
Dialogue: 0,1:30:44.98,1:30:47.52,Default,,0,0,0,,Мен де
Dialogue: 0,1:30:47.85,1:30:50.27,Default,,0,0,0,,Барлығыңызға рахмет
Dialogue: 0,1:30:51.27,1:30:52.65,Default,,0,0,0,,Уайымдама, бетіне шық!
Dialogue: 0,1:30:52.78,1:30:54.69,Default,,0,0,0,,Мені мотор бөлімінен жұмыстан шығарды.
Dialogue: 0,1:31:00.03,1:31:01.87,Default,,0,0,0,,Ия, иә!
Dialogue: 0,1:31:01.99,1:31:03.74,Default,,0,0,0,,Үлкен аға, тезірек Роппуру-кунды алыңыз!
Dialogue: 0,1:31:03.87,1:31:05.00,Default,,0,0,0,,Ах
Dialogue: 0,1:31:05.45,1:31:07.50,Default,,0,0,0,,Ах~
Dialogue: 0,1:31:09.29,1:31:09.96,Default,,0,0,0,,Ах!
Dialogue: 0,1:31:10.63,1:31:11.71,Default,,0,0,0,,Жер тұрғындары
Dialogue: 0,1:31:14.67,1:31:17.72,Default,,0,0,0,,Саған қарсы алатын күнді асыға күттім.
Dialogue: 0,1:31:18.09,1:31:19.72,Default,,0,0,0,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,1:31:19.84,1:31:23.85,Default,,0,0,0,,Нобита-кун, сенің ату шеберлігіңмен бәрі жақсы болады.
Dialogue: 0,1:31:29.27,1:31:30.35,Default,,0,0,0,,Уф...
Dialogue: 0,1:31:34.40,1:31:37.36,Default,,0,0,0,,Бұл кішкентай жігіт қарапайым адам емес.
Dialogue: 0,1:31:37.90,1:31:41.91,Default,,0,0,0,,Қандай әсерлі! Матчты бірінші соққы шешеді.
Dialogue: 0,1:31:42.03,1:31:43.91,Default,,0,0,0,,Өзіңізге сеніңіз
Dialogue: 0,1:31:44.99,1:31:47.58,Default,,0,0,0,,Олар қозғалуды тоқтатты.
Dialogue: 0,1:31:47.71,1:31:49.87,Default,,0,0,0,,Қазір қашыңыз!
Dialogue: 0,1:31:51.13,1:31:51.96,Default,,0,0,0,,Ху (Нобита) Хух
Dialogue: 0,1:31:52.17,1:31:53.46,Default,,0,0,0,,Уф
Dialogue: 0,1:31:56.38,1:31:57.84,Default,,0,0,0,,Ух... Нобита-кун!
Dialogue: 0,1:32:02.14,1:32:04.14,Default,,0,0,0,,А... а...
Dialogue: 0,1:32:04.97,1:32:07.10,Default,,0,0,0,,Жақсы! Бұл үлкен, Нобита!
Dialogue: 0,1:32:08.14,1:32:10.06,Default,,0,0,0,,Амансың ба? Нобита-кун!
Dialogue: 0,1:32:10.65,1:32:11.52,Default,,0,0,0,,Ропле-кун!
Dialogue: 0,1:32:11.65,1:32:13.90,Default,,0,0,0,,Біз ядроны жою құрылғысын тез арада тоқтатуымыз керек.
Dialogue: 0,1:32:14.61,1:32:16.11,Default,,0,0,0,,Ха, бұл қауіпті!
Dialogue: 0,1:32:17.44,1:32:18.90,Default,,0,0,0,,Ахх... Молина апа!
Dialogue: 0,1:32:20.07,1:32:21.61,Default,,0,0,0,,Жарайды, мен оны тырнап алдым.
Dialogue: 0,1:32:21.99,1:32:23.12,Default,,0,0,0,,Қорқынышты жігіт
Dialogue: 0,1:32:23.78,1:32:26.79,Default,,0,0,0,,Негізгі жою құрылғысы тоқтамайды!
Dialogue: 0,1:32:30.67,1:32:31.83,Default,,0,0,0,,Әй?
Dialogue: 0,1:32:32.00,1:32:33.88,Default,,0,0,0,,Аххххххх
Dialogue: 0,1:32:37.46,1:32:39.34,Default,,0,0,0,,Біз не істеуіміз керек? Дораемон
Dialogue: 0,1:32:39.67,1:32:41.88,Default,,0,0,0,,Бауырым, сол жүк кемесін пайдалана аламыз ба?
Dialogue: 0,1:32:42.64,1:32:45.89,Default,,0,0,0,,Бұл жойғыш құрылғыны қолыңызбен ұстап, бүкіл кемені бұраңыз.
Dialogue: 0,1:32:46.56,1:32:48.81,Default,,0,0,0,,Детонация кеңістігіне кіріп, оны жарып жіберіңіз.
Dialogue: 0,1:32:48.93,1:32:50.39,Default,,0,0,0,,Сонда бірдеңе болатын шығар.
Dialogue: 0,1:32:51.06,1:32:52.40,Default,,0,0,0,,Дораемонды қолданып көрейік
Dialogue: 0,1:32:52.52,1:32:54.73,Default,,0,0,0,,Дорами Барлығын эвакуациялаңыз.
Dialogue: 0,1:32:54.86,1:32:56.40,Default,,0,0,0,,Сау бол, ағайын.
Dialogue: 0,1:32:56.86,1:32:58.11,Default,,0,0,0,,Чумми Клемді сұраңыз
Dialogue: 0,1:32:58.23,1:32:58.90,Default,,0,0,0,,Иә
Dialogue: 0,1:33:01.45,1:33:03.36,Default,,0,0,0,,Уф...
Dialogue: 0,1:33:03.91,1:33:05.24,Default,,0,0,0,,Мен қолды жасаймын
Dialogue: 0,1:33:05.37,1:33:06.87,Default,,0,0,0,,Нобита-кун, сен маған қол ұшын бере аласың ба?
Dialogue: 0,1:33:08.54,1:33:10.37,Default,,0,0,0,,Амансың ба? Молина мырза
Dialogue: 0,1:33:10.50,1:33:12.37,Default,,0,0,0,,Көтерме, жер бетіне шығасың!
Dialogue: 0,1:33:15.33,1:33:17.13,Default,,0,0,0,,Ропле-кун, қазір!
Dialogue: 0,1:33:17.46,1:33:19.13,Default,,0,0,0,,Анашым! Бірдеңе істе!
Dialogue: 0,1:33:21.22,1:33:24.14,Default,,0,0,0,,Ой-а-а
Dialogue: 0,1:33:27.56,1:33:28.56,Default,,0,0,0,,Бұрыс!
Dialogue: 0,1:33:33.60,1:33:36.15,Default,,0,0,0,,Ропле-кун, тез ажырат!
Dialogue: 0,1:33:47.99,1:33:49.20,Default,,0,0,0,,Бұл энергия толқындарының дауылы.
Dialogue: 0,1:33:49.33,1:33:52.00,Default,,0,0,0,,О, не? иә?
Dialogue: 0,1:33:52.12,1:33:53.41,Default,,0,0,0,,Не болды? Молина мырза
Dialogue: 0,1:33:53.54,1:33:54.71,Default,,0,0,0,,Booster жұмыс істемейді
Dialogue: 0,1:33:54.83,1:33:55.58,Default,,0,0,0,,Иә
Dialogue: 0,1:33:55.71,1:33:58.63,Default,,0,0,0,,Бұл қиын. Мені энергия толқындары сүйреп бара жатыр.
Dialogue: 0,1:33:59.17,1:34:01.26,Default,,0,0,0,,Мен оны жөндеймін. Ахх.
Dialogue: 0,1:34:01.38,1:34:03.05,Default,,0,0,0,,Дораемон, фурошики уақытын бөл
Dialogue: 0,1:34:03.17,1:34:05.34,Default,,0,0,0,,Түсіндім, фурошики уақыты келді...
Dialogue: 0,1:34:05.47,1:34:07.39,Default,,0,0,0,,Ах (Молина) Роппл!
Dialogue: 0,1:34:07.68,1:34:08.89,Default,,0,0,0,,Ах (Нобита) Уф
Dialogue: 0,1:34:09.39,1:34:10.31,Default,,0,0,0,,Барлығы ұстаныңыз!
Dialogue: 0,1:34:10.43,1:34:11.89,Default,,0,0,0,,Ах (Нобита) Уф
Dialogue: 0,1:34:22.69,1:34:24.11,Default,,0,0,0,,Барлығы зардап шегеді ме?
Dialogue: 0,1:34:24.24,1:34:26.36,Default,,0,0,0,,А... у... Иә?
Dialogue: 0,1:34:26.78,1:34:28.74,Default,,0,0,0,,Бұл жер қай жер?
Dialogue: 0,1:34:28.87,1:34:29.53,Default,,0,0,0,,Ах
Dialogue: 0,1:34:32.70,1:34:34.75,Default,,0,0,0,,Эй, мен мұнда бұрын болғанмын.
Dialogue: 0,1:34:34.87,1:34:35.92,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,1:34:36.58,1:34:39.67,Default,,0,0,0,,Қарашы, Дорами-чан сені бір рет құтқарды, солай ма?
Dialogue: 0,1:34:39.79,1:34:42.38,Default,,0,0,0,,Дәл сол кезде мен кезіп жүрген жұлдызға ұқсайды.
Dialogue: 0,1:34:42.51,1:34:45.93,Default,,0,0,0,,Сонда бұл жұлдыз да кеңістік-уақыттың бұрмалануына байланысты.
Dialogue: 0,1:34:46.30,1:34:49.47,Default,,0,0,0,,Егер сіз ол жерден өтсеңіз, сіз Коя Кояға қайта аласыз, солай ма?
Dialogue: 0,1:34:49.60,1:34:52.68,Default,,0,0,0,,Жартастың жанында кеңістік-уақыттың бұрмалануы болды.
Dialogue: 0,1:34:53.02,1:34:53.93,Default,,0,0,0,,Мынаны қараңыз.
Dialogue: 0,1:34:54.68,1:34:56.10,Default,,0,0,0,,Бұл ракета!
Dialogue: 0,1:34:56.23,1:34:57.81,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,1:34:59.52,1:35:01.94,Default,,0,0,0,,Немесе... бұл құбыжық! Мен оны бұрын көргенмін
Dialogue: 0,1:35:02.69,1:35:04.94,Default,,0,0,0,,Жоқ, жігіт.
Dialogue: 0,1:35:05.32,1:35:06.70,Default,,0,0,0,,Бір минут күтіңіз
Dialogue: 0,1:35:08.03,1:35:09.53,Default,,0,0,0,,Молина!? (Молина) Ах!
Dialogue: 0,1:35:09.66,1:35:10.95,Default,,0,0,0,,Бұл Молина! (Молина) Иә?
Dialogue: 0,1:35:23.71,1:35:24.63,Default,,0,0,0,,Ах...
Dialogue: 0,1:35:28.80,1:35:30.39,Default,,0,0,0,,Доктор Бернс
Dialogue: 0,1:35:30.51,1:35:32.43,Default,,0,0,0,,Ал, Молина мырза...
Dialogue: 0,1:35:32.81,1:35:36.48,Default,,0,0,0,,У… Уу…
Dialogue: 0,1:35:37.02,1:35:41.02,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:35:43.77,1:35:45.28,Default,,0,0,0,,Молина
Dialogue: 0,1:35:45.99,1:35:47.45,Default,,0,0,0,,Бұл планетаға қалай келдіңіз?
Dialogue: 0,1:35:51.99,1:35:53.45,Default,,0,0,0,,Ах
Dialogue: 0,1:35:53.66,1:35:57.66,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:36:00.37,1:36:02.84,Default,,0,0,0,,Әке!
Dialogue: 0,1:36:10.01,1:36:13.72,Default,,0,0,0,,Сіз тірісіз, әке.
Dialogue: 0,1:36:13.89,1:36:15.97,Default,,0,0,0,,Сенсіз өлуім керек пе?
Dialogue: 0,1:36:16.47,1:36:19.77,Default,,0,0,0,,Мен осы уақытқа дейін өз күшіммен зымыран құрастырып үлгердім.
Dialogue: 0,1:36:28.74,1:36:30.28,Default,,0,0,0,,Сәлем Дораемон
Dialogue: 0,1:36:30.49,1:36:34.12,Default,,0,0,0,,Бұл планетаның ғарышты игерудің тағы бір тарихы болды.
Dialogue: 0,1:36:34.24,1:36:35.37,Default,,0,0,0,,Иә
Dialogue: 0,1:36:42.71,1:36:44.96,Default,,0,0,0,,А, ғарыш полициясы.
Dialogue: 0,1:36:45.09,1:36:47.51,Default,,0,0,0,,Бұл Ропле-кун мен Нобита-кун.
Dialogue: 0,1:36:47.76,1:36:50.88,Default,,0,0,0,,Мен кеңістік-уақыттың бұрмалануын толық жылдамдықпен қуып келемін.
Dialogue: 0,1:36:51.01,1:36:53.22,Default,,0,0,0,,Коя Коядағылардың барлығы қауіпсіз бе?
Dialogue: 0,1:36:53.80,1:36:55.39,Default,,0,0,0,,Уайымдамаңыз.
Dialogue: 0,1:36:55.51,1:36:58.68,Default,,0,0,0,,Гартит өндіруші жігіттердің барлығы қамауға алынды.
Dialogue: 0,1:36:58.81,1:37:01.27,Default,,0,0,0,,Балалар сендерге рахмет, үйге қайтайық.
Dialogue: 0,1:37:02.10,1:37:03.02,Default,,0,0,0,,Иә
Dialogue: 0,1:37:03.77,1:37:06.82,Default,,0,0,0,,Мен тек компанияның бұйрығын орындадым.
Dialogue: 0,1:37:06.94,1:37:09.86,Default,,0,0,0,,Бала маған мұндай қарым-қатынас жасайды деп ешқашан ойламадым.
Dialogue: 0,1:37:11.49,1:37:13.99,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,1:37:14.11,1:37:15.45,Default,,0,0,0,,Жарайсың, аман бол.
Dialogue: 0,1:37:15.57,1:37:17.41,Default,,0,0,0,,Молина уайымдағаныңыз үшін кешірім сұрайды.
Dialogue: 0,1:37:17.74,1:37:19.25,Default,,0,0,0,,Сәлем Нобита!
Dialogue: 0,1:37:19.37,1:37:22.92,Default,,0,0,0,,Бауырым, үйге тезірек бармасаң, есік көрінбей қалады.
Dialogue: 0,1:37:23.92,1:37:25.96,Default,,0,0,0,,Қоштасатын кез келген сияқты.
Dialogue: 0,1:37:26.09,1:37:29.09,Default,,0,0,0,,Нобита-кун Дораемонға рахмет
Dialogue: 0,1:37:29.21,1:37:32.55,Default,,0,0,0,,Мен әкеммен бірге сол планетаны зерттеуді шештім.
Dialogue: 0,1:37:32.80,1:37:33.93,Default,,0,0,0,,(Виолет) Мен теремін. (Роданс) Жарай бер.
Dialogue: 0,1:37:38.89,1:37:41.31,Default,,0,0,0,,Мен сені мәңгілікке ұмытпаймын
Dialogue: 0,1:37:41.43,1:37:42.89,Default,,0,0,0,,Мен де
Dialogue: 0,1:37:48.02,1:37:50.03,Default,,0,0,0,,Хмм, үйге барма!
Dialogue: 0,1:37:50.15,1:37:53.03,Default,,0,0,0,,Мен бұл лас планетаға ешқашан оралмаймын
Dialogue: 0,1:37:53.15,1:37:55.66,Default,,0,0,0,,Шумми
Dialogue: 0,1:37:56.03,1:37:57.99,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:37:58.12,1:38:01.45,Default,,0,0,0,,Жер Нобита мен оның достарының үйі.
Dialogue: 0,1:38:04.67,1:38:06.42,Default,,0,0,0,,Чумми, сау бол.
Dialogue: 0,1:38:06.54,1:38:08.46,Default,,0,0,0,,Жұлдыз болуға сәл ғана қалдым.
Dialogue: 0,1:38:10.42,1:38:13.88,Default,,0,0,0,,Осыны біз деп ойлап, қастерле.
Dialogue: 0,1:38:14.01,1:38:15.80,Default,,0,0,0,,Рахмет, мен оны бағалаймын.
Dialogue: 0,1:38:22.39,1:38:24.48,Default,,0,0,0,,Аха~
Dialogue: 0,1:38:24.60,1:38:26.98,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,1:38:27.48,1:38:29.23,Default,,0,0,0,,Қош бол~ Тағы кездескенше
Dialogue: 0,1:38:29.36,1:38:30.98,Default,,0,0,0,,Сау болыңыз!
Dialogue: 0,1:38:31.48,1:38:33.07,Default,,0,0,0,,Қош бол~
Dialogue: 0,1:38:33.19,1:38:35.07,Default,,0,0,0,,Ішімде…
Dialogue: 0,1:38:35.20,1:38:38.20,Default,,0,0,0,,Қош бол~
Dialogue: 0,1:38:39.24,1:38:41.20,Default,,0,0,0,,Хмм (Сунео) Жақсы түсіру.
Dialogue: 0,1:38:41.33,1:38:42.49,Default,,0,0,0,,А, қараңдаршы, уау.
Dialogue: 0,1:38:43.25,1:38:44.66,Default,,0,0,0,,Ол қалыпты жағдайға оралды
Dialogue: 0,1:38:44.79,1:38:47.17,Default,,0,0,0,,Мен Супермен болғанымды қалаймын.
Dialogue: 0,1:38:47.29,1:38:49.29,Default,,0,0,0,,Бұл тамаша жұлдыз болды...
Dialogue: 0,1:38:52.46,1:38:53.46,Default,,0,0,0,,Нобита-сан
Dialogue: 0,1:38:53.59,1:38:56.13,Default,,0,0,0,,Барлығы жақсы.
Dialogue: 0,1:38:56.47,1:38:57.38,Default,,0,0,0,,Иә
Dialogue: 0,1:38:58.18,1:39:00.60,Default,,0,0,0,,Қоймашыны алыңыз!
Dialogue: 0,1:39:00.72,1:39:02.01,Default,,0,0,0,,Кеттік, Нобита!
Dialogue: 0,1:39:02.14,1:39:02.85,Default,,0,0,0,,О! (Сунео) Жарайды.
Dialogue: 0,1:39:02.97,1:39:04.89,Default,,0,0,0,,Әрқашан осылай.
Dialogue: 0,1:39:05.02,1:39:05.77,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,1:39:05.89,1:39:06.52,Default,,0,0,0,,Га (Бала) Шық!
Dialogue: 0,1:39:06.64,1:39:07.77,Default,,0,0,0,,Бұл ~ (Сунео) ебедейсіз!
Dialogue: 0,1:39:09.23,1:39:11.52,Default,,0,0,0,,Бүгін қар гүлдері гүлдеді
Dialogue: 0,1:39:12.07,1:39:15.74,Default,,0,0,0,,Бағалаймын, асыл қазынам
Dialogue: 0,1:39:17.32,1:39:23.33,Default,,0,0,0,,♪〜
Dialogue: 0,1:42:12.29,1:42:18.29,Default,,0,0,0,,〜♪
Dialogue: 0,1:42:19.79,1:42:25.79,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory