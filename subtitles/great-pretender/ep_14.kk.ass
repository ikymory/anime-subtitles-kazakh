Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.20,0:00:03.87,Default,,0,0,0,,(Қылқаламмен сурет салу дыбысы)
Dialogue: 0,0:00:04.42,0:00:07.50,Default,,0,0,0,,Монтойя өзінің сурет салу стилін таба алмады.
Dialogue: 0,0:00:07.63,0:00:09.42,Default,,0,0,0,,Бұл көп күш жұмсаған сияқты.
Dialogue: 0,0:00:09.88,0:00:12.01,Default,,0,0,0,,Ол жай ғана көшіріп алды
Dialogue: 0,0:00:12.34,0:00:17.01,Default,,0,0,0,,Өзіңіз құрметтейтін суретшілердің картиналарын мұқият талдап, іздеңіз
Dialogue: 0,0:00:17.14,0:00:19.89,Default,,0,0,0,,Мен өзімнің картинама жеттім.
Dialogue: 0,0:00:21.06,0:00:25.27,Default,,0,0,0,,Соңында үлгере алмадым.
Dialogue: 0,0:00:26.40,0:00:32.40,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:24.83,0:01:30.84,Default,,0,0,0,,~♪
Dialogue: 0,0:01:31.34,0:01:34.01,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:01:34.34,0:01:36.09,Default,,0,0,0,,Міне! (Томас) Өте жаман
Dialogue: 0,0:01:36.22,0:01:37.84,Default,,0,0,0,,Мен мүлдем ажырата алмаймын!
Dialogue: 0,0:01:38.72,0:01:40.26,Default,,0,0,0,,Оны айтуды жек көремін, бірақ
Dialogue: 0,0:01:40.39,0:01:43.93,Default,,0,0,0,,Егер кімде-кім айырмашылықты айта алатын болса, бұл Коулман болуы мүмкін.
Dialogue: 0,0:01:45.14,0:01:46.81,Default,,0,0,0,,Күміс шынайырақ
Dialogue: 0,0:01:47.14,0:01:50.48,Default,,0,0,0,,Қарасы жалған. Сіз мұнымен қателесе алмайсыз.
Dialogue: 0,0:01:50.61,0:01:53.32,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:01:54.98,0:01:57.24,Default,,0,0,0,,Ах, ақшаны аударыңыз.
Dialogue: 0,0:01:57.53,0:02:00.32,Default,,0,0,0,,Тексергеннен кейін... О, онда.
Dialogue: 0,0:02:01.49,0:02:03.49,Default,,0,0,0,,Енді сіздің қарызыңыз бітті.
Dialogue: 0,0:02:04.20,0:02:06.96,Default,,0,0,0,,Хаа... Күн ашық, мен боспын.
Dialogue: 0,0:02:07.25,0:02:09.46,Default,,0,0,0,,Мен енді ешқашан сурет салмаймын деп шештім.
Dialogue: 0,0:02:10.17,0:02:12.71,Default,,0,0,0,,Сіз не болатынын ешқашан білмейсіз.
Dialogue: 0,0:02:12.84,0:02:19.51,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:02:20.97,0:02:22.80,Default,,0,0,0,,Күміс шынайы
Dialogue: 0,0:02:26.85,0:02:28.64,Default,,0,0,0,,Эдвард VIII...
Dialogue: 0,0:02:34.98,0:02:36.73,Default,,0,0,0,,Шақыруыңыз келді.
Dialogue: 0,0:02:36.86,0:02:37.78,Default,,0,0,0,,Лораннан?
Dialogue: 0,0:02:38.74,0:02:41.87,Default,,0,0,0,,Біз қара аукционның егжей-тегжейін біле алмадық.
Dialogue: 0,0:02:42.07,0:02:45.08,Default,,0,0,0,,«Лондондағы қардың» нарықтық бағасы хит немесе сәтсіз.
Dialogue: 0,0:02:45.29,0:02:46.62,Default,,0,0,0,,Бұл бөлікке алаңдамаңыз.
Dialogue: 0,0:02:47.25,0:02:49.29,Default,,0,0,0,,Мен сізге не істеу керектігін айттым.
Dialogue: 0,0:02:49.41,0:02:51.25,Default,,0,0,0,,«Міндетті түрде өтінім беріңіз».
Dialogue: 0,0:02:51.37,0:02:54.84,Default,,0,0,0,,Бірақ Фарах мырзаның қолында қанша ақша болса да, оған ақша жетеді ме?
Dialogue: 0,0:02:54.96,0:02:55.80,Default,,0,0,0,,Хмф!
Dialogue: 0,0:02:57.17,0:02:58.59,Default,,0,0,0,,Lloyd's компаниясына хабарласуым керек пе?
Dialogue: 0,0:02:58.92,0:03:01.05,Default,,0,0,0,,Егер сіз оны қолма-қол ақшаға айналдыру туралы айтып жатсаңыз, әлі емес.
Dialogue: 0,0:03:01.18,0:03:02.39,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:03:03.14,0:03:06.81,Default,,0,0,0,,Өзіңіз айтқандай, шешім қабылдауда сәл абай болыңыз.
Dialogue: 0,0:03:06.93,0:03:07.77,Default,,0,0,0,,Тим!
Dialogue: 0,0:03:08.14,0:03:09.52,Default,,0,0,0,,Уф! Босат! Мені босат!
Dialogue: 0,0:03:10.44,0:03:13.56,Default,,0,0,0,,қажетсіз деп саналатын жылжымайтын мүлікке басымдық береді.
Dialogue: 0,0:03:13.69,0:03:14.52,Default,,0,0,0,,Иә
Dialogue: 0,0:03:15.23,0:03:18.32,Default,,0,0,0,,Тим Джеймс мұны сұрап тұр.
Dialogue: 0,0:03:18.65,0:03:19.49,Default,,0,0,0,,Иә
Dialogue: 0,0:03:20.95,0:03:22.49,Default,,0,0,0,,Жылжымайтын мүлікті сату
Dialogue: 0,0:03:23.91,0:03:25.53,Default,,0,0,0,,50 миллион фунт?
Dialogue: 0,0:03:25.91,0:03:28.54,Default,,0,0,0,,Мен кем дегенде 70 миллион иен аламын ба деп ойлаймын.
Dialogue: 0,0:03:28.66,0:03:30.50,Default,,0,0,0,,Мұндай ақшаны қайдан табуға болады?
Dialogue: 0,0:03:30.62,0:03:32.83,Default,,0,0,0,,50 миллион жеткілікті!
Dialogue: 0,0:03:33.17,0:03:36.29,Default,,0,0,0,,Егер Фарах қайтадан шошып кетсе, оның баласы болмайды.
Dialogue: 0,0:03:37.00,0:03:38.63,Default,,0,0,0,,Көшбасшы ретінде сіздің пікіріңіз қандай?
Dialogue: 0,0:03:38.80,0:03:41.55,Default,,0,0,0,,Коулманға қызмет еткен бейшара қозы
Dialogue: 0,0:03:41.67,0:03:43.43,Default,,0,0,0,,Мен сені 70 миллион үшін кешіремін.
Dialogue: 0,0:03:43.55,0:03:46.60,Default,,0,0,0,,Көшбасшы күткендей, ол орасан зор.
Dialogue: 0,0:03:46.72,0:03:47.64,Default,,0,0,0,,Эбби
Dialogue: 0,0:03:48.68,0:03:51.64,Default,,0,0,0,,Мен онымен хабарластым, сондықтан сіздің жағдайыңыз жақсы деп үміттенемін.
Dialogue: 0,0:03:51.98,0:03:54.69,Default,,0,0,0,,Бұл сізді керемет түрде оятады
Dialogue: 0,0:04:25.93,0:04:28.30,Default,,0,0,0,,Сицилиялық Дон Сальваторе?
Dialogue: 0,0:04:28.55,0:04:30.06,Default,,0,0,0,,Сол жолмен жүріңіз.
Dialogue: 0,0:04:30.18,0:04:31.02,Default,,0,0,0,,Шизуку Каваками, Курона Анку, Наширо
Dialogue: 0,0:04:31.14,0:04:34.56,Default,,0,0,0,,Жапониядан келген Босс Кудо! Жағдайыңыз жақсы сияқты
Dialogue: 0,0:04:34.69,0:04:39.52,Default,,0,0,0,,Сеулдегі Қызыл Айдаһар қоғамының төрағасына! Сіз әрқашан әдемі болғаныңызша
Dialogue: 0,0:04:39.90,0:04:41.53,Default,,0,0,0,,Олардың бәрі мафия ма?
Dialogue: 0,0:04:41.65,0:04:42.90,Default,,0,0,0,,Көзге тым көп тиюден аулақ болыңыз
Dialogue: 0,0:04:43.82,0:04:46.16,Default,,0,0,0,,Қош келдіңіз, Джеймс Коулман мырза
Dialogue: 0,0:04:46.28,0:04:48.28,Default,,0,0,0,,Металды анықтаусыз енгізіңіз.
Dialogue: 0,0:04:48.70,0:04:50.29,Default,,0,0,0,,Жақсы дыбыстау.
Dialogue: 0,0:04:52.62,0:04:54.37,Default,,0,0,0,,Гардероб сіз кірген кезде сол жақта.
Dialogue: 0,0:04:59.34,0:05:00.30,Default,,0,0,0,,Меніңше... олар әлі өздерін жинастыра алмай, қиналып жатыр.
Dialogue: 0,0:05:00.88,0:05:03.17,Default,,0,0,0,,Кеше маған біртүрлі телефон қоңырауы түсті.
Dialogue: 0,0:05:03.30,0:05:05.30,Default,,0,0,0,,Мен сізден әртүрлі нәрселерді естігім келеді.
Dialogue: 0,0:05:06.30,0:05:09.93,Default,,0,0,0,,Фарахқа қазір көмектесетін жалғыз адам сенсің.
Dialogue: 0,0:05:13.89,0:05:15.81,Default,,0,0,0,,(қонақ күлкі)
Dialogue: 0,0:05:16.52,0:05:19.44,Default,,0,0,0,,Жадағайдың ебедейсіздігінің өзі көзге ұрып тұр.
Dialogue: 0,0:05:20.27,0:05:21.94,Default,,0,0,0,,Әуесқойлар
Dialogue: 0,0:05:24.15,0:05:26.24,Default,,0,0,0,,Бұл өте маңызды.
Dialogue: 0,0:05:26.74,0:05:29.28,Default,,0,0,0,,СНС-те тарамағаны ұят.
Dialogue: 0,0:05:29.41,0:05:33.20,Default,,0,0,0,,Күні кеше мен Шагалдың Белласына бір көргеннен ғашық болдым.
Dialogue: 0,0:05:33.37,0:05:36.25,Default,,0,0,0,,Менің жуынатын бөлмем Сезанның автопортреті
Dialogue: 0,0:05:37.21,0:05:39.13,Default,,0,0,0,,Кейбір адамдар өзгерді.
Dialogue: 0,0:05:39.38,0:05:42.05,Default,,0,0,0,,Олар шынымен де өте жағымсыз.
Dialogue: 0,0:05:46.17,0:05:47.76,Default,,0,0,0,,Адамдар айтады
Dialogue: 0,0:05:48.09,0:05:52.60,Default,,0,0,0,,«Тамаша өнер туындылары – бүкіл адамзаттың ортақ меншігі».
Dialogue: 0,0:05:53.14,0:05:55.43,Default,,0,0,0,,Бұл шынымен солай ма?
Dialogue: 0,0:05:56.02,0:06:01.98,Default,,0,0,0,,Өнер туындысы үшін шынайы бақыт - бұл өнерді терең сүйетіндердің монополиясы.
Dialogue: 0,0:06:02.11,0:06:04.73,Default,,0,0,0,,Бұл таң қалдыратын нәрсе емес пе?
Dialogue: 0,0:06:05.36,0:06:07.15,Default,,0,0,0,,Мен білетін нәрсе
Dialogue: 0,0:06:08.32,0:06:12.41,Default,,0,0,0,,Бұл жерде нағыз өнер сүйер қауым бас қосады
Dialogue: 0,0:06:13.12,0:06:18.12,Default,,0,0,0,,Әлемдегі ең жоғары және жалғыз аукционға қош келдіңіз!
Dialogue: 0,0:06:19.21,0:06:25.76,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:25.88,0:06:27.22,Default,,0,0,0,,Жағымсыз дәм...
Dialogue: 0,0:06:29.47,0:06:33.39,Default,,0,0,0,,Маркус Гюгоның бірінші жұмысы «Аты жоқ»
Dialogue: 0,0:06:33.51,0:06:35.06,Default,,0,0,0,,Бұл қанша?
Dialogue: 0,0:06:35.18,0:06:38.73,Default,,0,0,0,,Жақсы ұсыныс бағасы 30 000 фунт болады.
Dialogue: 0,0:06:39.31,0:06:40.65,Default,,0,0,0,,£100 000 бастап
Dialogue: 0,0:06:40.81,0:06:41.65,Default,,0,0,0,,100 000?
Dialogue: 0,0:06:41.77,0:06:42.98,Default,,0,0,0,,130 000!
Dialogue: 0,0:06:43.19,0:06:44.44,Default,,0,0,0,,150 000!
Dialogue: 0,0:06:44.94,0:06:47.07,Default,,0,0,0,,16... Бұл 20
Dialogue: 0,0:06:47.69,0:06:50.95,Default,,0,0,0,,25...арттағы 28
Dialogue: 0,0:06:51.99,0:06:53.07,Default,,0,0,0,,Иә 30!
Dialogue: 0,0:06:53.37,0:06:55.37,Default,,0,0,0,,Сонымен қатар… 32!
Dialogue: 0,0:06:55.87,0:06:59.12,Default,,0,0,0,,Сіз сенімдісіз бе? 320 000!
Dialogue: 0,0:06:59.75,0:07:00.58,Default,,0,0,0,,Сәтті өтінім!
Dialogue: 0,0:07:02.29,0:07:05.59,Default,,0,0,0,,Мишель Чан «Қысқы таң» 2005 ж
Dialogue: 0,0:07:05.96,0:07:07.00,Default,,0,0,0,,80 000
Dialogue: 0,0:07:07.21,0:07:08.71,Default,,0,0,0,,200 000 фунттан бастап
Dialogue: 0,0:07:09.30,0:07:11.22,Default,,0,0,0,,250 000! 300 000!
Dialogue: 0,0:07:11.59,0:07:14.72,Default,,0,0,0,,35… 40… 45…
Dialogue: 0,0:07:15.26,0:07:18.68,Default,,0,0,0,,46… 47… 50!
Dialogue: 0,0:07:19.06,0:07:21.27,Default,,0,0,0,,500 000-ға сәтті өтінім!
Dialogue: 0,0:07:21.64,0:07:25.15,Default,,0,0,0,,Садао Мияги «Бар» 1920 ж
Dialogue: 0,0:07:25.44,0:07:26.36,Default,,0,0,0,,180 000
Dialogue: 0,0:07:27.44,0:07:29.82,Default,,0,0,0,,820 000-ға сәтті өтінім!
Dialogue: 0,0:07:30.57,0:07:33.32,Default,,0,0,0,,Милан Миланович «Үш қыз»
Dialogue: 0,0:07:33.66,0:07:34.66,Default,,0,0,0,,250 000
Dialogue: 0,0:07:35.03,0:07:36.62,Default,,0,0,0,,1,03 миллионға сәтті өтінім!
Dialogue: 0,0:07:40.91,0:07:42.87,Default,,0,0,0,,Джеймс, жақсысың ба?
Dialogue: 0,0:07:43.50,0:07:47.30,Default,,0,0,0,,Қандай дәмсіз ақша ойыны, өнерге тіл тигізу.
Dialogue: 0,0:07:47.88,0:07:50.17,Default,,0,0,0,,«Лондондағы қар» жақсы.
Dialogue: 0,0:07:50.30,0:07:52.05,Default,,0,0,0,,Бұл сурет сіздікі болуы керек.
Dialogue: 0,0:07:52.55,0:07:55.18,Default,,0,0,0,,Маған қалдырыңыз (Кудо) Мүмкін 50 миллион.
Dialogue: 0,0:07:55.55,0:07:56.39,Default,,0,0,0,,Бұл тәтті.
Dialogue: 0,0:07:56.51,0:08:00.31,Default,,0,0,0,,60 миллион, мүмкін 70 миллион.
Dialogue: 0,0:08:00.43,0:08:01.73,Default,,0,0,0,,Мүмкін емес!
Dialogue: 0,0:08:01.85,0:08:05.02,Default,,0,0,0,,Бұл суретті оңай алу мүмкін емес.
Dialogue: 0,0:08:05.15,0:08:07.98,Default,,0,0,0,,Өйткені, бұл Коулманның растауы.
Dialogue: 0,0:08:08.90,0:08:11.69,Default,,0,0,0,,Джеймс, сәл күте тұрыңыз.
Dialogue: 0,0:08:13.03,0:08:14.28,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:08:15.16,0:08:16.87,Default,,0,0,0,,Иә Бұл не?
Dialogue: 0,0:08:17.20,0:08:19.66,Default,,0,0,0,,20 миллион артық, не істей аламыз?
Dialogue: 0,0:08:19.87,0:08:21.58,Default,,0,0,0,,Бұл жеткіліксіз сияқты.
Dialogue: 0,0:08:21.95,0:08:24.96,Default,,0,0,0,,Мен талай рет айтқанымдай, енді жоқ...
Dialogue: 0,0:08:25.21,0:08:27.67,Default,,0,0,0,,Актив қалыптастыру үшін тым көп
Dialogue: 0,0:08:28.09,0:08:30.51,Default,,0,0,0,,Мен саған мұны істе десем, сен істейсің.
Dialogue: 0,0:08:30.63,0:08:32.47,Default,,0,0,0,,Барлық шығынды жинаңыз
Dialogue: 0,0:08:32.59,0:08:33.42,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:08:34.80,0:08:35.68,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,0:08:35.80,0:08:38.26,Default,,0,0,0,,Қызмет еткен күннен бастап 35 жыл
Dialogue: 0,0:08:38.39,0:08:42.35,Default,,0,0,0,,Қате Мен сізге кеңес беремін.
Dialogue: 0,0:08:42.68,0:08:43.68,Default,,0,0,0,,Тим?
Dialogue: 0,0:08:43.85,0:08:46.27,Default,,0,0,0,,Коулманның тілегін қанағаттандырғаннан кейін
Dialogue: 0,0:08:46.40,0:08:49.61,Default,,0,0,0,,Оның жүрегін қозғай алмайтын шығарсың.
Dialogue: 0,0:08:50.69,0:08:52.61,Default,,0,0,0,,Сен не білесің?
Dialogue: 0,0:08:52.74,0:08:54.11,Default,,0,0,0,,Мен күзетші болсам да
Dialogue: 0,0:08:54.70,0:08:57.91,Default,,0,0,0,,Фарах, өтінемін, мен емес, күтуші.
Dialogue: 0,0:08:58.07,0:09:00.95,Default,,0,0,0,,Тимнің жеке сөздерін тыңдаңыз:
Dialogue: 0,0:09:03.04,0:09:05.16,Default,,0,0,0,,Не? Сол себепті...
Dialogue: 0,0:09:05.29,0:09:06.12,Default,,0,0,0,,Қате
Dialogue: 0,0:09:08.25,0:09:10.96,Default,,0,0,0,,Оған? Иә
Dialogue: 0,0:09:13.13,0:09:16.22,Default,,0,0,0,,Мен де ұстазымды қатты сыйлайтынмын.
Dialogue: 0,0:09:16.51,0:09:17.34,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:09:17.93,0:09:21.10,Default,,0,0,0,,Кешіріңіз, тым көп нәрсе болып жатыр.
Dialogue: 0,0:09:24.10,0:09:25.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:26.48,0:09:27.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:29.19,0:09:31.65,Default,,0,0,0,,Міне, күн жылып барады.
Dialogue: 0,0:09:32.23,0:09:34.94,Default,,0,0,0,,Бүгін жиналғандар, өз көздеріңмен көріңдер...
Dialogue: 0,0:09:35.07,0:09:35.95,Default,,0,0,0,,Онда...
Dialogue: 0,0:09:36.07,0:09:38.53,Default,,0,0,0,,Бұл оны көрудің соңғы мүмкіндігі болуы мүмкін.
Dialogue: 0,0:09:38.66,0:09:39.70,Default,,0,0,0,,
Dialogue: 0,0:09:40.32,0:09:41.74,Default,,0,0,0,,Кеттік
Dialogue: 0,0:09:41.95,0:09:47.75,Default,,0,0,0,,Серхио Монтойя «Лондондағы қар» 1930 № 4
Dialogue: 0,0:09:49.29,0:09:50.67,Default,,0,0,0,,Иә...
Dialogue: 0,0:09:51.04,0:09:52.88,Default,,0,0,0,,£30 миллионнан бастап!
Dialogue: 0,0:09:53.00,0:09:55.42,Default,,0,0,0,,35 миллион! 40 миллион!
Dialogue: 0,0:09:56.42,0:09:57.72,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:09:57.84,0:09:59.05,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:59.26,0:10:00.18,Default,,0,0,0,,Фарах ше?
Dialogue: 0,0:10:00.39,0:10:02.39,Default,,0,0,0,,Мен өзімді жақсы сезінбегендіктен үзіліс жасап жатырмын.
Dialogue: 0,0:10:02.76,0:10:05.64,Default,,0,0,0,,Бірақ 70 миллионға дейін алуға болатын сияқты.
Dialogue: 0,0:10:06.27,0:10:08.14,Default,,0,0,0,,«Сіздің өтінімді сәтті жасағаныңызды қалаймыз».
Dialogue: 0,0:10:10.06,0:10:11.27,Default,,0,0,0,,60 миллион
Dialogue: 0,0:10:11.40,0:10:12.82,Default,,0,0,0,,
Dialogue: 0,0:10:12.94,0:10:14.61,Default,,0,0,0,,Ал, 60 миллион шықты!
Dialogue: 0,0:10:15.32,0:10:16.65,Default,,0,0,0,,Не болып жатыр өзі?
Dialogue: 0,0:10:16.82,0:10:19.66,Default,,0,0,0,,Енді сіздің «The Snows of London» фильмін сатып алудың жалғыз мүмкіндігі.
Dialogue: 0,0:10:20.41,0:10:22.03,Default,,0,0,0,,Голливудтың атақты продюсерлері...
Dialogue: 0,0:10:22.16,0:10:23.08,Default,,0,0,0,,
Dialogue: 0,0:10:23.20,0:10:25.66,Default,,0,0,0,,Ой... 65 миллион!
Dialogue: 0,0:10:26.75,0:10:28.16,Default,,0,0,0,,66 миллион!
Dialogue: 0,0:10:28.46,0:10:31.54,Default,,0,0,0,,67 миллион (Коулман) 68 миллион!
Dialogue: 0,0:10:31.67,0:10:33.13,Default,,0,0,0,,69 миллион
Dialogue: 0,0:10:33.63,0:10:35.30,Default,,0,0,0,,69 миллион шықты
Dialogue: 0,0:10:37.63,0:10:39.55,Default,,0,0,0,,70 миллион!
Dialogue: 0,0:10:39.93,0:10:43.05,Default,,0,0,0,,Соңында 70 миллион! Тамаша!
Dialogue: 0,0:10:43.30,0:10:45.72,Default,,0,0,0,,Сіз Монтойяның қадірін білесіз!
Dialogue: 0,0:10:47.31,0:10:49.52,Default,,0,0,0,,Осылайша, өтінім 70 миллионға жасалды...
Dialogue: 0,0:10:49.69,0:10:52.56,Default,,0,0,0,,
Dialogue: 0,0:10:52.73,0:10:54.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:54.19,0:10:55.57,Default,,0,0,0,,А…?
Dialogue: 0,0:10:56.32,0:10:57.57,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:00.95,0:11:02.57,Default,,0,0,0,,71 миллион.
Dialogue: 0,0:11:04.78,0:11:07.54,Default,,0,0,0,,Ой... мүмкін
Dialogue: 0,0:11:07.66,0:11:09.87,Default,,0,0,0,,Бұл керемет болады.
Dialogue: 0,0:11:10.87,0:11:13.54,Default,,0,0,0,,Сондықтан мен аукционды тоқтата алмаймын.
Dialogue: 0,0:11:14.21,0:11:15.34,Default,,0,0,0,,Енді 72 миллион ше?
Dialogue: 0,0:11:15.46,0:11:16.30,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:11:16.67,0:11:18.92,Default,,0,0,0,,Оны жатын бөлмеңізде көрсетіңіз
Dialogue: 0,0:11:19.05,0:11:20.42,Default,,0,0,0,,Монтойяның алдында
Dialogue: 0,0:11:20.55,0:11:24.05,Default,,0,0,0,,Мен тезірек келбетті жігіттермен көңіл көтергім келеді.
Dialogue: 0,0:11:24.22,0:11:25.35,Default,,0,0,0,,72 миллион!
Dialogue: 0,0:11:26.01,0:11:27.85,Default,,0,0,0,,72 миллион шықты!
Dialogue: 0,0:11:28.52,0:11:30.60,Default,,0,0,0,,Сонымен… 75 млн
Dialogue: 0,0:11:31.77,0:11:32.98,Default,,0,0,0,,75 миллион!
Dialogue: 0,0:11:33.10,0:11:34.44,Default,,0,0,0,,76 миллион!
Dialogue: 0,0:11:34.56,0:11:35.40,Default,,0,0,0,,80 миллион
Dialogue: 0,0:11:35.52,0:11:36.36,Default,,0,0,0,,Хаа…
Dialogue: 0,0:11:36.48,0:11:37.61,Default,,0,0,0,,81 миллион!
Dialogue: 0,0:11:38.19,0:11:39.57,Default,,0,0,0,,84 миллион
Dialogue: 0,0:11:42.53,0:11:44.37,Default,,0,0,0,,85 миллион!
Dialogue: 0,0:11:44.49,0:11:45.37,Default,,0,0,0,,90 миллион
Dialogue: 0,0:11:48.45,0:11:49.41,Default,,0,0,0,,91 миллион!
Dialogue: 0,0:11:50.00,0:11:51.37,Default,,0,0,0,,95 миллион
Dialogue: 0,0:11:52.08,0:11:54.67,Default,,0,0,0,,Монтойяның картиналары өте қымбат.
Dialogue: 0,0:11:54.79,0:11:55.63,Default,,0,0,0,,Қанша?
Dialogue: 0,0:11:55.92,0:11:56.88,Default,,0,0,0,,Ах~
Dialogue: 0,0:11:57.00,0:12:01.59,Default,,0,0,0,,Бізге өлгенше консервіленген бұршақ жеу жеткілікті ме?
Dialogue: 0,0:12:02.13,0:12:04.14,Default,,0,0,0,,Мен сәл жақсырақ нәрсені қалаймын
Dialogue: 0,0:12:04.43,0:12:08.51,Default,,0,0,0,,Бірақ бір күні сіздің картиналарыңыз да солай болатын шығар.
Dialogue: 0,0:12:08.76,0:12:12.02,Default,,0,0,0,,Егер бұл орын алса, қаладағы барлық консервіленген бұршақтарды сатып алайық.
Dialogue: 0,0:12:12.73,0:12:13.77,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:12:13.89,0:12:16.90,Default,,0,0,0,,Уф… 96 миллион!
Dialogue: 0,0:12:17.57,0:12:19.07,Default,,0,0,0,,97 миллион!
Dialogue: 0,0:12:19.44,0:12:20.82,Default,,0,0,0,,98 миллион!
Dialogue: 0,0:12:21.11,0:12:22.78,Default,,0,0,0,,99 миллион!
Dialogue: 0,0:12:23.74,0:12:30.45,Default,,0,0,0,,(Коулманның ауыр тыныс алуы)
Dialogue: 0,0:12:39.46,0:12:40.92,Default,,0,0,0,,100 миллион!
Dialogue: 0,0:12:45.05,0:12:46.30,Default,,0,0,0,,100 миллион фунт
Dialogue: 0,0:12:46.97,0:12:47.80,Default,,0,0,0,,Сәтті өтінім!
Dialogue: 0,0:12:47.93,0:12:53.27,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:12:53.39,0:12:55.14,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:13:02.90,0:13:05.65,Default,,0,0,0,,Бүгін сатып алғаныңызға рахмет.
Dialogue: 0,0:13:05.86,0:13:08.53,Default,,0,0,0,,Сіз қалай төлегіңіз келеді?
Dialogue: 0,0:13:09.03,0:13:11.45,Default,,0,0,0,,Серіктестік төлеуге міндетті
Dialogue: 0,0:13:11.58,0:13:12.70,Default,,0,0,0,,Жақында келуі керек
Dialogue: 0,0:13:13.29,0:13:17.04,Default,,0,0,0,,Жеңімпаз Коулман мырза болды.
Dialogue: 0,0:13:17.63,0:13:20.50,Default,,0,0,0,,Мен серіктесіме қайта қоңырау шала аламын ба?
Dialogue: 0,0:13:20.75,0:13:24.05,Default,,0,0,0,,Біз оны сізге саттық.
Dialogue: 0,0:13:24.34,0:13:27.97,Default,,0,0,0,,Ха...бірақ сен атақтысың.
Dialogue: 0,0:13:28.09,0:13:29.80,Default,,0,0,0,,Бұл есімге сеніңіз
Dialogue: 0,0:13:30.60,0:13:34.06,Default,,0,0,0,,Бүгін осы шотқа ақша салыңыз.
Dialogue: 0,0:13:34.18,0:13:35.73,Default,,0,0,0,,Оны сізге тапсырайық.
Dialogue: 0,0:13:36.14,0:13:37.14,Default,,0,0,0,,Мен сені тозақ шетіне дейін қуалап барам да, қылышымды міндетті түрде мойныңа түсіремін.
Dialogue: 0,0:13:43.78,0:13:45.40,Default,,0,0,0,,О...
Dialogue: 0,0:13:49.99,0:13:51.99,Default,,0,0,0,,Мен оны көрген сайын
Dialogue: 0,0:13:52.41,0:13:54.45,Default,,0,0,0,,Мен Торикомын
Dialogue: 0,0:13:56.29,0:13:58.21,Default,,0,0,0,,Түсіндік, аударайық.
Dialogue: 0,0:14:01.29,0:14:02.17,Default,,0,0,0,,Екі күн бұрын банк тонаған жігіт енді автобусты ұрлап кетті.
Dialogue: 0,0:14:02.29,0:14:04.88,Default,,0,0,0,,Мен сілтеме жасайтын шотқа ақшаны дереу аударыңыз.
Dialogue: 0,0:14:06.01,0:14:07.09,Default,,0,0,0,,(тост дыбысы)
Dialogue: 0,0:14:08.01,0:14:11.30,Default,,0,0,0,,Бірақ Синтия мені үрейлендірді.
Dialogue: 0,0:14:11.64,0:14:13.18,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:14:13.31,0:14:15.77,Default,,0,0,0,,«007» деген не?
Dialogue: 0,0:14:15.93,0:14:18.10,Default,,0,0,0,,Өйткені мен оны мүлдем көре алмаймын.
Dialogue: 0,0:14:18.44,0:14:21.44,Default,,0,0,0,,Коулманның бейбақымен не болады?
Dialogue: 0,0:14:21.61,0:14:23.32,Default,,0,0,0,,Компанияңызды және үйіңізді сатыңыз
Dialogue: 0,0:14:23.82,0:14:26.86,Default,,0,0,0,,Қарыз бен жалғандық қана қалады.
Dialogue: 0,0:14:28.99,0:14:30.11,Default,,0,0,0,,Фарах!
Dialogue: 0,0:14:30.36,0:14:31.62,Default,,0,0,0,,Жүр, мына жерді аш!
Dialogue: 0,0:14:33.08,0:14:35.16,Default,,0,0,0,,Қараңызшы, бұл «Лондондағы қар»!
Dialogue: 0,0:14:35.29,0:14:37.20,Default,,0,0,0,,Жақыннан көргенде шынымен таң қалдырады.
Dialogue: 0,0:14:37.33,0:14:39.96,Default,,0,0,0,,Өтінемін! Эй, сатып ал.
Dialogue: 0,0:14:40.54,0:14:42.84,Default,,0,0,0,,Тіпті жарты бағасы жақсы! Өтінемін...
Dialogue: 0,0:14:43.67,0:14:46.55,Default,,0,0,0,,Иә? Мен одан құтыла алмаймын...
Dialogue: 0,0:14:46.67,0:14:47.67,Default,,0,0,0,,Эй, эй...
Dialogue: 0,0:14:48.42,0:14:50.63,Default,,0,0,0,,Фарах!
Dialogue: 0,0:14:51.34,0:14:53.10,Default,,0,0,0,,Бұл бөлікке алаңдамаңыз.
Dialogue: 0,0:14:53.22,0:14:56.81,Default,,0,0,0,,Маған «Аукционда міндетті түрде ұтып ал» деп мұқият айтты.
Dialogue: 0,0:14:57.35,0:15:00.81,Default,,0,0,0,,Бірақ Фарах мырзаның қолында қанша ақша болса да, оған ақша жетеді ме?
Dialogue: 0,0:15:01.19,0:15:04.86,Default,,0,0,0,,Хмф! Анау егде әйелдің төсек жары бар...
Dialogue: 0,0:15:04.98,0:15:05.82,Default,,0,0,0,,(Тоқтату түймесін басқан дыбыс)
Dialogue: 0,0:15:07.36,0:15:08.19,Default,,0,0,0,,Қате
Dialogue: 0,0:15:09.15,0:15:11.66,Default,,0,0,0,,Барлық жоюлар аяқталды.
Dialogue: 0,0:15:12.07,0:15:12.99,Default,,0,0,0,,Иә
Dialogue: 0,0:15:14.20,0:15:15.62,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:15:15.91,0:15:16.74,Default,,0,0,0,,Иә
Dialogue: 0,0:15:17.24,0:15:20.50,Default,,0,0,0,,А... Мен тағы да жалғызбын
Dialogue: 0,0:15:22.79,0:15:23.75,Default,,0,0,0,,(бүктеу дыбысы)
Dialogue: 0,0:15:23.88,0:15:24.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:26.42,0:15:28.63,Default,,0,0,0,,Фарах Ұмытпа
Dialogue: 0,0:15:29.26,0:15:31.22,Default,,0,0,0,,Мен осындамын
Dialogue: 0,0:15:37.60,0:15:38.43,Default,,0,0,0,,Фу…
Dialogue: 0,0:15:38.56,0:15:45.56,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:15:50.57,0:15:54.91,Default,,0,0,0,,Бұл шынымен де «Лондондағы қар». Сіз бұл туралы шағымдана алмайсыз, солай ма?
Dialogue: 0,0:15:55.16,0:15:57.20,Default,,0,0,0,,〈Көп рахмет〉
Dialogue: 0,0:15:57.33,0:15:59.70,Default,,0,0,0,,<Бұдан былай мен оған күнде табынуым керек! 〉
Dialogue: 0,0:16:00.16,0:16:01.50,Default,,0,0,0,,Ах, Спидвагон мырза!
Dialogue: 0,0:16:02.16,0:16:04.04,Default,,0,0,0,,Басқа нәрсе сияқты.
Dialogue: 0,0:16:04.17,0:16:05.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:06.21,0:16:08.00,Default,,0,0,0,,Менің әсерім өзгерген жоқ
Dialogue: 0,0:16:08.13,0:16:08.96,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:16:09.09,0:16:09.92,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:10.26,0:16:13.13,Default,,0,0,0,,Ал...шынында, бұл сурет...
Dialogue: 0,0:16:14.01,0:16:16.22,Default,,0,0,0,,Бұл Томас салған жалған!
Dialogue: 0,0:16:16.55,0:16:17.89,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:16:18.01,0:16:19.72,Default,,0,0,0,,Сіз тағы бір нәрсе істедіңіз бе?
Dialogue: 0,0:16:19.97,0:16:21.14,Default,,0,0,0,,Хаа…
Dialogue: 0,0:16:21.27,0:16:23.31,Default,,0,0,0,,Сіз оны әдейі өзгерттіңіз бе?
Dialogue: 0,0:16:24.44,0:16:26.40,Default,,0,0,0,,Мари! Әке!
Dialogue: 0,0:16:26.52,0:16:28.48,Default,,0,0,0,,Бастапқыда бұл біздің кінәміз еді.
Dialogue: 0,0:16:28.77,0:16:30.15,Default,,0,0,0,,Ең алдымен бұл үшін кешірім сұраймын.
Dialogue: 0,0:16:31.07,0:16:32.28,Default,,0,0,0,,сурет
Dialogue: 0,0:16:32.40,0:16:36.32,Default,,0,0,0,,Жақсы жасалғаны сонша, бір қарағанда сіз оны шынайы нәрсе деп санай аласыз.
Dialogue: 0,0:16:36.45,0:16:37.91,Default,,0,0,0,,Бұл дерлік шындық!
Dialogue: 0,0:16:38.41,0:16:41.70,Default,,0,0,0,,Сонымен біз нағыз картиналарды саттық.
Dialogue: 0,0:16:41.83,0:16:43.54,Default,,0,0,0,,Бұл жай ғана өнер дилері.
Dialogue: 0,0:16:43.91,0:16:46.29,Default,,0,0,0,,Неге менімен ақылдаспай олай істедің?
Dialogue: 0,0:16:47.17,0:16:50.00,Default,,0,0,0,,Мен сенің жаныңнан бақылап жүрдім.
Dialogue: 0,0:16:50.50,0:16:52.97,Default,,0,0,0,,Томас, сен өте көп жұмыс істедің.
Dialogue: 0,0:16:54.34,0:16:58.30,Default,,0,0,0,,Мен жейтін жалғыз тағам - консервіленген бұршақ, олардың әрқайсысының құны 75 р.
Dialogue: 0,0:16:58.47,0:17:00.43,Default,,0,0,0,,Сосын мен 3 сағат ұйықтадым.
Dialogue: 0,0:17:00.60,0:17:04.14,Default,,0,0,0,,Мен мұны күндер мен күндер бойы жасадым ... аяқтағанша!
Dialogue: 0,0:17:05.31,0:17:07.65,Default,,0,0,0,,Ол сурет жай қолдан жасалған сурет емес.
Dialogue: 0,0:17:08.02,0:17:11.19,Default,,0,0,0,,Бұл Томастың бар жан-тәнімен салған туындысы.
Dialogue: 0,0:17:11.73,0:17:12.57,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:17:12.69,0:17:13.53,Default,,0,0,0,,Иә
Dialogue: 0,0:17:13.94,0:17:15.53,Default,,0,0,0,,Маған одан да қатты ұнайды
Dialogue: 0,0:17:15.65,0:17:16.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:17.66,0:17:19.49,Default,,0,0,0,,Мен Макото сияқтымын.
Dialogue: 0,0:17:19.83,0:17:21.95,Default,,0,0,0,,Маған бұл сурет әлдеқайда ұнайды
Dialogue: 0,0:17:22.58,0:17:25.37,Default,,0,0,0,,Жылы және мейірімді
Dialogue: 0,0:17:27.33,0:17:29.59,Default,,0,0,0,,〈Иә, осындай керемет сурет болса〉
Dialogue: 0,0:17:29.71,0:17:32.09,Default,,0,0,0,,<Клиенттер дәл осы үшін келетініне сенімдімін! 〉
Dialogue: 0,0:17:32.30,0:17:35.88,Default,,0,0,0,,<Аа, дұрыс, бұл жолы шын деп көрсетейік.>
Dialogue: 0,0:17:36.01,0:17:37.38,Default,,0,0,0,,〈А, солай істейік! 〉
Dialogue: 0,0:17:37.80,0:17:40.01,Default,,0,0,0,,Бұл таңқаларлық оқиға.
Dialogue: 0,0:17:40.18,0:17:42.89,Default,,0,0,0,,Иә! Барлығы есептелгендей
Dialogue: 0,0:17:47.52,0:17:48.60,Default,,0,0,0,,Синтия
Dialogue: 0,0:17:49.31,0:17:50.15,Default,,0,0,0,,Е...
Dialogue: 0,0:17:53.07,0:17:54.65,Default,,0,0,0,,Кериса, әкел.
Dialogue: 0,0:17:55.99,0:17:57.36,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:03.83,0:18:06.83,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:18:08.79,0:18:10.33,Default,,0,0,0,,Шашың байланған екен.
Dialogue: 0,0:18:31.40,0:18:33.07,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:18:35.73,0:18:37.19,Default,,0,0,0,,Бүгінгі күн үшін рахмет
Dialogue: 0,0:18:38.90,0:18:40.41,Default,,0,0,0,,Бұл тек кішігірім жауынгерлерге ғана тиімді. Тастайық.
Dialogue: 0,0:18:40.53,0:18:41.70,Default,,0,0,0,,Тағы кездескенше!
Dialogue: 0,0:18:42.57,0:18:44.41,Default,,0,0,0,,Менің көзіме қарап, айт
Dialogue: 0,0:18:44.66,0:18:45.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:47.29,0:18:48.91,Default,,0,0,0,,Сау бол, Синтия
Dialogue: 0,0:18:50.50,0:18:51.50,Default,,0,0,0,,Сіз де
Dialogue: 0,0:19:14.15,0:19:15.11,Default,,0,0,0,,(суға құлау дыбысы)
Dialogue: 0,0:19:27.04,0:19:30.04,Default,,0,0,0,,~♪
Dialogue: 0,0:19:30.37,0:19:34.00,Default,,0,0,0,,Жақсы! Аяқтарды жуып, сергек болатын кез келді.
Dialogue: 0,0:19:34.13,0:19:36.55,Default,,0,0,0,,Сіз суши аспазшысысыз ба?
Dialogue: 0,0:19:37.13,0:19:39.51,Default,,0,0,0,,Менеджер! Мен ұялып үйге кеттім...
Dialogue: 0,0:19:40.05,0:19:41.55,Default,,0,0,0,,<О, сен бе?>
Dialogue: 0,0:19:42.18,0:19:44.18,Default,,0,0,0,,<Бізге енді корейлер керек емес>
Dialogue: 0,0:19:44.30,0:19:46.05,Default,,0,0,0,,<Үш тай адамды жалдағандықтан>
Dialogue: 0,0:19:46.81,0:19:48.06,Default,,0,0,0,,жапон
Dialogue: 0,0:19:49.68,0:19:52.31,Default,,0,0,0,,(теңіз құстарының айқайы)
Dialogue: 0,0:19:53.27,0:19:54.98,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:19:55.11,0:19:57.23,Default,,0,0,0,,Сіз енді сурет салмайсыз ба?
Dialogue: 0,0:19:57.57,0:19:59.69,Default,,0,0,0,,Сізді жек көреді.
Dialogue: 0,0:20:00.07,0:20:02.07,Default,,0,0,0,,Мен бұл туралы біраз ойландым.
Dialogue: 0,0:20:02.24,0:20:05.03,Default,,0,0,0,,Демек, бұл сіздің басынан-ақ трюкіңіз болды ма?
Dialogue: 0,0:20:05.16,0:20:05.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:06.62,0:20:10.25,Default,,0,0,0,,Ниццада нағыз «Лондон қары» бар екенін білу
Dialogue: 0,0:20:10.37,0:20:14.08,Default,,0,0,0,,Эдамаме мен Коулман бірге келді.
Dialogue: 0,0:20:14.50,0:20:17.00,Default,,0,0,0,,Қызықты. Не үшін?
Dialogue: 0,0:20:17.34,0:20:21.30,Default,,0,0,0,,Жарақатымды қайта өткізу арқылы көңіл көтеру
Dialogue: 0,0:20:21.42,0:20:23.97,Default,,0,0,0,,Сіздің қиялыңыз күшті.
Dialogue: 0,0:20:24.72,0:20:28.72,Default,,0,0,0,,Сондықтан бәрі сені жек көреді.
Dialogue: 0,0:20:29.18,0:20:30.56,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:20:30.77,0:20:33.48,Default,,0,0,0,,Одан да жақсы өнер көрмесі өтіп жатыр.
Dialogue: 0,0:20:33.60,0:20:34.90,Default,,0,0,0,,Оны тоқтатыңыз.
Dialogue: 0,0:20:35.02,0:20:36.02,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:20:36.77,0:20:40.23,Default,,0,0,0,,Мен ол аққұба қаншықпен бірге болғым келмейді.
Dialogue: 0,0:20:42.44,0:20:46.07,Default,,0,0,0,,Хаа... еркектер сорлы жаратылыс.
Dialogue: 0,0:20:46.95,0:20:48.83,Default,,0,0,0,,Сәлем Дороти
Dialogue: 0,0:20:51.04,0:20:57.04,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.86,0:22:50.86,Default,,0,0,0,,~♪
Dialogue: 0,0:22:52.36,0:22:58.36,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory