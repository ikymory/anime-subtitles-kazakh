Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:02.83,0:00:06.17,Default,,0,0,0,,Ол мұны ешқашан жеке пайда үшін жасаған емес
Dialogue: 0,0:00:06.29,0:00:08.13,Default,,0,0,0,,Мен қылмыс жасаған жоқпын.
Dialogue: 0,0:00:08.88,0:00:11.51,Default,,0,0,0,,Жеңілдететін жағдайларға көп орын бар.
Dialogue: 0,0:00:11.88,0:00:14.55,Default,,0,0,0,,Маған жеңіл жаза беріңізші.
Dialogue: 0,0:00:16.34,0:00:18.47,Default,,0,0,0,,Рахмет, Озаки мырза
Dialogue: 0,0:00:19.31,0:00:22.85,Default,,0,0,0,,Жоқ, мен шартты түрде сотталғаныма қуаныштымын.
Dialogue: 0,0:00:22.98,0:00:24.48,Default,,0,0,0,,Егер сізде қандай да бір қиындық туындаса, кез келген уақытта бізге хабарласыңыз.
Dialogue: 0,0:00:24.60,0:00:26.15,Default,,0,0,0,,Папа (Сейджи және т.б.) Иә?
Dialogue: 0,0:00:26.27,0:00:27.86,Default,,0,0,0,,Қараңдар, мен мұны көрдім.
Dialogue: 0,0:00:28.44,0:00:30.07,Default,,0,0,0,,Менің ұлым
Dialogue: 0,0:00:32.82,0:00:36.28,Default,,0,0,0,,Масато үнемі бір нәрсені айта береді
Dialogue: 0,0:00:36.41,0:00:37.87,Default,,0,0,0,,Қараңдаршы, мен не дедім.
Dialogue: 0,0:00:37.99,0:00:38.83,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:00:38.95,0:00:42.70,Default,,0,0,0,,Жұмыс істейтін әке өте керемет! Айтайын дегенім?
Dialogue: 0,0:00:42.83,0:00:43.96,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:00:44.08,0:00:48.08,Default,,0,0,0,,Үнемі жұмыс істеме, анда-санда
Dialogue: 0,0:00:48.21,0:00:49.34,Default,,0,0,0,,Қайтып кел! (Сейджи) Уф!
Dialogue: 0,0:00:49.46,0:00:50.59,Default,,0,0,0,,Біз әдетте соншалықты алдын ала брондамаймыз, сондықтан асығыс емесбіз
Dialogue: 0,0:00:50.71,0:00:53.09,Default,,0,0,0,,Осыны айтқыңыз келеді ме?
Dialogue: 0,0:00:53.21,0:00:54.05,Default,,0,0,0,,Тек тітіркену
Dialogue: 0,0:00:54.17,0:00:55.55,Default,,0,0,0,,Әкеңе елікте!
Dialogue: 0,0:00:55.68,0:00:57.80,Default,,0,0,0,,«Әрқашан дұрыс бол»
Dialogue: 0,0:00:57.93,0:01:00.18,Default,,0,0,0,,«Әлемге пайдалы болу»
Dialogue: 0,0:01:00.31,0:01:03.10,Default,,0,0,0,,«Өзгелер сыйлайтын адам бол»
Dialogue: 0,0:01:03.81,0:01:06.44,Default,,0,0,0,,Сіз әкеңіз сияқты заңгер бола аламын деп ойлайсыз ба?
Dialogue: 0,0:01:06.60,0:01:08.02,Default,,0,0,0,,Мен оқуды ұнатпаймын
Dialogue: 0,0:01:08.31,0:01:12.40,Default,,0,0,0,,Оқудан да маңыздысы – адамгершілік.
Dialogue: 0,0:01:12.53,0:01:13.94,Default,,0,0,0,,Мен де мұны естуден шаршадым.
Dialogue: 0,0:01:14.57,0:01:16.70,Default,,0,0,0,,Уау, әдеттегідей.
Dialogue: 0,0:01:16.82,0:01:19.07,Default,,0,0,0,,
Dialogue: 0,0:01:20.24,0:01:21.87,Default,,0,0,0,,Оян, далаға шығайық.
Dialogue: 0,0:01:21.99,0:01:22.83,Default,,0,0,0,,Уф...
Dialogue: 0,0:01:22.95,0:01:23.79,Default,,0,0,0,,О
Dialogue: 0,0:01:27.33,0:01:28.50,Default,,0,0,0,,Хаа…
Dialogue: 0,0:01:28.63,0:01:31.59,Default,,0,0,0,,Түсініксіз түс, көрмедің бе?
Dialogue: 0,0:01:32.75,0:01:35.42,Default,,0,0,0,,Тұтқаға бір нәрсе қойғанда
Dialogue: 0,0:01:36.59,0:01:42.60,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:34.90,0:02:40.91,Default,,0,0,0,,~♪
Dialogue: 0,0:02:42.24,0:02:44.91,Default,,0,0,0,,Бастық, бүгін көлік қуу жоқ па?
Dialogue: 0,0:02:45.20,0:02:48.20,Default,,0,0,0,,Иә, Андерсон да онша еңбекқор емес.
Dialogue: 0,0:02:48.71,0:02:50.75,Default,,0,0,0,,Менің ойымша, жапондықтар мұны шағымданбай жасайды.
Dialogue: 0,0:02:51.67,0:02:54.04,Default,,0,0,0,,Сіз шағымдансаңыз да, бәрібір сізге мәжбүрлейді.
Dialogue: 0,0:02:54.17,0:02:55.00,Default,,0,0,0,,Әкеміз шашыңды көрсе, сені кешірмес еді.
Dialogue: 0,0:02:55.38,0:02:56.38,Default,,0,0,0,,Ха ха
Dialogue: 0,0:02:56.50,0:02:59.47,Default,,0,0,0,,Манганы орналастыруды растауды дереу сұраңыз
Dialogue: 0,0:02:59.59,0:03:05.22,Default,,0,0,0,,(құрылыс шуы)
Dialogue: 0,0:03:06.43,0:03:08.60,Default,,0,0,0,,Құралдарды осы жерге орналастыр.
Dialogue: 0,0:03:08.73,0:03:10.31,Default,,0,0,0,,Барлығы Германияда жасалған
Dialogue: 0,0:03:10.56,0:03:11.85,Default,,0,0,0,,Бұл айдау құрылғысы.
Dialogue: 0,0:03:11.98,0:03:12.81,Default,,0,0,0,,Түсінікті
Dialogue: 0,0:03:13.65,0:03:16.27,Default,,0,0,0,,Доктор. Қандай су тазартқышы жақсы?
Dialogue: 0,0:03:16.40,0:03:18.19,Default,,0,0,0,,О...
Dialogue: 0,0:03:18.32,0:03:19.44,Default,,0,0,0,,Мүмкін осында
Dialogue: 0,0:03:19.57,0:03:20.40,Default,,0,0,0,,Оны қаншалықты жылдам орындауға болады?
Dialogue: 0,0:03:21.78,0:03:23.53,Default,,0,0,0,,Екі апта ішінде
Dialogue: 0,0:03:23.66,0:03:25.37,Default,,0,0,0,,Бір аптада аяқтаңыз
Dialogue: 0,0:03:25.49,0:03:26.33,Default,,0,0,0,,Иә, Кассано мырза.
Dialogue: 0,0:03:27.62,0:03:30.29,Default,,0,0,0,,Оған дейін Лос-Анджелесті тамашалаңыз, доктор.
Dialogue: 0,0:03:30.41,0:03:31.25,Default,,0,0,0,,Иә
Dialogue: 0,0:03:32.00,0:03:34.29,Default,,0,0,0,,Салазар, өзіңді жақсы көр.
Dialogue: 0,0:03:34.42,0:03:35.25,Default,,0,0,0,,Иә
Dialogue: 0,0:03:36.79,0:03:38.50,Default,,0,0,0,,Маған көп қызмет көрсетіңіз
Dialogue: 0,0:03:42.09,0:03:43.64,Default,,0,0,0,,Сіз не істемексіз?
Dialogue: 0,0:03:44.34,0:03:45.97,Default,,0,0,0,,Сіз тамақ әзірлеуге шеберсіз бе?
Dialogue: 0,0:03:46.10,0:03:46.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:47.06,0:03:47.89,Default,,0,0,0,,Хехе
Dialogue: 0,0:03:49.18,0:03:50.02,Default,,0,0,0,,Әй?
Dialogue: 0,0:03:51.18,0:03:55.36,Default,,0,0,0,,(ұшқышсыз ұшу дыбысы)
Dialogue: 0,0:03:57.27,0:03:59.53,Default,,0,0,0,,Бұрынғы сидр зауыты
Dialogue: 0,0:04:00.24,0:04:04.03,Default,,0,0,0,,Расымен де, неге сонша жыл табиғатта қалды деп ойлаймын.
Dialogue: 0,0:04:05.03,0:04:06.57,Default,,0,0,0,,Андерсон Түсінесің бе?
Dialogue: 0,0:04:06.70,0:04:07.53,Default,,0,0,0,,Хмм...
Dialogue: 0,0:04:08.58,0:04:11.20,Default,,0,0,0,,Лоранмен мәміле болатын болса
Dialogue: 0,0:04:11.33,0:04:12.83,Default,,0,0,0,,Мүмкін осында.
Dialogue: 0,0:04:13.41,0:04:14.87,Default,,0,0,0,,Мүмкіндікті пайдаланыңыз
Dialogue: 0,0:04:15.00,0:04:18.34,Default,,0,0,0,,Олардың барлығынан құтылу үшін не істеу керек?
Dialogue: 0,0:04:19.80,0:04:22.84,Default,,0,0,0,,Ең оңай нәрсе - хабарлаушыны жіберу.
Dialogue: 0,0:04:23.51,0:04:24.76,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:04:24.88,0:04:27.39,Default,,0,0,0,,Мен сенің досыңмен жасырын түрде кіре аламын ба?
Dialogue: 0,0:04:27.51,0:04:28.60,Default,,0,0,0,,(Сатушы) Жарайды, онда мен сата алатын зат та осы ғана болар.
Dialogue: 0,0:04:29.68,0:04:32.10,Default,,0,0,0,,Бұл жағдайда нені қолдануға болады
Dialogue: 0,0:04:33.35,0:04:34.48,Default,,0,0,0,,Ол ма?
Dialogue: 0,0:04:37.65,0:04:40.19,Default,,0,0,0,,(Салазардың күрсінуі)
Dialogue: 0,0:04:40.61,0:04:42.69,Default,,0,0,0,,(Эдамамның ұйқысы)
Dialogue: 0,0:04:46.91,0:04:49.70,Default,,0,0,0,,Жақсы... жақсы... ммм...
Dialogue: 0,0:04:49.83,0:04:52.54,Default,,0,0,0,,Ух... у... хмм...
Dialogue: 0,0:04:52.66,0:04:54.33,Default,,0,0,0,,Гааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа аааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:04:54.46,0:04:55.75,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:04:55.87,0:04:56.71,Default,,0,0,0,,Тыныш!
Dialogue: 0,0:04:56.83,0:04:57.92,Default,,0,0,0,,Ха... а?
Dialogue: 0,0:04:59.42,0:05:00.50,Default,,0,0,0,,Лоран?
Dialogue: 0,0:05:00.75,0:05:01.75,Default,,0,0,0,,О! Кетару?
Dialogue: 0,0:05:02.59,0:05:04.63,Default,,0,0,0,,Эд есірткі жасаудың шебері.
Dialogue: 0,0:05:04.76,0:05:07.51,Default,,0,0,0,,Махаббат пен Бейбітшілік!
Dialogue: 0,0:05:07.64,0:05:09.51,Default,,0,0,0,,Жарайды, оны бірден жасап алайық.
Dialogue: 0,0:05:12.52,0:05:14.02,Default,,0,0,0,,Хаа... Бұл не?
Dialogue: 0,0:05:14.31,0:05:15.77,Default,,0,0,0,,Ол қазірдің өзінде шешілді.
Dialogue: 0,0:05:16.14,0:05:17.48,Default,,0,0,0,,Сакура сиқырын қалай жасауға болады
Dialogue: 0,0:05:18.27,0:05:20.69,Default,,0,0,0,,Мұндай нәрсе бұл дүниеде жоқ.
Dialogue: 0,0:05:20.82,0:05:23.19,Default,,0,0,0,,Сондықтан да солай шығар.
Dialogue: 0,0:05:23.36,0:05:24.19,Default,,0,0,0,,Сіз
Dialogue: 0,0:05:24.32,0:05:26.78,Default,,0,0,0,,Жоқ... Мен үлгере алмаймын!
Dialogue: 0,0:05:26.90,0:05:28.61,Default,,0,0,0,,Есіңізде болсын, мүмкін емес деп айтпаңыз!
Dialogue: 0,0:05:28.74,0:05:30.83,Default,,0,0,0,,Негізінен бұл нағыз есірткі, оны жасап, сатасың.
Dialogue: 0,0:05:30.95,0:05:32.74,Default,,0,0,0,,Бұл енді алдау немесе басқа нәрсе емес.
Dialogue: 0,0:05:32.87,0:05:35.71,Default,,0,0,0,,Tsk, бұл нақты емес.
Dialogue: 0,0:05:35.83,0:05:37.42,Default,,0,0,0,,Бұл жалған Sakura Magic
Dialogue: 0,0:05:37.92,0:05:40.04,Default,,0,0,0,,Бірақ дәрі – бұл есірткі
Dialogue: 0,0:05:40.21,0:05:41.04,Default,,0,0,0,,That's right.
Dialogue: 0,0:05:41.17,0:05:43.88,Default,,0,0,0,,Сонда сіз жай ғана дилерсіз!
Dialogue: 0,0:05:44.09,0:05:44.92,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:45.34,0:05:46.59,Default,,0,0,0,,Қандай сенімді адам!
Dialogue: 0,0:05:46.80,0:05:48.13,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:49.76,0:05:54.10,Default,,0,0,0,,(Салазардың қорылдауы)
Dialogue: 0,0:05:55.48,0:05:56.93,Default,,0,0,0,,Бастапқыда
Dialogue: 0,0:05:57.77,0:06:00.44,Default,,0,0,0,,Рецепт сатуды ұсынғаныңыз үшін сіз кінәлісіз.
Dialogue: 0,0:06:00.77,0:06:01.94,Default,,0,0,0,,Уф...
Dialogue: 0,0:06:02.57,0:06:05.49,Default,,0,0,0,,Қорқақ адамдардың оңай алшақтап кетуі қиын.
Dialogue: 0,0:06:06.74,0:06:09.53,Default,,0,0,0,,Күте тұрыңыз, мен мұны жалғыз істей алмаймын!
Dialogue: 0,0:06:09.91,0:06:12.12,Default,,0,0,0,,Есірткіге араласпау қағидасы.
Dialogue: 0,0:06:12.41,0:06:13.33,Default,,0,0,0,,Оламо!
Dialogue: 0,0:06:13.70,0:06:16.58,Default,,0,0,0,,Мұны бірге қайнатуға болады. (Лоран) Төмен қызу.
Dialogue: 0,0:06:19.83,0:06:21.33,Default,,0,0,0,,Бұл емес
Dialogue: 0,0:06:22.79,0:06:24.55,Default,,0,0,0,,Стадионға баратын уақыт келді
Dialogue: 0,0:06:24.67,0:06:25.55,Default,,0,0,0,,«Мен… мен адаммын.»
Dialogue: 0,0:06:25.96,0:06:27.84,Default,,0,0,0,,Мен тамақты сонда ішемін.
Dialogue: 0,0:06:27.97,0:06:30.89,Default,,0,0,0,,Әй, «Күйікті» сериалының басты кейіпкері кім?
Dialogue: 0,0:06:31.64,0:06:33.14,Default,,0,0,0,,Бар болуы керек.
Dialogue: 0,0:06:33.35,0:06:34.72,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:06:36.02,0:06:37.98,Default,,0,0,0,,Бұл фильм қызықты болды.
Dialogue: 0,0:06:38.31,0:06:41.98,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:06:42.65,0:06:44.77,Default,,0,0,0,,Мен Сигердің қатты соққы беретініне сенімдімін.
Dialogue: 0,0:06:44.90,0:06:46.32,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:06:46.53,0:06:48.40,Default,,0,0,0,,Хот-догтарды жек көресіз бе?
Dialogue: 0,0:06:48.53,0:06:49.40,Default,,0,0,0,,Сондықтан олар жауапкершілікті маған жүктеді.
Dialogue: 0,0:06:50.49,0:06:52.53,Default,,0,0,0,,Мұндағы тағамдар өте жақсы.
Dialogue: 0,0:06:52.82,0:06:53.91,Default,,0,0,0,,Әйтеуір, жегені қанағаттанарлық.
Dialogue: 0,0:06:56.04,0:06:59.46,Default,,0,0,0,,Сізден жеке бірдеңе сұрасам бола ма?
Dialogue: 0,0:06:59.58,0:07:00.41,Default,,0,0,0,,О
Dialogue: 0,0:07:01.25,0:07:03.58,Default,,0,0,0,,Сіздің әйеліңіз бен балаларыңыз қайда тұрады?
Dialogue: 0,0:07:05.92,0:07:07.38,Default,,0,0,0,,Менің әйелім жазатайым жағдайда қайтыс болды
Dialogue: 0,0:07:08.88,0:07:09.76,Default,,0,0,0,,Балалар ше?
Dialogue: 0,0:07:10.17,0:07:12.64,Default,,0,0,0,,Мен сізді бір мекемеде қалдырамын. Мені көрмейсің бе?
Dialogue: 0,0:07:13.76,0:07:17.14,Default,,0,0,0,,Біз аптасына бір рет, жексенбі күні ғана кездесеміз.
Dialogue: 0,0:07:17.39,0:07:19.23,Default,,0,0,0,,Бүгін емес пе?
Dialogue: 0,0:07:21.44,0:07:22.27,Default,,0,0,0,,Менің жұмысым бар
Dialogue: 0,0:07:22.40,0:07:26.36,Default,,0,0,0,,(Музыка және шаттық)
Dialogue: 0,0:07:26.48,0:07:28.65,Default,,0,0,0,,Барғыңыз келетін жер болса, айтыңыз.
Dialogue: 0,0:07:28.78,0:07:30.15,Default,,0,0,0,,Мен айттым
Dialogue: 0,0:07:34.66,0:07:35.66,Default,,0,0,0,,Том
Dialogue: 0,0:07:36.87,0:07:39.00,Default,,0,0,0,,Көңілді болыңыз
Dialogue: 0,0:07:39.50,0:07:40.75,Default,,0,0,0,,(Көлік тежегішінің дыбысы)
Dialogue: 0,0:07:40.87,0:07:43.25,Default,,0,0,0,,Мен саған ешқашан осы туралы сұрастырамын деп айтқан жоқпын
Dialogue: 0,0:07:43.37,0:07:45.46,Default,,0,0,0,,Уау, әке!
Dialogue: 0,0:07:46.21,0:07:48.75,Default,,0,0,0,,Бұл бітсе, бірдеңе жейміз бе? Егер қаласаң, көңіліңді көтерейін.
Dialogue: 0,0:07:48.88,0:07:50.88,Default,,0,0,0,,Ха... ха ха ха
Dialogue: 0,0:07:51.26,0:07:53.80,Default,,0,0,0,,Хехе, кеш келе жатырсың.
Dialogue: 0,0:07:54.22,0:07:56.39,Default,,0,0,0,,А, менде кенет жұмыс табылды.
Dialogue: 0,0:07:56.51,0:07:57.35,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:58.18,0:07:59.89,Default,,0,0,0,,Кім? Сәлем
Dialogue: 0,0:08:00.68,0:08:02.39,Default,,0,0,0,,Бұл доктор Эдамура.
Dialogue: 0,0:08:02.52,0:08:03.35,Default,,0,0,0,,қытай?
Dialogue: 0,0:08:04.15,0:08:04.98,Default,,0,0,0,,жапон
Dialogue: 0,0:08:05.10,0:08:08.32,Default,,0,0,0,,Уау! Мүмкін ниндзя шығар?
Dialogue: 0,0:08:08.44,0:08:10.65,Default,,0,0,0,,Уф, суық қой!
Dialogue: 0,0:08:11.19,0:08:13.95,Default,,0,0,0,,Тек мынау: Мен бетперделеуге шебермін.
Dialogue: 0,0:08:14.07,0:08:16.37,Default,,0,0,0,,Ех~ Көрсет, көрсет!
Dialogue: 0,0:08:16.78,0:08:18.41,Default,,0,0,0,,Енді кейін сөйлесейік.
Dialogue: 0,0:08:18.53,0:08:20.24,Default,,0,0,0,,Хехе... Түсіндім, түсіндім!
Dialogue: 0,0:08:20.91,0:08:22.75,Default,,0,0,0,,Уау! Хахаха...
Dialogue: 0,0:08:22.96,0:08:25.63,Default,,0,0,0,,Кяхаха...
Dialogue: 0,0:08:25.75,0:08:28.13,Default,,0,0,0,,Неге маған шабуыл жасап тұрсың?
Dialogue: 0,0:08:31.30,0:08:34.80,Default,,0,0,0,,Сіз пайдасыз ниндзясыз. Әрі қарай не айдайсың?
Dialogue: 0,0:08:35.55,0:08:37.60,Default,,0,0,0,,Енді не істеуіміз керек?
Dialogue: 0,0:08:37.72,0:08:39.85,Default,,0,0,0,,Ниндзя демалып жатқанда
Dialogue: 0,0:08:39.97,0:08:40.81,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:41.14,0:08:43.48,Default,,0,0,0,,Әке, бар! Сол жаққа барыңыз!
Dialogue: 0,0:08:43.77,0:08:45.73,Default,,0,0,0,,Ата-ана қатал болуы керек.
Dialogue: 0,0:08:47.10,0:08:49.40,Default,,0,0,0,,(Бұрылу тетігінің дыбысы)
Dialogue: 0,0:08:50.61,0:08:54.15,Default,,0,0,0,,Капсула ойыншық? Бұл менің сүйіктім.
Dialogue: 0,0:08:54.28,0:08:57.16,Default,,0,0,0,,А, бұл банды. Мен сыртта болуым керек пе?
Dialogue: 0,0:08:58.12,0:08:58.95,Default,,0,0,0,,Иә
Dialogue: 0,0:08:59.08,0:09:02.75,Default,,0,0,0,,Әкемдей күзетшім болса ғой.
Dialogue: 0,0:09:03.62,0:09:05.71,Default,,0,0,0,,Бірақ ол дәл осы бандитке ұқсайды.
Dialogue: 0,0:09:05.83,0:09:07.17,Default,,0,0,0,,Мүлде жоқ!
Dialogue: 0,0:09:07.29,0:09:09.42,Default,,0,0,0,,Оққағардың міндеті - VIP-ті қорғау.
Dialogue: 0,0:09:09.92,0:09:13.26,Default,,0,0,0,,Полицейден немесе ФБРден әлдеқайда салқын!
Dialogue: 0,0:09:16.59,0:09:17.84,Default,,0,0,0,,О, самурай!
Dialogue: 0,0:09:17.97,0:09:20.14,Default,,0,0,0,,Керемет!
Dialogue: 0,0:09:20.51,0:09:21.68,Default,,0,0,0,,Бандамен алмасу
Dialogue: 0,0:09:22.18,0:09:23.06,Default,,0,0,0,,Иә!
Dialogue: 0,0:09:23.18,0:09:25.48,Default,,0,0,0,,Папа қараңызшы, бұл Мифунэ!
Dialogue: 0,0:09:25.60,0:09:27.35,Default,,0,0,0,,Хехе... Мен сені жақсы білемін.
Dialogue: 0,0:09:27.48,0:09:29.73,Default,,0,0,0,,«Бір қылыш бес адамды өлтіре алмайды!»
Dialogue: 0,0:09:29.86,0:09:31.07,Default,,0,0,0,,Эй!
Dialogue: 0,0:09:31.23,0:09:33.69,Default,,0,0,0,,Жуынатын бөлмеге бару үшін оққағар қажет емес.
Dialogue: 0,0:09:34.24,0:09:36.11,Default,,0,0,0,,Біз бірге барамыз ба?
Dialogue: 0,0:09:36.24,0:09:37.74,Default,,0,0,0,,Дәл сол жерде
Dialogue: 0,0:09:54.38,0:09:55.34,Default,,0,0,0,,Уф!
Dialogue: 0,0:09:55.46,0:09:56.84,Default,,0,0,0,,Мм... Мм!
Dialogue: 0,0:09:56.97,0:09:58.09,Default,,0,0,0,,Ашуланбаңыз
Dialogue: 0,0:10:02.81,0:10:04.18,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:10:04.31,0:10:06.60,Default,,0,0,0,,Сүйкімді бас бармақ ханшайымы бетін көрсетіп тұр.
Dialogue: 0,0:10:06.73,0:10:07.56,Default,,0,0,0,,(сыдырманың жабылу дыбысы)
Dialogue: 0,0:10:07.69,0:10:10.02,Default,,0,0,0,,Саған өзімді де көрсетейін бе?
Dialogue: 0,0:10:12.11,0:10:12.94,Default,,0,0,0,,Хмм?
Dialogue: 0,0:10:16.11,0:10:19.95,Default,,0,0,0,,(өкше дыбысы)
Dialogue: 0,0:10:23.08,0:10:24.08,Default,,0,0,0,,Масато Эдамура
Dialogue: 0,0:10:24.45,0:10:27.83,Default,,0,0,0,,Мен ФБР агенті Дикинспін.
Dialogue: 0,0:10:27.96,0:10:31.13,Default,,0,0,0,,Кассаномен қарым-қатынасыңыз туралы бірнеше сұрақ қоя аламын ба?
Dialogue: 0,0:10:31.71,0:10:33.79,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:10:34.05,0:10:37.42,Default,,0,0,0,,Кассано мен Лос-Анджелес полиция департаменті арасындағы бал айы аяқталды.
Dialogue: 0,0:10:37.55,0:10:39.88,Default,,0,0,0,,Мен ол жерден көп нәрсені естідім.
Dialogue: 0,0:10:40.18,0:10:42.85,Default,,0,0,0,,Сіз Кассаноға есірткі дайындайсыз ба?
Dialogue: 0,0:10:43.47,0:10:45.60,Default,,0,0,0,,Мен әлі ештеңе жасаған жоқпын.
Dialogue: 0,0:10:45.93,0:10:49.06,Default,,0,0,0,,Жоқ, әрине, менде оны жасау ниетім жоқ.
Dialogue: 0,0:10:49.19,0:10:50.69,Default,,0,0,0,,Жоқ, мен оны сізге дайындаймын.
Dialogue: 0,0:10:50.81,0:10:51.65,Default,,0,0,0,,Әй?
Dialogue: 0,0:10:52.19,0:10:53.98,Default,,0,0,0,,Мен бәрін білемін
Dialogue: 0,0:10:54.15,0:10:58.19,Default,,0,0,0,,Сізді жай ғана Лоранға ыңғайлы болу үшін пайдаланып жатырсыз.
Dialogue: 0,0:10:58.53,0:10:59.90,Default,,0,0,0,,Біздің мақсатымыз
Dialogue: 0,0:11:00.03,0:11:02.95,Default,,0,0,0,,Лоран мен Кассаноны бірге қамауға алу
Dialogue: 0,0:11:03.37,0:11:04.20,Default,,0,0,0,,екеуміз де шараптан бір-бір жұтым татып қойдық…
Dialogue: 0,0:11:04.33,0:11:06.87,Default,,0,0,0,,Транзакция сайтын жылдам басқарады
Dialogue: 0,0:11:07.33,0:11:10.79,Default,,0,0,0,,Сондықтан мен «әм» дегенді дұрыс айтуларыңызды қалаймын.
Dialogue: 0,0:11:11.58,0:11:14.46,Default,,0,0,0,,Менің айтайын дегенім, жасырын тыңшы?
Dialogue: 0,0:11:14.79,0:11:16.30,Default,,0,0,0,,Егер сіз ынтымақтастықта болсаңыз
Dialogue: 0,0:11:16.42,0:11:18.76,Default,,0,0,0,,Мен Жапонияға кінәні мойындау туралы мәмілемен орала аламын.
Dialogue: 0,0:11:19.09,0:11:20.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:11:21.80,0:11:22.72,Default,,0,0,0,,Мен бас тартсам ше?
Dialogue: 0,0:11:22.84,0:11:25.22,Default,,0,0,0,,Ол қаншық және бейбақ.
Dialogue: 0,0:11:25.68,0:11:30.14,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:11:30.27,0:11:31.10,Default,,0,0,0,,Ол шықпай ма?
Dialogue: 0,0:11:31.48,0:11:35.11,Default,,0,0,0,,Лоранның мейірімділігі тек үстірт.
Dialogue: 0,0:11:36.77,0:11:38.03,Default,,0,0,0,,Tsk
Dialogue: 0,0:11:39.36,0:11:41.49,Default,,0,0,0,,Шағын байланыс гаджеті.
Dialogue: 0,0:11:41.65,0:11:43.36,Default,,0,0,0,,Мен брендтерді сәйкестендірдім.
Dialogue: 0,0:11:43.53,0:11:45.41,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:11:45.57,0:11:47.49,Default,,0,0,0,,Егер сіз ынтымақтастық туралы шешім қабылдасаңыз
Dialogue: 0,0:11:47.62,0:11:48.95,Default,,0,0,0,,Оны қолданыңыз
Dialogue: 0,0:11:53.42,0:11:54.25,Default,,0,0,0,,Әкем ше?
Dialogue: 0,0:11:55.00,0:11:57.09,Default,,0,0,0,,Мен оны іздеп бардым.
Dialogue: 0,0:11:57.29,0:11:58.21,Default,,0,0,0,,Біз кездеспедік пе?
Dialogue: 0,0:11:58.34,0:11:59.17,Default,,0,0,0,,О
Dialogue: 0,0:12:01.51,0:12:03.43,Default,,0,0,0,,Бүгін көңілді болдыңыз ба?
Dialogue: 0,0:12:04.14,0:12:04.97,Default,,0,0,0,,Иә
Dialogue: 0,0:12:05.09,0:12:06.22,Default,,0,0,0,,жақсы болар еді.
Dialogue: 0,0:12:08.68,0:12:11.93,Default,,0,0,0,,Күн сайын осыншама көңілді болғанымды қалаймын
Dialogue: 0,0:12:12.94,0:12:14.44,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:12:14.56,0:12:15.48,Default,,0,0,0,,Сіз қайда болдыңыз?
Dialogue: 0,0:12:15.81,0:12:17.40,Default,,0,0,0,,Дәретхана
Dialogue: 0,0:12:18.73,0:12:20.48,Default,,0,0,0,,Телефонға ешқашан жауап бермеңіз
Dialogue: 0,0:12:21.36,0:12:23.90,Default,,0,0,0,,Аа, мен қазірден бастап сақ боламын.
Dialogue: 0,0:12:33.91,0:12:36.29,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:12:38.34,0:12:39.17,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:40.00,0:12:41.34,Default,,0,0,0,,Балалар сендерге ұнады деп ойлаймын.
Dialogue: 0,0:12:41.46,0:12:42.30,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:12:44.88,0:12:45.72,Default,,0,0,0,,Үйге қайт
Dialogue: 0,0:12:45.84,0:12:47.64,Default,,0,0,0,,Ваттотто Хаа~!
Dialogue: 0,0:12:48.14,0:12:49.81,Default,,0,0,0,,О! Кетару?
Dialogue: 0,0:12:50.06,0:12:50.89,Default,,0,0,0,,Матака?
Dialogue: 0,0:12:51.72,0:12:54.60,Default,,0,0,0,,Зауыт жақында бітетін сияқты.
Dialogue: 0,0:12:54.73,0:12:56.69,Default,,0,0,0,,Оқуыңызда алға жылжып жатырсыз ба?
Dialogue: 0,0:12:56.90,0:12:58.15,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:12:58.65,0:13:00.73,Default,,0,0,0,,Мен солай жасасам ғой.
Dialogue: 0,0:13:00.94,0:13:03.65,Default,,0,0,0,,Ақшаны алған бойда... Әй!
Dialogue: 0,0:13:03.82,0:13:04.65,Default,,0,0,0,,Тонзураса
Dialogue: 0,0:13:05.32,0:13:07.49,Default,,0,0,0,,Сіз аздап азап шегесіз.
Dialogue: 0,0:13:07.70,0:13:08.99,Default,,0,0,0,,Мүлдем емес.
Dialogue: 0,0:13:09.12,0:13:10.20,Default,,0,0,0,,Айтыңызшы
Dialogue: 0,0:13:10.95,0:13:14.00,Default,,0,0,0,,Иә, ФБР әрекет ете бастаған сияқты.
Dialogue: 0,0:13:14.12,0:13:15.66,Default,,0,0,0,,Ах... (Эбби) Мен мұны естімедім.
Dialogue: 0,0:13:16.12,0:13:17.75,Default,,0,0,0,,Мен қазір айтып тұрмын
Dialogue: 0,0:13:17.96,0:13:19.21,Default,,0,0,0,,Бір танысымның айтуы бойынша
Dialogue: 0,0:13:19.34,0:13:21.63,Default,,0,0,0,,Паула Дикинс жауапты болады.
Dialogue: 0,0:13:22.25,0:13:23.76,Default,,0,0,0,,Паула Дикинс
Dialogue: 0,0:13:24.59,0:13:27.05,Default,,0,0,0,,ФБР ескі қаскөйі
Dialogue: 0,0:13:27.22,0:13:29.09,Default,,0,0,0,,Мен сені онымен қуғым келмейді.
Dialogue: 0,0:13:29.76,0:13:31.68,Default,,0,0,0,,Әйтеуір жақсы болады.
Dialogue: 0,0:13:31.81,0:13:33.02,Default,,0,0,0,,Буэнос-Нош
Dialogue: 0,0:13:33.77,0:13:34.81,Default,,0,0,0,,Хаа…
Dialogue: 0,0:13:35.06,0:13:36.14,Default,,0,0,0,,Хаа…
Dialogue: 0,0:13:36.27,0:13:39.23,Default,,0,0,0,,Әй, мен сол ақымақ жігітпен аралассам ше?
Dialogue: 0,0:13:39.36,0:13:40.19,Default,,0,0,0,,Сен де жақында келесің
Dialogue: 0,0:13:40.31,0:13:42.11,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:13:42.40,0:13:45.40,Default,,0,0,0,,Егер заттар қауіпті болса, өзіңізді қорғаңыз
Dialogue: 0,0:13:46.36,0:13:48.36,Default,,0,0,0,,Сен де солай істеу керек, қара белбеу.
Dialogue: 0,0:13:51.33,0:13:53.29,Default,,0,0,0,,Айтпасаң да істеймін.
Dialogue: 0,0:13:56.83,0:13:57.96,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:13:58.08,0:13:59.67,Default,,0,0,0,,Қазір бару керек.
Dialogue: 0,0:14:00.04,0:14:01.54,Default,,0,0,0,,Көзілдірік Көзілдірік
Dialogue: 0,0:14:07.05,0:14:08.80,Default,,0,0,0,,Хмм... а?
Dialogue: 0,0:14:13.06,0:14:14.52,Default,,0,0,0,,"Оған қанша төлейсің?"
Dialogue: 0,0:14:15.43,0:14:16.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:17.10,0:14:18.64,Default,,0,0,0,,Қылышты қолына алғаннан кейін екі айдың ішінде-ақ қоғам тірегіне айналғандар да бар.
Dialogue: 0,0:14:19.35,0:14:20.73,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:14:21.11,0:14:23.15,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:14:25.40,0:14:26.74,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:14:33.28,0:14:34.70,Default,,0,0,0,,
Dialogue: 0,0:14:42.88,0:14:44.00,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:14:48.84,0:14:49.68,Default,,0,0,0,,Лоран
Dialogue: 0,0:14:49.80,0:14:51.68,Default,,0,0,0,,Шынында да, осы дүкенде…
Dialogue: 0,0:14:52.43,0:14:54.97,Default,,0,0,0,,Ол жерде біз сөйлесетін бір нәрсе бар.
Dialogue: 0,0:14:55.14,0:14:56.39,Default,,0,0,0,,О, доктор
Dialogue: 0,0:14:56.81,0:14:59.85,Default,,0,0,0,,Жөндеу ертең аяқталады.
Dialogue: 0,0:15:00.44,0:15:03.52,Default,,0,0,0,,Осыны тойлау үшін біз бүгін сіздерге суши кешін ұйымдастырамыз.
Dialogue: 0,0:15:03.98,0:15:05.44,Default,,0,0,0,,Ертеңнен бастап Жанжан
Dialogue: 0,0:15:05.57,0:15:07.82,Default,,0,0,0,,Маған Сакура Сиқырын жасатамын.
Dialogue: 0,0:15:07.99,0:15:09.61,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:15:10.28,0:15:11.78,Default,,0,0,0,,Бәріңіз тыңдаңыздар!
Dialogue: 0,0:15:13.12,0:15:18.00,Default,,0,0,0,,Мұндағы барлық ханымдар мен мырзалар Кассано отбасының бір бөлігі.
Dialogue: 0,0:15:18.37,0:15:20.04,Default,,0,0,0,,Біздің байланысымыз
Dialogue: 0,0:15:20.16,0:15:24.25,Default,,0,0,0,,Несие берушілер мен актерлер одақтары арасындағы байланыстан да күшті және берік!
Dialogue: 0,0:15:24.38,0:15:26.71,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:15:26.84,0:15:31.13,Default,,0,0,0,,Енді біз жаңа отбасымен таныстырамыз.
Dialogue: 0,0:15:31.93,0:15:35.72,Default,,0,0,0,,Бұл Шығыстан келген жас кәмпит шебері доктор Эдамура.
Dialogue: 0,0:15:35.85,0:15:37.85,Default,,0,0,0,,Эхехе…
Dialogue: 0,0:15:37.97,0:15:42.90,Default,,0,0,0,,Жеке жазбам бойынша, мені бір күні шошқалар тұтқындады.
Dialogue: 0,0:15:43.02,0:15:45.77,Default,,0,0,0,,Бірақ соңында ешқандай айып тағылған жоқ.
Dialogue: 0,0:15:46.23,0:15:47.98,Default,,0,0,0,,Әрине!
Dialogue: 0,0:15:48.36,0:15:50.53,Default,,0,0,0,,Мені кім жеңе алады?
Dialogue: 0,0:15:50.90,0:15:52.74,Default,,0,0,0,,Бұл дүниеде мұндай адам жоқ!
Dialogue: 0,0:15:53.57,0:15:56.03,Default,,0,0,0,,Әрине жалғыз мен емеспін
Dialogue: 0,0:15:56.20,0:15:58.20,Default,,0,0,0,,Бұл отбасында ешкім жоқ
Dialogue: 0,0:15:58.33,0:16:00.45,Default,,0,0,0,,Мен саған бір саусақты тигізбеймін.
Dialogue: 0,0:16:00.58,0:16:03.12,Default,,0,0,0,,Барлық кінә менікі
Dialogue: 0,0:16:03.25,0:16:05.96,Default,,0,0,0,,Бірақ мен оны қорғау үшін бар күшімді саламын.
Dialogue: 0,0:16:06.42,0:16:09.67,Default,,0,0,0,,Менің артымнан мені сиқытқысы келетін біреу болса ше?
Dialogue: 0,0:16:10.26,0:16:13.05,Default,,0,0,0,,Сіз маған опасыздық жасайсыз ба?
Dialogue: 0,0:16:13.34,0:16:15.97,Default,,0,0,0,,Уау! Қандай жігіт
Dialogue: 0,0:16:16.35,0:16:18.89,Default,,0,0,0,,Осындай адам бар деп ойлайсыз ба?
Dialogue: 0,0:16:19.10,0:16:20.72,Default,,0,0,0,,Иә, Эбби?
Dialogue: 0,0:16:20.85,0:16:22.64,Default,,0,0,0,,Біреуі болуы мүмкін емес.
Dialogue: 0,0:16:23.10,0:16:24.48,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:16:25.15,0:16:26.19,Default,,0,0,0,,Лоран ше?
Dialogue: 0,0:16:26.61,0:16:30.40,Default,,0,0,0,,Сондай надан біреу болса, мен шығармын.
Dialogue: 0,0:16:30.53,0:16:34.15,Default,,0,0,0,,Хахаха... Әдеттегідей.
Dialogue: 0,0:16:34.95,0:16:35.78,Default,,0,0,0,,Dr.
Dialogue: 0,0:16:36.66,0:16:38.03,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:16:38.37,0:16:41.58,Default,,0,0,0,,Маған опасыздық жасайтын біреу бар деп ойлайсың ба?
Dialogue: 0,0:16:43.66,0:16:45.21,Default,,0,0,0,,Менің ол жерде болуым мүмкін емес.
Dialogue: 0,0:16:45.42,0:16:48.84,Default,,0,0,0,,Бұл шындыққа сәйкес келмейді.
Dialogue: 0,0:16:48.96,0:16:52.05,Default,,0,0,0,,Бірақ, өкінішке орай, бар
Dialogue: 0,0:16:52.34,0:16:53.63,Default,,0,0,0,,Сатқын
Dialogue: 0,0:16:55.05,0:16:57.72,Default,,0,0,0,,Оларға ілеспе — мына жаққа оралыңдар!
Dialogue: 0,0:17:00.68,0:17:04.10,Default,,0,0,0,,Сәлем доктор, біреу біледі ме?
Dialogue: 0,0:17:04.44,0:17:05.27,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:05.39,0:17:07.02,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:07.15,0:17:09.69,Default,,0,0,0,,Мен оны әрқашан бір рет көргім келді.
Dialogue: 0,0:17:10.40,0:17:11.98,Default,,0,0,0,,«Қол тигізбейді»
Dialogue: 0,0:17:12.65,0:17:14.53,Default,,0,0,0,,Де Ниро!
Dialogue: 0,0:17:14.65,0:17:15.49,Default,,0,0,0,,(Айқай)
Dialogue: 0,0:17:17.66,0:17:21.91,Default,,0,0,0,,О... ой...
Dialogue: 0,0:17:22.08,0:17:22.91,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:17:23.04,0:17:25.41,Default,,0,0,0,,Алғыссыз бейбақ
Dialogue: 0,0:17:26.12,0:17:28.17,Default,,0,0,0,,Иә? Не?
Dialogue: 0,0:17:28.33,0:17:31.46,Default,,0,0,0,,Сатқындардан сақ болғаныңыз жөн... Сонда?
Dialogue: 0,0:17:31.75,0:17:35.30,Default,,0,0,0,,Ха! Өкінішке орай, бұл сіздің соңғы болады.
Dialogue: 0,0:17:36.18,0:17:38.68,Default,,0,0,0,,Дәрігер, бұл жақсы тербеліс болды.
Dialogue: 0,0:17:39.64,0:17:41.64,Default,,0,0,0,,Жоқ, соққы?
Dialogue: 0,0:17:42.31,0:17:46.23,Default,,0,0,0,,Кәне, бәріміз суши жейміз! Қолдарыңызбен
Dialogue: 0,0:17:46.35,0:17:47.64,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:17:52.19,0:17:53.32,Default,,0,0,0,,Жоқ?
Dialogue: 0,0:17:53.78,0:17:55.74,Default,,0,0,0,,Біздің кім екенімізді біліңіз
Dialogue: 0,0:17:56.11,0:17:57.74,Default,,0,0,0,,Сіз мүмкіндікті жіберіп алдыңыз.
Dialogue: 0,0:17:58.91,0:18:03.04,Default,,0,0,0,,Менің міндетім – Кассаноны қауіптен қорғау.
Dialogue: 0,0:18:03.66,0:18:06.08,Default,,0,0,0,,Алаяқтықтан қорғау жұмыс емес
Dialogue: 0,0:18:06.75,0:18:08.21,Default,,0,0,0,,Жарайды, қалағаныңды істе.
Dialogue: 0,0:18:09.08,0:18:11.67,Default,,0,0,0,,Жоқ Сіз оған жұмыс істейсіз бе?
Dialogue: 0,0:18:12.09,0:18:14.30,Default,,0,0,0,,Сіз банданың бастығы болдыңыз, солай ма?
Dialogue: 0,0:18:14.80,0:18:19.26,Default,,0,0,0,,Банданың бастығы болу сіз ойлағаннан аз пайда әкеледі.
Dialogue: 0,0:18:19.80,0:18:24.56,Default,,0,0,0,,Шеңбер соғыстары және бағыныштыларға қарау Полицияға пара беру
Dialogue: 0,0:18:25.81,0:18:28.06,Default,,0,0,0,,Демалуға уақыт жоқ
Dialogue: 0,0:18:28.19,0:18:30.52,Default,,0,0,0,,Сіз бандит болдыңыз ба?
Dialogue: 0,0:18:31.23,0:18:34.23,Default,,0,0,0,,Аа, сұрақтар көп.
Dialogue: 0,0:18:34.98,0:18:35.82,Default,,0,0,0,,(әйнек түсіру дыбысы)
Dialogue: 0,0:18:36.65,0:18:39.66,Default,,0,0,0,,Өйткені мен осы елдің ең төменгі қабатында туып-өстім.
Dialogue: 0,0:18:39.91,0:18:43.87,Default,,0,0,0,,Толық өмір сүргіңіз келсе, бұл сіздің жалғыз таңдауыңыз.
Dialogue: 0,0:18:44.20,0:18:48.00,Default,,0,0,0,,Менің оқуға ақшам да, миым да болмады.
Dialogue: 0,0:18:49.21,0:18:53.67,Default,,0,0,0,,Сондықтан менің орныма Том жақсы университетке барсын.
Dialogue: 0,0:18:53.79,0:18:55.80,Default,,0,0,0,,Мен қалыпты өмір сүргім келеді.
Dialogue: 0,0:18:57.21,0:18:59.01,Default,,0,0,0,,Ең бастысы, бұл менің әйеліме берген уәде.
Dialogue: 0,0:19:00.59,0:19:02.26,Default,,0,0,0,,Оған дейін маған ақша керек.
Dialogue: 0,0:19:03.05,0:19:04.89,Default,,0,0,0,,Бұл жақсы сылтау
Dialogue: 0,0:19:06.10,0:19:08.77,Default,,0,0,0,,Әкеңнің сезімін түсінбейсің.
Dialogue: 0,0:19:09.77,0:19:12.48,Default,,0,0,0,,Бұл шынымен Том үшін бе?
Dialogue: 0,0:19:13.77,0:19:16.82,Default,,0,0,0,,Том, сен мәңгі бала болмайсың.
Dialogue: 0,0:19:18.15,0:19:19.90,Default,,0,0,0,,Бір күні сен бәрін білесің
Dialogue: 0,0:19:20.86,0:19:23.32,Default,,0,0,0,,Жоқ, мен оны сезіп тұрмын.
Dialogue: 0,0:19:23.49,0:19:26.54,Default,,0,0,0,,Мүмкін ол әкесінің алдында кінәсіз болып жүрген шығар.
Dialogue: 0,0:19:28.04,0:19:29.62,Default,,0,0,0,,Түстен кейін Фудзисаваға қайтасың да, мектепке барасың, иә?
Dialogue: 0,0:19:31.33,0:19:34.13,Default,,0,0,0,,Бұл өте маңызды, сіз түсінбейтін нәрсе - бұл
Dialogue: 0,0:19:34.67,0:19:35.71,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:19:36.50,0:19:37.34,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:19:38.09,0:19:39.34,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:19:39.84,0:19:42.84,Default,,0,0,0,,Эй, бұл қайтадан баклажан мисо сорпасы.
Dialogue: 0,0:19:44.05,0:19:46.10,Default,,0,0,0,,Бұл жолы кәмелетке толмағандарды саудалау...
Dialogue: 0,0:19:46.22,0:19:47.51,Default,,0,0,0,,Мм, мм
Dialogue: 0,0:19:47.64,0:19:49.52,Default,,0,0,0,,А, алдағы үш жақты сұхбат бар.
Dialogue: 0,0:19:49.64,0:19:52.98,Default,,0,0,0,,Сузаку қауымдастығының мүшесі Цюнео Тадзима
Dialogue: 0,0:19:53.44,0:19:55.90,Default,,0,0,0,,Мүше Джуня Ишии
Dialogue: 0,0:19:56.02,0:19:56.86,Default,,0,0,0,,және адвокат
Dialogue: 0,0:19:57.69,0:19:58.82,Default,,0,0,0,,Сейджи Озаки
Dialogue: 0,0:19:59.28,0:20:02.36,Default,,0,0,0,,Елде заңсыз жүрген үш кәмелетке толмағандарды алдап кеткен.
Dialogue: 0,0:20:02.74,0:20:06.12,Default,,0,0,0,,Шетелде адам саудасына күдікті
Dialogue: 0,0:20:06.33,0:20:10.00,Default,,0,0,0,,Негізгі күдікті Озаки өзінің адвокаттық қызметін пайдаланды
Dialogue: 0,0:20:10.12,0:20:12.83,Default,,0,0,0,,Андеррайтер қызметін атқарған дейді.
Dialogue: 0,0:20:12.96,0:20:14.63,Default,,0,0,0,,Ах... (құлап түскен дыбыс)
Dialogue: 0,0:20:15.13,0:20:22.13,Default,,0,0,0,,(сағаттың секунд тілінің дыбысы)
Dialogue: 0,0:20:28.81,0:20:29.64,Default,,0,0,0,,(сигнал үні)
Dialogue: 0,0:20:30.22,0:20:31.43,Default,,0,0,0,,Сигнал келді
Dialogue: 0,0:20:31.56,0:20:34.14,Default,,0,0,0,,Ах~ Ах~ Сіз мені естисіз бе?
Dialogue: 0,0:20:34.77,0:20:37.77,Default,,0,0,0,,Иә, шешім қабылдағаныңызға қуаныштымын.
Dialogue: 0,0:20:38.02,0:20:39.98,Default,,0,0,0,,Оларды бірге құртайық.
Dialogue: 0,0:20:42.07,0:20:44.11,Default,,0,0,0,,Оның алдында бір шарт бар.
Dialogue: 0,0:20:44.78,0:20:45.74,Default,,0,0,0,,Бірдеңе
Dialogue: 0,0:20:49.08,0:20:50.79,Default,,0,0,0,,Салазарды жіберіп алмаңыз
Dialogue: 0,0:20:51.37,0:20:57.38,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:41.10,0:22:47.11,Default,,0,0,0,,~♪
Dialogue: 0,0:22:48.61,0:22:54.61,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory