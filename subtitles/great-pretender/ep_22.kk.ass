Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:22.27,0:00:23.69,Default,,0,0,0,,(кранды жабу дыбысы)
Dialogue: 0,0:00:30.32,0:00:31.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:31.53,0:00:35.41,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:00:55.13,0:00:56.01,Default,,0,0,0,,(Бұрылу тетігінің дыбысы)
Dialogue: 0,0:01:13.44,0:01:15.32,Default,,0,0,0,,〈Келесіздер ме?〉
Dialogue: 0,0:01:16.40,0:01:22.41,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:14.84,0:02:20.84,Default,,0,0,0,,~♪
Dialogue: 0,0:02:26.35,0:02:28.10,Default,,0,0,0,,〈Жергілікті жерде не болып жатыр? 〉
Dialogue: 0,0:02:28.73,0:02:31.15,Default,,0,0,0,,<Созақудың штаб-пәтерінің айналасы қатайтылған>
Dialogue: 0,0:02:31.94,0:02:34.32,Default,,0,0,0,,〈Әрине олардың аяқ астындағы еден де жақсы жабылған〉
Dialogue: 0,0:02:34.98,0:02:38.53,Default,,0,0,0,,〈Сізге белгі беру жеткілікті, олар дереу ішке кіреді〉
Dialogue: 0,0:02:38.65,0:02:39.61,Default,,0,0,0,,<Бірден басу>
Dialogue: 0,0:02:39.74,0:02:40.61,Default,,0,0,0,,〈Жақсы〉
Dialogue: 0,0:02:40.74,0:02:42.28,Default,,0,0,0,,<Бұл сақинадағы сарысу қандай? 〉
Dialogue: 0,0:02:42.53,0:02:45.79,Default,,0,0,0,,<Аа, Лоранның бейбақы, оған қамқорлық жасаңыз.>
Dialogue: 0,0:02:46.29,0:02:48.62,Default,,0,0,0,,〈Ол жерге жеткенде〉
Dialogue: 0,0:02:48.75,0:02:50.08,Default,,0,0,0,,〈Сізге алкоголь ұсынса да, оған қол тигізбеңіз〉
Dialogue: 0,0:02:50.42,0:02:53.38,Default,,0,0,0,,<Саса қазір өмір суы>
Dialogue: 0,0:03:03.39,0:03:05.43,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:03:06.43,0:03:08.35,Default,,0,0,0,,Иә, иә, түсіндім.
Dialogue: 0,0:03:09.43,0:03:12.90,Default,,0,0,0,,Төраға 100 миллиард сіздің есептік жазбаңызда дайын.
Dialogue: 0,0:03:13.61,0:03:14.65,Default,,0,0,0,,Лю және басқалары ше?
Dialogue: 0,0:03:14.77,0:03:16.11,Default,,0,0,0,,Токиоға бару
Dialogue: 0,0:03:16.73,0:03:19.57,Default,,0,0,0,,Бірақ түн ортасында мәміле дегеніміз не?
Dialogue: 0,0:03:20.40,0:03:22.57,Default,,0,0,0,,(қол қою дыбысы)
Dialogue: 0,0:03:24.28,0:03:25.58,Default,,0,0,0,,Олар түнгі үкілер.
Dialogue: 0,0:03:28.08,0:03:31.54,Default,,0,0,0,,Мен бұршақты қайтадан ауыстырып көрдім, бірақ бұл менің дәміме сәйкес келетінін білмеймін.
Dialogue: 0,0:03:37.38,0:03:41.01,Default,,0,0,0,,Шынымды айтсам, мен ешқашан кофе ішкен емеспін.
Dialogue: 0,0:03:41.42,0:03:42.26,Default,,0,0,0,,Е...
Dialogue: 0,0:03:42.55,0:03:44.97,Default,,0,0,0,,Бірақ жасағандарың дәмді болады.
Dialogue: 0,0:03:45.55,0:03:47.10,Default,,0,0,0,,Мен сені ұната бастадым
Dialogue: 0,0:04:16.38,0:04:17.46,Default,,0,0,0,,Мен өзімді мазасыз сезінемін.
Dialogue: 0,0:04:23.34,0:04:25.05,Default,,0,0,0,,Нақтысын сақтамайсың ба?
Dialogue: 0,0:04:25.59,0:04:27.85,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:04:28.60,0:04:30.81,Default,,0,0,0,,Тірі заттар өледі.
Dialogue: 0,0:04:35.81,0:04:37.69,Default,,0,0,0,,Осы тапсырманы орындағаннан кейін
Dialogue: 0,0:04:37.81,0:04:39.44,Default,,0,0,0,,Менің рөлім аяқталды.
Dialogue: 0,0:04:39.69,0:04:40.53,Default,,0,0,0,,Е...
Dialogue: 0,0:04:42.15,0:04:43.53,Default,,0,0,0,,Мм, мм
Dialogue: 0,0:04:44.61,0:04:46.49,Default,,0,0,0,,Мен тыныш өмір сүргім келеді
Dialogue: 0,0:04:48.41,0:04:50.37,Default,,0,0,0,,Менің қасымда қаласың ба?
Dialogue: 0,0:04:53.54,0:04:55.75,Default,,0,0,0,,Ойнайық
Dialogue: 0,0:04:57.04,0:04:58.17,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:05:15.10,0:05:16.10,Default,,0,0,0,,Қан жарылысы!
Dialogue: 0,0:05:16.64,0:05:18.81,Default,,0,0,0,,Жол көп, сондықтан
Dialogue: 0,0:05:18.94,0:05:21.15,Default,,0,0,0,,Мен оны жарлық арқылы жіберемін
Dialogue: 0,0:05:41.50,0:05:42.67,Default,,0,0,0,,Міне осылай
Dialogue: 0,0:05:50.14,0:05:51.80,Default,,0,0,0,,Мен қобалжыдым.
Dialogue: 0,0:05:51.93,0:05:54.43,Default,,0,0,0,,Өзіңізді көрсететін бірдеңе болғаныңызға қуаныштымын.
Dialogue: 0,0:05:54.56,0:05:55.39,Default,,0,0,0,,Хехехе
Dialogue: 0,0:05:55.52,0:05:57.48,Default,,0,0,0,,Ол мұны дұрыс орындай ма?
Dialogue: 0,0:05:58.06,0:06:01.31,Default,,0,0,0,,Ха... Мен оның бірдеңе жасайтынына сенімдімін.
Dialogue: 0,0:06:02.15,0:06:03.07,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:06:03.82,0:06:05.07,Default,,0,0,0,,Мен мұны істегенді жөн көремін
Dialogue: 0,0:06:05.19,0:06:07.11,Default,,0,0,0,,Бұл Лоран емес пе?
Dialogue: 0,0:06:07.65,0:06:08.65,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:06:08.86,0:06:10.66,Default,,0,0,0,,Мен сізге кеше қоңырау шалдым.
Dialogue: 0,0:06:10.87,0:06:13.37,Default,,0,0,0,,Әдеттегі қызықсыз әзілдер болған жоқ.
Dialogue: 0,0:06:13.87,0:06:15.91,Default,,0,0,0,,Мен кек алуға қалай қарсы тұра аламын?
Dialogue: 0,0:06:16.04,0:06:17.04,Default,,0,0,0,,Мен мұны істей алмас едім.
Dialogue: 0,0:06:18.50,0:06:21.75,Default,,0,0,0,,Мен соңына дейін қажетсіз ештеңе істеудің қажеті жоқ.
Dialogue: 0,0:06:21.92,0:06:24.50,Default,,0,0,0,,Іс бұзылса, бәрі жақсы.
Dialogue: 0,0:06:25.09,0:06:27.05,Default,,0,0,0,,Бұл уақыт.
Dialogue: 0,0:06:27.26,0:06:30.05,Default,,0,0,0,,Иә, бұл да рас. (Эби) О.
Dialogue: 0,0:06:30.64,0:06:33.05,Default,,0,0,0,,Олай болса, бәріміз жоспарлағандай орындаңдар!
Dialogue: 0,0:06:33.18,0:06:34.14,Default,,0,0,0,,О!
Dialogue: 0,0:06:34.26,0:06:35.10,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:06:41.02,0:06:43.06,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:06:43.19,0:06:44.19,Default,,0,0,0,,Қауіпсіздік
Dialogue: 0,0:06:44.32,0:06:46.28,Default,,0,0,0,,Біз денені тексереміз.
Dialogue: 0,0:06:47.78,0:06:49.28,Default,,0,0,0,,<Денені тексеруге рұқсат етіңіз>
Dialogue: 0,0:06:49.74,0:06:50.95,Default,,0,0,0,,<Өзіңізге ұнайтындай жасаңыз>
Dialogue: 0,0:06:51.36,0:06:52.20,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:07:00.87,0:07:01.75,Default,,0,0,0,,Бұл — Они руының салты—
Dialogue: 0,0:07:09.30,0:07:11.30,Default,,0,0,0,,Эдамура мырза, сіз ше?
Dialogue: 0,0:07:12.26,0:07:13.47,Default,,0,0,0,,Қауіпті жүктер жоқ
Dialogue: 0,0:07:14.01,0:07:14.93,Default,,0,0,0,,Ішінде не бар?
Dialogue: 0,0:07:15.26,0:07:16.76,Default,,0,0,0,,Бұл бағалы қағаздардың бір түрі.
Dialogue: 0,0:07:16.97,0:07:19.23,Default,,0,0,0,,Бұл компанияны беріп жатқаныңызды білдіре ме?
Dialogue: 0,0:07:20.60,0:07:22.10,Default,,0,0,0,,Мен сен демалыс үйін сатып аламыз дедің деп анық естідім.
Dialogue: 0,0:07:23.69,0:07:24.94,Default,,0,0,0,,<Бояу иісі>
Dialogue: 0,0:07:25.11,0:07:27.15,Default,,0,0,0,,<Қабырғаларды неге қайта бояйсың? 〉
Dialogue: 0,0:07:27.44,0:07:29.57,Default,,0,0,0,,〈Түпнұсқа өте нашар күйде болуы мүмкін.〉
Dialogue: 0,0:07:32.70,0:07:34.41,Default,,0,0,0,,(электрондық құлыпты ашу дыбысы)
Dialogue: 0,0:07:34.91,0:07:37.20,Default,,0,0,0,,Ішке тек үш адам ғана кіреді.
Dialogue: 0,0:07:37.54,0:07:39.79,Default,,0,0,0,,〈Үшеуміз ғана ішке кіреміз〉
Dialogue: 0,0:07:41.41,0:07:42.54,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:42.67,0:07:44.00,Default,,0,0,0,,Мен сені алып келдім
Dialogue: 0,0:07:55.80,0:07:57.31,Default,,0,0,0,,(Электрондық құлыпты құлыптау дыбысы)
Dialogue: 0,0:08:02.44,0:08:04.19,Default,,0,0,0,,Сені көргеніме қуаныштымын, Лю
Dialogue: 0,0:08:04.90,0:08:06.48,Default,,0,0,0,,<Қош келдіңіз>
Dialogue: 0,0:08:11.94,0:08:14.11,Default,,0,0,0,,<Қолайсыздық үшін кешірім сұраймыз>
Dialogue: 0,0:08:31.21,0:08:32.09,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:33.05,0:08:34.51,Default,,0,0,0,,〈Кешіріңіз〉
Dialogue: 0,0:08:35.01,0:08:35.97,Default,,0,0,0,,Отырыңыз.
Dialogue: 0,0:08:36.43,0:08:37.85,Default,,0,0,0,,<Сіз тұра аласыз>
Dialogue: 0,0:08:38.85,0:08:40.47,Default,,0,0,0,,<Қазіргі уақытта сандық алмасулар өте көп>
Dialogue: 0,0:08:40.60,0:08:43.77,Default,,0,0,0,,<Жинау қиын болды>
Dialogue: 0,0:08:44.35,0:08:47.27,Default,,0,0,0,,<Бірақ сіз айтқандай>
Dialogue: 0,0:08:47.40,0:08:48.94,Default,,0,0,0,,<Біз 100 миллиард иен тұратын құнды қағаздар дайындадық>
Dialogue: 0,0:08:49.52,0:08:53.40,Default,,0,0,0,,Сіз біздің компанияны 100 миллиард иенге сатып алғыңыз келеді деп естідім.
Dialogue: 0,0:08:54.07,0:08:55.66,Default,,0,0,0,,Ә, қысқа үзіліс жасайық па?
Dialogue: 0,0:08:56.11,0:08:57.78,Default,,0,0,0,,<Чен, дайындал>
Dialogue: 0,0:08:57.91,0:08:58.74,Default,,0,0,0,,〈Иә〉
Dialogue: 0,0:08:58.87,0:08:59.74,Default,,0,0,0,,Ишигами
Dialogue: 0,0:08:59.87,0:09:00.70,Default,,0,0,0,,Га
Dialogue: 0,0:09:08.33,0:09:10.21,Default,,0,0,0,,Енді алыңыз.
Dialogue: 0,0:09:10.92,0:09:13.09,Default,,0,0,0,,<Растауыңызды өтінеміз>
Dialogue: 0,0:09:21.89,0:09:23.77,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:09:23.89,0:09:24.98,Default,,0,0,0,,Ол бір мектептің формасын киген екен.
Dialogue: 0,0:09:26.69,0:09:28.52,Default,,0,0,0,,Masato What do you mean?
Dialogue: 0,0:09:29.02,0:09:31.19,Default,,0,0,0,,<Laurent, what's going on? 〉
Dialogue: 0,0:09:33.03,0:09:34.03,Default,,0,0,0,,Масато
Dialogue: 0,0:09:35.44,0:09:36.78,Default,,0,0,0,,<Laurent! 〉
Dialogue: 0,0:09:38.32,0:09:39.24,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:39.37,0:09:40.45,Default,,0,0,0,,Бұл елордалық полиция департаменті!
Dialogue: 0,0:09:40.58,0:09:42.33,Default,,0,0,0,,Барлығы, қозғалмаңдар!
Dialogue: 0,0:09:43.20,0:09:44.58,Default,,0,0,0,,<Жақсы болдыңыз ба? 〉
Dialogue: 0,0:09:45.08,0:09:46.21,Default,,0,0,0,,<Let's wait and see>
Dialogue: 0,0:09:48.08,0:09:50.96,Default,,0,0,0,,Raid on suspicion of human trafficking
Dialogue: 0,0:09:51.67,0:09:54.84,Default,,0,0,0,,Барлығыңыз, қолдарыңызды көтеріп, бастарыңыздың артына қойыңыздар!
Dialogue: 0,0:09:54.96,0:09:55.80,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:09:55.92,0:09:57.63,Default,,0,0,0,,<Қолыңызды басыңыздың артына қойыңыз>
Dialogue: 0,0:09:58.22,0:09:59.51,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:09:59.72,0:10:02.81,Default,,0,0,0,,Кешіріңіз, бірақ мен де сергек емеспін...
Dialogue: 0,0:10:03.18,0:10:04.97,Default,,0,0,0,,This is a check.
Dialogue: 0,0:10:05.27,0:10:07.27,Default,,0,0,0,,Seized as evidence
Dialogue: 0,0:10:07.60,0:10:09.23,Default,,0,0,0,,Please seize that case as well.
Dialogue: 0,0:10:10.90,0:10:12.48,Default,,0,0,0,,〈Hey, wait a minute! 〉
Dialogue: 0,0:10:12.98,0:10:15.36,Default,,0,0,0,,What authority do you have to take it!
Dialogue: 0,0:10:15.48,0:10:16.78,Default,,0,0,0,,Evidence
Dialogue: 0,0:10:16.90,0:10:18.95,Default,,0,0,0,,Тергеуге қатысы болмаса, қайтару
Dialogue: 0,0:10:19.07,0:10:21.37,Default,,0,0,0,,Мұндай нәрседен құтыламын деп ойламаңыз!
Dialogue: 0,0:10:21.91,0:10:24.33,Default,,0,0,0,,Біздің кейбір тұтынушыларымыз полиция басшыларының қатарында!
Dialogue: 0,0:10:24.54,0:10:25.91,Default,,0,0,0,,Әсіресе басқа елдің күшіне сүйенген адамға.
Dialogue: 0,0:10:26.79,0:10:28.79,Default,,0,0,0,,The timing is too good
Dialogue: 0,0:10:34.00,0:10:34.88,Default,,0,0,0,,<Laurent>
Dialogue: 0,0:10:35.50,0:10:36.76,Default,,0,0,0,,<Hey! 〉
Dialogue: 0,0:10:36.88,0:10:37.72,Default,,0,0,0,,〈Gah...〉
Dialogue: 0,0:10:39.34,0:10:43.35,Default,,0,0,0,,Liu, your subordinate was a police dog?
Dialogue: 0,0:10:43.47,0:10:44.31,Default,,0,0,0,,Edamame
Dialogue: 0,0:10:45.18,0:10:46.43,Default,,0,0,0,,Түсіндіріңіз.
Dialogue: 0,0:10:52.65,0:10:54.07,Default,,0,0,0,,Edamura…
Dialogue: 0,0:10:54.69,0:10:56.53,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:11:01.20,0:11:03.45,Default,,0,0,0,,<Please be arrested quietly>
Dialogue: 0,0:11:03.57,0:11:06.54,Default,,0,0,0,,<Өзімізбен бірге әкелген бағалы қағаздардан бас тартайық>
Dialogue: 0,0:11:06.87,0:11:10.04,Default,,0,0,0,,〈А, бұл да қауіпті, сондықтан оны қолға алғаным жөн.〉
Dialogue: 0,0:11:11.42,0:11:14.09,Default,,0,0,0,,<Сен, есіңде болсын, мен сені міндетті түрде өлтіремін...>
Dialogue: 0,0:11:14.21,0:11:16.34,Default,,0,0,0,,<Take care of yourself! 〉
Dialogue: 0,0:11:17.88,0:11:18.84,Default,,0,0,0,,〈Temee! 〉
Dialogue: 0,0:11:19.26,0:11:20.42,Default,,0,0,0,,<Higii~! 〉
Dialogue: 0,0:11:20.55,0:11:22.93,Default,,0,0,0,,<What... Poison! Poison! 〉
Dialogue: 0,0:11:23.05,0:11:24.35,Default,,0,0,0,,<Taste slowly>
Dialogue: 0,0:11:24.47,0:11:25.68,Default,,0,0,0,,<I'm going to die! I don't want to die...! 〉
Dialogue: 0,0:11:25.68,0:11:27.56,Default,,0,0,0,,<I'm going to die! Менің өлгім келмейді...! 〉
Dialogue: 0,0:11:25.68,0:11:27.56,Default,,0,0,0,,Жасайық
Dialogue: 0,0:11:27.68,0:11:29.35,Default,,0,0,0,,Are you a little sane? Мынадай нәрсе...
Dialogue: 0,0:11:29.48,0:11:30.60,Default,,0,0,0,,Үніңді жауып, қарап тұр.
Dialogue: 0,0:11:31.60,0:11:32.77,Default,,0,0,0,,<Мен... Мен өлемін! 〉
Dialogue: 0,0:11:32.90,0:11:36.48,Default,,0,0,0,,<Чикишо~ Лоран! сен~! 〉
Dialogue: 0,0:11:36.48,0:11:37.32,Default,,0,0,0,,<Чикишо~ Лоран! сен~! 〉
Dialogue: 0,0:11:36.48,0:11:37.32,Default,,0,0,0,,Айтпақшы...
Dialogue: 0,0:11:37.82,0:11:38.82,Default,,0,0,0,,Не? 〉
Dialogue: 0,0:11:39.90,0:11:40.86,Default,,0,0,0,,〈Фуга! 〉
Dialogue: 0,0:11:42.78,0:11:43.61,Default,,0,0,0,,Раббым!
Dialogue: 0,0:11:43.74,0:11:45.49,Default,,0,0,0,,Менімен ұйықтағың келе ме?
Dialogue: 0,0:11:48.99,0:11:50.20,Default,,0,0,0,,<Tsk…>
Dialogue: 0,0:11:50.33,0:11:52.79,Default,,0,0,0,,Шанхай Лонхубанмен жұмыс
Dialogue: 0,0:11:52.92,0:11:55.08,Default,,0,0,0,,Елордалық полиция департаменті...
Dialogue: 0,0:11:56.21,0:11:58.17,Default,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:11:58.59,0:11:59.42,Default,,0,0,0,,Сәлем…
Dialogue: 0,0:11:59.55,0:12:01.01,Default,,0,0,0,,Созаку Әкем!
Dialogue: 0,0:12:01.13,0:12:02.34,Default,,0,0,0,,Оны арқанға сал!
Dialogue: 0,0:12:02.51,0:12:03.43,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:12:05.59,0:12:06.43,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:06.55,0:12:08.47,Default,,0,0,0,,Кір қолдарыңыздан құтылыңыз!
Dialogue: 0,0:12:08.89,0:12:09.77,Default,,0,0,0,,А... а?
Dialogue: 0,0:12:09.89,0:12:10.72,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:11.35,0:12:13.23,Default,,0,0,0,,Мен сені қорғаймын
Dialogue: 0,0:12:13.56,0:12:14.48,Default,,0,0,0,,Масато…
Dialogue: 0,0:12:14.60,0:12:15.73,Default,,0,0,0,,Парта артында!
Dialogue: 0,0:12:15.86,0:12:18.07,Default,,0,0,0,,(саусақ ысқырығы)
Dialogue: 0,0:12:19.44,0:12:20.28,Default,,0,0,0,,(кездейсоқ ату дыбысы)
Dialogue: 0,0:12:26.16,0:12:28.03,Default,,0,0,0,,Мынау... бұл не деген жігіттер!
Dialogue: 0,0:12:28.16,0:12:29.99,Default,,0,0,0,,<Бұл сенің отрядың емес пе? 〉
Dialogue: 0,0:12:31.08,0:12:34.71,Default,,0,0,0,,Эй, жалған полиция! Бұл мылтық шынайы
Dialogue: 0,0:12:35.92,0:12:37.84,Default,,0,0,0,,Пайдасыз қарсылықты тоқтату.
Dialogue: 0,0:12:41.71,0:12:43.22,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:12:43.88,0:12:45.26,Default,,0,0,0,,Олар кімдер?
Dialogue: 0,0:12:46.93,0:12:51.64,Default,,0,0,0,,Ха~хаха хахахаха...
Dialogue: 0,0:12:54.23,0:12:56.85,Default,,0,0,0,,Біраз болды, аққұба бейбақ.
Dialogue: 0,0:12:58.02,0:12:58.90,Default,,0,0,0,,Эдди
Dialogue: 0,0:12:59.36,0:13:01.15,Default,,0,0,0,,Сот ұзаққа созылғанымен
Dialogue: 0,0:13:01.28,0:13:03.94,Default,,0,0,0,,Мен ақталып шықтым.
Dialogue: 0,0:13:04.49,0:13:06.03,Default,,0,0,0,,Ақша
Dialogue: 0,0:13:06.41,0:13:07.57,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:13:07.70,0:13:12.75,Default,,0,0,0,,«Корольдік бауырлар», «аукцион», «полицияға басып кіру» және т.б.
Dialogue: 0,0:13:12.87,0:13:16.33,Default,,0,0,0,,Әлі де дөрекі қулыққа толы.
Dialogue: 0,0:13:16.83,0:13:19.63,Default,,0,0,0,,Сэм мен Коулман мұнда келмеді.
Dialogue: 0,0:13:19.96,0:13:21.96,Default,,0,0,0,,«Танысқаныма қуаныштымын».
Dialogue: 0,0:13:24.22,0:13:25.88,Default,,0,0,0,,Мен сізге...
Dialogue: 0,0:13:26.26,0:13:27.09,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:27.22,0:13:28.18,Default,,0,0,0,,Ей!
Dialogue: 0,0:13:29.26,0:13:30.26,Default,,0,0,0,,Камера?
Dialogue: 0,0:13:30.43,0:13:31.60,Default,,0,0,0,,Маған бір сәт беріңіз.
Dialogue: 0,0:13:32.72,0:13:33.85,Default,,0,0,0,,Бұл сәл ақымақтық емес пе?
Dialogue: 0,0:13:34.23,0:13:36.52,Default,,0,0,0,,Балалар сендер болашақта жамандық жасамауларың үшін.
Dialogue: 0,0:13:36.64,0:13:38.56,Default,,0,0,0,,Мен міндетті түрде суретке түсіремін.
Dialogue: 0,0:13:38.94,0:13:41.44,Default,,0,0,0,,Масато, бұл не?
Dialogue: 0,0:13:41.57,0:13:43.65,Default,,0,0,0,,Неліктен олар әлі тірі?
Dialogue: 0,0:13:44.03,0:13:46.53,Default,,0,0,0,,Бұл халықаралық алаяқтар
Dialogue: 0,0:13:46.95,0:13:50.20,Default,,0,0,0,,Кейінірек кірген адам менің көмекшім болды.
Dialogue: 0,0:13:50.91,0:13:55.08,Default,,0,0,0,,Бұл жолы «үлкен жоспар» сияқты.
Dialogue: 0,0:13:55.20,0:13:56.62,Default,,0,0,0,,<Е... Оз? 〉
Dialogue: 0,0:13:58.96,0:14:00.17,Default,,0,0,0,,Эдамаме
Dialogue: 0,0:14:01.92,0:14:03.21,Default,,0,0,0,,Ха-ха…
Dialogue: 0,0:14:03.59,0:14:06.72,Default,,0,0,0,,Жалғыз адам болып көрінетін қылмыскерлер
Dialogue: 0,0:14:06.84,0:14:09.51,Default,,0,0,0,,Шабдалы Куперчику туралы твиттер жазбаңыз
Dialogue: 0,0:14:10.05,0:14:11.80,Default,,0,0,0,,Ах, Исигами мырза
Dialogue: 0,0:14:11.93,0:14:14.85,Default,,0,0,0,,Артыңыздағы жігіттен чекті қайтарыңыз.
Dialogue: 0,0:14:15.52,0:14:16.68,Default,,0,0,0,,Олардан да істер
Dialogue: 0,0:14:17.06,0:14:18.77,Default,,0,0,0,,Иә? Иә!
Dialogue: 0,0:14:19.65,0:14:20.56,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:14:20.69,0:14:22.65,Default,,0,0,0,,Енді іс...
Dialogue: 0,0:14:23.23,0:14:24.82,Default,,0,0,0,,Ей! Ах...
Dialogue: 0,0:14:26.82,0:14:27.65,Default,,0,0,0,,Мен онымен екеуміз ғана, бір рет болса да сөйлескенді қатты қалаймын. Хехе.
Dialogue: 0,0:14:28.11,0:14:29.49,Default,,0,0,0,,Мен оны қайтарып алдым.
Dialogue: 0,0:14:29.82,0:14:30.95,Default,,0,0,0,,Жарайсың
Dialogue: 0,0:14:31.32,0:14:34.08,Default,,0,0,0,,Төрағаның қалауынша орындаңыз.
Dialogue: 0,0:14:39.33,0:14:41.42,Default,,0,0,0,,Ку...фуфуфу аххахаха
Dialogue: 0,0:14:42.13,0:14:45.88,Default,,0,0,0,,Хахахаха хахахаха!
Dialogue: 0,0:14:46.38,0:14:47.30,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:48.01,0:14:51.39,Default,,0,0,0,,Мен аққұба бейбақты жеңдім!
Dialogue: 0,0:14:52.72,0:14:57.73,Default,,0,0,0,,Пуу Ахахахха... Ухахаха!
Dialogue: 0,0:14:57.85,0:14:59.60,Default,,0,0,0,,Кристалда жарық жүздеген миллион рет шағылады—
Dialogue: 0,0:14:59.73,0:15:01.69,Default,,0,0,0,,ештеңе көрінбейді, иә?
Dialogue: 0,0:15:01.81,0:15:02.69,Default,,0,0,0,,Масато
Dialogue: 0,0:15:03.27,0:15:04.90,Default,,0,0,0,,Ух... ха...
Dialogue: 0,0:15:05.02,0:15:05.86,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:06.36,0:15:08.69,Default,,0,0,0,,Бұл фарсты қашанға дейін ойнаймыз?
Dialogue: 0,0:15:09.61,0:15:11.16,Default,,0,0,0,,Бұл фарс па?
Dialogue: 0,0:15:11.61,0:15:13.70,Default,,0,0,0,,Сіз қаншалықты байыпты әрекет етсеңіз де
Dialogue: 0,0:15:13.82,0:15:16.87,Default,,0,0,0,,Шулы! Өзің білетіндей әрекет жасама!
Dialogue: 0,0:15:17.45,0:15:21.87,Default,,0,0,0,,Қалағаныңды айт! Мені де, анамды да тастап кеткен сенсің!
Dialogue: 0,0:15:22.00,0:15:25.46,Default,,0,0,0,,Апамды баққан мен едім!
Dialogue: 0,0:15:26.38,0:15:30.59,Default,,0,0,0,,Сіз сасық тамақ жеп жатқанда мен өзімді қаншалықты жалғыз сезіндім деп ойлайсыз?
Dialogue: 0,0:15:30.72,0:15:32.09,Default,,0,0,0,,Сіз түсінбейсіз!
Dialogue: 0,0:15:32.93,0:15:36.89,Default,,0,0,0,,«Мен әкеме сенемін» деп жүрдім!
Dialogue: 0,0:15:37.01,0:15:39.98,Default,,0,0,0,,Сен маған опасыздық жасадың!
Dialogue: 0,0:15:40.64,0:15:42.90,Default,,0,0,0,,Анасы көрде жалғыз
Dialogue: 0,0:15:43.02,0:15:45.36,Default,,0,0,0,,Дороти барлығынан кек алғысы келе ме?
Dialogue: 0,0:15:45.65,0:15:48.32,Default,,0,0,0,,Ол дос емес, жалғыз қасқыр, солай ма?
Dialogue: 0,0:15:48.44,0:15:53.03,Default,,0,0,0,,Бұл ақша, уақыт және отбасы есебінен өте ыңғайлы ұран!
Dialogue: 0,0:15:53.16,0:15:54.53,Default,,0,0,0,,Тек Окуясу мен екеуміз ғана қарт кісінің қайығына барамыз.
Dialogue: 0,0:15:55.28,0:15:57.49,Default,,0,0,0,,Мен фарсты ертерек қалдырдым.
Dialogue: 0,0:15:57.70,0:16:00.87,Default,,0,0,0,,Онда мен саған байыпты екенімді көрсетемін.
Dialogue: 0,0:16:01.83,0:16:04.12,Default,,0,0,0,,Алдымен мен Доротимен о дүниеде қоштасамын.
Dialogue: 0,0:16:04.29,0:16:07.04,Default,,0,0,0,,«Бос сызбалар үшін кешіріңіз».
Dialogue: 0,0:16:07.46,0:16:09.30,Default,,0,0,0,,Осыдан кейін Доротиді өзіңізбен бірге алыңыз.
Dialogue: 0,0:16:09.71,0:16:11.59,Default,,0,0,0,,Анаңнан кешірім сұрау
Dialogue: 0,0:16:14.34,0:16:15.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:15.47,0:16:17.64,Default,,0,0,0,,Эдамаме Сіз мұнымен біттіңіз, солай ма?
Dialogue: 0,0:16:17.89,0:16:19.39,Default,,0,0,0,,Бұл аяқталмайды!
Dialogue: 0,0:16:20.02,0:16:21.14,Default,,0,0,0,,Лоран!
Dialogue: 0,0:16:21.27,0:16:24.40,Default,,0,0,0,,Сен адамсың ғой, сені алдаудан ләззат алатын қоқыс!
Dialogue: 0,0:16:24.98,0:16:29.65,Default,,0,0,0,,Сен үшін маңызды адам құрбан болса да, тәубе етпесең, аяғыңды жумайсың!
Dialogue: 0,0:16:29.94,0:16:31.28,Default,,0,0,0,,Сенімді адам?
Dialogue: 0,0:16:31.40,0:16:32.90,Default,,0,0,0,,Хаха, бұл не?
Dialogue: 0,0:16:33.82,0:16:37.28,Default,,0,0,0,,Басқаларды ренжітіп, күлсең де, өзің аздап ренжісең ше?
Dialogue: 0,0:16:37.41,0:16:39.58,Default,,0,0,0,,Қайғылы оқиғаның қаһарманына ұқсайды!
Dialogue: 0,0:16:39.87,0:16:42.00,Default,,0,0,0,,Нарцисистік қылмыскерлер
Dialogue: 0,0:16:42.33,0:16:43.71,Default,,0,0,0,,Асқазан шығып жатыр!
Dialogue: 0,0:16:44.08,0:16:47.79,Default,,0,0,0,,Әрқашан түсініктемесіз қатысады
Dialogue: 0,0:16:48.63,0:16:50.88,Default,,0,0,0,,Мен енді сендерге ерінбеймін!
Dialogue: 0,0:16:51.13,0:16:54.68,Default,,0,0,0,,Бұдан былай сен тек өзіңе сенесің!
Dialogue: 0,0:16:55.84,0:16:56.68,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:57.14,0:16:58.26,Default,,0,0,0,,Эдамаме
Dialogue: 0,0:16:58.47,0:17:02.31,Default,,0,0,0,,Фарс болса да, шынайы сезімдеріңді естігеніме қуаныштымын.
Dialogue: 0,0:17:02.64,0:17:03.73,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:04.06,0:17:07.19,Default,,0,0,0,,Дәл қазір сен... қалай айтайын...
Dialogue: 0,0:17:07.31,0:17:10.44,Default,,0,0,0,,Әй, қалай қарасаң да сәтсіздік.
Dialogue: 0,0:17:10.57,0:17:13.32,Default,,0,0,0,,Сонда кім сәтсіздікке ұшырады?
Dialogue: 0,0:17:13.78,0:17:14.61,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:15.45,0:17:17.16,Default,,0,0,0,,Tsk! Апыр-ай!
Dialogue: 0,0:17:34.38,0:17:35.34,Default,,0,0,0,,Масато!
Dialogue: 0,0:17:37.59,0:17:38.59,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:41.76,0:17:44.10,Default,,0,0,0,,Жасай бер!
Dialogue: 0,0:17:44.93,0:17:46.85,Default,,0,0,0,,Хя ха ха хо…
Dialogue: 0,0:17:50.36,0:17:51.69,Default,,0,0,0,,Төраға, жүгірейік!
Dialogue: 0,0:17:51.82,0:17:54.32,Default,,0,0,0,,Масато... Масато!
Dialogue: 0,0:17:55.74,0:17:58.36,Default,,0,0,0,,(кездейсоқ ату дыбысы)
Dialogue: 0,0:18:00.95,0:18:03.83,Default,,0,0,0,,(Электрондық құлыпты құлыптау дыбысы)
Dialogue: 0,0:18:04.16,0:18:06.54,Default,,0,0,0,,Неліктен лифт жұмыс істемейді?
Dialogue: 0,0:18:06.66,0:18:08.29,Default,,0,0,0,,Неліктен басқа қызметкерлер жоқ?
Dialogue: 0,0:18:08.42,0:18:09.29,Default,,0,0,0,,Масато…
Dialogue: 0,0:18:09.42,0:18:10.33,Default,,0,0,0,,<Не істеп жатырсың! 〉
Dialogue: 0,0:18:10.46,0:18:11.50,Default,,0,0,0,,<Асығыңыз! 〉
Dialogue: 0,0:18:11.63,0:18:12.67,Default,,0,0,0,,<Өлім...>
Dialogue: 0,0:18:12.80,0:18:14.42,Default,,0,0,0,,<Сіз бұл асығыс дедіңіз! 〉
Dialogue: 0,0:18:14.55,0:18:15.84,Default,,0,0,0,,Тынш, тыныш бол.
Dialogue: 0,0:18:15.96,0:18:17.34,Default,,0,0,0,,<Қатты! Радио толқыны жоқ па? 〉
Dialogue: 0,0:18:17.47,0:18:18.59,Default,,0,0,0,,<Тыныш! 〉
Dialogue: 0,0:18:18.72,0:18:19.55,Default,,0,0,0,,〈А? 〉
Dialogue: 0,0:18:20.93,0:18:22.47,Default,,0,0,0,,(Камино) Керемет болды, иә? Кеше Эндевор.
Dialogue: 0,0:18:22.60,0:18:23.81,Default,,0,0,0,,<Бірге құлап жатырмыз ба? 〉
Dialogue: 0,0:18:24.01,0:18:25.56,Default,,0,0,0,,Масато!
Dialogue: 0,0:18:26.10,0:18:26.93,Default,,0,0,0,,(электрондық құлыпты ашу дыбысы)
Dialogue: 0,0:18:28.98,0:18:30.73,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:32.40,0:18:34.23,Default,,0,0,0,,<Ол қайда жоғалып кетті? 〉
Dialogue: 0,0:18:34.44,0:18:36.74,Default,,0,0,0,,Ал чектер туралы не деуге болады? Тіркеу ісі жоқ!
Dialogue: 0,0:18:37.28,0:18:40.16,Default,,0,0,0,,<Ол келесі бөлмеде ме? Сен қайдасың? 〉
Dialogue: 0,0:18:40.28,0:18:41.24,Default,,0,0,0,,Не?
Dialogue: 0,0:18:41.37,0:18:43.62,Default,,0,0,0,,<Қайсысы? Тек солға немесе оңға! 〉
Dialogue: 0,0:18:43.74,0:18:45.37,Default,,0,0,0,,Ах~ Шулы!
Dialogue: 0,0:18:45.49,0:18:47.58,Default,,0,0,0,,Ишигами (Ишигами) Не болып жатыр?
Dialogue: 0,0:18:47.70,0:18:48.75,Default,,0,0,0,,Ишигами! (Ишигами)...Иә!
Dialogue: 0,0:18:49.25,0:18:50.37,Default,,0,0,0,,Мен Архитектуралық дизайн бөлімінен Отомын; сіз маған қоңырау шалған едіңіз.
Dialogue: 0,0:18:50.50,0:18:51.54,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:51.88,0:18:52.71,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:53.96,0:18:54.96,Default,,0,0,0,,Тетік?
Dialogue: 0,0:18:55.09,0:18:56.51,Default,,0,0,0,,Осындай нәрсе болды ма?
Dialogue: 0,0:18:57.30,0:18:58.47,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:58.92,0:19:00.34,Default,,0,0,0,,А... А, бұл қауіпті...
Dialogue: 0,0:19:03.10,0:19:05.31,Default,,0,0,0,,Иә? (Ишигами) Ах... аа...
Dialogue: 0,0:19:05.47,0:19:07.02,Default,,0,0,0,,〈Ей, балалар, не істеп жатырсыңдар...〉
Dialogue: 0,0:19:07.14,0:19:09.56,Default,,0,0,0,,Міне, осылайша-ақ қырылып қалады!
Dialogue: 0,0:19:09.69,0:19:13.56,Default,,0,0,0,,
Dialogue: 0,0:19:14.94,0:19:17.48,Default,,0,0,0,,А... аа... ой...
Dialogue: 0,0:19:18.90,0:19:21.07,Default,,0,0,0,,Уау...
Dialogue: 0,0:19:31.08,0:19:32.42,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:19:33.46,0:19:36.75,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:46.56,0:19:50.43,Default,,0,0,0,,Ай!
Dialogue: 0,0:20:20.01,0:20:21.88,Default,,0,0,0,,Сәлем... Сәлем...
Dialogue: 0,0:20:22.01,0:20:22.84,Default,,0,0,0,,Хиккуши!
Dialogue: 0,0:20:24.97,0:20:26.01,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:26.35,0:20:27.80,Default,,0,0,0,,Міне, осылайша-ақ қырылып қалады!
Dialogue: 0,0:20:27.93,0:20:29.31,Default,,0,0,0,,Күт… не?
Dialogue: 0,0:20:29.43,0:20:34.69,Default,,0,0,0,,(сықырлау)
Dialogue: 0,0:20:50.95,0:20:56.96,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.78,0:22:50.78,Default,,0,0,0,,~♪
Dialogue: 0,0:22:52.28,0:22:58.28,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory