Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.71,0:00:03.42,Default,,0,0,0,,Эй, сен ағылшын тілін түсінесің, солай ма?
Dialogue: 0,0:00:03.54,0:00:04.37,Default,,0,0,0,,Иә
Dialogue: 0,0:00:04.92,0:00:08.09,Default,,0,0,0,,Тұздалған қиярды шығарыңыз, бұл менікі.
Dialogue: 0,0:00:08.25,0:00:10.21,Default,,0,0,0,,Жарайсың ба? 8 чизбургер
Dialogue: 0,0:00:10.34,0:00:11.55,Default,,0,0,0,,Екі қос қос
Dialogue: 0,0:00:11.67,0:00:12.67,Default,,0,0,0,,Және…
Dialogue: 0,0:00:12.80,0:00:13.72,Default,,0,0,0,,2-раунд, 1-жекпе-жек
Dialogue: 0,0:00:13.84,0:00:15.47,Default,,0,0,0,,О, аузыңды жап, күте тұр!
Dialogue: 0,0:00:19.56,0:00:21.31,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:00:21.60,0:00:22.56,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:00:22.68,0:00:24.52,Default,,0,0,0,,Түскі ас. Бұл менің де бүгінгі сыйлығым.
Dialogue: 0,0:00:24.64,0:00:26.23,Default,,0,0,0,,Өзіңізді ұстаудың қажеті жоқ.
Dialogue: 0,0:00:27.40,0:00:29.90,Default,,0,0,0,,Кеше Азиялық қандай адам болды?
Dialogue: 0,0:00:30.03,0:00:32.57,Default,,0,0,0,,А, мен әлі білмедім.
Dialogue: 0,0:00:32.69,0:00:34.65,Default,,0,0,0,,Менде мүлдем түсінік жоқ...
Dialogue: 0,0:00:34.78,0:00:38.03,Default,,0,0,0,,Ол шынымен де тамаша бағынушы.
Dialogue: 0,0:00:41.08,0:00:42.54,Default,,0,0,0,,Қарғыс атсын, көңілді жүрсің!
Dialogue: 0,0:00:43.37,0:00:45.12,Default,,0,0,0,,Кассаноға лақтырыңыз және бәрі...
Dialogue: 0,0:00:45.25,0:00:47.38,Default,,0,0,0,,(құсу дыбысы)
Dialogue: 0,0:00:47.50,0:00:50.50,Default,,0,0,0,,Тәтті, оның ішінде тұздалған қияр бар!
Dialogue: 0,0:00:50.63,0:00:52.76,Default,,0,0,0,,Андерсон мырза, оны өзгертуімді қалайсыз ба?
Dialogue: 0,0:00:52.88,0:00:54.26,Default,,0,0,0,,Шулы! (Детектив) Уф!
Dialogue: 0,0:00:56.18,0:01:00.06,Default,,0,0,0,,Үлкен адамның сағынышына еніп, үлкен байлыққа ие болыңыз
Dialogue: 0,0:01:00.35,0:01:04.64,Default,,0,0,0,,Жапония да тарихтағы ең сенімді адам болған.
Dialogue: 0,0:01:06.64,0:01:08.35,Default,,0,0,0,,Тойотоми Хидейоши дабе
Dialogue: 0,0:01:08.86,0:01:10.98,Default,,0,0,0,,Жақын кел, Лоран.
Dialogue: 0,0:01:11.11,0:01:12.61,Default,,0,0,0,,Жаяу күрес
Dialogue: 0,0:01:13.36,0:01:19.37,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:11.67,0:02:17.67,Default,,0,0,0,,~♪
Dialogue: 0,0:02:19.18,0:02:20.22,Default,,0,0,0,,Дос емес
Dialogue: 0,0:02:20.76,0:02:22.18,Default,,0,0,0,,Барлығы жалғыз қасқыр
Dialogue: 0,0:02:22.30,0:02:23.85,Default,,0,0,0,,Егер сіз сәтсіздікке ұшырасаңыз, сізді тастап кетесіз.
Dialogue: 0,0:02:23.97,0:02:26.02,Default,,0,0,0,,Сенуге болатын жалғыз адам - өзіңіз
Dialogue: 0,0:02:26.27,0:02:28.02,Default,,0,0,0,,Бар, түкке тұрғысызсың.
Dialogue: 0,0:02:28.14,0:02:31.02,Default,,0,0,0,,Өз ұяңда мастурбация жаса, тың.
Dialogue: 0,0:02:32.27,0:02:34.27,Default,,0,0,0,,Олар әуежайды бақылап тұруы керек.
Dialogue: 0,0:03:05.76,0:03:08.89,Default,,0,0,0,,Балалар сендер күрішті көбірек жеулерің керек.
Dialogue: 0,0:03:09.43,0:03:11.39,Default,,0,0,0,,Әрине, таяқшалармен.
Dialogue: 0,0:03:11.52,0:03:14.40,Default,,0,0,0,,Ха! Өкінішке орай, мен тек нан жей аламын!
Dialogue: 0,0:03:14.90,0:03:17.19,Default,,0,0,0,,Хмф! Ха! (Жау) Бейбақ!
Dialogue: 0,0:03:17.69,0:03:18.53,Default,,0,0,0,,Ха!
Dialogue: 0,0:03:21.61,0:03:24.45,Default,,0,0,0,,Мен мұны талай рет айттым, бірақ үрлеуден басқа амалым жоқ.
Dialogue: 0,0:03:25.87,0:03:27.66,Default,,0,0,0,,Мен ешқашан ас үйде жеңілген емеспін
Dialogue: 0,0:03:30.08,0:03:31.54,Default,,0,0,0,,Пиоттардан сақ болыңыз
Dialogue: 0,0:03:32.00,0:03:34.79,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:03:46.97,0:03:48.22,Default,,0,0,0,,Бұл бәрі немесе ештеңе
Dialogue: 0,0:03:50.81,0:03:51.64,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:51.98,0:03:52.81,Default,,0,0,0,,Гррр... Гррр...
Dialogue: 0,0:03:53.39,0:03:54.23,Default,,0,0,0,,(магистраль жабылған дыбыс)
Dialogue: 0,0:03:59.90,0:04:00.94,Default,,0,0,0,,Неге қашып кеттің?
Dialogue: 0,0:04:02.15,0:04:04.53,Default,,0,0,0,,Мен оны сатудан шаршадым.
Dialogue: 0,0:04:05.37,0:04:07.16,Default,,0,0,0,,Қазір олай болмайды деп ойлаймын.
Dialogue: 0,0:04:07.66,0:04:09.54,Default,,0,0,0,,Сіз оны сатуды шешкен жоқсыз ба?
Dialogue: 0,0:04:10.66,0:04:14.17,Default,,0,0,0,,Біз тек... Жапониядан жиіркеніп қалдық.
Dialogue: 0,0:04:14.29,0:04:16.33,Default,,0,0,0,,Маған енді бәрібір...
Dialogue: 0,0:04:17.50,0:04:19.05,Default,,0,0,0,,Хмм... менімен сөйлес.
Dialogue: 0,0:04:20.59,0:04:23.22,Default,,0,0,0,,Ол дәрі мен үшін бәрі болды.
Dialogue: 0,0:04:24.05,0:04:28.81,Default,,0,0,0,,Көптеген жылдар бойы жазылмайтын науқастар үшін әзірленген
Dialogue: 0,0:04:29.56,0:04:33.60,Default,,0,0,0,,Дегенмен, потенциалдың күштілігі сонша, оны қоқыс ретінде қарастырады.
Dialogue: 0,0:04:34.48,0:04:37.90,Default,,0,0,0,,Несиені мен сенім артқан әріптесім ұрлап алды.
Dialogue: 0,0:04:38.56,0:04:41.48,Default,,0,0,0,,Өйткені, бұл өзара сүйретілетін дүние.
Dialogue: 0,0:04:42.82,0:04:46.99,Default,,0,0,0,,Сіз менің сезімімді түсінбейсіз.
Dialogue: 0,0:04:47.74,0:04:49.37,Default,,0,0,0,,Мен туралы не білесіз?
Dialogue: 0,0:04:50.33,0:04:51.74,Default,,0,0,0,,Тек камуфляж үшін
Dialogue: 0,0:04:51.87,0:04:54.29,Default,,0,0,0,,Мен сізді ақымақ фильмді қаржыландырып жатқаныңызды естідім.
Dialogue: 0,0:04:55.16,0:04:57.33,Default,,0,0,0,,Менің фильмімді көрдіңіз бе?
Dialogue: 0,0:04:57.46,0:05:00.09,Default,,0,0,0,,Барлығы көрмесе де солай айтады.
Dialogue: 0,0:05:00.42,0:05:01.84,Default,,0,0,0,,Хун
Dialogue: 0,0:05:02.42,0:05:06.34,Default,,0,0,0,,Қарамай-ақ сынайтындардың бірісіз бе?
Dialogue: 0,0:05:07.72,0:05:10.89,Default,,0,0,0,,Балалар сендер күрішті көбірек жеулерің керек.
Dialogue: 0,0:05:11.14,0:05:12.68,Default,,0,0,0,,(Әйел) Жолдасым! Арбадағы әйел өліп қалды, бірақ➡
Dialogue: 0,0:05:12.81,0:05:13.64,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:14.31,0:05:16.69,Default,,0,0,0,,«Қүйген қамал» емес пе?
Dialogue: 0,0:05:16.81,0:05:19.31,Default,,0,0,0,,Бұл жапондық шығарылымның тақырыбы.
Dialogue: 0,0:05:20.06,0:05:21.90,Default,,0,0,0,,Бұл сіздің фильміңіз болды...
Dialogue: 0,0:05:22.03,0:05:23.86,Default,,0,0,0,,Сіз оны көрдіңіз бе?
Dialogue: 0,0:05:23.99,0:05:25.74,Default,,0,0,0,,Мен оның болғанына сене алар емеспін!
Dialogue: 0,0:05:25.90,0:05:27.24,Default,,0,0,0,,Раззи сүйіктісіне арналған
Dialogue: 0,0:05:27.36,0:05:30.16,Default,,0,0,0,,Бекініске жалғыз кірудің шарықтау шегі
Dialogue: 0,0:05:30.28,0:05:32.70,Default,,0,0,0,,Қанша көрсем де, жылауымды тоқтата алмаймын
Dialogue: 0,0:05:32.83,0:05:34.95,Default,,0,0,0,,Тек бір рет қолданылатын таяқшаларды пайдаланып көптеген жауларды жеңіңіз.
Dialogue: 0,0:05:35.08,0:05:37.21,Default,,0,0,0,,Бір рет қолданылатын таяқшаның әрекеті ең жақсы!
Dialogue: 0,0:05:37.54,0:05:39.25,Default,,0,0,0,,Бекініс күн батқанда теңізге батады
Dialogue: 0,0:05:39.38,0:05:42.67,Default,,0,0,0,,Дельфин секірген соңдағы сұлулық...
Dialogue: 0,0:05:42.80,0:05:44.59,Default,,0,0,0,,Ал, тынышталыңыз.
Dialogue: 0,0:05:45.84,0:05:49.51,Default,,0,0,0,,Ндаба Сондай-ақ «Қүйген қашқын пойыз» және «Қүйген суға батқан кеме»?
Dialogue: 0,0:05:49.64,0:05:50.47,Default,,0,0,0,,Бұл менікі
Dialogue: 0,0:05:50.60,0:05:52.10,Default,,0,0,0,,«Стреццо» дейсің бе?
Dialogue: 0,0:05:52.43,0:05:55.18,Default,,0,0,0,,Бұл Киелі кітаптан оқуға болатын тамаша фильм!
Dialogue: 0,0:05:55.31,0:05:58.52,Default,,0,0,0,,Адамдар бұл ақымақ В-фильмі дейді.
Dialogue: 0,0:05:58.64,0:06:00.77,Default,,0,0,0,,Түсінбейтін дүние ғой!
Dialogue: 0,0:06:01.52,0:06:03.78,Default,,0,0,0,,Сіздің фильміңіздегі басты кейіпкерлер
Dialogue: 0,0:06:03.90,0:06:07.74,Default,,0,0,0,,Қанша қиын жағдай болса да, берілмей күресетін ерлер!
Dialogue: 0,0:06:07.86,0:06:09.45,Default,,0,0,0,,Жеңіске жету мүмкіндігі болмаса да
Dialogue: 0,0:06:09.57,0:06:12.45,Default,,0,0,0,,Жақындарыңызды қорғау үшін бар күшіңізді салыңыз
Dialogue: 0,0:06:12.58,0:06:15.95,Default,,0,0,0,,Біз сіздің фильмдеріңізден көп нәрсені үйрендік!
Dialogue: 0,0:06:16.62,0:06:19.21,Default,,0,0,0,,Менің ең көп сурет салғым келгені осы болды.
Dialogue: 0,0:06:20.17,0:06:23.71,Default,,0,0,0,,«Эдди Кассано фильмнің жақсы не жаман екенін білмейді».
Dialogue: 0,0:06:23.84,0:06:26.42,Default,,0,0,0,,«Мен оған тек камуфляж үшін ақша салып жатырмын.»
Dialogue: 0,0:06:26.55,0:06:28.42,Default,,0,0,0,,Бұл өтірік!
Dialogue: 0,0:06:28.55,0:06:31.64,Default,,0,0,0,,Сіз инвестиция салған фильмдерді сеніммен таңдайсыз.
Dialogue: 0,0:06:32.51,0:06:36.18,Default,,0,0,0,,Егер сіз фильмдерді жақсы көрмесеңіз, қараңғы фильмдер түсіре алмайсыз!
Dialogue: 0,0:06:36.93,0:06:38.85,Default,,0,0,0,,Бұл жақсы сөз.
Dialogue: 0,0:06:39.06,0:06:41.23,Default,,0,0,0,,Мен сені түсінеді деп ойламаппын.
Dialogue: 0,0:06:41.35,0:06:42.19,Default,,0,0,0,,Мен олай ойламадым.
Dialogue: 0,0:06:43.69,0:06:47.03,Default,,0,0,0,,Маған біз жасаған дәрі балаға қандай қорқынышты көрінсе, сонша қорқынышты.
Dialogue: 0,0:06:47.15,0:06:50.86,Default,,0,0,0,,Сол сияқты, сіз үшін фильмдер...
Dialogue: 0,0:06:51.53,0:06:53.53,Default,,0,0,0,,Бала сияқты
Dialogue: 0,0:06:55.49,0:06:59.66,Default,,0,0,0,,Доктор Сакура Сиқыры - шедевр.
Dialogue: 0,0:06:59.79,0:07:01.96,Default,,0,0,0,,Менің жүрегім ауырды
Dialogue: 0,0:07:02.54,0:07:05.42,Default,,0,0,0,,Сіз біраз ақша қоса аласыз.
Dialogue: 0,0:07:06.71,0:07:08.34,Default,,0,0,0,,Егер сіз екі есе көп төлесеңіз
Dialogue: 0,0:07:08.59,0:07:10.72,Default,,0,0,0,,рет? Он миллион доллар?
Dialogue: 0,0:07:10.84,0:07:14.10,Default,,0,0,0,,Келіңіздер, бұл жай ғана күлкілі.
Dialogue: 0,0:07:14.22,0:07:16.60,Default,,0,0,0,,Балаңызды қаншаға сатар едіңіз?
Dialogue: 0,0:07:17.14,0:07:18.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:20.14,0:07:21.31,Default,,0,0,0,,Мұны тіркеңіз
Dialogue: 0,0:07:22.23,0:07:23.23,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:07:23.98,0:07:24.81,Default,,0,0,0,,Рецепт
Dialogue: 0,0:07:25.36,0:07:26.52,Default,,0,0,0,,Рецепт?
Dialogue: 0,0:07:26.65,0:07:30.57,Default,,0,0,0,,Төмендегі нұсқауларды орындау арқылы кез келген адам Сакура сиқырын жасай алады.
Dialogue: 0,0:07:31.15,0:07:33.45,Default,,0,0,0,,Мен шынымен де осымын.
Dialogue: 0,0:07:34.82,0:07:36.95,Default,,0,0,0,,Мен оны саған сеніп тапсыра аламын.
Dialogue: 0,0:07:37.41,0:07:39.87,Default,,0,0,0,,10 миллион доллар Бұл қымбат па?
Dialogue: 0,0:07:40.71,0:07:42.21,Default,,0,0,0,,Тым арзан
Dialogue: 0,0:07:45.96,0:07:46.79,Default,,0,0,0,,Түнгі стенд
Dialogue: 0,0:07:46.92,0:07:50.05,Default,,0,0,0,,Мен мұндай препаратты қалай жасауға болатынын зерттедім.
Dialogue: 0,0:07:50.26,0:07:53.76,Default,,0,0,0,,Әрине, Сакура Сиқыры ешқашан мүмкін емес еді.
Dialogue: 0,0:07:53.89,0:07:56.89,Default,,0,0,0,,Мен ақша алғанша, басқа ештеңе білмеймін.
Dialogue: 0,0:07:57.01,0:07:57.85,Default,,0,0,0,,(Лоран ысқырығы)
Dialogue: 0,0:07:58.22,0:08:01.77,Default,,0,0,0,,Қалайсың, Эбби? Дәл мен күткендей
Dialogue: 0,0:08:02.10,0:08:05.69,Default,,0,0,0,,Бұл фильмді мақтау үшін сізде керемет талғам болуы керек.
Dialogue: 0,0:08:05.81,0:08:07.61,Default,,0,0,0,,Раззи сыйлығы өте күлкілі!
Dialogue: 0,0:08:07.73,0:08:10.61,Default,,0,0,0,,«Күйікті» сериясы – ғасыр шедеврі!
Dialogue: 0,0:08:10.74,0:08:14.07,Default,,0,0,0,,Бір рет қолданылатын таяқшамен 200 адамды өлтіруге болады!
Dialogue: 0,0:08:14.99,0:08:16.99,Default,,0,0,0,,Сізге қатты әсер еткен сияқтысыз.
Dialogue: 0,0:08:17.12,0:08:18.95,Default,,0,0,0,,Бұл да талант шығар
Dialogue: 0,0:08:19.08,0:08:20.12,Default,,0,0,0,,
Dialogue: 0,0:08:20.24,0:08:21.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:22.50,0:08:24.00,Default,,0,0,0,,Қауіпсіз көлік?
Dialogue: 0,0:08:24.21,0:08:26.08,Default,,0,0,0,,Бұл кәмпиттің бағасы.
Dialogue: 0,0:08:26.38,0:08:28.75,Default,,0,0,0,,Оны қалай бөлу керектігін шешемін.
Dialogue: 0,0:08:28.88,0:08:29.84,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:08:30.09,0:08:32.34,Default,,0,0,0,,Алдымен жартысын аламыз.
Dialogue: 0,0:08:32.47,0:08:34.72,Default,,0,0,0,,Қалған жартысы, оны екіге бөліңіз...
Dialogue: 0,0:08:34.84,0:08:36.64,Default,,0,0,0,,Сіз ақша әкелмеген сияқтысыз.
Dialogue: 0,0:08:36.76,0:08:37.60,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:38.60,0:08:40.39,Default,,0,0,0,,Аа, бұл рас.
Dialogue: 0,0:08:41.60,0:08:43.35,Default,,0,0,0,,Тек қашуға дайын болыңыз.
Dialogue: 0,0:08:43.48,0:08:44.73,Default,,0,0,0,,Эх...хехе...
Dialogue: 0,0:08:45.85,0:08:48.56,Default,,0,0,0,,Кешіріңіз, мұнда ақша жоқ.
Dialogue: 0,0:08:48.69,0:08:51.40,Default,,0,0,0,,Менің Сабатым сақ.
Dialogue: 0,0:08:51.69,0:08:55.07,Default,,0,0,0,,Бұл соншалықты үлкен мәселе, жүйкеленуі табиғи нәрсе.
Dialogue: 0,0:08:55.78,0:08:57.91,Default,,0,0,0,,Егер сізде қандай да бір алаңдаушылық болса, маған кез келген нәрсені сұраңыз.
Dialogue: 0,0:08:58.32,0:08:59.53,Default,,0,0,0,,Ал, мен сенен сұрайын.
Dialogue: 0,0:08:59.66,0:09:03.87,Default,,0,0,0,,Қалай іздесем де, Масато Эдамура есімі шықпайды.
Dialogue: 0,0:09:04.37,0:09:07.33,Default,,0,0,0,,Хмм... Жапонияда қанша дәрігер бар деп ойлайсыз?
Dialogue: 0,0:09:07.46,0:09:10.46,Default,,0,0,0,,Маған SNS ұнамайды, сондықтан оны жасамаймын.
Dialogue: 0,0:09:11.50,0:09:13.30,Default,,0,0,0,,Өйткені жапондықтар қарапайым.
Dialogue: 0,0:09:13.42,0:09:16.59,Default,,0,0,0,,Интернетте өз есіміңізді оңай жария етпеңіз.
Dialogue: 0,0:09:16.84,0:09:20.81,Default,,0,0,0,,Мен осылай ойладым, мен қазір соңғы растауды жасап жатырмын.
Dialogue: 0,0:09:20.93,0:09:22.18,Default,,0,0,0,,Қорытынды растау?
Dialogue: 0,0:09:22.47,0:09:24.98,Default,,0,0,0,,Жақын арада Жапониядан хабар келеді.
Dialogue: 0,0:09:25.60,0:09:27.85,Default,,0,0,0,,Жапониядан...?
Dialogue: 0,0:09:29.52,0:09:33.73,Default,,0,0,0,,Сіз жұмыс істейтін Жапонияның химиялық зерттеу институты.
Dialogue: 0,0:09:34.19,0:09:35.95,Default,,0,0,0,,Заң кеңесшілері тобын жіберді
Dialogue: 0,0:09:36.07,0:09:37.57,Default,,0,0,0,,(Заңгердің сыбыры)
Dialogue: 0,0:09:37.70,0:09:42.58,Default,,0,0,0,,Зерттеуші доктор Масато Эдамура осында ма?
Dialogue: 0,0:09:43.45,0:09:46.00,Default,,0,0,0,,Жоқ, мен оған мүлде күмәнданбаймын.
Dialogue: 0,0:09:46.12,0:09:48.79,Default,,0,0,0,,Сіз тек адамдарды терең түсінгіңіз келеді.
Dialogue: 0,0:09:48.92,0:09:51.17,Default,,0,0,0,,(Смартфонның діріл дыбысы)
Dialogue: 0,0:09:51.96,0:09:53.05,Default,,0,0,0,,Дегенмен—
Dialogue: 0,0:09:57.30,0:09:58.13,Default,,0,0,0,,О...
Dialogue: 0,0:09:58.38,0:10:00.30,Default,,0,0,0,,Не? Бұл рас па?
Dialogue: 0,0:10:01.47,0:10:03.31,Default,,0,0,0,,Түсіндім, қолайсыздықтар үшін кешірім сұраймын.
Dialogue: 0,0:10:17.24,0:10:18.07,Default,,0,0,0,,Қазір ғана Какёин менің кім екенімді анықтай бастағанда мен дүрлігіп кеттім
Dialogue: 0,0:10:18.53,0:10:20.57,Default,,0,0,0,,Ха… ха ха…
Dialogue: 0,0:10:21.66,0:10:24.54,Default,,0,0,0,,Кассано отбасына қош келдіңіз
Dialogue: 0,0:10:25.29,0:10:28.12,Default,,0,0,0,,Өкінішке орай, ол демалыста.
Dialogue: 0,0:10:28.33,0:10:30.71,Default,,0,0,0,,Бұл сирек кездесетін нәрсе.
Dialogue: 0,0:10:30.83,0:10:33.71,Default,,0,0,0,,Мен Эдамура мырзаның демалыс алатынына сене алар емеспін.
Dialogue: 0,0:10:33.84,0:10:37.21,Default,,0,0,0,,Ол өте дарынды, зерттеуші адам.
Dialogue: 0,0:10:37.84,0:10:41.05,Default,,0,0,0,,Біз де үлкен үміт күтеміз.
Dialogue: 0,0:10:41.18,0:10:45.31,Default,,0,0,0,,Бірақ соңғы уақытта оны көру өте қиын болды.
Dialogue: 0,0:10:45.72,0:10:50.06,Default,,0,0,0,,Оның көп жылғы зерттеулері бағаланбағандықтан, ол күйзеліске түскендей көрінді...
Dialogue: 0,0:10:50.39,0:10:52.48,Default,,0,0,0,,Жоқ, ол ше?
Dialogue: 0,0:10:52.61,0:10:57.57,Default,,0,0,0,,Мен сенің аяғыңа тұрып, таңғажайып жаңа дәрілер жасайтыныңа сенімдімін.
Dialogue: 0,0:10:57.69,0:10:59.49,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:11:00.91,0:11:02.99,Default,,0,0,0,,Кассано мырза, мәселе жоқ.
Dialogue: 0,0:11:03.74,0:11:05.83,Default,,0,0,0,,Бұл тәртіпсіздік! (Кудо) Бұл матч.
Dialogue: 0,0:11:06.04,0:11:06.87,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:11:10.08,0:11:10.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:11.04,0:11:13.63,Default,,0,0,0,,Менің үстелімді біреу шатастырды ма?
Dialogue: 0,0:11:15.17,0:11:16.13,Default,,0,0,0,,Хошу оқиғасынан екі күн өткен соң
Dialogue: 0,0:11:16.46,0:11:19.80,Default,,0,0,0,,Жүр, қолыңнан келгенше тамақ іш, бұл алдын ала құттықтау.
Dialogue: 0,0:11:20.13,0:11:21.26,Default,,0,0,0,,Хаа…
Dialogue: 0,0:11:21.59,0:11:24.05,Default,,0,0,0,,Матчты тең ойын деп атаймыз.
Dialogue: 0,0:11:24.39,0:11:27.01,Default,,0,0,0,,Әйтеуір, сендердің сенімдеріңді ақтай алғаныма қуаныштымын.
Dialogue: 0,0:11:27.14,0:11:29.77,Default,,0,0,0,,Төлемге қатысты...
Dialogue: 0,0:11:30.48,0:11:32.90,Default,,0,0,0,,Мен жеткізу үшін басқа орынды қарастырып жатырмын.
Dialogue: 0,0:11:33.40,0:11:35.23,Default,,0,0,0,,Эдди Мен келісемін.
Dialogue: 0,0:11:35.48,0:11:38.65,Default,,0,0,0,,Мен де мұнда қабылдауға құлықсыз болдым.
Dialogue: 0,0:11:38.78,0:11:40.07,Default,,0,0,0,,Сіз байқадыңыз ба...
Dialogue: 0,0:11:40.44,0:11:41.28,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:41.45,0:11:45.99,Default,,0,0,0,,Терезеден көрінетін 5 қабатты тұрғын үйдің бұрыштық бөлмесі.
Dialogue: 0,0:11:46.78,0:11:48.45,Default,,0,0,0,,Бақылау үшін өте қолайлы
Dialogue: 0,0:11:48.95,0:11:51.12,Default,,0,0,0,,Хэхехехе, күткендей.
Dialogue: 0,0:11:52.25,0:11:55.13,Default,,0,0,0,,Лос-Анджелес полиция бөлімінде Андерсон деген детектив бар.
Dialogue: 0,0:11:55.25,0:11:57.09,Default,,0,0,0,,Сен мені жылдар бойы қуып келесің
Dialogue: 0,0:11:57.63,0:12:00.63,Default,,0,0,0,,B... Сізді Лос-Анджелес полиция департаменті бақылап жатыр ма?
Dialogue: 0,0:12:00.76,0:12:04.09,Default,,0,0,0,,Мен міндетті түрде қауіпсіз жерде сауда жасағым келеді.
Dialogue: 0,0:12:04.76,0:12:07.30,Default,,0,0,0,,Салазар, көлікті дайында.
Dialogue: 0,0:12:07.51,0:12:08.35,Default,,0,0,0,,Иә
Dialogue: 0,0:12:08.56,0:12:10.06,Default,,0,0,0,,Кассано пайда болады
Dialogue: 0,0:12:10.18,0:12:11.39,Default,,0,0,0,,Мен сені қуамын
Dialogue: 0,0:12:31.91,0:12:34.92,Default,,0,0,0,,Хмф, ақымақ, сен бірден ұсталып қалдың.
Dialogue: 0,0:12:35.08,0:12:37.67,Default,,0,0,0,,Ол соншалықты ақымақ емес сияқты.
Dialogue: 0,0:12:38.96,0:12:40.09,Default,,0,0,0,,Оны назардан тыс қалдырмаңыз
Dialogue: 0,0:12:40.21,0:12:41.05,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:41.42,0:12:42.92,Default,,0,0,0,,Сіз көлік қуумен айналысасыз ба?
Dialogue: 0,0:12:43.05,0:12:44.01,Default,,0,0,0,,Сұраныс
Dialogue: 0,0:12:44.43,0:12:45.47,Default,,0,0,0,,Оны шайқаңыз!
Dialogue: 0,0:12:45.80,0:12:47.47,Default,,0,0,0,,(жылдамдау дыбысы)
Dialogue: 0,0:12:51.60,0:12:52.73,Default,,0,0,0,,Chase! Оны қу!
Dialogue: 0,0:12:55.14,0:12:55.98,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:12:58.52,0:12:59.36,Default,,0,0,0,,Құдай-ай~!
Dialogue: 0,0:13:02.86,0:13:03.69,Default,,0,0,0,,Уф!
Dialogue: 0,0:13:06.36,0:13:07.20,Default,,0,0,0,,
Dialogue: 0,0:13:07.78,0:13:09.20,Default,,0,0,0,,Әрі қарай ұшыңыз!
Dialogue: 0,0:13:09.53,0:13:11.66,Default,,0,0,0,,А... Аман-есен айдау керек...
Dialogue: 0,0:13:11.79,0:13:14.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:14.91,0:13:15.87,Default,,0,0,0,,(сықырлаған дыбыс)
Dialogue: 0,0:13:16.00,0:13:16.83,Default,,0,0,0,,Чи…
Dialogue: 0,0:13:18.79,0:13:20.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:21.09,0:13:21.96,Default,,0,0,0,,Мұны жасамаңыз
Dialogue: 0,0:13:22.09,0:13:22.92,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:13:23.67,0:13:25.22,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:27.18,0:13:28.01,Default,,0,0,0,,Дұрыс дұрыс!
Dialogue: 0,0:13:31.26,0:13:32.47,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:32.60,0:13:35.48,Default,,0,0,0,,Ах, бай адамдар осындай кемені бос уақыттарында пайдаланады —
Dialogue: 0,0:13:36.94,0:13:37.85,Default,,0,0,0,,ағамдай бірге өскен сені—
Dialogue: 0,0:13:37.98,0:13:39.48,Default,,0,0,0,,Солтүстік-солтүстік-шығыс! Солтүстік-солтүстік-шығыс!
Dialogue: 0,0:13:39.77,0:13:42.15,Default,,0,0,0,,Мен қатты апатқа ұшырадым.
Dialogue: 0,0:13:42.27,0:13:44.90,Default,,0,0,0,,Бұл жай ғана «Күйікті» сериалының бір көрінісі.
Dialogue: 0,0:13:45.03,0:13:46.90,Default,,0,0,0,,Сонымен... солай болды...
Dialogue: 0,0:13:47.03,0:13:48.28,Default,,0,0,0,,Мен Тодомен мүмкіндігінше тезірек кездескім келеді—немесе ең болмағанда Мивамен—бірақ
Dialogue: 0,0:13:48.95,0:13:49.87,Default,,0,0,0,,Бірақ бұл Лос-Анджелес полиция департаменті...
Dialogue: 0,0:13:49.99,0:13:52.91,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз жарақат алдыңыз ба? Андерсон
Dialogue: 0,0:13:53.04,0:13:53.87,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:13:54.16,0:13:55.62,Default,,0,0,0,,Мен өліп қала жаздадым!
Dialogue: 0,0:13:56.00,0:13:58.00,Default,,0,0,0,,Сенің мені шындап қуып жүргеніңнен шығар.
Dialogue: 0,0:13:58.12,0:14:01.63,Default,,0,0,0,,Мен мұны шындап іздемесем, қол астындағылар мені күдіктенеді!
Dialogue: 0,0:14:01.75,0:14:03.38,Default,,0,0,0,,Ичижора тоз-тоз болып қалды.
Dialogue: 0,0:14:03.88,0:14:05.46,Default,,0,0,0,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,0:14:05.71,0:14:07.22,Default,,0,0,0,,Мен ақшаны қайтадан аударамын.
Dialogue: 0,0:14:07.34,0:14:10.22,Default,,0,0,0,,Қалағаныңызша Gucci немесе Armani сатып алыңыз
Dialogue: 0,0:14:10.64,0:14:12.39,Default,,0,0,0,,Хун, ол жексұрын адам.
Dialogue: 0,0:14:12.64,0:14:13.47,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:13.60,0:14:16.39,Default,,0,0,0,,Мен түсіндім, сондықтан ол қазірдің өзінде дайындалды ма?
Dialogue: 0,0:14:16.56,0:14:17.39,Default,,0,0,0,,Иә
Dialogue: 0,0:14:17.52,0:14:20.94,Default,,0,0,0,,Жылдар бойы қудым, ұстай алмадым. Әрине.
Dialogue: 0,0:14:21.52,0:14:23.82,Default,,0,0,0,,Лос-Анджелеске сәлем
Dialogue: 0,0:14:30.28,0:14:31.12,Default,,0,0,0,,Хмм… Бұл не өзі!
Dialogue: 0,0:14:37.00,0:14:38.50,Default,,0,0,0,,Жеткізу осында ма?
Dialogue: 0,0:14:38.62,0:14:40.00,Default,,0,0,0,,Иә (есіктің ашылған дыбысы)
Dialogue: 0,0:14:42.38,0:14:43.84,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:14:44.96,0:14:46.13,Default,,0,0,0,,Бұл қай жер?
Dialogue: 0,0:14:47.13,0:14:48.92,Default,,0,0,0,,Бұл сидр зауыты.
Dialogue: 0,0:14:49.17,0:14:50.76,Default,,0,0,0,,Мен сидрді жақсы көремін!
Dialogue: 0,0:14:50.89,0:14:52.09,Default,,0,0,0,,Өткенде
Dialogue: 0,0:14:52.22,0:14:54.22,Default,,0,0,0,,Мен қазір басқа нәрсе жасап жатырмын.
Dialogue: 0,0:14:58.31,0:15:00.69,Default,,0,0,0,,Дәрілік заттарды өңдеу зауыты
Dialogue: 0,0:15:01.23,0:15:03.40,Default,,0,0,0,,Бұл менің жүрегім
Dialogue: 0,0:15:03.69,0:15:04.77,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:15:05.15,0:15:06.90,Default,,0,0,0,,Зауыт бұл айыппұл
Dialogue: 0,0:15:07.03,0:15:09.70,Default,,0,0,0,,Сакура сиқырын көп мөлшерде жасауға болады.
Dialogue: 0,0:15:10.53,0:15:12.20,Default,,0,0,0,,Доктор рецепті...
Dialogue: 0,0:15:12.32,0:15:13.16,Default,,0,0,0,,О
Dialogue: 0,0:15:13.53,0:15:14.99,Default,,0,0,0,,Маған бұл енді керек емес
Dialogue: 0,0:15:15.12,0:15:15.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:16.62,0:15:19.46,Default,,0,0,0,,Лос-Анджелесте мен қамқорлық ететін суши мейрамханасы бар.
Dialogue: 0,0:15:19.58,0:15:21.50,Default,,0,0,0,,Бұл жақсы суши болды.
Dialogue: 0,0:15:21.62,0:15:23.58,Default,,0,0,0,,Шынымен бірінші сортты өнім.
Dialogue: 0,0:15:24.13,0:15:27.46,Default,,0,0,0,,Алайда екі жыл бұрын аспаз өзгерді.
Dialogue: 0,0:15:28.34,0:15:31.18,Default,,0,0,0,,Маған уайымдамау керек, өйткені мен рецептті айтып беремін деді.
Dialogue: 0,0:15:31.38,0:15:32.76,Default,,0,0,0,,Дәмі нашарлаған
Dialogue: 0,0:15:33.14,0:15:35.39,Default,,0,0,0,,Бұл мүлде басқа нәрсе деуге болады.
Dialogue: 0,0:15:35.64,0:15:36.93,Default,,0,0,0,,Осымен.
Dialogue: 0,0:15:37.81,0:15:40.85,Default,,0,0,0,,Бірінші сортты өнімдерді рецепт бойынша жасауға болмайды.
Dialogue: 0,0:15:41.23,0:15:44.56,Default,,0,0,0,,Мұқият оқытпайынша, қоян-қолтық оқыту мүмкін емес.
Dialogue: 0,0:15:45.90,0:15:49.57,Default,,0,0,0,,Doctor Sakura Magic - бұл жоғары деңгейлі өнім, солай емес пе?
Dialogue: 0,0:15:50.07,0:15:50.95,Default,,0,0,0,,...
Dialogue: 0,0:15:51.40,0:15:53.20,Default,,0,0,0,,Сосын жасайсың.
Dialogue: 0,0:15:53.32,0:15:54.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:56.91,0:15:57.74,Default,,0,0,0,,Уф...
Dialogue: 0,0:15:57.87,0:16:01.46,Default,,0,0,0,,Сакура сиқырын осында жасаған сенсің.
Dialogue: 0,0:16:02.67,0:16:04.50,Default,,0,0,0,,Біздің көз алдымызда
Dialogue: 0,0:16:13.72,0:16:16.14,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:17.30,0:16:18.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:19.35,0:16:21.10,Default,,0,0,0,,Балалар, неге...
Dialogue: 0,0:16:22.14,0:16:24.35,Default,,0,0,0,,Эй, сен кімсің?
Dialogue: 0,0:16:26.31,0:16:27.15,Default,,0,0,0,,Tsk
Dialogue: 0,0:16:29.32,0:16:32.03,Default,,0,0,0,,Мен сенің мұнда не істеп жүргеніңді сұрап тұрмын!
Dialogue: 0,0:16:32.15,0:16:34.07,Default,,0,0,0,,Мен жұмыс істеймін.
Dialogue: 0,0:16:34.20,0:16:35.03,Default,,0,0,0,,Не?
Dialogue: 0,0:16:35.16,0:16:36.12,Default,,0,0,0,,(орындық тартылып жатқан дыбыс)
Dialogue: 0,0:16:36.91,0:16:39.16,Default,,0,0,0,,ФБР арнайы агенті
Dialogue: 0,0:16:39.41,0:16:40.70,Default,,0,0,0,,Паула Дикинс
Dialogue: 0,0:16:41.08,0:16:42.79,Default,,0,0,0,,Хмм... Дикинс, иә?
Dialogue: 0,0:16:43.33,0:16:45.54,Default,,0,0,0,,«Бұл» нені білдіреді?
Dialogue: 0,0:16:45.67,0:16:47.75,Default,,0,0,0,,Сіз Николас Морера туралы айттыңыз ба?
Dialogue: 0,0:16:47.88,0:16:50.42,Default,,0,0,0,,Әлде сіз Саймондар отбасын жойдыңыз ба?
Dialogue: 0,0:16:52.17,0:16:54.59,Default,,0,0,0,,Бұдан былай сенің біліксіз орныңда мен сенің орныңды аламын.
Dialogue: 0,0:16:54.72,0:16:56.43,Default,,0,0,0,,Мен жетекшілік етемін.
Dialogue: 0,0:16:56.55,0:16:57.93,Default,,0,0,0,,Мен бұл туралы естіген жоқпын!
Dialogue: 0,0:16:58.43,0:16:59.97,Default,,0,0,0,,Бұл тау менікі!
Dialogue: 0,0:17:00.10,0:17:01.43,Default,,0,0,0,,Біз қабілетсіз емеспіз...
Dialogue: 0,0:17:02.02,0:17:05.44,Default,,0,0,0,,Білмейтін болсаң, неге мені әдейі ұстамайсың?
Dialogue: 0,0:17:05.56,0:17:06.94,Default,,0,0,0,,Инспектор Андерсон
Dialogue: 0,0:17:07.44,0:17:10.19,Default,,0,0,0,,Сіздің вилла мен қызыңыздың шетелде оқуына кеткен шығындар
Dialogue: 0,0:17:10.32,0:17:11.94,Default,,0,0,0,,Ол қайдан пайда болды?
Dialogue: 0,0:17:12.07,0:17:14.70,Default,,0,0,0,,Жақсылап жусаңыз түсінесіз.
Dialogue: 0,0:17:15.82,0:17:19.12,Default,,0,0,0,,Жұмысымнан, отбасымнан айырылып, түрмеге түсемін бе?
Dialogue: 0,0:17:19.24,0:17:22.95,Default,,0,0,0,,Сіз менің қол астымдағы қызметкер болып жұмыс істеп, детектив ретінде мақтанышыңызды қайта аласыз ба?
Dialogue: 0,0:17:23.75,0:17:25.29,Default,,0,0,0,,Таңдау
Dialogue: 0,0:17:26.83,0:17:28.96,Default,,0,0,0,,Ақшаны керемет жасасаң мен саған беремін.
Dialogue: 0,0:17:29.71,0:17:31.75,Default,,0,0,0,,Балалар, жақсылап қараңдар!
Dialogue: 0,0:17:31.88,0:17:33.30,Default,,0,0,0,,Енді бастаңыз.
Dialogue: 0,0:17:36.51,0:17:37.63,Default,,0,0,0,,Хмм... бұл мүмкін емес.
Dialogue: 0,0:17:37.76,0:17:38.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:38.72,0:17:40.30,Default,,0,0,0,,Бір... Өте алмаймын.
Dialogue: 0,0:17:40.68,0:17:43.27,Default,,0,0,0,,Егер үлгере алмасаңыз ше? Не айтқың келеді?
Dialogue: 0,0:17:44.27,0:17:47.94,Default,,0,0,0,,Бұны мұндай лас шеберханада жасауға болмайды!
Dialogue: 0,0:17:48.06,0:17:51.65,Default,,0,0,0,,Бұл лас, ал геодезиялық аспаптар да жақсы емес!
Dialogue: 0,0:17:51.77,0:17:53.28,Default,,0,0,0,,Бұл үлкен мәселе емес.
Dialogue: 0,0:17:53.57,0:17:56.70,Default,,0,0,0,,Сондықтан біз тек сапасыз өнім жасай аламыз!
Dialogue: 0,0:17:56.90,0:17:57.74,Default,,0,0,0,,Не?
Dialogue: 0,0:17:57.86,0:17:58.82,Default,,0,0,0,,Эдди
Dialogue: 0,0:17:59.53,0:18:02.37,Default,,0,0,0,,Сіз ешқашан дәрігердің зертханасын көрген емессіз бе?
Dialogue: 0,0:18:02.49,0:18:05.20,Default,,0,0,0,,Шаңсыз таза жерде
Dialogue: 0,0:18:05.33,0:18:08.37,Default,,0,0,0,,Дәл аспаптар ұқыпты қатарға қойылған
Dialogue: 0,0:18:08.87,0:18:10.13,Default,,0,0,0,,Иа (Эбби) Хмм!
Dialogue: 0,0:18:10.54,0:18:11.96,Default,,0,0,0,,Бұл операция бөлмесі сияқты.
Dialogue: 0,0:18:12.09,0:18:13.88,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:18:14.00,0:18:16.09,Default,,0,0,0,,Әрбір бұйым қолдан жасалған.
Dialogue: 0,0:18:16.47,0:18:19.09,Default,,0,0,0,,Бұл шынымен де, өте нәзік жұмыс.
Dialogue: 0,0:18:19.22,0:18:21.89,Default,,0,0,0,,Сіз жапондық суши аспаздары туралы фильм көрдіңіз бе?
Dialogue: 0,0:18:22.01,0:18:23.31,Default,,0,0,0,,Бұл өте нәзік болды!
Dialogue: 0,0:18:23.43,0:18:25.22,Default,,0,0,0,,Эбби, үндеме.
Dialogue: 0,0:18:25.43,0:18:29.39,Default,,0,0,0,,Дұрыс! Жапондықтар өте сезімтал.
Dialogue: 0,0:18:29.52,0:18:31.40,Default,,0,0,0,,Шағын бөлмеде жақсы.
Dialogue: 0,0:18:31.52,0:18:33.98,Default,,0,0,0,,Мен нашар бөлмеге шыдай алмаймын.
Dialogue: 0,0:18:34.11,0:18:34.94,Default,,0,0,0,,Басқаша айтқанда?
Dialogue: 0,0:18:35.44,0:18:39.45,Default,,0,0,0,,Мен өз зертханамсыз Сакура Сиқырын жасай алмаймын.
Dialogue: 0,0:18:39.57,0:18:40.78,Default,,0,0,0,,Менің ойымша, сіз мұны айтқыңыз келеді
Dialogue: 0,0:18:41.62,0:18:42.49,Default,,0,0,0,,Хмм…
Dialogue: 0,0:18:43.58,0:18:45.37,Default,,0,0,0,,Бұл жаман болды, доктор.
Dialogue: 0,0:18:46.08,0:18:49.21,Default,,0,0,0,,Ол шедеврді мұнда жасай алмайтының рас.
Dialogue: 0,0:18:50.17,0:18:52.38,Default,,0,0,0,,Түсінгеніңізге қуаныштымын.
Dialogue: 0,0:18:52.79,0:18:54.21,Default,,0,0,0,,Жаңартайық
Dialogue: 0,0:18:54.96,0:18:55.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:55.92,0:18:57.71,Default,,0,0,0,,Жөндеу!
Dialogue: 0,0:18:58.92,0:19:01.05,Default,,0,0,0,,Барлық аспаптар мен аспаптарды ауыстырыңыз!
Dialogue: 0,0:19:02.26,0:19:06.01,Default,,0,0,0,,Бұл жерді дәл зертханаңыз сияқты қайта тұрғызыңыз!
Dialogue: 0,0:19:06.14,0:19:07.31,Default,,0,0,0,,Уау...
Dialogue: 0,0:19:07.93,0:19:09.06,Default,,0,0,0,,Ынтымақтастық
Dialogue: 0,0:19:09.18,0:19:10.35,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:19:12.69,0:19:16.69,Default,,0,0,0,,Егер сіз Кассаноны тұтқындасаңыз, мен сізге несие беремін.
Dialogue: 0,0:19:17.32,0:19:18.65,Default,,0,0,0,,Біздің мақсатымыз
Dialogue: 0,0:19:18.78,0:19:22.70,Default,,0,0,0,,Лоран Тьерри тобының халықаралық алаяқтық тобы
Dialogue: 0,0:19:23.20,0:19:24.95,Default,,0,0,0,,Азиядан шыққандар да кездеседі
Dialogue: 0,0:19:25.58,0:19:28.12,Default,,0,0,0,,Жапондық Масато Эдамура
Dialogue: 0,0:19:28.25,0:19:30.08,Default,,0,0,0,,Жапонияда алаяқтық үшін бұрын сотталған
Dialogue: 0,0:19:31.04,0:19:32.58,Default,,0,0,0,,Лоран жұмысқа алды
Dialogue: 0,0:19:32.71,0:19:35.21,Default,,0,0,0,,Кассаноны алдап жатқан сияқты.
Dialogue: 0,0:19:35.75,0:19:37.50,Default,,0,0,0,,Біз мұны қолданамыз
Dialogue: 0,0:19:37.63,0:19:39.42,Default,,0,0,0,,Лоран тобы және Кассано отбасы
Dialogue: 0,0:19:39.55,0:19:41.22,Default,,0,0,0,,Барлығын бірден өлтіріңіз
Dialogue: 0,0:19:42.84,0:19:44.51,Default,,0,0,0,,LAPD! Сіздің жауабыңыз қандай?
Dialogue: 0,0:19:44.64,0:19:45.47,Default,,0,0,0,,Иә!
Dialogue: 0,0:19:46.56,0:19:49.22,Default,,0,0,0,,Дәрігер, мен сенің қалағаныңды істеймін.
Dialogue: 0,0:19:49.35,0:19:50.43,Default,,0,0,0,,Маған бірдеңе айтыңыз
Dialogue: 0,0:19:51.19,0:19:54.15,Default,,0,0,0,,Жөндеу біткенше маған қамқор бол, жарай ма?
Dialogue: 0,0:19:54.27,0:19:55.11,Default,,0,0,0,,Иә
Dialogue: 0,0:19:55.23,0:19:56.77,Default,,0,0,0,,Жоқ... Жоқ, маған бәрібір...
Dialogue: 0,0:19:57.48,0:19:59.19,Default,,0,0,0,,Ха, ұстанба.
Dialogue: 0,0:19:59.32,0:20:01.53,Default,,0,0,0,,Салазардың үйінде бол.
Dialogue: 0,0:20:01.65,0:20:02.49,Default,,0,0,0,,Үйде тұру?
Dialogue: 0,0:20:02.91,0:20:05.07,Default,,0,0,0,,Дәрігер менімен бір қонақүйде тұра алады.
Dialogue: 0,0:20:05.20,0:20:07.45,Default,,0,0,0,,Иә, қонақүйде.
Dialogue: 0,0:20:07.62,0:20:09.04,Default,,0,0,0,,Маңызды қонақ
Dialogue: 0,0:20:09.16,0:20:11.66,Default,,0,0,0,,Мен сені қонақүйде қалдыра алмаймын.
Dialogue: 0,0:20:12.50,0:20:14.96,Default,,0,0,0,,24 сағат Ешқандай қолайсыздық тудырмаңыз
Dialogue: 0,0:20:15.08,0:20:16.75,Default,,0,0,0,,Иә, оны маған қалдырыңыз.
Dialogue: 0,0:20:16.88,0:20:19.05,Default,,0,0,0,,Жоқ, жоқ, жоқ, бәрі жақсы!
Dialogue: 0,0:20:19.17,0:20:20.96,Default,,0,0,0,,Өте жақсы!
Dialogue: 0,0:20:25.01,0:20:26.51,Default,,0,0,0,,Мына төсекті пайдаланыңыз
Dialogue: 0,0:20:28.18,0:20:30.02,Default,,0,0,0,,Мен төменгі қабаттағы диванда ұйықтаймын
Dialogue: 0,0:20:30.35,0:20:33.98,Default,,0,0,0,,Сіз душты пайдалана аласыз, бірақ температураны басқара алмайсыз.
Dialogue: 0,0:20:34.90,0:20:37.15,Default,,0,0,0,,Бөлмедегі заттарды рұқсатсыз ұстамаңыз
Dialogue: 0,0:20:37.86,0:20:38.69,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:20:40.23,0:20:41.07,Default,,0,0,0,,Хаа…
Dialogue: 0,0:20:41.19,0:20:42.03,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:43.15,0:20:44.20,Default,,0,0,0,,Мынаны киіңіз
Dialogue: 0,0:20:45.57,0:20:46.41,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:20:48.08,0:20:49.62,Default,,0,0,0,,Бұл ең нашар...
Dialogue: 0,0:20:51.08,0:20:57.08,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.40,0:22:50.41,Default,,0,0,0,,~♪
Dialogue: 0,0:22:51.91,0:22:57.91,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory