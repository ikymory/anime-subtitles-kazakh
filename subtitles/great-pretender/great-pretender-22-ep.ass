Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:22.02,0:00:23.06,Default,,0,0,0,,(кранды жабу дыбысы)
Dialogue: 0,0:00:30.03,0:00:31.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:31.05,0:00:35.04,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:00:55.01,0:00:56.00,Default,,0,0,0,,(Бұрылу тетігінің дыбысы)
Dialogue: 0,0:01:13.04,0:01:15.03,Default,,0,0,0,,〈Келесіздер ме?〉
Dialogue: 0,0:01:16.04,0:01:22.04,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:14.08,0:02:20.08,Default,,0,0,0,,~♪
Dialogue: 0,0:02:26.03,0:02:28.01,Default,,0,0,0,,〈Жергілікті жерде не болып жатыр? 〉
Dialogue: 0,0:02:31.09,0:02:34.03,Default,,0,0,0,,〈Әрине олардың аяқ астындағы еден де жақсы жабылған〉
Dialogue: 0,0:02:34.09,0:02:38.05,Default,,0,0,0,,〈Сізге белгі беру жеткілікті, олар дереу ішке кіреді〉
Dialogue: 0,0:02:39.07,0:02:40.06,Default,,0,0,0,,〈Жақсы〉
Dialogue: 0,0:02:40.07,0:02:42.02,Default,,0,0,0,,<Бұл сақинадағы сарысу қандай? 〉
Dialogue: 0,0:02:46.02,0:02:48.06,Default,,0,0,0,,〈Ол жерге жеткенде〉
Dialogue: 0,0:02:48.07,0:02:50.00,Default,,0,0,0,,〈Сізге алкоголь ұсынса да, оған қол тигізбеңіз〉
Dialogue: 0,0:03:03.03,0:03:05.04,Default,,0,0,0,,(құстардың сайрауы)
Dialogue: 0,0:03:06.04,0:03:08.03,Default,,0,0,0,,Иә, иә, түсіндім.
Dialogue: 0,0:03:09.04,0:03:12.09,Default,,0,0,0,,Төраға 100 миллиард сіздің есептік жазбаңызда дайын.
Dialogue: 0,0:03:13.06,0:03:14.06,Default,,0,0,0,,Лю және басқалары ше?
Dialogue: 0,0:03:14.07,0:03:16.01,Default,,0,0,0,,Токиоға бару
Dialogue: 0,0:03:16.07,0:03:19.05,Default,,0,0,0,,Бірақ түн ортасында мәміле дегеніміз не?
Dialogue: 0,0:03:20.04,0:03:22.05,Default,,0,0,0,,(қол қою дыбысы)
Dialogue: 0,0:03:24.02,0:03:25.05,Default,,0,0,0,,Олар түнгі үкілер.
Dialogue: 0,0:03:28.00,0:03:31.05,Default,,0,0,0,,Мен бұршақты қайтадан ауыстырып көрдім, бірақ бұл менің дәміме сәйкес келетінін білмеймін.
Dialogue: 0,0:03:37.03,0:03:41.00,Default,,0,0,0,,Шынымды айтсам, мен ешқашан кофе ішкен емеспін.
Dialogue: 0,0:03:41.04,0:03:42.02,Default,,0,0,0,,Е...
Dialogue: 0,0:03:42.05,0:03:44.09,Default,,0,0,0,,Бірақ жасағандарың дәмді болады.
Dialogue: 0,0:03:45.05,0:03:47.01,Default,,0,0,0,,Мен сені ұната бастадым
Dialogue: 0,0:04:16.03,0:04:17.04,Default,,0,0,0,,Мен өзімді мазасыз сезінемін.
Dialogue: 0,0:04:23.03,0:04:25.00,Default,,0,0,0,,Нақтысын сақтамайсың ба?
Dialogue: 0,0:04:25.05,0:04:27.08,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:04:28.06,0:04:30.08,Default,,0,0,0,,Тірі заттар өледі.
Dialogue: 0,0:04:35.08,0:04:37.06,Default,,0,0,0,,Осы тапсырманы орындағаннан кейін
Dialogue: 0,0:04:37.08,0:04:39.04,Default,,0,0,0,,Менің рөлім аяқталды.
Dialogue: 0,0:04:39.06,0:04:40.05,Default,,0,0,0,,Е...
Dialogue: 0,0:04:42.01,0:04:43.05,Default,,0,0,0,,Мм, мм
Dialogue: 0,0:04:44.06,0:04:46.04,Default,,0,0,0,,Мен тыныш өмір сүргім келеді
Dialogue: 0,0:04:48.04,0:04:50.03,Default,,0,0,0,,Менің қасымда қаласың ба?
Dialogue: 0,0:04:53.05,0:04:55.07,Default,,0,0,0,,Ойнайық
Dialogue: 0,0:04:57.00,0:04:58.01,Default,,0,0,0,,Бұл туралы алаңдамаңыз
Dialogue: 0,0:05:15.01,0:05:16.01,Default,,0,0,0,,Қан жарылысы!
Dialogue: 0,0:05:16.06,0:05:18.08,Default,,0,0,0,,Жол көп, сондықтан
Dialogue: 0,0:05:18.09,0:05:21.01,Default,,0,0,0,,Мен оны жарлық арқылы жіберемін
Dialogue: 0,0:05:41.05,0:05:42.06,Default,,0,0,0,,Міне осылай
Dialogue: 0,0:05:50.01,0:05:51.08,Default,,0,0,0,,Мен қобалжыдым.
Dialogue: 0,0:05:51.09,0:05:54.04,Default,,0,0,0,,Өзіңізді көрсететін бірдеңе болғаныңызға қуаныштымын.
Dialogue: 0,0:05:54.05,0:05:55.03,Default,,0,0,0,,Хехехе
Dialogue: 0,0:05:55.05,0:05:57.04,Default,,0,0,0,,Ол мұны дұрыс орындай ма?
Dialogue: 0,0:05:58.00,0:06:01.03,Default,,0,0,0,,Ха... Мен оның бірдеңе жасайтынына сенімдімін.
Dialogue: 0,0:06:02.01,0:06:03.00,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:06:03.08,0:06:05.00,Default,,0,0,0,,Мен мұны істегенді жөн көремін
Dialogue: 0,0:06:05.01,0:06:07.01,Default,,0,0,0,,Бұл Лоран емес пе?
Dialogue: 0,0:06:07.06,0:06:08.06,Default,,0,0,0,,Ойланып көрейікші
Dialogue: 0,0:06:08.08,0:06:10.06,Default,,0,0,0,,Мен сізге кеше қоңырау шалдым.
Dialogue: 0,0:06:10.08,0:06:13.03,Default,,0,0,0,,Әдеттегі қызықсыз әзілдер болған жоқ.
Dialogue: 0,0:06:13.08,0:06:15.09,Default,,0,0,0,,Мен кек алуға қалай қарсы тұра аламын?
Dialogue: 0,0:06:16.00,0:06:17.00,Default,,0,0,0,,Мен мұны істей алмас едім.
Dialogue: 0,0:06:18.05,0:06:21.07,Default,,0,0,0,,Мен соңына дейін қажетсіз ештеңе істеудің қажеті жоқ.
Dialogue: 0,0:06:21.09,0:06:24.05,Default,,0,0,0,,Іс бұзылса, бәрі жақсы.
Dialogue: 0,0:06:25.00,0:06:27.00,Default,,0,0,0,,Бұл уақыт.
Dialogue: 0,0:06:27.02,0:06:30.00,Default,,0,0,0,,Иә, бұл да рас. (Эби) О.
Dialogue: 0,0:06:30.06,0:06:33.00,Default,,0,0,0,,Олай болса, бәріміз жоспарлағандай орындаңдар!
Dialogue: 0,0:06:33.01,0:06:34.01,Default,,0,0,0,,О!
Dialogue: 0,0:06:34.02,0:06:35.01,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:06:41.00,0:06:43.00,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:06:43.01,0:06:44.01,Default,,0,0,0,,Қауіпсіздік
Dialogue: 0,0:06:44.03,0:06:46.02,Default,,0,0,0,,Біз денені тексереміз.
Dialogue: 0,0:06:51.03,0:06:52.02,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:07:00.08,0:07:01.07,Default,,0,0,0,,Бұл — Они руының салты—
Dialogue: 0,0:07:09.03,0:07:11.03,Default,,0,0,0,,Эдамура мырза, сіз ше?
Dialogue: 0,0:07:12.02,0:07:13.04,Default,,0,0,0,,Қауіпті жүктер жоқ
Dialogue: 0,0:07:14.00,0:07:14.50,Default,,0,0,0,,Ішінде не бар?
Dialogue: 0,0:07:15.02,0:07:16.07,Default,,0,0,0,,Бұл бағалы қағаздардың бір түрі.
Dialogue: 0,0:07:16.09,0:07:19.02,Default,,0,0,0,,Бұл компанияны беріп жатқаныңызды білдіре ме?
Dialogue: 0,0:07:20.06,0:07:22.01,Default,,0,0,0,,Мен сен демалыс үйін сатып аламыз дедің деп анық естідім.
Dialogue: 0,0:07:25.01,0:07:27.01,Default,,0,0,0,,<Қабырғаларды неге қайта бояйсың? 〉
Dialogue: 0,0:07:27.04,0:07:29.05,Default,,0,0,0,,〈Түпнұсқа өте нашар күйде болуы мүмкін.〉
Dialogue: 0,0:07:32.07,0:07:34.04,Default,,0,0,0,,(электрондық құлыпты ашу дыбысы)
Dialogue: 0,0:07:34.09,0:07:37.02,Default,,0,0,0,,Ішке тек үш адам ғана кіреді.
Dialogue: 0,0:07:37.05,0:07:39.07,Default,,0,0,0,,〈Үшеуміз ғана ішке кіреміз〉
Dialogue: 0,0:07:41.04,0:07:42.05,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:07:42.06,0:07:44.00,Default,,0,0,0,,Мен сені алып келдім
Dialogue: 0,0:07:55.08,0:07:57.03,Default,,0,0,0,,(Электрондық құлыпты құлыптау дыбысы)
Dialogue: 0,0:08:02.04,0:08:04.01,Default,,0,0,0,,Сені көргеніме қуаныштымын, Лю
Dialogue: 0,0:08:31.02,0:08:32.00,Default,,0,0,0,,Фу…
Dialogue: 0,0:08:33.00,0:08:34.05,Default,,0,0,0,,〈Кешіріңіз〉
Dialogue: 0,0:08:35.00,0:08:35.50,Default,,0,0,0,,Отырыңыз.
Dialogue: 0,0:08:49.05,0:08:53.04,Default,,0,0,0,,Сіз біздің компанияны 100 миллиард иенге сатып алғыңыз келеді деп естідім.
Dialogue: 0,0:08:54.00,0:08:55.06,Default,,0,0,0,,Ә, қысқа үзіліс жасайық па?
Dialogue: 0,0:08:57.09,0:08:58.07,Default,,0,0,0,,〈Иә〉
Dialogue: 0,0:08:58.08,0:08:59.07,Default,,0,0,0,,Ишигами
Dialogue: 0,0:08:59.08,0:09:00.07,Default,,0,0,0,,Га
Dialogue: 0,0:09:08.03,0:09:10.02,Default,,0,0,0,,Енді алыңыз.
Dialogue: 0,0:09:21.08,0:09:23.07,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:09:23.08,0:09:24.09,Default,,0,0,0,,Ол бір мектептің формасын киген екен.
Dialogue: 0,0:09:26.06,0:09:28.05,Default,,0,0,0,,Masato What do you mean?
Dialogue: 0,0:09:29.00,0:09:31.01,Default,,0,0,0,,<Laurent, what's going on? 〉
Dialogue: 0,0:09:33.00,0:09:34.00,Default,,0,0,0,,Масато
Dialogue: 0,0:09:35.04,0:09:36.07,Default,,0,0,0,,<Laurent! 〉
Dialogue: 0,0:09:38.03,0:09:39.02,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:09:39.03,0:09:40.04,Default,,0,0,0,,Бұл елордалық полиция департаменті!
Dialogue: 0,0:09:40.05,0:09:42.03,Default,,0,0,0,,Барлығы, қозғалмаңдар!
Dialogue: 0,0:09:43.02,0:09:44.05,Default,,0,0,0,,<Жақсы болдыңыз ба? 〉
Dialogue: 0,0:09:48.00,0:09:50.09,Default,,0,0,0,,Raid on suspicion of human trafficking
Dialogue: 0,0:09:51.06,0:09:54.08,Default,,0,0,0,,Барлығыңыз, қолдарыңызды көтеріп, бастарыңыздың артына қойыңыздар!
Dialogue: 0,0:09:54.09,0:09:55.08,Default,,0,0,0,,Асығыңыз!
Dialogue: 0,0:09:58.02,0:09:59.05,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:09:59.07,0:10:02.08,Default,,0,0,0,,Кешіріңіз, бірақ мен де сергек емеспін...
Dialogue: 0,0:10:03.01,0:10:04.09,Default,,0,0,0,,This is a check.
Dialogue: 0,0:10:05.02,0:10:07.02,Default,,0,0,0,,Seized as evidence
Dialogue: 0,0:10:07.06,0:10:09.02,Default,,0,0,0,,Please seize that case as well.
Dialogue: 0,0:10:10.09,0:10:12.04,Default,,0,0,0,,〈Hey, wait a minute! 〉
Dialogue: 0,0:10:12.09,0:10:15.03,Default,,0,0,0,,What authority do you have to take it!
Dialogue: 0,0:10:15.04,0:10:16.07,Default,,0,0,0,,Evidence
Dialogue: 0,0:10:16.09,0:10:18.09,Default,,0,0,0,,Тергеуге қатысы болмаса, қайтару
Dialogue: 0,0:10:19.00,0:10:21.03,Default,,0,0,0,,Мұндай нәрседен құтыламын деп ойламаңыз!
Dialogue: 0,0:10:21.09,0:10:24.03,Default,,0,0,0,,Біздің кейбір тұтынушыларымыз полиция басшыларының қатарында!
Dialogue: 0,0:10:24.05,0:10:25.09,Default,,0,0,0,,Әсіресе басқа елдің күшіне сүйенген адамға.
Dialogue: 0,0:10:26.07,0:10:28.07,Default,,0,0,0,,The timing is too good
Dialogue: 0,0:10:35.05,0:10:36.07,Default,,0,0,0,,<Hey! 〉
Dialogue: 0,0:10:36.08,0:10:37.07,Default,,0,0,0,,〈Gah...〉
Dialogue: 0,0:10:39.03,0:10:43.03,Default,,0,0,0,,Liu, your subordinate was a police dog?
Dialogue: 0,0:10:43.04,0:10:44.03,Default,,0,0,0,,Edamame
Dialogue: 0,0:10:45.01,0:10:46.04,Default,,0,0,0,,Түсіндіріңіз.
Dialogue: 0,0:10:52.06,0:10:54.00,Default,,0,0,0,,Edamura…
Dialogue: 0,0:10:54.06,0:10:56.05,Default,,0,0,0,,Хмм… мм…
Dialogue: 0,0:11:06.08,0:11:10.00,Default,,0,0,0,,〈А, бұл да қауіпті, сондықтан оны қолға алғаным жөн.〉
Dialogue: 0,0:11:14.02,0:11:16.03,Default,,0,0,0,,<Take care of yourself! 〉
Dialogue: 0,0:11:17.08,0:11:18.08,Default,,0,0,0,,〈Temee! 〉
Dialogue: 0,0:11:19.02,0:11:20.04,Default,,0,0,0,,<Higii~! 〉
Dialogue: 0,0:11:20.05,0:11:22.09,Default,,0,0,0,,<What... Poison! Poison! 〉
Dialogue: 0,0:11:24.04,0:11:25.06,Default,,0,0,0,,<I'm going to die! I don't want to die...! 〉
Dialogue: 0,0:11:25.06,0:11:27.05,Default,,0,0,0,,<I'm going to die! Менің өлгім келмейді...! 〉 Жасайық
Dialogue: 0,0:11:27.06,0:11:29.03,Default,,0,0,0,,Are you a little sane? Мынадай нәрсе...
Dialogue: 0,0:11:29.04,0:11:30.06,Default,,0,0,0,,Үніңді жауып, қарап тұр.
Dialogue: 0,0:11:31.06,0:11:32.07,Default,,0,0,0,,<Мен... Мен өлемін! 〉
Dialogue: 0,0:11:32.09,0:11:37.03,Default,,0,0,0,,<Чикишо~ Лоран! сен~! 〉
Dialogue: 0,0:11:36.04,0:11:37.03,Default,,0,0,0,,Айтпақшы...
Dialogue: 0,0:11:37.08,0:11:38.08,Default,,0,0,0,,Не? 〉
Dialogue: 0,0:11:39.09,0:11:40.08,Default,,0,0,0,,〈Фуга! 〉
Dialogue: 0,0:11:42.07,0:11:43.06,Default,,0,0,0,,Раббым!
Dialogue: 0,0:11:43.07,0:11:45.04,Default,,0,0,0,,Менімен ұйықтағың келе ме?
Dialogue: 0,0:11:50.03,0:11:52.07,Default,,0,0,0,,Шанхай Лонхубанмен жұмыс
Dialogue: 0,0:11:52.09,0:11:55.00,Default,,0,0,0,,Елордалық полиция департаменті...
Dialogue: 0,0:11:56.02,0:11:58.01,Default,,0,0,0,,Сіздің мақсатыңыз қандай?
Dialogue: 0,0:11:58.05,0:11:59.04,Default,,0,0,0,,Сәлем…
Dialogue: 0,0:11:59.05,0:12:01.00,Default,,0,0,0,,Созаку Әкем!
Dialogue: 0,0:12:01.01,0:12:02.03,Default,,0,0,0,,Оны арқанға сал!
Dialogue: 0,0:12:02.05,0:12:03.04,Default,,0,0,0,,Уф... Уф!
Dialogue: 0,0:12:05.05,0:12:06.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:06.05,0:12:08.04,Default,,0,0,0,,Кір қолдарыңыздан құтылыңыз!
Dialogue: 0,0:12:08.08,0:12:09.07,Default,,0,0,0,,А... а?
Dialogue: 0,0:12:09.08,0:12:10.07,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:12:11.03,0:12:13.02,Default,,0,0,0,,Мен сені қорғаймын
Dialogue: 0,0:12:13.05,0:12:14.04,Default,,0,0,0,,Масато…
Dialogue: 0,0:12:14.06,0:12:15.07,Default,,0,0,0,,Парта артында!
Dialogue: 0,0:12:15.08,0:12:18.00,Default,,0,0,0,,(саусақ ысқырығы)
Dialogue: 0,0:12:19.04,0:12:20.02,Default,,0,0,0,,(кездейсоқ ату дыбысы)
Dialogue: 0,0:12:26.01,0:12:28.00,Default,,0,0,0,,Мынау... бұл не деген жігіттер!
Dialogue: 0,0:12:28.01,0:12:29.09,Default,,0,0,0,,<Бұл сенің отрядың емес пе? 〉
Dialogue: 0,0:12:31.00,0:12:34.07,Default,,0,0,0,,Эй, жалған полиция! Бұл мылтық шынайы
Dialogue: 0,0:12:35.09,0:12:37.08,Default,,0,0,0,,Пайдасыз қарсылықты тоқтату.
Dialogue: 0,0:12:41.07,0:12:43.02,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:12:43.08,0:12:45.02,Default,,0,0,0,,Олар кімдер?
Dialogue: 0,0:12:46.09,0:12:51.06,Default,,0,0,0,,Ха~хаха хахахаха...
Dialogue: 0,0:12:54.02,0:12:56.08,Default,,0,0,0,,Біраз болды, аққұба бейбақ.
Dialogue: 0,0:12:58.00,0:12:58.50,Default,,0,0,0,,Эдди
Dialogue: 0,0:12:59.03,0:13:01.01,Default,,0,0,0,,Сот ұзаққа созылғанымен
Dialogue: 0,0:13:01.02,0:13:03.09,Default,,0,0,0,,Мен ақталып шықтым.
Dialogue: 0,0:13:04.04,0:13:06.00,Default,,0,0,0,,Ақша
Dialogue: 0,0:13:06.04,0:13:07.05,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:13:07.07,0:13:12.07,Default,,0,0,0,,«Корольдік бауырлар», «аукцион», «полицияға басып кіру» және т.б.
Dialogue: 0,0:13:12.08,0:13:16.03,Default,,0,0,0,,Әлі де дөрекі қулыққа толы.
Dialogue: 0,0:13:16.08,0:13:19.06,Default,,0,0,0,,Сэм мен Коулман мұнда келмеді.
Dialogue: 0,0:13:19.09,0:13:21.09,Default,,0,0,0,,«Танысқаныма қуаныштымын».
Dialogue: 0,0:13:24.02,0:13:25.08,Default,,0,0,0,,Мен сізге...
Dialogue: 0,0:13:26.02,0:13:27.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:27.02,0:13:28.01,Default,,0,0,0,,Ей!
Dialogue: 0,0:13:29.02,0:13:30.02,Default,,0,0,0,,Камера?
Dialogue: 0,0:13:30.04,0:13:31.06,Default,,0,0,0,,Маған бір сәт беріңіз.
Dialogue: 0,0:13:32.07,0:13:33.08,Default,,0,0,0,,Бұл сәл ақымақтық емес пе?
Dialogue: 0,0:13:34.02,0:13:36.05,Default,,0,0,0,,Балалар сендер болашақта жамандық жасамауларың үшін.
Dialogue: 0,0:13:36.06,0:13:38.05,Default,,0,0,0,,Мен міндетті түрде суретке түсіремін.
Dialogue: 0,0:13:38.09,0:13:41.04,Default,,0,0,0,,Масато, бұл не?
Dialogue: 0,0:13:41.05,0:13:43.06,Default,,0,0,0,,Неліктен олар әлі тірі?
Dialogue: 0,0:13:44.00,0:13:46.05,Default,,0,0,0,,Бұл халықаралық алаяқтар
Dialogue: 0,0:13:46.09,0:13:50.02,Default,,0,0,0,,Кейінірек кірген адам менің көмекшім болды.
Dialogue: 0,0:13:50.09,0:13:55.00,Default,,0,0,0,,Бұл жолы «үлкен жоспар» сияқты.
Dialogue: 0,0:13:55.02,0:13:56.06,Default,,0,0,0,,<Е... Оз? 〉
Dialogue: 0,0:13:58.09,0:14:00.01,Default,,0,0,0,,Эдамаме
Dialogue: 0,0:14:01.09,0:14:03.02,Default,,0,0,0,,Ха-ха…
Dialogue: 0,0:14:03.05,0:14:06.07,Default,,0,0,0,,Жалғыз адам болып көрінетін қылмыскерлер
Dialogue: 0,0:14:06.08,0:14:09.05,Default,,0,0,0,,Шабдалы Куперчику туралы твиттер жазбаңыз
Dialogue: 0,0:14:10.00,0:14:11.08,Default,,0,0,0,,Ах, Исигами мырза
Dialogue: 0,0:14:11.09,0:14:14.08,Default,,0,0,0,,Артыңыздағы жігіттен чекті қайтарыңыз.
Dialogue: 0,0:14:15.05,0:14:16.06,Default,,0,0,0,,Олардан да істер
Dialogue: 0,0:14:17.00,0:14:18.07,Default,,0,0,0,,Иә? Иә!
Dialogue: 0,0:14:19.06,0:14:20.05,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:14:20.06,0:14:22.06,Default,,0,0,0,,Енді іс...
Dialogue: 0,0:14:23.02,0:14:24.08,Default,,0,0,0,,Ей! Ах...
Dialogue: 0,0:14:26.08,0:14:27.06,Default,,0,0,0,,Мен онымен екеуміз ғана, бір рет болса да сөйлескенді қатты қалаймын. Хехе.
Dialogue: 0,0:14:28.01,0:14:29.04,Default,,0,0,0,,Мен оны қайтарып алдым.
Dialogue: 0,0:14:29.08,0:14:30.09,Default,,0,0,0,,Жарайсың
Dialogue: 0,0:14:31.03,0:14:34.00,Default,,0,0,0,,Төрағаның қалауынша орындаңыз.
Dialogue: 0,0:14:39.03,0:14:41.04,Default,,0,0,0,,Ку...фуфуфу аххахаха
Dialogue: 0,0:14:42.01,0:14:45.08,Default,,0,0,0,,Хахахаха хахахаха!
Dialogue: 0,0:14:46.03,0:14:47.03,Default,,0,0,0,,Иә!
Dialogue: 0,0:14:48.00,0:14:51.03,Default,,0,0,0,,Мен аққұба бейбақты жеңдім!
Dialogue: 0,0:14:52.07,0:14:57.07,Default,,0,0,0,,Пуу Ахахахха... Ухахаха!
Dialogue: 0,0:14:57.08,0:14:59.06,Default,,0,0,0,,Кристалда жарық жүздеген миллион рет шағылады—
Dialogue: 0,0:14:59.07,0:15:01.06,Default,,0,0,0,,ештеңе көрінбейді, иә?
Dialogue: 0,0:15:01.08,0:15:02.06,Default,,0,0,0,,Масато
Dialogue: 0,0:15:03.02,0:15:04.09,Default,,0,0,0,,Ух... ха...
Dialogue: 0,0:15:05.00,0:15:05.50,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:06.03,0:15:08.06,Default,,0,0,0,,Бұл фарсты қашанға дейін ойнаймыз?
Dialogue: 0,0:15:09.06,0:15:11.01,Default,,0,0,0,,Бұл фарс па?
Dialogue: 0,0:15:11.06,0:15:13.07,Default,,0,0,0,,Сіз қаншалықты байыпты әрекет етсеңіз де
Dialogue: 0,0:15:13.08,0:15:16.08,Default,,0,0,0,,Шулы! Өзің білетіндей әрекет жасама!
Dialogue: 0,0:15:17.04,0:15:21.08,Default,,0,0,0,,Қалағаныңды айт! Мені де, анамды да тастап кеткен сенсің!
Dialogue: 0,0:15:22.00,0:15:25.04,Default,,0,0,0,,Апамды баққан мен едім!
Dialogue: 0,0:15:26.03,0:15:30.05,Default,,0,0,0,,Сіз сасық тамақ жеп жатқанда мен өзімді қаншалықты жалғыз сезіндім деп ойлайсыз?
Dialogue: 0,0:15:30.07,0:15:32.00,Default,,0,0,0,,Сіз түсінбейсіз!
Dialogue: 0,0:15:32.09,0:15:36.08,Default,,0,0,0,,«Мен әкеме сенемін» деп жүрдім!
Dialogue: 0,0:15:37.00,0:15:39.09,Default,,0,0,0,,Сен маған опасыздық жасадың!
Dialogue: 0,0:15:40.06,0:15:42.09,Default,,0,0,0,,Анасы көрде жалғыз
Dialogue: 0,0:15:43.00,0:15:45.03,Default,,0,0,0,,Дороти барлығынан кек алғысы келе ме?
Dialogue: 0,0:15:45.06,0:15:48.03,Default,,0,0,0,,Ол дос емес, жалғыз қасқыр, солай ма?
Dialogue: 0,0:15:48.04,0:15:53.00,Default,,0,0,0,,Бұл ақша, уақыт және отбасы есебінен өте ыңғайлы ұран!
Dialogue: 0,0:15:53.01,0:15:54.05,Default,,0,0,0,,Тек Окуясу мен екеуміз ғана қарт кісінің қайығына барамыз.
Dialogue: 0,0:15:55.02,0:15:57.04,Default,,0,0,0,,Мен фарсты ертерек қалдырдым.
Dialogue: 0,0:15:57.07,0:16:00.08,Default,,0,0,0,,Онда мен саған байыпты екенімді көрсетемін.
Dialogue: 0,0:16:01.08,0:16:04.01,Default,,0,0,0,,Алдымен мен Доротимен о дүниеде қоштасамын.
Dialogue: 0,0:16:04.02,0:16:07.00,Default,,0,0,0,,«Бос сызбалар үшін кешіріңіз».
Dialogue: 0,0:16:07.04,0:16:09.03,Default,,0,0,0,,Осыдан кейін Доротиді өзіңізбен бірге алыңыз.
Dialogue: 0,0:16:09.07,0:16:11.05,Default,,0,0,0,,Анаңнан кешірім сұрау
Dialogue: 0,0:16:14.03,0:16:15.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:15.04,0:16:17.06,Default,,0,0,0,,Эдамаме Сіз мұнымен біттіңіз, солай ма?
Dialogue: 0,0:16:17.08,0:16:19.03,Default,,0,0,0,,Бұл аяқталмайды!
Dialogue: 0,0:16:20.00,0:16:21.01,Default,,0,0,0,,Лоран!
Dialogue: 0,0:16:21.02,0:16:24.04,Default,,0,0,0,,Сен адамсың ғой, сені алдаудан ләззат алатын қоқыс!
Dialogue: 0,0:16:24.09,0:16:29.06,Default,,0,0,0,,Сен үшін маңызды адам құрбан болса да, тәубе етпесең, аяғыңды жумайсың!
Dialogue: 0,0:16:29.09,0:16:31.02,Default,,0,0,0,,Сенімді адам?
Dialogue: 0,0:16:31.04,0:16:32.09,Default,,0,0,0,,Хаха, бұл не?
Dialogue: 0,0:16:33.08,0:16:37.02,Default,,0,0,0,,Басқаларды ренжітіп, күлсең де, өзің аздап ренжісең ше?
Dialogue: 0,0:16:37.04,0:16:39.05,Default,,0,0,0,,Қайғылы оқиғаның қаһарманына ұқсайды!
Dialogue: 0,0:16:39.08,0:16:42.00,Default,,0,0,0,,Нарцисистік қылмыскерлер
Dialogue: 0,0:16:42.03,0:16:43.07,Default,,0,0,0,,Асқазан шығып жатыр!
Dialogue: 0,0:16:44.00,0:16:47.07,Default,,0,0,0,,Әрқашан түсініктемесіз қатысады
Dialogue: 0,0:16:48.06,0:16:50.08,Default,,0,0,0,,Мен енді сендерге ерінбеймін!
Dialogue: 0,0:16:51.01,0:16:54.06,Default,,0,0,0,,Бұдан былай сен тек өзіңе сенесің!
Dialogue: 0,0:16:55.08,0:16:56.06,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:57.01,0:16:58.02,Default,,0,0,0,,Эдамаме
Dialogue: 0,0:16:58.04,0:17:02.03,Default,,0,0,0,,Фарс болса да, шынайы сезімдеріңді естігеніме қуаныштымын.
Dialogue: 0,0:17:02.06,0:17:03.07,Default,,0,0,0,,Бірақ
Dialogue: 0,0:17:04.00,0:17:07.01,Default,,0,0,0,,Дәл қазір сен... қалай айтайын...
Dialogue: 0,0:17:07.03,0:17:10.04,Default,,0,0,0,,Әй, қалай қарасаң да сәтсіздік.
Dialogue: 0,0:17:10.05,0:17:13.03,Default,,0,0,0,,Сонда кім сәтсіздікке ұшырады?
Dialogue: 0,0:17:13.07,0:17:14.06,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:15.04,0:17:17.01,Default,,0,0,0,,Tsk! Апыр-ай!
Dialogue: 0,0:17:34.03,0:17:35.03,Default,,0,0,0,,Масато!
Dialogue: 0,0:17:37.05,0:17:38.05,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:41.07,0:17:44.01,Default,,0,0,0,,Жасай бер!
Dialogue: 0,0:17:44.09,0:17:46.08,Default,,0,0,0,,Хя ха ха хо…
Dialogue: 0,0:17:50.03,0:17:51.06,Default,,0,0,0,,Төраға, жүгірейік!
Dialogue: 0,0:17:51.08,0:17:54.03,Default,,0,0,0,,Масато... Масато!
Dialogue: 0,0:17:55.07,0:17:58.03,Default,,0,0,0,,(кездейсоқ ату дыбысы)
Dialogue: 0,0:18:00.09,0:18:03.08,Default,,0,0,0,,(Электрондық құлыпты құлыптау дыбысы)
Dialogue: 0,0:18:04.01,0:18:06.05,Default,,0,0,0,,Неліктен лифт жұмыс істемейді?
Dialogue: 0,0:18:06.06,0:18:08.02,Default,,0,0,0,,Неліктен басқа қызметкерлер жоқ?
Dialogue: 0,0:18:08.04,0:18:09.02,Default,,0,0,0,,Масато…
Dialogue: 0,0:18:09.04,0:18:10.03,Default,,0,0,0,,<Не істеп жатырсың! 〉
Dialogue: 0,0:18:10.04,0:18:11.05,Default,,0,0,0,,<Асығыңыз! 〉
Dialogue: 0,0:18:12.08,0:18:14.04,Default,,0,0,0,,<Сіз бұл асығыс дедіңіз! 〉
Dialogue: 0,0:18:14.05,0:18:15.08,Default,,0,0,0,,Тынш, тыныш бол.
Dialogue: 0,0:18:15.09,0:18:17.03,Default,,0,0,0,,<Қатты! Радио толқыны жоқ па? 〉
Dialogue: 0,0:18:17.04,0:18:18.05,Default,,0,0,0,,<Тыныш! 〉
Dialogue: 0,0:18:18.07,0:18:19.05,Default,,0,0,0,,〈А? 〉
Dialogue: 0,0:18:20.09,0:18:22.04,Default,,0,0,0,,(Камино) Керемет болды, иә? Кеше Эндевор.
Dialogue: 0,0:18:22.06,0:18:23.08,Default,,0,0,0,,<Бірге құлап жатырмыз ба? 〉
Dialogue: 0,0:18:24.00,0:18:25.05,Default,,0,0,0,,Масато!
Dialogue: 0,0:18:26.01,0:18:26.51,Default,,0,0,0,,(электрондық құлыпты ашу дыбысы)
Dialogue: 0,0:18:28.09,0:18:30.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:32.04,0:18:34.02,Default,,0,0,0,,<Ол қайда жоғалып кетті? 〉
Dialogue: 0,0:18:34.04,0:18:36.07,Default,,0,0,0,,Ал чектер туралы не деуге болады? Тіркеу ісі жоқ!
Dialogue: 0,0:18:37.02,0:18:40.01,Default,,0,0,0,,<Ол келесі бөлмеде ме? Сен қайдасың? 〉
Dialogue: 0,0:18:40.02,0:18:41.02,Default,,0,0,0,,Не?
Dialogue: 0,0:18:41.03,0:18:43.06,Default,,0,0,0,,<Қайсысы? Тек солға немесе оңға! 〉
Dialogue: 0,0:18:43.07,0:18:45.03,Default,,0,0,0,,Ах~ Шулы!
Dialogue: 0,0:18:45.04,0:18:47.05,Default,,0,0,0,,Ишигами (Ишигами) Не болып жатыр?
Dialogue: 0,0:18:47.07,0:18:48.07,Default,,0,0,0,,Ишигами! (Ишигами)...Иә!
Dialogue: 0,0:18:49.02,0:18:50.03,Default,,0,0,0,,Мен Архитектуралық дизайн бөлімінен Отомын; сіз маған қоңырау шалған едіңіз.
Dialogue: 0,0:18:50.05,0:18:51.05,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:18:51.08,0:18:52.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:53.09,0:18:54.09,Default,,0,0,0,,Тетік?
Dialogue: 0,0:18:55.00,0:18:56.05,Default,,0,0,0,,Осындай нәрсе болды ма?
Dialogue: 0,0:18:57.03,0:18:58.04,Default,,0,0,0,,Жоқ
Dialogue: 0,0:18:58.09,0:19:00.03,Default,,0,0,0,,А... А, бұл қауіпті...
Dialogue: 0,0:19:03.01,0:19:05.03,Default,,0,0,0,,Иә? (Ишигами) Ах... аа...
Dialogue: 0,0:19:05.04,0:19:07.00,Default,,0,0,0,,〈Ей, балалар, не істеп жатырсыңдар...〉
Dialogue: 0,0:19:07.01,0:19:09.05,Default,,0,0,0,,Міне, осылайша-ақ қырылып қалады!
Dialogue: 0,0:19:14.09,0:19:17.04,Default,,0,0,0,,А... аа... ой...
Dialogue: 0,0:19:18.09,0:19:21.00,Default,,0,0,0,,Уау...
Dialogue: 0,0:19:31.00,0:19:32.04,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:19:33.04,0:19:36.07,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:19:46.05,0:19:50.04,Default,,0,0,0,,Ай!
Dialogue: 0,0:20:20.00,0:20:21.08,Default,,0,0,0,,Сәлем... Сәлем...
Dialogue: 0,0:20:22.00,0:20:22.50,Default,,0,0,0,,Хиккуши!
Dialogue: 0,0:20:24.09,0:20:26.00,Default,,0,0,0,,Әй?
Dialogue: 0,0:20:26.03,0:20:27.08,Default,,0,0,0,,Міне, осылайша-ақ қырылып қалады!
Dialogue: 0,0:20:27.09,0:20:29.03,Default,,0,0,0,,Күт… не?
Dialogue: 0,0:20:29.04,0:20:34.06,Default,,0,0,0,,(сықырлау)
Dialogue: 0,0:20:50.09,0:20:56.09,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.07,0:22:50.07,Default,,0,0,0,,~♪
Dialogue: 0,0:22:51.57,0:22:56.57,Default,,0,0,0,,Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
