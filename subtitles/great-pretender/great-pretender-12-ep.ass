Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.54,0:00:05.75,Default,,0,0,0,,(Қылқаламмен сурет салу дыбысы)
Dialogue: 0,0:00:05.88,0:00:06.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:00:07.38,0:00:08.21,Default,,0,0,0,,(Қылқаламды қою дыбысы)
Dialogue: 0,0:00:11.38,0:00:12.92,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:00:17.30,0:00:22.85,Default,,0,0,0,,(қабығы)
Dialogue: 0,0:00:27.94,0:00:29.11,Default,,0,0,0,,
Dialogue: 0,0:00:31.74,0:00:32.86,Default,,0,0,0,,Әдеттегі
Dialogue: 0,0:00:32.99,0:00:34.57,Default,,0,0,0,,Әдеттегі деген не? (Томас) Иә?
Dialogue: 0,0:00:38.32,0:00:39.53,Default,,0,0,0,,Эспрессо
Dialogue: 0,0:00:39.87,0:00:40.95,Default,,0,0,0,,Жоқ, латте
Dialogue: 0,0:00:41.08,0:00:42.66,Default,,0,0,0,,Капучино емес
Dialogue: 0,0:00:42.79,0:00:45.08,Default,,0,0,0,,Пфффф…
Dialogue: 0,0:00:46.54,0:00:47.50,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:49.46,0:00:55.47,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:47.60,0:01:53.61,Default,,0,0,0,,~♪
Dialogue: 0,0:01:56.28,0:01:59.03,Default,,0,0,0,,Эдвард Кейн «Әйел портреті»
Dialogue: 0,0:01:59.16,0:02:01.62,Default,,0,0,0,,18 ғасырдың соңы No 30
Dialogue: 0,0:02:01.91,0:02:02.87,Default,,0,0,0,,Рамка да арнайы жасалған.
Dialogue: 0,0:02:03.62,0:02:06.58,Default,,0,0,0,,Сақтау жағдайы... Иә, өте жақсы.
Dialogue: 0,0:02:07.62,0:02:08.87,Default,,0,0,0,,£100 000 бастап
Dialogue: 0,0:02:10.67,0:02:11.50,Default,,0,0,0,,110 000
Dialogue: 0,0:02:12.88,0:02:13.71,Default,,0,0,0,,120 000
Dialogue: 0,0:02:15.17,0:02:16.01,Default,,0,0,0,,130 000
Dialogue: 0,0:02:16.92,0:02:17.84,Default,,0,0,0,,14
Dialogue: 0,0:02:17.97,0:02:18.80,Default,,0,0,0,,15
Dialogue: 0,0:02:18.93,0:02:19.76,Default,,0,0,0,,16
Dialogue: 0,0:02:20.22,0:02:21.34,Default,,0,0,0,,17
Dialogue: 0,0:02:21.59,0:02:22.80,Default,,0,0,0,,18
Dialogue: 0,0:02:23.56,0:02:25.22,Default,,0,0,0,,18… Жоқ па?
Dialogue: 0,0:02:25.35,0:02:26.47,Default,,0,0,0,,(Есік ашылған дыбыс) (Recovery Girl) Қарым-қатынас дағдылары
Dialogue: 0,0:02:26.68,0:02:27.52,Default,,0,0,0,,20
Dialogue: 0,0:02:28.10,0:02:29.02,Default,,0,0,0,,200 000 фунт!
Dialogue: 0,0:02:29.14,0:02:29.98,Default,,0,0,0,,Сәтті өтінім!
Dialogue: 0,0:02:30.40,0:02:32.19,Default,,0,0,0,,Хмм…
Dialogue: 0,0:02:32.31,0:02:34.48,Default,,0,0,0,,Келесі бюст Жан Пискарио
Dialogue: 0,0:02:35.07,0:02:37.19,Default,,0,0,0,,Хаа... Хехе (Коулман) "Жырлаған" Қола...
Dialogue: 0,0:02:37.32,0:02:39.03,Default,,0,0,0,,Джеймс Коулман
Dialogue: 0,0:02:39.15,0:02:42.45,Default,,0,0,0,,Ол қазір өнер бизнесіндегі ең қызық адам.
Dialogue: 0,0:02:44.12,0:02:46.70,Default,,0,0,0,,Мен шамамен 80 000 фунт сұрағым келеді.
Dialogue: 0,0:02:47.58,0:02:50.00,Default,,0,0,0,,Кешіріңіз, бірақ мен сіздің өтінішіңізді қабылдамаймын.
Dialogue: 0,0:02:50.12,0:02:51.46,Default,,0,0,0,,Не... не?
Dialogue: 0,0:02:51.96,0:02:53.04,Default,,0,0,0,,Бұл жалғандық
Dialogue: 0,0:02:53.38,0:02:56.59,Default,,0,0,0,,Сен сондай ақымақсың! Мен оны 50 000 фунтқа сатып алдым!
Dialogue: 0,0:02:57.21,0:02:58.05,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:02:58.55,0:03:02.18,Default,,0,0,0,,Егер сіз оны 50 000 деп ойласаңыз, бұл жақсы.
Dialogue: 0,0:03:02.39,0:03:04.85,Default,,0,0,0,,Ғұнды жақсылап күт
Dialogue: 0,0:03:05.68,0:03:09.52,Default,,0,0,0,,Жазба үшін: Мен оны 5 фунтқа да сатып алмас едім.
Dialogue: 0,0:03:10.18,0:03:12.23,Default,,0,0,0,,Бұл шындық па, жоқ па, қарамастан
Dialogue: 0,0:03:12.35,0:03:14.44,Default,,0,0,0,,Коулман танымаған суретшілер
Dialogue: 0,0:03:14.56,0:03:16.94,Default,,0,0,0,,Өнер әлемінде ұзақ өмір сүре алмайтын сияқтысыз.
Dialogue: 0,0:03:19.24,0:03:20.61,Default,,0,0,0,,Коулман мырза (Коулман) Иә?
Dialogue: 0,0:03:21.15,0:03:22.95,Default,,0,0,0,,Мені есіңе түсірмейсің бе?
Dialogue: 0,0:03:23.28,0:03:25.20,Default,,0,0,0,,Париждегі «Лондон қары».
Dialogue: 0,0:03:25.53,0:03:27.16,Default,,0,0,0,,О, сен бе?
Dialogue: 0,0:03:27.45,0:03:29.58,Default,,0,0,0,,Менде тамаша сауда тәжірибесі болды.
Dialogue: 0,0:03:29.75,0:03:34.08,Default,,0,0,0,,Сол дүкенде оның көрегендігін көргенде көзімнен таразы түсті.
Dialogue: 0,0:03:34.42,0:03:36.71,Default,,0,0,0,,Маған сіз үшін жұмыс істеуге рұқсат етіңіз.
Dialogue: 0,0:03:37.34,0:03:39.76,Default,,0,0,0,,Хаха, бұл қызық.
Dialogue: 0,0:03:39.92,0:03:41.30,Default,,0,0,0,,Бірақ біз уақытында келеміз. (Эбби) А...
Dialogue: 0,0:03:41.97,0:03:43.26,Default,,0,0,0,,Мен бәрін істеймін!
Dialogue: 0,0:03:43.51,0:03:45.51,Default,,0,0,0,,Басқа жолмен жүріңіз
Dialogue: 0,0:03:53.14,0:03:54.40,Default,,0,0,0,,Фарра Браун
Dialogue: 0,0:03:54.56,0:03:56.31,Default,,0,0,0,,Әкесі бастаған сән өндіруші.
Dialogue: 0,0:03:56.44,0:03:57.73,Default,,0,0,0,,Екінші буын президенті
Dialogue: 0,0:03:59.69,0:04:02.61,Default,,0,0,0,,Әкемнің барлық байланыстарын мұраға алғанымның арқасында,
Dialogue: 0,0:04:02.74,0:04:05.53,Default,,0,0,0,,Көркем кеңесші Коулманмен байланысқан
Dialogue: 0,0:04:06.41,0:04:10.08,Default,,0,0,0,,Ол оған қомақты ақша жұмсайтын адал тұтынушы.
Dialogue: 0,0:04:10.33,0:04:12.91,Default,,0,0,0,,Ол жәндіктерді қатты жек көретін көрінеді.
Dialogue: 0,0:04:13.04,0:04:17.00,Default,,0,0,0,,Ханым, бағбанның сізге айтары бар сияқты.
Dialogue: 0,0:04:20.00,0:04:21.76,Default,,0,0,0,,Сол бук ағашында
Dialogue: 0,0:04:21.88,0:04:24.88,Default,,0,0,0,,Мұнай қоңыздарының үлкен ошағы болды.
Dialogue: 0,0:04:25.09,0:04:27.22,Default,,0,0,0,,Олар тарақандар ма, әлде термиттер ме?
Dialogue: 0,0:04:27.60,0:04:29.64,Default,,0,0,0,,Бұл қоңыр қоңыз.
Dialogue: 0,0:04:29.76,0:04:32.06,Default,,0,0,0,,Жарайды, бұл зиянкес... көргің келе ме?
Dialogue: 0,0:04:32.64,0:04:34.35,Default,,0,0,0,,Менің ойымша, оны көрмеген дұрыс.
Dialogue: 0,0:04:34.48,0:04:36.69,Default,,0,0,0,,Болды, енді құтыл!
Dialogue: 0,0:04:36.90,0:04:38.82,Default,,0,0,0,,Міне, ақыры келді.
Dialogue: 0,0:04:38.94,0:04:43.44,Default,,0,0,0,,Бұл сіздің үйіңізге кіріп кеткен кішкентай жәндік.
Dialogue: 0,0:04:43.57,0:04:44.65,Default,,0,0,0,,Үй ішінде?
Dialogue: 0,0:04:45.03,0:04:46.74,Default,,0,0,0,,Бұл жәндік ағаш немесе қағаз.
Dialogue: 0,0:04:46.86,0:04:49.08,Default,,0,0,0,,Маған да маталар ұнайды. (2 адам) Бақыт...
Dialogue: 0,0:04:49.87,0:04:50.91,Default,,0,0,0,,Хаа…
Dialogue: 0,0:04:53.83,0:04:54.71,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:04:55.87,0:04:58.04,Default,,0,0,0,,Жарайды, мен мұнда емеспін.
Dialogue: 0,0:04:58.46,0:05:00.30,Default,,0,0,0,,Жуынатын бөлме де жақсы болды.
Dialogue: 0,0:05:01.75,0:05:03.55,Default,,0,0,0,,Бұл барлық бөлмелерді қамтиды ма?
Dialogue: 0,0:05:03.84,0:05:05.38,Default,,0,0,0,,Ах, жақсы істедің.
Dialogue: 0,0:05:06.72,0:05:08.43,Default,,0,0,0,,Сонда біз осылай істейміз
Dialogue: 0,0:05:08.55,0:05:10.35,Default,,0,0,0,,Шот-фактура кейінірек
Dialogue: 0,0:05:10.72,0:05:12.27,Default,,0,0,0,,Күте тұрыңыз (2 адам) Иә?
Dialogue: 0,0:05:13.02,0:05:15.10,Default,,0,0,0,,Ағаш пен мата айттыңыз.
Dialogue: 0,0:05:17.15,0:05:19.11,Default,,0,0,0,,Сіз де кенепті тістейсіз бе?
Dialogue: 0,0:05:24.03,0:05:25.82,Default,,0,0,0,,(мотор дыбысы)
Dialogue: 0,0:05:29.03,0:05:33.04,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:05:35.83,0:05:37.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:39.25,0:05:40.96,Default,,0,0,0,,Мұнда да тексеріңіз.
Dialogue: 0,0:05:42.21,0:05:43.34,Default,,0,0,0,,Иә...
Dialogue: 0,0:05:47.59,0:05:50.34,Default,,0,0,0,,Мен сенің сұлулығыңмен теңесе аламын деп үміттенемін.
Dialogue: 0,0:05:50.47,0:05:52.60,Default,,0,0,0,,Мен бақыттымын! рахмет
Dialogue: 0,0:05:55.89,0:05:57.98,Default,,0,0,0,,Хмм, қалай?
Dialogue: 0,0:05:58.56,0:06:00.61,Default,,0,0,0,,Бұл жерде өте жақсы.
Dialogue: 0,0:06:02.19,0:06:06.49,Default,,0,0,0,,Кешіріңіз, мен сізге қиын сәтте көмектесе алмаймын.
Dialogue: 0,0:06:06.90,0:06:10.03,Default,,0,0,0,,Ал сен мені осындай қымбат заттарды сатып алуға мәжбүрледің.
Dialogue: 0,0:06:11.07,0:06:13.08,Default,,0,0,0,,Жақсы, ол үшін уайымдама.
Dialogue: 0,0:06:13.28,0:06:15.45,Default,,0,0,0,,Мен оны қалағандықтан сатып алып жатырмын.
Dialogue: 0,0:06:16.25,0:06:17.16,Default,,0,0,0,,Рахмет
Dialogue: 0,0:06:17.29,0:06:20.25,Default,,0,0,0,,Мен сіздің мейірімділігіңізге әрқашан ризамын.
Dialogue: 0,0:06:21.33,0:06:25.13,Default,,0,0,0,,Сол шедевр көк жағалылардың қолына түссе,
Dialogue: 0,0:06:25.25,0:06:27.01,Default,,0,0,0,,Ластану
Dialogue: 0,0:06:27.76,0:06:29.34,Default,,0,0,0,,Шынымен де...
Dialogue: 0,0:06:29.97,0:06:34.22,Default,,0,0,0,,Сондықтан мен өнерді сүйетін адамдарда болғанын қалаймын.
Dialogue: 0,0:06:34.35,0:06:35.35,Default,,0,0,0,,Сіз сияқты
Dialogue: 0,0:06:36.22,0:06:38.68,Default,,0,0,0,,Өнерді сүюді кім үйретті
Dialogue: 0,0:06:39.44,0:06:41.60,Default,,0,0,0,,Джеймс сен
Dialogue: 0,0:06:41.81,0:06:42.65,Default,,0,0,0,,Хун
Dialogue: 0,0:06:43.23,0:06:45.65,Default,,0,0,0,,Бұдан былай қоштағыңыз келмейтін сурет
Dialogue: 0,0:06:46.03,0:06:47.28,Default,,0,0,0,,Мен оны сатып аламын
Dialogue: 0,0:06:47.40,0:06:48.69,Default,,0,0,0,,Фара…
Dialogue: 0,0:06:48.82,0:06:49.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:50.24,0:06:51.07,Default,,0,0,0,,(Джунпей) Бірақ мені жек көретін адамдарды өлтіретін түйме болса—
Dialogue: 0,0:06:51.24,0:06:54.12,Default,,0,0,0,,Эй, эй, бұл жақсы бөлік, солай ма?
Dialogue: 0,0:06:54.24,0:06:56.45,Default,,0,0,0,,Әрі - бұл жаман мінез.
Dialogue: 0,0:06:56.99,0:06:59.66,Default,,0,0,0,,Әрине, Колеман және Фарра Браун
Dialogue: 0,0:06:59.79,0:07:01.17,Default,,0,0,0,,Сахна артында қосылған
Dialogue: 0,0:07:02.04,0:07:03.79,Default,,0,0,0,,20 (Коулман) 200 000 фунт!
Dialogue: 0,0:07:03.96,0:07:04.79,Default,,0,0,0,,Сәтті өтінім!
Dialogue: 0,0:07:05.00,0:07:08.38,Default,,0,0,0,,Колеман Фарраға қалаған картинаны сатып алуға мүмкіндік береді.
Dialogue: 0,0:07:08.51,0:07:10.80,Default,,0,0,0,,Мен сізге өзіңізге топтама жасауға рұқсат етемін.
Dialogue: 0,0:07:11.51,0:07:13.39,Default,,0,0,0,,Мен Фарахты аяймын.
Dialogue: 0,0:07:13.51,0:07:17.39,Default,,0,0,0,,Достан артық, ғашықтан кем, әмиян ғана.
Dialogue: 0,0:07:17.52,0:07:20.27,Default,,0,0,0,,Егер сіз жай ғана пайдаланылып жатсаңыз, сіз байқамайсыз.
Dialogue: 0,0:07:20.39,0:07:21.39,Default,,0,0,0,,Ол ақымақ әйел.
Dialogue: 0,0:07:21.89,0:07:25.77,Default,,0,0,0,,Nonnonnon Байқасам да, мен байқамаған сияқтымын.
Dialogue: 0,0:07:25.90,0:07:28.36,Default,,0,0,0,,Әйелдің жүрегі осындай емес пе?
Dialogue: 0,0:07:28.48,0:07:29.32,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:07:29.78,0:07:30.99,Default,,0,0,0,,Әйел жүрегі...
Dialogue: 0,0:07:31.11,0:07:34.03,Default,,0,0,0,,Фарахтың қалаған нәрсесі картина емес.
Dialogue: 0,0:07:34.66,0:07:37.29,Default,,0,0,0,,Эбби түсінбейді деп ойлаймын.
Dialogue: 0,0:07:37.95,0:07:40.75,Default,,0,0,0,,Хмф! Ол аурады! Сен не істеп жатырсың?
Dialogue: 0,0:07:41.79,0:07:43.50,Default,,0,0,0,,Мені қашанға дейін алдайсың?
Dialogue: 0,0:07:44.00,0:07:46.34,Default,,0,0,0,,Өтінемін! маған шындықты айт
Dialogue: 0,0:07:46.50,0:07:48.55,Default,,0,0,0,,Адамдардың жүрегімен ойнағаны сонша...
Dialogue: 0,0:07:48.67,0:07:50.05,Default,,0,0,0,,Иә, жақсы, ә...
Dialogue: 0,0:07:50.17,0:07:52.26,Default,,0,0,0,,Жетер, еңбектеріңізге рахмет.
Dialogue: 0,0:07:56.22,0:07:57.10,Default,,0,0,0,,Хаа…
Dialogue: 0,0:07:57.35,0:07:59.93,Default,,0,0,0,,Бұл дөрекі.
Dialogue: 0,0:08:00.06,0:08:03.44,Default,,0,0,0,,Крис, мен саған бүгін кешке бірдеңе сатып аламын.
Dialogue: 0,0:08:03.56,0:08:04.48,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:08:12.24,0:08:13.95,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:08:21.83,0:08:23.04,Default,,0,0,0,,Әдеттегі
Dialogue: 0,0:08:23.25,0:08:24.08,Default,,0,0,0,,Емдеу
Dialogue: 0,0:08:27.13,0:08:28.04,Default,,0,0,0,,Ум...
Dialogue: 0,0:08:29.92,0:08:31.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:08:32.05,0:08:33.59,Default,,0,0,0,,А... жақсысың ба?
Dialogue: 0,0:08:37.39,0:08:38.22,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:08:40.60,0:08:43.35,Default,,0,0,0,,Сіз менің суретіме үлгі бола аласыз ба?
Dialogue: 0,0:08:45.39,0:08:47.90,Default,,0,0,0,,Басқа адамның көзіне қарап, соны айту керек.
Dialogue: 0,0:08:48.02,0:08:48.86,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:49.27,0:08:50.15,Default,,0,0,0,,Уау
Dialogue: 0,0:08:50.61,0:08:52.82,Default,,0,0,0,,Бірақ қаракөздер маған қарап тұр.
Dialogue: 0,0:08:53.32,0:08:55.03,Default,,0,0,0,,Осы жолы жауап бере аласыз ба?
Dialogue: 0,0:08:55.91,0:08:57.45,Default,,0,0,0,,Қажеті жоқ. Айтқым келетін ешкім жоқ.
Dialogue: 0,0:08:57.57,0:08:58.57,Default,,0,0,0,,Мен Томаспын
Dialogue: 0,0:09:00.49,0:09:01.66,Default,,0,0,0,,Мен Синтиямын
Dialogue: 0,0:09:07.04,0:09:10.42,Default,,0,0,0,,Эй, қазір қандай суретті қалайсың?
Dialogue: 0,0:09:11.09,0:09:12.80,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:09:12.92,0:09:16.43,Default,,0,0,0,,Жоқ, не болса да, тоқтайық...
Dialogue: 0,0:09:16.55,0:09:17.84,Default,,0,0,0,,Айт
Dialogue: 0,0:09:17.97,0:09:21.43,Default,,0,0,0,,Сіз қалайтын сурет түрі мен оны көргім келеді.
Dialogue: 0,0:09:21.97,0:09:25.64,Default,,0,0,0,,Біздің бөлмеге сәйкес суретті таңдағаныңызды қалаймын.
Dialogue: 0,0:09:26.60,0:09:29.69,Default,,0,0,0,,Сен мені еркелетуге шеберсің.
Dialogue: 0,0:09:31.77,0:09:34.40,Default,,0,0,0,,Олай болса, осында көрсетейік.
Dialogue: 0,0:09:34.82,0:09:37.28,Default,,0,0,0,,Хмм, түсіндім.
Dialogue: 0,0:09:37.82,0:09:40.78,Default,,0,0,0,,Мүмкін «Лондондағы қар»?
Dialogue: 0,0:09:42.03,0:09:44.75,Default,,0,0,0,,♪ Фара Фара Фара~
Dialogue: 0,0:09:44.87,0:09:47.00,Default,,0,0,0,,♪ Менің асыл лалагүлім
Dialogue: 0,0:09:47.12,0:09:49.04,Default,,0,0,0,,♪ Фарах~
Dialogue: 0,0:09:50.63,0:09:52.17,Default,,0,0,0,,
Dialogue: 0,0:09:56.84,0:09:57.93,Default,,0,0,0,,Сурет салу
Dialogue: 0,0:09:58.22,0:09:59.39,Default,,0,0,0,,Не? Сонымен...
Dialogue: 0,0:10:00.30,0:10:01.14,Default,,0,0,0,,Сурет салу
Dialogue: 0,0:10:02.01,0:10:02.85,Default,,0,0,0,,Қый!
Dialogue: 0,0:10:03.22,0:10:04.18,Default,,0,0,0,,Сурет
Dialogue: 0,0:10:04.31,0:10:05.14,Default,,0,0,0,,Сурет
Dialogue: 0,0:10:05.35,0:10:06.18,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:10:06.64,0:10:09.10,Default,,0,0,0,,Сен пәксің ғой.
Dialogue: 0,0:10:14.53,0:10:16.07,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:10:16.19,0:10:19.16,Default,,0,0,0,,Мен сізде талант бар деп ойладым.
Dialogue: 0,0:10:19.28,0:10:20.53,Default,,0,0,0,,Сонымен... солай ма?
Dialogue: 0,0:10:20.91,0:10:22.45,Default,,0,0,0,,Жоқ, мен не айта аламын?
Dialogue: 0,0:10:22.58,0:10:25.16,Default,,0,0,0,,Сурет салу қызық емес пе? Ахаха
Dialogue: 0,0:10:27.41,0:10:30.25,Default,,0,0,0,,Жоқ... Мені келуімді өтінді.
Dialogue: 0,0:10:30.37,0:10:31.88,Default,,0,0,0,,Менің тазалауға уақытым жоқ...
Dialogue: 0,0:10:32.42,0:10:34.09,Default,,0,0,0,,Сіз мұны жақсы білесіз.
Dialogue: 0,0:10:34.25,0:10:36.84,Default,,0,0,0,,Бұл көшірме. Сіздің өмір сүру шығындарыңызды қосу үшін.
Dialogue: 0,0:10:36.96,0:10:40.01,Default,,0,0,0,,Кейде мен көшірмелерді базарда сатамын.
Dialogue: 0,0:10:40.97,0:10:42.05,Default,,0,0,0,,Бұл ненің суреті?
Dialogue: 0,0:10:42.47,0:10:44.64,Default,,0,0,0,,Серджио Монтойяның «Сүйісуі».
Dialogue: 0,0:10:44.76,0:10:46.35,Default,,0,0,0,,Бұл көшірме.
Dialogue: 0,0:10:46.47,0:10:48.64,Default,,0,0,0,,Ол мен ең құрметтейтін суретші.
Dialogue: 0,0:10:49.27,0:10:52.10,Default,,0,0,0,,Тек оның картиналарын тамаша көшіру мүмкін емес.
Dialogue: 0,0:10:52.23,0:10:53.36,Default,,0,0,0,,өтіңіз
Dialogue: 0,0:10:53.69,0:10:57.07,Default,,0,0,0,,Қарапайым көрінгенімен, мағынасы терең.
Dialogue: 0,0:10:57.23,0:11:00.40,Default,,0,0,0,,Сіз мені осы суреттегі суретке ұқсайтындықтан шақырдыңыз ба?
Dialogue: 0,0:11:00.95,0:11:04.08,Default,,0,0,0,,А, жоқ, бұл қарапайымырақ себеп.
Dialogue: 0,0:11:04.33,0:11:07.66,Default,,0,0,0,,Мен тоқырауға ұшырадым және жазуыммен ешқандай ілгерілей алмадым.
Dialogue: 0,0:11:09.16,0:11:11.37,Default,,0,0,0,,Бірақ сол кафеде
Dialogue: 0,0:11:11.75,0:11:13.04,Default,,0,0,0,,Мен сені көргенде
Dialogue: 0,0:11:13.17,0:11:15.80,Default,,0,0,0,,Ақырында мен бірдеңе сала алатындай болдым.
Dialogue: 0,0:11:18.92,0:11:21.43,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,0:11:21.72,0:11:22.89,Default,,0,0,0,,Онда отырыңыз
Dialogue: 0,0:11:25.35,0:11:31.35,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:13:26.51,0:13:32.52,Default,,0,0,0,,~♪
Dialogue: 0,0:13:35.98,0:13:37.56,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:13:38.31,0:13:39.27,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:13:39.81,0:13:41.19,Default,,0,0,0,,Бұл қандай ақша?
Dialogue: 0,0:13:41.32,0:13:42.57,Default,,0,0,0,,Маған көмектесіңізші
Dialogue: 0,0:13:42.69,0:13:44.49,Default,,0,0,0,,Ол кісі табанды болды
Dialogue: 0,0:13:45.11,0:13:45.95,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:13:46.86,0:13:49.57,Default,,0,0,0,,Ол менің дүкенімде тұрақты және аңдыушы.
Dialogue: 0,0:13:49.70,0:13:52.03,Default,,0,0,0,,Маған жақындап, әдепсіз сөздерді сыбырлайды.
Dialogue: 0,0:13:52.16,0:13:53.41,Default,,0,0,0,,Жиренішті француз
Dialogue: 0,0:13:54.16,0:13:56.75,Default,,0,0,0,,Сенің мені осындай жерге табанды түрде ертіп бара жатқаныңа сене алар емеспін.
Dialogue: 0,0:13:56.87,0:13:59.83,Default,,0,0,0,,Хмм, мен сіздің құмарлығыңызды түсінемін.
Dialogue: 0,0:14:00.38,0:14:02.67,Default,,0,0,0,,Біреу тентіреп жүрсе, мені мазаламас едім.
Dialogue: 0,0:14:02.88,0:14:04.92,Default,,0,0,0,,Күзетші оны белгілесін
Dialogue: 0,0:14:05.67,0:14:07.55,Default,,0,0,0,,Сіз қатысасыз ба?
Dialogue: 0,0:14:07.84,0:14:10.43,Default,,0,0,0,,Иә, мұғалімнің жұмысын жақыннан көргім келеді.
Dialogue: 0,0:14:11.14,0:14:13.22,Default,,0,0,0,,Мен саған жолыңды өзгерт дедім.
Dialogue: 0,0:14:13.43,0:14:15.93,Default,,0,0,0,,Сіз әлі де аңдумен жұмыс істеп жатырсыз.
Dialogue: 0,0:14:26.44,0:14:29.99,Default,,0,0,0,,Мүмкін бұл жай ғана менің қиялым шығар, бірақ ол әдеттегіден танымал болып көрінеді.
Dialogue: 0,0:14:30.91,0:14:32.58,Default,,0,0,0,,Жоқ, бұл менің қиялым емес.
Dialogue: 0,0:14:33.53,0:14:35.83,Default,,0,0,0,,Менің ойымша, бұл менің теледидар жаңалықтарына шыққаным үшін де.
Dialogue: 0,0:14:35.95,0:14:37.62,Default,,0,0,0,,(аудитория күлкі)
Dialogue: 0,0:14:37.75,0:14:39.08,Default,,0,0,0,,Бейнежазбаны да көрдім
Dialogue: 0,0:14:39.92,0:14:41.25,Default,,0,0,0,,Теледидардағы сурет қорқынышты болды.
Dialogue: 0,0:14:41.38,0:14:44.38,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:14:46.21,0:14:47.34,Default,,0,0,0,,бастайық
Dialogue: 0,0:14:47.46,0:14:53.47,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:15:18.70,0:15:24.71,Default,,0,0,0,,~♪
Dialogue: 0,0:15:25.38,0:15:27.76,Default,,0,0,0,,Көптен күткен, бүгінгі соңғы жұмыс.
Dialogue: 0,0:15:27.88,0:15:31.88,Default,,0,0,0,,
Dialogue: 0,0:15:34.72,0:15:37.39,Default,,0,0,0,,Серхио Монтойя «Лондондағы қар»
Dialogue: 0,0:15:37.51,0:15:39.93,Default,,0,0,0,,1930 ж. № 4
Dialogue: 0,0:15:40.06,0:15:41.44,Default,,0,0,0,,Кітапшаны алып тастаңыз
Dialogue: 0,0:15:42.65,0:15:44.36,Default,,0,0,0,,£10 миллионнан бастап
Dialogue: 0,0:15:45.56,0:15:46.40,Default,,0,0,0,,1100
Dialogue: 0,0:15:47.36,0:15:48.57,Default,,0,0,0,,1200
Dialogue: 0,0:15:49.23,0:15:50.57,Default,,0,0,0,,1500
Dialogue: 0,0:15:51.24,0:15:52.49,Default,,0,0,0,,1600
Dialogue: 0,0:15:52.74,0:15:54.28,Default,,0,0,0,,1650
Dialogue: 0,0:15:54.49,0:15:55.78,Default,,0,0,0,,1700
Dialogue: 0,0:15:56.12,0:15:57.66,Default,,0,0,0,,1750
Dialogue: 0,0:15:58.16,0:15:59.58,Default,,0,0,0,,1800
Dialogue: 0,0:15:59.91,0:16:01.12,Default,,0,0,0,,1850
Dialogue: 0,0:16:02.12,0:16:03.42,Default,,0,0,0,,1900
Dialogue: 0,0:16:03.62,0:16:04.63,Default,,0,0,0,,1950 ж
Dialogue: 0,0:16:05.33,0:16:06.50,Default,,0,0,0,,Біреу бар ма?
Dialogue: 0,0:16:07.46,0:16:08.30,Default,,0,0,0,,20 миллион
Dialogue: 0,0:16:08.96,0:16:10.05,Default,,0,0,0,,Жоқ, солай ма?
Dialogue: 0,0:16:11.51,0:16:12.34,Default,,0,0,0,,22 миллион
Dialogue: 0,0:16:12.72,0:16:14.05,Default,,0,0,0,,22 миллионға сәтті өтінім...
Dialogue: 0,0:16:14.18,0:16:15.43,Default,,0,0,0,,23 миллион
Dialogue: 0,0:16:15.55,0:16:16.55,Default,,0,0,0,,А...
Dialogue: 0,0:16:17.10,0:16:17.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:21.73,0:16:23.14,Default,,0,0,0,,2300
Dialogue: 0,0:16:24.69,0:16:25.69,Default,,0,0,0,,2400
Dialogue: 0,0:16:26.27,0:16:27.52,Default,,0,0,0,,Сәтті өтінім... (Лоран) 25 миллион
Dialogue: 0,0:16:27.65,0:16:29.44,Default,,0,0,0,,Не!
Dialogue: 0,0:16:29.57,0:16:31.07,Default,,0,0,0,,25 миллион.
Dialogue: 0,0:16:33.90,0:16:35.03,Default,,0,0,0,,25 миллион
Dialogue: 0,0:16:35.66,0:16:38.28,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:16:41.50,0:16:42.91,Default,,0,0,0,,2600… (Лоран) 30 миллион
Dialogue: 0,0:16:43.04,0:16:46.75,Default,,0,0,0,,
Dialogue: 0,0:16:46.88,0:16:48.29,Default,,0,0,0,,30 миллион
Dialogue: 0,0:16:48.42,0:16:50.42,Default,,0,0,0,,Сіз көп нәрсені ала аласыз.
Dialogue: 0,0:16:50.55,0:16:51.51,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:16:52.46,0:16:54.05,Default,,0,0,0,,Шығу туралы не айтасыз?
Dialogue: 0,0:16:55.26,0:16:56.18,Default,,0,0,0,,Тоқтаңыз.
Dialogue: 0,0:16:58.47,0:17:01.64,Default,,0,0,0,,Мен Монтойяның картиналарын жақсы көремін.
Dialogue: 0,0:17:01.97,0:17:03.89,Default,,0,0,0,,Уақыт келді емес пе?
Dialogue: 0,0:17:04.31,0:17:07.90,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:17:08.36,0:17:10.57,Default,,0,0,0,,Сәтті өтінім! (Қуаныш пен шапалақтау)
Dialogue: 0,0:17:10.69,0:17:11.73,Default,,0,0,0,,Замаа...
Dialogue: 0,0:17:13.74,0:17:14.61,Default,,0,0,0,,Фарах!
Dialogue: 0,0:17:15.45,0:17:16.78,Default,,0,0,0,,Фарра! Неліктен?
Dialogue: 0,0:17:17.74,0:17:19.07,Default,,0,0,0,,Неліктен бас тарттыңыз?
Dialogue: 0,0:17:19.20,0:17:20.91,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:17:21.04,0:17:23.91,Default,,0,0,0,,Егер менде сіздің активтеріңіз болса, ештеңе маңызды болмас еді!
Dialogue: 0,0:17:24.04,0:17:26.67,Default,,0,0,0,,Сол сурет одан сайын құнды бола береді!
Dialogue: 0,0:17:27.25,0:17:29.63,Default,,0,0,0,,Мен сіздің өнер жөніндегі кеңесшіңізмін
Dialogue: 0,0:17:29.75,0:17:32.76,Default,,0,0,0,,Сондықтан мен активтерді қалыптастыру туралы бірнеше сөз айтқым келеді.
Dialogue: 0,0:17:32.88,0:17:33.71,Default,,0,0,0,,Жарайды ма?
Dialogue: 0,0:17:33.84,0:17:37.51,Default,,0,0,0,,Бірінші сортты өнімдердің құны уақыт өткен сайын артады.
Dialogue: 0,0:17:37.63,0:17:39.09,Default,,0,0,0,,Ол көтеріледі!
Dialogue: 0,0:17:39.80,0:17:42.01,Default,,0,0,0,,Мен неге білмеймін!
Dialogue: 0,0:17:42.97,0:17:44.18,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:17:44.31,0:17:45.68,Default,,0,0,0,,Мен бірдеңе істеймін...
Dialogue: 0,0:17:46.10,0:17:47.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:17:47.94,0:17:49.02,Default,,0,0,0,,Бұл жәндік емес.
Dialogue: 0,0:17:49.15,0:17:51.77,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:17:52.27,0:17:55.82,Default,,0,0,0,,Сол аққұба бейбақ кім екенін тезірек тауып ал.
Dialogue: 0,0:17:56.15,0:17:56.99,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:05.00,0:18:07.00,Default,,0,0,0,,Мен үшін жұмыс істегіңіз келе ме?
Dialogue: 0,0:18:07.12,0:18:07.96,Default,,0,0,0,,Иә
Dialogue: 0,0:18:08.08,0:18:09.54,Default,,0,0,0,,Сіз бірдеңе істейсіз бе? (Эби) Иә.
Dialogue: 0,0:18:10.50,0:18:11.79,Default,,0,0,0,,Менің кеудеме кір
Dialogue: 0,0:18:12.25,0:18:13.59,Default,,0,0,0,,Қалтаға
Dialogue: 0,0:18:14.25,0:18:15.42,Default,,0,0,0,,Тамаша жұмыс
Dialogue: 0,0:18:17.09,0:18:19.18,Default,,0,0,0,,Хмм, Монтойя күткендей.
Dialogue: 0,0:18:19.59,0:18:21.26,Default,,0,0,0,,Бұл әдемі~
Dialogue: 0,0:18:21.39,0:18:22.22,Default,,0,0,0,,Мен мұны жиі айтамын.
Dialogue: 0,0:18:22.89,0:18:24.06,Default,,0,0,0,,Дадомо Синтия
Dialogue: 0,0:18:24.77,0:18:28.10,Default,,0,0,0,,Жай ғана төмен баға беру дегенді қалай түсінесіңдер?
Dialogue: 0,0:18:28.44,0:18:30.85,Default,,0,0,0,,Сен сонша ақшаны қайдан алдың?
Dialogue: 0,0:18:31.06,0:18:34.27,Default,,0,0,0,,Әзірге біраз жылжымайтын мүлікті иеліктен шығарайық.
Dialogue: 0,0:18:34.40,0:18:35.90,Default,,0,0,0,,Өйткені ол алдын ала төленген
Dialogue: 0,0:18:36.24,0:18:37.78,Default,,0,0,0,,Оны кейінірек қайтарыңыз
Dialogue: 0,0:18:37.90,0:18:40.03,Default,,0,0,0,,Иә? Қайтарыңыз?
Dialogue: 0,0:18:40.16,0:18:42.62,Default,,0,0,0,,Секкен тұқымдар, солай ма?
Dialogue: 0,0:18:42.78,0:18:44.95,Default,,0,0,0,,Бұл мүмкін емес! 30 миллион?
Dialogue: 0,0:18:45.83,0:18:47.66,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:18:48.21,0:18:50.29,Default,,0,0,0,,Мен ол адамнан төлеуді сұрауым керек пе?
Dialogue: 0,0:18:50.46,0:18:51.29,Default,,0,0,0,,Қандай әдемі киім
Dialogue: 0,0:18:52.04,0:18:53.59,Default,,0,0,0,,♪ Фарах Фарах Фарах~
Dialogue: 0,0:18:53.71,0:18:54.55,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:54.92,0:18:58.09,Default,,0,0,0,,Фарра Браунға бұл суретті қайтадан сатып алуға рұқсат етіңіз.
Dialogue: 0,0:18:58.22,0:19:01.05,Default,,0,0,0,,Иә, бірақ бұл жалған.
Dialogue: 0,0:19:01.34,0:19:04.81,Default,,0,0,0,,Басқаша айтқанда, «Лондондағы қардың» жалған нұсқасын дайындаңыз.
Dialogue: 0,0:19:04.93,0:19:07.47,Default,,0,0,0,,Фарахқа 30 миллион иеннен астамға сатыңыз
Dialogue: 0,0:19:07.60,0:19:10.77,Default,,0,0,0,,Біз банкті бұзбай нақты нәрсені аламыз.
Dialogue: 0,0:19:10.89,0:19:11.81,Default,,0,0,0,,Жоқ, өмірден бас тартпа
Dialogue: 0,0:19:12.31,0:19:15.02,Default,,0,0,0,,Адамдарды жалған өнімді қайдан алуға болады?
Dialogue: 0,0:19:15.15,0:19:15.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:16.11,0:19:19.95,Default,,0,0,0,,Жапондықтардың қолдары жақсы, адамдарға еліктегіш.
Dialogue: 0,0:19:21.61,0:19:23.24,Default,,0,0,0,,Менің ойымша, бұл түсінбеушілік болды.
Dialogue: 0,0:19:23.37,0:19:24.66,Default,,0,0,0,,Орынды басыңыз!
Dialogue: 0,0:19:24.78,0:19:26.87,Default,,0,0,0,,Сіз мұны сату ниетімен салдыңыз ба?
Dialogue: 0,0:19:26.99,0:19:29.45,Default,,0,0,0,,Ха ха ха ха…
Dialogue: 0,0:19:29.58,0:19:32.04,Default,,0,0,0,,Мас адам суретшіні балыққа айналдырды.
Dialogue: 0,0:19:32.17,0:19:33.75,Default,,0,0,0,,Ішімдік дамиды дейді
Dialogue: 0,0:19:34.21,0:19:35.46,Default,,0,0,0,,Біраз мақтаншақ сезініп тұрсың деп сөйлегенің дұрыс емес. Бұл мені жүйкемді жұқартып жатыр.
Dialogue: 0,0:19:35.59,0:19:37.50,Default,,0,0,0,,Ендеше не істейсің?
Dialogue: 0,0:19:37.96,0:19:41.93,Default,,0,0,0,,Бір адам бар! Өте жақсы суретші
Dialogue: 0,0:19:46.31,0:19:48.56,Default,,0,0,0,,Бүгін тағы консервіленген бұршақтар?
Dialogue: 0,0:19:48.68,0:19:50.85,Default,,0,0,0,,Сатпаса, сол.
Dialogue: 0,0:19:50.98,0:19:53.73,Default,,0,0,0,,Шынымды айтсам, бұл суретті ешкімге бергім келмейді.
Dialogue: 0,0:19:53.85,0:19:54.69,Default,,0,0,0,,О...
Dialogue: 0,0:19:55.48,0:19:56.44,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:56.77,0:19:58.19,Default,,0,0,0,,Соңғысына дейін бәрін ұрып тастаймын.
Dialogue: 0,0:19:58.69,0:19:59.69,Default,,0,0,0,,Сіз оны салдыңыз ба?
Dialogue: 0,0:20:00.07,0:20:01.57,Default,,0,0,0,,А... иә
Dialogue: 0,0:20:01.78,0:20:04.91,Default,,0,0,0,,О, мүмкін сен...
Dialogue: 0,0:20:05.07,0:20:05.91,Default,,0,0,0,,Who?
Dialogue: 0,0:20:06.16,0:20:08.95,Default,,0,0,0,,Атақты бағалаушы, өнер дилері және аукционшы
Dialogue: 0,0:20:09.08,0:20:10.16,Default,,0,0,0,,(Роко) Иә, әрине. Мұнда өте жайлы екен.
Dialogue: 0,0:20:11.96,0:20:13.92,Default,,0,0,0,,Жақсы салынған
Dialogue: 0,0:20:14.04,0:20:15.92,Default,,0,0,0,,Ғажайып талант.
Dialogue: 0,0:20:16.04,0:20:17.67,Default,,0,0,0,,О... бұл рас па?
Dialogue: 0,0:20:17.79,0:20:20.13,Default,,0,0,0,,Түсінгендер түсінеді!
Dialogue: 0,0:20:20.71,0:20:22.13,Default,,0,0,0,,Үлгі ол.
Dialogue: 0,0:20:23.47,0:20:26.60,Default,,0,0,0,,А... бұл кәдесыйға тұрарлық көшірме.
Dialogue: 0,0:20:26.72,0:20:30.77,Default,,0,0,0,,Эй эй эй мына жігіт шектен шыққан
Dialogue: 0,0:20:30.89,0:20:32.89,Default,,0,0,0,,Huhahahaha Керемет!
Dialogue: 0,0:20:33.02,0:20:34.77,Default,,0,0,0,,Бұл аспанның сыйы
Dialogue: 0,0:20:35.44,0:20:36.94,Default,,0,0,0,,Ескі бояуларды қолдану
Dialogue: 0,0:20:37.06,0:20:38.65,Default,,0,0,0,,Шынайы нәрседен айырмашылығы жоқ шығар
Dialogue: 0,0:20:39.69,0:20:41.15,Default,,0,0,0,,Тіпті мен
Dialogue: 0,0:20:42.82,0:20:45.82,Default,,0,0,0,,Сізде табиғи талант бар.
Dialogue: 0,0:20:46.70,0:20:47.95,Default,,0,0,0,,Бұл жалған.
Dialogue: 0,0:20:49.33,0:20:50.66,Default,,0,0,0,,Жалғандық?
Dialogue: 0,0:20:51.12,0:20:57.13,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.82,0:22:50.82,Default,,0,0,0,,~♪
Dialogue: 0,0:22:52.32,0:22:58.32,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory