Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.60,0:00:07.07,Default,,0,0,0,,(қуырылған дыбыс)
Dialogue: 0,0:00:10.00,0:00:10.50,Default,,0,0,0,,Хаа…
Dialogue: 0,0:00:12.05,0:00:13.03,Default,,0,0,0,,(басылған дыбыс)
Dialogue: 0,0:00:15.05,0:00:16.09,Default,,0,0,0,,Хаа~
Dialogue: 0,0:00:17.03,0:00:19.01,Default,,0,0,0,,Сатылым төмендеуде
Dialogue: 0,0:00:19.03,0:00:21.03,Default,,0,0,0,,Мен оның осылай қала беретінін білемін.
Dialogue: 0,0:00:35.01,0:00:36.04,Default,,0,0,0,,Тамақ дайын.
Dialogue: 0,0:00:36.06,0:00:37.04,Default,,0,0,0,,О
Dialogue: 0,0:00:42.01,0:00:43.07,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:00:47.07,0:00:49.02,Default,,0,0,0,,Түскі ас.
Dialogue: 0,0:00:50.07,0:00:53.04,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:00:53.05,0:00:54.03,Default,,0,0,0,,(Табақ қою дыбысы)
Dialogue: 0,0:00:56.05,0:00:58.00,Default,,0,0,0,,Көп тамақтаныңыз
Dialogue: 0,0:00:58.01,0:00:59.07,Default,,0,0,0,,Барлығы тым арық
Dialogue: 0,0:01:00.01,0:01:01.06,Default,,0,0,0,,Аударған Эдамура мырза
Dialogue: 0,0:01:02.02,0:01:04.05,Default,,0,0,0,,(Эдамама: ағылшын)
Dialogue: 0,0:01:07.04,0:01:08.03,Default,,0,0,0,,Хаа…
Dialogue: 0,0:01:08.09,0:01:09.07,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:01:10.07,0:01:13.02,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:01:17.02,0:01:18.01,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:01:18.02,0:01:21.04,Default,,0,0,0,,Сасық. Сіз ваннаны дұрыс қабылдайсыз ба?
Dialogue: 0,0:01:21.06,0:01:22.07,Default,,0,0,0,,Аптасына бір рет
Dialogue: 0,0:01:22.09,0:01:24.09,Default,,0,0,0,,Аптасына екі рет жасаңыз (қызметкер) Иә.
Dialogue: 0,0:01:26.02,0:01:27.02,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:01:30.09,0:01:32.07,Default,,0,0,0,,Оны қайтадан қорапқа салыңыз.
Dialogue: 0,0:01:40.09,0:01:42.05,Default,,0,0,0,,Сіз байсалдысыз ба?
Dialogue: 0,0:01:42.07,0:01:45.06,Default,,0,0,0,,Бұл мен жасаған ең қиын жұмыс.
Dialogue: 0,0:01:46.01,0:01:48.04,Default,,0,0,0,,Әкемі Созаку неге ұқсайды?
Dialogue: 0,0:01:48.06,0:01:49.06,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:01:49.07,0:01:53.03,Default,,0,0,0,,Бұл әсерлі, бірақ соншалықты қорқынышты емес.
Dialogue: 0,0:01:53.06,0:01:56.07,Default,,0,0,0,,Лоран, мүмкіндігінше тезірек түс.
Dialogue: 0,0:01:57.04,0:01:58.07,Default,,0,0,0,,Түсуге болады.
Dialogue: 0,0:01:59.02,0:02:03.02,Default,,0,0,0,,Бірақ сіз бала сатуды көрдіңіз және ол туралы ештеңе ойламадыңыз ба?
Dialogue: 0,0:02:03.08,0:02:05.06,Default,,0,0,0,,Сіз қандай әдістерді қолданғыңыз келеді?
Dialogue: 0,0:02:06.00,0:02:08.06,Default,,0,0,0,,Синтияның қозғалатын уақыты келді.
Dialogue: 0,0:02:08.08,0:02:12.07,Default,,0,0,0,,(ағынды дыбыс)
Dialogue: 0,0:02:13.07,0:02:16.04,Default,,0,0,0,,Әй, анау бала жақсы жүр ме екен.
Dialogue: 0,0:02:16.05,0:02:18.03,Default,,0,0,0,,Сіз жас қарлығаштарға алаңдайсыз ба?
Dialogue: 0,0:02:18.04,0:02:20.09,Default,,0,0,0,,Өйткені мен сүйкімді ақымақпын.
Dialogue: 0,0:02:21.07,0:02:23.02,Default,,0,0,0,,Бірақ бұған дейін
Dialogue: 0,0:02:23.04,0:02:25.07,Default,,0,0,0,,Бір кесе.
Dialogue: 0,0:02:27.03,0:02:33.03,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:03:25.07,0:03:31.07,Default,,0,0,0,,~♪
Dialogue: 0,0:03:34.07,0:03:37.08,Default,,0,0,0,,Осы қарқынмен мен бұл айда да өз квотаға жете алмаймын.
Dialogue: 0,0:03:38.00,0:03:39.02,Default,,0,0,0,,Хаа…
Dialogue: 0,0:03:40.03,0:03:41.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:41.05,0:03:43.03,Default,,0,0,0,,Президент, тапсырыс беруші.
Dialogue: 0,0:03:46.01,0:03:47.00,Default,,0,0,0,,<Сіз президентсіз! 〉
Dialogue: 0,0:03:47.01,0:03:49.09,Default,,0,0,0,,<Мен Синтия Йорошикумын! 〉
Dialogue: 0,0:03:50.04,0:03:53.01,Default,,0,0,0,,Танысқаныма қуаныштымын, Синтия...
Dialogue: 0,0:03:53.08,0:03:56.05,Default,,0,0,0,,Синтия саудасы
Dialogue: 0,0:03:57.01,0:04:00.09,Default,,0,0,0,,Бұл бізбен бизнес жасағыңыз келетінін білдіре ме?
Dialogue: 0,0:04:01.01,0:04:02.06,Default,,0,0,0,,А, бұл дұрыс.
Dialogue: 0,0:04:03.02,0:04:06.03,Default,,0,0,0,,Сіз қандай бұйымдарды өңдейсіз?
Dialogue: 0,0:04:06.04,0:04:07.07,Default,,0,0,0,,Әртүрлі
Dialogue: 0,0:04:07.09,0:04:10.04,Default,,0,0,0,,Ол Еуропада және Таяу Шығыста жұмыс істеді.
Dialogue: 0,0:04:10.05,0:04:12.06,Default,,0,0,0,,Бұл жерде айтарлықтай рецессия.
Dialogue: 0,0:04:12.07,0:04:15.09,Default,,0,0,0,,Осылайша мен Азияға келдім.
Dialogue: 0,0:04:16.08,0:04:18.07,Default,,0,0,0,,Сөйлейтін брокер шығар.
Dialogue: 0,0:04:18.08,0:04:19.08,Default,,0,0,0,,О
Dialogue: 0,0:04:20.02,0:04:23.03,Default,,0,0,0,,〈Бізде өте жақсы өнімдер бар〉
Dialogue: 0,0:04:23.05,0:04:24.06,Default,,0,0,0,,«Жақсы өнім»
Dialogue: 0,0:04:24.07,0:04:26.04,Default,,0,0,0,,Өнер туындысы немесе сол сияқты нәрсе?
Dialogue: 0,0:04:27.09,0:04:28.09,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:04:29.08,0:04:31.01,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:04:33.04,0:04:34.06,Default,,0,0,0,,Сіз нені айтасыз...
Dialogue: 0,0:04:34.08,0:04:36.04,Default,,0,0,0,,〈Түйсіну〉
Dialogue: 0,0:04:36.05,0:04:37.03,Default,,0,0,0,,〈Жоқ.〉
Dialogue: 0,0:04:40.08,0:04:43.01,Default,,0,0,0,,Мұны айтудың жақсы тәсілі емес.
Dialogue: 0,0:04:43.04,0:04:44.04,Default,,0,0,0,,Не?
Dialogue: 0,0:04:44.07,0:04:47.02,Default,,0,0,0,,Үйде қажет болмаса, басқа жерге апарыңыз.
Dialogue: 0,0:04:47.04,0:04:48.02,Default,,0,0,0,,(Балалардың шуы)
Dialogue: 0,0:04:48.06,0:04:50.03,Default,,0,0,0,,Шанхай ұйымы т.б.
Dialogue: 0,0:04:50.04,0:04:51.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:58.02,0:05:00.02,Default,,0,0,0,,Менің тұтынушыларым қатал.
Dialogue: 0,0:05:00.03,0:05:03.04,Default,,0,0,0,,Біз тек Berry Expensive өнімдерін тасымалдаймыз...
Dialogue: 0,0:05:06.08,0:05:07.06,Default,,0,0,0,,басқа біреудің ұялы телефоны қоңырау шалғанда шыдай алмаймын.
Dialogue: 0,0:05:09.03,0:05:10.02,Default,,0,0,0,,Ханшайым?
Dialogue: 0,0:05:12.02,0:05:14.04,Default,,0,0,0,,Мұндай нәрсе қайда?
Dialogue: 0,0:05:14.07,0:05:17.08,Default,,0,0,0,,Мен қазір басып алуға барамын, менімен бірге келгің келе ме?
Dialogue: 0,0:05:18.04,0:05:19.03,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:23.08,0:05:26.03,Default,,0,0,0,,Иә, барлығы ағылшын тілінде сөйлейді.
Dialogue: 0,0:05:26.04,0:05:28.04,Default,,0,0,0,,Бұл адамдар көп әйелді, солай емес пе?
Dialogue: 0,0:05:28.08,0:05:29.08,Default,,0,0,0,,Соның арқасында
Dialogue: 0,0:05:29.09,0:05:33.04,Default,,0,0,0,,15 ханзада мен 18 ханшайым бірінен соң бірі
Dialogue: 0,0:05:33.05,0:05:34.04,Default,,0,0,0,,Сивон-сан
Dialogue: 0,0:05:35.00,0:05:36.05,Default,,0,0,0,,Осы уақытқа дейін келудің мәні неде?
Dialogue: 0,0:05:36.07,0:05:38.04,Default,,0,0,0,,Қателер және сол сияқты нәрселер...
Dialogue: 0,0:05:38.05,0:05:41.08,Default,,0,0,0,,(винттік ұшақтың ұшу дыбысы)
Dialogue: 0,0:05:43.09,0:05:46.08,Default,,0,0,0,,О, бұл өте жарқыраған ұшақ.
Dialogue: 0,0:05:47.08,0:05:50.02,Default,,0,0,0,,<Сіз Кларк Ибрахимді білесіз бе? 〉
Dialogue: 0,0:05:50.03,0:05:54.00,Default,,0,0,0,,〈Ол әйгілі әуе жарысшысы және ол күнде жаттығу жасайды.〉
Dialogue: 0,0:05:54.01,0:05:55.04,Default,,0,0,0,,Әуе жарысы?
Dialogue: 0,0:05:55.06,0:05:57.05,Default,,0,0,0,,Тәжірибеден оралуды мақсат етіңіз
Dialogue: 0,0:06:06.05,0:06:07.09,Default,,0,0,0,,(саусақ ысқырығы)
Dialogue: 0,0:06:13.09,0:06:17.00,Default,,0,0,0,,(Жылдам дыбыс)
Dialogue: 0,0:06:19.09,0:06:20.09,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:06:24.06,0:06:26.09,Default,,0,0,0,,Эй... Жындысың ба?
Dialogue: 0,0:06:36.03,0:06:38.06,Default,,0,0,0,,Бұл Кларк Ибрагим ме?
Dialogue: 0,0:06:38.07,0:06:39.05,Default,,0,0,0,,Иә
Dialogue: 0,0:06:39.08,0:06:42.04,Default,,0,0,0,,Мен лимузиннің артқы орындығында отырмын.
Dialogue: 0,0:06:42.05,0:06:44.06,Default,,0,0,0,,Түсінемін, бұл нанымды.
Dialogue: 0,0:06:44.08,0:06:47.04,Default,,0,0,0,,Бірақ ол өнім бола алмайды.
Dialogue: 0,0:06:47.06,0:06:48.09,Default,,0,0,0,,〈Тағы бір адам бар〉
Dialogue: 0,0:06:49.01,0:06:52.00,Default,,0,0,0,,Кларк мені күнде жаттығуға апарады.
Dialogue: 0,0:06:52.02,0:06:54.05,Default,,0,0,0,,Менің мінезі қысқа, сөйлемейтін апам
Dialogue: 0,0:06:54.08,0:06:55.07,Default,,0,0,0,,Наги…
Dialogue: 0,0:06:56.05,0:06:57.05,Default,,0,0,0,,〈Қараңдар! 〉
Dialogue: 0,0:06:58.05,0:07:02.09,Default,,0,0,0,,〈Ол 14-ші ханшайым, Абигейл Ибрахим! 〉
Dialogue: 0,0:07:03.02,0:07:05.06,Default,,0,0,0,,Абигейл Ибрахим
Dialogue: 0,0:07:09.01,0:07:10.03,Default,,0,0,0,,Сол жігіт Умина
Dialogue: 0,0:07:19.05,0:07:21.03,Default,,0,0,0,,〈Енді тұр〉
Dialogue: 0,0:07:25.09,0:07:28.05,Default,,0,0,0,,О... мен мұндамын...
Dialogue: 0,0:07:28.06,0:07:30.08,Default,,0,0,0,,Біреудің тепкені маған қатты тиді.
Dialogue: 0,0:07:31.02,0:07:32.09,Default,,0,0,0,,Іс-әрекеттер кәсіби емес.
Dialogue: 0,0:07:33.00,0:07:34.07,Default,,0,0,0,,Ух...ха
Dialogue: 0,0:07:35.03,0:07:39.00,Default,,0,0,0,,Солай болса да, ол дәл Сэмге ұқсайды.
Dialogue: 0,0:07:39.04,0:07:41.03,Default,,0,0,0,,Жүр, сен жараланасың.
Dialogue: 0,0:07:41.04,0:07:43.03,Default,,0,0,0,,Ха, бұл мақтау.
Dialogue: 0,0:07:43.05,0:07:45.00,Default,,0,0,0,,Хаха...
Dialogue: 0,0:07:55.00,0:07:56.05,Default,,0,0,0,,…
Dialogue: 0,0:07:59.01,0:08:02.01,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:08:03.02,0:08:04.00,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:07.00,0:08:09.04,Default,,0,0,0,,Нағыз ханшайым
Dialogue: 0,0:08:09.05,0:08:11.06,Default,,0,0,0,,Бұл ең үлкен нәрсе.
Dialogue: 0,0:08:12.07,0:08:13.05,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:08:21.06,0:08:24.05,Default,,0,0,0,,Ибраһим әулетінің 14-ханшайымы
Dialogue: 0,0:08:25.01,0:08:26.00,Default,,0,0,0,,Иә
Dialogue: 0,0:08:26.01,0:08:28.04,Default,,0,0,0,,Мен оны өз көзіммен көрдім.
Dialogue: 0,0:08:28.05,0:08:29.09,Default,,0,0,0,,Жарайды, абайлайық.
Dialogue: 0,0:08:30.00,0:08:31.02,Default,,0,0,0,,Фу~
Dialogue: 0,0:08:33.05,0:08:34.05,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:08:35.01,0:08:36.01,Default,,0,0,0,,(Эдамама: ағылшын)
Dialogue: 0,0:08:36.08,0:08:37.08,Default,,0,0,0,,Абигейл
Dialogue: 0,0:08:38.04,0:08:39.03,Default,,0,0,0,,Жыл?
Dialogue: 0,0:08:39.05,0:08:40.05,Default,,0,0,0,,(Эдамама: ағылшын)
Dialogue: 0,0:08:40.06,0:08:41.05,Default,,0,0,0,,Он алты
Dialogue: 0,0:08:41.08,0:08:42.08,Default,,0,0,0,,Оны шешіңіз.
Dialogue: 0,0:08:43.00,0:08:44.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:44.01,0:08:45.05,Default,,0,0,0,,А... иә
Dialogue: 0,0:08:48.09,0:08:49.07,Default,,0,0,0,,〈Дөрекі! 〉
Dialogue: 0,0:08:50.01,0:08:51.01,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:51.03,0:08:52.01,Default,,0,0,0,,Жаса!
Dialogue: 0,0:08:57.06,0:08:59.02,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:06.06,0:09:07.06,Default,,0,0,0,,О...
Dialogue: 0,0:09:12.00,0:09:12.50,Default,,0,0,0,,Барлығы.
Dialogue: 0,0:09:14.01,0:09:15.03,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:15.04,0:09:16.02,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:18.01,0:09:18.51,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:09:19.07,0:09:21.08,Default,,0,0,0,,Эй, не, эй...
Dialogue: 0,0:09:29.04,0:09:30.02,Default,,0,0,0,,Айналыңыз
Dialogue: 0,0:09:30.08,0:09:31.08,Default,,0,0,0,,(Эдамама: ағылшын)
Dialogue: 0,0:09:35.01,0:09:37.06,Default,,0,0,0,,Хмм… мм… мм…
Dialogue: 0,0:09:42.07,0:09:43.05,Default,,0,0,0,,Қанша?
Dialogue: 0,0:09:44.04,0:09:46.04,Default,,0,0,0,,(Синтия: ағылшын)
Dialogue: 0,0:09:47.03,0:09:49.03,Default,,0,0,0,,Ол үшін қанша төлейсіз?
Dialogue: 0,0:09:50.09,0:09:52.00,Default,,0,0,0,,Фу~
Dialogue: 0,0:09:59.08,0:10:02.02,Default,,0,0,0,,(Синтия: ағылшын)
Dialogue: 0,0:10:02.03,0:10:04.03,Default,,0,0,0,,Бұл иен емес, солай ма?
Dialogue: 0,0:10:05.01,0:10:07.08,Default,,0,0,0,,Сөйлегеніңе абай бол, қызым.
Dialogue: 0,0:10:08.01,0:10:09.02,Default,,0,0,0,,Бірақ Төраға
Dialogue: 0,0:10:09.04,0:10:10.07,Default,,0,0,0,,Бұл өнімнің құны
Dialogue: 0,0:10:10.09,0:10:13.03,Default,,0,0,0,,Бұзылған ойыншық емес
Dialogue: 0,0:10:13.04,0:10:16.09,Default,,0,0,0,,Ибрагим отбасы оны кез келген бағамен қайтарып алатын.
Dialogue: 0,0:10:17.02,0:10:18.01,Default,,0,0,0,,Тіпті бейбіт тұрғындар да құрбан болуда.
Dialogue: 0,0:10:18.04,0:10:21.06,Default,,0,0,0,,Кейбір елдер де оны дипломатиялық карта ретінде алғысы келетініне сенімдімін.
Dialogue: 0,0:10:22.00,0:10:24.02,Default,,0,0,0,,Мен сіздің пікіріңізді тыңдамаймын.
Dialogue: 0,0:10:24.05,0:10:28.00,Default,,0,0,0,,(Синтия: ағылшын)
Dialogue: 0,0:10:28.04,0:10:31.02,Default,,0,0,0,,Сатып алмасаң, Шанхайға апарамыз дейді.
Dialogue: 0,0:10:32.07,0:10:33.06,Default,,0,0,0,,Аа...
Dialogue: 0,0:10:34.07,0:10:36.03,Default,,0,0,0,,Бұл жай ғана «таптан шыққанды ұру» ойыны емес пе?
Dialogue: 0,0:10:39.09,0:10:41.08,Default,,0,0,0,,Фу~
Dialogue: 0,0:10:44.04,0:10:45.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:46.09,0:10:47.07,Default,,0,0,0,,Ах
Dialogue: 0,0:10:49.09,0:10:53.04,Default,,0,0,0,,Менің ойымша, егер ол сәл жас болса, жақсырақ баға алар еді.
Dialogue: 0,0:10:59.04,0:11:00.07,Default,,0,0,0,,Мұны қалдырыңыз.
Dialogue: 0,0:11:03.08,0:11:05.07,Default,,0,0,0,,(Синтия: ағылшын)
Dialogue: 0,0:11:06.05,0:11:07.05,Default,,0,0,0,,Хаа…
Dialogue: 0,0:11:11.09,0:11:14.04,Default,,0,0,0,,Бұл сіз үшін арнайы бөлме.
Dialogue: 0,0:11:14.05,0:11:17.03,Default,,0,0,0,,Бұл әдетте менің ұйықтайтын бөлмем.
Dialogue: 0,0:11:18.09,0:11:21.07,Default,,0,0,0,,Жарайсың ба? Теледидар мен ойындар бар
Dialogue: 0,0:11:21.08,0:11:24.08,Default,,0,0,0,,Аа, бұл менің жеке меншігім, оны құртпауларыңызды өтінемін.
Dialogue: 0,0:11:25.01,0:11:26.09,Default,,0,0,0,,Соның бәрін кейінірек айтып беріңізші.
Dialogue: 0,0:11:27.03,0:11:28.03,Default,,0,0,0,,Иә
Dialogue: 0,0:11:28.04,0:11:31.04,Default,,0,0,0,,Жарайды, бүгін шаршаған шығарсың, ендеше жүре бер.
Dialogue: 0,0:11:34.03,0:11:35.04,Default,,0,0,0,,(құлыптау дыбысы)
Dialogue: 0,0:11:43.01,0:11:44.03,Default,,0,0,0,,Ммммммм
Dialogue: 0,0:11:44.04,0:11:45.07,Default,,0,0,0,,Бақылау камераларына сенбеңіз
Dialogue: 0,0:11:46.03,0:11:48.03,Default,,0,0,0,,Айналаңызға сағатына бір рет қараңыз
Dialogue: 0,0:11:48.04,0:11:51.02,Default,,0,0,0,,Егер бірдеңе болса, біз Сагами шығанағында саяхаттаймыз.
Dialogue: 0,0:11:51.04,0:11:52.02,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:52.04,0:11:53.06,Default,,0,0,0,,Сагами шығанағы?
Dialogue: 0,0:11:53.07,0:11:54.06,Default,,0,0,0,,Өйткені ол сасық.
Dialogue: 0,0:11:54.07,0:11:57.02,Default,,0,0,0,,Шимамурадан киім сатып ал, мен киім ауыстырайын.
Dialogue: 0,0:11:57.08,0:11:59.09,Default,,0,0,0,,Түбіртекті де алуды ұмытпаңыз.
Dialogue: 0,0:12:01.04,0:12:02.03,Default,,0,0,0,,Иә
Dialogue: 0,0:12:02.08,0:12:03.06,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:12:12.02,0:12:13.01,Default,,0,0,0,,(еденге қойылған пластинаның дыбысы)
Dialogue: 0,0:12:13.03,0:12:14.02,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:12:20.04,0:12:21.09,Default,,0,0,0,,Тамақ ішесіз бе?
Dialogue: 0,0:12:22.03,0:12:23.05,Default,,0,0,0,,Менің өлгім келеді
Dialogue: 0,0:12:35.06,0:12:36.05,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:12:37.06,0:12:39.01,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:12:40.06,0:12:41.04,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:41.05,0:12:43.03,Default,,0,0,0,,Қайтадан қош келдіңіз, Эдамаме!
Dialogue: 0,0:12:43.04,0:12:44.08,Default,,0,0,0,,Жақсы жұмыс...
Dialogue: 0,0:12:45.01,0:12:47.05,Default,,0,0,0,,1 миллиард, бұл ең жақсы!
Dialogue: 0,0:12:47.06,0:12:49.03,Default,,0,0,0,,Бұл өте ауыр жұмыс болды, солай емес пе?
Dialogue: 0,0:12:50.03,0:12:53.02,Default,,0,0,0,,Сәлем, балалар, мұнда не істеп жатырсыңдар?
Dialogue: 0,0:12:54.00,0:12:54.50,Default,,0,0,0,,Аяқ киіммен
Dialogue: 0,0:12:55.02,0:12:56.04,Default,,0,0,0,,Бұл Татами
Dialogue: 0,0:12:56.05,0:12:57.04,Default,,0,0,0,,Маған ұнады
Dialogue: 0,0:12:57.05,0:12:58.06,Default,,0,0,0,,Секірме!
Dialogue: 0,0:12:58.07,0:13:00.08,Default,,0,0,0,,Қарашы, ауыр сөз айтпа.
Dialogue: 0,0:13:00.09,0:13:02.07,Default,,0,0,0,,Бұл емес!
Dialogue: 0,0:13:02.09,0:13:04.09,Default,,0,0,0,,Егер олар сенің менің досым екеніңді білсе, сені өлтіреді.
Dialogue: 0,0:13:05.01,0:13:06.03,Default,,0,0,0,,Қазір шығыңыз!
Dialogue: 0,0:13:06.06,0:13:08.08,Default,,0,0,0,,Түсіндім, түсіндім, сосын...
Dialogue: 0,0:13:09.02,0:13:10.09,Default,,0,0,0,,Мен сенен менің артымнан тазалауды өтіндім.
Dialogue: 0,0:13:11.00,0:13:12.01,Default,,0,0,0,,Тазалау?
Dialogue: 0,0:13:12.02,0:13:14.00,Default,,0,0,0,,Эбби қашып кетсін.
Dialogue: 0,0:13:14.02,0:13:16.05,Default,,0,0,0,,Сонымен, бұл жолы тапсырма аяқталды
Dialogue: 0,0:13:16.07,0:13:17.07,Default,,0,0,0,,Танысқаныма қуаныштымын!
Dialogue: 0,0:13:18.05,0:13:20.00,Default,,0,0,0,,Хаа…
Dialogue: 0,0:13:20.01,0:13:21.05,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:13:23.00,0:13:25.00,Default,,0,0,0,,Хаа~
Dialogue: 0,0:13:25.02,0:13:27.02,Default,,0,0,0,,(қонақ күлкі)
Dialogue: 0,0:13:27.03,0:13:28.05,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:13:29.00,0:13:33.05,Default,,0,0,0,,Мәселе мынада: әлгі қарт қаңбақ мұрасы кімге беріледі?
Dialogue: 0,0:13:33.06,0:13:36.00,Default,,0,0,0,,Бұл президент Ишигами емес пе?
Dialogue: 0,0:13:36.01,0:13:37.09,Default,,0,0,0,,Бұл сөзсіз.
Dialogue: 0,0:13:38.00,0:13:40.06,Default,,0,0,0,,Басқаша айтқанда, тағдырдың қызыл бауы
Dialogue: 0,0:13:42.03,0:13:44.09,Default,,0,0,0,,Сол себепті, әлгі қарт қаңбақ
Dialogue: 0,0:13:45.06,0:13:48.04,Default,,0,0,0,,Хекора Хеко Хеко Бұл Хеко.
Dialogue: 0,0:13:49.00,0:13:50.08,Default,,0,0,0,,Бұл өте жаман...
Dialogue: 0,0:13:51.01,0:13:52.09,Default,,0,0,0,,Менің де депрессияға түскім келеді
Dialogue: 0,0:13:53.01,0:13:54.07,Default,,0,0,0,,Жоқ! Дұрыс па?
Dialogue: 0,0:13:56.08,0:13:58.08,Default,,0,0,0,,Нодогоши~
Dialogue: 0,0:13:59.02,0:14:01.04,Default,,0,0,0,,Бірақ сіз көріндіңіз
Dialogue: 0,0:14:01.08,0:14:02.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:03.00,0:14:04.04,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:04.06,0:14:08.00,Default,,0,0,0,,Сізді кемпір жақсы көреді, солай ма?
Dialogue: 0,0:14:08.03,0:14:10.01,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:14:10.02,0:14:12.02,Default,,0,0,0,,Мен жаңадан келген адаммын.
Dialogue: 0,0:14:12.03,0:14:13.04,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:14:13.06,0:14:18.06,Default,,0,0,0,,Мен бұрынғыдан бері еңбек етіп келемін.
Dialogue: 0,0:14:18.08,0:14:23.06,Default,,0,0,0,,Созақудың ақырында... болатынына сенімдімін.
Dialogue: 0,0:14:27.05,0:14:28.09,Default,,0,0,0,,Президент
Dialogue: 0,0:14:34.09,0:14:35.08,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:40.06,0:14:41.05,Default,,0,0,0,,(Тақтаны соғу дыбысы)
Dialogue: 0,0:14:41.08,0:14:42.07,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:46.03,0:14:48.01,Default,,0,0,0,,Хмм... хмм?
Dialogue: 0,0:14:49.07,0:14:50.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:53.01,0:14:54.08,Default,,0,0,0,,Масамун күні?
Dialogue: 0,0:14:55.00,0:14:59.06,Default,,0,0,0,,Мен осылай көрінсем де, мен «Абиция» сериясына қызығушылық танытпаймын.
Dialogue: 0,0:14:59.09,0:15:01.02,Default,,0,0,0,,Менің ағам – ескі мектептің адамы – алдау мен айла-шарғы арқылы жеңетіндерден—
Dialogue: 0,0:15:01.03,0:15:04.08,Default,,0,0,0,,Масамуна өз әкесін өлтірді.
Dialogue: 0,0:15:06.06,0:15:07.06,Default,,0,0,0,,Ах~
Dialogue: 0,0:15:09.00,0:15:09.50,Default,,0,0,0,,Хаа…
Dialogue: 0,0:15:28.01,0:15:29.06,Default,,0,0,0,,(баспалдақтан түскен аяқ дыбыстары)
Dialogue: 0,0:15:51.09,0:15:53.07,Default,,0,0,0,,(кеспенің шырылдаған дыбысы)
Dialogue: 0,0:15:59.00,0:16:01.02,Default,,0,0,0,,Жүйкелері жуан ханшайым.
Dialogue: 0,0:16:01.04,0:16:02.02,Default,,0,0,0,,(сорпаның шырылдаған дыбысы)
Dialogue: 0,0:16:03.00,0:16:04.07,Default,,0,0,0,,Хаа~
Dialogue: 0,0:16:06.04,0:16:07.05,Default,,0,0,0,,ауыстырыңыз
Dialogue: 0,0:16:07.06,0:16:08.05,Default,,0,0,0,,О
Dialogue: 0,0:16:08.06,0:16:10.08,Default,,0,0,0,,Жарайды, мен айналама бір қарап алайын деп ойлаймын.
Dialogue: 0,0:16:11.00,0:16:12.00,Default,,0,0,0,,О, жарайды.
Dialogue: 0,0:16:13.00,0:16:15.05,Default,,0,0,0,,Мен келемін, сондықтан бүгін үйге қайтыңыз.
Dialogue: 0,0:16:15.06,0:16:16.05,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:16.06,0:16:17.06,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:16:18.01,0:16:20.02,Default,,0,0,0,,Сіз маған әрқашан көп нәрсені үйретесіз.
Dialogue: 0,0:16:20.03,0:16:21.06,Default,,0,0,0,,Біз өзара.
Dialogue: 0,0:16:22.08,0:16:23.07,Default,,0,0,0,,Оны сыныптар бойынша айналмалы турнир деп атайды.
Dialogue: 0,0:16:33.04,0:16:34.08,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:16:39.00,0:16:40.03,Default,,0,0,0,,Эбби, жүгір!
Dialogue: 0,0:16:40.04,0:16:41.05,Default,,0,0,0,,Тағы біраз
Dialogue: 0,0:16:41.06,0:16:43.02,Default,,0,0,0,,Өзіңді алдама, кеттік!
Dialogue: 0,0:16:51.03,0:16:52.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:16:52.06,0:16:53.05,Default,,0,0,0,,Не болды?
Dialogue: 0,0:16:55.09,0:16:56.08,Default,,0,0,0,,Эй!
Dialogue: 0,0:16:59.05,0:17:00.09,Default,,0,0,0,,Йоккойшо
Dialogue: 0,0:17:01.02,0:17:03.04,Default,,0,0,0,,Қош келдіңіз, киген киіміңізге не болды?
Dialogue: 0,0:17:03.06,0:17:04.09,Default,,0,0,0,,Киімді жуу
Dialogue: 0,0:17:05.01,0:17:05.51,Default,,0,0,0,,Ал екіншісі ше?
Dialogue: 0,0:17:08.06,0:17:10.05,Default,,0,0,0,,Эдамаме, тез шық
Dialogue: 0,0:17:13.04,0:17:15.08,Default,,0,0,0,,Қызықсыз нәрселерді айтпа
Dialogue: 0,0:17:16.01,0:17:19.01,Default,,0,0,0,,Барлық ұсталған балаларды бірге босатайық.
Dialogue: 0,0:17:19.02,0:17:20.07,Default,,0,0,0,,Міне келдік
Dialogue: 0,0:17:21.00,0:17:22.06,Default,,0,0,0,,Және қанша?
Dialogue: 0,0:17:22.07,0:17:24.05,Default,,0,0,0,,Біз әкелген бес адаммен
Dialogue: 0,0:17:24.07,0:17:27.03,Default,,0,0,0,,Бұрынғы 5 адамды қосқанда 10 адам.
Dialogue: 0,0:17:27.07,0:17:29.00,Default,,0,0,0,,Бұл 5 орындық
Dialogue: 0,0:17:29.01,0:17:30.06,Default,,0,0,0,,Кемеге мінсек те, екі адам ғана қалды.
Dialogue: 0,0:17:30.07,0:17:32.00,Default,,0,0,0,,Сіз көбірек міне аласыз!
Dialogue: 0,0:17:32.03,0:17:34.00,Default,,0,0,0,,Бұл жол қозғалысы ережесін бұзу.
Dialogue: 0,0:17:34.01,0:17:35.00,Default,,0,0,0,,Ұнамаса, бар!
Dialogue: 0,0:17:35.02,0:17:37.00,Default,,0,0,0,,Біз қашып кете аламыз!
Dialogue: 0,0:17:37.05,0:17:39.05,Default,,0,0,0,,Ааа, солай деп ойлаймын.
Dialogue: 0,0:17:39.06,0:17:41.00,Default,,0,0,0,,Маған айтпа.
Dialogue: 0,0:17:44.08,0:17:45.07,Default,,0,0,0,,Ах
Dialogue: 0,0:17:47.03,0:17:48.03,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:55.04,0:17:56.04,Default,,0,0,0,,Эбби!
Dialogue: 0,0:17:57.07,0:17:59.00,Default,,0,0,0,,Сол бөлмені сұраңыз.
Dialogue: 0,0:18:01.04,0:18:02.03,Default,,0,0,0,,Оян!
Dialogue: 0,0:18:02.07,0:18:04.09,Default,,0,0,0,,Барлығы ояныңдар! Жүгіріп кету!
Dialogue: 0,0:18:05.01,0:18:06.09,Default,,0,0,0,,Кел, оян!
Dialogue: 0,0:18:07.01,0:18:09.04,Default,,0,0,0,,Қараңызшы, сіз боссыз.
Dialogue: 0,0:18:09.05,0:18:11.01,Default,,0,0,0,,Менімен бірге жүр!
Dialogue: 0,0:18:12.00,0:18:14.03,Default,,0,0,0,,Don't be distracted, hurry!
Dialogue: 0,0:18:15.04,0:18:17.08,Default,,0,0,0,,Не болды? Сіз қашып кете аласыз!
Dialogue: 0,0:18:26.03,0:18:27.04,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:18:29.09,0:18:30.08,Default,,0,0,0,,Ах
Dialogue: 0,0:18:31.01,0:18:31.51,Default,,0,0,0,,Мен жеңдім
Dialogue: 0,0:18:32.02,0:18:33.08,Default,,0,0,0,,Мен сатылып кетті!
Dialogue: 0,0:18:33.09,0:18:34.08,Default,,0,0,0,,Қайда?
Dialogue: 0,0:18:34.09,0:18:35.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:36.01,0:18:38.03,Default,,0,0,0,,Сен қайда қашасың?
Dialogue: 0,0:18:41.03,0:18:45.01,Default,,0,0,0,,Біз бәріміз осындамыз, себебі ата-анамыз бізді тастап кетті немесе сатты.
Dialogue: 0,0:18:45.09,0:18:50.05,Default,,0,0,0,,Бізді ешкім ойламайды, қайда барсақ та, біз тиесілі емеспіз
Dialogue: 0,0:18:51.01,0:18:54.08,Default,,0,0,0,,Тірі ме, өлі ме бәрібір.
Dialogue: 0,0:18:56.01,0:18:57.04,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:02.06,0:19:04.06,Default,,0,0,0,,О, ана жерде.
Dialogue: 0,0:19:07.08,0:19:08.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:10.03,0:19:11.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:12.08,0:19:13.09,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:19:17.06,0:19:21.00,Default,,0,0,0,,(Тарих ойыны шайқас дыбыстары)
Dialogue: 0,0:19:21.01,0:19:21.51,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:28.05,0:19:29.07,Default,,0,0,0,,(Ағын су дыбысы)
Dialogue: 0,0:19:29.08,0:19:32.00,Default,,0,0,0,,Не, әжетханадасың ба?
Dialogue: 0,0:19:32.02,0:19:34.02,Default,,0,0,0,,Сіз бір нәрсені ұмыттыңыз ба?
Dialogue: 0,0:19:34.07,0:19:37.06,Default,,0,0,0,,Әй, одан гөрі ханшайым дәл қазір...
Dialogue: 0,0:19:39.09,0:19:41.03,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:19:41.07,0:19:44.00,Default,,0,0,0,,Мен кезекші боламын.
Dialogue: 0,0:19:44.02,0:19:46.00,Default,,0,0,0,,Үйге бару қиынға түсті.
Dialogue: 0,0:19:47.09,0:19:48.09,Default,,0,0,0,,Хаа…
Dialogue: 0,0:19:50.01,0:19:51.01,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:19:55.03,0:19:56.09,Default,,0,0,0,,Фу~
Dialogue: 0,0:19:59.05,0:20:01.07,Default,,0,0,0,,Хмм, жоқ, темекі...
Dialogue: 0,0:20:01.08,0:20:02.07,Default,,0,0,0,,Хмм
Dialogue: 0,0:20:13.09,0:20:14.07,Default,,0,0,0,,Хэ-хэ
Dialogue: 0,0:20:28.00,0:20:31.06,Default,,0,0,0,,Ата-анамыз бізді тастап кеткен немесе сатып жібергендіктен бәріміз осындамыз.
Dialogue: 0,0:20:32.03,0:20:34.06,Default,,0,0,0,,Қайда барсаң да, тиесілі жер жоқ
Dialogue: 0,0:20:51.00,0:20:57.00,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.07,0:22:50.07,Default,,0,0,0,,~♪
