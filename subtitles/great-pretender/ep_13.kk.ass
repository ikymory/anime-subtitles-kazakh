Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.21,0:00:05.79,Default,,0,0,0,,Томас Майер?
Dialogue: 0,0:00:05.92,0:00:06.84,Default,,0,0,0,,...
Dialogue: 0,0:00:06.96,0:00:09.42,Default,,0,0,0,,Сіздің осы дүкенге жиі келетініңізді естідім...
Dialogue: 0,0:00:09.55,0:00:10.42,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:00:10.55,0:00:12.84,Default,,0,0,0,,Бұл хехехе болды
Dialogue: 0,0:00:13.13,0:00:15.80,Default,,0,0,0,,Сіз бе? Ол Томасты іздейді.
Dialogue: 0,0:00:15.93,0:00:16.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:17.10,0:00:18.60,Default,,0,0,0,,Бұл оның ниггасы ма?
Dialogue: 0,0:00:18.72,0:00:21.85,Default,,0,0,0,,Жоқ, біз жай ғана таныспыз...
Dialogue: 0,0:00:21.98,0:00:23.98,Default,,0,0,0,,«Қиқанша» болса керек.
Dialogue: 0,0:00:24.44,0:00:26.44,Default,,0,0,0,,Әй, полицей!
Dialogue: 0,0:00:28.61,0:00:29.57,Default,,0,0,0,,Тұр, е!
Dialogue: 0,0:00:29.69,0:00:31.65,Default,,0,0,0,,Эй... Жоқ! кешіріңіз!
Dialogue: 0,0:00:31.78,0:00:33.82,Default,,0,0,0,,Эй, сыртта істе.
Dialogue: 0,0:00:34.32,0:00:40.33,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:32.59,0:01:38.59,Default,,0,0,0,,~♪
Dialogue: 0,0:01:39.84,0:01:42.97,Default,,0,0,0,,Хаха~ Мен бір ғана әмиянмен құтқарылдым.
Dialogue: 0,0:01:43.14,0:01:45.02,Default,,0,0,0,,Оң
Dialogue: 0,0:01:45.48,0:01:48.19,Default,,0,0,0,,Томас шынымен суретші ме?
Dialogue: 0,0:01:48.31,0:01:49.27,Default,,0,0,0,,Өткенде
Dialogue: 0,0:01:49.69,0:01:51.11,Default,,0,0,0,,Сонда жай ғана суретші ме?
Dialogue: 0,0:01:51.23,0:01:53.82,Default,,0,0,0,,Жоқ, сіз екі миллион фунт қарызсыз ба?
Dialogue: 0,0:01:53.94,0:01:54.94,Default,,0,0,0,,2 миллион?
Dialogue: 0,0:01:55.44,0:01:57.65,Default,,0,0,0,,Мен қандай кепілдік болғанын білмеймін.
Dialogue: 0,0:01:57.78,0:02:00.12,Default,,0,0,0,,Ол көп ақшаны қарызға алып жүгіріп жүр.
Dialogue: 0,0:02:00.70,0:02:02.08,Default,,0,0,0,,Әйтеуір, біз түсеміз.
Dialogue: 0,0:02:02.20,0:02:03.83,Default,,0,0,0,,Өзіңіз іздеңіз.
Dialogue: 0,0:02:04.33,0:02:07.41,Default,,0,0,0,,Е~ Олай деме, менімен аралас.
Dialogue: 0,0:02:08.16,0:02:10.96,Default,,0,0,0,,Бұл ең алдымен едамаменің кесірінен болса керек.
Dialogue: 0,0:02:12.09,0:02:14.84,Default,,0,0,0,,Әмиянымды алып кеткеннен бері ештеңе жеген жоқпын.
Dialogue: 0,0:02:15.59,0:02:17.63,Default,,0,0,0,,Бізге пицца жеткізуге бола ма?
Dialogue: 0,0:02:18.26,0:02:20.39,Default,,0,0,0,,Ал, әзірше мынаны байланыстырайық.
Dialogue: 0,0:02:20.51,0:02:21.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:02:21.68,0:02:23.05,Default,,0,0,0,,Бұл ешқайсысы емес
Dialogue: 0,0:02:23.18,0:02:24.85,Default,,0,0,0,,Жарамдылық мерзімі аяқталды.
Dialogue: 0,0:02:25.47,0:02:26.68,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:02:26.81,0:02:28.35,Default,,0,0,0,,Пицца, өтінемін
Dialogue: 0,0:02:32.90,0:02:35.53,Default,,0,0,0,,Егер сіз бір күні бұзылып қалсаңыз, не істейсіз?
Dialogue: 0,0:02:36.07,0:02:38.61,Default,,0,0,0,,Үлкенірек жерге көшуім керек пе?
Dialogue: 0,0:02:38.95,0:02:41.91,Default,,0,0,0,,Бірақ алдымен бұл картина сатыла ма деген сұрақ туындайды.
Dialogue: 0,0:02:42.03,0:02:44.12,Default,,0,0,0,,Хехе, сататынына сенімдімін.
Dialogue: 0,0:02:45.37,0:02:47.87,Default,,0,0,0,,Мен де тыңдалымда бар күшімді салуым керек.
Dialogue: 0,0:02:48.00,0:02:51.08,Default,,0,0,0,,Даяшы рөлінен өтетініңізге сенімдімін.
Dialogue: 0,0:02:51.25,0:02:53.92,Default,,0,0,0,,Ах~ Бұл дисс па?
Dialogue: 0,0:02:54.04,0:02:55.46,Default,,0,0,0,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,0:02:55.92,0:02:59.97,Default,,0,0,0,,Бірақ екеуміз өте жақсы жерге жеттік.
Dialogue: 0,0:03:00.30,0:03:03.76,Default,,0,0,0,,Егер бұл орын алса...
Dialogue: 0,0:03:10.69,0:03:12.60,Default,,0,0,0,,Huhahahaha Керемет!
Dialogue: 0,0:03:12.77,0:03:14.31,Default,,0,0,0,,Бұл аспанның сыйы.
Dialogue: 0,0:03:14.52,0:03:16.15,Default,,0,0,0,,Ескі бояуды қолдансаңыз
Dialogue: 0,0:03:16.27,0:03:18.28,Default,,0,0,0,,Нақты нәрседен айырмашылығы жоқ шығар
Dialogue: 0,0:03:18.74,0:03:20.45,Default,,0,0,0,,Тіпті мен
Dialogue: 0,0:03:20.99,0:03:23.45,Default,,0,0,0,,Сізде табиғи талант бар.
Dialogue: 0,0:03:24.32,0:03:25.70,Default,,0,0,0,,Бұл жалған.
Dialogue: 0,0:03:27.20,0:03:28.37,Default,,0,0,0,,Дүниеде
Dialogue: 0,0:03:28.49,0:03:32.12,Default,,0,0,0,,Қайталап сатып алу және сату кезінде жоғалған заттар
Dialogue: 0,0:03:32.25,0:03:36.34,Default,,0,0,0,,Аты тізімде көрсетілген, бірақ бар екені белгісіз заттар және т.б.
Dialogue: 0,0:03:36.46,0:03:38.17,Default,,0,0,0,,Бұл тау сияқты
Dialogue: 0,0:03:39.17,0:03:42.22,Default,,0,0,0,,Сіз оларды қазіргі заманға қайтарасыз.
Dialogue: 0,0:03:42.88,0:03:45.76,Default,,0,0,0,,Сіз оның жалған сурет салғанын қалайсыз ба?
Dialogue: 0,0:03:45.89,0:03:47.06,Default,,0,0,0,,Жалғандық емес
Dialogue: 0,0:03:47.18,0:03:48.43,Default,,0,0,0,,Нақты заттың суретін сал
Dialogue: 0,0:03:48.97,0:03:53.31,Default,,0,0,0,,Егер мен оны соттайтын болсам, жалғандықтың өзі шынайы.
Dialogue: 0,0:03:54.31,0:03:55.15,Default,,0,0,0,,Мен анықтаймын
Dialogue: 0,0:03:55.27,0:03:56.11,Default,,0,0,0,,Анықталған жоқ
Dialogue: 0,0:03:56.48,0:04:00.32,Default,,0,0,0,,Өйткені оның жалған екенін ешкім анықтай алмайды.
Dialogue: 0,0:04:00.44,0:04:03.24,Default,,0,0,0,,Басқаша айтқанда, бұл шайтанның дәлелі.
Dialogue: 0,0:04:03.36,0:04:05.62,Default,,0,0,0,,Егер фантомдық шедевр табылса
Dialogue: 0,0:04:05.74,0:04:10.58,Default,,0,0,0,,Өнер әлемі өркендеп келеді, тұтынушылар риза, мен де ақша тауып жатырмын.
Dialogue: 0,0:04:11.08,0:04:13.71,Default,,0,0,0,,Шынайы зат бір жерден табылса ше?
Dialogue: 0,0:04:14.04,0:04:14.96,Default,,0,0,0,,​​Хмм.
Dialogue: 0,0:04:16.25,0:04:17.34,Default,,0,0,0,,Жарайды, мұны істейік.
Dialogue: 0,0:04:17.96,0:04:20.46,Default,,0,0,0,,Маған қалаған 10 суретті сал.
Dialogue: 0,0:04:21.97,0:04:23.97,Default,,0,0,0,,Бар болғаны 10 дана
Dialogue: 0,0:04:24.18,0:04:25.51,Default,,0,0,0,,Суретті аяқтағаныңыз үшін алғыс ретінде
Dialogue: 0,0:04:25.64,0:04:30.10,Default,,0,0,0,,Мен сізді келешек данышпан суретші ретінде көтеруге уәде беремін.
Dialogue: 0,0:04:31.22,0:04:32.56,Default,,0,0,0,,Ойлан.
Dialogue: 0,0:04:37.86,0:04:40.02,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:05:47.30,0:05:50.60,Default,,0,0,0,,Джеймс Коулман, өнерді бағалаушы ретінде белгілі
Dialogue: 0,0:05:50.72,0:05:52.43,Default,,0,0,0,,Бұл оның эксклюзивті сұхбаты.
Dialogue: 0,0:05:52.89,0:05:55.98,Default,,0,0,0,,Алдымен шедевр ашқаныңызбен құттықтаймыз.
Dialogue: 0,0:05:56.10,0:05:56.93,Default,,0,0,0,,Рахмет
Dialogue: 0,0:05:57.44,0:05:58.94,Default,,0,0,0,,Соңғы әрекеттерді қараңыз
Dialogue: 0,0:05:59.06,0:06:02.07,Default,,0,0,0,,Кейбіреулер оны өнер әлемінің 007-сі дейді.
Dialogue: 0,0:06:02.19,0:06:03.02,Default,,0,0,0,,Иә
Dialogue: 0,0:06:03.15,0:06:06.36,Default,,0,0,0,,Бәлкім, бұл аттас шығар, бірақ бұл құрмет.
Dialogue: 0,0:06:06.65,0:06:07.70,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:07.82,0:06:11.12,Default,,0,0,0,,-да мен Кларенс Кокудың ''Фортепиано мұғалімі'' кітабын таптым.
Dialogue: 0,0:06:11.24,0:06:14.91,Default,,0,0,0,,Мұндай көру өткірлігін қалай дамытуға болады?
Dialogue: 0,0:06:15.91,0:06:17.58,Default,,0,0,0,,Тек оқу
Dialogue: 0,0:06:17.71,0:06:20.58,Default,,0,0,0,,Және сәл сәттілік.
Dialogue: 0,0:06:22.25,0:06:25.05,Default,,0,0,0,,Уау~ Керемет!
Dialogue: 0,0:06:25.17,0:06:27.13,Default,,0,0,0,,Мұнда толық жинақ бар.
Dialogue: 0,0:06:27.72,0:06:28.80,Default,,0,0,0,,Сізге ұнады ма?
Dialogue: 0,0:06:28.93,0:06:30.18,Default,,0,0,0,,Әрине, білемін.
Dialogue: 0,0:06:30.30,0:06:32.39,Default,,0,0,0,,Мен мұнда көбірек сурет сала алатындай сезінемін!
Dialogue: 0,0:06:32.51,0:06:33.47,Default,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:06:34.10,0:06:38.48,Default,,0,0,0,,Мен салған келесі картина Хосе Мартинестің «Сиеста» суреті.
Dialogue: 0,0:06:38.89,0:06:40.81,Default,,0,0,0,,Оның сипаттамасы қызыл
Dialogue: 0,0:06:41.10,0:06:42.36,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:06:42.48,0:06:45.57,Default,,0,0,0,,Менің ойымша, қызыл түске көгілдір түс араласқан.
Dialogue: 0,0:06:45.69,0:06:46.69,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:06:46.82,0:06:50.86,Default,,0,0,0,,Одан басқа, олар да бірдеңені негіз ретінде пайдаланған сияқты.
Dialogue: 0,0:06:57.04,0:06:59.91,Default,,0,0,0,,Оны енді бұл жерге әкелмеген дұрыс.
Dialogue: 0,0:07:00.16,0:07:01.12,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:07:01.25,0:07:03.46,Default,,0,0,0,,Әйелдің бөксесіне қараған кезде ме?
Dialogue: 0,0:07:04.04,0:07:05.75,Default,,0,0,0,,Сізге не істеу керек
Dialogue: 0,0:07:05.88,0:07:09.01,Default,,0,0,0,,Бұл кенепте өнер жасау туралы.
Dialogue: 0,0:07:09.17,0:07:10.59,Default,,0,0,0,,Фокус
Dialogue: 0,0:07:11.09,0:07:12.43,Default,,0,0,0,,Фокус…
Dialogue: 0,0:07:15.39,0:07:18.31,Default,,0,0,0,,Джеймс де маған осы дүкен туралы айтып берді.
Dialogue: 0,0:07:18.43,0:07:21.48,Default,,0,0,0,,Клиенттердің көңілін көтеру үшін қолданылады.
Dialogue: 0,0:07:21.77,0:07:25.52,Default,,0,0,0,,Оған менің кеше салған төртінші суретім ұнамады.
Dialogue: 0,0:07:25.65,0:07:26.90,Default,,0,0,0,,Бұл қайталау.
Dialogue: 0,0:07:27.48,0:07:30.19,Default,,0,0,0,,Жарайды, бәрібір ақша береді.
Dialogue: 0,0:07:30.32,0:07:31.82,Default,,0,0,0,,Сізге шынымен рахмет.
Dialogue: 0,0:07:33.32,0:07:35.20,Default,,0,0,0,,Тамақтанудан қорықпа
Dialogue: 0,0:07:35.32,0:07:36.83,Default,,0,0,0,,Танысқанымызға біраз болды.
Dialogue: 0,0:07:36.95,0:07:39.45,Default,,0,0,0,,Консервіленген үрме бұршақтарды қайта алғыңыз келмейді, солай ма?
Dialogue: 0,0:07:41.75,0:07:45.29,Default,,0,0,0,,Бұл жақсы емес. Ең қымбатына тапсырыс беруім керек пе?
Dialogue: 0,0:07:45.75,0:07:47.50,Default,,0,0,0,,Қанағаттанасыз ба?
Dialogue: 0,0:07:47.63,0:07:48.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:49.51,0:07:51.67,Default,,0,0,0,,Коулменмен қанша уақытты жалғастырасыз?
Dialogue: 0,0:07:52.34,0:07:53.80,Default,,0,0,0,,Э-э… «Эксперименттік нәтижелер»
Dialogue: 0,0:07:53.93,0:07:56.35,Default,,0,0,0,,Келісімшартта тағы 6 бөлік қалды.
Dialogue: 0,0:07:56.60,0:07:59.64,Default,,0,0,0,,Біз тіпті келісімшартқа да қол қойған жоқпыз. Бұл ауызша келісім, солай ма?
Dialogue: 0,0:07:59.77,0:08:01.85,Default,,0,0,0,,Ол сізді ыңғайлы түрде тастап кетуі мүмкін...
Dialogue: 0,0:08:01.98,0:08:04.60,Default,,0,0,0,,Көшіру қазір қызық.
Dialogue: 0,0:08:04.73,0:08:06.40,Default,,0,0,0,,Сіз көп нәрсені сіңіре аласыз.
Dialogue: 0,0:08:07.11,0:08:09.28,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:08:09.61,0:08:12.11,Default,,0,0,0,,Адамдар жарасымды, жарамсыз дейді.
Dialogue: 0,0:08:12.24,0:08:15.91,Default,,0,0,0,,Джеймс айтқандай, мен көшіруді жақсы білемін.
Dialogue: 0,0:08:16.03,0:08:16.91,Default,,0,0,0,,Ондай нәрсе жоқ
Dialogue: 0,0:08:17.07,0:08:18.24,Default,,0,0,0,,Жарайды, міне, гострайтингі тапсырысы формасы.
Dialogue: 0,0:08:18.37,0:08:20.62,Default,,0,0,0,,Джеймс мені таныды.
Dialogue: 0,0:08:20.75,0:08:23.37,Default,,0,0,0,,Екеуміз бір-бірімізді өз пайдамызға пайдаланып жатырмыз.
Dialogue: 0,0:08:23.50,0:08:26.71,Default,,0,0,0,,Оның істеп жүргені тек ақша табу емес пе?
Dialogue: 0,0:08:26.96,0:08:30.05,Default,,0,0,0,,Мен білемін! Мен де ақымақ емеспін
Dialogue: 0,0:08:30.17,0:08:33.42,Default,,0,0,0,,Консервіленген бұршақты жеу үшін қанша жыл күтуім керек?
Dialogue: 0,0:08:33.55,0:08:35.09,Default,,0,0,0,,Сіз бұған шыдай аласыз ба?
Dialogue: 0,0:08:36.05,0:08:38.97,Default,,0,0,0,,Осы жетістікке неге қуанбайсың?
Dialogue: 0,0:08:39.10,0:08:40.77,Default,,0,0,0,,Мен ешқандай табысқа жете алмадым.
Dialogue: 0,0:08:40.89,0:08:42.98,Default,,0,0,0,,Қолданылғаннан кейін ол жай ғана лақтырылады.
Dialogue: 0,0:08:43.27,0:08:44.81,Default,,0,0,0,,Сонымен не болды?
Dialogue: 0,0:08:45.73,0:08:48.44,Default,,0,0,0,,Сонымен не болды...?
Dialogue: 0,0:08:49.32,0:08:52.78,Default,,0,0,0,,Қандай сурет салсаң да, ол сатылмаса мағынасыз.
Dialogue: 0,0:08:53.78,0:08:55.57,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:08:57.53,0:08:58.62,Default,,0,0,0,,Мазасыздық?
Dialogue: 0,0:09:21.51,0:09:24.10,Default,,0,0,0,,Әй, қария! Асықшы!
Dialogue: 0,0:09:24.23,0:09:26.10,Default,,0,0,0,,Иә, кешіріңіз
Dialogue: 0,0:09:32.19,0:09:33.03,Default,,0,0,0,,Ах
Dialogue: 0,0:09:33.36,0:09:34.19,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:34.32,0:09:35.74,Default,,0,0,0,,Бір минут күтіңіз! (Еркектер) Әй?
Dialogue: 0,0:09:36.49,0:09:38.95,Default,,0,0,0,,Мен іздедім! Томас Майер
Dialogue: 0,0:09:39.57,0:09:40.41,Default,,0,0,0,,Эй
Dialogue: 0,0:09:41.16,0:09:43.91,Default,,0,0,0,,Сіз Томасты іздедіңіз, солай ма? Мұнда кел
Dialogue: 0,0:09:44.91,0:09:47.04,Default,,0,0,0,,Бұл жігітке не болу керек?
Dialogue: 0,0:09:48.71,0:09:49.96,Default,,0,0,0,,Жұмыс?
Dialogue: 0,0:09:50.21,0:09:51.04,Default,,0,0,0,,...
Dialogue: 0,0:09:51.17,0:09:53.92,Default,,0,0,0,,Бұл жерде барлығына жақсы әңгіме.
Dialogue: 0,0:09:55.01,0:09:59.14,Default,,0,0,0,,Басқаша айтқанда, мен сізге барлық қарыздарымды бірден өтеп жатырмын.
Dialogue: 0,0:09:59.26,0:10:02.18,Default,,0,0,0,,Не? Бұл өз ағзаңызды сатумен бірдей...
Dialogue: 0,0:10:02.31,0:10:03.60,Default,,0,0,0,,Бұлай емес!
Dialogue: 0,0:10:04.10,0:10:06.56,Default,,0,0,0,,Осындай кездерде үніңді жап, бас изеп қой!
Dialogue: 0,0:10:07.10,0:10:09.15,Default,,0,0,0,,Ал, ұсақ-түйектерді кейінге қалдырайық.
Dialogue: 0,0:10:09.27,0:10:11.86,Default,,0,0,0,,Біріншіден, сіз мас әйелді кездестіре аласыз ба?
Dialogue: 0,0:10:11.98,0:10:13.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:14.78,0:10:15.94,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:10:16.24,0:10:17.24,Default,,0,0,0,,Келіңіздер!
Dialogue: 0,0:10:21.87,0:10:23.20,Default,,0,0,0,,Гааааа…
Dialogue: 0,0:10:26.25,0:10:27.83,Default,,0,0,0,,Сәлеметсіз бе, қайырлы кеш.
Dialogue: 0,0:10:27.96,0:10:28.91,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:29.04,0:10:32.04,Default,,0,0,0,,Әй, менің бетімді ұмыттың ба?
Dialogue: 0,0:10:34.17,0:10:35.88,Default,,0,0,0,,Глоп, глоп, глоп
Dialogue: 0,0:10:36.17,0:10:39.01,Default,,0,0,0,,Мен шарапты ең қымбаты болғандықтан сақтап қойдым.
Dialogue: 0,0:10:44.01,0:10:46.52,Default,,0,0,0,,Хмм, сіз өнер дилерісіз бе?
Dialogue: 0,0:10:46.64,0:10:48.89,Default,,0,0,0,,Иә, бірақ тек қараңғыда
Dialogue: 0,0:10:49.35,0:10:50.39,Default,,0,0,0,,Қараңғылық?
Dialogue: 0,0:10:50.56,0:10:54.23,Default,,0,0,0,,Өнерді сатып алып мафияға сататын жігіт.
Dialogue: 0,0:10:54.82,0:10:57.44,Default,,0,0,0,,Актив құнына ғана қызығушылық танытатын қоқыстар
Dialogue: 0,0:10:57.86,0:10:58.99,Default,,0,0,0,,Жоқ-қ-қ-қ-қ…
Dialogue: 0,0:10:59.53,0:11:01.28,Default,,0,0,0,,Жетіспейтін өнер туындылары үшін
Dialogue: 0,0:11:01.41,0:11:05.12,Default,,0,0,0,,Бұл кісілердің меншігіндегі және қоймада сақталған заттары көп.
Dialogue: 0,0:11:05.33,0:11:09.16,Default,,0,0,0,,Мына жігіттер менің жұмысыммен ойнап жүр деп ойласам...
Dialogue: 0,0:11:09.29,0:11:12.67,Default,,0,0,0,,Мұндай зұлымдықты жаншып алсаң да, кейін қайтады.
Dialogue: 0,0:11:12.79,0:11:13.88,Default,,0,0,0,,Ешқандай шектеу жоқ
Dialogue: 0,0:11:14.42,0:11:17.63,Default,,0,0,0,,Мен сонда барсам, мұғалім керемет болды.
Dialogue: 0,0:11:18.42,0:11:21.93,Default,,0,0,0,,Жұмыстарды ашып, бізді нұрландыр.
Dialogue: 0,0:11:22.47,0:11:23.39,Default,,0,0,0,,Сен тәжірибелер жүргізіп, пулемётпен оқ жаудырып жүрсің — нағыз ақымақсың.
Dialogue: 0,0:11:31.85,0:11:34.19,Default,,0,0,0,,Хехе, сен өттің, Абигейл.
Dialogue: 0,0:11:34.81,0:11:37.40,Default,,0,0,0,,Мен сізге көбірек көмектескім келеді.
Dialogue: 0,0:11:37.61,0:11:41.70,Default,,0,0,0,,Кейде ынталы жастармен араласу жаман емес.
Dialogue: 0,0:11:42.32,0:11:45.70,Default,,0,0,0,,«Лондонның қарын» міндетті түрде қайтарайық, сэр.
Dialogue: 0,0:11:47.66,0:11:48.58,Default,,0,0,0,,Хаа…
Dialogue: 0,0:11:49.33,0:11:51.50,Default,,0,0,0,,Ал, сіз бұл жалғандықты суреттедіңіз делік.
Dialogue: 0,0:11:52.12,0:11:54.29,Default,,0,0,0,,Сіз оны қайда және кімге сатқыңыз келеді?
Dialogue: 0,0:11:54.42,0:11:55.33,Default,,0,0,0,,Коулман
Dialogue: 0,0:11:55.50,0:11:56.54,Default,,0,0,0,,Өзің жақсысың ба? Иносукэ
Dialogue: 0,0:11:56.67,0:11:58.00,Default,,0,0,0,,Мен айттым ғой.
Dialogue: 0,0:11:58.13,0:12:00.92,Default,,0,0,0,,«Қандай сурет болса да, ол сатылмаса, мағынасы жоқ».
Dialogue: 0,0:12:02.01,0:12:03.38,Default,,0,0,0,,Не өзгерді?
Dialogue: 0,0:12:03.55,0:12:04.93,Default,,0,0,0,,Сіз бұрынырақ...
Dialogue: 0,0:12:05.05,0:12:07.30,Default,,0,0,0,,Сіз бірінші болып өзгердіңіз.
Dialogue: 0,0:12:09.27,0:12:13.39,Default,,0,0,0,,Сол кезде мен Коулманмен мәңгілікке бірге боламын деп ойладым.
Dialogue: 0,0:12:13.52,0:12:17.98,Default,,0,0,0,,Қарыз жинап, ынталы, ынталы еңбек ету.
Dialogue: 0,0:12:19.57,0:12:23.40,Default,,0,0,0,,Кешіріңіз, бірақ мен қылқаламды көптен бері алмаған едім.
Dialogue: 0,0:12:23.78,0:12:25.70,Default,,0,0,0,,Мен бұрынғыдай сурет сала алмаймын.
Dialogue: 0,0:12:25.82,0:12:27.87,Default,,0,0,0,,Оның үстіне екінші тарап тым нашар.
Dialogue: 0,0:12:27.99,0:12:30.24,Default,,0,0,0,,О, бұл реабилитацияға байланысты ғой, солай ма?
Dialogue: 0,0:12:30.91,0:12:33.16,Default,,0,0,0,,Сіз мұны істей аламын деп ойлайсыз ба?
Dialogue: 0,0:12:33.37,0:12:35.54,Default,,0,0,0,,Бұл оңай емес
Dialogue: 0,0:12:35.67,0:12:37.84,Default,,0,0,0,,Бірақ бұл өте жақсы болды, солай емес пе?
Dialogue: 0,0:12:38.92,0:12:40.75,Default,,0,0,0,,Бұл баяғыда болды.
Dialogue: 0,0:12:41.38,0:12:45.26,Default,,0,0,0,,Ол кезде мен сахна актрисасы боламын деп ойлайтынмын.
Dialogue: 0,0:12:46.43,0:12:48.18,Default,,0,0,0,,Ол алаяқ...
Dialogue: 0,0:12:48.30,0:12:49.31,Default,,0,0,0,,(тұру дыбысы)
Dialogue: 0,0:12:50.81,0:12:51.97,Default,,0,0,0,,Бұл жаман әзіл
Dialogue: 0,0:12:57.65,0:12:59.27,Default,,0,0,0,,Моттайнай
Dialogue: 0,0:13:07.62,0:13:08.45,Default,,0,0,0,,
Dialogue: 0,0:13:08.57,0:13:09.41,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:09.91,0:13:12.50,Default,,0,0,0,,Сәлеметсіз бе, мен сізді баратын жеріңізге апарайын ба?
Dialogue: 0,0:13:12.87,0:13:14.37,Default,,0,0,0,,Мынау
Dialogue: 0,0:13:14.50,0:13:16.50,Default,,0,0,0,,Бірақ бұл өте серуендеу.
Dialogue: 0,0:13:16.92,0:13:18.13,Default,,0,0,0,,Мен кешірім сұрағым келеді
Dialogue: 0,0:13:18.25,0:13:22.17,Default,,0,0,0,,Мен оны осында жібердім, себебі мен сіздің жеке басыңызды білгім келді.
Dialogue: 0,0:13:23.30,0:13:25.38,Default,,0,0,0,,Ей, сенде жақсы бағыныңқы бар.
Dialogue: 0,0:13:25.51,0:13:29.64,Default,,0,0,0,,Мен олардың сол «Лондондағы қарға» ұқыптылықпен қарайтынына сенімдімін.
Dialogue: 0,0:13:30.01,0:13:33.56,Default,,0,0,0,,Мен оны бағалауға жібердім, менде жоқ.
Dialogue: 0,0:13:33.68,0:13:34.52,Default,,0,0,0,,Бағалау?
Dialogue: 0,0:13:35.06,0:13:39.06,Default,,0,0,0,,Оған сенімді болу үшін мен оны сенімді бағалаушыға қарадым.
Dialogue: 0,0:13:39.23,0:13:40.81,Default,,0,0,0,,Бұл нені білдіреді?
Dialogue: 0,0:13:40.94,0:13:42.69,Default,,0,0,0,,Міне, осыны білдіреді.
Dialogue: 0,0:13:43.73,0:13:46.28,Default,,0,0,0,,Өткенде сіз тапқан кейбір картиналар.
Dialogue: 0,0:13:46.40,0:13:48.32,Default,,0,0,0,,Мен бұған күмәнданамын.
Dialogue: 0,0:13:48.66,0:13:52.28,Default,,0,0,0,,Мен өнерпаздардың жауапсыз сөздер айтқанын ұнатпаймын.
Dialogue: 0,0:13:52.62,0:13:53.99,Default,,0,0,0,,L өліпті
Dialogue: 0,0:13:54.12,0:13:57.16,Default,,0,0,0,,«Лондондағы қар» шынайы сияқты.
Dialogue: 0,0:13:57.83,0:13:59.38,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:13:59.50,0:14:02.17,Default,,0,0,0,,Олар мұны мафияға сатпайды деп ойлаймын.
Dialogue: 0,0:14:03.00,0:14:05.51,Default,,0,0,0,,Егер сізге ұнамаса, оны аукционға қоюға болады.
Dialogue: 0,0:14:05.63,0:14:07.26,Default,,0,0,0,,Аукционға қойылады ма?
Dialogue: 0,0:14:08.01,0:14:11.18,Default,,0,0,0,,Бұл тек таңдалғандарға арналған құпия аукцион.
Dialogue: 0,0:14:12.01,0:14:14.93,Default,,0,0,0,,Уақыты мен орны анықталғаннан кейін біз сізге шақыру жібереміз.
Dialogue: 0,0:14:15.72,0:14:19.69,Default,,0,0,0,,Сіз де сол шұңқырдасыз. Сіз қатысуға толық құқылысыз.
Dialogue: 0,0:14:19.94,0:14:22.44,Default,,0,0,0,,Асыл паразит...
Dialogue: 0,0:14:24.78,0:14:27.53,Default,,0,0,0,,
Dialogue: 0,0:14:30.53,0:14:32.87,Default,,0,0,0,,Томас, сен осындасың ба?
Dialogue: 0,0:14:33.49,0:14:35.62,Default,,0,0,0,,Кішкене әңгіме тыңдайық.
Dialogue: 0,0:14:36.33,0:14:39.33,Default,,0,0,0,,Синтия, мейрамханадан келген соң.
Dialogue: 0,0:14:39.46,0:14:41.21,Default,,0,0,0,,Қиналғаныма көп болды
Dialogue: 0,0:14:41.79,0:14:42.71,Default,,0,0,0,,Ол жігіт...
Dialogue: 0,0:14:43.50,0:14:46.26,Default,,0,0,0,,Синтия сіздің қолыңызға ерекше көңіл бөледі.
Dialogue: 0,0:14:46.42,0:14:48.92,Default,,0,0,0,,Бұл суретті басқа ешкім сала алмады.
Dialogue: 0,0:14:50.22,0:14:52.76,Default,,0,0,0,,Өткенде не болғанын білмеймін.
Dialogue: 0,0:14:52.89,0:14:55.93,Default,,0,0,0,,Бірақ, сіз оған көмектесе аласыз ба?
Dialogue: 0,0:14:58.98,0:14:59.94,Default,,0,0,0,,(дыбыс құлпын ашу)
Dialogue: 0,0:15:03.98,0:15:05.61,Default,,0,0,0,,Бұл ескі күндер...
Dialogue: 0,0:15:05.73,0:15:10.45,Default,,0,0,0,,Иә, ол кезде ол қарапайым және боянбайтын еді.
Dialogue: 0,0:15:10.99,0:15:13.62,Default,,0,0,0,,Консервіленген бұршақты қуана жеп отырды.
Dialogue: 0,0:15:13.74,0:15:16.70,Default,,0,0,0,,Көп жағдайда мен сізді осы уақытта кездестірсем деп едім.
Dialogue: 0,0:15:17.33,0:15:20.33,Default,,0,0,0,,Соңғы кездері мен ішімдікті көп ішетін болдым.
Dialogue: 0,0:15:20.46,0:15:22.00,Default,,0,0,0,,Менопауза болуы мүмкін
Dialogue: 0,0:15:22.42,0:15:24.67,Default,,0,0,0,,Мен де ұқсаспын.
Dialogue: 0,0:15:25.88,0:15:27.71,Default,,0,0,0,,Егер бұл әлі Синтия туралы болса...
Dialogue: 0,0:15:27.84,0:15:29.26,Default,,0,0,0,,(Иида) Барлығы шараның рухына ене ала ма екен?
Dialogue: 0,0:15:29.59,0:15:31.18,Default,,0,0,0,,Бітті.
Dialogue: 0,0:15:31.88,0:15:33.84,Default,,0,0,0,,Олай болса, тыңдап ал.
Dialogue: 0,0:15:34.22,0:15:36.97,Default,,0,0,0,,Сіз 2 миллион иен қарыз жасадыңыз ба?
Dialogue: 0,0:15:38.81,0:15:39.64,Default,,0,0,0,,Бұл...
Dialogue: 0,0:15:40.43,0:15:44.86,Default,,0,0,0,,Мен өнер мұражайына жалғандық жасау бойынша зерттеу жүргізу үшін бардым.
Dialogue: 0,0:15:52.82,0:15:56.53,Default,,0,0,0,,Бұл мен салған жалғандық болды.
Dialogue: 0,0:15:59.50,0:16:00.66,Default,,0,0,0,,Мен қорқамын...
Dialogue: 0,0:16:03.67,0:16:05.83,Default,,0,0,0,,Мен өзімді жынданып бара жатқандай сезіндім.
Dialogue: 0,0:16:06.09,0:16:07.09,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:16:07.46,0:16:09.59,Default,,0,0,0,,Томас, сен тірісің бе?
Dialogue: 0,0:16:10.67,0:16:11.88,Default,,0,0,0,,Томас!
Dialogue: 0,0:16:12.01,0:16:12.93,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:13.22,0:16:15.39,Default,,0,0,0,,Мен бәрінен қаштым
Dialogue: 0,0:16:15.51,0:16:16.35,Default,,0,0,0,,Tsk
Dialogue: 0,0:16:17.47,0:16:18.47,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:16:18.60,0:16:19.68,Default,,0,0,0,,(шу)
Dialogue: 0,0:16:23.64,0:16:27.15,Default,,0,0,0,,Костаның «Ностальгия» Кокудың «Фортепиано мұғалімі»
Dialogue: 0,0:16:27.27,0:16:29.19,Default,,0,0,0,,Мартинестің «Сиеста»
Dialogue: 0,0:16:29.57,0:16:31.78,Default,,0,0,0,,Бұл мен салған жалғандық.
Dialogue: 0,0:16:32.44,0:16:34.82,Default,,0,0,0,,Мен оны сатып алу үшін әртүрлі әдістерді қолдандым.
Dialogue: 0,0:16:34.95,0:16:37.03,Default,,0,0,0,,Дүниеде енді ешқашан пайда болмас үшін...
Dialogue: 0,0:16:37.41,0:16:39.03,Default,,0,0,0,,О, сіз ақша қарызсыз ба?
Dialogue: 0,0:16:39.16,0:16:41.54,Default,,0,0,0,,Өзім еккен дәнім.
Dialogue: 0,0:16:43.33,0:16:45.12,Default,,0,0,0,,Сондықтан мен шештім
Dialogue: 0,0:16:45.25,0:16:47.33,Default,,0,0,0,,Мен енді ешқашан сурет салмаймын
Dialogue: 0,0:16:47.58,0:16:50.30,Default,,0,0,0,,Жалғандық әлдеқайда аз.
Dialogue: 0,0:16:51.34,0:16:52.97,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:16:53.09,0:16:57.80,Default,,0,0,0,,Жалған ақшаны қарызға алу және қарызды жабу үшін жалғандық жасау?
Dialogue: 0,0:16:58.01,0:16:59.39,Default,,0,0,0,,Бұл бос сөз.
Dialogue: 0,0:16:59.60,0:17:00.64,Default,,0,0,0,,Хаа…
Dialogue: 0,0:17:00.89,0:17:03.35,Default,,0,0,0,,Мен оны Синтияның үйінен жасырын әкелдім.
Dialogue: 0,0:17:04.23,0:17:05.64,Default,,0,0,0,,Бұл таныс сияқты ма?
Dialogue: 0,0:17:26.79,0:17:27.96,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:29.59,0:17:32.84,Default,,0,0,0,,Мен сізге әлі нақты нәрсені бере алмаймын...
Dialogue: 0,0:17:33.38,0:17:36.34,Default,,0,0,0,,Сіз не туралы айтып отырсыз? Бұл шынайы.
Dialogue: 0,0:17:39.85,0:17:41.06,Default,,0,0,0,,Хехе
Dialogue: 0,0:17:46.48,0:17:49.06,Default,,0,0,0,,Синтия сенімен ажырасқаннан бері.
Dialogue: 0,0:17:49.19,0:17:50.81,Default,,0,0,0,,Ештеңе өзгерген жоқ
Dialogue: 0,0:17:51.23,0:17:54.40,Default,,0,0,0,,Мен сені алып кетуіңді күттім!
Dialogue: 0,0:17:56.15,0:17:57.20,Default,,0,0,0,,тым кеш...
Dialogue: 0,0:17:57.91,0:17:59.74,Default,,0,0,0,,Өйткені сен осылай қыңырсың.
Dialogue: 0,0:17:59.87,0:18:01.91,Default,,0,0,0,,Синтия қозғала бастады.
Dialogue: 0,0:18:02.37,0:18:04.37,Default,,0,0,0,,Онымен мәселені шешу.
Dialogue: 0,0:18:04.50,0:18:05.33,Default,,0,0,0,,Есеп айырысу?
Dialogue: 0,0:18:05.95,0:18:09.96,Default,,0,0,0,,Сізді жалған суретші болуға жетелеген Коулманмен есеп айырысу.
Dialogue: 0,0:18:10.21,0:18:12.46,Default,,0,0,0,,Бірақ жалғыз Синтия ештеңе істей алмайды.
Dialogue: 0,0:18:13.42,0:18:15.84,Default,,0,0,0,,Енді әлі де кеш емес.
Dialogue: 0,0:18:15.96,0:18:18.26,Default,,0,0,0,,Енді қадам жасау кезегі сізде!
Dialogue: 0,0:18:20.43,0:18:23.06,Default,,0,0,0,,Осыған нүкте қоя алсам
Dialogue: 0,0:18:24.22,0:18:26.56,Default,,0,0,0,,Мен нағыз адам болуға қайта орала аламын ба деп ойлаймын.
Dialogue: 0,0:18:27.94,0:18:29.69,Default,,0,0,0,,Сол кездегі Синтияға
Dialogue: 0,0:18:31.31,0:18:32.86,Default,,0,0,0,,Эй, бұл жер...
Dialogue: 0,0:18:34.02,0:18:36.24,Default,,0,0,0,,Хехе, іштей.
Dialogue: 0,0:18:36.99,0:18:39.45,Default,,0,0,0,,Бөлменің орналасуын Синтия қадағалады.
Dialogue: 0,0:18:40.11,0:18:41.16,Default,,0,0,0,,Дегенмен
Dialogue: 0,0:18:41.28,0:18:43.83,Default,,0,0,0,,Перделер мен төсек әлі келген жоқ.
Dialogue: 0,0:18:43.95,0:18:45.24,Default,,0,0,0,,Амансың ба?
Dialogue: 0,0:18:45.37,0:18:46.20,Default,,0,0,0,,О
Dialogue: 0,0:18:47.91,0:18:51.71,Default,,0,0,0,,Серхио Монтойя «Лондондағы қар»
Dialogue: 0,0:18:51.92,0:18:53.13,Default,,0,0,0,,Сіз сурет сала білуіңіз керек пе?
Dialogue: 0,0:18:53.59,0:18:56.76,Default,,0,0,0,,Мен Монтойяны бірнеше рет қолданып көрдім.
Dialogue: 0,0:18:56.88,0:18:58.88,Default,,0,0,0,,Бұл ешқашан орындалмаған.
Dialogue: 0,0:18:59.88,0:19:03.39,Default,,0,0,0,,Бірақ егер нақты нәрсе жақын болса...
Dialogue: 0,0:19:11.85,0:19:13.73,Default,,0,0,0,,Мен сізге көмектесе алатын нәрсе бар ма?
Dialogue: 0,0:19:14.86,0:19:15.90,Default,,0,0,0,,Томас?
Dialogue: 0,0:20:05.24,0:20:07.53,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:20:08.95,0:20:10.33,Default,,0,0,0,,Тыныс алып жатқан сияқты.
Dialogue: 0,0:20:11.21,0:20:13.87,Default,,0,0,0,,Мердігерді шақыратындай лас.
Dialogue: 0,0:20:18.92,0:20:20.34,Default,,0,0,0,,Неге тағы ұйықтап қалмақсың!
Dialogue: 0,0:20:20.71,0:20:22.84,Default,,0,0,0,,Ол жай ғана қарт адам емес еді.
Dialogue: 0,0:20:23.26,0:20:24.43,Default,,0,0,0,,Мені есіңде бар ғой, иә?
Dialogue: 0,0:20:25.93,0:20:27.10,Default,,0,0,0,,Синтия
Dialogue: 0,0:20:27.93,0:20:30.64,Default,,0,0,0,,Ескі инстинкттерін қалпына келтіру, Томас
Dialogue: 0,0:20:30.77,0:20:32.94,Default,,0,0,0,,Міне, мен өмірімді қатерге тігіп сурет салдым.
Dialogue: 0,0:20:33.98,0:20:35.69,Default,,0,0,0,,Томас мұның бәрін жасады.
Dialogue: 0,0:20:36.65,0:20:39.07,Default,,0,0,0,,Бұл жігіттің жұмысы ақша үшін емес.
Dialogue: 0,0:20:39.61,0:20:40.53,Default,,0,0,0,,Бұл сізге арналған.
Dialogue: 0,0:20:42.07,0:20:43.82,Default,,0,0,0,,Мұны байыппен қабылдаңыз
Dialogue: 0,0:20:45.36,0:20:46.95,Default,,0,0,0,,Томас және сіз де
Dialogue: 0,0:20:47.32,0:20:49.12,Default,,0,0,0,,Әлі де сол кездегідей екеніне сенімдімін.
Dialogue: 0,0:20:51.08,0:20:57.08,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.69,0:22:50.70,Default,,0,0,0,,~♪
