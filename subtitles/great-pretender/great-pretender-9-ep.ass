Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.12,0:00:03.37,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:00:04.08,0:00:06.92,Default,,0,0,0,,Иә? Бірге кірейік пе?
Dialogue: 0,0:00:07.04,0:00:08.59,Default,,0,0,0,,Сіз бұрынғы жауынгерсіз бе?
Dialogue: 0,0:00:08.75,0:00:09.88,Default,,0,0,0,,Не?
Dialogue: 0,0:00:10.30,0:00:12.34,Default,,0,0,0,,Льюис бұрынғы әскери қызметкер ме?
Dialogue: 0,0:00:13.68,0:00:14.72,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:00:14.84,0:00:21.77,Default,,0,0,0,,(Шыңырау)
Dialogue: 0,0:00:24.35,0:00:25.44,Default,,0,0,0,,Эбби
Dialogue: 0,0:00:28.06,0:00:29.02,Default,,0,0,0,,Эбби?
Dialogue: 0,0:00:29.32,0:00:30.28,Default,,0,0,0,,Ха…
Dialogue: 0,0:00:30.98,0:00:32.15,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:00:32.44,0:00:35.66,Default,,0,0,0,,Хмм... Мен ұйықтап жатырмын.
Dialogue: 0,0:00:35.86,0:00:37.91,Default,,0,0,0,,Бұл сізге сәйкес болуы мүмкін.
Dialogue: 0,0:00:38.78,0:00:40.08,Default,,0,0,0,,Қалыпты ұшыңыз
Dialogue: 0,0:00:41.08,0:00:43.37,Default,,0,0,0,,Әлсіреп қалма — жолды бөгеп тұрсың.
Dialogue: 0,0:00:52.17,0:00:55.05,Default,,0,0,0,,(винт дыбысы)
Dialogue: 0,0:01:09.73,0:01:10.90,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:01:15.57,0:01:16.40,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:01:22.37,0:01:28.37,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:02:20.68,0:02:26.68,Default,,0,0,0,,~♪
Dialogue: 0,0:02:27.93,0:02:29.23,Default,,0,0,0,,
Dialogue: 0,0:02:30.48,0:02:32.40,Default,,0,0,0,,Турнир 2-тур 3-ші жарыс
Dialogue: 0,0:02:33.27,0:02:36.73,Default,,0,0,0,,Қызғылт ұшақ №38 Дон Родригеске қарсы
Dialogue: 0,0:02:36.99,0:02:39.90,Default,,0,0,0,,Күлгін машина №14 Абигейл Джонс
Dialogue: 0,0:02:40.86,0:02:44.41,Default,,0,0,0,,Коэффициенттер: Родригес 1.4 Абигейл 3.5
Dialogue: 0,0:02:45.29,0:02:48.91,Default,,0,0,0,,Екі құрылғы да күту режимінде. Қабылдау жақын арада аяқталады.
Dialogue: 0,0:02:49.41,0:02:52.00,Default,,0,0,0,,Әйелге бәс тігуім керек пе? (Адам В) Тоқта.
Dialogue: 0,0:02:52.54,0:02:54.09,Default,,0,0,0,,Өзіңізді жеңіл сезінген болуыңыз керек.
Dialogue: 0,0:02:54.21,0:02:55.04,Default,,0,0,0,,Менің есімде жақсы.
Dialogue: 0,0:02:55.17,0:02:56.00,Default,,0,0,0,,Сэм
Dialogue: 0,0:02:56.17,0:02:57.30,Default,,0,0,0,,Майк
Dialogue: 0,0:02:57.42,0:02:59.84,Default,,0,0,0,,Сонда сіз қанша әкелдіңіз?
Dialogue: 0,0:03:00.05,0:03:01.13,Default,,0,0,0,,300 000
Dialogue: 0,0:03:01.26,0:03:05.39,Default,,0,0,0,,300 000! Бастапқыда мен саған кішкентай болсын дедім.
Dialogue: 0,0:03:05.51,0:03:07.14,Default,,0,0,0,,Мен оны аз қалдыруды мақсат етіп отырмын.
Dialogue: 0,0:03:07.52,0:03:09.02,Default,,0,0,0,,Егер сіз бәрібір бәс тігетін болсаңыз
Dialogue: 0,0:03:09.14,0:03:11.19,Default,,0,0,0,,Бұлай болмаса қызық болмас еді.
Dialogue: 0,0:03:11.39,0:03:13.02,Default,,0,0,0,,Күдікті болыңыз
Dialogue: 0,0:03:13.15,0:03:15.86,Default,,0,0,0,,Егер сіздің жеке тұлғаңыз анықталса, сізге кіруге немесе шығуға тыйым салынады.
Dialogue: 0,0:03:15.98,0:03:17.98,Default,,0,0,0,,Тіркеу жақында жабылады
Dialogue: 0,0:03:19.90,0:03:22.66,Default,,0,0,0,,Абигейл Джонсқа 300 000 доллар.
Dialogue: 0,0:03:23.24,0:03:24.66,Default,,0,0,0,,мұнда өркениет бұрыннан-ақ бар еді.
Dialogue: 0,0:03:24.78,0:03:26.20,Default,,0,0,0,,Мен үлкен бәс тігемін.
Dialogue: 0,0:03:26.70,0:03:28.16,Default,,0,0,0,,Сіз сенімдісіз бе?
Dialogue: 0,0:03:28.29,0:03:29.79,Default,,0,0,0,,Жоғарғы шек жоқ... дұрыс па?
Dialogue: 0,0:03:30.37,0:03:31.46,Default,,0,0,0,,Менеджер
Dialogue: 0,0:03:31.87,0:03:33.67,Default,,0,0,0,,Мүмкіндіктер сәл төмен болса да
Dialogue: 0,0:03:34.00,0:03:35.17,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:03:35.96,0:03:37.09,Default,,0,0,0,,Оны қабылдаңыз.
Dialogue: 0,0:03:38.09,0:03:40.34,Default,,0,0,0,,300 000 доллар қабылданды
Dialogue: 0,0:03:41.30,0:03:46.60,Default,,0,0,0,,(винттік ұшақтың ұшу дыбысы)
Dialogue: 0,0:04:00.24,0:04:02.07,Default,,0,0,0,,О... шынымен бе?
Dialogue: 0,0:04:02.74,0:04:04.32,Default,,0,0,0,,Бұл қайтарылатын болады.
Dialogue: 0,0:04:04.53,0:04:09.83,Default,,0,0,0,,
Dialogue: 0,0:04:10.58,0:04:12.16,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,0:04:13.71,0:04:14.67,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:14.87,0:04:17.75,Default,,0,0,0,,Қош келдіңіз, Майк.
Dialogue: 0,0:04:18.17,0:04:21.38,Default,,0,0,0,,Масато, мен бүгін өте көңілді болдым.
Dialogue: 0,0:04:21.51,0:04:22.34,Default,,0,0,0,,О
Dialogue: 0,0:04:25.39,0:04:28.35,Default,,0,0,0,,Әй, сен маған жақсы нәрсені үйреттің.
Dialogue: 0,0:04:28.47,0:04:30.39,Default,,0,0,0,,Сізге ұнағанына қуаныштымын.
Dialogue: 0,0:04:30.52,0:04:32.23,Default,,0,0,0,,Келесі жолы жалғыз қалған дұрыс.
Dialogue: 0,0:04:33.06,0:04:34.56,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:04:34.69,0:04:37.69,Default,,0,0,0,,Сіз құмар ойындардың қызығынан ләззат ала алмайсыз.
Dialogue: 0,0:04:41.40,0:04:43.44,Default,,0,0,0,,Іс жақсы жүріп жатқан сияқты.
Dialogue: 0,0:04:43.65,0:04:45.28,Default,,0,0,0,,Жақсы өтіп жатқан сияқты
Dialogue: 0,0:04:45.41,0:04:47.91,Default,,0,0,0,,Кенеттен сейф бос.
Dialogue: 0,0:04:48.28,0:04:51.16,Default,,0,0,0,,Кешіріңіз, тамақ құны өсті.
Dialogue: 0,0:04:51.29,0:04:52.75,Default,,0,0,0,,Менің таңдауым жоқ.
Dialogue: 0,0:04:52.87,0:04:55.58,Default,,0,0,0,,Балық ауламас бұрын оны барынша семіз етейік.
Dialogue: 0,0:04:56.17,0:04:59.09,Default,,0,0,0,,Бірақ Сэм тереңірек баруы керек пе?
Dialogue: 0,0:04:59.29,0:05:00.92,Default,,0,0,0,,Мен сенетініне сенімдімін.
Dialogue: 0,0:05:01.05,0:05:04.42,Default,,0,0,0,,Өйткені, ол жарыстың нәтижесін шеше алады.
Dialogue: 0,0:05:04.55,0:05:06.26,Default,,0,0,0,,Бұл сөзсіз пайдалы.
Dialogue: 0,0:05:06.68,0:05:08.55,Default,,0,0,0,,Бұл күлкілі емес пе?
Dialogue: 0,0:05:08.80,0:05:09.85,Default,,0,0,0,,Әрине
Dialogue: 0,0:05:09.97,0:05:12.64,Default,,0,0,0,,Осымен бір рет жалықтыруыңыз мүмкін.
Dialogue: 0,0:05:13.02,0:05:16.39,Default,,0,0,0,,Олай болса, тегін ішіп-жеу керек.
Dialogue: 0,0:05:16.60,0:05:18.19,Default,,0,0,0,,Бақытымызға орай
Dialogue: 0,0:05:18.35,0:05:21.57,Default,,0,0,0,,Олардың қаржылық жағдайы сіз ойлағандай жомарт емес.
Dialogue: 0,0:05:22.32,0:05:25.32,Default,,0,0,0,,Әзірге ақша табудың жалғыз жолы - әуе жарысы.
Dialogue: 0,0:05:25.90,0:05:29.95,Default,,0,0,0,,Сондықтан мен қолымнан келгеннің барлығын жандандыруға тырысамын.
Dialogue: 0,0:05:30.12,0:05:32.95,Default,,0,0,0,,Басқаша айтқанда, ол әрқашан тереңдей түседі.
Dialogue: 0,0:05:33.37,0:05:36.91,Default,,0,0,0,,Сонымен қатар, адамның қалауы шексіз.
Dialogue: 0,0:05:37.21,0:05:38.79,Default,,0,0,0,,Түсінгеніңізге сенімдімін.
Dialogue: 0,0:05:40.08,0:05:40.92,Default,,0,0,0,,Хмф!
Dialogue: 0,0:05:41.34,0:05:44.38,Default,,0,0,0,,Алаяқтық ойыны өте қызық сияқты.
Dialogue: 0,0:05:45.38,0:05:48.80,Default,,0,0,0,,Медицина одан әлдеқайда жақсы.
Dialogue: 0,0:05:48.93,0:05:50.09,Default,,0,0,0,,Ас үшін рахмет
Dialogue: 0,0:05:51.18,0:05:52.06,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:05:52.51,0:05:54.93,Default,,0,0,0,,Ақыр соңында, мен не жақсымын?
Dialogue: 0,0:05:55.22,0:05:56.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:57.64,0:05:59.40,Default,,0,0,0,,Бір нәрсе... әртүрлі заттар
Dialogue: 0,0:05:59.52,0:06:00.35,Default,,0,0,0,,Жоқ
Dialogue: 0,0:06:00.98,0:06:02.98,Default,,0,0,0,,Сіз оны мүмкіндігінше қатты бұраңыз.
Dialogue: 0,0:06:22.63,0:06:29.51,Default,,0,0,0,,(«Жануарлар карнавалы» сюитасы)
Dialogue: 0,0:06:42.31,0:06:45.94,Default,,0,0,0,,(Шапалақтау)
Dialogue: 0,0:06:54.49,0:06:56.20,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:06:58.70,0:07:00.71,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:01.25,0:07:04.71,Default,,0,0,0,,(соғыс ұшағы ұшу дыбысы)
Dialogue: 0,0:07:10.05,0:07:13.85,Default,,0,0,0,,(Ұшақтың ұшу дыбысы)
Dialogue: 0,0:07:13.97,0:07:14.85,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:07:15.47,0:07:16.85,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:07:17.01,0:07:21.52,Default,,0,0,0,,(Қуаныштар алыстан жаңғырық)
Dialogue: 0,0:07:23.69,0:07:24.69,Default,,0,0,0,,Хаа…
Dialogue: 0,0:07:26.07,0:07:28.99,Default,,0,0,0,,Абигейл Джонсқа бір миллион доллар.
Dialogue: 0,0:07:29.11,0:07:32.11,Default,,0,0,0,,1 миллион? Хмм...
Dialogue: 0,0:07:32.66,0:07:37.45,Default,,0,0,0,,Абигейлдің коэффициенті 3,0, тіпті егер олар аздап төмендесе де...
Dialogue: 0,0:07:37.58,0:07:38.41,Default,,0,0,0,,Изуку Мидория…
Dialogue: 0,0:07:38.87,0:07:41.91,Default,,0,0,0,,Сәлем! Ешқандай жоғарғы шегі жоқ деп мәлімдегенімен
Dialogue: 0,0:07:42.04,0:07:45.88,Default,,0,0,0,,Менің ойымша, олар оны өткізіп жібермейді, өйткені олар төлеуге дайын емес.
Dialogue: 0,0:07:46.00,0:07:48.13,Default,,0,0,0,,Әрине, бізде дайын.
Dialogue: 0,0:07:48.80,0:07:51.38,Default,,0,0,0,,Мен оны қабылдаймын, 1 миллион доллар.
Dialogue: 0,0:07:51.51,0:07:52.47,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:58.76,0:08:00.89,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:05.52,0:08:07.77,Default,,0,0,0,,
Dialogue: 0,0:08:08.23,0:08:09.98,Default,,0,0,0,,Мен қайтадан келемін.
Dialogue: 0,0:08:11.36,0:08:14.24,Default,,0,0,0,,Күте тұрыңыз, Майк, жоқ...
Dialogue: 0,0:08:14.99,0:08:16.91,Default,,0,0,0,,Құрметті Сэм Ибрахим
Dialogue: 0,0:08:17.37,0:08:19.79,Default,,0,0,0,,Сіз әуе жарысына қатысасыз.
Dialogue: 0,0:08:19.91,0:08:21.54,Default,,0,0,0,,Бұл Сэм Ибрагим.
Dialogue: 0,0:08:22.79,0:08:24.04,Default,,0,0,0,,Сонда ше?
Dialogue: 0,0:08:24.58,0:08:28.71,Default,,0,0,0,,Кешірім сұраймыз, бірақ келесі жолы бізге келмеуіңізді сұраймыз.
Dialogue: 0,0:08:28.96,0:08:32.01,Default,,0,0,0,,Бұл кіруге және шығуға тыйым салынғанын білдіре ме?
Dialogue: 0,0:08:32.17,0:08:33.38,Default,,0,0,0,,Қош бол
Dialogue: 0,0:08:33.63,0:08:37.43,Default,,0,0,0,,Мен қонақ ретінде рахаттанып жатырмын.
Dialogue: 0,0:08:37.60,0:08:38.43,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:39.31,0:08:41.39,Default,,0,0,0,,Сіз өзіңіздің жеке басыңыз туралы өтірік айттыңыз.
Dialogue: 0,0:08:41.81,0:08:45.44,Default,,0,0,0,,Біздің дүкен мүшелерімізбен сенімді қарым-қатынасқа негізделген.
Dialogue: 0,0:08:45.85,0:08:50.23,Default,,0,0,0,,Егер әрекет зиян келтіреді деп есептелсе, мүшелік тоқтатылады.
Dialogue: 0,0:08:51.48,0:08:52.49,Default,,0,0,0,,Үйге қош келдіңіз
Dialogue: 0,0:08:54.15,0:08:55.49,Default,,0,0,0,,Ұстамаңыз!
Dialogue: 0,0:08:56.28,0:09:00.12,Default,,0,0,0,,Жарайды, мен кетемін. Мен ақшаны аламын.
Dialogue: 0,0:09:04.54,0:09:08.71,Default,,0,0,0,,(винттік ұшақтың ұшу дыбысы)
Dialogue: 0,0:09:14.80,0:09:17.68,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:09:18.01,0:09:20.35,Default,,0,0,0,,Жақсы жұмыс! Ұшақ ше?
Dialogue: 0,0:09:20.72,0:09:21.93,Default,,0,0,0,,Керемет
Dialogue: 0,0:09:22.06,0:09:24.35,Default,,0,0,0,,Масато техникалық қызмет көрсетуді бастады.
Dialogue: 0,0:09:24.48,0:09:25.56,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:09:25.69,0:09:27.35,Default,,0,0,0,,Үйренсең, одан да өседі.
Dialogue: 0,0:09:27.48,0:09:28.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:29.31,0:09:31.36,Default,,0,0,0,,Көңіл-күйі нашар сияқты.
Dialogue: 0,0:09:31.90,0:09:34.61,Default,,0,0,0,,Оған сол астыртын казиноға кіруге тыйым салынды.
Dialogue: 0,0:09:34.74,0:09:35.65,Default,,0,0,0,,Хаа…
Dialogue: 0,0:09:35.99,0:09:38.49,Default,,0,0,0,,Ей, сенің рахатың жеткілікті болды ғой, солай емес пе?
Dialogue: 0,0:09:38.78,0:09:41.20,Default,,0,0,0,,Жарысқа қатысу үшін ақша қажет.
Dialogue: 0,0:09:41.33,0:09:43.33,Default,,0,0,0,,Сіз ойлағаннан да көп!
Dialogue: 0,0:09:43.62,0:09:47.50,Default,,0,0,0,,Мен астыртын казинода операциялық қаражат табу туралы ешқашан естіген емеспін.
Dialogue: 0,0:09:47.62,0:09:50.50,Default,,0,0,0,,Бұл менің соңғы өтінішім
Dialogue: 0,0:09:50.88,0:09:52.67,Default,,0,0,0,,Жаңбыр көп жауады
Dialogue: 0,0:09:52.88,0:09:55.01,Default,,0,0,0,,Оның орнына неге бармайсың?
Dialogue: 0,0:09:55.13,0:09:55.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:56.55,0:09:59.18,Default,,0,0,0,,Тек Сэмге тыйым салынды.
Dialogue: 0,0:09:59.76,0:10:01.85,Default,,0,0,0,,Бізден бас тартуға ешқандай себеп болмауы керек.
Dialogue: 0,0:10:02.22,0:10:06.73,Default,,0,0,0,,Бірақ мен көп ақшаны жаман жігітке сеніп тапсырамын ба деп уайымдаймын.
Dialogue: 0,0:10:09.85,0:10:11.98,Default,,0,0,0,,(Шәй жұтып отырған дыбыс)
Dialogue: 0,0:10:14.61,0:10:17.11,Default,,0,0,0,,(Шәй жұтып отырған дыбыс)
Dialogue: 0,0:10:17.36,0:10:18.82,Default,,0,0,0,,Камado Танжиро.
Dialogue: 0,0:10:19.49,0:10:22.37,Default,,0,0,0,,(Шәй жұтып отырған дыбыс)
Dialogue: 0,0:10:23.41,0:10:25.24,Default,,0,0,0,,Дәл 2,5 млн
Dialogue: 0,0:10:25.91,0:10:28.25,Default,,0,0,0,,Осы... барлығына бәс тігу керек пе?
Dialogue: 0,0:10:28.54,0:10:29.92,Default,,0,0,0,,Бұл соңы
Dialogue: 0,0:10:30.04,0:10:32.08,Default,,0,0,0,,Мен саған сенбеймін дегенім емес, бірақ
Dialogue: 0,0:10:32.21,0:10:35.88,Default,,0,0,0,,Қауіпсіздікті сақтау үшін қол астындағы қызметкеріңізден сізбен бірге дүкеннің алдына баруын сұраңыз.
Dialogue: 0,0:10:36.01,0:10:37.13,Default,,0,0,0,,Түсіндім.
Dialogue: 0,0:10:37.26,0:10:40.47,Default,,0,0,0,,Бірақ сіз Абигейлге бәс тігуге болмайды.
Dialogue: 0,0:10:41.22,0:10:43.68,Default,,0,0,0,,Мен сенің хабаршыңмын деген сияқты.
Dialogue: 0,0:10:44.51,0:10:47.48,Default,,0,0,0,,Хм... Басқа картаны пайдалануым керек пе?
Dialogue: 0,0:10:48.73,0:10:49.81,Default,,0,0,0,,Кайо?
Dialogue: 0,0:10:50.31,0:10:52.10,Default,,0,0,0,,Кайо Висконти
Dialogue: 0,0:10:52.23,0:10:55.11,Default,,0,0,0,,Ол жас және сүйкімді жүзді бала.
Dialogue: 0,0:10:55.36,0:10:59.36,Default,,0,0,0,,Олар оған жартылай финалға шығуға және Кларкпен жұдырықтасуға мүмкіндік беретіндерін айтты.
Dialogue: 0,0:10:59.90,0:11:01.70,Default,,0,0,0,,Жарайсың Эдамаме
Dialogue: 0,0:11:01.86,0:11:02.70,Default,,0,0,0,,Хмф!
Dialogue: 0,0:11:07.50,0:11:08.37,Default,,0,0,0,,Шабуыл
Dialogue: 0,0:11:08.62,0:11:10.16,Default,,0,0,0,,Инишо медицинасы
Dialogue: 0,0:11:10.29,0:11:11.12,Default,,0,0,0,,Ішемін бе?
Dialogue: 0,0:11:11.62,0:11:14.13,Default,,0,0,0,,Жоқ, жоқ, ол тым үлкен.
Dialogue: 0,0:11:14.67,0:11:16.88,Default,,0,0,0,,Жылқы суппозиторийлері осыншама үлкен, солай ма?
Dialogue: 0,0:11:17.00,0:11:17.84,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:11:17.96,0:11:19.22,Default,,0,0,0,,Бұл үлкенірек емес пе?
Dialogue: 0,0:11:19.34,0:11:22.89,Default,,0,0,0,,Қолды сыйғызу керек. Қол мүмкін емес.
Dialogue: 0,0:11:36.86,0:11:39.99,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:11:51.08,0:11:51.91,Default,,0,0,0,,Эй!
Dialogue: 0,0:11:53.42,0:11:54.25,Default,,0,0,0,,《Бірақ Узуи Иносукэ мен басқалармен бірге ме?》
Dialogue: 0,0:11:56.59,0:12:00.21,Default,,0,0,0,,Ха ха ха...! (пышақ ұрған дыбыс)
Dialogue: 0,0:12:00.34,0:12:02.72,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:12:02.84,0:12:05.47,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:12:09.14,0:12:09.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:12:15.90,0:12:16.73,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:12:17.31,0:12:21.57,Default,,0,0,0,,(мылтық ату дыбысы)
Dialogue: 0,0:12:23.32,0:12:24.16,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:25.49,0:12:28.37,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,0:12:30.04,0:12:37.04,Default,,0,0,0,,(Шыңырау)
Dialogue: 0,0:13:22.46,0:13:27.72,Default,,0,0,0,,(винттік ұшақтың ұшу дыбысы)
Dialogue: 0,0:13:42.90,0:13:43.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:48.61,0:13:49.45,Default,,0,0,0,,Мен де солай ойладым, бірақ бұл шешімді талқылаудың қажеті жоқ
Dialogue: 0,0:13:50.03,0:13:51.62,Default,,0,0,0,,Мен мәселені білемін!
Dialogue: 0,0:13:51.74,0:13:53.20,Default,,0,0,0,,(Лифттің келу дыбысы)
Dialogue: 0,0:13:54.12,0:13:55.50,Default,,0,0,0,,Жарайды
Dialogue: 0,0:13:56.50,0:13:58.67,Default,,0,0,0,,
Dialogue: 0,0:14:03.80,0:14:06.22,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:14:07.09,0:14:11.05,Default,,0,0,0,,Масато: Кайоға дұрыс бәс тіктіңіз бе? Мүмкіндіктер қандай?
Dialogue: 0,0:14:11.43,0:14:12.93,Default,,0,0,0,,Ха ха ха!
Dialogue: 0,0:14:13.51,0:14:16.89,Default,,0,0,0,,Бұл 7,5 миллион ба? Жарайсың!
Dialogue: 0,0:14:20.10,0:14:21.61,Default,,0,0,0,,Ұшқаннан кейін бірден батыстан жел соқты...
Dialogue: 0,0:14:21.73,0:14:22.57,Default,,0,0,0,,Сәлем
Dialogue: 0,0:14:24.36,0:14:26.57,Default,,0,0,0,,Маған экскурсия жасауға бола ма?
Dialogue: 0,0:14:27.57,0:14:28.95,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:14:29.15,0:14:31.32,Default,,0,0,0,,Мен сенімдімін Абигейл Джонс...
Dialogue: 0,0:14:31.78,0:14:34.41,Default,,0,0,0,,Аа, сіз білетініңізге қуаныштымын.
Dialogue: 0,0:14:34.74,0:14:37.41,Default,,0,0,0,,Сіздің машинаңыз өте тартымды
Dialogue: 0,0:14:38.08,0:14:40.62,Default,,0,0,0,,Сонымен... солай ма? Тіпті сіздің машинаңыз ...
Dialogue: 0,0:14:41.17,0:14:44.92,Default,,0,0,0,,Сіз өте қатыгез адамсыз, солай емес пе?
Dialogue: 0,0:14:45.38,0:14:48.13,Default,,0,0,0,,Жас болсаң да, ғажап техниксің.
Dialogue: 0,0:14:48.72,0:14:50.51,Default,,0,0,0,,А, мен де соны қарап көрейін бе?
Dialogue: 0,0:14:50.63,0:14:52.09,Default,,0,0,0,,Е... Иә, өтінемін!
Dialogue: 0,0:14:52.22,0:14:55.10,Default,,0,0,0,,Иә! Бұл мүмкін бе?
Dialogue: 0,0:15:04.82,0:15:05.69,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:06.82,0:15:08.03,Default,,0,0,0,,Баратын уақыт келді
Dialogue: 0,0:15:08.74,0:15:10.11,Default,,0,0,0,,Уау! Мен сені сүйем
Dialogue: 0,0:15:11.28,0:15:13.82,Default,,0,0,0,,Ах... Рахмет. Мен қолымнан келгеннің бәрін жасаймын!
Dialogue: 0,0:15:14.20,0:15:16.91,Default,,0,0,0,,Мен дені сау ұлдарды жақсы көремін
Dialogue: 0,0:15:17.45,0:15:22.33,Default,,0,0,0,,(винттік ұшақтың ұшу дыбысы)
Dialogue: 0,0:15:26.50,0:15:28.59,Default,,0,0,0,,Бұл капсула қандай зат?
Dialogue: 0,0:15:28.84,0:15:30.76,Default,,0,0,0,,Өте қарапайым
Dialogue: 0,0:15:30.88,0:15:34.22,Default,,0,0,0,,Капсула ериді және дәрі маймен араласа бастайды.
Dialogue: 0,0:15:34.93,0:15:38.22,Default,,0,0,0,,Қозғалтқышқа барғанда, айналу жылдамдығы бірте-бірте азаяды.
Dialogue: 0,0:15:39.35,0:15:40.81,Default,,0,0,0,,Табиғи түрде тоқтап қалу
Dialogue: 0,0:15:40.94,0:15:42.98,Default,,0,0,0,,(винттің тұрақсыз дыбысы)
Dialogue: 0,0:15:44.27,0:15:46.23,Default,,0,0,0,,Ах... у... уһ?
Dialogue: 0,0:15:49.90,0:15:54.03,Default,,0,0,0,,Бәлкім, Сэм Льюисте пайдаланған сияқты.
Dialogue: 0,0:15:54.16,0:15:56.41,Default,,0,0,0,,Не болды? Сен не істеп жатырсың?
Dialogue: 0,0:15:56.53,0:15:58.33,Default,,0,0,0,,Иә? Ана жерде!
Dialogue: 0,0:16:01.08,0:16:03.08,Default,,0,0,0,,Кайо~!
Dialogue: 0,0:16:04.38,0:16:08.05,Default,,0,0,0,,Теңізге шұғыл қонатын болсаңыз, үлкен апат болмайды.
Dialogue: 0,0:16:08.30,0:16:09.17,Default,,0,0,0,,Мүмкін.
Dialogue: 0,0:16:10.46,0:16:12.34,Default,,0,0,0,,Төлем жинау!
Dialogue: 0,0:16:12.59,0:16:14.72,Default,,0,0,0,,Хаа~
Dialogue: 0,0:16:14.84,0:16:16.60,Default,,0,0,0,,Қош келдіңіздер~ Барлығына
Dialogue: 0,0:16:17.18,0:16:20.47,Default,,0,0,0,,Сен қатты ашулысың, Сэм.
Dialogue: 0,0:16:20.68,0:16:22.14,Default,,0,0,0,,Мені жұбатыңыз.
Dialogue: 0,0:16:22.69,0:16:23.64,Default,,0,0,0,,Хаа…
Dialogue: 0,0:16:25.02,0:16:26.69,Default,,0,0,0,,Сіз нені айтасыз!
Dialogue: 0,0:16:26.81,0:16:27.65,Default,,0,0,0,,(Балға ату дыбысы)
Dialogue: 0,0:16:27.77,0:16:30.03,Default,,0,0,0,,7,5 миллион доллар ештеңе емес!
Dialogue: 0,0:16:30.19,0:16:32.95,Default,,0,0,0,,Күте тұрыңыз, жай ғана тынышталыңыз!
Dialogue: 0,0:16:33.32,0:16:34.15,Default,,0,0,0,,Әй, қойшы енді.
Dialogue: 0,0:16:34.53,0:16:37.41,Default,,0,0,0,,Масатоға тисе де көмектесе алмайды.
Dialogue: 0,0:16:37.78,0:16:40.33,Default,,0,0,0,,Ағам айтқандай, мен жай ғана бәс тіккенмін.
Dialogue: 0,0:16:40.45,0:16:41.29,Default,,0,0,0,,Иә, иә!
Dialogue: 0,0:16:42.25,0:16:43.29,Default,,0,0,0,,Кайоны әкел
Dialogue: 0,0:16:43.41,0:16:46.38,Default,,0,0,0,,Мен ол баланы өлтіремін!
Dialogue: 0,0:16:46.75,0:16:48.63,Default,,0,0,0,,Ол қорқып қашып кетті.
Dialogue: 0,0:16:48.88,0:16:51.63,Default,,0,0,0,,Қозғалтқыштың ақауы – Құдайдың қулығы ғана.
Dialogue: 0,0:16:51.76,0:16:52.59,Default,,0,0,0,,Әй?
Dialogue: 0,0:16:52.76,0:16:55.13,Default,,0,0,0,,Менің жолым болмаған шығар.
Dialogue: 0,0:16:55.43,0:16:57.51,Default,,0,0,0,,Біреу оны қолдан жасаған болуы мүмкін.
Dialogue: 0,0:16:57.76,0:16:59.56,Default,,0,0,0,,Қауіпсіздік деңгейін көтеріңіз!
Dialogue: 0,0:16:59.68,0:17:02.77,Default,,0,0,0,,Ха... Мен бұған қосыламын.
Dialogue: 0,0:17:04.44,0:17:07.27,Default,,0,0,0,,Француз менеджері жағымсыз.
Dialogue: 0,0:17:07.52,0:17:10.40,Default,,0,0,0,,Ол, әрине, өте жағымсыз жігіт.
Dialogue: 0,0:17:10.52,0:17:14.03,Default,,0,0,0,,Мен оны бұлай қалдыра алмаймын, міндетті түрде қайтарамын.
Dialogue: 0,0:17:14.15,0:17:15.70,Default,,0,0,0,,О, мен оны қайтарып алуым керек.
Dialogue: 0,0:17:16.28,0:17:17.53,Default,,0,0,0,,Ойлан
Dialogue: 0,0:17:18.91,0:17:20.41,Default,,0,0,0,,Жоспарланғандай.
Dialogue: 0,0:17:20.66,0:17:23.70,Default,,0,0,0,,Мен сол жерде теңізде жүзіп бара жаздадым.
Dialogue: 0,0:17:24.29,0:17:28.46,Default,,0,0,0,,Олар ақырында байсалды болып, оған шынымен кірісіп кеткен сияқты.
Dialogue: 0,0:17:29.88,0:17:31.17,Default,,0,0,0,,Эбби ұйықтап қалды ма?
Dialogue: 0,0:17:31.55,0:17:34.55,Default,,0,0,0,,Соңғы кездері көп ұйықтамайтын сияқтымын.
Dialogue: 0,0:17:34.67,0:17:36.18,Default,,0,0,0,,Себебі мен өзімді ұшуға мәжбүрлеймін.
Dialogue: 0,0:17:36.68,0:17:39.80,Default,,0,0,0,,Не болса да, менде тағы екі ғана аттракцион бар.
Dialogue: 0,0:17:40.05,0:17:43.06,Default,,0,0,0,,Әрине, мен максималды сақтық көшірме жасауды жалғастырамын.
Dialogue: 0,0:17:43.89,0:17:44.73,Default,,0,0,0,,Эй
Dialogue: 0,0:17:44.85,0:17:45.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:47.27,0:17:49.94,Default,,0,0,0,,Неліктен өлгісі келеді?
Dialogue: 0,0:17:52.07,0:17:53.73,Default,,0,0,0,,Сіз немен айналысып жатырсыз?
Dialogue: 0,0:17:54.07,0:17:55.49,Default,,0,0,0,,(Батырма басылған дыбысы)
Dialogue: 0,0:17:55.94,0:17:57.20,Default,,0,0,0,,Не істеуім керек...
Dialogue: 0,0:17:57.32,0:17:58.61,Default,,0,0,0,,Жағдайды білгеннен кейін
Dialogue: 0,0:17:59.07,0:18:02.08,Default,,0,0,0,,Баланың сезімін түсіну мүмкін емес.
Dialogue: 0,0:18:02.87,0:18:04.62,Default,,0,0,0,,Сізге және бізге
Dialogue: 0,0:18:24.68,0:18:25.77,Default,,0,0,0,,(винттік ұшақтың ұшу дыбысы)
Dialogue: 0,0:19:01.39,0:19:02.64,Default,,0,0,0,,
Dialogue: 0,0:19:07.68,0:19:09.64,Default,,0,0,0,,Менің ойымша, ол ұйықтап жатыр.
Dialogue: 0,0:19:11.77,0:19:12.69,Default,,0,0,0,,Әй?
Dialogue: 0,0:19:12.86,0:19:14.36,Default,,0,0,0,,Қайырлы кеш Эдамаме
Dialogue: 0,0:19:14.73,0:19:17.07,Default,,0,0,0,,Жоқ... Бұл Эдамура.
Dialogue: 0,0:19:17.28,0:19:18.86,Default,,0,0,0,,Мақсаттының екінші ұлы
Dialogue: 0,0:19:18.99,0:19:20.15,Default,,0,0,0,,Тек бір адам?
Dialogue: 0,0:19:20.53,0:19:23.53,Default,,0,0,0,,Льюис Эббимен серуендеуге шықты.
Dialogue: 0,0:19:23.91,0:19:24.91,Default,,0,0,0,,Эббимен бе?
Dialogue: 0,0:19:25.12,0:19:28.66,Default,,0,0,0,,«Мен ұшқыштар туралы кәсіби кеңес алғым келеді».
Dialogue: 0,0:19:32.54,0:19:35.67,Default,,0,0,0,,(қатты дауыс)
Dialogue: 0,0:19:35.79,0:19:41.68,Default,,0,0,0,,(көңілді музыка)
Dialogue: 0,0:19:42.13,0:19:44.30,Default,,0,0,0,,Уау, қараңдар, қараңдар!
Dialogue: 0,0:19:44.43,0:19:45.26,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:19:50.39,0:19:57.27,Default,,0,0,0,,Мен жалғыз қалдым ба?
Dialogue: 0,0:20:07.03,0:20:08.37,Default,,0,0,0,,Мақсаты не?
Dialogue: 0,0:20:09.41,0:20:12.25,Default,,0,0,0,,Менің кеңес сұрағым келмейді.
Dialogue: 0,0:20:16.92,0:20:18.30,Default,,0,0,0,,Мен сені әскерде деп естідім?
Dialogue: 0,0:20:20.30,0:20:25.76,Default,,0,0,0,,Көпұлтты күштердің ұшқышы ретінде Таяу Шығысты бақылауға қатысты.
Dialogue: 0,0:20:27.89,0:20:32.43,Default,,0,0,0,,кез келген адам саны кез келген адам саны
Dialogue: 0,0:20:34.19,0:20:35.31,Default,,0,0,0,,Сен оны өлтірдің, солай ма?
Dialogue: 0,0:20:35.44,0:20:36.27,Default,,0,0,0,,Тағы 500 рет!
Dialogue: 0,0:20:36.44,0:20:37.69,Default,,0,0,0,,(Льюистің дем алған дыбысы)
Dialogue: 0,0:20:39.48,0:20:43.57,Default,,0,0,0,,2003 жылдың наурызы Олар Бағдатты бомбалады ма?
Dialogue: 0,0:20:49.16,0:20:50.24,Default,,0,0,0,,Сонымен қатар, ол бізге дерлік жетіп қалды.
Dialogue: 0,0:20:51.04,0:20:57.04,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.78,0:22:50.78,Default,,0,0,0,,~♪
