Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.66,0:00:03.62,Default,,0,0,0,,Маған көмектес!
Dialogue: 0,0:00:03.87,0:00:06.38,Default,,0,0,0,,Өтінемін!
Dialogue: 0,0:00:06.88,0:00:09.38,Default,,0,0,0,,Бұл жақсы. Мен ішімнен шыққан дауысты естимін.
Dialogue: 0,0:00:09.50,0:00:10.34,Default,,0,0,0,,Ах!
Dialogue: 0,0:00:10.46,0:00:13.63,Default,,0,0,0,,Әй... қойшы! Мен оны тегін қалдыра алмаймын
Dialogue: 0,0:00:14.18,0:00:15.80,Default,,0,0,0,,Не?
Dialogue: 0,0:00:15.93,0:00:18.93,Default,,0,0,0,,Балалар сендер кімсіңдер?
Dialogue: 0,0:00:19.14,0:00:20.89,Default,,0,0,0,,Сенімді адам
Dialogue: 0,0:00:21.14,0:00:22.89,Default,,0,0,0,,Қоюландырылған сүт?
Dialogue: 0,0:00:23.69,0:00:27.44,Default,,0,0,0,,Қашпаймын деп уәде берсең, мен сені тастаймын. Эдамаме.
Dialogue: 0,0:00:27.56,0:00:28.86,Default,,0,0,0,,Бұл Эдамура.
Dialogue: 0,0:00:29.77,0:00:31.03,Default,,0,0,0,,Қашпа
Dialogue: 0,0:00:31.15,0:00:32.74,Default,,0,0,0,,Эбби, қойшы.
Dialogue: 0,0:00:33.19,0:00:35.24,Default,,0,0,0,,Не? Уау~
Dialogue: 0,0:00:36.32,0:00:37.53,Default,,0,0,0,,Ah~ah
Dialogue: 0,0:00:37.66,0:00:39.28,Default,,0,0,0,,Мен саған қойдым дедім.
Dialogue: 0,0:00:40.45,0:00:46.46,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:01:38.51,0:01:44.52,Default,,0,0,0,,~♪
Dialogue: 0,0:01:45.73,0:01:48.35,Default,,0,0,0,,(шай құйып жатқан дыбыс)
Dialogue: 0,0:01:48.48,0:01:50.15,Default,,0,0,0,,Сонымен, сіз шешім қабылдадыңыз ба?
Dialogue: 0,0:01:50.36,0:01:55.53,Default,,0,0,0,,Иә, мен шай әкелетін және сататын компанияда сату саласында жұмыс істеймін.
Dialogue: 0,0:01:56.53,0:01:58.40,Default,,0,0,0,,Кішкентай, бірақ президент те жақсы адам.
Dialogue: 0,0:01:58.53,0:02:01.24,Default,,0,0,0,,Иә, ішіңіз, бұл сізге пайдалы.
Dialogue: 0,0:02:03.66,0:02:04.74,Default,,0,0,0,,Хаа
Dialogue: 0,0:02:06.83,0:02:08.87,Default,,0,0,0,,Уф... аа...
Dialogue: 0,0:02:09.33,0:02:10.96,Default,,0,0,0,,А, мен оны білдім бе?
Dialogue: 0,0:02:11.33,0:02:13.92,Default,,0,0,0,,Осы шайды ішкенде тіл қатып қалады дейді бәрі.
Dialogue: 0,0:02:14.05,0:02:15.88,Default,,0,0,0,,Жоқ
Dialogue: 0,0:02:17.09,0:02:19.97,Default,,0,0,0,,Өте жақсы
Dialogue: 0,0:02:20.80,0:02:24.97,Default,,0,0,0,,Әкеңнің кесірінен мен саған қажетсіз кемістік қойдым.
Dialogue: 0,0:02:25.10,0:02:27.64,Default,,0,0,0,,Болды, мен жұмысқа орналастым.
Dialogue: 0,0:02:29.60,0:02:30.60,Default,,0,0,0,,Масато
Dialogue: 0,0:02:31.60,0:02:34.15,Default,,0,0,0,,Бұл маған көп күш жұмсалған жұмыс.
Dialogue: 0,0:02:34.77,0:02:36.94,Default,,0,0,0,,Ұнамаса да, бас тартпа.
Dialogue: 0,0:02:37.53,0:02:38.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:39.53,0:02:41.20,Default,,0,0,0,,Қалғандар да дәл қазір барын салып еңбек етіп жатқан болар.
Dialogue: 0,0:02:42.07,0:02:44.20,Default,,0,0,0,,Тезірек сауығып кетіңіз.
Dialogue: 0,0:02:44.91,0:02:45.74,Default,,0,0,0,,Маған қолыңды бер
Dialogue: 0,0:02:45.87,0:02:46.70,Default,,0,0,0,,Иә?
Dialogue: 0,0:02:48.37,0:02:50.42,Default,,0,0,0,,Ха, өте сүйкімді
Dialogue: 0,0:02:51.17,0:02:52.42,Default,,0,0,0,,Сізге мысықтар ұнайды, солай ма?
Dialogue: 0,0:02:53.13,0:02:55.30,Default,,0,0,0,,Сіз көбірек әкеле аласыз.
Dialogue: 0,0:02:55.50,0:02:57.84,Default,,0,0,0,,Уууу рахмет
Dialogue: 0,0:02:58.26,0:02:59.09,Default,,0,0,0,,Иә
Dialogue: 0,0:03:01.59,0:03:04.26,Default,,0,0,0,,Оны суда осылай ерітіңіз
Dialogue: 0,0:03:05.51,0:03:06.97,Default,,0,0,0,,Байқап көріңіз.
Dialogue: 0,0:03:07.18,0:03:09.31,Default,,0,0,0,,Менің қатты әдетім бар, бірақ жақсы дәрі табу қиынға соғады.
Dialogue: 0,0:03:10.27,0:03:13.31,Default,,0,0,0,,Жасушаларды белсендіру арқылы барлық аурулардың алдын алуға болады.
Dialogue: 0,0:03:14.06,0:03:15.57,Default,,0,0,0,,Тек осында
Dialogue: 0,0:03:15.69,0:03:18.82,Default,,0,0,0,,Қатерлі ісік жасушаларының азайғаны туралы да мәліметтер бар.
Dialogue: 0,0:03:19.49,0:03:22.32,Default,,0,0,0,,Бізді Денсаулық сақтау, Еңбек және әл-ауқат министрлігі мақұлдады,
Dialogue: 0,0:03:22.45,0:03:25.12,Default,,0,0,0,,Біз оны мүмкіндігінше тезірек барлығына таныстырамыз.
Dialogue: 0,0:03:25.53,0:03:27.58,Default,,0,0,0,,Диетаға пайдалы, пайдалы шай
Dialogue: 0,0:03:27.95,0:03:29.12,Default,,0,0,0,,Банкайча
Dialogue: 0,0:03:29.25,0:03:31.37,Default,,0,0,0,,Бір қорап 5000 иен тұрады.
Dialogue: 0,0:03:31.87,0:03:33.42,Default,,0,0,0,,Қымбат
Dialogue: 0,0:03:33.63,0:03:34.50,Default,,0,0,0,,Бере бер, ағайын.
Dialogue: 0,0:03:35.13,0:03:37.05,Default,,0,0,0,,«Шындығында, Уэноға бір ғана пойызбен жетуге болады»
Dialogue: 0,0:03:37.42,0:03:39.51,Default,,0,0,0,,4000 иен үшін 1 қорап
Dialogue: 0,0:03:39.67,0:03:40.51,Default,,0,0,0,,Тағы бір айқай!
Dialogue: 0,0:03:40.63,0:03:42.38,Default,,0,0,0,,А... онда...
Dialogue: 0,0:03:42.93,0:03:44.68,Default,,0,0,0,,1 қорап 3500 иен!
Dialogue: 0,0:03:44.80,0:03:45.64,Default,,0,0,0,,Күнделікті бағаларды білмейтін алғашқы келуші—
Dialogue: 0,0:03:46.14,0:03:47.43,Default,,0,0,0,,Бұл әр уақытта болады!
Dialogue: 0,0:03:47.56,0:03:50.68,Default,,0,0,0,,Жақсы! Енді 2 қорап үшін 4000 иен
Dialogue: 0,0:03:50.81,0:03:53.14,Default,,0,0,0,,3 қорап үшін 5000 иен
Dialogue: 0,0:03:53.27,0:03:54.40,Default,,0,0,0,,Онда маған үшеуін беріңіз.
Dialogue: 0,0:03:54.52,0:03:56.15,Default,,0,0,0,,Мен көп сатып алсам, арзанырақ бола ма?
Dialogue: 0,0:03:56.27,0:03:58.02,Default,,0,0,0,,Мен үшін де екі Иә, иә!
Dialogue: 0,0:03:58.15,0:03:59.15,Default,,0,0,0,,Тапсырысты ретімен беріңіз.
Dialogue: 0,0:04:00.11,0:04:01.74,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:04:02.03,0:04:05.49,Default,,0,0,0,,Бүгінгі сатылымдар біраз уақыттан бері алғаш рет үш саннан асты!
Dialogue: 0,0:04:05.62,0:04:08.41,Default,,0,0,0,,Жоқ, мұның бәрі Эдамура-кунның арқасында.
Dialogue: 0,0:04:08.79,0:04:11.58,Default,,0,0,0,,Жоқ, маған президент көмектесті...
Dialogue: 0,0:04:11.70,0:04:14.96,Default,,0,0,0,,Бұл аздап қымбат, сондықтан триггер маңызды.
Dialogue: 0,0:04:15.29,0:04:18.13,Default,,0,0,0,,Шындығында мен өте ризамын.
Dialogue: 0,0:04:18.59,0:04:20.17,Default,,0,0,0,,Мен сияқты адамдар...
Dialogue: 0,0:04:20.30,0:04:23.01,Default,,0,0,0,,Ей, олай айтпауың керек.
Dialogue: 0,0:04:23.88,0:04:26.64,Default,,0,0,0,,Әкең екеуің екі бөлек адамсыңдар.
Dialogue: 0,0:04:27.05,0:04:30.77,Default,,0,0,0,,Дүниеге түрлі-түсті көзілдірік арқылы қараған адамдар ғана емес.
Dialogue: 0,0:04:30.89,0:04:33.77,Default,,0,0,0,,Уф... Рахмет
Dialogue: 0,0:04:34.02,0:04:37.02,Default,,0,0,0,,Әрине, мұндай адамдар көп болғандықтан.
Dialogue: 0,0:04:37.15,0:04:39.65,Default,,0,0,0,,Кішкене ойлану керек.
Dialogue: 0,0:04:39.77,0:04:41.11,Default,,0,0,0,,Сіз тым адалсыз (есіктің ашылған дыбысы)
Dialogue: 0,0:04:41.23,0:04:42.69,Default,,0,0,0,,Не? (Қызметкерлер) Әй?
Dialogue: 0,0:04:42.82,0:04:45.24,Default,,0,0,0,,Иә, барлығы, қозғалмаңдар.
Dialogue: 0,0:04:46.03,0:04:48.74,Default,,0,0,0,,Жалған ақпарат негізінде өнімді сатып алу және сату арқылы алаяқтық
Dialogue: 0,0:04:49.16,0:04:51.37,Default,,0,0,0,,Иә, сізді қамауға алу туралы ордер бар. Кім жауапты?
Dialogue: 0,0:04:51.49,0:04:52.41,Default,,0,0,0,,Не!
Dialogue: 0,0:04:52.58,0:04:55.83,Default,,0,0,0,,Вада мырза, сәл күте тұрыңыз.
Dialogue: 0,0:04:55.96,0:04:57.71,Default,,0,0,0,,Бұл тағы сенсің, Кудо...
Dialogue: 0,0:04:57.83,0:04:59.96,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:05:01.09,0:05:01.92,Default,,0,0,0,,Ах...
Dialogue: 0,0:05:02.05,0:05:05.59,Default,,0,0,0,,Сол жас баланы аяй аласыз ба?
Dialogue: 0,0:05:05.72,0:05:06.55,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:05:07.84,0:05:09.93,Default,,0,0,0,,Сакураны жасаған компания.
Dialogue: 0,0:05:10.05,0:05:12.02,Default,,0,0,0,,Сіз шынымен байқамадыңыз ба?
Dialogue: 0,0:05:13.47,0:05:18.69,Default,,0,0,0,,Егер сіз шынымен ештеңе білмесеңіз және бұл кәдімгі компания болса...
Dialogue: 0,0:05:19.65,0:05:21.32,Default,,0,0,0,,Тек мойындаңыз.
Dialogue: 0,0:05:22.53,0:05:24.82,Default,,0,0,0,,Мен мұны айтуды жек көремін, бірақ
Dialogue: 0,0:05:24.94,0:05:28.78,Default,,0,0,0,,Төңіректе әкенің осындай ұлы бар екен деген әңгіме тарады.
Dialogue: 0,0:05:30.12,0:05:35.87,Default,,0,0,0,,Сотталушы кінәлі: 1 жыл 6 ай бас бостандығынан айырылды, 3 жылға бас бостандығынан айырылды.
Dialogue: 0,0:05:39.63,0:05:41.17,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:05:41.88,0:05:45.59,Default,,0,0,0,,Жазықсыз болу - бұл даусыз шындық.
Dialogue: 0,0:05:46.59,0:05:50.76,Default,,0,0,0,,Өмір бір-екі сәтсіздікпен бітпейді.
Dialogue: 0,0:05:51.18,0:05:52.56,Default,,0,0,0,,Бұдан былай
Dialogue: 0,0:05:53.10,0:05:53.93,Default,,0,0,0,,Иә
Dialogue: 0,0:05:54.27,0:05:58.02,Default,,0,0,0,,Әй, кейде дүние мені түсінбейді.
Dialogue: 0,0:05:58.35,0:06:02.44,Default,,0,0,0,,Өйткені шындықты ешкім білмейді.
Dialogue: 0,0:06:02.57,0:06:03.40,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:04.40,0:06:08.11,Default,,0,0,0,,Өзіңе сенуден басқа амалың жоқ
Dialogue: 0,0:06:08.86,0:06:13.03,Default,,0,0,0,,Бірақ мен саған әрқашан сенемін.
Dialogue: 0,0:06:13.28,0:06:14.12,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:15.45,0:06:18.87,Default,,0,0,0,,Бұл жерде кінәлі деп жазылған, бірақ бұл рас па?
Dialogue: 0,0:06:19.00,0:06:20.71,Default,,0,0,0,,Бұл түсінбеушілік... (Интервьюер) Түсінбеушілік пе?
Dialogue: 0,0:06:21.17,0:06:24.13,Default,,0,0,0,,Ал... мен жұмыс істеген компания алаяқтық жасады.
Dialogue: 0,0:06:24.25,0:06:27.47,Default,,0,0,0,,Хаа... Сіз қамауға алындыңыз, солай ма?
Dialogue: 0,0:06:27.88,0:06:28.72,Default,,0,0,0,,Иә
Dialogue: 0,0:06:28.93,0:06:33.55,Default,,0,0,0,,Сіз өз өміріңізді алдымен фактілерді мойындау арқылы ғана аша аласыз.
Dialogue: 0,0:06:35.26,0:06:39.77,Default,,0,0,0,,Біздің бағалайтынымыз – адалдық, алаяқтық...
Dialogue: 0,0:06:40.06,0:06:41.06,Default,,0,0,0,,Ei
Dialogue: 0,0:06:59.12,0:06:59.96,Default,,0,0,0,,(үнсіздік)
Dialogue: 0,0:07:05.34,0:07:09.34,Default,,0,0,0,,(Пойыздың ысқырығы мен жүгіру дыбысы)
Dialogue: 0,0:07:18.81,0:07:20.89,Default,,0,0,0,,Шартты түрде босатылуыңызбен құттықтаймыз
Dialogue: 0,0:07:22.48,0:07:24.56,Default,,0,0,0,,Әңгіме дегеніміз не?
Dialogue: 0,0:07:24.81,0:07:27.15,Default,,0,0,0,,Зорлық-зомбылықты тоқтатыңыз.
Dialogue: 0,0:07:29.82,0:07:32.32,Default,,0,0,0,,Барлығы мені алаяқ деп атайды.
Dialogue: 0,0:07:34.66,0:07:36.03,Default,,0,0,0,,Сонда мен мұны істеймін деп ойлаймын.
Dialogue: 0,0:07:36.16,0:07:37.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:38.87,0:07:40.29,Default,,0,0,0,,Сіз мұны бірге жасағыңыз келе ме?
Dialogue: 0,0:07:41.29,0:07:43.75,Default,,0,0,0,,(судың төгілген дыбысы)
Dialogue: 0,0:07:44.29,0:07:45.84,Default,,0,0,0,,Нгуппупуфа!
Dialogue: 0,0:07:46.50,0:07:47.50,Default,,0,0,0,,Мен тірі едім
Dialogue: 0,0:07:47.80,0:07:49.76,Default,,0,0,0,,Маған бәрібір, бірақ қарным ашты.
Dialogue: 0,0:07:49.88,0:07:51.72,Default,,0,0,0,,Хмм...
Dialogue: 0,0:07:57.93,0:07:59.47,Default,,0,0,0,,Ах, кешіріңіз (ер адам) Ух...
Dialogue: 0,0:07:59.89,0:08:01.52,Default,,0,0,0,,Мен тазалау ақысын төлеймін.
Dialogue: 0,0:08:01.64,0:08:03.81,Default,,0,0,0,,Бұл туралы алаңдамаңыз.
Dialogue: 0,0:08:05.77,0:08:10.44,Default,,0,0,0,,Бірнеше жыл бұрын жапондық зерттеушілер синтетикалық есірткінің жаңа түрін жасағанын айтты.
Dialogue: 0,0:08:10.57,0:08:11.94,Default,,0,0,0,,Сыбыс бар.
Dialogue: 0,0:08:12.36,0:08:16.74,Default,,0,0,0,,Мен мұны пайдаланып ақша табуды жоспарлап отырмын.
Dialogue: 0,0:08:20.37,0:08:22.16,Default,,0,0,0,,Асшаяндарды ұнатпайсыз ба?
Dialogue: 0,0:08:22.71,0:08:23.71,Default,,0,0,0,,Онда мен аламын.
Dialogue: 0,0:08:23.83,0:08:25.79,Default,,0,0,0,,Эбби, тамақты мұқият шайнаңыз.
Dialogue: 0,0:08:25.92,0:08:26.75,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:08:27.75,0:08:31.34,Default,,0,0,0,,Сенің кесіріңнен сол жаңа дәріні жұтып қойдым.
Dialogue: 0,0:08:33.09,0:08:35.97,Default,,0,0,0,,Есірткіге араласқым келмесе де...
Dialogue: 0,0:08:36.64,0:08:38.47,Default,,0,0,0,,Киімдерді киетін уақыт келді!
Dialogue: 0,0:08:39.01,0:08:42.52,Default,,0,0,0,,Ахаха О, сен мұны айтып тұрсың ба?
Dialogue: 0,0:08:42.64,0:08:43.98,Default,,0,0,0,,Бұл өте тиімді болды.
Dialogue: 0,0:08:44.39,0:08:45.65,Default,,0,0,0,,Не болды?
Dialogue: 0,0:08:45.77,0:08:46.85,Default,,0,0,0,,Ng…
Dialogue: 0,0:08:47.10,0:08:47.98,Default,,0,0,0,,Тоқта
Dialogue: 0,0:08:48.48,0:08:50.94,Default,,0,0,0,,Апельсин? Әлде жүзім бе?
Dialogue: 0,0:08:51.40,0:08:52.69,Default,,0,0,0,,Құлпынай?
Dialogue: 0,0:08:53.49,0:08:55.86,Default,,0,0,0,,«Сакура сиқыры» бар ма?
Dialogue: 0,0:08:56.20,0:08:58.95,Default,,0,0,0,,Салқын... (Лоран) Субұрқақ қаламдарға арналған ұнтақ та картоп крахмалы болып табылады.
Dialogue: 0,0:08:59.16,0:09:01.08,Default,,0,0,0,,Алғашында өсек таратқан мен едім.
Dialogue: 0,0:09:01.20,0:09:02.91,Default,,0,0,0,,Сіз ше?
Dialogue: 0,0:09:03.45,0:09:06.17,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:09:06.37,0:09:07.42,Default,,0,0,0,,Мен…
Dialogue: 0,0:09:07.88,0:09:08.88,Default,,0,0,0,,Бұл әрекет болды ма...
Dialogue: 0,0:09:09.00,0:09:10.38,Default,,0,0,0,,О...
Dialogue: 0,0:09:10.50,0:09:11.50,Default,,0,0,0,,Уф
Dialogue: 0,0:09:11.96,0:09:13.42,Default,,0,0,0,,Егер сізде де солай деп ойласаңыз.
Dialogue: 0,0:09:14.09,0:09:16.43,Default,,0,0,0,,Менің ойымша, ол жай ғана үрейленді.
Dialogue: 0,0:09:17.34,0:09:19.01,Default,,0,0,0,,Ол сүйкімді алаяқ
Dialogue: 0,0:09:20.39,0:09:22.35,Default,,0,0,0,,Сіз мені пайдаландыңыз ба?
Dialogue: 0,0:09:23.10,0:09:23.93,Default,,0,0,0,,Кассано
Dialogue: 0,0:09:24.06,0:09:28.31,Default,,0,0,0,,Олар мен Сакура Сиқырын жасаған адамды әкелуімді талап етті.
Dialogue: 0,0:09:30.52,0:09:33.40,Default,,0,0,0,,Алайда Жапонияда сенімді адамдар жоқ.
Dialogue: 0,0:09:33.53,0:09:34.65,Default,,0,0,0,,Мағынасыздық
Dialogue: 0,0:09:35.07,0:09:38.28,Default,,0,0,0,,Мен Майамиде Ян мен Йо сияқты қолдандым.
Dialogue: 0,0:09:38.41,0:09:39.57,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:09:39.78,0:09:41.37,Default,,0,0,0,,Бұл Тайваньдікі
Dialogue: 0,0:09:41.53,0:09:42.83,Default,,0,0,0,,Бір қарағанда бірдей
Dialogue: 0,0:09:43.33,0:09:47.21,Default,,0,0,0,,Сіз барлаушылар тапқан ең жақсысы болдыңыз.
Dialogue: 0,0:09:47.33,0:09:48.46,Default,,0,0,0,,Скаут...
Dialogue: 0,0:09:48.58,0:09:49.42,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:50.33,0:09:51.38,Default,,0,0,0,,Жоқ, бұл...
Dialogue: 0,0:09:52.04,0:09:53.59,Default,,0,0,0,,Сіз бұл кеңесті байқадыңыз.
Dialogue: 0,0:09:53.92,0:09:57.51,Default,,0,0,0,,Менің қолдарым жақсы.
Dialogue: 0,0:09:58.09,0:10:00.93,Default,,0,0,0,,Кішкене жас, бірақ зерттеуші сияқты.
Dialogue: 0,0:10:01.85,0:10:02.93,Default,,0,0,0,,Ким Сивон
Dialogue: 0,0:10:03.14,0:10:04.77,Default,,0,0,0,,Бір кездері динамит денесі болған
Dialogue: 0,0:10:04.89,0:10:07.48,Default,,0,0,0,,Мен әр адамды бал қақпанына батырдым.
Dialogue: 0,0:10:07.60,0:10:09.81,Default,,0,0,0,,Бірінші дәрежелі сенімді әйел
Dialogue: 0,0:10:09.94,0:10:13.36,Default,,0,0,0,,Неліктен мен оны жою үшін түс трюкін қолданбаймын?
Dialogue: 0,0:10:13.98,0:10:16.53,Default,,0,0,0,,Ол белсенді қызметте болғысы келсе де.
Dialogue: 0,0:10:17.11,0:10:19.41,Default,,0,0,0,,Қудо да?
Dialogue: 0,0:10:20.53,0:10:21.53,Default,,0,0,0,,Раxмет?
Dialogue: 0,0:10:21.91,0:10:26.08,Default,,0,0,0,,Әй, әлгі жайдарлы адамды жеңу оңай болды.
Dialogue: 0,0:10:26.29,0:10:27.54,Default,,0,0,0,,Жақсы серіктес.
Dialogue: 0,0:10:28.46,0:10:31.54,Default,,0,0,0,,Айтпақшы, сізді қуған тергеушілер де дайындалған.
Dialogue: 0,0:10:32.17,0:10:35.13,Default,,0,0,0,,Маған Кудо өзінің ескі достарын жинады.
Dialogue: 0,0:10:35.59,0:10:37.47,Default,,0,0,0,,Бұл қарапайым толық емес жұмыс, онымен айналысқыңыз келе ме?
Dialogue: 0,0:10:38.01,0:10:39.68,Default,,0,0,0,,Кәсіпорында жұмыс істегенде...
Dialogue: 0,0:10:40.38,0:10:42.64,Default,,0,0,0,,Сонда әлгі такси жүргізушісі ше?
Dialogue: 0,0:10:42.76,0:10:43.85,Default,,0,0,0,,Иә, бұл Каваджири.
Dialogue: 0,0:10:44.72,0:10:48.56,Default,,0,0,0,,Қалай болғанда да, сізді қамауға алу туралы ордер әлі шығарылған жоқ, сондықтан уайымдамаңыз.
Dialogue: 0,0:10:49.69,0:10:52.73,Default,,0,0,0,,Неліктен сіз мұны айналмалы жолмен жасайсыз?
Dialogue: 0,0:10:53.44,0:10:55.78,Default,,0,0,0,,Ынтымақтастығымды қаласаңыз, айтыңыз.
Dialogue: 0,0:10:56.19,0:10:59.11,Default,,0,0,0,,Оларды нақты ұрысқа тарту жылдамырақ.
Dialogue: 0,0:10:59.36,0:11:01.74,Default,,0,0,0,,Ал сен бейбақ сияқты әрекет етесің.
Dialogue: 0,0:11:01.86,0:11:04.33,Default,,0,0,0,,Байыпты, аңғал баланы тәрбиелеу
Dialogue: 0,0:11:04.45,0:11:06.16,Default,,0,0,0,,Өте тосын
Dialogue: 0,0:11:06.41,0:11:07.24,Default,,0,0,0,,Хун
Dialogue: 0,0:11:10.33,0:11:13.42,Default,,0,0,0,,Әрине мен сен туралы бәрін білемін.
Dialogue: 0,0:11:14.00,0:11:14.84,Default,,0,0,0,,Уф...
Dialogue: 0,0:11:16.67,0:11:19.26,Default,,0,0,0,,Неге алаяқ болып кетті деп ойлаймын.
Dialogue: 0,0:11:19.76,0:11:21.01,Default,,0,0,0,,Осымен
Dialogue: 0,0:11:21.63,0:11:24.39,Default,,0,0,0,,Отбасылық ит сізді іздеп жатыр.
Dialogue: 0,0:11:25.14,0:11:28.81,Default,,0,0,0,,Олар менің достарым екеніне сенімді болу үшін...
Dialogue: 0,0:11:29.02,0:11:31.35,Default,,0,0,0,,Жоқ, бұл нағыз мафия.
Dialogue: 0,0:11:31.73,0:11:32.73,Default,,0,0,0,,Бұл жерде тақды шарлатанға тапсыратын орын да емес қой, иә?
Dialogue: 0,0:11:33.15,0:11:34.19,Default,,0,0,0,,Өлтіріңіз
Dialogue: 0,0:11:35.23,0:11:38.19,Default,,0,0,0,,Менің ойымша, бұл өрескел еліктеу емес, бірақ бұл азап.
Dialogue: 0,0:11:38.61,0:11:40.03,Default,,0,0,0,,Артқы есіктен шығайық
Dialogue: 0,0:11:42.74,0:11:43.57,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:43.70,0:11:45.45,Default,,0,0,0,,Сол жерде менің досым төлейді.
Dialogue: 0,0:11:46.45,0:11:48.87,Default,,0,0,0,,Төлем қымбат болса, кешіріңіз!
Dialogue: 0,0:11:48.99,0:11:50.37,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:11:51.33,0:11:52.29,Default,,0,0,0,,Эхх (қызметші) Уһ
Dialogue: 0,0:11:54.17,0:11:56.71,Default,,0,0,0,,Маған сенің еркелегенің ұнамайды.
Dialogue: 0,0:11:57.00,0:11:57.84,Default,,0,0,0,,Иә
Dialogue: 0,0:12:00.67,0:12:01.76,Default,,0,0,0,,Кеттік, Эбби.
Dialogue: 0,0:12:01.88,0:12:02.72,Default,,0,0,0,,Хмм
Dialogue: 0,0:12:06.05,0:12:07.72,Default,,0,0,0,,Кассано есімді адам
Dialogue: 0,0:12:07.85,0:12:10.77,Default,,0,0,0,,Ресми түрде өзін кино продюсері деп атайды.
Dialogue: 0,0:12:10.89,0:12:13.89,Default,,0,0,0,,Іс жүзінде олар қоқыс фильмдерін жаппай шығарады.
Dialogue: 0,0:12:14.65,0:12:18.36,Default,,0,0,0,,Иә, ол биылғы Раззи сыйлығына ұсынылды.
Dialogue: 0,0:12:19.40,0:12:22.65,Default,,0,0,0,,Бірақ шындап айтсам, мен «Күйікті» сериясын ұсынамын.
Dialogue: 0,0:12:23.53,0:12:28.41,Default,,0,0,0,,Фильмнің жақсы жақтарына қарамастан, ол ең жаман иіс пен ең нашар миға ие.
Dialogue: 0,0:12:29.16,0:12:33.37,Default,,0,0,0,,Иә, шын мәнінде оның негізгі кәсібі – есірткі бизнесі.
Dialogue: 0,0:12:34.79,0:12:39.67,Default,,0,0,0,,Батыс жағалаудағы есірткі өнеркәсібін басқарды және үш бандалық ұйымды біріктірді.
Dialogue: 0,0:12:40.96,0:12:44.68,Default,,0,0,0,,Оққағар Салазар да бастапқыда бастық болғанға ұқсайды.
Dialogue: 0,0:12:45.97,0:12:49.93,Default,,0,0,0,,Голливудқа түсетін есірткінің көпшілігі Кассано арқылы өтетін шығар.
Dialogue: 0,0:12:50.51,0:12:55.39,Default,,0,0,0,,Оған жақындаған жастар үнемі адасқан.
Dialogue: 0,0:12:55.52,0:12:58.52,Default,,0,0,0,,Жолың болмаса, өміріңнен айырылдың.
Dialogue: 0,0:13:00.94,0:13:03.82,Default,,0,0,0,,Мен армандарымды батыс жағалауға дейін қуып жетуім керек еді, бірақ
Dialogue: 0,0:13:04.49,0:13:07.32,Default,,0,0,0,,Мен өзім маскүнем немесе секс-құл боламын деп ешқашан ойлаған емеспін.
Dialogue: 0,0:13:07.45,0:13:09.33,Default,,0,0,0,,Бұл ақылсыз американдық арман.
Dialogue: 0,0:13:09.91,0:13:11.33,Default,,0,0,0,,Қарт адамға ұқсайды
Dialogue: 0,0:13:11.45,0:13:13.83,Default,,0,0,0,,Итальяндық айғырдың төменгі денесі ме?
Dialogue: 0,0:13:13.95,0:13:15.79,Default,,0,0,0,,Уху... (Кассано) О...
Dialogue: 0,0:13:15.92,0:13:18.08,Default,,0,0,0,,Ондағы әйелдер ақыры...
Dialogue: 0,0:13:18.21,0:13:19.04,Default,,0,0,0,,(Кассаноның күлкісі)
Dialogue: 0,0:13:20.17,0:13:24.30,Default,,0,0,0,,Кейде адамдарды салық төлеуден жалтарды деп айыптайды, бірақ олар тез босатылады.
Dialogue: 0,0:13:25.17,0:13:30.01,Default,,0,0,0,,Тіпті полиция, прокурорлар және қазылар алқасы оның қайырымдылықтарына малынған.
Dialogue: 0,0:13:30.55,0:13:32.68,Default,,0,0,0,,Тыйым салу кезіндегі Капоне сияқты.
Dialogue: 0,0:13:33.47,0:13:36.14,Default,,0,0,0,,Барлығы осы Сұрақтарға түсініктемелер жоқ
Dialogue: 0,0:13:37.85,0:13:40.73,Default,,0,0,0,,Әрине, егер сатқын болса...
Dialogue: 0,0:13:41.07,0:13:42.94,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:13:43.07,0:13:44.99,Default,,0,0,0,,Артқы аллеядан аспанға
Dialogue: 0,0:13:50.28,0:13:51.41,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:51.53,0:13:54.41,Default,,0,0,0,,Брокер Лоран Тьерри, бұл сіз бе?
Dialogue: 0,0:13:57.50,0:13:58.96,Default,,0,0,0,,Трейдер
Dialogue: 0,0:13:59.08,0:13:59.92,Default,,0,0,0,,Хун
Dialogue: 0,0:14:01.34,0:14:04.26,Default,,0,0,0,,Олай болса, мұны қалдырайық.
Dialogue: 0,0:14:05.46,0:14:07.09,Default,,0,0,0,,Айтпақшы, Тьерри-кун.
Dialogue: 0,0:14:07.22,0:14:09.13,Default,,0,0,0,,Флюоран жақсы.
Dialogue: 0,0:14:09.47,0:14:10.68,Default,,0,0,0,,Лоран
Dialogue: 0,0:14:11.05,0:14:13.26,Default,,0,0,0,,Бірдеңе іздеп жүрген адам болды.
Dialogue: 0,0:14:14.27,0:14:16.98,Default,,0,0,0,,Жақсы бағаға сатып аламыз дейді, ғұн.
Dialogue: 0,0:14:17.85,0:14:19.90,Default,,0,0,0,,Ол «Сакура сиқыры» деп аталатын сияқты
Dialogue: 0,0:14:20.77,0:14:24.48,Default,,0,0,0,,Жемге түскен жауыздардың тамырын құртып, алдап ал.
Dialogue: 0,0:14:26.69,0:14:27.74,Default,,0,0,0,,Қызық, солай ма?
Dialogue: 0,0:14:28.24,0:14:29.78,Default,,0,0,0,,Бұл да
Dialogue: 0,0:14:30.24,0:14:33.78,Default,,0,0,0,,Сіз бір кәмпит допымен біреуді миллиондаған доллардан алдай алмайсыз.
Dialogue: 0,0:14:33.91,0:14:34.74,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:14:35.41,0:14:37.91,Default,,0,0,0,,Ересек адамның ұсталуына жол жоқ.
Dialogue: 0,0:14:38.25,0:14:39.42,Default,,0,0,0,,Амансың ба? Эдамаме
Dialogue: 0,0:14:40.21,0:14:43.88,Default,,0,0,0,,Адамдар өздерінің алдындағы фактілерге міндетті түрде сенбейді.
Dialogue: 0,0:14:44.00,0:14:45.50,Default,,0,0,0,,Сонымен, сен не нәрсеге сенесің?
Dialogue: 0,0:14:45.92,0:14:50.26,Default,,0,0,0,,Адамдар сенгісі келетін нәрсе - олар үшін қолайлы шындық.
Dialogue: 0,0:14:50.63,0:14:55.39,Default,,0,0,0,,Біреудің арманы мен амбициясының орнына мен саған иллюзияны сатамын.
Dialogue: 0,0:14:55.97,0:14:58.31,Default,,0,0,0,,Бұл біздің жұмысымыз
Dialogue: 0,0:14:58.81,0:15:00.52,Default,,0,0,0,,Сіз міндетті түрде өлтіресіз.
Dialogue: 0,0:15:01.06,0:15:03.36,Default,,0,0,0,,Әр адам бір күні өледі
Dialogue: 0,0:15:03.98,0:15:04.98,Default,,0,0,0,,(Эдамам күрсініс)
Dialogue: 0,0:15:05.57,0:15:07.82,Default,,0,0,0,,Бәс тігуді көтерген сен едің.
Dialogue: 0,0:15:08.28,0:15:10.57,Default,,0,0,0,,Ал мәміле 5 миллионға жасалды.
Dialogue: 0,0:15:10.70,0:15:12.36,Default,,0,0,0,,Сондықтан мен жеңдім.
Dialogue: 0,0:15:12.49,0:15:15.03,Default,,0,0,0,,Маған бағынышты боласың.
Dialogue: 0,0:15:15.16,0:15:15.99,Default,,0,0,0,,Tsk
Dialogue: 0,0:15:17.66,0:15:20.16,Default,,0,0,0,,Бүгін түнде демалуға болады.
Dialogue: 0,0:15:22.00,0:15:23.33,Default,,0,0,0,,Менің ағам – ескі мектептің адамы – алдау мен айла-шарғы арқылы жеңетіндерден—
Dialogue: 0,0:15:23.63,0:15:28.09,Default,,0,0,0,,Мен күткендей кешкі асты ертерек төледім.
Dialogue: 0,0:15:28.96,0:15:32.22,Default,,0,0,0,,Бұлай көрінгенімен, біз тек жауыздарды алдап аламыз.
Dialogue: 0,0:15:32.84,0:15:34.55,Default,,0,0,0,,Ертең кездескенше
Dialogue: 0,0:15:34.89,0:15:36.89,Default,,0,0,0,,Эби, бірге ұйықтайық.
Dialogue: 0,0:15:37.56,0:15:38.39,Default,,0,0,0,,Хун
Dialogue: 0,0:15:51.36,0:15:54.78,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:16:05.29,0:16:06.67,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:08.00,0:16:11.30,Default,,0,0,0,,А... уф... (Эбби) Қашып барасың ба? Ақымақ
Dialogue: 0,0:16:11.72,0:16:14.13,Default,,0,0,0,,Жапонияның нөмірі бірінші алаяқы естігенде таң қалды
Dialogue: 0,0:16:14.76,0:16:16.39,Default,,0,0,0,,Ято-сама!
Dialogue: 0,0:16:16.51,0:16:19.52,Default,,0,0,0,,Балалар сендерді сенімді адамдар деп кім атайды?
Dialogue: 0,0:16:19.64,0:16:22.43,Default,,0,0,0,,Әділдік одақтасы ретінде
Dialogue: 0,0:16:22.56,0:16:25.85,Default,,0,0,0,,Гугу... Бұл дүниеде әділдік жоқ!
Dialogue: 0,0:16:25.98,0:16:28.32,Default,,0,0,0,,Біз мұны бірінші қолымыздан білеміз!
Dialogue: 0,0:16:28.90,0:16:31.65,Default,,0,0,0,,Жапонияда тұру тыныштықты ұмыттыратын сияқты.
Dialogue: 0,0:16:32.19,0:16:36.41,Default,,0,0,0,,Бейбіт, қулықпен өмір сүруден басқа амалымыз жоқ.
Dialogue: 0,0:16:38.87,0:16:41.54,Default,,0,0,0,,Басқа адамдардың заттарын рұқсатсыз алмау
Dialogue: 0,0:16:41.66,0:16:43.37,Default,,0,0,0,,Сонда... неге Лоран?
Dialogue: 0,0:16:43.50,0:16:46.13,Default,,0,0,0,,Сен сияқты өнерпазды әкелді ме?
Dialogue: 0,0:16:47.04,0:16:48.25,Default,,0,0,0,,Кеңес жоқ па?
Dialogue: 0,0:16:48.96,0:16:52.67,Default,,0,0,0,,Ол жігіт сол жігіт, ол үнемі ойымен, төменгі денесімен қозғалады.
Dialogue: 0,0:16:52.92,0:16:53.76,Default,,0,0,0,,Мазасыздық.
Dialogue: 0,0:16:54.38,0:16:57.18,Default,,0,0,0,,Сіз Лоранмен доссыз ба? Олай болса...
Dialogue: 0,0:16:57.30,0:16:58.89,Default,,0,0,0,,Достар емес пе?
Dialogue: 0,0:16:59.64,0:17:01.14,Default,,0,0,0,,Барлығы жалғыз қасқыр
Dialogue: 0,0:17:01.27,0:17:02.73,Default,,0,0,0,,Егер сіз сәтсіздікке ұшырасаңыз, сізді тастап кетесіз.
Dialogue: 0,0:17:02.85,0:17:05.23,Default,,0,0,0,,Сенуге болатын жалғыз адам - өзіңіз
Dialogue: 0,0:17:05.85,0:17:08.11,Default,,0,0,0,,Бұл дүниедегі жалғыз ақиқат.
Dialogue: 0,0:17:08.65,0:17:10.15,Default,,0,0,0,,Бар, түкке тұрғысызсың.
Dialogue: 0,0:17:10.36,0:17:13.11,Default,,0,0,0,,Өз ұяңда мастурбация жаса, тың.
Dialogue: 0,0:17:13.24,0:17:14.36,Default,,0,0,0,,Нгува Геге…
Dialogue: 0,0:17:14.78,0:17:16.91,Default,,0,0,0,,До-до-до, мен пәкпін!
Dialogue: 0,0:17:17.03,0:17:17.87,Default,,0,0,0,,Хмф!
Dialogue: 0,0:17:17.99,0:17:19.32,Default,,0,0,0,,(кету)
Dialogue: 0,0:17:19.45,0:17:21.74,Default,,0,0,0,,Олар әуежайды бақылап тұруы керек.
Dialogue: 0,0:17:23.45,0:17:24.29,Default,,0,0,0,,Хун
Dialogue: 0,0:17:24.91,0:17:26.12,Default,,0,0,0,,Бұл аңғал
Dialogue: 0,0:17:45.60,0:17:46.44,Default,,0,0,0,,Хмм...
Dialogue: 0,0:17:47.02,0:17:51.02,Default,,0,0,0,,(душ дыбысы)
Dialogue: 0,0:17:57.28,0:18:00.16,Default,,0,0,0,,(Есікті ашу/жабу дыбысы)
Dialogue: 0,0:18:00.28,0:18:02.74,Default,,0,0,0,,Қайырлы таң, ішуді қалайсыз ба?
Dialogue: 0,0:18:02.87,0:18:03.70,Default,,0,0,0,,шайқастан барынша аулақ болуға тырысқанымызға қарамастан, әскеріміздің шамамен жиырма пайызын жоғалттық.
Dialogue: 0,0:18:04.20,0:18:06.04,Default,,0,0,0,,Сіз оның қашып кетуіне рұқсат еттіңіз бе?
Dialogue: 0,0:18:06.46,0:18:09.04,Default,,0,0,0,,Мен сені жалғыз қалдыру үшін қиналсам да.
Dialogue: 0,0:18:09.17,0:18:11.84,Default,,0,0,0,,Мен оны тұншықтырып өлтіре алар едім, бірақ мен одан бас тарттым.
Dialogue: 0,0:18:12.09,0:18:13.63,Default,,0,0,0,,Иә, міне, солай.
Dialogue: 0,0:18:13.80,0:18:17.05,Default,,0,0,0,,Біріншіден, тың бейбақ үшін бұл мүмкін емес еді.
Dialogue: 0,0:18:17.17,0:18:18.84,Default,,0,0,0,,Не? Қыз?
Dialogue: 0,0:18:19.09,0:18:19.97,Default,,0,0,0,,Сен асырап алатын балалар санын көбейту керек дедің, бірақ бұл – басты себеп емес шығар?
Dialogue: 0,0:18:20.55,0:18:23.64,Default,,0,0,0,,Мен де түсемін, нөлден бастаймын.
Dialogue: 0,0:18:23.76,0:18:25.60,Default,,0,0,0,,Мұның қажеті жоқ.
Dialogue: 0,0:18:26.27,0:18:27.10,Default,,0,0,0,,Хаа~
Dialogue: 0,0:18:27.94,0:18:30.44,Default,,0,0,0,,Адамдар дарынды туады.
Dialogue: 0,0:18:31.65,0:18:34.82,Default,,0,0,0,,Тағдыр дейтін жұлдызға ешкім қарсы шыға алмайды.
Dialogue: 0,0:18:34.94,0:18:37.40,Default,,0,0,0,,Сізге ұнаса да, ұнамаса да.
Dialogue: 0,0:18:38.24,0:18:40.32,Default,,0,0,0,,Түске дейін келетініме сенімдімін.
Dialogue: 0,0:18:40.45,0:18:41.57,Default,,0,0,0,,Эдамаме
Dialogue: 0,0:18:44.74,0:18:47.37,Default,,0,0,0,,А... түстен өтті.
Dialogue: 0,0:18:47.62,0:18:49.04,Default,,0,0,0,,Қайта құрайық
Dialogue: 0,0:18:54.38,0:18:56.38,Default,,0,0,0,,(көліктің жүгіру дыбысы)
Dialogue: 0,0:19:00.01,0:19:01.39,Default,,0,0,0,,Иә? Осылайша?
Dialogue: 0,0:19:01.76,0:19:03.43,Default,,0,0,0,,Мен қоюға жаттығып жатырмын.
Dialogue: 0,0:19:03.55,0:19:04.43,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:19:07.18,0:19:08.02,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:19:08.23,0:19:10.44,Default,,0,0,0,,Мені де Эбби көндірді.
Dialogue: 0,0:19:10.89,0:19:13.27,Default,,0,0,0,,Қорқып бара жатқан сияқтысың.
Dialogue: 0,0:19:13.40,0:19:15.69,Default,,0,0,0,,Бұл кәмпит өте жақсы болды.
Dialogue: 0,0:19:16.73,0:19:18.65,Default,,0,0,0,,Сіз бұрын не айтқыңыз келді?
Dialogue: 0,0:19:18.82,0:19:21.53,Default,,0,0,0,,Дәрігер болсаң, әйелдермен суда ойнайсың.
Dialogue: 0,0:19:22.32,0:19:23.16,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:23.28,0:19:24.95,Default,,0,0,0,,Ах! Аха, мен кеттім
Dialogue: 0,0:19:25.08,0:19:25.91,Default,,0,0,0,,Бұл~
Dialogue: 0,0:19:26.24,0:19:29.08,Default,,0,0,0,,Сол бала бағаны көтерді.
Dialogue: 0,0:19:29.20,0:19:30.33,Default,,0,0,0,,көтерілді ме?
Dialogue: 0,0:19:30.50,0:19:31.92,Default,,0,0,0,,Мен оның екі есе көп екенін қалдырдым.
Dialogue: 0,0:19:32.37,0:19:34.25,Default,,0,0,0,,Уақыт? 10 миллион?
Dialogue: 0,0:19:34.50,0:19:37.84,Default,,0,0,0,,Аа, кешіріңіз, бұл ақылсыз баға.
Dialogue: 0,0:19:37.96,0:19:39.05,Default,,0,0,0,,Төлеуге шешім қабылдады
Dialogue: 0,0:19:39.55,0:19:40.38,Default,,0,0,0,,Иә?
Dialogue: 0,0:19:40.51,0:19:44.18,Default,,0,0,0,,Мен жаңа ғана сақтаушыға хабарластым, сондықтан ол жақында келеді.
Dialogue: 0,0:19:44.68,0:19:46.72,Default,,0,0,0,,«Айрықша шарт», солай ма?
Dialogue: 0,0:19:46.89,0:19:48.14,Default,,0,0,0,,О, әрине
Dialogue: 0,0:19:48.27,0:19:50.89,Default,,0,0,0,,(Кассаноның күлкісі)
Dialogue: 0,0:19:51.02,0:19:52.69,Default,,0,0,0,,-де не болып жатыр?
Dialogue: 0,0:19:52.81,0:19:53.65,Default,,0,0,0,,Сол уақыттан бері жағдай өзгерді ғой, иә?
Dialogue: 0,0:19:58.69,0:20:00.03,Default,,0,0,0,,Иә! дәрігер
Dialogue: 0,0:20:00.15,0:20:01.82,Default,,0,0,0,,Сіз кешіккен жоқсыз ба?
Dialogue: 0,0:20:02.32,0:20:05.41,Default,,0,0,0,,О? Сіз мұны білмей тұрып, сіз ересек болуға қол жеткізе аласыз ба?
Dialogue: 0,0:20:05.66,0:20:07.28,Default,,0,0,0,,Хитачи мидабе
Dialogue: 0,0:20:07.45,0:20:11.62,Default,,0,0,0,,Үлкен адамның сағынышына еніп, үлкен байлыққа ие болыңыз
Dialogue: 0,0:20:12.25,0:20:16.25,Default,,0,0,0,,Жапония да тарихтағы ең сенімді адам болған.
Dialogue: 0,0:20:16.54,0:20:17.84,Default,,0,0,0,,Ах... (Эбби) Иә?
Dialogue: 0,0:20:18.75,0:20:20.01,Default,,0,0,0,,Сонни Сиба?
Dialogue: 0,0:20:20.13,0:20:22.42,Default,,0,0,0,,Жоқ, бұл Sony емес, бұл Sunny.
Dialogue: 0,0:20:23.13,0:20:26.05,Default,,0,0,0,,Жоқ! Тіпті Самурай Хироши де емес!
Dialogue: 0,0:20:26.43,0:20:29.14,Default,,0,0,0,,Бұл адам Тойотоми Хидэйоши
Dialogue: 0,0:20:30.22,0:20:31.06,Default,,0,0,0,,Who?
Dialogue: 0,0:20:31.68,0:20:32.52,Default,,0,0,0,,Қызық емес
Dialogue: 0,0:20:33.02,0:20:38.11,Default,,0,0,0,,Ах~ Қарапайым тілмен айтқанда, шаруадан патшаға дейін көтерілген адам.
Dialogue: 0,0:20:38.23,0:20:39.61,Default,,0,0,0,,Бұл Хидейоши
Dialogue: 0,0:20:40.94,0:20:41.82,Default,,0,0,0,,Иә
Dialogue: 0,0:20:43.11,0:20:46.37,Default,,0,0,0,,Бұл бәс тігу, жеңесің, хехехе
Dialogue: 0,0:20:46.82,0:20:49.24,Default,,0,0,0,,Жақын кел, Лоран.
Dialogue: 0,0:20:49.37,0:20:50.70,Default,,0,0,0,,Жаяу күрес
Dialogue: 0,0:20:51.08,0:20:57.08,Default,,0,0,0,,Ал Уротаки мырза қару-жарақсыз, тек жалаңаш қолдары бар
Dialogue: 0,0:22:44.78,0:22:50.78,Default,,0,0,0,,~♪
Dialogue: 0,0:22:52.28,0:22:58.28,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory