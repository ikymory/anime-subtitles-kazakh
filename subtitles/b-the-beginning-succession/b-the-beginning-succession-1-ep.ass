Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,‎NETFLIX түпнұсқа аниме сериясы
Dialogue: 0,0:00:13.93,0:00:17.76,Default,,0,0,0,,‎(қоңырау дыбысы)
Dialogue: 0,0:00:23.06,0:00:25.06,Default,,0,0,0,,‎(Қатысушылар) Құттықтаймыз! Керемет!
Dialogue: 0,0:00:25.94,0:00:27.44,Default,,0,0,0,,Сәттілік! Құттықтаймыз!
Dialogue: 0,0:00:30.36,0:00:32.03,Default,,0,0,0,,‎(Келін) Ах, ахах!
Dialogue: 0,0:00:35.45,0:00:36.57,Default,,0,0,0,,Сәлем
Dialogue: 0,0:00:37.37,0:00:40.20,Default,,0,0,0,,‎Бізді шақырудың қажеті бар ма?
Dialogue: 0,0:00:40.54,0:00:45.21,Default,,0,0,0,,‎Ол соғыстан кейін осы елдің қалпына келуіне көп көмектескен адамдардың бірі болды.
Dialogue: 0,0:00:45.79,0:00:50.38,Default,,0,0,0,,‎Парламент мүшесі ретінде Венеция шартын құру және EG Одағын жүзеге асыру
Dialogue: 0,0:00:50.50,0:00:54.22,Default,,0,0,0,,Зейнеткерлікке шыққаннан кейін ол қазіргі патшаның кеңесшісі қызметін атқарды.
Dialogue: 0,0:00:55.63,0:00:59.01,Default,,0,0,0,,‎Сонымен қатар орташа және патша сарайынан тыс жерде тұратын адам ретінде белгілі.
Dialogue: 0,0:00:59.14,0:01:00.85,Default,,0,0,0,,Ең сенімді...
Dialogue: 0,0:01:00.97,0:01:02.47,Default,,0,0,0,,Әртүрлі заттар бар.
Dialogue: 0,0:01:09.86,0:01:10.69,Default,,0,0,0,,А?
Dialogue: 0,0:01:10.90,0:01:13.65,Default,,0,0,0,,‎(Радио: Каэла) Айқайламаңыз! Балапан!
Dialogue: 0,0:01:14.11,0:01:15.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:15.32,0:01:18.16,Default,,0,0,0,,‎... дейді көрші үйдегі Пак Нен Ин.
Dialogue: 0,0:01:18.28,0:01:19.12,Default,,0,0,0,,На!
Dialogue: 0,0:01:21.03,0:01:21.87,Default,,0,0,0,,‎Жүрекпен
Dialogue: 0,0:01:21.99,0:01:22.83,Default,,0,0,0,,Сәлем
Dialogue: 0,0:01:23.79,0:01:27.25,Default,,0,0,0,,‎Мен мұндай нәрсеге дайын емеспін деп ойлаймын.
Dialogue: 0,0:01:27.50,0:01:30.54,Default,,0,0,0,,‎Бұл сізге ұнайды немесе ұнамайды деп айтпаңыз, бұл жұмыс.
Dialogue: 0,0:01:30.67,0:01:33.59,Default,,0,0,0,,‎Тіпті Борис тік тұрып жұмыс істеуді ақымақ деді.
Dialogue: 0,0:01:34.05,0:01:36.63,Default,,0,0,0,,‎Мен ғана ештеңе айта аламын.
Dialogue: 0,0:01:36.76,0:01:37.76,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:01:38.89,0:01:39.97,Default,,0,0,0,,Одан да көп
Dialogue: 0,0:01:40.09,0:01:43.22,Default,,0,0,0,,‎Осы қарбалас уақытта менде сақалды көзілдірік жоқ.
Dialogue: 0,0:01:43.72,0:01:46.56,Default,,0,0,0,,Соңғы кезде көрмегенім рас...
Dialogue: 0,0:01:47.19,0:01:48.69,Default,,0,0,0,,Сіз мұны қайталадыңыз ба?
Dialogue: 0,0:01:49.02,0:01:51.40,Default,,0,0,0,,‎Қазір басқа мәселені дербес тергеп жатыр
Dialogue: 0,0:01:52.36,0:01:53.19,Default,,0,0,0,,Уф!
Dialogue: 0,0:01:54.44,0:01:55.28,Default,,0,0,0,,‎(Пернетақтаны түрту дыбысы)
Dialogue: 0,0:01:57.20,0:01:58.53,Default,,0,0,0,,‎Басқа мәселе қандай?
Dialogue: 0,0:02:00.87,0:02:01.91,Default,,0,0,0,,‎Бұл басқа мәселе.
Dialogue: 0,0:02:02.83,0:02:04.41,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,0:02:06.87,0:02:07.71,Default,,0,0,0,,‎Фу...
Dialogue: 0,0:02:08.04,0:02:09.83,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:02:12.50,0:02:16.42,Default,,0,0,0,,мырза. Гени қазір рұқсатсыз жалғыз әрекет етуде.
Dialogue: 0,0:02:16.63,0:02:20.80,Default,,0,0,0,,‎Қазіргі мүше ретінде өз міндеттеріңізді тез арада орындаңыз.
Dialogue: 0,0:02:20.93,0:02:24.47,Default,,0,0,0,,Генидің жігіті әлі де Джано
Dialogue: 0,0:02:24.60,0:02:27.02,Default,,0,0,0,,‎Әй, қайда бардың?
Dialogue: 0,0:02:27.14,0:02:29.44,Default,,0,0,0,,‎ А... Шынымен, ешкім білмейді ме?
Dialogue: 0,0:02:29.73,0:02:31.90,Default,,0,0,0,,‎Балалар, ауыздарыңды жабыңдар.
Dialogue: 0,0:02:32.90,0:02:33.73,Default,,0,0,0,,‎Хмм?
Dialogue: 0,0:02:45.16,0:02:45.91,Default,,0,0,0,,‎Хмм...
Dialogue: 0,0:02:49.37,0:02:51.00,Default,,0,0,0,,Аспанда! Бірдеңе келе жатыр!
Dialogue: 0,0:02:56.67,0:02:58.13,Default,,0,0,0,,‎(Адамдардың айқайы)
Dialogue: 0,0:02:59.13,0:03:00.30,Default,,0,0,0,,‎(Захари) А... аа!
Dialogue: 0,0:03:00.43,0:03:01.26,Default,,0,0,0,,Шығар!
Dialogue: 0,0:03:04.97,0:03:06.68,Default,,0,0,0,,‎(SP) Сіз қандайсыз!
Dialogue: 0,0:03:08.27,0:03:09.48,Default,,0,0,0,,А... Уф!
Dialogue: 0,0:03:09.98,0:03:10.81,Default,,0,0,0,,Ға!
Dialogue: 0,0:03:21.78,0:03:23.66,Default,,0,0,0,,‎(Захари) Не... бұл не?
Dialogue: 0,0:03:23.78,0:03:24.95,Default,,0,0,0,,Басыңды төмен түсір!
Dialogue: 0,0:03:26.49,0:03:27.87,Default,,0,0,0,,‎Жақсы... мүмкін емес
Dialogue: 0,0:03:27.99,0:03:28.83,Default,,0,0,0,,‎(мылтық ату)
Dialogue: 0,0:03:31.25,0:03:32.08,Default,,0,0,0,,‎(SP)Уау!
Dialogue: 0,0:03:32.75,0:03:33.58,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:03:53.73,0:03:55.15,Default,,0,0,0,,‎Хахаха... ‎(Жарылыс дыбысы)
Dialogue: 0,0:03:55.27,0:03:56.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:00.65,0:04:02.24,Default,,0,0,0,,Захари, жақсысың ба?
Dialogue: 0,0:04:02.36,0:04:03.20,Default,,0,0,0,,‎(Захари) Ах...
Dialogue: 0,0:04:03.32,0:04:04.45,Default,,0,0,0,,‎Ах (Захари) Уф...
Dialogue: 0,0:04:09.49,0:04:10.33,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:04:11.62,0:04:12.46,Default,,0,0,0,,Ах
Dialogue: 0,0:04:14.54,0:04:15.38,Default,,0,0,0,,Ға!
Dialogue: 0,0:04:19.80,0:04:20.63,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:24.68,0:04:26.01,Default,,0,0,0,,‎(Захари) Күте тұрыңыз...
Dialogue: 0,0:04:26.76,0:04:28.35,Default,,0,0,0,,Маған көмектес!
Dialogue: 0,0:04:28.47,0:04:30.64,Default,,0,0,0,,‎Hihii...
Dialogue: 0,0:04:37.15,0:04:38.77,Default,,0,0,0,,Жақсы...
Dialogue: 0,0:04:42.53,0:04:44.40,Default,,0,0,0,,‎(Лили мен Борис ауыр дем алады)
Dialogue: 0,0:04:44.57,0:04:47.45,Default,,0,0,0,,‎(Захари) Уау!
Dialogue: 0,0:04:55.12,0:05:01.13,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:05:04.01,0:05:10.01,Default,,0,0,0,,‎〜♪
Dialogue: 0,0:05:15.18,0:05:16.56,Default,,0,0,0,,‎(Куроба) Мектеп қалай?
Dialogue: 0,0:05:16.69,0:05:17.85,Default,,0,0,0,,Бұл қызық
Dialogue: 0,0:05:18.23,0:05:20.52,Default,,0,0,0,,‎Куроба Сізге қалпына келтіру жұмыстары ұнай ма?
Dialogue: 0,0:05:22.15,0:05:24.74,Default,,0,0,0,,‎(Куроба) Бұл қызық сияқты емес...
Dialogue: 0,0:05:24.86,0:05:26.78,Default,,0,0,0,,Бұл пайдалы ма?
Dialogue: 0,0:05:26.90,0:05:28.28,Default,,0,0,0,,Иә, дұрыс.
Dialogue: 0,0:05:28.41,0:05:29.24,Default,,0,0,0,,‎Хехе
Dialogue: 0,0:05:31.08,0:05:32.70,Default,,0,0,0,,Мен келемін!
Dialogue: 0,0:05:33.79,0:05:35.33,Default,,0,0,0,,‎(1-сыныптасы) О, Юна, қайырлы таң.
Dialogue: 0,0:05:35.46,0:05:36.29,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:05:36.41,0:05:38.29,Default,,0,0,0,,‎(2-сыныптасы) Юна үй тапсырмасын орындады, солай ма?
Dialogue: 0,0:05:38.42,0:05:40.04,Default,,0,0,0,,‎Маған көрсету/сұрау
Dialogue: 0,0:05:40.17,0:05:42.88,Default,,0,0,0,,‎Жоқ, мұны өзіңіз жасауыңыз керек.
Dialogue: 0,0:05:43.00,0:05:44.84,Default,,0,0,0,,‎(1-сыныптас) Маған айтты
Dialogue: 0,0:05:53.10,0:05:54.39,Default,,0,0,0,,‎Ябаши Ябаши Ябаши
Dialogue: 0,0:05:54.52,0:05:55.35,Default,,0,0,0,,О, жоқ!
Dialogue: 0,0:05:55.56,0:05:57.23,Default,,0,0,0,,‎Ябаши Ябаши...
Dialogue: 0,0:05:57.69,0:05:59.02,Default,,0,0,0,,‎(Куроба) Қайырлы таң Қайырлы таң!
Dialogue: 0,0:05:59.15,0:06:00.06,Default,,0,0,0,,‎(Куроба) Сол нан...
Dialogue: 0,0:06:00.19,0:06:01.98,Default,,0,0,0,,Кешіріңіз, мен кешігіп қалдым!
Dialogue: 0,0:06:10.32,0:06:11.99,Default,,0,0,0,,‎Ана ана!
Dialogue: 0,0:06:12.12,0:06:13.53,Default,,0,0,0,,Мен дәптерімді ұмытып қалдым!
Dialogue: 0,0:06:14.54,0:06:15.62,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:15.83,0:06:18.33,Default,,0,0,0,,(Лилидің анасы) Не істеп жатырсың, ақымақ?
Dialogue: 0,0:06:22.38,0:06:23.96,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:27.38,0:06:28.34,Default,,0,0,0,,‎Ха...
Dialogue: 0,0:06:32.30,0:06:33.68,Default,,0,0,0,,‎Ана...
Dialogue: 0,0:06:37.48,0:06:40.52,Default,,0,0,0,,‎Хмм...
Dialogue: 0,0:06:40.65,0:06:41.48,Default,,0,0,0,,Мм...
Dialogue: 0,0:06:45.73,0:06:48.19,Default,,0,0,0,,‎Каэла мен саған тамақ сатып алайын...
Dialogue: 0,0:06:48.40,0:06:49.24,Default,,0,0,0,,Ақан
Dialogue: 0,0:06:49.36,0:06:51.20,Default,,0,0,0,,‎Оншалықты өзің істе, ақымақ
Dialogue: 0,0:06:51.32,0:06:52.16,Default,,0,0,0,,‎Ку...
Dialogue: 0,0:06:52.62,0:06:53.70,Default,,0,0,0,,Бұл сұмдық...
Dialogue: 0,0:06:54.95,0:06:56.70,Default,,0,0,0,,Сіз Китті білмейсіз бе? иә?
Dialogue: 0,0:06:56.83,0:06:58.50,Default,,0,0,0,,Сіз тағы да кешіктіңіз.
Dialogue: 0,0:06:58.62,0:06:59.50,Default,,0,0,0,,Тиісті қорытынды әріпті жаз
Dialogue: 0,0:06:59.87,0:07:01.50,Default,,0,0,0,,Не? Уақытында болу?
Dialogue: 0,0:07:01.71,0:07:04.38,Default,,0,0,0,,‎ Астыңғы 5 минут бұрын Door Ho
Dialogue: 0,0:07:04.63,0:07:05.46,Default,,0,0,0,,На!
Dialogue: 0,0:07:05.92,0:07:06.84,Default,,0,0,0,,‎Уаау!
Dialogue: 0,0:07:07.00,0:07:07.84,Default,,0,0,0,,Ах!
Dialogue: 0,0:07:07.96,0:07:09.38,Default,,0,0,0,,Сіз!
Dialogue: 0,0:07:09.51,0:07:12.47,Default,,0,0,0,,‎Ах~ мен жарты жолға жеттім...
Dialogue: 0,0:07:12.59,0:07:13.64,Default,,0,0,0,,‎Кит ше?
Dialogue: 0,0:07:13.76,0:07:15.51,Default,,0,0,0,,Келіңіздер ме? Мен білмеймін.
Dialogue: 0,0:07:18.02,0:07:18.93,Default,,0,0,0,,Иә
Dialogue: 0,0:07:19.18,0:07:20.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:51.67,0:07:52.51,Default,,0,0,0,,‎(Лилидің әкесі) Куроба
Dialogue: 0,0:07:52.63,0:07:53.47,Default,,0,0,0,,‎(Куроба) Иә
Dialogue: 0,0:07:54.34,0:07:57.26,Default,,0,0,0,,Қоймадан кокоболоны әкеле аласыз ба?
Dialogue: 0,0:07:57.39,0:07:58.97,Default,,0,0,0,,‎Әлі қалған жоқ.
Dialogue: 0,0:07:59.10,0:07:59.93,Default,,0,0,0,,‎(Куроба) Иә
Dialogue: 0,0:08:08.82,0:08:09.65,Default,,0,0,0,,Куроба
Dialogue: 0,0:08:09.78,0:08:10.61,Default,,0,0,0,,‎(Куроба) Ха...
Dialogue: 0,0:08:17.24,0:08:18.12,Default,,0,0,0,,‎(Куроба) Әйтеуір...
Dialogue: 0,0:08:18.99,0:08:22.37,Default,,0,0,0,,‎Сен мені жақын арада көремін дедің ғой, Куроба.
Dialogue: 0,0:08:22.91,0:08:24.71,Default,,0,0,0,,‎(Куроба) Кири... Акула?
Dialogue: 0,0:08:25.37,0:08:27.04,Default,,0,0,0,,Мен көптен бері іздеп жүрмін
Dialogue: 0,0:08:27.17,0:08:29.30,Default,,0,0,0,,Мен оны Куробанды таптым
Dialogue: 0,0:08:30.21,0:08:32.72,Default,,0,0,0,,‎Жоқ... Өлтіруші Б
Dialogue: 0,0:08:42.85,0:08:43.73,Default,,0,0,0,,‎(Куроба) Ол тірі ме?
Dialogue: 0,0:08:49.90,0:08:51.73,Default,,0,0,0,,Сіз маған көмектестіңіз, солай ма?
Dialogue: 0,0:08:53.40,0:08:54.99,Default,,0,0,0,,Сонда қалғандары ше?
Dialogue: 0,0:09:02.62,0:09:04.00,Default,,0,0,0,,Олар не деді?
Dialogue: 0,0:09:04.41,0:09:05.62,Default,,0,0,0,,‎Доктор Казамаға
Dialogue: 0,0:09:07.71,0:09:11.50,Default,,0,0,0,,‎(Куроба) Ол өлім алдында тұр. Егер оның денесінің бөліктерін ауыстырсақ,
Dialogue: 0,0:09:11.63,0:09:13.42,Default,,0,0,0,,‎Ол достарына көмектесе алатынын айтты.
Dialogue: 0,0:09:14.59,0:09:17.43,Default,,0,0,0,,‎Достарыма көмектесу арқылы мен де күшті боламын.
Dialogue: 0,0:09:17.97,0:09:21.06,Default,,0,0,0,,‎Күшті болыңыз және достарыңызды қайтадан қорғаңыз
Dialogue: 0,0:09:21.97,0:09:25.31,Default,,0,0,0,,‎Бұл менің қабілетім және менің міндетім.
Dialogue: 0,0:09:25.52,0:09:29.02,Default,,0,0,0,,‎Ал маған ауыстырылатын бөлшектер туралы ескерту берілді.
Dialogue: 0,0:09:29.69,0:09:31.52,Default,,0,0,0,,‎Бірақ ешкім оянған жоқ...
Dialogue: 0,0:09:32.15,0:09:36.07,Default,,0,0,0,,Бұл кезеңде адгезияның қалпына келуіне бір аптадан астам уақыт қажет.
Dialogue: 0,0:09:36.99,0:09:39.37,Default,,0,0,0,,‎Егер сен әрқашан жанымда болсаң
Dialogue: 0,0:09:39.62,0:09:43.45,Default,,0,0,0,,‎Сіз резонанс құбылысына байланысты сәл ерте оянған боларсыз.
Dialogue: 0,0:09:46.33,0:09:47.29,Default,,0,0,0,,Куроба
Dialogue: 0,0:09:48.33,0:09:51.00,Default,,0,0,0,,Қайтадан бірге болғың келмейді ме?
Dialogue: 0,0:09:51.38,0:09:52.55,Default,,0,0,0,,Сол күндер сияқты...
Dialogue: 0,0:09:57.68,0:10:00.34,Default,,0,0,0,,‎Біз мемлекеттік мекемеде жұмыс істейміз
Dialogue: 0,0:10:00.72,0:10:02.81,Default,,0,0,0,,‎Жаңа әлем құру
Dialogue: 0,0:10:06.06,0:10:08.73,Default,,0,0,0,,‎Адамдар мен біз бірге өмір сүре алатын болашақ
Dialogue: 0,0:10:09.27,0:10:10.69,Default,,0,0,0,,‎Ол үшін алдымен...
Dialogue: 0,0:10:10.90,0:10:15.19,Default,,0,0,0,,‎Редги сияқты ескірген технологияға әуес адамдар.
Dialogue: 0,0:10:15.32,0:10:17.36,Default,,0,0,0,,Барлығын жою керек
Dialogue: 0,0:10:18.36,0:10:20.07,Default,,0,0,0,,‎Жаңа әлемдік тәртіп
Dialogue: 0,0:10:20.57,0:10:22.58,Default,,0,0,0,,Бастау үшін үзіліс
Dialogue: 0,0:10:25.33,0:10:28.58,Default,,0,0,0,,‎Куроба, маған сенің қылышың мен күшің керек.
Dialogue: 0,0:10:29.04,0:10:31.71,Default,,0,0,0,,‎Менімен бірге жүр, бірге күресейік.
Dialogue: 0,0:10:32.96,0:10:35.09,Default,,0,0,0,,‎Ұлттық... мекеме?
Dialogue: 0,0:10:35.76,0:10:38.17,Default,,0,0,0,,‎Сіз Гилберт Россты ойлайсыз ба?
Dialogue: 0,0:10:38.88,0:10:40.43,Default,,0,0,0,,Егер солай болса, сіз дұрыс түсінбедіңіз.
Dialogue: 0,0:10:40.93,0:10:42.76,Default,,0,0,0,,‎Бұл елдің еркі емес
Dialogue: 0,0:10:42.89,0:10:46.47,Default,,0,0,0,,‎Дәлірек айтқанда, олар бақылаудан шыққан кезде олардың өзін-өзі жоюына себеп болу.
Dialogue: 0,0:10:47.27,0:10:48.93,Default,,0,0,0,,Бұл жобаның бөлігі.
Dialogue: 0,0:10:49.23,0:10:50.77,Default,,0,0,0,,Қарапайым тілмен айтқанда:
Dialogue: 0,0:10:51.10,0:10:54.02,Default,,0,0,0,,Мен Гилбертке өз-өзіне қол жұмсауға көмектестім.
Dialogue: 0,0:10:57.32,0:10:59.20,Default,,0,0,0,,Өртті тоқтату үшін өрт
Dialogue: 0,0:11:00.95,0:11:02.57,Default,,0,0,0,,‎Қашып кетуді тоқтату
Dialogue: 0,0:11:02.82,0:11:05.70,Default,,0,0,0,,‎Ең жылдам жол - жеделдету және өзін-өзі жою.
Dialogue: 0,0:11:07.75,0:11:12.25,Default,,0,0,0,,Сіз және Кит Фрик мен күткеннен де көп нәрсе істедіңіз.
Dialogue: 0,0:11:13.00,0:11:15.04,Default,,0,0,0,,Сіз мені және Китті пайдаландыңыз ба?
Dialogue: 0,0:11:15.38,0:11:16.67,Default,,0,0,0,,Нәтижесінде
Dialogue: 0,0:11:17.13,0:11:19.38,Default,,0,0,0,,‎Бірақ сен Юнамен қайта кездесе алдың, солай ма?
Dialogue: 0,0:11:24.10,0:11:25.05,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:11:25.72,0:11:29.64,Default,,0,0,0,,Әр адамның тірі екенін білу - ең үлкен қуаныш.
Dialogue: 0,0:11:30.10,0:11:31.60,Default,,0,0,0,,Мен шынымен бақыттымын
Dialogue: 0,0:11:31.98,0:11:34.86,Default,,0,0,0,,Бірақ менің шайқасым аяқталды
Dialogue: 0,0:11:35.19,0:11:37.86,Default,,0,0,0,,Мен қылышты қайтарамын, бірақ ол менің күшіме айналмайды.
Dialogue: 0,0:11:42.86,0:11:43.70,Default,,0,0,0,,A...
Dialogue: 0,0:11:48.79,0:11:49.66,Default,,0,0,0,,Куроба
Dialogue: 0,0:11:50.79,0:11:54.46,Default,,0,0,0,,Біз доктор Казаманың өсиетімен дүниеге келдік деп ойлайсың ба?
Dialogue: 0,0:11:54.58,0:11:55.42,Default,,0,0,0,,‎(Куроба) Иә?
Dialogue: 0,0:11:56.29,0:12:00.92,Default,,0,0,0,,‎Қара қауырсындардың патшасы доктор Казаманы басқарса, сіз не істер едіңіз?
Dialogue: 0,0:12:01.26,0:12:02.09,Default,,0,0,0,,‎(Куроба) Иә?
Dialogue: 0,0:12:02.26,0:12:03.09,Default,,0,0,0,,Куроба
Dialogue: 0,0:12:03.55,0:12:05.68,Default,,0,0,0,,Сіз өз тағдырыңыздан қашып құтыла алмайсыз.
Dialogue: 0,0:12:06.60,0:12:09.18,Default,,0,0,0,,Сіз және біз...
Dialogue: 0,0:12:09.85,0:12:11.23,Default,,0,0,0,,‎Кирисаме...
Dialogue: 0,0:12:17.90,0:12:18.94,Default,,0,0,0,,Юкиказэ
Dialogue: 0,0:12:19.36,0:12:20.65,Default,,0,0,0,,Бұл Куробане ме?
Dialogue: 0,0:12:20.78,0:12:22.82,Default,,0,0,0,,Менен бір секундқа да көзіңді алма
Dialogue: 0,0:12:23.15,0:12:25.28,Default,,0,0,0,,‎Барлық қозғалыстарды көшіру
Dialogue: 0,0:12:25.78,0:12:28.45,Default,,0,0,0,,‎Бұл күнделікті өмір мағыналы ма?
Dialogue: 0,0:12:29.08,0:12:30.74,Default,,0,0,0,,‎Әр нәрсенің мәні бар
Dialogue: 0,0:12:30.87,0:12:32.12,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:12:32.25,0:12:34.04,Default,,0,0,0,,Мен сені қазір өлтіргім келеді.
Dialogue: 0,0:12:34.33,0:12:37.17,Default,,0,0,0,,‎Сіз қазіргідей жеңе алмайсыз.
Dialogue: 0,0:12:38.42,0:12:39.25,Default,,0,0,0,,‎Асагири
Dialogue: 0,0:12:39.38,0:12:40.21,Default,,0,0,0,,‎Хмм?
Dialogue: 0,0:12:40.46,0:12:44.72,Default,,0,0,0,,‎Егер оның эволюциясын қате бағаласақ, ол біздің бақылауымыздан шығып кетеді.
Dialogue: 0,0:12:45.80,0:12:48.47,Default,,0,0,0,,Сіз нағыз шайтанды жасайсыз.
Dialogue: 0,0:12:49.35,0:12:52.68,Default,,0,0,0,,‎Сәтсіздіктің себебі - әрқашан абайсыздық.
Dialogue: 0,0:12:53.43,0:12:57.10,Default,,0,0,0,,‎Ал біз ешқашан сәтсіздікке ұшырай алмаймыз
Dialogue: 0,0:13:08.03,0:13:09.49,Default,,0,0,0,,Ол айтты...
Dialogue: 0,0:13:09.62,0:13:10.99,Default,,0,0,0,,‎(күлді)
Dialogue: 0,0:13:16.46,0:13:17.29,Default,,0,0,0,,Сонда кездескенше
Dialogue: 0,0:13:17.42,0:13:18.50,Default,,0,0,0,,‎Сау болыңыз
Dialogue: 0,0:13:47.07,0:13:48.82,Default,,0,0,0,,‎(Полиция көлігінің сиренасы) ‎(Офицер) артқа тұр!
Dialogue: 0,0:13:48.95,0:13:51.20,Default,,0,0,0,,‎(мылтық дыбысы)
Dialogue: 0,0:13:51.33,0:13:54.04,Default,,0,0,0,,‎(Редги) Ампула қайда! Бұл басқа әңгіме!
Dialogue: 0,0:13:54.16,0:13:57.00,Default,,0,0,0,,‎(мылтық дыбысы)
Dialogue: 0,0:13:57.58,0:13:58.62,Default,,0,0,0,,‎(Редги) Қарғыс атсын!
Dialogue: 0,0:13:58.92,0:14:00.38,Default,,0,0,0,,‎(1-детектив) Қылмыскердің өтініші қандай?
Dialogue: 0,0:14:00.63,0:14:02.59,Default,,0,0,0,,‎(2-детектив) Жоқ, әлі ештеңе жоқ...
Dialogue: 0,0:14:03.09,0:14:05.30,Default,,0,0,0,,Тек анда-санда мылтық ату
Dialogue: 0,0:14:05.46,0:14:06.59,Default,,0,0,0,,‎(Редги) Уау!
Dialogue: 0,0:14:06.92,0:14:08.84,Default,,0,0,0,,‎(1-детектив) Сендіру мағынасыз ба...
Dialogue: 0,0:14:09.43,0:14:10.64,Default,,0,0,0,,‎Шабуыл командасы туралы не деуге болады?
Dialogue: 0,0:14:10.76,0:14:12.18,Default,,0,0,0,,Келуге 5 минут қалды
Dialogue: 0,0:14:12.30,0:14:14.01,Default,,0,0,0,,‎(Кейт) Бекіту тілегі...
Dialogue: 0,0:14:14.14,0:14:15.06,Default,,0,0,0,,‎(Детективтер)!
Dialogue: 0,0:14:16.52,0:14:19.52,Default,,0,0,0,,‎(айқай)
Dialogue: 0,0:14:19.65,0:14:22.11,Default,,0,0,0,,Мен енді мұны істей алмаймын. Маған тез беріңізші!
Dialogue: 0,0:14:22.36,0:14:26.40,Default,,0,0,0,,‎(Кит) Ол бізден көмек сұрап тұр.
Dialogue: 0,0:14:26.53,0:14:27.36,Default,,0,0,0,,Ах
Dialogue: 0,0:14:27.74,0:14:29.32,Default,,0,0,0,,‎(2-детектив) Неге рұқсатсыз кірдің?
Dialogue: 0,0:14:29.45,0:14:30.87,Default,,0,0,0,,‎(Кит) Жоқ, мен де детективпін...
Dialogue: 0,0:14:30.99,0:14:31.87,Default,,0,0,0,,‎(2-детектив) Жай ғана шық!
Dialogue: 0,0:14:32.24,0:14:33.70,Default,,0,0,0,,‎(Кит) А, артқа.
Dialogue: 0,0:14:33.83,0:14:34.66,Default,,0,0,0,,‎(Детективтер) Иә?
Dialogue: 0,0:14:34.79,0:14:36.83,Default,,0,0,0,,‎(Адамдардың айқайы)
Dialogue: 0,0:14:37.12,0:14:38.50,Default,,0,0,0,,‎Ааа
Dialogue: 0,0:14:54.85,0:14:57.64,Default,,0,0,0,,Кім бірін-бірі атып тастады?
Dialogue: 0,0:14:57.77,0:15:00.85,Default,,0,0,0,,‎ Танысқаныма қуаныштымын Кит Казама
Dialogue: 0,0:15:09.99,0:15:11.36,Default,,0,0,0,,Сәлем (Куроба)?
Dialogue: 0,0:15:12.11,0:15:13.20,Default,,0,0,0,,‎(Куроба) Лилия
Dialogue: 0,0:15:13.32,0:15:14.16,Default,,0,0,0,,Е...
Dialogue: 0,0:15:14.58,0:15:17.79,Default,,0,0,0,,‎Мен әдемі қызды қыдырып жүргендіктен алдым.
Dialogue: 0,0:15:17.91,0:15:18.95,Default,,0,0,0,,Мені алып кетті
Dialogue: 0,0:15:19.08,0:15:19.91,Default,,0,0,0,,‎(Екі адам күледі)
Dialogue: 0,0:15:27.88,0:15:30.59,Default,,0,0,0,,‎Соңғы уақытта жұртты әбігерге салған оғаш қылмыстар көбейіп кетті.
Dialogue: 0,0:15:30.72,0:15:33.47,Default,,0,0,0,,‎Юна-чан өте әдемі қыз, сондықтан мен абай болуым керек.
Dialogue: 0,0:15:33.59,0:15:34.97,Default,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:15:35.10,0:15:36.31,Default,,0,0,0,,‎(Куроба) Бұл ештеңе емес.
Dialogue: 0,0:15:36.64,0:15:38.56,Default,,0,0,0,,‎Сосын бірдеңе болған болуы керек.
Dialogue: 0,0:15:44.27,0:15:46.57,Default,,0,0,0,,‎(Кит) Ол әлі тірі ме?
Dialogue: 0,0:15:47.07,0:15:49.03,Default,,0,0,0,,Менің кім екенімді білесің
Dialogue: 0,0:15:50.44,0:15:51.95,Default,,0,0,0,,‎Кирисаме-кун
Dialogue: 0,0:15:54.11,0:15:57.70,Default,,0,0,0,,Соңғы күндері Реджи өлімі өсті.
Dialogue: 0,0:15:57.99,0:15:59.20,Default,,0,0,0,,‎Бұл сіздің операцияңыз ба?
Dialogue: 0,0:15:59.62,0:16:03.58,Default,,0,0,0,,‎ «Ұйымды қайта құру кезінде барлық регистрлерді жойыңыз».
Dialogue: 0,0:16:03.71,0:16:05.25,Default,,0,0,0,,‎Бұл тапсырыс болғандықтан...
Dialogue: 0,0:16:05.38,0:16:06.46,Default,,0,0,0,,‎(Кит) Сіз қай жақтансыз?
Dialogue: 0,0:16:09.00,0:16:11.22,Default,,0,0,0,,Жарайды, жақсы.
Dialogue: 0,0:16:12.01,0:16:13.72,Default,,0,0,0,,Ол қиын адам.
Dialogue: 0,0:16:13.88,0:16:14.72,Default,,0,0,0,,‎(Кит)?
Dialogue: 0,0:16:15.05,0:16:16.89,Default,,0,0,0,,‎Бұл уақыт қандай?
Dialogue: 0,0:16:17.10,0:16:20.47,Default,,0,0,0,,‎Менде әлі де кейбір пайдалану құндылығы бар деп айту дұрыс па?
Dialogue: 0,0:16:20.60,0:16:22.81,Default,,0,0,0,,Сіз шынымен қызықсыз
Dialogue: 0,0:16:23.02,0:16:24.98,Default,,0,0,0,,‎(Кит) О, бұл жиі айтылады.
Dialogue: 0,0:16:25.10,0:16:27.23,Default,,0,0,0,,‎
Dialogue: 0,0:16:27.77,0:16:30.53,Default,,0,0,0,,‎Сен де әр уақытта көп жұмыс істедің.
Dialogue: 0,0:16:31.19,0:16:32.24,Default,,0,0,0,,‎Қажырлы еңбегіңіз үшін рахмет
Dialogue: 0,0:16:32.61,0:16:33.45,Default,,0,0,0,,Е...
Dialogue: 0,0:16:34.36,0:16:36.37,Default,,0,0,0,,Әрине, сіз қайда барсаңыз да
Dialogue: 0,0:16:36.49,0:16:40.12,Default,,0,0,0,,‎Мен ғана сен түсіне алатын қолтаңба қалдырдым.
Dialogue: 0,0:16:40.91,0:16:42.33,Default,,0,0,0,,‎(Кит) Жазылмайтын науқас Гилбертке
Dialogue: 0,0:16:42.45,0:16:45.54,Default,,0,0,0,,Сіз егжей-тегжейлі белгіні жасай алмайсыз.
Dialogue: 0,0:16:46.08,0:16:49.25,Default,,0,0,0,,‎Бұл керемет жұмыс болды, Кирисаме-кун.
Dialogue: 0,0:16:50.59,0:16:53.59,Default,,0,0,0,,‎ Кит Казама Мен оны біраз уақыттан бері естігім келді.
Dialogue: 0,0:16:54.13,0:16:56.05,Default,,0,0,0,,Мұның бәрі тұзақ екенін білгеннен кейін
Dialogue: 0,0:16:56.18,0:16:58.26,Default,,0,0,0,,‎Сен неге әрқашан осындасың?
Dialogue: 0,0:16:59.05,0:17:00.51,Default,,0,0,0,,Мен жай ғана білгім келеді
Dialogue: 0,0:17:02.43,0:17:07.52,Default,,0,0,0,,«Құдай өлтіруші шайтанға айналады, ал шайтан өлтіруші патша болады».
Dialogue: 0,0:17:09.11,0:17:10.82,Default,,0,0,0,,Эй, сен қалай ойлайсың?
Dialogue: 0,0:17:11.73,0:17:14.65,Default,,0,0,0,,Мен тастар билеген адаммын ба?
Dialogue: 0,0:17:15.07,0:17:16.11,Default,,0,0,0,,Балалар сендер?
Dialogue: 0,0:17:17.32,0:17:20.70,Default,,0,0,0,,Менің ойымша, сені өлтіру ұят болар еді.
Dialogue: 0,0:17:21.20,0:17:22.29,Default,,0,0,0,,‎Жақсы емес
Dialogue: 0,0:17:23.16,0:17:24.71,Default,,0,0,0,,Өлтіру (Кит)
Dialogue: 0,0:17:25.71,0:17:27.79,Default,,0,0,0,,Келіңіздер ме? Мен білмеймін.
Dialogue: 0,0:17:32.05,0:17:35.76,Default,,0,0,0,,Сонымен, мен үйден асығыс шыққанда, мен ешқандай шалбар кимегенімді түсіндім.
Dialogue: 0,0:17:36.22,0:17:37.76,Default,,0,0,0,,Мен асығыс көлікті артқа тартып, артқа қарай бет алдым.
Dialogue: 0,0:17:38.26,0:17:39.76,Default,,0,0,0,,Мен өзімді төсекте таптым
Dialogue: 0,0:17:39.97,0:17:41.60,Default,,0,0,0,,‎Әрине мен бас тарттым.
Dialogue: 0,0:17:42.06,0:17:44.14,Default,,0,0,0,,‎Себебі біз енді араласпаймыз
Dialogue: 0,0:17:44.31,0:17:46.06,Default,,0,0,0,,‎Сен шынымен жақсысың ба?
Dialogue: 0,0:17:47.94,0:17:49.52,Default,,0,0,0,,Сау болыңыз Куробане
Dialogue: 0,0:17:49.90,0:17:51.11,Default,,0,0,0,,Иә, Юна да.
Dialogue: 0,0:17:51.23,0:17:52.52,Default,,0,0,0,,Иә? (Куроба/Юна) Иә?
Dialogue: 0,0:17:52.94,0:17:53.78,Default,,0,0,0,,Бұл танымал емес пе?
Dialogue: 0,0:17:56.20,0:17:57.03,Default,,0,0,0,,А?
Dialogue: 0,0:17:57.36,0:17:59.28,Default,,0,0,0,,Сіз мені жаңа ғана тыңдадыңыз ба?
Dialogue: 0,0:17:59.53,0:18:01.37,Default,,0,0,0,,‎(Куроба) Мен ештеңе естіген жоқпын.
Dialogue: 0,0:18:01.66,0:18:02.79,Default,,0,0,0,,‎Иә~
Dialogue: 0,0:18:02.91,0:18:03.74,Default,,0,0,0,,‎(Электрондық поштаның қоңырау үні)
Dialogue: 0,0:18:03.87,0:18:04.79,Default,,0,0,0,,‎(Куроба) А?
Dialogue: 0,0:18:05.29,0:18:06.87,Default,,0,0,0,,Иә? Бұрын қашан?
Dialogue: 0,0:18:07.46,0:18:09.37,Default,,0,0,0,,‎Ол болмау принципі емес пе еді?
Dialogue: 0,0:18:09.54,0:18:10.79,Default,,0,0,0,,‎(Куроба) Әртүрлі заттар бар.
Dialogue: 0,0:18:11.09,0:18:12.34,Default,,0,0,0,,Ей, жолды өзгертейік.
Dialogue: 0,0:18:12.46,0:18:13.30,Default,,0,0,0,,‎(Куроба) Әй...
Dialogue: 0,0:18:13.46,0:18:14.84,Default,,0,0,0,,‎Алға қараңыз
Dialogue: 0,0:18:14.96,0:18:17.51,Default,,0,0,0,,‎Жарайды, менің үш көзім бар!
Dialogue: 0,0:18:17.63,0:18:19.26,Default,,0,0,0,,‎(Куроба/Юна) Уау!
Dialogue: 0,0:18:24.47,0:18:26.81,Default,,0,0,0,,Мұнда су да, тамақ та жоқ.
Dialogue: 0,0:18:27.27,0:18:29.31,Default,,0,0,0,,‎Қашан өлетініңді өзің шешесің.
Dialogue: 0,0:18:30.19,0:18:32.02,Default,,0,0,0,,‎(Кит) Ол мұны жай ғана айтады.
Dialogue: 0,0:18:32.61,0:18:35.61,Default,,0,0,0,,Адамдар мұны құрмет белгісі ретінде қабылдағанын қалаймын.
Dialogue: 0,0:18:36.53,0:18:40.28,Default,,0,0,0,,‎(Кит) Саған айтып тұрмын, ол мен үшін ештеңе істемейді.
Dialogue: 0,0:18:40.41,0:18:44.24,Default,,0,0,0,,‎(Кирисамэ күледі)
Dialogue: 0,0:18:44.66,0:18:48.29,Default,,0,0,0,,Мен сенің түсінбегеніңді түсіндім.
Dialogue: 0,0:18:50.50,0:18:53.75,Default,,0,0,0,,Куробане үшін сіз Канопуссыз.
Dialogue: 0,0:18:53.92,0:18:55.42,Default,,0,0,0,,‎Сен Юнадан маңыздырақсың
Dialogue: 0,0:18:56.21,0:18:58.30,Default,,0,0,0,,Оның қозғалмауы мүмкін емес, солай ма?
Dialogue: 0,0:18:59.09,0:19:02.80,Default,,0,0,0,,Сіз шынымен түсінбейтін жалғыз нәрсе - бұл махаббат қалай жұмыс істейтіні.
Dialogue: 0,0:19:03.14,0:19:05.06,Default,,0,0,0,,‎(Ұялы телефон діріл дыбысы)
Dialogue: 0,0:19:05.18,0:19:06.01,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:19:07.39,0:19:08.23,Default,,0,0,0,,‎(Ұялы жұмыс дыбысы)
Dialogue: 0,0:19:34.04,0:19:34.88,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:44.22,0:19:45.05,Default,,0,0,0,,Ах
Dialogue: 0,0:19:52.94,0:19:53.77,Default,,0,0,0,,Уф!
Dialogue: 0,0:19:59.74,0:20:00.57,Default,,0,0,0,,‎Ку...
Dialogue: 0,0:20:09.08,0:20:09.91,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:20:16.38,0:20:17.21,Default,,0,0,0,,Хехе!
Dialogue: 0,0:20:20.46,0:20:21.30,Default,,0,0,0,,Кяа!
Dialogue: 0,0:20:28.39,0:20:33.27,Default,,0,0,0,,(қол шапалақтау)
Dialogue: 0,0:20:33.60,0:20:34.52,Default,,0,0,0,,‎Ку...
Dialogue: 0,0:20:39.11,0:20:41.53,Default,,0,0,0,,‎Уау, ғажап, ғажап
Dialogue: 0,0:20:41.65,0:20:43.07,Default,,0,0,0,,Сыбыстан да артық
Dialogue: 0,0:20:43.20,0:20:45.86,Default,,0,0,0,,‎Мен сіздің Куроба екеніңізге сене алмаймын.
Dialogue: 0,0:20:47.16,0:20:49.28,Default,,0,0,0,,‎Эй, біраз уақыт болды.
Dialogue: 0,0:20:50.20,0:20:51.16,Default,,0,0,0,,‎Қазан
Dialogue: 0,0:20:52.33,0:20:53.37,Default,,0,0,0,,Юкиказэ
Dialogue: 0,0:20:54.04,0:20:56.33,Default,,0,0,0,,‎Мені еске алғаныңыз үшін мақтанамын.
Dialogue: 0,0:20:56.46,0:20:57.54,Default,,0,0,0,,‎(Куроба) Кит?
Dialogue: 0,0:20:57.75,0:21:00.42,Default,,0,0,0,,‎Дәл қазір мен ерекше жерде демалып жатырмын.
Dialogue: 0,0:21:01.00,0:21:04.05,Default,,0,0,0,,Жақсы жер: теңізге жақын
Dialogue: 0,0:21:04.47,0:21:07.14,Default,,0,0,0,,Қанаттары болса ең жақсы жер болар еді.
Dialogue: 0,0:21:07.34,0:21:09.26,Default,,0,0,0,,‎(Куроба) Менің не істегенімді қалайсыз?
Dialogue: 0,0:21:09.39,0:21:11.06,Default,,0,0,0,,Жұмыста көмек алу
Dialogue: 0,0:21:11.52,0:21:12.68,Default,,0,0,0,,Жұмыс?
Dialogue: 0,0:21:14.48,0:21:15.39,Default,,0,0,0,,бас тарту
Dialogue: 0,0:21:15.85,0:21:18.65,Default,,0,0,0,,‎Кит Фрикпен не болғаны маңызды ма?
Dialogue: 0,0:21:18.77,0:21:20.69,Default,,0,0,0,,‎(Куроба) Мен үшін уайымдама!
Dialogue: 0,0:21:20.94,0:21:23.53,Default,,0,0,0,,Бұл жақсы, бірақ ол өлсе...
Dialogue: 0,0:21:24.32,0:21:27.32,Default,,0,0,0,,Келесі кезекте Юнаға ұмтылайық.
Dialogue: 0,0:21:28.91,0:21:29.87,Default,,0,0,0,,‎Егер сен Юнаға қолыңды қойсаң...
Dialogue: 0,0:21:29.99,0:21:31.29,Default,,0,0,0,,Бұл сізге байланысты.
Dialogue: 0,0:21:31.41,0:21:32.24,Default,,0,0,0,,‎Ку...
Dialogue: 0,0:21:32.62,0:21:33.58,Default,,0,0,0,,Өзіңізді алдамаңыз!
Dialogue: 0,0:21:33.70,0:21:36.58,Default,,0,0,0,,‎Егер сіз оны қабылдамасаңыз, Канопус сізді өлтіреді.
Dialogue: 0,0:21:36.71,0:21:39.13,Default,,0,0,0,,‎Мен оны жалғыз қалдырсам да, ол 4 күннен кейін өледі.
Dialogue: 0,0:21:39.84,0:21:41.67,Default,,0,0,0,,‎Сосын Юна
Dialogue: 0,0:21:41.80,0:21:44.72,Default,,0,0,0,,Лили Хошина және оның отбасы
Dialogue: 0,0:21:44.92,0:21:48.89,Default,,0,0,0,,Сізді білетіндердің барлығын өлтіріңіз
Dialogue: 0,0:21:49.85,0:21:50.93,Default,,0,0,0,,Куроба
Dialogue: 0,0:21:52.14,0:21:54.77,Default,,0,0,0,,Мен сені Құдайды өлтіруді сұраймын.
Dialogue: 0,0:21:57.27,0:22:03.28,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:23:41.33,0:23:47.34,Default,,0,0,0,,‎〜♪
