Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,‎NETFLIX түпнұсқа аниме сериясы
Dialogue: 0,0:00:34.82,0:00:36.45,Default,,0,0,0,,‎(Куроба) Ку... ха!
Dialogue: 0,0:00:44.83,0:00:45.67,Default,,0,0,0,,‎Хехе
Dialogue: 0,0:00:45.79,0:00:51.80,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:00:54.72,0:01:00.72,Default,,0,0,0,,‎〜♪
Dialogue: 0,0:01:09.19,0:01:10.02,Default,,0,0,0,,‎(Куроба)...
Dialogue: 0,0:01:12.57,0:01:13.94,Default,,0,0,0,,Фу
Dialogue: 0,0:01:15.11,0:01:16.28,Default,,0,0,0,,Өкінішке орай
Dialogue: 0,0:01:16.74,0:01:18.41,Default,,0,0,0,,‎Бұл орынсыз
Dialogue: 0,0:01:20.33,0:01:23.70,Default,,0,0,0,,Менің өлетін уақытым келді емес пе?
Dialogue: 0,0:01:24.16,0:01:27.04,Default,,0,0,0,,‎(Асагири күлді)
Dialogue: 0,0:01:27.83,0:01:29.71,Default,,0,0,0,,деді Кирисаме
Dialogue: 0,0:01:30.38,0:01:33.46,Default,,0,0,0,,«Куроба әрқашан жеңіледі»
Dialogue: 0,0:01:34.05,0:01:36.72,Default,,0,0,0,,«Әрқашан солай болған»
Dialogue: 0,0:01:36.84,0:01:38.22,Default,,0,0,0,,‎Уфуфуфуфуфу
Dialogue: 0,0:01:39.30,0:01:42.72,Default,,0,0,0,,‎Сіз барлық жолмен келгендіктен, мұқият болыңыз.
Dialogue: 0,0:01:42.85,0:01:44.81,Default,,0,0,0,,Менің басқалармен араласуға уақытым жоқ.
Dialogue: 0,0:01:48.60,0:01:51.11,Default,,0,0,0,,‎Оған уақытыңыз болмаса да
Dialogue: 0,0:01:51.36,0:01:53.48,Default,,0,0,0,,‎Ол бізде бар!
Dialogue: 0,0:02:03.54,0:02:06.25,Default,,0,0,0,,‎Хехе, сен ақымақ емессің бе?
Dialogue: 0,0:02:06.62,0:02:07.87,Default,,0,0,0,,Мазаламау
Dialogue: 0,0:02:10.63,0:02:13.25,Default,,0,0,0,,Сіз өте жақсы адам екеніңізді естідім.
Dialogue: 0,0:02:14.00,0:02:17.38,Default,,0,0,0,,‎Кирисамэ мен Юкиказэ сен туралы сөйлеседі
Dialogue: 0,0:02:17.51,0:02:20.26,Default,,0,0,0,,‎Оның әдетте көрсетпейтін мейірімді көздері бар.
Dialogue: 0,0:02:20.39,0:02:23.76,Default,,0,0,0,,Сіз ностальгиялық сезімдесіз бе? Кейде күлемін.
Dialogue: 0,0:02:24.14,0:02:25.77,Default,,0,0,0,,Маған бұл ұнамайды.
Dialogue: 0,0:02:27.23,0:02:29.14,Default,,0,0,0,,Мен оны шынымен жек көремін.
Dialogue: 0,0:02:29.27,0:02:31.77,Default,,0,0,0,,Олар мен білмейтін оқиғаларды айтады
Dialogue: 0,0:02:32.40,0:02:33.65,Default,,0,0,0,,Жиренішті!
Dialogue: 0,0:02:33.77,0:02:35.32,Default,,0,0,0,,Мен әрқашан солай ойлаймын.
Dialogue: 0,0:02:35.44,0:02:39.15,Default,,0,0,0,,Мен бұл сезімнің жалғасқанын қаламаймын!
Dialogue: 0,0:03:12.10,0:03:13.19,Default,,0,0,0,,‎(Куроба)...
Dialogue: 0,0:03:15.73,0:03:17.32,Default,,0,0,0,,Өлтіремін!
Dialogue: 0,0:03:29.00,0:03:29.83,Default,,0,0,0,,Фу
Dialogue: 0,0:03:37.25,0:03:38.09,Default,,0,0,0,,‎Мм!
Dialogue: 0,0:03:41.22,0:03:42.38,Default,,0,0,0,,Бұл...
Dialogue: 0,0:04:05.74,0:04:07.99,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:04:09.45,0:04:10.37,Default,,0,0,0,,‎Қазан...
Dialogue: 0,0:04:19.09,0:04:21.13,Default,,0,0,0,,Сәлемдесу жоқ па?
Dialogue: 0,0:04:21.63,0:04:23.38,Default,,0,0,0,,Әдеттегідей әлі суық.
Dialogue: 0,0:04:23.51,0:04:25.89,Default,,0,0,0,,Бұның қажеті жоқ, солай ма?
Dialogue: 0,0:04:26.01,0:04:27.64,Default,,0,0,0,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:04:28.01,0:04:30.14,Default,,0,0,0,,‎Хехе, әрине
Dialogue: 0,0:04:30.52,0:04:32.60,Default,,0,0,0,,‎Сонымен... бұл не үшін?
Dialogue: 0,0:04:33.02,0:04:35.06,Default,,0,0,0,,Мен асығып тұрмын.
Dialogue: 0,0:04:35.65,0:04:37.56,Default,,0,0,0,,Қызықсыз нәрселерді айтпа
Dialogue: 0,0:04:37.69,0:04:40.48,Default,,0,0,0,,Мен біраз уақыттан кейін бірінші рет ойнаймын деп ойладым.
Dialogue: 0,0:04:41.11,0:04:43.15,Default,,0,0,0,,‎Өткенді еске түсіру
Dialogue: 0,0:04:44.15,0:04:45.99,Default,,0,0,0,,Біз дос емеспіз бе?
Dialogue: 0,0:04:46.32,0:04:48.16,Default,,0,0,0,,‎Ойнау жақсы, бірақ
Dialogue: 0,0:04:49.24,0:04:52.16,Default,,0,0,0,,Біз топ құрмай ештеңе істей алмадық.
Dialogue: 0,0:04:53.29,0:04:54.83,Default,,0,0,0,,Жалғыз болған дұрыс па?
Dialogue: 0,0:04:56.08,0:04:58.25,Default,,0,0,0,,Мен өте бақыттымын, патшайым.
Dialogue: 0,0:04:58.38,0:05:00.67,Default,,0,0,0,,Ештеңе өзгерген жоқ
Dialogue: 0,0:05:01.00,0:05:03.67,Default,,0,0,0,,‎Шынында, ол бұрынғыдан да әдемі...
Dialogue: 0,0:05:03.92,0:05:06.30,Default,,0,0,0,,Сіз әлі әлсізсіз бе?
Dialogue: 0,0:05:11.06,0:05:14.68,Default,,0,0,0,,‎Бұл мені ұзақ уақыт ренжітті.
Dialogue: 0,0:05:26.70,0:05:28.70,Default,,0,0,0,,Маған көшірме берілді
Dialogue: 0,0:05:29.03,0:05:33.20,Default,,0,0,0,,‎Бірнеше рет ұрысуымыздың себебі сіздің қабілеттеріңізді бағалау болды.
Dialogue: 0,0:05:34.29,0:05:38.21,Default,,0,0,0,,Юкиказэ сіздің қабілеттеріңізді маған тікелей көшірді.
Dialogue: 0,0:05:38.71,0:05:41.54,Default,,0,0,0,,Басқаша айтқанда, мен сізден асып түстім.
Dialogue: 0,0:05:46.09,0:05:48.72,Default,,0,0,0,,‎Бұл нені білдіретінін білесіз бе?
Dialogue: 0,0:05:54.60,0:05:57.23,Default,,0,0,0,,‎Кирисаме енді саған керек емес!
Dialogue: 0,0:06:00.56,0:06:01.40,Default,,0,0,0,,Мен...
Dialogue: 0,0:06:02.90,0:06:03.73,Default,,0,0,0,,‎Хехе
Dialogue: 0,0:06:13.24,0:06:14.74,Default,,0,0,0,,Пайдасыз заттар...
Dialogue: 0,0:06:18.04,0:06:20.50,Default,,0,0,0,,Сіздің жеңу мүмкіндігіңіз жоқ.
Dialogue: 0,0:06:20.63,0:06:22.00,Default,,0,0,0,,Беріңіз!
Dialogue: 0,0:06:46.73,0:06:47.94,Default,,0,0,0,,‎Хехе
Dialogue: 0,0:06:49.70,0:06:50.53,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:55.54,0:06:56.37,Default,,0,0,0,,‎Ку
Dialogue: 0,0:07:08.67,0:07:10.22,Default,,0,0,0,,А...
Dialogue: 0,0:07:10.72,0:07:11.72,Default,,0,0,0,,Ах
Dialogue: 0,0:07:15.14,0:07:16.14,Default,,0,0,0,,‎Ку...
Dialogue: 0,0:07:20.69,0:07:22.06,Default,,0,0,0,,Неліктен...
Dialogue: 0,0:07:31.32,0:07:32.28,Default,,0,0,0,,‎Куха
Dialogue: 0,0:07:37.45,0:07:41.58,Default,,0,0,0,,‎(қатты тыныс алу)
Dialogue: 0,0:07:42.54,0:07:45.38,Default,,0,0,0,,Бұл мүмкін емес...
Dialogue: 0,0:07:45.63,0:07:46.46,Default,,0,0,0,,Уф!
Dialogue: 0,0:07:53.72,0:07:55.18,Default,,0,0,0,,‎Ку...
Dialogue: 0,0:07:59.22,0:08:00.06,Default,,0,0,0,,‎Мм!
Dialogue: 0,0:08:04.56,0:08:05.61,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:08:09.44,0:08:12.15,Default,,0,0,0,,‎Неге... Неге?
Dialogue: 0,0:08:13.07,0:08:14.24,Default,,0,0,0,,Неге!
Dialogue: 0,0:08:19.20,0:08:23.46,Default,,0,0,0,,‎(толқындар дыбысы)
Dialogue: 0,0:08:40.18,0:08:43.60,Default,,0,0,0,,‎Неге... Бұлай болуы мүмкін емес.
Dialogue: 0,0:08:44.73,0:08:45.98,Default,,0,0,0,,Мен...
Dialogue: 0,0:08:48.61,0:08:49.61,Default,,0,0,0,,Ах
Dialogue: 0,0:08:55.03,0:08:56.32,Default,,0,0,0,,Өлтір!
Dialogue: 0,0:09:02.29,0:09:03.87,Default,,0,0,0,,Кирисамеге айтыңыз
Dialogue: 0,0:09:04.21,0:09:05.87,Default,,0,0,0,,Маған жақындама
Dialogue: 0,0:09:06.50,0:09:10.38,Default,,0,0,0,,‎Егер жақынырақ келсең, мен аямаймын.
Dialogue: 0,0:09:10.67,0:09:11.67,Default,,0,0,0,,‎Ку
Dialogue: 0,0:09:29.65,0:09:31.65,Default,,0,0,0,,‎Ку...
Dialogue: 0,0:09:43.16,0:09:44.08,Default,,0,0,0,,‎(мылтық ату)
Dialogue: 0,0:09:54.84,0:09:55.67,Default,,0,0,0,,Ах
Dialogue: 0,0:09:58.84,0:09:59.68,Default,,0,0,0,,Ах
Dialogue: 0,0:10:06.23,0:10:07.31,Default,,0,0,0,,Ах
Dialogue: 0,0:10:28.04,0:10:28.96,Default,,0,0,0,,А...
Dialogue: 0,0:10:29.29,0:10:30.12,Default,,0,0,0,,Ах
Dialogue: 0,0:10:33.96,0:10:35.00,Default,,0,0,0,,‎Фу...
Dialogue: 0,0:10:36.01,0:10:37.26,Default,,0,0,0,,‎(Қоңырау үні)
Dialogue: 0,0:10:39.47,0:10:41.01,Default,,0,0,0,,‎Оппа!
Dialogue: 0,0:10:41.18,0:10:43.47,Default,,0,0,0,,Кешіріңіз, бұл бүгінгі күн үшін.
Dialogue: 0,0:10:43.89,0:10:46.27,Default,,0,0,0,,Жақында кездескенше! Ханымдар
Dialogue: 0,0:10:47.48,0:10:50.77,Default,,0,0,0,,‎Келесі кездескенде мен сені міндетті түрде өлтіремін.
Dialogue: 0,0:11:03.03,0:11:04.08,Default,,0,0,0,,‎Изанами
Dialogue: 0,0:11:05.28,0:11:08.41,Default,,0,0,0,,‎Бұл уақытты сатып алудың айқын тәсілі.
Dialogue: 0,0:11:08.62,0:11:13.92,Default,,0,0,0,,Егер осылай көрінсе, сіз басқа жерде бірдеңе болып жатыр деп ойлауыңыз мүмкін.
Dialogue: 0,0:11:16.00,0:11:17.21,Default,,0,0,0,,Тезірек келейік
Dialogue: 0,0:11:42.66,0:11:44.28,Default,,0,0,0,,Ол қоса берілген.
Dialogue: 0,0:11:45.07,0:11:46.83,Default,,0,0,0,,Олар Мәртебелін нысанаға алып жатыр ма?
Dialogue: 0,0:11:46.95,0:11:47.79,Default,,0,0,0,,‎(Патша) Хмм...
Dialogue: 0,0:11:48.70,0:11:49.75,Default,,0,0,0,,Сіз оны танисыз ба?
Dialogue: 0,0:11:49.87,0:11:50.70,Default,,0,0,0,,‎(Патша) Жоқ...
Dialogue: 0,0:11:51.25,0:11:56.34,Default,,0,0,0,,‎Бірақ қазіргі жағдайды ескере отырып, мен оны серіктес деп ойламаймын.
Dialogue: 0,0:11:56.50,0:11:57.55,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:11:58.09,0:11:59.38,Default,,0,0,0,,Оны сілкіп алайық!
Dialogue: 0,0:11:59.51,0:12:00.67,Default,,0,0,0,,‎(Патша) Жақсысың ба?
Dialogue: 0,0:12:00.80,0:12:03.09,Default,,0,0,0,,Әзірше, мықтап ұстаңыз.
Dialogue: 0,0:12:03.22,0:12:05.22,Default,,0,0,0,,Менің мас болудан басқа амалым жоқ!
Dialogue: 0,0:12:13.69,0:12:14.52,Default,,0,0,0,,‎Хмм!
Dialogue: 0,0:12:21.69,0:12:22.57,Default,,0,0,0,,‎(Патша) Уф...
Dialogue: 0,0:12:25.45,0:12:26.37,Default,,0,0,0,,‎
Dialogue: 0,0:12:28.33,0:12:30.29,Default,,0,0,0,,‎(Патша) Ух... Ах.
Dialogue: 0,0:12:36.08,0:12:37.88,Default,,0,0,0,,‎Хмм хи хи хи
Dialogue: 0,0:12:43.34,0:12:44.93,Default,,0,0,0,,Ол шайқалады!
Dialogue: 0,0:12:55.81,0:12:56.85,Default,,0,0,0,,‎
Dialogue: 0,0:13:01.73,0:13:03.15,Default,,0,0,0,,Жасай бер!
Dialogue: 0,0:13:03.32,0:13:05.70,Default,,0,0,0,,‎Мәртебелі, өте жақсы өтті!
Dialogue: 0,0:13:05.82,0:13:06.41,Default,,0,0,0,,Ах!
Dialogue: 0,0:13:08.74,0:13:10.62,Default,,0,0,0,,‎Мигья~!
Dialogue: 0,0:13:12.87,0:13:14.12,Default,,0,0,0,,‎Уау уау...
Dialogue: 0,0:13:20.63,0:13:22.63,Default,,0,0,0,,‎Хаа~! Бұл мені құтқарды
Dialogue: 0,0:13:24.47,0:13:25.47,Default,,0,0,0,,‎Яба
Dialogue: 0,0:13:29.76,0:13:30.51,Default,,0,0,0,,‎Ха!
Dialogue: 0,0:13:34.10,0:13:36.64,Default,,0,0,0,,‎Уа, Мәртебелі, түсіңіз! (Патша) А...
Dialogue: 0,0:13:39.40,0:13:40.23,Default,,0,0,0,,Ах
Dialogue: 0,0:13:49.07,0:13:49.91,Default,,0,0,0,,‎Хмм?
Dialogue: 0,0:13:53.58,0:13:55.29,Default,,0,0,0,,Корольдік полиция?
Dialogue: 0,0:13:59.04,0:14:03.46,Default,,0,0,0,,‎(Полиция көлігінің сиренасы)
Dialogue: 0,0:14:07.38,0:14:08.93,Default,,0,0,0,,‎Е... Иә!
Dialogue: 0,0:14:09.30,0:14:10.97,Default,,0,0,0,,Бір минут күте тұрыңыз...
Dialogue: 0,0:14:11.10,0:14:11.93,Default,,0,0,0,,Лилия!
Dialogue: 0,0:14:13.06,0:14:14.14,Default,,0,0,0,,Борис!
Dialogue: 0,0:14:14.27,0:14:15.72,Default,,0,0,0,,Сіз кінәлісіз бе?
Dialogue: 0,0:14:15.85,0:14:18.94,Default,,0,0,0,,‎Ақымақ болмаңыз, дәл қазір шешіңіз!
Dialogue: 0,0:14:19.90,0:14:21.98,Default,,0,0,0,,‎Бұл менің тергеушім.
Dialogue: 0,0:14:22.11,0:14:23.69,Default,,0,0,0,,‎Мені жібересіз бе?
Dialogue: 0,0:14:24.15,0:14:26.40,Default,,0,0,0,,‎(Офицер) Жоқ, кешіріңіз.
Dialogue: 0,0:14:26.53,0:14:29.70,Default,,0,0,0,,Олай айтпа! Мен кепілдік беремін.
Dialogue: 0,0:14:30.24,0:14:31.70,Default,,0,0,0,,Лилия белгісі?
Dialogue: 0,0:14:32.12,0:14:32.95,Default,,0,0,0,,Поке
Dialogue: 0,0:14:34.16,0:14:34.99,Default,,0,0,0,,Мұнда?
Dialogue: 0,0:14:35.12,0:14:36.33,Default,,0,0,0,,‎Қария, менің кеудеме тиіспе!
Dialogue: 0,0:14:36.45,0:14:38.33,Default,,0,0,0,,Форс-мажор
Dialogue: 0,0:14:45.71,0:14:46.55,Default,,0,0,0,,Түсінді
Dialogue: 0,0:14:47.09,0:14:48.47,Default,,0,0,0,,Расталды
Dialogue: 0,0:14:52.22,0:14:53.47,Default,,0,0,0,,Не...
Dialogue: 0,0:14:53.60,0:14:55.10,Default,,0,0,0,,‎Бұл не?
Dialogue: 0,0:14:55.22,0:14:57.35,Default,,0,0,0,,‎Міне, біз естігіміз келеді.
Dialogue: 0,0:14:57.47,0:14:58.31,Default,,0,0,0,,Не?
Dialogue: 0,0:15:00.39,0:15:02.48,Default,,0,0,0,,Ех! Келіңіздер... Мәртебелі патша
Dialogue: 0,0:15:02.61,0:15:04.69,Default,,0,0,0,,‎Сен кінәлісің бе?
Dialogue: 0,0:15:04.82,0:15:06.40,Default,,0,0,0,,‎Сондықтан ол басқаша!
Dialogue: 0,0:15:07.69,0:15:08.53,Default,,0,0,0,,‎(Патша) Ах.
Dialogue: 0,0:15:15.99,0:15:18.12,Default,,0,0,0,,Мәртебелі, мына жерді басыңыз
Dialogue: 0,0:15:26.00,0:15:28.42,Default,,0,0,0,,‎Бұл нені білдіреді?
Dialogue: 0,0:15:29.30,0:15:32.76,Default,,0,0,0,,Не болып жатқанын айтыңызшы.
Dialogue: 0,0:15:34.80,0:15:37.14,Default,,0,0,0,,Сізге білудің қажеті жоқ
Dialogue: 0,0:15:37.26,0:15:39.52,Default,,0,0,0,,Тек нұсқауларды орындаңыз
Dialogue: 0,0:15:39.77,0:15:41.06,Default,,0,0,0,,На! (соққылау дыбысы)
Dialogue: 0,0:15:41.19,0:15:42.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:42.56,0:15:43.60,Default,,0,0,0,,‎Мм!
Dialogue: 0,0:15:44.06,0:15:44.90,Default,,0,0,0,,‎Мм!
Dialogue: 0,0:15:47.07,0:15:48.19,Default,,0,0,0,,‎Хмм...
Dialogue: 0,0:15:50.28,0:15:51.78,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:15:55.49,0:15:58.16,Default,,0,0,0,,‎Бұл мұндай нәрсені жасайтын уақыт емес!
Dialogue: 0,0:15:58.29,0:15:59.62,Default,,0,0,0,,Мені бұл жерден кетіріңіз.
Dialogue: 0,0:16:00.16,0:16:02.75,Default,,0,0,0,,Егер біз асықпасақ, Кейтке қауіп төніп тұр!
Dialogue: 0,0:16:03.25,0:16:05.54,Default,,0,0,0,,‎Сен солай айтсаң да...
Dialogue: 0,0:16:05.67,0:16:07.71,Default,,0,0,0,,Бұл тағы да Китке қатысты ма?
Dialogue: 0,0:16:08.42,0:16:12.09,Default,,0,0,0,,‎Ол кісінің есімі әрқашан қиыншылықтарға байланысты.
Dialogue: 0,0:16:13.18,0:16:15.55,Default,,0,0,0,,Не болып жатыр?
Dialogue: 0,0:16:16.43,0:16:21.18,Default,,0,0,0,,Бізді жай ғана егжей-тегжейлі айтпастан шығарып жіберді.
Dialogue: 0,0:16:21.31,0:16:25.56,Default,,0,0,0,,Мен Мәртебелі Корольдің аман екенін енді білдім.
Dialogue: 0,0:16:26.23,0:16:28.94,Default,,0,0,0,,Екінші жағынан, маған не болып жатқанын айтыңыз.
Dialogue: 0,0:16:29.07,0:16:30.82,Default,,0,0,0,,Кейт ұрланған
Dialogue: 0,0:16:31.07,0:16:32.24,Default,,0,0,0,,Не!
Dialogue: 0,0:16:33.45,0:16:35.86,Default,,0,0,0,,Мен Киттің түрмеде отырғанына сенемін.
Dialogue: 0,0:16:35.95,0:16:38.33,Default,,0,0,0,,Мен ойлаған жерге бара жатыр едім.
Dialogue: 0,0:16:38.45,0:16:40.83,Default,,0,0,0,,Бұл туралы кейінірек.
Dialogue: 0,0:16:42.54,0:16:43.37,Default,,0,0,0,,Түсінді
Dialogue: 0,0:16:44.16,0:16:46.38,Default,,0,0,0,,Келіңіздер, біз де ынтымақтастық жасайық
Dialogue: 0,0:16:46.63,0:16:49.09,Default,,0,0,0,,‎Бірақ мен дәл қазір қозғала алмаймын деп ойлаймын.
Dialogue: 0,0:16:49.21,0:16:51.05,Default,,0,0,0,,Борис, өтінемін.
Dialogue: 0,0:16:51.34,0:16:52.26,Default,,0,0,0,,‎Оу
Dialogue: 0,0:16:54.93,0:16:56.09,Default,,0,0,0,,‎Хмм...
Dialogue: 0,0:16:57.18,0:16:58.30,Default,,0,0,0,,‎Мм... Иә?
Dialogue: 0,0:16:59.18,0:17:01.43,Default,,0,0,0,,Мәртебелі Корольмен не болады?
Dialogue: 0,0:17:02.60,0:17:03.93,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:17:04.06,0:17:06.40,Default,,0,0,0,,Корольдік отбасының тікелей бақылауындағы мекемелер жұмыс істейді
Dialogue: 0,0:17:07.19,0:17:10.69,Default,,0,0,0,,Ол патша сарайына аман-есен оралады.
Dialogue: 0,0:17:11.28,0:17:12.78,Default,,0,0,0,,Мен көремін...
Dialogue: 0,0:17:25.25,0:17:28.25,Default,,0,0,0,,‎Мәртебелі Король, аман-есен болғаныңызға қуаныштымын.
Dialogue: 0,0:17:31.46,0:17:34.47,Default,,0,0,0,,Жүрейік. Жоғары мәртебелі сізді күтуде.
Dialogue: 0,0:17:41.68,0:17:42.51,Default,,0,0,0,,Ах
Dialogue: 0,0:17:52.40,0:17:53.23,Default,,0,0,0,,Ах!
Dialogue: 0,0:17:55.57,0:17:56.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:57.99,0:17:58.82,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:17:59.57,0:18:01.83,Default,,0,0,0,,Міне, тез кел.
Dialogue: 0,0:18:01.95,0:18:05.12,Default,,0,0,0,,‎Иә... Мұны біреу біледі ме?
Dialogue: 0,0:18:05.25,0:18:07.58,Default,,0,0,0,,Бұл таныс сияқты.
Dialogue: 0,0:18:08.62,0:18:11.88,Default,,0,0,0,,Әй, ол жігіт тікелей патша әулетінің қол астында.
Dialogue: 0,0:18:12.00,0:18:13.63,Default,,0,0,0,,‎Менің үйіме кенет кірді
Dialogue: 0,0:18:13.75,0:18:16.38,Default,,0,0,0,,Мен бастық болдым және мұнда және мұнда тапсырыс бердім.
Dialogue: 0,0:18:17.05,0:18:18.51,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:18:18.63,0:18:20.89,Default,,0,0,0,,Аты? Сенің атың кім?
Dialogue: 0,0:18:21.01,0:18:22.55,Default,,0,0,0,,Бұл ерекше атау екеніне сенімдімін...
Dialogue: 0,0:18:22.89,0:18:25.52,Default,,0,0,0,,‎О, осы уақытқа дейін келеді.
Dialogue: 0,0:18:25.64,0:18:26.48,Default,,0,0,0,,Ах!
Dialogue: 0,0:18:35.94,0:18:36.99,Default,,0,0,0,,‎Кирисаме!
Dialogue: 0,0:18:37.36,0:18:38.99,Default,,0,0,0,,Иә, Кирисаме!
Dialogue: 0,0:18:41.49,0:18:42.49,Default,,0,0,0,,Бұл жоғалды!
Dialogue: 0,0:18:43.45,0:18:44.66,Default,,0,0,0,,Сәлем, Лили!
Dialogue: 0,0:18:48.66,0:18:50.46,Default,,0,0,0,,‎(сықырлаған дыбыс)
Dialogue: 0,0:18:51.13,0:18:53.04,Default,,0,0,0,,Оу!
Dialogue: 0,0:18:54.17,0:18:55.46,Default,,0,0,0,,А...
Dialogue: 0,0:19:17.11,0:19:19.11,Default,,0,0,0,,Ол міндетті түрде осында болды.
Dialogue: 0,0:19:26.66,0:19:27.66,Default,,0,0,0,,Бұл...
Dialogue: 0,0:19:39.30,0:19:40.72,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:20:06.12,0:20:08.70,Default,,0,0,0,,‎(Куроба) Жел мені осылай алып кетеді.
Dialogue: 0,0:20:09.70,0:20:10.83,Default,,0,0,0,,Уақытында келіңіз.
Dialogue: 0,0:20:39.19,0:20:45.20,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:22:23.25,0:22:29.26,Default,,0,0,0,,‎〜♪
Dialogue: 0,0:22:30.76,0:22:36.76,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory