Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.00,0:00:11.01,Default,,0,0,0,,‎NETFLIX түпнұсқа аниме сериясы
Dialogue: 0,0:00:14.84,0:00:16.68,Default,,0,0,0,,Қандай көне қирандылар әлі де бар?
Dialogue: 0,0:00:17.35,0:00:19.10,Default,,0,0,0,,‎Бұлар өте аз.
Dialogue: 0,0:00:19.22,0:00:22.18,Default,,0,0,0,,‎Әрқайсысын оң жаққа соғуға уақыт жоқ, егер сіз оны тарылтпасаңыз.
Dialogue: 0,0:00:22.89,0:00:23.94,Default,,0,0,0,,‎Егер
Dialogue: 0,0:00:24.06,0:00:27.94,Default,,0,0,0,,Қара қауырсындардың патшасымен ең жақын жері осы емес пе?
Dialogue: 0,0:00:28.31,0:00:29.27,Default,,0,0,0,,‎(Куроба) Қазан...
Dialogue: 0,0:00:30.02,0:00:32.90,Default,,0,0,0,,‎"Дәл қазір мен ерекше жерде демалып жатырмын."
Dialogue: 0,0:00:33.40,0:00:36.03,Default,,0,0,0,,‎«Жақсы, бұл теңізге жақын»
Dialogue: 0,0:00:36.28,0:00:39.12,Default,,0,0,0,,‎«Егер оның қанаты болса, ең жақсы жер болар еді»
Dialogue: 0,0:00:39.49,0:00:40.45,Default,,0,0,0,,‎Бұл не?
Dialogue: 0,0:00:41.37,0:00:42.83,Default,,0,0,0,,‎(Куроба) Ол солай деді.
Dialogue: 0,0:00:43.33,0:00:44.16,Default,,0,0,0,,‎(Патша) Ах...
Dialogue: 0,0:00:45.50,0:00:50.46,Default,,0,0,0,,‎Жет Блэктің солтүстігін, оңтүстігін, шығысын және батысын қорғау үшін салынған төрт мұнара
Dialogue: 0,0:00:51.17,0:00:54.92,Default,,0,0,0,,Менің естуімше, бұл Қара қауырсындардың патшасына қатысты қасиетті жер.
Dialogue: 0,0:00:55.72,0:00:57.26,Default,,0,0,0,,Бұл жерде ше?
Dialogue: 0,0:01:00.14,0:01:00.97,Default,,0,0,0,,А...
Dialogue: 0,0:01:01.10,0:01:07.10,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:01:09.98,0:01:15.99,Default,,0,0,0,,‎〜♪
Dialogue: 0,0:01:42.18,0:01:43.14,Default,,0,0,0,,‎(Кит) Ха...
Dialogue: 0,0:01:43.89,0:01:45.64,Default,,0,0,0,,Бұл уақыт әлдеқашан болды ма?
Dialogue: 0,0:01:57.57,0:01:59.95,Default,,0,0,0,,Ештеңе емес
Dialogue: 0,0:02:01.20,0:02:03.33,Default,,0,0,0,,Менің ойымша, бұл мүмкін емес
Dialogue: 0,0:02:03.66,0:02:06.20,Default,,0,0,0,,Түсіндім, бұл жігіт ақылды екен.
Dialogue: 0,0:02:07.37,0:02:08.54,Default,,0,0,0,,‎(Гилберт) Сәлем
Dialogue: 0,0:02:11.79,0:02:12.75,Default,,0,0,0,,Сәлем
Dialogue: 0,0:02:13.42,0:02:16.01,Default,,0,0,0,,Эй, сен мені естисің, солай ма?
Dialogue: 0,0:02:16.13,0:02:17.55,Default,,0,0,0,,‎Кит Фрик
Dialogue: 0,0:02:35.23,0:02:38.19,Default,,0,0,0,,Сіз Гилберт деңгейіне түсіп қалдыңыз ба?
Dialogue: 0,0:02:40.16,0:02:41.57,Default,,0,0,0,,Міне, ақыры келді.
Dialogue: 0,0:02:43.87,0:02:44.83,Default,,0,0,0,,‎Кит
Dialogue: 0,0:02:46.16,0:02:47.70,Default,,0,0,0,,‎(Кит) Өзгеріс жоқ.
Dialogue: 0,0:02:50.29,0:02:53.17,Default,,0,0,0,,Егер бейсаналықтың іске асуы иллюзия болса
Dialogue: 0,0:02:53.29,0:02:56.25,Default,,0,0,0,,Өлім алдында миға бөлінетін дәрілер...
Dialogue: 0,0:02:56.84,0:02:57.88,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:02:59.22,0:03:00.17,Default,,0,0,0,,‎Қалайсың?
Dialogue: 0,0:03:00.63,0:03:02.09,Default,,0,0,0,,Сіз сау көрінесіз бе?
Dialogue: 0,0:03:03.26,0:03:04.10,Default,,0,0,0,,‎
Dialogue: 0,0:03:06.72,0:03:08.10,Default,,0,0,0,,‎(Гилберт) Мені елемеңіз.
Dialogue: 0,0:03:10.31,0:03:12.15,Default,,0,0,0,,‎Бұл әдеттегідей.
Dialogue: 0,0:03:15.52,0:03:16.61,Default,,0,0,0,,Бас тарту
Dialogue: 0,0:03:22.03,0:03:25.12,Default,,0,0,0,,Мен сіздің деңгейіңізге түстім.
Dialogue: 0,0:03:27.24,0:03:29.29,Default,,0,0,0,,Сіз маған жауап бердіңіз.
Dialogue: 0,0:03:29.50,0:03:30.87,Default,,0,0,0,,‎(Кейт) Шулы
Dialogue: 0,0:03:32.04,0:03:33.88,Default,,0,0,0,,Сіз әлі де кешіре алмайсыз ба?
Dialogue: 0,0:03:34.25,0:03:38.13,Default,,0,0,0,,‎Мені өлтіру сенің көңіліңді жақсартты деп ойладым.
Dialogue: 0,0:03:39.01,0:03:41.01,Default,,0,0,0,,Бұл ең жаман сезім
Dialogue: 0,0:03:41.72,0:03:45.60,Default,,0,0,0,,‎(Гилберт) Сіз кешіре алмайсыз ба?
Dialogue: 0,0:03:46.39,0:03:48.51,Default,,0,0,0,,Эриканы өлтірген мен болдым
Dialogue: 0,0:03:48.81,0:03:51.89,Default,,0,0,0,,‎Бірақ сен себепкер болдың.
Dialogue: 0,0:03:55.98,0:03:57.40,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:03:57.94,0:03:58.90,Default,,0,0,0,,Не?
Dialogue: 0,0:03:59.28,0:04:01.61,Default,,0,0,0,,‎(Кит) Сен менің иллюзиямсың, солай ма?
Dialogue: 0,0:04:01.74,0:04:02.82,Default,,0,0,0,,‎(Гилберт) Дұрыс.
Dialogue: 0,0:04:02.95,0:04:04.41,Default,,0,0,0,,‎(Кит) мені білдіреді.
Dialogue: 0,0:04:04.70,0:04:05.87,Default,,0,0,0,,‎(Гильберт) Сөзсіз
Dialogue: 0,0:04:05.99,0:04:09.49,Default,,0,0,0,,‎(Кит) Демек, сен мені кінәлап отырсың.
Dialogue: 0,0:04:09.62,0:04:10.91,Default,,0,0,0,,‎(Гилберт) Иә... Бұл дұрыс.
Dialogue: 0,0:04:12.25,0:04:15.92,Default,,0,0,0,,‎Сенің ішіңдегі қараңғылық бейнесі менің келбетім
Dialogue: 0,0:04:16.25,0:04:18.50,Default,,0,0,0,,‎(Кит) Бұл мәселе.
Dialogue: 0,0:04:18.63,0:04:20.34,Default,,0,0,0,,‎(Гилберт) Қазір не істеп жатырсың?
Dialogue: 0,0:04:20.51,0:04:21.92,Default,,0,0,0,,Сіз мұны білдіңіз.
Dialogue: 0,0:04:22.80,0:04:25.93,Default,,0,0,0,,‎Ұзақ уақыт бойы...
Dialogue: 0,0:04:30.10,0:04:30.93,Default,,0,0,0,,‎Кит
Dialogue: 0,0:04:32.27,0:04:33.31,Default,,0,0,0,,Мен...
Dialogue: 0,0:04:33.43,0:04:35.90,Default,,0,0,0,,Мен сізден бірдеңе сұрағым келді.
Dialogue: 0,0:04:36.02,0:04:36.85,Default,,0,0,0,,‎(Кит) Иә?
Dialogue: 0,0:04:38.19,0:04:41.90,Default,,0,0,0,,‎Мен ғылыми-зерттеу институтындағы жұмысымды тастап, полицияға жұмысқа орналастым...
Dialogue: 0,0:04:43.57,0:04:45.86,Default,,0,0,0,,Менен қашу үшін бе?
Dialogue: 0,0:04:47.12,0:04:49.16,Default,,0,0,0,,‎(Кит) Бұл жалғыз себеп емес.
Dialogue: 0,0:04:49.49,0:04:52.95,Default,,0,0,0,,Себептердің бірі осы болды ма?
Dialogue: 0,0:04:53.37,0:04:56.21,Default,,0,0,0,,‎Аа... Менің ойымша, сіз солай айта аласыз.
Dialogue: 0,0:04:57.00,0:04:58.08,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:04:58.54,0:04:59.96,Default,,0,0,0,,Сіз түсінесіз.
Dialogue: 0,0:05:01.71,0:05:05.05,Default,,0,0,0,,‎Ғылыми-зерттеу институтына түсемін деген кезде.
Dialogue: 0,0:05:05.84,0:05:07.51,Default,,0,0,0,,Әлі есімде
Dialogue: 0,0:05:09.35,0:05:10.89,Default,,0,0,0,,Мен мұны сол кезде түсіндім
Dialogue: 0,0:05:11.39,0:05:14.60,Default,,0,0,0,,Маған Эрика ұнайды.
Dialogue: 0,0:05:18.73,0:05:19.98,Default,,0,0,0,,‎Білмеймін
Dialogue: 0,0:05:21.40,0:05:22.40,Default,,0,0,0,,Және...
Dialogue: 0,0:05:22.57,0:05:25.49,Default,,0,0,0,,Мен сізге Гилберт ұнайды деп ойладым.
Dialogue: 0,0:05:30.91,0:05:33.54,Default,,0,0,0,,‎(Гилберт) Мен Эриканың сезімін білдім.
Dialogue: 0,0:05:34.00,0:05:35.71,Default,,0,0,0,,Сіз қашып кеттіңіз
Dialogue: 0,0:05:38.25,0:05:41.88,Default,,0,0,0,,Мен Эриканы алыс ұстау үшін ғылыми-зерттеу институтын тастадым.
Dialogue: 0,0:05:45.47,0:05:46.67,Default,,0,0,0,,‎(Кит) Иә.
Dialogue: 0,0:05:47.93,0:05:51.97,Default,,0,0,0,,‎Мен қашып кетпесем, Эрика өлмес еді.
Dialogue: 0,0:05:54.31,0:05:58.23,Default,,0,0,0,,‎Үшеуміз істі қазірше шешіп алар едік.
Dialogue: 0,0:06:01.48,0:06:02.65,Default,,0,0,0,,‎(Кейт) №.
Dialogue: 0,0:06:02.94,0:06:04.69,Default,,0,0,0,,Мен сенімен сөйлесуді аяқтадым.
Dialogue: 0,0:06:04.82,0:06:06.32,Default,,0,0,0,,Тез жоғалып кетіңіз!
Dialogue: 0,0:06:08.91,0:06:11.20,Default,,0,0,0,,‎(Гилберт) Бұл сізге байланысты.
Dialogue: 0,0:06:11.87,0:06:15.54,Default,,0,0,0,,‎Сенің жүрегің әлі де айыпталғысы келеді.
Dialogue: 0,0:06:20.50,0:06:25.21,Default,,0,0,0,,Мен ешкім білмейтін қылмыс үшін сотталғым келеді.
Dialogue: 0,0:06:25.92,0:06:28.26,Default,,0,0,0,,Мен өзімді кінәлі сезінуден арыла алмаймын
Dialogue: 0,0:06:35.10,0:06:36.68,Default,,0,0,0,,Ағымдағы жағдай
Dialogue: 0,0:06:36.81,0:06:40.14,Default,,0,0,0,,Мен мұны өзіме лайықты жаза ретінде қабылдаймын.
Dialogue: 0,0:06:42.48,0:06:44.02,Default,,0,0,0,,Мүмкін солай шығар.
Dialogue: 0,0:06:44.77,0:06:47.82,Default,,0,0,0,,Сонда сіз өле алмайсыз, солай ма?
Dialogue: 0,0:06:51.45,0:06:54.33,Default,,0,0,0,,‎Кит Фрик, егер сіз бұл туралы аздап ойласаңыз.
Dialogue: 0,0:06:55.12,0:06:58.70,Default,,0,0,0,,‎Осы жерден құтылудың жолын таппайсың ба?
Dialogue: 0,0:07:00.87,0:07:01.83,Default,,0,0,0,,‎Мүмкін емес
Dialogue: 0,0:07:02.42,0:07:04.29,Default,,0,0,0,,Заттардың шегі болады
Dialogue: 0,0:07:06.30,0:07:08.97,Default,,0,0,0,,Мұнда қажеті жоқ.
Dialogue: 0,0:07:09.72,0:07:12.34,Default,,0,0,0,,Сонда мен осылай өлуім керек пе?
Dialogue: 0,0:07:15.76,0:07:17.47,Default,,0,0,0,,‎Сен тағы қашасың ба?
Dialogue: 0,0:07:37.29,0:07:39.00,Default,,0,0,0,,‎Кит - ақымақ
Dialogue: 0,0:07:48.05,0:07:51.05,Default,,0,0,0,,Сіз маған ақымақ екенімді айттыңыз.
Dialogue: 0,0:07:51.34,0:07:52.84,Default,,0,0,0,,Жалғыз сен едің.
Dialogue: 0,0:07:53.51,0:07:55.26,Default,,0,0,0,,Бұл ақымақтық.
Dialogue: 0,0:07:56.18,0:08:00.64,Default,,0,0,0,,Мен де айта алмадым.
Dialogue: 0,0:08:04.10,0:08:06.77,Default,,0,0,0,,Гилберт мейірімді болды.
Dialogue: 0,0:08:10.61,0:08:13.15,Default,,0,0,0,,Сен маған бәрін кешірдің.
Dialogue: 0,0:08:13.28,0:08:15.91,Default,,0,0,0,,‎Мен ол мені бұзды
Dialogue: 0,0:08:17.03,0:08:18.87,Default,,0,0,0,,Мен кез келген нәрсе туралы сұрай аламын.
Dialogue: 0,0:08:20.12,0:08:22.16,Default,,0,0,0,,‎Сондықтан мен айттым
Dialogue: 0,0:08:23.33,0:08:24.87,Default,,0,0,0,,‎«Мен сені сүйемін Кит»
Dialogue: 0,0:08:25.54,0:08:29.30,Default,,0,0,0,,«Мен өкінгім келмейді, сондықтан мен Китке айтамын».
Dialogue: 0,0:08:30.80,0:08:31.92,Default,,0,0,0,,Бұл...
Dialogue: 0,0:08:32.42,0:08:36.55,Default,,0,0,0,,‎Ол мені кешірмеген жалғыз нәрсе
Dialogue: 0,0:08:40.39,0:08:43.98,Default,,0,0,0,,‎Кит Менің соңғы сөздерім...
Dialogue: 0,0:08:47.02,0:08:48.98,Default,,0,0,0,,‎Кит, тыңда.
Dialogue: 0,0:08:52.49,0:08:53.57,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:09:00.83,0:09:01.70,Default,,0,0,0,,Жоғалыңыз
Dialogue: 0,0:09:05.75,0:09:07.92,Default,,0,0,0,,‎(Гилберт) Мен сенің қашуыңа жол бермеймін.
Dialogue: 0,0:09:20.68,0:09:23.35,Default,,0,0,0,,Өшпейтін код жазылған
Dialogue: 0,0:09:24.14,0:09:26.73,Default,,0,0,0,,‎Мен сенімен өмір сүруді жалғастырамын
Dialogue: 0,0:09:29.44,0:09:31.82,Default,,0,0,0,,Біз әрқашан бірге боламыз
Dialogue: 0,0:09:35.70,0:09:37.15,Default,,0,0,0,,Мен білемін!
Dialogue: 0,0:09:39.16,0:09:43.70,Default,,0,0,0,,Мен сенен қашпағанымда, сен өлмес едің!
Dialogue: 0,0:09:45.71,0:09:50.25,Default,,0,0,0,,‎Мен сенің мені пайдасыз деп көруіңді қаламадым!
Dialogue: 0,0:09:52.17,0:09:54.51,Default,,0,0,0,,Сен маған ұнадың
Dialogue: 0,0:09:57.13,0:10:00.09,Default,,0,0,0,,‎Мен сенің қасымда әрқашан күліп жүргеніңді қаладым
Dialogue: 0,0:10:03.68,0:10:07.44,Default,,0,0,0,,Мен эмоцияларымды білдіруде шебер емес екенімді білдім.
Dialogue: 0,0:10:08.44,0:10:09.27,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:10:11.23,0:10:12.61,Default,,0,0,0,,Сөйлеу...
Dialogue: 0,0:10:13.61,0:10:15.78,Default,,0,0,0,,Мен құлап қаламын ба деп қорықтым
Dialogue: 0,0:10:17.78,0:10:20.03,Default,,0,0,0,,‎Себебі мен сенің жездеңмін!
Dialogue: 0,0:10:22.91,0:10:24.99,Default,,0,0,0,,Менің ағам мен әпкем...
Dialogue: 0,0:10:28.00,0:10:30.54,Default,,0,0,0,,‎Себебі сен мені сүйе алмайсың!
Dialogue: 0,0:10:33.92,0:10:35.63,Default,,0,0,0,,Мен оны қорғауым керек
Dialogue: 0,0:10:38.05,0:10:40.72,Default,,0,0,0,,‎Себебі сен мені сүйе алмайсың!
Dialogue: 0,0:10:44.01,0:10:45.72,Default,,0,0,0,,‎Мен сені сүйдім және т.б
Dialogue: 0,0:10:46.27,0:10:48.35,Default,,0,0,0,,Мен оны қорғай да алмадым.
Dialogue: 0,0:10:53.98,0:10:54.82,Default,,0,0,0,,Мен...
Dialogue: 0,0:10:55.78,0:10:57.69,Default,,0,0,0,,Сен дәрменсіз ақымақсың.
Dialogue: 0,0:10:59.95,0:11:00.91,Default,,0,0,0,,‎Кит
Dialogue: 0,0:11:02.11,0:11:03.45,Default,,0,0,0,,Мен осылай өлсем
Dialogue: 0,0:11:03.57,0:11:05.83,Default,,0,0,0,,Мен сені тағы көремін бе?
Dialogue: 0,0:11:06.83,0:11:09.12,Default,,0,0,0,,Біз мәңгі бірге бола аламыз ба?
Dialogue: 0,0:11:10.79,0:11:14.88,Default,,0,0,0,,‎Кит, уәдеңді ұмытпа.
Dialogue: 0,0:11:15.21,0:11:16.25,Default,,0,0,0,,‎(Кит) Уәде...
Dialogue: 0,0:11:17.09,0:11:20.84,Default,,0,0,0,,‎(Гилберт пен Эрика) Кит Кит Кит...
Dialogue: 0,0:11:30.81,0:11:31.77,Default,,0,0,0,,‎Кит
Dialogue: 0,0:11:33.02,0:11:36.44,Default,,0,0,0,,‎Кит Мен өте жақсы наубайхана таптым
Dialogue: 0,0:11:36.57,0:11:37.86,Default,,0,0,0,,Келесі аптада барыңыз
Dialogue: 0,0:11:42.28,0:11:45.37,Default,,0,0,0,,‎(Кит) Жоқ, мен ұмытып қалдым.
Dialogue: 0,0:11:48.29,0:11:49.29,Default,,0,0,0,,А...
Dialogue: 0,0:11:51.00,0:11:52.54,Default,,0,0,0,,Мазасыз!
Dialogue: 0,0:11:56.63,0:11:59.13,Default,,0,0,0,,Келесі сейсенбі
Dialogue: 0,0:11:59.38,0:12:01.88,Default,,0,0,0,,‎Мен өмір сүруім керек екенін ұмытып кеттім.
Dialogue: 0,0:12:02.80,0:12:05.09,Default,,0,0,0,,Кейт солардың бірінде
Dialogue: 0,0:12:06.60,0:12:08.39,Default,,0,0,0,,Қайсысы?
Dialogue: 0,0:12:09.06,0:12:10.47,Default,,0,0,0,,‎Мм.
Dialogue: 0,0:12:12.48,0:12:16.56,Default,,0,0,0,,‎Мм.
Dialogue: 0,0:12:17.77,0:12:21.74,Default,,0,0,0,,Мен оны қысқарту үшін басқа ақпарат алғым келмейді...
Dialogue: 0,0:12:21.86,0:12:22.82,Default,,0,0,0,,Лилия...
Dialogue: 0,0:12:22.95,0:12:23.78,Default,,0,0,0,,Таңдау жоқ
Dialogue: 0,0:12:25.07,0:12:27.16,Default,,0,0,0,,‎Жалғыз ғана бару және оны тексеру ғана қалды.
Dialogue: 0,0:12:28.83,0:12:32.33,Default,,0,0,0,,‎Біз ақпарат алу кезінде байланыста боламыз.
Dialogue: 0,0:12:33.41,0:12:36.33,Default,,0,0,0,,Мен дереу патша сарайына баруым керек еді.
Dialogue: 0,0:12:36.46,0:12:37.38,Default,,0,0,0,,Енді...
Dialogue: 0,0:12:37.50,0:12:39.92,Default,,0,0,0,,‎(Патша) Уайымдаудың қажеті жоқ. Мен сенімен бірге боламын.
Dialogue: 0,0:12:40.25,0:12:41.84,Default,,0,0,0,,Бұл қауіпті
Dialogue: 0,0:12:42.13,0:12:44.47,Default,,0,0,0,,Соңына дейін көрейін
Dialogue: 0,0:12:47.14,0:12:48.47,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:50.26,0:12:53.31,Default,,0,0,0,,Барлығын бөліп, төрт мұнараны зерттеңіз
Dialogue: 0,0:12:54.44,0:12:56.69,Default,,0,0,0,,‎Куроба-кун осы екі орын
Dialogue: 0,0:12:58.36,0:13:00.69,Default,,0,0,0,,Юна-чан мен Изанами осында
Dialogue: 0,0:13:03.61,0:13:07.45,Default,,0,0,0,,Содан кейін мен қалғанын зерттеймін.
Dialogue: 0,0:13:08.95,0:13:11.20,Default,,0,0,0,,Мәртебелі мырза мені ертіп жүріңізші.
Dialogue: 0,0:13:12.08,0:13:15.33,Default,,0,0,0,,‎ Менің ойымша, бұл тарау қауіпті.
Dialogue: 0,0:13:16.67,0:13:19.25,Default,,0,0,0,,‎Жылдам тексерудің басқа жолы бар ма?
Dialogue: 0,0:13:21.17,0:13:22.46,Default,,0,0,0,,Түсінді
Dialogue: 0,0:13:22.84,0:13:24.80,Default,,0,0,0,,Жарайды! Барайық!
Dialogue: 0,0:13:30.51,0:13:32.14,Default,,0,0,0,,‎(Кит) Уф... Уф...
Dialogue: 0,0:13:35.60,0:13:37.14,Default,,0,0,0,,‎Ку...
Dialogue: 0,0:13:49.62,0:13:51.74,Default,,0,0,0,,Міне, осындай нәрсе.
Dialogue: 0,0:14:08.59,0:14:10.55,Default,,0,0,0,,Сіз мұнымен жарты күн табуға болады
Dialogue: 0,0:14:12.81,0:14:14.27,Default,,0,0,0,,Енді...
Dialogue: 0,0:14:15.31,0:14:16.14,Default,,0,0,0,,Сіз...
Dialogue: 0,0:14:19.10,0:14:20.15,Default,,0,0,0,,Жасайсыз ба?
Dialogue: 0,0:14:21.81,0:14:22.65,Default,,0,0,0,,‎(қозғалтқыштың іске қосылу дыбысы)
Dialogue: 0,0:14:23.77,0:14:24.65,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:14:25.73,0:14:27.15,Default,,0,0,0,,‎Барлығыңыз, сақ болыңыз!
Dialogue: 0,0:14:37.79,0:14:40.12,Default,,0,0,0,,‎(Пернетақтаны түрту дыбысы)
Dialogue: 0,0:14:40.25,0:14:42.17,Default,,0,0,0,,Куроба және басқалары қозғала бастады.
Dialogue: 0,0:14:42.29,0:14:44.04,Default,,0,0,0,,Соңында?
Dialogue: 0,0:14:45.75,0:14:46.63,Default,,0,0,0,,Асагири туралы не деуге болады?
Dialogue: 0,0:14:47.80,0:14:50.13,Default,,0,0,0,,‎Барлық қозғалыстар түсірілді
Dialogue: 0,0:14:50.59,0:14:52.39,Default,,0,0,0,,Бұл толығымен аяқталды.
Dialogue: 0,0:14:53.76,0:14:56.68,Default,,0,0,0,,‎Бұл оның күші жетпейтінін білдіре ме?
Dialogue: 0,0:15:01.27,0:15:02.73,Default,,0,0,0,,‎Сандық
Dialogue: 0,0:15:06.15,0:15:08.40,Default,,0,0,0,,‎Дұрыс болса, ықтималдық жоғары.
Dialogue: 0,0:15:08.57,0:15:11.03,Default,,0,0,0,,‎ Оны басып, нәтижені көру жеткілікті.
Dialogue: 0,0:15:11.16,0:15:13.95,Default,,0,0,0,,А, мен оны көргім келді.
Dialogue: 0,0:15:14.12,0:15:14.95,Default,,0,0,0,,‎Қазан
Dialogue: 0,0:15:15.08,0:15:16.99,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:15:19.25,0:15:20.33,Default,,0,0,0,,Тезірек!
Dialogue: 0,0:15:20.50,0:15:23.00,Default,,0,0,0,,‎ RIS-ті күтіңіз.
Dialogue: 0,0:15:23.67,0:15:24.92,Default,,0,0,0,,Олай айтпа
Dialogue: 0,0:15:25.50,0:15:27.34,Default,,0,0,0,,‎Олар да маңызды серіктестер.
Dialogue: 0,0:15:27.46,0:15:28.80,Default,,0,0,0,,Иә иә
Dialogue: 0,0:15:48.11,0:15:52.70,Default,,0,0,0,,‎(Кейт) Бұл ақылсыз. Оған басымды орап тастай алмаймын.
Dialogue: 0,0:15:54.53,0:15:58.62,Default,,0,0,0,,‎Егер қателессең, міндетті түрде өлесің.
Dialogue: 0,0:16:02.25,0:16:04.42,Default,,0,0,0,,Оған да көмектесу мүмкін емес.
Dialogue: 0,0:16:09.96,0:16:11.80,Default,,0,0,0,,‎Хмм.
Dialogue: 0,0:16:12.80,0:16:14.43,Default,,0,0,0,,‎(Патша) Мәселе бар ма?
Dialogue: 0,0:16:15.01,0:16:17.14,Default,,0,0,0,,Прогресс баяу.
Dialogue: 0,0:16:18.89,0:16:20.02,Default,,0,0,0,,‎(Патша) Біз не істеуіміз керек?
Dialogue: 0,0:16:21.02,0:16:23.06,Default,,0,0,0,,‎Мен төте жолды пайдалана аламын ба?
Dialogue: 0,0:16:23.81,0:16:24.65,Default,,0,0,0,,‎(Патша) Маған бәрібір.
Dialogue: 0,0:16:25.77,0:16:26.81,Default,,0,0,0,,Nja!
Dialogue: 0,0:16:31.94,0:16:33.20,Default,,0,0,0,,‎(Патша) Уау...
Dialogue: 0,0:16:33.32,0:16:35.28,Default,,0,0,0,,‎Жақсысың ба, Мәртебелі?
Dialogue: 0,0:16:35.41,0:16:36.99,Default,,0,0,0,,‎(Патша) Уф...
Dialogue: 0,0:16:37.12,0:16:38.95,Default,,0,0,0,,Біраз өткізіп жіберейік!
Dialogue: 0,0:16:42.04,0:16:43.62,Default,,0,0,0,,‎(Патша) Уау!
Dialogue: 0,0:16:54.43,0:16:56.39,Default,,0,0,0,,Бұл жақсы емес пе?
Dialogue: 0,0:17:01.14,0:17:03.23,Default,,0,0,0,,‎Менің қалағанымды істеу дұрыс па?
Dialogue: 0,0:17:03.35,0:17:05.06,Default,,0,0,0,,Жарайды
Dialogue: 0,0:17:07.81,0:17:09.40,Default,,0,0,0,,Сіз оны басқара аласыз ба?
Dialogue: 0,0:17:09.52,0:17:10.40,Default,,0,0,0,,Мүмкін
Dialogue: 0,0:17:12.65,0:17:14.32,Default,,0,0,0,,‎Мен сізді қайтадан көргеніме қуаныштымын
Dialogue: 0,0:17:15.20,0:17:16.70,Default,,0,0,0,,Кенеттен не болды?
Dialogue: 0,0:17:20.03,0:17:22.37,Default,,0,0,0,,‎Себебі мен көпке дейін айта алмадым...
Dialogue: 0,0:17:28.00,0:17:31.21,Default,,0,0,0,,‎Эй, мен Куробамен байланыста болдым.
Dialogue: 0,0:17:32.34,0:17:33.55,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:17:38.59,0:17:40.26,Default,,0,0,0,,Біз анда-санда кездесіп тұратынбыз.
Dialogue: 0,0:17:40.39,0:17:42.14,Default,,0,0,0,,Иә? Солай ма?
Dialogue: 0,0:17:42.26,0:17:43.31,Default,,0,0,0,,‎(қозғалтқыштың іске қосылу дыбысы)
Dialogue: 0,0:17:43.43,0:17:45.93,Default,,0,0,0,,Иә? Сіз мұны естіген жоқсыз ба?
Dialogue: 0,0:17:46.06,0:17:47.23,Default,,0,0,0,,Мен естіген жоқпын
Dialogue: 0,0:17:47.35,0:17:48.81,Default,,0,0,0,,Толығырақ айтып беріңізші
Dialogue: 0,0:17:49.90,0:17:51.27,Default,,0,0,0,,Келесі кездескенше
Dialogue: 0,0:17:51.40,0:17:53.07,Default,,0,0,0,,Бір сәт...
Dialogue: 0,0:17:53.19,0:17:54.78,Default,,0,0,0,,‎(Домалақ тастардың дыбысы)
Dialogue: 0,0:18:34.69,0:18:36.69,Default,,0,0,0,,‎(Кейт) Бұл туралы.
Dialogue: 0,0:18:38.45,0:18:39.82,Default,,0,0,0,,‎Мәселе өлшемде емес.
Dialogue: 0,0:18:40.86,0:18:42.32,Default,,0,0,0,,Секіру жылдамдығы
Dialogue: 0,0:18:45.70,0:18:46.70,Default,,0,0,0,,Енді...
Dialogue: 0,0:18:47.50,0:18:49.50,Default,,0,0,0,,‎Құлау жылдамдығы...жеткіліксіз
Dialogue: 0,0:18:49.62,0:18:52.33,Default,,0,0,0,,‎Жолды қосыңыз... Қашықтық жеткіліксіз
Dialogue: 0,0:18:52.50,0:18:54.71,Default,,0,0,0,,‎Шығырды пайдалану... Жоқ
Dialogue: 0,0:18:55.13,0:18:56.67,Default,,0,0,0,,‎Ауыстыруға болатын нәрселер...
Dialogue: 0,0:19:01.05,0:19:03.47,Default,,0,0,0,,Олардың таулары бар.
Dialogue: 0,0:19:14.73,0:19:16.07,Default,,0,0,0,,‎Ха... Келесі.
Dialogue: 0,0:19:24.45,0:19:25.28,Default,,0,0,0,,Хехе
Dialogue: 0,0:19:25.41,0:19:26.99,Default,,0,0,0,,‎(Патша) Уф...
Dialogue: 0,0:19:31.87,0:19:34.00,Default,,0,0,0,,Баратын жер дерлік осында
Dialogue: 0,0:19:34.46,0:19:35.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:19:47.10,0:19:47.93,Default,,0,0,0,,‎(Кит) Уау.
Dialogue: 0,0:19:54.19,0:19:56.11,Default,,0,0,0,,‎(қатты тыныс алу)
Dialogue: 0,0:19:57.23,0:19:58.11,Default,,0,0,0,,A...
Dialogue: 0,0:20:13.25,0:20:14.54,Default,,0,0,0,,Мен оны таптым
Dialogue: 0,0:20:16.88,0:20:17.96,Default,,0,0,0,,‎Қазан
Dialogue: 0,0:20:29.10,0:20:30.02,Default,,0,0,0,,‎(Куроба) Солай ма?
Dialogue: 0,0:21:26.20,0:21:27.03,Default,,0,0,0,,А...
Dialogue: 0,0:21:35.29,0:21:36.12,Default,,0,0,0,,‎Хехе
Dialogue: 0,0:21:38.25,0:21:44.26,Default,,0,0,0,,‎♪〜
Dialogue: 0,0:23:22.31,0:23:28.32,Default,,0,0,0,,‎〜♪
