Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:05.58,0:00:10.51,Default,,0,0,0,,Kodama 718 жақын арада 17-платформаға келеді.
Dialogue: 0,0:00:10.51,0:00:11.88,Default,,0,0,0,,Kodama 718 жақын арада 17-платформаға келеді.
Dialogue: 0,0:00:10.51,0:00:11.88,Default,,0,0,0,,Я...
Dialogue: 0,0:00:11.97,0:00:14.64,Default,,0,0,0,,Бұл сағатта да ыстық...
Dialogue: 0,0:00:14.72,0:00:16.51,Default,,0,0,0,,Қазірдің өзінде шілде
Dialogue: 0,0:00:16.60,0:00:17.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:17.89,0:00:20.56,Default,,0,0,0,,Кондиционері бар жерде тез суытқым келеді.
Dialogue: 0,0:00:20.64,0:00:21.64,Default,,0,0,0,,Ах
Dialogue: 0,0:00:21.73,0:00:24.06,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:00:24.15,0:00:25.15,Default,,0,0,0,,Сәлем
Dialogue: 0,0:00:25.23,0:00:28.40,Default,,0,0,0,,Мені шақырғаныңызға рахмет.
Dialogue: 0,0:00:28.48,0:00:30.40,Default,,0,0,0,,Мен бүгін таңертеңнен бері қатты толқыдым.
Dialogue: 0,0:00:30.48,0:00:32.65,Default,,0,0,0,,Мен оны қатты күттім.
Dialogue: 0,0:00:32.74,0:00:35.61,Default,,0,0,0,,Әрбір бармен кем дегенде бір рет баратын қасиетті жер
Dialogue: 0,0:00:35.70,0:00:37.28,Default,,0,0,0,,Yamazaki спирт зауыты
Dialogue: 0,0:00:37.37,0:00:38.70,Default,,0,0,0,,Хехехе
Dialogue: 0,0:00:38.78,0:00:43.04,Default,,0,0,0,,Мен жақсы брондау алдым. Бұл туристер арасында танымал деп естідім.
Dialogue: 0,0:00:43.12,0:00:45.79,Default,,0,0,0,,Кішкене бұралу бар.
Dialogue: 0,0:00:46.63,0:00:50.05,Default,,0,0,0,,Мен екінші тараппен сөйлестім.
Dialogue: 0,0:00:50.13,0:00:54.55,Default,,0,0,0,,Оның да тарихи құндылығы бар. Сіз сондай-ақ өндіріс процесін бақылай аласыз.
Dialogue: 0,0:00:54.63,0:00:59.31,Default,,0,0,0,,Бұл сіздің бармендік дағдыларыңызды жақсартуға өте ыңғайлы.
Dialogue: 0,0:01:00.60,0:01:03.85,Default,,0,0,0,,Сонда мына төрт адам сенімен бірге жүр ме?
Dialogue: 0,0:01:03.93,0:01:06.06,Default,,0,0,0,,Жоқ, тағы бір адам...
Dialogue: 0,0:01:06.15,0:01:07.48,Default,,0,0,0,,О, итата
Dialogue: 0,0:01:07.56,0:01:08.56,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:08.65,0:01:11.07,Default,,0,0,0,,Мынау қандай жігіт?
Dialogue: 0,0:01:11.15,0:01:12.74,Default,,0,0,0,,Күте тұрыңыз... күтіңіз, бұл мүмкін емес.
Dialogue: 0,0:01:12.82,0:01:13.86,Default,,0,0,0,,Не?
Dialogue: 0,0:01:13.94,0:01:16.57,Default,,0,0,0,,Сәлем Чен!
Dialogue: 0,0:01:18.99,0:01:24.00,Default,,0,0,0,,♪～
Dialogue: 0,0:02:43.95,0:02:48.96,Default,,0,0,0,,～♪
Dialogue: 0,0:03:01.43,0:03:04.10,Default,,0,0,0,,Бұл Бар Минамиден келген Киоко Каваками.
Dialogue: 0,0:03:05.06,0:03:07.73,Default,,0,0,0,,Бұл К бардан келген Келвин Чен.
Dialogue: 0,0:03:07.81,0:03:10.48,Default,,0,0,0,,Эй, Кузухара мырзаның орны.
Dialogue: 0,0:03:10.56,0:03:12.56,Default,,0,0,0,,Мен Тозақтың қолындағы Кинджомын...
Dialogue: 0,0:03:12.65,0:03:15.98,Default,,0,0,0,,Чен мырза, Жапония бұрыннан бар ма?
Dialogue: 0,0:03:16.53,0:03:17.36,Default,,0,0,0,,Жоқ
Dialogue: 0,0:03:17.44,0:03:20.86,Default,,0,0,0,,Бірақ сіз жапон тілін өте жақсы білесіз, солай емес пе?
Dialogue: 0,0:03:21.49,0:03:22.78,Default,,0,0,0,,Менің анам жапон
Dialogue: 0,0:03:22.87,0:03:26.24,Default,,0,0,0,,Эй, Yamazaki спирт зауытына бірінші рет келіп тұрсың ба?
Dialogue: 0,0:03:26.91,0:03:27.75,Default,,0,0,0,,Иә
Dialogue: 0,0:03:27.83,0:03:30.58,Default,,0,0,0,,Өйткені, жапон вискиінің киелі жері
Dialogue: 0,0:03:30.66,0:03:31.87,Default,,0,0,0,,Оны көргіңіз келе ме?
Dialogue: 0,0:03:31.96,0:03:34.38,Default,,0,0,0,,Өйткені маған Кузухара мырза айтты
Dialogue: 0,0:03:34.46,0:03:36.63,Default,,0,0,0,,Уау, бұл қиын.
Dialogue: 0,0:03:36.71,0:03:38.38,Default,,0,0,0,,Бұл сіздің Киотоға бірінші рет келуіңіз бе?
Dialogue: 0,0:03:39.42,0:03:40.51,Default,,0,0,0,,Тек бір рет
Dialogue: 0,0:03:40.59,0:03:42.51,Default,,0,0,0,,Эй, сен саяхаттап жүрсің бе?
Dialogue: 0,0:03:44.60,0:03:46.68,Default,,0,0,0,,Әй, бұл кім?
Dialogue: 0,0:03:46.76,0:03:47.85,Default,,0,0,0,,Не, не?
Dialogue: 0,0:03:47.93,0:03:50.39,Default,,0,0,0,,Бұл мені болашақ туралы ойлауға мәжбүр етеді.
Dialogue: 0,0:03:51.98,0:03:55.15,Default,,0,0,0,,Міне, келдік!
Dialogue: 0,0:03:55.23,0:03:56.86,Default,,0,0,0,,А, мен оны қазір көріп тұрмын.
Dialogue: 0,0:03:56.94,0:03:58.48,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:03:58.98,0:04:01.86,Default,,0,0,0,,Тіпті 1923 ж
Dialogue: 0,0:04:01.95,0:04:03.91,Default,,0,0,0,,100 жыл бұрын?
Dialogue: 0,0:04:03.99,0:04:05.53,Default,,0,0,0,,Ямазаки спирт зауыты
Dialogue: 0,0:04:05.62,0:04:09.29,Default,,0,0,0,,Бұл Жапониядағы ең көне уыт виски зауыты.
Dialogue: 0,0:04:09.37,0:04:10.70,Default,,0,0,0,,Wow~ (ысырма дыбысы)
Dialogue: 0,0:04:10.79,0:04:13.79,Default,,0,0,0,,Неліктен бұл жерде салынған деп ойлайсыңдар?
Dialogue: 0,0:04:13.87,0:04:16.04,Default,,0,0,0,,Неге...
Dialogue: 0,0:04:16.13,0:04:17.21,Default,,0,0,0,,Станция жанында?
Dialogue: 0,0:04:17.29,0:04:18.88,Default,,0,0,0,,Жалға алу?
Dialogue: 0,0:04:18.96,0:04:20.05,Default,,0,0,0,,Бұл өзен
Dialogue: 0,0:04:20.13,0:04:24.30,Default,,0,0,0,,Уджи өзені Кизугава Катсурагава
Dialogue: 0,0:04:24.39,0:04:28.68,Default,,0,0,0,,Үш өзен тоғысқан бұл жер қалың тұманға бейім.
Dialogue: 0,0:04:29.39,0:04:31.52,Default,,0,0,0,,Жылы және ылғалды климат
Dialogue: 0,0:04:31.60,0:04:35.19,Default,,0,0,0,,Вискидің қартаюына жақсы жағдай деп айтылады.
Dialogue: 0,0:04:35.27,0:04:36.81,Default,,0,0,0,,Бұл егжей-тегжейлі.
Dialogue: 0,0:04:36.90,0:04:39.69,Default,,0,0,0,,Өте жақсы, сен көп оқыдың.
Dialogue: 0,0:04:39.78,0:04:43.45,Default,,0,0,0,,Бар К-ның атына кір келтіргім келмейді.
Dialogue: 0,0:04:43.53,0:04:45.61,Default,,0,0,0,,Сонда мен...
Dialogue: 0,0:04:45.70,0:04:48.20,Default,,0,0,0,,Бардың оңтүстігіндегі лас жер.
Dialogue: 0,0:04:48.28,0:04:49.87,Default,,0,0,0,,Не, сен де?
Dialogue: 0,0:04:49.95,0:04:53.21,Default,,0,0,0,,Ал, мен үйренейін деп жатырмын.
Dialogue: 0,0:04:53.29,0:04:54.67,Default,,0,0,0,,Олай болса
Dialogue: 0,0:04:54.75,0:04:57.21,Default,,0,0,0,,Біз саяхатты бастаймыз.
Dialogue: 0,0:04:57.29,0:05:00.71,Default,,0,0,0,,Арпа – уыт вискиінің шикізаты.
Dialogue: 0,0:05:01.80,0:05:04.22,Default,,0,0,0,,Арпа мен судан сусло жасаңыз
Dialogue: 0,0:05:05.30,0:05:07.72,Default,,0,0,0,,Ашытқы қосып, ашытыңыз
Dialogue: 0,0:05:11.35,0:05:14.10,Default,,0,0,0,,Дайын езбе дистилденеді.
Dialogue: 0,0:05:14.18,0:05:16.10,Default,,0,0,0,,Ньюпот
Dialogue: 0,0:05:16.19,0:05:19.02,Default,,0,0,0,,Виски болса да анық па?
Dialogue: 0,0:05:19.11,0:05:21.86,Default,,0,0,0,,Қартайған кезде ол сары түске айналады.
Dialogue: 0,0:05:23.94,0:05:26.36,Default,,0,0,0,,Хаааах! Гүх!
Dialogue: 0,0:05:27.20,0:05:30.53,Default,,0,0,0,,Виски 5 жылдан кейін 10 жыл
Dialogue: 0,0:05:30.62,0:05:33.25,Default,,0,0,0,,Жасаған талғамың бағаланатын дүние
Dialogue: 0,0:05:33.87,0:05:37.67,Default,,0,0,0,,Болашақ ішетіндерге ешқандай түсініктеме немесе ақтауға болмайды.
Dialogue: 0,0:05:38.25,0:05:43.51,Default,,0,0,0,,Сондықтан жасаушылар да өз туындыларына бар мақтанышы мен жанын салады.
Dialogue: 0,0:05:43.59,0:05:48.01,Default,,0,0,0,,О, мына 1924 жылғы бөшкеге қараңызшы.
Dialogue: 0,0:05:48.09,0:05:49.39,Default,,0,0,0,,Я~
Dialogue: 0,0:05:49.47,0:05:51.39,Default,,0,0,0,,100 жаста
Dialogue: 0,0:05:51.47,0:05:53.77,Default,,0,0,0,,Қызық, дәмі қандай болады?
Dialogue: 0,0:05:53.85,0:05:57.39,Default,,0,0,0,,Мазмұны әлдеқашан буланып кеткен деп ойлаймын.
Dialogue: 0,0:05:57.48,0:06:00.40,Default,,0,0,0,,Айтпасаң да білесің
Dialogue: 0,0:06:00.48,0:06:02.86,Default,,0,0,0,,Әй, анау бөшке, жасымыз бір.
Dialogue: 0,0:06:02.94,0:06:05.53,Default,,0,0,0,,Иә? Менің де туған жылым ба?
Dialogue: 0,0:06:05.61,0:06:07.65,Default,,0,0,0,,А, мен де көріп тұрмын.
Dialogue: 0,0:06:25.17,0:06:26.55,Default,,0,0,0,,Осылай былай деді:
Dialogue: 0,0:06:27.22,0:06:30.55,Default,,0,0,0,,Біз араластырылмаған саке дәмін тату семинарын аяқтаймыз.
Dialogue: 0,0:06:30.64,0:06:32.51,Default,,0,0,0,,Қалыпты бағдарламада
Dialogue: 0,0:06:32.60,0:06:36.31,Default,,0,0,0,,Соңында, біз өз тұтынушыларымыз үшін жоғары баллдар жасаймыз.
Dialogue: 0,0:06:36.39,0:06:39.27,Default,,0,0,0,,Барлық кәсіби мамандарға
Dialogue: 0,0:06:39.35,0:06:43.36,Default,,0,0,0,,Дәмді жасау жолын айтып берсеңіз, риза болар едім.
Dialogue: 0,0:06:43.44,0:06:44.82,Default,,0,0,0,,Бұл не деген сөз өзі?
Dialogue: 0,0:06:45.61,0:06:47.86,Default,,0,0,0,,Чен мырза, сізден бір жақсылық сұрасам болады ма?
Dialogue: 0,0:06:47.95,0:06:50.24,Default,,0,0,0,,А... Түсіндім.
Dialogue: 0,0:07:16.14,0:07:17.72,Default,,0,0,0,,Хайбол
Dialogue: 0,0:07:17.81,0:07:20.48,Default,,0,0,0,,Бұл биік доп...
Dialogue: 0,0:07:20.56,0:07:24.61,Default,,0,0,0,,Сіз маған бірдеңе үйретуімді өтіндіңіз, бірақ сізде қандай да бір түсінік немесе қулық бар болуы керек!
Dialogue: 0,0:07:24.69,0:07:26.48,Default,,0,0,0,,Рахмет
Dialogue: 0,0:07:26.57,0:07:28.49,Default,,0,0,0,,Жолбасшы, сіз қиындыққа тап болдыңыз!
Dialogue: 0,0:07:28.57,0:07:30.86,Default,,0,0,0,,Жоқ, бұл пайдалы болды.
Dialogue: 0,0:07:30.95,0:07:34.16,Default,,0,0,0,,Ендеше, соңғы рет Жаңа кастрюльге барайық.
Dialogue: 0,0:07:34.24,0:07:35.99,Default,,0,0,0,,Не, ішсем болады ма?
Dialogue: 0,0:07:36.08,0:07:37.58,Default,,0,0,0,,Күте тұрыңыз... Мына төбеге ше?
Dialogue: 0,0:07:37.66,0:07:40.08,Default,,0,0,0,,Ішпесе болмайды ғой?
Dialogue: 0,0:07:43.33,0:07:44.63,Default,,0,0,0,,Уау...
Dialogue: 0,0:07:44.71,0:07:46.50,Default,,0,0,0,,Арпа шочу сияқты
Dialogue: 0,0:07:46.59,0:07:48.84,Default,,0,0,0,,Мынаның дәмі осылай бола ма?
Dialogue: 0,0:07:48.92,0:07:51.13,Default,,0,0,0,,Мен оны мүлде елестете алмаймын.
Dialogue: 0,0:07:51.22,0:07:52.59,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:07:52.68,0:07:55.76,Default,,0,0,0,,Қартаю маңызды, солай емес пе?
Dialogue: 0,0:07:55.85,0:07:57.89,Default,,0,0,0,,Чен мырза, сіз ішпейсіз бе?
Dialogue: 0,0:07:57.97,0:08:00.35,Default,,0,0,0,,Менде бәрі жақсы.
Dialogue: 0,0:08:00.43,0:08:03.40,Default,,0,0,0,,Біз мұны өз тұтынушыларымызға бермейміз.
Dialogue: 0,0:08:03.48,0:08:06.23,Default,,0,0,0,,Сондықтан өңделмеген саке де ішпедім.
Dialogue: 0,0:08:06.32,0:08:09.90,Default,,0,0,0,,Кузухара мырза менің ойымды сұраса, қиын болмай ма?
Dialogue: 0,0:08:15.45,0:08:16.87,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:08:16.95,0:08:18.49,Default,,0,0,0,,өрескел
Dialogue: 0,0:08:18.58,0:08:22.92,Default,,0,0,0,,Егер сіз оны тұтынушыларға ұсынбасаңыз да, оны білу жақсы.
Dialogue: 0,0:08:23.00,0:08:24.63,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:24.71,0:08:27.17,Default,,0,0,0,,Мен мұны әлі де мағынасыз деп ойлаймын.
Dialogue: 0,0:08:27.25,0:08:30.67,Default,,0,0,0,,Мағынасыз...?
Dialogue: 0,0:08:30.76,0:08:32.93,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:08:33.01,0:08:36.43,Default,,0,0,0,,Түсіндім, мен Коктейль марапаттарына барамын.
Dialogue: 0,0:08:36.51,0:08:40.18,Default,,0,0,0,,Осыдан кейін Киоко дүкенге өзі келді.
Dialogue: 0,0:08:40.27,0:08:43.98,Default,,0,0,0,,Мен де конкурсқа қатысатынымды жариялау үшін барын салдым.
Dialogue: 0,0:08:44.06,0:08:45.15,Default,,0,0,0,,Сонымен
Dialogue: 0,0:08:45.23,0:08:49.19,Default,,0,0,0,,Осыдан кейін мен әртүрлі дүкендерге барып, біраз зерттеуді жөн көрдім.
Dialogue: 0,0:08:49.27,0:08:52.07,Default,,0,0,0,,Ей, бұл жақсы идея.
Dialogue: 0,0:08:52.90,0:08:54.15,Default,,0,0,0,,Сіз не айтасыз, Чен мырза?
Dialogue: 0,0:08:54.24,0:08:57.45,Default,,0,0,0,,Менің бір ісім бар, сондықтан мен бүгін басқа іспен айналысқым келеді.
Dialogue: 0,0:08:57.53,0:08:59.91,Default,,0,0,0,,Эй, сен кімсің, Чен?
Dialogue: 0,0:08:59.99,0:09:03.16,Default,,0,0,0,,Ол доссыз және икемсіз.
Dialogue: 0,0:09:03.25,0:09:07.71,Default,,0,0,0,,Шебер Мэрфект мырза болса, шәкірті Робот мырза ма?
Dialogue: 0,0:09:07.79,0:09:09.50,Default,,0,0,0,,Ол әдемі болса да
Dialogue: 0,0:09:10.00,0:09:13.72,Default,,0,0,0,,Дүкеніңізде тұтынушыларға осылай қызмет көрсетесіз бе?
Dialogue: 0,0:09:13.80,0:09:17.18,Default,,0,0,0,,Осы жылдамдықпен тұтынушы үйіне кетеді.
Dialogue: 0,0:09:17.26,0:09:18.26,Default,,0,0,0,,Иә...
Dialogue: 0,0:09:18.35,0:09:22.06,Default,,0,0,0,,Мен ойладым, неге әртүрлі бармендерді кездестірмейсіз?
Dialogue: 0,0:09:22.14,0:09:24.48,Default,,0,0,0,,Мен сені жаттығуға шығарып салдым.
Dialogue: 0,0:09:24.56,0:09:29.56,Default,,0,0,0,,Чен бұл сапарда бірдеңе сезінді деп үміттенемін.
Dialogue: 0,0:09:40.53,0:09:42.74,Default,,0,0,0,,Аа, егер бұл Такея-сан болса.
Dialogue: 0,0:09:42.83,0:09:45.83,Default,,0,0,0,,Сіз жұмысты баяғыда тастадыңыз, солай ма?
Dialogue: 0,0:09:45.91,0:09:47.58,Default,,0,0,0,,Оны біреу сатып алды
Dialogue: 0,0:09:47.67,0:09:50.75,Default,,0,0,0,,Олар ғимаратты ұстап тұрған сияқты.
Dialogue: 0,0:09:57.63,0:09:59.51,Default,,0,0,0,,Баратыныңызға сенімдісіз бе?
Dialogue: 0,0:10:03.68,0:10:05.10,Default,,0,0,0,,Хитоза…
Dialogue: 0,0:10:08.69,0:10:10.69,Default,,0,0,0,,(Тамның есінеу)
Dialogue: 0,0:10:10.77,0:10:11.69,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:11.77,0:10:13.44,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:10:13.53,0:10:16.70,Default,,0,0,0,,Хмм, мен кеше кешігіп қалдым.
Dialogue: 0,0:10:16.78,0:10:19.66,Default,,0,0,0,,Қонақ үйге сағат нешеде оралдыңыз?
Dialogue: 0,0:10:19.74,0:10:21.20,Default,,0,0,0,,Ал...
Dialogue: 0,0:10:21.28,0:10:23.70,Default,,0,0,0,,Бұл K6 ма?
Dialogue: 0,0:10:23.79,0:10:25.70,Default,,0,0,0,,Кальвадордан…
Dialogue: 0,0:10:25.79,0:10:27.71,Default,,0,0,0,,Джион Самбоа
Dialogue: 0,0:10:27.79,0:10:29.71,Default,,0,0,0,,Киямачи самбоа
Dialogue: 0,0:10:29.79,0:10:31.96,Default,,0,0,0,,Эль Тесоро
Dialogue: 0,0:10:32.04,0:10:33.96,Default,,0,0,0,,Талискерге...
Dialogue: 0,0:10:34.05,0:10:35.96,Default,,0,0,0,,Финляндия
Dialogue: 0,0:10:36.05,0:10:38.47,Default,,0,0,0,,Тербелетін орындық
Dialogue: 0,0:10:38.55,0:10:41.05,Default,,0,0,0,,Қызық, сағат неше болды?
Dialogue: 0,0:10:41.14,0:10:42.68,Default,,0,0,0,,Хехехе
Dialogue: 0,0:10:42.76,0:10:45.43,Default,,0,0,0,,Чен мырза жақсы ұйықтады ма?
Dialogue: 0,0:10:46.10,0:10:47.23,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:48.31,0:10:50.98,Default,,0,0,0,,Кеттік, саған көрсететін бір нәрсем бар.
Dialogue: 0,0:10:54.11,0:10:56.74,Default,,0,0,0,,Маған көрсеткіңіз келетін нәрсе осы ма?
Dialogue: 0,0:10:56.82,0:10:57.65,Default,,0,0,0,,Иә
Dialogue: 0,0:10:57.74,0:11:00.99,Default,,0,0,0,,Бұл Манё жырында да жазылған атақты су ауылы.
Dialogue: 0,0:11:01.74,0:11:06.45,Default,,0,0,0,,Сен но Рикюге де бұл су ұнап, сол жерге шайхана орнатқан деседі.
Dialogue: 0,0:11:07.08,0:11:10.71,Default,,0,0,0,,Спирт зауыты да осы аймақтың суын пайдаланады.
Dialogue: 0,0:11:11.21,0:11:14.00,Default,,0,0,0,,Су – вискидің қаны.
Dialogue: 0,0:11:15.05,0:11:17.01,Default,,0,0,0,,Басы – тамшы
Dialogue: 0,0:11:17.71,0:11:20.59,Default,,0,0,0,,Су тамшылары баяу тамшылайды
Dialogue: 0,0:11:21.68,0:11:25.01,Default,,0,0,0,,Көп ұзамай бұлақ ағып, ағаштарды суарады.
Dialogue: 0,0:11:26.56,0:11:30.27,Default,,0,0,0,,Ондаған, жүздеген жылдар бойы өзенге айналады.
Dialogue: 0,0:11:31.56,0:11:34.02,Default,,0,0,0,,Көп өмірді тәрбиелеу
Dialogue: 0,0:11:35.52,0:11:37.40,Default,,0,0,0,,Бір стақан виски үшін
Dialogue: 0,0:11:37.48,0:11:40.95,Default,,0,0,0,,Онда ұзақ тарих туралы естеліктер бар.
Dialogue: 0,0:11:42.45,0:11:45.70,Default,,0,0,0,,Ештеңені білмей-ақ тұтынушыларға ішімдік берген дұрыс.
Dialogue: 0,0:11:45.78,0:11:49.29,Default,,0,0,0,,Оны шығармас бұрын оның ішіндегі сезімдерді білген дұрыс.
Dialogue: 0,0:11:49.37,0:11:53.42,Default,,0,0,0,,Сіз дәмді ғана емес, көбірек жеткізе аласыз деп ойламайсыз ба?
Dialogue: 0,0:11:53.50,0:11:54.79,Default,,0,0,0,,(Нитта) Джун, Мориока: Тайчи Канеда
Dialogue: 0,0:11:55.63,0:11:59.30,Default,,0,0,0,,Ата маған су әкелуімді өтінді.
Dialogue: 0,0:11:59.38,0:12:01.55,Default,,0,0,0,,Олай болса...
Dialogue: 0,0:12:01.63,0:12:02.80,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:03.55,0:12:04.55,Default,,0,0,0,,Иә
Dialogue: 0,0:12:04.64,0:12:05.97,Default,,0,0,0,,Тұмар
Dialogue: 0,0:12:06.05,0:12:10.14,Default,,0,0,0,,Минас ғибадатханасы дағдыларды жетілдіру үшін пайдалы деп саналады.
Dialogue: 0,0:12:10.64,0:12:12.56,Default,,0,0,0,,Тұмар…
Dialogue: 0,0:12:12.64,0:12:14.06,Default,,0,0,0,,Мм... (ұйымшыл) иә?
Dialogue: 0,0:12:14.98,0:12:17.57,Default,,0,0,0,,Бұл да бойтұмар ма?
Dialogue: 0,0:12:19.78,0:12:22.07,Default,,0,0,0,,«Талисман» деп жазылған.
Dialogue: 0,0:12:22.15,0:12:23.03,Default,,0,0,0,,Тұмар?
Dialogue: 0,0:12:23.11,0:12:25.57,Default,,0,0,0,,Иә, иә...
Dialogue: 0,0:12:26.16,0:12:28.41,Default,,0,0,0,,Хошо тауы...
Dialogue: 0,0:12:28.49,0:12:31.83,Default,,0,0,0,,Гион фестивалінің тауларының біріне ұқсайды
Dialogue: 0,0:12:31.91,0:12:33.33,Default,,0,0,0,,Гион фестивалі?
Dialogue: 0,0:12:33.42,0:12:37.59,Default,,0,0,0,,Сол бойтұмарды... Йоияма кезеңінде сатып алуға болады.
Dialogue: 0,0:12:37.67,0:12:40.30,Default,,0,0,0,,Бұл фестивальдермен шектелетінін білдіре ме?
Dialogue: 0,0:12:40.38,0:12:41.21,Default,,0,0,0,,Ха…
Dialogue: 0,0:12:41.30,0:12:45.05,Default,,0,0,0,,Махаббатты шындыққа айналдырған оқиғаның атымен аталған.
Dialogue: 0,0:12:45.14,0:12:46.51,Default,,0,0,0,,Я~
Dialogue: 0,0:12:46.60,0:12:48.64,Default,,0,0,0,,Иә? (Мива) Хмм...
Dialogue: 0,0:13:05.78,0:13:07.53,Default,,0,0,0,,Бұл 12 жыл бұрын болған.
Dialogue: 0,0:13:07.62,0:13:12.50,Default,,0,0,0,,(Мерекелік музыка)
Dialogue: 0,0:13:16.33,0:13:18.17,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:18.84,0:13:20.63,Default,,0,0,0,,Дәл қазір, барлық жерде.
Dialogue: 0,0:13:20.71,0:13:23.26,Default,,0,0,0,,Тауларды жинайтын кез келді.
Dialogue: 0,0:13:23.34,0:13:26.26,Default,,0,0,0,,Сіз Джион фестиваліне келушісіз бе?
Dialogue: 0,0:13:26.34,0:13:27.18,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:27.26,0:13:28.47,Default,,0,0,0,,Кельвин
Dialogue: 0,0:13:29.10,0:13:31.72,Default,,0,0,0,,Мен мұнда көрікті жерлерді көру үшін келген жоқпын.
Dialogue: 0,0:13:31.81,0:13:34.14,Default,,0,0,0,,Менмендік көрсетпе
Dialogue: 0,0:13:34.77,0:13:36.94,Default,,0,0,0,,Менің мұрагерім ретінде
Dialogue: 0,0:13:40.73,0:13:42.90,Default,,0,0,0,,Окошиясуға қош келдіңіз
Dialogue: 0,0:13:42.98,0:13:44.61,Default,,0,0,0,,Көмегің үшін рахмет
Dialogue: 0,0:13:44.69,0:13:46.78,Default,,0,0,0,,Сіз жол бойы шаршаған болуыңыз керек.
Dialogue: 0,0:13:47.41,0:13:50.12,Default,,0,0,0,,Мен саған бірден бөлмеңді көрсетемін.
Dialogue: 0,0:13:50.20,0:13:52.29,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:13:52.95,0:13:54.50,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:13:54.58,0:13:57.00,Default,,0,0,0,,Окошиясуға қош келдіңіз
Dialogue: 0,0:13:57.08,0:13:59.92,Default,,0,0,0,,Қош келдіңіз бе?
Dialogue: 0,0:14:00.00,0:14:01.80,Default,,0,0,0,,Жапон тілі жақсы.
Dialogue: 0,0:14:01.88,0:14:04.05,Default,,0,0,0,,«Біз "екінші Кира" бағыты бойынша тергеу жүргізіп жатырмыз» және олардың ынтымақтастығын сұраймыз.
Dialogue: 0,0:14:04.13,0:14:07.55,Default,,0,0,0,,Кешіріңіз, жалғастырыңыз.
Dialogue: 0,0:14:11.97,0:14:12.81,Default,,0,0,0,,Ах
Dialogue: 0,0:14:12.89,0:14:15.52,Default,,0,0,0,,Аяқ киімді киіңіз.
Dialogue: 0,0:14:15.60,0:14:16.81,Default,,0,0,0,,Жарайды
Dialogue: 0,0:14:16.89,0:14:19.31,Default,,0,0,0,,Мен жүктерімді дереу қалдырамын.
Dialogue: 0,0:14:19.40,0:14:21.36,Default,,0,0,0,,Кешіктірмеңіз
Dialogue: 0,0:14:21.44,0:14:22.65,Default,,0,0,0,,Иә
Dialogue: 0,0:14:24.73,0:14:27.32,Default,,0,0,0,,Тамақты дайындаймыз.
Dialogue: 0,0:14:34.74,0:14:35.58,Default,,0,0,0,,Бұл жасырын операциялар үшін мінсіз қабілет.
Dialogue: 0,0:14:35.66,0:14:39.58,Default,,0,0,0,,Сіздің ұлыңыз солақай екенін түсіндім.
Dialogue: 0,0:14:39.67,0:14:40.54,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:40.63,0:14:43.84,Default,,0,0,0,,Мен аяқ киімімді жинап жатқанда
Dialogue: 0,0:14:43.92,0:14:46.30,Default,,0,0,0,,Бұл менің қызым Хитосе.
Dialogue: 0,0:14:46.38,0:14:48.97,Default,,0,0,0,,Бұл бәрібір мұрагер.
Dialogue: 0,0:14:49.05,0:14:50.34,Default,,0,0,0,,Солай болды ма?
Dialogue: 0,0:14:50.43,0:14:54.97,Default,,0,0,0,,Мен де Сингапурдағы қонақүй бизнесін ұлыма тапсыруды ойлап жүрмін.
Dialogue: 0,0:14:55.06,0:14:57.14,Default,,0,0,0,,Ал, монах та.
Dialogue: 0,0:14:57.23,0:14:58.44,Default,,0,0,0,,Ол Кельвин деп аталады.
Dialogue: 0,0:14:58.52,0:15:00.52,Default,,0,0,0,,Сіз өте күштісіз.
Dialogue: 0,0:15:00.60,0:15:01.86,Default,,0,0,0,,Хмм... (Хитоз) А...
Dialogue: 0,0:15:02.65,0:15:03.86,Default,,0,0,0,,Хехе
Dialogue: 0,0:15:07.69,0:15:12.12,Default,,0,0,0,,♪～
Dialogue: 0,0:16:13.76,0:16:17.93,Default,,0,0,0,,～♪
Dialogue: 0,0:16:22.64,0:16:23.94,Default,,0,0,0,,Тоқта!
Dialogue: 0,0:16:24.02,0:16:27.40,Default,,0,0,0,,Мұрагерді анаң өзі шешеді.
Dialogue: 0,0:16:27.48,0:16:28.90,Default,,0,0,0,,Хитоза!
Dialogue: 0,0:16:35.16,0:16:38.16,Default,,0,0,0,,Му~ Мен қатты ашуландым.
Dialogue: 0,0:16:38.24,0:16:41.00,Default,,0,0,0,,Мен өз өмірімді өзім шешем
Dialogue: 0,0:16:42.41,0:16:43.71,Default,,0,0,0,,Хитоза-сан
Dialogue: 0,0:16:43.79,0:16:45.54,Default,,0,0,0,,Хитоза жақсы.
Dialogue: 0,0:16:46.08,0:16:49.00,Default,,0,0,0,,Хитоза биші болғысы келеді ме?
Dialogue: 0,0:16:49.09,0:16:51.21,Default,,0,0,0,,Е, сен қайдан білесің?
Dialogue: 0,0:16:51.30,0:16:53.13,Default,,0,0,0,,Мен сенің жаттығу жасап жатқаныңды көрдім.
Dialogue: 0,0:16:53.22,0:16:56.64,Default,,0,0,0,,Өтірік! Жоқ, қазір ұят
Dialogue: 0,0:16:56.72,0:16:59.89,Default,,0,0,0,,Бұл жай ғана арман.
Dialogue: 0,0:16:59.97,0:17:03.35,Default,,0,0,0,,Жақсы, сізде қол жеткізгіңіз келетін мақсат бар.
Dialogue: 0,0:17:04.52,0:17:06.10,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:17:06.19,0:17:10.07,Default,,0,0,0,,Жалғыз баламын, жалғызбын.
Dialogue: 0,0:17:10.86,0:17:14.11,Default,,0,0,0,,Мұрагер болмаса, анам мұңаяды.
Dialogue: 0,0:17:15.49,0:17:18.12,Default,,0,0,0,,Соңында ата-анаңның тілін аласың ба?
Dialogue: 0,0:17:18.20,0:17:22.37,Default,,0,0,0,,Чен, сен күнде әкеңнің айтқанын істейсің бе?
Dialogue: 0,0:17:23.46,0:17:26.58,Default,,0,0,0,,Мен сенің айтқаныңды істей бергім келмейді.
Dialogue: 0,0:17:27.08,0:17:31.50,Default,,0,0,0,,Ата-анам салған рельстерді бұзамын.
Dialogue: 0,0:17:32.51,0:17:34.17,Default,,0,0,0,,Олай болса, мен оны жоюға тырысуым керек пе?
Dialogue: 0,0:17:34.26,0:17:35.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:35.34,0:17:40.01,Default,,0,0,0,,Дәл қазір жеп отырған балмұздақ жеңсе ше?
Dialogue: 0,0:17:40.10,0:17:43.77,Default,,0,0,0,,Ченге бойкот жариялау ертеңге жоспарланған кесте.
Dialogue: 0,0:17:45.77,0:17:48.69,Default,,0,0,0,,Сосын, егер сен де соққы алсаң.
Dialogue: 0,0:17:48.77,0:17:51.32,Default,,0,0,0,,Қонақ үйге бойкот жариялау
Dialogue: 0,0:17:51.86,0:17:53.69,Default,,0,0,0,,Белгісіз
Dialogue: 0,0:17:53.78,0:17:56.32,Default,,0,0,0,,Екі ойыншы да жеңсе
Dialogue: 0,0:17:57.86,0:18:01.37,Default,,0,0,0,,Фестивальді көруге барамыз ба? Джион фестивалі
Dialogue: 0,0:18:03.75,0:18:05.16,Default,,0,0,0,,Жарайды, бірақ
Dialogue: 0,0:18:05.87,0:18:07.12,Default,,0,0,0,,Иә!
Dialogue: 0,0:18:07.21,0:18:08.04,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:08.12,0:18:09.79,Default,,0,0,0,,Уау, бұл хит.
Dialogue: 0,0:18:09.88,0:18:12.34,Default,,0,0,0,,Екеуің өтірік айтасыңдар, солай ма?
Dialogue: 0,0:18:12.42,0:18:14.71,Default,,0,0,0,,Шынымен...
Dialogue: 0,0:18:14.80,0:18:16.30,Default,,0,0,0,,(Изуку) Ка… Качан! Бұл емтиханда мұғалім жаман кейіпкер рөлін сомдап отыр,
Dialogue: 0,0:18:18.01,0:18:19.80,Default,,0,0,0,,Баратыныңызға сенімдісіз бе?
Dialogue: 0,0:18:21.47,0:18:23.18,Default,,0,0,0,,Иә, кеттік.
Dialogue: 0,0:18:23.26,0:18:25.48,Default,,0,0,0,,Ия, мен оны асыға күтемін.
Dialogue: 0,0:18:25.56,0:18:26.77,Default,,0,0,0,,Иә
Dialogue: 0,0:18:36.86,0:18:38.20,Default,,0,0,0,,Бірақ…
Dialogue: 0,0:18:38.99,0:18:41.20,Default,,0,0,0,,Ақырында мен бармадым.
Dialogue: 0,0:18:41.99,0:18:44.91,Default,,0,0,0,,Мен әкемнің тілін алмас едім.
Dialogue: 0,0:18:45.54,0:18:48.71,Default,,0,0,0,,Бірақ мен оны көптен бері қызықтырдым.
Dialogue: 0,0:18:48.79,0:18:52.34,Default,,0,0,0,,Ол Джион фестиваліне барды ма?
Dialogue: 0,0:18:52.42,0:18:53.96,Default,,0,0,0,,Бармадың ба?
Dialogue: 0,0:18:58.05,0:19:03.22,Default,,0,0,0,,Фестивальге бардым десем, Чен мырзаға ауыр тиеді.
Dialogue: 0,0:19:03.30,0:19:07.81,Default,,0,0,0,,Сезімін сол тұмарға сеніп тапсырған шығар.
Dialogue: 0,0:19:11.98,0:19:15.82,Default,,0,0,0,,Мен Хитозаның қазір не істеп жатқанын білмеймін.
Dialogue: 0,0:19:16.32,0:19:20.15,Default,,0,0,0,,Ол тұрған қонақ үй жұмыс істемейді.
Dialogue: 0,0:19:20.82,0:19:23.37,Default,,0,0,0,,Мен енді кешірім сұрай алмаймын
Dialogue: 0,0:19:24.16,0:19:26.54,Default,,0,0,0,,Оған берген уәдеңді бұзу
Dialogue: 0,0:19:27.41,0:19:29.33,Default,,0,0,0,,Хитозаны зақымдау
Dialogue: 0,0:19:30.54,0:19:32.63,Default,,0,0,0,,Мен ең нашар адаммын
Dialogue: 0,0:19:36.67,0:19:37.88,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:19:39.38,0:19:41.43,Default,,0,0,0,,Ямадзакидің 12 жасы
Dialogue: 0,0:19:41.93,0:19:43.14,Default,,0,0,0,,Онда...
Dialogue: 0,0:19:43.22,0:19:45.22,Default,,0,0,0,,Су қосыңыз
Dialogue: 0,0:19:51.02,0:19:52.15,Default,,0,0,0,,Оны ішіп көріңіз
Dialogue: 0,0:20:06.58,0:20:11.54,Default,,0,0,0,,Су қосса дәм ашылады.
Dialogue: 0,0:20:11.62,0:20:16.04,Default,,0,0,0,,Бұл 12 жылдың дәмі
Dialogue: 0,0:20:16.13,0:20:19.30,Default,,0,0,0,,Жаңа қазан да сондай жабайы еді.
Dialogue: 0,0:20:20.09,0:20:24.68,Default,,0,0,0,,12 жылдан кейін дәм осылай жетіледі.
Dialogue: 0,0:20:25.68,0:20:28.51,Default,,0,0,0,,Уақыт дәмі
Dialogue: 0,0:20:28.60,0:20:30.56,Default,,0,0,0,,Ченге де солай.
Dialogue: 0,0:20:31.27,0:20:37.86,Default,,0,0,0,,12 жыл бұрынғы өкінішті қарапайым адам ұстай алмайды.
Dialogue: 0,0:20:37.94,0:20:42.40,Default,,0,0,0,,Мен азапты естеліктер мен өкініштерге қарап тұратыныма сенімдімін
Dialogue: 0,0:20:42.99,0:20:46.45,Default,,0,0,0,,Оны жетілдіре алатындар ғана
Dialogue: 0,0:20:47.16,0:20:49.20,Default,,0,0,0,,Сіз ересек бола аласыз.
Dialogue: 0,0:20:56.46,0:20:59.67,Default,,0,0,0,,Кешіріңіз, Хитоза
Dialogue: 0,0:21:02.51,0:21:05.93,Default,,0,0,0,,Дүкенді кенеттен жалға алғаным үшін кешіріңіз.
Dialogue: 0,0:21:06.01,0:21:09.51,Default,,0,0,0,,Жоқ, төраға Курушимаға үлкен сәлем жолдаңыз.
Dialogue: 0,0:21:09.60,0:21:10.60,Default,,0,0,0,,Иә
Dialogue: 0,0:21:10.68,0:21:14.06,Default,,0,0,0,,Киоко мен Юри ғана қалды.
Dialogue: 0,0:21:14.14,0:21:15.60,Default,,0,0,0,,Ойланып қарашы, қайда бардың?
Dialogue: 0,0:21:15.60,0:21:16.60,Default,,0,0,0,,Ойланып қарашы, қайда бардың?
Dialogue: 0,0:21:15.60,0:21:16.60,Default,,0,0,0,,(Қоңырау үні)
Dialogue: 0,0:21:16.69,0:21:18.36,Default,,0,0,0,,Ах~
Dialogue: 0,0:21:18.44,0:21:20.11,Default,,0,0,0,,Дәмді
Dialogue: 0,0:21:20.19,0:21:22.99,Default,,0,0,0,,Дәмі жақсы Сыртқы түрі жақсы Шағымдары жоқ
Dialogue: 0,0:21:23.07,0:21:24.03,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:21:24.03,0:21:26.32,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:21:24.03,0:21:26.32,Default,,0,0,0,,Ол шықпайды...
Dialogue: 0,0:21:28.99,0:21:31.91,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:21:32.00,0:21:35.42,Default,,0,0,0,,Барменнің қызметі қандай?
Dialogue: 0,0:21:35.50,0:21:38.29,Default,,0,0,0,,Мен оны бірінші рет түсінгендей болдым.
Dialogue: 0,0:21:38.38,0:21:42.05,Default,,0,0,0,,Ішіп алдың, Жаңа қазан.
Dialogue: 0,0:21:42.92,0:21:44.13,Default,,0,0,0,,Иә
Dialogue: 0,0:21:49.10,0:21:52.14,Default,,0,0,0,,Мен Ченмін. Мен қазір дүкенге барамын.
Dialogue: 0,0:21:54.39,0:21:56.06,Default,,0,0,0,,Ах~
Dialogue: 0,0:21:56.14,0:21:57.77,Default,,0,0,0,,Дәмді
Dialogue: 0,0:21:57.85,0:22:00.57,Default,,0,0,0,,Дәмі жақсы Сыртқы түрі жақсы Шағымдары жоқ
Dialogue: 0,0:22:00.65,0:22:01.44,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:22:01.44,0:22:02.65,Default,,0,0,0,,Жарайды, жарайды.
Dialogue: 0,0:22:01.44,0:22:02.65,Default,,0,0,0,,Тұтынушы Сіз бүгін осында тұрасыз ба?
Dialogue: 0,0:22:02.65,0:22:04.40,Default,,0,0,0,,Тұтынушы Сіз бүгін осында тұрасыз ба?
Dialogue: 0,0:22:04.49,0:22:06.20,Default,,0,0,0,,Жоқ, мен үйге бара жатырмын.
Dialogue: 0,0:22:06.28,0:22:08.45,Default,,0,0,0,,Шинкансен туралы...
Dialogue: 0,0:22:08.53,0:22:09.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:10.03,0:22:12.12,Default,,0,0,0,,Қазір сағат неше?
Dialogue: 0,0:22:12.20,0:22:14.25,Default,,0,0,0,,Енді пойыздар жоқ...
Dialogue: 0,0:22:15.04,0:22:20.04,Default,,0,0,0,,♪～
Dialogue: 0,0:23:39.96,0:23:44.96,Default,,0,0,0,,～♪
