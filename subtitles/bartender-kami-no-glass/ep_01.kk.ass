Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:04.04,0:00:05.38,Default,,0,0,0,,Дүниеде
Dialogue: 0,0:00:05.46,0:00:08.88,Default,,0,0,0,,Біз тұтынушыларымызды ешқашан ренжітпеуіміз керек жұмыс бар.
Dialogue: 0,0:00:08.96,0:00:10.59,Default,,0,0,0,,Екі бар
Dialogue: 0,0:00:13.01,0:00:15.93,Default,,0,0,0,,Біреуі дәрігер фармацевт
Dialogue: 0,0:00:17.47,0:00:19.22,Default,,0,0,0,,Басқа нәрсе ...
Dialogue: 0,0:00:25.02,0:00:29.98,Default,,0,0,0,,♪～
Dialogue: 0,0:01:49.94,0:01:54.94,Default,,0,0,0,,～♪
Dialogue: 0,0:02:03.95,0:02:06.58,Default,,0,0,0,,Бүгін Кардинал қонақ үйі
Dialogue: 0,0:02:06.66,0:02:09.42,Default,,0,0,0,,Барменді жұмысқа қабылдау емтиханына қатысыңыз.
Dialogue: 0,0:02:09.50,0:02:10.50,Default,,0,0,0,,Рахмет
Dialogue: 0,0:02:11.88,0:02:16.01,Default,,0,0,0,,Менің атым Курушима, сатуды жоспарлау бөлімінен.
Dialogue: 0,0:02:16.63,0:02:19.51,Default,,0,0,0,,Қонақ үй ашылғаннан кейін екі айдан кейін
Dialogue: 0,0:02:19.59,0:02:22.76,Default,,0,0,0,,Біз тек осы лаунж-барда емеспіз.
Dialogue: 0,0:02:22.85,0:02:26.73,Default,,0,0,0,,Мен шынайы есептегіш жолақ жасағым келеді.
Dialogue: 0,0:02:26.81,0:02:28.44,Default,,0,0,0,,Ойлау
Dialogue: 0,0:02:29.65,0:02:31.61,Default,,0,0,0,,Емтихан тапсырғандар үшін
Dialogue: 0,0:02:31.69,0:02:35.53,Default,,0,0,0,,Мен сені сол барға бармен ретінде алғым келеді.
Dialogue: 0,0:02:36.15,0:02:39.20,Default,,0,0,0,,Енді, бұдан былай, сатуды жоспарлау менеджері
Dialogue: 0,0:02:39.28,0:02:41.49,Default,,0,0,0,,Камишима шолуды жүргізеді
Dialogue: 0,0:02:41.57,0:02:45.66,Default,,0,0,0,,Бірден әр адам өз коктейльін дайындасын.
Dialogue: 0,0:02:46.37,0:02:47.20,Default,,0,0,0,,'Ол да сондай.'
Dialogue: 0,0:02:47.29,0:02:48.66,Default,,0,0,0,,Иә
Dialogue: 0,0:02:48.75,0:02:51.08,Default,,0,0,0,,Менде мартини бар
Dialogue: 0,0:02:53.13,0:02:54.67,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:02:56.71,0:02:57.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:57.97,0:03:01.68,Default,,0,0,0,,Менің тамағымды әлі бітірдіңіз бе?
Dialogue: 0,0:03:01.76,0:03:02.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:03.05,0:03:05.93,Default,,0,0,0,,Мен тамақ алдында ма, тамақтан кейін ме деп сұрап тұрмын.
Dialogue: 0,0:03:06.02,0:03:08.68,Default,,0,0,0,,Мен мұндайды естіген жоқпын...
Dialogue: 0,0:03:08.77,0:03:11.60,Default,,0,0,0,,Мартини - күшті коктейль
Dialogue: 0,0:03:11.69,0:03:14.90,Default,,0,0,0,,Ішім бос па деп сұрамай-ақ тамақты жиі жасай аламын.
Dialogue: 0,0:03:14.98,0:03:17.65,Default,,0,0,0,,Бірақ маған икемді коктейль жасау керектігін айтты...
Dialogue: 0,0:03:17.74,0:03:19.57,Default,,0,0,0,,Жақында кездескенше
Dialogue: 0,0:03:20.53,0:03:22.95,Default,,0,0,0,,Әрі қарай жеткілікті
Dialogue: 0,0:03:23.66,0:03:25.45,Default,,0,0,0,,Мен шегірткемін
Dialogue: 0,0:03:25.53,0:03:26.79,Default,,0,0,0,,Хмм…
Dialogue: 0,0:03:26.87,0:03:30.08,Default,,0,0,0,,Бұл жағдайда мен оны Poos Cafe стилінде жасауым керек пе?
Dialogue: 0,0:03:30.16,0:03:31.25,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:31.33,0:03:33.08,Default,,0,0,0,,Әрине, білесіз бе?
Dialogue: 0,0:03:33.17,0:03:34.96,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:03:35.04,0:03:39.17,Default,,0,0,0,,Меншікті салмағы әртүрлі материалдарды араластырып алмас үшін қабаттастыру әдісі...
Dialogue: 0,0:03:41.09,0:03:45.22,Default,,0,0,0,,Мм... Әрине, кәсіпқой қолынан келеді.
Dialogue: 0,0:03:45.30,0:03:47.47,Default,,0,0,0,,Ол араласып кетті.
Dialogue: 0,0:03:47.56,0:03:49.56,Default,,0,0,0,,Бұл тым көп уақытты алады.
Dialogue: 0,0:03:49.64,0:03:52.23,Default,,0,0,0,,Себебі мен кенеттен бұйрық алдым...
Dialogue: 0,0:03:52.31,0:03:54.81,Default,,0,0,0,,Тұтынушылар - қарапайым
Dialogue: 0,0:03:54.90,0:03:55.73,Default,,0,0,0,,Келесі
Dialogue: 0,0:03:58.69,0:04:00.32,Default,,0,0,0,,АҚШ
Dialogue: 0,0:04:01.03,0:04:01.86,Default,,0,0,0,,Курушима-кун…
Dialogue: 0,0:04:01.95,0:04:03.07,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,0:04:01.95,0:04:03.07,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:03.07,0:04:03.16,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:03.16,0:04:05.07,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:03.16,0:04:05.07,Default,,0,0,0,,Оны әкелдің бе?
Dialogue: 0,0:04:05.07,0:04:05.16,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:05.16,0:04:06.70,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:04:05.16,0:04:06.70,Default,,0,0,0,,Жоқ, Хигучи мырза...
Dialogue: 0,0:04:06.78,0:04:09.12,Default,,0,0,0,,Ол қазір ең танымал бармен.
Dialogue: 0,0:04:09.20,0:04:10.70,Default,,0,0,0,,... (Юкари) Кя хаха!
Dialogue: 0,0:04:10.79,0:04:13.58,Default,,0,0,0,,Олай емес...
Dialogue: 0,0:04:15.25,0:04:16.63,Default,,0,0,0,,Директор Камишима?
Dialogue: 0,0:04:16.71,0:04:19.63,Default,,0,0,0,,Неліктен қытырлақ?
Dialogue: 0,0:04:20.26,0:04:23.30,Default,,0,0,0,,Бармен де ашуланады.
Dialogue: 0,0:04:24.18,0:04:26.89,Default,,0,0,0,,Қонақ үй жұмысын бастады.
Dialogue: 0,0:04:27.68,0:04:31.89,Default,,0,0,0,,Есептегіш жолағы әлі ашылмайды.
Dialogue: 0,0:04:31.98,0:04:35.35,Default,,0,0,0,,Бұл ешқашан ашылмайтын есік.
Dialogue: 0,0:04:36.02,0:04:39.40,Default,,0,0,0,,Бармен табу қиын екеніне сене алар емеспін.
Dialogue: 0,0:04:39.48,0:04:43.90,Default,,0,0,0,,Басқарушы болмасаң да, қытырлақ болып, ішіңді ауыртады.
Dialogue: 0,0:04:44.61,0:04:46.74,Default,,0,0,0,,Мен Юкари-чанды қызғанамын
Dialogue: 0,0:04:47.66,0:04:51.16,Default,,0,0,0,,Мен жұмыс істемейтін сияқтымын, солай ма?
Dialogue: 0,0:04:51.25,0:04:53.87,Default,,0,0,0,,Мен де асығып тұрмын.
Dialogue: 0,0:04:53.96,0:04:57.04,Default,,0,0,0,,Ха... Мен қайтадан іздеуге тура келеді.
Dialogue: 0,0:04:57.13,0:04:59.67,Default,,0,0,0,,Стандарттар бірінші кезекте тым анық емес.
Dialogue: 0,0:04:59.75,0:05:02.17,Default,,0,0,0,,Ол әрбір детальға өте қатал.
Dialogue: 0,0:05:02.26,0:05:04.68,Default,,0,0,0,,Көбінесе бұл... мынау!
Dialogue: 0,0:05:04.76,0:05:07.68,Default,,0,0,0,,«Құдайдың әйнегі» дегеніміз не?
Dialogue: 0,0:05:07.76,0:05:09.56,Default,,0,0,0,,Төрағаның міндеттемесі
Dialogue: 0,0:05:09.64,0:05:12.68,Default,,0,0,0,,Сонымен~ Бұл нені білдіреді?
Dialogue: 0,0:05:12.77,0:05:17.19,Default,,0,0,0,,Соны түсінбесең, есік мәңгі ашық қалады, солай ма?
Dialogue: 0,0:05:17.86,0:05:19.65,Default,,0,0,0,,Сабыр сақта.
Dialogue: 0,0:05:22.94,0:05:25.90,Default,,0,0,0,,Құдайдың шыны...?
Dialogue: 0,0:05:27.11,0:05:31.70,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:05:31.79,0:05:36.79,Default,,0,0,0,,(Ұялы телефон рингтоны)
Dialogue: 0,0:05:38.33,0:05:41.21,Default,,0,0,0,,Ой! Иә, иә, мен қазір кетемін.
Dialogue: 0,0:05:41.88,0:05:43.46,Default,,0,0,0,,Мм... а?
Dialogue: 0,0:05:43.55,0:05:45.67,Default,,0,0,0,,Ал...
Dialogue: 0,0:05:48.05,0:05:49.72,Default,,0,0,0,,Біз не істеуіміз керек? Бұл
Dialogue: 0,0:05:52.06,0:05:54.10,Default,,0,0,0,,Ах... Мм, кешіріңіз.
Dialogue: 0,0:05:54.18,0:05:55.73,Default,,0,0,0,,Хмм... Иә?
Dialogue: 0,0:05:56.35,0:05:58.90,Default,,0,0,0,,Маған бірдеңе айтқым келеді...
Dialogue: 0,0:05:58.98,0:06:00.23,Default,,0,0,0,,Мен?
Dialogue: 0,0:06:00.31,0:06:02.86,Default,,0,0,0,,Осында сырғытсаңыз... (Ұйымдастыру) Сырғытыңыз...?
Dialogue: 0,0:06:02.94,0:06:03.78,Default,,0,0,0,,Иә түймесін басыңыз
Dialogue: 0,0:06:03.86,0:06:05.07,Default,,0,0,0,,Қасымда... (Таме) Иә.
Dialogue: 0,0:06:05.15,0:06:05.99,Default,,0,0,0,,Иә!
Dialogue: 0,0:06:06.07,0:06:07.70,Default,,0,0,0,,Көмегің үшін рахмет.
Dialogue: 0,0:06:07.78,0:06:09.20,Default,,0,0,0,,Сәлеметсіз бе? Мүмкін
Dialogue: 0,0:06:09.28,0:06:10.74,Default,,0,0,0,,Иә Сәлем.
Dialogue: 0,0:06:10.82,0:06:12.99,Default,,0,0,0,,Ах Маки-сан, иә, иә.
Dialogue: 0,0:06:13.08,0:06:14.75,Default,,0,0,0,,Бұл тест
Dialogue: 0,0:06:14.83,0:06:17.41,Default,,0,0,0,,Бұл апат болды, Миуа-сенпай.
Dialogue: 0,0:06:17.50,0:06:18.50,Default,,0,0,0,,Ах (Мива) Иә?
Dialogue: 0,0:06:18.58,0:06:20.71,Default,,0,0,0,,Бұл бұрынғы адам ба?
Dialogue: 0,0:06:20.79,0:06:23.92,Default,,0,0,0,,Ах! Бір минут күте тұрыңыз...
Dialogue: 0,0:06:24.00,0:06:25.01,Default,,0,0,0,,Цукуёми-кун мен Каэрубүки-санға қандай сынақтар қойылған?
Dialogue: 0,0:06:25.71,0:06:27.01,Default,,0,0,0,,Мұнда емес.
Dialogue: 0,0:06:27.88,0:06:29.51,Default,,0,0,0,,Токиодағы барлар
Dialogue: 0,0:06:29.59,0:06:32.55,Default,,0,0,0,,А, мүмкін бұл...
Dialogue: 0,0:06:33.72,0:06:34.77,Default,,0,0,0,,Күтілгендей
Dialogue: 0,0:06:34.85,0:06:37.39,Default,,0,0,0,,Бұл кітапхана кітабы.
Dialogue: 0,0:06:37.48,0:06:38.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:38.85,0:06:42.77,Default,,0,0,0,,Шынында да, бұл не?
Dialogue: 0,0:06:44.23,0:06:45.53,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:06:45.61,0:06:48.28,Default,,0,0,0,,Барлығы қайтадан сәтсіздікке ұшырады ма?
Dialogue: 0,0:06:48.90,0:06:51.78,Default,,0,0,0,,Иә, бұл 30 адам.
Dialogue: 0,0:06:51.87,0:06:53.91,Default,,0,0,0,,Егер оны табу оңай болса
Dialogue: 0,0:06:53.99,0:06:56.04,Default,,0,0,0,,Бүркіт оны әлдеқашан тауып алған.
Dialogue: 0,0:06:56.12,0:07:01.04,Default,,0,0,0,,Ең болмағанда бізге нақтырақ шарттарды бере алсаңыз...
Dialogue: 0,0:07:01.13,0:07:05.30,Default,,0,0,0,,Құдайдың шыны деген не?
Dialogue: 0,0:07:05.38,0:07:08.42,Default,,0,0,0,,Иә, бұл...
Dialogue: 0,0:07:08.51,0:07:09.93,Default,,0,0,0,,Сіз оны ішсеңіз түсіне аласыз ба?
Dialogue: 0,0:07:11.01,0:07:13.68,Default,,0,0,0,,Төраға шынымен де солай айтты ма?
Dialogue: 0,0:07:13.76,0:07:16.18,Default,,0,0,0,,Осылай өтірік айтсаң не болады?
Dialogue: 0,0:07:16.27,0:07:19.06,Default,,0,0,0,,Мұны зерттеудің ешқандай жолы жоқ.
Dialogue: 0,0:07:19.14,0:07:21.48,Default,,0,0,0,,Арызыңыз болса, төрағаға айтыңыз.
Dialogue: 0,0:07:23.77,0:07:27.19,Default,,0,0,0,,Мұны біз ғана жасаймыз.
Dialogue: 0,0:07:27.28,0:07:29.44,Default,,0,0,0,,IBN 5100 — ол
Dialogue: 0,0:07:29.53,0:07:32.53,Default,,0,0,0,,Сұхбатқа байланысты ескертпелердің саны айтарлықтай өскен сияқты.
Dialogue: 0,0:07:32.61,0:07:34.37,Default,,0,0,0,,Шынында да…
Dialogue: 0,0:07:34.45,0:07:36.45,Default,,0,0,0,,Барлығы жақсы сияқты.
Dialogue: 0,0:07:37.41,0:07:40.21,Default,,0,0,0,,Бұлай жалғаса берсе, мен оны артта қалдырамын.
Dialogue: 0,0:07:40.29,0:07:41.46,Default,,0,0,0,,Әйтеуір!
Dialogue: 0,0:07:41.54,0:07:45.54,Default,,0,0,0,,Іс осылай жалғаса берсе жаман. Тезірек тауып алайық.
Dialogue: 0,0:07:45.63,0:07:46.84,Default,,0,0,0,,Иә!
Dialogue: 0,0:08:09.57,0:08:11.49,Default,,0,0,0,,Сен қатты мазалап жатырсың.
Dialogue: 0,0:08:11.57,0:08:12.40,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:08:12.49,0:08:13.99,Default,,0,0,0,,Uss
Dialogue: 0,0:08:14.07,0:08:16.37,Default,,0,0,0,,Usu~! Хаха
Dialogue: 0,0:08:16.45,0:08:17.99,Default,,0,0,0,,Иә
Dialogue: 0,0:08:16.45,0:08:17.99,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,0:08:21.58,0:08:22.50,Default,,0,0,0,,және келісім-шарт аяқталады
Dialogue: 0,0:08:22.58,0:08:25.88,Default,,0,0,0,,Шығындар үшін алынбау деген нені білдіреді?
Dialogue: 0,0:08:25.96,0:08:28.75,Default,,0,0,0,,Бухгалтерия бұдан былай қабылдай алмайтынын айтады...
Dialogue: 0,0:08:28.84,0:08:31.30,Default,,0,0,0,,Сонда сіз осы уақытқа дейін бәрін төледіңіз бе?
Dialogue: 0,0:08:31.38,0:08:33.80,Default,,0,0,0,,Менің жалақым...
Dialogue: 0,0:08:33.88,0:08:35.51,Default,,0,0,0,,Әлі де табылмады ма?
Dialogue: 0,0:08:35.59,0:08:37.76,Default,,0,0,0,,Ашылмаған есіктің бармені
Dialogue: 0,0:08:37.85,0:08:39.60,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:08:39.68,0:08:41.52,Default,,0,0,0,,Мен оны ешқашан таба алмайтын шығармын
Dialogue: 0,0:08:42.31,0:08:47.77,Default,,0,0,0,,Эй, генерал, білмейсің бе? Құдайдың көзілдірігін жасай алатын бармен
Dialogue: 0,0:08:47.86,0:08:50.53,Default,,0,0,0,,Хе, мен білемін.
Dialogue: 0,0:08:50.61,0:08:53.40,Default,,0,0,0,,Иә! (Юкари) Қайдасың?
Dialogue: 0,0:08:54.45,0:08:55.78,Default,,0,0,0,,Бұл мен
Dialogue: 0,0:08:55.86,0:08:57.32,Default,,0,0,0,,Я...
Dialogue: 0,0:08:57.41,0:09:00.29,Default,,0,0,0,,Дүкенді осы сағатқа дейін ашық ұстайтын менмін.
Dialogue: 0,0:09:00.37,0:09:02.08,Default,,0,0,0,,Сіз құдайға ұқсайсыз, солай ма?
Dialogue: 0,0:09:02.16,0:09:04.79,Default,,0,0,0,,Ақылсыз әзілдерді доғарыңыз.
Dialogue: 0,0:09:04.87,0:09:07.04,Default,,0,0,0,,Құдай үшін не?
Dialogue: 0,0:09:07.13,0:09:08.79,Default,,0,0,0,,Сонымен~
Dialogue: 0,0:09:08.88,0:09:11.76,Default,,0,0,0,,Құдай болса, шығынды өтей гөр.
Dialogue: 0,0:09:11.84,0:09:13.42,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:09:13.51,0:09:15.22,Default,,0,0,0,,Сәлеметсіз бе, жоғары балл.
Dialogue: 0,0:09:15.30,0:09:16.30,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:17.05,0:09:18.35,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:18.43,0:09:19.81,Default,,0,0,0,,(Суға құлау дыбысы)
Dialogue: 0,0:09:19.89,0:09:21.93,Default,,0,0,0,,Өйткені, осы уақыт ішінде...
Dialogue: 0,0:09:22.02,0:09:23.56,Default,,0,0,0,,Смартфонды пайдалана алмайтын адам
Dialogue: 0,0:09:23.64,0:09:26.77,Default,,0,0,0,,Ахаха... Мен бұған жақсы емеспін.
Dialogue: 0,0:09:26.85,0:09:28.90,Default,,0,0,0,,Аа, дұрыс. Сіз кітапты білмейсіз бе?
Dialogue: 0,0:09:28.98,0:09:31.19,Default,,0,0,0,,Мен сол кезде ұмытып кеткен сияқтымын...
Dialogue: 0,0:09:31.28,0:09:32.99,Default,,0,0,0,,Мен оны сенімен бірге сақтаймын.
Dialogue: 0,0:09:33.07,0:09:34.07,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:09:34.15,0:09:36.32,Default,,0,0,0,,Менде қазір жоқ...
Dialogue: 0,0:09:36.41,0:09:39.83,Default,,0,0,0,,Мен оны сізге қайтарамын, себебі ол кітапхана мен жұмыстың жанында.
Dialogue: 0,0:09:39.91,0:09:42.83,Default,,0,0,0,,Жарайды ма? рахмет
Dialogue: 0,0:09:42.91,0:09:47.00,Default,,0,0,0,,Жапония да әлі бас тартқан жоқ.
Dialogue: 0,0:09:47.08,0:09:48.29,Default,,0,0,0,,Хой Хайбол
Dialogue: 0,0:09:48.38,0:09:50.96,Default,,0,0,0,,Аа, көп рахмет.
Dialogue: 0,0:09:51.46,0:09:54.42,Default,,0,0,0,,Уф, жұқа! Бұл не деген биік доп?
Dialogue: 0,0:09:54.51,0:09:56.72,Default,,0,0,0,,Генерал, сіз вискиге сараң болдыңыз, солай емес пе?
Dialogue: 0,0:09:56.80,0:09:59.34,Default,,0,0,0,,Мұз еріді. Мен оны бірден ішпеймін.
Dialogue: 0,0:09:59.43,0:10:01.97,Default,,0,0,0,,Дұрыс, бармендер керемет.
Dialogue: 0,0:10:02.06,0:10:03.85,Default,,0,0,0,,Ол да бармен.
Dialogue: 0,0:10:03.93,0:10:05.10,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:10:05.18,0:10:07.64,Default,,0,0,0,,Келесі күні көрсеткен көмегіңіз үшін рахмет.
Dialogue: 0,0:10:07.73,0:10:08.56,Default,,0,0,0,,О
Dialogue: 0,0:10:08.65,0:10:11.61,Default,,0,0,0,,Сенпай, бұл да бір байланыстың түрі.
Dialogue: 0,0:10:11.69,0:10:14.36,Default,,0,0,0,,Сол кісіге де тест тапсырайық.
Dialogue: 0,0:10:14.44,0:10:15.61,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:15.69,0:10:18.95,Default,,0,0,0,,Әмиянымды ұмытамын деп ойламаппын.
Dialogue: 0,0:10:19.03,0:10:22.62,Default,,0,0,0,,Кешіріңіз, бірақ менде бүгін бар... Уф!
Dialogue: 0,0:10:22.70,0:10:24.54,Default,,0,0,0,,Мен банкке баруды ұмытып кетіппін.
Dialogue: 0,0:10:24.62,0:10:26.00,Default,,0,0,0,,Тоқтатайық
Dialogue: 0,0:10:26.08,0:10:27.08,Default,,0,0,0,,(Панда) Ол екі мектептің аралығындағы бір жерде босап шыққан болар, деп ойлаймын—
Dialogue: 0,0:10:27.16,0:10:28.00,Default,,0,0,0,,Я...
Dialogue: 0,0:10:29.00,0:10:31.00,Default,,0,0,0,,Қызық, қайдасың?
Dialogue: 0,0:10:31.92,0:10:34.55,Default,,0,0,0,,Біздің бармен
Dialogue: 0,0:11:02.32,0:11:05.04,Default,,0,0,0,,Гинза Эден Холл?
Dialogue: 0,0:11:05.12,0:11:07.29,Default,,0,0,0,,Иә, бармен
Dialogue: 0,0:11:07.37,0:11:11.54,Default,,0,0,0,,Еуропадағы коктейль байқауында біреу жеңіп алған сияқты.
Dialogue: 0,0:11:11.63,0:11:15.34,Default,,0,0,0,,Эден Холл жабылған жоқ па?
Dialogue: 0,0:11:15.42,0:11:20.80,Default,,0,0,0,,Тұрақсыз жабылған жеке бар ақыры есігін қайта ашты...
Dialogue: 0,0:11:20.88,0:11:25.56,Default,,0,0,0,,Жеке жолақ? Мұндай керемет адам қалай болуы мүмкін ...
Dialogue: 0,0:11:25.64,0:11:30.52,Default,,0,0,0,,Бұл біраз күдікті, бірақ байқап көруге тұрарлық.
Dialogue: 0,0:11:30.60,0:11:32.06,Default,,0,0,0,,Егер шығындар болса
Dialogue: 0,0:11:32.15,0:11:33.56,Default,,0,0,0,,Иә.
Dialogue: 0,0:11:33.65,0:11:36.15,Default,,0,0,0,,Егер шығындар болса
Dialogue: 0,0:11:38.03,0:11:39.32,Default,,0,0,0,,Ах~
Dialogue: 0,0:11:40.07,0:11:42.16,Default,,0,0,0,,Әскери қаржыландыру (Юкари/Мива) Уау!
Dialogue: 0,0:11:42.24,0:11:44.57,Default,,0,0,0,,Рахмет (Юкари) Директор Камишима Құдай!
Dialogue: 0,0:11:46.66,0:11:50.66,Default,,0,0,0,,Міне, осы жерде...
Dialogue: 0,0:11:50.75,0:11:52.08,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:52.17,0:11:54.42,Default,,0,0,0,,А, ана жақта емес пе?
Dialogue: 0,0:11:55.17,0:11:56.59,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:11:56.67,0:11:58.09,Default,,0,0,0,,Осылайша-
Dialogue: 0,0:11:58.17,0:12:02.09,Default,,0,0,0,,Мен бұған дейін талай рет болдым, бірақ байқамадым.
Dialogue: 0,0:12:12.14,0:12:16.40,Default,,0,0,0,,(Дүкендегі BGM)
Dialogue: 0,0:12:30.29,0:12:32.91,Default,,0,0,0,,Бұл өте жақсы емес пе?
Dialogue: 0,0:12:33.42,0:12:34.67,Default,,0,0,0,,(Барлығы төрт адам) Һмм? (JoJo) Дерби?
Dialogue: 0,0:12:36.08,0:12:38.67,Default,,0,0,0,,Сасакура-кун, сен тұтынушысың.
Dialogue: 0,0:12:38.75,0:12:40.71,Default,,0,0,0,,Иә, дәл қазір
Dialogue: 0,0:12:44.84,0:12:45.68,Default,,0,0,0,,Ах
Dialogue: 0,0:12:48.18,0:12:49.31,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:12:49.39,0:12:51.10,Default,,0,0,0,,Сіз тағы да?
Dialogue: 0,0:12:51.18,0:12:53.69,Default,,0,0,0,,А, мен сені жиі көремін.
Dialogue: 0,0:12:53.77,0:12:57.86,Default,,0,0,0,,Өткен күні көрсеткен көмегіңіз үшін рахмет. Мұнда басыңыз.
Dialogue: 0,0:12:57.94,0:12:59.32,Default,,0,0,0,,Иә... иә
Dialogue: 0,0:13:01.03,0:13:02.57,Default,,0,0,0,,Бір-біріңді білесіңдер ме?
Dialogue: 0,0:13:02.65,0:13:04.61,Default,,0,0,0,,Иә, аздап.
Dialogue: 0,0:13:04.70,0:13:08.45,Default,,0,0,0,,Атмосфера бұрынғыдан біршама ерекшеленеді.
Dialogue: 0,0:13:17.04,0:13:19.34,Default,,0,0,0,,Сенпай, сен қалай ойлайсың?
Dialogue: 0,0:13:19.96,0:13:23.47,Default,,0,0,0,,Өнімдердің әртүрлілігі өте жақсы деп ойлаймын...
Dialogue: 0,0:13:23.55,0:13:24.59,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:13:25.51,0:13:27.80,Default,,0,0,0,,А, сәлем
Dialogue: 0,0:13:27.89,0:13:30.22,Default,,0,0,0,,Сіз мұны жақсы түсінесіз.
Dialogue: 0,0:13:30.31,0:13:32.43,Default,,0,0,0,,Огура генералынан сұрадыңыз ба?
Dialogue: 0,0:13:32.52,0:13:34.60,Default,,0,0,0,,Мен оны желідегі шолулар арқылы көрдім.
Dialogue: 0,0:13:34.68,0:13:37.85,Default,,0,0,0,,Өте шебер бармен бар.
Dialogue: 0,0:13:37.94,0:13:40.86,Default,,0,0,0,,Әй, мынандай қауесет бар.
Dialogue: 0,0:13:43.40,0:13:44.53,Default,,0,0,0,,Тапсырысты қалай беруге болады?
Dialogue: 0,0:13:44.53,0:13:45.74,Default,,0,0,0,,Тапсырысты қалай беруге болады?
Dialogue: 0,0:13:44.53,0:13:45.74,Default,,0,0,0,,Бұл адам шынымен бармен болды ма?
Dialogue: 0,0:13:45.74,0:13:45.82,Default,,0,0,0,,Бұл адам шынымен бармен болды ма?
Dialogue: 0,0:13:45.82,0:13:48.49,Default,,0,0,0,,Бұл адам шынымен бармен болды ма?
Dialogue: 0,0:13:45.82,0:13:48.49,Default,,0,0,0,,Хмм... Бір сәт ойланып көрейін.
Dialogue: 0,0:13:49.12,0:13:51.95,Default,,0,0,0,,Ауызша бағалау дұрыс па?
Dialogue: 0,0:13:52.45,0:13:55.87,Default,,0,0,0,,Сасакура-кун, мен шегірткемін.
Dialogue: 0,0:13:55.96,0:13:57.62,Default,,0,0,0,,Иә
Dialogue: 0,0:13:57.71,0:13:59.88,Default,,0,0,0,,Pousse кафе стилі де бар.
Dialogue: 0,0:13:59.96,0:14:02.13,Default,,0,0,0,,Олай болса бір рет болса да болады.
Dialogue: 0,0:14:02.21,0:14:04.42,Default,,0,0,0,,Пусу кафесі – емтихан уақыты...
Dialogue: 0,0:14:04.51,0:14:05.88,Default,,0,0,0,,Иә
Dialogue: 0,0:14:14.98,0:14:17.64,Default,,0,0,0,,Өтінемін, бұл Шегіртке.
Dialogue: 0,0:14:17.73,0:14:19.40,Default,,0,0,0,,Жарайды, Дөңгелек үстел конференциясын бастайық!
Dialogue: 0,0:14:19.48,0:14:23.11,Default,,0,0,0,,Бұл таңқаларлық емес пе? Ол мүлдем араласпады
Dialogue: 0,0:14:23.19,0:14:24.57,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:25.78,0:14:27.07,Default,,0,0,0,,Мен қуғыншымын (Итами) Ах.
Dialogue: 0,0:14:27.15,0:14:29.78,Default,,0,0,0,,Егер солай болса... Ой!
Dialogue: 0,0:14:29.86,0:14:31.66,Default,,0,0,0,,Иә Сіз сенімдісіз бе?
Dialogue: 0,0:14:31.74,0:14:34.41,Default,,0,0,0,,Мен мартини алғым келеді, өтінемін.
Dialogue: 0,0:14:34.49,0:14:36.00,Default,,0,0,0,,Мартини...
Dialogue: 0,0:14:36.08,0:14:37.16,Default,,0,0,0,,(Іштің ырылдаған дыбысы)
Dialogue: 0,0:14:37.25,0:14:38.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:14:39.37,0:14:41.84,Default,,0,0,0,,Сіз әлі тамақ жемеген сияқтысыз.
Dialogue: 0,0:14:41.92,0:14:44.75,Default,,0,0,0,,Алкоголь мөлшері аз
Dialogue: 0,0:14:44.84,0:14:46.67,Default,,0,0,0,,Жеңілірек нәрсе ше?
Dialogue: 0,0:14:46.76,0:14:49.30,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:14:49.38,0:14:50.59,Default,,0,0,0,,Хехе
Dialogue: 0,0:14:50.68,0:14:54.06,Default,,0,0,0,,Мартиниден жеңіл коктейль.
Dialogue: 0,0:14:54.14,0:14:56.18,Default,,0,0,0,,Мен шайқалған нұсқасын алғым келеді, өтінемін.
Dialogue: 0,0:14:56.27,0:14:58.31,Default,,0,0,0,,Аа, түсі қызғылт.
Dialogue: 0,0:14:58.81,0:15:00.31,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:15:15.24,0:15:20.58,Default,,0,0,0,,(Шайкер дыбысы)
Dialogue: 0,0:15:20.67,0:15:25.59,Default,,0,0,0,,Еңбекқор адамның саусақтарында бір нәрсе бар...
Dialogue: 0,0:15:28.09,0:15:29.84,Default,,0,0,0,,Өте сексуалды
Dialogue: 0,0:15:29.92,0:15:31.59,Default,,0,0,0,,Хмм... сексуалды ма?
Dialogue: 0,0:15:36.43,0:15:39.10,Default,,0,0,0,,Өтінемін, Космополит.
Dialogue: 0,0:15:39.18,0:15:40.94,Default,,0,0,0,,Уау...
Dialogue: 0,0:15:44.19,0:15:47.36,Default,,0,0,0,,Дәмді! Бұл керемет дәмді.
Dialogue: 0,0:15:47.44,0:15:48.86,Default,,0,0,0,,Соншама?
Dialogue: 0,0:15:48.94,0:15:50.36,Default,,0,0,0,,Бұл рас!
Dialogue: 0,0:15:52.32,0:15:54.12,Default,,0,0,0,,Тұтынушылар не істейді?
Dialogue: 0,0:15:58.24,0:16:03.63,Default,,0,0,0,,Егер бұл адам шынымен де керемет бармен болса...
Dialogue: 0,0:16:04.83,0:16:06.09,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:16:06.17,0:16:08.21,Default,,0,0,0,,Не? аға
Dialogue: 0,0:16:08.30,0:16:12.30,Default,,0,0,0,,Мен оған жоқ дедім, өйткені бұл барменге қиындық туғызады...
Dialogue: 0,0:16:12.38,0:16:13.72,Default,,0,0,0,,Иә
Dialogue: 0,0:16:13.80,0:16:16.47,Default,,0,0,0,,Алкогольге қарсы қаншалықты күшті?
Dialogue: 0,0:16:16.55,0:16:19.14,Default,,0,0,0,,Алкогольдің қай түрін ұнатасыз?
Dialogue: 0,0:16:19.89,0:16:23.85,Default,,0,0,0,,Тұтынушы туралы ештеңе білмей, өнімді жасай алмайсыз.
Dialogue: 0,0:16:24.40,0:16:27.15,Default,,0,0,0,,Сондықтан сіздің шеберлігіңіз сыналады
Dialogue: 0,0:16:27.23,0:16:28.94,Default,,0,0,0,,Маған қалдырыңыз
Dialogue: 0,0:16:29.03,0:16:32.20,Default,,0,0,0,,Маған тамаша коктейль жасап беріңізші.
Dialogue: 0,0:16:33.57,0:16:34.91,Default,,0,0,0,,Кашикомаримасу
Dialogue: 0,0:16:34.99,0:16:37.66,Default,,0,0,0,,(мұздың жарылған дыбысы)
Dialogue: 0,0:17:00.52,0:17:02.93,Default,,0,0,0,,Негізі - виски
Dialogue: 0,0:17:03.02,0:17:04.60,Default,,0,0,0,,Егер ол вискиге негізделген болса
Dialogue: 0,0:17:04.69,0:17:08.36,Default,,0,0,0,,«Манхэттен» және «Өкіл әке» фильмдері әйгілі.
Dialogue: 0,0:17:08.44,0:17:12.15,Default,,0,0,0,,Егер сіз оны сол стақанмен жасағыңыз келсе, бұл виски пакеті.
Dialogue: 0,0:17:12.24,0:17:15.20,Default,,0,0,0,,Бұл шотландтық болғандықтан, ол Highland Cooler деп аталады ма?
Dialogue: 0,0:17:15.28,0:17:16.70,Default,,0,0,0,,(Көмірқышқыл газының шығу дыбысы)
Dialogue: 0,0:17:17.32,0:17:18.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:17:20.03,0:17:21.45,Default,,0,0,0,,Көмір қышқылы?
Dialogue: 0,0:17:22.54,0:17:25.21,Default,,0,0,0,,Виски және көмір қышқылы…
Dialogue: 0,0:17:29.09,0:17:30.21,Default,,0,0,0,,Күннің соңына сай ән
Dialogue: 0,0:17:31.92,0:17:33.21,Default,,0,0,0,,Хайбол
Dialogue: 0,0:17:34.13,0:17:35.97,Default,,0,0,0,,Хайбол?
Dialogue: 0,0:17:36.05,0:17:38.47,Default,,0,0,0,,Мен үшін ең жақсы сусын қандай?
Dialogue: 0,0:17:39.22,0:17:42.97,Default,,0,0,0,,Мен вискиді газдалған сумен араластырдым...
Dialogue: 0,0:17:43.06,0:17:47.48,Default,,0,0,0,,Мұндай нәрсені кез келген адам жасай алады.
Dialogue: 0,0:17:50.65,0:17:52.73,Default,,0,0,0,,Осыны ішіп болған соң үйге қайтайық.
Dialogue: 0,0:17:53.23,0:17:54.24,Default,,0,0,0,,Аға
Dialogue: 0,0:17:54.99,0:17:58.82,Default,,0,0,0,,Соңында бұл көңілсіз болды.
Dialogue: 0,0:17:59.32,0:18:01.99,Default,,0,0,0,,Нөлден қайта іздеу...
Dialogue: 0,0:18:15.97,0:18:19.22,Default,,0,0,0,,Тегіс және нәзік дәм
Dialogue: 0,0:18:19.89,0:18:22.39,Default,,0,0,0,,Бұл шынымен де биік доп па?
Dialogue: 0,0:18:23.18,0:18:25.39,Default,,0,0,0,,Иә, бірақ...
Dialogue: 0,0:18:26.02,0:18:27.89,Default,,0,0,0,,Бұл дәмді хайубол.
Dialogue: 0,0:18:32.77,0:18:34.90,Default,,0,0,0,,Бұл неге сонша дәмді?
Dialogue: 0,0:18:35.74,0:18:37.32,Default,,0,0,0,,Әлемде
Dialogue: 0,0:18:37.40,0:18:40.82,Default,,0,0,0,,Біз өз тұтынушыларымызды ешқашан ренжітпеуіміз керек жұмыс бар.
Dialogue: 0,0:18:40.91,0:18:42.03,Default,,0,0,0,,Екі бар
Dialogue: 0,0:18:42.74,0:18:46.00,Default,,0,0,0,,Біреуі дәрігер фармацевт
Dialogue: 0,0:18:46.08,0:18:47.41,Default,,0,0,0,,Басқа нәрсе ...
Dialogue: 0,0:18:48.08,0:18:49.67,Default,,0,0,0,,Ал екіншісі ше?
Dialogue: 0,0:18:50.92,0:18:52.59,Default,,0,0,0,,Бармен
Dialogue: 0,0:18:52.67,0:18:54.55,Default,,0,0,0,,Екеуі де бір рецептпен
Dialogue: 0,0:18:54.63,0:18:57.92,Default,,0,0,0,,Олар у ретінде де, дәрі ретінде де қолдануға болатын заттарды сатады.
Dialogue: 0,0:18:58.01,0:18:59.68,Default,,0,0,0,,Медицина…
Dialogue: 0,0:19:01.51,0:19:03.68,Default,,0,0,0,,Бізде шаршаған тұтынушы бар.
Dialogue: 0,0:19:04.35,0:19:07.85,Default,,0,0,0,,Мүмкін сіз жұмысқа тым көп көңіл бөле алмайсыз.
Dialogue: 0,0:19:08.35,0:19:10.94,Default,,0,0,0,,Жеңдердегі түймелер шешіліп тұрған...
Dialogue: 0,0:19:11.69,0:19:13.69,Default,,0,0,0,,Сонда ол шешілді ме?
Dialogue: 0,0:19:13.77,0:19:15.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:16.86,0:19:19.28,Default,,0,0,0,,Сағаттың орны да өзгерді
Dialogue: 0,0:19:19.36,0:19:22.20,Default,,0,0,0,,Аа... бұл неге...
Dialogue: 0,0:19:23.12,0:19:26.83,Default,,0,0,0,,Мүмкін... сол кезде?
Dialogue: 0,0:19:28.20,0:19:32.08,Default,,0,0,0,,Осындай ұсақ-түйектерді көріп, есіңізде қалдыңыз ба?
Dialogue: 0,0:19:34.00,0:19:36.80,Default,,0,0,0,,Стресске ұшыраған ағза
Dialogue: 0,0:19:36.88,0:19:41.05,Default,,0,0,0,,Мен әдеттегі хайбол рецепті тым күшті деп ойладым.
Dialogue: 0,0:19:41.13,0:19:43.85,Default,,0,0,0,,Сондықтан біз алкоголь мөлшерін төмендеттік.
Dialogue: 0,0:19:43.93,0:19:48.27,Default,,0,0,0,,Өтірік болса, дәмі әлсіз емес пе еді?
Dialogue: 0,0:19:48.35,0:19:49.35,Default,,0,0,0,,Мұз
Dialogue: 0,0:19:50.02,0:19:52.81,Default,,0,0,0,,Алкоголь мөлшерін шекке дейін төмендетсеңіз де
Dialogue: 0,0:19:52.90,0:19:55.94,Default,,0,0,0,,Тепе-теңдігін жоғалтпайтын қатты мұз
Dialogue: 0,0:19:56.61,0:20:00.90,Default,,0,0,0,,Мұз неғұрлым ұзақ қатса, соғұрлым қатаяды.
Dialogue: 0,0:20:00.99,0:20:02.86,Default,,0,0,0,,Одан әрі өзек бөлігін кесіңіз.
Dialogue: 0,0:20:03.78,0:20:05.62,Default,,0,0,0,,Оны мұздатқышта бірнеше күн қалдырыңыз.
Dialogue: 0,0:20:07.45,0:20:10.87,Default,,0,0,0,,Оңай ерімейтін қатты мұздан жасалған
Dialogue: 0,0:20:11.92,0:20:13.88,Default,,0,0,0,,Бір ғана сусын үшін -
Dialogue: 0,0:20:14.54,0:20:16.88,Default,,0,0,0,,Сіз соншалықты ойлайсыз ба?
Dialogue: 0,0:20:17.80,0:20:21.63,Default,,0,0,0,,Бармен сөзінің мағынасын білесіз бе?
Dialogue: 0,0:20:23.43,0:20:27.10,Default,,0,0,0,,Бар – «алабұға» Тендер «жұмсақ»
Dialogue: 0,0:20:27.18,0:20:30.14,Default,,0,0,0,,«Нәзік алабұға» дегенді білдіреді
Dialogue: 0,0:20:30.98,0:20:34.35,Default,,0,0,0,,Бұл жай ғана спирт салуға болатын бар.
Dialogue: 0,0:20:35.02,0:20:37.90,Default,,0,0,0,,Бірақ сонда бармен бар.
Dialogue: 0,0:20:38.40,0:20:42.65,Default,,0,0,0,,Барда нәзік нәзіктік туады
Dialogue: 0,0:20:43.61,0:20:46.16,Default,,0,0,0,,Сонымен, бұл биік доп...
Dialogue: 0,0:20:46.24,0:20:50.91,Default,,0,0,0,,Мен сізді сынайтын бірдеңе жасадым.
Dialogue: 0,0:20:51.87,0:20:54.96,Default,,0,0,0,,Есептегіш алдында тұрған тұтынушылар үшін
Dialogue: 0,0:20:55.04,0:20:57.92,Default,,0,0,0,,Мен сіздің тамаша кесе ішкеніңізді қалаймын.
Dialogue: 0,0:20:58.00,0:21:00.92,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:21:05.55,0:21:07.18,Default,,0,0,0,,Мен оны таптым!
Dialogue: 0,0:21:07.26,0:21:08.81,Default,,0,0,0,,Сасакураны бағындырыңыз
Dialogue: 0,0:21:08.89,0:21:11.68,Default,,0,0,0,,Төрағаға да ұнайтынына сенімдімін.
Dialogue: 0,0:21:11.77,0:21:15.19,Default,,0,0,0,,Париждегі Rat's қонақ үйінің бас бармені...
Dialogue: 0,0:21:15.81,0:21:17.90,Default,,0,0,0,,Сіз шетелде болдыңыз ба?
Dialogue: 0,0:21:17.98,0:21:20.44,Default,,0,0,0,,Үміткер ретінде ұсталмағаным таңқаларлық емес.
Dialogue: 0,0:21:20.53,0:21:23.90,Default,,0,0,0,,Мен ол адам Құдайдың шыны деп аталатын нәрсені жасай алатынына сенімдімін.
Dialogue: 0,0:21:23.99,0:21:25.86,Default,,0,0,0,,Ішсең, түсінесің.
Dialogue: 0,0:21:25.95,0:21:27.20,Default,,0,0,0,,Мистер Столкер
Dialogue: 0,0:21:27.87,0:21:31.20,Default,,0,0,0,,Бірақ сіз Жапонияға неліктен оралдыңыз?
Dialogue: 0,0:21:31.29,0:21:34.00,Default,,0,0,0,,Бұл алаңдаушылық, солай емес пе?
Dialogue: 0,0:21:34.08,0:21:37.96,Default,,0,0,0,,Одан гөрі олар менің үйіме келе ме, келмей ме деген сұрақ.
Dialogue: 0,0:21:38.04,0:21:41.21,Default,,0,0,0,,Төрағаның үмітін ақтай ма?
Dialogue: 0,0:21:41.30,0:21:43.46,Default,,0,0,0,,Материалдарды дайындаңыздар. (Мива/Юкари) Иә!
Dialogue: 0,0:21:45.01,0:21:46.76,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:21:46.84,0:21:47.97,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:21:48.72,0:21:50.72,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:21:50.81,0:21:52.02,Default,,0,0,0,,Ах~
Dialogue: 0,0:21:52.10,0:21:54.73,Default,,0,0,0,,Иә? Қайтарып бермедің бе?
Dialogue: 0,0:21:54.81,0:21:57.98,Default,,0,0,0,,Аа~ мен ұмытып кетіппін...
Dialogue: 0,0:22:15.08,0:22:20.08,Default,,0,0,0,,♪～
Dialogue: 0,0:23:40.00,0:23:45.00,Default,,0,0,0,,～♪
