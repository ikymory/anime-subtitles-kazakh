Dialogue: 0,0:00:30.00,0:00:35.00,花語製作通用,,0000,0000,0000,,Бұл субтитр Юка тіліндегі субтитр тобының өндірісі
Dialogue: 0,0:01:44.23,0:01:45.55,兔子日文,,0000,0000,0040,,Q01
Dialogue: 0,0:01:46.72,0:01:48.11,兔子日文,,0000,0000,0040,,Q01
Dialogue: 0,0:01:54.55,0:01:55.86,兔子日文,,0000,0000,0040,,Q01
Dialogue: 0,0:01:56.58,0:01:58.56,兔子日文,,0000,0000,0000,,Ол көтеріледі
Dialogue: 0,0:02:58.65,0:03:00.11,兔子日文,,0000,0000,0000,,Хал өлді
Dialogue: 0,0:03:02.03,0:03:06.05,兔子日文,,0000,0000,0000,,Әрқашан Курумимен бірге жүретін Хару қайтыс болды.
Dialogue: 0,0:03:10.78,0:03:12.63,兔子日文,,0000,0000,0000,,Куруми күлуін тоқтатты
Dialogue: 0,0:03:13.52,0:03:14.84,兔子日文,,0000,0000,0000,,Мен ұйықтауды тоқтаттым
Dialogue: 0,0:03:15.79,0:03:17.22,兔子日文,,0000,0000,0000,,Мен тыңдауды тоқтаттым.
Dialogue: 0,0:03:18.19,0:03:20.04,兔子日文,,0000,0000,0000,,Мен ештеңе жеуді қойдым.
Dialogue: 0,0:03:21.44,0:03:22.83,兔子日文,,0000,0000,0000,,Мен жылауды қойдым
Dialogue: 0,0:03:40.37,0:03:41.53,兔子日文,,0000,0000,0040,,Q01
Dialogue: 0,0:03:46.28,0:03:50.26,兔子日文,,0000,0000,0000,,Сол балаға көмектесіңізші.
Dialogue: 0,0:03:52.75,0:03:55.65,兔子日文,,0000,0000,0000,,Сіз ол жігіт бола аласыз.
Dialogue: 0,0:03:58.75,0:04:03.18,兔子日文,,0000,0000,0000,,Сол адам бол және сол баланы құтқар.
Dialogue: 0,0:04:39.27,0:04:41.38,兔子日文,,0000,0000,0000,,Мен адам болдым
Dialogue: 0,0:04:52.82,0:04:56.59,兔子日文,,0000,0000,0000,,Q01 Кешіктіргеніміз үшін кешіріңіз.
Dialogue: 0,0:04:59.15,0:05:02.82,兔子日文,,0000,0000,0000,,Мұғалім, мен бүгіннен Харумын.
Dialogue: 0,0:05:02.82,0:05:05.10,兔子日文,,0000,0000,0000,,Бұл болды
Dialogue: 0,0:05:05.73,0:05:08.61,兔子日文,,0000,0000,0000,,Адам болу қандай сезімде?
Dialogue: 0,0:05:09.61,0:05:12.47,兔子日文,,0000,0000,0000,,«Көңіл-күй» дегеніміз не?
Dialogue: 0,0:05:13.02,0:05:16.02,兔子日文,,0000,0000,0000,,«Көңіл-күй» бұл...
Dialogue: 0,0:05:17.73,0:05:19.45,兔子日文,,0000,0000,0000,,Қазір жоқ
Dialogue: 0,0:05:20.04,0:05:22.84,兔子日文,,0000,0000,0000,,Әй, эй, тезірек.
Dialogue: 0,0:05:43.93,0:05:46.57,兔子日文,,0000,0000,0000,,Бұл ностальгиялық.
Dialogue: 0,0:05:48.29,0:05:50.51,兔子日文,,0000,0000,0000,,Студент кезім
Dialogue: 0,0:05:50.51,0:05:53.77,兔子日文,,0000,0000,0000,,Бірге жиналсаң тілегің орындалады дейді.
Dialogue: 0,0:05:53.77,0:05:57.32,兔子日文,,0000,0000,0000,,Қыздар және басқалар мұны амалсыз атқарды.
Dialogue: 0,0:05:57.88,0:05:59.79,兔子日文,,0000,0000,0000,,Бір кездерің болды
Dialogue: 0,0:06:01.79,0:06:03.95,兔子日文,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:06:03.95,0:06:07.49,兔子日文,,0000,0000,0000,,Мен Хару кәрі туралы ештеңе білмеймін.
Dialogue: 0,0:06:21.97,0:06:23.71,兔子日文,,0000,0000,0000,,Олардың мен адамзаттың күш арасындағы алшақтық аса үлкен еді,
Dialogue: 0,0:06:24.43,0:06:25.69,兔子日文,,0000,0000,0000,,Нашар
Dialogue: 0,0:06:25.69,0:06:29.91,兔子日文,,0000,0000,0000,,Мен болашақта кемпірге бетімді көрсетуім керек.
Dialogue: 0,0:06:30.41,0:06:32.70,兔子日文,,0000,0000,0000,,Сіз өзіңіз бара аласыз.
Dialogue: 0,0:06:36.25,0:06:37.41,兔子日文,,0000,0000,0000,,Иә.
Dialogue: 0,0:06:39.39,0:06:40.33,兔子日文,,0000,0000,0000,,Хаха… бұл қызық екен.
Dialogue: 0,0:06:43.58,0:06:46.34,兔子日文,,0000,0000,0000,,Жаңғақ және «рус»?
Dialogue: 0,0:06:47.44,0:06:49.16,兔子日文,,0000,0000,0000,,Оны Халл жазды.
Dialogue: 0,0:06:53.56,0:06:55.43,兔子日文,,0000,0000,0000,,Жаңғақпен өмір сүру
Dialogue: 0,0:06:56.37,0:06:59.51,兔子日文,,0000,0000,0000,,Бұл Харудың соңғы тілегі.
Dialogue: 0,0:07:16.37,0:07:18.35,兔子日文,,0000,0000,0000,,Мен адам болдым
Dialogue: 0,0:07:17.66,0:07:19.25,兔子日文,,0000,0000,0000,,Кочи Кокчи
Dialogue: 0,0:07:20.71,0:07:21.71,兔子日文,,0000,0000,0000,,Тәуекелде
Dialogue: 0,0:08:45.85,0:08:47.60,兔子日文,,0000,0000,0000,,Қиындық тудырғаным үшін кешір.
Dialogue: 0,0:09:39.56,0:09:41.22,兔子日文,,0000,0000,0000,,Сіз Курумисіз бе?
Dialogue: 0,0:09:46.86,0:09:48.44,兔子日文,,0000,0000,0000,,Куруми-сан, солай ма?
Dialogue: 0,0:09:49.30,0:09:50.22,兔子日文,,0000,0000,0000,,Қазір
Dialogue: 0,0:09:50.83,0:09:53.48,兔子日文,,0000,0000,0000,,Мені қамқорлық орталығынан жіберді.
Dialogue: 0,0:09:53.86,0:09:56.28,兔子日文,,0000,0000,0000,,Сіз мені тыңдайсыз ба?
Dialogue: 0,0:09:58.74,0:10:00.81,兔子日文,,0000,0000,0000,,Мен Харуға ұқсайтын робот сұрағаным есімде жоқ.
Dialogue: 0,0:10:04.44,0:10:07.33,兔子日文,,0000,0000,0000,,Мен Куруми-санға көмектесуге келдім.
Dialogue: 0,0:10:17.94,0:10:19.26,兔子日文,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:10:20.37,0:10:21.58,兔子日文,,0000,0000,0000,,Мен үйге бара жатырмын
Dialogue: 0,0:10:26.82,0:10:27.75,兔子日文,,0000,0000,0000,,Куруми-сан
Dialogue: 0,0:10:28.18,0:10:31.69,兔子日文,,0000,0000,0000,,Менің қайтып келгенімді қаласаңыз, қол қоясыз ба?
Dialogue: 0,0:11:40.05,0:11:41.59,兔子日文,,0000,0000,0000,,Куруми
Dialogue: 0,0:11:42.89,0:11:44.72,兔子日文,,0000,0000,0000,,Рубик кубигі
Dialogue: 0,0:11:54.87,0:11:56.52,兔子日文,,0000,0000,0000,,Барлығы жинақталған
Dialogue: 0,0:11:57.95,0:12:00.10,兔子日文,,0000,0000,0000,,Куруми мырза келді.
Dialogue: 0,0:12:00.10,0:12:01.58,兔子日文,,0000,0000,0000,,Курумидің тілегі...
Dialogue: 0,0:12:09.06,0:12:10.22,兔子日文,,0000,0000,0000,,...
Dialogue: 0,0:12:12.12,0:12:13.52,兔子日文,,0000,0000,0000,,Түсінікті
Dialogue: 0,0:12:54.37,0:12:55.55,兔子日文,,0000,0000,0000,,Куруми мырза
Dialogue: 0,0:12:55.96,0:12:57.29,兔子日文,,0000,0000,0000,,Тамақ дайын.
Dialogue: 0,0:12:58.55,0:13:00.84,兔子日文,,0000,0000,0000,,Себебі мен оны бірінші рет жасап отырмын.
Dialogue: 0,0:13:00.84,0:13:04.26,兔子日文,,0000,0000,0000,,Сәл сәтсіздікке ұшырағаным үшін кешіріңіз.
Dialogue: 0,0:13:11.19,0:13:14.51,兔子日文,,0000,0000,0000,,Мен күрішті осында қалдырамын.
Dialogue: 0,0:13:16.22,0:13:18.05,兔子日文,,0000,0000,0000,,Дұрыс тамақтаныңыз.
Dialogue: 0,0:13:20.21,0:13:21.82,兔子日文,,0000,0000,0000,,Мен ертең қайтамын.
Dialogue: 0,0:13:23.00,0:13:24.21,兔子日文,,0000,0000,0000,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:14:02.28,0:14:03.83,兔子日文,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:14:09.13,0:14:10.39,兔子日文,,0000,0000,0000,,Куруми мырза
Dialogue: 0,0:14:10.39,0:14:12.63,兔子日文,,0000,0000,0000,,Қалаған нәрсе бар ма?
Dialogue: 0,0:14:12.99,0:14:14.73,兔子日文,,0000,0000,0000,,Мен дүкенге барамын.
Dialogue: 0,0:14:47.44,0:14:49.82,兔子日文,,0000,0000,0000,,Омачидо-сама десу
Dialogue: 0,0:14:49.82,0:14:50.93,兔子日文,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:15:07.21,0:15:08.55,兔子日文,,0000,0000,0000,,Дайын
Dialogue: 0,0:15:08.55,0:15:11.80,兔子日文,,0000,0000,0000,,Гайоючокука
Dialogue: 0,0:15:09.01,0:15:10.02,兔子日文,,0000,0000,0000,,Қараңыз
Dialogue: 0,0:15:25.52,0:15:27.57,兔子日文,,0000,0000,0000,,28 миллион иен
Dialogue: 0,0:15:32.68,0:15:33.82,兔子日文,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:15:35.41,0:15:36.63,兔子日文,,0000,0000,0000,,Әй, бұл осылай.
Dialogue: 0,0:15:36.63,0:15:38.10,兔子日文,,0000,0000,0000,,Мұнда
Dialogue: 0,0:15:40.90,0:15:42.10,兔子日文,,0000,0000,0000,,жылдам
Dialogue: 0,0:15:42.10,0:15:43.75,兔子日文,,0000,0000,0000,,Мен таптым
Dialogue: 0,0:15:44.85,0:15:45.81,兔子日文,,0000,0000,0000,,Қараңыз
Dialogue: 0,0:16:02.43,0:16:03.57,兔子日文,,0000,0000,0000,,Нөлдік иен
Dialogue: 0,0:16:09.10,0:16:11.83,兔子日文,,0000,0000,0000,,Жирафты алуға тырыстың ба?
Dialogue: 0,0:16:11.83,0:16:15.04,兔子日文,,0000,0000,0000,,Иә, содан кейін дүкен қызметкерлері маған ашуланды.
Dialogue: 0,0:16:15.04,0:16:17.04,兔子日文,,0000,0000,0000,,Мен солай ойлаймын.
Dialogue: 0,0:16:17.04,0:16:19.61,兔子日文,,0000,0000,0000,,Бірақ ол нөл иен болды.
Dialogue: 0,0:16:19.61,0:16:21.25,兔子日文,,0000,0000,0000,,Нөлдік иен дегеніміз не?
Dialogue: 0,0:16:21.25,0:16:24.42,兔子日文,,0000,0000,0000,,Бұл оны өзіңізбен бірге ала аласыз дегенді білдірмейді.
Dialogue: 0,0:16:24.42,0:16:26.96,兔子日文,,0000,0000,0000,,Сондай-ақ оған баға қоюға болмайды дегенді білдіреді.
Dialogue: 0,0:16:26.96,0:16:28.86,兔子日文,,0000,0000,0000,,Тек мені көтер.
Dialogue: 0,0:16:33.28,0:16:35.16,兔子日文,,0000,0000,0000,,Бағаға тұрарлық емес
Dialogue: 0,0:16:35.92,0:16:39.91,兔子日文,,0000,0000,0000,,Бұл маңызды нәрсе, сондықтан сіз оған баға қоя алмайсыз.
Dialogue: 0,0:16:39.91,0:16:42.85,兔子日文,,0000,0000,0000,,Нөлдік иен маңызды
Dialogue: 0,0:16:44.28,0:16:47.20,兔子日文,,0000,0000,0000,,Мен Кириндодан жираф алғым келеді.
Dialogue: 0,0:16:47.20,0:16:49.70,兔子日文,,0000,0000,0000,,Садаодан сұрасаң басқаша.
Dialogue: 0,0:16:49.70,0:16:51.64,兔子日文,,0000,0000,0000,,Дүкеннің алдында отырған қарт
Dialogue: 0,0:16:51.64,0:16:53.13,兔子日文,,0000,0000,0000,,Бар болуы керек
Dialogue: 0,0:16:53.88,0:16:55.89,兔子日文,,0000,0000,0000,,Сол жираф
Dialogue: 0,0:16:55.89,0:16:57.95,兔子日文,,0000,0000,0000,,Бұл жақсы емес.
Dialogue: 0,0:16:57.95,0:17:01.63,兔子日文,,0000,0000,0000,,Ана жақтағы әйел де ондай жоқ деді.
Dialogue: 0,0:17:01.63,0:17:05.45,兔子日文,,0000,0000,0000,,Бір ғана Садао бар, ол барын салып жатыр.
Dialogue: 0,0:17:05.45,0:17:07.88,兔子日文,,0000,0000,0000,,Анау қарт қарт.
Dialogue: 0,0:17:08.31,0:17:11.14,兔子日文,,0000,0000,0000,,Маған Цукико-сан айтса жақсы болар еді.
Dialogue: 0,0:17:11.14,0:17:13.52,兔子日文,,0000,0000,0000,,Цукико-сан.
Dialogue: 0,0:17:13.52,0:17:16.57,兔子日文,,0000,0000,0000,,Цукико-сан, Садаодан сұраңыз.
Dialogue: 0,0:17:18.46,0:17:19.93,兔子日文,,0000,0000,0000,,Цукико-сан
Dialogue: 0,0:17:19.21,0:17:20.73,兔子日文,,0000,0000,0000,,Жоқ, жоқ.
Dialogue: 0,0:17:20.73,0:17:22.16,兔子日文,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:17:22.16,0:17:25.54,兔子日文,,0000,0000,0000,,Бауырым, сен мұны қатты қалайтыныңды айттың.
Dialogue: 0,0:17:27.71,0:17:33.53,兔子日文,,0000,0000,0000,,Неліктен мен мына бір бейтаныс бұршақ өскіні үшін сүйекті аямаймын?
Dialogue: 0,0:17:33.53,0:17:38.20,兔子日文,,0000,0000,0000,,Жалпы, олар біреудің рұқсатынсыз бірдеңені алып кетсе, ұры деп атайтынын білмей ме?
Dialogue: 0,0:17:38.20,0:17:42.16,兔子日文,,0000,0000,0000,,Мен ең жек көретін түрі әлсіз адамды.
Dialogue: 0,0:17:42.16,0:17:45.03,兔子日文,,0000,0000,0000,,Ер болса да брошь киеді.
Dialogue: 0,0:17:48.25,0:17:50.61,兔子日文,,0000,0000,0000,,Сіз, сол түйме...
Dialogue: 0,0:17:51.62,0:17:55.17,兔子日文,,0000,0000,0000,,Мына түйме сүйкімді, солай емес пе?
Dialogue: 0,0:17:55.17,0:17:56.30,兔子日文,,0000,0000,0000,,Бүгін таңертең...
Dialogue: 0,0:17:58.91,0:18:01.64,兔子日文,,0000,0000,0000,,Сіз Куруми-санның танысысыз ба?
Dialogue: 0,0:18:02.90,0:18:06.08,兔子日文,,0000,0000,0000,,Бұған неге иә деп айтпайсың?
Dialogue: 0,0:18:06.08,0:18:09.19,兔子日文,,0000,0000,0000,,Цукико-сан, мен оны әлі жөндеп біткен жоқпын.
Dialogue: 0,0:18:08.31,0:18:10.16,兔子日文,,0000,0000,0000,,Шулы дәрігер
Dialogue: 0,0:18:10.16,0:18:11.25,兔子日文,,0000,0000,0000,,♬ Бос соңғы бетте
Dialogue: 0,0:18:12.57,0:18:16.19,兔子日文,,0000,0000,0000,,Бұл адам Куруми-санға қарыз.
Dialogue: 0,0:18:16.58,0:18:21.01,兔子日文,,0000,0000,0000,,Сіз мұнда кіргенде отбасыңызбен қатты ұрысып қалдыңыз.
Dialogue: 0,0:18:21.01,0:18:26.16,兔子日文,,0000,0000,0000,,Цукиконың барлық қымбат киімдері лақтырылды.
Dialogue: 0,0:18:22.99,0:18:26.16,兔子日文,,0000,0000,0000,,Иә, тез Садао мырзаға қоңырау шалыңыз.
Dialogue: 0,0:18:26.16,0:18:27.81,兔子日文,,0000,0000,0000,,Бұл қорқынышты болар еді.
Dialogue: 0,0:18:28.48,0:18:32.34,兔子日文,,0000,0000,0000,,Бірақ Куруми-сан менімен сөйлесіп, бәрін өз қолына алды.
Dialogue: 0,0:18:32.34,0:18:34.03,兔子日文,,0000,0000,0000,,Мұқият күтім
Dialogue: 0,0:18:34.03,0:18:36.93,兔子日文,,0000,0000,0000,,Жақын адамдарға таратып берді.
Dialogue: 0,0:18:36.93,0:18:38.19,兔子日文,,0000,0000,0000,,Куруми мырза...
Dialogue: 0,0:18:38.19,0:18:42.63,兔子日文,,0000,0000,0000,,Бұл түйме Цукиконың екі бөлігінде болған түйме.
Dialogue: 0,0:18:42.63,0:18:45.24,兔子日文,,0000,0000,0000,,Бірінші кездесуде киген киіміңізге ұқсайды.
Dialogue: 0,0:18:45.24,0:18:46.31,兔子日文,,0000,0000,0000,,Садаомен
Dialogue: 0,0:18:46.31,0:18:48.56,兔子日文,,0000,0000,0000,,Қажет емес нәрсені айта аласыз.
Dialogue: 0,0:18:49.34,0:18:51.02,兔子日文,,0000,0000,0000,,Жирафты қайтар
Dialogue: 0,0:18:51.56,0:18:54.25,兔子日文,,0000,0000,0000,,Дүкенде телефон бар.
Dialogue: 0,0:18:56.75,0:18:58.35,兔子日文,,0000,0000,0000,,Рахмет
Dialogue: 0,0:18:59.92,0:19:02.13,兔子日文,,0000,0000,0000,,Оның орнына осы түймені пайдаланыңыз.
Dialogue: 0,0:19:02.13,0:19:03.68,兔子日文,,0000,0000,0000,,Оны сол күйінде қалдыра аласыз.
Dialogue: 0,0:19:04.57,0:19:06.56,兔子日文,,0000,0000,0000,,Оны сол күйінде сақтаңыз.
Dialogue: 0,0:19:07.41,0:19:13.75,兔子日文,,0000,0000,0000,,Менің естеліктерім осы дүниенің әр жерінде шашырап кеткенін ойлау
Dialogue: 0,0:19:14.52,0:19:17.09,兔子日文,,0000,0000,0000,,Бұл жеткілікті
Dialogue: 0,0:19:32.55,0:19:35.53,兔子日文,,0000,0000,0000,,Нөлдік иен маңызды
Dialogue: 0,0:19:46.98,0:19:48.66,兔子日文,,0000,0000,0000,,Суретке түсірмеңіз.
Dialogue: 0,0:19:51.08,0:19:53.24,兔子日文,,0000,0000,0000,,Рахмет сізге ата
Dialogue: 0,0:19:53.60,0:19:55.08,兔子日文,,0000,0000,0000,,Бұл не?
Dialogue: 0,0:19:55.08,0:19:58.41,兔子日文,,0000,0000,0000,,Отаке-санның әжесі сыйға тартқан жүннен жасалған.
Dialogue: 0,0:19:58.41,0:19:59.47,兔子日文,,0000,0000,0000,,Қараңыз
Dialogue: 0,0:20:03.67,0:20:05.67,兔子日文,,0000,0000,0000,,Жақсы орындалған сияқты
Dialogue: 0,0:20:12.22,0:20:14.63,兔子日文,,0000,0000,0000,,Рахмет саған Хал
Dialogue: 0,0:20:15.44,0:20:16.94,兔子日文,,0000,0000,0000,,Мен осындамын
Dialogue: 0,0:20:17.61,0:20:19.66,兔子日文,,0000,0000,0000,,Мен оны сатпауым керек еді.
Dialogue: 0,0:21:01.68,0:21:03.44,兔子日文,,0000,0000,0000,,Хал, күте тұрыңыз.
Dialogue: 0,0:21:05.07,0:21:07.90,兔子日文,,0000,0000,0000,,Ештеңені іске қосудың қажеті жоқ.
Dialogue: 0,0:21:09.75,0:21:13.44,兔子日文,,0000,0000,0000,,Сіз оны бірінші біреуге бере аласыз, солай ма?
Dialogue: 0,0:21:13.44,0:21:16.56,兔子日文,,0000,0000,0000,,Мұны ешкім қаламайды.
Dialogue: 0,0:21:49.76,0:21:51.20,兔子日文,,0000,0000,0000,,Мұғалім
Dialogue: 0,0:21:51.20,0:21:56.86,兔子日文,,0000,0000,0000,,Куруми-санның мұңын толық түсіне аламын ба?
Dialogue: 0,0:21:56.86,0:21:58.60,兔子日文,,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,0:21:58.60,0:22:00.91,兔子日文,,0000,0000,0000,,Менің робот болғаным үшін бе?
Dialogue: 0,0:22:00.91,0:22:03.21,兔子日文,,0000,0000,0000,,Тіпті адамдар үшін де солай.
Dialogue: 0,0:22:03.92,0:22:06.25,兔子日文,,0000,0000,0000,,Басқалардың қайғысы мен қасіреті
Dialogue: 0,0:22:06.25,0:22:08.99,兔子日文,,0000,0000,0000,,Мен шынымен де білмеймін деп ойлаймын.
Dialogue: 0,0:22:14.03,0:22:16.96,兔子日文,,0000,0000,0000,,Түсінбесең де жарайды.
Dialogue: 0,0:22:16.96,0:22:19.58,兔子日文,,0000,0000,0000,,Білмесек, қамқорлық жасай алмаймыз.
Dialogue: 0,0:22:20.59,0:22:22.58,兔子日文,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,0:22:22.58,0:22:26.55,兔子日文,,0000,0000,0000,,Ештеңе істеудің қажеті жоқ, тек қарап тұрыңыз.
Dialogue: 0,0:22:30.90,0:22:33.14,兔子日文,,0000,0000,0000,,Дәл солай
Dialogue: 0,0:22:33.14,0:22:34.66,兔子日文,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:22:36.75,0:22:38.78,兔子日文,,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,0:22:40.97,0:22:42.80,兔子日文,,0000,0000,0000,,Адам дегеніміз не?
Dialogue: 0,0:22:43.34,0:22:45.74,兔子日文,,0000,0000,0000,,Бұл жеткілікті.
Dialogue: 0,0:22:48.55,0:22:49.80,兔子日文,,0000,0000,0000,,Жираф Жираф
Dialogue: 0,0:22:51.34,0:22:52.97,兔子日文,,0000,0000,0000,,Жираф ата
Dialogue: 0,0:22:55.64,0:22:56.81,兔子日文,,0000,0000,0000,,Мама Мама
Dialogue: 0,0:22:56.81,0:22:58.56,兔子日文,,0000,0000,0000,,Жираф ата болуы керек.Жираф ата
Dialogue: 0,0:22:57.61,0:23:01.21,兔子日文,,0000,0000,0000,,Жоқ, қарашы, Сачико-чан сені күтіп отыр.
Dialogue: 0,0:23:03.33,0:23:07.07,兔子日文,,0000,0000,0000,,Міне, мен солай ойлаймын.
Dialogue: 0,0:23:08.56,0:23:11.78,兔子日文,,0000,0000,0000,,Көңілсіз қалмаңыз, жақын жерде.
Dialogue: 0,0:23:11.78,0:23:13.13,兔子日文,,0000,0000,0000,,Оны алып жүрейік
Dialogue: 0,0:23:13.13,0:23:14.62,兔子日文,,0000,0000,0000,,Иә
Dialogue: 0,0:23:28.47,0:23:30.87,兔子日文,,0000,0000,0000,,Электр сымдарынан сақ болыңыз
Dialogue: 0,0:23:39.39,0:23:41.96,兔子日文,,0000,0000,0000,,Жарайды, арқаңызды ұстаңыз.
Dialogue: 0,0:23:41.96,0:23:42.95,兔子日文,,0000,0000,0000,,Иә
Dialogue: 0,0:23:45.20,0:23:46.19,兔子日文,,0000,0000,0000,,Бұл
Dialogue: 0,0:23:58.49,0:24:00.87,兔子日文,,0000,0000,0000,,Біраз тұрып қалды, бірақ жақсы ма?
Dialogue: 0,0:24:02.04,0:24:03.42,兔子日文,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:24:05.64,0:24:07.04,兔子日文,,0000,0000,0000,,Бұл менің кінәм
Dialogue: 0,0:24:14.59,0:24:18.13,兔子日文,,0000,0000,0000,,Бәлкім, әйтеуір жасырған дұрыс шығар.
Dialogue: 0,0:24:18.50,0:24:20.77,兔子日文,,0000,0000,0000,,Сау бол, Хару.
Dialogue: 0,0:24:21.55,0:24:24.12,兔子日文,,0000,0000,0000,,Бұл Хеджа болмайды
Dialogue: 0,0:24:36.66,0:24:38.58,兔子日文,,0000,0000,0000,,Жарайсың Хару
Dialogue: 0,0:24:38.58,0:24:39.54,兔子日文,,0000,0000,0000,,Иә
Dialogue: 0,0:25:56.72,0:25:59.11,兔子日文,,0000,0000,0000,,Котенканың құпия бөлмесі Нян
Dialogue: 0,0:25:59.11,0:26:02.41,兔子日文,,0000,0000,0000,,Сізге көп рахмет, Нян-нян
Dialogue: 0,0:26:02.41,0:26:03.60,兔子日文,,0000,0000,0000,,Мияу мияу
Dialogue: 0,0:26:06.16,0:26:07.67,兔子日文,,0000,0000,0000,,Үлкен аға
Dialogue: 0,0:26:07.67,0:26:09.96,兔子日文,,0000,0000,0000,,Котенканың құпия бөлмесі Нян
Dialogue: 0,0:26:09.96,0:26:12.59,兔子日文,,0000,0000,0000,,Данянға көп рахмет
Dialogue: 0,0:26:30.56,0:26:33.23,兔子日文,,0000,0000,0000,,Не? Бұл Хару ғой, солай ма?
Dialogue: 0,0:26:33.58,0:26:36.91,兔子日文,,0000,0000,0000,,Қайда жоғалып кеттің?
Dialogue: 0,0:26:36.91,0:26:40.46,兔子日文,,0000,0000,0000,,Курумимен қатты ұрысып қалғанымнан кейін солай болды.
Dialogue: 0,0:26:41.80,0:26:42.88,兔子日文,,0000,0000,0000,,Жоқ
Dialogue: 0,0:26:44.00,0:26:45.58,兔子日文,,0000,0000,0000,,Күте тұрыңыз, Рю-сан.
Dialogue: 0,0:26:52.55,0:26:57.55,兔子日文,,0000,0000,0000,,Хару, сенен бір сұрағым бар.
Dialogue: 0,0:26:57.55,0:26:59.65,兔子日文,,0000,0000,0000,,Мен тағы да барамын.
Dialogue: 0,0:26:59.65,0:27:00.56,兔子日文,,0000,0000,0000,,Рю мырза
Dialogue: 0,0:27:00.56,0:27:01.80,兔子日文,,0000,0000,0000,,Осы үшін оны мектептен шығарып жіберсе жақсы болар еді.
Dialogue: 0,0:27:00.89,0:27:02.74,兔子日文,,0000,0000,0000,,Рю осылай
Dialogue: 0,0:27:33.19,0:27:39.56,兔子日文,,0000,0000,0000,,Хару Курумиге зорлық көрсетті ме?
Dialogue: 0,0:27:42.43,0:27:44.59,兔子日文,,0000,0000,0000,,Мен оны ешқашан көрген емеспін
Dialogue: 0,0:27:45.02,0:27:47.87,兔子日文,,0000,0000,0000,,Бірақ мен оны адамдардан естідім.
Dialogue: 0,0:27:51.12,0:27:53.57,兔子日文,,0000,0000,0000,,Сіз ұрысып қалдыңыз ба?
Dialogue: 0,0:27:55.29,0:27:58.13,兔子日文,,0000,0000,0000,,Жарайды, сөйлесудің қажеті жоқ.
Dialogue: 0,0:28:06.97,0:28:08.44,兔子日文,,0000,0000,0000,,Рахмет
Dialogue: 0,0:28:10.16,0:28:11.37,兔子日文,,0000,0000,0000,,түймесі
Dialogue: 0,0:28:13.97,0:28:17.49,兔子日文,,0000,0000,0000,,Дүкеннің түймелерін рұқсатсыз саттым.
Dialogue: 0,0:28:23.84,0:28:25.37,兔子日文,,0000,0000,0000,,Оны неге рұқсатсыз саттың?
Dialogue: 0,0:28:25.37,0:28:28.51,兔子日文,,0000,0000,0000,,Өйткені сіз оларды сату ниетімен жинап жатқаныңызды айттыңыз.
Dialogue: 0,0:28:28.51,0:28:30.49,兔子日文,,0000,0000,0000,,Сондықтан да осында қойылған болуы мүмкін.
Dialogue: 0,0:28:30.49,0:28:33.51,兔子日文,,0000,0000,0000,,Сіз оны бұлай сатпауыңыз керек еді.
Dialogue: 0,0:28:33.51,0:28:36.13,兔子日文,,0000,0000,0000,,Хару мүлде түсінбейді
Dialogue: 0,0:28:38.42,0:28:41.82,兔子日文,,0000,0000,0000,,Әрине, дәмді болмауы мүмкін емес — рецептіні дәлме-дәл орындадым. Бұл дәл бір тәжірибе сияқты.
Dialogue: 0,0:28:45.69,0:28:46.48,兔子日文,,0000,0000,0000,,Корпус
Dialogue: 0,0:28:47.57,0:28:51.40,兔子日文,,0000,0000,0000,,Егер мен шағын дүкен ашсам, жақсы.
Dialogue: 0,0:28:51.40,0:28:53.75,兔子日文,,0000,0000,0000,,Сондықтан сіз қателесесіз.
Dialogue: 0,0:28:55.87,0:28:58.94,兔子日文,,0000,0000,0000,,Дүкенге келген адамдармен ғана жұмыс жасаңыз
Dialogue: 0,0:28:58.94,0:29:02.55,兔子日文,,0000,0000,0000,,Өз қолыңызбен жинаған әрбір затты жеткізіңіз.
Dialogue: 0,0:29:02.71,0:29:05.73,兔子日文,,0000,0000,0000,,Осындай нәрсемен қалай күн көресің?
Dialogue: 0,0:29:05.73,0:29:08.60,兔子日文,,0000,0000,0000,,Егер сізде ысырапшылдық болмаса, сіз әйтеуір жеңе аласыз.
Dialogue: 0,0:29:10.39,0:29:12.26,兔子日文,,0000,0000,0000,,Куруми түсінбейді
Dialogue: 0,0:29:12.26,0:29:14.74,兔子日文,,0000,0000,0000,,Ақшаның жоқтығы қандай сорлы
Dialogue: 0,0:29:14.74,0:29:15.79,兔子日文,,0000,0000,0000,,Жетеді
Dialogue: 0,0:29:15.79,0:29:16.99,兔子日文,,0000,0000,0000,,Буггарати мен басқалары шынында да осы пойызға мініпті
Dialogue: 0,0:29:16.99,0:29:19.29,兔子日文,,0000,0000,0000,,Мен Харудың ақымақтығын танымаймын
Dialogue: 0,0:29:26.15,0:29:30.19,兔子日文,,0000,0000,0000,,Адамдардың сезімін сандармен білдірсе жақсы болар еді.
Dialogue: 0,0:29:31.87,0:29:35.08,兔子日文,,0000,0000,0000,,Мен Куруми-санға сұмдық жасадым.
Dialogue: 0,0:29:36.60,0:29:37.80,兔子日文,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:29:39.67,0:29:42.89,兔子日文,,0000,0000,0000,,Бұл мен ойлағаннан әлдеқайда ауыр.
Dialogue: 0,0:29:44.88,0:29:50.76,兔子日文,,0000,0000,0000,,Мен Харудың шын азабын түсінбедім деп ойлаймын.
Dialogue: 0,0:29:56.80,0:30:00.23,兔子日文,,0000,0000,0000,,Кешіріңіз, мен сізді түсіндіре алмадым.
Dialogue: 0,0:30:11.46,0:30:14.99,兔子日文,,0000,0000,0000,,Мұғалім мен туралы білді ме?
Dialogue: 0,0:30:15.87,0:30:17.97,兔子日文,,0000,0000,0000,,Сіз нағыз Хару туралы айтып отырсыз ба?
Dialogue: 0,0:30:20.23,0:30:22.43,兔子日文,,0000,0000,0000,,Неше жыл болды?
Dialogue: 0,0:30:22.43,0:30:25.03,兔子日文,,0000,0000,0000,,Бұл өте өрескел болды.
Dialogue: 0,0:30:25.03,0:30:27.18,兔子日文,,0000,0000,0000,,Мен Рю деген жігітпен жүрмін.
Dialogue: 0,0:30:29.18,0:30:31.36,兔子日文,,0000,0000,0000,,Рю, сен бейбақ.
Dialogue: 0,0:30:31.36,0:30:34.94,兔子日文,,0000,0000,0000,,Олар бала кезінде заңсыз жұмыс орнында танысқан көрінеді.
Dialogue: 0,0:30:35.51,0:30:38.00,兔子日文,,0000,0000,0000,,Ақымақ, қателесесің.
Dialogue: 0,0:30:38.00,0:30:40.97,兔子日文,,0000,0000,0000,,Сен неге қызылды алып жатырсың?
Dialogue: 0,0:30:40.97,0:30:42.19,兔子日文,,0000,0000,0000,,Корпус
Dialogue: 0,0:30:41.42,0:30:43.36,兔子日文,,0000,0000,0000,,Мен саған мынаны ал деп айттым.
Dialogue: 0,0:30:43.36,0:30:44.44,兔子日文,,0000,0000,0000,,Рю
Dialogue: 0,0:30:44.44,0:30:46.79,兔子日文,,0000,0000,0000,,Ештеңе етпейді
Dialogue: 0,0:30:46.79,0:30:48.67,兔子日文,,0000,0000,0000,,Кел мені тауып ал.
Dialogue: 0,0:30:48.67,0:30:49.76,兔子日文,,0000,0000,0000,,Корпус
Dialogue: 0,0:30:49.76,0:30:51.26,兔子日文,,0000,0000,0000,,Корпус
Dialogue: 0,0:30:53.62,0:30:56.53,兔子日文,,0000,0000,0000,,Өзімшіл ештеңе жасамаңыз.
Dialogue: 0,0:30:57.94,0:31:00.66,兔子日文,,0000,0000,0000,,Ол жерден қашқан соң
Dialogue: 0,0:31:00.66,0:31:04.11,兔子日文,,0000,0000,0000,,Екеуі қолдарынан келгенін сатқан сияқты.
Dialogue: 0,0:31:05.03,0:31:07.72,兔子日文,,0000,0000,0000,,Менің ойымша, ол өзінше күрескен болуы керек.
Dialogue: 0,0:31:08.67,0:31:11.37,兔子日文,,0000,0000,0000,,Бірақ ол да жаман адам емес.
Dialogue: 0,0:31:11.37,0:31:14.15,兔子日文,,0000,0000,0000,,Маған Хару ұнады.
Dialogue: 0,0:31:14.94,0:31:16.04,兔子日文,,0000,0000,0000,,Иә
Dialogue: 0,0:31:16.74,0:31:19.27,兔子日文,,0000,0000,0000,,Сіз мұны жасадыңыз ба?
Dialogue: 0,0:31:19.27,0:31:23.59,兔子日文,,0000,0000,0000,,Неге, соларға дұрыстап бермедің бе?
Dialogue: 0,0:31:23.59,0:31:27.26,兔子日文,,0000,0000,0000,,Юката фестивальдерге барады
Dialogue: 0,0:31:28.24,0:31:29.98,兔子日文,,0000,0000,0000,,Фестиваль?
Dialogue: 0,0:31:29.98,0:31:31.80,兔子日文,,0000,0000,0000,,Бұл дұрыс.
Dialogue: 0,0:31:33.98,0:31:36.00,兔子日文,,0000,0000,0000,,Гион фестивалі
Dialogue: 0,0:31:36.00,0:31:37.83,兔子日文,,0000,0000,0000,,Иә, Джион фестивалі
Dialogue: 0,0:31:38.06,0:31:42.55,兔子日文,,0000,0000,0000,,Алысқа кеткен балалар жылдың осы мезгілінде қайтады.
Dialogue: 0,0:31:42.55,0:31:45.77,兔子日文,,0000,0000,0000,,Шиджо Каварамачиде күтпеген қайта ашу
Dialogue: 0,0:31:45.77,0:31:47.53,兔子日文,,0000,0000,0000,,Юката?
Dialogue: 0,0:31:47.53,0:31:50.44,兔子日文,,0000,0000,0000,,Қарғыс атқыр, мен қатты толқып тұрмын.
Dialogue: 0,0:31:52.16,0:31:55.26,兔子日文,,0000,0000,0000,,Бірақ Курумидің юката...
Dialogue: 0,0:31:55.26,0:31:59.52,兔子日文,,0000,0000,0000,,Куруми мен Токио-сан қарттан сұраңыз.
Dialogue: 0,0:31:59.92,0:32:02.64,兔子日文,,0000,0000,0000,,Юката фейерверк теңізі
Dialogue: 0,0:32:02.64,0:32:03.85,兔子日文,,0000,0000,0000,,Суға арналған киім
Dialogue: 0,0:32:16.98,0:32:18.57,兔子日文,,0000,0000,0000,,Рахмет
Dialogue: 0,0:32:19.27,0:32:23.03,兔子日文,,0000,0000,0000,,Олай болса бұл сенікі.
Dialogue: 0,0:32:24.03,0:32:25.20,兔子日文,,0000,0000,0000,,Маған
Dialogue: 0,0:32:25.52,0:32:28.86,兔子日文,,0000,0000,0000,,Куруми оны Харуға жеткізді.
Dialogue: 0,0:32:29.64,0:32:34.04,兔子日文,,0000,0000,0000,,Өрмекші торы ежелден зұлым рухтардан қорғайды деп айтылады.
Dialogue: 0,0:32:35.58,0:32:39.02,兔子日文,,0000,0000,0000,,Куруми Хару үшін алаңдады, солай ма?
Dialogue: 0,0:32:42.59,0:32:44.03,兔子日文,,0000,0000,0000,,Мен...
Dialogue: 0,0:32:44.03,0:32:46.52,兔子日文,,0000,0000,0000,,Хал жаман адам болды ма?
Dialogue: 0,0:32:49.53,0:32:54.26,兔子日文,,0000,0000,0000,,Баласының кесірінен қарызға батқан.
Dialogue: 0,0:32:55.95,0:32:58.53,兔子日文,,0000,0000,0000,,Жүрегім әлсіз болып тудым.
Dialogue: 0,0:32:58.53,0:33:01.06,兔子日文,,0000,0000,0000,,Ата-анам жүректі сатып алды
Dialogue: 0,0:33:04.17,0:33:06.83,兔子日文,,0000,0000,0000,,Қарызды өтей алмау
Dialogue: 0,0:33:06.83,0:33:09.95,兔子日文,,0000,0000,0000,,Ата-анасы Харуды тастап қашып кетті.
Dialogue: 0,0:33:10.81,0:33:14.59,兔子日文,,0000,0000,0000,,Кім кінәлі екенін білмеймін
Dialogue: 0,0:33:56.82,0:33:58.43,兔子日文,,0000,0000,0000,,Куруми мырза
Dialogue: 0,0:34:04.80,0:34:06.14,兔子日文,,0000,0000,0000,,Куруми-сан
Dialogue: 0,0:34:06.80,0:34:07.75,兔子日文,,0000,0000,0000,,Мынаны киіңіз...
Dialogue: 0,0:34:08.86,0:34:10.15,兔子日文,,0000,0000,0000,,Жақсы
Dialogue: 0,0:34:10.57,0:34:13.90,兔子日文,,0000,0000,0000,,Менімен бірге барғың келе ме? Джион фестивалі
Dialogue: 0,0:34:15.78,0:34:17.32,兔子日文,,0000,0000,0000,,Егер бұл мүмкін болмаса...
Dialogue: 0,0:34:21.43,0:34:23.70,兔子日文,,0000,0000,0000,,Оны маған кигізді.
Dialogue: 0,0:34:25.64,0:34:27.93,兔子日文,,0000,0000,0000,,Бұл Куруми-сан.
Dialogue: 0,0:34:27.93,0:34:29.46,兔子日文,,0000,0000,0000,,Сізге жақсы көрінеді
Dialogue: 0,0:34:31.16,0:34:32.66,兔子日文,,0000,0000,0000,,Куруми мырза
Dialogue: 0,0:34:32.66,0:34:35.10,兔子日文,,0000,0000,0000,,Сіз Харуға көмектескіңіз келді.
Dialogue: 0,0:34:40.09,0:34:42.39,兔子日文,,0000,0000,0000,,Неліктен көмектескіңіз келді?
Dialogue: 0,0:34:45.08,0:34:48.02,兔子日文,,0000,0000,0000,,Осы дүниенің бәрінен
Dialogue: 0,0:34:50.73,0:34:52.01,兔子日文,,0000,0000,0000,,Мен білемін
Dialogue: 0,0:34:52.60,0:34:56.08,兔子日文,,0000,0000,0000,,Ең қауіпті жұмысты адам жасайды.
Dialogue: 0,0:34:56.54,0:35:00.32,兔子日文,,0000,0000,0000,,Бірақ мектепте мұны роботтар жасайды деп айтылды.
Dialogue: 0,0:35:01.64,0:35:05.46,兔子日文,,0000,0000,0000,,Роботтарды пайдалану техникалық қызмет көрсету үшін ақшаны талап етеді.
Dialogue: 0,0:35:05.46,0:35:09.75,兔子日文,,0000,0000,0000,,Сондықтан олар мұны бір реттік адамдарға жасауға мүмкіндік береді.
Dialogue: 0,0:35:10.48,0:35:15.00,兔子日文,,0000,0000,0000,,Олар мен сияқты қарызға батқан адамдарды табады.
Dialogue: 0,0:35:16.96,0:35:21.29,兔子日文,,0000,0000,0000,,Адамдар ақшасы бар кезде мейірімдірек.
Dialogue: 0,0:35:21.81,0:35:24.24,兔子日文,,0000,0000,0000,,Бүкіл қала маған мейірімді.
Dialogue: 0,0:35:24.89,0:35:29.18,兔子日文,,0000,0000,0000,,Осылай мәңгі жасай алсаңыз қандай жақсы болар еді.
Dialogue: 0,0:35:36.44,0:35:39.12,兔子日文,,0000,0000,0000,,Жоқ, бұл баяғыда.
Dialogue: 0,0:35:39.12,0:35:40.01,兔子日文,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:35:40.01,0:35:41.86,兔子日文,,0000,0000,0000,,Менің әңгімем маңызды болды ма?
Dialogue: 0,0:35:41.86,0:35:43.04,兔子日文,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:35:43.04,0:35:45.00,兔子日文,,0000,0000,0000,,Өзіңізге ұнайтын нәрсені сатып алыңыз
Dialogue: 0,0:35:45.00,0:35:46.15,兔子日文,,0000,0000,0000,,Мен қазір барамын
Dialogue: 0,0:35:46.15,0:35:49.13,兔子日文,,0000,0000,0000,,Қараңдаршы, Курумидің сүйікті дүкені.
Dialogue: 0,0:35:52.25,0:35:54.54,兔子日文,,0000,0000,0000,,Сағыз Сағыз
Dialogue: 0,0:35:59.56,0:36:01.59,兔子日文,,0000,0000,0000,,Хару жарайды
Dialogue: 0,0:36:02.91,0:36:03.89,兔子日文,,0000,0000,0000,,Корпус
Dialogue: 0,0:36:36.89,0:36:37.90,兔子日文,,0000,0000,0000,,Кіріңіз
Dialogue: 0,0:36:52.25,0:36:55.03,兔子日文,,0000,0000,0000,,Бұл сол кездегі түйме
Dialogue: 0,0:36:57.50,0:37:03.19,兔子日文,,0000,0000,0000,,Мен мұны көргенде Харудың жүрегі деп ойладым.
Dialogue: 0,0:37:14.82,0:37:16.18,兔子日文,,0000,0000,0000,,Қозғалмай отырыңыз
Dialogue: 0,0:37:33.99,0:37:36.35,兔子日文,,0000,0000,0000,,Кешіріңіз, Хару.
Dialogue: 0,0:37:38.36,0:37:41.74,兔子日文,,0000,0000,0000,,Кешіріңіз, мен сізді түсіндіре алмадым.
Dialogue: 0,0:37:49.99,0:37:52.99,兔子日文,,0000,0000,0000,,Менімен мәңгі бірге боласыз
Dialogue: 0,0:37:54.30,0:37:55.57,兔子日文,,0000,0000,0000,,Бар
Dialogue: 0,0:37:55.96,0:37:57.19,兔子日文,,0000,0000,0000,,(Rodanse) Тыныш болыңыздар, өтінемін. (Bluebell) Ой!
Dialogue: 0,0:37:57.58,0:37:59.01,兔子日文,,0000,0000,0000,,Мәңгі және мәңгі
Dialogue: 0,0:38:24.24,0:38:26.78,兔子日文,,0000,0000,0000,,Ақ сызықтың артында қалыңыз
Dialogue: 0,0:38:27.92,0:38:29.51,兔子日文,,0000,0000,0000,,Ыстық
Dialogue: 0,0:38:28.81,0:38:31.06,兔子日文,,0000,0000,0000,,Артқа тағы бір қадам жасаңыз.
Dialogue: 0,0:38:31.06,0:38:32.23,兔子日文,,0000,0000,0000,,Иә
Dialogue: 0,0:38:34.28,0:38:36.40,兔子日文,,0000,0000,0000,,Рахмет
Dialogue: 0,0:38:42.22,0:38:45.29,兔子日文,,0000,0000,0000,,Хару-кун, жақсысың ба?
Dialogue: 0,0:38:46.05,0:38:49.01,兔子日文,,0000,0000,0000,,Мен де 50 жас кіші болсам ғой.
Dialogue: 0,0:38:49.18,0:38:51.39,兔子日文,,0000,0000,0000,,Әлі 40...
Dialogue: 0,0:38:56.34,0:38:58.68,兔子日文,,0000,0000,0000,,Міне, келдік
Dialogue: 0,0:39:26.97,0:39:30.87,兔子日文,,0000,0000,0000,,Мен мұны қанша рет қайталай аламын деп ойлаймын.
Dialogue: 0,0:40:21.08,0:40:23.52,兔子日文,,0000,0000,0000,,Бұл әдемі, Куруми-сан.
Dialogue: 0,0:40:26.40,0:40:28.25,兔子日文,,0000,0000,0000,,Рахмет сізге Хал
Dialogue: 0,0:40:39.66,0:40:41.50,兔子日文,,0000,0000,0000,,Тым көп қарамаңыз
Dialogue: 0,0:40:43.40,0:40:44.64,兔子日文,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:42:58.18,0:43:00.55,兔子日文,,0000,0000,0000,,Хару-кун
Dialogue: 0,0:43:06.46,0:43:08.28,兔子日文,,0000,0000,0000,,Қалайсың, Хару?
Dialogue: 0,0:43:14.51,0:43:17.68,兔子日文,,0000,0000,0000,,Біз ақша жоғалттық.
Dialogue: 0,0:43:17.68,0:43:20.67,兔子日文,,0000,0000,0000,,Сізге бұл тесікті толтыру қиынға соғады, солай емес пе?
Dialogue: 0,0:43:20.67,0:43:24.66,兔子日文,,0000,0000,0000,,Сондықтан мен ынтымақтастықты қалаймын.
Dialogue: 0,0:43:25.69,0:43:28.76,兔子日文,,0000,0000,0000,,Сонымен, сіз де бір кесек тістедіңіз.
Dialogue: 0,0:43:33.47,0:43:34.90,兔子日文,,0000,0000,0000,,Оны сатайық
Dialogue: 0,0:43:38.70,0:43:40.11,兔子日文,,0000,0000,0000,,Барайық Хару
Dialogue: 0,0:43:57.96,0:43:58.94,兔子日文,,0000,0000,0000,,Корпус
Dialogue: 0,0:44:55.77,0:44:57.09,兔子日文,,0000,0000,0000,,Куруми мырза
Dialogue: 0,0:45:08.30,0:45:09.62,兔子日文,,0000,0000,0000,,Куруми мырза
Dialogue: 0,0:45:10.03,0:45:11.26,兔子日文,,0000,0000,0000,,Куруми мырза
Dialogue: 0,0:45:23.39,0:45:24.65,兔子日文,,0000,0000,0000,,Куруми мырза
Dialogue: 0,0:45:31.93,0:45:33.06,兔子日文,,0000,0000,0000,,оны қалай қолдануыңа байланысты адамдарға көмектесе алады.
Dialogue: 0,0:45:33.06,0:45:35.17,兔子日文,,0000,0000,0000,,Маған оны сатуға рұқсат етіңіз.
Dialogue: 0,0:45:39.95,0:45:41.43,兔子日文,,0000,0000,0000,,Куруми-сан
Dialogue: 0,0:45:41.88,0:45:44.12,兔子日文,,0000,0000,0000,,Куруми мырзаға тиіспеңіз
Dialogue: 0,0:45:44.12,0:45:46.33,兔子日文,,0000,0000,0000,,Не болды, Хал?
Dialogue: 0,0:45:46.33,0:45:47.74,兔子日文,,0000,0000,0000,,Тіпті сен де
Dialogue: 0,0:45:48.33,0:45:49.98,兔子日文,,0000,0000,0000,,Есте сақта
Dialogue: 0,0:45:51.90,0:45:55.08,兔子日文,,0000,0000,0000,,Осылай қашанға дейін тұрасың?
Dialogue: 0,0:46:01.23,0:46:04.02,兔子日文,,0000,0000,0000,,Осындай нәрсемен қалай күн көресің?
Dialogue: 0,0:46:04.02,0:46:06.75,兔子日文,,0000,0000,0000,,Егер сіз еріксіз болсаңыз, сіз өте аласыз.
Dialogue: 0,0:46:06.75,0:46:09.01,兔子日文,,0000,0000,0000,,Куруми түсінбейді
Dialogue: 0,0:46:09.01,0:46:11.07,兔子日文,,0000,0000,0000,,Ақшаның жоқтығы қандай сорлы
Dialogue: 0,0:46:11.07,0:46:12.22,兔子日文,,0000,0000,0000,,Жетеді
Dialogue: 0,0:46:12.22,0:46:13.36,兔子日文,,0000,0000,0000,,Буггарати мен басқалары шынында да осы пойызға мініпті
Dialogue: 0,0:46:13.36,0:46:15.66,兔子日文,,0000,0000,0000,,Мен Харудың ақымақтығын танымаймын
Dialogue: 0,0:46:16.41,0:46:17.49,兔子日文,,0000,0000,0000,,18-ші эпизод: Венецияға!
Dialogue: 0,0:46:18.70,0:46:19.91,兔子日文,,0000,0000,0000,,Жаңғақ
Dialogue: 0,0:46:22.33,0:46:24.19,兔子日文,,0000,0000,0000,,Олай болса өз қалауыңызша жасаңыз.
Dialogue: 0,0:46:37.56,0:46:38.55,兔子日文,,0000,0000,0000,,Корпус
Dialogue: 0,0:46:38.89,0:46:40.28,兔子日文,,0000,0000,0000,,Корпус
Dialogue: 0,0:47:04.12,0:47:05.40,兔子日文,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:47:05.40,0:47:07.98,兔子日文,,0000,0000,0000,,Неліктен бірге болмадыңыз?
Dialogue: 0,0:47:07.98,0:47:12.18,兔子日文,,0000,0000,0000,,Егер біз бірге болсақ, бірдеңе істей алар едік.
Dialogue: 0,0:47:13.89,0:47:15.77,兔子日文,,0000,0000,0000,,Бұл орындалмады.
Dialogue: 0,0:47:16.02,0:47:19.11,兔子日文,,0000,0000,0000,,Мұны істеуге болатын еді.
Dialogue: 0,0:47:24.42,0:47:25.95,兔子日文,,0000,0000,0000,,Жаңғақ
Dialogue: 0,0:47:25.95,0:47:27.52,兔子日文,,0000,0000,0000,,Жаңғақ
Dialogue: 0,0:47:27.92,0:47:29.63,兔子日文,,0000,0000,0000,,Білесің бе, Хал.
Dialogue: 0,0:47:29.63,0:47:30.91,兔子日文,,0000,0000,0000,,Жаңғақ
Dialogue: 0,0:47:30.91,0:47:32.28,兔子日文,,0000,0000,0000,,Жаңғақ
Dialogue: 0,0:47:32.85,0:47:34.87,兔子日文,,0000,0000,0000,,Бұл жаңғақ.
Dialogue: 0,0:47:35.31,0:47:37.29,兔子日文,,0000,0000,0000,,Жаңғақ өлді
Dialogue: 0,0:47:37.97,0:47:40.28,兔子日文,,0000,0000,0000,,Жаңғақ жақсы
Dialogue: 0,0:47:42.07,0:47:43.34,兔子日文,,0000,0000,0000,,Жаңғақ
Dialogue: 0,0:47:44.42,0:47:45.85,兔子日文,,0000,0000,0000,,Бірақ мұндағы олардың ойып жазғандары ұзақ уақыттан бері ұмыт қалды, және мұнда енді дұғалар айтылмайды.
Dialogue: 0,0:47:51.86,0:47:53.16,兔子日文,,0000,0000,0000,,Бұл өтірік
Dialogue: 0,0:47:53.64,0:47:55.13,兔子日文,,0000,0000,0000,,Корпус
Dialogue: 0,0:48:25.62,0:48:30.11,兔子日文,,0000,0000,0000,,Сіз өзіңізді роботпын деп ойлайтын сияқтысыз.
Dialogue: 0,0:48:31.39,0:48:36.72,兔子日文,,0000,0000,0000,,Шындықты қабылдау тым қатал болуы мүмкін.
Dialogue: 0,0:48:38.95,0:48:41.91,兔子日文,,0000,0000,0000,,Сіз бұл туралы бірдеңе істей алмайсыз ба?
Dialogue: 0,0:48:44.51,0:48:48.76,兔子日文,,0000,0000,0000,,Оған дәл қазір ең керек нәрсе - Куруми.
Dialogue: 0,0:48:49.79,0:48:51.86,兔子日文,,0000,0000,0000,,Мен мұны білемін.
Dialogue: 0,0:48:52.20,0:48:53.34,兔子日文,,0000,0000,0000,,Дегенмен
Dialogue: 0,0:48:55.62,0:48:58.46,兔子日文,,0000,0000,0000,,Бұл әлі кең таралған емес.
Dialogue: 0,0:48:58.46,0:49:01.19,兔子日文,,0000,0000,0000,,Робот терапиясы деген нәрсе бар.
Dialogue: 0,0:49:15.83,0:49:17.28,兔子日文,,0000,0000,0040,,Q01
Dialogue: 0,0:49:18.00,0:49:20.68,兔子日文,,0000,0000,0000,,Сол балаға көмектесіңізші.
Dialogue: 0,0:49:22.68,0:49:25.09,兔子日文,,0000,0000,0000,,Сіз ол жігіт бола аласыз
Dialogue: 0,0:49:28.07,0:49:29.75,兔子日文,,0000,0000,0000,,Сол адам болыңыз
Dialogue: 0,0:49:29.75,0:49:32.26,兔子日文,,0000,0000,0000,,Сол балаға көмектесіңізші.
Dialogue: 0,0:50:09.96,0:50:11.17,兔子日文,,0000,0000,0000,,Жаңғақ
Dialogue: 0,0:50:16.77,0:50:17.84,兔子日文,,0000,0000,0000,,Жаңғақ
Dialogue: 0,0:50:23.28,0:50:25.36,兔子日文,,0000,0000,0000,,Барлығы мейірімді.
Dialogue: 0,0:50:26.01,0:50:30.19,兔子日文,,0000,0000,0000,,Мен Курумимен кездескендіктен, мен оны уақытында жасағандай сезінемін.
Dialogue: 0,0:50:34.30,0:50:39.70,兔子日文,,0000,0000,0000,,Өткенде азап шеккен не осы сәтке байланысты?
Dialogue: 0,0:50:41.04,0:50:44.31,兔子日文,,0000,0000,0000,,Менің ойымша, бұл жақсы болды.
Dialogue: 0,0:50:45.92,0:50:48.43,兔子日文,,0000,0000,0000,,Курумимен осылай танысқан болсаңыз
Dialogue: 0,0:50:48.93,0:50:50.96,兔子日文,,0000,0000,0000,,Жаман оқиғаны басынан өткеру
Dialogue: 0,0:50:51.44,0:50:54.84,兔子日文,,0000,0000,0000,,Енді бәрі жақсы болды деп ойлаймын.
Dialogue: 0,0:50:57.22,0:50:58.39,兔子日文,,0000,0000,0000,,Жаңғақ
Dialogue: 0,0:51:21.98,0:51:23.21,兔子日文,,0000,0000,0000,,Жаңғақ
Dialogue: 0,0:51:29.78,0:51:31.64,兔子日文,,0000,0000,0000,,Жоқ, Куруми.
Dialogue: 0,0:51:32.73,0:51:34.45,兔子日文,,0000,0000,0000,,Барма
Dialogue: 0,0:51:53.44,0:51:56.35,兔子日文,,0000,0000,0000,,Жаңғақ
Dialogue: 0,0:52:15.36,0:52:16.31,兔子日文,,0000,0000,0000,,Корпус
Dialogue: 0,0:52:16.31,0:52:17.59,兔子日文,,0000,0000,0000,,Сендердің міндетің не, көпшілік?
Dialogue: 0,0:52:24.20,0:52:25.12,兔子日文,,0000,0000,0000,,Жаңғақ
Dialogue: 0,0:52:25.12,0:52:26.13,兔子日文,,0000,0000,0000,,18-ші эпизод: Венецияға!
Dialogue: 0,0:52:26.13,0:52:28.47,兔子日文,,0000,0000,0000,,Хал, барма.
Dialogue: 0,0:52:30.06,0:52:33.10,兔子日文,,0000,0000,0000,,Өтінемін, барма.
Dialogue: 0,0:52:36.86,0:52:38.20,兔子日文,,0000,0000,0000,,Себебі мен түсінемін
Dialogue: 0,0:52:38.77,0:52:40.54,兔子日文,,0000,0000,0000,,Себебі мен білемін
Dialogue: 0,0:52:40.54,0:52:41.95,兔子日文,,0000,0000,0000,,Мен сізден өтінемін
Dialogue: 0,0:52:43.02,0:52:45.74,兔子日文,,0000,0000,0000,,Хал, өмір сүр.
Dialogue: 0,0:53:53.60,0:53:58.17,兔子日文,,0000,0000,0000,,Адамдар өлгенде қайда барады?
Dialogue: 0,0:54:01.16,0:54:03.61,兔子日文,,0000,0000,0000,,Мен ешқайда бармаймын
Dialogue: 0,0:54:04.15,0:54:07.09,兔子日文,,0000,0000,0000,,Әрқашан біздің қасымызда
Dialogue: 0,0:54:08.60,0:54:11.06,兔子日文,,0000,0000,0000,,Мен үнемі сөйлесемін
Dialogue: 0,0:54:12.16,0:54:14.68,兔子日文,,0000,0000,0000,,«Бүгін ыстық»
Dialogue: 0,0:54:14.68,0:54:17.69,兔子日文,,0000,0000,0000,,«Қараңдаршы, бұл әдемі».
Dialogue: 0,0:54:18.87,0:54:21.37,兔子日文,,0000,0000,0000,,Бұл жеке әңгіме емес пе?
Dialogue: 0,0:54:22.15,0:54:23.84,兔子日文,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:54:23.84,0:54:25.62,兔子日文,,0000,0000,0000,,Олай айтпа.
Dialogue: 0,0:55:29.10,0:55:30.19,兔子日文,,0000,0000,0000,,Корпус
Dialogue: 0,0:55:31.20,0:55:37.02,兔子日文,,0000,0000,0000,,Бүгін кешке кемпірлерге қамқорлық жасай аласыз ба?
Dialogue: 0,0:55:37.36,0:55:41.42,兔子日文,,0000,0000,0000,,Бүгін түстен кейін кенеттен кетуге тура келді.
Dialogue: 0,0:55:42.95,0:55:45.02,兔子日文,,0000,0000,0000,,Иә, бұл жаман.
Dialogue: 0,0:55:45.30,0:55:47.17,兔子日文,,0000,0000,0000,,Жарайды, мен сұрадым.
Dialogue: 0,0:56:08.95,0:56:10.54,兔子日文,,0000,0000,0000,,Itadadakimasu
Dialogue: 0,0:56:39.70,0:56:40.99,兔子日文,,0000,0000,0000,,Бұл дәмді
Dialogue: 0,0:56:40.99,0:56:42.10,兔子日文,,0000,0000,0000,,Жаңғақ
Dialogue: 0,0:56:42.74,0:56:48.19,歌詞,,0000,0000,0000,,Сөзбен айтып жеткізе алмаймын
Dialogue: 0,0:56:48.19,0:56:52.84,歌詞,,0000,0000,0000,,Сенімен өткізген күндерім
Dialogue: 0,0:56:52.84,0:56:56.26,歌詞,,0000,0000,0000,,Мен өте қуаныштымын
Dialogue: 0,0:56:56.49,0:57:01.36,歌詞,,0000,0000,0000,,Мен саған
Dialogue: 0,0:57:01.52,0:57:07.53,歌詞,,0000,0000,0000,,Менің қолымнан ештеңе келмесе де
Dialogue: 0,0:57:08.61,0:57:15.70,歌詞,,0000,0000,0000,,Мен құлайын деп тұрған қолым
Dialogue: 0,0:57:15.98,0:57:26.10,歌詞,,0000,0000,0000,,Мен сіздің ыстық температураңызды қазір де ұмытпаймын
Dialogue: 0,0:57:26.52,0:57:33.82,歌詞,,0000,0000,0000,,Сенсіз бұл дүниеде де
Dialogue: 0,0:57:33.82,0:57:39.51,歌詞,,0000,0000,0000,,Басынан білмей ұйықтап қалсаң
Dialogue: 0,0:57:39.51,0:57:48.25,歌詞,,0000,0000,0000,,Көзіңізді жұмған бойда естеліктеріңіз
Dialogue: 0,0:57:48.38,0:57:52.67,歌詞,,0000,0000,0000,,Оны қазір сезінген дұрыс
Dialogue: 0,0:57:52.67,0:57:55.75,歌詞,,0000,0000,0000,,Бір-бірімізден алшақ болсақ та
Dialogue: 0,0:57:55.75,0:57:58.92,歌詞,,0000,0000,0000,,Кездесе алмасақ та
Dialogue: 0,0:57:58.92,0:58:04.22,歌詞,,0000,0000,0000,,Бұл жүрек сені ойлайды
Dialogue: 0,0:58:04.22,0:58:07.78,歌詞,,0000,0000,0000,,Мен сені бақылап отырмын.
Dialogue: 0,0:58:07.81,0:58:10.65,歌詞,,0000,0000,0000,,Кез келген уақытта
Dialogue: 0,0:58:10.65,0:58:15.95,歌詞,,0000,0000,0000,,Мені ойласаң
Dialogue: 0,0:58:15.95,0:58:19.77,歌詞,,0000,0000,0000,,Миямура-кун, сен өте сүйкімдісің!
Dialogue: 0,0:58:24.79,0:58:32.18,歌詞,,0000,0000,0000,,Сенсіз бұл дүниеде де
Dialogue: 0,0:58:32.18,0:58:37.97,歌詞,,0000,0000,0000,,Басынан білмей ұйықтап қалсаң
Dialogue: 0,0:58:37.97,0:58:46.37,歌詞,,0000,0000,0000,,Көзіңізді жұмған бойда естеліктеріңіз
Dialogue: 0,0:58:46.37,0:58:50.91,歌詞,,0000,0000,0000,,Оны қазір сезінген дұрыс
Dialogue: 0,0:58:50.91,0:58:58.16,歌詞,,0000,0000,0000,,Менсіз бұл дүниеде де
Dialogue: 0,0:58:58.16,0:59:03.85,歌詞,,0000,0000,0000,,Бақытты болу үшін
Dialogue: 0,0:59:03.85,0:59:12.59,歌詞,,0000,0000,0000,,Мен керек болсам
Dialogue: 0,0:59:12.67,0:59:25.71,歌詞,,0000,0000,0000,,Күлімсіреп саған қарап тұрамын.
Dialogue: 0,0:59:27.21,0:59:33.21,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory