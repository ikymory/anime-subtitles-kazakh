Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:52.96,0:00:56.84,Default,,0,0,0,,Ақырында бізде маңызды түсінік бар.
Dialogue: 0,0:00:59.51,0:01:02.52,Default,,0,0,0,,Біз анықтағанша уақыт мәселесі
Dialogue: 0,0:01:02.64,0:01:04.02,Default,,0,0,0,,О!
Dialogue: 0,0:01:04.14,0:01:05.19,Default,,0,0,0,,Жарайды, мен оны сатып аламын.
Dialogue: 0,0:01:05.31,0:01:06.23,Default,,0,0,0,,Жоқ, I
Dialogue: 0,0:01:06.35,0:01:09.06,Default,,0,0,0,,Бірінші сатып алуға құқығым бар.
Dialogue: 0,0:01:09.19,0:01:10.11,Default,,0,0,0,,Иә
Dialogue: 0,0:01:12.40,0:01:16.03,Default,,0,0,0,,Балалар, алдымен мынаны қарап алыңдар.
Dialogue: 0,0:01:19.95,0:01:21.28,Default,,0,0,0,,Уау
Dialogue: 0,0:01:25.29,0:01:27.21,Default,,0,0,0,,О...
Dialogue: 0,0:01:27.33,0:01:28.63,Default,,0,0,0,,Міне!
Dialogue: 0,0:01:28.96,0:01:29.71,Default,,0,0,0,,Қош бол
Dialogue: 0,0:01:29.79,0:01:33.96,Default,,0,0,0,,Ең жоғары баға берген адамға беремін.
Dialogue: 0,0:01:35.42,0:01:39.89,Default,,0,0,0,,Ғажайыптар аралында тіршілік ететін алтын қоңыз.
Dialogue: 0,0:01:42.51,0:01:45.85,Default,,0,0,0,,Алтын Геркулес!
Dialogue: 0,0:02:02.83,0:02:05.83,Default,,0,0,0,,Хмм... хахахаха
Dialogue: 0,0:02:06.37,0:02:09.42,Default,,0,0,0,,Рахмет, папа Кабуто, мен мұны қаладым.
Dialogue: 0,0:02:09.54,0:02:13.29,Default,,0,0,0,,Эй, Нобита, бұл жолы дұрыстап істе.
Dialogue: 0,0:02:13.42,0:02:15.55,Default,,0,0,0,,Не? Не айтқың келеді?
Dialogue: 0,0:02:15.67,0:02:18.26,Default,,0,0,0,,Бір жыл бұрын сатып алған алтын балыққа да солай.
Dialogue: 0,0:02:19.55,0:02:21.47,Default,,0,0,0,,Сіз мұнымен айналысамын дедіңіз...
Dialogue: 0,0:02:21.59,0:02:25.18,Default,,0,0,0,,Соңында бұл ана мен Дораемонға байланысты.
Dialogue: 0,0:02:25.52,0:02:26.43,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:28.23,0:02:30.98,Default,,0,0,0,,Бұл жолы жақсы
Dialogue: 0,0:02:31.10,0:02:32.77,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:02:32.90,0:02:34.07,Default,,0,0,0,,Иә
Dialogue: 0,0:02:34.73,0:02:35.61,Default,,0,0,0,,Хмм...
Dialogue: 0,0:02:36.65,0:02:38.53,Default,,0,0,0,,Сәлем Нобита
Dialogue: 0,0:02:38.74,0:02:42.45,Default,,0,0,0,,Сіз әрқашан ана мен Дораемонға сенесіз
Dialogue: 0,0:02:42.57,0:02:44.70,Default,,0,0,0,,Бұл аянышты емес пе?
Dialogue: 0,0:02:44.83,0:02:45.83,Default,,0,0,0,,Ах
Dialogue: 0,0:02:46.24,0:02:50.08,Default,,0,0,0,,Оны өз бетіңізше сынап көргіңіз келмейді ме?
Dialogue: 0,0:02:50.21,0:02:51.79,Default,,0,0,0,,Әрқашан басқаларға сенбеу —
Dialogue: 0,0:02:52.17,0:02:55.00,Default,,0,0,0,,Қанша уақыт өтсе де мен толыққанды адам бола алмаймын.
Dialogue: 0,0:02:57.88,0:03:01.26,Default,,0,0,0,,Біріншіден, орындай алмайтын уәделерді бермеңіз.
Dialogue: 0,0:03:01.76,0:03:04.35,Default,,0,0,0,,Сіз солай ойлайсыз ба? Нобита
Dialogue: 0,0:03:05.05,0:03:06.10,Default,,0,0,0,,Иә
Dialogue: 0,0:03:06.72,0:03:10.39,Default,,0,0,0,,Хахахаха Солай болса да ыстық.
Dialogue: 0,0:03:10.52,0:03:12.98,Default,,0,0,0,,Балмұздақ алуға барайық па?
Dialogue: 0,0:03:13.10,0:03:15.23,Default,,0,0,0,,Мен сені жақсы көремін, иә?
Dialogue: 0,0:03:15.36,0:03:16.36,Default,,0,0,0,,Тек қарап тұр.
Dialogue: 0,0:03:18.36,0:03:20.32,Default,,0,0,0,,Жарайды, мен уәде беремін.
Dialogue: 0,0:03:20.99,0:03:22.86,Default,,0,0,0,,♪Саусақпен кесу Генман
Dialogue: 0,0:03:22.99,0:03:28.12,Default,,0,0,0,,♪Өтірік айтсаң, мың ине ішемін.
Dialogue: 0,0:03:40.55,0:03:42.38,Default,,0,0,0,,Жарайды, жүр! (Балалар қолдайды)
Dialogue: 0,0:03:42.51,0:03:43.51,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:43.80,0:03:45.09,Default,,0,0,0,,Не?
Dialogue: 0,0:03:45.22,0:03:46.72,Default,,0,0,0,,О, қате сумо?
Dialogue: 0,0:03:47.06,0:03:49.64,Default,,0,0,0,,Иә? Бұл ностальгия
Dialogue: 0,0:03:49.77,0:03:51.73,Default,,0,0,0,,Әкем мұны жақсы білетін.
Dialogue: 0,0:03:51.85,0:03:52.69,Default,,0,0,0,,Иә?
Dialogue: 0,0:03:55.73,0:03:59.57,Default,,0,0,0,,Катая Кабута Кабута
Dialogue: 0,0:03:59.69,0:04:00.53,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:04:00.65,0:04:05.57,Default,,0,0,0,,Коната Кабутодаке Кабутодаке
Dialogue: 0,0:04:06.37,0:04:07.45,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:04:07.58,0:04:10.16,Default,,0,0,0,,Дауысты қатты шығарайық
Dialogue: 0,0:04:11.16,0:04:12.87,Default,,0,0,0,,Қолыңнан келгенін істе, Кабута
Dialogue: 0,0:04:13.37,0:04:16.08,Default,,0,0,0,,Хаккейой кетіп қалды
Dialogue: 0,0:04:16.21,0:04:18.54,Default,,0,0,0,,қалды
Dialogue: 0,0:04:19.00,0:04:21.51,Default,,0,0,0,,Кабута, жүр, алға.
Dialogue: 0,0:04:22.72,0:04:25.80,Default,,0,0,0,,Қалды қалды қалды
Dialogue: 0,0:04:25.93,0:04:28.18,Default,,0,0,0,,Кабута! Алдыңғы Алдыңғы
Dialogue: 0,0:04:28.30,0:04:30.81,Default,,0,0,0,,(Қыздар қолдайды)
Dialogue: 0,0:04:30.93,0:04:32.93,Default,,0,0,0,,Жүр! Осымен (Сунео) қалды!
Dialogue: 0,0:04:33.06,0:04:35.81,Default,,0,0,0,,Қалды қалды қалды
Dialogue: 0,0:04:35.94,0:04:37.98,Default,,0,0,0,,Жүр! Бар! (Сунео) қалды
Dialogue: 0,0:04:38.36,0:04:39.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:39.48,0:04:41.28,Default,,0,0,0,,(Ұлдардың күлкісі)
Dialogue: 0,0:04:41.40,0:04:43.28,Default,,0,0,0,,Кабутодаке
Dialogue: 0,0:04:43.40,0:04:46.41,Default,,0,0,0,,Ухаха, әділдік міндетті түрде жеңеді.
Dialogue: 0,0:04:47.03,0:04:49.08,Default,,0,0,0,,Сіз қалай ойлайсыз? Нобита келді ме?
Dialogue: 0,0:04:49.20,0:04:51.20,Default,,0,0,0,,Мүлде жоқ
Dialogue: 0,0:04:51.33,0:04:53.87,Default,,0,0,0,,Ухехехехе Өте жақсы.
Dialogue: 0,0:04:54.12,0:04:56.33,Default,,0,0,0,,Жүр! Кабута Жарайды
Dialogue: 0,0:04:56.87,0:04:58.42,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,0:04:58.54,0:05:00.84,Default,,0,0,0,,Бұл мүмкін емес, Шизука-кун, иә?
Dialogue: 0,0:05:01.17,0:05:05.26,Default,,0,0,0,,Мен Ноби-кун үшін ренжідім, бірақ физикалық күштегі бұл айырмашылықты айтып жеткізу мүмкін емес.
Dialogue: 0,0:05:05.38,0:05:07.51,Default,,0,0,0,,Кабутаның жеңу мүмкіндігі жоқ.
Dialogue: 0,0:05:07.64,0:05:09.76,Default,,0,0,0,,Жоғалтпа, Кабута! Уф
Dialogue: 0,0:05:09.89,0:05:10.89,Default,,0,0,0,,Ах
Dialogue: 0,0:05:11.01,0:05:14.02,Default,,0,0,0,,Әлі жоқ, келесі жолы
Dialogue: 0,0:05:16.81,0:05:18.15,Default,,0,0,0,,Не? Уау
Dialogue: 0,0:05:18.31,0:05:20.40,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:05:20.52,0:05:22.86,Default,,0,0,0,,Айтпақшы, Нобитаның Кабуто...
Dialogue: 0,0:05:22.98,0:05:25.03,Default,,0,0,0,,Вокзал алдындағы супермаркетте сатылмады ма?
Dialogue: 0,0:05:25.15,0:05:27.78,Default,,0,0,0,,Ол (Сунео) 300 иенге сатылды.
Dialogue: 0,0:05:28.07,0:05:30.70,Default,,0,0,0,,Жоқ! Бұл бар болғаны 350 иен!
Dialogue: 0,0:05:30.83,0:05:32.79,Default,,0,0,0,,Бұл таңқаларлық (Папа Нобита) Хамф
Dialogue: 0,0:05:32.91,0:05:34.75,Default,,0,0,0,,Қалай болғанда да, бұл арзан.
Dialogue: 0,0:05:34.87,0:05:35.87,Default,,0,0,0,,Жоқ! (Декисуги) Әй...
Dialogue: 0,0:05:36.00,0:05:39.33,Default,,0,0,0,,Хахаха, сондай арзан дулыға...
Dialogue: 0,0:05:39.46,0:05:41.50,Default,,0,0,0,,Менің Кабутомен жарысуға қалай дәтің бардың?
Dialogue: 0,0:05:41.63,0:05:43.88,Default,,0,0,0,,Чунчара біртүрлі екен
Dialogue: 0,0:05:44.30,0:05:46.13,Default,,0,0,0,,Нобита! Бұл ойыншының ауысуы
Dialogue: 0,0:05:46.42,0:05:47.63,Default,,0,0,0,,Жүр! Нобита
Dialogue: 0,0:05:47.76,0:05:49.22,Default,,0,0,0,,Бұл Кабута, әке.
Dialogue: 0,0:05:49.34,0:05:51.68,Default,,0,0,0,,Сәттілік! Нобита! (Нобита) Тіпті Кабута
Dialogue: 0,0:05:51.80,0:05:53.31,Default,,0,0,0,,Хмм, а... (Нобита) Әке!
Dialogue: 0,0:05:53.64,0:05:54.27,Default,,0,0,0,,Амансың ба? әке
Dialogue: 0,0:05:54.27,0:05:56.10,Default,,0,0,0,,Амансың ба? әке
Dialogue: 0,0:05:54.27,0:05:56.10,Default,,0,0,0,,(Балалардың күлкісі)
Dialogue: 0,0:05:56.23,0:05:58.10,Default,,0,0,0,,Кабутодаке
Dialogue: 0,0:05:58.23,0:05:59.52,Default,,0,0,0,,Оңай жеңіс Оңай жеңіс
Dialogue: 0,0:05:59.85,0:06:02.44,Default,,0,0,0,,Хахаха... берілу.
Dialogue: 0,0:06:02.57,0:06:03.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:03.52,0:06:06.24,Default,,0,0,0,,Кішкентай болғандықтан көмектесу мүмкін емес
Dialogue: 0,0:06:06.78,0:06:10.53,Default,,0,0,0,,Оның үстіне Кабута одан да көп нәрсе жасаса, мен оған қатты өкінемін.
Dialogue: 0,0:06:10.66,0:06:11.57,Default,,0,0,0,,Иә
Dialogue: 0,0:06:11.70,0:06:14.04,Default,,0,0,0,,Онда мен бірінші үйге барамын (Нобита) А...
Dialogue: 0,0:06:14.95,0:06:16.29,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:06:16.41,0:06:19.79,Default,,0,0,0,,Барлығы, ыстық соққыдан сақ болыңдар. Жарайды онда.
Dialogue: 0,0:06:19.92,0:06:22.92,Default,,0,0,0,,Сәлем, қош бол
Dialogue: 0,0:06:23.04,0:06:23.88,Default,,0,0,0,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:06:26.46,0:06:27.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:27.55,0:06:29.38,Default,,0,0,0,,♪Нобита
Dialogue: 0,0:06:29.51,0:06:32.10,Default,,0,0,0,,♪Әкең (Сунео) ♪ Ол қашып кетті.
Dialogue: 0,0:06:33.51,0:06:35.47,Default,,0,0,0,,♪Нобитаның әкесі Нобитаға ұқсайды
Dialogue: 0,0:06:35.60,0:06:39.27,Default,,0,0,0,,♪Менің әкем ерке
Dialogue: 0,0:06:39.52,0:06:41.40,Default,,0,0,0,,♪Кабуто да, Папа да әлсіз.
Dialogue: 0,0:06:41.52,0:06:42.81,Default,,0,0,0,,♪ Хохо (Сунео/Джиан) ♪ Ия
Dialogue: 0,0:06:42.90,0:06:43.40,Default,,0,0,0,,(Ұлдардың күлкісі)
Dialogue: 0,0:06:43.40,0:06:44.57,Default,,0,0,0,,(Ұлдардың күлкісі)
Dialogue: 0,0:06:43.40,0:06:44.57,Default,,0,0,0,,Енді екеуміз тоқтаймыз ба?
Dialogue: 0,0:06:44.57,0:06:45.40,Default,,0,0,0,,Енді екеуміз тоқтаймыз ба?
Dialogue: 0,0:06:45.53,0:06:47.49,Default,,0,0,0,,Иә, мен сені аяймын.
Dialogue: 0,0:06:47.61,0:06:49.45,Default,,0,0,0,,♪Ариаряноря
Dialogue: 0,0:06:49.57,0:06:51.07,Default,,0,0,0,,♪Мен сені аядым
Dialogue: 0,0:06:51.20,0:06:52.74,Default,,0,0,0,,(Сунео мен Джианның күлкісі)
Dialogue: 0,0:06:52.87,0:06:55.62,Default,,0,0,0,,Хэхе (Сунео) Бұл жақсы емес.
Dialogue: 0,0:07:00.75,0:07:04.84,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:07:04.96,0:07:09.97,Default,,0,0,0,,♪～
Dialogue: 0,0:08:23.37,0:08:28.38,Default,,0,0,0,,～♪
Dialogue: 0,0:08:29.25,0:08:30.80,Default,,0,0,0,,Уау! иә?
Dialogue: 0,0:08:31.05,0:08:33.09,Default,,0,0,0,,Мені... қайда апарыңыз?
Dialogue: 0,0:08:33.22,0:08:34.55,Default,,0,0,0,,Таулардың тереңінде!
Dialogue: 0,0:08:34.68,0:08:35.72,Default,,0,0,0,,Тау…
Dialogue: 0,0:08:35.84,0:08:39.10,Default,,0,0,0,,Хаха, мені тағы қорлады.
Dialogue: 0,0:08:39.22,0:08:42.14,Default,,0,0,0,,Оның себебі неде? Әлгі қоңыз?
Dialogue: 0,0:08:42.27,0:08:45.02,Default,,0,0,0,,Иә... Кабута әлсіз.
Dialogue: 0,0:08:45.14,0:08:46.19,Default,,0,0,0,,Кабута?
Dialogue: 0,0:08:46.31,0:08:47.98,Default,,0,0,0,,А, бұл Кабуто туралы.
Dialogue: 0,0:08:48.73,0:08:51.19,Default,,0,0,0,,Мен әкеме жақсы қараймын деп уәде бердім.
Dialogue: 0,0:08:52.07,0:08:55.32,Default,,0,0,0,,Мен үлкенірек және күштірек нәрсені қалаймын.
Dialogue: 0,0:08:55.45,0:08:57.66,Default,,0,0,0,,Мені өзіңізбен бірге алып кетіңізші~
Dialogue: 0,0:08:57.78,0:09:00.16,Default,,0,0,0,,Бұл әкеңізден сұрауға болатын нәрсе.
Dialogue: 0,0:09:01.12,0:09:02.70,Default,,0,0,0,,Және...
Dialogue: 0,0:09:02.83,0:09:03.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:09.25,0:09:11.55,Default,,0,0,0,,Уәделерді орындау керек
Dialogue: 0,0:09:11.67,0:09:12.71,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:09:12.84,0:09:14.17,Default,,0,0,0,,Үлкен аға?
Dialogue: 0,0:09:14.51,0:09:16.22,Default,,0,0,0,,Дорами-чан! Келдің бе?
Dialogue: 0,0:09:16.34,0:09:19.18,Default,,0,0,0,,Иә, аға, басталып жатыр.
Dialogue: 0,0:09:19.30,0:09:21.81,Default,,0,0,0,,Ноби-чанға да қара, ол пайдалы болады.
Dialogue: 0,0:09:21.93,0:09:23.14,Default,,0,0,0,,Иә
Dialogue: 0,0:09:25.56,0:09:28.69,Default,,0,0,0,,А, енді Нобита-кун.
Dialogue: 0,0:09:28.81,0:09:30.40,Default,,0,0,0,,Дора-чан, басталып жатыр.
Dialogue: 0,0:09:30.52,0:09:32.61,Default,,0,0,0,,А... иә.
Dialogue: 0,0:09:32.73,0:09:35.44,Default,,0,0,0,,Бұл... Иә? Қайда...
Dialogue: 0,0:09:35.57,0:09:37.36,Default,,0,0,0,,Дора-чан! А... иә
Dialogue: 0,0:09:37.49,0:09:38.86,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:41.08,0:09:43.20,Default,,0,0,0,,Аты аңызға айналған алып құс Моа...
Dialogue: 0,0:09:43.33,0:09:47.29,Default,,0,0,0,,Неліктен Жаңа Зеландияда жүздеген жылдар бұрын жойылып кеткеніне келсек...
Dialogue: 0,0:09:47.42,0:09:49.50,Default,,0,0,0,,Әртүрлі теориялар бар—
Dialogue: 0,0:09:49.63,0:09:52.71,Default,,0,0,0,,Ең ықтимал көзқарас оны адамдар аулаған.
Dialogue: 0,0:09:52.84,0:09:54.01,Default,,0,0,0,,Жою?
Dialogue: 0,0:09:54.13,0:09:56.13,Default,,0,0,0,,Белгілі бір себептермен қайтыс болу -
Dialogue: 0,0:09:56.26,0:09:58.34,Default,,0,0,0,,Қазір тіпті біреуі де жоқ.
Dialogue: 0,0:09:58.63,0:09:59.59,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:59.72,0:10:03.97,Default,,0,0,0,,Басқа себептерге адамдардың шектен тыс аң аулауы және табиғатты бұзуы жатады.
Dialogue: 0,0:10:04.10,0:10:09.56,Default,,0,0,0,,Көптеген жануарлар жойылып кетті немесе жойылу алдында.
Dialogue: 0,0:10:10.73,0:10:12.61,Default,,0,0,0,,Табиғатты қорғау дегеніміз...
Dialogue: 0,0:10:12.73,0:10:18.24,Default,,0,0,0,,21 ғасырда өмір сүріп, бізге үлкен жауапкершілік жүктеледі.
Dialogue: 0,0:10:18.65,0:10:19.49,Default,,0,0,0,,(өшіру дыбысы)
Dialogue: 0,0:10:19.61,0:10:22.91,Default,,0,0,0,,Мен көп нәрсені үйрендім.
Dialogue: 0,0:10:23.37,0:10:26.08,Default,,0,0,0,,Біз де ойлануымыз керек.
Dialogue: 0,0:10:26.20,0:10:29.46,Default,,0,0,0,,А, біз жойылудың алдын алуға тырысуымыз керек.
Dialogue: 0,0:10:30.79,0:10:35.59,Default,,0,0,0,,Бұл қиын. Кабуто жойылып кетсе, біз енді жәндіктер сумосын ойнай алмаймыз.
Dialogue: 0,0:10:35.71,0:10:37.34,Default,,0,0,0,,Ахаха аха жақсы...
Dialogue: 0,0:10:37.47,0:10:38.47,Default,,0,0,0,,Нобита (Нобита/Дораэмон)?
Dialogue: 0,0:10:38.97,0:10:40.72,Default,,0,0,0,,Кабута Содан бері жеңдіңіз бе?
Dialogue: 0,0:10:40.84,0:10:42.55,Default,,0,0,0,,Мүлде жоқ
Dialogue: 0,0:10:42.68,0:10:47.18,Default,,0,0,0,,Менің ойымша, жәндіктердің сумосында үлкенірек тиімдірек.
Dialogue: 0,0:10:47.68,0:10:50.48,Default,,0,0,0,,Иә, әкем бала кезінде—
Dialogue: 0,0:10:50.60,0:10:54.27,Default,,0,0,0,,Сондай үлкен қоңыз бар деп естідім.
Dialogue: 0,0:10:54.48,0:10:55.73,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:56.32,0:10:58.94,Default,,0,0,0,,Ал, бұл... Менің ойымша, бұл көп болды.
Dialogue: 0,0:10:59.07,0:11:01.70,Default,,0,0,0,,Бұл көп уақыт бұрын болды, сондықтан мен сенімді емеспін.
Dialogue: 0,0:11:01.82,0:11:02.95,Default,,0,0,0,,Әке, не?
Dialogue: 0,0:11:03.57,0:11:05.83,Default,,0,0,0,,Сол оқиға туралы көбірек айтып беріңізші!
Dialogue: 0,0:11:06.70,0:11:11.96,Default,,0,0,0,,Хмм... міне, мен бұл жерде екеніне сенімдімін... Эй, мынау.
Dialogue: 0,0:11:12.08,0:11:14.04,Default,,0,0,0,,Дорами-чан күріш крекерін беріңізші
Dialogue: 0,0:11:14.17,0:11:15.50,Default,,0,0,0,,Иә, itadakimasu
Dialogue: 0,0:11:17.34,0:11:18.80,Default,,0,0,0,,болды
Dialogue: 0,0:11:21.80,0:11:23.93,Default,,0,0,0,,Ой, қарашы, міне, осы.
Dialogue: 0,0:11:24.30,0:11:25.14,Default,,0,0,0,,Уф аа
Dialogue: 0,0:11:26.18,0:11:27.47,Default,,0,0,0,,Қоңыз...
Dialogue: 0,0:11:27.60,0:11:28.85,Default,,0,0,0,,Жарқыраған
Dialogue: 0,0:11:29.43,0:11:31.56,Default,,0,0,0,,Әке, сіз мұны көрдіңіз бе? иә?
Dialogue: 0,0:11:31.69,0:11:32.56,Default,,0,0,0,,Қайда?
Dialogue: 0,0:11:32.69,0:11:35.02,Default,,0,0,0,,Мм... ол қайда?
Dialogue: 0,0:11:35.15,0:11:37.57,Default,,0,0,0,,Өйткені, бұл менің бала кезімде болған.
Dialogue: 0,0:11:38.36,0:11:40.03,Default,,0,0,0,,Кез келген жағдайда! (Нобита) Иә
Dialogue: 0,0:11:40.61,0:11:41.65,Default,,0,0,0,,Иә
Dialogue: 0,0:11:43.03,0:11:44.07,Default,,0,0,0,,Бұл арман болған шығар
Dialogue: 0,0:11:44.20,0:11:45.95,Default,,0,0,0,,А, қазірдің өзінде (Нобита) ...
Dialogue: 0,0:11:46.62,0:11:50.71,Default,,0,0,0,,Маған бұрынғыдай дулыға керек~
Dialogue: 0,0:11:51.04,0:11:53.25,Default,,0,0,0,,Егер мен жай ғана бас тартсам ше?
Dialogue: 0,0:11:53.37,0:11:57.17,Default,,0,0,0,,Мен бас тарта алмаймын, Дораемон, бірдеңе істе.
Dialogue: 0,0:11:57.29,0:11:59.17,Default,,0,0,0,,Оған көмектесу мүмкін емес.
Dialogue: 0,0:12:00.01,0:12:02.17,Default,,0,0,0,,Уақыт саңылауы!
Dialogue: 0,0:12:02.80,0:12:03.63,Default,,0,0,0,,Қорқамын, ол қайтып келмейді.
Dialogue: 0,0:12:03.76,0:12:06.55,Default,,0,0,0,,Бұл жоғалған заттарды қайтаратын машина.
Dialogue: 0,0:12:06.68,0:12:07.89,Default,,0,0,0,,Үлкен аға?
Dialogue: 0,0:12:08.01,0:12:09.01,Default,,0,0,0,,Жетпейді
Dialogue: 0,0:12:09.14,0:12:11.81,Default,,0,0,0,,Не? Торимочи
Dialogue: 0,0:12:11.93,0:12:14.02,Default,,0,0,0,,Ах! А... дұрыс
Dialogue: 0,0:12:14.48,0:12:16.94,Default,,0,0,0,,Уақытты бақылау
Dialogue: 0,0:12:17.06,0:12:19.48,Default,,0,0,0,,Ахаха, мына екеуін қолдан.
Dialogue: 0,0:12:20.07,0:12:21.99,Default,,0,0,0,,Қазірдің өзінде! Қолыңнан келгеннің бәрін жаса
Dialogue: 0,0:12:22.11,0:12:24.11,Default,,0,0,0,,А... иә (Нобита) Хмф!
Dialogue: 0,0:12:24.24,0:12:25.99,Default,,0,0,0,,Нобита-сан, сен қайда қарап тұрсың?
Dialogue: 0,0:12:26.12,0:12:26.95,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:27.70,0:12:30.58,Default,,0,0,0,,Сіз үлкен, жылтыр қоңыз іздеп жүрсіз ғой, солай ма?
Dialogue: 0,0:12:30.70,0:12:32.41,Default,,0,0,0,,Енді қайда қарау керек?
Dialogue: 0,0:12:33.46,0:12:35.62,Default,,0,0,0,,Жаңа Зеландия! Моа қайда болды
Dialogue: 0,0:12:36.08,0:12:38.21,Default,,0,0,0,,Көбірек? Дорами
Dialogue: 0,0:12:38.34,0:12:39.42,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:12:40.05,0:12:42.34,Default,,0,0,0,,Орналасқан жері: Жаңа Зеландия
Dialogue: 0,0:12:42.47,0:12:44.43,Default,,0,0,0,,Уақыт шамамен 500 жыл бұрын болған.
Dialogue: 0,0:12:47.14,0:12:48.72,Default,,0,0,0,,А, шықты!
Dialogue: 0,0:12:48.85,0:12:51.77,Default,,0,0,0,,Бұл 500 жыл бұрынғы Жаңа Зеландия
Dialogue: 0,0:12:51.89,0:12:54.39,Default,,0,0,0,,Аа, бұл өте кең.
Dialogue: 0,0:12:54.81,0:12:57.02,Default,,0,0,0,,Мұны табу қиын.
Dialogue: 0,0:12:57.15,0:12:57.81,Default,,0,0,0,,Иә
Dialogue: 0,0:12:57.94,0:12:59.77,Default,,0,0,0,,Сабырмен іздеу керек!
Dialogue: 0,0:12:59.90,0:13:00.86,Default,,0,0,0,,Мен білемін
Dialogue: 0,0:13:01.69,0:13:03.19,Default,,0,0,0,,Йойшо Йойшо Йойшо
Dialogue: 0,0:13:03.32,0:13:04.65,Default,,0,0,0,,Онда жоқ.
Dialogue: 0,0:13:05.24,0:13:06.66,Default,,0,0,0,,Сабырлы болыңыз
Dialogue: 0,0:13:06.78,0:13:07.74,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:13:07.87,0:13:09.53,Default,,0,0,0,,Мен орынды өзгертуге тырысамын.
Dialogue: 0,0:13:09.66,0:13:11.58,Default,,0,0,0,,Шындығында, мен...
Dialogue: 0,0:13:15.12,0:13:16.58,Default,,0,0,0,,Онда жоқ.
Dialogue: 0,0:13:17.00,0:13:19.13,Default,,0,0,0,,Сабырмен (Дорами/Дораэмон) Сабырмен
Dialogue: 0,0:13:19.25,0:13:21.00,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:21.13,0:13:22.71,Default,,0,0,0,,Иә? (Нобитаның қорылдауы)
Dialogue: 0,0:13:22.84,0:13:24.01,Default,,0,0,0,,Не! (Нобита) Уау
Dialogue: 0,0:13:24.38,0:13:26.80,Default,,0,0,0,,Адамдар үнемі ізденсін!
Dialogue: 0,0:13:26.93,0:13:29.93,Default,,0,0,0,,Кешіріңіз, мен оны мүлдем таба алмаймын...
Dialogue: 0,0:13:30.05,0:13:33.47,Default,,0,0,0,,Үлкен аға, орманда қоңыздар мекендемей ме?
Dialogue: 0,0:13:33.60,0:13:35.27,Default,,0,0,0,,Ой! А, түсіндім.
Dialogue: 0,0:13:35.39,0:13:38.48,Default,,0,0,0,,Дорами Қараңдаршы, мына жерде орман бар.
Dialogue: 0,0:13:39.56,0:13:42.65,Default,,0,0,0,,Барамыз ба? Иә, кеттік!
Dialogue: 0,0:13:45.78,0:13:47.45,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:13:48.53,0:13:50.12,Default,,0,0,0,,Ei hmph
Dialogue: 0,0:13:50.32,0:13:52.03,Default,,0,0,0,,Хмм... Ах!
Dialogue: 0,0:13:52.70,0:13:53.99,Default,,0,0,0,,Ол тікелей Бүкіл Құдірет Біреуіне бағынышты.
Dialogue: 0,0:13:54.12,0:13:55.20,Default,,0,0,0,,Не? не?
Dialogue: 0,0:13:56.33,0:13:57.37,Default,,0,0,0,,Уау, аға!
Dialogue: 0,0:13:57.50,0:13:59.04,Default,,0,0,0,,Уау, аа...
Dialogue: 0,0:13:59.17,0:14:01.54,Default,,0,0,0,,Ууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууууу
Dialogue: 0,0:14:01.67,0:14:02.80,Default,,0,0,0,,Уау (Нобита) Уау
Dialogue: 0,0:14:04.34,0:14:05.17,Default,,0,0,0,,Уф!
Dialogue: 0,0:14:05.30,0:14:06.55,Default,,0,0,0,,Әй?
Dialogue: 0,0:14:06.67,0:14:07.51,Default,,0,0,0,,Үлкен аға! Ах!
Dialogue: 0,0:14:07.63,0:14:08.51,Default,,0,0,0,,Уау
Dialogue: 0,0:14:08.84,0:14:09.97,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:10.14,0:14:12.05,Default,,0,0,0,,Ай... Көбірек~
Dialogue: 0,0:14:12.43,0:14:13.93,Default,,0,0,0,,Иә? Хмм
Dialogue: 0,0:14:14.06,0:14:16.48,Default,,0,0,0,,Мо моаааааааааааааааааааааа
Dialogue: 0,0:14:18.52,0:14:20.48,Default,,0,0,0,,Жасаңыз... Дораэмон әйтеуір
Dialogue: 0,0:14:20.60,0:14:22.77,Default,,0,0,0,,Увааааааааааааааааааааааааа
Dialogue: 0,0:14:23.07,0:14:25.44,Default,,0,0,0,,Толығырақ~! (Нобита) Ахх...
Dialogue: 0,0:14:25.73,0:14:26.74,Default,,0,0,0,,Нобита-сан
Dialogue: 0,0:14:26.86,0:14:29.15,Default,,0,0,0,,А, жоқ, жоқ, жоқ, жоқ.
Dialogue: 0,0:14:29.95,0:14:31.91,Default,,0,0,0,,Додо… Дораемон
Dialogue: 0,0:14:32.03,0:14:34.24,Default,,0,0,0,,Нобита-кун! Бұл қайда? Бұл қайда? Бұл қайда?
Dialogue: 0,0:14:34.37,0:14:36.45,Default,,0,0,0,,Кабута... жоқ
Dialogue: 0,0:14:36.58,0:14:38.37,Default,,0,0,0,,А, аа, у...
Dialogue: 0,0:14:39.00,0:14:41.67,Default,,0,0,0,,Момотаро мөрі бар тары тұшпара
Dialogue: 0,0:14:41.96,0:14:43.88,Default,,0,0,0,,Бұл сенің ағаңның іздеп жүргені ғой, солай ма?
Dialogue: 0,0:14:44.00,0:14:45.25,Default,,0,0,0,,Иә иә иә
Dialogue: 0,0:14:45.38,0:14:46.84,Default,,0,0,0,,Міне! Ерке!
Dialogue: 0,0:14:47.30,0:14:48.76,Default,,0,0,0,,Нобита-санды жібер.
Dialogue: 0,0:14:48.88,0:14:50.55,Default,,0,0,0,,Толығырақ! Қараңдар!
Dialogue: 0,0:14:50.93,0:14:52.72,Default,,0,0,0,,(жұтыну дыбысы)
Dialogue: 0,0:14:53.89,0:14:55.22,Default,,0,0,0,,(Моа ызылдаған дыбыс)
Dialogue: 0,0:14:55.76,0:14:56.93,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,0:14:57.47,0:14:58.39,Default,,0,0,0,,Хмм...
Dialogue: 0,0:14:58.52,0:15:00.02,Default,,0,0,0,,Нобита (Дораэмон/Нобита)!
Dialogue: 0,0:15:00.56,0:15:01.52,Default,,0,0,0,,Кірейік.
Dialogue: 0,0:15:01.65,0:15:03.36,Default,,0,0,0,,А... Уф, сәл күте тұрыңыз!
Dialogue: 0,0:15:03.48,0:15:04.73,Default,,0,0,0,,Мен күте алмаймын!
Dialogue: 0,0:15:06.19,0:15:07.23,Default,,0,0,0,,Әй?
Dialogue: 0,0:15:07.94,0:15:09.70,Default,,0,0,0,,Не болды? анам
Dialogue: 0,0:15:10.15,0:15:13.41,Default,,0,0,0,,Бұл біртүрлі. Мен біртүрлі дауыс естідім.
Dialogue: 0,0:15:13.53,0:15:16.04,Default,,0,0,0,,Иә? Дораемон
Dialogue: 0,0:15:16.16,0:15:17.54,Default,,0,0,0,,Иә? Иә
Dialogue: 0,0:15:17.66,0:15:21.67,Default,,0,0,0,,(Нобита мен оның достарының күлкісі)
Dialogue: 0,0:15:23.33,0:15:25.00,Default,,0,0,0,,Бөлмеңізді әрқашан таза ұстаңыз!
Dialogue: 0,0:15:25.13,0:15:26.88,Default,,0,0,0,,Иә (есік жабылған дыбыс)
Dialogue: 0,0:15:28.42,0:15:29.42,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:29.55,0:15:31.05,Default,,0,0,0,,Бұл қауіпті болды.
Dialogue: 0,0:15:31.43,0:15:33.72,Default,,0,0,0,,Білсек, үлкен шу болады.
Dialogue: 0,0:15:33.84,0:15:36.26,Default,,0,0,0,,Тез оны бастапқы орнына қайтарайық.
Dialogue: 0,0:15:36.81,0:15:41.85,Default,,0,0,0,,Бірақ егер сіз оны бастапқы орнына қайтарсаңыз да, ол ақырында жойылып кетеді.
Dialogue: 0,0:15:41.98,0:15:42.73,Default,,0,0,0,,Иә...
Dialogue: 0,0:15:42.85,0:15:44.73,Default,,0,0,0,,Бұл өте өкінішті.
Dialogue: 0,0:15:47.44,0:15:50.90,Default,,0,0,0,,Мен мәңгі өмір сүретін жер бар ма?
Dialogue: 0,0:15:51.49,0:15:56.58,Default,,0,0,0,,Дұрыс, ондай жер болса, тауып бер...
Dialogue: 0,0:15:56.70,0:15:58.12,Default,,0,0,0,,Іздеу? иә?
Dialogue: 0,0:15:58.58,0:15:59.54,Default,,0,0,0,,Табайық!
Dialogue: 0,0:15:59.66,0:16:01.46,Default,,0,0,0,,Иә, іздеп көрейік! Хехехе
Dialogue: 0,0:16:01.58,0:16:04.58,Default,,0,0,0,,Иә? мен?
Dialogue: 0,0:16:05.92,0:16:09.59,Default,,0,0,0,,Қызық, осындай қолайлы жер бар ма?
Dialogue: 0,0:16:09.84,0:16:12.84,Default,,0,0,0,,Жақында орныңды табасың деп үміттенемін.
Dialogue: 0,0:16:13.26,0:16:16.64,Default,,0,0,0,,Иә? Эй, мен оны тапқанша осында қалдырғың келе ме?
Dialogue: 0,0:16:16.76,0:16:18.39,Default,,0,0,0,,Мама сені тауып береді
Dialogue: 0,0:16:18.51,0:16:22.31,Default,,0,0,0,,Әй, мұны істейік, Кіші жарық!
Dialogue: 0,0:16:23.10,0:16:24.48,Default,,0,0,0,,Иә көбірек
Dialogue: 0,0:16:30.99,0:16:32.19,Default,,0,0,0,,Қосымша
Dialogue: 0,0:16:33.03,0:16:35.03,Default,,0,0,0,,(Айзава) Сондықтан мен қабылдау емтиханы логикаға жат дедім
Dialogue: 0,0:16:35.41,0:16:37.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:38.87,0:16:41.29,Default,,0,0,0,,Няхахахаха, қарныңыз ашты.
Dialogue: 0,0:16:41.41,0:16:45.04,Default,,0,0,0,,Иә! кешегі тамақ
Dialogue: 0,0:16:45.17,0:16:46.83,Default,,0,0,0,,Уау! Аха~ Дораяки
Dialogue: 0,0:16:47.29,0:16:49.17,Default,,0,0,0,,Бірден құсты алыңыз
Dialogue: 0,0:16:49.71,0:16:51.42,Default,,0,0,0,,Иә (Нобита) Мен мұны істедім!
Dialogue: 0,0:16:51.55,0:16:54.47,Default,,0,0,0,,(Уақыт телефонының рингтоны)
Dialogue: 0,0:16:55.38,0:16:56.59,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:16:56.72,0:16:59.60,Default,,0,0,0,,Үлкен аға, мінеки, ғажайып арал.
Dialogue: 0,0:16:59.72,0:17:01.43,Default,,0,0,0,,Ғажайып арал?
Dialogue: 0,0:17:01.85,0:17:06.94,Default,,0,0,0,,Иә, Берегамонд – жойылып кеткен жануарларды қорғайтын арал.
Dialogue: 0,0:17:07.06,0:17:09.19,Default,,0,0,0,,Берегамонд?
Dialogue: 0,0:17:10.11,0:17:12.57,Default,,0,0,0,,Шамамен 65 миллион жыл бұрын—
Dialogue: 0,0:17:12.69,0:17:15.32,Default,,0,0,0,,Жерге көптеген метеориттер түскенде—
Dialogue: 0,0:17:15.49,0:17:16.91,Default,,0,0,0,,Бұл құрылған арал.
Dialogue: 0,0:17:17.66,0:17:19.20,Default,,0,0,0,,Метеориттермен жаңбыр жауды.
Dialogue: 0,0:17:19.32,0:17:21.79,Default,,0,0,0,,Ғарыштық құдіретпен, тылсым күшпен—
Dialogue: 0,0:17:21.91,0:17:24.20,Default,,0,0,0,,Ол қазір қорғалған сияқты.
Dialogue: 0,0:17:24.33,0:17:26.21,Default,,0,0,0,,Жұмбақ күш?
Dialogue: 0,0:17:26.33,0:17:28.75,Default,,0,0,0,,Иә, барлық тірі заттардың
Dialogue: 0,0:17:28.88,0:17:31.84,Default,,0,0,0,,Оның тіршілік қуатын арттыратын күші бар сияқты.
Dialogue: 0,0:17:32.42,0:17:34.59,Default,,0,0,0,,Мұны байқаған ғалымдар
Dialogue: 0,0:17:34.72,0:17:38.26,Default,,0,0,0,,Осы аралға жойылған жануарларды әкелу үшін уақыт машинасын пайдаланыңыз.
Dialogue: 0,0:17:38.39,0:17:40.26,Default,,0,0,0,,Сонымен, сіз оны қорғауды шештіңіз бе?
Dialogue: 0,0:17:40.60,0:17:44.31,Default,,0,0,0,,Ху~ Сондай арал бар еді.
Dialogue: 0,0:17:44.43,0:17:46.60,Default,,0,0,0,,Мен сізге бірден хабарласамын, күте тұрыңыз.
Dialogue: 0,0:17:46.73,0:17:48.31,Default,,0,0,0,,Рахмет сізге Дорами
Dialogue: 0,0:17:48.44,0:17:49.65,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:17:49.77,0:17:52.32,Default,,0,0,0,,Әй, дәмді!
Dialogue: 0,0:17:57.45,0:18:01.16,Default,,0,0,0,,Қонақ - Ноби отбасының жүк тиеушісі. Бұл Дораемон ба?
Dialogue: 0,0:18:21.09,0:18:22.60,Default,,0,0,0,,Нобисуке!
Dialogue: 0,0:18:22.97,0:18:24.72,Default,,0,0,0,,Мен сенен үйде қалуыңды өтінемін.
Dialogue: 0,0:18:24.85,0:18:26.43,Default,,0,0,0,,Иә
Dialogue: 0,0:18:28.52,0:18:30.06,Default,,0,0,0,,(Нобисукенің есінеу)
Dialogue: 0,0:18:42.45,0:18:43.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:18:48.58,0:18:50.62,Default,,0,0,0,,Дораемон-сан... солай ма?
Dialogue: 0,0:18:51.04,0:18:53.29,Default,,0,0,0,,Уау! Не? Уау
Dialogue: 0,0:18:53.67,0:18:55.63,Default,,0,0,0,,Мен сені алып кетуге келдім (Нобисуке) Не істейсің? Жіберу!
Dialogue: 0,0:18:55.75,0:18:59.13,Default,,0,0,0,,Эй, эй, тез жүр (Нобисуке) Уау, мені жібер!
Dialogue: 0,0:18:59.26,0:19:00.47,Default,,0,0,0,,Уау
Dialogue: 0,0:19:00.80,0:19:02.80,Default,,0,0,0,,Хаха, кеттік.
Dialogue: 0,0:19:17.32,0:19:19.36,Default,,0,0,0,,Не... не? Міне
Dialogue: 0,0:19:19.74,0:19:22.32,Default,,0,0,0,,Неліктен сағат...
Dialogue: 0,0:19:22.45,0:19:23.95,Default,,0,0,0,,Ұшу?
Dialogue: 0,0:19:25.37,0:19:27.58,Default,,0,0,0,,Бірдеңе айт! Уау
Dialogue: 0,0:19:28.29,0:19:31.46,Default,,0,0,0,,О, мен жай ғана ұйықтап қалдым.
Dialogue: 0,0:19:31.58,0:19:35.25,Default,,0,0,0,,Мен соңғы уақытта тым көп жұмыс істеп, шаршадым.
Dialogue: 0,0:19:35.38,0:19:36.84,Default,,0,0,0,,Ақымақ! Хе-хе-хе! ➡
Dialogue: 0,0:19:36.96,0:19:39.21,Default,,0,0,0,,Әй, ау... Аш!
Dialogue: 0,0:19:39.34,0:19:40.63,Default,,0,0,0,,Мына нәрсені ашыңыз!
Dialogue: 0,0:19:41.01,0:19:44.85,Default,,0,0,0,,Ұйқысыз көлік жүргізу қауіпті. Кішкене демалу жақсы.
Dialogue: 0,0:19:56.48,0:19:58.32,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:19:58.44,0:20:00.90,Default,,0,0,0,,Кукуннн... кукукку
Dialogue: 0,0:20:01.03,0:20:03.53,Default,,0,0,0,,Мен қалай шыға аламын?
Dialogue: 0,0:20:04.91,0:20:05.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:07.83,0:20:10.83,Default,,0,0,0,,(Нобисукенің айқайы)
Dialogue: 0,0:20:20.01,0:20:20.96,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:23.97,0:20:27.01,Default,,0,0,0,,Иә? А, туннельде біртүрлі нәрсе бар.
Dialogue: 0,0:20:27.14,0:20:28.39,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:20:28.51,0:20:31.39,Default,,0,0,0,,Ал, кететін уақыт келді деп ойлаймын.
Dialogue: 0,0:20:31.52,0:20:34.23,Default,,0,0,0,,Иә? Шимота!
Dialogue: 0,0:20:34.44,0:20:37.98,Default,,0,0,0,,Жолаушыларды тасымалдау үшін дұрыс емес дәуірді таңдаған болуыңыз керек.
Dialogue: 0,0:20:41.32,0:20:43.07,Default,,0,0,0,,О, Дора... Әй?
Dialogue: 0,0:20:43.78,0:20:47.28,Default,,0,0,0,,Иә? Мен жүктеуді ұмытып кеткен көгершін
Dialogue: 0,0:20:47.41,0:20:50.08,Default,,0,0,0,,Хаха, келесі жолы қателеспей барамын.
Dialogue: 0,0:20:57.96,0:20:59.88,Default,,0,0,0,,Әлі емес пе?
Dialogue: 0,0:21:00.38,0:21:01.84,Default,,0,0,0,,Сәлем Дораемон
Dialogue: 0,0:21:01.96,0:21:04.63,Default,,0,0,0,,Дорами-чан, сен менімен дұрыс хабарластың ба?
Dialogue: 0,0:21:04.76,0:21:06.84,Default,,0,0,0,,...
Dialogue: 0,0:21:07.43,0:21:09.39,Default,,0,0,0,,Уау, осында ма?
Dialogue: 0,0:21:09.97,0:21:12.06,Default,,0,0,0,,Дораемон, солай ма?
Dialogue: 0,0:21:12.60,0:21:13.60,Default,,0,0,0,,Жоқ
Dialogue: 0,0:21:13.73,0:21:15.89,Default,,0,0,0,,Ал, Дораемон ше?
Dialogue: 0,0:21:16.02,0:21:17.06,Default,,0,0,0,,Мен ғана
Dialogue: 0,0:21:17.44,0:21:20.40,Default,,0,0,0,,А, көк... енот ит?
Dialogue: 0,0:21:22.19,0:21:23.94,Default,,0,0,0,,Түн ортасында әлі де 36 сағат.
Dialogue: 0,0:21:24.07,0:21:26.91,Default,,0,0,0,,Мен енот ит емеспін!
Dialogue: 0,0:21:27.03,0:21:28.70,Default,,0,0,0,,Ха, біреуі жақсы.
Dialogue: 0,0:21:28.82,0:21:30.66,Default,,0,0,0,,Әй, жүр!
Dialogue: 0,0:21:30.78,0:21:33.25,Default,,0,0,0,,Тезірек келіңіздер!
Dialogue: 0,0:21:33.37,0:21:35.41,Default,,0,0,0,,Уау, Дораемон!
Dialogue: 0,0:21:36.75,0:21:40.96,Default,,0,0,0,,Ол мүлде жалқау жігіт. Мен көп нәрсені бастан өткердім.
Dialogue: 0,0:21:41.09,0:21:42.96,Default,,0,0,0,,Ах! Апыр-ай?
Dialogue: 0,0:21:43.26,0:21:46.01,Default,,0,0,0,,Бұл әдемі. Мен оны бірінші рет көріп тұрмын.
Dialogue: 0,0:21:46.13,0:21:48.05,Default,,0,0,0,,Иә? Уау
Dialogue: 0,0:21:52.26,0:21:53.93,Default,,0,0,0,,Сіз қайда барасыз?
Dialogue: 0,0:21:54.06,0:21:57.81,Default,,0,0,0,,Бұл Дорами айтқан ғажайып арал болса керек.
Dialogue: 0,0:21:57.94,0:22:00.11,Default,,0,0,0,,А, біз тезірек жетуіміз керек.
Dialogue: 0,0:22:00.69,0:22:01.77,Default,,0,0,0,,Ах!
Dialogue: 0,0:22:11.78,0:22:13.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:13.29,0:22:15.70,Default,,0,0,0,,Бұл Дабе, Берегамонд аралы.
Dialogue: 0,0:22:25.76,0:22:26.47,Default,,0,0,0,,Гонске
Dialogue: 0,0:22:26.59,0:22:27.92,Default,,0,0,0,,Иә, доктор.
Dialogue: 0,0:22:28.05,0:22:29.68,Default,,0,0,0,,Мен S3 аймағында күтемін.
Dialogue: 0,0:22:29.80,0:22:31.68,Default,,0,0,0,,Иә, түсіндім.
Dialogue: 0,0:22:34.01,0:22:36.35,Default,,0,0,0,,Мм... Dr.
Dialogue: 0,0:22:36.48,0:22:40.10,Default,,0,0,0,,Доктор Келли, былайша айтқанда, осы аралдың қамқоршысы.
Dialogue: 0,0:22:53.58,0:22:56.50,Default,,0,0,0,,(Додоның айқайы)
Dialogue: 0,0:23:07.84,0:23:08.88,Default,,0,0,0,,Уау! Уф
Dialogue: 0,0:23:09.01,0:23:10.47,Default,,0,0,0,,А-а... (Нобита) Уф
Dialogue: 0,0:23:10.97,0:23:13.01,Default,,0,0,0,,Ауырды... Уф
Dialogue: 0,0:23:13.43,0:23:14.26,Default,,0,0,0,,Әй?
Dialogue: 0,0:23:14.39,0:23:16.47,Default,,0,0,0,,Додо
Dialogue: 0,0:23:16.93,0:23:18.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:18.48,0:23:20.31,Default,,0,0,0,,Уау! (Додо жылайды)
Dialogue: 0,0:23:24.27,0:23:26.61,Default,,0,0,0,,Додо – жұмсақ құс.
Dialogue: 0,0:23:26.73,0:23:28.11,Default,,0,0,0,,Мен ешқандай зиян келтірмеймін.
Dialogue: 0,0:23:29.24,0:23:30.07,Default,,0,0,0,,Ум...
Dialogue: 0,0:23:30.78,0:23:32.53,Default,,0,0,0,,О! көк ракон ит
Dialogue: 0,0:23:34.74,0:23:38.95,Default,,0,0,0,,Мен енот ит емеспін! Дораэмон - мысық тәрізді робот.
Dialogue: 0,0:23:39.41,0:23:41.16,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:23:41.83,0:23:43.25,Default,,0,0,0,,Бухахаха... Болды.
Dialogue: 0,0:23:43.38,0:23:45.04,Default,,0,0,0,,Күлкілі емес!
Dialogue: 0,0:23:45.17,0:23:47.80,Default,,0,0,0,,Кешіріңіз, кешіріңіз, бұл қорқынышты.
Dialogue: 0,0:23:47.92,0:23:48.63,Default,,0,0,0,,Менімен бірге Нобита-кун да күлді.
Dialogue: 0,0:23:48.63,0:23:50.38,Default,,0,0,0,,Менімен бірге Нобита-кун да күлді.
Dialogue: 0,0:23:48.63,0:23:50.38,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,0:23:50.51,0:23:51.55,Default,,0,0,0,,А, жоқ.
Dialogue: 0,0:23:55.01,0:23:56.56,Default,,0,0,0,,Танысқаныма қуаныштымын, Келли.
Dialogue: 0,0:23:56.68,0:23:59.06,Default,,0,0,0,,Цуки… Цуки…
Dialogue: 0,0:23:59.18,0:24:00.89,Default,,0,0,0,,Менің атым Нобита Ноби.
Dialogue: 0,0:24:01.02,0:24:02.69,Default,,0,0,0,,Танысқаныма қуаныштымын (Нобита) Иә.
Dialogue: 0,0:24:03.15,0:24:05.27,Default,,0,0,0,,Уау... Нобита-кун
Dialogue: 0,0:24:05.40,0:24:06.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:06.19,0:24:08.57,Default,,0,0,0,,А... анау... а... (Нобита) Не?
Dialogue: 0,0:24:08.69,0:24:12.11,Default,,0,0,0,,Уау! Нана не? Бұл үлкен тасбақа ма?
Dialogue: 0,0:24:12.90,0:24:14.57,Default,,0,0,0,,Бұл глиптодон
Dialogue: 0,0:24:14.70,0:24:18.03,Default,,0,0,0,,Тасбақаға ұқсайды, бірақ нағыз сүтқоректі
Dialogue: 0,0:24:18.16,0:24:20.08,Default,,0,0,0,,Армадилло тұқымдасының мүшесі.
Dialogue: 0,0:24:20.20,0:24:23.42,Default,,0,0,0,,Уау, мен бұрын соңды мұндайды көрген емеспін.
Dialogue: 0,0:24:24.33,0:24:28.55,Default,,0,0,0,,Мұндағы жануарлардың көпшілігі бұрыннан жойылып кеткен.
Dialogue: 0,0:24:29.17,0:24:32.63,Default,,0,0,0,,Додо – көгершіндер тұқымдасына жататын ұшпайтын құс.
Dialogue: 0,0:24:33.18,0:24:38.14,Default,,0,0,0,,Индрикотериум тарихтағы ең ірі құрлық сүтқоректісі деп аталады.
Dialogue: 0,0:24:38.68,0:24:39.72,Default,,0,0,0,,Бұл… (Бакуго) Э?
Dialogue: 0,0:24:39.85,0:24:42.02,Default,,0,0,0,,Иә, керемет
Dialogue: 0,0:24:50.98,0:24:53.20,Default,,0,0,0,,Ах (Нобита) Ах...
Dialogue: 0,0:24:53.78,0:24:55.41,Default,,0,0,0,,Бұл Мегатерий
Dialogue: 0,0:24:55.53,0:24:58.74,Default,,0,0,0,,Бұл жалқаулықтың ең үлкен түрі.
Dialogue: 0,0:24:58.87,0:25:02.45,Default,,0,0,0,,Элазмотерийдің мүйіздерінің ұзындығы шамамен 2 метр.
Dialogue: 0,0:25:02.58,0:25:05.46,Default,,0,0,0,,Бұл бір мүйізді мүйіздің үлгісі деп айтылады.
Dialogue: 0,0:25:06.21,0:25:08.08,Default,,0,0,0,,Бұл халикотериум
Dialogue: 0,0:25:08.21,0:25:10.09,Default,,0,0,0,,Горилла сияқты жүресің.
Dialogue: 0,0:25:13.30,0:25:14.59,Default,,0,0,0,,Қараңызшы, сонда да.
Dialogue: 0,0:25:14.72,0:25:15.59,Default,,0,0,0,,Не? а?
Dialogue: 0,0:25:15.72,0:25:17.39,Default,,0,0,0,,Эпигавр, уф...
Dialogue: 0,0:25:17.51,0:25:20.51,Default,,0,0,0,,Уау! Бұл егеуқұйрық!
Dialogue: 0,0:25:21.89,0:25:23.48,Default,,0,0,0,,қиын өмір кешкен.
Dialogue: 0,0:25:23.60,0:25:25.94,Default,,0,0,0,,Дораэмон тышқандармен жақсы қарым-қатынаста емес.
Dialogue: 0,0:25:26.06,0:25:29.19,Default,,0,0,0,,О, Эпигавр егеуқұйрық емес.
Dialogue: 0,0:25:29.48,0:25:31.23,Default,,0,0,0,,Тиіндердің достары
Dialogue: 0,0:25:31.36,0:25:32.69,Default,,0,0,0,,Уф...
Dialogue: 0,0:25:33.07,0:25:35.61,Default,,0,0,0,,Эй, мұнда біреу бар ма?
Dialogue: 0,0:25:36.82,0:25:38.37,Default,,0,0,0,,Эй
Dialogue: 0,0:25:39.62,0:25:41.74,Default,,0,0,0,,Эй
Dialogue: 0,0:25:42.62,0:25:43.62,Default,,0,0,0,,Шығыс пен Батыс екі мемлекеті бетпе-бет келіп тұр
Dialogue: 0,0:25:44.62,0:25:45.75,Default,,0,0,0,,Ах...
Dialogue: 0,0:25:45.87,0:25:47.83,Default,,0,0,0,,Уау
Dialogue: 0,0:25:48.54,0:25:50.75,Default,,0,0,0,,Уф, не?
Dialogue: 0,0:25:51.04,0:25:52.92,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:25:53.26,0:25:54.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:25:55.05,0:25:56.13,Default,,0,0,0,,Ах!
Dialogue: 0,0:25:59.76,0:26:00.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:26:02.26,0:26:05.52,Default,,0,0,0,,Біреу... маған көмектесіңізші.
Dialogue: 0,0:26:06.94,0:26:09.06,Default,,0,0,0,,(Халикотерия айқайы)
Dialogue: 0,0:26:09.19,0:26:10.19,Default,,0,0,0,,Мықтырақ!
Dialogue: 0,0:26:14.65,0:26:15.57,Default,,0,0,0,,Ах
Dialogue: 0,0:26:16.40,0:26:19.03,Default,,0,0,0,,Сонда алып моа қайда?
Dialogue: 0,0:26:19.16,0:26:21.78,Default,,0,0,0,,Иә, мына қалтада
Dialogue: 0,0:26:21.91,0:26:23.87,Default,,0,0,0,,Иә? О, ла ла ла бір минут...
Dialogue: 0,0:26:24.12,0:26:26.45,Default,,0,0,0,,Эй, үндемеші.
Dialogue: 0,0:26:26.58,0:26:27.87,Default,,0,0,0,,Қосымша~
Dialogue: 0,0:26:28.83,0:26:30.88,Default,,0,0,0,,Уау, иә, сен істедің.
Dialogue: 0,0:26:31.00,0:26:32.34,Default,,0,0,0,,Мо моа~
Dialogue: 0,0:26:32.46,0:26:34.05,Default,,0,0,0,,Бүгінгі жағдайда ол профессор Годжо немесе сондай біреу болар еді.
Dialogue: 0,0:26:34.55,0:26:37.09,Default,,0,0,0,,Мен сені енді кешірмеймін (Моаның жылағаны)
Dialogue: 0,0:26:38.51,0:26:40.55,Default,,0,0,0,,Жарайды... Уау!
Dialogue: 0,0:26:41.22,0:26:42.10,Default,,0,0,0,,Рыцарь Рейнхарт.
Dialogue: 0,0:26:45.47,0:26:47.77,Default,,0,0,0,,Үлкен жарық
Dialogue: 0,0:26:54.15,0:26:55.82,Default,,0,0,0,,Қосымша
Dialogue: 0,0:26:56.69,0:26:58.70,Default,,0,0,0,,(Моа ызылдаған дыбыс)
Dialogue: 0,0:26:59.82,0:27:02.99,Default,,0,0,0,,Иә? Иә, бұл толығымен...
Dialogue: 0,0:27:03.83,0:27:05.87,Default,,0,0,0,,А... (Нобита) А?
Dialogue: 0,0:27:05.99,0:27:07.20,Default,,0,0,0,,Хмм
Dialogue: 0,0:27:07.33,0:27:07.66,Default,,0,0,0,,Ахахахаха…
Dialogue: 0,0:27:07.66,0:27:10.75,Default,,0,0,0,,Ахахаха…
Dialogue: 0,0:27:07.66,0:27:10.75,Default,,0,0,0,,Менің жолыма кедергі болма!
Dialogue: 0,0:27:12.13,0:27:13.17,Default,,0,0,0,,Қосымша
Dialogue: 0,0:27:13.59,0:27:15.96,Default,,0,0,0,,Ах... О, дұрыс, доктор Келли.
Dialogue: 0,0:27:16.42,0:27:17.34,Default,,0,0,0,,Не?
Dialogue: 0,0:27:17.46,0:27:20.43,Default,,0,0,0,,Уақыт туннелінде біртүрлі нәрсе болды.
Dialogue: 0,0:27:20.84,0:27:23.43,Default,,0,0,0,,Жоқ, менің болжамым бар.
Dialogue: 0,0:27:23.55,0:27:28.14,Default,,0,0,0,,Гонсуке, осы екеуін бастапқы әлеміне қайтарыңыз.
Dialogue: 0,0:27:28.27,0:27:30.89,Default,,0,0,0,,Мен зертханаға қайта барып, зерттеймін.
Dialogue: 0,0:27:40.99,0:27:42.28,Default,,0,0,0,,Доктор Келли
Dialogue: 0,0:27:42.41,0:27:45.70,Default,,0,0,0,,Саған көп рахмет Қош бол~
Dialogue: 0,0:27:45.83,0:27:46.58,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:46.87,0:27:51.92,Default,,0,0,0,,Хахан Мен доктор Келли, Нобита-кун туралы көбірек естігім келді.
Dialogue: 0,0:27:52.04,0:27:54.25,Default,,0,0,0,,Кім? иә?
Dialogue: 0,0:27:54.38,0:27:55.29,Default,,0,0,0,,Уау!
Dialogue: 0,0:27:55.79,0:27:57.96,Default,,0,0,0,,Нобита-кун деген кім?
Dialogue: 0,0:27:58.09,0:28:02.43,Default,,0,0,0,,Жоқ, мен waslenbo-ны қолдандым.
Dialogue: 0,0:28:02.55,0:28:05.26,Default,,0,0,0,,Бұл заттарды ұмыттыратын құрал.
Dialogue: 0,0:28:05.39,0:28:09.97,Default,,0,0,0,,Таймер дұрыс жұмыс істемеді, сондықтан мен оны жөндеуге жіберуді ойладым.
Dialogue: 0,0:28:10.43,0:28:13.02,Default,,0,0,0,,Нобита-кун Нобита-кун!
Dialogue: 0,0:28:13.14,0:28:15.36,Default,,0,0,0,,Сонымен Нобита-кун деген кім?
Dialogue: 0,0:28:15.48,0:28:16.44,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:16.69,0:28:18.32,Default,,0,0,0,,Қосымша~
Dialogue: 0,0:28:19.32,0:28:21.49,Default,,0,0,0,,Кім артық? Уау
Dialogue: 0,0:28:22.61,0:28:23.61,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:23.74,0:28:25.12,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:28:25.24,0:28:27.33,Default,,0,0,0,,Бұл Нобита болуы керек, солай ма?
Dialogue: 0,0:28:27.45,0:28:28.58,Default,,0,0,0,,Хмм...
Dialogue: 0,0:28:28.70,0:28:30.37,Default,,0,0,0,,Уау, уау (Нобита) Уау, уау!
Dialogue: 0,0:28:30.50,0:28:32.25,Default,,0,0,0,,Қой, қой...
Dialogue: 0,0:28:32.37,0:28:33.96,Default,,0,0,0,,Эй, эй...
Dialogue: 0,0:28:34.08,0:28:35.50,Default,,0,0,0,,А-а-а-а
Dialogue: 0,0:28:35.75,0:28:37.17,Default,,0,0,0,,(Дораэмонның айқайы)
Dialogue: 0,0:28:38.46,0:28:39.71,Default,,0,0,0,,Дораемон! Көбірек
Dialogue: 0,0:28:39.84,0:28:41.67,Default,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,0:28:44.05,0:28:45.22,Default,,0,0,0,,Дораемон!
Dialogue: 0,0:28:45.34,0:28:48.64,Default,,0,0,0,,А... Мен саған кейінірек көмектесемін.
Dialogue: 0,0:28:49.26,0:28:52.39,Default,,0,0,0,,Күте тұрыңыз! Васренбоны қайтарыңыз!
Dialogue: 0,0:28:52.68,0:28:54.39,Default,,0,0,0,,Хаха...
Dialogue: 0,0:28:54.56,0:28:57.90,Default,,0,0,0,,(Дораэмонның ыңырсыуы)
Dialogue: 0,0:28:58.02,0:29:00.82,Default,,0,0,0,,Иә, көп уақыт пен күш жұмсайды.
Dialogue: 0,0:29:01.15,0:29:03.82,Default,,0,0,0,,Сәлем! Эй!
Dialogue: 0,0:29:04.07,0:29:07.66,Default,,0,0,0,,Сәлем! Жоғалған баладан гөрі!
Dialogue: 0,0:29:07.78,0:29:09.99,Default,,0,0,0,,(Құстардың шырылдаған дыбыстары)
Dialogue: 0,0:29:10.12,0:29:11.29,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:12.79,0:29:14.46,Default,,0,0,0,,Уф уау
Dialogue: 0,0:29:17.50,0:29:20.38,Default,,0,0,0,,Эй, эй
Dialogue: 0,0:29:20.71,0:29:23.30,Default,,0,0,0,,А, эй... а, не болып жатыр?
Dialogue: 0,0:29:23.42,0:29:24.72,Default,,0,0,0,,(Дораэмонның ыңырсыуы)
Dialogue: 0,0:29:24.84,0:29:26.34,Default,,0,0,0,,Тағы бір суретке түсірейік.
Dialogue: 0,0:29:26.47,0:29:29.55,Default,,0,0,0,,Бұл туралы не деуге болады? Иә осында
Dialogue: 0,0:29:30.22,0:29:33.31,Default,,0,0,0,,Аха~ Мен құтқарылдым.
Dialogue: 0,0:29:33.43,0:29:35.23,Default,,0,0,0,,Рахмет
Dialogue: 0,0:29:35.35,0:29:38.52,Default,,0,0,0,,Хахаха Не, картоп қазудан оңай болды.
Dialogue: 0,0:29:39.15,0:29:41.73,Default,,0,0,0,,Моа қайда кетті?
Dialogue: 0,0:29:42.61,0:29:43.65,Default,,0,0,0,,Ммм
Dialogue: 0,0:29:45.07,0:29:46.15,Default,,0,0,0,,Ах!
Dialogue: 0,0:29:47.32,0:29:51.08,Default,,0,0,0,,Уау! Кабутаға қара
Dialogue: 0,0:29:51.74,0:29:53.95,Default,,0,0,0,,Бұл тамаша кабуто.
Dialogue: 0,0:29:54.16,0:29:56.71,Default,,0,0,0,,Керемет хахаха... Нобита-кун!
Dialogue: 0,0:29:56.83,0:29:57.67,Default,,0,0,0,,Ах
Dialogue: 0,0:29:58.67,0:30:01.96,Default,,0,0,0,,Менің Васленборгтан бас тартудан басқа амалым жоқ.
Dialogue: 0,0:30:02.09,0:30:04.09,Default,,0,0,0,,Дұрыс, а
Dialogue: 0,0:30:04.21,0:30:06.26,Default,,0,0,0,,Не болды? Нобита-кун
Dialogue: 0,0:30:06.38,0:30:09.09,Default,,0,0,0,,Иә, мен үйге қуаныштымын.
Dialogue: 0,0:30:09.64,0:30:11.72,Default,,0,0,0,,Ерте келу керек емес пе?
Dialogue: 0,0:30:13.01,0:30:16.06,Default,,0,0,0,,Үйге келгенде мен құпия құралдарды тексеруім керек.
Dialogue: 0,0:30:28.36,0:30:30.82,Default,,0,0,0,,Күрсін... Қарным ашты!
Dialogue: 0,0:30:32.24,0:30:33.79,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:30:34.16,0:30:37.08,Default,,0,0,0,,Тек су сізді толтырмайды
Dialogue: 0,0:30:37.41,0:30:40.04,Default,,0,0,0,,Рамен жегім келеді. Мен де якисоба жегім келеді
Dialogue: 0,0:30:40.17,0:30:43.00,Default,,0,0,0,,Катсудон да... Уф
Dialogue: 0,0:30:43.80,0:30:45.00,Default,,0,0,0,,Қосымша
Dialogue: 0,0:30:47.76,0:30:49.80,Default,,0,0,0,,А-а-а
Dialogue: 0,0:30:49.93,0:30:52.14,Default,,0,0,0,,Уау! Көбірек
Dialogue: 0,0:31:02.77,0:31:04.15,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:05.94,0:31:08.11,Default,,0,0,0,,(Моаның айқайы)
Dialogue: 0,0:31:08.24,0:31:10.07,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,0:31:10.82,0:31:11.86,Default,,0,0,0,,Бұл қайда? (мылтық)
Dialogue: 0,0:31:12.41,0:31:13.32,Default,,0,0,0,,Уф
Dialogue: 0,0:31:15.03,0:31:16.83,Default,,0,0,0,,Уф... не? ток
Dialogue: 0,0:31:22.46,0:31:25.04,Default,,0,0,0,,Онда барсаңыз, біреуді кездестіруіңіз мүмкін.
Dialogue: 0,0:31:25.17,0:31:26.13,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:31:27.09,0:31:28.34,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:31:29.05,0:31:30.38,Default,,0,0,0,,Кеттік
Dialogue: 0,0:31:38.39,0:31:40.39,Default,,0,0,0,,А, бұл да
Dialogue: 0,0:31:40.94,0:31:42.85,Default,,0,0,0,,Амортизатор да жөндеуге жіберіледі
Dialogue: 0,0:31:43.10,0:31:45.90,Default,,0,0,0,,Ах, пневматикалық мылтық та дірілдеп тұр.
Dialogue: 0,0:31:46.02,0:31:48.11,Default,,0,0,0,,Жөндеу жөндеу және
Dialogue: 0,0:31:48.23,0:31:49.82,Default,,0,0,0,,Әлі де көп
Dialogue: 0,0:31:49.94,0:31:52.82,Default,,0,0,0,,Маған сенің көмегің керек кезде ол үнемі жоғалып кетеді.
Dialogue: 0,0:31:52.95,0:31:54.12,Default,,0,0,0,,Нобита-кун
Dialogue: 0,0:31:54.24,0:31:56.95,Default,,0,0,0,,(Нобитаның гуілдеуі)
Dialogue: 0,0:31:57.08,0:31:58.20,Default,,0,0,0,,Хэхехаха
Dialogue: 0,0:32:03.12,0:32:06.92,Default,,0,0,0,,(Ұлдардың қатты тыныс алуы)
Dialogue: 0,0:32:08.88,0:32:10.34,Default,,0,0,0,,Қалай!
Dialogue: 0,0:32:10.47,0:32:11.59,Default,,0,0,0,,Мәңгі менің қасымда бол.
Dialogue: 0,0:32:12.26,0:32:14.55,Default,,0,0,0,,Хехе, қашатын нәрсе ме?
Dialogue: 0,0:32:19.56,0:32:21.39,Default,,0,0,0,,Ха (бала) Ах, а...
Dialogue: 0,0:32:24.23,0:32:25.61,Default,,0,0,0,,Ах, оо
Dialogue: 0,0:32:28.78,0:32:30.86,Default,,0,0,0,,Балалар сендер білулерің керек.
Dialogue: 0,0:32:31.40,0:32:33.32,Default,,0,0,0,,Келіңіздер, айтайын.
Dialogue: 0,0:32:33.57,0:32:38.08,Default,,0,0,0,,А, үлкен құс. Ал ол не? Сол жігіттер
Dialogue: 0,0:32:38.58,0:32:41.12,Default,,0,0,0,,Алтын Геркулес қайда орналасқан?
Dialogue: 0,0:32:41.62,0:32:43.25,Default,,0,0,0,,Алтын Геркулес?
Dialogue: 0,0:32:43.37,0:32:45.29,Default,,0,0,0,,Сіз қайдасыз?
Dialogue: 0,0:32:47.38,0:32:49.84,Default,,0,0,0,,Тексеріңіз! Олар қыңыр жігіттер.
Dialogue: 0,0:32:49.96,0:32:51.76,Default,,0,0,0,,Иә, маған қалдырыңыз!
Dialogue: 0,0:32:52.13,0:32:55.30,Default,,0,0,0,,Ей! Уау, ауырады...
Dialogue: 0,0:32:55.64,0:32:57.26,Default,,0,0,0,,Ах, а...
Dialogue: 0,0:33:00.47,0:33:01.52,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:33:01.64,0:33:02.64,Default,,0,0,0,,тым кеш.
Dialogue: 0,0:33:02.77,0:33:05.06,Default,,0,0,0,,Шулы! Тезірек ұстаңыз!
Dialogue: 0,0:33:05.19,0:33:06.15,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:33:08.56,0:33:10.11,Default,,0,0,0,,♬ Бос соңғы бетте
Dialogue: 0,0:33:11.82,0:33:13.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:13.53,0:33:16.11,Default,,0,0,0,,Уау (Жылан тас) Иә?
Dialogue: 0,0:33:17.28,0:33:19.12,Default,,0,0,0,,Кууууууууу
Dialogue: 0,0:33:19.24,0:33:20.99,Default,,0,0,0,,Уау! (қылыш тісті жолбарыстың айқайы)
Dialogue: 0,0:33:21.12,0:33:22.54,Default,,0,0,0,,(Вампирлердің соғыс айғайы)
Dialogue: 0,0:33:22.75,0:33:23.75,Default,,0,0,0,,Ммм
Dialogue: 0,0:33:24.00,0:33:24.91,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:25.04,0:33:27.79,Default,,0,0,0,,(Нобисукенің айқайы)
Dialogue: 0,0:33:27.92,0:33:29.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:29.71,0:33:32.00,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:33:32.13,0:33:33.01,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:38.59,0:33:40.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:33:43.27,0:33:46.02,Default,,0,0,0,,Соқыңыз! Жарайды... жарайды
Dialogue: 0,0:33:47.06,0:33:48.06,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:33:48.48,0:33:50.52,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:51.23,0:33:52.98,Default,,0,0,0,,(Екі адам айғайлайды)
Dialogue: 0,0:33:53.19,0:33:56.28,Default,,0,0,0,,(Диатриманың айқайы)
Dialogue: 0,0:33:56.40,0:33:57.36,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:33:57.49,0:33:58.53,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:33:58.66,0:33:59.99,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:34:00.32,0:34:01.45,Default,,0,0,0,,(айқай)
Dialogue: 0,0:34:09.25,0:34:10.25,Default,,0,0,0,,Уф
Dialogue: 0,0:34:11.13,0:34:12.05,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,0:34:12.38,0:34:14.21,Default,,0,0,0,,(айқай)
Dialogue: 0,0:34:18.63,0:34:19.97,Default,,0,0,0,,(айқай)
Dialogue: 0,0:34:23.68,0:34:25.85,Default,,0,0,0,,(Қылыш тісті жолбарыстың айқайы)
Dialogue: 0,0:34:28.98,0:34:30.23,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:34:32.23,0:34:33.19,Default,,0,0,0,,Саранд (Нобисуке) Уау
Dialogue: 0,0:34:34.36,0:34:35.32,Default,,0,0,0,,Данкон (Кураджоның айқайы)
Dialogue: 0,0:34:35.44,0:34:36.99,Default,,0,0,0,,А... не?
Dialogue: 0,0:34:37.11,0:34:38.74,Default,,0,0,0,,Уа уай уай...
Dialogue: 0,0:34:39.20,0:34:40.16,Default,,0,0,0,,Данкон
Dialogue: 0,0:34:40.28,0:34:41.49,Default,,0,0,0,,Данкон (бала) Данкон
Dialogue: 0,0:34:41.74,0:34:43.91,Default,,0,0,0,,Не... не айтып тұрсың?
Dialogue: 0,0:34:44.04,0:34:46.45,Default,,0,0,0,,Меаномо Эста Скола
Dialogue: 0,0:34:46.58,0:34:47.66,Default,,0,0,0,,А...
Dialogue: 0,0:34:47.79,0:34:48.96,Default,,0,0,0,,Дианомо
Dialogue: 0,0:34:49.33,0:34:52.67,Default,,0,0,0,,А... не? Мен білмеймін
Dialogue: 0,0:34:53.17,0:34:54.75,Default,,0,0,0,,Номо Номо
Dialogue: 0,0:34:54.88,0:34:55.84,Default,,0,0,0,,Жоқ... Жоқ па?
Dialogue: 0,0:34:55.96,0:34:58.88,Default,,0,0,0,,Иә! номо одеколон
Dialogue: 0,0:34:59.01,0:35:00.68,Default,,0,0,0,,Номо Куррагьо
Dialogue: 0,0:35:00.80,0:35:02.18,Default,,0,0,0,,Do~
Dialogue: 0,0:35:02.51,0:35:04.76,Default,,0,0,0,,Nomo Colon
Dialogue: 0,0:35:04.89,0:35:06.64,Default,,0,0,0,,Номо Куррагьо
Dialogue: 0,0:35:11.77,0:35:13.94,Default,,0,0,0,,Nomo Colon
Dialogue: 0,0:35:14.07,0:35:15.53,Default,,0,0,0,,Түсіндім!
Dialogue: 0,0:35:16.03,0:35:18.40,Default,,0,0,0,,Ха, сіз менің атымды естідіңіз бе?
Dialogue: 0,0:35:18.53,0:35:19.53,Default,,0,0,0,,Жасау~
Dialogue: 0,0:35:19.65,0:35:20.99,Default,,0,0,0,,Менің атым...
Dialogue: 0,0:35:21.20,0:35:23.99,Default,,0,0,0,,А-а-а-а-а...
Dialogue: 0,0:35:24.12,0:35:27.66,Default,,0,0,0,,Ум... уф
Dialogue: 0,0:35:27.79,0:35:30.75,Default,,0,0,0,,Ой, бұл не?
Dialogue: 0,0:35:30.96,0:35:32.58,Default,,0,0,0,,Нандакке?
Dialogue: 0,0:35:32.71,0:35:35.59,Default,,0,0,0,,Әй, Нан Дак!
Dialogue: 0,0:35:35.71,0:35:37.71,Default,,0,0,0,,Не? (Бала) Нан Дакке!
Dialogue: 0,0:35:37.84,0:35:39.76,Default,,0,0,0,,Дакке (бала) Дакке
Dialogue: 0,0:35:40.17,0:35:41.51,Default,,0,0,0,,Салудон Дак
Dialogue: 0,0:35:41.63,0:35:43.34,Default,,0,0,0,,Салудон (бала) Салудон
Dialogue: 0,0:35:44.55,0:35:47.31,Default,,0,0,0,,Дак Дак Дианомо
Dialogue: 0,0:35:47.43,0:35:49.31,Default,,0,0,0,,Үйрек!
Dialogue: 0,0:35:51.02,0:35:52.77,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:35:53.15,0:35:54.61,Default,,0,0,0,,Әр жолы
Dialogue: 0,0:35:54.73,0:35:57.23,Default,,0,0,0,,Жөндеу аяқталғаннан кейін біз сізге хабарласамыз.
Dialogue: 0,0:35:57.36,0:35:59.03,Default,,0,0,0,,Түсінікті (Бизнесмен) Рахмет.
Dialogue: 0,0:35:59.15,0:36:00.57,Default,,0,0,0,,Нобита?
Dialogue: 0,0:36:00.70,0:36:01.78,Default,,0,0,0,,Нобита!
Dialogue: 0,0:36:02.86,0:36:05.16,Default,,0,0,0,,Нобита жаңа ғана шықты.
Dialogue: 0,0:36:05.28,0:36:08.04,Default,,0,0,0,,Сіз сыртқа шықтыңыз ба? Қайда?
Dialogue: 0,0:36:08.16,0:36:13.29,Default,,0,0,0,,«Джианнан кек ал!» деді. сондықтан бұл жәндіктердің сумосы деп ойлаймын.
Dialogue: 0,0:36:13.42,0:36:14.92,Default,,0,0,0,,Қазірдің өзінде...
Dialogue: 0,0:36:15.59,0:36:18.00,Default,,0,0,0,,Ешбір көмексіз жай ғана ойнау
Dialogue: 0,0:36:18.13,0:36:22.72,Default,,0,0,0,,Хахахаха Балалардың өздерінің әлеуметтік қарым-қатынастары бар.
Dialogue: 0,0:36:22.84,0:36:26.55,Default,,0,0,0,,Сен сондай тәттісің, Нобита.
Dialogue: 0,0:36:26.68,0:36:28.26,Default,,0,0,0,,Мен солай ойлаймын. Иә.
Dialogue: 0,0:36:28.68,0:36:31.73,Default,,0,0,0,,Хахаха, солай шығар.
Dialogue: 0,0:36:32.48,0:36:37.06,Default,,0,0,0,,Нобитаның дүниеге келген күні есіңізде ме?
Dialogue: 0,0:36:37.94,0:36:40.61,Default,,0,0,0,,Иә, жақсы есімде.
Dialogue: 0,0:36:40.74,0:36:42.32,Default,,0,0,0,,Бұл ұл бала.
Dialogue: 0,0:36:42.45,0:36:46.20,Default,,0,0,0,,А... Гочисусу мырза, о, жоқ, солай.
Dialogue: 0,0:36:46.99,0:36:50.20,Default,,0,0,0,,Сәби осында. А, қобалжымаңыз.
Dialogue: 0,0:36:50.87,0:36:52.58,Default,,0,0,0,,Ухх~
Dialogue: 0,0:36:52.71,0:36:54.67,Default,,0,0,0,,О, қандай сүйкімді!
Dialogue: 0,0:36:55.96,0:36:58.04,Default,,0,0,0,,Нобита Ноби
Dialogue: 0,0:36:58.92,0:37:02.34,Default,,0,0,0,,Мен сенің денің сау, қолыңнан келгенше өскеніңді қалаймын.
Dialogue: 0,0:37:02.47,0:37:05.05,Default,,0,0,0,,Тілектеріңізбен қойған есім
Dialogue: 0,0:37:05.51,0:37:09.10,Default,,0,0,0,,Сіз менің жақсы бала болып өскенімді қалайсыз дедіңіз.
Dialogue: 0,0:37:09.22,0:37:10.01,Default,,0,0,0,,Иә
Dialogue: 0,0:37:14.44,0:37:18.27,Default,,0,0,0,,Сіздердің арқаларыңызда сол бала өсіп келеді.
Dialogue: 0,0:37:18.40,0:37:20.69,Default,,0,0,0,,Бұл тым көп созылу.
Dialogue: 0,0:37:20.94,0:37:21.86,Default,,0,0,0,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,0:37:21.98,0:37:25.24,Default,,0,0,0,,Хахаха, бұл әрине босаңсытады.
Dialogue: 0,0:37:25.36,0:37:26.99,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе
Dialogue: 0,0:37:27.11,0:37:28.62,Default,,0,0,0,,(Рей) Ой, жоқ~ Өте жақын қалдым~
Dialogue: 0,0:37:28.74,0:37:30.53,Default,,0,0,0,,Сонда да, иә?
Dialogue: 0,0:37:30.99,0:37:35.29,Default,,0,0,0,,Нобита біздің баламыз болғанына қуаныштымыз.
Dialogue: 0,0:37:41.00,0:37:46.38,Default,,0,0,0,,Мен Нобита туралы ойласам, мен бұл жерде әрқашан ыстық сезінемін.
Dialogue: 0,0:37:48.72,0:37:51.93,Default,,0,0,0,,Иә, күн жылы болады.
Dialogue: 0,0:38:04.69,0:38:08.74,Default,,0,0,0,,Нобитаның арқасында біз қазір бақыттымыз.
Dialogue: 0,0:38:09.20,0:38:10.95,Default,,0,0,0,,Бұл жеткілікті
Dialogue: 0,0:38:11.08,0:38:12.03,Default,,0,0,0,,Иә
Dialogue: 0,0:38:12.74,0:38:14.75,Default,,0,0,0,,Сондықтан мен жалғастырамын-
Dialogue: 0,0:38:14.87,0:38:17.83,Default,,0,0,0,,Мен сіз бен Нобита үшін қолымнан келгеннің бәрін жасауға тырысамын.
Dialogue: 0,0:38:17.96,0:38:18.83,Default,,0,0,0,,Дора-чан да
Dialogue: 0,0:38:19.17,0:38:21.96,Default,,0,0,0,,О, әрине, бар күшімді саламын.
Dialogue: 0,0:38:22.50,0:38:25.13,Default,,0,0,0,,Өйткені Дораемон - біздің отбасымыз.
Dialogue: 0,0:38:25.26,0:38:26.47,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:38:27.47,0:38:29.55,Default,,0,0,0,,Сатып алуға сәттілік
Dialogue: 0,0:38:29.68,0:38:30.89,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:38:31.01,0:38:32.76,Default,,0,0,0,,Хмм, мен?
Dialogue: 0,0:38:32.89,0:38:34.93,Default,,0,0,0,,Біздің бақытымыз үшін
Dialogue: 0,0:38:35.06,0:38:36.81,Default,,0,0,0,,Маған не енгізгендерін ешкім білмейді.
Dialogue: 0,0:38:36.93,0:38:39.94,Default,,0,0,0,,Енді мен Нобитамен бірге баг сумосына баратын болдым.
Dialogue: 0,0:38:40.48,0:38:44.07,Default,,0,0,0,,Қате сумо ма? Бұл біртүрлі
Dialogue: 0,0:38:44.36,0:38:47.40,Default,,0,0,0,,Кабута осында... Ах!
Dialogue: 0,0:38:48.78,0:38:50.99,Default,,0,0,0,,(Стефани) Сол сөзіңді қайтарып ал. (Сора) Ә?
Dialogue: 0,0:38:51.20,0:38:53.66,Default,,0,0,0,,Жарайды, басыңыз! Қаттырақ итеріңіз!
Dialogue: 0,0:38:53.99,0:38:55.87,Default,,0,0,0,,Жоғалтпа, Қабутодаке!
Dialogue: 0,0:38:56.00,0:38:59.08,Default,,0,0,0,,Ондай жігітті мета-мета-жігітке айналдырыңыз!
Dialogue: 0,0:38:59.37,0:39:01.42,Default,,0,0,0,,Бұл тамаша! таңқаларлық!
Dialogue: 0,0:39:01.54,0:39:02.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:39:02.54,0:39:05.55,Default,,0,0,0,,Ах (Сунео) Хахахахаха қашып кеттім.
Dialogue: 0,0:39:07.13,0:39:09.26,Default,,0,0,0,,Хахаха... мен жеңілдім
Dialogue: 0,0:39:09.38,0:39:11.59,Default,,0,0,0,,Мені жеңе алмайтын сияқтысың
Dialogue: 0,0:39:11.72,0:39:13.68,Default,,0,0,0,,(Сунеоның күлкісі)
Dialogue: 0,0:39:13.80,0:39:15.81,Default,,0,0,0,,Иесі – тез қашатын...
Dialogue: 0,0:39:15.93,0:39:17.60,Default,,0,0,0,,Меншік иесі кім?
Dialogue: 0,0:39:17.73,0:39:18.93,Default,,0,0,0,,Өйткені бұл жақсы
Dialogue: 0,0:39:19.14,0:39:20.06,Default,,0,0,0,,Хахаха
Dialogue: 0,0:39:20.19,0:39:22.52,Default,,0,0,0,,Нобита-сан, бұл Кабутоға не болды?
Dialogue: 0,0:39:22.98,0:39:26.61,Default,,0,0,0,,Дұрыс, мұндай ғажайып дулығаны қайдан таптың?
Dialogue: 0,0:39:26.73,0:39:29.82,Default,,0,0,0,,Хахахахаха бұл құпия
Dialogue: 0,0:39:29.95,0:39:31.36,Default,,0,0,0,,Нобита!
Dialogue: 0,0:39:31.49,0:39:33.16,Default,,0,0,0,,Аххх (Нобита) иә... сәлем
Dialogue: 0,0:39:33.28,0:39:35.37,Default,,0,0,0,,«Сәлем» деген не?
Dialogue: 0,0:39:35.49,0:39:37.08,Default,,0,0,0,,Нобита-кун қорғалатын аумақтан —
Dialogue: 0,0:39:37.20,0:39:39.00,Default,,0,0,0,,Тірі заттарды рұқсатсыз шығарсаң жақсы емес.
Dialogue: 0,0:39:39.12,0:39:40.04,Default,,0,0,0,,Дора-чан, бұл
Dialogue: 0,0:39:40.50,0:39:41.33,Default,,0,0,0,,Дораемон
Dialogue: 0,0:39:41.46,0:39:42.75,Default,,0,0,0,,Иә... ақыры келді!
Dialogue: 0,0:39:43.29,0:39:44.38,Default,,0,0,0,,Не? Не?
Dialogue: 0,0:39:44.50,0:39:45.96,Default,,0,0,0,,ауырсынатын ауырсынатын ауырсынатын
Dialogue: 0,0:39:47.71,0:39:49.55,Default,,0,0,0,,(Барлығының қорқынышты дауыстары)
Dialogue: 0,0:39:49.92,0:39:51.97,Default,,0,0,0,,(Дораэмонның ыңырсыуы)
Dialogue: 0,0:39:52.09,0:39:54.68,Default,,0,0,0,,Хабуруруруру Авававава...
Dialogue: 0,0:39:55.64,0:39:59.06,Default,,0,0,0,,(Дораэмонның қиын дауысы)
Dialogue: 0,0:40:12.03,0:40:13.03,Default,,0,0,0,,ол немесе сенімге толы қуғыншы,
Dialogue: 0,0:40:13.32,0:40:14.91,Default,,0,0,0,,Әлі таба алмай жүрсіз бе?
Dialogue: 0,0:40:15.03,0:40:17.49,Default,,0,0,0,,Кешіріңіз, Шерман мырза.
Dialogue: 0,0:40:17.74,0:40:20.70,Default,,0,0,0,,Мен сөзге араласып кете жаздадым.
Dialogue: 0,0:40:20.83,0:40:22.33,Default,,0,0,0,,Бұл аянышты.
Dialogue: 0,0:40:22.46,0:40:25.13,Default,,0,0,0,,Қылыш тісті жолбарыстан қашу
Dialogue: 0,0:40:25.25,0:40:28.42,Default,,0,0,0,,Бұл күтпеген оқиға болды.
Dialogue: 0,0:40:28.55,0:40:29.59,Default,,0,0,0,,Уф
Dialogue: 0,0:40:30.13,0:40:32.22,Default,,0,0,0,,Сіз немен айналысып жатырсыз?
Dialogue: 0,0:40:32.34,0:40:34.47,Default,,0,0,0,,Егер сіз Алтын Геркулесті алғыңыз келсе...
Dialogue: 0,0:40:34.59,0:40:36.22,Default,,0,0,0,,Не істегеніңіз маңызды емес.
Dialogue: 0,0:40:36.55,0:40:38.97,Default,,0,0,0,,Жолыңызға кедергі келтіретін кез келген адамды құртыңыз!
Dialogue: 0,0:40:39.10,0:40:39.77,Default,,0,0,0,,Хаха
Dialogue: 0,0:40:43.81,0:40:47.02,Default,,0,0,0,,Енді біз бұрынғы жерімізге орала аламыз.
Dialogue: 0,0:40:49.19,0:40:51.24,Default,,0,0,0,,Ережелерді сақтаңыз
Dialogue: 0,0:40:51.36,0:40:53.20,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:40:54.32,0:40:55.91,Default,,0,0,0,,Мм... (Келли) Иә?
Dialogue: 0,0:40:56.03,0:40:58.66,Default,,0,0,0,,Доктор Келли неге мұнда?
Dialogue: 0,0:40:58.78,0:40:59.74,Default,,0,0,0,,Уау
Dialogue: 0,0:41:00.16,0:41:02.54,Default,,0,0,0,,Мен осы аралда тұрамын, себебі...
Dialogue: 0,0:41:02.66,0:41:06.63,Default,,0,0,0,,Бұл жануарлардың неліктен жойылып кеткенін зерттеңіз.
Dialogue: 0,0:41:06.92,0:41:09.50,Default,,0,0,0,,Ал одан әрі жойылып кетпес үшін...
Dialogue: 0,0:41:09.63,0:41:12.59,Default,,0,0,0,,Мен не істеуім керек? Бұл зерттеу үшін.
Dialogue: 0,0:41:13.55,0:41:14.47,Default,,0,0,0,,Уау, маған ұнамайды.
Dialogue: 0,0:41:14.59,0:41:16.34,Default,,0,0,0,,Бұл не? (Сунео) А?
Dialogue: 0,0:41:17.14,0:41:18.26,Default,,0,0,0,,Сонымен қатар,
Dialogue: 0,0:41:18.35,0:41:22.31,Default,,0,0,0,,Бұл арал ежелгі заманнан бері тылсым күшпен қорғалған.
Dialogue: 0,0:41:22.43,0:41:24.23,Default,,0,0,0,,Жұмбақ күш?
Dialogue: 0,0:41:24.35,0:41:26.56,Default,,0,0,0,,Шамамен 65 миллион жыл бұрын—
Dialogue: 0,0:41:26.69,0:41:29.11,Default,,0,0,0,,Бұл аралда өмір сүруін жалғастырады дейді.
Dialogue: 0,0:41:29.23,0:41:33.11,Default,,0,0,0,,Алтын қоңыз, Алтын Геркулестің күші
Dialogue: 0,0:41:33.24,0:41:35.11,Default,,0,0,0,,Иә? Алтын?
Dialogue: 0,0:41:35.24,0:41:36.45,Default,,0,0,0,,Қоңыз?
Dialogue: 0,0:41:36.78,0:41:37.91,Default,,0,0,0,,Алтын…
Dialogue: 0,0:41:38.03,0:41:38.99,Default,,0,0,0,,Геркулес
Dialogue: 0,0:41:39.49,0:41:41.99,Default,,0,0,0,,Иә, Алтын Геркулес —
Dialogue: 0,0:41:42.12,0:41:45.04,Default,,0,0,0,,Мәңгілік өмір бар деп айта ма?
Dialogue: 0,0:41:45.16,0:41:48.71,Default,,0,0,0,,Бұл ғана емес, бізді қоршаған барлық тіршілік иелері...
Dialogue: 0,0:41:48.83,0:41:52.00,Default,,0,0,0,,Тіршілік қуатын арттыратын күші бар дейді.
Dialogue: 0,0:41:52.51,0:41:54.92,Default,,0,0,0,,Мен сенімен бір рет болса да кездескім келеді
Dialogue: 0,0:41:55.05,0:41:58.97,Default,,0,0,0,,Мен де сол тылсым күштің сырын ашқым келеді.
Dialogue: 0,0:41:59.26,0:42:00.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:02.51,0:42:05.68,Default,,0,0,0,,Дораемон! Мүмкін бұл менің әкемнің суреті шығар?
Dialogue: 0,0:42:05.81,0:42:07.23,Default,,0,0,0,,Олай емес.
Dialogue: 0,0:42:07.35,0:42:09.02,Default,,0,0,0,,Сонда сен қайдасың?
Dialogue: 0,0:42:09.15,0:42:10.69,Default,,0,0,0,,Алтын гетаклдер
Dialogue: 0,0:42:11.27,0:42:14.15,Default,,0,0,0,,Такеши мырза, бұл «Hetacles» емес.
Dialogue: 0,0:42:14.28,0:42:16.40,Default,,0,0,0,,Иә Алтын Геркулес
Dialogue: 0,0:42:16.53,0:42:17.70,Default,,0,0,0,,Міне, солай.
Dialogue: 0,0:42:18.36,0:42:20.57,Default,,0,0,0,,Сіздің аралда екеніңізге сенімдімін, бірақ...
Dialogue: 0,0:42:20.70,0:42:22.99,Default,,0,0,0,,Мен сенің қайда екеніңді де білмеймін
Dialogue: 0,0:42:23.12,0:42:25.66,Default,,0,0,0,,Иә! ? (Нобита) Солай ма?
Dialogue: 0,0:42:26.33,0:42:28.25,Default,,0,0,0,,Доктор Келли (Келли) Иә?
Dialogue: 0,0:42:28.37,0:42:30.50,Default,,0,0,0,,Мен аралға қонуға бола ма?
Dialogue: 0,0:42:30.63,0:42:32.38,Default,,0,0,0,,Иә? (Келли) Неге?
Dialogue: 0,0:42:33.05,0:42:35.13,Default,,0,0,0,,Ол жануарлар тірі...
Dialogue: 0,0:42:35.26,0:42:37.76,Default,,0,0,0,,Оның қозғалғанын көру керемет.
Dialogue: 0,0:42:37.88,0:42:40.80,Default,,0,0,0,,Мен оның қандай екенін көргім келеді.
Dialogue: 0,0:42:41.26,0:42:44.14,Default,,0,0,0,,Осыны ойлаудың өзі мені толқытады.
Dialogue: 0,0:42:44.27,0:42:45.27,Default,,0,0,0,,Мен де!
Dialogue: 0,0:42:45.39,0:42:46.23,Default,,0,0,0,,Мен де (Сунео) Мен де
Dialogue: 0,0:42:46.81,0:42:49.81,Default,,0,0,0,,Өтінемін! Доктор Келли
Dialogue: 0,0:42:50.23,0:42:51.36,Default,,0,0,0,,Егер өзіңді жақсы ұстасаң, мен саған зиян тигізбеймін.
Dialogue: 0,0:42:52.57,0:42:54.98,Default,,0,0,0,,Гонсуке, барлығына айналаны көрсет.
Dialogue: 0,0:42:55.11,0:42:58.24,Default,,0,0,0,,(Нобита мен оның достары қуанады)
Dialogue: 0,0:43:03.66,0:43:05.74,Default,,0,0,0,,Доктор Келли, қайда?
Dialogue: 0,0:43:05.87,0:43:08.54,Default,,0,0,0,,Бұл уақыт туннелі. Мен оны тексеруге бардым.
Dialogue: 0,0:43:08.66,0:43:09.62,Default,,0,0,0,,Хмм.
Dialogue: 0,0:43:09.75,0:43:11.67,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:43:18.97,0:43:20.18,Default,,0,0,0,,Дабыр!
Dialogue: 0,0:43:20.30,0:43:23.43,Default,,0,0,0,,Әлгі әйелдің көзі ауырады.
Dialogue: 0,0:43:32.15,0:43:33.52,Default,,0,0,0,,Шамасы—
Dialogue: 0,0:43:33.65,0:43:37.19,Default,,0,0,0,,Ол үлкен нәрсе соқтығысқанда жасалған сияқты.
Dialogue: 0,0:43:37.32,0:43:38.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:41.86,0:43:45.41,Default,,0,0,0,,Міне... Кецалькоатлус
Dialogue: 0,0:43:49.46,0:43:51.75,Default,,0,0,0,,Ууууууууу!
Dialogue: 0,0:43:51.96,0:43:52.79,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:53.38,0:43:55.84,Default,,0,0,0,,(Кветалькоатлус айқайы)
Dialogue: 0,0:43:57.30,0:43:57.96,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:43:58.09,0:44:00.17,Default,,0,0,0,,Жапырақтарды жеу
Dialogue: 0,0:44:00.30,0:44:01.76,Default,,0,0,0,,Сен тірісің бе? Бұл
Dialogue: 0,0:44:01.88,0:44:04.18,Default,,0,0,0,,Хахаха
Dialogue: 0,0:44:04.97,0:44:06.14,Default,,0,0,0,,Сіз жақсы көрінесіз.
Dialogue: 0,0:44:06.26,0:44:07.31,Default,,0,0,0,,Толығырақ
Dialogue: 0,0:44:07.43,0:44:10.14,Default,,0,0,0,,Уау! Татата... маған көмектес
Dialogue: 0,0:44:10.27,0:44:11.10,Default,,0,0,0,,Иян
Dialogue: 0,0:44:14.98,0:44:19.99,Default,,0,0,0,,Дааааааааааааааааааааааааааа...
Dialogue: 0,0:44:20.11,0:44:21.07,Default,,0,0,0,,Осы жолы сен жұмсаған күшіңе сай нәтижеге қол жеткіздің—
Dialogue: 0,0:44:21.20,0:44:22.36,Default,,0,0,0,,Шешім емес пе?
Dialogue: 0,0:44:23.16,0:44:26.12,Default,,0,0,0,,Біз Алтын Хеннакулдарды ұстаймыз.
Dialogue: 0,0:44:26.24,0:44:27.58,Default,,0,0,0,,Геркулес!
Dialogue: 0,0:44:27.70,0:44:28.79,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:44:28.91,0:44:30.12,Default,,0,0,0,,Хмм...
Dialogue: 0,0:44:31.21,0:44:35.33,Default,,0,0,0,,Бірақ мұндағы тіршілік иелерін ұстауға тыйым салынған...
Dialogue: 0,0:44:35.46,0:44:38.30,Default,,0,0,0,,Сіз оны аралдан шығармасаңыз, бәрі жақсы болады.
Dialogue: 0,0:44:38.42,0:44:41.80,Default,,0,0,0,,Оны ерте ұстап алып, Нобитаны таң қалдырайық.
Dialogue: 0,0:44:42.22,0:44:43.26,Default,,0,0,0,,Ах!
Dialogue: 0,0:44:43.84,0:44:44.84,Default,,0,0,0,,Не болды?
Dialogue: 0,0:44:44.97,0:44:47.22,Default,,0,0,0,,Сонымен... (Сунео) А?
Dialogue: 0,0:44:49.26,0:44:50.68,Default,,0,0,0,,Жақсы, жақсы...
Dialogue: 0,0:44:50.81,0:44:53.81,Default,,0,0,0,,Джа Джа Джа Джай... Джиан
Dialogue: 0,0:44:53.94,0:44:55.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:44:55.44,0:44:57.15,Default,,0,0,0,,(Эласмотерийдің үруі)
Dialogue: 0,0:44:57.40,0:44:59.07,Default,,0,0,0,,Гия!
Dialogue: 0,0:44:59.19,0:44:59.98,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:00.82,0:45:01.99,Default,,0,0,0,,(Джианның айқайы)
Dialogue: 0,0:45:02.28,0:45:04.41,Default,,0,0,0,,Не... Не?
Dialogue: 0,0:45:05.03,0:45:06.74,Default,,0,0,0,,Қаш, Нобита!
Dialogue: 0,0:45:07.32,0:45:08.37,Default,,0,0,0,,Не? Апыр-ай!
Dialogue: 0,0:45:08.49,0:45:09.91,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:45:10.29,0:45:13.91,Default,,0,0,0,,Вааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:45:14.04,0:45:16.46,Default,,0,0,0,,Бұл... қиын! Маған көмектесші!
Dialogue: 0,0:45:17.29,0:45:19.42,Default,,0,0,0,,Ваааааааааа?
Dialogue: 0,0:45:19.55,0:45:20.67,Default,,0,0,0,,Уау уау уау...
Dialogue: 0,0:45:20.80,0:45:22.05,Default,,0,0,0,,Уау аа
Dialogue: 0,0:45:22.17,0:45:23.01,Default,,0,0,0,,Уау
Dialogue: 0,0:45:26.05,0:45:27.68,Default,,0,0,0,,(Сунео мен оның достарының қорқынышты дауыстары)
Dialogue: 0,0:45:27.80,0:45:29.47,Default,,0,0,0,,Анашым! Ахх
Dialogue: 0,0:45:29.60,0:45:31.27,Default,,0,0,0,,Маған көмектесіңіз~
Dialogue: 0,0:45:31.39,0:45:32.98,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,0:45:33.68,0:45:35.27,Default,,0,0,0,,Егер сізде бұл бар болса!
Dialogue: 0,0:45:35.39,0:45:36.60,Default,,0,0,0,,Кез келген жерде орындаңыз...
Dialogue: 0,0:45:36.73,0:45:39.06,Default,,0,0,0,,Ахххх
Dialogue: 0,0:45:40.07,0:45:41.98,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,0:45:42.73,0:45:45.20,Default,,0,0,0,,Ах! Барлық жерде есіктер бар!
Dialogue: 0,0:45:45.32,0:45:47.45,Default,,0,0,0,,Жарайды, кейде осындай
Dialogue: 0,0:45:47.57,0:45:49.62,Default,,0,0,0,,Момотаро мөрі...
Dialogue: 0,0:45:49.74,0:45:52.29,Default,,0,0,0,,Иә? Жоқ... жоқ!
Dialogue: 0,0:45:52.41,0:45:53.75,Default,,0,0,0,,Ах!
Dialogue: 0,0:45:54.25,0:45:56.67,Default,,0,0,0,,А, көмектесші, итерме, итерме
Dialogue: 0,0:45:56.79,0:45:58.92,Default,,0,0,0,,Сонда... міне, солай!
Dialogue: 0,0:45:59.50,0:46:01.84,Default,,0,0,0,,Жалған Робот Делюкс
Dialogue: 0,0:46:01.96,0:46:04.88,Default,,0,0,0,,(Үйректердің айқайы)
Dialogue: 0,0:46:05.01,0:46:06.30,Default,,0,0,0,,Вашой
Dialogue: 0,0:46:06.43,0:46:07.76,Default,,0,0,0,,Вашой
Dialogue: 0,0:46:08.26,0:46:09.60,Default,,0,0,0,,Вашой
Dialogue: 0,0:46:10.43,0:46:12.43,Default,,0,0,0,,Васшои Васшои
Dialogue: 0,0:46:12.56,0:46:13.77,Default,,0,0,0,,Васшои Васшои
Dialogue: 0,0:46:13.85,0:46:14.64,Default,,0,0,0,,(Эласмотерийдің үруі)
Dialogue: 0,0:46:14.64,0:46:16.69,Default,,0,0,0,,(Эласмотерийдің үруі)
Dialogue: 0,0:46:14.64,0:46:16.69,Default,,0,0,0,,Васшои Васшои
Dialogue: 0,0:46:16.81,0:46:18.52,Default,,0,0,0,,Васшои Васшои
Dialogue: 0,0:46:18.98,0:46:20.90,Default,,0,0,0,,Васшои Васшои
Dialogue: 0,0:46:21.02,0:46:23.03,Default,,0,0,0,,Васшои Васшои
Dialogue: 0,0:46:23.15,0:46:25.24,Default,,0,0,0,,Васшои Васшои
Dialogue: 0,0:46:25.36,0:46:27.91,Default,,0,0,0,,Уасшои вашой вашой вашой…
Dialogue: 0,0:46:28.36,0:46:31.78,Default,,0,0,0,,Ол көзге түскендіктен, көңілім ауып, сонда бардым.
Dialogue: 0,0:46:31.91,0:46:32.83,Default,,0,0,0,,Хмм...
Dialogue: 0,0:46:32.95,0:46:35.45,Default,,0,0,0,,Жақсы (Сунео) Иә, жақсы.
Dialogue: 0,0:46:35.58,0:46:36.58,Default,,0,0,0,,Ах...
Dialogue: 0,0:46:37.08,0:46:38.50,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:46:39.12,0:46:40.17,Default,,0,0,0,,Гуах (курадхо) жасаңыз!
Dialogue: 0,0:46:40.29,0:46:41.46,Default,,0,0,0,,Уау
Dialogue: 0,0:46:42.04,0:46:43.34,Default,,0,0,0,,Ншо (Сунео) Йойшо
Dialogue: 0,0:46:43.46,0:46:44.59,Default,,0,0,0,,(Итадори) Медуза шикигами! Ішке кірсе, соққылар әсер етпейді ме?
Dialogue: 0,0:46:44.71,0:46:47.76,Default,,0,0,0,,Бұл сәби додо. Бұл сүйкімді.
Dialogue: 0,0:46:48.09,0:46:49.05,Default,,0,0,0,,Куррагио
Dialogue: 0,0:46:49.18,0:46:52.39,Default,,0,0,0,,Уау, ау, ауырып тұр...
Dialogue: 0,0:46:52.76,0:46:53.85,Default,,0,0,0,,Бұл ыңғайсыз.
Dialogue: 0,0:46:53.97,0:46:55.31,Default,,0,0,0,,Нобитаға ұқсайды
Dialogue: 0,0:46:55.64,0:46:57.31,Default,,0,0,0,,Амансың ба? (Нобита) Эй
Dialogue: 0,0:46:57.43,0:46:58.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:46:58.48,0:47:00.44,Default,,0,0,0,,Барлығы осы жерде болды
Dialogue: 0,0:47:00.77,0:47:03.07,Default,,0,0,0,,Иә! ? Уф
Dialogue: 0,0:47:03.19,0:47:05.53,Default,,0,0,0,,Ау, ауырып тұр...
Dialogue: 0,0:47:07.24,0:47:08.61,Default,,0,0,0,,Иә! о қымбаттым
Dialogue: 0,0:47:09.28,0:47:11.03,Default,,0,0,0,,(Дораэмонның таңданған дауысы)
Dialogue: 0,0:47:11.45,0:47:12.91,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:13.03,0:47:14.95,Default,,0,0,0,,Ши... Шизука-чан
Dialogue: 0,0:47:15.20,0:47:16.20,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:16.54,0:47:19.62,Default,,0,0,0,,Шамасы мен екеуміз.
Dialogue: 0,0:47:19.75,0:47:20.42,Default,,0,0,0,,Иә...
Dialogue: 0,0:47:21.00,0:47:22.92,Default,,0,0,0,,Иә, ол кім? Сіз
Dialogue: 0,0:47:23.04,0:47:23.96,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:47:24.09,0:47:27.26,Default,,0,0,0,,Балалар сендер бұрынғы аңшылармен доссыңдар ма?
Dialogue: 0,0:47:27.38,0:47:30.13,Default,,0,0,0,,Уа, сен Нобитаға ұқсайсың, бірақ сен сондай тәкаппарсың.
Dialogue: 0,0:47:30.26,0:47:32.89,Default,,0,0,0,,Біз оны сыпайы етіп жасаймыз ба? иә?
Dialogue: 0,0:47:33.01,0:47:34.26,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,0:47:34.60,0:47:36.06,Default,,0,0,0,,Хмм...
Dialogue: 0,0:47:36.18,0:47:38.98,Default,,0,0,0,,Әй, аңшы дегенді қалай түсінесің?
Dialogue: 0,0:47:39.10,0:47:39.98,Default,,0,0,0,,Жоқ... жоқ?
Dialogue: 0,0:47:40.60,0:47:41.65,Default,,0,0,0,,Сіз нені айтасыз?
Dialogue: 0,0:47:41.77,0:47:42.69,Default,,0,0,0,,Келіңіздер
Dialogue: 0,0:47:43.02,0:47:45.94,Default,,0,0,0,,Біз аңшы емеспіз.
Dialogue: 0,0:47:46.07,0:47:47.23,Default,,0,0,0,,Жаса
Dialogue: 0,0:47:47.36,0:47:49.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:49.65,0:47:50.65,Default,,0,0,0,,Жасау
Dialogue: 0,0:47:51.03,0:47:53.95,Default,,0,0,0,,Ей, тағы бір қызық нәрсе болды.
Dialogue: 0,0:47:54.07,0:47:56.16,Default,,0,0,0,,Бірақ бұл сүйкімді
Dialogue: 0,0:47:56.29,0:47:59.66,Default,,0,0,0,,Сіз кімсіз? Сен қай жақтансын?
Dialogue: 0,0:47:59.79,0:48:00.71,Default,,0,0,0,,Келісуші
Dialogue: 0,0:48:01.00,0:48:02.17,Default,,0,0,0,,Уау? (Сунео) А?
Dialogue: 0,0:48:02.62,0:48:04.63,Default,,0,0,0,,Марбона Агресанто
Dialogue: 0,0:48:05.04,0:48:08.71,Default,,0,0,0,,Не? А, мен білмеймін.
Dialogue: 0,0:48:08.84,0:48:11.72,Default,,0,0,0,,Қос нүкте: Мен аңшы емеспін.
Dialogue: 0,0:48:11.84,0:48:13.18,Default,,0,0,0,,Әй?
Dialogue: 0,0:48:13.30,0:48:15.72,Default,,0,0,0,,Балалар сендер бір-біріңді таныдыңдар ма?
Dialogue: 0,0:48:17.26,0:48:19.43,Default,,0,0,0,,Do Furbo
Dialogue: 0,0:48:19.68,0:48:21.23,Default,,0,0,0,,Ах (Сунео) Ах...
Dialogue: 0,0:48:21.35,0:48:22.85,Default,,0,0,0,,Ах...
Dialogue: 0,0:48:23.73,0:48:25.81,Default,,0,0,0,,Альместатр
Dialogue: 0,0:48:25.90,0:48:28.82,Default,,0,0,0,,Agrabre Konatygekube
Dialogue: 0,0:48:28.94,0:48:29.86,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:48:29.99,0:48:31.99,Default,,0,0,0,,Әй, сен не айттың?
Dialogue: 0,0:48:32.11,0:48:34.66,Default,,0,0,0,,Болма... менен сұрама.
Dialogue: 0,0:48:35.24,0:48:37.28,Default,,0,0,0,,Хоньяку Коньяку
Dialogue: 0,0:48:37.53,0:48:41.12,Default,,0,0,0,,Мен Оро, Рокколо тайпасының басшысымын.
Dialogue: 0,0:48:41.25,0:48:43.33,Default,,0,0,0,,Ал мына бала менің немерем...
Dialogue: 0,0:48:43.46,0:48:44.67,Default,,0,0,0,,қос нүкте
Dialogue: 0,0:48:44.79,0:48:47.79,Default,,0,0,0,,Ал мынау батыр Дакке-сама.
Dialogue: 0,0:48:47.92,0:48:48.75,Default,,0,0,0,,Хехехе
Dialogue: 0,0:48:49.25,0:48:50.88,Default,,0,0,0,,Батыл Дакке?
Dialogue: 0,0:48:51.01,0:48:52.38,Default,,0,0,0,,Біртүрлі атау
Dialogue: 0,0:48:52.51,0:48:53.72,Default,,0,0,0,,Мен Нобитамын
Dialogue: 0,0:48:54.09,0:48:55.22,Default,,0,0,0,,I Джан
Dialogue: 0,0:48:55.34,0:48:56.47,Default,,0,0,0,,Бұл Сунео.
Dialogue: 0,0:48:56.60,0:48:58.22,Default,,0,0,0,,Мен тынышпын
Dialogue: 0,0:48:58.35,0:49:00.14,Default,,0,0,0,,I Дораемон
Dialogue: 0,0:49:01.02,0:49:02.48,Default,,0,0,0,,Жасау
Dialogue: 0,0:49:02.60,0:49:04.90,Default,,0,0,0,,Сүйкімді
Dialogue: 0,0:49:05.94,0:49:08.19,Default,,0,0,0,,Хехе, танысқаныма қуаныштымын.
Dialogue: 0,0:49:08.32,0:49:10.61,Default,,0,0,0,,Ей, біз енді доспыз.
Dialogue: 0,0:49:10.98,0:49:14.45,Default,,0,0,0,,Олар жаман адамдар емес сияқты.
Dialogue: 0,0:49:14.78,0:49:18.33,Default,,0,0,0,,Қаласаңыз, біздің ауылға барып демалуға болады.
Dialogue: 0,0:49:18.74,0:49:20.54,Default,,0,0,0,,Иә (Нобита) Шынымен бе?
Dialogue: 0,0:49:20.66,0:49:23.75,Default,,0,0,0,,Хехе
Dialogue: 0,0:49:24.08,0:49:24.79,Default,,0,0,0,,Ойлағанымдай, жұдырығыммен тиіп,
Dialogue: 0,0:49:25.29,0:49:28.92,Default,,0,0,0,,Дораэмон тез
Dialogue: 0,0:49:49.40,0:49:50.61,Default,,0,0,0,,Бұл маған сыртқы түрі жағынан да шайтандардың алуан түрлі болатынын шын түсінуге көмектеседі.
Dialogue: 0,0:49:50.73,0:49:51.65,Default,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,0:49:51.98,0:49:55.82,Default,,0,0,0,,Рокколо ауылына қош келдіңіз!
Dialogue: 0,0:49:56.20,0:49:59.83,Default,,0,0,0,,Дайын болғанша өзіңізді сергек сезінесіз деп үміттенемін.
Dialogue: 0,0:50:01.03,0:50:02.83,Default,,0,0,0,,Бұл ең жақсы!
Dialogue: 0,0:50:02.95,0:50:04.79,Default,,0,0,0,,Бұл жақсы ыстық бұлақ.
Dialogue: 0,0:50:04.91,0:50:05.87,Default,,0,0,0,,Иә
Dialogue: 0,0:50:06.42,0:50:07.54,Default,,0,0,0,,Уау (Нобита/Дакке) Уау
Dialogue: 0,0:50:13.92,0:50:14.84,Default,,0,0,0,,Ухахаха
Dialogue: 0,0:50:14.97,0:50:18.18,Default,,0,0,0,,Әй, бұл екеуінің қорқынышты жолдары бірдей.
Dialogue: 0,0:50:18.30,0:50:21.51,Default,,0,0,0,,Не? Ахаха мен көремін.
Dialogue: 0,0:50:21.64,0:50:23.18,Default,,0,0,0,,Қос нобита
Dialogue: 0,0:50:23.31,0:50:24.52,Default,,0,0,0,,«Қос нобита»! ?
Dialogue: 0,0:50:24.73,0:50:26.23,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:50:26.35,0:50:28.52,Default,,0,0,0,,Бүгіннен бастап екеуміз «Қос нобита» боламыз.
Dialogue: 0,0:50:30.69,0:50:31.94,Default,,0,0,0,,Сонымен... болды.
Dialogue: 0,0:50:32.07,0:50:33.03,Default,,0,0,0,,Қалжың емес!
Dialogue: 0,0:50:33.23,0:50:35.03,Default,,0,0,0,,О, дәл солай
Dialogue: 0,0:50:35.15,0:50:38.03,Default,,0,0,0,,Хахаха, Double Нобита күткендей
Dialogue: 0,0:50:38.91,0:50:40.16,Default,,0,0,0,,Ха~
Dialogue: 0,0:50:40.91,0:50:41.74,Default,,0,0,0,,Әй?
Dialogue: 0,0:50:42.62,0:50:43.45,Default,,0,0,0,,Жасау
Dialogue: 0,0:50:43.74,0:50:46.96,Default,,0,0,0,,Ах, кешіріңіз. Сіз қарауға келдіңіз бе?
Dialogue: 0,0:50:47.08,0:50:50.33,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:50:50.46,0:50:52.29,Default,,0,0,0,,♪Додо
Dialogue: 0,0:50:52.42,0:50:53.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:50:54.55,0:50:58.34,Default,,0,0,0,,(Додоның ән айту дауысы)
Dialogue: 0,0:50:58.72,0:50:59.72,Default,,0,0,0,,Хехехе
Dialogue: 0,0:50:59.84,0:51:01.05,Default,,0,0,0,,Шизука-сан
Dialogue: 0,0:51:01.18,0:51:02.01,Default,,0,0,0,,Иә
Dialogue: 0,0:51:02.22,0:51:04.72,Default,,0,0,0,,Мен сенің киіміңді осында қалдырамын.
Dialogue: 0,0:51:05.85,0:51:08.56,Default,,0,0,0,,Ах, уау...
Dialogue: 0,0:51:10.27,0:51:12.90,Default,,0,0,0,,О, сүйкімді. (Әйел) Саған өте жақсы көрінеді.
Dialogue: 0,0:51:13.48,0:51:15.28,Default,,0,0,0,,Балалар, сендер де бірге әдемі көрінесіңдер.
Dialogue: 0,0:51:15.40,0:51:16.49,Default,,0,0,0,,Жоқ
Dialogue: 0,0:51:16.61,0:51:18.70,Default,,0,0,0,,Бұл орын алады.
Dialogue: 0,0:51:19.70,0:51:21.78,Default,,0,0,0,,Сен сондай сүйкімдісің
Dialogue: 0,0:51:21.91,0:51:24.87,Default,,0,0,0,,«Сүйкімді» Ахахха…
Dialogue: 0,0:51:29.62,0:51:34.17,Default,,0,0,0,,Шерман мырза, бұл әйел ештеңе білмейді.
Dialogue: 0,0:51:34.29,0:51:35.80,Default,,0,0,0,,Неге бұлай істеп жатырсың?
Dialogue: 0,0:51:36.13,0:51:40.26,Default,,0,0,0,,Ой, ақша үшін шешілген шығар.
Dialogue: 0,0:51:40.63,0:51:42.09,Default,,0,0,0,,Мені құлыптаңыз! Хаха
Dialogue: 0,0:51:42.22,0:51:43.09,Default,,0,0,0,,Ах
Dialogue: 0,0:51:43.22,0:51:45.85,Default,,0,0,0,,Қара, Хун.
Dialogue: 0,0:51:47.02,0:51:50.94,Default,,0,0,0,,Алтын Геркулес қайда орналасқан? Тез табыңыз!
Dialogue: 0,0:51:51.06,0:51:54.61,Default,,0,0,0,,Менің ұсынысым бар... Жоқ, менде стратегия бар.
Dialogue: 0,0:51:54.73,0:51:55.69,Default,,0,0,0,,«Мен бірде сенімен жақсылап сөйлескім келеді.»
Dialogue: 0,0:51:56.53,0:51:57.82,Default,,0,0,0,,Иә
Dialogue: 0,0:52:05.78,0:52:07.91,Default,,0,0,0,,Уау, үлкен банан
Dialogue: 0,0:52:09.75,0:52:10.91,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:52:11.41,0:52:12.58,Default,,0,0,0,,Мен бір қолымда оқпен жүктелген винтовка ұстап тұрмын
Dialogue: 0,0:52:12.71,0:52:16.55,Default,,0,0,0,,Мен дәмді тамақ жейтін адамдарды жақсы көремін.
Dialogue: 0,0:52:18.26,0:52:19.71,Default,,0,0,0,,Бо... маған да бер!
Dialogue: 0,0:52:19.84,0:52:21.38,Default,,0,0,0,,Иә, көп тамақтаныңыз.
Dialogue: 0,0:52:22.18,0:52:23.22,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:52:23.34,0:52:25.14,Default,,0,0,0,,Рахмет
Dialogue: 0,0:52:25.26,0:52:26.56,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:52:26.68,0:52:28.77,Default,,0,0,0,,Мм... бұл не?
Dialogue: 0,0:52:28.89,0:52:30.60,Default,,0,0,0,,Айдаһар жемісі
Dialogue: 0,0:52:30.73,0:52:31.98,Default,,0,0,0,,Жұмбақ дәм
Dialogue: 0,0:52:33.44,0:52:34.94,Default,,0,0,0,,Бұл өте дәмді
Dialogue: 0,0:52:35.31,0:52:40.94,Default,,0,0,0,,Хмм, аа, иә, иә, біз де кешкі ас ішейік.
Dialogue: 0,0:52:41.07,0:52:42.57,Default,,0,0,0,,Ах!
Dialogue: 0,0:52:42.70,0:52:43.78,Default,,0,0,0,,Қандай стратегия?
Dialogue: 0,0:52:44.57,0:52:46.24,Default,,0,0,0,,Рокколо тайпасының басшысына —
Dialogue: 0,0:52:46.37,0:52:48.70,Default,,0,0,0,,Менің өте жақсы көретін немерем бар.
Dialogue: 0,0:52:49.33,0:52:50.75,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,0:52:50.87,0:52:52.66,Default,,0,0,0,,Егер сіз баланы кепілге алсаңыз —
Dialogue: 0,0:52:53.37,0:52:55.00,Default,,0,0,0,,Сөзсіз
Dialogue: 0,0:52:55.25,0:52:58.00,Default,,0,0,0,,Иә? Хи хи хи
Dialogue: 0,0:53:09.31,0:53:12.52,Default,,0,0,0,,Әй, менің ішім тоқ болғаны сонша, ауырады.
Dialogue: 0,0:53:12.64,0:53:15.44,Default,,0,0,0,,Сол үлкен банан...
Dialogue: 0,0:53:15.56,0:53:18.44,Default,,0,0,0,,Мен оны Джианнан күткендей екі тістеп жей аламын.
Dialogue: 0,0:53:18.57,0:53:23.57,Default,,0,0,0,,Хи хи, бұл жай таңғы ас, жоқ, кешкі ас.
Dialogue: 0,0:53:25.03,0:53:26.16,Default,,0,0,0,,Дораемон Иә?
Dialogue: 0,0:53:26.28,0:53:27.74,Default,,0,0,0,,Оны менің дулығаммен ауыстыр
Dialogue: 0,0:53:27.87,0:53:28.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:29.28,0:53:32.87,Default,,0,0,0,,Көрдің бе, бұл Нобита-кунның дулығасы.
Dialogue: 0,0:53:33.00,0:53:35.67,Default,,0,0,0,,Не? Нобитаны алмастыратын бала
Dialogue: 0,0:53:35.79,0:53:36.79,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:53:36.92,0:53:38.25,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:53:38.38,0:53:40.09,Default,,0,0,0,,Не болса да
Dialogue: 0,0:53:40.21,0:53:41.05,Default,,0,0,0,,Нобита
Dialogue: 0,0:53:41.17,0:53:42.01,Default,,0,0,0,,Жоқ, жоқ
Dialogue: 0,0:53:45.30,0:53:46.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:53:46.26,0:53:48.72,Default,,0,0,0,,Нобитаны алмастыратын бала
Dialogue: 0,0:53:49.43,0:53:50.89,Default,,0,0,0,,Жоқ десең, жоқ!
Dialogue: 0,0:53:51.14,0:53:52.85,Default,,0,0,0,,Нобита-кун...
Dialogue: 0,0:53:54.73,0:53:56.27,Default,,0,0,0,,Нобитаның ақымақ!
Dialogue: 0,0:53:56.56,0:53:57.98,Default,,0,0,0,,Уау!
Dialogue: 0,0:53:58.10,0:54:00.15,Default,,0,0,0,,Ахх (авро) бұл қос нүкте
Dialogue: 0,0:54:00.27,0:54:02.19,Default,,0,0,0,,Иә!
Dialogue: 0,0:54:02.44,0:54:03.94,Default,,0,0,0,,Додо До
Dialogue: 0,0:54:04.07,0:54:07.82,Default,,0,0,0,,Бұл менің кінәм емес! Нобита кінәлі!
Dialogue: 0,0:54:08.82,0:54:11.12,Default,,0,0,0,,Кішкентай балалармен не істеп жатырсың?
Dialogue: 0,0:54:11.24,0:54:12.20,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:13.54,0:54:14.41,Default,,0,0,0,,Мистер Дак
Dialogue: 0,0:54:14.54,0:54:16.58,Default,,0,0,0,,Неге сонша ашуланасың?
Dialogue: 0,0:54:16.87,0:54:18.00,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:54:18.12,0:54:19.58,Default,,0,0,0,,Бірақ жоқ
Dialogue: 0,0:54:20.42,0:54:21.42,Default,,0,0,0,,Нобита-сан
Dialogue: 0,0:54:21.54,0:54:22.59,Default,,0,0,0,,Иә
Dialogue: 0,0:54:22.80,0:54:26.09,Default,,0,0,0,,Сол баланы кешіріңіз.
Dialogue: 0,0:54:26.22,0:54:29.22,Default,,0,0,0,,Себебі мен оны бір еркекпен өсірдім.
Dialogue: 0,0:54:29.34,0:54:31.93,Default,,0,0,0,,Мен өзімшіл балаға айналдым.
Dialogue: 0,0:54:32.43,0:54:35.64,Default,,0,0,0,,Сонда Колонның анасы мен әкесі ше...
Dialogue: 0,0:54:35.77,0:54:37.56,Default,,0,0,0,,Ол бала бір жасқа толғанда...
Dialogue: 0,0:54:37.69,0:54:42.02,Default,,0,0,0,,(Қолонның күлкісі)
Dialogue: 0,0:54:42.15,0:54:43.19,Default,,0,0,0,,Иә?
Dialogue: 0,0:54:46.70,0:54:48.82,Default,,0,0,0,,А? Сол жігіт
Dialogue: 0,0:54:50.87,0:54:52.45,Default,,0,0,0,,Бұрынғы үшін кешіріңіз.
Dialogue: 0,0:54:52.58,0:54:55.33,Default,,0,0,0,,Бұл маған әкем сатып алған дулыға.
Dialogue: 0,0:54:55.45,0:54:57.79,Default,,0,0,0,,Сол кезде мен әкеме уәде бердім.
Dialogue: 0,0:54:58.54,0:55:01.17,Default,,0,0,0,,Мен сені жақсы көремін, уәде беремін.
Dialogue: 0,0:55:01.29,0:55:02.50,Default,,0,0,0,,Жарайды, мен уәде беремін.
Dialogue: 0,0:55:03.34,0:55:05.30,Default,,0,0,0,,♪Саусақпен кесу Генман
Dialogue: 0,0:55:05.42,0:55:10.43,Default,,0,0,0,,♪Өтірік айтсаң 1000 ине ішемін.
Dialogue: 0,0:55:10.93,0:55:14.39,Default,,0,0,0,,Сондықтан кешіріңіз, мен сізді алмастыра алмаймын.
Dialogue: 0,0:55:14.76,0:55:15.89,Default,,0,0,0,,Хмм...
Dialogue: 0,0:55:16.02,0:55:19.60,Default,,0,0,0,,Егер солай болса, бас тартудан басқа амалың жоқ.
Dialogue: 0,0:55:19.73,0:55:22.27,Default,,0,0,0,,Иә, сен уәдеңде тұруың керек.
Dialogue: 0,0:55:22.40,0:55:23.36,Default,,0,0,0,,Ах~ Ол тірі!
Dialogue: 0,0:55:23.48,0:55:24.86,Default,,0,0,0,,Сонымен, (Даке Колон) иә?
Dialogue: 0,0:55:25.36,0:55:28.95,Default,,0,0,0,,Біз қайтып келгенше сақтағаныңызды қалаймын.
Dialogue: 0,0:55:30.95,0:55:31.78,Default,,0,0,0,,Ах...
Dialogue: 0,0:55:32.45,0:55:33.28,Default,,0,0,0,,Иә
Dialogue: 0,0:55:33.62,0:55:36.95,Default,,0,0,0,,Иә! Ұстап тұрыңыз
Dialogue: 0,0:55:45.34,0:55:46.92,Default,,0,0,0,,Нобита?
Dialogue: 0,0:55:47.13,0:55:48.97,Default,,0,0,0,,Әке қандай адам?
Dialogue: 0,0:55:49.09,0:55:50.88,Default,,0,0,0,,Хмм...
Dialogue: 0,0:55:51.18,0:55:53.34,Default,,0,0,0,,Қарапайым айтсаң да
Dialogue: 0,0:55:53.60,0:55:56.85,Default,,0,0,0,,Аа, Нобитаның әкесі Нобитаға ұқсайды.
Dialogue: 0,0:55:56.97,0:55:59.77,Default,,0,0,0,,Екеумізді де мама жиі ұрысады, хаха.
Dialogue: 0,0:56:00.27,0:56:03.23,Default,,0,0,0,,Маған да анам үнемі айғайлайды.
Dialogue: 0,0:56:03.36,0:56:04.23,Default,,0,0,0,,Шынымен бе?
Dialogue: 0,0:56:04.52,0:56:07.40,Default,,0,0,0,,0 ұпай Алған кезде қиын болады.
Dialogue: 0,0:56:07.53,0:56:09.53,Default,,0,0,0,,Нобита! қайтадан 0 ұпай
Dialogue: 0,0:56:09.99,0:56:12.36,Default,,0,0,0,,Жоғарыдан төменге дейін барлығы кресттерге толы
Dialogue: 0,0:56:12.49,0:56:15.49,Default,,0,0,0,,Әйтсе де, Папа мен Дораемон білмейді.
Dialogue: 0,0:56:16.33,0:56:19.33,Default,,0,0,0,,Е, солай деп ойлаймын хаха
Dialogue: 0,0:56:19.45,0:56:23.58,Default,,0,0,0,,Әй, мен сияқты бақытсыз бала жоқ деп ойлаймын.
Dialogue: 0,0:56:23.83,0:56:28.21,Default,,0,0,0,,Әй, анамды танымайсың ғой, солай дейсің.
Dialogue: 0,0:56:28.34,0:56:30.55,Default,,0,0,0,,Мен қатты тырыссам да...
Dialogue: 0,0:56:31.09,0:56:34.51,Default,,0,0,0,,«Бұрышты кеспеңіз, оны байыпты түрде жасаңыз»
Dialogue: 0,0:56:34.97,0:56:38.26,Default,,0,0,0,,Олар менің баламның сезімін мүлде түсінбейді.
Dialogue: 0,0:56:39.06,0:56:42.14,Default,,0,0,0,,Шынында да, бұл күндері ата-анаға келгенде,
Dialogue: 0,0:56:42.27,0:56:44.69,Default,,0,0,0,,Тіпті Шун Амакури менің үйіме келгенде
Dialogue: 0,0:56:44.81,0:56:47.44,Default,,0,0,0,,Шун Амакури Сунеоның үйінде ме?
Dialogue: 0,0:56:48.69,0:56:52.15,Default,,0,0,0,,Сәлеметсіз бе, бұл Куритто сергітетін Амагури Шун.
Dialogue: 0,0:56:52.65,0:56:54.99,Default,,0,0,0,,Сунео-кун екеуміз жақсы доспыз.
Dialogue: 0,0:56:55.28,0:56:58.24,Default,,0,0,0,,Мен барлығына өзімді таныстырғым келді.
Dialogue: 0,0:56:58.37,0:57:01.12,Default,,0,0,0,,Сонда да анам маған агрессивті болғаныма ашуланады.
Dialogue: 0,0:57:01.66,0:57:03.71,Default,,0,0,0,,Жалпы айтқанда, анам туралы айтатын болсақ...
Dialogue: 0,0:57:03.83,0:57:05.25,Default,,0,0,0,,Ой, күте тұрыңыз...
Dialogue: 0,0:57:05.38,0:57:07.00,Default,,0,0,0,,Маған неге қоңырау шалмадың?
Dialogue: 0,0:57:07.00,0:57:08.21,Default,,0,0,0,,Неге мені шақырмадың?
Dialogue: 0,0:57:07.00,0:57:08.21,Default,,0,0,0,,Мистер Польнареф
Dialogue: 0,0:57:08.34,0:57:08.67,Default,,0,0,0,,'Otoishi-kun' деп жазып қойыңызшы
Dialogue: 0,0:57:08.67,0:57:09.59,Default,,0,0,0,,'Otoishi-kun' деп жазып қойыңызшы
Dialogue: 0,0:57:08.67,0:57:09.59,Default,,0,0,0,,Мен де Амакуримен кездескім келеді
Dialogue: 0,0:57:09.59,0:57:09.71,Default,,0,0,0,,Мен де Амакуримен кездескім келеді
Dialogue: 0,0:57:09.71,0:57:10.96,Default,,0,0,0,,Мен де Амакуримен кездескім келеді
Dialogue: 0,0:57:09.71,0:57:10.96,Default,,0,0,0,,Ауырды, ауырады, ауырады
Dialogue: 0,0:57:10.96,0:57:11.55,Default,,0,0,0,,Ауырды, ауырады, ауырады
Dialogue: 0,0:57:15.47,0:57:16.72,Default,,0,0,0,,Әлі-
Dialogue: 0,0:57:16.85,0:57:19.68,Default,,0,0,0,,Әкем, анам және Дораемон...
Dialogue: 0,0:57:19.81,0:57:22.27,Default,,0,0,0,,Барлығымыз рамен жеуге шыққанда...
Dialogue: 0,0:57:22.77,0:57:24.73,Default,,0,0,0,,Әйтеуір қатты қуандым.
Dialogue: 0,0:57:24.98,0:57:26.06,Default,,0,0,0,,Мен берілмеймін. Бір адамның да өлуіне жол бермеймін
Dialogue: 0,0:57:26.19,0:57:30.23,Default,,0,0,0,,Бір нәрсе жеу немесе бүкіл отбасымен бір жерге бару...
Dialogue: 0,0:57:30.36,0:57:33.07,Default,,0,0,0,,Бұл біз үшін өте жақсы, солай емес пе?
Dialogue: 0,0:57:33.19,0:57:34.07,Default,,0,0,0,,Иә
Dialogue: 0,0:57:36.82,0:57:39.41,Default,,0,0,0,,Мен анам мен әкем туралы ойласам—
Dialogue: 0,0:57:39.53,0:57:42.50,Default,,0,0,0,,Бұл жерде әрқашан жылы сезінеді.
Dialogue: 0,0:57:42.62,0:57:47.63,Default,,0,0,0,,♪～
Dialogue: 0,0:58:07.48,0:58:12.48,Default,,0,0,0,,～♪
Dialogue: 0,0:58:12.61,0:58:16.15,Default,,0,0,0,,Иә, жылы болады.
Dialogue: 0,0:58:16.28,0:58:18.16,Default,,0,0,0,,А, өте жылы
Dialogue: 0,0:58:18.28,0:58:22.04,Default,,0,0,0,,Иә, ата-ана да адам ғой.
Dialogue: 0,0:58:22.16,0:58:26.46,Default,,0,0,0,,Түсінбеушіліктен кейде ашуланамын, кейде ашуланамын.
Dialogue: 0,0:58:28.37,0:58:30.63,Default,,0,0,0,,Менің әкем мен анам...
Dialogue: 0,0:58:31.09,0:58:33.59,Default,,0,0,0,,Мен үйдемін, анам мен әкем.
Dialogue: 0,0:58:34.05,0:58:38.30,Default,,0,0,0,,Ол менің ең жақсы көретін адамым және ең маңызды адамым.
Dialogue: 0,0:58:38.89,0:58:40.14,Default,,0,0,0,,Иә
Dialogue: 0,0:58:42.97,0:58:47.56,Default,,0,0,0,,Мен ең жақсы көретін және ең көп көңіл бөлетін адам...
Dialogue: 0,0:58:50.23,0:58:51.36,Default,,0,0,0,,Ах
Dialogue: 0,0:58:55.53,0:58:57.74,Default,,0,0,0,,А, қазір күн жылы.
Dialogue: 0,0:58:58.15,0:59:00.11,Default,,0,0,0,,Мен атамды ойладым.
Dialogue: 0,0:59:00.24,0:59:01.70,Default,,0,0,0,,Иә, хехе
Dialogue: 0,0:59:01.99,0:59:03.53,Default,,0,0,0,,Хахаха
Dialogue: 0,0:59:04.66,0:59:05.66,Default,,0,0,0,,Хехе
Dialogue: 0,0:59:06.41,0:59:08.08,Default,,0,0,0,,Хехехехехе
Dialogue: 0,0:59:09.29,0:59:10.96,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:59:18.17,0:59:20.55,Default,,0,0,0,,(Екі адам күледі)
Dialogue: 0,0:59:20.68,0:59:22.51,Default,,0,0,0,,А-а, ауырады, менің ішім ауырады... (Нобита) Мм.
Dialogue: 0,0:59:22.64,0:59:24.60,Default,,0,0,0,,(Қос нүктелердің күлкісі)
Dialogue: 0,0:59:26.93,0:59:27.89,Default,,0,0,0,,Не болды?
Dialogue: 0,0:59:29.14,0:59:32.19,Default,,0,0,0,,Менің ойымша, Double Нобита сурет салған жоқ.
Dialogue: 0,0:59:32.31,0:59:33.94,Default,,0,0,0,,Колонның өтініші бойынша.
Dialogue: 0,0:59:34.07,0:59:34.90,Default,,0,0,0,,Иә
Dialogue: 0,0:59:35.48,0:59:37.69,Default,,0,0,0,,Нобита-кун, бұл қандай сурет?
Dialogue: 0,0:59:37.82,0:59:40.36,Default,,0,0,0,,Иә...бұл Даккенің суреті.
Dialogue: 0,0:59:40.86,0:59:44.16,Default,,0,0,0,,Аа, бұл Кураджо, бұл дәмді.
Dialogue: 0,0:59:44.28,0:59:46.41,Default,,0,0,0,,Бұл Нобита-кунның суреті ме?
Dialogue: 0,0:59:46.54,0:59:47.75,Default,,0,0,0,,Ух... иә
Dialogue: 0,0:59:47.87,0:59:49.12,Default,,0,0,0,,Уху-уу-хмм
Dialogue: 0,0:59:49.25,0:59:50.04,Default,,0,0,0,,Бұл қалай?
Dialogue: 0,0:59:50.16,0:59:52.54,Default,,0,0,0,,Сіз мұндай нашар суретті бұрын-соңды көрмегенсіз, солай ма?
Dialogue: 0,0:59:52.67,0:59:54.21,Default,,0,0,0,,Сіз мұны жақсы емессіз бе? (Нобита) Иә?
Dialogue: 0,0:59:54.34,0:59:55.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:59:55.80,0:59:59.05,Default,,0,0,0,,Сіз құбыжықтарды өте жақсы тартасыз!
Dialogue: 0,0:59:59.17,1:00:02.18,Default,,0,0,0,,Дорэмон құбыжық емес
Dialogue: 0,1:00:02.30,1:00:05.51,Default,,0,0,0,,Иә? Уау, кездейсоқ, бұл...
Dialogue: 0,1:00:05.64,1:00:07.97,Default,,0,0,0,,Дұрыс, бұл Кларжо.
Dialogue: 0,1:00:08.10,1:00:10.27,Default,,0,0,0,,Куррагио! (Кюрахо) Жаса
Dialogue: 0,1:00:12.73,1:00:16.61,Default,,0,0,0,,Уау, сен қаншалықты жамансың?
Dialogue: 0,1:00:16.73,1:00:20.36,Default,,0,0,0,,Қазірдің өзінде! Мен де Дораэмонды мазақ еттім.
Dialogue: 0,1:00:20.49,1:00:21.99,Default,,0,0,0,,Ах Нобита-кун
Dialogue: 0,1:00:22.11,1:00:24.20,Default,,0,0,0,,Аа, дұрыс! (Нобита) А?
Dialogue: 0,1:00:24.45,1:00:28.83,Default,,0,0,0,,Соны пайдалансаңыз... Иә? Қайда бардың? Ой
Dialogue: 0,1:00:28.95,1:00:31.08,Default,,0,0,0,,Нобита-кун, аздап ұста.
Dialogue: 0,1:00:31.21,1:00:34.38,Default,,0,0,0,,Ем... о хмм мінеки!
Dialogue: 0,1:00:35.08,1:00:36.96,Default,,0,0,0,,Нобита-кун, пайдаланып көріңіз
Dialogue: 0,1:00:37.09,1:00:38.00,Default,,0,0,0,,Не?Бұл
Dialogue: 0,1:00:38.13,1:00:39.34,Default,,0,0,0,,Пневматикалық қарындаш
Dialogue: 0,1:00:39.92,1:00:42.63,Default,,0,0,0,,Түсіндім, сіз жақсы сурет сала аласыз.
Dialogue: 0,1:00:42.76,1:00:43.97,Default,,0,0,0,,Ум (Нобита) Иә?
Dialogue: 0,1:00:44.09,1:00:47.76,Default,,0,0,0,,Бұл ауада еркін сурет салуға мүмкіндік беретін қарындаш.
Dialogue: 0,1:00:48.31,1:00:49.47,Default,,0,0,0,,0 ұпай алды!
Dialogue: 0,1:00:49.60,1:00:50.89,Default,,0,0,0,,Таныс Нобита
Dialogue: 0,1:00:51.02,1:00:52.56,Default,,0,0,0,,0 ұпай!
Dialogue: 0,1:00:52.69,1:00:55.23,Default,,0,0,0,,О... Әй?
Dialogue: 0,1:00:55.48,1:00:57.57,Default,,0,0,0,,Менің айтқым келгені бұл емес.
Dialogue: 0,1:00:58.48,1:01:00.57,Default,,0,0,0,,Маған бұл керек емес.
Dialogue: 0,1:01:00.82,1:01:03.65,Default,,0,0,0,,Сурет салуды жақсы білетін адам қолдануы керек.
Dialogue: 0,1:01:04.28,1:01:06.41,Default,,0,0,0,,Дак мырза, Кабутаны салыңыз.
Dialogue: 0,1:01:06.53,1:01:08.24,Default,,0,0,0,,Ұлы соғыс аяқталғаннан бері—
Dialogue: 0,1:01:10.70,1:01:12.79,Default,,0,0,0,,(Қос нүктелердің күлкісі)
Dialogue: 0,1:01:15.08,1:01:16.96,Default,,0,0,0,,О, не? не?
Dialogue: 0,1:01:18.50,1:01:20.38,Default,,0,0,0,,Уау, керемет
Dialogue: 0,1:01:20.51,1:01:24.01,Default,,0,0,0,,Сәлем! Фук, Дак мырзаға кедергі жасама.
Dialogue: 0,1:01:24.51,1:01:28.89,Default,,0,0,0,,Хмф! Не, сен Дак мырзаны монополияға алмақшысың ба?
Dialogue: 0,1:01:29.01,1:01:33.10,Default,,0,0,0,,Дұрыс, мен өскенде Дак мырзадай боламын.
Dialogue: 0,1:01:33.23,1:01:34.60,Default,,0,0,0,,Хехе, мен бір бола аламын ба?
Dialogue: 0,1:01:34.73,1:01:36.40,Default,,0,0,0,,Мен мұны істей аламын!
Dialogue: 0,1:01:36.52,1:01:37.48,Default,,0,0,0,,Мен бір бола алмаймын!
Dialogue: 0,1:01:37.61,1:01:38.86,Default,,0,0,0,,Сіз мұны міндетті түрде жасай аласыз!
Dialogue: 0,1:01:38.98,1:01:40.61,Default,,0,0,0,,Мүлдем жоқ!
Dialogue: 0,1:01:40.73,1:01:41.57,Default,,0,0,0,,Хмф!
Dialogue: 0,1:01:41.86,1:01:45.20,Default,,0,0,0,,Жасайсыз ба? додо жасайды
Dialogue: 0,1:01:46.74,1:01:49.58,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,1:01:49.87,1:01:51.24,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:01:51.54,1:01:54.75,Default,,0,0,0,,Бұл суретті Дак мырза түсірді ме? Бұл керемет
Dialogue: 0,1:01:54.87,1:01:55.71,Default,,0,0,0,,Иә
Dialogue: 0,1:01:56.25,1:01:58.63,Default,,0,0,0,,Бұл қамқоршы құдайдың суреті сияқты.
Dialogue: 0,1:01:58.75,1:02:00.17,Default,,0,0,0,,Дұрыс.
Dialogue: 0,1:02:00.38,1:02:01.67,Default,,0,0,0,,Қамқоршы құдай
Dialogue: 0,1:02:01.80,1:02:02.84,Default,,0,0,0,,Қабырға?
Dialogue: 0,1:02:02.96,1:02:05.76,Default,,0,0,0,,Қош бол, Алтын Геркулес.
Dialogue: 0,1:02:05.88,1:02:08.64,Default,,0,0,0,,Алтын Геркулес! ?
Dialogue: 0,1:02:09.18,1:02:11.64,Default,,0,0,0,,Алтын қоңыз
Dialogue: 0,1:02:13.47,1:02:15.56,Default,,0,0,0,,(Нобита мен оның достары қуанады)
Dialogue: 0,1:02:15.81,1:02:20.48,Default,,0,0,0,,Мұны мыңдаған жылдар бұрын ата-бабаларымыз салған.
Dialogue: 0,1:02:20.61,1:02:23.53,Default,,0,0,0,,Біз бұл аралды ерте заманнан қорғап келеміз.
Dialogue: 0,1:02:23.65,1:02:26.53,Default,,0,0,0,,Алтын қоңыз Алтын Геркулес
Dialogue: 0,1:02:26.86,1:02:31.24,Default,,0,0,0,,Біз сол ғажайып күшпен қорғандық.
Dialogue: 0,1:02:32.45,1:02:37.46,Default,,0,0,0,,Егер Алтын Геркулес күшін жоғалтса ше?
Dialogue: 0,1:02:37.58,1:02:41.13,Default,,0,0,0,,Біз және сол күшке арқа сүйеген жануарлар...
Dialogue: 0,1:02:41.42,1:02:44.01,Default,,0,0,0,,Барлығы жойылады.
Dialogue: 0,1:02:44.13,1:02:45.26,Default,,0,0,0,,Иә! ?
Dialogue: 0,1:02:45.38,1:02:46.84,Default,,0,0,0,,Еш нәрсеге қарамастан—
Dialogue: 0,1:02:46.97,1:02:49.76,Default,,0,0,0,,Біз Алтын Гераклды қорғауымыз керек.
Dialogue: 0,1:02:52.05,1:02:54.14,Default,,0,0,0,,(айқай)
Dialogue: 0,1:02:54.27,1:02:58.27,Default,,0,0,0,,Әрине, ол бір орында тұра бермейді ғой?
Dialogue: 0,1:03:00.06,1:03:02.86,Default,,0,0,0,,Алтын Геркулес қайда орналасқан?
Dialogue: 0,1:03:03.52,1:03:08.82,Default,,0,0,0,,Қос нүкте мұны көрген жалғыз адам.
Dialogue: 0,1:03:08.95,1:03:10.32,Default,,0,0,0,,Иә! ?
Dialogue: 0,1:03:10.57,1:03:12.45,Default,,0,0,0,,Иә! Мен көрдім
Dialogue: 0,1:03:12.58,1:03:14.79,Default,,0,0,0,,Мен бұл алқаны сол кезде алдым.
Dialogue: 0,1:03:15.20,1:03:18.25,Default,,0,0,0,,Ол Алтын Геркулестің тасқа айналған мүйізінен жасалған.
Dialogue: 0,1:03:18.54,1:03:20.67,Default,,0,0,0,,Мүйіз қалдықтарынан?
Dialogue: 0,1:03:20.79,1:03:22.79,Default,,0,0,0,,Оны қайдан алдың?
Dialogue: 0,1:03:22.92,1:03:24.25,Default,,0,0,0,,Иә Қай жерде?
Dialogue: 0,1:03:24.38,1:03:25.55,Default,,0,0,0,,Барғыңыз келе ме?
Dialogue: 0,1:03:25.67,1:03:27.26,Default,,0,0,0,,Менің барғым келеді Барғым келеді
Dialogue: 0,1:03:27.38,1:03:30.51,Default,,0,0,0,,Уау Уау Уау...
Dialogue: 0,1:03:41.02,1:03:43.02,Default,,0,0,0,,Бәрің сақ болыңдар, өйткені тайып кетесіңдер.
Dialogue: 0,1:03:43.15,1:03:43.98,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:03:49.53,1:03:52.41,Default,,0,0,0,,Хмм, әлі емес пе?
Dialogue: 0,1:03:52.53,1:03:53.45,Default,,0,0,0,,«Мен… мен адаммын.»
Dialogue: 0,1:03:54.49,1:03:57.79,Default,,0,0,0,,Әй, тамағым кепті.
Dialogue: 0,1:03:58.33,1:03:59.16,Default,,0,0,0,,Әй?
Dialogue: 0,1:03:59.66,1:04:00.67,Default,,0,0,0,,Иә?
Dialogue: 0,1:04:02.79,1:04:04.84,Default,,0,0,0,,Нобита-кун, асығыңыз!
Dialogue: 0,1:04:13.14,1:04:14.14,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,1:04:14.26,1:04:16.47,Default,,0,0,0,,Бұл өмірдің бұлағы.
Dialogue: 0,1:04:16.81,1:04:20.98,Default,,0,0,0,,Жаралы жануарлар су ішуге келеді.
Dialogue: 0,1:04:21.77,1:04:26.40,Default,,0,0,0,,Неге екені белгісіз, осы жердегі суды ішкенде мен өзімді қуаттаймын.
Dialogue: 0,1:04:35.28,1:04:39.70,Default,,0,0,0,,Мен де жараланғанда, Бұлақтан су ішуге келдім.
Dialogue: 0,1:04:40.58,1:04:42.04,Default,,0,0,0,,Содан кейін...
Dialogue: 0,1:04:42.92,1:04:43.92,Default,,0,0,0,,Ах
Dialogue: 0,1:04:45.54,1:04:46.38,Default,,0,0,0,,О
Dialogue: 0,1:04:49.76,1:04:50.92,Default,,0,0,0,,Ах...
Dialogue: 0,1:05:02.14,1:05:05.35,Default,,0,0,0,,Уау! Ах...
Dialogue: 0,1:05:05.73,1:05:09.48,Default,,0,0,0,,Мен мұны білмей тұрып, менің жарақатымның ауыруы жоғалып кетті.
Dialogue: 0,1:05:10.11,1:05:11.53,Default,,0,0,0,,Олай болса, мұнда—
Dialogue: 0,1:05:11.65,1:05:15.57,Default,,0,0,0,,Мен Алтын Геркулестің тас мүйізін таптым.
Dialogue: 0,1:05:16.74,1:05:19.66,Default,,0,0,0,,Сонда жақын жерде ұя бар ма?
Dialogue: 0,1:05:19.79,1:05:23.41,Default,,0,0,0,,Сондықтан бұлақ суын ішу көңіл-күйіңді көтереді.
Dialogue: 0,1:05:23.87,1:05:25.37,Default,,0,0,0,,Қарап көрейік.
Dialogue: 0,1:05:25.50,1:05:28.29,Default,,0,0,0,,Бұл алтын қоңыз ғой.
Dialogue: 0,1:05:28.42,1:05:32.38,Default,,0,0,0,,Менің түйсігім...
Dialogue: 0,1:05:34.51,1:05:36.76,Default,,0,0,0,,Бұл аймақ күдікті!
Dialogue: 0,1:05:36.89,1:05:37.72,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:05:38.01,1:05:39.39,Default,,0,0,0,,Не?
Dialogue: 0,1:05:39.51,1:05:43.52,Default,,0,0,0,,Алтын Геркулес - Рокколо тайпасының маңызды қамқоршы құдайы.
Dialogue: 0,1:05:43.64,1:05:46.69,Default,,0,0,0,,Дұрыс, сіз тек соны бақылап отыруыңыз керек.
Dialogue: 0,1:05:46.94,1:05:47.90,Default,,0,0,0,,Иә
Dialogue: 0,1:05:48.02,1:05:48.90,Default,,0,0,0,,(Ұшу дыбысы)
Dialogue: 0,1:05:49.02,1:05:49.90,Default,,0,0,0,,Ах (Нобита) Уф
Dialogue: 0,1:05:50.23,1:05:53.07,Default,,0,0,0,,А... не? Бұл
Dialogue: 0,1:05:53.61,1:05:55.45,Default,,0,0,0,,А... не?
Dialogue: 0,1:05:55.57,1:05:58.28,Default,,0,0,0,,Ах (Сунео) Бұл Кецалькоатлус!
Dialogue: 0,1:05:58.41,1:06:01.08,Default,,0,0,0,,Эй, бортта біреу бар.
Dialogue: 0,1:06:03.33,1:06:06.17,Default,,0,0,0,,Уау аа
Dialogue: 0,1:06:06.29,1:06:08.25,Default,,0,0,0,,Ол робот па?
Dialogue: 0,1:06:09.21,1:06:12.17,Default,,0,0,0,,А, бұл қиын. Мен Рокколо ауылына бара жатырмын.
Dialogue: 0,1:06:12.30,1:06:14.17,Default,,0,0,0,,Ааах…
Dialogue: 0,1:06:14.55,1:06:18.43,Default,,0,0,0,,Уау!
Dialogue: 0,1:06:23.52,1:06:27.19,Default,,0,0,0,,Е!
Dialogue: 0,1:06:29.44,1:06:30.23,Default,,0,0,0,,Нобита-кун
Dialogue: 0,1:06:30.36,1:06:32.82,Default,,0,0,0,,Мен Коэкамаринді іштім.
Dialogue: 0,1:06:32.94,1:06:33.78,Default,,0,0,0,,Иә
Dialogue: 0,1:06:34.11,1:06:36.74,Default,,0,0,0,,Менің шөлдегенім сонша, мен жай ғана...
Dialogue: 0,1:06:36.86,1:06:38.24,Default,,0,0,0,,Әй, қайтар!
Dialogue: 0,1:06:38.36,1:06:39.45,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,1:06:39.57,1:06:41.37,Default,,0,0,0,,Нобита Бұл керемет (Нобита) Иә?
Dialogue: 0,1:06:41.49,1:06:43.29,Default,,0,0,0,,Мұны тағы бір рет орындаңыз
Dialogue: 0,1:06:43.41,1:06:44.70,Default,,0,0,0,,Жарайды.
Dialogue: 0,1:06:44.83,1:06:46.25,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,1:06:46.37,1:06:47.67,Default,,0,0,0,,Ал 3D маневрлік жабдық ше?
Dialogue: 0,1:06:48.12,1:06:50.33,Default,,0,0,0,,«Кое катамарин» дегеніміз не?
Dialogue: 0,1:06:50.46,1:06:52.75,Default,,0,0,0,,Дорэмонның құпия құралы
Dialogue: 0,1:06:52.88,1:06:55.13,Default,,0,0,0,,Осыны ішіп, айқайласаң...
Dialogue: 0,1:06:55.46,1:06:59.14,Default,,0,0,0,,Даусым бұрынғыдай қатып қалады.
Dialogue: 0,1:06:59.51,1:07:01.18,Default,,0,0,0,,Енді айқайламаңыз
Dialogue: 0,1:07:01.30,1:07:03.06,Default,,0,0,0,,Оны бермеңіз! (Нобита) Дәл солай
Dialogue: 0,1:07:03.18,1:07:05.35,Default,,0,0,0,,Тынш! (Нобита) А... иә
Dialogue: 0,1:07:08.73,1:07:09.69,Default,,0,0,0,,О... бәріңе сәлем
Dialogue: 0,1:07:09.81,1:07:10.65,Default,,0,0,0,,Иә?
Dialogue: 0,1:07:10.77,1:07:11.94,Default,,0,0,0,,Не?
Dialogue: 0,1:07:12.06,1:07:14.48,Default,,0,0,0,,Үйге қайтайық. Мен Рокколо ауылы үшін алаңдаймын.
Dialogue: 0,1:07:14.73,1:07:16.11,Default,,0,0,0,,Ах!
Dialogue: 0,1:07:17.03,1:07:17.95,Default,,0,0,0,,Иә
Dialogue: 0,1:07:19.99,1:07:23.99,Default,,0,0,0,,(Жануарлар үреді)
Dialogue: 0,1:07:26.79,1:07:29.67,Default,,0,0,0,,(Додоның айқайы)
Dialogue: 0,1:07:31.38,1:07:34.63,Default,,0,0,0,,(Ауыл адамдарының үрейлі дауыстары)
Dialogue: 0,1:07:43.35,1:07:44.56,Default,,0,0,0,,Хехехе
Dialogue: 0,1:07:48.98,1:07:50.35,Default,,0,0,0,,Уау!
Dialogue: 0,1:07:59.40,1:08:00.91,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,1:08:01.03,1:08:02.95,Default,,0,0,0,,Уа, ау, ау!
Dialogue: 0,1:08:03.07,1:08:03.87,Default,,0,0,0,,Уау
Dialogue: 0,1:08:03.99,1:08:06.74,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,1:08:14.63,1:08:15.67,Default,,0,0,0,,Оро мырза
Dialogue: 0,1:08:15.80,1:08:18.30,Default,,0,0,0,,Әй, бәрі аман ба?
Dialogue: 0,1:08:18.42,1:08:22.09,Default,,0,0,0,,Иә, бірақ біз оны қалай да тоқтатуымыз керек.
Dialogue: 0,1:08:22.22,1:08:24.30,Default,,0,0,0,,Алдымен Колон-чанды эвакуациялаған дұрыс.
Dialogue: 0,1:08:24.43,1:08:26.43,Default,,0,0,0,,Мен ол рөлді ойнаймын.
Dialogue: 0,1:08:26.56,1:08:29.73,Default,,0,0,0,,О, жоқ, мен төбелескенді ұнатпаймын демеймін.
Dialogue: 0,1:08:29.85,1:08:32.48,Default,,0,0,0,,Қараңдаршы, мен Куррагьоны үнемі бақылап жүрдім.
Dialogue: 0,1:08:32.60,1:08:34.69,Default,,0,0,0,,Мен дұрыс адам ба деп ойладым.
Dialogue: 0,1:08:34.81,1:08:37.40,Default,,0,0,0,,Барлығы да солай ойлайды, солай ма? Ахахха...
Dialogue: 0,1:08:37.82,1:08:39.74,Default,,0,0,0,,Ах...
Dialogue: 0,1:08:40.61,1:08:41.95,Default,,0,0,0,,(айқай)
Dialogue: 0,1:08:42.07,1:08:44.53,Default,,0,0,0,,Алтын Геркулес қайда орналасқан?
Dialogue: 0,1:08:42.07,1:08:44.53,Default,,0,0,0,,(Әйелдердің айқайы)
Dialogue: 0,1:08:44.66,1:08:46.33,Default,,0,0,0,,Уф, ауырып тұр...
Dialogue: 0,1:08:46.45,1:08:48.45,Default,,0,0,0,,Не? а? Не? Сіз аа
Dialogue: 0,1:08:49.12,1:08:51.46,Default,,0,0,0,,Неге, Гонсуке мырза!
Dialogue: 0,1:08:51.58,1:08:53.54,Default,,0,0,0,,Бұл қиын. Ол қатты.
Dialogue: 0,1:08:53.67,1:08:55.25,Default,,0,0,0,,Уау! иә?
Dialogue: 0,1:08:55.38,1:08:57.80,Default,,0,0,0,,О, құдайым
Dialogue: 0,1:08:58.09,1:08:59.55,Default,,0,0,0,,О, ой
Dialogue: 0,1:08:59.67,1:09:03.01,Default,,0,0,0,,(Әйелдердің қошеметі)
Dialogue: 0,1:09:03.13,1:09:06.14,Default,,0,0,0,,Нобита, егер сіз тырыссаңыз, жасай аласыз.
Dialogue: 0,1:09:06.26,1:09:07.35,Default,,0,0,0,,Няхахаха...
Dialogue: 0,1:09:07.47,1:09:10.10,Default,,0,0,0,,А, мен түсіндім, бұл қол бар еді.
Dialogue: 0,1:09:10.52,1:09:11.85,Default,,0,0,0,,Джан, мынаны іш.
Dialogue: 0,1:09:11.98,1:09:12.64,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:12.77,1:09:13.98,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,1:09:14.10,1:09:16.02,Default,,0,0,0,,Иә
Dialogue: 0,1:09:17.40,1:09:20.11,Default,,0,0,0,,А, онша көп ішпе...
Dialogue: 0,1:09:20.23,1:09:21.53,Default,,0,0,0,,Мен оны іштім.
Dialogue: 0,1:09:23.03,1:09:24.11,Default,,0,0,0,,бос
Dialogue: 0,1:09:24.49,1:09:28.24,Default,,0,0,0,,Хахахаха Сен өте әлсізсің, әйтеуір бір мүмкіндікті жіберіп аласың!
Dialogue: 0,1:09:28.37,1:09:30.91,Default,,0,0,0,,Соғыс уақыты келді! Хмф!
Dialogue: 0,1:09:31.04,1:09:34.00,Default,,0,0,0,,Бұл белоб бар! Бұл осылай!
Dialogue: 0,1:09:34.42,1:09:35.96,Default,,0,0,0,,Tsk... hmm?
Dialogue: 0,1:09:42.17,1:09:43.01,Default,,0,0,0,,Мен келе жатырмын
Dialogue: 0,1:09:43.13,1:09:44.22,Default,,0,0,0,,О!
Dialogue: 0,1:09:44.55,1:09:46.18,Default,,0,0,0,,(Екі адамның тыныс алу дыбысы)
Dialogue: 0,1:09:49.35,1:09:50.47,Default,,0,0,0,,Нобита-кун!
Dialogue: 0,1:09:50.60,1:09:52.77,Default,,0,0,0,,Уау!
Dialogue: 0,1:09:53.02,1:09:53.93,Default,,0,0,0,,Джан!
Dialogue: 0,1:09:54.06,1:09:56.60,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,1:10:00.73,1:10:01.86,Default,,0,0,0,,Хехехе
Dialogue: 0,1:10:03.49,1:10:04.45,Default,,0,0,0,,Пами
Dialogue: 0,1:10:05.45,1:10:08.16,Default,,0,0,0,,(Аспанның айқайы)
Dialogue: 0,1:10:10.70,1:10:13.33,Default,,0,0,0,,Қаш! Ававава...
Dialogue: 0,1:10:24.76,1:10:25.88,Default,,0,0,0,,Фу…
Dialogue: 0,1:10:37.94,1:10:39.65,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:39.77,1:10:41.48,Default,,0,0,0,,Ах...
Dialogue: 0,1:10:42.23,1:10:44.32,Default,,0,0,0,,Аа, дұрыс
Dialogue: 0,1:10:44.44,1:10:45.90,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,1:10:46.03,1:10:47.66,Default,,0,0,0,,Жоқ, доктор Келли...
Dialogue: 0,1:10:47.78,1:10:49.66,Default,,0,0,0,,Ол қайтып келмеді.
Dialogue: 0,1:10:56.33,1:11:00.29,Default,,0,0,0,,(Ауыл тұрғындарының шуы)
Dialogue: 0,1:11:07.55,1:11:09.22,Default,,0,0,0,,(Ауыл тұрғындары айқайлайды)
Dialogue: 0,1:11:10.09,1:11:10.93,Default,,0,0,0,,қос нүкте!
Dialogue: 0,1:11:11.05,1:11:11.89,Default,,0,0,0,,Кураджо!
Dialogue: 0,1:11:12.14,1:11:13.64,Default,,0,0,0,,Әй, Сунео-сан!
Dialogue: 0,1:11:13.76,1:11:15.18,Default,,0,0,0,,Сіз ұсталдыңыз ба?
Dialogue: 0,1:11:15.43,1:11:18.56,Default,,0,0,0,,Қараңызшы, егер сіз мына жігіттерге көмектескіңіз келсе—
Dialogue: 0,1:11:18.69,1:11:22.11,Default,,0,0,0,,Алтын Геркулесті Жолбарыс жартасына әкеліңіз.
Dialogue: 0,1:11:22.23,1:11:25.11,Default,,0,0,0,,Ой, тағы бір барымта бар.
Dialogue: 0,1:11:25.36,1:11:27.65,Default,,0,0,0,,Доктор Келли! Не деген
Dialogue: 0,1:11:27.78,1:11:31.87,Default,,0,0,0,,Бүгін күн батқанша күт, мені міндетті түрде әкел.
Dialogue: 0,1:11:31.99,1:11:33.66,Default,,0,0,0,,Не ойнап жүрсің?
Dialogue: 0,1:11:34.28,1:11:36.58,Default,,0,0,0,,Қос нүкте...
Dialogue: 0,1:11:36.70,1:11:38.21,Default,,0,0,0,,Ах!
Dialogue: 0,1:11:38.33,1:11:40.00,Default,,0,0,0,,Ах (ер) Ауро-сама!
Dialogue: 0,1:11:40.12,1:11:41.63,Default,,0,0,0,,Уф...
Dialogue: 0,1:11:41.75,1:11:43.79,Default,,0,0,0,,Не болды? Оро мырза
Dialogue: 0,1:11:51.59,1:11:53.64,Default,,0,0,0,,Қос нүкте және ауыл туралы
Dialogue: 0,1:11:53.72,1:11:55.47,Default,,0,0,0,,Бұл күйзеліс пен күйзелістің қосындысы болуы керек.
Dialogue: 0,1:11:55.72,1:11:58.27,Default,,0,0,0,,Әйтсе де, ол тынышталып қалған сияқты...
Dialogue: 0,1:11:58.39,1:11:59.73,Default,,0,0,0,,Ол қазір ұйықтап жатыр.
Dialogue: 0,1:11:59.85,1:12:01.06,Default,,0,0,0,,Жақсы
Dialogue: 0,1:12:01.19,1:12:03.15,Default,,0,0,0,,Сізге жақсы (Нобита) Иә.
Dialogue: 0,1:12:03.40,1:12:05.02,Default,,0,0,0,,Енді Сунео және оның достары туралы.
Dialogue: 0,1:12:05.15,1:12:07.40,Default,,0,0,0,,А, тезірек көмектесейік.
Dialogue: 0,1:12:07.86,1:12:09.36,Default,,0,0,0,,Қарсылас – айбатты жау.
Dialogue: 0,1:12:09.49,1:12:11.95,Default,,0,0,0,,Соқыр жүрудің қажеті жоқ.
Dialogue: 0,1:12:12.07,1:12:15.87,Default,,0,0,0,,Дұрыс, бұрынғыдай көп нәрсе болуы мүмкін.
Dialogue: 0,1:12:16.83,1:12:19.16,Default,,0,0,0,,Содан кейін оны қайта пайдаланыңыз.
Dialogue: 0,1:12:19.29,1:12:21.58,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,1:12:21.71,1:12:22.71,Default,,0,0,0,,(Тыныс алу дыбысы)
Dialogue: 0,1:12:22.83,1:12:25.79,Default,,0,0,0,,Уау!
Dialogue: 0,1:12:25.92,1:12:27.84,Default,,0,0,0,,О?
Dialogue: 0,1:12:30.42,1:12:31.59,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,1:12:32.22,1:12:34.64,Default,,0,0,0,,Препараттың әсері тозған сияқты.
Dialogue: 0,1:12:34.76,1:12:35.97,Default,,0,0,0,,Иә
Dialogue: 0,1:12:36.10,1:12:38.56,Default,,0,0,0,,Жолбарыс жартасы қандай жер?
Dialogue: 0,1:12:38.85,1:12:42.64,Default,,0,0,0,,Иә, мен осы аралдың шығыс жағындағы қирандылар туралы айтып отырмын.
Dialogue: 0,1:12:48.36,1:12:52.49,Default,,0,0,0,,Оған жету үшін сол тік таудан өту керек.
Dialogue: 0,1:12:52.61,1:12:56.49,Default,,0,0,0,,Бұл тіпті біз, рокололықтар да сирек баратын жер.
Dialogue: 0,1:13:02.96,1:13:04.25,Default,,0,0,0,,Естуімше, ол сенің бала кезден бергі досың.
Dialogue: 0,1:13:04.38,1:13:06.09,Default,,0,0,0,,Амансың ба? Сунео
Dialogue: 0,1:13:06.21,1:13:07.25,Default,,0,0,0,,Тоқтамаңыз! Ахх
Dialogue: 0,1:13:10.01,1:13:11.76,Default,,0,0,0,,Әй, Кабута!
Dialogue: 0,1:13:12.22,1:13:13.51,Default,,0,0,0,,Тез жүр!
Dialogue: 0,1:13:13.63,1:13:15.84,Default,,0,0,0,,Ах, а...
Dialogue: 0,1:13:21.14,1:13:24.31,Default,,0,0,0,,Хмм! Ақыр соңында көмектесейік
Dialogue: 0,1:13:24.94,1:13:26.19,Default,,0,0,0,,Иә
Dialogue: 0,1:13:27.98,1:13:32.40,Default,,0,0,0,,…
Dialogue: 0,1:13:32.53,1:13:33.70,Default,,0,0,0,,Жоқ (Нобита) Иә?
Dialogue: 0,1:13:33.82,1:13:34.86,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:13:34.99,1:13:36.82,Default,,0,0,0,,Жөндеуге жіберілді
Dialogue: 0,1:13:36.95,1:13:38.37,Default,,0,0,0,,Сонымен, амортизаторлар туралы не деуге болады?
Dialogue: 0,1:13:38.49,1:13:39.54,Default,,0,0,0,,Тіпті олай емес.
Dialogue: 0,1:13:39.99,1:13:41.62,Default,,0,0,0,,Солай ма?
Dialogue: 0,1:13:41.87,1:13:45.67,Default,,0,0,0,,...
Dialogue: 0,1:13:45.79,1:13:49.92,Default,,0,0,0,,～
Dialogue: 0,1:13:50.21,1:13:52.30,Default,,0,0,0,,Айттым ғой! Апаттар – нағыз азап.
Dialogue: 0,1:13:52.42,1:13:55.38,Default,,0,0,0,,...
Dialogue: 0,1:13:55.51,1:13:57.55,Default,,0,0,0,,Е... бұл не?
Dialogue: 0,1:13:57.68,1:13:59.89,Default,,0,0,0,,...
Dialogue: 0,1:14:00.10,1:14:01.77,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,1:14:02.77,1:14:03.81,Default,,0,0,0,,Ондай нәрсе жоқ
Dialogue: 0,1:14:04.18,1:14:05.27,Default,,0,0,0,,Иә! ?
Dialogue: 0,1:14:05.56,1:14:08.36,Default,,0,0,0,,（）
Dialogue: 0,1:14:08.98,1:14:13.69,Default,,0,0,0,,...
Dialogue: 0,1:14:13.82,1:14:17.95,Default,,0,0,0,,...
Dialogue: 0,1:14:18.45,1:14:21.41,Default,,0,0,0,,Бұл дұрыс болуы мүмкін, бірақ
Dialogue: 0,1:14:22.08,1:14:25.25,Default,,0,0,0,,...
Dialogue: 0,1:14:25.37,1:14:27.46,Default,,0,0,0,,Біреу маған айтып беріңізші!
Dialogue: 0,1:14:28.42,1:14:29.59,Default,,0,0,0,,Сәлем Дораемон
Dialogue: 0,1:14:30.04,1:14:31.17,Default,,0,0,0,,Хмм...
Dialogue: 0,1:14:32.50,1:14:34.17,Default,,0,0,0,,Қорықпа
Dialogue: 0,1:14:34.30,1:14:36.47,Default,,0,0,0,,Дораемон міндетті түрде сізге көмекке келеді.
Dialogue: 0,1:14:37.09,1:14:38.51,Default,,0,0,0,,Дораемон ғана емес
Dialogue: 0,1:14:38.64,1:14:42.14,Default,,0,0,0,,...
Dialogue: 0,1:14:42.56,1:14:45.10,Default,,0,0,0,,—
Dialogue: 0,1:14:45.23,1:14:46.31,Default,,0,0,0,,Мұны істеу уақыты келгенде, оны жасаңыз.
Dialogue: 0,1:14:46.44,1:14:47.81,Default,,0,0,0,,оқиға әрі қарай ешбір келеңсіздіксіз шешілді
Dialogue: 0,1:14:47.98,1:14:51.90,Default,,0,0,0,,Мен не істеуім керек? Не істеуім керек?
Dialogue: 0,1:14:52.02,1:14:56.32,Default,,0,0,0,,Дораемон, неге жөндеуге бірдеңе жібердің?
Dialogue: 0,1:14:56.45,1:14:58.20,Default,,0,0,0,,Мен осылай дедім
Dialogue: 0,1:14:58.32,1:15:00.07,Default,,0,0,0,,Нобита (Нобита) Иә?
Dialogue: 0,1:15:00.20,1:15:01.66,Default,,0,0,0,,Жолбарыс тасқа барайық
Dialogue: 0,1:15:02.08,1:15:04.66,Default,,0,0,0,,Не... сізде ешқандай құрал жоқ па?
Dialogue: 0,1:15:05.12,1:15:08.33,Default,,0,0,0,,...
Dialogue: 0,1:15:08.46,1:15:11.13,Default,,0,0,0,,Ер болсаң, істеу керек.
Dialogue: 0,1:15:11.50,1:15:13.09,Default,,0,0,0,,Жа... Джиан
Dialogue: 0,1:15:13.21,1:15:14.25,Default,,0,0,0,,Қыздар да
Dialogue: 0,1:15:14.38,1:15:16.42,Default,,0,0,0,,Шизука-чан, сен де
Dialogue: 0,1:15:16.72,1:15:19.09,Default,,0,0,0,,Бұл анық, солай ма? Біз доспыз.
Dialogue: 0,1:15:19.22,1:15:20.18,Default,,0,0,0,,Ах!
Dialogue: 0,1:15:20.30,1:15:22.51,Default,,0,0,0,,—
Dialogue: 0,1:15:22.64,1:15:24.35,Default,,0,0,0,,Сіз ештеңе істей алмайсыз ба?
Dialogue: 0,1:15:24.89,1:15:27.73,Default,,0,0,0,,Мен мұндай әлсіздерді жек көремін!
Dialogue: 0,1:15:27.85,1:15:30.40,Default,,0,0,0,,Ши... Шизука-чан, басқаша.
Dialogue: 0,1:15:30.52,1:15:31.36,Default,,0,0,0,,Хмф!
Dialogue: 0,1:15:31.48,1:15:35.78,Default,,0,0,0,,Ах, Шизука-чан мені жек көретін.
Dialogue: 0,1:15:35.90,1:15:39.49,Default,,0,0,0,,Ум... у... анау...
Dialogue: 0,1:15:39.61,1:15:40.66,Default,,0,0,0,,Мен де барамын!
Dialogue: 0,1:15:41.70,1:15:44.24,Default,,0,0,0,,Қос нүкте менің қарындасым сияқты.
Dialogue: 0,1:15:44.37,1:15:45.70,Default,,0,0,0,,Біз оны жалғыз қалдыра алмаймыз
Dialogue: 0,1:15:45.83,1:15:47.50,Default,,0,0,0,,Хехехе солай болды.
Dialogue: 0,1:15:48.58,1:15:54.00,Default,,0,0,0,,Бұдан былай қандай жағдай болмасын, біз әрқашан бірге боламыз.
Dialogue: 0,1:15:56.71,1:15:57.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:15:58.01,1:16:00.34,Default,,0,0,0,,Барымызды салайық, Нобита-кун
Dialogue: 0,1:16:00.47,1:16:01.34,Default,,0,0,0,,Иә!
Dialogue: 0,1:16:06.56,1:16:10.14,Default,,0,0,0,,Бәріміз бірге жұмыс жасайық, кеттік!
Dialogue: 0,1:16:10.27,1:16:11.85,Default,,0,0,0,,О!
Dialogue: 0,1:16:11.98,1:16:14.56,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,1:16:15.19,1:16:19.19,Default,,0,0,0,,Мен саған жол көрсетемін. Екеуің ауыл тұрғындарын қорғайсыңдар.
Dialogue: 0,1:16:19.32,1:16:20.53,Default,,0,0,0,,Түсіндім
Dialogue: 0,1:16:20.65,1:16:22.11,Default,,0,0,0,,Бірақ жақсы ма?
Dialogue: 0,1:16:22.61,1:16:27.58,Default,,0,0,0,,Қолайсыз жағдай өзгерген жоқ, бірақ мен сол балалардың батылдығына сенемін.
Dialogue: 0,1:16:27.87,1:16:32.29,Default,,0,0,0,,Хм... Менің ойымша, бұл қалай болады.
Dialogue: 0,1:16:40.05,1:16:42.09,Default,,0,0,0,,Сунео, қорқып тұрсың ба?
Dialogue: 0,1:16:42.22,1:16:45.55,Default,,0,0,0,,Не? Ахахха, бұл дұрыс емес.
Dialogue: 0,1:16:45.68,1:16:48.18,Default,,0,0,0,,Мен... қорқамын
Dialogue: 0,1:16:48.31,1:16:49.64,Default,,0,0,0,,Иә?
Dialogue: 0,1:16:49.77,1:16:51.14,Default,,0,0,0,,Колон-чан
Dialogue: 0,1:16:51.35,1:16:52.31,Default,,0,0,0,,Ах...
Dialogue: 0,1:16:52.44,1:16:55.40,Default,,0,0,0,,Ах
Dialogue: 0,1:16:56.15,1:16:57.32,Default,,0,0,0,,Чип… Чип, чип!
Dialogue: 0,1:16:57.69,1:17:01.07,Default,,0,0,0,,Сіз маған Алтын Геркулестің қайда екенін айтқыңыз келе ме?
Dialogue: 0,1:17:01.53,1:17:03.20,Default,,0,0,0,,Ешқашан айтпа!
Dialogue: 0,1:17:03.32,1:17:04.99,Default,,0,0,0,,Балаларды босат!
Dialogue: 0,1:17:05.24,1:17:07.45,Default,,0,0,0,,Хмф! Жаса
Dialogue: 0,1:17:07.58,1:17:08.54,Default,,0,0,0,,Га
Dialogue: 0,1:17:08.66,1:17:12.71,Default,,0,0,0,,Хи хи хи... Шоу уақыты басталады
Dialogue: 0,1:17:12.83,1:17:15.46,Default,,0,0,0,,Басты кейіпкерлер, әрине, сендерсіңдер.
Dialogue: 0,1:17:15.79,1:17:16.84,Default,,0,0,0,,Иә? (еденнің ашылған дыбысы)
Dialogue: 0,1:17:16.96,1:17:17.96,Default,,0,0,0,,Ах
Dialogue: 0,1:17:20.84,1:17:21.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:23.84,1:17:26.80,Default,,0,0,0,,Хехехехе Қызық енді басталады
Dialogue: 0,1:17:31.02,1:17:32.73,Default,,0,0,0,,Уау... не?
Dialogue: 0,1:17:38.44,1:17:43.07,Default,,0,0,0,,(Сунеоның айқайы)
Dialogue: 0,1:17:52.58,1:17:54.58,Default,,0,0,0,,Уф уау
Dialogue: 0,1:17:55.08,1:17:55.96,Default,,0,0,0,,Уау
Dialogue: 0,1:17:56.25,1:17:59.42,Default,,0,0,0,,Сіз қалай ойлайсыз? Сіз маған қайда екеніңізді айтқыңыз келе ме?
Dialogue: 0,1:17:59.67,1:18:01.67,Default,,0,0,0,,Маған кім үйретеді!
Dialogue: 0,1:18:01.80,1:18:03.97,Default,,0,0,0,,Ой, мен сендерден қорықпаймын!
Dialogue: 0,1:18:04.09,1:18:07.68,Default,,0,0,0,,Мен бұны бейберекет қыламын!
Dialogue: 0,1:18:07.80,1:18:09.26,Default,,0,0,0,,Уау Уау
Dialogue: 0,1:18:09.39,1:18:13.31,Default,,0,0,0,,А, жібер! Босатпасаң, мен сені құртамын!
Dialogue: 0,1:18:13.81,1:18:15.98,Default,,0,0,0,,Уау... ауырады
Dialogue: 0,1:18:16.10,1:18:17.19,Default,,0,0,0,,Сунео!
Dialogue: 0,1:18:17.31,1:18:18.52,Default,,0,0,0,,Тоқта! дереу
Dialogue: 0,1:18:18.90,1:18:23.61,Default,,0,0,0,,Тек сен, Колон, баланы құтқара аласың.
Dialogue: 0,1:18:23.74,1:18:26.99,Default,,0,0,0,,Қайда екеніңді айтсаң, мен сені бірден түсіремін.
Dialogue: 0,1:18:27.20,1:18:30.03,Default,,0,0,0,,Айтпа! Қос нүкте: Айтпа!
Dialogue: 0,1:18:30.16,1:18:33.95,Default,,0,0,0,,Ей, олай айтпа!
Dialogue: 0,1:18:34.16,1:18:37.83,Default,,0,0,0,,Айтпа! Бұл жігіттерден жеңілме
Dialogue: 0,1:18:37.96,1:18:40.88,Default,,0,0,0,,Барлығымыз осы аралды қорғайық!
Dialogue: 0,1:18:41.00,1:18:44.21,Default,,0,0,0,,Ааааааааааа
Dialogue: 0,1:18:44.51,1:18:46.01,Default,,0,0,0,,Сунео!
Dialogue: 0,1:18:46.93,1:18:51.93,Default,,0,0,0,,Қос нүкте... Дораемон және басқалары келетініне сенімдімін.
Dialogue: 0,1:18:52.18,1:18:53.52,Default,,0,0,0,,Ах!
Dialogue: 0,1:18:58.10,1:18:59.56,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:18:59.94,1:19:04.03,Default,,0,0,0,,Сондықтан айтпа...
Dialogue: 0,1:19:07.65,1:19:09.99,Default,,0,0,0,,Жарайды, мүлдем...
Dialogue: 0,1:19:12.91,1:19:14.95,Default,,0,0,0,,Мен оны ешқашан айтпаймын!
Dialogue: 0,1:19:15.08,1:19:17.91,Default,,0,0,0,,(Кураджоның айқайы)
Dialogue: 0,1:19:31.39,1:19:32.43,Default,,0,0,0,,Ах
Dialogue: 0,1:19:32.80,1:19:34.18,Default,,0,0,0,,Бұл...
Dialogue: 0,1:19:34.31,1:19:35.60,Default,,0,0,0,,Уф
Dialogue: 0,1:19:36.22,1:19:39.56,Default,,0,0,0,,Аймақты анықтау үшін сол алқаны зерттеңіз.
Dialogue: 0,1:19:39.94,1:19:43.44,Default,,0,0,0,,Енді сіз Алтын Геркулестің қайда екенін білесіз.
Dialogue: 0,1:19:43.57,1:19:45.57,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:19:58.91,1:19:59.92,Default,,0,0,0,,Бұл шықты!
Dialogue: 0,1:20:00.58,1:20:02.38,Default,,0,0,0,,Мені ұстаңыз! Жарайды
Dialogue: 0,1:20:10.55,1:20:14.55,Default,,0,0,0,,(айқай)
Dialogue: 0,1:20:15.06,1:20:16.56,Default,,0,0,0,,Не болды? Куррагио
Dialogue: 0,1:20:16.68,1:20:18.48,Default,,0,0,0,,Иә? (Кураджоның жылағаны)
Dialogue: 0,1:20:18.60,1:20:22.81,Default,,0,0,0,,А, мүмкін Алтын Геркулес...
Dialogue: 0,1:20:22.94,1:20:24.61,Default,,0,0,0,,Сіз қамауға алындыңыз ба? (Сунео) Иә.
Dialogue: 0,1:20:25.02,1:20:28.15,Default,,0,0,0,,Бұл қиын, Дораемон!
Dialogue: 0,1:20:29.24,1:20:30.57,Default,,0,0,0,,Барлығына!
Dialogue: 0,1:20:33.53,1:20:35.41,Default,,0,0,0,,Тез кел!
Dialogue: 0,1:20:35.53,1:20:36.87,Default,,0,0,0,,Ей Нобита! (Нобита) Уау, о
Dialogue: 0,1:20:36.99,1:20:37.95,Default,,0,0,0,,А, Нобита-сан
Dialogue: 0,1:20:38.08,1:20:39.50,Default,,0,0,0,,Уау Уау
Dialogue: 0,1:20:40.04,1:20:40.96,Default,,0,0,0,,Нобита!
Dialogue: 0,1:20:41.83,1:20:44.42,Default,,0,0,0,,Маған көмектесіңізші... Дакке
Dialogue: 0,1:20:44.71,1:20:46.84,Default,,0,0,0,,Мықты бол, батыл бол!
Dialogue: 0,1:20:49.42,1:20:51.76,Default,,0,0,0,,Double Нобита мұны істей алуы керек.
Dialogue: 0,1:20:53.47,1:20:54.89,Default,,0,0,0,,Үйрек
Dialogue: 0,1:20:56.01,1:20:57.35,Default,,0,0,0,,Хаха
Dialogue: 0,1:21:00.52,1:21:01.77,Default,,0,0,0,,Уау, Нобита!
Dialogue: 0,1:21:01.89,1:21:04.35,Default,,0,0,0,,Уау, жоқ...
Dialogue: 0,1:21:04.69,1:21:07.90,Default,,0,0,0,,Нобита! Қолыңызды созыңыз және оны алыңыз!
Dialogue: 0,1:21:08.02,1:21:09.32,Default,,0,0,0,,О
Dialogue: 0,1:21:09.57,1:21:11.70,Default,,0,0,0,,Иә, дерлік.
Dialogue: 0,1:21:12.74,1:21:14.36,Default,,0,0,0,,А, сәттілік!
Dialogue: 0,1:21:14.49,1:21:16.45,Default,,0,0,0,,Нобита! Берілме!
Dialogue: 0,1:21:16.58,1:21:17.99,Default,,0,0,0,,Иносукэ, кешір мені. Егер оны ертерек байқап қалсам...
Dialogue: 0,1:21:19.33,1:21:20.58,Default,,0,0,0,,Даусыңды естігім келді. Сені көргім келді.
Dialogue: 0,1:21:20.70,1:21:22.87,Default,,0,0,0,,(Деккенің күш айқайы)
Dialogue: 0,1:21:23.21,1:21:24.58,Default,,0,0,0,,Барлығына сәттілік
Dialogue: 0,1:21:25.63,1:21:27.71,Default,,0,0,0,,Уф
Dialogue: 0,1:21:27.84,1:21:29.71,Default,,0,0,0,,Егер ол 30 минут күтуді айтса, басқа амалым жоқ шығар
Dialogue: 0,1:21:31.09,1:21:33.55,Default,,0,0,0,,Амансың ба? Нобита-сан
Dialogue: 0,1:21:33.68,1:21:34.68,Default,,0,0,0,,Иә
Dialogue: 0,1:21:34.80,1:21:37.05,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:21:37.18,1:21:39.64,Default,,0,0,0,,Мен оны ақырында ұстадым.
Dialogue: 0,1:21:39.76,1:21:44.19,Default,,0,0,0,,Аты аңызға айналған Алтын Геркулес қоңызы!
Dialogue: 0,1:21:45.94,1:21:47.02,Default,,0,0,0,,Оқшаулау
Dialogue: 0,1:21:47.15,1:21:48.11,Default,,0,0,0,,Га
Dialogue: 0,1:22:02.91,1:22:05.37,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:22:06.25,1:22:08.21,Default,,0,0,0,,Ах... Кураджо!
Dialogue: 0,1:22:09.25,1:22:13.01,Default,,0,0,0,,Не болды? Куррагио Куррагио Куррагио
Dialogue: 0,1:22:13.13,1:22:16.38,Default,,0,0,0,,(Додос ыңырсып)
Dialogue: 0,1:22:16.51,1:22:18.55,Default,,0,0,0,,Сіз нені айтасыз? (Бала) Мен білмеймін.
Dialogue: 0,1:22:18.68,1:22:21.06,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:22:22.77,1:22:24.43,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,1:22:24.64,1:22:28.40,Default,,0,0,0,,(ырылдаған дыбыс)
Dialogue: 0,1:22:35.15,1:22:36.32,Default,,0,0,0,,Сіз өлдіңіз бе?
Dialogue: 0,1:22:36.45,1:22:39.24,Default,,0,0,0,,Жоқ, мен жай ғана әлсізмін.
Dialogue: 0,1:22:39.37,1:22:41.70,Default,,0,0,0,,Бұл жігіт мені басқарып отырды.
Dialogue: 0,1:22:41.83,1:22:44.00,Default,,0,0,0,,Бейшара жігіт, шешіп алайық.
Dialogue: 0,1:22:44.12,1:22:45.79,Default,,0,0,0,,Иә, солай істейік.
Dialogue: 0,1:22:50.54,1:22:54.42,Default,,0,0,0,,Әй, бізге сүйкімді қонақ келген сияқты.
Dialogue: 0,1:22:54.80,1:22:55.97,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:58.84,1:23:01.51,Default,,0,0,0,,Не? Бұл көк ракон ит
Dialogue: 0,1:23:01.64,1:23:04.31,Default,,0,0,0,,Енот ит пе, түлкі ме бәрібір.
Dialogue: 0,1:23:04.43,1:23:06.06,Default,,0,0,0,,Аяқтаңыз!
Dialogue: 0,1:23:13.94,1:23:14.94,Default,,0,0,0,,Бұл дирижабль.
Dialogue: 0,1:23:15.57,1:23:18.36,Default,,0,0,0,,Сунео мен оның достары сонда болуы керек.
Dialogue: 0,1:23:19.07,1:23:20.82,Default,,0,0,0,,Мен қалай жасырын түрде кіре аламын?
Dialogue: 0,1:23:21.74,1:23:22.83,Default,,0,0,0,,Сол жерде.
Dialogue: 0,1:23:23.87,1:23:26.79,Default,,0,0,0,,Сол шағын алқаптан өтсем, жақындай аламын деп ойлаймын.
Dialogue: 0,1:23:27.46,1:23:30.96,Default,,0,0,0,,Алдымен мен, Дакке және Джиан сізді тексереміз.
Dialogue: 0,1:23:31.08,1:23:33.00,Default,,0,0,0,,Нобита-кун және басқалары, осында күтіңіздер.
Dialogue: 0,1:23:33.13,1:23:34.13,Default,,0,0,0,,Түсіндім, иә.
Dialogue: 0,1:23:34.25,1:23:37.67,Default,,0,0,0,,Бұл құрал бірдеңе үшін пайдалы болуы мүмкін.
Dialogue: 0,1:23:38.30,1:23:42.68,Default,,0,0,0,,(Дораэмонның ауыр тыныс алуы)
Dialogue: 0,1:23:43.47,1:23:44.51,Default,,0,0,0,,О, уау!
Dialogue: 0,1:23:44.81,1:23:46.77,Default,,0,0,0,,«Көк Дануки отқа ұшады»
Dialogue: 0,1:23:47.27,1:23:51.23,Default,,0,0,0,,Мен талай рет айттым, бірақ мен енот емеспін, мен мысық тәрізді роботпын... Уау.
Dialogue: 0,1:23:51.90,1:23:53.11,Default,,0,0,0,,Қаш!
Dialogue: 0,1:23:53.23,1:23:55.65,Default,,0,0,0,,Уау!
Dialogue: 0,1:23:58.78,1:24:01.57,Default,,0,0,0,,Куррагио, мықты бол! Крахо!
Dialogue: 0,1:24:02.28,1:24:04.28,Default,,0,0,0,,Дораэмон тез
Dialogue: 0,1:24:04.87,1:24:06.37,Default,,0,0,0,,Амансың ба? Дораемон
Dialogue: 0,1:24:06.49,1:24:08.58,Default,,0,0,0,,Мен 2-3 мм жоғалтқан сияқтымын.
Dialogue: 0,1:24:08.71,1:24:10.33,Default,,0,0,0,,(Жануарлар дүкенінің сатушысы) Хмм… Таныс итті өсірушімнен сұрайын ба?
Dialogue: 0,1:24:10.46,1:24:12.75,Default,,0,0,0,,Жарайды, келесі операцияны бастаңыз (Нобита және оның достары) Иә.
Dialogue: 0,1:24:14.38,1:24:15.21,Default,,0,0,0,,Иә?
Dialogue: 0,1:24:17.21,1:24:18.63,Default,,0,0,0,,Бақытты мысық?
Dialogue: 0,1:24:18.76,1:24:19.88,Default,,0,0,0,,Бұл... иә?
Dialogue: 0,1:24:20.01,1:24:21.76,Default,,0,0,0,,Кака... Кам... Не? Сіз
Dialogue: 0,1:24:21.89,1:24:22.55,Default,,0,0,0,,Уф...
Dialogue: 0,1:24:22.68,1:24:25.85,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса, қолыңнан келгенін істе, Нобита-сан Барыңды істе, барыңды істе, Нобита-сан
Dialogue: 0,1:24:26.60,1:24:27.56,Default,,0,0,0,,Тек сол сәтте, бір сәтке ғана…
Dialogue: 0,1:24:28.68,1:24:29.89,Default,,0,0,0,,Хмф!
Dialogue: 0,1:24:30.27,1:24:32.94,Default,,0,0,0,,Мен ағамды Кам Кэм Мысықпен бірге шақырдым.
Dialogue: 0,1:24:33.06,1:24:34.52,Default,,0,0,0,,Мұны жеңу үшін
Dialogue: 0,1:24:34.77,1:24:37.28,Default,,0,0,0,,Хе, мұндай нәрсемен не істеуге болады?
Dialogue: 0,1:24:37.40,1:24:39.53,Default,,0,0,0,,Күшті желдеткіш Фуджин!
Dialogue: 0,1:24:39.78,1:24:42.95,Default,,0,0,0,,Нууууууууууууууууууууу
Dialogue: 0,1:24:43.07,1:24:46.83,Default,,0,0,0,,Нанана Не? Ол кептеліп қалды. Не болып жатыр? Түсіріңіз
Dialogue: 0,1:24:46.95,1:24:50.08,Default,,0,0,0,,Бұл ғарыштық желім Учива деп аталады.
Dialogue: 0,1:24:50.21,1:24:52.58,Default,,0,0,0,,Дораэмонның құпия құралы керемет
Dialogue: 0,1:24:52.71,1:24:54.29,Default,,0,0,0,,Осы жерге кел~
Dialogue: 0,1:24:54.42,1:24:56.59,Default,,0,0,0,,Бейбақ, күте тұрыңыз! Ах
Dialogue: 0,1:24:56.96,1:24:58.80,Default,,0,0,0,,Не болып жатыр? Уау
Dialogue: 0,1:24:59.38,1:25:01.01,Default,,0,0,0,,Егер сіз оған Кой Кой белгісін қойсаңыз—
Dialogue: 0,1:25:01.42,1:25:03.64,Default,,0,0,0,,Ол көрсеткі бағытында жүреді.
Dialogue: 0,1:25:03.76,1:25:07.10,Default,,0,0,0,,А, а, жоқ, жоқ... Уау.
Dialogue: 0,1:25:08.18,1:25:10.10,Default,,0,0,0,,Жарайды, кеттік! (Нобита және басқалар) О!
Dialogue: 0,1:25:10.23,1:25:11.48,Default,,0,0,0,,Бірақ мен әлі біраз уақыт үйге оралмаймын.
Dialogue: 0,1:25:13.31,1:25:14.40,Default,,0,0,0,,Ах!
Dialogue: 0,1:25:16.65,1:25:18.23,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:20.44,1:25:22.74,Default,,0,0,0,,Ах...
Dialogue: 0,1:25:27.83,1:25:29.41,Default,,0,0,0,,Дораэмон?
Dialogue: 0,1:25:31.33,1:25:32.54,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,1:25:33.33,1:25:34.67,Default,,0,0,0,,Кішкентай бәйбішелер!
Dialogue: 0,1:25:34.79,1:25:36.88,Default,,0,0,0,,Олар бәріңді бірден жаншып тастайды.
Dialogue: 0,1:25:37.00,1:25:39.75,Default,,0,0,0,,Мынау... бұл жолы менің қарсыласым ба?
Dialogue: 0,1:25:39.88,1:25:40.92,Default,,0,0,0,,Мен жалықтым.
Dialogue: 0,1:25:43.38,1:25:44.68,Default,,0,0,0,,А-а, не? иә?
Dialogue: 0,1:25:44.80,1:25:47.64,Default,,0,0,0,,Әй, мынау ма, мынау... Басқасы жоқ па?
Dialogue: 0,1:25:47.76,1:25:50.01,Default,,0,0,0,,Аа, ол қайда? Бұл қайда? Бұл қайда?
Dialogue: 0,1:25:52.14,1:25:53.10,Default,,0,0,0,,Кабута!
Dialogue: 0,1:25:53.39,1:25:54.60,Default,,0,0,0,,Иә?
Dialogue: 0,1:26:12.00,1:26:14.83,Default,,0,0,0,,Бұл не? Неге мұндасың?
Dialogue: 0,1:26:15.54,1:26:18.71,Default,,0,0,0,,Кабута бізді қорғауға ниетті.
Dialogue: 0,1:26:19.34,1:26:23.01,Default,,0,0,0,,Жарайды, қазір Сунео мен басқаларды құтқарайық!
Dialogue: 0,1:26:23.13,1:26:24.30,Default,,0,0,0,,Бірақ қалай?
Dialogue: 0,1:26:25.09,1:26:26.51,Default,,0,0,0,,Міне!
Dialogue: 0,1:26:27.64,1:26:28.80,Default,,0,0,0,,Жарайсың ба? Дораемон
Dialogue: 0,1:26:29.05,1:26:30.39,Default,,0,0,0,,Жарайды!
Dialogue: 0,1:26:31.35,1:26:33.02,Default,,0,0,0,,Жоқ! Ах!
Dialogue: 0,1:26:35.60,1:26:36.02,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, барыңды істе
Dialogue: 0,1:26:36.02,1:26:36.60,Default,,0,0,0,,Қолыңнан келгеннің бәрін істе, барыңды істе
Dialogue: 0,1:26:36.02,1:26:36.60,Default,,0,0,0,,Гахахаха үлкен үй жүгірісі
Dialogue: 0,1:26:36.60,1:26:36.69,Default,,0,0,0,,Гахахаха үлкен үй жүгірісі
Dialogue: 0,1:26:36.69,1:26:37.69,Default,,0,0,0,,Гахахаха үлкен үй жүгірісі
Dialogue: 0,1:26:36.69,1:26:37.69,Default,,0,0,0,,Дораемон
Dialogue: 0,1:26:37.69,1:26:37.81,Default,,0,0,0,,Гахахаха үлкен үй жүгірісі
Dialogue: 0,1:26:37.81,1:26:38.48,Default,,0,0,0,,Гахахаха үлкен үй жүгірісі
Dialogue: 0,1:26:37.81,1:26:38.48,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз, Дораэмонды жасаңыз
Dialogue: 0,1:26:38.48,1:26:39.65,Default,,0,0,0,,Қолыңыздан келгеннің бәрін жасаңыз, Дораэмонды жасаңыз
Dialogue: 0,1:26:39.77,1:26:41.73,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса, Дораэмонды ең жақсысын жаса
Dialogue: 0,1:26:41.86,1:26:44.78,Default,,0,0,0,,Сәлем! Бауырлар!
Dialogue: 0,1:26:46.15,1:26:47.86,Default,,0,0,0,,(Нобита мен оның достарының айқайы)
Dialogue: 0,1:26:57.04,1:27:00.63,Default,,0,0,0,,Иә! (Барлығы қуанады)
Dialogue: 0,1:27:01.59,1:27:05.34,Default,,0,0,0,,Сізге сол кепілге алынғандар не болатыны қызықты ма?
Dialogue: 0,1:27:06.38,1:27:07.26,Default,,0,0,0,,Ах
Dialogue: 0,1:27:07.72,1:27:09.43,Default,,0,0,0,,Рахмет, мм?
Dialogue: 0,1:27:09.55,1:27:11.85,Default,,0,0,0,,Маған есікті ашыңыз!
Dialogue: 0,1:27:11.97,1:27:13.56,Default,,0,0,0,,Уф
Dialogue: 0,1:27:15.89,1:27:17.64,Default,,0,0,0,,Ууууу, кешіріңіз!
Dialogue: 0,1:27:20.61,1:27:21.86,Default,,0,0,0,,Ах...
Dialogue: 0,1:27:34.08,1:27:35.41,Default,,0,0,0,,(Аспанның айқайы)
Dialogue: 0,1:27:38.21,1:27:40.46,Default,,0,0,0,,Алтын Геркулес осында
Dialogue: 0,1:27:40.58,1:27:43.00,Default,,0,0,0,,Бейшараға жамандық жасама.
Dialogue: 0,1:27:43.13,1:27:44.38,Default,,0,0,0,,Куррагио!
Dialogue: 0,1:27:44.71,1:27:46.88,Default,,0,0,0,,Сәттілік, Кураджо!
Dialogue: 0,1:27:47.72,1:27:50.26,Default,,0,0,0,,Мен сырттағы жағдайды тексеремін. (Сунео) Мен де барамын!
Dialogue: 0,1:27:56.43,1:27:57.27,Default,,0,0,0,,Кабута!
Dialogue: 0,1:27:57.73,1:27:58.73,Default,,0,0,0,,Ах
Dialogue: 0,1:27:58.98,1:28:03.19,Default,,0,0,0,,бітті ме? Хмф! Бұл ауыз толтырып айтарлықтай емес.
Dialogue: 0,1:28:04.82,1:28:05.65,Default,,0,0,0,,Ах
Dialogue: 0,1:28:07.53,1:28:08.61,Default,,0,0,0,,Хехехехе
Dialogue: 0,1:28:10.11,1:28:12.16,Default,,0,0,0,,Ашыңыз!
Dialogue: 0,1:28:14.24,1:28:15.08,Default,,0,0,0,,Куррагио!
Dialogue: 0,1:28:20.54,1:28:21.50,Default,,0,0,0,,Кабута!
Dialogue: 0,1:28:23.29,1:28:24.63,Default,,0,0,0,,Кабута
Dialogue: 0,1:28:27.09,1:28:28.26,Default,,0,0,0,,Йосе Кабута
Dialogue: 0,1:28:28.80,1:28:31.97,Default,,0,0,0,,Жетеді, жеткілікті, жеткілікті.
Dialogue: 0,1:28:35.60,1:28:37.52,Default,,0,0,0,,Тоқта!
Dialogue: 0,1:28:37.64,1:28:38.43,Default,,0,0,0,,Е, Нобита-кун
Dialogue: 0,1:28:38.56,1:28:40.56,Default,,0,0,0,,Бұл ақылсыз! (Сунео) Көп!
Dialogue: 0,1:28:40.94,1:28:42.77,Default,,0,0,0,,ебедейсіз бәйбіше!
Dialogue: 0,1:28:43.10,1:28:46.69,Default,,0,0,0,,Увааааааааааааааааааааааааааааааааааа...
Dialogue: 0,1:28:46.82,1:28:48.36,Default,,0,0,0,,Нобита-кун, қаш!
Dialogue: 0,1:28:48.48,1:28:51.36,Default,,0,0,0,,Нобита қашып барады! қауіпті!
Dialogue: 0,1:28:51.78,1:28:52.61,Default,,0,0,0,,Уф
Dialogue: 0,1:28:57.45,1:28:59.75,Default,,0,0,0,,Сондай-ақ... бұл енді жақсы емес.
Dialogue: 0,1:28:59.87,1:29:02.96,Default,,0,0,0,,Тыңда, не болса да, мені тастама!
Dialogue: 0,1:29:03.50,1:29:05.17,Default,,0,0,0,,Мен Нобитаны қорғаймын.
Dialogue: 0,1:29:05.63,1:29:06.96,Default,,0,0,0,,Әрине (Нобита) Иә.
Dialogue: 0,1:29:07.42,1:29:09.05,Default,,0,0,0,,(Екі адам жөтеледі)
Dialogue: 0,1:29:09.17,1:29:10.88,Default,,0,0,0,,Доктор Келли тез.
Dialogue: 0,1:29:12.22,1:29:14.47,Default,,0,0,0,,(құлыпты ашу дыбысы)
Dialogue: 0,1:29:14.59,1:29:16.05,Default,,0,0,0,,Аға, ашық!
Dialogue: 0,1:29:16.85,1:29:20.06,Default,,0,0,0,,Жарайды, мен саған соңғы соққыны беремін.
Dialogue: 0,1:29:20.18,1:29:21.39,Default,,0,0,0,,Кабутаны қорғаңыз!
Dialogue: 0,1:29:21.52,1:29:25.35,Default,,0,0,0,,(Дораэмонның айқайы)
Dialogue: 0,1:29:25.48,1:29:27.65,Default,,0,0,0,,Жарайды, мен де жасайын.
Dialogue: 0,1:29:27.94,1:29:30.65,Default,,0,0,0,,Дәрігер!
Dialogue: 0,1:29:31.03,1:29:31.94,Default,,0,0,0,,Әлі емес пе?
Dialogue: 0,1:29:32.07,1:29:33.70,Default,,0,0,0,,Қолыңнан келгенін істе, Кабута
Dialogue: 0,1:29:33.82,1:29:36.20,Default,,0,0,0,,Қолыңнан келгенін істе, Кабута жаса
Dialogue: 0,1:29:36.49,1:29:39.83,Default,,0,0,0,,(Барлығы айғайлайды)
Dialogue: 0,1:29:43.37,1:29:44.33,Default,,0,0,0,,Уф
Dialogue: 0,1:29:44.62,1:29:45.46,Default,,0,0,0,,Ең алдымен, техникалық колледжде—
Dialogue: 0,1:29:49.46,1:29:51.76,Default,,0,0,0,,(Барлығы айқайлайды)
Dialogue: 0,1:29:53.34,1:29:54.05,Default,,0,0,0,,Уау
Dialogue: 0,1:29:54.34,1:29:56.51,Default,,0,0,0,,(Бақсы күлкі)
Dialogue: 0,1:29:56.76,1:29:58.51,Default,,0,0,0,,... Мен шыдай алмаймын.
Dialogue: 0,1:29:58.64,1:30:01.02,Default,,0,0,0,,Анашым! Бұл қорқынышты!
Dialogue: 0,1:30:09.86,1:30:11.90,Default,,0,0,0,,Алтын Геркулес
Dialogue: 0,1:30:12.03,1:30:12.90,Default,,0,0,0,,Уау! Қандай эпикалық эпизод!
Dialogue: 0,1:30:16.99,1:30:19.33,Default,,0,0,0,,Барлығына көмектесіңіз!
Dialogue: 0,1:30:26.08,1:30:28.42,Default,,0,0,0,,Жаса!
Dialogue: 0,1:30:37.93,1:30:41.93,Default,,0,0,0,,Қолыңнан келгеннің бәрін жаса, Кабута, барыңды істе, Кабута
Dialogue: 0,1:30:42.06,1:30:43.18,Default,,0,0,0,,Сәттілік!
Dialogue: 0,1:30:44.31,1:30:47.06,Default,,0,0,0,,Ой, тоқтат! Бұл қауіпті!
Dialogue: 0,1:30:47.19,1:30:49.23,Default,,0,0,0,,(Шаман айқайы)
Dialogue: 0,1:31:02.74,1:31:05.54,Default,,0,0,0,,Ууууууууууууууууууууууу...
Dialogue: 0,1:31:05.79,1:31:09.42,Default,,0,0,0,,(Жануарлар үреді және жылайды)
Dialogue: 0,1:31:09.54,1:31:12.17,Default,,0,0,0,,Маған көмектес!
Dialogue: 0,1:31:20.43,1:31:23.51,Default,,0,0,0,,(Сунеоның күш айқайы)
Dialogue: 0,1:31:23.97,1:31:25.47,Default,,0,0,0,,Жақсы, солай.
Dialogue: 0,1:31:25.81,1:31:27.69,Default,,0,0,0,,Жарайды, абай болыңыз.
Dialogue: 0,1:31:28.06,1:31:28.98,Default,,0,0,0,,Артық емес
Dialogue: 0,1:31:29.10,1:31:31.44,Default,,0,0,0,,Бұл аянышты. Ол әлі еркек пе?
Dialogue: 0,1:31:33.07,1:31:35.11,Default,,0,0,0,,О, Кларжо, сен жақсы қызсың.
Dialogue: 0,1:31:35.23,1:31:36.49,Default,,0,0,0,,(айқай)
Dialogue: 0,1:31:36.86,1:31:38.95,Default,,0,0,0,,Ой...
Dialogue: 0,1:31:39.49,1:31:41.87,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,1:31:41.99,1:31:44.12,Default,,0,0,0,,Енді бұл арал құтқарылды.
Dialogue: 0,1:31:44.24,1:31:45.83,Default,,0,0,0,,Сол жаман адамдар ше?
Dialogue: 0,1:31:45.95,1:31:46.95,Default,,0,0,0,,Уайымдамаңыз
Dialogue: 0,1:31:47.62,1:31:50.29,Default,,0,0,0,,Мен патруль келгенше қамаламын.
Dialogue: 0,1:31:50.42,1:31:52.29,Default,,0,0,0,,Жабысып қалма, аулақ жүр
Dialogue: 0,1:31:52.42,1:31:54.59,Default,,0,0,0,,Мен осылай дедім
Dialogue: 0,1:31:55.80,1:31:57.42,Default,,0,0,0,,Хаха, бұл жақсы (Фук күлді)
Dialogue: 0,1:31:57.55,1:31:58.34,Default,,0,0,0,,Иә? Уау
Dialogue: 0,1:31:58.47,1:31:59.93,Default,,0,0,0,,Хахаха мұнда!
Dialogue: 0,1:32:00.05,1:32:00.72,Default,,0,0,0,,Әй?
Dialogue: 0,1:32:00.84,1:32:02.39,Default,,0,0,0,,Маған көмектеспейсіз бе?
Dialogue: 0,1:32:02.51,1:32:04.26,Default,,0,0,0,,Хмм...
Dialogue: 0,1:32:04.39,1:32:05.89,Default,,0,0,0,,Фук (Фук) иә
Dialogue: 0,1:32:06.31,1:32:08.60,Default,,0,0,0,,Бұған не болды?
Dialogue: 0,1:32:08.73,1:32:09.85,Default,,0,0,0,,Мен оны алдым.
Dialogue: 0,1:32:10.23,1:32:12.06,Default,,0,0,0,,Орман бұлағында
Dialogue: 0,1:32:12.73,1:32:14.69,Default,,0,0,0,,Мұндай адамды қайдан тауып алдың?
Dialogue: 0,1:32:14.82,1:32:18.78,Default,,0,0,0,,Балаларға үйге баратын уақыт келді деп айт.
Dialogue: 0,1:32:21.07,1:32:22.78,Default,,0,0,0,,Сау болыңыз Дак мырза
Dialogue: 0,1:32:22.91,1:32:24.49,Default,,0,0,0,,Аман болыңыз, қос нүкте.
Dialogue: 0,1:32:24.87,1:32:26.45,Default,,0,0,0,,Атаңа қамқор бол
Dialogue: 0,1:32:26.58,1:32:27.25,Default,,0,0,0,,Иә
Dialogue: 0,1:32:27.58,1:32:30.00,Default,,0,0,0,,Уақыт келді. Асықшы!
Dialogue: 0,1:32:30.71,1:32:33.00,Default,,0,0,0,,Бір күні тағы кездесемін.
Dialogue: 0,1:32:33.38,1:32:34.67,Default,,0,0,0,,(Зенitsu) Өтінемін! (Күсари-карасу) Кә~!
Dialogue: 0,1:32:34.88,1:32:36.55,Default,,0,0,0,,Хе хе дакке
Dialogue: 0,1:32:36.67,1:32:38.46,Default,,0,0,0,,А? Уау
Dialogue: 0,1:32:42.18,1:32:43.84,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:32:43.97,1:32:45.89,Default,,0,0,0,,Сіз кімсіз? Сенің атың кім?
Dialogue: 0,1:32:46.01,1:32:48.35,Default,,0,0,0,,Аты-жөні? Бұл Нобисуке.
Dialogue: 0,1:32:48.47,1:32:49.31,Default,,0,0,0,,Иә?
Dialogue: 0,1:32:49.60,1:32:53.06,Default,,0,0,0,,Балалар сендер кімсіңдер? Аа, бұл қайда?
Dialogue: 0,1:32:53.19,1:32:54.77,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,1:32:54.90,1:32:57.15,Default,,0,0,0,,Жоспарланған уақыттан асып кету
Dialogue: 0,1:32:57.28,1:32:59.19,Default,,0,0,0,,Уау, ұшсын!
Dialogue: 0,1:33:03.11,1:33:04.49,Default,,0,0,0,,Менің...
Dialogue: 0,1:33:06.74,1:33:08.54,Default,,0,0,0,,Ол менің әкем болды.
Dialogue: 0,1:33:11.04,1:33:11.96,Default,,0,0,0,,Сол жігіт
Dialogue: 0,1:33:14.58,1:33:15.84,Default,,0,0,0,,Ах!
Dialogue: 0,1:33:16.92,1:33:21.92,Default,,0,0,0,,♪～
Dialogue: 0,1:34:15.48,1:34:18.15,Default,,0,0,0,,Рахмет, әке.
Dialogue: 0,1:34:26.45,1:34:28.07,Default,,0,0,0,,Нобита?
Dialogue: 0,1:34:28.20,1:34:29.78,Default,,0,0,0,,Бұл Дак мырза емес пе?
Dialogue: 0,1:34:29.91,1:34:31.08,Default,,0,0,0,,Ах...
Dialogue: 0,1:34:31.91,1:34:34.62,Default,,0,0,0,,Ол дұшпан, хехе.
Dialogue: 0,1:34:36.29,1:34:38.33,Default,,0,0,0,,Рахмет, Үйрек!
Dialogue: 0,1:34:38.46,1:34:40.00,Default,,0,0,0,,Дак мырза!
Dialogue: 0,1:34:40.46,1:34:43.01,Default,,0,0,0,,Үйрек!
Dialogue: 0,1:34:44.26,1:34:45.63,Default,,0,0,0,,Дораемон
Dialogue: 0,1:34:45.76,1:34:49.47,Default,,0,0,0,,Васленборгта мен сізге осы арал туралы естеліктеріңізді ұмыттырдым.
Dialogue: 0,1:34:49.60,1:34:51.35,Default,,0,0,0,,Дүйсенбі күні Сакура TV-ге Екінші Кирадан тағы бір хабарлама келді.
Dialogue: 0,1:34:51.47,1:34:52.56,Default,,0,0,0,,Иә
Dialogue: 0,1:34:54.77,1:34:59.77,Default,,0,0,0,,～♪
Dialogue: 0,1:35:08.20,1:35:09.16,Default,,0,0,0,,Сәлем! иә?
Dialogue: 0,1:35:09.57,1:35:12.37,Default,,0,0,0,,Сен уже мазасызсың, сондықтан араласпа.
Dialogue: 0,1:35:12.49,1:35:14.50,Default,,0,0,0,,Жарайды, жексенбіге қатысты.
Dialogue: 0,1:35:14.62,1:35:17.58,Default,,0,0,0,,Ханым! Қараңызшы, оянбасаңыз, дем аласыз.
Dialogue: 0,1:35:18.25,1:35:22.21,Default,,0,0,0,,Олай болса, сонша бос уақытыңыз болса, дүкен аралағаныңызды қалаймын.
Dialogue: 0,1:35:22.34,1:35:23.21,Default,,0,0,0,,Иә! ?
Dialogue: 0,1:35:23.34,1:35:25.55,Default,,0,0,0,,Үшеуміз (Нобита/Дораэмон) Иә! ?
Dialogue: 0,1:35:25.88,1:35:28.30,Default,,0,0,0,,Не істеп жатырсың... Кедергі, кедергі.
Dialogue: 0,1:35:28.43,1:35:29.64,Default,,0,0,0,,Иә, иә (Нобита) Ах!
Dialogue: 0,1:35:29.76,1:35:30.85,Default,,0,0,0,,Хмм.
Dialogue: 0,1:35:30.97,1:35:33.64,Default,,0,0,0,,(Анамның ызылдағаны)
Dialogue: 0,1:35:35.27,1:35:37.02,Default,,0,0,0,,Сіз біраз уақыттан бері ненің суретін салып жүрсіз?
Dialogue: 0,1:35:37.52,1:35:40.52,Default,,0,0,0,,А, мен түсімде алтын қоңыз көрдім.
Dialogue: 0,1:35:40.65,1:35:41.77,Default,,0,0,0,,Қалай
Dialogue: 0,1:35:41.90,1:35:46.28,Default,,0,0,0,,Маған мұндай ыстық жерде ештеңе салудың қажеті жоқ.
Dialogue: 0,1:35:49.95,1:35:52.83,Default,,0,0,0,,Нобита-кун! Әке! Мен шығамын!
Dialogue: 0,1:35:52.95,1:35:54.37,Default,,0,0,0,,А, мен қазір барамын.
Dialogue: 0,1:35:54.49,1:35:55.58,Default,,0,0,0,,сол жақтағы бүлдіршінге бір сызат түспеуі үшін бар күшімізді салу.
Dialogue: 0,1:35:55.70,1:35:57.08,Default,,0,0,0,,Тезірек, Нобита
Dialogue: 0,1:35:57.20,1:35:58.87,Default,,0,0,0,,Күте тұрыңыз, әке!
Dialogue: 0,1:36:03.71,1:36:08.72,Default,,0,0,0,,♪～
Dialogue: 0,1:39:24.04,1:39:29.04,Default,,0,0,0,,～♪
Dialogue: 0,1:39:30.54,1:39:36.54,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory