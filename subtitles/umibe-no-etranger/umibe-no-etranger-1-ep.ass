Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:44.04,0:00:45.21,Default,,0,0,0,,Сәлем апай
Dialogue: 0,0:00:45.29,0:00:46.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:00:46.29,0:00:49.25,Default,,0,0,0,,Сен ана жақтағы орындықта отырған қызды білесің бе?
Dialogue: 0,0:00:49.75,0:00:52.46,Default,,0,0,0,,Ой, бұл Миокун ба?
Dialogue: 0,0:00:53.30,0:00:55.47,Default,,0,0,0,,Кішкентай кезімде анамның қасында болдым.
Dialogue: 0,0:00:55.55,0:00:59.55,Default,,0,0,0,,Нанымды алуға жиі келетін.
Dialogue: 0,0:01:00.06,0:01:01.97,Default,,0,0,0,,Хмм…
Dialogue: 0,0:01:04.56,0:01:07.48,Default,,0,0,0,,Мен үйдемін~
Dialogue: 0,0:01:08.23,0:01:09.81,Default,,0,0,0,,Қарапайым отбасы рөлін ойнауды жалғастыр
Dialogue: 0,0:01:09.90,0:01:12.32,Default,,0,0,0,,Қош келдіңіз, Сузу-чан?
Dialogue: 0,0:01:12.40,0:01:14.57,Default,,0,0,0,,Ол келмейді. Ол қосымша уақытты аяқтамайды.
Dialogue: 0,0:01:15.82,0:01:17.28,Default,,0,0,0,,Ах Эри, әлі ыстық... (Эри) Ыстық!
Dialogue: 0,0:01:17.36,0:01:18.53,Default,,0,0,0,,Оны жеме
Dialogue: 0,0:01:18.62,0:01:20.49,Default,,0,0,0,,Дәмді!
Dialogue: 0,0:01:42.89,0:01:43.81,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:01:43.89,0:01:44.77,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:31.90,0:02:33.98,Default,,0,0,0,,А, сәл күте тұрыңыз!
Dialogue: 0,0:02:34.07,0:02:35.07,Default,,0,0,0,,Олардың мүлде қозғалмай жатқаны оғаш екен
Dialogue: 0,0:02:35.15,0:02:36.90,Default,,0,0,0,,Тез кел!
Dialogue: 0,0:02:38.11,0:02:38.70,Default,,0,0,0,,Ах
Dialogue: 0,0:02:43.49,0:02:44.33,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:02:44.41,0:02:47.20,Default,,0,0,0,,Сіз әрқашан осында отырдыңыз ...
Dialogue: 0,0:02:50.54,0:02:52.25,Default,,0,0,0,,(велосипед қоңырауы)
Dialogue: 0,0:02:54.17,0:02:55.17,Default,,0,0,0,,Қат!
Dialogue: 0,0:02:55.25,0:02:57.38,Default,,0,0,0,,Үстіне көкөністерді саламыз...
Dialogue: 0,0:02:58.01,0:03:00.26,Default,,0,0,0,,А... жұмыста ма?
Dialogue: 0,0:03:00.84,0:03:03.26,Default,,0,0,0,,(Шоко) Есікті ашамын. Киініп жатқанда да апат болуы мүмкін, білесің бе.
Dialogue: 0,0:03:14.52,0:03:16.19,Default,,0,0,0,,Бұл менің апамнан.
Dialogue: 0,0:03:16.27,0:03:19.07,Default,,0,0,0,,Иә, әдеттегідей рахмет.
Dialogue: 0,0:03:19.15,0:03:21.24,Default,,0,0,0,,Шун-чан, мынаны же.
Dialogue: 0,0:03:22.78,0:03:23.74,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:03:23.82,0:03:25.62,Default,,0,0,0,,Осы екеуінің қайсысы екенін сұрап тұрмын. Сен бе?
Dialogue: 0,0:03:25.70,0:03:27.62,Default,,0,0,0,,Кешіріңіз, иә.
Dialogue: 0,0:03:28.54,0:03:30.00,Default,,0,0,0,,Бір карри және...
Dialogue: 0,0:03:30.08,0:03:32.12,Default,,0,0,0,,Мен сізге көмектесемін, өтінемін.
Dialogue: 0,0:03:32.21,0:03:33.58,Default,,0,0,0,,Иә
Dialogue: 0,0:03:33.67,0:03:36.54,Default,,0,0,0,,Кешіріңіз, бірақ қабылдау бөлімінде...
Dialogue: 0,0:03:36.63,0:03:37.92,Default,,0,0,0,,Сатору мен жоғары лауазымды тұлғалар арасындағы қақтығыс осыны ұйымдастырды деген сыбыс бар, солай емес пе?
Dialogue: 0,0:03:38.00,0:03:41.09,Default,,0,0,0,,Осы жерге отырыңыз да, сәл күтіңіз.
Dialogue: 0,0:03:41.59,0:03:43.01,Default,,0,0,0,,Онда «Лайт» орнына «Рыцарь» деп атай алам ба?
Dialogue: 0,0:03:46.05,0:03:48.26,Default,,0,0,0,,Шикі? (Әйел тұтынушы) Иә.
Dialogue: 0,0:03:49.47,0:03:51.98,Default,,0,0,0,,Қария, тапсырыс бере аламын ба?
Dialogue: 0,0:03:52.06,0:03:53.27,Default,,0,0,0,,Иә
Dialogue: 0,0:03:56.77,0:03:58.19,Default,,0,0,0,,Хаа~
Dialogue: 0,0:03:59.23,0:03:59.90,Default,,0,0,0,,Иә?
Dialogue: 0,0:04:05.53,0:04:06.78,Default,,0,0,0,,О, күте тұр, сен!
Dialogue: 0,0:04:06.87,0:04:07.87,Default,,0,0,0,,Күте тұрыңыз!
Dialogue: 0,0:04:11.16,0:04:13.79,Default,,0,0,0,,Бұл дүкеннің қалған бөлігі.
Dialogue: 0,0:04:14.83,0:04:17.38,Default,,0,0,0,,А... қарның аш емес пе?
Dialogue: 0,0:04:18.25,0:04:18.80,Default,,0,0,0,,Бөлек
Dialogue: 0,0:04:19.92,0:04:22.63,Default,,0,0,0,,А... А, түсіндім.
Dialogue: 0,0:04:22.72,0:04:25.68,Default,,0,0,0,,Дұрыс, кешкі ас бар.
Dialogue: 0,0:04:27.22,0:04:29.68,Default,,0,0,0,,Маған бере аласыз ба?
Dialogue: 0,0:04:29.76,0:04:32.98,Default,,0,0,0,,Не? Иә... иә
Dialogue: 0,0:04:38.36,0:04:39.82,Default,,0,0,0,,Рахмет
Dialogue: 0,0:04:40.32,0:04:42.40,Default,,0,0,0,,Не? А, мүлде жоқ
Dialogue: 0,0:04:51.16,0:04:54.33,Default,,0,0,0,,бірақ қанға бөккен қол дәл алдына ұсынылғанда да,
Dialogue: 0,0:04:54.41,0:04:55.79,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:04:55.87,0:04:57.08,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:04:57.17,0:05:01.21,Default,,0,0,0,,Жоқ, жоқ, кенеттен келді~
Dialogue: 0,0:05:01.30,0:05:02.34,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:05:02.42,0:05:03.97,Default,,0,0,0,,Мұздатқыш балмұздақ жақсы-ақ, бірақ бұл да дәмді.
Dialogue: 0,0:05:04.59,0:05:05.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:05.97,0:05:07.84,Default,,0,0,0,,Миокун дәл қазір келді.
Dialogue: 0,0:05:08.47,0:05:10.31,Default,,0,0,0,,Нан үшін рахмет.
Dialogue: 0,0:05:10.39,0:05:13.77,Default,,0,0,0,,Анаңның көшеттері бөлінген сияқты.
Dialogue: 0,0:05:13.85,0:05:15.23,Default,,0,0,0,,Я~
Dialogue: 0,0:05:17.98,0:05:21.57,Default,,0,0,0,,Мио-кун, мен сенің анаңның қайтыс болғанын естідім.
Dialogue: 0,0:05:21.65,0:05:22.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:23.19,0:05:25.07,Default,,0,0,0,,Біз екеуміз ғана болдық.
Dialogue: 0,0:05:25.15,0:05:26.90,Default,,0,0,0,,Мен жалғызбын
Dialogue: 0,0:05:27.49,0:05:29.87,Default,,0,0,0,,Ол бала әлі орта мектепте оқиды.
Dialogue: 0,0:05:31.08,0:05:33.16,Default,,0,0,0,,Жалғыздық болуы керек...
Dialogue: 0,0:05:39.17,0:05:41.38,Default,,0,0,0,,(Жел қоңырауының дыбысы)
Dialogue: 0,0:05:44.09,0:05:47.13,Default,,0,0,0,,Мио Кешкі асқа не қалайсыз?
Dialogue: 0,0:05:47.22,0:05:48.38,Default,,0,0,0,,Карри
Dialogue: 0,0:05:48.47,0:05:52.60,Default,,0,0,0,,Мен оны кеше және кеше жедім.
Dialogue: 0,0:05:52.68,0:05:53.97,Default,,0,0,0,,Тағы не?
Dialogue: 0,0:05:54.06,0:05:56.64,Default,,0,0,0,,Иә? Сонда...
Dialogue: 0,0:05:56.73,0:05:57.98,Default,,0,0,0,,Алдымен, қазіргі жағдайды ескерсек—
Dialogue: 0,0:05:58.73,0:06:00.10,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:00.19,0:06:03.61,Default,,0,0,0,,Иә? Бүгін ақшасыз күн бе?
Dialogue: 0,0:06:04.11,0:06:07.03,Default,,0,0,0,,Жоқ, шаян жейміз.
Dialogue: 0,0:06:07.78,0:06:08.91,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:06:08.99,0:06:10.37,Default,,0,0,0,,А... иә
Dialogue: 0,0:06:10.45,0:06:14.87,Default,,0,0,0,,Хахахаха!
Dialogue: 0,0:06:15.37,0:06:17.00,Default,,0,0,0,,Каникаманма…
Dialogue: 0,0:06:17.08,0:06:19.04,Default,,0,0,0,,Ол Аня-чанның әкесі бола ма?
Dialogue: 0,0:06:19.67,0:06:23.67,Default,,0,0,0,,Краб таяқшасы... Дәмді!
Dialogue: 0,0:06:27.22,0:06:29.30,Default,,0,0,0,,О, өте дәмді!
Dialogue: 0,0:06:29.38,0:06:31.30,Default,,0,0,0,,Иә, бұл дәмді!
Dialogue: 0,0:06:31.39,0:06:33.51,Default,,0,0,0,,Дәмді толтыру!
Dialogue: 0,0:06:33.60,0:06:36.56,Default,,0,0,0,,Иә, иә, менде толтыру бар.
Dialogue: 0,0:06:41.19,0:06:45.36,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:06:45.44,0:06:46.65,Default,,0,0,0,,Көрші есік жақсы ма?
Dialogue: 0,0:06:51.28,0:06:52.16,Default,,0,0,0,,Сәлем
Dialogue: 0,0:06:55.08,0:06:57.25,Default,,0,0,0,,Гүлдер Рахмет
Dialogue: 0,0:06:57.33,0:06:57.83,Default,,0,0,0,,О
Dialogue: 0,0:06:58.91,0:07:02.83,Default,,0,0,0,,Эй... сен үнемі не қарайсың? Осы жерден
Dialogue: 0,0:07:03.50,0:07:05.34,Default,,0,0,0,,Ештеңе...
Dialogue: 0,0:07:08.09,0:07:10.43,Default,,0,0,0,,Сіз әрқашан жалғыздықты сезінесіз бе?
Dialogue: 0,0:07:14.55,0:07:15.35,Default,,0,0,0,,Не?
Dialogue: 0,0:07:15.43,0:07:16.89,Default,,0,0,0,,Не? Ах... кешіріңіз.
Dialogue: 0,0:07:16.97,0:07:18.35,Default,,0,0,0,,Бұл сіз әрқашан көресіз!
Dialogue: 0,0:07:20.69,0:07:21.60,Default,,0,0,0,,Оны дәл осы жерде жоямыз
Dialogue: 0,0:07:22.35,0:07:23.90,Default,,0,0,0,,Бұл жиіркенішті.
Dialogue: 0,0:07:26.90,0:07:29.49,Default,,0,0,0,,Эй, Хашимото кейде әйелдік болып көрінеді, солай ма?
Dialogue: 0,0:07:29.57,0:07:31.45,Default,,0,0,0,,Тұр, мен мұнда сұрақ қоятын адаммын.
Dialogue: 0,0:07:31.53,0:07:33.36,Default,,0,0,0,,Мүмкін ол гей шығар?
Dialogue: 0,0:07:33.45,0:07:36.03,Default,,0,0,0,,Уау! Мен сенің жаныңда отырмын.
Dialogue: 0,0:07:36.12,0:07:37.16,Default,,0,0,0,,Бұл ақылсыз
Dialogue: 0,0:07:37.24,0:07:39.00,Default,,0,0,0,,Сіз ренжіп қалуыңыз мүмкін!
Dialogue: 0,0:07:39.08,0:07:43.08,Default,,0,0,0,,(Сыныптастардың күлкісі)
Dialogue: 0,0:07:46.79,0:07:48.34,Default,,0,0,0,,А, мен ояндым.
Dialogue: 0,0:07:49.46,0:07:50.47,Default,,0,0,0,,Сузу-чан?
Dialogue: 0,0:07:50.55,0:07:52.47,Default,,0,0,0,,Эй, сен ояусың ба?
Dialogue: 0,0:07:52.55,0:07:55.05,Default,,0,0,0,,Сіз қайтадан құладыңыз.
Dialogue: 0,0:07:55.14,0:07:56.39,Default,,0,0,0,,Не, бұл өтірік!
Dialogue: 0,0:07:56.47,0:07:57.68,Default,,0,0,0,,Мен аламын (Шун) А...
Dialogue: 0,0:07:58.47,0:08:00.39,Default,,0,0,0,,Шун: Бірдеңе болды ма?
Dialogue: 0,0:08:00.48,0:08:02.14,Default,,0,0,0,,Кеше болған жайтқа әлі де алаңдайсың ба?
Dialogue: 0,0:08:02.23,0:08:03.77,Default,,0,0,0,,Сузу-чанға да рахмет.
Dialogue: 0,0:08:03.85,0:08:04.81,Default,,0,0,0,,Жоқ
Dialogue: 0,0:08:06.98,0:08:08.73,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,0:08:08.82,0:08:10.23,Default,,0,0,0,,Мен оларды шаруамен жібердім.
Dialogue: 0,0:08:10.82,0:08:15.99,Default,,0,0,0,,Бір жыныстағы адамдар романтикалық қарым-қатынаста болады емес пе?
Dialogue: 0,0:08:16.62,0:08:20.16,Default,,0,0,0,,Неліктен бұл біртүрлі болып шықты?
Dialogue: 0,0:08:23.21,0:08:26.17,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:08:26.25,0:08:28.17,Default,,0,0,0,,Бұл не? (Шун) А.
Dialogue: 0,0:08:29.42,0:08:30.88,Default,,0,0,0,,Жұмыс…
Dialogue: 0,0:08:30.96,0:08:33.13,Default,,0,0,0,,Мен сізді роман жазып жатыр деп естідім.
Dialogue: 0,0:08:33.22,0:08:34.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:08:34.47,0:08:38.01,Default,,0,0,0,,Бірақ бұл менің қолжазбам емес, бұл алдын ала оқу...
Dialogue: 0,0:08:38.10,0:08:40.43,Default,,0,0,0,,маңызды ма?
Dialogue: 0,0:08:40.93,0:08:42.52,Default,,0,0,0,,Мен қорқынышты нәрсе айттым
Dialogue: 0,0:08:43.73,0:08:44.52,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:08:45.02,0:08:45.77,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:45.85,0:08:49.02,Default,,0,0,0,,Неге кешірім сұрайсыз? Бұл мен ғана едім...
Dialogue: 0,0:08:49.86,0:08:51.53,Default,,0,0,0,,Мен сені аяймын...
Dialogue: 0,0:08:52.86,0:08:54.61,Default,,0,0,0,,Барлығы маған осылай қарайды.
Dialogue: 0,0:08:55.36,0:08:59.28,Default,,0,0,0,,Өзіңізді отбасыңызсыз мұңсыз немесе жалғыз сезінесіз бе?
Dialogue: 0,0:08:59.78,0:09:02.04,Default,,0,0,0,,Мұны мен ғана түсінемін.
Dialogue: 0,0:09:02.70,0:09:04.54,Default,,0,0,0,,Мені оңай жұбатқаныңды қаламаймын.
Dialogue: 0,0:09:06.21,0:09:09.25,Default,,0,0,0,,Сен де солай ма деп едім...
Dialogue: 0,0:09:09.34,0:09:10.04,Default,,0,0,0,,Жоқ!
Dialogue: 0,0:09:10.13,0:09:11.30,Default,,0,0,0,,Ах
Dialogue: 0,0:09:11.38,0:09:16.55,Default,,0,0,0,,А-а... Мен қызық болдым...
Dialogue: 0,0:09:16.63,0:09:18.80,Default,,0,0,0,,Мен сенімен сөйлескім келді.
Dialogue: 0,0:09:19.60,0:09:21.56,Default,,0,0,0,,Бұл жай ғана жасырын ниет.
Dialogue: 0,0:09:23.68,0:09:24.73,Default,,0,0,0,,Б-бірақ… енді Хигучи Кира екенін білгеннен кейін,
Dialogue: 0,0:09:25.23,0:09:25.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:26.39,0:09:29.56,Default,,0,0,0,,Ешқандай себеп жоқ, қыздарды жинағандай
Dialogue: 0,0:09:32.53,0:09:33.40,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:09:36.40,0:09:37.36,Default,,0,0,0,,Жақсы
Dialogue: 0,0:09:41.70,0:09:44.12,Default,,0,0,0,,Қат! Кешкі асқа бірдеңе...
Dialogue: 0,0:09:44.20,0:09:46.00,Default,,0,0,0,,Не? Күте тұрыңыз... (Эри) Әй?
Dialogue: 0,0:09:46.08,0:09:47.83,Default,,0,0,0,,О, ой, ой? (Шун) Эри?
Dialogue: 0,0:09:47.92,0:09:50.96,Default,,0,0,0,,Тағы бір әдемі бала~
Dialogue: 0,0:09:51.04,0:09:53.71,Default,,0,0,0,,Бүгін қалайсың?
Dialogue: 0,0:09:53.80,0:09:54.59,Default,,0,0,0,,Эри!
Dialogue: 0,0:09:54.67,0:09:57.09,Default,,0,0,0,,Уа, дұрыс.
Dialogue: 0,0:09:57.17,0:09:57.93,Default,,0,0,0,,Хехе
Dialogue: 0,0:09:58.43,0:10:00.43,Default,,0,0,0,,Зарядтау~!
Dialogue: 0,0:10:00.51,0:10:01.80,Default,,0,0,0,,Хехе
Dialogue: 0,0:10:02.31,0:10:04.10,Default,,0,0,0,,Шун (Шун) Иә?
Dialogue: 0,0:10:04.68,0:10:06.60,Default,,0,0,0,,Сіздің атыңыз Шун ба?
Dialogue: 0,0:10:07.10,0:10:09.35,Default,,0,0,0,,Дұрыс, ат кейіпкері.
Dialogue: 0,0:10:09.44,0:10:12.11,Default,,0,0,0,,Мен Миомын.
Dialogue: 0,0:10:12.73,0:10:15.11,Default,,0,0,0,,Жемістің ортасында
Dialogue: 0,0:10:15.19,0:10:16.36,Default,,0,0,0,,Я~
Dialogue: 0,0:10:16.44,0:10:19.07,Default,,0,0,0,,Мен үйге ерте барып кешкі ас әзірлеуім керек.
Dialogue: 0,0:10:19.66,0:10:20.62,Default,,0,0,0,,Карри!
Dialogue: 0,0:10:20.70,0:10:21.87,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:10:21.95,0:10:23.99,Default,,0,0,0,,Карри Карри!
Dialogue: 0,0:10:24.08,0:10:28.46,Default,,0,0,0,,Карри Карри Карри Карри!
Dialogue: 0,0:10:29.12,0:10:30.12,Default,,0,0,0,,Шун...
Dialogue: 0,0:10:30.21,0:10:31.54,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:31.63,0:10:33.67,Default,,0,0,0,,Сіз балық аулауда нашарсыз.
Dialogue: 0,0:10:33.75,0:10:34.88,Default,,0,0,0,,Гррр…
Dialogue: 0,0:10:35.92,0:10:37.97,Default,,0,0,0,,Сәлем! Ал балық ше?
Dialogue: 0,0:10:38.47,0:10:39.97,Default,,0,0,0,,Ешбір балықты ұстай алмады
Dialogue: 0,0:10:40.05,0:10:41.59,Default,,0,0,0,,Ум...Шун (Эри) Біреу ме?
Dialogue: 0,0:10:41.68,0:10:43.64,Default,,0,0,0,,Ух... өте шулы! (Мио) Мен үйге барамын.
Dialogue: 0,0:10:44.22,0:10:46.14,Default,,0,0,0,,Иә? Сен не туралы айтып тұрсың?
Dialogue: 0,0:10:46.22,0:10:48.43,Default,,0,0,0,,Сен де тамақ ішесің.
Dialogue: 0,0:10:48.52,0:10:50.48,Default,,0,0,0,,Не? (қоңырау) Иә, иә
Dialogue: 0,0:10:52.15,0:10:54.40,Default,,0,0,0,,Иә, онда...
Dialogue: 0,0:10:54.48,0:10:57.03,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,0:10:57.11,0:10:58.65,Default,,0,0,0,,Ах, итадакамасу
Dialogue: 0,0:11:00.03,0:11:01.41,Default,,0,0,0,,Пуха~!
Dialogue: 0,0:11:01.99,0:11:04.62,Default,,0,0,0,,Миокун, сен жақсы аспазсың, солай ма?
Dialogue: 0,0:11:04.70,0:11:07.50,Default,,0,0,0,,А, мен үйге көмектесіп жүрдім.
Dialogue: 0,0:11:07.58,0:11:09.50,Default,,0,0,0,,Түсіндім, иә?
Dialogue: 0,0:11:09.58,0:11:10.67,Default,,0,0,0,,Иә, Миокун.
Dialogue: 0,0:11:11.29,0:11:12.79,Default,,0,0,0,,Рахмет
Dialogue: 0,0:11:12.88,0:11:15.92,Default,,0,0,0,,Бұл жігіт мүлде жақсармайды.
Dialogue: 0,0:11:16.00,0:11:17.63,Default,,0,0,0,,Мынаны қараңыз
Dialogue: 0,0:11:17.71,0:11:19.26,Default,,0,0,0,,Олай болса оны жеме.
Dialogue: 0,0:11:20.97,0:11:24.43,Default,,0,0,0,,Шун сені үнемі уайымдайтын.
Dialogue: 0,0:11:24.51,0:11:26.47,Default,,0,0,0,,Эри! сен керексізсің...
Dialogue: 0,0:11:26.56,0:11:28.18,Default,,0,0,0,,Бұл дұрыс емес пе?
Dialogue: 0,0:11:29.02,0:11:30.85,Default,,0,0,0,,Шулы болғаным үшін кешіріңіз.
Dialogue: 0,0:11:31.35,0:11:33.40,Default,,0,0,0,,Сізге карри ұнай ма, Мио?
Dialogue: 0,0:11:33.48,0:11:36.44,Default,,0,0,0,,А, мен оны жақсы көремін...
Dialogue: 0,0:11:37.57,0:11:38.48,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:39.28,0:11:41.24,Default,,0,0,0,,Мен сенің үмітіңе сүйенемін, Гран Торино
Dialogue: 0,0:11:41.32,0:11:43.20,Default,,0,0,0,,Енді аузыңды жап, тамақ іш!
Dialogue: 0,0:11:43.28,0:11:44.70,Default,,0,0,0,,Мен қуаныштымын~
Dialogue: 0,0:11:44.78,0:11:46.41,Default,,0,0,0,,Гах... Эри!
Dialogue: 0,0:11:46.49,0:11:48.45,Default,,0,0,0,,Ах, Сузу, мен қуырылған тауық жедім.
Dialogue: 0,0:11:48.54,0:11:50.71,Default,,0,0,0,,Иә (Шун) Эй, тыңдап тұрсың ба!
Dialogue: 0,0:11:50.79,0:11:52.50,Default,,0,0,0,,Мен тыңдамаймын.
Dialogue: 0,0:11:52.58,0:11:53.37,Default,,0,0,0,,Не~!
Dialogue: 0,0:11:53.46,0:11:56.67,Default,,0,0,0,,Ах, Сузу-чан, мына картоп салаты дәмді екен.
Dialogue: 0,0:11:56.75,0:11:58.96,Default,,0,0,0,,А, жақсы.
Dialogue: 0,0:12:00.05,0:12:02.51,Default,,0,0,0,,Ха... Мен көп жедім.
Dialogue: 0,0:12:02.59,0:12:04.55,Default,,0,0,0,,Жақсы тамақтанып алдың.
Dialogue: 0,0:12:04.64,0:12:05.72,Default,,0,0,0,,Ахахаха
Dialogue: 0,0:12:07.14,0:12:09.14,Default,,0,0,0,,Шун (Шун) Иә?
Dialogue: 0,0:12:09.64,0:12:12.73,Default,,0,0,0,,Мен ертең басты аралдағы нысанға көшемін.
Dialogue: 0,0:12:14.10,0:12:15.73,Default,,0,0,0,,Иә? ертең?
Dialogue: 0,0:12:16.31,0:12:19.15,Default,,0,0,0,,А-а, байланыс ақпараты... Ұялы телефоныңыз ше?
Dialogue: 0,0:12:19.65,0:12:21.24,Default,,0,0,0,,Менде ұялы телефон жоқ
Dialogue: 0,0:12:22.28,0:12:25.99,Default,,0,0,0,,Балалар өздігінен ештеңе істей алмайды.
Dialogue: 0,0:12:29.33,0:12:30.83,Default,,0,0,0,,Шун
Dialogue: 0,0:12:32.12,0:12:35.25,Default,,0,0,0,,Мен саған жеткенде хабарласамын.
Dialogue: 0,0:12:46.30,0:12:50.97,Default,,0,0,0,,(Годжо) Кәмелетке толмаған… 16 жастағы бала, білесің бе.
Dialogue: 0,0:12:57.98,0:13:01.23,Default,,0,0,0,,Сәлем, мұғалім! Маған көмектес
Dialogue: 0,0:13:01.32,0:13:03.61,Default,,0,0,0,,«Мырза» деп айтпаңыз
Dialogue: 0,0:13:03.69,0:13:04.86,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:04.95,0:13:08.37,Default,,0,0,0,,Ал, шындық мынандай~
Dialogue: 0,0:13:08.45,0:13:09.87,Default,,0,0,0,,Әй?
Dialogue: 0,0:13:09.95,0:13:13.87,Default,,0,0,0,,Екінші жағынан, бұл екеумізге ғана арналған махаббат ұясы ма?
Dialogue: 0,0:13:13.95,0:13:15.21,Default,,0,0,0,,Бұл жақсы.
Dialogue: 0,0:13:15.29,0:13:19.71,Default,,0,0,0,,Кешіріңіз, мен жай ғана бақыттымын, Қареки-сені.
Dialogue: 0,0:13:19.79,0:13:21.63,Default,,0,0,0,,Шулы! Тез шық!
Dialogue: 0,0:13:22.59,0:13:23.84,Default,,0,0,0,,Хаа…
Dialogue: 0,0:13:23.92,0:13:27.26,Default,,0,0,0,,А, келесі тұрғын жақында келеді, солай ма?
Dialogue: 0,0:13:27.80,0:13:29.76,Default,,0,0,0,,Иә? Мен оны естіген жоқпын
Dialogue: 0,0:13:29.85,0:13:33.43,Default,,0,0,0,,Апай еркекті қалайтынын айтады.
Dialogue: 0,0:13:34.31,0:13:36.52,Default,,0,0,0,,Маған бәрібір
Dialogue: 0,0:13:40.90,0:13:41.77,Default,,0,0,0,,Шун?
Dialogue: 0,0:13:43.36,0:13:44.28,Default,,0,0,0,,Сіз ұйықтап жатырсыз ба?
Dialogue: 0,0:13:48.11,0:13:49.62,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:13:50.12,0:13:51.78,Default,,0,0,0,,(Мысықтың мияулауы)
Dialogue: 0,0:13:55.79,0:13:56.83,Default,,0,0,0,,Мио?
Dialogue: 0,0:13:56.91,0:13:59.42,Default,,0,0,0,,Шун Қалайсың?
Dialogue: 0,0:13:59.50,0:14:00.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:00.88,0:14:03.96,Default,,0,0,0,,Жаңа жігіт... Иә?
Dialogue: 0,0:14:04.05,0:14:04.88,Default,,0,0,0,,Иә
Dialogue: 0,0:14:04.96,0:14:06.30,Default,,0,0,0,,Сіз қайда тұрасыз?
Dialogue: 0,0:14:06.38,0:14:08.93,Default,,0,0,0,,Иә, мен 20 жасқа толдым.
Dialogue: 0,0:14:09.55,0:14:12.93,Default,,0,0,0,,Мен де Эри-чаннан сұрап, осында пайдалы нәрсе білдім.
Dialogue: 0,0:14:13.01,0:14:15.43,Default,,0,0,0,,Мен Шунды жақсы көремін.
Dialogue: 0,0:14:15.52,0:14:20.19,Default,,0,0,0,,Сондықтан Шун, өтінемін, маған да ғашық бол.
Dialogue: 0,0:14:20.77,0:14:21.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:21.61,0:14:22.69,Default,,0,0,0,,Ахахха!
Dialogue: 0,0:14:22.77,0:14:25.03,Default,,0,0,0,,Шун: Сізге жақсы!
Dialogue: 0,0:14:25.11,0:14:25.69,Default,,0,0,0,,Эри!
Dialogue: 0,0:14:25.78,0:14:28.49,Default,,0,0,0,,Мен мұндай жақсы мүлікті ешқашан таба алмаймын!
Dialogue: 0,0:14:28.57,0:14:30.32,Default,,0,0,0,,Ух... өте шулы.
Dialogue: 0,0:14:30.41,0:14:31.57,Default,,0,0,0,,Хехехе
Dialogue: 0,0:14:31.66,0:14:33.37,Default,,0,0,0,,«хехехе» емес!
Dialogue: 0,0:14:33.45,0:14:35.58,Default,,0,0,0,,Қазірдің өзінде! Балалар сендер қандайсыңдар!
Dialogue: 0,0:14:35.66,0:14:37.91,Default,,0,0,0,,Құттықтаймыз! (Suzu) Құттықтаймыз!
Dialogue: 0,0:14:38.00,0:14:38.71,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:42.08,0:14:43.21,Default,,0,0,0,,Бұл гүл...
Dialogue: 0,0:14:43.29,0:14:46.21,Default,,0,0,0,,Мен сенің көшеттеріңді отырғыздым.
Dialogue: 0,0:14:46.30,0:14:48.59,Default,,0,0,0,,Өсе келе мен саған ұқсаймын.
Dialogue: 0,0:14:49.17,0:14:50.59,Default,,0,0,0,,Ол біршама өсті, солай емес пе?
Dialogue: 0,0:14:52.14,0:14:54.60,Default,,0,0,0,,Эй, қалжыңдап тұрсың ба?
Dialogue: 0,0:14:55.64,0:14:59.10,Default,,0,0,0,,Еркекті ұнатудың жақсы жағы жоқ.
Dialogue: 0,0:14:59.85,0:15:01.60,Default,,0,0,0,,Сондықтан үш жыл ойландым.
Dialogue: 0,0:15:01.69,0:15:04.11,Default,,0,0,0,,Бұл жай ғана болжам.
Dialogue: 0,0:15:04.86,0:15:05.94,Default,,0,0,0,,(Барлығы төрт адам) Һмм? (JoJo) Дерби?
Dialogue: 0,0:15:06.53,0:15:07.94,Default,,0,0,0,,Егер солай болса...
Dialogue: 0,0:15:08.49,0:15:10.45,Default,,0,0,0,,Себептер дұрыс.
Dialogue: 0,0:15:11.45,0:15:13.16,Default,,0,0,0,,Себебі мен сенімен бірге болғым келеді...
Dialogue: 0,0:15:14.95,0:15:16.20,Default,,0,0,0,,Мен қайтып келдім
Dialogue: 0,0:15:17.24,0:15:17.87,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:19.00,0:15:19.87,Default,,0,0,0,,Шун
Dialogue: 0,0:15:22.67,0:15:23.88,Default,,0,0,0,,Бірдеңе...
Dialogue: 0,0:15:24.46,0:15:25.88,Default,,0,0,0,,Менің қарным ашты
Dialogue: 0,0:15:26.42,0:15:27.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:27.59,0:15:30.01,Default,,0,0,0,,Неге қазір?
Dialogue: 0,0:15:30.09,0:15:33.05,Default,,0,0,0,,Жетер, бірдеңе жейміз.
Dialogue: 0,0:15:33.14,0:15:36.01,Default,,0,0,0,,Жоқ... күте тұр... Қат!
Dialogue: 0,0:15:36.68,0:15:38.52,Default,,0,0,0,,Хигучи, қолыңды көтер де, көліктен шық.
Dialogue: 0,0:15:38.60,0:15:39.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:15:41.19,0:15:43.10,Default,,0,0,0,,Мио қош келдіңіз
Dialogue: 0,0:15:43.19,0:15:43.94,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:45.36,0:15:48.03,Default,,0,0,0,,Себебі мен саған әлі айтқан жоқпын.
Dialogue: 0,0:15:49.78,0:15:50.49,Default,,0,0,0,,Иә
Dialogue: 0,0:15:54.28,0:15:55.41,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:16:03.42,0:16:06.21,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:16:12.59,0:16:15.72,Default,,0,0,0,,Мен осындамын, анам мен әкем.
Dialogue: 0,0:16:16.55,0:16:17.81,Default,,0,0,0,,Бүгін қалайсың?
Dialogue: 0,0:16:31.44,0:16:32.70,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:16:32.78,0:16:34.36,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:16:34.45,0:16:37.37,Default,,0,0,0,,Әй, керемет.
Dialogue: 0,0:16:37.45,0:16:40.24,Default,,0,0,0,,Аа, таңғы ас ішкен жоқсың ба?
Dialogue: 0,0:16:42.83,0:16:44.58,Default,,0,0,0,,Сіз қалай ойлайсыз? Ол дамыды ма?
Dialogue: 0,0:16:45.50,0:16:46.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:16:46.88,0:16:48.79,Default,,0,0,0,,Ze… мүлде емес
Dialogue: 0,0:16:48.88,0:16:49.88,Default,,0,0,0,,Уау
Dialogue: 0,0:16:50.50,0:16:52.34,Default,,0,0,0,,... Сәттілік
Dialogue: 0,0:16:52.42,0:16:54.38,Default,,0,0,0,,Окабе ше? Білмеймін. Мен өте бос болдым ғой.
Dialogue: 0,0:16:54.47,0:16:56.80,Default,,0,0,0,,Хехехехе…
Dialogue: 0,0:16:58.72,0:16:59.89,Default,,0,0,0,,Ах!
Dialogue: 0,0:16:59.97,0:17:02.10,Default,,0,0,0,,Сіз сұрағаныңыз туралы не айтасыз?
Dialogue: 0,0:17:02.18,0:17:03.85,Default,,0,0,0,,Иә? (Шун) Суық пета
Dialogue: 0,0:17:03.93,0:17:05.85,Default,,0,0,0,,Ах! Мен ұмыттым
Dialogue: 0,0:17:06.35,0:17:10.52,Default,,0,0,0,,Кешіріңіз! Менің толық емес жұмысым бар, сондықтан оны үйге бара жатқанда сатып аламын.
Dialogue: 0,0:17:10.61,0:17:12.03,Default,,0,0,0,,Сізде толық емес жұмыс күні бар ма?
Dialogue: 0,0:17:12.11,0:17:13.78,Default,,0,0,0,,Иә, мен кешке үйге барамын.
Dialogue: 0,0:17:13.86,0:17:15.82,Default,,0,0,0,,(Мұғалім) Ал қарама-қарсы, 7-орын, 0 жау ұпайымен…
Dialogue: 0,0:17:19.12,0:17:20.58,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,0:17:20.66,0:17:21.66,Default,,0,0,0,,Иә
Dialogue: 0,0:17:22.37,0:17:24.87,Default,,0,0,0,,Иә, сізді күткенім үшін кешіріңіз.
Dialogue: 0,0:17:24.96,0:17:27.79,Default,,0,0,0,,Қуырылған ет және Фучампуру
Dialogue: 0,0:17:27.88,0:17:29.79,Default,,0,0,0,,Мен аралданмын ба?
Dialogue: 0,0:17:29.88,0:17:30.63,Default,,0,0,0,,Бо…
Dialogue: 0,0:17:31.46,0:17:33.05,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:17:34.09,0:17:35.05,Default,,0,0,0,,Сіздің атыңыз кім?
Dialogue: 0,0:17:35.76,0:17:37.51,Default,,0,0,0,,Бұл Чика-кун.
Dialogue: 0,0:17:37.59,0:17:38.59,Default,,0,0,0,,Жасың нешеде?
Dialogue: 0,0:17:39.09,0:17:41.14,Default,,0,0,0,,20 жаста (Әйел тұтынушылар) Өте жас!
Dialogue: 0,0:17:41.64,0:17:43.77,Default,,0,0,0,,Ал, ол туралы не деуге болады?
Dialogue: 0,0:17:43.85,0:17:45.68,Default,,0,0,0,,А, қызыл түсті!
Dialogue: 0,0:17:45.77,0:17:47.39,Default,,0,0,0,,Мен сенің үмітіңе сүйенемін, Гран Торино
Dialogue: 0,0:17:50.11,0:17:52.61,Default,,0,0,0,,Шун Ванна бос.
Dialogue: 0,0:17:53.48,0:17:55.40,Default,,0,0,0,,Мен шаршадым, біраз ұйықтаймын
Dialogue: 0,0:17:55.49,0:17:56.07,Default,,0,0,0,,Не!
Dialogue: 0,0:17:56.15,0:17:58.91,Default,,0,0,0,,Олай болса, мен бүгін сонда ұйықтай аламын ба?
Dialogue: 0,0:17:58.99,0:18:01.08,Default,,0,0,0,,Иә? Бұл жақсы емес
Dialogue: 0,0:18:01.16,0:18:02.83,Default,,0,0,0,,Жақсы.
Dialogue: 0,0:18:03.58,0:18:05.33,Default,,0,0,0,,Тым ашық па?
Dialogue: 0,0:18:06.54,0:18:10.50,Default,,0,0,0,,Сіз шынымен ештеңе туралы ойламайсыз.
Dialogue: 0,0:18:20.05,0:18:22.72,Default,,0,0,0,,(Қаламның жүгірген дыбысы)
Dialogue: 0,0:18:34.57,0:18:38.24,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:18:51.00,0:18:51.75,Default,,0,0,0,,Хехе
Dialogue: 0,0:18:52.71,0:18:54.34,Default,,0,0,0,,Анашым!
Dialogue: 0,0:18:55.34,0:18:56.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:57.34,0:19:00.18,Default,,0,0,0,,Мұны Мио жасады ма?
Dialogue: 0,0:19:00.26,0:19:03.01,Default,,0,0,0,,Иә, бұл үлкен көмек.
Dialogue: 0,0:19:03.72,0:19:08.10,Default,,0,0,0,,Иә! Үлкен көмек...
Dialogue: 0,0:19:08.60,0:19:09.94,Default,,0,0,0,,Же, же!
Dialogue: 0,0:19:10.02,0:19:10.77,Default,,0,0,0,,Ах
Dialogue: 0,0:19:15.23,0:19:17.23,Default,,0,0,0,,Itadadakimasu!
Dialogue: 0,0:19:17.73,0:19:20.11,Default,,0,0,0,,Ммм, дәмді!
Dialogue: 0,0:19:20.20,0:19:21.99,Default,,0,0,0,,Мио рахмет
Dialogue: 0,0:19:22.07,0:19:23.99,Default,,0,0,0,,Не болды!
Dialogue: 0,0:19:24.49,0:19:27.20,Default,,0,0,0,,Ах, бай адамдар осындай кемені бос уақыттарында пайдаланады —
Dialogue: 0,0:19:29.00,0:19:29.66,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:34.92,0:19:36.13,Default,,0,0,0,,Сіз ұйықтамайсыз ба?
Dialogue: 0,0:19:36.63,0:19:37.75,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:42.55,0:19:44.68,Default,,0,0,0,,Мио~!
Dialogue: 0,0:19:45.30,0:19:48.85,Default,,0,0,0,,Мен түнде барамын, жегің келетін нәрсе бар ма?
Dialogue: 0,0:19:48.93,0:19:50.10,Default,,0,0,0,,Карри
Dialogue: 0,0:19:50.18,0:19:51.85,Default,,0,0,0,,Маған ұнайды
Dialogue: 0,0:19:52.35,0:19:52.85,Default,,0,0,0,,Сонымен?
Dialogue: 0,0:19:53.56,0:19:56.48,Default,,0,0,0,,Жазушымен өміріңіз қалай?
Dialogue: 0,0:19:59.03,0:20:02.32,Default,,0,0,0,,Жарайды... Менің ойымша, бұл қалыпты жағдай.
Dialogue: 0,0:20:10.08,0:20:11.66,Default,,0,0,0,,Келдің бе?
Dialogue: 0,0:20:11.75,0:20:13.62,Default,,0,0,0,,О, мырза.
Dialogue: 0,0:20:13.71,0:20:14.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:14.58,0:20:18.63,Default,,0,0,0,,Бұл сенсің, маған дұрыстап қарашы.
Dialogue: 0,0:20:18.71,0:20:20.09,Default,,0,0,0,,Не?
Dialogue: 0,0:20:21.59,0:20:24.38,Default,,0,0,0,,Бос емес болып көрінесіз бе?
Dialogue: 0,0:20:24.47,0:20:26.09,Default,,0,0,0,,Бұл жасандылық емес
Dialogue: 0,0:20:32.35,0:20:33.89,Default,,0,0,0,,Орындау мерзімі қашан?
Dialogue: 0,0:20:33.98,0:20:34.90,Default,,0,0,0,,Кеше
Dialogue: 0,0:20:34.98,0:20:35.94,Default,,0,0,0,,Не!
Dialogue: 0,0:20:36.44,0:20:38.19,Default,,0,0,0,,Ертең жіберсең, уақытында келеді.
Dialogue: 0,0:20:38.94,0:20:40.90,Default,,0,0,0,,Уақыт өтіп кеткен жоқ па?
Dialogue: 0,0:20:43.20,0:20:45.20,Default,,0,0,0,,Шун бос емес пе?
Dialogue: 0,0:20:45.70,0:20:46.99,Default,,0,0,0,,Сіз де
Dialogue: 0,0:20:47.07,0:20:47.66,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:47.74,0:20:49.41,Default,,0,0,0,,Тұтынушыларға қызмет көрсету және т.б.
Dialogue: 0,0:20:49.49,0:20:52.41,Default,,0,0,0,,А... дүкен? Ондай ештеңе жоқ
Dialogue: 0,0:20:53.12,0:20:56.17,Default,,0,0,0,,Мен өте танымалмын~
Dialogue: 0,0:20:58.00,0:20:59.67,Default,,0,0,0,,Сәлем! Айтпа!
Dialogue: 0,0:20:59.75,0:21:01.21,Default,,0,0,0,,Не деген сұмдық!
Dialogue: 0,0:21:04.34,0:21:05.47,Default,,0,0,0,,Хмм...
Dialogue: 0,0:21:06.76,0:21:07.68,Default,,0,0,0,,О, Мио
Dialogue: 0,0:21:07.76,0:21:09.68,Default,,0,0,0,,Иә? (Эри) Хехе
Dialogue: 0,0:21:10.26,0:21:11.68,Default,,0,0,0,,Жаңа қуырылған
Dialogue: 0,0:21:11.77,0:21:13.31,Default,,0,0,0,,Байқап көріңіз
Dialogue: 0,0:21:13.39,0:21:14.69,Default,,0,0,0,,Біреуін алыңыз! (қоңырау) А.
Dialogue: 0,0:21:14.77,0:21:18.73,Default,,0,0,0,,Сіз тым көп жеп қойғансыз. Сіз де үйде тамақтандыңыз, солай ма?
Dialogue: 0,0:21:18.81,0:21:21.86,Default,,0,0,0,,Сузу пончиктері дәмді~
Dialogue: 0,0:21:22.36,0:21:23.65,Default,,0,0,0,,О, Құдай-ай…
Dialogue: 0,0:21:24.95,0:21:26.45,Default,,0,0,0,,Екеуі жақсы дос
Dialogue: 0,0:21:26.53,0:21:27.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:27.24,0:21:30.37,Default,,0,0,0,,Сузу сүйкімді.
Dialogue: 0,0:21:30.45,0:21:32.66,Default,,0,0,0,,Оған ұқсамайды
Dialogue: 0,0:21:32.74,0:21:34.29,Default,,0,0,0,,Эй, Шун?
Dialogue: 0,0:21:34.37,0:21:35.33,Default,,0,0,0,,Ах
Dialogue: 0,0:21:36.25,0:21:37.83,Default,,0,0,0,,Не?
Dialogue: 0,0:21:37.92,0:21:40.34,Default,,0,0,0,,Аяқтадыңыз ба? (Шун) О
Dialogue: 0,0:21:40.42,0:21:42.71,Default,,0,0,0,,Мен біраз уақытқа бас аралға барамын.
Dialogue: 0,0:21:43.21,0:21:43.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:43.92,0:21:46.34,Default,,0,0,0,,Неліктен? Қазір бастайсыз ба?
Dialogue: 0,0:21:46.43,0:21:48.09,Default,,0,0,0,,Әуежай рейсінің ұшып шығуы
Dialogue: 0,0:21:48.18,0:21:50.39,Default,,0,0,0,,Ах... Жақсы жұмыс.
Dialogue: 0,0:21:50.89,0:21:52.85,Default,,0,0,0,,Ал, неге менімен келмейсің, Мио?
Dialogue: 0,0:21:52.93,0:21:56.85,Default,,0,0,0,,Не? А...бірақ дүкен де бар.
Dialogue: 0,0:21:56.94,0:22:00.61,Default,,0,0,0,,Уайымдамаңыз, біз мұны сіз үшін жасаймыз.
Dialogue: 0,0:22:00.69,0:22:01.48,Default,,0,0,0,,Эй?
Dialogue: 0,0:22:01.57,0:22:05.07,Default,,0,0,0,,Не? Иә, жарайды, алға.
Dialogue: 0,0:22:05.94,0:22:08.11,Default,,0,0,0,,А... иә
Dialogue: 0,0:22:12.12,0:22:13.37,Default,,0,0,0,,Иә (Шун) Ах.
Dialogue: 0,0:22:14.83,0:22:15.87,Default,,0,0,0,,Мейірім көрсетпе.
Dialogue: 0,0:22:17.75,0:22:18.87,Default,,0,0,0,,Сәлем
Dialogue: 0,0:22:21.00,0:22:21.88,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:22:21.96,0:22:22.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:22.71,0:22:23.88,Default,,0,0,0,,Қалпақ
Dialogue: 0,0:22:24.55,0:22:27.17,Default,,0,0,0,,Мен адамдармен көз алмасамын.
Dialogue: 0,0:22:27.26,0:22:28.59,Default,,0,0,0,,Басты аралда адам көп.
Dialogue: 0,0:22:28.68,0:22:31.01,Default,,0,0,0,,Иә? Бұл қайда?
Dialogue: 0,0:22:31.09,0:22:33.51,Default,,0,0,0,,Тұтынушымен дұрыс сөйлестіңіз бе?
Dialogue: 0,0:22:33.60,0:22:37.48,Default,,0,0,0,,Сондықтан мен оны жасауға барынша тырыстым.
Dialogue: 0,0:22:37.56,0:22:39.14,Default,,0,0,0,,Бір айдан кейін
Dialogue: 0,0:22:39.23,0:22:41.56,Default,,0,0,0,,Дұрыс орындаңыз
Dialogue: 0,0:22:42.27,0:22:44.69,Default,,0,0,0,,Иә, жақсы.
Dialogue: 0,0:22:44.78,0:22:47.61,Default,,0,0,0,,Мен оның осылай жасаса екен деп тілеймін.
Dialogue: 0,0:22:48.86,0:22:50.66,Default,,0,0,0,,Қандай ысырап!
Dialogue: 0,0:22:50.74,0:22:52.16,Default,,0,0,0,,Иә?
Dialogue: 0,0:22:53.24,0:22:54.41,Default,,0,0,0,,Не айтып тұрсың!
Dialogue: 0,0:23:01.67,0:23:04.96,Default,,0,0,0,,Мен әуежайға барамын, сен ше?
Dialogue: 0,0:23:08.47,0:23:09.88,Default,,0,0,0,,Мен үйге өзім барамын.
Dialogue: 0,0:23:32.41,0:23:36.95,Default,,0,0,0,,А, мм... о... саған еркектер ұнай ма?
Dialogue: 0,0:23:38.54,0:23:40.21,Default,,0,0,0,,Балаларды қызықтырмайды
Dialogue: 0,0:23:40.29,0:23:42.92,Default,,0,0,0,,Не? Цк, цк... аа...
Dialogue: 0,0:23:44.04,0:23:46.38,Default,,0,0,0,,Мен сыныпқа барып қарап келейін.
Dialogue: 0,0:23:49.92,0:23:52.72,Default,,0,0,0,,Мені ер адам мойындады
Dialogue: 0,0:23:52.80,0:23:55.47,Default,,0,0,0,,Мен бұл туралы ойланамын
Dialogue: 0,0:23:55.55,0:23:58.10,Default,,0,0,0,,Мен мұны мүлдем түсінбеймін
Dialogue: 0,0:23:58.18,0:24:01.39,Default,,0,0,0,,Сондықтан мен сізден көп нәрсе сұрағым келді...
Dialogue: 0,0:24:01.48,0:24:01.98,Default,,0,0,0,,Ах
Dialogue: 0,0:24:02.85,0:24:04.23,Default,,0,0,0,,Кез келген уақытта қош келдіңіз.
Dialogue: 0,0:24:05.40,0:24:06.31,Default,,0,0,0,,Ах...
Dialogue: 0,0:24:08.19,0:24:10.24,Default,,0,0,0,,Мен сізге тек шырын бере аламын.
Dialogue: 0,0:24:17.83,0:24:21.37,Default,,0,0,0,,Не дедің?
Dialogue: 0,0:24:25.75,0:24:28.25,Default,,0,0,0,,Қазір қайдасың? Мио
Dialogue: 0,0:24:29.96,0:24:31.26,Default,,0,0,0,,Шунхаса
Dialogue: 0,0:24:31.97,0:24:34.26,Default,,0,0,0,,Мен ақымақ сияқты толқып тұрмын
Dialogue: 0,0:24:34.84,0:24:37.76,Default,,0,0,0,,Сіз мені ештеңе туралы ойламаймын деп ойлайтын шығарсыз.
Dialogue: 0,0:24:38.47,0:24:42.52,Default,,0,0,0,,Бірақ мен Шунмен ажырасқаннан кейін де осыны ойлап жүрдім.
Dialogue: 0,0:24:44.06,0:24:46.77,Default,,0,0,0,,Мен Шунды жақсы көремін
Dialogue: 0,0:24:47.40,0:24:49.44,Default,,0,0,0,,Бірақ Шун...
Dialogue: 0,0:24:50.11,0:24:50.94,Default,,0,0,0,,Солай емес пе?
Dialogue: 0,0:24:52.44,0:24:53.70,Default,,0,0,0,,Мен қайтып келгенде
Dialogue: 0,0:24:54.57,0:24:55.82,Default,,0,0,0,,Мазасыздық тудырды ма?
Dialogue: 0,0:24:58.20,0:24:58.70,Default,,0,0,0,,Мио!
Dialogue: 0,0:24:59.41,0:25:00.37,Default,,0,0,0,,Қазір қайдасың?
Dialogue: 0,0:25:00.45,0:25:00.95,Default,,0,0,0,,Е...
Dialogue: 0,0:25:01.70,0:25:05.21,Default,,0,0,0,,Сакуразаканың… Тірі үй
Dialogue: 0,0:25:05.29,0:25:07.67,Default,,0,0,0,,Мен сонда барамын, сонда қал.
Dialogue: 0,0:25:08.54,0:25:10.71,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:25:16.55,0:25:18.51,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:25:18.60,0:25:21.56,Default,,0,0,0,,Эй, Хашимото кейде әйелдік болып көрінеді, солай ма?
Dialogue: 0,0:25:21.64,0:25:23.27,Default,,0,0,0,,Тұр, мен мұнда сұрақ қоятын адаммын.
Dialogue: 0,0:25:23.35,0:25:25.27,Default,,0,0,0,,Мүмкін ол гей шығар?
Dialogue: 0,0:25:25.35,0:25:26.56,Default,,0,0,0,,Бұл ақылсыз
Dialogue: 0,0:25:26.65,0:25:28.52,Default,,0,0,0,,Сіз ренжіп қалуыңыз мүмкін!
Dialogue: 0,0:25:28.61,0:25:31.69,Default,,0,0,0,,(Сыныптастардың күлкісі)
Dialogue: 0,0:25:31.78,0:25:32.53,Default,,0,0,0,,Уф...
Dialogue: 0,0:25:35.36,0:25:38.78,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:25:57.63,0:26:01.89,Default,,0,0,0,,Ха ха ха ха ха... Мио
Dialogue: 0,0:26:04.39,0:26:07.89,Default,,0,0,0,,Себебі мен Шун мені ұнатады деп ойладым.
Dialogue: 0,0:26:08.56,0:26:10.31,Default,,0,0,0,,Мен саған ғашық болдым
Dialogue: 0,0:26:11.31,0:26:13.32,Default,,0,0,0,,Сол үшін қайтып келдім
Dialogue: 0,0:26:14.48,0:26:17.03,Default,,0,0,0,,Ол мен қалағандай емес!
Dialogue: 0,0:26:20.28,0:26:21.91,Default,,0,0,0,,Кел (Мио) Иә?
Dialogue: 0,0:26:27.37,0:26:28.79,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:26:28.87,0:26:31.13,Default,,0,0,0,,Рахмет, онда...
Dialogue: 0,0:26:31.21,0:26:33.30,Default,,0,0,0,,Мынаны қараңыз.
Dialogue: 0,0:26:33.38,0:26:35.05,Default,,0,0,0,,Не? (Әйел тұтынушы) Не, алдыңғы үстелде не?
Dialogue: 0,0:26:35.13,0:26:37.30,Default,,0,0,0,,Шығу келесі күні сағат 10.00-де
Dialogue: 0,0:26:37.88,0:26:39.88,Default,,0,0,0,,Жоқ, көзіміз түйісті.
Dialogue: 0,0:26:39.97,0:26:40.80,Default,,0,0,0,,Тынш!
Dialogue: 0,0:26:40.89,0:26:42.89,Default,,0,0,0,,Бұл сіздің бөлме кілті.
Dialogue: 0,0:26:43.39,0:26:44.76,Default,,0,0,0,,Мына лифтке көтеріліңіз.
Dialogue: 0,0:26:44.85,0:26:45.60,Default,,0,0,0,,Иә
Dialogue: 0,0:26:46.39,0:26:48.69,Default,,0,0,0,,Не? А, сәл күте тұрыңыз ...
Dialogue: 0,0:26:49.73,0:26:51.06,Default,,0,0,0,,Эй Шун
Dialogue: 0,0:26:52.06,0:26:53.77,Default,,0,0,0,,Ах... эй!
Dialogue: 0,0:26:53.86,0:26:55.36,Default,,0,0,0,,Ши... Қой, сәл күте тұр!
Dialogue: 0,0:26:55.44,0:26:56.69,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:27:15.17,0:27:17.76,Default,,0,0,0,,Неге қайтып келдің?
Dialogue: 0,0:27:17.84,0:27:18.88,Default,,0,0,0,,Иә?
Dialogue: 0,0:27:19.47,0:27:20.88,Default,,0,0,0,,Мен емес
Dialogue: 0,0:27:20.97,0:27:23.64,Default,,0,0,0,,Қарапайым қызға ғашық болған жақсы
Dialogue: 0,0:27:23.72,0:27:25.85,Default,,0,0,0,,Мен бақытты болдым
Dialogue: 0,0:27:26.72,0:27:31.39,Default,,0,0,0,,Саған қарасам солай ойлаймын...
Dialogue: 0,0:27:42.78,0:27:44.16,Default,,0,0,0,,Эй, бұл сенсің
Dialogue: 0,0:27:45.08,0:27:47.04,Default,,0,0,0,,Сіз қызбен жатып көрдіңіз бе?
Dialogue: 0,0:27:47.12,0:27:48.41,Default,,0,0,0,,Ал, бар...
Dialogue: 0,0:27:49.00,0:27:50.29,Default,,0,0,0,,Менде де бар
Dialogue: 0,0:27:50.37,0:27:51.67,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:27:51.75,0:27:52.75,Default,,0,0,0,,Тек жағдайда
Dialogue: 0,0:27:53.75,0:27:57.13,Default,,0,0,0,,Бірақ мен ешқашан еркекпен болған емеспін.
Dialogue: 0,0:27:58.80,0:28:01.34,Default,,0,0,0,,Иә! Бар емес пе?
Dialogue: 0,0:28:01.42,0:28:02.30,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:28:03.01,0:28:05.26,Default,,0,0,0,,Мен ешқашан мойындамадым
Dialogue: 0,0:28:05.93,0:28:07.31,Default,,0,0,0,,Өйткені біз доспыз
Dialogue: 0,0:28:08.14,0:28:11.56,Default,,0,0,0,,Егер айта алмасаңыз және ол жұмыс істемесе, айтпағаныңыз жөн.
Dialogue: 0,0:28:13.02,0:28:16.31,Default,,0,0,0,,А, бірақ мен сені шақырдым.
Dialogue: 0,0:28:16.40,0:28:18.48,Default,,0,0,0,,Мен оны жалғыз қалдыра алмаймын.
Dialogue: 0,0:28:20.65,0:28:22.65,Default,,0,0,0,,Шун Жыныстық қатынасқа түсейік!
Dialogue: 0,0:28:22.74,0:28:23.32,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:23.41,0:28:26.07,Default,,0,0,0,,Ой... Мен 2-сынып оқушысымын.
Dialogue: 0,0:28:26.16,0:28:27.62,Default,,0,0,0,,Ал Кира
Dialogue: 0,0:28:27.70,0:28:30.83,Default,,0,0,0,,Жоқ, бұл кенеттен мүмкін емес...
Dialogue: 0,0:28:31.33,0:28:34.21,Default,,0,0,0,,... Тыныссаң, қолыңнан келеді.
Dialogue: 0,0:28:34.29,0:28:36.33,Default,,0,0,0,,Эй Шун, оян.
Dialogue: 0,0:28:43.72,0:28:45.76,Default,,0,0,0,,(ұйықтау)
Dialogue: 0,0:28:45.84,0:28:46.34,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:48.81,0:28:49.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:28:51.06,0:28:54.35,Default,,0,0,0,,Күріш шары үшін рахмет
Dialogue: 0,0:28:58.77,0:29:00.61,Default,,0,0,0,,Қазірдің өзінде!
Dialogue: 0,0:29:03.28,0:29:05.86,Default,,0,0,0,,Неге ұйықтап жатырсың...
Dialogue: 0,0:29:06.99,0:29:07.91,Default,,0,0,0,,Идиот!
Dialogue: 0,0:29:29.14,0:29:29.89,Default,,0,0,0,,Шун
Dialogue: 0,0:29:31.31,0:29:32.89,Default,,0,0,0,,Дайынсың ба?
Dialogue: 0,0:29:34.10,0:29:36.27,Default,,0,0,0,,Әдемі екен
Dialogue: 0,0:29:38.02,0:29:38.77,Default,,0,0,0,,Эй
Dialogue: 0,0:29:39.56,0:29:42.53,Default,,0,0,0,,Біз үйленеміз.
Dialogue: 0,0:29:43.11,0:29:47.32,Default,,0,0,0,,Мұның дұрыс екеніне сенімдісіз бе?
Dialogue: 0,0:29:49.12,0:29:50.16,Default,,0,0,0,,Ха…
Dialogue: 0,0:30:00.84,0:30:02.25,Default,,0,0,0,,Шұн…
Dialogue: 0,0:30:03.00,0:30:04.59,Default,,0,0,0,,Хи хи
Dialogue: 0,0:30:30.41,0:30:31.78,Default,,0,0,0,,Мен бүгін жыныстық қатынасқа түспеймін... (Шун)
Dialogue: 0,0:30:32.87,0:30:33.99,Default,,0,0,0,,Иә!
Dialogue: 0,0:30:34.49,0:30:36.37,Default,,0,0,0,,Шабуыл шаңы!
Dialogue: 0,0:30:36.96,0:30:40.46,Default,,0,0,0,,Сен мұны қаламайсың ба, Шун?
Dialogue: 0,0:30:40.54,0:30:41.46,Default,,0,0,0,,Мен қалаймын
Dialogue: 0,0:30:48.05,0:30:49.97,Default,,0,0,0,,Мен Шунды жақсы көремін
Dialogue: 0,0:30:50.55,0:30:52.22,Default,,0,0,0,,Мен де сені жақсы көремін
Dialogue: 0,0:30:55.77,0:30:57.48,Default,,0,0,0,,Толық емес жұмыс күнін алуға асығыңыз.
Dialogue: 0,0:30:58.06,0:30:59.19,Default,,0,0,0,,Тағы бір рет айтыңыз
Dialogue: 0,0:30:59.27,0:31:00.48,Default,,0,0,0,,Айтпа!
Dialogue: 0,0:31:00.56,0:31:03.48,Default,,0,0,0,,Жарайсың, Эй Шун!
Dialogue: 0,0:31:04.94,0:31:06.03,Default,,0,0,0,,Кетіңіз
Dialogue: 0,0:31:06.11,0:31:08.44,Default,,0,0,0,,Мен барамын, жарай ма?
Dialogue: 0,0:31:09.82,0:31:11.11,Default,,0,0,0,,Шун (2 адам) Иә?
Dialogue: 0,0:31:14.20,0:31:15.12,Default,,0,0,0,,Ах
Dialogue: 0,0:31:16.45,0:31:18.12,Default,,0,0,0,,Біраз уақыт өтті.
Dialogue: 0,0:31:22.29,0:31:24.29,Default,,0,0,0,,Білемін, бірақ шынымен сабырымды сақтай аламын ба?
Dialogue: 0,0:31:24.79,0:31:25.88,Default,,0,0,0,,Бала күнгі досы
Dialogue: 0,0:31:25.96,0:31:28.26,Default,,0,0,0,,«Келін», дұрыс па?
Dialogue: 0,0:31:29.34,0:31:30.76,Default,,0,0,0,,«Түпнұсқа», солай ма?
Dialogue: 0,0:31:30.84,0:31:32.89,Default,,0,0,0,,Сіз мұны қайдан білдіңіз?
Dialogue: 0,0:31:33.39,0:31:34.89,Default,,0,0,0,,Сен мұнда не үшін келдің?
Dialogue: 0,0:31:36.89,0:31:38.14,Default,,0,0,0,,Бұл шешілді, солай ма?
Dialogue: 0,0:31:40.10,0:31:41.90,Default,,0,0,0,,Мен сені қайтаруға келдім.
Dialogue: 0,0:31:46.65,0:31:47.15,Default,,0,0,0,,Ах
Dialogue: 0,0:31:55.74,0:31:57.24,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:31:57.33,0:31:59.41,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:32:02.54,0:32:05.17,Default,,0,0,0,,Мен Сакуракомын. Сәлем.
Dialogue: 0,0:32:05.25,0:32:07.30,Default,,0,0,0,,Эй... Мен Чикамын.
Dialogue: 0,0:32:07.84,0:32:08.80,Default,,0,0,0,,Сәлем
Dialogue: 0,0:32:08.88,0:32:11.05,Default,,0,0,0,,Сіз Шунның досысыз ба?
Dialogue: 0,0:32:11.13,0:32:13.01,Default,,0,0,0,,… …
Dialogue: 0,0:32:13.09,0:32:14.55,Default,,0,0,0,,Жоқ (Мио) Иә?
Dialogue: 0,0:32:15.22,0:32:17.01,Default,,0,0,0,,Біраздан бері айтып жүрсіз ғой, солай емес пе?
Dialogue: 0,0:32:18.06,0:32:19.18,Default,,0,0,0,,Тіпті ғашық
Dialogue: 0,0:32:19.27,0:32:22.14,Default,,0,0,0,,Ах, бұл қосымша кітап (Мио) А, иә...
Dialogue: 0,0:32:22.23,0:32:23.94,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:32:26.86,0:32:27.57,Default,,0,0,0,,Бұл зейінімді басқа жаққа бұрады, сондықтан кетші.
Dialogue: 0,0:32:27.65,0:32:29.07,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:32:29.65,0:32:32.49,Default,,0,0,0,,О, сенің жігітің жақсы болды ма?
Dialogue: 0,0:32:33.66,0:32:36.20,Default,,0,0,0,,Жоқ! Олай емес!
Dialogue: 0,0:32:36.87,0:32:38.08,Default,,0,0,0,,Күйеу деген не?
Dialogue: 0,0:32:38.16,0:32:42.33,Default,,0,0,0,,Мәміле баяғыда бұзылды, сол кезде мен де отбасыммен байланысымды үздім.
Dialogue: 0,0:32:42.41,0:32:43.58,Default,,0,0,0,,Ах
Dialogue: 0,0:32:44.96,0:32:47.42,Default,,0,0,0,,Сонымен... бұл не?
Dialogue: 0,0:32:49.30,0:32:50.34,Default,,0,0,0,,Хаа~
Dialogue: 0,0:32:51.26,0:32:52.09,Default,,0,0,0,,Не болды?
Dialogue: 0,0:32:52.17,0:32:55.93,Default,,0,0,0,,Үйден «Мені көруге қайтып кел».
Dialogue: 0,0:32:56.01,0:32:56.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:32:58.10,0:33:00.56,Default,,0,0,0,,Жасалғаннан гөрі айту оңай.
Dialogue: 0,0:33:01.27,0:33:02.85,Default,,0,0,0,,Мен шомыламын.
Dialogue: 0,0:33:04.48,0:33:05.35,Default,,0,0,0,,Иә
Dialogue: 0,0:33:11.36,0:33:12.82,Default,,0,0,0,,Бір сәтке бола аламын ба?
Dialogue: 0,0:33:13.61,0:33:14.74,Default,,0,0,0,,Уау!
Dialogue: 0,0:33:14.82,0:33:16.61,Default,,0,0,0,,Иә... Иә.
Dialogue: 0,0:33:16.70,0:33:17.49,Default,,0,0,0,,Шун ше?
Dialogue: 0,0:33:18.24,0:33:21.37,Default,,0,0,0,,Мен жұмыс істеп жатқан шығармын.
Dialogue: 0,0:33:21.45,0:33:22.66,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:33:23.25,0:33:25.54,Default,,0,0,0,,Сонда бұл сізсіз.
Dialogue: 0,0:33:25.62,0:33:26.21,Default,,0,0,0,,Иә?
Dialogue: 0,0:33:27.08,0:33:32.17,Default,,0,0,0,,Аралға гид туралы айтып жатсаңыз да, тек теңіз мен таулар бар.
Dialogue: 0,0:33:32.67,0:33:34.26,Default,,0,0,0,,Таулар жақсырақ
Dialogue: 0,0:33:34.88,0:33:36.63,Default,,0,0,0,,Сіз теңізді жек көресіз бе?
Dialogue: 0,0:33:37.47,0:33:39.76,Default,,0,0,0,,Менің туған жерім портты қала.
Dialogue: 0,0:33:44.27,0:33:44.77,Default,,0,0,0,,Эй
Dialogue: 0,0:33:45.35,0:33:46.27,Default,,0,0,0,,Иә!
Dialogue: 0,0:33:46.89,0:33:49.44,Default,,0,0,0,,Балалар, ұйықтадыңдар ма?
Dialogue: 0,0:33:49.52,0:33:51.36,Default,,0,0,0,,Керісінше, қанша адам қарғысқа ұшырап өлетінін болжау мүмкін емес.
Dialogue: 0,0:33:52.44,0:33:55.65,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,0:33:55.74,0:33:56.99,Default,,0,0,0,,Әлі емес пе?
Dialogue: 0,0:34:00.28,0:34:01.78,Default,,0,0,0,,Шун жақсы
Dialogue: 0,0:34:02.49,0:34:04.16,Default,,0,0,0,,Әдепті және мейірімді
Dialogue: 0,0:34:05.37,0:34:07.42,Default,,0,0,0,,Мен мұны тезірек орындасам екен.
Dialogue: 0,0:34:08.25,0:34:09.17,Default,,0,0,0,,Сол адам...
Dialogue: 0,0:34:10.00,0:34:12.34,Default,,0,0,0,,Себебі көп уақыт бойы қолымнан келмеді
Dialogue: 0,0:34:16.38,0:34:17.68,Default,,0,0,0,,Сакурако-сан
Dialogue: 0,0:34:17.76,0:34:22.01,Default,,0,0,0,,Мм, сіз қайтадан жиналу үшін келген жоқсыз ба?
Dialogue: 0,0:34:22.51,0:34:25.68,Default,,0,0,0,,Жоқ, бұл дұрыс емес.
Dialogue: 0,0:34:25.77,0:34:27.44,Default,,0,0,0,,Сіз ештеңе естіген жоқсыз.
Dialogue: 0,0:34:34.07,0:34:37.03,Default,,0,0,0,,Әкемнің жағдайы нашар.
Dialogue: 0,0:34:37.11,0:34:38.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:38.15,0:34:40.70,Default,,0,0,0,,Мен сізге хат жібердім. Сіз оны алған жоқсыз ба?
Dialogue: 0,0:34:40.78,0:34:42.16,Default,,0,0,0,,Ол келді, бірақ...
Dialogue: 0,0:34:42.24,0:34:45.54,Default,,0,0,0,,Иә? Соншама? Сізге қоңырау шалу жеткілікті жаман ба?
Dialogue: 0,0:34:45.62,0:34:48.16,Default,,0,0,0,,Бұл бірден қауіпті емес.
Dialogue: 0,0:34:48.79,0:34:49.71,Default,,0,0,0,,Жоқ, бірақ...
Dialogue: 0,0:34:50.37,0:34:53.59,Default,,0,0,0,,Осы қарқынмен мен енді үйге бара алмаймын.
Dialogue: 0,0:34:55.42,0:34:59.09,Default,,0,0,0,,Неліктен Шунға тұрмысқа шығуды шештіңіз?
Dialogue: 0,0:34:59.18,0:35:01.34,Default,,0,0,0,,Өйткені Шун мұның жақсы екенін айтты.
Dialogue: 0,0:35:01.97,0:35:05.35,Default,,0,0,0,,Әйелге ғашық бола алмайтыныңызды білесіз бе?
Dialogue: 0,0:35:05.43,0:35:06.93,Default,,0,0,0,,Сіз мұны білдіңіз бе?
Dialogue: 0,0:35:17.19,0:35:18.99,Default,,0,0,0,,Балалар сендер әлсіреп жатырсыңдар.
Dialogue: 0,0:35:19.07,0:35:20.49,Default,,0,0,0,,Мен әлсіреп жатырмын!
Dialogue: 0,0:35:20.57,0:35:22.78,Default,,0,0,0,,<Ал сол адам маған айтты>
Dialogue: 0,0:35:22.87,0:35:24.87,Default,,0,0,0,,Менің 5 минуттық үзілістен басқа амалым жоқ.
Dialogue: 0,0:35:25.62,0:35:26.74,Default,,0,0,0,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,0:35:26.83,0:35:29.16,Default,,0,0,0,,Әй, ол одан да шаршаған жоқ па?
Dialogue: 0,0:35:29.25,0:35:30.12,Default,,0,0,0,,Әрине
Dialogue: 0,0:35:39.92,0:35:42.26,Default,,0,0,0,,Оны маған әдеттегідей беріңіз.
Dialogue: 0,0:35:44.64,0:35:45.89,Default,,0,0,0,,Сіз мойындамайсыз ба?
Dialogue: 0,0:35:45.97,0:35:48.10,Default,,0,0,0,,Мүмкін емес.
Dialogue: 0,0:35:48.18,0:35:51.23,Default,,0,0,0,,Мүмкін бұл жолы жұмыс істейтін шығар
Dialogue: 0,0:35:51.73,0:35:53.40,Default,,0,0,0,,Мүлдем жоқ.
Dialogue: 0,0:35:54.19,0:35:56.65,Default,,0,0,0,,Абсолюттер жоқ, солай ма?
Dialogue: 0,0:35:57.36,0:36:00.03,Default,,0,0,0,,Айтпасаң мен ештеңе істей алмаймын.
Dialogue: 0,0:36:03.11,0:36:04.78,Default,,0,0,0,,Сізде батылдық жоқ.
Dialogue: 0,0:36:07.20,0:36:08.29,Default,,0,0,0,,Сіз үшін...
Dialogue: 0,0:36:08.37,0:36:09.04,Default,,0,0,0,,Ах
Dialogue: 0,0:36:09.62,0:36:10.79,Default,,0,0,0,,Мен білмеймін
Dialogue: 0,0:36:17.38,0:36:20.80,Default,,0,0,0,,Сіз романдармен кез келген жерде жұмыс істей аласыз, солай ма?
Dialogue: 0,0:36:20.88,0:36:22.68,Default,,0,0,0,,Қалай болғанда да, бір рет қайтыңыз.
Dialogue: 0,0:36:22.76,0:36:23.93,Default,,0,0,0,,Үйге бармау
Dialogue: 0,0:36:26.43,0:36:29.02,Default,,0,0,0,,Мен қарбызды кесіп тастадым...
Dialogue: 0,0:36:29.85,0:36:32.27,Default,,0,0,0,,Менің енді қайтуға ниетім жоқ.
Dialogue: 0,0:36:32.77,0:36:36.94,Default,,0,0,0,,Мұның бәрі не туралы? Осы жерге асығып
Dialogue: 0,0:36:37.02,0:36:39.69,Default,,0,0,0,,Бейтаныс адамның үйін жалғыз қалдырыңыз.
Dialogue: 0,0:36:39.78,0:36:42.70,Default,,0,0,0,,Бұл енді сізге маңызды емес.
Dialogue: 0,0:36:43.53,0:36:44.95,Default,,0,0,0,,Қат! Қазіргі...
Dialogue: 0,0:36:45.03,0:36:46.32,Default,,0,0,0,,Ах!
Dialogue: 0,0:36:49.79,0:36:50.95,Default,,0,0,0,,дірілдеп тұр
Dialogue: 0,0:36:53.08,0:36:55.00,Default,,0,0,0,,Мен сені ақымақ деп ойламадым.
Dialogue: 0,0:36:59.50,0:37:01.71,Default,,0,0,0,,Күте тұрыңыз! Сакурако-сан!
Dialogue: 0,0:37:03.05,0:37:05.38,Default,,0,0,0,,Қат! Мен тезірек жетуім керек
Dialogue: 0,0:37:05.47,0:37:06.80,Default,,0,0,0,,Сіз осында болсаңыз да
Dialogue: 0,0:37:07.97,0:37:09.22,Default,,0,0,0,,Үйге не үшін бара жатырсың?
Dialogue: 0,0:37:09.97,0:37:10.47,Default,,0,0,0,,Мен?
Dialogue: 0,0:37:10.56,0:37:11.72,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:37:13.23,0:37:14.52,Default,,0,0,0,,Солай ма...
Dialogue: 0,0:37:15.39,0:37:18.06,Default,,0,0,0,,Мені сылтау етіп қашып бара жатырсың!
Dialogue: 0,0:37:18.56,0:37:19.65,Default,,0,0,0,,Осындай бірдеңе...
Dialogue: 0,0:37:19.73,0:37:20.73,Default,,0,0,0,,Қат! (Шун) А.
Dialogue: 0,0:37:20.82,0:37:24.24,Default,,0,0,0,,Мен өлсем, сені енді көре алмаймын.
Dialogue: 0,0:37:25.07,0:37:25.99,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:37:26.74,0:37:29.24,Default,,0,0,0,,Жарайды, мені үйге жібер.
Dialogue: 0,0:37:37.21,0:37:41.05,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:37:42.46,0:37:43.46,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:46.22,0:37:49.22,Default,,0,0,0,,(толқынды дыбыс)
Dialogue: 0,0:38:02.90,0:38:03.99,Default,,0,0,0,,Мен де...
Dialogue: 0,0:38:10.99,0:38:12.41,Default,,0,0,0,,(айқай)
Dialogue: 0,0:38:14.33,0:38:15.41,Default,,0,0,0,,Не?
Dialogue: 0,0:38:18.42,0:38:18.92,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:38:21.42,0:38:23.67,Default,,0,0,0,,Қалыңдығыңды тастап қаш
Dialogue: 0,0:38:23.75,0:38:26.42,Default,,0,0,0,,Маған ер адамдар ұнайды
Dialogue: 0,0:38:26.51,0:38:27.93,Default,,0,0,0,,Осындай уақытта... (Шунның анасы) Сен!
Dialogue: 0,0:38:28.01,0:38:30.18,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:38:30.26,0:38:32.18,Default,,0,0,0,,Жоқ, солай ма? Шун
Dialogue: 0,0:38:32.26,0:38:34.06,Default,,0,0,0,,Айтыңызшы!
Dialogue: 0,0:38:35.27,0:38:36.43,Default,,0,0,0,,дірілдеп тұр
Dialogue: 0,0:38:37.18,0:38:38.94,Default,,0,0,0,,Мен сені ақымақ деп ойламадым.
Dialogue: 0,0:38:39.52,0:38:41.31,Default,,0,0,0,,Маған үйге баруға рұқсат етіңіз
Dialogue: 0,0:38:41.40,0:38:42.52,Default,,0,0,0,,Менде бәрі жақсы
Dialogue: 0,0:38:43.11,0:38:44.03,Default,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:38:45.78,0:38:46.61,Default,,0,0,0,,Сонда бәрі бір сәтте бітеді.
Dialogue: 0,0:38:48.99,0:38:52.41,Default,,0,0,0,,Хахахахахаха…
Dialogue: 0,0:39:02.50,0:39:04.67,Default,,0,0,0,,Жүріңдер, мен екеуіңді суретке түсіремін.
Dialogue: 0,0:39:05.76,0:39:08.17,Default,,0,0,0,,Қараңдаршы, екеуміз де күліп жатырмыз.
Dialogue: 0,0:39:11.14,0:39:12.68,Default,,0,0,0,,Бұл қорқынышты бет.
Dialogue: 0,0:39:12.76,0:39:16.35,Default,,0,0,0,,Хехе, жарайды, сүйкімді емес пе?
Dialogue: 0,0:39:16.43,0:39:17.43,Default,,0,0,0,,Апай (Шунның анасы) А?
Dialogue: 0,0:39:18.02,0:39:19.69,Default,,0,0,0,,Мен таң қалдырды
Dialogue: 0,0:39:19.77,0:39:21.90,Default,,0,0,0,,О, бұл жақсы.
Dialogue: 0,0:39:21.98,0:39:24.32,Default,,0,0,0,,Шунның да бізбен бірге болғанына қуаныштымын.
Dialogue: 0,0:39:24.40,0:39:25.98,Default,,0,0,0,,Нағашы апа
Dialogue: 0,0:39:26.07,0:39:26.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:39:26.65,0:39:29.70,Default,,0,0,0,,Мен Шунның әйелі боламын.
Dialogue: 0,0:39:29.78,0:39:31.99,Default,,0,0,0,,Хаха мен көрдім.
Dialogue: 0,0:39:32.07,0:39:33.28,Default,,0,0,0,,Сізге жақсы Шун
Dialogue: 0,0:39:33.37,0:39:35.87,Default,,0,0,0,,Бұл рас, мен уәде бердім.
Dialogue: 0,0:39:35.95,0:39:37.08,Default,,0,0,0,,Сәлем? Шун
Dialogue: 0,0:39:38.79,0:39:39.33,Default,,0,0,0,,Иә
Dialogue: 0,0:39:39.91,0:39:41.87,Default,,0,0,0,,Сакурако жақсы.
Dialogue: 0,0:39:48.05,0:39:49.09,Default,,0,0,0,,Сакурако-сан!
Dialogue: 0,0:39:49.80,0:39:52.84,Default,,0,0,0,,Жоқ! Егер мен осындай жерде жалғыз болсам
Dialogue: 0,0:39:52.93,0:39:54.35,Default,,0,0,0,,Түн болса да!
Dialogue: 0,0:39:54.43,0:39:55.85,Default,,0,0,0,,Осы жігіттің жақтаушылары қайда және қаншасы жасырынып жатқанын кім білсін?
Dialogue: 0,0:39:55.93,0:39:58.60,Default,,0,0,0,,Үйге қайтайық, мен саған жіберемін.
Dialogue: 0,0:39:59.64,0:40:01.35,Default,,0,0,0,,Мен бұны тоқтатар едім.
Dialogue: 0,0:40:01.44,0:40:02.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:40:02.40,0:40:06.11,Default,,0,0,0,,Осылайша Шун осында мәңгі қала алады.
Dialogue: 0,0:40:06.19,0:40:07.53,Default,,0,0,0,,Үй ойынынан біраз жалығып кеттім ғой, иә?
Dialogue: 0,0:40:07.61,0:40:10.36,Default,,0,0,0,,Мен өзімшілдік туралы көбірек айтсам ғой!
Dialogue: 0,0:40:11.57,0:40:14.32,Default,,0,0,0,,Сакурако да солай емес пе?
Dialogue: 0,0:40:14.41,0:40:15.87,Default,,0,0,0,,Мен айттым!
Dialogue: 0,0:40:16.70,0:40:21.46,Default,,0,0,0,,Мен сені сүймесем де, менімен бірге болғаныңды қалаймын...
Dialogue: 0,0:40:23.29,0:40:24.50,Default,,0,0,0,,айттым ғой
Dialogue: 0,0:40:29.17,0:40:33.13,Default,,0,0,0,,Бір күні Шун өзгеге ғашық болады.
Dialogue: 0,0:40:34.51,0:40:36.97,Default,,0,0,0,,Мен енді сенің жаныңда болмасам да
Dialogue: 0,0:40:38.22,0:40:39.77,Default,,0,0,0,,Бұл маған жақсы
Dialogue: 0,0:40:40.77,0:40:41.89,Default,,0,0,0,,Шун шешеді.
Dialogue: 0,0:40:42.48,0:40:43.98,Default,,0,0,0,,Бұл солай сияқты
Dialogue: 0,0:40:44.48,0:40:47.06,Default,,0,0,0,,Өйткені сен керексің!
Dialogue: 0,0:40:47.15,0:40:49.07,Default,,0,0,0,,Сиқыр формуласын ашу
Dialogue: 0,0:40:51.03,0:40:54.61,Default,,0,0,0,,Неліктен кешірім сұрайсыз? Сіз не білесіз?
Dialogue: 0,0:40:54.70,0:40:55.87,Default,,0,0,0,,Мен түсінемін.
Dialogue: 0,0:40:55.95,0:40:57.74,Default,,0,0,0,,Бұл да менмін.
Dialogue: 0,0:40:58.37,0:41:01.00,Default,,0,0,0,,Шун да сондай маңызды!
Dialogue: 0,0:41:01.08,0:41:03.00,Default,,0,0,0,,Ол «Рух толқынын» қолдануда — қалағанынша жоғалып, қайта пайда бола алады.
Dialogue: 0,0:41:05.33,0:41:06.25,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:41:15.43,0:41:16.22,Default,,0,0,0,,Батырлар дереу қажет!
Dialogue: 0,0:41:18.22,0:41:22.64,Default,,0,0,0,,Мен ең нашар қарсылас болсам ғой...
Dialogue: 0,0:41:28.11,0:41:30.52,Default,,0,0,0,,Кішкентай кезімде анам айтатын
Dialogue: 0,0:41:30.61,0:41:33.36,Default,,0,0,0,,Маған жалғыз болсам, мені ұрлап әкететінін айтты.
Dialogue: 0,0:41:34.15,0:41:35.15,Default,,0,0,0,,Теңізде?
Dialogue: 0,0:41:35.24,0:41:36.86,Default,,0,0,0,,Иә, сол жақта.
Dialogue: 0,0:41:37.87,0:41:39.62,Default,,0,0,0,,Бірақ менің анам да қайтыс болды.
Dialogue: 0,0:41:40.33,0:41:43.04,Default,,0,0,0,,Отбасыңнан айырылу өкінішті.
Dialogue: 0,0:41:44.25,0:41:46.67,Default,,0,0,0,,Сол себепті Шун олай сезінбейді деп үміттенемін.
Dialogue: 0,0:41:48.29,0:41:50.21,Default,,0,0,0,,Үйге дұрыстап барғаныңды қалаймын.
Dialogue: 0,0:41:52.05,0:41:55.05,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:41:57.51,0:42:00.18,Default,,0,0,0,,Хэхехе!
Dialogue: 0,0:42:01.01,0:42:02.26,Default,,0,0,0,,Иә
Dialogue: 0,0:42:02.77,0:42:04.68,Default,,0,0,0,,Анашым!
Dialogue: 0,0:42:05.31,0:42:06.94,Default,,0,0,0,,Иә
Dialogue: 0,0:42:07.02,0:42:09.10,Default,,0,0,0,,Мені құшақтап ал!
Dialogue: 0,0:42:09.19,0:42:10.44,Default,,0,0,0,,Иә
Dialogue: 0,0:42:11.27,0:42:12.32,Default,,0,0,0,,Йотто!
Dialogue: 0,0:42:12.40,0:42:14.94,Default,,0,0,0,,Гю~! (Мионың анасы) Гю~!
Dialogue: 0,0:42:18.49,0:42:21.58,Default,,0,0,0,,Анашым, сіз жақсы иіссіз.
Dialogue: 0,0:42:22.58,0:42:24.04,Default,,0,0,0,,Маған ұнайды!
Dialogue: 0,0:42:27.04,0:42:28.00,Default,,0,0,0,,Мио!
Dialogue: 0,0:42:31.79,0:42:34.21,Default,,0,0,0,,Неге телефонға жауап бермейсіз?
Dialogue: 0,0:42:34.30,0:42:36.42,Default,,0,0,0,,Сіз уайымдап тұрсыз.
Dialogue: 0,0:42:36.51,0:42:39.47,Default,,0,0,0,,Не? Менде жоқ, мен оны бөлмеме қалдырамын.
Dialogue: 0,0:42:39.55,0:42:42.47,Default,,0,0,0,,Ұялы телефонның пайдасы жоқ, ақымақ!
Dialogue: 0,0:42:42.56,0:42:44.72,Default,,0,0,0,,Сонда... сонда?
Dialogue: 0,0:42:44.81,0:42:46.89,Default,,0,0,0,,Ал... Сакурако ше?
Dialogue: 0,0:42:46.98,0:42:48.39,Default,,0,0,0,,Мен сені қонақ үйге апардым.
Dialogue: 0,0:42:48.48,0:42:49.90,Default,,0,0,0,,Тұрғын үй қайда?
Dialogue: 0,0:42:49.98,0:42:51.98,Default,,0,0,0,,Мен саған бүгін келме дедім.
Dialogue: 0,0:42:57.19,0:43:00.57,Default,,0,0,0,,Хаа~ Кешіріңіз.
Dialogue: 0,0:43:00.66,0:43:01.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:43:01.45,0:43:03.95,Default,,0,0,0,,Сіз шынымен шаршадыңыз ба?
Dialogue: 0,0:43:04.03,0:43:05.79,Default,,0,0,0,,Иә? бөлек
Dialogue: 0,0:43:08.08,0:43:11.75,Default,,0,0,0,,Дұрыс, бұлай айтудың ең жаман жолы.
Dialogue: 0,0:43:12.25,0:43:14.92,Default,,0,0,0,,Қыздарға мейірімді болу керек.
Dialogue: 0,0:43:15.42,0:43:17.76,Default,,0,0,0,,Сіз ересек адам болсаңыз, неге дұрыс істемейсіз?
Dialogue: 0,0:43:20.13,0:43:22.93,Default,,0,0,0,,Хахаха, бұл не?
Dialogue: 0,0:43:24.39,0:43:25.35,Default,,0,0,0,,Сіз қорқасыз ба?
Dialogue: 0,0:43:26.02,0:43:27.85,Default,,0,0,0,,Кешіріңіз...
Dialogue: 0,0:43:27.93,0:43:29.39,Default,,0,0,0,,Хехе
Dialogue: 0,0:43:31.77,0:43:33.15,Default,,0,0,0,,Жетеді.
Dialogue: 0,0:43:33.23,0:43:35.02,Default,,0,0,0,,Эй... (Сакурако) Менің махаббатым таусылды.
Dialogue: 0,0:43:35.11,0:43:36.15,Default,,0,0,0,,Сакурако?
Dialogue: 0,0:43:36.23,0:43:37.99,Default,,0,0,0,,Қоштасу және жақсы тілектер
Dialogue: 0,0:43:38.07,0:43:41.03,Default,,0,0,0,,Мен бөгде адаммын, сондықтан кешіріңіз.
Dialogue: 0,0:43:41.11,0:43:42.78,Default,,0,0,0,,Жақсы... жақсы.
Dialogue: 0,0:43:42.87,0:43:44.78,Default,,0,0,0,,Бұл туралы... солай емес пе?
Dialogue: 0,0:43:44.87,0:43:46.08,Default,,0,0,0,,Сакурако-сан
Dialogue: 0,0:43:49.87,0:43:51.42,Default,,0,0,0,,Бір рет артқа оралыңыз
Dialogue: 0,0:43:51.50,0:43:52.88,Default,,0,0,0,,Сенің әкең...
Dialogue: 0,0:43:52.96,0:43:55.25,Default,,0,0,0,,Білемін, хатты оқыдым.
Dialogue: 0,0:43:55.34,0:43:56.30,Default,,0,0,0,,Иә
Dialogue: 0,0:43:58.38,0:43:59.05,Default,,0,0,0,,Эй Шун
Dialogue: 0,0:43:59.80,0:44:01.22,Default,,0,0,0,,Мені сүй
Dialogue: 0,0:44:01.30,0:44:01.80,Default,,0,0,0,,Не!
Dialogue: 0,0:44:01.88,0:44:03.80,Default,,0,0,0,,Ұшу уақыты аз қалды...
Dialogue: 0,0:44:03.89,0:44:07.06,Default,,0,0,0,,Иә? Не айтайын... (Сакурако) Онда мен қазірдің өзінде бас тартамын.
Dialogue: 0,0:44:07.14,0:44:08.68,Default,,0,0,0,,Жақсы емес пе?
Dialogue: 0,0:44:08.77,0:44:11.06,Default,,0,0,0,,Сіз мұны мен үшін ешқашан жасаған емессіз!
Dialogue: 0,0:44:11.14,0:44:11.81,Default,,0,0,0,,Иә?
Dialogue: 0,0:44:11.89,0:44:13.81,Default,,0,0,0,,Шун жақсы
Dialogue: 0,0:44:13.90,0:44:16.15,Default,,0,0,0,,Әдепті және мейірімді
Dialogue: 0,0:44:16.65,0:44:18.11,Default,,0,0,0,,Хаа~ (Мио) Иә?
Dialogue: 0,0:44:20.15,0:44:21.20,Default,,0,0,0,,Иә? (Шун) Сакурако
Dialogue: 0,0:44:21.90,0:44:23.07,Default,,0,0,0,,Сіз сонша жау жинап алатыныңыз шын мәнінде ауыртпалық.
Dialogue: 0,0:44:38.67,0:44:40.59,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:44:40.67,0:44:42.84,Default,,0,0,0,,меніңше, бұл – нағыз ақымақтық шыңы… Яғни—
Dialogue: 0,0:44:42.93,0:44:46.30,Default,,0,0,0,,Бұл сен емессің!
Dialogue: 0,0:44:46.39,0:44:47.35,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:44:47.43,0:44:50.60,Default,,0,0,0,,Шун жақсы болса да, қолымнан келмейді.
Dialogue: 0,0:44:50.68,0:44:51.48,Default,,0,0,0,,Ха!
Dialogue: 0,0:44:51.56,0:44:53.35,Default,,0,0,0,,Қайта кездескенше, Сакурако-сан
Dialogue: 0,0:44:56.69,0:44:58.57,Default,,0,0,0,,Мен енді ешқашан келмеймін
Dialogue: 0,0:45:00.57,0:45:02.03,Default,,0,0,0,,Осындай жер...
Dialogue: 0,0:45:05.99,0:45:08.74,Default,,0,0,0,,Аа, бұл дауыл.
Dialogue: 0,0:45:09.45,0:45:12.50,Default,,0,0,0,,Тек... үйге барып ұйықта.
Dialogue: 0,0:45:12.58,0:45:14.37,Default,,0,0,0,,Эй (Шун)?
Dialogue: 0,0:45:15.04,0:45:17.54,Default,,0,0,0,,Барма! Не...
Dialogue: 0,0:45:17.63,0:45:20.92,Default,,0,0,0,,Неге мұны істеу мүмкін емес деп айтпайсыз!
Dialogue: 0,0:45:21.51,0:45:23.17,Default,,0,0,0,,Егер мен араласпаған болсам
Dialogue: 0,0:45:23.26,0:45:26.26,Default,,0,0,0,,Сіз дәл солай істейтін едіңіз!
Dialogue: 0,0:45:28.14,0:45:30.56,Default,,0,0,0,,Не? иә?
Dialogue: 0,0:45:31.27,0:45:33.85,Default,,0,0,0,,Мен енді білмеймін, ақымақ!
Dialogue: 0,0:45:39.23,0:45:40.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:45:44.40,0:45:45.57,Default,,0,0,0,,Сәлем Мио
Dialogue: 0,0:45:45.65,0:45:46.91,Default,,0,0,0,,Шулы!
Dialogue: 0,0:45:46.99,0:45:49.07,Default,,0,0,0,,Тамақ туралы не айтасыз? (Мио) Маған керек емес!
Dialogue: 0,0:45:50.83,0:45:51.58,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:45:54.50,0:45:55.33,Default,,0,0,0,,Апай
Dialogue: 0,0:45:55.41,0:45:57.37,Default,,0,0,0,,Мио Мен оны кейін жеймін.
Dialogue: 0,0:45:57.46,0:45:59.79,Default,,0,0,0,,Әй, ұрысып қалдың ба?
Dialogue: 0,0:45:59.88,0:46:01.38,Default,,0,0,0,,Хмм...
Dialogue: 0,0:46:01.46,0:46:03.09,Default,,0,0,0,,Хехехе
Dialogue: 0,0:46:03.17,0:46:05.97,Default,,0,0,0,,Олай болса кейін бірге тамақтанайық.
Dialogue: 0,0:46:06.47,0:46:07.09,Default,,0,0,0,,Иә
Dialogue: 0,0:46:09.18,0:46:10.14,Default,,0,0,0,,Мио
Dialogue: 0,0:46:14.06,0:46:14.93,Default,,0,0,0,,(күрсіну)
Dialogue: 0,0:46:16.69,0:46:17.73,Default,,0,0,0,,Мен кіремін
Dialogue: 0,0:46:19.56,0:46:20.98,Default,,0,0,0,,Мио
Dialogue: 0,0:46:21.06,0:46:23.73,Default,,0,0,0,,Эй, сен әлі ашулысың ба?
Dialogue: 0,0:46:25.69,0:46:26.49,Default,,0,0,0,,Хаа…
Dialogue: 0,0:46:26.57,0:46:28.49,Default,,0,0,0,,Сіз неге...
Dialogue: 0,0:46:30.57,0:46:32.95,Default,,0,0,0,,Мен оңай жылаймын
Dialogue: 0,0:46:33.62,0:46:35.58,Default,,0,0,0,,Жоқ, тоқтатыңыз...
Dialogue: 0,0:46:37.16,0:46:38.54,Default,,0,0,0,,Мүмкін емес
Dialogue: 0,0:46:43.59,0:46:44.76,Default,,0,0,0,,Хмм...
Dialogue: 0,0:46:46.80,0:46:48.68,Default,,0,0,0,,Сіз осында болсаңыз да
Dialogue: 0,0:46:48.76,0:46:52.05,Default,,0,0,0,,Мұндай сұрауды тыңдау мүмкін емес.
Dialogue: 0,0:46:55.31,0:46:57.02,Default,,0,0,0,,Күте тұрыңыз! (Шун) Не?
Dialogue: 0,0:46:57.10,0:46:59.35,Default,,0,0,0,,Киіміңді шеш Мен шешкім келеді!
Dialogue: 0,0:47:00.90,0:47:05.90,Default,,0,0,0,,Білесіз бе... шынымен де солай істегіңіз келе ме?
Dialogue: 0,0:47:06.40,0:47:08.32,Default,,0,0,0,,Иә, неге?
Dialogue: 0,0:47:08.95,0:47:11.95,Default,,0,0,0,,Бұл жиіркенішті емес пе?
Dialogue: 0,0:47:12.03,0:47:14.91,Default,,0,0,0,,Жоқ, сіз қазір не туралы айтып отырсыз?
Dialogue: 0,0:47:14.99,0:47:16.83,Default,,0,0,0,,Оларды да шешіңіз!
Dialogue: 0,0:47:32.85,0:47:34.26,Default,,0,0,0,,Ах...
Dialogue: 0,0:47:34.89,0:47:36.31,Default,,0,0,0,,Хмм...
Dialogue: 0,0:47:36.85,0:47:37.89,Default,,0,0,0,,Ах
Dialogue: 0,0:47:40.60,0:47:43.94,Default,,0,0,0,,Мио, кіре аласың ба?
Dialogue: 0,0:47:44.02,0:47:44.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:47:45.11,0:47:47.82,Default,,0,0,0,,Бұл мүмкін емес. Мен мүлдем шыдай алмаймын.
Dialogue: 0,0:47:47.90,0:47:52.28,Default,,0,0,0,,Қазір шықты, сондықтан екі данасын тіркесеңіз, бәрі жақсы болады.
Dialogue: 0,0:47:52.36,0:47:55.45,Default,,0,0,0,,Е-е... Мүмкін болмаса да, осылай істеуге болады.
Dialogue: 0,0:47:55.53,0:47:57.79,Default,,0,0,0,,Осыны қосуыңызды қалаймын.
Dialogue: 0,0:47:58.37,0:48:01.83,Default,,0,0,0,,Сонымен мен ваннаға түсіп, басқа да көп нәрсені жасадым...
Dialogue: 0,0:48:02.33,0:48:03.46,Default,,0,0,0,,Әртүрлі заттар?
Dialogue: 0,0:48:03.54,0:48:05.29,Default,,0,0,0,,Ой... жарайды!
Dialogue: 0,0:48:09.01,0:48:10.05,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:48:12.51,0:48:14.30,Default,,0,0,0,,Саусағымды салайын ба?
Dialogue: 0,0:48:15.55,0:48:16.31,Default,,0,0,0,,Уф...
Dialogue: 0,0:48:16.39,0:48:18.56,Default,,0,0,0,,Уф...
Dialogue: 0,0:48:23.52,0:48:26.27,Default,,0,0,0,,Ах! Өзіңіз үйреніп қалдыңыз ба?
Dialogue: 0,0:48:26.90,0:48:30.53,Default,,0,0,0,,Маған бұл туралы айт, келесі жолы істеймін.
Dialogue: 0,0:48:32.07,0:48:33.82,Default,,0,0,0,,Бұл жеткілікті...
Dialogue: 0,0:48:34.49,0:48:35.74,Default,,0,0,0,,Оны салыңыз
Dialogue: 0,0:48:41.25,0:48:42.29,Default,,0,0,0,,Мен оны саламын.
Dialogue: 0,0:48:45.33,0:48:46.08,Default,,0,0,0,,Уф...
Dialogue: 0,0:48:46.75,0:48:48.21,Default,,0,0,0,,Уф...
Dialogue: 0,0:48:51.72,0:48:53.97,Default,,0,0,0,,Қалай... бұл қандай сезімде?
Dialogue: 0,0:48:54.97,0:48:56.68,Default,,0,0,0,,Бұл ауырады...
Dialogue: 0,0:48:59.64,0:49:00.60,Default,,0,0,0,,Бұл — бір сәт бұрынғы Итадори ешқашан жасамайтын қимыл
Dialogue: 0,0:49:02.39,0:49:03.85,Default,,0,0,0,,Ғашық болған адаммен...
Dialogue: 0,0:49:03.94,0:49:05.98,Default,,0,0,0,,Дұрыс па, солай емес пе?
Dialogue: 0,0:49:06.61,0:49:07.73,Default,,0,0,0,,Біз не істеуіміз керек?
Dialogue: 0,0:49:08.57,0:49:09.94,Default,,0,0,0,,Оны маған бір сәтке бересіз бе?
Dialogue: 0,0:49:10.94,0:49:12.11,Default,,0,0,0,,Бір-бірімізді құшақтай алсақ...
Dialogue: 0,0:49:13.57,0:49:14.82,Default,,0,0,0,,Мұндай нәрсе
Dialogue: 0,0:49:15.95,0:49:19.95,Default,,0,0,0,,Мен бұл ешқашан орындалмайды деп ойладым.
Dialogue: 0,0:49:30.21,0:49:31.59,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:49:31.67,0:49:33.13,Default,,0,0,0,,Хмм.
Dialogue: 0,0:49:33.22,0:49:34.55,Default,,0,0,0,,Ішемін бе?
Dialogue: 0,0:49:35.55,0:49:36.64,Default,,0,0,0,,Жоқ
Dialogue: 0,0:49:37.51,0:49:38.43,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:49:40.81,0:49:41.72,Default,,0,0,0,,Темпура?
Dialogue: 0,0:49:42.22,0:49:44.69,Default,,0,0,0,,Жақсы, жейсің.
Dialogue: 0,0:49:44.77,0:49:45.52,Default,,0,0,0,,Бір ай бойы бірдей нәрсені естіп жүрсең, ештеңе сезбей қаласың.
Dialogue: 0,0:49:45.60,0:49:48.81,Default,,0,0,0,,Бақытты екен
Dialogue: 0,0:49:52.86,0:49:56.11,Default,,0,0,0,,Мен ештеңе істеген жоқпын.
Dialogue: 0,0:49:56.61,0:49:58.70,Default,,0,0,0,,Не? Мен көп нәрсе жасадым.
Dialogue: 0,0:49:58.78,0:50:00.83,Default,,0,0,0,,Жоқ, ақымақ.
Dialogue: 0,0:50:02.58,0:50:06.04,Default,,0,0,0,,Мен сен ойлағаннан әлдеқайда артықпын
Dialogue: 0,0:50:06.62,0:50:08.79,Default,,0,0,0,,Маған ұнайсың
Dialogue: 0,0:50:09.75,0:50:11.42,Default,,0,0,0,,Менің де бірдеңе істегім келеді.
Dialogue: 0,0:50:12.09,0:50:12.92,Default,,0,0,0,,Ол маған бұны берді.
Dialogue: 0,0:50:13.88,0:50:15.67,Default,,0,0,0,,Оны—
Dialogue: 0,0:50:17.18,0:50:18.68,Default,,0,0,0,,Мен оны алдым.
Dialogue: 0,0:50:18.76,0:50:19.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:20.26,0:50:22.26,Default,,0,0,0,,Маған қыздар ұнайды
Dialogue: 0,0:50:22.85,0:50:25.81,Default,,0,0,0,,Сонда да мен Шунға ғашық болдым.
Dialogue: 0,0:50:30.52,0:50:32.57,Default,,0,0,0,,Еркектерді ұнататын болсаң, бұл таңқаларлық емес.
Dialogue: 0,0:50:41.16,0:50:43.04,Default,,0,0,0,,Білесің бе, Мио
Dialogue: 0,0:50:43.12,0:50:44.08,Default,,0,0,0,,Иә?
Dialogue: 0,0:50:44.16,0:50:46.58,Default,,0,0,0,,Мен үйге бара жатырмын
Dialogue: 0,0:51:00.68,0:51:01.39,Default,,0,0,0,,Иә
Dialogue: 0,0:51:06.18,0:51:08.35,Default,,0,0,0,,Сіз біраз тазаладыңыз.
Dialogue: 0,0:51:08.44,0:51:10.27,Default,,0,0,0,,Иә.
Dialogue: 0,0:51:10.77,0:51:12.19,Default,,0,0,0,,Кенеттен болғаны үшін кешіріңіз.
Dialogue: 0,0:51:12.27,0:51:16.19,Default,,0,0,0,,Жарайды, асықпай, ата-анаға бауырмал бол.
Dialogue: 0,0:51:16.94,0:51:19.91,Default,,0,0,0,,Егер сізге бірдеңе керек болса, маған хабарлаңыз.
Dialogue: 0,0:51:20.41,0:51:22.32,Default,,0,0,0,,Қонақ үй иесінің әйелі екі күн бұрын қайтыс болды ғой, иә?
Dialogue: 0,0:51:29.66,0:51:32.21,Default,,0,0,0,,Мио, сен не істеп жатырсың?
Dialogue: 0,0:51:34.17,0:51:37.17,Default,,0,0,0,,Сіз не қарап тұрсыз? Бұл жиіркенішті болса да
Dialogue: 0,0:51:37.26,0:51:38.09,Default,,0,0,0,,Уф...
Dialogue: 0,0:51:39.01,0:51:42.14,Default,,0,0,0,,А... бұл не?
Dialogue: 0,0:51:42.22,0:51:45.81,Default,,0,0,0,,Эй, Хоккайдо шынымен суық па?
Dialogue: 0,0:51:45.89,0:51:47.14,Default,,0,0,0,,Суық тигізбе
Dialogue: 0,0:51:48.02,0:51:49.27,Default,,0,0,0,,Мен саған хат жазамын.
Dialogue: 0,0:51:49.35,0:51:51.27,Default,,0,0,0,,А, бірақ қазір менде ұялы телефон бар...
Dialogue: 0,0:51:51.35,0:51:52.40,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,0:51:53.56,0:51:54.15,Default,,0,0,0,,Мио
Dialogue: 0,0:51:55.27,0:51:56.65,Default,,0,0,0,,Менімен барғың келе ме?
Dialogue: 0,0:51:56.73,0:52:00.45,Default,,0,0,0,,Әлде сен мұнда жалғыз күтіп тұрсың ба?
Dialogue: 0,0:52:00.53,0:52:01.82,Default,,0,0,0,,Дәл мен сияқты!
Dialogue: 0,0:52:07.99,0:52:09.75,Default,,0,0,0,,Мен сыныпқа барып қарап келейін.
Dialogue: 0,0:52:11.50,0:52:12.50,Default,,0,0,0,,Мио!
Dialogue: 0,0:52:13.29,0:52:14.38,Default,,0,0,0,,Кел
Dialogue: 0,0:52:15.09,0:52:17.21,Default,,0,0,0,,Мио бірге барайық
Dialogue: 0,0:52:19.97,0:52:22.88,Default,,0,0,0,,Бар, мен сенімен барғым келеді.
Dialogue: 0,0:52:23.64,0:52:25.39,Default,,0,0,0,,1 адам жақсы емес
Dialogue: 0,0:52:26.05,0:52:27.64,Default,,0,0,0,,(Мио жылайды)
Dialogue: 0,0:52:29.72,0:52:31.39,Default,,0,0,0,,Жылама
Dialogue: 0,0:52:32.14,0:52:33.15,Default,,0,0,0,,Мен жыламаймын!
Dialogue: 0,0:52:36.23,0:52:37.48,Default,,0,0,0,,Эй Шун
Dialogue: 0,0:52:38.23,0:52:39.07,Default,,0,0,0,,Теңізге кірейік (Шун) А?
Dialogue: 0,0:52:39.15,0:52:39.94,Default,,0,0,0,,Жақсы!
Dialogue: 0,0:52:40.03,0:52:42.65,Default,,0,0,0,,Не? А...күте...күте тұр!
Dialogue: 0,0:52:43.24,0:52:44.32,Default,,0,0,0,,Мио!
Dialogue: 0,0:52:45.07,0:52:47.12,Default,,0,0,0,,Уау, суық!
Dialogue: 0,0:52:47.20,0:52:48.91,Default,,0,0,0,,Хаха, бұл рас.
Dialogue: 0,0:52:50.08,0:52:50.66,Default,,0,0,0,,Шун
Dialogue: 0,0:52:50.75,0:52:51.75,Default,,0,0,0,,Иә?
Dialogue: 0,0:52:51.83,0:52:52.87,Default,,0,0,0,,Рахмет
Dialogue: 0,0:52:55.29,0:52:56.29,Default,,0,0,0,,Мен бақыттымын!
Dialogue: 0,0:52:57.25,0:52:58.34,Default,,0,0,0,,Ахаха
Dialogue: 0,0:52:58.42,0:53:01.55,Default,,0,0,0,,Неге екенін түсінбеймін, бірақ керемет!
Dialogue: 0,0:53:16.56,0:53:18.23,Default,,0,0,0,,Ал, мен барамын.
Dialogue: 0,0:53:18.82,0:53:20.82,Default,,0,0,0,,Әкең мен анаңның жағдайы жақсы деп үміттенемін.
Dialogue: 0,0:53:23.45,0:53:23.95,Default,,0,0,0,,Ах
Dialogue: 0,0:53:33.29,0:53:34.29,Default,,0,0,0,,Тұттым сені!
Dialogue: 0,0:53:37.79,0:53:38.96,Default,,0,0,0,,Мен қазір кетуім керек
Dialogue: 0,0:53:39.96,0:53:40.46,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:53:52.31,0:53:54.81,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,0:53:55.56,0:53:56.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:53:57.94,0:53:59.81,Default,,0,0,0,,Жоқ, ештеңе.
Dialogue: 0,0:53:59.90,0:54:02.40,Default,,0,0,0,,Қат! Мио!
Dialogue: 0,0:54:02.48,0:54:04.07,Default,,0,0,0,,Кеме кетейін деп жатыр!
Dialogue: 0,0:54:04.15,0:54:05.82,Default,,0,0,0,,О!
Dialogue: 0,0:54:07.61,0:54:08.32,Default,,0,0,0,,Ах
Dialogue: 0,0:54:13.58,0:54:15.12,Default,,0,0,0,,Мио~!
Dialogue: 0,0:54:16.16,0:54:16.96,Default,,0,0,0,,Иә
Dialogue: 0,0:54:21.29,0:54:22.17,Default,,0,0,0,,Иә!
Dialogue: 0,0:54:25.22,0:54:27.22,Default,,0,0,0,,♪~
Dialogue: 0,0:58:21.62,0:58:23.62,Default,,0,0,0,,~♪
