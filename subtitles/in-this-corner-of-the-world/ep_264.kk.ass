Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:00.00,0:00:04.62,kono-staff,,0000,0000,0000,,Бұл субтитрді Yuuriha Subtitles Co., Ltd. шығарған және сіз жапон-жапон алмасуында пайдаланасыз. Сіз оны өзіңіздің қосалқы мақсаттарыңыз үшін және коммерциялық мақсаттар үшін пайдалана аласыз.
Dialogue: 0,0:00:04.64,0:00:08.56,kono-staff,,0000,0000,0000,,Аударма/Жапон аудармасы: Арк Рей Аку Юкисен мектебінің аудармасы/Жапон тіліндегі аудармасы: DestroyerCZ
Dialogue: 0,0:00:08.58,0:00:12.58,kono-staff,,0000,0000,0000,,Уақыты: 55 Кеш кезең: Ice DestroyerCZ жүйесі: DestroyerCZ
Dialogue: 0,0:00:28.78,0:00:31.82,kono-text-jp,,0000,0000,0000,,Біз жалқау балалармыз, сондықтан бізге айтқанды орындаңдар.
Dialogue: 0,0:00:36.94,0:00:41.01,kono-text-jp,,0000,0000,0000,,Сәлем! Жолдан кет
Dialogue: 0,0:00:42.41,0:00:45.89,kono-text-jp,,0000,0000,0000,,Накадзима Хончодағы Футабаға теңіз балдырларын жеткізу
Dialogue: 0,0:00:46.29,0:00:48.26,kono-text-jp,,0000,0000,0000,,Бастапқыда бұл үлкен ағаның рөлі еді.
Dialogue: 0,0:00:48.31,0:00:49.35,kono-text-jp,,0000,0000,0000,,Суыққа байланысты
Dialogue: 0,0:00:49.87,0:00:52.11,kono-text-jp,,0000,0000,0000,,Мен сізді ұсынамын.
Dialogue: 0,0:00:53.12,0:00:53.85,kono-text-jp,,0000,0000,0000,,Цуто
Dialogue: 0,0:00:54.49,0:00:55.97,kono-text-jp,,0000,0000,0000,,Мен қатты әсер алдым.
Dialogue: 0,0:00:56.10,0:00:57.41,kono-text-jp,,0000,0000,0000,,Иә, тоқтат, тоқта.
Dialogue: 0,0:00:57.76,0:01:00.54,kono-text-jp,,0000,0000,0000,,Қиыршық қайық қайтып келмесін, шашылайық.
Dialogue: 0,0:01:00.99,0:01:05.57,kono-text-jp,,0000,0000,0000,,Мен балдырларды жеткізгеннен кейін ағам мен әпкеме кәдесыйлар сатып алып, үйге қайтамын.
Dialogue: 0,0:01:07.16,0:01:08.32,kono-text-jp,,0000,0000,0000,,Мына мұз жігітке қарашы—
Dialogue: 0,0:01:20.14,0:01:24.00,kono-text-jp,,0000,0000,0000,,Әй, жақындап қалдық.
Dialogue: 0,0:01:25.09,0:01:27.24,kono-text-jp,,0000,0000,0000,,Тыныш жерде
Dialogue: 0,0:01:52.21,0:01:54.68,kono-text-jp,,0000,0000,0000,,Уау! Рождество
Dialogue: 0,0:01:55.68,0:01:57.21,kono-text-jp,,0000,0000,0000,,Шоколад 10 сен
Dialogue: 0,0:01:57.40,0:02:00.19,kono-text-jp,,0000,0000,0000,,Карамель үлкен қорап 10 сен кішкентай қорап 5 сен
Dialogue: 0,0:02:00.48,0:02:01.61,kono-text-jp,,0000,0000,0000,,Йойо 10 сен
Dialogue: 0,0:02:01.61,0:02:03.30,kono-text-jp,,0000,0000,0000,,Өте жақсы, өте жақсы.
Dialogue: 0,0:02:05.99,0:02:07.71,kono-text-jp,,0000,0000,0000,,Қызыл жақсы.
Dialogue: 0,0:02:07.86,0:02:09.77,kono-text-jp,,0000,0000,0000,,Әлі бос емес.
Dialogue: 0,0:02:09.77,0:02:10.78,kono-text-jp,,0000,0000,0000,,Шынымен
Dialogue: 0,0:02:11.35,0:02:13.17,kono-text-jp,,0000,0000,0000,,Үздіксіз қолдау көрсеткеніңіз үшін рахмет.
Dialogue: 0,0:02:13.70,0:02:15.15,kono-text-jp,,0000,0000,0000,,Аяғыңызды сау ұстаңыз
Dialogue: 1,0:02:17.78,0:02:26.50,kono-op-jp,,0000,0000,0000,,Аспанның нұры жүрегімді тебірентеді
Dialogue: 1,0:02:27.94,0:02:32.55,kono-op-jp,,0000,0000,0000,,Бүгін тағы да алысқа қарап
Dialogue: 1,0:02:33.85,0:02:39.75,kono-op-jp,,0000,0000,0000,,көз жасын төкті
Dialogue: 1,0:02:47.67,0:02:56.42,kono-op-jp,,0000,0000,0000,,Ақ бұлттар ағып, ағады
Dialogue: 1,0:02:57.53,0:03:02.21,kono-op-jp,,0000,0000,0000,,Бүгін де армандар шырмалған
Dialogue: 1,0:03:03.47,0:03:08.53,kono-op-jp,,0000,0000,0000,,Қатты қалтырап
Dialogue: 1,0:03:08.88,0:03:14.18,kono-op-jp,,0000,0000,0000,,Қайғылы және қайғылы
Dialogue: 1,0:03:14.98,0:03:20.06,kono-op-jp,,0000,0000,0000,,Мен енді мұны істей алмаймын
Dialogue: 1,0:03:20.06,0:03:26.11,kono-op-jp,,0000,0000,0000,,Осы шексіз қуыстың
Dialogue: 1,0:03:26.65,0:03:34.14,kono-op-jp,,0000,0000,0000,,Құтқарылу жоқ па?
Dialogue: 0,0:03:51.29,0:03:53.71,kono-text-jp,,0000,0000,0000,,Егер сол жерде адасып қалсаңыз
Dialogue: 0,0:03:54.48,0:03:56.38,kono-text-jp,,0000,0000,0000,,Мен Наои Контонмен таныстым
Dialogue: 0,0:03:58.96,0:04:00.21,kono-text-jp,,0000,0000,0000,,Сузучан
Dialogue: 0,0:04:00.94,0:04:02.11,kono-text-jp,,0000,0000,0000,,Не? ол
Dialogue: 0,0:04:02.60,0:04:03.35,kono-text-jp,,0000,0000,0000,,Багемон
Dialogue: 0,0:04:04.56,0:04:05.66,kono-text-jp,,0000,0000,0000,,деді
Dialogue: 0,0:04:06.12,0:04:07.77,kono-text-jp,,0000,0000,0000,,Мұны жолды табу үшін пайдаланыңыз
Dialogue: 0,0:04:07.89,0:04:10.00,kono-text-jp,,0000,0000,0000,,Ол маған телескоп арқылы қарауға рұқсат бермеді.
Dialogue: 0,0:04:12.14,0:04:14.92,kono-text-jp,,0000,0000,0000,,Уау, солай көрінеді.
Dialogue: 0,0:04:17.48,0:04:20.88,kono-text-jp,,0000,0000,0000,,Құлаған тордан белгісіз ағайынды табылды.
Dialogue: 0,0:04:21.21,0:04:22.73,kono-text-jp,,0000,0000,0000,,Ол адам ұрлаушы
Dialogue: 0,0:04:22.89,0:04:24.91,kono-text-jp,,0000,0000,0000,,Біз ұрланған адамдармыз.
Dialogue: 0,0:04:24.96,0:04:25.46,kono-text-jp,,0000,0000,0000,,Иә?
Dialogue: 0,0:04:26.71,0:04:28.15,kono-text-jp,,0000,0000,0000,,Сіз әлсізсіз.
Dialogue: 0,0:04:28.71,0:04:32.66,kono-text-jp,,0000,0000,0000,,Мен кешке тауықтарды тамақтандыру үшін үйге баруым керек.
Dialogue: 0,0:04:32.92,0:04:36.31,kono-text-jp,,0000,0000,0000,,Мен де әкеммен бірге үйге пойызбен баруым керек.
Dialogue: 0,0:04:36.36,0:04:42.31,kono-text-jp,,0000,0000,0000,,Үйге кешке дейін жетпесек, мен үшін де, мен үшін де апат болады.
Dialogue: 0,0:04:42.47,0:04:44.52,kono-text-jp,,0000,0000,0000,,Бұл қаншалықты жаман болады?
Dialogue: 0,0:04:44.57,0:04:45.87,kono-text-jp,,0000,0000,0000,,Ал, қараңдаршы.
Dialogue: 0,0:04:52.35,0:04:53.87,kono-text-jp,,0000,0000,0000,,Қария, қария
Dialogue: 1,0:04:52.74,0:04:53.87,kono-text-jp-2,,0000,0000,0000,,Ауырды
Dialogue: 0,0:04:54.73,0:04:57.51,kono-text-jp,,0000,0000,0000,,Қарап, не екенін көр.
Dialogue: 0,0:04:58.58,0:05:00.19,kono-text-jp,,0000,0000,0000,,(Ходжинс) Бүгіннен бастап мен Автоматты жазу қуыршағының шәкірті болып жұмыс істеймін.
Dialogue: 0,0:05:05.28,0:05:08.25,kono-text-jp,,0000,0000,0000,,Түнде ұйықтайсың деген сөз емес.
Dialogue: 0,0:05:09.75,0:05:12.19,kono-text-jp,,0000,0000,0000,,Бұл жігіттің кешкі асына мен де ренжідім.
Dialogue: 0,0:05:14.03,0:05:16.34,kono-text-jp,,0000,0000,0000,,Ангатона Сузу Урано
Dialogue: 0,0:05:16.36,0:05:18.93,kono-text-jp,,0000,0000,0000,,Менің атымды қашан білдің?
Dialogue: 0,0:05:21.29,0:05:22.83,kono-text-jp,,0000,0000,0000,,Ангатона Сузу Урано
Dialogue: 0,0:05:23.86,0:05:25.50,kono-text-jp,,0000,0000,0000,,Міне! шулы!
Dialogue: 0,0:05:27.03,0:05:28.92,kono-text-jp,,0000,0000,0000,,Учаааабутошиторуке
Dialogue: 0,0:05:29.51,0:05:34.29,kono-text-jp,,0000,0000,0000,,Бұл күн менің күндізгі арманым ғана екеніне сенімдімін.
Dialogue: 0,0:05:40.43,0:05:42.70,kono-text-jp,,0000,0000,0000,,Юмбе теңізі осылай болды
Dialogue: 0,0:05:44.25,0:05:46.56,kono-text-jp,,0000,0000,0000,,Бұл таңертең көктемгі толқында болған оқиға.
Dialogue: 0,0:05:48.70,0:05:51.24,kono-text-jp,,0000,0000,0000,,Бала кезімде мұхитты бірінші рет жалғыз өтуім.
Dialogue: 0,0:05:51.42,0:05:52.60,kono-text-jp,,0000,0000,0000,,Бұл қызық
Dialogue: 0,0:05:53.02,0:05:55.32,kono-text-jp,,0000,0000,0000,,Мен көремін: «Кусацудың нағашылары, апалары және әжелері.
Dialogue: 0,0:05:55.32,0:05:57.24,kono-text-jp,,0000,0000,0000,,«Қайырлы таң» деп айтамын.
Dialogue: 0,0:05:57.83,0:06:00.78,kono-text-jp,,0000,0000,0000,,Әкелер қалаға кешігіп келеді.
Dialogue: 0,0:06:01.05,0:06:02.53,kono-text-jp,,0000,0000,0000,,Қарбыз беріңізші
Dialogue: 0,0:06:02.67,0:06:05.85,kono-text-jp,,0000,0000,0000,,Ааан Суми қарбыз ұстады.
Dialogue: 0,0:06:05.89,0:06:06.56,kono-text-jp,,0000,0000,0000,,Жарайды, осы ғана. Абай бол.
Dialogue: 0,0:06:08.19,0:06:10.12,kono-text-jp,,0000,0000,0000,,Қараңдаршы, менің ойнауға уақытым жоқ.
Dialogue: 0,0:06:10.50,0:06:13.45,kono-text-jp,,0000,0000,0000,,Менің ағам өте қатал адам еді.
Dialogue: 0,0:06:13.61,0:06:14.51,kono-text-jp,,0000,0000,0000,,Күте тұрыңыз, иә?
Dialogue: 0,0:06:16.56,0:06:17.91,kono-text-jp,,0000,0000,0000,,Қайырлы таң
Dialogue: 0,0:06:18.58,0:06:20.89,kono-text-jp,,0000,0000,0000,,Әке мен шеше...
Dialogue: 0,0:06:21.32,0:06:22.30,kono-text-jp,,0000,0000,0000,,Чайнатаун болса да, ол Йокогамада ғой!
Dialogue: 0,0:06:22.71,0:06:24.15,kono-text-jp,,0000,0000,0000,,Суй... Сәлем!
Dialogue: 0,0:06:24.63,0:06:26.37,kono-text-jp,,0000,0000,0000,,Қарбыз беріңізші
Dialogue: 0,0:06:26.45,0:06:28.89,kono-text-jp,,0000,0000,0000,,Рахмет. Құрбандық жасайық.
Dialogue: 0,0:06:29.14,0:06:32.04,kono-text-jp,,0000,0000,0000,,Хохо Бетсупинсанжа
Dialogue: 0,0:06:32.45,0:06:37.47,kono-text-jp,,0000,0000,0000,,Әжем жыл сайын маған жаңа кимоно жасап беретін.
Dialogue: 0,0:06:37.98,0:06:41.07,kono-text-jp,,0000,0000,0000,,Дүкенге барған ана мен әке бірге болғанда
Dialogue: 0,0:06:41.24,0:06:42.17,kono-text-jp,,0000,0000,0000,,Бейітті зиярат ету
Dialogue: 0,0:06:44.39,0:06:45.98,kono-text-jp,,0000,0000,0000,,Сіз қалай ойлайсыз? Энами
Dialogue: 0,0:06:46.21,0:06:48.40,kono-text-jp,,0000,0000,0000,,Бұл қиын.
Dialogue: 0,0:06:48.84,0:06:50.40,kono-text-jp,,0000,0000,0000,,Порттың жанында болуы керек
Dialogue: 0,0:06:50.40,0:06:51.49,kono-text-jp,,0000,0000,0000,,Солай ма?
Dialogue: 0,0:06:54.70,0:06:56.81,kono-text-jp-2,,0000,0000,0000,,Күндіз үйде егеуқұйрықтар бар ма?
Dialogue: 0,0:06:58.11,0:06:59.41,kono-text-jp,,0000,0000,0000,,Әртүрлі
Dialogue: 0,0:07:02.24,0:07:04.71,kono-text-jp,,0000,0000,0000,,Бала болғанның айыбы жоқ.
Dialogue: 0,0:07:05.44,0:07:07.73,kono-text-jp,,0000,0000,0000,,Мен көп нәрсені көріп тұрғандай сезінемін.
Dialogue: 0,0:07:26.68,0:07:29.08,kono-text-jp,,0000,0000,0000,,Сәлеметсіз бе...
Dialogue: 0,0:07:34.72,0:07:35.67,kono-text-jp,,0000,0000,0000,,Ум
Dialogue: 0,0:07:37.21,0:07:39.84,kono-text-jp,,0000,0000,0000,,Одан да жақсы, ашуланайық.
Dialogue: 0,0:07:43.85,0:07:45.18,kono-text-jp,,0000,0000,0000,,Әже
Dialogue: 0,0:07:47.81,0:07:50.93,kono-text-jp,,0000,0000,0000,,Қараңдаршы, толқын азайып барады.
Dialogue: 0,0:07:51.69,0:07:52.90,kono-text-jp,,0000,0000,0000,,Қараңдар, дайындалыңдар.
Dialogue: 0,0:07:54.35,0:07:55.98,kono-text-jp,,0000,0000,0000,,Мұнда Сумимо
Dialogue: 0,0:07:57.59,0:07:58.28,kono-text-jp,,0000,0000,0000,,Қараңыз
Dialogue: 0,0:08:00.19,0:08:03.56,kono-text-jp,,0000,0000,0000,,Жалғыз болсаңыз, кейінірек келіңіз.
Dialogue: 0,0:08:04.34,0:08:04.95,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,0:08:05.25,0:08:09.63,kono-text-jp,,0000,0000,0000,,Егер мен қаласам, кимононы тастап кетсем, оны киюге келмес едім.
Dialogue: 0,0:08:10.92,0:08:14.21,kono-text-jp,,0000,0000,0000,,Сузу-чан сондай мейірімді.
Dialogue: 0,0:08:14.89,0:08:19.52,kono-text-jp,,0000,0000,0000,,Ол кісі менің мектептегі мұғалімім айтқан зашики варо болуы керек.
Dialogue: 0,0:08:20.07,0:08:21.38,kono-text-jp,,0000,0000,0000,,Маған ағам айтты
Dialogue: 0,0:08:21.44,0:08:26.06,kono-text-jp,,0000,0000,0000,,Сол кеште табиғат пен адамдар жұмсақ әрі бұлыңғыр болып көрінді.
Dialogue: 0,0:08:27.16,0:08:30.66,kono-text-jp,,0000,0000,0000,,Күрсіну~ Мен кимономды Кусацуда қалдырдым.
Dialogue: 0,0:08:30.70,0:08:32.54,kono-text-jp,,0000,0000,0000,,Барыңыз, қазір алыңыз, жүзіңіз.
Dialogue: 0,0:08:32.76,0:08:33.72,kono-text-jp,,0000,0000,0000,,Боке
Dialogue: 0,0:08:35.52,0:08:38.31,kono-text-jp,,0000,0000,0000,,Ичанның қорқынышты екенін де ұмытып кетіппін.
Dialogue: 0,0:08:44.54,0:08:46.41,kono-text-jp,,0000,0000,0000,,Қалайы төменірек.
Dialogue: 0,0:08:46.94,0:08:48.35,kono-text-jp,,0000,0000,0000,,Жел болса да ұшады
Dialogue: 0,0:08:48.66,0:08:49.18,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,0:08:50.42,0:08:52.86,kono-text-jp,,0000,0000,0000,,Аа, мама, маған 2 сен берші, өтінемін.
Dialogue: 0,0:08:52.95,0:08:54.59,kono-text-jp,,0000,0000,0000,,Қарындашты таста
Dialogue: 0,0:08:54.65,0:08:56.39,kono-text-jp,,0000,0000,0000,,Қалтаңыздағы ақшаны ұстаңыз.
Dialogue: 0,0:08:57.57,0:09:00.00,kono-text-jp,,0000,0000,0000,,Дудл жасамасаңыз, бәрі жақсы болады деп ойлаймын.
Dialogue: 0,0:09:03.06,0:09:05.61,kono-text-jp,,0000,0000,0000,,Суми-чан, қарындашты ауыстырайық.
Dialogue: 0,0:09:05.67,0:09:06.17,kono-text-jp,,0000,0000,0000,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:09:06.27,0:09:07.00,kono-text-jp,,0000,0000,0000,,Қалайы
Dialogue: 0,0:09:07.20,0:09:10.06,kono-text-jp,,0000,0000,0000,,Сувондағы Тэцукун мектепке күнде келеді
Dialogue: 0,0:09:10.34,0:09:11.90,kono-text-jp,,0000,0000,0000,,Не? Мен келемін бірақ
Dialogue: 0,0:09:17.56,0:09:18.25,kono-text-jp,,0000,0000,0000,,Уау, суық
Dialogue: 0,0:09:18.25,0:09:19.21,kono-text-jp,,0000,0000,0000,,Салқындату
Dialogue: 0,0:09:38.02,0:09:38.73,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,0:09:40.67,0:09:42.12,kono-text-jp,,0000,0000,0000,,Миджика
Dialogue: 0,0:09:42.61,0:09:44.80,kono-text-jp,,0000,0000,0000,,Бұл маған осы аптада созылмайды.
Dialogue: 0,0:09:45.17,0:09:47.26,kono-text-jp,,0000,0000,0000,,Бұл жолы оны тастамауға тырысыңыз.
Dialogue: 0,0:09:50.96,0:09:52.93,kono-text-jp,,0000,0000,0000,,Бүгінгі сурет – еркін сурет.
Dialogue: 0,0:09:53.36,0:09:55.67,kono-text-jp,,0000,0000,0000,,Оны жіберген адамнан қайтаруыңызды сұраймыз.
Dialogue: 0,0:09:55.70,0:09:56.96,kono-text-jp,,0000,0000,0000,,Yes
Dialogue: 0,0:09:56.96,0:09:58.53,kono-text-jp,,0000,0000,0000,,Мен қайда жазуым керек?
Dialogue: 0,0:09:58.53,0:09:59.80,kono-text-jp,,0000,0000,0000,,Мұнда басшының жеке гвардиясы орналасқан
Dialogue: 0,0:10:00.62,0:10:02.25,kono-text-jp,,0000,0000,0000,,Иә, иә.
Dialogue: 0,0:10:02.62,0:10:03.99,kono-text-jp,,0000,0000,0000,,Урано Джанудан күткендей
Dialogue: 0,0:10:04.60,0:10:06.76,kono-text-jp,,0000,0000,0000,,Иә, Сузу-чан, сен жақсысың.
Dialogue: 0,0:10:09.44,0:10:11.20,kono-text-jp,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:10:13.43,0:10:15.63,kono-text-jp,,0000,0000,0000,,Жүр, мен үйге келгенде алып кетемін.
Dialogue: 0,0:10:15.81,0:10:16.84,kono-text-jp,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:10:35.90,0:10:37.25,kono-text-jp,,0000,0000,0000,,Мизухара мырза
Dialogue: 0,0:10:37.81,0:10:41.33,kono-text-jp,,0000,0000,0000,,Тезірек, Эде-сан екеуміз үйге мәңгілікке бара алмаймыз.
Dialogue: 0,0:10:41.84,0:10:42.49,kono-text-jp,,0000,0000,0000,,Артқа қайтпайды
Dialogue: 0,0:10:43.72,0:10:47.09,kono-text-jp,,0000,0000,0000,,Әкем мен шешем де балдырларды теріп, ішкен.
Dialogue: 0,0:10:47.74,0:10:49.03,kono-text-jp,,0000,0000,0000,,Мен теңізді жек көремін
Dialogue: 0,0:10:49.84,0:10:50.77,kono-text-jp,,0000,0000,0000,,Сурет салмаңыз
Dialogue: 0,0:10:51.32,0:10:52.73,kono-text-jp,,0000,0000,0000,,Уранотты шығарыңыз!
Dialogue: 0,0:10:57.34,0:10:57.73,kono-text-jp,,0000,0000,0000,,Иә?
Dialogue: 0,0:10:57.77,0:10:58.20,kono-text-jp,,0000,0000,0000,,Жасаңыз
Dialogue: 0,0:11:00.96,0:11:02.00,kono-text-jp,,0000,0000,0000,,Е, гейдемо
Dialogue: 0,0:11:02.45,0:11:05.08,kono-text-jp,,0000,0000,0000,,Онии-чанның Джайок Аруке
Dialogue: 0,0:11:05.66,0:11:07.29,kono-text-jp,,0000,0000,0000,,Қоян секіреді
Dialogue: 0,0:11:08.12,0:11:11.32,kono-text-jp,,0000,0000,0000,,Жаңа жыл күні аударылған апат те осындай теңізде болды.
Dialogue: 0,0:11:12.24,0:11:13.94,kono-text-jp,,0000,0000,0000,,Мен оны салғым келсе, сіз оны салыңыз.
Dialogue: 0,0:11:14.44,0:11:15.87,kono-text-jp,,0000,0000,0000,,Тіпті мына қызықсыз теңізде де
Dialogue: 0,0:11:18.99,0:11:22.30,kono-text-jp,,0000,0000,0000,,Мизухара мырза, Иманон нені білдіреді?
Dialogue: 0,0:11:25.29,0:11:27.89,kono-text-jp,,0000,0000,0000,,Ақ толқындар секірген қоян тәрізді.
Dialogue: 0,0:11:28.72,0:11:31.54,kono-text-jp,,0000,0000,0000,,Мизухара-сан, саған үлкен аға беруім керек пе?
Dialogue: 0,0:11:31.55,0:11:32.22,kono-text-jp,,0000,0000,0000,,шайқастан барынша аулақ болуға тырысқанымызға қарамастан, әскеріміздің шамамен жиырма пайызын жоғалттық.
Dialogue: 0,0:11:33.22,0:11:35.90,kono-text-jp,,0000,0000,0000,,Уранның ағасын көрсеңіз, бар жылдамдықпен қашыңыз.
Dialogue: 0,0:11:35.90,0:11:37.63,kono-text-jp,,0000,0000,0000,,Ерлерге арналған ережелер бар.
Dialogue: 0,0:11:40.08,0:11:43.55,kono-text-jp,,0000,0000,0000,,Эй, мен теңіз мектебіне бардым.
Dialogue: 0,0:11:44.21,0:11:46.50,kono-text-jp,,0000,0000,0000,,Теңізге батқан ақымақтан артық
Dialogue: 0,0:11:48.07,0:11:51.69,kono-text-jp,,0000,0000,0000,,Бұл дұрыс емес. Бұл ақ қоян сияқты.
Dialogue: 0,0:11:53.31,0:11:54.98,kono-text-jp,,0000,0000,0000,,Иә, орындалды.
Dialogue: 0,0:11:55.52,0:11:56.80,kono-text-jp,,0000,0000,0000,,Жинаңыз және кетіңіз
Dialogue: 0,0:11:56.80,0:11:57.93,kono-text-jp,,0000,0000,0000,,А, рахмет
Dialogue: 0,0:11:59.87,0:12:01.69,kono-text-jp,,0000,0000,0000,,Жарайды, мен одан құтыламын.
Dialogue: 0,0:12:02.58,0:12:04.95,kono-text-jp,,0000,0000,0000,,Мен мұны істегеннен кейін үйге бармауым керек.
Dialogue: 0,0:12:05.94,0:12:06.86,kono-text-jp,,0000,0000,0000,,Бұл әдемі сурет
Dialogue: 0,0:12:07.82,0:12:09.58,kono-text-jp,,0000,0000,0000,,Теңізді жек көруге болмайды
Dialogue: 0,0:12:16.40,0:12:20.81,kono-text-jp,,0000,0000,0000,,Тынық мұхитының бүкіл шығыс аймағында әрекет ететін Император Әскери-теңіз күштерінің бөлімшелері
Dialogue: 0,0:12:20.81,0:12:23.15,kono-text-jp,,0000,0000,0000,,Ура! Ура!
Dialogue: 0,0:12:23.54,0:12:24.74,kono-text-jp,,0000,0000,0000,,Сәттілік
Dialogue: 0,0:12:26.53,0:12:30.02,kono-text-jp,,0000,0000,0000,,Моританың жиені, оны осы жерден алғаныңыз дұрыс.
Dialogue: 0,0:12:30.19,0:12:31.45,kono-text-jp,,0000,0000,0000,,Ай
Dialogue: 0,0:12:33.91,0:12:36.04,kono-text-jp,,0000,0000,0000,,Бұл әдемі жауынгерлік киім.
Dialogue: 0,0:12:39.80,0:12:40.37,kono-text-jp,,0000,0000,0000,,Салқындату
Dialogue: 0,0:12:40.06,0:12:41.35,kono-text-jp-2,,0000,0000,0000,,Сәлем!
Dialogue: 0,0:12:53.10,0:12:54.66,kono-text-jp,,0000,0000,0000,,Сіз тамаша істеп жатырсыз.
Dialogue: 0,0:12:54.96,0:12:57.27,kono-text-jp,,0000,0000,0000,,Ей, түскі асты сол жерден ішейік.
Dialogue: 0,0:12:58.18,0:12:59.24,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,0:12:59.90,0:13:00.98,kono-text-jp,,0000,0000,0000,,Алыста
Dialogue: 0,0:13:01.65,0:13:02.14,kono-text-jp,,0000,0000,0000,,Иә?
Dialogue: 0,0:13:02.60,0:13:05.03,kono-text-jp,,0000,0000,0000,,Сузу-нечан үйлену үшін алысқа кетуі керек.
Dialogue: 0,0:13:05.68,0:13:06.60,kono-text-jp,,0000,0000,0000,,Хонан?
Dialogue: 0,0:13:07.21,0:13:08.73,kono-text-jp,,0000,0000,0000,,Суми-ни жақын жерде.
Dialogue: 0,0:13:08.93,0:13:14.38,kono-text-jp,,0000,0000,0000,,Таяқшаны алыс ұстаған бала тұрмысқа шығу үшін алысқа кетуі керек.
Dialogue: 0,0:13:16.22,0:13:18.06,kono-text-jp,,0000,0000,0000,,Әже қайдан шыққан?
Dialogue: 0,0:13:19.24,0:13:21.90,kono-text-jp,,0000,0000,0000,,Мен Фурумын.
Dialogue: 0,0:13:22.16,0:13:25.11,kono-text-jp,,0000,0000,0000,,Көрші Фуруден Кусацуға барма.
Dialogue: 0,0:13:25.23,0:13:28.88,kono-text-jp,,0000,0000,0000,,Егер сіз Маньчжурияда немесе басқа жерде болған болсаңыз, тіпті таяқшалар да жеткіліксіз.
Dialogue: 0,0:13:28.93,0:13:32.89,kono-text-jp,,0000,0000,0000,,Осыны айтып жатқанда таяқшаларын қайта алған Суми Урано болды.
Dialogue: 0,0:13:33.21,0:13:35.52,kono-text-jp,,0000,0000,0000,,Тым жақын болса, арман жоқ.
Dialogue: 0,0:13:40.15,0:13:41.90,kono-text-jp,,0000,0000,0000,,Сузу-чан жақында үйге келеді
Dialogue: 0,0:13:42.03,0:13:44.87,kono-text-jp,,0000,0000,0000,,Мен қазір шақырылғаннан кейін бірдеңе туралы ойласам ше?
Dialogue: 0,0:13:44.87,0:13:48.05,kono-text-jp,,0000,0000,0000,,Сені әйелі етіп алған адам сені өзіне қызметші етіп алуы керек.
Dialogue: 0,0:13:48.18,0:13:49.59,kono-text-jp,,0000,0000,0000,,Күреден бастап
Dialogue: 0,0:13:49.72,0:13:50.35,kono-text-jp,,0000,0000,0000,,Ву?
Dialogue: 0,0:13:50.81,0:13:54.21,kono-text-jp,,0000,0000,0000,,Сузу-чан, сен нешедесің?
Dialogue: 0,0:13:54.27,0:13:55.40,kono-text-jp,,0000,0000,0000,,19
Dialogue: 0,0:13:55.79,0:13:58.34,kono-text-jp,,0000,0000,0000,,Толығымен 18
Dialogue: 0,0:13:58.79,0:14:01.05,kono-text-jp,,0000,0000,0000,,Ұнамаса, жоқ деп айта алмайсың.
Dialogue: 0,0:14:01.18,0:14:02.83,kono-text-jp,,0000,0000,0000,,Танысқаныма қуаныштымын Чито
Dialogue: 0,0:14:02.83,0:14:05.18,kono-text-jp,,0000,0000,0000,,Сузу-чан, бір сәт осында кел.
Dialogue: 0,0:14:06.83,0:14:12.17,kono-text-jp,,0000,0000,0000,,Саған тұрмысқа шыққанда, ойламаймын, бірақ түзетемін.
Dialogue: 0,0:14:12.90,0:14:15.69,kono-text-jp,,0000,0000,0000,,Шешім болса, жарайды.
Dialogue: 0,0:14:18.10,0:14:19.27,kono-text-jp,,0000,0000,0000,,Рахмет
Dialogue: 0,0:14:20.42,0:14:21.46,kono-text-jp,,0000,0000,0000,,Хондену
Dialogue: 0,0:14:21.66,0:14:24.69,kono-text-jp,,0000,0000,0000,,Мен ана жақтағы үйде мереке жасаймын.
Dialogue: 0,0:14:25.60,0:14:26.22,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,0:14:26.22,0:14:31.22,kono-text-jp,,0000,0000,0000,,Сол түні күйеу балам: ''Қолшатыр әкелдің бе?'' деді.
Dialogue: 0,0:14:32.32,0:14:36.92,kono-text-jp,,0000,0000,0000,,«Мен саған жаңа бөтелке әкелдім», - деді.
Dialogue: 0,0:14:37.56,0:14:41.05,kono-text-jp,,0000,0000,0000,,Біреу: «Сізге шынымен де мән бересіз бе?» десе.
Dialogue: 0,0:14:41.16,0:14:43.36,kono-text-jp,,0000,0000,0000,,«Өтінемін» деңіз Жарайды?
Dialogue: 0,0:14:44.21,0:14:45.03,kono-text-jp,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:14:45.32,0:14:46.39,kono-text-jp,,0000,0000,0000,,Бәрі де болады
Dialogue: 0,0:14:46.63,0:14:48.88,kono-text-jp,,0000,0000,0000,,Шамасы, біз өсетін боламыз.
Dialogue: 0,0:14:49.69,0:14:53.28,kono-text-jp,,0000,0000,0000,,Куреутара Әскери порты бар жерде
Dialogue: 0,0:14:53.87,0:14:56.20,kono-text-jp,,0000,0000,0000,,Теңізші кетіп бара жатыр
Dialogue: 0,0:15:01.95,0:15:03.03,kono-text-jp,,0000,0000,0000,,Мизухара мырза
Dialogue: 0,0:15:05.03,0:15:06.42,kono-text-jp,,0000,0000,0000,,Көптен бері көрмеген
Dialogue: 0,0:15:06.69,0:15:08.08,kono-text-jp,,0000,0000,0000,,Тез, үйге қайт!
Dialogue: 0,0:15:08.17,0:15:08.60,kono-text-jp,,0000,0000,0000,,Ха
Dialogue: 0,0:15:08.98,0:15:12.23,kono-text-jp,,0000,0000,0000,,Анаң қатты шу шығарды.
Dialogue: 0,0:15:12.42,0:15:13.83,kono-text-jp,,0000,0000,0000,,Маңайдағылардың бәрі біледі
Dialogue: 0,0:15:16.28,0:15:17.66,kono-text-jp,,0000,0000,0000,,Мен асығыс едім
Dialogue: 0,0:15:17.83,0:15:19.88,kono-text-jp,,0000,0000,0000,,Менің қарсыласым екеніңізге сенімдімін.
Dialogue: 0,0:15:19.89,0:15:20.95,kono-text-jp,,0000,0000,0000,,Сен ақымақсың ба?
Dialogue: 0,0:15:21.80,0:15:25.46,kono-text-jp,,0000,0000,0000,,Жаңа ғана ағамның қайтыс болғанына 7 жыл толғанда үйге салтанатты түрде оралдым.
Dialogue: 0,0:15:28.01,0:15:30.56,kono-text-jp,,0000,0000,0000,,Сіз басқа адамды танисыз ба?
Dialogue: 0,0:15:31.29,0:15:32.07,kono-text-jp,,0000,0000,0000,,Мүлдем емес
Dialogue: 0,0:15:32.83,0:15:35.61,kono-text-jp,,0000,0000,0000,,Мен Суми Чан деп қателескен шығармын.
Dialogue: 0,0:15:36.37,0:15:38.51,kono-text-jp,,0000,0000,0000,,Суми-чан әдемірек
Dialogue: 0,0:15:39.60,0:15:41.52,kono-text-jp,,0000,0000,0000,,Мен олай ойламаймын.
Dialogue: 0,0:15:42.47,0:15:45.30,kono-text-jp,,0000,0000,0000,,Мен осы мектепке бара бастадым.
Dialogue: 0,0:15:45.37,0:15:47.84,kono-text-jp,,0000,0000,0000,,Мен оны алғаш рет бір жерден көрдім деп ойлаймын.
Dialogue: 0,0:15:49.06,0:15:51.83,kono-text-jp,,0000,0000,0000,,Үй іздеу де маңызды болды.
Dialogue: 0,0:15:52.25,0:15:55.61,kono-text-jp,,0000,0000,0000,,Біз де осыдан үш жыл бұрын Еба жағалауындағы мелиорацияға қатысқанбыз.
Dialogue: 0,0:15:55.79,0:15:57.86,kono-text-jp,,0000,0000,0000,,Мен балдырдан бас тарттым.
Dialogue: 0,0:15:59.15,0:16:01.41,kono-text-jp,,0000,0000,0000,,Менің ойымша, ол жақында оралады.
Dialogue: 0,0:16:02.49,0:16:05.23,kono-text-jp,,0000,0000,0000,,Иә, бұл әңгіме ме, жоқ па білмедім.
Dialogue: 0,0:16:05.68,0:16:10.87,kono-text-jp,,0000,0000,0000,,Аузыма карамель дәмі тарағанын неге сездім деп ойлаймын.
Dialogue: 0,0:16:11.26,0:16:12.41,kono-text-jp,,0000,0000,0000,,О, сабыр
Dialogue: 0,0:16:13.42,0:16:15.02,kono-text-jp,,0000,0000,0000,,Мен қиындыққа тап болдым.
Dialogue: 0,0:16:15.97,0:16:18.52,kono-text-jp,,0000,0000,0000,,Ұнамаса, жоқ деп айт.
Dialogue: 0,0:16:19.09,0:16:21.90,kono-text-jp,,0000,0000,0000,,Оны жек көретінін де, жек көрмейтінін де білмеді.
Dialogue: 0,0:16:21.91,0:16:22.91,kono-text-jp,,0000,0000,0000,,Ум
Dialogue: 0,0:16:24.20,0:16:24.93,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,0:16:26.82,0:16:28.99,kono-text-jp,,0000,0000,0000,,Адасып қалмасқа амалым жоқ.
Dialogue: 0,0:16:29.06,0:16:30.96,kono-text-jp,,0000,0000,0000,,Қай трамвай аялдамасы?
Dialogue: 0,0:16:31.53,0:16:32.41,kono-text-jp,,0000,0000,0000,,Осы жолмен
Dialogue: 0,0:16:32.43,0:16:33.62,kono-text-jp,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:16:33.78,0:16:37.10,kono-text-jp,,0000,0000,0000,,Мен мұны мейірімді теңізшіге айтсам қарсы болмас едім.
Dialogue: 0,0:16:39.09,0:16:41.46,kono-text-jp,,0000,0000,0000,,Ол біртүрлі адам болса керек.
Dialogue: 0,0:16:41.71,0:16:46.47,kono-text-jp,,0000,0000,0000,,Оны тауда жүрген бейтаныс әйел үйіне аман-есен жеткізген сияқты.
Dialogue: 0,0:16:50.86,0:16:54.13,kono-text-jp,,0000,0000,0000,,Мен жай ғана ойсыз болдым деп ойлаймын.
Dialogue: 0,0:16:55.54,0:16:58.57,kono-text-jp,,0000,0000,0000,,Қызық, бұл қашан болды?
Dialogue: 0,0:17:08.73,0:17:09.84,kono-text-jp,,0000,0000,0000,,Йогакане
Dialogue: 0,0:17:09.93,0:17:14.82,kono-text-jp,,0000,0000,0000,,Бұдан былай теңіз жағындағы жапқыштарды жабыңыз.
Dialogue: 0,0:17:24.32,0:17:26.09,kono-text-jp,,0000,0000,0000,,Бір жерде терезені ашыңыз
Dialogue: 0,0:17:30.45,0:17:33.99,kono-text-jp,,0000,0000,0000,,Ву Ву
Dialogue: 0,0:17:35.73,0:17:38.13,kono-text-jp,,0000,0000,0000,,Әскери-теңіз күштерінің мылтық батареясын оқыту.
Dialogue: 0,0:17:52.68,0:17:53.79,kono-text-jp,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,0:17:53.80,0:17:55.00,kono-text-jp,,0000,0000,0000,,Мен оны уақытында орындаймын деп ойлаймын.
Dialogue: 0,0:17:57.88,0:18:00.46,kono-text-jp,,0000,0000,0000,,Көмір автобусы келер еді.
Dialogue: 0,0:18:01.01,0:18:02.14,kono-text-jp,,0000,0000,0000,,О, Кобаяши-сан.
Dialogue: 0,0:18:02.14,0:18:03.75,kono-text-jp,,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:18:04.11,0:18:07.32,kono-text-jp,,0000,0000,0000,,Кобаяши мырза, мен бүгін сізден көмек сұрағым келеді.
Dialogue: 0,0:18:07.43,0:18:09.97,kono-text-jp,,0000,0000,0000,,Ауа-райы жақсы деп үміттенемін.
Dialogue: 0,0:18:11.17,0:18:13.21,kono-text-jp,,0000,0000,0000,,Көмегің үшін рахмет, Суенага
Dialogue: 0,0:18:13.66,0:18:15.92,kono-text-jp,,0000,0000,0000,,Кішкентай болсам да, саған перзент боламын.
Dialogue: 0,0:18:15.92,0:18:18.51,kono-text-jp,,0000,0000,0000,,Бұл Шусакудың Кобаяши апасы.
Dialogue: 0,0:18:18.80,0:18:20.96,kono-text-jp,,0000,0000,0000,,Сәйкес келуші ретінде әрекет етіңіз.
Dialogue: 0,0:18:21.10,0:18:24.10,kono-text-jp,,0000,0000,0000,,Мен үйленетін жердің фамилиясын есте сақтау керек сияқты.
Dialogue: 0,0:18:24.10,0:18:26.44,kono-text-jp,,0000,0000,0000,,Шынымен кішкентай болса жарай ма?
Dialogue: 0,0:18:35.09,0:18:37.46,kono-text-jp,,0000,0000,0000,,Ол шынымен көтерілді ме?
Dialogue: 0,0:18:37.88,0:18:40.10,kono-text-jp,,0000,0000,0000,,Бұл дәл бұрыш.
Dialogue: 0,0:18:40.33,0:18:41.83,kono-text-jp,,0000,0000,0000,,Міне, осы
Dialogue: 0,0:18:42.25,0:18:43.90,kono-text-jp,,0000,0000,0000,,Ол келді.
Dialogue: 0,0:18:44.54,0:18:47.46,kono-text-jp,,0000,0000,0000,,Кешіріңіз, бұл күндері бәрі өте ыңғайлы.
Dialogue: 0,0:18:47.80,0:18:49.29,kono-text-jp,,0000,0000,0000,,Менің балам – жегіш.
Dialogue: 0,0:18:49.30,0:18:50.19,kono-text-jp,,0000,0000,0000,,Сузу-чан
Dialogue: 0,0:18:50.92,0:18:51.98,kono-text-jp,,0000,0000,0000,,Аранжировка
Dialogue: 0,0:18:52.19,0:18:54.45,kono-text-jp,,0000,0000,0000,,Ең жақсы киім ысырап болатын жер
Dialogue: 0,0:18:56.80,0:18:59.55,kono-text-jp,,0000,0000,0000,,Киімді қай жерде шешуге болады?
Dialogue: 0,0:19:06.93,0:19:08.93,kono-text-jp,,0000,0000,0000,,Бұл тағы бір үлкен қуаныш.
Dialogue: 0,0:19:08.93,0:19:11.97,kono-text-jp,,0000,0000,0000,,Бұл баланың ағасы келе алмайтыны шынымен ұят.
Dialogue: 0,0:19:11.98,0:19:14.41,kono-text-jp,,0000,0000,0000,,Осының бәрін жинағаныңыз рас.
Dialogue: 0,0:19:14.74,0:19:19.83,kono-text-jp,,0000,0000,0000,,Жақсы тамақтанайық, кешкі асқа мына үйдегілердің бәріне қамқор болайық.
Dialogue: 0,0:19:20.05,0:19:22.44,kono-text-jp,,0000,0000,0000,,Бұл бұқтырма да қайнатылған.
Dialogue: 0,0:19:23.91,0:19:26.93,kono-text-jp,,0000,0000,0000,,Сіз тыныш адам екенсіз.
Dialogue: 0,0:19:27.32,0:19:29.48,kono-text-jp,,0000,0000,0000,,Бұндай жерде ешкім шу шығармас.
Dialogue: 0,0:19:29.48,0:19:30.95,kono-text-jp,,0000,0000,0000,,Сіз шатастырдыңыз.
Dialogue: 0,0:19:32.67,0:19:35.34,kono-text-jp,,0000,0000,0000,,Ал, мен үйге қайтқанда.
Dialogue: 0,0:19:35.50,0:19:37.48,kono-text-jp,,0000,0000,0000,,Жақсы.
Dialogue: 0,0:19:39.43,0:19:40.56,kono-text-jp,,0000,0000,0000,,Мен қайта ораламын.
Dialogue: 0,0:19:45.41,0:19:49.28,kono-text-jp,,0000,0000,0000,,Мм... бұл кім болды?
Dialogue: 0,0:19:49.34,0:19:50.90,kono-text-jp,,0000,0000,0000,,Менің әйелім де келді
Dialogue: 0,0:19:51.10,0:19:54.54,kono-text-jp,,0000,0000,0000,,Үйдегінің бәрін маған қалдырып, тыныш ұйықта.
Dialogue: 0,0:19:54.73,0:19:55.38,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,0:19:57.22,0:20:01.27,kono-text-jp,,0000,0000,0000,,Әрқашан қолдау көрсеткеніңіз үшін қайын ата мен енеңізге рахмет.
Dialogue: 0,0:20:01.63,0:20:03.79,kono-text-jp,,0000,0000,0000,,Inoue-ге қош келдіңіз
Dialogue: 0,0:20:04.14,0:20:06.73,kono-text-jp,,0000,0000,0000,,Менің аяғым ауырады.
Dialogue: 0,0:20:07.12,0:20:09.29,kono-text-jp,,0000,0000,0000,,Танысқаныма қуаныштымын, Сузу-сан
Dialogue: 0,0:20:09.91,0:20:10.35,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,0:20:11.86,0:20:13.03,kono-text-jp,,0000,0000,0000,,Апыр-ай, жақсы болды. Сонымен, іс шешілді ғой?
Dialogue: 0,0:20:13.31,0:20:15.81,kono-text-jp,,0000,0000,0000,,Пеште пісіретін нәрсені күйдірмеңіз.
Dialogue: 0,0:20:16.07,0:20:20.29,kono-text-jp,,0000,0000,0000,,Одан әрі күйеуге шыққан қайынсіңлің бе?
Dialogue: 0,0:20:38.93,0:20:40.47,kono-text-jp,,0000,0000,0000,,Әскери кеменің сәулеленуіне дайындық
Dialogue: 0,0:20:40.48,0:20:41.63,kono-text-jp,,0000,0000,0000,,Уау
Dialogue: 0,0:20:42.82,0:20:45.46,kono-text-jp,,0000,0000,0000,,Біз қай жерге келдік?
Dialogue: 0,0:20:52.71,0:20:55.75,kono-text-jp,,0000,0000,0000,,Футон үшін рахмет
Dialogue: 0,0:20:56.29,0:20:56.89,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,0:21:01.65,0:21:02.82,kono-text-jp,,0000,0000,0000,,О, Сузу-сан
Dialogue: 0,0:21:03.31,0:21:03.96,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,0:21:05.19,0:21:07.31,kono-text-jp,,0000,0000,0000,,Қолшатыр әкелуім керек пе?
Dialogue: 0,0:21:11.80,0:21:15.57,kono-text-jp,,0000,0000,0000,,Иә, бір жаңа
Dialogue: 0,0:21:16.81,0:21:18.31,kono-text-jp,,0000,0000,0000,,Маған аздап қарыз беріңізші.
Dialogue: 0,0:21:25.63,0:21:26.23,kono-text-jp,,0000,0000,0000,,Қараңыз
Dialogue: 0,0:21:28.81,0:21:30.09,kono-text-jp,,0000,0000,0000,,Менің қарным ашты.
Dialogue: 0,0:21:34.14,0:21:35.85,kono-text-jp,,0000,0000,0000,,Неліктен әлі күнге дейін құлықсыз?
Dialogue: 0,0:21:37.85,0:21:40.57,kono-text-jp,,0000,0000,0000,,Сіз күндіз ештеңе жеген жоқсыз.
Dialogue: 0,0:21:41.30,0:21:44.23,kono-text-jp,,0000,0000,0000,,Аузыңмен тамақ ішпейсің деп жеңілдеп қалдым.
Dialogue: 0,0:21:46.13,0:21:47.69,kono-text-jp,,0000,0000,0000,,А, өзіңді қауіпсіз сезін, қауіпсіз сезін.
Dialogue: 0,0:21:47.79,0:21:49.38,kono-text-jp,,0000,0000,0000,,Мен тек тұқымын іштім.
Dialogue: 0,0:21:49.89,0:21:51.02,kono-text-jp,,0000,0000,0000,,Ауызды тазарту
Dialogue: 0,0:21:53.22,0:21:54.23,kono-text-jp,,0000,0000,0000,,Ум
Dialogue: 0,0:21:54.41,0:21:56.97,kono-text-jp,,0000,0000,0000,,Біз алдымен бір жерде кездестік пе?
Dialogue: 0,0:21:58.78,0:22:01.36,kono-text-jp,,0000,0000,0000,,Есіңде жоқ па, қашан кездескеніміз?
Dialogue: 0,0:22:01.63,0:22:05.60,kono-text-jp,,0000,0000,0000,,Кешіріңіз, мен жай ғана назардан тыс қалдым.
Dialogue: 0,0:22:05.66,0:22:07.56,kono-text-jp,,0000,0000,0000,,Таң атқаннан бері көп уақыт өтті.
Dialogue: 0,0:22:09.74,0:22:12.47,kono-text-jp,,0000,0000,0000,,Ертеде де мең болған.
Dialogue: 0,0:22:45.81,0:22:49.43,kono-text-jp,,0000,0000,0000,,Құдық астында коммуналдық шатыр бар.
Dialogue: 0,0:22:49.56,0:22:50.12,kono-text-jp,,0000,0000,0000,,Сәлем...
Dialogue: 0,0:23:15.74,0:23:20.80,kono-text-jp,,0000,0000,0000,,Солтүстік…Өнер…
Dialogue: 0,0:23:28.11,0:23:29.28,kono-text-jp,,0000,0000,0000,,Умм
Dialogue: 0,0:23:29.95,0:23:35.69,kono-text-jp,,0000,0000,0000,,Бұл Күре қаласындағы қандай қала және нөмір?
Dialogue: 0,0:23:37.16,0:23:37.78,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,0:23:37.95,0:23:38.91,kono-text-jp,,0000,0000,0000,,Хожано
Dialogue: 0,0:23:39.69,0:23:40.88,kono-text-jp,,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:23:42.46,0:23:46.67,kono-text-jp,,0000,0000,0000,,Мен бұл жердегілердің бәрі Әскери-теңіз флотында жұмыс істей ме деп ойлаймын.
Dialogue: 0,0:23:56.70,0:23:58.07,kono-text-jp,,0000,0000,0000,,Ходжо мырза
Dialogue: 0,0:24:01.62,0:24:02.94,kono-text-jp,,0000,0000,0000,,Ходжо мырза
Dialogue: 0,0:24:02.95,0:24:04.04,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,0:24:04.30,0:24:05.71,kono-text-jp,,0000,0000,0000,,Тарату баж салығы?
Dialogue: 0,0:24:05.71,0:24:10.33,kono-text-jp,,0000,0000,0000,,Бұл жерде және мұнда әрқашан солай бола бермейді.
Dialogue: 0,0:24:10.81,0:24:12.24,kono-text-jp,,0000,0000,0000,,Көмегің үшін рахмет
Dialogue: 0,0:24:12.55,0:24:13.31,kono-text-jp,,0000,0000,0000,,Бұл Чита
Dialogue: 0,0:24:13.32,0:24:14.31,kono-text-jp,,0000,0000,0000,,Бұл Қария
Dialogue: 0,0:24:19.56,0:24:20.66,kono-text-jp,,0000,0000,0000,,Қайта кездескенше
Dialogue: 0,0:24:20.91,0:24:22.72,kono-text-jp,,0000,0000,0000,,Сіз оны дұрыс өлшемейсіз бе?
Dialogue: 0,0:24:23.11,0:24:25.15,kono-text-jp,,0000,0000,0000,,Егер сіз көз өлшемдері туралы айтып жатсаңыз, сіздікі не?
Dialogue: 0,0:24:25.15,0:24:25.85,kono-text-jp,,0000,0000,0000,,Жоқ.
Dialogue: 0,0:24:25.85,0:24:27.03,kono-text-jp,,0000,0000,0000,,Бұл әділ емес.
Dialogue: 0,0:24:27.04,0:24:28.20,kono-text-jp,,0000,0000,0000,,Алайда операция бастапқы сәттен бастап сәтсіздікке ұшыраудың аз-ақ алдында болды.
Dialogue: 0,0:24:28.35,0:24:29.23,kono-text-jp,,0000,0000,0000,,Мүлдем
Dialogue: 0,0:24:29.63,0:24:30.56,kono-text-jp,,0000,0000,0000,,Не?
Dialogue: 0,0:24:30.68,0:24:33.44,kono-text-jp,,0000,0000,0000,,Маған сенің айтқаның ұнамайды.
Dialogue: 0,0:24:33.45,0:24:34.73,kono-text-jp,,0000,0000,0000,,Қайда?
Dialogue: 0,0:24:35.11,0:24:36.81,kono-text-jp,,0000,0000,0000,,Ахахха жас жас
Dialogue: 0,0:24:36.82,0:24:38.29,kono-text-jp,,0000,0000,0000,,Сіз құлап қалдыңыз.
Dialogue: 0,0:24:45.49,0:24:46.63,kono-text-jp,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:24:47.17,0:24:50.08,kono-text-jp,,0000,0000,0000,,Оның орасан зор екенін айтпай кете алмаймын.
Dialogue: 0,0:24:50.64,0:24:52.82,kono-text-jp,,0000,0000,0000,,Егер тұтандырғыш бомба түссе
Dialogue: 0,0:24:53.07,0:24:56.71,kono-text-jp,,0000,0000,0000,,Талап етілетін нәрсе, ең алдымен, әдепті әрекет.
Dialogue: 0,0:24:57.44,0:24:59.31,kono-text-jp,,0000,0000,0000,,Жақын кел!
Dialogue: 0,0:25:00.02,0:25:02.13,kono-text-jp,,0000,0000,0000,,Бұл орындық суық болуы мүмкін емес.
Dialogue: 0,0:25:03.37,0:25:03.87,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,0:25:05.65,0:25:08.25,kono-text-jp,,0000,0000,0000,,Бұл менің күнделікті өміріме айналды.
Dialogue: 0,0:25:19.85,0:25:23.24,kono-text-jp,,0000,0000,0000,,Әй, бұл Кейконың қызының киімі.
Dialogue: 0,0:25:23.60,0:25:25.08,kono-text-jp,,0000,0000,0000,,Бұл да қойма бөлмесі.
Dialogue: 0,0:25:25.72,0:25:30.02,kono-text-jp,,0000,0000,0000,,Соны киіп, күйеу баламмен бірге шықтым.
Dialogue: 0,0:25:30.42,0:25:35.06,kono-text-jp,,0000,0000,0000,,Кино көру, батыс мейрамханаларына бару, эксполарға бару.
Dialogue: 0,0:25:37.50,0:25:40.54,kono-text-jp,,0000,0000,0000,,Бұл Мога, жеңгем еді.
Dialogue: 0,0:25:41.21,0:25:43.93,kono-text-jp,,0000,0000,0000,,Бұл әлі жалғыз дүние еді.
Dialogue: 0,0:25:44.95,0:25:46.76,kono-text-jp,,0000,0000,0000,,Шусаку 4 жаста болғанда
Dialogue: 0,0:25:47.04,0:25:50.79,kono-text-jp,,0000,0000,0000,,Бейбітшілік үшін қарусыздану соғыс кемелерін жасауды мүмкін етпеді.
Dialogue: 0,0:25:52.03,0:25:55.81,kono-text-jp,,0000,0000,0000,,Менің халқым да осы жерде жұмыссыз.
Dialogue: 0,0:25:56.03,0:25:57.77,kono-text-jp,,0000,0000,0000,,Бұл маңызды болды.
Dialogue: 0,0:25:58.39,0:26:00.62,kono-text-jp,,0000,0000,0000,,Кейко дәл осындай қыз.
Dialogue: 0,0:26:00.62,0:26:04.87,kono-text-jp,,0000,0000,0000,,Өзіңіздің жұмысыңызды шешіп, күйеуіңізді өзіңіз табыңыз.
Dialogue: 0,0:26:06.47,0:26:09.23,kono-text-jp,,0000,0000,0000,,Қаласам, жеңіліп қалмас үшін көп еңбектенемін.
Dialogue: 0,0:26:11.14,0:26:14.55,kono-text-jp,,0000,0000,0000,,Маңызды деп ойлаған күндер
Dialogue: 0,0:26:14.86,0:26:15.76,kono-text-jp,,0000,0000,0000,,Аман болсын
Dialogue: 0,0:26:15.76,0:26:18.93,kono-text-jp,,0000,0000,0000,,Маңызды деп ойлаған күндерді сағындым.
Dialogue: 0,0:26:28.00,0:26:29.77,kono-text-jp,,0000,0000,0000,,А, сәлем
Dialogue: 0,0:26:30.70,0:26:31.56,kono-text-jp,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:26:31.93,0:26:34.84,kono-text-jp,,0000,0000,0000,,Әй, қош келдің, жеңге.
Dialogue: 0,0:26:37.96,0:26:38.66,kono-text-jp,,0000,0000,0000,,Саен
Dialogue: 0,0:26:41.26,0:26:44.82,kono-text-jp,,0000,0000,0000,,Бүгінгі күріш бағалы бұйым емес.
Dialogue: 0,0:26:45.14,0:26:46.17,kono-text-jp,,0000,0000,0000,,Бұл сіз туралы.
Dialogue: 0,0:26:47.26,0:26:50.59,kono-text-jp,,0000,0000,0000,,Хиросимадан келген бала кезімде мен одан құтыламын деп ойладым.
Dialogue: 0,0:26:51.09,0:26:53.87,kono-text-jp,,0000,0000,0000,,Барлық патчворктерде не бар?
Dialogue: 0,0:26:54.36,0:26:56.06,kono-text-jp,,0000,0000,0000,,Қуырылған бұршақ
Dialogue: 0,0:26:56.24,0:26:58.76,kono-text-jp,,0000,0000,0000,,Иә, Харуми-чан, қош келдіңіз.
Dialogue: 0,0:26:58.89,0:27:01.96,kono-text-jp,,0000,0000,0000,,Анаңның көңіл-күйі нашар деп уайымдама.
Dialogue: 0,0:27:02.40,0:27:03.96,kono-text-jp,,0000,0000,0000,,Харуми Отонашюушиторун
Dialogue: 0,0:27:03.96,0:27:07.27,kono-text-jp,,0000,0000,0000,,Кешіріңіз, менде қазір осы ғана
Dialogue: 0,0:27:07.34,0:27:08.61,kono-text-jp,,0000,0000,0000,,Қазір жасаңыз
Dialogue: 0,0:27:13.02,0:27:15.15,kono-text-jp,,0000,0000,0000,,Сондай-ақ, ол күріш кәдесыйдан ерекшеленеді.
Dialogue: 0,0:27:15.34,0:27:17.07,kono-text-jp,,0000,0000,0000,,Бұл маған және қызыма арналған.
Dialogue: 0,0:27:19.23,0:27:20.75,kono-text-jp,,0000,0000,0000,,Хойде Кейко
Dialogue: 0,0:27:21.00,0:27:22.57,kono-text-jp,,0000,0000,0000,,Тыңдашы, анашым.
Dialogue: 0,0:27:22.57,0:27:25.56,kono-text-jp,,0000,0000,0000,,Сіз өте әлсіз көрінесіз.
Dialogue: 0,0:27:27.49,0:27:27.96,kono-text-jp,,0000,0000,0000,,Ауырды
Dialogue: 0,0:27:28.37,0:27:30.91,kono-text-jp,,0000,0000,0000,,Бұл басқа, бұл басқа.
Dialogue: 0,0:27:31.08,0:27:34.48,kono-text-jp,,0000,0000,0000,,Сен сондай жаман болсаң, маған үйлен.
Dialogue: 0,0:27:34.65,0:27:36.39,kono-text-jp,,0000,0000,0000,,Иә, мен бармаймын.
Dialogue: 0,0:27:43.97,0:27:47.08,kono-text-jp,,0000,0000,0000,,Міне, мен келдім.
Dialogue: 0,0:27:48.21,0:27:49.61,kono-text-jp,,0000,0000,0000,,А, мен түсіндім.
Dialogue: 0,0:28:05.10,0:28:07.10,kono-text-jp,,0000,0000,0000,,Бұны шешіңіз
Dialogue: 0,0:28:07.70,0:28:09.04,kono-text-jp,,0000,0000,0000,,Тағы да төреші
Dialogue: 0,0:28:09.62,0:28:11.67,kono-text-jp,,0000,0000,0000,,Бірге тігу
Dialogue: 0,0:28:12.93,0:28:15.48,kono-text-jp,,0000,0000,0000,,Резеңкені оның ішінен өткізіп, орындалады.
Dialogue: 0,0:28:15.72,0:28:16.64,kono-text-jp,,0000,0000,0000,,Жарайды, жарайды
Dialogue: 0,0:28:20.33,0:28:21.87,kono-text-jp,,0000,0000,0000,,Бұл Харуми Куромура.
Dialogue: 0,0:28:21.87,0:28:23.95,kono-text-jp,,0000,0000,0000,,Сәлем, бұл Сузу Ходжо.
Dialogue: 0,0:28:25.37,0:28:27.19,kono-text-jp,,0000,0000,0000,,Сузу-сан, маған жіпті бер
Dialogue: 0,0:28:28.31,0:28:29.62,kono-text-jp,,0000,0000,0000,,Бұл жақсы ма?
Dialogue: 0,0:28:47.16,0:28:49.09,kono-text-jp,,0000,0000,0000,,Сузу-санның тапсырмасы
Dialogue: 0,0:28:49.26,0:28:50.76,kono-text-jp,,0000,0000,0000,,Иә, тарату орталығына
Dialogue: 0,0:28:51.47,0:28:54.96,kono-text-jp,,0000,0000,0000,,Кеттік, мен саған рацион билеті мен әмиянды қарызға беремін.
Dialogue: 0,0:28:55.50,0:28:57.67,kono-text-jp,,0000,0000,0000,,Иә, өтінемін.
Dialogue: 0,0:29:12.31,0:29:13.46,kono-text-jp,,0000,0000,0000,,Қайтадан қош келдіңіз
Dialogue: 0,0:29:18.81,0:29:20.68,kono-text-jp,,0000,0000,0000,,Иә, мен мұны істеймін.
Dialogue: 0,0:29:30.02,0:29:32.23,kono-text-jp,,0000,0000,0000,,Сәлем анашым
Dialogue: 0,0:29:34.51,0:29:35.77,kono-text-jp,,0000,0000,0000,,Иә, иә
Dialogue: 0,0:29:36.24,0:29:37.07,kono-text-jp,,0000,0000,0000,,Не?
Dialogue: 0,0:29:37.07,0:29:38.90,kono-text-jp,,0000,0000,0000,,Бұл сорпаның жемісі.
Dialogue: 0,0:29:57.11,0:30:00.09,kono-text-jp,,0000,0000,0000,,О, Кейко мен Харуми келе жатыр ма?
Dialogue: 0,0:30:00.46,0:30:01.32,kono-text-jp,,0000,0000,0000,,Екі адам?
Dialogue: 0,0:30:01.49,0:30:02.96,kono-text-jp,,0000,0000,0000,,Қош келдіңіз әке
Dialogue: 0,0:30:03.05,0:30:04.82,kono-text-jp,,0000,0000,0000,,Ал, сабыр етіңіз.
Dialogue: 0,0:30:06.91,0:30:11.27,kono-text-jp,,0000,0000,0000,,Ерекше Әпкем пісірген күріш көп күйген жоқ.
Dialogue: 0,0:30:11.83,0:30:13.68,kono-text-jp,,0000,0000,0000,,Міне, Шусаку
Dialogue: 0,0:30:13.50,0:30:15.86,kono-text-jp-2,,0000,0000,0000,,Итатата
Dialogue: 0,0:30:13.75,0:30:15.86,kono-text-jp,,0000,0000,0000,,Анау қайын сіңлі
Dialogue: 0,0:30:16.27,0:30:19.44,kono-text-jp,,0000,0000,0000,,Сіздің арқаңызда кимононы дәл осылай жөндеп алдым.
Dialogue: 0,0:30:20.49,0:30:22.20,kono-text-jp,,0000,0000,0000,,Иә Жоқ
Dialogue: 0,0:30:22.78,0:30:25.08,kono-text-jp,,0000,0000,0000,,Сенің анаңның аяғы ауыр болғандықтан.
Dialogue: 0,0:30:25.54,0:30:29.44,kono-text-jp,,0000,0000,0000,,Сендей баланы мен танымайтын елге әкелгенім үшін.
Dialogue: 0,0:30:29.94,0:30:33.13,kono-text-jp,,0000,0000,0000,,Мен осында мәңгі қалсам ғой.
Dialogue: 0,0:30:34.40,0:30:37.86,kono-text-jp,,0000,0000,0000,,Сузу-сан, мен Хиросимаға қайтып келгенде
Dialogue: 0,0:30:40.81,0:30:41.92,kono-text-jp,,0000,0000,0000,,Дұрыс.
Dialogue: 0,0:30:47.42,0:30:48.77,kono-text-jp,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:30:49.17,0:30:50.75,kono-text-jp,,0000,0000,0000,,Уф, мен шаршадым.
Dialogue: 0,0:30:50.89,0:30:51.93,kono-text-jp,,0000,0000,0000,,Қайтадан қош келдіңіз
Dialogue: 0,0:30:52.92,0:30:54.74,kono-text-jp,,0000,0000,0000,,Аа, сағат 8 болып қалды.
Dialogue: 0,0:30:54.95,0:30:56.85,kono-text-jp,,0000,0000,0000,,Бүгінгі таңда одан да көп.
Dialogue: 0,0:30:58.25,0:30:59.84,kono-text-jp,,0000,0000,0000,,Мұның бәрі мың ине ме?
Dialogue: 0,0:30:59.87,0:31:02.62,kono-text-jp,,0000,0000,0000,,Эй, Суми, кейінге сақтап қой.
Dialogue: 0,0:31:04.18,0:31:06.13,kono-text-jp,,0000,0000,0000,,Сузу, оян!
Dialogue: 0,0:31:06.80,0:31:08.04,kono-text-jp,,0000,0000,0000,,Өрмектей өрілген тағдырлар
Dialogue: 0,0:31:10.36,0:31:12.03,kono-text-jp,,0000,0000,0000,,Жүр, қазір кешкі ас ішейік.
Dialogue: 0,0:31:13.07,0:31:17.85,kono-text-jp,,0000,0000,0000,,Аа, мен қатты қобалжыдым. Күреге үйленемін деп армандадым.
Dialogue: 0,0:31:19.67,0:31:21.26,kono-text-jp,,0000,0000,0000,,Сіз ояусыз ба?
Dialogue: 0,0:31:20.72,0:31:21.31,kono-text-jp-2,,0000,0000,0000,,Иә
Dialogue: 0,0:31:21.97,0:31:26.05,kono-text-jp,,0000,0000,0000,,Жүр, менің жеңгем Хиросимаға қайтуды айтты.
Dialogue: 0,0:31:27.16,0:31:29.18,kono-text-jp,,0000,0000,0000,,Сіз не айтып жатырсыз деп ойладым.
Dialogue: 0,0:31:29.65,0:31:31.11,kono-text-jp,,0000,0000,0000,,Ах, үйге қайту
Dialogue: 0,0:31:31.85,0:31:33.93,kono-text-jp,,0000,0000,0000,,Хотара, қайын ата, қайын ене де
Dialogue: 0,0:31:34.41,0:31:36.88,kono-text-jp,,0000,0000,0000,,«Осы уақытқа дейін мұқият болғаным үшін менің кінәм болды».
Dialogue: 0,0:31:37.85,0:31:41.05,kono-text-jp,,0000,0000,0000,,Маған айтыңызшы, бірнеше күн жеңіл жүріңіз.
Dialogue: 0,0:31:41.30,0:31:42.17,kono-text-jp,,0000,0000,0000,,Жездем де
Dialogue: 0,0:31:43.81,0:31:46.76,kono-text-jp,,0000,0000,0000,,Осыған иә деп жауап берсең жақсы болар еді.
Dialogue: 0,0:31:48.10,0:31:50.60,kono-text-jp,,0000,0000,0000,,Айтпақшы, сіз Йоичиге ашықхат жібердіңіз бе?
Dialogue: 0,0:31:50.69,0:31:52.01,kono-text-jp,,0000,0000,0000,,Үй? шығару
Dialogue: 0,0:31:52.58,0:31:54.84,kono-text-jp,,0000,0000,0000,,Әлі жауап жоқ...
Dialogue: 0,0:31:55.92,0:31:57.42,kono-text-jp,,0000,0000,0000,,Үйге де
Dialogue: 0,0:31:59.77,0:32:01.03,kono-text-jp,,0000,0000,0000,,Ал, бұл алыс.
Dialogue: 0,0:32:01.09,0:32:03.16,kono-text-jp,,0000,0000,0000,,Онии-чан жалқау
Dialogue: 0,0:32:03.75,0:32:06.52,kono-text-jp,,0000,0000,0000,,Сузу қолы дұрыс емес болуы мүмкін.
Dialogue: 0,0:32:07.73,0:32:09.62,kono-text-jp,,0000,0000,0000,,Ваннаға арналған ванна
Dialogue: 0,0:32:09.99,0:32:12.02,kono-text-jp,,0000,0000,0000,,Суми-чанның қандай еріктілер корпусы бар?
Dialogue: 0,0:32:12.03,0:32:13.32,kono-text-jp,,0000,0000,0000,,Мен бұған әбден үйреніп қалдым
Dialogue: 0,0:32:13.67,0:32:15.99,kono-text-jp,,0000,0000,0000,,Машина майының иісі бар.
Dialogue: 0,0:32:16.39,0:32:19.18,kono-text-jp,,0000,0000,0000,,Бұл қауіпті жұмыс, солай емес пе?
Dialogue: 0,0:32:19.52,0:32:22.53,kono-text-jp,,0000,0000,0000,,Теңіз балдыры сияқты суық емес.
Dialogue: 0,0:32:22.64,0:32:23.90,kono-text-jp,,0000,0000,0000,,Иә, кейде.
Dialogue: 0,0:32:24.25,0:32:28.90,kono-text-jp,,0000,0000,0000,,Әдемі әскери офицер маған жасырын түрде асханаға билет берді.
Dialogue: 0,0:32:28.90,0:32:30.04,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,0:32:30.23,0:32:32.95,kono-text-jp,,0000,0000,0000,,Мен күтпеген жерден әскердің қыр-сырын білдім.
Dialogue: 0,0:32:33.33,0:32:34.87,kono-text-jp,,0000,0000,0000,,Сузу-чан ше?
Dialogue: 0,0:32:35.43,0:32:36.79,kono-text-jp,,0000,0000,0000,,Ву Те Иә?
Dialogue: 0,0:32:38.58,0:32:40.93,kono-text-jp,,0000,0000,0000,,Есте қалар әлі көп нәрсе бар
Dialogue: 0,0:32:42.74,0:32:46.24,kono-text-jp,,0000,0000,0000,,енді күтпеген жерден шықты
Dialogue: 0,0:32:46.27,0:32:49.39,kono-text-jp,,0000,0000,0000,,Әскери-теңіз құпияларына қол жеткізгісі келетіндей болдым.
Dialogue: 0,0:32:49.46,0:32:50.37,kono-text-jp,,0000,0000,0000,,Оны тежеуге шамамыз жетпейді
Dialogue: 0,0:32:50.39,0:32:51.14,kono-text-jp,,0000,0000,0000,,Енді ұйықтайық
Dialogue: 0,0:32:53.62,0:32:54.75,kono-text-jp,,0000,0000,0000,,Сузу-чан
Dialogue: 0,0:32:54.85,0:32:55.35,kono-text-jp,,0000,0000,0000,,Иә?
Dialogue: 0,0:32:56.32,0:32:58.73,kono-text-jp,,0000,0000,0000,,Сізде тақырлар пайда болады.
Dialogue: 0,0:33:01.29,0:33:04.31,kono-text-jp,,0000,0000,0000,,Көріскенше, Сузу-чан, мен барамын.
Dialogue: 0,0:33:05.22,0:33:07.13,kono-text-jp,,0000,0000,0000,,Шешуші ұрыстағы төтенше шаралар!
Dialogue: 0,0:33:07.25,0:33:10.77,kono-text-jp,,0000,0000,0000,,Ай өзгерсе, тіпті қысқа сапарларға да шектеу қойылады.
Dialogue: 0,0:33:11.34,0:33:12.20,kono-text-jp,,0000,0000,0000,,Көңіл күйде
Dialogue: 0,0:33:13.80,0:33:16.61,kono-text-jp,,0000,0000,0000,,Енді мен әйелдер қауымдастығына жұмысқа баруым керек.
Dialogue: 0,0:33:16.83,0:33:19.44,kono-text-jp,,0000,0000,0000,,Е, анам да шығып жатыр.
Dialogue: 0,0:33:34.42,0:33:37.53,kono-text-jp,,0000,0000,0000,,Әкем маған қалталы ақша берді.
Dialogue: 0,0:34:09.53,0:34:10.45,kono-text-jp,,0000,0000,0000,,Мен күте тұр дедім ғой, иә?
Dialogue: 0,0:34:12.43,0:34:13.86,kono-text-jp,,0000,0000,0000,,Қош бол Хиросима
Dialogue: 0,0:34:20.45,0:34:22.48,kono-text-jp,,0000,0000,0000,,Сіз қайтып келдіңіз бе?
Dialogue: 0,0:34:23.03,0:34:25.88,kono-text-jp,,0000,0000,0000,,Ол жақтағыларға жаным ашиды.
Dialogue: 0,0:34:33.72,0:34:35.24,kono-text-jp,,0000,0000,0000,,А, мен үйдемін.
Dialogue: 0,0:34:37.54,0:34:39.91,kono-text-jp,,0000,0000,0000,,Менің жеңгем үнемі осында.
Dialogue: 0,0:34:43.82,0:34:45.04,kono-text-jp,,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:34:45.32,0:34:47.03,kono-text-jp,,0000,0000,0000,,Эй, маған Сузури беріңізші.
Dialogue: 0,0:34:47.33,0:34:48.85,kono-text-jp,,0000,0000,0000,,Бұл не, Харуми?
Dialogue: 0,0:34:49.62,0:34:51.07,kono-text-jp,,0000,0000,0000,,Эй, оны маған қарызға бер.
Dialogue: 0,0:34:51.70,0:34:55.03,kono-text-jp,,0000,0000,0000,,Эй, Сузу-сан, сен Харумиге не дедің?
Dialogue: 0,0:34:57.12,0:35:00.02,kono-text-jp,,0000,0000,0000,,Дөңгелек тақтаны қайта бұра аласыз ба?
Dialogue: 0,0:35:00.37,0:35:01.34,kono-text-jp,,0000,0000,0000,,Өтінемін
Dialogue: 0,0:35:02.92,0:35:03.98,kono-text-jp,,0000,0000,0000,,I'm going
Dialogue: 0,0:35:04.35,0:35:07.95,kono-text-jp,,0000,0000,0000,,Хиросимадан қайтып келгеннен бері мен А-Джагаға құмар болдым.
Dialogue: 0,0:35:08.45,0:35:10.37,kono-text-jp,,0000,0000,0000,,Әй, мен әлі баламын.
Dialogue: 0,0:35:10.45,0:35:12.89,kono-text-jp,,0000,0000,0000,,Эй, көп рахмет.
Dialogue: 0,0:35:14.78,0:35:16.35,kono-text-jp,,0000,0000,0000,,Жоқ десең
Dialogue: 0,0:35:16.64,0:35:17.73,kono-text-jp,,0000,0000,0000,,Эй, оны маған қарызға бер.
Dialogue: 0,0:35:18.34,0:35:21.00,kono-text-jp,,0000,0000,0000,,Сізге бұл қажет емес.
Dialogue: 0,0:35:45.36,0:35:46.28,kono-text-jp,,0000,0000,0000,,Қайтадан қош келдіңіз
Dialogue: 0,0:35:48.20,0:35:49.98,kono-text-jp,,0000,0000,0000,,Сіз шөп тердіңіз бе?
Dialogue: 0,0:35:51.45,0:35:53.79,kono-text-jp,,0000,0000,0000,,Мен оны кешкі асқа гарнир деп ойлаймын.
Dialogue: 0,0:35:55.76,0:35:58.45,kono-text-jp,,0000,0000,0000,,Бұл жердегі бәйшешектердің бәрі ақ түсті.
Dialogue: 0,0:35:59.08,0:36:00.73,kono-text-jp,,0000,0000,0000,,Энами басқа емес пе?
Dialogue: 0,0:36:01.50,0:36:03.70,kono-text-jp,,0000,0000,0000,,Әй, сарысы да бар.
Dialogue: 0,0:36:06.64,0:36:08.62,kono-text-jp,,0000,0000,0000,,Олар алыстан келген шығар.
Dialogue: 0,0:36:10.82,0:36:13.52,kono-text-jp,,0000,0000,0000,,Неге, мен өзімді жақсы сезінбеймін.
Dialogue: 0,0:36:13.81,0:36:15.41,kono-text-jp,,0000,0000,0000,,Хиросимаға ғашық болдыңыз ба?
Dialogue: 0,0:36:15.78,0:36:16.76,kono-text-jp,,0000,0000,0000,,Наторан
Dialogue: 0,0:36:23.48,0:36:25.03,kono-text-jp,,0000,0000,0000,,Мынаны қараңыз!
Dialogue: 0,0:36:25.45,0:36:27.03,kono-text-jp,,0000,0000,0000,,Сондай-ақ бүгінде ұшақ тасығыш бар.
Dialogue: 0,0:36:27.58,0:36:29.44,kono-text-jp,,0000,0000,0000,,Хитака және Джунтака Кану
Dialogue: 0,0:36:29.59,0:36:30.68,kono-text-jp,,0000,0000,0000,,Үлкен
Dialogue: 0,0:36:32.21,0:36:34.44,kono-text-jp,,0000,0000,0000,,Мұндағы барлық шағын кемелер эсминецтер.
Dialogue: 0,0:36:34.87,0:36:36.86,kono-text-jp,,0000,0000,0000,,Сондай-ақ Германиядан келген су қайықтары бар.
Dialogue: 0,0:36:37.23,0:36:40.58,kono-text-jp,,0000,0000,0000,,Бұл кәдімгі кемеге ұқсас нәрсе - суасты қайықтарының тендері.
Dialogue: 0,0:36:45.49,0:36:47.26,kono-text-jp,,0000,0000,0000,,Қараңдаршы, ақ көз ұшып келеді
Dialogue: 0,0:36:48.44,0:36:50.77,kono-text-jp,,0000,0000,0000,,Қараңдар, қараңдар!
Dialogue: 0,0:36:50.77,0:36:51.89,kono-text-jp,,0000,0000,0000,,Мен қараймын
Dialogue: 0,0:36:54.25,0:36:57.37,kono-text-jp,,0000,0000,0000,,А, Шусаку-сан, бұл не?
Dialogue: 0,0:36:57.78,0:36:59.32,kono-text-jp,,0000,0000,0000,,Бұл кеме ме?
Dialogue: 0,0:36:59.71,0:37:00.59,kono-text-jp,,0000,0000,0000,,Ямато
Dialogue: 0,0:37:01.75,0:37:05.31,kono-text-jp,,0000,0000,0000,,Дүние жүзіндегі ең үлкен әскери кеме Шығыстағы ең үлкен әскери портта дүниеге келді.
Dialogue: 0,0:37:06.13,0:37:08.88,kono-text-jp,,0000,0000,0000,,күрсіну. Оны да адамдар алып жатыр ма?
Dialogue: 0,0:37:09.24,0:37:09.99,kono-text-jp,,0000,0000,0000,,О
Dialogue: 0,0:37:13.09,0:37:14.83,kono-text-jp,,0000,0000,0000,,Шамамен 2700 адам
Dialogue: 0,0:37:14.92,0:37:17.00,kono-text-jp-2,,0000,0000,0000,,Маршқа дайындалу Маршқа дайындалу
Dialogue: 0,0:37:18.05,0:37:20.95,kono-text-jp,,0000,0000,0000,,2700 адам
Dialogue: 0,0:37:21.39,0:37:22.43,kono-text-jp,,0000,0000,0000,,Жарайды, бірінші кім?
Dialogue: 0,0:37:22.90,0:37:25.19,kono-text-jp,,0000,0000,0000,,"Күреге қайта қош келдіңіз" деп айтыңыз, Сузу-сан.
Dialogue: 0,0:37:27.77,0:37:31.95,kono-text-jp,,0000,0000,0000,,Мен сол жердегі адамдарға күнде тамақ әзірлеймін.
Dialogue: 0,0:37:31.95,0:37:32.46,kono-text-jp,,0000,0000,0000,,Сузу-сан
Dialogue: 0,0:37:32.46,0:37:33.64,kono-text-jp,,0000,0000,0000,,Кір туралы не деуге болады?
Dialogue: 0,0:37:38.92,0:37:41.67,kono-text-jp,,0000,0000,0000,,Кешіріңіз. Сенімен бәрі жақсы ма?
Dialogue: 0,0:37:41.86,0:37:42.39,kono-text-jp,,0000,0000,0000,,Жоқ
Dialogue: 0,0:37:43.44,0:37:44.49,kono-text-jp,,0000,0000,0000,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:37:54.55,0:37:55.90,kono-text-jp,,0000,0000,0000,,Сузу Ноу
Dialogue: 0,0:37:56.08,0:37:58.95,kono-text-jp,,0000,0000,0000,,Осыны уайымдасаң, тақырлығың нашарлайды.
Dialogue: 0,0:37:59.18,0:38:00.90,kono-text-jp,,0000,0000,0000,,Сіз ұсталдыңыз ба?
Dialogue: 0,0:38:01.40,0:38:03.36,kono-text-jp,,0000,0000,0000,,Әй, қылқаламды маған қарызға бер.
Dialogue: 0,0:38:03.49,0:38:06.28,kono-text-jp,,0000,0000,0000,,Мен Сузудың басына сия тігемін.
Dialogue: 0,0:38:06.40,0:38:07.78,kono-text-jp,,0000,0000,0000,,Икенчуутара
Dialogue: 0,0:38:07.78,0:38:10.34,kono-text-jp,,0000,0000,0000,,Осы уақытқа дейін бәрін қаралайтыныңызға сенімдімін, бірақ сіз...
Dialogue: 0,0:38:12.79,0:38:16.32,kono-text-jp,,0000,0000,0000,,Ақырында қайынсіңлің де тұрмысқа шыққан жеріне қайтады.
Dialogue: 0,0:38:16.82,0:38:19.02,kono-text-jp,,0000,0000,0000,,Енді кешкі асқа дайындалайық.
Dialogue: 0,0:38:19.75,0:38:22.93,kono-text-jp,,0000,0000,0000,,Осыны ойлағанымда рацион айтарлықтай азайып кетті.
Dialogue: 0,0:38:24.21,0:38:28.26,kono-text-jp,,0000,0000,0000,,4 кептірілген сардина 4 адамнан тұратын отбасына 3 мезгіл тамақ береді
Dialogue: 0,0:38:29.68,0:38:32.08,kono-text-jp,,0000,0000,0000,,Тек көкөніспен күн өткеннен де жақсы.
Dialogue: 0,0:38:32.44,0:38:35.46,kono-text-jp,,0000,0000,0000,,Егер сіз Kokee-ді сапқа тұрғызсаңыз, сіз ақырында Unohana-ны сатып алуыңыз мүмкін.
Dialogue: 0,0:38:36.59,0:38:37.67,kono-text-jp,,0000,0000,0000,,А, мен түсіндім.
Dialogue: 0,0:38:39.51,0:38:43.36,kono-text-jp,,0000,0000,0000,,Күлгін балапан жылқықұйрығы
Dialogue: 0,0:38:44.11,0:38:49.63,kono-text-jp,,0000,0000,0000,,Одуванчик оксалис Кептірілген сардиналар Unohana картоп картоп
Dialogue: 0,0:38:49.85,0:38:51.95,kono-text-jp,,0000,0000,0000,,Ұн Умебоши тұқымдары
Dialogue: 0,0:38:54.85,0:38:57.42,kono-text-jp,,0000,0000,0000,,Тәтті картопты турап, бумен пісіріңіз
Dialogue: 0,0:38:57.82,0:39:00.85,kono-text-jp,,0000,0000,0000,,Жылқы құйрығын аздап қайнатып, суға салып, тураңыз.
Dialogue: 0,0:39:01.22,0:39:03.81,kono-text-jp,,0000,0000,0000,,Ұнды тәтті картоп пен қырықбуынмен араластырыңыз
Dialogue: 0,0:39:03.98,0:39:05.13,kono-text-jp,,0000,0000,0000,,Тегіс айналдырыңыз
Dialogue: 0,0:39:05.40,0:39:07.00,kono-text-jp,,0000,0000,0000,,Түскі ас дайын
Dialogue: 0,0:39:07.18,0:39:09.50,kono-text-jp,,0000,0000,0000,,Кейко және басқаларсыз тыныш.
Dialogue: 0,0:39:09.84,0:39:12.05,kono-text-jp,,0000,0000,0000,,Артық бөшке кептіру арқылы сақталуы керек.
Dialogue: 0,0:39:13.73,0:39:14.99,kono-text-jp,,0000,0000,0000,,Келіңіздер, әлі жоқ.
Dialogue: 0,0:39:15.70,0:39:18.98,kono-text-jp,,0000,0000,0000,,Күрішті 5 рет сумен сұйылтып, ботқа ретінде қолданыңыз.
Dialogue: 0,0:39:19.86,0:39:23.00,kono-text-jp,,0000,0000,0000,,Туралған картопты қосып, тағы 10 минут пісіріңіз.
Dialogue: 0,0:39:24.06,0:39:26.01,kono-text-jp,,0000,0000,0000,,Туралған балапаны қосыңыз
Dialogue: 0,0:39:26.77,0:39:29.41,kono-text-jp,,0000,0000,0000,,Шалғам терісі Одуванчик тамыры
Dialogue: 0,0:39:29.62,0:39:32.08,kono-text-jp,,0000,0000,0000,,Жолақтарға кесіп, қант пен соя соусымен қайнатыңыз.
Dialogue: 0,0:39:32.96,0:39:35.02,kono-text-jp,,0000,0000,0000,,Туралған одуванчик жапырақтарын қосыңыз
Dialogue: 0,0:39:35.42,0:39:37.59,kono-text-jp,,0000,0000,0000,,Уноханамен араластырып, әрі қарай пісіріңіз.
Dialogue: 0,0:39:39.69,0:39:43.50,kono-text-jp,,0000,0000,0000,,Шалғамды жұқалап турап, тұз бен Оксалиспен араластырамыз.
Dialogue: 0,0:39:45.40,0:39:47.83,kono-text-jp,,0000,0000,0000,,Умебоши тұқымын және суды кәстрөлге салыңыз.
Dialogue: 0,0:39:47.94,0:39:50.57,kono-text-jp,,0000,0000,0000,,Қайнаған кезде кептірілген сардиналарды қосыңыз.
Dialogue: 0,0:39:50.89,0:39:53.31,kono-text-jp,,0000,0000,0000,,Сорпаны үстіне құйып, бетін ашпай қайнатыңыз.
Dialogue: 0,0:39:53.68,0:39:55.68,kono-text-jp,,0000,0000,0000,,Дәміне қарай тұзбен аяқтаңыз
Dialogue: 0,0:39:55.68,0:39:59.21,kono-text-jp,,0000,0000,0000,,Бұл туралы Қария-санға айта аламын деп ойлаймын.
Dialogue: 0,0:39:59.28,0:40:01.74,kono-text-jp,,0000,0000,0000,,Күріш рационы тек жартысы ғана толы.
Dialogue: 0,0:40:02.02,0:40:03.78,kono-text-jp,,0000,0000,0000,,Көптеген тәтті картоптары бар конги
Dialogue: 0,0:40:03.84,0:40:04.66,kono-text-jp,,0000,0000,0000,,Не?
Dialogue: 0,0:40:04.88,0:40:06.97,kono-text-jp,,0000,0000,0000,,Ертең маған қалдырыңыз.
Dialogue: 0,0:40:07.84,0:40:10.62,kono-text-jp,,0000,0000,0000,,Адал вассал Лорд Кусуноки қоршауға төтеп беруі үшін.
Dialogue: 0,0:40:10.82,0:40:13.62,kono-text-jp,,0000,0000,0000,,Азық-түлікті көбейту әдісін ойлап тапты
Dialogue: 0,0:40:15.57,0:40:18.23,kono-text-jp,,0000,0000,0000,,Алдымен күрішті жақсылап қуырамыз.
Dialogue: 0,0:40:19.34,0:40:23.03,kono-text-jp,,0000,0000,0000,,3 есе көп су құйып, баяу отта баяу пісіріңіз.
Dialogue: 0,0:40:24.83,0:40:28.20,kono-text-jp,,0000,0000,0000,,Жанармай ысырап етсеңіз, күрішті үнемдеу қызықсыз.
Dialogue: 0,0:40:28.81,0:40:33.95,kono-text-jp,,0000,0000,0000,,Бұл Жапон империясының қолайлығы. Оны отсыз пешке қалдырыңыз.
Dialogue: 0,0:40:34.90,0:40:36.22,kono-text-jp,,0000,0000,0000,,Таңды күту
Dialogue: 0,0:40:39.31,0:40:42.67,kono-text-jp,,0000,0000,0000,,Қалған қайнатылған балық сорпасына шегіргүлді қосыңыз.
Dialogue: 0,0:40:42.89,0:40:44.45,kono-text-jp,,0000,0000,0000,,Мисо қосып, қайнатыңыз.
Dialogue: 0,0:40:45.51,0:40:48.36,kono-text-jp,,0000,0000,0000,,Күрішті қайтадан отқа қойып, қайнатыңыз.
Dialogue: 0,0:40:49.11,0:40:50.01,kono-text-jp,,0000,0000,0000,,Аяқтау
Dialogue: 0,0:40:50.70,0:40:53.71,kono-text-jp,,0000,0000,0000,,Бұл Кусуноки-кохан, Кусуноки-комен туыстас.
Dialogue: 0,0:40:54.90,0:40:57.00,kono-text-jp,,0000,0000,0000,,Бұл менің қайын атамның түскі ас қорабы.
Dialogue: 0,0:40:59.81,0:41:01.97,kono-text-jp,,0000,0000,0000,,Бүгін таңертең менде қуырылған күріш көп болды.
Dialogue: 0,0:41:01.96,0:41:03.60,kono-text-jp,,0000,0000,0000,,Күріш дәндері ісінеді
Dialogue: 0,0:41:03.93,0:41:06.14,kono-text-jp,,0000,0000,0000,,Оны дайындаудың әдемі тәсілі бар.
Dialogue: 0,0:41:06.28,0:41:06.81,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,0:41:06.97,0:41:08.55,kono-text-jp,,0000,0000,0000,,Itadadakimasu
Dialogue: 0,0:41:19.18,0:41:19.81,kono-text-jp,,0000,0000,0000,,Кеттік
Dialogue: 0,0:41:19.81,0:41:20.64,kono-text-jp,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:41:20.81,0:41:23.94,kono-text-jp,,0000,0000,0000,,Лорд Кусуноки оны жеуге қуанышты болды.
Dialogue: 0,0:41:24.12,0:41:26.76,kono-text-jp,,0000,0000,0000,,Ол нағыз батыр болуы керек.
Dialogue: 0,0:41:27.56,0:41:29.03,kono-text-jp,,0000,0000,0000,,Мен көрдім.
Dialogue: 0,0:41:31.29,0:41:34.90,kono-text-jp,,0000,0000,0000,,Ескерту сигналын беру
Dialogue: 0,0:41:36.25,0:41:39.42,kono-text-jp,,0000,0000,0000,,Әуе шабуылы туралы ескерту берілді
Dialogue: 0,0:41:46.17,0:41:47.86,kono-text-jp,,0000,0000,0000,,Эфирде ештеңе айтпаңыз
Dialogue: 0,0:41:48.51,0:41:50.73,kono-text-jp,,0000,0000,0000,,Шусаку жұмысқа кетті ме?
Dialogue: 0,0:41:51.05,0:41:51.55,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,0:41:51.72,0:41:54.83,kono-text-jp,,0000,0000,0000,,Қарсыластың күтілетін крейсерлік күшін ескере отырып.
Dialogue: 0,0:41:54.92,0:41:57.03,kono-text-jp,,0000,0000,0000,,Кюсю бірінші рет ең жақсы орын.
Dialogue: 0,0:41:57.62,0:42:00.21,kono-text-jp,,0000,0000,0000,,Мен асығып, осы жердегі тауларға жүгіріп келемін.
Dialogue: 0,0:42:01.86,0:42:03.34,kono-text-jp,,0000,0000,0000,,Бұл жай ғана электр қуатының үзілуі
Dialogue: 0,0:42:06.55,0:42:08.34,kono-text-jp,,0000,0000,0000,,Сіз сәтсіздікке ұшырадыңыз.
Dialogue: 0,0:42:09.12,0:42:11.08,kono-text-jp,,0000,0000,0000,,Ғимаратты эвакуациялау
Dialogue: 0,0:42:12.10,0:42:14.69,kono-text-jp,,0000,0000,0000,,Қала бойынша өрт сөндіру алаңын жасаңыз
Dialogue: 0,0:42:15.79,0:42:18.49,kono-text-jp,,0000,0000,0000,,Менің ойымша, бұл туралы уайымдаудың қажеті жоқ.
Dialogue: 0,0:42:19.19,0:42:20.50,kono-text-jp,,0000,0000,0000,,Бұл қиын, солай емес пе?
Dialogue: 0,0:42:21.08,0:42:23.43,kono-text-jp,,0000,0000,0000,,Барлығы көшетін жер таба ала ма?
Dialogue: 0,0:42:24.27,0:42:25.68,kono-text-jp,,0000,0000,0000,,О, кешіріңіз.
Dialogue: 0,0:42:26.79,0:42:28.01,kono-text-jp,,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:42:29.61,0:42:31.35,kono-text-jp,,0000,0000,0000,,Отын болса, оны да пайдалануға болады.
Dialogue: 0,0:42:32.07,0:42:34.32,kono-text-jp,,0000,0000,0000,,Менің үйім де бұзылды.
Dialogue: 0,0:42:36.35,0:42:39.05,kono-text-jp,,0000,0000,0000,,Үйіңізбен Шимоносэкиге бармаңыз.
Dialogue: 0,0:42:39.91,0:42:41.84,kono-text-jp,,0000,0000,0000,,Иә, мен онымен ажырасуға мүмкіндік бердім.
Dialogue: 0,0:42:41.97,0:42:42.85,kono-text-jp,,0000,0000,0000,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:42:43.72,0:42:47.08,kono-text-jp,,0000,0000,0000,,Уайымдамаңыз, жұмыс тауып, жұмысқа кірісіңіз.
Dialogue: 0,0:42:48.07,0:42:50.67,kono-text-jp,,0000,0000,0000,,Кірушілер саны артты.
Dialogue: 0,0:42:51.74,0:42:52.71,kono-text-jp,,0000,0000,0000,,Бұл солай ма?
Dialogue: 0,0:42:58.78,0:43:01.69,kono-text-jp,,0000,0000,0000,,Кеше Хайгаминнің басында шырылдады.
Dialogue: 0,0:43:02.03,0:43:04.76,kono-text-jp,,0000,0000,0000,,Агенатого да зеңбірек келді деп ойлаймын.
Dialogue: 0,0:43:04.76,0:43:06.66,kono-text-jp,,0000,0000,0000,,Енді қиыншылықтың уақыты келді
Dialogue: 0,0:43:07.42,0:43:09.01,kono-text-jp,,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,0:43:07.99,0:43:09.04,kono-text-jp-2,,0000,0000,0000,,Сәлеметсіз бе.
Dialogue: 0,0:43:09.92,0:43:13.85,kono-text-jp,,0000,0000,0000,,Иә, әуе шабуылына қарсы пана аяқталды.
Dialogue: 0,0:43:16.01,0:43:19.25,kono-text-jp,,0000,0000,0000,,Сіз қосымша жұмысты жалғастыра беруге қатты қуанған болуыңыз керек.
Dialogue: 0,0:43:20.25,0:43:24.58,kono-text-jp,,0000,0000,0000,,Мен әпкемнің үйіндегі бағаналар мен татами төсеніштерінің арқасында құтқарылдым.
Dialogue: 0,0:43:27.17,0:43:28.24,kono-text-jp,,0000,0000,0000,,Шусаку
Dialogue: 0,0:43:28.66,0:43:30.19,kono-text-jp,,0000,0000,0000,,Бұл сіз осындасыз.
Dialogue: 0,0:43:31.01,0:43:32.72,kono-text-jp,,0000,0000,0000,,Бұл ештеңе емес.
Dialogue: 0,0:43:34.09,0:43:36.52,kono-text-jp,,0000,0000,0000,,Енді алдыңғы жағын сәл жинап алайық.
Dialogue: 0,0:43:39.17,0:43:40.31,kono-text-jp,,0000,0000,0000,,Шусаку-сан
Dialogue: 0,0:43:40.66,0:43:44.03,kono-text-jp,,0000,0000,0000,,Мен бұл топырақты далаға апара аламын.
Dialogue: 0,0:43:45.10,0:43:46.15,kono-text-jp,,0000,0000,0000,,Әкел, әкел
Dialogue: 0,0:43:46.78,0:43:47.58,kono-text-jp,,0000,0000,0000,,Абайлаңыз
Dialogue: 0,0:43:48.43,0:43:50.69,kono-text-jp,,0000,0000,0000,,Иә, мен осындамын.
Dialogue: 0,0:43:52.04,0:43:53.16,kono-text-jp,,0000,0000,0000,,Мен қайықты көрдім
Dialogue: 0,0:43:56.32,0:43:58.38,kono-text-jp,,0000,0000,0000,,Бұл туралы бүгін тағы да ұмытпа.
Dialogue: 0,0:43:58.50,0:43:59.98,kono-text-jp,,0000,0000,0000,,Екі Ямато бар.
Dialogue: 0,0:44:01.24,0:44:02.49,kono-text-jp,,0000,0000,0000,,Біреуі – Мусаши
Dialogue: 0,0:44:03.05,0:44:07.04,kono-text-jp,,0000,0000,0000,,Соғыс кемелері бар, бірақ ұшақ тасығыштары жоқ.
Dialogue: 0,0:44:08.34,0:44:10.13,kono-text-jp,,0000,0000,0000,,А, бұл Тон.
Dialogue: 0,0:44:10.41,0:44:14.18,kono-text-jp,,0000,0000,0000,,Оның артқы жағында мұнарасы жоқ, бұл авиациялық крейсер.
Dialogue: 0,0:44:15.79,0:44:18.77,kono-text-jp,,0000,0000,0000,,Уау, бұл керемет.
Dialogue: 0,0:44:19.02,0:44:21.90,kono-text-jp,,0000,0000,0000,,Иә, ағаңызға айтыңызшы.
Dialogue: 0,0:44:22.54,0:44:23.41,kono-text-jp,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:44:24.14,0:44:25.67,kono-text-jp,,0000,0000,0000,,Біз де аздап үйрендік.
Dialogue: 0,0:44:26.76,0:44:27.55,kono-text-jp,,0000,0000,0000,,Жоюшы
Dialogue: 0,0:44:28.49,0:44:30.03,kono-text-jp,,0000,0000,0000,,Әй, кішкене бірдеңе келе жатыр.
Dialogue: 0,0:44:31.30,0:44:32.65,kono-text-jp,,0000,0000,0000,,Бұл ішкі өртке қарсы қайық.
Dialogue: 0,0:44:34.62,0:44:36.31,kono-text-jp,,0000,0000,0000,,Әй, саған да рахмет.
Dialogue: 0,0:44:37.42,0:44:39.15,kono-text-jp,,0000,0000,0000,,Бұл үлкен бұлт шығар
Dialogue: 0,0:44:40.09,0:44:41.84,kono-text-jp,,0000,0000,0000,,Канатоко бұлттары
Dialogue: 0,0:44:43.40,0:44:44.84,kono-text-jp,,0000,0000,0000,,Қатты жаңбыр жауады
Dialogue: 0,0:44:49.37,0:44:50.10,kono-text-jp,,0000,0000,0000,,Шусаку-сан
Dialogue: 0,0:44:50.10,0:44:52.76,kono-text-jp,,0000,0000,0000,,Әзірше сол заттарды окопқа салыңыз.
Dialogue: 0,0:45:02.50,0:45:03.10,kono-text-jp,,0000,0000,0000,,Кешіріңіз, кешіріңіз.
Dialogue: 0,0:45:10.80,0:45:12.13,kono-text-jp,,0000,0000,0000,,Мен мұны істеймін, істеймін
Dialogue: 0,0:45:13.73,0:45:15.49,kono-text-jp,,0000,0000,0000,,Сізге әскери кемелер ұнайды, солай ма?
Dialogue: 0,0:45:16.51,0:45:18.17,kono-text-jp,,0000,0000,0000,,Харуми-саннан естіген
Dialogue: 0,0:45:19.92,0:45:21.91,kono-text-jp,,0000,0000,0000,,Харумиге сабақ берген мен емес едім
Dialogue: 0,0:45:22.63,0:45:23.54,kono-text-jp,,0000,0000,0000,,Хибоджа
Dialogue: 0,0:45:23.71,0:45:24.19,kono-text-jp,,0000,0000,0000,,H?
Dialogue: 0,0:45:26.15,0:45:28.09,kono-text-jp,,0000,0000,0000,,Иә, мен әскери кемелерді жақсы көретін жас жігітпін.
Dialogue: 0,0:45:28.75,0:45:30.47,kono-text-jp,,0000,0000,0000,,Бір күні мен де Сузу-санды кездестіремін.
Dialogue: 0,0:45:31.29,0:45:32.13,kono-text-jp,,0000,0000,0000,,Олар әжептәуір алысқа қашып кеткен болар...
Dialogue: 0,0:45:32.80,0:45:34.27,kono-text-jp,,0000,0000,0000,,Біреу «Хисао» деп атады ма?
Dialogue: 0,0:45:35.21,0:45:35.84,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,0:45:46.90,0:45:48.24,kono-text-jp,,0000,0000,0000,,Осындай нәрсені жасаңыз
Dialogue: 0,0:45:48.58,0:45:50.16,kono-text-jp,,0000,0000,0000,,Осы адаммен
Dialogue: 0,0:45:55.12,0:45:57.88,kono-text-jp,,0000,0000,0000,,Жарайды, аздап жаңбыр жауа бастады.
Dialogue: 0,0:45:58.27,0:45:59.97,kono-text-jp,,0000,0000,0000,,Қазір үйге қайтайық.
Dialogue: 0,0:46:00.78,0:46:01.79,kono-text-jp,,0000,0000,0000,,Мм...
Dialogue: 0,0:46:01.83,0:46:06.28,kono-text-jp,,0000,0000,0000,,Біз ерлі-зайыптымыз, сондықтан жақсы қарым-қатынаста болғанымыз дұрыс.
Dialogue: 0,0:46:06.56,0:46:09.67,kono-text-jp,,0000,0000,0000,,Иә, иә, ерлі-зайыптылардың тіл табысуы үлкен мәселе емес.
Dialogue: 0,0:46:09.68,0:46:10.87,kono-text-jp,,0000,0000,0000,,2 жиын аяқталды
Dialogue: 0,0:46:10.89,0:46:12.34,kono-text-jp,,0000,0000,0000,,Диази
Dialogue: 0,0:46:15.39,0:46:20.00,kono-text-jp,,0000,0000,0000,,Отбасы жиналып, өздерінің күшті жақтарын салыстырды.
Dialogue: 0,0:46:20.86,0:46:21.98,kono-text-jp,,0000,0000,0000,,Жер
Dialogue: 0,0:46:22.47,0:46:25.84,kono-text-jp,,0000,0000,0000,,Жеңгесінің күйеуі...
Dialogue: 0,0:46:26.18,0:46:30.30,kono-text-jp,,0000,0000,0000,,Әскерге бару қиынға соқса да, арық денелі еді.
Dialogue: 0,0:46:30.80,0:46:32.48,kono-text-jp,,0000,0000,0000,,Тым жұқа ма?
Dialogue: 0,0:46:33.89,0:46:37.03,kono-text-jp,,0000,0000,0000,,Әкем қайтадан зауытқа жұмысқа тұрғанда
Dialogue: 0,0:46:37.76,0:46:40.17,kono-text-jp,,0000,0000,0000,,Мен әпкемді тойлау үшін дүкенге сағат іздедім.
Dialogue: 0,0:46:40.71,0:46:42.93,kono-text-jp,,0000,0000,0000,,Мен жас шеберді сонда кездестірдім.
Dialogue: 0,0:46:44.20,0:46:45.42,kono-text-jp,,0000,0000,0000,,Әйеліңізге барыңыз
Dialogue: 0,0:46:45.93,0:46:48.61,kono-text-jp,,0000,0000,0000,,Екі жас жұп жаңа дүкен ашып жатыр
Dialogue: 0,0:46:49.76,0:46:53.09,kono-text-jp,,0000,0000,0000,,Хойжага Кейкода мұндай тұлға бар.
Dialogue: 0,0:46:53.55,0:46:55.90,kono-text-jp,,0000,0000,0000,,Мен ата-анаммен тіл табыса алмаймын.
Dialogue: 0,0:46:56.53,0:46:58.37,kono-text-jp,,0000,0000,0000,,Күйеу баласы ырылдаған соң
Dialogue: 0,0:46:58.72,0:47:02.29,kono-text-jp,,0000,0000,0000,,Дүкенмен не істеу керектігін шеше алмай қиналдым.
Dialogue: 0,0:47:02.63,0:47:07.35,kono-text-jp,,0000,0000,0000,,Соңында ғимарат эвакуацияланып, бірдеңе дұрыс болмады.
Dialogue: 0,0:47:09.42,0:47:12.25,kono-text-jp,,0000,0000,0000,,Хисао - Куромураның мұрагері.
Dialogue: 0,0:47:13.11,0:47:15.29,kono-text-jp,,0000,0000,0000,,Шимоносекиге апарылды
Dialogue: 0,0:47:16.30,0:47:18.51,kono-text-jp,,0000,0000,0000,,Сіз сұраққа жауап берген сияқтысыз.
Dialogue: 0,0:47:19.61,0:47:23.18,kono-text-jp,,0000,0000,0000,,Әр адам бақытты өмір сүрсе, жақсы болар еді.
Dialogue: 0,0:47:24.15,0:47:25.46,kono-text-jp,,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:47:34.42,0:47:36.20,kono-text-jp,,0000,0000,0000,,Көкөністерді қарастырайық.
Dialogue: 0,0:47:50.01,0:47:51.73,kono-text-jp,,0000,0000,0000,,Мен мұны түсінген кезде
Dialogue: 0,0:47:52.07,0:47:54.48,kono-text-jp,,0000,0000,0000,,Бұған айлар қажет.
Dialogue: 0,0:47:55.01,0:47:57.22,kono-text-jp,,0000,0000,0000,,Бұл шынымен қызықсыз.
Dialogue: 0,0:48:02.07,0:48:03.09,kono-text-jp,,0000,0000,0000,,Бұл Ямато
Dialogue: 0,0:48:04.83,0:48:05.87,kono-text-jp,,0000,0000,0000,,Бұл Тон
Dialogue: 0,0:48:12.12,0:48:14.29,kono-text-jp,,0000,0000,0000,,А, анау, анау, анау.
Dialogue: 0,0:48:15.78,0:48:17.24,kono-text-jp,,0000,0000,0000,,Ух... Учаатада.
Dialogue: 0,0:48:17.29,0:48:19.93,kono-text-jp,,0000,0000,0000,,Мен алысқа көшіп келген балама қайықтың суретін жібергім келді.
Dialogue: 0,0:48:19.93,0:48:21.48,kono-text-jp,,0000,0000,0000,,Мына әйелдің үйі қайда?
Dialogue: 0,0:48:21.72,0:48:23.18,kono-text-jp,,0000,0000,0000,,Ке...Әскери полиция
Dialogue: 0,0:48:24.35,0:48:26.65,kono-text-jp,,0000,0000,0000,,Мен жағалау сызығы мен кеменің сұлбасын сыздым.
Dialogue: 0,0:48:27.50,0:48:28.66,kono-text-jp,,0000,0000,0000,,Шпиондық
Dialogue: 0,0:48:28.85,0:48:30.17,kono-text-jp,,0000,0000,0000,,Сондай қара жүзбен
Dialogue: 0,0:48:30.45,0:48:34.17,kono-text-jp,,0000,0000,0000,,Мен бұл жоспардың қаншалықты қулық және айлалы екенін білмеймін.
Dialogue: 0,0:48:36.01,0:48:37.60,kono-text-jp,,0000,0000,0000,,Бұл әйелдің күйеуі
Dialogue: 0,0:48:37.91,0:48:41.21,kono-text-jp,,0000,0000,0000,,Әскери-теңіз сотының жазбасы
Dialogue: 0,0:48:41.46,0:48:45.12,kono-text-jp,,0000,0000,0000,,Әйелдің мүмкіндікті пайдаланып, әскери құпияларды ақтару мүмкіндігі бар емес пе?
Dialogue: 0,0:48:46.19,0:48:48.12,kono-text-jp,,0000,0000,0000,,Шифрланған байланыстың белгісі бар ма?
Dialogue: 0,0:48:48.69,0:48:51.59,kono-text-jp,,0000,0000,0000,,Әйел затынан кездейсоқ сандар кестесін көрдіңіз бе?
Dialogue: 0,0:48:51.78,0:48:53.29,kono-text-jp,,0000,0000,0000,,Фондық қатынасты білдіретін заттар
Dialogue: 0,0:48:53.76,0:48:54.97,kono-text-jp,,0000,0000,0000,,Иә? Өтінемін
Dialogue: 0,0:48:57.14,0:48:59.44,kono-text-jp,,0000,0000,0000,,Мен бұл жолы бір істі қамауға алудан аулақ боламын.
Dialogue: 0,0:48:59.99,0:49:01.70,kono-text-jp,,0000,0000,0000,,Өзіңізді мұқият бақылаңыз
Dialogue: 0,0:49:02.10,0:49:04.31,kono-text-jp,,0000,0000,0000,,Әйелім десем де, ол басқа біреу ғой.
Dialogue: 0,0:49:16.39,0:49:17.47,kono-text-jp,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:49:18.60,0:49:21.82,kono-text-jp,,0000,0000,0000,,Неге, кірді кептіруге қалдыру керек пе?
Dialogue: 0,0:49:22.01,0:49:23.78,kono-text-jp,,0000,0000,0000,,Әй, Шусаку, болды.
Dialogue: 0,0:49:23.96,0:49:25.86,kono-text-jp,,0000,0000,0000,,Сузу-сан әскери полиция қызметкері болады...
Dialogue: 0,0:49:29.07,0:49:31.25,kono-text-jp,,0000,0000,0000,,Сузу-сан, осында сәл кел.
Dialogue: 0,0:49:39.23,0:49:42.09,kono-text-jp,,0000,0000,0000,,Егер ол соншалықты кішкентай болса, тіпті жағалау сызығын салуға болады.
Dialogue: 0,0:49:44.54,0:49:47.07,kono-text-jp,,0000,0000,0000,,Сузу-сан, сурет салғанды ​​ұнатасың ба?
Dialogue: 0,0:49:47.88,0:49:50.31,kono-text-jp,,0000,0000,0000,,Маған тағы бір рет сурет сала аласыз ба?
Dialogue: 0,0:49:51.20,0:49:52.20,kono-text-jp,,0000,0000,0000,,Уақытша телефондар, ноутбуктар
Dialogue: 0,0:49:52.94,0:49:55.41,kono-text-jp,,0000,0000,0000,,Ол дұрыс салынбауы мүмкін
Dialogue: 0,0:49:57.80,0:50:00.60,kono-text-jp,,0000,0000,0000,,Сузу тыңшы ма?
Dialogue: 0,0:50:01.16,0:50:03.91,kono-text-jp,,0000,0000,0000,,Шусаку: Дұрыс айтасың.
Dialogue: 0,0:50:04.18,0:50:07.57,kono-text-jp,,0000,0000,0000,,We apologize to the military police.
Dialogue: 0,0:50:07.57,0:50:09.67,kono-text-jp,,0000,0000,0000,,Күлу қиын
Dialogue: 0,0:50:09.69,0:50:12.35,kono-text-jp,,0000,0000,0000,,Егер сіз ұстанатын болсаңыз, сізге көбірек қиындықтар қажет болады.
Dialogue: 0,0:50:15.64,0:50:17.50,kono-text-jp,,0000,0000,0000,,Көріп отырғаныңыздай
Dialogue: 0,0:50:17.50,0:50:20.49,kono-text-jp,,0000,0000,0000,,Тым толқыған кезде айналаңыздағыны көре алмайсыз.
Dialogue: 0,0:50:20.85,0:50:22.16,kono-text-jp,,0000,0000,0000,,The mysterious thing is
Dialogue: 0,0:50:22.16,0:50:24.74,kono-text-jp,,0000,0000,0000,,If you don't look wise in vain,
Dialogue: 0,0:50:24.75,0:50:25.95,kono-text-jp,,0000,0000,0000,,Бұл... бұл адам
Dialogue: 0,0:50:26.17,0:50:29.66,kono-text-jp,,0000,0000,0000,,Мен ``Сағат 6-да үйге қайт, ``жазып жатыр'' деп ойлаған адам едім.
Dialogue: 0,0:50:29.76,0:50:31.60,kono-text-jp,,0000,0000,0000,,What secret are you aiming for?
Dialogue: 0,0:50:31.69,0:50:33.49,kono-text-jp,,0000,0000,0000,,The army's stupid military police
Dialogue: 0,0:50:33.49,0:50:36.80,kono-text-jp,,0000,0000,0000,,Мен оның не екенін білмеймін, бірақ мен сүйретіліп, ауырып жатырмын.
Dialogue: 0,0:50:40.46,0:50:44.06,kono-text-jp,,0000,0000,0000,,Әркім өз өмірін күліп өткізсе, тамаша болар еді.
Dialogue: 0,0:50:44.48,0:50:45.78,kono-text-jp,,0000,0000,0000,,Бұл рас.
Dialogue: 0,0:50:45.78,0:50:46.89,kono-text-jp,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:50:47.67,0:50:50.13,kono-text-jp,,0000,0000,0000,,Dad, you let your dad hear it too.
Dialogue: 0,0:50:51.56,0:50:53.61,kono-text-jp,,0000,0000,0000,,Адал күле алмайтын мен ғана ма?
Dialogue: 0,0:50:53.73,0:50:55.52,kono-text-jp-2,,0000,0000,0000,,What kind of plan can you come up with?
Dialogue: 0,0:50:55.97,0:50:58.01,kono-text-jp-2,,0000,0000,0000,,I don't understand anything anymore
Dialogue: 0,0:51:00.93,0:51:04.92,kono-text-jp,,0000,0000,0000,,Соғыс болса да, цикадалар шырылдап, көбелектер ұшады.
Dialogue: 0,0:51:05.21,0:51:07.35,kono-text-jp,,0000,0000,0000,,Уау, ыстық.
Dialogue: 0,0:51:09.38,0:51:10.97,kono-text-jp,,0000,0000,0000,,Иә, қант та.
Dialogue: 0,0:51:12.39,0:51:14.88,kono-text-jp,,0000,0000,0000,,Маусым айындағы әуе шабуылдарының уақыты келді.
Dialogue: 0,0:51:14.96,0:51:17.98,kono-text-jp,,0000,0000,0000,,Көз алдымда келер деп ойладым, бірақ соғыс болды.
Dialogue: 0,0:51:18.82,0:51:20.92,kono-text-jp,,0000,0000,0000,,Қазір қайда бара жатырсың?
Dialogue: 0,0:51:24.47,0:51:25.78,kono-text-jp,,0000,0000,0000,,Ау, ау, ау…
Dialogue: 0,0:51:25.94,0:51:27.85,kono-text-jp,,0000,0000,0000,,Harumi-san, sorry, sorry.
Dialogue: 0,0:51:27.93,0:51:28.94,kono-text-jp,,0000,0000,0000,,Жарайды
Dialogue: 0,0:51:29.59,0:51:31.08,kono-text-jp,,0000,0000,0000,,Ariko-san is watching
Dialogue: 0,0:51:33.01,0:51:35.72,kono-text-jp,,0000,0000,0000,,Бұл қанша уақытқа созылады деп ойлаймын.
Dialogue: 0,0:51:56.97,0:51:59.92,kono-text-jp,,0000,0000,0000,,Sugar is now a valuable item.
Dialogue: 0,0:52:07.00,0:52:09.84,kono-text-jp,,0000,0000,0000,,Hide it if Ariko can't find it.
Dialogue: 0,0:52:10.27,0:52:11.90,kono-text-jp,,0000,0000,0000,,Ходжабут...
Dialogue: 0,0:52:12.45,0:52:13.56,kono-text-jp,,0000,0000,0000,,Мінез-құлқы: Талғампаз
Dialogue: 0,0:52:17.91,0:52:19.31,kono-text-jp,,0000,0000,0000,,Не...не болды?
Dialogue: 0,0:52:20.29,0:52:21.79,kono-text-jp,,0000,0000,0000,,Суда
Dialogue: 0,0:52:22.14,0:52:25.02,kono-text-jp,,0000,0000,0000,,Мен де Арико мені оған жақындатпайды деп ойладым.
Dialogue: 0,0:52:34.27,0:52:37.55,kono-text-jp,,0000,0000,0000,,Осыны алып, қара базардан сатып алу қиын.
Dialogue: 0,0:52:41.87,0:52:43.49,kono-text-jp,,0000,0000,0000,,A different path than usual
Dialogue: 0,0:52:46.81,0:52:48.07,kono-text-jp,,0000,0000,0000,,Өзіңізге қажетін алыңыз
Dialogue: 0,0:52:53.47,0:52:55.67,kono-text-jp,,0000,0000,0000,,There shouldn't be anything to sell.
Dialogue: 0,0:52:56.00,0:52:57.69,kono-text-jp,,0000,0000,0000,,Why are there so many people?
Dialogue: 0,0:53:02.83,0:53:06.27,kono-text-jp,,0000,0000,0000,,Дұрыс, Тайвань күріші ең жақсысы.
Dialogue: 0,0:53:07.64,0:53:10.18,kono-text-jp,,0000,0000,0000,,Бірдеңе болса, біз ішкі күрішті де ұйымдастыра аламыз.
Dialogue: 0,0:53:12.46,0:53:15.04,kono-text-jp,,0000,0000,0000,,Егісте қарбызға тыйым салу керек.
Dialogue: 0,0:53:17.31,0:53:19.24,kono-text-jp,,0000,0000,0000,,Бәрі де болады
Dialogue: 0,0:53:23.40,0:53:26.08,kono-text-jp,,0000,0000,0000,,Соғыс алдындағы жазғы демалыс сияқты.
Dialogue: 0,0:53:27.33,0:53:29.55,kono-text-jp,,0000,0000,0000,,1 бөлке қант 20 иен
Dialogue: 0,0:53:29.85,0:53:32.79,kono-text-jp,,0000,0000,0000,,рационнан 50 есе көп.
Dialogue: 0,0:53:33.06,0:53:35.59,kono-text-jp,,0000,0000,0000,,Қазір алмасам, бәрібір қымбат болады.
Dialogue: 0,0:53:36.03,0:53:41.30,kono-text-jp,,0000,0000,0000,,Ананың қарны мен осы айдағы күнкөріс шығыны 25 иен.
Dialogue: 0,0:53:41.53,0:53:44.17,kono-text-jp,,0000,0000,0000,,Устрица тұқымдары
Dialogue: 0,0:53:47.45,0:53:51.55,kono-text-jp,,0000,0000,0000,,Қант қазір шамамен 150 иен тұрады.
Dialogue: 0,0:53:51.82,0:53:54.95,kono-text-jp,,0000,0000,0000,,Мен бұдан былай 100 иенге карамель немесе басқа нәрсе сатып ала алмаймын.
Dialogue: 0,0:53:55.27,0:53:59.87,kono-text-jp,,0000,0000,0000,,Егер сіз 3 жұп шұлық алсаңыз, оның құны 1000 иен емес пе?
Dialogue: 0,0:54:01.13,0:54:04.65,kono-text-jp,,0000,0000,0000,,Мұндай елде тұруға бола ма?
Dialogue: 0,0:54:10.24,0:54:13.61,kono-text-jp,,0000,0000,0000,,Эй, бұл қайда?
Dialogue: 0,0:54:13.97,0:54:15.69,kono-text-jp,,0000,0000,0000,,Иә? Наганоки?
Dialogue: 0,0:54:15.88,0:54:17.24,kono-text-jp,,0000,0000,0000,,Теңіз зираты бар ма?
Dialogue: 0,0:54:17.58,0:54:19.40,kono-text-jp,,0000,0000,0000,,Ах, Нагасако.
Dialogue: 0,0:54:19.52,0:54:20.90,kono-text-jp,,0000,0000,0000,,О, ана жерде ме?
Dialogue: 0,0:54:21.14,0:54:22.26,kono-text-jp,,0000,0000,0000,,Осылайша, солай емес пе?
Dialogue: 0,0:54:37.94,0:54:38.69,kono-text-jp,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:54:43.56,0:54:44.10,kono-text-jp,,0000,0000,0000,,Жоқ
Dialogue: 0,0:54:45.22,0:54:46.06,kono-text-jp,,0000,0000,0000,,Қарбыз
Dialogue: 0,0:54:47.73,0:54:48.66,kono-text-jp,,0000,0000,0000,,Карамель?
Dialogue: 0,0:54:50.14,0:54:51.01,kono-text-jp,,0000,0000,0000,,Жоғалдың ба?
Dialogue: 0,0:54:53.04,0:54:54.35,kono-text-jp,,0000,0000,0000,,Сіз ересек болсаңыз да?
Dialogue: 0,0:54:55.13,0:54:56.33,kono-text-jp,,0000,0000,0000,,Қайдан келдің?
Dialogue: 0,0:54:57.04,0:54:57.89,kono-text-jp,,0000,0000,0000,,Наганоки
Dialogue: 0,0:54:59.02,0:55:02.56,kono-text-jp,,0000,0000,0000,,Апа, үйге баратын жолды ешкім айтпайды.
Dialogue: 0,0:55:02.93,0:55:04.73,kono-text-jp,,0000,0000,0000,,Барлығының иісін сезінсін
Dialogue: 0,0:55:05.14,0:55:07.61,kono-text-jp,,0000,0000,0000,,Бұл Рюгу сарайы немесе басқасы болуы керек.
Dialogue: 0,0:55:08.16,0:55:12.63,kono-text-jp,,0000,0000,0000,,Егер сіз Наганокиде болсаңыз, бұрыштан бұрылып, пошта бөлімшесіне түсіңіз.
Dialogue: 0,0:55:12.93,0:55:13.54,kono-text-jp,,0000,0000,0000,,Хойде
Dialogue: 0,0:55:14.52,0:55:15.54,kono-text-jp,,0000,0000,0000,,Мені күт.
Dialogue: 0,0:55:17.18,0:55:19.89,kono-text-jp,,0000,0000,0000,,Әпке, айтыңызшы.
Dialogue: 0,0:55:24.86,0:55:27.26,kono-text-jp,,0000,0000,0000,,Мына жерге барыңыз, мынаны қалдырыңыз
Dialogue: 0,0:55:27.48,0:55:30.91,kono-text-jp,,0000,0000,0000,,Пошта бөлімшесінен кейінгі бұрышта оңға бұрылыңыз.
Dialogue: 0,0:55:31.70,0:55:33.24,kono-text-jp,,0000,0000,0000,,Рахмет
Dialogue: 0,0:55:34.44,0:55:37.78,kono-text-jp,,0000,0000,0000,,Мұндағылардың бәрі бейтаныс болуы керек.
Dialogue: 0,0:55:38.21,0:55:42.13,kono-text-jp,,0000,0000,0000,,Олардың көпшілігі аутсайдер, тіпті бұл қақпадан шықпайды.
Dialogue: 0,0:55:42.95,0:55:45.24,kono-text-jp,,0000,0000,0000,,Сіз де Хиросиманың оңтүстігіненсіз...
Dialogue: 0,0:55:46.03,0:55:46.89,kono-text-jp,,0000,0000,0000,,Теңізге қарай
Dialogue: 0,0:55:47.36,0:55:49.48,kono-text-jp,,0000,0000,0000,,Неліктен?
Dialogue: 0,0:55:49.88,0:55:50.76,kono-text-jp,,0000,0000,0000,,Сөзбен
Dialogue: 0,0:55:52.23,0:55:53.02,kono-text-jp,,0000,0000,0000,,Enami т.б.
Dialogue: 0,0:55:53.24,0:55:55.14,kono-text-jp,,0000,0000,0000,,Иә, Кусацу т.б.
Dialogue: 0,0:55:55.22,0:55:56.29,kono-text-jp,,0000,0000,0000,,Кусацу
Dialogue: 0,0:55:57.20,0:56:00.38,kono-text-jp,,0000,0000,0000,,Жыл сайын әжемнің үйінде қарбыз жейтінбіз.
Dialogue: 0,0:56:00.74,0:56:02.97,kono-text-jp,,0000,0000,0000,,Өйткені мен кедей едім
Dialogue: 0,0:56:03.09,0:56:05.69,kono-text-jp,,0000,0000,0000,,Адамның тамағына толы болды.
Dialogue: 0,0:56:06.39,0:56:08.39,kono-text-jp,,0000,0000,0000,,Маған мейірімді болыңыз.
Dialogue: 0,0:56:09.31,0:56:11.56,kono-text-jp,,0000,0000,0000,,Мен қызыл жеңгемді жедім.
Dialogue: 0,0:56:12.35,0:56:14.13,kono-text-jp,,0000,0000,0000,,Бұл көп уақыт өткен жоқ.
Dialogue: 0,0:56:15.26,0:56:17.31,kono-text-jp,,0000,0000,0000,,Сіз сурет салуда жақсы болуыңыз керек.
Dialogue: 0,0:56:17.98,0:56:21.29,kono-text-jp,,0000,0000,0000,,Мен оны қараған кезде...
Dialogue: 0,0:56:22.32,0:56:23.60,kono-text-jp,,0000,0000,0000,,Бұл арзан.
Dialogue: 0,0:56:24.18,0:56:26.00,kono-text-jp,,0000,0000,0000,,Басқа нәрсе болса, маған хабарлаңыз.
Dialogue: 0,0:56:26.43,0:56:28.40,kono-text-jp,,0000,0000,0000,,Жалбыз қант вараби мочи
Dialogue: 0,0:56:28.91,0:56:30.33,kono-text-jp,,0000,0000,0000,,Жалбыз қант…
Dialogue: 0,0:56:30.40,0:56:34.38,kono-text-jp,,0000,0000,0000,,Сосын балмұздақ вафли.
Dialogue: 0,0:56:34.88,0:56:35.66,kono-text-jp,,0000,0000,0000,,Вафель?
Dialogue: 0,0:56:36.11,0:56:38.86,kono-text-jp,,0000,0000,0000,,Білмейсіз бе? Сіз ешқашан кофеханаға бармадыңыз ба?
Dialogue: 0,0:56:38.87,0:56:40.00,kono-text-jp,,0000,0000,0000,,Арық
Dialogue: 0,0:56:40.10,0:56:42.29,kono-text-jp,,0000,0000,0000,,Сіз шынымен мұнай сатпайсыз.
Dialogue: 0,0:56:42.51,0:56:44.58,kono-text-jp,,0000,0000,0000,,Кешіріңіз, мен бәрібір кетуім керек.
Dialogue: 0,0:56:45.21,0:56:47.74,kono-text-jp,,0000,0000,0000,,А, эй, келесі жолы сызамын.
Dialogue: 0,0:56:49.75,0:56:50.56,kono-text-jp,,0000,0000,0000,,Иә.
Dialogue: 0,0:56:51.33,0:56:53.58,kono-text-jp,,0000,0000,0000,,Мен мұндай жерге ешқашан келмеймін.
Dialogue: 0,0:56:56.99,0:56:59.15,kono-text-jp,,0000,0000,0000,,Қайтадан адасып қалма
Dialogue: 0,0:57:20.25,0:57:21.60,kono-text-jp,,0000,0000,0000,,Кеш болды.
Dialogue: 0,0:57:21.60,0:57:25.19,kono-text-jp,,0000,0000,0000,,Мен базарға бардым, бірақ үйге қайтып бара жатқанда қателесуім мүмкін деп ойладым.
Dialogue: 0,0:57:26.61,0:57:27.54,kono-text-jp,,0000,0000,0000,,Қайын апа
Dialogue: 0,0:57:27.90,0:57:31.46,kono-text-jp,,0000,0000,0000,,Кофехана балмұздақ утара вафли
Dialogue: 0,0:57:31.63,0:57:32.88,kono-text-jp,,0000,0000,0000,,Бұл қандай зат?
Dialogue: 0,0:57:33.04,0:57:34.69,kono-text-jp,,0000,0000,0000,,Неліктен білмейсің?
Dialogue: 0,0:57:35.28,0:57:38.34,kono-text-jp,,0000,0000,0000,,Дұрыс, сен тәттісің, суықсың.
Dialogue: 0,0:57:38.36,0:57:41.62,kono-text-jp,,0000,0000,0000,,Бұл қытырлақ күріш крекеріне ұқсайды, сондықтан оны жинап жеп қойыңыз.
Dialogue: 0,0:57:42.01,0:57:43.82,kono-text-jp,,0000,0000,0000,,А, жақсы...
Dialogue: 0,0:57:44.58,0:57:45.35,kono-text-jp,,0000,0000,0000,,Бұл…
Dialogue: 0,0:57:48.53,0:57:51.10,kono-text-jp,,0000,0000,0000,,Біз тәттілер туралы сөйлескенімізге біраз болды.
Dialogue: 0,0:57:51.11,0:57:53.96,kono-text-jp,,0000,0000,0000,,Жай су тым тәтті деп ойламайсыз ба?
Dialogue: 0,0:58:01.25,0:58:02.50,kono-text-jp,,0000,0000,0000,,Әлі ыстық
Dialogue: 0,0:58:04.32,0:58:05.84,kono-text-jp,,0000,0000,0000,,Ходжоның әйелі
Dialogue: 0,0:58:06.32,0:58:07.73,kono-text-jp,,0000,0000,0000,,Сізге қоңырау шалыңыз
Dialogue: 0,0:58:09.13,0:58:11.54,kono-text-jp,,0000,0000,0000,,Иә, үйде ме?
Dialogue: 0,0:58:15.03,0:58:16.04,kono-text-jp,,0000,0000,0000,,Мынау мынау
Dialogue: 0,0:58:17.77,0:58:19.20,kono-text-jp,,0000,0000,0000,,ыстық ыстық
Dialogue: 0,0:58:19.37,0:58:21.10,kono-text-jp,,0000,0000,0000,,Ұят болған Шусаку.
Dialogue: 0,0:58:21.10,0:58:22.37,kono-text-jp,,0000,0000,0000,,Сіз сондай қайғылы көрінесіз...
Dialogue: 0,0:58:32.66,0:58:35.20,kono-text-jp,,0000,0000,0000,,Олай болса, шеңберге сәл жүрейік.
Dialogue: 0,0:58:35.59,0:58:38.74,kono-text-jp,,0000,0000,0000,,Сонымен GKF қалай болды?
Dialogue: 0,0:58:38.98,0:58:40.19,kono-text-jp,,0000,0000,0000,,Босаңсыды.
Dialogue: 0,0:58:40.19,0:58:41.07,kono-text-jp,,0000,0000,0000,,Мен көремін.
Dialogue: 0,0:58:41.28,0:58:42.75,kono-text-jp,,0000,0000,0000,,Алдымен салқын сыра ішейік.
Dialogue: 0,0:58:59.54,0:59:02.57,kono-text-jp,,0000,0000,0000,,Шот тапсыруға Шусаку мырза келді.
Dialogue: 0,0:59:08.52,0:59:09.48,kono-text-jp,,0000,0000,0000,,Сузу-сан
Dialogue: 0,0:59:10.22,0:59:12.12,kono-text-jp,,0000,0000,0000,,Бұл өте ақ, бірақ жақсы ма?
Dialogue: 0,0:59:13.23,0:59:14.91,kono-text-jp,,0000,0000,0000,,бөліміне өтіңіз...бұл біртүрлі ме?
Dialogue: 0,0:59:16.00,0:59:17.88,kono-text-jp,,0000,0000,0000,,Жоқ, жақсы болсаң, иә.
Dialogue: 0,0:59:18.59,0:59:19.75,kono-text-jp,,0000,0000,0000,,Әй, кеттік.
Dialogue: 0,0:59:21.57,0:59:22.38,kono-text-jp,,0000,0000,0000,,Сіздің жұмысыңыз қандай?
Dialogue: 0,0:59:22.97,0:59:26.20,kono-text-jp,,0000,0000,0000,,Шұғыл болмаса да, есепшотты өзіммен бірге әдейі алып келдім.
Dialogue: 0,0:59:27.28,0:59:30.14,kono-text-jp,,0000,0000,0000,,Қалада дүкен аралау қызық екенін айттым.
Dialogue: 0,0:59:34.40,0:59:35.17,kono-text-jp,,0000,0000,0000,,Не болды?
Dialogue: 0,0:59:35.86,0:59:36.94,kono-text-jp,,0000,0000,0000,,Күтілгендей...
Dialogue: 0,0:59:37.28,0:59:39.34,kono-text-jp,,0000,0000,0000,,Күлдірмей тұра алмайсың.
Dialogue: 0,0:59:45.23,0:59:47.24,kono-text-jp,,0000,0000,0000,,Мен де бұл фильм деп ойладым.
Dialogue: 0,0:59:49.63,0:59:52.32,kono-text-jp,,0000,0000,0000,,Үлкен кеме қайтып келгенде не болды?
Dialogue: 0,0:59:54.76,0:59:56.40,kono-text-jp,,0000,0000,0000,,Жарайды, мен берілмеймін.
Dialogue: 0,0:59:57.32,0:59:59.54,kono-text-jp,,0000,0000,0000,,Өкінішке орай, мен мұны қайталаймын.
Dialogue: 0,1:00:02.81,1:00:03.87,kono-text-jp,,0000,0000,0000,,Сузу-сан?
Dialogue: 0,1:00:04.34,1:00:09.01,kono-text-jp,,0000,0000,0000,,Бастауыш сыныпта матрос болған бір сыныптасым бар еді.
Dialogue: 0,1:00:09.58,1:00:11.99,kono-text-jp,,0000,0000,0000,,Кездескен кезде не істеуіміз керек деп ойлайсың...
Dialogue: 0,1:00:12.15,1:00:14.55,kono-text-jp,,0000,0000,0000,,Мен жай ғана амандассам жақсы болар еді.
Dialogue: 0,1:00:15.58,1:00:18.16,kono-text-jp,,0000,0000,0000,,Мен бұрыннан таныс адаммен қазір кездессем ше?
Dialogue: 0,1:00:18.35,1:00:22.25,kono-text-jp,,0000,0000,0000,,Түсіңізден оянамын деп ойлайсыз ба?
Dialogue: 0,1:00:22.66,1:00:23.54,kono-text-jp,,0000,0000,0000,,Арман...
Dialogue: 0,1:00:23.86,1:00:27.76,kono-text-jp,,0000,0000,0000,,Тұратын жеріңіз бен фамилияңызды өзгертуде көптеген мәселелер туындайды.
Dialogue: 0,1:00:28.01,1:00:31.09,kono-text-jp,,0000,0000,0000,,Шусаку-санға мейірімді болыңыз.
Dialogue: 0,1:00:31.26,1:00:33.04,kono-text-jp,,0000,0000,0000,,Мен де достар таптым.
Dialogue: 0,1:00:33.83,1:00:36.95,kono-text-jp,,0000,0000,0000,,Иә...қазір оянсам қызық болмас еді.
Dialogue: 0,1:00:37.45,1:00:40.16,kono-text-jp,,0000,0000,0000,,Егер қазіргі жағдай рас болса, мен солай ойлаймын.
Dialogue: 0,1:00:40.37,1:00:41.61,kono-text-jp,,0000,0000,0000,,Мен көрдім.
Dialogue: 0,1:00:42.91,1:00:45.47,kono-text-jp,,0000,0000,0000,,Не өтті, мен таңдамаған жол
Dialogue: 0,1:00:46.16,1:00:49.01,kono-text-jp,,0000,0000,0000,,Бәрі оянғанда біткен түстен айырмашылығы жоқ.
Dialogue: 0,1:00:49.71,1:00:52.37,kono-text-jp,,0000,0000,0000,,Сузу-сан, мен сені таңдадым.
Dialogue: 0,1:00:52.61,1:00:55.07,kono-text-jp,,0000,0000,0000,,Мен үшін ең жақсы таңдау шығар
Dialogue: 0,1:00:57.00,1:00:59.94,kono-text-jp,,0000,0000,0000,,Мен аздап арықтап қалдым ба деп уайымдап отырмын.
Dialogue: 0,1:01:00.58,1:01:04.55,kono-text-jp,,0000,0000,0000,,Айтпақшы, соңғы кездері күннің тұтылуы жақсы жүрмейтін сияқты...
Dialogue: 0,1:01:11.50,1:01:13.26,kono-text-jp,,0000,0000,0000,,Иә 2 адамға
Dialogue: 0,1:01:20.38,1:01:22.66,kono-text-jp,,0000,0000,0000,,Мен таңертең көбірек тамақтандым.
Dialogue: 0,1:01:22.81,1:01:24.76,kono-text-jp,,0000,0000,0000,,Бұл туралы, солай емес пе?
Dialogue: 0,1:01:26.79,1:01:28.58,kono-text-jp,,0000,0000,0000,,Өйткені, бұл бір адамға арналған.
Dialogue: 0,1:01:28.83,1:01:32.82,kono-text-jp,,0000,0000,0000,,Портты енгізуге дайындық Баяу алға жылдамдық Қызыл қақпақ
Dialogue: 0,1:01:33.08,1:01:35.40,kono-text-jp,,0000,0000,0000,,Қош келдіңіз баяу тұнатын қызыл қақпақ
Dialogue: 0,1:01:35.40,1:01:37.10,kono-text-jp,,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,1:01:39.38,1:01:41.28,kono-text-jp,,0000,0000,0000,,Қаласаңыз, сұраңыз.
Dialogue: 0,1:01:43.49,1:01:44.32,kono-text-jp,,0000,0000,0000,,Иә?
Dialogue: 0,1:01:45.02,1:01:47.90,kono-text-jp,,0000,0000,0000,,Уау, бұл нағыз теңізші.
Dialogue: 0,1:01:49.38,1:01:52.36,kono-text-jp,,0000,0000,0000,,Құдықта бір-біріңе соқтығысыңдар
Dialogue: 0,1:01:52.70,1:01:53.88,kono-text-jp,,0000,0000,0000,,Сатоси Мизухара
Dialogue: 0,1:01:54.25,1:01:55.87,kono-text-jp,,0000,0000,0000,,Бұл Аоба әскери кемесінің экипажы.
Dialogue: 0,1:01:56.68,1:01:58.91,kono-text-jp,,0000,0000,0000,,Аоба Утара - Комецу.
Dialogue: 0,1:01:59.66,1:02:01.51,kono-text-jp,,0000,0000,0000,,Бұл Харуми
Dialogue: 0,1:02:04.97,1:02:07.50,kono-text-jp,,0000,0000,0000,,Қыс мезгілі, бірақ қара күнге күйіп тұрғандай емес.
Dialogue: 0,1:02:07.65,1:02:11.16,kono-text-jp,,0000,0000,0000,,Эй, сен үйге шомылуға келдің бе?
Dialogue: 0,1:02:11.32,1:02:14.21,kono-text-jp,,0000,0000,0000,,Әй, бұл шомылу қонуы деп аталатын бос уақыт.
Dialogue: 0,1:02:14.69,1:02:16.68,kono-text-jp,,0000,0000,0000,,Баратын жер туралы не деуге болады?
Dialogue: 0,1:02:16.87,1:02:19.57,kono-text-jp,,0000,0000,0000,,Мен туған жерімдегі Сузудан сізге қонаққа келуін сұрадым.
Dialogue: 0,1:02:20.16,1:02:22.61,kono-text-jp,,0000,0000,0000,,Сузу бәріңе қамқор болады.
Dialogue: 0,1:02:23.89,1:02:27.78,kono-text-jp,,0000,0000,0000,,Ежелден бері Сузу тек сурет салуға және балдырларға деген сүйіспеншілігімен танымал.
Dialogue: 0,1:02:27.84,1:02:30.02,kono-text-jp,,0000,0000,0000,,Бұл жай ғана бұлыңғыр.
Dialogue: 0,1:02:30.56,1:02:32.97,kono-text-jp,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,1:02:32.99,1:02:34.39,kono-text-jp,,0000,0000,0000,,Мен сені үйге апарамын.
Dialogue: 0,1:02:39.24,1:02:41.27,kono-text-jp,,0000,0000,0000,,Қиын болса да
Dialogue: 0,1:02:41.31,1:02:43.68,kono-text-jp,,0000,0000,0000,,«Suzu Suzu» лақтырылатын сөз сияқты.
Dialogue: 0,1:02:44.78,1:02:46.33,kono-text-jp,,0000,0000,0000,,Сонда оны қалай атаймыз?
Dialogue: 0,1:02:46.66,1:02:48.26,kono-text-jp,,0000,0000,0000,,Мүмкін бұл енді Урано емес шығар.
Dialogue: 0,1:02:49.83,1:02:52.55,kono-text-jp,,0000,0000,0000,,Сузу-сан, теңізшілермен зорлық-зомбылық жасама.
Dialogue: 0,1:03:02.49,1:03:03.99,kono-text-jp,,0000,0000,0000,,Қызықты нәрсе бар ма?
Dialogue: 0,1:03:04.02,1:03:07.39,kono-text-jp,,0000,0000,0000,,Бұл күлкілі, сіз шынымен қалыптысыз.
Dialogue: 0,1:03:07.84,1:03:09.88,kono-text-jp,,0000,0000,0000,,Дәмді Иә Дәмді
Dialogue: 0,1:03:09.89,1:03:11.36,kono-text-jp,,0000,0000,0000,,Нашар картоп
Dialogue: 0,1:03:11.43,1:03:13.41,kono-text-jp,,0000,0000,0000,,Жұмақ
Dialogue: 0,1:03:13.77,1:03:15.92,kono-text-jp,,0000,0000,0000,,Эй, Сузуды да қос!
Dialogue: 0,1:03:16.16,1:03:17.24,kono-text-jp,,0000,0000,0000,,Сен ақымақсың ба?
Dialogue: 0,1:03:17.58,1:03:19.82,kono-text-jp,,0000,0000,0000,,Сузу-сан, шам қайда?
Dialogue: 0,1:03:20.42,1:03:22.81,kono-text-jp,,0000,0000,0000,,Мен окопта екеніне сенімдімін
Dialogue: 0,1:03:22.90,1:03:23.54,kono-text-jp,,0000,0000,0000,,Хоука
Dialogue: 0,1:03:25.16,1:03:27.79,kono-text-jp,,0000,0000,0000,,Харуми да болашақта теңізші болады.
Dialogue: 0,1:03:28.41,1:03:30.01,kono-text-jp,,0000,0000,0000,,Дұрыс.
Dialogue: 0,1:03:30.01,1:03:30.99,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,1:03:31.36,1:03:32.25,kono-text-jp,,0000,0000,0000,,Itadadakimasu
Dialogue: 0,1:03:32.90,1:03:33.87,kono-text-jp,,0000,0000,0000,,Сәлемдесу
Dialogue: 0,1:03:34.19,1:03:35.56,kono-text-jp,,0000,0000,0000,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,1:03:36.46,1:03:37.80,kono-text-jp,,0000,0000,0000,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,1:03:40.05,1:03:41.75,kono-text-jp,,0000,0000,0000,,Жер жақсы.
Dialogue: 0,1:03:41.86,1:03:43.46,kono-text-jp,,0000,0000,0000,,Ходжа Учиха
Dialogue: 0,1:03:44.36,1:03:46.73,kono-text-jp,,0000,0000,0000,,Қандай жасыл жапырақтар бар?
Dialogue: 0,1:03:47.12,1:03:50.48,kono-text-jp,,0000,0000,0000,,Мен Манилада жарақат алып, қайтып оралдым.
Dialogue: 0,1:03:50.83,1:03:55.25,kono-text-jp,,0000,0000,0000,,Иә, бұл кеме болды, бірақ ол тағы да жақсы жұмыс істемеді немесе батып кетті.
Dialogue: 0,1:03:57.23,1:03:58.54,kono-text-jp,,0000,0000,0000,,Шусаку Ноу
Dialogue: 0,1:03:59.09,1:04:02.81,kono-text-jp,,0000,0000,0000,,Өлімге кешігіп келу қынжылтады.
Dialogue: 0,1:04:04.74,1:04:05.90,kono-text-jp,,0000,0000,0000,,Мизухара мырза
Dialogue: 0,1:04:06.19,1:04:10.01,kono-text-jp,,0000,0000,0000,,Әкем түнгі ауысымға қайта келмейді, сондықтан мен бүгін кешке үй басшысымын.
Dialogue: 0,1:04:10.56,1:04:14.14,kono-text-jp,,0000,0000,0000,,Кешіріңіз, бірақ мен сізді осында қалдыра алмаймын.
Dialogue: 0,1:04:18.79,1:04:19.33,kono-text-jp,,0000,0000,0000,,Солай ма?
Dialogue: 0,1:04:19.82,1:04:21.74,kono-text-jp,,0000,0000,0000,,Мен қораның екінші қабатында ұйықтадым.
Dialogue: 0,1:04:22.56,1:04:24.21,kono-text-jp,,0000,0000,0000,,Жоқ, бұл сирек болатын.
Dialogue: 0,1:04:24.51,1:04:26.80,kono-text-jp,,0000,0000,0000,,Тіпті сіз кейде өрескелсіз.
Dialogue: 0,1:04:28.69,1:04:29.10,kono-text-jp,,0000,0000,0000,,Қараңыз
Dialogue: 0,1:04:29.58,1:04:32.08,kono-text-jp,,0000,0000,0000,,От жағып, маған әкел.
Dialogue: 0,1:04:32.41,1:04:34.31,kono-text-jp,,0000,0000,0000,,Иә, жай ғана баяу сөйлесіңіз.
Dialogue: 0,1:04:34.55,1:04:36.16,kono-text-jp,,0000,0000,0000,,Мен сені тағы көретінімді білмеймін.
Dialogue: 0,1:04:51.41,1:04:53.39,kono-text-jp,,0000,0000,0000,,Мұнда келгенім үшін кешіріңіз.
Dialogue: 0,1:04:54.66,1:04:56.70,kono-text-jp,,0000,0000,0000,,Бұл аспалы еденмен салыстырғанда жұмақ.
Dialogue: 0,1:04:57.43,1:04:59.30,kono-text-jp,,0000,0000,0000,,Қараңызшы, біз жинақтау туралы айтып отырмыз.
Dialogue: 0,1:05:00.02,1:05:01.54,kono-text-jp,,0000,0000,0000,,Күн суық, аяғыңызды ішке кіргізіңіз.
Dialogue: 0,1:05:06.19,1:05:08.66,kono-text-jp,,0000,0000,0000,,Қараңдаршы, бұл кәдесый.
Dialogue: 0,1:05:08.94,1:05:09.65,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,1:05:12.70,1:05:13.79,kono-text-jp,,0000,0000,0000,,Сіз қаламсапта тұрасыз ба?
Dialogue: 0,1:05:16.22,1:05:16.78,kono-text-jp,,0000,0000,0000,,Жарайды
Dialogue: 0,1:05:25.65,1:05:27.16,kono-text-jp-2,,0000,0000,0000,,жаза алады
Dialogue: 0,1:05:25.29,1:05:27.16,kono-text-jp,,0000,0000,0000,,А, мен жаза аламын, жаза аламын.
Dialogue: 0,1:05:28.16,1:05:29.88,kono-text-jp,,0000,0000,0000,,Ол құтанға ұқсады, бірақ
Dialogue: 0,1:05:29.95,1:05:32.58,kono-text-jp,,0000,0000,0000,,Біз оңтүстік теңізде кездестік.
Dialogue: 0,1:05:32.70,1:05:35.24,kono-text-jp,,0000,0000,0000,,Құтырандар теңізден өте ме?
Dialogue: 0,1:05:35.48,1:05:36.72,kono-text-jp,,0000,0000,0000,,Ноу
Dialogue: 0,1:05:36.96,1:05:40.73,kono-text-jp,,0000,0000,0000,,Энамиде сіз жыл бойы өзен жағасында тұра аласыз.
Dialogue: 0,1:05:42.04,1:05:44.00,kono-text-jp,,0000,0000,0000,,Мен Энами Нямен келісімге келдім.
Dialogue: 0,1:05:45.58,1:05:46.81,kono-text-jp,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,1:05:46.93,1:05:48.54,kono-text-jp,,0000,0000,0000,,Мен қалағандай сурет сала алмаймын
Dialogue: 0,1:05:49.28,1:05:51.01,kono-text-jp,,0000,0000,0000,,Сізде де осындай кездер бола ма?
Dialogue: 0,1:05:52.57,1:05:53.56,kono-text-jp,,0000,0000,0000,,Ол басқа суреттерде де бар емес пе?
Dialogue: 0,1:05:54.22,1:05:55.97,kono-text-jp,,0000,0000,0000,,Бірдеңені салғаныма біраз болды.
Dialogue: 0,1:05:56.16,1:05:57.18,kono-text-jp,,0000,0000,0000,,Квирктерін қылмыстық мақсатта пайдаланатын жауыздармен күресу үшін —
Dialogue: 0,1:05:59.07,1:06:00.02,kono-text-jp,,0000,0000,0000,,Сол сурет
Dialogue: 0,1:06:00.76,1:06:02.43,kono-text-jp,,0000,0000,0000,,Сол толқынды қоян
Dialogue: 0,1:06:03.82,1:06:04.55,kono-text-jp,,0000,0000,0000,,Бұл
Dialogue: 0,1:06:05.58,1:06:07.68,kono-text-jp,,0000,0000,0000,,Одан кейін қиын болды.
Dialogue: 0,1:06:09.27,1:06:10.27,kono-text-jp,,0000,0000,0000,,Солай ма?
Dialogue: 0,1:06:11.28,1:06:12.86,kono-text-jp,,0000,0000,0000,,Сіз ұмыттыңыз ба?
Dialogue: 0,1:06:13.28,1:06:16.71,kono-text-jp,,0000,0000,0000,,Менің мұғалімім бұл суретті Хиросимадағы байқауға жіберді.
Dialogue: 0,1:06:17.15,1:06:19.61,kono-text-jp,,0000,0000,0000,,Онда ең жақсы беделдің біріне ие болды.
Dialogue: 0,1:06:20.06,1:06:21.55,kono-text-jp,,0000,0000,0000,,Мен шынымен абдырап қалдым.
Dialogue: 0,1:06:22.64,1:06:25.04,kono-text-jp,,0000,0000,0000,,Мен сызған тор
Dialogue: 0,1:06:25.73,1:06:27.43,kono-text-jp,,0000,0000,0000,,Нақты несие
Dialogue: 0,1:06:27.61,1:06:28.92,kono-text-jp,,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,1:06:38.28,1:06:40.29,kono-text-jp,,0000,0000,0000,,Қалайы жылы
Dialogue: 0,1:06:40.73,1:06:42.71,kono-text-jp,,0000,0000,0000,,Қалайы жұмсақ
Dialogue: 0,1:06:42.84,1:06:44.04,kono-text-jp,,0000,0000,0000,,Тәтті мұрын
Dialogue: 0,1:06:48.16,1:06:49.34,kono-text-jp,,0000,0000,0000,,Мизухара мырза
Dialogue: 0,1:06:50.97,1:06:54.11,kono-text-jp,,0000,0000,0000,,Мен осындай күнді көптен күткен сияқтымын.
Dialogue: 0,1:06:55.39,1:06:57.60,kono-text-jp,,0000,0000,0000,,Сен осылай келдің
Dialogue: 0,1:06:58.59,1:07:00.46,kono-text-jp,,0000,0000,0000,,Маған соншалықты жақын болсаң да
Dialogue: 0,1:07:01.17,1:07:02.09,kono-text-jp,,0000,0000,0000,,Біз...
Dialogue: 0,1:07:04.03,1:07:07.81,kono-text-jp,,0000,0000,0000,,Шынымды айтсам, мен саған ренжімей тұра алмаймын.
Dialogue: 0,1:07:08.81,1:07:09.61,kono-text-jp,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:07:10.08,1:07:11.72,kono-text-jp,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,1:07:12.91,1:07:16.16,kono-text-jp,,0000,0000,0000,,Сізге ол адам ұнайды...
Dialogue: 0,1:07:16.92,1:07:17.62,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,1:07:20.05,1:07:22.31,kono-text-jp,,0000,0000,0000,,Бұл таңқаларлықтай қалыпты жағдай
Dialogue: 0,1:07:22.57,1:07:23.30,kono-text-jp,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:07:23.41,1:07:25.88,kono-text-jp,,0000,0000,0000,,Ашық көрінетін нәрсеге ашулану.
Dialogue: 0,1:07:26.10,1:07:28.40,kono-text-jp,,0000,0000,0000,,Белгілі себептермен кешірім сұрау
Dialogue: 0,1:07:29.15,1:07:31.09,kono-text-jp,,0000,0000,0000,,Мені үйге апара алмайтыныңызға сенімдісіз бе?
Dialogue: 0,1:07:31.61,1:07:34.52,kono-text-jp,,0000,0000,0000,,Маған амалсыз күйеуге шыққаның үшін қиналғаның дұрыс емес пе?
Dialogue: 0,1:07:36.42,1:07:37.80,kono-text-jp,,0000,0000,0000,,Иә.
Dialogue: 0,1:07:40.14,1:07:41.88,kono-text-jp,,0000,0000,0000,,4-сынып
Dialogue: 0,1:07:42.64,1:07:43.73,kono-text-jp,,0000,0000,0000,,Шусаку мырза?
Dialogue: 0,1:07:44.06,1:07:46.13,kono-text-jp,,0000,0000,0000,,Ол менің қайтыс болған ағаммен құрдас.
Dialogue: 0,1:07:47.68,1:07:49.20,kono-text-jp,,0000,0000,0000,,Біз кедей едік.
Dialogue: 0,1:07:49.34,1:07:52.33,kono-text-jp,,0000,0000,0000,,Менің ағам Әскери-теңіз академиясына тегін түсті.
Dialogue: 0,1:07:53.14,1:07:56.11,kono-text-jp,,0000,0000,0000,,Менің ағам жаңа ғана қайтыс болды. Мен флотқа қосылдым.
Dialogue: 0,1:07:57.01,1:07:58.90,kono-text-jp,,0000,0000,0000,,Мұның бәрі қалыпты.
Dialogue: 0,1:07:59.21,1:08:03.37,kono-text-jp,,0000,0000,0000,,Мен адамдар үшін нормадан қай жерде қалып қойдым деп ойлаймын.
Dialogue: 0,1:08:04.68,1:08:05.51,kono-text-jp,,0000,0000,0000,,Джейки
Dialogue: 0,1:08:06.47,1:08:09.36,kono-text-jp,,0000,0000,0000,,Осындағы Орусузды көріп, көңілім жайланды.
Dialogue: 0,1:08:09.91,1:08:12.64,kono-text-jp,,0000,0000,0000,,Мені батырлық рух деп айтудан бас тартпа.
Dialogue: 0,1:08:13.34,1:08:16.61,kono-text-jp,,0000,0000,0000,,Мені еске алсаң, күліп еске ал.
Dialogue: 0,1:08:17.59,1:08:18.98,kono-text-jp,,0000,0000,0000,,Тек сен
Dialogue: 0,1:08:19.35,1:08:23.53,kono-text-jp,,0000,0000,0000,,Осы дүниеде соңына дейін қалыпты және әдепті болыңыз.
Dialogue: 0,1:08:24.00,1:08:24.81,kono-text-jp,,0000,0000,0000,,Қалайы
Dialogue: 0,1:08:25.55,1:08:27.09,kono-text-jp,,0000,0000,0000,,Сен сондай әдемісің
Dialogue: 0,1:08:27.84,1:08:29.24,kono-text-jp,,0000,0000,0000,,Сен ақымақсың ба?
Dialogue: 0,1:08:31.89,1:08:35.51,kono-text-jp,,0000,0000,0000,,Мен сені кішкентай кезімнен білемін
Dialogue: 0,1:08:35.73,1:08:38.62,kono-text-jp,,0000,0000,0000,,Маңызды нәрселерді айта алмайтын әдетім бар...
Dialogue: 0,1:08:49.83,1:08:51.85,kono-text-jp,,0000,0000,0000,,Они-чанға қош келдіңіз
Dialogue: 0,1:08:52.31,1:08:55.92,kono-text-jp,,0000,0000,0000,,Сүйектің орнын басатын тас дегеніміз не?
Dialogue: 0,1:08:56.66,1:08:58.66,kono-text-jp,,0000,0000,0000,,Суми-чан онша жақсы емес...
Dialogue: 0,1:08:58.64,1:09:01.21,kono-text-jp,,0000,0000,0000,,Онии-чанның...миы?
Dialogue: 0,1:09:01.95,1:09:03.62,kono-text-jp,,0000,0000,0000,,Мен жаңа ғана қате айттым...
Dialogue: 0,1:09:04.00,1:09:05.46,kono-text-jp,,0000,0000,0000,,Бұл қандай аға?
Dialogue: 0,1:09:06.73,1:09:09.34,kono-text-jp,,0000,0000,0000,,Суықта шақыру ақымақ сияқты
Dialogue: 0,1:09:09.56,1:09:12.08,kono-text-jp,,0000,0000,0000,,Қызық, әлгі Йоичи оңай өледі ме?
Dialogue: 0,1:09:13.36,1:09:15.56,kono-text-jp,,0000,0000,0000,,Кенеттен адам болмайды
Dialogue: 0,1:09:16.20,1:09:21.15,kono-text-jp,,0000,0000,0000,,Мені енді көре алмасаң, сөзім саған жетпейді.
Dialogue: 0,1:09:23.04,1:09:24.28,kono-text-jp,,0000,0000,0000,,Шусаку-сан
Dialogue: 0,1:09:25.57,1:09:28.85,kono-text-jp,,0000,0000,0000,,Өткен күн үшін көп рахмет.
Dialogue: 0,1:09:30.23,1:09:33.53,kono-text-jp,,0000,0000,0000,,Мизухара мырзамен сөйлесуге уақытым таусылып жатыр...
Dialogue: 0,1:09:34.76,1:09:35.61,kono-text-jp,,0000,0000,0000,,Жоқ…
Dialogue: 0,1:09:36.36,1:09:37.83,kono-text-jp,,0000,0000,0000,,Шусаку Хойде
Dialogue: 0,1:09:38.44,1:09:40.02,kono-text-jp,,0000,0000,0000,,Ерлі-зайыптылар осындай ма?
Dialogue: 0,1:09:42.07,1:09:45.00,kono-text-jp,,0000,0000,0000,,Әйелімді зорлап келсем де, қабыл алыңыз.
Dialogue: 0,1:09:47.28,1:09:49.36,kono-text-jp,,0000,0000,0000,,Оны маған көрсетпе
Dialogue: 0,1:09:49.51,1:09:50.90,kono-text-jp,,0000,0000,0000,,Ашулы бет
Dialogue: 0,1:09:51.15,1:09:51.90,kono-text-jp,,0000,0000,0000,,Жоқ…
Dialogue: 0,1:09:52.33,1:09:54.03,kono-text-jp,,0000,0000,0000,,Оны қазір көресіз.
Dialogue: 0,1:09:55.88,1:09:58.26,kono-text-jp,,0000,0000,0000,,Хо~ Мен сенің ашуланатыныңды білмедім.
Dialogue: 0,1:09:58.70,1:10:00.49,kono-text-jp,,0000,0000,0000,,Бұл алаңдатады.
Dialogue: 0,1:10:01.02,1:10:02.14,kono-text-jp,,0000,0000,0000,,Аяғын батпаққа тығып алып, осы жардан құлап кеткен бе? ➡
Dialogue: 0,1:10:03.92,1:10:07.08,kono-text-jp,,0000,0000,0000,,Бүгін сыйлаған шұлықтарыңызды өзіңізге қалдырдыңыз ба?
Dialogue: 0,1:10:07.59,1:10:11.13,kono-text-jp,,0000,0000,0000,,Сузу-сан өзі жөндеп жатқан утанға аяғын баса алмай қалды.
Dialogue: 0,1:10:11.13,1:10:12.54,kono-text-jp,,0000,0000,0000,,Басқалары болуы мүмкін.
Dialogue: 0,1:10:12.65,1:10:16.53,kono-text-jp,,0000,0000,0000,,Енді екеуің төбелесесіңдер ме?
Dialogue: 0,1:10:17.87,1:10:20.48,kono-text-jp,,0000,0000,0000,,Қайтадан бұрыс бұрылу үшін.
Dialogue: 0,1:10:20.48,1:10:21.73,kono-text-jp,,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,1:10:22.18,1:10:25.49,kono-text-jp,,0000,0000,0000,,Біз сол жерде, Хайгамин бағытындамыз.
Dialogue: 0,1:10:25.55,1:10:26.83,kono-text-jp,,0000,0000,0000,,Мен түсіндім.
Dialogue: 0,1:10:30.48,1:10:33.86,kono-text-jp,,0000,0000,0000,,Сол қыста қар көп жауды.
Dialogue: 0,1:10:34.65,1:10:36.36,kono-text-jp,,0000,0000,0000,,Көктемді күте алмадым.
Dialogue: 0,1:10:37.72,1:10:41.59,kono-text-jp,,0000,0000,0000,,Индигоға қарағанда көгілдір
Dialogue: 0,1:10:41.82,1:10:45.88,kono-text-jp,,0000,0000,0000,,Аспанда, көкте
Dialogue: 0,1:10:45.94,1:10:54.02,kono-text-jp,,0000,0000,0000,,Бірден ашу
Dialogue: 0,1:10:54.18,1:11:01.40,kono-text-jp,,0000,0000,0000,,Машироки раушан гүлдері...
Dialogue: 0,1:11:02.19,1:11:03.26,kono-text-jp,,0000,0000,0000,,Сонда ше?
Dialogue: 0,1:11:03.60,1:11:07.47,kono-text-jp,,0000,0000,0000,,Харуми-сан, тыныш болшы. Мұғалім де саған ұрысып жатқан жоқ.
Dialogue: 0,1:11:08.09,1:11:11.27,kono-text-jp,,0000,0000,0000,,Шынымен бе? Мектептен қорықпайсың ба?
Dialogue: 0,1:11:11.34,1:11:13.97,kono-text-jp,,0000,0000,0000,,Иә, тіпті қазір достарым болмаса да.
Dialogue: 0,1:11:14.22,1:11:17.91,kono-text-jp,,0000,0000,0000,,Қарашы, мен де мұнда келгенімде жалғыз болдым.
Dialogue: 0,1:11:18.02,1:11:20.59,kono-text-jp,,0000,0000,0000,,Барлығы тез достасып кетті.
Dialogue: 0,1:11:21.06,1:11:22.79,kono-text-jp,,0000,0000,0000,,Менің анам да?
Dialogue: 0,1:12:14.78,1:12:16.01,kono-text-jp,,0000,0000,0000,,Әуе қорғанысы капоты
Dialogue: 0,1:12:17.64,1:12:18.54,kono-text-jp,,0000,0000,0000,,Харуми-чан
Dialogue: 0,1:12:41.72,1:12:44.23,kono-text-jp,,0000,0000,0000,,Егер менде дәл қазір бояу болса...
Dialogue: 0,1:12:46.35,1:12:49.30,kono-text-jp,,0000,0000,0000,,...Сен не ойлап отырсың?
Dialogue: 0,1:12:50.39,1:12:53.21,kono-text-jp,,0000,0000,0000,,Эй, сен не істеп жатырсың?
Dialogue: 0,1:12:53.25,1:12:55.65,kono-text-jp,,0000,0000,0000,,Көлеңкеге түсіп, тез жат
Dialogue: 0,1:12:56.78,1:12:58.22,kono-text-jp,,0000,0000,0000,,Қайтадан қош келдіңіз
Dialogue: 0,1:13:00.27,1:13:03.59,kono-text-jp,,0000,0000,0000,,Эй, қазір әуе шабуылы туралы ескерту бар ма?
Dialogue: 0,1:13:04.24,1:13:05.28,kono-text-jp,,0000,0000,0000,,Тыныш болыңыз
Dialogue: 0,1:13:05.35,1:13:06.65,kono-text-jp,,0000,0000,0000,,Снаряд сынықтарымен соғылу
Dialogue: 0,1:13:25.22,1:13:27.30,kono-text-jp,,0000,0000,0000,,Дыбысты дыбыс
Dialogue: 0,1:13:28.44,1:13:31.96,kono-text-jp,,0000,0000,0000,,Біздің 2000 ат күшіміз қатты дыбыс шығарады.
Dialogue: 0,1:13:32.89,1:13:35.60,kono-text-jp,,0000,0000,0000,,Күндіз-түні зауыттарда жұмыс істейміз.
Dialogue: 0,1:13:35.65,1:13:38.47,kono-text-jp,,0000,0000,0000,,Бұл тек кірісті жақсарту үшін.
Dialogue: 0,1:13:40.67,1:13:45.07,kono-text-jp,,0000,0000,0000,,Біз 91 500 ат күшімен бастап, осы уақытқа дейін жеткен сияқтымыз.
Dialogue: 0,1:13:47.34,1:13:53.12,kono-text-jp,,0000,0000,0000,,Мен жұмыс істеп жатқан технологияда...
Dialogue: 0,1:13:53.74,1:13:57.80,kono-text-jp,,0000,0000,0000,,Әлемдік бейбітшілік нұры
Dialogue: 0,1:14:00.12,1:14:04.42,kono-text-jp,,0000,0000,0000,,Бар күшіңізді жұмылдырыңыз
Dialogue: 0,1:14:04.60,1:14:06.53,kono-text-jp,,0000,0000,0000,,Әй, жаудың қанша ат күші бар?
Dialogue: 0,1:14:08.55,1:14:11.02,kono-text-jp,,0000,0000,0000,,Ей, жаудың қанша ат күші бар...
Dialogue: 0,1:14:11.77,1:14:12.87,kono-text-jp,,0000,0000,0000,,Қайын ата?
Dialogue: 0,1:14:17.62,1:14:21.71,kono-text-jp,,0000,0000,0000,,Әуе шабуылы туралы ескерту жойылды
Dialogue: 0,1:14:25.01,1:14:27.79,kono-text-jp,,0000,0000,0000,,Дұрыс, түнгі кезекшілік аяқталды. Бұл сондай көңілді.
Dialogue: 0,1:14:27.89,1:14:32.07,kono-text-jp,,0000,0000,0000,,Әй, сен әуе шабуылы кезінде жерде ұйықтап қалдың.
Dialogue: 0,1:14:32.07,1:14:33.04,kono-text-jp,,0000,0000,0000,,Енді, енді.
Dialogue: 0,1:14:33.43,1:14:35.50,kono-text-jp,,0000,0000,0000,,Мен таң қалдым.
Dialogue: 0,1:14:35.50,1:14:38.32,kono-text-jp,,0000,0000,0000,,Сол күні Күреден балық ауланды.
Dialogue: 0,1:14:38.36,1:14:39.65,kono-text-jp,,0000,0000,0000,,Шағындық
Dialogue: 0,1:14:39.96,1:14:43.07,kono-text-jp,,0000,0000,0000,,Суретке үлкен нәрсені салсаңыз, ол үлкен болады.
Dialogue: 0,1:14:48.90,1:14:50.89,kono-text-jp,,0000,0000,0000,,Дабыл беру Дабыл беру
Dialogue: 0,1:14:50.90,1:14:53.19,kono-text-jp,,0000,0000,0000,,Әуе қорғанысы киімдері Өрт сөндіру
Dialogue: 0,1:14:53.40,1:14:54.98,kono-text-jp,,0000,0000,0000,,Есіктерді және жылжымалы есіктерді алу
Dialogue: 0,1:14:55.04,1:14:58.59,kono-text-jp,,0000,0000,0000,,Жоғарыда айтылғандарды орындағаннан кейін, жедел сөмкеңізді алып, әуе шабуылына қарсы панаханаға барыңыз.
Dialogue: 0,1:15:00.12,1:15:03.89,kono-text-jp,,0000,0000,0000,,Әуе шабуылы туралы ескерту жойылды
Dialogue: 0,1:15:06.25,1:15:08.43,kono-text-jp,,0000,0000,0000,,Оны шикі күйінде қайнатпаңыз.
Dialogue: 0,1:15:08.53,1:15:10.57,kono-text-jp,,0000,0000,0000,,Мен өзімді ауыр сезінемін.
Dialogue: 0,1:15:10.76,1:15:13.28,kono-text-jp,,0000,0000,0000,,Күйеуі де шайқаста қаза тапты.
Dialogue: 0,1:15:13.34,1:15:16.16,kono-text-jp,,0000,0000,0000,,Бұл жолы мен 17 жасар баламды көтере алмаймын.
Dialogue: 0,1:15:16.21,1:15:18.16,kono-text-jp,,0000,0000,0000,,Неге… неге мен
Dialogue: 0,1:15:22.89,1:15:24.46,kono-text-jp,,0000,0000,0000,,Әуе қорғанысы киімдерін дайындау
Dialogue: 0,1:15:24.46,1:15:25.62,kono-text-jp,,0000,0000,0000,,Өртті тоқтатуға болмайды.
Dialogue: 0,1:15:25.62,1:15:27.17,kono-text-jp,,0000,0000,0000,,Есіктерді және жылжымалы есіктерді алу
Dialogue: 0,1:15:27.33,1:15:28.40,kono-text-jp,,0000,0000,0000,,Әуе қорғанысы құралдары
Dialogue: 0,1:15:28.41,1:15:29.09,kono-text-jp,,0000,0000,0000,,Осы жерден айналып өтейік…
Dialogue: 0,1:15:29.56,1:15:32.11,kono-text-jp,,0000,0000,0000,,Қараңғы болғаны сонша, мен енді көре алмаймын
Dialogue: 0,1:15:32.11,1:15:32.91,kono-text-jp,,0000,0000,0000,,Осы жерден айналып өтейік…
Dialogue: 0,1:15:33.99,1:15:35.13,kono-text-jp,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:15:35.89,1:15:37.34,kono-text-jp,,0000,0000,0000,,Қай мысық?
Dialogue: 0,1:15:43.20,1:15:45.68,kono-text-jp,,0000,0000,0000,,Мен ескертулерден шаршадым
Dialogue: 0,1:15:59.71,1:16:01.12,kono-text-jp,,0000,0000,0000,,бәлкім, осы ғана шығар
Dialogue: 0,1:16:12.94,1:16:17.01,kono-text-jp,,0000,0000,0000,,Хитомаруёнсан жаудың 17 ірі ұшағы
Dialogue: 0,1:16:17.01,1:16:19.69,kono-text-jp,,0000,0000,0000,,Луошань үстінде, Луошань қарулы шайқасы кезінде
Dialogue: 0,1:16:19.86,1:16:24.21,kono-text-jp,,0000,0000,0000,,Кейінгі мақсат: Токусима префектурасының оңтүстік-шығысында 30 ұшақ
Dialogue: 0,1:16:24.25,1:16:26.37,kono-text-jp,,0000,0000,0000,,Күреге қарай бет алды
Dialogue: 0,1:16:28.03,1:16:32.10,kono-text-jp,,0000,0000,0000,,Әуе шабуылы туралы ескерту жойылды
Dialogue: 0,1:16:32.32,1:16:33.55,kono-text-jp,,0000,0000,0000,,Басқа сиқыршылардың қосымша күштерінен қашқысы келген бе?
Dialogue: 0,1:16:33.56,1:16:37.63,kono-text-jp,,0000,0000,0000,,5-і күні таңертең жаудың 125 ірі ұшағы шабуылға шықты.
Dialogue: 0,1:16:40.98,1:16:42.01,kono-text-jp,,0000,0000,0000,,Мен үйдемін
Dialogue: 0,1:16:43.87,1:16:45.76,kono-text-jp,,0000,0000,0000,,Амансың ба, Шусаку?
Dialogue: 0,1:16:45.81,1:16:46.72,kono-text-jp,,0000,0000,0000,,Әкем ше?
Dialogue: 0,1:16:47.78,1:16:49.40,kono-text-jp,,0000,0000,0000,,Жоқ, әлі жоқ.
Dialogue: 0,1:16:49.58,1:16:50.47,kono-text-jp,,0000,0000,0000,,Хоука
Dialogue: 0,1:16:54.36,1:16:56.74,kono-text-jp,,0000,0000,0000,,Сузу-сан шашу
Dialogue: 0,1:17:06.10,1:17:08.38,kono-text-jp,,0000,0000,0000,,Сузу-сан кішкентай бала.
Dialogue: 0,1:17:11.70,1:17:13.51,kono-text-jp,,0000,0000,0000,,Тұрса да кішкентай.
Dialogue: 0,1:17:14.93,1:17:16.14,kono-text-jp,,0000,0000,0000,,Бұл не?
Dialogue: 0,1:17:16.32,1:17:17.56,kono-text-jp,,0000,0000,0000,,Қолыңды тигізбе…
Dialogue: 0,1:17:17.92,1:17:19.96,kono-text-jp,,0000,0000,0000,,Кішкентаймын демеңіз.
Dialogue: 0,1:17:32.91,1:17:35.96,kono-text-jp,,0000,0000,0000,,Жарайды, мен сенімдімін қайын ата.
Dialogue: 0,1:17:35.96,1:17:37.04,kono-text-jp,,0000,0000,0000,,Әскери киім
Dialogue: 0,1:17:38.80,1:17:40.50,kono-text-jp,,0000,0000,0000,,Фурошики мазмұны
Dialogue: 0,1:17:41.60,1:17:45.39,kono-text-jp,,0000,0000,0000,,15-інде бірінші дәрежелі заңгер болды.
Dialogue: 0,1:17:45.79,1:17:49.30,kono-text-jp,,0000,0000,0000,,Енді ол солдат болғандықтан, теңіз жаяу әскерінде оқытылады.
Dialogue: 0,1:17:49.52,1:17:50.75,kono-text-jp,,0000,0000,0000,,Наурыз қайтып оралмайды
Dialogue: 0,1:17:52.22,1:17:55.23,kono-text-jp,,0000,0000,0000,,Осыдан кейін қайтып келе аласыз ба?
Dialogue: 0,1:17:55.38,1:17:56.23,kono-text-jp,,0000,0000,0000,,Мүмкін
Dialogue: 0,1:17:57.44,1:17:59.72,kono-text-jp,,0000,0000,0000,,Жақсысың ба, Сузу-сан?
Dialogue: 0,1:18:00.24,1:18:02.23,kono-text-jp,,0000,0000,0000,,Кіші және жіңішке
Dialogue: 0,1:18:02.61,1:18:06.52,kono-text-jp,,0000,0000,0000,,Бұл үйді ер адамсыз ешкім қорғай ала ма?
Dialogue: 0,1:18:07.72,1:18:08.74,kono-text-jp,,0000,0000,0000,,Мен темекі шегуді тастадым
Dialogue: 0,1:18:09.64,1:18:10.74,kono-text-jp,,0000,0000,0000,,Қазір тек екеуміз ғана қалдық.
Dialogue: 0,1:18:16.40,1:18:19.10,kono-text-jp,,0000,0000,0000,,Кешіріңіз, бұл өтірік.
Dialogue: 0,1:18:20.25,1:18:22.06,kono-text-jp,,0000,0000,0000,,Мен сені жақсы көремін
Dialogue: 0,1:18:22.92,1:18:24.99,kono-text-jp,,0000,0000,0000,,Наурызда қайта кездеспесек
Dialogue: 0,1:18:25.00,1:18:27.16,kono-text-jp,,0000,0000,0000,,Сіз тіпті бетіңізді ұмытып кетуіңіз мүмкін.
Dialogue: 0,1:18:27.78,1:18:28.85,kono-text-jp,,0000,0000,0000,,Сузу-сан
Dialogue: 0,1:18:29.21,1:18:31.09,kono-text-jp,,0000,0000,0000,,Джеки мен сені осы үйде күтемін.
Dialogue: 0,1:18:31.55,1:18:35.87,kono-text-jp,,0000,0000,0000,,Осы үйде тұрсаң, Шусаку-санды таба алмауың мүмкін.
Dialogue: 0,1:18:55.46,1:18:57.44,kono-text-jp,,0000,0000,0000,,Егер сіз сурет салсаңыз, оны ұмытасыз ба?
Dialogue: 0,1:18:58.30,1:19:00.03,kono-text-jp,,0000,0000,0000,,Тек ұқсастық
Dialogue: 0,1:19:00.05,1:19:02.73,kono-text-jp,,0000,0000,0000,,Жоқ, Сузу-сан түсінбейді.
Dialogue: 0,1:19:03.01,1:19:05.74,kono-text-jp,,0000,0000,0000,,Қайсысын әдемі деп салдыңыз?
Dialogue: 0,1:19:05.74,1:19:06.96,kono-text-jp,,0000,0000,0000,,Кенкенкен
Dialogue: 0,1:19:07.00,1:19:09.09,kono-text-jp,,0000,0000,0000,,Бұл маңызды құпия.
Dialogue: 0,1:19:23.43,1:19:25.45,kono-text-jp,,0000,0000,0000,,Мен барамын.
Dialogue: 0,1:19:26.83,1:19:27.84,kono-text-jp,,0000,0000,0000,,Кеттік
Dialogue: 0,1:19:29.25,1:19:31.85,kono-text-jp,,0000,0000,0000,,Шусаку, жарты жолда бірге барайық.
Dialogue: 0,1:19:31.86,1:19:32.63,kono-text-jp,,0000,0000,0000,,О
Dialogue: 0,1:19:33.26,1:19:35.17,kono-text-jp,,0000,0000,0000,,Әскери киімдер әдемі.
Dialogue: 0,1:19:37.22,1:19:41.11,kono-text-jp,,0000,0000,0000,,Үй кенеттен үлкейіп кеткендей болды.
Dialogue: 0,1:19:46.24,1:19:47.60,kono-text-jp,,0000,0000,0000,,Ходжо мырзаға
Dialogue: 0,1:19:55.02,1:19:57.87,kono-text-jp,,0000,0000,0000,,Мен бұл үлкен өзара көмек көрсету ауруханасы деп ойладым.
Dialogue: 0,1:19:58.08,1:20:01.60,kono-text-jp,,0000,0000,0000,,Сіз оны таба алмайсыз.
Dialogue: 0,1:20:01.96,1:20:04.25,kono-text-jp,,0000,0000,0000,,Іші мен басынан соққы алған сияқты.
Dialogue: 0,1:20:04.83,1:20:06.52,kono-text-jp,,0000,0000,0000,,Мен ауруханадан шыға жаздадым.
Dialogue: 0,1:20:08.47,1:20:11.28,kono-text-jp,,0000,0000,0000,,Әкем сағатын жөндеуімді өтінді.
Dialogue: 0,1:20:11.95,1:20:16.70,kono-text-jp,,0000,0000,0000,,Иә, бұл мүмкіндік. Мен Шимоносэкидегі Куромура отбасына барамын деп ойлаймын.
Dialogue: 0,1:20:17.21,1:20:18.20,kono-text-jp,,0000,0000,0000,,Тіпті ертең
Dialogue: 0,1:20:19.50,1:20:21.26,kono-text-jp,,0000,0000,0000,,Сен ағаңмен барасың ба?
Dialogue: 0,1:20:21.37,1:20:22.79,kono-text-jp,,0000,0000,0000,,Дайындық
Dialogue: 0,1:20:22.92,1:20:24.12,kono-text-jp,,0000,0000,0000,,Харуми де?
Dialogue: 0,1:20:26.19,1:20:27.15,kono-text-jp,,0000,0000,0000,,Мектеп
Dialogue: 0,1:20:27.15,1:20:28.00,kono-text-jp,,0000,0000,0000,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,1:20:28.34,1:20:30.99,kono-text-jp,,0000,0000,0000,,Барсаң да, топырақпен ойнау, гимнастика жасау ғана.
Dialogue: 0,1:20:32.08,1:20:36.47,kono-text-jp,,0000,0000,0000,,Қыздың саусақтары да
Dialogue: 0,1:20:36.56,1:20:44.78,kono-text-jp-2,,0000,0000,0000,,Бүгін тағы да еліміздің игілігі үшін біз
Dialogue: 0,1:20:43.73,1:20:45.52,kono-text-jp,,0000,0000,0000,,Бұл көп уақытты алады
Dialogue: 0,1:20:46.66,1:20:47.84,kono-text-jp,,0000,0000,0000,,Мен билет сатып аламын.
Dialogue: 0,1:20:47.90,1:20:50.82,kono-text-jp,,0000,0000,0000,,Харумиді әкесіне қонаққа апара аласыз ба?
Dialogue: 0,1:20:52.53,1:20:54.46,kono-text-jp,,0000,0000,0000,,Эй, кеттік, Харуми-чан.
Dialogue: 0,1:20:54.54,1:20:56.70,kono-text-jp,,0000,0000,0000,,Әскери-теңіз күштеріне қосыла аламын ба?
Dialogue: 0,1:20:56.84,1:20:57.63,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,1:21:00.45,1:21:01.99,kono-text-jp,,0000,0000,0000,,Неге сонша аю?
Dialogue: 0,1:21:02.22,1:21:05.12,kono-text-jp,,0000,0000,0000,,Төтенше жағдайда сізде мақтанатын бамбук найзасы жоқ па?
Dialogue: 0,1:21:05.12,1:21:06.09,kono-text-jp,,0000,0000,0000,,Сен ақымақсың ба?
Dialogue: 0,1:21:06.09,1:21:08.31,kono-text-jp,,0000,0000,0000,,Басқа жақтағы ата-анаңнан қорқатын болсаң басқа.
Dialogue: 0,1:21:08.87,1:21:11.46,kono-text-jp,,0000,0000,0000,,Мен өзімді жақсы сезінбеймін...
Dialogue: 0,1:21:11.46,1:21:14.10,kono-text-jp,,0000,0000,0000,,Дәлірек айтсақ, бамбук найзасы бәрібір жақсы.
Dialogue: 0,1:21:14.10,1:21:16.28,kono-text-jp,,0000,0000,0000,,Шимоносеки алыс
Dialogue: 0,1:21:16.31,1:21:17.14,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,1:21:17.34,1:21:19.25,kono-text-jp,,0000,0000,0000,,Хиросимадан алыс па?
Dialogue: 0,1:21:19.28,1:21:20.43,kono-text-jp,,0000,0000,0000,,Бұл өте алыс
Dialogue: 0,1:21:20.45,1:21:21.55,kono-text-jp,,0000,0000,0000,,Мелло
Dialogue: 0,1:21:21.73,1:21:23.78,kono-text-jp,,0000,0000,0000,,Ересектер үшін ауруханаға жатқызу
Dialogue: 0,1:21:23.79,1:21:24.66,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,1:21:28.98,1:21:31.16,kono-text-jp,,0000,0000,0000,,Дұшпандық музыканы айтасыз ба?
Dialogue: 0,1:21:31.17,1:21:33.41,kono-text-jp,,0000,0000,0000,,Сіз уайымдадыңыз.
Dialogue: 0,1:21:33.59,1:21:37.58,kono-text-jp,,0000,0000,0000,,Мен көптен бері ес-түссіз жатырмын, маусым айы болды.
Dialogue: 0,1:21:37.59,1:21:39.42,kono-text-jp,,0000,0000,0000,,Бұл бәрінен де артық болды.
Dialogue: 0,1:21:39.64,1:21:43.10,kono-text-jp,,0000,0000,0000,,Харуми, мен пойызға мініп, ағаммен барамын.
Dialogue: 0,1:21:43.23,1:21:44.06,kono-text-jp,,0000,0000,0000,,Хоука
Dialogue: 0,1:21:44.23,1:21:46.09,kono-text-jp,,0000,0000,0000,,Неғұрлым тезірек болса, соғұрлым жақсы.
Dialogue: 0,1:21:46.09,1:21:48.89,kono-text-jp,,0000,0000,0000,,Эй, сен қандай кемеге міндің?
Dialogue: 0,1:21:49.03,1:21:51.42,kono-text-jp,,0000,0000,0000,,№16 мина іздеуші арнайы катер
Dialogue: 0,1:21:53.65,1:21:56.71,kono-text-jp,,0000,0000,0000,,Мұнда келсең, көп нәрсені үйренесің.
Dialogue: 0,1:21:57.24,1:21:59.15,kono-text-jp,,0000,0000,0000,,Гуанчжоу да жабылды.
Dialogue: 0,1:21:59.18,1:22:03.20,kono-text-jp,,0000,0000,0000,,Сондай-ақ Әскери-теңіз күштерінің өзі армияға сіңеді деген қауесет бар.
Dialogue: 0,1:22:03.72,1:22:06.80,kono-text-jp,,0000,0000,0000,,Сузу-сан, Ямато батып кеткен сияқты.
Dialogue: 0,1:22:06.96,1:22:07.92,kono-text-jp,,0000,0000,0000,,Ямато?
Dialogue: 0,1:22:08.13,1:22:08.96,kono-text-jp,,0000,0000,0000,,О
Dialogue: 0,1:22:09.22,1:22:12.94,kono-text-jp,,0000,0000,0000,,Юкигакуреде қамалып, жаудың алдынан секіріп шықтым.
Dialogue: 0,1:22:13.98,1:22:17.93,kono-text-jp,,0000,0000,0000,,Сето ішкі теңізі де біздің теңіз.
Dialogue: 0,1:22:18.39,1:22:21.88,kono-text-jp,,0000,0000,0000,,Ей, толқындағы қоян әлдеқашан...
Dialogue: 0,1:22:21.97,1:22:22.62,kono-text-jp,,0000,0000,0000,,Иә?
Dialogue: 0,1:22:22.86,1:22:23.59,kono-text-jp,,0000,0000,0000,,Жоқ
Dialogue: 0,1:22:24.06,1:22:26.25,kono-text-jp,,0000,0000,0000,,Джейк, мен айттым.
Dialogue: 0,1:22:26.92,1:22:31.01,kono-text-jp,,0000,0000,0000,,Мен Харумиді Куромурадағы ата-анасының үйіне эвакуациялауды өтіндім.
Dialogue: 0,1:22:31.22,1:22:33.52,kono-text-jp,,0000,0000,0000,,Мен осы жерден өзімді қауіпсіз сезінемін.
Dialogue: 0,1:22:34.90,1:22:36.31,kono-text-jp,,0000,0000,0000,,Сонымен, жеңге...
Dialogue: 0,1:22:36.55,1:22:37.70,kono-text-jp,,0000,0000,0000,,Сәлем Сузу-сан
Dialogue: 0,1:22:38.26,1:22:39.79,kono-text-jp,,0000,0000,0000,,Сен сол жаққа барып қарай аласың ба?
Dialogue: 0,1:22:39.86,1:22:43.25,kono-text-jp,,0000,0000,0000,,Мен мұнда қандай кеме келгенін айтайын.
Dialogue: 0,1:22:43.42,1:22:45.57,kono-text-jp,,0000,0000,0000,,Иә? Сіз оны көре аласыз ба?
Dialogue: 0,1:22:45.71,1:22:47.73,kono-text-jp,,0000,0000,0000,,Тек Чито Тек Чито
Dialogue: 0,1:22:48.07,1:22:49.25,kono-text-jp,,0000,0000,0000,,Мен оны көре алмаймын
Dialogue: 0,1:22:52.10,1:22:54.03,kono-text-jp,,0000,0000,0000,,Мен не істеуім керек?
Dialogue: 0,1:22:54.11,1:22:57.55,kono-text-jp,,0000,0000,0000,,Мен үйге қайта алмаймын, мен бір жерде қоғамдық әуе шабуылына қарсы паналаудамын.
Dialogue: 0,1:22:59.40,1:23:00.93,kono-text-jp,,0000,0000,0000,,Сіз шынымен келе жатырсыз ба?
Dialogue: 0,1:23:01.09,1:23:03.70,kono-text-jp,,0000,0000,0000,,Соңғы кездері мен көп қателесіп жүрмін.
Dialogue: 0,1:23:04.55,1:23:11.34,kono-text-jp,,0000,0000,0000,,Марукю Футасан Токуяма оңтүстік-шығыс жаудың үлкен футаджу ұшағы
Dialogue: 0,1:23:11.37,1:23:12.70,kono-text-jp,,0000,0000,0000,,Куреге барыңыз
Dialogue: 0,1:23:13.81,1:23:16.60,kono-text-jp,,0000,0000,0000,,Әй, бұл жолы шынымен де келді.
Dialogue: 0,1:23:16.60,1:23:18.73,kono-text-jp,,0000,0000,0000,,Кешіріңіз, кіруге болады ма?
Dialogue: 0,1:23:18.73,1:23:19.98,kono-text-jp,,0000,0000,0000,,Ерте қабылдау
Dialogue: 0,1:23:19.98,1:23:23.27,kono-text-jp,,0000,0000,0000,,Тез эвакуациялаңыз!
Dialogue: 0,1:23:26.96,1:23:28.61,kono-text-jp,,0000,0000,0000,,Сузу-сан қорқынышты
Dialogue: 0,1:23:28.61,1:23:29.54,kono-text-jp,,0000,0000,0000,,Жарайды
Dialogue: 0,1:23:30.23,1:23:30.95,kono-text-jp,,0000,0000,0000,,Қараңыз
Dialogue: 0,1:23:33.97,1:23:34.92,kono-text-jp,,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,1:23:35.71,1:23:37.24,kono-text-jp,,0000,0000,0000,,Сәлем, мұнда.
Dialogue: 0,1:23:37.96,1:23:38.85,kono-text-jp,,0000,0000,0000,,Харуми
Dialogue: 0,1:23:39.30,1:23:41.72,kono-text-jp,,0000,0000,0000,,Харуми-чан, сен анаңмен біргесің.
Dialogue: 0,1:23:41.73,1:23:44.00,kono-text-jp,,0000,0000,0000,,Ол бұл жақтан емес.
Dialogue: 0,1:23:44.17,1:23:47.04,kono-text-jp,,0000,0000,0000,,Наганокиден сізге ауруханаға бару үшін
Dialogue: 0,1:23:47.17,1:23:49.37,kono-text-jp,,0000,0000,0000,,Бұл жаман уақыт болды.
Dialogue: 0,1:23:49.81,1:23:50.23,kono-text-jp,,0000,0000,0000,,келді
Dialogue: 0,1:23:50.23,1:23:51.64,kono-text-jp,,0000,0000,0000,,Құлағыңызды жабыңыз, аузыңызды ашыңыз
Dialogue: 0,1:23:51.64,1:23:52.92,kono-text-jp,,0000,0000,0000,,Менің көзім шығып кетті
Dialogue: 0,1:23:54.59,1:23:55.76,kono-text-jp,,0000,0000,0000,,Ыстық
Dialogue: 0,1:23:56.63,1:23:57.32,kono-text-jp,,0000,0000,0000,,Шыдамдылық
Dialogue: 0,1:24:31.27,1:24:34.53,kono-text-jp,,0000,0000,0000,,Бұл су жақсы ма?
Dialogue: 0,1:24:35.23,1:24:35.83,kono-text-jp,,0000,0000,0000,,О
Dialogue: 0,1:24:40.34,1:24:42.19,kono-text-jp,,0000,0000,0000,,Сізге көп рахмет
Dialogue: 0,1:24:42.87,1:24:45.99,kono-text-jp,,0000,0000,0000,,Пойыз...ол әлі кетті ме?
Dialogue: 0,1:24:46.62,1:24:49.27,kono-text-jp,,0000,0000,0000,,Пойыз да қозғалмайды. Күте тұрыңыз, Ринсару.
Dialogue: 0,1:24:50.54,1:24:51.43,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,1:24:58.68,1:25:00.09,kono-text-jp,,0000,0000,0000,,Мен ештеңе көрмеймін
Dialogue: 0,1:25:02.84,1:25:04.80,kono-text-jp,,0000,0000,0000,,Амансың ба?
Dialogue: 0,1:25:04.83,1:25:06.15,kono-text-jp,,0000,0000,0000,,Yes
Dialogue: 0,1:25:06.20,1:25:10.41,kono-text-jp,,0000,0000,0000,,Жарылмаған снарядтар сағаттық бомба болуы мүмкін
Dialogue: 0,1:25:10.49,1:25:12.64,kono-text-jp,,0000,0000,0000,,Тез қаш!
Dialogue: 0,1:25:13.13,1:25:16.45,kono-text-jp,,0000,0000,0000,,Ха, сәттілік!
Dialogue: 0,1:25:16.54,1:25:18.17,kono-text-jp,,0000,0000,0000,,Сәлем Сузу-сан
Dialogue: 0,1:25:18.34,1:25:21.46,kono-text-jp,,0000,0000,0000,,Келесі жолы мен Харумидің ағасын да саламын.
Dialogue: 0,1:25:21.94,1:25:24.61,kono-text-jp,,0000,0000,0000,,Жарылмаған снарядтардың шұңқыр тесігі өте кішкентай.
Dialogue: 0,1:25:24.60,1:25:27.76,kono-text-jp,,0000,0000,0000,,Жақында азаматтық әуе қорғанысы оқу бюллетеніне сәйкес
Dialogue: 0,1:25:27.89,1:25:30.50,kono-text-jp,,0000,0000,0000,,Жау тасталған бомбаның бір бөлігіне айналады.
Dialogue: 0,1:25:31.91,1:25:34.03,kono-text-jp,,0000,0000,0000,,Қауіпті Харуми-чан
Dialogue: 0,1:26:10.16,1:26:12.80,kono-text-jp,,0000,0000,0000,,Бұл басқа, ол басқа.
Dialogue: 0,1:26:12.90,1:26:16.59,kono-text-jp,,0000,0000,0000,,Егер сен соншалықты жаман болсаң, маған үйлен.
Dialogue: 0,1:26:16.88,1:26:20.62,kono-text-jp,,0000,0000,0000,,Енді ойлап қарасам, маған бәрін айтып берді.
Dialogue: 0,1:26:20.92,1:26:23.08,kono-text-jp,,0000,0000,0000,,Мен бармайтын жол болмады.
Dialogue: 0,1:26:24.89,1:26:25.97,kono-text-jp,,0000,0000,0000,,Қарбыз
Dialogue: 0,1:26:27.07,1:26:28.46,kono-text-jp,,0000,0000,0000,,Варабимимочи
Dialogue: 0,1:26:29.49,1:26:30.69,kono-text-jp,,0000,0000,0000,,Жалбыз қант
Dialogue: 0,1:26:31.76,1:26:36.49,kono-text-jp,,0000,0000,0000,,Сол жолда арық болса, мен секіре алар едім.
Dialogue: 0,1:26:37.63,1:26:40.39,kono-text-jp,,0000,0000,0000,,Фурошики сол қолға оралған
Dialogue: 0,1:26:41.48,1:26:43.53,kono-text-jp,,0000,0000,0000,,Харуми-сан оң жақта
Dialogue: 0,1:26:44.65,1:26:47.25,kono-text-jp,,0000,0000,0000,,Мен керісінше болғанын қалаймын.
Dialogue: 0,1:26:48.92,1:26:52.42,kono-text-jp,,0000,0000,0000,,Тым болмаса қонағыңызды шешіп, жүгіріңіз.
Dialogue: 0,1:26:53.74,1:26:55.49,kono-text-jp,,0000,0000,0000,,Төбенің арғы жағында
Dialogue: 0,1:26:55.87,1:26:57.72,kono-text-jp,,0000,0000,0000,,Төбенің арғы жағында...
Dialogue: 0,1:26:58.19,1:27:01.79,kono-text-jp,,0000,0000,0000,,Бұл Тон, бұл Хината.
Dialogue: 0,1:27:02.32,1:27:05.32,kono-text-jp,,0000,0000,0000,,Ямато ана осында.
Dialogue: 0,1:27:08.59,1:27:09.52,kono-text-jp,,0000,0000,0000,,Бұл адам
Dialogue: 0,1:27:11.21,1:27:16.14,kono-text-jp,,0000,0000,0000,,Шынымен Шусаку-санға ұқсас
Dialogue: 0,1:27:17.04,1:27:18.90,kono-text-jp,,0000,0000,0000,,Сіз менімен біргесіз
Dialogue: 0,1:27:19.83,1:27:22.13,kono-text-jp,,0000,0000,0000,,Сіз менімен бірге болғаныңызда...
Dialogue: 0,1:27:22.88,1:27:26.00,kono-text-jp,,0000,0000,0000,,Кешіріңіз...кешіріңіз Харуми-сан
Dialogue: 0,1:27:26.40,1:27:27.93,kono-text-jp,,0000,0000,0000,,Кешіріңіз, жеңге.
Dialogue: 0,1:27:27.93,1:27:29.59,kono-text-jp,,0000,0000,0000,,Кісі өлтіруші
Dialogue: 0,1:27:30.58,1:27:32.26,kono-text-jp,,0000,0000,0000,,Әйтеуір, адамның өмірінің соңы—
Dialogue: 0,1:27:32.35,1:27:33.76,kono-text-jp-2,,0000,0000,0000,,Тоқта!
Dialogue: 0,1:27:32.92,1:27:34.53,kono-text-jp,,0000,0000,0000,,Харумиді қайтару
Dialogue: 0,1:27:34.54,1:27:36.43,kono-text-jp,,0000,0000,0000,,Тофу тарататын кез келді.
Dialogue: 0,1:27:38.30,1:27:40.54,kono-text-jp,,0000,0000,0000,,Әлгі бала да ренжіді.
Dialogue: 0,1:27:40.79,1:27:42.93,kono-text-jp,,0000,0000,0000,,Сіз байыпты бола алмайсыз.
Dialogue: 0,1:27:43.12,1:27:48.21,kono-text-jp,,0000,0000,0000,,Сіздің аман қалғаныңызға қуаныштымыз.
Dialogue: 0,1:27:48.99,1:27:50.32,kono-text-jp,,0000,0000,0000,,Менің ойымша, солай
Dialogue: 0,1:27:51.02,1:27:55.57,kono-text-jp,,0000,0000,0000,,Бұл дүниеде ешкімнің орны жоқ.
Dialogue: 0,1:27:55.57,1:27:56.63,kono-text-jp-2,,0000,0000,0000,,Лин мырза?
Dialogue: 0,1:27:56.25,1:27:56.88,kono-text-jp,,0000,0000,0000,,Адам аяғы тимейтін орынды әдейі таңдаған...
Dialogue: 0,1:27:57.93,1:28:01.80,kono-text-jp,,0000,0000,0000,,Ол кезде менің орным қайда еді?
Dialogue: 0,1:28:02.72,1:28:06.43,kono-text-jp,,0000,0000,0000,,Кейбір тақталар сол тақтай қоршаудан құлап кеткен болуы керек.
Dialogue: 0,1:28:07.39,1:28:09.85,kono-text-jp,,0000,0000,0000,,Егер сіз жарылысқа мініп, сол жерден секірсеңіз
Dialogue: 0,1:28:11.02,1:28:14.08,kono-text-jp,,0000,0000,0000,,Ана жақта, ана жақта
Dialogue: 0,1:28:16.71,1:28:18.81,kono-text-jp,,0000,0000,0000,,Жарайсың, тағы кездескенше.
Dialogue: 0,1:28:18.81,1:28:20.35,kono-text-jp,,0000,0000,0000,,Бұл дыбыс ешқашан шықпайды
Dialogue: 0,1:28:20.38,1:28:21.69,kono-text-jp,,0000,0000,0000,,Ұйқысы бар
Dialogue: 0,1:28:22.06,1:28:25.81,kono-text-jp,,0000,0000,0000,,Бұл үй қандай болды?
Dialogue: 0,1:28:26.32,1:28:29.39,kono-text-jp,,0000,0000,0000,,Эй, уайымдама.
Dialogue: 0,1:28:29.49,1:28:30.82,kono-text-jp,,0000,0000,0000,,Жақсы
Dialogue: 0,1:28:31.51,1:28:32.65,kono-text-jp,,0000,0000,0000,,Бұл өтірік
Dialogue: 0,1:28:33.30,1:28:37.61,kono-text-jp,,0000,0000,0000,,Сол адам менің үйімді бұзды.
Dialogue: 0,1:28:38.29,1:28:41.56,kono-text-jp,,0000,0000,0000,,Мен бұл қаладан абыроймен кете алар ма едім деп ойлаймын.
Dialogue: 0,1:28:44.32,1:28:45.82,kono-text-jp,,0000,0000,0000,,Оны асыра алмаңыз.
Dialogue: 0,1:28:47.53,1:28:50.51,kono-text-jp,,0000,0000,0000,,Жарайды, егер бұл үлкен мәселе болса, мен сізге жұмыста демалыс алуға рұқсат етемін.
Dialogue: 0,1:28:50.51,1:28:51.56,kono-text-jp,,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,1:28:55.20,1:28:57.52,kono-text-jp,,0000,0000,0000,,Иә, күн жарқырайды
Dialogue: 0,1:28:57.64,1:29:00.46,kono-text-jp,,0000,0000,0000,,Таңғыш Сыртынан кептірейік.
Dialogue: 0,1:29:03.89,1:29:05.86,kono-text-jp,,0000,0000,0000,,Қытай аймағының әуе қорғанысы туралы ақпарат
Dialogue: 0,1:29:05.99,1:29:12.07,kono-text-jp-2,,0000,0000,0000,,23:50 Жау ұшақтарының Хиросима шығанағында 2 нысанасы және Суонадада 2 нысанасы бар...
Dialogue: 0,1:29:10.77,1:29:12.72,kono-text-jp,,0000,0000,0000,,Ояна аласың ба, Сузу-сан?
Dialogue: 0,1:29:14.10,1:29:15.39,kono-text-jp,,0000,0000,0000,,Жарайды
Dialogue: 0,1:29:16.12,1:29:20.75,kono-text-jp,,0000,0000,0000,,23:58 Куре мен Хиросима маңындағы жау ұшақтары...
Dialogue: 0,1:29:20.77,1:29:21.69,kono-text-jp,,0000,0000,0000,,Қараңыз
Dialogue: 0,1:29:29.28,1:29:31.74,kono-text-jp,,0000,0000,0000,,Хохо, келіп ал.
Dialogue: 0,1:29:31.76,1:29:33.82,kono-text-jp,,0000,0000,0000,,Мен сені көрмесем де
Dialogue: 0,1:29:37.52,1:29:39.50,kono-text-jp,,0000,0000,0000,,Бұл алау ма?
Dialogue: 0,1:29:43.24,1:29:45.13,kono-text-jp,,0000,0000,0000,,Сузу-сан, сен де тез кел.
Dialogue: 0,1:30:04.60,1:30:06.47,kono-text-jp,,0000,0000,0000,,8-ші отрядтың шабуылы
Dialogue: 0,1:30:16.75,1:30:20.38,kono-text-jp,,0000,0000,0000,,Сузу-сан, сен не істеп жатырсың? Асықшы.
Dialogue: 0,1:30:26.04,1:30:29.18,kono-text-jp,,0000,0000,0000,,Сузу-сан Сузу-сан
Dialogue: 0,1:30:40.27,1:30:42.70,kono-text-jp,,0000,0000,0000,,Сузу-сан, құлап қалдың ба?
Dialogue: 0,1:30:42.85,1:30:45.16,kono-text-jp,,0000,0000,0000,,Көбірек су Көбірек су
Dialogue: 0,1:30:46.78,1:30:48.01,kono-text-jp,,0000,0000,0000,,Жарайды, кеттік.
Dialogue: 0,1:30:49.67,1:30:54.40,kono-text-jp,,0000,0000,0000,,0:20: Алдымен Бунго арнасы арқылы солтүстікке қарай жылжитын жау құрамы
Dialogue: 0,1:30:54.40,1:30:56.65,kono-text-jp,,0000,0000,0000,,Хиросима шығанағы, оңтүстік бөлігі арқылы солтүстікке қарай жылжиды
Dialogue: 0,1:30:56.65,1:30:59.82,kono-text-jp,,0000,0000,0000,,Одан әрі Бунго арнасында солтүстікке қарай бет алған формация
Dialogue: 0,1:30:59.82,1:31:03.45,kono-text-jp,,0000,0000,0000,,және Ашизуридің оңтүстігіндегі теңіздегі 3 нысана
Dialogue: 0,1:31:03.99,1:31:05.51,kono-text-jp,,0000,0000,0000,,Ақпараттың соңы
Dialogue: 0,1:31:05.71,1:31:09.32,kono-text-jp,,0000,0000,0000,,Бұл JOFK Хиросима хабар тарату станциясы
Dialogue: 0,1:31:09.76,1:31:12.06,kono-text-jp,,0000,0000,0000,,Күреде барлығына сәттілік.
Dialogue: 0,1:31:12.14,1:31:14.59,kono-text-jp,,0000,0000,0000,,Күреде барлығына сәттілік.
Dialogue: 0,1:31:17.62,1:31:20.11,kono-text-jp,,0000,0000,0000,,Барлық апаттан зардап шеккендерге
Dialogue: 0,1:31:20.60,1:31:25.11,kono-text-jp,,0000,0000,0000,,Хиросимадан күріш шарлары келеді.
Dialogue: 0,1:31:25.41,1:31:28.72,kono-text-jp,,0000,0000,0000,,Футагва саябағында тарату
Dialogue: 0,1:31:28.73,1:31:31.20,kono-text-jp,,0000,0000,0000,,Апат құрбаны туралы анықтаманы қайдан алуға болады?
Dialogue: 0,1:31:31.20,1:31:33.03,kono-text-jp,,0000,0000,0000,,Қалалық әкімдік әлі бар ма?
Dialogue: 0,1:31:33.03,1:31:34.53,kono-text-jp,,0000,0000,0000,,Ол күйіп қалды.
Dialogue: 0,1:31:34.54,1:31:37.02,kono-text-jp,,0000,0000,0000,,Окопқа түспе, жаныңды сақта.
Dialogue: 0,1:31:37.03,1:31:38.65,kono-text-jp,,0000,0000,0000,,Кешіріңіз, жарай ма?
Dialogue: 0,1:31:38.65,1:31:40.05,kono-text-jp,,0000,0000,0000,,Иә, өтінемін
Dialogue: 0,1:31:42.22,1:31:45.13,kono-text-jp,,0000,0000,0000,,Әй, сен, жылы болғанша тамақтан.
Dialogue: 0,1:31:45.20,1:31:48.78,kono-text-jp,,0000,0000,0000,,Мен еденнің астына тастаған картоп толығымен жанып кетті.
Dialogue: 0,1:31:48.83,1:31:51.24,kono-text-jp,,0000,0000,0000,,Итадакимасу
Dialogue: 0,1:31:51.66,1:31:52.86,kono-text-jp,,0000,0000,0000,,Жездем де...
Dialogue: 0,1:31:54.43,1:31:58.31,kono-text-jp,,0000,0000,0000,,Жоқ, ыстық, ыстық, ыстық
Dialogue: 0,1:31:58.64,1:32:01.77,kono-text-jp,,0000,0000,0000,,Эй, Шинономе қаласында адамдар бар.
Dialogue: 0,1:32:01.77,1:32:04.55,kono-text-jp,,0000,0000,0000,,Асахи қаласынан оңтүстікке қарай жүре алмайсыз.
Dialogue: 0,1:32:04.85,1:32:06.86,kono-text-jp,,0000,0000,0000,,Қызыл жанған аудан да толығымен жанып кетті.
Dialogue: 0,1:32:06.88,1:32:07.85,kono-text-jp,,0000,0000,0000,,Хоука
Dialogue: 0,1:32:09.88,1:32:11.89,kono-text-jp,,0000,0000,0000,,Эй, Сузу-сан
Dialogue: 0,1:32:13.13,1:32:14.63,kono-text-jp,,0000,0000,0000,,Жараланған Тонка
Dialogue: 0,1:32:14.78,1:32:15.86,kono-text-jp,,0000,0000,0000,,Тренинг - бұл
Dialogue: 0,1:32:15.88,1:32:16.68,kono-text-jp,,0000,0000,0000,,Жою
Dialogue: 0,1:32:17.33,1:32:20.17,kono-text-jp,,0000,0000,0000,,Әйтеуір, аман қалғаныңа қуаныштымын.
Dialogue: 0,1:32:21.23,1:32:23.45,kono-text-jp,,0000,0000,0000,,Бұлыңғырлықтың ортасында
Dialogue: 0,1:32:23.45,1:32:24.16,kono-text-jp,,0000,0000,0000,,Сузу-сан
Dialogue: 0,1:32:24.81,1:32:25.89,kono-text-jp-2,,0000,0000,0000,,Эй, Сузу-сан
Dialogue: 0,1:32:24.30,1:32:30.68,kono-text-jp,,0000,0000,0000,,«Мистер Ринді іздеңіз» дегенді естідім.
Dialogue: 0,1:32:33.42,1:32:34.82,kono-text-jp,,0000,0000,0000,,Қалай болғанда да, жақсы болды.
Dialogue: 0,1:32:35.07,1:32:37.40,kono-text-jp,,0000,0000,0000,,Қызуыңыз төмендегеніне қуаныштымын.
Dialogue: 0,1:32:37.41,1:32:40.38,kono-text-jp,,0000,0000,0000,,Жақсы болды, ол жарылып кетпеді.
Dialogue: 0,1:32:40.38,1:32:42.58,kono-text-jp,,0000,0000,0000,,Оны өшіре алғаныңызға қуаныштымын.
Dialogue: 0,1:32:42.62,1:32:44.68,kono-text-jp,,0000,0000,0000,,Тез жазылып кеткеніне қуаныштымын.
Dialogue: 0,1:32:45.01,1:32:46.08,kono-text-jp,,0000,0000,0000,,Жақсы
Dialogue: 0,1:32:46.90,1:32:49.31,kono-text-jp,,0000,0000,0000,,Жақсы, жақсы...
Dialogue: 0,1:32:50.58,1:32:53.97,kono-text-jp,,0000,0000,0000,,Мен оның не жақсы болғанын білмеймін.
Dialogue: 0,1:32:55.84,1:32:59.63,kono-text-jp,,0000,0000,0000,,Джунның оң қолы Харуми-сандікімен жалғанған.
Dialogue: 0,1:33:00.12,1:33:03.99,kono-text-jp,,0000,0000,0000,,Мамыр айында Шусакудың оң қолында ұйықтап жатқан беті бейнеленген
Dialogue: 0,1:33:05.04,1:33:08.80,kono-text-jp,,0000,0000,0000,,Апрельдің оң қолы Теру-санның қызыл қызылын ұстады.
Dialogue: 0,1:33:06.84,1:33:09.01,kono-text-jp-2,,0000,0000,0000,,Наурызда Хисаоның оқулығын оң қолыммен көшіріп алдым.
Dialogue: 0,1:33:09.02,1:33:13.17,kono-text-jp-2,,0000,0000,0000,,Өткен мамырда менің оң қолым лорд Кусунокиге шошынып таяқшаларымды түсіріп алды.
Dialogue: 0,1:33:09.16,1:33:13.29,kono-text-jp,,0000,0000,0000,,Ақпан айында Они-чанның миын көтерген оң қол
Dialogue: 0,1:33:13.18,1:33:16.58,kono-text-jp-2,,0000,0000,0000,,Өткен желтоқсанда менің оң қолым Мизухараның қолын ұстады.
Dialogue: 0,1:33:13.73,1:33:18.70,kono-text-jp,,0000,0000,0000,,Өткен қараша айында менің оң қолым әпкенің кимоносын қиып қателесті.
Dialogue: 0,1:33:19.42,1:33:23.78,kono-text-jp,,0000,0000,0000,,Өткен тамызда мен Линнің оң қолына қарбызды боядым.
Dialogue: 0,1:33:20.57,1:33:24.61,kono-text-jp-2,,0000,0000,0000,,Өткен шілдеде Тон, Хината және әскери полициямен кездескен оң қол.
Dialogue: 0,1:33:24.93,1:33:28.93,kono-text-jp,,0000,0000,0000,,Өткен мамырда менің оң қолым лорд Кусунокиге шошып таяқшамды түсіріп алды.
Dialogue: 0,1:33:26.93,1:33:31.02,kono-text-jp-2,,0000,0000,0000,,Өткен тамызда мен Линнің оң қолына қарбыз суретін салдым.
Dialogue: 0,1:33:30.83,1:33:34.83,kono-text-jp,,0000,0000,0000,,Өткен наурызда мен туған жерімді оң қолыма салдым.
Dialogue: 0,1:33:33.70,1:33:37.43,kono-text-jp-2,,0000,0000,0000,,Өткен жылдың соңында менің оң қолым балдырларды жақсы көрді.
Dialogue: 0,1:33:38.80,1:33:43.22,kono-text-jp,,0000,0000,0000,,Жеті жыл бұрын ақпан айында менің оң қолыма көптеген қояндар сызылған.
Dialogue: 0,1:33:45.22,1:33:47.28,kono-text-jp,,0000,0000,0000,,Әпке, мен көре алмадым.
Dialogue: 0,1:33:47.33,1:33:49.66,kono-text-jp,,0000,0000,0000,,Бұл маңызды емес, Сузу-чан.
Dialogue: 0,1:33:50.80,1:33:54.25,kono-text-jp,,0000,0000,0000,,Суми-чан, сен келдің.
Dialogue: 0,1:33:54.28,1:33:59.15,kono-text-jp,,0000,0000,0000,,Әскер офицері мені құтқару көлігіне мінуімді өтінді.
Dialogue: 0,1:34:00.76,1:34:01.59,kono-text-jp,,0000,0000,0000,,Дұрыс, қозғалғыш жабдық әлі де жұмыс істеп тұр
Dialogue: 0,1:34:02.41,1:34:05.08,kono-text-jp,,0000,0000,0000,,Иә, ескі киім, таза мақта.
Dialogue: 0,1:34:05.22,1:34:06.67,kono-text-jp,,0000,0000,0000,,Суфумен таныстыру
Dialogue: 0,1:34:06.76,1:34:08.38,kono-text-jp,,0000,0000,0000,,Иә, ол бұзылған.
Dialogue: 0,1:34:22.44,1:34:23.83,kono-text-jp,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:34:28.37,1:34:32.46,kono-text-jp,,0000,0000,0000,,Бұл Еба тауында өсетін локаттар.
Dialogue: 0,1:34:33.26,1:34:34.62,kono-text-jp,,0000,0000,0000,,Менде бәрі жақсы.
Dialogue: 0,1:34:34.75,1:34:36.71,kono-text-jp,,0000,0000,0000,,Мен оянсам, менде екпін бар.
Dialogue: 0,1:34:37.02,1:34:38.51,kono-text-jp,,0000,0000,0000,,Мені жарты жолда жібер
Dialogue: 0,1:34:38.67,1:34:41.64,kono-text-jp,,0000,0000,0000,,Өрт сөндіру бекетінің алдында кездесейік.
Dialogue: 0,1:34:41.65,1:34:44.56,kono-text-jp,,0000,0000,0000,,Хойжа өзенінің жағасындағы Ягура - көрнекті орын
Dialogue: 0,1:34:44.98,1:34:47.24,kono-text-jp,,0000,0000,0000,,Жоқ, ол да күйіп кеткен.
Dialogue: 0,1:34:47.26,1:34:48.97,kono-text-jp,,0000,0000,0000,,Әлі тұр
Dialogue: 0,1:34:49.27,1:34:52.09,kono-text-jp,,0000,0000,0000,,Келгенімде офицер мені көріп, таң қалдым.
Dialogue: 0,1:34:52.52,1:34:55.14,kono-text-jp,,0000,0000,0000,,Жас болсаң да мейірімді адам емессің.
Dialogue: 0,1:34:55.59,1:34:58.37,kono-text-jp,,0000,0000,0000,,Сіз маған бұрыннан тамақ билетін бердіңіз.
Dialogue: 0,1:34:58.61,1:35:03.85,kono-text-jp,,0000,0000,0000,,Күреге тұрмысқа шыққан үлкен әпкем бар екенін естеріңізде шығар деп үміттенемін.
Dialogue: 0,1:35:03.92,1:35:05.33,kono-text-jp,,0000,0000,0000,,Маған ұнайды
Dialogue: 0,1:35:05.39,1:35:08.83,kono-text-jp,,0000,0000,0000,,Жоқ, Сузу-чан
Dialogue: 2,1:35:13.55,1:35:15.60,kono-text-jp,,0000,0000,0000,,Бұл қорқынышты.
Dialogue: 0,1:35:26.88,1:35:30.83,kono-text-jp,,0000,0000,0000,,Әуе шабуылдарының бәрінен Күреге жаным ашиды.
Dialogue: 0,1:35:32.02,1:35:36.45,kono-text-jp,,0000,0000,0000,,Үйді бақылай алмасам, үйге жету қиын болар еді.
Dialogue: 0,1:35:38.68,1:35:40.26,kono-text-jp,,0000,0000,0000,,Сәлем Сузу-чан
Dialogue: 0,1:35:41.06,1:35:43.65,kono-text-jp,,0000,0000,0000,,Хиросимаға қайту.
Dialogue: 0,1:35:44.88,1:35:46.95,kono-text-jp,,0000,0000,0000,,Қорқынышты әуе шабуылдары болған жоқ.
Dialogue: 0,1:35:47.13,1:35:49.08,kono-text-jp,,0000,0000,0000,,Они-чан да кетіп қалды.
Dialogue: 0,1:35:49.22,1:35:51.44,kono-text-jp,,0000,0000,0000,,Бұзақылар жоқ.
Dialogue: 0,1:35:53.99,1:35:55.82,kono-text-jp,,0000,0000,0000,,Жоқ.
Dialogue: 0,1:35:56.92,1:36:00.71,kono-text-jp,,0000,0000,0000,,Суми-чанның офицері әдемі ме, жоқ па, соған қарап шешетін шығармын.
Dialogue: 0,1:36:00.77,1:36:03.00,kono-text-jp,,0000,0000,0000,,Иә, бұл таза емес.
Dialogue: 0,1:36:03.19,1:36:04.36,kono-text-jp,,0000,0000,0000,,Өтірік өтірік
Dialogue: 0,1:36:04.44,1:36:05.73,kono-text-jp,,0000,0000,0000,,Жақында кездескенше
Dialogue: 0,1:36:05.73,1:36:06.75,kono-text-jp,,0000,0000,0000,,Игандору
Dialogue: 0,1:36:06.88,1:36:09.36,kono-text-jp,,0000,0000,0000,,Иә, бұл жай ғана ой деп ойлаймын.
Dialogue: 0,1:36:09.95,1:36:12.96,kono-text-jp,,0000,0000,0000,,Келесі айдың 6-сы Энами фестивалі болады.
Dialogue: 0,1:36:13.01,1:36:14.81,kono-text-jp,,0000,0000,0000,,Тезірек үйге келіңізші.
Dialogue: 0,1:36:14.90,1:36:17.20,kono-text-jp,,0000,0000,0000,,Рахмет, Суми-чан
Dialogue: 0,1:36:17.32,1:36:20.19,kono-text-jp,,0000,0000,0000,,Они-чанның қайтыс болғанына қуаныштымын.
Dialogue: 0,1:36:21.14,1:36:22.83,kono-text-jp,,0000,0000,0000,,Біз көлік жүргіземіз.
Dialogue: 0,1:36:23.60,1:36:25.82,kono-text-jp,,0000,0000,0000,,Сол қолыммен салған сурет сияқты
Dialogue: 0,1:37:13.43,1:37:15.92,kono-text-jp-2,,0000,0000,0000,,А-а, мен де бүгін келдім.
Dialogue: 0,1:37:14.83,1:37:18.64,kono-text-jp,,0000,0000,0000,,Ки заттарын көтеріп, тағы да ырылдайтын сияқты.
Dialogue: 0,1:37:18.65,1:37:18.79,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,1:37:18.80,1:37:19.48,kono-text-jp,,0000,0000,0000,,Acchi
Dialogue: 0,1:37:19.48,1:37:22.05,kono-text-jp,,0000,0000,0000,,Сузу-сан, жүре бер.
Dialogue: 0,1:37:29.82,1:37:31.07,kono-text-jp,,0000,0000,0000,,Келме
Dialogue: 0,1:37:32.64,1:37:34.94,kono-text-jp,,0000,0000,0000,,Енді мұнда келуге болмайды.
Dialogue: 0,1:37:45.26,1:37:46.53,kono-text-jp,,0000,0000,0000,,Осылайша
Dialogue: 0,1:37:46.60,1:37:48.30,kono-text-jp,,0000,0000,0000,,Сол жерге дейін қашыңыз.
Dialogue: 0,1:37:48.75,1:37:51.45,kono-text-jp,,0000,0000,0000,,Таудан өткеннен кейін Хиросимаға жетесіз.
Dialogue: 0,1:38:24.09,1:38:25.09,kono-text-jp,,0000,0000,0000,,Өлгің келе ме?
Dialogue: 0,1:38:26.38,1:38:28.52,kono-text-jp,,0000,0000,0000,,Кешіріңіз, құтан...
Dialogue: 0,1:38:28.88,1:38:30.38,kono-text-jp,,0000,0000,0000,,Құтан ұшып өтті.
Dialogue: 0,1:38:31.02,1:38:33.79,kono-text-jp,,0000,0000,0000,,А, олар жағадан қашып кетті.
Dialogue: 0,1:38:34.97,1:38:37.21,kono-text-jp,,0000,0000,0000,,Шусаку-сан
Dialogue: 0,1:38:38.13,1:38:39.59,kono-text-jp,,0000,0000,0000,,Хиросимаға қайту
Dialogue: 0,1:38:44.25,1:38:45.91,kono-text-jp,,0000,0000,0000,,Қайтуды жоспарлайсыз ба?
Dialogue: 0,1:38:47.40,1:38:48.95,kono-text-jp,,0000,0000,0000,,Сіз қолыңызға қамқорсыз ба?
Dialogue: 0,1:38:50.22,1:38:51.68,kono-text-jp,,0000,0000,0000,,Сіз әуе шабуылынан қорқасыз ба?
Dialogue: 0,1:38:52.05,1:38:53.61,kono-text-jp,,0000,0000,0000,,Сіз Харуми туралы айтып отырсыз ба?
Dialogue: 0,1:38:53.76,1:38:56.01,kono-text-jp,,0000,0000,0000,,Дұрыс.
Dialogue: 0,1:38:56.74,1:38:57.85,kono-text-jp,,0000,0000,0000,,Барлығы дұрыс.
Dialogue: 0,1:38:58.06,1:38:59.12,kono-text-jp,,0000,0000,0000,,Мен сізді естімеймін
Dialogue: 0,1:38:59.19,1:39:00.26,kono-text-jp,,0000,0000,0000,,Олардың жылдамдығы да, күші де бір сәт бұрынғыдан мүлде өзгеше — басқа адам сияқты.
Dialogue: 0,1:39:01.80,1:39:03.22,kono-text-jp,,0000,0000,0000,,Сонда неге?
Dialogue: 0,1:39:04.97,1:39:08.18,kono-text-jp,,0000,0000,0000,,Сузу-сан, көңілді болдым.
Dialogue: 0,1:39:08.54,1:39:11.63,kono-text-jp,,0000,0000,0000,,Соңғы бір жарым жылдағы үйіңізге оралыңыз.
Dialogue: 0,1:39:12.27,1:39:14.15,kono-text-jp,,0000,0000,0000,,Мен сенімен бірге жүрмін
Dialogue: 0,1:39:14.42,1:39:15.87,kono-text-jp,,0000,0000,0000,,Флирттік әңгіме де
Dialogue: 0,1:39:17.63,1:39:19.36,kono-text-jp,,0000,0000,0000,,Сіз басқашасыз ба?
Dialogue: 0,1:39:19.40,1:39:21.43,kono-text-jp,,0000,0000,0000,,Ол әрқашан белгісіз үймен бірдей ме?
Dialogue: 0,1:39:24.63,1:39:25.68,kono-text-jp,,0000,0000,0000,,Мен сізді естімеймін
Dialogue: 0,1:39:26.94,1:39:28.15,kono-text-jp,,0000,0000,0000,,Естімейді, естімейді
Dialogue: 0,1:39:28.29,1:39:29.61,kono-text-jp,,0000,0000,0000,,Біреуін де естімеймін.
Dialogue: 0,1:39:29.61,1:39:31.21,kono-text-jp,,0000,0000,0000,,қайтару
Dialogue: 0,1:39:31.22,1:39:33.00,kono-text-jp,,0000,0000,0000,,Хиросимаға қайту
Dialogue: 0,1:39:33.13,1:39:34.43,kono-text-jp,,0000,0000,0000,,Солай ма?
Dialogue: 0,1:39:35.35,1:39:36.62,kono-text-jp,,0000,0000,0000,,Қалағаныңды істе
Dialogue: 0,1:39:49.92,1:39:52.90,kono-text-jp,,0000,0000,0000,,Қытайдың әскери аймағында аспанда жау ұшағы жоқ
Dialogue: 0,1:39:53.34,1:39:56.34,kono-text-jp,,0000,0000,0000,,Қытайдың әскери аймағында аспанда жау ұшағы жоқ
Dialogue: 0,1:39:56.74,1:40:02.02,kono-text-jp,,0000,0000,0000,,Хиросима префектурасының ауданы 7:31 Ескерту жойылды
Dialogue: 0,1:40:03.68,1:40:06.09,kono-text-jp,,0000,0000,0000,,Ол дер кезінде жойылды.
Dialogue: 0,1:40:06.14,1:40:07.89,kono-text-jp,,0000,0000,0000,,Эй, мен кетемін.
Dialogue: 0,1:40:07.94,1:40:10.00,kono-text-jp,,0000,0000,0000,,Қош келдіңіз.
Dialogue: 0,1:40:11.21,1:40:13.77,kono-text-jp,,0000,0000,0000,,Ау, ауырып тұр...
Dialogue: 0,1:40:14.20,1:40:15.64,kono-text-jp,,0000,0000,0000,,Әділ
Dialogue: 0,1:40:16.10,1:40:19.12,kono-text-jp,,0000,0000,0000,,Жаса, таңертеңнен бері ыстық.
Dialogue: 0,1:40:21.20,1:40:22.89,kono-text-jp,,0000,0000,0000,,Мен өзімді жалғыз сезінемін.
Dialogue: 0,1:40:23.41,1:40:25.85,kono-text-jp,,0000,0000,0000,,Сузу-сан жоқ.
Dialogue: 0,1:40:45.63,1:40:47.89,kono-text-jp,,0000,0000,0000,,Сонымен, сағат қанша?
Dialogue: 0,1:40:49.26,1:40:50.22,kono-text-jp,,0000,0000,0000,,Өл!
Dialogue: 0,1:40:50.92,1:40:53.45,kono-text-jp,,0000,0000,0000,,Ха, сағат 10 шамасында.
Dialogue: 0,1:40:57.44,1:40:58.76,kono-text-jp,,0000,0000,0000,,Ха, олай киінуге болмайды.
Dialogue: 0,1:41:10.43,1:41:12.63,kono-text-jp,,0000,0000,0000,,Кешіріңіз, мм...
Dialogue: 0,1:41:13.90,1:41:16.51,kono-text-jp,,0000,0000,0000,,О, бұл кір емес еді.
Dialogue: 0,1:41:18.52,1:41:21.73,kono-text-jp,,0000,0000,0000,,Бүгін сенің ауылыңның мерекесі.
Dialogue: 0,1:41:22.92,1:41:23.45,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,1:41:24.18,1:41:26.27,kono-text-jp,,0000,0000,0000,,Мен демалыс күні үйге баруды жоспарлап отырмын.
Dialogue: 0,1:41:26.78,1:41:29.89,kono-text-jp,,0000,0000,0000,,Мен бүгін ғана ауруханаға жазыла аламын.
Dialogue: 0,1:41:33.83,1:41:35.11,kono-text-jp,,0000,0000,0000,,Қараңыз.
Dialogue: 0,1:41:35.12,1:41:36.12,kono-text-jp,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:41:37.64,1:41:39.61,kono-text-jp,,0000,0000,0000,,Мен бәрібір уақытында үлгермеймін.
Dialogue: 0,1:41:40.25,1:41:42.18,kono-text-jp,,0000,0000,0000,,Дәрігерлер бос емес болса да.
Dialogue: 0,1:41:43.05,1:41:46.66,kono-text-jp,,0000,0000,0000,,Хиросимадағы ауруханаға кіріспе хат жазу керек.
Dialogue: 0,1:41:47.72,1:41:50.27,kono-text-jp,,0000,0000,0000,,Даиичи пойызына билет ала алмай жүрмін.
Dialogue: 0,1:41:53.94,1:41:57.12,kono-text-jp,,0000,0000,0000,,Мен апамның таза мақтасын жөндеймін деп Монпеге бардым.
Dialogue: 0,1:41:57.95,1:42:00.19,kono-text-jp,,0000,0000,0000,,Бір адамға серпімді жіппен киюге болады.
Dialogue: 0,1:42:00.56,1:42:02.62,kono-text-jp,,0000,0000,0000,,Резеңкенің шатасып кеткені үшін кешіріңіз.
Dialogue: 0,1:42:03.52,1:42:06.21,kono-text-jp,,0000,0000,0000,,Рахмет
Dialogue: 0,1:42:10.28,1:42:11.36,kono-text-jp,,0000,0000,0000,,Окабе?
Dialogue: 0,1:42:11.90,1:42:14.57,kono-text-jp,,0000,0000,0000,,Мен сені Харумидің өліміне кінәлаймын.
Dialogue: 0,1:42:15.90,1:42:16.63,kono-text-jp,,0000,0000,0000,,Жоқ
Dialogue: 0,1:42:18.87,1:42:21.42,kono-text-jp,,0000,0000,0000,,Мен сүйген адам ерте қайтыс болды.
Dialogue: 0,1:42:22.18,1:42:24.27,kono-text-jp,,0000,0000,0000,,Эвакуация кезінде дүкен де жойылды.
Dialogue: 0,1:42:25.27,1:42:27.04,kono-text-jp,,0000,0000,0000,,Мен енді балаларымды көре алмаймын.
Dialogue: 0,1:42:28.24,1:42:31.12,kono-text-jp,,0000,0000,0000,,Қандай жағдай болмасын, бұл сен таңдаған жолдың соңы.
Dialogue: 0,1:42:33.09,1:42:34.77,kono-text-jp,,0000,0000,0000,,Осы орайда, сіз
Dialogue: 0,1:42:34.79,1:42:37.41,kono-text-jp,,0000,0000,0000,,Мен танымайтын үйге келіп, қасымдағылардың өтінішімен үйлендім.
Dialogue: 0,1:42:37.73,1:42:39.74,kono-text-jp,,0000,0000,0000,,Жұмысқа мәжбүрлеу
Dialogue: 0,1:42:41.14,1:42:43.78,kono-text-jp,,0000,0000,0000,,Менің ойымша, бұл қызықсыз өмір.
Dialogue: 0,1:42:48.66,1:42:51.17,kono-text-jp,,0000,0000,0000,,Сузу-санның орны да осында.
Dialogue: 0,1:42:51.39,1:42:52.43,kono-text-jp,,0000,0000,0000,,Кез келген жерде
Dialogue: 0,1:42:53.08,1:42:55.97,kono-text-jp,,0000,0000,0000,,Абыр-сабыр болмай, өзіңіз шешіңіз
Dialogue: 0,1:43:07.59,1:43:10.60,kono-text-jp,,0000,0000,0000,,Кейко-чан, дәл қазір бірдеңе жарқ етті ме?
Dialogue: 0,1:43:10.61,1:43:12.02,kono-text-jp,,0000,0000,0000,,It hit me
Dialogue: 0,1:43:12.62,1:43:15.20,kono-text-jp,,0000,0000,0000,,Күн күркіреді ме? Иә, ауа-райы.
Dialogue: 0,1:43:15.77,1:43:18.19,kono-text-jp,,0000,0000,0000,,Өйткені, бұл...
Dialogue: 0,1:43:18.41,1:43:20.04,kono-text-jp,,0000,0000,0000,,Маған жууға бола ма?
Dialogue: 0,1:43:21.20,1:43:23.79,kono-text-jp,,0000,0000,0000,,Эй, күткендей...
Dialogue: 0,1:43:24.39,1:43:26.74,kono-text-jp,,0000,0000,0000,,Сіз осында келе аласыз ба?
Dialogue: 0,1:43:26.80,1:43:27.49,kono-text-jp,,0000,0000,0000,,Ә, қысқа үзіліс жасайық па?
Dialogue: 0,1:43:27.49,1:43:30.53,kono-text-jp,,0000,0000,0000,,Түсінді ме? Кетіңіз. Бұл ыстық.
Dialogue: 0,1:43:40.09,1:43:41.74,kono-text-jp,,0000,0000,0000,,Қазір бұл не?
Dialogue: 0,1:43:44.37,1:43:47.16,kono-text-jp,,0000,0000,0000,,Мен Джофктан ештеңе естімеймін.
Dialogue: 0,1:43:47.17,1:43:48.35,kono-text-jp,,0000,0000,0000,,Сыртта
Dialogue: 0,1:43:48.62,1:43:49.54,kono-text-jp,,0000,0000,0000,,Эй
Dialogue: 0,1:43:50.81,1:43:52.25,kono-text-jp,,0000,0000,0000,,Келіңіз және қараңыз.
Dialogue: 0,1:43:56.41,1:43:59.03,kono-text-jp,,0000,0000,0000,,Бұл не бұлт?
Dialogue: 0,1:44:00.37,1:44:01.06,kono-text-jp,,0000,0000,0000,,Бұлттар?
Dialogue: 0,1:44:02.28,1:44:05.79,kono-text-jp,,0000,0000,0000,,It's a big cloud. Бұл бұлт.
Dialogue: 0,1:44:06.40,1:44:08.22,kono-text-jp,,0000,0000,0000,,Мұнда басыңыз Окаяма хабар тарату станциясы
Dialogue: 0,1:44:08.46,1:44:11.25,kono-text-jp,,0000,0000,0000,,Хиросима хабар тарату станциясы? Хиросима хабар тарату станциясы?
Dialogue: 0,1:44:11.78,1:44:13.38,kono-text-jp,,0000,0000,0000,,Мұнда басыңыз Окаяма хабар тарату станциясы
Dialogue: 0,1:44:13.69,1:44:18.86,kono-text-jp,,0000,0000,0000,,Эй, мен бірдеңені түсіріп алдым деп ойладым, ол Хиросимадағы дөңгелек тақта болып шықты.
Dialogue: 0,1:44:26.03,1:44:29.75,kono-text-jp,,0000,0000,0000,,Қолдарыңыз бос болса, Ринпоканға кейінірек тоқтаңыз.
Dialogue: 0,1:44:31.47,1:44:33.93,kono-text-jp,,0000,0000,0000,,Чита-сан медбике болды ма?
Dialogue: 0,1:44:33.94,1:44:36.97,kono-text-jp,,0000,0000,0000,,Ха, мен бұрын ешқашан зори сандалдарын жасаған емеспін.
Dialogue: 0,1:44:37.44,1:44:39.55,kono-text-jp,,0000,0000,0000,,Айналадағылардың бәрі сондай.
Dialogue: 0,1:44:39.71,1:44:41.04,kono-text-jp,,0000,0000,0000,,Is that okay?
Dialogue: 0,1:44:41.04,1:44:41.57,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,1:44:43.41,1:44:45.78,kono-text-jp,,0000,0000,0000,,А, мен мұны бір қолмен жасай алмаймын.
Dialogue: 0,1:44:45.84,1:44:47.44,kono-text-jp,,0000,0000,0000,,Бұл сізге ұнамайды дегенді білдіре ме?
Dialogue: 0,1:44:47.84,1:44:50.44,kono-text-jp,,0000,0000,0000,,Мына сандалдармен не істеуім керек?
Dialogue: 0,1:44:50.46,1:44:51.70,kono-text-jp,,0000,0000,0000,,Хиросимаға.
Dialogue: 0,1:44:51.86,1:44:54.53,kono-text-jp,,0000,0000,0000,,Өткен айда әуе шабуылындағыдай жолдар еріп кетсе.
Dialogue: 0,1:44:54.58,1:44:56.20,kono-text-jp,,0000,0000,0000,,Ешқандай аяқ киім немесе бітеу жоқ.
Dialogue: 0,1:44:57.26,1:44:58.61,kono-text-jp,,0000,0000,0000,,Біз де бара аламыз ба?
Dialogue: 0,1:44:59.08,1:45:00.32,kono-text-jp,,0000,0000,0000,,No injured people
Dialogue: 0,1:45:00.39,1:45:03.59,kono-text-jp,,0000,0000,0000,,Менің ұлымды солдаттар Хиросимаға алып кетті.
Dialogue: 0,1:45:03.82,1:45:06.08,kono-text-jp,,0000,0000,0000,,Эй, қызық, Шита жүк көлігіне мінеді ме?
Dialogue: 0,1:45:06.38,1:45:09.42,kono-text-jp,,0000,0000,0000,,Хиросима Куреге әуе шабуылы кезінде құтқарылды.
Dialogue: 0,1:45:09.54,1:45:11.28,kono-text-jp,,0000,0000,0000,,Оның орнына ештеңе бермеңіз
Dialogue: 0,1:45:14.40,1:45:15.99,kono-text-jp,,0000,0000,0000,,Бұл сізді байлау қиындықтарынан құтқарады.
Dialogue: 0,1:45:16.29,1:45:18.05,kono-text-jp,,0000,0000,0000,,Мен қиындық тудырмауға тырысамын.
Dialogue: 0,1:45:18.15,1:45:18.91,kono-text-jp,,0000,0000,0000,,Go
Dialogue: 0,1:45:19.81,1:45:20.98,kono-text-jp,,0000,0000,0000,,Сен ақымақсың.
Dialogue: 0,1:45:20.98,1:45:23.26,kono-text-jp,,0000,0000,0000,,Тез, үйге барып, қырқайық.
Dialogue: 0,1:45:23.62,1:45:26.34,kono-text-jp,,0000,0000,0000,,Менің отбасым да жақында Хиросимаға барады.
Dialogue: 0,1:45:27.69,1:45:30.31,kono-text-jp,,0000,0000,0000,,Хиросимаға бомбаның жаңа түрі тасталған көрінеді
Dialogue: 0,1:45:32.21,1:45:33.78,kono-text-jp,,0000,0000,0000,,Сузу отбасы жақсы.
Dialogue: 0,1:45:33.79,1:45:34.69,kono-text-jp,,0000,0000,0000,,Ана
Dialogue: 0,1:45:36.16,1:45:39.96,kono-text-jp,,0000,0000,0000,,Жеңілдік әскери базадан келеді, жақсы.
Dialogue: 0,1:45:50.04,1:45:52.41,kono-text-jp,,0000,0000,0000,,Сіз де Хиросимадан келдіңіз.
Dialogue: 0,1:46:07.69,1:46:10.38,kono-text-jp,,0000,0000,0000,,Отырып өлмейсің.
Dialogue: 0,1:46:10.52,1:46:13.00,kono-text-jp,,0000,0000,0000,,Хиросимадан осы жерге дейін жаяу жүру
Dialogue: 0,1:46:13.00,1:46:15.98,kono-text-jp,,0000,0000,0000,,Күрсін, ешкім білмейді.
Dialogue: 0,1:46:16.13,1:46:18.27,kono-text-jp,,0000,0000,0000,,Бетіңіз де, киіміңіз де жабылған.
Dialogue: 0,1:46:18.33,1:46:20.62,kono-text-jp,,0000,0000,0000,,Ходжоның әйелі, аузыңды жап, осылай істе.
Dialogue: 0,1:46:20.63,1:46:24.15,kono-text-jp,,0000,0000,0000,,Әлгі баланың түрін қарашы, мен оны аяймын.
Dialogue: 0,1:46:27.12,1:46:29.36,kono-text-jp,,0000,0000,0000,,Мен эвкалипт жапырақтарын жинадым.
Dialogue: 0,1:46:29.73,1:46:31.47,kono-text-jp,,0000,0000,0000,,Масалардан қорғау үшін қолданыңыз
Dialogue: 0,1:46:32.65,1:46:33.96,kono-text-jp,,0000,0000,0000,,Рахмет
Dialogue: 0,1:46:34.58,1:46:36.13,kono-text-jp,,0000,0000,0000,,Зейінді болыңыз
Dialogue: 0,1:46:36.38,1:46:36.87,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,1:46:37.19,1:46:37.80,kono-text-jp,,0000,0000,0000,,Хойде
Dialogue: 0,1:46:38.53,1:46:41.54,kono-text-jp,,0000,0000,0000,,Энамиден Джуро Урано Суми Кисено
Dialogue: 0,1:46:42.91,1:46:46.35,kono-text-jp,,0000,0000,0000,,Ито Морита Кусацу Марина Чизуко
Dialogue: 0,1:46:48.35,1:46:50.14,kono-text-jp,,0000,0000,0000,,Менің де ырылдағым келеді
Dialogue: 0,1:46:51.11,1:46:52.99,kono-text-jp,,0000,0000,0000,,Мен ақырын ырылдағым келеді
Dialogue: 0,1:46:53.34,1:46:54.85,kono-text-jp,,0000,0000,0000,,Осы қаланың тұрғындары
Dialogue: 0,1:46:55.80,1:46:57.65,kono-text-jp,,0000,0000,0000,,А, бұл шулы.
Dialogue: 0,1:46:57.89,1:47:00.15,kono-text-jp,,0000,0000,0000,,Мұндай зорлық-зомбылыққа кім көнеді?
Dialogue: 0,1:47:01.76,1:47:04.83,kono-text-jp,,0000,0000,0000,,Өтінемін, осында мәңгілікке келіңіз.
Dialogue: 0,1:47:06.54,1:47:08.09,kono-text-jp,,0000,0000,0000,,Мені алаңдатыңыз
Dialogue: 0,1:47:08.38,1:47:09.66,kono-text-jp,,0000,0000,0000,,Мына ақымақ
Dialogue: 0,1:47:09.99,1:47:12.39,kono-text-jp,,0000,0000,0000,,Идиот ақымақ...
Dialogue: 0,1:47:13.00,1:47:14.58,kono-text-jp,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:47:15.89,1:47:16.68,kono-text-jp,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:47:17.50,1:47:18.97,kono-text-jp,,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,1:47:20.18,1:47:21.35,kono-text-jp,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:47:21.59,1:47:23.42,kono-text-jp,,0000,0000,0000,,Біреуін де жеңе алмайсың.
Dialogue: 0,1:47:23.69,1:47:26.04,kono-text-jp,,0000,0000,0000,,Теңіз жаяу әскері мені тағы қорқытады деп ойлаймын.
Dialogue: 0,1:47:27.32,1:47:28.46,kono-text-jp,,0000,0000,0000,,Сузу-сан
Dialogue: 0,1:47:28.68,1:47:31.20,kono-text-jp,,0000,0000,0000,,Егер сіз АҚШ-тың әскери миссиясын алсаңыз, оны жеткізуіңіз керек.
Dialogue: 0,1:47:31.29,1:47:33.37,kono-text-jp,,0000,0000,0000,,Әскери полиция тағы ұрысады.
Dialogue: 0,1:47:34.21,1:47:36.57,kono-text-jp,,0000,0000,0000,,Жеткізсең де тек күйіп қалады.
Dialogue: 0,1:47:36.88,1:47:40.71,kono-text-jp,,0000,0000,0000,,Қағазды түсіру үшін осылай пайдалансаңыз, қалдықтар аз болады.
Dialogue: 0,1:47:40.99,1:47:42.02,kono-text-jp,,0000,0000,0000,,Сіз жүкті болсаңыз да
Dialogue: 0,1:47:42.75,1:47:45.23,kono-text-jp,,0000,0000,0000,,Жага әжетхананы әзірге ешкімге бермейді.
Dialogue: 0,1:47:45.63,1:47:49.72,kono-text-jp,,0000,0000,0000,,Біздің шайқас – қолымызда бар нәрсені пайдалана отырып өмір сүруді жалғастыру.
Dialogue: 0,1:47:52.20,1:47:53.38,kono-text-jp,,0000,0000,0000,,А, өтінемін, көтеріліңіз.
Dialogue: 0,1:47:53.38,1:47:54.42,kono-text-jp,,0000,0000,0000,,Сәлем
Dialogue: 0,1:47:54.83,1:47:58.35,kono-text-jp,,0000,0000,0000,,Майдан даласында қаза тапқан, борышын өтеу кезінде қаза тапқан
Dialogue: 0,1:47:58.37,1:48:04.06,kono-text-jp,,0000,0000,0000,,Өлместікке ұшырағандар және олардың қайтыс болған отбасылары туралы ойлар.
Dialogue: 0,1:48:04.24,1:48:06.00,kono-text-jp,,0000,0000,0000,,Гонай үшін рип
Dialogue: 0,1:48:06.01,1:48:10.41,kono-text-jp,,0000,0000,0000,,Соғыста жараланып, апатқа ұшыраған.
Dialogue: 0,1:48:10.43,1:48:13.70,kono-text-jp,,0000,0000,0000,,Отбасылық кәсіптен айырылғандардың әл-ауқаты туралы
Dialogue: 0,1:48:13.78,1:48:17.97,kono-text-jp,,0000,0000,0000,,Төзгісізге шыдаңыз Төзгісізге шыдаңыз
Dialogue: 0,1:48:17.99,1:48:20.44,kono-text-jp,,0000,0000,0000,,Бүкіл әлем үшін
Dialogue: 0,1:48:20.26,1:48:25.53,kono-text-jp-2,,0000,0000,0000,,Біз кішіпейілділікпен Ұлы Мәртебелі Императордың дыбысын таратуды аяқтаймыз.
Dialogue: 0,1:48:23.38,1:48:25.75,kono-text-jp,,0000,0000,0000,,А, бітті, бітті
Dialogue: 0,1:48:25.85,1:48:26.98,kono-text-jp,,0000,0000,0000,,...
Dialogue: 0,1:48:27.15,1:48:29.31,kono-text-jp,,0000,0000,0000,,Бұл мен жеңілдім дегенді білдіре ме?
Dialogue: 0,1:48:30.18,1:48:31.16,kono-text-jp,,0000,0000,0000,,Неліктен?
Dialogue: 0,1:48:31.16,1:48:34.40,kono-text-jp,,0000,0000,0000,,Хиросима мен Нагасакиге жаңа бомбалар тасталды
Dialogue: 0,1:48:34.41,1:48:38.15,kono-text-jp,,0000,0000,0000,,Соғысқа Кеңес Одағы да қосылды, сондықтан бұл үлкен мәселе емес.
Dialogue: 0,1:48:39.21,1:48:41.70,kono-text-jp,,0000,0000,0000,,Сіз бұған дайын емессіз бе?
Dialogue: 0,1:48:42.15,1:48:45.02,kono-text-jp,,0000,0000,0000,,Олар соңына дейін шайқаспас па еді?
Dialogue: 0,1:48:45.47,1:48:47.69,kono-text-jp,,0000,0000,0000,,Дәл қазір мұнда әлі бес адам бар.
Dialogue: 0,1:48:47.98,1:48:51.26,kono-text-jp,,0000,0000,0000,,Сол қолым мен екі аяғым болса да.
Dialogue: 0,1:48:59.27,1:49:00.52,kono-text-jp,,0000,0000,0000,,Харуми
Dialogue: 0,1:49:01.46,1:49:03.25,kono-text-jp,,0000,0000,0000,,Харуми
Dialogue: 0,1:49:10.70,1:49:12.22,kono-text-jp,,0000,0000,0000,,Ұш
Dialogue: 0,1:49:12.47,1:49:13.98,kono-text-jp,,0000,0000,0000,,Біздің өткеніміз
Dialogue: 0,1:49:14.89,1:49:17.15,kono-text-jp,,0000,0000,0000,,Менің ойлағаным дұрыс болды
Dialogue: 0,1:49:17.85,1:49:20.86,kono-text-jp,,0000,0000,0000,,Сондықтан мен өзімді ұстауға тырыстым.
Dialogue: 0,1:49:23.33,1:49:27.00,kono-text-jp,,0000,0000,0000,,Теңіздің арғы жағындағы күріш пен соя
Dialogue: 0,1:49:27.01,1:49:30.18,kono-text-jp,,0000,0000,0000,,Менің ойымша, мұндай нәрсе бізге мұны істей алады.
Dialogue: 0,1:49:31.52,1:49:34.62,kono-text-jp,,0000,0000,0000,,Зорлық-зомбылыққа берілу керек емес пе?
Dialogue: 0,1:49:37.69,1:49:42.36,kono-text-jp,,0000,0000,0000,,Мен ештеңені ойламадым. Мен ессіз өлгім келді.
Dialogue: 0,1:49:55.32,1:50:00.08,kono-text-jp,,0000,0000,0000,,Уақыты келгенде, бәрімізде соңғы ой бар деп үміттенемін.
Dialogue: 0,1:50:01.53,1:50:04.14,kono-text-jp,,0000,0000,0000,,Барлығын араластырып, бүгін пісірейік.
Dialogue: 0,1:50:04.60,1:50:06.26,kono-text-jp,,0000,0000,0000,,Барлығы емес
Dialogue: 0,1:50:06.38,1:50:10.07,kono-text-jp,,0000,0000,0000,,Әлі ертең және одан кейінгі күн бар.
Dialogue: 0,1:50:15.87,1:50:22.66,kono-text-jp,,0000,0000,0000,,15, 16 және 17 тамыз
Dialogue: 0,1:50:24.43,1:50:27.85,kono-text-jp,,0000,0000,0000,,Қыркүйек және қазан айлары
Dialogue: 0,1:50:28.43,1:50:30.39,kono-text-jp,,0000,0000,0000,,Қарашада да, келесі жылы да
Dialogue: 0,1:50:31.63,1:50:34.48,kono-text-jp,,0000,0000,0000,,Келесі жыл және 10 жылдан кейін
Dialogue: 0,1:50:35.61,1:50:37.72,kono-text-jp,,0000,0000,0000,,мәңгілік
Dialogue: 0,1:50:49.16,1:50:51.42,kono-text-jp,,0000,0000,0000,,Жарқыраған таза ақ
Dialogue: 0,1:50:51.75,1:50:53.70,kono-text-jp,,0000,0000,0000,,Гарнир не үшін пайдалы?
Dialogue: 0,1:50:53.85,1:50:54.87,kono-text-jp,,0000,0000,0000,,Не?
Dialogue: 0,1:50:55.33,1:50:56.44,kono-text-jp,,0000,0000,0000,,Шусаку
Dialogue: 0,1:50:56.61,1:50:57.44,kono-text-jp,,0000,0000,0000,,Өміріңде —
Dialogue: 0,1:50:57.89,1:51:02.17,kono-text-jp,,0000,0000,0000,,Бұл ретте тәртіпті сақтау әлі де заңды жұмыс.
Dialogue: 0,1:51:02.98,1:51:04.39,kono-text-jp,,0000,0000,0000,,Алдымен соны алайық.
Dialogue: 0,1:51:06.89,1:51:09.78,kono-text-jp,,0000,0000,0000,,Бомба енді құламайды, сондықтан балық жүзбейді.
Dialogue: 0,1:51:10.07,1:51:11.80,kono-text-jp,,0000,0000,0000,,Уайымдамаңыз
Dialogue: 0,1:51:23.49,1:51:25.26,kono-text-jp,,0000,0000,0000,,Сіз не істемексіз?
Dialogue: 0,1:51:25.29,1:51:27.56,kono-text-jp,,0000,0000,0000,,Мен ақ күрішті көрмеймін
Dialogue: 0,1:51:40.40,1:51:42.14,kono-text-jp,,0000,0000,0000,,Қону уақыты келді
Dialogue: 0,1:51:42.79,1:51:44.46,kono-text-jp,,0000,0000,0000,,Отакеге көшеміз
Dialogue: 0,1:51:45.32,1:51:47.46,kono-text-jp,,0000,0000,0000,,Әскери-теңіз күштері жойылғанға дейін
Dialogue: 0,1:51:47.52,1:51:51.68,kono-text-jp,,0000,0000,0000,,Адвокатураның міндеті - қандай жағдай болмасын тәртіпті сақтау.
Dialogue: 0,1:51:53.74,1:51:56.47,kono-text-jp,,0000,0000,0000,,Қараңғы түскенде, Екі қолың болса
Dialogue: 0,1:51:56.56,1:52:01.06,kono-text-jp,,0000,0000,0000,,Мен бұл кісінің қобалжыған қолына ақырын ғана қолымды қоя алсам да.
Dialogue: 0,1:52:02.82,1:52:04.04,kono-text-jp,,0000,0000,0000,,Тыныш, солай емес пе?
Dialogue: 0,1:52:04.04,1:52:05.61,kono-text-jp,,0000,0000,0000,,Барлығың дайындалыңдар.
Dialogue: 0,1:52:06.29,1:52:08.77,kono-text-jp,,0000,0000,0000,,Кешіріңіз, міне.
Dialogue: 0,1:52:10.35,1:52:12.19,kono-text-jp,,0000,0000,0000,,Ха, тезірек үйге қайт.
Dialogue: 0,1:52:13.19,1:52:14.08,kono-text-jp,,0000,0000,0000,,Жақында кездескенше
Dialogue: 0,1:52:17.22,1:52:19.27,kono-text-jp,,0000,0000,0000,,Мен міндетті түрде қайтамын
Dialogue: 0,1:52:19.56,1:52:20.88,kono-text-jp,,0000,0000,0000,,Сузу-сан және Кохену
Dialogue: 0,1:52:22.20,1:52:22.81,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,1:52:25.36,1:52:28.65,kono-text-jp,,0000,0000,0000,,Тұз бен соя соусы баяғыда кетті.
Dialogue: 0,1:52:34.08,1:52:35.39,kono-text-jp,,0000,0000,0000,,Әй, жеңгем
Dialogue: 0,1:52:35.39,1:52:36.49,kono-text-jp,,0000,0000,0000,,О, Сузу-сан
Dialogue: 0,1:52:36.65,1:52:38.53,kono-text-jp,,0000,0000,0000,,Бұл қандай шеру екен деп ойлаймын.
Dialogue: 0,1:52:38.64,1:52:40.99,kono-text-jp,,0000,0000,0000,,Бәрі де болады.
Dialogue: 0,1:52:40.99,1:52:43.03,kono-text-jp,,0000,0000,0000,,Ештеңе жеткіліксіз
Dialogue: 0,1:52:43.67,1:52:44.88,kono-text-jp,,0000,0000,0000,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,1:52:46.23,1:52:49.15,kono-text-jp,,0000,0000,0000,,Бірақ бұл қала да өзгерді.
Dialogue: 0,1:52:49.77,1:52:51.02,kono-text-jp,,0000,0000,0000,,Маған беріңіз
Dialogue: 0,1:52:51.16,1:52:53.81,kono-text-jp,,0000,0000,0000,,Хисао қазір оған еліктеп жатқан жоқ па?
Dialogue: 0,1:52:54.87,1:52:56.25,kono-text-jp,,0000,0000,0000,,Менің ойымша, оны Харуми де жасады.
Dialogue: 0,1:52:56.26,1:53:00.07,kono-text-jp,,0000,0000,0000,,Бұл басқыншы әскерден қалған күріш ботқасы еді.
Dialogue: 0,1:53:02.52,1:53:03.84,kono-text-jp,,0000,0000,0000,,Қағаз қалдықтары
Dialogue: 0,1:53:15.01,1:53:17.11,kono-text-jp,,0000,0000,0000,,Дәмді
Dialogue: 0,1:53:19.74,1:53:22.08,kono-text-jp,,0000,0000,0000,,Бұның дәмі мүлде жоқ.
Dialogue: 0,1:53:23.59,1:53:26.63,kono-text-jp,,0000,0000,0000,,Америкаға жол көрсетсем ше?
Dialogue: 0,1:53:26.90,1:53:28.46,kono-text-jp,,0000,0000,0000,,Шоколад да балауыз
Dialogue: 0,1:53:28.69,1:53:32.35,kono-text-jp,,0000,0000,0000,,Сол шаш үлгісімен сіз мені бала деп қателесе аласыз.
Dialogue: 0,1:53:38.16,1:53:39.59,kono-text-jp,,0000,0000,0000,,Солай ма?
Dialogue: 0,1:53:39.71,1:53:41.99,kono-text-jp,,0000,0000,0000,,Сізбен киім айырбастау
Dialogue: 0,1:53:42.46,1:53:43.72,kono-text-jp,,0000,0000,0000,,Иә.
Dialogue: 0,1:53:44.51,1:53:45.75,kono-text-jp,,0000,0000,0000,,Сіз білмейсіз бе?
Dialogue: 0,1:53:46.42,1:53:49.03,kono-text-jp,,0000,0000,0000,,Маңайда қаза тапқан жауынгер
Dialogue: 0,1:53:49.13,1:53:51.12,kono-text-jp,,0000,0000,0000,,Менің ұлым болса керек.
Dialogue: 0,1:53:52.23,1:53:54.69,kono-text-jp,,0000,0000,0000,,Мен оны ұлым деп танымадым.
Dialogue: 0,1:53:56.80,1:53:59.22,kono-text-jp,,0000,0000,0000,,Сіз де көз алдыңызда Харуми-санды көрдіңіз.
Dialogue: 0,1:54:00.57,1:54:01.26,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,1:54:02.10,1:54:03.16,kono-text-jp,,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:54:07.10,1:54:07.83,kono-text-jp,,0000,0000,0000,,Қалайы
Dialogue: 0,1:54:10.14,1:54:10.91,kono-text-jp,,0000,0000,0000,,Қалайы
Dialogue: 0,1:54:12.10,1:54:13.90,kono-text-jp,,0000,0000,0000,,Мені есіңе түсірсең
Dialogue: 0,1:54:14.58,1:54:16.03,kono-text-jp,,0000,0000,0000,,Күлімсіреңіз
Dialogue: 0,1:54:18.59,1:54:22.76,kono-text-jp,,0000,0000,0000,,Осы дүниеде қалыпты және әдепті болыңыз.
Dialogue: 0,1:54:24.02,1:54:24.76,kono-text-jp,,0000,0000,0000,,Қалайы
Dialogue: 0,1:54:25.35,1:54:26.44,kono-text-jp,,0000,0000,0000,,Харуми-сан
Dialogue: 0,1:54:26.91,1:54:29.70,kono-text-jp,,0000,0000,0000,,Қандай кеме келе жатқанын көрдім, Харуми-сан.
Dialogue: 0,1:54:31.03,1:54:33.64,kono-text-jp,,0000,0000,0000,,Оқиға Аоба болды.
Dialogue: 0,1:54:35.95,1:54:36.77,kono-text-jp,,0000,0000,0000,,Тецу-сан
Dialogue: 0,1:54:37.71,1:54:40.14,kono-text-jp,,0000,0000,0000,,Дәл қазір күлкіңнің шетінде
Dialogue: 0,1:54:40.71,1:54:46.56,kono-text-jp,,0000,0000,0000,,Қоян секірген теңіз, Құтандар өткен аспан қонды.
Dialogue: 0,1:54:51.10,1:54:53.14,kono-text-jp,,0000,0000,0000,,Харуми-сан күліп тұр.
Dialogue: 0,1:54:53.28,1:54:56.90,kono-text-jp,,0000,0000,0000,,Мен Харуми-санды күліп еске алғым келеді.
Dialogue: 0,1:54:57.17,1:55:01.10,kono-text-jp,,0000,0000,0000,,Бұдан былай біз әрқашан күлкі контейнері боламыз.
Dialogue: 0,1:55:01.59,1:55:05.17,kono-text-jp,,0000,0000,0000,,Ей, үнемі жылай берсең босқа.
Dialogue: 0,1:55:05.86,1:55:07.75,kono-text-jp,,0000,0000,0000,,Тұз жоқ
Dialogue: 0,1:55:09.14,1:55:12.18,kono-text-jp,,0000,0000,0000,,Теңіздің тұзды суы әртүрлі.
Dialogue: 0,1:55:12.58,1:55:15.88,kono-text-jp,,0000,0000,0000,,Чизуко-чан апай
Dialogue: 0,1:55:17.36,1:55:18.43,kono-text-jp,,0000,0000,0000,,Сузу-чан
Dialogue: 0,1:55:20.84,1:55:21.84,kono-text-jp,,0000,0000,0000,,Суми-чан
Dialogue: 0,1:55:23.08,1:55:24.27,kono-text-jp,,0000,0000,0000,,Ах Сузу-чан
Dialogue: 0,1:55:24.49,1:55:26.23,kono-text-jp,,0000,0000,0000,,Мен шашымды қимадым.
Dialogue: 0,1:55:26.46,1:55:28.20,kono-text-jp,,0000,0000,0000,,Иә, иә, оян.
Dialogue: 0,1:55:28.44,1:55:29.70,kono-text-jp,,0000,0000,0000,,Мен өзімді жақсы сезінбеймін.
Dialogue: 0,1:55:30.18,1:55:32.20,kono-text-jp,,0000,0000,0000,,Аздап басы айналып кетті
Dialogue: 0,1:55:33.19,1:55:35.69,kono-text-jp,,0000,0000,0000,,О, не деген ұят, апа.
Dialogue: 0,1:55:35.90,1:55:39.98,kono-text-jp,,0000,0000,0000,,Шимоноридің мына суық аспандағы жұмысы көмектесетініне сене алар емеспін.
Dialogue: 0,1:55:42.25,1:55:45.22,kono-text-jp,,0000,0000,0000,,Бұл ересек адам ретінде ұйықтау керек дегенді білдіреді.
Dialogue: 0,1:55:49.60,1:55:55.51,kono-text-jp,,0000,0000,0000,,Әй, егер менің қолым болса, Они-чанның Оңтүстік теңіздегі шытырман оқиғаларын суреттейтін едім.
Dialogue: 0,1:55:55.84,1:55:57.04,kono-text-jp,,0000,0000,0000,,Бұл не?
Dialogue: 0,1:55:57.22,1:55:58.75,kono-text-jp,,0000,0000,0000,,Әй, әңгіме қандай?
Dialogue: 0,1:55:59.05,1:56:02.54,kono-text-jp,,0000,0000,0000,,Онии-чан, көлік кемесі апатқа ұшырады.
Dialogue: 0,1:56:03.51,1:56:07.25,kono-text-jp,,0000,0000,0000,,Оңтүстік аралда пальма жапырақтарынан үй тұрғыз
Dialogue: 0,1:56:07.93,1:56:09.66,kono-text-jp,,0000,0000,0000,,Менің сақалымның бәрі бітті
Dialogue: 0,1:56:10.17,1:56:12.02,kono-text-jp,,0000,0000,0000,,Крокодилді әйеліңе айналдыр
Dialogue: 0,1:56:12.19,1:56:14.37,kono-text-jp,,0000,0000,0000,,Қолтырауынның әйелі
Dialogue: 0,1:56:15.92,1:56:18.67,kono-text-jp,,0000,0000,0000,,Неге Эбаға қайтпайсың, Они-чан?
Dialogue: 0,1:56:19.22,1:56:20.25,kono-text-jp,,0000,0000,0000,,Анам да...
Dialogue: 0,1:56:22.14,1:56:27.15,kono-text-jp,,0000,0000,0000,,Сол күні таңертең анам фестивальге дайындалу үшін қалаға кетті.
Dialogue: 0,1:56:28.61,1:56:31.24,kono-text-jp,,0000,0000,0000,,Әкем екеуміз оны іздедік.
Dialogue: 0,1:56:31.48,1:56:33.19,kono-text-jp,,0000,0000,0000,,Мен оны таба алмадым.
Dialogue: 0,1:56:33.86,1:56:37.63,kono-text-jp,,0000,0000,0000,,Әке, ол қазан айында құлап, бірден өлетін еді.
Dialogue: 0,1:56:38.15,1:56:40.48,kono-text-jp,,0000,0000,0000,,Мен олардың барлығын мектепте пісіретін едім.
Dialogue: 0,1:56:41.20,1:56:43.96,kono-text-jp,,0000,0000,0000,,Кешіріңіз, сізге хабарлауға уақытым болмады.
Dialogue: 0,1:56:45.75,1:56:48.34,kono-text-jp,,0000,0000,0000,,Ерте келмегенім үшін кешіріңіз.
Dialogue: 0,1:56:48.95,1:56:50.92,kono-text-jp,,0000,0000,0000,,Ерте келгеніңізге қуаныштымын.
Dialogue: 0,1:56:51.82,1:56:54.80,kono-text-jp,,0000,0000,0000,,Сузу-чан, мынау сияқты
Dialogue: 0,1:56:55.52,1:56:57.78,kono-text-jp,,0000,0000,0000,,Оның жазылатынын білмеймін.
Dialogue: 0,1:56:57.87,1:56:58.83,kono-text-jp,,0000,0000,0000,,Ол сауығып кетеді
Dialogue: 0,1:56:59.03,1:57:00.63,kono-text-jp,,0000,0000,0000,,Емделмесе біртүрлі.
Dialogue: 0,1:57:03.52,1:57:09.13,kono-chaqu-jp,,0000,0000,0000,,Макифую деп аталса да
Dialogue: 0,1:57:09.50,1:57:18.76,kono-chaqu-jp,,0000,0000,0000,,Жылы жел соғып тұр
Dialogue: 0,1:57:21.38,1:57:33.65,kono-chaqu-jp,,0000,0000,0000,,Уақыт өтіп, маған теңіздің иісі келді.
Dialogue: 0,1:57:42.10,1:57:48.26,kono-chaqu-jp,,0000,0000,0000,,Жолда біраз қоқыс
Dialogue: 0,1:57:48.26,1:57:52.46,kono-chaqu-jp,,0000,0000,0000,,Жарқыраған күлкі
Dialogue: 0,1:57:53.42,1:58:03.30,kono-chaqu-jp,,0000,0000,0000,,Арқаңды сипап күннің алақаны
Dialogue: 0,1:58:16.73,1:58:22.61,kono-chaqu-jp,,0000,0000,0000,,Құшағыңызды балдырдың кешкі қараңғылығы
Dialogue: 0,1:58:39.40,1:58:45.34,kono-chaqu-jp,,0000,0000,0000,,Мен Сузуменің қызметшісін естуді ұмытып кетіппін
Dialogue: 0,1:58:49.67,1:58:55.52,kono-chaqu-jp,,0000,0000,0000,,Одуванчик үлбірін мен де сағындым.
Dialogue: 0,1:58:55.95,1:59:02.69,kono-chaqu-jp,,0000,0000,0000,,Бұлттардың арасындағы күн сәулесіне түсе алмады
Dialogue: 0,1:59:02.69,1:59:12.87,kono-chaqu-jp,,0000,0000,0000,,Қасымда ұйықтап жатқан адамның түсін де білмеймін.
Dialogue: 0,1:59:14.91,1:59:23.92,kono-chaqu-jp,,0000,0000,0000,,Күнделікті жолдың өзі сәтсіздікке ұшырайды
Dialogue: 0,1:59:27.87,1:59:30.93,kono-chaqu-jp,,0000,0000,0000,,Үлкен жылдамдықпен
Dialogue: 0,1:59:30.93,1:59:34.06,kono-chaqu-jp,,0000,0000,0000,,Жадқа айналу
Dialogue: 0,1:59:34.22,1:59:40.90,kono-chaqu-jp,,0000,0000,0000,,Жарқыраған күндер артта қалды
Dialogue: 0,1:59:43.27,1:59:45.40,kono-chaqu-jp,,0000,0000,0000,,Сіз
Dialogue: 0,1:59:45.87,1:59:53.49,kono-chaqu-jp,,0000,0000,0000,,Мен ештеңе істей алмаймын
Dialogue: 0,1:59:54.96,2:00:00.54,kono-chaqu-jp,,0000,0000,0000,,Сіз және осы дүниедегі басқалар
Dialogue: 0,2:00:00.54,2:00:05.03,kono-chaqu-jp,,0000,0000,0000,,Бұл жәй ғана сынық
Dialogue: 0,2:00:05.93,2:00:10.92,kono-chaqu-jp,,0000,0000,0000,,Мен сені қатты сағындым
Dialogue: 0,2:00:10.92,2:00:18.00,kono-chaqu-jp,,0000,0000,0000,,біреудің немесе бір нәрсенің бөлігі
Dialogue: 0,2:00:23.78,2:00:29.80,kono-chaqu-jp,,0000,0000,0000,,Бұл жай ғана заттардың жиынтығы.
Dialogue: 0,2:00:32.22,2:00:33.33,kono-chaqu-jp,,0000,0000,0000,,Сонымен
Dialogue: 0,2:00:33.33,2:00:34.74,kono-chaqu-jp,,0000,0000,0000,,Кез келген уақытта
Dialogue: 0,2:00:34.99,2:00:37.81,kono-chaqu-jp,,0000,0000,0000,,Дайындалды
Dialogue: 0,2:00:37.88,2:00:42.42,kono-chaqu-jp,,0000,0000,0000,,Сіздің орналасқан жеріңіз
Dialogue: 0,2:00:49.08,2:00:54.30,kono-chaqu-jp,,0000,0000,0000,,Барлық жерде тұратын махаббат
Dialogue: 0,2:00:54.30,2:00:59.81,kono-chaqu-jp,,0000,0000,0000,,Барлық жерде тұратын махаббат
Dialogue: 0,2:01:00.29,2:01:05.48,kono-chaqu-jp,,0000,0000,0000,,Бұл әлем өзгеруде
Dialogue: 0,2:01:05.86,2:01:11.57,kono-chaqu-jp,,0000,0000,0000,,Мұнда және жерде тұру
Dialogue: 0,2:01:14.67,2:01:20.09,kono-chaqu-jp,,0000,0000,0000,,Шексіз махаббат
Dialogue: 0,2:01:24.92,2:01:27.57,kono-chaqu-jp,,0000,0000,0000,,Мұнда қараңыз.
Dialogue: 0,2:01:27.62,2:01:30.77,kono-chaqu-jp,,0000,0000,0000,,Енді бұл да
Dialogue: 0,2:01:31.08,2:01:33.35,kono-chaqu-jp,,0000,0000,0000,,Сіздің
Dialogue: 0,2:01:33.35,2:01:38.22,kono-chaqu-jp,,0000,0000,0000,,бөлігі болады
Dialogue: 0,1:57:08.38,1:57:09.49,kono-text-jp,,0000,0000,0000,,Ах, Сачико-сан
Dialogue: 0,1:57:10.60,1:57:11.33,kono-text-jp,,0000,0000,0000,,Жоқ
Dialogue: 0,1:57:14.76,1:57:17.52,kono-text-jp,,0000,0000,0000,,Киёоко-сан Киоко-сан!
Dialogue: 0,1:57:19.46,1:57:23.40,kono-text-jp,,0000,0000,0000,,Бұл қалада барлығы біреуді жоғалтып алып, іздеп жүр.
Dialogue: 0,1:57:23.99,1:57:28.21,kono-text-jp,,0000,0000,0000,,Мен де Рин-санды бір-екі рет көргендей болдым.
Dialogue: 0,1:57:29.91,1:57:30.87,kono-text-jp,,0000,0000,0000,,Сузу-сан
Dialogue: 0,1:57:34.17,1:57:35.66,kono-text-jp,,0000,0000,0000,,Аман болыңыз.
Dialogue: 0,1:57:36.44,1:57:39.04,kono-text-jp,,0000,0000,0000,,Әскери-теңіз күштері де қараша айы бойы шулады.
Dialogue: 0,1:57:39.13,1:57:40.16,kono-text-jp,,0000,0000,0000,,Қолайсыздық үшін кешірім сұраймын.
Dialogue: 0,1:57:41.72,1:57:42.68,kono-text-jp,,0000,0000,0000,,Сузу-сан
Dialogue: 0,1:57:43.70,1:57:47.93,kono-text-jp,,0000,0000,0000,,Осы көпірде мен және Сузу алғаш рет кездестік.
Dialogue: 0,1:57:49.16,1:57:51.24,kono-text-jp,,0000,0000,0000,,Мен ол күндерге қайта оралмаймын
Dialogue: 0,1:57:51.91,1:57:55.45,kono-text-jp,,0000,0000,0000,,Менің ойымша, бұл қала және біз өзгереміз.
Dialogue: 0,1:57:55.67,1:57:57.95,kono-text-jp,,0000,0000,0000,,Менің кім екенімді әрқашан біле аласыз.
Dialogue: 0,1:57:58.44,1:58:01.15,kono-text-jp,,0000,0000,0000,,Бұл жерде мең бар, оны бірден білесің
Dialogue: 0,1:58:02.40,1:58:04.41,kono-text-jp,,0000,0000,0000,,Рахмет Шусаку-сан
Dialogue: 0,1:58:04.87,1:58:08.34,kono-text-jp,,0000,0000,0000,,Әлемнің осы бұрышында бізді бақылағаныңыз үшін рахмет.
Dialogue: 0,1:58:08.85,1:58:10.90,kono-text-jp,,0000,0000,0000,,Енді мені тастап кет
Dialogue: 0,1:58:11.24,1:58:13.40,kono-text-jp,,0000,0000,0000,,Мәңгі қасымда болшы
Dialogue: 0,1:59:25.67,1:59:27.04,kono-text-jp,,0000,0000,0000,,Жәй ғана кішкентай сызат жеткілікті.
Dialogue: 0,1:59:27.28,1:59:30.94,kono-text-jp,,0000,0000,0000,,Қалай болғанда да, мен Хиросимадан жұмыс тапқаныма қуаныштымын.
Dialogue: 0,1:59:30.94,1:59:31.49,kono-text-jp,,0000,0000,0000,,Иә
Dialogue: 0,1:59:35.03,1:59:38.30,kono-text-jp,,0000,0000,0000,,Бірақ бұл алыс және қиын.
Dialogue: 0,1:59:38.30,1:59:39.37,kono-text-jp,,0000,0000,0000,,Учиха
Dialogue: 0,1:59:43.89,1:59:47.58,kono-text-jp,,0000,0000,0000,,Рахмет, тамақ ішіңіз.
Dialogue: 0,1:59:47.83,1:59:51.32,kono-text-jp,,0000,0000,0000,,Мен үйден кетіп, осында отбасын құруым керек пе?
Dialogue: 0,1:59:51.86,1:59:54.38,kono-text-jp,,0000,0000,0000,,Мұнда сенің енең мен Суми-сан да бар.
Dialogue: 0,1:59:54.74,1:59:58.78,kono-text-jp,,0000,0000,0000,,Жоқ, біз сонда барамыз.
Dialogue: 0,1:59:58.99,2:00:01.32,kono-text-jp,,0000,0000,0000,,Мен де Хиросима үшін алаңдаймын.
Dialogue: 0,2:00:01.60,2:00:04.89,kono-text-jp,,0000,0000,0000,,Күре – біз таңдаған жер.
Dialogue: 0,2:00:24.77,2:00:28.38,kono-text-jp,,0000,0000,0000,,Ву Ву
Dialogue: 0,2:00:28.38,2:00:29.15,kono-text-jp,,0000,0000,0000,,Маған беріңіз
Dialogue: 0,2:00:29.87,2:00:32.17,kono-text-jp,,0000,0000,0000,,Иә, бұл Күре.
Dialogue: 0,2:00:32.64,2:00:35.02,kono-text-jp,,0000,0000,0000,,Оны тоғыз аумақ қорғайды.
Dialogue: 0,2:00:35.39,2:00:37.39,kono-text-jp,,0000,0000,0000,,Эй, ол "Кюрё" деп аталады
Dialogue: 0,2:00:37.90,2:00:40.61,kono-text-jp,,0000,0000,0000,,Оң жақтағы нонға тыныққан тау
Dialogue: 0,2:00:40.78,2:00:42.75,kono-text-jp,,0000,0000,0000,,Сол жағы - Хачимаки тауы
Dialogue: 0,2:00:44.15,2:00:47.83,kono-text-jp,,0000,0000,0000,,Хайгаминнің ортаңғы шыңы
Dialogue: 0,2:00:50.91,2:00:53.95,kono-text-jp,,0000,0000,0000,,Бұл етек біздің үй.
Dialogue: 0,2:01:03.00,2:01:04.63,kono-text-jp,,0000,0000,0000,,Бұл бала
Dialogue: 0,2:01:06.27,2:01:08.53,kono-text-jp,,0000,0000,0000,,Қорқынышты бит.
Dialogue: 0,2:01:09.17,2:01:13.04,kono-text-jp,,0000,0000,0000,,Үлкен қазанға суды қайнатып, барлық киімдерді қайнатыңыз.
Dialogue: 0,2:01:13.41,2:01:15.47,kono-text-jp,,0000,0000,0000,,Әзірше жуынып алайық.
Dialogue: 0,2:01:15.47,2:01:18.16,kono-text-jp,,0000,0000,0000,,Осы бала соңғы болғаны жақсы емес пе?
Dialogue: 0,2:01:18.24,2:01:19.62,kono-text-jp,,0000,0000,0000,,Әйтеуір, ваннада от бар.
Dialogue: 0,2:01:19.63,2:01:20.32,kono-text-jp,,0000,0000,0000,,С… Сол әйел
Dialogue: 0,2:01:21.41,2:01:25.05,kono-text-jp,,0000,0000,0000,,Харумидің былтырғы киімдері тым кішкентай емес.
Dialogue: 0,2:01:59.41,2:02:04.12,kono-ed-jp,,0000,0000,0000,,Құстар әкелген тұқымдар
Dialogue: 0,2:02:04.23,2:02:08.59,kono-ed-jp,,0000,0000,0000,,Тыныш тыныс алу
Dialogue: 0,2:02:09.23,2:02:13.51,kono-ed-jp,,0000,0000,0000,,Қандай табиғат көріністері таралады?
Dialogue: 0,2:02:13.51,2:02:19.72,kono-ed-jp,,0000,0000,0000,,Топырақта елестетіңіз
Dialogue: 0,2:02:27.51,2:02:31.79,kono-ed-jp,,0000,0000,0000,,Қарап көрейік пе?
Dialogue: 0,2:02:32.44,2:02:36.82,kono-ed-jp,,0000,0000,0000,,Мен біраз қорқамын
Dialogue: 0,2:02:37.20,2:02:41.54,kono-ed-jp,,0000,0000,0000,,Күнбағысқа толы әлемді көргім келеді
Dialogue: 0,2:02:41.62,2:02:47.88,kono-ed-jp,,0000,0000,0000,,Бұл сезім айнымас
Dialogue: 0,2:02:51.38,2:02:59.93,kono-ed-jp,,0000,0000,0000,,Желдің тонусы өзгергенде
Dialogue: 0,2:03:01.28,2:03:11.73,kono-ed-jp,,0000,0000,0000,,Жаңбыр тікенектері кеткенде
Dialogue: 0,2:03:30.03,2:03:34.38,kono-ed-jp,,0000,0000,0000,,Бұл әлем сен үшін
Dialogue: 0,2:03:34.59,2:03:39.26,kono-ed-jp,,0000,0000,0000,,Ол неге ұқсайды?
Dialogue: 0,2:03:39.45,2:03:44.06,kono-ed-jp,,0000,0000,0000,,Міне, мен тамырымды қойдым
Dialogue: 0,2:03:44.23,2:03:49.01,kono-ed-jp,,0000,0000,0000,,Түс ортасында күрсініп
Dialogue: 0,2:03:49.02,2:04:05.04,kono-ed-jp,,0000,0000,0000,,Алыстағы аспанды үлбіреген
Dialogue: 0,2:04:05.16,2:04:09.92,kono-ed-jp,,0000,0000,0000,,Өткізіп жіберу
Dialogue: 0,2:04:31.26,2:04:35.03,kono-ed-jp,,0000,0000,0000,,Орындалмайтын тілектер
Dialogue: 0,2:04:36.19,2:04:39.86,kono-ed-jp,,0000,0000,0000,,Қол жеткізе алмайтын сезімдер
Dialogue: 0,2:04:40.68,2:04:45.29,kono-ed-jp,,0000,0000,0000,,Ол терең терең түске айналады
Dialogue: 0,2:04:45.33,2:04:52.25,kono-ed-jp,,0000,0000,0000,,Мені ақырын боя
Dialogue: 0,2:04:54.23,2:04:58.01,kono-ed-jp,,0000,0000,0000,,Бұл шатырдың арғы жағында
Dialogue: 0,2:04:59.06,2:05:02.55,kono-ed-jp,,0000,0000,0000,,Келесі қалаға
Dialogue: 0,2:05:03.93,2:05:12.81,kono-ed-jp,,0000,0000,0000,,Белгісіз біреудің бақшасына
Dialogue: 0,2:05:13.81,2:05:17.19,kono-ed-jp,,0000,0000,0000,,Кейбіреулері басылды
Dialogue: 0,2:05:18.65,2:05:22.28,kono-ed-jp,,0000,0000,0000,,Кейбіреулері кемелерде
Dialogue: 0,2:05:23.51,2:05:33.71,kono-ed-jp,,0000,0000,0000,,Иығыңа жете алсам
Dialogue: 0,2:05:50.72,2:05:55.08,kono-ed-jp,,0000,0000,0000,,Кішкентай от жанып жатыр
Dialogue: 0,2:05:55.64,2:06:00.07,kono-ed-jp,,0000,0000,0000,,Топырақта үнсіз
Dialogue: 0,2:06:00.57,2:06:04.87,kono-ed-jp,,0000,0000,0000,,Ертең еркіндік уақыты келгенде
Dialogue: 0,2:06:04.90,2:06:12.46,kono-ed-jp,,0000,0000,0000,,Мен сені кездестіретініме сенімдімін
Dialogue: 0,2:06:13.96,2:06:19.96,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory
