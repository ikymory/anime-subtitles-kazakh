Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:33.65,0:00:35.03,Default,,0,0,0,,Мұнда күт
Dialogue: 0,0:00:41.33,0:00:42.87,Default,,0,0,0,,Тез аяқталады
Dialogue: 0,0:01:07.56,0:01:10.48,Default,,0,0,0,,Біраз уақыт өтті, №1
Dialogue: 0,0:01:11.27,0:01:14.57,Default,,0,0,0,,Рабу...
Dialogue: 0,0:01:14.90,0:01:16.11,Default,,0,0,0,,О
Dialogue: 0,0:01:16.57,0:01:19.78,Default,,0,0,0,,Бұл да бүгін аяқталады.
Dialogue: 0,0:01:59.91,0:02:00.91,Default,,0,0,0,,Не болды?
Dialogue: 0,0:02:02.24,0:02:03.62,Default,,0,0,0,,Неге маған шабуыл жасап тұрсың?
Dialogue: 0,0:03:00.34,0:03:05.18,Default,,0,0,0,,Соңында «№1» атағын алды
Dialogue: 0,0:03:18.32,0:03:21.86,Default,,0,0,0,,Мына бас таңғышты маңдайыңызға ораңыз...
Dialogue: 0,0:03:27.49,0:03:30.91,Default,,0,0,0,,Мен құдай болып, әлемді билеймін
Dialogue: 0,0:03:43.01,0:03:46.68,Default,,0,0,0,,Мұндай көріністі көру өте аянышты.
Dialogue: 0,0:03:52.39,0:03:54.73,Default,,0,0,0,,Бұл сәт сиқырға айналады...
Dialogue: 0,0:03:56.06,0:03:58.57,Default,,0,0,0,,Маған деген өшпенділіктен тозған
Dialogue: 0,0:04:02.11,0:04:05.99,Default,,0,0,0,,Құдаймен күресуге сенімді болған кезіңізде келіңіз.
Dialogue: 0,0:05:05.26,0:05:08.80,Default,,0,0,0,,Мұның бәрі сіз үшін.
Dialogue: 0,0:05:09.76,0:05:11.76,Default,,0,0,0,,Афро самурай!
Dialogue: 0,0:05:15.94,0:05:20.86,Default,,0,0,0,,Бұл 20 адам, толық қаруланған және толығымен қоршалған.
Dialogue: 0,0:05:20.94,0:05:23.53,Default,,0,0,0,,Өзіңіздің ақымақ әрекеттеріңізге алаңдамаңыз.
Dialogue: 0,0:05:24.19,0:05:29.49,Default,,0,0,0,,Сол мата үшін көп ақша төлейтін адамдар бар.
Dialogue: 0,0:05:30.58,0:05:31.83,Default,,0,0,0,,Тыныш-
Dialogue: 0,0:05:32.58,0:05:34.45,Default,,0,0,0,,Бейтаныс
Dialogue: 0,0:05:40.75,0:05:44.76,Default,,0,0,0,,Сен сонша өлгің келе ме? Өзіңізге ұнайтын нәрсені жасаңыз.
Dialogue: 0,0:05:46.47,0:05:47.88,Default,,0,0,0,,Міне, басталды!
Dialogue: 0,0:06:14.49,0:06:19.87,Default,,0,0,0,,Қараңдаршы, ол бізді бір қылышпен жеңетін сияқты.
Dialogue: 0,0:06:23.04,0:06:25.00,Default,,0,0,0,,Оны кесектерге кесіңіз!
Dialogue: 0,0:06:40.77,0:06:41.90,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:06:42.44,0:06:43.56,Default,,0,0,0,,Бұл өтірік
Dialogue: 0,0:06:43.69,0:06:44.57,Default,,0,0,0,,(ДжоДжо) Шынында да, ол адам болса жақсы болар еді.
Dialogue: 0,0:06:44.77,0:06:46.82,Default,,0,0,0,,Бейбақты өлтіріңіз
Dialogue: 0,0:08:28.25,0:08:31.21,Default,,0,0,0,,Сіздің аңыз т.б.
Dialogue: 0,0:08:31.67,0:08:34.76,Default,,0,0,0,,Мен бұған сенбедім
Dialogue: 0,0:08:35.47,0:08:39.26,Default,,0,0,0,,Бұл баланы қорқыту үшін ойдан шығарылған әңгіме.
Dialogue: 0,0:08:40.52,0:08:45.52,Default,,0,0,0,,Бірақ шынымен де «Құдайға қарсы шыққан зұлым жындар» болды.
Dialogue: 0,0:08:45.65,0:08:47.52,Default,,0,0,0,,Сізге не керек?
Dialogue: 0,0:08:48.06,0:08:52.94,Default,,0,0,0,,Әділеттің одақтасы ақымаққа ұқсамайды.
Dialogue: 0,0:08:56.49,0:09:00.49,Default,,0,0,0,,Қалайша қатыгез боласың?
Dialogue: 0,0:09:08.04,0:09:11.96,Default,,0,0,0,,Тек кек алу
Dialogue: 0,0:09:43.37,0:09:45.25,Default,,0,0,0,,YO! Афро!
Dialogue: 0,0:09:46.25,0:09:50.59,Default,,0,0,0,,Мен түсіндім. Бұл өте өлтіреді.
Dialogue: 0,0:09:53.92,0:09:58.59,Default,,0,0,0,,Бірақ, сіз еш нәрсеге қарамастан соншалықты алысқа баруға дайынсыз ба?
Dialogue: 0,0:09:58.72,0:10:03.26,Default,,0,0,0,,Сізде адамның жүрегі бар ма?
Dialogue: 0,0:10:13.65,0:10:18.90,Default,,0,0,0,,Егер сіз мені қатты ашуландырсаңыз, мен сізге ермеймін.
Dialogue: 0,0:10:18.99,0:10:21.07,Default,,0,0,0,,Бұл жақсы ма?
Dialogue: 0,0:10:21.41,0:10:27.75,Default,,0,0,0,,Сізге біртүрлі монах қарап тұрды.
Dialogue: 0,0:10:29.17,0:10:32.13,Default,,0,0,0,,Өзіңізді жайсыз сезінбейсіз бе?
Dialogue: 0,0:10:32.63,0:10:35.21,Default,,0,0,0,,YO! Күте тұрыңыз
Dialogue: 0,0:10:35.80,0:10:37.59,Default,,0,0,0,,Бір минут.
Dialogue: 0,0:10:37.92,0:10:39.30,Default,,0,0,0,,Афро!
Dialogue: 0,0:10:56.36,0:10:57.82,Default,,0,0,0,,Бұл қиын.
Dialogue: 0,0:10:59.74,0:11:00.45,Default,,0,0,0,,Не?
Dialogue: 0,0:11:03.28,0:11:04.58,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:11:06.74,0:11:09.58,Default,,0,0,0,,Сабыр ет, не болды?
Dialogue: 0,0:11:11.54,0:11:13.58,Default,,0,0,0,,Ол келді
Dialogue: 0,0:11:16.13,0:11:18.88,Default,,0,0,0,,Ол кім туралы айтып тұр?
Dialogue: 0,0:11:20.80,0:11:24.26,Default,,0,0,0,,Бұған ешқандай күмән жоқ.
Dialogue: 0,0:11:26.31,0:11:27.01,Default,,0,0,0,,Ішуге болмайды
Dialogue: 0,0:11:33.31,0:11:36.86,Default,,0,0,0,,Ол афро шашы бар самурай.
Dialogue: 0,0:11:36.98,0:11:40.36,Default,,0,0,0,,Мұқият қарасаңыз, жасылдау шаш көрінеді.
Dialogue: 0,0:11:40.49,0:11:46.70,Default,,0,0,0,,Маңдайындағы таңғышқа «2-сан» деп жазылған.
Dialogue: 0,0:11:47.33,0:11:50.20,Default,,0,0,0,,Жасыл афро шаш?
Dialogue: 0,0:11:50.33,0:11:52.79,Default,,0,0,0,,«Екінші» бас бау туралы не деуге болады?
Dialogue: 0,0:11:53.33,0:11:55.13,Default,,0,0,0,,Сөз жоқ
Dialogue: 0,0:11:55.50,0:11:58.05,Default,,0,0,0,,Бұл 2 саны.
Dialogue: 0,0:11:59.09,0:12:01.05,Default,,0,0,0,,Афро самурай
Dialogue: 0,0:12:02.88,0:12:05.93,Default,,0,0,0,,Афро самурай туралы не деуге болады?
Dialogue: 0,0:12:06.01,0:12:09.56,Default,,0,0,0,,Батыстағы барлық өлтірушілерді өлтірген кім?
Dialogue: 0,0:12:10.18,0:12:14.81,Default,,0,0,0,,Әлемдегі ең күшті екінші қылышшы туралы айтасыз ба?
Dialogue: 0,0:12:15.65,0:12:20.61,Default,,0,0,0,,Ашура бауырларын бес қылышпен ғана жеңген адам.
Dialogue: 0,0:12:23.74,0:12:27.87,Default,,0,0,0,,Өз өміріңнен қорқатын болсаң, оған тиіспе.
Dialogue: 0,0:12:28.37,0:12:31.54,Default,,0,0,0,,Өкінішті, ұятсыз төбелесші
Dialogue: 0,0:12:31.62,0:12:35.46,Default,,0,0,0,,Мен екінші бас байлауды аламын.
Dialogue: 0,0:12:35.67,0:12:39.75,Default,,0,0,0,,Үніңді жап, қарап тұр. Оны жеңетін менмін.
Dialogue: 0,0:12:40.05,0:12:40.84,Default,,0,0,0,,Бұл менмін
Dialogue: 0,0:12:40.92,0:12:43.30,Default,,0,0,0,,Балықтың батып кетуіне жол бермеңіз.
Dialogue: 0,0:12:43.38,0:12:45.13,Default,,0,0,0,,Мен 2-ші нөмірмін
Dialogue: 0,0:12:45.22,0:12:46.68,Default,,0,0,0,,(Рютаки) Мен сені Финалдық іріктеуге жіберуге еш ниеттенген емеспін
Dialogue: 0,0:12:46.76,0:12:51.02,Default,,0,0,0,,Мен оның миын мына найзамен жарып жіберемін.
Dialogue: 0,0:12:51.10,0:12:52.60,Default,,0,0,0,,Осы сияқты
Dialogue: 0,0:12:53.77,0:12:54.85,Default,,0,0,0,,Жарайды
Dialogue: 0,0:12:55.39,0:12:57.77,Default,,0,0,0,,Сол металл сынықтарынан құтыл.
Dialogue: 0,0:13:01.07,0:13:02.11,Default,,0,0,0,,Әпке
Dialogue: 0,0:13:03.90,0:13:08.20,Default,,0,0,0,,Неліктен ол жау ретінде көрінеді?
Dialogue: 0,0:13:08.53,0:13:13.33,Default,,0,0,0,,Сіз бұл жердің аңыздарын білмейтін сияқтысыз.
Dialogue: 0,0:13:13.41,0:13:14.62,Default,,0,0,0,,Аңыз?
Dialogue: 0,0:13:15.08,0:13:20.42,Default,,0,0,0,,Ежелден бері келе жатқан екі бау бар: «Ичибан» және «Нибан».
Dialogue: 0,0:13:20.92,0:13:26.55,Default,,0,0,0,,Ең көп (1 саны) Құдай, оған ешкім тиісе алмайды
Dialogue: 0,0:13:27.09,0:13:30.60,Default,,0,0,0,,Бірақ 2 саны (2 саны) барлар ғана дау айта алады.
Dialogue: 0,0:13:31.10,0:13:32.64,Default,,0,0,0,,Ең үздік батыр болу үшін
Dialogue: 0,0:13:32.72,0:13:34.52,Default,,0,0,0,,2 саны үшін—
Dialogue: 0,0:13:35.14,0:13:38.65,Default,,0,0,0,,Сонда кез келген адам оған қарсы шыға алады ма?
Dialogue: 0,0:13:43.11,0:13:45.74,Default,,0,0,0,,Бұл өткір. Сізді қызықтырады ма?
Dialogue: 0,0:13:46.40,0:13:49.20,Default,,0,0,0,,2 саны үшін әр күн өлгенше күрес.
Dialogue: 0,0:13:49.28,0:13:54.37,Default,,0,0,0,,Бірақ соған шыдау арқылы ғана біз Құдайдың дәрежесіне жете аламыз.
Dialogue: 0,0:13:54.45,0:13:57.75,Default,,0,0,0,,1 саны Сумеру тауының басында орналасқан.
Dialogue: 0,0:13:59.12,0:14:02.80,Default,,0,0,0,,Екі қолға ұқсайтын тау.
Dialogue: 0,0:14:06.05,0:14:08.13,Default,,0,0,0,,Маған кедергі жасама
Dialogue: 0,0:14:09.18,0:14:11.01,Default,,0,0,0,,Бір минут күтіңіз.
Dialogue: 0,0:14:11.30,0:14:14.85,Default,,0,0,0,,Маған бас киімін берме.
Dialogue: 0,0:14:18.81,0:14:21.48,Default,,0,0,0,,Көз алмалары сүйкімділікке толы!
Dialogue: 0,0:14:21.65,0:14:24.82,Default,,0,0,0,,Сіз жылынуды аяқтадыңыз ба?
Dialogue: 0,0:14:26.53,0:14:28.53,Default,,0,0,0,,Сыртта шайқас!
Dialogue: 0,0:14:50.59,0:14:53.55,Default,,0,0,0,,Салқындатылған лимонад
Dialogue: 0,0:14:53.64,0:14:56.27,Default,,0,0,0,,Қазір 250.
Dialogue: 0,0:15:00.73,0:15:02.98,Default,,0,0,0,,Бұл лимонад.
Dialogue: 0,0:15:03.31,0:15:04.94,Default,,0,0,0,,Акселераторға да қолым жетпейді – орындық тым үлкен.
Dialogue: 0,0:15:05.27,0:15:08.40,Default,,0,0,0,,Сәлем, балалар, қараңдаршы!
Dialogue: 0,0:15:09.36,0:15:11.49,Default,,0,0,0,,Иә, лимонад.
Dialogue: 0,0:15:14.41,0:15:16.79,Default,,0,0,0,,Іш, жас жігіт.
Dialogue: 0,0:15:19.79,0:15:21.46,Default,,0,0,0,,Тағы бір сусын?
Dialogue: 0,0:15:23.21,0:15:24.04,Default,,0,0,0,,Оның есебінен?
Dialogue: 0,0:15:38.47,0:15:39.77,Default,,0,0,0,,Мүмкін емес...
Dialogue: 0,0:15:40.10,0:15:42.06,Default,,0,0,0,,Өтінемін, лимонад.
Dialogue: 0,0:15:42.60,0:15:44.69,Default,,0,0,0,,Бұл қымбат
Dialogue: 0,0:15:45.11,0:15:47.90,Default,,0,0,0,,Оның есепшоты енді оған тұрарлық емес.
Dialogue: 0,0:16:00.58,0:16:02.00,Default,,0,0,0,,Бұл керемет
Dialogue: 0,0:16:10.71,0:16:13.55,Default,,0,0,0,,Ойшии... қуантады
Dialogue: 0,0:16:13.84,0:16:15.97,Default,,0,0,0,,Өзіңізді жақсы сезінесіз бе?
Dialogue: 0,0:16:16.10,0:16:18.85,Default,,0,0,0,,Әлі көп жол бар, №2.
Dialogue: 0,0:16:19.89,0:16:26.11,Default,,0,0,0,,«Шығыс жолымен» жүріңіз, олар сізді жардың соңында күтіп тұр.
Dialogue: 0,0:16:26.19,0:16:27.31,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:16:28.61,0:16:30.48,Default,,0,0,0,,«Шығысқа жол»
Dialogue: 0,0:16:32.11,0:16:34.66,Default,,0,0,0,,Сәлем Афро!
Dialogue: 0,0:16:34.78,0:16:38.95,Default,,0,0,0,,Бұл жол дұрыс па? Бұл үлкен жартас.
Dialogue: 0,0:16:39.41,0:16:40.83,Default,,0,0,0,,Бонус ретінде...
Dialogue: 0,0:16:41.66,0:16:44.67,Default,,0,0,0,,Бұрын дүкеннен бір жігіт киіп жүр.
Dialogue: 0,0:16:46.13,0:16:51.88,Default,,0,0,0,,Қолтаңбаңызды емес, эпитафыңызды алғыңыз келетін сияқты.
Dialogue: 0,0:16:51.96,0:16:58.35,Default,,0,0,0,,Тез қалаға барайық. Шыдасаң, өлтіресің.
Dialogue: 0,0:16:58.64,0:17:01.35,Default,,0,0,0,,Бұл не? Тоқтамаңыз.
Dialogue: 0,0:17:01.52,0:17:03.68,Default,,0,0,0,,Тез жүріңіз
Dialogue: 0,0:17:05.27,0:17:09.02,Default,,0,0,0,,Сіз екеуміз бірге өлетінімізге сенімдісіз бе?
Dialogue: 0,0:17:09.15,0:17:10.36,Default,,0,0,0,,Үндетпе
Dialogue: 0,0:17:10.94,0:17:15.03,Default,,0,0,0,,Олай болса өз бетімен өл, деп ескерттім.
Dialogue: 0,0:17:15.11,0:17:16.03,Default,,0,0,0,,Есеп № 006
Dialogue: 0,0:17:22.95,0:17:28.71,Default,,0,0,0,,Мен Мунетошимін, мен батыстағы қару ұстаушылар еліненмін.
Dialogue: 0,0:17:30.17,0:17:33.76,Default,,0,0,0,,Бұл сізді Құдайға жақындататын аңызға айналған бас киім.
Dialogue: 0,0:17:36.18,0:17:38.39,Default,,0,0,0,,Бірден бастайық.
Dialogue: 0,0:17:39.76,0:17:42.43,Default,,0,0,0,,Ол адаммен ештеңе істеме!
Dialogue: 0,0:17:44.68,0:17:48.48,Default,,0,0,0,,Мен саған жебелер мен гранаталарды әкелемін.
Dialogue: 0,0:18:17.47,0:18:21.55,Default,,0,0,0,,Әй, сен өлдің бе? Бірдеңе айт
Dialogue: 0,0:18:31.06,0:18:35.94,Default,,0,0,0,,Жай ғана секір, сонда сен менің ауқымымда боласың.
Dialogue: 0,0:18:36.28,0:18:39.49,Default,,0,0,0,,Енді қайда қашуымыз керек? саны 2
Dialogue: 0,0:18:51.33,0:18:53.92,Default,,0,0,0,,Мен тек алға жылжи аламын
Dialogue: 0,0:19:07.43,0:19:10.60,Default,,0,0,0,,Бұлай етпе, мен қобалжыдым!
Dialogue: 0,0:19:10.69,0:19:13.19,Default,,0,0,0,,Мен өлдім деп ойладым
Dialogue: 0,0:19:13.90,0:19:18.57,Default,,0,0,0,,Иістен арылу үшін анда-санда ваннаға түсу.
Dialogue: 0,0:19:18.65,0:19:22.49,Default,,0,0,0,,Сіздің феромондарыңыз «өлтірушілерді» тартады
Dialogue: 0,0:19:24.91,0:19:29.16,Default,,0,0,0,,Сақтығыңызды төмендетпеңіз. Менде әлі жаман сезім бар.
Dialogue: 0,0:19:35.88,0:19:37.00,Default,,0,0,0,,Ахахахаха! Хахахахаха!
Dialogue: 0,0:19:37.80,0:19:40.01,Default,,0,0,0,,Мен «Ни-но-джи»
Dialogue: 0,0:19:54.02,0:19:57.15,Default,,0,0,0,,көремін. Мен түссіндім.
Dialogue: 0,0:19:57.48,0:20:02.28,Default,,0,0,0,,Мен ойлағандай оңай емес сияқты.
Dialogue: 0,0:20:02.36,0:20:05.82,Default,,0,0,0,,Менімен жүруді жалғастырыңыз.
Dialogue: 0,0:20:09.16,0:20:13.37,Default,,0,0,0,,2 саны қозғала бастаған сияқты.
Dialogue: 0,0:20:13.46,0:20:17.75,Default,,0,0,0,,Жұмысымыз басталған сияқты.
Dialogue: 0,0:20:18.71,0:20:22.42,Default,,0,0,0,,Оның жүріп өткен жолы шығысқа қарай.
Dialogue: 0,0:20:23.88,0:20:26.51,Default,,0,0,0,,Ұлы бабаларымыздың ұстанған бағыты.
Dialogue: 0,0:20:26.97,0:20:33.89,Default,,0,0,0,,Ол осы Шумеру тауына көздеп, алдымен аңғардан келуі керек.
Dialogue: 0,0:20:34.02,0:20:36.73,Default,,0,0,0,,Деректер жиналуда
Dialogue: 0,0:20:36.81,0:20:40.73,Default,,0,0,0,,Аспанның тағдыры біз жақта.
Dialogue: 0,0:20:40.82,0:20:43.49,Default,,0,0,0,,Осы «Мумубозу»
Dialogue: 0,0:20:46.32,0:20:50.08,Default,,0,0,0,,Асқақтай берсін!
Dialogue: 0,0:20:50.16,0:20:53.41,Default,,0,0,0,,Қасиетті жолда дұға ету
Dialogue: 0,0:21:12.22,0:21:16.10,Default,,0,0,0,,Көзіңізді жұмып, күшті сезініңіз.
Dialogue: 0,0:21:16.56,0:21:19.65,Default,,0,0,0,,Құдайдың күшін ішіне салыңыз -
Dialogue: 0,0:21:19.73,0:21:22.28,Default,,0,0,0,,Қасиетті жолға түс
Dialogue: 0,0:21:22.40,0:21:27.61,Default,,0,0,0,,Аспанның қалауымен біз күлден тірілдік.
Dialogue: 0,0:21:27.70,0:21:32.45,Default,,0,0,0,,Осы қиыншылықтан біз айқыштарымызды алдық.
Dialogue: 0,0:21:32.54,0:21:35.21,Default,,0,0,0,,Бірақ қазір тәжді қолға алатын кез келді
Dialogue: 0,0:21:35.41,0:21:38.29,Default,,0,0,0,,Пайғамбарлықтар орындалады
Dialogue: 0,0:21:38.42,0:21:40.17,Default,,0,0,0,,«Көзге көз»!
Dialogue: 0,0:21:40.25,0:21:46.55,Default,,0,0,0,,2 саны тозақты бізден Мумубозу көреді
Dialogue: 0,0:21:47.22,0:21:51.14,Default,,0,0,0,,Енді соңғы шайқасқа дайындал.
Dialogue: 0,0:21:51.85,0:21:55.85,Default,,0,0,0,,Бостандық жақын жерде
Dialogue: 0,0:21:57.23,0:22:03.28,Default,,0,0,0,,Құдайдың теңдесі жоқ құдіреті біздікі болады!
Dialogue: 0,0:22:04.44,0:22:07.99,Default,,0,0,0,,Бауырлар, мені естідіңдер ме?
Dialogue: 0,0:22:08.57,0:22:10.49,Default,,0,0,0,,Нұсқауды орындаңыз
Dialogue: 0,0:22:15.12,0:22:20.00,Default,,0,0,0,,Қаншама адам өлтіруді көру көңілсіз.
Dialogue: 0,0:22:21.21,0:22:22.96,Default,,0,0,0,,Тыңдап тұрсың ба?
Dialogue: 0,0:22:27.01,0:22:29.47,Default,,0,0,0,,Сіз мені тағы да елемейсіз бе?
Dialogue: 0,0:22:35.68,0:22:38.35,Default,,0,0,0,,Сен кезіп жүрсің.
Dialogue: 0,0:22:38.64,0:22:40.27,Default,,0,0,0,,Не болды!
Dialogue: 0,0:22:41.10,0:22:42.81,Default,,0,0,0,,Лимонадтың кесірінен бе?
Dialogue: 0,0:22:43.32,0:22:46.57,Default,,0,0,0,,Сен жаралысың, солай емес пе?
Dialogue: 0,0:22:46.65,0:22:49.53,Default,,0,0,0,,Сол жебе сені өлтірді ме?
Dialogue: 0,0:22:54.49,0:22:57.37,Default,,0,0,0,,Афро, сауығып кет
Dialogue: 0,0:22:59.92,0:23:01.88,Default,,0,0,0,,Сіз оны қазір жеңе аласыз
Dialogue: 0,0:23:02.63,0:23:05.55,Default,,0,0,0,,Ей, күте тұрыңыз, әлі ерте!
Dialogue: 0,0:23:13.55,0:23:17.43,Default,,0,0,0,,Ағайын сәл демалсын.
Dialogue: 0,0:23:17.52,0:23:21.90,Default,,0,0,0,,Адамгершілік немесе әділ ойын жоқ па?
Dialogue: 0,0:23:31.70,0:23:34.16,Default,,0,0,0,,Бұл RPG емес пе?
Dialogue: 0,0:23:34.99,0:23:39.79,Default,,0,0,0,,Арқаңызда осындай нәрсені көтеріп жүрсіз бе?
Dialogue: 0,0:23:39.87,0:23:42.00,Default,,0,0,0,,Әй, сөйлесейік.
Dialogue: 0,0:23:42.46,0:23:44.92,Default,,0,0,0,,Қалыпты сөз бар емес пе?
Dialogue: 0,0:23:53.09,0:23:55.97,Default,,0,0,0,,Біраз күте тұрыңыз, өтірік айтасыз, солай ма?
Dialogue: 0,0:24:06.77,0:24:07.61,Default,,0,0,0,,Ақымақ
Dialogue: 0,0:24:07.82,0:24:11.70,Default,,0,0,0,,Сіз тіпті екінші бас таспаны да үрлеуді жоспарлап отырсыз ба?
Dialogue: 0,0:24:13.20,0:24:19.20,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory