Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:02.72,0:01:05.73,Default,,0,0,0,,Титан шабуылына ұшыраған Трост ауданында,
Dialogue: 0,0:01:05.85,0:01:08.19,Default,,0,0,0,,Жылама
Dialogue: 0,0:01:08.27,0:01:10.48,Default,,0,0,0,,Эй, көңіл көтер.
Dialogue: 0,0:01:11.73,0:01:16.07,Default,,0,0,0,,Достарыңыздың көбі өлсе, қиын екенін білемін.
Dialogue: 0,0:01:16.74,0:01:19.28,Default,,0,0,0,,Бірақ мен қазір осындамын, солай ма?
Dialogue: 0,0:01:20.91,0:01:22.62,Default,,0,0,0,,Біз бүгіннен бастап ең жақсы доспыз.
Dialogue: 0,0:01:32.67,0:01:34.13,Default,,0,0,0,,Мен мұндай нәрселерге әрдайым шебер болдым, көріп тұрсың ғой.
Dialogue: 0,0:01:35.22,0:01:39.43,Default,,0,0,0,,Бұл жолы қауіпті болады, сондықтан абай болыңыз.
Dialogue: 0,0:01:48.94,0:01:52.27,Default,,0,0,0,,Ей, олай жасама.
Dialogue: 0,0:01:52.94,0:01:55.49,Default,,0,0,0,,Өкінудің қажеті жоқ.
Dialogue: 0,0:01:56.65,0:02:00.32,Default,,0,0,0,,Сендеріңді берік ұстандыңдар, солай емес пе?
Dialogue: 0,0:02:01.12,0:02:03.37,Default,,0,0,0,,Не істеу керек болса, соны істе
Dialogue: 0,0:02:03.54,0:02:05.29,Default,,0,0,0,,Оны жең!
Dialogue: 0,0:02:07.16,0:02:09.54,Default,,0,0,0,,Тіпті ескі нигга
Dialogue: 0,0:02:10.63,0:02:13.13,Default,,0,0,0,,Сіз түсінесіз.
Dialogue: 0,0:02:13.63,0:02:15.05,Default,,0,0,0,,Бақылаңыз
Dialogue: 0,0:02:15.84,0:02:20.72,Default,,0,0,0,,Егер жау екі қылыш ұстаса, қозғалыс санын екі есе көбейтіңіз.
Dialogue: 0,0:02:21.93,0:02:25.77,Default,,0,0,0,,Қылышты екі қолмен ұстасаң, күш екі есе артады.
Dialogue: 0,0:02:28.10,0:02:29.81,Default,,0,0,0,,Міне, таптырмас нәрсе! Керемет!
Dialogue: 0,0:02:31.77,0:02:34.02,Default,,0,0,0,,Басқалардың айтқанын тыңдамайды.
Dialogue: 0,0:02:34.73,0:02:37.94,Default,,0,0,0,,Бұл жерден жалғыз сенсің.
Dialogue: 0,0:02:42.99,0:02:44.70,Default,,0,0,0,,Қоштасу.
Dialogue: 0,0:02:48.12,0:02:51.71,Default,,0,0,0,,Сізбен араласу керемет болды.
Dialogue: 0,0:02:52.04,0:02:54.50,Default,,0,0,0,,Афро самурай
Dialogue: 0,0:03:05.05,0:03:08.18,Default,,0,0,0,,Сіздің айтқандарыңыз рас.
Dialogue: 0,0:03:11.73,0:03:16.82,Default,,0,0,0,,Егер сіздің қарсыласыңыз орташа қос ойыншы болса, сіз жеңетін шығарсыз.
Dialogue: 0,0:03:16.98,0:03:19.24,Default,,0,0,0,,Бірақ мен орташа емеспін.
Dialogue: 0,0:03:19.36,0:03:21.95,Default,,0,0,0,,Жылдамдықтың анықтығы
Dialogue: 0,0:03:22.03,0:03:24.49,Default,,0,0,0,,Менің күшім де сенен артық.
Dialogue: 0,0:03:25.95,0:03:29.50,Default,,0,0,0,,Мен қылышты екі қолмен ұстаймын.
Dialogue: 0,0:03:30.25,0:03:34.38,Default,,0,0,0,,Енді мәселені шешетін кез келді, Афро Самурай.
Dialogue: 0,0:03:44.26,0:03:46.55,Default,,0,0,0,,Тозаққа түс!
Dialogue: 0,0:04:21.38,0:04:25.89,Default,,0,0,0,,Бұл жақсы, Кума. Күткендей, бұл менің шедеврім.
Dialogue: 0,0:04:26.26,0:04:30.89,Default,,0,0,0,,Афроға деген ашу өз күшін екі есе арттырады
Dialogue: 0,0:04:31.14,0:04:34.19,Default,,0,0,0,,Енді жек көретін жауыңызды жеңетін уақыт.
Dialogue: 0,0:04:34.39,0:04:37.19,Default,,0,0,0,,2 санын кесектерге кесіңіз.
Dialogue: 0,0:04:53.91,0:04:56.12,Default,,0,0,0,,Бұл қорқынышты
Dialogue: 0,0:05:03.55,0:05:08.47,Default,,0,0,0,,Мойын мен бастың артқы жағының зақымдануы ерекше ауыр.
Dialogue: 0,0:05:08.55,0:05:15.06,Default,,0,0,0,,Оның бүйірінде сондай терең пышақ жарақаты бар.
Dialogue: 0,0:05:17.35,0:05:22.86,Default,,0,0,0,,Сансыз жарақаттардан басқа, құлаудан сынған сүйектер де бар.
Dialogue: 0,0:05:23.57,0:05:28.32,Default,,0,0,0,,Аяқ-қолым бұзылып, жарамсыз.
Dialogue: 0,0:05:29.03,0:05:31.41,Default,,0,0,0,,Мына бейшара жанды құтқаруға бола ма?
Dialogue: 0,0:05:31.62,0:05:35.83,Default,,0,0,0,,Кемінде 450 жетек және—
Dialogue: 0,0:05:35.96,0:05:39.33,Default,,0,0,0,,100 ультра жұқа процессор қажет
Dialogue: 0,0:05:39.42,0:05:42.67,Default,,0,0,0,,Сондай-ақ сенсорлар мен отын элементтері
Dialogue: 0,0:05:43.17,0:05:44.76,Default,,0,0,0,,Дайындал
Dialogue: 0,0:05:46.97,0:05:49.89,Default,,0,0,0,,Маған бұл жұмысты не үшін бердіңіз?
Dialogue: 0,0:05:50.30,0:05:52.31,Default,,0,0,0,,Оның жоғары білімі және-
Dialogue: 0,0:05:52.39,0:05:56.31,Default,,0,0,0,,Мен моральдың жетіспеушілігін сатып алдым.
Dialogue: 0,0:05:57.39,0:06:00.94,Default,,0,0,0,,Адамдар еститін жаман сөздер
Dialogue: 0,0:06:01.48,0:06:06.36,Default,,0,0,0,,Ең күшті күші бар самурай жасаңыз
Dialogue: 0,0:06:06.61,0:06:10.20,Default,,0,0,0,,Қатты ашу мен мұңды сезіну
Dialogue: 0,0:06:10.66,0:06:13.49,Default,,0,0,0,,Неге оның өлуіне жол бермейсің?
Dialogue: 0,0:06:59.96,0:07:02.54,Default,,0,0,0,,Сіз қанша уақыт ойнадыңыз?
Dialogue: 0,0:07:02.63,0:07:05.71,Default,,0,0,0,,Тезірек, сол жігітке соңғы соққыны тигіз!
Dialogue: 0,0:07:06.92,0:07:10.84,Default,,0,0,0,,Сіз мені тыңдап тұрсыз ба? менің сүйкімді аюым
Dialogue: 0,0:07:11.55,0:07:14.80,Default,,0,0,0,,Толқудан терге малындым.
Dialogue: 0,0:07:14.89,0:07:16.56,Default,,0,0,0,,Иісі бар ма?
Dialogue: 0,0:10:19.66,0:10:22.33,Default,,0,0,0,,Шумеру тауының басты қақпасына барыңыз.
Dialogue: 0,0:10:25.24,0:10:28.54,Default,,0,0,0,,Афро самурай бір күні келеді.
Dialogue: 0,0:10:32.54,0:10:34.46,Default,,0,0,0,,Сіз шеберді өлтірдіңіз!
Dialogue: 0,0:10:37.30,0:10:38.88,Default,,0,0,0,,Сасукені өлтірді
Dialogue: 0,0:10:42.89,0:10:45.56,Default,,0,0,0,,Джиро мен Сейкичи де
Dialogue: 0,0:10:46.22,0:10:47.60,Default,,0,0,0,,Толық шегіну.
Dialogue: 0,0:10:56.28,0:10:57.40,Default,,0,0,0,,Оцуруға дейін
Dialogue: 0,0:11:01.07,0:11:02.70,Default,,0,0,0,,Оны сен өлтірдің!
Dialogue: 0,0:11:09.96,0:11:10.62,Default,,0,0,0,,Сасуке…
Dialogue: 0,0:11:13.50,0:11:14.29,Default,,0,0,0,,Джиро…
Dialogue: 0,0:11:16.71,0:11:17.71,Default,,0,0,0,,Мастер…
Dialogue: 0,0:11:19.88,0:11:20.97,Default,,0,0,0,,Оцуру…
Dialogue: 0,0:11:26.97,0:11:28.81,Default,,0,0,0,,Енді шыдаңдар!
Dialogue: 0,0:11:29.43,0:11:33.81,Default,,0,0,0,,Тіршілікті қамтамасыз ету тізбегі зақымдалған. Бізде уақыт жоқ.
Dialogue: 0,0:11:34.06,0:11:35.82,Default,,0,0,0,,Өлтір!
Dialogue: 0,0:11:50.83,0:11:54.00,Default,,0,0,0,,Енді біз осы уақытқа дейін келдік -
Dialogue: 0,0:11:56.34,0:11:59.67,Default,,0,0,0,,Кес немесе кес, артқа жол жоқ
Dialogue: 0,0:12:39.00,0:12:40.80,Default,,0,0,0,,Ақымақ...
Dialogue: 0,0:12:41.96,0:12:43.30,Default,,0,0,0,,Мен сізбен кездескім келеді
Dialogue: 0,0:12:44.59,0:12:49.81,Default,,0,0,0,,Бұл денемен 1 санымен бәсекелесуге мүмкіндік жоқ.
Dialogue: 0,0:13:43.65,0:13:45.90,Default,,0,0,0,,Кешігіп қалдың, балақай.
Dialogue: 0,0:13:47.24,0:13:53.12,Default,,0,0,0,,Күтуден шаршадым, дауыстық поштаны қалдыруды ойладым.
Dialogue: 0,0:13:59.67,0:14:01.21,Default,,0,0,0,,Мен оны көптен бері қарап жүрмін.
Dialogue: 0,0:14:01.54,0:14:04.96,Default,,0,0,0,,Мен ескі досымды өлтірген бөлік
Dialogue: 0,0:14:05.13,0:14:10.05,Default,,0,0,0,,«Қиялы досыммен» қоштасқанда жыладым.
Dialogue: 0,0:14:15.47,0:14:18.89,Default,,0,0,0,,Ол толыққанды адамға ұқсайды, бірақ—
Dialogue: 0,0:14:20.44,0:14:22.36,Default,,0,0,0,,әлі де нәзік
Dialogue: 0,0:14:29.45,0:14:33.58,Default,,0,0,0,,Әкесі сияқты іштей әлсіз.
Dialogue: 0,0:14:37.91,0:14:42.71,Default,,0,0,0,,Басында төбелесіп, өлтірген күндеріне шыдай алмады.
Dialogue: 0,0:14:42.79,0:14:47.84,Default,,0,0,0,,Мен ең жақсы таңғышты жасырдым және Құдайдың құдіретін жабуға тырыстым.
Dialogue: 0,0:14:48.80,0:14:53.30,Default,,0,0,0,,Бірақ ақыры жанжал ушыға түсті.
Dialogue: 0,0:14:53.60,0:14:57.47,Default,,0,0,0,,Шексіз өлтіру жалғасты.
Dialogue: 0,0:14:57.98,0:15:01.35,Default,,0,0,0,,Бұл бас киім адамдарды жынды етеді.
Dialogue: 0,0:15:02.90,0:15:08.90,Default,,0,0,0,,Ешкім осы екінші матаны орау арқылы шынайы күшке ие болған емес.
Dialogue: 0,0:15:08.99,0:15:11.53,Default,,0,0,0,,Олар бір-бірін өлтірді.
Dialogue: 0,0:15:12.99,0:15:15.99,Default,,0,0,0,,Әлемді ешкім басқара алмайды
Dialogue: 0,0:15:16.08,0:15:19.79,Default,,0,0,0,,Кісі өлтіру мен заңсыздықтың дауылы басталды.
Dialogue: 0,0:15:28.67,0:15:33.14,Default,,0,0,0,,Тек кемел күш қана тыныштық әкеледі.
Dialogue: 0,0:15:33.84,0:15:36.68,Default,,0,0,0,,Қолданбаған қуат мағынасыз
Dialogue: 0,0:15:38.52,0:15:41.94,Default,,0,0,0,,Қарапайым адамдарда жоқ күш-қуатқа ие болды...
Dialogue: 0,0:15:42.02,0:15:45.65,Default,,0,0,0,,Дүниеге билік етпеу күнә
Dialogue: 0,0:15:58.20,0:16:03.29,Default,,0,0,0,,Дүние шатасушылық пен азапқа толы терминалдық жағдайда.
Dialogue: 0,0:16:03.58,0:16:06.38,Default,,0,0,0,,Біреудің бақылауға алатын уақыты келді
Dialogue: 0,0:16:06.71,0:16:10.76,Default,,0,0,0,,«Тұңғиық бейбітшілік» үшін —
Dialogue: 0,0:16:10.88,0:16:13.38,Default,,0,0,0,,Күш қолдану уақыты келді
Dialogue: 0,0:16:13.76,0:16:16.68,Default,,0,0,0,,Барлық дауларды жою—
Dialogue: 0,0:16:16.76,0:16:21.60,Default,,0,0,0,,Барлық жастағы ерлер мен әйелдер бейбіт өмір сүретін әлем құру
Dialogue: 0,0:16:22.23,0:16:28.07,Default,,0,0,0,,Құдайдың қолынан келмеген нәрсені мен саған жасаймын.
Dialogue: 0,0:16:28.40,0:16:32.32,Default,,0,0,0,,Алдымен мен әлемдегі ең күшті самурайдың басын алдым.
Dialogue: 0,0:16:32.70,0:16:36.74,Default,,0,0,0,,Теңдесі жоқ шеберлігі бар қорқынышты адам
Dialogue: 0,0:16:37.16,0:16:38.45,Default,,0,0,0,,Бұл сенің әкең.
Dialogue: 0,0:16:39.33,0:16:43.25,Default,,0,0,0,,Ал тағдырдың құдіретімен осы киелі мекенге...
Dialogue: 0,0:16:43.33,0:16:46.13,Default,,0,0,0,,Ежелгі құпияны білді
Dialogue: 0,0:16:46.92,0:16:51.63,Default,,0,0,0,,Ең жақсы бас байлау жеткіліксіз
Dialogue: 0,0:16:52.67,0:16:56.18,Default,,0,0,0,,Әкеңнен, досыңнан, қожайыннан айырылдың...
Dialogue: 0,0:16:56.26,0:16:58.76,Default,,0,0,0,,Бұл жай ғана кездейсоқтық деп ойлайсыз ба?
Dialogue: 0,0:17:00.93,0:17:03.60,Default,,0,0,0,,Олар құрбандық
Dialogue: 0,0:17:04.44,0:17:07.94,Default,,0,0,0,,Сіз дәл сол себепті қазір осындасыз.
Dialogue: 0,0:17:08.56,0:17:12.19,Default,,0,0,0,,Тағдырдың бәріне иелік ету.
Dialogue: 0,0:17:13.94,0:17:14.99,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:17:16.11,0:17:20.16,Default,,0,0,0,,Егер сізде олардың барлығы болмаса, мағынасы жоқ.
Dialogue: 0,0:17:20.28,0:17:27.46,Default,,0,0,0,,Сонда ғана түпкілікті билікке қол жеткізіледі.
Dialogue: 0,0:17:28.13,0:17:32.46,Default,,0,0,0,,Әкең білген соң, менің шақыруымды қабылдады.
Dialogue: 0,0:17:32.59,0:17:35.97,Default,,0,0,0,,Шындықты жасыру
Dialogue: 0,0:17:37.38,0:17:42.01,Default,,0,0,0,,Енді осы қасиетті жерде
Dialogue: 0,0:17:42.47,0:17:46.14,Default,,0,0,0,,Сізді жеңіп, барлық бас киімдерді алыңыз
Dialogue: 0,0:17:46.94,0:17:52.82,Default,,0,0,0,,Сен маған бас киімін ұсынуға келдің.
Dialogue: 0,0:17:53.69,0:17:56.90,Default,,0,0,0,,Ал мен құдай боламын
Dialogue: 0,0:18:14.00,0:18:16.17,Default,,0,0,0,,Әкеңе бар
Dialogue: 0,0:18:35.07,0:18:38.90,Default,,0,0,0,,Біраз уақыт қажет болды, сен де осы уақытқа дейін.
Dialogue: 0,0:19:27.45,0:19:28.58,Default,,0,0,0,,Неге маған шабуыл жасап тұрсың?
Dialogue: 0,0:19:30.96,0:19:33.58,Default,,0,0,0,,Сен әкеңді жақсы көрдің, солай ма?
Dialogue: 0,0:19:34.46,0:19:38.92,Default,,0,0,0,,О дүниеге жіберген көп өмірлеріңіз не болады?
Dialogue: 0,0:19:40.42,0:19:42.63,Default,,0,0,0,,Түсіндіңіз.
Dialogue: 0,0:19:43.26,0:19:46.93,Default,,0,0,0,,Шексіз қырғын теңізінде —
Dialogue: 0,0:19:47.01,0:19:51.10,Default,,0,0,0,,Сенің ашуың – бір тамшы қан.
Dialogue: 0,0:19:52.52,0:19:54.15,Default,,0,0,0,,Соңы жоқ
Dialogue: 0,0:19:55.11,0:19:56.52,Default,,0,0,0,,Басталуы жоқ
Dialogue: 0,0:19:57.07,0:19:59.94,Default,,0,0,0,,Тек күштілер мен өлілер
Dialogue: 0,0:20:00.94,0:20:05.32,Default,,0,0,0,,Бұл шындықты тек біз қарғыс атқандар түсіне аламыз.
Dialogue: 0,0:20:22.55,0:20:26.30,Default,,0,0,0,,Әкесі сияқты дайындықта ол да шала болды.
Dialogue: 0,0:20:26.60,0:20:28.10,Default,,0,0,0,,Афро самурай
Dialogue: 0,0:20:36.10,0:20:40.23,Default,,0,0,0,,Барлық бас киімдер алынды
Dialogue: 0,0:20:40.69,0:20:44.45,Default,,0,0,0,,Сіз ақырында құдай бола аласыз.
Dialogue: 0,0:21:18.19,0:21:19.98,Default,,0,0,0,,Маған не болды...
Dialogue: 0,0:21:39.50,0:21:40.75,Default,,0,0,0,,Наму…
Dialogue: 0,0:22:37.81,0:22:41.23,Default,,0,0,0,,Күндер өтеді...
Dialogue: 0,0:22:41.31,0:22:44.23,Default,,0,0,0,,Көп жылдар өткен соң
Dialogue: 0,0:23:32.61,0:23:33.70,Default,,0,0,0,,Джинносуке
Dialogue: 0,0:23:37.41,0:23:41.00,Default,,0,0,0,,Біраз уақыт болды, Афро Самурай.
Dialogue: 0,0:23:41.71,0:23:44.21,Default,,0,0,0,,Сіз қайтадан өлесіз.
Dialogue: 0,0:23:48.21,0:23:52.22,Default,,0,0,0,,Мүмкін, бірақ оны осымен аяқтау жаман идея болмас еді.
Dialogue: 0,0:23:58.27,0:24:00.48,Default,,0,0,0,,Олай болса, бастайық.
Dialogue: 0,0:24:14.53,0:24:16.16,Default,,0,0,0,,(Бакуго) Ха! Ал бері кел, шалғайлар! Қатты жарысуға шақырамын!
Dialogue: 0,0:24:19.20,0:24:23.96,Default,,0,0,0,,Шексіз шайқас жалғасуда
Dialogue: 0,0:24:25.46,0:24:31.46,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory