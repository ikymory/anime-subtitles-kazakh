Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:07.58,0:01:09.33,Dialogue,,0,0,0,,Қалалық аңыз дегеніміз не?!
Dialogue: 0,0:01:07.71,0:01:09.39,*Default-ja,NTP,0,0,0,,Қала аңызы дегеніміз не?
Dialogue: 0,0:01:09.33,0:01:10.66,Dialogue,,0,0,0,,Мына қара велосипед!
Dialogue: 0,0:01:09.54,0:01:12.00,*Default-ja,NTP,0,0,0,,Бұл қара велосипед. Бұл басы жоқ шабандоз!
Dialogue: 0,0:01:10.66,0:01:12.28,Dialogue,,0,0,0,,Басы жоқ шабандоз!
Dialogue: 0,0:01:12.28,0:01:14.17,Chat,,0,0,0,,Мына қара велосипедті мінген адам...
Dialogue: 0,0:01:12.56,0:01:14.68,*Default-ja,NTP,0,0,0,,Қара мотоцикл мінген адамға
Dialogue: 0,0:01:14.17,0:01:16.30,Chat,,0,0,0,,...басы жоқ.
Dialogue: 0,0:01:14.71,0:01:16.19,*Default-ja,NTP,0,0,0,,Менің мойнымнан жоғары ештеңе жоқ.
Dialogue: 0,0:01:16.30,0:01:19.05,Chat,,0,0,0,,Ол толығымен жойылды, бірақ ол әлі қозғала алады.
Dialogue: 0,0:01:16.61,0:01:19.38,*Default-ja,NTP,0,0,0,,Толығымен жойылса да, ол әлі қозғалады.
Dialogue: 0,0:01:19.05,0:01:23.06,Dialogue,,0,0,0,,Бұл жұмыс соншалықты қиын емес сияқты, бірақ бәрібір сақ болыңыз.
Dialogue: 0,0:01:19.57,0:01:21.76,*Default-ja,NTP,0,0,0,,Бұл аса қиын жұмыс емес сияқты.
Dialogue: 0,0:01:21.88,0:01:23.14,*Default-ja,NTP,0,0,0,,Сақ болыңыз.
Dialogue: 0,0:01:23.06,0:01:27.99,Dialogue,,0,0,0,,Сіздің әділдік үшін крест жорығына айналғаныңыз туралы ештеңе есімде жоқ.
Dialogue: 0,0:01:23.30,0:01:28.31,*Default-ja,NTP,0,0,0,,Әділдіктің одақтасы болғаныңды естімеппін.
Dialogue: 0,0:01:27.99,0:01:29.94,Dialogue,,0,0,0,,Сен қандайсың?
Dialogue: 0,0:01:28.42,0:01:29.51,*Default-ja,NTP,0,0,0,,Бұл тек қана достық теннис матчы.
Dialogue: 0,0:01:29.83,0:01:32.91,*Default-ja,NTP,0,0,0,,Бұл не?!
Dialogue: 0,0:01:29.94,0:01:32.57,Dialogue,,0,0,0,,Сен неменесің?!
Dialogue: 0,0:02:05.53,0:02:08.20,Dialogue,,0,0,0,,Басы жоқ шабандоз?! Мен ол туралы естідім!
Dialogue: 0,0:02:05.86,0:02:06.88,*Default-ja,NTP,0,0,0,,Басы жоқ шабандоз?
Dialogue: 0,0:02:07.06,0:02:07.92,*Default-ja,NTP,0,0,0,,Ол қайда еді?
Dialogue: 0,0:02:08.73,0:02:11.09,Dialogue,,0,0,0,,Менің досым оның мініп келе жатқанын көрді.
Dialogue: 0,0:02:09.08,0:02:11.16,*Default-ja,NTP,0,0,0,,Мен досымның жүгіріп келе жатқанын көрдім!
Dialogue: 0,0:02:11.23,0:02:14.57,Dialogue,,0,0,0,,Ал, мені бұл қызықтырмайды.
Dialogue: 0,0:02:11.64,0:02:14.72,*Default-ja,NTP,0,0,0,,Келіңіздер ме? Маған қызық емес.
Dialogue: 0,0:02:14.61,0:02:17.33,Dialogue,,0,0,0,,Олай десеңіз, мен суретке түсірдім.
Dialogue: 0,0:02:14.92,0:02:17.12,*Default-ja,NTP,0,0,0,,Бұл жағдайда мен суретке түсірдім.
Dialogue: 0,0:02:17.33,0:02:18.50,Dialogue,,0,0,0,,Ф-Фатирлеу ештеңе әкелмейді.
Dialogue: 0,0:02:17.59,0:02:18.43,*Default-ja,NTP,0,0,0,,Кенеттен келгеніме кешірім өтінемін.
Dialogue: 0,0:02:20.20,0:02:21.62,Dialogue,,0,0,0,,Басы жоқ шабандоз?
Dialogue: 0,0:02:20.49,0:02:21.84,*Default-ja,NTP,0,0,0,,Басы жоқ шабандоз?
Dialogue: 0,0:02:21.62,0:02:24.02,Dialogue,,0,0,0,,Бұл жігіт.
Dialogue: 0,0:02:22.28,0:02:23.77,*Default-ja,NTP,0,0,0,,Бұл жігіт! Бұл жігіт!
Dialogue: 0,0:02:25.02,0:02:27.00,Dialogue,,0,0,0,,Мен бұл туралы естідім.
Dialogue: 0,0:02:25.21,0:02:27.03,*Default-ja,NTP,0,0,0,,Сіз мұны бұрын естігенсіз.
Dialogue: 0,0:02:27.00,0:02:29.77,Dialogue,,0,0,0,,Мен оны Күн сәулесінің жанында көрген шығармын.
Dialogue: 0,0:02:27.24,0:02:29.43,*Default-ja,NTP,0,0,0,,Мен оны Күн сәулесінің жанынан көрген шығармын~
Dialogue: 0,0:02:29.77,0:02:31.01,Dialogue,,0,0,0,,Реал үшін?
Dialogue: 0,0:02:30.04,0:02:31.15,*Default-ja,NTP,0,0,0,,Шынайы ма?
Dialogue: 0,0:02:31.01,0:02:34.74,Dialogue,,0,0,0,,Мен білмеймін, бірақ бәрі шошып кетті, сондықтан ол болуы керек.
Dialogue: 0,0:02:31.32,0:02:35.05,*Default-ja,NTP,0,0,0,,Мен мұны түсінбеймін, бірақ бәрі бұл туралы шу шығарды, сондықтан солай болуы керек деп ойлаймын.
Dialogue: 0,0:02:35.73,0:02:38.15,Dialogue,,0,0,0,,Ол туралы әркімнің айтары көп.
Dialogue: 0,0:02:36.00,0:02:37.40,*Default-ja,NTP,0,0,0,,Барлығы ақылды
Dialogue: 0,0:02:38.15,0:02:41.17,Chat,,0,0,0,,Велосипед қайтадан байқалған сияқты.
Dialogue: 0,0:02:38.50,0:02:41.20,*Default-ja,NTP,0,0,0,,Қайтадан келген сияқты~ Мысалдағы велосипед
Dialogue: 0,0:02:41.17,0:02:44.59,Chat,,0,0,0,,Бірақ, оның басы жоқ екені рас деп ойлайсың ба?
Dialogue: 0,0:02:44.59,0:02:47.06,Chat,,0,0,0,,Бұл жай ғана жаман өсек.
Dialogue: 0,0:02:47.06,0:02:50.26,Chat,,0,0,0,,Бірақ мен сенуге болатын кейбір әңгімелерді естідім.
Dialogue: 0,0:02:50.26,0:02:51.90,Chat,,0,0,0,,Ой...
Dialogue: 0,0:02:51.90,0:02:54.18,Chat,,0,0,0,,Оның басы жоқ болуы мүмкін емес.
Dialogue: 0,0:02:54.18,0:02:55.98,Chat,,0,0,0,,Ол адам болмаса...
Dialogue: 0,0:02:55.98,0:02:58.51,Chat,,0,0,0,,Сонда сенуге болады.
Dialogue: 0,0:02:59.89,0:03:03.78,Dialogue,,0,0,0,,Бұл туралы көп білетіндер сөйлемейтін сияқты.
Dialogue: 0,0:03:00.17,0:03:02.15,*Default-ja,NTP,0,0,0,,Сіз шынымен кіммен айналысасыз?
Dialogue: 0,0:03:02.27,0:03:03.57,*Default-ja,NTP,0,0,0,,Ол тынышталып бара жатқан сияқты.
Dialogue: 0,0:03:04.88,0:03:07.69,Dialogue,,0,0,0,,Кешіріңіз, бірақ мен бұл туралы ештеңе білмеймін.
Dialogue: 0,0:03:05.07,0:03:07.48,*Default-ja,NTP,0,0,0,,Кешіріңіз, мен шынымен түсінбеймін.
Dialogue: 0,0:03:10.28,0:03:12.07,Dialogue,,0,0,0,,Қараңыз, қаншама Ято-ра бар
Dialogue: 0,0:03:10.44,0:03:11.83,*Default-ja,NTP,0,0,0,,Сіз ше?
Dialogue: 0,0:03:12.72,0:03:16.55,Dialogue,,0,0,0,,Мына басы жоқ шабандоздан қандай әсер алдың?
Dialogue: 0,0:03:13.01,0:03:16.39,*Default-ja,NTP,0,0,0,,Аты аңызға айналған «Бассыз шабандоз» сізге қандай әсер қалдырды?
Dialogue: 0,0:03:16.85,0:03:20.55,Dialogue,,0,0,0,,Сіз оны қорқынышты деп ойлайсыз ба? Керемет пе? Күтпеген мейірімді ме?
Dialogue: 0,0:03:17.03,0:03:18.72,*Default-ja,NTP,0,0,0,,Қорқынышты ма? тамаша?
Dialogue: 0,0:03:18.98,0:03:20.69,*Default-ja,NTP,0,0,0,,Ол шынымен жақсы адамға ұқсайды ма?
Dialogue: 0,0:03:20.55,0:03:22.51,Dialogue,,0,0,0,,Қолдауыңызға рахмет
Dialogue: 0,0:03:21.03,0:03:22.15,*Default-ja,NTP,0,0,0,,Жоқ, мен ойладым...
Dialogue: 0,0:03:23.32,0:03:25.55,Dialogue,,0,0,0,,Сіз не ойлайтыныңызды білмейсіз бе?
Dialogue: 0,0:03:23.61,0:03:25.89,*Default-ja,NTP,0,0,0,,Оны қалай қабылдау керектігін білмейсіз бе?
Dialogue: 0,0:03:29.50,0:03:33.10,Thought,,0,0,0,,Басы жоқ шабандоз туралы білетінімді айтайын.
Dialogue: 0,0:03:29.80,0:03:33.44,*Default-ja,NTP,0,0,0,,Бүгін мен сендерге «Бассыз шабандоз» туралы білетінімді айтамын.
Dialogue: 0,0:03:33.70,0:03:38.51,Thought,,0,0,0,,Бұл ұзақ әңгіме, бірақ мен сенің ойыңды ашық ұстағаныңды қалаймын.
Dialogue: 0,0:03:33.96,0:03:35.74,*Default-ja,NTP,0,0,0,,Бұл ұзақ әңгіме, бірақ
Dialogue: 0,0:03:35.91,0:03:37.98,*Default-ja,NTP,0,0,0,,Сирек және үлкен жүрекпен тыңдауларыңызды қалаймын.
Dialogue: 0,0:03:39.57,0:03:41.57,Thought,,0,0,0,,Алдымен өзімді таныстырып өтейін.
Dialogue: 0,0:03:39.95,0:03:41.36,*Default-ja,NTP,0,0,0,,Алдымен өзімді таныстырып өтейін.
Dialogue: 0,0:03:41.57,0:03:44.59,Thought,,0,0,0,,Мен Кишитани Шинра, жиырма төрт жастамын.
Dialogue: 0,0:03:41.95,0:03:44.35,*Default-ja,NTP,0,0,0,,Менің атым Шинра Кишитани, 24 жаста.
Dialogue: 0,0:03:44.59,0:03:46.83,Thought,,0,0,0,,Мен осы қалада астыртын дәрігермін.
Dialogue: 0,0:03:44.85,0:03:46.78,*Default-ja,NTP,0,0,0,,Ол осы қалада асхана дәрігері болып жұмыс істейді.
Dialogue: 0,0:03:46.83,0:03:49.16,Thought,,0,0,0,,Нақтырақ айтсам, мен қара базардың дәрігерімін.
Dialogue: 0,0:03:47.10,0:03:49.20,*Default-ja,NTP,0,0,0,,Айтуға тура келсе, бұл саяхатшы қараңғы дәрігер.
Dialogue: 0,0:03:50.82,0:03:57.42,Thought,,0,0,0,,Мен заңсыз қарудан жарақат алған адамдарды емдеймін және бетін өзгертуді қажет ететін адамдарға косметикалық операция жасаймын.
Dialogue: 0,0:03:51.04,0:03:53.88,*Default-ja,NTP,0,0,0,,Заңсыз қарудан жарақат алғандарды емдеу және т.б.
Dialogue: 0,0:03:54.35,0:03:57.45,*Default-ja,NTP,0,0,0,,Бет-әлпетін өзгертуді қажет ететін адамдарға пластикалық хирургия
Dialogue: 0,0:03:59.75,0:04:02.51,Thought,,0,0,0,,Осы салада жұмыс істесем де, мен біліктімін, құрметтімін.
Dialogue: 0,0:04:00.06,0:04:02.64,*Default-ja,NTP,0,0,0,,Сырт келбеті осындай болса да, өнері жақсы, сенімді.
Dialogue: 0,0:04:03.49,0:04:06.01,Thought,,0,0,0,,Жарайды, маңызды бөлікке өту уақыты келді.
Dialogue: 0,0:04:03.75,0:04:05.74,*Default-ja,NTP,0,0,0,,Енді негізгі тақырыпқа көшейік.
Dialogue: 0,0:04:06.42,0:04:08.01,Dialogue,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:04:06.73,0:04:07.65,*Default-ja,NTP,0,0,0,,Мен үйдемін~
Dialogue: 0,0:04:19.41,0:04:20.72,Thought,,0,0,0,,Өте талғампаз болма.
Dialogue: 0,0:04:19.88,0:04:22.81,*Default-ja,NTP,0,0,0,,Иә... Мен сол басы жоқ шабандозмын.
Dialogue: 0,0:04:20.72,0:04:26.50,Thought,,0,0,0,,Мен...бассыз шабандоз Селти Стурлюсонмен бірге тұрамын.
Dialogue: 0,0:04:23.99,0:04:26.34,*Default-ja,NTP,0,0,0,,Селти Стурлюсонмен бірге тұру
Dialogue: 0,0:04:27.82,0:04:30.16,Dialogue,,0,0,0,,Мен үйдемін, Селти.
Dialogue: 0,0:04:28.21,0:04:29.91,*Default-ja,NTP,0,0,0,,Мен қайтып келдім, Селти.
Dialogue: 0,0:04:32.20,0:04:35.67,Dialogue,,0,0,0,,Бұл өте қарапайым жұмыс болды.
Dialogue: 0,0:04:32.71,0:04:35.17,*Default-ja,NTP,0,0,0,,Бұл қарапайым және оңай жұмыс болды.
Dialogue: 0,0:04:35.67,0:04:37.42,Dialogue,,0,0,0,,Ал сіз ше?
Dialogue: 0,0:04:36.17,0:04:37.53,*Default-ja,NTP,0,0,0,,Онда қалай болды?
Dialogue: 0,0:04:37.42,0:04:38.45,Dialogue,,0,0,0,,Қарауға болмайды!
Dialogue: 0,0:04:37.95,0:04:38.95,*Default-ja,NTP,0,0,0,,Қарамаңыз
Dialogue: 0,0:04:39.58,0:04:43.95,Dialogue,,0,0,0,,Кешіріңіз! Мен олай айтқым келген жоқ! Мен жай ғана кездейсоқ...
Dialogue: 0,0:04:39.80,0:04:40.67,*Default-ja,NTP,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:04:40.71,0:04:42.24,*Default-ja,NTP,0,0,0,,Мен бұны азғындықпен айтып тұрған жоқпын.
Dialogue: 0,0:04:42.35,0:04:43.32,*Default-ja,NTP,0,0,0,,Кездейсоқ...
Dialogue: 0,0:04:48.65,0:04:52.23,Dialogue,,0,0,0,,Умм, сіз өте ашулы сияқтысыз, иә?
Dialogue: 0,0:04:49.92,0:04:51.79,*Default-ja,NTP,0,0,0,,Сіз ренжіген сияқтысыз.
Dialogue: 0,0:04:52.23,0:04:54.85,Dialogue,,0,0,0,,Сізге тағы біраз кальций қажет болуы мүмкін.
Dialogue: 0,0:04:52.53,0:04:54.54,*Default-ja,NTP,0,0,0,,Маған кальций қабылдау керек пе?
Dialogue: 0,0:04:56.23,0:04:58.61,Dialogue,,0,0,0,,Сіз жұмыртқаның қабығын жеуім керек дейсіз бе?
Dialogue: 0,0:05:01.02,0:05:03.49,Dialogue,,0,0,0,,Бұл жақсы идея болуы мүмкін.
Dialogue: 0,0:05:01.42,0:05:03.47,*Default-ja,NTP,0,0,0,,А, бұл жақсы емес пе?
Dialogue: 0,0:05:03.49,0:05:05.36,Dialogue,,0,0,0,,Мен жай ғана дәрігермін.
Dialogue: 0,0:05:03.69,0:05:05.54,*Default-ja,NTP,0,0,0,,Бірақ бұл менмін
Dialogue: 0,0:05:05.36,0:05:14.85,Dialogue,,0,0,0,,Мен диетолог емеспін, сондықтан жұмыртқаның қабығында қанша кальций бар немесе оны сол көзден қаншалықты жақсы сіңіре алатыныңызды білмеймін.
Dialogue: 0,0:05:05.74,0:05:07.09,*Default-ja,NTP,0,0,0,,Себебі мен дұрыс тамақтанумен таныс емеспін.
Dialogue: 0,0:05:07.23,0:05:10.14,*Default-ja,NTP,0,0,0,,Жұмыртқа қабығында қанша кальций бар?
Dialogue: 0,0:05:10.58,0:05:14.59,*Default-ja,NTP,0,0,0,,Мен сіңіру қаншалықты тиімді дегенді білмеймін.
Dialogue: 0,0:05:15.77,0:05:22.88,Dialogue,,0,0,0,,Мен сіздің миыңыздың қайда екенін де білмеймін, сондықтан сізге кальций қаншалықты қажет екенін кім біледі.
Dialogue: 0,0:05:15.99,0:05:19.40,*Default-ja,NTP,0,0,0,,Мен сіздің миыңыздың қай жерде екенін де білмеймін.
Dialogue: 0,0:05:19.75,0:05:22.91,*Default-ja,NTP,0,0,0,,Кальций қаншалықты пайдалы деген сұрақ бар.
Dialogue: 0,0:05:23.48,0:05:24.77,Dialogue,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,0:05:31.54,0:05:39.52,Dialogue,,0,0,0,,Эй, Селти, мен сенен тағы сұрайын, бірақ сенің көзің болмаса, әлем саған қалай көрінеді?
Dialogue: 0,0:05:31.92,0:05:33.01,*Default-ja,NTP,0,0,0,,Сәлем Селти
Dialogue: 0,0:05:33.56,0:05:34.67,*Default-ja,NTP,0,0,0,,Мен мұны көп естимін
Dialogue: 0,0:05:34.99,0:05:36.70,*Default-ja,NTP,0,0,0,,Көз алмасы бар сізге
Dialogue: 0,0:05:36.97,0:05:39.55,*Default-ja,NTP,0,0,0,,Қызық, бұл дүние қалай көрінеді?
Dialogue: 0,0:05:42.97,0:05:47.51,Dialogue,,0,0,0,,Мен түсінбегенімді басқа адамдарға түсіндіре алмаймын.
Dialogue: 0,0:05:43.24,0:05:47.22,*Default-ja,NTP,0,0,0,,Өзіңіз түсінбеген нәрсені басқаларға үйрете алмайсыз.
Dialogue: 0,0:05:49.03,0:05:54.71,Thought,,0,0,0,,Оның басы жоқ, бірақ көреді, естиді, иіс сезеді.
Dialogue: 0,0:05:49.43,0:05:50.97,*Default-ja,NTP,0,0,0,,Оның басы жоқ болса да
Dialogue: 0,0:05:51.15,0:05:53.13,*Default-ja,NTP,0,0,0,,Мен дыбыстарды көремін және ести аламын.
Dialogue: 0,0:05:53.19,0:05:54.31,*Default-ja,NTP,0,0,0,,Мен де иісті сеземін
Dialogue: 0,0:05:54.71,0:05:59.00,Thought,,0,0,0,,Алайда оның басы жоқ болғандықтан 360 градусты көре алмайды.
Dialogue: 0,0:05:54.92,0:05:58.69,*Default-ja,NTP,0,0,0,,Дегенмен, мойынның жоқтығы барлық бағытта көрінетінін білдірмейді.
Dialogue: 0,0:05:59.00,0:06:02.63,Thought,,0,0,0,,Оның көру диапазоны адамдарға қарағанда сәл ғана кеңірек...
Dialogue: 0,0:05:59.15,0:06:02.20,*Default-ja,NTP,0,0,0,,Кәдімгі адамға қарағанда көру өрісі сәл кеңірек сияқты.
Dialogue: 0,0:06:04.06,0:06:06.92,Dialogue,,0,0,0,,Бұл менің гипотезаларымның бірі ғана емес,
Dialogue: 0,0:06:04.31,0:06:06.34,*Default-ja,NTP,0,0,0,,Бұл менің теориям ғана.
Dialogue: 0,0:06:07.18,0:06:12.96,Dialogue,,0,0,0,,бірақ сіздің денеңізден үнемі шығып тұратын жұмбақ, көлеңке тәрізді, ғылыми фантастикалық субстанцияға қатысты ...
Dialogue: 0,0:06:07.23,0:06:09.42,*Default-ja,NTP,0,0,0,,Ол сіздің денеңізден үнемі шығып тұрады.
Dialogue: 0,0:06:09.64,0:06:12.49,*Default-ja,NTP,0,0,0,,Көлеңкеге ұқсайтын жұмбақ ғылыми-фантастикалық материал
Dialogue: 0,0:06:12.96,0:06:20.54,Dialogue,,0,0,0,,Бөлшектерді ауаға шығару және олар қайтып оралғанда талдау арқылы сіз үшін айналаңыз туралы ақпаратты жинайды деп ойлайсыз ба?
Dialogue: 0,0:06:13.09,0:06:15.55,*Default-ja,NTP,0,0,0,,Бөлшектер жарықтың орнына айналаға таралады.
Dialogue: 0,0:06:15.69,0:06:17.56,*Default-ja,NTP,0,0,0,,Кері серпіні қабылдаңыз
Dialogue: 0,0:06:17.76,0:06:20.35,*Default-ja,NTP,0,0,0,,Айналаңыз туралы ақпарат алу туралы не айтасыз?
Dialogue: 0,0:06:21.53,0:06:25.78,Dialogue,,0,0,0,,Әрине, онда сіз алыстағы заттар туралы ақпаратты ала алмас едіңіз.
Dialogue: 0,0:06:21.73,0:06:25.47,*Default-ja,NTP,0,0,0,,Әрине, ақпарат алыстағы объектілер үшін түсініксіз болады.
Dialogue: 0,0:06:27.83,0:06:29.20,Dialogue,,0,0,0,,Маған бәрібір.
Dialogue: 0,0:06:28.14,0:06:31.12,*Default-ja,NTP,0,0,0,,Мені қызықтырмайды. Мен оны көріп, естігенше, бұл жақсы.
Dialogue: 0,0:06:29.20,0:06:31.41,Dialogue,,0,0,0,,Көріп, естігенше жақсымын.
Dialogue: 0,0:06:31.41,0:06:34.91,Dialogue,,0,0,0,,Сен әрқашан осындайсың, Селти.
Dialogue: 0,0:06:31.65,0:06:34.39,*Default-ja,NTP,0,0,0,,Селти... сен әрқашан солайсың.
Dialogue: 0,0:06:34.91,0:06:40.48,Dialogue,,0,0,0,,Мен сіз бен біз қабылдайтын дүниелер қаншалықты басқаша екеніне таңғаламын...
Dialogue: 0,0:06:35.08,0:06:36.50,*Default-ja,NTP,0,0,0,,Сіз сезінетін әлем
Dialogue: 0,0:06:36.94,0:06:40.18,*Default-ja,NTP,0,0,0,,Дүние мен сезінуімнен қаншалықты ерекшеленеді?
Dialogue: 0,0:06:41.17,0:06:44.03,Dialogue,,0,0,0,,Менің білгім келетіні осы ғана.
Dialogue: 0,0:06:41.40,0:06:43.82,*Default-ja,NTP,0,0,0,,Мен бұл туралы қызықтымын.
Dialogue: 0,0:06:44.03,0:06:46.25,Dialogue,,0,0,0,,Бұл сіздің көзқарасыңыз туралы әңгіме ғана емес.
Dialogue: 0,0:06:44.34,0:06:46.23,*Default-ja,NTP,0,0,0,,Бұл тек көріну туралы ғана емес.
Dialogue: 0,0:06:46.25,0:06:48.25,Dialogue,,0,0,0,,Бұл сіздің құндылықтар жүйесіне де қатысты.
Dialogue: 0,0:06:46.40,0:06:47.85,*Default-ja,NTP,0,0,0,,Бұл да құндылықтар мәселесі.
Dialogue: 0,0:06:48.25,0:06:54.47,Dialogue,,0,0,0,,Осы қалада жаңадан пайда болған перінің құндылықтар жүйесі.
Dialogue: 0,0:06:48.62,0:06:50.62,*Default-ja,NTP,0,0,0,,Адами құндылықтардан гөрі
Dialogue: 0,0:06:51.01,0:06:54.04,*Default-ja,NTP,0,0,0,,Осы қалада пайда болған жалғыз ертегі...
Dialogue: 0,0:06:56.97,0:07:01.07,Dialogue,,0,0,0,,Дуллаханның бұл дүниеде не құнды екенін білгім келеді...
Dialogue: 0,0:06:57.35,0:07:00.65,*Default-ja,NTP,0,0,0,,Дуллахан көрген дүниенің құны...
Dialogue: 0,0:07:15.20,0:07:17.44,Dialogue,,0,0,0,,Құдайым, маған көмектес
Dialogue: 0,0:07:15.71,0:07:16.72,*Default-ja,NTP,0,0,0,,Қарт әже, кіріп келемін.
Dialogue: 0,0:07:17.44,0:07:19.51,Dialogue,,0,0,0,,Егер сізге жараса, оны талқылайық.
Dialogue: 0,0:07:17.70,0:07:20.91,*Default-ja,NTP,0,0,0,,Не болғанын айтып беріңізші.
Dialogue: 0,0:07:19.51,0:07:22.00,Dialogue,,0,0,0,,Бірдеңе болды ма?
Dialogue: 0,0:07:26.02,0:07:31.00,Dialogue,,0,0,0,,Орихара сенің бүгінгі жұмысың оңай екенін айтты, бірақ...
Dialogue: 0,0:07:26.36,0:07:30.31,*Default-ja,NTP,0,0,0,,Бүгінгі жұмыс Орихара-кун оңай екенін айтты.
Dialogue: 0,0:07:31.00,0:07:34.72,Dialogue,,0,0,0,,Жұмысты еш кедергісіз аяқтадым.
Dialogue: 0,0:07:31.35,0:07:35.14,*Default-ja,NTP,0,0,0,,Жұмыстың өзі ешқандай оқиғасыз аяқталды.
Dialogue: 0,0:07:36.10,0:07:36.76,Dialogue,,0,0,0,,Бірақ?
Dialogue: 0,0:07:36.39,0:07:37.20,*Default-ja,NTP,0,0,0,,Сонымен?
Dialogue: 0,0:07:41.40,0:07:44.36,Dialogue,,0,0,0,,Мен курьерлерге өте ризамын.
Dialogue: 0,0:07:41.78,0:07:44.07,*Default-ja,NTP,0,0,0,,Сіз шынымен курьерсіз.
Dialogue: 0,0:07:44.36,0:07:47.86,Dialogue,,0,0,0,,Мен сенің арқаңдамын, ал сен менің арқамдасың.
Dialogue: 0,0:07:44.51,0:07:47.82,*Default-ja,NTP,0,0,0,,Сен мен кім болсаң, Мен сондаймын
Dialogue: 0,0:07:47.86,0:07:50.58,Dialogue,,0,0,0,,Мен бұл сөйлемнің соңғы бөлігіне сенбегенім жөн.
Dialogue: 0,0:07:48.20,0:07:50.31,*Default-ja,NTP,0,0,0,,Соңғысын мойындағым келмейді.
Dialogue: 0,0:07:50.58,0:07:52.15,Dialogue,,0,0,0,,Олай айтпа...
Dialogue: 0,0:07:50.67,0:07:52.15,*Default-ja,NTP,0,0,0,,Олай айтпа
Dialogue: 0,0:07:52.46,0:07:54.51,Dialogue,,0,0,0,,Болашақта да саған сенемін деп сенемін.
Dialogue: 0,0:07:52.63,0:07:54.17,*Default-ja,NTP,0,0,0,,Мен сізден тұрақты қолдау күтемін.
Dialogue: 0,0:07:54.51,0:07:57.49,Dialogue,,0,0,0,,Мен сенімен тіл табысқым келеді, білесің.
Dialogue: 0,0:07:54.70,0:07:57.14,*Default-ja,NTP,0,0,0,,Мен сенімен жақсы араласқым келеді.
Dialogue: 0,0:07:57.49,0:07:59.49,Dialogue,,0,0,0,,Қазірден мәңгілікке...
Dialogue: 0,0:07:57.74,0:07:59.57,*Default-ja,NTP,0,0,0,,Бұдан былай да...
Dialogue: 0,0:08:05.29,0:08:08.82,Dialogue,,0,0,0,,Бұл жай мен бе, әлде шынымен қорқыныштысың ба?
Dialogue: 0,0:08:05.84,0:08:08.04,*Default-ja,NTP,0,0,0,,Мені қорқынышты сезінетін менің қиялым ба?
Dialogue: 0,0:08:08.14,0:08:10.63,*Default-ja,NTP,0,0,0,,Ой! Бұл сөзсіз менің қиялым
Dialogue: 0,0:08:08.82,0:08:11.03,Dialogue,,0,0,0,,Бұл тек сіз.
Dialogue: 0,0:08:11.03,0:08:13.51,Dialogue,,0,0,0,,Әйтеуір, сен дуллаханның не екенін білесің бе?
Dialogue: 0,0:08:11.10,0:08:13.74,*Default-ja,NTP,0,0,0,,Айтпақшы, сен Дуллаханның не екенін білесің бе?
Dialogue: 0,0:08:14.66,0:08:17.85,Dialogue,,0,0,0,,Бұл Ирландиядағы басы жоқ пері,
Dialogue: 0,0:08:15.01,0:08:17.70,*Default-ja,NTP,0,0,0,,Бұл Ирландиядан келген басы жоқ пері туралы болса керек.
Dialogue: 0,0:08:17.85,0:08:24.87,Dialogue,,0,0,0,,бірақ Йоэми саябағында карикатура суретшісі бар, ол мұндай адамды көргенін айтады.
Dialogue: 0,0:08:17.98,0:08:21.37,*Default-ja,NTP,0,0,0,,Жақында Йойоги саябағына қарт карикатурашы келді.
Dialogue: 0,0:08:21.63,0:08:24.28,*Default-ja,NTP,0,0,0,,Сіз мұны баяғыда көрдіңіз дедіңіз.
Dialogue: 0,0:08:24.87,0:08:33.53,Dialogue,,0,0,0,,«Оның басы жоқ еді! Басы жоқ» деп қайталай бергенін естідім, сондықтан ол дуллаханды меңзеп тұр ма деп ойлаймын...
Dialogue: 0,0:08:25.15,0:08:26.39,*Default-ja,NTP,0,0,0,,Енді сол қария
Dialogue: 0,0:08:26.69,0:08:29.70,*Default-ja,NTP,0,0,0,,«Мойын жоқ, мойын жоқ» деп шу шығарса керек.
Dialogue: 0,0:08:29.93,0:08:33.92,*Default-ja,NTP,0,0,0,,Негізінен бұл Дуллаханның мойнын білдіре ме?
Dialogue: 0,0:08:36.60,0:08:38.41,Dialogue,,0,0,0,,Ол әлі де сонда ма?
Dialogue: 0,0:08:36.84,0:08:38.10,*Default-ja,NTP,0,0,0,,Сіз әлі де сондасыз ба?
Dialogue: 0,0:08:38.41,0:08:40.73,Dialogue,,0,0,0,,Hmph. Кім біледі.
Dialogue: 0,0:08:38.54,0:08:40.75,*Default-ja,NTP,0,0,0,,Келіңіздер ме? Мен шынымен де түсінбеймін
Dialogue: 0,0:08:47.00,0:08:49.75,Dialogue,,0,0,0,,Мен оның қызықтыратынын білдім.
Dialogue: 0,0:08:47.35,0:08:49.03,*Default-ja,NTP,0,0,0,,Мен әлі де қызықпын.
Dialogue: 0,0:08:56.35,0:08:59.01,Thought,,0,0,0,,Селти Стурлюсон адам емес.
Dialogue: 0,0:08:56.58,0:08:58.98,*Default-ja,NTP,0,0,0,,Селти Стурлюсон адам емес
Dialogue: 0,0:08:59.57,0:09:05.56,Thought,,0,0,0,,Ол кельттердің «дуллахан» деп атаған қаңғыбас рухы.
Dialogue: 0,0:08:59.94,0:09:05.13,*Default-ja,NTP,0,0,0,,Көбінесе Дуллахан деп аталады, ол кельт фольклорында айтылатын пері түрі.
Dialogue: 0,0:09:10.11,0:09:12.59,Dialogue,,0,0,0,,Сіз карикатура суретшісін білесіз бе?
Dialogue: 0,0:09:10.62,0:09:12.50,*Default-ja,NTP,0,0,0,,Портрет салуды білмейсіз бе?
Dialogue: 0,0:09:13.29,0:09:16.41,Dialogue,,0,0,0,,О, ол енді мұнда жоқ.
Dialogue: 0,0:09:13.57,0:09:16.17,*Default-ja,NTP,0,0,0,,Ол адам енді мұнда жоқ.
Dialogue: 0,0:09:16.41,0:09:20.28,Dialogue,,0,0,0,,Эй, әлгі жігіт Йокогамаға көшетінін айтты емес пе?
Dialogue: 0,0:09:16.65,0:09:20.12,*Default-ja,NTP,0,0,0,,Сәлем! Ол Йокогамаға баратынын айтқан жоқ па?
Dialogue: 0,0:09:20.28,0:09:21.83,Dialogue,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:09:23.38,0:09:31.48,Thought,,0,0,0,,Дуллахан өзінің басы кесілген басын қолында ұстайды, ол «Кошитабава» деп аталатын басы жоқ ат сүйреген екі дөңгелекті арбаға мініп келе жатыр.
Dialogue: 0,0:09:23.56,0:09:26.55,*Default-ja,NTP,0,0,0,,Дуллахан кесілген басын қолтығынан ұстайды.
Dialogue: 0,0:09:26.79,0:09:31.27,*Default-ja,NTP,0,0,0,,Ол Қоштабава деген басы жоқ ат сүйреткен екі дөңгелекті арбаға мініп келеді.
Dialogue: 0,0:09:35.11,0:09:39.59,Thought,,0,0,0,,Өлім алдында тұрған адамдардың үйіне барады.
Dialogue: 0,0:09:35.33,0:09:39.03,*Default-ja,NTP,0,0,0,,Олар өліп жатқан адамның үйіне барады.
Dialogue: 0,0:09:47.28,0:09:50.90,Thought,,0,0,0,,Егер сіз оған есікті кездейсоқ ашсаңыз, сіздің өміріңіз аяқталады.
Dialogue: 0,0:09:47.63,0:09:50.87,*Default-ja,NTP,0,0,0,,Есікті абайсызда ашсаңыз...
Dialogue: 0,0:09:54.69,0:09:57.45,Thought,,0,0,0,,Жуу жәшігіндегі қанға сіңіп қалдыңыз.
Dialogue: 0,0:09:55.25,0:09:57.69,*Default-ja,NTP,0,0,0,,Қан құйылған ванна
Dialogue: 0,0:09:59.53,0:10:07.29,Thought,,0,0,0,,Оның қазіргі түрін сол қорқынышты және қанды аңызбен байланыстыру қиын болар еді.
Dialogue: 0,0:09:59.93,0:10:02.65,*Default-ja,NTP,0,0,0,,Өлімнің иісі аңқып тұрған осындай сұмдық аңыз.
Dialogue: 0,0:10:02.94,0:10:06.60,*Default-ja,NTP,0,0,0,,Оның өмірдегі сыртқы келбетімен байланыстыру оңай емес.
Dialogue: 0,0:10:07.29,0:10:09.75,Thought,,0,0,0,,Оның басы жоқ екенін қоспағанда.
Dialogue: 0,0:10:07.58,0:10:09.22,*Default-ja,NTP,0,0,0,,Бастың жоқтығынан басқа...
Dialogue: 0,0:10:10.45,0:10:15.71,Thought,,0,0,0,,Жапонияның Токио қаласындағы Икебукуроға не үшін келді?
Dialogue: 0,0:10:10.76,0:10:15.21,*Default-ja,NTP,0,0,0,,Ол мына Жапонияға, мына Токиоға, осы Икебукураға не үшін келді?
Dialogue: 0,0:10:15.71,0:10:19.51,Thought,,0,0,0,,Неліктен ол өз басы үшін соншалықты алаңдайды?
Dialogue: 0,0:10:15.79,0:10:18.78,*Default-ja,NTP,0,0,0,,Неліктен мойынға мұнша көндің?
Dialogue: 0,0:10:20.32,0:10:22.80,Dialogue,,0,0,0,,Мен бұл туралы дәл қазір айтамын.
Dialogue: 0,0:10:20.56,0:10:22.42,*Default-ja,NTP,0,0,0,,Енді бұл туралы сөйлесейік.
Dialogue: 0,0:10:30.34,0:10:32.73,Thought,,0,0,0,,Бұл жиырма жыл бұрын болған.
Dialogue: 0,0:10:30.84,0:10:32.60,*Default-ja,NTP,0,0,0,,Бұл 20 жыл бұрын болды.
Dialogue: 0,0:10:33.26,0:10:39.40,Thought,,0,0,0,,Бір күні тауда оянса, басы жоқ екен.
Dialogue: 0,0:10:33.49,0:10:36.15,*Default-ja,NTP,0,0,0,,Ол кенет тауда оянғанда
Dialogue: 0,0:10:36.58,0:10:38.47,*Default-ja,NTP,0,0,0,,Мен білмей тұрып, басым кетіп қалды.
Dialogue: 0,0:10:39.40,0:10:44.24,Thought,,0,0,0,,Осы сәтте ол әртүрлі естеліктерін жоғалтқанын байқады.
Dialogue: 0,0:10:39.65,0:10:44.08,*Default-ja,NTP,0,0,0,,Осы кезде мен түрлі естеліктер жетіспейтінін түсіндім.
Dialogue: 0,0:10:44.86,0:10:52.02,Thought,,0,0,0,,Оның тұлғасы және өткен өмірі туралы естеліктер сияқты нәрселер.
Dialogue: 0,0:10:45.21,0:10:48.15,*Default-ja,NTP,0,0,0,,Өз әрекетінің себебі осы ма?
Dialogue: 0,0:10:48.50,0:10:51.20,*Default-ja,NTP,0,0,0,,Белгілі бір уақытқа оралатын өткен күннен естеліктер
Dialogue: 0,0:10:52.02,0:11:02.53,Thought,,0,0,0,,Алайда ол өзінің дуллахан екенін, есімі Селти Стурлюсон екенін және белгілі бір қабілеттерге ие екенін есіне алды.
Dialogue: 0,0:10:52.33,0:10:57.78,*Default-ja,NTP,0,0,0,,Дегенмен мен Дуллахан болуым керек, ал менің атым Селти Стурлусон болуы керек.
Dialogue: 0,0:10:58.23,0:11:02.24,*Default-ja,NTP,0,0,0,,Мен өз қабілеттерімді қалай пайдалану керектігін міндетті түрде есіме түсірдім.
Dialogue: 0,0:11:04.53,0:11:07.27,Thought,,0,0,0,,Оның таң қалғаны бірінші болды...
Dialogue: 0,0:11:05.00,0:11:07.09,*Default-ja,NTP,0,0,0,,Ал оны таң қалдырған бірінші нәрсе...
Dialogue: 0,0:11:07.65,0:11:11.40,Dialogue,,0,0,0,,Мен нәрселерді тек баспен ойламаймын.
Dialogue: 0,0:11:07.73,0:11:11.32,*Default-ja,NTP,0,0,0,,Мен өз басым ойланбадым...
Dialogue: 0,0:11:11.40,0:11:13.49,Thought,,0,0,0,,Ол айтқандай.
Dialogue: 0,0:11:11.66,0:11:12.88,*Default-ja,NTP,0,0,0,,...
Dialogue: 0,0:11:14.28,0:11:20.28,Thought,,0,0,0,,Ол сондай-ақ жақын жерде басының барын сезгенін байқады.
Dialogue: 0,0:11:14.64,0:11:19.53,*Default-ja,NTP,0,0,0,,Осыдан кейін мен өзімнің мойным сияқты көрінетін қатысуды сезіне алатынымды байқадым.
Dialogue: 0,0:11:27.29,0:11:31.56,Thought,,0,0,0,,Жағдайды бағалай отырып, ол бір нәрсені қорытындылады.
Dialogue: 0,0:11:27.63,0:11:30.96,*Default-ja,NTP,0,0,0,,Жағдайды ескере отырып, ол шегерім жасады.
Dialogue: 0,0:11:31.56,0:11:40.30,Thought,,0,0,0,,Оның ерік-жігерін оның денесі мен басы бөлісті және оның жоғалған естеліктері оның басында жатуы керек.
Dialogue: 0,0:11:31.85,0:11:36.20,*Default-ja,NTP,0,0,0,,Адамның өз еркі бастапқыда тән мен ақыл арасында ортақ болды.
Dialogue: 0,0:11:36.48,0:11:40.35,*Default-ja,NTP,0,0,0,,Қызық, жоғалған естеліктер менің басымда жатыр ма?
Dialogue: 0,0:11:40.97,0:11:43.03,Thought,,0,0,0,,Содан кейін ол шешім қабылдады.
Dialogue: 0,0:11:41.23,0:11:42.75,*Default-ja,NTP,0,0,0,,Ол шешті
Dialogue: 0,0:11:43.03,0:11:46.25,Thought,,0,0,0,,Ол басын қайтарып, өзінің өмір сүруінің мәнін есіне түсірмек болды.
Dialogue: 0,0:11:43.30,0:11:46.11,*Default-ja,NTP,0,0,0,,Өз болмысының мәнін білу қабілетін қалпына келтіру
Dialogue: 0,0:11:46.25,0:11:50.31,Thought,,0,0,0,,Мұның өзі оның өмірдегі мақсаты болды.
Dialogue: 0,0:11:46.55,0:11:49.95,*Default-ja,NTP,0,0,0,,Менің қазіргі өмір сүруімнің себебі осы.
Dialogue: 0,0:11:51.33,0:11:56.87,Thought,,0,0,0,,Оның басы өз еркімен денесінен шығып кеткен болуы мүмкін.
Dialogue: 0,0:11:51.63,0:11:56.57,*Default-ja,NTP,0,0,0,,Мүмкін басы денеден өз еркімен шығып кеткен шығар.
Dialogue: 0,0:11:56.87,0:12:01.06,Thought,,0,0,0,,Солай болса да, ол оны қайтарып алмаса, білмейді.
Dialogue: 0,0:11:56.93,0:12:00.40,*Default-ja,NTP,0,0,0,,Олай болса да, ақырында қолыңмен ұстамайынша білмейсің.
Dialogue: 0,0:12:01.87,0:12:04.43,Dialogue,,0,0,0,,Ол енді Йокогамада болған жоқ.
Dialogue: 0,0:12:02.10,0:12:04.07,*Default-ja,NTP,0,0,0,,Ол енді Йокогамада болмады.
Dialogue: 0,0:12:04.43,0:12:07.83,Dialogue,,0,0,0,,Мен Таманы, одан кейін Чибаны сынап көрдім.
Dialogue: 0,0:12:04.70,0:12:05.75,*Default-ja,NTP,0,0,0,,Келесі - Тама
Dialogue: 0,0:12:05.98,0:12:07.30,*Default-ja,NTP,0,0,0,,Келесі Чиба
Dialogue: 0,0:12:07.83,0:12:10.33,Dialogue,,0,0,0,,Қайда барсам да таба алмадым.
Dialogue: 0,0:12:08.12,0:12:10.03,*Default-ja,NTP,0,0,0,,Қайда барсам да, дұрыс емес жерде қалдым.
Dialogue: 0,0:12:10.33,0:12:13.83,Dialogue,,0,0,0,,Сіз ертеңге дейін күтуіңіз керек еді.
Dialogue: 0,0:12:10.59,0:12:12.87,*Default-ja,NTP,0,0,0,,Сіз мұны ертең қайталай аласыз.
Dialogue: 0,0:12:13.83,0:12:15.67,Dialogue,,0,0,0,,Мен шарасыз болдым.
Dialogue: 0,0:12:14.23,0:12:15.56,*Default-ja,NTP,0,0,0,,Бұл шарасыз болды.
Dialogue: 0,0:12:15.67,0:12:19.42,Dialogue,,0,0,0,,Менің басым сонда болуы мүмкін.
Dialogue: 0,0:12:16.16,0:12:18.64,*Default-ja,NTP,0,0,0,,Менің басым сонда болуы мүмкін.
Dialogue: 0,0:12:21.21,0:12:23.71,Dialogue,,0,0,0,,Не болса да қайтарып алғым келді.
Dialogue: 0,0:12:21.48,0:12:25.41,*Default-ja,NTP,0,0,0,,Мен оны мүмкіндігінше тезірек қайтарғым келді
Dialogue: 0,0:12:23.71,0:12:25.72,Dialogue,,0,0,0,,Тіпті бір күн бұрын болса да...
Dialogue: 0,0:12:25.72,0:12:30.51,Dialogue,,0,0,0,,Мен енді тек бұлдыр естеліктермен өмір сүргім келмейді.
Dialogue: 0,0:12:25.99,0:12:29.99,*Default-ja,NTP,0,0,0,,Мен бұлай өмір сүргім келмейді... тіпті менің естеліктерім бұлыңғыр.
Dialogue: 0,0:12:31.89,0:12:37.48,Thought,,0,0,0,,Сол әлсіз көріністен кейін басы шығып кетті, ол сонша келді...
Dialogue: 0,0:12:32.38,0:12:34.73,*Default-ja,NTP,0,0,0,,Айналаңызда қалған әлсіз белгілерді қадағалаңыз
Dialogue: 0,0:12:35.02,0:12:36.68,*Default-ja,NTP,0,0,0,,Осы уақытқа дейін жеткенімізбен
Dialogue: 0,0:12:37.48,0:12:41.03,Thought,,0,0,0,,Бірақ оның басы елден кетіп қалған сияқты.
Dialogue: 0,0:12:37.65,0:12:40.64,*Default-ja,NTP,0,0,0,,Басы шетелге кеткен көрінеді.
Dialogue: 0,0:12:41.56,0:12:44.00,Thought,,0,0,0,,Кеме Жапонияға бет алды.
Dialogue: 0,0:12:41.82,0:12:43.60,*Default-ja,NTP,0,0,0,,Кеменің баратын жері Жапония сияқты.
Dialogue: 0,0:12:44.00,0:12:47.00,Thought,,0,0,0,,Ол тоқтап, соңынан еруді шешті.
Dialogue: 0,0:12:44.32,0:12:47.02,*Default-ja,NTP,0,0,0,,Қойылып, менің артымнан еретін болсаң, жарайды.
Dialogue: 0,0:12:47.00,0:12:48.74,Thought,,0,0,0,,Мәселе оның жылқысында болды.
Dialogue: 0,0:12:47.24,0:12:48.84,*Default-ja,NTP,0,0,0,,Мәселе мына жылқыда.
Dialogue: 0,0:12:49.88,0:12:55.00,Thought,,0,0,0,,Дуллалықтар өздерінің қызметшілері ретінде жылқының етін иемденеді.
Dialogue: 0,0:12:50.18,0:12:54.58,*Default-ja,NTP,0,0,0,,Бұл бір жылқы мәйітін иемденген Дуллаханның танысы сияқты.
Dialogue: 0,0:12:55.00,0:13:01.79,Thought,,0,0,0,,Ол оны жоғалтып жіберуі мүмкін еді, бірақ оның қайда кеткенін оның басы ғана біледі.
Dialogue: 0,0:12:55.38,0:12:57.91,*Default-ja,NTP,0,0,0,,Қажет болса, мен оны өшіріп тастар едім.
Dialogue: 0,0:12:58.31,0:13:01.42,*Default-ja,NTP,0,0,0,,Бұдан кейін қайда барасың?
Dialogue: 0,0:13:01.79,0:13:09.80,Thought,,0,0,0,,Сондықтан оны қалай жою керектігін білсе де, ол мұны істей алмады.
Dialogue: 0,0:13:02.03,0:13:04.14,*Default-ja,NTP,0,0,0,,Ол естелік сіздің басыңызда болса керек.
Dialogue: 0,0:13:04.83,0:13:07.05,*Default-ja,NTP,0,0,0,,Олай ойласаң, өшіруді білсең де
Dialogue: 0,0:13:07.06,0:13:08.78,*Default-ja,NTP,0,0,0,,Мен шешім қабылдауда қиналып жүрмін.
Dialogue: 0,0:13:17.13,0:13:18.51,Thought,,0,0,0,,Ол кезде...
Dialogue: 0,0:13:17.47,0:13:18.54,*Default-ja,NTP,0,0,0,,Осындай кезде...
Dialogue: 0,0:13:22.84,0:13:24.28,Thought,,0,0,0,,Ол...
Dialogue: 0,0:13:23.15,0:13:24.23,*Default-ja,NTP,0,0,0,,...
Dialogue: 0,0:13:26.03,0:13:27.98,Thought,,0,0,0,,Оған тап болды.
Dialogue: 0,0:13:26.25,0:13:27.65,*Default-ja,NTP,0,0,0,,Мен оны кездестірдім
Dialogue: 0,0:13:30.90,0:13:34.71,Dialogue,,0,0,0,,Мен оны еш жерден таба алмадым.
Dialogue: 0,0:13:31.29,0:13:34.32,*Default-ja,NTP,0,0,0,,Оны еш жерден таба алмадым
Dialogue: 0,0:13:34.71,0:13:36.30,Dialogue,,0,0,0,,Мен сенің жаныңа дүрлігіп бара жатырмын, дірілдеп
Dialogue: 0,0:13:34.98,0:13:35.93,*Default-ja,NTP,0,0,0,,Басқа амал жоқ па?!
Dialogue: 0,0:13:36.30,0:13:40.29,Dialogue,,0,0,0,,Эй, мен ол жігітті білемін.
Dialogue: 0,0:13:37.63,0:13:39.45,*Default-ja,NTP,0,0,0,,Ах~ Мен ол карикатурашыны білемін.
Dialogue: 0,0:13:40.90,0:13:45.45,Dialogue,,0,0,0,,Ол екі күн бұрын Оңтүстік Икебукуро саябағында болды.
Dialogue: 0,0:13:41.13,0:13:44.48,*Default-ja,NTP,0,0,0,,Мен кешеден бері Минами Икебукуро саябағына келе жатырмын.
Dialogue: 0,0:13:43.72,0:13:45.45,Secondary,,0,0,0,,Б... бір сызық
Dialogue: 0,0:13:44.55,0:13:46.72,*Default-ja,NTP,0,0,0,,Иә, мен сенімен барайын ба?
Dialogue: 0,0:13:45.45,0:13:47.56,Dialogue,,0,0,0,,Сені оған апарғанымды қалайсың ба?
Dialogue: 0,0:13:50.00,0:13:53.68,Dialogue,,0,0,0,,Бұлай өмір сүру ыңғайсыз болуы керек, солай ма?
Dialogue: 0,0:13:50.35,0:13:51.87,*Default-ja,NTP,0,0,0,,Бұл ыңғайсыз емес пе? Не?
Dialogue: 0,0:13:57.92,0:13:59.68,Dialogue,,0,0,0,,Міне, кеттіңіз.
Dialogue: 0,0:13:58.21,0:14:00.02,*Default-ja,NTP,0,0,0,,Міне, орындалды.
Dialogue: 0,0:14:01.33,0:14:03.55,*Default-ja,NTP,0,0,0,,Уау~ Бұл керемет!
Dialogue: 0,0:14:02.17,0:14:03.48,Dialogue,,0,0,0,,Керемет!
Dialogue: 0,0:14:03.48,0:14:05.65,Dialogue,,0,0,0,,Ол сені өзіңнен де әдемірек тартты, Ариса.
Dialogue: 0,0:14:03.59,0:14:05.34,*Default-ja,NTP,0,0,0,,Ол Арисадан әдемірек көрінеді
Dialogue: 0,0:14:05.87,0:14:07.53,Dialogue,,0,0,0,,Бір сәт те жоғалтуға болмайды.
Dialogue: 0,0:14:05.99,0:14:07.22,*Default-ja,NTP,0,0,0,,Иә? Бір минут күтіңіз!
Dialogue: 0,0:14:07.53,0:14:09.40,Dialogue,,0,0,0,,Әдеттегідей керемет жұмыс, мырза.
Dialogue: 0,0:14:07.61,0:14:09.45,*Default-ja,NTP,0,0,0,,Сіз күткендей, ағай!
Dialogue: 0,0:14:09.40,0:14:14.79,Dialogue,,0,0,0,,Жоқ, жоқ, мен әлі күнге дейін заттарды өзім елестеткендей сала алмаймын.
Dialogue: 0,0:14:09.61,0:14:10.46,*Default-ja,NTP,0,0,0,,Жоқ, жоқ, жоқ
Dialogue: 0,0:14:10.53,0:14:14.69,*Default-ja,NTP,0,0,0,,Мен әлі де сурет салғым келетін нәрсені дұрыс сала алмаймын.
Dialogue: 0,0:14:15.65,0:14:17.70,Dialogue,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:14:15.90,0:14:17.23,*Default-ja,NTP,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:14:17.70,0:14:19.92,Dialogue,,0,0,0,,Менің қуанышым.
Dialogue: 0,0:14:17.82,0:14:19.09,*Default-ja,NTP,0,0,0,,Қош келдіңіз
Dialogue: 0,0:14:19.92,0:14:20.87,Dialogue,,0,0,0,,Қайта кел!
Dialogue: 0,0:14:20.09,0:14:20.88,*Default-ja,NTP,0,0,0,,Қайта кел
Dialogue: 0,0:14:20.87,0:14:22.38,Dialogue,,0,0,0,,Ә... ә... білесің бе...
Dialogue: 0,0:14:20.91,0:14:21.85,*Default-ja,NTP,0,0,0,,≪Бұл жай ғана зор күшпен соққы емес➡
Dialogue: 0,0:14:24.31,0:14:27.66,Dialogue,,0,0,0,,Кешіріңіз, бірақ қараңғы.
Dialogue: 0,0:14:25.40,0:14:27.62,*Default-ja,NTP,0,0,0,,Кешіріңіз, қазір қараңғы.
Dialogue: 0,0:14:27.66,0:14:29.43,Dialogue,,0,0,0,,Мен бұл күнді аяқтадым.
Dialogue: 0,0:14:27.81,0:14:29.40,*Default-ja,NTP,0,0,0,,Бүгінгі күннің бәрі осы.
Dialogue: 0,0:14:29.43,0:14:31.85,Dialogue,,0,0,0,,Дуллаханды көргенің рас па?
Dialogue: 0,0:14:29.61,0:14:32.27,*Default-ja,NTP,0,0,0,,Дуллаханды көргенің рас па?
Dialogue: 0,0:14:31.85,0:14:33.50,Dialogue,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:14:34.99,0:14:38.20,Dialogue,,0,0,0,,Иә... иә, солай.
Dialogue: 0,0:14:36.81,0:14:38.09,*Default-ja,NTP,0,0,0,,О, бұл рас.
Dialogue: 0,0:14:38.20,0:14:41.84,Dialogue,,0,0,0,,Мен жас кезімде Ирландияның тауларында көрдім.
Dialogue: 0,0:14:38.38,0:14:42.00,*Default-ja,NTP,0,0,0,,Мен мұны жас кезімде Ирландияның тауларында көрдім.
Dialogue: 0,0:14:41.84,0:14:44.40,Dialogue,,0,0,0,,Мен оны осы көзбен көрдім, мен сенімдімін.
Dialogue: 0,0:14:42.16,0:14:44.14,*Default-ja,NTP,0,0,0,,Сөзсіз өз көзіммен
Dialogue: 0,0:14:45.87,0:14:48.15,Dialogue,,0,0,0,,«Басынан айырылды?» дегенді қалай түсінесіңдер?
Dialogue: 0,0:14:48.45,0:14:52.86,Dialogue,,0,0,0,,«Ол басынан айырылды ма?» Бұл сол емес.
Dialogue: 0,0:14:48.76,0:14:50.18,*Default-ja,NTP,0,0,0,,«Басы жоқ»?
Dialogue: 0,0:14:50.53,0:14:52.29,*Default-ja,NTP,0,0,0,,Қайырлы таң, Камилла.
Dialogue: 0,0:14:52.86,0:14:54.66,Dialogue,,0,0,0,,Оның басы жоқ еді.
Dialogue: 0,0:14:53.06,0:14:54.78,*Default-ja,NTP,0,0,0,,Бұл басы жоқ.
Dialogue: 0,0:14:54.66,0:14:57.55,Dialogue,,0,0,0,,Мен оны дұрыс сала алмаймын.
Dialogue: 0,0:14:55.09,0:14:57.38,*Default-ja,NTP,0,0,0,,Мен жай ғана мойынымды шеше алмаймын.
Dialogue: 0,0:15:00.42,0:15:01.96,Dialogue,,0,0,0,,Қарау.
Dialogue: 0,0:15:00.70,0:15:01.70,*Default-ja,NTP,0,0,0,,Қараңыз
Dialogue: 0,0:15:09.55,0:15:13.54,Dialogue,,0,0,0,,Бұл әйел еді, әрі өте әдемі.
Dialogue: 0,0:15:10.02,0:15:14.04,*Default-ja,NTP,0,0,0,,Бұл әйел еді, ол да өте сұлу еді.
Dialogue: 0,0:15:14.35,0:15:18.51,Dialogue,,0,0,0,,Ол шынымен тұманды түнде тау жолында менің қасымнан өтті.
Dialogue: 0,0:15:14.88,0:15:18.44,*Default-ja,NTP,0,0,0,,Тұманды түнде тау жолында бір-бірімізден өттік
Dialogue: 0,0:15:19.30,0:15:24.86,Dialogue,,0,0,0,,Ол керемет жылдамдықпен өтіп бара жатқанда қорқынышты, бірақ әдемі болды.
Dialogue: 0,0:15:19.54,0:15:25.06,*Default-ja,NTP,0,0,0,,Ол қатты жылдамдықпен қашып кетті, бұл қорқынышты, бірақ әдемі фигура.
Dialogue: 0,0:15:26.09,0:15:30.90,Dialogue,,0,0,0,,Мен оның бұл дүниелік емес екенін білдім.
Dialogue: 0,0:15:26.40,0:15:29.95,*Default-ja,NTP,0,0,0,,Бұл дүниелік емес... Мен интуитивті түрде сезіндім.
Dialogue: 0,0:15:31.29,0:15:36.77,Dialogue,,0,0,0,,Қонақ үйге қайтып келіп, біреумен сөйлескенімде, ол маған бұл сөзсіз, дуллахан екенін айтты.
Dialogue: 0,0:15:31.65,0:15:33.85,*Default-ja,NTP,0,0,0,,Қонақ үйге оралып, сөйлескеннен кейін
Dialogue: 0,0:15:34.00,0:15:36.58,*Default-ja,NTP,0,0,0,,Маған бұл Дуллахан болуы керек деді.
Dialogue: 0,0:15:36.77,0:15:39.77,Dialogue,,0,0,0,,Олар бұл жерді ертеден мекендеген.
Dialogue: 0,0:15:36.98,0:15:39.81,*Default-ja,NTP,0,0,0,,Олар ерте заманнан бері сол аймақта өмір сүрсе керек.
Dialogue: 0,0:15:39.77,0:15:43.42,Dialogue,,0,0,0,,Неге сенің дуллахтарың басын ұстамайды?
Dialogue: 0,0:15:40.01,0:15:43.11,*Default-ja,NTP,0,0,0,,Сенің Дуллахаң неге мойнын ұстамайды?
Dialogue: 0,0:15:43.42,0:15:45.37,Dialogue,,0,0,0,,Мен олардың суретін сала алмаймын.
Dialogue: 0,0:15:43.60,0:15:45.00,*Default-ja,NTP,0,0,0,,Мен сурет сала алмаймын
Dialogue: 0,0:15:45.37,0:15:48.92,Dialogue,,0,0,0,,Мен оларды салуға тырысқан сайын, олар әртүрлі болады.
Dialogue: 0,0:15:45.55,0:15:47.92,*Default-ja,NTP,0,0,0,,Неғұрлым көп сурет салсаңыз, соғұрлым басқаша көрінеді
Dialogue: 0,0:15:48.92,0:15:55.50,Dialogue,,0,0,0,,Сол күнгі менің есімде сақталғаны сонша, бірақ ол әйелді мүлде есіме түсіре алмаймын.
Dialogue: 0,0:15:49.40,0:15:55.00,*Default-ja,NTP,0,0,0,,Сол күндегі естеліктерім анық болса да, мен ол әйелге жете алмаймын.
Dialogue: 0,0:15:56.05,0:16:01.48,Dialogue,,0,0,0,,Оның шашы қандай түсті? Оның көздері? Оның бет әлпеті ше?
Dialogue: 0,0:15:56.31,0:15:59.07,*Default-ja,NTP,0,0,0,,Әйелдің шашының түсі қандай? Көздерің қандай түсті?
Dialogue: 0,0:15:59.31,0:16:00.56,*Default-ja,NTP,0,0,0,,Оның көрінісі қандай болды?
Dialogue: 0,0:16:02.21,0:16:06.44,Dialogue,,0,0,0,,Білсем, оның суретін салып әуре болмас едім.
Dialogue: 0,0:16:02.45,0:16:06.71,*Default-ja,NTP,0,0,0,,Егер айта алсам, оны бояу ойыма келмес еді.
Dialogue: 0,0:16:06.91,0:16:10.41,Dialogue,,0,0,0,,Бір күні бір бейтаныс адам келді.
Dialogue: 0,0:16:07.24,0:16:10.43,*Default-ja,NTP,0,0,0,,Енді ойлап қарасам, жақында маған бір бейтаныс адам келді.
Dialogue: 0,0:16:10.41,0:16:14.28,Dialogue,,0,0,0,,Ол маған суреттің тамаша екенін айтты.
Dialogue: 0,0:16:10.64,0:16:14.01,*Default-ja,NTP,0,0,0,,Адам суретті тамаша дейді.
Dialogue: 0,0:16:14.28,0:16:17.52,Dialogue,,0,0,0,,Оның басы болмауы керек деді.
Dialogue: 0,0:16:14.47,0:16:17.24,*Default-ja,NTP,0,0,0,,Оның басы жоқ деп үміттенемін.
Dialogue: 0,0:16:18.61,0:16:21.33,Dialogue,,0,0,0,,Қандай қызық жігіт.
Dialogue: 0,0:16:18.91,0:16:20.53,*Default-ja,NTP,0,0,0,,Ол біртүрлі адам еді.
Dialogue: 0,0:16:21.33,0:16:24.29,Dialogue,,0,0,0,,Оған неге сонша мән бересің?
Dialogue: 0,0:16:21.48,0:16:23.85,*Default-ja,NTP,0,0,0,,Неліктен сіз бұған ерекше назар аударасыз?
Dialogue: 0,0:16:24.29,0:16:28.10,Dialogue,,0,0,0,,Сол тәжірибе менің өмірімнің шыңы болды.
Dialogue: 0,0:16:24.54,0:16:28.06,*Default-ja,NTP,0,0,0,,Бұл тәжірибе менің өмірімдегі ең жақсы оқиға болды.
Dialogue: 0,0:16:28.10,0:16:30.60,Dialogue,,0,0,0,,Сол бір түн менің бүкіл өмірім болды.
Dialogue: 0,0:16:28.26,0:16:30.29,*Default-ja,NTP,0,0,0,,Бұл түн өмір бойы жалғасты
Dialogue: 0,0:16:30.60,0:16:35.53,Dialogue,,0,0,0,,Мен сол кездегі сезімдер мен естеліктерімді қайтарғым келеді.
Dialogue: 0,0:16:30.73,0:16:34.97,*Default-ja,NTP,0,0,0,,Мен сол сәтті, сол кездегі естелікті қайтарғым келеді.
Dialogue: 0,0:16:41.64,0:16:43.64,Dialogue,,0,0,0,,Рахмет, жігітім.
Dialogue: 0,0:16:42.06,0:16:43.74,*Default-ja,NTP,0,0,0,,Рахмет, қария.
Dialogue: 0,0:16:44.12,0:16:45.94,Dialogue,,0,0,0,,Мен түсіндім.
Dialogue: 0,0:16:44.52,0:16:45.74,*Default-ja,NTP,0,0,0,,Мен көремін.
Dialogue: 0,0:16:48.19,0:16:53.12,Dialogue,,0,0,0,,Онымен кездескеніңіз есіңде жоқ, солай ма?
Dialogue: 0,0:16:48.65,0:16:52.50,*Default-ja,NTP,0,0,0,,Айтпақшы, әлгі қартпен кездескеніңіз есіңізде жоқ па?
Dialogue: 0,0:16:55.06,0:16:56.09,Dialogue,,0,0,0,,Ақыры заман мені қуып жетті ме?
Dialogue: 0,0:16:55.32,0:16:56.17,*Default-ja,NTP,0,0,0,,(Чунтарo) Чип… (Танжиро) Ә?
Dialogue: 0,0:16:56.09,0:17:00.32,Dialogue,,0,0,0,,Ол дуллахан сен болған шығар, жоқ шығар.
Dialogue: 0,0:16:56.32,0:16:59.80,*Default-ja,NTP,0,0,0,,Сол Дуллахан сен боларсың, жоқсың.
Dialogue: 0,0:17:00.32,0:17:02.70,Dialogue,,0,0,0,,Немесе ол көргенін қате түсінген болуы мүмкін.
Dialogue: 0,0:17:00.56,0:17:03.07,*Default-ja,NTP,0,0,0,,Немесе бұл жай ғана түсінбеушілік шығар.
Dialogue: 0,0:17:02.70,0:17:04.91,Dialogue,,0,0,0,,Бұл сөзсіз мен болдым.
Dialogue: 0,0:17:03.24,0:17:05.92,*Default-ja,NTP,0,0,0,,Бұл менмін, мен сенімдімін.
Dialogue: 0,0:17:04.91,0:17:06.10,Dialogue,,0,0,0,,Мен оны білемін.
Dialogue: 0,0:17:06.10,0:17:07.17,Dialogue,,0,0,0,,Жарайды.
Dialogue: 0,0:17:06.26,0:17:07.12,*Default-ja,NTP,0,0,0,,Леви… бұл сенің кінәң.
Dialogue: 0,0:17:09.75,0:17:12.67,Dialogue,,0,0,0,,Мен қайда бардым?
Dialogue: 0,0:17:09.96,0:17:12.51,*Default-ja,NTP,0,0,0,,Мен қайда жүгірдім?
Dialogue: 0,0:17:12.67,0:17:16.01,Dialogue,,0,0,0,,Мен не ойладым және қандай мақсат қойдым?
Dialogue: 0,0:17:12.92,0:17:15.48,*Default-ja,NTP,0,0,0,,Сіз не ойлайсыз және қандай мақсатта...
Dialogue: 0,0:17:16.01,0:17:19.06,Dialogue,,0,0,0,,Сізге шынымен де бұл туралы көп уайымдау керек пе?
Dialogue: 0,0:17:16.25,0:17:18.64,*Default-ja,NTP,0,0,0,,Бұл туралы шынымен алаңдауымыз керек пе?
Dialogue: 0,0:17:19.06,0:17:20.21,Dialogue,,0,0,0,,Мен сенің жаныңа жүгіріп бара жатырмын, дірілдеп
Dialogue: 0,0:17:20.21,0:17:25.04,Dialogue,,0,0,0,,Сіз өз қалауыңыз бойынша пайда бола аласыз және жоғала аласыз және сіз сергітетін бірегейсіз.
Dialogue: 0,0:17:20.36,0:17:24.68,*Default-ja,NTP,0,0,0,,Сіз шынымен қол жетпес, жаңашыл адамсыз.
Dialogue: 0,0:17:25.04,0:17:30.23,Dialogue,,0,0,0,,Дегенмен, сіз өз тілегіңіздің орындалуынан әлі де алыссыз.
Dialogue: 0,0:17:25.31,0:17:27.55,*Default-ja,NTP,0,0,0,,Бірақ дәл қазіргідей
Dialogue: 0,0:17:27.59,0:17:30.09,*Default-ja,NTP,0,0,0,,Өз қалауларыңызға жету - ұзақ жол.
Dialogue: 0,0:17:30.54,0:17:32.01,Dialogue,,0,0,0,,Сіз не айтқыңыз келіп тұр?
Dialogue: 0,0:17:30.82,0:17:31.97,*Default-ja,NTP,0,0,0,,Не айтпақшысың?
Dialogue: 0,0:17:32.01,0:17:33.44,Dialogue,,0,0,0,,Бұл қарапайым...
Dialogue: 0,0:17:32.20,0:17:34.66,*Default-ja,NTP,0,0,0,,Жай ғана айтайын, берілме.
Dialogue: 0,0:17:33.44,0:17:35.24,Dialogue,,0,0,0,,Тек бас тарт.
Dialogue: 0,0:17:37.01,0:17:41.02,Dialogue,,0,0,0,,Әлгі біртүрлі адам дұрыс шығар.
Dialogue: 0,0:17:37.44,0:17:40.95,*Default-ja,NTP,0,0,0,,Әлгі біртүрлі адамның айтқаны рас емес пе?
Dialogue: 0,0:17:41.02,0:17:44.50,Dialogue,,0,0,0,,Басың болмаса жақсы боларсың.
Dialogue: 0,0:17:41.42,0:17:44.03,*Default-ja,NTP,0,0,0,,Басым болмаса жақсы емес пе?
Dialogue: 0,0:17:47.79,0:17:53.43,Dialogue,,0,0,0,,Басыңды іздеуді қойып, бірге бір жерге барайық.
Dialogue: 0,0:17:48.15,0:17:50.13,*Default-ja,NTP,0,0,0,,Өз басыңды іздеуді доғар.
Dialogue: 0,0:17:51.10,0:17:52.56,*Default-ja,NTP,0,0,0,,Бір жерге бірге барайық
Dialogue: 0,0:17:53.43,0:17:55.00,Dialogue,,0,0,0,,Кез келген жерде жақсы.
Dialogue: 0,0:17:53.70,0:17:54.77,*Default-ja,NTP,0,0,0,,Шынымен де мүлде бос…
Dialogue: 0,0:17:55.99,0:18:02.72,Dialogue,,0,0,0,,Қалағанша, мен сені туған жеріңе қайтару үшін қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:17:56.32,0:18:01.93,*Default-ja,NTP,0,0,0,,Қаласаң, мен сені туған жеріңе қайтару үшін қолымнан келгеннің бәрін жасаймын.
Dialogue: 0,0:18:02.72,0:18:04.71,Dialogue,,0,0,0,,Мен де сонда барамын.
Dialogue: 0,0:18:02.89,0:18:06.36,*Default-ja,NTP,0,0,0,,Мен де сонда барамын, мәңгі бірге боламыз...
Dialogue: 0,0:18:04.71,0:18:06.16,Dialogue,,0,0,0,,Біз мәңгі бірге боламыз.
Dialogue: 0,0:18:06.16,0:18:12.15,Dialogue,,0,0,0,,Мен сені жек көрмеймін, бірақ қазір жағдайым жақсы.
Dialogue: 0,0:18:06.46,0:18:08.38,*Default-ja,NTP,0,0,0,,Мен сені жек көрмеймін, бірақ
Dialogue: 0,0:18:08.54,0:18:11.68,*Default-ja,NTP,0,0,0,,Қазір мұнда тұру жеткілікті.
Dialogue: 0,0:18:12.15,0:18:13.68,Dialogue,,0,0,0,,Олай айтпа...
Dialogue: 0,0:18:12.37,0:18:13.89,*Default-ja,NTP,0,0,0,,Олай айтпа...
Dialogue: 0,0:18:13.68,0:18:15.49,Dialogue,,0,0,0,,Менде бәрі жақсы!
Dialogue: 0,0:18:13.93,0:18:14.76,*Default-ja,NTP,0,0,0,,Жетеді!
Dialogue: 0,0:18:18.68,0:18:20.07,Dialogue,,0,0,0,,Өте талғампаз болма.
Dialogue: 0,0:18:19.00,0:18:22.96,*Default-ja,NTP,0,0,0,,Олай болса, тым болмаса, қызға ұқсайды...
Dialogue: 0,0:18:20.07,0:18:22.74,Dialogue,,0,0,0,,Әйелге тән болуға тырысыңыз—
Dialogue: 0,0:18:22.74,0:18:24.27,Dialogue,,0,0,0,,Мен жеткілікті болдым!
Dialogue: 0,0:18:23.01,0:18:23.92,*Default-ja,NTP,0,0,0,,Қоғамдық махаббат хатынан бері —
Dialogue: 0,0:18:31.21,0:18:36.81,Dialogue,,0,0,0,,Сонымен, менің ойымша, біздің құндылықтарымыз басқаша.
Dialogue: 0,0:18:31.53,0:18:36.03,*Default-ja,NTP,0,0,0,,Менің құндылықтарым мен оның құндылықтары арасында шынымен айырмашылық бар ма?
Dialogue: 0,0:18:36.81,0:18:39.72,Thought,,0,0,0,,Осы үзілісті аяқтап, әңгімені жалғастырайық.
Dialogue: 0,0:18:37.07,0:18:38.22,*Default-ja,NTP,0,0,0,,Тыныш тақырып
Dialogue: 0,0:18:38.50,0:18:40.07,*Default-ja,NTP,0,0,0,,Бұрынғы айтқанымды жалғастырайын ба?
Dialogue: 0,0:18:40.84,0:18:46.02,Thought,,0,0,0,,Оның оқиғасы — жоқ, біз сол кемеге мінгеннен кейін.
Dialogue: 0,0:18:41.05,0:18:42.69,*Default-ja,NTP,0,0,0,,Кемеге мінгеннен кейін ол...
Dialogue: 0,0:18:43.14,0:18:45.78,*Default-ja,NTP,0,0,0,,Жоқ, ол және мен туралы.
Dialogue: 0,0:18:46.94,0:18:53.52,Thought,,0,0,0,,Ол экипажға оны бортқа жіберуге шақыра алды, бірақ ол өзінің сыртқы түрі оны ерекше ететінін түсінді.
Dialogue: 0,0:18:47.18,0:18:49.58,*Default-ja,NTP,0,0,0,,Экипажмен сөйлесіп, тоқтап қалуға болмайды.
Dialogue: 0,0:18:50.02,0:18:53.50,*Default-ja,NTP,0,0,0,,Ол өзінің сыртқы түрі өте көзге түсетінін байқады.
Dialogue: 0,0:18:55.45,0:18:59.55,Thought,,0,0,0,,Онымен біраз уақыт танысқаннан кейін, мен бұл таңқаларлық емес екенін айта аламын.
Dialogue: 0,0:18:55.83,0:18:59.23,*Default-ja,NTP,0,0,0,,Енді мен оны білгендіктен, бұл ерекше көрініс сияқты...
Dialogue: 0,0:19:03.73,0:19:06.77,Thought,,0,0,0,,Дегенмен, мен оны алғаш көргенімде таң қалдым.
Dialogue: 0,0:19:04.11,0:19:06.21,*Default-ja,NTP,0,0,0,,Мен оны алғаш көргенде таң қалдым.
Dialogue: 0,0:19:06.77,0:19:08.69,Thought,,0,0,0,,Мен ол кезде төрт жаста едім.
Dialogue: 0,0:19:06.98,0:19:08.69,*Default-ja,NTP,0,0,0,,Менің 4 жасымда
Dialogue: 0,0:19:10.15,0:19:14.02,Thought,,0,0,0,,Мен әкеммен Жапонияға қайтып бара жатқанмын.
Dialogue: 0,0:19:10.51,0:19:13.37,*Default-ja,NTP,0,0,0,,Мен әкеммен Жапонияға қайтып бара жатқан едім.
Dialogue: 0,0:19:11.56,0:19:15.53,Secondary,,0,0,0,,Әке, әке, жүк қоймасында бір әйел бар!
Dialogue: 0,0:19:14.02,0:19:17.96,Thought,,0,0,0,,Әдемі сөзбен айтқанда, менің әкем — Шинген — қарапайым адам деп айта алмайтын адам емес еді.
Dialogue: 0,0:19:14.29,0:19:17.80,*Default-ja,NTP,0,0,0,,Менің әкем Ивао Мори – орташа деп сипаттауға болмайтын адам.
Dialogue: 0,0:19:18.46,0:19:24.49,Thought,,0,0,0,,Менің айтқанымды естігеннен кейін ата-аналардың көпшілігі оны елемейді.
Dialogue: 0,0:19:18.89,0:19:23.79,*Default-ja,NTP,0,0,0,,Менің көргенімді естісең, ата-ананың күліп жібергені дұрыс емес пе?
Dialogue: 0,0:19:25.08,0:19:27.40,Thought,,0,0,0,,Дегенмен, әкем басқаша болды.
Dialogue: 0,0:19:25.43,0:19:27.06,*Default-ja,NTP,0,0,0,,Бірақ әкем басқаша болды.
Dialogue: 0,0:19:27.40,0:19:31.03,Thought,,0,0,0,,Дәрігер болғандықтан шығар, бірақ бұл оның қызығушылығын тудырды.
Dialogue: 0,0:19:27.69,0:19:29.03,*Default-ja,NTP,0,0,0,,Дәрігер болудың табиғаты ма?
Dialogue: 0,0:19:29.17,0:19:30.55,*Default-ja,NTP,0,0,0,,Мені қатты қызықтырды.
Dialogue: 0,0:19:32.73,0:19:38.23,Dialogue,,0,0,0,,Ханым, бұл менмендік болуы мүмкін, бірақ сіздің басыңыздың жоқтығы рас па?
Dialogue: 0,0:19:33.15,0:19:35.23,*Default-ja,NTP,0,0,0,,Ханым, кешіріңіз.
Dialogue: 0,0:19:35.39,0:19:38.35,*Default-ja,NTP,0,0,0,,Басың жоқ деген рас па?
Dialogue: 0,0:19:38.64,0:19:40.76,Thought,,0,0,0,,Сондықтан әкем оған қарады:
Dialogue: 0,0:19:38.92,0:19:42.08,*Default-ja,NTP,0,0,0,,Әкем бір рет қана жарайды деді.
Dialogue: 0,0:19:40.76,0:19:45.24,Thought,,0,0,0,,«Сен маған бір рет кесуге рұқсат берсең, мен саған тұратын жер беремін».
Dialogue: 0,0:19:42.29,0:19:45.59,*Default-ja,NTP,0,0,0,,Сізді кесуге рұқсат етсеңіз, мен сізге қонақүй беремін.
Dialogue: 0,0:19:46.84,0:19:49.02,Thought,,0,0,0,,Ол тағайындады.
Dialogue: 0,0:19:47.20,0:19:48.55,*Default-ja,NTP,0,0,0,,Ол келісті.
Dialogue: 0,0:19:49.02,0:19:52.17,Thought,,0,0,0,,Бұл оған жақсы болған шығар, бірақ мен оның әлі де уайымдағанына сенімдімін.
Dialogue: 0,0:19:49.15,0:19:51.67,*Default-ja,NTP,0,0,0,,Кейбір қаржылық жоспарлау және әртүрлі алаңдаушылықтар болуы керек.
Dialogue: 0,0:19:56.01,0:20:00.00,Thought,,0,0,0,,Одан кейін не болғанын оның есінде жоқ сияқты.
Dialogue: 0,0:19:56.51,0:19:59.26,*Default-ja,NTP,0,0,0,,Бұл уақыт оның есінде жоқ сияқты.
Dialogue: 0,0:20:01.73,0:20:07.18,Thought,,0,0,0,,Адамның анестезиясы оған шынымен әсер етпеді, сондықтан мен оның соққысы өте керемет болғанына сенімдімін.
Dialogue: 0,0:20:02.07,0:20:04.25,*Default-ja,NTP,0,0,0,,Адамның анестезиясы өте тиімді емес.
Dialogue: 0,0:20:04.87,0:20:06.63,*Default-ja,NTP,0,0,0,,Соққы тым күшті болған шығар
Dialogue: 0,0:20:07.90,0:20:12.73,Dialogue,,0,0,0,,Ол ауырсынуды сезетін сияқты, бірақ адам сияқты өткір емес.
Dialogue: 0,0:20:08.36,0:20:12.33,*Default-ja,NTP,0,0,0,,Оларда ауырсыну сезімі бар сияқты, бірақ адамдарға қарағанда сезімталдығы әлдеқайда төмен сияқты.
Dialogue: 0,0:20:16.81,0:20:18.60,Dialogue,,0,0,0,,Оның жүрегі жоқ.
Dialogue: 0,0:20:17.23,0:20:18.47,*Default-ja,NTP,0,0,0,,Жүрек жоқ
Dialogue: 0,0:20:18.60,0:20:22.02,Dialogue,,0,0,0,,Оның барлық мүшелері тек формада және нақты қызмет атқармайды.
Dialogue: 0,0:20:18.82,0:20:21.90,*Default-ja,NTP,0,0,0,,Әрбір мүше жай ғана форма және ешқандай қызмет атқармайды.
Dialogue: 0,0:20:22.02,0:20:26.29,Dialogue,,0,0,0,,Оның қан тамырлары бар, бірақ олар арқылы қан жүрмейді. Оның еті - бұл шынайы нәрсе.
Dialogue: 0,0:20:22.27,0:20:24.50,*Default-ja,NTP,0,0,0,,Қан тамырлары бар, бірақ олар арқылы қан жүрмейді.
Dialogue: 0,0:20:24.56,0:20:26.00,*Default-ja,NTP,0,0,0,,Тек ет бар.
Dialogue: 0,0:20:26.29,0:20:29.05,Dialogue,,0,0,0,,Ол жай ғана модель сияқты.
Dialogue: 0,0:20:26.56,0:20:29.16,*Default-ja,NTP,0,0,0,,Тірі адам үлгісі сияқты.
Dialogue: 0,0:20:29.05,0:20:30.33,Dialogue,,0,0,0,,Бірақ, қараңыз.
Dialogue: 0,0:20:29.42,0:20:30.64,*Default-ja,NTP,0,0,0,,Дегенмен, қараңыз
Dialogue: 0,0:20:34.86,0:20:37.51,Dialogue,,0,0,0,,Ол қалай өледі?
Dialogue: 0,0:20:35.23,0:20:37.03,*Default-ja,NTP,0,0,0,,Бұл жігіт қалай өледі?
Dialogue: 0,0:20:39.39,0:20:41.13,Thought,,0,0,0,,Ол қорқынышты әке, солай ма?
Dialogue: 0,0:20:39.75,0:20:41.31,*Default-ja,NTP,0,0,0,,Ол қорқынышты әке, солай емес пе?
Dialogue: 0,0:20:41.57,0:20:45.98,Thought,,0,0,0,,Ол төрт жасар балаға біреуді ашуға рұқсат берді.
Dialogue: 0,0:20:41.78,0:20:45.18,*Default-ja,NTP,0,0,0,,Олар оны 4 жасар балаға бөледі.
Dialogue: 0,0:20:45.98,0:20:50.39,Thought,,0,0,0,,Дегенмен оның ілімінің арқасында мен хирург болуды үйрендім.
Dialogue: 0,0:20:46.17,0:20:50.47,*Default-ja,NTP,0,0,0,,Бірақ осындай білім алудың арқасында мен дәрігер болу дағдыларына ие болдым.
Dialogue: 0,0:20:50.39,0:20:53.86,Thought,,0,0,0,,Мен бұл туралы нені «бақытты» деп атауға болатынын білмеймін.
Dialogue: 0,0:20:50.78,0:20:52.76,*Default-ja,NTP,0,0,0,,Мені не бақытты ететінін білмеймін
Dialogue: 0,0:20:53.86,0:20:55.65,Dialogue,,0,0,0,,Құдайым, маған көмектес
Dialogue: 0,0:20:54.28,0:20:55.19,*Default-ja,NTP,0,0,0,,Не болды?
Dialogue: 0,0:20:57.89,0:21:02.36,Thought,,0,0,0,,Мен оны алғаш көргенде-ақ оның барлық нәрсесі мені қызықтырды.
Dialogue: 0,0:20:58.24,0:21:01.80,*Default-ja,NTP,0,0,0,,Мен оны көрген сәттен бастап қызық болдым.
Dialogue: 0,0:21:02.90,0:21:08.02,Thought,,0,0,0,,Онымен бірге өмір сүрген жиырма жыл бойы оған деген сезімім өзгерген жоқ.
Dialogue: 0,0:21:03.24,0:21:07.43,*Default-ja,NTP,0,0,0,,Бұл сезім біз бірге өмір сүрген соңғы 20 жылда мүлде өзгерген жоқ.
Dialogue: 0,0:21:08.02,0:21:13.41,Thought,,0,0,0,,Ол курьер болып жұмыс істеп жүріп, басын іздеуді жалғастырады.
Dialogue: 0,0:21:08.39,0:21:11.08,*Default-ja,NTP,0,0,0,,Ол курьер болып жұмыс істегенде,
Dialogue: 0,0:21:11.23,0:21:13.21,*Default-ja,NTP,0,0,0,,Мен өз басымды іздедім
Dialogue: 0,0:21:14.27,0:21:17.97,Thought,,0,0,0,,Маған қызық, егер ол басын тапса, не істеуді жоспарлайды?
Dialogue: 0,0:21:14.59,0:21:17.54,*Default-ja,NTP,0,0,0,,Ол басын қайтарғанда не істейді?
Dialogue: 0,0:21:17.97,0:21:20.42,Thought,,0,0,0,,Оған не болады?
Dialogue: 0,0:21:18.12,0:21:19.79,*Default-ja,NTP,0,0,0,,Оның жағдайы не болады?
Dialogue: 0,0:21:20.85,0:21:24.44,Thought,,0,0,0,,Оның еркі басымен бірдей ме?
Dialogue: 0,0:21:21.07,0:21:24.31,*Default-ja,NTP,0,0,0,,Оның еркі басшының еркі ме?
Dialogue: 0,0:21:24.44,0:21:25.96,Thought,,0,0,0,,Қолдауыңызға рахмет
Dialogue: 0,0:21:24.74,0:21:25.75,*Default-ja,NTP,0,0,0,,Ей! Польнареф!
Dialogue: 0,0:21:26.43,0:21:28.07,Dialogue,,0,0,0,,Нені түсіріп жатырсыз?
Dialogue: 0,0:21:26.68,0:21:27.96,*Default-ja,NTP,0,0,0,,Сіз нені суретке түсіріп жатырсыз?
Dialogue: 0,0:21:28.07,0:21:36.11,Dialogue,,0,0,0,,Білесіз бе, мен күнделікті өмірімнің әр қырын ұрпаққа қалдыру үшін түсіріп жатырмын.
Dialogue: 0,0:21:28.31,0:21:30.23,*Default-ja,NTP,0,0,0,,Жоқ... оны қалай айтасыз?
Dialogue: 0,0:21:30.71,0:21:32.18,*Default-ja,NTP,0,0,0,,Тәтті күнделікті өмірдің қимасы
Dialogue: 0,0:21:32.23,0:21:35.43,*Default-ja,NTP,0,0,0,,Барлық байлық туралы айтып, ұрпаққа қалдырайық.
Dialogue: 0,0:21:36.11,0:21:40.52,Dialogue,,0,0,0,,Ендеше, не істеп жатсаңыз да, оны тыныш орындаңыз. Мен ұйықтай алмаймын.
Dialogue: 0,0:21:36.39,0:21:38.72,*Default-ja,NTP,0,0,0,,Бәрі жақсы, тыныш бол.
Dialogue: 0,0:21:38.83,0:21:39.80,*Default-ja,NTP,0,0,0,,Мен ұйықтай алмаймын
Dialogue: 0,0:21:40.52,0:21:43.09,Dialogue,,0,0,0,,Кешіріңіз, Селти.
Dialogue: 0,0:21:40.83,0:21:42.37,*Default-ja,NTP,0,0,0,,Бұл жаман болды, Селти.
Dialogue: 0,0:21:44.21,0:21:47.24,Dialogue,,0,0,0,,Олай болса, осымен аяқтаймын. Кейінірек жалғастырамыз.
Dialogue: 0,0:21:44.46,0:21:45.53,*Default-ja,NTP,0,0,0,,Міне, кеттік
Dialogue: 0,0:21:45.80,0:21:47.10,*Default-ja,NTP,0,0,0,,Тағы бір күні келеді
Dialogue: 0,0:21:50.39,0:21:53.75,Dialogue,,0,0,0,,Уау, бұл тамаша!
Dialogue: 0,0:21:52.19,0:21:53.56,*Default-ja,NTP,0,0,0,,Керемет емес пе!
Dialogue: 0,0:21:53.75,0:22:00.50,Dialogue,,0,0,0,,Иә? Бұл не? Дуллашылар өздерімен бірге бастарын алып жүруі керек.
Dialogue: 0,0:21:54.88,0:21:56.60,*Default-ja,NTP,0,0,0,,Мінсіз деген не?
Dialogue: 0,0:21:56.77,0:22:00.29,*Default-ja,NTP,0,0,0,,Дуллаханның бастапқы түрі оның мойнынан ұстаған кездегі, солай емес пе?
Dialogue: 0,0:22:00.50,0:22:03.72,Dialogue,,0,0,0,,Басы болмаса жақсы ғой, солай ма?
Dialogue: 0,0:22:00.59,0:22:03.29,*Default-ja,NTP,0,0,0,,Оның қажеті жоқ па? Қандай мойын
Dialogue: 0,0:22:04.31,0:22:08.99,Dialogue,,0,0,0,,Әрине олай емес. Сіз бұлай айта аласыз, өйткені сіз ешқашан шынайы нәрсені көрмегенсіз.
Dialogue: 0,0:22:04.57,0:22:05.94,*Default-ja,NTP,0,0,0,,Ешқандай себеп жоқ
Dialogue: 0,0:22:06.08,0:22:08.82,*Default-ja,NTP,0,0,0,,Шындығын көрмегендіктен солай дейсіз.
Dialogue: 0,0:22:08.99,0:22:11.77,Dialogue,,0,0,0,,Ол керемет сұлу әйел еді.
Dialogue: 0,0:22:09.09,0:22:11.70,*Default-ja,NTP,0,0,0,,Ол әлемдегі ең сұлу әйел болды.
Dialogue: 0,0:22:11.77,0:22:13.06,Dialogue,,0,0,0,,Мен сенімдімін.
Dialogue: 0,0:22:11.96,0:22:13.13,*Default-ja,NTP,0,0,0,,Дұрыс.
Dialogue: 0,0:22:13.06,0:22:13.76,Dialogue,,0,0,0,,Тағдырымыз өріліп-жалғассын
Dialogue: 0,0:22:13.76,0:22:16.95,Dialogue,,0,0,0,,Бірақ менің ойымша, ол басы жоқ жақсы көрінеді.
Dialogue: 0,0:22:14.27,0:22:16.94,*Default-ja,NTP,0,0,0,,Бірақ менің ойымша бассыз жақсы.
Dialogue: 0,0:22:16.95,0:22:19.02,Dialogue,,0,0,0,,Ол осылайша сүйкімдірек.
Dialogue: 0,0:22:17.16,0:22:20.53,*Default-ja,NTP,0,0,0,,Бұл әлдеқайда сүйкімді. Бұл тамаша.
Dialogue: 0,0:22:19.02,0:22:20.55,Dialogue,,0,0,0,,Ол сол қалпында мінсіз.
Dialogue: 0,0:22:20.55,0:22:23.69,Dialogue,,0,0,0,,Сондықтан сізді алаңдатудың қажеті жоқ.
Dialogue: 0,0:22:20.80,0:22:23.82,*Default-ja,NTP,0,0,0,,Сондықтан да қарияға уайымдаудың қажеті жоқ.
Dialogue: 0,0:22:23.69,0:22:25.45,Dialogue,,0,0,0,,Оның басын тарта алмасаң жақсы.
Dialogue: 0,0:22:24.01,0:22:27.09,*Default-ja,NTP,0,0,0,,Сурет сала алмасаңыз, жақсы. Осылай тұра бер...
Dialogue: 0,0:22:25.45,0:22:27.50,Dialogue,,0,0,0,,Сіз ешқашан алмасаңыз да...
Dialogue: 0,0:22:30.99,0:22:33.02,Dialogue,,0,0,0,,Мен оны әлі де саламын.
Dialogue: 0,0:22:31.36,0:22:33.04,*Default-ja,NTP,0,0,0,,Бірақ мен сурет саламын
Dialogue: 0,0:22:33.02,0:22:35.54,Dialogue,,0,0,0,,Мен бәрі жақсы дедім.
Dialogue: 0,0:22:33.28,0:22:34.93,*Default-ja,NTP,0,0,0,,Бұл жақсы!
Dialogue: 0,0:22:35.54,0:22:37.48,Dialogue,,0,0,0,,Сіз біртүрлі екенсіз.
Dialogue: 0,0:22:35.65,0:22:37.77,*Default-ja,NTP,0,0,0,,Сіз біртүрлі адамсыз.
Dialogue: 0,0:22:37.48,0:22:40.71,Dialogue,,0,0,0,,Жоқ, мен соншалықты біртүрлі емеспін.
Dialogue: 0,0:22:37.79,0:22:39.75,*Default-ja,NTP,0,0,0,,Олай емес.
Dialogue: 0,0:24:14.95,0:24:19.57,staff,NTP,0,0,0,,Өндіріс: LASTZZZ Демалыс бұлт акира Акира
Dialogue: 0,0:24:15.15,0:24:19.02,Dialogue,,0,0,0,,Сіз менің еліктіргіш нәзіктігім мен жүрегімді ауыртатын өмір салты туралы білгіңіз келе ме?
Dialogue: 0,0:24:15.39,0:24:18.78,*Default-ja,NTP,0,0,0,,Менің сүйікті гетчумдағы менің жүрегімді ауыртатын күнделікті өмірім туралы білгің келе ме?
Dialogue: 0,0:24:19.02,0:24:24.03,Dialogue,,0,0,0,,Содан кейін жүрегіңіздің арнасын алып, оны маған, салқын, бірақ ұялшақ Кида Масамомиге баптаңыз.
Dialogue: 0,0:24:19.15,0:24:20.75,*Default-ja,NTP,0,0,0,,Содан кейін жүрегіңізді арнаңыз
Dialogue: 0,0:24:19.73,0:24:24.72,staff,NTP,0,0,0,,Manyu субтитрлер жұбы http://popgo.net/bbs/
Dialogue: 0,0:24:20.82,0:24:23.96,*Default-ja,NTP,0,0,0,,Осы ұялшақ және салқын Масаоми Кидаға сәйкес келіңіз!
Dialogue: 0,0:24:24.03,0:24:26.06,Dialogue,,0,0,0,,Келесі жолы: Жалған жарнама.
Dialogue: 0,0:24:26.06,0:24:29.48,Dialogue,,0,0,0,,300 жылда бір келетін мүмкіндікті жіберіп алмаңыз!
Dialogue: 0,0:24:26.46,0:24:29.09,*Default-ja,NTP,0,0,0,,Бұл мүмкіндікті 300 жылда бір рет жіберіп алмаңыз!
Dialogue: 0,0:24:30.98,0:24:36.98,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory