Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:33.38,0:01:43.38,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:10.37,0:04:15.38,Default,,0,0,0,,<Гоку супер Сайян құдайына айналды>
Dialogue: 0,0:04:15.38,0:04:19.38,Default,,0,0,0,,<Оның күшін бағындыру үшін тым үлкен→
Dialogue: 0,0:04:19.38,0:04:22.39,Default,,0,0,0,,Күрес болса да...>
Dialogue: 0,0:04:22.39,0:04:24.39,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:04:24.39,0:04:26.39,Default,,0,0,0,,Фуфуфуфуфуфу!
Dialogue: 0,0:04:26.39,0:04:28.39,Default,,0,0,0,,Тататата... дааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааааа
Dialogue: 0,0:04:28.39,0:04:30.39,Default,,0,0,0,,Қарғыс атсын.
Dialogue: 0,0:04:30.39,0:04:32.40,Default,,0,0,0,,Даа!
Dialogue: 0,0:04:32.40,0:04:35.40,Default,,0,0,0,,Мен мұны күттім.
Dialogue: 0,0:04:38.40,0:04:41.40,Default,,0,0,0,,Не? Ең алдымен, Декопин.
Dialogue: 0,0:04:41.40,0:04:44.41,Default,,0,0,0,,De! Содан кейін кесу бар.
Dialogue: 0,0:04:44.41,0:04:47.41,Default,,0,0,0,,Нга! Кешіріңіз!
Dialogue: 0,0:04:47.41,0:04:49.41,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:49.41,0:04:52.42,Default,,0,0,0,,Ауырды! Хехе….
Dialogue: 0,0:04:52.42,0:04:57.42,Default,,0,0,0,,Мен аздап күшті болдым, бірақ мен оны қайтардым.
Dialogue: 0,0:04:57.42,0:04:59.42,Default,,0,0,0,,Пин Пин.
Dialogue: 0,0:04:59.42,0:05:01.42,Default,,0,0,0,,Хе...
Dialogue: 0,0:05:01.42,0:05:06.45,Default,,0,0,0,,Егер сіз жеңілгенді жек көрсеңіз, мен де солаймын.
Dialogue: 0,0:05:06.45,0:05:12.37,Default,,0,0,0,,Осыдан бастап Құдай мен Құдай арасындағы нағыз шайқас басталады.
Dialogue: 0,0:05:12.37,0:05:14.37,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:05:14.37,0:05:18.37,Default,,0,0,0,,Тіпті менің байыптылығым әлі ондай емес.
Dialogue: 0,0:05:18.37,0:05:21.38,Default,,0,0,0,,<Гоку Берусқа кек қайтарды→
Dialogue: 0,0:05:21.38,0:05:26.38,Default,,0,0,0,,Біз шынымен жеңе аламыз ба!?>
Dialogue: 0,0:05:40.40,0:05:49.41,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:49.41,0:05:52.41,Default,,0,0,0,,Бұлма-сан, тезірек бара алмайсың ба?
Dialogue: 0,0:05:52.41,0:05:55.41,Default,,0,0,0,,Бұрын апат кезінде қозғалтқыш дірілдеген.
Dialogue: 0,0:05:55.41,0:05:58.41,Default,,0,0,0,,Тезірек түсіндіріп беріңізші.
Dialogue: 0,0:05:58.41,0:06:02.42,Default,,0,0,0,,Артық емес. Бұл би техникасы, сондықтан ұшу керек.
Dialogue: 0,0:06:02.42,0:06:05.42,Default,,0,0,0,,Мен мұны шынымен істегім келеді, бірақ...
Dialogue: 0,0:06:05.42,0:06:07.36,Default,,0,0,0,,Менің күшім жоқ.
Dialogue: 0,0:06:07.36,0:06:11.36,Default,,0,0,0,,Не, осындай маңызды уақытта?
Dialogue: 0,0:06:11.36,0:06:14.36,Default,,0,0,0,,Хахахаха.
Dialogue: 0,0:06:14.36,0:06:18.37,Default,,0,0,0,,《Супер Сайян құдайы болу рәсімінің әсері ме? 》
Dialogue: 0,0:06:18.37,0:06:23.37,Default,,0,0,0,,《Қалай болса да, бұл енді біз араласатын шайқас емес.》
Dialogue: 0,0:06:23.37,0:06:26.38,Default,,0,0,0,,《Мен оны сұрадым! Немересі》
Dialogue: 0,0:06:26.38,0:06:46.40,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:46.40,0:06:50.40,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:50.40,0:06:52.40,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:00.41,0:07:03.41,Default,,0,0,0,,Аа...
Dialogue: 0,0:07:03.41,0:07:17.36,Default,,0,0,0,,♪♪~
Dialogue: 0,0:07:17.36,0:07:19.36,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:19.36,0:07:22.36,Default,,0,0,0,,Кез келген уақыт жақсы. Супер Сайян Құдай.
Dialogue: 0,0:07:22.36,0:07:25.36,Default,,0,0,0,,Олай болса, неге бармайсың?
Dialogue: 0,0:07:29.37,0:07:31.37,Default,,0,0,0,,О, аа...
Dialogue: 0,0:07:31.37,0:07:33.38,Default,,0,0,0,,Ni. Хаа!
Dialogue: 0,0:07:33.38,0:07:35.38,Default,,0,0,0,,Тынш!
Dialogue: 0,0:07:40.38,0:07:43.38,Default,,0,0,0,,Уа, уа, уа....
Dialogue: 0,0:07:47.39,0:07:49.39,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:52.39,0:07:56.40,Default,,0,0,0,,Хахаха маған мүлдем әсер еткен жоқ.
Dialogue: 0,0:07:56.40,0:08:01.40,Default,,0,0,0,,О, құдайым. Мен сені көбірек арандатпасам жақсы ма?
Dialogue: 0,0:08:03.41,0:08:05.41,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:08:07.34,0:08:09.34,Default,,0,0,0,,Уау.
Dialogue: 0,0:08:13.35,0:08:17.35,Default,,0,0,0,,Күтілгендей, Беерус-саманың шабуылы тиімді.
Dialogue: 0,0:08:25.36,0:08:29.37,Default,,0,0,0,,Келесі жолы мен саған үлкенін сыйлыққа беремін.
Dialogue: 0,0:08:29.37,0:08:32.37,Default,,0,0,0,,Бұл бұрынғыдан әлдеқайда үлкен, солай емес пе?
Dialogue: 0,0:08:32.37,0:08:35.37,Default,,0,0,0,,Бұл арнайы қызмет.
Dialogue: 0,0:08:35.37,0:08:37.37,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:37.37,0:08:39.38,Default,,0,0,0,,Уф….
Dialogue: 0,0:08:39.38,0:08:41.38,Default,,0,0,0,,Ах!
Dialogue: 0,0:08:41.38,0:08:45.38,Default,,0,0,0,,Не істеу керек? Ucchi үшін бұл сәл ауыр, солай емес пе?
Dialogue: 0,0:08:45.38,0:08:50.39,Default,,0,0,0,,Гү… Ха-ха
Dialogue: 0,0:08:50.39,0:08:54.39,Default,,0,0,0,,Уау!
Dialogue: 0,0:08:56.39,0:08:58.39,Default,,0,0,0,,Угугу….
Dialogue: 0,0:08:58.39,0:09:01.40,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:01.40,0:09:03.40,Default,,0,0,0,,О.
Dialogue: 0,0:09:05.40,0:09:10.40,Default,,0,0,0,,Угігіги... Куу!
Dialogue: 0,0:09:13.34,0:09:15.34,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:09:15.34,0:09:20.35,Default,,0,0,0,,Джигиджи… Куу….
Dialogue: 0,0:09:20.35,0:09:24.35,Default,,0,0,0,,Вуги.
Dialogue: 0,0:09:24.35,0:09:27.36,Default,,0,0,0,,Угиги!
Dialogue: 0,0:09:27.36,0:09:31.36,Default,,0,0,0,,Джигиджи... Ах...
Dialogue: 0,0:09:31.36,0:09:33.36,Default,,0,0,0,,Куу!
Dialogue: 0,0:09:33.36,0:09:35.36,Default,,0,0,0,,күрсіну.
Dialogue: 0,0:09:35.36,0:09:38.37,Default,,0,0,0,,Угиджи….
Dialogue: 0,0:09:38.37,0:09:40.37,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:48.38,0:09:52.38,Default,,0,0,0,,Балалар, сіз оны арнайы кимен таба алмайсыз ба?
Dialogue: 0,0:09:52.38,0:09:55.38,Default,,0,0,0,,Мен Құдайдың рухын сезіне алмаймын.
Dialogue: 0,0:09:55.38,0:09:57.39,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:09:57.39,0:09:59.39,Default,,0,0,0,,Ах. Бауырым, мен бір нәрсе көріп тұрмын.
Dialogue: 0,0:09:59.39,0:10:02.39,Default,,0,0,0,,А... бұл.
Dialogue: 0,0:10:02.39,0:10:04.39,Default,,0,0,0,,Уау, бұл әдемі.
Dialogue: 0,0:10:04.39,0:10:08.39,Default,,0,0,0,,Осыны айтып тұрсыз ба? Мен бұл жерде екеніне сенімдімін.
Dialogue: 0,0:10:10.33,0:10:13.34,Default,,0,0,0,,Уг-г-г
Dialogue: 0,0:10:13.34,0:10:15.34,Default,,0,0,0,,Джигиджи….
Dialogue: 0,0:10:20.34,0:10:23.35,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:23.35,0:10:25.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:25.35,0:10:27.35,Default,,0,0,0,,Аһ!
Dialogue: 0,0:10:29.35,0:10:31.35,Default,,0,0,0,,болды. Бұл менің әкем.
Dialogue: 0,0:10:31.35,0:10:33.35,Default,,0,0,0,,Не? Қай жерде?
Dialogue: 0,0:10:35.36,0:10:37.36,Default,,0,0,0,,Иә!
Dialogue: 0,0:10:37.36,0:10:39.36,Default,,0,0,0,,Сонымен... бұл таңқаларлық.
Dialogue: 0,0:10:39.36,0:10:41.36,Default,,0,0,0,,Сәлем! Ол аурады.
Dialogue: 0,0:10:41.36,0:10:44.37,Default,,0,0,0,,Хахаха. Әкем күткендей.
Dialogue: 0,0:10:44.37,0:10:47.37,Default,,0,0,0,,Уау! Джиджи Джиги.
Dialogue: 0,0:10:47.37,0:10:51.37,Default,,0,0,0,,Мен сене алар емеспін. Ол Жоюшы Құдаймен тең.
Dialogue: 0,0:10:51.37,0:10:53.38,Default,,0,0,0,,Міне кеттік. О.
Dialogue: 0,0:10:53.38,0:10:56.38,Default,,0,0,0,,Біркелкі сәйкестік? Жоқ, жоқ.
Dialogue: 0,0:10:56.38,0:10:59.38,Default,,0,0,0,,Біз одан асып түскен шығармыз.
Dialogue: 0,0:10:59.38,0:11:02.38,Default,,0,0,0,,Ха ха ха ха ха….
Dialogue: 0,0:11:02.38,0:11:06.41,Default,,0,0,0,,Күрсін... Күрсін.
Dialogue: 0,0:11:06.41,0:11:08.32,Default,,0,0,0,,Бұл көп емес, Берус-сама.
Dialogue: 0,0:11:08.32,0:11:10.33,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:10.33,0:11:12.33,Default,,0,0,0,,Сіз өзіңіздің күшіңізді әлі толық пайдаланған жоқсыз, солай ма?
Dialogue: 0,0:11:14.33,0:11:17.33,Default,,0,0,0,,Сіз білдіңіз бе? Ха.
Dialogue: 0,0:11:17.33,0:11:19.33,Default,,0,0,0,,Жоқ, кешіріңіз, кешіріңіз.
Dialogue: 0,0:11:19.33,0:11:22.34,Default,,0,0,0,,Сендей типке, алғыр болғаны дұрыс→
Dialogue: 0,0:11:22.34,0:11:25.34,Default,,0,0,0,,Мен өседі деп ойладым.
Dialogue: 0,0:11:27.34,0:11:29.34,Default,,0,0,0,,Ата-бабалар. Beerus-sama →
Dialogue: 0,0:11:29.34,0:11:31.35,Default,,0,0,0,,Бұрыштарды кесу үшін жолдан шығыңыз →
Dialogue: 0,0:11:31.35,0:11:35.35,Default,,0,0,0,,Бұл сізді Гоку ұрып-соққан кейіп танытқаныңызды білдіре ме?
Dialogue: 0,0:11:35.35,0:11:39.35,Default,,0,0,0,,Солай көрінеді.
Dialogue: 0,0:11:39.35,0:11:42.36,Default,,0,0,0,,Неге олай істейсің? (Ескі Кай) Гоку →
Dialogue: 0,0:11:42.36,0:11:46.36,Default,,0,0,0,,Өзіңізді керемет Super Saiyan Құдайына көтеріңіз→
Dialogue: 0,0:11:46.36,0:11:48.36,Default,,0,0,0,,Содан кейін оны қатты ұсақтаңыз.
Dialogue: 0,0:11:48.36,0:11:52.37,Default,,0,0,0,,Жоқ! Сонымен... бұл не үшін?
Dialogue: 0,0:11:52.37,0:11:54.37,Default,,0,0,0,,(Хироко) Дегенмен, мен өзімді сәл жалғыз сезінемін.
Dialogue: 0,0:11:54.37,0:11:57.37,Default,,0,0,0,,Көңіл көтеру үшін бе? (Кибито Құдай) Иә?
Dialogue: 0,0:11:57.37,0:12:03.38,Default,,0,0,0,,Менің ойымша, Беерус-сама қорқынышты адам.
Dialogue: 0,0:12:03.38,0:12:07.32,Default,,0,0,0,,Хехе. Бірақ түсіндім деп ойлаймын.
Dialogue: 0,0:12:07.32,0:12:09.32,Default,,0,0,0,,Берус, өтінемін, күшейген кезде→
Dialogue: 0,0:12:09.32,0:12:13.32,Default,,0,0,0,,Барыңды бере алатын адамды табу оңай.
Dialogue: 0,0:12:13.32,0:12:15.32,Default,,0,0,0,,Бұл...
Dialogue: 0,0:12:15.32,0:12:19.33,Default,,0,0,0,,Га. Әңгіменің бәрі осы. →
Dialogue: 0,0:12:19.33,0:12:22.33,Default,,0,0,0,,Сіз түсінбейсіз.
Dialogue: 0,0:12:22.33,0:12:24.33,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:26.34,0:12:29.34,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:31.34,0:12:34.34,Default,,0,0,0,,Қарғыс атсын... Уау!
Dialogue: 0,0:12:34.34,0:12:36.35,Default,,0,0,0,,Уг-г-г
Dialogue: 0,0:12:36.35,0:12:38.35,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:40.35,0:12:42.35,Default,,0,0,0,,Уау.
Dialogue: 0,0:12:42.35,0:12:44.35,Default,,0,0,0,,Уф...
Dialogue: 0,0:12:44.35,0:12:46.36,Default,,0,0,0,,Угугу….
Dialogue: 0,0:12:46.36,0:12:49.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:49.36,0:12:53.36,Default,,0,0,0,,Қалайсың, Супер Сайян Құдай?
Dialogue: 0,0:12:53.36,0:12:57.36,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:59.37,0:13:03.37,Default,,0,0,0,,Уф… уф… уф….
Dialogue: 0,0:13:03.37,0:13:07.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:07.31,0:13:11.31,Default,,0,0,0,,Ештеңеге қолымнан келмей тастап кетем бе?
Dialogue: 0,0:13:11.31,0:13:16.31,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:19.32,0:13:21.32,Default,,0,0,0,,Сенде ондай мақсат болса да…
Dialogue: 0,0:15:08.80,0:15:11.80,Default,,0,0,0,,Бұлма-сан, тезірек барайық. Мен білемін. →
Dialogue: 0,0:15:11.80,0:15:14.80,Default,,0,0,0,,Қозғалтқыштың жағдайы... қазірдің өзінде!
Dialogue: 0,0:15:16.81,0:15:19.81,Default,,0,0,0,,《Жоятын Құдайдың құдіреті үшін→
Dialogue: 0,0:15:19.81,0:15:23.81,Default,,0,0,0,,Тіпті супер Сайян құдайының құдіретімен→
Dialogue: 0,0:15:23.81,0:15:26.82,Default,,0,0,0,,Сіз оны жеңе алмайтыныңызға сенімдісіз бе?
Dialogue: 0,0:15:26.82,0:15:40.83,Default,,0,0,0,,♪♪~
Dialogue: 0,0:15:40.83,0:15:43.83,Default,,0,0,0,,♪♪ “Хмф, сағ” →
Dialogue: 0,0:15:43.83,0:15:46.84,Default,,0,0,0,,♪♪ «Ғұн ғұн» →
Dialogue: 0,0:15:46.84,0:15:50.84,Default,,0,0,0,,♪♪ “Hmph hun hun” →
Dialogue: 0,0:15:50.84,0:15:56.85,Default,,0,0,0,,♪♪ «Ғұн хун хун»
Dialogue: 0,0:15:56.85,0:15:58.85,Default,,0,0,0,,Хе...
Dialogue: 0,0:15:58.85,0:16:01.87,Default,,0,0,0,,А... Аа...
Dialogue: 0,0:16:01.87,0:16:04.79,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:16:04.79,0:16:06.79,Default,,0,0,0,,Аа….
Dialogue: 0,0:16:06.79,0:16:09.79,Default,,0,0,0,,Аа... Ах...
Dialogue: 0,0:16:09.79,0:16:13.80,Default,,0,0,0,,А... Аа...
Dialogue: 0,0:16:13.80,0:16:17.80,Default,,0,0,0,,Ол жарылған сәтте аман қалғаныңыз жақсы болды.
Dialogue: 0,0:16:17.80,0:16:20.80,Default,,0,0,0,,Супер Сайян Құдайы.
Dialogue: 0,0:16:20.80,0:16:23.81,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:16:23.81,0:16:26.81,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:16:26.81,0:16:28.81,Default,,0,0,0,,Иә. Гах.
Dialogue: 0,0:16:31.81,0:16:33.82,Default,,0,0,0,,Уф!
Dialogue: 0,0:16:33.82,0:16:37.82,Default,,0,0,0,,Менің ұйқым келіп тұр.
Dialogue: 0,0:16:37.82,0:16:39.82,Default,,0,0,0,,Қарғыс атсын. сәуле!
Dialogue: 0,0:16:39.82,0:16:42.82,Default,,0,0,0,,Ой... ақымақ. Менің ұйқым келді→
Dialogue: 0,0:16:42.82,0:16:46.83,Default,,0,0,0,,Ұйқысы бар, ұйқасы, ұйқысы қашады→
Dialogue: 0,0:16:46.83,0:16:49.83,Default,,0,0,0,,Ұйқысы бар, ұйқасы, ұйқысы қашады →
Dialogue: 0,0:16:49.83,0:16:53.84,Default,,0,0,0,,Ұйқым келді, ұйқым қашады, шыдай алмаймын!
Dialogue: 0,0:16:53.84,0:16:55.84,Default,,0,0,0,,Сәлеметсіз бе!
Dialogue: 0,0:16:55.84,0:16:57.84,Default,,0,0,0,,Ах! Апыр-ай!
Dialogue: 0,0:16:57.84,0:17:00.84,Default,,0,0,0,,Әй!
Dialogue: 0,0:17:00.84,0:17:03.78,Default,,0,0,0,,Аа... Ах...
Dialogue: 0,0:17:03.78,0:17:05.78,Default,,0,0,0,,Аа... Ах...
Dialogue: 0,0:17:05.78,0:17:07.78,Default,,0,0,0,,Қарғыс атсын. Уф….
Dialogue: 0,0:17:07.78,0:17:10.78,Default,,0,0,0,,Бұл жақсы болды.
Dialogue: 0,0:17:12.79,0:17:15.79,Default,,0,0,0,,Бірақ шабуылдың бұл деңгейі→
Dialogue: 0,0:17:15.79,0:17:19.80,Default,,0,0,0,,Мынадай→
Dialogue: 0,0:17:19.80,0:17:22.80,Default,,0,0,0,,Маған мүлдем мағынасы жоқ!
Dialogue: 0,0:17:22.80,0:17:24.80,Default,,0,0,0,,Уау….
Dialogue: 0,0:17:24.80,0:17:27.80,Default,,0,0,0,,Бұл арал. Асығыңыз. Мен білемін. →
Dialogue: 0,0:17:27.80,0:17:29.81,Default,,0,0,0,,Маған бұйрық берме.
Dialogue: 0,0:17:29.81,0:17:31.81,Default,,0,0,0,,Ах. не? Бұл.
Dialogue: 0,0:17:38.81,0:17:41.81,Default,,0,0,0,,Немересі? Ал... Әке!
Dialogue: 0,0:17:43.82,0:17:47.82,Default,,0,0,0,,Уау!
Dialogue: 0,0:17:47.82,0:17:49.82,Default,,0,0,0,,Уау….
Dialogue: 0,0:17:54.83,0:17:58.83,Default,,0,0,0,,Ол көтеріле береді. Аа….
Dialogue: 0,0:17:58.83,0:18:00.84,Default,,0,0,0,,(Хироко) Дегенмен, мен өзімді сәл жалғыз сезінемін.
Dialogue: 0,0:18:00.84,0:18:03.77,Default,,0,0,0,,Жоғарыда. Мен білемін!
Dialogue: 0,0:18:03.77,0:18:19.79,Default,,0,0,0,,♪♪~
Dialogue: 0,0:18:19.79,0:18:22.79,Default,,0,0,0,,күрсіну.
Dialogue: 0,0:18:26.80,0:18:31.80,Default,,0,0,0,,Әй, сен қашанғы демаласың? →
Dialogue: 0,0:18:31.80,0:18:35.80,Default,,0,0,0,,Жақында қайта бастаймыз.
Dialogue: 0,0:18:35.80,0:18:38.81,Default,,0,0,0,,О, құдайым. Жоюға мағына беру →
Dialogue: 0,0:18:38.81,0:18:42.81,Default,,0,0,0,,Маған ұнамайды.
Dialogue: 0,0:18:47.82,0:18:49.82,Default,,0,0,0,,Қарғыс атсын.
Dialogue: 0,0:18:49.82,0:18:53.82,Default,,0,0,0,,Хехехехехе. →
Dialogue: 0,0:18:53.82,0:18:56.83,Default,,0,0,0,,Фуфуфуфуфуфуфуфу. →
Dialogue: 0,0:18:56.83,0:18:58.83,Default,,0,0,0,,Хехехехехе.
Dialogue: 0,0:18:58.83,0:19:01.83,Default,,0,0,0,,Иә! Уау... уф! Аа….
Dialogue: 0,0:19:03.77,0:19:06.77,Default,,0,0,0,,Фуфуфуфуфуфуфуфуфу.
Dialogue: 0,0:19:06.77,0:19:09.77,Default,,0,0,0,,Куу… Куу….
Dialogue: 0,0:19:09.77,0:19:13.78,Default,,0,0,0,,Менің сізге бар жақсылықты беруге мәжбүрлеуден басқа амалым жоқ.
Dialogue: 0,0:19:13.78,0:19:15.78,Default,,0,0,0,,Жарайды... мүмкін емес.
Dialogue: 0,0:19:18.78,0:19:21.78,Default,,0,0,0,,Уф... уф.
Dialogue: 0,0:19:21.78,0:19:24.79,Default,,0,0,0,,Иә. Хмм.
Dialogue: 0,0:19:24.79,0:19:26.79,Default,,0,0,0,,(Дарио) Бала ма!? Қоя бер!
Dialogue: 0,0:19:26.79,0:19:29.79,Default,,0,0,0,,Бұл сен кінәлі.
Dialogue: 0,0:19:29.79,0:19:32.79,Default,,0,0,0,,Адам өмірі дегеніміз не деп ойлайсың?
Dialogue: 0,0:19:32.79,0:19:35.80,Default,,0,0,0,,Бұл Құдай мен Құдай арасындағы шайқас.
Dialogue: 0,0:19:35.80,0:19:39.80,Default,,0,0,0,,Қайсысы маңыздырақ, адам өмірі?
Dialogue: 0,0:19:41.80,0:19:43.81,Default,,0,0,0,,Бұл ақымақ сұрақ.
Dialogue: 0,0:19:43.81,0:19:45.81,Default,,0,0,0,,Аа….
Dialogue: 0,0:19:45.81,0:19:50.81,Default,,0,0,0,,Бұл жігітке тойтарыс беруге, жаншуға болмайды.
Dialogue: 0,0:19:53.82,0:19:55.82,Default,,0,0,0,,Әй!
Dialogue: 0,0:20:03.76,0:20:06.76,Default,,0,0,0,,Бұл оңай емес пе?
Dialogue: 0,0:20:06.76,0:20:08.76,Default,,0,0,0,,Оны жойыңыз!
Dialogue: 0,0:20:08.76,0:20:11.76,Default,,0,0,0,,Бұл өте жақсы идея.
Dialogue: 0,0:20:15.77,0:20:18.77,Default,,0,0,0,,Ах! мыс?
Dialogue: 0,0:20:18.77,0:20:20.78,Default,,0,0,0,,Мотивацияңыз бар ма?
Dialogue: 0,0:20:20.78,0:20:23.78,Default,,0,0,0,,Аа….
Dialogue: 0,0:20:23.78,0:20:29.78,Default,,0,0,0,,Мен сізге Super Saiyan Құдайдың құдіретін көрсетемін!
Dialogue: 0,0:20:29.78,0:20:32.79,Default,,0,0,0,,Хмм.
Dialogue: 0,0:20:32.79,0:20:36.79,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:36.79,0:20:39.79,Default,,0,0,0,,《Аа... жақсы》
Dialogue: 0,0:20:39.79,0:20:44.80,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:44.80,0:20:49.80,Default,,0,0,0,,《Иә, мынау, мынау, мына сезім》
Dialogue: 0,0:20:49.80,0:20:54.81,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:54.81,0:20:56.81,Default,,0,0,0,,Кеттік. →
Dialogue: 0,0:20:56.81,0:20:59.81,Default,,0,0,0,,Тынш!
Dialogue: 0,0:20:59.81,0:21:04.75,Default,,0,0,0,,Ка→
Dialogue: 0,0:21:04.75,0:21:08.76,Default,,0,0,0,,Мен→
Dialogue: 0,0:21:08.76,0:21:12.76,Default,,0,0,0,,Ха→
Dialogue: 0,0:21:12.76,0:21:16.77,Default,,0,0,0,,Мен→
Dialogue: 0,0:21:16.77,0:21:19.77,Default,,0,0,0,,Толқын!
Dialogue: 0,0:21:19.77,0:21:21.77,Default,,0,0,0,,Толқын!
Dialogue: 0,0:21:21.77,0:21:25.77,Default,,0,0,0,,Толқын!
Dialogue: 0,0:21:28.78,0:21:32.78,Default,,0,0,0,,Ах. Ах!
Dialogue: 0,0:21:41.79,0:21:44.79,Default,,0,0,0,,Күрсіну… Ах….
Dialogue: 0,0:21:44.79,0:21:47.80,Default,,0,0,0,,Күрсіну… Ах….
Dialogue: 0,0:21:47.80,0:21:50.80,Default,,0,0,0,,Хахаха….
Dialogue: 0,0:21:50.80,0:21:53.80,Default,,0,0,0,,Аа... Ах...
Dialogue: 0,0:21:53.80,0:21:57.81,Default,,0,0,0,,Ах! Бұл жаман болды.
Dialogue: 0,0:21:57.81,0:22:00.81,Default,,0,0,0,,Ах! Ка… Ка….
Dialogue: 0,0:22:00.81,0:22:05.81,Default,,0,0,0,,Ааа... аа... а.
Dialogue: 0,0:22:09.75,0:22:12.75,Default,,0,0,0,,Бұл дұрыс емес адам. →
Dialogue: 0,0:22:12.75,0:22:17.75,Default,,0,0,0,,Мен іздеген сен емес сияқтысың.
Dialogue: 0,0:22:41.78,0:22:44.78,Default,,0,0,0,,Уау! Аа…. (Кибито Құдай) Ах!
Dialogue: 0,0:22:50.79,0:22:52.79,Default,,0,0,0,,Ах! Ах!
Dialogue: 0,0:22:52.79,0:22:54.79,Default,,0,0,0,,Немерем!
Dialogue: 0,0:23:09.74,0:23:29.76,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:29.76,0:23:32.77,Default,,0,0,0,,♪♪~
Dialogue: 0,0:23:32.77,0:23:37.77,Default,,0,0,0,,《Сен мықтысың, Беерус-сама》
Dialogue: 0,0:23:37.77,0:23:42.78,Default,,0,0,0,,《Не? О, мен білмедім》
Dialogue: 0,0:23:42.78,0:23:44.78,Default,,0,0,0,,《Осындай көп→
Dialogue: 0,0:23:44.78,0:23:48.78,Default,,0,0,0,,Мен мұндай күшті адамдардың бар екеніне сене алар емеспін.
Dialogue: 0,0:23:48.78,0:23:52.79,Default,,0,0,0,,《Күшті, күшті...》
Dialogue: 0,0:23:52.79,0:23:57.79,Default,,0,0,0,,《Тым күшті, тым күшті...》
Dialogue: 0,0:24:00.80,0:24:03.80,Default,,0,0,0,,《Әйтеуір, о...》
Dialogue: 0,0:24:05.73,0:24:10.74,Default,,0,0,0,,《Бірдеңе, бірдеңе→
Dialogue: 0,0:24:10.74,0:24:14.74,Default,,0,0,0,,Әйтеуір, Ола→
Dialogue: 0,0:24:14.74,0:24:16.74,Default,,0,0,0,,Бірдеңе →
Dialogue: 0,0:24:16.74,0:24:21.74,Default,,0,0,0,,Уау, мен қатты толқып тұрмын! 》
Dialogue: 0,0:24:27.76,0:24:29.76,Default,,0,0,0,,Не? (Готен) А.
Dialogue: 0,0:24:29.76,0:24:31.76,Default,,0,0,0,,Не? Қазір.
Dialogue: 0,0:24:31.76,0:24:42.77,Default,,0,0,0,,♪♪~
Dialogue: 0,0:24:42.77,0:24:45.77,Default,,0,0,0,,Хмм.
Dialogue: 0,0:24:45.77,0:24:47.78,Default,,0,0,0,,Ni.
Dialogue: 0,0:24:47.78,0:24:50.78,Default,,0,0,0,,Жалғастырайық, Беерус-сама.
Dialogue: 0,0:24:50.78,0:24:54.78,Default,,0,0,0,,Супер Сайян Құдайдың күші әлі Ола →
Dialogue: 0,0:24:54.78,0:24:58.79,Default,,0,0,0,,Сен мені жоғарыға апаратын сияқтысың.
Dialogue: 0,0:24:58.79,0:25:00.79,Default,,0,0,0,,Жақсы жүз.
Dialogue: 0,0:25:00.79,0:25:05.79,Default,,0,0,0,,Осы уақытқа дейін жеткен күшіңіздің құрметіне→
Dialogue: 0,0:25:05.79,0:25:08.80,Default,,0,0,0,,Сізге көрсетейін →
Dialogue: 0,0:25:08.80,0:25:11.80,Default,,0,0,0,,Менің күшім.
Dialogue: 0,0:25:11.80,0:25:24.81,Default,,0,0,0,,♪♪~
Dialogue: 0,0:25:24.81,0:25:28.82,Default,,0,0,0,,<Супер Сайян Құдайдың құдіреті қандай?→
Dialogue: 0,0:25:28.82,0:25:33.82,Default,,0,0,0,,Шектеу әлі жеткен жоқ＞
Dialogue: 0,0:25:33.82,0:25:38.83,Default,,0,0,0,,<Шексіз күшейетін Гоку келеді →
Dialogue: 0,0:25:38.83,0:25:43.83,Default,,0,0,0,,Бұл шайқастың нәтижесі қандай болады? ＞
Dialogue: 0,0:25:46.83,0:25:56.83,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:48.83,0:26:50.83,Default,,0,0,0,,Сәлем, Гоку.
Dialogue: 0,0:26:50.83,0:26:52.83,Default,,0,0,0,,Супер Сайян Құдайдың шынайы күші.
Dialogue: 0,0:26:52.83,0:26:55.84,Default,,0,0,0,,Нағыз шайқас осы жерден басталады!
Dialogue: 0,0:26:55.84,0:26:58.84,Default,,0,0,0,,Не? Кай патшаның дауысы керемет.
Dialogue: 0,0:26:58.84,0:27:01.86,Default,,0,0,0,,Иә? Енді ұрысты тоқтатқанымызды қалайсың ба?
Dialogue: 0,0:27:01.86,0:27:05.78,Default,,0,0,0,,Ақымақ болма. Жақында мен оны қолға алатын сияқтымын!
Dialogue: 0,0:27:05.78,0:27:07.78,Default,,0,0,0,,Келесі жолы «Dragon Ball Super»
Dialogue: 0,0:27:12.79,0:27:14.79,Default,,0,0,0,,Сіз оны міндетті түрде тексеруіңіз керек.
Dialogue: 0,0:27:16.29,0:27:22.29,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory