Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:33.15,0:01:43.15,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:09.14,0:04:15.15,Default,,0,0,0,,<Алдын ала түсінде көрген ең күшті жау, Супер Сайян Құдаймен күресу→
Dialogue: 0,0:04:15.15,0:04:21.15,Default,,0,0,0,,Жою құдайы Бер 39 жылдан кейін оянады>
Dialogue: 0,0:04:21.15,0:04:24.16,Default,,0,0,0,,<Екінші жағынан, бейбіт жерде→
Dialogue: 0,0:04:24.16,0:04:29.16,Default,,0,0,0,,Бұлманың туған күні өтетін болды>
Dialogue: 0,0:04:29.16,0:04:32.16,Default,,0,0,0,,＜Ол кезде Гоку→
Dialogue: 0,0:04:32.16,0:04:35.17,Default,,0,0,0,,Тек күшке ұмтылу→
Dialogue: 0,0:04:35.17,0:04:39.17,Default,,0,0,0,,Солтүстік патшасы Кай қол астында жаттығады>
Dialogue: 0,0:04:55.19,0:04:59.19,Default,,0,0,0,,Хм, бұл не болды?
Dialogue: 0,0:04:59.19,0:05:03.20,Default,,0,0,0,,Бұл Super Seiyan Құдайы болуы мүмкін →
Dialogue: 0,0:05:03.20,0:05:07.13,Default,,0,0,0,,Мен оны супер Соян құдайы болғандай сезінемін.
Dialogue: 0,0:05:07.13,0:05:11.14,Default,,0,0,0,,Қалай болғанда да, бұл әсірелеу есім.
Dialogue: 0,0:05:11.14,0:05:14.14,Default,,0,0,0,,Бұл, оны табу үшін күшіңізді пайдаланыңыз.
Dialogue: 0,0:05:14.14,0:05:18.14,Default,,0,0,0,,Үміткерлер соншалықты көп болса, іздеу мүмкін болмас еді.
Dialogue: 0,0:05:18.14,0:05:22.15,Default,,0,0,0,,Оны тағы да қысқартыңыз. Сараң.
Dialogue: 0,0:05:22.15,0:05:24.15,Default,,0,0,0,,А, мен → деп ойладым
Dialogue: 0,0:05:24.15,0:05:26.15,Default,,0,0,0,,Мен тәтті нәрсе жегім келеді.
Dialogue: 0,0:05:26.15,0:05:29.16,Default,,0,0,0,,Қайтып келгенде тәтті жеп алайық.
Dialogue: 0,0:05:29.16,0:05:33.16,Default,,0,0,0,,Менің ойымша, тоңазытқышта шектеулі таралымдағы тәттілер болды.
Dialogue: 0,0:05:33.16,0:05:35.16,Default,,0,0,0,,Тәттілер саны шектеулі! →
Dialogue: 0,0:05:35.16,0:05:39.17,Default,,0,0,0,,Бұл дұрыс емес пе? Whis. Егер жоқ болса...
Dialogue: 0,0:05:39.17,0:05:43.17,Default,,0,0,0,,Уайымдама, Беерус-сама.
Dialogue: 0,0:05:43.17,0:05:46.17,Default,,0,0,0,,Мен біраз уақыт → деп ойладым
Dialogue: 0,0:05:46.17,0:05:48.17,Default,,0,0,0,,Сіз сәл жылдамырақ ұша алмайсыз ба?
Dialogue: 0,0:05:48.17,0:05:51.18,Default,,0,0,0,,Уф….
Dialogue: 0,0:05:51.18,0:05:53.18,Default,,0,0,0,,Не? Тіпті бұл →
Dialogue: 0,0:05:53.18,0:05:56.18,Default,,0,0,0,,Бұл ғаламдағы ең жылдам ұшатын нысан.
Dialogue: 0,0:05:56.18,0:05:59.19,Default,,0,0,0,,Дұрыс. Мен мұны білмедім.
Dialogue: 0,0:05:59.19,0:06:01.19,Default,,0,0,0,,Хун.
Dialogue: 0,0:06:06.21,0:06:09.13,Default,,0,0,0,,Уф! Ой... ой...
Dialogue: 0,0:06:09.13,0:06:12.13,Default,,0,0,0,,Ата-бабалар?
Dialogue: 0,0:06:12.13,0:06:18.14,Default,,0,0,0,,Беерус-сама тағы бір планетаны жойған сияқты.
Dialogue: 0,0:06:18.14,0:06:21.14,Default,,0,0,0,,《Қорыққаныңды көремін→
Dialogue: 0,0:06:21.14,0:06:23.14,Default,,0,0,0,,Бұл менің бірінші рет.》
Dialogue: 0,0:06:23.14,0:06:25.14,Default,,0,0,0,,《Сыра-сама сонша...》
Dialogue: 0,0:06:27.15,0:06:29.15,Default,,0,0,0,,Бұл дүниеде біз сияқты→
Dialogue: 0,0:06:29.15,0:06:33.15,Default,,0,0,0,,Жұлдыздар мен тіршілікті жарататын құдай бар. →
Dialogue: 0,0:06:33.15,0:06:38.16,Default,,0,0,0,,Керісінше, жұлдыздар мен өмірді бұзатын құдайлар бар. →
Dialogue: 0,0:06:38.16,0:06:41.16,Default,,0,0,0,,Бұл Берус, жойылу Құдайы.
Dialogue: 0,0:06:41.16,0:06:43.16,Default,,0,0,0,,Иә. Мен бұл туралы хабардармын.
Dialogue: 0,0:06:43.16,0:06:47.17,Default,,0,0,0,,Басқаша айтқанда, тіпті жойылудың да мәні бар.
Dialogue: 0,0:06:47.17,0:06:49.17,Default,,0,0,0,,Жоқ (Кибито Құдай) Иә?
Dialogue: 0,0:06:49.17,0:06:53.17,Default,,0,0,0,,Мұның мағынасы жоқ. (Кибитогами) Ах... ах...
Dialogue: 0,0:06:53.17,0:06:56.18,Default,,0,0,0,,Беерус-саманың жойылуы жай ғана құмарлық еді. →
Dialogue: 0,0:06:56.18,0:06:59.18,Default,,0,0,0,,Бізде бір ғана нәрсе бар →
Dialogue: 0,0:06:59.18,0:07:02.18,Default,,0,0,0,,Беерус-саманы тітіркендірмеңіз →
Dialogue: 0,0:07:02.18,0:07:05.18,Default,,0,0,0,,Тек орындаңыз. (Кибито Құдай) Иә.
Dialogue: 0,0:07:05.18,0:07:09.12,Default,,0,0,0,,Беерус-саманы жекпе-жекке шақыруды ойлайтын адам→
Dialogue: 0,0:07:09.12,0:07:12.12,Default,,0,0,0,,Мен бұлай болмайды деп үміттенемін.
Dialogue: 0,0:07:12.12,0:07:15.13,Default,,0,0,0,,Естеріңізде ме?
Dialogue: 0,0:07:15.13,0:07:18.13,Default,,0,0,0,,Ах. Ұлы Гоку.
Dialogue: 0,0:07:18.13,0:07:20.13,Default,,0,0,0,,Бұл дұрыс! Тек сол шайқас ақымақ →
Dialogue: 0,0:07:20.13,0:07:24.14,Default,,0,0,0,,Мен Беерус-саманың бар екені белгілі болғанын қаламаймын.
Dialogue: 0,0:07:24.14,0:07:28.14,Default,,0,0,0,,Беерус-саманың энергиясын тек Құдай ғана сезіне алады.
Dialogue: 0,0:07:28.14,0:07:32.14,Default,,0,0,0,,Сонымен қатар, Сон Гоку Жерде өте алыс.
Dialogue: 0,0:07:32.14,0:07:34.15,Default,,0,0,0,,Беерус-самамен кездесу, т.б.→
Dialogue: 0,0:07:34.15,0:07:37.15,Default,,0,0,0,,Мен олай ойламаймын. (Кәрі Кай) жақсы болар еді.
Dialogue: 0,0:07:37.15,0:07:39.15,Default,,0,0,0,,≪(Kaiou) Қазіргі уақытта қабылдануда →
Dialogue: 0,0:07:39.15,0:07:41.15,Default,,0,0,0,,Кешіріңіз. (Кибито Құдай/Кәрі Кай) Иә?
Dialogue: 0,0:07:41.15,0:07:44.16,Default,,0,0,0,,Солтүстік патшасы Кай. →
Dialogue: 0,0:07:44.16,0:07:47.16,Default,,0,0,0,,Сыбыс тараған Сон Гокуға келсек...
Dialogue: 0,0:07:47.16,0:07:49.16,Default,,0,0,0,,Уау! Хмм. Уууу уууу.
Dialogue: 0,0:07:49.16,0:07:52.16,Default,,0,0,0,,Ол менің орнымда жаттығады.
Dialogue: 0,0:07:52.16,0:07:55.17,Default,,0,0,0,,Хехехе.
Dialogue: 0,0:07:55.17,0:07:57.17,Default,,0,0,0,,Сон Гоку бар ма?
Dialogue: 0,0:07:57.17,0:08:01.17,Default,,0,0,0,,Кай патша да байқады ма? Берус-саманың оянуы.
Dialogue: 0,0:08:01.17,0:08:03.18,Default,,0,0,0,,≪(Kaiou) Иә.
Dialogue: 0,0:08:03.18,0:08:07.11,Default,,0,0,0,,Бұл жолы мен ойлағаннан ерте ояндым.
Dialogue: 0,0:08:07.11,0:08:09.11,Default,,0,0,0,,Мұны міндетті түрде құпия сақтау керек.
Dialogue: 0,0:08:09.11,0:08:13.12,Default,,0,0,0,,Әрине. Мен мұны Сон Гокудан міндетті түрде құпия ұстаймын.
Dialogue: 0,0:08:13.12,0:08:16.12,Default,,0,0,0,,Иә? Олаға не болды?
Dialogue: 0,0:08:16.12,0:08:19.12,Default,,0,0,0,,Эх! иә?
Dialogue: 0,0:08:19.12,0:08:23.13,Default,,0,0,0,,Хахахахахаха. Сен не істеп жатырсың? Кай патша.
Dialogue: 0,0:08:23.13,0:08:26.13,Default,,0,0,0,,Сіз мені қорқытқаныңыз үшін шығар.
Dialogue: 0,0:08:26.13,0:08:30.14,Default,,0,0,0,,Амансың ба? Ол осылай бояумен жабылған.
Dialogue: 0,0:08:30.14,0:08:33.14,Default,,0,0,0,,Ой, кешіріңіз. Кешіріңіз, кешіріңіз.
Dialogue: 0,0:08:33.14,0:08:37.14,Default,,0,0,0,,Сасық. Бұл шүберек емес пе?
Dialogue: 0,0:08:37.14,0:08:39.14,Default,,0,0,0,,Не? (Кай) Сен солсың.
Dialogue: 0,0:08:39.14,0:08:41.15,Default,,0,0,0,,Ах, жаман, жаман.
Dialogue: 0,0:08:41.15,0:08:46.15,Default,,0,0,0,,Аа, дәл солай, Кай патша. Жаңа ғана Оланың атын айтпадың ба?
Dialogue: 0,0:08:46.15,0:08:48.15,Default,,0,0,0,,Ах!? Мен айтпаймын. →
Dialogue: 0,0:08:48.15,0:08:51.16,Default,,0,0,0,,Сіз тым өзін-өзі ұстайсыз, солай емес пе? →
Dialogue: 0,0:08:51.16,0:08:55.16,Default,,0,0,0,,Сосососо... Одан да сен→
Dialogue: 0,0:08:55.16,0:08:59.16,Default,,0,0,0,,Сіз маған жасаған сұмдық қарым-қатынасыңызды ұмытқан жоқсыз, солай ма?
Dialogue: 0,0:08:59.16,0:09:02.17,Default,,0,0,0,,Не? Мынаны қараңыз.
Dialogue: 0,0:09:02.17,0:09:05.17,Default,,0,0,0,,Иә? Біздің құрбандығымыздың арқасында →
Dialogue: 0,0:09:05.17,0:09:09.11,Default,,0,0,0,,Жер бүгінгідей.
Dialogue: 0,0:09:09.11,0:09:12.11,Default,,0,0,0,,Жер? Ах!
Dialogue: 0,0:09:12.11,0:09:16.12,Default,,0,0,0,,《Аа, ақымақ! Ондай адамды әкелме! 》
Dialogue: 0,0:09:16.12,0:09:21.12,Default,,0,0,0,,《Жаман. Кай патша, бұл жалғыз орын болды.
Dialogue: 0,0:09:21.12,0:09:23.12,Default,,0,0,0,,《Ах! 》
Dialogue: 0,0:09:25.12,0:09:29.13,Default,,0,0,0,,А, мен камераның жарылысына түсіп қалдым.
Dialogue: 0,0:09:29.13,0:09:32.13,Default,,0,0,0,,Сіз мені қатыстырдыңыз.
Dialogue: 0,0:09:32.13,0:09:35.13,Default,,0,0,0,,Сіз еш өкінбейсіз.
Dialogue: 0,0:09:35.13,0:09:37.14,Default,,0,0,0,,Сіз көп рет кешірім сұрадыңыз!
Dialogue: 0,0:09:37.14,0:09:41.14,Default,,0,0,0,,Егер мен кешірім сұрасам, Құдайға мұқтаж болмас едім. →
Dialogue: 0,0:09:41.14,0:09:46.15,Default,,0,0,0,,Мен Шенрон шыққан сайын үлкен үміт күтетінмін→
Dialogue: 0,0:09:46.15,0:09:51.15,Default,,0,0,0,,Қашанға дейін бізді өмірге қайтаруға тырысасың?
Dialogue: 0,0:09:51.15,0:09:56.16,Default,,0,0,0,,Нашар Нашар. Мен мүлдем ұмыттым. (Кай) Ұмытпа!
Dialogue: 0,0:09:56.16,0:09:58.16,Default,,0,0,0,,Кай патша құдай, солай ма?
Dialogue: 0,0:09:58.16,0:10:02.16,Default,,0,0,0,,Мен тірі болсам да, өлсем де көп нәрсе өзгермейді деп ойлаймын.
Dialogue: 0,0:10:02.16,0:10:06.18,Default,,0,0,0,,Ақымақ! Бұл үлкен айырмашылық.
Dialogue: 0,0:10:06.18,0:10:08.10,Default,,0,0,0,,Басқа Кайдан→
Dialogue: 0,0:10:08.10,0:10:12.10,Default,,0,0,0,,Сізді қаншалықты мазақ етеді деп ойлайсыз?
Dialogue: 0,0:10:12.10,0:10:16.11,Default,,0,0,0,,Келесі жолы сіз бізді міндетті түрде өмірге қайтарасыз...
Dialogue: 0,0:10:16.11,0:10:18.11,Default,,0,0,0,,Не? Хмм.
Dialogue: 0,0:10:18.11,0:10:22.11,Default,,0,0,0,,Адамдардың айтқанын соңына дейін тыңдайсыз ба?
Dialogue: 0,0:10:22.11,0:10:25.12,Default,,0,0,0,,Мүлде жоқ.
Dialogue: 0,0:10:25.12,0:10:30.12,Default,,0,0,0,,《Мен әзірге Беерус-саманы жасыра алдым деп ойлаймын.》
Dialogue: 0,0:10:30.12,0:10:34.13,Default,,0,0,0,,Уау! Бұл шүберек!
Dialogue: 0,0:10:34.13,0:10:42.13,Default,,0,0,0,,♪♪~
Dialogue: 0,0:10:42.13,0:10:45.14,Default,,0,0,0,,Беерус-сама, біз келдік.
Dialogue: 0,0:10:45.14,0:10:48.14,Default,,0,0,0,,Соңында.
Dialogue: 0,0:10:48.14,0:10:50.14,Default,,0,0,0,,Есіңде ме? →
Dialogue: 0,0:10:50.14,0:10:52.14,Default,,0,0,0,,Бұл өте жақсы.
Dialogue: 0,0:10:52.14,0:10:55.15,Default,,0,0,0,,Мм. Хмм.
Dialogue: 0,0:10:55.15,0:10:58.15,Default,,0,0,0,,Иә. Професи Балық мырзадан сұрап көрейік.
Dialogue: 0,0:10:58.15,0:11:02.15,Default,,0,0,0,,Ақырында, сіз Мистер Професи Балыққа сенесіз бе?
Dialogue: 0,0:11:02.15,0:11:06.13,Default,,0,0,0,,Нашар ма? Жоқ, мұны істеуге қымсынбаңыз.
Dialogue: 0,0:11:06.13,0:11:11.13,Default,,0,0,0,,Мистер Пайғамбарлық Балық. Пайғамбарлық балық бар ма?
Dialogue: 0,0:11:14.00,0:11:16.00,Default,,0,0,0,,Хмм.
Dialogue: 0,0:11:19.00,0:11:21.00,Default,,0,0,0,,Ах! кінә.
Dialogue: 0,0:11:26.01,0:11:28.01,Default,,0,0,0,,Бір нәрсе үшін бе?
Dialogue: 0,0:11:31.02,0:11:33.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:36.02,0:11:42.03,Default,,0,0,0,,Мистер Професи Балық, сіз осылай дедіңіз, солай ма? Менің айбынды жауым 39 жылдан кейін пайда болады.
Dialogue: 0,0:11:42.03,0:11:46.03,Default,,0,0,0,,Мен бүгін бір жерге келемін. екінші ойлар туралы.
Dialogue: 0,0:11:46.03,0:11:51.04,Default,,0,0,0,,Ендеше, сол күшті жаудың аты кім?
Dialogue: 0,0:11:51.04,0:11:54.04,Default,,0,0,0,,Аты. Хмм.
Dialogue: 0,0:11:54.04,0:11:58.04,Default,,0,0,0,,Хмм….
Dialogue: 0,0:11:58.04,0:12:01.05,Default,,0,0,0,,Мен ұмытып қалдым. Ұмытып қалдыңыз ба?
Dialogue: 0,0:12:01.05,0:12:03.05,Default,,0,0,0,,Сәттілік, Пайғамбарлық балық.
Dialogue: 0,0:12:03.05,0:12:05.05,Default,,0,0,0,,Эй, Whis. иә?
Dialogue: 0,0:12:05.05,0:12:08.09,Default,,0,0,0,,Мистер Профейси Балық күніне үш рет тамақтандырылды.
Dialogue: 0,0:12:08.09,0:12:10.09,Default,,0,0,0,,Иә. бұл дұрыс.
Dialogue: 0,0:12:10.09,0:12:13.09,Default,,0,0,0,,Күніне екі рет азайту керек пе?
Dialogue: 0,0:12:13.09,0:12:15.09,Default,,0,0,0,,Джо! Бұл тамаша идея.
Dialogue: 0,0:12:15.09,0:12:19.10,Default,,0,0,0,,Ах! Ендеше... маған бір үзіліс беріңізші!
Dialogue: 0,0:12:19.10,0:12:21.10,Default,,0,0,0,,Соны есте сақтаңыз.
Dialogue: 0,0:12:21.10,0:12:23.10,Default,,0,0,0,,Түсіндім. есте сақтаңыз.
Dialogue: 0,0:12:23.10,0:12:26.10,Default,,0,0,0,,Мм, м...
Dialogue: 0,0:12:26.10,0:12:28.11,Default,,0,0,0,,Хмм….
Dialogue: 0,0:12:28.11,0:12:31.11,Default,,0,0,0,,Ах. Супер Сайян Құдай!
Dialogue: 0,0:12:31.11,0:12:34.11,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:12:34.11,0:12:40.12,Default,,0,0,0,,Супер Сайян Құдайы. Құдай деп аталатындықтан, бұл құдай деп ойлаймын.
Dialogue: 0,0:12:40.12,0:12:42.12,Default,,0,0,0,,О, құдайым. Бұл қиын.
Dialogue: 0,0:12:42.12,0:12:44.12,Default,,0,0,0,,Дегенмен, Беерус-сама→
Dialogue: 0,0:12:44.12,0:12:49.13,Default,,0,0,0,,Супер Сайян Құдайы жоқ.
Dialogue: 0,0:12:49.13,0:12:52.13,Default,,0,0,0,,Егер сіз Сайян болсаңыз, сіз бірдеңе білуіңіз мүмкін.
Dialogue: 0,0:12:52.13,0:12:56.13,Default,,0,0,0,,Иә? Сайяндар мекендеген Вегета планетасы →
Dialogue: 0,0:12:56.13,0:12:58.14,Default,,0,0,0,,Фриза оны жойды ма?
Dialogue: 0,0:12:58.14,0:13:02.14,Default,,0,0,0,,Мен ұйықтап жатқанда мынаны істе дедім→
Dialogue: 0,0:13:02.14,0:13:04.14,Default,,0,0,0,,Бұл Беерус-сама емес пе?
Dialogue: 0,0:13:04.14,0:13:06.13,Default,,0,0,0,,Өйткені ол жігіттер тітіркендіргіш.
Dialogue: 0,0:13:06.13,0:13:10.08,Default,,0,0,0,,Әсіресе сол Вегета патшасы.
Dialogue: 0,0:13:10.08,0:13:13.09,Default,,0,0,0,,Ал, заттарды ретке келтіру, яғни →
Dialogue: 0,0:13:13.09,0:13:18.09,Default,,0,0,0,,Сонымен Сайяндар Вегета планетасымен бірге жойылды ма?
Dialogue: 0,0:13:18.09,0:13:20.09,Default,,0,0,0,,Жоқ Олардың көпшілігі қаза тапты →
Dialogue: 0,0:13:20.09,0:13:24.10,Default,,0,0,0,,Басқа планетаға кеткендер аман қалады.
Dialogue: 0,0:13:24.10,0:13:28.10,Default,,0,0,0,,Айтпақшы, ханзада Вегета әлі тірі және жақсы.
Dialogue: 0,0:13:28.10,0:13:30.10,Default,,0,0,0,,Ол бақытты жігіт.
Dialogue: 0,0:13:30.10,0:13:33.11,Default,,0,0,0,,Whis. Ванна ыстық па?
Dialogue: 0,0:13:33.11,0:13:36.11,Default,,0,0,0,,Сіз осы сағатта шомылып жатырсыз ба?
Dialogue: 0,0:13:36.11,0:13:41.11,Default,,0,0,0,,Бұл жолы мен 39 жыл ғана ұйықтадым.
Dialogue: 0,0:13:41.11,0:13:43.11,Default,,0,0,0,,Мен мұны істегім келеді.
Dialogue: 0,0:13:45.12,0:13:49.12,Default,,0,0,0,,Су қаншалықты ыстық? Бұл ең жақсы.
Dialogue: 0,0:13:49.12,0:13:52.12,Default,,0,0,0,,Сізге көп рахмет.
Dialogue: 0,0:13:52.12,0:13:56.13,Default,,0,0,0,,Хмм…. Сонымен аман қалған сайандар →
Dialogue: 0,0:13:56.13,0:13:59.13,Default,,0,0,0,,Қайдасың? Ха.
Dialogue: 0,0:13:59.13,0:14:01.13,Default,,0,0,0,,Хмм. →
Dialogue: 0,0:14:01.13,0:14:09.14,Default,,0,0,0,,Тірі қалған Сайяндар негізінен 4032 жасыл 877 планета→
Dialogue: 0,0:14:09.14,0:14:11.14,Default,,0,0,0,,Бұл Жер планетасында болғандай.
Dialogue: 0,0:14:11.14,0:14:16.15,Default,,0,0,0,,Жер. Мен сонда бір рет болғаныма сенімдімін.
Dialogue: 0,0:14:16.15,0:14:19.15,Default,,0,0,0,,Өйткені динозавр дөрекі әрекет етті →
Dialogue: 0,0:14:19.15,0:14:22.15,Default,,0,0,0,,Бұл біз жойған планета.
Dialogue: 0,0:14:22.15,0:14:26.16,Default,,0,0,0,,Алайда, Сайяндардың бірі Фризаны жеңген Сон Гоку...
Dialogue: 0,0:14:26.16,0:14:29.16,Default,,0,0,0,,Иә! Ах!?
Dialogue: 0,0:14:29.16,0:14:31.16,Default,,0,0,0,,Фризаны жеңді!?
Dialogue: 0,0:14:31.16,0:14:34.17,Default,,0,0,0,,Жақсы! Берус-сама.
Dialogue: 0,0:14:34.17,0:14:37.17,Default,,0,0,0,,Иә? Ах!
Dialogue: 0,0:14:37.17,0:14:41.17,Default,,0,0,0,,Сонымен Фризаны Сайян жеңді ме?
Dialogue: 0,0:14:41.17,0:14:46.18,Default,,0,0,0,,Иә. Оны Сон Гоку деген сайян жеңді.
Dialogue: 0,0:14:46.18,0:14:51.18,Default,,0,0,0,,Сайян қазір солтүстікте Кай патшаның планетасында жүрген сияқты.
Dialogue: 0,0:14:51.18,0:14:54.19,Default,,0,0,0,,Бұл күдікті. Кай патшаның жұлдызы?
Dialogue: 0,0:14:54.19,0:14:56.19,Default,,0,0,0,,Иә.
Dialogue: 0,0:14:59.19,0:15:03.20,Default,,0,0,0,,Бұл Сон Гоку немесе басқасы.
Dialogue: 0,0:15:03.20,0:15:06.13,Default,,0,0,0,,Иә. бұл дұрыс.
Dialogue: 0,0:15:06.13,0:15:09.13,Default,,0,0,0,,Сайянның шашы осындай түсті ме?
Dialogue: 0,0:15:09.13,0:15:12.14,Default,,0,0,0,,Сайяндар мутацияға ұшырайды→
Dialogue: 0,0:15:12.14,0:15:16.14,Default,,0,0,0,,Жауынгерлік күшіңді еселейтін әдісті меңгерген сияқтысың. →
Dialogue: 0,0:15:16.14,0:15:20.15,Default,,0,0,0,,Есімі Супер Сайян екеніне сенімдімін.
Dialogue: 0,0:15:20.15,0:15:23.15,Default,,0,0,0,,Құдай емес пе? өкінішке орай.
Dialogue: 0,0:15:25.15,0:15:29.15,Default,,0,0,0,,Супер Сайян? →
Dialogue: 0,0:15:29.15,0:15:33.16,Default,,0,0,0,,Қандай ұят. Бірақ әлсіз. →
Dialogue: 0,0:15:33.16,0:15:37.16,Default,,0,0,0,,Whis. Солтүстіктегі Кай патша жұлдызына жету қанша уақытты алады?
Dialogue: 0,0:15:37.16,0:15:42.17,Default,,0,0,0,,Шамамен 26 минут 44 секунд.
Dialogue: 0,0:15:42.17,0:15:44.17,Default,,0,0,0,,Соншама алыс па!?→
Dialogue: 0,0:15:44.17,0:15:47.17,Default,,0,0,0,,Теледидар анимесінің бір бөлімін көруге болады, солай ма? →
Dialogue: 0,0:15:47.17,0:15:50.18,Default,,0,0,0,,Хмм, бұл қиын. →
Dialogue: 0,0:15:50.18,0:15:52.18,Default,,0,0,0,,Жарайды, оған көмектесу мүмкін емес.
Dialogue: 0,0:15:52.18,0:15:55.18,Default,,0,0,0,,Whis. Олардан бенто дайындауды сұраңыз.
Dialogue: 0,0:15:55.18,0:15:57.18,Default,,0,0,0,,Бақытымызға орай, осы жаманның атыс құралдары баяу
Dialogue: 0,0:15:57.18,0:16:04.18,Default,,0,0,0,,♪♪~
Dialogue: 0,0:17:50.60,0:17:52.60,Default,,0,0,0,,
Dialogue: 0,0:17:52.60,0:17:55.60,Default,,0,0,0,,Қат! Мен кептелісте тұрып қалдым.
Dialogue: 0,0:17:55.60,0:17:59.60,Default,,0,0,0,,№18 өзінің макияжына көп уақыт жұмсайды.
Dialogue: 0,0:17:59.60,0:18:01.61,Default,,0,0,0,,Тезірек шығуы керек еді.
Dialogue: 0,0:18:01.61,0:18:03.61,Default,,0,0,0,,Бұл сәнді круиздік кемедегі кеш→
Dialogue: 0,0:18:03.61,0:18:05.61,Default,,0,0,0,,Өрт шығуы табиғи нәрсе.
Dialogue: 0,0:18:05.61,0:18:08.61,Default,,0,0,0,,Шынымен. Әлемдегі ең бай адам Булма →
Dialogue: 0,0:18:08.61,0:18:11.62,Default,,0,0,0,,Бұл туған күн кеші. (Марлон) Ахаха.
Dialogue: 0,0:18:11.62,0:18:15.62,Default,,0,0,0,,Кешігіп қалсаңыз, бинго турнирін жіберіп алмайсыз, солай ма?
Dialogue: 0,0:18:15.62,0:18:19.62,Default,,0,0,0,,Бұл керемет сыйлық болатыны сөзсіз! Аа…. →
Dialogue: 0,0:18:19.62,0:18:23.63,Default,,0,0,0,,Хмм... Бұлай жалғаса берсе, кешігіп қаламын.
Dialogue: 0,0:18:23.63,0:18:25.63,Default,,0,0,0,,Хмм….
Dialogue: 0,0:18:25.63,0:18:28.63,Default,,0,0,0,,Жарайды, жасайық!
Dialogue: 0,0:18:31.64,0:18:34.64,Default,,0,0,0,,Көлікті капсулаға қайтарыңыз. →
Dialogue: 0,0:18:34.64,0:18:36.64,Default,,0,0,0,,Хехе. (Марлон) Уау!
Dialogue: 0,0:18:36.64,0:18:39.64,Default,,0,0,0,,Ах…. (Еркек) Шынымен!?
Dialogue: 0,0:18:41.66,0:18:43.58,Default,,0,0,0,,Аа….
Dialogue: 0,0:18:43.58,0:19:02.60,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:02.60,0:19:05.60,Default,,0,0,0,,Бинго жүлделеріне дайынсыз ба?
Dialogue: 0,0:19:05.60,0:19:08.61,Default,,0,0,0,,Иә. Әсіресе арнайы сыйлықтар→
Dialogue: 0,0:19:08.61,0:19:11.61,Default,,0,0,0,,Бұл маңызды, сондықтан абай болыңыз.
Dialogue: 0,0:19:11.61,0:19:13.61,Default,,0,0,0,,Абыройлы музыка мектептерінде бәрі бәсекелестік рейтингтерге және→
Dialogue: 0,0:19:15.61,0:19:20.62,Default,,0,0,0,,Өйткені, ұшатын болсаң, әуелі көлікпен келмеуің керек еді.
Dialogue: 0,0:19:20.62,0:19:24.62,Default,,0,0,0,,Ах. Ей, алдап жүрген біз ғана емес сияқтымыз.
Dialogue: 0,0:19:24.62,0:19:26.63,Default,,0,0,0,,Иә? Эй! →
Dialogue: 0,0:19:26.63,0:19:30.63,Default,,0,0,0,,Ямча мырза! Пуар! Иә?
Dialogue: 0,0:19:30.63,0:19:33.63,Default,,0,0,0,,Бұл криллин! Біраз уақыт өтті.
Dialogue: 0,0:19:33.63,0:19:35.63,Default,,0,0,0,,≪(Тяньшинхан) криллин. (No18, криллин) Ах.
Dialogue: 0,0:19:35.63,0:19:40.64,Default,,0,0,0,,Теншин күрішімен гиоза. Барлығы жақсы ма?
Dialogue: 0,0:19:40.64,0:19:43.58,Default,,0,0,0,,Иә, жақсы. (Марлон) Кяхахахаха!
Dialogue: 0,0:19:43.58,0:19:45.58,Default,,0,0,0,,Хехе.
Dialogue: 0,0:19:52.58,0:19:55.59,Default,,0,0,0,,≪(Гохан) Булма-сан! Ах.
Dialogue: 0,0:19:55.59,0:19:58.59,Default,,0,0,0,,Хаха. Сандықтар! О!
Dialogue: 0,0:19:58.59,0:20:00.59,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,0:20:00.59,0:20:02.59,Default,,0,0,0,,Сәлем Готен. Мынаны қара!
Dialogue: 0,0:20:02.59,0:20:04.60,Default,,0,0,0,,Бұл кеме үлкен, сондықтан оны зерттеп көрейік.
Dialogue: 0,0:20:04.60,0:20:06.60,Default,,0,0,0,,Иә! Кеттік, кеттік.
Dialogue: 0,0:20:06.60,0:20:10.60,Default,,0,0,0,,Туған күнің құтты болсын, Бұлма-сан.
Dialogue: 0,0:20:10.60,0:20:12.60,Default,,0,0,0,,Құттықтаймын, Бұлма-сан.
Dialogue: 0,0:20:12.60,0:20:16.61,Default,,0,0,0,,Құттықтаймыз! Барлығыңызға рахмет.
Dialogue: 0,0:20:16.61,0:20:18.61,Default,,0,0,0,,Біз біріншіміз бе?
Dialogue: 0,0:20:18.61,0:20:21.61,Default,,0,0,0,,Қазірдің өзінде екі оғаш адам бар.
Dialogue: 0,0:20:21.61,0:20:24.62,Default,,0,0,0,,Улонг. Менің тиыным таусылмаймын.
Dialogue: 0,0:20:24.62,0:20:26.62,Default,,0,0,0,,Уохёхёхё.
Dialogue: 0,0:20:26.62,0:20:29.62,Default,,0,0,0,,Қарт, оны алмастыратын кез келді.
Dialogue: 0,0:20:29.62,0:20:32.62,Default,,0,0,0,,Қазір ең жақсы бөлік. →
Dialogue: 0,0:20:32.62,0:20:34.63,Default,,0,0,0,,Ухё. →
Dialogue: 0,0:20:34.63,0:20:37.63,Default,,0,0,0,,Уохёхёхё.
Dialogue: 0,0:20:37.63,0:20:39.63,Default,,0,0,0,,Ой, мұрыннан қан кетті. (Улонг) Қария!
Dialogue: 0,0:20:39.63,0:20:43.57,Default,,0,0,0,,Аузыңды жап! Кішкене ғана. →
Dialogue: 0,0:20:43.57,0:20:46.57,Default,,0,0,0,,Ой! бұл! →
Dialogue: 0,0:20:46.57,0:20:49.57,Default,,0,0,0,,Иә? Сәлем Улонг. Менде тиын таусылды.
Dialogue: 0,0:20:49.57,0:20:51.58,Default,,0,0,0,,Мастер Роши!
Dialogue: 0,0:20:51.58,0:20:54.58,Default,,0,0,0,,Балалардың білім алуына жарамсыз! Оны тоқтатасың ба!?
Dialogue: 0,0:20:54.58,0:20:57.58,Default,,0,0,0,,Бұл жай ғана құстарды бақылау.
Dialogue: 0,0:20:57.58,0:20:59.58,Default,,0,0,0,,Қарт адамның мұрнынан қан кетті.
Dialogue: 0,0:20:59.58,0:21:09.59,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:09.59,0:21:12.60,Default,,0,0,0,,Қалада өмір сүру дегеніміз – көптеген адамдармен кездесу деген сөз
Dialogue: 0,0:21:12.60,0:21:14.60,Default,,0,0,0,,Эй, сен! Сен не істеп жатырсың?
Dialogue: 0,0:21:14.60,0:21:16.60,Default,,0,0,0,,Буу!
Dialogue: 0,0:21:16.60,0:21:19.60,Default,,0,0,0,,Кеш әлі басталған жоқ.
Dialogue: 0,0:21:19.60,0:21:22.61,Default,,0,0,0,,Тамақ ішер алдында барлығы келгенше күтіңіз.
Dialogue: 0,0:21:22.61,0:21:24.61,Default,,0,0,0,,Менің қарным ашты, тамақ ішемін!
Dialogue: 0,0:21:24.61,0:21:26.61,Default,,0,0,0,,Ал, жақсы, жақсы.
Dialogue: 0,0:21:26.61,0:21:30.62,Default,,0,0,0,,Бұлма-сан, кешіріңіз. Мен сізге ескертемін.
Dialogue: 0,0:21:30.62,0:21:32.62,Default,,0,0,0,,Буу мырза, сол жаққа барайық.
Dialogue: 0,0:21:32.62,0:21:34.62,Default,,0,0,0,,Қараңдар, қараңдар, мен оны Буу-санға арнайы жасадым→
Dialogue: 0,0:21:34.62,0:21:38.62,Default,,0,0,0,,Бізде дәмді тағамдар бар. Бұл рас па? Шайтан.
Dialogue: 0,0:21:38.62,0:21:41.64,Default,,0,0,0,,Бізде көп нәрсе бар.
Dialogue: 0,0:21:41.64,0:21:44.56,Default,,0,0,0,,Шынымен де ме?
Dialogue: 0,0:21:44.56,0:21:47.57,Default,,0,0,0,,Бұл біздің тойымыздан түскен сурет.
Dialogue: 0,0:21:47.57,0:21:50.57,Default,,0,0,0,,Мен оны әлі Пикколоға берген жоқпын.
Dialogue: 0,0:21:50.57,0:21:53.57,Default,,0,0,0,,Мазалағаным үшін кешіріңіз.
Dialogue: 0,0:21:53.57,0:21:55.57,Default,,0,0,0,,→
Dialogue: 0,0:21:55.57,0:21:57.58,Default,,0,0,0,,… …
Dialogue: 0,0:21:57.58,0:22:01.58,Default,,0,0,0,,Пикколо-сан, ол жай ғана жыпылықтап тұрған сияқты.
Dialogue: 0,0:22:01.58,0:22:03.58,Default,,0,0,0,,Ғимараттан шықпаңдар!!
Dialogue: 0,0:22:03.58,0:22:07.58,Default,,0,0,0,,Ха ха ха ха ха….
Dialogue: 0,0:22:09.59,0:22:11.59,Default,,0,0,0,,Иә! Ха! Ха!
Dialogue: 0,0:22:11.59,0:22:14.59,Default,,0,0,0,,《Бірінші нөмір – мен! 》
Dialogue: 0,0:22:14.59,0:22:16.59,Default,,0,0,0,,Вегета жаттығуға келмейді!?→
Dialogue: 0,0:22:16.59,0:22:20.60,Default,,0,0,0,,Тіпті немерең де! Кешіріңіз.
Dialogue: 0,0:22:20.60,0:22:22.60,Default,,0,0,0,,...
Dialogue: 0,0:22:22.60,0:22:24.60,Default,,0,0,0,,(салмақ түскен дыбыс)
Dialogue: 0,0:22:24.60,0:22:29.61,Default,,0,0,0,,...
Dialogue: 0,0:22:29.61,0:22:32.61,Default,,0,0,0,,… …
Dialogue: 0,0:22:32.61,0:22:36.61,Default,,0,0,0,,Барма! Бүгін Булманың туған күні болды!
Dialogue: 0,0:22:36.61,0:22:41.59,Default,,0,0,0,,...
Dialogue: 0,0:22:41.59,0:22:46.46,Default,,0,0,0,,Ол ашулы болуы керек. Мен ашуланғанда қорықпаймын.
Dialogue: 0,0:22:46.46,0:22:52.46,Default,,0,0,0,,《Жақсы. Бұл Беерус-сама туралы емес еді.
Dialogue: 0,0:22:52.46,0:22:57.47,Default,,0,0,0,,《Берус-саманың мұндай жерге келуі мүмкін емес》
Dialogue: 0,0:22:57.47,0:23:01.47,Default,,0,0,0,,Сайяндардың шайқаста ақымақ болғанына таң қаламын.
Dialogue: 0,0:23:01.47,0:23:04.47,Default,,0,0,0,,...
Dialogue: 0,0:23:10.48,0:23:14.48,Default,,0,0,0,,(Пойыз ысқырығы)
Dialogue: 0,0:23:18.49,0:23:22.49,Default,,0,0,0,,Беерус-сама, түскі қорапшаң дайын.
Dialogue: 0,0:23:22.49,0:23:24.49,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:23:26.50,0:23:28.50,Default,,0,0,0,,Гарнир дегеніміз не?
Dialogue: 0,0:23:28.50,0:23:31.50,Default,,0,0,0,,Негізгі ингредиент - Вотлин планетасынан Якиджаке→
Dialogue: 0,0:23:31.50,0:23:35.51,Default,,0,0,0,,Тұмандық 65 Мамандығы тауық Нанбан.
Dialogue: 0,0:23:35.51,0:23:37.51,Default,,0,0,0,,Бұл қандай болды? →
Dialogue: 0,0:23:37.51,0:23:39.51,Default,,0,0,0,,Жоқ. →
Dialogue: 0,0:23:39.51,0:23:42.55,Default,,0,0,0,,Әдемі көрінісі бар жер болса, мен жолда тамақ ішуім мүмкін.
Dialogue: 0,0:23:42.55,0:23:45.55,Default,,0,0,0,,Түсінікті. Мен оны есте сақтаймын.
Dialogue: 0,0:23:47.55,0:23:50.55,Default,,0,0,0,,бастайық. аа.
Dialogue: 0,0:23:57.56,0:24:00.57,Default,,0,0,0,,Беерус-саманың оянғанына жарты күн ғана өтті →
Dialogue: 0,0:24:00.57,0:24:04.57,Default,,0,0,0,,Сегіз жарым жұлдыз жоғалды.
Dialogue: 0,0:24:04.57,0:24:06.57,Default,,0,0,0,,Шынымен де аз уақыт ішінде→
Dialogue: 0,0:24:06.57,0:24:08.57,Default,,0,0,0,,Мұны Беерус-сама жасады ма?
Dialogue: 0,0:24:08.57,0:24:12.58,Default,,0,0,0,,Беерус-саманың кереметі де осы. →
Dialogue: 0,0:24:12.58,0:24:15.58,Default,,0,0,0,,Мені Z қылышта мөр басқан →
Dialogue: 0,0:24:15.58,0:24:19.58,Default,,0,0,0,,Нені жасыруым керек? Бұл Беерус-сама. (Кибито Құдай) Иә!?
Dialogue: 0,0:24:19.58,0:24:22.59,Default,,0,0,0,,Ол уақыт та көзді ашып-жұмғанша өте шықты.
Dialogue: 0,0:24:22.59,0:24:26.59,Default,,0,0,0,,А... Мен Беерус-саманы төмен бағалаған сияқтымын.
Dialogue: 0,0:24:26.59,0:24:30.60,Default,,0,0,0,,Мм. Сіз оны сезінесіз бе? Берус-самаға қамқор болыңыз.
Dialogue: 0,0:24:30.60,0:24:33.60,Default,,0,0,0,,Уф... иә. →
Dialogue: 0,0:24:33.60,0:24:35.60,Default,,0,0,0,,Ол үлкен жылдамдықпен қозғалады.
Dialogue: 0,0:24:35.60,0:24:38.60,Default,,0,0,0,,Ммм….
Dialogue: 0,0:24:44.54,0:24:47.55,Default,,0,0,0,,Не!? Ой… ой…. (Кибито Құдай) Ах!
Dialogue: 0,0:24:47.55,0:24:52.55,Default,,0,0,0,,Неліктен? Беерус-сама қайда бара жатыр?
Dialogue: 0,0:24:52.55,0:24:56.55,Default,,0,0,0,,Солтүстіктегі Кай патшаның жұлдызы! (Кибито Құдай) Мен де сезініп тұрмын.
Dialogue: 0,0:24:56.55,0:25:00.56,Default,,0,0,0,,Бірақ Беерус-сама неге Сон Гоку-санға барды?
Dialogue: 0,0:25:00.56,0:25:04.56,Default,,0,0,0,,Сондай-ақ... мен ең қорқатын нәрсе...
Dialogue: 0,0:25:04.56,0:25:09.57,Default,,0,0,0,,Бейбітшілік шынымен де қысқа.
Dialogue: 0,0:25:09.57,0:25:11.57,Default,,0,0,0,,Әйтеуір Беерус-сама мен Гоку-сан →
Dialogue: 0,0:25:11.57,0:25:15.57,Default,,0,0,0,,Олардың кездесуіне жол бермеудің жолы бар ма?
Dialogue: 0,0:25:15.57,0:25:18.58,Default,,0,0,0,,Не істесең де, бұл бос қарсылық.
Dialogue: 0,0:25:18.58,0:25:23.58,Default,,0,0,0,,Беерус-саманың әрекеті табиғат заңымен бірдей.
Dialogue: 0,0:25:23.58,0:25:27.59,Default,,0,0,0,,Біздің қолымыздан келетіні – дауылдың өткенін күту.
Dialogue: 0,0:25:27.59,0:25:29.59,Default,,0,0,0,,Міне...
Dialogue: 0,0:25:29.59,0:25:31.59,Default,,0,0,0,,Бұл жолы жай жұлдыздар емес→
Dialogue: 0,0:25:31.59,0:25:35.59,Default,,0,0,0,,Бүкіл ғалам жойылып кетуі мүмкін.
Dialogue: 0,0:25:35.59,0:25:38.60,Default,,0,0,0,,Хмм... бүкіл ғалам?
Dialogue: 0,0:25:38.60,0:25:40.60,Default,,0,0,0,,Мен оны міндетті түрде табамын. →
Dialogue: 0,0:25:40.60,0:25:44.60,Default,,0,0,0,,Super Saiyan God сияқты нәрсе.
Dialogue: 0,0:25:46.54,0:25:56.54,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:48.53,0:26:50.54,Default,,0,0,0,,Сәлем, Гоку.
Dialogue: 0,0:26:50.54,0:26:53.54,Default,,0,0,0,,Менің ойымша, кеш басталды.
Dialogue: 0,0:26:53.54,0:26:57.54,Default,,0,0,0,,Жарайды, бәріміз көңіл көтеріп жатырмыз, сонда бәрі жақсы болады.
Dialogue: 0,0:26:57.54,0:27:00.55,Default,,0,0,0,,Солай ма? Кай патша Беерус-самадан қатты қорқады→
Dialogue: 0,0:27:00.55,0:27:02.55,Default,,0,0,0,,Бұл күлкілі күшті.
Dialogue: 0,0:27:02.55,0:27:06.55,Default,,0,0,0,,Әй, мен қатты толқып тұрмын!
Dialogue: 0,0:27:06.55,0:27:09.55,Default,,0,0,0,,Келесі жолы «Dragon Ball Super»
Dialogue: 0,0:27:12.56,0:27:14.56,Default,,0,0,0,,Міндетті түрде қарап шығу керек.
Dialogue: 0,0:27:16.06,0:27:22.06,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory