Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:33.02,0:01:43.02,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:09.11,0:04:11.11,Default,,0,0,0,,Бұл жаман болды.
Dialogue: 0,0:04:11.11,0:04:13.11,Default,,0,0,0,,Ах! Ка… Ка….
Dialogue: 0,0:04:13.11,0:04:18.12,Default,,0,0,0,,<Жоятын құдай Берустың зор күші>
Dialogue: 0,0:04:18.12,0:04:25.12,Default,,0,0,0,,＜Алайда бұл қорқынышты шабуыл Гокудың жүрегін өртеп жіберді＞
Dialogue: 0,0:04:25.12,0:04:33.13,Default,,0,0,0,,<Супер Сайян Құдайының шынайы күші ақыры оянады>
Dialogue: 0,0:04:33.13,0:04:35.13,Default,,0,0,0,,《Ора бір нәрсе→
Dialogue: 0,0:04:35.13,0:04:40.13,Default,,0,0,0,,Уау, мен қатты толқып тұрмын! 》
Dialogue: 0,0:04:45.14,0:04:48.15,Default,,0,0,0,,Жалғастырайық, Беерус-сама.
Dialogue: 0,0:04:48.15,0:04:52.15,Default,,0,0,0,,Супер Сайян Құдайдың құдіреті әлі де сақталады →
Dialogue: 0,0:04:52.15,0:04:56.15,Default,,0,0,0,,Ол мені жоғарыға апаратын сияқты.
Dialogue: 0,0:04:56.15,0:04:58.16,Default,,0,0,0,,Жақсы жүз.
Dialogue: 0,0:04:58.16,0:05:03.16,Default,,0,0,0,,Осы уақытқа дейін жеткен күшіңіздің құрметіне→
Dialogue: 0,0:05:03.16,0:05:06.18,Default,,0,0,0,,Маған көрсетейін →
Dialogue: 0,0:05:06.18,0:05:08.10,Default,,0,0,0,,Менің күшім.
Dialogue: 0,0:05:08.10,0:05:12.10,Default,,0,0,0,,<Гоку Берусты жеңе ме?>
Dialogue: 0,0:05:12.10,0:05:17.10,Default,,0,0,0,,Жерді сақтай аламыз ба? ＞
Dialogue: 0,0:05:30.12,0:05:41.13,Default,,0,0,0,,♪♪~
Dialogue: 0,0:05:41.13,0:05:43.13,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:43.13,0:05:45.13,Default,,0,0,0,,Иә.
Dialogue: 0,0:05:51.14,0:05:53.14,Default,,0,0,0,,Сіз оны уақытында орындадыңыз ба?
Dialogue: 0,0:05:53.14,0:05:57.15,Default,,0,0,0,,Сәттілік! Әке!
Dialogue: 0,0:05:57.15,0:06:00.15,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,0:06:00.15,0:06:03.15,Default,,0,0,0,,Не... Бұл не?
Dialogue: 0,0:06:03.15,0:06:06.12,Default,,0,0,0,,А... бұл қиын! Кя!
Dialogue: 0,0:06:06.12,0:06:07.99,Default,,0,0,0,,Пикколо мырза, бұл не?
Dialogue: 0,0:06:07.99,0:06:10.99,Default,,0,0,0,,Олардың күші ауаны жағуда.
Dialogue: 0,0:06:10.99,0:06:14.00,Default,,0,0,0,,Уау, құлап жатыр!
Dialogue: 0,0:06:14.00,0:06:17.00,Default,,0,0,0,,Бірдеңе істе! Мен бірдеңе істеп жатырмын!
Dialogue: 0,0:06:17.00,0:06:19.00,Default,,0,0,0,,Жолың болсын, Бұлма-сан.
Dialogue: 0,0:06:19.00,0:06:22.01,Default,,0,0,0,,А... Орын ауыстырамыз ба?
Dialogue: 0,0:06:22.01,0:06:26.01,Default,,0,0,0,,Егер сіз мұны істей алсаңыз, мен риза болар едім.
Dialogue: 0,0:06:26.01,0:06:28.01,Default,,0,0,0,,Иә.
Dialogue: 0,0:06:37.02,0:06:40.02,Default,,0,0,0,,Сәлеметсіз бе.
Dialogue: 0,0:06:40.02,0:06:43.02,Default,,0,0,0,,Сіздің мойныңыз ауырады ма?
Dialogue: 0,0:06:45.03,0:06:47.03,Default,,0,0,0,,Хмм….
Dialogue: 0,0:06:50.03,0:06:53.04,Default,,0,0,0,,Оу! Ашық және анық →
Dialogue: 0,0:06:53.04,0:06:57.04,Default,,0,0,0,,Анау-мынау жерлерге.
Dialogue: 0,0:06:57.04,0:07:00.04,Default,,0,0,0,,О...о.
Dialogue: 0,0:07:00.04,0:07:04.04,Default,,0,0,0,,Көргіңіз келсе, маған хабарлаңыз.
Dialogue: 0,0:07:07.08,0:07:10.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:10.09,0:07:13.09,Default,,0,0,0,,Иә? Берус-сама жоқ.
Dialogue: 0,0:07:13.09,0:07:16.09,Default,,0,0,0,,Сен қайда бардың?
Dialogue: 0,0:07:16.09,0:07:18.10,Default,,0,0,0,,Бұл ұят.
Dialogue: 0,0:07:18.10,0:07:20.10,Default,,0,0,0,,Һм. →
Dialogue: 0,0:07:20.10,0:07:23.10,Default,,0,0,0,,Иә? Оны тоқтатайық.
Dialogue: 0,0:07:23.10,0:07:25.10,Default,,0,0,0,,Мені енді сол техника соқпайды.
Dialogue: 0,0:07:25.10,0:07:28.11,Default,,0,0,0,,Түсінесіз бе?
Dialogue: 0,0:07:28.11,0:07:33.11,Default,,0,0,0,,, солай ма? Хехе.
Dialogue: 0,0:07:33.11,0:07:37.11,Default,,0,0,0,,Алаяқтарды қалдырайық. Мен сонда баруым керек.
Dialogue: 0,0:07:37.11,0:07:39.11,Default,,0,0,0,,Әй!
Dialogue: 0,0:07:43.12,0:07:45.12,Default,,0,0,0,,Иә.
Dialogue: 0,0:07:47.12,0:07:50.13,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:50.13,0:07:54.13,Default,,0,0,0,,Мм.
Dialogue: 0,0:07:54.13,0:07:57.13,Default,,0,0,0,,Ха!
Dialogue: 0,0:07:57.13,0:08:00.14,Default,,0,0,0,,Уф.
Dialogue: 0,0:08:00.14,0:08:03.14,Default,,0,0,0,,Ха!
Dialogue: 0,0:08:03.14,0:08:06.13,Default,,0,0,0,,Арх!
Dialogue: 0,0:08:06.13,0:08:10.08,Default,,0,0,0,,Аа!!
Dialogue: 0,0:08:10.08,0:08:13.08,Default,,0,0,0,,Гуаааа!
Dialogue: 0,0:08:15.09,0:08:17.09,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:08:17.09,0:08:19.09,Default,,0,0,0,,Ой!
Dialogue: 0,0:08:19.09,0:08:21.09,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:08:21.09,0:08:23.09,Default,,0,0,0,,Уф!
Dialogue: 0,0:08:23.09,0:08:25.09,Default,,0,0,0,,Ха! Хаа!
Dialogue: 0,0:08:33.10,0:08:35.10,Default,,0,0,0,,Әй!
Dialogue: 0,0:08:40.11,0:08:42.11,Default,,0,0,0,,Иә?
Dialogue: 0,0:08:44.11,0:08:46.11,Default,,0,0,0,,Ах... (Кәрі Кай) А...
Dialogue: 0,0:08:57.13,0:08:59.13,Default,,0,0,0,,Бұл... бұл.
Dialogue: 0,0:08:59.13,0:09:03.13,Default,,0,0,0,,Оқиға орнынан қаншалықты алыс болсаң, соғұрлым көп → болатын сияқты
Dialogue: 0,0:09:03.13,0:09:06.07,Default,,0,0,0,,Деструктивті күш күшейіп бара жатқан сияқты.
Dialogue: 0,0:09:06.07,0:09:10.07,Default,,0,0,0,,Бұл оқиға болды. (Кибито Құдай) Иә?
Dialogue: 0,0:09:15.08,0:09:19.08,Default,,0,0,0,,Әлем жойылады. (Кибито Құдай) Иә!?
Dialogue: 0,0:09:19.08,0:09:24.09,Default,,0,0,0,,Егер бұл екеуі тағы бірнеше рет соқтығысса.
Dialogue: 0,0:09:24.09,0:09:26.09,Default,,0,0,0,,Аа!!
Dialogue: 0,0:09:26.09,0:09:28.09,Default,,0,0,0,,Нуо!!
Dialogue: 0,0:09:31.09,0:09:37.10,Default,,0,0,0,,Адамдар, жұлдыздар, біз құдайлар, Беерус-сама және Гоку→
Dialogue: 0,0:09:37.10,0:09:39.10,Default,,0,0,0,,Толығымен жойылған→
Dialogue: 0,0:09:39.10,0:09:43.11,Default,,0,0,0,,Бұл ғалам ештеңе емес →
Dialogue: 0,0:09:43.11,0:09:47.11,Default,,0,0,0,,Ол бос кеңістікке айналады.
Dialogue: 0,0:09:47.11,0:09:49.11,Default,,0,0,0,,А... аа....
Dialogue: 0,0:09:49.11,0:09:53.12,Default,,0,0,0,,Кукукуку... Қуа!
Dialogue: 0,0:09:53.12,0:09:56.12,Default,,0,0,0,,Айдаһар шарларын пайдалануға рұқсат беру үшін →
Dialogue: 0,0:09:56.12,0:10:01.12,Default,,0,0,0,,Толық қыздың тентек және жылы суреті.
Dialogue: 0,0:10:01.12,0:10:03.13,Default,,0,0,0,,Жас ұлғаюына байланысты →
Dialogue: 0,0:10:03.13,0:10:08.07,Default,,0,0,0,,Сіз маған қаңылтыр беруге уәде берген едіңіз! Қазірдің өзінде!
Dialogue: 0,0:10:08.07,0:10:12.07,Default,,0,0,0,,А, мен мұнымен Буддалыққа жете алмаймын!
Dialogue: 0,0:10:12.07,0:10:14.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:14.07,0:10:16.07,Default,,0,0,0,,Ах... тағы неше рет?
Dialogue: 0,0:10:16.07,0:10:21.08,Default,,0,0,0,,Әлем тағы қанша соқтығысқа төтеп бере алады?
Dialogue: 0,0:10:21.08,0:10:25.08,Default,,0,0,0,,Ең көбі екі рет көрдім. (Кибито Құдай) Тек екі рет!?
Dialogue: 0,0:10:25.08,0:10:28.09,Default,,0,0,0,,А, жоқ, мүмкін үш рет.
Dialogue: 0,0:10:28.09,0:10:32.09,Default,,0,0,0,,Бұл маңызды мәселе, сондықтан нақты айта аласыз ба!?
Dialogue: 0,0:10:32.09,0:10:35.09,Default,,0,0,0,,Олай болса, екі рет жасайық.
Dialogue: 0,0:10:35.09,0:10:37.09,Default,,0,0,0,,Муо!
Dialogue: 0,0:10:37.09,0:10:40.10,Default,,0,0,0,,Әй!
Dialogue: 0,0:10:40.10,0:10:42.10,Default,,0,0,0,,Иә. Ха.
Dialogue: 0,0:10:45.10,0:10:49.11,Default,,0,0,0,,Оны бұзбаңыз.
Dialogue: 0,0:10:49.11,0:10:52.11,Default,,0,0,0,,Иә. Хмф.
Dialogue: 0,0:10:54.11,0:10:56.11,Default,,0,0,0,,≪(Кибито Құдай) Сіз мені естисіз бе? Гоку мырза! →
Dialogue: 0,0:10:56.11,0:10:59.12,Default,,0,0,0,,Енді ұрысты тоқтатыңыз! →
Dialogue: 0,0:10:59.12,0:11:01.12,Default,,0,0,0,,Сен мені естисің, Беерус-сама!
Dialogue: 0,0:11:01.12,0:11:03.12,Default,,0,0,0,,Қарғыс атсын!
Dialogue: 0,0:11:10.06,0:11:13.06,Default,,0,0,0,,А, жоқ.
Dialogue: 0,0:11:13.06,0:11:17.07,Default,,0,0,0,,Бұл жекпе-жектердің дауысы естілетін шайқас па?
Dialogue: 0,0:11:17.07,0:11:20.07,Default,,0,0,0,,Аа!!
Dialogue: 0,0:11:20.07,0:11:23.07,Default,,0,0,0,,Жақсы!!
Dialogue: 0,0:11:23.07,0:11:25.08,Default,,0,0,0,,Аа!!
Dialogue: 0,0:11:25.08,0:11:28.08,Default,,0,0,0,,Аа!!
Dialogue: 0,0:11:28.08,0:11:31.08,Default,,0,0,0,,Нуо!!
Dialogue: 0,0:11:31.08,0:11:33.08,Default,,0,0,0,,Гааах!
Dialogue: 0,0:11:33.08,0:11:35.09,Default,,0,0,0,,Ха! Гуаааа!
Dialogue: 0,0:11:35.09,0:11:37.09,Default,,0,0,0,,Ах, жоқ, мәселе сол емес! Мен бұған дейін ешқашан жеп көрмеппін…
Dialogue: 0,0:11:37.09,0:11:41.09,Default,,0,0,0,,Уау! Алақай!
Dialogue: 0,0:11:41.09,0:11:43.09,Default,,0,0,0,,Ой… Бұл сәл ағаттық болды.
Dialogue: 0,0:11:43.09,0:11:45.10,Default,,0,0,0,,Уау! Алақай!
Dialogue: 0,0:11:45.10,0:11:47.10,Default,,0,0,0,,Ха! Ха!
Dialogue: 0,0:11:54.10,0:11:58.11,Default,,0,0,0,,Қарғыс атсын... Хм...
Dialogue: 0,0:11:58.11,0:12:00.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:00.11,0:12:02.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:05.12,0:12:07.05,Default,,0,0,0,,Кя! Апыр-ай!
Dialogue: 0,0:12:07.05,0:12:09.05,Default,,0,0,0,,Уау! Апыр-ай!
Dialogue: 0,0:12:11.05,0:12:14.06,Default,,0,0,0,,Бұл Құдай мен Құдай арасындағы шайқас па?
Dialogue: 0,0:12:14.06,0:12:16.06,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:12:23.07,0:12:26.07,Default,,0,0,0,,Ах…. (Кибитогами) Ах... ах...
Dialogue: 0,0:12:29.07,0:12:32.08,Default,,0,0,0,,Ах... Ах!
Dialogue: 0,0:12:32.08,0:12:34.08,Default,,0,0,0,,Мұнда Шайтан қаласында→
Dialogue: 0,0:12:34.08,0:12:37.08,Default,,0,0,0,,Екінші соққы толқыны жақында өтті!
Dialogue: 0,0:12:37.08,0:12:41.08,Default,,0,0,0,,Жер бетінде не болып жатыр?!
Dialogue: 0,0:12:41.08,0:12:43.09,Default,,0,0,0,,Не?
Dialogue: 0,0:12:43.09,0:12:45.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:45.09,0:12:48.09,Default,,0,0,0,,Бұл жерде Шайтан мырзамен байланыс орнатқан сияқтысыз.
Dialogue: 0,0:12:48.09,0:12:50.09,Default,,0,0,0,,[ТЕЛ] (Диктор) Шайтан мырза! →
Dialogue: 0,0:12:50.09,0:12:53.10,Default,,0,0,0,,Қала қиыншылықта, сонда сен қайдасың?
Dialogue: 0,0:12:53.10,0:12:57.10,Default,,0,0,0,,Туған күн кеші өтетін жерде...
Dialogue: 0,0:12:57.10,0:12:59.10,Default,,0,0,0,,[TEL] (Диктор) Иә!? О, жоқ.
Dialogue: 0,0:12:59.10,0:13:03.11,Default,,0,0,0,,Туған күн болып көрінді→
Dialogue: 0,0:13:03.11,0:13:07.04,Default,,0,0,0,,Аса зұлым қылмыстық ұйымның демеушілігімен ұрланған тауарлар аукционында→
Dialogue: 0,0:13:07.04,0:13:09.05,Default,,0,0,0,,Олар еніп жатыр.
Dialogue: 0,0:13:09.05,0:13:12.05,Default,,0,0,0,,[ТЕЛ] (Диктор) О! Мүмкін сол қылмыстық ұйыммен →
Dialogue: 0,0:13:12.05,0:13:14.05,Default,,0,0,0,,Бұл соққы толқынының оған қатысы бар ма?
Dialogue: 0,0:13:14.05,0:13:16.05,Default,,0,0,0,,Міне, бұл туралы.
Dialogue: 0,0:13:16.05,0:13:18.05,Default,,0,0,0,,[ТЕЛ] (диктор) Толығырақ айтып беріңізші.
Dialogue: 0,0:13:18.05,0:13:22.06,Default,,0,0,0,,Ug! Уф….
Dialogue: 0,0:13:22.06,0:13:26.06,Default,,0,0,0,,Иә? Сигнал нашар.
Dialogue: 0,0:13:26.06,0:13:28.06,Default,,0,0,0,,[TEL] (Диктор) Шайтан мырза? Сәлем, сәлем.
Dialogue: 0,0:13:28.06,0:13:31.06,Default,,0,0,0,,Сәлеметсіз бе. [TEL] (Диктор) Шайтан мырза!
Dialogue: 0,0:13:33.07,0:13:35.07,Default,,0,0,0,,《Сейрек шапалақ》
Dialogue: 0,0:13:35.07,0:13:38.07,Default,,0,0,0,,Гохан-кун Гохан-кун! →
Dialogue: 0,0:13:38.07,0:13:40.08,Default,,0,0,0,,Біз бірдеңе істей алмаймыз ба? Мұнда →
Dialogue: 0,0:13:40.08,0:13:44.08,Default,,0,0,0,,Ішінде сәбиі бар Видель бар!
Dialogue: 0,0:13:44.08,0:13:46.08,Default,,0,0,0,,Түсіндің бе?
Dialogue: 0,0:13:46.08,0:13:48.08,Default,,0,0,0,,Мен түсіндім. Бірақ бұл да...
Dialogue: 0,0:13:48.08,0:13:50.08,Default,,0,0,0,,Саған не болды!?
Dialogue: 0,0:13:54.09,0:13:56.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:13:58.09,0:14:02.10,Default,,0,0,0,,Куу! Уф!
Dialogue: 0,0:14:02.10,0:14:06.10,Default,,0,0,0,,Уф….
Dialogue: 0,0:14:06.10,0:14:09.11,Default,,0,0,0,,Иә? →
Dialogue: 0,0:14:09.11,0:14:11.11,Default,,0,0,0,,О.
Dialogue: 0,0:14:15.11,0:14:17.11,Default,,0,0,0,,О.
Dialogue: 0,0:14:17.11,0:14:20.12,Default,,0,0,0,,Қауіпті Қауіпті.
Dialogue: 0,0:14:20.12,0:14:23.12,Default,,0,0,0,,Аа….
Dialogue: 0,0:14:23.12,0:14:26.12,Default,,0,0,0,,Сіз... маған көмектестіңіз бе?
Dialogue: 0,0:14:26.12,0:14:28.12,Default,,0,0,0,,Берус-сама уәде берді. →
Dialogue: 0,0:14:28.12,0:14:33.13,Default,,0,0,0,,Гоку жеңсе, Жер жойылуы керек.
Dialogue: 0,0:14:33.13,0:14:36.13,Default,,0,0,0,,Шайқас әлі аяқталған жоқ, солай емес пе?
Dialogue: 0,0:14:36.13,0:14:39.14,Default,,0,0,0,,Кез келген жағдайда. Хехе.
Dialogue: 0,0:14:39.14,0:14:44.14,Default,,0,0,0,,Хахаха….
Dialogue: 0,0:14:44.14,0:14:47.14,Default,,0,0,0,,Хахаха….
Dialogue: 0,0:14:47.14,0:14:50.15,Default,,0,0,0,,Күрсін... Күрсін....
Dialogue: 0,0:14:50.15,0:14:55.15,Default,,0,0,0,,Ах... хаа ха....
Dialogue: 0,0:14:55.15,0:14:58.15,Default,,0,0,0,,Хахаха….
Dialogue: 0,0:15:02.16,0:15:04.16,Default,,0,0,0,,Ах.
Dialogue: 0,0:15:07.10,0:15:11.10,Default,,0,0,0,,Түсімде көргенімдей.
Dialogue: 0,0:15:11.10,0:15:13.10,Default,,0,0,0,,Иә.
Dialogue: 0,0:15:13.10,0:15:19.11,Default,,0,0,0,,Жарайсың, осы уақытқа дейін жеттің. Мен сені мақтаймын, Супер Сайян Құдай!
Dialogue: 0,0:15:19.11,0:15:23.11,Default,,0,0,0,,Хехехе, Беерус-самаға рахмет.
Dialogue: 0,0:15:23.11,0:15:26.12,Default,,0,0,0,,А... ха!
Dialogue: 0,0:15:26.12,0:15:28.12,Default,,0,0,0,,Келесі соққы →
Dialogue: 0,0:15:28.12,0:15:33.12,Default,,0,0,0,,Мені осы уақытқа дейін жеткізген Беерус-самаға алғыс айтамын→
Dialogue: 0,0:15:33.12,0:15:36.12,Default,,0,0,0,,Мен саған қолымнан келгенше беремін!
Dialogue: 0,0:15:38.13,0:15:40.13,Default,,0,0,0,,Аа….
Dialogue: 0,0:15:40.13,0:15:42.13,Default,,0,0,0,,Келесі үшінші рет.
Dialogue: 0,0:15:42.13,0:15:46.13,Default,,0,0,0,,Ух... ғалам ғайып болады.
Dialogue: 0,0:17:29.11,0:17:32.11,Default,,0,0,0,,Куу! Уф!
Dialogue: 0,0:17:32.11,0:17:35.11,Default,,0,0,0,,Ум!
Dialogue: 0,0:17:44.12,0:17:47.12,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:08.14,0:18:10.14,Default,,0,0,0,,Nu! Хмм!
Dialogue: 0,0:18:19.16,0:18:22.16,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:22.16,0:18:25.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:25.09,0:18:27.10,Default,,0,0,0,,Уг-г-г
Dialogue: 0,0:18:27.10,0:18:29.10,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:29.10,0:18:31.10,Default,,0,0,0,,Уг-г-г
Dialogue: 0,0:18:31.10,0:18:33.10,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:33.10,0:18:36.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:36.11,0:18:38.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:40.11,0:18:43.11,Default,,0,0,0,,Кеттік! кел!
Dialogue: 0,0:18:43.11,0:18:45.11,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:45.11,0:18:47.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:47.12,0:18:50.12,Default,,0,0,0,,Уау. Апыр-ай.
Dialogue: 0,0:18:50.12,0:18:52.12,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:52.12,0:18:56.13,Default,,0,0,0,,өте ашық костюміңізбен үлкен шу тудырған едіңіз—
Dialogue: 0,0:18:56.13,0:18:58.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:58.13,0:19:00.13,Default,,0,0,0,,Бұл тек алдын алу тексерісі ғана
Dialogue: 0,0:19:00.13,0:19:15.14,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:15.14,0:19:17.15,Default,,0,0,0,,Орындалды. Иә?
Dialogue: 0,0:19:17.15,0:19:20.15,Default,,0,0,0,,О... (Кибито Құдай) Иә?
Dialogue: 0,0:19:20.15,0:19:22.15,Default,,0,0,0,,Уг-г-г
Dialogue: 0,0:19:22.15,0:19:24.09,Default,,0,0,0,,Уау.
Dialogue: 0,0:19:24.09,0:19:34.10,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:34.10,0:19:36.10,Default,,0,0,0,,Уф. Хе.
Dialogue: 0,0:19:36.10,0:19:40.10,Default,,0,0,0,,Ой... уау!
Dialogue: 0,0:19:40.10,0:19:44.11,Default,,0,0,0,,Уау. Апыр-ай!
Dialogue: 0,0:19:44.11,0:19:46.11,Default,,0,0,0,,Ух... Хэхехе.
Dialogue: 0,0:19:46.11,0:19:49.11,Default,,0,0,0,,Не... қандай сұмдық.
Dialogue: 0,0:19:49.11,0:19:53.12,Default,,0,0,0,,Ата-бабалар, қазір не істеп жатырсыңдар?
Dialogue: 0,0:19:53.12,0:19:56.12,Default,,0,0,0,,Импульсі мен бұрышы тура сол жігіт→
Dialogue: 0,0:19:56.12,0:19:59.12,Default,,0,0,0,,Жұдырықпен соғу арқылы →
Dialogue: 0,0:19:59.12,0:20:03.13,Default,,0,0,0,,Мен Беерус-саманың шабуылын тоқтаттым.
Dialogue: 0,0:20:03.13,0:20:05.13,Default,,0,0,0,,Шынымен, маған екінші атуды беріңізші →
Dialogue: 0,0:20:05.13,0:20:08.13,Default,,0,0,0,,Мен оны аяқтауды жоспарладым →
Dialogue: 0,0:20:08.13,0:20:10.13,Default,,0,0,0,,Беерус-самадан күткендей.
Dialogue: 0,0:20:10.13,0:20:13.14,Default,,0,0,0,,Ол маған оңайлықпен рұқсат етпеді.
Dialogue: 0,0:20:13.14,0:20:16.14,Default,,0,0,0,,《Бұл жігіт менімен төбелесіп жатыр→
Dialogue: 0,0:20:16.14,0:20:20.14,Default,,0,0,0,,Жаңа техниканы қолданып көрдіңіз бе?
Dialogue: 0,0:20:20.14,0:20:25.14,Default,,0,0,0,,Хехе. Апыр-ай!
Dialogue: 0,0:20:28.08,0:20:30.08,Default,,0,0,0,,Уау.
Dialogue: 0,0:20:34.09,0:20:36.09,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:36.09,0:20:39.10,Default,,0,0,0,,Сәлем! Алақай!
Dialogue: 0,0:20:39.10,0:20:41.10,Default,,0,0,0,,Сәлем! Татататата!
Dialogue: 0,0:20:41.10,0:20:44.10,Default,,0,0,0,,Таа!
Dialogue: 0,0:20:44.10,0:20:47.10,Default,,0,0,0,,Уф!
Dialogue: 0,0:20:49.11,0:20:51.11,Default,,0,0,0,,Уау! →
Dialogue: 0,0:20:51.11,0:20:53.11,Default,,0,0,0,,Қарғыс атсын...
Dialogue: 0,0:20:53.11,0:20:58.11,Default,,0,0,0,,Сіз Құдайдың құдіретіне ие болып, әлі де шыңға көтерілуге тырысасыз ба?
Dialogue: 0,0:20:58.11,0:21:00.11,Default,,0,0,0,,А, кеттік!
Dialogue: 0,0:21:02.12,0:21:04.12,Default,,0,0,0,,Ах... уф...
Dialogue: 0,0:21:04.12,0:21:06.12,Default,,0,0,0,,Екінші жартысында басқалар әлсіреп жатқанда, олар өздерінің көз тартымды Квиркімен жауды өздеріне тартты ➡
Dialogue: 0,0:21:15.13,0:21:20.13,Default,,0,0,0,,Құдайдың құдіретін бағалама.
Dialogue: 0,0:21:23.16,0:21:25.07,Default,,0,0,0,,Иә.
Dialogue: 0,0:21:25.07,0:21:45.09,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:45.09,0:21:57.11,Default,,0,0,0,,♪♪~
Dialogue: 0,0:21:57.11,0:21:59.11,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:22:06.12,0:22:08.12,Default,,0,0,0,,Ах...
Dialogue: 0,0:22:08.12,0:22:11.12,Default,,0,0,0,,Ка→
Dialogue: 0,0:22:11.12,0:22:14.12,Default,,0,0,0,,Мен→
Dialogue: 0,0:22:14.12,0:22:17.13,Default,,0,0,0,,Га→
Dialogue: 0,0:22:17.13,0:22:19.13,Default,,0,0,0,,Мен!
Dialogue: 0,0:22:19.13,0:22:21.13,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:22:21.13,0:22:23.10,Default,,0,0,0,,Толқын!
Dialogue: 0,0:22:23.10,0:22:24.97,Default,,0,0,0,,Толқын!
Dialogue: 0,0:22:24.97,0:22:26.97,Default,,0,0,0,,Толқын!
Dialogue: 0,0:22:34.98,0:22:37.98,Default,,0,0,0,,Ах! (Кәрі Кай) Ах...
Dialogue: 0,0:22:37.98,0:22:39.98,Default,,0,0,0,,Міне...
Dialogue: 0,0:22:41.98,0:22:44.99,Default,,0,0,0,,Қарап көріңіз. →
Dialogue: 0,0:22:44.99,0:22:49.99,Default,,0,0,0,,Қорқынышты соққы толқыны әлемді шарпыуда! →
Dialogue: 0,0:22:49.99,0:22:54.00,Default,,0,0,0,,Менде өте жағымсыз сезім бар. →
Dialogue: 0,0:22:54.00,0:22:57.00,Default,,0,0,0,,Негізі менде жағымсыз сезім бар!
Dialogue: 0,0:22:57.00,0:22:59.00,Default,,0,0,0,,Уау!
Dialogue: 0,0:22:59.00,0:23:02.00,Default,,0,0,0,,Уау... аа... Уау.
Dialogue: 0,0:23:13.02,0:23:18.02,Default,,0,0,0,,Сонымен... соңы осылай болды ма?
Dialogue: 0,0:23:20.02,0:23:22.02,Default,,0,0,0,,Аа….
Dialogue: 0,0:23:22.02,0:23:28.06,Default,,0,0,0,,Сізді артта қалдырғаным үшін кешіріңіз, бірақ қоштасатын кез келген сияқты.
Dialogue: 0,0:23:28.06,0:23:30.07,Default,,0,0,0,,Ах.
Dialogue: 0,0:23:30.07,0:23:33.07,Default,,0,0,0,,Ата-бабалар...
Dialogue: 0,0:23:33.07,0:23:35.07,Default,,0,0,0,,Қараңыз. (Кибито Құдай) Иә?
Dialogue: 0,0:23:40.08,0:23:43.08,Default,,0,0,0,,Оны қоштасу сыйы ретінде қабылдаңыз. →
Dialogue: 0,0:23:43.08,0:23:45.08,Default,,0,0,0,,Ах!
Dialogue: 0,0:23:55.09,0:23:57.09,Default,,0,0,0,,Уф.
Dialogue: 0,0:24:02.10,0:24:05.10,Default,,0,0,0,,Гррр… Уф….
Dialogue: 0,0:24:07.10,0:24:10.11,Default,,0,0,0,,Бұл… бұл→
Dialogue: 0,0:24:10.11,0:24:14.11,Default,,0,0,0,,Супер Сайян Құдайдың шектері.
Dialogue: 0,0:24:14.11,0:24:19.12,Default,,0,0,0,,Беерус-сама. Сіз кереметсіз.
Dialogue: 0,0:24:19.12,0:24:22.12,Default,,0,0,0,,Кешіріңіз, бірақ эй...→
Dialogue: 0,0:24:22.12,0:24:26.06,Default,,0,0,0,,Мен үлгере алмаймын деп ойлаймын.
Dialogue: 0,0:24:26.06,0:24:30.06,Default,,0,0,0,,Уау!
Dialogue: 0,0:24:30.06,0:24:32.06,Default,,0,0,0,,Жақсы орындадың.
Dialogue: 0,0:24:35.06,0:24:37.06,Default,,0,0,0,,Иә?
Dialogue: 0,0:24:40.07,0:24:42.07,Default,,0,0,0,,Сәлем.
Dialogue: 0,0:24:44.07,0:24:47.08,Default,,0,0,0,,Дәл.
Dialogue: 0,0:24:47.08,0:24:49.08,Default,,0,0,0,,Жаңа велосипедтің қуанышына ештеңе жетпейді, иә?
Dialogue: 0,0:24:49.08,0:24:54.08,Default,,0,0,0,,Супер Сайян Құдайдың күші Олаға айтты.
Dialogue: 0,0:24:54.08,0:24:58.09,Default,,0,0,0,,Жоғары... Жоғары көтеріл!
Dialogue: 0,0:24:58.09,0:25:00.09,Default,,0,0,0,,Міне, бастаймын!
Dialogue: 0,0:25:00.09,0:25:02.09,Default,,0,0,0,,Уууу!
Dialogue: 0,0:25:04.09,0:25:07.10,Default,,0,0,0,,Ха!
Dialogue: 0,0:25:07.10,0:25:11.10,Default,,0,0,0,,Міне, сол жаққа қара, Хагакуре-сан!
Dialogue: 0,0:25:16.11,0:25:18.11,Default,,0,0,0,,Ах.
Dialogue: 0,0:25:25.05,0:25:30.05,Default,,0,0,0,,<Әлемді қамтитын қуаттың орасан зор жарылысы>
Dialogue: 0,0:25:30.05,0:25:34.06,Default,,0,0,0,,<Сол ғажайып жарық сөнгенде→
Dialogue: 0,0:25:34.06,0:25:39.06,Default,,0,0,0,,Онда кім тұр? ＞
Dialogue: 0,0:25:46.07,0:25:56.07,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:49.07,0:26:51.07,Default,,0,0,0,,Сәлем, Гоку.
Dialogue: 0,0:26:51.07,0:26:54.07,Default,,0,0,0,,Мен таң қалдым! Бұл қандай техника?
Dialogue: 0,0:26:54.07,0:26:57.07,Default,,0,0,0,,Беерус-сама, сен әлі де өз күшіңді жасырып жүрсің бе?
Dialogue: 0,0:26:57.07,0:27:01.08,Default,,0,0,0,,Бірақ мен бұрынғыдан сәл өзгешемін.
Dialogue: 0,0:27:01.08,0:27:05.08,Default,,0,0,0,,Мен жеңіле алмаймын! Күресті жалғастырайық!
Dialogue: 0,0:27:05.08,0:27:08.08,Default,,0,0,0,,Келесі жолы «Dragon Ball Super»
Dialogue: 0,0:27:12.09,0:27:14.09,Default,,0,0,0,,Сіз оны міндетті түрде тексеруіңіз керек.
Dialogue: 0,0:27:15.59,0:27:21.59,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory