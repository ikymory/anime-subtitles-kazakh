Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:33.09,0:01:43.09,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:07.61,0:04:10.61,Default,,0,0,0,,<Вегета Whis-пен жаттығуға кетеді→
Dialogue: 0,0:04:10.61,0:04:15.62,Default,,0,0,0,,Жарты жылдан сәл астам уақыт өтті＞
Dialogue: 0,0:04:15.62,0:04:21.63,Default,,0,0,0,,<Жерде Гохан мен Видельдің баласы дүниеге келді>
Dialogue: 0,0:04:21.63,0:04:27.63,Default,,0,0,0,,<Криллин жекпе-жектен шығып, полиция қызметкері болып жұмыс істеді>
Dialogue: 0,0:04:29.63,0:04:34.63,Default,,0,0,0,,<Гоку Чичидің бұйрығымен егіншілікте көп жұмыс істеді>
Dialogue: 0,0:04:36.64,0:04:38.64,Default,,0,0,0,,<Бірақ Вегета→
Dialogue: 0,0:04:38.64,0:04:40.64,Default,,0,0,0,,Мен Whis-ке жаттығуға бардым →
Dialogue: 0,0:04:40.64,0:04:44.65,Default,,0,0,0,,Гоку Чичидің оны тоқтатуын біліп, тыңдамады →
Dialogue: 0,0:04:44.65,0:04:48.65,Default,,0,0,0,,Ол Whis>-мен бірге кетті
Dialogue: 0,0:05:04.67,0:05:07.60,Default,,0,0,0,,Шынымен, Гоку-сан мен Вегета-сан да →
Dialogue: 0,0:05:07.60,0:05:11.61,Default,,0,0,0,,Сіз менімен бірге жаттығыңыз келетін ерекше адам болуыңыз керек.
Dialogue: 0,0:05:11.61,0:05:14.61,Default,,0,0,0,,Беерус-саманың жанында болғысы келетіндер→
Dialogue: 0,0:05:14.61,0:05:16.61,Default,,0,0,0,,Біреуін табу сирек.
Dialogue: 0,0:05:16.61,0:05:18.62,Default,,0,0,0,,Ал, көбірек жаттыға →
Dialogue: 0,0:05:18.62,0:05:22.62,Default,,0,0,0,,Беерус-самаға қара, сенің күшейгеніңе қуаныштымын.
Dialogue: 0,0:05:22.62,0:05:25.62,Default,,0,0,0,,Ұстаудың қажеті жоқ. Өтінемін қатты жаттығыңыз.
Dialogue: 0,0:05:25.62,0:05:27.62,Default,,0,0,0,,Бұл сіздің үміттеріңізге сәйкес келеді деп үміттенемін.
Dialogue: 0,0:05:27.62,0:05:31.63,Default,,0,0,0,,Солай ма? Whis-san, сен оған Донгри арқылы жетесің бе?
Dialogue: 0,0:05:31.63,0:05:34.63,Default,,0,0,0,,Бұл менің бірдеңе жасағым келеді...
Dialogue: 0,0:05:34.63,0:05:37.63,Default,,0,0,0,,Шонбен! ? Мен мұны осында жасасам жақсы ма?
Dialogue: 0,0:05:37.63,0:05:39.64,Default,,0,0,0,,Ешкім қарап тұрған жоқ... Амал жоқ!
Dialogue: 0,0:05:39.64,0:05:42.64,Default,,0,0,0,,Менің секіргім келмейді.
Dialogue: 0,0:05:42.64,0:05:45.64,Default,,0,0,0,,Бірақ бұлай жалғаса берсе, ол ағып кетеді.
Dialogue: 0,0:05:45.64,0:05:48.65,Default,,0,0,0,,Сабырлы болыңыз. Жақында келеді.
Dialogue: 0,0:05:48.65,0:05:50.65,Default,,0,0,0,,Бірақ...
Dialogue: 0,0:05:50.65,0:05:52.65,Default,,0,0,0,,Егер сіз зәр шықсаңыз →
Dialogue: 0,0:05:52.65,0:05:54.65,Default,,0,0,0,,Мен оны Жерге қайта жіберемін.
Dialogue: 0,0:05:54.65,0:05:56.65,Default,,0,0,0,,Сәлем! ?
Dialogue: 0,0:05:56.65,0:06:00.65,Default,,0,0,0,,Жақсы. Unnunu….
Dialogue: 0,0:06:04.66,0:06:09.60,Default,,0,0,0,,Біз келдік. Берус-сама сонда ма?
Dialogue: 0,0:06:09.60,0:06:12.60,Default,,0,0,0,,Үйдесің бе? (Балық пайғамбарлық) О~.
Dialogue: 0,0:06:12.60,0:06:16.61,Default,,0,0,0,,Сіз Құдайдың рухын сезіне аласыз ба?
Dialogue: 0,0:06:16.61,0:06:19.61,Default,,0,0,0,,Хун.
Dialogue: 0,0:06:19.61,0:06:21.61,Default,,0,0,0,,Қарап көргіңіз келе ме?
Dialogue: 0,0:06:21.61,0:06:23.61,Default,,0,0,0,,Біз иттерге ең жоғары құрметпен қараймыз.
Dialogue: 0,0:06:25.62,0:06:28.62,Default,,0,0,0,,Эй.
Dialogue: 0,0:06:44.63,0:06:47.64,Default,,0,0,0,,Қош келдіңіз, Уис-сама. иә! ?
Dialogue: 0,0:06:47.64,0:06:50.64,Default,,0,0,0,,Иә! ұзақ уақытта көрмеу! Какарот.
Dialogue: 0,0:06:50.64,0:06:53.64,Default,,0,0,0,,Уфуфу Болжағандай болды, солай ма?
Dialogue: 0,0:06:53.64,0:06:57.65,Default,,0,0,0,,Вегета-сан, бізбен амандасу жолында ерен еңбегіңіз үшін рахмет. →
Dialogue: 0,0:06:57.65,0:07:00.65,Default,,0,0,0,,Сіз ерекше бір нәрсені байқадыңыз ба?
Dialogue: 0,0:07:00.65,0:07:02.65,Default,,0,0,0,,Иә. Беерус-сама да дұрыс →
Dialogue: 0,0:07:02.65,0:07:04.65,Default,,0,0,0,,Демалыста қалу керек пе? (Вегета) Иә.
Dialogue: 0,0:07:04.65,0:07:06.59,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:07:06.59,0:07:10.59,Default,,0,0,0,,Бұған көмектесу мүмкін емес.
Dialogue: 0,0:07:10.59,0:07:12.60,Default,,0,0,0,,Не? сол. Мен оны Булмадан алдым →
Dialogue: 0,0:07:12.60,0:07:14.60,Default,,0,0,0,,Тәттілер. →
Dialogue: 0,0:07:14.60,0:07:16.60,Default,,0,0,0,,Мен Беерус-сама үшін де алдым→
Dialogue: 0,0:07:16.60,0:07:20.60,Default,,0,0,0,,Бұл жолы мен оны өзім аламын.
Dialogue: 0,0:07:20.60,0:07:22.61,Default,,0,0,0,,Хмм.
Dialogue: 0,0:07:22.61,0:07:24.61,Default,,0,0,0,,Дұрыс, Вегета.
Dialogue: 0,0:07:24.61,0:07:26.61,Default,,0,0,0,,Көріп отырғаныңыздай, Гоку-сан да ертіп келді.
Dialogue: 0,0:07:26.61,0:07:30.61,Default,,0,0,0,,Өйткені сен менімен бірге жаттығыңыз келеді.
Dialogue: 0,0:07:30.61,0:07:32.62,Default,,0,0,0,,Бір күні келеді деп ойладым.
Dialogue: 0,0:07:32.62,0:07:35.62,Default,,0,0,0,,Вегета да суық болуы керек.
Dialogue: 0,0:07:35.62,0:07:38.62,Default,,0,0,0,,Демек, сіз көптен бері жаттығуға келдіңіз бе?
Dialogue: 0,0:07:38.62,0:07:41.63,Default,,0,0,0,,Мені де шақырсаңыз жақсы болар еді.
Dialogue: 0,0:07:41.63,0:07:43.63,Default,,0,0,0,,Сізге бір-бірлеп айтып беруге міндетті емеспін.
Dialogue: 0,0:07:43.63,0:07:45.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:47.63,0:07:50.63,Default,,0,0,0,,Не?
Dialogue: 0,0:07:50.63,0:07:53.64,Default,,0,0,0,,Мм. Бұл керемет Вегета.
Dialogue: 0,0:07:53.64,0:07:56.64,Default,,0,0,0,,Осынша күш жұмсағаныңызға сене алар емеспін.
Dialogue: 0,0:07:56.64,0:07:59.64,Default,,0,0,0,,Мүмкін бұл Орадан да күшті шығар?
Dialogue: 0,0:07:59.64,0:08:03.65,Default,,0,0,0,,Сіздің рухыңыздың сапасы сіз Жерде болған кезден мүлдем басқаша.
Dialogue: 0,0:08:03.65,0:08:05.67,Default,,0,0,0,,Хун. Бір сәтке тіпті Вегета→
Dialogue: 0,0:08:05.67,0:08:07.58,Default,,0,0,0,,Мен түсінбедім.
Dialogue: 0,0:08:07.58,0:08:09.59,Default,,0,0,0,,Ол біртүрлі алжапқыш киіп алған.
Dialogue: 0,0:08:09.59,0:08:11.59,Default,,0,0,0,,Оған тиме!
Dialogue: 0,0:08:11.59,0:08:15.59,Default,,0,0,0,,Сіз қандай жаттығу жасадыңыз?
Dialogue: 0,0:08:15.59,0:08:19.60,Default,,0,0,0,,Хохохо Байқап көрсеңіз түсінесіз.
Dialogue: 0,0:08:19.60,0:08:21.60,Default,,0,0,0,,Сәлем! Мен мұны асыға күтемін!
Dialogue: 0,0:08:21.60,0:08:24.60,Default,,0,0,0,,Сіз қазір осындай нәрселерді айта аласыз.
Dialogue: 0,0:08:24.60,0:08:28.61,Default,,0,0,0,,Шу шығармай тұрып, үйге барған дұрыс емес пе?
Dialogue: 0,0:08:28.61,0:08:32.61,Default,,0,0,0,,Егер Вегета Ораның қарқынына ілесе алмаса→
Dialogue: 0,0:08:32.61,0:08:34.61,Default,,0,0,0,,Мен оны қалдырамын. Не! ?
Dialogue: 0,0:08:34.61,0:08:37.61,Default,,0,0,0,,Мен жеңілмеймін. Жарайды, екеуі де.
Dialogue: 0,0:08:37.61,0:08:40.62,Default,,0,0,0,,Айтпақшы, Гоку-сан, сен шынымен зәр алғың келе ме?
Dialogue: 0,0:08:40.62,0:08:43.62,Default,,0,0,0,,Ах! Шонбен Шонбен...!
Dialogue: 0,0:08:43.62,0:08:45.62,Default,,0,0,0,,Шонбен Шонбен...!
Dialogue: 0,0:08:45.62,0:08:47.62,Default,,0,0,0,,Онда тұрмаңыз!
Dialogue: 0,0:08:47.62,0:08:49.63,Default,,0,0,0,,Не? Дәретхана ана жақта!
Dialogue: 0,0:08:49.63,0:08:52.63,Default,,0,0,0,,Уау! Ағып жатыр, ағып жатыр!
Dialogue: 0,0:08:52.63,0:08:55.63,Default,,0,0,0,,Жарайды, Вегета, қалғанын істеймін.
Dialogue: 0,0:08:55.63,0:08:59.64,Default,,0,0,0,,Мен саған мына тәттілерді беремін.
Dialogue: 0,0:08:59.64,0:09:02.64,Default,,0,0,0,,Иә, Уис мырза.
Dialogue: 0,0:09:02.64,0:09:04.64,Default,,0,0,0,,Хехехе.
Dialogue: 0,0:09:04.64,0:09:06.58,Default,,0,0,0,,Сіз бізге қосылғыңыз келе ме, Професи Балық мырза?
Dialogue: 0,0:09:06.58,0:09:09.58,Default,,0,0,0,,Берус-самаға айтпа. (Балық пайғамбарлық) Иә!
Dialogue: 0,0:09:09.58,0:09:13.58,Default,,0,0,0,,Бұл да болжағандай болды ма?
Dialogue: 0,0:09:16.59,0:09:20.59,Default,,0,0,0,,Берус-сама ұйықтап жатыр. Қатты дыбыс шығармаңыз, тыныш болыңыз.
Dialogue: 0,0:09:20.59,0:09:22.59,Default,,0,0,0,,О, ой.
Dialogue: 0,0:09:22.59,0:09:25.60,Default,,0,0,0,,Берус-сама ұйықтайтын жер осы ма?
Dialogue: 0,0:09:25.60,0:09:28.60,Default,,0,0,0,,Бұл жерде біртүрлі нәрсе бар.
Dialogue: 0,0:09:34.60,0:09:37.61,Default,,0,0,0,,Бұл жыланға ұқсайтын алып мүсін қандай?
Dialogue: 0,0:09:37.61,0:09:39.61,Default,,0,0,0,,Мен білмеймін. Бір→ бар
Dialogue: 0,0:09:39.61,0:09:42.61,Default,,0,0,0,,Құм сағатта не көріп тұрсың? (Вегета) Бұл оятқыш. →
Dialogue: 0,0:09:42.61,0:09:46.61,Default,,0,0,0,,Оған қол тигізбеңіз! Ол жарылып кетеді! Хмм.
Dialogue: 0,0:09:48.62,0:10:02.63,Default,,0,0,0,,
Dialogue: 0,0:10:02.63,0:10:05.65,Default,,0,0,0,,Беерус-сама да жат жерде ұйықтап жатыр.
Dialogue: 0,0:10:05.65,0:10:07.57,Default,,0,0,0,,Тезірек киіңіз!
Dialogue: 0,0:10:07.57,0:10:09.57,Default,,0,0,0,,Мен... Мен! ?
Dialogue: 0,0:10:09.57,0:10:11.58,Default,,0,0,0,,Сіз мұны жаттығуға киесіз бе?
Dialogue: 0,0:10:11.58,0:10:13.58,Default,,0,0,0,,Бұл тамаша емес.
Dialogue: 0,0:10:13.58,0:10:17.58,Default,,0,0,0,,Сәлем! Алдымен Беерус-саманың жаймалары мен көрпелерін ауыстырайық.
Dialogue: 0,0:10:17.58,0:10:19.58,Default,,0,0,0,,Парақтар мен көрпелер?
Dialogue: 0,0:10:19.58,0:10:22.59,Default,,0,0,0,,Жарайсың ба? Берус-саманы ешқашан оятпа.
Dialogue: 0,0:10:22.59,0:10:24.59,Default,,0,0,0,,Оянғанда көңіл-күйім ерекше.
Dialogue: 0,0:10:24.59,0:10:27.59,Default,,0,0,0,,Мені жаман оятсаң, өмірім кетеді!
Dialogue: 0,0:10:27.59,0:10:30.59,Default,,0,0,0,,​​Түсіндім.
Dialogue: 0,0:10:30.59,0:10:32.60,Default,,0,0,0,,Жарайды! Иччо...! Тынш!
Dialogue: 0,0:10:32.60,0:10:34.60,Default,,0,0,0,,Хмм….
Dialogue: 0,0:10:34.60,0:10:37.60,Default,,0,0,0,,Аузыңды жап! Қолымыздан келетін ештеңе жоқ па?
Dialogue: 0,0:10:37.60,0:10:42.61,Default,,0,0,0,,Ух... ммм...
Dialogue: 0,0:10:42.61,0:10:45.61,Default,,0,0,0,,Ақымақ! Жаман, жаман.
Dialogue: 0,0:10:45.61,0:10:48.61,Default,,0,0,0,,Бірақ, сіз жайма мен көрпелерді қалай ауыстырдыңыз?
Dialogue: 0,0:10:48.61,0:10:50.61,Default,,0,0,0,,Өз мүмкіндігіңізді күтіңіз.
Dialogue: 0,0:10:50.61,0:10:54.62,Default,,0,0,0,,Күтесің бе... Әй, мен ондайға жарамаймын.
Dialogue: 0,0:10:54.62,0:11:13.57,Default,,0,0,0,,♪♪~
Dialogue: 0,0:11:13.57,0:11:15.57,Default,,0,0,0,,Әлі емес пе?
Dialogue: 0,0:11:15.57,0:11:17.57,Default,,0,0,0,,Әлі жоқ.
Dialogue: 0,0:11:20.58,0:11:23.58,Default,,0,0,0,,≪Вегета! Әзірше емес!
Dialogue: 0,0:11:26.58,0:11:30.59,Default,,0,0,0,,Бетіне ақымақ болып ұйықтайды.
Dialogue: 0,0:11:30.59,0:11:32.59,Default,,0,0,0,,Сәлем...! Сол ақымақ!
Dialogue: 0,0:11:32.59,0:11:37.59,Default,,0,0,0,,Әй... Эй, Беерус-сама, мен сені мазалап жүрмін.
Dialogue: 0,0:11:39.60,0:11:41.60,Default,,0,0,0,,Уау~ Мен таң қалдым~!
Dialogue: 0,0:11:41.60,0:11:44.60,Default,,0,0,0,,Үніңді жауып күтесің бе?
Dialogue: 0,0:11:44.60,0:11:46.60,Default,,0,0,0,,Хахаха... Ах! ?
Dialogue: 0,0:11:49.61,0:11:53.61,Default,,0,0,0,,
Dialogue: 0,0:11:53.61,0:11:56.61,Default,,0,0,0,,Сіз ұйықтап жатырсыз ба? Ха...
Dialogue: 0,0:11:56.61,0:11:58.62,Default,,0,0,0,,Ауырды...
Dialogue: 0,0:11:58.62,0:12:01.62,Default,,0,0,0,,Мен сені соншалықты нашар ұйықтай аламын деп ойламаппын.
Dialogue: 0,0:12:01.62,0:12:03.62,Default,,0,0,0,,Оның үстіне оның керемет күші бар.
Dialogue: 0,0:12:03.62,0:12:05.64,Default,,0,0,0,,Ұйықтап жатқандықтан, мен саған жеңіл жүрмеймін.
Dialogue: 0,0:12:05.64,0:12:07.56,Default,,0,0,0,,Сонымен не істеуіміз керек?
Dialogue: 0,0:12:07.56,0:12:11.56,Default,,0,0,0,,Беерус-саманың бұрылу мүмкіндігі...
Dialogue: 0,0:12:11.56,0:12:14.56,Default,,0,0,0,,Ябе! Жарылу!
Dialogue: 0,0:12:17.57,0:12:21.57,Default,,0,0,0,,Бейшара Уис-сан. Бұл туралы бірдеңе жасаңыз.
Dialogue: 0,0:12:21.57,0:12:23.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:26.58,0:12:30.58,Default,,0,0,0,,Хохо... Бұл өте ерлік, солай емес пе?
Dialogue: 0,0:12:33.58,0:12:35.59,Default,,0,0,0,,Сіз одан құтыла алмайсыз!
Dialogue: 0,0:12:35.59,0:12:38.59,Default,,0,0,0,,Бұл толық финт.
Dialogue: 0,0:12:38.59,0:12:41.59,Default,,0,0,0,,Беерус-сама, сен шынымен ұйықтап жатырсың ба?
Dialogue: 0,0:12:41.59,0:12:43.59,Default,,0,0,0,,Иә!
Dialogue: 0,0:12:43.59,0:12:45.60,Default,,0,0,0,,Ол ешқандай қосымша күш бола алмайды.
Dialogue: 0,0:12:45.60,0:12:48.60,Default,,0,0,0,,Расында да, Беерус-сама, сен ояусың! ?
Dialogue: 0,0:12:48.60,0:12:52.60,Default,,0,0,0,,Тыныш болыңыз! Тек Берус-саманы көтеріңіз!
Dialogue: 0,0:12:54.60,0:12:56.61,Default,,0,0,0,,Керемет... Какарот!
Dialogue: 0,0:12:56.61,0:13:00.61,Default,,0,0,0,,Нунуну...!
Dialogue: 0,0:13:00.61,0:13:03.61,Default,,0,0,0,,Жақсы! Қазір!
Dialogue: 0,0:13:05.58,0:13:07.45,Default,,0,0,0,,Әлі емес...!
Dialogue: 0,0:13:07.45,0:13:09.45,Default,,0,0,0,,Нунуну...!
Dialogue: 0,0:13:09.45,0:13:12.45,Default,,0,0,0,,Өтінемін, асығыңыз...!
Dialogue: 0,0:13:14.46,0:13:16.46,Default,,0,0,0,,Бар!
Dialogue: 0,0:13:16.46,0:13:19.46,Default,,0,0,0,,Сіз оны әдейі баяу қабылдайсыз ба? ?
Dialogue: 0,0:13:19.46,0:13:21.46,Default,,0,0,0,,(сыралардың иіскеу дыбысы)
Dialogue: 0,0:13:21.46,0:13:24.47,Default,,0,0,0,,Иә, иә, Беерус-сама, бұл кептірілген сардина. →
Dialogue: 0,0:13:24.47,0:13:28.47,Default,,0,0,0,,Кептірілген сардина Кептірілген сардина ~. Бұл дәмді кептірілген сардина. →
Dialogue: 0,0:13:28.47,0:13:32.48,Default,,0,0,0,,Иә, сол күйінде қалдырыңыз. →
Dialogue: 0,0:13:32.48,0:13:34.48,Default,,0,0,0,,«Бұл мүлдем керісінше! Менің жайымды қарашы!»
Dialogue: 0,0:13:42.49,0:13:47.49,Default,,0,0,0,,Уау! Ол аурады...!
Dialogue: 0,0:13:47.49,0:13:49.49,Default,,0,0,0,,Аа...
Dialogue: 0,0:13:49.49,0:13:53.50,Default,,0,0,0,,Бұл жаймалар мен көрпелердің алмасуын аяқтайды.
Dialogue: 0,0:13:53.50,0:13:56.50,Default,,0,0,0,,Вегета, сен күнде осылай жаттығасың ба?
Dialogue: 0,0:13:56.50,0:13:58.50,Default,,0,0,0,,Жаттығу деп кім айтты?
Dialogue: 0,0:13:58.50,0:14:00.50,Default,,0,0,0,,Бұл жай ғана... →
Dialogue: 0,0:14:00.50,0:14:04.50,Default,,0,0,0,,Үй шаруашылығына көмек! Эх! ?
Dialogue: 0,0:15:47.68,0:15:50.68,Default,,0,0,0,,Вегета, сен неге үй шаруасына көмектесесің?
Dialogue: 0,0:15:50.68,0:15:52.68,Default,,0,0,0,,Бұл жаттығуға рұқсат берудің шарты.
Dialogue: 0,0:15:52.68,0:15:54.68,Default,,0,0,0,,Мен айтқандай, Какарот→
Dialogue: 0,0:15:54.68,0:15:57.69,Default,,0,0,0,,Үй көмегінің басқа да түрлері көп.
Dialogue: 0,0:15:57.69,0:16:00.69,Default,,0,0,0,,Уау! Бұл не нәрсе?
Dialogue: 0,0:16:00.69,0:16:02.69,Default,,0,0,0,,Бұл пайғамбарлық балықтың тостағаншасы. →
Dialogue: 0,0:16:02.69,0:16:04.69,Default,,0,0,0,,Әдемі болғанша бітпейді.
Dialogue: 0,0:16:04.69,0:16:07.70,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:16:07.70,0:16:10.70,Default,,0,0,0,,Ұнамаса, үйге қайт. Олай айтпа.
Dialogue: 0,0:16:14.70,0:16:17.71,Default,,0,0,0,,Эй, менің қарным ашты...
Dialogue: 0,0:16:17.71,0:16:19.71,Default,,0,0,0,,Тренинг үй жұмыстарына көмектескеннен кейін келеді.
Dialogue: 0,0:16:19.71,0:16:21.71,Default,,0,0,0,,Тренинг! ?
Dialogue: 0,0:16:21.71,0:16:25.72,Default,,0,0,0,,Мен Вегетаға дейін аяқтап, жаттығуға барамын.
Dialogue: 0,0:16:25.72,0:16:28.72,Default,,0,0,0,,Менен бұрын бітірсең! ?
Dialogue: 0,0:16:28.72,0:16:32.72,Default,,0,0,0,,Мен жеңілмеймін! Апыр-ай!
Dialogue: 0,0:16:32.72,0:16:34.72,Default,,0,0,0,,Куә!
Dialogue: 0,0:16:34.72,0:16:38.73,Default,,0,0,0,,Уау! →
Dialogue: 0,0:16:38.73,0:16:41.66,Default,,0,0,0,,Хахаха….
Dialogue: 0,0:16:41.66,0:16:45.67,Default,,0,0,0,,Ха... бітті...
Dialogue: 0,0:16:45.67,0:16:50.67,Default,,0,0,0,,Ертең қайтадан өседі. Ха! ?
Dialogue: 0,0:16:50.67,0:16:53.68,Default,,0,0,0,,Еңбектеріңіз үшін рахмет. Әдемі кесіп алды.
Dialogue: 0,0:16:53.68,0:16:57.68,Default,,0,0,0,,Олай болса, жаттығуымызды бастайық па?
Dialogue: 0,0:16:57.68,0:16:59.68,Default,,0,0,0,,Иә! Мен күттім!
Dialogue: 0,0:16:59.68,0:17:02.69,Default,,0,0,0,,Иә. Жаттығу болып жатыр дегенді естігенде, өзімді жақсы сезіндім.
Dialogue: 0,0:17:02.69,0:17:04.69,Default,,0,0,0,,Бұған дейін, Гоку-сан.
Dialogue: 0,0:17:04.69,0:17:07.69,Default,,0,0,0,,Мен сізге жаңа ги дайындадым.
Dialogue: 0,0:17:07.69,0:17:10.69,Default,,0,0,0,,Жаңа GI?
Dialogue: 0,0:17:10.69,0:17:14.70,Default,,0,0,0,,Мен оны Гоку-сан үшін арнайы әзірледім.
Dialogue: 0,0:17:14.70,0:17:18.70,Default,,0,0,0,,Мен Вегета-санға сәйкестендіруді ойладым, бірақ...
Dialogue: 0,0:17:18.70,0:17:21.70,Default,,0,0,0,,Вегетаның киімі оның сүйікті жары Булмадан →
Dialogue: 0,0:17:21.70,0:17:24.70,Default,,0,0,0,,Бұл сыйлық, бәрібір. (Вегета) Hmph.
Dialogue: 0,0:17:29.71,0:17:31.71,Default,,0,0,0,,Сіз қалай ойлайсыз?
Dialogue: 0,0:17:31.71,0:17:33.72,Default,,0,0,0,,Иә! Бұл жақсы сезінеді!
Dialogue: 0,0:17:33.72,0:17:35.72,Default,,0,0,0,,Рахмет, Уис мырза!
Dialogue: 0,0:17:35.72,0:17:38.72,Default,,0,0,0,,Хе... хе!
Dialogue: 0,0:17:38.72,0:17:41.66,Default,,0,0,0,,Сізге ұнағанына қуаныштымын.
Dialogue: 0,0:17:41.66,0:17:43.66,Default,,0,0,0,,Бастаймыз ба?
Dialogue: 0,0:17:45.66,0:17:48.66,Default,,0,0,0,,Жарайды, бастайық!
Dialogue: 0,0:17:52.67,0:17:55.67,Default,,0,0,0,,Қолыңды мына жігіттен өткізіп, жоғары көтересің бе?
Dialogue: 0,0:17:55.67,0:17:57.67,Default,,0,0,0,,Иә.
Dialogue: 0,0:17:57.67,0:17:59.68,Default,,0,0,0,,Жарайды, қараңызшы.
Dialogue: 0,0:17:59.68,0:18:03.68,Default,,0,0,0,,Yotto! Уау... уау….
Dialogue: 0,0:18:03.68,0:18:06.68,Default,,0,0,0,,Иә? Бұл ауыр, мен оны көтеруім керек ...
Dialogue: 0,0:18:06.68,0:18:09.69,Default,,0,0,0,,Бұл жеңіл болса жаттығу емес.
Dialogue: 0,0:18:09.69,0:18:12.69,Default,,0,0,0,,Гуджиджи...! (Вегета) Бұл тәтті, Какарот.
Dialogue: 0,0:18:12.69,0:18:15.69,Default,,0,0,0,,Бұны көтерудің айласы бар.
Dialogue: 0,0:18:15.69,0:18:20.70,Default,,0,0,0,,Қараңыз. Иә... уф...! Не! ?
Dialogue: 0,0:18:20.70,0:18:24.70,Default,,0,0,0,,Вегета-сан, бұл алдыңғысының салмағынан екі есе артық.
Dialogue: 0,0:18:24.70,0:18:26.70,Default,,0,0,0,,Не?! ?
Dialogue: 0,0:18:26.70,0:18:29.71,Default,,0,0,0,,Grrgh...!
Dialogue: 0,0:18:29.71,0:18:32.71,Default,,0,0,0,,Әлі емес пе?
Dialogue: 0,0:18:32.71,0:18:34.71,Default,,0,0,0,,Орындалды!
Dialogue: 0,0:18:34.71,0:18:38.71,Default,,0,0,0,,Тіпті Ола... раушан...!
Dialogue: 0,0:18:38.71,0:18:42.65,Default,,0,0,0,,Осы ғаламшарды айналып өт. Өтінемін жүгіріңіз.
Dialogue: 0,0:18:42.65,0:18:44.65,Default,,0,0,0,,Оны осылай қалдыру керек пе...?
Dialogue: 0,0:18:44.65,0:18:47.66,Default,,0,0,0,,Денемнің ауырлығы сонша, қозғала алмаймын...
Dialogue: 0,0:18:47.66,0:18:50.66,Default,,0,0,0,,Сәлем. Жүгірмесең жол жоғалады.
Dialogue: 0,0:18:50.66,0:18:53.66,Default,,0,0,0,,Уау! (Вегета) Уау!
Dialogue: 0,0:18:53.66,0:19:00.67,Default,,0,0,0,,Уф... (Вегета) Ааа...
Dialogue: 0,0:19:00.67,0:19:03.67,Default,,0,0,0,,Жолдан құлап қалсаңыз, басқа өлшемге лақтырасыз→
Dialogue: 0,0:19:03.67,0:19:06.68,Default,,0,0,0,,Сіз ешқашан орала алмайсыз.
Dialogue: 0,0:19:06.68,0:19:08.68,Default,,0,0,0,,Е! Қарғыс атқыр...
Dialogue: 0,0:19:08.68,0:19:16.69,Default,,0,0,0,,Уф... уф...!
Dialogue: 0,0:19:16.69,0:19:25.70,Default,,0,0,0,,♪♪~
Dialogue: 0,0:19:25.70,0:19:29.70,Default,,0,0,0,,Қарқын сәл тым жылдам ба?
Dialogue: 0,0:19:29.70,0:19:31.70,Default,,0,0,0,,Уақыты келді…
Dialogue: 0,0:19:33.70,0:19:38.71,Default,,0,0,0,,Күнде осылай қатты жаттығасыз ба...?
Dialogue: 0,0:19:38.71,0:19:40.73,Default,,0,0,0,,Ең қиыны бұл емес.
Dialogue: 0,0:19:40.73,0:19:42.65,Default,,0,0,0,,Ол адам ақыры келеді...!
Dialogue: 0,0:19:42.65,0:19:44.65,Default,,0,0,0,,Бұл не...?
Dialogue: 0,0:19:44.65,0:19:46.65,Default,,0,0,0,,Енді мен білдім... Эй.
Dialogue: 0,0:19:46.65,0:19:48.65,Default,,0,0,0,,Сіз мен күткеннен де көп тырысасыз.
Dialogue: 0,0:19:48.65,0:19:51.65,Default,,0,0,0,,Эй, эй...! (Вегета) А, аа...!
Dialogue: 0,0:19:51.65,0:19:53.66,Default,,0,0,0,,Уф... уф...!
Dialogue: 0,0:19:53.66,0:19:55.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:55.66,0:19:59.66,Default,,0,0,0,,(Балықтардың айқайы)
Dialogue: 0,0:19:59.66,0:20:03.67,Default,,0,0,0,,Whis~ Уақыт таяп қалды~!
Dialogue: 0,0:20:03.67,0:20:06.67,Default,,0,0,0,,Солай ма? Жарайды онда.
Dialogue: 0,0:20:09.67,0:20:12.68,Default,,0,0,0,,А... Иә? Мұнда...
Dialogue: 0,0:20:12.68,0:20:15.68,Default,,0,0,0,,Хмм…. Апыр-ай! Лорд Берус!
Dialogue: 0,0:20:15.68,0:20:19.68,Default,,0,0,0,,Нашар! Сіз осындай нәрсені жей аласыз ба?
Dialogue: 0,0:20:22.69,0:20:26.69,Default,,0,0,0,,
Dialogue: 0,0:20:28.69,0:20:31.69,Default,,0,0,0,,Хахаха... хаха....
Dialogue: 0,0:20:31.69,0:20:35.70,Default,,0,0,0,,Сіз әрең аман қалдыңыз ба? Тамаша болды.
Dialogue: 0,0:20:35.70,0:20:38.70,Default,,0,0,0,,Бүгінгі тренингке осының бәрі.
Dialogue: 0,0:20:38.70,0:20:40.67,Default,,0,0,0,,Мен шаршадым.
Dialogue: 0,0:20:40.67,0:20:44.54,Default,,0,0,0,,Вегета, сен, Беерус-саманың тынымсыз энергиясы→
Dialogue: 0,0:20:44.54,0:20:48.54,Default,,0,0,0,,Күнделікті дұрыс шомылу арқылы жақсы өмір сүре алдым.
Dialogue: 0,0:20:48.54,0:20:50.55,Default,,0,0,0,,Ола мен өлемін деп ойладым.
Dialogue: 0,0:20:50.55,0:20:52.55,Default,,0,0,0,,Қорқыныш сезінсеңіз, үйге қайтыңыз.
Dialogue: 0,0:20:52.55,0:20:54.55,Default,,0,0,0,,Бұл дұрыс емес.
Dialogue: 0,0:20:54.55,0:20:59.56,Default,,0,0,0,,Дегенмен жаттығу жақсырақ...
Dialogue: 0,0:20:59.56,0:21:02.56,Default,,0,0,0,,Мен үй шаруасына көмектесемін...
Dialogue: 0,0:21:02.56,0:21:07.56,Default,,0,0,0,,Мен ешқашан тазалау немесе соған ұқсас ештеңе жасаған емеспін...
Dialogue: 0,0:21:07.56,0:21:09.57,Default,,0,0,0,,Жақсы сөз айтып, босаңсығыңыз келсе де, →
Dialogue: 0,0:21:09.57,0:21:11.57,Default,,0,0,0,,Бұл дұрыс емес!
Dialogue: 0,0:21:11.57,0:21:14.57,Default,,0,0,0,,Мен сені ертең таңғы 6-да оятамын!
Dialogue: 0,0:21:14.57,0:21:16.57,Default,,0,0,0,,Цк.
Dialogue: 0,0:21:16.57,0:21:21.58,Default,,0,0,0,,Жаттығу тым қиын емес пе? →
Dialogue: 0,0:21:21.58,0:21:25.58,Default,,0,0,0,,Бұлай жалғаса берсе, бұл екеуі шынымен де өледі. →
Dialogue: 0,0:21:25.58,0:21:29.59,Default,,0,0,0,,Тым болмаса оны Супер Сайян немесе бірдеңе етіңіз.
Dialogue: 0,0:21:29.59,0:21:31.59,Default,,0,0,0,,Бұл жақсы емес.
Dialogue: 0,0:21:31.59,0:21:33.59,Default,,0,0,0,,Жоқ? Екі адамның деңгейі әлі →
Dialogue: 0,0:21:33.59,0:21:38.59,Default,,0,0,0,,Ақырында мен Құдайдың рухын сезіне алдым.
Dialogue: 0,0:21:38.59,0:21:41.63,Default,,0,0,0,,Егер ол құлып Құдайдың иелігінде болса→
Dialogue: 0,0:21:41.63,0:21:45.64,Default,,0,0,0,,Екеуінің күші осыншама.
Dialogue: 0,0:21:45.64,0:21:47.64,Default,,0,0,0,,Энергия деңгейіңізді барған сайын арттырыңыз →
Dialogue: 0,0:21:47.64,0:21:50.64,Default,,0,0,0,,Оның үстіне супер Сайян болу керек→
Dialogue: 0,0:21:50.64,0:21:54.64,Default,,0,0,0,,Мен күшейсем де, әлі де күшті екенімді білемін.
Dialogue: 0,0:21:54.64,0:21:58.65,Default,,0,0,0,,Арғы дүниені көре алмайсың. →
Dialogue: 0,0:21:58.65,0:22:01.65,Default,,0,0,0,,Мүмкін бұл екеуі де білетін шығар. →
Dialogue: 0,0:22:01.65,0:22:04.65,Default,,0,0,0,,Супер Сайян болмау керек→
Dialogue: 0,0:22:04.65,0:22:06.66,Default,,0,0,0,,Мен бір ауыз сөз айтқан жоқпын.
Dialogue: 0,0:22:06.66,0:22:08.66,Default,,0,0,0,,Хмм.
Dialogue: 0,0:22:08.66,0:22:11.66,Default,,0,0,0,,Маған бәрібір, бірақ мені өлтірме.
Dialogue: 0,0:22:11.66,0:22:13.66,Default,,0,0,0,,О, бұл әдеттен тыс.
Dialogue: 0,0:22:13.66,0:22:16.67,Default,,0,0,0,,Балық пайғамбар, екеуіңе алаңдап тұрсыңдар ма?
Dialogue: 0,0:22:16.67,0:22:19.67,Default,,0,0,0,,Ол келгеннен бері мен көп тағамдар жедім. →
Dialogue: 0,0:22:19.67,0:22:21.67,Default,,0,0,0,,Өлгеніңде ол жоқ.
Dialogue: 0,0:22:21.67,0:22:24.67,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:22:24.67,0:22:26.68,Default,,0,0,0,,Фалкооо!! Қайдасыңңң!!
Dialogue: 0,0:22:26.68,0:22:30.68,Default,,0,0,0,,《Мен Какароттан жеңілмеймін! 》
Dialogue: 0,0:22:30.68,0:22:32.68,Default,,0,0,0,,Бүгінгі тренинг сәл басқаша →
Dialogue: 0,0:22:32.68,0:22:35.69,Default,,0,0,0,,Маған серік болуға рұқсат етіңіз.
Dialogue: 0,0:22:35.69,0:22:38.69,Default,,0,0,0,,Сіз Уис-санмен күресе аласыз ба?
Dialogue: 0,0:22:38.69,0:22:40.67,Default,,0,0,0,,... бірінші рет.
Dialogue: 0,0:22:40.67,0:22:43.63,Default,,0,0,0,,Вегета, сен мұнда көптен бері келмедің→
Dialogue: 0,0:22:43.63,0:22:45.63,Default,,0,0,0,,Сіз Мистер Уиспен ешқашан ұрысып көрмедіңіз бе?
Dialogue: 0,0:22:45.63,0:22:48.63,Default,,0,0,0,,О, ешқашан.
Dialogue: 0,0:22:48.63,0:22:50.63,Default,,0,0,0,,Менің ойымша, ол әлі ондай деңгейде емес еді.
Dialogue: 0,0:22:50.63,0:22:52.64,Default,,0,0,0,,Не? Гоку →
Dialogue: 0,0:22:52.64,0:22:54.64,Default,,0,0,0,,Дұрыс айтасыз. (Вегета) Цк.
Dialogue: 0,0:22:54.64,0:22:57.64,Default,,0,0,0,,Бірақ Гоку бірдей.
Dialogue: 0,0:22:57.64,0:22:59.64,Default,,0,0,0,,Ора да? Иә.
Dialogue: 0,0:22:59.64,0:23:01.64,Default,,0,0,0,,Екі адам бір уақытта қоңырау шалса да→
Dialogue: 0,0:23:01.64,0:23:04.65,Default,,0,0,0,,Мен үшін ме, жоқ па. (Вегета/Гоку) Иә?
Dialogue: 0,0:23:04.65,0:23:08.65,Default,,0,0,0,,Сіз оны қолданып көргіңіз келе ме? (Вегета) Әрине.
Dialogue: 0,0:23:08.65,0:23:10.65,Default,,0,0,0,,Ааа! !
Dialogue: 0,0:23:10.65,0:23:14.66,Default,,0,0,0,,Оряря...! !
Dialogue: 0,0:23:14.66,0:23:16.66,Default,,0,0,0,,Урья! Эй!
Dialogue: 0,0:23:16.66,0:23:21.66,Default,,0,0,0,,Дораа! ! (Вегета) О, жоқ...!
Dialogue: 0,0:23:21.66,0:23:24.67,Default,,0,0,0,,Дораа!
Dialogue: 0,0:23:24.67,0:23:26.67,Default,,0,0,0,,Дадада...!
Dialogue: 0,0:23:26.67,0:23:29.67,Default,,0,0,0,,Урья! ! Иә тоқта.
Dialogue: 0,0:23:29.67,0:23:31.67,Default,,0,0,0,,Бұл мүлдем жеткіліксіз.
Dialogue: 0,0:23:31.67,0:23:35.68,Default,,0,0,0,,Өйткені олар ойлайды да, бастарымен әрекет етеді.
Dialogue: 0,0:23:35.68,0:23:38.68,Default,,0,0,0,,Бұл тенденция әсіресе Вегета үшін күшті.
Dialogue: 0,0:23:38.68,0:23:41.62,Default,,0,0,0,,Сонда жылдамдықтың шегі бар.
Dialogue: 0,0:23:41.62,0:23:46.62,Default,,0,0,0,,Бес сезім және оның жүйке арқылы мидан денеге өтетін уақыты →
Dialogue: 0,0:23:46.62,0:23:48.62,Default,,0,0,0,,Уақыт қажет.
Dialogue: 0,0:23:48.62,0:23:51.63,Default,,0,0,0,,Хаха. Вегета, әрине, солай.
Dialogue: 0,0:23:51.63,0:23:55.63,Default,,0,0,0,,Шулы! Сіз жай ғана ақымақ емессіз бе?
Dialogue: 0,0:23:55.63,0:23:58.63,Default,,0,0,0,,Денеңіздің әрбір мүшесі өз бетінше шешім қабылдайды →
Dialogue: 0,0:23:58.63,0:24:01.64,Default,,0,0,0,,Әрекет етер едім →
Dialogue: 0,0:24:01.64,0:24:03.64,Default,,0,0,0,,Бұл өте қиын.
Dialogue: 0,0:24:03.64,0:24:07.64,Default,,0,0,0,,Тіпті Беерус-сама әлі кемел емес.
Dialogue: 0,0:24:07.64,0:24:11.65,Default,,0,0,0,,Кез келген дағдарысты жеңуге болатын болса, оны болдырмауға болады.
Dialogue: 0,0:24:11.65,0:24:14.65,Default,,0,0,0,,Мистер Whis мұны істей ала ма?
Dialogue: 0,0:24:14.65,0:24:17.65,Default,,0,0,0,,Әрине. Бірақ Мистер Уис...
Dialogue: 0,0:24:17.65,0:24:19.66,Default,,0,0,0,,Нәжіске қадам бас.
Dialogue: 0,0:24:19.66,0:24:21.66,Default,,0,0,0,,Ах! ? Охохохо….
Dialogue: 0,0:24:21.66,0:24:25.66,Default,,0,0,0,,Аяқ киім сізді өз бетінше бағаламайды.
Dialogue: 0,0:24:25.66,0:24:28.66,Default,,0,0,0,,Сорбет-сама! Не?
Dialogue: 0,0:24:28.66,0:24:30.67,Default,,0,0,0,,Планета 448→
Dialogue: 0,0:24:30.67,0:24:34.67,Default,,0,0,0,,Жергілікті халықтың көтерілісі соншалықты күшейіп, шыдай алмайтын сияқты!
Dialogue: 0,0:24:34.67,0:24:37.67,Default,,0,0,0,,Не! ? Дегенмен, ол әлемдегі ең күшті → деп қорқатын
Dialogue: 0,0:24:37.67,0:24:39.68,Default,,0,0,0,,Фризаның армиясының таңдаулы мүшесі! ?
Dialogue: 0,0:24:39.68,0:24:41.61,Default,,0,0,0,,Көбірек әскер қосыңыз!
Dialogue: 0,0:24:41.61,0:24:43.61,Default,,0,0,0,,Біз басқа планеталарда да соғысамыз →
Dialogue: 0,0:24:43.61,0:24:46.62,Default,,0,0,0,,Тек бірнеше солдат жіберуге болады...
Dialogue: 0,0:24:46.62,0:24:48.62,Default,,0,0,0,,Уф... Шүкір!
Dialogue: 0,0:24:48.62,0:24:51.62,Default,,0,0,0,,Шегін! Оларды шегіндіріңіз! →
Dialogue: 0,0:24:51.62,0:24:55.62,Default,,0,0,0,,Уау! Ахх!
Dialogue: 0,0:24:57.63,0:25:00.63,Default,,0,0,0,,Чампа-сама, біз келдік.
Dialogue: 0,0:25:05.63,0:25:08.64,Default,,0,0,0,,Хмм... сөзсіз.
Dialogue: 0,0:25:08.64,0:25:11.64,Default,,0,0,0,,Мен ойлағандай. Вадос!
Dialogue: 0,0:25:11.64,0:25:13.64,Default,,0,0,0,,Тағы да? Кейде→
Dialogue: 0,0:25:13.64,0:25:16.65,Default,,0,0,0,,Егер сіз мұны өзіңіз жасай алсаңыз ше?
Dialogue: 0,0:25:16.65,0:25:18.65,Default,,0,0,0,,Тек орындаңыз!
Dialogue: 0,0:25:26.66,0:25:28.66,Default,,0,0,0,,Хмм... Өшірілген шығар.
Dialogue: 0,0:25:28.66,0:25:30.66,Default,,0,0,0,,Бұл басқаша болды.
Dialogue: 0,0:25:30.66,0:25:32.66,Default,,0,0,0,,Білсең, айт!
Dialogue: 0,0:25:32.66,0:25:34.66,Default,,0,0,0,,Айтсам да тыңдамайсың.
Dialogue: 0,0:25:34.66,0:25:36.66,Default,,0,0,0,,Келесі!
Dialogue: 0,0:25:45.67,0:25:55.67,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:47.67,0:26:49.67,Default,,0,0,0,,Сәлем! Ола Гоку!
Dialogue: 0,0:26:49.67,0:26:51.67,Default,,0,0,0,,Whis-san өте күшті!
Dialogue: 0,0:26:51.67,0:26:54.68,Default,,0,0,0,,Қазір мүлдем шыдай алмаймын→
Dialogue: 0,0:26:54.68,0:26:57.68,Default,,0,0,0,,Қатты жаттығып, күшті бол!
Dialogue: 0,0:26:57.68,0:27:01.68,Default,,0,0,0,,А? Дәл қазір біртүрлі болып тұр.
Dialogue: 0,0:27:01.68,0:27:05.69,Default,,0,0,0,,Бұл аздап ностальгиялық, бірақ өте жаман!
Dialogue: 0,0:27:05.69,0:27:08.69,Default,,0,0,0,,Келесі «Dragon Ball Super»
Dialogue: 0,0:27:11.69,0:27:13.69,Default,,0,0,0,,Міндетті түрде қарап шығу керек.
Dialogue: 0,0:27:15.19,0:27:21.19,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory