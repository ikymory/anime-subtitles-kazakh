Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:33.09,0:01:43.09,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:09.98,0:04:12.98,Default,,0,0,0,,<Жоятын Құдай Беруспен кескілескен шайқас>
Dialogue: 0,0:04:12.98,0:04:16.99,Default,,0,0,0,,<Вегета Гоку эволюциясының куәсі болды→
Dialogue: 0,0:04:16.99,0:04:21.99,Default,,0,0,0,,Оның өзі Құдай патшалығына жету үшін қатты жаттығады, бірақ...>
Dialogue: 0,0:04:21.99,0:04:27.00,Default,,0,0,0,,Мен Беерус-саманың қожайынымын.
Dialogue: 0,0:04:27.00,0:04:30.00,Default,,0,0,0,,<Булма Вегетаны құпия сақтады→
Dialogue: 0,0:04:30.00,0:04:33.00,Default,,0,0,0,,Дәмді кесе кеспенің бар екендігін ашу→
Dialogue: 0,0:04:33.00,0:04:38.01,Default,,0,0,0,,Маған оның қол астында жаттығуға рұқсат етілді>
Dialogue: 0,0:04:38.01,0:04:43.01,Default,,0,0,0,,<Ал жарты жылдан сәл астам уақыт өтті>
Dialogue: 0,0:04:58.03,0:05:01.03,Default,,0,0,0,,≪(Панның күлкісі)
Dialogue: 0,0:05:01.03,0:05:05.03,Default,,0,0,0,,≪Сәлемдесу~. (Видель) Хехехехе.
Dialogue: 0,0:05:06.97,0:05:10.97,Default,,0,0,0,,Ол Пан Чанның атасы. →
Dialogue: 0,0:05:10.97,0:05:14.98,Default,,0,0,0,,Жоқ, жоқ... Баа! (Пан күледі)
Dialogue: 0,0:05:14.98,0:05:18.98,Default,,0,0,0,,Баа. Баа~. Баа! (Пан күледі)
Dialogue: 0,0:05:18.98,0:05:21.99,Default,,0,0,0,,Пан-чан, ұйықтайтын уақыт та қалды.
Dialogue: 0,0:05:21.99,0:05:23.99,Default,,0,0,0,,Баа! (Пан күледі)
Dialogue: 0,0:05:23.99,0:05:25.99,Default,,0,0,0,,Әке. Баа~.
Dialogue: 0,0:05:25.99,0:05:29.99,Default,,0,0,0,,Әке! иә?
Dialogue: 0,0:05:29.99,0:05:32.99,Default,,0,0,0,,А... А...
Dialogue: 0,0:05:35.00,0:05:37.00,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:05:37.00,0:05:39.00,Default,,0,0,0,,Қайтадан қош келдіңіз. Конференция қалай өтті?
Dialogue: 0,0:05:39.00,0:05:42.01,Default,,0,0,0,,А... иә. (Пан күледі)
Dialogue: 0,0:05:42.01,0:05:45.01,Default,,0,0,0,,Жоғары жоғары! Мен істеп жатырмын.
Dialogue: 0,0:05:45.01,0:05:48.01,Default,,0,0,0,,Гоханға келетін болсақ...
Dialogue: 0,0:05:48.01,0:05:50.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:50.01,0:05:53.02,Default,,0,0,0,,Кейде ол Пан Чанның мейірімді әкесі.
Dialogue: 0,0:05:53.02,0:05:57.02,Default,,0,0,0,,Кейде мен үлкен ғалыммын.
Dialogue: 0,0:05:57.02,0:06:00.02,Default,,0,0,0,,Бірақ оның шынайы тұлғасы қандай?
Dialogue: 0,0:06:05.03,0:06:08.03,Default,,0,0,0,,Жер бетіндегі тыныштықты қорғайтын жауынгер!
Dialogue: 0,0:06:09.97,0:06:12.97,Default,,0,0,0,,Ұлы Сайяман!
Dialogue: 0,0:06:14.97,0:06:16.97,Default,,0,0,0,,О...
Dialogue: 0,0:06:16.97,0:06:21.98,Default,,0,0,0,,Шайтан Пан-чанның жүрегін ұрлайды! Мына Ұлы Сайяман менің қарсыласым.
Dialogue: 0,0:06:21.98,0:06:24.98,Default,,0,0,0,,шықты. Мен бүгін шешемін!
Dialogue: 0,0:06:24.98,0:06:28.99,Default,,0,0,0,,Кеттік, Шайтан! Алақай! Хамф!
Dialogue: 0,0:06:28.99,0:06:32.99,Default,,0,0,0,,Ха! көзқарас!
Dialogue: 0,0:06:32.99,0:06:39.00,Default,,0,0,0,,Бір қолмен жасау шынымен қиын ба? Егер солай болса, бұл туралы не айтасыз!
Dialogue: 0,0:06:39.00,0:06:44.00,Default,,0,0,0,,Жоқ! ? Тея! Татата!
Dialogue: 0,0:06:44.00,0:06:46.00,Default,,0,0,0,,Ойнайық. Әйтеуір біз пианисттер ғой.
Dialogue: 0,0:06:46.00,0:06:50.01,Default,,0,0,0,,Шайтан ата - Пан-чанның сүйіктісі.
Dialogue: 0,0:06:50.01,0:06:53.01,Default,,0,0,0,,Мен мұны істеймін... Хмф!
Dialogue: 0,0:06:53.01,0:06:55.01,Default,,0,0,0,,Иә! (Пан күледі)
Dialogue: 0,0:06:55.01,0:06:58.02,Default,,0,0,0,,Ах! ? Йотто.
Dialogue: 0,0:06:58.02,0:07:02.02,Default,,0,0,0,,Хаха! Гоханның әкесінің махаббаты кәрі Шайтан сияқты, бірақ →
Dialogue: 0,0:07:02.02,0:07:06.04,Default,,0,0,0,,Сіз оны жеңе алмайсыз! Не? мұнара!
Dialogue: 0,0:07:06.04,0:07:09.96,Default,,0,0,0,,Күн сайын мен одан шаршамаймын.
Dialogue: 0,0:07:09.96,0:07:12.96,Default,,0,0,0,,Видель Мен Пан-чанды көруге келдім.
Dialogue: 0,0:07:12.96,0:07:14.97,Default,,0,0,0,,≪(Гохан мен оның достары шулайды) Иә?
Dialogue: 0,0:07:14.97,0:07:16.97,Default,,0,0,0,,Иә! көзқарас! (Пан күледі)
Dialogue: 0,0:07:16.97,0:07:18.97,Default,,0,0,0,,Жақсы! ?
Dialogue: 0,0:07:18.97,0:07:21.97,Default,,0,0,0,,Тей! Таа! Хмф! Тория!
Dialogue: 0,0:07:21.97,0:07:25.98,Default,,0,0,0,,Не істеп жатырсың?! !
Dialogue: 0,0:07:25.98,0:07:29.98,Default,,0,0,0,,Иә? Апыр-ай!
Dialogue: 0,0:07:31.98,0:07:34.98,Default,,0,0,0,,Ах…. (Пан күледі)
Dialogue: 0,0:07:36.99,0:07:40.99,Default,,0,0,0,,Анашым, маған кенет қоңырау шалмаңыз.
Dialogue: 0,0:07:40.99,0:07:42.99,Default,,0,0,0,,Бұл қауіпті емес пе! Иә иә.
Dialogue: 0,0:07:42.99,0:07:45.99,Default,,0,0,0,,Қайсысы қауіпті?
Dialogue: 0,0:07:48.00,0:07:52.00,Default,,0,0,0,,Басын да ұстай алмайтын нәрестені лақтыр.
Dialogue: 0,0:07:52.00,0:07:57.01,Default,,0,0,0,,Жарайды. Бұл қорқынышты болды ма?
Dialogue: 0,0:07:57.01,0:08:00.01,Default,,0,0,0,,Пан қазірдің өзінде орналасты →
Dialogue: 0,0:08:00.01,0:08:04.01,Default,,0,0,0,,Менде Сайян қаны бар, сондықтан мен мұнымен жақсымын.
Dialogue: 0,0:08:04.01,0:08:05.98,Default,,0,0,0,,Иә.
Dialogue: 0,0:08:05.98,0:08:07.85,Default,,0,0,0,,Менің айтайын дегенім осы!
Dialogue: 0,0:08:07.85,0:08:10.85,Default,,0,0,0,,Сәби кезімнен төбелесуден басқаны көрсетпе→
Dialogue: 0,0:08:10.85,0:08:14.86,Default,,0,0,0,,Гоку сияқты төбелесші ақымақ болып кетсең не істер едің?
Dialogue: 0,0:08:14.86,0:08:16.86,Default,,0,0,0,,Пан-чан үшін→
Dialogue: 0,0:08:16.86,0:08:19.86,Default,,0,0,0,,Мен сенің ақкөңіл, әдепті қыз болғаныңды қалаймын.
Dialogue: 0,0:08:19.86,0:08:22.87,Default,,0,0,0,,Мейірімді және әйелдік?
Dialogue: 0,0:08:22.87,0:08:25.87,Default,,0,0,0,,Мен сіздің сөзіңізді қайтарып жатқан сияқтымын, Чичи-сан.
Dialogue: 0,0:08:25.87,0:08:28.87,Default,,0,0,0,,Мен Пан-чанның ұлы жекпе-жек суретшісі болғанын қалаймын→
Dialogue: 0,0:08:28.87,0:08:33.88,Default,,0,0,0,,Сіз менің орныма түсесіз.
Dialogue: 0,0:08:33.88,0:08:35.88,Default,,0,0,0,,Сіз жекпе-жек шеберісіз бе?
Dialogue: 0,0:08:35.88,0:08:38.88,Default,,0,0,0,,Онда менің және Гоханның қаны бар!
Dialogue: 0,0:08:38.88,0:08:41.89,Default,,0,0,0,,Пан-чанда ондай талант бар.
Dialogue: 0,0:08:41.89,0:08:43.89,Default,,0,0,0,,Жер бетіндегі ең жақсы жекпе-жек шебері бол→
Dialogue: 0,0:08:43.89,0:08:47.89,Default,,0,0,0,,Ол жүздеген шәкіртті...
Dialogue: 0,0:08:47.89,0:08:50.89,Default,,0,0,0,,Сенің бұл баланы бастан кешіретін ойың жоқ!
Dialogue: 0,0:08:50.89,0:08:53.90,Default,,0,0,0,,Міне... болды! ? (Шайтан Чичи) Ку~.
Dialogue: 0,0:08:53.90,0:08:56.90,Default,,0,0,0,,Біраз күтіңіздер, екеуің де.
Dialogue: 0,0:08:56.90,0:09:00.90,Default,,0,0,0,,Жоқ, мен күте алмаймын! Гоку ақыры түсінді →
Dialogue: 0,0:09:00.90,0:09:03.91,Default,,0,0,0,,Сондықтан да шындап жұмыс істеу керек.
Dialogue: 0,0:09:03.91,0:09:08.91,Default,,0,0,0,,Кім не десе де, мен сенің жекпе-жек шебері болуына жол бермеймін!
Dialogue: 0,0:09:16.95,0:09:20.95,Default,,0,0,0,,Аа... Оны жақсы өсіріңіз.
Dialogue: 0,0:09:23.96,0:09:25.96,Default,,0,0,0,,[Сөйлеуші] (Ер адам) Жай ғана кесіп тастауға бола ма?
Dialogue: 0,0:09:25.96,0:09:29.97,Default,,0,0,0,,Иә. Маған сенің шашыңды сәл реттеп алсаң болғаны.
Dialogue: 0,0:09:29.97,0:09:32.97,Default,,0,0,0,,Хахаха! →
Dialogue: 0,0:09:32.97,0:09:35.97,Default,,0,0,0,,Хахахаха…
Dialogue: 0,0:09:35.97,0:09:37.98,Default,,0,0,0,,Жарайды, мен саған сағат 1-де хабарласамын.
Dialogue: 0,0:09:37.98,0:09:39.98,Default,,0,0,0,,[Үндеткіш] (кесілген дыбыс) Иә?
Dialogue: 0,0:09:39.98,0:09:41.98,Default,,0,0,0,,Ах!
Dialogue: 0,0:09:43.98,0:09:46.98,Default,,0,0,0,,Не? не? Не~! ?
Dialogue: 0,0:09:46.98,0:09:48.98,Default,,0,0,0,,Э? Естімеймін.
Dialogue: 0,0:09:52.99,0:09:55.99,Default,,0,0,0,,Амансың ба? (Еркектер) Уау!
Dialogue: 0,0:09:55.99,0:10:00.00,Default,,0,0,0,,Менің көлігімде...→
Dialogue: 0,0:10:00.00,0:10:02.00,Default,,0,0,0,,Не істеп жатырсың!
Dialogue: 0,0:10:02.00,0:10:05.00,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:10:05.00,0:10:07.94,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:10:07.94,0:10:09.94,Default,,0,0,0,,Иә? (Ер) Иә?
Dialogue: 0,0:10:09.94,0:10:15.94,Default,,0,0,0,,Менің көлігіме зақым келтіруге кінәлі екеніңізді түсініңіз!
Dialogue: 0,0:10:20.95,0:10:22.95,Default,,0,0,0,,Эх! ?
Dialogue: 0,0:10:24.96,0:10:26.96,Default,,0,0,0,,Соғыс күші жағынан олар сөзсіз сенімді.
Dialogue: 0,0:10:26.96,0:10:29.96,Default,,0,0,0,,Тоқта! (Ичи) Ә? Мұнда ма?
Dialogue: 0,0:10:29.96,0:10:32.96,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:41.97,0:10:43.97,Default,,0,0,0,,Хамф!
Dialogue: 0,0:10:43.97,0:10:46.98,Default,,0,0,0,,≪Бұл қауіпті, Бұлма-сан. иә?
Dialogue: 0,0:10:46.98,0:10:49.98,Default,,0,0,0,,Бұл үлкен апат дерлік.
Dialogue: 0,0:10:49.98,0:10:52.98,Default,,0,0,0,,Криллин!
Dialogue: 0,0:10:52.98,0:10:55.99,Default,,0,0,0,,көремін. Мен полиция қызметкері емтиханын тапсырдым.
Dialogue: 0,0:10:55.99,0:11:01.99,Default,,0,0,0,,Иә. Мен екі рет құладым. Бұл тамаша. Құттықтаймыз.
Dialogue: 0,0:11:01.99,0:11:03.99,Default,,0,0,0,,Рахмет. ...Жоқ!
Dialogue: 0,0:11:03.99,0:11:06.93,Default,,0,0,0,,Ынтымақтастық үшін рахмет→
Dialogue: 0,0:11:06.93,0:11:08.93,Default,,0,0,0,,Сен мұндай қауіпті әрекет жасай алмайсың!
Dialogue: 0,0:11:08.93,0:11:12.94,Default,,0,0,0,,Хмф! Мен сұлулық салонына барамын, себебі қыздың мазасын аламын →
Dialogue: 0,0:11:12.94,0:11:15.94,Default,,0,0,0,,Әділдік орнады.
Dialogue: 0,0:11:15.94,0:11:18.94,Default,,0,0,0,,Бұл мүлдем әділдік емес.
Dialogue: 0,0:11:18.94,0:11:23.95,Default,,0,0,0,,Әдеттегідей. иә. Бұл не?
Dialogue: 0,0:11:23.95,0:11:26.95,Default,,0,0,0,,Жылдамдықты арттыру және қауіпті көлік жүргізу үшін айыппұл.
Dialogue: 0,0:11:26.95,0:11:28.95,Default,,0,0,0,,Иә! ?
Dialogue: 0,0:11:28.95,0:11:30.95,Default,,0,0,0,,Тек бас тартыңыз! [ТЕЛ]
Dialogue: 0,0:11:30.95,0:11:32.96,Default,,0,0,0,,Эй, бұл неге...?
Dialogue: 0,0:11:32.96,0:11:35.96,Default,,0,0,0,,Криллин, тыңдап тұрсың ба? Иә... Гохан.
Dialogue: 0,0:11:35.96,0:11:40.96,Default,,0,0,0,,Иә. иә? Түсіндім, мен бірден кетемін.
Dialogue: 0,0:11:40.96,0:11:43.97,Default,,0,0,0,,Сіз қалай ойлайсыз? Хмм….
Dialogue: 0,0:11:43.97,0:11:45.97,Default,,0,0,0,,≪ (Шайтан/Гохан) Иә?
Dialogue: 0,0:11:45.97,0:11:48.97,Default,,0,0,0,,Әке, мен сені алып келдім.
Dialogue: 0,0:11:48.97,0:11:50.97,Default,,0,0,0,,Мен өзімді тосқауыл қойдым! ?
Dialogue: 0,0:11:50.97,0:11:54.98,Default,,0,0,0,,Иә. «Мен сендерге нанды қалдыра алмаймын», - деді ол.
Dialogue: 0,0:11:54.98,0:11:59.98,Default,,0,0,0,,Жоқ, бұл ұят! Мен де тым көп айттым...
Dialogue: 0,0:11:59.98,0:12:03.99,Default,,0,0,0,,Хмф! Менің ойымша, мен әкелерге бұл туралы аздап ойлануға мәжбүр етемін.
Dialogue: 0,0:12:03.99,0:12:06.01,Default,,0,0,0,,Күрсіну….
Dialogue: 0,0:12:06.01,0:12:08.93,Default,,0,0,0,,Видель не істегісі келеді? (Видель) Иә?
Dialogue: 0,0:12:08.93,0:12:12.93,Default,,0,0,0,,Нанның болашағы. Ола сіздің одақтасыңыз. →
Dialogue: 0,0:12:12.93,0:12:17.93,Default,,0,0,0,,Видель нанның қалай өсетінін шешуге уақыт бөлуі керек.
Dialogue: 0,0:12:17.93,0:12:21.94,Default,,0,0,0,,Ах... күрсін...
Dialogue: 0,0:12:21.94,0:12:23.94,Default,,0,0,0,,Оның бар болуы өзі бір қорқыныш ретінде қарастырылады ➡
Dialogue: 0,0:12:23.94,0:12:27.94,Default,,0,0,0,,Чи-Чиге шығуын айта аласыз ба?
Dialogue: 0,0:12:27.94,0:12:31.95,Default,,0,0,0,,Эй... Мен бұл Чи-Чиге жақсы емеспін.
Dialogue: 0,0:12:31.95,0:12:33.95,Default,,0,0,0,,Криллин-сан, өтінемін.
Dialogue: 0,0:12:33.95,0:12:38.96,Default,,0,0,0,,Иә... солай айтсаң да.
Dialogue: 0,0:12:38.96,0:12:41.96,Default,,0,0,0,,Мен сені сендіремін. (Барлығы) иә?
Dialogue: 0,0:12:41.96,0:12:43.96,Default,,0,0,0,,Бұлма-сан!
Dialogue: 0,0:12:43.96,0:12:47.96,Default,,0,0,0,,Оның орнына жылдамдықты арттыру билетін елемеңіз.
Dialogue: 0,0:12:47.96,0:12:49.97,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:12:49.97,0:12:52.97,Default,,0,0,0,,Полиция шеше алмайтын мәселелерді шешеміз →
Dialogue: 0,0:12:52.97,0:12:55.97,Default,,0,0,0,,Әрине, солай ма? Жоқ!
Dialogue: 0,0:12:55.97,0:12:57.97,Default,,0,0,0,,Түсіндім! Сараң!
Dialogue: 0,0:12:59.98,0:13:01.98,Default,,0,0,0,,Чичи-сан, тыңдап тұрсың ба? Блумерлер.
Dialogue: 0,0:13:01.98,0:13:04.98,Default,,0,0,0,,≪(шу)
Dialogue: 0,0:13:06.92,0:13:09.92,Default,,0,0,0,,≪(шу)
Dialogue: 0,0:13:11.92,0:13:14.93,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:14.93,0:13:18.93,Default,,0,0,0,,Дұрыс. Жігіт кекештенгенде, ол үнемі кездейсоқ нәрселерді айтады →
Dialogue: 0,0:13:18.93,0:13:22.93,Default,,0,0,0,,Бұл мені қатты мазалайды! Мен жасадым.
Dialogue: 0,0:13:22.93,0:13:25.94,Default,,0,0,0,,Сайяндар арасында үйреншікті нәрсе ме, әлде бір нәрсе ме, білмеймін →
Dialogue: 0,0:13:25.94,0:13:28.94,Default,,0,0,0,,Транкс туылған болса да, оны елеме! Оны елемеу!
Dialogue: 0,0:13:28.94,0:13:31.94,Default,,0,0,0,,Сайандар достарымыздың басынан өткерген қиындықтарын түсіне алмайды.
Dialogue: 0,0:13:31.94,0:13:33.94,Default,,0,0,0,,Сәлем, Видель. →
Dialogue: 0,0:13:33.94,0:13:36.95,Default,,0,0,0,,Бұл баланың да Саян қаны бар→
Dialogue: 0,0:13:36.95,0:13:38.95,Default,,0,0,0,,Жекпе-жек шеберлерінің жолға қарсылығы жоқ па?
Dialogue: 0,0:13:38.95,0:13:42.95,Default,,0,0,0,,Жарайды... Өйткені мен жекпе-жек шебері болдым →
Dialogue: 0,0:13:42.95,0:13:45.96,Default,,0,0,0,,Өйткені мен Гохан-кунмен кездесе алдым. (Чичи Булма) Иә, иә.
Dialogue: 0,0:13:45.96,0:13:49.96,Default,,0,0,0,,Қыздарға тән нәрселерге сүйсінген кездерім болды→
Dialogue: 0,0:13:49.96,0:13:52.96,Default,,0,0,0,,Бұл жақсы. Мен осы бала үшін →
Dialogue: 0,0:13:52.96,0:13:55.97,Default,,0,0,0,,Мен сенің өзің қалағандай өскеніңді қалаймын.
Dialogue: 0,0:13:55.97,0:14:00.97,Default,,0,0,0,,Тамақ бергеніңіз үшін рахмет. Чичи-сан. Пан Чан жақсы.
Dialogue: 0,0:14:00.97,0:14:03.97,Default,,0,0,0,,Гохан-кун тамаша ғалым болды→
Dialogue: 0,0:14:03.97,0:14:07.98,Default,,0,0,0,,Немерең де дұрыс жұмыс істеп жатыр, солай ма?
Dialogue: 0,0:14:07.98,0:14:11.98,Default,,0,0,0,,Менің күйеуім Whis мырзада →
Dialogue: 0,0:14:11.98,0:14:13.98,Default,,0,0,0,,«Мен жаттығудамын!» және кетті →
Dialogue: 0,0:14:13.98,0:14:17.99,Default,,0,0,0,,Оның Жерге оралмағанына жарты жылдан асты.
Dialogue: 0,0:14:17.99,0:14:21.99,Default,,0,0,0,,<<Қандай болса да~! ? (3 адам) Уау!
Dialogue: 0,0:14:25.00,0:14:28.00,Default,,0,0,0,,Вегета Жерге жарты жылдан астам уақыт оралмады →
Dialogue: 0,0:14:28.00,0:14:33.00,Default,,0,0,0,,Не айтып тұрсың! ? Ах... ой. Мен мұны айтпадым ба?
Dialogue: 0,0:14:33.00,0:14:37.01,Default,,0,0,0,,Мен Whis-ке жаттығуға барамын. иә! ?
Dialogue: 0,0:14:37.01,0:14:40.01,Default,,0,0,0,,Жаттығу үшін Whis-sanға барыңыз! ?
Dialogue: 0,0:16:23.15,0:16:25.15,Default,,0,0,0,,Мен мұны білмедім...
Dialogue: 0,0:16:25.15,0:16:28.15,Default,,0,0,0,,Вис-сан Берустың қожайыны болған.
Dialogue: 0,0:16:28.15,0:16:31.15,Default,,0,0,0,,Мен олай көрмедім.
Dialogue: 0,0:16:31.15,0:16:37.16,Default,,0,0,0,,``Талантты сұңқар тырнағын жасырады.'' Жекпе-жек шебері осындай. Иә.
Dialogue: 0,0:16:37.16,0:16:41.16,Default,,0,0,0,,Сәлем, Бұлма. Мистер Вис, сіз Жерге қашан келдіңіз?
Dialogue: 0,0:16:41.16,0:16:45.17,Default,,0,0,0,,Мен саған Уис-санмен де жаттығуға рұқсат етемін.
Dialogue: 0,0:16:45.17,0:16:48.17,Default,,0,0,0,,Иә. Мен мұнда біраз уақыт бұрын келдім →
Dialogue: 0,0:16:48.17,0:16:52.18,Default,,0,0,0,,Келесісі бір-екі айдан кейін келеді...
Dialogue: 0,0:16:52.18,0:16:54.18,Default,,0,0,0,,Көп күтпе!
Dialogue: 0,0:16:54.18,0:16:57.18,Default,,0,0,0,,Сізбен байланысудың қандай да бір жолы бар ма?
Dialogue: 0,0:16:57.18,0:17:00.18,Default,,0,0,0,,Гоку! Не айтқың келеді?
Dialogue: 0,0:17:00.18,0:17:05.19,Default,,0,0,0,,Ұлым мен оның әйелінің үйінің қабырғасын жыртып жаттығу керек пе?
Dialogue: 0,0:17:05.19,0:17:09.19,Default,,0,0,0,,О, мен сені кешірмеймін. ауа….
Dialogue: 0,0:17:09.19,0:17:13.20,Default,,0,0,0,,Шынымен де көмектесу мүмкін емес, қария.
Dialogue: 0,0:17:13.20,0:17:15.20,Default,,0,0,0,,Гоку.
Dialogue: 0,0:17:15.20,0:17:18.13,Default,,0,0,0,,Біз тек Вегетаның киін білуіміз керек емес пе?
Dialogue: 0,0:17:18.13,0:17:22.14,Default,,0,0,0,,Егер сіз энергияны жинай алсаңыз, телепорттауға болады, солай ма?
Dialogue: 0,0:17:22.14,0:17:25.14,Default,,0,0,0,,Әй, күлшіл, күлшіл.
Dialogue: 0,0:17:33.15,0:17:38.15,Default,,0,0,0,,Жоқ. Мен түсінбеймін. Тым алыс па?
Dialogue: 0,0:17:38.15,0:17:41.15,Default,,0,0,0,,Менің күтуден басқа амалым жоқ...
Dialogue: 0,0:17:43.16,0:17:47.16,Default,,0,0,0,,Мистер Вис туралы не деуге болады? Ал... әлі жоқ!
Dialogue: 0,0:17:49.17,0:17:52.17,Default,,0,0,0,,Келдің бе? Ха! ? Эй, эй!
Dialogue: 0,0:17:52.17,0:17:54.17,Default,,0,0,0,,≪(Жарылыс дыбысы) Иә?
Dialogue: 0,0:17:57.17,0:18:00.18,Default,,0,0,0,,Мистер Вис туралы не деуге болады?
Dialogue: 0,0:18:00.18,0:18:02.18,Default,,0,0,0,,Немересі….
Dialogue: 0,0:18:02.18,0:18:05.18,Default,,0,0,0,,Уау!
Dialogue: 0,0:18:05.18,0:18:07.18,Default,,0,0,0,,Иә, бұл. →
Dialogue: 0,0:18:07.18,0:18:09.19,Default,,0,0,0,,Мистер Уис келгенде хабарласамын.
Dialogue: 0,0:18:09.19,0:18:11.19,Default,,0,0,0,,Мен оны сізге әкелу үшін барын салдым→
Dialogue: 0,0:18:11.19,0:18:15.19,Default,,0,0,0,,Рахмет! Маған міндетті түрде хабарласыңыз.
Dialogue: 0,0:18:15.19,0:18:17.13,Default,,0,0,0,,Жарайды, міне. Бағасы 12 доллар болады.
Dialogue: 0,0:18:17.13,0:18:21.13,Default,,0,0,0,,Бұл ақшаны не үшін алып жатырсың?
Dialogue: 0,0:18:21.13,0:18:24.13,Default,,0,0,0,,А... мынау... Нан үшін →
Dialogue: 0,0:18:24.13,0:18:27.14,Default,,0,0,0,,Гоханға айтпай, тосын кеш ұйымдастырыңыз→
Dialogue: 0,0:18:27.14,0:18:31.14,Default,,0,0,0,,Өйткені Бұлма осылай дейді. Бұл контакт үшін.
Dialogue: 0,0:18:31.14,0:18:34.14,Default,,0,0,0,,Хмм….
Dialogue: 0,0:18:34.14,0:18:38.15,Default,,0,0,0,,Түсіндім! Гоку да жақсы қарт.
Dialogue: 0,0:18:38.15,0:18:42.15,Default,,0,0,0,,Ах... а. Бұл дұрыс... дұрыс.
Dialogue: 0,0:18:42.15,0:18:45.15,Default,,0,0,0,,Неліктен жаттығуларыңыз туралы дұрыс айтпадыңыз?
Dialogue: 0,0:18:45.15,0:18:47.15,Default,,0,0,0,,Ал...
Dialogue: 0,0:18:50.16,0:18:52.16,Default,,0,0,0,,Ол келмейді.
Dialogue: 0,0:18:54.16,0:18:57.17,Default,,0,0,0,,Ол келмейді... ≪(Есіктің ашылған дыбысы)
Dialogue: 0,0:18:57.17,0:19:00.17,Default,,0,0,0,,Дәл қазір. Бұл сұралған сатып алу.
Dialogue: 0,0:19:00.17,0:19:03.17,Default,,0,0,0,,Бұл пайдалы. Рақмет сізге.
Dialogue: 0,0:19:03.17,0:19:06.18,Default,,0,0,0,,Гоку-сан, күріш.
Dialogue: 0,0:19:06.18,0:19:10.18,Default,,0,0,0,,Әке…. ау. А... аа.
Dialogue: 0,0:19:14.18,0:19:17.12,Default,,0,0,0,,Әке, не болды? Уау!
Dialogue: 0,0:19:17.12,0:19:20.12,Default,,0,0,0,,Жақында қызық болады. →
Dialogue: 0,0:19:20.12,0:19:23.13,Default,,0,0,0,,Гоку да жақсы қария.
Dialogue: 0,0:19:23.13,0:19:26.13,Default,,0,0,0,,《Аа...? Мен бұған сене алмадым…》
Dialogue: 0,0:19:28.13,0:19:32.14,Default,,0,0,0,,Ол келмейді... Иә?
Dialogue: 0,0:19:32.14,0:19:35.14,Default,,0,0,0,,[TEL] Міне осында!
Dialogue: 0,0:19:35.14,0:19:38.14,Default,,0,0,0,,Блумерлер? Иә. Иә.
Dialogue: 0,0:19:38.14,0:19:42.14,Default,,0,0,0,,Түсіндім! Жақсы.
Dialogue: 0,0:19:44.15,0:19:46.15,Default,,0,0,0,,Доги? Хмм.
Dialogue: 0,0:19:48.15,0:19:50.15,Default,,0,0,0,,Ха!
Dialogue: 0,0:19:56.16,0:20:00.16,Default,,0,0,0,,Бүгін не пісірерімді білмеймін... ≪Вис-сан!
Dialogue: 0,0:20:02.17,0:20:05.17,Default,,0,0,0,,Сәлем! О, Сон Гоку. →
Dialogue: 0,0:20:05.17,0:20:08.17,Default,,0,0,0,,Біраз уақыт өтті. екінші ойлар туралы ....
Dialogue: 0,0:20:08.17,0:20:13.18,Default,,0,0,0,,Вегета: Сіз Уис мырзамен бірге жаттығасыз ба?
Dialogue: 0,0:20:13.18,0:20:16.20,Default,,0,0,0,,Иә. Вегетаға →
Dialogue: 0,0:20:16.20,0:20:19.12,Default,,0,0,0,,Сіз маған өте дәмді тағамдарды үйреттіңіз.
Dialogue: 0,0:20:19.12,0:20:22.12,Default,,0,0,0,,Менің де сенімен бірге жаттығуымды қалайсың ба?
Dialogue: 0,0:20:22.12,0:20:24.12,Default,,0,0,0,,Аа...
Dialogue: 0,0:20:24.12,0:20:26.12,Default,,0,0,0,,Мен де Беерус-саманы көргеннен кейін күшейіп кеттім.
Dialogue: 0,0:20:26.12,0:20:30.12,Default,,0,0,0,,Эй, өтінемін, Мистер Уис. Дәл осылай!
Dialogue: 0,0:20:35.13,0:20:38.13,Default,,0,0,0,,Аа... Ештене етпейді.
Dialogue: 0,0:20:38.13,0:20:40.14,Default,,0,0,0,,Иә! ? иә?
Dialogue: 0,0:20:40.14,0:20:42.14,Default,,0,0,0,,Иә! ? Жарайды ма?
Dialogue: 0,0:20:42.14,0:20:45.14,Default,,0,0,0,,Иә. Уақыт келді деп ойладым.
Dialogue: 0,0:20:45.14,0:20:48.14,Default,,0,0,0,,Уақыт келді ме? Шынымен, шынымен, жақсы, солай емес пе?
Dialogue: 0,0:20:48.14,0:20:51.15,Default,,0,0,0,,Иә. Жақсы!
Dialogue: 0,0:20:51.15,0:20:54.15,Default,,0,0,0,,Олай болса, қазір бастайық... Сәл күте аласыз ба?
Dialogue: 0,0:20:54.15,0:20:56.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:56.15,0:20:59.16,Default,,0,0,0,,Алдымен мен Бұлма-санмен кешкі ас ішемін.
Dialogue: 0,0:20:59.16,0:21:01.16,Default,,0,0,0,,Сондықтан біз Жерге келдік.
Dialogue: 0,0:21:01.16,0:21:06.16,Default,,0,0,0,,А... дұрыс. Бұл жағдайда мен осында күтемін →
Dialogue: 0,0:21:06.16,0:21:10.17,Default,,0,0,0,,Ақырын жүріңіз. Барамыз ба?
Dialogue: 0,0:21:10.17,0:21:12.17,Default,,0,0,0,,Иә... иә.
Dialogue: 0,0:21:12.17,0:21:15.17,Default,,0,0,0,,«Уақыт жетті» деген нені білдіреді?
Dialogue: 0,0:21:15.17,0:21:18.11,Default,,0,0,0,,Мен мұны айттым ба?
Dialogue: 0,0:21:18.11,0:21:21.11,Default,,0,0,0,,Мен Whis-san-мен жаттыға алмаймын ба?
Dialogue: 0,0:21:21.11,0:21:23.11,Default,,0,0,0,,Мен оны асыға күтемін!
Dialogue: 0,0:21:23.11,0:21:29.12,Default,,0,0,0,,А... анам білсе... Әке, сізді өлтіреді.
Dialogue: 0,0:21:29.12,0:21:36.13,Default,,0,0,0,,Сәлем. Жіңішке кесілген етті ыстық суға тез салып жейді.
Dialogue: 0,0:21:36.13,0:21:40.13,Default,,0,0,0,,Бұл шабу-шабу сияқты!
Dialogue: 0,0:21:40.13,0:21:43.13,Default,,0,0,0,,Бітірдің бе?
Dialogue: 0,0:21:43.13,0:21:46.14,Default,,0,0,0,,Иә? Жоқ, бірақ қазірден бастап.
Dialogue: 0,0:21:46.14,0:21:51.14,Default,,0,0,0,,Түсіндім. Жарайды, күтемін.
Dialogue: 0,0:21:51.14,0:21:56.15,Default,,0,0,0,,Сіз шыдамсыз адамсыз. Ақырында... →
Dialogue: 0,0:21:56.15,0:21:59.15,Default,,0,0,0,,О! Мұны істейік. Бітірдің бе?
Dialogue: 0,0:21:59.15,0:22:03.15,Default,,0,0,0,,Не? Жоқ, қазірден бастап.
Dialogue: 0,0:22:03.15,0:22:06.16,Default,,0,0,0,,Түсіндім. Ха...
Dialogue: 0,0:22:06.16,0:22:09.16,Default,,0,0,0,,Мұны мүмкіндігінше тезірек жасаңыз. Ахах...
Dialogue: 0,0:22:09.16,0:22:14.16,Default,,0,0,0,,Охохохо. Түсі өзгерді. Олай болса!
Dialogue: 0,0:22:14.16,0:22:16.18,Default,,0,0,0,,Бітірдің бе?
Dialogue: 0,0:22:16.18,0:22:19.10,Default,,0,0,0,,Гоку-сан! Егер сіз осындай асығыс болсаңыз→
Dialogue: 0,0:22:19.10,0:22:22.11,Default,,0,0,0,,Сіз тіпті ештеңе жей алмайсыз.
Dialogue: 0,0:22:22.11,0:22:25.11,Default,,0,0,0,,Өйткені, эй, тез барғаныңыз жөн.
Dialogue: 0,0:22:25.11,0:22:28.11,Default,,0,0,0,,Егер сіз тым табанды болсаңыз, олар сізді жек көреді.
Dialogue: 0,0:22:28.11,0:22:31.11,Default,,0,0,0,,Мені енді көтере алмасаң да, мен білмеймін.
Dialogue: 0,0:22:31.11,0:22:33.12,Default,,0,0,0,,Аа...
Dialogue: 0,0:22:33.12,0:22:39.12,Default,,0,0,0,,Хахаха... Асықпаңыз. Эй, сонда күт.
Dialogue: 0,0:22:39.12,0:22:42.13,Default,,0,0,0,,Хехе….
Dialogue: 0,0:22:42.13,0:22:46.13,Default,,0,0,0,,Хмм…. Тамақтану қиын.
Dialogue: 0,0:22:46.13,0:22:49.13,Default,,0,0,0,,Тамақ бергеніңіз үшін рахмет. О!
Dialogue: 0,0:22:49.13,0:22:53.14,Default,,0,0,0,,Ингредиенттердің дәмін қарапайым пісіру әдістерімен шығару керемет...
Dialogue: 0,0:22:53.14,0:22:56.14,Default,,0,0,0,,Жарайды! Олай болса, Уис мырза! Ол аурады.
Dialogue: 0,0:22:56.14,0:23:00.14,Default,,0,0,0,,Гоку мырза. Сіздің мазасыздығыңыз проблема болып табылады.
Dialogue: 0,0:23:00.14,0:23:03.15,Default,,0,0,0,,Мен бұл жолы жаттығуды кейінге қалдырамын деп ойлаймын.
Dialogue: 0,0:23:03.15,0:23:05.15,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:23:05.15,0:23:07.15,Default,,0,0,0,,Сіз мені алып кетемін дедіңіз!
Dialogue: 0,0:23:07.15,0:23:10.15,Default,,0,0,0,,Мен айтқанымдай. ≪ Бір минут күтіңіз!
Dialogue: 0,0:23:10.15,0:23:12.15,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:14.16,0:23:17.09,Default,,0,0,0,,Чичи! Ол кетті!
Dialogue: 0,0:23:17.09,0:23:19.10,Default,,0,0,0,,Гоку!
Dialogue: 0,0:23:19.10,0:23:22.10,Default,,0,0,0,,Кешіріңіз, әке. Мен білдім.
Dialogue: 0,0:23:22.10,0:23:26.10,Default,,0,0,0,,Жаттығу дегеніміз не! Маған мұндай нәрсеге баруға рұқсат етпеңіз.
Dialogue: 0,0:23:26.10,0:23:29.11,Default,,0,0,0,,Бұлма-санға да айтыңызшы!
Dialogue: 0,0:23:29.11,0:23:31.11,Default,,0,0,0,,Аха….
Dialogue: 0,0:23:31.11,0:23:34.11,Default,,0,0,0,,Чичи... олай айтпа.
Dialogue: 0,0:23:34.11,0:23:37.11,Default,,0,0,0,,Аз ғана. Мен сәл ғана барамын.
Dialogue: 0,0:23:37.11,0:23:39.12,Default,,0,0,0,,Қандай аз!
Dialogue: 0,0:23:39.12,0:23:43.12,Default,,0,0,0,,Олай деп тағы да алдауға жол берме!
Dialogue: 0,0:23:43.12,0:23:45.12,Default,,0,0,0,,Анашым, мен сізді жіберуім керек пе?
Dialogue: 0,0:23:45.12,0:23:48.12,Default,,0,0,0,,Әке, менің барғым келеді.
Dialogue: 0,0:23:48.12,0:23:51.13,Default,,0,0,0,,Готен, үндеме! (Готен) Иә.
Dialogue: 0,0:23:51.13,0:23:56.13,Default,,0,0,0,,Анашым, маған да көмектесіңізші. Әкенің қабілетін дамыту →
Dialogue: 0,0:23:56.13,0:23:59.14,Default,,0,0,0,,Мен міндетті түрде жер үшін пайдалы болады деп ойлаймын.
Dialogue: 0,0:23:59.14,0:24:01.14,Default,,0,0,0,,Әрине, мен де бар күшімді саламын.
Dialogue: 0,0:24:01.14,0:24:05.14,Default,,0,0,0,,Маған төтенше жағдайда әкемнің күші керек.
Dialogue: 0,0:24:05.14,0:24:07.14,Default,,0,0,0,,Пайдасыз нәрсе пайдасыз!
Dialogue: 0,0:24:07.14,0:24:11.15,Default,,0,0,0,,Нан үшін Гоку еңбектенеді →
Dialogue: 0,0:24:11.15,0:24:13.15,Default,,0,0,0,,Мен сенің жақсы қария болғаныңды қалаймын.
Dialogue: 0,0:24:13.15,0:24:16.17,Default,,0,0,0,,Кішкене ғана. Аз ғана уақытқа.
Dialogue: 0,0:24:16.17,0:24:21.09,Default,,0,0,0,,Біраз уақыт алатын сияқты. Олай болса, Бұлма-сан, мен осындамын.
Dialogue: 0,0:24:21.09,0:24:24.09,Default,,0,0,0,,А... барасың ба?
Dialogue: 0,0:24:24.09,0:24:27.10,Default,,0,0,0,,Ах!
Dialogue: 0,0:24:27.10,0:24:30.10,Default,,0,0,0,,Кешіріңіз, Чичи! О, мен шынымен кетуім керек!
Dialogue: 0,0:24:30.10,0:24:34.10,Default,,0,0,0,,Жаттығу және күштірек бол!
Dialogue: 0,0:24:34.10,0:24:37.11,Default,,0,0,0,,Тория!
Dialogue: 0,0:24:37.11,0:24:39.11,Default,,0,0,0,,О.
Dialogue: 0,0:24:39.11,0:24:42.11,Default,,0,0,0,,О? Гоку? Гоку!
Dialogue: 0,0:24:42.11,0:24:45.11,Default,,0,0,0,,Гоку!
Dialogue: 0,0:24:48.12,0:24:53.12,Default,,0,0,0,,Аа... Күткендей мен кеттім.
Dialogue: 0,0:24:53.12,0:24:56.13,Default,,0,0,0,,Садаши Гоку Оған көмектесу мүмкін емес.
Dialogue: 0,0:24:56.13,0:25:00.13,Default,,0,0,0,,Қарның ашқанда қайту керек. →
Dialogue: 0,0:25:00.13,0:25:04.13,Default,,0,0,0,,Сонымен, Бұлма-сан, бізде тосын кеш қашан болады?
Dialogue: 0,0:25:04.13,0:25:06.14,Default,,0,0,0,,Не... мен?
Dialogue: 0,0:25:06.14,0:25:12.14,Default,,0,0,0,,Егер бұлай болса... Мен сені қатты ұрамын!
Dialogue: 0,0:25:12.14,0:25:15.14,Default,,0,0,0,,Сіз абайсыздасыз. Хи хи хи хи.
Dialogue: 0,0:25:15.14,0:25:19.08,Default,,0,0,0,,Бұл шынымен жақсы ма? Мен осылай ғана кетіп қалдым.
Dialogue: 0,0:25:19.08,0:25:24.09,Default,,0,0,0,,Ах. Чи-Чи түсінетініне сенімдімін.
Dialogue: 0,0:25:24.09,0:25:27.09,Default,,0,0,0,,Бинго турнирі болуы керек пе? Әрине!
Dialogue: 0,0:25:27.09,0:25:31.09,Default,,0,0,0,,Менде ешқандай Айдаһар шарлары жоқ, бірақ мен керемет сыйлықтар дайындаймын.
Dialogue: 0,0:25:31.09,0:25:35.10,Default,,0,0,0,,《Әке. Анаң үшін уайымдаудың қажеті жоқ.
Dialogue: 0,0:25:35.10,0:25:38.10,Default,,0,0,0,,《Қолыңыздан келгенше жаттығу жасаңыз》
Dialogue: 0,0:25:38.10,0:25:41.10,Default,,0,0,0,,Әй, қызды сүйкімді көйлекпен қалай киесің?
Dialogue: 0,0:25:41.10,0:25:43.11,Default,,0,0,0,,Бұл арман болды!
Dialogue: 0,0:25:43.11,0:25:46.11,Default,,0,0,0,,Бұл керемет, анашым.
Dialogue: 0,0:25:46.11,0:25:56.11,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:47.17,0:26:49.17,Default,,0,0,0,,Сәлем, Гоку!
Dialogue: 0,0:26:49.17,0:26:52.17,Default,,0,0,0,,Вегета айтарлықтай күшті болды.
Dialogue: 0,0:26:52.17,0:26:54.18,Default,,0,0,0,,Мен сізді дұрыс түсінбедім.
Dialogue: 0,0:26:54.18,0:26:58.18,Default,,0,0,0,,Беерус-саманың төсегі. Шөп шабу жарысы. Мен жеңілмеймін!
Dialogue: 0,0:26:58.18,0:27:01.18,Default,,0,0,0,,Бұл көп жаттығу. Бұл сәл басқаша!
Dialogue: 0,0:27:01.18,0:27:03.19,Default,,0,0,0,,Не? Айтыңызшы, Уис мырза!
Dialogue: 0,0:27:03.19,0:27:07.19,Default,,0,0,0,,Бізге не жетпейді?
Dialogue: 0,0:27:07.19,0:27:09.19,Default,,0,0,0,,Келесі жолы «Dragon Ball Super»
Dialogue: 0,0:27:12.19,0:27:14.19,Default,,0,0,0,,Міндетті түрде тексеріңіз!
Dialogue: 0,0:27:15.69,0:27:21.69,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory