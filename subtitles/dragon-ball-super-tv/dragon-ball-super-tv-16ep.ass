Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:33.23,0:01:43.23,Default,,0,0,0,,♪♪~
Dialogue: 0,0:04:10.55,0:04:16.56,Default,,0,0,0,,<Жер тағдырына қауіп төніп тұрған Гоку мен Беерус, жойылу құдайы арасындағы шайқас→
Dialogue: 0,0:04:16.56,0:04:18.56,Default,,0,0,0,,Берустың жеңісімен аяқталса да→
Dialogue: 0,0:04:18.56,0:04:23.57,Default,,0,0,0,,Берус Гокумен күресте де бар күшін жұмсады>
Dialogue: 0,0:04:23.57,0:04:27.57,Default,,0,0,0,,Өте жақсы….
Dialogue: 0,0:04:27.57,0:04:34.57,Default,,0,0,0,,＜Осылайша жойылудан құтылған жер күнделікті бейбіт өмірге қайта оралды.＞
Dialogue: 0,0:04:37.58,0:04:42.58,Default,,0,0,0,,<Гоку да Кайтоға тағы бір рет жаттығуға бармақшы болады, бірақ →
Dialogue: 0,0:04:42.58,0:04:45.59,Default,,0,0,0,,Чичи маған қатты жұмыс істе деп ұрысады...＞
Dialogue: 0,0:04:45.59,0:04:48.89,Default,,0,0,0,,Мен бүгін үйге бара алмаймын деп ойлаймын.
Dialogue: 0,0:05:01.60,0:05:03.61,Default,,0,0,0,,Содан бері әсіресе не өзгерді→
Dialogue: 0,0:05:03.61,0:05:05.61,Default,,0,0,0,,Бұл орындалмайтын сияқты →
Dialogue: 0,0:05:05.61,0:05:09.55,Default,,0,0,0,,Олай болса, бірінші жоғалған екі жұлдыз →
Dialogue: 0,0:05:09.55,0:05:11.55,Default,,0,0,0,,Бұл не болды?
Dialogue: 0,0:05:11.55,0:05:13.55,Default,,0,0,0,,Менің ойымша, оны Беерус-сама жойды.
Dialogue: 0,0:05:13.55,0:05:15.55,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:05:15.55,0:05:20.56,Default,,0,0,0,,Бұлай айтқанда, қирау белгілері байқалмады→
Dialogue: 0,0:05:20.56,0:05:24.56,Default,,0,0,0,,Бірдеңе болса, ол сиқырлы түрде жоғалып кеткендей болды.
Dialogue: 0,0:05:24.56,0:05:27.56,Default,,0,0,0,,О. Онда қара.
Dialogue: 0,0:05:27.56,0:05:30.57,Default,,0,0,0,,Оңға қарай көбірек. Дұрыс Дұрыс.
Dialogue: 0,0:05:30.57,0:05:33.57,Default,,0,0,0,,Иә, иә, иә.
Dialogue: 0,0:05:33.57,0:05:36.57,Default,,0,0,0,,Иә... Ахаха?
Dialogue: 0,0:05:36.57,0:05:39.58,Default,,0,0,0,,Ах!
Dialogue: 0,0:05:39.58,0:05:43.58,Default,,0,0,0,,Құрметті ата-баба, сендер не қарап тұрсыңдар?
Dialogue: 0,0:05:43.58,0:05:46.58,Default,,0,0,0,,Эй, маған кедергі жасама! Эй.
Dialogue: 0,0:05:46.58,0:05:49.59,Default,,0,0,0,,Жоқ! Не деген пәле!
Dialogue: 0,0:05:49.59,0:05:51.59,Default,,0,0,0,,Тоқта... Эй. Тоқта.
Dialogue: 0,0:05:51.59,0:05:54.59,Default,,0,0,0,,Ата-бабалар! (Кәрі Кай) Әй, аққан жұлдыз!
Dialogue: 0,0:05:54.59,0:05:56.59,Default,,0,0,0,,Не? (Кәрі Кай) Ах.
Dialogue: 0,0:05:56.59,0:05:59.60,Default,,0,0,0,,Мен жеңілдім.
Dialogue: 0,0:05:59.60,0:06:01.60,Default,,0,0,0,,Жоғалдың ба?
Dialogue: 0,0:06:01.60,0:06:04.60,Default,,0,0,0,,Нені қарадыңыз?
Dialogue: 0,0:06:07.54,0:06:10.54,Default,,0,0,0,,Қоңыз?
Dialogue: 0,0:06:10.54,0:06:13.54,Default,,0,0,0,,Бұл қоңыздардың шайқасы.
Dialogue: 0,0:06:13.54,0:06:16.55,Default,,0,0,0,,Сіз нені көріп тұрмын деп ойладыңыз?
Dialogue: 0,0:06:16.55,0:06:21.55,Default,,0,0,0,,Ах... Сонымен... Бұл... Бұл...
Dialogue: 0,0:06:21.55,0:06:24.55,Default,,0,0,0,,А, аққан жұлдыз! (Кәрі Кай) Муу!
Dialogue: 0,0:06:24.55,0:06:26.85,Default,,0,0,0,,Ха... хахаха... хахаха….
Dialogue: 0,0:06:31.56,0:06:35.56,Default,,0,0,0,,Гугаааааааааааааааааааааааааааааааааааааааааааааааааа...
Dialogue: 0,0:06:35.56,0:06:47.58,Default,,0,0,0,,♪♪~
Dialogue: 0,0:06:47.58,0:06:50.58,Default,,0,0,0,,Әй, Гоку~!
Dialogue: 0,0:06:56.59,0:06:59.59,Default,,0,0,0,,Иә?
Dialogue: 0,0:06:59.59,0:07:01.59,Default,,0,0,0,,О, криллин.
Dialogue: 0,0:07:01.59,0:07:04.59,Default,,0,0,0,,Ол шынымен де сонда болды ма? екінші ойлар туралы?
Dialogue: 0,0:07:04.59,0:07:07.53,Default,,0,0,0,,Мен Кай патшамен жаттығуға оралдым деп ойладым→
Dialogue: 0,0:07:07.53,0:07:10.53,Default,,0,0,0,,Мен сені әлі Жерде екеніңді естідім.
Dialogue: 0,0:07:10.53,0:07:14.54,Default,,0,0,0,,А, мен де бардым, бірақ Чи-Чи сондай шу болды.
Dialogue: 0,0:07:14.54,0:07:16.54,Default,,0,0,0,,«Менің немерем дүниеге келгендіктен→
Dialogue: 0,0:07:16.54,0:07:19.54,Default,,0,0,0,,Маған жақсы, еңбекқор ата ретінде қандай екеніңізді көрсетіңіз.''
Dialogue: 0,0:07:19.54,0:07:24.55,Default,,0,0,0,,Мен көремін. Мен бұл Гоку үшін ең қиын дер едім→
Dialogue: 0,0:07:24.55,0:07:26.55,Default,,0,0,0,,Бұл маған сәйкес келмейді.
Dialogue: 0,0:07:26.55,0:07:30.55,Default,,0,0,0,,Мен саған алаңдама дедім, өйткені менде Саян қаны бар→
Dialogue: 0,0:07:30.55,0:07:33.56,Default,,0,0,0,,Гохан туған кездегі Чи-Чи →
Dialogue: 0,0:07:33.56,0:07:35.56,Default,,0,0,0,,Барған сайын қиындап барады.
Dialogue: 0,0:07:35.56,0:07:37.56,Default,,0,0,0,,Өйткені бұл менің бірінші немерем.
Dialogue: 0,0:07:37.56,0:07:41.56,Default,,0,0,0,,Солай ма? Криллин, неге көлік жүргізуді өз қолыңа алмайсың?
Dialogue: 0,0:07:41.56,0:07:44.57,Default,,0,0,0,,Иә? Жарайды дегенмен.
Dialogue: 0,0:07:44.57,0:07:48.57,Default,,0,0,0,,Жай отыра берсең, денең түтікпейді.
Dialogue: 0,0:07:48.57,0:07:50.57,Default,,0,0,0,,Маған әлі де жаттығып, шыңдалу керек→
Dialogue: 0,0:07:50.57,0:07:54.58,Default,,0,0,0,,Мен Беерус-самаға жете алмаймын.
Dialogue: 0,0:07:54.58,0:07:58.58,Default,,0,0,0,,Соған қарамастан, айырмашылық айтарлықтай кеңейді.
Dialogue: 0,0:07:58.58,0:08:01.58,Default,,0,0,0,,Иә? Алдымен Мутен Рошидің орнында →
Dialogue: 0,0:08:01.58,0:08:04.59,Default,,0,0,0,,Біз бірге жаттығатынбыз.
Dialogue: 0,0:08:04.59,0:08:07.52,Default,,0,0,0,,《Hehehe...》
Dialogue: 0,0:08:07.52,0:08:11.53,Default,,0,0,0,,《Бірақ бұл шын ба, жоқ па білмеймін》
Dialogue: 0,0:08:11.53,0:08:14.53,Default,,0,0,0,,《Мм? 》 《Оны біраз уақытқа қарызға алуға рұқсат етіңіз.》
Dialogue: 0,0:08:14.53,0:08:16.53,Default,,0,0,0,,《Мм...》
Dialogue: 0,0:08:16.53,0:08:18.53,Default,,0,0,0,,《Ухахаха! 》
Dialogue: 0,0:08:18.53,0:08:21.54,Default,,0,0,0,,《Ах! 》 《Ухьяхья...》
Dialogue: 0,0:08:21.54,0:08:24.54,Default,,0,0,0,,《Күте~ Мына бейбақ лас.》
Dialogue: 0,0:08:29.54,0:08:32.55,Default,,0,0,0,,Мен мұны білмей тұрып...
Dialogue: 0,0:08:32.55,0:08:34.55,Default,,0,0,0,,《Өткізіп жіберу》
Dialogue: 0,0:08:34.55,0:08:37.55,Default,,0,0,0,,Жою құдайы Беруспен біркелкі күресуге жеткілікті→
Dialogue: 0,0:08:37.55,0:08:40.56,Default,,0,0,0,,Өйткені ол сізді күштірек етеді.
Dialogue: 0,0:08:40.56,0:08:44.56,Default,,0,0,0,,Криллин сол кездегідей кішкентай.
Dialogue: 0,0:08:44.56,0:08:46.56,Default,,0,0,0,,Гоку~!
Dialogue: 0,0:08:46.56,0:08:48.56,Default,,0,0,0,,Эй... Мен әзілдеп тұрмын.
Dialogue: 0,0:08:50.57,0:08:53.57,Default,,0,0,0,,Гоку... маған бір соққы бере аласыз ба?
Dialogue: 0,0:08:53.57,0:08:55.57,Default,,0,0,0,,Не? Ола криллин ме?
Dialogue: 0,0:08:55.57,0:09:00.58,Default,,0,0,0,,Аа, мен қазір Гокудың қаншалықты күшті екенін білгім келеді.
Dialogue: 0,0:09:00.58,0:09:02.58,Default,,0,0,0,,Бірақ бұл ауырады.
Dialogue: 0,0:09:02.58,0:09:04.58,Default,,0,0,0,,Ах.
Dialogue: 0,0:09:04.58,0:09:07.52,Default,,0,0,0,,Сіз сенімдісіз бе? аа.
Dialogue: 0,0:09:07.52,0:09:10.52,Default,,0,0,0,,Бұл шынымен ауырады ма? аа!
Dialogue: 0,0:09:10.52,0:09:14.52,Default,,0,0,0,,Шынымен, шынымен, ауырады!
Dialogue: 0,0:09:14.52,0:09:18.53,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,0:09:18.53,0:09:20.53,Default,,0,0,0,,Олай болса, кеттік!
Dialogue: 0,0:09:20.53,0:09:23.53,Default,,0,0,0,,О!
Dialogue: 0,0:09:23.53,0:09:26.53,Default,,0,0,0,,Оооооооооуу!
Dialogue: 0,0:09:29.54,0:09:31.54,Default,,0,0,0,,Сәлем!
Dialogue: 0,0:09:33.54,0:09:35.54,Default,,0,0,0,,Криллин!
Dialogue: 0,0:09:35.54,0:09:37.55,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:37.55,0:09:39.55,Default,,0,0,0,,Хмм.
Dialogue: 0,0:09:41.22,0:09:43.45,Default,,0,0,0,,Уау! Криллин!
Dialogue: 0,0:09:43.45,0:09:45.45,Default,,0,0,0,,≪(Соқтығыс дыбысы)
Dialogue: 0,0:09:45.45,0:09:47.45,Default,,0,0,0,,Хэхехе.
Dialogue: 0,0:09:50.46,0:09:53.46,Default,,0,0,0,,Хаха хахаха.... жоқ….
Dialogue: 0,0:09:53.46,0:09:55.46,Default,,0,0,0,,Эй, қозғалма.
Dialogue: 0,0:09:55.46,0:09:59.47,Default,,0,0,0,,Бұл... ауырады!
Dialogue: 0,0:09:59.47,0:10:03.47,Default,,0,0,0,,Ааа~ Қозғасаң, дәріні жаға алмайсың, солай ма?
Dialogue: 0,0:10:03.47,0:10:06.47,Default,,0,0,0,,Гоку сені жұдырықтайды деп не ойлап жүрсің?
Dialogue: 0,0:10:06.47,0:10:11.41,Default,,0,0,0,,Оған көмектесу мүмкін емес. Мен Гокудың күшін білгім келді.
Dialogue: 0,0:10:11.41,0:10:13.42,Default,,0,0,0,,Аа, ауырады... Ауырды...
Dialogue: 0,0:10:13.42,0:10:17.42,Default,,0,0,0,,Қараңызшы, ол қозғалмайды. Бұл қиналған әке.
Dialogue: 0,0:10:17.42,0:10:19.42,Default,,0,0,0,,Кеттік!
Dialogue: 0,0:10:19.42,0:10:23.43,Default,,0,0,0,,Эй, эй, эй! Соған қарамастан, ол күшті болды.
Dialogue: 0,0:10:23.43,0:10:26.43,Default,,0,0,0,,Иә? (Марлон) Хахаха, дәмді, дәмді!
Dialogue: 0,0:10:26.43,0:10:31.43,Default,,0,0,0,,Мен жекпе-жек өнерінен бас тарту шынымен жақсы идея ма деп ойладым...
Dialogue: 0,0:10:31.43,0:10:34.44,Default,,0,0,0,,Бұл аяқталуды білдіреді.
Dialogue: 0,0:10:34.44,0:10:37.44,Default,,0,0,0,,Жасайық! Ауырады...
Dialogue: 0,0:10:37.44,0:10:40.44,Default,,0,0,0,,Қараңызшы, әлі біткен жоқ.
Dialogue: 0,0:10:40.44,0:10:44.44,Default,,0,0,0,,Ауырды... Ауырды...
Dialogue: 0,0:10:47.45,0:10:51.45,Default,,0,0,0,,《Тоқсым жұмыс істеді, Гоку》 《Мм? 》
Dialogue: 0,0:10:51.45,0:10:56.46,Default,,0,0,0,,《Оның қаншалықты күшті болатынын асыға күтемін》
Dialogue: 0,0:10:56.46,0:10:58.46,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:10:58.46,0:11:04.47,Default,,0,0,0,,Маған көбірек жаттығып, шыңдалу керек...
Dialogue: 0,0:11:04.47,0:11:07.40,Default,,0,0,0,,Енді ешкім қарап тұрған жоқ.
Dialogue: 0,0:11:07.40,0:11:12.41,Default,,0,0,0,,Иә!
Dialogue: 0,0:11:12.41,0:11:14.41,Default,,0,0,0,,Тренинг!
Dialogue: 0,0:11:24.42,0:11:29.42,Default,,0,0,0,,(Найзағай)
Dialogue: 0,0:11:44.44,0:11:54.45,Default,,0,0,0,,Coo. Хааааааа...
Dialogue: 0,0:11:54.45,0:11:57.45,Default,,0,0,0,,Әй, қарт кісі, жақсысың ба? Ауырған жоқсың ба?
Dialogue: 0,0:11:57.45,0:12:13.40,Default,,0,0,0,,♪♪~
Dialogue: 0,0:12:13.40,0:12:19.41,Default,,0,0,0,,Ха... ха... ха... ха....
Dialogue: 0,0:12:19.41,0:12:22.41,Default,,0,0,0,,《Бұл әлі де солай ма?》
Dialogue: 0,0:12:25.41,0:12:30.42,Default,,0,0,0,,《Міндетті түрде Какароттан асып кет》→
Dialogue: 0,0:12:30.42,0:12:33.42,Default,,0,0,0,,《Өз күшіммен...》→
Dialogue: 0,0:12:33.42,0:12:36.42,Default,,0,0,0,,《Мен саған Құдай патшалығынан тыс жерлерді көрсетемін! 》
Dialogue: 0,0:12:45.43,0:12:47.44,Default,,0,0,0,,Охххх! →
Dialogue: 0,0:12:47.44,0:12:49.44,Default,,0,0,0,,Сонымен...
Dialogue: 0,0:12:51.44,0:12:53.44,Default,,0,0,0,,Беттері….
Dialogue: 0,0:12:56.44,0:12:58.45,Default,,0,0,0,,(Оқушы) Қайырлы таң. (Оқушы) Қайырлы таң. Ой, күйіп кеткен екен!
Dialogue: 0,0:12:58.45,0:13:00.45,Default,,0,0,0,,Уф, уф, уф….
Dialogue: 0,0:13:00.45,0:13:04.45,Default,,0,0,0,,Ммммммммм….
Dialogue: 0,0:13:04.45,0:13:07.49,Default,,0,0,0,,Дәмді….
Dialogue: 0,0:13:07.49,0:13:09.49,Default,,0,0,0,,Бұл дәмді. →
Dialogue: 0,0:13:09.49,0:13:13.50,Default,,0,0,0,,Бұл қытырлақ, үлпілдек текстура →
Dialogue: 0,0:13:13.50,0:13:16.50,Default,,0,0,0,,Кенет ол жайылып кетеді...
Dialogue: 0,0:13:16.50,0:13:18.50,Default,,0,0,0,,(Терезеге қағып жатқан дыбыс)
Dialogue: 0,0:13:18.50,0:13:22.50,Default,,0,0,0,,Бұл Тентсую ма? иә! Тентсую. →
Dialogue: 0,0:13:22.50,0:13:26.51,Default,,0,0,0,,Бұл тәтті хош иіс нағыз өнер.
Dialogue: 0,0:13:26.51,0:13:29.51,Default,,0,0,0,,Күйеуі: Дәмді екен. (Дүкенші) Сәлеметсіз бе.
Dialogue: 0,0:13:29.51,0:13:31.51,Default,,0,0,0,,Ал, келесіде какиаж.
Dialogue: 0,0:13:31.51,0:13:33.52,Default,,0,0,0,,Иә, какиаж.
Dialogue: 0,0:13:33.52,0:13:36.52,Default,,0,0,0,,(қуырылған дыбыс)
Dialogue: 0,0:13:36.52,0:13:39.52,Default,,0,0,0,,Иә, бұл дыбыс. →
Dialogue: 0,0:13:39.52,0:13:41.52,Default,,0,0,0,,Бұл хош иісті иіс.
Dialogue: 0,0:13:41.52,0:13:44.53,Default,,0,0,0,,Кешіріңіз. Әрқашан Булма үшін →
Dialogue: 0,0:13:44.53,0:13:46.53,Default,,0,0,0,,Маған дәмді нәрсе беріңіз.
Dialogue: 0,0:13:46.53,0:13:51.53,Default,,0,0,0,,Бұл анық емес. Өйткені біз доспыз.
Dialogue: 0,0:13:51.53,0:13:53.53,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:13:55.54,0:13:58.54,Default,,0,0,0,,Хм, бұл какиге ме?
Dialogue: 0,0:13:58.54,0:14:02.54,Default,,0,0,0,,Асшаяндардан айырмашылығы оның құрылымы ауыр→
Dialogue: 0,0:14:02.54,0:14:05.55,Default,,0,0,0,,Тағы да жақсы.
Dialogue: 0,0:14:05.55,0:14:08.55,Default,,0,0,0,,Біз доспыз.
Dialogue: 0,0:14:08.55,0:14:11.55,Default,,0,0,0,,Жерді қайта құртуға Беерус-сама келсе де →
Dialogue: 0,0:14:11.55,0:14:15.56,Default,,0,0,0,,Әрине, тек мен және Транкс көмектеседі →
Dialogue: 0,0:14:15.56,0:14:17.56,Default,,0,0,0,,Сіз оны сұрайсыз.
Dialogue: 0,0:14:17.56,0:14:19.56,Default,,0,0,0,,Мен келдім.
Dialogue: 0,0:14:21.56,0:14:24.57,Default,,0,0,0,,Енді бұл туралы не деуге болады?
Dialogue: 0,0:14:24.57,0:14:28.57,Default,,0,0,0,,Мм. Ммммммммм….
Dialogue: 0,0:14:28.57,0:14:30.57,Default,,0,0,0,,Бұл дәмді.
Dialogue: 0,0:14:30.57,0:14:32.57,Default,,0,0,0,,Иә.
Dialogue: 0,0:16:25.62,0:16:29.62,Default,,0,0,0,,Хаа… Хаа… Хаа….
Dialogue: 0,0:16:29.62,0:16:32.63,Default,,0,0,0,,≪Ой, қайтып келдің бе?
Dialogue: 0,0:16:32.63,0:16:37.63,Default,,0,0,0,,Әлі ерте емес. Үйге қайтқыңыз келсе, үйге қайтыңыз деп айтыңыз. →
Dialogue: 0,0:16:37.63,0:16:39.63,Default,,0,0,0,,Сондай лас киінген. →
Dialogue: 0,0:16:39.63,0:16:43.64,Default,,0,0,0,,Вегета қайтып келген сайын бөлме лай болады. →
Dialogue: 0,0:16:43.64,0:16:46.64,Default,,0,0,0,,Өткен күні тіккен көйлегім...
Dialogue: 0,0:16:46.64,0:16:49.64,Default,,0,0,0,,Әй, күте тұр, жұрттың айтқанын тыңдап тұрсың ба?
Dialogue: 0,0:16:49.64,0:16:53.65,Default,,0,0,0,,Мен ұзақ уақыттан кейін оралдым деп ойлағанымда, міне, осы. →
Dialogue: 0,0:16:53.65,0:16:56.65,Default,,0,0,0,,Адамдармен қарым-қатынас жасауды білмеймін...
Dialogue: 0,0:16:58.65,0:17:00.66,Default,,0,0,0,,Whis!
Dialogue: 0,0:17:00.66,0:17:02.66,Default,,0,0,0,,Вегета-сан, біраз уақыт болды.
Dialogue: 0,0:17:02.66,0:17:04.66,Default,,0,0,0,,Жерде не үшін жүрсің? ?
Dialogue: 0,0:17:04.66,0:17:07.66,Default,,0,0,0,,Мен бе? Охохохо.
Dialogue: 0,0:17:07.66,0:17:09.60,Default,,0,0,0,,Мен Бұлма-санмен кешкі ас ішемін.
Dialogue: 0,0:17:09.60,0:17:11.60,Default,,0,0,0,,Булмамен бірге! ?
Dialogue: 0,0:17:11.60,0:17:14.60,Default,,0,0,0,,Содан бері біз біртүрлі араласып кеттік.
Dialogue: 0,0:17:14.60,0:17:17.61,Default,,0,0,0,,Whis де анда-санда Жерге келеді.
Dialogue: 0,0:17:17.61,0:17:19.61,Default,,0,0,0,,Кішкене ғана! ?
Dialogue: 0,0:17:19.61,0:17:21.61,Default,,0,0,0,,Әрқашан Булма үшін →
Dialogue: 0,0:17:21.61,0:17:23.61,Default,,0,0,0,,Біз дәмді тағаммен тамақтанғалы жатырмыз.
Dialogue: 0,0:17:23.61,0:17:27.62,Default,,0,0,0,,Жер шынымен дәмді нәрселерге толы→
Dialogue: 0,0:17:27.62,0:17:29.62,Default,,0,0,0,,Қанша келсем де, жалықпаймын.
Dialogue: 0,0:17:29.62,0:17:33.62,Default,,0,0,0,,Дәмді тағамды жеуге болатыны менің арқамда.
Dialogue: 0,0:17:33.62,0:17:35.62,Default,,0,0,0,,Ұмытпа.
Dialogue: 0,0:17:35.62,0:17:38.63,Default,,0,0,0,,Әрине. Мен ризамын.
Dialogue: 0,0:17:38.63,0:17:41.63,Default,,0,0,0,,Келетін болсаң, келе жатыр деп неге айтпайсың!
Dialogue: 0,0:17:41.63,0:17:43.63,Default,,0,0,0,,Неге ашуланасың?
Dialogue: 0,0:17:43.63,0:17:46.63,Default,,0,0,0,,А, түсіндім. Сен қызғаншақсың.
Dialogue: 0,0:17:46.63,0:17:50.64,Default,,0,0,0,,Сұлу әйел Уиспен жалғыз тамақтанды. →
Dialogue: 0,0:17:50.64,0:17:53.64,Default,,0,0,0,,Күйеу ретінде мен сенің неліктен уайымдап жатқаныңды түсінемін.
Dialogue: 0,0:17:53.64,0:17:55.64,Default,,0,0,0,,Бұл маңызды емес!
Dialogue: 0,0:17:55.64,0:17:57.65,Default,,0,0,0,,Е, маған бәрібір! ?
Dialogue: 0,0:17:57.65,0:18:00.65,Default,,0,0,0,,Сонымен қатар, Берус та бізбен бірге! ?
Dialogue: 0,0:18:00.65,0:18:03.65,Default,,0,0,0,,Беерус-сама планетада демалып жатыр...
Dialogue: 0,0:18:03.65,0:18:05.65,Default,,0,0,0,,Түсіндім! Олай болса, бірден→
Dialogue: 0,0:18:05.65,0:18:08.67,Default,,0,0,0,,Мені Берусқа апарыңыз! иә?
Dialogue: 0,0:18:08.67,0:18:12.59,Default,,0,0,0,,Мен Берусқа Сайяндардың нағыз күшін үйретемін!
Dialogue: 0,0:18:12.59,0:18:14.60,Default,,0,0,0,,Вегета.
Dialogue: 0,0:18:14.60,0:18:16.20,Default,,0,0,0,,Ухухуху.
Dialogue: 0,0:18:19.60,0:18:21.60,Default,,0,0,0,,Не?
Dialogue: 0,0:18:21.60,0:18:23.60,Default,,0,0,0,,Әй, сен не айтып тұрсың? ?
Dialogue: 0,0:18:23.60,0:18:26.61,Default,,0,0,0,,Егер Беерус Жерді қайтадан жоюға келсе ше?→
Dialogue: 0,0:18:26.61,0:18:28.61,Default,,0,0,0,,Біз не істеуіміз керек? (Вегета) Шулы!
Dialogue: 0,0:18:28.61,0:18:31.61,Default,,0,0,0,,Мен қазір қаншалықты түсінемін→
Dialogue: 0,0:18:31.61,0:18:33.61,Default,,0,0,0,,Мен онымен күресуім керек.
Dialogue: 0,0:18:33.61,0:18:37.62,Default,,0,0,0,,Жекпе-жекке келгенде... мен сені жеңе алмаймын.
Dialogue: 0,0:18:37.62,0:18:40.62,Default,,0,0,0,,Тіпті Сон-кун да өлтірілмекші болды.
Dialogue: 0,0:18:40.62,0:18:44.63,Default,,0,0,0,,Цк... Мені ең қатты алаңдататын нәрсе...
Dialogue: 0,0:18:44.63,0:18:46.63,Default,,0,0,0,,Тек мені мазаламаңыз.
Dialogue: 0,0:18:46.63,0:18:49.63,Default,,0,0,0,,Whis мырзамен дос болсаң →
Dialogue: 0,0:18:49.63,0:18:51.63,Default,,0,0,0,,Жерді қирату үшін Берус келсе де→
Dialogue: 0,0:18:51.63,0:18:54.63,Default,,0,0,0,,Біз ғана қауіпсізміз.
Dialogue: 0,0:18:56.64,0:18:58.64,Default,,0,0,0,,Енді кеттік. иә.
Dialogue: 0,0:18:58.64,0:19:02.64,Default,,0,0,0,,Бұлма-санның маған тапсырыс берген тәттісі→
Dialogue: 0,0:19:02.64,0:19:04.65,Default,,0,0,0,,Мен оны асыға күтемін.
Dialogue: 0,0:19:04.65,0:19:07.65,Default,,0,0,0,,Күте тұрыңыз! Әңгіме әлі біткен жоқ!
Dialogue: 0,0:19:07.65,0:19:10.59,Default,,0,0,0,,《Егер бұлай болса, мен күш қолданамын...》→
Dialogue: 0,0:19:10.59,0:19:15.59,Default,,0,0,0,,《Не? Қарсыласты тығырыққа тірейтін бұл апатия...》→
Dialogue: 0,0:19:15.59,0:19:18.59,Default,,0,0,0,,《Шабуыл жасамау》
Dialogue: 0,0:19:18.59,0:19:22.60,Default,,0,0,0,,Ах... Бұл! Сен кімсің! ?
Dialogue: 0,0:19:22.60,0:19:25.60,Default,,0,0,0,,Ол Берустың қамқоршысы ғана емес!
Dialogue: 0,0:19:25.60,0:19:28.60,Default,,0,0,0,,Сен мұны айтпадың ба?
Dialogue: 0,0:19:28.60,0:19:32.61,Default,,0,0,0,,Мен Беерус-саманың қожайынымын.
Dialogue: 0,0:19:32.61,0:19:35.61,Default,,0,0,0,,Иә! ? (Вегета) Ши... Ұстаз.
Dialogue: 0,0:19:35.61,0:19:38.61,Default,,0,0,0,,А... Сіз Берустың қожайынысыз ба?
Dialogue: 0,0:19:38.61,0:19:40.28,Default,,0,0,0,,Мұнда сен сияқтыларды көргіміз келмейді!
Dialogue: 0,0:19:40.28,0:19:42.52,Default,,0,0,0,,Бұл оның Берустан күшті екенін білдіре ме?
Dialogue: 0,0:19:42.52,0:19:45.52,Default,,0,0,0,,Охохо Ал ше?
Dialogue: 0,0:19:47.52,0:19:51.53,Default,,0,0,0,,Әйтеуір, кеттік. Дәмді десертті жеп қойыңыз.
Dialogue: 0,0:19:51.53,0:19:54.53,Default,,0,0,0,,Дұрыс. Күніне шектеулі шығарылымдағы 10 кәмпит!
Dialogue: 0,0:19:54.53,0:19:56.53,Default,,0,0,0,,Бес. Бес.
Dialogue: 0,0:19:56.53,0:19:59.53,Default,,0,0,0,,Әлгі жігіт... Берустың қожайыны.
Dialogue: 0,0:19:59.53,0:20:03.54,Default,,0,0,0,,Ах, Вегета. Бір ғана кеңес.
Dialogue: 0,0:20:03.54,0:20:05.54,Default,,0,0,0,,Бұл оқытудың нәтижесі ме? →
Dialogue: 0,0:20:05.54,0:20:08.54,Default,,0,0,0,,Сіз күшіңізді айтарлықтай арттырдыңыз. →
Dialogue: 0,0:20:08.54,0:20:11.48,Default,,0,0,0,,Бірақ осылай жасасаңыз, қанша уақыт болса да →
Dialogue: 0,0:20:11.48,0:20:13.48,Default,,0,0,0,,Беерус-саманы жеңе алмайсың.
Dialogue: 0,0:20:13.48,0:20:16.48,Default,,0,0,0,,Мен өз ойымды басқаруды көбірек үйренуім керек.
Dialogue: 0,0:20:16.48,0:20:18.49,Default,,0,0,0,,Егер бұл мүмкін болса...→
Dialogue: 0,0:20:18.49,0:20:21.49,Default,,0,0,0,,Сон Гоку деген Сайян да бар→
Dialogue: 0,0:20:21.49,0:20:24.49,Default,,0,0,0,,Ол асып кетуі мүмкін. (Вегета) Какарот!
Dialogue: 0,0:20:24.49,0:20:27.50,Default,,0,0,0,,Бұл оңай емес.
Dialogue: 0,0:20:27.50,0:20:29.80,Default,,0,0,0,,. (Вегета) Уф...
Dialogue: 0,0:20:31.50,0:20:33.50,Default,,0,0,0,,Бұл не?
Dialogue: 0,0:20:33.50,0:20:38.50,Default,,0,0,0,,Маған үйрете аласыз ба? Бұл сананы қалай басқаруға болады!
Dialogue: 0,0:20:45.51,0:20:49.51,Default,,0,0,0,,Маған сіздің астыңызда жаттығуға рұқсат етіңіз!
Dialogue: 0,0:20:51.52,0:20:55.52,Default,,0,0,0,,Сіз табандысыз. Біз қазірден бастап десерт жейтін боламыз.
Dialogue: 0,0:20:55.52,0:20:58.53,Default,,0,0,0,,Бұл жақсы. иә?
Dialogue: 0,0:20:58.53,0:21:02.53,Default,,0,0,0,,Жою Құдайы болған кезде осылай болады.
Dialogue: 0,0:21:02.53,0:21:04.53,Default,,0,0,0,,Барамыз ба?
Dialogue: 0,0:21:04.53,0:21:07.54,Default,,0,0,0,,Кешіріңіз. Вегета жолға түсті.
Dialogue: 0,0:21:07.54,0:21:09.47,Default,,0,0,0,,Жоқ, жоқ.
Dialogue: 0,0:21:09.47,0:21:11.47,Default,,0,0,0,,Ал егер! →
Dialogue: 0,0:21:11.47,0:21:13.47,Default,,0,0,0,,Хахаха...
Dialogue: 0,0:21:13.47,0:21:17.48,Default,,0,0,0,,Мен саған жер бетіндегі ең жақсы тағамды беремін!
Dialogue: 0,0:21:17.48,0:21:19.48,Default,,0,0,0,,Сонда ше! !
Dialogue: 0,0:21:19.48,0:21:22.48,Default,,0,0,0,,Жер бетіндегі ең дәмді нәрсе?
Dialogue: 0,0:21:22.48,0:21:26.49,Default,,0,0,0,,Иә, Whis. Бұл жер бетіндегі ең жақсы нәрсе.
Dialogue: 0,0:21:26.49,0:21:30.49,Default,,0,0,0,,Вегета. Өйткені мен жасаймын.
Dialogue: 0,0:21:30.49,0:21:33.49,Default,,0,0,0,,Жер бетіндегі ең жақсы... Иә?
Dialogue: 0,0:21:33.49,0:21:35.50,Default,,0,0,0,,Хэхе~.
Dialogue: 0,0:21:35.50,0:21:38.50,Default,,0,0,0,,Білгіңіз келсе→
Dialogue: 0,0:21:38.50,0:21:40.50,Default,,0,0,0,,Менің артымнан жүр!
Dialogue: 0,0:21:40.50,0:21:43.50,Default,,0,0,0,,Хм, бір сәт кешіріңіз.
Dialogue: 0,0:21:43.50,0:21:47.50,Default,,0,0,0,,Whis. Сондай-ақ күтіңіз.
Dialogue: 0,0:21:49.51,0:21:51.51,Default,,0,0,0,,Жарайды! Бұл мейрамхананың темпурасы →
Dialogue: 0,0:21:51.51,0:21:53.51,Default,,0,0,0,,Қытырлақ! Пурипури!
Dialogue: 0,0:21:53.51,0:21:55.52,Default,,0,0,0,,Қытырлақ! Өте дәмді!
Dialogue: 0,0:21:55.52,0:21:58.52,Default,,0,0,0,,Тамақтанғаннан кейін →
Dialogue: 0,0:21:58.52,0:22:01.52,Default,,0,0,0,,Сәлем! Менің беттерім түсіп кетті ...
Dialogue: 0,0:22:01.52,0:22:04.53,Default,,0,0,0,,Какиаж Бұл керемет болды. (Вегета) А, сен әлі тамақ жедің бе?
Dialogue: 0,0:22:04.53,0:22:07.53,Default,,0,0,0,,Бұлма-сан мені ертерек осында әкелді.
Dialogue: 0,0:22:07.53,0:22:09.53,Default,,0,0,0,,Хмм, онда!
Dialogue: 0,0:22:11.47,0:22:13.47,Default,,0,0,0,,Хмм, мен бұл иіске шыдай алмаймын.
Dialogue: 0,0:22:13.47,0:22:16.47,Default,,0,0,0,,Бұл мейрамханада құпия соусы бар мұқият таңдалған жыланбалық ұсынылады!
Dialogue: 0,0:22:16.47,0:22:19.47,Default,,0,0,0,,Бұл майлы және ерекше дәмі бар.
Dialogue: 0,0:22:19.47,0:22:21.48,Default,,0,0,0,,Сен де осында келдің бе?
Dialogue: 0,0:22:21.48,0:22:23.48,Default,,0,0,0,,Бұл соба дүкені де! ?
Dialogue: 0,0:22:23.48,0:22:26.48,Default,,0,0,0,,Бұл стейкхаус та! ? Күрсіну….
Dialogue: 0,0:22:26.48,0:22:29.48,Default,,0,0,0,,Бұл дүкеннің одені! Сиыр етінің нәзік сіңірі.
Dialogue: 0,0:22:29.48,0:22:33.49,Default,,0,0,0,,Хокухоку шалғам. (Вегета) Хаха... мұнда да?
Dialogue: 0,0:22:33.49,0:22:35.49,Default,,0,0,0,,Уф….
Dialogue: 0,0:22:35.49,0:22:37.49,Default,,0,0,0,,Бұл орын алса ше?→
Dialogue: 0,0:22:37.49,0:22:40.49,Default,,0,0,0,,Мен тамақ пісірумен құтылғанша! →
Dialogue: 0,0:22:40.49,0:22:42.49,Default,,0,0,0,,Өзіңізді дайындаңыз!
Dialogue: 0,0:22:44.50,0:22:47.50,Default,,0,0,0,,Ең алдымен, Vegeta-ның арнайы омлет күріші!
Dialogue: 0,0:22:47.50,0:22:49.50,Default,,0,0,0,,Жұмыртқа сынуы мүмкін бе?
Dialogue: 0,0:22:49.50,0:22:51.51,Default,,0,0,0,,Шулы!
Dialogue: 0,0:22:51.51,0:22:54.51,Default,,0,0,0,,Жеңіл, жеңіл.
Dialogue: 0,0:22:54.51,0:22:56.51,Default,,0,0,0,,Аа...
Dialogue: 0,0:22:58.51,0:23:00.51,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:00.51,0:23:06.52,Default,,0,0,0,,Жеңіл, жеңіл, жеңіл.... →
Dialogue: 0,0:23:06.52,0:23:08.52,Default,,0,0,0,,«Құрғап қалған болар ма?»
Dialogue: 0,0:23:13.56,0:23:16.56,Default,,0,0,0,,Бұл! бұл! Бұл... Бұл... Бұл...!
Dialogue: 0,0:23:16.56,0:23:18.57,Default,,0,0,0,,Кеттік, Whis.
Dialogue: 0,0:23:18.57,0:23:22.57,Default,,0,0,0,,Кешіріңіз. Мен оны біраз уақыт күттім.
Dialogue: 0,0:23:22.57,0:23:24.81,Default,,0,0,0,,О, күте тұрыңыз!
Dialogue: 0,0:23:24.81,0:23:26.57,Default,,0,0,0,,Иә?
Dialogue: 0,0:23:26.57,0:23:28.58,Default,,0,0,0,,Уф!
Dialogue: 0,0:23:28.58,0:23:33.58,Default,,0,0,0,,Бас тарту. Вегета тамақ пісіре алмайды.
Dialogue: 0,0:23:33.58,0:23:36.58,Default,,0,0,0,,Шулы! Тіпті сіз үлкен тамақ пісіре алмайсыз!
Dialogue: 0,0:23:36.58,0:23:42.59,Default,,0,0,0,,А-а... Бұлма саған осы уақытқа дейін не берді?
Dialogue: 0,0:23:42.59,0:23:44.59,Default,,0,0,0,,Темпура жыланбалығы кабаяки →
Dialogue: 0,0:23:44.59,0:23:47.60,Default,,0,0,0,,Оден Сукияки шаян шабу ішімдік ыстық қазан….
Dialogue: 0,0:23:47.60,0:23:50.60,Default,,0,0,0,,Мен де қайсеки асқа бардым.
Dialogue: 0,0:23:50.60,0:23:54.60,Default,,0,0,0,,Хехе…. Дәл мен ойлағандай болды.
Dialogue: 0,0:23:54.60,0:23:58.61,Default,,0,0,0,,Булма жер бетіндегі ең жақсы нәрсені жасырып тұр!
Dialogue: 0,0:23:58.61,0:24:00.61,Default,,0,0,0,,Ең жақсысы...
Dialogue: 0,0:24:00.61,0:24:04.61,Default,,0,0,0,,Бұлма аптасына бір рет болса да тамақ ішуге қарсы тұра алмайтын нәрсе!
Dialogue: 0,0:24:04.61,0:24:06.61,Default,,0,0,0,,Иә! ? Вегета...
Dialogue: 0,0:24:06.61,0:24:11.61,Default,,0,0,0,,Не? бұл. Мен қатты қызығамын.
Dialogue: 0,0:24:20.56,0:24:22.56,Default,,0,0,0,,Байқап көріңіз!
Dialogue: 0,0:24:24.57,0:24:27.57,Default,,0,0,0,,Бұл жер бетіндегі ең дәмді нәрсе ме?
Dialogue: 0,0:24:39.58,0:24:42.58,Default,,0,0,0,,Жолға шықтық, Дэнни! (Дэннидің үргені)
Dialogue: 0,0:24:42.58,0:24:44.58,Default,,0,0,0,,Керемет!
Dialogue: 0,0:24:46.59,0:24:49.59,Default,,0,0,0,,Жібектей өңешіңнен сырғып кетеді.
Dialogue: 0,0:24:49.59,0:24:53.59,Default,,0,0,0,,Бұл жұмсақ құрылымы бар талғампаз сорпа.
Dialogue: 0,0:24:53.59,0:24:57.60,Default,,0,0,0,,Ал оған ыстық су құйсаңыз да болады.
Dialogue: 0,0:24:57.60,0:25:00.60,Default,,0,0,0,,Бұлма-сан да жаман адам.
Dialogue: 0,0:25:00.60,0:25:03.60,Default,,0,0,0,,Сіздің соншалықты дәмді нәрсені жасырғаныңызға сене алар емеспін.
Dialogue: 0,0:25:03.60,0:25:07.61,Default,,0,0,0,,Мен оны қажет кезде сақтап қойдым.
Dialogue: 0,0:25:07.61,0:25:09.54,Default,,0,0,0,,Жарайды!
Dialogue: 0,0:25:09.54,0:25:12.55,Default,,0,0,0,,Хэхехе. кесе кеспенің бар екені анықталды→
Dialogue: 0,0:25:12.55,0:25:15.55,Default,,0,0,0,,Бұлма-сан, сен қатты ашуландың.
Dialogue: 0,0:25:15.55,0:25:19.55,Default,,0,0,0,,Бұлманың бірдеңені жасырып жатқанын білгеніңізге сене алмадым...
Dialogue: 0,0:25:19.55,0:25:23.56,Default,,0,0,0,,Жоқ, жоқ, онша емес...
Dialogue: 0,0:25:23.56,0:25:25.56,Default,,0,0,0,,Бірақ сенің маған осындай әдемі кеудеше сыйлағаныңа сене алар емеспін→
Dialogue: 0,0:25:25.56,0:25:28.56,Default,,0,0,0,,Сіздің жақсы жағыңыз бар емес пе?
Dialogue: 0,0:25:28.56,0:25:30.56,Default,,0,0,0,,《Мынаны кию керек! ? 》
Dialogue: 0,0:25:30.56,0:25:33.57,Default,,0,0,0,,《Күйеуіңді сондай кір киіммен сыртқа шығарсаң→
Dialogue: 0,0:25:33.57,0:25:36.57,Default,,0,0,0,,Бұл ғаламның күлкі.
Dialogue: 0,0:25:36.57,0:25:40.57,Default,,0,0,0,,Хмф! Жақында келеміз.
Dialogue: 0,0:25:40.57,0:25:43.57,Default,,0,0,0,,Бұл Берус-саманың жұлдызы.
Dialogue: 0,0:25:46.58,0:25:56.58,Default,,0,0,0,,♪♪~
Dialogue: 0,0:26:48.64,0:26:52.65,Default,,0,0,0,,О. Вегетаны жаттықтыру үшін жалғыз қалдыру өте қулық.
Dialogue: 0,0:26:52.65,0:26:55.65,Default,,0,0,0,,Тіпті мен бара аламын. Чичиге тосқауыл қойылған.
Dialogue: 0,0:26:55.65,0:26:57.65,Default,,0,0,0,,Гохан қорқады.
Dialogue: 0,0:26:57.65,0:26:59.65,Default,,0,0,0,,Мистер Уис, оның қашан келетінін білмеймін.
Dialogue: 0,0:26:59.65,0:27:04.66,Default,,0,0,0,,Әй, гүлденушілер. Жаттығуға баруыма көмектесіңізші.
Dialogue: 0,0:27:04.66,0:27:06.66,Default,,0,0,0,,Чи-Чи қорқынышты.
Dialogue: 0,0:27:06.66,0:27:09.66,Default,,0,0,0,,Келесі жолы «Dragon Ball Super»
Dialogue: 0,0:27:12.60,0:27:14.60,Default,,0,0,0,,Міндетті түрде тексеріңіз!
Dialogue: 0,0:27:16.10,0:27:22.10,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory