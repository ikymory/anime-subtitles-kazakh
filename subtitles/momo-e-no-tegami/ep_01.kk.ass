Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:01:33.84,0:01:36.17,jp,NTP,0000,0000,0000,,Өйткені, Сето ішкі теңізі жақсы.
Dialogue: 0,0:01:37.84,0:01:39.30,jp,NTP,0000,0000,0000,,Жарайды, мен айтқандай болды.
Dialogue: 0,0:01:39.71,0:01:41.63,jp,NTP,0000,0000,0000,,Аралдар өте көп.
Dialogue: 0,0:01:42.03,0:01:42.43,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:01:44.04,0:01:45.40,jp,NTP,0000,0000,0000,,Сағыныш
Dialogue: 0,0:01:45.72,0:01:48.28,jp,NTP,0000,0000,0000,,Мен соңғы рет сен туылмай тұрып келгенмін.
Dialogue: 0,0:01:49.56,0:01:50.12,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:02:04.11,0:02:06.97,jp,NTP,0000,0000,0000,,А, мүмкін бұл Шиошима шығар.
Dialogue: 0,0:02:07.49,0:02:08.90,jp,NTP,0000,0000,0000,,Қарашы, Момо.
Dialogue: 0,0:02:11.64,0:02:15.82,jp,NTP,0000,0000,0000,,Үлкен аралдың арғы жағында ол алыстан көрінеді
Dialogue: 0,0:02:16.82,0:02:17.38,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:04:46.63,0:04:51.95,jp,NTP,0000,0000,0000,,А... ештеңе өзгерген жоқ.
Dialogue: 0,0:04:54.66,0:04:55.18,jp,NTP,0000,0000,0000,,Бұл ескі.
Dialogue: 0,0:04:55.78,0:04:57.23,jp,NTP,0000,0000,0000,,Бұл жақсы нәрсе емес пе?
Dialogue: 0,0:04:58.23,0:04:59.31,jp,NTP,0000,0000,0000,,Икуко-чан
Dialogue: 0,0:04:59.64,0:05:00.59,jp,NTP,0000,0000,0000,,Апай
Dialogue: 0,0:05:01.33,0:05:03.19,jp,NTP,0000,0000,0000,,Біраз уақыт өтті
Dialogue: 0,0:05:03.74,0:05:06.63,jp,NTP,0000,0000,0000,,Ұзақ болмағанымыз үшін кешіріңіз.
Dialogue: 0,0:05:07.39,0:05:09.17,jp,NTP,0000,0000,0000,,Жақсы, сіз жақсы көрінесіз.
Dialogue: 0,0:05:09.36,0:05:11.93,jp,NTP,0000,0000,0000,,Екі қарт кісі жеңіл жүрсін.
Dialogue: 0,0:05:12.80,0:05:14.46,jp,NTP,0000,0000,0000,,Үлкен заттарды тазалаңыз.
Dialogue: 0,0:05:14.79,0:05:16.39,jp,NTP,0000,0000,0000,,Қалғаны қызықсыз
Dialogue: 0,0:05:16.81,0:05:18.13,jp,NTP,0000,0000,0000,,Аа, кешіріңіз.
Dialogue: 0,0:05:18.29,0:05:20.77,jp,NTP,0000,0000,0000,,Мен сол жерді сүртемін.
Dialogue: 0,0:05:20.85,0:05:24.02,jp,NTP,0000,0000,0000,,Жылжымалы компания барлық келісімдерді жасады.
Dialogue: 0,0:05:24.09,0:05:25.00,jp,NTP,0000,0000,0000,,Бірақ бұл жаман.
Dialogue: 0,0:05:25.18,0:05:26.54,jp,NTP,0000,0000,0000,,Ештеңе жасамаңыз.
Dialogue: 0,0:05:35.91,0:05:37.39,jp,NTP,0000,0000,0000,,Көмегің үшін рахмет.
Dialogue: 0,0:05:38.20,0:05:39.26,jp,NTP,0000,0000,0000,,Бұл менің қызымның жамбасы.
Dialogue: 0,0:05:39.67,0:05:40.42,jp,NTP,0000,0000,0000,,Момо-чан
Dialogue: 0,0:05:40.88,0:05:44.45,jp,NTP,0000,0000,0000,,Күрсін, сенің үлкен болып кеткеніңе көп болды.
Dialogue: 0,0:05:46.07,0:05:46.46,jp,NTP,0000,0000,0000,,Момо
Dialogue: 0,0:05:49.05,0:05:49.64,jp,NTP,0000,0000,0000,,Сәлем
Dialogue: 0,0:05:50.38,0:05:51.82,jp,NTP,0000,0000,0000,,Иә Сәлем
Dialogue: 0,0:05:52.67,0:05:54.27,jp,NTP,0000,0000,0000,,Саса, тезірек!
Dialogue: 0,0:05:54.62,0:05:55.98,jp,NTP,0000,0000,0000,,Үйіңізде болыңыз.
Dialogue: 0,0:05:56.26,0:05:57.54,jp,NTP,0000,0000,0000,,«Мен, Демегава, ақыры құдайдай Кираны ұстауға тырысқан зұлым ұйымның жасырын базасын тауып алдым,
Dialogue: 0,0:06:14.20,0:06:15.24,jp,NTP,0000,0000,0000,,Сіз қайда тұрасыз?
Dialogue: 0,0:06:15.41,0:06:15.98,jp,NTP,0000,0000,0000,,Мұнда
Dialogue: 0,0:06:16.76,0:06:18.31,jp,NTP,0000,0000,0000,,Мына жерде ағамның үйі.
Dialogue: 0,0:06:27.56,0:06:29.16,jp,NTP,0000,0000,0000,,Мен мұны ертерек көргенде таң қалдым.
Dialogue: 0,0:06:29.56,0:06:31.46,jp,NTP,0000,0000,0000,,Сіз өте үлкен көпір салдыңыз.
Dialogue: 0,0:06:31.74,0:06:34.02,jp,NTP,0000,0000,0000,,Ол қыркүйекте ашылады.
Dialogue: 0,0:06:34.27,0:06:35.40,jp,NTP,0000,0000,0000,,Бұл ыңғайлы болады.
Dialogue: 0,0:06:36.18,0:06:38.40,jp,NTP,0000,0000,0000,,Хоньяга Энкаваринка
Dialogue: 0,0:06:38.87,0:06:44.02,jp,NTP,0000,0000,0000,,Барлығы өтіп бара жатқандықтан, аралдың қаңырап қалғанын қаламаймыз.
Dialogue: 0,0:06:44.34,0:06:46.13,jp,NTP,0000,0000,0000,,Аа, дұрыс.
Dialogue: 0,0:06:48.13,0:06:50.39,jp,NTP,0000,0000,0000,,Ей, сіздің денеңіз өте жақсы.
Dialogue: 0,0:06:50.80,0:06:52.62,jp,NTP,0000,0000,0000,,Бұл жерде енді ештеңе жоқ.
Dialogue: 0,0:06:53.40,0:06:54.44,jp,NTP,0000,0000,0000,,Ол үшін уайымдама, темекі тарт
Dialogue: 0,0:06:55.33,0:06:56.01,jp,NTP,0000,0000,0000,,Момо-чан
Dialogue: 0,0:06:56.84,0:07:01.61,jp,NTP,0000,0000,0000,,Икуко бала кезінде демікпеден айығу үшін осында бір жылдай уақыт өткізді.
Dialogue: 0,0:07:01.98,0:07:02.85,jp,NTP,0000,0000,0000,,Сіз оны ести аласыз.
Dialogue: 0,0:07:06.28,0:07:08.41,jp,NTP,0000,0000,0000,,Мен бірден жұмыс істегім келетінін айттым.
Dialogue: 0,0:07:08.64,0:07:11.13,jp,NTP,0000,0000,0000,,Соңында бұл пәтерге не болды?
Dialogue: 0,0:07:12.30,0:07:13.00,jp,NTP,0000,0000,0000,,Мен оны саттым.
Dialogue: 0,0:07:13.85,0:07:15.79,jp,NTP,0000,0000,0000,,Қарызға берсем, табыс табатын едім.
Dialogue: 0,0:07:16.59,0:07:17.71,jp,NTP,0000,0000,0000,,Мен жеткілікті деп ойладым.
Dialogue: 0,0:07:18.56,0:07:19.54,jp,NTP,0000,0000,0000,,Хоука
Dialogue: 0,0:07:20.52,0:07:22.52,jp,NTP,0000,0000,0000,,Иә, бұл рас.
Dialogue: 0,0:07:22.88,0:07:25.71,jp,NTP,0000,0000,0000,,Шындық, біз де жалғыздық.
Dialogue: 0,0:07:25.83,0:07:27.45,jp,NTP,0000,0000,0000,,Бұл өте жанды!
Dialogue: 0,0:07:28.05,0:07:30.62,jp,NTP,0000,0000,0000,,Менің көршімдегі адамдардың барлығы қарт адамдар.
Dialogue: 0,0:07:30.81,0:07:32.58,jp,NTP,0000,0000,0000,,Жастар қабылданады.
Dialogue: 0,0:07:33.07,0:07:35.94,jp,NTP,0000,0000,0000,,Әй, сен мені де жастардың қатарына қосасың.
Dialogue: 0,0:07:36.13,0:07:37.82,jp,NTP,0000,0000,0000,,Иә, бұл тамаша.
Dialogue: 0,0:07:42.70,0:07:43.68,jp,NTP,0000,0000,0000,,Пошта
Dialogue: 0,0:07:45.05,0:07:46.54,jp,NTP,0000,0000,0000,,Иччан?
Dialogue: 0,0:07:47.40,0:07:49.20,jp,NTP,0000,0000,0000,,О, Ко-чан
Dialogue: 0,0:07:49.50,0:07:50.91,jp,NTP,0000,0000,0000,,Біраз уақыт өтті
Dialogue: 0,0:07:51.17,0:07:54.02,jp,NTP,0000,0000,0000,,Сенің келе жатқаныңды естіп, асыға күттім.
Dialogue: 0,0:07:54.40,0:07:55.27,jp,NTP,0000,0000,0000,,Бүгін болды ма?
Dialogue: 0,0:07:56.07,0:07:57.66,jp,NTP,0000,0000,0000,,Кәсіпкерге не болды?
Dialogue: 0,0:07:58.01,0:08:00.49,jp,NTP,0000,0000,0000,,Согенамон, мен баяғыда тастадым.
Dialogue: 0,0:08:01.13,0:08:02.44,jp,NTP,0000,0000,0000,,Мен қарама-қарсы бағытта тұрмын.
Dialogue: 0,0:08:02.74,0:08:04.47,jp,NTP,0000,0000,0000,,Көптен бері солай.
Dialogue: 0,0:08:08.24,0:08:08.77,jp,NTP,0000,0000,0000,,Момойо
Dialogue: 0,0:08:11.39,0:08:14.41,jp,NTP,0000,0000,0000,,Сайвайичи Көрші үйге қайта көшпекші.
Dialogue: 0,0:08:14.51,0:08:17.03,jp,NTP,0000,0000,0000,,Уайымдамаңыз, мен әрқашан сәтсіздікке ұшырадым.
Dialogue: 0,0:08:17.41,0:08:19.65,jp,NTP,0000,0000,0000,,Ах, мен мұны қайталадым.
Dialogue: 0,0:08:19.79,0:08:21.25,jp,NTP,0000,0000,0000,,Әдеттегідей.
Dialogue: 0,0:08:28.44,0:08:30.90,jp,NTP,0000,0000,0000,,Әй, менің жұмысым бар, ендеше тағы да жеңілдеп алайық.
Dialogue: 0,0:08:32.16,0:08:34.65,jp,NTP,0000,0000,0000,,Бұл шынымен өзгермейді, бұл күлкілі
Dialogue: 0,0:08:36.24,0:08:38.45,jp,NTP,0000,0000,0000,,О, тоқтады.
Dialogue: 0,0:08:40.48,0:08:42.58,jp,NTP,0000,0000,0000,,Менің жиенім ерте көктемде кенет пайда болды.
Dialogue: 0,0:08:42.85,0:08:44.78,jp,NTP,0000,0000,0000,,Сағат жасаушыға қарасам да түзетпейді.
Dialogue: 0,0:08:45.58,0:08:50.16,jp,NTP,0000,0000,0000,,Мен көріп үйренген нәрселер мені тыныштандырмайды, сондықтан мен оларды сол күйінде қалдырамын.
Dialogue: 0,0:08:50.47,0:08:52.92,jp,NTP,0000,0000,0000,,Иә, ерте көктемде
Dialogue: 0,0:08:53.83,0:08:55.55,jp,NTP,0000,0000,0000,,Егер кедергі болса, оны алып тастаңыз.
Dialogue: 0,0:08:57.46,0:08:58.31,jp,NTP,0000,0000,0000,,Момо-чан
Dialogue: 0,0:08:59.33,0:09:02.64,jp,NTP,0000,0000,0000,,Сораға заттарымды беруге көмектесіңізші.
Dialogue: 0,0:09:03.92,0:09:04.44,jp,NTP,0000,0000,0000,,Сора
Dialogue: 0,0:09:12.49,0:09:13.66,jp,NTP,0000,0000,0000,,келе жатыр
Dialogue: 0,0:09:27.87,0:09:29.95,jp,NTP,0000,0000,0000,,Қайырлы таң.
Dialogue: 0,0:09:30.39,0:09:33.62,jp,NTP,0000,0000,0000,,Қарттар заттарды тастамайды
Dialogue: 0,0:09:35.53,0:09:37.70,jp,NTP,0000,0000,0000,,Титан шабуылына ұшыраған Трост ауданында,
Dialogue: 0,0:09:39.44,0:09:41.93,jp,NTP,0000,0000,0000,,Момо-чан, оны алып келші.
Dialogue: 0,0:09:49.58,0:09:50.98,jp,NTP,0000,0000,0000,,Иә, еңбектеріңіз үшін рахмет.
Dialogue: 0,0:10:05.87,0:10:07.45,jp,NTP,0000,0000,0000,,Эй, сенің көздерің керемет.
Dialogue: 0,0:10:09.12,0:10:10.14,jp,NTP,0000,0000,0000,,Оны ашыңыз.
Dialogue: 0,0:10:24.25,0:10:25.18,jp,NTP,0000,0000,0000,,Маған қара
Dialogue: 0,0:10:26.39,0:10:28.43,jp,NTP,0000,0000,0000,,...
Dialogue: 0,0:10:42.41,0:10:45.29,jp,NTP,0000,0000,0000,,Қарияның әкесі жиналды.
Dialogue: 0,0:10:45.63,0:10:47.87,jp,NTP,0000,0000,0000,,Әлі көп жол бар
Dialogue: 0,0:10:48.37,0:10:51.16,jp,NTP,0000,0000,0000,,Бұл Эдо дәуірінің сары мұқабасы сияқты.
Dialogue: 0,0:10:51.69,0:10:54.57,jp,NTP,0000,0000,0000,,Әрине, сирек кездесетін зат.
Dialogue: 0,0:10:56.19,0:10:59.48,jp,NTP,0000,0000,0000,,Егер сізге ұнаса, оны кез келген уақытта көріңіз.
Dialogue: 0,0:11:01.17,0:11:05.83,jp,NTP,0000,0000,0000,,Енді кенеттен оқыс оқиғалардан сақ болыңыз.
Dialogue: 0,0:11:40.91,0:11:43.14,jp,NTP,0000,0000,0000,,Иә, мен естіген жоқпын.
Dialogue: 0,0:11:43.14,0:11:46.62,jp,NTP,0000,0000,0000,,Мен сізге Имабариде екінші сыныпты көмекші сынып бар дедім.
Dialogue: 0,0:11:47.14,0:11:48.26,jp,NTP,0000,0000,0000,,Мен мұны білемін.
Dialogue: 0,0:11:48.56,0:11:50.55,jp,NTP,0000,0000,0000,,Бірақ сіз ертеңнен кейін басталады дедіңіз.
Dialogue: 0,0:11:50.76,0:11:52.27,jp,NTP,0000,0000,0000,,Әй, сен мұны айтпадың ба?
Dialogue: 0,0:11:52.99,0:11:55.65,jp,NTP,0000,0000,0000,,Мен қателік жібердім деп ойлаймын, ол ертең басталады.
Dialogue: 0,0:11:56.10,0:11:57.37,jp,NTP,0000,0000,0000,,Бұл қауіпті болды.
Dialogue: 0,0:11:59.67,0:12:02.49,jp,NTP,0000,0000,0000,,Мен жалғыз не істеуім керек?
Dialogue: 0,0:12:03.42,0:12:06.11,jp,NTP,0000,0000,0000,,Буып-түю және үй тапсырмасы болады.
Dialogue: 0,0:12:06.53,0:12:10.03,jp,NTP,0000,0000,0000,,Олар басқа тараптың жұмысын сол қалпында беруге болады, сондықтан оны жасай алмайсыз дейді.
Dialogue: 0,0:12:10.78,0:12:12.98,jp,NTP,0000,0000,0000,,Олар – Құдайдың үкімі еді.
Dialogue: 0,0:12:13.19,0:12:14.22,jp,NTP,0000,0000,0000,,Ванна қайнап жатыр.
Dialogue: 0,0:12:14.48,0:12:16.39,jp,NTP,0000,0000,0000,,Мен қазір сусабын беремін, ендеше кір.
Dialogue: 0,0:12:54.09,0:12:54.90,jp,NTP,0000,0000,0000,,Әкем
Dialogue: 0,0:12:55.88,0:12:56.99,jp,NTP,0000,0000,0000,,Жетеді
Dialogue: 0,0:12:57.94,0:12:59.30,jp,NTP,0000,0000,0000,,Мен әкемді жек көремін.
Dialogue: 0,0:13:04.62,0:13:05.96,jp,NTP,0000,0000,0000,,Енді қайтып келудің қажеті жоқ.
Dialogue: 0,0:13:22.40,0:13:24.88,jp,NTP,0000,0000,0000,,Сонымен зерттеу кемесі жақсы болды ма?
Dialogue: 0,0:13:27.28,0:13:30.60,jp,NTP,0000,0000,0000,,Иә... Сонымен қожайын
Dialogue: 0,0:13:30.98,0:13:32.43,jp,NTP,0000,0000,0000,,Менің күйеуім аман, солай ма?
Dialogue: 0,0:14:35.57,0:14:36.80,jp,NTP,0000,0000,0000,,Мен не жазғым келді?
Dialogue: 0,0:14:38.05,0:14:38.67,jp,NTP,0000,0000,0000,,Әкем
Dialogue: 0,0:15:03.85,0:15:04.98,jp,NTP,0000,0000,0000,,Жүр, кеттік.
Dialogue: 0,0:15:16.22,0:15:17.82,jp,NTP,0000,0000,0000,,Әзірше осы.
Dialogue: 0,0:15:18.39,0:15:20.77,jp,NTP,0000,0000,0000,,Ей, үлкен супермаркеттер жоқ.
Dialogue: 0,0:15:21.27,0:15:22.91,jp,NTP,0000,0000,0000,,Иә, дүкен де жоқ.
Dialogue: 0,0:15:24.04,0:15:24.64,jp,NTP,0000,0000,0000,,Ах.
Dialogue: 0,0:15:30.00,0:15:33.27,jp,NTP,0000,0000,0000,,Барлығы асығыс. Тез шешіңіз.
Dialogue: 0,0:15:34.44,0:15:36.80,jp,NTP,0000,0000,0000,,Біраз ауыр, бірақ кеткенде сұраймын.
Dialogue: 0,0:15:41.98,0:15:43.56,jp,NTP,0000,0000,0000,,Ол сен сияқты жас емес.
Dialogue: 0,0:15:43.93,0:15:45.02,jp,NTP,0000,0000,0000,,Мен сенімен сөйлесейін бе?
Dialogue: 0,0:15:45.50,0:15:46.13,jp,NTP,0000,0000,0000,,Тоқта!
Dialogue: 0,0:15:47.67,0:15:49.81,jp,NTP,0000,0000,0000,,Сәлем балалар
Dialogue: 0,0:15:51.34,0:15:53.91,jp,NTP,0000,0000,0000,,Сонда Йота-кунның үйі де Миканоока.
Dialogue: 0,0:15:54.25,0:15:54.54,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:15:55.52,0:15:56.78,jp,NTP,0000,0000,0000,,Бірақ бәрі жақсы болды.
Dialogue: 0,0:15:56.94,0:15:58.44,jp,NTP,0000,0000,0000,,Менің бір алтыншы сыныпта оқитын балам бар.
Dialogue: 0,0:15:59.44,0:16:00.66,jp,NTP,0000,0000,0000,,Маған көп нәрсені айтып беріңізші.
Dialogue: 0,0:16:13.62,0:16:14.29,jp,NTP,0000,0000,0000,,Йота-кун
Dialogue: 0,0:16:15.39,0:16:17.28,jp,NTP,0000,0000,0000,,Бұл баланы қосуға бола ма?
Dialogue: 0,0:16:17.73,0:16:19.43,jp,NTP,0000,0000,0000,,Иә, иә
Dialogue: 0,0:16:20.34,0:16:20.69,jp,NTP,0000,0000,0000,,Момо
Dialogue: 0,0:16:26.60,0:16:27.10,jp,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:16:31.49,0:16:32.24,jp,NTP,0000,0000,0000,,Сонда кездескенше
Dialogue: 0,0:16:33.23,0:16:33.63,jp,NTP,0000,0000,0000,,Уми
Dialogue: 0,0:16:41.08,0:16:42.73,jp,NTP,0000,0000,0000,,Мені қайта шақырыңыз.
Dialogue: 0,0:16:46.89,0:16:47.74,jp,NTP,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:16:57.77,0:16:59.04,jp,NTP,0000,0000,0000,,Күріш шарларын жеңіз.
Dialogue: 0,0:16:59.41,0:17:00.90,jp,NTP,0000,0000,0000,,Пудингті де жеуге болады.
Dialogue: 0,0:17:02.34,0:17:03.65,jp,NTP,0000,0000,0000,,Менің де бармауым керек.
Dialogue: 0,0:17:04.54,0:17:06.63,jp,NTP,0000,0000,0000,,Мен сені келесі жолы сол жерге қайта апарамын.
Dialogue: 0,0:17:06.87,0:17:09.54,jp,NTP,0000,0000,0000,,Бүгін телефоншы келеді, мен үйде боламын.
Dialogue: 0,0:17:10.52,0:17:11.03,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:17:12.20,0:17:12.71,jp,NTP,0000,0000,0000,,Джейн
Dialogue: 0,0:17:58.41,0:17:59.44,jp,NTP,0000,0000,0000,,Бұл не болды?
Dialogue: 0,0:18:59.50,0:19:02.83,jp,NTP,0000,0000,0000,,Төлем сіздің келесі шотыңызға қосылады.
Dialogue: 0,0:19:03.20,0:19:04.84,jp,NTP,0000,0000,0000,,Отбасыңызға айтыңыз
Dialogue: 0,0:19:07.37,0:19:08.07,jp,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:19:08.33,0:19:09.63,jp,NTP,0000,0000,0000,,Еңбегіңіз үшін рахмет.
Dialogue: 0,0:19:19.28,0:19:20.01,jp,NTP,0000,0000,0000,,Сіз оны жаптыңыз ба?
Dialogue: 0,0:19:49.48,0:19:50.29,jp,NTP,0000,0000,0000,,Момога...
Dialogue: 0,0:20:01.49,0:20:02.64,jp,NTP,0000,0000,0000,,Момо-чан
Dialogue: 0,0:20:04.90,0:20:06.58,jp,NTP,0000,0000,0000,,Қайда бара жатырсың?
Dialogue: 0,0:20:08.18,0:20:10.45,jp,NTP,0000,0000,0000,,Жол тар. Көліктерден сақ болыңыз.
Dialogue: 0,0:20:14.35,0:20:14.74,jp,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:20:37.48,0:20:38.12,jp,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:22:05.88,0:22:09.00,jp,NTP,0000,0000,0000,,Бұл менің қиялым ғана болды.
Dialogue: 0,0:22:24.89,0:22:27.32,jp,NTP,0000,0000,0000,,Бұл қайда?
Dialogue: 0,0:22:39.17,0:22:41.06,jp,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:22:42.75,0:22:45.38,jp,NTP,0000,0000,0000,,Аралда адасып қалсаң, теңізді ізде.
Dialogue: 0,0:22:46.11,0:22:50.07,jp,NTP,0000,0000,0000,,Бұл жол аралды айналып өтеді, сондықтан сіз бірден орала аласыз.
Dialogue: 0,0:22:51.53,0:22:52.01,jp,NTP,0000,0000,0000,,Эрен Егердің жұмбақ Титанның күшін босатып жіберген сәті
Dialogue: 0,0:22:53.22,0:22:53.78,jp,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:23:02.66,0:23:05.51,jp,NTP,0000,0000,0000,,Сен ана жақта, мен ана жақтамын.
Dialogue: 0,0:23:16.04,0:23:17.86,jp,NTP,0000,0000,0000,,Сабан қайыққа назар аударамыз ба?
Dialogue: 0,0:23:29.21,0:23:30.44,jp,NTP,0000,0000,0000,,Ешкім
Dialogue: 0,0:23:32.57,0:23:37.04,jp,NTP,0000,0000,0000,,Менің атам жасады, бірақ ол бір жерге кеткен сияқты.
Dialogue: 0,0:23:46.21,0:23:48.87,jp,NTP,0000,0000,0000,,Қараңдаршы, бұл дайын сабан қайық.
Dialogue: 0,0:23:50.19,0:23:51.68,jp,NTP,0000,0000,0000,,Әдемі емес пе?
Dialogue: 0,0:23:53.57,0:23:55.80,jp,NTP,0000,0000,0000,,Оны Миядзима-сан деп аталатын фестиваль үшін пайдаланыңыз.
Dialogue: 0,0:23:56.64,0:24:00.76,jp,NTP,0000,0000,0000,,Мынаны жағажайдан жуайық, иә?
Dialogue: 0,0:24:04.99,0:24:07.14,jp,NTP,0000,0000,0000,,Қызық, қария қайда кетті?
Dialogue: 0,0:24:09.62,0:24:11.34,jp,NTP,0000,0000,0000,,Мен міндетті түрде барамын.
Dialogue: 0,0:24:13.09,0:24:14.70,jp,NTP,0000,0000,0000,,Анам жақында үйге келеді.
Dialogue: 0,0:24:15.10,0:24:17.11,jp,NTP,0000,0000,0000,,Мен пирске барамын. Рақмет сізге.
Dialogue: 0,0:24:22.18,0:24:23.21,jp,NTP,0000,0000,0000,,Мияура
Dialogue: 0,0:24:24.26,0:24:25.78,jp,NTP,0000,0000,0000,,Мен де ертең секіремін.
Dialogue: 0,0:24:26.13,0:24:27.29,jp,NTP,0000,0000,0000,,Қаласаңыз келіңіз.
Dialogue: 0,0:24:35.40,0:24:36.20,jp,NTP,0000,0000,0000,,Ата
Dialogue: 0,0:24:37.23,0:24:38.58,jp,NTP,0000,0000,0000,,Қайда кетті?
Dialogue: 0,0:24:39.08,0:24:40.96,jp,NTP,0000,0000,0000,,Мені тастап кетсең, қиындық болмас па еді?
Dialogue: 0,0:24:56.69,0:24:58.25,jp,NTP,0000,0000,0000,,Жарайды, мен қараймын.
Dialogue: 0,0:24:59.11,0:25:00.15,jp,NTP,0000,0000,0000,,Мен қатты қорқамын.
Dialogue: 0,0:25:00.79,0:25:01.14,jp,NTP,0000,0000,0000,,Бұл
Dialogue: 0,0:25:03.26,0:25:04.68,jp,NTP,0000,0000,0000,,Ол жабық емес.
Dialogue: 0,0:25:05.03,0:25:06.92,jp,NTP,0000,0000,0000,,Ондай ештеңе болған жоқ.
Dialogue: 0,0:25:07.29,0:25:08.28,jp,NTP,0000,0000,0000,,Асығыңыз!
Dialogue: 0,0:25:08.73,0:25:09.85,jp,NTP,0000,0000,0000,,Бетіме қарау – мен бере алатын ең үлкен жеңілдік.
Dialogue: 0,0:25:10.87,0:25:13.95,jp,NTP,0000,0000,0000,,Сіз маған әрқашан есіктің құлыптаулы екеніне көз жеткізіңіз деп айтасыз.
Dialogue: 0,0:25:15.37,0:25:17.14,jp,NTP,0000,0000,0000,,Мықты болыңыз
Dialogue: 0,0:25:17.19,0:25:17.71,jp,NTP,0000,0000,0000,,Не болды, Ниа?
Dialogue: 0,0:25:20.06,0:25:21.46,jp,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:25:55.44,0:25:57.73,jp,NTP,0000,0000,0000,,Нені шулатып жатырсың?
Dialogue: 0,0:25:58.74,0:26:01.30,jp,NTP,0000,0000,0000,,Енді мені бірдеңе жалап жіберді.
Dialogue: 0,0:26:04.16,0:26:05.17,jp,NTP,0000,0000,0000,,Онда ештеңе жоқ
Dialogue: 0,0:26:06.73,0:26:08.38,jp,NTP,0000,0000,0000,,Бар
Dialogue: 0,0:26:10.52,0:26:11.29,jp,NTP,0000,0000,0000,,Онда жоқ.
Dialogue: 0,0:26:24.21,0:26:25.92,jp,NTP,0000,0000,0000,,Мені шынымен қуып жіберді.
Dialogue: 0,0:26:26.40,0:26:29.45,jp,NTP,0000,0000,0000,,Мен саған қазірден бастап есігіңді құлыптаудан сақ бол деп жай айтып отырған жоқпын.
Dialogue: 0,0:26:29.98,0:26:33.23,jp,NTP,0000,0000,0000,,Мен үш пудинг жеу мүмкін емес.
Dialogue: 0,0:26:33.56,0:26:35.20,jp,NTP,0000,0000,0000,,Сіз бұған ашуланбайсыз.
Dialogue: 0,0:26:36.14,0:26:38.01,jp,NTP,0000,0000,0000,,Әрине, мұндай нәрсе бар
Dialogue: 0,0:26:38.21,0:26:39.03,jp,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,0:26:39.24,0:26:39.78,jp,NTP,0000,0000,0000,,Бар
Dialogue: 0,0:26:40.05,0:26:42.18,jp,NTP,0000,0000,0000,,Сіз жоқсыз, тоқтатыңыз.
Dialogue: 0,0:26:52.49,0:26:53.00,jp,NTP,0000,0000,0000,,Не болды, апа?
Dialogue: 0,0:26:55.22,0:26:57.15,jp,NTP,0000,0000,0000,,Эй, Токиоға қайтайық.
Dialogue: 0,0:27:00.24,0:27:01.63,jp,NTP,0000,0000,0000,,Менің тұратын жерім жоқ.
Dialogue: 0,0:27:02.40,0:27:03.89,jp,NTP,0000,0000,0000,,Мен білемін, бірақ
Dialogue: 0,0:27:04.25,0:27:05.58,jp,NTP,0000,0000,0000,,Көп ұзамай үйреніп кетесің.
Dialogue: 0,0:27:05.58,0:27:06.77,jp,NTP,0000,0000,0000,,Иә, же, же.
Dialogue: 0,0:27:24.35,0:27:25.35,jp,NTP,0000,0000,0000,,Маған орнатылған тыңшылық құрылғыдан басқа, осы бөлмеде ештеңе жоқ
Dialogue: 0,0:27:26.70,0:27:30.56,jp,NTP,0000,0000,0000,,Сіз осында келе жатырсыз. Анам өзі шешім қабылдады.
Dialogue: 0,0:27:31.25,0:27:32.35,jp,NTP,0000,0000,0000,,Менің әңгімем
Dialogue: 0,0:27:32.73,0:27:35.54,jp,NTP,0000,0000,0000,,Сіз не туралы айтып отырсыз? Мен сенімен сөйлескенімде, сен де жақсымын дедің.
Dialogue: 0,0:27:37.66,0:27:39.64,jp,NTP,0000,0000,0000,,Мен оны жек көрмейтінімді айттым.
Dialogue: 0,0:27:40.26,0:27:43.03,jp,NTP,0000,0000,0000,,Осында бұдан былай қалсам, жынды боламын.
Dialogue: 0,0:27:43.03,0:27:43.95,jp,NTP,0000,0000,0000,,Ей, үйге қайтайық.
Dialogue: 0,0:27:44.62,0:27:47.43,jp,NTP,0000,0000,0000,,Егер сізге онша ұнамаса, үйге жалғыз қайтыңыз.
Dialogue: 0,0:27:47.80,0:27:48.40,jp,NTP,0000,0000,0000,,Мен үйге барамын.
Dialogue: 0,0:27:49.01,0:27:49.64,jp,NTP,0000,0000,0000,,тіпті Эден кампусында да — қайдағы қырағы көздердің қашан қарап тұрғанын білмейсің.
Dialogue: 0,0:27:51.51,0:27:53.20,jp,NTP,0000,0000,0000,,Ананың арамдығы
Dialogue: 0,0:27:57.27,0:28:00.22,jp,NTP,0000,0000,0000,,Йоккора Шотто
Dialogue: 0,0:28:17.49,0:28:20.61,jp,NTP,0000,0000,0000,,Егер Йота-кун шақырса, бару керек деп ойлаймын.
Dialogue: 0,0:28:20.94,0:28:23.35,jp,NTP,0000,0000,0000,,Затыңызды реттейтін уақыт келді.
Dialogue: 0,0:28:24.53,0:28:26.02,jp,NTP,0000,0000,0000,,Таңғы асты дұрыс ішіңіз
Dialogue: 0,0:28:26.65,0:28:30.02,jp,NTP,0000,0000,0000,,Мен апайдан түскі ас сұрадым, өтінемін, барып маған беріңізші.
Dialogue: 0,0:28:30.50,0:28:31.34,jp,NTP,0000,0000,0000,,Ал, мен барамын.
Dialogue: 0,0:28:34.98,0:28:35.60,jp,NTP,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,0:28:44.31,0:28:46.82,jp,NTP,0000,0000,0000,,Икуко шығып кетті.
Dialogue: 0,0:28:47.01,0:28:49.41,jp,NTP,0000,0000,0000,,Сіз не істеп жатырсыз? Тезірек, анашым.
Dialogue: 0,0:28:50.87,0:28:53.50,jp,NTP,0000,0000,0000,,Енді қарын тоқуды жасаймыз ба?
Dialogue: 0,0:28:54.10,0:28:56.00,jp,NTP,0000,0000,0000,,Момоның жағдайы қалай?
Dialogue: 0,0:28:56.21,0:28:58.67,jp,NTP,0000,0000,0000,,Міне, мен қазір ұйықтап жатқан шығармын.
Dialogue: 0,0:28:59.63,0:29:01.89,jp,NTP,0000,0000,0000,,Менің қарным одан да көп.
Dialogue: 0,0:29:02.02,0:29:03.70,jp,NTP,0000,0000,0000,,Мен келісемін.
Dialogue: 0,0:29:11.91,0:29:12.92,jp,NTP,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:29:14.00,0:29:14.59,jp,NTP,0000,0000,0000,,купальник?
Dialogue: 0,0:29:19.05,0:29:20.12,jp,NTP,0000,0000,0000,,Келеді
Dialogue: 0,0:29:21.55,0:29:24.32,jp,NTP,0000,0000,0000,,Бұл емес. Бүгіннен бастап сен біздің доссың.
Dialogue: 0,0:29:24.78,0:29:25.26,jp,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:29:25.95,0:29:26.56,jp,NTP,0000,0000,0000,,Иә.
Dialogue: 0,0:29:26.56,0:29:27.00,jp,NTP,0000,0000,0000,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:29:27.17,0:29:27.82,jp,NTP,0000,0000,0000,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:29:28.33,0:29:29.70,jp,NTP,0000,0000,0000,,Қыздардың көп болғанына қуаныштымын.
Dialogue: 0,0:29:30.17,0:29:31.72,jp,NTP,0000,0000,0000,,Танысқаныма қуаныштымын, Мияура мырза
Dialogue: 0,0:29:32.50,0:29:33.10,jp,NTP,0000,0000,0000,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:29:33.56,0:29:34.78,jp,NTP,0000,0000,0000,,Жарайды, кеттік.
Dialogue: 0,0:29:35.66,0:29:36.47,jp,NTP,0000,0000,0000,,Дайын бол
Dialogue: 0,0:29:36.81,0:29:39.24,jp,NTP,0000,0000,0000,,Бұл аздап қымбат, бірақ бір рет секірсең, жақсы болады.
Dialogue: 0,0:29:58.70,0:29:59.53,jp,NTP,0000,0000,0000,,Қараңыз
Dialogue: 0,0:30:03.13,0:30:05.00,jp,NTP,0000,0000,0000,,Міне, осылай істейсің.
Dialogue: 0,0:30:05.38,0:30:07.24,jp,NTP,0000,0000,0000,,Йо-чан, тез кел!
Dialogue: 0,0:30:07.50,0:30:08.42,jp,NTP,0000,0000,0000,,Қараңыз.
Dialogue: 0,0:30:18.76,0:30:19.69,jp,NTP,0000,0000,0000,,Оны жасауға бола ма?
Dialogue: 0,0:30:30.72,0:30:31.77,jp,NTP,0000,0000,0000,,Оны асыра алмаңыз
Dialogue: 0,0:30:32.18,0:30:33.24,jp,NTP,0000,0000,0000,,Хорья
Dialogue: 0,0:30:44.54,0:30:45.68,jp,NTP,0000,0000,0000,,көбірек
Dialogue: 0,0:31:00.07,0:31:01.77,jp,NTP,0000,0000,0000,,Момо-чан, үйге барасың ба?
Dialogue: 0,0:31:02.12,0:31:02.58,jp,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:32:06.74,0:32:08.00,jp,NTP,0000,0000,0000,,Кувахара Кувахара
Dialogue: 0,0:32:08.39,0:32:10.84,jp,NTP,0000,0000,0000,,Маған жаңбыр мен күн күркіреуі ұнамайды.
Dialogue: 0,0:32:12.14,0:32:13.26,jp,NTP,0000,0000,0000,,Мен оны қатты жек көремін.
Dialogue: 0,0:32:13.74,0:32:20.16,jp,NTP,0000,0000,0000,,Иеміздің қазіргі келбеті суға төзімді болып көрінеді.
Dialogue: 0,0:32:21.43,0:32:23.07,jp,NTP,0000,0000,0000,,Қойшы.
Dialogue: 0,0:32:39.73,0:32:41.26,jp,NTP,0000,0000,0000,,Қазір не таң қалдырады?
Dialogue: 0,0:32:42.67,0:32:43.75,jp,NTP,0000,0000,0000,,...
Dialogue: 0,0:32:44.52,0:32:47.29,jp,NTP,0000,0000,0000,,Бір рет қоныстанған соң, өзіңді-өзің қамтамасыз ете алмайсың.
Dialogue: 0,0:32:47.96,0:32:49.84,jp,NTP,0000,0000,0000,,Барлық осы көк мандарин апельсиндері
Dialogue: 0,0:32:50.12,0:32:51.84,jp,NTP,0000,0000,0000,,Менің ет жегім келеді.
Dialogue: 0,0:32:52.76,0:32:54.01,jp,NTP,0000,0000,0000,,Шынында да
Dialogue: 0,0:33:12.46,0:33:14.73,jp,NTP,0000,0000,0000,,Мен жамбасқа отырдым.
Dialogue: 0,0:33:25.69,0:33:28.31,jp,NTP,0000,0000,0000,,Сіз бізді көре аласыз.
Dialogue: 0,0:33:28.97,0:33:30.06,jp,NTP,0000,0000,0000,,Сізге қалай ұнайды?
Dialogue: 0,0:33:46.63,0:33:49.06,jp,NTP,0000,0000,0000,,Мандарин бағы қайтадан жойылды.
Dialogue: 0,0:33:49.56,0:33:51.73,jp,NTP,0000,0000,0000,,Мемлекеттік мекеме не істейді?
Dialogue: 0,0:33:52.30,0:33:55.04,jp,NTP,0000,0000,0000,,Тездетіп, қабандардан құтыл.
Dialogue: 0,0:33:56.06,0:33:57.07,jp,NTP,0000,0000,0000,,Не болды?
Dialogue: 0,0:34:05.68,0:34:08.88,jp,NTP,0000,0000,0000,,Мені аралдың лимонынан жасалған Йокан деп атама.
Dialogue: 0,0:34:10.09,0:34:12.95,jp,NTP,0000,0000,0000,,Біз өлген әкемді ұнатқандықтан жиналдық.
Dialogue: 0,0:34:14.26,0:34:17.97,jp,NTP,0000,0000,0000,,Тұмар деп атағанын естідім.
Dialogue: 0,0:34:18.44,0:34:22.26,jp,NTP,0000,0000,0000,,Басында құдай болған нәрсе құлап, құбыжық болып кеткен сияқты.
Dialogue: 0,0:34:23.59,0:34:24.37,jp,NTP,0000,0000,0000,,Құдай
Dialogue: 0,0:34:29.74,0:34:30.67,jp,NTP,0000,0000,0000,,Іс жүзінде
Dialogue: 0,0:34:31.80,0:34:34.82,jp,NTP,0000,0000,0000,,Әкем ол жұмыртқаны иіскегенін айтты.
Dialogue: 0,0:34:36.71,0:34:40.24,jp,NTP,0000,0000,0000,,Кішкентай кезімде жасырын бірдеңе үйреттің.
Dialogue: 0,0:34:40.39,0:34:43.37,jp,NTP,0000,0000,0000,,Бұл өте күлкілі болды
Dialogue: 0,0:34:44.99,0:34:48.55,jp,NTP,0000,0000,0000,,Жеңдер. Бұл өте тәтті емес және өте дәмді.
Dialogue: 0,0:34:51.05,0:34:53.03,jp,NTP,0000,0000,0000,,Мен, мен қазір ғана болдым.
Dialogue: 0,0:35:00.03,0:35:02.68,jp,NTP,0000,0000,0000,,Иә, сондықтан да солай.
Dialogue: 0,0:35:03.25,0:35:06.68,jp,NTP,0000,0000,0000,,Мен саған айтамын, бірақ бұл туралы ешкімге айтпа.
Dialogue: 0,0:35:07.35,0:35:10.68,jp,NTP,0000,0000,0000,,Жаман нәрсе болуы мүмкін
Dialogue: 0,0:35:12.53,0:35:13.93,jp,NTP,0000,0000,0000,,Шынымды айтсам.
Dialogue: 0,0:35:14.05,0:35:16.36,jp,NTP,0000,0000,0000,,Әкемді ысқырушы деп айтудан алысқа бармас едім.
Dialogue: 0,0:35:16.36,0:35:18.81,jp,NTP,0000,0000,0000,,Кеннің бір нәрсені асыра айтатын әдеті болды.
Dialogue: 0,0:35:19.12,0:35:20.39,jp,NTP,0000,0000,0000,,Бұл оқиға да
Dialogue: 0,0:35:22.73,0:35:24.13,jp,NTP,0000,0000,0000,,Нағыз картопты көргенде
Dialogue: 0,0:35:24.13,0:35:28.13,jp,NTP,0000,0000,0000,,Олардың барлығы қорқынышты емес, қызықтырақ көрінеді.
Dialogue: 0,0:35:32.30,0:35:36.43,jp,NTP,0000,0000,0000,,Неліктен Маме Икуконың соңынан Имабариге бармады?
Dialogue: 0,0:35:37.99,0:35:38.69,jp,NTP,0000,0000,0000,,Мен тыңдаймын.
Dialogue: 0,0:35:39.31,0:35:42.39,jp,NTP,0000,0000,0000,,Мен қайықты сағындым деп ойлаймын.
Dialogue: 0,0:35:42.46,0:35:43.05,jp,NTP,0000,0000,0000,,Осымен
Dialogue: 0,0:35:46.56,0:35:47.94,jp,NTP,0000,0000,0000,,Мынау ортадағы.
Dialogue: 0,0:35:48.19,0:35:49.87,jp,NTP,0000,0000,0000,,Сіздің арғы атаңыз.
Dialogue: 0,0:35:57.34,0:35:59.38,jp,NTP,0000,0000,0000,,Дәл солай сен бізге қарайсың.
Dialogue: 0,0:36:00.76,0:36:02.16,jp,NTP,0000,0000,0000,,Егер сіз көретін боламын деп ойласаңыз
Dialogue: 0,0:36:02.16,0:36:06.14,jp,NTP,0000,0000,0000,,Бұл біртүрлі, бірақ мен мұны да байқап көретін сияқтымын.
Dialogue: 0,0:36:07.22,0:36:07.73,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:36:11.09,0:36:14.92,jp,NTP,0000,0000,0000,,Құбыжықпен кездессем не істеуім керек?
Dialogue: 0,0:36:15.74,0:36:19.52,jp,NTP,0000,0000,0000,,Мұндай кезде қорқынышты, қорқынышты ойлар орындалады.
Dialogue: 0,0:36:19.85,0:36:22.00,jp,NTP,0000,0000,0000,,Мен батылдық жинасам, артыма жалт қарасам
Dialogue: 0,0:36:22.48,0:36:25.17,jp,NTP,0000,0000,0000,,Мына жігіт мұны істеймін деп ойлап, былай шығады.
Dialogue: 0,0:36:26.25,0:36:30.33,jp,NTP,0000,0000,0000,,Әкем олардың қорқақтығын таң қалдырды.
Dialogue: 0,0:36:30.46,0:36:31.46,jp,NTP,0000,0000,0000,,Шынымен бе?
Dialogue: 0,0:36:51.75,0:36:53.05,jp,NTP,0000,0000,0000,,Мүлде мүмкін емес.
Dialogue: 0,0:36:53.36,0:36:55.41,jp,NTP,0000,0000,0000,,Менің артыма жалтақтауға сенімім жоқ.
Dialogue: 0,0:36:55.99,0:36:58.13,jp,NTP,0000,0000,0000,,Қайта шықпайды деп үміттенемін.
Dialogue: 0,0:37:16.98,0:37:18.70,jp,NTP,0000,0000,0000,,Мен далаға көмектесемін.
Dialogue: 0,0:37:19.04,0:37:21.31,jp,NTP,0000,0000,0000,,Түскі ас Бұл басқа күріш шары, бірақ оны жеп қойыңыз.
Dialogue: 0,0:37:22.27,0:37:25.64,jp,NTP,0000,0000,0000,,PS Пакет түстен кейін келеді. Рақмет сізге.
Dialogue: 0,0:37:26.39,0:37:26.91,jp,NTP,0000,0000,0000,,Ай! Ол маған сөйлеп тұрған екен!
Dialogue: 0,0:37:31.86,0:37:33.00,jp,NTP,0000,0000,0000,,Тағы да жалғыз
Dialogue: 0,0:37:51.06,0:37:52.92,jp,NTP,0000,0000,0000,,Бұл шынымен жұмыс істей ме?
Dialogue: 0,0:37:53.59,0:37:55.33,jp,NTP,0000,0000,0000,,Менде түсінік жоқ
Dialogue: 0,0:37:55.94,0:37:58.75,jp,NTP,0000,0000,0000,,Сондықтан мен сәтті сынақ болды деп ойламаймын.
Dialogue: 0,0:37:59.55,0:38:00.38,jp,NTP,0000,0000,0000,,Қараңдаршы
Dialogue: 0,0:38:19.04,0:38:19.90,jp,NTP,0000,0000,0000,,Онигири
Dialogue: 0,0:38:25.06,0:38:26.29,jp,NTP,0000,0000,0000,,Сіздің қорғанысыңыз қандай?
Dialogue: 0,0:38:26.53,0:38:28.46,jp,NTP,0000,0000,0000,,Мен және анаммен не істеуді жоспарлап отырсыз?
Dialogue: 0,0:38:32.02,0:38:33.76,jp,NTP,0000,0000,0000,,Бұл жақсы идея не болды?
Dialogue: 0,0:38:38.47,0:38:42.14,jp,NTP,0000,0000,0000,,Бізді Мичизан Сугавара өлтірді, оны Лорд Шуга деп те атайды.
Dialogue: 0,0:38:42.34,0:38:44.85,jp,NTP,0000,0000,0000,,Сары мұқабада мөрленген құбыжық
Dialogue: 0,0:38:45.25,0:38:47.55,jp,NTP,0000,0000,0000,,Сандықты ашқаны үшін Жаратқанға мың алғыс
Dialogue: 0,0:38:47.65,0:38:50.17,jp,NTP,0000,0000,0000,,Иә, мен мың жылда алғаш рет өз өмірімді қайтардым.
Dialogue: 0,0:38:50.24,0:38:56.03,jp,NTP,0000,0000,0000,,Солай ма? Мен аспаннан келгенім анық...
Dialogue: 0,0:38:59.51,0:39:00.77,jp,NTP,0000,0000,0000,,Менің атым Ива.
Dialogue: 0,0:39:01.39,0:39:02.80,jp,NTP,0000,0000,0000,,Жіңішкесі сүйкімді
Dialogue: 0,0:39:03.35,0:39:04.98,jp,NTP,0000,0000,0000,,Кіші - ең жақсысы
Dialogue: 0,0:39:05.28,0:39:08.76,jp,NTP,0000,0000,0000,,Көріп отырғаныңыздай, бұл мүлдем күдікті емес.
Dialogue: 0,0:39:10.68,0:39:12.31,jp,NTP,0000,0000,0000,,Келме
Dialogue: 0,0:39:12.87,0:39:13.67,jp,NTP,0000,0000,0000,,Эй, сәлем
Dialogue: 0,0:39:14.00,0:39:15.59,jp,NTP,0000,0000,0000,,Тоқта, сен тоқта!
Dialogue: 0,0:39:35.51,0:39:36.79,jp,NTP,0000,0000,0000,,Оны бұзбаңыз
Dialogue: 0,0:39:37.38,0:39:39.24,jp,NTP,0000,0000,0000,,Бұл маңызды өту.
Dialogue: 0,0:39:39.50,0:39:43.13,jp,NTP,0000,0000,0000,,Жартысын жұлып алсаң, жарамсыз болып қалады.
Dialogue: 0,0:39:43.20,0:39:46.06,jp,NTP,0000,0000,0000,,Неге бәрін түсіндіріп жатырсың, қария?
Dialogue: 0,0:39:46.32,0:39:47.23,jp,NTP,0000,0000,0000,,Енді оны қайтарыңыз.
Dialogue: 0,0:39:51.11,0:39:54.54,jp,NTP,0000,0000,0000,,Жоқ, өтінемін, тоқтатыңыз.
Dialogue: 0,0:39:56.32,0:39:57.50,jp,NTP,0000,0000,0000,,Енді басыңызды иіңіз
Dialogue: 0,0:39:58.96,0:40:00.82,jp,NTP,0000,0000,0000,,Менің айтқанымды тыңда.
Dialogue: 0,0:40:01.92,0:40:03.74,jp,NTP,0000,0000,0000,,Қалаған нәрсе бар ма?
Dialogue: 0,0:40:05.74,0:40:07.01,jp,NTP,0000,0000,0000,,Ұстаудың қажеті жоқ.
Dialogue: 0,0:40:09.34,0:40:12.85,jp,NTP,0000,0000,0000,,Әзірше бұл туралы не деуге болады?
Dialogue: 0,0:40:14.16,0:40:14.76,jp,NTP,0000,0000,0000,,Менің
Dialogue: 0,0:40:14.85,0:40:15.63,jp,NTP,0000,0000,0000,,Иә, сіздікі.
Dialogue: 0,0:40:17.47,0:40:20.66,jp,NTP,0000,0000,0000,,Ал, тағы басқалары бар.
Dialogue: 0,0:40:21.21,0:40:23.19,jp,NTP,0000,0000,0000,,Маған ештеңе керек емес, бұл үйден кет.
Dialogue: 0,0:40:23.19,0:40:24.98,jp,NTP,0000,0000,0000,,Жоқ, бұл мәселе...
Dialogue: 0,0:40:26.42,0:40:27.27,jp,NTP,0000,0000,0000,,Бұл мәселе
Dialogue: 0,0:40:29.30,0:40:31.34,jp,NTP,0000,0000,0000,,А, мен түсіндім.
Dialogue: 0,0:40:31.85,0:40:33.37,jp,NTP,0000,0000,0000,,Мен бұл үйден кетемін.
Dialogue: 0,0:40:34.28,0:40:36.70,jp,NTP,0000,0000,0000,,Мүмкін болса, мен оны сізге қайтарғым келеді.
Dialogue: 0,0:40:38.15,0:40:40.74,jp,NTP,0000,0000,0000,,О, түсіндім.
Dialogue: 0,0:40:48.44,0:40:52.91,jp,NTP,0000,0000,0000,,Иә иә Иә иә иә
Dialogue: 0,0:41:12.86,0:41:15.92,jp,NTP,0000,0000,0000,,Иә, ол өте зұлым қыз.
Dialogue: 0,0:41:16.17,0:41:18.39,jp,NTP,0000,0000,0000,,Заң жобасы қабылданды.
Dialogue: 0,0:41:18.51,0:41:20.39,jp,NTP,0000,0000,0000,,Қандай қиын жұмыс!
Dialogue: 0,0:41:20.72,0:41:23.24,jp,NTP,0000,0000,0000,,Негізінде ол бізді неге көре алады?
Dialogue: 0,0:41:23.54,0:41:24.70,jp,NTP,0000,0000,0000,,Бұл зұлымдық болғандықтан ба?
Dialogue: 0,0:41:26.50,0:41:29.57,jp,NTP,0000,0000,0000,,Мен құлаған кезде ойлаймын
Dialogue: 0,0:41:29.66,0:41:31.96,jp,NTP,0000,0000,0000,,Мен абайсызда сол жамбасқа тиіп кеттім.
Dialogue: 0,0:41:34.52,0:41:37.17,jp,NTP,0000,0000,0000,,Сол себепті бізді көре алмайсыз ба?
Dialogue: 0,0:41:40.28,0:41:41.70,jp,NTP,0000,0000,0000,,Бұрынғы күндер жақсы болды.
Dialogue: 0,0:41:41.85,0:41:45.58,jp,NTP,0000,0000,0000,,Жабайы жүріп, айналадағы адамдарды тепкіле.
Dialogue: 0,0:41:45.97,0:41:48.18,jp,NTP,0000,0000,0000,,...
Dialogue: 0,0:42:24.06,0:42:27.99,jp,NTP,0000,0000,0000,,Енді қыздың жүрегі жұғады.
Dialogue: 0,0:42:28.17,0:42:30.25,jp,NTP,0000,0000,0000,,Үйге кететін уақыт та қалды.
Dialogue: 0,0:42:30.79,0:42:33.27,jp,NTP,0000,0000,0000,,Бұл рас па?
Dialogue: 0,0:42:42.20,0:42:42.98,jp,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,0:42:45.07,0:42:49.99,jp,NTP,0000,0000,0000,,Өйткені, бірден жұмыс істеуге мәжбүрлеу дұрыс емес деп ойлаймын.
Dialogue: 0,0:42:50.24,0:42:51.85,jp,NTP,0000,0000,0000,,Иә, бірақ
Dialogue: 0,0:42:52.55,0:42:55.07,jp,NTP,0000,0000,0000,,Сандарым үлкейгенше әлі қиын.
Dialogue: 0,0:42:55.66,0:42:58.09,jp,NTP,0000,0000,0000,,Мен бәрібір жұмысқа баратын болсам, ертерек болғаным дұрыс деп ойлаймын.
Dialogue: 0,0:43:00.41,0:43:02.35,jp,NTP,0000,0000,0000,,Маған жұмысқа тұрып, тәуелсіз болу керек.
Dialogue: 0,0:43:03.22,0:43:06.40,jp,NTP,0000,0000,0000,,Апайлар мені еркелетіп жатыр:
Dialogue: 0,0:43:06.58,0:43:09.58,jp,NTP,0000,0000,0000,,Иә, сізге ұнайды деп үміттенемін.
Dialogue: 0,0:43:17.24,0:43:21.83,jp,NTP,0000,0000,0000,,Казуо-сан да жақсы адам болған. Мен оның жалғыз болатынына сенімдімін.
Dialogue: 0,0:43:23.16,0:43:24.62,jp,NTP,0000,0000,0000,,Мен қазір әбден үйреніп қалдым.
Dialogue: 0,0:43:29.42,0:43:33.38,jp,NTP,0000,0000,0000,,Өсіріп, көкке жет, солай емес пе?
Dialogue: 0,0:43:33.94,0:43:36.20,jp,NTP,0000,0000,0000,,Мен олардың осылай шыңға қалай жеткеніне таң қаламын.
Dialogue: 0,0:43:36.88,0:43:41.82,jp,NTP,0000,0000,0000,,Ата-бабамыздың арқасында Жәкең жері аз ғана арал.
Dialogue: 0,0:43:45.37,0:43:46.13,jp,NTP,0000,0000,0000,,Жақсысың ба?
Dialogue: 0,0:43:48.61,0:43:51.11,jp,NTP,0000,0000,0000,,О Шай біртүрлі екен... кіріңіз.
Dialogue: 0,0:43:59.07,0:44:02.12,jp,NTP,0000,0000,0000,,Мен өзіңізді қайтадан нашар сезінесіз деп ойладым.
Dialogue: 0,0:44:02.93,0:44:03.70,jp,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:44:04.76,0:44:05.72,jp,NTP,0000,0000,0000,,А, мен таң қалдым.
Dialogue: 0,0:44:06.25,0:44:07.95,jp,NTP,0000,0000,0000,,Бұл мені таң қалдырды.
Dialogue: 0,0:44:19.51,0:44:20.07,jp,NTP,0000,0000,0000,,Дәретхана дәретханасы
Dialogue: 0,0:44:28.77,0:44:29.90,jp,NTP,0000,0000,0000,,А, кіріңіз...
Dialogue: 0,0:44:30.71,0:44:31.44,jp,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,0:44:35.44,0:44:37.10,jp,NTP,0000,0000,0000,,Біз бұрын берген уәдеміз не болды?
Dialogue: 0,0:44:37.10,0:44:39.73,jp,NTP,0000,0000,0000,,Бұл жерден кетсем, қиналып қаламын.
Dialogue: 0,0:44:39.91,0:44:41.09,jp,NTP,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:44:43.56,0:44:44.02,jp,NTP,0000,0000,0000,,Мүмкін емес
Dialogue: 0,0:44:53.30,0:44:54.13,jp,NTP,0000,0000,0000,,Қышу
Dialogue: 0,0:44:59.23,0:45:01.54,jp,NTP,0000,0000,0000,,Бұзсақ, өлеміз.
Dialogue: 0,0:45:02.11,0:45:03.96,jp,NTP,0000,0000,0000,,Эй, сен кісі өлтірушісің бе?
Dialogue: 0,0:45:06.59,0:45:08.05,jp,NTP,0000,0000,0000,,Бұл адам емес.
Dialogue: 0,0:45:15.08,0:45:15.92,jp,NTP,0000,0000,0000,,Эй, эй
Dialogue: 0,0:45:20.20,0:45:21.18,jp,NTP,0000,0000,0000,,Міне, тамақтаныңыз.
Dialogue: 0,0:45:21.71,0:45:24.49,jp,NTP,0000,0000,0000,,Жоқ, сен оны ұрлап алдың.
Dialogue: 0,0:45:25.37,0:45:25.80,jp,NTP,0000,0000,0000,,Тамақтану
Dialogue: 0,0:45:29.07,0:45:33.61,jp,NTP,0000,0000,0000,,Қалған дұрыс, тек жамандық жасама.
Dialogue: 0,0:45:34.04,0:45:35.84,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:45:45.14,0:45:48.82,jp,NTP,0000,0000,0000,,Анам үйде жоқ, құбыжықтар пайда болады.
Dialogue: 0,0:45:49.54,0:45:51.54,jp,NTP,0000,0000,0000,,Біртүрлі нәрсе болды.
Dialogue: 0,0:46:07.47,0:46:08.39,jp,NTP,0000,0000,0000,,Бұл дұрыс болды
Dialogue: 0,0:46:09.27,0:46:11.18,jp,NTP,0000,0000,0000,,Момо аспанда
Dialogue: 0,0:46:14.85,0:46:15.64,jp,NTP,0000,0000,0000,,Қайта оралдын.
Dialogue: 0,0:46:16.88,0:46:17.39,jp,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,0:46:17.87,0:46:19.39,jp,NTP,0000,0000,0000,,Мен тамақ сатып алдым, тамақтанайық.
Dialogue: 0,0:46:19.68,0:46:20.52,jp,NTP,0000,0000,0000,,Түсіңіз.
Dialogue: 0,0:46:28.54,0:46:29.48,jp,NTP,0000,0000,0000,,Мен оны көре алмаймын
Dialogue: 0,0:47:56.29,0:47:58.82,jp,NTP,0000,0000,0000,,Мен Кадзуомен кездесіп жатырмын деп ойлаймын.
Dialogue: 0,0:47:58.91,0:48:00.05,jp,NTP,0000,0000,0000,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:48:00.30,0:48:01.65,jp,NTP,0000,0000,0000,,Менің әкем жоқ.
Dialogue: 0,0:48:01.93,0:48:04.65,jp,NTP,0000,0000,0000,,Кадзуо Момоға ұқсайды ма?
Dialogue: 0,0:48:04.65,0:48:05.75,jp,NTP,0000,0000,0000,,Мен білмеймін
Dialogue: 0,0:48:05.99,0:48:07.56,jp,NTP,0000,0000,0000,,Будда құрбандық орнының суретіне қараңыз.
Dialogue: 0,0:48:08.63,0:48:09.92,jp,NTP,0000,0000,0000,,Бірақ мұны неге сұрайсың?
Dialogue: 0,0:48:11.57,0:48:14.16,jp,NTP,0000,0000,0000,,Сіз өте оңай ұмытасыз.
Dialogue: 0,0:48:14.35,0:48:15.57,jp,NTP,0000,0000,0000,,Неліктен?
Dialogue: 0,0:48:21.45,0:48:21.75,jp,NTP,0000,0000,0000,,Б-Бірақ соншама Титан бар кезде адамды көтеріп ұшу…
Dialogue: 0,0:48:40.38,0:48:40.94,jp,NTP,0000,0000,0000,,Мияура
Dialogue: 0,0:48:43.25,0:48:45.55,jp,NTP,0000,0000,0000,,Кешіріңіз, кеше үндемей кетіп қалдым.
Dialogue: 0,0:48:47.84,0:48:49.46,jp,NTP,0000,0000,0000,,Аа, бұл туралы уайымдамаңыз.
Dialogue: 0,0:48:50.24,0:48:51.60,jp,NTP,0000,0000,0000,,Сен маған мұны айту үшін келдің бе?
Dialogue: 0,0:48:54.53,0:48:55.33,jp,NTP,0000,0000,0000,,Момо-чан
Dialogue: 0,0:48:56.39,0:48:57.06,jp,NTP,0000,0000,0000,,Сәлем
Dialogue: 0,0:48:59.36,0:49:01.90,jp,NTP,0000,0000,0000,,Хаа, Умидің жаңбыр гаппа.
Dialogue: 0,0:49:02.12,0:49:04.02,jp,NTP,0000,0000,0000,,Момо-чан сізге тапты ма?
Dialogue: 0,0:49:05.38,0:49:07.94,jp,NTP,0000,0000,0000,,Иә...себебі онда менің атым жазылған.
Dialogue: 0,0:49:20.68,0:49:21.63,jp,NTP,0000,0000,0000,,Сіз кімсіз?
Dialogue: 0,0:49:26.55,0:49:27.50,jp,NTP,0000,0000,0000,,Маған бәрібір
Dialogue: 0,0:49:28.13,0:49:30.05,jp,NTP,0000,0000,0000,,Бұл жігіт кейде оғаш сөздер айтады.
Dialogue: 0,0:49:30.64,0:49:32.05,jp,NTP,0000,0000,0000,,Бұл жиіркенішті, тоқтатыңыз.
Dialogue: 0,0:49:35.44,0:49:37.58,jp,NTP,0000,0000,0000,,Кешіріңіз, сау болыңыз.
Dialogue: 0,0:49:55.57,0:49:56.19,jp,NTP,0000,0000,0000,,Кешір мені. Қызығушылығымды тежей алмадым; мен жай ғана…
Dialogue: 0,0:49:56.49,0:49:58.12,jp,NTP,0000,0000,0000,,Бүгін де ағаңмен түскі асқа бар.
Dialogue: 0,0:49:58.63,0:49:59.42,jp,NTP,0000,0000,0000,,I'm going
Dialogue: 0,0:49:59.93,0:50:01.57,jp,NTP,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:50:07.58,0:50:09.28,jp,NTP,0000,0000,0000,,Сіз әкеңізге ұқсайсыз ба?
Dialogue: 0,0:50:12.24,0:50:13.23,jp,NTP,0000,0000,0000,,Сораену
Dialogue: 0,0:50:14.82,0:50:18.08,jp,NTP,0000,0000,0000,,Ал, кешегі күні егістік алқаптар тағы да жойылды.
Dialogue: 0,0:50:18.08,0:50:19.33,jp,NTP,0000,0000,0000,,Бұл қорқынышты.
Dialogue: 0,0:50:19.68,0:50:20.43,jp,NTP,0000,0000,0000,,Қабан?
Dialogue: 0,0:50:20.99,0:50:21.88,jp,NTP,0000,0000,0000,,Менің ойымша.
Dialogue: 0,0:50:22.09,0:50:23.24,jp,NTP,0000,0000,0000,,Сіз қалай ойлайсыз?
Dialogue: 0,0:50:23.55,0:50:26.67,jp,NTP,0000,0000,0000,,Оның тамақтану тәсілі қабан үшін тым ұқыпты.
Dialogue: 0,0:50:27.11,0:50:29.21,jp,NTP,0000,0000,0000,,Қабаннан өзгеше болса, онда бұл не?
Dialogue: 0,0:50:30.87,0:50:33.18,jp,NTP,0000,0000,0000,,Мен мұны түсінбеймін.
Dialogue: 0,0:50:41.26,0:50:43.04,jp,NTP,0000,0000,0000,,Аралға қалай үйрендің?
Dialogue: 0,0:50:44.86,0:50:47.55,jp,NTP,0000,0000,0000,,Түсінбеген жеріңіз болса, менен сұраңыз.
Dialogue: 0,0:50:48.10,0:50:48.39,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:50:49.57,0:50:51.25,jp,NTP,0000,0000,0000,,Бүгін де Иччанның сабағы бар ма?
Dialogue: 0,0:50:51.87,0:50:52.16,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,0:50:55.44,0:50:56.08,jp,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,0:50:56.48,0:50:58.54,jp,NTP,0000,0000,0000,,Жоқ, сіз нені айтып тұрсыз?
Dialogue: 0,0:50:59.98,0:51:00.79,jp,NTP,0000,0000,0000,,Сонда кездескенше
Dialogue: 0,0:51:01.40,0:51:01.78,jp,NTP,0000,0000,0000,,О.
Dialogue: 0,0:51:08.33,0:51:09.88,jp,NTP,0000,0000,0000,,Бірінші
Dialogue: 0,0:51:11.92,0:51:13.51,jp,NTP,0000,0000,0000,,Жарайды, менде
Dialogue: 0,0:51:16.40,0:51:17.58,jp,NTP,0000,0000,0000,,Келесі - Ян.
Dialogue: 0,0:51:17.72,0:51:19.13,jp,NTP,0000,0000,0000,,Басын көтеріп секіру
Dialogue: 0,0:51:19.49,0:51:21.17,jp,NTP,0000,0000,0000,,Тағы да?
Dialogue: 0,0:51:55.11,0:51:56.64,jp,NTP,0000,0000,0000,,Орындалды.
Dialogue: 0,0:51:56.69,0:51:57.84,jp,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,0:51:58.21,0:51:59.31,jp,NTP,0000,0000,0000,,Мен секірген жоқпын.
Dialogue: 0,0:52:02.44,0:52:03.77,jp,NTP,0000,0000,0000,,Мені итеріп жібермеді.
Dialogue: 0,0:52:09.90,0:52:11.10,jp,NTP,0000,0000,0000,,Мен өлемін деп ойладым
Dialogue: 0,0:52:12.06,0:52:12.98,jp,NTP,0000,0000,0000,,Денеңде осындай жарақаттармен қаза таптың, иә?
Dialogue: 0,0:52:18.95,0:52:20.58,jp,NTP,0000,0000,0000,,Керемет
Dialogue: 0,0:52:23.27,0:52:24.46,jp,NTP,0000,0000,0000,,Бұл әзіл емес.
Dialogue: 0,0:52:32.87,0:52:34.32,jp,NTP,0000,0000,0000,,Мен саған жоқ дедім.
Dialogue: 0,0:52:34.55,0:52:36.20,jp,NTP,0000,0000,0000,,Біраз балық аулап, жеп ал.
Dialogue: 0,0:52:38.67,0:52:42.36,jp,NTP,0000,0000,0000,,Мен балықты ұнатпаймын, олардың қабыршақтары бар.
Dialogue: 0,0:52:45.76,0:52:47.27,jp,NTP,0000,0000,0000,,Хонжа, мен барамын.
Dialogue: 0,0:52:47.83,0:52:50.77,jp,NTP,0000,0000,0000,,Бұл тамаша нәрсе болады.
Dialogue: 0,0:52:50.84,0:52:52.06,jp,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,0:52:52.40,0:52:56.32,jp,NTP,0000,0000,0000,,Тегін алданып қалма. Қалталы ақшамды пайдалансам жақсы болар еді.
Dialogue: 0,0:52:57.28,0:52:57.94,jp,NTP,0000,0000,0000,,Қош келдіңіз
Dialogue: 0,0:53:07.11,0:53:07.60,jp,NTP,0000,0000,0000,,Сіз білесіз бе?
Dialogue: 0,0:53:08.33,0:53:08.84,jp,NTP,0000,0000,0000,,Иә?
Dialogue: 0,0:53:09.78,0:53:14.15,jp,NTP,0000,0000,0000,,Мен бұл аралда ақша жұмсамай-ақ жеуге болатын нәрсе бар ма?
Dialogue: 0,0:53:14.90,0:53:16.43,jp,NTP,0000,0000,0000,,Сіз әлі ашсыз ба?
Dialogue: 0,0:53:16.61,0:53:18.20,jp,NTP,0000,0000,0000,,Жоқ, олай емес.
Dialogue: 0,0:53:18.58,0:53:21.16,jp,NTP,0000,0000,0000,,Табиғатта осындай нәрсе
Dialogue: 0,0:53:21.85,0:53:23.73,jp,NTP,0000,0000,0000,,Барлық жерде балық бар
Dialogue: 0,0:53:23.80,0:53:24.61,jp,NTP,0000,0000,0000,,Балық жоқ
Dialogue: 0,0:53:26.57,0:53:28.31,jp,NTP,0000,0000,0000,,Балықтан басқа тағам
Dialogue: 0,0:53:29.21,0:53:34.58,jp,NTP,0000,0000,0000,,Тауға барсаң, аз болады
Dialogue: 0,0:53:45.05,0:53:47.99,jp,NTP,0000,0000,0000,,Сіз шынымен тойып жей аласыз ба?
Dialogue: 0,0:53:48.08,0:53:50.52,jp,NTP,0000,0000,0000,,Қалай болғанда да, мен люкске тапсырыс беремін.
Dialogue: 0,0:53:50.97,0:53:54.02,jp,NTP,0000,0000,0000,,Мен үш күннен бері ештеңе жеген жоқпын.
Dialogue: 0,0:53:54.66,0:53:55.63,jp,NTP,0000,0000,0000,,Мен тамақтанып отырдым
Dialogue: 0,0:54:05.53,0:54:06.44,jp,NTP,0000,0000,0000,,Hey, wait.
Dialogue: 0,0:54:07.32,0:54:08.50,jp,NTP,0000,0000,0000,,Мынаны мінейік
Dialogue: 0,0:54:09.21,0:54:11.15,jp,NTP,0000,0000,0000,,Жоқ, ашуланасың.
Dialogue: 0,0:54:11.42,0:54:14.23,jp,NTP,0000,0000,0000,,А? Сіз ашуланасыз ба?
Dialogue: 0,0:54:15.83,0:54:17.24,jp,NTP,0000,0000,0000,,Егер тым алысқа кетсек, Радио ғимаратында дүрбелең болады,
Dialogue: 0,0:54:17.46,0:54:18.93,jp,NTP,0000,0000,0000,,Бұл ағамыз бұрын болған
Dialogue: 0,0:54:19.07,0:54:22.84,jp,NTP,0000,0000,0000,,Бір кездері үлкен кісіні бүтін жұтып қоятын.
Dialogue: 0,0:54:23.18,0:54:23.74,jp,NTP,0000,0000,0000,,Қараңдар!
Dialogue: 0,0:54:24.32,0:54:27.27,jp,NTP,0000,0000,0000,,Мұны адам аузыңмен де жаса.
Dialogue: 0,0:54:30.01,0:54:32.65,jp,NTP,0000,0000,0000,,Мен етін сордым, бәрін жедім.
Dialogue: 0,0:54:33.27,0:54:34.99,jp,NTP,0000,0000,0000,,Мен сағыныш сезінемін
Dialogue: 0,0:54:35.90,0:54:37.67,jp,NTP,0000,0000,0000,,Ал, тек түсіну керек.
Dialogue: 0,0:54:38.04,0:54:39.00,jp,NTP,0000,0000,0000,,Сыртқа шығарған ауаңыз сол жақтағы осы бөліктен шығады.
Dialogue: 0,0:54:46.06,0:54:48.05,jp,NTP,0000,0000,0000,,Сіз қанша қашықтыққа көтерілесіз?
Dialogue: 0,0:54:48.54,0:54:51.41,jp,NTP,0000,0000,0000,,Хмм, мен шыңға шығуым керек шығар.
Dialogue: 0,0:54:51.62,0:54:54.56,jp,NTP,0000,0000,0000,,Маған мағынасы жоқ жаңғақ жегізбеу керек.
Dialogue: 0,0:55:03.37,0:55:05.32,jp,NTP,0000,0000,0000,,Бұл ыңғайлы көрінеді.
Dialogue: 0,0:55:14.50,0:55:15.44,jp,NTP,0000,0000,0000,,Бұл тітіркендіргіш
Dialogue: 0,0:55:20.10,0:55:20.78,jp,NTP,0000,0000,0000,,Көрдіңіз бе?
Dialogue: 0,0:55:20.88,0:55:22.99,jp,NTP,0000,0000,0000,,Негізгі тағам
Dialogue: 0,0:55:23.85,0:55:25.45,jp,NTP,0000,0000,0000,,Эй, эй
Dialogue: 0,0:55:51.00,0:55:53.36,jp,NTP,0000,0000,0000,,Қашу
Dialogue: 0,0:56:13.75,0:56:14.28,jp,NTP,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:56:15.10,0:56:16.28,jp,NTP,0000,0000,0000,,Ива Кава
Dialogue: 0,0:56:16.81,0:56:18.22,jp,NTP,0000,0000,0000,,Бір минут күтіңіз.
Dialogue: 0,0:56:25.25,0:56:26.06,jp,NTP,0000,0000,0000,,келді
Dialogue: 0,0:56:43.19,0:56:45.43,jp,NTP,0000,0000,0000,,Момо-доно, бұл қауіпті болды.
Dialogue: 0,0:56:45.64,0:56:47.61,jp,NTP,0000,0000,0000,,Дұрысы, мені тастап қашып кетті.
Dialogue: 0,0:57:00.20,0:57:02.28,jp,NTP,0000,0000,0000,,Енді мен бүгін көп жей аламын.
Dialogue: 0,0:57:03.40,0:57:05.83,jp,NTP,0000,0000,0000,,Мен дірілдегенімді тоқтата алмаймын.
Dialogue: 0,0:57:06.05,0:57:06.88,jp,NTP,0000,0000,0000,,Мұндай нәрсе
Dialogue: 0,0:57:07.16,0:57:08.56,jp,NTP,0000,0000,0000,,Жоқ, мен сені аяймын.
Dialogue: 0,0:57:08.56,0:57:09.56,jp,NTP,0000,0000,0000,,Әй, қара
Dialogue: 0,0:57:13.65,0:57:14.91,jp,NTP,0000,0000,0000,,Тұрақты
Dialogue: 0,0:57:14.91,0:57:16.33,jp,NTP,0000,0000,0000,,Ол балаларды жіберме
Dialogue: 0,0:57:16.65,0:57:17.44,jp,NTP,0000,0000,0000,,Ақымақ болма
Dialogue: 0,0:57:17.75,0:57:18.39,jp,NTP,0000,0000,0000,,Өйткені
Dialogue: 0,0:57:18.78,0:57:21.21,jp,NTP,0000,0000,0000,,Жарайды, маған қалдырыңыз.
Dialogue: 0,0:57:43.06,0:57:43.85,jp,NTP,0000,0000,0000,,Жақсы
Dialogue: 0,0:57:49.41,0:57:52.67,jp,NTP,0000,0000,0000,,Болжау қорқынышты
Dialogue: 0,0:57:54.80,0:57:55.79,jp,NTP,0000,0000,0000,,Енді ешқашан
Dialogue: 0,0:57:55.80,0:57:58.03,jp,NTP,0000,0000,0000,,Кава мен оны сұрадым
Dialogue: 0,0:58:06.16,0:58:08.62,jp,NTP,0000,0000,0000,,Кусса
Dialogue: 0,0:58:10.04,0:58:11.30,jp,NTP,0000,0000,0000,,Балалар сендер кереметсіңдер
Dialogue: 0,0:58:11.41,0:58:14.59,jp,NTP,0000,0000,0000,,Әзірше осы.
Dialogue: 0,0:58:27.98,0:58:29.22,jp,NTP,0000,0000,0000,,келді
Dialogue: 0,0:58:31.57,0:58:33.99,jp,NTP,0000,0000,0000,,Кава Мен бұл туралы бірдеңе істеймін
Dialogue: 0,0:58:34.05,0:58:36.26,jp,NTP,0000,0000,0000,,Менде бензин бітті.
Dialogue: 0,0:58:59.95,0:59:02.43,jp,NTP,0000,0000,0000,,Ағашта жаңғақ та жоқ еді.
Dialogue: 0,0:59:03.44,0:59:05.62,jp,NTP,0000,0000,0000,,Мен оны қабан жегеніне сенімдімін.
Dialogue: 0,0:59:06.45,0:59:08.13,jp,NTP,0000,0000,0000,,Менің қарным ашты
Dialogue: 0,0:59:08.31,0:59:12.21,jp,NTP,0000,0000,0000,,Бірақ бұл дәмді және ретсіз көрінді.
Dialogue: 0,0:59:59.08,1:00:00.32,jp,NTP,0000,0000,0000,,Бұл… (Бакуго) Э?
Dialogue: 0,1:00:04.68,1:00:05.89,jp,NTP,0000,0000,0000,,Балалар, сендер де қарап алыңдар.
Dialogue: 0,1:00:06.23,1:00:07.37,jp,NTP,0000,0000,0000,,Өте әдемі
Dialogue: 0,1:00:08.03,1:00:10.26,jp,NTP,0000,0000,0000,,Декорацияны жеуге болмайды
Dialogue: 0,1:00:12.21,1:00:14.46,jp,NTP,0000,0000,0000,,Мен көмектесе алмаймын, үйге жаяу барайық.
Dialogue: 0,1:00:16.17,1:00:17.36,jp,NTP,0000,0000,0000,,Бұл мүмкін емес.
Dialogue: 0,1:00:17.36,1:00:20.08,jp,NTP,0000,0000,0000,,Біз саған қарағанда нәзікпіз.
Dialogue: 0,1:00:20.08,1:00:22.34,jp,NTP,0000,0000,0000,,...
Dialogue: 0,1:00:22.88,1:00:24.77,jp,NTP,0000,0000,0000,,Кешіріңіз, үйге жалғыз қайтыңыз.
Dialogue: 0,1:00:26.21,1:00:27.04,jp,NTP,0000,0000,0000,,Жарайды, бірақ
Dialogue: 0,1:00:27.85,1:00:29.39,jp,NTP,0000,0000,0000,,Қараңғы түскенде қорқамын.
Dialogue: 0,1:00:29.73,1:00:33.09,jp,NTP,0000,0000,0000,,Біздің мәйіттерден асып кетіңіз.
Dialogue: 0,1:00:55.92,1:00:58.64,jp,NTP,0000,0000,0000,,Енді өзіміздің шынайы мүмкіндіктерімізді көрсетейік.
Dialogue: 0,1:01:01.44,1:01:04.41,jp,NTP,0000,0000,0000,,Мен күш пен таразыны ұнатпаймын.
Dialogue: 0,1:01:19.09,1:01:19.79,jp,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,1:01:29.40,1:01:29.96,jp,NTP,0000,0000,0000,,Мен үйдемін
Dialogue: 0,1:01:32.87,1:01:33.41,jp,NTP,0000,0000,0000,,Қайтадан қош келдіңіз
Dialogue: 0,1:01:34.13,1:01:35.65,jp,NTP,0000,0000,0000,,О, бұл тас қараңғы.
Dialogue: 0,1:01:39.76,1:01:43.77,jp,NTP,0000,0000,0000,,Әлгі кішкентай қыз қол ізін ұстаған кезде қатты мақтана бастады.
Dialogue: 0,1:01:44.41,1:01:47.10,jp,NTP,0000,0000,0000,,Сіздің көзқарасыңыз барған сайын нашарлайды.
Dialogue: 0,1:01:47.25,1:01:49.98,jp,NTP,0000,0000,0000,,Қыздар осындай.
Dialogue: 0,1:01:54.28,1:01:56.15,jp,NTP,0000,0000,0000,,Тоңазытқыштың іші сәл нашар.
Dialogue: 0,1:01:56.42,1:01:59.14,jp,NTP,0000,0000,0000,,Мұны кейін қалтаңыздың ақшасына сатып алсаңыз, білмейсіз.
Dialogue: 0,1:01:59.20,1:01:59.56,jp,NTP,0000,0000,0000,,Тамақ ішпеңіз
Dialogue: 0,1:02:07.99,1:02:11.06,jp,NTP,0000,0000,0000,,Ақырында құрмет көрсеткіңіз келе ме? Тым кеш.
Dialogue: 0,1:02:25.03,1:02:25.82,jp,NTP,0000,0000,0000,,Таңғалатын ештеңе жоқ — кенеттен біздің көптеген жолдастарымыз қаза тауып жатыр.
Dialogue: 0,1:02:27.69,1:02:28.06,jp,NTP,0000,0000,0000,,Дәретхана
Dialogue: 0,1:02:33.69,1:02:36.28,jp,NTP,0000,0000,0000,,Әке, сіз теңізді жақсы көретінсіз.
Dialogue: 0,1:02:37.84,1:02:38.18,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,1:02:40.80,1:02:41.37,jp,NTP,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,1:02:43.02,1:02:47.83,jp,NTP,0000,0000,0000,,Мен бұл аралды онша жек көрмеймін.
Dialogue: 0,1:03:10.06,1:03:14.83,jp,NTP,0000,0000,0000,,Ойланып қарасаңыз, сіз көптен бері осылай істеп жүрсіз.
Dialogue: 0,1:03:15.07,1:03:16.17,jp,NTP,0000,0000,0000,,Мүлдем.
Dialogue: 0,1:03:16.50,1:03:18.58,jp,NTP,0000,0000,0000,,Бұл қашан бітері белгісіз қиын жұмыс.
Dialogue: 0,1:03:19.21,1:03:22.10,jp,NTP,0000,0000,0000,,Дегенмен, егер сіз шындап жұмыс істесеңіз, қазірге дейін
Dialogue: 0,1:03:23.04,1:03:24.65,jp,NTP,0000,0000,0000,,Жақсы жұмыс.
Dialogue: 0,1:03:26.74,1:03:30.48,jp,NTP,0000,0000,0000,,Менің аспанға есеп жіберетін кез келді.
Dialogue: 0,1:03:31.00,1:03:33.03,jp,NTP,0000,0000,0000,,Мен бұл не деп ойлаймын.
Dialogue: 0,1:03:33.32,1:03:35.07,jp,NTP,0000,0000,0000,,Біраз үйрен, ақымақ.
Dialogue: 0,1:03:35.14,1:03:38.27,jp,NTP,0000,0000,0000,,Сораға Икуко Мотоның жағдайын айту біздің міндетіміз.
Dialogue: 0,1:03:41.67,1:03:44.76,jp,NTP,0000,0000,0000,,Бізді Нантара Сугавара жойып жіберді.
Dialogue: 0,1:03:45.07,1:03:49.40,jp,NTP,0000,0000,0000,,Иә, менің ойымша, бұл мың жыл бойы кітаптарда сақталды.
Dialogue: 0,1:03:50.11,1:03:52.91,jp,NTP,0000,0000,0000,,Бұл кішкентай қызды алдау үшін өтірік болса керек.
Dialogue: 0,1:03:53.35,1:03:54.50,jp,NTP,0000,0000,0000,,Такумо
Dialogue: 0,1:03:55.26,1:03:55.74,jp,NTP,0000,0000,0000,,Жарайды
Dialogue: 0,1:03:56.49,1:04:01.56,jp,NTP,0000,0000,0000,,Менің ойымша, бұл баяндаманы Маме жазғаны дұрыс болар еді, ол оқу жаттығуы ретінде де қызмет етеді.
Dialogue: 0,1:04:49.52,1:04:50.23,jp,NTP,0000,0000,0000,,Уми-чан
Dialogue: 0,1:04:51.82,1:04:53.30,jp,NTP,0000,0000,0000,,Білесің бе, Момо-чан?
Dialogue: 0,1:04:56.71,1:04:58.23,jp,NTP,0000,0000,0000,,Бүгін барлығы келеді.
Dialogue: 0,1:04:58.52,1:05:00.39,jp,NTP,0000,0000,0000,,Тек менің ағам мен Уми
Dialogue: 0,1:05:00.75,1:05:03.00,jp,NTP,0000,0000,0000,,Бірге секірейік, Момо-чан.
Dialogue: 0,1:05:04.42,1:05:05.24,jp,NTP,0000,0000,0000,,Бұл жақсы.
Dialogue: 0,1:05:05.65,1:05:07.84,jp,NTP,0000,0000,0000,,Момо-чан, тамақ ішейік.
Dialogue: 0,1:05:08.39,1:05:09.16,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,1:05:10.63,1:05:12.34,jp,NTP,0000,0000,0000,,Жарайды, мен кейінірек барамын.
Dialogue: 0,1:05:13.15,1:05:14.04,jp,NTP,0000,0000,0000,,Иә, кейінірек
Dialogue: 0,1:05:14.80,1:05:16.23,jp,NTP,0000,0000,0000,,Көпірде күтіңіз.
Dialogue: 0,1:05:34.13,1:05:37.93,jp,NTP,0000,0000,0000,,Мен жаза алмаймын деп ойлаймын.
Dialogue: 0,1:05:45.22,1:05:46.77,jp,NTP,0000,0000,0000,,Ыстық, солай емес пе?
Dialogue: 0,1:05:46.99,1:05:48.05,jp,NTP,0000,0000,0000,,Шынымен бе?
Dialogue: 0,1:05:49.38,1:05:52.96,jp,NTP,0000,0000,0000,,Айтпақшы, қазір аралда бір қызда бірдеңе бар.
Dialogue: 0,1:05:53.61,1:05:56.66,jp,NTP,0000,0000,0000,,Сөмке, қалпақ сияқты заттар ұрланады.
Dialogue: 0,1:05:57.64,1:05:59.01,jp,NTP,0000,0000,0000,,Сонымен қатар егістіктерге рейдтер болады.
Dialogue: 0,1:05:59.20,1:06:03.23,jp,NTP,0000,0000,0000,,Жеткізу кезінде күдікті нәрсені көрсеңіз, маған хабарлаңыз.
Dialogue: 0,1:06:07.51,1:06:08.47,jp,NTP,0000,0000,0000,,Ой Сайвайичи
Dialogue: 0,1:06:08.85,1:06:10.62,jp,NTP,0000,0000,0000,,Адамдардың әңгімесін тыңдау
Dialogue: 0,1:06:11.52,1:06:12.95,jp,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,1:06:15.16,1:06:17.09,jp,NTP,0000,0000,0000,,Мен қиындыққа тап болдым
Dialogue: 0,1:06:21.57,1:06:23.52,jp,NTP,0000,0000,0000,,Ауыр нәрсе
Dialogue: 0,1:06:34.59,1:06:35.25,jp,NTP,0000,0000,0000,,Icchan
Dialogue: 0,1:06:40.29,1:06:43.84,jp,NTP,0000,0000,0000,,Жоқ, ыстық үшін кешіріңіз.
Dialogue: 0,1:06:45.85,1:06:46.60,jp,NTP,0000,0000,0000,,Бұршақ
Dialogue: 0,1:06:48.71,1:06:49.56,jp,NTP,0000,0000,0000,,Оранука
Dialogue: 0,1:06:58.19,1:06:58.86,jp,NTP,0000,0000,0000,,Момоға
Dialogue: 0,1:07:00.13,1:07:03.60,jp,NTP,0000,0000,0000,,Бұршақ жазуды аяқтап, бір жаққа кетті.
Dialogue: 0,1:07:05.16,1:07:06.74,jp,NTP,0000,0000,0000,,Бұл туралы ештеңе істей алмаймыз.
Dialogue: 0,1:07:24.89,1:07:27.17,jp,NTP,0000,0000,0000,,Бұл дұрыс жапон тілі.
Dialogue: 0,1:07:28.24,1:07:32.22,jp,NTP,0000,0000,0000,,Жұмыстың өзі мен үшін де жиіркенішті емес пе?
Dialogue: 0,1:07:36.61,1:07:39.32,jp,NTP,0000,0000,0000,,Ол сәтті ұйымдастырылғандықтан, мен оны жібере аламын.
Dialogue: 0,1:08:13.93,1:08:14.70,jp,NTP,0000,0000,0000,,Эден мектебінің сұхбатына барамын
Dialogue: 0,1:08:15.49,1:08:17.36,jp,NTP,0000,0000,0000,,Әй, мына түрің не болды?
Dialogue: 0,1:08:17.54,1:08:18.60,jp,NTP,0000,0000,0000,,Тыныш болыңыз
Dialogue: 0,1:08:19.17,1:08:21.25,jp,NTP,0000,0000,0000,,Хат жіберілетін киелі жер.
Dialogue: 0,1:08:24.93,1:08:26.01,jp,NTP,0000,0000,0000,,Момомомен айналысқыңыз келе ме?
Dialogue: 0,1:08:26.34,1:08:28.35,jp,NTP,0000,0000,0000,,Сіз не туралы айтып отырсыз? Мен мұны істемеймін.
Dialogue: 0,1:08:31.08,1:08:32.57,jp,NTP,0000,0000,0000,,Момомомен айналысқыңыз келе ме?
Dialogue: 0,1:08:32.98,1:08:34.40,jp,NTP,0000,0000,0000,,Мұны жасамаңыз
Dialogue: 0,1:08:38.92,1:08:40.36,jp,NTP,0000,0000,0000,,Момомомен айналысқыңыз келе ме?
Dialogue: 0,1:08:41.39,1:08:42.72,jp,NTP,0000,0000,0000,,Мүлдем жоқ
Dialogue: 0,1:08:47.58,1:08:50.63,jp,NTP,0000,0000,0000,,Момомомен айналысқыңыз келе ме?
Dialogue: 0,1:09:03.17,1:09:05.27,jp,NTP,0000,0000,0000,,Ауырды...
Dialogue: 0,1:09:05.27,1:09:06.15,jp,NTP,0000,0000,0000,,Мұқият қараңыз
Dialogue: 0,1:09:07.34,1:09:10.77,jp,NTP,0000,0000,0000,,Коу Коу Коу
Dialogue: 0,1:09:30.29,1:09:37.73,jp,NTP,0000,0000,0000,,Кедотохе Расонракореша
Dialogue: 0,1:09:54.78,1:09:55.64,jp,NTP,0000,0000,0000,,Бұл… (Бакуго) Э?
Dialogue: 0,1:09:56.74,1:09:57.53,jp,NTP,0000,0000,0000,,Оны қайда жібердіңіз?
Dialogue: 0,1:09:57.76,1:09:59.44,jp,NTP,0000,0000,0000,,Не? О, жоқ
Dialogue: 0,1:10:00.76,1:10:05.40,jp,NTP,0000,0000,0000,,Біз лорд Мичизанның рухына біздің қауіпсіз екенімізді білдік.
Dialogue: 0,1:10:05.61,1:10:07.91,jp,NTP,0000,0000,0000,,Ол енді қайтып келмейді.
Dialogue: 0,1:10:08.27,1:10:11.00,jp,NTP,0000,0000,0000,,О дүниеде жер басып жүргендіктен болар.
Dialogue: 0,1:10:13.12,1:10:14.77,jp,NTP,0000,0000,0000,,А Канра Канра
Dialogue: 0,1:10:16.18,1:10:18.09,jp,NTP,0000,0000,0000,,Өлген адамға хат жібере аласыз ба?
Dialogue: 0,1:10:19.54,1:10:21.47,jp,NTP,0000,0000,0000,,Дұрыс.
Dialogue: 0,1:10:21.53,1:10:22.13,jp,NTP,0000,0000,0000,,Күтілгендей
Dialogue: 0,1:10:22.15,1:10:24.58,jp,NTP,0000,0000,0000,,Мен бұл туралы білмеймін.
Dialogue: 0,1:10:25.43,1:10:27.11,jp,NTP,0000,0000,0000,,Мен әкеме хат жазғым келеді.
Dialogue: 0,1:10:27.71,1:10:28.25,jp,NTP,0000,0000,0000,,Каранэс ауданына оралу.
Dialogue: 0,1:10:33.90,1:10:35.91,jp,NTP,0000,0000,0000,,Бұл жақсы даму емес.
Dialogue: 0,1:10:42.27,1:10:43.21,jp,NTP,0000,0000,0000,,Хат?
Dialogue: 0,1:10:43.81,1:10:45.43,jp,NTP,0000,0000,0000,,Ол үстелдің үстінде болды.
Dialogue: 0,1:10:45.58,1:10:46.15,jp,NTP,0000,0000,0000,,Көргенім, нато мен үшін емес екен
Dialogue: 0,1:10:46.48,1:10:47.43,jp,NTP,0000,0000,0000,,Жек көру
Dialogue: 0,1:10:48.26,1:10:50.26,jp,NTP,0000,0000,0000,,Айя, жоқ, жоқ.
Dialogue: 0,1:10:50.43,1:10:51.84,jp,NTP,0000,0000,0000,,Білмеймін Білмеймін Білмеймін
Dialogue: 0,1:10:51.87,1:10:52.65,jp,NTP,0000,0000,0000,,Бұл – Екінші зерттеу флотилиясы!!
Dialogue: 0,1:10:52.70,1:10:53.47,jp,NTP,0000,0000,0000,,Батырлар курсынан Мидория (Деку): Ә?
Dialogue: 0,1:10:53.97,1:10:55.64,jp,NTP,0000,0000,0000,,Мама мама сен білмейсің бе?
Dialogue: 0,1:10:59.50,1:11:00.51,jp,NTP,0000,0000,0000,,Алайда, біз түбіне жетпей тұрып олар Титанға айналса, ықтималдығы аз болса да
Dialogue: 0,1:11:06.20,1:11:07.66,jp,NTP,0000,0000,0000,,Момо-чан, келіңізші.
Dialogue: 0,1:11:08.47,1:11:09.58,jp,NTP,0000,0000,0000,,Қоңырауға өтіңіз
Dialogue: 0,1:11:12.86,1:11:14.83,jp,NTP,0000,0000,0000,,Иә, күтейік.
Dialogue: 0,1:11:18.98,1:11:20.57,jp,NTP,0000,0000,0000,,Біреуі міндетті түрде болуы керек.
Dialogue: 0,1:11:23.98,1:11:26.31,jp,NTP,0000,0000,0000,,Мүмкін емес
Dialogue: 0,1:11:31.68,1:11:32.25,jp,NTP,0000,0000,0000,,Сен сияқты — олардың әрқайсысы.
Dialogue: 0,1:12:23.50,1:12:26.81,jp,NTP,0000,0000,0000,,Тайфун өзінің күшті күшін сақтай отырып, солтүстікке қарай жылжуын жалғастыруда.
Dialogue: 0,1:12:26.98,1:12:31.68,jp,NTP,0000,0000,0000,,Кешке оңтүстік Кюсю және бүкіл Сикоку аймағы қатты жел аймағына кіреді деп күтілуде.
Dialogue: 0,1:12:31.83,1:12:33.28,jp,NTP,0000,0000,0000,,Содан кейін жерге ...
Dialogue: 0,1:12:32.46,1:12:34.14,jp,NTP,0000,0000,0000,,Сабақсыз күн болғанына қуаныштымын.
Dialogue: 0,1:12:34.40,1:12:36.26,jp,NTP,0000,0000,0000,,Мен оны қазір тазалауым керек.
Dialogue: 0,1:12:37.23,1:12:39.00,jp,NTP,0000,0000,0000,,Үй тапсырмасын орындауда да үлгермедің.
Dialogue: 0,1:12:39.55,1:12:41.22,jp,NTP,0000,0000,0000,,Бүгін сыртқа шыға алмаймын деп ойлаймын.
Dialogue: 0,1:12:41.52,1:12:42.42,jp,NTP,0000,0000,0000,,Мұны мұқият орындаңыз
Dialogue: 0,1:12:44.26,1:12:44.70,jp,NTP,0000,0000,0000,,Жауап:
Dialogue: 0,1:12:46.44,1:12:47.18,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,1:13:01.46,1:13:03.36,jp,NTP,0000,0000,0000,,Әй, мен қол айнасын көрмедім.
Dialogue: 0,1:13:04.09,1:13:05.20,jp,NTP,0000,0000,0000,,Соққы
Dialogue: 0,1:13:05.57,1:13:06.97,jp,NTP,0000,0000,0000,,Оны ашық қалдырмаңыз
Dialogue: 0,1:13:07.34,1:13:08.89,jp,NTP,0000,0000,0000,,Әй, қол айнасы
Dialogue: 0,1:13:09.19,1:13:10.20,jp,NTP,0000,0000,0000,,Мен білмеймін
Dialogue: 0,1:13:10.38,1:13:11.73,jp,NTP,0000,0000,0000,,Ол киім-кешек үстелінде емес пе?
Dialogue: 0,1:13:13.18,1:13:13.97,jp,NTP,0000,0000,0000,,Бұл біртүрлі.
Dialogue: 0,1:13:25.04,1:13:27.10,jp,NTP,0000,0000,0000,,Бұл көрсеткіш те жаман емес.
Dialogue: 0,1:13:27.92,1:13:30.10,jp,NTP,0000,0000,0000,,Сіздің денеңіз қандай болса да, сіз әдемі көрінесіз
Dialogue: 0,1:13:30.77,1:13:33.54,jp,NTP,0000,0000,0000,,Қадір-қасиет сені осылай жасауға мәжбүрлей ме деп ойлаймын.
Dialogue: 0,1:13:34.79,1:13:35.35,jp,NTP,0000,0000,0000,,бірақ енді Эсидиси жеңілгендіктен—
Dialogue: 0,1:13:39.93,1:13:41.17,jp,NTP,0000,0000,0000,,Өте дегозару
Dialogue: 0,1:13:41.57,1:13:43.26,jp,NTP,0000,0000,0000,,Екеуің үйде қалсаңдаршы.
Dialogue: 0,1:13:43.41,1:13:45.71,jp,NTP,0000,0000,0000,,Бақылау тобы болу оңай.
Dialogue: 0,1:13:46.23,1:13:47.41,jp,NTP,0000,0000,0000,,Мүлдем жоқ
Dialogue: 0,1:13:50.10,1:13:53.63,jp,NTP,0000,0000,0000,,Айтпақшы, бізде ақуыз жетіспейді.
Dialogue: 0,1:14:12.72,1:14:14.79,jp,NTP,0000,0000,0000,,Сіз қайтып келдіңіз.
Dialogue: 0,1:14:16.59,1:14:18.83,jp,NTP,0000,0000,0000,,Сіздің қарныңыз ашты деп ойлаймын.
Dialogue: 0,1:14:26.45,1:14:27.28,jp,NTP,0000,0000,0000,,Балалар
Dialogue: 0,1:14:27.35,1:14:27.70,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,1:14:31.24,1:14:33.40,jp,NTP,0000,0000,0000,,Дәл, түсіну үшін неше рет айту керек?
Dialogue: 0,1:14:33.79,1:14:35.26,jp,NTP,0000,0000,0000,,Ешқашан ұры болма
Dialogue: 0,1:14:38.15,1:14:39.24,jp,NTP,0000,0000,0000,,Бұл жақсы емес.
Dialogue: 0,1:14:42.06,1:14:45.40,jp,NTP,0000,0000,0000,,Не, сіз оны жаңа ғана алдыңыз ба?
Dialogue: 0,1:14:48.44,1:14:49.36,jp,NTP,0000,0000,0000,,Сіз не істеп жатырсыз?
Dialogue: 0,1:14:50.05,1:14:53.62,jp,NTP,0000,0000,0000,,Бұл әкең анаңды сатып алған маңызды нәрсе.
Dialogue: 0,1:14:54.00,1:14:54.97,jp,NTP,0000,0000,0000,,Леви…
Dialogue: 0,1:14:58.75,1:14:59.74,jp,NTP,0000,0000,0000,,Егер мен оны қайтарсам
Dialogue: 0,1:15:00.55,1:15:01.17,jp,NTP,0000,0000,0000,,Эй
Dialogue: 0,1:15:07.69,1:15:09.89,jp,NTP,0000,0000,0000,,Тоқта, тоқта.
Dialogue: 0,1:15:10.18,1:15:11.30,jp,NTP,0000,0000,0000,,Леви…
Dialogue: 0,1:15:23.74,1:15:24.36,jp,NTP,0000,0000,0000,,Момо
Dialogue: 0,1:15:38.82,1:15:40.01,jp,NTP,0000,0000,0000,,Бұл не?
Dialogue: 0,1:15:44.50,1:15:45.44,jp,NTP,0000,0000,0000,,Сіз ауырып қалдыңыз ба?
Dialogue: 0,1:15:48.98,1:15:51.55,jp,NTP,0000,0000,0000,,Анашым, кешіріңіз.
Dialogue: 0,1:15:51.96,1:15:53.47,jp,NTP,0000,0000,0000,,Айна сынды
Dialogue: 0,1:15:53.95,1:15:55.06,jp,NTP,0000,0000,0000,,Айна дұрыс па?
Dialogue: 0,1:16:03.23,1:16:05.38,jp,NTP,0000,0000,0000,,Бұл нені білдіретінін айтыңыз.
Dialogue: 0,1:16:06.01,1:16:06.74,jp,NTP,0000,0000,0000,,Жоқ.
Dialogue: 0,1:16:07.89,1:16:09.23,jp,NTP,0000,0000,0000,,Мен оны қабылдаған жоқпын.
Dialogue: 0,1:16:10.16,1:16:12.15,jp,NTP,0000,0000,0000,,Маған біреу әкелді.
Dialogue: 0,1:16:13.86,1:16:14.62,jp,NTP,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,1:16:16.36,1:16:17.31,jp,NTP,0000,0000,0000,,Шынымды айтсам
Dialogue: 0,1:16:20.64,1:16:21.04,jp,NTP,0000,0000,0000,,Момо
Dialogue: 0,1:16:25.09,1:16:27.38,jp,NTP,0000,0000,0000,,Сіз маған сенбейтін шығарсыз, бірақ
Dialogue: 0,1:16:29.09,1:16:30.38,jp,NTP,0000,0000,0000,,Құбыжық бар
Dialogue: 0,1:16:31.55,1:16:33.07,jp,NTP,0000,0000,0000,,Менің қарным ашты
Dialogue: 0,1:16:37.23,1:16:38.96,jp,NTP,0000,0000,0000,,Момо, сен өтірік айта алмайсың.
Dialogue: 0,1:16:40.23,1:16:41.13,jp,NTP,0000,0000,0000,,Бұл өтірік емес
Dialogue: 0,1:16:41.88,1:16:42.32,jp,NTP,0000,0000,0000,,Момо
Dialogue: 0,1:16:43.49,1:16:44.68,jp,NTP,0000,0000,0000,,Өтірік емес
Dialogue: 0,1:16:45.19,1:16:47.23,jp,NTP,0000,0000,0000,,Сонда бұл құбыжық қайда?
Dialogue: 0,1:16:50.79,1:16:51.73,jp,NTP,0000,0000,0000,,Мен осындамын
Dialogue: 0,1:16:53.04,1:16:53.79,jp,NTP,0000,0000,0000,,Онда жоқ.
Dialogue: 0,1:16:54.86,1:16:55.62,jp,NTP,0000,0000,0000,,Бар
Dialogue: 0,1:16:56.21,1:16:57.02,jp,NTP,0000,0000,0000,,Онда емес пе?
Dialogue: 0,1:16:57.72,1:16:58.72,jp,NTP,0000,0000,0000,,Сіз осындасыз.
Dialogue: 0,1:17:08.68,1:17:10.78,jp,NTP,0000,0000,0000,,Анашым, бұл біртүрлі.
Dialogue: 0,1:17:12.65,1:17:13.08,jp,NTP,0000,0000,0000,,Не
Dialogue: 0,1:17:15.58,1:17:19.05,jp,NTP,0000,0000,0000,,Әкем қайтыс болғаннан бері бәрі өзгерді.
Dialogue: 0,1:17:20.76,1:17:21.69,jp,NTP,0000,0000,0000,,Алданбаңыз
Dialogue: 0,1:17:23.37,1:17:24.38,jp,NTP,0000,0000,0000,,Жаңылтпау
Dialogue: 0,1:17:25.06,1:17:27.77,jp,NTP,0000,0000,0000,,Анам мен туралы мүлдем ештеңе түсінбейді.
Dialogue: 0,1:17:29.96,1:17:31.00,jp,NTP,0000,0000,0000,,Сіз үйде емессіз.
Dialogue: 0,1:17:36.25,1:17:40.51,jp,NTP,0000,0000,0000,,Анашым, мен де әкемді ұмытып кетіппін.
Dialogue: 0,1:17:42.45,1:17:45.02,jp,NTP,0000,0000,0000,,Күте тұрыңыз, әлі біткен жоқ.
Dialogue: 0,1:18:37.28,1:18:38.48,jp,NTP,0000,0000,0000,,Кеше не болды?
Dialogue: 0,1:18:40.58,1:18:41.51,jp,NTP,0000,0000,0000,,Бір минут күтіңіз.
Dialogue: 0,1:18:42.64,1:18:43.09,jp,NTP,0000,0000,0000,,Кешіріңіз
Dialogue: 0,1:18:46.98,1:18:50.03,jp,NTP,0000,0000,0000,,Негізі бесінші курсқа дейін секірмедім.
Dialogue: 0,1:18:50.80,1:18:52.76,jp,NTP,0000,0000,0000,,Күндердің бірінде секіре аласыз.
Dialogue: 0,1:18:56.60,1:18:57.76,jp,NTP,0000,0000,0000,,Жақында фестиваль келеді
Dialogue: 0,1:18:59.40,1:19:03.53,jp,NTP,0000,0000,0000,,Әкең мен басқалары мен саған кеше көрсеткен сабан қайықты көтеріп, теңізге жібереді.
Dialogue: 0,1:19:04.62,1:19:05.89,jp,NTP,0000,0000,0000,,Бұл әдемі.
Dialogue: 0,1:19:07.85,1:19:09.30,jp,NTP,0000,0000,0000,,Әкесі мұнда жоқ
Dialogue: 0,1:20:26.35,1:20:27.87,jp,NTP,0000,0000,0000,,Көп уайымдамаңыз
Dialogue: 0,1:20:28.54,1:20:30.52,jp,NTP,0000,0000,0000,,Ата-ана мен баланың ортақ ұрысы
Dialogue: 0,1:20:31.71,1:20:35.03,jp,NTP,0000,0000,0000,,Сіз не туралы айтып отырсыз? Бұл сенің кінәң.
Dialogue: 0,1:20:43.76,1:20:44.22,jp,NTP,0000,0000,0000,,Оны түсініп-ақ болмайды.
Dialogue: 0,1:20:47.40,1:20:50.57,jp,NTP,0000,0000,0000,,Әкем өлмес бұрын екеуміз ұрысып қалдық.
Dialogue: 0,1:20:51.41,1:20:52.13,jp,NTP,0000,0000,0000,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,1:20:54.70,1:20:57.98,jp,NTP,0000,0000,0000,,Анасы мен әкесі бірінші кездесуге барған кезде
Dialogue: 0,1:20:59.06,1:21:01.60,jp,NTP,0000,0000,0000,,Вена ұлдар хорын көруге барғанын айтты.
Dialogue: 0,1:21:06.31,1:21:10.35,jp,NTP,0000,0000,0000,,Биыл біздің үйлену тойымызға хордың келетінін білдім.
Dialogue: 0,1:21:11.48,1:21:15.26,jp,NTP,0000,0000,0000,,Мен анамнан үш билет сатып алуын өтіндім.
Dialogue: 0,1:21:18.81,1:21:23.29,jp,NTP,0000,0000,0000,,Бірақ әкеңізге күнді уәде етіңіз.
Dialogue: 0,1:21:23.92,1:21:25.89,jp,NTP,0000,0000,0000,,Мен хорды құпия ұстадым.
Dialogue: 0,1:21:26.95,1:21:28.37,jp,NTP,0000,0000,0000,,Бұл таң қалдырды.
Dialogue: 0,1:21:32.73,1:21:35.47,jp,NTP,0000,0000,0000,,Содан, сол күні, кенеттен
Dialogue: 0,1:21:37.54,1:21:41.24,jp,NTP,0000,0000,0000,,Кешіріңіз, келесі аптада міндетті түрде ашық қалдырамын.
Dialogue: 0,1:21:42.37,1:21:44.29,jp,NTP,0000,0000,0000,,Бүгін болуы керек.
Dialogue: 0,1:21:45.63,1:21:46.83,jp,NTP,0000,0000,0000,,Бұл маңызды зерттеу.
Dialogue: 0,1:21:48.09,1:21:51.01,jp,NTP,0000,0000,0000,,Әкем бармаса, көптің басына күн тудырады.
Dialogue: 0,1:21:52.49,1:21:53.53,jp,NTP,0000,0000,0000,,Өйткені
Dialogue: 0,1:21:56.25,1:21:57.32,jp,NTP,0000,0000,0000,,...
Dialogue: 0,1:22:00.46,1:22:02.14,jp,NTP,0000,0000,0000,,Осы сияқты
Dialogue: 0,1:22:09.94,1:22:10.58,jp,NTP,0000,0000,0000,,Жетеді
Dialogue: 0,1:22:11.85,1:22:13.27,jp,NTP,0000,0000,0000,,Мен әкемді жек көремін.
Dialogue: 0,1:22:22.12,1:22:23.52,jp,NTP,0000,0000,0000,,Енді қайтып келудің қажеті жоқ.
Dialogue: 0,1:23:12.36,1:23:14.63,jp,NTP,0000,0000,0000,,Неге олай дедің?
Dialogue: 0,1:23:18.32,1:23:19.79,jp,NTP,0000,0000,0000,,Кешіріңіз.
Dialogue: 0,1:23:20.26,1:23:25.91,jp,NTP,0000,0000,0000,,Оның соншалықты маңызды хат екенін білмедім, қателесіп көкке жібердім.
Dialogue: 0,1:23:28.21,1:23:31.39,jp,NTP,0000,0000,0000,,Аспан дегенді қалай түсінесіңдер?
Dialogue: 0,1:23:32.13,1:23:38.88,jp,NTP,0000,0000,0000,,Бұл шатырда емес, үлкен аспанда.
Dialogue: 0,1:23:47.04,1:23:49.01,jp,NTP,0000,0000,0000,,Ауыл шаруашылығы кемесі Жарайды ма?
Dialogue: 0,1:23:49.35,1:23:49.71,jp,NTP,0000,0000,0000,,О.
Dialogue: 0,1:23:52.26,1:23:53.01,jp,NTP,0000,0000,0000,,Йота-кун
Dialogue: 0,1:24:00.08,1:24:03.81,jp,NTP,0000,0000,0000,,Йота-кун, сен Момоны көрмедің бе?
Dialogue: 0,1:24:05.18,1:24:08.74,jp,NTP,0000,0000,0000,,Жағажайда ән айтқанымызға біраз болды.
Dialogue: 0,1:24:09.60,1:24:10.89,jp,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,1:24:11.77,1:24:14.82,jp,NTP,0000,0000,0000,,Апай, мен ол жігітке жаман сөз айтқан шығармын.
Dialogue: 0,1:24:24.88,1:24:28.51,jp,NTP,0000,0000,0000,,Не болып жатыр? Сенімен бәрі жақсы ма? Мықты болыңыз.
Dialogue: 0,1:24:32.51,1:24:36.78,jp,NTP,0000,0000,0000,,Баяғыда біз көп жамандық жасадық.
Dialogue: 0,1:24:37.63,1:24:42.01,jp,NTP,0000,0000,0000,,Мен шектен шығып, аспан иесінің оқына іліктім.
Dialogue: 0,1:24:43.59,1:24:47.57,jp,NTP,0000,0000,0000,,Ол өзінің бастапқы пішінін жоғалтты және оның сиқырлы күштерінің көпшілігі жойылды.
Dialogue: 0,1:24:48.07,1:24:50.83,jp,NTP,0000,0000,0000,,Енді мен керексіз адаммын.
Dialogue: 0,1:24:51.57,1:24:53.24,jp,NTP,0000,0000,0000,,Сіздің тәбетіңіз ғана қалады.
Dialogue: 0,1:24:54.88,1:24:57.08,jp,NTP,0000,0000,0000,,Оның бітпейтін міндеті бар.
Dialogue: 0,1:24:59.10,1:25:00.70,jp,NTP,0000,0000,0000,,Мичизан Сугавара туралы не деуге болады?
Dialogue: 0,1:25:02.21,1:25:03.13,jp,NTP,0000,0000,0000,,Бұл өтірік
Dialogue: 0,1:25:03.75,1:25:05.15,jp,NTP,0000,0000,0000,,Не деген өтірік
Dialogue: 0,1:25:06.79,1:25:09.85,jp,NTP,0000,0000,0000,,Қайта-қайта таңдануды доғар, қария.
Dialogue: 0,1:25:10.21,1:25:11.38,jp,NTP,0000,0000,0000,,Маған бәрібір.
Dialogue: 0,1:25:13.60,1:25:14.24,jp,NTP,0000,0000,0000,,Момо-доно
Dialogue: 0,1:25:14.83,1:25:19.22,jp,NTP,0000,0000,0000,,Біздің Иеміздің әкесімен байланысымыз бар.
Dialogue: 0,1:25:21.03,1:25:28.37,jp,NTP,0000,0000,0000,,Өлген адамдар жерде біраз қалқып, аспанға қарай бет алады.
Dialogue: 0,1:25:28.96,1:25:35.26,jp,NTP,0000,0000,0000,,Жерден аспанға көшіп бара жатып, артында қалған отбасына қарау мүмкін емес.
Dialogue: 0,1:25:35.99,1:25:39.50,jp,NTP,0000,0000,0000,,Сол уақытта Жаратқан Ие оның отбасын бақылап отырды.
Dialogue: 0,1:25:39.83,1:25:44.16,jp,NTP,0000,0000,0000,,Аспанға есеп беру – қамқоршы борышымыз.
Dialogue: 0,1:25:45.70,1:25:47.95,jp,NTP,0000,0000,0000,,Әке жақында аспанға келеді.
Dialogue: 0,1:25:48.51,1:25:54.66,jp,NTP,0000,0000,0000,,Шеберлерді өз көзімізбен бақылай алсақ, рөліміз аяқталады.
Dialogue: 0,1:25:55.44,1:25:58.06,jp,NTP,0000,0000,0000,,Қандай болса да, Мин әулеті.
Dialogue: 0,1:25:58.77,1:25:59.74,jp,NTP,0000,0000,0000,,Сурет салу уақыты келді
Dialogue: 0,1:26:01.04,1:26:04.76,jp,NTP,0000,0000,0000,,Жарайды, көп айта алмаймын, кешіріңізші.
Dialogue: 0,1:26:05.44,1:26:07.79,jp,NTP,0000,0000,0000,,Сәлеметсіз бе, мен бәрін айттым.
Dialogue: 0,1:26:10.35,1:26:11.02,jp,NTP,0000,0000,0000,,Менің әкем
Dialogue: 0,1:26:16.07,1:26:17.95,jp,NTP,0000,0000,0000,,Момо-чан?
Dialogue: 0,1:26:22.28,1:26:23.59,jp,NTP,0000,0000,0000,,Қараңғы жерге құлап қалдыңыз ба?
Dialogue: 0,1:26:24.22,1:26:26.86,jp,NTP,0000,0000,0000,,Тезірек артқа мін. Icchan маңызды.
Dialogue: 0,1:26:28.85,1:26:29.38,jp,NTP,0000,0000,0000,,Момо-чан
Dialogue: 0,1:26:47.30,1:26:47.91,jp,NTP,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,1:26:48.60,1:26:49.39,jp,NTP,0000,0000,0000,,Момо-чан
Dialogue: 0,1:26:52.49,1:26:53.18,jp,NTP,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,1:26:54.99,1:26:57.89,jp,NTP,0000,0000,0000,,Момо жақсы болды.
Dialogue: 0,1:26:58.58,1:27:01.00,jp,NTP,0000,0000,0000,,Жарайды, сізді алаңдатқаным үшін кешіріңіз.
Dialogue: 0,1:27:04.74,1:27:05.49,jp,NTP,0000,0000,0000,,Дәрігер
Dialogue: 0,1:27:05.97,1:27:10.85,jp,NTP,0000,0000,0000,,Дәл сол кезде дәрігер мен медбике Мицуко көрші аралға үй шақыруға барды.
Dialogue: 0,1:27:10.98,1:27:13.68,jp,NTP,0000,0000,0000,,Осы тайфун мені осылай кері қайтуға мәжбүр етті.
Dialogue: 0,1:27:15.90,1:27:18.07,jp,NTP,0000,0000,0000,,Мен дымқыл болдым, бірақ киімімді ауыстыруым керек.
Dialogue: 0,1:27:18.51,1:27:19.56,jp,NTP,0000,0000,0000,,Жоқ, менде бәрі жақсы.
Dialogue: 0,1:27:21.99,1:27:25.56,jp,NTP,0000,0000,0000,,Мицуконың әпкесі қазір менімен әртүрлі мәселелер бойынша хабарласып жатыр.
Dialogue: 0,1:27:30.74,1:27:32.12,jp,NTP,0000,0000,0000,,Бұл дұрыс емес.
Dialogue: 0,1:27:33.61,1:27:37.50,jp,NTP,0000,0000,0000,,Тайфун әлсірегенше кемелерді де, медициналық тікұшақтарды да жіберуге болмайды.
Dialogue: 0,1:27:38.34,1:27:41.67,jp,NTP,0000,0000,0000,,Дәрігердің жалғыз болуы қиын болады деп айтылды.
Dialogue: 0,1:27:42.31,1:27:43.41,jp,NTP,0000,0000,0000,,Не істеуім керек?
Dialogue: 0,1:27:46.54,1:27:51.68,jp,NTP,0000,0000,0000,,Дәрігер немесе медбике болса, оттегін ингаляцияға немесе бұлшықет ішіне енгізуге болатын сияқты.
Dialogue: 0,1:27:58.07,1:28:01.64,jp,NTP,0000,0000,0000,,Бұл шынымен жұмыс істемейді, сондықтан оны қайта-қайта соғудың қажеті жоқ.
Dialogue: 0,1:28:07.36,1:28:08.05,jp,NTP,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,1:28:09.61,1:28:10.27,jp,NTP,0000,0000,0000,,Icchan
Dialogue: 0,1:28:19.47,1:28:21.23,jp,NTP,0000,0000,0000,,Көпір
Dialogue: 0,1:28:21.70,1:28:24.93,jp,NTP,0000,0000,0000,,Ол аяқталуы керек, бірақ ол әлі ашылған жоқ.
Dialogue: 0,1:28:25.87,1:28:29.79,jp,NTP,0000,0000,0000,,Бұл тайфун өте жақсы ашылды.
Dialogue: 0,1:28:45.76,1:28:48.00,jp,NTP,0000,0000,0000,,Мама, осылай жүре берсек не болады?
Dialogue: 0,1:28:48.94,1:28:52.31,jp,NTP,0000,0000,0000,,Тайфун басыла сала бірден дәрігер келеді.
Dialogue: 0,1:28:53.44,1:28:54.86,jp,NTP,0000,0000,0000,,Ол сәйкес келмесе не болады?
Dialogue: 0,1:28:55.43,1:29:00.03,jp,NTP,0000,0000,0000,,Ақырында орнығады, уайымдама, тыныштал.
Dialogue: 0,1:29:04.16,1:29:07.98,jp,NTP,0000,0000,0000,,Сіз өзіңізді тым зорлап жіберген шығарсыз, бейшара.
Dialogue: 0,1:29:09.79,1:29:11.88,jp,NTP,0000,0000,0000,,Мен мұңайып отырмын.
Dialogue: 0,1:29:13.56,1:29:17.84,jp,NTP,0000,0000,0000,,Ешкімге айтқан жоқпын, бұдан да ауыр болса керек.
Dialogue: 0,1:30:13.45,1:30:15.80,jp,NTP,0000,0000,0000,,Анам жылап отырды.
Dialogue: 0,1:30:33.96,1:30:36.56,jp,NTP,0000,0000,0000,,Көпірден өтіп, менімен бірге Имабариге барыңыз.
Dialogue: 0,1:30:36.94,1:30:38.18,jp,NTP,0000,0000,0000,,Мен дәрігерді шақырғым келеді.
Dialogue: 0,1:30:38.79,1:30:42.93,jp,NTP,0000,0000,0000,,Бұл мүмкін емес. Біз адамдардың өмірі мен өліміне араласқымыз келмейді.
Dialogue: 0,1:30:43.28,1:30:44.21,jp,NTP,0000,0000,0000,,Өтінемін
Dialogue: 0,1:30:45.26,1:30:47.47,jp,NTP,0000,0000,0000,,Тыйым салынған қылмыс жасасам не болады?
Dialogue: 0,1:30:47.72,1:30:50.33,jp,NTP,0000,0000,0000,,Біріншіден, бізде мұндай күш бар ма?
Dialogue: 0,1:30:54.12,1:30:55.50,jp,NTP,0000,0000,0000,,Мен бәрін істеймін дедім.
Dialogue: 0,1:30:56.11,1:30:59.06,jp,NTP,0000,0000,0000,,Есеп бұзылса да, мен мұны істей алмаймын.
Dialogue: 0,1:30:59.28,1:31:02.55,jp,NTP,0000,0000,0000,,Дұрыс. Таң атқанда біз де тартамыз.
Dialogue: 0,1:31:02.90,1:31:04.84,jp,NTP,0000,0000,0000,,Мен жайбарақат алғаныңызды қалаймын.
Dialogue: 0,1:31:08.47,1:31:10.81,jp,NTP,0000,0000,0000,,Бұл жеткілікті. Мен сұрамаймын. Мен мұны өзім жасаймын.
Dialogue: 0,1:31:30.06,1:31:30.73,jp,NTP,0000,0000,0000,,Момо-чан
Dialogue: 0,1:31:32.16,1:31:33.85,jp,NTP,0000,0000,0000,,Эй, Сачичи, қазір тоқтай аласың ба?
Dialogue: 0,1:31:39.00,1:31:41.82,jp,NTP,0000,0000,0000,,Қария, мотоцикл, мотоцикл
Dialogue: 0,1:31:43.41,1:31:44.21,jp,NTP,0000,0000,0000,,Енді не болады?
Dialogue: 0,1:31:47.95,1:31:49.70,jp,NTP,0000,0000,0000,,Кілт қайда? Кілт қайда?
Dialogue: 0,1:32:00.76,1:32:04.62,jp,NTP,0000,0000,0000,,Мен анамның сезімін ешқашан түсінбедім.
Dialogue: 0,1:32:17.47,1:32:18.56,jp,NTP,0000,0000,0000,,Момо-чан, №.
Dialogue: 0,1:32:19.65,1:32:21.54,jp,NTP,0000,0000,0000,,Мені жіберуіңізді өтінемін
Dialogue: 0,1:32:22.62,1:32:24.86,jp,NTP,0000,0000,0000,,Бейбіт болмаңыз. Қайтып келу.
Dialogue: 0,1:32:25.18,1:32:27.00,jp,NTP,0000,0000,0000,,Бұлай жалғаса берсе, анаң өледі.
Dialogue: 0,1:32:27.51,1:32:29.91,jp,NTP,0000,0000,0000,,Ақымақ болма.
Dialogue: 0,1:32:32.09,1:32:33.67,jp,NTP,0000,0000,0000,,Енді қайтайық
Dialogue: 0,1:32:38.95,1:32:43.42,jp,NTP,0000,0000,0000,,Мен, мен әкеммен татуласа алмадым.
Dialogue: 0,1:32:45.83,1:32:48.90,jp,NTP,0000,0000,0000,,Мен де бүгін анама бір сұмдық айттым.
Dialogue: 0,1:32:51.33,1:32:54.44,jp,NTP,0000,0000,0000,,Менің қазір кетуім керек. Мен анама міндетті түрде көмектесемін.
Dialogue: 0,1:32:55.59,1:32:56.43,jp,NTP,0000,0000,0000,,Момо-чан
Dialogue: 0,1:32:57.65,1:32:59.56,jp,NTP,0000,0000,0000,,Ағай, бірдеңе істей аласыз ба?
Dialogue: 0,1:33:00.78,1:33:02.37,jp,NTP,0000,0000,0000,,Қарт болсаң, көмектесе аласың.
Dialogue: 0,1:33:03.19,1:33:05.71,jp,NTP,0000,0000,0000,,Ағай, маған көмектесіңізші
Dialogue: 0,1:33:06.95,1:33:07.66,jp,NTP,0000,0000,0000,,Yota
Dialogue: 0,1:33:10.70,1:33:13.05,jp,NTP,0000,0000,0000,,Сіз агрессивтісіз.
Dialogue: 0,1:33:14.02,1:33:15.57,jp,NTP,0000,0000,0000,,Мен ше?
Dialogue: 0,1:33:31.79,1:33:35.02,jp,NTP,0000,0000,0000,,Иччан мен үшін де маңызды.
Dialogue: 0,1:33:38.33,1:33:39.00,jp,NTP,0000,0000,0000,,Тезірек кемеге мін.
Dialogue: 0,1:33:43.27,1:33:44.58,jp,NTP,0000,0000,0000,,Йота, дұға ет.
Dialogue: 0,1:33:48.33,1:33:51.54,jp,NTP,0000,0000,0000,,Сәттілік Мияура
Dialogue: 0,1:33:59.06,1:34:00.31,jp,NTP,0000,0000,0000,,Оған көмектесу мүмкін емес.
Dialogue: 0,1:34:01.29,1:34:05.42,jp,NTP,0000,0000,0000,,Жақында тыйым салуды қозғаған нәрсе болды.
Dialogue: 0,1:34:05.96,1:34:09.32,jp,NTP,0000,0000,0000,,Соңы аянышты болды, сұмдық.
Dialogue: 0,1:34:09.81,1:34:11.77,jp,NTP,0000,0000,0000,,Менің өлгім келмейді
Dialogue: 0,1:34:13.40,1:34:17.81,jp,NTP,0000,0000,0000,,Томоко Икуко өлсе, біздің жағдайымыз не болады деп ойлаймын.
Dialogue: 0,1:34:18.55,1:34:22.31,jp,NTP,0000,0000,0000,,Иә, бұл табиғи өлім немесе тағдырлы өлім болса, бәрібір.
Dialogue: 0,1:34:23.10,1:34:26.39,jp,NTP,0000,0000,0000,,Бірақ әйтпесе, біз қамқоршы болу құқығынан айырыламыз.
Dialogue: 0,1:34:26.68,1:34:28.11,jp,NTP,0000,0000,0000,,Яғни, бұл
Dialogue: 0,1:34:28.59,1:34:31.24,jp,NTP,0000,0000,0000,,Оның үстіне бір адам болса да, екі адам болса да маңызды емес.
Dialogue: 0,1:34:32.09,1:34:36.64,jp,NTP,0000,0000,0000,,Күте тұрыңыз, бұл жолы біз себепкерміз.
Dialogue: 0,1:34:43.26,1:34:47.67,jp,NTP,0000,0000,0000,,Олай болса, егер сіз Момо-доноға көмектессеңіз, тіпті тыйымды бұзсаңыз да,
Dialogue: 0,1:34:48.26,1:34:52.03,jp,NTP,0000,0000,0000,,Сайып келгенде, олар өздерінің қамқоршы тобы ретіндегі міндеттерін орындамас па еді?
Dialogue: 0,1:34:52.31,1:34:54.72,jp,NTP,0000,0000,0000,,Сіз ауыр жазадан құтыла аласыз.
Dialogue: 0,1:34:55.64,1:34:56.32,jp,NTP,0000,0000,0000,,Мен көремін.
Dialogue: 0,1:34:57.97,1:34:58.96,jp,NTP,0000,0000,0000,,Жоқ, күтіңіз, күтіңіз.
Dialogue: 0,1:34:59.19,1:35:01.87,jp,NTP,0000,0000,0000,,Сонымен, біз өз бетімізше не істей аламыз?
Dialogue: 0,1:35:02.58,1:35:05.31,jp,NTP,0000,0000,0000,,Ол көп ысыра алады немесе өте жылдам жүре алады.
Dialogue: 0,1:35:05.31,1:35:07.60,jp,NTP,0000,0000,0000,,Сіз дауылды осындай нәрсемен жеңе аласыз ба?
Dialogue: 0,1:35:08.65,1:35:09.88,jp,NTP,0000,0000,0000,,Мені күлдірме
Dialogue: 0,1:35:15.87,1:35:17.17,jp,NTP,0000,0000,0000,,Менің достарым бар
Dialogue: 0,1:35:36.54,1:35:38.07,jp,NTP,0000,0000,0000,,Жарайды, кеттік.
Dialogue: 0,1:35:38.67,1:35:38.98,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,1:35:51.76,1:35:53.61,jp,NTP,0000,0000,0000,,Дұрыс ұстаңыз
Dialogue: 0,1:37:09.58,1:37:10.07,jp,NTP,0000,0000,0000,,Сайвайчи мырза
Dialogue: 0,1:37:10.95,1:37:11.74,jp,NTP,0000,0000,0000,,Жарайды.
Dialogue: 0,1:37:43.84,1:37:46.06,jp,NTP,0000,0000,0000,,Боқ, жоқ.
Dialogue: 0,1:38:04.96,1:38:05.76,jp,NTP,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,1:38:13.87,1:38:19.90,jp,NTP,0000,0000,0000,,Әке, анама көмектес.
Dialogue: 0,1:39:01.13,1:39:04.48,jp,NTP,0000,0000,0000,,Момо
Dialogue: 0,1:39:05.34,1:39:10.05,jp,NTP,0000,0000,0000,,Ива Кава Маме Барлығы келді.
Dialogue: 0,1:39:11.98,1:39:13.09,jp,NTP,0000,0000,0000,,Момо-доно
Dialogue: 0,1:39:13.30,1:39:18.75,jp,NTP,0000,0000,0000,,Алға қарай жүгір, өйткені біз сені оқтан қорғаймыз.
Dialogue: 0,1:39:33.74,1:39:36.86,jp,NTP,0000,0000,0000,,Момо-чан жаңбыры
Dialogue: 0,1:39:37.41,1:39:38.56,jp,NTP,0000,0000,0000,,Қазір болды, кеттік.
Dialogue: 0,1:39:39.24,1:39:40.55,jp,NTP,0000,0000,0000,,Сен ақымақ
Dialogue: 0,1:39:41.54,1:39:42.50,jp,NTP,0000,0000,0000,,Сайвайчи мырза
Dialogue: 0,1:39:54.77,1:39:55.88,jp,NTP,0000,0000,0000,,Жүгіруіңізді өтінемін
Dialogue: 0,1:40:21.76,1:40:22.93,jp,NTP,0000,0000,0000,,Хе-хе, рақмет
Dialogue: 0,1:40:58.85,1:40:59.77,jp,NTP,0000,0000,0000,,Сайвайчи мырза
Dialogue: 0,1:41:09.39,1:41:09.96,jp,NTP,0000,0000,0000,,Ива
Dialogue: 0,1:41:10.20,1:41:13.00,jp,NTP,0000,0000,0000,,Егер бұл орын алса, мен шарасызмын.
Dialogue: 0,1:41:56.46,1:41:57.61,jp,NTP,0000,0000,0000,,Жарайды
Dialogue: 0,1:41:58.73,1:42:00.38,jp,NTP,0000,0000,0000,,Hyahoo degozaru
Dialogue: 0,1:42:05.38,1:42:06.21,jp,NTP,0000,0000,0000,,Керемет
Dialogue: 0,1:42:17.77,1:42:19.52,jp,NTP,0000,0000,0000,,Шикоку
Dialogue: 0,1:42:27.51,1:42:29.05,jp,NTP,0000,0000,0000,,Бәрі қайталанды
Dialogue: 0,1:42:30.03,1:42:33.11,jp,NTP,0000,0000,0000,,Мен қайтып келгенше күте тұрыңыз.
Dialogue: 0,1:42:33.49,1:42:37.01,jp,NTP,0000,0000,0000,,Маған жаңбыр ұнамайды, асығыңыз.
Dialogue: 0,1:43:25.38,1:43:28.26,jp,NTP,0000,0000,0000,,Мен үйге біраз уақыт кетейін, бірақ көп ұзамай қайтамын.
Dialogue: 0,1:43:51.51,1:43:53.65,jp,NTP,0000,0000,0000,,Жақсы, мен оны уақытында жасадым.
Dialogue: 0,1:43:55.47,1:43:59.09,jp,NTP,0000,0000,0000,,Рахмет. Барлығына рахмет, анам жақсы болды.
Dialogue: 0,1:44:00.69,1:44:04.63,jp,NTP,0000,0000,0000,,Мен күзетші ретінде өзімнен күткен нәрсені істедім.
Dialogue: 0,1:44:04.96,1:44:07.52,jp,NTP,0000,0000,0000,,Жарайды, жартысы өзім үшін.
Dialogue: 0,1:44:08.65,1:44:16.38,jp,NTP,0000,0000,0000,,Жарайды, мүмкін болса, мына хатты әкеңе беруіңді қалаймын.
Dialogue: 0,1:44:18.02,1:44:20.81,jp,NTP,0000,0000,0000,,Бұған да тыйым салынған.
Dialogue: 0,1:44:21.35,1:44:26.92,jp,NTP,0000,0000,0000,,Мен ненің дұрыс, ненің дұрыс емес екенін есіме түсіре алмаймын, мүмкін мен мұны істей аламын.
Dialogue: 0,1:44:28.57,1:44:30.81,jp,NTP,0000,0000,0000,,Мен сенің алаңсыз екеніңді қызғанамын.
Dialogue: 0,1:44:32.68,1:44:35.44,jp,NTP,0000,0000,0000,,Абайо, мен де сенің бауырыңды жегім келді.
Dialogue: 0,1:44:35.96,1:44:39.47,jp,NTP,0000,0000,0000,,Сайвайичиді тұтас жұтып алғым келді.
Dialogue: 0,1:44:40.22,1:44:40.85,jp,NTP,0000,0000,0000,,Мен
Dialogue: 0,1:44:45.20,1:44:46.38,jp,NTP,0000,0000,0000,,Мандарин апельсиндері жақсы.
Dialogue: 0,1:44:56.17,1:44:57.73,jp,NTP,0000,0000,0000,,Айтпақшы, яғни
Dialogue: 0,1:45:02.16,1:45:04.77,jp,NTP,0000,0000,0000,,Тоқта, бұл жеке.
Dialogue: 0,1:45:15.86,1:45:19.20,jp,NTP,0000,0000,0000,,Жетер, мен естеліктерді әдемі етіп сақтаймын.
Dialogue: 0,1:45:19.90,1:45:20.73,jp,NTP,0000,0000,0000,,Кетіңіз
Dialogue: 0,1:45:23.51,1:45:26.02,jp,NTP,0000,0000,0000,,Олай болса мен сіздің сөзіңізді қабылдаймын.
Dialogue: 0,1:45:30.07,1:45:33.51,jp,NTP,0000,0000,0000,,Дочии Умоёру Домонирасо
Dialogue: 0,1:45:45.92,1:45:48.63,jp,NTP,0000,0000,0000,,Барлығыңызға рахмет, мен оны ешқашан ұмытпаймын.
Dialogue: 0,1:45:49.43,1:45:51.47,jp,NTP,0000,0000,0000,,Әйелдер үнемі солай айтады.
Dialogue: 0,1:45:52.77,1:45:54.99,jp,NTP,0000,0000,0000,,Олай болса, кешіріңіз.
Dialogue: 0,1:47:08.88,1:47:10.41,jp,NTP,0000,0000,0000,,Қош бол
Dialogue: 0,1:47:45.29,1:47:46.13,jp,NTP,0000,0000,0000,,Әкемге
Dialogue: 0,1:47:47.48,1:47:48.64,jp,NTP,0000,0000,0000,,Менде бәрі жақсы
Dialogue: 0,1:47:50.54,1:47:52.62,jp,NTP,0000,0000,0000,,Кешіріңіз, сол кезде қорқынышты нәрсе айтқаным үшін.
Dialogue: 0,1:47:53.78,1:47:55.18,jp,NTP,0000,0000,0000,,Мен әрқашан кешірім сұрағым келді.
Dialogue: 0,1:47:57.53,1:47:59.92,jp,NTP,0000,0000,0000,,Құбыжықтар анама көмектесті
Dialogue: 0,1:48:01.32,1:48:03.85,jp,NTP,0000,0000,0000,,Әкем де алғыс айтса қуанар едім.
Dialogue: 0,1:48:05.07,1:48:09.37,jp,NTP,0000,0000,0000,,Мүмкін бұл менің білетінімнен басқаша шығар.
Dialogue: 0,1:48:11.35,1:48:14.70,jp,NTP,0000,0000,0000,,Бұдан былай анам екеуміз барымызды саламыз.
Dialogue: 0,1:48:16.29,1:48:20.57,jp,NTP,0000,0000,0000,,Әке, сәл уайымдап, мені бақылай беріңіз.
Dialogue: 0,1:48:22.68,1:48:25.45,jp,NTP,0000,0000,0000,,Менің сүйікті әкем Момоға
Dialogue: 0,1:48:30.08,1:48:33.54,jp,NTP,0000,0000,0000,,Сіздің әкеңіз сол хатта не жазбақ болды?
Dialogue: 0,1:48:34.05,1:48:35.44,jp,NTP,0000,0000,0000,,Мама, мен аздап түсіндім.
Dialogue: 0,1:48:36.34,1:48:36.79,jp,NTP,0000,0000,0000,,Алдымен саусақтарыңды найза пішініне келтір.
Dialogue: 0,1:48:38.38,1:48:41.12,jp,NTP,0000,0000,0000,,Бірдеңені дұрыс істемесем де кешірім сұрағым келді.
Dialogue: 0,1:48:41.77,1:48:42.55,jp,NTP,0000,0000,0000,,Менің ойымша, солай
Dialogue: 0,1:48:43.18,1:48:43.76,jp,NTP,0000,0000,0000,,Уууу… Онда бұны қалай түсіндіресің?
Dialogue: 0,1:48:44.75,1:48:48.35,jp,NTP,0000,0000,0000,,Бірақ менің әкем зерттеу жұмыстарын тегіс жазады.
Dialogue: 0,1:48:48.99,1:48:51.02,jp,NTP,0000,0000,0000,,Себебі мен хат жазуға шебер емес едім.
Dialogue: 0,1:48:51.93,1:48:53.83,jp,NTP,0000,0000,0000,,Мен оны жақсы жаза алмадым деп ойлаймын.
Dialogue: 0,1:48:55.74,1:48:58.25,jp,NTP,0000,0000,0000,,Әрқашан басқа адамның сезімі туралы тым көп ойлау
Dialogue: 0,1:49:10.69,1:49:13.67,jp,NTP,0000,0000,0000,,Әке, сіз теңізді жақсы көретінсіз.
Dialogue: 0,1:49:15.04,1:49:15.39,jp,NTP,0000,0000,0000,,Иә
Dialogue: 0,1:49:17.87,1:49:19.77,jp,NTP,0000,0000,0000,,Сізді ұрғаным үшін кешіріңіз.
Dialogue: 0,1:49:21.75,1:49:24.10,jp,NTP,0000,0000,0000,,Ал анам, Момоноко.
Dialogue: 0,1:49:24.10,1:49:25.88,jp,NTP,0000,0000,0000,,Жоқ, кешіріңіз.
Dialogue: 0,1:49:27.33,1:49:28.71,jp,NTP,0000,0000,0000,,Мен уайымдадым.
Dialogue: 0,1:49:29.14,1:49:30.81,jp,NTP,0000,0000,0000,,Себебі мен ашуландым
Dialogue: 0,1:49:31.33,1:49:34.27,jp,NTP,0000,0000,0000,,Бірақ мен кешірім сұраймын.
Dialogue: 0,1:49:43.49,1:49:48.14,jp,NTP,0000,0000,0000,,Анашым, мен жалғыз өзім қолымнан келгеннің бәрін істеуім керек деп ойлаймын.
Dialogue: 0,1:49:48.53,1:49:50.35,jp,NTP,0000,0000,0000,,Мен қандай да бір себептермен айналамын деп ойлаймын.
Dialogue: 0,1:49:52.09,1:49:54.02,jp,NTP,0000,0000,0000,,Мен сені жалғыз сезіндім
Dialogue: 0,1:49:54.51,1:49:55.02,jp,NTP,0000,0000,0000,,Жоқ
Dialogue: 0,1:49:56.74,1:50:00.12,jp,NTP,0000,0000,0000,,Бұдан былай мен Момомен әр түрлі мәселелер бойынша кеңесетін боламын.
Dialogue: 0,1:50:01.02,1:50:04.15,jp,NTP,0000,0000,0000,,Иә, бірақ мен сенімсізмін.
Dialogue: 0,1:50:05.62,1:50:06.56,jp,NTP,0000,0000,0000,,Мен білемін
Dialogue: 0,1:50:13.67,1:50:14.28,jp,NTP,0000,0000,0000,,Содан кейін
Dialogue: 0,1:50:17.42,1:50:18.09,jp,NTP,0000,0000,0000,,Момоға рахмет
Dialogue: 0,1:50:33.61,1:50:36.03,jp,NTP,0000,0000,0000,,Қолыңнан келгенін істе, әке.
Dialogue: 0,1:50:40.76,1:50:41.36,jp,NTP,0000,0000,0000,,О
Dialogue: 0,1:50:42.14,1:50:43.74,jp,NTP,0000,0000,0000,,Иә, әке.
Dialogue: 0,1:50:44.84,1:50:46.02,jp,NTP,0000,0000,0000,,Момо-чан
Dialogue: 0,1:51:38.66,1:51:40.20,jp,NTP,0000,0000,0000,,Жүр, үйге қайтайық.
Dialogue: 0,1:52:20.23,1:52:20.91,jp,NTP,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,1:53:09.96,1:53:10.71,jp,NTP,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,1:53:13.95,1:53:15.20,jp,NTP,0000,0000,0000,,Онда бірдеңе жазылған ба?
Dialogue: 0,1:53:22.04,1:53:22.99,jp,NTP,0000,0000,0000,,Жақсы жұмыс
Dialogue: 0,1:53:24.58,1:53:26.35,jp,NTP,0000,0000,0000,,Анаңа қамқор бол.
Dialogue: 0,1:53:27.77,1:53:28.76,jp,NTP,0000,0000,0000,,Мен оны үнемі көремін
Dialogue: 0,1:53:31.20,1:53:32.07,jp,NTP,0000,0000,0000,,Әкемнен
Dialogue: 0,1:53:41.38,1:53:42.25,jp,NTP,0000,0000,0000,,Айтуынша, сол шайқас нағыз қанды қырғын болған екен.
Dialogue: 0,1:53:46.87,1:53:47.32,jp,NTP,0000,0000,0000,,Момо
Dialogue: 0,1:53:51.32,1:53:52.07,jp,NTP,0000,0000,0000,,Сол жігіт мүлде есінен танып кетті – адамдар оны ұстап тұруға мәжбүр болды.
Dialogue: 0,1:53:54.42,1:53:56.67,jp,NTP,0000,0000,0000,,Бұл менің әкем екені анық.
Dialogue: 0,1:53:58.00,1:53:59.24,jp,NTP,0000,0000,0000,,Бұл жай ғана доғал таяқ.
Dialogue: 0,1:54:39.33,1:54:43.32,jp,NTP,0000,0000,0000,,Эй Момо-чан, сенің достарың кімдер?
Dialogue: 0,1:54:45.50,1:54:46.17,jp,NTP,0000,0000,0000,,Мен қайттым
Dialogue: 0,1:55:01.10,1:55:01.62,jp,NTP,0000,0000,0000,,Қарақұрым қоңырау белгісі мұнараның шыңынан алыстап барады. Мен оны сеземін.
Dialogue: 0,1:55:04.95,1:55:06.72,jp,NTP,0000,0000,0000,,Мен бүгін секіретін сияқтымын.
Dialogue: 0,1:55:10.66,1:55:11.54,jp,NTP,0000,0000,0000,,Өмірдің өткелін белгілейтін ессіз сағат
Dialogue: 0,1:55:33.98,1:55:34.60,jp,NTP,0000,0000,0000,,Рахмет
Dialogue: 0,1:56:02.05,1:56:02.75,jp,NTP,0000,0000,0000,,Салқын
Dialogue: 0,1:56:02.92,1:56:03.49,jp,NTP,0000,0000,0000,,Бұл… (Бакуго) Э?
Dialogue: 0,1:56:03.49,1:56:05.68,jp,NTP,0000,0000,0000,,Сен мұны істедің, Мияура, сен барыңды салдың.
Dialogue: 0,1:56:05.68,1:56:07.74,jp,NTP,0000,0000,0000,,Енді Момо-чан да аралдың баласы.
Dialogue: 0,1:56:08.03,1:56:10.99,jp,NTP,0000,0000,0000,,Сіз соншалықты жылдам секіре алатыныңыз шынымен таң қалдырады.
Dialogue: 0,1:56:14.09,1:56:23.83,jp-m,NTP,0000,0000,0000,,Алыс уақыт пен кеңістікте жүректі тербететін желдің үні
Dialogue: 0,1:56:24.32,1:56:33.58,jp-m,NTP,0000,0000,0000,,Аспанда алыстағы жүз, есімде сені
Dialogue: 0,1:56:34.55,1:56:44.29,jp-m,NTP,0000,0000,0000,,Теңізге апаратын жолды кезіп жүрсеңіз
Dialogue: 0,1:56:44.70,1:56:53.66,jp-m,NTP,0000,0000,0000,,Жарқыраған жаз нұры, а, қазір де
Dialogue: 0,1:56:54.97,1:57:04.72,jp-m,NTP,0000,0000,0000,,Шексіз көк аспан, Ұмытпайтын адамға
Dialogue: 0,1:57:05.17,1:57:14.53,jp-m,NTP,0000,0000,0000,,Өз ойыңды аққан бұлттарға жеткіз
Dialogue: 0,1:57:14.98,1:57:22.80,jp-m,NTP,0000,0000,0000,,Жүрегімізді жалғайтын ән сал
Dialogue: 0,1:57:30.56,1:57:40.43,jp-m,NTP,0000,0000,0000,,Жыл мезгілі өткенде, Жел сипайды бетімді
Dialogue: 0,1:57:40.91,1:57:49.87,jp-m,NTP,0000,0000,0000,,Менің сүйіктім, мені ақырын бақылаңыз.
Dialogue: 0,1:57:51.11,1:58:00.87,jp-m,NTP,0000,0000,0000,,Толқынның дүбірі құшақтасып, тұманмен тербелген қала
Dialogue: 0,1:58:01.31,1:58:10.41,jp-m,NTP,0000,0000,0000,,Мен іздеген арманның үзіндісі, аа, қайда?
Dialogue: 0,1:58:11.50,1:58:21.60,jp-m,NTP,0000,0000,0000,,Урувасимахороба Тілегіңді орында
Dialogue: 0,1:58:21.76,1:58:31.02,jp-m,NTP,0000,0000,0000,,Барлығының бақыты, алақандары бірге
Dialogue: 0,1:58:31.66,1:58:39.17,jp-m,NTP,0000,0000,0000,,Мәңгілік махаббатты өрген өмір
Dialogue: 0,1:59:02.62,1:59:12.35,jp-m,NTP,0000,0000,0000,,Шексіз көк аспан, Ұмытпайтын адамға
Dialogue: 0,1:59:12.84,1:59:22.09,jp-m,NTP,0000,0000,0000,,Біз қайта кездесетін күнге дейін өз ойларыңызды жеткізіңіз
Dialogue: 0,1:59:22.67,1:59:26.88,jp-m,NTP,0000,0000,0000,,Күлімдеп жүріңіз
Dialogue: 0,1:59:28.10,1:59:37.83,jp-m,NTP,0000,0000,0000,,Урувасимахороба Сағыныш туған қаласы
Dialogue: 0,1:59:38.33,1:59:43.95,jp-m,NTP,0000,0000,0000,,Ертеңгі күнді армандау
Dialogue: 0,1:59:45.85,1:59:55.10,jp-m,NTP,0000,0000,0000,,Көз жасына ерген кемпірқосақты кесіп өту
Dialogue: 0,1:59:55.48,2:00:04.39,jp-m,NTP,0000,0000,0000,,Ендеше бірге серуендейміз
Dialogue: 0,0:01:33.84,0:01:36.17,cn,NTP,0000,0000,0000,,...
Dialogue: 0,0:01:37.84,0:01:39.30,cn,NTP,0000,0000,0000,,...
Dialogue: 0,0:01:39.71,0:01:41.63,cn,NTP,0000,0000,0000,,Кіші аралдар көп
Dialogue: 0,0:01:42.03,0:01:42.43,cn,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:01:44.04,0:01:45.40,cn,NTP,0000,0000,0000,,Сәттілік
Dialogue: 0,0:01:45.72,0:01:48.28,cn,NTP,0000,0000,0000,,...
Dialogue: 0,0:01:49.56,0:01:50.12,cn,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:02:04.11,0:02:06.97,cn,NTP,0000,0000,0000,,Шиошима есімі белгісіз.
Dialogue: 0,0:02:07.49,0:02:08.90,cn,NTP,0000,0000,0000,,...
Dialogue: 0,0:02:11.64,0:02:15.82,cn,NTP,0000,0000,0000,,Елдің негізгі нүктесіндегі аралдың беті.
Dialogue: 0,0:02:16.82,0:02:17.38,cn,NTP,0000,0000,0000,,Кодтық аты: Принцесса Торн
Dialogue: 0,0:04:46.63,0:04:51.95,cn,NTP,0000,0000,0000,,…
Dialogue: 0,0:04:54.66,0:04:55.18,cn,NTP,0000,0000,0000,,...
Dialogue: 0,0:04:55.78,0:04:57.23,cn,NTP,0000,0000,0000,,Насаи Кокоу
Dialogue: 0,0:04:58.23,0:04:59.31,cn,NTP,0000,0000,0000,,Уцуко
Dialogue: 0,0:04:59.64,0:05:00.59,cn,NTP,0000,0000,0000,,Омусуме
Dialogue: 0,0:05:01.33,0:05:03.19,cn,NTP,0000,0000,0000,,Йошику Фуми-Рё
Dialogue: 0,0:05:03.74,0:05:06.63,cn,NTP,0000,0000,0000,,Шынайы қолайсыз ниет
Dialogue: 0,0:05:07.39,0:05:09.17,cn,NTP,0000,0000,0000,,Тайкорё ләззат түсінің шатасуы
Dialogue: 0,0:05:09.36,0:05:11.93,cn,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:12.80,0:05:14.46,cn,NTP,0000,0000,0000,,Негізгі мәселе аяқталды.
Dialogue: 0,0:05:14.79,0:05:16.39,cn,NTP,0000,0000,0000,,менмендік пен өркөкіректік
Dialogue: 0,0:05:16.81,0:05:18.13,cn,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:18.29,0:05:20.77,cn,NTP,0000,0000,0000,,Бұл мен ғана.
Dialogue: 0,0:05:20.85,0:05:24.02,cn,NTP,0000,0000,0000,,Тасымалдаушы компанияны алып тастау
Dialogue: 0,0:05:24.09,0:05:25.00,cn,NTP,0000,0000,0000,,Накан Коретаның қолайсыз ниеті бар.
Dialogue: 0,0:05:25.18,0:05:26.54,cn,NTP,0000,0000,0000,,Шынымен қажетсіз пайдалану
Dialogue: 0,0:05:35.91,0:05:37.39,cn,NTP,0000,0000,0000,,Бұдан былай көптеген қосымшалар болады.
Dialogue: 0,0:05:38.20,0:05:39.26,cn,NTP,0000,0000,0000,,Мен ұрғашы шабдалымын
Dialogue: 0,0:05:39.67,0:05:40.42,cn,NTP,0000,0000,0000,,Момоко Комо
Dialogue: 0,0:05:40.88,0:05:44.45,cn,NTP,0000,0000,0000,,...
Dialogue: 0,0:05:46.07,0:05:46.46,cn,NTP,0000,0000,0000,,Комомо
Dialogue: 0,0:05:49.05,0:05:49.64,cn,NTP,0000,0000,0000,,Ләззат
Dialogue: 0,0:05:50.38,0:05:51.82,cn,NTP,0000,0000,0000,,Сізге ұнайды
Dialogue: 0,0:05:52.67,0:05:54.27,cn,NTP,0000,0000,0000,,Жақында
Dialogue: 0,0:05:54.62,0:05:55.98,cn,NTP,0000,0000,0000,,Бұл сіздің үйіңіз.
Dialogue: 0,0:05:56.26,0:05:57.54,cn,NTP,0000,0000,0000,,Жақсы Си Си
Dialogue: 0,0:06:14.20,0:06:15.24,cn,NTP,0000,0000,0000,,Қоқыс
Dialogue: 0,0:06:15.41,0:06:15.98,cn,NTP,0000,0000,0000,,Хибебе
Dialogue: 0,0:06:16.76,0:06:18.31,cn,NTP,0000,0000,0000,,Нанабе - үлкен қария және оның отбасы.
Dialogue: 0,0:06:27.56,0:06:29.16,cn,NTP,0000,0000,0000,,Госай Канмиден кейін астанаға қауіп төніп, шабуыл аяқталды.
Dialogue: 0,0:06:29.56,0:06:31.46,cn,NTP,0000,0000,0000,,Үлкен көпірдің құрылысы
Dialogue: 0,0:06:31.74,0:06:34.02,cn,NTP,0000,0000,0000,,Бұл қыркүйек айындағы ауа райы қозғалысы.
Dialogue: 0,0:06:34.27,0:06:35.40,cn,NTP,0000,0000,0000,,Жиналысты өзгерту жолы
Dialogue: 0,0:06:36.18,0:06:38.40,cn,NTP,0000,0000,0000,,Қате жоқ, жақсы, жақсы, білім жоқ
Dialogue: 0,0:06:38.87,0:06:44.02,cn,NTP,0000,0000,0000,,Зақымдалмаған аралда өмір сүрген кездегі өтпелі кезең
Dialogue: 0,0:06:44.34,0:06:46.13,cn,NTP,0000,0000,0000,,...
Dialogue: 0,0:06:48.13,0:06:50.39,cn,NTP,0000,0000,0000,,Ағзаңыздың қазіргі проблемасын түсініңіз.
Dialogue: 0,0:06:50.80,0:06:52.62,cn,NTP,0000,0000,0000,,Оны қалай орындауға болады деген сұрақ
Dialogue: 0,0:06:53.40,0:06:54.44,cn,NTP,0000,0000,0000,,...
Dialogue: 0,0:06:55.33,0:06:56.01,cn,NTP,0000,0000,0000,,Момоко Комо
Dialogue: 0,0:06:56.84,0:07:01.61,cn,NTP,0000,0000,0000,,Уақыттың қысқа болуына байланысты мен бір жылдан бері мазасыздандым.
Dialogue: 0,0:07:01.98,0:07:02.85,cn,NTP,0000,0000,0000,,Тыңдағаннан кейін
Dialogue: 0,0:07:06.28,0:07:08.41,cn,NTP,0000,0000,0000,,Ат үстінде жұмысты бастау
Dialogue: 0,0:07:08.64,0:07:11.13,cn,NTP,0000,0000,0000,,Накатаның соңғы қоғамдық салоны
Dialogue: 0,0:07:12.30,0:07:13.00,cn,NTP,0000,0000,0000,,...
Dialogue: 0,0:07:13.85,0:07:15.79,cn,NTP,0000,0000,0000,,Салықтарды алу және кірістерді алу туралы айту
Dialogue: 0,0:07:16.59,0:07:17.71,cn,NTP,0000,0000,0000,,Дегенмен, қайтаруға тұрарлық.
Dialogue: 0,0:07:18.56,0:07:19.54,cn,NTP,0000,0000,0000,,Тексеру
