Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:27.61,0:00:31.23,Default,,0,0,0,,Қайырлы таң, мен – санасыз баламын.
Dialogue: 0,0:00:35.91,0:00:37.45,Default,,0,0,0,,Эй
Dialogue: 0,0:00:37.66,0:00:39.91,Default,,0,0,0,,Қайда бара жатырсың?
Dialogue: 0,0:00:41.41,0:00:43.12,Default,,0,0,0,,Накадзима Хонмачидегі «Футабаға»
Dialogue: 0,0:00:43.25,0:00:45.04,Default,,0,0,0,,Желімді жеткізіңіз
Dialogue: 0,0:00:45.29,0:00:48.67,Default,,0,0,0,,Бастапқыда бұл үлкен ағамның рөлі еді, бірақ суық тиюге байланысты...
Dialogue: 0,0:00:48.88,0:00:53.30,Default,,0,0,0,,Мен...
Dialogue: 0,0:00:53.42,0:00:56.68,Default,,0,0,0,,Маған тәнті болды, бірақ тоқта, тоқта.
Dialogue: 0,0:00:56.80,0:00:59.85,Default,,0,0,0,,Қиыршық қайықтың қайтып оралуы шашыранды.
Dialogue: 0,0:00:59.97,0:01:04.98,Default,,0,0,0,,Балдырларды жеткізіп болған соң үйге барып, ағам мен әпкеме кәдесыйлар сатып аламын.
Dialogue: 0,0:01:06.23,0:01:07.60,Default,,0,0,0,,Мына мұз жігітке қарашы—
Dialogue: 0,0:01:19.20,0:01:21.16,Default,,0,0,0,,Эй, хехе...
Dialogue: 0,0:01:21.28,0:01:23.29,Default,,0,0,0,,Біз жақындап қалдық
Dialogue: 0,0:01:24.12,0:01:27.62,Default,,0,0,0,,Әй, менің ойым жоқ.
Dialogue: 0,0:01:37.72,0:01:38.80,Default,,0,0,0,,Мен қанаттарымды алдын ала жіберіп қойдым.
Dialogue: 0,0:01:48.06,0:01:53.07,Default,,0,0,0,,(Реми Аясаки) Ай! Не!? Сонымен не болды!?
Dialogue: 0,0:01:54.65,0:01:57.90,Default,,0,0,0,,Шоколад 10 сен Карамель қорабы 10 сен
Dialogue: 0,0:01:58.15,0:02:00.41,Default,,0,0,0,,Кіші қорап 5 сен, йо-йо 10 сен
Dialogue: 0,0:02:00.53,0:02:02.16,Default,,0,0,0,,Дұрыс, жақсы, жақсы.
Dialogue: 0,0:02:04.79,0:02:06.54,Default,,0,0,0,,Маған қызыл түсті ұнайды.
Dialogue: 0,0:02:06.91,0:02:10.17,Default,,0,0,0,,Әлі де адам көп (Қала тұрғыны) Рас.
Dialogue: 0,0:02:10.38,0:02:12.50,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:02:12.88,0:02:14.50,Default,,0,0,0,,Қадамыңызды бақылаңыз
Dialogue: 0,0:02:16.76,0:02:21.76,Default,,0,0,0,,♪~
Dialogue: 0,0:03:45.14,0:03:50.14,Default,,0,0,0,,~♪
Dialogue: 0,0:03:50.27,0:03:52.94,Default,,0,0,0,,Егер сол жерде адасып қалсаңыз
Dialogue: 0,0:03:53.44,0:03:55.77,Default,,0,0,0,,Мен бұл қарияны кездестірдім
Dialogue: 0,0:03:57.90,0:04:01.40,Default,,0,0,0,,Сузу-чан, бұл не? ол
Dialogue: 0,0:04:01.61,0:04:03.36,Default,,0,0,0,,«Бэйкемон» иә?
Dialogue: 0,0:04:03.53,0:04:04.86,Default,,0,0,0,,деді
Dialogue: 0,0:04:05.11,0:04:09.24,Default,,0,0,0,,Ол маған мынаны пайдаланып жол табуды және телескоп арқылы қарауға рұқсат етті.
Dialogue: 0,0:04:11.16,0:04:14.12,Default,,0,0,0,,Уау! Бұл солай көрінеді
Dialogue: 0,0:04:15.17,0:04:16.13,Default,,0,0,0,,Уау!
Dialogue: 0,0:04:16.46,0:04:19.88,Default,,0,0,0,,Құлаған себетке бейтаныс адам шықты.
Dialogue: 0,0:04:20.26,0:04:23.88,Default,,0,0,0,,Ол ұрлаушы, біз ұрланған халықпыз.
Dialogue: 0,0:04:24.01,0:04:25.01,Default,,0,0,0,,Иә!?
Dialogue: 0,0:04:25.68,0:04:27.43,Default,,0,0,0,,Сіз әлсізсіз.
Dialogue: 0,0:04:27.72,0:04:31.77,Default,,0,0,0,,Мен кешке тауықтарды тамақтандыру үшін үйге баруым керек.
Dialogue: 0,0:04:31.89,0:04:35.23,Default,,0,0,0,,Мен де әкеммен бірге үйге пойызбен баруым керек.
Dialogue: 0,0:04:35.35,0:04:37.27,Default,,0,0,0,,Мен де Мен
Dialogue: 0,0:04:37.40,0:04:41.36,Default,,0,0,0,,Кеш батқанша үйге бармасаң, қиналып қаласың.
Dialogue: 0,0:04:41.48,0:04:43.44,Default,,0,0,0,,Бұл үлкен мәселе бола ма деп ойлаймын.
Dialogue: 0,0:04:43.57,0:04:45.32,Default,,0,0,0,,Ал, Миторинсай
Dialogue: 0,0:04:51.33,0:04:53.12,Default,,0,0,0,,Қария қария Айтат Айтат
Dialogue: 0,0:04:53.75,0:04:56.17,Default,,0,0,0,,Бұл не? Қараңыз
Dialogue: 0,0:04:56.54,0:04:59.29,Default,,0,0,0,,Иә? қайсысы
Dialogue: 0,0:05:00.21,0:05:01.59,Default,,0,0,0,,(Құлау дыбысы)
Dialogue: 0,0:05:01.71,0:05:04.13,Default,,0,0,0,,
Dialogue: 0,0:05:04.30,0:05:07.64,Default,,0,0,0,,Түнде ұйықтайсың деген сөз.
Dialogue: 0,0:05:08.76,0:05:11.01,Default,,0,0,0,,Мен бұл жігітті аяймын, өйткені оның кешкі асы жайбарақат.
Dialogue: 0,0:05:13.06,0:05:15.27,Default,,0,0,0,,Ангатона Сузу Урано
Dialogue: 0,0:05:15.39,0:05:17.98,Default,,0,0,0,,Иә, мен білмей тұрып, менің атым болды
Dialogue: 0,0:05:18.10,0:05:20.11,Default,,0,0,0,,(бұрышта күлкі)
Dialogue: 0,0:05:20.27,0:05:22.69,Default,,0,0,0,,«Ангатона Сузу Урано» Ахахха!
Dialogue: 0,0:05:22.82,0:05:24.86,Default,,0,0,0,,Міне! шулы
Dialogue: 0,0:05:25.15,0:05:25.99,Default,,0,0,0,,Хехе...
Dialogue: 0,0:05:26.11,0:05:28.20,Default,,0,0,0,,Біздің ойымыз жоқ
Dialogue: 0,0:05:28.49,0:05:33.70,Default,,0,0,0,,Джейк, бұл күн менің күндізгі арманым болғанына сенімдімін.
Dialogue: 0,0:05:39.46,0:05:42.05,Default,,0,0,0,,Юмбе теңізі Мынадай болды
Dialogue: 0,0:05:43.25,0:05:45.63,Default,,0,0,0,,Бүгін таңертең көктемгі толқын келгенде, ол былай болды
Dialogue: 0,0:05:45.76,0:05:47.05,Default,,0,0,0,,Құлайтындай… Бұл қылыш…
Dialogue: 0,0:05:47.68,0:05:51.80,Default,,0,0,0,,Балалық шағында мұхитты жалғыз кешіп өту бірінші рет қызық.
Dialogue: 0,0:05:52.01,0:05:53.89,Default,,0,0,0,,Иә, «Кусацудағы ағай мен апай»
Dialogue: 0,0:05:54.02,0:05:56.56,Default,,0,0,0,,«Әже, қайырлы таң» деймін.
Dialogue: 0,0:05:56.85,0:05:59.90,Default,,0,0,0,,«Әкелер қалаға кешігіп келді».
Dialogue: 0,0:06:00.02,0:06:01.48,Default,,0,0,0,,«Қарбыз өтінемін»
Dialogue: 0,0:06:01.65,0:06:04.44,Default,,0,0,0,,Аа, Сумиде қарбыз бар.
Dialogue: 0,0:06:04.90,0:06:06.78,Default,,0,0,0,,（･）
Dialogue: 0,0:06:07.24,0:06:09.36,Default,,0,0,0,,Қараңдаршы, менің ойнауға уақытым жоқ.
Dialogue: 0,0:06:09.53,0:06:12.53,Default,,0,0,0,,Менің ағам өте қатал адам еді.
Dialogue: 0,0:06:12.66,0:06:14.49,Default,,0,0,0,,Күте тұрыңыз...
Dialogue: 0,0:06:15.54,0:06:17.25,Default,,0,0,0,,Қайырлы таң
Dialogue: 0,0:06:17.58,0:06:21.42,Default,,0,0,0,,Менің әкем мен анам... у...
Dialogue: 0,0:06:21.71,0:06:23.34,Default,,0,0,0,,Sui... Cap
Dialogue: 0,0:06:23.80,0:06:25.30,Default,,0,0,0,,Қарбыз, өтінемін (Морита) Хаа...
Dialogue: 0,0:06:25.42,0:06:27.76,Default,,0,0,0,,Рахмет. Құрбандық жасайық.
Dialogue: 0,0:06:28.13,0:06:31.18,Default,,0,0,0,,Хохо Беппин-санджа
Dialogue: 0,0:06:28.13,0:06:31.18,Default,,0,0,0,,(бұрышта ызылдау)
Dialogue: 0,0:06:31.18,0:06:31.47,Default,,0,0,0,,(бұрышта ызылдау)
Dialogue: 0,0:06:31.47,0:06:32.93,Default,,0,0,0,,(бұрышта ызылдау)
Dialogue: 0,0:06:31.47,0:06:32.93,Default,,0,0,0,,Әже жыл сайын -
Dialogue: 0,0:06:32.93,0:06:33.05,Default,,0,0,0,,(бұрышта ызылдау)
Dialogue: 0,0:06:33.05,0:06:34.14,Default,,0,0,0,,(бұрышта ызылдау)
Dialogue: 0,0:06:33.05,0:06:34.14,Default,,0,0,0,,Ол маған жаңа кимоно жасап, мені күтті.
Dialogue: 0,0:06:34.14,0:06:34.26,Default,,0,0,0,,Ол маған жаңа кимоно жасап, мені күтті.
Dialogue: 0,0:06:34.26,0:06:35.18,Default,,0,0,0,,Ол маған жаңа кимоно жасап, мені күтті.
Dialogue: 0,0:06:34.26,0:06:35.18,Default,,0,0,0,,Ах!
Dialogue: 0,0:06:35.18,0:06:35.31,Default,,0,0,0,,Ол маған жаңа кимоно жасап, мені күтті.
Dialogue: 0,0:06:35.31,0:06:36.68,Default,,0,0,0,,Ол маған жаңа кимоно жасап, мені күтті.
Dialogue: 0,0:06:35.31,0:06:36.68,Default,,0,0,0,,Сәлем, мен үйдемін (Джуро)
Dialogue: 0,0:06:36.97,0:06:41.27,Default,,0,0,0,,Әкем мен анам дүкен аралауға шыққанда, біз бейіт басына бардық.
Dialogue: 0,0:06:43.40,0:06:45.11,Default,,0,0,0,,Сіз қалай ойлайсыз? Энами
Dialogue: 0,0:06:45.23,0:06:49.32,Default,,0,0,0,,Бұл қиын. Біз порт салып жатқандықтан...
Dialogue: 0,0:06:49.45,0:06:50.78,Default,,0,0,0,,Солай ма?
Dialogue: 0,0:06:51.53,0:06:54.49,Default,,0,0,0,,Ммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммммм
Dialogue: 0,0:06:54.95,0:06:56.33,Default,,0,0,0,,Хмм.
Dialogue: 0,0:06:57.12,0:06:58.75,Default,,0,0,0,,Әртүрлі заттар бар...
Dialogue: 0,0:07:01.25,0:07:04.13,Default,,0,0,0,,Бала болғанның айыбы жоқ.
Dialogue: 0,0:07:04.42,0:07:06.96,Default,,0,0,0,,Мен көп нәрсені көре алатындай сезінемін.
Dialogue: 0,0:07:11.51,0:07:12.76,Default,,0,0,0,,Ха…
Dialogue: 0,0:07:14.39,0:07:15.39,Default,,0,0,0,,Ах...
Dialogue: 0,0:07:25.65,0:07:28.32,Default,,0,0,0,,Сәлем... Сәлем...
Dialogue: 0,0:07:31.49,0:07:32.32,Default,,0,0,0,,Ах
Dialogue: 0,0:07:33.70,0:07:35.03,Default,,0,0,0,,Ум...
Dialogue: 0,0:07:36.20,0:07:39.00,Default,,0,0,0,,Тағы да аламыз ба?
Dialogue: 0,0:07:42.87,0:07:44.46,Default,,0,0,0,,Ана
Dialogue: 0,0:07:46.79,0:07:50.13,Default,,0,0,0,,Қараңдаршы, толқын азайып барады.
Dialogue: 0,0:07:50.67,0:07:52.26,Default,,0,0,0,,Эй, дайындалайық (Йоичи) Ух... ммм.
Dialogue: 0,0:07:53.34,0:07:55.09,Default,,0,0,0,,Мұнда Сумимо
Dialogue: 0,0:07:56.39,0:07:57.22,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:07:59.14,0:08:02.85,Default,,0,0,0,,Мені жалғыз қалдырсаң, тамақты кейінірек кел.
Dialogue: 0,0:08:03.35,0:08:05.35,Default,,0,0,0,,Иә, мен қалаймын
Dialogue: 0,0:08:06.02,0:08:08.65,Default,,0,0,0,,Кимоноңды тастап кетсем, неге келмейсің?
Dialogue: 0,0:08:09.90,0:08:13.15,Default,,0,0,0,,Сузу-чан сондай мейірімді.
Dialogue: 0,0:08:13.86,0:08:16.57,Default,,0,0,0,,«Мұны маған мектептегі мұғалімім айтты».
Dialogue: 0,0:08:16.70,0:08:18.66,Default,,0,0,0,,«Бұл Зашики Вараси болуы керек».
Dialogue: 0,0:08:19.08,0:08:21.54,Default,,0,0,0,,Сол күні кешке ағам...
Dialogue: 0,0:08:21.66,0:08:25.17,Default,,0,0,0,,Табиғат пен адамдар жұмсақ әрі бұлыңғыр болып көрінді.
Dialogue: 0,0:08:26.13,0:08:29.42,Default,,0,0,0,,Иә!? Кимоноңызды Кусацуда қалдырдыңыз ба?
Dialogue: 0,0:08:29.55,0:08:32.30,Default,,0,0,0,,Қазір барып ал, жүз, ақымақ!
Dialogue: 0,0:08:32.42,0:08:33.26,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:08:34.51,0:08:37.76,Default,,0,0,0,,«Они-чанның» қорқынышты екенін де ұмытып кетіппін.
Dialogue: 0,0:08:39.55,0:08:41.27,Default,,0,0,0,,Уау
Dialogue: 0,0:08:43.52,0:08:47.52,Default,,0,0,0,,Сузу Төмен ілулі, жел соғып тұр.
Dialogue: 0,0:08:47.65,0:08:48.61,Default,,0,0,0,,Иә
Dialogue: 0,0:08:49.40,0:08:51.86,Default,,0,0,0,,Әй, анашым, маған 2 сен беріңізші.
Dialogue: 0,0:08:51.98,0:08:53.53,Default,,0,0,0,,Мен қарындашты тастадым.
Dialogue: 0,0:08:53.65,0:08:55.70,Default,,0,0,0,,Қалтаңыздың ақшасын алғанша ұстамаңыз.
Dialogue: 0,0:08:56.57,0:08:59.24,Default,,0,0,0,,Дудл жасамасаңыз, жақсы болады.
Dialogue: 0,0:09:01.99,0:09:04.29,Default,,0,0,0,,Суми-чан, қарындашты ауыстырайын ба?
Dialogue: 0,0:09:04.41,0:09:05.25,Default,,0,0,0,,(Ер адам) Аа… тоқта… Уа! (Әйелдің айқайы)
Dialogue: 0,0:09:05.37,0:09:09.21,Default,,0,0,0,,Мизухарадан келген Сузу Тецу-кун, сен күнде мектепке келесің бе?
Dialogue: 0,0:09:09.34,0:09:10.92,Default,,0,0,0,,Ал, мен келемін.
Dialogue: 0,0:09:11.09,0:09:11.75,Default,,0,0,0,,Аха…
Dialogue: 0,0:09:11.75,0:09:12.80,Default,,0,0,0,,Аха…
Dialogue: 0,0:09:11.75,0:09:12.80,Default,,0,0,0,,Шынымен суық.
Dialogue: 0,0:09:12.80,0:09:13.67,Default,,0,0,0,,Шынымен суық.
Dialogue: 0,0:09:15.97,0:09:18.09,Default,,0,0,0,,Эй, суық~ О, суық~
Dialogue: 0,0:09:22.14,0:09:23.22,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:37.07,0:09:38.16,Default,,0,0,0,,Иә
Dialogue: 0,0:09:39.66,0:09:40.74,Default,,0,0,0,,Қысқаша a
Dialogue: 0,0:09:41.58,0:09:43.87,Default,,0,0,0,,Осы апта осымен бітті
Dialogue: 0,0:09:44.16,0:09:46.21,Default,,0,0,0,,Бұл жолы оны тастамауға тырысыңыз.
Dialogue: 0,0:09:46.33,0:09:49.79,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:09:49.92,0:09:52.21,Default,,0,0,0,,Бүгінгі сурет – еркін сурет.
Dialogue: 0,0:09:52.34,0:09:54.55,Default,,0,0,0,,Оны жіберген адамнан қайтаруыңызды сұраймыз.
Dialogue: 0,0:09:54.67,0:09:55.76,Default,,0,0,0,,Yes
Dialogue: 0,0:09:55.92,0:09:58.76,Default,,0,0,0,,Қай жерде сурет салу керек? Эй
Dialogue: 0,0:09:59.64,0:10:01.26,Default,,0,0,0,,Иә, иә.
Dialogue: 0,0:10:01.64,0:10:03.10,Default,,0,0,0,,Урано Янудан күткендей
Dialogue: 0,0:10:03.60,0:10:05.77,Default,,0,0,0,,Ал, Сузу-чан, бұл жақсы.
Dialogue: 0,0:10:08.48,0:10:10.31,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:10:12.44,0:10:14.73,Default,,0,0,0,,Жүр, мен кокубаны алып кетейін.
Dialogue: 0,0:10:14.86,0:10:16.28,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:10:24.99,0:10:25.83,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:29.17,0:10:30.17,Default,,0,0,0,,Ha
Dialogue: 0,0:10:32.75,0:10:33.88,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:34.92,0:10:40.64,Default,,0,0,0,,Мизухара-сан, мен Дез-санмен мәңгілік үйге бара алмаймын.
Dialogue: 0,0:10:40.84,0:10:42.01,Default,,0,0,0,,Артқа қайтпайды
Dialogue: 0,0:10:42.72,0:10:46.43,Default,,0,0,0,,Әкесі мен анасы теңіз балдырларын маринадтап, оны ішті.
Dialogue: 0,0:10:46.77,0:10:47.98,Default,,0,0,0,,Мен теңізді жек көремін
Dialogue: 0,0:10:48.81,0:10:50.06,Default,,0,0,0,,Мен оны сала алмаймын...
Dialogue: 0,0:10:50.31,0:10:52.44,Default,,0,0,0,,Урано, сен маған көмектесе аласың ба?
Dialogue: 0,0:10:56.36,0:10:57.53,Default,,0,0,0,,Не? (Философия) мұны істе
Dialogue: 0,0:10:59.95,0:11:01.32,Default,,0,0,0,,Е, гейдемо
Dialogue: 0,0:11:01.45,0:11:04.33,Default,,0,0,0,,Менің ағамның үйі.
Dialogue: 0,0:11:04.91,0:11:06.70,Default,,0,0,0,,Қоян жоғары-төмен секіреді.
Dialogue: 0,0:11:07.08,0:11:10.62,Default,,0,0,0,,Жаңа жылда аударылған апатта теңіз осылай болды.
Dialogue: 0,0:11:11.25,0:11:13.25,Default,,0,0,0,,Мен оны салғым келсе, сіз оны салыңыз.
Dialogue: 0,0:11:13.42,0:11:15.29,Default,,0,0,0,,Тіпті мына қызықсыз теңізде де
Dialogue: 0,0:11:18.01,0:11:21.34,Default,,0,0,0,,Мизухара мырза, бұл нені білдіреді?
Dialogue: 0,0:11:21.47,0:11:23.51,Default,,0,0,0,,Ууух!
Dialogue: 0,0:11:24.18,0:11:26.93,Default,,0,0,0,,Ақ толқындар секірген қоян тәрізді.
Dialogue: 0,0:11:27.72,0:11:30.31,Default,,0,0,0,,Мизухара-сан, саған ағаңды беруім керек пе?
Dialogue: 0,0:11:30.43,0:11:31.27,Default,,0,0,0,,шайқастан барынша аулақ болуға тырысқанымызға қарамастан, әскеріміздің шамамен жиырма пайызын жоғалттық.
Dialogue: 0,0:11:32.23,0:11:33.48,Default,,0,0,0,,Мен Ураноның ағасын көргенде...
Dialogue: 0,0:11:33.60,0:11:36.90,Default,,0,0,0,,Ерлердің бар жылдамдықпен қашатын заңы бар.
Dialogue: 0,0:11:39.11,0:11:40.28,Default,,0,0,0,,Хойд-
Dialogue: 0,0:11:41.07,0:11:45.99,Default,,0,0,0,,Әскери-теңіз училищесіне түсіп, теңізде батып кеткен ақымақтан жақсысың.
Dialogue: 0,0:11:47.08,0:11:50.96,Default,,0,0,0,,Бұл дұрыс емес, ақ қоян сияқты.
Dialogue: 0,0:11:53.21,0:11:54.38,Default,,0,0,0,,Дайын
Dialogue: 0,0:11:54.50,0:11:57.21,Default,,0,0,0,,Оларды жинаңыз. Рақмет сізге.
Dialogue: 0,0:11:58.55,0:12:00.97,Default,,0,0,0,,Ах... (Тэцу) Жарайды, мен керек нәрсені істеймін.
Dialogue: 0,0:12:01.59,0:12:04.30,Default,,0,0,0,,Егер қолымнан келсе, үйге барудың қажеті болмас еді.
Dialogue: 0,0:12:04.93,0:12:08.93,Default,,0,0,0,,Әдемі суреттерге қарасаң теңізді жек көре алмайсың.
Dialogue: 0,0:12:15.44,0:12:19.53,Default,,0,0,0,,Тынық мұхитының шығысында әрекет ететін Император Әскери-теңіз күштері...
Dialogue: 0,0:12:19.65,0:12:23.95,Default,,0,0,0,,Аман болсын, аман болсын...
Dialogue: 0,0:12:25.53,0:12:29.08,Default,,0,0,0,,Моританың немере қарындасы Бұл жерде қызған дұрыс.
Dialogue: 0,0:12:29.20,0:12:30.45,Default,,0,0,0,,Ай
Dialogue: 0,0:12:31.79,0:12:35.21,Default,,0,0,0,,О, бұл әдемі жауынгерлік киім.
Dialogue: 0,0:12:35.33,0:12:36.96,Default,,0,0,0,,Хмм, хехе...
Dialogue: 0,0:12:37.46,0:12:40.30,Default,,0,0,0,,Уау, мен оны жек көремін!
Dialogue: 0,0:12:41.17,0:12:42.38,Default,,0,0,0,,Haah
Dialogue: 0,0:12:50.18,0:12:53.81,Default,,0,0,0,,Иә, жақсарып келеді.
Dialogue: 0,0:12:53.93,0:12:55.81,Default,,0,0,0,,Әй, түскі асты сол жерде ішейік.
Dialogue: 0,0:12:55.94,0:12:57.94,Default,,0,0,0,,Уау!
Dialogue: 0,0:12:58.90,0:12:59.94,Default,,0,0,0,,Алыс!
Dialogue: 0,0:13:00.57,0:13:01.40,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:01.53,0:13:04.36,Default,,0,0,0,,Сузунэ-чан үйлену үшін алысқа кетуі керек.
Dialogue: 0,0:13:04.70,0:13:05.78,Default,,0,0,0,,Хонан?
Dialogue: 0,0:13:06.11,0:13:07.74,Default,,0,0,0,,Сумини-чан жақын.
Dialogue: 0,0:13:07.87,0:13:13.20,Default,,0,0,0,,Таяқшаны алыс ұстаған бала тұрмысқа шығу үшін алысқа кетуі керек.
Dialogue: 0,0:13:13.58,0:13:15.08,Default,,0,0,0,,А...
Dialogue: 0,0:13:15.21,0:13:17.21,Default,,0,0,0,,Әже қайдан келді?
Dialogue: 0,0:13:17.33,0:13:21.00,Default,,0,0,0,,Иә? Менің атым Фуру.
Dialogue: 0,0:13:21.13,0:13:23.67,Default,,0,0,0,,Көрші Фуруден Кусацуға дейін...
Dialogue: 0,0:13:24.22,0:13:27.80,Default,,0,0,0,,Егер сіз Маньчжурияда немесе басқа жерде болған болсаңыз, тіпті таяқшалар да жеткіліксіз.
Dialogue: 0,0:13:27.93,0:13:31.97,Default,,0,0,0,,Осыны айтып жатқанда таяқшаларын қайта алған Суми Урано болды.
Dialogue: 0,0:13:32.10,0:13:34.98,Default,,0,0,0,,Тым жақын болса, арман жоқ.
Dialogue: 0,0:13:35.35,0:13:36.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:37.02,0:13:37.85,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:38.44,0:13:40.90,Default,,0,0,0,,Ха! Сузу-чан жақында үйге келеді
Dialogue: 0,0:13:41.02,0:13:43.69,Default,,0,0,0,,Телефонға қоңырау шалған кезде бірдеңе ойлап жатсаңыз...
Dialogue: 0,0:13:43.82,0:13:47.11,Default,,0,0,0,,Біреу әйеліңе кел деді.
Dialogue: 0,0:13:47.24,0:13:48.61,Default,,0,0,0,,Күреден бастап
Dialogue: 0,0:13:48.74,0:13:49.66,Default,,0,0,0,,Ву?
Dialogue: 0,0:13:49.78,0:13:53.12,Default,,0,0,0,,Сузу-чан, сен нешедесің?
Dialogue: 0,0:13:53.24,0:13:57.54,Default,,0,0,0,,19… 18-ге толы
Dialogue: 0,0:13:57.79,0:14:01.67,Default,,0,0,0,,Ұнамаса, жоқ деп айта алмайсың. Келіңіз, менімен танысыңыз.
Dialogue: 0,0:14:01.79,0:14:04.51,Default,,0,0,0,,Сузу-чан, бір сәт осында кел.
Dialogue: 0,0:14:05.84,0:14:09.68,Default,,0,0,0,,Мен оны бір күні сен үйленгенде ойланамын.
Dialogue: 0,0:14:09.80,0:14:11.60,Default,,0,0,0,,Мен оны жөндедім.
Dialogue: 0,0:14:11.89,0:14:14.97,Default,,0,0,0,,Шешім болса, жарайды.
Dialogue: 0,0:14:17.10,0:14:18.52,Default,,0,0,0,,Рахмет
Dialogue: 0,0:14:19.40,0:14:23.82,Default,,0,0,0,,Бізді ана жақтағы үйде құттықтаймыз.
Dialogue: 0,0:14:24.19,0:14:25.03,Default,,0,0,0,,Иә
Dialogue: 0,0:14:25.15,0:14:27.11,Default,,0,0,0,,Сол түні күйеу балам...
Dialogue: 0,0:14:27.24,0:14:30.41,Default,,0,0,0,,«Сіз қолшатыр әкелдіңіз бе?»
Dialogue: 0,0:14:30.53,0:14:31.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:31.49,0:14:36.29,Default,,0,0,0,,Алғың келсе: «Мен саған жаңасын әкелдім» дейсің.
Dialogue: 0,0:14:36.54,0:14:40.04,Default,,0,0,0,,«Оны қоюға болады ма?» деп сұрағанда.
Dialogue: 0,0:14:40.17,0:14:42.50,Default,,0,0,0,,«Өтінемін» деңіз Жарайды?
Dialogue: 0,0:14:42.92,0:14:45.50,Default,,0,0,0,,Иә? Неліктен? Бәрі болады
Dialogue: 0,0:14:45.63,0:14:48.26,Default,,0,0,0,,Шамасы, біз өсетін боламыз.
Dialogue: 0,0:14:48.88,0:14:52.55,Default,,0,0,0,,Куреутара әскери порты орналасқан жерде.
Dialogue: 0,0:14:52.85,0:14:55.31,Default,,0,0,0,,Теңізші кетіп бара жатты
Dialogue: 0,0:14:56.27,0:14:57.10,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:57.98,0:15:00.73,Default,,0,0,0,,Иә? Иә?
Dialogue: 0,0:15:00.94,0:15:02.10,Default,,0,0,0,,Мизухара мырза?
Dialogue: 0,0:15:04.02,0:15:05.57,Default,,0,0,0,,Көптен бері көрмеген
Dialogue: 0,0:15:05.69,0:15:07.78,Default,,0,0,0,,Тезірек үйге қайт, ә?
Dialogue: 0,0:15:08.03,0:15:11.28,Default,,0,0,0,,Анаң қатты шу шығарды...
Dialogue: 0,0:15:11.41,0:15:13.12,Default,,0,0,0,,Маңайдағылардың бәрі біледі
Dialogue: 0,0:15:14.33,0:15:16.70,Default,,0,0,0,,Ах! Мен асығыс болдым
Dialogue: 0,0:15:16.83,0:15:18.75,Default,,0,0,0,,Сіздің менің қарсыласым екеніңізге сенімдімін...
Dialogue: 0,0:15:18.87,0:15:20.16,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,0:15:20.83,0:15:24.75,Default,,0,0,0,,Ағамның қайтыс болғанына жеті жыл толғанда салтанатты түрде елге оралдым.
Dialogue: 0,0:15:24.92,0:15:26.55,Default,,0,0,0,,…менің бөлмесіне келуім керек деді—
Dialogue: 0,0:15:26.96,0:15:30.09,Default,,0,0,0,,Сіз басқа адамды танисыз ба?
Dialogue: 0,0:15:30.30,0:15:31.47,Default,,0,0,0,,Мүлдем емес
Dialogue: 0,0:15:31.80,0:15:34.60,Default,,0,0,0,,Мен Суми Чан деп қателескен шығармын.
Dialogue: 0,0:15:35.35,0:15:37.64,Default,,0,0,0,,Суми-чан әдемірек
Dialogue: 0,0:15:38.60,0:15:41.02,Default,,0,0,0,,Мен олай ойламаймын.
Dialogue: 0,0:15:41.48,0:15:44.23,Default,,0,0,0,,Бұл мектепке бара бастаған кезім еді.
Dialogue: 0,0:15:44.36,0:15:46.90,Default,,0,0,0,,Мен оны алғаш рет бір жерден көрдім деп ойлаймын.
Dialogue: 0,0:15:47.02,0:15:51.03,Default,,0,0,0,,Ал, үйіңді іздеу үлкен жұмыс болды.
Dialogue: 0,0:15:51.24,0:15:54.66,Default,,0,0,0,,Біз де осыдан үш жыл бұрын Еба жағалауындағы мелиорацияға қатысқанбыз.
Dialogue: 0,0:15:54.78,0:15:57.03,Default,,0,0,0,,Мен желім қолдануды тоқтаттым.
Dialogue: 0,0:15:58.16,0:16:00.29,Default,,0,0,0,,Менің ойымша, ол жақында оралады.
Dialogue: 0,0:16:00.41,0:16:01.37,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:16:01.54,0:16:03.37,Default,,0,0,0,,Иә, бұл рас па, жоқ па білмедім, бірақ...
Dialogue: 0,0:16:03.37,0:16:04.54,Default,,0,0,0,,Иә, бұл рас па, жоқ па білмедім, бірақ...
Dialogue: 0,0:16:03.37,0:16:04.54,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:16:04.67,0:16:08.46,Default,,0,0,0,,Аузыма карамель дәмі тарағанын сездім...
Dialogue: 0,0:16:08.59,0:16:10.17,Default,,0,0,0,,Қызық, неге?
Dialogue: 0,0:16:10.30,0:16:11.51,Default,,0,0,0,,О, Сабу...
Dialogue: 0,0:16:12.42,0:16:14.22,Default,,0,0,0,,Мен қиындыққа тап болдым.
Dialogue: 0,0:16:14.97,0:16:17.85,Default,,0,0,0,,Ұнамаса, жоқ деп айт.
Dialogue: 0,0:16:18.10,0:16:20.77,Default,,0,0,0,,Оны жек көретінін де, жек көрмейтінін де білмеді.
Dialogue: 0,0:16:20.89,0:16:22.10,Default,,0,0,0,,Ум...
Dialogue: 0,0:16:23.06,0:16:23.89,Default,,0,0,0,,Иә
Dialogue: 0,0:16:25.90,0:16:28.11,Default,,0,0,0,,Адасып қалмасқа амалым жоқ.
Dialogue: 0,0:16:28.23,0:16:29.90,Default,,0,0,0,,Қай трамвай аялдамасы?
Dialogue: 0,0:16:30.53,0:16:32.61,Default,,0,0,0,,Осылай (Шусаку) Кешіріңіз.
Dialogue: 0,0:16:32.74,0:16:36.37,Default,,0,0,0,,Мен мейірімді теңізшіге айта алмадым.
Dialogue: 0,0:16:36.57,0:16:40.62,Default,,0,0,0,,А... дұрыс, ол біртүрлі адам екен.
Dialogue: 0,0:16:40.74,0:16:43.62,Default,,0,0,0,,Мен тауда болдым, бейтаныс әйелдің жетегінде...
Dialogue: 0,0:16:43.75,0:16:45.54,Default,,0,0,0,,Сіз үйге аман-есен жеткен сияқтысыз.
Dialogue: 0,0:16:45.67,0:16:46.50,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:49.88,0:16:53.51,Default,,0,0,0,,Менің ойымша, біз мүлдем бей-жай қалдық.
Dialogue: 0,0:16:54.59,0:16:57.89,Default,,0,0,0,,Қызық, бұл қашан болды?
Dialogue: 0,0:17:07.81,0:17:08.81,Default,,0,0,0,,Doganakane? Иә
Dialogue: 0,0:17:08.94,0:17:14.03,Default,,0,0,0,,Бұдан былай теңіз жағасындағы жапқыштарды жабыңыз.
Dialogue: 0,0:17:19.99,0:17:22.66,Default,,0,0,0,,(Жолаушылар жөтелді)
Dialogue: 0,0:17:23.41,0:17:25.08,Default,,0,0,0,,Бір жерде терезені ашыңыз
Dialogue: 0,0:17:29.46,0:17:33.01,Default,,0,0,0,,Ву~ Ву~
Dialogue: 0,0:17:33.17,0:17:34.59,Default,,0,0,0,,Уф!
Dialogue: 0,0:17:34.72,0:17:37.05,Default,,0,0,0,,Әскери-теңіз күштерінің мылтық батареясын оқыту.
Dialogue: 0,0:17:37.18,0:17:38.89,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:17:51.77,0:17:53.90,Default,,0,0,0,,Кешіріңіз, кешіріңіз.
Dialogue: 0,0:17:54.49,0:17:56.86,Default,,0,0,0,,Хаа ха...
Dialogue: 0,0:17:56.99,0:17:59.91,Default,,0,0,0,,Көмір автобусы келмес еді.
Dialogue: 0,0:18:00.07,0:18:02.58,Default,,0,0,0,,Аа, Кобаяши мырза (Джуро) О, сәлем.
Dialogue: 0,0:18:03.08,0:18:06.29,Default,,0,0,0,,Кобаяши мырза, бүгінгі көмегіңіз үшін рахмет.
Dialogue: 0,0:18:06.41,0:18:08.92,Default,,0,0,0,,Ауа-райы да жақсы.
Dialogue: 0,0:18:10.08,0:18:12.46,Default,,0,0,0,,Көмегің үшін рахмет, Суенага
Dialogue: 0,0:18:12.63,0:18:14.80,Default,,0,0,0,,Кішкентай болсам да, саған перзент боламын.
Dialogue: 0,0:18:14.92,0:18:17.63,Default,,0,0,0,,Бұл Шусакудың Кобаяши апасы. иә?
Dialogue: 0,0:18:17.80,0:18:19.97,Default,,0,0,0,,Мен матч ретінде қызмет етемін, ә...
Dialogue: 0,0:18:20.09,0:18:22.68,Default,,0,0,0,,Тұрмысқа шығатын адамыңның тегі есіңде жоқ па?
Dialogue: 0,0:18:22.81,0:18:25.18,Default,,0,0,0,,Шынымен екеуі ғана болғаны дұрыс па?
Dialogue: 0,0:18:32.40,0:18:36.65,Default,,0,0,0,,Әй, бұл шынымен де пайда болды.
Dialogue: 0,0:18:36.86,0:18:39.24,Default,,0,0,0,,Бұл ең жақсы бұрыш.
Dialogue: 0,0:18:39.36,0:18:40.70,Default,,0,0,0,,Міне.
Dialogue: 0,0:18:41.28,0:18:43.20,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:18:43.49,0:18:46.66,Default,,0,0,0,,Кешіріңіз, бұл күндері бәрі өте ыңғайлы.
Dialogue: 0,0:18:46.87,0:18:48.16,Default,,0,0,0,,Менің баламда мазасыздық синдромы бар.
Dialogue: 0,0:18:48.29,0:18:49.79,Default,,0,0,0,,Бұл дұрыс, Сузу-чан.
Dialogue: 0,0:18:49.92,0:18:51.08,Default,,0,0,0,,Жарайды.
Dialogue: 0,0:18:51.21,0:18:53.71,Default,,0,0,0,,Бұл жерде сіздің ең жақсы киіміңіз босқа кетеді.
Dialogue: 0,0:18:54.67,0:18:56.67,Default,,0,0,0,,Ах! Бұл Сузу!
Dialogue: 0,0:18:57.09,0:18:59.13,Default,,0,0,0,,Киімді қай жерде шешуім керек? (Джуро/Сузу) Ах...
Dialogue: 0,0:18:59.26,0:19:04.85,Default,,0,0,0,,(Сутра оқу)
Dialogue: 0,0:19:05.93,0:19:07.81,Default,,0,0,0,,Бұл тағы бір үлкен мереке.
Dialogue: 0,0:19:07.93,0:19:10.81,Default,,0,0,0,,Шынымен, мына баланың ағасы келе алмайтыны ұят.
Dialogue: 0,0:19:10.94,0:19:13.69,Default,,0,0,0,,Осының бәрін жинағаныңыз рас.
Dialogue: 0,0:19:13.81,0:19:15.48,Default,,0,0,0,,Дұрыс тамақтаныңыз
Dialogue: 0,0:19:15.61,0:19:18.94,Default,,0,0,0,,Барлығымыз осы үйде кешке төлейік.
Dialogue: 0,0:19:19.07,0:19:21.53,Default,,0,0,0,,Бұл қайнатылған тағам да қайнатылған.
Dialogue: 0,0:19:22.91,0:19:26.12,Default,,0,0,0,,Сіз тыныш адам екенсіз.
Dialogue: 0,0:19:26.24,0:19:28.33,Default,,0,0,0,,Бұндай жерде ешкім шу шығармайды деп ойлаймын.
Dialogue: 0,0:19:28.45,0:19:31.04,Default,,0,0,0,,Жап-жұмсақсың Саппақсың
Dialogue: 0,0:19:31.71,0:19:34.33,Default,,0,0,0,,Сәлем, үйге қайтқанда.
Dialogue: 0,0:19:34.46,0:19:36.75,Default,,0,0,0,,Сәлем
Dialogue: 0,0:19:38.42,0:19:39.80,Default,,0,0,0,,Мен қайта ораламын.
Dialogue: 0,0:19:44.39,0:19:48.22,Default,,0,0,0,,Ал, бұл кім болды?
Dialogue: 0,0:19:48.35,0:19:49.98,Default,,0,0,0,,Менің әйелім де келді...
Dialogue: 0,0:19:50.10,0:19:53.60,Default,,0,0,0,,Үйдегінің бәрін маған қалдырып, тыныш ұйықта.
Dialogue: 0,0:19:53.73,0:19:54.77,Default,,0,0,0,,Иә
Dialogue: 0,0:19:56.19,0:20:00.49,Default,,0,0,0,,Қайын ата, ене, Көмек көрсеткендеріңізге көп рахмет.
Dialogue: 0,0:20:00.61,0:20:02.99,Default,,0,0,0,,Сәлем, Ину.
Dialogue: 0,0:20:03.11,0:20:05.95,Default,,0,0,0,,Мен аяғымды ауырттым.
Dialogue: 0,0:20:06.12,0:20:08.49,Default,,0,0,0,,Танысқаныма қуаныштымын, Сузу-сан
Dialogue: 0,0:20:08.87,0:20:09.70,Default,,0,0,0,,Иә
Dialogue: 0,0:20:10.79,0:20:12.16,Default,,0,0,0,,Апыр-ай, жақсы болды. Сонымен, іс шешілді ғой?
Dialogue: 0,0:20:12.29,0:20:14.92,Default,,0,0,0,,Пеште пісірсеңіз, ол үнемі жанып тұрады.
Dialogue: 0,0:20:15.04,0:20:19.05,Default,,0,0,0,,А, иә. Сізге күйеуге шыққан қайынсіңліңіз болды ма?
Dialogue: 0,0:20:32.68,0:20:36.02,Default,,0,0,0,,Оның жасы үлкен екенін білетінмін, бірақ бұл…
Dialogue: 0,0:20:37.98,0:20:40.28,Default,,0,0,0,,Әскери кеменің сәулеленуіне арналған жаттығулар Уау!
Dialogue: 0,0:20:41.86,0:20:44.86,Default,,0,0,0,,Қызық, бәріміз қайдан келдік?
Dialogue: 0,0:20:45.82,0:20:47.20,Default,,0,0,0,,Хаа…
Dialogue: 0,0:20:47.82,0:20:51.58,Default,,0,0,0,,(Шусакудың гуілдеуі)
Dialogue: 0,0:20:51.70,0:20:55.17,Default,,0,0,0,,Футон үшін рахмет
Dialogue: 0,0:20:55.29,0:20:56.21,Default,,0,0,0,,Иә
Dialogue: 0,0:20:57.46,0:20:59.88,Default,,0,0,0,,(сыбырлау)
Dialogue: 0,0:21:00.80,0:21:02.17,Default,,0,0,0,,О, Сузу-сан
Dialogue: 0,0:21:02.30,0:21:03.51,Default,,0,0,0,,Иә
Dialogue: 0,0:21:04.17,0:21:06.72,Default,,0,0,0,,Қолшатыр әкелгіңіз келе ме?
Dialogue: 0,0:21:10.72,0:21:12.72,Default,,0,0,0,,Иә... жаңа.
Dialogue: 0,0:21:13.68,0:21:14.89,Default,,0,0,0,,1 бөтелке…
Dialogue: 0,0:21:15.85,0:21:17.65,Default,,0,0,0,,Маған аздап қарыз беріңізші.
Dialogue: 0,0:21:21.86,0:21:23.24,Default,,0,0,0,,Жарайды...
Dialogue: 0,0:21:24.61,0:21:25.70,Default,,0,0,0,,Қараңыз
Dialogue: 0,0:21:26.03,0:21:29.16,Default,,0,0,0,,Менің қарным ашты.
Dialogue: 0,0:21:33.12,0:21:35.50,Default,,0,0,0,,Неліктен әлі күнге дейін құлықсыз?
Dialogue: 0,0:21:36.83,0:21:39.71,Default,,0,0,0,,Сіз күндіз ештеңе жеген жоқсыз.
Dialogue: 0,0:21:40.25,0:21:42.71,Default,,0,0,0,,Аузыңыздан тамақ ішпеңіз. Мен жеңілдеп қалдым.
Dialogue: 0,0:21:42.84,0:21:43.76,Default,,0,0,0,,Аһ!
Dialogue: 0,0:21:44.42,0:21:48.09,Default,,0,0,0,,А... Уайымдама, уайымдама, мен жаңа ғана тұқымын іштім.
Dialogue: 0,0:21:48.84,0:21:50.30,Default,,0,0,0,,Дұрыс ауызша
Dialogue: 0,0:21:52.18,0:21:56.02,Default,,0,0,0,,Мм... біз бірінші бір жерде кездестік пе?
Dialogue: 0,0:21:56.14,0:21:58.77,Default,,0,0,0,,Иә, мен сені кездестіремін.
Dialogue: 0,0:21:58.90,0:22:00.40,Default,,0,0,0,,Есіңде жоқ па?
Dialogue: 0,0:22:00.52,0:22:01.52,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:22:01.65,0:22:04.53,Default,,0,0,0,,Үйде біз әдеттен тыс жұмыс істейміз.
Dialogue: 0,0:22:04.65,0:22:06.82,Default,,0,0,0,,Ежелден дүмпу болып келеді.
Dialogue: 0,0:22:08.74,0:22:11.78,Default,,0,0,0,,Бұл жерде баяғыда мең болған.
Dialogue: 0,0:22:44.82,0:22:48.90,Default,,0,0,0,,Құдықтың астында коммуналдық шатыр бар, келіңіздер...
Dialogue: 0,0:23:14.72,0:23:20.19,Default,,0,0,0,,Ходжо…
Dialogue: 0,0:23:26.15,0:23:26.98,Default,,0,0,0,,Ах...
Dialogue: 0,0:23:27.11,0:23:28.24,Default,,0,0,0,,Ум...
Dialogue: 0,0:23:28.94,0:23:34.74,Default,,0,0,0,,Бұл Күре қаласындағы қандай қала және нөмір?
Dialogue: 0,0:23:34.87,0:23:35.87,Default,,0,0,0,,Иә? иә?
Dialogue: 0,0:23:36.03,0:23:36.87,Default,,0,0,0,,Иә
Dialogue: 0,0:23:37.04,0:23:38.29,Default,,0,0,0,,Хойджану
Dialogue: 0,0:23:38.66,0:23:40.16,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,0:23:41.46,0:23:45.75,Default,,0,0,0,,Мен бұл жердегілердің бәрі Әскери-теңіз флотында жұмыс істей ме деп ойлаймын.
Dialogue: 0,0:23:51.63,0:23:52.63,Default,,0,0,0,,Хаа…
Dialogue: 0,0:23:55.72,0:23:57.56,Default,,0,0,0,,Ходжо мырза
Dialogue: 0,0:24:00.68,0:24:01.81,Default,,0,0,0,,Ходжо мырза
Dialogue: 0,0:24:01.94,0:24:03.02,Default,,0,0,0,,Иә
Dialogue: 0,0:24:03.31,0:24:04.56,Default,,0,0,0,,Тарату баж салығы?
Dialogue: 0,0:24:04.69,0:24:09.28,Default,,0,0,0,,Бұл жерде және мұнда әрқашан солай болады.
Dialogue: 0,0:24:09.82,0:24:11.36,Default,,0,0,0,,Көмегің үшін рахмет
Dialogue: 0,0:24:11.49,0:24:13.66,Default,,0,0,0,,Бұл Чита (Кария) Бұл Қария.
Dialogue: 0,0:24:18.58,0:24:19.74,Default,,0,0,0,,Қайтадан қараңыз
Dialogue: 0,0:24:19.87,0:24:21.66,Default,,0,0,0,,Сіз оны дұрыс өлшемейсіз бе?
Dialogue: 0,0:24:22.16,0:24:24.04,Default,,0,0,0,,Егер сіз көз өлшемдері туралы айтып жатсаңыз, сіздікі не?
Dialogue: 0,0:24:24.17,0:24:25.96,Default,,0,0,0,,Жоқ, (Чита) Бұл әділетсіздік болар еді.
Dialogue: 0,0:24:26.08,0:24:27.17,Default,,0,0,0,,Алайда операция бастапқы сәттен бастап сәтсіздікке ұшыраудың аз-ақ алдында болды.
Dialogue: 0,0:24:27.34,0:24:29.59,Default,,0,0,0,,Дәл (Қария) Не?
Dialogue: 0,0:24:29.71,0:24:32.30,Default,,0,0,0,,Маған сенің мұндай мінезің ұнамайды.
Dialogue: 0,0:24:32.42,0:24:33.68,Default,,0,0,0,,Қайда
Dialogue: 0,0:24:34.09,0:24:35.76,Default,,0,0,0,,Ахаха... Жас, жас (Қария)
Dialogue: 0,0:24:35.89,0:24:37.39,Default,,0,0,0,,Сіз құлап қалдыңыз.
Dialogue: 0,0:24:38.51,0:24:39.51,Default,,0,0,0,,Уау
Dialogue: 0,0:24:39.76,0:24:40.72,Default,,0,0,0,,Иә
Dialogue: 0,0:24:41.73,0:24:42.73,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,0:24:42.85,0:24:45.69,Default,,0,0,0,,Айтата... Су... Кешіріңіз.
Dialogue: 0,0:24:46.23,0:24:47.48,Default,,0,0,0,,Өте үлкен болу.
Dialogue: 0,0:24:47.61,0:24:49.44,Default,,0,0,0,,Айта алмаймын
Dialogue: 0,0:24:49.61,0:24:51.94,Default,,0,0,0,,Егер тұтандырғыш бомба құласа -
Dialogue: 0,0:24:52.07,0:24:56.32,Default,,0,0,0,,Ең алдымен әдепті әрекет керек...
Dialogue: 0,0:24:56.45,0:24:58.70,Default,,0,0,0,,Жақын кел!
Dialogue: 0,0:24:59.12,0:25:01.20,Default,,0,0,0,,Мына орындық суық, солай емес пе?
Dialogue: 0,0:25:01.33,0:25:03.29,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:25:04.71,0:25:07.71,Default,,0,0,0,,Бұл менің күнделікті әдетіме айналды.
Dialogue: 0,0:25:18.80,0:25:22.43,Default,,0,0,0,,Әй, бұл Кейко қызының киімдері.
Dialogue: 0,0:25:22.56,0:25:24.43,Default,,0,0,0,,Бұл да қойма бөлмесі.
Dialogue: 0,0:25:24.68,0:25:28.23,Default,,0,0,0,,Мен оны киіп, күйеу баламмен бірге кетіп қалдым.
Dialogue: 0,0:25:28.23,0:25:29.19,Default,,0,0,0,,Мен оны киіп, күйеу баламмен бірге кетіп қалдым.
Dialogue: 0,0:25:28.23,0:25:29.19,Default,,0,0,0,,Сен… кімсің?
Dialogue: 0,0:25:29.48,0:25:34.36,Default,,0,0,0,,Кино көріңіз, батыс мейрамханасына барыңыз, экспоға барыңыз.
Dialogue: 0,0:25:35.07,0:25:39.62,Default,,0,0,0,,Уау, Мога еді, жеңгем.
Dialogue: 0,0:25:40.20,0:25:43.20,Default,,0,0,0,,Бұл әлі де әлем еді, солай емес пе?
Dialogue: 0,0:25:43.91,0:25:45.87,Default,,0,0,0,,Шусаку төртінші курста оқып жүргенде-
Dialogue: 0,0:25:46.00,0:25:50.09,Default,,0,0,0,,Бейбітшілік үшін қарусыздану соғыс кемелерін жасау мүмкін болмады.
Dialogue: 0,0:25:51.00,0:25:54.92,Default,,0,0,0,,Менің адамдарым да осы жерде жұмыссыз қалып жатыр.
Dialogue: 0,0:25:55.05,0:25:57.09,Default,,0,0,0,,Бұл үлкен мәселе болды.
Dialogue: 0,0:25:57.34,0:25:59.43,Default,,0,0,0,,Кейко дәл осындай қыз.
Dialogue: 0,0:25:59.55,0:26:03.72,Default,,0,0,0,,Өзіңіздің жұмысыңызды шешіп, өз күшіңізбен күйеу табыңыз.
Dialogue: 0,0:26:03.85,0:26:08.06,Default,,0,0,0,,Жарайды, егер қаласаң, жеңіліп қалмас үшін көп жұмыс істеу керек.
Dialogue: 0,0:26:10.11,0:26:13.53,Default,,0,0,0,,Ол кезде мен бұл үлкен мәселе деп ойлайтынмын.
Dialogue: 0,0:26:13.82,0:26:14.65,Default,,0,0,0,,Аман болсын!
Dialogue: 0,0:26:14.78,0:26:18.11,Default,,0,0,0,,Сағындым күндерді үлкен іс болып көрінген.
Dialogue: 0,0:26:22.78,0:26:24.37,Default,,0,0,0,,Бұл менің төзімділігім жақсарғандықтан, және
Dialogue: 0,0:26:27.00,0:26:28.92,Default,,0,0,0,,А, сәлем
Dialogue: 0,0:26:29.71,0:26:30.79,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:26:30.92,0:26:33.92,Default,,0,0,0,,Әй, қош келдің, жеңге.
Dialogue: 0,0:26:34.05,0:26:35.05,Default,,0,0,0,,Ах!
Dialogue: 0,0:26:36.21,0:26:37.63,Default,,0,0,0,,Хаа... Саен
Dialogue: 0,0:26:37.76,0:26:38.76,Default,,0,0,0,,Иә?
Dialogue: 0,0:26:40.22,0:26:44.01,Default,,0,0,0,,Күріш бүгінде бағалы тауар емес пе?
Dialogue: 0,0:26:44.14,0:26:45.43,Default,,0,0,0,,Бұл сіз туралы.
Dialogue: 0,0:26:46.22,0:26:49.77,Default,,0,0,0,,Хиросималық бала сондай жарқын болар деп ойладым.
Dialogue: 0,0:26:50.06,0:26:52.44,Default,,0,0,0,,Цугихагиге толы монпеде не бар?
Dialogue: 0,0:26:53.32,0:26:55.19,Default,,0,0,0,,Бұршақ қуырылған ба?
Dialogue: 0,0:26:55.32,0:26:57.74,Default,,0,0,0,,Иә, Харуми-чан, қош келдіңіз.
Dialogue: 0,0:26:57.86,0:27:01.11,Default,,0,0,0,,Анашым, көңіл-күйіңіз нашар ма?
Dialogue: 0,0:27:01.36,0:27:02.74,Default,,0,0,0,,Харуми ересек Шушиторун
Dialogue: 0,0:27:02.87,0:27:03.99,Default,,0,0,0,,Кешіріңіз, жаным
Dialogue: 0,0:27:04.12,0:27:06.16,Default,,0,0,0,,Қазір бізде осы ғана
Dialogue: 0,0:27:06.29,0:27:07.91,Default,,0,0,0,,Жаса! дәл қазір
Dialogue: 0,0:27:12.00,0:27:14.21,Default,,0,0,0,,Сондай-ақ, ол күріш кәдесыйдан ерекшеленеді.
Dialogue: 0,0:27:14.34,0:27:16.46,Default,,0,0,0,,Бұл маған және қызыма арналған!
Dialogue: 0,0:27:18.21,0:27:21.47,Default,,0,0,0,,Хойде? Диази: мені тыңда анашым.
Dialogue: 0,0:27:21.59,0:27:24.47,Default,,0,0,0,,Сен әлсіреп қалдың.
Dialogue: 0,0:27:26.14,0:27:26.97,Default,,0,0,0,,Бұл 5 миллион йенге арналған ақшалай ваучер
Dialogue: 0,0:27:27.35,0:27:29.98,Default,,0,0,0,,Тағы да басқаша.
Dialogue: 0,0:27:30.10,0:27:33.48,Default,,0,0,0,,Сен сондай жаман болсаң, маған үйленбе.
Dialogue: 0,0:27:33.61,0:27:35.44,Default,,0,0,0,,Иә, мен бармаймын.
Dialogue: 0,0:27:37.32,0:27:39.15,Default,,0,0,0,,Хмм...
Dialogue: 0,0:27:39.78,0:27:40.99,Default,,0,0,0,,«Мен ашулымын», «қаным қайнап тұр»
Dialogue: 0,0:27:42.95,0:27:46.12,Default,,0,0,0,,Ал, менің белім туралы...
Dialogue: 0,0:27:47.20,0:27:48.70,Default,,0,0,0,,А, мен түсіндім.
Dialogue: 0,0:27:53.17,0:27:54.96,Default,,0,0,0,,Ол ит болса да, тым оғаш кішкентай жаратылыс.
Dialogue: 0,0:28:00.01,0:28:01.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:28:04.09,0:28:08.14,Default,,0,0,0,,Оны шешіп, қайта бағалаңыз
Dialogue: 0,0:28:08.64,0:28:11.14,Default,,0,0,0,,Бірге тігу
Dialogue: 0,0:28:11.98,0:28:15.65,Default,,0,0,0,,Резеңкені оның ішінен өткізіңіз, сонда сіз біттіңіз!
Dialogue: 0,0:28:19.32,0:28:20.78,Default,,0,0,0,,Бұл Харуми Куромура.
Dialogue: 0,0:28:20.90,0:28:23.53,Default,,0,0,0,,Сәлем, бұл Сузу Ходжо.
Dialogue: 0,0:28:24.32,0:28:26.20,Default,,0,0,0,,Сузу-сан, маған жіпті бер
Dialogue: 0,0:28:26.32,0:28:28.83,Default,,0,0,0,,А, бұл жақсы ма?
Dialogue: 0,0:28:43.47,0:28:44.34,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:28:44.47,0:28:45.55,Default,,0,0,0,,Ой
Dialogue: 0,0:28:46.18,0:28:48.14,Default,,0,0,0,,Сузу-сан, сен тапсырмаларды орындайсың ба?
Dialogue: 0,0:28:48.26,0:28:49.97,Default,,0,0,0,,Тарату орталығына иә
Dialogue: 0,0:28:50.43,0:28:54.35,Default,,0,0,0,,Кеттік, мен саған рацион билеті мен әмиянды қарызға беремін.
Dialogue: 0,0:28:54.48,0:28:56.73,Default,,0,0,0,,Иә, өтінемін.
Dialogue: 0,0:29:09.24,0:29:10.79,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:29:11.24,0:29:12.08,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:29:17.79,0:29:19.88,Default,,0,0,0,,Иә, мен мұны істеймін.
Dialogue: 0,0:29:20.63,0:29:21.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:29:29.01,0:29:31.47,Default,,0,0,0,,Сәлем анашым
Dialogue: 0,0:29:32.02,0:29:35.10,Default,,0,0,0,,Келіңіздер... иә иә
Dialogue: 0,0:29:35.23,0:29:37.60,Default,,0,0,0,,Не? (Кейко) Бұл сорпа жемісі.
Dialogue: 0,0:29:43.23,0:29:44.11,Default,,0,0,0,,(Судзу күрсінуі)
Dialogue: 0,0:29:53.50,0:29:54.91,Default,,0,0,0,,
Dialogue: 0,0:29:56.12,0:30:00.42,Default,,0,0,0,,Ой, Кейко мен Харуми келе ме? Әлде екі?
Dialogue: 0,0:30:00.54,0:30:01.96,Default,,0,0,0,,Қош келдіңіз әке
Dialogue: 0,0:30:02.09,0:30:03.84,Default,,0,0,0,,Ал, сабыр етіңіз.
Dialogue: 0,0:30:03.96,0:30:04.80,Default,,0,0,0,,Иә
Dialogue: 0,0:30:05.92,0:30:07.68,Default,,0,0,0,,Ерекше
Dialogue: 0,0:30:07.80,0:30:10.43,Default,,0,0,0,,Әпкемнің дайындаған тамағы көп күйген жоқ.
Dialogue: 0,0:30:10.80,0:30:12.76,Default,,0,0,0,,Бұл Шусаку (Шусаку) Итатата
Dialogue: 0,0:30:12.89,0:30:15.18,Default,,0,0,0,,Анау қайын сіңлі
Dialogue: 0,0:30:15.31,0:30:18.52,Default,,0,0,0,,Сіздің арқаңызда мен кимононы осылай жөндеп алдым.
Dialogue: 0,0:30:18.69,0:30:19.52,Default,,0,0,0,,Ах~
Dialogue: 0,0:30:19.65,0:30:21.44,Default,,0,0,0,,Иә? Жоқ
Dialogue: 0,0:30:21.77,0:30:24.40,Default,,0,0,0,,Анаңның аяғы ауыр.
Dialogue: 0,0:30:24.53,0:30:28.61,Default,,0,0,0,,Мен білмеген жерге сендей баланы алып келдім.
Dialogue: 0,0:30:28.91,0:30:32.41,Default,,0,0,0,,Мен осында қалғаным жақсы болар еді.
Dialogue: 0,0:30:33.37,0:30:37.08,Default,,0,0,0,,Сузу-сан, Хиросимаға қайтуға қалай болады?
Dialogue: 0,0:30:38.41,0:30:39.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:30:39.79,0:30:41.29,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:30:41.42,0:30:42.54,Default,,0,0,0,,Иә...
Dialogue: 0,0:30:44.92,0:30:46.30,Default,,0,0,0,,(Есіктің ашылу дыбысы)
Dialogue: 0,0:30:46.42,0:30:47.88,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:30:48.13,0:30:49.80,Default,,0,0,0,,шаршадым
Dialogue: 0,0:30:49.93,0:30:51.01,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,0:30:51.93,0:30:53.76,Default,,0,0,0,,Аа, сағат 8 болып қалды.
Dialogue: 0,0:30:53.89,0:30:56.10,Default,,0,0,0,,Бүгінгі таңда одан да көп.
Dialogue: 0,0:30:56.31,0:30:58.77,Default,,0,0,0,,О? Мұның бәрі мың ине ме?
Dialogue: 0,0:30:58.89,0:31:01.56,Default,,0,0,0,,Эй, Суми, кейінге сақтап қой.
Dialogue: 0,0:31:01.69,0:31:02.56,Default,,0,0,0,,Иә
Dialogue: 0,0:31:03.19,0:31:05.07,Default,,0,0,0,,Міне! Сузу оян
Dialogue: 0,0:31:05.82,0:31:07.19,Default,,0,0,0,,Дүрс! (Айзава) Гах!
Dialogue: 0,0:31:09.36,0:31:11.28,Default,,0,0,0,,Жүр, қазір кешкі ас ішейік.
Dialogue: 0,0:31:12.07,0:31:16.49,Default,,0,0,0,,А, мен шошып кеттім. Күреге үйленемін деп армандадым.
Dialogue: 0,0:31:16.62,0:31:17.70,Default,,0,0,0,,Аха…
Dialogue: 0,0:31:17.83,0:31:18.66,Default,,0,0,0,,Ах...
Dialogue: 0,0:31:18.79,0:31:20.62,Default,,0,0,0,,Сіз ояусыз ба? Иә.
Dialogue: 0,0:31:20.96,0:31:24.92,Default,,0,0,0,,Жүр, менің жеңгем Хиросимаға қайтуды айтты.
Dialogue: 0,0:31:25.04,0:31:26.05,Default,,0,0,0,,Иә
Dialogue: 0,0:31:26.17,0:31:27.71,Default,,0,0,0,,Сіз не айтып жатырсыз деп қызық болдым...
Dialogue: 0,0:31:28.63,0:31:30.22,Default,,0,0,0,,Ах! Үйге оралу (Кайко) А?
Dialogue: 0,0:31:30.84,0:31:33.09,Default,,0,0,0,,Қаласаң қайын атаң да, енең де...
Dialogue: 0,0:31:33.43,0:31:36.22,Default,,0,0,0,,«Осы уақытқа дейін мұқият болғаным үшін менің кінәм болды».
Dialogue: 0,0:31:36.85,0:31:40.18,Default,,0,0,0,,«Бірнеше күн тынышталыңыз.»
Dialogue: 0,0:31:40.31,0:31:41.73,Default,,0,0,0,,Жездем де
Dialogue: 0,0:31:42.77,0:31:45.69,Default,,0,0,0,,Иә десең, жарайды.
Dialogue: 0,0:31:45.98,0:31:46.90,Default,,0,0,0,,Жарайды, екеу болсын.
Dialogue: 0,0:31:47.15,0:31:49.57,Default,,0,0,0,,Айтпақшы, сіз Йоичиге ашық хат жібердіңіз бе?
Dialogue: 0,0:31:49.69,0:31:51.24,Default,,0,0,0,,Үй? шығару
Dialogue: 0,0:31:51.57,0:31:54.32,Default,,0,0,0,,Әлі жауап жоқ
Dialogue: 0,0:31:54.91,0:31:56.70,Default,,0,0,0,,Үйде ме? Иә
Dialogue: 0,0:31:58.75,0:31:59.95,Default,,0,0,0,,Ал, бұл алыс.
Dialogue: 0,0:32:00.08,0:32:02.33,Default,,0,0,0,,Үлкен аға жалқау
Dialogue: 0,0:32:02.71,0:32:05.46,Default,,0,0,0,,Сузу адресат болып табылады. Мен қателескен шығармын.
Dialogue: 0,0:32:05.59,0:32:06.46,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:32:06.71,0:32:08.71,Default,,0,0,0,,Ваннаға арналған ванна
Dialogue: 0,0:32:08.92,0:32:10.92,Default,,0,0,0,,Суми-чан, еріктілер корпусы қандай?
Dialogue: 0,0:32:11.05,0:32:12.51,Default,,0,0,0,,Мен бұған әбден үйреніп қалдым
Dialogue: 0,0:32:12.63,0:32:15.26,Default,,0,0,0,,Машина майының иісі бар.
Dialogue: 0,0:32:15.39,0:32:18.26,Default,,0,0,0,,Бұл қауіпті жұмыс па? Бұл қиын
Dialogue: 0,0:32:18.47,0:32:22.73,Default,,0,0,0,,Желімдеу жұмысы сияқты суық емес, сондықтан кейде жақсы болады.
Dialogue: 0,0:32:23.23,0:32:27.77,Default,,0,0,0,,Әдемі әскери офицер маған жасырын түрде асханаға билет берді.
Dialogue: 0,0:32:27.90,0:32:28.86,Default,,0,0,0,,Иә
Dialogue: 0,0:32:29.23,0:32:32.15,Default,,0,0,0,,Мен күтпеген жерден әскер құпиясын білдім.
Dialogue: 0,0:32:32.28,0:32:35.87,Default,,0,0,0,,Сузу-чан ше? Ву қайда?
Dialogue: 0,0:32:35.99,0:32:39.99,Default,,0,0,0,,Хмм, әлі есімде көп нәрсе бар.
Dialogue: 0,0:32:40.12,0:32:41.50,Default,,0,0,0,,Ах! сурет?
Dialogue: 0,0:32:41.70,0:32:43.75,Default,,0,0,0,,Енді...
Dialogue: 0,0:32:43.87,0:32:48.34,Default,,0,0,0,,Мен абайсызда теңіз құпиясына тап болған сияқтымын.
Dialogue: 0,0:32:48.46,0:32:50.13,Default,,0,0,0,,Не... не? Қазір ұйықта
Dialogue: 0,0:32:52.55,0:32:54.63,Default,,0,0,0,,Сузу-чан?
Dialogue: 0,0:32:55.30,0:32:57.68,Default,,0,0,0,,Сізде тақырлар пайда болады.
Dialogue: 0,0:32:57.80,0:32:58.64,Default,,0,0,0,,Иә!?
Dialogue: 0,0:33:00.26,0:33:03.64,Default,,0,0,0,,Көріскенше, Сузу-чан, мен барамын.
Dialogue: 0,0:33:04.19,0:33:06.06,Default,,0,0,0,,Шешуші ұрыстағы төтенше шаралар!
Dialogue: 0,0:33:06.19,0:33:10.02,Default,,0,0,0,,Ай өзгерсе, тіпті қысқа сапарларға да шектеу қойылады.
Dialogue: 0,0:33:10.32,0:33:12.44,Default,,0,0,0,,Менде бәрі жақсы. Иә.
Dialogue: 0,0:33:12.78,0:33:15.66,Default,,0,0,0,,Енді мен әйелдер қауымдастығына жұмысқа баруым керек.
Dialogue: 0,0:33:15.78,0:33:18.41,Default,,0,0,0,,Әй, анаң да сыртқа шығып жатыр ма?
Dialogue: 0,0:33:33.38,0:33:36.43,Default,,0,0,0,,Әкем маған қалталы ақша берді.
Dialogue: 0,0:34:08.50,0:34:09.83,Default,,0,0,0,,Оларды Он екі Жын Айлары қатарына қосу соңы дегенді білдірмейді.
Dialogue: 0,0:34:11.38,0:34:13.17,Default,,0,0,0,,Қош бол Хиросима
Dialogue: 0,0:34:18.38,0:34:19.26,Default,,0,0,0,,Иә?
Dialogue: 0,0:34:19.38,0:34:21.80,Default,,0,0,0,,Эй, қайтып келдің!?
Dialogue: 0,0:34:22.06,0:34:24.68,Default,,0,0,0,,Мен ол жақтағыларды аяй бастадым.
Dialogue: 0,0:34:24.81,0:34:25.64,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,0:34:32.69,0:34:34.36,Default,,0,0,0,,А, мен үйдемін.
Dialogue: 0,0:34:36.57,0:34:38.65,Default,,0,0,0,,Менің жеңгем үнемі осында.
Dialogue: 0,0:34:42.78,0:34:46.20,Default,,0,0,0,,Анашым, маған Сузури беріңізші.
Dialogue: 0,0:34:46.33,0:34:48.08,Default,,0,0,0,,Бұл не, Харуми?
Dialogue: 0,0:34:48.58,0:34:50.50,Default,,0,0,0,,Эй, оны маған қарызға бер.
Dialogue: 0,0:34:50.67,0:34:54.34,Default,,0,0,0,,Тоқта... Сузу-сан, сен Харумиге не дедің?
Dialogue: 0,0:34:56.09,0:34:59.26,Default,,0,0,0,,Айналым тақтасы, мен оны қазір айналдыра аламын ба?
Dialogue: 0,0:34:59.38,0:35:00.55,Default,,0,0,0,,Өтінемін
Dialogue: 0,0:35:01.89,0:35:03.18,Default,,0,0,0,,I'm going
Dialogue: 0,0:35:03.30,0:35:07.23,Default,,0,0,0,,Мен Хиросимадан оралғаннан бері өзімді...
Dialogue: 0,0:35:07.39,0:35:09.31,Default,,0,0,0,,Босатқанда әлі баласың
Dialogue: 0,0:35:09.44,0:35:12.11,Default,,0,0,0,,Эй, көп рахмет.
Dialogue: 0,0:35:12.73,0:35:13.65,Default,,0,0,0,,(Жолаушы) Соңғы сегіздік пе? Сен керемет көріндің. (Изуку) Ә…
Dialogue: 0,0:35:13.77,0:35:15.48,Default,,0,0,0,,Жоқ десең
Dialogue: 0,0:35:15.61,0:35:17.19,Default,,0,0,0,,Маған қылқаламыңды қарызға бер, эй
Dialogue: 0,0:35:17.32,0:35:19.90,Default,,0,0,0,,Сізге бұл қажет емес.
Dialogue: 0,0:35:43.43,0:35:45.72,Default,,0,0,0,,Ах... қош келдіңіз.
Dialogue: 0,0:35:47.18,0:35:49.18,Default,,0,0,0,,Шөпті көрдің бе?
Dialogue: 0,0:35:49.31,0:35:52.94,Default,,0,0,0,,Күлсін, мен оны кешкі асқа гарнир деп ойлаймын.
Dialogue: 0,0:35:53.06,0:35:54.48,Default,,0,0,0,,Хмм.
Dialogue: 0,0:35:54.73,0:35:57.57,Default,,0,0,0,,Бұл жердегі бәйшешектердің бәрі ақ түсті.
Dialogue: 0,0:35:58.07,0:35:59.94,Default,,0,0,0,,Non Enami айырмашылығы бар ма?
Dialogue: 0,0:36:00.49,0:36:02.16,Default,,0,0,0,,Әй, сарысы да бар.
Dialogue: 0,0:36:02.28,0:36:04.28,Default,,0,0,0,,Ах (Шусаку) Иә?
Dialogue: 0,0:36:05.62,0:36:08.12,Default,,0,0,0,,Олар алыстан келген шығар.
Dialogue: 0,0:36:09.83,0:36:14.67,Default,,0,0,0,,Неге, мен өзімді жақсы сезінбеймін деп ойладым, бірақ қазір Хиросимаға ғашық болып қалдым.
Dialogue: 0,0:36:14.79,0:36:16.17,Default,,0,0,0,,Наторан
Dialogue: 0,0:36:16.46,0:36:17.96,Default,,0,0,0,,Ух... (Шусаку) А.
Dialogue: 0,0:36:22.47,0:36:26.35,Default,,0,0,0,,Қараңдаршы, бүгін ұшақ тасығыш бар.
Dialogue: 0,0:36:26.55,0:36:28.47,Default,,0,0,0,,Хитака және Хаятака Кано
Dialogue: 0,0:36:28.60,0:36:29.93,Default,,0,0,0,,Үлкен
Dialogue: 0,0:36:31.18,0:36:33.64,Default,,0,0,0,,Акорадағы барлық кемелер жойғыштар.
Dialogue: 0,0:36:33.85,0:36:36.11,Default,,0,0,0,,Германиядан келген су қайықтары да бар.
Dialogue: 0,0:36:36.23,0:36:39.69,Default,,0,0,0,,Бұл кәдімгі кеме тәрізді нәрсе - суасты қайықтарының тендері ...
Dialogue: 0,0:36:44.45,0:36:46.37,Default,,0,0,0,,Қараңдаршы, ақ көз ұшып келеді
Dialogue: 0,0:36:46.49,0:36:47.33,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:36:47.45,0:36:49.24,Default,,0,0,0,,Міне.
Dialogue: 0,0:36:49.49,0:36:51.25,Default,,0,0,0,,Қараңдар, мен қараймын.
Dialogue: 0,0:36:51.37,0:36:52.83,Default,,0,0,0,,Ух... (Шусаку) А...
Dialogue: 0,0:36:53.25,0:36:56.58,Default,,0,0,0,,А, Шусаку-сан, бұл не?
Dialogue: 0,0:36:56.83,0:36:58.13,Default,,0,0,0,,Бұл кеме ме?
Dialogue: 0,0:36:58.75,0:37:00.13,Default,,0,0,0,,Ямато
Dialogue: 0,0:37:00.76,0:37:04.13,Default,,0,0,0,,Дүние жүзіндегі ең үлкен әскери кеме Шығыстағы ең үлкен әскери портта дүниеге келді.
Dialogue: 0,0:37:05.13,0:37:08.05,Default,,0,0,0,,Күрсін... Оны да адамдар алып жатыр ма?
Dialogue: 0,0:37:08.26,0:37:09.26,Default,,0,0,0,,О
Dialogue: 0,0:37:12.14,0:37:14.14,Default,,0,0,0,,Шамамен 2700 адам
Dialogue: 0,0:37:17.06,0:37:20.23,Default,,0,0,0,,2700 адам…
Dialogue: 0,0:37:20.36,0:37:24.15,Default,,0,0,0,,Олай болса, Сузу-сан, Күреге қайтып келші.
Dialogue: 0,0:37:24.70,0:37:26.20,Default,,0,0,0,,Хааа~
Dialogue: 0,0:37:26.70,0:37:29.28,Default,,0,0,0,,Ортадағы адамдарға...
Dialogue: 0,0:37:29.41,0:37:31.33,Default,,0,0,0,,Сіз күнде тамақ жасайсыз ба? (Шусаку) Сузу-сан
Dialogue: 0,0:37:31.45,0:37:34.08,Default,,0,0,0,,Кірге келетін болсақ... Ах! (Шусаку) Әй, уау!
Dialogue: 0,0:37:34.21,0:37:35.87,Default,,0,0,0,,(құлау дыбысы)
Dialogue: 0,0:37:36.12,0:37:37.38,Default,,0,0,0,,Уф...
Dialogue: 0,0:37:37.92,0:37:40.71,Default,,0,0,0,,Кешіріңіз. Сенімен бәрі жақсы ма?
Dialogue: 0,0:37:40.84,0:37:45.30,Default,,0,0,0,,Жоқ. Сіз жарақат алдыңыз ба? Ахх
Dialogue: 0,0:37:45.76,0:37:46.80,Default,,0,0,0,,Ах...
Dialogue: 0,0:37:53.56,0:37:54.98,Default,,0,0,0,,Сузу Ноу
Dialogue: 0,0:37:55.10,0:37:58.06,Default,,0,0,0,,Осыған уайымдасаңыз, тазыңыз нашарлайды.
Dialogue: 0,0:37:58.19,0:37:59.94,Default,,0,0,0,,Сіз ұсталдыңыз ба?
Dialogue: 0,0:38:00.40,0:38:05.24,Default,,0,0,0,,Эй, қылқаламыңды маған бер, мен Сузу-санның басын сиямен бояйын.
Dialogue: 0,0:38:05.36,0:38:06.82,Default,,0,0,0,,Икенчуутара
Dialogue: 0,0:38:06.95,0:38:08.99,Default,,0,0,0,,Сіз бәрін қара етесіз, бірақ сіз
Dialogue: 0,0:38:09.12,0:38:10.62,Default,,0,0,0,,Иә~ Аа...
Dialogue: 0,0:38:11.74,0:38:15.58,Default,,0,0,0,,Ақырында қайынсіңлің де тұрмысқа шыққан жеріне қайтады.
Dialogue: 0,0:38:15.79,0:38:20.13,Default,,0,0,0,,Жүр, мен кешкі ас әзірлеуді ойлап жатқанда...
Dialogue: 0,0:38:20.25,0:38:22.34,Default,,0,0,0,,Рацион айтарлықтай төмендеді.
Dialogue: 0,0:38:23.21,0:38:27.47,Default,,0,0,0,,Төрт кептірілген сардина төрт адамнан тұратын отбасына үш мезгіл тамақ береді.
Dialogue: 0,0:38:28.68,0:38:30.97,Default,,0,0,0,,Жасыл жапырақтары бар күннен жақсы.
Dialogue: 0,0:38:31.43,0:38:34.81,Default,,0,0,0,,Егер сіз Kokee-ді сапқа тұрғызсаңыз, сіз ақырында Унохананы да сатып ала аласыз.
Dialogue: 0,0:38:35.60,0:38:37.48,Default,,0,0,0,,А, мен түсіндім, а
Dialogue: 0,0:38:38.48,0:38:42.48,Default,,0,0,0,,Күлгін балапан жылқықұйрығы
Dialogue: 0,0:38:43.11,0:38:47.11,Default,,0,0,0,,Одуванчик оксалис кептірілген сардин Унохана
Dialogue: 0,0:38:47.24,0:38:51.16,Default,,0,0,0,,Картоп Тәтті картоп Ұн Умебоши тұқымы
Dialogue: 0,0:38:51.74,0:38:53.28,Default,,0,0,0,,Хмм.
Dialogue: 0,0:38:53.83,0:38:56.66,Default,,0,0,0,,Тәтті картопты турап, бумен пісіріңіз
Dialogue: 0,0:38:56.79,0:39:00.08,Default,,0,0,0,,Жылқы құйрығын аздап қайнатып, суға салып, тураңыз.
Dialogue: 0,0:39:00.21,0:39:04.25,Default,,0,0,0,,Ұнды тәтті картоп пен қырықбуынмен араластырып, жалпақ шарға айналдырыңыз.
Dialogue: 0,0:39:04.42,0:39:06.01,Default,,0,0,0,,Түскі ас дайын
Dialogue: 0,0:39:06.13,0:39:08.26,Default,,0,0,0,,Кейко және басқаларсыз тыныш.
Dialogue: 0,0:39:08.80,0:39:11.39,Default,,0,0,0,,Қалдықтарды кептіру арқылы сақтау керек.
Dialogue: 0,0:39:12.68,0:39:14.22,Default,,0,0,0,,Келіңіздер, әлі жоқ.
Dialogue: 0,0:39:14.72,0:39:17.73,Default,,0,0,0,,Күрішті 5 рет сумен сұйылтып, ботқа ретінде қолданыңыз.
Dialogue: 0,0:39:18.89,0:39:22.36,Default,,0,0,0,,Туралған картопты қосып, тағы 10 минут пісіріңіз
Dialogue: 0,0:39:23.11,0:39:25.19,Default,,0,0,0,,Туралған балапаны қосыңыз
Dialogue: 0,0:39:25.78,0:39:28.24,Default,,0,0,0,,Шалғам қабығы Одуванчик тамыры
Dialogue: 0,0:39:28.65,0:39:31.36,Default,,0,0,0,,Жолақтарға кесіп, қант пен соя соусымен қайнатыңыз.
Dialogue: 0,0:39:31.95,0:39:37.08,Default,,0,0,0,,Туралған одуванчика жапырақтарын қосып, Уноханамен араластырып, әрі қарай пісіріңіз.
Dialogue: 0,0:39:38.66,0:39:43.00,Default,,0,0,0,,Шалғамды жұқалап турап, оны тұзбен сүртіңіз, Оксалиспен араластырыңыз.
Dialogue: 0,0:39:44.42,0:39:49.63,Default,,0,0,0,,Умебоши тұқымын және суды кәстрөлге салыңыз, қайнатыңыз, содан кейін кептірілген сардина қосыңыз.
Dialogue: 0,0:39:49.80,0:39:52.51,Default,,0,0,0,,Сорпаны үстіне құйып, бетін ашпай қайнатыңыз.
Dialogue: 0,0:39:52.64,0:39:54.55,Default,,0,0,0,,Дәміне қарай тұзбен аяқтаңыз
Dialogue: 0,0:39:54.68,0:39:58.18,Default,,0,0,0,,Жарайды, бұл туралы Қария-санға айта алмайсың.
Dialogue: 0,0:39:58.31,0:40:02.69,Default,,0,0,0,,Күріш рационы тек жартысы ғана болды, ал күріш ботқасында тәтті картоп көп болды.
Dialogue: 0,0:40:02.81,0:40:03.73,Default,,0,0,0,,Не
Dialogue: 0,0:40:03.85,0:40:05.77,Default,,0,0,0,,Ертең маған қалдырыңызшы.
Dialogue: 0,0:40:06.82,0:40:09.65,Default,,0,0,0,,Адал вассал Лорд Кусуноки балауыз қамалына төтеп беруі үшін.
Dialogue: 0,0:40:09.78,0:40:13.03,Default,,0,0,0,,Азық-түлікті көбейту әдісін ойлап тапты
Dialogue: 0,0:40:14.57,0:40:17.62,Default,,0,0,0,,Алдымен күрішті жақсылап қуырыңыз.
Dialogue: 0,0:40:18.29,0:40:22.33,Default,,0,0,0,,3 есе көп су құйып, баяу отта баяу пісіріңіз.
Dialogue: 0,0:40:23.83,0:40:27.42,Default,,0,0,0,,Жанармай ысырап етсеңіз, күрішті үнемдеу қызықсыз.
Dialogue: 0,0:40:27.80,0:40:32.88,Default,,0,0,0,,Бұл Жапон империясының қолайлығы. Оны жалынсыз пешке қалдырыңыз.
Dialogue: 0,0:40:33.88,0:40:35.34,Default,,0,0,0,,Таңды күту
Dialogue: 0,0:40:38.26,0:40:41.77,Default,,0,0,0,,Қалған қайнатылған балық сорпасына шегіргүлді қосыңыз.
Dialogue: 0,0:40:41.89,0:40:43.52,Default,,0,0,0,,Мисо қосып, қайнатыңыз
Dialogue: 0,0:40:44.48,0:40:47.52,Default,,0,0,0,,Күрішті қайтадан отқа қойып, қайнатыңыз.
Dialogue: 0,0:40:48.15,0:40:49.36,Default,,0,0,0,,Аяқтау
Dialogue: 0,0:40:49.69,0:40:52.90,Default,,0,0,0,,Бұл Кусуноки-кохан, Кусуноки-комен туыстас.
Dialogue: 0,0:40:53.90,0:40:56.20,Default,,0,0,0,,Бұл әкемнің түскі асына арналған.
Dialogue: 0,0:40:57.07,0:41:01.04,Default,,0,0,0,,Ой... Бүгін таңертең менде дәмді тағамдар көп.
Dialogue: 0,0:41:01.16,0:41:02.54,Default,,0,0,0,,Меши дәндері ісінеді
Dialogue: 0,0:41:02.91,0:41:05.08,Default,,0,0,0,,Оны дайындаудың әдемі тәсілі бар.
Dialogue: 0,0:41:05.21,0:41:08.13,Default,,0,0,0,,Иә (барлығы) Мен қабылдаймын.
Dialogue: 0,0:41:14.93,0:41:16.39,Default,,0,0,0,,Өз орныңды біл.
Dialogue: 0,0:41:18.18,0:41:19.64,Default,,0,0,0,,Мен барамын... Кешіріңіз.
Dialogue: 0,0:41:19.76,0:41:23.02,Default,,0,0,0,,Лорд Кусуноки осыдан ләззат алады...
Dialogue: 0,0:41:23.14,0:41:26.06,Default,,0,0,0,,Ол нағыз батыр болуы керек.
Dialogue: 0,0:41:26.52,0:41:28.02,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:41:28.15,0:41:30.07,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:41:30.19,0:41:33.90,Default,,0,0,0,,Ескерту ескертуі берілді
Dialogue: 0,0:41:34.03,0:41:35.15,Default,,0,0,0,,(Дабыл)
Dialogue: 0,0:41:35.28,0:41:38.66,Default,,0,0,0,,Әуе шабуылы туралы ескерту берілді
Dialogue: 0,0:41:45.21,0:41:47.21,Default,,0,0,0,,Эфирде ештеңе айтпаңыз
Dialogue: 0,0:41:47.50,0:41:49.84,Default,,0,0,0,,Шусаку жұмысқа кетті ме?
Dialogue: 0,0:41:49.96,0:41:51.38,Default,,0,0,0,,Иә (Entaro) Жақсы.
Dialogue: 0,0:41:51.50,0:41:56.43,Default,,0,0,0,,Қарсыластың күтілетін крейсерлік күшіне қарағанда, Кюсю бірінші рет ең жақсы жер.
Dialogue: 0,0:41:56.59,0:41:59.47,Default,,0,0,0,,Мен бұл жерде үрейленіп, тауға жүгіріп бара жатырмын... Ах.
Dialogue: 0,0:41:59.60,0:42:00.76,Default,,0,0,0,,...
Dialogue: 0,0:42:00.89,0:42:03.39,Default,,0,0,0,,Бұл жай ғана электр қуатының үзілуі.
Dialogue: 0,0:42:05.56,0:42:07.65,Default,,0,0,0,,Сіз сәтсіздікке ұшырадыңыз.
Dialogue: 0,0:42:08.15,0:42:10.48,Default,,0,0,0,,Ғимаратты эвакуациялау
Dialogue: 0,0:42:11.02,0:42:13.65,Default,,0,0,0,,Қала бойынша өрт сөндіру алаңын жасаңыз
Dialogue: 0,0:42:13.78,0:42:14.65,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:42:14.78,0:42:17.78,Default,,0,0,0,,Менің ойымша, сізге бұл жерде алаңдаудың қажеті жоқ.
Dialogue: 0,0:42:18.16,0:42:19.70,Default,,0,0,0,,Бұл қиын, солай емес пе?
Dialogue: 0,0:42:20.07,0:42:22.79,Default,,0,0,0,,Қызық, әркім көшетін жерін таба ма?
Dialogue: 0,0:42:23.24,0:42:25.00,Default,,0,0,0,,Ах... Кешіріңіз.
Dialogue: 0,0:42:25.79,0:42:27.54,Default,,0,0,0,,Қош келдіңіз, иә?
Dialogue: 0,0:42:28.58,0:42:30.71,Default,,0,0,0,,Отынның кез келген түрі жарайды.
Dialogue: 0,0:42:31.04,0:42:33.59,Default,,0,0,0,,Менің ғимаратым да бұзылды.
Dialogue: 0,0:42:33.71,0:42:34.55,Default,,0,0,0,,Иә
Dialogue: 0,0:42:35.30,0:42:38.01,Default,,0,0,0,,Мен бүкіл үймен Шимоносэкиге баруды шештім.
Dialogue: 0,0:42:38.13,0:42:38.97,Default,,0,0,0,,Иә?
Dialogue: 0,0:42:39.09,0:42:40.84,Default,,0,0,0,,Иә, мен онымен ажырасу мүмкіндігін пайдаландым.
Dialogue: 0,0:42:40.97,0:42:42.22,Default,,0,0,0,,Иә!?
Dialogue: 0,0:42:42.64,0:42:46.06,Default,,0,0,0,,Уайымдама, тек жұмыс тауып, жұмысқа бар.
Dialogue: 0,0:42:47.06,0:42:49.85,Default,,0,0,0,,Кірушілер саны артты.
Dialogue: 0,0:42:49.98,0:42:51.69,Default,,0,0,0,,Иә, солай ма?
Dialogue: 0,0:42:51.81,0:42:52.94,Default,,0,0,0,,Бірақ қазір бұны ойлайтын уақытым жоқ.
Dialogue: 0,0:42:55.44,0:42:57.57,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:42:57.90,0:43:00.91,Default,,0,0,0,,Сіз оны кеше Хайгаминнің үстіне шықтыңыз.
Dialogue: 0,0:43:01.03,0:43:03.70,Default,,0,0,0,,Менің ойымша, зеңбірек Агенатода да келді.
Dialogue: 0,0:43:03.83,0:43:05.79,Default,,0,0,0,,Бұл ақыры қорқынышты бола бастады
Dialogue: 0,0:43:06.37,0:43:08.21,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,0:43:08.96,0:43:12.71,Default,,0,0,0,,Иә, әуе шабуылына қарсы пана аяқталды.
Dialogue: 0,0:43:12.84,0:43:14.63,Default,,0,0,0,,Иә (Шусаку) Жарайды.
Dialogue: 0,0:43:15.00,0:43:18.09,Default,,0,0,0,,Сіз артық жұмыс істеуді жалғастыра беруге қатты қуанған болуыңыз керек.
Dialogue: 0,0:43:19.26,0:43:23.89,Default,,0,0,0,,Әпкем екеуміз бағаналар мен татами төсеніштерінің арқасында аман қалдық.
Dialogue: 0,0:43:26.10,0:43:29.52,Default,,0,0,0,,Шусаку Сіз осындасыз ба?
Dialogue: 0,0:43:30.06,0:43:32.02,Default,,0,0,0,,Не? Бұл ештеңе емес
Dialogue: 0,0:43:33.06,0:43:35.77,Default,,0,0,0,,Енді дастарханды жинап алайық.
Dialogue: 0,0:43:36.44,0:43:37.48,Default,,0,0,0,,Жақсы кадрлар
Dialogue: 0,0:43:38.11,0:43:42.91,Default,,0,0,0,,Шусаку-сан, мен бұл топырақты Читоның егісіне апарсам болады ма?
Dialogue: 0,0:43:43.03,0:43:46.45,Default,,0,0,0,,Ал, ал, абай бол.
Dialogue: 0,0:43:47.41,0:43:50.00,Default,,0,0,0,,Иә, мұнда кел.
Dialogue: 0,0:43:50.12,0:43:52.42,Default,,0,0,0,,Иә, мен қайықты көрдім.
Dialogue: 0,0:43:53.17,0:43:55.17,Default,,0,0,0,,Жарайды хаха...
Dialogue: 0,0:43:55.29,0:43:57.38,Default,,0,0,0,,Бүгін қайта жіберіп алмаңыз.
Dialogue: 0,0:43:57.50,0:43:58.92,Default,,0,0,0,,Екі Ямато бар.
Dialogue: 0,0:44:00.22,0:44:01.88,Default,,0,0,0,,Бірі – Мусаши
Dialogue: 0,0:44:02.01,0:44:06.14,Default,,0,0,0,,Соғыс кемелері бар, бірақ ұшақ тасығыштары жоқ.
Dialogue: 0,0:44:06.26,0:44:07.18,Default,,0,0,0,,Иә
Dialogue: 0,0:44:07.31,0:44:11.39,Default,,0,0,0,,А, бұл Тон. Оның артында мұнара жоқ.
Dialogue: 0,0:44:11.52,0:44:13.35,Default,,0,0,0,,Авиациялық крейсер
Dialogue: 0,0:44:13.48,0:44:17.90,Default,,0,0,0,,Уау, бұл керемет.
Dialogue: 0,0:44:18.03,0:44:21.28,Default,,0,0,0,,Иә, ағаңызға айтыңызшы.
Dialogue: 0,0:44:21.53,0:44:24.57,Default,,0,0,0,,Түсіндім, біз де аздап үйрендік.
Dialogue: 0,0:44:25.74,0:44:27.33,Default,,0,0,0,,Жоюшы (Харуми) Иә
Dialogue: 0,0:44:27.45,0:44:29.08,Default,,0,0,0,,А, бірдеңе келе жатыр.
Dialogue: 0,0:44:30.33,0:44:31.58,Default,,0,0,0,,Бұл ішкі өртке қарсы қайық.
Dialogue: 0,0:44:32.33,0:44:35.58,Default,,0,0,0,,Эй, эй, саған да рахмет.
Dialogue: 0,0:44:36.42,0:44:38.92,Default,,0,0,0,,Бұл үлкен бұлт (Харуми) Иә.
Dialogue: 0,0:44:39.05,0:44:42.22,Default,,0,0,0,,Канатоко бұлттары (Харуми) Иә.
Dialogue: 0,0:44:42.38,0:44:44.84,Default,,0,0,0,,Қатты жаңбыр жауады. Ха... (Харуми) Ха!
Dialogue: 0,0:44:47.72,0:44:48.89,Default,,0,0,0,,Сәлем Шусаку-сан
Dialogue: 0,0:44:49.01,0:44:51.85,Default,,0,0,0,,Әзірше айналадағы заттарды окопқа салыңыз.
Dialogue: 0,0:44:53.39,0:44:55.06,Default,,0,0,0,,Ахх
Dialogue: 0,0:45:00.86,0:45:02.44,Default,,0,0,0,,Кешіріңіз, кешіріңіз
Dialogue: 0,0:45:03.03,0:45:03.86,Default,,0,0,0,,Хаа…
Dialogue: 0,0:45:06.99,0:45:08.20,Default,,0,0,0,,Haah
Dialogue: 0,0:45:08.70,0:45:11.50,Default,,0,0,0,,А, мен істеймін, істеймін.
Dialogue: 0,0:45:12.75,0:45:15.33,Default,,0,0,0,,Сізге әскери кемелер ұнайды, солай ма? (Шусаку) Иә?
Dialogue: 0,0:45:15.50,0:45:17.29,Default,,0,0,0,,Харуми-саннан естіген
Dialogue: 0,0:45:17.42,0:45:18.63,Default,,0,0,0,,О
Dialogue: 0,0:45:18.84,0:45:22.59,Default,,0,0,0,,Харумиге сабақ берген мен емес, Хибо болды.
Dialogue: 0,0:45:22.71,0:45:24.93,Default,,0,0,0,,H? (Шусаку) Иә.
Dialogue: 0,0:45:25.18,0:45:29.35,Default,,0,0,0,,Мен әскери кемені жақсы көремін, сондықтан мен Сузу-санды бір күні кездестіремін.
Dialogue: 0,0:45:30.26,0:45:33.64,Default,,0,0,0,,Бұл Хисао ма?
Dialogue: 0,0:45:34.23,0:45:35.10,Default,,0,0,0,,Иә
Dialogue: 0,0:45:40.44,0:45:41.28,Default,,0,0,0,,Ах
Dialogue: 0,0:45:45.86,0:45:49.45,Default,,0,0,0,,Мен мұны осы адаммен жасадым.
Dialogue: 0,0:45:54.08,0:45:57.21,Default,,0,0,0,,Жарайды, аздап жаңбыр жауа бастады.
Dialogue: 0,0:45:57.33,0:45:59.25,Default,,0,0,0,,Қазір үйге қайтайық.
Dialogue: 0,0:45:59.75,0:46:00.71,Default,,0,0,0,,Ум...
Dialogue: 0,0:46:00.84,0:46:05.26,Default,,0,0,0,,Біз жұппыз, сондықтан жақсы қарым-қатынаста болғанымыз дұрыс.
Dialogue: 0,0:46:05.55,0:46:08.51,Default,,0,0,0,,Иә, иә, жақсы неке құру маңызды емес.
Dialogue: 0,0:46:08.64,0:46:09.72,Default,,0,0,0,,2 жиын
Dialogue: 0,0:46:09.85,0:46:11.26,Default,,0,0,0,,Диази…
Dialogue: 0,0:46:14.35,0:46:19.44,Default,,0,0,0,,Отбасы болып бас қосып, тату болайық
Dialogue: 0,0:46:19.86,0:46:24.99,Default,,0,0,0,,Әлгі қайын апасының күйеуі...
Dialogue: 0,0:46:25.15,0:46:29.66,Default,,0,0,0,,Әскерге барсам да, арық болдым.
Dialogue: 0,0:46:29.78,0:46:31.28,Default,,0,0,0,,Тым жұқа ма?
Dialogue: 0,0:46:32.87,0:46:36.21,Default,,0,0,0,,Әкем қайтадан зауытқа жұмысқа тұрғанда...
Dialogue: 0,0:46:36.75,0:46:39.37,Default,,0,0,0,,Әпке, мен мерекелеу үшін дүкенге сағат іздедім.
Dialogue: 0,0:46:39.67,0:46:42.25,Default,,0,0,0,,Мен жас шеберді сонда кездестірдім.
Dialogue: 0,0:46:43.17,0:46:47.97,Default,,0,0,0,,Мен әйеліме бардым, ал екі жас жұп жаңа киім алуға дүкенге барды.
Dialogue: 0,0:46:48.76,0:46:52.35,Default,,0,0,0,,Ей, Кейкода сондай мінез бар.
Dialogue: 0,0:46:52.51,0:46:55.22,Default,,0,0,0,,Ата-анаңмен келісімге кел.
Dialogue: 0,0:46:55.52,0:46:57.68,Default,,0,0,0,,Күйеу баласы айқайлаған соң,
Dialogue: 0,0:46:57.81,0:47:01.40,Default,,0,0,0,,Дүкенмен не істеу керектігін шеше алмай қиналдым.
Dialogue: 0,0:47:01.61,0:47:06.74,Default,,0,0,0,,Соңында ғимаратты эвакуациялауға байланысты ештеңе болған жоқ.
Dialogue: 0,0:47:08.40,0:47:11.41,Default,,0,0,0,,Хисао - Куромураның мұрагері.
Dialogue: 0,0:47:12.07,0:47:17.75,Default,,0,0,0,,Оны Шимоносэкиге апарды, ол жақсы жауап берген сияқты.
Dialogue: 0,0:47:18.66,0:47:22.50,Default,,0,0,0,,Бəрінің күліп тұрғанымен өмір сүрсем ғой.
Dialogue: 0,0:47:23.17,0:47:24.75,Default,,0,0,0,,Бұл рас.
Dialogue: 0,0:47:26.05,0:47:26.88,Default,,0,0,0,,Га
Dialogue: 0,0:47:33.39,0:47:35.10,Default,,0,0,0,,Көкөністерді қарап көрейін.
Dialogue: 0,0:47:48.94,0:47:53.78,Default,,0,0,0,,Мұның солай екенін түсіну үшін бізге айлар қажет болды.
Dialogue: 0,0:47:53.99,0:47:55.99,Default,,0,0,0,,Шынымен, мен жай ғана ойсызмын.
Dialogue: 0,0:48:01.04,0:48:02.54,Default,,0,0,0,,Бұл Ямато
Dialogue: 0,0:48:03.79,0:48:05.29,Default,,0,0,0,,Бұл Тон
Dialogue: 0,0:48:08.01,0:48:10.17,Default,,0,0,0,,Эй, аа...
Dialogue: 0,0:48:10.51,0:48:13.55,Default,,0,0,0,,Ах... Мм... Мм, Учиха...
Dialogue: 0,0:48:14.76,0:48:18.68,Default,,0,0,0,,Алысқа көшіп келген балама қайықтың суретін жібергім келді...
Dialogue: 0,0:48:18.81,0:48:20.60,Default,,0,0,0,,Мына әйелдің үйі қайда?
Dialogue: 0,0:48:20.73,0:48:23.15,Default,,0,0,0,,Кэ... Әскери полиция (Кэйджи) Иә!?
Dialogue: 0,0:48:23.31,0:48:25.90,Default,,0,0,0,,Мен жағалау сызығы мен кеменің сұлбасын сыздым.
Dialogue: 0,0:48:26.48,0:48:29.32,Default,,0,0,0,,Тыңшылықпен айналысып жүрсең, бет-әлпеті сондай қара...
Dialogue: 0,0:48:29.44,0:48:33.66,Default,,0,0,0,,Мен сіздің жоспарыңыздың қаншалықты қу және қу екенін білмеймін.
Dialogue: 0,0:48:34.95,0:48:36.78,Default,,0,0,0,,Бұл әйелдің күйеуі-
Dialogue: 0,0:48:36.91,0:48:40.37,Default,,0,0,0,,Әскери-теңіз сотының жазбасы
Dialogue: 0,0:48:40.50,0:48:44.33,Default,,0,0,0,,Әйелдің мүмкіндікті пайдаланып, әскери құпияларды ақтару мүмкіндігі бар емес пе?
Dialogue: 0,0:48:45.21,0:48:47.42,Default,,0,0,0,,Шифрланған байланыстың белгісі бар ма?
Dialogue: 0,0:48:47.71,0:48:50.59,Default,,0,0,0,,Әйел затынан кездейсоқ сандар кестесін көрдіңіз бе?
Dialogue: 0,0:48:50.71,0:48:54.18,Default,,0,0,0,,Фонға не нұсқайды? Иә? Өтінемін?
Dialogue: 0,0:48:56.09,0:49:00.93,Default,,0,0,0,,Бұл жолы мен айыптаудан бас тартамын, бірақ мен оларды әрқашан қадағалаймын.
Dialogue: 0,0:49:01.06,0:49:03.19,Default,,0,0,0,,Әйелім десең де, ол бәрібір бөтен.
Dialogue: 0,0:49:06.61,0:49:07.61,Default,,0,0,0,,Иә
Dialogue: 0,0:49:12.19,0:49:15.11,Default,,0,0,0,,(Нацуо) Жоқ, «шектеу» дегеніміз – ақыр соңында адам өз-өзіне қоятын нәрсе.
Dialogue: 0,0:49:15.32,0:49:16.99,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:49:17.57,0:49:20.91,Default,,0,0,0,,Не? Кір кептіруге қалды
Dialogue: 0,0:49:21.04,0:49:22.62,Default,,0,0,0,,А, Шусаку, бұл...
Dialogue: 0,0:49:22.91,0:49:25.62,Default,,0,0,0,,Сузу-сан әскери полицияға (Шусаку) иә?
Dialogue: 0,0:49:28.21,0:49:30.55,Default,,0,0,0,,Сузу-сан, бір сәт осында келші.
Dialogue: 0,0:49:37.18,0:49:38.01,Default,,0,0,0,,Иә?
Dialogue: 0,0:49:38.14,0:49:41.52,Default,,0,0,0,,Егер ол соншалықты кішкентай болса, сіз тіпті жағалау сызығын сала алмайсыз.
Dialogue: 0,0:49:43.48,0:49:46.27,Default,,0,0,0,,Сузу сурет салуды ұнататын адам емес пе еді?
Dialogue: 0,0:49:46.85,0:49:49.61,Default,,0,0,0,,Сіз мені тағы бір рет сала аласыз ба?
Dialogue: 0,0:49:50.15,0:49:51.53,Default,,0,0,0,,Бұл...
Dialogue: 0,0:49:51.90,0:49:54.40,Default,,0,0,0,,Ол дұрыс салынбауы мүмкін
Dialogue: 0,0:49:54.90,0:49:56.07,Default,,0,0,0,,Хаа…
Dialogue: 0,0:49:56.74,0:49:59.62,Default,,0,0,0,,Сузу-сан тыңшы...
Dialogue: 0,0:50:00.16,0:50:02.91,Default,,0,0,0,,Шусаку, дұрыс айтасың.
Dialogue: 0,0:50:03.16,0:50:06.46,Default,,0,0,0,,We apologize to the military police.
Dialogue: 0,0:50:06.58,0:50:08.54,Default,,0,0,0,,Күлу қиын
Dialogue: 0,0:50:08.67,0:50:10.92,Default,,0,0,0,,Егер сіз ұстанатын болсаңыз, сізге көбірек қиындықтар қажет болады.
Dialogue: 0,0:50:11.50,0:50:14.42,Default,,0,0,0,,Қырықша… әрине!
Dialogue: 0,0:50:14.67,0:50:16.38,Default,,0,0,0,,Көріп отырғаныңыздай, егер көңіліңіз көтерілсе...
Dialogue: 0,0:50:16.51,0:50:19.72,Default,,0,0,0,,Ол айналаны бірден көре алмайтын бала.
Dialogue: 0,0:50:19.85,0:50:24.14,Default,,0,0,0,,Тәңіршіл, дана болып көріну уақытты босқа өткізу.
Dialogue: 0,0:50:24.27,0:50:28.73,Default,,0,0,0,,Бұл адам үйіне сағат 6-да қайтуы керек. Оны Рокуджи деп ойлаған адам.
Dialogue: 0,0:50:28.85,0:50:32.36,Default,,0,0,0,,Бұл ақымақ армияның полицейлері қандай құпияларды көздеп отыр?
Dialogue: 0,0:50:32.48,0:50:35.99,Default,,0,0,0,,Неге екенін білмеймін, бірақ ашулана бастадым.
Dialogue: 0,0:50:36.11,0:50:38.91,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:50:39.49,0:50:42.91,Default,,0,0,0,,Бəрінің күліп тұрғанымен өмір сүрсем ғой.
Dialogue: 0,0:50:43.49,0:50:44.70,Default,,0,0,0,,Бұл дұрыс.
Dialogue: 0,0:50:44.83,0:50:46.12,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,0:50:46.25,0:50:49.37,Default,,0,0,0,,Әке? Әкеңнен де тыңдауын өтіндім.
Dialogue: 0,0:50:49.50,0:50:50.42,Default,,0,0,0,,(күлкі)
Dialogue: 0,0:50:50.54,0:50:53.13,Default,,0,0,0,,Адал күле алмайтын мен ғана ма?
Dialogue: 0,0:50:53.50,0:50:57.22,Default,,0,0,0,,Хо Хо Хо
Dialogue: 0,0:50:59.97,0:51:02.43,Default,,0,0,0,,Соғыс болса да, цикадалар ән салады
Dialogue: 0,0:51:02.72,0:51:03.93,Default,,0,0,0,,Көбелектер де ұшады
Dialogue: 0,0:51:04.06,0:51:06.52,Default,,0,0,0,,Хаа... ыстық болса да
Dialogue: 0,0:51:08.39,0:51:09.90,Default,,0,0,0,,Иә, қант та.
Dialogue: 0,0:51:11.35,0:51:13.82,Default,,0,0,0,,Маусымдағы әуе шабуылдары кезінде...
Dialogue: 0,0:51:13.94,0:51:16.65,Default,,0,0,0,,Көз алдымда соғыс келе жатыр деп ойладым.
Dialogue: 0,0:51:17.86,0:51:20.32,Default,,0,0,0,,Біз қазір қайдамыз және не істейміз?
Dialogue: 0,0:51:20.74,0:51:22.70,Default,,0,0,0,,А, мінеки! О
Dialogue: 0,0:51:23.45,0:51:24.83,Default,,0,0,0,,Itatata...
Dialogue: 0,0:51:24.95,0:51:26.70,Default,,0,0,0,,Harumi-Сан, sorry, sorry.
Dialogue: 0,0:51:26.91,0:51:30.37,Default,,0,0,0,,Жарайды, Арико-сан, мен саған қарап тұрмын.
Dialogue: 0,0:51:30.62,0:51:31.92,Default,,0,0,0,,Хо
Dialogue: 0,0:51:32.04,0:51:34.84,Default,,0,0,0,,Бұл қанша уақытқа созылады деп ойлаймын
Dialogue: 0,0:51:37.26,0:51:39.22,Default,,0,0,0,,Иә...? Иә... (Харуми) Иә.
Dialogue: 0,0:51:40.01,0:51:43.64,Default,,0,0,0,,Иә, иә, иә... (Харуми) Иә...?
Dialogue: 0,0:51:43.80,0:51:45.72,Default,,0,0,0,,Әлде бұл жыныстық сипаттағы қорлау үшін сылтау ма?
Dialogue: 0,0:51:47.22,0:51:48.14,Default,,0,0,0,,Иә?
Dialogue: 0,0:51:54.82,0:51:55.77,Default,,0,0,0,,Ах! Қант қазір бағалы тауарға айналды.
Dialogue: 0,0:51:55.77,0:51:58.28,Default,,0,0,0,,Ах! Қант қазір бағалы тауарға айналды.
Dialogue: 0,0:51:55.77,0:51:58.28,Default,,0,0,0,,Ах! Иә!
Dialogue: 0,0:51:58.28,0:51:59.11,Default,,0,0,0,,Ах! Қант қазір бағалы тауарға айналды.
Dialogue: 0,0:51:59.24,0:52:03.03,Default,,0,0,0,,Уау, аа, а...
Dialogue: 0,0:52:03.16,0:52:04.53,Default,,0,0,0,,Ах (Харуми) Уау!
Dialogue: 0,0:52:06.16,0:52:09.12,Default,,0,0,0,,Арико таба алмайтын нәрсені жасырыңыз.
Dialogue: 0,0:52:09.33,0:52:12.87,Default,,0,0,0,,Жарайды, бірақ қайда?
Dialogue: 0,0:52:14.88,0:52:16.84,Default,,0,0,0,,Иә? Хмм...
Dialogue: 0,0:52:16.96,0:52:18.59,Default,,0,0,0,,Не... не болды?
Dialogue: 0,0:52:19.30,0:52:24.34,Default,,0,0,0,,Арико суда болса, маған жақындай алмайды деп ойладым.
Dialogue: 0,0:52:24.93,0:52:26.56,Default,,0,0,0,,Уау!
Dialogue: 0,0:52:33.23,0:52:36.82,Default,,0,0,0,,Мұны қара базардан сатып алу қиын.
Dialogue: 0,0:52:40.86,0:52:42.82,Default,,0,0,0,,A different path than usual
Dialogue: 0,0:52:45.99,0:52:46.83,Default,,0,0,0,,Өзіңізге қажетін алыңыз
Dialogue: 0,0:52:52.50,0:52:54.88,Default,,0,0,0,,Сатылатын ештеңе болмауы керек.
Dialogue: 0,0:52:55.00,0:52:56.96,Default,,0,0,0,,Неліктен адамдар көп...
Dialogue: 0,0:52:57.92,0:53:01.34,Default,,0,0,0,,Иә? Иә... иә
Dialogue: 0,0:53:01.80,0:53:05.39,Default,,0,0,0,,Бұл Тайвань күріші, солай ма?
Dialogue: 0,0:53:05.51,0:53:06.34,Default,,0,0,0,,Хун
Dialogue: 0,0:53:06.60,0:53:08.35,Default,,0,0,0,,Мен ішкі күрішті ұйымдастыра алсам...
Dialogue: 0,0:53:08.35,0:53:09.85,Default,,0,0,0,,Мен ішкі күрішті ұйымдастыра алсам...
Dialogue: 0,0:53:08.35,0:53:09.85,Default,,0,0,0,,О~
Dialogue: 0,0:53:10.31,0:53:14.31,Default,,0,0,0,,Иә, егістікте қарбызға тыйым салу керек.
Dialogue: 0,0:53:15.44,0:53:18.32,Default,,0,0,0,,Күрсін, бәрі де болады.
Dialogue: 0,0:53:20.82,0:53:25.24,Default,,0,0,0,,Хаха, соғыс алдындағы жазғы демалыс сияқты.
Dialogue: 0,0:53:26.28,0:53:28.28,Default,,0,0,0,,1 бөлке қант 20 иен
Dialogue: 0,0:53:28.83,0:53:31.91,Default,,0,0,0,,... рационнан 50 есе артық?
Dialogue: 0,0:53:32.04,0:53:35.00,Default,,0,0,0,,Қазір алмасам, бәрібір қымбат болады.
Dialogue: 0,0:53:35.17,0:53:40.13,Default,,0,0,0,,Ененің қарны мен осы айдағы күнкөріс шығыны барлығы 25 иен
Dialogue: 0,0:53:40.50,0:53:43.26,Default,,0,0,0,,Устрица тұқымдары
Dialogue: 0,0:53:46.43,0:53:50.68,Default,,0,0,0,,Қант қазір шамамен 150 иен тұрады.
Dialogue: 0,0:53:50.81,0:53:54.10,Default,,0,0,0,,Мен бұдан былай 100 иенге карамель немесе басқа ештеңе сатып ала алмаймын.
Dialogue: 0,0:53:54.23,0:53:55.60,Default,,0,0,0,,Шұлықтар...
Dialogue: 0,0:53:55.73,0:53:59.15,Default,,0,0,0,,3 жұп сатып алсаңыз, 1000 иен болмай ма?
Dialogue: 0,0:54:00.23,0:54:04.03,Default,,0,0,0,,Мұндай елде тұруға бола ма?
Dialogue: 0,0:54:04.82,0:54:05.65,Default,,0,0,0,,Ах...
Dialogue: 0,0:54:07.70,0:54:12.66,Default,,0,0,0,,Иә? Эй, бұл қайда? Бірге
Dialogue: 0,0:54:12.95,0:54:16.46,Default,,0,0,0,,Иә? Наганоки? Теңіз зираты бар ма?
Dialogue: 0,0:54:16.62,0:54:18.17,Default,,0,0,0,,А... иә, Нагасако.
Dialogue: 0,0:54:18.50,0:54:21.17,Default,,0,0,0,,Аа, ана жақта (әйел) Міне, солай ма?
Dialogue: 0,0:54:22.92,0:54:24.05,Default,,0,0,0,,Хаа…
Dialogue: 0,0:54:36.31,0:54:38.14,Default,,0,0,0,,Аа, кешіріңіз.
Dialogue: 0,0:54:42.52,0:54:43.65,Default,,0,0,0,,Жоқ
Dialogue: 0,0:54:44.19,0:54:46.57,Default,,0,0,0,,Қарбыз? Хаа
Dialogue: 0,0:54:46.70,0:54:49.03,Default,,0,0,0,,Карамель haa
Dialogue: 0,0:54:49.16,0:54:51.16,Default,,0,0,0,,Бала жоғалды ма? Хаа
Dialogue: 0,0:54:52.03,0:54:55.66,Default,,0,0,0,,Сіз ересек болсаңыз да? Қайдан келдің?
Dialogue: 0,0:54:56.00,0:54:57.29,Default,,0,0,0,,Наганоки
Dialogue: 0,0:54:58.00,0:55:01.79,Default,,0,0,0,,Апа, үйге баратын жолды ешкім айтпайды.
Dialogue: 0,0:55:01.92,0:55:07.01,Default,,0,0,0,,Бәрің, иіскеп көрейін. Бұл Рюгу сарайы ма?
Dialogue: 0,0:55:07.13,0:55:12.93,Default,,0,0,0,,Егер сіз Наганокиде болсаңыз, бұрыштан бұрылып, пошта бөлімшесіне түсіңіз.
Dialogue: 0,0:55:13.47,0:55:15.02,Default,,0,0,0,,Мені күт.
Dialogue: 0,0:55:16.18,0:55:18.69,Default,,0,0,0,,Әпке, айтыңызшы.
Dialogue: 0,0:55:20.98,0:55:23.19,Default,,0,0,0,,(иіскеу дыбысы)
Dialogue: 0,0:55:23.86,0:55:26.36,Default,,0,0,0,,Мына жерге барыңыз, мынаны қалдырыңыз
Dialogue: 0,0:55:26.48,0:55:30.32,Default,,0,0,0,,Алға барып, пошта бөлімшесінің жанындағы бұрышта оңға бұрылыңыз.
Dialogue: 0,0:55:30.66,0:55:32.37,Default,,0,0,0,,Рахмет
Dialogue: 0,0:55:33.41,0:55:37.08,Default,,0,0,0,,Айналадағылардың бәрі білмейтін болуы керек.
Dialogue: 0,0:55:37.20,0:55:41.46,Default,,0,0,0,,Олардың көпшілігі аутсайдер, тіпті бұл қақпадан шықпайды.
Dialogue: 0,0:55:41.92,0:55:46.21,Default,,0,0,0,,Сіз де Хиросимадан оңтүстікте... теңіз жағасындасыз ба?
Dialogue: 0,0:55:46.34,0:55:48.72,Default,,0,0,0,,Иә, бірақ неге?
Dialogue: 0,0:55:48.84,0:55:49.72,Default,,0,0,0,,Сөзбен
Dialogue: 0,0:55:50.13,0:55:52.09,Default,,0,0,0,,Еба немесе сол сияқты
Dialogue: 0,0:55:52.22,0:55:54.05,Default,,0,0,0,,Иә, Кусацу т.б.
Dialogue: 0,0:55:54.18,0:55:55.47,Default,,0,0,0,,Кусацу
Dialogue: 0,0:55:56.18,0:55:59.64,Default,,0,0,0,,Әжем жыл сайын бізбен бірге қарбыз жейтін.
Dialogue: 0,0:55:59.77,0:56:01.73,Default,,0,0,0,,Өйткені біз кедей едік...
Dialogue: 0,0:56:01.85,0:56:04.61,Default,,0,0,0,,Адамдардың жеген терісінің бәрі жабысқақ болды.
Dialogue: 0,0:56:05.36,0:56:10.61,Default,,0,0,0,,Мен саған жақсылық жасауға тырыстым, қызылды жедім.
Dialogue: 0,0:56:11.32,0:56:13.57,Default,,0,0,0,,Бұл баяғыда болды.
Dialogue: 0,0:56:14.24,0:56:18.66,Default,,0,0,0,,Суретіңізге қарасаңыз, жақсы екенсіз.
Dialogue: 0,0:56:19.29,0:56:20.21,Default,,0,0,0,,Ум...
Dialogue: 0,0:56:21.29,0:56:25.25,Default,,0,0,0,,Егер сізде басқа арзан заттар болса, маған хабарлаңыз.
Dialogue: 0,0:56:25.42,0:56:27.67,Default,,0,0,0,,Жалбыз қант вараби мочи
Dialogue: 0,0:56:27.84,0:56:29.30,Default,,0,0,0,,Жалбыз қант
Dialogue: 0,0:56:29.42,0:56:33.64,Default,,0,0,0,,Содан кейін балмұздақ вафли болды...
Dialogue: 0,0:56:33.89,0:56:34.93,Default,,0,0,0,,Вафель?
Dialogue: 0,0:56:35.05,0:56:37.64,Default,,0,0,0,,Білмейсіз бе? Сіз Kiccha дүкенінде ешқашан болғансыз ба?
Dialogue: 0,0:56:37.76,0:56:38.64,Default,,0,0,0,,Рин!
Dialogue: 0,0:56:39.14,0:56:41.14,Default,,0,0,0,,Мұнай сатушы көп емес.
Dialogue: 0,0:56:41.48,0:56:43.98,Default,,0,0,0,,Кешіріңіз, мен қазір кетуім керек.
Dialogue: 0,0:56:44.19,0:56:46.52,Default,,0,0,0,,А, эй, келесі жолы сызамын.
Dialogue: 0,0:56:48.78,0:56:52.53,Default,,0,0,0,,Иә, мен мұндай жерге ешқашан келмеймін.
Dialogue: 0,0:56:52.95,0:56:53.86,Default,,0,0,0,,Иә?
Dialogue: 0,0:56:54.07,0:56:58.37,Default,,0,0,0,,Хехехе... Тағы адасып қалармын.
Dialogue: 0,0:57:19.26,0:57:24.27,Default,,0,0,0,,Кеш болды. Мен базарға барғым келді. Үйге келе жатып, қателескен шығармын деп ойладым.
Dialogue: 0,0:57:24.39,0:57:25.48,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,0:57:25.60,0:57:26.81,Default,,0,0,0,,Қайын апа
Dialogue: 0,0:57:26.94,0:57:30.57,Default,,0,0,0,,Kiccha дүкенінің вафли қосылған балмұздағы.
Dialogue: 0,0:57:30.69,0:57:31.94,Default,,0,0,0,,Бұл қандай?
Dialogue: 0,0:57:32.07,0:57:33.99,Default,,0,0,0,,Неліктен білмейсің?
Dialogue: 0,0:57:34.45,0:57:37.20,Default,,0,0,0,,Дұрыс, сен сондай тәтті және суықсың.
Dialogue: 0,0:57:37.32,0:57:40.33,Default,,0,0,0,,Бұл қытырлақ күріш крекеріне ұқсайды, сондықтан оны жинап жеп қойыңыз.
Dialogue: 0,0:57:40.99,0:57:42.16,Default,,0,0,0,,Иә, солай.
Dialogue: 0,0:57:42.29,0:57:44.71,Default,,0,0,0,,А, бұл...
Dialogue: 0,0:57:45.96,0:57:47.08,Default,,0,0,0,,Ахх
Dialogue: 0,0:57:47.50,0:57:49.96,Default,,0,0,0,,Біз тәттілер туралы сөйлескенімізге біраз болды.
Dialogue: 0,0:57:50.09,0:57:52.80,Default,,0,0,0,,Жай судың өзі тәтті көрінеді.
Dialogue: 0,0:57:53.13,0:57:54.47,Default,,0,0,0,,Ах...
Dialogue: 0,0:58:00.26,0:58:01.76,Default,,0,0,0,,Әлі ыстық
Dialogue: 0,0:58:03.27,0:58:07.06,Default,,0,0,0,,Сізге Ходжоның әйелі телефон соқты
Dialogue: 0,0:58:08.06,0:58:10.82,Default,,0,0,0,,Иә, үйде ме?
Dialogue: 0,0:58:13.99,0:58:15.49,Default,,0,0,0,,Мынау мынау
Dialogue: 0,0:58:16.78,0:58:18.24,Default,,0,0,0,,Хаа... ыстық, ыстық
Dialogue: 0,0:58:18.36,0:58:21.28,Default,,0,0,0,,Ұят болатын Шусаку емес. Солай киініп шықсаң...
Dialogue: 0,0:58:31.71,0:58:34.05,Default,,0,0,0,,(Солдат дауысы)
Dialogue: 0,0:58:34.59,0:58:37.55,Default,,0,0,0,,Сонымен, GKF қалай болды?
Dialogue: 0,0:58:37.97,0:58:39.14,Default,,0,0,0,,Босаңсыды.
Dialogue: 0,0:58:39.26,0:58:40.55,Default,,0,0,0,,Мен көремін.
Dialogue: 0,0:58:57.28,0:58:58.24,Default,,0,0,0,,Ах
Dialogue: 0,0:58:58.49,0:59:01.99,Default,,0,0,0,,Шот тапсыруға Шусаку мырза келді.
Dialogue: 0,0:59:02.20,0:59:04.08,Default,,0,0,0,,IBN 5100 — ол
Dialogue: 0,0:59:04.70,0:59:05.79,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:59:05.95,0:59:08.83,Default,,0,0,0,,Ах... Ах! Сузу-сан
Dialogue: 0,0:59:09.25,0:59:11.42,Default,,0,0,0,,Бұл өте ақ, бірақ жақсы ма?
Dialogue: 0,0:59:12.17,0:59:14.21,Default,,0,0,0,,өтіңіз...Бұл біртүрлі емес пе?
Dialogue: 0,0:59:15.00,0:59:17.17,Default,,0,0,0,,Жоқ, жақсы болсаң, иә.
Dialogue: 0,0:59:17.59,0:59:19.22,Default,,0,0,0,,Ей, кеттік.
Dialogue: 0,0:59:19.72,0:59:21.84,Default,,0,0,0,,Не? Сіздің жұмысыңыз...
Dialogue: 0,0:59:21.97,0:59:25.64,Default,,0,0,0,,Шұғыл болмаса да, есепшотты өзіммен бірге әдейі алып келдім.
Dialogue: 0,0:59:26.27,0:59:29.35,Default,,0,0,0,,Мен қалада дүкен аралап көңілді болдым деп ойладым.
Dialogue: 0,0:59:32.81,0:59:36.07,Default,,0,0,0,,Иә? Не болды? Мен өзімді нашар сезінемін...
Dialogue: 0,0:59:36.19,0:59:38.61,Default,,0,0,0,,Мен қатты күлемін.
Dialogue: 0,0:59:40.66,0:59:42.32,Default,,0,0,0,,О...
Dialogue: 0,0:59:44.28,0:59:46.08,Default,,0,0,0,,Мен де бұл фильм деп ойладым.
Dialogue: 0,0:59:46.20,0:59:47.62,Default,,0,0,0,,Хаа…
Dialogue: 0,0:59:48.62,0:59:51.58,Default,,0,0,0,,Үлкен кеме қайтып келгенде не болды?
Dialogue: 0,0:59:53.71,0:59:55.13,Default,,0,0,0,,Жарайды, мен мұнда берілмеймін.
Dialogue: 0,0:59:56.34,0:59:58.67,Default,,0,0,0,,Өкінішке орай, мен мұны қайталаймын.
Dialogue: 0,1:00:01.80,1:00:02.93,Default,,0,0,0,,Сузу-сан?
Dialogue: 0,1:00:03.34,1:00:08.06,Default,,0,0,0,,Бастауыш сыныпта оқитын бір сыныптасым матрос болды.
Dialogue: 0,1:00:08.64,1:00:11.02,Default,,0,0,0,,Біз кездескенде не істеуіміз керек деп ойлайсыңдар?
Dialogue: 0,1:00:11.14,1:00:13.65,Default,,0,0,0,,Мен жай ғана амандассам жақсы болар еді.
Dialogue: 0,1:00:14.52,1:00:17.23,Default,,0,0,0,,Егер мен бұрыннан таныс адаммен қазір кездессем...
Dialogue: 0,1:00:17.36,1:00:21.45,Default,,0,0,0,,Түсіңізден оянамын деп ойламайсыз ба?
Dialogue: 0,1:00:21.65,1:00:22.74,Default,,0,0,0,,Сіз жақсысыз ба?
Dialogue: 0,1:00:22.86,1:00:26.16,Default,,0,0,0,,Тұратын жерімді өзгерту мен фамилиямды өзгерту қиыншылыққа толы...
Dialogue: 0,1:00:27.04,1:00:30.08,Default,,0,0,0,,Please be kind to Shusaku-Сан.
Dialogue: 0,1:00:30.29,1:00:32.08,Default,,0,0,0,,I also made friends.
Dialogue: 0,1:00:32.87,1:00:35.92,Default,,0,0,0,,Иә, қазір оянсам қызық болмас еді.
Dialogue: 0,1:00:36.42,1:00:39.21,Default,,0,0,0,,Егер қазіргі жағдай рас болса, мен солай ойлаймын.
Dialogue: 0,1:00:39.34,1:00:40.92,Default,,0,0,0,,Мен көрдім.
Dialogue: 0,1:00:41.88,1:00:44.76,Default,,0,0,0,,Не өтті, мен таңдамаған жол
Dialogue: 0,1:00:45.18,1:00:48.10,Default,,0,0,0,,Оянған түстен айырмашылығы жоқ
Dialogue: 0,1:00:48.68,1:00:51.18,Default,,0,0,0,,Сузу-сан, мен сені таңдадым...
Dialogue: 0,1:00:51.60,1:00:54.19,Default,,0,0,0,,Probably the best choice for me.
Dialogue: 0,1:00:55.98,1:00:58.94,Default,,0,0,0,,Сіз аздап арықтаған сияқтысыз, бірақ мен уайымдап тұрмын.
Dialogue: 0,1:00:59.57,1:01:03.66,Default,,0,0,0,,Айтпақшы, мен бұл күндері көп тамақ жемейтін сияқтымын.
Dialogue: 0,1:01:03.78,1:01:05.74,Default,,0,0,0,,О...
Dialogue: 0,1:01:06.12,1:01:08.08,Default,,0,0,0,,Ах! (Шусаку) Иә?
Dialogue: 0,1:01:08.20,1:01:09.66,Default,,0,0,0,,Ах! (Шусаку) Ах!
Dialogue: 0,1:01:10.62,1:01:12.33,Default,,0,0,0,,Иә, 2 адамға
Dialogue: 0,1:01:19.42,1:01:23.55,Default,,0,0,0,,Таңертең қосымша тамақ ішкен болуыңыз керек, бұл сізге қажет.
Dialogue: 0,1:01:24.47,1:01:25.43,Default,,0,0,0,,Күрсін...
Dialogue: 0,1:01:25.76,1:01:27.43,Default,,0,0,0,,After all, it’s for one person.
Dialogue: 0,1:01:27.85,1:01:30.85,Default,,0,0,0,,Портты енгізуге дайындық Баяу алға жылдамдық Қызыл 20
Dialogue: 0,1:01:30.97,1:01:34.94,Default,,0,0,0,,Yaw Solow Slow Advance Red 20 Yaw Solow
Dialogue: 0,1:01:38.40,1:01:40.27,Default,,0,0,0,,If you want it, you can ask for it.
Dialogue: 0,1:01:40.40,1:01:41.28,Default,,0,0,0,,О
Dialogue: 0,1:01:42.44,1:01:43.90,Default,,0,0,0,,Иә? Ах
Dialogue: 0,1:01:44.03,1:01:46.82,Default,,0,0,0,,Уау! Нағыз теңізші
Dialogue: 0,1:01:48.41,1:01:51.58,Default,,0,0,0,,We Ран into each other at the well.
Dialogue: 0,1:01:51.74,1:01:55.08,Default,,0,0,0,,Сатоси Мизухара, Аоба әскери кемесінің экипаж мүшесі
Dialogue: 0,1:01:55.71,1:01:58.58,Default,,0,0,0,,Aoba Utaru is Kometsu (Tetsu) Oh
Dialogue: 0,1:01:58.71,1:02:02.13,Default,,0,0,0,,This is Harumi (Tetsu) hahaha...
Dialogue: 0,1:02:02.96,1:02:06.34,Default,,0,0,0,,Уау, қыс болды, мен әбден тотықтым.
Dialogue: 0,1:02:06.63,1:02:10.14,Default,,0,0,0,,Әй, сен менің үйіме шомылуға келдің бе?
Dialogue: 0,1:02:10.30,1:02:13.27,Default,,0,0,0,,Ah, it's free time called bath landing.
Dialogue: 0,1:02:13.68,1:02:18.69,Default,,0,0,0,,Баратын жеріне келсек, сондықтан мен туған жерім Сузудан маған қонаққа келуді өтіндім.
Dialogue: 0,1:02:19.15,1:02:22.07,Default,,0,0,0,,Suzu will take care of you all.
Dialogue: 0,1:02:22.86,1:02:26.70,Default,,0,0,0,,Ежелгі уақыттан бері Сузу тек сурет пен кескіндемені жақсы көреді.
Dialogue: 0,1:02:26.86,1:02:29.12,Default,,0,0,0,,Бұл жай ғана бұлыңғыр.
Dialogue: 0,1:02:29.57,1:02:33.62,Default,,0,0,0,,Жарайды, ойланбасаң, мен сені үйге апарамын.
Dialogue: 0,1:02:34.04,1:02:36.12,Default,,0,0,0,,Хахаха... Уф!
Dialogue: 0,1:02:38.33,1:02:40.04,Default,,0,0,0,,Қиын болса да
Dialogue: 0,1:02:40.21,1:02:42.75,Default,,0,0,0,,«Suzu Suzu» лақтырылатын сөз сияқты.
Dialogue: 0,1:02:42.88,1:02:45.38,Default,,0,0,0,,Иә? Сонымен, мен оны қалай атауға болады?
Dialogue: 0,1:02:45.72,1:02:47.13,Default,,0,0,0,,Мүмкін бұл енді Урано емес шығар.
Dialogue: 0,1:02:47.59,1:02:48.68,Default,,0,0,0,,А...
Dialogue: 0,1:02:48.80,1:02:51.60,Default,,0,0,0,,Сузу-сан, теңізшілер зорлық көрсетті...
Dialogue: 0,1:02:51.72,1:02:52.64,Default,,0,0,0,,Уф
Dialogue: 0,1:02:52.85,1:02:56.14,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:02:56.89,1:02:59.15,Default,,0,0,0,,Хаха...
Dialogue: 0,1:02:59.40,1:03:01.27,Default,,0,0,0,,Содан соң…
Dialogue: 0,1:03:01.44,1:03:02.94,Default,,0,0,0,,Қызықты нәрсе бар ма?
Dialogue: 0,1:03:03.07,1:03:06.15,Default,,0,0,0,,Бұл күлкілі, сіз шынымен қалыптысыз.
Dialogue: 0,1:03:06.90,1:03:08.82,Default,,0,0,0,,Дәмді Иә Дәмді
Dialogue: 0,1:03:08.95,1:03:10.11,Default,,0,0,0,,Нашар картоп
Dialogue: 0,1:03:10.41,1:03:12.45,Default,,0,0,0,,Жұмақ Жұмақ
Dialogue: 0,1:03:12.70,1:03:14.99,Default,,0,0,0,,Әй, қаңылтырды да сал.
Dialogue: 0,1:03:15.12,1:03:15.83,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,1:03:15.83,1:03:16.41,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,1:03:15.83,1:03:16.41,Default,,0,0,0,,(Тетсудың ән айту дауысы)
Dialogue: 0,1:03:16.41,1:03:16.58,Default,,0,0,0,,(Тетсудың ән айту дауысы)
Dialogue: 0,1:03:16.58,1:03:18.79,Default,,0,0,0,,(Тетсудың ән айту дауысы)
Dialogue: 0,1:03:16.58,1:03:18.79,Default,,0,0,0,,Сузу-сан, шам қайда?
Dialogue: 0,1:03:18.79,1:03:18.92,Default,,0,0,0,,(Тетсудың ән айту дауысы)
Dialogue: 0,1:03:18.92,1:03:21.79,Default,,0,0,0,,(Тетсудың ән айту дауысы)
Dialogue: 0,1:03:18.92,1:03:21.79,Default,,0,0,0,,А, окопта екеніне сенімдімін.
Dialogue: 0,1:03:21.92,1:03:23.00,Default,,0,0,0,,Хоука
Dialogue: 0,1:03:24.17,1:03:26.71,Default,,0,0,0,,Харуми де болашақта теңізші болады.
Dialogue: 0,1:03:26.84,1:03:30.13,Default,,0,0,0,,О, дұрыс, иә.
Dialogue: 0,1:03:30.30,1:03:31.72,Default,,0,0,0,,Itadadakimasu
Dialogue: 0,1:03:31.84,1:03:33.05,Default,,0,0,0,,Сәлеметсіз бе?
Dialogue: 0,1:03:33.18,1:03:34.35,Default,,0,0,0,,Жарайды, тікелей іске кірісейік. Шинигамиңді Мисакиге де көрсет.
Dialogue: 0,1:03:34.47,1:03:36.68,Default,,0,0,0,,Хехе қайырлы түн
Dialogue: 0,1:03:37.73,1:03:40.60,Default,,0,0,0,,А, жер жақсы.
Dialogue: 0,1:03:40.73,1:03:42.77,Default,,0,0,0,,Ходжа Учиха
Dialogue: 0,1:03:43.31,1:03:45.90,Default,,0,0,0,,Жасыл жапырақтар қандай?
Dialogue: 0,1:03:46.11,1:03:48.90,Default,,0,0,0,,Мен Манилада жарақат алып, жаңа ғана оралдым.
Dialogue: 0,1:03:49.82,1:03:54.37,Default,,0,0,0,,Иә, бұл кеме болды, бірақ ол тағы да жақсы жұмыс істемеді немесе батып кетті.
Dialogue: 0,1:03:56.29,1:03:57.87,Default,,0,0,0,,Шусаку Ноу
Dialogue: 0,1:03:58.08,1:04:02.17,Default,,0,0,0,,Өлім кешігіп қалса, мазасыздану оңай.
Dialogue: 0,1:04:03.75,1:04:05.04,Default,,0,0,0,,Мизухара мырза
Dialogue: 0,1:04:05.17,1:04:09.09,Default,,0,0,0,,Әкем түнгі кезекшілікке қайта келмейді, сондықтан мен бүгін кешке үй басшысымын.
Dialogue: 0,1:04:09.55,1:04:13.34,Default,,0,0,0,,Кешіріңіз, бірақ мен сізді осында қалдыра алмаймын.
Dialogue: 0,1:04:16.47,1:04:18.68,Default,,0,0,0,,Иә? Осында?
Dialogue: 0,1:04:18.81,1:04:21.10,Default,,0,0,0,,Мен қораның екінші қабатында ұйықтап жатқанмын.
Dialogue: 0,1:04:21.52,1:04:23.35,Default,,0,0,0,,Жоқ, бұл сирек болатын.
Dialogue: 0,1:04:23.48,1:04:26.15,Default,,0,0,0,,Тіпті сен кейде өрескелсің.
Dialogue: 0,1:04:26.44,1:04:27.57,Default,,0,0,0,,(Масато) Сен көп жүгірдің, бірақ көп жағынан шегіңе жеткен жоқсың ба?
Dialogue: 0,1:04:27.69,1:04:31.24,Default,,0,0,0,,Қараңдар, якорьді киіңдер, мен оны өзіңмен бірге алып кетемін.
Dialogue: 0,1:04:31.36,1:04:34.95,Default,,0,0,0,,Жүр, жай сөйлесейік. Мен сені тағы көремін бе деп ойлаймын.
Dialogue: 0,1:04:50.38,1:04:52.30,Default,,0,0,0,,Мұнда келгенім үшін кешірім сұраймын.
Dialogue: 0,1:04:52.43,1:04:56.10,Default,,0,0,0,,Хаха... Аспалы еденмен салыстырғанда бұл жұмақ.
Dialogue: 0,1:04:56.43,1:05:00.27,Default,,0,0,0,,Қараңдаршы, үймелеу туралы айтсаң, суық. Аяғыңызды салыңыз.
Dialogue: 0,1:05:00.39,1:05:01.23,Default,,0,0,0,,Иә
Dialogue: 0,1:05:05.23,1:05:07.36,Default,,0,0,0,,Қараңдаршы, бұл кәдесый.
Dialogue: 0,1:05:07.73,1:05:08.57,Default,,0,0,0,,Иә
Dialogue: 0,1:05:11.65,1:05:13.45,Default,,0,0,0,,Сіз қаламсапта өмір сүргіңіз келе ме?
Dialogue: 0,1:05:15.32,1:05:16.45,Default,,0,0,0,,Жарайды
Dialogue: 0,1:05:24.29,1:05:26.25,Default,,0,0,0,,Уау, жаза аламын, жаза аламын (Философия) Жаза аламын.
Dialogue: 0,1:05:27.13,1:05:29.67,Default,,0,0,0,,Бұл құтанға ұқсайды, бірақ мен оны кездестірдім...
Dialogue: 0,1:05:29.80,1:05:31.71,Default,,0,0,0,,Оңтүстік теңізі Джаттакену
Dialogue: 0,1:05:31.88,1:05:34.18,Default,,0,0,0,,Құтырандар теңізден өте ме?
Dialogue: 0,1:05:34.51,1:05:37.22,Default,,0,0,0,,Ноу Эба жыл бойы.
Dialogue: 0,1:05:37.43,1:05:39.47,Default,,0,0,0,,Маған өзен жағасында тұру ғана қалды.
Dialogue: 0,1:05:40.35,1:05:43.06,Default,,0,0,0,,Әй, Еба, сен өте жақсысың!
Dialogue: 0,1:05:43.64,1:05:47.48,Default,,0,0,0,,А... Мен оны өзім қалағандай сала алмайтын сияқтымын.
Dialogue: 0,1:05:48.27,1:05:50.44,Default,,0,0,0,,Сізде де осындай кездер бола ма?
Dialogue: 0,1:05:51.48,1:05:55.03,Default,,0,0,0,,Мүмкін біраз уақыт өткен шығар? Сурет - бұл
Dialogue: 0,1:05:55.20,1:05:56.20,Default,,0,0,0,,Жақсы
Dialogue: 0,1:05:58.03,1:06:01.45,Default,,0,0,0,,Сол сурет, толқындағы қоян
Dialogue: 0,1:06:02.12,1:06:03.75,Default,,0,0,0,,О, бұл
Dialogue: 0,1:06:04.58,1:06:06.96,Default,,0,0,0,,Одан кейін қиын болды.
Dialogue: 0,1:06:07.21,1:06:09.50,Default,,0,0,0,,Не? Солай ма?
Dialogue: 0,1:06:10.00,1:06:12.05,Default,,0,0,0,,Сіз ұмыттыңыз ба? иә?
Dialogue: 0,1:06:12.25,1:06:16.01,Default,,0,0,0,,Менің мұғалімім бұл суретті Хиросимадағы байқауға жіберді.
Dialogue: 0,1:06:16.13,1:06:20.85,Default,,0,0,0,,Мен ол жерде ең жақсы беделге ие болдым, бұл мені қатты алаңдатты.
Dialogue: 0,1:06:21.64,1:06:24.27,Default,,0,0,0,,Мен не салдым
Dialogue: 0,1:06:24.73,1:06:27.77,Default,,0,0,0,,Нағыз несие сізге беріледі.
Dialogue: 0,1:06:27.90,1:06:28.98,Default,,0,0,0,,Хэхе…
Dialogue: 0,1:06:29.77,1:06:30.61,Default,,0,0,0,,Ха…
Dialogue: 0,1:06:37.20,1:06:39.32,Default,,0,0,0,,Сузу жылы
Dialogue: 0,1:06:39.70,1:06:41.74,Default,,0,0,0,,Қалайы жұмсақ
Dialogue: 0,1:06:41.87,1:06:43.20,Default,,0,0,0,,Тәтті мұрын
Dialogue: 0,1:06:47.16,1:06:48.37,Default,,0,0,0,,Мизухара мырза
Dialogue: 0,1:06:50.00,1:06:53.30,Default,,0,0,0,,Мен осындай күнді көптен күткен сияқтымын.
Dialogue: 0,1:06:54.34,1:06:56.63,Default,,0,0,0,,Сен осылай келдің
Dialogue: 0,1:06:57.59,1:06:59.72,Default,,0,0,0,,Осылай жанымда болсаң да
Dialogue: 0,1:07:00.18,1:07:01.35,Default,,0,0,0,,Біз...
Dialogue: 0,1:07:01.47,1:07:02.30,Default,,0,0,0,,Ах!
Dialogue: 0,1:07:03.06,1:07:07.02,Default,,0,0,0,,Шынымды айтсам, саған ренжімей тұра алмаймын.
Dialogue: 0,1:07:07.73,1:07:10.94,Default,,0,0,0,,Кешіріңіз, шынымен кешіріңіз.
Dialogue: 0,1:07:11.86,1:07:15.23,Default,,0,0,0,,Сізге ол адам ұнайды.
Dialogue: 0,1:07:15.94,1:07:16.90,Default,,0,0,0,,Иә
Dialogue: 0,1:07:17.74,1:07:21.32,Default,,0,0,0,,А, бұл қалыпты жағдай
Dialogue: 0,1:07:21.45,1:07:22.28,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:07:22.41,1:07:24.95,Default,,0,0,0,,Бұл анық нәрсеге ашуланған сияқты...
Dialogue: 0,1:07:25.08,1:07:27.25,Default,,0,0,0,,Белгілі себептермен кешірім сұрау
Dialogue: 0,1:07:28.21,1:07:30.33,Default,,0,0,0,,Мені үйге апара алмайтыныңызға сенімдісіз бе?
Dialogue: 0,1:07:30.62,1:07:33.54,Default,,0,0,0,,Маған амалсыз күйеуге шыққаның үшін қиналғаның дұрыс емес пе?
Dialogue: 0,1:07:34.00,1:07:35.09,Default,,0,0,0,,Жоқ
Dialogue: 0,1:07:35.42,1:07:37.55,Default,,0,0,0,,Сонда иә хаха...
Dialogue: 0,1:07:39.13,1:07:41.05,Default,,0,0,0,,4-сынып
Dialogue: 0,1:07:41.64,1:07:42.89,Default,,0,0,0,,Шусаку мырза?
Dialogue: 0,1:07:43.01,1:07:45.35,Default,,0,0,0,,Ол менің қайтыс болған ағаммен құрдас.
Dialogue: 0,1:07:46.64,1:07:48.23,Default,,0,0,0,,Біз кедей едік...
Dialogue: 0,1:07:48.35,1:07:51.77,Default,,0,0,0,,Менің ағам Әскери-теңіз академиясына тегін түсті.
Dialogue: 0,1:07:52.15,1:07:55.27,Default,,0,0,0,,Менің ағам жаңа ғана қайтыс болды. Мен флотқа қосылдым.
Dialogue: 0,1:07:56.03,1:07:58.15,Default,,0,0,0,,Мұның бәрі ақылға қонымды ...
Dialogue: 0,1:07:58.28,1:08:02.66,Default,,0,0,0,,Мен адамдар үшін нормадан қай жерде қалып қойдым деп ойлаймын.
Dialogue: 0,1:08:03.74,1:08:08.50,Default,,0,0,0,,Джейк, мен мұнда кәдімгі Сузуды көріп, жеңілдеп қалдым.
Dialogue: 0,1:08:08.95,1:08:11.83,Default,,0,0,0,,Мен сені батырлық рух деп айтудан бас тартамын.
Dialogue: 0,1:08:12.33,1:08:15.75,Default,,0,0,0,,Мені еске алсаң, күліп еске ал.
Dialogue: 0,1:08:16.63,1:08:22.76,Default,,0,0,0,,Осы дүниеде соңына дейін қалыпты және әдепті болып қалыңыз.
Dialogue: 0,1:08:23.01,1:08:24.43,Default,,0,0,0,,Сузу Иә?
Dialogue: 0,1:08:24.55,1:08:26.35,Default,,0,0,0,,Сіз беппин болдыңыз.
Dialogue: 0,1:08:26.85,1:08:28.10,Default,,0,0,0,,Сен ақымақсың ба?
Dialogue: 0,1:08:28.22,1:08:30.39,Default,,0,0,0,,Ахах... хаха...
Dialogue: 0,1:08:30.85,1:08:34.48,Default,,0,0,0,,Мен сені жас кезімнен білемін.
Dialogue: 0,1:08:34.69,1:08:37.73,Default,,0,0,0,,Маңызды нәрселерді айта алмайтын әдетім бар.
Dialogue: 0,1:08:38.86,1:08:43.11,Default,,0,0,0,,Қазірдің өзінде біз ұзақ ғұмыр сыйлаған пендені қабылдадық...
Dialogue: 0,1:08:46.95,1:08:48.45,Default,,0,0,0,,Хаа…
Dialogue: 0,1:08:48.83,1:08:50.62,Default,,0,0,0,,Қош келдіңіз аға
Dialogue: 0,1:08:51.33,1:08:55.42,Default,,0,0,0,,Дегенмен, сүйекті алмастыратын жалғыз тас дегеніміз не?
Dialogue: 0,1:08:55.71,1:08:57.50,Default,,0,0,0,,Суми-чан өте кішкентай...
Dialogue: 0,1:08:57.63,1:09:00.30,Default,,0,0,0,,Үлкен ағаның миы?
Dialogue: 0,1:09:00.97,1:09:02.88,Default,,0,0,0,,Мен жаңа ғана қате айттым...
Dialogue: 0,1:09:03.01,1:09:04.59,Default,,0,0,0,,Сіз кімсіз?
Dialogue: 0,1:09:05.72,1:09:08.43,Default,,0,0,0,,Суықта шақыру ақымақ сияқты
Dialogue: 0,1:09:08.56,1:09:11.10,Default,,0,0,0,,Қызық, әлгі Йоичи оңай өледі ме?
Dialogue: 0,1:09:12.35,1:09:14.81,Default,,0,0,0,,Кенет адамдар жоғалып кетеді.
Dialogue: 0,1:09:15.23,1:09:20.11,Default,,0,0,0,,Мені енді көре алмасаң, сөзім саған жетпейді.
Dialogue: 0,1:09:22.03,1:09:23.11,Default,,0,0,0,,Шусаку-сан
Dialogue: 0,1:09:24.57,1:09:27.91,Default,,0,0,0,,Өткен күн үшін көп рахмет.
Dialogue: 0,1:09:28.03,1:09:29.03,Default,,0,0,0,,Иә?
Dialogue: 0,1:09:29.24,1:09:32.75,Default,,0,0,0,,Мизухара-санмен сөйлесуге уақытым таусылып жатыр.
Dialogue: 0,1:09:33.79,1:09:34.79,Default,,0,0,0,,Жоқ…
Dialogue: 0,1:09:35.46,1:09:38.63,Default,,0,0,0,,Шусаку Хойде, ерлі-зайыптылар осындай ма?
Dialogue: 0,1:09:41.09,1:09:44.38,Default,,0,0,0,,Мен мұны істей алмаймын десем де, әйеліңізден сұрау керек.
Dialogue: 0,1:09:46.30,1:09:49.89,Default,,0,0,0,,Маған көрсетпесең де ашулы жүзің бар.
Dialogue: 0,1:09:50.22,1:09:52.89,Default,,0,0,0,,Жарайды... Енді көретіндеріңізге сенімдімін.
Dialogue: 0,1:09:53.02,1:09:54.81,Default,,0,0,0,,Мен толықтай жазылып кеттім! (Косей) Оу!
Dialogue: 0,1:09:54.94,1:09:57.44,Default,,0,0,0,,О, мен сенің ашуланатыныңды білмедім.
Dialogue: 0,1:09:57.56,1:09:59.90,Default,,0,0,0,,Бұл алаңдаушылық!
Dialogue: 0,1:10:00.02,1:10:01.07,Default,,0,0,0,,О...
Dialogue: 0,1:10:02.90,1:10:06.20,Default,,0,0,0,,Әй, бүгін ғана, тозған шұлықтарыңды алып кетесің бе?
Dialogue: 0,1:10:06.57,1:10:09.87,Default,,0,0,0,,Сузу-сан өзі жөндеп жатқан утанға аяғын баса алмай қалды.
Dialogue: 0,1:10:09.99,1:10:11.54,Default,,0,0,0,,Басқалары да бар.
Dialogue: 0,1:10:11.66,1:10:15.29,Default,,0,0,0,,Енді екеуің төбелесесіңдер ме?
Dialogue: 0,1:10:16.92,1:10:19.17,Default,,0,0,0,,Мен тағы да дұрыс емес жолмен келе жатырмын, сондықтан осы жолмен кел!
Dialogue: 0,1:10:19.29,1:10:20.96,Default,,0,0,0,,Мен түсіндім.
Dialogue: 0,1:10:21.17,1:10:24.47,Default,,0,0,0,,Біз сол жерде, Хайгамин бағытындамыз.
Dialogue: 0,1:10:24.59,1:10:26.05,Default,,0,0,0,,Түсіндім!
Dialogue: 0,1:10:29.47,1:10:32.81,Default,,0,0,0,,Сол қыста қар көп жауды...
Dialogue: 0,1:10:33.60,1:10:35.60,Default,,0,0,0,,Көктемді күте алмадым.
Dialogue: 0,1:10:36.73,1:10:40.56,Default,,0,0,0,,♪ «Аспандағы Құдай сарбазы»
Dialogue: 0,1:10:57.21,1:10:59.83,Default,,0,0,0,,~♪
Dialogue: 0,1:11:00.42,1:11:02.29,Default,,0,0,0,,Аха, не болды?
Dialogue: 0,1:11:02.59,1:11:06.59,Default,,0,0,0,,Харуми-сан, тыныш болшы. Мұғалім де саған ұрысып жатқан жоқ.
Dialogue: 0,1:11:07.09,1:11:10.22,Default,,0,0,0,,Шынымен бе? Мектептен қорықпайсың ба?
Dialogue: 0,1:11:10.34,1:11:12.97,Default,,0,0,0,,Иә, қазір достарым болмаса да.
Dialogue: 0,1:11:13.22,1:11:16.85,Default,,0,0,0,,Қарашы, мен мұнда келгенде жалғыз қалдым.
Dialogue: 0,1:11:16.98,1:11:19.73,Default,,0,0,0,,Барлығы бірден тіл табысып кетті.
Dialogue: 0,1:11:20.06,1:11:21.19,Default,,0,0,0,,Менің анам да?
Dialogue: 0,1:11:21.19,1:11:21.69,Default,,0,0,0,,Менің анам да?
Dialogue: 0,1:11:21.19,1:11:21.69,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,1:11:21.69,1:11:21.94,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,1:11:21.94,1:11:22.77,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,1:11:21.94,1:11:22.77,Default,,0,0,0,,Ах...
Dialogue: 0,1:11:22.77,1:11:22.90,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,1:11:22.90,1:11:25.65,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,1:11:22.90,1:11:25.65,Default,,0,0,0,,Иә? Эх...
Dialogue: 0,1:11:27.86,1:11:28.70,Default,,0,0,0,,Иә?
Dialogue: 0,1:11:28.82,1:11:33.66,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,1:11:34.54,1:11:38.41,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,1:11:38.91,1:11:43.92,Default,,0,0,0,,(Труба дыбысы)
Dialogue: 0,1:11:48.59,1:11:53.60,Default,,0,0,0,,(Соғыс ұшағы дыбысы)
Dialogue: 0,1:11:55.18,1:11:58.14,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:12:00.94,1:12:01.81,Default,,0,0,0,,Ах
Dialogue: 0,1:12:02.73,1:12:04.19,Default,,0,0,0,,(мылтық дыбысы)
Dialogue: 0,1:12:12.74,1:12:15.08,Default,,0,0,0,,А, әуе шабуылы капоты
Dialogue: 0,1:12:15.78,1:12:17.49,Default,,0,0,0,,Ух... Харуми-чан
Dialogue: 0,1:12:19.87,1:12:21.37,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:12:30.26,1:12:33.51,Default,,0,0,0,,Уау... Уау...
Dialogue: 0,1:12:38.68,1:12:39.89,Default,,0,0,0,,Ах...
Dialogue: 0,1:12:40.68,1:12:43.81,Default,,0,0,0,,Егер менде қазір бояу болса
Dialogue: 0,1:12:44.52,1:12:48.40,Default,,0,0,0,,...Біз тіпті не туралы ойлап жатырмыз?
Dialogue: 0,1:12:49.32,1:12:50.28,Default,,0,0,0,,Маңызы бар деп саналатын бір куәгерлік көрсету бар
Dialogue: 0,1:12:50.82,1:12:52.07,Default,,0,0,0,,Сіз не істеп жатырсыз?
Dialogue: 0,1:12:52.32,1:12:54.32,Default,,0,0,0,,Көлеңкеге түс, тез жат.
Dialogue: 0,1:12:54.49,1:12:55.62,Default,,0,0,0,,(Дабыл)
Dialogue: 0,1:12:55.74,1:12:57.33,Default,,0,0,0,,Қайтадан қош келдіңіз
Dialogue: 0,1:12:59.20,1:13:02.66,Default,,0,0,0,,Әй, қазір әуе шабуылы туралы ескерту бар.
Dialogue: 0,1:13:03.25,1:13:06.25,Default,,0,0,0,,Тыныш қалмаңыз, сізге снаряд сынықтары түседі.
Dialogue: 0,1:13:20.06,1:13:21.23,Default,,0,0,0,,Цезарь Цеппели
Dialogue: 0,1:13:24.40,1:13:27.15,Default,,0,0,0,,Дыбыс туралы не айтуға болады?
Dialogue: 0,1:13:27.52,1:13:31.24,Default,,0,0,0,,Біздің 2000 ат күшіміз қатты дыбыс шығарады.
Dialogue: 0,1:13:31.82,1:13:34.53,Default,,0,0,0,,Күндіз-түні зауыттарда жұмыс істейміз...
Dialogue: 0,1:13:34.66,1:13:37.28,Default,,0,0,0,,Оны аяқтау үшін кірістіріп алайық.
Dialogue: 0,1:13:37.74,1:13:39.03,Default,,0,0,0,,Хаа…
Dialogue: 0,1:13:39.74,1:13:44.21,Default,,0,0,0,,91 500 ат күші түрінен бастап, біз осы уақытқа дейін жеттік.
Dialogue: 0,1:13:46.29,1:13:51.76,Default,,0,0,0,,♪ Жұмыс істеп жатқан дағдыға жабысып қалу
Dialogue: 0,1:13:52.71,1:13:56.64,Default,,0,0,0,,♪ Дүние жүзіндегі бейбітшілік нұры
Dialogue: 0,1:13:59.14,1:14:02.43,Default,,0,0,0,,♪ Бар күшіңізбен шоғырланыңыз
Dialogue: 0,1:14:02.56,1:14:05.48,Default,,0,0,0,,Әй, жаудың қанша ат күші бар?
Dialogue: 0,1:14:07.56,1:14:10.57,Default,,0,0,0,,Әй, жаудың қанша ат күші бар... (құлаған дыбыс)
Dialogue: 0,1:14:10.77,1:14:11.98,Default,,0,0,0,,Қайын ата!?
Dialogue: 0,1:14:12.65,1:14:14.40,Default,,0,0,0,,(оқ ату)
Dialogue: 0,1:14:16.61,1:14:20.37,Default,,0,0,0,,Әуе шабуылы туралы ескерту жойылды
Dialogue: 0,1:14:20.74,1:14:23.87,Default,,0,0,0,,(Судзу мен Харумидің жылауы)
Dialogue: 0,1:14:24.00,1:14:26.71,Default,,0,0,0,,Дұрыс, түнгі кезекшілік аяқталды. Бұл сондай көңілді.
Dialogue: 0,1:14:26.83,1:14:30.96,Default,,0,0,0,,Әуе шабуылы кезінде сіз жерде тыныш ұйықтадыңыз...
Dialogue: 0,1:14:31.09,1:14:32.30,Default,,0,0,0,,Енді, енді.
Dialogue: 0,1:14:32.46,1:14:34.26,Default,,0,0,0,,Мен таң қалдым.
Dialogue: 0,1:14:34.38,1:14:37.22,Default,,0,0,0,,Сол күні Күреден балық ауланды.
Dialogue: 0,1:14:37.34,1:14:38.80,Default,,0,0,0,,Чисса
Dialogue: 0,1:14:38.97,1:14:41.93,Default,,0,0,0,,Суретке үлкен нәрсе салсаңыз, ол үлкен болады.
Dialogue: 0,1:14:42.06,1:14:43.72,Default,,0,0,0,,(күлкі)
Dialogue: 0,1:14:43.85,1:14:47.73,Default,,0,0,0,,(Дабыл)
Dialogue: 0,1:14:47.94,1:14:49.77,Default,,0,0,0,,Дабыл беру Дабыл беру
Dialogue: 0,1:14:49.94,1:14:53.90,Default,,0,0,0,,Әуе қорғанысы киімдері Өрт сөндіру Есіктерді және жылжымалы есіктерді алыңыз
Dialogue: 0,1:14:54.03,1:14:57.78,Default,,0,0,0,,Жоғарыда айтылғандарды орындағаннан кейін, апаттық сөмкеңізді алып, әуе шабуылына қарсы панаханаға барыңыз.
Dialogue: 0,1:14:59.11,1:15:02.83,Default,,0,0,0,,Әуе шабуылы туралы ескерту жойылды
Dialogue: 0,1:15:04.54,1:15:07.37,Default,,0,0,0,,Уф, шикі қайнатылған.
Dialogue: 0,1:15:07.54,1:15:09.58,Default,,0,0,0,,Мен өзімді ауыр сезінемін.
Dialogue: 0,1:15:09.71,1:15:12.17,Default,,0,0,0,,Күйеуіңіз шайқаста қаза болса да.
Dialogue: 0,1:15:12.29,1:15:15.13,Default,,0,0,0,,Бұл жолы мен 17 жасар баламды жібермеймін.
Dialogue: 0,1:15:15.26,1:15:17.09,Default,,0,0,0,,Неге… неге мен
Dialogue: 0,1:15:17.22,1:15:19.97,Default,,0,0,0,,(Дабыл)
Dialogue: 0,1:15:21.85,1:15:24.60,Default,,0,0,0,,Әуе қорғанысы киімдерін дайындап, өртті сөндір.
Dialogue: 0,1:15:24.72,1:15:26.27,Default,,0,0,0,,Есіктерді және жылжымалы есіктерді алу
Dialogue: 0,1:15:26.39,1:15:27.73,Default,,0,0,0,,Әуе қорғанысы құралдары... А! (Шусаку) Атта!
Dialogue: 0,1:15:28.64,1:15:30.94,Default,,0,0,0,,Енді көру мүмкін емес тым қараңғы
Dialogue: 0,1:15:31.06,1:15:32.15,Default,,0,0,0,,Атта
Dialogue: 0,1:15:32.27,1:15:33.98,Default,,0,0,0,,Әй, кешіріңіз.
Dialogue: 0,1:15:34.48,1:15:36.24,Default,,0,0,0,,Қандай мысық?
Dialogue: 0,1:15:36.65,1:15:39.45,Default,,0,0,0,,(Дабыл)
Dialogue: 0,1:15:39.57,1:15:40.45,Default,,0,0,0,,Хмм.
Dialogue: 0,1:15:41.37,1:15:42.20,Default,,0,0,0,,
Dialogue: 0,1:15:42.32,1:15:44.41,Default,,0,0,0,,Ескерту Мен одан шаршадым
Dialogue: 0,1:15:44.74,1:15:47.25,Default,,0,0,0,,
Dialogue: 0,1:15:58.72,1:16:00.47,Default,,0,0,0,,бәлкім, осы ғана шығар
Dialogue: 0,1:16:06.27,1:16:08.60,Default,,0,0,0,,(Ысырма дыбысы)
Dialogue: 0,1:16:11.94,1:16:15.86,Default,,0,0,0,,Hitomaru Yongsan Enemy ұшағы 17 үлкен ұшақ
Dialogue: 0,1:16:15.98,1:16:18.74,Default,,0,0,0,,Фукуяма үстіндегі артиллериялық шайқас кезінде
Dialogue: 0,1:16:18.86,1:16:23.20,Default,,0,0,0,,Кейінгі мақсат: Токусима префектурасының оңтүстік-шығысында 30 ұшақ
Dialogue: 0,1:16:23.32,1:16:25.45,Default,,0,0,0,,Күреге қарай бет алды
Dialogue: 0,1:16:27.04,1:16:30.83,Default,,0,0,0,,Әуе шабуылы туралы ескерту жойылды
Dialogue: 0,1:16:31.29,1:16:32.46,Default,,0,0,0,,Маған жеңіл қарама
Dialogue: 0,1:16:32.58,1:16:36.63,Default,,0,0,0,,5-і күні таңертең жаудың 125 ірі ұшағы шабуылға шықты.
Dialogue: 0,1:16:36.88,1:16:39.92,Default,,0,0,0,,Хиро Арсенал және 11 әуе күштері...
Dialogue: 0,1:16:40.05,1:16:41.63,Default,,0,0,0,,Мен үйдемін
Dialogue: 0,1:16:42.01,1:16:44.68,Default,,0,0,0,,А, жақсысың деп үміттенемін, Шусаку.
Dialogue: 0,1:16:44.80,1:16:46.10,Default,,0,0,0,,Әкем ше?
Dialogue: 0,1:16:46.76,1:16:48.47,Default,,0,0,0,,Жоқ, әлі жоқ...
Dialogue: 0,1:16:48.60,1:16:49.73,Default,,0,0,0,,Хоука
Dialogue: 0,1:16:53.35,1:16:55.90,Default,,0,0,0,,Сузу-сан шашу
Dialogue: 0,1:16:56.44,1:16:57.32,Default,,0,0,0,,Ах
Dialogue: 0,1:16:58.44,1:16:59.57,Default,,0,0,0,,Ах...
Dialogue: 0,1:17:05.07,1:17:07.41,Default,,0,0,0,,Сузу-сан - Комайноу
Dialogue: 0,1:17:10.70,1:17:12.83,Default,,0,0,0,,Тұрсаңыз да
Dialogue: 0,1:17:12.96,1:17:15.21,Default,,0,0,0,,О... не?
Dialogue: 0,1:17:15.33,1:17:16.54,Default,,0,0,0,,Қолыңды тигізбе…
Dialogue: 0,1:17:16.92,1:17:19.00,Default,,0,0,0,,Уайымдамаңыз, жай ғана бұл туралы сөйлесіңіз.
Dialogue: 0,1:17:31.93,1:17:34.81,Default,,0,0,0,,Жарайды, әке, мен сенімдімін.
Dialogue: 0,1:17:34.94,1:17:37.02,Default,,0,0,0,,Әскери киім, иә?
Dialogue: 0,1:17:37.73,1:17:39.52,Default,,0,0,0,,Фурошики мазмұны
Dialogue: 0,1:17:40.61,1:17:44.24,Default,,0,0,0,,15-ші жағдай бойынша заң бойынша жеке бірінші сыныпқа айналды.
Dialogue: 0,1:17:44.74,1:17:48.20,Default,,0,0,0,,Енді сіз солдатсыз, теңіз жаяу әскерінде оқудан өтесіз.
Dialogue: 0,1:17:48.58,1:17:49.95,Default,,0,0,0,,Наурыз қайтып оралмайды
Dialogue: 0,1:17:51.12,1:17:54.29,Default,,0,0,0,,Осыдан кейін қайтып келе аласыз ба?
Dialogue: 0,1:17:54.41,1:17:55.42,Default,,0,0,0,,Егер бұл операция сәтті өтсе,
Dialogue: 0,1:17:56.46,1:17:58.63,Default,,0,0,0,,Жақсысың ба, Сузу-сан?
Dialogue: 0,1:17:59.17,1:18:01.46,Default,,0,0,0,,Мен суықпын және арықпын
Dialogue: 0,1:18:01.59,1:18:05.93,Default,,0,0,0,,Адам қалмады, сондықтан бізді қорғай алар ма екен деп ойлаймын.
Dialogue: 0,1:18:06.76,1:18:09.97,Default,,0,0,0,,Бұл мүмкін емес. Мүлдем мүмкін емес!
Dialogue: 0,1:18:15.52,1:18:18.23,Default,,0,0,0,,Кешіріңіз, бұл өтірік.
Dialogue: 0,1:18:19.31,1:18:21.15,Default,,0,0,0,,Мен сені жақсы көремін
Dialogue: 0,1:18:21.94,1:18:26.11,Default,,0,0,0,,Наурызда сені қайта көрмесем, жүзіңді ұмытуым мүмкін.
Dialogue: 0,1:18:26.78,1:18:28.03,Default,,0,0,0,,Сузу-сан
Dialogue: 0,1:18:28.20,1:18:30.24,Default,,0,0,0,,Джейк, мен сені осы үйде күтемін.
Dialogue: 0,1:18:30.58,1:18:34.96,Default,,0,0,0,,Мен бұл үйден Ран мен Шусакуды таба алмайтын шығармын.
Dialogue: 0,1:18:54.52,1:18:56.35,Default,,0,0,0,,Егер сіз сурет салсаңыз, оны ұмытасыз ба?
Dialogue: 0,1:18:56.48,1:18:58.98,Default,,0,0,0,,А, иә, астарлы әңгімеде.
Dialogue: 0,1:18:59.10,1:19:01.61,Default,,0,0,0,,Жоқ, Сузу-сан түсінбейді.
Dialogue: 0,1:19:02.02,1:19:04.57,Default,,0,0,0,,Оның суретін қаншалықты әдемі етіп салдың?
Dialogue: 0,1:19:04.69,1:19:05.86,Default,,0,0,0,,Икен Икен
Dialogue: 0,1:19:05.99,1:19:08.16,Default,,0,0,0,,Бұл маңызды құпия.
Dialogue: 0,1:19:22.50,1:19:24.00,Default,,0,0,0,,Мен барамын.
Dialogue: 0,1:19:25.84,1:19:27.17,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,1:19:28.26,1:19:30.76,Default,,0,0,0,,Шусаку, жарты жолда бірге барайық.
Dialogue: 0,1:19:30.89,1:19:31.72,Default,,0,0,0,,О
Dialogue: 0,1:19:32.26,1:19:34.01,Default,,0,0,0,,Әскери киімдер әдемі.
Dialogue: 0,1:19:36.22,1:19:40.31,Default,,0,0,0,,Үй кенеттен үлкейіп кеткендей.
Dialogue: 0,1:19:41.48,1:19:43.02,Default,,0,0,0,,Хаа ха...
Dialogue: 0,1:19:45.40,1:19:47.36,Default,,0,0,0,,Ходжо мырзаға (Кейко) Иә?
Dialogue: 0,1:19:47.74,1:19:51.62,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,1:19:53.99,1:19:58.25,Default,,0,0,0,,Мен бұл өте үлкен өзара көмек көрсету ауруханасы деп ойладым.
Dialogue: 0,1:19:58.37,1:20:00.67,Default,,0,0,0,,Мен оны таба алмағаным таңқаларлық емес.
Dialogue: 0,1:20:00.92,1:20:03.54,Default,,0,0,0,,Іші мен басынан соққы алған сияқты.
Dialogue: 0,1:20:03.84,1:20:05.63,Default,,0,0,0,,Мен ауруханадан шыға жаздадым.
Dialogue: 0,1:20:07.38,1:20:10.38,Default,,0,0,0,,Әкем сағатын жөндеуімді өтінді.
Dialogue: 0,1:20:10.97,1:20:15.93,Default,,0,0,0,,Иә, бұл мүмкіндік, сондықтан мен Шимоносекидегі Куромура Нгатаға баруды ойлап жүрмін.
Dialogue: 0,1:20:16.22,1:20:17.18,Default,,0,0,0,,Тіпті ертең
Dialogue: 0,1:20:18.52,1:20:20.23,Default,,0,0,0,,Не? Ағаңмен барасың ба?
Dialogue: 0,1:20:20.35,1:20:21.69,Default,,0,0,0,,Дайындық
Dialogue: 0,1:20:21.94,1:20:22.98,Default,,0,0,0,,Харуми де?
Dialogue: 0,1:20:25.15,1:20:26.07,Default,,0,0,0,,(Цубаки) Шынын айтсам, мен оның бармағанын қалаймын.
Dialogue: 0,1:20:26.19,1:20:30.15,Default,,0,0,0,,Иә, иә, ол жерге барсаң да, топырақпен ойнап, гимнастикамен айналысасың.
Dialogue: 0,1:20:30.99,1:20:35.20,Default,,0,0,0,,♪ «Жеңіс күніне дейін»
Dialogue: 0,1:20:41.67,1:20:44.29,Default,,0,0,0,,Аа, бұл көп уақытты алады.
Dialogue: 0,1:20:44.46,1:20:45.54,Default,,0,0,0,,Хаа…
Dialogue: 0,1:20:45.67,1:20:46.75,Default,,0,0,0,,Мен билет сатып аламын.
Dialogue: 0,1:20:46.88,1:20:49.71,Default,,0,0,0,,Сіз Харумиді әкесіне апара аласыз ба?
Dialogue: 0,1:20:49.84,1:20:50.51,Default,,0,0,0,,Мені тыңда!
Dialogue: 0,1:20:50.63,1:20:53.39,Default,,0,0,0,,Эй, кеттік, Харуми-чан.
Dialogue: 0,1:20:53.51,1:20:55.72,Default,,0,0,0,,Мен флотқа қосыла аламын ба?
Dialogue: 0,1:20:55.85,1:20:56.89,Default,,0,0,0,,Иә...
Dialogue: 0,1:20:59.43,1:21:01.06,Default,,0,0,0,,Неге сонша аю?
Dialogue: 0,1:21:01.23,1:21:04.02,Default,,0,0,0,,Төтенше жағдайда сізде мақтанатын бамбук найзасы бар.
Dialogue: 0,1:21:04.15,1:21:07.27,Default,,0,0,0,,Сен ақымақсың ба? Ата-анаң қорқса, басқаша.
Dialogue: 0,1:21:07.86,1:21:10.32,Default,,0,0,0,,Жоқ, мен өзімді жақсы сезінбеймін.
Dialogue: 0,1:21:10.44,1:21:12.49,Default,,0,0,0,,Дәлірек айтсақ, бамбук найзасымен...
Dialogue: 0,1:21:13.07,1:21:15.12,Default,,0,0,0,,Шимоносеки алыс па?
Dialogue: 0,1:21:15.37,1:21:16.28,Default,,0,0,0,,Иә
Dialogue: 0,1:21:16.41,1:21:18.16,Default,,0,0,0,,Хиросимадан алыс па?
Dialogue: 0,1:21:18.29,1:21:19.41,Default,,0,0,0,,Бұл өте алыс
Dialogue: 0,1:21:19.54,1:21:20.62,Default,,0,0,0,,Мелло
Dialogue: 0,1:21:20.75,1:21:23.00,Default,,0,0,0,,Ауруханаға бару керек.
Dialogue: 0,1:21:23.83,1:21:28.09,Default,,0,0,0,,(музыканы жазу)
Dialogue: 0,1:21:28.21,1:21:30.13,Default,,0,0,0,,Дұшпандық музыканы айтасыз ба? (Сержант) Ш.
Dialogue: 0,1:21:30.26,1:21:32.42,Default,,0,0,0,,Сіз уайымдадыңыз.
Dialogue: 0,1:21:32.63,1:21:36.47,Default,,0,0,0,,Мен көптен бері ес-түссіз жатырмын, маусым айы да болды.
Dialogue: 0,1:21:36.60,1:21:38.39,Default,,0,0,0,,Бұл бәрінен де артық болды.
Dialogue: 0,1:21:38.68,1:21:42.06,Default,,0,0,0,,Харуми, мен пойызға мініп, ағаммен барамын.
Dialogue: 0,1:21:42.23,1:21:44.98,Default,,0,0,0,,Неғұрлым тезірек болса, соғұрлым жақсы.
Dialogue: 0,1:21:45.10,1:21:47.86,Default,,0,0,0,,Әй, сен қандай кемеге міндің?
Dialogue: 0,1:21:47.98,1:21:50.11,Default,,0,0,0,,№16 мина іздеуші арнайы катер
Dialogue: 0,1:21:50.53,1:21:51.90,Default,,0,0,0,,Хмм.
Dialogue: 0,1:21:52.65,1:21:55.82,Default,,0,0,0,,Мұнда келсеңіз, көп нәрсені үйренесіз.
Dialogue: 0,1:21:56.24,1:21:58.12,Default,,0,0,0,,Гуанчжоу да жабылды.
Dialogue: 0,1:21:58.24,1:22:02.29,Default,,0,0,0,,Сондай-ақ Әскери-теңіз күштерінің өзі армияға сіңеді деген қауесет бар.
Dialogue: 0,1:22:02.75,1:22:05.79,Default,,0,0,0,,Сузу-сан, Ямато батып кеткен сияқты.
Dialogue: 0,1:22:05.92,1:22:07.04,Default,,0,0,0,,Ямато?
Dialogue: 0,1:22:07.17,1:22:12.09,Default,,0,0,0,,Әй, мен бұрышқа тығылып жаудың алдына шықтым.
Dialogue: 0,1:22:12.96,1:22:17.14,Default,,0,0,0,,Теңізімізде мөңірей берсін.
Dialogue: 0,1:22:17.39,1:22:20.93,Default,,0,0,0,,Ей, толқындағы қоян әлдеқашан...
Dialogue: 0,1:22:21.06,1:22:22.89,Default,,0,0,0,,Иә? Жоқ
Dialogue: 0,1:22:23.02,1:22:25.35,Default,,0,0,0,,Джейк, мен айттым.
Dialogue: 0,1:22:25.89,1:22:30.02,Default,,0,0,0,,Куромураның ата-анасына мен Харумиді эвакуациялауды өтіндім.
Dialogue: 0,1:22:30.23,1:22:32.61,Default,,0,0,0,,Мен бұл жерден өзімді қауіпсіз сезінемін.
Dialogue: 0,1:22:33.90,1:22:35.20,Default,,0,0,0,,Сонымен, жеңге
Dialogue: 0,1:22:35.61,1:22:38.74,Default,,0,0,0,,Эй, Сузу-сан, сен сол жаққа барып қарай аласың ба?
Dialogue: 0,1:22:38.87,1:22:42.29,Default,,0,0,0,,Мен мұнда қандай кеменің келгенін айтайын.
Dialogue: 0,1:22:42.41,1:22:44.58,Default,,0,0,0,,Иә, мен оны көрмеймін.
Dialogue: 0,1:22:44.70,1:22:46.79,Default,,0,0,0,,Тек Чито Тек Чито
Dialogue: 0,1:22:47.12,1:22:48.25,Default,,0,0,0,,Мен оны көре алмаймын
Dialogue: 0,1:22:48.38,1:22:50.75,Default,,0,0,0,,(Дабыл)
Dialogue: 0,1:22:51.17,1:22:53.00,Default,,0,0,0,,Мен не істеуім керек?
Dialogue: 0,1:22:53.13,1:22:56.68,Default,,0,0,0,,Мен үйге қайта алмаймын, мен бір жерде қоғамдық әуе шабуылына қарсы паналаудамын...
Dialogue: 0,1:22:57.05,1:22:57.88,Default,,0,0,0,,Иә?
Dialogue: 0,1:22:58.47,1:22:59.93,Default,,0,0,0,,Сіз шынымен келе жатырсыз ба?
Dialogue: 0,1:23:00.05,1:23:02.76,Default,,0,0,0,,Соңғы кездері мен көп қателесіп жүрмін.
Dialogue: 0,1:23:03.52,1:23:06.73,Default,,0,0,0,,Марукюфутасан Токуяма…
Dialogue: 0,1:23:06.89,1:23:11.69,Default,,0,0,0,,Жау ұшақтары Күреге қарай бет алған үлкен, шамамен 20 ұшақ
Dialogue: 0,1:23:12.86,1:23:15.44,Default,,0,0,0,,Әй, бұл жолы шынымен де келді.
Dialogue: 0,1:23:15.57,1:23:17.70,Default,,0,0,0,,Кешіріңіз, кіруге болады ма?
Dialogue: 0,1:23:17.82,1:23:18.78,Default,,0,0,0,,Ерте кел
Dialogue: 0,1:23:18.99,1:23:21.78,Default,,0,0,0,,Эвакуация Асығыңыз!
Dialogue: 0,1:23:25.91,1:23:27.41,Default,,0,0,0,,Сузу-сан қорқынышты
Dialogue: 0,1:23:27.54,1:23:30.17,Default,,0,0,0,,Жарайды, қара.
Dialogue: 0,1:23:32.13,1:23:33.84,Default,,0,0,0,,Әй, анашым
Dialogue: 0,1:23:33.96,1:23:36.34,Default,,0,0,0,,Иә, эй, бұл туралы ше?
Dialogue: 0,1:23:36.97,1:23:37.80,Default,,0,0,0,,Харуми
Dialogue: 0,1:23:38.22,1:23:40.59,Default,,0,0,0,,Харуми-чан, сен анаңмен біргесің.
Dialogue: 0,1:23:40.72,1:23:42.97,Default,,0,0,0,,Сіз бұл жақтан емессіз.
Dialogue: 0,1:23:43.18,1:23:45.93,Default,,0,0,0,,Наганокиден ауруханаға бару
Dialogue: 0,1:23:46.06,1:23:48.44,Default,,0,0,0,,Бұл қате болды.
Dialogue: 0,1:23:48.73,1:23:51.81,Default,,0,0,0,,Міне! Құлағыңызды жабыңыз, аузыңызды ашыңыз, көзіңіз шығады
Dialogue: 0,1:23:53.69,1:23:56.69,Default,,0,0,0,,Ыстық, иә, мен шыдаймын.
Dialogue: 0,1:23:57.19,1:23:59.32,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:24:01.41,1:24:03.32,Default,,0,0,0,,(Айқай)
Dialogue: 0,1:24:15.63,1:24:17.84,Default,,0,0,0,,Ух... ха...
Dialogue: 0,1:24:18.80,1:24:20.18,Default,,0,0,0,,(жөтел)
Dialogue: 0,1:24:21.97,1:24:24.85,Default,,0,0,0,,(Харумидің жөтелі)
Dialogue: 0,1:24:30.31,1:24:33.56,Default,,0,0,0,,Мм...су ала аламын ба?
Dialogue: 0,1:24:34.02,1:24:34.86,Default,,0,0,0,,Ах...
Dialogue: 0,1:24:39.36,1:24:41.32,Default,,0,0,0,,Сізге көп рахмет
Dialogue: 0,1:24:41.91,1:24:45.20,Default,,0,0,0,,Пойыз әлі кетті ме?
Dialogue: 0,1:24:45.62,1:24:48.62,Default,,0,0,0,,Пойыз да қозғалмайды. Күте тұрыңыз, Ринсару.
Dialogue: 0,1:24:49.54,1:24:50.37,Default,,0,0,0,,Иә
Dialogue: 0,1:24:50.50,1:24:52.12,Default,,0,0,0,,(жарты қоңырау және сирена)
Dialogue: 0,1:24:52.25,1:24:53.08,Default,,0,0,0,,Ах!
Dialogue: 0,1:24:56.54,1:24:59.34,Default,,0,0,0,,Ах~ мен ештеңе көрмеймін
Dialogue: 0,1:24:59.63,1:25:01.63,Default,,0,0,0,,Хмм хмм
Dialogue: 0,1:25:01.76,1:25:03.76,Default,,0,0,0,,Жақсысың ба?
Dialogue: 0,1:25:03.89,1:25:04.89,Default,,0,0,0,,Yes
Dialogue: 0,1:25:05.30,1:25:06.76,Default,,0,0,0,,Жарылмаған снарядтар...
Dialogue: 0,1:25:05.30,1:25:06.76,Default,,0,0,0,,
Dialogue: 0,1:25:06.76,1:25:06.89,Default,,0,0,0,,
Dialogue: 0,1:25:06.89,1:25:11.73,Default,,0,0,0,,
Dialogue: 0,1:25:06.89,1:25:11.73,Default,,0,0,0,,Бұл уақытты бомба болуы мүмкін, сондықтан асығыңыз және жүгіріңіз!
Dialogue: 0,1:25:12.06,1:25:15.48,Default,,0,0,0,,Ха, сәттілік!
Dialogue: 0,1:25:15.61,1:25:16.90,Default,,0,0,0,,Сәлем Сузу-сан
Dialogue: 0,1:25:17.32,1:25:20.40,Default,,0,0,0,,Келесі жолы да Харумидің ағасын салыңызшы.
Dialogue: 0,1:25:20.94,1:25:23.53,Default,,0,0,0,,Жарылмаған снарядтардың шұңқыры өте кішкентай.
Dialogue: 0,1:25:23.66,1:25:26.78,Default,,0,0,0,,Жақында азаматтық әуе қорғанысы оқу бюллетеніне сәйкес:
Dialogue: 0,1:25:26.91,1:25:29.45,Default,,0,0,0,,Жау тасталған бомбаның бір бөлігі болады...
Dialogue: 0,1:25:29.79,1:25:31.96,Default,,0,0,0,,Ха! қауіпті! Харуми-чан
Dialogue: 0,1:25:32.08,1:25:32.91,Default,,0,0,0,,Ах!
Dialogue: 0,1:26:09.24,1:26:11.87,Default,,0,0,0,,Тағы да басқаша.
Dialogue: 0,1:26:12.00,1:26:15.67,Default,,0,0,0,,Сен сондай жаман болсаң, маған үйленбе.
Dialogue: 0,1:26:15.92,1:26:19.50,Default,,0,0,0,,Енді ойлап қарасам, осының барлығынан кейін...
Dialogue: 0,1:26:19.92,1:26:22.09,Default,,0,0,0,,Мен бармайтын жол болмады.
Dialogue: 0,1:26:23.88,1:26:30.18,Default,,0,0,0,,Қарбыз Вараби мочи Жалбыз қант
Dialogue: 0,1:26:30.68,1:26:35.73,Default,,0,0,0,,Сол жолда арық болса, мен секіре алар едім.
Dialogue: 0,1:26:36.56,1:26:39.23,Default,,0,0,0,,Фурошики сол қолға оралған
Dialogue: 0,1:26:40.52,1:26:42.44,Default,,0,0,0,,Харуми-сан оң жақта
Dialogue: 0,1:26:43.69,1:26:46.07,Default,,0,0,0,,Мен керісінше болғанын қалаймын.
Dialogue: 0,1:26:47.95,1:26:51.66,Default,,0,0,0,,Ең болмаса киіміңді шешіп жүгір.
Dialogue: 0,1:26:52.70,1:26:54.37,Default,,0,0,0,,Төбенің арғы жағында
Dialogue: 0,1:26:54.87,1:26:56.92,Default,,0,0,0,,Төбенің арғы жағында...
Dialogue: 0,1:26:57.21,1:27:00.67,Default,,0,0,0,,Бұл Тон, бұл Хината.
Dialogue: 0,1:27:01.34,1:27:04.51,Default,,0,0,0,,Ямато ана осында.
Dialogue: 0,1:27:04.67,1:27:07.47,Default,,0,0,0,,(Кейзидің жылаған дауысы)
Dialogue: 0,1:27:07.59,1:27:09.01,Default,,0,0,0,,Бұл адам...
Dialogue: 0,1:27:10.22,1:27:14.39,Default,,0,0,0,,Хонма Шусаку-сан Ринсаруға ұқсайды.
Dialogue: 0,1:27:16.10,1:27:17.73,Default,,0,0,0,,Сіз менің артымнан келе жатырсыз...
Dialogue: 0,1:27:18.85,1:27:21.19,Default,,0,0,0,,Сіз осында болғаныңызда!
Dialogue: 0,1:27:21.90,1:27:23.15,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:27:23.27,1:27:25.19,Default,,0,0,0,,Кешіріңіз, Харуми-сан.
Dialogue: 0,1:27:25.44,1:27:26.82,Default,,0,0,0,,Кешіріңіз, жеңге.
Dialogue: 0,1:27:26.95,1:27:28.70,Default,,0,0,0,,Әйтеуір, адамның өмірінің соңы—
Dialogue: 0,1:27:29.49,1:27:31.20,Default,,0,0,0,,Өлтіруші!
Dialogue: 0,1:27:31.32,1:27:33.24,Default,,0,0,0,,Тоқта, Кейко (Кейко), маған Харумиді қайтар!
Dialogue: 0,1:27:33.37,1:27:35.37,Default,,0,0,0,,Тофу тарататын кез келді.
Dialogue: 0,1:27:37.33,1:27:42.00,Default,,0,0,0,,Шын айта алмайсың, себебі ол қыз да ренжіп қалады.
Dialogue: 0,1:27:42.17,1:27:45.00,Default,,0,0,0,,Сіз бізді жаңа ғана құтқарсаңыз да...
Dialogue: 0,1:27:45.13,1:27:47.42,Default,,0,0,0,,Мен орындағаныма қуаныштымын.
Dialogue: 0,1:27:48.05,1:27:49.43,Default,,0,0,0,,Менің ойымша, солай
Dialogue: 0,1:27:50.05,1:27:54.43,Default,,0,0,0,,Бұл дүниеде әркімнің өз орны бар, солай ма?
Dialogue: 0,1:27:54.56,1:27:55.14,Default,,0,0,0,,Лин мырза
Dialogue: 0,1:27:55.14,1:27:55.89,Default,,0,0,0,,Лин мырза
Dialogue: 0,1:27:55.14,1:27:55.89,Default,,0,0,0,,Эй
Dialogue: 0,1:27:56.93,1:28:01.06,Default,,0,0,0,,Ол кезде менің орным қайда еді?
Dialogue: 0,1:28:01.77,1:28:05.86,Default,,0,0,0,,Кейбір тақталар сол тақтай қоршаудан құлап кеткен болуы керек.
Dialogue: 0,1:28:06.44,1:28:09.20,Default,,0,0,0,,Жарылысқа мініп, сол жерден секіру
Dialogue: 0,1:28:09.99,1:28:12.87,Default,,0,0,0,,Ана жақта, ана жақта...
Dialogue: 0,1:28:12.99,1:28:15.41,Default,,0,0,0,,(Дабыл)
Dialogue: 0,1:28:15.70,1:28:17.66,Default,,0,0,0,,Жарайсың, тағы кездескенше.
Dialogue: 0,1:28:17.79,1:28:20.83,Default,,0,0,0,,Бұл дыбыс шықпайды, ұйықта, ұйықта
Dialogue: 0,1:28:21.08,1:28:24.75,Default,,0,0,0,,Бұл үй ерекше емес еді.
Dialogue: 0,1:28:25.34,1:28:28.30,Default,,0,0,0,,Эй, уайымдама.
Dialogue: 0,1:28:28.46,1:28:29.97,Default,,0,0,0,,Жақсы
Dialogue: 0,1:28:30.55,1:28:31.63,Default,,0,0,0,,Ол ма?
Dialogue: 0,1:28:32.34,1:28:36.64,Default,,0,0,0,,Сол адам менің үйімді бұзды...
Dialogue: 0,1:28:37.35,1:28:40.69,Default,,0,0,0,,Мен бұл қаладан абыроймен кете алар ма едім деп ойлаймын.
Dialogue: 0,1:28:43.35,1:28:44.94,Default,,0,0,0,,Оны асыра алмаңыз.
Dialogue: 0,1:28:45.36,1:28:49.40,Default,,0,0,0,,Жарайды, егер бұл үлкен мәселе болса, мен сізге жұмыста демалыс алуға рұқсат етемін.
Dialogue: 0,1:28:49.53,1:28:50.90,Default,,0,0,0,,Қош келдіңіз
Dialogue: 0,1:28:54.20,1:28:56.49,Default,,0,0,0,,Иә, күн жарқырайды
Dialogue: 0,1:28:56.62,1:28:59.62,Default,,0,0,0,,Таңғыш Сыртынан кептірейік.
Dialogue: 0,1:29:02.87,1:29:04.79,Default,,0,0,0,,Қытай аймағының әуе қорғанысы туралы ақпарат
Dialogue: 0,1:29:05.00,1:29:08.50,Default,,0,0,0,,23:50 Хиросима шығанағында жау ұшақтарының екі нысанасы бар
Dialogue: 0,1:29:08.63,1:29:09.71,Default,,0,0,0,,2 мақсаттар
Dialogue: 0,1:29:09.84,1:29:11.55,Default,,0,0,0,,Ояна аласың ба, Сузу-сан?
Dialogue: 0,1:29:11.67,1:29:14.43,Default,,0,0,0,,Иә, бәрібір.
Dialogue: 0,1:29:15.05,1:29:19.14,Default,,0,0,0,,23:58 Жау ұшақтары Куре мен Хиросима маңында ұшты.
Dialogue: 0,1:29:19.27,1:29:19.68,Default,,0,0,0,,Бірнеше ұшақ айналып жүрді.
Dialogue: 0,1:29:19.68,1:29:20.89,Default,,0,0,0,,Бірнеше ұшақ айналып жүрді.
Dialogue: 0,1:29:19.68,1:29:20.89,Default,,0,0,0,,Қараңыз
Dialogue: 0,1:29:20.89,1:29:21.27,Default,,0,0,0,,Бірнеше ұшақ айналып жүрді.
Dialogue: 0,1:29:23.06,1:29:24.02,Default,,0,0,0,,Ах...
Dialogue: 0,1:29:25.81,1:29:26.81,Default,,0,0,0,,Хаа…
Dialogue: 0,1:29:28.15,1:29:32.70,Default,,0,0,0,,Хохо, мен сені алып кетсем, мені көре алмайсың.
Dialogue: 0,1:29:33.74,1:29:36.37,Default,,0,0,0,,Ах! Уау
Dialogue: 0,1:29:36.66,1:29:38.58,Default,,0,0,0,,Бұл алау ма?
Dialogue: 0,1:29:42.29,1:29:44.21,Default,,0,0,0,,Сузу-сан, сен де тез кел.
Dialogue: 0,1:30:03.56,1:30:05.48,Default,,0,0,0,,(шу)
Dialogue: 0,1:30:15.82,1:30:19.58,Default,,0,0,0,,Сузу-сан! Сен не істеп жатырсың? Асықшы!
Dialogue: 0,1:30:24.96,1:30:28.00,Default,,0,0,0,,Сузу-сан! Сузу-сан!
Dialogue: 0,1:30:28.84,1:30:29.88,Default,,0,0,0,,Ах...
Dialogue: 0,1:30:30.13,1:30:32.13,Default,,0,0,0,,Осыншама өмірді сақтап жүргенде…
Dialogue: 0,1:30:34.38,1:30:36.59,Default,,0,0,0,,Уау!
Dialogue: 0,1:30:36.72,1:30:38.05,Default,,0,0,0,,Уууух! Ах, бұл кактус екен!
Dialogue: 0,1:30:39.26,1:30:41.39,Default,,0,0,0,,Сузу-сан, құлап қалдың ба?
Dialogue: 0,1:30:41.89,1:30:44.14,Default,,0,0,0,,Су! көбірек су
Dialogue: 0,1:30:44.27,1:30:45.14,Default,,0,0,0,,Уау
Dialogue: 0,1:30:45.89,1:30:46.27,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,1:30:46.27,1:30:48.65,Default,,0,0,0,,Жарайды, кеттік.
Dialogue: 0,1:30:46.27,1:30:48.65,Default,,0,0,0,,(радиодан дауыс)
Dialogue: 0,1:30:48.77,1:30:49.19,Default,,0,0,0,,0:30: Алдымен Бунго арнасы арқылы солтүстікке қарай жылжитын жау құрамы
Dialogue: 0,1:30:49.19,1:30:53.28,Default,,0,0,0,,0:30: Алдымен Бунго арнасы арқылы солтүстікке қарай жылжитын жау құрамы
Dialogue: 0,1:30:49.19,1:30:53.28,Default,,0,0,0,,Хмм, жарайды... Абайлаңыз.
Dialogue: 0,1:30:53.40,1:30:55.61,Default,,0,0,0,,Хиросима шығанағының оңтүстігі арқылы солтүстікке бару
Dialogue: 0,1:30:55.90,1:30:58.66,Default,,0,0,0,,1 формация Бунго арнасынан солтүстікке қарай
Dialogue: 0,1:30:58.82,1:31:02.58,Default,,0,0,0,,және Ашизуридің оңтүстік-батыс жағалауындағы 3 нысана
Dialogue: 0,1:31:03.24,1:31:04.70,Default,,0,0,0,,Ақпараттың соңы
Dialogue: 0,1:31:04.83,1:31:06.25,Default,,0,0,0,,Бұл JOFK Хиросима хабар тарату станциясы
Dialogue: 0,1:31:06.25,1:31:08.46,Default,,0,0,0,,Бұл JOFK Хиросима хабар тарату станциясы
Dialogue: 0,1:31:06.25,1:31:08.46,Default,,0,0,0,,(жарты қоңырау және сирена)
Dialogue: 0,1:31:08.46,1:31:08.79,Default,,0,0,0,,(жарты қоңырау және сирена)
Dialogue: 0,1:31:08.79,1:31:11.09,Default,,0,0,0,,(жарты қоңырау және сирена)
Dialogue: 0,1:31:08.79,1:31:11.09,Default,,0,0,0,,Күреде барлығына сәттілік.
Dialogue: 0,1:31:11.21,1:31:13.59,Default,,0,0,0,,Күреде барлығына сәттілік.
Dialogue: 0,1:31:16.63,1:31:18.63,Default,,0,0,0,,Барлық апаттан зардап шеккендерге -
Dialogue: 0,1:31:19.55,1:31:24.14,Default,,0,0,0,,Нигири Меши Хиросимадан келеді.
Dialogue: 0,1:31:24.47,1:31:27.64,Default,,0,0,0,,Футагва саябағында тарату
Dialogue: 0,1:31:27.77,1:31:30.06,Default,,0,0,0,,Апат құрбаны анықтамасын қайдан алуға болады?
Dialogue: 0,1:31:30.19,1:31:31.90,Default,,0,0,0,,Қалалық әкімдік әлі бар ма?
Dialogue: 0,1:31:32.02,1:31:33.40,Default,,0,0,0,,Менің үйім толығымен өртеніп кетті, солай емес пе?
Dialogue: 0,1:31:33.52,1:31:35.65,Default,,0,0,0,,Жаныңды сақтап қалу үшін окопқа түспе.
Dialogue: 0,1:31:35.99,1:31:37.53,Default,,0,0,0,,Кешіріңіз, жарай ма?
Dialogue: 0,1:31:37.65,1:31:39.16,Default,,0,0,0,,Иә, өтінемін
Dialogue: 0,1:31:41.78,1:31:44.12,Default,,0,0,0,,Әлі жылы болғанша тамақтаныңыз.
Dialogue: 0,1:31:44.24,1:31:47.79,Default,,0,0,0,,Төсектің астына қойған картоп толығымен өртеніп кетті.
Dialogue: 0,1:31:47.91,1:31:50.25,Default,,0,0,0,,Итадакимасу
Dialogue: 0,1:31:50.67,1:31:51.96,Default,,0,0,0,,Жездем де
Dialogue: 0,1:31:53.46,1:31:56.92,Default,,0,0,0,,Жоқ, ыстық, ыстық...
Dialogue: 0,1:31:57.67,1:32:00.43,Default,,0,0,0,,Эй, Шинономе қаласында адамдар бар.
Dialogue: 0,1:32:00.80,1:32:03.76,Default,,0,0,0,,Асахи қаласынан оңтүстікке қарай жүру мүмкін емес
Dialogue: 0,1:32:03.93,1:32:05.64,Default,,0,0,0,,Қызыл жанған аудан да өртеніп кетті.
Dialogue: 0,1:32:05.77,1:32:06.85,Default,,0,0,0,,Хоука
Dialogue: 0,1:32:06.97,1:32:08.43,Default,,0,0,0,,Ах...
Dialogue: 0,1:32:08.94,1:32:11.06,Default,,0,0,0,,Сузу-сан! Эй...
Dialogue: 0,1:32:12.19,1:32:13.44,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,1:32:13.73,1:32:15.57,Default,,0,0,0,,Жаттығу туралы не деуге болады? (Шусаку) Ол жойылды.
Dialogue: 0,1:32:16.32,1:32:19.24,Default,,0,0,0,,Қалай болғанда да сенің аман қалғаныңа қуаныштымын.
Dialogue: 0,1:32:20.20,1:32:22.32,Default,,0,0,0,,Аңырап, бұлыңғыр
Dialogue: 0,1:32:22.45,1:32:23.37,Default,,0,0,0,,Сузу-сан!
Dialogue: 0,1:32:23.49,1:32:26.24,Default,,0,0,0,,Рин-санды іздеп жатырмын... (Шусаку) Сузу-сан Эй!
Dialogue: 0,1:32:26.62,1:32:29.58,Default,,0,0,0,,Иә, мен өз дауысымды естідім
Dialogue: 0,1:32:32.42,1:32:33.58,Default,,0,0,0,,Қалай болғанда да, жақсы болды.
Dialogue: 0,1:32:34.13,1:32:36.34,Default,,0,0,0,,Қызуыңыздың төмендегеніне қуаныштымын.
Dialogue: 0,1:32:36.50,1:32:39.22,Default,,0,0,0,,Жақсы болды, ол жарылып кетпеді.
Dialogue: 0,1:32:39.38,1:32:41.22,Default,,0,0,0,,Оны шығара алғаныңызға қуаныштымын.
Dialogue: 0,1:32:41.72,1:32:44.05,Default,,0,0,0,,Тез жазылып кеткеніңізге қуаныштымын.
Dialogue: 0,1:32:44.22,1:32:45.05,Default,,0,0,0,,Жақсы...
Dialogue: 0,1:32:45.89,1:32:48.06,Default,,0,0,0,,«Жақсы, жақсы»
Dialogue: 0,1:32:49.56,1:32:53.31,Default,,0,0,0,,Мен оның не жақсы болғанын білмеймін.
Dialogue: 0,1:32:54.86,1:32:58.32,Default,,0,0,0,,Маусым айында менің оң қолым Харуми-санға қосылды.
Dialogue: 0,1:32:59.15,1:33:02.99,Default,,0,0,0,,Мамыр айында оң қол Шусакудың ұйықтап жатқан бетін бейнелейді.
Dialogue: 0,1:33:04.03,1:33:08.08,Default,,0,0,0,,Сәуірде оң қолы Теру-санның қып-қызыл қызылын ұстады
Dialogue: 0,1:33:08.24,1:33:12.33,Default,,0,0,0,,Ақпан айында ағамның миын көтерген оң қол
Dialogue: 0,1:33:12.79,1:33:17.75,Default,,0,0,0,,Өткен қараша айында қайын апамның кимоносын қате қиып алдым.
Dialogue: 0,1:33:18.46,1:33:22.76,Default,,0,0,0,,Өткен тамызда мен Линнің оң қолына қарбыз тарттым.
Dialogue: 0,1:33:24.01,1:33:29.47,Default,,0,0,0,,Өткен мамырда мен лорд Кусунокиге таңғалғаным сонша, мен таяқшамды тастап кеттім.
Dialogue: 0,1:33:29.89,1:33:34.31,Default,,0,0,0,,Өткен наурызда... Оң қолыма туған жерім сызылған...
Dialogue: 0,1:33:34.44,1:33:36.98,Default,,0,0,0,,Норисуки жақсы көретін оң қол...
Dialogue: 0,1:33:37.82,1:33:42.45,Default,,0,0,0,,Жеті жыл бұрын ақпан айында мен оң қолыма көптеген қояндарды салдым.
Dialogue: 0,1:33:44.28,1:33:46.20,Default,,0,0,0,,Әпке, мен көре алмадым.
Dialogue: 0,1:33:46.32,1:33:48.87,Default,,0,0,0,,Бұл үлкен іс болды, Сузу-чан.
Dialogue: 0,1:33:49.83,1:33:53.16,Default,,0,0,0,,Суми-чан, келгеніңе рахмет.
Dialogue: 0,1:33:53.29,1:33:58.38,Default,,0,0,0,,Әскер офицері мені құтқару көлігіне мінуімді өтінді.
Dialogue: 0,1:33:59.84,1:34:01.30,Default,,0,0,0,,Не? Иә
Dialogue: 0,1:34:01.42,1:34:03.88,Default,,0,0,0,,Иә, ескі киім таза мақта.
Dialogue: 0,1:34:04.18,1:34:05.63,Default,,0,0,0,,Құрамында суфу жоқ па?
Dialogue: 0,1:34:05.76,1:34:07.43,Default,,0,0,0,,Иә, ол бұзылған.
Dialogue: 0,1:34:07.55,1:34:08.76,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,1:34:08.89,1:34:10.35,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,1:34:21.48,1:34:23.11,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:34:27.32,1:34:31.41,Default,,0,0,0,,Бұл Еба тауында өсетін локаттар.
Dialogue: 0,1:34:32.29,1:34:33.66,Default,,0,0,0,,Амансың ба?
Dialogue: 0,1:34:33.79,1:34:37.54,Default,,0,0,0,,Орнымнан тұрмасам, жалқау боламын, сондықтан мен сені жарты жолға жіберемін.
Dialogue: 0,1:34:37.67,1:34:40.63,Default,,0,0,0,,Өрт сөндіру бекетінің алдында кездесейік.
Dialogue: 0,1:34:40.75,1:34:43.71,Default,,0,0,0,,Хойжа Өзен жағасындағы мұнара – көрнекті орын
Dialogue: 0,1:34:43.96,1:34:46.13,Default,,0,0,0,,Жоқ, ол да күйіп кеткен.
Dialogue: 0,1:34:46.26,1:34:48.01,Default,,0,0,0,,Әлі де тұр
Dialogue: 0,1:34:48.26,1:34:51.14,Default,,0,0,0,,Келсем офицерді көріп шошып кеттім.
Dialogue: 0,1:34:51.56,1:34:54.43,Default,,0,0,0,,Жас болса да мейірімді адам емес.
Dialogue: 0,1:34:54.64,1:34:57.35,Default,,0,0,0,,Сіз маған бұрыннан тамақ билетін бердіңіз.
Dialogue: 0,1:34:57.60,1:35:02.78,Default,,0,0,0,,Менің Күреге тұрмысқа шыққан үлкен әпкем бар, соны есте сақтаңыз.
Dialogue: 0,1:35:02.94,1:35:04.11,Default,,0,0,0,,Сізге ұнайды.
Dialogue: 0,1:35:04.40,1:35:07.86,Default,,0,0,0,,О, тәңірім Сузу-чан
Dialogue: 0,1:35:07.99,1:35:08.95,Default,,0,0,0,,Атта
Dialogue: 0,1:35:12.62,1:35:14.37,Default,,0,0,0,,Бұл қорқынышты.
Dialogue: 0,1:35:21.79,1:35:23.50,Default,,0,0,0,,А... Жарайды.
Dialogue: 0,1:35:25.92,1:35:30.14,Default,,0,0,0,,Әуе шабуылдарынан Күре аянып қалма.
Dialogue: 0,1:35:31.01,1:35:35.35,Default,,0,0,0,,Үйге күтім жасай алмасаң, үйге жету қиын болады.
Dialogue: 0,1:35:37.85,1:35:39.56,Default,,0,0,0,,Сәлем Сузу-чан
Dialogue: 0,1:35:40.10,1:35:42.69,Default,,0,0,0,,Хиросимаға қайту.
Dialogue: 0,1:35:42.82,1:35:43.73,Default,,0,0,0,,А...
Dialogue: 0,1:35:43.90,1:35:45.61,Default,,0,0,0,,Қорқынышты әуе шабуылдары жоқ...
Dialogue: 0,1:35:46.15,1:35:50.49,Default,,0,0,0,,Енді үлкен аға, бұзақы болмайды.
Dialogue: 0,1:35:53.12,1:35:54.62,Default,,0,0,0,,Жоқ
Dialogue: 0,1:35:55.95,1:35:59.67,Default,,0,0,0,,Суми-чанның офицері сымбатты ма, жоқ па, соған қарап шешім қабылдамауым керек деп ойлаймын.
Dialogue: 0,1:35:59.79,1:36:01.96,Default,,0,0,0,,Иә, бұл таза емес.
Dialogue: 0,1:36:02.25,1:36:04.63,Default,,0,0,0,,Өтірік, өтірік Онда кездескенше
Dialogue: 0,1:36:04.75,1:36:05.75,Default,,0,0,0,,Бұрмаланған
Dialogue: 0,1:36:05.88,1:36:08.42,Default,,0,0,0,,Иә, бұл жай ғана ой деп ойлаймын.
Dialogue: 0,1:36:08.88,1:36:11.93,Default,,0,0,0,,Келесі айдың 6-сы Энами фестивалі болады.
Dialogue: 0,1:36:12.05,1:36:13.76,Default,,0,0,0,,Тезірек үйге қайт.
Dialogue: 0,1:36:13.89,1:36:16.18,Default,,0,0,0,,Рахмет, Суми Чан
Dialogue: 0,1:36:16.35,1:36:19.23,Default,,0,0,0,,Мен ағамның қайтыс болғанына қуаныштымын.
Dialogue: 0,1:36:20.14,1:36:21.98,Default,,0,0,0,,Бұрмаланған өзіміз.
Dialogue: 0,1:36:22.56,1:36:25.02,Default,,0,0,0,,Сол қолмен салынған сурет сияқты
Dialogue: 0,1:36:28.53,1:36:33.53,Default,,0,0,0,,(Дабыл)
Dialogue: 0,1:36:52.05,1:36:52.97,Default,,0,0,0,,Ах...
Dialogue: 0,1:37:05.52,1:37:10.53,Default,,0,0,0,,(Дабыл)
Dialogue: 0,1:37:12.66,1:37:14.07,Default,,0,0,0,,Аа, мен де бүгін келдім.
Dialogue: 0,1:37:14.20,1:37:17.37,Default,,0,0,0,,Ки тағы да ырылдайтын сияқты. Затыңызды әкеліңіз.
Dialogue: 0,1:37:17.49,1:37:18.33,Default,,0,0,0,,Иә, солай.
Dialogue: 0,1:37:18.45,1:37:21.12,Default,,0,0,0,,Сузу-сан, алға.
Dialogue: 0,1:37:23.46,1:37:24.83,Default,,0,0,0,,(Геронның айқайы)
Dialogue: 0,1:37:28.84,1:37:29.96,Default,,0,0,0,,Келме
Dialogue: 0,1:37:31.76,1:37:34.01,Default,,0,0,0,,Енді мұнда келуге болмайды.
Dialogue: 0,1:37:35.89,1:37:36.80,Default,,0,0,0,,Ах...
Dialogue: 0,1:37:44.31,1:37:47.15,Default,,0,0,0,,Содан кейін сол жаққа дейін қашыңыз.
Dialogue: 0,1:37:47.82,1:37:50.53,Default,,0,0,0,,Таудан өткеннен кейін Хиросимаға жетесіз.
Dialogue: 0,1:37:50.65,1:37:55.66,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,1:38:05.08,1:38:05.96,Default,,0,0,0,,Ах
Dialogue: 0,1:38:23.10,1:38:24.52,Default,,0,0,0,,Өлгің келе ме!?
Dialogue: 0,1:38:25.35,1:38:26.48,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:38:26.60,1:38:29.73,Default,,0,0,0,,Құлтан... Құтан ұшып кетті.
Dialogue: 0,1:38:29.98,1:38:33.07,Default,,0,0,0,,А, менің ойымша, олар жағадан қашып кетті.
Dialogue: 0,1:38:34.03,1:38:36.45,Default,,0,0,0,,Шусаку-сан...
Dialogue: 0,1:38:37.16,1:38:38.82,Default,,0,0,0,,Хиросимаға қайту
Dialogue: 0,1:38:43.29,1:38:45.04,Default,,0,0,0,,Қайтуды жоспарлайсыз ба?
Dialogue: 0,1:38:46.58,1:38:48.04,Default,,0,0,0,,Қолдарыңыз үшін алаңдайсыз ба?
Dialogue: 0,1:38:49.21,1:38:50.84,Default,,0,0,0,,Сіз әуе шабуылынан қорқасыз ба?
Dialogue: 0,1:38:51.59,1:38:52.46,Default,,0,0,0,,Сіз Харуми туралы айтып отырсыз ба?
Dialogue: 0,1:38:52.80,1:38:56.47,Default,,0,0,0,,Дұрыс, дұрыс, осының бәрі.
Dialogue: 0,1:38:57.09,1:38:58.05,Default,,0,0,0,,Мен сізді естімеймін!
Dialogue: 0,1:38:58.18,1:38:59.35,Default,,0,0,0,,Жоқ!
Dialogue: 0,1:39:00.89,1:39:02.35,Default,,0,0,0,,Сонда неге?
Dialogue: 0,1:39:03.97,1:39:05.31,Default,,0,0,0,,Сузу-сан
Dialogue: 0,1:39:05.68,1:39:08.73,Default,,0,0,0,,Мен өткен бір жарым жылды көңілді өткіздім.
Dialogue: 0,1:39:09.19,1:39:11.23,Default,,0,0,0,,Үйіңізге қайтыңыз
Dialogue: 0,1:39:11.36,1:39:14.90,Default,,0,0,0,,Мен сенімен бірге жүріп, сенімен дірілдеп сөйлессем де.
Dialogue: 0,1:39:16.70,1:39:20.41,Default,,0,0,0,,Сіз басқашасыз ба? Осы уақыт бойы мен оны білмеген сияқтымын ба?
Dialogue: 0,1:39:23.70,1:39:24.91,Default,,0,0,0,,Мен сізді естімеймін
Dialogue: 0,1:39:25.79,1:39:28.46,Default,,0,0,0,,Мен естімеймін, естімеймін, мен ештеңе естімеймін
Dialogue: 0,1:39:28.75,1:39:32.04,Default,,0,0,0,,Қайту Қайту Хиросимаға қайту!
Dialogue: 0,1:39:32.17,1:39:33.50,Default,,0,0,0,,О, түсіндім!
Dialogue: 0,1:39:34.38,1:39:35.59,Default,,0,0,0,,Қалағаныңды істе
Dialogue: 0,1:39:48.98,1:39:52.02,Default,,0,0,0,,Қытайдың әскери аймағында аспанда жау ұшағы жоқ
Dialogue: 0,1:39:52.36,1:39:55.19,Default,,0,0,0,,Қытайдың әскери аймағында аспанда жау ұшағы жоқ
Dialogue: 0,1:39:55.69,1:39:58.40,Default,,0,0,0,,Хиросима префектурасының ауданы 7:31
Dialogue: 0,1:39:58.57,1:40:01.16,Default,,0,0,0,,Ескерту ескертуі жойылды
Dialogue: 0,1:40:02.83,1:40:04.95,Default,,0,0,0,,Ол дер кезінде жойылды.
Dialogue: 0,1:40:05.16,1:40:06.79,Default,,0,0,0,,Эй, мен кетемін.
Dialogue: 0,1:40:06.91,1:40:08.79,Default,,0,0,0,,Қош келдіңіз.
Dialogue: 0,1:40:10.25,1:40:12.92,Default,,0,0,0,,Айтатата…
Dialogue: 0,1:40:13.42,1:40:14.84,Default,,0,0,0,,Әділ
Dialogue: 0,1:40:15.13,1:40:18.17,Default,,0,0,0,,Жаса, таңертеңнен бері ыстық.
Dialogue: 0,1:40:20.13,1:40:24.93,Default,,0,0,0,,Сузу-сан кеткенде жалғыздық.
Dialogue: 0,1:40:44.78,1:40:47.04,Default,,0,0,0,,Сонымен, сағат нешеде?
Dialogue: 0,1:40:47.20,1:40:48.87,Default,,0,0,0,,үшін? (Гуйжи) ауруханасы
Dialogue: 0,1:40:49.91,1:40:52.67,Default,,0,0,0,,Ха, сағат 10 шамасында.
Dialogue: 0,1:40:55.63,1:40:57.88,Default,,0,0,0,,Хаа... Ол киімді киме.
Dialogue: 0,1:40:59.47,1:41:00.34,Default,,0,0,0,,Иә
Dialogue: 0,1:41:09.43,1:41:11.85,Default,,0,0,0,,Кешіріңіз, мм...
Dialogue: 0,1:41:12.90,1:41:15.69,Default,,0,0,0,,А... бұл кір емес еді.
Dialogue: 0,1:41:17.48,1:41:21.03,Default,,0,0,0,,Бүгін сенің ауылыңның мерекесі.
Dialogue: 0,1:41:21.95,1:41:22.99,Default,,0,0,0,,Иә
Dialogue: 0,1:41:23.32,1:41:29.08,Default,,0,0,0,,Мен демалыс күні үйге баруды жоспарлап едім, бірақ мен бүгін ғана ауруханаға жазыла аламын.
Dialogue: 0,1:41:32.83,1:41:33.92,Default,,0,0,0,,Қараңыз.
Dialogue: 0,1:41:34.04,1:41:35.29,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:41:36.67,1:41:38.80,Default,,0,0,0,,Мен бәрібір уақытында үлгермеймін.
Dialogue: 0,1:41:39.30,1:41:41.38,Default,,0,0,0,,Дәрігерлер бос емес болса да.
Dialogue: 0,1:41:42.05,1:41:46.09,Default,,0,0,0,,Менің ойымша, мен Хиросимадағы ауруханаға кіріспе хат жазуым керек.
Dialogue: 0,1:41:46.72,1:41:49.52,Default,,0,0,0,,Даиичи пойызына билет ала алмай жүрмін.
Dialogue: 0,1:41:51.64,1:41:52.48,Default,,0,0,0,,Иә
Dialogue: 0,1:41:52.94,1:41:56.31,Default,,0,0,0,,Мен апамның таза мақтасын жөндеймін деп Монпеге бардым.
Dialogue: 0,1:41:56.98,1:41:59.44,Default,,0,0,0,,Серпімді сыммен бір адамға киюге болады.
Dialogue: 0,1:41:59.57,1:42:01.94,Default,,0,0,0,,Резеңкенің шатасып кеткені үшін кешіріңіз.
Dialogue: 0,1:42:02.57,1:42:05.49,Default,,0,0,0,,Ах... Рахмет.
Dialogue: 0,1:42:09.28,1:42:13.83,Default,,0,0,0,,Өте өкінішті, мен сені Харумидің өліміне кінәлаймын.
Dialogue: 0,1:42:14.67,1:42:15.50,Default,,0,0,0,,Жоқ
Dialogue: 0,1:42:17.88,1:42:20.42,Default,,0,0,0,,Мен сүйген адам ерте қайтыс болды.
Dialogue: 0,1:42:21.21,1:42:23.38,Default,,0,0,0,,Эвакуация кезінде дүкен де жойылды.
Dialogue: 0,1:42:24.30,1:42:26.30,Default,,0,0,0,,Мен енді балаларымды көре алмаймын.
Dialogue: 0,1:42:27.26,1:42:30.14,Default,,0,0,0,,Қандай жағдай болмасын, бұл сен таңдаған жолдың соңы.
Dialogue: 0,1:42:32.06,1:42:33.73,Default,,0,0,0,,Осы орайда сіз...
Dialogue: 0,1:42:33.89,1:42:36.56,Default,,0,0,0,,Айналадағылардың өтініші бойынша мен танымайтын үйге тұрмысқа шықтым.
Dialogue: 0,1:42:36.69,1:42:38.65,Default,,0,0,0,,Жұмысқа мәжбүрлеу
Dialogue: 0,1:42:40.11,1:42:43.07,Default,,0,0,0,,Менің ойымша, бұл қызықсыз өмір.
Dialogue: 0,1:42:47.66,1:42:51.74,Default,,0,0,0,,Сузу-санның тұрған жері осында немесе кез келген жерде болуы мүмкін.
Dialogue: 0,1:42:52.08,1:42:55.08,Default,,0,0,0,,Абыр-сабыр болмай, өзіңіз шешіңіз
Dialogue: 0,1:43:04.59,1:43:05.67,Default,,0,0,0,,Иә?
Dialogue: 0,1:43:06.63,1:43:09.55,Default,,0,0,0,,Кейко-чан, дәл қазір бірдеңе жарқ етті ме?
Dialogue: 0,1:43:09.68,1:43:10.89,Default,,0,0,0,,Жарқыраған
Dialogue: 0,1:43:11.60,1:43:14.35,Default,,0,0,0,,Күн күркіреді ме? Иә, ауа-райы.
Dialogue: 0,1:43:14.81,1:43:16.89,Default,,0,0,0,,Мм... мен осылай ойладым...
Dialogue: 0,1:43:17.39,1:43:19.23,Default,,0,0,0,,Маған жууға бола ма?
Dialogue: 0,1:43:20.44,1:43:22.69,Default,,0,0,0,,Хойде, күткендей-
Dialogue: 0,1:43:23.44,1:43:24.99,Default,,0,0,0,,Сіз осында келе аласыз ба?
Dialogue: 0,1:43:25.11,1:43:29.66,Default,,0,0,0,,Әй, түсіндім, түсіндім, бірақ кет, ыстық.
Dialogue: 0,1:43:39.12,1:43:40.79,Default,,0,0,0,,Не? Қазіргісі
Dialogue: 0,1:43:43.42,1:43:46.21,Default,,0,0,0,,Go JOFK ештеңе естімейді.
Dialogue: 0,1:43:46.34,1:43:47.51,Default,,0,0,0,,Басқалар ше?
Dialogue: 0,1:43:47.63,1:43:48.68,Default,,0,0,0,,Эй
Dialogue: 0,1:43:49.76,1:43:51.26,Default,,0,0,0,,Келіңіз және қараңыз.
Dialogue: 0,1:43:55.47,1:43:57.39,Default,,0,0,0,,Не? Бұл бұлт
Dialogue: 0,1:43:57.52,1:43:59.23,Default,,0,0,0,,«Шындығында, Уэноға бір ғана пойызбен жетуге болады»
Dialogue: 0,1:43:59.35,1:44:00.31,Default,,0,0,0,,Бұлттар?
Dialogue: 0,1:44:01.31,1:44:04.57,Default,,0,0,0,,Бұл үлкен бұлт, Канатоко бұлты.
Dialogue: 0,1:44:05.48,1:44:10.66,Default,,0,0,0,,Бұл Окаяма хабар тарату станциясы немесе Хиросима хабар тарату станциясы ма? Хиросима хабар тарату станциясы?
Dialogue: 0,1:44:10.78,1:44:12.57,Default,,0,0,0,,Бұл Окаяма хабар тарату станциясы
Dialogue: 0,1:44:12.70,1:44:17.70,Default,,0,0,0,,Жоқ, мен бірдеңені түсіріп алдым деп ойладым, бірақ ол Хиросимадағы дөңгелек тақта болып шықты.
Dialogue: 0,1:44:23.38,1:44:24.75,Default,,0,0,0,,Ах...
Dialogue: 0,1:44:25.05,1:44:28.72,Default,,0,0,0,,Қолдарыңыз бос болса, Ринпоканға кейінірек тоқтаңыз.
Dialogue: 0,1:44:29.38,1:44:32.80,Default,,0,0,0,,Хм, Чита-сан медбике болған, солай ма?
Dialogue: 0,1:44:32.93,1:44:36.06,Default,,0,0,0,,Ха, мен бұрын ешқашан зори сандалдарын жасаған емеспін.
Dialogue: 0,1:44:36.52,1:44:38.56,Default,,0,0,0,,Айналадағылардың бәрі сондай.
Dialogue: 0,1:44:38.68,1:44:40.31,Default,,0,0,0,,Келе аласыз ба?
Dialogue: 0,1:44:41.40,1:44:44.69,Default,,0,0,0,,А, мен енді бір қолды ұстай алмаймын, тістерім нашар.
Dialogue: 0,1:44:44.82,1:44:46.15,Default,,0,0,0,,Сонда бұл сізге ұнамайды ма?
Dialogue: 0,1:44:46.82,1:44:49.36,Default,,0,0,0,,Әй, мына сандалдарды не істейсің?
Dialogue: 0,1:44:49.49,1:44:50.70,Default,,0,0,0,,Хиросимаға.
Dialogue: 0,1:44:50.82,1:44:53.45,Default,,0,0,0,,Өткен айдағы әуе шабуылындағыдай жолдар еріп кетсе...
Dialogue: 0,1:44:53.57,1:44:55.45,Default,,0,0,0,,Аяқ киім немесе аяқ киім жоқ.
Dialogue: 0,1:44:56.28,1:44:57.66,Default,,0,0,0,,Біз де бара аламыз ба?
Dialogue: 0,1:44:58.08,1:44:59.29,Default,,0,0,0,,Зардап шеккендер бара алмайды.
Dialogue: 0,1:44:59.41,1:45:02.71,Default,,0,0,0,,Менің ұлымды солдаттар Хиросимаға алып кетті.
Dialogue: 0,1:45:02.83,1:45:05.21,Default,,0,0,0,,Эй, сен ертең жүк көлігіне мінгің келе ме?
Dialogue: 0,1:45:05.34,1:45:08.38,Default,,0,0,0,,Куреге әуе шабуылы кезінде Хиросима құтқарылды!
Dialogue: 0,1:45:08.51,1:45:10.22,Default,,0,0,0,,Мен бір нәрсені қайтаруым керек...
Dialogue: 0,1:45:11.88,1:45:12.72,Default,,0,0,0,,Ах
Dialogue: 0,1:45:13.39,1:45:16.89,Default,,0,0,0,,Бұл сізді байлау қиындығынан құтқарады, сондықтан мен сізді алаңдатпаймын.
Dialogue: 0,1:45:17.01,1:45:17.85,Default,,0,0,0,,Go
Dialogue: 0,1:45:18.85,1:45:20.60,Default,,0,0,0,,Қайтадан ақымақ бол
Dialogue: 0,1:45:20.73,1:45:22.48,Default,,0,0,0,,Тез, үйге барып, қырқайық.
Dialogue: 0,1:45:22.69,1:45:26.44,Default,,0,0,0,,Менің отбасым да жақында Хиросимаға барады.
Dialogue: 0,1:45:26.94,1:45:29.36,Default,,0,0,0,,Хиросимаға бомбаның жаңа түрі тасталды.
Dialogue: 0,1:45:29.48,1:45:31.03,Default,,0,0,0,,Арьярия
Dialogue: 0,1:45:31.28,1:45:32.57,Default,,0,0,0,,Сузу-сан жарайды...
Dialogue: 0,1:45:32.70,1:45:33.95,Default,,0,0,0,,Ана
Dialogue: 0,1:45:35.16,1:45:38.87,Default,,0,0,0,,Жеңілдік әскери базадан келеді, сондықтан...
Dialogue: 0,1:45:44.58,1:45:45.54,Default,,0,0,0,,Хмм...
Dialogue: 0,1:45:49.05,1:45:51.47,Default,,0,0,0,,Сіз де Хиросимадан келдіңіз.
Dialogue: 0,1:46:06.73,1:46:09.40,Default,,0,0,0,,Отырып өлмейсің.
Dialogue: 0,1:46:09.57,1:46:11.90,Default,,0,0,0,,Хиросимадан осында жүрдім
Dialogue: 0,1:46:12.03,1:46:14.95,Default,,0,0,0,,Күрсін... Кім екенін білмеймін.
Dialogue: 0,1:46:15.11,1:46:17.20,Default,,0,0,0,,Беті де, киімі де жабылған
Dialogue: 0,1:46:17.37,1:46:19.53,Default,,0,0,0,,Қожоның әйеліне үндемей осыны айт.
Dialogue: 0,1:46:19.66,1:46:23.33,Default,,0,0,0,,Ол баланың түрін көрмеймін, аяймын.
Dialogue: 0,1:46:23.46,1:46:24.29,Default,,0,0,0,,Ха…
Dialogue: 0,1:46:26.12,1:46:28.54,Default,,0,0,0,,Эвкалипт жапырақтары көктеп шықты.
Dialogue: 0,1:46:28.71,1:46:30.63,Default,,0,0,0,,Масалардан қорғау үшін қолданыңыз
Dialogue: 0,1:46:31.76,1:46:33.09,Default,,0,0,0,,Рахмет
Dialogue: 0,1:46:33.63,1:46:35.30,Default,,0,0,0,,Зейінді болыңыз
Dialogue: 0,1:46:35.43,1:46:37.18,Default,,0,0,0,,Иә, келіңіз...
Dialogue: 0,1:46:37.55,1:46:40.76,Default,,0,0,0,,Энамиден Джуро Урано Суми Кисено
Dialogue: 0,1:46:40.89,1:46:41.81,Default,,0,0,0,,Иә
Dialogue: 0,1:46:41.93,1:46:45.31,Default,,0,0,0,,Ито Морита Кусацу Марина Чизуко
Dialogue: 0,1:46:47.40,1:46:52.19,Default,,0,0,0,,Мен де қатты айқайлағым келеді, ақырын және қыңыр ырылдағым келеді
Dialogue: 0,1:46:52.32,1:46:54.19,Default,,0,0,0,,Осы қаланың адамдары сияқты
Dialogue: 0,1:46:54.82,1:46:56.61,Default,,0,0,0,,О, бұл шулы.
Dialogue: 0,1:46:56.99,1:46:59.53,Default,,0,0,0,,Мұндай зорлық-зомбылыққа кім көнеді?
Dialogue: 0,1:47:00.74,1:47:03.91,Default,,0,0,0,,Өтінемін, осында мәңгілікке келіңіз.
Dialogue: 0,1:47:05.54,1:47:07.25,Default,,0,0,0,,Мені алаңдатыңыз
Dialogue: 0,1:47:07.42,1:47:08.83,Default,,0,0,0,,Мен… сен сияқты жігіттің үстемдік етуіне жол бермеймін, Карс
Dialogue: 0,1:47:09.04,1:47:11.55,Default,,0,0,0,,Идиот ақымақ ақымақ...
Dialogue: 0,1:47:12.00,1:47:13.30,Default,,0,0,0,,Кешіріңіз (Шусаку) Ах.
Dialogue: 0,1:47:14.88,1:47:16.17,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,1:47:16.59,1:47:18.22,Default,,0,0,0,,Кешіріңіз.
Dialogue: 0,1:47:19.26,1:47:20.51,Default,,0,0,0,,Кешіріңіз (Шусаку) Ах.
Dialogue: 0,1:47:20.64,1:47:22.51,Default,,0,0,0,,Сіз тіпті біреуін де алмайсыз.
Dialogue: 0,1:47:22.68,1:47:25.27,Default,,0,0,0,,Теңіз корпусы мені тағы қорқытады деп ойлаймын.
Dialogue: 0,1:47:26.35,1:47:30.27,Default,,0,0,0,,Сузу-сан, егер сіз АҚШ әскерінен оқиғаны алсаңыз, оны жеткізуіңіз керек.
Dialogue: 0,1:47:30.40,1:47:32.48,Default,,0,0,0,,Әскери полиция маған тағы ұрысты.
Dialogue: 0,1:47:33.23,1:47:35.74,Default,,0,0,0,,Жеткізсең де тек күйіп қалады.
Dialogue: 0,1:47:35.86,1:47:38.20,Default,,0,0,0,,Оны осылай ысқылап, тамшы қағазға айналдырған дұрыс.
Dialogue: 0,1:47:38.32,1:47:39.87,Default,,0,0,0,,Өте көп қалдықтар
Dialogue: 0,1:47:40.03,1:47:41.41,Default,,0,0,0,,Ең маңыздысы
Dialogue: 0,1:47:41.74,1:47:44.41,Default,,0,0,0,,Әзірге дәретхана ешкімге қарызға берілмейді.
Dialogue: 0,1:47:44.66,1:47:48.62,Default,,0,0,0,,Біздің шайқас – қолымызда бар нәрсені пайдалана отырып өмір сүруді жалғастыру.
Dialogue: 0,1:47:48.75,1:47:49.67,Default,,0,0,0,,Иә?
Dialogue: 0,1:47:50.50,1:47:52.29,Default,,0,0,0,,А, өтінемін, көтеріліңіз.
Dialogue: 0,1:47:52.42,1:47:53.67,Default,,0,0,0,,Сәлем
Dialogue: 0,1:47:53.88,1:47:57.30,Default,,0,0,0,,Майдан даласында қаза тапқан, борышын өтеу кезінде қаза тапқан.
Dialogue: 0,1:47:57.42,1:48:03.01,Default,,0,0,0,,Қайтыс болғандар мен олардың жақындары туралы ой...
Dialogue: 0,1:48:03.31,1:48:04.97,Default,,0,0,0,,Гонай үшін рип
Dialogue: 0,1:48:05.10,1:48:09.35,Default,,0,0,0,,Соғыста жараланып, апатқа ұшырады.
Dialogue: 0,1:48:09.56,1:48:12.56,Default,,0,0,0,,Отбасылық кәсіптен айырылғандардың игілігі үшін...
Dialogue: 0,1:48:12.69,1:48:16.99,Default,,0,0,0,,Төзгісізге шыдаңыз Төзгісізге шыдаңыз
Dialogue: 0,1:48:17.11,1:48:19.20,Default,,0,0,0,,Барлық жастағы адамдар үшін...
Dialogue: 0,1:48:19.49,1:48:22.32,Default,,0,0,0,,Мәртебелі императордың хабар таратуын құрметпен сұраймыз...
Dialogue: 0,1:48:22.45,1:48:24.70,Default,,0,0,0,,Хаа... болды, бітті
Dialogue: 0,1:48:24.83,1:48:26.04,Default,,0,0,0,,Сонымен...
Dialogue: 0,1:48:26.16,1:48:28.54,Default,,0,0,0,,Бұл сіздің жеңіліп қалдыңыз дегенді білдіре ме?
Dialogue: 0,1:48:29.16,1:48:30.04,Default,,0,0,0,,Неліктен?
Dialogue: 0,1:48:30.17,1:48:33.42,Default,,0,0,0,,Хиросима мен Нагасакиге жаңа бомбалар тасталды.
Dialogue: 0,1:48:33.54,1:48:37.34,Default,,0,0,0,,Соғысқа Кеңес Одағы да қосылды, сондықтан бұл үлкен мәселе емес.
Dialogue: 0,1:48:38.17,1:48:40.63,Default,,0,0,0,,Сіз бұған дайын емессіз бе?
Dialogue: 0,1:48:41.18,1:48:43.97,Default,,0,0,0,,Ең соңғы адамға дейін шайқаспас па едің?
Dialogue: 0,1:48:44.47,1:48:46.81,Default,,0,0,0,,Мұнда әлі бес адам бар.
Dialogue: 0,1:48:46.97,1:48:50.31,Default,,0,0,0,,Сол қолым мен екі аяғым болса да.
Dialogue: 0,1:48:51.31,1:48:53.61,Default,,0,0,0,,Уф! аа! Уф!
Dialogue: 0,1:48:55.15,1:48:58.32,Default,,0,0,0,,(Кейзидің жылаған дауысы)
Dialogue: 0,1:48:58.44,1:48:59.90,Default,,0,0,0,,Харуми…
Dialogue: 0,1:49:00.24,1:49:02.41,Default,,0,0,0,,Ух... Харуми...
Dialogue: 0,1:49:09.70,1:49:13.25,Default,,0,0,0,,Біздің өткеніміз ұшып барады
Dialogue: 0,1:49:13.83,1:49:16.25,Default,,0,0,0,,Менің ойлағаным дұрыс болды
Dialogue: 0,1:49:16.92,1:49:19.55,Default,,0,0,0,,Сондықтан мен өзімді ұстауға тырыстым
Dialogue: 0,1:49:21.26,1:49:25.76,Default,,0,0,0,,А... теңіздің арғы жағындағы күріш пен соя.
Dialogue: 0,1:49:25.93,1:49:29.52,Default,,0,0,0,,Менің ойымша, біз мұны осылай істей аламыз.
Dialogue: 0,1:49:30.52,1:49:33.27,Default,,0,0,0,,Зорлық-зомбылыққа берілу керек емес пе?
Dialogue: 0,1:49:33.40,1:49:35.40,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:49:35.52,1:49:39.48,Default,,0,0,0,,А-а... Ештеңені ойламаймын, сасқалақтап қаламын...
Dialogue: 0,1:49:39.61,1:49:41.40,Default,,0,0,0,,Менің өлгім келді
Dialogue: 0,1:49:41.95,1:49:44.36,Default,,0,0,0,,《Жоқ, жасама!》
Dialogue: 0,1:49:54.37,1:49:55.58,Default,,0,0,0,,Ақыры келгенде...
Dialogue: 0,1:49:55.71,1:49:58.59,Default,,0,0,0,,Соңында, менің ойымша, барлығы сол үшін болды.
Dialogue: 0,1:50:00.55,1:50:03.09,Default,,0,0,0,,Бүгін барлығын араластырып пісірейік.
Dialogue: 0,1:50:03.63,1:50:05.09,Default,,0,0,0,,Барлығы емес
Dialogue: 0,1:50:05.47,1:50:09.10,Default,,0,0,0,,Әлі ертең және одан кейінгі күн бар.
Dialogue: 0,1:50:12.60,1:50:13.85,Default,,0,0,0,,Ах (Мейко) Ах...
Dialogue: 0,1:50:14.94,1:50:18.11,Default,,0,0,0,,15 және 16 тамыз
Dialogue: 0,1:50:20.36,1:50:21.65,Default,,0,0,0,,17-ші
Dialogue: 0,1:50:23.40,1:50:24.61,Default,,0,0,0,,қыркүйек
Dialogue: 0,1:50:25.70,1:50:27.03,Default,,0,0,0,,қазан
Dialogue: 0,1:50:27.74,1:50:29.70,Default,,0,0,0,,Қарашада да, келесі жылы да
Dialogue: 0,1:50:30.66,1:50:33.12,Default,,0,0,0,,Келесі жыл және 10 жылдан кейін
Dialogue: 0,1:50:34.62,1:50:36.88,Default,,0,0,0,,мәңгілік
Dialogue: 0,1:50:44.72,1:50:45.88,Default,,0,0,0,,Кім? Сен бе?
Dialogue: 0,1:50:46.80,1:50:50.64,Default,,0,0,0,,Әй, таза ақ, жарқыраған.
Dialogue: 0,1:50:50.76,1:50:52.72,Default,,0,0,0,,Гарнир бәріне жарайды
Dialogue: 0,1:50:52.85,1:50:55.44,Default,,0,0,0,,Қандай Шусаку?
Dialogue: 0,1:50:55.60,1:50:56.60,Default,,0,0,0,,Өміріңде —
Dialogue: 0,1:50:56.90,1:51:01.32,Default,,0,0,0,,Осы кезде тәртіпті сақтау заңгердің міндеті ме?
Dialogue: 0,1:51:01.98,1:51:03.40,Default,,0,0,0,,Алдымен соны алайық.
Dialogue: 0,1:51:05.90,1:51:08.87,Default,,0,0,0,,Бомбалар енді құламайды, сондықтан балықтар жүзбейді.
Dialogue: 0,1:51:09.07,1:51:10.91,Default,,0,0,0,,Ол кезде емес
Dialogue: 0,1:51:11.03,1:51:14.50,Default,,0,0,0,,(Харумидің күлкісі)
Dialogue: 0,1:51:22.21,1:51:24.21,Default,,0,0,0,,Ха... (Энтаро) Не істеп жатырсың?
Dialogue: 0,1:51:24.34,1:51:26.51,Default,,0,0,0,,Қымбат ақ ас көрінбейді
Dialogue: 0,1:51:39.40,1:51:41.44,Default,,0,0,0,,Қону уақыты келді
Dialogue: 0,1:51:41.82,1:51:43.57,Default,,0,0,0,,Отакеге көшеміз
Dialogue: 0,1:51:44.36,1:51:47.65,Default,,0,0,0,,Әскери-теңіз күштері толығымен жойылмайынша, не болса да...
Dialogue: 0,1:51:47.78,1:51:50.78,Default,,0,0,0,,Тәртіпті сақтау заңгердің міндеті.
Dialogue: 0,1:51:51.53,1:51:55.41,Default,,0,0,0,,А... Қараңғыда екі қолым болса...
Dialogue: 0,1:51:55.54,1:52:00.33,Default,,0,0,0,,Мен бұл кісінің қобалжыған қолына ақырын ғана қолымды қоя алсам да.
Dialogue: 0,1:52:01.84,1:52:03.00,Default,,0,0,0,,Тыныш.
Dialogue: 0,1:52:03.13,1:52:04.50,Default,,0,0,0,,Барлығың дайындалыңдар.
Dialogue: 0,1:52:05.30,1:52:07.63,Default,,0,0,0,,Кешіріңіз, міне.
Dialogue: 0,1:52:08.34,1:52:09.26,Default,,0,0,0,,Иә?
Dialogue: 0,1:52:09.38,1:52:11.34,Default,,0,0,0,,Ха, балабақшаға ерте қайт.
Dialogue: 0,1:52:12.18,1:52:13.35,Default,,0,0,0,,Содан кейін
Dialogue: 0,1:52:16.27,1:52:20.15,Default,,0,0,0,,Мен бұл жерге Сузу-санмен міндетті түрде қайтамын.
Dialogue: 0,1:52:21.23,1:52:22.06,Default,,0,0,0,,Иә
Dialogue: 0,1:52:24.40,1:52:27.74,Default,,0,0,0,,Тұз бен соя соусы баяғыда кетті.
Dialogue: 0,1:52:33.16,1:52:34.28,Default,,0,0,0,,Әй, жеңгем
Dialogue: 0,1:52:34.41,1:52:37.45,Default,,0,0,0,,Ах, Сузу-сан, бұл қандай кезек?
Dialogue: 0,1:52:37.58,1:52:42.04,Default,,0,0,0,,Енді бәрі жақсы, ештеңе жетпейді.
Dialogue: 0,1:52:42.71,1:52:43.88,Default,,0,0,0,,Бұл тек менің алаңдаулы жүрегімді жеделдетті
Dialogue: 0,1:52:45.25,1:52:47.96,Default,,0,0,0,,Бірақ бұл қала да өзгерді.
Dialogue: 0,1:52:48.84,1:52:50.05,Default,,0,0,0,,Маған беріңіз
Dialogue: 0,1:52:50.18,1:52:52.89,Default,,0,0,0,,Менің ойымша, Хисао қазір де солай ете ме?
Dialogue: 0,1:52:53.89,1:52:55.10,Default,,0,0,0,,Қызық, Харуми де солай жасады ма?
Dialogue: 0,1:52:55.22,1:52:59.98,Default,,0,0,0,,Бұл басқыншы әскерден қалған күріш ботқасы еді. Ха...
Dialogue: 0,1:53:01.56,1:53:03.06,Default,,0,0,0,,Қағаз қалдықтары...
Dialogue: 0,1:53:05.02,1:53:05.90,Default,,0,0,0,,Уф
Dialogue: 0,1:53:09.53,1:53:10.40,Default,,0,0,0,,Уф
Dialogue: 0,1:53:11.03,1:53:13.49,Default,,0,0,0,,Уф уф...
Dialogue: 0,1:53:14.12,1:53:16.03,Default,,0,0,0,,Дәмді
Dialogue: 0,1:53:18.75,1:53:21.25,Default,,0,0,0,,Бұның дәмі мүлде жоқ.
Dialogue: 0,1:53:22.62,1:53:25.79,Default,,0,0,0,,Жүр, мен Америкаға жол көрсетемін.
Dialogue: 0,1:53:25.92,1:53:27.46,Default,,0,0,0,,Шоколад да балауыз
Dialogue: 0,1:53:27.59,1:53:31.30,Default,,0,0,0,,Сол шаш үлгісімен сіз мені бала деп қателесе аласыз.
Dialogue: 0,1:53:31.42,1:53:32.59,Default,,0,0,0,,Хаха...
Dialogue: 0,1:53:37.47,1:53:40.93,Default,,0,0,0,,Солай ма? сенімен киім айырбастау
Dialogue: 0,1:53:41.52,1:53:42.98,Default,,0,0,0,,Иә.
Dialogue: 0,1:53:43.52,1:53:45.02,Default,,0,0,0,,Сіз білмейсіз бе?
Dialogue: 0,1:53:45.48,1:53:50.24,Default,,0,0,0,,Маңайдағы мұражайда қайтыс болған солдат менің ұлым сияқты.
Dialogue: 0,1:53:51.19,1:53:54.11,Default,,0,0,0,,Мен бұл менің ұлым екенін түсінбедім.
Dialogue: 0,1:53:55.78,1:53:58.45,Default,,0,0,0,,Менің алдымда Харуми-санды да көрдің...
Dialogue: 0,1:53:59.62,1:54:02.46,Default,,0,0,0,,Иә, бұл ұят.
Dialogue: 0,1:54:06.08,1:54:07.13,Default,,0,0,0,,Қалайы
Dialogue: 0,1:54:09.13,1:54:10.21,Default,,0,0,0,,Қалайы
Dialogue: 0,1:54:11.13,1:54:14.93,Default,,0,0,0,,Мені есіңе алсаң, күл.
Dialogue: 0,1:54:17.64,1:54:21.43,Default,,0,0,0,,Осы дүниеде қалыпты және әдепті болыңыз.
Dialogue: 0,1:54:22.98,1:54:24.14,Default,,0,0,0,,Қалайы
Dialogue: 0,1:54:24.31,1:54:25.73,Default,,0,0,0,,Харуми-сан
Dialogue: 0,1:54:25.94,1:54:28.94,Default,,0,0,0,,Мен мұнда қандай кеме екенін көрдім, Харуми-сан.
Dialogue: 0,1:54:30.02,1:54:32.19,Default,,0,0,0,,Құлаған Аоба болды.
Dialogue: 0,1:54:35.03,1:54:36.28,Default,,0,0,0,,Тецу-сан
Dialogue: 0,1:54:36.78,1:54:39.49,Default,,0,0,0,,Енді күлкіңнің шетінде...
Dialogue: 0,1:54:39.74,1:54:45.50,Default,,0,0,0,,Қоян секірген теңіз, Құтандар өткен аспан қонды.
Dialogue: 0,1:54:45.62,1:54:49.92,Default,,0,0,0,,(Харумидің күлкісі)
Dialogue: 0,1:54:50.04,1:54:52.17,Default,,0,0,0,,Харуми-сан осылай күліп тұр.
Dialogue: 0,1:54:52.30,1:54:55.93,Default,,0,0,0,,Мен Харуми-санды күліп еске аламын.
Dialogue: 0,1:54:56.18,1:55:00.35,Default,,0,0,0,,Бұдан былай біз әрқашан күлкі контейнері боламыз.
Dialogue: 0,1:55:00.60,1:55:04.18,Default,,0,0,0,,Ей, үнемі жыласаң босқа.
Dialogue: 0,1:55:04.85,1:55:06.77,Default,,0,0,0,,Тұз жоқ
Dialogue: 0,1:55:07.23,1:55:08.06,Default,,0,0,0,,Тыныш, сендер!
Dialogue: 0,1:55:08.19,1:55:11.07,Default,,0,0,0,,Теңіздің тұзды суының әртүрлі түрлері бар.
Dialogue: 0,1:55:11.61,1:55:14.94,Default,,0,0,0,,Чизуко-чан апай
Dialogue: 0,1:55:15.70,1:55:17.57,Default,,0,0,0,,Иә (Чизуко) Сузу-чан
Dialogue: 0,1:55:19.87,1:55:21.12,Default,,0,0,0,,Суми-чан
Dialogue: 0,1:55:21.37,1:55:23.08,Default,,0,0,0,,Ах! Сузу-чан
Dialogue: 0,1:55:23.49,1:55:25.37,Default,,0,0,0,,Мен шашымды қимадым.
Dialogue: 0,1:55:25.50,1:55:28.88,Default,,0,0,0,,Yes, yes, wake up, are you sick?
Dialogue: 0,1:55:29.17,1:55:31.17,Default,,0,0,0,,Менің басым айналады.
Dialogue: 0,1:55:31.29,1:55:32.13,Default,,0,0,0,,А...
Dialogue: 0,1:55:32.25,1:55:34.80,Default,,0,0,0,,Әй, не деген ұят, апа.
Dialogue: 0,1:55:34.92,1:55:39.18,Default,,0,0,0,,Under this cold sky, Nori's work will help
Dialogue: 0,1:55:41.22,1:55:44.39,Default,,0,0,0,,Бұл ересек адам ретінде ұйықтау керек дегенді білдіреді.
Dialogue: 0,1:55:46.85,1:55:48.48,Default,,0,0,0,,Хехе...
Dialogue: 0,1:55:48.60,1:55:49.85,Default,,0,0,0,,Ah, if only I had a hand.
Dialogue: 0,1:55:49.98,1:55:54.53,Default,,0,0,0,,Сіз тіпті ағаңыздың Оңтүстік теңізіндегі шытырман оқиғаларын суреттей аласыз.
Dialogue: 0,1:55:54.86,1:55:57.95,Default,,0,0,0,,Ол қандай? Әй, не әңгіме?
Dialogue: 0,1:55:58.07,1:56:01.87,Default,,0,0,0,,Үлкен аға, көлік кемесі апатқа ұшырады.
Dialogue: 0,1:56:02.58,1:56:06.16,Default,,0,0,0,,Оңтүстік аралда пальма жапырақтарынан үй тұрғызу
Dialogue: 0,1:56:06.87,1:56:11.13,Default,,0,0,0,,Барлығына сақал қойып, қолтырауынды әйел етіп ал
Dialogue: 0,1:56:11.25,1:56:13.63,Default,,0,0,0,,Is the crocodile your wife?
Dialogue: 0,1:56:14.92,1:56:17.88,Default,,0,0,0,,Why don't you go back to Enami, brother?
Dialogue: 0,1:56:18.22,1:56:19.76,Default,,0,0,0,,Анам да
Dialogue: 0,1:56:19.88,1:56:20.97,Default,,0,0,0,,Иә?
Dialogue: 0,1:56:21.18,1:56:26.39,Default,,0,0,0,,Сол күні таңертең мерекеге дайындалу үшін анам қалаға жұмыс істеуге кетті.
Dialogue: 0,1:56:27.56,1:56:30.40,Default,,0,0,0,,Әкем екеуміз оны іздедік, бірақ...
Dialogue: 0,1:56:30.52,1:56:32.52,Default,,0,0,0,,Мен оны таба алмадым.
Dialogue: 0,1:56:32.86,1:56:36.82,Default,,0,0,0,,Әке, ол қазан айында құлап, бірден өлетін еді.
Dialogue: 0,1:56:37.11,1:56:39.90,Default,,0,0,0,,Мен олардың барлығын мектепте пісіретін едім.
Dialogue: 0,1:56:40.20,1:56:43.20,Default,,0,0,0,,Сізге хабарлауға уақыт алғаным үшін кешірім сұраймыз.
Dialogue: 0,1:56:44.66,1:56:47.50,Default,,0,0,0,,Sorry for not coming early.
Dialogue: 0,1:56:47.87,1:56:50.12,Default,,0,0,0,,I'm glad you came early.
Dialogue: 0,1:56:50.79,1:56:54.00,Default,,0,0,0,,Сузу-чан, мынау сияқты
Dialogue: 0,1:56:54.54,1:56:56.75,Default,,0,0,0,,Емдейтінін білмеймін.
Dialogue: 0,1:56:56.88,1:56:59.42,Default,,0,0,0,,It'll heal, it'll be weird if it doesn't.
Dialogue: 0,1:57:06.39,1:57:08.31,Default,,0,0,0,,Ах! Сачико-сан!
Dialogue: 0,1:57:09.60,1:57:10.77,Default,,0,0,0,,Жоқ (әйел) А...
Dialogue: 0,1:57:13.86,1:57:16.40,Default,,0,0,0,,Kiyoko-Сан Isn't that Kiyoko-Сан?
Dialogue: 0,1:57:18.48,1:57:22.49,Default,,0,0,0,,Бұл қалада барлығы біреуді жоғалтып алып, іздеп жүр.
Dialogue: 0,1:57:23.07,1:57:27.04,Default,,0,0,0,,Мен де Рин-санды бір-екі рет көргендей болдым.
Dialogue: 0,1:57:27.16,1:57:28.45,Default,,0,0,0,,Хаа…
Dialogue: 0,1:57:29.00,1:57:30.20,Default,,0,0,0,,Сузу-сан
Dialogue: 0,1:57:31.54,1:57:34.79,Default,,0,0,0,,Oh, I hope you're safe.
Dialogue: 0,1:57:35.42,1:57:39.30,Default,,0,0,0,,Әскери-теңіз күштері де қараша айының соңына дейін оларға қызмет етпейтінін айтты.
Dialogue: 0,1:57:40.72,1:57:41.88,Default,,0,0,0,,Сузу-сан
Dialogue: 0,1:57:42.72,1:57:46.97,Default,,0,0,0,,Осы көпірде мен және Сузу алғаш рет кездестік.
Dialogue: 0,1:57:48.26,1:57:50.27,Default,,0,0,0,,I'll never go back to those days
Dialogue: 0,1:57:50.89,1:57:54.48,Default,,0,0,0,,Бұл қала және біз өзгереміз...
Dialogue: 0,1:57:54.65,1:57:56.56,Default,,0,0,0,,I can always understand Suzu-Сан.
Dialogue: 0,1:57:57.44,1:58:00.28,Default,,0,0,0,,Бұл жерде мең бар, оны бірден көруге болады.
Dialogue: 0,1:58:01.44,1:58:03.53,Default,,0,0,0,,Рахмет Шусаку-сан
Dialogue: 0,1:58:03.86,1:58:07.41,Default,,0,0,0,,Бізді әлемнің осы бұрышынан тапқаны үшін
Dialogue: 0,1:58:07.87,1:58:12.37,Default,,0,0,0,,Өтінемін, қазір мені тастап, мәңгі қасымда бол.
Dialogue: 0,1:58:13.37,1:58:15.04,Default,,0,0,0,,Иә? иә?
Dialogue: 0,1:58:37.23,1:58:39.77,Default,,0,0,0,,(Жарылыс дыбысы)
Dialogue: 0,1:58:39.90,1:58:44.82,Default,,0,0,0,,Хаа һаа һаа…
Dialogue: 0,1:58:55.50,1:58:59.84,Default,,0,0,0,,Ууууууууууу...
Dialogue: 0,1:59:24.32,1:59:26.24,Default,,0,0,0,,Ах (Шусаку) Иә, иә
Dialogue: 0,1:59:26.40,1:59:29.87,Default,,0,0,0,,Қалай болғанда да, мен Хиросимада жұмыс тапқаныма қуаныштымын.
Dialogue: 0,1:59:29.99,1:59:30.99,Default,,0,0,0,,Иә
Dialogue: 0,1:59:34.08,1:59:36.96,Default,,0,0,0,,Бірақ бұл алыс және қиын.
Dialogue: 0,1:59:37.25,1:59:39.38,Default,,0,0,0,,Біз... у...
Dialogue: 0,1:59:42.96,1:59:46.22,Default,,0,0,0,,Рахмет, тамақ ішіңіз.
Dialogue: 0,1:59:46.80,1:59:50.01,Default,,0,0,0,,Мен үйден шығып, осында отбасын құруым керек пе?
Dialogue: 0,1:59:50.80,1:59:53.18,Default,,0,0,0,,Мұнда сенің енең мен Суми-сан да бар.
Dialogue: 0,1:59:53.68,1:59:57.77,Default,,0,0,0,,Жоқ, мен сонда барамын.
Dialogue: 0,1:59:57.98,2:00:03.32,Default,,0,0,0,,Мен Хиросима үшін алаңдаймын, бірақ Куре - біз таңдаған жер.
Dialogue: 0,2:00:04.98,2:00:05.94,Default,,0,0,0,,Иә...
Dialogue: 0,2:00:13.78,2:00:14.79,Default,,0,0,0,,Иә
Dialogue: 0,2:00:23.84,2:00:27.22,Default,,0,0,0,,Ву~ Ву~
Dialogue: 0,2:00:27.34,2:00:28.47,Default,,0,0,0,,Ву?
Dialogue: 0,2:00:28.80,2:00:31.22,Default,,0,0,0,,Иә, бұл Күре.
Dialogue: 0,2:00:31.59,2:00:36.27,Default,,0,0,0,,Ол тоғыз жотамен қорғалған.
Dialogue: 0,2:00:36.93,2:00:41.73,Default,,0,0,0,,Оң жақтағы - тыныш тау, сол жақта - Хачимаки тауы
Dialogue: 0,2:00:43.15,2:00:46.69,Default,,0,0,0,,Хайгаминнің ортаңғы шыңы
Dialogue: 0,2:00:49.99,2:00:53.07,Default,,0,0,0,,Ол юбка біздің үйде.
Dialogue: 0,2:01:02.04,2:01:03.38,Default,,0,0,0,,Бұл бала...
Dialogue: 0,2:01:03.75,2:01:04.75,Default,,0,0,0,,Иә
Dialogue: 0,2:01:05.38,2:01:07.59,Default,,0,0,0,,Қорқынышты бит.
Dialogue: 0,2:01:08.26,2:01:12.09,Default,,0,0,0,,Үлкен қазанға суды қайнатып, бәрін қайнатыңыз.
Dialogue: 0,2:01:12.47,2:01:13.97,Default,,0,0,0,,Әзірше жуынып алайық.
Dialogue: 0,2:01:14.51,2:01:17.22,Default,,0,0,0,,Бұл бала соңында жақсырақ емес пе?
Dialogue: 0,2:01:17.35,2:01:19.02,Default,,0,0,0,,Жарайды, бәрібір ваннаға түс.
Dialogue: 0,2:01:20.43,2:01:23.52,Default,,0,0,0,,Харумидің былтырғы киімдері жеткіліксіз.
Dialogue: 0,2:01:48.67,2:01:53.68,Default,,0,0,0,,♪~
Dialogue: 0,2:06:11.14,2:06:16.15,Default,,0,0,0,,~♪
Dialogue: 0,2:06:18.23,2:06:23.24,Default,,0,0,0,,♪~
Dialogue: 0,2:09:09.49,2:09:14.49,Default,,0,0,0,,~♪
