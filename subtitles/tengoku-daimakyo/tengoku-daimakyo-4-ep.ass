Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:06.21,0:00:07.21,Default,,0,0,0,,Каннибализм
Dialogue: 0,0:00:07.29,0:00:08.84,Default,,0,0,0,,Уау... Уау
Dialogue: 0,0:00:08.92,0:00:10.55,Default,,0,0,0,,Нашар Мен бәрін білуім керек!
Dialogue: 0,0:00:12.42,0:00:13.13,Default,,0,0,0,,Дөңгелек үй!
Dialogue: 0,0:00:13.22,0:00:14.30,Default,,0,0,0,,Не, сен өз бетімен істеп жатырсың...
Dialogue: 0,0:00:14.38,0:00:16.85,Default,,0,0,0,,Кемеге адам жегіштер шабуыл жасауда. Жылдамдаңыз!
Dialogue: 0,0:00:16.93,0:00:18.18,Default,,0,0,0,,Не!
Dialogue: 0,0:00:19.31,0:00:21.56,Default,,0,0,0,,Үлкен әпке осында! Апыр-ай!
Dialogue: 0,0:00:24.27,0:00:25.27,Default,,0,0,0,,Жеңдер!
Dialogue: 0,0:00:29.52,0:00:31.15,Default,,0,0,0,,Замамиро!
Dialogue: 0,0:00:35.82,0:00:36.74,Default,,0,0,0,,Уф...
Dialogue: 0,0:00:37.37,0:00:38.53,Default,,0,0,0,,Шынайы ма?
Dialogue: 0,0:00:41.49,0:00:45.50,Default,,0,0,0,,♪~
Dialogue: 0,0:02:05.54,0:02:09.54,Default,,0,0,0,,~♪
Dialogue: 0,0:02:12.34,0:02:14.88,Default,,0,0,0,,Ах… Хехе…
Dialogue: 0,0:02:15.71,0:02:17.34,Default,,0,0,0,,Куку ха... аа...
Dialogue: 0,0:02:18.72,0:02:21.18,Default,,0,0,0,,Сізді ешкім таппай келе алдыңыз ба?
Dialogue: 0,0:02:21.76,0:02:22.76,Default,,0,0,0,,Иә
Dialogue: 0,0:02:22.85,0:02:26.06,Default,,0,0,0,,Олай болса, кеттік! нәрестені көру үшін
Dialogue: 0,0:02:26.14,0:02:28.06,Default,,0,0,0,,Хмм... ой...
Dialogue: 0,0:02:29.64,0:02:30.94,Default,,0,0,0,,Фуфуфу…
Dialogue: 0,0:02:36.28,0:02:37.36,Default,,0,0,0,,Міне!
Dialogue: 0,0:02:38.07,0:02:39.07,Default,,0,0,0,,«Аздап жұмсауға да болар...» деп ойладым.
Dialogue: 0,0:02:39.86,0:02:41.32,Default,,0,0,0,,Менің артымнан жүр, иә?
Dialogue: 0,0:02:41.87,0:02:42.87,Default,,0,0,0,,Иә!
Dialogue: 0,0:02:44.91,0:02:46.20,Default,,0,0,0,,иә иә...
Dialogue: 0,0:02:46.29,0:02:47.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:02:47.45,0:02:49.33,Default,,0,0,0,,иә... иә
Dialogue: 0,0:02:50.17,0:02:51.58,Default,,0,0,0,,Осы жерден кетейік!
Dialogue: 0,0:02:51.67,0:02:53.96,Default,,0,0,0,,А... ә...
Dialogue: 0,0:02:56.50,0:02:57.51,Default,,0,0,0,,Мен... ха!
Dialogue: 0,0:02:59.05,0:03:00.22,Default,,0,0,0,,Уф
Dialogue: 0,0:03:00.30,0:03:01.72,Default,,0,0,0,,Ах...
Dialogue: 0,0:03:02.39,0:03:04.26,Default,,0,0,0,,Сіз мұны істей аласыз ба! Міне бітті!
Dialogue: 0,0:03:05.72,0:03:07.64,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:03:15.23,0:03:16.86,Default,,0,0,0,,Эй, сен бұрын біртүрлі дыбыс естідің ғой, солай ма?
Dialogue: 0,0:03:17.44,0:03:19.07,Default,,0,0,0,,Ах... бұл рас.
Dialogue: 0,0:03:19.15,0:03:21.86,Default,,0,0,0,,Жарайды, қарашы. (Оқушы) Бұл қауіпті. Тоқта.
Dialogue: 0,0:03:21.95,0:03:23.49,Default,,0,0,0,,Иә! (Оқушы) Уау!
Dialogue: 0,0:03:24.57,0:03:25.37,Default,,0,0,0,,(дыбыстық сигнал)
Dialogue: 0,0:03:25.45,0:03:27.49,Default,,0,0,0,,Қалыпты емес мінез-құлықты анықтау
Dialogue: 0,0:03:27.58,0:03:30.12,Default,,0,0,0,,Сұңқыр әрқашан бақытты.
Dialogue: 0,0:03:32.62,0:03:33.33,Default,,0,0,0,,(дыбыстық сигнал)
Dialogue: 0,0:03:33.42,0:03:35.92,Default,,0,0,0,,Жақын контактіні 10 секунд немесе одан да көп уақытқа растаңыз
Dialogue: 0,0:03:36.00,0:03:37.88,Default,,0,0,0,,Нанаки мен Ива тағы да?
Dialogue: 0,0:03:37.96,0:03:41.09,Default,,0,0,0,,Сіз қандай эмоцияларды ұстайсыз...
Dialogue: 0,0:03:41.17,0:03:43.01,Default,,0,0,0,,Бірақ бұл біртүрлі.
Dialogue: 0,0:03:43.09,0:03:45.68,Default,,0,0,0,,Мен саған ондай білім бермеген болсам да.
Dialogue: 0,0:03:45.76,0:03:46.89,Default,,0,0,0,,Ах
Dialogue: 0,0:03:45.76,0:03:49.89,Default,,0,0,0,,(жылдам сигнал)
Dialogue: 0,0:03:46.97,0:03:49.89,Default,,0,0,0,,Дене жағдайының ықтимал нашарлауын анықтау
Dialogue: 0,0:03:49.97,0:03:52.77,Default,,0,0,0,,Қоғамдық денсаулық сақтау қызметкері Тараоның жағдайын дереу тексеріңіз
Dialogue: 0,0:03:53.35,0:03:55.10,Default,,0,0,0,,Қазіргі уақытта медбике жауап беруде.
Dialogue: 0,0:03:55.19,0:03:56.52,Default,,0,0,0,,Мен жақында барамын.
Dialogue: 0,0:03:56.61,0:03:59.28,Default,,0,0,0,,Келіңдер, бірге болыңдар.
Dialogue: 0,0:03:59.36,0:04:01.74,Default,,0,0,0,,Жарайды, жоғарыға шық.
Dialogue: 0,0:04:02.24,0:04:03.24,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:04:03.32,0:04:05.49,Default,,0,0,0,,Сен жақсы нәрсе ойладың, Токио!
Dialogue: 0,0:04:05.57,0:04:07.99,Default,,0,0,0,,Така бұл идеяны ұсынды.
Dialogue: 0,0:04:11.79,0:04:12.87,Default,,0,0,0,,(дыбыстық сигнал)
Dialogue: 0,0:04:12.96,0:04:15.08,Default,,0,0,0,,Жақсы, Токио
Dialogue: 0,0:04:15.83,0:04:16.96,Default,,0,0,0,,матрац ұратын таяқпен қатты ұрсаңдар ма?
Dialogue: 0,0:04:17.46,0:04:18.67,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:19.80,0:04:20.67,Default,,0,0,0,,Ах!
Dialogue: 0,0:04:19.80,0:04:21.38,Default,,0,0,0,,Оны іздеп көрейік
Dialogue: 0,0:04:21.46,0:04:23.84,Default,,0,0,0,,Ахаха (2-оқушы) А, сонда қайда?
Dialogue: 0,0:04:24.84,0:04:26.26,Default,,0,0,0,,Токио! иә?
Dialogue: 0,0:04:26.84,0:04:27.97,Default,,0,0,0,,Не болды, Ниа?
Dialogue: 0,0:04:28.05,0:04:29.06,Default,,0,0,0,,Иә
Dialogue: 0,0:04:31.35,0:04:35.60,Default,,0,0,0,,Мен қазір сырттамын, солай емес пе?
Dialogue: 0,0:04:42.69,0:04:44.15,Default,,0,0,0,,Ішке кірсең бітті.
Dialogue: 0,0:04:45.28,0:04:47.62,Default,,0,0,0,,Жас ханым, мені тағы бір рет қуып жібере алмайсыз ба?
Dialogue: 0,0:04:47.70,0:04:51.24,Default,,0,0,0,,Олай болса, барлығы есікті жауып, айнала алады.
Dialogue: 0,0:04:51.33,0:04:52.29,Default,,0,0,0,,Бұл мүмкін емес.
Dialogue: 0,0:04:52.37,0:04:54.04,Default,,0,0,0,,Енді оқ жоқ
Dialogue: 0,0:04:54.75,0:04:57.75,Default,,0,0,0,,Ал мен кеменің бұралғанын немесе тот басқанын білмеймін.
Dialogue: 0,0:04:57.83,0:04:59.96,Default,,0,0,0,,Мүлде қозғалмайтын есік бар.
Dialogue: 0,0:05:00.46,0:05:03.46,Default,,0,0,0,,Менің ойымша, бұл жерде тосқауыл қоюдан басқа амалым жоқ...
Dialogue: 0,0:05:03.55,0:05:05.55,Default,,0,0,0,,Құрлыққа қанша уақыт жетеді?
Dialogue: 0,0:05:05.63,0:05:07.64,Default,,0,0,0,,30 минут асығыс
Dialogue: 0,0:05:08.22,0:05:09.43,Default,,0,0,0,,Менде бар ма екен...
Dialogue: 0,0:05:10.72,0:05:12.02,Default,,0,0,0,,Уау! мм...
Dialogue: 0,0:05:13.56,0:05:15.31,Default,,0,0,0,,Мен оны аламын деп ойламаймын.
Dialogue: 0,0:05:15.48,0:05:16.39,Default,,0,0,0,,Фалько…
Dialogue: 0,0:05:16.98,0:05:18.35,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:05:18.44,0:05:23.78,Default,,0,0,0,,Сол балыққа тез қарасам, қабырғаға жабысқан сансыз қолды көрдім.
Dialogue: 0,0:05:23.86,0:05:26.90,Default,,0,0,0,,Денеңіздің айналасындағы су костюмін майлаушы ретінде қолданыңыз.
Dialogue: 0,0:05:26.99,0:05:28.66,Default,,0,0,0,,Құрлықта да қозғалады
Dialogue: 0,0:05:29.53,0:05:32.08,Default,,0,0,0,,Шабуыл мен қозғалыс үшін су костюміне сеніңіз
Dialogue: 0,0:05:33.12,0:05:35.16,Default,,0,0,0,,Онымен күресетін ең жақсы жер қай жерде?
Dialogue: 0,0:05:35.75,0:05:38.29,Default,,0,0,0,,Су... жерді толтыра алмайсыз ба?
Dialogue: 0,0:05:39.13,0:05:41.34,Default,,0,0,0,,Неғұрлым күрделі болса, соғұрлым жақсы.
Dialogue: 0,0:05:41.75,0:05:43.92,Default,,0,0,0,,Қозғалыс пен шабуылдар сызықты
Dialogue: 0,0:05:45.13,0:05:46.34,Default,,0,0,0,,Біз кеменің ішінде шайқасамыз.
Dialogue: 0,0:05:46.42,0:05:47.84,Default,,0,0,0,,Кеме ішінде?
Dialogue: 0,0:05:48.43,0:05:51.35,Default,,0,0,0,,Сәлем! Мұнда есік бар, солай ма?
Dialogue: 0,0:05:48.89,0:05:49.68,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:51.43,0:05:53.01,Default,,0,0,0,,Маған кілтті сол жерде беріңіз.
Dialogue: 0,0:05:53.10,0:05:54.02,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:54.10,0:05:55.14,Default,,0,0,0,,Неліктен?
Dialogue: 0,0:05:55.22,0:05:56.93,Default,,0,0,0,,Өлгің келмесе, ынтымақтас!
Dialogue: 0,0:05:57.02,0:05:59.02,Default,,0,0,0,,Бұл жұмыс істемейді (Кирко/Хенчман) Иә?
Dialogue: 0,0:05:59.69,0:06:01.86,Default,,0,0,0,,Кілт қажет емес!
Dialogue: 0,0:06:02.44,0:06:03.90,Default,,0,0,0,,Оны қабылдамаңыз!
Dialogue: 0,0:06:05.15,0:06:06.19,Default,,0,0,0,,Эрвиннің бөлімшесінен келгендер, қатты кешігіпсіңдер ғой.
Dialogue: 0,0:06:07.78,0:06:09.41,Default,,0,0,0,,Әпке, күте тұрыңыз!
Dialogue: 0,0:06:09.49,0:06:11.49,Default,,0,0,0,,Өлтіретін сәуле жоқ, қалай?!
Dialogue: 0,0:06:12.24,0:06:13.28,Default,,0,0,0,,«Multouch» бар
Dialogue: 0,0:06:13.87,0:06:14.95,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:16.04,0:06:17.04,Default,,0,0,0,,…Солай ма?
Dialogue: 0,0:06:18.29,0:06:19.71,Default,,0,0,0,,Сіз оны түртіп, өлтіресіз.
Dialogue: 0,0:06:19.79,0:06:20.46,Default,,0,0,0,,Сізде басқа туыстарыңыз жоқ па?
Dialogue: 0,0:06:21.29,0:06:22.38,Default,,0,0,0,,Ах...
Dialogue: 0,0:06:23.38,0:06:26.05,Default,,0,0,0,,! Жоспар жоқ дерлік, иә?
Dialogue: 0,0:06:30.68,0:06:34.18,Default,,0,0,0,,Сәлем! Бұл осылай! Кәне!
Dialogue: 0,0:06:40.02,0:06:43.44,Default,,0,0,0,,Келді... Міне, келді!
Dialogue: 0,0:06:43.52,0:06:44.57,Default,,0,0,0,,Уау!
Dialogue: 0,0:06:44.77,0:06:46.03,Default,,0,0,0,,Тыңдаңыз!
Dialogue: 0,0:06:49.36,0:06:51.24,Default,,0,0,0,,Уау! Қорап кептелісі!
Dialogue: 0,0:06:51.32,0:06:52.74,Default,,0,0,0,,Тез көтеріл!
Dialogue: 0,0:06:52.82,0:06:54.45,Default,,0,0,0,,Бұл психологиялық шабуыл ма? Әлде қудалау ма!
Dialogue: 0,0:06:55.12,0:06:57.62,Default,,0,0,0,,Уау... Ах!
Dialogue: 0,0:06:57.70,0:06:58.70,Default,,0,0,0,,Аһ!
Dialogue: 0,0:07:02.50,0:07:03.25,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:07:06.42,0:07:08.13,Default,,0,0,0,,Ақымақ! Босқа түсіру!
Dialogue: 0,0:07:08.21,0:07:10.93,Default,,0,0,0,,Уф! Әпке ашты!
Dialogue: 0,0:07:11.01,0:07:12.18,Default,,0,0,0,,Бұл психологиялық шабуыл ма? Әлде қудалау ма!
Dialogue: 0,0:07:12.26,0:07:15.72,Default,,0,0,0,,Екеуін де ашпасаң, балық өте алмайды!
Dialogue: 0,0:07:16.51,0:07:17.68,Default,,0,0,0,,Сізге өтудің қажеті жоқ, солай ма?
Dialogue: 0,0:07:17.77,0:07:19.39,Default,,0,0,0,,Маған адамдарды жеткізу қиынға соғып жатыр!
Dialogue: 0,0:07:19.48,0:07:20.18,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:21.06,0:07:23.81,Default,,0,0,0,,Ой... сұмдық! Бұл жер де жәшіктерге толы!
Dialogue: 0,0:07:23.90,0:07:25.19,Default,,0,0,0,,Жарайды, ішке кір! Ей!
Dialogue: 0,0:07:25.52,0:07:29.28,Default,,0,0,0,,Қарғыс атсын! Қалай күресу керектігін ойлаудың қажеті жоқ.
Dialogue: 0,0:07:33.07,0:07:34.87,Default,,0,0,0,,Уф... Ах!
Dialogue: 0,0:07:34.95,0:07:35.99,Default,,0,0,0,,Хмф!
Dialogue: 0,0:07:36.66,0:07:37.99,Default,,0,0,0,,Егер Ұйым біздің құпиямызды біліп қалса, не істейміз!
Dialogue: 0,0:07:38.58,0:07:39.58,Default,,0,0,0,,Есік!
Dialogue: 0,0:07:40.96,0:07:43.67,Default,,0,0,0,,Бір минут күтіңіз, бұл есік... ашылмайды!
Dialogue: 0,0:07:44.13,0:07:44.92,Default,,0,0,0,,Ой, жоқ!
Dialogue: 0,0:07:46.25,0:07:47.34,Default,,0,0,0,,Гррр…
Dialogue: 0,0:07:49.01,0:07:50.76,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:51.38,0:07:52.22,Default,,0,0,0,,♬ Мен бара жатқан жер — әлі көрінбеген тағдыр
Dialogue: 0,0:07:52.30,0:07:54.55,Default,,0,0,0,,Мару Оны ашудың қажеті жоқ!
Dialogue: 0,0:07:54.64,0:07:55.34,Default,,0,0,0,,Уф...
Dialogue: 0,0:07:55.97,0:07:58.26,Default,,0,0,0,,Апа, қауіпті, ашылмайды...!
Dialogue: 0,0:07:58.76,0:08:00.48,Default,,0,0,0,,Оны ашудың қажеті жоқ.
Dialogue: 0,0:08:00.56,0:08:01.31,Default,,0,0,0,,Өзіңді тым жоғары қоя бастадың.
Dialogue: 0,0:08:07.32,0:08:09.23,Default,,0,0,0,,Не? Не болып жатыр?
Dialogue: 0,0:08:09.57,0:08:10.49,Default,,0,0,0,,А... А?
Dialogue: 0,0:08:10.57,0:08:14.03,Default,,0,0,0,,Бұл кемеде марихуананың көп мөлшері болуы керек.
Dialogue: 0,0:08:14.11,0:08:17.62,Default,,0,0,0,,Жоғарыдағы еден көкөністерге толы болды.
Dialogue: 0,0:08:18.33,0:08:20.33,Default,,0,0,0,,Шектеу аймағынан тыс
Dialogue: 0,0:08:20.41,0:08:23.37,Default,,0,0,0,,Мен марихуананың қораптары көп деп ойладым.
Dialogue: 0,0:08:24.04,0:08:28.42,Default,,0,0,0,,Бұл жігітті көп картон мен кептірілген каннабис сусыз қалдырды.
Dialogue: 0,0:08:30.00,0:08:32.30,Default,,0,0,0,,Жай жағадағы балық
Dialogue: 0,0:08:36.26,0:08:38.93,Default,,0,0,0,,Хехе... Мен жеңдім.
Dialogue: 0,0:08:43.43,0:08:46.65,Default,,0,0,0,,Жарайды, мен аяқтауыңызды сұраймын.
Dialogue: 0,0:08:47.31,0:08:49.82,Default,,0,0,0,,Адамды өлтіру сәулесісіз қалай өлтіруге болады?
Dialogue: 0,0:08:49.90,0:08:52.90,Default,,0,0,0,,Осындай кезде тек жау ғана көрінсе, жақсы емес.
Dialogue: 0,0:08:53.61,0:08:57.78,Default,,0,0,0,,Тыныштық сақтап, айналаңыздан мүмкіндігінше көбірек ақпарат алу арқылы жеңесіз.
Dialogue: 0,0:09:00.37,0:09:02.25,Default,,0,0,0,,Мен осылай өмір сүрдім
Dialogue: 0,0:09:03.75,0:09:06.08,Default,,0,0,0,,Күрсіну... Сонда да қорқынышты.
Dialogue: 0,0:09:06.62,0:09:07.46,Default,,0,0,0,,Иә?
Dialogue: 0,0:09:07.54,0:09:11.63,Default,,0,0,0,,Мен өлтіру сәулесін кешіре алсам да, тым нашар.
Dialogue: 0,0:09:12.13,0:09:13.09,Default,,0,0,0,,Сіз не туралы айтып отырсыз?
Dialogue: 0,0:09:13.17,0:09:15.63,Default,,0,0,0,,Бұл сіздің әпкеңіздің ат қою мағынасы!
Dialogue: 0,0:09:18.97,0:09:21.43,Default,,0,0,0,,Қараңғы болды.
Dialogue: 0,0:09:21.51,0:09:23.52,Default,,0,0,0,,Біз жақындап қалдық! Қараңдар!
Dialogue: 0,0:09:23.60,0:09:24.27,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:27.94,0:09:29.77,Default,,0,0,0,,Жарайды, ешкім жоқ.
Dialogue: 0,0:09:29.86,0:09:31.44,Default,,0,0,0,,Онда біреу бар ма?
Dialogue: 0,0:09:31.94,0:09:35.53,Default,,0,0,0,,Директор, белгісіз ересек және т.б.
Dialogue: 0,0:09:35.99,0:09:36.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:09:39.07,0:09:39.82,Default,,0,0,0,,Незуко! Жоқ, жасама!
Dialogue: 0,0:09:39.91,0:09:41.99,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:09:42.87,0:09:46.79,Default,,0,0,0,,Бұл... мектептен тыс жерде ме? Ішінде?
Dialogue: 0,0:09:46.87,0:09:47.87,Default,,0,0,0,,Қараңдар! иә?
Dialogue: 0,0:09:48.87,0:09:50.50,Default,,0,0,0,,Нағыз сәби
Dialogue: 0,0:09:52.25,0:09:53.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:09:57.84,0:09:58.97,Default,,0,0,0,,Бұл...
Dialogue: 0,0:09:59.97,0:10:00.97,Default,,0,0,0,,Бала…
Dialogue: 0,0:10:05.52,0:10:06.43,Default,,0,0,0,,Ах...
Dialogue: 0,0:10:09.77,0:10:10.94,Default,,0,0,0,,А...
Dialogue: 0,0:10:15.74,0:10:16.99,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:10:18.70,0:10:20.87,Default,,0,0,0,,Күрсін...!
Dialogue: 0,0:10:25.79,0:10:27.79,Default,,0,0,0,,Уау!
Dialogue: 0,0:10:25.79,0:10:29.25,Default,,0,0,0,,Зиянкестерді анықтау Зиянкестерді анықтау
Dialogue: 0,0:10:27.87,0:10:29.25,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:29.33,0:10:30.21,Default,,0,0,0,,Токио!
Dialogue: 0,0:10:30.29,0:10:32.13,Default,,0,0,0,,Иә... иә!
Dialogue: 0,0:10:30.29,0:10:32.96,Default,,0,0,0,,Өрлеу бөлмесі Көтерілу бөлмесі
Dialogue: 0,0:10:32.21,0:10:34.09,Default,,0,0,0,,Уау! Ха...
Dialogue: 0,0:10:34.96,0:10:37.26,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:10:39.93,0:10:45.68,Default,,0,0,0,,(Дабыл дыбысы)
Dialogue: 0,0:10:41.01,0:10:41.89,Default,,0,0,0,,Иә?
Dialogue: 0,0:10:41.97,0:10:47.27,Default,,0,0,0,,Зиянкестерді анықтау Зиянкестерді анықтау Көтерілу бөлмесі
Dialogue: 0,0:10:47.93,0:10:49.31,Default,,0,0,0,,Не? Қазір ескерту!
Dialogue: 0,0:10:49.39,0:10:51.94,Default,,0,0,0,,Түсінбедім, бірінші рет естіп тұрмын.
Dialogue: 0,0:10:52.31,0:10:53.36,Default,,0,0,0,,Зиянкесуші дегеніміз не?
Dialogue: 0,0:10:53.44,0:10:54.57,Default,,0,0,0,,Әйтеуір, ішке кір.
Dialogue: 0,0:10:54.23,0:10:54.94,Default,,0,0,0,,(дыбыстық сигнал)
Dialogue: 0,0:10:57.40,0:11:00.32,Default,,0,0,0,,Уф... уф...
Dialogue: 0,0:11:00.40,0:11:01.57,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:11:04.87,0:11:05.87,Default,,0,0,0,,Хмм...
Dialogue: 0,0:11:06.37,0:11:07.37,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:08.62,0:11:09.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:11:10.79,0:11:12.58,Default,,0,0,0,,Хаа... хаа... Иә?
Dialogue: 0,0:11:11.71,0:11:12.58,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:11:13.46,0:11:14.79,Default,,0,0,0,,Не болды?
Dialogue: 0,0:11:14.88,0:11:15.46,Default,,0,0,0,,Ах!
Dialogue: 0,0:11:16.25,0:11:18.09,Default,,0,0,0,,Мұнда зиянкес туралы ескерту бар!
Dialogue: 0,0:11:19.38,0:11:21.38,Default,,0,0,0,,Мен де естідім.
Dialogue: 0,0:11:21.88,0:11:23.47,Default,,0,0,0,,Мен қазір тексеремін
Dialogue: 0,0:11:24.14,0:11:24.97,Default,,0,0,0,,Монитор бөлмесі
Dialogue: 0,0:11:25.47,0:11:27.47,Default,,0,0,0,,Біз де тексеріп жатырмыз...
Dialogue: 0,0:11:27.56,0:11:30.10,Default,,0,0,0,,Нақты кірудің дәлелі жоқ
Dialogue: 0,0:11:30.77,0:11:34.61,Default,,0,0,0,,Тексеруді жалғастырамыз, бірақ бұл ақаулық болуы мүмкін.
Dialogue: 0,0:11:36.94,0:11:38.94,Default,,0,0,0,,Менің ойымша, олар бізді тапты
Dialogue: 0,0:11:39.03,0:11:41.53,Default,,0,0,0,,Токио тез
Dialogue: 0,0:11:42.11,0:11:44.32,Default,,0,0,0,,Хмм... Куку... Арх!
Dialogue: 0,0:11:45.53,0:11:47.70,Default,,0,0,0,,Хмм!
Dialogue: 0,0:11:47.79,0:11:50.16,Default,,0,0,0,,Уау! Уф...
Dialogue: 0,0:11:53.42,0:11:54.46,Default,,0,0,0,,Дэку-чан…
Dialogue: 0,0:11:57.75,0:11:59.13,Default,,0,0,0,,Токио! Хмм...
Dialogue: 0,0:12:07.10,0:12:10.60,Default,,0,0,0,,То… Ки… О…
Dialogue: 0,0:12:14.31,0:12:15.56,Default,,0,0,0,,Жарайды Мина
Dialogue: 0,0:12:17.52,0:12:18.52,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:19.19,0:12:23.03,Default,,0,0,0,,Сіз дәл қазір ескертуді түсінбедіңіз бе?
Dialogue: 0,0:12:23.11,0:12:25.53,Default,,0,0,0,,Бұл сіздің денеңіз сияқты, солай ма?
Dialogue: 0,0:12:26.03,0:12:30.37,Default,,0,0,0,,Мысалы, егер адам медициналық тексерудің нәтижесін алса
Dialogue: 0,0:12:30.45,0:12:33.58,Default,,0,0,0,,Тексеру қажет Шұғыл хабарлама алынды
Dialogue: 0,0:12:33.66,0:12:38.34,Default,,0,0,0,,Денеңіздің қай бөлігі дұрыс емес екенін білесіз бе?
Dialogue: 0,0:12:38.96,0:12:42.17,Default,,0,0,0,,Бер, Мина, сен жеңдің.
Dialogue: 0,0:12:49.47,0:12:51.39,Default,,0,0,0,,О! Бір минут күтіңіз!
Dialogue: 0,0:12:51.52,0:12:52.31,Default,,0,0,0,,Иә?
Dialogue: 0,0:12:52.39,0:12:55.19,Default,,0,0,0,,Бұл ақымақ! Жүктеріңізді бос қалдырыңыз
Dialogue: 0,0:12:55.27,0:12:58.02,Default,,0,0,0,,Сіз не айтқыңыз келеді?
Dialogue: 0,0:12:59.15,0:13:01.15,Default,,0,0,0,,Ух... (Мал Кирко) Хмм...
Dialogue: 0,0:13:01.23,0:13:04.24,Default,,0,0,0,,Егер сіз кемеде болмасаңыз, бүкіл кеме жойылар еді.
Dialogue: 0,0:13:04.32,0:13:05.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:05.45,0:13:07.70,Default,,0,0,0,,Бұл құтқарушы! рақмет сізге!
Dialogue: 0,0:13:07.20,0:13:08.16,Default,,0,0,0,,Уф...
Dialogue: 0,0:13:08.74,0:13:11.12,Default,,0,0,0,,Бұл құбыжықтарды жоюға кететін еңбек шығыны.
Dialogue: 0,0:13:11.20,0:13:14.29,Default,,0,0,0,,Жоқ... Егер мен мұны істемесем, мені өлтіретін еді.
Dialogue: 0,0:13:14.79,0:13:16.75,Default,,0,0,0,,Алғыс алу орынды емес.
Dialogue: 0,0:13:16.83,0:13:20.88,Default,,0,0,0,,Оның орнына осы туралы айтып беріңізші.
Dialogue: 0,0:13:21.38,0:13:22.46,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:13:25.09,0:13:25.84,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:25.93,0:13:28.97,Default,,0,0,0,,Үлкен жолмен осылай жүре берсең
Dialogue: 0,0:13:29.05,0:13:31.22,Default,,0,0,0,,Шағын қалаға айналған жерлер бар.
Dialogue: 0,0:13:31.72,0:13:32.85,Default,,0,0,0,,А...
Dialogue: 0,0:13:32.93,0:13:36.56,Default,,0,0,0,,Ах... Сондай-ақ, сіз бұл белгі туралы бірдеңе білесіз бе?
Dialogue: 0,0:13:37.06,0:13:38.40,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:38.98,0:13:42.82,Default,,0,0,0,,Құс өрнектері бар таңбалар бұрыннан кең тараған.
Dialogue: 0,0:13:43.32,0:13:45.95,Default,,0,0,0,,Олардың бәрі маған бірдей көрінеді.
Dialogue: 0,0:13:44.36,0:13:45.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:13:46.03,0:13:46.82,Default,,0,0,0,,Мен...
Dialogue: 0,0:13:46.90,0:13:47.86,Default,,0,0,0,,Бұл белгі!
Dialogue: 0,0:13:47.95,0:13:49.24,Default,,0,0,0,,Иә! сурет? Сен білесің бе?
Dialogue: 0,0:13:49.82,0:13:50.87,Default,,0,0,0,,Бұл...
Dialogue: 0,0:13:52.49,0:13:53.79,Default,,0,0,0,,«Мицва» белгісі!
Dialogue: 0,0:13:53.87,0:13:55.00,Default,,0,0,0,,Мицва?
Dialogue: 0,0:13:55.08,0:13:57.00,Default,,0,0,0,,О, әрине!
Dialogue: 0,0:13:57.08,0:14:00.63,Default,,0,0,0,,Егер бұл Мицуба болса, жолда біраз қоқыс болады...
Dialogue: 0,0:14:01.00,0:14:01.88,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:14:01.96,0:14:03.05,Default,,0,0,0,,Рахмет!
Dialogue: 0,0:14:04.26,0:14:08.05,Default,,0,0,0,,Эй, сен менің оққағар болғың келе ме?
Dialogue: 0,0:14:05.13,0:14:05.92,Default,,0,0,0,,Иә?
Dialogue: 0,0:14:08.13,0:14:10.97,Default,,0,0,0,,Мен қазір бос емеспін, сондықтан жақын арада кездесеміз!
Dialogue: 0,0:14:12.22,0:14:16.14,Default,,0,0,0,,Аникидің шақыруын мазақ еткендер ғой!
Dialogue: 0,0:14:16.64,0:14:18.81,Default,,0,0,0,,Сіздің шеберлігіңіз неғұрлым жоғары болса, билетіңіз де соғұрлым жақсы болады.
Dialogue: 0,0:14:18.89,0:14:21.11,Default,,0,0,0,,Мүмкін болса, мен сенімен тағы да кездескім келеді.
Dialogue: 0,0:14:21.61,0:14:23.52,Default,,0,0,0,,Олар жақсы жігіттер еді!
Dialogue: 0,0:14:31.53,0:14:32.78,Default,,0,0,0,,(шу)
Dialogue: 0,0:14:32.87,0:14:37.62,Default,,0,0,0,,Сол қаскөй, сен маған үлкен үміт арттың...
Dialogue: 0,0:14:39.21,0:14:40.54,Default,,0,0,0,,Ештеңе
Dialogue: 0,0:14:41.08,0:14:42.59,Default,,0,0,0,,Әрине, ол жай ғана дос қой.
Dialogue: 0,0:14:42.67,0:14:43.21,Default,,0,0,0,,Ах
Dialogue: 0,0:14:43.29,0:14:45.59,Default,,0,0,0,,Мен жеуге болатын нәрсе таптым!
Dialogue: 0,0:14:45.67,0:14:49.38,Default,,0,0,0,,Е! Қанекей мынаны істейік! Қай жерде болды?
Dialogue: 0,0:14:49.47,0:14:52.01,Default,,0,0,0,,Ол сөренің астында тұрып қалған рюкзакта болды.
Dialogue: 0,0:14:52.68,0:14:55.47,Default,,0,0,0,,Мен қолшатыр таптым, бірақ сіз қаланы іздегіңіз келе ме?
Dialogue: 0,0:14:55.56,0:14:59.89,Default,,0,0,0,,А, жоқ... таң атқанша әлі уақыт бар, осында демалайық.
Dialogue: 0,0:14:59.98,0:15:00.94,Default,,0,0,0,,Хмм...
Dialogue: 0,0:15:01.65,0:15:03.11,Default,,0,0,0,,Йокан
Dialogue: 0,0:15:03.69,0:15:06.57,Default,,0,0,0,,Бұл... жеуге бола ма?
Dialogue: 0,0:15:07.07,0:15:08.07,Default,,0,0,0,,(иіс)
Dialogue: 0,0:15:08.28,0:15:09.11,Default,,0,0,0,,А...
Dialogue: 0,0:15:09.99,0:15:10.57,Default,,0,0,0,,Барлығын қайта әкелу – басты мақсат.
Dialogue: 0,0:15:10.65,0:15:11.45,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:15:11.53,0:15:14.37,Default,,0,0,0,,Дұрыстап жесең жарайды.
Dialogue: 0,0:15:14.45,0:15:15.49,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:22.46,0:15:24.79,Default,,0,0,0,,Иә? Иә! Бұл өте жақсы!
Dialogue: 0,0:15:25.13,0:15:26.25,Default,,0,0,0,,Ыстық!
Dialogue: 0,0:15:26.88,0:15:29.13,Default,,0,0,0,,Менде ингредиенттер қалды, сондықтан мен оны қайта жасай аламын.
Dialogue: 0,0:15:29.21,0:15:30.47,Default,,0,0,0,,Ат қойып көрейік.
Dialogue: 0,0:15:32.13,0:15:35.14,Default,,0,0,0,,Дұрыс... Өйткені бұл йокан және хардтак...
Dialogue: 0,0:15:35.22,0:15:36.43,Default,,0,0,0,,«Йопан шырыны»
Dialogue: 0,0:15:36.51,0:15:39.77,Default,,0,0,0,,А... мына кісінің ат қою мағынасы бітті.
Dialogue: 0,0:15:39.85,0:15:40.52,Default,,0,0,0,,Хмм!
Dialogue: 0,0:15:40.60,0:15:42.77,Default,,0,0,0,,Йоканды қол бұлғап, шайнап жейтіндерге.
Dialogue: 0,0:15:42.85,0:15:43.98,Default,,0,0,0,,Мен сенің бұлай айтқаныңды қаламаймын!
Dialogue: 0,0:15:44.06,0:15:47.61,Default,,0,0,0,,Аты қандай болса да, дәмді. Мен оны тағы қанша рет жасай аламын?
Dialogue: 0,0:15:47.69,0:15:48.78,Default,,0,0,0,,Бір рет.
Dialogue: 0,0:15:48.86,0:15:50.49,Default,,0,0,0,,Бір рет...
Dialogue: 0,0:15:55.66,0:15:57.74,Default,,0,0,0,,Мен шынымен таң қалдым.
Dialogue: 0,0:15:57.83,0:16:00.75,Default,,0,0,0,,Иә? жаңбыр? Бұл кенеттен болды.
Dialogue: 0,0:16:00.83,0:16:01.91,Default,,0,0,0,,Жоқ.
Dialogue: 0,0:16:02.00,0:16:02.62,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:03.75,0:16:04.88,Default,,0,0,0,,«Мицва»
Dialogue: 0,0:16:05.46,0:16:07.75,Default,,0,0,0,,Хехе... Бұл рас.
Dialogue: 0,0:16:08.34,0:16:10.46,Default,,0,0,0,,«Сөзсіз!» деген не?
Dialogue: 0,0:16:11.22,0:16:14.59,Default,,0,0,0,,Екеуі бір-біріне мүлде ұқсамайды, анау бұзақы.
Dialogue: 0,0:16:15.97,0:16:19.14,Default,,0,0,0,,Аха…
Dialogue: 0,0:16:19.22,0:16:23.81,Default,,0,0,0,,Аха ахах...
Dialogue: 0,0:16:27.73,0:16:30.11,Default,,0,0,0,,Жоқ... күткендей.
Dialogue: 0,0:16:30.53,0:16:33.61,Default,,0,0,0,,Бұл күн мен осы күннің арасында болуы керек еді...
Dialogue: 0,0:16:33.70,0:16:36.53,Default,,0,0,0,,Менің есте сақтау қабілетім де бұлыңғыр...
Dialogue: 0,0:16:36.62,0:16:38.37,Default,,0,0,0,,Ugh... ugh...
Dialogue: 0,0:16:38.45,0:16:42.16,Default,,0,0,0,,Егер бұл орын алса, бұл қабақтың жадында берік болады.
Dialogue: 0,0:16:42.25,0:16:44.37,Default,,0,0,0,,Мен оны өртеп жіберуім керек еді...
Dialogue: 0,0:16:44.96,0:16:46.88,Default,,0,0,0,,(қоңырау дыбысы)
Dialogue: 0,0:16:46.96,0:16:50.21,Default,,0,0,0,,Жарайды, мен ойлап тапқан жаттығуларды орындайық.
Dialogue: 0,0:16:48.29,0:16:50.21,Default,,0,0,0,,Мимихиме... Иә?
Dialogue: 0,0:16:50.30,0:16:53.01,Default,,0,0,0,,Бәрібір сұңқардың ғана қолынан келетіні анық.
Dialogue: 0,0:16:50.30,0:16:50.88,Default,,0,0,0,,Фалько…
Dialogue: 0,0:16:50.96,0:16:53.01,Default,,0,0,0,,О, күте тұрыңыз ...
Dialogue: 0,0:16:53.09,0:16:54.76,Default,,0,0,0,,Байқап көріңіз және қараңыз. Мен бассейнге барамын.
Dialogue: 0,0:16:55.97,0:16:57.01,Default,,0,0,0,,Фото?
Dialogue: 0,0:16:57.59,0:17:00.81,Default,,0,0,0,,Жақында Широға электрондық хат жібергенім есімде жоқ.
Dialogue: 0,0:17:01.31,0:17:03.10,Default,,0,0,0,,Маған бірдеңе керек болса, мен сізге тікелей хабарлаймын.
Dialogue: 0,0:17:03.68,0:17:04.85,Default,,0,0,0,,Мен...
Dialogue: 0,0:17:04.94,0:17:05.85,Default,,0,0,0,,Қандай фотосурет?
Dialogue: 0,0:17:05.94,0:17:08.48,Default,,0,0,0,,Жоқ! Жақсы, бұл проблема емес ...
Dialogue: 0,0:17:08.98,0:17:09.98,Default,,0,0,0,,Осы балаға не болған екен…
Dialogue: 0,0:17:11.61,0:17:15.40,Default,,0,0,0,,Мұны айту оғаш көрінуі мүмкін, бірақ...
Dialogue: 0,0:17:15.49,0:17:16.53,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:17.03,0:17:19.99,Default,,0,0,0,,Мен Мимихимені көрген сайын...
Dialogue: 0,0:17:20.83,0:17:22.87,Default,,0,0,0,,Бұл қайтпас сезім...
Dialogue: 0,0:17:23.37,0:17:24.91,Default,,0,0,0,,ше? Не айтқың келеді?
Dialogue: 0,0:17:25.50,0:17:27.37,Default,,0,0,0,,Кішкене нақтырақ болыңыз
Dialogue: 0,0:17:27.46,0:17:29.92,Default,,0,0,0,,Хмм, нақты...
Dialogue: 0,0:17:31.30,0:17:32.76,Default,,0,0,0,,Мимихим...
Dialogue: 0,0:17:34.55,0:17:36.76,Default,,0,0,0,,Мен өзімді бөлмеме қамап алғым келеді
Dialogue: 0,0:17:37.55,0:17:39.60,Default,,0,0,0,,Біраз уақыт жақсы, бірақ...
Dialogue: 0,0:17:40.10,0:17:41.10,Default,,0,0,0,,Сонда?
Dialogue: 0,0:17:41.76,0:17:43.27,Default,,0,0,0,,А... Иә?
Dialogue: 0,0:17:43.35,0:17:44.22,Default,,0,0,0,,(тыныс алу)
Dialogue: 0,0:17:44.31,0:17:47.60,Default,,0,0,0,,А... Мен киімімді шешіп алғым келеді... және саған тиіссем...
Dialogue: 0,0:17:48.19,0:17:49.19,Default,,0,0,0,,Түрту...
Dialogue: 0,0:17:49.77,0:17:53.44,Default,,0,0,0,,Мен оны аузыммен жалап алғым келеді...
Dialogue: 0,0:17:53.73,0:17:54.44,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:55.07,0:17:56.61,Default,,0,0,0,,Мені жегің келе ме?
Dialogue: 0,0:17:56.70,0:18:00.12,Default,,0,0,0,,Жоқ... Мм, тамақ ішу басқа.
Dialogue: 0,0:17:57.53,0:18:02.16,Default,,0,0,0,,(Токионың ауыр тыныс алуы)
Dialogue: 0,0:18:00.62,0:18:02.16,Default,,0,0,0,,Оны жесең, ол жоғалады.
Dialogue: 0,0:18:02.24,0:18:04.70,Default,,0,0,0,,Сонымен, кесу немесе шаншу туралы не деуге болады?
Dialogue: 0,0:18:04.79,0:18:06.41,Default,,0,0,0,,Мен мұны істемеймін!
Dialogue: 0,0:18:06.62,0:18:07.33,Default,,0,0,0,,Хмм…
Dialogue: 0,0:18:07.41,0:18:08.54,Default,,0,0,0,,Хмм... уф
Dialogue: 0,0:18:08.62,0:18:11.04,Default,,0,0,0,,(Студенттердің шуы)
Dialogue: 0,0:18:11.13,0:18:13.25,Default,,0,0,0,,Екі қолыңды тербе.
Dialogue: 0,0:18:18.84,0:18:20.72,Default,,0,0,0,,(Оқушы күлкісі)
Dialogue: 0,0:18:20.80,0:18:22.35,Default,,0,0,0,,Міне, міне!
Dialogue: 0,0:18:27.52,0:18:28.52,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:30.31,0:18:33.07,Default,,0,0,0,,Тарао...тез сауығып кет.
Dialogue: 0,0:18:33.73,0:18:35.36,Default,,0,0,0,,Тағы бірге ойнайық...
Dialogue: 0,0:18:35.86,0:18:36.99,Default,,0,0,0,,Токи... Ах...
Dialogue: 0,0:18:37.49,0:18:38.45,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:38.53,0:18:39.78,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:40.45,0:18:43.87,Default,,0,0,0,,Жарайды... бұл жұқпалы ауру емес.
Dialogue: 0,0:18:43.95,0:18:46.25,Default,,0,0,0,,Менің айтқым келгені бұл емес.
Dialogue: 0,0:18:47.70,0:18:48.71,Default,,0,0,0,,Барша адамның ішінен… сен бе
Dialogue: 0,0:18:48.79,0:18:49.96,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:18:50.92,0:18:51.96,Default,,0,0,0,,Токио…
Dialogue: 0,0:18:56.26,0:18:57.34,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:18:59.76,0:19:00.88,Default,,0,0,0,,Уф...
Dialogue: 0,0:19:00.97,0:19:01.97,Default,,0,0,0,,Токио!
Dialogue: 0,0:19:02.05,0:19:05.01,Default,,0,0,0,,Ах… Хехе…
Dialogue: 0,0:19:09.48,0:19:10.48,Default,,0,0,0,,Ах...
Dialogue: 0,0:19:11.90,0:19:13.90,Default,,0,0,0,,Ах… Хехе…
Dialogue: 0,0:19:15.69,0:19:17.65,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:19:17.73,0:19:19.61,Default,,0,0,0,,Токио! Ха…
Dialogue: 0,0:19:20.45,0:19:21.57,Default,,0,0,0,,Не болды?
Dialogue: 0,0:19:22.20,0:19:23.20,Default,,0,0,0,,Кона…
Dialogue: 0,0:19:24.28,0:19:26.49,Default,,0,0,0,,Ух... у...ух
Dialogue: 0,0:19:29.00,0:19:30.08,Default,,0,0,0,,Сіз тынышталдыңыз ба?
Dialogue: 0,0:19:30.75,0:19:31.75,Default,,0,0,0,,Иә
Dialogue: 0,0:19:33.54,0:19:36.71,Default,,0,0,0,,Соңғы кездері бәрі біртүрлі болды.
Dialogue: 0,0:19:39.55,0:19:42.22,Default,,0,0,0,,Мен қорқамын...
Dialogue: 0,0:19:43.43,0:19:44.43,Default,,0,0,0,,Фу…
Dialogue: 0,0:19:45.51,0:19:47.26,Default,,0,0,0,,Бұл мүлдем қорқынышты емес.
Dialogue: 0,0:19:47.35,0:19:47.97,Default,,0,0,0,,А...
Dialogue: 0,0:19:49.35,0:19:53.06,Default,,0,0,0,,Адамдардың біреуге ғашық болуы табиғи нәрсе.
Dialogue: 0,0:19:54.19,0:19:57.11,Default,,0,0,0,,Токио да бір күні біреуге тиіскісі келеді.
Dialogue: 0,0:19:57.19,0:20:00.07,Default,,0,0,0,,Менің ойымша, сізге қол тигізгіңіз келеді.
Dialogue: 0,0:20:00.78,0:20:02.86,Default,,0,0,0,,Шатастырудың қажеті жоқ.
Dialogue: 0,0:20:03.45,0:20:04.41,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:07.33,0:20:08.29,Default,,0,0,0,,Хмм... сонда
Dialogue: 0,0:20:08.37,0:20:09.12,Default,,0,0,0,,Иә?
Dialogue: 0,0:20:09.83,0:20:12.04,Default,,0,0,0,,Бұл жағдайда мен...
Dialogue: 0,0:20:15.42,0:20:16.96,Default,,0,0,0,,Кона жақсы
Dialogue: 0,0:20:17.59,0:20:18.59,Default,,0,0,0,,Мен сені жеңемін!
Dialogue: 0,0:20:21.97,0:20:22.84,Default,,0,0,0,,Хмм...
Dialogue: 0,0:20:24.38,0:20:25.05,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:25.76,0:20:27.14,Default,,0,0,0,,Маған да Токио ұнайды.
Dialogue: 0,0:20:27.22,0:20:28.22,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:20:30.81,0:20:31.81,Default,,0,0,0,,Уф...
Dialogue: 0,0:20:35.06,0:20:36.06,Default,,0,0,0,,Иә...
Dialogue: 0,0:20:40.69,0:20:42.69,Default,,0,0,0,,Ахаха!
Dialogue: 0,0:20:42.90,0:20:44.40,Default,,0,0,0,,Уау... Ахаха
Dialogue: 0,0:20:44.66,0:20:46.74,Default,,0,0,0,,Ухаха... у...
Dialogue: 0,0:20:46.91,0:20:48.91,Default,,0,0,0,,U… Uu…
Dialogue: 0,0:20:50.04,0:20:51.54,Default,,0,0,0,,Токио-кун
Dialogue: 0,0:20:51.62,0:20:52.37,Default,,0,0,0,,Ах...
Dialogue: 0,0:20:53.12,0:20:56.71,Default,,0,0,0,,Бұл хабар тек Токио-кунның бөлмесіне таратылуда.
Dialogue: 0,0:20:57.83,0:21:00.13,Default,,0,0,0,,Тараоның жағдайы кенет өзгерді.
Dialogue: 0,0:21:00.21,0:21:01.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:21:01.17,0:21:03.47,Default,,0,0,0,,Мен Токио-кунмен сөйлескім келеді.
Dialogue: 0,0:21:03.55,0:21:06.22,Default,,0,0,0,,Хахаха... хахаха...
Dialogue: 0,0:21:04.26,0:21:06.80,Default,,0,0,0,,Тез арада емдеу бөлмесіне келіңіз.
Dialogue: 0,0:21:08.68,0:21:09.93,Default,,0,0,0,,Тарао!
Dialogue: 0,0:21:10.01,0:21:11.35,Default,,0,0,0,,(қатты тыныс алу)
Dialogue: 0,0:21:11.43,0:21:14.60,Default,,0,0,0,,Токио және... екі адам...
Dialogue: 0,0:21:14.69,0:21:17.81,Default,,0,0,0,,Амансың ба? Талау! Мықты болыңыз!
Dialogue: 0,0:21:18.61,0:21:21.69,Default,,0,0,0,,Мен шықтым, егер сізге бірдеңе керек болса, дереу маған қоңырау шалыңыз.
Dialogue: 0,0:21:22.65,0:21:24.03,Default,,0,0,0,,Ах...
Dialogue: 0,0:21:24.74,0:21:25.74,Default,,0,0,0,,Тарао…
Dialogue: 0,0:21:25.82,0:21:26.49,Default,,0,0,0,,Маған бәрібір! Ха!
Dialogue: 0,0:21:26.57,0:21:28.07,Default,,0,0,0,,Кешіріңіз!
Dialogue: 0,0:21:28.62,0:21:32.41,Default,,0,0,0,,Жарайды, ұстаңыз... Мен оны қалаймын...
Dialogue: 0,0:21:34.04,0:21:35.87,Default,,0,0,0,,(Талаоның ауыр тыныс алуы)
Dialogue: 0,0:21:37.04,0:21:38.67,Default,,0,0,0,,Күндіз... Кешіріңіз...
Dialogue: 0,0:21:39.17,0:21:41.96,Default,,0,0,0,,Токионың сезімін ойламай...
Dialogue: 0,0:21:42.05,0:21:43.76,Default,,0,0,0,,Жақсы! Бұл солай
Dialogue: 0,0:21:43.84,0:21:45.84,Default,,0,0,0,,(Талаоның ауыр тыныс алуы)
Dialogue: 0,0:21:47.55,0:21:50.01,Default,,0,0,0,,Мен жақсара алмаймын ...
Dialogue: 0,0:21:50.10,0:21:52.26,Default,,0,0,0,,Олай айтпа!
Dialogue: 0,0:21:52.76,0:21:56.14,Default,,0,0,0,,Хаа... Токио, тыңда...
Dialogue: 0,0:21:57.39,0:21:58.40,Default,,0,0,0,,Осы жерден...
Dialogue: 0,0:22:00.48,0:22:01.48,Default,,0,0,0,,Қаш...
Dialogue: 0,0:22:04.23,0:22:05.49,Default,,0,0,0,,Сол куртка—таныс болуға таяу қалды, бірақ атау жапсырмасын анықтай алмадым.
Dialogue: 0,0:22:07.32,0:22:08.32,Default,,0,0,0,,Қауіпті...
Dialogue: 0,0:22:11.41,0:22:15.41,Default,,0,0,0,,♪~
Dialogue: 0,0:23:34.16,0:23:38.16,Default,,0,0,0,,~♪
Dialogue: 0,0:23:39.66,0:23:45.66,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory