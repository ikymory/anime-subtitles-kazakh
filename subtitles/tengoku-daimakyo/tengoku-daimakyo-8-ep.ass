Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:01.45,0:00:05.46,Default,,0,0,0,,♪~
Dialogue: 0,0:01:25.37,0:01:29.38,Default,,0,0,0,,~♪
Dialogue: 0,0:01:31.50,0:01:35.55,Default,,0,0,0,,(флейта мен барабан дыбысы)
Dialogue: 0,0:01:38.47,0:01:41.93,Default,,0,0,0,,Адам тәжірибесін тоқтатыңыз!
Dialogue: 0,0:01:42.01,0:01:44.77,Default,,0,0,0,,Тәжірибе жасау үшін біреудің аяғын кесу.
Dialogue: 0,0:01:42.01,0:01:46.06,Default,,0,0,0,,Адам тәжірибесін тоқтатыңыз!
Dialogue: 0,0:01:44.85,0:01:47.64,Default,,0,0,0,,Бұл адамдар жасайтын нәрсе емес!
Dialogue: 0,0:01:47.73,0:01:50.06,Default,,0,0,0,,Иә! (3-ші шолу) Дұрыс!
Dialogue: 0,0:01:50.15,0:01:53.11,Default,,0,0,0,,Адам тәжірибесін тоқтатыңыз!
Dialogue: 0,0:01:53.19,0:01:55.03,Default,,0,0,0,,Кик!
Dialogue: 0,0:01:55.11,0:01:56.53,Default,,0,0,0,,Уау!
Dialogue: 0,0:01:56.61,0:02:00.24,Default,,0,0,0,,Сіз мұны істедіңіз, қарғыс атқыр эго бейбақтары!
Dialogue: 0,0:02:00.32,0:02:01.24,Default,,0,0,0,,Уау!
Dialogue: 0,0:02:02.33,0:02:03.37,Default,,0,0,0,,Кя!
Dialogue: 0,0:02:05.04,0:02:08.16,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:02:09.08,0:02:10.21,Default,,0,0,0,,Адамдар өте оңай өліп қалады, иә?
Dialogue: 0,0:02:10.29,0:02:12.34,Default,,0,0,0,,Мизухаши-сан!
Dialogue: 0,0:02:13.75,0:02:16.01,Default,,0,0,0,,Жексұрын! (Рецензенттер) Зорлық-зомбылық жексұрын!
Dialogue: 0,0:02:16.09,0:02:19.09,Default,,0,0,0,,(Шолушылардың шуы)
Dialogue: 0,0:02:19.18,0:02:21.85,Default,,0,0,0,,Бір тас хаос тудыруы мүмкін бе?
Dialogue: 0,0:02:21.93,0:02:24.89,Default,,0,0,0,,Өйткені, бұл ешқандай сенімі жоқ фестиваль тобы.
Dialogue: 0,0:02:25.68,0:02:28.64,Default,,0,0,0,,Жоқ, олар бүгін біртүрлі әрекет етеді.
Dialogue: 0,0:02:29.31,0:02:34.23,Default,,0,0,0,,Мен оны эмоционалды әбігерге түсірді деп ойладым, бірақ ол бір ғана таспен кетіп қалды.
Dialogue: 0,0:02:34.98,0:02:38.53,Default,,0,0,0,,Бұл басқа мақсатқа қызмет еткен сияқты...
Dialogue: 0,0:02:39.20,0:02:42.16,Default,,0,0,0,,Ах, қазіргі тас орамды сылтау етіп
Dialogue: 0,0:02:42.24,0:02:44.53,Default,,0,0,0,,Ол бірдеңені талап етуге тырысуы мүмкін.
Dialogue: 0,0:02:44.62,0:02:47.25,Default,,0,0,0,,Ол бірінші лақтырса да?
Dialogue: 0,0:02:47.75,0:02:51.17,Default,,0,0,0,,Күрсіну... Біздің істеп жатқанымыз — өрнек.
Dialogue: 0,0:02:51.25,0:02:55.50,Default,,0,0,0,,Олар басқа адамның істегенін шабуыл деп ойлайды.
Dialogue: 0,0:02:57.01,0:02:59.13,Default,,0,0,0,,Өкіл!
Dialogue: 0,0:02:59.22,0:03:02.14,Default,,0,0,0,,Өкіл! өкілі!
Dialogue: 0,0:03:02.22,0:03:04.80,Default,,0,0,0,,Бір сәт кешіріңіз... өтуге рұқсат етіңіз.
Dialogue: 0,0:03:07.43,0:03:08.89,Default,,0,0,0,,Ха...хахаха
Dialogue: 0,0:03:10.44,0:03:12.94,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:03:15.57,0:03:17.65,Default,,0,0,0,,Басқа бақылаушылар растады.
Dialogue: 0,0:03:18.65,0:03:21.15,Default,,0,0,0,,Жер асты құбыжық шынымен өлген сияқты.
Dialogue: 0,0:03:23.16,0:03:26.49,Default,,0,0,0,,Бұл мүмкіндікті жіберіп алмау керек
Dialogue: 0,0:03:28.20,0:03:29.83,Default,,0,0,0,,Барлығың тыңдаңдар.
Dialogue: 0,0:03:30.75,0:03:33.08,Default,,0,0,0,,күрсіну... Өкіл
Dialogue: 0,0:03:33.71,0:03:34.71,Default,,0,0,0,,қайтыс болды
Dialogue: 0,0:03:34.79,0:03:36.75,Default,,0,0,0,,О, не!
Dialogue: 0,0:03:36.84,0:03:40.76,Default,,0,0,0,,(Рецензенттер айқайы)
Dialogue: 0,0:03:41.38,0:03:46.30,Default,,0,0,0,,Адамгершілікке жатпайтын эксперимент кезінде өкілдің аяғы кесілген болса да,
Dialogue: 0,0:03:46.89,0:03:51.60,Default,,0,0,0,,Өлмейтін культ ұстаған сынақ субъектілерін әлі де құтқаруға тырысуда.
Dialogue: 0,0:03:51.68,0:03:52.69,Default,,0,0,0,,Тұр!
Dialogue: 0,0:03:54.35,0:03:56.23,Default,,0,0,0,,Өкілді жеңіңіз!
Dialogue: 0,0:03:56.81,0:03:58.15,Default,,0,0,0,,Қаруыңызды алыңыз!
Dialogue: 0,0:03:58.23,0:04:00.15,Default,,0,0,0,,Бұл қонақүй маған сия қосылған спагетти ұсынғысы келе ме➡
Dialogue: 0,0:04:01.61,0:04:03.03,Default,,0,0,0,,Ғү… Ақымақ, шегінбе! ➡
Dialogue: 0,0:04:07.83,0:04:08.83,Default,,0,0,0,,Ах...
Dialogue: 0,0:04:15.67,0:04:17.17,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:04:17.67,0:04:20.30,Default,,0,0,0,,Мұғалім, менің протездік қолым біртүрлі дыбыстар шығарып жатыр.
Dialogue: 0,0:04:22.59,0:04:24.63,Default,,0,0,0,,(жылжымалы протездік қолдың дыбысы)
Dialogue: 0,0:04:24.72,0:04:28.14,Default,,0,0,0,,Біреудің сізге май немесе силикон шашыратқышын жағуын сұраңыз.
Dialogue: 0,0:04:28.72,0:04:31.39,Default,,0,0,0,,Бұл жерде. Тек осы бір жер жақсы.
Dialogue: 0,0:04:32.06,0:04:37.44,Default,,0,0,0,,Мұғалім, бұл бала мен қанша күш қолданып жатқанын түсінбеймін деп жатыр.
Dialogue: 0,0:04:37.52,0:04:39.32,Default,,0,0,0,,Қалай?
Dialogue: 0,0:04:39.40,0:04:41.94,Default,,0,0,0,,Оған үйреніңіз. Тек оған үйрену керек.
Dialogue: 0,0:04:42.44,0:04:44.11,Default,,0,0,0,,Мұғалім (ер 2) Усами мырза
Dialogue: 0,0:04:44.20,0:04:45.20,Default,,0,0,0,,Кеттік
Dialogue: 0,0:04:46.24,0:04:47.24,Default,,0,0,0,,Эй, досым! Эй, досым!
Dialogue: 0,0:04:47.99,0:04:49.20,Default,,0,0,0,,Ешқандай шектеу жоқ
Dialogue: 0,0:04:51.62,0:04:52.66,Default,,0,0,0,,Міне, осы жерде.
Dialogue: 0,0:04:54.29,0:04:56.50,Default,,0,0,0,,Мен жер астындағы құбыжықты қалай өлтірдім
Dialogue: 0,0:04:57.21,0:05:00.00,Default,,0,0,0,,Мені өлтіре алатыныңды көргім келеді.
Dialogue: 0,0:05:00.71,0:05:04.47,Default,,0,0,0,,(Механикалық электрондық дыбыстар)
Dialogue: 0,0:05:05.63,0:05:06.63,Default,,0,0,0,,Біз енді ғана қысқа қақтығыс жасадық,
Dialogue: 0,0:05:09.05,0:05:11.10,Default,,0,0,0,,Мизухаши айтып отырған шатыр...
Dialogue: 0,0:05:12.77,0:05:14.64,Default,,0,0,0,,Жоқ! Уф...
Dialogue: 0,0:05:15.56,0:05:17.02,Default,,0,0,0,,Ой!
Dialogue: 0,0:05:18.52,0:05:21.77,Default,,0,0,0,,Бұл науқасты емдеудің ірге тасы ма?
Dialogue: 0,0:05:24.40,0:05:25.28,Default,,0,0,0,,Хаа…
Dialogue: 0,0:05:27.03,0:05:28.45,Default,,0,0,0,,Ха!
Dialogue: 0,0:05:29.70,0:05:33.20,Default,,0,0,0,,Оның өлгенін қаласаңыз, машинаны неге тоқтатпайсыз?
Dialogue: 0,0:05:34.54,0:05:37.79,Default,,0,0,0,,Егер сіз оны тоқтатсаңыз, ол жертөледегі құбыжықтай айналады.
Dialogue: 0,0:05:37.87,0:05:39.13,Default,,0,0,0,,Не!
Dialogue: 0,0:05:39.21,0:05:42.80,Default,,0,0,0,,Әй... ол кісі жегіш болып кете ме?
Dialogue: 0,0:05:43.96,0:05:46.30,Default,,0,0,0,,Сонымен, каннибалдар адам ма?
Dialogue: 0,0:05:48.05,0:05:51.35,Default,,0,0,0,,Менен адам ба деп сұрасаң, сәл басқаша.
Dialogue: 0,0:05:51.43,0:05:53.93,Default,,0,0,0,,Ол ауруға шалдығып, оны құбыжыққа айналдырып, қайтыс болды.
Dialogue: 0,0:05:54.68,0:05:56.06,Default,,0,0,0,,Бұрынғы адам
Dialogue: 0,0:05:57.06,0:06:00.94,Default,,0,0,0,,Мұндағы мекемелер оны ауруды дамытқан адам ретінде қарастырады.
Dialogue: 0,0:06:01.02,0:06:03.19,Default,,0,0,0,,Өмірді ұзарту үшін жаралған.
Dialogue: 0,0:06:04.48,0:06:06.24,Default,,0,0,0,,Прогресті баяулату үшін
Dialogue: 0,0:06:06.74,0:06:10.74,Default,,0,0,0,,Жалғыз нұсқа – ауру дене мүшесін кесіп алу.
Dialogue: 0,0:06:12.53,0:06:16.50,Default,,0,0,0,,Десе де, ауруды дамытқаннан кейін, бұл жақсы емес.
Dialogue: 0,0:06:17.08,0:06:19.04,Default,,0,0,0,,Жақында қайталанады
Dialogue: 0,0:06:19.62,0:06:21.92,Default,,0,0,0,,оны қайтадан алып тастаңыз
Dialogue: 0,0:06:22.50,0:06:25.59,Default,,0,0,0,,Дене өз функцияларын жоғалтса, оның орнын машиналар басады.
Dialogue: 0,0:06:26.09,0:06:29.51,Default,,0,0,0,,Мен мұны көп жылдар бойы істеп келемін.
Dialogue: 0,0:06:30.68,0:06:34.31,Default,,0,0,0,,Оның денесі шегінде...
Dialogue: 0,0:06:37.06,0:06:39.39,Default,,0,0,0,,Құбыжық жер астында қалай өлді
Dialogue: 0,0:06:40.19,0:06:43.48,Default,,0,0,0,,Мүмкін оның адам болып өлуіне жол берерміз.
Dialogue: 0,0:06:45.48,0:06:47.65,Default,,0,0,0,,Жалпы білім бөлімі мен Батырлар бөлімі бәрі аралас—
Dialogue: 0,0:06:48.49,0:06:50.32,Default,,0,0,0,,Бұл менің жалғыз үмітім
Dialogue: 0,0:07:10.34,0:07:12.76,Default,,0,0,0,,(механикалық дыбыс)
Dialogue: 0,0:07:19.10,0:07:20.10,Default,,0,0,0,,Орындауға болады
Dialogue: 0,0:07:22.52,0:07:23.81,Default,,0,0,0,,Сіз мұны істей аласыз ба?
Dialogue: 0,0:07:23.90,0:07:25.98,Default,,0,0,0,,Бірақ бұл адамның еркі қандай?
Dialogue: 0,0:07:27.19,0:07:29.36,Default,,0,0,0,,Сіз бұл планшетпен сөйлесе аласыз.
Dialogue: 0,0:07:29.86,0:07:32.86,Default,,0,0,0,,Мен де сенің дауысыңды естимін.
Dialogue: 0,0:07:56.18,0:07:58.43,Default,,0,0,0,,Сіз бұл адамды сыртқа шығара алмайсыз ба?
Dialogue: 0,0:07:59.18,0:08:00.85,Default,,0,0,0,,Құрылғыдан шығару мүмкін емес
Dialogue: 0,0:08:06.15,0:08:07.40,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:08:07.48,0:08:08.61,Default,,0,0,0,,Осы жерден
Dialogue: 0,0:08:13.82,0:08:14.91,Default,,0,0,0,,Әзірге
Dialogue: 0,0:08:15.87,0:08:17.24,Default,,0,0,0,,Бұл өте алыс.
Dialogue: 0,0:08:20.75,0:08:22.29,Default,,0,0,0,,Біз де көмектесеміз.
Dialogue: 0,0:08:23.12,0:08:25.37,Default,,0,0,0,,Мен мұны істей алмасам, мен де істемеймін.
Dialogue: 0,0:08:30.51,0:08:34.05,Default,,0,0,0,,Жарайды, ақырын, жайлап жылжытыңыз.
Dialogue: 0,0:08:34.13,0:08:35.38,Default,,0,0,0,,Со~тто
Dialogue: 0,0:08:38.14,0:08:39.85,Default,,0,0,0,,Оның жанында
Dialogue: 0,0:08:39.93,0:08:40.85,Default,,0,0,0,,Түсіндім
Dialogue: 0,0:08:42.39,0:08:44.48,Default,,0,0,0,,Сондай-ақ, мұны жақын жерде сақтаңыз.
Dialogue: 0,0:08:44.56,0:08:45.56,Default,,0,0,0,,Иә
Dialogue: 0,0:08:46.27,0:08:48.73,Default,,0,0,0,,Бұл... ұзарту керек пе?
Dialogue: 0,0:08:49.44,0:08:51.69,Default,,0,0,0,,Ол біраз уақыт ести алмайды.
Dialogue: 0,0:08:52.36,0:08:54.65,Default,,0,0,0,,Оның көз алдында болыңыз.
Dialogue: 0,0:08:54.74,0:08:55.40,Default,,0,0,0,,Иә
Dialogue: 0,0:09:16.55,0:09:17.47,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:19.47,0:09:21.18,Default,,0,0,0,,Кешіріңіз... кешіріңіз!
Dialogue: 0,0:09:22.47,0:09:23.68,Default,,0,0,0,,Идиот...
Dialogue: 0,0:09:26.31,0:09:27.35,Default,,0,0,0,,Хэхе…
Dialogue: 0,0:09:28.77,0:09:31.27,Default,,0,0,0,,(Рецензенттер айқайы)
Dialogue: 0,0:09:32.11,0:09:33.94,Default,,0,0,0,,Еш жерде баспалдақ жоқ!
Dialogue: 0,0:09:34.03,0:09:35.74,Default,,0,0,0,,Айналыңыз! (3-ші шолу) Кеттік!
Dialogue: 0,0:09:35.82,0:09:36.82,Default,,0,0,0,,Чи…
Dialogue: 0,0:09:37.32,0:09:38.49,Default,,0,0,0,,(Рецензенттер айқайы)
Dialogue: 0,0:09:38.57,0:09:40.45,Default,,0,0,0,,Уақыт келді!
Dialogue: 0,0:09:41.45,0:09:42.95,Default,,0,0,0,,Сәлем! (Кувата) Иә?
Dialogue: 0,0:09:44.54,0:09:46.16,Default,,0,0,0,,Хатсу…
Dialogue: 0,0:09:49.42,0:09:50.84,Default,,0,0,0,,Ах... а...
Dialogue: 0,0:09:55.26,0:09:57.51,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:09:58.93,0:10:02.51,Default,,0,0,0,,Бұл өкіл Мизухашиді өлтіргені үшін кек!
Dialogue: 0,0:10:03.26,0:10:04.93,Default,,0,0,0,,Дұрыс!
Dialogue: 0,0:10:05.02,0:10:07.27,Default,,0,0,0,,Қолыңнан келгенше алысқа барудан басқа амалың жоқ!
Dialogue: 0,0:10:07.69,0:10:09.19,Default,,0,0,0,,Осы жерден бастайық!
Dialogue: 0,0:10:09.27,0:10:10.65,Default,,0,0,0,,Оу!
Dialogue: 0,0:10:10.73,0:10:11.73,Default,,0,0,0,,Қандай үлкен мәселе!
Dialogue: 0,0:10:12.32,0:10:15.36,Default,,0,0,0,,Ақ киім киген, қаруланған адам келді.
Dialogue: 0,0:10:15.44,0:10:19.24,Default,,0,0,0,,Цк, бұл зорлық-зомбылық пен жексұрындық емес пе еді?
Dialogue: 0,0:10:20.45,0:10:25.08,Default,,0,0,0,,Барлығы жоғарыға жүгір! Қозғала алатындар зардап шеккен адамға көмектесе алады.
Dialogue: 0,0:10:25.16,0:10:26.00,Default,,0,0,0,,Ах!
Dialogue: 0,0:10:29.92,0:10:31.67,Default,,0,0,0,,Фу…
Dialogue: 0,0:10:34.09,0:10:37.09,Default,,0,0,0,,(Хошионың тыныс алу дыбысы)
Dialogue: 0,0:10:45.72,0:10:49.64,Default,,0,0,0,,(Рецензенттер айқайы)
Dialogue: 0,0:10:49.73,0:10:52.40,Default,,0,0,0,,Әй, эй... бірдеңе шулап жатыр.
Dialogue: 0,0:10:53.23,0:10:54.27,Default,,0,0,0,,Оны жай қалдырыңыз
Dialogue: 0,0:10:55.15,0:10:56.44,Default,,0,0,0,,(Хошионың тыныс алу дыбысы)
Dialogue: 0,0:10:56.53,0:10:59.07,Default,,0,0,0,,(Рецензенттер айқайы)
Dialogue: 0,0:11:01.86,0:11:03.07,Default,,0,0,0,,(Хошионың тыныс алу дыбысы)
Dialogue: 0,0:11:16.13,0:11:17.13,Default,,0,0,0,,Хмм...
Dialogue: 0,0:12:04.76,0:12:07.64,Default,,0,0,0,,(Хошионың тыныс алу дыбысы)
Dialogue: 0,0:12:17.65,0:12:19.28,Default,,0,0,0,,Ха!
Dialogue: 0,0:12:34.62,0:12:36.63,Default,,0,0,0,,(Желдің дыбысы)
Dialogue: 0,0:12:37.33,0:12:39.17,Default,,0,0,0,,(Марудың дірілдеген тынысы)
Dialogue: 0,0:12:52.27,0:12:55.52,Default,,0,0,0,,Құбыжық болу оңайырақ болуы мүмкін.
Dialogue: 0,0:12:59.06,0:13:02.94,Default,,0,0,0,,Сіз мені ұзақ уақыт бойы жаман сезіндіңіз.
Dialogue: 0,0:13:09.66,0:13:11.16,Default,,0,0,0,,Ха!
Dialogue: 0,0:13:13.70,0:13:16.71,Default,,0,0,0,,Мару Мару! Бұл
Dialogue: 0,0:13:17.42,0:13:18.42,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:20.88,0:13:22.05,Default,,0,0,0,,Хаа!
Dialogue: 0,0:13:22.88,0:13:25.05,Default,,0,0,0,,Усами Бұл!
Dialogue: 0,0:13:30.30,0:13:33.10,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:14:06.67,0:14:08.05,Default,,0,0,0,,Уф...
Dialogue: 0,0:14:11.64,0:14:15.56,Default,,0,0,0,,Ауылдың қарапайым адамдары көбейіп кеткен сияқты.
Dialogue: 0,0:14:16.39,0:14:19.69,Default,,0,0,0,,(Усамидің айқайы)
Dialogue: 0,0:14:35.54,0:14:39.08,Default,,0,0,0,,(Усамидің айқайы)
Dialogue: 0,0:14:39.79,0:14:43.63,Default,,0,0,0,,Барлығы сонда ма? Басқа жараланғандар бар ма?
Dialogue: 0,0:14:43.71,0:14:46.55,Default,,0,0,0,,Наито мырза бірінші болып секіріп кетті.
Dialogue: 0,0:14:47.05,0:14:48.05,Default,,0,0,0,,Қияметсіз...
Dialogue: 0,0:14:48.30,0:14:49.26,Default,,0,0,0,,Қарғыс атқыр...
Dialogue: 0,0:14:49.47,0:14:50.01,Default,,0,0,0,,Ах!
Dialogue: 0,0:14:50.76,0:14:51.76,Default,,0,0,0,,Ұстаз!
Dialogue: 0,0:14:53.01,0:14:54.01,Default,,0,0,0,,Сіз қауіпсізсіз деп үміттенемін...
Dialogue: 0,0:14:54.51,0:14:57.64,Default,,0,0,0,,Олар Мизухаши өлгендіктен кірді.
Dialogue: 0,0:14:57.73,0:15:00.85,Default,,0,0,0,,Қуатты дереу қалпына келтірмесек, Хошио мырза...
Dialogue: 0,0:15:05.48,0:15:07.90,Default,,0,0,0,,Қазірдің өзінде... өлді
Dialogue: 0,0:15:07.99,0:15:09.28,Default,,0,0,0,,А...
Dialogue: 0,0:15:09.36,0:15:10.07,Default,,0,0,0,,Ах...
Dialogue: 0,0:15:11.53,0:15:13.99,Default,,0,0,0,,Мен оларды ешқашан күтпедім...
Dialogue: 0,0:15:15.66,0:15:19.46,Default,,0,0,0,,Жоқ, ол адам өмірінің ішінде қайтыс болды.
Dialogue: 0,0:15:24.96,0:15:26.80,Default,,0,0,0,,Бұл жерде ауыл болуы керек.
Dialogue: 0,0:15:27.55,0:15:29.76,Default,,0,0,0,,Күн батқанша жасай аласың ба?
Dialogue: 0,0:15:29.84,0:15:32.13,Default,,0,0,0,,Мұғалім ше? Сіз бірге емессіз бе?
Dialogue: 0,0:15:33.22,0:15:37.01,Default,,0,0,0,,Мен оны жерлеймін, сосын күзетшіммен соңынан еремін.
Dialogue: 0,0:15:37.56,0:15:38.85,Default,,0,0,0,,Жалғастырыңыз.
Dialogue: 0,0:15:40.64,0:15:42.94,Default,,0,0,0,,(сенушілердің сөзі)
Dialogue: 0,0:15:43.02,0:15:45.90,Default,,0,0,0,,Неліктен біз тұратын жерде бізді қууға болмайды?
Dialogue: 0,0:15:47.78,0:15:49.74,Default,,0,0,0,,Себебі мен жігітті жертөледе өлтірдім.
Dialogue: 0,0:15:50.78,0:15:52.45,Default,,0,0,0,,Бұл оқиға болды.
Dialogue: 0,0:15:54.82,0:15:56.08,Default,,0,0,0,,Мару... (Усами) Маған бәрібір.
Dialogue: 0,0:15:59.62,0:16:03.04,Default,,0,0,0,,Сол ғимараттағы құрал-жабдықтар оған арналып жасалған.
Dialogue: 0,0:16:03.71,0:16:05.21,Default,,0,0,0,,Енді қажет емес
Dialogue: 0,0:16:05.29,0:16:06.34,Default,,0,0,0,,Бірақ зардап шеккен адам...
Dialogue: 0,0:16:07.25,0:16:09.67,Default,,0,0,0,,Сізді көргісі келетіндер көп...
Dialogue: 0,0:16:12.01,0:16:14.55,Default,,0,0,0,,Бастапқыда екеуміз бірге тұрдық.
Dialogue: 0,0:16:15.14,0:16:20.06,Default,,0,0,0,,Егер жарақаттанған адам қаңғып кетсе, мен қалауым бойынша қол протезін жасасам ше?
Dialogue: 0,0:16:20.14,0:16:22.81,Default,,0,0,0,,Мен білмей тұрып, көп адам жиналды.
Dialogue: 0,0:16:24.69,0:16:27.06,Default,,0,0,0,,Иә...
Dialogue: 0,0:16:28.94,0:16:33.74,Default,,0,0,0,,Мен бірдеңе жасағанда ол қуанады.
Dialogue: 0,0:16:36.49,0:16:38.20,Default,,0,0,0,,Сондықтан мен оны жасадым
Dialogue: 0,0:16:39.91,0:16:41.04,Default,,0,0,0,,Сонымен
Dialogue: 0,0:16:43.41,0:16:44.92,Default,,0,0,0,,Мен дәрігер емеспін
Dialogue: 0,0:16:50.59,0:16:52.80,Default,,0,0,0,,Wonderful
Dialogue: 0,0:16:53.38,0:16:56.01,Default,,0,0,0,,Менің болашағым бар
Dialogue: 0,0:16:56.09,0:16:58.64,Default,,0,0,0,,Осыншама көп қуат өндірілсе
Dialogue: 0,0:16:58.01,0:17:00.47,Default,,0,0,0,,(шешініп жатқан дыбыс)
Dialogue: 0,0:16:58.72,0:17:00.47,Default,,0,0,0,,Мұнда қалашық салуға болады
Dialogue: 0,0:17:02.27,0:17:04.35,Default,,0,0,0,,Бұл бұзылған әлемде
Dialogue: 0,0:17:04.85,0:17:06.69,Default,,0,0,0,,Жаңа мәдениет!
Dialogue: 0,0:17:08.94,0:17:12.53,Default,,0,0,0,,Қазір бізге керегі – тәртіп пен көшбасшылық.
Dialogue: 0,0:17:13.11,0:17:14.36,Default,,0,0,0,,«Ұлт»
Dialogue: 0,0:17:14.86,0:17:17.28,Default,,0,0,0,,Балалық клик ойыны аяқталды.
Dialogue: 0,0:17:17.82,0:17:19.78,Default,,0,0,0,,Осы жерден бастаңыз!
Dialogue: 0,0:17:33.80,0:17:34.42,Default,,0,0,0,,Ум...
Dialogue: 0,0:17:34.51,0:17:35.55,Default,,0,0,0,,Қалай болғанда да, әзірге сол жерден кетіңдер
Dialogue: 0,0:17:35.63,0:17:36.63,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:37.34,0:17:39.34,Default,,0,0,0,,Осы қиын уақыт үшін кешірім сұраймыз.
Dialogue: 0,0:17:39.43,0:17:41.39,Default,,0,0,0,,Сіз бұл екеуін көрдіңіз бе?
Dialogue: 0,0:17:41.89,0:17:43.60,Default,,0,0,0,,Бұл дәрігер.
Dialogue: 0,0:17:43.68,0:17:45.85,Default,,0,0,0,,Мен білмеймін.
Dialogue: 0,0:17:45.93,0:17:50.02,Default,,0,0,0,,Маңдайыңыздағы бұл сызатты бір рет көрсеңіз, есіңізде болар.
Dialogue: 0,0:17:50.11,0:17:53.44,Default,,0,0,0,,Мен үшінші курстағы мұғаліміммен біргемін, бірақ оны бұрын ешқашан көрген емеспін.
Dialogue: 0,0:17:53.94,0:17:55.07,Default,,0,0,0,,Иә?
Dialogue: 0,0:17:55.15,0:17:58.70,Default,,0,0,0,,Бұл әдемі жігіт Иназаки мырза емес пе?
Dialogue: 0,0:17:58.78,0:17:59.95,Default,,0,0,0,,Хмм...
Dialogue: 0,0:18:00.03,0:18:01.03,Default,,0,0,0,,Не!
Dialogue: 0,0:18:01.66,0:18:04.83,Default,,0,0,0,,Аа, дұрыс, бұл Иназаки-сенсей.
Dialogue: 0,0:18:04.91,0:18:10.63,Default,,0,0,0,,Бұл екі жыл бұрын, мен ақ киім киіп, әбігерге сала бастағанға дейін болды.
Dialogue: 0,0:18:10.71,0:18:14.92,Default,,0,0,0,,Бір күні ол ештеңе айтпастан кенет жоғалып кетті.
Dialogue: 0,0:18:15.01,0:18:18.84,Default,,0,0,0,,Хирургияны білетіндіктен, мен доктор Усамидің әдістерін зерттедім.
Dialogue: 0,0:18:19.43,0:18:22.01,Default,,0,0,0,,Енді өлуге жол бермеймін деп.
Dialogue: 0,0:18:22.43,0:18:23.89,Default,,0,0,0,,Ол ынталы адам болды.
Dialogue: 0,0:18:25.47,0:18:26.48,Default,,0,0,0,,Бұл Робин...
Dialogue: 0,0:18:28.39,0:18:31.61,Default,,0,0,0,,Бұл сөзсіз Робин болатын. Өйткені ол тірі еді!
Dialogue: 0,0:18:32.77,0:18:33.77,Default,,0,0,0,,Мен сенімен танысқым келеді
Dialogue: 0,0:18:34.44,0:18:35.57,Default,,0,0,0,,Мен сенімен кездесуім керек...!
Dialogue: 0,0:18:37.03,0:18:38.15,Default,,0,0,0,,Үлкен әпке
Dialogue: 0,0:18:37.53,0:18:38.57,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:41.87,0:18:44.03,Default,,0,0,0,,Усамиді қорғайсыз ба?
Dialogue: 0,0:18:44.12,0:18:45.45,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:45.54,0:18:49.87,Default,,0,0,0,,Аа, солай болып шықты.
Dialogue: 0,0:18:50.37,0:18:51.42,Default,,0,0,0,,Хмм…
Dialogue: 0,0:18:52.00,0:18:54.46,Default,,0,0,0,,Мен де Робин туралы естігім келеді.
Dialogue: 0,0:18:53.67,0:18:54.46,Default,,0,0,0,,Жоқ…
Dialogue: 0,0:18:55.09,0:18:56.96,Default,,0,0,0,,Ал, тыңдаңдар! Мен тыңдаймын
Dialogue: 0,0:18:57.05,0:18:58.26,Default,,0,0,0,,Иә, иә
Dialogue: 0,0:18:58.34,0:18:59.34,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:02.34,0:19:03.35,Default,,0,0,0,,Хмм...
Dialogue: 0,0:19:05.06,0:19:07.10,Default,,0,0,0,,Мен әлі жоқ па деп ойлаймын, Усами…
Dialogue: 0,0:19:07.18,0:19:08.39,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:19:10.02,0:19:12.77,Default,,0,0,0,,(Қарғаның айқайы)
Dialogue: 0,0:19:19.65,0:19:21.11,Default,,0,0,0,,(Қарқылдаған дыбыс)
Dialogue: 0,0:20:17.38,0:20:18.88,Default,,0,0,0,,(оқ ату)
Dialogue: 0,0:20:19.63,0:20:20.88,Default,,0,0,0,,Ха!
Dialogue: 0,0:20:22.55,0:20:26.55,Default,,0,0,0,,♪~
Dialogue: 0,0:20:26.64,0:20:27.51,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:20:27.60,0:20:28.76,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:20:28.85,0:20:31.56,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:20:44.03,0:20:46.78,Default,,0,0,0,,Бах...! Қарғыс атқыр...
Dialogue: 0,0:20:47.57,0:20:48.62,Default,,0,0,0,,(Киришима) Сенпай Амагири жақсы жүр ме екен?
Dialogue: 0,0:20:52.50,0:20:53.50,Default,,0,0,0,,Мал?
Dialogue: 0,0:20:55.83,0:20:57.50,Default,,0,0,0,,Томо Усами
Dialogue: 0,0:20:57.58,0:21:00.25,Default,,0,0,0,,Мен Робинге қарама-қарсымын.
Dialogue: 0,0:21:02.71,0:21:03.84,Default,,0,0,0,,Менің қолым...
Dialogue: 0,0:21:06.05,0:21:07.76,Default,,0,0,0,,Тек өлім ғана туа алады!
Dialogue: 0,0:21:07.84,0:21:09.26,Default,,0,0,0,,Уф...
Dialogue: 0,0:21:10.01,0:21:12.18,Default,,0,0,0,,Идиот!
Dialogue: 0,0:21:13.31,0:21:15.77,Default,,0,0,0,,Олай айтпа...
Dialogue: 0,0:21:17.40,0:21:19.36,Default,,0,0,0,,Олай айтпа!
Dialogue: 0,0:21:20.32,0:21:23.32,Default,,0,0,0,,Егер сіз жегішті өлтірсеңіз
Dialogue: 0,0:21:23.40,0:21:25.07,Default,,0,0,0,,Адамдар енді тамақтанбайды
Dialogue: 0,0:21:25.57,0:21:27.70,Default,,0,0,0,,Әр адамның өмірі сақталады!
Dialogue: 0,0:21:53.56,0:21:55.98,Default,,0,0,0,,(Адамдар қолдайды)
Dialogue: 0,0:22:09.03,0:22:10.53,Default,,0,0,0,,Иә
Dialogue: 0,0:22:25.80,0:22:27.26,Default,,0,0,0,,Хмм... га...
Dialogue: 0,0:22:28.72,0:22:30.14,Default,,0,0,0,,Ммм
Dialogue: 0,0:22:30.22,0:22:32.72,Default,,0,0,0,,Бұл не деген жер екен...
Dialogue: 0,0:22:33.93,0:22:35.64,Default,,0,0,0,,Қараңғы...
Dialogue: 0,0:22:35.89,0:22:36.73,Default,,0,0,0,,Хмм...
Dialogue: 0,0:22:38.77,0:22:42.19,Default,,0,0,0,,Маған ұнамайды...
Dialogue: 0,0:22:44.86,0:22:47.19,Default,,0,0,0,,Хаа... Ммм.
Dialogue: 0,0:22:49.40,0:22:50.61,Default,,0,0,0,,Бұл қорқынышты...
Dialogue: 0,0:22:51.70,0:22:53.95,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:22:54.37,0:22:56.62,Default,,0,0,0,,Хмм, ха...
Dialogue: 0,0:22:59.46,0:23:00.71,Default,,0,0,0,,Хааа
Dialogue: 0,0:23:01.75,0:23:03.17,Default,,0,0,0,,Ол келді.
Dialogue: 0,0:23:06.34,0:23:07.34,Default,,0,0,0,,(Каибуки) Қызға да аяушылық көрсетпейсің, Бакуго-чан.
Dialogue: 0,0:23:08.84,0:23:10.05,Default,,0,0,0,,Қорқынышты емес
Dialogue: 0,0:23:13.72,0:23:16.35,Default,,0,0,0,,(Балалар дауысы)
Dialogue: 0,0:23:16.43,0:23:18.77,Default,,0,0,0,,хм/сағ хм/сағ...
Dialogue: 0,0:23:18.85,0:23:20.52,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:23:21.90,0:23:24.06,Default,,0,0,0,,Қанша адам күліп тұр?
Dialogue: 0,0:23:26.40,0:23:28.36,Default,,0,0,0,,Мен оның не екенін білмеймін, бірақ
Dialogue: 0,0:23:28.94,0:23:31.45,Default,,0,0,0,,Мен өзімді бақытты сезінген түс көрдім.
Dialogue: 0,0:23:32.03,0:23:33.66,Default,,0,0,0,,Иә! қандай?
Dialogue: 0,0:23:35.91,0:23:37.16,Default,,0,0,0,,Нфуфуфу
Dialogue: 0,0:23:37.99,0:23:40.00,Default,,0,0,0,,Енді көп есімде жоқ
Dialogue: 0,0:23:41.50,0:23:47.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory