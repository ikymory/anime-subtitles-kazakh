Dialogue: 0,0:00:00.50,0:00:05.50,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Қазақ тіліне аударған: ikymory\NЖоба: Anime Subtitles Kazakh (@ikymory)
Dialogue: 0,0:00:07.00,0:00:09.38,Default,,0,0,0,,Бұл – чай. Дәмі керемет.
Dialogue: 0,0:00:12.63,0:00:13.97,Default,,0,0,0,,5 жыл бұрын
Dialogue: 0,0:00:14.05,0:00:17.39,Default,,0,0,0,,Электрлік карт жарыстарын өткізу арқылы күн көретінбіз.
Dialogue: 0,0:00:18.43,0:00:20.02,Default,,0,0,0,,Өтінемін, Озаки!
Dialogue: 0,0:00:20.10,0:00:23.02,Default,,0,0,0,,Катаяма!
Dialogue: 0,0:00:23.10,0:00:25.40,Default,,0,0,0,,Кирико Кирико-чан!
Dialogue: 0,0:00:25.48,0:00:26.27,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:26.77,0:00:29.19,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:00:32.28,0:00:34.28,Default,,0,0,0,,(Харуки Харукидің ентігуі)
Dialogue: 0,0:00:35.11,0:00:37.03,Default,,0,0,0,,Күте тұрыңыз! Күте тұрыңыз, эй!
Dialogue: 0,0:00:37.12,0:00:38.20,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:38.37,0:00:39.16,Default,,0,0,0,,(соққы дыбысы)
Dialogue: 0,0:00:39.33,0:00:40.91,Default,,0,0,0,,Ха! Такехая Такехая?
Dialogue: 0,0:00:43.25,0:00:44.66,Default,,0,0,0,,Біреудің шайқасып жатқан даусы естіледі.
Dialogue: 0,0:00:44.75,0:00:47.88,Default,,0,0,0,,Хаахаа... хаа... хаа Өзіңді қатты итерме, Харуки!
Dialogue: 0,0:00:50.92,0:00:51.88,Default,,0,0,0,,Ха!
Dialogue: 0,0:00:53.13,0:00:53.67,Default,,0,0,0,,Хмм...
Dialogue: 0,0:00:56.51,0:00:57.89,Default,,0,0,0,,Гррр…
Dialogue: 0,0:00:57.97,0:01:00.81,Default,,0,0,0,,Ах… Хехе…
Dialogue: 0,0:01:00.89,0:01:03.18,Default,,0,0,0,,Тез қашайық
Dialogue: 0,0:01:03.27,0:01:05.98,Default,,0,0,0,,Жоқ, бұл жігіт менің бетімді көрді.
Dialogue: 0,0:01:06.48,0:01:08.77,Default,,0,0,0,,Ха... уф!
Dialogue: 0,0:01:10.65,0:01:12.44,Default,,0,0,0,,(Жақындап келе жатқан аяқ дыбысы)
Dialogue: 0,0:01:12.53,0:01:13.36,Default,,0,0,0,,Иә?
Dialogue: 0,0:01:17.82,0:01:19.20,Default,,0,0,0,,Менің жасым
Dialogue: 0,0:01:19.28,0:01:21.70,Default,,0,0,0,,Сен маған жақсы қарайтын сияқтысың.
Dialogue: 0,0:01:21.79,0:01:25.25,Default,,0,0,0,,Робин! Бұл жігіттер жалған билеттер жасаған.
Dialogue: 0,0:01:27.79,0:01:29.63,Default,,0,0,0,,Уф... Уф
Dialogue: 0,0:01:29.71,0:01:31.92,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:01:32.42,0:01:36.42,Default,,0,0,0,,♪~
Dialogue: 0,0:02:56.63,0:03:00.63,Default,,0,0,0,,~♪
Dialogue: 0,0:03:01.97,0:03:03.93,Default,,0,0,0,,Мен күнәларымды өтеуді қалаймын.
Dialogue: 0,0:03:04.01,0:03:08.52,Default,,0,0,0,,Сен мені осылай темірмен өлтіремін деп ойладың!
Dialogue: 0,0:03:11.44,0:03:15.65,Default,,0,0,0,,Харуки төбелескенде басқа адамнан басқа жаққа қарауға болмайды.
Dialogue: 0,0:03:16.44,0:03:18.23,Default,,0,0,0,,Біреудің көзіне қарамау
Dialogue: 0,0:03:18.32,0:03:21.95,Default,,0,0,0,,Қорқытып-үркітіп құтылуға тырысқан тауықтар осылай істейді.
Dialogue: 0,0:03:23.37,0:03:25.95,Default,,0,0,0,,Қараңыз және басқа адамның жағасына қараңыз.
Dialogue: 0,0:03:26.62,0:03:30.46,Default,,0,0,0,,Содан кейін аяқ астындағы жерді сезін.
Dialogue: 0,0:03:32.46,0:03:33.04,Default,,0,0,0,,Хмм...
Dialogue: 0,0:03:33.12,0:03:36.38,Default,,0,0,0,,Жекпе-жекте басқа адамды ғана көре алатын адам жеңіледі.
Dialogue: 0,0:03:37.42,0:03:39.51,Default,,0,0,0,,Оларды жоғарыдағыларға тапсырыңыз.
Dialogue: 0,0:03:40.05,0:03:42.43,Default,,0,0,0,,Харуки, сен кінәлісің.
Dialogue: 0,0:03:43.01,0:03:44.68,Default,,0,0,0,,Егер бірдеңе қалайтын болса, маған хабарлаңыз.
Dialogue: 0,0:03:45.18,0:03:46.26,Default,,0,0,0,,《Қандай жаман, шіріген иіс》
Dialogue: 0,0:03:47.68,0:03:50.56,Default,,0,0,0,,(аяқ дыбысы)
Dialogue: 0,0:03:50.64,0:03:51.64,Default,,0,0,0,,Мен үйдемін!
Dialogue: 0,0:03:52.44,0:03:53.52,Default,,0,0,0,,Бұл қандай ет?
Dialogue: 0,0:03:53.60,0:03:56.77,Default,,0,0,0,,Маймыл мен қарға және тышқан.
Dialogue: 0,0:03:58.23,0:04:01.40,Default,,0,0,0,,Мына секіргіш!
Dialogue: 0,0:04:01.49,0:04:02.70,Default,,0,0,0,,Оны Робиннен алдым!
Dialogue: 0,0:04:02.78,0:04:04.61,Default,,0,0,0,,Хаха, бұл біраз үлкен.
Dialogue: 0,0:04:05.12,0:04:06.99,Default,,0,0,0,,Жақында жақсарады.
Dialogue: 0,0:04:07.08,0:04:10.66,Default,,0,0,0,,Эй~ Керемет~ Мен де бірдеңені қалаймын.
Dialogue: 0,0:04:10.75,0:04:14.08,Default,,0,0,0,,Маған шалбар берсеңіз, мен оны екіге бөліп, кие аламын.
Dialogue: 0,0:04:14.17,0:04:16.96,Default,,0,0,0,,Жоқ! Менің аяғым қысқа емес!
Dialogue: 0,0:04:17.04,0:04:18.09,Default,,0,0,0,,(Барлығы күледі)
Dialogue: 0,0:04:18.55,0:04:19.96,Default,,0,0,0,,Менің қарным ашты~
Dialogue: 0,0:04:20.38,0:04:22.13,Default,,0,0,0,,Иә? (Харуки) Әпке, қош келдіңіз!
Dialogue: 0,0:04:22.22,0:04:23.13,Default,,0,0,0,,Уф...
Dialogue: 0,0:04:23.22,0:04:24.34,Default,,0,0,0,,Қандай киім кидің?
Dialogue: 0,0:04:24.43,0:04:27.30,Default,,0,0,0,,Сіз оны көрмедіңіз бе? Тастап, бас тартты
Dialogue: 0,0:04:27.39,0:04:28.05,Default,,0,0,0,,Не!
Dialogue: 0,0:04:28.14,0:04:29.26,Default,,0,0,0,,Сіз жарақат алдыңыз ба?
Dialogue: 0,0:04:29.76,0:04:31.98,Default,,0,0,0,,Жарайды, себебі менің артымнан келе жатқан адам одан аулақ болды.
Dialogue: 0,0:04:32.68,0:04:33.94,Default,,0,0,0,,Сәлем, мұғалім.
Dialogue: 0,0:04:34.02,0:04:36.40,Default,,0,0,0,,Қауіпті! Шынайы, абай болыңыз!
Dialogue: 0,0:04:36.90,0:04:38.94,Default,,0,0,0,,Сіз шынымен абай болуыңыз керек.
Dialogue: 0,0:04:39.52,0:04:41.07,Default,,0,0,0,,(Ходжинс) Көріп тұрғаныңыздай, базадағы сарбаздар қуыршақтарға сұраныс жоғары.
Dialogue: 0,0:04:42.03,0:04:44.90,Default,,0,0,0,,Аа, дұрыс, Кирико-чан, хе...
Dialogue: 0,0:04:46.57,0:04:49.20,Default,,0,0,0,,Менің камерамда жарқыл бар.
Dialogue: 0,0:04:49.28,0:04:51.58,Default,,0,0,0,,Жаңа бромды жасап сатайық хехе
Dialogue: 0,0:04:52.16,0:04:54.41,Default,,0,0,0,,Содан кейін мұғаліммен суретке түсіңіз.
Dialogue: 0,0:04:54.50,0:04:55.83,Default,,0,0,0,,Мен жақсымын, рақмет.
Dialogue: 0,0:04:55.92,0:04:57.00,Default,,0,0,0,,Мен суретке түсемін
Dialogue: 0,0:04:59.71,0:05:01.50,Default,,0,0,0,,Эхехе (Дәрігер) Мен қазір барамын.
Dialogue: 0,0:05:01.59,0:05:03.67,Default,,0,0,0,,Иә, рахмет, мұғалім.
Dialogue: 0,0:05:04.17,0:05:08.30,Default,,0,0,0,,Харуки Бұл дәрігер каннибализмді жасырын зерттеген.
Dialogue: 0,0:05:08.39,0:05:10.56,Default,,0,0,0,,Олар адамдарға эксперимент жүргізіп жатырмыз дейді.
Dialogue: 0,0:05:10.64,0:05:11.77,Default,,0,0,0,,Иә!
Dialogue: 0,0:05:11.85,0:05:13.77,Default,,0,0,0,,Робин қазір тергеуде.
Dialogue: 0,0:05:14.31,0:05:17.10,Default,,0,0,0,,Кирико-чанға тым жақын жолатпаған дұрыс.
Dialogue: 0,0:05:17.77,0:05:18.77,Default,,0,0,0,,Күрсін...
Dialogue: 0,0:05:28.53,0:05:30.49,Default,,0,0,0,,Харуки Суық емес пе?
Dialogue: 0,0:05:30.99,0:05:33.37,Default,,0,0,0,,Иә, апаң ше?
Dialogue: 0,0:05:33.45,0:05:34.50,Default,,0,0,0,,Барлығы дүрбелеңде.
Dialogue: 0,0:05:34.58,0:05:37.00,Default,,0,0,0,,Иә? Сонда мен кірейін бе?
Dialogue: 0,0:05:38.92,0:05:41.71,Default,,0,0,0,,Уау! А... сен шынымен кіресің бе?
Dialogue: 0,0:05:42.55,0:05:43.09,Default,,0,0,0,,Иә?
Dialogue: 0,0:05:45.72,0:05:46.72,Default,,0,0,0,,Не болды?
Dialogue: 0,0:05:47.22,0:05:49.22,Default,,0,0,0,,3-ші көшеде каннибал болған!
Dialogue: 0,0:05:49.30,0:05:51.72,Default,,0,0,0,,Мен сені бұл жерге кіргізбеймін, уайымдамай ұйықта!
Dialogue: 0,0:05:52.72,0:05:54.43,Default,,0,0,0,,Кеттік, Робин! иә!
Dialogue: 0,0:05:55.18,0:05:56.23,Default,,0,0,0,,Хмм...
Dialogue: 0,0:05:57.81,0:05:58.98,Default,,0,0,0,,Сіз барасыз ба?
Dialogue: 0,0:05:59.06,0:06:02.32,Default,,0,0,0,,Жарайды! Өзім жасаған мылтығым да бар.
Dialogue: 0,0:06:03.44,0:06:05.28,Default,,0,0,0,,Мен Робинге көмектескім келеді!
Dialogue: 0,0:06:05.36,0:06:06.78,Default,,0,0,0,,Хмм...
Dialogue: 0,0:06:11.16,0:06:14.24,Default,,0,0,0,,Ойлап қарасам, бұл күндер мен үшін болды.
Dialogue: 0,0:06:16.29,0:06:18.12,Default,,0,0,0,,Бұл «аспан» болуы мүмкін
Dialogue: 0,0:06:20.50,0:06:21.38,Default,,0,0,0,,Танк шайқасы басталады!
Dialogue: 0,0:06:22.50,0:06:23.84,Default,,0,0,0,,Бұл керемет (Харуки) Ах...
Dialogue: 0,0:06:24.46,0:06:27.67,Default,,0,0,0,,Өткен аптада сіз сол қарумен каннибалды өлтірдіңіз бе?
Dialogue: 0,0:06:28.30,0:06:29.30,Default,,0,0,0,,Иә...
Dialogue: 0,0:06:29.76,0:06:33.76,Default,,0,0,0,,Мұны көңіл көтеру үшін жасамаңыз. Қауіпті болғандықтан келмеу керек!
Dialogue: 0,0:06:34.81,0:06:36.31,Default,,0,0,0,,...Мен ашуландым.
Dialogue: 0,0:06:38.35,0:06:41.19,Default,,0,0,0,,Робин 10 жыл бұрын апаттан қайтыс болды.
Dialogue: 0,0:06:41.27,0:06:43.94,Default,,0,0,0,,Өзіммен құрдас әпкемнен айырылдым.
Dialogue: 0,0:06:44.61,0:06:48.78,Default,,0,0,0,,Ендеше...не айтамын, мен біраз қорғаншақпын.
Dialogue: 0,0:06:49.74,0:06:52.53,Default,,0,0,0,,Ха! Әй, қазір сағат қанша?
Dialogue: 0,0:06:52.62,0:06:56.79,Default,,0,0,0,,Маған қай сағат жарасады...
Dialogue: 0,0:06:57.66,0:06:58.29,Default,,0,0,0,,Міне, осы
Dialogue: 0,0:06:58.37,0:06:59.71,Default,,0,0,0,,О 2:20
Dialogue: 0,0:06:59.79,0:07:02.71,Default,,0,0,0,,Жоқ! Сағат 3-те апамның жарысы басталады.
Dialogue: 0,0:07:02.79,0:07:03.79,Default,,0,0,0,,Жақында кездескенше!
Dialogue: 0,0:07:04.29,0:07:06.46,Default,,0,0,0,,Робин тым қорғаншы болуы мүмкін.
Dialogue: 0,0:07:06.92,0:07:08.80,Default,,0,0,0,,Ол Cisco компьютері.
Dialogue: 0,0:07:09.13,0:07:10.38,Default,,0,0,0,,Дұрыс.
Dialogue: 0,0:07:11.01,0:07:14.39,Default,,0,0,0,,(аудиторияның қолдауы)
Dialogue: 0,0:07:15.26,0:07:17.27,Default,,0,0,0,,Бірақ Карс қорқақтық танытып, соғысқа жалған адам жібереді—
Dialogue: 0,0:07:25.94,0:07:27.82,Default,,0,0,0,,Жарайды, мен оны уақытында орындадым...
Dialogue: 0,0:07:28.49,0:07:30.24,Default,,0,0,0,,(басылған ысырма дыбысы)
Dialogue: 0,0:07:30.74,0:07:31.74,Default,,0,0,0,,Иә?
Dialogue: 0,0:07:43.21,0:07:44.96,Default,,0,0,0,,(Ысырманы басу дыбысы)
Dialogue: 0,0:07:49.17,0:07:51.22,Default,,0,0,0,,Уау! біреу!
Dialogue: 0,0:07:51.30,0:07:54.39,Default,,0,0,0,,Курстың соңында каннибал бар!
Dialogue: 0,0:07:54.47,0:07:57.26,Default,,0,0,0,,Бұрынғыдай, мөлдір болатын
Dialogue: 0,0:08:00.43,0:08:02.02,Default,,0,0,0,,(қозғалтқыш дыбысы/қуаныш)
Dialogue: 0,0:08:02.10,0:08:04.90,Default,,0,0,0,,Енді барлық машиналар бір уақытта іске қосылды.
Dialogue: 0,0:08:04.98,0:08:07.90,Default,,0,0,0,,Бүгін бізді қандай жарыс күтіп тұр?
Dialogue: 0,0:08:07.98,0:08:09.57,Default,,0,0,0,,Әпке... уф
Dialogue: 0,0:08:11.11,0:08:13.61,Default,,0,0,0,,Каннибал кірген аркадада
Dialogue: 0,0:08:13.70,0:08:16.32,Default,,0,0,0,,Арба келгенше 7-8 минут болуы керек.
Dialogue: 0,0:08:17.95,0:08:19.12,Default,,0,0,0,,Мен айдап кетемін
Dialogue: 0,0:08:21.75,0:08:23.04,Default,,0,0,0,,Мен мұны істеймін!
Dialogue: 0,0:08:26.00,0:08:27.42,Default,,0,0,0,,Ұзын түзуді аяқтау
Dialogue: 0,0:08:27.50,0:08:30.59,Default,,0,0,0,,Екінші бұрышты бұру No 8 No 3 No 4 Wow!
Dialogue: 0,0:08:31.26,0:08:34.38,Default,,0,0,0,,5 саны 2 саны осында айналады! Өте кеш!
Dialogue: 0,0:08:34.47,0:08:36.76,Default,,0,0,0,,Топ Сенсожи храмына қарай жүрді.
Dialogue: 0,0:08:36.85,0:08:39.26,Default,,0,0,0,,№ 4 Такехая оны сәтті жұлып алды!
Dialogue: 0,0:08:39.35,0:08:41.27,Default,,0,0,0,,Кирико-чан, тамаша!
Dialogue: 0,0:08:44.94,0:08:45.94,Default,,0,0,0,,Ол қайда?
Dialogue: 0,0:08:46.73,0:08:48.19,Default,,0,0,0,,Сіз курстан шықтыңыз ба...?
Dialogue: 0,0:08:50.03,0:08:51.11,Default,,0,0,0,,Онда!
Dialogue: 0,0:08:59.20,0:09:01.58,Default,,0,0,0,,Бұл таңқаларлық тиімді емес...
Dialogue: 0,0:09:11.92,0:09:12.80,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:12.88,0:09:13.92,Default,,0,0,0,,Уау!
Dialogue: 0,0:09:16.97,0:09:20.14,Default,,0,0,0,,А... Аа...
Dialogue: 0,0:09:20.68,0:09:23.48,Default,,0,0,0,,А... А...
Dialogue: 0,0:09:24.06,0:09:27.02,Default,,0,0,0,,Батырлар курсы: Дэнки Камина!
Dialogue: 0,0:09:27.31,0:09:28.31,Default,,0,0,0,,Ха!
Dialogue: 0,0:09:29.48,0:09:30.40,Default,,0,0,0,,A сыныбы Тодорокидің мұздату шабуылымен алға шықты, бірақ
Dialogue: 0,0:09:30.48,0:09:32.32,Default,,0,0,0,,(каннибал ыңқылы)
Dialogue: 0,0:09:32.94,0:09:35.03,Default,,0,0,0,,Мен мұны істедім. Бұл сезіледі... Уау.
Dialogue: 0,0:09:36.32,0:09:37.91,Default,,0,0,0,,Уау! Уау...
Dialogue: 0,0:09:38.41,0:09:39.37,Default,,0,0,0,,Уф...
Dialogue: 0,0:09:39.95,0:09:40.62,Default,,0,0,0,,Қолдар!
Dialogue: 0,0:09:41.28,0:09:42.79,Default,,0,0,0,,Қолдау бөлімі, Кәсіпкерлік бөлімі—
Dialogue: 0,0:09:42.87,0:09:45.21,Default,,0,0,0,,Мені жіберіңізші... Уф...
Dialogue: 0,0:09:46.04,0:09:47.46,Default,,0,0,0,,Екеуің неге сонда тұрып, аң-таң болып қарап тұрсыңдар?
Dialogue: 0,0:09:48.54,0:09:50.79,Default,,0,0,0,,…өйткені ол ит алғысы келетінін айта бастады
Dialogue: 0,0:09:51.29,0:09:52.75,Default,,0,0,0,,Жеді!
Dialogue: 0,0:09:52.84,0:09:54.51,Default,,0,0,0,,Вааах!
Dialogue: 0,0:09:54.59,0:09:56.51,Default,,0,0,0,,Маған көмектесші, Робин!
Dialogue: 0,0:09:56.59,0:09:58.43,Default,,0,0,0,,Бірінші 4 Такехая
Dialogue: 0,0:09:58.51,0:10:00.72,Default,,0,0,0,,Үшінші бұрыш арқылы аркадаға өтіңіз
Dialogue: 0,0:10:01.30,0:10:04.56,Default,,0,0,0,,Енді, бұдан былай мен сізге біраз уақыт хабар тарататын орындардан ілесе алмаймын.
Dialogue: 0,0:10:04.64,0:10:08.23,Default,,0,0,0,,Қазіргі уақытта Асакуса жарысы бүкіл курста камераларды таратады...
Dialogue: 0,0:10:08.31,0:10:09.60,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:10.61,0:10:12.27,Default,,0,0,0,,Иә?Не?
Dialogue: 0,0:10:12.94,0:10:16.28,Default,,0,0,0,,Тоқта! Каннибализм пайда болды, нәсіл жарамсыз!
Dialogue: 0,0:10:16.99,0:10:18.61,Default,,0,0,0,,Артқа қайтып, штабқа хабарлаңыз.
Dialogue: 0,0:10:18.70,0:10:19.70,Default,,0,0,0,,(Игги) Ұф! (Джозеф) Хи-хи
Dialogue: 0,0:10:21.91,0:10:24.04,Default,,0,0,0,,Сен ұшқан сорлы! Маған ілесіп суға сүңгисің деп кім ойлаған
Dialogue: 0,0:10:24.12,0:10:26.29,Default,,0,0,0,,Сен ұшқан сорлы! Маған ілесіп суға сүңгисің деп кім ойлаған
Dialogue: 0,0:10:26.37,0:10:27.46,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:27.54,0:10:29.75,Default,,0,0,0,,Сен ұшқан сорлы! Маған ілесіп суға сүңгисің деп кім ойлаған
Dialogue: 0,0:10:33.63,0:10:34.67,Default,,0,0,0,,Ха!
Dialogue: 0,0:10:35.13,0:10:36.13,Default,,0,0,0,,Харуки...!
Dialogue: 0,0:10:40.72,0:10:42.14,Default,,0,0,0,,Харуки!
Dialogue: 0,0:10:46.35,0:10:47.14,Default,,0,0,0,,Уф...
Dialogue: 0,0:10:48.89,0:10:49.52,Default,,0,0,0,,Уф
Dialogue: 0,0:10:49.60,0:10:51.19,Default,,0,0,0,,(каннибал ыңқылы)
Dialogue: 0,0:10:51.31,0:10:52.86,Default,,0,0,0,,Сол кезде мені қорғауға барынша тырысқаның үшін рахмет.
Dialogue: 0,0:10:52.94,0:10:53.94,Default,,0,0,0,,Каэ... Се...
Dialogue: 0,0:10:54.82,0:10:57.99,Default,,0,0,0,,Харукиді қайтарыңыз!
Dialogue: 0,0:10:59.57,0:11:01.57,Default,,0,0,0,,Ах… Хехе…
Dialogue: 0,0:11:03.03,0:11:06.45,Default,,0,0,0,,Ах… Хехе…
Dialogue: 0,0:11:06.54,0:11:07.70,Default,,0,0,0,,Ха!
Dialogue: 0,0:11:09.08,0:11:11.75,Default,,0,0,0,,А... өтірік...
Dialogue: 0,0:11:12.96,0:11:13.96,Default,,0,0,0,,Жоқ...
Dialogue: 0,0:11:14.59,0:11:16.00,Default,,0,0,0,,А... а...
Dialogue: 0,0:11:16.92,0:11:19.42,Default,,0,0,0,,(жылайды)
Dialogue: 0,0:11:19.51,0:11:23.39,Default,,0,0,0,,Сәлем... Біреу... Біреу асығыңыз...
Dialogue: 0,0:11:23.89,0:11:26.14,Default,,0,0,0,,Бұл кім?
Dialogue: 0,0:11:27.06,0:11:29.85,Default,,0,0,0,,Менің әпкем...чан...
Dialogue: 0,0:11:32.10,0:11:33.98,Default,,0,0,0,,Жақын... Эй...
Dialogue: 0,0:11:36.36,0:11:38.36,Default,,0,0,0,,Эй... Ча...
Dialogue: 0,0:11:39.78,0:11:41.53,Default,,0,0,0,,Біріншіден, аяқтарыңыздың астындағы қорапқа қараңыздар
Dialogue: 0,0:12:41.05,0:12:42.09,Default,,0,0,0,,…қашып кету…
Dialogue: 0,0:12:47.22,0:12:48.30,Default,,0,0,0,,Әпке...
Dialogue: 0,0:12:54.77,0:12:56.02,Default,,0,0,0,,Бас...
Dialogue: 0,0:12:57.23,0:12:58.27,Default,,0,0,0,,Ыстық...
Dialogue: 0,0:13:02.28,0:13:05.78,Default,,0,0,0,,Әпке...чан...
Dialogue: 0,0:13:15.58,0:13:17.58,Default,,0,0,0,,Біріншіден, аяқтарыңыздың астындағы қорапқа қараңыздар
Dialogue: 0,0:13:21.67,0:13:22.51,Default,,0,0,0,,Хмм...
Dialogue: 0,0:13:34.06,0:13:35.10,Default,,0,0,0,,Әпке?
Dialogue: 0,0:13:35.60,0:13:36.60,Default,,0,0,0,,Фалько…
Dialogue: 0,0:13:37.23,0:13:37.90,Default,,0,0,0,,Ах...
Dialogue: 0,0:13:39.23,0:13:42.48,Default,,0,0,0,,Уау! Әпке!
Dialogue: 0,0:13:43.28,0:13:47.78,Default,,0,0,0,,Ха! Хаа...ха...
Dialogue: 0,0:13:47.86,0:13:49.66,Default,,0,0,0,,Ха… га
Dialogue: 0,0:13:50.33,0:13:53.37,Default,,0,0,0,,Ха... Такехая-сан есін жиды!
Dialogue: 0,0:14:12.81,0:14:15.18,Default,,0,0,0,,Тағы бір адам жегіш бар.
Dialogue: 0,0:14:15.77,0:14:17.85,Default,,0,0,0,,Бір бала қайтыс болды.
Dialogue: 0,0:14:18.35,0:14:19.52,Default,,0,0,0,,Бұл ақылсыз...
Dialogue: 0,0:14:19.60,0:14:21.31,Default,,0,0,0,,Мм... иә...
Dialogue: 0,0:14:22.69,0:14:24.44,Default,,0,0,0,,А... ә...
Dialogue: 0,0:14:24.53,0:14:25.65,Default,,0,0,0,,Әй...
Dialogue: 0,0:14:26.74,0:14:28.41,Default,,0,0,0,,Ах... Ха!
Dialogue: 0,0:14:31.74,0:14:32.91,Default,,0,0,0,,Сәлем...
Dialogue: 0,0:14:32.99,0:14:35.62,Default,,0,0,0,,Әпке? Апыр-ай!
Dialogue: 0,0:14:35.70,0:14:37.58,Default,,0,0,0,,Уф... Уау!
Dialogue: 0,0:14:38.37,0:14:39.37,Default,,0,0,0,,Мен?
Dialogue: 0,0:14:39.46,0:14:41.08,Default,,0,0,0,,Уау!
Dialogue: 0,0:14:41.17,0:14:42.92,Default,,0,0,0,,Ах...! Ах... аа...
Dialogue: 0,0:14:43.00,0:14:46.17,Default,,0,0,0,,А... а... а...!
Dialogue: 0,0:14:46.26,0:14:48.47,Default,,0,0,0,,Шулы! Мен Харукимін!
Dialogue: 0,0:14:49.05,0:14:51.76,Default,,0,0,0,,Менің әпкем қайда? Мен әпкеммен танысқым келеді!
Dialogue: 0,0:14:51.85,0:14:55.72,Default,,0,0,0,,Уф... Әпке... Әпке!
Dialogue: 0,0:15:02.61,0:15:06.19,Default,,0,0,0,,Бәлкім, інісінің өлуіне жол берген шоктан шығар.
Dialogue: 0,0:15:06.28,0:15:08.99,Default,,0,0,0,,Ол өзін інісі деп ойлайтын сияқты.
Dialogue: 0,0:15:09.61,0:15:10.74,Default,,0,0,0,,Бейшара жігіт
Dialogue: 0,0:15:11.78,0:15:13.49,Default,,0,0,0,,Дәрігер...? (1-ер адам) Иә?
Dialogue: 0,0:15:14.45,0:15:16.29,Default,,0,0,0,,Ол дәрігер не істеді?
Dialogue: 0,0:15:16.91,0:15:18.12,Default,,0,0,0,,Ол түсінеді.
Dialogue: 0,0:15:18.71,0:15:19.79,Default,,0,0,0,,Дәрігер қайда?
Dialogue: 0,0:15:20.46,0:15:24.75,Default,,0,0,0,,Дәрігер сізді емдегеннен кейін қаладан шығып кетті.
Dialogue: 0,0:15:24.84,0:15:25.96,Default,,0,0,0,,Ха…
Dialogue: 0,0:15:26.05,0:15:30.47,Default,,0,0,0,,Екеуің де, ағаң да, әпкең де, ауруханаға өлімге жақын күйде жеткізілдің.
Dialogue: 0,0:15:32.89,0:15:37.60,Default,,0,0,0,,Ағаң үшін кешірім сұраймын, бірақ оған қандай ем жасасаң да.
Dialogue: 0,0:15:38.06,0:15:41.90,Default,,0,0,0,,Сен болмасаң, екеуміз де өлетін едік деп ойлаймын.
Dialogue: 0,0:15:44.81,0:15:45.94,Default,,0,0,0,,Әрі қарай!
Dialogue: 0,0:15:47.40,0:15:49.36,Default,,0,0,0,,Соңғы көрген апам
Dialogue: 0,0:15:50.65,0:15:53.66,Default,,0,0,0,,Мен жылап едім, бірақ тірі едім.
Dialogue: 0,0:15:55.16,0:15:59.62,Default,,0,0,0,,Менің әпкемді адам жегіштер өлтірген бе деп ойлаймын...
Dialogue: 0,0:16:01.16,0:16:05.34,Default,,0,0,0,,Менің Харуки екенім анық.
Dialogue: 0,0:16:06.21,0:16:12.01,Default,,0,0,0,,Соның айғағы ретінде әпкемнен айырылудың мұңы менің жаныма батары сөзсіз.
Dialogue: 0,0:16:12.59,0:16:15.93,Default,,0,0,0,,Ал анда-санда көтеріледі
Dialogue: 0,0:16:16.55,0:16:21.02,Default,,0,0,0,,Маған ұнайтын әйелдің денесін алудың күңгірт қуанышы
Dialogue: 0,0:16:22.52,0:16:27.52,Default,,0,0,0,,Әпкемнің жарақаты жазылып, белгілі бір дәрежеде қозғала алатын болды.
Dialogue: 0,0:16:28.19,0:16:30.53,Default,,0,0,0,,Оның ауруханаға түскеніне төрт айға жуық уақыт болды.
Dialogue: 0,0:16:35.07,0:16:38.03,Default,,0,0,0,,Робин дәрігердің құпия жағын іздеген болуы керек.
Dialogue: 0,0:16:38.79,0:16:40.79,Default,,0,0,0,,Робин біле алатынына сенімдімін.
Dialogue: 0,0:16:41.29,0:16:43.62,Default,,0,0,0,,Неліктен мен үлкен әпке болып жатырмын?
Dialogue: 0,0:16:44.37,0:16:46.42,Default,,0,0,0,,Менің әпкем неліктен өлді?
Dialogue: 0,0:16:47.88,0:16:48.75,Default,,0,0,0,,Кешіріңіз
Dialogue: 0,0:16:48.84,0:16:49.67,Default,,0,0,0,,Иә?
Dialogue: 0,0:16:50.26,0:16:53.55,Default,,0,0,0,,Мен Асакуса жарыс клубының қызметкері Иназаки Иназаки Робинмен танысқым келеді.
Dialogue: 0,0:16:53.63,0:16:56.43,Default,,0,0,0,,А, бұл мүмкін емес...
Dialogue: 0,0:16:58.22,0:17:00.81,Default,,0,0,0,,Робин өткен жылдың қыркүйегінде болды ма?
Dialogue: 0,0:17:02.14,0:17:04.02,Default,,0,0,0,,Өлтірген болуы мүмкін.
Dialogue: 0,0:17:04.10,0:17:04.94,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:05.02,0:17:06.10,Default,,0,0,0,,Хаха...
Dialogue: 0,0:17:06.19,0:17:08.90,Default,,0,0,0,,Өткен жылы бұл жерде жоғалып кеткендер саны артқан.
Dialogue: 0,0:17:09.40,0:17:12.15,Default,,0,0,0,,Соған байланысты олар кінәліні тергеп жатқан көрінеді.
Dialogue: 0,0:17:12.78,0:17:16.20,Default,,0,0,0,,Ақырында адамның өзі де жоғалып кетті.
Dialogue: 0,0:17:16.78,0:17:19.20,Default,,0,0,0,,Хааха... уф... хаа
Dialogue: 0,0:17:20.20,0:17:22.29,Default,,0,0,0,,Кен! Жүгіріп кетті!
Dialogue: 0,0:17:22.79,0:17:23.83,Default,,0,0,0,,Директор!
Dialogue: 0,0:17:24.50,0:17:25.79,Default,,0,0,0,,Барлығына!
Dialogue: 0,0:17:26.17,0:17:27.96,Default,,0,0,0,,Хаа… хаа…
Dialogue: 0,0:17:30.46,0:17:31.59,Default,,0,0,0,,Ха…
Dialogue: 0,0:17:31.67,0:17:35.43,Default,,0,0,0,,Кешіріңіз! Мұндағы Фунаяма балалар үйі туралы не деуге болады?
Dialogue: 0,0:17:36.05,0:17:37.84,Default,,0,0,0,,Мен басқа жерге бардым.
Dialogue: 0,0:17:37.93,0:17:38.60,Default,,0,0,0,,Е...
Dialogue: 0,0:17:38.68,0:17:41.89,Default,,0,0,0,,Ең көп табыс тапқан жүгіруші апаттан қайтыс болды.
Dialogue: 0,0:17:42.43,0:17:45.52,Default,,0,0,0,,Көшбасшы бала жоқ.
Dialogue: 0,0:17:45.60,0:17:47.31,Default,,0,0,0,,Түрлі бақытсыздықтарға байланысты
Dialogue: 0,0:17:47.40,0:17:50.07,Default,,0,0,0,,Мен бұл қалада енді жете алмаймын деп ойлаймын.
Dialogue: 0,0:17:53.19,0:17:55.20,Default,,0,0,0,,(есіктің ашылған дыбысы)
Dialogue: 0,0:17:58.07,0:17:59.07,Default,,0,0,0,,(есік жабылған дыбыс)
Dialogue: 0,0:18:01.45,0:18:03.20,Default,,0,0,0,,( Төсекке құлау дыбысы)
Dialogue: 0,0:18:10.09,0:18:11.13,Default,,0,0,0,,Әпке...
Dialogue: 0,0:18:12.71,0:18:14.96,Default,,0,0,0,,Робин... Ух...
Dialogue: 0,0:18:16.38,0:18:17.22,Default,,0,0,0,,Уф...
Dialogue: 0,0:18:18.34,0:18:21.93,Default,,0,0,0,,Ақырында адамның өзі де жоқ болып кетті.
Dialogue: 0,0:18:22.01,0:18:24.72,Default,,0,0,0,,Көшбасшы бала жоқ.
Dialogue: 0,0:18:24.81,0:18:25.64,Default,,0,0,0,,Ха!
Dialogue: 0,0:18:26.52,0:18:29.06,Default,,0,0,0,,Жоқ па? Ол жоғалып кетті ме?
Dialogue: 0,0:18:29.65,0:18:32.44,Default,,0,0,0,,Робиннің өлгеніне әлі ешқандай дәлел жоқ!
Dialogue: 0,0:18:33.48,0:18:34.28,Default,,0,0,0,,Ах...
Dialogue: 0,0:18:36.44,0:18:38.45,Default,,0,0,0,,Робиннің өлуі мүмкін емес...
Dialogue: 0,0:18:38.53,0:18:39.28,Default,,0,0,0,,Хаа…
Dialogue: 0,0:18:39.74,0:18:42.49,Default,,0,0,0,,Оның бір жерде тірі екені анық! Ха…
Dialogue: 0,0:18:43.83,0:18:44.83,Default,,0,0,0,,Ол дәрігер...
Dialogue: 0,0:18:45.45,0:18:47.33,Default,,0,0,0,,Дәрігер бәрін біледі!
Dialogue: 0,0:18:47.41,0:18:51.21,Default,,0,0,0,,Робиннің тұрған жері және әпкемнің қайтыс болу себебі...
Dialogue: 0,0:18:51.29,0:18:52.96,Default,,0,0,0,,(Номудың айғайы)
Dialogue: 0,0:18:53.04,0:18:55.76,Default,,0,0,0,,Менің әлі тірі болуымның себебі, мен үлкен әпке атандым!
Dialogue: 0,0:18:59.72,0:19:03.26,Default,,0,0,0,,Осыдан кейін мен оларды іздеп, әртүрлі қалаларда тұрдым.
Dialogue: 0,0:19:03.64,0:19:07.52,Default,,0,0,0,,Сұраныстарды орындаңыз және өз бетіңізше кез келген нәрсені жасай аласыз
Dialogue: 0,0:19:10.35,0:19:14.40,Default,,0,0,0,,Шамамен төрт жылдан кейін мен сені Наканода кездестірдім.
Dialogue: 0,0:19:21.78,0:19:24.41,Default,,0,0,0,,Мен біреуге мұндай нәрсені бірінші рет айтып отырмын.
Dialogue: 0,0:19:26.33,0:19:28.25,Default,,0,0,0,,Мен бір нәрсені растағым келеді...
Dialogue: 0,0:19:29.41,0:19:32.58,Default,,0,0,0,,Мүмкін мен сізді әпке деп атамауым керек еді...
Dialogue: 0,0:19:32.67,0:19:33.92,Default,,0,0,0,,Онда?
Dialogue: 0,0:19:34.00,0:19:35.59,Default,,0,0,0,,Жоқ, бәрі жақсы.
Dialogue: 0,0:19:35.67,0:19:39.30,Default,,0,0,0,,Сізді осында шақырғанына бір ай болды, сондықтан екеуің де үйреніп қалғансыңдар, солай ма?
Dialogue: 0,0:19:39.92,0:19:44.18,Default,,0,0,0,,Жарайды, бұл себеп, сондықтан мені ер адам деп есептеңіз.
Dialogue: 0,0:19:44.26,0:19:46.64,Default,,0,0,0,,Бұл кенеттен мүмкін емес...
Dialogue: 0,0:19:49.60,0:19:50.69,Default,,0,0,0,,Хмм... мм
Dialogue: 0,0:19:51.10,0:19:53.86,Default,,0,0,0,,Сен сондай әдемі бала екенсің, мен сені енді көрмеймін.
Dialogue: 0,0:19:53.94,0:19:56.23,Default,,0,0,0,,Жақында дұрыс адамды табасыз
Dialogue: 0,0:19:56.32,0:19:59.49,Default,,0,0,0,,Мен мұндай әйелді таба алмаймын.
Dialogue: 0,0:19:59.57,0:20:01.99,Default,,0,0,0,,Себебі олардың миы еркектермен бірдей.
Dialogue: 0,0:20:03.32,0:20:06.53,Default,,0,0,0,,Бұл... Фотодағы Джейн Инамура ма?
Dialogue: 0,0:20:06.62,0:20:07.99,Default,,0,0,0,,Робин Иназаки
Dialogue: 0,0:20:09.08,0:20:11.21,Default,,0,0,0,,Ол адам туралы не ойлайсың?
Dialogue: 0,0:20:13.25,0:20:14.58,Default,,0,0,0,,Дұрыс...
Dialogue: 0,0:20:15.21,0:20:18.46,Default,,0,0,0,,Біз бір үйде өстік, сондықтан бір отбасы сияқтымыз.
Dialogue: 0,0:20:18.96,0:20:20.51,Default,,0,0,0,,Ол да менің ең жақын досым.
Dialogue: 0,0:20:21.47,0:20:23.01,Default,,0,0,0,,Мен де саған тәнті болдым
Dialogue: 0,0:20:23.09,0:20:24.51,Default,,0,0,0,,Хмм…
Dialogue: 0,0:20:25.10,0:20:27.06,Default,,0,0,0,,Сонымен! Гомосексуал ретінде!
Dialogue: 0,0:20:27.14,0:20:29.06,Default,,0,0,0,,Сіз әлі де шатасасыз.
Dialogue: 0,0:20:29.14,0:20:32.31,Default,,0,0,0,,Мені осылай тастап кетсең, абдырап қалады!
Dialogue: 0,0:20:32.39,0:20:33.85,Default,,0,0,0,,Күрсін
Dialogue: 0,0:20:33.94,0:20:36.23,Default,,0,0,0,,Бір рет ұйықтап, санаңызды тазартыңыз.
Dialogue: 0,0:20:36.73,0:20:40.82,Default,,0,0,0,,Мұны орындаңыз. Мен оянсам, бұл оқиға жай ғана түс болуы мүмкін.
Dialogue: 0,0:20:41.40,0:20:42.90,Default,,0,0,0,,Уау!
Dialogue: 0,0:20:42.99,0:20:44.78,Default,,0,0,0,,Не, сен шулысың!
Dialogue: 0,0:20:44.86,0:20:45.74,Default,,0,0,0,,Уау... Уау!
Dialogue: 0,0:20:45.82,0:20:47.16,Default,,0,0,0,,Не болды!
Dialogue: 0,0:20:47.24,0:20:49.95,Default,,0,0,0,,Терезенің сыртында үлкен балық тұр екен!
Dialogue: 0,0:20:50.04,0:20:51.04,Default,,0,0,0,,Балық?
Dialogue: 0,0:20:53.00,0:20:57.25,Default,,0,0,0,,Жаңбыр жаумағаны рас, бірақ терезенің сырты дымқыл.
Dialogue: 0,0:20:57.84,0:20:58.84,Default,,0,0,0,,Осылай болмас еді...
Dialogue: 0,0:21:00.01,0:21:01.67,Default,,0,0,0,,Мару Тек сақ болыңыз.
Dialogue: 0,0:21:01.76,0:21:02.80,Default,,0,0,0,,Капитанға...
Dialogue: 0,0:21:02.88,0:21:04.55,Default,,0,0,0,,Уа уа...
Dialogue: 0,0:21:12.27,0:21:13.44,Default,,0,0,0,,Каннибализм
Dialogue: 0,0:21:14.23,0:21:18.23,Default,,0,0,0,,♪~
Dialogue: 0,0:22:36.94,0:22:40.94,Default,,0,0,0,,~♪
Dialogue: 0,0:22:47.95,0:22:50.87,Default,,0,0,0,,Хмм... мм...
Dialogue: 0,0:22:51.41,0:22:52.20,Default,,0,0,0,,Nfu…
Dialogue: 0,0:22:53.74,0:22:55.29,Default,,0,0,0,,Бұл нәресте ме?
Dialogue: 0,0:22:55.37,0:22:57.71,Default,,0,0,0,,Мына суретті маған беріңізші.
Dialogue: 0,0:22:58.21,0:23:01.75,Default,,0,0,0,,Мен мұны Токиоға беруге уәде беремін, сондықтан келесі жолы.
Dialogue: 0,0:23:01.84,0:23:05.30,Default,,0,0,0,,Иә! Конаның суреттері біртүрлі және әдемі
Dialogue: 0,0:23:05.38,0:23:06.84,Default,,0,0,0,,А... Бұл біртүрлі ме?
Dialogue: 0,0:23:06.92,0:23:10.26,Default,,0,0,0,,Бұл біртүрлі, өйткені нағыз сәби...
Dialogue: 0,0:23:10.34,0:23:10.93,Default,,0,0,0,,Уау! Хайаа
Dialogue: 0,0:23:11.01,0:23:14.35,Default,,0,0,0,,Эй, Куку-кун, үстелге отырма!
Dialogue: 0,0:23:14.43,0:23:17.18,Default,,0,0,0,,Қарашы, Куку! Мен Конаның жолына түсемін, сондықтан мен сол жаққа барамын.
Dialogue: 0,0:23:17.27,0:23:18.52,Default,,0,0,0,,Уау... ой...
Dialogue: 0,0:23:22.52,0:23:25.61,Default,,0,0,0,,Егер сіз Конаның суретін сынға алғыңыз келсе, оны қаламаңыз.
Dialogue: 0,0:23:25.69,0:23:27.24,Default,,0,0,0,,Мен сізге комплимент айттым.
Dialogue: 0,0:23:27.82,0:23:30.91,Default,,0,0,0,,Мен нағыз сәбиді көрдім.
Dialogue: 0,0:23:30.99,0:23:32.12,Default,,0,0,0,,А...
Dialogue: 0,0:23:32.20,0:23:35.62,Default,,0,0,0,,Нағыз сәбилердің беті болмайды.
Dialogue: 0,0:23:36.33,0:23:37.12,Default,,0,0,0,,Хехе
Dialogue: 0,0:23:38.00,0:23:39.79,Default,,0,0,0,,Сіз де Токионы көргіңіз келе ме?
Dialogue: 0,0:23:41.29,0:23:47.29,Default,,0,0,0,,{\an8\fs18\c&H00FFFF&}Субтитрлерді дайындаған: ikymory\NБарлық құқықтары қорғалған • github.com/ikymory